    "སྲིད་པ་གསུམ་དུ་མི་སྣང་བ་དེ་ལྟར་རྣམ་པར་བཏུལ་ལོ།",
    "རབ་འབྱོར་དེ་ལྟར་བྱང་སེམས་ཆེན་པོས་མཚན་མ་མེད་པའི་ཚུལ་གྱིས་ཡུམ་ལ་བསླབ་པར་བྱའོ།",
    "རབ་འབྱོར་བྱང་སེམས་ཆེན་པོས་དེ་ལྟར་ཡུམ་ལ་བསླབ་པར་བྱའོ་ཞེས་པའི་དོན།",
    "སྔོན་གྱི་གནས་སྐབས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་ཉེ་བར་བརྟགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "བཅོས་མ་ཡིན་པའི་དོན་གྱིས་བྱས་པ་ནི་མ་ཡིན་ལ།",
    "གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧གང་ཕྱིར་དབེན་པ་དབེན་གྱུར་ལས།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་བཅུ་དང་།",
    "སྨོན་ནས་མཁྱེན་པ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དང་།",
    "བག་ཆགས་ཡང་དག་པར་བཅོམ་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དང་།",
    "རབ་འབྱོར་དེ་ལྟར་བྱང་སེམས་ཆེན་པོས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ལ་བསླབ་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རྣམ་པར་ཐར་དང་མཐར་གྱིས་ནི།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་དང་།",
    "ནང་གཟུགས་ཅན་དང་གཟུགས་ཅན་མ་ཡིན་པར་འདུ་ཤེས་པས་ཕྱི་རོལ་གྱི་གཟུགས་རྣམས་ལ་ལྟ་བ་ཞེས་བྱ་བ་གཉིས་དང་།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ་བ་སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "རྣམ་པར་ཤེས་ཞེས་བྱ་བ་ཟད་པར་རྣམ་པ་བཅུ་དང་།",
    "ནང་གཟུགས་སུ་འདུ་ཤེས་ཤིང་ཕྱི་རོལ་གྱི་ཚ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧གཟུགས་རགས་པ་དང་ཁ་དོག་སྡུག་པ་དང་མི་སྡུག་པ་མཐོང་ཡང་གཟུགས་དེ་དག་ཟིལ་གྱིས་མནན་ཏེ་ཤེས།",
    "ནང་གཟུགས་མེད་པར་འདུ་ཤེས་ཤིང་ཕྱི་རོལ་གྱི་གཟུགས་རགས་པ་དང་ཁ་དོག་སྡུག་པ་དང་མི་སྡུག་པ་མཐོང་ཡང་གཟུགས་དེ་དག་ཟིལ་གྱིས་ཏེ་ཞེས་སོགས་ནི་བཞི་པའོ།",
    "ནང་གཟུགས་མེད་པར་འདུ་ཤེས་ཤིང་ཕྱི་རོལ་གྱི་གཟུགས་དཀར་པོ་ཁ་དོག་དཀར་པོ་དཀར་པོར་སྣང་བ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ནང་གཟུགས་མེད་པར་འདུ་ཤེས་པ་དག་ཁོ་ནས་སྔོན་པོ་དང་།",
    "རྣམ་པར་གྲོལ་བ་ཇི་སྲིད་པའི་གནས་སྐབས་སུ་འཇུག་པ་ཞེས་བྱ་བ་སྨོན་ནས་མཁྱེན་པ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སྐུའི་སྤྱོད་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊིཀ་བཞུགས། ༢༧པ་ཡོངས་སུ་མ་དག་པ་མི་མངའ་བས།",
    "ལ་ལས་ཤེས་སུ་འོང་ངོ་ཞེས་གང་ཡང་བཅབ་པར་དགོངས་པ་དེ་བཞིན་གཤེགས་པ་ལ་མི་མངའ་སྟེ།",
    "ལ་ལས་ཤེས་སུ་འོང་ངོ་ཞེས་བཅབ་པར་དགོངས་པ་དེ་བཞིན་གཤེགས་པ་ལ་མི་མངའ་སྟེ་འདི་ནི་བསྲུང་བ་མེད་པ་གཉིས་པའོ།",
    "ལ་ལས་ཤེས་སུ་འོང་ངོ་ཞེས་གང་ཡང་བཅབ་པར་དགོངས་པ་དེ་བཞིན་གཤེགས་པ་ལ་མི་མངའ་སྟེ་འདི་ནི་བསྲུང་བ་མེད་པ་གསུམ་པའོ་ཞེས་པའི་དོན།",
    "མི་བཟོད་པར་མི་འགྱུར།",
    "ཐུགས་མི་ཆེས་པར་མི་འགྱུར་ཏེ་འདི་ནི་དགོངས་པ་ཉེ་བར་གཞག་པ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཐམས་ཅད་དུ་དགོངས་པ་དང་ལྡན་ཞིང་མཁྱེན་པར་བཏང་སྙོམས་སུ་རྣམ་པར་སྤྱོད་པ་འདི་ནི་དགོངས་པ་ཉེར་བར་གཞག་པ་གསུམ་པའོ་ཞེས་པའི་དོན།",
    "ཉན་པར་མི་འདོད་པ་དང་།",
    "གཉིས་ཀས་དབེན་པ་ཁོ་ནར་བཏང་སྙོམས་སུ་དྲན་པ་དང་ལྡན་པར་གནས་སོ་ཞེས་བྱ་བ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམ་པ་གསུམ་དང་།",
    "དེ་ལ་དེ་བཞིན་གཤེགས་པའི་ཐུགས་རྗེ་ཆེན་པོ་གང་ཞེ་ན་དེ་བཞིན་གཤེགས་པ་ཐུགས་རྗེ་ཆེན་པོ་གང་དང་ལྡན་པས་འཇིག་རྟེན་གྱིས་བརྡ་ཉེ་བར་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས།",
    "རབ་འབྱོར་དེ་བཞིན་གཤེགས་པའི་རྣམ་མཁྱེན་ཉིད་གང་ཞེ་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལེའུར་བྱས་པ་ལ་འཇུག་པར་བྱེད་དོ།",
    "སྤྱོད་པའི་དོན་ཡིན་པའི་ཕྱིར་འདུས་བྱས་སུ་འགྱུར་བའི་ཉེས་པ་ཡོད་དོ།",
    "དེ་ལ་སྐུ་ཞེས་བརྗོད་པ་ནི་སྔོན་གྱི་གནས་སྐབས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་ཉེ་བར་བཏགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྤྲུལ་པའི་སྐུ་གསུམ་དུ་འཇོག་ཅིང་དེ་དག་ཀྱང་དོན་དམ་པར་མ་སྐྱེས་པར་བརྗོད་ཀྱི།",
    "ཅེས་བྱ་བའི་ཚིག་ལེའུར་བྱས་པ་ལས།",
    "དགོས་པ་ཉེ་བར་བསྟན་པའི་ཤུགས་ཀྱིས་ཚིག་ལེའུར་བྱས་པ་སྦྱར་བའི་ངོར།",
    "ཡེ་ཤེས་ཁོ་ན་དང་མཛད་པ་སྦྱར་བའི་ཕྱིར་དེ་སྐད་དུ་གསུངས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཕྱོགས་གཞན་ནས་སྐུ་བཞིར་གསུངས་པ་ཐམས་ཅད་ཀྱང་མི་འགལ་བར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "བསམ་གཏན་ལ་གནས་ནས་བྱང་སེམས་ཆེན་པོའི་རྣམ་པར་སྤྱོད་པ།",
    "དེ་བཞིན་གཤེགས་པའི་སྨོན་ནས་མཁྱེན་པ་ཁྱད་པར་དུ་འཕགས་པར་བསྟན་པའི་ཕྱིར།",
    "བསམ་གཏན་ལ་གནས་ཏེ་འདི་ཤེས་པར་བྱའོ་ཞེས་བྱང་སེམས་ཆེན་པོ་དུས་གསུམ་གྱི་ཤེས་བྱའམ་ཤེས་པ་གང་དང་གང་འདོད་པར་གྱུར་པ་དེ་ལ་ཡིད་ཀྱིས་སྨོན་པ་བྱེད་དེ།",
    "འདྲི་བ་ཀུན་ལན་འདེབས་པར་བཞེད།",
    "ཡང་དག་པའི་སོ་སོ་རིག་པ་བརྙེས་པས་འདྲི་བའི་ལན་འདེབས་པར་མཛད་པ་ཡིན་པ་བཞེད་དོ།",
    "ཡུན་དུ་འཕྲོད་པར་གྱུར་པ་དེའི་ཚེ།",
    "འཚམས་པར་དོན་གྱི་བྱ་བ་མཛད་པས་དུས་ཐམས་ཅད་དུ་ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟར་ཉེ་བར་གནས་ཀྱང་།",
    "དེའི་ལན་བཏབ་པའི་ཕྱིར་བར་སྐབས་ཀྱི་ཚིགས་སུ་བཅད་དེ་གསུངས་པ།",
    "ཡང་དག་པར་ན་ཁྱབ་མ་ཁྱབ་དང་།",
    "ཞབས་ལེགས་པར་མཐོ་བ་དང་།",
    "གསང་བའི་གནས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧སྦུབས་སུ་ནུབ་པ་དང་།",
    "ཕྲག་པའི་ལྷུན་མཛེས་པར་གྲུབ་པ་དང་།",
    "ཞབས་ཀྱི་མཐིལ་གཉིས་མཉམ་པར་ས་ལ་འཇོག་ཅིང་ཞབས་ཞུམ་བ་མེད་པས་ཞབས་ཤིན་ཏུ་གནས་པའོ་ཞེས་པའི་དོན།",
    "སྡོམ་པ་ཡང་དག་པར་བླངས་པ་ལ་བརྟེན་པ་ཉིད་ཀྱིས་རུས་སྦལ་བཞིན་དུ་ཞབས་ཤིན་ཏུ་གནས་པ་ཉིད་དང་།",
    "རིག་པ་དང་བཟོ་ལ་སོགས་པ་གུས་པར་བྱས་ཏེ་བྱིན་པས་བྱིན་པ་རི་དྭགས་ཨེ་ན་ཡའི་ལྟ་བུ་དང་།",
    "སྐྱེ་བོ་ཐམས་ཅད་ཚངས་པར་སྤྱོད་པ་ཡང་དག་པར་ལེན་དུ་འཇུག་པ་དང་གསང་བའི་གསང་ཚིག་བསྲུངས་བས་འདོམས་ཀྱི་སྦ་བ་སྦུབས་སུ་ནུབ་པ་ཉིད་དང་།",
    "མགུལ་དང་རྒྱུད་ལེགས་པར་འབྲེལ་ཞིང་ལྷུན་ཟླུམ་པས་ཕྲག་པའི་ལྷུན་མཛེས་པར་གྲུབ་པའོ་ཞེས་པའི་དོན།",
    "སྙན་པར་སྨྲ་བ་དང་ལེགས་པར་སྨྲ་བ་རྗེས་སུ་མཐུན་པར་བྱས་པས་དཔུང་མགོ་ཤིན་ཏུ་ཟླུམ་པ་ཉིད་དང་།",
    "གསེར་གྱི་གཏན་པ་ཤིན་ཏུ་ཕྱིས་པ་ལྟར་ཕྲག་སོ་ལེགས་པར་གྲུབ་པས་ཕྲག་སོ་ལེགས་པར་ཤིན་ཏུ་རྒྱས་པའོ་ཞེས་པའི་དོན།",
    "ནགས་ཚལ་དང་ཀུན་དགའ་ར་བ་ལ་སོགས་པ་བྱེད་པ་ཡང་དག་པར་ལེན་དུ་བཅུག་པས་ཤིང་ནྱ་གྲོ་དྷ་ལྟར་ཆུ་ཞེང་གབ་པ་ཉིད་དང་།",
    "གཙུག་ལག་ཁང་ལ་སོགས་པ་ལྷག་པར་བྱིན་པས་དབུ་གཙུག་ཏོར་དང་ལྡན་པ་ཉིད་དང་།",
    "འཚོ་བ་རྣམ་པར་དག་པ་ཉིད་ཀྱིས་ཚེམས་མཉམ་པ་ཉིད་དང་།",
    "རྫི་མ་བླ་འོག་ཤིན་ཏུ་ལེགས་པར་གནས་ལ་མ་འཛིངས་པས་བའི་རྗི་མ་ལྟ་བུའོ་ཞེས་པའི་དོན།",
    "ཁོང་ཁྲོ་བ་ལ་སོགས་པ་མེད་པར་བལྟས་པས་རྫི་མ་བའི་ལྟ་བུ་ཉིད་དོ།",
    "སྒྲུབ་པར་བྱེད་པའི་རྒྱུ་གང་ཡིན།",
    "བྱི་དོར་བྱས་འདྲ་རིམ་པར་འཚམ།",
    "གཙང་དང་འཇམ་དང་དག་པའི་སྐུ།",
    "ཀུན་སྤྱོད་གཙང་དང་སྐུ་ལ་ནི་ སྨེ་བ་གནག་བག་མེད་པ་དང་།",
    "གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས།",
    "ཉམས་པ་རྣམ་པར་སྤངས་པ་དང་།",
    "དཔྲལ་བ་ལེགས་པར་འབྱེས་པ་དང་།",
    "ཡིད་ནི་འཕྲོག་པར་བྱེད་པ་དང་།",
    "ནམ་མཁའ་ལ་གཤེགས་པར་མཁས་པ་ཉིད་ཀྱིས་སྟབས་སུ་གཤེགས་པ་ཉིད་དང་།",
    "སྐོར་ཕྱོགས་ཀྱི་ལམ་དང་མཐུན་པར་གཤེགས་པ་ཉིད་ཀྱིས་གཡས་ཕྱོགས་ལྡོག་ཅིང་གཤེགས་པ་ཉིད་དང་།",
    "མཛེས་པར་མཁས་པ་ཉིད་ཀྱིས་མཛེས་པར་གཤེགས་པ་ཉིད་དང་།",
    "ཡོན་ཏན་ཡང་དག་པར་བརྗོད་པར་མཛད་པ་ཉིད་ཀྱིས་སྐུ་འཁྲིལ་བག་ཆགས་པ་ཉིད་དང་།",
    "སྐུ་ལ་སོགས་པ་ཀུན་ཏུ་སྤྱོད་པ་གཙང་བའི་ཕྱིར་རྣམ་པར་དག་པ་ཉིད་དང་།",
    "ཐུགས་རྣམ་པར་དག་པའི་ཕྱིར་སྐུ་རྣམ་པར་དག་པ་ཉིད་དང་།",
    "སྤྱན་རྣམ་པར་དག་པ་ཉིད་དང་།",
    "ཡན་ལག་དང་ཉིང་ལག་ཤིན་ཏུ་རྣམ་པར་འབྱེས་པ་ཉིད་དང་།",
    "འཁོར་ཀུན་ནས་མཛེས་པར་གྱུར་པ་ཉིད་ཀྱིས་ཀུན་ནས་མཛེས་པ་ཉིད་དང་།",
    "ཐུགས་གཙང་བ་ཉིད་ཀྱིས་ཀུན་ཏུ་སྤྱོད་པ་གཙང་བ་ཉིད་དང་།",
    "བསླབ་པ་རབ་ཏུ་མང་པོ་ཀུན་ནས་སྟོན་པར་མཛད་པ་ཉིད་ཀྱིས་ཞལ་ཧ་ཅང་མི་རིང་བ་ཉིད་དང་།",
    "སྙན་པ་ལ་སོགས་པར་གསུང་པ་ཉིད་ཀྱིས་གསུང་སྙན་ཅིང་མཉེན་ལ་འཇམ་པ་ཉིད་དང་།",
    "སྐྱེ་བོ་གཙང་བ་ཕུན་སུམ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "མཆོག་ཏུ་གནོད་པ་བཟློག་པར་མཛད་པ་ཉིད་ཀྱིས་ཕྱག་རིང་ཞིང་རྒྱས་པ་ཉིད་དང་།",
    "འདོད་ཆགས་ལ་སོགས་པའི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བ་ཉིད་ཀྱིས་སྙན་མཉམ་པ་ཉིད་དང་།",
    "ལྟ་བས་བྱས་པ་ཐམས་ཅད་ཀྱིས་གཞན་དུ་མི་འགྱུར་བ་ཉིད་ཀྱིས་དཔྲལ་བ་ལེགས་པར་འབྱེད་པ་ཉིད་དང་།",
    "སྨྲ་བ་ཐམས་ཅད་འཇོམས་པར་མཛད་པ་ཉིད་ཀྱིས་དཔྲལ་དབྱེས་ཆེ་བ་ཉིད་དང་།",
    "ཡུལ་གྱི་དགའ་བ་བཟློག་པར་མཛད་པ་ཉིད་ཀྱིས་དབུ་སྐྲ་བུང་བ་ལྟར་གནག་པ་ཉིད་དང་།",
    "རྣམ་པ་ཐམས་ཅད་དུ་མཛེས་པར་གྱུར་པ་ཉིད་ཀྱིས་ཕྱག་དང་ཞབས་དཔལ་གྱི་བེའུ་བཀྲ་ཤིས་དང་གཡུང་དྲུང་འཁྱིལ་པས་བརྒྱན་པ་ཉིད་ཡིན་ནོ།",
    "བྱང་སེམས་ཆེན་པོས་ཡུམ་ལ་བསླབ་པར་བྱའོ་ཞེས་པའི་དོན།",
    "མི་རྟག་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་བཞིན་དུ་དངོས་པོ་དང་འབྲེལ་བས་རྣམ་པར་རྟོག་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པས་ཕན་པའི་རྒྱུ་ཉིད་དུ་འགྱུར་བར་མཐོང་བ་ཁོ་ན་སྟེ་མྱུར་དུ་ནི་མ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་རྒྱལ་པོའི་ཁབ་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་བཞུགས་སོ།",
    "འཁོར་དང་ཐབས་གཅིག་ཏུ་བཞུགས་ཏེ།",
    "ཏིང་ངེ་འཛིན་རྣམ་པར་དག་པ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་གནས་སུ་དག་པ་ནི་སོ་སོར་རྟོགས་པའི་ཡེ་ཤེས་ཏེ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུའོ།",
    "རྣམ་པར་ཤེས་པ་ལྔ་ཡོངས་སུ་དག་པ་ནི་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ཏེ་སྤྲུལ་པའི་སྐུའོ།",
    "སོགས་པ་གནས་འོག་མིན་ཁོ་ནར་བཞུགས་ཤིང་མཚན་དང་དཔེ་བྱད་གསལ་ལ་རྫོགས་པས་བརྒྱན་པའི་གཟུགས་སྐུ་ལ་ལྟོས་ནས་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་དང་།",
    "ལས་ནི་རྒྱུན་མི་འཆད་པར་འདོད།",
    "དེ་དག་ནས་རྣམ་པར་ལངས་ནས་ལྷ་དང་མི་དག་དང་སྐལ་བ་མཉམ་པར་སྐྱེས་ཤིང་།",
    "དེ་ལ་བྱང་སེམས་ཆེན་པོ་དེ་དག་ཡན་ལག་དང་ཉིང་ལག་བཅད་ཅིང་བཏུབ་སྟེ་ཕྱོགས་བཅུར་རྣམ་པར་འཐོར་པ་དང་།",
    "རྣམ་པར་ལངས་ནས་ལྷ་དང་མིའི་ནང་དུ་སྐྱེ་བ་དང་།",
    "ཡི་དྭགས་ཀྱི་སྐྱེ་གནས་དེ་དག་ནས་རྣམ་པར་ལྡང་བ་དང་།",
    "དེ་ལ་ལྷའི་བུ་གང་འདོད་པའི་ཡོན་ཏན་ལྔས་ཤས་ཆེར་མྱོས་པ་དེ་དག་ལ་གཞལ་མེད་ཁང་དེ་དག་འབར་བར་སྣང་བར་བྱས་ཤིང་དེ་དག་སྐྱོ་བར་གྱུར་པ་ཤེས་ནས་འདི་སྐད་དུ།",
    "ལ་ལ་ནི་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་གསོ་སྦྱོང་ལ་ཉེ་བར་གནས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཇི་ལྟར་ལགས།",
    "བྱང་སེམས་ཆེན་པོས་རྣམ་མཁྱེན་ཉིད་ཐོབ་པར་འགྱུར་རམ།",
    "ཐོབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་བྱང་སེམས་ཆེན་པོས་རྣམ་མཁྱེན་ཉིད་འཐོབ་པར་འགྱུར་ན།",
    "བྱང་སེམས་ཆེན་པོ་ནི་རྣམ་མཁྱེན་ཉིད་འཐོབ་པར་འགྱུར་བའོ།",
    "རྣམ་མཁྱེན་ཉིད་དང་།",
    "དེ་བཞིན་ཉིད་དང་ཡང་དག་པའི་མཐའ་ལའང་འདའ་བ་མ་མཆིས་ན་ཅི་ལགས།",
    "ཡང་དག་པའི་མཐའ་ཡང་གཞན་ཞིག་ལགས་སམ།",
    "དེ་བཞིན་ཉིད་ཀྱང་གཞན་ཡང་དག་པའི་མཐའ་ཡང་གཞན་མ་ལགས་ན།"
