    "དེ་ཐོབ་པ་ནི་རྙེད་པ་སྟེ་མངོན་དུ་བྱས་པའོ།",
    "དེ་དག་སྒྲུབ་པར་མཛད་པོ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཚངས་པ་ལ་སོགས་པ་ཐམས་ཅད་ལས་ཁྱད་པར་དུ་འཕགས་པར་གྱུར་ཅིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "སྲིད་པ་གསུམ་ན་ཕན་དང་བདེ་བ་ཐོབ་པར་མཛད།",
    "རྣལ་འབྱོར་གྱི་རྒྱུད་སྤྱིར་རྗོད་པར་བྱེད་པ་ཡིན་དུ་ཟིན་ཀྱང་ཤུགས་ཀྱིས་དཔལ་གསང་བ་འདུས་པ་ཡོངས་སུ་གཟུང་བར་བྱ་སྟེ།",
    "རྣམ་པར་དཀྲུགས་པས་རྣམ་པ་ཐམས་ཅད་ལ་རྣམ་པར་ཁྱབ་པ་སྟེ།",
    "དེས་བསྒྲུབ་པར་བྱ་བ་དཀྲུགས་པའོ།",
    "གསལ་བར་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ནི་བདེ་བར་གནས་པར་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྣམ་པར་འཁྲུལ་པའི་བློ་ཤེས་རབ་ཀྱི་བྱེ་བྲག་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་འདི་ཞེས་དེ་ཁོ་ན་ཉིད་དང་།",
    "དེ་ཁོ་ན་ཉིད་དང་བསྒྲུབ་པར་བྱ་བ་དག་ནི་བླང་བར་བྱ་བ་ཉིད་དུ་ངོ་བོ་གཅིག་པ་མ་ཡིན་ནམ།",
    "བསྒྲུབ་པར་བྱ་བ་ཞེས་དབྱེ་བ་བསྟན་ཞེ་ན།",
    "བཏང་སྙོམས་ལ་སོགས་པ་སོ་སོར་སྣང་བའི་ཚོགས་མ་ལུས་པ་ལ་ཤེས་བྱ་ཙམ་དུ་ཁྱབ་པར་བྱེད་པ་ཡིན་ལ།",
    "སྲོག་ཆགས་ཐམས་ཅད་ཀྱིས་གདོན་མི་ཟ་བར་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་ལས་བཟློག་པ།",
    "མི་གཡོ་བ་ཞེས་བྱ་བ་ནི་མི་རྟག་པ་ཉིད་ཀྱིས་བསྐྱོད་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་དེ་ལྟ་བུ་བསྒྲུབ་པར་བྱ་བ་ལ་བདུན་པ་ལ་ནི་འདོད་པར་གྱུར་པའོ།",
    "འདི་སྐད་བསྟན་པར་འགྱུར་ཏེ།",
    "ཕུང་པོ་ལྷག་མ་མེད་པའི་དབྱེ་བས་མྱ་ངན་ལས་འདས་པ་ཐ་དད་ཀྱང་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པ་ཁོ་ན་མངོན་སུམ་དུ་བྱ་བའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བར་ཞུགས་པ་ཡིན་ནོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉེ་བར་སྟོན་པའི་སྒྲས་བརྗོད་པར་བྱ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་གྱིས་བསྒྲུབ་པར་བྱ་བ་དང་པོའོ།",
    "བདེ་བ་ཡང་སྔོན་དུ་བྱས་པའི་གནས་སྐབས་ན་མེད་པའི་ཕྱིར་བཏང་སྙོམས་ཀྱི་ངོ་བོ་ཉིད་ཀྱི་བདེ་བ་ཉིད་མེད་པ་ནི་བདེ་བྲལ་བའོ།",
    "འདི་སྐད་དུ་བསྟན་པར་འགྱུར་ཏེ།",
    "མཚན་སུམ་ཅུ་རྩ་གཉིས་འཛིན་ཅིང་དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུས་རྣམ་པར་སྤྲས་པའི་སྐུས།",
    "སྡུག་བསྔལ་སྤངས་པའི་བཏང་སྙོམས་ཀྱི་ངོ་བོ་ཉིད་ནི་བསྒྲུབ་པར་བྱ་བ་གཉིས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བུའི་བསྒྲུབ་པར་བྱ་བ་གསུམ་པ་ཡིན་ནོ།",
    "སྦྱིན་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཡོན་ཏན་འདུ་བྱེད་གོམས་པར་བྱེད་པའི་ཕྱིར།",
    "སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་ཉིད་ཡོན་ཏན་ཡིན་ལ་དེ་དག་ཡང་དག་པར་རྫོགས་པ་སྟེ།",
    "ཡོངས་སུ་རྫོགས་པར་བྱས་ནས།",
    "དེ་ཡང་བསྒྲུབ་བྱར་ཡོད་པ་ཡིན་ནོ་ཞེས་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་ལ་གནས་པ་དག་དེ་སྐད་སྨྲ་བ་བསྒྲུབ་པར་བྱ་བ་བཞི་པ་ཡིན་ནོ།",
    "རྣམ་པར་མི་རྟོག་པ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཡང་དག་པར་འཁྱུད་པ་སྟེ།",
    "དང་པོ་ཉིད་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ལྷའི་རྣམ་པའི་ཁྱད་པར་ཏེ།",
    "བདེ་བ་འབའ་ཞིག་ཙམ་བསྒོམས་པས་གསལ་བར་བྱས་ལ་བདེ་བ་ཆེན་པོ་ཞེས་བྱ།",
    "མངོན་བྱས་པ་ནི་ཀུན་ནས་མངོན་སུམ་དུ་བྱས་པ་ཡིན་ནོ།",
    "ཕྱིས་ལྷའི་རྣམ་པ་ཉིད་ཡོངས་སུ་བཏང་ནས་སྒྲུབ་པའི་འབྲས་བུ་བདེ་བ་ཙམ་ལ་གནས་པར་གྱུར་པའོ།",
    "གལ་ཏེ་མངོན་སུམ་དུ་བྱས་ནས་ཀྱང་ལྷའི་རྣམ་པའི་ངོ་བོ་ཉིད་གཏང་བར་བྱ་བ་ཡིན་པ་དེ་ལྟ་ན་ནི།",
    "རྣམ་པར་བྲལ་བའི་བདེ་བ་ཙམ་ཁོ་ན་མངོན་སུམ་དུ་བྱེད་མི་ནུས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་གསུམ་པ་ཡིན་ནོ།",
    "བདེ་བ་ཙམ་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་ཡོན་ཏན་དུ་འཆད་དོ།",
    "དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུས་སྤྲས་པར་གྱུར་པའོ།",
    "ཀུན་ནས་འཁྱུད་པར་གྱུར་པའོ།",
    "དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུས་རྣམ་པར་སྤྲས་པ།",
    "གཞན་ནི་རྟོགས་པར་སླའོ།",
    "དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་ངོ་བོ་མངོན་སུམ་དུ་བྱས་ནས།",
    "ཕྱིས་དེ་བཀག་ཅིང་བཏང་སྙོམས་ཀྱི་ཡེ་ཤེས་ཙམ་དུ་གྱུར་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ལྔ་པའོ།",
    "གལ་ཏེ་མངོན་སུམ་དུ་བྱས་ནས་ཀྱང་།",
    "བདེ་བས་ཡང་དག་པར་གང་བའི་འཁོར་ལོ་མངོན་སུམ་དུ་བྱས་ནས།",
    "དུས་ཇི་སྲིད་དུ་འདོད་པར་རྣམ་པར་གནས་པ་སྟེ།",
    "ཕྱོགས་གཞན་ཞིག་མངོན་སུམ་དུ་བྱས་ནས།",
    "དེའི་འོག་ཏུ་དེའི་རྒྱུད་རྒྱུན་ཆད་པའི་ངོ་བོ་འགོག་པ་ནི་བསྒྲུབ་པར་བྱ་བ་བདུན་པའོ།",
    "གཞན་ཡང་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་སྒྲུབ་པའི་མཚན་ཉིད་དོན་མེད་པ་ཐོབ་པར་འགྱུར་རོ།",
    "འབྲས་བུ་ཁྱད་པར་ཅན་གཞན་ཡང་མེད་པའི་ཕྱིར་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ལྷག་མའི་དོན་ནི་རྟོགས་པར་ཟད་དོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་དེ་ཞེས་བྱ་བའི་སྒྲ་ཤེས་རབ་ཡེ་ཤེས་ཀྱི་ངོ་བོ་དེ་མཚོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཁྱད་པར་ཡང་ཟག་པ་མེད་པ་ཤིན་ཏུ་རྒྱས་པ་ཉིད་དང་།",
