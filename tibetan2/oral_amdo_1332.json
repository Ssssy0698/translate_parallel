    "ཚེ་གང་བོར་ཁྱོད་དང་ཁ་འབྲལ་མི་སྲིད།",
    "ངོ་མ་ང་རང་དགའ་དྲགས་པ་ཡིན་པས་ཁྱོད་ཀྱིས་ཐུགས་དོགས་མི་གནང་རོགས་ཟེར་བཞིན་མིག་ཆུའི་དོག་པ་རེ་རེ་འགྲམ་ངོས་བརྒྱུད་ནས་ཁྱོ་གའི་ཕྲག་པའི་སྟེང་དུ་བར་མེད་དུ་ཐིགས་བྱུང་ལ།",
    "དེ་ནི་ནང་སེམས་ཀྱི་རྣམ་དག་མཚོན་པར་བྱེད་པའི་གདངས་མེད་ཀྱི་རོལ་དབྱངས་ཇི་བཞིན་ཁྱོ་གའི་ལྭ་བ་དང་ཤ་སྐྱི་བརྟོལ་ནས་སེམས་ཀྱི་གཏིང་རུམ་དུ་སིམ་དུ་འཇུག་འདོད་པ་དང་གཉིས་སུ་མ་མཆིས།",
    "ཁོ་མོའི་སྐད་ཆ་དེ་ཐོས་པས་དོན་གྲུབ་ཀྱང་སེམས་འགུལ་རབ་ཏུ་ཐེབས་བྱུང་བ་འདྲ།",
    "ངས་ཁྱོད་ཀྱི་ཚེ་གང་བོར་བདེ་སྐྱིད་སྟེར་ངེས་ཞེས་བཤད།",
    "གཉིད་ལས་སད་ནས་ཀྱང་སྣང་བ་ཞིག་ལ་ཁོ་མོ་གཙང་བོའི་ལྟོངས་སུ་གཡེང་ཡོད་པ་ལྟ་བུའི་སྣང་བ་ཞིག་སྐྱེས་ནས་མིག་འབྱེད་མི་འདོད་པར་གྱུར།",
    "ཁ་སང་སྟོན་མོ་བྱས་པའི་གནས་ཚུལ་ཡོངས་རྫོགས་ཀྱང་ཆུ་ངོས་སུ་གཟུགས་བརྙན་ཤར་བ་བཞིན་ཡིད་ངོར་མག་མོག་པོར་དྲན།",
    "དོན་གྲུབ་ཁོ་མོའི་འཁྲིས་སུ་ཉལ་འདུག་པ་མཐོང་ནས་སེམས་བདེ་ལ་བབས།",
    "ཁོ་མོར་མུ་མཐུད་དུ་གཉིད་མི་ཡོང་བས་ཕྱོགས་ཡར་མར་ལ་འདང་རྒྱག་བཞིན་དུ་སླར་ཡང་རང་ཉིད་ཆུང་ངུ་ཡིན་དུས་ཀྱི་དོན་དག་ཕྲན་ཚེགས་དག་ཕྱིར་དྲན་བྱས།",
    "ཁོ་མོར་ཨ་ཕ་མེད་པའི་ཁར་གྱོན་གོས་ཧྲལ་ཧྲུལ་ཡིན་པས་ཁྱིམ་མཚེས་བྱིས་པ་དག་གིས་རྩེད་གྲོགས་སུ་མ་འདོད་པར་ཁྱོད་ནི་རྒྱ་སྤྲང་གི་བུ་མོ་ཡིན་པས་ང་ཚོའི་རྩེད་གྲོགས་སུ་མི་དགོས་ཞེས་གཅིག་པུར་ཕུད་འགྲོ་བས།",
    "དེ་ནས་བཟུང་ཁོ་མོ་གཅིག་པུ་ཕྱི་རོལ་ཏུ་གཅིག་པུར་འགྲོ་བར་འཇིགས་སྐྲག་སྐྱེས་ཤིང་།",
    "ཨ་མས་ཀྱང་ཁོ་མོ་སྐྲག་གིན་པ་ཤེས་ནས་གང་བྱུང་དུ་ཐག་རིང་ལ་ལས་བཅོལ་མི་བྱེད་པར་ཕོ་ལས་མོ་ལས་ཅི་ཞིག་བྱེད་ཀྱང་སྔར་བཞིན་ཁོ་མོ་རྗེས་སུ་ཁྲིད་ནས་འགྲོ།",
    "པ་དང་བསྟུན་ནས་ཁོ་མོས་ཀྱང་ཨ་མའི་དཀའ་ངལ་ཤེས་བར་གྱུར་བས་བྱིས་པ་བཞིན་ནམ་རྒྱུན་ཨ་མའི་རྗེས་ཁོ་ན་འབྲངས་ནས་སྡོད་མི་འོས་པ་རྟོགས་ཏེ།",
    "སྤོབས་པ་བསྐྱེད་དེ་ཨ་མས་ཁྱིམ་ལས་བྱེད་དུས་སུ་ཁོ་མོས་སྒོ་ཕྱིའི་ལས་ཀ་ལས་པ་དང་།",
    "ཨ་མ་ཆུ་ལེན་དུ་འགྲོ་ན་ཁོ་མོ་རི་མགོར་བུད་ཤིང་འཐུ་རུ་འགྲོ་བ་སོགས་བྱས་པས་ཨ་མའི་ལས་ཀ་ཡང་མངོན་གསལ་དུ་ཇེ་ཡང་དུ་གྱུར།",
    "དབྱར་ཁར་བུ་མོ་ལོ་གཞོན་དག་དང་ལྷན་དུ་ཞིང་ནང་དུ་ཡུར་མ་ཡུར་བ།",
    "ཁོ་མོས་གསར་བུ་དེ་དག་ལ་གང་ལ་གང་འཚམ་གྱིས་ཀུ་རེ་སྣ་ཚོགས་ཀྱིས་ལན་འདེབས་ཙམ་བྱས་པ་ལས་ཚིག་དོན་ཅན་གཅིག་ཀྱང་ཁ་ནས་ཤོར་དུ་བཅུག་མ་མྱོང་།",
    "བུ་མོ་སུ་ཞིག་གི་ཁྱོ་ག་ཁ་ལོ་བ་ཞིག་ཡིན་ཡང་ད་ལྟ་ཁོ་མོའི་ཨ་མ་ཡང་མཁར་གྲོང་དུ་ཁྲིད་ནས་འཚོ་བ་སྐྱིད་པོ་རོལ་གྱིན་ཡོད་པ་སོགས་ཀྱི་སྐད་ཆ་མང་པོ་ཐོས་རྒྱུ་བྱུང་བས།",
    "དེ་རྗེས་ཁོ་མོ་དང་བུ་མོ་གསུམ་ལྐོག་ཏུ་མཁར་གྲོང་དུ་བྲོས་པ་དང་།",
    "མཁར་གྲོང་དུ་ཟ་ཁང་དང་མགྲོན་ཁང་གི་ལས་གཡོག་བྱས་པ།",
    "སྐབས་དེར་ཕྱི་རོལ་ཏུ་ནམ་གསལ་ཐག་ཆོད་ཡོད་པས་མ་མལ་ལས་ལངས་རྩིས་ཀྱིས་མྱུར་མོར་ཡར་ཙོག་པས་དོན་གྲུབ་ཀྱང་གཉིད་ལས་སད།",
    "ཅེ་རེར་ཚེ་སྐྱིད་ཀྱི་གདོང་ལ་ལྟ་བཞིན་དུ།",
    "གཉིད་མི་ཡོང་གི་མི་འདུག་གམ་ཟེར་ནས་ཁོ་མོའི་ལག་པར་འཇུས་བྱུང་།",
    "མིག་ཆུ་བསྐམས་རྗེས་ཀྱི་ཁོ་མོའི་ངོ་མདངས་ནི་སྔར་བས་ཀྱང་ཉམ་ང་ཞིང་ཡིད་དུ་འོང་བར་གྱུར་འདུག་ཁོ་མོ་འཛུམ་ཙམ་བྱས་ནས་མདང་དགོང་གཉིད་པ་ཧ་ཅང་སྐྱིད།",
    "རང་ཉིད་ཀྱི་ཁྱོ་གའི་གམ་དུ་མི་སྐྱིད་པར་གང་ནས་སྐྱིད་ཨང་ཟེར་བཞིན་ཁོ་ལ་ཧ་ཅང་ཞིམ་པའི་འོ་ཞིག་བྱས།",
    "དྲི་བ་དེ་ནི་རི་གཟར་ནས་ཐོན་པའི་ཤྭ་འོད་ཇི་བཞིན་ཁོ་མོའི་མགྲིན་པའི་ཆུ་རགས་བརྟོལ་ནས་ཤོར་སོང་།",
    "ཁོ་མོས་སྐད་དམའ་མོས་ཁྱོད་ཀྱིས་ད་བར་དུ་ང་རང་མ་མཐོང་བ་མིན་ཨང་།",
    "སྔ་མོ་ནས་མི་ལེན་དོན་ཅི་ཡིན་ཞེས་དྲིས།",
    "དང་ཐོག་དྲི་བ་དེ་བཏོན་པ་ཅུང་ཐལ་དྲགས་ཨེ་སོང་སྙམ་མོད་སླར་ཡང་སེམས་ལ་ད་ནི་ཁྱོ་ཤུག་ཕན་ཚུན་ལུས་སེམས་འདྲེས་ཟིན་པས་ངོ་གནོང་དགོས་དོན་ཅི་ཡང་མི་འདུག་སྙམ།",
    "བཟའ་ཟླ་མོ་གསར་བའི་དྲི་བ་དེས་དོན་གྲུབ་ཀྱི་མིག་ཟུང་ཡང་བསྐྱར་ཕྱེ་རུ་བཅུག་ཁོས་ཀྱང་ཁོ་མོས་རང་ཉིད་ཀྱི་བཟའ་ཟླ་སྔོན་མ་དེར་ཕྲག་དོག་བྱེད་ཀྱིན་པ་ཤེས་ནས་འཛུམ་ཙམ་བྱས་ཤིང་།",
    "ང་རང་སྔོན་ལ་ཁོ་མོར་འཕྲད་པས་རེད་ཟེར།",
    "ཁོའི་ཚིག་དེས་ཁོ་མོས་མུ་མཐུད་དུ་ཅི་ཞིག་རྟོགས་འདོད་ཀྱི་འདུན་པ་དེ་ཇེ་དྲག་ཏུ་གྱུར།",
    "སླར་ཡང་ལག་པ་གཉིས་ཀྱིས་ཁོ་རང་བསྒུལ་ཏེ་ཡང་བསྐྱར་མིག་འབྱེད་དུ་བཅུག་འོ་ན་ཁྱོད་གཉིས་གཉེན་འཐོར་བྱེད་དོན་ནི་ཁོ་མོར་བྱིས་པ་བཙའ་བའི་ནུས་བ་མེད་པ་དེ་ཁོ་ན་ཡིན་ནམ།",
    "དོན་གྲུབ་ཀྱིས་ད་སོ་མར་ཁོ་མོ་གམ་དུ་ཡོད་པ་ཚོར་བ་ལྟར་མིག་ཕྱེ་ནས་ཚེ་སྐྱིད་ལ་ཞིབ་ལྟ་ཞིག་བྱས་རྗེས།",
    "དགོད་བཞིན་དུ་ཁྱོ་གའི་སྣ་མགོར་མཛུབ་མོས་གནོན་ཙམ་བྱས་ཏེ་ཀུ་རེ་དང་དོན་གཏམ་འདྲེས་མའི་ངང་།",
    "བྱིས་པ་མི་བཙའ་བ་དེ་ནི་ཁྱོད་རང་ཉིད་ཀྱི་སྐྱོན་ཡིན་ཡང་སྲིད་པ་མ་རེད་དམ་ཞེས་བཤད།",
    "ཁྱོ་གར་ཡང་གདེང་ཚོད་ཆེན་པོ་མེད་པ་འདྲ།",
    "དེ་བས་ཁོ་མོས་ལྐོག་ནས་གཞན་ལ་བྱིས་པ་བསླངས་པ་རེད།",
    "མགོ་བོ་དགྱེ་སྟེ་དོན་གྲུབ་ཀྱི་གདོང་ལ་ཅེར་བཞིན་གཞན་ལ་བྱིས་པ་བསླངས་ཟེར་བ་ཅི་རེད་ཅེས་དྲིས།",
    "ཁོ་མོར་བྱིས་པ་མ་བཙས་པས་གཤིས་ཀ་ཇེ་བཙོག་ཏུ་གྱུར་ནས་ནམ་རྒྱུན་བཟའ་འཁོན་བྱེད་ཀྱིན་འདུག་དེར་ངས་ཅི་ཡང་མ་བཤད།",
    "བུད་མེད་ཅིག་ལ་མཚོན་ན་བྱིས་པ་བཙའ་བའི་ནུས་བ་མེད་པ་ལས་ལྷག་པའི་མནར་གཅོད་ཅི་ཞིག་ཡོད་དམ།",
    "འོན་ཀྱང་བསྡད་ཀྱིན་དུ་ཁོ་མོས་བྱིས་པ་ཞིག་ལུས་ལ་ཨེ་འཁོར་ལ་རེ་སྟེ་ལྐོག་ཏུ་སྐྱེས་པ་གཞན་དང་ལུས་འབྲེལ་བྱས་པ་རེད་ཟེར།",
    "ངས་ཀྱང་ཁོ་མོས་རང་ཉིད་ལ་བྱིས་པ་བཙའ་བའི་ནུས་པ་མི་འདུག་པ་ཤེས་འཕྲལ་མྱུར་མོར་ཡི་ཆད་པར་འགྱུར་ངེས་རེརེད་སྙམ་ནས་དེ་དག་ལ་ཁ་ཡ་མ་བྱས།",
    "འོན་ཀྱང་བསྡད་ཀྱིན་དུ་སྐྱེས་པ་གཞན་དང་ལུས་འབྲེལ་བྱེད་རྒྱུ་དེ་ཁོ་མོའི་ཆེད་ལས་ལྟ་བུར་གྱུར་སོང་བས་ངེད་གཉིས་རང་རང་སར་སྡོད་དགོས་བྱུང་བ་རེད་ཟེར་ནས་ཧ་ཅང་ཐང་ཆད་པ་ལྟ་བུའི་དངན་པ་རིང་བོ་ཞིག་འཐེན།",
    "ཚེ་སྐྱིད་ཀྱི་ཁ་འདུག་མ་ཐུབ་པར་ཆེད་ལས་ཟེར་བ་ཅི་རེད་ཅེས་དྲིས་རྗེས་རང་ཉིད་ཧ་ཅང་ཐལ་དྲགས་སོང་སྙམ་སྟེ་སྐད་དམའ་མོས་དགོངས་པ་མ་ཚོམ་ཟེར།",
    "དོན་གྲུབ་ཀྱིས་ཁོ་མོའི་རྣམ་འགྱུར་དེ་མཐོང་འཕྲལ་ད་སྔོན་གྱི་སྐྱོ་སྣང་དེ་དག་བརྗེད་པ་ལྟར་གྱུར་ཏེ་བགད་བྱུང་།",
    "ཆེད་ལས་ཞེས་པ་ནི་རང་ཉིད་ཕྱོགས་གང་ལ་མཁས་ཤིང་གོམས་པར་གྱུར་བའི་བྱ་བ་དེ་ལ་ཟེར་བ་རེད།",
    "ཕྱུགས་ལས་པ་ཞིག་ཡིན་ན་ཁོའི་ཆེད་ལས་ནི་ཕྱུགས་འཚོ་རྒྱུ་དེ་ཡིན་པ་ལྟ་བུ་རེད་ཅེས་བཤད།",
    "ཁོ་མོ་ཁ་ཟུམ་མ་ཐུབ་པར་བགད་བྱུང་།",
    "དགོད་བཞིན་དུ་ད་ནི་ངས་ཤེས་སོང་ཟེར།",
    "དོན་གྲུབ་ཀྱིས་ཁོ་མོའི་རྒྱུན་ལྡན་མ་ཡིན་པ་ལྟ་བུའི་དགོད་སྲོལ་དེ་མཐོང་ནས་ཅུང་ངོ་གནོང་བར་གྱུར་ཅིང་།",
    "ཁྱོད་དགོད་དོན་ཅི་ཞིག་ཡིན།",
    "ཁོ་མོ་མུ་མཐུད་དུ་དགོད་བཞིན་དུ།",
    "ཁོའི་གདོང་ལ་ལྟ་ཙམ་བྱས་ཏེ་མ་རེད།",
    "ངས་ཀྱང་ངའི་ཆེད་ལས་ཅི་ཞིག་ཡིན་པ་ཤེས་སོང་ཟེར།",
    "དོན་གྲུབ་ཀྱིས་ཁོ་མོའི་སྐད་ཆའི་ནང་དོན་མ་གོ་བར་ཁོ་མོའི་རྣམ་འགྱུར་ལ་བརྟག་བཞིན་དུ།",
    "ཁྱོད་ཀྱི་ཆེད་ལས་ཅི་ཞིག་ཡིན་ཞེས་དྲིས།",
    "ཁོ་མོའི་ངོ་མདངས་མཚལ་གྱིས་བྱུགས་པ་ལྟར་དམར་བོར་འགྱུར་བཞིན་དུ་ངའི་ཆེད་ལས་ནི་རང་ཉིད་ཀྱི་བྱིས་པ་བཙས་ཏེ་ཚེ་གང་བོར་ཁྱོད་ལ་སྲི་ཞུ་བསྒྲུབ་རྒྱུ་དེ་ཡིན་པ་མ་རེད་དམ་ཟེར།",
    "བྱིས་པ་བཙའ་ན་ཡང་ཞིང་འདེབས་པ་དང་གཅིག་འདྲ་རེད།",
    "ཚེ་སྐྱིད་ཀྱང་དགོད་མཚམས་ཆད་དེ་མ་རབས་ཀྱི་མིག་མདངས་དང་བཅས་ཐ་ཚིག་སྒྲོག་པའི་ཚུལ་དུ་འོན་ཀྱང་ཁྱོད་ཀྱིས་ཀྱང་སེམས་ཆུང་བྱེད་དགོས།",
    "ཁྱོ་ཤུག་གསར་བ་གཉིས་ཀྱིས་ཕན་ཚུན་ལ་འོ་བྱེད་བཞིན་དུ་ལུས་ཀྱི་རྔུལ་ཆུ་བརྡོལ་བར་གྱུར།",
    "འོན་ཀྱང་བྱིས་པ་བཙའ་མི་ནུས་པ་དེ་ཁྱོད་ཀྱི་སྐྱོན་ཡིན་ན་ཅི་བྱེད་རྒྱུ་ཞེས་དྲིས་ནས་ཁོས་ཅི་ཟེར་ལ་ཉན།",
    "བུ་མོ་བཙས་ནས་ཏག་ཏག་ཟླ་གཅིག་འགོར་བའི་དགོང་མོ་དེར་ཁྱོ་ཤུག་གཉིས་ཀ་སླར་ཡང་མལ་ཁྲི་གཅིག་གི་སྟེང་དུ་ཉལ་བ་རེད།",
    "མལ་ཁྲིའི་སྟེང་ནས་དོན་གྲུབ་ཀྱིས་ཚེ་སྐྱིད་ལ་ཅི་འདྲ་རེད།",
    "བྱིས་པ་བཙའ་མི་ནུས་པ་ནི་ངའི་སྐྱོན་མ་ཡིན་པ་ཤེས་སོང་ཨང་།",
    "ད་ནི་ཞི་ལི་ཞིག་བཙས་པ་ན་ཁྱོད་ཀྱི་འགན་ཁུར་འགྲུབ་སོང་བ་རེད་ཅེས་བཤད།",
    "ཅི་ཟེར།",
    "ཁྱོད་ཀྱི་ཆུང་མ་སྔོན་མས་ཁྱོད་ལ་བྱིས་པ་བཙའ་མ་ནུས་པ་རེད་མོད།",
    "ངས་ནི་ཁྱོད་ལ་བུ་མོ་ཞིག་བཙས་ན་ད་དུང་ཡིད་མི་ཚིམ་པ་རེད་དམ་ཟེར་ནས་བསམ་འཆར་བཤད།",
    "ཚེ་སྐྱིད་ཀྱིས་འོ་ན་ཁྱོད་ཀྱིས་བྱིས་པ་བཙའ་རྒྱུ་རྟ་སྦངས་གཏོང་བ་ལྟ་བུའི་ལས་སླ་མོ་ཞིག་རེད་སྙམ་མམ།",
    "ཁྱོད་ཀྱིས་ང་རང་གསོད་འདོད་པ་ཡིན་ནམ་ཟེར།",
    "དོན་གྲུབ་ཀྱིས་ཁོ་མོར་ཞུ་བ་བྱེད་དགོས་བྱུང་།",
    "ཁྱོད་ལ་ཁག་མེད་པ་ངས་ལོས་ཤེས་མོད།",
    "ཁྱིམ་ནང་དུ་བུ་བུ་མོ་གཉིས་ཡོད་ན་ཧ་ཅང་བཟང་བ་མ་རེད་དམ་ཞེས་བཤད།",
    "ཚེ་སྐྱིད་ཀྱི་སེམས་ནས་ཀྱང་བུ་མོར་ཕུ་བོ་ཡོད་ན་ཅིས་མི་འདོད།",
    "ད་དུང་དེ་སྔ་ནས་ཁོ་ལ་བུ་ཕྲུག་བཙའ་རྒྱུ་ནི་རང་གི་ཆེད་ལས་ཡིན་ཞེས་ཚིག་ཤོར་ཡོད་པས།",
    "ཅུང་ཙམ་ལ་འདང་ཞིག་བརྒྱབ་རྗེས་ན་རེ།",
    "འོན་ཀྱང་ངས་བཙའ་བའི་དུས་སུ་ཁྱོད་དེ་སྔ་ལྟར་དགོད་མི་ཆོག་ཟེར།",
    "ང་རང་བགད་ཚེ་ཁྱོད་ཀྱིས་ང་ལ་ཆད་པ་བཅད་ཆོག་ཅེས་བཤད།",
    "ཚེ་སྐྱིད་ཀྱི་སེམས་ཀྱང་སྔོན་ཆད་ལྟར་བདེ་ལ་བབས་སོང་།",
    "གར་སྤོས་ཡོང་སྟེ་ཁྱིམ་མཚེས་སུ་གྱུར་བ་རེད།",
    "རིམ་བཞིན་དུ་ཁོ་མོ་གཉིས་ཀྱིས་ཕན་ཚུན་ངོ་ཤེས་པར་གྱུར་བ་མ་ཟད་ཧ་ཅང་འདྲིས་པར་གྱུར་ཏེ་ད་ལྟ་བློས་ཐུབ་ཀྱི་གྲོགས་མོར་གྱུར་ཡོད།",
    "ཁོ་མོའི་མིང་ལ་རྒྱ་མོ་སྐྱིད་ཟེར་ཞིང་ཕར་བལྟས་ཚོད་དུ་ཁྱིམ་ཚང་གི་འཚོ་བ་ཧ་ཅང་ཐབས་ཆག་རེད་མོད།",
    "ནམ་རྒྱུན་ཁོ་མོ་གཉིས་ཀ་ལྷན་དུ་བསྡད་ཚེ་ཁ་བརྡ་ཧ་ཅང་འཛོམས་པོ་ཡོད་དེ།",
    "ཆེ་བ་རྒྱལ་ཁབ་ཕྱི་ནང་གི་དོན་ཆེན་ནས་ཆུང་བ་མཐའ་འཁོར་གྱི་བུད་མེད་དག་གི་གྱོན་གོས་ཀྱི་གསར་རྙིང་ཐམས་ཅད་གླེང་ཞིང་དཔྱད་ལ།",
    "ད་ནི་དོན་དག་ཅི་ཡང་མི་འདུག་པས་གཅིག་པུར་འདུག་མ་འདོད་པར་སྒོ་ཕྱིར་བུད་དེ་ཁྱིམ་མཚེས་ཚང་གི་ཕྱོགས་སུ་འཁོར་ནས།",
    "རྒྱ་མོ་སྐྱིད།",
    "རེ་ཞིག་ནས་ལྷས་རའི་བར་གྱང་གི་ཕ་རོལ་ནས་བུད་མེད་ཅིག་གིས་ཁོ་མོའི་འབོད་དོན་སྔར་ནས་རྟོགས་ཡོད་པ་ལྟར།",
    "ཡོང་གིན་ཡོད་ཅེས་ལན་བཏབ།",
    "ཁོ་མོ་དལ་དལ་ངང་ཕྱིར་ཁྱིམ་ནང་དུ་ཡོང་ནས་འབོལ་ཁྲིའི་སྟེང་དུ་བསྡད་རྗེས་ཧ་ཅང་སྐྱིད་སྣང་གིས་སྣ་གླུ་ཞིག་ལེན་བཞིན་འགྲམ་རོལ་ཏུ་སླེ་འཕྲོར་བསྐྱུར་ཡོད་པའི་ཐིག་ལྭ་དེ་ལག་ཏུ་བླངས་ནས་སླ་མགོ་བརྩམས།",
    "ཐིག་ལ་སླ་བཞིན་དུ་ལན་རེར་དགྱེ་ནས་བསྡད་དེ་དོན་ཅི་ཞིག་ལ་བསམ་བློ་གཏོང་བ་ལྟར་སྡོད་ཅིང་དེ་འཕྲལ་སླར་ཡང་གདོང་ལ་འཛུམ་ཞིག་ལངས་ནས་མུ་མཐུད་དུ་ཐིག་ལྭ་སླ་བཞིན་བསྡད།",
    "ཕར་བལྟས་ཚོད་ཀྱིས་ད་ལྟ་ཁོ་མོར་སེམས་ཁྲལ་ཅི་ཡང་མེད་པ་འདྲ།",
    "ཅུང་མ་འགོར་བར་ཁྱིམ་མཚེས་ཀྱི་བུད་མེད་རྒྱ་མོ་སྐྱིད་ཀྱིས་ཀྱང་ཐིག་ལྭ་སླ་བཞིན་དུ་སྒོ་ཕྱེ་ནས་ནང་དུ་ཐོན་བྱུང་།",
    "ཁོ་མོ་ནང་དུ་ཡོང་རྗེས་སྒོ་གཏད་བཞིན་དུ་གདོང་ལ་འཛུམ་ཞིག་ལངས་ནས་ཅི་རེད།",
    "ཁྱོད་ཀྱིས་ད་བར་དུ་ཅི་བྱས་པ་ཡིན་ཞེས་བཤད།",
    "རྒྱ་མོ་སྐྱིད་ཀྱང་ཚེ་སྐྱིད་ཀྱི་འཁྲིས་སུ་བསྡད་དེ་འཛུམ་མདངས་ཕྱིར་བསྡུས་ཏེ་ཅུང་སུན་པའི་ཚུལ་གྱིས།",
    "ཚེ་སྐྱིད་ཀྱིས་ཀྱང་ཁོ་མོའི་ཁྱོ་གར་གདུང་སེམས་བཅངས་ཀྱིན་པའི་ཉམས་ཀྱིས།",
    "རེད་ཡ།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་ཅུང་ཡིད་སྨོན་པའི་ངང་།",
    "ཁོ་ཚོའི་ལས་ཀའང་ཡང་བ་རེད་མོད་ཟེར།",
    "ཁོ་མོས་མུ་མཐུད་དུ་གླེང་གཞི་དེའི་རྒྱུན་མི་སྐྱོང་བར།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་ཀྱང་དེ་མུར་ཁོ་མོར་རྒྱུས་ལོན་བྱེད་ཀྱིན་པའི་རྣམ་འགྱུར་ཞིག་བསྟན་ནས།",
    "ཁྱོད་ལའང་ཁག་མི་འདུག་མདང་དགོང་ཁྱོད་ཚང་ན་འུར་ཆེ་བ་ངེད་ཚང་ནས་ཀྱང་ཐོས་ཐུབ།",
    "བར་དེར་གཟིམ་ཁང་ནང་ནས་བུ་མོ་ངུས་བྱུང་བས།",
    "ཚེ་སྐྱིད་ཀྱིས་ཁོ་མོ་གཉིས་ཀྱི་ཁ་བརྡར་བར་ཆད་བྱས་སོང་པར་ཅུང་སུན་པའི་ཉམས་ཀྱིས་སྐེ་དེ་ཕྱོགས་སུ་འཁོར་ཏེ་ཅུང་བཀའ་འབེབས་པའི་གདངས་ཀྱིས་ཝེ།",
    "ཁྱོད་ཀྱིས་དེ་ལ་ཁ་ཡ་ཙམ་བྱས་ན་མི་ཆོག་གམ་ཞེས་བཤད།",
    "ཅུང་མ་འགོར་བར་སྐད་ཅུང་གསལ་བོའི་ངང་ཁོ་མོ་ལྟོགས་ཀྱིན་འདུག་ཁྱོད་ཀྱིས་ཁོ་མོར་འོ་མ་ཞིག་བླུད་དང་ཟེར།",
    "དེ་དང་ལྷན་དུ་བུ་མོ་རྐང་རྗེན་དུ་གཟིམ་ཁང་ལས་ཐོན་ནས་ཨ་མའི་གམ་དུ་གོག་ནས་ཐོན་བྱུང་།",
    "ཚེ་སྐྱིད་ཀྱིས་བུ་མོར་བལྟས་ཏེ་དགོད་བཞིན་དུ་སྡིགས་མོ་བྱེད་རྫུས་བྱས་ཏེ།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་བུ་མོ་ཁོ་མོའི་གམ་དུ་བོས།",
    "ཆུང་བར་ཁ་རྩེད་ཀྱིན་འདུག་ལ་བུ་མོ་ཡང་ཁོ་མོར་འདྲིས་ཆ་ཡོད་པས་ཕྱིར་པང་དུ་འཁྱུད་ཀྱིན་འདུག་ཚེ་སྐྱིད་ཀྱིས་བུ་མོར་བལྟས་ཏེ།",
    "བུ་མོས་ཀྱང་ཨ་མའི་ལག་ནང་གི་ཤེལ་ཕོར་མཐོང་འཕྲལ་སར་བབས་ནས་ཡང་བསྐྱར་ཨ་མའི་པང་དུ་འཁྱུད།",
    "སྐབས་དེར་དོན་གྲུབ་ཀྱང་གཟིམ་ཁང་ནང་ནས་ཕྱི་ཚོར་ཡོང་སྟེ་རྒྱ་མོ་སྐྱིད་ལ་འཚམས་འདྲི་ཞིག་བྱས་རྗེས་ཚེ་སྐྱིད་ལ་བལྟས་ཏེ།",
    "ཇ་ཞིག་འཐུང་ནས་སོང་ཞིག་ཨང་།",
    "དོན་གྲུབ་ཀྱིས་མགོ་བོ་ལྡེམ་ཙམ་བྱས་རྗེས་ཕྱི་རོལ་ཏུ་བུད་ཅིང་སྒོ་བརྒྱབ།",
    "ཚེ་སྐྱིད་ཀྱིས་དོན་གྲུབ་ལ་ཀ་ར་དབུགས་རྒྱག་ཉོས་ལ་ཤོག་ཟེར་བ་ནི་ཁོ་མོའི་ལག་ཏུ་ཀ་ར་དབུགས་རྒྱག་ཉོ་བྱེད་ཀྱི་སྒོར་མོ་མེད་པ་མིན་ལ་ཁོ་མོ་རང་ཉིད་ལ་ཉོ་རུ་འགྲོ་བའི་དུས་ཚོད་མེད་པ་ཡང་མ་ཡིན་པར།",
    "མི་གཞན་གྱི་མདུན་དུ་ཁྱོ་ག་རང་ཉིད་ལ་འདང་རྩིས་ཅི་འདྲ་ཆེ་བ་ངོམ་སོ་བྱེད་འདོད་པ་རེད།",
    "ཚེ་སྐྱིད་ཀྱིས་ལོ་ན་ཆུང་བའི་དུས་སུ་ན་མཉམ་གྱི་བུ་མོ་དག་གིས་ནམ་རྒྱུན་ཁ་ནང་དུ་ཀ་ར་དབུགས་རྒྱག་ལྡད་ཀྱིན་ཧ་ཅང་ཡིད་སྨོན་བྱེད་ཀྱིན་ཡོད།",
    "དེ་དུས་ཀ་ར་དབུགས་རྒྱག་རེཪ་སྐར་ལྔ་ཙམ་ལས་མ་ཡིན་ཡང་ཁྱིམ་ནང་ཧ་ཅང་དབུལ་ཞིང་ཁོ་མོར་དེ་ཉོ་བྱེད་ཀྱི་སྒོར་མོ་མེད་པས།",
    "ད་ལྟ་ནི་ཁོ་མོར་ཀ་ར་དབུགས་རྒྱག་ཉོ་བྱེད་ཀྱི་ཆ་རྐྱེན་ལྡན་པར་མ་ཟད་ཁྱོ་ཀས་ཉོས་ཏེ་ཡོང་མི་དགོས་པར་འགྲམ་རོལ་གྱི་ཚོང་ཁང་ནང་དུ་ཡོད་པ་རེད་མོད།",
    "ཐ་ན་དངོས་རྫས་ཆུང་ངུ་ཙམ་ཉོ་ན་ཡང་ཆེད་མངགས་ཀྱིས་ཁྱོ་ག་བཅོལ་བར་བྱེད།",
