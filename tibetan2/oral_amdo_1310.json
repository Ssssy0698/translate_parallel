    "སྔ་མས་སྐྲ་བཞར་མི་རྙེད་པས་སོར་གཉིས་བཞག་ཆོག་ཕྱི་མས་རྙེད་པས་དེའི་འོག་མ་སོར་གང་ལས་བཞག་མི་ཆོག་སྐྲ་བ་ལང་གི་སྤུ་ལྟར་མི་བྲེག་པ་ནི་ཚན་པ་སྟེ་ཧེ་གྲིབ་མི་བྲེག་པའོ།",
    "རྒྱ་གར་ན་སྐྲ་ཕལ་ཆེར་བུད་མེད་ཀྱིས་འབྲེག་པས་རྒན་གཞོན་གྱི་བྱེ་བྲག་གིས་རྒན་པའམ།",
    "བར་མར་སྲིང་མོ།",
    "ཆུང་ངུར་བུ་མོའི་འདུ་ཤེས་འཇོག་པའོ།",
    "རྡུལ་གཟན་དང་མོན་སྲན་དེའུ་ལ་པར་མ་ན་རྡུལ་གཟན་དང་རྡེའུ་ཞེས་པ་ལྟར་ཡོད་ཀྱང་ཉིད་ནས་རྡུལ་གཟན་དང་མོན་སྲན་རྡེའུ་ཞེས་གསུངས།",
    "འདིའི་ཁྲུས་ཁང་ནི་རྒྱ་ནག་གི་མཁར་ཆེ་བ་ཚོ་ནའང་ཡོད།",
    "དེ་ལ་སོ་བཏང་བ་གྱོ་མོག་གི་མིང་རེད།",
    "སོ་ཕག་གི་དུམ་བུས་དུད་པས་རྐང་བ་གཉིས་ལས་གཞན་པའི་ལུས་ལ་དྲུད་པར་མི་བྱའོ།",
    "ཞེས་པ་རྒྱུ་གར་ན་རྐང་རྗེན་ལ་སོང་བས་སྟེང་དུ་རག་ཆགས་པ་སོ་ཕག་རྩུབ་མོས་བཞར་བའོ།",
    "བཞར་སྤྱད་དང་ཕྲུག་སྤྱད་ནི་རང་རེའི་གཏམ་ལ་བཞར་སྤྱད་པོ།",
    "བསྲོ་གང་གི་ཁང་པ་ནི་གྲམས་ཆེ་བར་བཟང་ངོ།",
    "ཞེས་བསྲོ་གང་གི་ཁང་བ་བསྲོ་ཁང་ཡིན་པས་དེ་གཉིས་མི་འདྲ།",
    "ཚ་ཐབ་ཡིན་ཟེར་ཀྱང་དེ་གཅིག་པུ་མ་ཡིན་པར་མེ་འབུད་ས་སྟེ།",
    "ཞེས་མིག་ནས་ཆུ་འཛག་ན་རྩམ་པ་ཚན་འདིས་གླན་པས་ཆོད་པ་རེད།",
    "དབུས་ན་བུལ་ཏོག་གིས་བྱེད།",
    "སྣོད་སྤྱད་སོགས་ལ་ག་དར་གྱིས་གསུངས་པ་རེད།",
    "ཟང་རའི་ཁ་ཁེབ་ཕྱི་བ་ལ་ངན་ཀྱང་འདི་ལྟར་ན་ཕྱིས་ཀྱང་རུང་ཙམ་མོ་གསུངས།",
    "ད་ལྟའི་མགར་བས་བརྡུང་བའི་འཐུག་པོ་དེ་འདྲ་མ་ཡིན་པར་ཨོ་རོ་སུ་ན་ལྕགས་སྲ་བ་ཤིན་ཏུ་སྲབ་མོས་བཟོས་པ་སྣང་སྟེ་རྒྱ་གར་ན་ཡང་དེ་འདྲ་ཡོད་རྒྱུ་རེད།",
    "ཞེས་པ་སྔས་བཞག་ནས་ཚབ་ཚན་ལ་ཉལ་ཚུལ་རེད།",
    "རྐང་ཁྲུས་ཀྱི་གཞི་གཙུག་ལག་ཁང་གི་སྟེང་ཡིན་ན་ཤར་ལྷོར་བྱ་དགོས།",
    "ཁའི་ཆའི་མཐའ་ཁོ་ན་ནས་མཐེ་བོའི་ལྟོ་གང་གི་ལྷག་མར།",
    "ཞེས་མཐེ་བོང་གི་ཚིགས་གཅིག་གི་ཚོད་མ་གང་བ་དགོས་པས་མང་ཇ་ཁ་ཐེལ་མ་ཞེས་ཕྱི་འབོ་མི་ལེན།",
    "མ་ག་དྷའི་བྲེ་ཆུང་གང་ནི་རང་རེའི་ཕོར་པ་གང་ཙམ་མོ།",
    "སྲན་ཚོད་རྒྱ་ནག་ན་ཡོད་དེ་ཞིམ་པོ་འདུག་རྒྱ་གར་པའི་བཟའ་བ་འབྲས་ཆན་དང་ཚོད་མ་ཤས་ཆེ།",
    "རང་རེ་ལྟར་ཤ་གྲིས་བཅད་ཀྱིན་བཅད་ཀྱིན་ཟ་བ་མིན།",
    "ལྔ་བོ་ཡང་དེ་བཞིན་ནོ་ཞེས་རབ་བྱུང་གི་ཚེ་ལྷུང་བཟེད་དང་།",
    "དེས་ཕྱག་དར་མི་དོར་རོ་ཞེས་ནང་གི་རྡུལ་ཕྱག་པ་དེ་མི་དོར་བའོ།",
    "དེ་བཀུར་བ་ནི་ལུང་ཐག་བཏགས་ཏེ་མཆན་ཁུང་གིས་སོ།",
    "ཞེས་སྣོད་ལ་ལུང་ཐག་བཏགས་ཏེ་མཆན་ཁུང་གི་ཐད་དུ་བཀུར་བའོ།",
    "ཞེས་ལེབ་མོར་གནས་པའི་ཆེད་དུ་ཕྱིང་བ་སྦྱར་བའོ།",
    "ཚོན་མོ་སྟེང་ནི་ཞ་ཉེ་ནག་པོའོ།",
    "དེ་དག་གི་མཐའ་ཐམས་ཅད་སོག་ལེའི་ཁའམ་ཆུ་སྲིན་གྱི་སོ་ལྟ་བུ་བྱས་པ་བཟང་སྟེ།",
    "གང་གིས་བདར་ན་ལྕགས་སམ་རྡོའི་བྱེ་བྲག་ཀུ་རུ་བིན་དིས་བདར་རོ།",
    "ཁ་བསྒྱུར་ཚུལ་སོགས་གསུངས་པ་རེད་དེ།",
    "ང་ཚོ་དཔའ་བས་དེང་སང་སྐྲག་རྒྱུ་ག་ན་ཡོད་གསུངས།",
    "ཁྱོད་འདོན་རྒྱུ་ཅན་པོ་མ་རེད།",
    "འདོན་མི་དགོས་ཞེས་བསྡིགས་མོ་བྱེད་པ་ཡིན་གྱི།",
    "སོ་ཤིང་གི་ཚད་སོར་བཅུ་གཉིས་མན་ཆད་བརྒྱུད་ཡན་ཆད་དོ།",
    "དེ་ནས་སོ་ཤིང་ས་ལ་འཕང་བས་མགྲོན་ལམ་ལྟ་བུར་དེ་རིང་གི་དོན་གྲུབ་མིན་གྱི་ལྟས་རྟོག་པ་རྒྱ་གར་པའི་ཡུལ་སྲོལ་རེད་གསུངས།",
    "ཞེས་པ་ཚོགས་གཏམ་ངན་གི་ཨང་གསུངས།",
    "གནས་བརྟན་མ་འོང་ན་ཅུང་ཟད་སོང་སྟེ་ཡང་སྡོད་པ་དང་།",
    "གྲོང་གི་ཐག་ཉེར་སོང་སྟེ་ཡང་སྡོད་པ་དང་།",
    "གྲོང་གི་སྒོར་སླེབས་ནས་འོང་བ་མཐོང་ན་ཡང་སྡོད་པ་དང་།",
    "ཁྲུས་འབུལ་ན་དུས་མི་འགྱང་ན་རེ་ཞིག་སྡོད་པ་དང་།",
    "མ་གོ་ན་དྲུང་ན་མོ་བྱེད་དུ་གཞུག་གོ།",
    "མ་གྱུར་ན་རང་གིས་སོ།",
    "ཞེས་པ་བརྡ་སྦྱར་ཀྱང་མ་གོ་ན་དྲུང་ན་མོ་ཐག་ཉེ་ན་ཡོད་པ་ལ་བརྡ་བྱེད་དུ་གཞུག་པ་དང་།",
    "དེས་ཀྱང་མཛེས་པར་མ་གྱུར་ན་གནས་བརྟན་རང་གིས་མཛེས་པར་བྱ་བའོ།",
    "ཞེས་དགེ་སློང་གྲོང་དུ་སོང་ནས་ཁྱིམ་དུ་རྒོད་བག་མི་བྱེད་པ་དང་།",
    "བསྙེན་གནས་རེ་ཨེ་ཐུབ་ལྟོས་ཟེར་བ་ལྟ་བུའོ།",
    "ཞེས་གྲོས་བཏབ་པའི་རྐྱེན་གྱིས་ཁོང་ཚོ་འགྲོ་ན་མ་འགྲོ་ཞེས་བྱོལ་བཏབ་བོ།",
    "སེན་མོ་ཐམས་ཅད་གཅིག་ཏུ་སོང་བ་ནི་སེན་མོ་གཅིག་པའོ།",
    "མིག་ཕྱིན་ཅི་ལོག་པ་ནི་གཅིག་གིས་ཐད་ཀ་དང་།",
    "གཅིག་གིས་གཞན་དུ་ལྟ་བའི་ཁྲ་ཞར་རོ།",
    "ཆེ་བ་ནི་ཁྱི་རྔོ་ཆུང་འབྲིང་ཆེ་གསུམ་མོ།",
    "བཅུག་རེག་ཉམས་སུ་མྱོང་ནའོ།",
    "ཞེས་པ་ལམ་གསུམ་དུ་བཅུག་པའི་རེག་པ་བདག་གིར་བྱས་ན་ཕམ་པའོ།",
    "རང་གིས་སྨྲས་པ་དང་སྨྲས་པར་བྱེད་དུ་གཞུག་པར་མི་བྱའོ།",
    "རང་གིས་རྨ་བཏོད་བའམ་བཏོད་དུ་བཅུག་ནས་ཀྱང་ལེན་དུ་མི་རུང་ངོ།",
    "ཞེས་པ་གཡར་བོ་ཟད་ཟད་དུ་ལོངས་སྤྱད་ན་སྦོམ་པོར་འགྱུར་བས་མི་རུང་བ་སོགས་ང་ཚོའི་ས་ཆ་འདི་ཚོའི་རྣ་བའི་ལམ་དུ་མི་འགྲོ་བ་ཤ་སྟག་རེད་དེ་གལ་ཆེན་པོ་ཡིན་གསུངས།",
    "ཆོམ་རྐུན་པ་ལས་སྦྱིན་བདག་གི་སེམས་ཀྱིས་ལེན་པ་ལ་ཉེས་པ་མེད་དོ།",
    "ཞེས་ཆོམ་རྐུན་པ་ལས་སྦྱིན་བདག་གི་བསམ་པས་རྫས་བླང་བ་ཉེས་པ་མེད་པའོ།",
    "ཐལ་བའི་གོང་བུ་འཕེན་པ་གནའ་དུས་ཡག་གི་སྐད་ཆ་རེད་གསུངས་སྐྲ་ཅན་འཚོང་ནའོ།",
    "གང་གིས་བརྐུས་པ་དེ་བླའི་གྲར་འབུལ་ནའོ།",
    "གསང་སྔགས་ཀྱི་ཐལ་ལྕག་བྱ་བ་ཡང་ངོ།",
    "ཞེས་སྔགས་བཏབ་པའི་ཐལ་ལྕག་བསྣུན་ཆེ་བ་དང་།",
    "ཞེས་ལྷ་མཐོང་བ་སོགས་མོ་ལུང་བསྟན་དང་རྨི་ལམ་བརྟག་མཁན་ལ་འབྱུང་ཉེ་གསུངས།",
    "མི་མཐུན་ཕྱོགས་ཀྱིས་གཉེན་པོའི་ཕྱོགས་བཅོམ་སྟེ་ཕམ་སོང་བས་ཕམ་པ་དང་།",
    "རེག་ལྷག་གི་སྐབས་ཁྲིའུ་བཞིན་དུ་བསྲུང་བར་བྱའོ།",
    "བུད་མེད་ཆུས་ཁྱེར་བ་ཕྱིར་བླངས་ཏེ་དྲན་པ་རྙེད་ཀྱི་བར་དུ་ཁྱིམ་པ་ལ་གཡར་བའི་ཁྲིའུ་བསྲུང་བ་བཞིན་དུ་ཕྱོགས་གཅིག་ཏུ་བཞག་སྟེ་རང་གི་ལས་ཀྱང་བྱེད་ལ།",
    "སྲུ་མོ་ཟེར་བ་དེའོ།",
    "ཡ་བྷ་འཁྲིག་པ་ལ་འཇུག་པས་ཡ་བྷ་གོར་རེ་ནས་ཡ་བ་སྟེ་ནས་བྱིན་ཅིག་ཟེར་མི་རུང་བའོ།",
    "ཁྱོད་ཅི་ལ་དགའ་བ་བྱིན་ཅིག་ཅེས་བདག་ལ་སྨྲས་པ།",
    "ཁྱོད་ཅི་ལ་དགའ་ཟེར་བ་ལ་སུ་ཁྱོད་ལ་དགའ་འོ།",
    "བུད་མེད་ལ་ཁྱོད་ཅི་ལ་དགའ་བ་བྱིན་ཅིག་སྨྲས་པ་དང་།",
    "བུད་མེད་ཀྱིས་བདག་ལ་སྨྲས་པ།",
    "ཁྱོད་ཅི་ལ་དགའ་ཟེར་བ་ལ།"
