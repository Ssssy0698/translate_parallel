    "དེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་དང་དེ་དག་ལ་དམིགས་པར་གྱུར་པ་སྟོང་པ་ཉིད་ལ་སོགས་པ་དོན་དམ་པ་ངོ་བོ་ཉིད་མེད་དུ་ཟིན་ཀྱང་།",
    "དེའི་ཚེ་རྣལ་འབྱོར་པས་རྣམ་པར་རྟོག་པ་འདི་ཡང་སྤང་བར་བྱ་བ་ཉིད་དོ།",
    "ས་ལ་སོགས་པ་དག་ཀྱང་དོན་དམ་པར་མ་སྐྱེས་པའི་ཕྱིར་རོ།",
    "ས་འདི་རྣམས་ནི་ལྷུན་གྱིས་གྲུབ་པར་འཇུག་པ་ལ་སོགས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར་ས་དེ་མ་ཡིན་པ་གཞན་དག་པས་མཆོག་ཏུ་གྱུར་པས་ན་བྱེ་བྲག་ཏུ་རྣམ་པར་རྟོག་པའི་མཚན་མ་གཞན་དག་གསུངས་སོ།",
    "ས་ལ་བཞུགས་པའི་ནི་མ་ཡིན་ཏེ།",
    "མངོན་དུ་ཕྱོགས་པར་ཡིད་ལ་བྱེད་པའི་རྨོངས་པའི་གཉེན་པོར་རོ།",
    "དྲུག་པ་ནི་མཚན་མ་མེད་པར་གནས་པ་མཚན་མ་མེད་པར་མང་དུ་ཀུན་དུ་སྤྱོད་པ་ལ་རྨོངས་པའི་གཉེན་པོ་དང་།",
    "བརྒྱད་པ་ནི་ལྷུན་གྱིས་གྲུབ་པར་མཚན་མ་མེད་པ་ལ་གནས་པ་ཐོབ་པས་མཚན་མ་མེད་པ་ལ་འབད་ཅིང་ཀུན་དུ་སྤྱོད་པའི་རྨོངས་པའི་གཉེན་པོར་རོ།",
    "བསྐལ་པ་བརྒྱར་གནས་པར་བྱེད་པ་དང་།",
    "ཕྱོགས་དང་དུས་ཐམས་ཅད་དུ་གཏོགས་པའི་དངོས་པོ་མ་ལུས་པའི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཏོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཅེས་གསུངས་ཏེ།",
    "ཤིན་ཏུ་བརྩོན་པ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ལ་འཇུག་པའི་ལམ་ལ་མངོན་དུ་ཡང་དག་པར་ཞུགས་པའི་ཕྱིར་རོ།",
    "དེ་ཞི་བར་བྱས་ནས་ཡང་དེ་ཉིད་ལ་སེམས་ཡོངས་སུ་གཏད་དོ།",
    "རྣམ་པར་གཡེང་བའི་ཉེས་པ་མཐོང་བས་མི་དགའ་བ་ཞི་བར་འགྱུར་རོ།",
    "བྱིང་བས་སེམས་མི་དགའ་བར་གྱུར་པར་མཐོང་བ་དེའི་ཚེ་རབ་ཏུ་དགའ་བར་འགྱུར་བའི་དངོས་པོ་ལ་སོགས་པའི་ཡིད་ལ་བྱ་བས་བྱིང་བ་ཞི་བར་བྱས་ཏེ།",
    "རྒོད་དུ་དོགས་པ་མཐོང་བ་དེའི་ཚེ་མི་རྟག་པ་ལ་སོགས་པ་སྐྱོ་བར་འགྱུར་བ་འདི་དངོས་པོ་ཡིད་ལ་བྱས་ནས་རྒོད་པ་ཞི་བར་བྱའོ།",
    "སེམས་མཉམ་པར་འཇུག་པར་མཐོང་བ་དེའི་ཚེ་རྩོལ་ཀློད་དེ་བཏང་སྙོམས་སུ་བྱའོ།",
    "གལ་ཏེ་སེམས་མཉམ་པར་གནས་པར་གྱུར་པ་ལ་བརྩལ་བ་བྱས་ན་དེའི་ཚེ་སེམས་རྣམ་པར་གཡེང་བར་འགྱུར་རོ།",
    "གལ་ཏེ་སེམས་ཞུམ་པར་གྱུར་པ་ལ་བརྩལ་བ་མ་བྱས་ན་དེའི་བྱིང་བ་ཞི་བར་མི་འགྱུར་ཏེ།",
    "དེས་ན་སྐྱེས་བུ་དམུས་ལོང་བཞིན་དུ་དེ་ཁོ་ན་གསལ་བར་ཟིན་པར་མི་འགྱུར་རོ།",
    "དེ་བས་ན་བྱིང་བའི་སེམས་ནི་གསལ་བར་བྱ་ཞིང་དགོད་པ་ཞི་བར་བྱས་ཏེ་མཉམ་པ་ཐོབ་ནས་བཏང་སྙོམས་སུ་བྱའོ།",
    "དེ་ལྟར་བྱས་ན་རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་སྟོང་པ་ཉིད་ཀྱི་བསམ་གཏན་སྒྲུབ་པར་འགྱུར་ཏེ།",
    "ཐབས་དང་མ་བྲལ་བ་ལ་སོགས་པ་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "འཕགས་པ་དྲི་མ་མེད་པར་གྲགས་པས་བསྟན་པ་ལ་སོགས་པ་ལས་ཀྱང་།",
    "ཡང་དག་པའི་ཏིང་ངེ་འཛིན་ཞེས་རྣམ་པར་གཞག་གོ།",
    "དེ་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ལ་ཤིན་ཏུ་བརྩོན་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ཡང་དག་པའི་སྦྱོར་བ་བསྟན་ནས་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་སུ་འཇུག་པ་སྟེ།",
    "དེ་ཡང་དག་པར་སྦྱོར་བ་དེ་དང་ཞེས་བྱ་བའོ།",
    "དེ་ལྟར་ཡང་དག་པར་སྦྱོར་བའི་ཐོས་པ་དང་།",
    "ཡུན་རིང་པོར་བསྒོམས་ནས་བསྐལ་པ་གྲངས་མེད་པ་འདས་པར་གྱུར་པ་དང་།",
    "དེའི་ཚེ་རྣལ་འབྱོར་པ་རྣམ་པར་མི་རྟོག་པ་ཉིད་དུ་ཞུགས་པ་ཡིན།",
    "མང་དུ་བྱས་པས་རྗེས་སུ་འགྲོའོ་ཞེས་བྱ་བ་ནི་བསྒོམས་པའི་ཤེས་རབ་སྟེ།",
    "ཡང་དག་པར་ཡིད་ལ་བྱ་བས་རྗེས་སུ་འགྲོ་བ་ན་ཞེས་བྱ་བ་ནི་ཤེས་རབ་འདི་རྣམས་ཀྱིས་ཕྱིན་ཅི་མ་ལོག་པར་སྦྱོར་བས་རྗེས་སུ་འགྲོ་བར་བསྟན་པའོ།",
    "ས་དང་པོར་ཞུགས་ནས་དེའི་གོང་མའི་ས་རྣམས་རྣམ་པར་སྦྱང་ངོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་བཞིའི་གནས་དང་གོ་རིམས་བཞིན་ནོ།",
    "ཅིའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ཀྱི་མཚན་ཉིད་དེ་བསྡུས་པའི་དོན་དགུ་པ་སྟོན་ཏོ།",
    "དཔྱད་པའི་རྣམ་པར་བརྟག་པ་ཐམས་ཅད་ལས་ཤིན་ཏུ་འདས་པ་ཞེས་བྱ་བ་ནི་འདིའོ།",
    "བསྟན་པ་དང་དཔེར་རྣམ་པར་བརྟག་པ་ཐམས་ཅད་ལས་འདས་པ་ཞེས་བྱ་བ་ནི་གཞན་དག་ལ་འདི་ན་འདི་འདྲའོ་ཞེས་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཡུལ་དུ་རྣམ་པར་བརྟག་པ་ཐམས་ཅད་ལས་ཤིན་ཏུ་འདས་པ་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པ་ཕྱིའི་སྐྱེ་མཆེད་ཀྱི་མཚན་ཉིད་དུ་རྣམ་པར་བརྟག་པ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ལས་འདས་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རིག་པར་རྣམ་པར་བརྟག་པ་ཐམས་ཅད་ལས་ཤིན་ཏུ་འདས་པ་ཞེས་བྱ་བ་ནི་མིག་ལ་སོགས་པའི་རྣམ་པར་རིག་པའི་མཚན་ཉིད་དུ་རྣམ་པར་བརྟག་པ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ལས་ཤིན་ཏུ་འདས་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་རྣམ་པར་རིག་པ་མ་ཡིན་པ་སྟེ།",
    "དེའི་ལན་དུ་གཟུགས་མེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་མི་འགྱུར་རོ།",
    "ལྷའི་བུ་གལ་ཏེ་དོན་དམ་པར་བདེན་པ་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ཡུལ་གྱི་དངོས་པོར་གྱུར་ན་ནི་དོན་དམ་པའི་བདེན་པ་ཞེས་བྱ་བའི་གྲངས་སུ་མི་འགྲོ་སྟེ།",
    "ལྷའི་བུ་འདི་ལྟར་ཡང་དོན་དམ་པར་ན་དོན་དམ་པའི་བདེན་པ་ནི་ཐ་སྙད་ཐམས་ཅད་ལས་ཤིན་ཏུ་འདས་པ་སྟེ།",
    "ཁྱད་པར་མེད་པ།",
    "མ་འགགས་པ་བརྗོད་པར་བྱ་བ་དང་།",
    "ལྷའི་བུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ལས་འདས་པ་སྟེ།",
    "ལྷའི་བུ་དེ་ལ་རྟོག་པ་དང་རྣམ་པར་རྟོག་པ་རྣམས་མི་འཇུག་གོ།",
    "དོན་དམ་པའི་བདེན་པ་ཞེས་ཇི་སྐད་དུ་བྱ་བ་ལྟར་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "ད་ནི་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་སུ་ཞུགས་པའི་རྟགས་ཏེ།",
    "རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ལ་རབ་ཏུ་གནས་པས་ནི་ཤེས་བྱ་དང་ཁྱད་པར་མེད་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གང་ཡོད་པ་དེ་ནི་དོན་དམ་པར་བརྫུན་ཡང་སྐྱེ་བར་འགྱུར་ཏེ།",
    "སྒྱུ་མ་ལ་སོགས་པ་ཡང་དོན་དམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་སྒྱུ་མ་ལ་སོགས་པ་དང་བྱེ་བྲག་མེད་པར་བརྟག་མི་བཟོད་དེ།",
    "འོན་ཀྱང་སྒྱུ་མ་ལ་སོགས་པ་ལས་དོན་དམ་པའི་མཚན་ཉིད་དེ་ཁྱད་པར་ཡོད་པར་བརྗོད་དགོས་སོ།",
    "མ་བྱུང་བ་ལས་འབྱུང་ཞིང་བྱུང་ནས་ཀྱང་འཇིག་པར་མི་འགྱུར་ཏེ།",
    "ནམ་ཡང་འཐད་པར་མི་འགྱུར་རོ།",
    "སྣོད་ཀྱི་འཇིག་རྟེན་བསྡུས་པ་རྣམས་ནི་སྨིག་རྒྱུ་དང་མཚུངས་པར་ཏེ།",
    "ཡུལ་དང་ལོངས་སྤྱོད་ཀྱི་ངོ་བོ་རྣམས་ནི་རྨི་ལམ་དང་མཚུངས་པར་ཏེ།",
    "ལུས་ཀྱི་ལས་ཀྱི་ངོ་བོ་ཉིད་རྣམས་ནི་མིག་ཡོར་དང་མཚུངས་པར་ཏེ།",
    "འདོད་པ་ན་སྤྱོད་པ་རྣམས་ནི་གཟུགས་བརྙན་དང་མཚུངས་པར་ཏེ།",
    "གཟུགས་དང་གཟུགས་མེད་པ་ན་སྤྱོད་པའི་ཏིང་ངེ་འཛིན་དུ་བསྡུས་པའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པའི་འབྲས་བུར་བསྡུས་པ་རྣམས་ནི་ཆུ་ཟླ་དང་མཚུངས་པར་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་དྲུག་དང་སེམས་ལས་བྱུང་བ་ཐམས་ཅད་ནི་སྨིག་རྒྱུ་དང་མཚུངས་པར་ཏེ།",
    "དེ་དག་སྨིག་རྒྱུ་བཞིན་དུ་བརྫུན་པའི་རྣམ་པར་སྣང་བའི་ཕྱིར་རོ།",
    "ཕྱིའི་ཁམས་རྣམས་ནི་རྨི་ལམ་དང་མཚུངས་པར་ཏེ།",
    "སྔོན་གྱི་ལས་ཀྱི་འབྲས་བུར་བསྡུས་པ་རྣམས་ནི་གཟུགས་བརྙན་དང་མཚུངས་པར་ཏེ།",
    "ད་དེ་ནི་དེའི་ཕན་ཡོན་ཏེ་བསྡུས་པའི་དོན་བཅུ་གཅིག་པ་ནི་བདེ་བ་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དུས་ཐམས་ཅད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་སྟེ།",
    "འདི་ལྟ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་དཔེ་ཉེ་བར་བཀོད་པས་ནི་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་གཅིག་ཏུ་བླང་བ་སྟེ་བསྡུས་པའི་དོན་བཅུ་གསུམ་པ་སྟོན་ཏོ།",
    "རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་སུ་འཇུག་པ་ལམ་གྱི་དཔེའོ།",
    "ཇི་ལྟར་བསགས་པར་བྱ་བའི་ཕྱིར་གསེར་ལ་སོགས་པའོ།",
    "རང་བཞིན་གྱི་རྣམ་པར་རྟོག་པ་རྣམས་ནི་གཅིག་ཏུ་སྤང་བར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར་རྡོའི་རང་བཞིན་ནི་དཔེའོ།",
    "ཇི་ལྟར་གཞོར་ལ་སོགས་པས་རྐོ་བའི་ཐབས་ཡང་དག་པ་ཡིན་པས་འགྲུབ་ཀྱི་གཞན་གྱིས་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ་ཡང་དག་པར་སོ་སོར་རྟོག་པའི་མཚན་ཉིད་ཁོ་ནས་མཚན་མ་རྣམས་ཡིད་ལ་མི་བྱེད་པར་ཡོངས་སུ་སྤང་བར་ནུས་ཀྱི་གཞན་གྱིས་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་རྐོས་ཤིག་ཅེས་བྱ་བ་སྟེ་ཡིད་ལ་མི་བྱེད་པའི་དཔེའོ།",
    "རྣམ་པར་རྟོག་པའི་རང་བཞིན་དུ་བདེན་དུ་ཟིན་ཀྱང་གཉེན་པོ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པས་ཡུལ་གྱི་དངོས་པོ་ཁྱད་པར་ཅན་དུ་གྱུར་པས་གོང་ནས་གོང་དུ་འབྲས་བུའི་ཁྱད་པར་ཐོབ་པའི་རྒྱུ་ཡོད་དོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "འཇུག་པ་ཁོང་དུ་ཆུད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་འཇུག་པའི་གོ་རིམས་ཤེས་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ད་ནི་ཐབས་ཀྱི་མཚན་ཉིད་དེ་བསྡུས་པའི་དོན་བཅུ་བཞིས་བསྟན་པའི་ཕྱིར་ཇི་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཉེ་བར་རྟོག་པ་མེད་པར་མཚན་མ་རྣམས་ཡོངས་སུ་སྤོང་བར་མི་ནུས་ལ།",
    "མཚན་མ་རྣམས་ཡོངས་སུ་མ་སྤོངས་པར་ཡང་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ལ་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟ་བས་ན་གདོན་མི་ཟ་བར་ཉེ་བར་བརྟག་པར་བྱའོ་སྙམ་ནས་ཇི་ལྟར་ན་ཡང་རྣམ་པར་རྟོག་པའི་མཚན་མ་ཇི་སྐད་བསྟན་པ་དེ་དག་ལ་ཉེ་བར་རྟོག་ཅིང་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་སུ་འཇུག་ཅེ་ན་ཞེས་འདྲི་བའོ།",
    "དེ་ནི་འདིར་སྦྱོར་བའི་ལམ་ལ་བརྟགས་ནས་རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ཞེས་སྒྲར་དགོངས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་མི་རྟོག་པའི་དབྱིངས་ལ་གནས་པ་དངོས་ལ་ནི་གཟུགས་ལ་སོགས་པའི་མཚན་མ་མངོན་དུ་གྱུར་པ་མེད་པའི་ཕྱིར་རོ།",
    "གཟུགས་ལ་སོགས་པ་ནི་གཟོད་མ་ནས་མ་སྐྱེས་པའི་ཕྱིར་དོན་དམ་པར་སྐྱེ་བ་དང་འགག་པ་ལ་སོགས་པ་མི་སྲིད་དོ།",
    "ཡོད་པར་འཛིན་པ་སྔོན་དུ་འགྲོ་བ་ནི་མེད་པར་འཛིན་པ་ཡིན་པས་དེ་ལྟར་རྟོག་ན་ཡོད་པར་འཛིན་པ་ཉིད་དུ་འགྱུར་རོ།",
