    "དེ་ལ་གལ་ཏེ་འགའ་ཞིག་བཟླས་པའི་ཕྱག་རྒྱ་རྣམས་བསྒྲུབ་པར་འདོད་ན་ཡང་དེ་ནས་དེས་ཇི་ལྟ་བ་བཞིན་དུ་བཟླས་པ་བྱས་ལ་ཞེས་བྱ་བ་ནི་དེ་བཟླས་པའི་ཆོ་གས།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གཟུངས་ཀྱི་རིག་པ་མཚན་ཐོག་ཐག་བཟླས་ན་དེ་ལྟ་བུ་དེས་ཕྱག་རྒྱ་བྱས་པ་ཧཱུཾའགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་གཟུངས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ནས་ཟླ་བ་ཉ་ལ་མཚན་ཐོག་ཐག་བཟླས་པ་བྱས་ནས་ལས་ཐམས་ཅད་ལ་རིག་པའི་ཡི་གེ་ལན་ཅིག་བརྗོད་པས་འགྲུབ་པར་འགྱུར་རོ།",
    "ད་ནི་པདྨའི་རིགས་ཀྱི་ཡོ་བྱད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་ཡོད་པར་ལྷ་གྲུབ་པའི་གནས་སུ་པདྨའི་ཆགས་པ།",
    "དོན་ཡོད་པར་གྲུབ་པའི་གནས་སུ་པདྨའི་དཔལ།",
    "དོན་ཡོད་པར་གྲུབ་པའི་གནས་སུ་པདྨ་རྒྱུ།",
    "ལྷག་མ་ནི་སྔ་མ་བཞིན་དུ་བྱས་ཏེ།",
    "དོན་ཡོད་པར་གྲུབ་པའི་གནས་སུ་པདྨ་གནོད་སྦྱིན།",
    "དེ་ལྟར་རས་ལ་བྲིས་ནས་སྔ་མ་བཞིན་དུ་རང་ལ་བྱིན་གྱིས་བརླབ་ལྷཔ་ལ་སོགས་པ་བྱས་ལ།",
    "དེ་ནས་ཟླ་བ་ཉ་ལ་མཚན་ཐོག་ཐག་ཏུ་བཟླས་པར་བྱའོ།",
    "ཅི་སྟེ་ཕྱག་རྒྱ་བསྒྲུབ་པར་འདོད་ན་ཡང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་རིག་པ་འབུམ་བཟླས་པར་བྱའོ།",
    "བཟླས་པ་བྱས་ལ་ནམ་ལངས་པ་ན་ཕྱག་རྒྱའི་དངོས་གྲུབ་ཏུ་འགྱུར་རོ།",
    "ཅི་སྟེ་ལས་བསྒྲུབ་པར་འདོད་ན་ཡང་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཐུན་བཞིའི་སྦྱོར་བས་སྟོང་རྩ་བརྒྱད་བཟླས་ལ་རྨྱེ་ཟླ་བ་གཅིག་ཏུ་བཟླས་པར་བྱའོ།",
    "མཐར་མཚན་ཐོག་ཐག་བཟླས་ལ་དེའི་རྗེས་ལ་ནམ་ལངས་པ་ན་ལས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟར་པདྨའི་རིགས་ཀྱི་ཡོ་བྱད་ཀྱི་ཆོ་ག་རྒྱས་པར་བསྟན་ནས།",
    "ད་ནི་ནོར་བུའི་རིགས་ཀྱི་ཡོ་བྱད་དང་ཆོ་ག་རྒྱས་པ་ནི་ཊྭཱ་འདི་ཡིན་ཏེ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་ལྟར་རས་རིས་བྲིས་ནས་དེ་ནས་བསྡུ་བ་ལ་སོགས་པའི་ཆོ་ག་བྱས་ལ།",
    "ཅི་སྟེ་ཕྱག་རྒྱ་བསྒྲུབ་པར་འདོད་ན་ཡང་།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་ལྟར་ནོར་བུའི་རིགས་ཀྱི་གཟུངས་བསྒྲུབ་པའི་ཡོ་བྱད་ཀྱི་ཆོ་ག་རྒྱས་པར་མུབསྟན་ནས།",
    "ཅི་སྟེ་ནོར་བུའི་ཡེ་ཤེས་བསྒྲུབ་པར་འདོད་ན་ཡང་།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ནམ་མཁའ་དེ་ཡང་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་སྤངས་པའི་ཕྱིར་དངོས་པོ་མེད་པའོ།",
    "ཤིན་ཏུ་རྣམ་པར་རྟོག་པ་མེད་པ་དེའི་ཕྱིར།",
    "མཚན་ཐོག་ཐག་བཟླས་པར་བྱའོ།",
    "ཇི་ལྟར་གོང་དུདུ་སྨོས་པ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཕྱག་བཞི་བྱས་ལ་སྟོང་ཕྲག་བརྒྱ་བཟླས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྟོང་ཕྲག་བརྒྱ་བཟླས་པ་རྐ་བྱས་པའི་རྗེས་ཐོགས་ཉིད་ལའོ།",
    "ཟླ་བ་ཉ་ལ་མཐར་མཚན་ཐོག་ཐག་བཟླས་པར་ཛིབྱའོ།",
    "དེའི་རྗེས་ལ་རིག་པ་རྣམས་ལན་ཅིག་བརྗོད་པས་ལས་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "རིག་པ་བཟླས་པར་བྱའོ་སྐྱཞེས་བྱ་བའི་དོན་བསྟན་པའི་ཕྱིར།",
    "གྲུབ་པར་གྱུར་ཅིག་ཅེས་བརྗོད་ལ།",
    "སྤྲོས་པ་མེད་པའི་ཚིག་གྲུབ་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "སྤྲོས་པ་མེད་པའི་ཚིག་འགྲུབ་པར་གྱུར་ཅིག་ཅེས་བརྗོད་ཅིང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཏིང་ངེ་འཛིན་བདག་ལ་བསྐྱེད་པར་གྱུར་ཅིག་ཅེས་སྨྲས་ལ།",
    "དེ་ནི་རིགས་ཞུཔ་ཐུགས་སུ་ཆུད་ཅིང་སྡོམ་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི།",
    "དེ་སྡོམ་པར་གྱུར་པ་ནི་མངོན་སུམ་དུ་བྱེད་པའི་རྒྱུར་གྱུར་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིག་་པ་ཐུགས་སུ་ཆུད་ཅིང་སྡོམ་པར་འགྱུར་བ་ལ་བྱའོ་ཞེས་སྨྲས་ལ།",
    "རིག་པ་བཟླས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་བསྟན་པའི་ཕྱིར།",
    "རྒྱས་པར་རྔོསྐྱེགསུངས་པ་ནི་ཅི་དགའ་བ་ཉིད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བཟླས་པའི་དོན་དུ་བསྒྲུབ་པར་བྱ་བ་དེ་ནི་བདག་གམ་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རིན་ཆེན་འབེེབས་པའི་མཐར་ཐུག་པ་དེ་ཟློས་ཤིང་།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ལ།",
    "དེ་ལྟར་བྱས་ན་ཅིར་འགྱུར་ཞེ་ན།",
    "བསྒྲུབ་པར་བྱ་བ་འགྲུབ་པར་འགྱུར།",
    "རིག་སྔགས་སྣརྣམས་ཀྱིས་བསྒྲུབ་པའི་བྱ་བ་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ངུནི་ཟློས་པ་པོ་རྣམས་སྤྲོ་བ་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་བཟླས་བརྗོད་ཀྱི་འབྲས་བུ་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བའི་ཀྱེཆོ་ག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཐར་མཚན་ཐོག་ཐག་བཟླས་པ་བྱས་ནས་རྡོ་རྗེ་གཏེར་ལ་སོགས་པའི་སྤྱོར་བས་༨༧བསྒྲུབ་པར་བྱའོ།",
    "ཤིང་སྐྱེས་བྷེདེ་ལྟ་བུར་མཐོང་ན་དེ་ན་གཏེར་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "བདག་ཉིད་གནས་དེར་བཅས་པ་བསྲུང་བར་བྱས་ནས།",
    "རྡོ་རྗེ་འབར་བ་ལྟ་བུ་མཐོང་ན་དེ་ན་གཏེར་ཡོད་པར་བྱེ་ཤེས་པར་བྱའོ།",
    "རྫུ་འཕྲུལ་གྱི་དངོས་གྲུབ་གསུངས་པ་ཡིན་ཏེ།",
