    "ཉིན་པར་བསྟན་དང་རང་གཞན་དོན་ལ་འབད།",
    "ཐོབ་རྟིང་རང་ནོར་སྙམ་པའི་བློ་རྫོགས་པའོ།",
    "བདུད་ཀྱི་ལས་དང་རང་ཁ་བཏང་བཞག་མེད།",
    "ཉལ་འདུག་མི་བྱའི་ཁྲི་སྟན་གསུམ་ཞེས་བཤད།",
    "རང་རང་ཁས་བླང་ན་ནི་འགལ་མེད་དགོས།",
    "འཚང་རྒྱ་མི་འདོད་འདོད་ཀྱང་རང་འདོད་སྤང་།",
    "ཕམ་པ་ཞེས་བརྗོད་གཞན་དང་རང་ཉིད་ཀྱིས།",
    "ཚོགས་ལ་རྩོད་དང་ཉན་ཐོས་ནང་དུ་འདུག།",
    "ཉེས་བྱས་དགུ་ནི་དམ་ཉམས་གནས་གཅིག་འདུག།",
    "རང་རང་ལམ་གྱིས་འབྲས་བུ་མི་བསླུ་ཡང་།",
    "རང་རང་ལྟ་བའི་ཤུགས་ཀྱི་རྟ་ལ་ཞོན།",
    "རང་རང་ས་ནས་སྔགས་ཀྱི་སྒོར་ཞུགས་པ།",
    "ནོད་པ་པོ་དག་དམའ་སར་འདུག།",
    "འདུག་པའི་ཚུལ།",
    "འདུག་པ།",
    "དེ་གཉིས་དང་བྲལ་བར་འདུག་པ་སྟེ་མི་ལེགས་པའི་སྤྱོད་ལམ་ལྔ་སྤོང་བའོ།",
    "དེའང་རང་བས་གོང་མའི་དོན།",
    "ཞིང་ཐོག་གད་གཡང་རང་གཞན་གནོད་ལམ་སྤོང་།",
    "གསུམ་པ་འདུག་ཚུལ་ལ་བཞི།",
    "འདུག་ཚུལ་ལོ།",
    "འདུག་ན་དྲན་པས་བརྟགས་ལ།",
    "འདུག་ན་འདུག་པའི་ས་ཕྱོགས་ཡིན་མིན་རང་ལ་ཕན་ཡང་གཞན་ལ་གནོད་མི་གནོད་དྲན་པས་བརྟགས་ལ།",
    "ལ་ནི་སྟན་ལ་ནི་འདུག་ཅེས་པ་ལྟ་བུ་གཉིས་པའི་སྒྲའོ།",
    "༡ ཐད་ཀ་དང་འོག་མར་གྱུར་པའི་འདུག་ས་དང་༢།",
    "ལམ་ཀ་སོགས་གཞན་ལ་གནོད་༤ ས་དག་ནི་འདུག་པའི་ས་མིན་ནོ།",
    "མཇིང་པ་བསྟན་དང་འཁྲོས་བཞིན་འདུག་མི་བྱ།",
    "འཁྲོས་བཞིན་དུ་འདུག་པ་༤ རྣམས་མི་བྱའོ།",
    "མདུན་བསྟན་དགའ་དང་འཛུམ་པར་བྱེད་ཅིང་འདུག།",
    "དེ་དག་ལ་མདུན་བསྟན་ནས་དགའ་བའི་ཚུལ་གྱིས་འཛུམ་པར་བྱེད་ཅིང་འདུག་གོ།",
    "གཤིབས་བརྐྱང་ཁྱི་ཚུགས་གཉིད་ཅིང་འདུག་པ་སྤོང་།",
    "༣ གན་རྐྱལ་དུ་འདུག་པ་དང་།",
    "༩ ཁྱི་ཚུགས་སུ་འདུག་པ།",
    "༡ གཉིད་ཅིང་འདུག་པ་དང་བཅུ་གཅིག་སྤོང་དགོས་སོ།",
    "ཟས་འདྲེན་པ་དང་རང་གཉིས་ཀྱི་བར་དུ་ཆོད་པ།",
    "ཚུལ་གོས་སོགས་དང་མི་འབྲལ་བར་བདེ་བའི་སྟན་ལ་འདུག་ནས་གཙང་སྦྲ་རྣམ་དག་བྱས་ལ་སྤྱོད་པའོ།",
    "ལངས་ཉལ་ཟ་འགྲོས་ཡང་ཟ་འདུག་ས་སྤོ།",
    "༡༦ འདུག་ས་སྤོ་སྟེ་ཟ་བ།",
    "ཉིན་པར་སྟན་དང་རང་གཞན་དོན་ལ་འབད།",
    "གཞན་ཡང་རང་ལས་རིགས་དང་ཡོན་ཏན་ལྷག་པ་ལའང་དེ་བཞིན་དུ་བྱ་སྟེ་བརྙས་ཤིང་གྲལ་འོག་དུ་བཞག་པ་ལ་སོགས་མི་རུང་ངོ་༡༣།",
    "ཐོབ་རྟིང་རང་ནོར་སྙམ་པའི་བློ་རྫོགས་པའོ།",
    "༡ མ་བསྟབས་པའི་སྟན་ལ་འདུག་པ།",
    "༤ གདན་གཅིག་ལ་འདུག་པ་སོགས་སྟབས་གཅིག་པ་ལ་དང་།",
    "༤ དེའི་ཡུལ་ན་རྒྱ་བོད་ལ་སོགས་མི་རིགས་ཐ་དད་པ་འདུག་པ་གནས་དང་བཅས་པ་དང་།",
    "༤ བཟའ་བའི་ཟས་ཞིམ་པ་ལ་ཕྲག་དོག་འདུག་པའི་གནས་ཡིད་འོང་ལ་ཕྲག་དོག་སྟེ་མི་དགའ་བའི་སེམས་དང་།",
    "བདུད་ཀྱི་ལས་དང་རང་ཁ་བཏང་བཞག་མེད།",
    "འདུག་པའི་མཁར་ཁང་དང་༢།",
