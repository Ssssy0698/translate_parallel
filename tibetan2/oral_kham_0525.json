    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་རུ",
    "རྡོ་རྗེ་བདུག་པའི་སྤྲིན་གྱི་ཕུང་པོ་ལས་ཁྲོ་བོའི་ཚོགས་དཔག་ཏུ་མེད་པ་སེར་རྒོད་འབབ་པ་ལྟར་འཕྲོས་ཁྱེད་རང་རྣམས་ལ་གནོད་ཅིང་བར་དུ་གཅོད་པའི་མི་མཐུན་མི་འདོད་པ་ཐམས་ཅད་ཚར་བཅད།",
    "ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་ལུས་སྣང་སྟོང་འཆི་མེད་རྡོ་རྗེའི་སྐུར་གྱུར་པར་མེས་ཤིག།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་གཉེན་པོ་སྟོབས་ཀྱི་ལྷའི་ཕྱག་རྒྱ་འདི་བཞིན་ཏུགསལ་ཐོབཅིག།",
    "སློབ་དཔོན་དང་ཁྱེད་རང་དཔལ་རྡོ་རྗེ་བདུད་རྩི་ཧེ་རུ་ཀ།",
    "རྫས་དང་ལམ་དང་རང་བཞིན་གྱིས",
    "གནས་འདིའི་མ་འདུག་གཞན་དུ་དེངས",
    "ཞེས་པས་སོ་སོར་མངའ་གསོལ་ཅིང་རང་གྲལ་དུ་དགོད་དོ།",
    "གནས་འདིར་མ་འདུག་གཞན་དུ་དེངས",
    "ཞལནས་འཐོན་ཏེ་ཁྱེད་རང་རྣམས་འཇིག་རྟེན་དབར་ཕྱུག་རྒྱལབ་རྒྱ་མཚོར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "སློབ་དཔོན་དཀྱིལའཁོར་གྱི་གཙོ་བོའི་ཐུགས་ཀའི་ས་བོན་དང་ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་ནས་འོད་ཟེར་བསམ་གྱིས་མིཁྱབ་པ་འཕྲོས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་འལ་དུ་ཞུགས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ཤུགས་སྲོག་དང་ལུས་གནས་ཀྱི་ལྷ་རྣམས་ལས་འོད་ཟེར་འཕྲོས།",
    "གཏོར་མའི་ལྷ་ཚོགས་འོད་དུ་ཞུནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཧེ་རུཀའི་ཡིག་བརྒྱ་བཟླས་མཐར་བཤགས་སྡོམ་བྱ་ཞིང་རང་ལ་བསྟིམ",
    "རང་རང་གནས་སུ་བདེ་བར་དེངས",
    "ཁྱེད་རང་རྣམས་ཀྱིཞལ་ནས་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རངརྣམས་བདེ་མཆོག་པདྨ་བཛྲ།",
    "བདུད་རྩིའི་ཕོབྲོང་བླམ་བདེ་མཆོག་པདྨ་བཛྲ་རྩལརྟེན་དང་བརྟེན་པའི་དཀྱིལ་འཁོར་ཡོང་སུ་རྫོགསཔ་གསལ་བ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་སྤྱན་དྲངས་ཤིར་བྱིན་གྱིས་བརླབས་པ་ལ་བརྟེན་ནས་དབར་བཞི་ཡོངས་སུ་རྫོགས་པ་ཐོབ།",
    "སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་གང་དུ་གནས་པའི་གོ་སར་པདྨ་ཉི་མདྲེགས་པའི་གདན་གྱི་སྟེང་དུ་རང་སེམས་ཧཱུཾ་ཡིག་དམར་པོ།",
    "ཁྲིད་རང་འདྲའི་ཡུམ་ལ་འཁྱུད་ཅིང་རང་འོད་ཀྱི་ཀློང་ན་བཞུགས་པ།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་རྩ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་བླ་ཚེ་ཆད་ཉམས་ཡར་བ་དར་འཁོར་འདས་བརྟན་གཡོའི་དྭངས་བཅུད་ཐམས་ཅདེའཇའ་ཟེར་ཐིག་ལེའི་རྣམ་པར་བསྡུས་ཏེ་བ་སྤུའི་བུ་གནས་སིབ་ཀྱིས་ཞུགས།",
    "འོ་ཁྱེད་རང་རྣམས་ལ་སྔོན་གྱི་ལས་དང་འཕྲལ་གྱི་རྐྱེན་ལས་གྱུར་པའང་རུང་སྟེ་གཟུགས་ཅན་མི་དང་གཟུགས་མེད་ལྷ་འདྲེ་རྣམས་ཀྱིས་གདུག་ཅིང་རྩུབ་པའི་བསམ་སྦྱོར་ངན་པས་བྱད་ཁ་ཕུར་ལཎྜཾརྦོད་གཏོང་རྦད་འདྲེ་གཏོབབ་དང་།",
    "གནས་སྐབས་དེ་ཙ་ན་ཧེང་རིས་ཀྱིས་གློག་འཕྲིན་གྱི་རྩ་བའི་རིགས་པ་གསུངས་པ་དེས་རྨོ་སེའི་སྒྲིབ་པ་བསལ་ཅིང་བློ་རིག་རྣམ་པར་གྲོལ་བའི་རྒྱུར་གྱུར་ཏོ།",
    "ཁྱེད་རང་གྱི་ཕ་མེས་དང་མ་མེས་ནས་སུ་ཞིག་སྤྲེའུ་ཡིན་ཞེས་བརྙས་སྨོད་བྱས།",
    "ཤེལ་སྒོའི་ངོས་སུ་ལག་པའི་ཀེང་རུས་ཀྱི་གཟུགས་བརྙན་ཞིག་གསལ་བོར་འཆར་འདུག་པ་མཐོང་།",
    "ལོ་སན་གྱིས་ཁྱེད་རང་དགོངས་པ་མ་ཚོམ།",
    "ཁྱེད་རང་ངལ་ཡོད་པ་ངས་ལོས་ཤེས།",
    "འཛམ་གླིང་འཁྲུག་ཆེན་ཐེངས་གཉིས་པའི་སྐབས་སུ་ཁོང་རང་ཡོན་ཙི་ཏེན་གྱིས་གནོད་སྐྱོན་ཆེན་པོ་བཟོ་བར་ཐུགས་ཁུར་གནང་།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག་པ་དང་།",
    "ཁམས་ཀྱི་དབྱེ་བ་དང་རང་བཞིན།",
    "བདག་ཕུང་རང་བཞིན་གཅིག་པ་དགག་པ་དང་།",
    "སམང་གནས་ནས་ར་ནས་ནང་སུཅ་ནཔ་བའང་རང་ག་གསཚུར་ངས་ཟླ་ཙིཏཾདྷུ་ཅིང་འབྲེལ་པར་གསུམ་པ་ལ།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ།",
    "བྱ་བ་དང་རང་བཞིན་གྱིས་ལྡན་པར་ཡོད་པའི་རྐྱེན་ཀྱང་འོན་ཏེ་ན་ཞེས་པ་མེད་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར་རོ།",
    "འགྲོ་བར་རྩོམ་པའི་ལམ་གསུམ་པོ་གང་ཡང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར་རོ།",
    "བ་རང་རང་གང་ཞིག་སྡོད་པར་འགྱུར་ཏེ།",
    "ལྡོག་ས་གསུམ་པོ་གང་ལས་ཀྱང་རང་བཞིན་གྱིས་མི་ལྡོག་པའི་ཕྱིར་རོ།",
    "འགྲོ་བ་པོ་ཡིན་པར་གྱུར་པ་དེ་འགྲོ་སའི་ལམ་རྣམ་པ་གསུམ་པོ་གང་དུའང་རང་བཞིན་གྱིས་འགྲོ་བར་མི་བྱེད་ལ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག་པ།",
    "དེ་ཡོད་པའི་ཕྱིར་གཟུགས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་ཅེས་ལན་འདེབས་ཤིང་སྨྲ་བར་བྱེད་པ་དེ་ཡིས་ཐམས་ཅད་དུ་ཡང་དག་པའི་ལན་བཏབ་པ་མིན་ཏེ།",
    "༧༣༧ བང་བྱས་པའི་ཚེ་རྒོལ་བ་གང་ཞིག་སྐྱོན་གདགས་པའི་བསམ་པས་ཚོར་བ་ལྟ་བུ་རང་བཞིན་གྱིས་ཡོད་པའི་ཕྱིར་གཟུགས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་ཅེས་སྨྲ་བར་བྱེད་པ་དེ་ཡིས་ཐམས་ཅད་དུ་སྐྱོན་བཏགས་ནུས་པ་མིན་ཏེ།",
    "མཚན་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་ཉིད་མ་ཡིན་ཏེ།",
    "གསུམ་པོ་གང་དུའང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར་ཞེས་པའོ།",
    "ཇི་ལྟར་ཏེ་དཔེར་ན་མར་མེས་རང་དང་གཞན་གཉིས་ཀ་སྣང་བར་བྱེད་པ་དེ་བཞིན་དུ་སྐྱེ་བའང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉི་གའི་སྐྱེད་བྱེད་དུ་འགྱུར་བས་སྐྱེ་སོགས་གཞན་ལ་བརྗོད་པའི་ཉེས་པ་མེད་ཅེ་ན།",
    "མར་མེ་དང་ནི་ཡུལ་གང་དག་ན་མར་མེ་དེ་འདུག་ཅིང་འོད་ཀྱིས་ཁྱབ་པ་ནའང་མུན་པ་མེད་ལ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉི་ག་སྒྲིབ་པར་འགྱུར་བ་ཐེ་ཚོམ་མེད་པར་འདོད་དགོས་པར་འགྱུར་ཏེ་མཚུངས་པའི་ཕྱིར་རོ།",
    "སྤྱིར་འདུས་བྱས་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པའི་ཕྱིར་དེའི་ཁྱད་པར་སའི་མཚན་ཉིད་སོགས་ཀྱང་རང་བཞིན་གྱིས་མེད་དོ།",
    "བྱེད་པོ་ཡིན་པས་ལས་ཡིན་པ་བྱས་ན་བྱེད་པ་པོ་ལས་དོན་གཞན་པའི་བྱ་བ་ཡོད་མི་དགོས་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱོགས་ལྟར་ན་དགོས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱོགས་ལྟར་དགོས་པས་དུས་མཉམ་པའང་མི་འཐད་དོ།",
    "གལ་ཏེ་ལེན་པ་པོའི་བདག་དང་བླང་བྱའི་ཕུང་པོ་ཕན་ཚུན་ལྟོས་ཀྱང་རང་བཞིན་ཡོད་པ་མི་འགལ་ཏེ།",
    "སྡུག་བསྔལ་ནི་བྱིན་པའི་གང་ཟག་དང་ལེན་པའི་གང་ཟག་གང་ལ་ལྟོས་ཀྱང་རང་བཞིན་གྱིས་གཞན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དངོས་པོའི་རང་དུས་ཀྱི་གནས་སྐབས་དེ་ཉིད་ལ་ནི་གཞན་འགྱུར་རང་བཞིན་གྱིས་ལ་༨ ང་མ་རམ་ཟ་མཐར་བསམ་འདུག་༥ ས་ལ་ས་དབསར་མ་ཡིན་པས་གཞན་འགྱུར་རང་བཞིན་གྱིས་གྲུབ་པ་མི་སྲིད་དོ།་",
    "དེ་དག་ལའང་རང་བཞིན་གྱིས་ཕྲད་པར་འགྱུར་བ་མེད་དོ།་",
    "ཕྲད་བཞིན་པ་དང་ཕྲད་པ་དང་ཕྲད་པ་པོ་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "དེ་ལྟ་ནའང་རང་བཞིན་ནི་རྒྱུ་རྐྱེན་གྱིས་བྱས་པ་ཅན་ཡིན་ཞེས་ཇི་ལྟ་བུར་ན་རུང་བར་འགྱུར་ཏེ།",
    "ཁམས་ཀྱི་དབྱེ་བ་དང་རང་བཞིན།",
    "རྐྱེན་མིན་ལས་བྱུང་བ་ནི་ཐ་སྙད་དུའང་ཡོད་པ་མིན་པ་དེའི་ཕྱིར་ལས་སུ་མ་ཟད་བྱེད་པ་པོ་ཡང་རང་བཞིན་གྱིས་མེད་ལ།",
    "ངར་འཛིན་པ་དང་ང་ཡིར་༤ ༢ན་འཛིན་པ་སྤངས་ནས་མེད་པའི་རྣལ་འབྱོར་པ་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་རྒྱུས་འབྲས་བུ་རང་བཞིན་གྱིས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ན་རྒྱུ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་འཐད་པར་མི་འགྱུར་ལ།",
    "དངོས་པོ་རང་བཞིན་གྱིས་གྲུབ་པ་འགའ་ཞིག་ཡོད་ན་དེ་ལ་བརྟེན་པའི་འབྱུང་འཇིག་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པར་རིགས་ནའང་དངོས་པོ་རང་བཞིན་གྱིས་གྲུབ་པ་ནི་མེད་དེ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་ལ་ཕུང་པོ་རང་བཞིན་གྱིས་བརྟེན་པ་མེད་ལ་ཕུང་པོ་དེར་ཡང་དེ་བཞིན་གཤེགས་པ་དེ་ཉིད་རང་བཞིན་གྱིས་བརྟེན་པ་མེད་ཅིང་དེ་བཞིན་གཤེགས་པ་ནི་ཕུང་པོ་དང་རང་བཞིན་གྱིས་ལྡན་པ་ཡང་མིན་ན་དེ་བཞིན་གཤེགས་པ་རང་བཞིན་གྱིས་གྲུབ་པ་ནི་གང་ཞིག་ཡིན་ཏེ་གང་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གཞན་ལ་བརྟེན་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་མི་འགལ་ཞེ་ན།",
    "དེས་ན་སྟོང་མི་སྟོང་དང་རྟག་མི་རྟག་སོགས་ལ་བརྟེན་པའི་མཐར་འཛིན་གྱི་ལྟ་བས་གང་དུའང་རང་བཞིན་གྱིས་གདགས་པར་མི་ནུས་ཏེ།",
    "གང་ལ་བརྟེན་ནས་སྡུག་པ་ཞེས་གདགས་པར་བྱ་བ་མི་སྡུག་པ་དེ་ནི་སྡུག་པ་ལ་མ་སྡུག་གཉིས་རང་བཞིན་མེད་པས་ཆགས་སྡང་རང་བཞིན་ཡོད་པ་དགག་པའོ།",
    "དེའི་རྒྱུ་ཅན་གྱི་ཞེ་སྡང་རང་བཞིན་གྱིས་ཡོད་པར་ག་ལ་འགྱུར་ཏེ་མི་འགྱུར་རོ།",
    "དེ་གཉིས་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར་ཆགས་སྡང་རང་བཞིན་གྱིས་མེད་ཅེས་པའོ།",
    "ལོག་པར་འཛིན་པའམ་ཡང་དག་པ་ཉིད་དུ་འཛིན་པ་གང་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ན།",
    "དེར་མ་ཟད་དངོས་པོ་རྣམས་ལ་རྒྱུ་རྐྱེན་མེད་ན་དངོས་པོ་རྣམས་འབྲས་བུ་ཡིན་པ་མི་འཐད་ཅིང་གང་ཡང་དངོས་པོའི་རྒྱུ་ཉིད་དུ་མི་འཐད་པ་དང་རང་བཞིན་ལ་བྱེད་པ་པོ་དང་བྱེད་པ་དང་བྱ་བ་ཡང་མི་འཐད་ཅིང་སྐྱེ་བ་དང་འགག་པ་དང་བྱ་བ་བརྩམས་པའི་འབྲས་བུ་ཡང་མི་འཐད་པས་ཐ་སྙད་ཀུན་ལ་ཡང་གནོད་པ་བྱེད་པ་ཡིན་ནོ།",
    "ཀུན་འབྱུང་རང་བཞིན་ཉིད་ཀྱིས་ནི།",
    "གཞན་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ལ་གནོད་པ་བྱེད་ན་བུམ་པ་སོགས་དངོས་པོ་ཐམས་ཅད་མ་བྱས་པར་ཡོད་པར་འགྱུར་བར་དེ་ལྟ་ན་བུམ་པ་བཟོ་བ་སོགས་བྱ་བ་ཅི་ཡང་མེད་པར་འགྱུར་ཞིང་།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་གྲུབ་པ་སྤྱིར་དགག།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་དཔེའོ།",
    "དེ་ཚུལ་ཡང་རང་བཞིན་གྱིས་ཡོད་ན་གཞན་དུ་འགྱུར་བ་མི་རིགས་པས་རྟག་ལ།",
    "ཕན་ཚུན་ལས་ཀྱང་རང་བཞིན་ཡོད་པར་མ་གྲུབ་སྟེ།",
    "དེ་ཡང་རང་བཞིན་གྲུབ་པའི་ཕྱོགས་ལ་གཅིག་དུས་སུ་གཅིག་ཡོད་དགོས་པར་རིགས་པས་འཕུལ་བ་ཡིན་གྱི་རང་ལུགས་ལ་མ་ཡིན་པའི་ཚུལ་ཤེས་པར་བྱའོ།",
    "ཅེས་པའི་འགྲེལ་པ་རྣམས་གོ་དཀའ་བར་འདུག་པས་ཡི་གེ་ཆད་ལྷག་བྱུང་བ་ཡིན་ནམ་ད་དུང་དཔྱད་དོ།",
    "དེ་མེད་ཕྱིར་ཞེས་པའང་རང་ལས་མེད་པའི་ཕྱིར་ཞེས་པའི་དོན་དུ་བྱས་ནས་དེས་གཞན་ལས་ཡོད་པ་བཀག་གོ།",
    "མ་ཡིན་ཏེ་རྟགས་སུ་སྨྲས་པའི་རྟོག་བློ་དེའང་རང་བཞིན་མེད་པས་བསྒྲུབ་བྱ་དང་མཚུངས་པའི་ཕྱིར་རོ།",
    "འདུས་པའང་རང་བཞིན་གྱིས་འདུས་པས་མི་འདུས་པའི་སྐབས་མེད་ཅིང་།",
