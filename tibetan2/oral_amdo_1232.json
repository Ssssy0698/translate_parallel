    "མེ་ཏོག་ཕལ་ཆེར་ཉིན་རེའི་རྒྱན།",
    "གཙུག་གི་ནོར་བུ་གང་དུའང་མཆོད།",
    "ལྷག་པར་དུ་བརྐྱངས་བསྐུམས་མ་འབུམ་ཕྲག་གཅིག་སོང་ཚུལ་སོགས་ཞུས་པརཐུགས་ཧ་ཅང་མཉེས་པའི་ཚུལ་གྱིས་ད་ནས་བརྐྱངས་བསྐུམས་མ་གསུང་མི་དགོས་འགྲུབ་ཡོད་ཅེས་གསུངས་ཞོར་དུ་ཕྱག་གིས་ནམ་མཁར་རལ་གྲི་འཕྱར།",
    "ད་ཞབས་བརྟན་ཡོད་ཀྱི་གསུང་བཀོད་ཅིག་བཀའ་དྲིན་སྐྱོང་རྒྱུ་ཞུས་པརབསྒྲུབས་ཚར་སོང་ཞེས་དགོངས་གཞི་ཅན་གྱི་གསུང་ལན་གནང་ཅང་མེད།",
    "ཉིད་རེབ་གོང་ཕྱོགས་སུ་ཕྱགས་བཏེག་པར།",
    "བསྟན་པའི་བྱ་བ་ཅུང་ཟད་ཙམ་བྱས་ཀྱང་དུས་ཀྱི་ཐ་མར་གྱུར་པའི་རྐྱེན་གྱིས་འདོད་པའི་སྟེང་དུ་མ་སོང་བའང་མང་།",
    "སྒྲིག་ལམ་གྱི་རིམ་པ་ཐམས་ཅད་ཁྱེད་ཀྱིས་གཟིགས་རྟོག་དང་།",
    "ལུས་ཅན་མཐའ་དག་གི་ཕན་བདེ་སྤྱི་དང་།",
    "དུ་མཐོང་ཐོས་དྲན་རེག་གིས་བསྡུས་པའི་འབྲེལ་ཐོགས་ཐམས་ཅད་མ་འོངས་པར་རྗེ་བཙུན་བྱམས་པའི་འཁོར་གྱི་ཐོག་མར་གྱུར་ནས་ཐར་བའི་ལམ་བཟང་མངོན་དུ་བྱེད་པའི་ཐུགས་སྨོན་གནང་བ་དང་།",
    "ལྗགས་ལུང་ཕྲན་ཚེགས་འགའ་རེ་སྩལ་པས་ཐུགས་ཀྱི་རེ་བ་ཡོངས་སུ་བསྐངས།",
    "དེའི་དགྲ་ཆོག་གི་ལྗགས་ལུང་སོགས་སྩལ།",
    "གཏོར་མ་བརྒྱ་རྩའི་ཕྱག་ཁྲིད་སོགས་འདོད་མོས་ལྟར་གནང་།",
    "རྣམ་འཇོམས་གསུམ་གྱི་སྐུ་བརྙན་ཞལ་ཤར་གཟིགས་སུ་བཞུགས་པ་ཞིག་བཞེངས་ན་ཕན་པ་ཆེ་གསུངས་པ་ལྟར་བཞེངས་པས་ཕྱིས་སུ་ས་སྒྲིབ་ཀྱི་གནོད་པ་ཐམས་ཅད་ཞི་བར་གྲགས་སོ།",
    "གཟུངས་སྔགས་འགའི་ལྗགས་ལུང་སོགས་འདོད་མོས་ལྟར་སྩལ།",
    "མ་ཎིའི་ལྗགས་ལ་ལར་བསྙེན་གནས་ཀྱི་སྡོམ་པ་སོགས་སྩལ་ཏེ་སོ་སོའི་ཡིད་ཀྱི་རེ་བ་ལུང་།",
    "མཐོང་ཐོས་དྲན་རེག་གིས་ལུས་ཅན་མཐའ་དག་ལ་ཐར་བ་དང་ཐམས་ཅད་མཁྱེན་པའི་ས་བོན་ཁྱད་པར་ཅན་བསྐྲུན་པར་མཛད།",
    "དེ་དག་གི་ཚེ་དགོན་གྲོང་སོ་སོའི་སེར་སྐྱ་ཐམས་ཅད་ལ་གསུང་རྒྱུར།",
    "ང་ལོ་ན་རྒས་པས་ཕྱིན་ཆད་ང་ཚོ་འཕྲད་མི་འཕྲད་མི་ཤེས།",
    "རང་རེའི་ཡུལ་ཕྱོགས་འདིར་གོང་ས་སྐྱབས་མགོན་ཐམས་ཅད་མཁྱེན་པ་བཞུགས་ཡོད་པས་ཁོང་ལ་རེ་ལྟོས་བཅོལ་ཏེ་བྱ་བ་ཆེ་ཆུང་དང་ལེགས་ཉེས་ཐམས་ཅད་ཁོང་ལ་སྐྱབས་འཇུག་ཞུས།",
    "ད་ལྟ་སྙིགས་མའི་དུས་མཐར་སོང་བས་དཀར་ཕྱོགས་སྐྱོང་བའི་ལྷ་རྣམས་མཐུ་སྟོབས་ཉམས་པ་དང་།",
    "གཞན་དག་རང་གི་དོན་དུ་ཡང་།",
    "ང་རང་ལོ་ན་རྒས་པས་ད་ཕྱིན་ཆད་ང་ཚོ་ཨེ་འཕྲད་མི་ཤེས།",
    "ཞེས་གསུངས་པ་དེར་འདུས་ཀྱི་གདུལ་བྱ་རྣམས་ལ་གསུང་གི་ཐ་མར་གྱུར།",
    "རོང་བར་བཅས་ཀྱི་རྟ་བ་ལྔ་བརྒྱ་ལྷག་གིས་རྟ་བསུ་དང་།",
    "དེ་ནས་དྲི་ཞིམ་པའི་སྤོས་སྣ་དང་བཅས་བླ་བྲང་ཆེན་མོའི་ཚོམས་ཆེན་ནང་གདོང་ལྔས་བཏེག་པའི་ནོར་བུའི་ཁྲི་འཕང་མཐོན་པོར་ཞབས་ཟུང་གསེར་གྱི་འཁོར་ལོ་མཛེས་པར་འཁོད་དེ།",
    "ད་རེབ་བྲེལ་བ་ཆེ་བས་ཁོམ་མེད།",
    "ལྷ་མོ་དམག་ཟོར་མའི་རྗེས་གནང་།",
    "རྒྱུན་དུ་བསམ་པ་བཟང་བོ་རེ་བྱས་ཏེ་དེ་ལ་གོམས་པར་བྱ་དགོས།",
    "ཞེས་གསུངས་ཡོད་པ་ལྟར་རེད།",
    "བསམ་པ་དེ་ཡོད་ན་རྐྱེན་ངན་བར་ཆད་གང་གིས་ཀྱང་མི་ཚུགས་ཤིང་།",
    "དཔལ་ལྡན་ལྷ་མོ་ནི་ངེད་ཀྱི་སྲུང་མའི་གཙོ་བོ་ཡང་ཡིན།",
    "ཁྱེད་ཀྱི་སྐུ་རིང་འདི་སྔོན་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་གོང་མས་དཔལ་ལྡན་ལྷ་མོ་ལ་གཉེར་གཏད་གནང་ཡོད་པས་ཁྱེད་ཀྱི་སྲུང་མའི་གཙོ་བོ་བྱེད་དགོས།",
    "འདི་ལ་འཕྲིན་བཅོལ་རེ་གནང་ན་འཕྲིན་ལས་མྱུར་ཞིང་སྐུ་དོན་ཐམས་ཅད་བསྒྲུབ་ངེས་ཡིན།",
    "ད་ལྟ་རང་གི་སྣ་ཐག་རང་གིས་འཛིན་དགོས་པ་མ་གཏོགས་ཡང་ཞལ་ནས།",
    "འདོད་ཡོན་བདུད་ཀྱི་གཡབ་མོ་ཡིན།",
    "ངས་ཁྱེད་ལ་རེ་བ་ཆེན་པོ་བཟུང་ཡོད།",
    "དེའི་རྐྱེན་གྱིས་ལུང་རྒྱུན་གང་ཡོད་སྤེལ་ཅི་ཐུབ་རེ་བྱ་རྒྱུ་ཐུགས་ལ་འཛིན་དགོས།",
    "མན་ངག་མང་བོའི་རྒྱུན་རྣམ་དག་རེ་བཙལ་ནས་ཁྱེད་ཀྱིས་ཉན་ཐབས་བྱོས།",
    "སྒྲུབ་པ་ཉམས་ལེན་གྱི་བཟང་ངན་འགྲན་བསྡུར་བྱེད་པ་ཉིན་སྐར་བཞིན་དུ་སོང་བ་དང་།",
    "ད་དུང་བསྟན་པ་འཇིག་པའི་དུས་ལ་སླེབས་མེད་པས་བསྟན་པའི་གཟུགས་བརྙན་ཙམ་ད་དུང་ཅུང་ཟད་གནས་རྒྱུ་རེད།",
    "འདི་འདྲའི་བཟོ་བོ་ཞིབ་མོ་ཅན་ཞིག་ཧ་ཅང་དཀོན།",
    "རྒྱ་གར་ཐེར་མ་སེར་བོ་དང་དམར་བོ་གྱོན་འདང་རེ།",
    "གཙོས་སེར་སྐྱ་དམངས་ཚོགས་རྟ་བ་སྟོང་ཕྲག་ལྷག་གིས་རྟ་བསུ་དང་།",
    "སེར་སྐྱ་སོ་སོའི་རེ་འདོད་ལྟར་དུ་ལྗགས་ལུང་ཕྲན་ཚེགས་སྣ་ཚོགས་ཀྱི་བཀའ་དྲིན་སྩལ་ཞིང་།",
    "གསེར་མཁར་དགུ་ཐོག་གི་ལྷ་ཁང་གཙོ་བྱས།",
    "གཙོ་བོ་རང་བསྟན་རང་གིས་བཤིག་རང་གཉེན་རང་གི་དགྲར་ལང་བའི་དུས་སུ་སླེབས་པ་འདི་ལས་གནོད་པ་ཚབས་ཆེ་བ་མེད་དེ།",
    "ཐོས་བསམ་གྱི་བྱ་བས་ཉིན་མཚན་འདའ་བ་ཉིན་སྐར་ཙམ་དུ་སོང་བ་དང་།",
    "བྱིས་པ་འཐབ་མོ་འཛིན་པས་བདག་དང་གཞན་འཕུང་བར་བྱེད་པ།",
    "བཅོམ་ལྡན་འདས་འོད་སྲུང་གིས་ཀྱང་།",
    "འདི་འདྲའི་བསྟན་པ་ཉམས་ཆགས་སུ་འགྲོ་བའི་རྒྱུ་རྐྱེན་སྣ་ཚོགས་ལུང་གི་རྒྱབ་བརྟེན་དང་བཅས་གསུངས་པ་སྐབས་འདི་མ་གཏོགས་མེད་པས།",
    "ཁོང་གི་ཞལ་ནས།",
    "ཁོང་ཐུགས་རྗེ་ཅན་གྱི་གསུང་ཐུགས་དག་པོ་རེད།",
    "དཔལ་མོ་ལུགས་ཀྱི་ཐུགས་རྗེ་ཆེན་པོ་དང་།",
    "གཟིམ་ཆུང་གི་སྒོ་ཁར་སྐུ་དངོས་ཕེབས་ཀྱིས་མཇལ་དར་རྩེ་སྤྲོད་གནང་བར་གནོན་མི་ཐུབ་པའི་དགའ་སྤྲོ་བསམ་གྱིས་མི་ཁྱབ་པ་བྱུང་།",
    "བདག་གིས་སྔོན་ནས་བཟུང་ཞུ་བ་ཐེངས་གསུམ་ཕུལ་པ་དང་སྐབས་འདིར་ཡང་ཆེད་དུ་གསོལ་བ་བཏབ་པ་ལ་བརྟེན་ནས་བདག་དང་།",
    "འཇམ་མགོན་བསྟན་པའི་སྲོག་ཤིང་གཅིག་བུ་སྐྱབས་རྗེ་མི་ཉག་རྡོ་རྗེ་འཆང་གིས་གསང་སྟོན།",
    "ཐོས་རྐྱང་ཁོ་ནར་སོང་བས་ནང་གི་ཉམས་ལེན་ལྟ་ཅི།",
    "ངན་གཡོ་སྣ་ཚོགས་པའི་ཐབས་ཀྱིས་མདའ་སྐད་གླིང་བུར་བསྒྱུར་པའི་འགལ་རྐྱེན་ཅི་ལ་ཐུག་ཅིང་རང་གི་བློ་སྣ་འགྱུར་པ་དང་གཞན་གྱིས་ཐག་ཞོར་འབྲེང་དྲུད་ལྟ་བུ་མ་བྱུང་བར།",
    "ལས་ཀྱི་ཁ་སྐོང་བའི་དགེ་སློང་རྣམས་ལ་སྐུ་གཟན་གྱི་རྒྱུ་རྒྱ་ཐེར་དང་དངུལ་ཊཾ་བརྒྱ་རེ་བཅས་ཀྱི་དངོས་འབུལ་སྤུས་ལེགས་ཕུལ་པ་སོགས་མཁན་སློབ་འཁོར་དང་བཅས་པར་དངོས་འབྱོར་གྱི་མཆོད་སྤྲིན་རྒྱ་མཚོ་དཀྲིགས།",
    "ཉིན་ཞིག་སྐྱབས་མཆོག་རྡོ་རྗེ་འཆང་གི་ཞལ་ནས།",
    "བདག་གི་ཚེ་ལ་བར་ཆད་རེ་མ་བྱུང་ན་རྗེས་སུ་ངེས་པར་མཇལ་ཡོང་ཞེས་བཀའ་སྩལ་པ་གསུང་གི་ཐ་མར་གྱུར།",
    "གསེར་ཁོག་བཙན་པོ་ནོ་མོ་ཧན།",
    "ཡོངས་རྫོགས་ཆིབས་ཀྱི་ཁ་ལོ་བསྒྱུར་ཏེ་དམངས་ཚོགས་སྟོང་ཕྲག་ལྷག་གིས་རྟ་བསུ་དང་།",
    "རོང་བོ་དུས་འཁོར་གྲྭ་ཚང་གི་གར་འཆམ་དང་འདྲ་འདྲ་རེད།",
    "ཆེད་མངགས་མི་སྣ་རླངས་འཁོར་དང་བཅས་པ་འབྱོར་པས་དགོངས་པ་ནན་ཞུ་མཛད་ཀྱང་རྒྱལ་ཁབ་ཀྱི་བཀའ་བཙན་པས་མི་ཕེབས་ཐབས་མེད་བྱུང་རྐྱེན་སྐྱབས་རྗེ་མཆོག་གིས་ཕྲན་ལ་གསུང་རྒྱུར།"
  ]
}