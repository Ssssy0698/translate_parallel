    "ད་ནས་བཟུང་ལོ་རེ་ལ་ས་འདིར་གཏེར་མང་བོ་རེ་ཕུལ་ན་བཟང་།",
    "ནང་སོ་སྐུ་མཆེད་སོགས་ཆིབས་སྐྱེལ་བ་རྣམས་ཕྱིར་ལོག་རྗེ་སྟོན་འཁོར་རྣམས་གཅན་རྫ་བརྒྱུད་དེ་དགོན་སར་ཞང་མོ་ཆེ།",
    "རྒྱལ་མཆོག་ལྔ་བའི་ཡང་གསང་གི་ཆོ་ག་རྡོ་རྗེ་སྒྲ་དབྱངས་དང་།",
    "ཁྱོད་ཅག་ཐམས་ཅད་འདི་འདྲའི་འཇིགས་སྐྲག་བྱེད་མི་དགོས།",
    "རང་རང་གི་ཞིང་ལས་དང་།",
    "ཨ་རིག་སྨར་སྐམ་སྤྲུལ་པའི་སྐུ་ལོ་གཅིག་གི་རིང་ཁྲིར་བཞུགས་རྗེས་དགོངས་པ་ཡང་ཡང་ཞུས་མཐར་ཞལ་བཞེས་གནང་།",
    "འབྲེལ་ཐོགས་དོན་ལྡན་མཛད་པའི་ཐབས་སུ་ལོ་འདི་དག་གི་སྐབས།",
    "ཟང་ཟིང་གི་དངོས་འབྱོར་སྡུད་པ་དང་།",
    "ཚར་གཅོད་འོས་པ་རྣམས་ལ་བབ་བསྟུན་གྱི་ཚར་གཅོད་མཛད་པ་སོགས་ཚར་གཅོད་རྗེས་འཛིན་ཟུང་འབྲེལ་གྱི་སྒོ་ནས་སྒྲིག་ལམ་ཕྲ་ཞིབ་དམ་འཛིན་གནང་འཆད་ཉན་ཀྱང་ལོ་རེ་ལས་ལོ་རེར་ཆེས་ཆེར་འཕེལ་རྒྱས་བྱུང་བ་དང་།",
    "གོས་ཕྲུག་ལྔ་རེ་གནང་ཞིང་རྗེ་ཉིད་ཀྱི་རྒྱུན་བཞེས་སྐུ་འགག་རེ་རྟེན་སྐལ་དུ་སྩལ་ཏེ།",
    "གཞི་འདི་ལྟ་བུ་གཏན་ནས་བསླང་མི་ཆོག་པའི་གསུང་ནན་ལྕི་མོ་ཕེབས་པར་བརྟེན།",
    "ཐང་ནག་གི་དམག་རྣམས་ཕྱིར་འཐེན་དུ་བཅུག་དེར་འཁོད་ཀྱི་རྒྱ་རིགས་དང་ཧོས་རིགས་ཀྱི་ཕོ་མོ་རྒན་གཞོན་ཐམས་ཅད་དགའ་སྤྲོ་བླ་ན་མེད་པ་སྐྱེས་ཤིང་རྗེ་ཉིད་ལ་མི་ཕྱེད་པའི་དད་པ་ཐོབ་སྟེ།",
    "དེའི་ཕྱོགས་ཀྱི་སེར་སྐྱ་མང་ཚོགས་ནས་གསོལ་བ་བཏབ་པ་དང་།",
    "རྙེ་སྐུ་ཕྲེང་ལྔ་བ་བློ་བཟང་འཕྲིན་ལས་རབ་རྒྱས་ཀྱི་ཡང་སྲིད་རྐང་ཚའི་ཞྭ་ནག་ཇོ་སྐོར་ཚོ་བའི་བྱིས་པ་ཞིག་ལ་ངོས་འཛིན་གནང་སྟེ་ཐུགས་བརྟག་བཅད་པས་དགོན་གྲོང་སེར་སྐྱ་ཐམས་ཅད་ཀྱི་རེ་བ་ཡོངས་སུ་བསྐངས།",
    "དགུང་ལོ་རེ་གསུམ་པ་ལྕགས་སྟག་ལོར་གནམ་ལོ་གསར་ཚེས་ཀྱི་དགའ་སྟོན་སོགས་དཀྱུས་ལྟར་གནང་།",
    "འདི་ནི་མི་མ་ཡིན་ནག་ཕྱོགས་པ་ཞིག་གི་ཆོ་འཕྲུལ་ཙམ་རེད་གསུངས་ཏེ།",
    "སྟིས་ཚང་མཚམས་པ་བ་ཟེར་བའི་རི་ཁྲོད་པ་འཇིགས་བྱེད་བསྙེན་ཆེན་ཚར་བདུན་སོང་བ་ཞིག་བཞུགས་པ་དེ་ལ།",
    "ཁྱོད་གནས་རིའི་མེ་ཏོག་ལུང་བའི་ཕུག་ཏུ་སོང་ལ།",
    "ཡི་གེ་བཞི་བའི་བསད་བཟློག་གི་ཁྲིད།",
    "སྒྲོལ་དཀར་ཚེ་ཁྲིད་ཐུན་མོང་མ་ཡིན་པ་བཅས་དང་།",
    "ས་ག་ཟླ་བའི་ཡར་ཚེས་ནས་ཆིབས་བཏེག་སྟེ་སྟོན་འཁོར་ཡོངས་རྫོགས་ཀྭ་རིང་དང་རེབ་གོང་ཕྱོགས་སུ་བྱོན།",
    "ནང་ཆེན་གྱི་རྟ་དྲེའུ་རྣམས་ཀྱིས་མཚེར་ནག་མགོན་པོ་རྡོ་རྗེ་ཟེར་བའི་ཁྱིམ་ཚང་གི་ལོ་ཏོག་ཐམས་ཅད་ཟོས་ནས་ས་ཞིང་ལ་གནོད་པ་ཚབས་ཆེན་བྱས་པ།",
    "ཁྱོད་ཅག་རྣམས་ཀྱིས་ཅི་ཉེས་ཞེས་གསུངས་པར།",
    "ཁྱོད་རང་ཁོང་ཁྲོ་མ་སྐྱེ།",
    "ལོ་རེར་རྒྱུན་མ་ཆད་པར་རྗེ་ཉིད་ལ་གསོལ་ཕྱེ་བཟང་བོ་དྲེའུ་ཁལ་གཅིག་རེ་མ་ཆད་པར་ཕུལ།",
    "ཕུ་དུད་ཆེན་པོས་བསྙེན་བཀུར་ཟབ་རྒྱས་ཞུས་ཤིང་བླ་གྲྭ་ཐུན་མོང་ནས་གསོལ་བ་ཕུར་ཚུགས་སུ་བཏབ་པར།",
    "ལྷ་མོ་དམག་ཟོར་མ།",
    "ཐེག་ཆེན་གསོ་སྦྱོང་གི་སྡོམ་ལུང་དང་།",
    "རིགས་གསུམ་མགོན་པོའི་གཟུངས་སྔགས་སོགས་སྩལ་ཏེ་དད་ལྡན་སྐྱེ་བོ་ཡོངས་ཀྱི་རེ་བའི་འདོད་པ་ཡོངས་སུ་བསྐངས།",
    "རྗེ་ཉིད་ཀྱིས་ཞག་གཅིག་གི་རིང་ཆིབས་སྐྱེལ་མཛད་དེ།",
    "སྐྱབས་རྗེ་ཉིད་ཀྱང་སྐུ་འབུམ་གྱི་བླ་སྤྲུལ་ཆེ་ཁག་གི་གྲས་སུ་བཞུགས་སུ་བཅུག་སྟེ་སྤྱན་བསྐྱངས་གཞན་ལས་འབུར་དུ་ཐོན་པ་གནང་།",
    "རྗེ་ཉིད་ཀྱིས་ཀུན་གཟིགས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ཆེན་པོར་གཟིམ་ཆུང་དུ་མཇལ་ཁ་ཞུས་ཐོག་གསོལ་ཇ།",
    "ཀུན་གཟིགས་ཐམས་ཅད་མཁྱེན་པས་ཀྱང་།",
    "གྲྭ་ཚང་གིས་སེར་སྦྲེང་དང་རྗེ་རང་ཉིད་ཀྱིས་སྤོས་སྣ་དང་བཅས་གཙུག་ལག་ཁང་དུ་བཞུགས་སུ་གསོལ།",
    "རྗེ་རང་ནས་ལྷ་མོའི་འཕྲིན་བཅོལ་དང་།",
    "ཁྱོད་ཚོ་སོང་ནས་ཤིང་ཆ་རྣམས་བླང་ཆོག་གསུངས།",
    "དེ་ནས་ལས་གཉེར་བ་རྣམས་རྨ་ཆུའི་ཁར་སོང་བའི་ཚེ།",
    "ཕྱོགས་འདིའི་སྐྱེ་བོ་ཕོ་མོ་ཐམས་ཅད་ཀྱིས་མགྲིན་གཅིག་ཏུ།",
    "གཞི་བྱེས་ཀྱི་སྐྱེ་བོ་ཕོ་མོ་རྒན་གཞོན་བར་གསུམ་སུ་ཞིག་གིས་གཙུག་ལག་ཁང་འདི་ལ་ལུས་དང་།",
    "གཙུག་ལག་ཁང་རྟེན་དང་བརྟེན་པ་ཐམས་ཅད་ད་ལོར་འགྲུབ་ནས་ལོ་རྗེས་མར་གཏོར་བཤིག་བཏང་སྟེ་རྩ་མེད་དུ་སོང་ཡང་འགྱོད་པ་སྤུ་ཙམ་མེད།",
    "འདི་ལ་འབྲེལ་ཆེ་ཐོགས་ཆུང་ཐོགས་ཐམས་ཅད་ཀྱིས་ལྷག་བསམ་རྣམ་དག་གི་སྒོ་ནས།",
    "གང་ལ་རང་གི་ཤེས་རབ་མེད།",
    "བློ་དང་ལྡན་པ་ཚིག་གཅིག་གིས།",
    "འཆང་ཆེན་པོའི་བཀའ་གསུང་འདི་ལ་ཞིབ་ཏུ་དཔྱད་ཚེ་ལེགས་པོ་ཞིག་གཏན་ནས་མ་རེད།",
    "གཞན་བླ་དཔོན་སེར་སྐྱ་ཐམས་ཅད་ཀྱང་རྟག་འཛིན་གྱི་འཆིང་བ་དམ་པས་རང་རང་སར་རང་རང་དྲེགས་པའི་སྙེམས་པ་དང་བཅས་འཇིག་རྟེན་ཟང་ཟིང་གི་བྱ་བར་འུར་ལངས་རྒྱ་ཆེ་བས་ཀུན་ལ་དོགས་བ་ཙམ་ཡང་མ་སྐྱེས་པར།",
    "རྡུལ་ཚོན་འགྱེད་པའི་བར་གསེང་དུ་ཐུགས་རྗེ་ཆེན་པོ་དཔལ་མོ་ལུགས་དང་།",
