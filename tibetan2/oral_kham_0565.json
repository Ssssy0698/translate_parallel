    "མཐོང་ཐོས་མྱོང་གསུམ་གྱི་གོ་རིམ་རྣམས་ངོ་སྤྲད་རྒྱུ་ཡིན་ནོ་ཞེས་ཐོག་མར་སེམས་བསྐྱེད་ཡོད་པར་འདུག་ཅིང་།",
    "འདི་ལ་བཙན་བྱོལ་ནང་དུ་ཕྱི་ལོ་ཞེས་འབྲི་བཞིན་འདུག་ལ།",
    "ཕྱི་ལོ་ཞེས་བཏགས་ན་འགྲིག་ཅེས་གཞུང་ངོས་ནས་གཏན་ལ་ཕབ་པ་ཞིག་ཡིན་པར་འདུག།",
    "ནང་པའི་རྒྱལ་ཁབ་མང་ཆེ་བས་དེ་ཉིད་དག་པར་འཛིན་གྱི་ཡོད་སྐད་འདུག་པས།",
    "རྒྱ་གར་དུ་འགྲོ་རྒྱུའི་བསམ་པ་ཞིག་ཡོད་གསུངས་འདུག་ལ།",
    "པཎྜི་ཏ་ར་ཧུ་ལ་ཞེས་པ་དེ་བོད་ནང་དུ་ཕེབས་དོན་ཅི་ཡིན་སྐོར་གྱི་རྩོམ་ཞིག་ལ་ངས་སྔོན་ཆད་བལྟས་མྱོང་བའི་དོན་སྤྱི་ཙམ་ཞིག་སེམས་ངོར་ལུས་འདུག་པ་ལས།",
    "ཁོང་རང་ལ་དངུལ་ཀྱང་ཡང་མང་པོ་འདུག་ཅིང་།",
    "ད་དུང་བོད་ནང་ལ་ནི་གནའ་བོའི་རྒྱ་གར་གྱི་དཔེ་རྙིང་སོགས་ཡོད་ངེས་སྙམ་ནས་པཎྜིཏ་ར་ཧུ་ལ་ཞིབ་འཇུག་བྱེད་དུ་ཕེབས་པ་ཡིན་འདུག་དེས་ན་བསྟན་པ་ཕྱི་དར་གྱི་ཐོག་མའི་དུས་སུ།",
    "བྲག་རྒྱབ་སོགས་བཀའ་གདམས་པའི་གདན་ས་མིང་ཆེ་ཆེ་ཕལ་ཆེར་ལུང་པ་དེའི་མགོ་མཇུག་ཙམ་ལ་འདུག་ཅེས་གསུངས་པ་ལྟར།",
    "སྔོན་གྱི་གདན་ས་ལྷ་ས་ལས་ཀྱང་ཕྱོགས་དེ་ན་མང་བ་ཙམ་འདུག་ཅེས་གསུངས་འདུག་ཁྱེད་རྣམ་པའི་ནང་དུ་འཕན་པོའི་ས་ཆར་བྱོན་མྱོང་མཁན་མང་པོ་ཡོད་ངེས་ཏེ།",
    "ཁ་ཞེང་ཆེ་བ་ཞིག་ཡིན་པར་གསུངས་འདུག་པོ་ཏོ་བའི་སྐོར།",
    "དེ་འདྲ་ལོས་ཡིན་བསམ་པ་ཞིག་བྱོན་ཡོད།",
    "དུས་དེའི་བཤེས་གཉེན་དག་ལ་བུ་སློབ་ཀྱི་གྲངས་བགྲང་ཚུལ་ཁྱད་མཚར་ཞིག་འདུག་དཔེར་ན།",
    "དེ་དང་དེ་ལ་སོགས་པ་བཀའ་གདམས་པའི་གདན་ས་མང་ཆེ་ཤོས་ཕལ་ཆེར་ལུང་པ་དེའི་མགོ་མཇུག་ཙམ་ལ་འདུག་གསུངས།",
    "བཀའ་གདམས་པའི་དགོན་རྙིང་དེ་ཀུན་ཕལ་ཆེར་མཆོད་རྟེན་གྱིས་གང་བསྡད་པ་ལྟ་བུར་འདུག་ཅིང་།",
    "ནཱལེནྡྲའི་དགོན་ཤུལ་རྣམས་ན་མཆོད་རྟེན་ཆེ་ཆུང་གྲངས་ཀྱིས་མི་ལང་བ་ལྟ་བུ་འདུག་པས་སྔོན་གྱི་སྲོལ་དེ་ག་རང་ཡིན་འདུག་ཅེས་བྱུང་ཡོད།",
    "ཞེས་གསུངས་འདུག།",
    "ཞེས་གསུངས་འདུག་ནའང་།",
    "རྒྱལ་ལྷ་ཁང་ག་དུས་བཞེངས་པ།",
    "འགོས་ལོར་ག་དུས་ཡིན་ན།",
    "དེ་ནི་ཕྱི་ལོ་ལོ་ཡིན་པར་འདོད་ཀྱི་འདུག་དེ་ལྟར་ཁས་བླངས་ཚེ་སྲོང་བཙན་དགུང་ལོ་སོ་བཞི་ལས་མ་བཞུགས་པའི་ལུགས་ཀྱི་འཁྲུངས་འདས་ལོ་ཚིགས་དང་མཐུན་གྱི་ཡོད་ལ།",
    "བཙན་པོའི་ཆབ་སྲིད་ཀྱི་གནས་སྟངས་ཟིང་ཟིང་ལོང་ལོང་དུ་གྱུར་པར་གསུངས་འདུག་ད་དུང་།",
    "སྐབས་འདི་དུས་ཙ་ན་ལྷག་ཏུ་མངོན་གསལ་ཇེ་ཆེར་ཕྱིན་པས།",
    "གླེགས་ཤིང་མེད་པར་ཤོག་བུ་རྗེན་པར་བརྩིགས་པའི་རྩེ་གནམ་ལ་ཐུག་ཐུག་ཏུ་ཡོད་པ་དེ་འདྲ་འདུག་ཅིང་།",
    "གླེགས་བམ་དེ་དག་ཆེས་གནའ་བོའི་དུས་ཀྱི་ཡི་གེ་རྙིང་མ་རང་དུ་འདུག་ཅིང་།",
    "འདི་རྒྱ་གར་ནས་འཁྱེར་ཡོང་བར་འདུག་ཟེར།",
    "ཞེས་གསུངས་འདུག་སྐུ་དེའི་རྒྱབ་ཡོལ་དུ་རྡོ་བརྐོས་བོད་ཡིག་ཡོད་པས་མི་ཚད།",
    "རྒྱ་གར་ལ་རྡོ་སྐུ་སྣ་ཚོགས་བཞེངས་རྒྱུ་དར་བ་དེའང་གྷི་རི་སིའི་ཤུགས་རྐྱེན་ལས་བྱུང་བ་ཡིན་པར་འདུག་སྟེ།",
    "ཕན་ཚུན་ཤུགས་རྐྱེན་མང་པོ་ཐེབས་ཡོད་པར་འདུག་ཀུཤཱཎའི་རྒྱལ་རབས་ཞེས་པ་དེ་ནི།",
    "ཨེ་ལེག་ཟན་ཏར་ཁོ་རང་རྒྱ་གར་ཡུལ་དབུས་སུ་ལོ་གཉིས་ཙམ་ལས་མ་བསྡད་ཀྱང་།",
    "ལར་སྔོན་གྱི་རྒྱ་སྐད་གདངས་ཅི་ལྟར་ཐོན་པ་ཙམ་བོད་ཡིག་ལ་བྲིས་པ་ལས་མི་འདུག་ཅིང་།",
    "ལེགས་སྦྱར་གཙང་སང་རྒྱ་ཡིག་ཇི་ལྟ་བ་བཞིན་བྲིས་ཆོག་པ་འདི་དུས་ཕྱིས་ཙ་ན་མཁས་པ་རྣམས་ཀྱིས་མཛད་པ་ཞིག་ཏུ་སྣང་།",
    "རྒྱལ་ལྷ་ཁང་དེ་ལྷོ་རིའི་ཉེ་འདབས་སུ་འདུག་ཅིང་།",
    "བསྟན་པ་ཕྱི་དར་གྱི་མགོ་ལ་བརྩིགས་པའི་དགོན་གནས་དང་ལྷ་ཁང་རྣམས་རྟག་ཏུ་ཐང་དཀྱིལ་ཁོ་ནར་འདུག་ཅིང་།",
    "དེའུ་འབུར་ལྟ་བུའི་རི་ཆུང་དུ་དག་ལའང་རིའི་རྒྱལ་པོ་སོགས་ཐ་སྙད་རྫིག་པོ་དག་སྤྱད་ནས་ཆེ་བ་བརྗོད་ཀྱི་ཡོད་པར་འདུག་དེར་བལྟས་ན།",
    "འགྲམ་གྱི་རི་གཉིས་ཁོ་ན་ལས་མི་འདུག་ས་པཎ་གྱིས་བྱ་རྒོད་ཕུང་པོ་འཕགས་པའི་ཡུལ་གྱི་རི་ཆེན་དུ་གསུངས་པ་ཡང་ཤིན་ཏུ་བདེན།",
    "བྱ་རྒོད་ཕུང་པོའི་རི་ཡང་རི་ཆེན་གྱི་གྲས་སུ་བརྩི་ཆོག་པར་ས་པཎ་གྱིས་གསུངས་པ་དེའང་བདེན་ཞེས་སྨྲས་འདུག་འོན་ཀྱང་།",
    "ཁྱེད་རྣམ་པའི་ནང་ལ་རྒྱ་གར་དུ་བྱོན་མྱོང་མཁན་མང་པོ་འདུག་པས།",
    "ཡིད་ལ་མ་བརྗེད་པར་བཟུང་བྱ་བ་སོགས་འདུག་ཞེས་ཏེ།",
    "བྱ་བ་བཟང་པོ་དང་ལེགས་པའི་ཕྱོགས་སུ་མི་རྣམས་གྲོས་མཐུན་ཡོང་རྒྱུའང་ཧ་ཅང་དཀའ་བར་འདུག་ཅེས་པའོ།",
    "སྒོ་གཉེར་སོ་སོར་བླངས་ཞེས་པའི་དོན་ངས་གསལ་བོ་ཞིག་གོ་ཡི་མི་འདུག་པས།",
    "དེ་ལ་དཀོན་གཉེར་ཞེས་བྲིས་འདུག་འདི་རུ་སྒོ་གཉེར་ཞེས་བྱུང་འདུག་ལ།",
    "ཆིག་སོགས་ཀྱང་འདི་ཁོ་ན་བཞིན་དུ་འདུག་ཞེས་ཏེ།",
    "རྒྱལ་པོ་ཞིག་ཡིན་སོགས་མི་གསལ་བར་གསུངས་འདུག་བཙུགས་པ་ལ་ཞེས་པའི་རྔམ་ཟིལ་དང་ཞེས་ཏེ།",
    "སྲས་དངོས་ཡིན་མིན་གྱི་གླེང་གཞི་བྱུང་ས་དེ་ཡང་འོད་སྲུངས་ཡིན་པར་འདོད་ཀྱི་འདུག།",
    "འདི་འདྲའི་གཏམ་རྒྱུད་ཅིག་ཀྱང་འདུག་སྟེ།",
    "འདིར་ཡང་ཁྲི་དར་མའི་ཚ་བོ་བཀྲ་ཤིས་བརྩེགས་ཞེས་བྲིས་འདུག་སྟེ།",
    "ཙོང་ཁ་རྒྱལ་རབས་ཀྱི་སྲིད་འབྱོར་རིག་གསུམ་གྱི་ལྟེ་གནས་ནི་ད་ལྟའི་ཟི་ལིང་ཡིན་པར་འདུག།",
    "ཁ་ཆེ་དང་རྒྱ་གར་ཡུལ་གྱི་མཁས་གྲུབ་མང་པོ་ཡང་རང་ཡུལ་དུ་སྡོད་མ་ནུས་པར་བོད་དུ་ཕེབས་ཡོད་ལ།",
    "ལོ་ཙཱ་པ་བློ་ལྡན་ཤེས་རབ་ཀྱིས་ཀྱང་གནས་དེར་སྒྲ་སྒྱུར་གྱི་ཕྱག་ལས་གནང་ཡོད་པར་འདུག་ལ།",
    "བསྟན་བཅོས་ཀུན་གྱི་དབུ་ན་རྒྱ་གར་སྐད་དུ་ཞེས་སྦྱར་བ་ཡིན་འདུག་དེ་ནི་རྩོམ་ཁུངས་དག་སྤུས་གཙང་ཡིན་པའི་མཚོན་རྟགས་ལྟ་བུར་བརྩིས་པས།",
    "འཕན་ཡུལ་གྱི་ས་ཆ་གཞན་ཞིག་ན་རྡོ་རིང་གཅིག་གཉིས་ཤིག་ཡོད་སྐད་འདུག་པས།",
    "དེ་དག་ཡིག་ཐོག་ཏུ་འགོད་རོགས་གསུངས་འདུག་འོན་ཀྱང་།",
    "དེའི་སྐོར་འོག་ཏུ་འཆད་རྒྱུ་ཡིན་གསུངས་འདུག་པ་ཚབ་ཀྱི་གདན་སར་འབྱོར་བ་དང་།",
    "ཕྱི་དར་གྱི་མཐོ་ལྡིང་གསེར་གྱི་ལྷ་ཁང་གཉིས་སུ་ནི་ལོ་ཙཱ་པ་རྣམས་ཀྱིས་གཙོ་བོ་སྒྲ་སྒྱུར་མཛད་འདུག་པས།",
    "སིལ་བུའི་དུས་རང་ལ་ནི་བརྒྱ་དང་ཉེར་གཉིས་བྱུང་བ་ཡིན་འདུག་ཡི་གེར་འགོད་མཁན་གྱིས།",
    "འདི་འདྲའི་བསྡོམས་ཚིག་གཅིག་ཀྱང་འདུག་པས།",
    "ཡིན་ཡང་སྐྱོན་ཆེན་པོ་མི་འདུག་སྟེ།",
    "ཅེས་གསུངས་འདུག་ཡ་ད་ཆུ་ཚོད་ཟིན་འདུག་དེ་རིང་དེ་ཙམ་བྱ།",
    "ཁོང་རྣམ་པ་གཉིས་ཀྱིས་མཇལ་མེད་པ་དེ་ཅིའི་ཕྱིར་ཡིན་ནམ་སྙམ་གྱི་འདུག་དེ་ཡང་དུས་རབས་བཅུ་གཉིས་པའི་སྨད་ཙམ་ལ།",
    "སྔ་མའི་ལས་ཀྱིས་བསྐོས་ཐང་ཟེར་ནའང་ཆོག་དེ་འདྲ་ཞིག་ཀྱང་ཏན་ཏན་ཡོད་པར་སྙམ་གྱི་འདུག་དཔེར་ན།",
    "དེའི་སྐོར་དེ་རིང་རྒྱས་པར་གླེང་མ་གླེང་མི་འདུག།",
    "ཁོང་གཉིས་ལ་རྒྱ་དཔེར་མཇལ་ཁ་གནང་མི་འདུག་ལ།",
    "མི་འདུག་སྐབས་དེའི་༧གོང་ས་བཅུ་གསུམ་པ་ལ་མཚོན་ན།",
    "ཨརྱན་ཞེས་པ་བོད་སྐད་དུ་བསྒྱུར་ན་འཕགས་པའི་དོན་ཡིན་པས་འཕགས་པའི་རིགས་ཞེས་པ་ཡིན་པར་འདུག།",
    "མི་རྒྱུད་གཉིས་ཀའི་འབྱུང་གནས་ནི་ད་ལྟའི་ཨུ་རུ་སུའི་ས་ཁོངས་ཀྱི་ཆ་༧ཟེར་ས་དེ་ཕལ་ཆེར་ཡིན་ཚོད་འདུག་ཀྱང་།",
    "མགོ་ནས་ཤོག་བུ་གཉིས་ཚམ་ཚོམ་མེད་པར་ཤར་གྱི་བཏོན་སོགས་གསུངས་པས་བདེན་ན་རྒྱ་དཔེ་དེ་ལ་སོགས་པ་ཡིན་འདུག་ཅེས་ཏེ།",
    "རྭ་སྒྲེང་དུ་ཤནྟི་པའི་བརྟགས་གཉིས་ཀྱི་འགྲེལ་ལབ་ཀྱི་འདུག་གསུངས།",
    "དཀོན་གཉེར་ལ་མཁས་པ་འཇོག་སྲོལ་འདུག་ནའང་།",
    "དགུང་ལོ་གྱ་བརྒྱད་ཀྱི་ཐོག་ལ་བོད་ནས་ཕྱིར་རྒྱ་གར་དུ་བྱོན་ཡོད་པར་འདུག།",
    "བོད་ཀྱིས་ཁ་ཆེ་པཎ་ཆེན་ལ་མཐོང་ཆེན་བྱས་པའི་ཚད་ནི་དེ་འདྲ་ཞིག་ཡིན་པར་འདུག་དེ་འདྲའི་མཛད་རྗེས་བཞག་ཡོད།",
    "ཁ་ཆེ་རུ་ལོ་བཅུ་ཐམ་པར་བཞུགས་ཏེ་དགུང་ལོ་གོ་དགུའི་ཐོག་དགོངས་པ་རྫོགས་པ་ཡིན་པར་འདུག་ཁ་ཆེ་པཎ་ཆེན་གྱི་གནས་ཚུལ་ནི་དེ་འདྲ་ཞིག་ཡིན།",
    "ཁ་ཆེ་པཎ་ཆེན་དགུང་ལོ་གྱ་བརྒྱད་ཀྱི་ཐོག་ཏུ་ཕྱིར་ཁ་ཆེའི་ཡུལ་དུ་བྱོན་ཡོད་པར་འདུག་ལ།",
    "ཉེ་ཆར་གནའ་དུས་ཀྱི་ལྷ་ཁང་རྙིང་མ་ཞིག་འདུག་པ་མཐའ་འདུལ་གྱི་གྲས་ཡིན་ཟེར་ཀྱང་མི་བདེན་པ་སྣང་།",
    "དེས་ན་ནག་ཚོས་ཇོ་བོ་མཇལ་ཚེ་ན་བཟའ་སྨུག་པོ་ཅན་གསུངས་པ་ཡང་དྲེག་པ་ཆགས་པའི་སྨྱུག་རིས་དེ་མིན་འདུག་ཅེས་ཏེ།",
    "དེ་ཡང་ཁ་དོག་སྨུག་པོ་ཡིན་པ་ལས་དྲེག་པ་ཆགས་པའི་སྨུག་རིས་མིན་འདུག་ཅེས་ཏེ།",
    "གོས་སྨུག་པོའི་སྣམ་སྦྱར་ཞིག་གསོལ་རས་གནང་བ་བྲིས་འདུག་གསུངས།",
    "གྱོས་ཆས་སྤུས་དག་གཙང་མ་ཞིག་གྱོན་པ་ནི་གུས་ཞབས་མཚོན་པའི་རྟགས་ཤིག་ཏུ་རྩི་ཡི་ཡོད་པར་འདུག།",
    "ཤིན་ཏུ་བབ་ཆགས་ཤིག་ཡོང་རྒྱུ་གཙོ་བོར་བཟུང་ཡོད་པར་འདུག་སིངྒ་ལ་པ་རྣམས་ནི་དམར་སེར་ཤ་སྟག་གྱོན།",
    "ཁ་ཆེ་པཎ་ཆེན་གྱི་ལྷུང་བཟེད་ནང་དུ་ནི་ཤ་དཀར་གྱི་གཡའ་རྩི་ཞིག་བཏང་ཡོད་པར་འདུག་དེང་སང་བཙའ་མི་ཆགས་པའི་ལྕགས་ཏེ་ཟེར་བ་ཡོད་ལ།",
    "དེ་མ་དར་བའི་གོང་ལ་ལྕགས་ཀྱི་སྣོད་དུ་ཆུ་སོགས་བླུགས་བཞག་དུས་བཙའ་ཆགས་འགྲོ་བས།",
    "ལག་རྩལ་དེ་འདྲ་དེ་དུས་ནས་དར་ཡོད་པར་འདུག།",
    "མགོ་མཇུག་ཏུ་རས་ནག་པོའི་མཐའ་ཆགས་བཅས་པ་ཞིག་འདུག་འདི་རྣམས་དཔེ་རིས་སུ་བྲིས་པ་ལ་ལྟོས།",
    "ཞེས་གསུངས་འདུག་པས།",
    "གུསྟ་ཞེས་པ་རྒྱ་གར་སྐད་ཡིན་པས་བོད་སྐད་དུ་སྦས་པའི་རྒྱལ་རབས་ཟེར་གྱི་འདུག་སྦས་པའི་རྒྱལ་རབས་ནི་རྒྱ་གར་གྱི་རྒྱལ་རབས་གྲགས་ཅན་ཞིག་སྟེ།",
    "འདུག་བགྲེས་སྐྱོན་ཡང་དེ་ཙམ་དུ་མི་ཆེ།",
    "འཁོར་གྱི་རྟ་མགྲིན་དེ་ཡས་ཀྱི་མཆེ་བ་གླང་ཆེན་བཞིན་ཡས་སུ་འཁྱིལ་བ་ཞིག་འདུག་ཅིང་།",
    "མེས་དབོན་གྱི་ལྷ་ཁང་རྣམས་ན་ཡང་ཁྲོ་བོའི་གཟུགས་དེ་ཁོ་ནར་འདུག་པས།",
    "དགོད་སྒྲ་ཁྲོ་བོ་རྣམས་ཀྱི་མཆེ་བ་མར་བསྲིངས་པ་ཞིག་བྲིས་འདུག་གམ།",
    "ཡར་འཁྱིལ་བ་ཞིག་བྲིས་འདུག་ལྟོས་དང་།",
    "ཞ་ལུར་ཡང་ཡ་རྩེ་ནས་ཕུལ་བྱ་བའི་རྒྱ་དཔེ་འདུག་པས།",
    "བལ་ཡུལ་གྱི་རྒྱལ་རྒྱུད་ཅིག་ལ་ཡ་རྩེ་ཞེས་པ་ཞིག་ཡོད་པར་གསུངས་འདུག་པས་དེ་དང་འདི་གཉིས་འདྲ་མིན་མ་ཤེས།",
    "ཕྱི་ལོ་ཙམ་ནས་ནི་བལ་བོའི་ཁོངས་སུ་ཤོར་ཡོད་པར་འདུག་རྒྱ་དཔེ་འདི་གཉིས་བི་ཀྲ་མའི་ལོ་སྟོང་སུམ་བརྒྱ་བདུན་ཅུ་ལ་བྲིས་ཞེས་བྱུང་བས།",
    "ཁོང་རང་ཉིད་མཁས་པའི་གྲགས་པ་རྒྱས་པས།",
    "ཕ་སྟོན་པ་ཞིག་ལ་བུའང་སྟོན་པ་ཞིག་འཁྲུངས་འདུག་ཅེས་སྨྲས་པས་མིང་ལ་བུ་སྟོན་ཐོགས་པར་གྲགས།",
    "མཛད་པའི་ཆ་ཤས་ཆུང་ངུ་དེའི་སྟེང་ནས་ཀྱང་དམ་པའི་བབ་ཆགས་ཀྱི་གཤིས་དང་རང་བཞིན་མང་པོ་དཔོག་ཐུབ་པ་མིན་ནམ།",
    "སྲིད་དུ་མཐོ་དྲུག་འདུག་ཟེར།",
    "དེའི་ནང་དུ་བོད་དཔེ་བྲིས་མ་མང་པོ་ཡང་འདུག་སུ་ལ་ཡང་རྒྱུས་མེད་པའི་དཔེ་རིང་ཞིག་གོས་ཐུམ་དགུ་ཙམ་གྱིས་དྲིལ་ནས་འདུག་པར་ཞལ་ཕྱེས་པས།",
    "དཔེ་འདི་ཐུགས་སྲས་ལོ་ཙཱ་པའི་ཕྱག་བྲིས་ཡིན་པས་ཕྱི་ལ་མ་འཁྱར་བ་དགོས་བྱ་བ་སོགས་འདུག་ཅེས་ཏེ།",
    "སྲིད་དུ་མཐོ་དྲུག་ཡོད་པ་གཉིས་ཀྱི་ནང་དུ་བཅུག་འདུག་པ་སྒམ་དེ་ཡང་བུ་སྟོན་གྱི་ཡིན་ཟེར།",
    "དཔེ་ལྡེབ་ངོས་ཀྱི་ཐིག་ཕྲེང་ཀུན་སེར་པོ་ཡིན་འདུག་ཁྱེད་རྣམ་པའི་གྲས་ནས་དགུང་ལོ་ཆུང་བ་ཚོས་མང་པོ་རིག་ཨེ་ཡོད་མི་ཤེས།",
    "མཐོང་ན་འཇིགས་པའི་སྒེར་གཅོད་མཁན་གྱི་ལྟེ་བ་ཞིག་ཏུ་འགྱུར་གྱི་མི་འདུག་གམ།",
    "འདིར་རྒྱ་དཔེ་པོ་ཏི་བཞི་བཅུ་ཞེ་གཉིས་པོའི་མཚན་བྱང་ཐོ་རུ་བཏབ་འདུག་པས།",
    "ངོ་མཚར་ཞིག་བསྐྲུན་འདུག་ཟེར་དོན་དེ་ཡིན།",
    "སྔགས་ཡག་པོ་ཀློག་མི་ཤེས་པར་འདུག་ཁྱེད་རྣམ་པ་ནི་ཆོ་ག་འདོན་ཀློག་སོགས་ལ་མཁས་པས་སྔགས་ཡིག་འདི་དག་བཀླག་ཤེས་ངེས་པས།",
    "ཁོང་ནི་བྱིས་པ་ཡིན་དུས་དེ་འདྲའི་ཉམས་སྣང་ཁྱད་མཚར་ཡོད་པ་ཞིག་ཡིན་འདུག་དགུང་ལོ་བཅུའི་ཡས་མས་ཤིག་ལ་མ་ཡུམ་གྲོངས་པས།",
    "རྩ་མི་ལོ་ཙཱ་པ་ཞེས་པའི་རྩ་མི་ནི་ས་མིང་ཞིག་ཡིན་སྐད་འདུག་པས་དེ་ནས་འཁྲུངས་པར་གྲགས་ལ།",
    "རྒྱ་གར་དུ་སྟོན་པའི་རྒྱལ་ཚབ་མཛད་པ་སོགས་འཕྲིན་ལས་ཤིན་ཏུ་རྒྱས་པའི་སྐྱེས་བུ་ཆེན་པོ་ཞིག་ཡིན་པར་འདུག།",
    "མི་གཞན་གྱིས་ཤེས་ཀྱི་མི་འདུག་པས།",
    "ཞོན་ཙང་རྒྱ་གར་དུ་ཕེབས་པའི་དངོས་བཤུས་གློག་བརྙན་ཞིག་ཀྱང་བཟོས་འདུག་དེར་མ་ཟད།",
    "རྒྱ་གར་གྱི་ནཱལེནྡྲའི་དགོན་ཤུལ་དུ་ཞོན་ཙང་རྗེས་དྲན་ཁང་ཞིག་ཀྱང་བཞེངས་ཡོད་སྐད་འདུག་པས།",
    "དེ་དུས་ཙ་ན་བོད་པ་མང་པོ་བི་ཀྲ་མ་ཤི་ལར་འགྲོ་བའི་སྒང་ཡིན་ཅིང་དེར་བོད་པ་སྡོད་སའི་སྤྱི་ཁང་ཞིག་ཀྱང་ཡོད་པ་ཡིན་འདུག་ཅེས་ཏེ།",
    "དེ་མེད་པ་ནི་མུན་པ་སོགས་འདུག་པས།",
    "བོད་འགྲེལ་རང་དུ་སྣང་ལ་བར་བར་དུ་ཚིག་གསལ་རྒྱ་སྐད་དུ་བྲིས་འདུག་གོ་ཞེས་བྱུང་།",
    "བོད་ཀྱི་ལོ་ཙཱ་པ་ཚོས་བསྒྱུར་པ་ལ་ཞུ་དག་བྱས་པའི་གསུང་ཚིག་དེ་འདྲ་ཡང་ནང་དུ་ཡོད་པར་འདུག་དོཧཱཀོཥ་ཊིཀ་མ་ཚང་བ།",
    "ཀློག་ཚེ་འབྲུ་གཅིག་ལས་མེད་ཀྱང་འབྲི་དུས་སྔོན་འཇུག་རྗེས་འཇུག་མང་པོ་ཞིག་སྤུངས་ན་ཡི་གེ་གསུམ་བཞི་ཙམ་གྱི་རིང་ཐུང་ཆགས་འགྲོ་བ་ལྟ་བུས་ཀྱང་ཇེ་རིང་དུ་འགྲོ་ཡི་འདུག།",
    "ཀློག་དུས་ལེགས་སྦྱར་གྱི་སྐད་ཡིན་ལ།",
    "ས་ཆ་དེར་ལུང་པ་དགུ་ཡོད་སྐད་འདུག་ཡང་།",
    "ཡིག་མཁན་གྱིས་ནོར་བ་ཡིན་མིན་སོགས་ལ་བརྟག་དགོས་པར་འདུག་གཅིག་བྱས་ན་གཉིས་ཀས་ནོར་མེད་པར།",
    "དོན་ལ་བོད་དུ་མ་འགྱུར་བ་གཞན་ཞིག་ཡོད་པ་ཡིན་སོགས་ལ་དཔྱད་དགོས་པར་འདུག།",
    "ཞ་ལུ་རི་ཕུག་ཏུ་ཕྱིན་ཏེ་མ་རྩོམ་གྱི་རྒྱ་གཞུང་རང་ལ་བལྟས་ནས་དཔྱད་ཆོག་ཀྱང་།",
    "སོགས་ཡིན་ཡང་ཆ་ཚང་དྲན་གྱི་མི་འདུག་གང་ལྟར་བོད་ཀྱིས་འབྲི་བཞིན་པའི་སུམ་རྐང་དང་།",
    "ཞ་ལུ་ནས་ཉེ་ལམ་བརྒྱུད་ན་ཉིན་ཕྱེད་ཙམ་གྱི་སར་འདུག་ཅེས་ཏེ།",
    "དེ་ནས་རིམ་གྱིས་གདན་ས་ངོར་དུ་བྱོན་འདུག་མཁས་གྲུབ་ཆེན་པོ་ཀུན་བཟང་བ་ཞེས་པ་ནི་ངོར་ཆེན་ཀུན་དགའ་བཟང་པོ་ཡིན་ཞིང་།",
    "གདན་ས་འདིར་ཕེབས་དུས་ནི་ཁོང་ན་ཚོད་སྨིན་པའི་རྗེས་སུ་ཡིན་པར་འདུག་སྐབས་དེ་དུས་ངོར་ཆེན་ཀུན་དགའ་བཟང་པོ་དགུང་ལོ་བདུན་ཅུ་ནང་ལ་སླེབས་ཟིན་པས།",
    "ནོར་འདུག་ཟེར་བ་དང་།",
    "ཁ་དན་ཚིག་ལ་གནས་ཀྱི་མི་འདུག་ཟེར་བ་ལྟ་བུ།",
    "བོད་དཔེ་རྣམས་ཅི་བས་ཀྱང་སྤུས་ལེགས་ལ་གྲས་མཚུངས་པ་རྐྱང་འདུག་འདིར་རྒྱ་དཔེ་པོད་ཆེ་ཆུང་བཞི་བཅུ་ལྷག་བཞུགས་པར།",
    "དོན་དངོས་སྟེང་གནས་ལུགས་ཆེན་པོ་འགའ་ཞིག་ཧ་གོ་མི་འདུག་སྟེ།",
    "ལ་ལར་བློན་པོའི་ཚུལ་འཛིན་པ་སོགས་མང་པོ་ཡོད་སྐད་འདུག།",
    "བྱ་བ་བོད་ཡིག་དབུ་ཅན་ཤིན་ཏུ་ཡིད་འཕྲོག་པའི་གཟུགས་སུ་བྲིས་ནས་འདུག་ས་བཟང་པཎ་ཆེན་གྱི་ཕྱག་བྲིས་ཡིན་མཆིས།",
    "དེ་ལྟར་ངོར་དུ་དྷརྨཔད་ཡི་རྒྱ་དཔེ་ཐོར་བུ་ཞིག་རྙེད་འདུག་ལ།",
    "འགྱུར་ཧ་ཅང་ལེགས་ཤིང་ཚིག་དོན་གཉིས་ཆ་ནས་ཡིད་འཕྲོག་པ་ཞིག་འདུག་པས།",
    "འདིར་ཆད་རྟགས་འགའ་ཞིག་བཏབ་འདུག་ཀྱང་ཅི་ཞིག་ཆད་པ་མི་ཤེས་པས་མཐུད་ཤེས་ཀྱི་མི་འདུག་འདིར་ནགས་རིན་གྱི་བསྟོད་པ་ཞེས་བྱུང་བའི་ནགས་རིན་ནི་དུས་ཕྱིས་སུ་བོད་དུ་བྱོན་པའི་པཎྜི་ཏ་ཞིག་སྟེ།",
    "རྗེ་ཙོང་ཁ་པ་ཆེན་པོ་ལ་ལམ་དམན་པར་ཞུགས་པ་ཟེར་ནས་མི་འོས་པའི་ངན་སྨྲས་བྱེད་ཀྱི་འདུག་གསུངས།",
    "ལྟ་བ་བོར་ཞིང་སྤྱོད་པ་འཆལ་བའི་རིགས་ལ་དག་ཐེར་ཞིག་མ་བྱས་ཐུ་མེད་འདུག་ན།",
    "ཡག་པོ་འདུག་ཁྱེད་པཎྜི་ཏ་གདན་འདྲེན་དུ་ཕེབས་དང་གསུངས་ནས།",
    "ལོ་ཆེན་རིན་ཆེན་བཟང་པོ་དགུང་ལོ་བརྒྱད་ཅུ་གྱ་ལྔར་ཕེབས་འདུག་པས།",
    "མང་ཤོས་ཀྱིས་གསུང་སྟངས་དེ་ཁས་ལེན་གྱི་འདུག་གལ་ཏེ་སྨྲི་ཏིའི་གསང་སྔགས་ཀྱི་འགྱུར་དེ་ལོ་ཆེན་ལས་ཅུང་ཙམ་སྔ་ཕར་འགྲོ་མང་ཡང་ཚུར་སླེབས་ཉུང་།",
    "དེ་དུས་རྒྱ་གར་ན་ཧ་ཅང་སྐད་གྲགས་ཆེ་བར་འདུག་ཤར་སྒོ་ན་ཤནྟི་བ་སྟེ།",
    "འབྲོག་མི་མཁས་པ་འདི་འདྲར་ཆགས་འདུག་ནའང་།",
    "མཁས་པ་མིན་ཡང་ལྷག་བསམ་བཟང་པོ་འདུག་པས།",
    "གོ་ལྡོག་ལྟ་བུ་ཞིག་བྱེད་ཀྱི་འདུག་སྙམ།",
    "དཔེ་པོད་སྟོང་ཕྲག་ལྷག་ཙམ་འདུག་པའི་ནང་ནས་ཐོག་མར་ངེད་ཀྱིས་དཔེ་ལྡེབ་ཆེན་པོ་ཞིག་སྣང་མེད་དུ་བཏོན་པས།",
    "པཎྜི་ཏ་རྣལ་འབྱོར་ཟླ་བའི་ཕྱག་བྲིས་རྣམ་འགྲེལ་རྒྱན་གྱི་རྒྱ་དཔེ་ཤོག་བུ་ལ་བྲིས་པ་ཆ་ཚང་ཞིག་འདུག་ཅེས་ཏེ།",
    "དེར་པཎྜི་ཏས་རྒྱ་དཔེ་མང་དུ་རྙེད་འོང་བར་བསམ་ནས་གྲོགས་བཅོལ་ཏེ་ཉིན་གཉིས་གསུམ་བཙལ་ཡང་དཔེ་ཁང་དེའི་ནང་ན་པོད་དེ་གཅིག་པུ་ལས་མི་འདུག་ཅེས་ཏེ།",
    "དཀའ་སྣང་བྱུང་བ་སོགས་ཐུགས་སྐྱོ་བའི་ཚིགས་བཅད་གཉིས་བྲིས་འདུག་གསུངས།",
    "དེ་རུ་འཁོར་རྣམས་ལ་ཞབས་ཏོག་ཡག་པོ་མ་ཞུས་པས་དེ་དག་སེམས་མ་སྐྱིད་པ་ཡིན་འདུག་པ་དང་།",
    "དེའི་སྐོར་དུམ་བུ་ཞིག་འདུག་པས་གནས་ཚུལ་དེ་བདེན་པར་ངེས།",
    "དེ་ལ་ངོ་མཚར་རྒྱུ་ཅང་མི་འདུག་གསུངས་པ་ན།",
    "མ་གཞི་ནས་དེ་འདྲ་ཡིན་པར་འདུག་ལགས་ཞུས་པས།",
    "མི་དེ་ནི་མ་ཧཱ་བཛྲ་དངོས་སུ་འདུག་པས་ཕྱག་ཅིག་འཚལ་བ་ཡིན་གསུངས།",
    "དཔེ་དེ་གཉིས་ལེགས་སྦྱར་གྱི་ཡི་གེ་ནི་མིན་པར་འདུག་གཅིག་ན།",
    "དེ་དག་བསྣན་ན་བསྟན་པ་ཕྱི་དར་ལ་ནགས་རིན་གྱི་བར་པཎྜི་ཏ་བདུན་ཅུ་དོན་གསུམ་བོད་དུ་ཕེབས་ཡོད་འདུག་ནགས་རིན་བོད་ལ་ཕེབས་དུས་ཅུང་ཟད་འཕྱི་སྟེ།",
    "རྣམ་འགྲེལ་རྩ་བ་མ་ཚང་བ་ཞིག་རྙེད་པས་དེ་དཔེ་བཤུས་བརྒྱབ་པ་ཞིག་རྒྱ་གར་དུ་འབྱོར་འདུག་གསུངས་པས།",
    "ལྷ་ས་ཀུན་གླིང་བླ་བྲང་དུ་རྩོད་རིགས་ཀྱི་འགྲེལ་པ་ཞི་འཚོས་མཛད་པ་དཔེ་ཐུང་ཞིག་འདུག་པར་པཎྜི་ཏས་ངོ་བཤུས་བྱས།",
    "མཛད་པའི་རྒྱ་དཔེ་སྣ་ཐུང་ཞིག་འདུག་པས།",
    "དེ་ཡང་པཎྜི་ཏ་ར་ཧུ་ལས་ངོ་བཤུས་བྱས་འདུག་གསུངས།",
    "དེར་བརྒྱད་སྟོང་མཚན་བརྗོད་སོགས་ཀྱང་འདུག་བོད་དཔེ་དཀོན་པོ་སྦ་བཞེད་ཞབས་བཏགས་མ་བྲིས་མ་ཞིག་ཀྱང་སྣང་།",
    "དེ་དུས་སྦ་བཞེད་ཞབས་བཏགས་མ་ནི་དཀོན་པོ་ཡིན་པར་འདུག་ནའང་།",
    "སྦ་དང་དབའ་སོགས་སྒྲ་གཅིག་ཡི་གེ་འབྲི་ཚུལ་སོ་སོར་བྱས་པ་ཙམ་ལས་ནང་དོན་ནི་རྒྱས་བསྡུས་ཙམ་ལས་གཅིག་པ་ཡིན་པར་འདུག་སྦའམ་དབའ་ནི་བོད་ཀྱི་རུས་ཆེན་ཞིག་སྟེ།",
    "ཅེས་གསུངས་འདུག་པས།",
    "ཞབས་བཏགས་མེད་པའི་རྦ་བཞེད་གཅིག་བཅས་སོན་པར་གསུངས་འདུག་ཡི་གེར་འགོད་མཁན་གྱིས།",
    "དེར་ངོ་མཚར་ཆེ་བ་རྡོ་རྗེ་གདན་གྱི་མཆོད་རྟེན་སོགས་དགོན་གནས་ཡོངས་རྫོགས་གྱི་བཀོད་པ་རྡོ་ནག་དང་ཙནྡན་དཀར་པོ་ལས་བྱས་པ་ཁ་ཐོར་ཆ་གཉིས་འདུག་ཅེས་ཏེ།",
    "དབུས་ཀྱི་མཆོད་རྟེན་སོགས་རྡོ་ནག་པོ་དང་ཙནྡན་དཀར་པོས་བཟོས་པ་ཁ་ཐོར་ཆ་གཉིས་ཡོད་པ་དེ་ཡིན་འདུག་རྡོ་ཡི་དེ་རྒྱ་གར་ནས་འཁྱེར་ཡོང་བ་ཡིན་ཟེར་ཅིང་།",
    "ག་ཡའི་བརྒྱུད་ཀྱི་རྡོ་ནག་གྲགས་ཅན་དེ་ག་རང་དུ་འདུག་ཅེས་པའོ།",
    "བོད་དུ་བཟོས་པ་མིན་འདུག་རྡོ་ཡི་དེ་ནི་རྒྱ་གར་ནས་རྒྱུ་ཆ་ཁྱེར་ཡོང་ནས་བཟོས་པ་དང་།",
    "ཡང་ན་ཅི་ཞིག་ཡིན་དཔྱད་དགོས་པར་འདུག་བསམ་ཡས་དཀོར་མཛོད་དུ་རྒྱ་དཔེ་མེད་པ་བདེན་ཟེར།",
    "ཀཎགོམིས་མཛད་པ་སོགས་ནི་བྱང་ཤམ་བྷ་ལའི་དཔེ་མཛོད་དེ་འདྲ་ན་ཡོད་ན་མ་གཏོགས་བོད་ཡུལ་གྱི་གླེགས་བམ་འདི་གཅིག་པུ་ལས་གཞན་ས་སྟེང་ན་དཔེ་རྒྱུན་ཡོད་ཚོད་མི་འདུག་ཅིང་།",
    "ང་ནི་ཙོག་པུར་བསྡད་དེ་མཐའ་མེད་པའི་བྱེ་ཐང་ཆེན་པོར་བལྟས་ནས་ཤུགས་ཆེན་པོས་ངུ་ངག་ཅིག་འདོན་རྒྱུ་ལས་ཐབས་མི་འདུག་ཟེར།",
    "ཞེས་པའི་ནང་སྔར་འབྲི་དུས་ཀྱི་སེམས་ཚོར་གླེང་བའི་སྐད་ཆ་ཡིན་འདུག་པས་འདིར་བཅོས་ཡོད།",
    "ཡུལ་དེའི་ཆུ་འགྲམ་བྱང་ངོས་ན་གྲུབ་ཐོབ་གཅེར་བུ་རྣམས་ཀྱི་རྒྱལ་ས་ཆེན་པོ་ལ་སྟོད་རྒྱལ་གྱི་ཤྲཱིབྱ་བའི་གྲགས་ཆེན་དེ་འདུག་ཅེས་བྱུང་།",
    "ལ་སྟོད་རྒྱལ་གྱི་ཤྲཱིཟེར་བའི་གནས་གྲགས་ཅན་དེར་སླེབས་པ་ཡིན་འདུག་གནས་དེ་ནི་ཕལ་ཆེར་དེང་སང་འགྲམ་ལ་འགྲོ་བའི་གཞུང་ལམ་ནས་རྒྱང་རིག་ཅིག་བྱེད་ཐུབ་བམ་སྙམ་སྟེ།",
    "གསལ་པོ་ཞིག་དྲན་གྱི་མི་འདུག་དེ་ཡང་ལ་སྟོད་རྒྱལ་གྱི་ཤྲཱིཞེས་པ་ནི།",
    "མཐོང་ནས་དྲུང་དུ་སླེབས་ཙ་ན།",
    "རང་རང་ས་ནས་མཁྲེགས་འཛིན་བྱས་ཏེ།",
    "ལ་སྟོད་རྒྱལ་གྱི་ཤྲཱི་འདི་གྲུབ་ཐོབ་རྣམས་ཀྱི་གདན་ས་ཡིན་གསུངས་འདུག་གཏམ་རྒྱུད་གསེར་ཐང་ནང་ལ་འདིའི་ཡན་དུ།",
    "རྒྱ་གར་དུ་ཚ་བ་ཆེ་དྲགས་པས་མི་རྣམས་ཚ་བའི་ཁྲོད་འདུག་མ་བཟོད་པར་ནགས་སུ་བྲོས་རྗེས།",
    "ནགས་སྡོང་རྣམས་ཀྱི་བསིལ་གྲིབ་འོག་ཏུ་མིའི་བློ་ཡུལ་དུ་མི་ཤོང་བའི་ཕུགས་བསམ་སྣ་ཚོགས་རྙེད་འདུག་ཅེས་ཀྱང་སྨྲ་ཡི་ཡོད་ཚོད་དེ།",
    "རྒྱུད་ལ་སྐྱེས་མྱོང་བའི་རྟོགས་པ་ཞིག་ཡིན་པར་འདུག།",
    "འདིར་ས་ཞིག་ཆད་འདུག་པས་རིམ་གྱིས་བལ་ཡུལ་དུ་སླེབས་ཟེར་དགོས།",
    "དཔར་དུ་འདེབས་སྐབས་ཤིག་ལ་སྐྱོན་ཕྲན་བུ་ཞིག་ཤོར་མེད་དམ་སྙམ་པའི་དོགས་པ་ཞིག་འདུག་མ་གཞི་ཚིག་དེའི་དོན་ནི།",
    "རྒྱ་གར་ནས་ཚུར་བལ་ཡུལ་ལ་མཇལ་དུ་ཡོང་མཁན་མང་པོ་འདུག་ཀྱང་།",
    "ལག་པ་ལ་ལག་སོགས་བོད་སྐད་གསར་པ་ཞིག་དང་མཚུངས་པ་ལྟ་བུ་ཞིག་ཏུ་གསུངས་འདུག།",
    "འདིར་གོནཔ་རྣམས་རྒྱ་གར་རཱཛ་པུ་ཏནའི་རྒྱུད་པར་གསུངས་འདུག་ཀྱང་།",
    "སྲོང་བཙན་སྒམ་པོའི་སྐུ་ཚེའི་སྨད་ཙམ་ནས་བཟུང་བལ་ཡུལ་བོད་ཀྱི་མངའ་ཁོངས་ཡིན་པར་འདུག་ཐེངས་ཤིག་ལ།",
    "ཡང་མཚར་འདོད་ཀྱི་ཚིགས་བཅད་དུ་བྲིས་པ་རགས་ཙམ་ཞིག་ཡོད་ཅེས་གསུངས་འདུག་ཀྱང་།",
    "བོད་སྐད་དུ་གསེར་རྒྱལ་བྱ་བ་དེ་དང་མཇལ་ཕྲད་བྱུང་འདུག་ཅིང་།",
    "ལན་གཅིག་རྒྱལ་པོ་ལ་ཚེ་གེགས་འདུག་པའི་དེ་སེལ་བའི་ཐབས་སུ་ཤི་ནས་སླར་སྐྱེས་པའི་ཆོ་ག་བྱ་དགོས་ཟེར་ནས།",
    "དེའི་ཐད་དུ་བོད་ཀྱི་ལོ་ཙཱ་པ་རྣམས་ཀྱིས་ཁྱི་ཤ་ཟོ་ཞེས་བསྒྱུར་འདུག་པ་ལ།",
    "རྒྱ་གཞུང་རང་དུ་ཤ་ཟོ་ཞེས་པ་ལས་ཁྱི་ཤ་ཟོ་ཟེར་བ་ཞིག་མེད་པས།",
    "དགོས་པ་གང་འདུག་ཅེ་ན།",
    "འོན་ཀྱང་ཞོ་ལྟ་བུའི་ཀླད་པ་ཁོ་རང་བེམ་པོ་ཡིན་པས་ཤེས་པར་ག་ལ་རུང་།",
    "གཙོ་བོ་ཀླད་པའི་ནང་དུ་གནས་པ་ཚན་རིག་པས་ཤེས་ཀྱི་འདུག་ལ།",
    "འདི་འདྲས་ཀྱང་རྣམ་འགྲེལ་ཤེས་ཀྱི་འདུག་སྙམ་དུ་ཧ་ལས་ཡོད་ནའང་བོད་ལ་ནི་དེ་འདྲའི་གཡོག་པོ་མང་པོ་འཁྲིད་རྒྱུ་ག་ལ་ཡོད།",
    "བལ་ཡུལ་དུ་སྔོན་ཆད་ནང་པའི་བསྟན་པ་ཧ་ཅང་དར་མྱོང་འདུག་དེའི་འཕྲོར་བོད་བཙན་པོའི་རྒྱལ་རབས་དར་རྒྱས་བྱུང་བས།",
    "ཡུལ་དཔོག་པའི་ནུས་པའི་ལྟེ་བ་ཀླད་པར་གནས་པ་ཡང་ཁས་བླངས་འདུག་འོན་ཀྱང་།",
    "གཟུགས་ཅན་རགས་པ་སྟེ་ཞོ་ལྟ་བུའི་ཀླད་པ་ཁོ་རང་ནི་ཤེས་པ་ཡིན་མི་སྲིད་ཟེར་བས།",
    "གནའ་རབས་ཤར་ཕྱོགས་ཀྱི་མཚན་ཉིད་རིག་པའི་ལྟ་གྲུབ་ཀྱི་སྲོག་ནི་བརྟན་པོར་འཛིན་ཐབས་ལ་བརྩོན་གྱི་འདུག་ཁོང་རྣམ་གཉིས་ཀྱི་ཁ་བརྡ་ཐུང་ངུ་དེའི་ནང་།",
    "ཤེས་པ་གཟུགས་སུ་གྲུབ་མ་གྲུབ་ཀྱི་དོགས་པ་བསླངས་འདུག་པ་དེ་ནི།",
    "ས་སྐྱ་རུ་རྣམ་འགྲེལ་ལེའུ་དང་པོའི་རང་འགྲེལ་ཁ་མ་ཚང་བ་ཞིག་རྙེད་ཀྱང་རྩ་བ་རྙེད་མི་འདུག་འོན་ཀྱང་ར་ཧུ་ལས་བོད་ནས་གདན་དྲངས་པའི་རྣམ་འགྲེལ་རྩ་བ་ཞིག་ཕྱི་རྒྱལ་དུ་དཔར་བསྐྲུན་བྱས་ཚུལ་གསུངས་པར་དཔྱད་ན།",
    "ལི་ཡུལ་ནི་བོད་ཀྱི་བྱང་ཕྱོགས་སུ་ཡོད་ཀྱང་རང་སྐད་ལ་ཀུསྟན།",
    "ད་ལྟ་ནི་ཏུར་ཀིསྦྱིན་ཞེས་འབྲི་ཡི་འདུག་ཅིང་།",
    "རྒྱ་ནག་གཉིས་བར་ལ་འབྲེལ་བ་བྱུང་དུས་ནི་ཧན་རྒྱལ་རབས་ཀྱི་སྐབས་སུ་ཡིན་འདུག་ཧན་རྒྱལ་རབས་ལ་ཧན་ནུབ་མ་དང་ཤར་མ་གཉིས་ཡོད་པ་ལས།",
    "ཞེས་པའི་ལམ་ཐག་རིང་པོ་ཞིག་ཁོ་ཚོས་འདེད་ཀྱི་འདུག་སྔར་གྱི་དར་གོས་ཀྱི་ཚོང་ལམ་དེ་རུ།",
    "ད་ལྟ་ཡང་ཞི་ཅིན་ཕེན་གྱིས་བསྐྱར་དུ་ཚོང་ལམ་ཆེན་པོ་ཞིག་འབྱེད་དགོས་ཟེར་གྱི་འདུག་སྤྱིར་དར་ཟབ་ཀྱི་ཚོང་ལམ་ལ།",
    "བོད་དམག་ལི་ཡུལ་དུ་དྲངས་པའི་ལོ་ནི་ཕལ་ཆེར་ཕྱི་ལོ་ལོ་ཙམ་ལ་ཡིན་པར་འདུག་དུས་དེར་ཐང་བོད་གཉིས་ཀྱི་བར་དུ་ལི་ཡུལ་འཕྲོག་རྩོད་ཀྱི་ཕྱིར་དམག་འཁྲུག་མང་དུ་བྱུང་བའི་ཚུལ་དེབ་དཀར་དུའང་གསལ་བས།",
    "མན་ཇུའི་གོང་མ་ཆན་ལུང་སྐབས་བཏགས་པ་ཡིན་འདུག་ལ།",
    "འབྲས་སྤུངས་སུ་ཕེབས་པ་ཡིན་འདུག་པས།",
    "ཡུལ་དེ་ནི་ཨི་སི་ལམ་པ་ཚོའི་ཕ་ཡུལ་ལྟ་བུ་ཞིག་ཏུ་ཆགས་འདུག་པས།",
    "ཡུལ་དེའི་མི་རྣམས་ཀྱང་སོག་པོ་ཡིན་པར་སྨྲས་འདུག་ནའང་།",
    "རྒྱ་གར་གྱི་ལྕགས་ལམ་དང་ཕྲད་བྱུང་གསུངས་འདུག།",
    "དེ་འོག་ནས་བདག་ཅག་སྐྱེས་འདུག་ལགས་ཤིང་།",
    "དེང་སང་རྒན་པོ་རྣམས་ཀྱིས་ཀྱང་འདི་ཁོ་ཆུང་དུས་ཀྱི་ཁྲི་ཡིན་ཟེར་སྐད་འདུག།",
    "བྱམས་པའི་ལྷ་ཁང་ཞིག་འདུག་བ་མཇལ།",
    "དགོན་དེབ་ཚོགས་པ་ཐམས་ཅད་ཆུ་ལེན་ཕེབས་བར་དབུ་ཞྭ་ཕྲག་པར་བཀལ་ནས་ཕེབས་འགྲོ་འདུག་པར་ཕྱི་ལགས་ཞུས་པས།",
    "ཕྱིའི་ཁྱམས་ཀྱི་བཀའང་རྩིའུ་དམར་གྱི་རྟེན་གཞན་ཡང་འཇིག་རྟེན་དྲེགས་པ་ཁ་ཤས་ཀྱིས་བསྐོར་བའདུག་པས་ཕྲིན་ལས་དྲག་ཏུ་བཙེས།",
    "དེའི་ཕུགམཆོད་རྟེན་བཀྲ་ཤིས་འོད་འབར་བྱ་བ་ཞིག་འདུག་པ་ནི་མཇལ་མ་ཐུབ།",
    "ཡུལ་དེར་ཡང་ཡང་དྲིས་རུངབལ་ཊཾ་གཅིག་ལའང་འཚོང་མཁན་མི་འདུག།",
    "ངེད་རང་རང་དོན་དུ་འོང་བར་དཀའ་འབའོས་ཅི་ཡོད།",
    "དེང་སང་གནམརྒྱན་མ་གཏོགས་མི་འདུག།",
    "གཙུག་ལག་ཁང་དེའི་བཀོད་པ་དང་སྒོ་བཏོད་ལུགས་ཇི་ལྟ་བ་བཞིན་དུ་ལྷས་ཡང་དེ་ལས་དཔེ་བླངས་འདུག།",
    "རིམ་གྱིས་གཙང་དུ་ལོག་རྒྱུའི་ལམ་དུ་ཞུགས་ནས་སྙེ་ཐང་བཀྲ་ཤིས་སྒང་དུ་འདུག་ཞུས།",
    "དེ་སྐབས་སྦྱིན་བདག་རྣམས་ལ་མགྲོན་ཆུང་ཞིག་མཛོད་སྲོལ་འདུག་ལ།",
    "ཟིལ་གནོན་འབུམ་པ་གཉིས་ལའང་གདའ།",
    "སྒ་ཆེན་བོ་ཞིག་ན་ངེད་རང་ཁྲི་ཐོག་ཞིག་ལ་མ་སླེབས་འདུག།",
    "དེའི་གཡས་ན་བླམ་ཀུན་དགའ་རྣམ་རྒྱལ་འདི་ཁྲི་དེ་ལས་ཅུང་དམའ་བ་ཞིགཞས་སྒྱུའདུག།",
