    "དེ་དག་གིས་དེ་ཁོ་ན་ཉིད་ཀྱི་རྟགས་སེམས་ལ་འཆར་བར་བསྟན་ཏོ།",
    "བྷ་གའི་དཀྱིལ་འཁོར་དུ་རིགས་དྲུག་གི་ས་བོན་མཐོང་ས་བོན་དྲུག་ལ་མངའ་བརྙེས་ཞེས་པས་བསྟན་ཏོ།",
    "རེངས་པ་དང་།",
    "བྷ་གའི་དཀྱིལ་འཁོར་དུ་རིགས་དྲུག་གི་ས་བོན་མཐོང་ས་བོན་དྲུག་ལ་མངའ་བརྙེས་ཞེས་པ་སྟེ།",
    "ལྟེ་མཛོད་བར་ཡི་གེའི་ཕྱི་མོ་བརྒྱད་ཅེས་པ་ཨ་ཀ་ཙ་ཊ་ཏ་པ་ཡ་ཤའོ།",
    "བཞི་སྟོང་གི་ནི་གྲངས་སྙེད་ཀྱི།",
    "ཨ་ནི་ཡིག་འབྲུ་ཞེས་པ་དྲུག་གིས་གསལ་ལོ་ཞེས་པ་སྟེ།",
    "དག་པའི་སྣང་བ་ཡེ་ཤེས་གཅིག་གི་སྤྱོད་ཡུལ་ལ་ཞིང་ཁམས་བཞི་ཇི་ལྟར་སྣང་བ་ནི།",
    "དེད་འདྲེན་ཆེན་པོ་ཕྲག་བདུན་བདུན་ཏེ་རྡོག་ཐབས་གཅིག་གིས་བསྒྲལ་བ་དང་།",
    "དེ་དག་གི་ཞལ་བལྟ་བ་དང་།",
    "བདུན་པ་རིང་དུ་སོང་བ།",
    "བདག་གཞན་མི་སྣང་བར་སྦེད་ནུས་པ་འབྱུང་སྟོབས་ལྔ་པོ་དེ་སྔར་ས་བཅུའི་སྐབས་སུ་ནི་ཅུང་ཟད་ཐོགས་པ་དང་བཅས་རང་སྣང་གི་ཚུལ་དུ་འོང་ལ།",
    "ཁྱོད་ཞབས་པདྨོ་སྤངས་ནས་ནི།",
    "གཟུགས་ནས་རེག་བྱའི་བར་དུ་ནང་གི་འདོད་ཡོན་ལྔ་ལ་རིམ་གྱིས་མ་བསླབ་པ་ནི་དགའ་བ།",
    "དེ་གོམས་པར་བྱས་པ་ལས་སྤང་བྱ་ཉོན་མོངས་པ་ཕྱེད་ཞི་སྟེ་ཀུན་བརྟགས་དང་ལྷན་སྐྱེས་ལས་ཀུན་བརྟགས་ཞིའོ།",
    "ལམ་དེ་གོམས་པ་ལས་སྤང་བྱ་ཉོན་མོངས་པ་ལྷན་ཅིག་སྐྱེས་པ་ལས་མངོན་གྱུར་དང་བག་ལ་ཉལ་མངོན་གྱུར་ཞི་བས་བཞི་གསུམ་ཞི།",
    "དེ་གོམས་པར་བྱས་པ་ལས་སྤང་བྱ་ཉོན་མོངས་པ་བག་ལ་ཉལ་ཡང་ཞི་སྟེ་ཉོན་མོངས་པ་ཐམས་ཅད་ཞི།",
    "ལམ་དེ་གོམས་པ་ལས་སྤང་བྱ་ཉོན་མོངས་ཐམས་ཅད་ཞི་བ་བརྟན་པས་ཤེས་བྱའི་སྒྲིབ་པ་མ་ལུས་པ་འཇོམས་པའི་གཉེན་པོར་གྱུར་པ།",
    "ཀུན་རྫོབ་ཀུནྡ་ལྟ་བུ་དེ་གནས་དམའ་མོར་ཕབ་ཀྱང་མི་འཆོར་བར་རྟོགས་པས་སོ་སོར་རྟོག་པ།",
    "དེ་ཁོ་ན་ཉིད་རང་གིས་རྟོགས་ཤིང་རང་ལ་གྲུབ་ཅིང་གཞན་ལ་མེད་པས་བྱ་བ་གྲུབ་པ།",
    "བདག་བསྐྱེད་པའི་རིམ་པའི་དཀྱིལ་འཁོར་ཙཀྲ་དམ་ཚིག་པར་བསྐྱེད་པ་དེ་ཡང་བདེ་སྟོང་དུ་འཆར་བས་དམ་ཚིག་གི་ཧེ་རུ་ཀ་དེ་ལ་ཕྱོགས་བཅུའི་ཏ་ཐཱ་ལ་སོགས་པ་ཡེ་ཤེས་སེམས་དཔའ་སྤྱན་དྲངས་པ་དེ་༥། ཡང་དེ་བདེ་སྟོང་དུ་འཆར་བས་གཞན་ཡེ་ཤེས་ཀྱི་ཧེ་རུ་ཀ་བྲིས་སྐུ་དང་ལྡེར་བཟོ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱང་བདེ་སྟོང་དུ་འཆར་བས་བཏགས་པ་བརྡའི་ཧེ་རུ་ཀ་ཧེ་རུ་ཀ་ཞེས་བརྗོད་པའི་སྒྲ་ཐམས་ཅད་ཀྱང་བདེ་སྟོང་དུ་འཆར་བས་བརྗོད་པ་མིང་གི་ཧེ་རུ་ཀའོ།",
    "དེ་ལྟར་ན་བདག་གི་ལུས་ལ་གནས་པས་ན་ལྷ།",
    "དེ་དག་གིས་ཕྲིན་ལས་ཡོངས་སུ་དག་པ་ཡིན་ནོ།",
    "དེའང་ཨ་ཡིག་གི་གནས་སུ་སྤོས་ཏེ་བཞག་ན་ལྷའི་སྐྱེ་བ་བརྒྱ་དང་སྟོང་ལ་སོགས་པ་ཅི་ཙམ་བླངས་པ་དྲན་པ་འབྱུང་།",
    "དེ་དག་གི་ཞལ་ལྟ་བ་དང་།",
    "དེ་དག་གིས་ནི་དེ་ཁོ་ན་ཉིད་ཀྱི་རྟགས་སེམས་ལ་འཆར་བ་བསྟན་ཏོ།",
    "འབྲས་བུ་གཅིག་གི་སྒོ་ནས་རྒྱས་པར་བཤད།",
    "ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་རིག་མའི་སྐྱེས་བུ་ངོ་བོ་ཉིད་ཀྱི་སྐུ་རང་བཞིན་གྱིས་ལྷུན་གྲུབ་ཐོབ་པར་བྱེད་ཅེས་པ་བསྟན་ཏེ།",
    "ལག་ནི་ཡེ་ཤེས་ལྔའི་རྒྱུ་ཐུན་མོང་མ་ཡིན་པ་རང་གི་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་བརྒྱད་ཤེས་བྱའི་སྒྲིབ་པ་ཆ་ཕྲ་བ་དེ་འདག་ལ་ཁད་དེ་སྐད་ཅིག་མ་བདུན་གྱི་ཐ་མ་ལ་འགག་པའོ།",
    "ཐབས་རྒྱུད་དག་པ་ལ་གཡས་གཟུང་བའི་རྦ་རླབས་རེངས་པ་སྐད་ཅིག་མ་གཅིག་གཡོན་འཛིན་པའི་རྦ་རླབས་རེངས་པ།",
    "གསུམ་དུ་བཞག་ན་ཐབས་རྒྱུད་དག་པ་སྐད་ཅིག་མ་གཅིག་ཤེས་རབ་ཀྱི་རྒྱུད་དག་པ་སྐད་ཅིག་མ་གཅིག་སོ་སོར་དག་པ་ལ་སྐད་ཅིག་མ་གཅིག་སྟེ་གསུམ་མོ།",
    "ཐབས་ཤེས་རབ་གཉིས་ཆར་གྱི་ཏིང་ངེ་འཛིན་གྱིས་ཐབས་ཀྱི་རྩ་གཡས་རོ་མར་བྱས་པས་གཟུང་བའི་རྦ་རླབས་རེངས།",
    "དེ་བཞིན་དུ་གཡོན་དུ་བྱས་པས་འཛིན་པའི་རྦ་རླབས་རེངས།",
    "ཁྱབ་འཇུག་གིས་འཁོར་ལོ་འཕངས་པ་ལ་སོགས་འདོད་པ་ཁམས་ཀྱི་བདུད་བྱེ་བ་ཕྲག་ཁྲིག་བརྒྱ་སྟོང་དུ་མ་ལ་སོགས་པས་མཚོན་ཆ་དཔག་ཏུ་མེད་པའི་ཆར་ཕབ་པས་བཅོམ་ལྡན་འདས་ཀྱི་བ་སྤུའི་བུ་ག་གཅིག་ཀྱང་བསྐྱོད་པར་མ་ནུས་ཏེ།",
    "བརྟན་མ་དེ་རིང་བདག་གི་དཔང་མཛོད་ཅིག།",
    "དེ་ལྟར་གྱུར་ནས་སྟོང་གསུམ་གྱི་སའི་ལྷ་མོ་ཐམས་ཅད་ཀྱིས་གད་མོ་ཆེན་པོ་བགད་པས།",
    "གསུང་གི་གཉིས་ཏེ་བརྒྱད་འཆར་བ་ནི།",
    "གཟུགས་རྡོ་རྗེ་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་རྡོ་རྗེ་མ་ལ་སོགས་པ་ཟག་པ་མེད་པའི་འདོད་པའི་ལོངས་སྤྱོད་ཐམས་ཅད་ལ་ལོངས་སྤྱོད་ནུས་པའོ།",
    "འབྲས་བུ་གཅིག་གི་དུས་ཞེས་བྱ།",
    "སོགས་ཀྱིས་བསྡུས་པ་ནི་ས་དང་པོ་མན་ཆད་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལམ་གྱིས་བགྲོད་ནས་དེ་ནས་རང་དང་རྟོགས་པ་མཉམ་པའི་བུ་མོ་ས་དང་པོ་མ་དང་གཉིས་རྡོ་རྗེ་རྦ་རླབས་ཉམས་སུ་བླངས་པས་སྐད་ཅིག་མ་བདུན་གྱིས་ས་གཉིས།",
    "ས་བཅུ་གཅིག་པ་ལ་རང་དང་རྟོགས་པ་མཉམ་པའི་བུ་མོ་དང་རྦ་རླབས་གསུམ་ཉམས་སུ་བླངས་པས་སྐད་ཅིག་མ་བདུན་གྱིས་ས་བཅུ་གསུམ་གྱི་བར་དུ་བགྲོད་པ་ཡང་སྲིད་དེ།",
    "ཉི་མ་གཅིག་གི་སྦྱོར་བ་དང་།",
    "ཐིག་ལེ་དཀར་དམར་འདྲེས་པ་གསུམ་མོ།",
    "བྷ་གར་ཞེས་པ་ས་བཅུ་གཉིས་མ་ལ་སོགས་པ་མཆོག་གི་ཟེ་བའོ།",
    "བསྒོམས་ཉམས་སྐྱོན་ཡོད་མེད་ཕྱེད་ཅེས་པ་དེ་ཙམ་ན་སྐྱོན་ཅན་ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་སྤངས་ནས་རང་གི་སེམས་ཉིད་ཟག་པ་མེད་པའི་ཡེ་ཤེས་སུ་བདེ་སྟོང་མཆོག་དེར་ཐམས་ཅད་རོ་གཅིག་པར་རྟོགས་ཏེ་གཉིས་སྣང་ཐམས་ཅད་ནུབ་པའོ།",
    "ས་བཅུ་གསུམ་མོ།",
    "སྤྱན་ལ་སོགས་པ་ལྷ་མོ་རྣམས་དང་།",
    "ཁྲོ་མོ་རྣམས་དང་ཤཱཀྱ་ཐུབ་པ་ལ་སོགས་པ་སྤྲལ་པ་མཆོག་ནས་བཟུང་སྟེ།",
    "རི་བོང་དང་སྟག་དང་བྱ་ངང་མོ་དང་དཔག་བསམ་གྱི་ཤིང་དང་འདོད་འཇོའི་བ་ལ་སོགས་པ་དང་།",
    "སྣོད་མཐའ་ཡས་པ་དག་གི་རྣམ་པར་སྣང་བས་ཀྱང་གདུལ་བྱ་མཐའ་དག་གི་དོན་དུ་འགྱུར་བ་སྟེ།",
    "སྐུའི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞེས་པ་སྐུའི་གདུལ་བྱར་འགྱུར་ཚད་དུ་སྣང་བ་སྟེ་བློ་ཆུང་བའི་ཡུལ་དུ་མ་གྱུར་པས་བུདྡྷའི་བློ་ཡི་སྤྱོད་ཡུལ།",
    "སྟོབས་ཐིམ་པས་བདུད་བཞི་ཟིལ་གྱིས་གནོན་པ་ཧཱྃ་གི་སྟོབས་ལྟ་བུར་གྱུར་ཏེ།",
    "གསུང་གི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ།",
    "དེ་ལྟར་ཡིན་ཡང་རང་གི་ངོ་བོ་བརྟེན་པ་གནས་གྱུར་གྱི་སྐུ་གཅིག་ཡིན་ཏེ།",
    "དེ་དག་གི་ཚིག་གི་དོན་ནི་གོ་སླའོ། ། ད་ནི་དེ་དག་གི་གཞུང་ཉེ་བར་བསྡུས་ཏེ་བསྟན་པ་ནི།",
    "ཡང་རྟོག་པས་བརྟགས་ནི་འཇིག་རྟེན་པའི་ལམ་སྟེ་དེརྟོག་པས་བསྡུས་པས་ཡེ་ཤེས་འགྲོ་ལྡོག་གི་དུས་ཡིན་པས་སོ།",
    "རྟོག་མེད་རྟོགས་འདས་པའི་ལམ་སྟེ་དེ་རྣམ་རྟོག་འཇུག་ལྡོག་གི་དུས་ཡིན་པས་སོ།",
    "རྟོག་མེད་རྟོགས་པ་ནི་རང་བཞིན་སྟོང་པར་འཆར་བ་སྟེ་བདག་གཞན་གྱི་སྣང་བ་ཐམས་ཅད་སྟོང་པར་སོང་བས་སོ།",
    "འབྲིང་དམ་ཚིག་གི་ལམ།",
    "ཡོངས་རྫོགས་བསྟན་པའི་མངའ་བདག་རྗེ་བཙུན་ས་སྐྱ་པའི་ལྟབྱོནགྲུབ་ཐུན་མོང་མ་ཡིན་པའི་གཞི་དང་རྩ་བར་གྱུར་པའི་རྣམ་འགྲེལ་འདི་ཉིད་རྗེས་འཇུག་གང་ཟག་རྣམས་ཀྱིས་འཆད་ཉན་དང་།",
    "དེའི་ཞབས་ཀྱི་པདྨོ་ལ་རེག་ན་བདག་ལ་སྐུ་བཞིའི་དངོས་གྲུབ་སྟེར་བས་ཞབས་ཀྱི་པདྨོ་ལ་བཏུད་ཅེས་དངོས་སུ་སྨོས་ཏེ།",
    "རང་གི་ངོ་བོ་ས་མཚམས་ཀྱིས་ཕྱེ་བའོ།",
    "ཡང་དེ་དག་རེ་རེ་ཞིང་རང་གི་ངོ་བོའམ་ས་མཚམས་ཀྱིས་ཕྱེ་ན་རྣམ་གྲངས་བཅུ་སྟེ།",
    "ཡེ་ཤེས་འཇུག་ལྡོག་དང་རྣམ་རྟོག་འཇུག་ལྡོག་གི་ལམ་གཉིས།",
    "འཇིག་རྟེན་པའི་ལམ་དུ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སྐྱོན་མེད་སྐྱེས་ཀྱང་སྤྲིན་བར་གྱི་ཉི་མ་བཞིན་སླར་ལྡོག་པས་ཡེ་ཤེས་འཇུག་ལྡོག་གི་ལམ་ཞེས་བྱ་ལ།",
    "འདས་པའི་ལམ་དུ་རྣམ་པར་རྟོག་པའི་རྦ་རླབས་སྐྱེས་ཀྱང་རྒྱ་མཚོའི་རླབས་བཞིན་སླར་ཡེ་ཤེས་སུ་ལྡོག་པས་རྣམ་རྟོག་འཇུག་ལྡོག་གི་ལམ་ཞེས་བྱའོ།",
    "གཉིས་པ་ནི་ངན་སོང་ལས་མ་བསྒྲལ་བ་རྣམས་བསྒྲལ་བ་དང་།",
