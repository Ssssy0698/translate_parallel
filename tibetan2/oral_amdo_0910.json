    "འཁོར་གྱི་ལྷ་མོ་ཚུལ་དེ་ལྟ་བུ་བཅུ་དྲུག་གིས་བསྐོར་བ།",
    "འཁོར་གྱི་ལྷ་མོ་ཚུལ་དེ་ལྟ་བུ་སུམ་ཅུ་སོ་གཉིས་ཀྱིས་བསྐོར་བ།",
    "ཟུང་འཇུག་གི་ངོ་བོ་ཉིད་དོ་། དེ་ཡང་མཉམ་རྗེས་གཉིས་ལས་དང་པོ་མཉམ་གཞག་ལ་ཉམས་སུ་མྱོང་བ་ནི།",
    "གཙོ་བོ་ལྔའི་སྤྱན་ལྟ་བུའམ་དགྱེས་པ་རྡོ་རྗེ་ལྷ་དགུ་ལྟ་བུ་ལ་སེམས་ཟིན་ཏེ་དམིགས་པ་རྩེ་གཅིག་ཏུ་སོང་ན་སྣང་ཕྱོགས་ཀྱི་ངོ་བོ་ཉིད་ཅེས་བྱའོ།",
    "ཡང་ལྷའི་འཁོར་ལོ་སྣང་ལ་རང་བཞིན་མེད་པ་འཇའ་ཚོན་ལྟ་བུ་ལ་སེམས་རྩེ་གཅིག་ཏུ་ཟིན་ན་ཟུང་འཇུག་གི་ངོ་བོ་ཉིད་དོ།",
    "ངེས་པ་ནང་གི་འཆི་ལྟས་ཤིན་ཏུ་ངེས་པ་རྒྱས་པའི་འཆི་ལྟས་སོ།",
    "དང་པོ་ནི་རྨི་ལམ་དུ་རྒྱ་སྐྱེགས་ཀྱི་རི་ལ་འཛེགས་པ་དང་གོས་དམར་པོ་གྱོན་པ་དང་མེ་ཏོག་དམར་པོ་འཐུ་བ་དང་ཕྱིང་པ་དམར་པོ་གོན་པ་དང་སྔར་འགྲོ་མ་མྱོང་བའི་ཐང་ལ་རིང་དུ་ཕྱིན་པ་དང་བུད་མེད་ནག་མོ་རབ་ཏུ་ཁྲོས་པས་བདག་གི་ལྟོ་དྲལ་བ་དང་།",
    "རྔ་མོ་ལ་ཞོན་ནས་ལྷོར་འགྲོ་བ་ལ་སོགས་པ་རྨིས་ནའོ།",
    "ལུས་ངག་གི་སྤྱོད་པ་འགྱུར་བ་དང་།",
    "དབྱར་ཐ་ཆུང་མོན་གྲེས་ཉ་བའི་ཟླ་བ་ལ།",
    "སློབ་དཔོན་བིརླ་པའི་ཐུན་མོང་མ་ཡིན་པའི་གདམས་ངག་གསུམ་ནི།",
    "ལུས་ཐམས་ཅད་ཁྲིག་གིས་ཁེངས་པ་དང་མཆིལ་མ་གཅིག་མིད་ལ་ཨོག་ཀོས་ཨོལ་མགོ་མནན་ལ་རང་ཐུབ་ཚད་བཟུང་སྟེ།",
    "དེ་ལས་འོད་ཀྱི་གོང་བུ་རེ་ཆད་དེ།",
    "ལྟ་བ་རང་བྱུང་གི་ཡེ་ཤེས་བཞི།",
    "བརྟེན་པ་གསུམ་མན་ངག་གི་གཏུམ་མོ་དང་དགུའོ།",
    "བསྲུབ་ཤིང་གི་འཁོར་ལོ།",
    "ཡིད་འཇུག་ཡུལ་བརྟག་ཟས་དང་སྤྱོད་ལམ་གྱི་ལྕག་གིས་བསྐུལ་ལོ།",
    "བྱང་སེམས་ཧཾ་གི་འབེན་ལ་བརྡེག།",
    "ཐུན་རེ་ལ་དམིགས་པ་ལན་རེ་ལས་བསྐྱར་དུ་མེད།",
    "མྱུར་དུ་གསལ་སྟོང་ལ་སོགས་པ་རང་བྱུང་གི་ཡེ་ཤེས་འཆར་ཏེ།",
    "དེ་ཡང་པདྨའི་སྐད་པ་ལྟར་ཕྲ་བ་ཆུ་ཤིང་གི་སྡོང་པོ་ལྟར་དྲང་བ།",
    "ཟས་དང་སྤྱོད་ལམ་གྱི་ལྕག་གིས་བསྐུལ།",
    "འདི་ལ་ཟས་དང་སྤྱོད་ལམ་གྱི་ལྕག་གིས་བསྐུལ་ཞིང་།",
    "སྟེང་གི་ཉི་མ་ལ་བུ་ག་རྟ་རྔ་ཤོང་བ་ཙམ་གཅིག་བྱུང་བར་བསམ།",
    "མཛོད་སྤུ་ཧཾ་འཁྱོགས་པོ་མགོ་ཐུར་དུ་ལྟ་བ་བསམ།",
    "ལྕེ་ཆུང་གི་རྒྱབ་ནས་སོང་ནས་ཧཾ་ལ་ཕོག་པས་ཧཾ་ལས་བདུད་རྩིའི་རྒྱུན་ལྕེ་ཆུང་གི་སུཾ་གྱི་བར་དུ་བབས།",
    "ཟས་དང་སྤྱོད་ལམ་གྱི་ལྕག་གིས་བྲབ་བསྐུལ།",
    "རྣམ་པ་ཕྲ་བ་གཅིག་གཡས་རོ་མ་ནས་སོང་།",
    "ཡང་གཡས་རོ་མ་ནས་སོང་མགྲིན་པའི་ཡི་གེ་བཅུ་དྲུག་བསྲེགས།",
    "ཡང་རོ་མ་ནས་སོང་སྤྱི་གཙུག་གི་ཧཾ་ལ་རེག་པས།",
    "ཧཾ་ལས་བདུད་རྩིའི་རྒྱུན་བབ་གཡོན་རྐྱང་མ་ནས་མར་སོང་མགྲིན་པའི་ཡིག་འབྲུ་རྣམས་གསོས་བདུད་རྩིས་ཁེངས།",
    "དགུ་པ་མན་ངག་གི་གཏུམ་མོ་ལ་དམིགས་པ་བདུན་ལས་དང་པོ་མེ་དམར་སྐྱ་ནི།",
    "དེ་ནས་རང་གི་ལུས་ཁོང་སྟོང་དུ་དམིགས་ལ།",
    "མེ་དམར་སྐྱས་རང་གི་ལུས་གང་བར་བསམ།",
    "ཟས་དང་སྤྱོད་ལམ་གྱི་ལྕག་གིས་བསྐུལ།",
    "ཐུན་བཞིའི་ངེས་པ་བྱ་རབ་ཞག་གསུམ་འབྲིང་ལྔ་ཐ་མ་ཞག་དགུ་ན་དམིགས་པ་རེ་རེ་སྤོ།",
    "གཉིས་པ་མེ་དམར་ནག་གི་དམིགས་པ་ནི།",
    "རྐང་མཐིལ་གཉིས་སུ་རཾ་དམར་ནག་རེ་རེ་བསམ་ལ།",
    "ལོང་བུའི་ནང་ནས་སོང་བརླའི་རྩ་བོ་ཆེ་ནས་གསང་གནས་སུ་འཛོམ།",
    "གསུམ་པ་ཐིག་ལེའི་འཐབ་མོ་ནི།",
    "འཁོར་ལོ་དེ་ལས་མེ་སོར་བཞི་ཨིཡཾཧཾ་ནས་ཁྲུ་གང་གི་བར་དུ་འབར་བ་ལ་ཞག་གསུམ་ལ་སོགས་པར་རོ།",
    "ལྟ་བ་རང་བྱུང་གི་ཡེ་ཤེས་བཞི་ནི།",
    "ཉོན་མོངས་པ་རང་བྱུང་གི་ཏིང་ངེ་འཛིན་དང་།",
    "རྣམ་རྟོག་རང་བྱུང་གི་ཏིང་ངེ་འཛིན།",
    "སྣྲེལ་གཞི་རང་བྱུང་གི་ཏིང་ངེ་འཛིན།",
    "གསལ་ཞིང་ཡང་བ་རང་བྱུང་གི་ཡེ་ཤེས་ནམ་མཁའ་བཞིན་དུ་དྲི་མ་མེད་པའི་ཏིང་ངེ་འཛིན་ནོ།",
    "བཞི་པ་ནི་ཟུང་འཇུག་གི་ཧཱུཾ་དུ་ཞུགས་ན་གསལ་ཞིང་ཡང་བའི་རང་བྱུང་སྐྱེ་སྟེ།",
    "ས་བཞི་ལ་རིགས་དྲུག་གི་སྐད་ཤེས།",
    "ཚིག་གི་མཆོག་འགྲུབ།",
    "རི་མོ་ཅན་མ།",
    "དང་པོ་ནི་བུ་མོ་གང་ཞིག་རི་དྭགས་ཀྱི་སྟོད་དེ་ནུ་མ་འཁྲང་བ།",
    "ལྟེ་བ་ན་དུང་གཡས་སུ་འཁྱིལ་པའི་རི་མོ་ཡོད་པ།",
    "རི་མོ་ཅན་ནི།",
    "ལྟེ་བའི་སྟེང་ན་རི་མོ་འགྲེང་བུ་གསུམ་ཡོད་པ་སྤྱིར་ཚིགས་ཀྱི་ཚོགས་ཐམས་ཅད་རིང་བ།",
    "བུ་མོ་པད་ཅན་གྱི་རིགས་ཞེས་བྱ་བ་རྗེས་སུ་བསྟན་པ་ནི།",
    "ཡུམ་གྱིས་ཡབ་ཀྱི་གསང་བ་མི་དམིགས་པ་ལས་ཧཱུཾ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ་ལྟེ་བར་ཧཱུྃ་གིས་མཚན་པའི་བུག་པར་ཕཊ་དམར་ནག་མགོ་གྱེན་དུ་ལྟ་བ་ནོར་བུ་ལ་ཨོཾ་གྱིས་བྱིན་གྱིས་བརླབས།",
    "དེ་ལ་དང་པོ་ནི་གནས་དབེན་པར་སོང་།",
    "གསང་ཐུབ་པ་སྟེ་དྲི་ལ་མི་བསྣོམ་མོ།",
    "གསང་ཐུབ་པ་སྟེ་དེ་ལ་རེག་པར་མི་བྱའོ།",
    "བདག་གི་བདེ་བ་སྤྱོད།",
    "རོ་འཛིན་རང་གི་གནས་སུ་སྦྱར་ཞེས།",
