    "རུང་བར་གསུངས་ཀྱང་འཛེམས་པ་འདིས།",
    "ཉི་མར་རྟག་པར་བསྐོར་བའི་དུས་བཞི་ཡི།",
    "འཇིག་རྟེན་བྱུང་བ་སྔ་མ་ཉམས་པར་བྱེད།་",
    "རྒྱལ་གཅེས་ལུགས་སྲོལ་ངེས་པར་གོམས་དགོས་ཞེས།",
    "ཡལ་འདབ་ལྔ་པ་མཉམ་པར་སྦྱོར་བ་ཡི།",
    "འཁྲུལ་ལྡན་མཚོན་ཆའི་བཟོ་རིགས་མ་བསླབས་པར།",
    "དེ་ཕྱིར་ཇི་ལྟ་ཇི་སྙེད་མཁྱེན་པ་ཡི།",
    "ཡེ་ཤེས་སྣང་བ་བསམ་མི་ཁྱབ་པར་འཕེལ།",
    "ཁེངས་པ་གོམས་པར་བྱའོ་ཞེས།",
    "རིངས་པར་མ་བཏབ་པ་མིན་ན།",
    "ལྔ་བའི་ལམ་དུ་འཁྱམས་པར་འགྱུར།",
    "རྒྱལ་བའི་ཤེས་བྱའི་ཆུ་ལ་རབ་ཚོད་བྱས།་",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་ཟླ་གཞོན་འཛུམ་པའི་གཟིས།",
    "པདྨའི་སྐྱེད་ཚལ་ཅིག་ཅར་བཞད་བྱས་པས།",
    "ཐུབ་བསྟན་གླིང་བཞིའི་དཀྱིལ་འཁོར་མཛེས་པར་གྱུར།",
    "སིམ་པར་བྱས་ལ་ཀུན་གྱིས་ཡི་རང་བརྗོད།",
    "ཞུགས་ནས་གཞན་གྱི་སྤྱོད་པར་བརྟགས་པ་ན།",
    "ཚན་རིག་རྣམ་མང་མཁྱེན་པའི་སྤོབས་པ་མཐོ།",
    "འདིར་བཞུགས་སློབ་དཔོན་ཚོགས་ཀྱི་རྒན་དུ་མཛེས།",
    "ཁྲོ་གཉེར་ངོ་ཟུམ་གནག་པར་སྡོད་པ་ཡང་།",
    "གང་ཞིག་སྙན་པར་སྨྲ་བ་བསླབ།",
    "གྲངས་མེད་དུ་མའི་དཀའ་སྤྱད་མ་དགོས་པར།",
    "ཀུན་མཁྱེན་ཁས་བླངས་མུ་སྟེགས་སྟོན་པ་ཡིས།",
