    "བགྲོད་པར་འགྱུར་གྱི་བར་དུ་སྦྱིན།",
    "དཀྱིལ་འཁོར་གྱི་ནི་རྣམ་པར་དབྱེ།",
    "འདི་ལས་མ་དག་རྣམ་པར་སྤངས།",
    "ཉི་མའི་ལོངས་སྤྱོད་རྣམ་པར་དག་པ་མཐོང་ནས།",
    "དནི་སྒྲ་གཅན་རྒྱུ་སྐར་ལ་འོངས་སྤྱོད་པ་གསུངས་པ།",
    "ཁ་ཅིག་ཏུ་ཉིན་ཞག་སོ་སོའི་གཟའ་ལྷག་པསགསལབའི་དོན་དུགཟའ་གཅིག་དམན་པར་འགྱུར་རོ།",
    "དནི་བཀྲཤས་། གསུངས་ཏེ།",
    "ད་ནི་མིག་དམར་དག་ལས་གསུངས་པ།",
    "ཐ་སྐར་ལ་སོགས་པའི་སྐར་མའི་ལོངས་སྤྱོད་ལ་གལཏེ་བུ་ལོན་ལྷག་ནའཁོར་ལོ་བསྲེས་ལ་རྣམ་པར་སྦྱང་ཞེས་པ་ནི།",
    "དེ་དག་བསྲོསལ་བུ་ལོན་རྣམ་པར་སྦྱང་ངོ་ཞེས་བའི་དོན་ཏོ།",
    "ཕྱེད་པས་ལྷག་པར་གྱུར་ནའང་འདིར་ལྷག་མ་གང་ཡིན་པ་ཕྱེད་པས་ལྷག་པར་འགྱུར་ནའོ།",
    "སྐར་མ་དྲུག་ཅུས་བསྐྱུར་ཏེ་ཆུ་ཚོ་ད་དག་དང་རབ་ཏུ་ལྡན་པར་གྱུར་པ་ཞེས་པ་ནི་ཆུ་ཚོད་ཀྱི་ཚོགས་ཀྱི་དོན་དུ་རྒྱ་སྐར་གྱིཚོགསདྲུག་ཅུམ་བསྐྱང་བར་གྱུར་པལ་འོག་ན་གནས་པའི་ཆུ་ཚད་ཀྱི་ཚོགས་སྟེང་དུ་ལྡན་པར་འགྱུར་རོ།",
    "གྲངས་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེས་པར་ཞེས་པགདོན་མི་ཟ་བར་རོ།",
    "དཀར་པོ་ལསརྣམ་པར་དག་པར་གྱུར་པནི་དཀར་པོར་འགྱུར་ཏེ།",
    "རྣམ་པར་དབྱེའོ།",
    "ཅི་སྟེ་བུ་ལོན་དག་པར་མ་གྱུར་ན།",
    "དེའི་ཚེ་རྒྱུ་སྐར་གྱི་འཁོར་ལོ་རབཏུ་བསྲེས་ནས་བུ་ལོན་རྣམ་པར་སྦྱང་བར་བྱའོ།",
    "དནི་ཕུར་བུ་གསུངས་པ།",
    "སླར་ཡང་མྱུར་བའི་ལས་དགོལརྐང་པར་བ་གསལ་མ་ནུའི་གནས་ཏེ།",
    "ཐམསཅདདུ་ལྔ་བོའི་དོན་ལ་བདུན་པར་རིག་པར་བྱའོ།",
    "དེ་ནི་སྤེན་པ་གསུངས་པ་མཁའམིགལ་དང་རིག་བྱེད་ཀྱིས་དམན་གསལ་བའི་ཉིན་ཞག་ཚོགས་ནི་ཞེས་པ་སྟེ་ག།",
    "དེ་བཞན་དུ་ཕྱེད་ཕྱི་མ་ལ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "ཞས་གསུངས་པའི་ཕྱིར་རོ།",
    "ད་ནི་རྒྱུ་བའི་མཚན་ཉིད་གསུངས་པ།",
    "མྱུར་དལ་རྒྱུ་བ་དགཀྱ་ངརམ་པས་རྐང་བ་བགྲོད་པ་ལ་སྟེ་ཞེས་པ་ནི་མྱུར་བའི་ལས་ལ་ཉི་མའི་དཀྱིལ་འཁོར་ལས་ཤར་བའི་གཟའི་རྐང་པ་ཆང་བཅུ་བཞིའི་ཆུ་ཚོད་སྔམ་ལོངས་སྤྱོད་བ་ནི་མྱུར་བར་རྒྱུ་བཞེས་བརྗོད་དོ།",
    "འདིར་༡ཤར་ནས་རམ་པར་བགྲོད་པ་ཕྱེད་སྔ་མའི་བར་དུ་ནོར་འཕེལ་ལོ།",
    "གང་དག་སུ་ཞག་ཉི་མའི་ལོངས་སྐྱོད་ལ་ན་རབཞུགས་གཟའ་དེ་དག་ཀྱང་ངེས་པར་ནུབ་པར་འགྱུར་ཞེས་པ་སྟེ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་གྱི་འོད་ཟེར་གྱིས་མི་མཐོད་བའི་ཕྱིར་ནུབ་པར་གྱུར་བ་ཞེས་བརྗོད་ཀྱི་གཟའ་ན་མ་པ་ཐམས་ཅད་དུ་མེད་པ་ནི་མ་ཡཞིནོ། ཉིམ་བཏང་ནས་འཆར་བར་འགྱུར་ཏེ་ཞེས་པ་ནི་ནུབ་པར་གྱུར་པའི་རྒྱུད།",
    "དེའི་ལམ་ཡང་བགྲོད་པ་འགྲོ་འགྲེལ་བའི་རྣམ་པར་དབྱེ་བས་སོ།",
    "ཞེས་པནི་འཆར་བའི་གཟའ་དེའི་ལམ་ཡང་བགྲོད་པ་འགྲོ་བའི་རྣམ་པར་དབྱེ་བས་སོ།",
    "མིའི་དཀྱིལ་འཁོར་ནས་ཀེ་ལ་ཤའི་ོབྱང་ངུ་གངས་ཅན་གྱི་བར་དང་གངས་ཅན་ནས་ལྷོརམེའི་དཀྱིལ་འཁོར་གྱི་བར་དུ་ཕྱེད་དང་བཅས་པའི་ཉིན་ཞག་བརྒྱ་བརྒྱད་ཅུ་རྩགཉིས་ཀྱི་རྣམ་པར་དབྱེ་བ་སྟེ།",
    "དེ་ཡིས་ཉི་མའི་བགྲོད་པ་འགྲོ་བའི་རྣམ་པར་དབྱེ་བའོ།",
    "མཇུག་རིངསརྣམས་ནི་གཡོན་གྱི་ཡན་ལག་ཏུ་ཡང་དག་པར་བྱུང་བའི་ཕྱིར་རོ།",
    "གཡས་ཀྱི་ཡན་ལགཏུ་ཡང་དག་པར་བྱུང་བའི་ཕྱིར་རོ།",
    "སྐར་མ་གཞནལ་ཕན་ཚུནམས་བདག་ཏུལྡན་པར་འགྱུར་རོ།",
    "དེ་ལྟར་སྒྲ་ག་ཅན་གྱིས་ནི་ཕྱོགས་མཚམས་སུ་འཛིན་རི་བོང་འཛིན་བཞེས་པ་ནི།",
    "དེའི་ཚེ་མྱུར་བ་དང་དལ་བ་དག་ཕྲད་པར་མི་འགྱུར་ཏེ།",
    "འཆར་བ་ཡང་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དོན་དམ་པར་གཟའ་རྣམས་ཀྱི་གནས་གཞན་པ་མེད་དོ།",
    "སེང་གེ་བུམ་པར་རབ་ཏུ་ཞུགས་པར་གྱུར་པ་ན་སྟེ།",
    "དེ་བཞན་དུབུམ་པར་ཉ་མས་སའི་དུམ་བུ་གཉིས་པལའོ།",
    "ཉལདུམ་བུ་གསུམ་པར་རོ།",
    "གཞུལ་གནས་པས་དུམ་བུ་བཅུགཉིས་པར་འགྱུར་ཏེ།",
    "ཡུནབོའི་ལྷའི་ཛམ་བུའི་གླིང་ཆུང་ངུའི་སའི་དུམ་བུའདཀརཀ་ཊར་ཉི་མ་གནས་པས་ལྷོར་བགྲོད་པར་འགྱུར་རོ།",
    "གཉིས་པར་སེང་གེའི་ཉ་མས་སོ།",
    "ལྷུན་པོའྀ་ནུབ་ཏུ་སཱ་ལྷོར་བགྲོད་པརའགྱུར་རོ།",
    "ཁྱིམ་བཅུགཉིས་ཀྱི་དབྱེ་བས་འཇག་རྟེན་རྣམས་ཀྱི་ལྷོར་བགྲོད་པར་འགྱུར་རོ།",
    "དེ་ནས་གཡས་ཕྱོགས་སུ་ཡང་ཟད་པར་འགྱུར་ཏེ།",
    "ཞི་མའི་གདུང་བ་ར་བྱེད་པ་ནི་སྟེང་དུ་སྟོང་ཕྲག་བཅུ་རྩ་ལྔར་རིག་པར་བྱའོ།",
    "ད་ནི་དུམ་བུ་བཅུག་ཉསི་ལ་ལྷོ་དང་བྱང་དུ་ཉིན་ཞག་སོ་སོར་ཉི་མཐད་ཀར་འགྲོ་བ་གསུངས་པ།",
    "རིདང་མཉམ་པ་བགྲོད་པ་དག་དང་ཞེས་པ་ནི་དུམ་བུ་སོ་སོ་རི་དང་མཉམ་པ་ལྷུན་པོ་ལ་མངོན་དུ་ཕྱོགས་པར་ཉིམ་བགྲོདཔ་ནི་བྱང་དང་ལྷོ་ངག་གོ།",
    "དེ་བཞིན་དུ་དུམ་བུབཅུགཉིས་སུ་ཇིལྟར་འཆར་བ་ཤར་ཡིནཔ་དེ་བཞིན་དུདེ་ནུབ་པ་ནི་ནུབ་ཏུ་རིག་པར་བྱའོ།",
    "འཕགས་པའི་ཨཡུལ་དུ་ཡང་ཉིན་མཚན་སོ་སོ་ལ་ཆུ་སྲང་གཉིས་འཕེལ་བ་འམ་འགྲིབ་པར་རིག་པར་བྱ་སྟེ།",
    "ཉི་མ་ལས་རྣམ་པར་དག་པའི་དབྱེ་བསམྱུ་བར་བྱེད་དོ།",
    "ད་ནིདལབའི་བྱ་བ་ལས་སྐྱེ་བའི་ཁྱིམ་གྱི་ཆུ་ཚོད་དལ་བའི་རྐང་པ་རྣམསགསུངས་པ།",
    "དེལྟར་དུས་ཀྱི་འཁོར་ལོའི་ཟླབའི་ཡོངས་སུ་ལོངས་སྤྱོདཔ་བརྒྱད་ཀྱིས་བསྒྱུར་བ་ལས་དྲུག་ཅུའི་ཆ་ཤས་ནི་ཁྱིམ་གྱི་རྐང་པའི་ཆུ་ཚོད་དུ་རིག་པརབྱའོ།",
    "ད་ནི་སྒྲགཅནགྱིལོངས་སྤྱོད་ལས་མཇུག་རིངས་ཀྱི་ལོངས་སྤྱོདགསུངས་པ།",
    "དེ་ནི་ཉི་མའི་ལྷག་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་མཇུག་རིངས་དེ་ཡིས་འཆ་ར་བའི་ཆ་དག་ཤེས་པར་གྱུར་ན།",
    "ད་ནི་གཟའ་རྣམས་ཀྱི་སྐྱེ་བ་དག་པར་བྱ་བའི་དོན་དུ་རྒྱུ་སྐར་གྱི་ཚོགས་གསུངས་པ།",
    "དེ་ཉིད་མཇུག་རིངས་ཤར་བ་ནས་ཉིན་ཞག་སོ་སོ་ལ་འགྱུར་རོ་ཞེས་པ་ནི་བྱ་ཚེ་བར་རིག་པར་བྱའོ།",
    "ད་ནི་གཟའ་རྣམས་ཀྱི་རྒྱུ་བའི་སྟོབས་གསུངས་པ་ཟླ་སྐྱེས་ཞེས་པ་ལ་སོགས་པ་སྟེ་ཟླ་སྐྱེས་གཟའ་ལག་དང་བློན་པོ་ཕུར་བུ་ནི་མྱུར་བ་སྟེ།",
    "མྱུ་བར་རྒྱུ་བ་ཕྱེད་སྔ་མ་ལ་ཤར་བར་གྱུར་པ་ན་སྟོབས་དང་ལྡན་པར་འགྱུར་རོ།",
    "ད་ནིཉི་མ་དང་ཟླ་བའི་རྐང་བ་གསུངས་པ།",
    "ཉིན་ཞག་བདུན་གྱི་བར་དུ་ཟླ་བའི་ཆའཕེལབའི་དོན་དུ་རྐང་པ་བརྒྱཉི་ཤུར་འགྱུར་ཏེ་འཆད་པར་འགྱུར་བ་ལ་བརྗོད་པར་བྱའོ།",
    "བཞི་བཅུ་རྩ་བརྒྱད་ཀྱི་གྲངས་རྣམས་བྱེད་པ་བརྗོད་པར་འདོད་པ་ལ་རིག་པར་བྱའོ།",
    "ད་ནི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་སྒྲ་གཅན་འཇུག་པའི་མཚནཉིད་གསུངས་པ།",
    "ལོངས་སྤྱོད་ཕྱེད་དག་པར་གྱུར་ན་བྱེད་འཛིན་ནོ།",
    "དེ་བཞིན་དུགཟའ་འཐབ་པ་ལ་སོགས་པ་མཐའ་དག་གྲུབ་པའི་མཐའ་ལས་ཤེས་པར་བྱའོ།",
    "ནང་དུ་ནི་གཟའ་འཐབ་པ་བརྗོད་པར་འདོད་པ་མེད་དོ།",
    "ཉིན་ཞིག་སུམ་བརྒྱ་དྲུག་ཅུས་ལོ་སྟོང་ཕྲག་ཉི་ཤུ་རྩ་བཞིལོངས་སྤྱོད་པར་འགྱུར་ཏེ།",
    "རབ་བྱུང་ཞེས་པར་འགྱུར་བཇི་ལྟ་བདེ་བཞིན་དུ་ནག་པའི་ཟླ་བ་ལ་སོགས་པར་ཡང་འགྱུར་རོ།",
    "དེ་ནསརྫོགས་ལྡན་ཀྱི་དུས་འཇུག་པར་འགྱུར་རོ།",
    "ཟླ་བརྫོགསན་ངེས་པར་འགྱུར་ཏེ་སླར་ཡང་གཟའ་དང་ཆུ་ཚོད་ཀྱི་ནི་གནས་རྣམས་དག་ཏུ་འགྱུར།",
    "དཔལ་ལྡན་དུསཀྱི་འཁོར་ལོ་གཟའ་ཡིས་ཚོགས་དང་བཅས་པ་འདིད་གཙེས་པ་ལ་སོགས་པ་བརྗོད་པའི་རིམ་པས་ཕྱི་དང་ལུས་ལ་ད་བྱེར་མེད་པར་བསྡུ་བ་དང་ནི་སྤྲོ་བའི་སླད་དུ་སྲིད་པ་གསུམ་འདོད་པ་དང་གཟུགས་དང་གཟུགས་མེད་པ་སྟེ།",
    "ཁྱབ་པར་བྱ་བ་བ་སྟན་པད་གཡོ་བའི་དངོས་པོ་ཐམས་ཅད་ལ་ཁྱབ་པར་བྱེད་པ།",
    "དྲ་ནི་དབྱངས་འཆར་བ་གསུངས་པ།",
    "ཡོན་ཏན་ཡ་ཎར་བསྐྱེད་པའི་ཕྱིར་ཨ་ཨ་ཨུཎ་རྀ་ལྀ་ཀ་ཅེས་པར་རིགས་ཏེ།",
    "དེབཞིན་དུ་ཨ་ཨེ་ཨར་ཨོ་ཨལ་ཙདང་དེ་བཞིན་དུ་ཧ་ཡ་ར་ཝ་ལཊ་འཇམ་དཔལ་གྱིས་ངེས་པར་བསྟན་ཏེ།",
    "ནག་པའི་དཀར་པོའི་ཚེས་གཅིག་ལ་སོགས་པ་ཇི་སྲིད་པར་ཟླ་བ་གཉིས་པའི་ཡ་ང་དཀར་པོའི་ཚེས་གཅིག་གོ།",
    "དེ་བཞིན་དུ་ལོའི་ཉིན་ཞག་སུམ་བརྒྱ་དྲུག་ཅུ་ལ་བདུན་ནུ་རྩ་གཉིས་ཀྱི་ཨ་ཡིག་ལབརྒྱ་སོགས་པ་རྣམས་རིམ་པས་འཆ་ར་བར་ཤེས་པར་བྱ་སྟེ།",
    "ལོ་ལ་སོགས་པ་རྣམས་ཤེས་པར་བྱའོ།",
    "ལྔ་པ་ལ་ནི་ནུབ་པར་འགྱུར་ཞེས་པནི།",
    "དང་པོར་ཏེ་གྲོག་མ་སུམ་ཅུའི་དབྱངས་རྣམས་འདིརནིའ་ཆད་པར་འགྱུརབའདི་དེ་ཡུད་ཙམ་ཡུད་ཙམ་དག་ལའོ།",
    "འདིར་ཇི་ལྟར་རིགས་པར་ལྷག་པའི་ལྷའོ།",
    "གསལ་བྱེད་འཆར་བའི་དུས་སྦྱོར་གྱི་ཆུ་ཆོད་ཀྱི་དབྱེ་བས་ཤེས་པར་བྱའོ།",
    "དེ་ཉིད་ནིགང་ཞིག་རྣལ་འབྱོར་ལྡན་པས་ཤེས་པར་བྱེད་དེ་བ་ཞན་རྣམས་ཀྱི་ནི་མ་ཡིན་ནོ།",
    "དལྟར་བྱུང་བ་ཤེས་པ་མིན་པར་ཏེ་དེ་ལྟར་སྔར་བརྗོད་པ་དག་ད་ལྟར་བྱུང་བའི་དུས་སུཤེས་པར་འགྱུར་བ་མ་ཡིན་པར།",
    "གལ་ཏེ་ཡིན་པ་ཡོད་ན་དེའི་ཚོ་ནོར་རྣམ་པར་ཉམས་པར་འགྱུར་ཏེ།",
    "གཡུལདུ་རྣམ་པར་རྒྱལ་བར་འགྱུར་རོ།",
    "སོགས་པའི་གཟའ་རྣམས་ཀྱི་ལོངས་སྤྱོད་བརྒྱ་རྩ་བརྒྱད་དགོད་པརབྱ་སྟེ།",
    "ཡན་ལག་བཅུགཉིས་པརྣམས་སོ།",
    "བཅུག་ཅིག་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཡོན་དད་མདུན་དུ་གནས་པས་འཆི་བ་ར་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་ཚེས་དེ་དག་བརྒྱད་གཉིས་ཀྱིདབྱེབ་རྣམས་ལ་འཆར་བར་ཤེས་པར་བྱའོ།",
    "དེབཞིན་དུ་ཚས་ཀྱི་ཕྱེད་ཕྱིམ་ལ་ཡང་ཤེས་པར་བྱའོ་ཞེས་པ་ནི་རྣལ་འབྱོར་མའི་འཁོར་ལོ་འཆར་བའི་དེས་པའོ།",
    "ད་ནི་དྲག་པོའི་སྟོབསགསུངས་པ།",
    "དས་ན་མ་གསུངས་སོ།",
    "ད་ནི་ཐུན་ཕྱེད་པའི་སྒྲ་གཅན་གྱི་སྟོབས་གསུངས་ཏེ།",
    "དབྱངས་རིར་པོ་ནི་དབྱངས་ཤིན་ཏུ་རིང་པོས་འཇོམསཔར་བྱེད་དོ།",
    "སྦྱོར་བ་༣ གཞན་ནི་བོནས་བརྗོད་པ་དང་པོའི་མིང་དེ་རྣམ་པར་རྒྱལ་བར་འགྱུར་ཏེ།",
    "སྐབས་གསུམ་པརྣམས་འཇིག་པར་བྱེད་ལ།",
    "གཡུལ་དུ་ཕམ་པའི་དགྲ་བོ་དག་ཞིག་ལ་ཏེ་འཕྲལལ་མཁར་གྱི་ནང་དུ་ཞུགས་པར་གྱུར་པ་ན།",
    "དེ་དག་ཀྱངགནས་བརྒྱད་དུ་ཕུག་པར་གྱུར་པ་སྟེ།",
    "གནས་བརྒྱད་པོ་དེ་དག་ཏུ་ཕུག་པར་གྱུར་པ་སྟེ།",
    "སེར་དྲུག་ནི་ལྕེའིམཉའ་མནོན་གྱིཚད་ཡིན་ལ་དེའི་བུག་པར་སྒྱོགས་མདའི་མཉའ་ནོནགྱི་བར་དུ་བཅུག་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་ཆུ་འཇུག་པར་མི་འགྱུར་བར་བསྡམ་པརབྱའོ།",
    "ལྕགས་ལས་བྱས་པའི་ཆུང་དུའོ།",
    "ཞེས་པ་རང་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ད་ནིད་པྱིད་ཀྱི་དགའ་སྟོན་གྱི་སླད་དུ་འཁོར་ལོའི་ཕྱོགས་ཀྱི་མཚན་ཉིད་གསུངས་པ།",
    "ད་ནི་ལྡུམ་ར་ལ་སོགས་པ་བཅུ་པའི་དོན་དུ་ཆུའི་འཁྲུལ་འཁོར་གྱིས་ཚན་ཉི་དགསུངས་པ་སྟེ།",
    "སྦུབས་ཀྱི་བུག་པར་མདུནནས་རྒྱས་གདབ་པར་བྱའོ།",
    "དེ་ནས་ཇི་སྲིད་འཁྲུལ་འཁོར་ཆུས་གང་བར་གྱུར་གྱི་བར་དུ་རྩ་བའི་འཁྲུལ་འཁོར་གྱི་དབུས་ཀྱི་བུག་བ་ནས་ཆུ་གཞུག་པར་བྱའོ།",
    "ཞེས་པ་ནི་བྱང་ཆུ་བ་ཀྱི་སེམས་ཀྱི་ཐིག་ལེ་བཞིའི་དབྱེ་བས་ཞེསཔར་བྱའོ།",
    "སྟོང་པ་ལ་ནི་ཡེ་ཤེས་རྣམ་པར་བསྲེས་པ་ཞེས་པ་ནི།",
    "དེ་ཉིད་ནི་སྟོང་པསྟེ་སྟོད་པ་ཉིད་ཀྱི་གཟུགས་ལ་བསྒོམས་པའི་སྟོབས་ཀྱི་འཛིན་པར་བྱེད་པའི་སེ་མས་གཟུང་བར་བྱ་བ་སེམས་ཀྱི་སྣང་བ་ལ་རྣམ་པར་བསྲེས་པ་ནིརོ་མཉམ་འགྱུར་མེད་རྟག་པར་ཡང་འགྱུར་ཏེ།",
    "འཆད་པར་འགྱུར་བའི་ཡེ་ཤེས་ཀྱི་ལེའུར་མཆོག་ཏུ་མི་འགྱུར་བའི་ཡེ་ཤེས་གྲུབ་པ་ལས་རྒྱས་པར་བརྗོད་པར་བྱའོ།",
    "མངལ་འཛིན་པ་ལ་སོགས་པ་གསུངསཔ་ས་བོན་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "ཕྱི་ནས་ནིམེ་ཡིས་སྨིན་པར་བྱེད་ཅིང་ཞེས་པ་ནི་ཆུ་ཡིས་རབ་ཏུ་བསྡུས་པའིས་བོན་འདི་མེ་ཡིས་རབ་ཏུ་སྨིན་པར་བྱེད་དོ།",
    "ནམམཁ་འགོང་བ་དག་ཀྱང་འཕེལ་བའི་སྔོན་དུ་གོ་སྐབས་སྦྱིན་པར་བྱེད་དོ།",
    "མེ་ནི་ཟོས་པའི་རོ་རྣམས་སྨིན་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་ལོ་བཅུ་དྲུག་ནས་སྐྲ་དཀར་སྐྱེས་པའི་བར་ནི་རྒྱས་པར་གཞན་ནག་པོའི་གནས་སྐབསསོ།",
    "ཚའཆི་བའི་ཉིན་ཞག་ལ་འབྱུངབ་ཐམས་ཅད་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་ཉིད་ཀྱི་ཕྱིར་ལུས་ལ་རིགས་ལྡན་གྱི་གནས་སྐབས་སུ་འགྱུར་ཏེ།",
    "བཙའ་བའི་མཐར་ཐུག་པ་གསུངས་སོ།",
    "རུས་པར་འགྱུར་བ་དང་།",
    "དེ་ལྟར་སྐྱམསརྨོངས་པར་བྱས་པའི་མཐའ་དག་འགྲོ་བནི་སྡུག་བསྔལ་དག་ལས་སྡུལ་བསྔལ་འཛིན་པར་བྱེད།",
    "༡མ་ངར་འཛིན་པ་དང་ང་ཡིར་འཛན་པའི་བདག་ཉིད་ཅན་གྱིས་རྨོངས་པར་བྱས་པ་ནི་ནམྱལ་བ་དང་ཡི་དགས་དང་དུད་འགྲོའི་སྡུག་བསྔལ་དག་ལས་སྡུག་བསྔལ་འཇིམ་པར་བྱེད་དོ།",
    "སྔགས་ཀྱི་ཚུལ་དང་ཕ་རོལ་ཆུ་ཕྱིན་པའི་ཚུལ་འབྲས་བུ་དང་རྒྱའི་བདག་ཉིད་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པའོ།",
    "འདིར་དང་པོར་འཇིག་རྟེན་ཀུན་རྫོ་བ་ཀྱི་རྣམཔར་དག་པའི་སྐུ་ལ་སོགས་པ་མངལ་ནས་སྐྱེས་པའི་ལུས་ལ་ཡང་དག་པར་བལྟ་བར་བྱ་སྟེ།",
    "ད་ནི་མངལ་དུ་དག་པའི་སྐུར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་ཁྱབ་པར་བྱ་བ་དང་ཁྱབ་པར་བྱེད་པར་འབྲེལ་པའི་སེམསཀྱི་དབྱེ་བས་སྐུ་ཡི་དབྱེ་བ་རྣམ་པ་བཞི་དང་།",
    "རྣམ་པར་ཤེས་པ་བསྲེས་པའོ།",
    "ཡེ་ཤེས་རྡོ་ཌཱིལ་སོགས་ཀུན་ནི་ལྷན་ཅིག་སྐྱེས་བའི་དགའ་བ་ལ་སོགས་པར་འགྱུར་རོ།",
    "དེ་ནས་སོསུམ་ནུ་རྩ་གཉིས་རོབ་ཏུ་སྐྱེས་པར་གྱུར་པ་ན་ཐུགས་འདུ་ཤེས་འཛིན་པ་པོར་འགྱུར་ཏེ།",
    "སྐུ་དངོགསུངས་དང་ཐུགས་དང་ཡེ་ཤེས་རྫོགས་པ་བརྗོད་པའི་ཕྱིར་རོ།",
    "རྟེན་དང་བརྟེན་པའི་འབྲེལ་པ་གསུངས་པ།",
    "འདིར་ས་ལ་སོགས་པའི་རང་བཞིན་མེད་ན་མ་རིག་པ་ལ་སོགས་པའི་རྐྱེན་མེད་པར་འགྱུར་རོ།",
    "དེ་ཡང་རྣམ་པ་བཅུ་སྟེ་འཆད་པར་འགྱུར་བ་ལས་བརྗོད་པར་བྱའོ།",
    "ང་ནི་གཟུང་བ་དང་འཛིན་པའི་འབྲེལ་བ་གསུངས་ཏེ།",
    "འདིར་གཞན་གྱི་རིགས་ལ་འཁྱད་པས་པྱ་བ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་ནི་སྟོད་པ་ཞེས་པ་སྟོང་པའི་རིགས་ལས་བྱུང་བའི་རྣ་བའི་དབར་བོས་ནི་ཡེ་ཤེས་ཀྱི་ཁམས་ལས་བྱུང་བའི་སྒྲ་འཛིན་པར་བྱེད་དོ།",
    "འཇིག་རྟེན་ཀུན་རྫོབ་ཀྱི་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་རྣམས་ཁམས་སོ་སོ་ལ་གྲུབ་པར་གསུངས་པ།",
    "འདིར་སེ་དགུཁམས་དང་ཕུང་པོ་རྣམས་གཅིག་ཉིད་དུ་གྲུབ་པར་གསུངས་སོ།",
    "དེའི་ཕྱིར་མེ་ལ་ཚོར་བ་གཙོ་བོས་གྲུབ་པར་འགྱུར་ཏེ།",
    "འདུ་བྱེད་སྐྱེད་པར་བྱེད་པ་སྟེ།",
    "ནམམཁའ་ལ་རྣ་བའི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་མཚན་ཉིད་རྣམ་པར་ཤོས་པ་གྲུབ་བོ།",
    "ཅིའི་ཕྱིར་ཁམས་དང་ཕུང་པོ་ལ་སོགས་པ་ཐམས་ཅད་དུ་འགྱུར་ཞེན་གསུངས་པ།",
    "དེའི་ཕྱིར་གཟུང་བར་བྱ་བའི་རང་བཞིན་གྱིས་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པའི་རང་བཞིན་རྣམ་པར་ཤེས་པར་བྱའོ།",
    "ཆུའི་ཁམས་ལས་ལྷ་སྦྱིན་ནོ།",
    "འདབ་མའི་གྲངས་ན་འཆད་པར་འགྱུར་བ་ལས་བརྗོད་པར་བྱའོ།",
    "འཁོར་ལོ་བ་ཅུགཉིས་ནི་འཆད་པར་འགྱུར་བ་ལས་བརྗོད་པར་བྱའོ།",
    "ད་ནི་གསང་བ་ཞེས་པལ་སོགས་པས་བརྟེན་དང་བརྟེན་པའི་ཚོགས་པ་གསུངས་ཏེ།",
    "མགྲིནཔརམེའི་པདྨ་ལ་རིན་ཆེན་གྱི་རིགས་སུ་འགྱུར་རོ།་",
    "བསམ་པརབ་ཏུ་འཇུག་པ་དང་ཁམས་ཀྱི་ཁ་དོག་གསུངསཏེ།",
    "རུས་པ་དང་ཤལ་སོགས་པའིཁམསརྣམས་ཤེས་རབ་ཐབས་ཀྱི་འཁྱུད་པ་གསུངས་པ།",
    "སྟོང་པ་ཞེས་པ་རྡུལ་གྱི་ཁམས་དང་ཁུ་བ་ཞེས་པ་རྣམ་པར་ཤེས་པའི་ཁམས་ནི་ཤེས་རབ་དང་ཐབསཏེ།",
    "ད་ནི་རྩ་རྣམས་ཞེས་པལ་སོགས་པ་ཟླ་བ་དང་ཉི་མ་ཁུ་བ་དང་རྡུལ་གྱི་བྱ་བ་གསུངས་ཏེ།",
    "དེནས་ཟླ་བ་དང་ཁུ་བའི་རྩའི་ཁམས་ཀྱི་གྲངས་ཡོངས་སུཆད་པར་གྱུར་བན་ལོ་བཅུགཉིས་ཀྱི་བར་དུ་རྡུལ་གྱི་ཁམསའཕེལ་བར་བྱེད་དོ།",
    "དེ་ཙམ་ལྔ་རུ་བརྗོད་པརྣམས་སོ།",
    "རྩ་རྣམས་ཆུ་བཞེས་པནི་འདིརཕྱི་རོལ་ཏུ་འཇིག་རྟེན་གྱི་ཁམས་ལ་རྒྱ་མཚོར་འགྲོ་བའི་ཆུ་བོ་སྟོང་ཕྲག་འདུནཅ་རྩ་གཉིས་ཏེ།",
    "སྤྲུལ་སོགས་པའི་ཁམས་ཀྱི་རྣམ་པར་འགྱུར་བས་གཅིག་དང་།",
    "འདིདགལས་སླར་ཡང་སྤྲུལ་སོགས་པའི་ཁམས་ཀྱི་རྣམ་པར་འགྱུར་བས་གནས་པགང་ཡིན་པ་དེ་ཡང་རྣམཔགཉིས་ཏེ།",
    "དེདག་ལ་མཁའ་ལ་སྤྱོད་པ་མགོ་ལས་སྐྱེས་པརྣམས་སོ།",
    "དནིག་ཟ་ཞེས་བ་ལ་སོགས་པས་གཟའི་ཆུ་ཚོད་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་པནི་འཆད་པར་འགྱུར་བ་ལསརྒྱས་པར་བརྗོད་པརབྱའོ།",
    "དེ་བཞན་དུསྐོས་པ་ཐམས་ཅད་ཀྱིས་དུས་སྦྱོར་གང་དུ་སྐྱེས་པར་གྱུར་པའི་ཁྱིམདེ་ནིཀརཀ་ཊའི་མིང་ཅན་དུ་རིག་པར་བྱ་སྟེ།",
    "དེ་བཞིན་རུ་ནང་ངུ་དབུགས་བརྒྱ་ཕྲག་བཅོ་བརྒྱད་ཀྱི་དཀྱིལ་འཁོད་ལྔ་ལོངས་སྤྱོད་ཅད་དབུགས་སུམ་བརྒྱ་དྲུག་ཅུས་དཀྱིལ་འཁོར་གཅིག་ལོངས་སྤྱོད་པརའགྱུར་བཞི་ངེས་པའོ།",
