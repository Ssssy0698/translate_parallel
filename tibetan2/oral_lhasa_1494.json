    "འོག་མ་དགུ་དང་ཡོན་ཏན་རྣམས་ཀྱི་ཆ་ཐོབ་པར།",
    "སླར་ཡང་མ་དག་པ་ལས་ཀྱང་མ་དག་པའི་ཟླ་བའི་ངེས་པ་བྱིས་བ་རྣམས་ཀྱིས་རབ་ཏུ་རྟོགས་པར་བྱ་བའི་དོན་དུ་བ་ཀོད་པ་གཟའལ་གཟའ་ནི་རབ་སྦྱིན་གཟའི་གནས་སུ་གཟའ་གཅིག་སྦྱིན་པར་བྱའོ།",
    "མི་བདག་བདགཅས་པནི་དྲུག་ཅུ་སྟེམི་བདུག་ཉིས་འགྱུར་ཆུ་ཚོད་ནི་ཆུ་ཚོདསུམ་ཅུ་རྩ་གཉིས་ཆུ་ཚོད་ཀྱི་གནས་སུ་སྦྱིན་པར་བྱའོ།",
    "འོག་ཏུ་ཚོགས་དག་ལ་ཡང་གཉིས་ཞེས་པ་ནི་ཆུ་ཚོད་ཀྱི་འོགཚོགས་ཀྱི་གནས་སུ་གཉིས་སྦྱིན་པར་བྱ་བར་འགྱུར་སྐར་མའི་གནས་སུ་སྐར་མར་གཉིས་དང་།",
    "ཆུ་ཚོད་དྲག་པོ་སྐར་མའི་ཆུ་ཚོད་ཀྱི་གནས་སུ་དྲག་བོ་ཞེས་པཆུ་ཚོད་བཅུ་གཅིག་སྦྱིན་པར་བྱ་བའི་ཕྱིར་དོན་དུ་རབ་ཏུ་གསལ་ཏེ།",
    "དེའི་ཕྱིར་ཟླ་བའི་ངེས་པར་འགྱུར་ཏེ།",
    "སླར་ཡང་ཟླ་བ་ཟླ་བ་དག་ལ་རབ་ཏུ་སྦྱིན་པར་གསུངས།",
    "དནི་ཟླ་བའི་ངེས་པ་ལས་ཚེས་ལ་སོགས་པའི་རྩིས་གསུངས་པ།",
    "ཚེས་རྣམས་སྦྱིན་དང་དོར་དང་སླར་ཡང་སྦྱིན་པ་དག་ནི་གཟའ་དངཆུ་ཚོདརྐ་དཔརྣམསསུསྟེ་ཞེས་པསྟེ།",
    "ཚོགས་ཀྱི་གནས་སུ་སླར་ཡང་སྦྱིན་ཏེ་ཟླ་བའི་རྐང་པརྣམས་ཀྱི་ནོར་དང་བུ་ལོན་ཡོངས་སུ་དག་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཚེསསུམ་ཅུ་དང་བཅས་པའི་ཚོགས་ཉི་ཤུ་རྩ་བདུན་ནིཝ་བཅུ་ལས་ལྷག་པར་མི་འགྱུར་རོ།",
    "དེ་ལས་ཆ་བཅུ་བཞིས་རྣམ་པར་ཕྱེབ་ནི་བཞིར་འགྱུར་རོ།",
    "མཉམ་པ་དང་མི་མཉམ་བའི་ཆ་དེབ་རྐང་བའི་དོན་སྦྱིན་པའམ་དོར་པར་རིག་པར་བྱའོ།",
    "སྟོང་ལ་སྟོང་པ་རྣམད་ག་ཅེས་པཞི་བཅུ་བཞིའི་ཆའི་ལྷག་མ་གལ་ཏེ་སྤྱོད་པར་གྱུར་ན་དེའི་ཚེ།",
    "དེ་ལ་ཉི་མའི་རབ་ཏུ་དབས་གསལ་བྱས་ཉི་མའི་ཆང་བདག་ཞི་སྦྱིན་དང་དོར་བར་འགྱུར།",
    "དེ་ལྟར་ག་ནས་བཅུ་བཞི་བོ་རྣམས་སུ་ཟླ་བའི་རྐང་པརྣམས་དགོད་པར་འགྱུར་རོ།",
    "འདིར་ཡེར་ཆ་བཅུ་བཞིའི་ལྷག་མ་མཐོང་བར་གྱུར་པ་ན་མཉམ་པར་ཐོབ་པ་ལརྒྱུ་བ་ལྔ་ལསོགས་པརྣམས་སྦྱིན་ནོ།",
    "མི་མཉམ་པརཐོབ་པ་ལ་དོར་རོ་ཞེས་པ་སྟེ།",
    "ཚོགས་ལས་བཅུབཞིའི་ཆ་ཡི་ལྷག་མ་རྒྱུ་བའི་རྐང་པ་གང་ཡིན་པ་དེའི་སྔོན་མ་ནི་རྒྱུ་ཞིང་ཡོད་པའི་རྐར་པ་སྟེ་ཚོགས་ཀྱི་ཆ་ཤསརྣམས་ཡོདཔའི་རྐང་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ལ་ཉི་མའི་རབ་ཏུ་དབྱེ་བས་སྔར་བཞིན་དུ་ཉི་མའྀ་རྐར་པརྣམསསྤྱན་པ་འམ་དོར་བར་འགྱུར་རོ་ཞེས་པ་ནི་གྲུབ་པའི་མཐའོ།",
    "འདིར་ཉི་མའི་རྐང་པ་རྣམ་པར་དག་པར་བྱ་བའི་དོན་དུ་གང་གས་ཉི་མའི་ལོངས་སྤྱོད་ཉིན་ཞག་སོལ་རྒྱ་བའི་ཆུ་ཚད་དང་ཆ་སུང་ལ་སོགས་པ་རྣམས་ཤེས་པར་བྱེད་པ་ཉི་མའི་སྐྱེ་བའི་ཁྱིམ་སྦྱང་བར་བྱའོ།",
    "ཉི་མའརྐང་པ་དག་པར་བྱ་བའི་ཕྱིར་ལུག་ལ་སོགས་པའི་ཁྱིམ་གསུམ་ཡོངསསུ་སྦྱང་བར་འགྱུར་ཞིང་ཀར་ཀ་ཊ་སྐྱེས་པའི་ཁྱི་མ་དུའགྱུར་རོ།",
    "དལ་བའིལམ་འདིལ་ཀར་ཀ་ཊ་ལ་སོགས་པའི་ཁྱིམ་དྲུག་པོ་རྣམས་སུ་དྲུག་པོ་འདི་དག་རྐང་པར་འགྱུར་རོ།",
    "གཞན་ནི་མིག་དམར་ལ་བརྗོད་པར་བྱའོ།",
    "འདིར་བྱེད་པ་ལ་བརྗོད་པའི་ཆོག་གསུངས་པ།",
    "ད་ནི་ཟླ་བའི་ལོངས་སྦྱོད་གསུངས་པ།",
    "དེ་བཞིན་དུ་རྐང་པ་དགུ་དགུ་ནི་ལུག་ལ་སོགས་པར་ཁྱིམ་བཅུ་གཉིས་པོར་རིག་པར་བྱའོ།",
    "གཟའི་གནས་དད་ཆུ་ཚོད་ཀྱི་གནས་སུ་གཟའ་དང་ཆུ་ཚོད་རིམ་པར་ཡོངསབཀོད་བཅུ་གཉིས་འདི་དག་སྟེ།",
    "ཟླ་བཞེས་པ་གཟའ་ལ་གཅིག་གོ།",
    "ཟླ་བཞེས་པ་གཟའ་ལ་གཅིག་གོ།",
    "སྟོང་པ་ཞེས་པ་གཟའི་གནས་སུ་ཅི་ཡང་སྦྱིན་པར་མ་བྱ་བའོ།",
    "ཉིན་ཞགཔ་ལ་ཉི་མའི་ལོངས་སྦྱོད་པརམའི་གནས་སུ་ཉི་ཤུ་དང་ཆུ་ཚོད་ཀྱི་གནས་སུ་བཅོ་ལྔ་ཞེས་བའི་རྩབའི་ངེས་པའོ།",
