    "ཤར་བ་ནས་ནུབ་བཞེས་པའི་མིང་ཅན་ནོ།",
    "ཡི་དགས་དང་དུད་འགྲོདང་མི་རྣམས་སྐྱེད་པ་ལ་རབ་ཏུགསལ་བར་བྱས་སོ།",
    "ཀླུ་ལསོགས་པ་རྣམས་ཀྱི་ཞབས་ཀྱི་པདྨལ་ཕྱག་བྱས་པ་དུས་ཀྱི་འཁོར་ལོའོཞེས་པ་ནི་བག་ཆགས་སྤངས་པའི་ངེས་བའོ།",
    "ཁུ་བ་དང་རྡུལ་ཡང་དག་པར་སྦྱོར་བས་ཕུང་པོ་ཥ་དངཁམས་དང་སྐྱེ་མཆེད་ལ་སོགས་པ་རྣམས་སོ་སྟེ་སྐྱེད་པ་དང་སྡུད་པའི་རིམ་པས་སོ།",
    "ཟླ་བ་བཅུ་གཉིས་པ་ལ་རྣམ་པར་བཅད་པས་བྱིནགྱིས་པརླབས་པ་རྣམས་སུ་འགྱུར་རོ།",
    "ལོ་བརྒྱའི་ཕྱོགས་ཀྱི་ཕུང་པོ་བརྒྱ་ཕྲག་ཉི་ཤ་རྩ་བཞིའི་གྲང་མལས་དམན་པར་གྱུར་པའོ།",
    "དེ་ནསསའི་ཁམས་རྣམ་པར་འཆད་པར་འགྱུར་རོ།",
    "མགྲིན་པར་མེའི་ཁམས་ཡོན་ཏནགསུམ་གྱི་རང་བཞིན་འདོར་ཏེ།",
    "དེ་ནས་སད་པའགནས་སྐབས་ཟད་པར་འགྱུར་རོ།",
    "དེ་ནས་རྨི་ལམ་གྱི་གནས་སྐབས་ཆད་པར་འགྱུར་རོ།",
    "དེ་ནས་ཤིན་ཏུ་གཉིད་ལོག་པའི་གནས་སྐབས་ཆད་པར་འགྱུར་རོ།",
    "དེ་ནས་ལུས་དང་ངག་དང་སེམས་ནི་རྣམ་པར་ཆདཔར་འགྱུར་རོ།",
    "ཡན་ལག་ཐམས་ཅད་ལ་ཁུབ་འོག་ཏུ་འདོར་ཞིང་རྔུལ་སྟེང་ངུ་འདོར་ཏེ་བཞི་པའི་གནས་སྐབས་རྣམ་པར་ཆད་པར་འགྱུར་རོ།",
    "ད་ནི་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་ཀྱི་རྒྱུར་ལུས་སྲུང་བའིམན་ངག་གསུངས་པ།",
    "རྒྱམ་ཐུན་ལ་སོགས་པ་འགྱུར་བ་མེད་པར་བྱེད་དོ།",
    "དེ་ནས་གང་ཞིག་ཅུང་ཟད་འདོད་པ་དག་ཅེས་པ་ནི་རྒྱམཐུན་པ་དེ་ལ་རྣམ་པར་སྨིན་པ་དང་སྐྱེས།་",
    "འཆད་པར་འགྱུར་བའི་རིམ་པས་སོ།",
    "ད་ནི་མཆན་ཁུང་ཞེས་པ་ལ་སོགས་པས་འཆི་ལྟས་སླ་བའི་སྨདདུ་རྩ་བའི་འཆིང་བའི་བཅིང་བགསུངས་ཏེ།",
    "འབྲས་དང་སྐྲང་འབུར་ལ་སོགསཔ་བྱུང་བའི་དུས་སུ་མར་དང་བཅས་པའི་ཚྭ་དང་གོས་ཀྱིས་བཅིངས་པ་ཡི་བདུགས་ན་འཕེལ་བ་འཛོམས་པར་བྱེད་པ་ཉིད་དོ།",
    "དནི་སྲོག་རྩོལ་གྱི་ངེས་པ་གསུངས་ཏེ།",
    "འ་དིར་ཇི་ལྟར་ཕྱི་རོལ་དེ་བཞིན་ལུས་ཞེས་གསུངས་པའི་ཕྱིར།",
    "ཕྱི་རོལ་ཏུབ་ཤར་བའི་སྒྲས་རྣམ་པར་སྣང་མཛད་སྟོབས་ལྡན་སྟོབས་ཀྱི་ཞག་སྟེ་མུ་ཟིར་བརྗོད་དོ།",
    "འདི་རྣམས་གཅིག་ཏུ་བྱས་ནས་གཅིན་གྱིས་ལན་བདུན་གྱི་བར་དུ་བསྐོ་བར་བྱ་སྟེ།",
    "མཚན་ཉིད་འདི་ཤེསནས་ཏིང་ངེ་འཛིན་ལ་དམིགས་པར་བྱའོ།",
    "ཞེས་པཞི་སྲོག་སྩོལ་གྱི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་རྡོ་རྗེ་བདྨའི་གདན་ལ་བཞུགས་པ་ཞལ་གཅིག་པ་ཕྱག་གཉིས་བ་སྟེ་པདྨ་དང་མཆོག་སྦྱིན་གྱི་ཕྱག་གོ།",
    "འདི་ནི་བཅོམ་ལྡན་འདསམ་སྣ་ཚོགས་ཡུམ་གྱི་སྣེ་ཉེ་བར་འཚེ་བཐམས་ཅད་ལས་བདག་དང་གཞན་སྲུང་བ་ལ་དྲན་པར་བྱའོ།",
    "དནི་རྣོན་པོ་ཞེས་པ་ལ་སོགས་པས་མེ་ཏོག་བྱ་བ་གསུངས་སོ།",
    "དང་པོ་ཀོང་བུ་ཁ་བསྡམས་པར་བསྲེག་སྟེ།",
    "དེ་ནས་ཀོར་བུ་ཁ་ཕྱེ་བར་ཉི་མའི་ཕྱུག་མར་གྱུར་གྱི་བར་དུ་བསྲེག་པར་བྱའོ།",
    "སླར་ཡང་ལན་ཚྭ་སྟེ་ཊཾ་ག་ནའིལནཱཚྭས་དག་པར་འགྱུར་རོ།",
    "ཞེས་པ་ནིགབུར་དང་གླ་རྩི་དང་ཛཱ་དྷི་ཕ་ལ་དང་བཅས་པ་འཆད་པར་འགྱུར་བའི་ཆང་ཐམས་ཅད་ཀྱིས་དབུག་བར་བྱའོ།",
    "ད་ནི་ལེ་ཚེ་སྦྱར་བ་ལ་བཀོད་པའི་རྫས་རྣམས་ཀྱི་ཆ་གསུངས་པ།",
    "དགུ་པ་ལ་ལག་བཞེས་པ་གཉིས་སོ།",
    "དེ་རྣམས་ཀྱི་གནས་སུ་རིམ་བ་བཞིནགཞན་ལྔ་སྦྱིན་པར་བྱའོ།",
    "གང་ངུ་ཀ་ར་ཡིནབ་དེ་རཀ་ར་དང་ལྷན་ཅིག་སྦྲང་རྩི་སྦྱིན་པར་བྱའོ།",
    "དནི་ལུས་ཀྱི་ལེ་ཚེ་སྦྱོར་བ་གསུངས་པ་ལྟེ་བ་དང་པོ་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "ལུས་དང་ཧ་ཏ་བཏུང་བ་བསྒོ་བ་ལ་སྦྱིན་པར་བྱབར་འགྱུར་ཏེ།",
    "དནི་དྲི་སྡུག་པས་སྨིན་པ་གསུངས་པ་དང་པོར་བརྒྱད་ཆ་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཨ་རུ་རའི་ཕྱོག་ཁུ་རམ་གྱིས་སྦྱར་བའི་བདུག་པར་འགྱུར་ཏེ།",
    "དེ་འད་བ་མའི་བརྒྱད་ཆས་དང་པོར་ཉིན་ཞགག་ཅིག་བདུག་པར་བྱའོ།",
    "བསྐའ་བའི་ཉིས་འགྱུར་སྦྱིན་པར་བྱ་སྟེ།",
    "ཕྱི་ནས་རྫས་ཀྱི་ཚད་ཀྱི་བུ་རམ་དག་ཀྱང་བཏུག་པ་དར་ལྷན་ཅིག་སོས་ཀངེས་པར་བསྲེག་པར་བྱའོ།",
    "དབྱར་རྫས་ཀྱི་ཉིས་འགྱུར་དང་དགུན་སུམ་འགྱུར་སྦྱིན་པར་བྱའོ།",
    "ཉིན་ཞག་སོ་སོར་རྫས་ཀྱི་བརྒྱད་ཆའི་སྦོས་ངེས་པར་བསྲེག་པརབྱའོ།",
    "ཡང་བཞེས་པ་ནི་ཨ་ཀ་རུའོ།",
    "དེ་བཞི་ནནོ་ཞེས་བནི་གོང་བུའི་བདུག་པ་དང་མཚུངས་པར་སྦྱར་རྩི་དང་ཤ་ཀར་དང་བཅམ་པ་ངེས་པར་བསྲེག་པར་བྱའོ།",
    "དེ་ནས་བླངས་ཏེ་ནཱ་རི་ཀེ་ལ་ལ་སོགས་པར་བླུགས་ནས་སོ་བའི་ཕུང་བོའི་དབུས་སུ་ཟླ་བ་གཅིག་སྨིན་བར་འགྱུར་རོ།",
    "ཞེས་པནི་མེ་ཡིས་སྨིན་པའིམཇུག་ཏུ་ལྟེ་བ་ཞེས་པ་གླ་རྩི་དངམ་གསུངས་ཀྱང་ག་པུར་དང་འབྲས་བུ་གསུམ་སྟེ།",
    "དེ་ལས་ལྷག་མནི་དྲི་ཉམས་པར་འགྱུར་རོ།",
    "འདབ་མ་སྦྱར་བའི་སྨིན་པ་ལ་ཡང་ཀེ་ཏ་ཀིའི་འདབ་མ་རྣམས་ཀྱི་སོ་སྣོད་བྱསནས་ནང་དུ་དྲིའི་རྫས་བཞུག་པར་བྱ་སྟེ།",
    "ཟངས་ཀྱི་སྣོད་དྲིའི་ཆུས་བྱེད་ཡོངས་སུ་བགང་བ་ལ་བརྐྱལ་པར་བྱེད་ཅིང་བསྐོལ་བ་ཉམས་སུ་མྱོང་བ་སྟེ།",
    "བརྗོད་པའི་རྫས་འདི་རྣམས་ཕྱེ་མར་བྱས་ན་ས་སྣོད་ཀྱི་ཁར་གོས་ཀྱི་སྟེང་དུ་ཕྱེམ་སྦྱིན་ནོ།",
    "ཇི་སྲིད་ཕྱེ་མ་རློན་པར་གྱུར་གྱི་བར་དུའོ།",
    "ལྕགམ་ནི་དྲི་དོན་དུ་གཉེར་བརྣམས་ཀྱི་དྲིའི་བསྟན་བཅོས་ལས་ཤེས་པར་བྱའོ།",
    "ད་ནི་དྲི་ལ་སོགས་པ་རྣམས་ཀྱི་གསང་བ་གསུངས་པ།",
    "འདིར་སྤོས་ཀྱིས་སྨིན་པ་ལ་སྐྱུར་བར་གྱུར་པའི་དྲི་རྣམས་ལསྤོས་སྦྱིན་པར་བྱ་སྟེ།",
    "སྤོས་ཀྱི་སྦྱོར་བ་བྱས་ནས་སོ།",
    "དེ་ནས་གོངབུ་ལ་སོགས་པ་སྦྱིན་པར་བྱའོ།",
    "དེ་མེད་ན་ཇི་སྲིད་ཆིག་པའི་སྐྱོན་ཉེ་བར་ཞི་བར་གྱུར་གྱི་བར་དུ་ཆུའི་འགྲམ་ངུ་གཞག་པར་བྱའོ།",
    "བུ་ཡྰ་ཀེ་ཤའི་མཇུག་ཏུ་གསིལ་བལ་སོགས་པའི་ལྟོས་སྦྱིན་པར་བྱའོ།",
    "ཇི་སྲིད་མེ་ཏོག་བསྒོ་བའི་སྐྱོན་ཉེ་བར་ཞི་བར་གྱུར་པར་རོ།",
    "དེ་རྣམས་ལ་དྲིའི་སྦྱོར་བ་ལ་གླང་པོཆེའི་རྩ་བ་དང་རྟའི་རྨིག་བ་སྦྱིན་པར་བྱའོ།",
    "དེ་ཉིད་གཞན་པའི་རྫས་ཀྱིས་ད་མན་ཞིང་མངར་བདག་དང་ཞེས་པ་ནི་ཆང་སྟེ་དེ་དང་རྣམ་པར་བྲལ་བའོ།",
    "ཇི་སྲིད་དྲིའི་ཆུར་གྱུར་པར་རོ།",
    "དེ་ཡིས་དྲི་གཞན་ཡང་བརྟག་པར་བྱའོ།",
    "ཁམ་བུའི་ཐོག་མ་ཐ་མར་སྦྲང་རྩི་དག་དང་དཀར་པོ་ངེས་པར་བསྲིག་སྟེ་དང་པོ་སྤོས་ལས་སོ་ཞེས་པའི་ངེས་པ་ལས་དང་བོར་སྦྲང་རྩི་དང་ཤ་ཀ་རའོ།",
    "སླར་ཡང་ཁམ་བུའི་མཇུག་ཏུ་སྦྲང་རྩི་དང་ཀ་ར་ངེས་པར་བསྲེག་པར་བྱའོ་ཉིན་ཞག་གཉིས་པ་ལ་མེ་ཏོག་སྒོ་བར་བྱའོ།",
    "སྣོད་དེར་བཅུག་ལ་སྟེང་ནས་བྱེ་མ་སྦྱིན་པར་བྱ་སྟེ།"
  ]
}