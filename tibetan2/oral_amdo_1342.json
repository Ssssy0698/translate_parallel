    "དེ་གཉིས་ཀྱང་རིག་པ་བློས་འཇལ་བའི་འཁྲུལ་མ་འཁྲུལ་ལ་ལྟོས་ནས་རེ་རེར་མངོན་སུམ་ལྟར་སྣང་དང་མངོན་སུམ་ཡང་དག་རྗེས་དཔག་ལྟར་སྣང་དང་རྗེས་དཔག་ཡང་དག་བཅས་བཞི་རུ་དབྱེ་བ་དང་།",
    "དེ་ནི་སྤྱིར་བཏང་གི་རྩེད་རིགས་ཁོ་ན་ཙམ་གཏན་ནས་མ་ཡིན་པར།",
    "སོང་ཡོད་དེ།",
    "རང་གི་མཚན་གཞིའམ་གབ་བྱའི་སྟེང་དུ་གྲུབ་པ།",
    "རང་གི་མཚན་ཉིད་དམ་གབ་བྱེད་གང་ཡིན་པ་དེ་ལས་གཞན་པ་ཞིག་གི་མཚོན་བྱའམ་གབ་བྱ་མི་བྱེད་པ་སོགས་ནི་གོང་དང་རིགས་འདྲ་ཞིང་།",
    "མ་ཁྱབ་ཅེས་མཚན་ཉིད་དེ་རང་གི་མཚོན་བྱའི་ཆ་ཤས་ཐམས་ཅད་ལ་མ་ཁྱབ་པ་དང་།",
    "མི་སྲིད་ཅེས་རང་གི་མཚོན་བྱའི་དོན་དུ་མི་སྲིད་པའམ་རང་གི་མཚོན་བྱའི་དོན་ལྡོག་མ་ཡིན་པའི་སྐྱོན་གསུམ་དང་བྲལ་ཞིང་།",
    "བོད་ལྗོངས་ཡིག་རྙིང་དཔེ་སྐྲུན་ཁང་གིས་༡༩༩༢ལོར་པར།",
    "གི་གབ་བྱ་སྦྲང་མ་དེ་མཚོན་བྱར་བཟུང་ནས་དཔྱད་ན།",
    "གོང་གི་བརྗོད་དོན་འདིའི་ཐད་ནས་གཞིགས་ན་སྤྱིར་མཚན་མཚོན་གྱི་རྣམ་བཞག་དེ་ནི་འགྲོ་བ་མིའི་ཤེས་རབ་རིག་པས་སྒྲ་སྤྱི་དང་དོན་སྤྱི་རྟོགས་པའི་རྟོག་པ་ཤས་ཆེ་བས་རྗེས་དཔག་ཏུ་འགྲོ་ཡང་།",
    "དེ་མིན་གབ་ཚིག་གི་རིག་པ་འདིའི་ཐོག་ནས་ནུབ་ཕྱོགས་གཏན་ཚིགས་རིག་པའི་རིགས་འདེད་ཀྱི་བསམ་གཞིག་ལས་དོན་སྤྱི་དང་ཡང་ཅུང་མཐུན་ཏེ།",
    "དེར་བརྗོད་པའི་དོན་སྤྱི་ནི་བྱ་དངོས་ཤིག་གི་ངོ་བོའི་རང་བཞིན་ནམ་ཁྱད་པར་གྱི་རང་བཞིན་མཚོན་པའི་བསམ་གཞིག་གི་རྣམ་པ་ཞིག་ལ་བརྗོད་པ་བཞིན།",
    "ང་ཚོས་བོད་རང་ཉིད་ལ་དུས་སྐབས་དེ་ཙམ་དུ་མངོན་སུམ་ལ་འཁྲུལ་མ་འཁྲུལ་དཔྱོད་བྱེད་ཀྱི་ཐབས་ཤེས་རྨད་དུ་བྱུང་བ་ཞིག་ཡོད་པ་དཔགས་ཐུབ་ལ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་༢༤ལོར་པར།",
    "གཏམ་དཔེ་ལ་གཏམ་རྙིང་ཞེས་གནའ་མིའི་གཏམ་དཔེ་དང་དོན་གཅིག་ཏུ་སོང་བ་དེ་ལས་ཤིན་ཏུ་སྔ་མོ་ཞིག་ནས་བཟུང་བྱུང་ཡོད་པ་དཔགས་ཐུབ་བོ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་༡༩༩༧ལོར་པར།",
    "དཔེ་ནི་ཚད་དབྱིབས་སོགས་མཚོན་བྱེད་ཀྱི་རི་མོ་དང་གཟུགས་དབྱིབས་སོགས་ཀྱི་མིང་ཞེས་དང་།",
    "གཏམ་དཔེ་ནི་དཔེ་ལ་སྦྱར་ནས་དོན་སྟོན་པའི་ཚིག་སྦྱོར་གྱི་རྣམ་པ་ཞིག་གི་མིང་ཞེས་བཀོད་མོད།",
    "ཨ་ཁུས་བཏང་བཏང་མང་ལ།",
    "ཞེས་འཛམ་གླིང་གེ་སར་གྱི་སྒྲུང་ལས་ལྡོག་ཕྱོགས་སུ་ལངས་པའི་མི་སྣ་གཙོ་ཁྲོ་ཐུང་གི་གཏམ་རྒྱུད་དངོས་སུ་བཀོད་པ་དང་།",
    "འོན་ཀྱང་གཏམ་དེ་དག་དུས་ཀྱི་ཆ་ནས་ཅུང་འཕྱིས་པར་སྣང་མོད།",
    "བོད་བཙན་པོའི་རྒྱལ་སྲིད་ཉག་ཕྲན་གཅིག་གིས་རྨེག་མེད་དུ་བཏང་ཡང་།",
    "དུས་ཡུན་ཤིན་ཏུ་རིང་བོར་བོད་མང་ཚོགས་ཀྱི་སེམས་སུ་བགོས་པའི་དཔེ་ལམ་སྲོལ་གསུམ་གྱི་བག་ཆགས་དེ་ནམ་མཁའི་སྐར་མདའ་ལྟ་བུའི་དུས་ཡུན་ཐུང་ཐུང་ཞིག་གི་ནང་ནས་ཉམས་མི་འགྲོ་བར།",
    "གོང་གི་གཏམ་དཔེ་དེ་དག་གཏམ་མཛོད་མེས་པའི་ཞལ་རྒྱུན་ལས་བཤུས།",
    "སྤྱིར་ཀུན་སྤྱོད་ཀྱི་ཚད་གཞི་འདིའོ་ཞེས་ཚིག་གཅིག་གིས་བརྒྱ་ཁ་གཅིག་ཆོད་ཐུབ་པ་ཞིག་གཏན་ནས་མ་ཡིན་པར།",
    "འོན་ཀྱང་རྨོངས་དད་ཀྱིས་དེའི་ནང་གི་གཙོ་བོ་ཞིག་བཟུང་ཡོད་མོད།",
    "ཧོང་ཀྲིན་གིས་གཙོ་བསྒྲིགས་བྱས།",
    "ཞེས་སྤྱིར་མི་རང་ཉིད་ལ་མཁོ་དགོས་ཤིག་ཡིན་ཕྱིར་བརླག་འོས་པ་གཅིག་ཀྱང་མེད་མོད།",
    "ཀུན་སྤྱོད་ཀྱི་ཚད་ཐིག་འདི་འདྲ་ཞིག་གི་རྨང་གཞིའི་ཐོག་ཚུགས་པའི་གནའ་བོའི་གཏམ་གྱི་སྐོར་ཕྱོགས་འདྲེན་རགས་ཙམ་བྱས་ན།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་༡༩༩༧ལོར་པར།",
    "དེ་བཞིན་སྲོལ་ལུགས་དེ་བོད་མི་རིགས་ཀྱི་ཀུན་སྤྱོད་འཇལ་བའི་ཚད་གཞི་གཙོ་བོ་ཞིག་ཏུ་སོང་ཕྱིར།",
    "མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་༡༩༩༩ལོར་པར།",
    "ཐག་རང་གིས་ཆོད།",
    "གཆིགི་ནོར་གྱིས་ཕྱུགས།",
    "འུ་ཅག་སྒང་བ་བོད་པའི་སའི་རྒྱ་ཁྱོན་ཧ་ཅང་ཆེ་ཞིང་རོང་འབྲོག་གི་འཚོ་གནས་ཀྱང་ཤིན་ཏུ་ཆེ་བས།",
    "བློ་མཐུན་མའོ་ཙེ་ཏུང་གིས་མི་མང་ན་ནུས་ཤུགས་ཆེ་གསུངས་པ་ལྟར།",
    "མི་ནི་ཐོན་སྐྱེད་ནུས་ཤུགས་ཨང་དང་བོར་སོང་བའི་དངོས་དོན་དེར།",
    "སྐྱིད་པོ་རང་གིས་མ་བྱས་ན།",
    "སྡུག་དུས་འགྱོད་པ་རང་གིས་འཁུར།",
    "ལྟ་བུ་སོགས་འཁྱོག་བརྗོད་དང་དཔེ་འདྲེན་གང་གིས་ཀྱང་མ་སྤྲོས་པར།",
    "ཚུལ་གསུམ་ཚང་བའི་རྟགས་སྦྱོར་ཡང་དག་ཅིག་ལ་བརྟེན་ནས་རང་གི་དཔག་བྱ་དཔོག་པ་ནི་རྗེས་དཔག་ཡིན་པའོ།",
    "སྤྱིར་རྗེས་དཔག་ཅེས་པ་ནི་བློ་རིག་པས་དངོས་སུ་མི་རྟོགས་པར་རྟགས་སྦྱོར་གང་རུང་ཞིག་གི་ཐབས་ལ་བརྟེན་ནས་རྟོགས་བྱ་ཤུགས་ནས་དཔོག་པ་ཞིག་ཏུ་བརྗོད་པ་ལས་མཐའ་གཅིག་ཏུ་ཡང་དག་ཡིན་མིན་གྱི་ངེས་པ་མ་མཆིས་པ་ནི་རྟོགས་སླ།",
    "དེ་ན་ནང་བསྟན་ཚད་གཞུང་མ་བསྒྱུར་གོང་དུ་བཙན་པོ་རིམ་བྱོན་གྱི་དུས་སུ་རང་རེའི་ཁ་བ་ཅན་འདིར་ཕུག་གི་བྱ་བ་ཕྲ་རགས་ཀུན་ལ་བརྟག་དཔྱད་དང་།",
    "འགྱུར་མེད་བདེན་དཔང་གི་མཚོན་རྟགས་འགོད་པའི་ཐབས་ཤེས་རྨད་དུ་བྱུང་བ་ཞིག་ཡོད་པ་དངོས་ཤུགས་ཇི་རིགས་ནས་མཐོང་ཐུབ་སྟེ།",
    "ཐམ་ཀའི་རི་མོ་འདི་གཉིས་སུ་གསལ་ལ།",
    "གནའ་བོའི་དུས་སུ་རང་རང་གི་བླ་སྲོག་གི་དོད་དུ་སྲོག་ཆགས་དང་རི་ཆུ་ནགས་གསུམ་སོགས་རང་བྱུང་ཁམས་ཆེན་པོ་བཀུར་བའི་སྲོལ་ཡོད་པ་ནི་གླིང་སྒྲུང་སོགས་ལས།",
    "པ་ནི་དམངས་ཁྲོད་ན་རྒྱུན་འབྱམས་སུ་ཆགས་པའི་ཁྲོམ་ར་དང་ཁྲོམ་ཚོགས་ཞེས་མི་མང་ཚོགས་པའི་འདུ་རར་བརྗོད་པའི་བརྡ་རྙིང་ཞིག་ཡིན་ཕྱིར།",
    "འདིར་ཡང་མི་མང་ཚོགས་པའི་དབུས་སུ་བོད་མིའི་ཚེ་སྲོག་གི་མཚོན་དོན་བླ་རྟགས་སུ་བཀོད་པ་མིན་ནམ་སྙམ།",
    "མཚན་ཉིད་རིག་པའི་ཡན་ལག་གི་གཏན་ཚིགས་རིག་པ་འདི་ལྟ་བུའི་ནང་དོན་མང་ཞིང་ཁྱབ་སྟངས་ཆེ་བའི་རིགས་པའི་གཞུང་ལུགས་ཤིག་མེད་པ་འདྲ།",
    "གཏན་ཚིགས་རིག་པ་འདི་ནི་བརྡ་སྤྲོད་རིག་པ་ཇི་བཞིན་དེ་དང་མ་འབྲེལ་བ་གཅིག་ཀྱང་མེད་པས་མཁས་ཆེན་ལ་ལས་དེ་ལ་བསམ་གཞིག་གི་བརྡ་སྤྲོད་ཅེས་ཀྱང་འབོད།",
    "གཉིས་སུ་གང་ཞིག་བྱེ་བྲག་གི་དོན་དངོས་ལ་མཚོན་ན།",
    "ཧྲང་ཝའོ་དཔེ་སྐྲུན་ཁང་གིས་༡༩༩༧ལོར་པར།",
    "བདག་ལའང་དེ་ལས་གཞན་པའི་གསང་བ་ལྐོག་གྱུར་མཁྱེན་པའི་ཤེས་རབ་ཅི་ཡང་མི་མངའ་མོད།",
    "བྱམས་པའི་དྲིན་གྱིས་ནི་ནང་གི་ཚིས་སྦྱརད།"
  ]
}