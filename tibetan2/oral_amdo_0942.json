    "རྣམ་རྒྱལ་ཞེས་པ་ཆུ་མོ་སྦྲུལ་གྱི་ལོ་གསར་དུ་ཤར་བ་ན།",
    "ལྷ་ཁང་ཆེན་མོར་མང་ཇ་བརྒྱད་ཙམ་བསྐོལ་ཞིང་།",
    "དེ་དག་གི་རེ་བའི་ཡོལ་གོ་ཡོངས་སུ་ཁེངས་པར་གྱུར་ཏོ།",
    "འཛམ་གླིང་བྱང་ཕྱོགས་ཀྱི་ཐུབ་པ་ཆེན་པོ་འཇམ་མགོན་ས་པཎྜི་ཏ་ལ་ལེགས་པར་བརྒྱུད་པའི་ཡོངས་སུ་རྫོགས་པ་དགེ་སློང་གི་སྡོམ་པ་ཡང་དག་པར་འབོགས་པའི་མཐུན་པའི་ཆ་རྐྱེན་བཟང་པོ་ཉེ་བར་སྦྱར་ཏེ།",
    "བོད་ཡུལ་གྱི་རྡོ་རྗེ་གདན་ཆེན་པོ་དཔལ་བསམ་ཡས་ལྷུན་གྱིས་གྲུབ་པའི་གཙུག་ལག་ཁང་གི་ཉེ་འདབས་སུ།",
    "བདག་ཅག་གི་སྟོན་པ་དང་རྣམ་དབྱེར་མ་མཆིས་པ།",
    "ཚིགས་གསུམ་རིམ་གྱིས་ནོས་ཏེ་བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོ་མངོན་དུ་མཛད།",
    "དད་མོས་སྤྲོ་བས་ཉིན་མཚན་དབྱེར་མེད་པར།",
    "དཔལ་ཀྱེ་རྡོ་རྗེའི་གཞིའི་ལྗགས་བསྙེན་ཁ་སྐོང་གི་སྦྱིན་སྲེག་དང་བཅས་པ་གནང་སྐབས་མཁའ་འགྲོས་བརྡ་ཐབས་དང་ཡི་གེ་སོགས་ཀྱིས་རྨི་ལམ་བཟུང་བའི་གྲོགས་ཡང་ཡང་བྱས་གསུང་།",
    "ཡང་ནུབ་ཅིག་བུད་མེད་ཅིག་གིས་ལབས་ཀྱང་།",
    "གནས་གསར་བརྒྱུད་དེ་མཁས་པའི་འདུན་ས་དཔལ་ཞྭ་ལུ་གསེར་ཁང་ཁྲ་མོར་ཕྱགས་ཕེབས།",
    "རྗེས་སོར་ཐར་རྩེ་རྡོ་རྗེ་འཆང་གི་བཀའ་ལས།",
    "ཆིབས་པ་དམར་པོ་གྭ་ཞུར་ཡོད་པ་ཞིག་བཅིབས་ནས་བྱོན་སོང་བས་དག་སྣང་དང་སེམས་འཕྲེང་པོ་བྱུང་གསུངས་པ་ལས་ཞལ་རྒྱས་པ་ནི་མ་བྱུང་འདུག་དེ་ནས་བོད་ཡུལ་གྱི་རྡོ་རྗེ་གདན་ཆེན་པོ་དཔལ་ལྡན་ས་སྐྱར་ཕེབས་ཏེ།",
    "སྒྲོ་མོ་ལུང་དུ་ཕེབས་གོང་ཞག་ཁ་ཤས་ནས།",
    "གཟིམས་ཁང་གི་ཕྱི་ནང་ཀུན་ལ་ཕྱགས་དར་མཛད།",
    "ཉི་མ་དགོང་ཁྱོག་ཙམ་ལ་ལུང་པའི་ཕུ་ནས་བཙུན་པ་བོང་ཁལ་དེད་པ་ཁ་ཤས་བྱུང་བས་མགྲོན་འོང་གསུངས་པ་དེ་ཡ་གི་ལགས་སམ་ཞུས་པས།",
    "སྤྱན་བར་སྣང་དུ་ཧྲིག་གེར་གཟིགས་ནས།",
    "གསུངས་པ་དང་མཉམ་དུ་ཡུག་ཅིག་ལྟ་བ་ལ་འབྱམས་སོང་བས།",
    "ཁོ་བོའི་བསམ་ཚོད་ལ་ནི་བསྲུང་བ་ཐུན་མོང་བའི་སྐུ་ཞལ་ནང་བསྟན་དུ་ཡོད་པ་དེ་གསུང་ངག་ཚོགས་སློབ་གཉིས་ཀའི་བདག་པོ་མཛད་པའི་བརྡ་དང་།",
    "འདུ་ཁང་གསེང་གཡབ་སྟེང་བཞུགས་ཁྲིར་གདན་འདྲེན་ཞུས་ཏེ་ཚོགས་གཟིགས་མཛད་སྐབས།",
    "ཞག་ཤས་བཞུགས་པར་གནས་གཟིགས་མཆོད་འབུལ་སོགས་མཛད་ཅིང་།",
    "བྲག་རྩ་རྡོ་རྗེ་འཆང་གི་གཟིམས་སྤྱིལ་དུ་གདན་འདྲེན།",
    "ཆ་ལུང་རྡོ་རྗེའི་བྲག་སོགས་ལ་གནས་གཟིགས་མཆོད་འབུལ་མཛད་པའི་ཕེབས་ལམ་དུ་བྲག་རྩ་ནང་པས་གདན་འདྲེན།",
    "ཞབས་ཏོག་རྒྱས་པ་དང་བཅས་བྲག་རྩ་རྡོ་རྗེ་འཆང་གི་ཡབ་དེ་ཉིད་ཀྱི་ཞབས་དྲུང་གནས་གསར་བ་ལ་ཕྲིན་ལས་འགྲོ་དོན་ཐོགས་པ་མེད་ཅིང་།",
    "སྐུ་ཚེས་ཐོགས་པ་ཡོད་པས་ཞབས་པད་བརྟན་ཆེད་ཚེ་སྒྲུབ་ཟབ་མོའི་རིམ་པ་ལ་ཐུགས་ནན་གནང་དགོས་ཞུ་ཞིང་།",
    "ཁོང་ཚོའི་གཞིས་སྟེང་ཤོད་ཚང་མར་ཕྱག་ནས་མཛད་དེ་རྨུ་གཤོངས་བླ་བྲང་དུ་བཞུགས་ཞག་གི་གསུང་བསྐང་།",
    "མི་ཁྱོད་ནི་ཀུན་གཞི་ཤིན་ཏུ་འཇམ།",
    "སྲུང་མ་འདི་ནི་ཁྱོད་ལ་ཤིན་ཏུ་ཁྲོས་པ་ཞིག་འདུག་ཕེབས་པ་ནས་མ་འགྱངས་པར་ཁོ་བར་རྐྱེན་ངན་བཏུད་མར་བྱུང་བ་དེ་སྒྲིབ་བྲལ་ཡེ་ཤེས་སྤྱན་གྱིས་གཟིགས་པར་སྣང་།",
    "དགེ་འཕེལ་བཅས་ལ་གནས་གཟིགས།",
    "སང་སྔ་བར་ཀོམ་འདྲེ་བརྒྱུད་དེ་སྒྲོ་མོ་ལུང་དུ་བཞུགས་ཞག་དང་།",
    "ཕྱིར་འཕེན་པའི་ཞབས་ཕྱི་བདེ་ཆེན་གླིང་བན་ཚང་བསྙེན་སོང་རགས་བསྡུས་ཀྱི་ཞུས་ནས་ཆོ་ག་ཕྱག་ལེན།",
    "ཡབ་རྗེ་རྡོ་རྗེ་འཆང་གི་བཀས་བསྐུལ་ཏེ།",
    "གཞི་ཐོག་མཁས་བཙུན་ཆེན་པོའི་ཐུགས་དམ་མགོན་ཁང་ཚོམ་བར་དུ་གསུང་བསྐང་མཛད་སྐབས་ཐུགས་སྣང་དུ་མགོན་ཁང་དེ་ལ་རྒྱ་མཐོངས་ཟང་ཐལ་ཕུག་སྟེ་མཐིལ་ཞལ་གྱི་དབུས་ལྕགས་སྒྱེད་ཟངས་ཆེན་བཅས་བཙུགས་ནང་ཤ་བཙོས་པའི་རླངས་པ་སྐྱ་བུན་བུན་འགྲོ་བ་ཞིག་བྱུང་གསུངས།",
    "གང་ལྟར་ཡུམ་དེ་ཉིད་ཀྱི་གསུང་དང་མཛད་པ་འདི་ལ་དཔག་ན་ཁོ་བོ་མཆེད་རྗེ་འདི་ཉིད་ལ་བཅོལ་དམ་མཛད་པ་འདྲ་མོ་བྱུང་།",
    "དེས་ཁོ་རང་གི་ཉེར་སྤྱད་གང་ཡོད་གཟིགས་ཕུལ།",
    "བཤར་སྦྱང་ཁྱུག་ཙམ་རེ་གནང་།",
    "ཛོ་ཀི་གར་སོང་ཆ་མེད་དུ་གྱུར་པ་དང་།",
    "རེ་ཞིག་གི་མཁན་འོས་ལ་རྗེ་འདི་ཉིད་དང་།",
    "ཐུབ་བསྟན་འདི་གྲྭ་ས་འགངས་ཆེ་བས་ངོས་ནས་གྲོང་མོ་ཆེར་ཕན་ཐོགས་པ་ཞིག་མི་འོང་གསུང་བར།",
    "ད་རུང་གྲྭ་ཚང་གྲོས་ཐོག་ནས་འོས་གཞན་དགོས་ཚུལ་འདྲ་མོ་བྱུང་ཡང་།",
    "ཡབ་རྗེ་རྡོ་རྗེ་འཆང་ཆེན་པོས་བརྟག་སྒྲིལ་མཛད་པས་བཟང་ཐོན་དུ་རྗེ་འདི་ཉིད་བྱུང་བའི་གསུང་ལན་ཕེབས་པ་དང་བསྟུན་རྗེ་དྲུང་སྐྱིད་པ་གྲོང་མོ་ཆེར་འཕྲལ་དུ་ལོག་སྟེ།",
    "ཕྱོགས་ཕུལ་རང་རྒྱལ་གཞན་ཕམ་གྱི་ཐུགས་བསྐྱེད་ཕྲ་མོ་ཙམ་ཡང་མི་མངའ་བར་མངོན་སུམ་ཚད་གྲུབ་དང་།",
    "ཚུར་མཐོང་དག་གི་སྣང་ངོར་འཁྲུག་ལོང་ཟི་བུན་སྣ་ཚོགས་དེ་དང་།",
    "སྔར་སྐུའི་རྣམ་པ་གྲུབ་ཆེན་བིརྺ་པ་ལྟ་བུ་འབེར་མོའི་ཚུལ་དུ་ཡོད་པ་ལས།",
    "སྐུ་ཤ་རྣམས་ཀྱང་ཉིན་ཁྱད་ཞག་ཁྱད་ལྟ་བུས་སྐམ་ཚུལ་བཞེས་ཏེ་ཟླ་བ་བཅུ་གཅིག་པའི་ཚེས་བཅུ་གཉིས་ཀྱི་ཐོ་རེངས་ལམ་དུས་རྒྱས་པ་གཅིག་མཐུད།",
    "རྨོར་ཆེན་རྡོ་རྗེ་འཆང་གཤེགས་སྐབས་དབུས་གཙང་བདེ་གཟར་གྱི་མཇུག་དང་གཞི་ནས་བླ་བྲང་དུ་ཕྱག་འབྱོར་ཆུང་བ་སོགས་ཀྱིས་དགོངས་རྫོགས་མཆོད་འབུལ་ཧ་ཅང་གི་རྒྱ་ཆེ་བ་ཞིག་མ་བྱུང་ཡང་།",
    "ཤེའུ་གྲོང་དུ་ཟླ་རེར་མཁའ་སྤྱོད་མའི་སྒྲུབ་མཆོད།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ཞེས་སོ། ། བཞི་པ་ལ་ཐུན་མོང་བ་སྤྱིར་བསྟན་པ་དང་།",
    "གྲོང་ཆེན་བང་ཕྱིན་ལ་ཐུགས་དགྱེས་ཏེ་ཁྱོད་གདན་སར་ཞེན་ཆེན་པོ་བྱུང་ཞེས་གསུང་བར་གྲགས།",
    "ཁམས་ནས་ཡར་མ་ཕེབས་བར་བླ་གཞིས་ཚང་མ་གྲྭ་ཚང་སྤྱི་ནས་བླངས་པའི་འོང་འབབས་རྣམས་ཀྱིས་གཙུག་ལག་ཁང་གི་ཞིག་གསོ་དང་།",
    "ཡར་ཀླུང་དུ་གསང་ཆེན་འདུས་པའི་ཚོགས་ཀྱིས་རྗེ་བཙུན་ཡིད་བཞིན་འཁོར་ལོའི་སྒོ་ནས་ཞབས་ཟུང་སྲིད་མཐར་བརྟན་པའི་ཐབས་མཆོག་སྙན་བརྒྱུད་ཟབ་མོའི་ཕྱག་ལེན་ཇི་ལྟ་བར་མཎྜལ་འབུལ་ནོད་རྒྱ་ཆེན་དང་།",
    "དེ་བཞིན་མཛད་པས་ཁྱེད་རང་འདིར་བཞུགས་ཤིག་ངས་ནག་གུ་མ་ཞིག་བླང་འོང་གི་ཟེར།",
    "དཀྱིལ་ཆོག་ནག་འགྲོས་བཀླགས་ཆོག་གི་ཡི་གེ་གཉིས་དཔྱད་གསུམ་རྣམ་པར་དག་པ་དང་།",
    "ཐུན་མོང་ཞེས་པ་ལྕགས་ཁྱི་ལོ་འོ་སྐོལ་གྱི་རྣམ་འདྲེན་ཤཱཀྱའི་རྒྱལ་པོ་དེས་ཤྲཱི་དྷ་ནྱ་ཀ་ཊ་ཀར།",
    "སྦྱིན་སྲེག་མཆོད་གར་དང་བཅས་སྒྲུབ་མཆོད་བདག་འཇུག་ཕྱག་ལེན་ཕྲ་མོ་ཚུན་ཆད་ཀྱང་མ་འཕྱུགས་ཤིང་འགད་གཙང་བར་འཛུགས་པར་མཛད།",
    "རྒྱུན་ཇའི་ཐོག་ཏུ་ཁྱོན་བསྡོམས་དངུལ་སྲང་བརྒྱ་དང་།",
    "སྐྱབས་མགོན་དམ་པ་འདི་ཉིད་ཟང་ཟིང་གི་རྫས་ལ་ཐུགས་ཞེན་ཆེ་བ་ག་ལ་ཡིན་ཀྱང་སྦྱོར་འཇགས་གནང་དགོས་རྣམས་དགོངས་པ་བཞིན་མ་གྲུབ་པས་ཐུགས་འཁྲུགས་པར་བྱུང་བ་རྗེས་སུའང་ཡང་ཡང་གསུང་ངོ།",
    "ཁྱི་ལོའི་མཇུག་དང་ཕག་ལོའི་ནང་དུ་ཕྱག་འབྱོར་བྱུང་བའི་དངོས་པོ་རྣམས་མར་དང་མཛོ་མོར་བསྒྲིལ་བར་གནང་བར།",
    "མཛོ་མོ་ལེགས་ངེས་བརྒྱད།",
    "དྲེའུ་གསུམ་སོགས་ཕྱག་ན་གང་ཡོད་སྤང་དག་གི་ཚུལ་དུ་གོངས་ཐམས་ཅད་མཁྱེན་གཟིགས་ཆེན་པོར་འབུལ་བར་ཕེབས་ལམ་གྱི་དཀའ་ཚེགས་ཁྱད་དུ་བསད་དེ་ཟླ་བ་དགུ་པའི་ནང་དུ་ཧོར་གཞུང་བརྒྱུད་འགར་ཐར་དུ་སྐྱབས་མགོན་ཐམས་ཅད་མཁྱེན་གཟིགས་ཆེན་པོ་བློ་བཟང་སྐལ་བཟང་རྒྱ་མཚོའི་ཞབས་དྲུང་དུ་ཕེབས་པ་ན་གོང་ས་མཆོག་དང་སྐུ་འཁོར་ཚང་མས་གནང་སྐྱེས་དང་བདག་རྒྱན་ཕུན་སུམ་ཚོགས་པར་མཛད།",
    "ཁྲི་ཆེན་ནོ་མོན་ཧན་གྱི་དྲུང་ནས།",
    "སླར་ཡང་དངུལ་མདའ་ལྷུན་གྲུབ་སྟེང་དུ་ཆིབས་བསྐྱོད་བྱི་ལོའི་ནང་དུ་ལྷུན་གྲུབ་སྟེང་གི་ཇ་མཛོད་དུ་རྒྱལ་ཆེན་རྣམ་ཐོས་སྲས་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་རྣམས་དང་།",
    "དེས་རྒྱ་དཔེ་གང་ཡོད་གཟིགས་ཕུལ་ཞིང་།",
    "དེའི་ཕུད་ལྟ་བུར་རྟ་རྨིག་མ་གཅིག་རྗེས་གནང་ཞིག་གི་སྐབས་འབུལ་བར་མཛད་དེ།",
    "འོན་ཀྱང་ད་ལམ་གྱི་འདི་ཁོ་བོ་ཅག་གི་མཐུ་ལས་བྱུང་བ་རང་ཇི་ལྟར་ལགས་རུང་།",
    "ཡབ་རྗེ་གཤེགས་པའི་ཟླ་ཚེས་ཁོ་ནར་འདུག་ཅེས་གསུང་ལས་ཐོས་པ་ཡལ་ཡོལ་ཙམ་ལས་ཡེ་ཤེས་ཀྱི་གཟིགས་པར་ཆགས་ཐོགས་མེད་པའི་བརྡར་མངོན།",
    "ཕྱག་རྟེན་གྱི་དངོས་པོ་ཚུན་ཀྱང་མཆོག་གི་དངོས་གྲུབ་སྒྲུབ་བྱེད་དང་།",
    "བྱེ་བྲག་བླ་ཆེན་དྲེགས་ལྡན་དག་གིས་སྤྱོད་ཡུལ་དུ་མ་གྱུར་པའི་ཟབ་མོ་སྙན་བརྒྱུད་ཀྱི་སྐོར་ལ་གཞན་དྲིང་མི་འཇོག་པའི་བསྟན་པའི་མངའ་བདག་ཆེན་པོར་ཐུགས་ངེས་འདྲོངས་པའི་ཡིད་ཆེས་བཟློག་ཏུ་མེད་པའི་རྒྱུ་དང་།",
    "སྐྱབས་མགོན་དམ་པ་འདི་ཉིད་ལ་སྙན་གསན་ཞུ་བར་མཛད་པ་ན་དུས་ལ་བབས་པར་མཁྱེན་ནས་ཞལ་གྱིས་བཞེས་ཏེ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་གཟུངས་སྔགས་སོགས་རིང་བསྲེལ་རྣམ་བཞི།",
    "སེང་ལྡེང་གི་ཕུར་བུ་སོགས་ཉེ་བར་དགོས་པའི་ཡོ་བྱད་རྣམས་ཀྱང་མ་ཚང་བར་མེད་པ་སྟ་གོན་གྱིས་ལྗགས་བསྙེན་ཁ་གསོ་དང་།",
    "མགོན་པོ་ཆེ་ཆུང་གི་རྗེས་གནང་སོགས་གནང་།",
    "རྟེན་གྱི་ཞལ་བཞེས་ཐུན་མོང་མ་ཡིན་པ་སོགས་ལ་བརྒྱུད་པའི་མན་ངག་གིས་བརྒྱན་པའི་རབ་ཏུ་གནས་པ་ཐུན་མོང་མ་ཡིན་པའི་ཕྱག་བཞེས་འཁྲུལ་མེད་དུ་མཛད་པ་སོགས།",
    "དཔོན་འབངས་ཀུན་དགའ་མགུ་ཡི་རང་གི་ས་ལ་འགོད་པར་མཛད།",
    "དེ་སྐབས་གནས་ཉེར་གཉིས་སོ་སོའི་མིང་རེ་སྨོས་པ་དང་སྔགས་རྒྱ་རེས་གཏུགས་པ་སྤེལ་མར་མཛད་པ་སོགས་ཤིན་ཏུ་ཡིད་ཆེས་པ་འབྱུང་གསུང་ཞིང་།",
    "བདག་མེད་ལྷ་མོ་བཅོ་ལྔ།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "སྦེ་གོ་གཉིས་དང་བཅས་པ་རྣམས་ཀྱིས་ཆུ་བོ་ཆེན་པོ་རྦ་རླབས་ཀྱི་ལྟེང་ཀ་གཡོ་བ་མིག་གིས་ཀྱང་བལྟ་བར་མི་བཟོད་པ་དེ་ལས་ཕ་རོལ་ཏུ་གཤེགས་པའི་ཞབས་འགྱུར་ཡང་དག་པའི་སྐད་ཅིག་ལ་གདན་འདྲེན་ཞུས་ཏེ།",
    "ཐུགས་དགེས་པའི་གསུང་གིས་གཟེངས་བསྟོད་དང་།",
    "ཟང་ཟིང་གི་གནང་སྐྱེས་ཀྱང་སྩལ།",
    "སྤུས་རི་སྐོར་གྱི་ཆུ་ལྷོ་བྱང་གི་ས་དགོན་ཕལ་ཆེར་ལ་མང་ཇ།",
    "གྲྭ་ཚང་གིས་སེར་སྦྲེང་།",
    "བསྟན་པའི་སྦྱིན་བདག་ཆེན་པོ་འདར་ནས་སོགས་སེར་སྐྱ་མཆོག་དམན་རྣམས་ནས་རང་རང་གི་འབྱོར་ཚོགས་ཇི་སྙེད་ཡོད་པ་རྣམས་ལེགས་སྐྱེས་སུ་བསྟར་ཞིང་།",
    "གྲོང་ཆེན་འདུ་ཁང་དུ་བླ་རེ་ཆེ་ལེགས།",
    "ཞལ་སྒྲུབ་དུས་ཐུན་མོང་བ་རྣམས་དང་།",
    "རྒྱལ་ཕུར་འཛོམ་ཉིན་ཚོགས་བདག་ཐུན་མོང་མ་ཡིན་པའི་རྗེས་གནང་།",
    "ཟླ་བ་དགུ་པའི་ནང་དུ་འདར་ནས་ཆིབས་བསྐྱོད་ཅིང་ར་ས་བརྒྱུད་དེ་ངོར་གྱི་གནས་གཟིགས་དང་།",
    "བླ་གཞིས་གསར་རྙིང་གི་ས་རིས་བདག་ཐོབ་ཤས་བགོས།",
    "ཆོག་མང་ཉིན་བཞི་རེ་འཕར་བ་དང་།",
