    "དགྱེ་པེ་སྣར་རྣམ་པར་རྒྱལ་པའི་གྲོང་དང་།",
    "༡ པེ་སྣར་པར།",
    "པེ་སྣར་པར།",
    "༦༧༣༧༡ ༢༦༣༤༣། བསྟན་པའི་གཏད་རབས་བཞུགས་སོ།",
    "འཕགས་པ་ཤ་ནའི་གོས་ཅན་གྱིས་༡ ༢ ༧བསྟན་པའི་གཏད་རབས་བཞུགས་སོ།",
    "ཀྱང་གར་གྱི་རྗེ་ཞེས་བྱ་བའི་ཚོང་དཔོན་གྱི་བུ་རུ་མགོ་བོའི་རི་བོ་ལ་གཙུག་ལག་ཁང་མཛད་ནས་འཕགས་པ་ཉེར་སྦས་རབ་ཏུ་ཕྱུང་ཞིང་བསྙེན་པར་རྫོགས་ནས་དགྲ་བཅོམ་པར་གྱུར་ཏེ།",
    "ཕུག་སྲིད་དུ་ཁྲུ་བཅོ་བརྒྱད་པ་རྒྱར་ཁྲུ་བཅུ་གཉིས་པར་གནས་ནས།",
    "སྤྲིང་ཡིགངེ་༡༨༨ཕྱུང་ཞིང་བསྙེན་པར་རྫོགས་ནས་དགྲ་བཅོམ་པ་ཉིད་ལ་བཀོད།",
    "མྱ་ངན་མེད་ཅེས་བྱ་བའི་རྒྱལ་པོ་ཉིད་ཤི་ནས་ཁ་ཆེར་ལེགས་མཐོང་བྱུང་སྟེ་མ་དང་ཕ་དག་ལས་དེ་ལ་སེང་གེ་ཞེས་བྱ་བའི་མིང་དུ་གྲུབ་པ་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་སྟེ་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་སོ།",
    "དགེ་སློང་རྣམས་ལ་ཡང་བསྟན་ནས་ཁ་ཆེར་རྣ་རྒྱན་གྱི་ནགས་ཀྱི་གཙུག་ལག་ཁང་དུ་འཕགས་པ་རྩི་བ་ལོགས་ལ་སོགས་པའི་དགྲ་བཅོམ་པ་ལྔ་བརྒྱ་༡༢༩བསྟན་པའི་གཏད་རབས་བཞུགས་སོ།",
    "དང་དཔེ་བསྡུར་བྱས་ཡོད།",
    "ཡུལ་ཀོ་ཤཱམཱིར་ནུབ་པར་འགྱུར་བ་ལྟ་ཞིག་ན།",
    "༡ ༣ ༡ཇི་སྲིད་ཅིག་ཏུ་གནས་པར་འགྱུར།",
    "སློབ་དཔོན་སྟོན་པ་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་བསྟན་པ་ལོ་ཉིས་སྟོང་ནས་འཇིག་པར་ལུང་བསྟན་ན།",
    "ལི་ཡུལ་འདི་ལ་སོགས་པ་ཡུལ་གཞན་གྱི་བསྟན་པ་ཇི་སྲིད་དུ་གནས་པར་འགྱུར།",
    "བདེ་བར་གཤེགས་པའི་བསྟན་པ་ཡུན་རིང་དུ་གནས་པར་བྱ་བའི་ཕྱིར་ཐེ་ཚོམ་དྲིས་པ་ལེགས་ཀྱིས།",
    "ལེགས་པར་ཉོན་ལ་ཡིད་ལ་ཟུང་ཤིག་དང་།",
    "ལི་ཡུལ་ལ་སོགས་པའི་བསྟན་པ་ཇི་སྲིད་དུ་གནས་པར་འགྱུར།",
    "ཡུལ་ཡང་རྒྱལ་པོས་ཕན་ཚུན་རྟོད་ཅིང་འཕྲོག་ཡིཔར་འགྱུར་རོ།",
    "དེ་ཕྱིན་ཆད་ནི་ཡུལ་ཡང་ཉིན་གཅིག་བཞིན་དུ་ཉམས་པར་འགྱུར།",
    "བབ་ཆོལ་གྱི་ལོངས་སྤྱོད་ཀྱང་སོགས་པར་བྱེད་པར་འགྱུར་རོ།",
    "ཁྱིམ་པས་བསླབ་པར་བྱ་བའི་བཟོ་དང་།",
    "སྒོ་གསོལ་རྔམ་པོ་ཆེ་ཡང་བྱེད་པར་འགྱུར།",
    "དེའི་ཚེ་ལི་ཡུལ་ལ་སོགས་པར་རྒྱལ་པོ་དང་།",
    "གནས་ཀྱིས་ཕོངས་པར་འགྱུར་རོ།",
    "ལྡུམ་ར་ལ་སོགས་པ་ཡོ་བྱད་རྣམས་ཀྱང་བཙན་ཐབ་ཀྱི་སུ་འཕྲོག་པར་བྱེད།",
    "དེ་ནས་དགེ་སློང་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟ་བུར་གྱུར་པར་ཤེས་ནས་ཡི་མུག་སྟེ།",
    "དེའི་ཚེ་ཐམས་ཅད་ཀྱིས་ཆོ་དེ་ཆེན་པོ་འདེབས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བྱས་པ་གཟོ་བ་ཐམས་ཅད་ཀྱང་གཙུག་ལག་ཁང་དེར་འདུས་ཏེ་གཅིག་ལ་གཅིག་ལྟ་ཞིང་འདི་སྐད་དུ་བདེ་བར་གཤེགས་པའི་བསྟན་པ་ནི་ཡུན་རིང་པོར་མི་གནས་སོ།",
    "ཡུལ་འདི་ཡང་སྟོངས་པར་འགྱུར་རོ་ཞེས་མྱ་ངན་བྱེད་ཅིང་ངུ་བར་འགྱུར་རོ།",
    "དེའི་ཚེ་དགེ་སློང་དེ་དག་འདི་སྙམ་དུ་ཡུལ་འདིར་ནི་འཚོ་བ་མི་འབྱོར་ན་འདི་བོར་ཏེ་ཡུལ་གཞན་དུ་འགྲོ་བར་བྱའོ་སྙམ་དུ་སེམས་མཐུན་པར་གྱུར་པ་གང་དུ་འདོད་པར་བྱ་ཞེས་གྲོས་བྱས་ཏེ།",
    "དེའི་ཚེ་ལི་ཡུལ་ན་གནས་པའི་ཀླུ་ཐམས་ཅད་འདི་སྙམ་དུ་བདེ་བར་གཤེགས་པའི་བསྟན་པ་ནི་རྨེགས་མེད་པར་འགྱུར་ལ་ཐུག་གོ་སྙམ་དུ་མྱ་ངན་བྱེད་ཅིང་བསྟན་པ་གནས་པར་བྱ་བའི་ཕྱིར་ཆར་ཆེན་པོ་ཕབ་སྟེ།",
    "དེའི་ཚེ་མི་རྒན་རྒོན་རྣམས་ནི་བསླབ་པ་འཛིན་པར་བྱེད།",
    "གཉེན་གྱི་རྗེས་བཞིན་དུ་ལྟ་བཞིན་པར་མེ་སྐར་གྱི་ལམ་དུ་ཞུགས་ཏེ་འགྲོ་བར་འགྱུར་རོ།",
    "གཟོ་བོ་དང་གནང་ཆེན་རྣམས་དྲུང་དུ་བོས་ཏེ་ངུས་ནས་འདི་སྐད་ཅེས།",
    "དེའི་ཚེ་བོད་ཡུལ་གྱི་རྒྱལ་པོ་དང་བློན་པོ་རྣམས་ཀྱིས་དགེ་སློང་དེ་དག་མཐོང་ནས་དད་པ་ཆེན་པོ་སྐྱེ་ཞིང་གཙུག་ལག་ཁང་ཆེན་པོ་བདུན་ཡང་བརྩིག་པར་འགྱུར་རོ།",
    "པར་ཝན་པ་དང་།",
    "སྤྲིང་ཡིག་ངེ་༡༨༨ རྫས་བྱས་ནས་འགྲོ་བར་འགྱུར་རོ།",
    "སྐྱེ་བོ་དང་རྩོད་པའི་དུས་དེའི་ཚེ་རྒྱ་ཡུལ་གྱི་དགེ་སློང་རྣམས་ཀྱང་ཤིན་ཏུ་སྡུག་བསྔལ་བས་གཟིར་ནས་ཡུལ་གན་དྷ་རར་འགྲོ་བར་འགྱུར་རོ་། དེ་ལྟར་དོང་བ་དང་དགེ་སློང་དེ་དག་ཐམས་ཅད་ཡུལ་གན་དྷ་རར་འགྲོ་བའི་ལམ་ཀར་ཕྲད་པར་འགྱུར་རོ།",
    "ནོར་ཕྱུགས་དག་ཕྲོགས་ཏེ་དགེ་སློང་དག་ཀྱང་གསོད་པར་འགྱུར་རོ།",
    "བདག་ནི་དེའི་ཤུལ་དུ་བཞུད་པར་མི་དགའ་ཞིང་མཆིས་སོ།",
    "མ་བསྙེངས་པར་རྗེས་དགྲ་ཆོམས་སུ་དོགས་པ་ནི་འབངས་དང་ཕྱག་རྗེད་དང་ཁུར་རྣམས་༡ ༤༢༡ ༤༢།",
    "དེའི་ཚེ་ཀླུའི་རྒྱལ་པོ་དེའི་རྒྱབ་ཀྱི་པགས་པ་ཕྱུགས་ཀྱི་རྨིག་པ་དང་མིའི་རྐང་པས་བཤུས་ཏེ་རྨ་ཆེན་པོ་བྱུང་སྟེ་མཚོའི་ནང་དུ་རྣག་ཁྲག་ཀྱང་འཛག་པར་འགྱུར་རོ།",
    "མཚོ་དེ་ཡང་སྐམས་པར་འགྱུར་ཏེ།",
    "ཕྱོགས་གཉིས་སུ་ཆད་པར་འགྱུར་རོ།",
    "དྲུ་གུ་རུས་སྣ་ཚོགས་དུ་མིའི་ིརྒྱལ་པོ་ནི་དྲུ་གུས་བྱེད་པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་དེ་གསུམ་ཀ་ནི་ཡང་སེམས་མཐུན་པར་འགྱུར་རོ།",
    "གཞན་ཡང་དག་པའི་ལྟ་བ་འཛིན་པའི་ཡུལ་ཐམས་ཅད་བཅོམ་ནས་མི་མང་པོ་ཁ་བཏགས་ནས་གྲོང་ལ་སོགས་པ་ཡང་སྟོངས་པར་འགྱུར་རོ།",
