    "རྗེས་སུ་ཉིན་རེར་མིག་ལ་ཨིའུ་ལིན་ཐེངས་གཏིག་པ་དང་དུས་མཚུངས་སུ་ལེན་མེ་སུའོ་རྩིས་གཞི་ཁྲི་ཙོ་ཁབ་ཤུའི་ནང་དུ་རྒྱག་དགོས།",
    "༢ཟགས་ཐོན་དངོས་རྫས་ཉུང་ཙམ་སོང་དུས་ཅན་གྱི་ལིའུ་སོ་ཤིན་བཞུས་ཁུ་མིག་ལུ་ཉིན་རེར་ཐེངས་གཏིག་དགོས།",
    "ཅུ་གང་ཐུན་དྲུག་རྒྱལ་མོ་ཀར་ཐུན་ལྔ།",
    "ལིང་འདི་རྣམས་ཞིབ་བཏགས་དར་རམ་རས་ལ་བཙག་ཐོག་རྙིང་བ་ཐུན་རེ་སྐམ་འདེབས་བྱ།",
    "གསར་བར་བུད་མེད་ནུ་ཞོ་སྦྱར་ལ་བྱུགས་པས་ལན་གསུམ་གྱིས་མི་གྲོལ་མི་སྲིད་དོ།",
    "མི་ཟངས་རྡོ་བརྡར་བའི་ཕྱེ་མ་ལུག་སོགས་ཀྱི་མིག་གི་ལང་ཐོག་ལ་བྱུགས་ན་ཕན།",
    "མི་ལ་མི་ནོར་ཁོང་དུ་ཁབ་ཤོར་སོང་བ་འདོན་ཐབས།",
    "སྲེ་མོའི་བགག་པ་པ་གཡོན་བཤུས་ནསོ།",
    "གོང་གི་སྲིད་སྤེལ་འདོད་པ་ཡི།",
    "བ་ཏེ་ཕྱུགས་ལ་སོགས་ནོར་གྱི་སྲིད་སྤྲེལ་ཟབ་མོ།",
    "ཤུ་དག་གི་ཐུང་ཆུ་རྣམས་སྦྱར་བཏདེ་ཕྱུགས་རབས་ཆད་ཅེས་བྱུང་གཏེར་བསྟན་སྲུང་ཡོངས་རྫོགས་ཀྱི་མ་གུས་ཆམ་དབབ་ཀྱི་ལས་བརྒྱུ་བརྒྱད་པ་ལས་གསུངས་སོ།",
    "ཁོང་ཐབ་རྒྱག་པའི་སྔགས་ཏི་ཏི་སོགས་རེད་ཟེར་ཕྱུགས་མི་སྟེར་བའི་ཕྱག་རྒྱུ་ལྷས་དང་ཁྱིམ་གཉིས་བཅས་ཀྱི་བར་དུ་བཙུགས་པས་ཕན་ནོ།",
    "མི་དཔེ་རིས་ར་སྤྱང་ཀིའི་ཁ་ཆིངས་བྱེད་ན་གོང་གི་སྔགས་ཨོཾ་མ་དུར་ཅད་ལ་ཧཱ་དེ་ཀ་ཡིན།",
    "ཚར་བུའམ་བེ་དྷོ་ཤིང་ཤུན་པགས་མ་བཤུས་པ་རྩེ་མོ་ནས་སོག་ལེས་སྙགས་ཉག་ལ་སྤྱང་ཀིའི་ཁ་བཟོས་ཁ་དེ་ནོར་གྱི་རྔ་མས་བཀྱིགས།་",
    "གཤམ་དུ་མིག་ཕུག་པ་ལ་ཡང་དེ་ཉིད་ཀྱིས་ལུང་བཏགས་ལ་རྟ་ཕྱུགས་གང་ཡིན་སྤུ་ཁ་ལེགས་པ་གཅིག་གི་ཟེ་བ་ལ་བཏགས་པས་ཐུབ་ངེས་ཅན་ཡིན།",
    "སྦྱིན་སྲེག་གི་ས་དང་ས་གཙང་བསྲེས་ལ་སྔགས་འདིསྟོང་བཏབ།",
    "སྔགས་སྟོང་ཚོ་རེ་བཏབ།",
    "ཕྱུགས་ཀྱི་གཙོ་བོ་གཅིག་གི་མགུལ་དུ་བཏགས་པས་ཐུབ།",
    "མི་ཕ་དམ་པའི་ལུགས་ཀྱི་ཀླུང་སྲུང་རེའུ་མིག་དགུ་བ་འདི་བཏགས་སྨཱཤཱཨོ།",
    "མཚན་མོའི་འོད་ལྡན་སཾ་ཀུང་ཀུ་མ་གསུམ་ཞོ་རེ་རེ།",
    "རིང་གོ་ཐལ་གསུམ་གཉིས་ད་ཏྲིག་སུམ་ཆ་སྦྱར།",
    "སྔགས་བརྒྱ་རེ་བཏབ་ནས་བཏགས་མར་ལ་བསྔགས་ནས་བྱིན་པས་ཐུབ་བོ།",
    "མི་༡ ཞོ་རྩབསོ་མོའི་ཁུར་གདུས་ནས་བཏང་ན་འཁྲུ་གཅོདོ་ཌ་ཁོ་༦ མཆོག་རང་ཁྲག་འཁྱུ་ལ་ལོ་ཅིན་པི་སྲིབ་སྐྱེས་བ་སིལ་སྐུམ་ཕྱི་མ་ཆ་ང་།་",
    "རང་༧གིས་ཕུལ་ན་ཤིན་ཏུ་ཕན་པ་ལག་བླང་མའོབོང་དྲི་བཙོད་དང་བུ་ལེ་ག་༣ དབ།",
    "རང་གྲང་འཁྲུ་ལ་སེ་འབྲུའི་སྦྱོར་བ་མྱོང་ཐོན་མ་ཟབ་རང་ཡང་གོ་ཐལ་གཉིས་སྦྱོར་ཟབ།",
    "ༀཏཱརེ་ཏཱཾ་སྭཱ་ཧཱ",
    "མར་ཁུ་དྲོན་མོའི་ནང་ཛཱཏི་བཏབ་པ་བླུད།",
    "མོ་ཕྱུགས་ཀྱི་ཤ་ཤེད་ངན་པ་ལ་སོགས་པའི་རྐྱེན་གྱིས་བེའུ་ལ་ཉང་དཀར་འབྱུང་སྲིད་བ་རེད།",
    "ཉིན་རེར་ཐེངས་གཅིག་རེ་དང་ཐེངས་རེ་ལ་དཀར་ཡོལ་དོ་རེ་ལྟུད་དགོས།",
    "ཡང་ན་མོ་ཕྱུགས་ཀྱི་ཁྲག་ཧོ་ཧྲིན་བླངས་ནས་བེའུའི་སྟོད་རྩར་ཁབ་རྒྱག་པ།",
    "ཧོང་ངན་བཀའ་ཁེ་དང་ཆུ་ཁོལ་དྲོ་འཇམ་གཙང་མ་ཧོ་ཧྲིན་ཉིན་རེར་ཐེརས་རེ་དང་།",
    "༣ཧྥུ་ནན་ཤི་ལིན་ཉིན་རེར་ཐེངས་གསུམ་དང་།",
    "ཐེངས་རེར་ཁེ་ལྟད།",
    "ཡང་ན་ཧྥུ་ནན་ཙོ་ཐུང་ཉིན་རེར་ཐེངས་གཉིས་དང་།",
    "ཐེངས་རེར་ཁེ་ལྟུད་པ་དང་།",
    "རིན་རྟ་གསེབ་ཀྱི་རྫིང་གིས་གློ་འབུ་མཆིན་འབུ་ཐུབ།",
    "ལུག་གི་སྣ་སྲིན་ན་སོན་ན་ཧི་ལམ་འབུང་ཐུལ་དང་འདྲ་གྱམངལ་སྐྱེས་ཡིན།",
    "དབྱར་སྟོན་དུས་ཀྱི་གནམ་ཐང་བུའི་ཉིན་གུང་གི་སྨྲ་གཞུག་ཏུ།",
    "སྣེབ་སྦྱོར་བྱས་ཟིན་པའི་མོ་འབུ་མགྱོགས་མྱུར་གྱིས་ལུག་གི་སྣ་ཁུང་དུ་འཕུར་ནས་འབུ་ཕྲུག་གཏོང་བ་རེད།",
    "ཐེངས་རེར་ཧ་ལམ་ཉི་ཤུ་ནས་བཞི་བཅུ་གཏོང་ཐུབ།",
    "ནར་སོན་པའི་འབུ་ཕྲུག་དེ་སླར་སྣ་ཆུང་ནས་བུད་པས།",
    "ཐུམ་འབུ་དེ་མི་ཟ་མི་འགུལ་བར་ཟླ་གཅིག་གཉིས་འགོར་རྗེས་འབུ་ན་སོན་དུ་གྱུར་པ་རེད།",
    "ལུག་གི་སྣ་སྲིན་ན་སོན་ལུག་གི་ཐག་ཉེ་སར་འཕུར་ཡོང་དུས་ལ་ལུག་རྒྱུན་པར་ཕྱོགས་གཅིག་ཏུ་འཚངས་ནས།",
    "འབུ་ཕྲུག་གི་ལུས་ཧྲིལ་བོར་ཚེར་ཕྲ་སྐྱེས་ཡོད་སྟབས་ཆུ་དྭངས་མོའམོ་རྣག་ལྟ་བུའི་ཁུང་ཚ་སྐྲང་བྱུང་ནས།",
    "ཕྱི་རུ་བཞུར་བའི་སྣབས་དེ་སྣ་ཁུང་གི་མཐར་སྐོར་དུ་སྐམས་ཤིང་སྣ་ཁུང་བཀག་སྟེ།",
    "ལུག་གི་དབུགས་འབྱིན་རྔུབ་དཀའ་བར་མ་ཟད་ད་དུང་སྦྲིད་པ་རྒྱུག་ཅིང་མགོ་གཡུག་པ།",
    "༡ཆུ་དྭངས་མོའམ་བཙགས་པའི་ཆུ་ཆ་གོ་བདུན་ནང་དུ་དུག་སེལ་བྱེད་ཀྱི་ལེ་སོར་ཆ་གསུམ་བསྣན་ནས།",
    "༢ལུག་གི་ལྗི་ཚད་སྤྱི་རྒྱ་གང་རེར་ཏེས་པེ་ཁྲུང་ཁེ་བླུད་ན་སྣ་ཁུང་ནང་གི་འབུ་ཕྲུག་ཡོངས་རྫོགས་རྩ་མེད་གཏོང་ཐུབ་པ་རེད།",
    "པ་༣སི་ལུའུ་དཔའ་ཐན་ཆ་གཅིག་དང་གཡིས་ཆ་གཅིག་བསྲེས་རྗེས་ལུག་གི་ཆེ་ཆུང་དང་ཤ་ཤེད་བཟང་ངན་གཞིར་བཟུང་སྟེ།",
    "ལུག་གི་དཔྲལ་རུས་དང་རྭ་རྙིང་དུ་གནས་པའི་འབུ་ཕྲུག་ཡོངས་རྫོགས་ཚར་གཅོད་བྱེད་ཐུབ་ལ།",
    "དུས་ཚོད་སྐར་མ་བཞི་ལྔ་ཙམ་འགོར་རྗེས་འཕྲལ་དུ་དྲག་རྒྱུ་རེད།",
    "ལུག་གི་སྣ་ཁུང་བཀྲུས་ན།",
    "སྣ་ཁུང་ནང་གི་འབུ་ཕྲུག་ཚང་མ་ཚར་གཅོད་བྱེད་ཐུབ།",
    "སྲིན་བུ་སྤུ་ཅན་ཕྲུ་གུ་རུམ་ནས་བྱུང་སྟེ་དེ་ཆུ་འབུ་དུང་དཀར་གྱི་ལུས་ཕུང་ནང་དུ་འཛུལ་ཏེ་ཡར་སྐྱེས་ནས་སྲིན་བུ་མཇུག་ཅན་ཕྲུ་གུ་རུ་གྱུར་པ་དང་ཆུ་འབུ་དུང་དཀར་གྱི་ལུས་ལས་ཕྱིར་བུད་ནས།",
    "མ་ནེའི་འོག་ཆུ་སྐྲང་བྱུང་ནས་ཨོལ་མ་བླུག་པ་བྲང་གསུས་འོག་ཏུའང་ཆུ་སྐྲང་བྱུང་ནས་སྦོས་པརེག་དཔྱད་བྱེད་ཚེ་ན་ཟུག་གི་ཚོར་བ་མེད་པ།",
    "ལུག་ལུག་གི་ལྗིད་ཚད་སྤྱི་རྒྱ་གང་རེར་ཧོ་ཁེ་རེར་ཁེ་ཡིན།",
    "པགས་སྦྱང་ལུས་ཧྲིལ་བོར་སྤུ་ཕྲ་མོ་ཤིན་ཏུ་མཐུག་པོ་སྐྱེས་ཡོད་ཅིང་།",
    "གསུས་ཁག་ལུས་ཀྱི་ལོགས་གཉིས་བཅས་ལ་སྒོ་ང་གཏོང་བ་རེད།",
    "སྐོགས་ཤུན་ཆགས་ནས་སྐོགས་ཤུན་རི་རེའི་ནང་དུ་འབུ་ཕྲུག་རེ་ཡོད།",
    "འབུ་ཕྲུག་ཆེར་སྐྱེས་པ་དང་བསྟུན་ནས་སྐོགས་ཤུན་ཀྱང་ཇེ་ཆེར་བསྐྱེད་པ་རེད།",
    "འབུ་ཕྲུག་གིས་ནོར་ལུས་ཀྱི་ནང་དུ་འགུལ་སྐྱོད་བྱེད་པའི་དུས་ནོར་གྱི་ལུས་ཐོག་ནས་འཚོ་བཅུད་འཇིབ་ལེན་བྱས་ཏེ་ནོར་གྱི་ནང་ཁྲོལ་ལ་གཏོར་བརླག་གཏོང་བར་མ་ཟད།",
    "ནོར་ཆེ་བས་ཤེད་མོ་མི་འཛིན་པ།",
    "ཡང་ན་རྡོ་སྣུམ་ཧོ་ཧྲིན་དང་ཏེས་པེ་ཁྲུང་ཁེ་བསྲེས་ནས་རྒྱབ་ལ་བྱུག་༢ཏུའུ་ཅན་གྱི་ཆང་གིས་འབུ་ཕྲུག་སྐྱེས་ཡོད་སའི་མཐའ་སྐོར་དུ་ཆུ་ཐིགས་གཅིག་པ་བཞིན་དུ་ཁབ་ཐེངས་གཅིག་བརྒྱབ་ན་འབུ་ཕྲུག་གསོད་ཐུབ་རྒྱུ་རེད།",
    "མཛེར་བའི་རྩ་བ་ནས་སོར་མོས་ཤེད་ཀྱིས་བཙིར་ན་འབུ་ཕྲུག་ཕྱི་རུ་འཚིར་ཐུབ།",
    "ཤེད་མྱུར་དུ་ཇེ་ཞན་དུ་འགྱུར་བ་རེད།",
    "༡ལྗིད་ཚད་སྤྱི་རྒྱ་གང་རེར་ཧོང་ཨན་སྨིས་ཁེ་ལྟར་ཉིན་རེར་ཐེངས་གཅིག་སྡུད་པ་དང་།",
    "ནོར་རེར་ཐེངས་རེར་ཁེ་ལྡུད་པ་དང་ཉིན་བླུད་ན་ཡང་ཆོག་ཕོ་རྒྱུ་ལ་སྲུང་སྐྱོབ་བྱེད་རྒྱུ་ན་ཧྲི་ལའི་གཤེར་ཁུ་དང་ཚུ་ཤོ་ཟོན་པེས་བཀོལ་ཆོག",
    "༢བེའུ་ལ་རྒྱུ་ལན་ཤི་ལིན་ཁེ་ཉིན་རེར་ཐེངས་གཅིག་དང་མུ་མཐུད་དུ་ཉིན་བདུན་ལ་ལྡུད་དགོས།",
    "ཉིན་རེར་ཐེངས་གཉིས་དང་ཐེངས་རེར་ཁེམ་བུ་གང་།",
    "༥ཅན་གྱི་ཕོ་ཐོའོ་ཐང་བཞུས་ཁུའམ་ཡང་ན་སྐྱེ་ལུགས་ཚྭ་ཆུ་ཧོ་ཧྲིན་ཉིན་རེར་ཐེངས་རེ་སྣོད་རྩར་ཁབ་རྒྱག་དགོས།",
    "གྲོད་པུ་སྦོས་ནས་ལྟད་པའི་ནུས་པ་ཇེ་ཞན་དུ་སོང་ནས་ཟས་མ་ཞུ་བ་བཅས་རེད།",
    "གྲོད་པུར་རེག་དཔྱད་བྱེད་དུས་རྩྭ་མ་ཞུ་བ་གང་ལ་ཡོད་པ་དང་སྲ་མཁྲེགས་ཡིན་པའམ།",
    "གྲོད་པུའི་འུར་འཁྲོག་གི་སྒྲ་མི་གྲགས་པ་རེད།",
    "ན་ཚུལ་ཇེ་སྡུག་ཏུ་སོང་རྗེས།",
    "མིག་ནང་གི་སྐྱི་མོ་སྔོ་སྨུག་ཏུ་འགྱུར་བས།",
    "༢གྲོད་པའི་ནང་གི་ཟས་མ་ཞུ་བ་དེ་ཕྱིར་འབུད་བས་ཁབ་ཁབ་ཐབས་བྱེད་ཆེད་ཧྲི་ལ་གཤེར་ཁུ་ཧོ་ཧྲིན་དང་ལིའུ་སོན་ནའམ་ལིའུ་སོན་མེ་ཁེ་ཅིའུ་ཧྲི་སོན་ཐེས་ཅ་ཁེ་བཅས་བཙས་བསྲེས་ནས་ཆུ་ཧོ་ཧྲིན་བསྣན་རྗེས།",
    "ཡང་ན་རྩྭ་སྐམ་པོ་འབོར་ཆེན་ཐོས་མ་ཐག་ཏུ་ཆུ་མང་བོ་འཐུང་ནས་གྲོད་པུའི་ནང་དུ་དབུགས་འབོར་ཆེན་རྒྱས་པའི་རྐྱེན་གྱིས་གསུས་བཁོག་མགྱོགས་མྱུར་དུ་སྦོས་པ་རེད།",
    "དབུགས་གཏོང་ལེན་བྱེད་ཚུལ་ཐུང་ཞིང་འཚངས་པབ་། མིག་ནང་གི་སྐེ་བསྲིངས་ཤིང་མིག་འབུར་ཚུགས་སུ་ལྟ་བགསུས་པ་རྡུང་དཔྱད་བྱེད་དུས་རྗེ་སྐྱི་མོ་དམར་ནག་ཡིན།",
    "ཁ་ཆུ་འབོར་ཆེན་བཞུར་བ་བཅས་རེད།",
    "གྲོད་པའི་ནང་གི་དབུགས་གཏོང་རོགས་བྱེད་པའི་ནུས་པ་ཡོད།",
    "གྲོད་པུར་ལག་པས་གནོན་འཕུར་བྱས་ན་ཡང་ཕན་ནུས་ཡོད་པ་རེད།",
    "ཚབས་ཆེན་རྣམས་མཐར་ཆུ་འགག་ནས་སྨྱོ་ཚུལ་ལ་སྟོན་གང་མཐོང་རྡུངས་ནས་མཐར་འཆི་འགྲོ་བ་རེད།",
    "ངང་སེར་གྱི་སྤུ་བདུག་ན་ཕན་པ་མི་ཆུ་དུག་གི་སྔགས།",
    "མི་དུད་འགྲོའི་རིགས་རྣམས་ཀྱི་དུག་བཅོས་ཟབ་མོ་འདི་ལ་གསུམ་སྟེ།",
    "སྦྲ་དུག་རྩྭ་དུག་སྲིན་དུག་གི་བཅོས་སོ།",
    "ཕོ་ཡོ་གོ་ལྡོག་གི་རྨངས་སྤུ།",
    "ཕྱེ་མར་རྣམས་ཀྱི་དུད་པ་མགོ་ཕུར་ལ་སྣ་ཆུ་མ་བྱུང་གི་བར་བདུག་དེས་ཐུབ་བོ་ རིན་ཡང་རྟའི་སྦྲེ་དུག་སེལ་བ་ལ།",
    "རྟ་བོང་སྦེ་དུག་གིས་ན་བའི་སྔགས།",
    "ཁ་ཆུ་འཛག་ཡན་ལག་གིས་ས་མི་ནོན་པར་འཁྱོར།",
    "ཕྱང་མའི་དུག་གིས་ན་བར་ཞེ་ཆེན་ནམ་ཡ་རྐན་གཏར་བས་ཐུབ།",
    "མི་རེ་ལྕག་པས་དུག་ན།",
    "རིན་ར་དུག་གིས་དུག་ན།",
    "མ་མོའི་དར་བ་ལ་རི་དྭགས་ཤ་བའི་ཀླད་པ་སྦྱར་བ་བླུད།",
    "གཙུག་གི་ཕྱོགས་བཞིར་ཚོན་རེ་ལ་ཚུགས་བྱ།",
    "རིན་སྤྱིར་དུག་རིགས་ཐམས་ཅད་ལ་བྱང་བུལ་སླད་མེད་ཐུན་ཆེན་རེ་ཆུ་དྲོན་ལ་བཏབ་ནས་གཏོང་།",
    "ཐང་ཕྲོམ་རྣམས་གང་རུང་གི་ཐང་གཏོང་བས་ཕན།",
    "སྒོ་སྟན་བསྟད་ནས་རྟ་བདག་གི་ལྷམ་ཕྱི་ཤད་བྱས་ལ་ཚག་བྱ།",
    "རིན་ཤ་ཡི་ཁུ་བར་ལན་ཚྭ་དང་གླ་རྩི་བཏབ་པ་བླུད་པས་ཕན་བུད་མེད་ཀྱི་མངལ་དུག་བྱུང་ན།",
    "ཁོང་བ་རྒྱུས་ནས་ཁྱི་དེ་ལ་ཨ་རུ་ར་དང་ཕབས་བཅས་དྲི་ཚང་ཚོལ་ཚོལ་བྱེད།",
    "རྐང་ལག་གིས་ས་བརྐོ་དེ་ཡ་རྐན་རྒྱས་པའི་སོ་རྩ་ནས་རིམ་མགོས་ས་བརྡུང་།",
    "སོ་མ་ར་ཙ་བ་ལང་གི་ལྕི་ཁུར་སྦྱར་བས་བརྟན་གཡོའི་དུག་ཀུན་འཛོམས།",
    "མི་ལུག་གིས་ཕུར་དུག་ཐོས་པས་ན་ན།",
    "ཐར་ནུ་ཆ་གཅིག་བྱས་ལ་ཐར་ནུ་བ་ཆུར་བཙོས་པའི་ཁུ་བའི་ནང་དུ་དཀར་བོ་གཆིག་ཐུབ་རྡོག་གཅིག་གི་ཕྱེ་མ་འདེབས།",
