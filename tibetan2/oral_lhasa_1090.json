    "འགྲོ་བའི་དམ་པ་འཇིག་པར་འགྱུར།",
    "དེའི་རིགས་ཀྱི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེ་ནས་ཕྱིས་ཇི་སྲིད་དུ་རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་ཏིང་ངེ་འཛིན་ཐོབ་པར་འགྱུར་རོ།",
    "འགྲོ་བ་དམ་པ་འཇིག་པར་འགྱུར་བ་ལ་དམིགས་པའི་ཏིང་ངེ་འཛིན་ཡང་ཐོབ་པར་འགྱུར་རོ།་",
    "དེའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ་ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་དེའམ།",
    "ཞེས་བརྗོད་ཅིང་འདིར་རིན་ཆེན་ཆར་འབེེབས་སམ་དེའི་རིགས་སུ་བདག་ཉིད་ངེས་པར་བྱས་ཏེ།",
    "བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདིར་ཡང་ནོར་བུའི་མཚན་མ་ལ་སོགས་པ་སྟེར་བར་འགྱུར་རོ་ཞེས་བྱ་བ་དེའི་ཕྱག་རྒྱ་ཆེན་པོའི་ཡེ་ཤེས་དེའི་དངོས་གྲུབ་དམ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཐམས་ཅད་ཀྱི་གནས་ཀུན་དུ་འདི་རྣམས་གཞག་པར་བྱའོ།",
    "ཇི་ལྟར་གཞག་པར་བྱ་ཞེ་ན།",
    "རྡོ་རྗེ་རིན་ཆེན་གཉིས་བྱས་ལ།་།",
    "ཞེས་བྱ་བ་ནི་ནོར་བུ་ཁུ་ཚུར་གྱི་གནས་སུ་བཞད་པའི་རྡོ་རྗེ་རིན་ཆེན་གྱི་ཕྱག་རྒྱ་གཉིས་སུ་བྱས་ན་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རིན་ཆེན་འབེབས་པའི་མཐར་ཐུག་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བཅོམ་ལྡན་འདས་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "ཏིང་ངེ་འཛིན་རིན་ཆེན་ཕྱག་རྒྱ་ཞེས་བྱ་བ་དེ་ལ་སྙོམས་པར་ཞུགས་ཤིང་མངོན་སུམ་དུ་མཛད་ནས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་སྔ་མ་བཞིན་དུ་ཕུལ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་གཞུང་འདི་ཙམ་གྱིས་ནི་ནོར་བུ་ཆེན་པོའི་རིགས་ཀྱི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལྔ་པོ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་བསྡུ་བ་དང་བྱིན་ཀྱིས་བརླབས་པ་ལ་སོགས་པ་ནི་སྔ་མ་བཞིན་དུ་ལས་ཀྱི་ཕྱག་རྒྱ་ཆེན་ཛེེཔོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལྔ་པོ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་ཞེས་དྷིབྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་ཏུ་གྱུར་པ་ཀྱེཏྲེ་ན་རིགས་ཐམས་ཅད་ཀྱི་དཀྱིལ་འཁོར་ལས་དམ་པར་གྱུར་པའི་ཕྱིར།",
    "དཀྱིལ་འཁོར་ཡོངས་སུ་བརྟག་པར་བྱ།",
    "དབྱིབས་ལ་སོགས་པ་དང་ལྡན་པའི་རྣམ་པར་སྣང་མཛད་བྲི་བར་བྱའོ།",
    "དེ་ནས་ཇི་ལྟ་བ་བཞིན་དུ་བཅུག་སྟེ་བསླབ་པར་བྱའོ།",
    "ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་པར་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡེ་ཤེས་བསྐྱེད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་རིན་ཆེན་སྒྲུབ་པའི་མན་ངག་ཡིན་པས་༣་ཤེས་པར་བྱའོ།",
    "དེ་བསྒྲུབ་ཅིང་སྤྲུལ་པར་བྱེད་པའོ།",
    "དཔྲལ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཡི་གེ་ཏྲས་སྤྲུལ་ལ་གཞག་པར་བྱའོ།",
    "དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་འགྱུར།",
    "དེ་ནས་ཟླ་བ་ཉ་ལ་མཚན་ཐོག་ཐག་བསྒོམས་ན་བྱེའདོད་པའི་ལྷའི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "སྤྲད་པས་གཉིས་ཀ་འགྲུབ་པར་འགྱུར།",
    "ཡང་དག་པར་སྦྱར་བ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེས་བཅོམ་ལྡན་འདས་དང་ལྷན་ཅིག་མཉམ་པར་སྦྱར་བར་བསྒོམས་ལ།",
    "ཨོཾ་བཛྲ་རཏྣ་ས་ཁྱི་བ་དྷི་དྷ་ར་ཏྭོ་པྲ་ཡཙྪ་ཤྲཱི་རྒྱུ་ཨ་བྷི་ཥིཉྩ་ཏི་ཧ་ཧ་ཧ་ཏྲ་ཞེས་བྱ་བ་འདི་བརྗོད་པར་བྱའོ།",
    "ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱི་ལས་ཀྱི་དཀྱིལ་འཁོར་སྒྲུབ་པར་བྱེད་ན་གསང་བའི་ཕྱག་རྒྱ་མཆོག་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་ནོར་བུ་ཆེན་པོའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པ་ན་གསང་བའི་ཕྱག་རྒྱ་ནི་འདི་ཡིན་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་དང་།",
    "ཨོཾ་བཛྲ་ཨཱཏྨ་ཀོཉཧཾ་ཞེས་ལན་གསུམ་བརྗོད་ཅིང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རིན་ཆེན་འབེབས་པའི་བར་གྱི་མཐར་ཐུག་པའི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེའི་རང་བཞིན་བདག་ཡིན་ནོ་ཞེས་བསམ་པར་བྱ་བ་དང་།",
    "དེ་ནས་སྭ་བྷཱ་ལེབ་ཤུདྡྷོཉ་ཧཾ་ཞེས་ལན་གསུམ་བརྗོད་ཅིང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་ནོར་བུ་རིན་ཆེན་འབེབས་པའི་མཐར་ཐུག་པའི་ལྷ་རྣམས་ཐམས་ཅད་ཀྱི་སྐུ་དང་།",
    "ཐུགས་རྡོ་རྗེ་གཟུགས་བརྙན་དང་མཚུངས་པར་བདག་ཉིད་བསམ་པར་བྱའོ།",
    "བདག་ཉིད་དང་ཡེ་ཤེས་གཅིག་ལས་བྱུང་བ་ནི་བདག་ཡིན་ནོ་ཞེས་བྱ་བ་བསམ་ཕུ་༧་པར་བྱའོ།",
    "ཨོཾ་སཏྠ་ཨརྦ་སིདྷི་པྲ་དཱ་ཧཱུཾ་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་ངེས་པར་བརྗོད་ན་དེ་ལྟར་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ཨོཾ་མ་ཎི་རཏྣ་ཨཱ་བེ་ཤ་ཨ་ཞེས་བྱ་བའི་བར་དུ་གཟུངས་ཀྱི་རིག་པ་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ནས་བརྩམས་ནས།",
    "དེ་ནས་ལས་ཀྱི་དཀྱིལ་འཁོར་སྒྲུབ་པར་འདོད་པས་སྔ་མ་བཞིན་དུ་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ལ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་རྒྱ་ཆེན་པོ་རྣམ་པ་ལྔ་བཅིངས་ཏེ།",
    "ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་དོན་ཐམས་ཅད་གྲུབ་པའི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ཏེ།",
    "དོན་གསུམ་རྣམ་པར་བསྒོམས་ནས།",
    "དེ་ལྟར་ལས་ཀྱི་དཀྱིལ་འཁོར་འགྲུབ་པར་འགྱུར་རོ།",
    "ནོར་བུ་ཆེན་པོའི་རིགས་སྒྲུབ་པར་བྱེད་པའི་གསང་བའི་ཕྱག་རྒྱ་ནི་འདི་ཡིན་ཏེ།",
