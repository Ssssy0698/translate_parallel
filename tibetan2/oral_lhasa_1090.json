    "ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱིས་འོད་གསལ་བའི་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་ཐམས་ཅད་རྣམ་པར་སྦྱངས་པའོ།",
    "དེའི་ཕྱིར་ཀུན་ནས་ཀུན་དུ་རྣམ་པར་དག་པའི་ཕྱིར་ལས་རྣམས་ཐམས་ཅད་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་སྦྱོར་བའི་ལས་ཐམས་ཅད་རང་བཞིན་གྱིས་འོད་གསལ་བའི་སྒྱུ་མ་དང་མཚུངས་པར་བསྒོམས་པའོ།",
    "སྔ་མ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པའི་རྣལ་འབྱོར་རམ།",
    "དེའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེ་ནས་སྔ་མ་བཞིན་དུ་ཐམས་ཅད་ཀུན་དུ་ཁྱབ་པར་རྣམ་པར་བསམས་ལཀྱེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ལས་ཕྱུང་ནས་ཕྱོགས་བཅུ་ཐམས་ཅད་དུ་རྡོ་རྗེ་ཧཱུཾ་མཛད་སྤྲུལ་པར་ལྟ་སྟེ།",
    "ཐམས་ཅད་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པར་གྱུར་ནས།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་བོའི་རང་བཞིན་དུ་རྣམ་པར་བསམས་ཏེ།",
    "སྔ་མ་བཞིན་དུ་གང་ཡང་རུང་བའི་གཟུགས་ཤིག་ལྐུབསྟན་པར་བྱས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་འབྲས་བུར་གྱུར་པ་དེ་བཞིན་དུ་ཐམས་ཅད་དུ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་རྒྱུད་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "སྔ་མ་བཞིན་དུ་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ལ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ངོ་བོ་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དེའི་སེམས་དང་སེམས་ལས་བྱུང་བའོ།",
    "ཡང་དང་ཡང་མངོན་དུ་བྱས་ན་གཟི་བརྗིད་ཅན་དུ་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་གསུངས་པའོ།",
    "སྔ་མ་བཞིན་དུ་ཐམས་ཅད་བྱས་ལ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་པ་དཀར་པོ་ལྕེ་ལ་རྣམ་པར་བསམ་པར་བྱའོ།",
    "གྲགས་པའི་ཕྱིར་འཇིག་རྟེན་ལས་གྲགས་པ་དེ་ལྟར་བརྗོད་པར་བྱའོ།",
    "ཞི་བ་རྣམས་རྗེས་སུ་གཟུང་བ་ལ་སོགས་པ་དེ་རྣམ་པར་བསམས་ཏེ།",
    "ངོ་བོ་ཉིད་ནི་སྒྲོ་འདོགས་པ་མེད་པ་གཉུག་མའི་བདག་ཉིད་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་ཀྱེཔ་སྤངས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཀྭ།",
    "དེ་ལྟར་གྱུར་པའི་འདོད་ཆགས་དེ་ལ་མུ་སྟེགས་ཅན་གྱིས་སྨད་པར་གྱུར་པའོ།",
    "ནི་ཞེས་བྱ་བའི་སྒྲ་ནི་ངེས་པར་གཟུང་བ་སྟེ།",
    "དེ་ནས་པདྨའི་རིགས་ཀྱི་ངོ་བོས་ཐམས་ཅད་དུ་ཁྱབ་པར་ཇི་སྲིད་བདག་ཉིད་ཀྱིས་མཐོང་བར་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་བསྒོམ་རྔུཔར་བྱའོ།",
    "བསྒོམས་པས་ནི་ཡང་དང་ཡང་མངོན་དུ་བྱས་པའོ།",
    "ཅི་ཞིག་གོམས་པར་བྱེད་ཅེ་ན།",
    "ཏིང་ངེ་འཛིན་བརྟན་པར་གྱུར་ནས་སྤྲོ་བར་བྱའོ།",
    "ཆོ་ག་བཞིན་ལྡན་ཁྱབ་བྱས་ནས།",
    "པདྨའི་རིགས་ཀྱི་གཟུགས་སུ་རྣམ་པར་བསམས་ལ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་སྣང་བརྙན་ཙམ་དུ་བདག་ཉིད་སྔ་མ་བཞིན་དུ་བསམ་པར་བྱའོ།",
    "ཅེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་ཀྱིས་དག་པ་ནི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་སྤངས་ནས་ངོ་བོ་ཉིད་ཀྱིས་དག་པའོ།",
    "ལྕེ་ལ་རྡོ་རྗེ་དཀར་པོ་རྣམ་པར་བསམས་ཏེ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་དམ་པའི་དངོས་གྲུབ་དེ་སྟོན་པར་བྱེད་པའི་སྒྲའི་ཚོགས་ལ་ཡང་རྒྱུད་ཅེས་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་ནོར་བུའི་རིགས་དེ་ཡང་དང་ཡང་མངོན་དུ་བྱས་པའོ།",
    "ན་ཞེས་བྱ་བའི་སྒྲ་ནི་ངེས་པར་གཟུང་བ་སྟེ།",
    "ཡང་དང་ཡང་མངོན་དུ་བྱས་པའོ།",
    "ནོར་བུའི་རིགས་ཀྱི་རང་བཞིན་དུ་རྣམ་པར་བསམས་ཏེ།",
    "ཡོངས་སུ་རྫོགས་པར་བྱེད་འགྱུར་ཞིང་།",
    "ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "དེ་ལྟར་བསྒྲུབས་པས་ཅི་ཞིག་ཐོབ་པར་འགྱུར་ཞེ་ན།",
    "ནམ་མཁའ་དང་མཚུངས་པའི་སོ་སོར་སྣང་བ་ནི་བདག་ཡིན་ནོ་ཞེས་ནོར་བུའི་རིགས་ཐམས་ཅད་ཀྱིས་ང་རྒྱལ་བསྐྱེད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་བསྒོམས་ནས་དེ་ནས་ནམ་མཁའ་ཐམས་ཅད་ནོར་བུའི་རང་བཞིན་དུ་མཐོང་ན།",
    "ཀྱང་ཞེས་བྱ་བ་ནི་ངེས་པར་གཟུང་བ་སྟེ།",
    "སྔ་མ་བཞིན་དུ་དོན་ཐམས་ཅད་གྲུབ་པའི་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ཏེ།",
    "དེའི་རྗེས་ལ་ཐམས་ཅད་བདག་ཡིན་ནོ་ཞེས་ང་རྒྱལ་བསྐྱེད་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་ཐམས་ཅད་དུ་སྦྱོར་བར་ཤེས་པར་བྱའོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་རྒྱུད་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "འདི་ཞེས་བྱ་བ་ཕྱིས་འཆད་པར་འགྱུར་བ་བློ་ལ་གནས་པའོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་རྣམ་པར་རྩེ་གཅིག་པ་ནི།",
    "དེའི་རྣལ་འབྱོར་པས་འདོད་པ་ལ་སྙོམས་པར་འཇུག་པ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་ཡིན་གྱི།",
    "རྡོ་རྗེའི་རིགས་ཀྱི་ནམ་མཁའ་ཁྱབ་པར་བསྒོམས་པ་ནི་ཆེན་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིའི་སྒྲ་ནི་ངེས་པར་གཟུང་བའོ།",
    "དེའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "འདི་ཞེས་བྱ་བ་ནི་པདྨའི་རིགས་ཐུགས་ལ་གནས་པ་གསུངས་སོ་བྱེ།",
    "རང་བཞིན་དག་པར་ཤེས་ནས་ཀྱང་།",
    "ཞེས་བྱ་བ་ནི་དེ་བཞིན་ཉིད་དེ་རྣམ་པར་ཤེས་པའོ།",
    "བྱིས་པས་ཉི་མ་མ་སྟོངས་པར།",
    "སྦྱིན་པ་ནི་གང་གང་སྦྱིན་པས་ཉི་མ་མ་སྟོངས་པར་ནོར་བུའི་རིགས་ཀྱི་རྣལ་འབྱོར་པས་ཅིའི་ཕྱིར་བྱེད་ཅེ་ན།"
  ]
}