    "དེ་ལྟར་བསྒོམས་ནས་ཕྱག་རྒྱ་གང་དུ་བསྟན་པར་གྱུར་པ་ན་གཏེར་གྱི་ལྷ་མཐོང་བའི་ཚུལ་གྱིས་གཏེར་ཡོད་པའི་ཕྱོགས་དེར་སྟོན་པར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་རིན་ཆེན་པདྨའམ་དེའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "སྔ་མ་བཞིན་དུ་བསྒྲུབས་པ་བྱས་ལ།",
    "ཇི་སྲིད་དུ་གཏེར་ཀྱི་ལྷ་དང་མཉམ་པར་སྦྱོར་བར་བསྒོམས་པ་དེ་སྲིད་དུ་གཏེར་མཐོང་བར་འགྱུར་རོ།",
    "དེའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "གཏེར་གྱི་ལྷ་དང་ལྷན་ཅིག་མཉམ་པར་སྤྱོར་བས་ཇི་སྲིང་།་",
    "དེ་ནས་གཏེར་ཀྱི་ལྷ་གྲུབ་པར་གྱུར་པ་དེས་གཏེར་སྟོན་པའི་དངོས་གྲུབ་ཏུ་འགྱུར་རོ།",
    "ཕྱག་རྒྱའི་འབྲས་བུ་བསྟན་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ནོར་བུའི་རིགས་ཆེན་པོའི་ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་བབེེབ་པོ་ཞེས་བྱ་བ་གསུངས་ལ།",
    "དོན་ཡོད་པར་གྲུབ་པའི་དཀྱིལ་འཁོར་ཆེན་པོའོ།",
    "དེ་རྣམས་ཀྱི་ཡེ་ཤེས་སུ་ངེས་པ་དེ་བསླབ་པར་བྱའོ།",
    "ཇི་ལྟར་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དང་།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རིན་ཆེན་འབེེབས་པའི་རང་བཞིན་གྱི་མཐར་ཐུག་པའོ།",
    "དེ་ནས་ཐཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་རྒྱ་ཆེན་བོ་རྣམས་ཀྱི་འབྲས་བུ་གསུངས་པ་ཡིན་ནོ།",
    "དེས་ཕྱོགས་བཅུ་ཀུན་ནས་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་སྤྱན་འདྲེན་པར་བྱེད་པའོ།",
    "སྟོབས་དང་མི་འཇིགས་པ་ལ་སོགས་པ་ཕྱེའཇིག་རྟེན་ལས་འདས་པའི་དོན་འཕྲོག་ཅིང་སྒྲུབ་སྣེཔར་བྱེད་པའོ།",
    "ནོར་བུ་བསྲུང་བའི་ཕྱག་རྒྱ་ཆེན་པོ་ནི་རིན་ཆེན་གོ་ཆ་བརྟན་པར་བྱེད་པ་སྟེ།",
    "འཛིན་པའི་རྣམ་པར་རྟོག་པ་འཇོམས་པས་ན་དེའི་ནོར་འཕྲོག་པའོ།",
    "དེ་མངོན་སུམ་དུ་བྱས་པས་དེ་བཞིན་གཤེགས་པའི་དངོས་གྲུབ་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་རིན་ཆེན་འགྲུབ་པར་འགྱུར།་།",
    "ཞེས་གསུངས་ཏེ།",
    "རྡོ་རྗེ་གཉིས་ལས་ནོར་བུ་བྱས།",
    "ཞེས་བྱ་བ་ནི་འབྲས་བུ་གསུངས་པ་ཡིན་ནོ།",
    "མཚན་ཐོག་ཐག་ཟློས་ཤིང་བཅོམ་ལྡན་འདས་མདུན་དུ་བཞག་ལ་བསྒོམས་པ་དེའི་ཚེ་རྡོ་རྗེ་འཛིན་པ་ཉིད་ཐོབ་པར་འགྱུར་རོ།",
    "གར་བྱས་སྤྱི་གཙུག་དབུས་གཞག་སྟེ།",
    "ཅི་ཞིག་སྦྱིན་པར་བྱེད་ཅེ་ན།",
    "དེ་ལས་མཐེ་བོང་རྡོ་རྗེ་བཅིངས་པར་འགྱུར་ཏེ།",
    "འདི་ནི་རྡོ་རྗེ་ནོར་བུར་གསུངས།",
    "མཇེ་ཆུང་རྣམས་ནི་པདྨོར་བྱས།",
    "རྡོ་རྗེ་བསྡམས་པ་དམ་བྱས་ལ།",
    "མདའ་འཕང་བའི་ཚུལ་དུ་བྱས་ལ་དྲངས་ཤིང་འཐེན་ནས།",
    "ཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་འདིའི་འབྲས་བུ་གསུངས་པ་ཡིན་ནོ།",
    "ཁ་འགྲམ་དགོད་པར་བསྐོར་བ་དེ།",
    "མདུན་དུ་ཁ་ཐུར་དུ་བསྟན་ལ་གཞག་པར་བྱའོ།",
    "ཁ་ནས་འདྲེན་པར་བྱས་པ་ནི།",
    "ང་རྒྱལ་ཀྱི་ནོར་གསུང་བས་འཕྲོག་ཅིང་འགུགས་པར་བྱེད་པ་སྟེ།",
    "གར་བྱས་གཙུག་ཕུད་དབུས་བཞག་ནས།",
    "མགྲིན་པའི་ཕྱོགས་སུ་འཁྱུད་པར་བྱ།",
    "རྡོ་རྗེ་བསྡམས་པ་དམ་བྱས་ལ།",
    "ཡི་གེ་ཧཱུཾ་ཁུརྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "རིན་ཆེན་འབེེབས་པའི་མཐར་ཐུག་པ་རྣམས་ལ་ཁྱད་པར་ནི་འདི་ཡིན་ཏེ།",
    "རིན་ཆེན་ཕྱག་རྒྱ་གཉིས་བྱས་ལས།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ལས་ཀྱི་ཕྱག་རྒྱའོ།",
    "བསམ་པ་གཡོས་པས་འདུད་པར་བྱ།",
    "དེ་ཁོ་ན་ཉིད་སྣང་བར་བྱེད་པ་ལས་དོན་ཐམས་ཅད་གྲུབ་པར་བྱེད་པའི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཙོ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རྡོ་རྗེ་རིན་ཆེན་ཆར་འབེེབས་མའི་མཐར་ཐུག་པ་གཉིས་སུ་མེད་པའི་དྲན་པ་དང་།",
    "ཤེས་རབ་ཡང་དག་པར་ལྡན་པའི་སེམས་སོ།",
    "དེས་བྱེན་གྱིས་བརླབས་པ་ནི་བརྟན་པར་བྱས་པའོ།",
    "ཨོཾ་སཏྠ་ཨ་བྷེ་ཥེ་ཀ་པཱུ་ཛ་ས་མ་ཡ་ཧཱུཾ་ཞེས་བྱ་བ་ནི་མཐར་ཐུག་པའི་གཞུང་འདི་ཙམ་གྱིས་༥ནི་ནོར་བུའི་རིགས་ཀྱི་གཟུངས་ཀྱི་པྱ་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་བསྡུ་བ་དང་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ལས་ཀྱི་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གསུངས་པ་ནི་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "གསུངས་པ་ཡིན་ནོ།",
    "ཕྱག་རྒྱའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དམ་པར་མཆོག་ཏུ་གྱུར་པའོ།",
    "ནམ་མཁའི་ཕྱོགས་ནས་ཕབ་སྟེ་གཞག་པར་བྱའོ་ཞེས་བྱ་བ་འདི་ནི་ཚུལ་བཞིན་དུ་ཞེས་བྱ་བའི་དོན་ཡིན་ནོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་གནས་པ་ནི་ཁྲི་ལ་བཞུགས་པ་སྟེ།",
    "མདུན་དྲང་པོར་བྱས་ནས་ཤར་ཕྱོགས་རྡོ་རྗེ་སེམས་མའི་གནས་སུ་བྲི་བར་བྱའོ།",
