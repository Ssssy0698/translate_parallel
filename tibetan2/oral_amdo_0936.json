    "བྱ་བ་ནི་རྣ་བ་དང་སྒྲའི་རང་གི་ངོ་བོ་ལྟར་རོ།",
    "ཤེས་པ་རྟག་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "སྤྱོར་བ་ནི་གང་རེས་འགའ་བ་དེ་ནི་སྐྱེ་བ་དང་ལྡན་པའི་རྒྱུས་བསྐྱེད་པར་བྱ་བ་ཡིན་ཏེ།",
    "སྒྲའི་ཤེས་པ་ཡང་རེས་འགའ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "ནུས་པ་ངེས་ཕྱིར་ཡང་ཞེས་བྱ་བའི་ཡང་གི་སྒྲ་མི་རྟམངོན་བྱེད།",
    "རེས་འགའ་སྒྲ་འདི་རང་བཞིན་གྱིས་ཤེས་པ་སྐྱེད་པར་རུང་བ་ཡིན་ནམ་མ་ཡིན་ཞེས་བྱ་བའི་ཕྱོགས་གཉིས་སོ།",
    "འདི་སྙམ་དུ་ནུས་པ་ཡང་འགལ་བའི་རྐྱེན་གྱི་སྟོབས་ཀྱིས་རེས་འགའ་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་མི་བྱེད་པ་དེ་བཞིན་དུ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཉམས་པ་དང་སྐྱེད་པར་ཁས་ལེན་ན་ཡང་རྟག་པ་ཉིད་ཉམས་པར་ཐལ་བར་འགྱུར་རོ།་།",
    "གང་གི་ཕྱིར་རང་གི་རྒྱུ་ལས་སོ་སོར་ངེས་པའི་རྣམ་པར་ཤེས་པ་སྐྱེད་པའི་ནུས་པ་ཉིད་ཉེ་བར་སྐྱེ་བ་ཡིན་ཏེ།",
    "གང་གི་ལྟར་ན་སྒྲ་ལེགས་པར་བྱས་པ་དེའི་ཇེལྟར་ན་སྐྱོན་འདི་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "འོན་ཀྱང་ཐོས་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་རོག་གི་དྲི་བར་བསྟན་ཏོ།",
    "གལ་ཏེ་ལེགས་པར་བྱས་པས་སྐྱེ་བ་ཡིན་ན་དེའི་ཚེ་སྒྲ་ཡང་སྐྱེ་བར་ཐལ་བར་འགྱུར་ཏེ།",
    "སྒྲ་བྱེད་པ་པོ་མ་ཡིན་པས་ཤེས་བྱ་མ་ཡིན་པ་ཉིད་དུ་ཐལ་ལོ།",
    "ཡང་ཅི་སྟེ་ཇི་ལྟར་ཁྱེད་ཅག་གིས་སོ་སོར་ངེས་པའི་ཤེས་པ་སྐྱེད་པར་ནུས་པའི་སྒྲ་སྐྱེ་བ་དེ་བཞིན་དུ།",
    "འདི་ལྟར་གལ་ཏེ་ཤེས་པ་སྐྱེད་༡༡པར་རུང་བའི་ཤེས་པ་མི་སྤོང་བ་དེའི་ཚེ་ཐམས་ཅད་ཀྱི་ཚེ་ཤེས་པ་བསྐྱེད་པར་ཐལ་བར་འགྱུར་ལ།",
    "ཅི་སྟེ་སྤོང་ན་དེའི་ཚེ་མི་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "གང་དག་གི་ལྟར་ན་སྐྱེ་བ་ཡིན་པའི་ཕྱོགས་དེ་དག་གི་གང་ཡང་རུང་བ་མ་ཚང་བ་རིགས་པ་ཡིན་གྱི།",
    "དེ་དག་གི་ལྟར་ན་སྔ་མའི་ལེགས་པར་བྱས་པའི་རང་བཞིན་རྟག་ཏུ་རྗེས་སུ་འཇུག་པའི་ཕྱིར་རོ།",
    "འཕོ་འགྱུར་ཕྱིར་ཞེས་བྱ་བ་ནི་མི་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་༤ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟ་ན་ཡི་གེ་གཞན་རྟོགས་པ་པོ་གང་དག་ཡིན་པ་དེ་དག་གིས་སྒྲ་ཐོས་པར་མི་འགྱུར་རོ།",
    "གང་དག་ཡི་ཀེ་གཞན་རྟོགས་པ་པོ་དེ་དག་གི་ཤེས་པ་སྐྱེད་༦པར་རུང་བ་སྒྲ་དང་རྣ་བ་དག་གིས་ལེགས་པར་བྱེད་པ་གཞན་ཡང་འགྱུར་བ་ཉིད་དོ་སྙམ་ན་ཞེས་བྱ་བ་འདི་དོགས་པ་བསུ་ནས།",
    "རྟོགས་པ་པོ་གཞན་དག་གིས་གཟུང་༡བ་གང་དག་ཡིན་པའོ།",
    "དེ་དག་གི་རྣམ་པར་ཤེས་པ་དེ་ལ་རུང་བ་ཞེས་བསྦུའོ།",
    "ག་ལ་སོགས་པའི་ཡི་གེ་ཕྱིས་གཞན་དག་གིས་ཐོས་པ་དེའི་ཚེ་ཡང་གང་དག་གིས་སྔར་ཐོས་པ་དེ་བཞིན་དུ་དེ་དག་གིས་ཀྱང་ཐོས་པར་འགྱུར་ཏེ།",
    "ཅི་སྟེ་རྗེས་སུ་མི་འཇུག་ན་དེའི་ཚེ་མི་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བར་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟ་ཡིན་དང་གང་ཞིག་ཆུའི་ནང་ན་གནས་པའི་ངོ་བོར་མཐོང་བ་འདི་ནི་རེ་ཞིག་ཤེས་པའི་རྣམ་པ་ནི་མ་ཡིན་ཏེ།",
    "ཉི་མ་མི་འཛིན་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གིས་དེ་ལྟར་སྣང་བར་འགྱུར་བ་ཉི་མ་ཆུའི་ནང་ན་གནས་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "ཅི་སྟེ་ཡང་ཉི་མ་དེ་ཉིད་ཡུལ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་གཞན་ཉིད་དུ་རྟོགས་པ་འབའ་ཞིག་ཏུ་ཟད་པས་དེའི་ཕྱིར་གཏན་ཚིགས་མ་གྲུབ་པ་ཉིད་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ཉིད་གཞན་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་སྤྱི་རྟོལ་ཅན་གྱེ་རྟོག་གེ་པ་ཁྱེད་ཅག་ལས་གཞན་སུ་ཞིག་གིས་བརྗོད་པར་འོས།",
    "འདི་ལྟར་དེ་ཉིད་ཅེས་བྱ་བ་འདིས་ནི་རང་གི་དེའི་ངོ་བོ་བསྒྲུབ་པར་བརྗོད་ལ།",
    "དེ་ཇི་ལྟར་གཅིག་ལ་༤གཅིག་གི་ཚེ་ཕན་ཚུན་འགལ་བ་བསྒྲུབ་པ་དང་དགག་པ་གཉིས་རིགས་༥པ་ཡིན།",
    "དེ་ལྟ་མ་ཡིན་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་བདག་གིས་བརྒྱུད་ནས་གཏོད་པའི་སྟེང་ན་གནས་པའི་ཉི་མ་ལོག་པར་རྟོག་པ་མ་ཡིན་ན་ཅིའི་ཕྱིར་ལོག་པ་ཉིད་དུ་མཐོང་གི་སྟེང་དུ་མ་ཡིན།",
    "གཞན་དུ་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རལ་གྲི་ལ་སོགས་པའི་རྟེན་གྱི་བྱེ་བྲག་གི་༧གཟུགས་བརྙན་རིང་པོ་ལ་སོགས་པའི་བྱེ་བྲག་གི་རྣམ་པར་སྣང་སྟེ།",
    "ཇི་ལྟར་སོར་མོས་ཅུང་ཟད་མནན།",
    "གཟུགས་བརྙན་དངོས་པོར་ཡོད་པ་ཡིན་དུ་ཆུག་མོད་དེ་ལྟ་ན་ཡང་དེ་མཚུངས་པའི་བློའི་རྟོགས་༡པར་བྱ་བ་ཉིད་དུ་མ་གྲུབ་བོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཅི་སྟེ་ཡང་ཡུལ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་ཐ་དད་ན་ཡང་དོན་དམ་པར་གཅིག་ཉིད་དུ་འགྱུར་ན།",
    "རང་གི་ཁ་དང་།",
    "སྣ་ཚོགས་ཐམས་ཅད་དངོས་པོ་ཉིད་ཡིན་པའི་ཕྱིར་ལྷན་ཅིག་སྐྱེ་བ་དང་འཇིག་པ་ལ་སོགས་པར་ཐལ་བར་འགྱུར་བ་ཡང་བཟློག་པར་དཀའ་བ་ཉིད་དོ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་གཉིས་པ་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་ལས་མ་དམིགས་པའི་ཕྱིར་མེད་པ་༡ངེས་པས་བདག་ཉིད་དུ་གྲུབ་པའི་སྒོ་ནས་ཉི་མ་བདག་གི་སྟེང་ན་གནས་སོ་སྙམ་པ་འདི་འཁྲུལ་པའི་ཤེས་པར་ངེས་པར་གཟུང་༢སྟེ།",
    "གང་གིས་ཡུལ་ཐ་དད་པས་ཐ་དད་པ་ཉིད་འཁྲུལ་པར་འགྱུར་བ་དེ་ལྟར་སྒྲ་གཅིག་པ་ཉིད་དུ་གྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "བར་ཞེས་བྱ་བ་ནི་མྱུར་བ་དང་བར་མ་དང་དལ་བ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་སོ་སོ།",
    "མངོན་སུམ་འབའ་ཞིག་ཅེས་བྱ་བ་ནི་དེའི་ཚེ་ཡང་དྲུག་སྐྱེས་ལ་སོགས་པའི་བྱེ་བྲག་གིས་གསལ་༧བར་སྣང་བ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཚེ་དེ་ཉིད་སྲིད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "བཏང་ན་ཡང་རྟག་པ་ཉིད་ཉམས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རེག་བྱ་མེད་པ་ཙམ་ཉིད་ལ་དེ་གདགས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱེད་ཅག་གི་དོན་དམ་པ་པའི་སྒྲ་དང་དོན་དག་གི་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་དངོས་པོ་མེད་པར་ཐལ་བར་འགྱུར་བར་བྱེད་ན་དེའི་ཚེ་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་རིགས་དང་རང་གི་མཚན་ཉིད་ལ་སོགས་པའི་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པ་ཉིད་རྒྱས་པར་སྒྲའི་དོན་བརྟགས་༡པར་བསལ་ཟིན་ཏོ།",
    "ཡིན་ན་ཡང་དོན་འགའ་ཞིག་རང་བཞིན་གྱིས་རྣམ་པ་གཅིག་ཏུ་རྟོག་པའི་ཤེས་པའི་རྒྱུ་ཉིད་དུ་བསྒྲུབ་པས་ན་ཀུན་རྫོབས་ཀྱི་སྒྲ་དང་དོན་དག་གི་༤བརྗོད་ང་།",
    "གང་གི་ཚེ་བློ་རང་གི་སྣང་བའི་སྒོ་ནས་གཞན་གྱེ་ངོ་བོ་སྒྲིབ་པར་བྱེད་པ་ནི་དོན་ཅི་ལྟ་བ་བཞིན་དུ་མི་སྣང་བའི་ཕྱིར་རྣམ་པར་རྟོག་པ་ཅན་གྱི་བློ་དེ་ཀུན་རྫོབ་ཡིན་ལ།",
    "དེའི་ཕྱིར་དེས་རྣམ་པར་གཞག་པའི་ཕྱིར་སྒྲ་དང་དོན་དག་གིས་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པ་ཉིད་དུ་ཉུཀུན་རྫོབ་ཉིད་དུ་གནས་པ་ཡིན་གྱི།",
    "མྱུར་བ་དང་དལ་བའི་བྱེ་བྲག་ལ་སོགས་པའི་བྱེ་བྲག་གིས་བློ་ཐ་དད་པའི་ཕྱིར་རོ་ཞེས་སྦྱར་བར་བྱའོ།",
    "དེ་དག་གི་ཤེས་པ་སྟེ།",
    "རྟག་པ་ཉིད་དུ་ཁས་བླང་གིས།",
    "མི་རྟག་པར་འགྱུར་བ་སྒྲ་དང་དོན་དག་གི་འབྱེལ་པ་དངོས་པོ་བ་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འབྲེལ་པ་མེད་པར་ཡང་སྟོན་རྔོ་པར་བྱེད་པ་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་གང་གི་རྟགས་ཀྱིས་དེ་སྟོན་པར་བྱེད་པ་བརྗོད་པར་འདོད་པ་དང་ལྷན་ཅིག་དེ་དང་འབྱེལ་པ་གང་ཡིན་ཞེ་ན།",
    "སྒྲ་རྣམས་བརྗོད་པར་འདོད་པ་དེའི་འབྲས་བུ་ཉིད་དུ་བདག་ཉིད་ལ་མངོན་སུམ་དང་མི་དམིགས་པ་དག་གིས་ངེས་པའི་ཕྱིར་རྒྱུ་དང་འབྲས་བུའི་མཚན་ཉིད་འབྱེལ་པ་ཡིན་ནོ།",
    "གང་གིས་རྒྱུ་དང་འབྲས་བུ་ཡི།",
    "བརྡ་འདི་བྱས་པ་ན་ཕྱིས་ཐ་སྙད་ཀྱི་དུས་ན་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་རྟོག་༡པའི་རྒྱུར་འགྱུར་ན་གང་གི་ཕྱིར་ཐབས་དེ་ཉིད་ཡོད་པ་མ་ཡིན་ཏེ།",
    "སྒྲའི་ཐ་སྙད་འདི་ཐམས་ཅད་རང་གི་སྣང་བའི་རྗེས་སུ་བྱེད་པ་ཉིད་དུ་འདོད་དེ།",
    "སྐབས་ལ་སོགས་པས་དོན་གྱི་ཁྱད་པར་སྟོན་པས་རང་གི་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་རིགས་ནས་བརྡ་༦བྱེད་པའི་ཕན་ཚུན་བསྟེན་༧པ་ཉིད་མ་ཡིན་ནོ།་།",
    "དེ་ལྟ་བས་ན་འདི་ལ་ཁྱེད་ཀྱི་ལན་གང་ཡིན་པ་དེ་ཁོ་བོ་ཅག་གིར་ཡང་འགྱུར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་སྙམ་ན།",
    "དེ་ཉིད་ལ་བརྡ་བྱེད་པ་ཡིན་གྱི་རང་གི་མཚན་ཉིད་ལ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་སྐྱེས་བུ་དང་སྤྱོར་བ་རེ་རེ་ལ་དེ་དག་ཐ་དད་པའི་ཕྱིར་ཇི་ལྟར་སྨྲ་བ་པོ་དང་ཉན་པ་པོ་དག་གི་འབྱེལ་པ་ཐ་མི་དད་པར་རྟོགས།",
    "བརྡའི་དུས་སུ་བདག་གིས་བཟུང་བ་གང་ཡིན་པའི་སྒྲའམ་དོན་དེ་ཉིད་ཀྱིས་དོན་དེ་ཉིད་རྟོགས་པར་བྱའོ་སྙམ་དུ་སེམས་ལ།",
    "འདི་ནི་བརྡ་དང་ཐ་སྙད་དག་གིས་ཕྱིན་པ་སྟེ་ནོན་པ་ཡང་ཡིན་ལ་དུས་ཀྱང་ཡིན་པའི་ཕྱིར་དེ་སྐད་ཅེས་བྱའོ།",
    "དེར་ཁྱད་པར་ནི་རྒྱུ་དང་འབྲས་བུའི་ངོ་བོ་གཅིག་གིས་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "ཡང་དོན་དམ་པར་འབྱེལ་པ་གཅིག་ཉིད་དུ་ཅིའི་ཕྱིར་མི་འདོད་གང་གིས་བརྟགས་པ་ཁོ་ན་འདོད་ཅེ་ན་འདི་ལ་འབྱེལ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རེ་ཞིག་ཐ་དད་པ་རྣམས་ལ་ནི་མེད་དེ།",
    "ཐམས་ཅད་རང་གི་བདག་ཉིད་ལ་གནས་པ་ཉིད་ཀྱིས་མ་འཆོལ་བའི་ཕྱིར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བརྗོད་པ་རེ་རེ་ཉིད་ལའམ།",
    "བརྗོད་པ་རེ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་སྨྲས་པ་དེ་ལ།",
    "འབྱེལ་པ་རེ་རེ་ཐ་དད་དམ།",
    "རེ་རེའི་འབྱེལ་པ་གང་ཡིན་དེ།",
    "བློ་ཐ་དད་པར་ཐལ་བར་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "ཐ་དད་སྐད་ཅིག་གིས་འཇིག་ཕྱིར།",
    "དཔེར་ན་སྔོན་པོ་ལ་སོགས་པའི་སྐད་ཅིག་མ་མང་པོ་དག་གིས་མཐོང་ན་ཡང་ཐ་དད་པ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "རིགས་ཀྱི་རང་གི་ངོ་བོ་བཞིན་དུ་བུམ་པ་ལ་སོགས་པ་དེ་དག་ཀྱང་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཉི་ག་མ་ཡིན་པའི་ཕྱོགས་ལ་དངོས་པོ་ཉིད་ཉམས་པར་ཐལ་བར་འགྱུར་བ་དང་གཅིག་ལ་བསྒྲུབ་བྱེ་པ་དང་དགག་པ་མི་རུང་བའི་ཕྱིར་རོ་ཞེས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "ཉེས་པ་འདི་དག་ཅེས་བྱ་བ་ནི་འབྱེལ་པ་མི་སྒྲུབ་༤པ་དང་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་ཐལ་བར་འགྱུར་བའི་མཚན་ཉིད་དོ།",
    "མི་འདོད་ཅེ་ན་འདི་བྱ་བ་ནི་གཉི་ག་དང་གཉི་ག་མ་ཡིན་པའི་རང་བཞིན་གྱི་མཚན་ཉིད་ལ་སྔ་མ་བཞིན་དུ་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁྱེད་ཅག་གི་འབྱེལ་པ་ལ་ཐམས་ཅད་རིགས་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་ཁྱེད་ཅག་གིས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཕྱོགས་དང་པོ་ལ་ཐམས་ཅད་ལ་ཐམས་ཅད་ཅིག་ཅར་དོན་རྟོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དངོས་པོ་བྱས་པ་རྣམས་ནི་སོ་སོར་ངེས་པའི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པའི་རང་བཞིན་ངེས་པ་ནི་རང་གི་རྒྱུ་དང་རྐྱེན་རྣམས་ཡིན་པར་རིགས་ཏེ།",
    "གང་གི་ཕྱིར་དེ་སྲིད་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "གྲུགོ་བས་ཞེས་བྱ་བ་ལ་སོགས་པས་རེ་ཞིག་རྒྱས་པར་གཞན་གྱི་རི་ཥྤེདོགས་པ་བསུ་བ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་རེ་ཞིག་དང་པོར་མངོན་སུམ་གྱི་སྒྲ་དང་འབྱེལ་པ་ཆད་པར་བྱེད་པའི་སྨྲ་བ་པོ་དང་བརྗོད་པར་བྱ་བ་སྟེ་བརྗོད་བྱའི་༥དངོས་པོ་མཐོང་ལ།",
    "ཕྱོགས་གཉིས་པ་ལ་ཡང་སྒྲ་གཅིག་ལས་ཅིག་ཅར་སྐྱེས་བུ་ཐམས་ཅད་ལ་དོན་ཐམས་ཅད་རྟོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ཡིན་དང་སོ་སོར་ངེས་པའི་དོན་བྱ་བ་བྱེད་པར་སྒྲུབ་པར་བྱེད་པའི་དོན་ཊྭཱཐམས་ཅད་དང་ཐུན་མོང་བའི་སྒྲའི་འདོད་པའི་དོན་གྱི་ཡུལ་ཅན་ཉིད་ཀྱི་བརྡ་བྱེད་པས་བྱེད་དོ་ཞེས་བྱ་བ་འདི་ག་ལས་རྙེད་པ་ཡིན།",
    "གང་གི་ཕྱིར་གཞན་དུ་ཡང་བརྡ་ལས་སྒྲའི་སྒོ་ནས་ཐ་སྙད་འཇུག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་བསྟན་ཟིན་ཏོ།",
    "མ་བསྟན་པ་མ་ཡིན་མོད་ཀྱི།",
    "རྟག་པ་ནི་རིམ་༥དང་ཅིག་ཅར་དག་གིས་༤དོན་བྱེད་པ་འགལ་བའི་ཕྱིར་དེ་ཉིད་རིགས་པ་མ་ཡིན་པས་༧འདི་ནི་གྱི་ནའོ།",
    "རྗོད་པར་བྱེད་པ་གོའི་སྒྲ་ལེགས་པར་སྦྱར་བ་ཡོད་ན་ག་བ་རྨྱེལ་སོགས་པ་ལེགས་པར་མ་བྱས་པ་སྦྱར་བ་ལས་བ་ལང་གི་བློར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བརྗོད་ཀྱི་དེ་ཉིད་ལ་བྱུང་བ་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་བར་ཏི་ཧ་རི་ན་རེ་ཇི་ལྟར་བྱིས་པ་སློབ་པ་ནི།",
    "ཨ་མར་མི་གསལ་ཨ་མར་བརྗོད།",
    "ཁོ་བོ་ཅག་གིས་ཐམས་ཅད་རྒྱུན་ཆད་པའི་བདག་ཉིད་འཇིག་པ་ཡིན་པར་མ་བརྗོད་ལ་འབྱིན་པ་དང་སྡུད་པའི་བདག་ཉིད་ཀྱི་ཐོག་མ་མེད་པའི་སྐྱེས་བུ་ཡང་མ་ཡིན་ནོ།",
    "འགྲོ་བ་ཐམས་ཅད་ཐོག་མ་མེད་པའི་ཐ་སྙད་དང་ལྡན་ཏེ་ཐོག་མ་མེད་པའི་བག་ཆགས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པའི་མཐར་ཐུག་པའི་སྒྲ་ལས་བྱུང་བ་འཇུག་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཕྱིན་ཅི་ལོག་གི་དོན་རྟོགས་པ་ན་ཡང་རིག་བྱེད་འདི་གཞན་ཉིད་ཡིན་ནོ།",
    "འདི་ལྟར་རེ་ཞིག་ད་ལྟར་ཡུལ་ཐམས་ཅད་དུ་སྐྱེས་བུ་རྣམས་ཀྱིས་རིག་བྱེད་འདོན་པ་ལ་སོགས་པ་གཞན་དུ་བྱ་བར།",
    "ཚིག་རྣམས་དང་ངག་རྣམས་དང་ཡི་གེ་རྣམས་ཡིན་པས་དེ་སྐད་དུ་བརྗོད་ལ་དེ་དག་གི་རིམ་པ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་ཁྱོད་ཀྱི་༤བྱས་པ་ཉམས་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "གཞན་གྱི་བརྗོད་པ་དག་གིས་བྱེ་བརྗོད།",
    "དེ་དག་གི་སྒྲ་མངོན་གསལ་རྒྱུ།",
    "དེ་དང་འབྱེལ་པའི་རང་བཞིན་ཉམས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་གིས་ནི་གསལ་བྱས་ཡིན།་།",
    "དེ་ལྟ་མ་ཡིན་ན་དུ་མ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "རེ་ཞིག་འདིར་བསྡུས་པའི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "སྨྲ་བ་པོའི་རྒྱུད་ལ་ཡི་གེ་རེ་རེ་དེ་ཀུན་ནས་སློང་བའི་ཤེས་པ་སྔ་མའི་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་གྱིས་བསྐྱེད་པར་བྱ་བ་ཡིན་ཞིང་དེ་དག་ལས་ཡི་གེ་རྣམས་རིམ་པ་དང་ལྡན་པར་འབྱུང་སྟེ།",
    "དེས་ཉན་པ་པོའི་རྒྱུ་ལས་ཡི་གེ་སྔ་མ་སྔ་མ་འཛིན་པའི་ཤེས་པ་ལྷན་ཅིག་བྱེད་པ་ཅན་རང་གི་ཡུལ་ཅན་གྱེ་ཤེས་པ་རིམ་པ་དང་ལྡན་པར་དངོས་སུ་སྐྱེད་རྟེཔར་བྱེད་དོ།",
    "གང་དེ་དག་གིས་བསྐྱེད་པའི་༥ཉན་པ་པོའི་རྒྱུད་ལ་ཡོད་པ་ལ་ཡང་ལྟོས་ནས་རྒྱུ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་དེ་དག་གི་གོ་རིམས་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ཏེ།",
    "ཡན་ལག་གི་དོན་བརྗོད་པར་བྱ་སྟེ།",
    "གང་གི་བརྗོད་པར་འདོད་པ་ལས་བྱུང་བའི་བརྗོད་པར་འདོད་པ་ལ་སྟེ།",
    "དེའི་ཕྱིར་ཡི་གེ་ར་ལ་སོགས་པའི་བརྗོད་པར་འདོད་པ་ནི་གང་གི་བརྗོད་ལྐུཔར་འདོད་པའོ།",
    "དེ་ལྟར་རེ་ཞིག་སྨྲ་བ་པོའི་རྒྱུད་ལས་ཡོད་པའི་ཡི་གེ་ཀུན་ནས་སློང་བའི་ཤེས་པའི་རིམ་པ་ལས་ཡི་གེ་རྣམས་ཀྱི་སྐྱེ་བའི་རིམ་པ་འབྲས་བུ་ཉིད་དུ་བསྟན་ཏོ།་།",
    "དེ་དྲན་ཏེ་སྔ་མ་སྔ་མ་དྲན་པ་ལ་ལྟོས་ནས་ཉམས་སུ་མྱོང་བའི་ཤེས་པ་ལ་ཕྱིས་ཏེ་དུས་ཕྱིས་བདག་ལ་སྟེ་རང་གི་ཡུལ་ལ་དྲན་པར་བྱེད་དོ།",
    "འོན་ཏེ་ཇི་ལྟར་བྱེ་བྲག་ཏུ་སྨྲ་བའི་འགའ་ཞིག་གིས་བརྟགས་པ་བཞིན་དུ་མི་རྟག་པ་ཡིན།",
    "དེ་ལ་རེ་ཞིག་ཕྱོགས་དང་པོ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་ལ་རེ་ཞིག་ཕྱོགས་དང་པོ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་རེ་ཞིག་རྟག་པའི་ཕྱོགས་ལ་སུན་འབྱིན་པ་བསྟན་ཏོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་ཁ་ཅིག་འབྲས་བུ་ཚིག་བརྗོད་པས་ངག་གི་གསལ་བ་མི་རྟག་པ་ཡིན་པའི་ཕྱིར་བསྐྱེད་པར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་ཏོ།",
    "རྗོད་པར་བྱེད་པ་ཉིད་དུ་རྟོགས་ན་ཡང་ཡི་གེའི་ཡན་ལག་ཉིད་རྗོད་པར་བྱེད་ལ་རག་མོད།",
    "གལ་ཏེ་ཡན་ལག་རེ་རེ་དོན་དང་ལྡན་པར་གྱུར་ན།",
    "ཡན་ལག་གཅིག་རྟོགས་པ་ན་ཡང་ངག་གི་དོན་རྟོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "རེ་རེ་དོན་གཅིག་ཉིད་ན་ཡང་།",
    "གང་གི་དོན་དག་རྟོགས་པར་འགྱུར།",
    "སྒྲ་ཙམ་ཞིག་གིས་ལན་གཅིག་ཏུ།",
    "གལ་ཏེ་ཡང་སྒྲ་གཅིག་གིས་རིགས་སམ།",
    "ཁྱད་པར་གཞན་གྱི་རྒྱུ་རྔེད་པས་ནུས་པ་ཐ་དད་པ་བརྟགས་པ་དོན་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྣང་དུ་ཆུག་མོད།",
    "གང་གི་ཕྱིར་སྒྲ་ལས་མཇུག་ཐོགས་སུ་དོན་རྟོགས་པར་འགྱུར་བ་ཞེས་བྱ་བ་འདི་ནི་བྱིས་པའི་བར་གྱིས་རྟོགས་པ་ཡིན་ནོ་ཞེས་དོགས་ནརྗོ།",
    "འཇིག་རྟེན་པ་རྣམས་ཀྱིས་ཞེས་བྱ་བ་ནི་རང་གི་དོན་དེ་ལ་ཕན་པའི་རྐྱེན་ཡིན་ནོ།",
    "དེ་ནི་གཙོ་བོ་གཅིག་གི་ལུགས་ལ་འཐད་ཀྱི།",
    "གང་གིས་སྣང་བར་མི་འགྱུར་བ་དེ་དག་གི་ལུགས་ཀྱི་ཡི་གེ་རྣམས་འཇིག་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་འདས་པ་གནས་པ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་དེ་སྣང་བར་མི་རིགས་སོ་ཞེས་སྟོན་པ་ནི།",
    "དེ་ཇི་ལྟར་བ་ལང་གི་སྒྲ་བ་ལང་ཞེས་བྱ་བའི་གབྱུག་གི་རྣམ་པ་ཅན་གྱི་བློར་འགྱུར་ཞེ་ན།",
    "དེ་གཟུང་དོན་གཅིག་ཉིད་དག་གིས།",
    "དེ་དག་གི་དངོས་པོ་ནི་དེ་འཛིན་དོན་གཅིག་ཉིད་དེ་དག་གིས་གཅིག་ཏུ་བརྗོད་དོ།",
    "བློ་གཅིག་གིས་གཟུང་བར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "སྒོག་ཤལ་ལ་སོགས་པའི་དོན་གཅིག་གསལ་བར་བྱེད་པའི་ཕྱིར་བ་ལང་གི་སྒྲ་གཅིག་ཏུ་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་སྙམ་དུ་གསལ་བར་རྗོད་པར་བྱེད་པ་ཉིད་དུ་མ་གྱུར་མོད་ཡི་གེ་རྣམས་ཁོ་ན་རྟག་པ་ཉིད་ཡིན་པ་ན་དུརྗོད་པར་བྱེད་པའི་འགྱུར་ལ།",
    "རང་གི་ཚིག་ལ་སོགས་དང་འགལ།",
    "རང་གི་ཚིག་ལ་སོགས་པ་འགལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་དག་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་རང་གི་ཚིག་ལ་སོགས་པ་དང་འགལ་བའོ།",
    "རང་གི་འདོད་པས་བརྟགས་པ་ནི་མ་ཡིན་ཏེ།",
    "རྟག་པ་ནི་རིམ་དང་ཅིག་ཅར་བ་དག་གིས་དོན་བྱེད་པ་མི་རིགས་པའི་ཕྱིར་འབྱེལ་པ་གྲུབ་པོ།",
    "དེ་དག་གི་ལུགས་ཀྱིས་སོ་སོར་བརྟགས་པས་འགོག་པ་ལ་སོགས་པ་ཀུན་རྫོབ་ཏུ་ཡོད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་མཚན་ཉིད་ཉམས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་དངོས་པོ་རྣམས་དང་བྲལ་བ་གང་ཡིན་པ་དེ་ནི་སོ་སོར་བརྟགས་༦པ་སྟེ།",
    "དེ་ཡང་ལྡན་པའི་རྫས་རེ་རེ་ལ་ཐ་དད་པ་ཡིན་ནོ།",
    "འཇིག་པའི་བདག་ཉིད་ཡིན་དུ་ཟད་མོད།",
    "ནམ་མཁའ་ཡང་རེག་པར་བྱ་བ་མེད་པ་ཙམ་ཡིན་ཏེ།",
    "གྱོ་མོ་སྣང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཞེས་གང་སྨྲས་པ་དེ་ལ་དོན་གྱི་རང་གི་ངོ་བོ་གཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "སྐད་ཅིག་རེ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པས་གཞན་གྱི་ལུགས་ཀྱིས་སྒོན་མ་ལ་སོགས་པ་ལ་ཡང་དཔེ་བསྒྲུབ་བྱ་མ་ཚང་བ་ཉིད་དུ་དོགས་པར་བྱེད་དོ་༡༡།",
    "སྐད་ཅིག་རེ་རེ་ལ་འཇུག་པའི་ངང་ཅན་ནི་མ་ཡིན་ནོ།"
  ]
}