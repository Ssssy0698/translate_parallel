    "བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "བསམ་གཏན་སྤེལ་མས་འོག་མིན་འགྲོ།",
    "ལྔ་པོ་དེ་དག་དུས་དང་སྦྱོར་བ་དང་།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡི།",
    "ཁྱེད་ཀྱིས་གཙོ་བོར་འཛིན་མྱུ་ཤྭ་ལུའི་འགྲེལ་པ་ཡིན་འདུག་བཞིན།",
    "འཁོར་གྱི་ཁྱམས་ཀྱི་བཀོད་པ་ཡང་དེ་ཁོ་ན་བཞིན་དུ་གདའོ།",
    "བཅོམ་ལྡན་འདས་འཁོར་གྱི་ཁྱམས་འདི་རྒྱན་གྱིས་བརྒྱན་བཞིན་དུ་དགུང་བདུན་དུ་གནས་ཤིང་མི་གདའ་བར་མི་འགྱུར་བར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཀྱང་བཅོམ་ལྡན་འདས་ལ་སྒྱུ་མ་མཁན་བཟང་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དྲི་མ་མེད་པའི་བཀའ་ལུང་ལས་སྐུ་བསྐྱེད་ཆེ་ཞིང་ཐུགས་དྭངས་པར་འདུག་ཅེས་རབ་ཏུ་དགྱེས་པའི་ཉམས་དང་ཐུགས་གཉེར་ལེགས་པོ་གནང་དགོས་ཞེས་བརྩེ་བ་ཆེན་པོའི་བསླབ་སྟོན་ཡང་རྒྱས་པར་གནང་ཞིང་།",
    "གཟིམས་ཆུང་དུ་གཏེར་གསར་མགོན་ཁང་གསར་སྒྲིག་གནང་འདུག་པར་མངའ་གསོལ་གྱི་བསྐང་བ་དང་རབ་ཏུ་གནས་པའི་མེ་ཏོག་འཐོར་བར་མཛད་ཅིང་།",
    "ཉེར་གཅིག་ནས་བཟུང་གཙུག་ལག་ཁང་དུ་བཞུགས་ས་སྤོས་ཏེ་ལོ་མཇུག་དུས་རིམ་གྱི་ས་ཆོག་ནས་བཟུང་།",
    "ལོ་མཇུག་དུས་རིམ་གྱི་སྟབས་ཉི་ཤུ་ནས་གཙུག་ལག་ཁང་དུ་བཞུགས་གནས་སྤོས་ཏེ་ས་ཆོག་ནས་བཟུང་སྒྲུབ་པ་དང་ལས་སྦྱོར་གྱི་གདབ་ཁ་ཟོར་འཕེན་གཏོར་འབུལ་རྟེན་འདོག་བར་གྱི་སློབ་དཔོན་དུ་ཞབས་བསྐྱོད་ཅིང་།",
    "སྙན་དར་རྣམ་བཞག་སོགས་དང་ཁོང་རང་ལ་དད་ཅན་གྱིས་ཕུལ་བའི་དངོས་པོ་གང་ཡོད་སྤྲུགས་པ་ལྟ་བུའི་འབུལ་བ་རྒྱས་པ་དང་བཅས་ཏེ་ཚེ་ཆོག་དང་འབྲེལ་བའི་གཟིམས་ཆུང་བརྟན་བཞུགས་ཕུལ་ཞིང་།",
    "ཕུང་པོ་ལ་སོགས་པའི་དང་འདོགས་པ་དག་ལ་ཡང་དེ་བཞིན་དུ་སྦྱར་བར་བྱའོ་ཞེས་བྱ་བའི་གལ་ཏེཕུད་པའི་སྐལ་པ་མཉམ་པཉིདཀྱི་སྡུསཁྱད་པརོམེད་པ་ཞིག་མེདན་ཕན་ཚུན་ཁྱད་པར་ཐ་དད་པའི་ཕུང་པོ་རྣམས་ལ་བྱེ་བྲག་མེད་པར་ཕུང་པོ་ཕུད་པོཞེས་བྱ་བའི་བློ་འདུག་པ་དང་།",
    "མནོས་པ་ལྡན་པའི་དོན་གྱིསན་ཞེས་བྱ་བ་ནི་མཚུངས་པར་འདུག་པའིདོན་གྱིསན་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ནི་རྣམ་པར་ཤེས་པ་དཔལྷནཅིག་འདུག་པ་མ་ཡིན་ཏེ།",
    "པ་འདུག་པ་ལ་སྙོམས་པར་ཞུས་པ་རྣམས་དང་།",
    "ཕན་ཡོན་གྱི་འགྲེལ་པ་ནི་བོད་རྩོམ་ཟངས་མར་འདུག་ཅིང་།",
    "ངེས་པར་འཇམ་པའི་མལ་ཆ་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "དེ་དག་ཀུན་ལ་གསོལ་བ་བཏབ་ནས་སེང་ལྡེང་རང་བཞིན་སྲ་བའི་ཕུར་བུ་རྣམས་ཀྱིས་ས་ལ་གདབ།",
    "ཡང་རང་ཉིད་ལྷར་བསྐྱེད་ནས་ཞལ་དག་པ་བྱེད་པའང་མཐོང་སྟེ།",
    "ངེས་པར་འཇམ་པའི་མལ་ཆ་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་སྲུང་བ་བྱས་ནས་ནི།",
    "བསྲུང་རྒྱུ་ནི་འདིར་ཡང་རང་ལུས་ཉིད་ཡིན་པས་ཡན་ལག་དྲུག་ཅེས་པ་ལུས་ཀྱི་ཡན་ལག་ཉིད་ལ་འཇོག་པ་འཐད་ཀྱི།",
    "ཕྱིས་བྱུང་ཁ་ཅིག་ལྟར་དང་པོ་ལྔ་པོ་རང་ལུས་སྲུང་བར་འདུག་ཀྱང་ཕྱི་མ་འདི་ཕྱི་རོལ་ཏུ་བསྲུང་རྒྱུ་ཞིག་ཡིན་ནམ་སྙམ་ནས།",
    "དོན་ལ་མི་གནས་པ་ཤ་སྟག་ཏུ་འདུག་ཅིང་།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་དང་རྡོ་རྗེ་ཤུགས་གཅིག་པར་ཐང་བརྡོལ་བ་ཁྱེད་རྣམས་དེ་སྐད་སྨྲ་བ་དེ་གཞན་གྱི་སྐྱོར་བཟློས་རྟིང་མ་ཞིག་ཡིན་པ་འདུག་ལ།",
    "དེ་རྣམས་གཅིག་ལ་གཅིག་བྲིས་བཤུས་ལྟ་བུར་འདུག་ཀྱང་གཞན་རྣམས་ཀྱིས་རྒྱུད་འགྲེལ་གྱི་དོན་མ་ཤེས་ལ།",
    "བགེགས་རྣམས་བཅིངས་ཏེ་ཙོག་ཙོག་པུར་འདུག་པའི་སྤྱི་བོ་ནས་བཏབ་པས།",
    "ཕུར་བུ་དང་ཐོ་བའི་སྔགས་ཀྱིས་སྐབས་འདི་དག་ཏུ་སོ་སོའི་ཕྱག་རྒྱ་འཆའ་བའི་ལུགས་ཀྱང་འདུག་སྟེ།",
    "ཐུན་མཚམས་ཀྱི་ལྷའི་སྐབས་སུ་ཡང་བདག་འཇུག་རྒྱས་པ་ལེན་པའི་ལག་ལེན་ཡོད་ཉེན་གདའོ།",
    "ལུས་དང་བྲལ་བའི་མགོ་གཞུག་གཅིག་ཁོ་ན་འགོད་པ་མི་རིགས་ཞེས་པ་ནི་ཁྱེད་རང་ལ་ཡང་མཚུངས་ཏེ།",
    "པདྨའི་འདུག་སྟངས་ཟླ་གམ་གྱི་དབྱིབས་ཅན་ཏེ།",
    "འདི་ལ་བོད་རྣམས་འཇིག་རྟེན་ཁམས་མཉམ་གྱི་ཐ་སྙད་སྦྱོར་བར་འདུག་གོ།",
    "འགལ་བའང་ཆེར་མེད་པ་ལྟར་སྣང་ཡང་རྒྱུད་འགྲེལ་ལས་གསལ་བར་མ་གསུངས་ཤིང་རང་ལུགས་ལ་མི་བཞེད་དོ།",
    "རྒྱལ་བ་རིགས་ལྔ་ལ་ཡང་རང་རིགས་ཀྱིས་རྒྱས་བཏབ་རུང་བའི་སྐབས་ཤིག་ཀྱང་རྒྱུད་འདིར་གཏན་ནས་མེད་པ་ནི་མ་ཡིན་ནོ།",
    "བྱས་ན་སུས་རྒྱས་བཏབ་ཀྱང་གཞན་རིགས་སུ་མི་འགྱུར་ཞིང་རང་རིགས་ཉིད་དེ་ཀུན་ཁྱབ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡབ་རྡོར་སེམས་ལ་ཡུམ་དབྱིངས་ཕྱུག་མས་འཁྱུད་ཟེར་བ་སོགས་ཀྱང་རང་གང་སྨྲས་པར་ཟད་དེ་ལུང་དང་དངོས་སུ་འགལ་བའི་ཕྱིར་རོ།",
    "རང་བཟོའི་རྣམ་འགྱུར་དུ་ཤིན་ཏུ་གསལ་བ་ཕལ་གྱིས་གོ་བླ་བ་འདུག་ཅིང་།",
    "ལོགས་སུ་མ་བསྐྱེད་ཀྱང་རུང་བ་ཞིག་ཡིན་པར་འདུག་ཅིང་།",
    "དམིགས་གསལ་གྱི་ཁུངས་འཚོལ་ས་མ་རྙེད་པ་རྣམས་མནོ་བསམ་གང་སྨར་གྱི་སྟེང་ནས་བསྒྲིགས་པར་འདུག་པས།",
    "ཟླུམ་པོའི་འདུག་སྟངས་ནི།",
    "ཁྱེད་རང་ལྟར་ན།",
    "གང་མངལ་བཟུང་བའི་ཟླ་བ་དེ་ཉིད་ཕྱི་རོལ་ཀྱི་ཟླ་བ་དང་ཞག་དུས་གང་ལ་ཡང་མ་བལྟོས་པར་མ་རིག་པ་ཆུ་སྲིན་གྱི་ཟླ་བར་འཇོག་ཅིང་།",
    "དེ་ནས་ཟླ་བ་བརྒྱད་པ་ལ་གསང་བའི་འཁོར་ལོ་དང་སྤྱི་བོའི་འཁོར་ལོ་ཡང་རང་གནས་སུ་སླེབ་ཅིང་བྱ་བ་བྱེད་ནུས་སུ་གྱུར་པ་དང་།",
    "དེ་རྣམས་དག་པ་ས་གའི་འདུག་སྟངས་ལ་སོགས་པ་ལྔ་ཡིན་ལ།",
    "དེ་ལྟར་ན་ལྷ་སོ་སོ་རང་རང་དང་།",
    "ལྷ་རང་རང་སོ་སོའི་སྟེང་ཕྱོགས་ཀྱི་མདུན་ངོས་སུ་བྱོན་པར་གྱུར།",
    "གཡས་ཀྱི་ཐོ་བ་དྲིལ་བུར་བསྒྱུར་ཏེ་ལྷ་ཐམས་ཅད་ཀྱི་མདུན་དུ་འདུག་ཅིང་།"
  ]
