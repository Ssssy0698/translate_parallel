    "དེ་ལས་ཀྱང་མཁས་པ་རྣམས་རྩོམ་པའི་བྱ་བ་ལ་འཇུག་པའི་སྐབས་སུ་སྙན་ངག་གི་གཞུང་ཤིན་ཏུ་གལ་ཆེ་བ་ཡིན་ནོ།",
    "དེ་གཉིས་ཚུལ་ཐ་དད་པས་འདི་བཟོ་རིག་གི་ནང་ཚན་ངག་བཟོའི་གཙོ་བོར་གཏོགས་ཞེས་གསུངས་ཀྱང་།",
    "སྒྲ་དང་མངོན་བརྗོད་སོགས་ལའང་ཚུལ་ཐ་དད་པ་ཡོད་མོད།",
    "ཡུལ་སོ་སོའི་ལུགས་ཀྱི་མིང་དང་དེ་ལ་རྐྱེན་ནམ་ཕྲད་སོགས་ཚུལ་བཞིན་སྦྱར་བས་བརྗོད་བྱའི་དོན་ལེགས་པར་བརྡ་འཕྲོད་པར་བྱེད་པའི་རྣམ་བཞག་སྟོན་པའི་བསྟན་བཅོས་དེ་དག་རང་རང་གི་ལུགས་ཀྱི་ལུང་སྟོན་པའམ་སྒྲ་རིག་པར་འགྱུར་ཞིང་།",
    "བརྡ་འཕྲོད་པར་བྱེད་པའི་རྣམ་བཞག་སྟོན་པའི་བསྟན་བཅོས་དེ་དག་མིང་གི་རྣམ་གྲངས་དུ་མ་དང་ལྡན་པའི་ཆ་ནས་མངོན་བརྗོད་དང་།",
    "ཟློས་གར་ལ་ལུས་ཀྱི་འཆམ་སྟབས་དང་གླུ་དབྱངས་ལྟ་བུ་ལུས་ངག་གི་བཟོར་གཏོགས་པའི་ཆ་ཡང་ཡོད་མོད་ཀྱི།",
    "དེ་དག་སོ་སོ་རང་རང་གི་སྐད་ཀྱིས་རིག་པའི་གནས་ཐམས་ཅད་ཁོང་དུ་ཆུད་པའང་ཡོད་པས།",
    "གསུམ་པ་གཞུང་གི་དོན་ལ།",
    "འཇིག་རྟེན་མེས་པོ་གདོང་བཞི་པ་ཚངས་པ་ཆེན་པོའི་གདོང་གི་པདྨའི་ཚལ་གྱི་ངང་པའི་བུ་མོ་གང་ཞིག་རྣམ་པ་ཐམས་ཅད་དུ་དཀར་བའི་གཟུགས་དང་ལྡན་ཞིང་།",
    "ཤིས་པར་བརྗོད་པ་སྟེ་སྨྲ་བ་ངག་གི་བྱེད་པོ་དབྱངས་ཅན་མ་ནི་ངག་རིག་སྨྲ་བ་རྣམས་ཀྱི་ལྷག་པའི་ལྷ་ཡིན་པས་སོ།",
    "སྒྲ་དབྱངས་དེ་ལ་དགྱེས་པས་ལྷའི་ལོ་སྟོང་དུ་རྒྱ་མཚོ་དེར་གཟིགས་ཤིང་སྒྲ་དབྱངས་ཀྱི་དགའ་བ་ཉམས་སུ་མྱོང་བར་བྱས་པའི་ཚེ་གནས་དེར་ཚངས་པའི་གདོང་ཡབ་དང་རྒྱ་མཚོ་ཡུམ་གྱི་དོད་དུ་རྟེན་ཅིང་འབྲེལ་བ་ལས།",
    "སྲིད་པ་གསུམ་གྱི་བརྟན་གཡོའི་སྒྲ་དབྱངས་དང་དྭངས་བཅུད་འདུས་པ་ལས་ལྷ་མོ་དབྱངས་ཅན་མ་འཁྲུངས་པར་གྱུར་ཅིང་།",
    "ལྷ་མོ་དེ་འཇིག་རྟེན་གསུམ་ན་མཚུངས་ཟླ་མེད་པའི་གཟུགས་དང་ལང་ཚོ་དང་ཤེས་རབ་དང་སྤོབས་པ་རྨད་དུ་བྱུང་བ་འཇིག་རྟེན་གསུམ་གྱི་མཆོད་འོས་སུ་གྱུར་པ་ནི།",
    "གང་གི་ཚེ་འཇིག་རྟེན་འདིར་མི་འཚེ་བ་དང་།",
    "རྒྱ་མཚོའི་ལྷ་མོ་སྒྲ་ལྡན་ཞེས་བྱ་བ།",
    "རང་གི་སྐད་ཀྱིས་སྐད་ཀུན་ཚིམ་པར་བྱེད།",
    "ཚངས་པའི་བུ་མོ་ཡིད་ལས་བྱུང་བ་དེ།",
    "དཔལ་ལྷ་མོ་སྒྲ་དབྱངས་ལ་བསྟོད་པ་ལས།",
    "སྒྲ་འཇོམས་ཁྱད་པར་ཚིག་གིས་དོན་མཚོན་ཏེ།",
    "དབྱངས་ཅན་ཁྱོད་ཀྱི་མཐུ་སྟེ་བསམ་མི་ཁྱབ།",
    "རིག་པའི་གནས་ལ་མངའ་བརྙེས་ཚིག་གི་བདག།",
    "ལྷ་མོའི་མཆོག་སྟེ་འགྲོ་ཀུན་སྐྱོང་བར་དགྱེས།",
    "མི་བསླུ་མཆོག་ཁྱོད་རྣམ་གྲོལ་ས་ལ་བཞུགས།",
    "ཕྱི་རོལ་པ་དག་གིས་བྱེད་པོ་ཉེར་བཞི་འདོད་པའི་ནང་ཚན་སྨྲ་བ་ངག་གི་བྱེད་པ་པོ་དབྱངས་ཅན་མ་ཞེས་འདོད་དེ།",
    "ལྷ་མོ་དེ་ལ་དོན་གྱིས་འདུད་པ་སྟོན་པའི་ཤིས་བརྗོད་མཛད་པ་ཡིན་ལ།",
    "ངང་པའི་བུ་མོ་ནི་དབྱངས་ཅན་མའི་མཚན་དུའང་རུང་ཞིང་།",
    "དེ་ལྟར་རྡོ་རྗེ་སྒྲ་དབྱངས་ལྷ་མོ་དེ་ནི་འཆད་ཉན་གྱི་སྐབས་སུ་འཆད་ཉན་བྱེད་པ་པོའི་ཡིད་ལ་གནས་པར་སྨོན་པར་ཡང་འགྱུར་རོ།",
    "སྙན་ངག་སྨྲ་བའི་སྔོན་གྱི་སློབ་དཔོན་ར་མ་ཤ་མ་སོགས་ཀྱི་སྙན་ངག་གི་བསྟན་བཅོས་སྔ་མ་རྣམས་ཀྱི་དོན་མ་ལུས་པ་ལེགས་པར་བསྡུས་ཤིང་།",
    "རྒྱན་གྱི་དཔེར་བརྗོད་ཀྱི་ཚིག་གི་སྦྱོར་བ་རྣམས་ཀྱང་ཉེ་བར་མཚོན་པའམ་གསལ་བར་བྱས་ཏེ།",
    "བློ་གྲོས་ཀྱི་མཐུས་ཇི་ལྟར་ནུས་པ་བཞིན་སྙན་ངག་དག་གི་མཚན་ཉིད་བརྗོད་པར་བྱའོ།",
    "བྱེ་བྲག་སྙན་ངག་གི་དགོས་པ་གཉིས།",
    "མཐོ་རིས་ལྷ་དང་མི་ཡུལ་དང་ས་འོག་གི་འཇིག་རྟེན་གསུམ་པོ་མཐའ་དག་འདི་ལྐུགས་པའི་ཚོགས་བཞིན་བླང་དོར་གྱི་བརྡ་སྤྲོད་པའི་སྨྲ་བ་མེད་པས།",
    "གནས་སྐབས་འཇིག་རྟེན་གྱི་དོན་རྣམས་དང་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་རྣམ་པར་བཞག་པ་སོགས་ཤེས་བྱ་མཐའ་ཡས་པ་གཞལ་ཞིང་གཏན་ལ་འབེབས་པ་འདི་ནི་མིང་ཚིག་ཡི་གེའི་རང་བཞིན་ཅན་ངག་གི་བརྗོད་པའི་དྲིན་ལས་བྱུང་བ་ན་ཡིན་ནོ།",
    "མཁས་པས་ཚིག་དང་དོན་གྱི་རྣམ་པ་ཡང་དག་པར་རབ་ཏུ་སྦྱར་བའི་ངག་ནི་འདོད་པ་འཇོ་བའི་བ་མོ་ལྟ་བུ་རུ་བཤད།",
    "ངག་ནི་ངག་གི་འདོད་འཇོར་བཤད།",
    "མིག་ཚག་པ་སོགས་སྐྱོན་གཅིག་གིས་ནི་སྐལ་བ་ངན་པར་འགྱུར་བ་བཞིན་ནོ།",
    "གང་ཚེ་སྐྱེ་བོ་སྙན་ངག་གི་བསྟན་བཅོས་སོགས་ཀྱི་མཚན་ཉིད་མི་ཤེས་པས།",
    "ངག་གི་ཡོན་ཏན་དང་སྐྱོན་དག་ཇི་ལྟར་དབྱེ་ནུས་ཏེ།",
    "ཇི་ལྟར་སྦྱར་ན་མཁས་པ་དེ་དག་གིས་ནི་སྙན་ངག་གི་ལུས་ནི་མིང་ཚིག་ཡི་གེ་ཚོགས་པའི་རང་བཞིན་ངག་གི་རྒྱུན་དང་།",
    "སྙན་ངག་གི་ལུས་རྣམ་པར་གཞག་པ་དང་།",
    "དང་པོ་སྙན་ངག་གི་ལུས་ནི་རེ་ཞིག་ཅེས་རྩོམ་པའི་སྐབས་དེར།",
    "ཕྱི་མོ་བགྲང་བ་ཛཱ་ཏི་ཞེས་རྣམ་པ་གཉིས་སུ་ཡོད་ལ།",
    "ཟབ་མོར་འཇུག་འདོད་རྣམས་ཀྱི་གྲུ་ལྟ་བུ་ཡིན་ཏེ།",
    "ཚིགས་བཅད་ཀྱི་དབྱེ་བ་དེ་རྣམས་སྣལ་མ་དང་སྣམ་བུ་ལྟར་སྙན་ངག་གི་སྦྱོར་བ་ཆེན་པོ་རྣམས་ཀྱི་གཞུང་གི་ཆ་ཤས་སུ་གྱུར་པའི་རང་བཞིན་ཡིན་ཕྱིར་འདིར་ལོགས་སུ་དཔེར་མ་བརྗོད་ཀྱང་དོན་གྱིས་ཤེས་པར་བྱ་བ།",
    "གཞན་དོན་སྤྱོད་པ་གང་གིས་ཡོན་ཏན་སྒྲུབ་པ་ཕུན་ཚོགས་རྣམས།",
