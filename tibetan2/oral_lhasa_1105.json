    "དེ་མཐར་ལྕགས་རི་རིམ་པ་མང་པོར་བྱས།",
    "ལྐོག་ཏུ་ངན་བགྲོས་བྱས་ཏེ་རྒྱལ་པོ་ལ།",
    "འགྲན་རྒོལ་བྱས་ནས་རྒྱལ་སྲིད་འཕྲོག་འདོད་དེ།",
    "ཕྱི་ཚུལ་རབ་བྱུང་ཟོལ་གྱིས་གཡོ་ཐབས་བྱས།",
    "རྒྱལ་པོར་འཐབ་པའི་དོན་དུ་བྱས་སོ་ཟེར།",
    "དེ་སྐད་རྫུན་ཚིག་ལོག་ཞུ་བྱས་པས་ན།",
    "དེར་གནས་ཐམས་ཅད་དེ་དང་མཐུན་པར་སྨྲས།",
    "ཡུལ་ཕྱོགས་འདི་ནས་གཞན་དུ་སྤྱུགས་པར་གྱིས།",
    "ཞེས་པའི་བཀའ་བཞིན་དེ་ལྟར་བྱས་ནའང་།",
    "ཕན་ཚུན་གྲོགས་བྱས་གསང་ཆེན་བརྟུལ་ཞུགས་སྤྱད།",
    "ཁྱད་པར་རྒྱལ་པོ་ཉིད་ཀྱང་སྔོན་ལས་ཀྱིས།",
    "གྲོགས་བཤེས་སུ་གྱུར་རིག་སྔགས་བཟླས་བརྩོན་བྱས།",
    "མཛད་གནང་བརྟུལ་ཞུགས་གང་འདུལ་ངོ་ཙམ་སྤྲུལ།",
    "སློབ་དཔོན་དྷ་ནུ་སྐྲྀ་ཏ་ཞེས་བྱ་བཞུགས།",
    "དུར་ཁྲོད་ཚང་ཚང་འཁྲིགས་པར་སློབ་དཔོན་ནི།",
    "ས་ཡི་བུ་ཞེས་བྱ་བ་ལེགས་བཞུགས་དྲུང་།",
    "སློབ་དཔོན་ཉི་མའི་བུ་ཞེས་བྱ་བ་བཞུགས།",
    "གང་བཞུགས་དྲུང་ལས་དངོས་གྲུབ་མཆིལ་ལྡུམ་བསྒྲུབས།",
    "སློབ་དཔོན་ཤཾ་བཾ་ཀ་ར་བཞུགས་དྲུང་ནས།",
    "བར་རུ་ཙེ་སྟེ་མཆོག་སྲེད་ཅེས་བྱ་བཞུགས།",
    "སློབ་དཔོན་གཅེར་བུའི་མཚན་ཅན་བཞུགས་པ་ལས།",
    "དངོས་གྲུབ་གཏེར་གྱི་བུམ་པ་ལེགས་པར་བསྒྲུབས།",
    "སློབ་དཔོན་ངན་སྤོང་བྱ་བ་བཞུགས་པའི་དྲུང་།",
    "བྱས་ན་འདོད་པའི་དངོས་གྲུབ་མཐར་ཐུག་ལ།",
    "ཇི་བཞིན་མ་འབྱོར་ཕྱོགས་བསླད་པར་རིགས་ནས།",
    "བསྙེན་པར་རྫོགས་པའི་དངོས་པོ་ལེགས་མནོས་མཛད།",
    "བྱོན་བཞུགས་མཛད་ཏེ་སྐལ་ལྡན་ཅི་རིགས་ལ།",
    "ལོངས་སྤྱོད་འབྱོར་བ་ཀུན་ནས་རྒྱས་པར་མཛད།",
    "ལྷོ་ནུབ་མཚམས་ཡུལ་བཱ་ག་ལ་ཞེས་པར།",
    "དེར་ནི་མུ་སྟེགས་ལྷ་སྲུང་བྲམ་ཟེའི་རིགས།",
    "ཁྱད་པར་བརྟན་པའི་ཕུར་བུ་གསུམ་བྱུང་བ།",
    "རཏྣ་ཤཱི་ལ་ཞེས་བྱས་བླངས་ནས་སུ།",
    "ཅུང་ཟད་བཞུགས་ནས་གནས་དེར་རྟེན་མཆོག་ནི།",
    "ངོ་མཚར་མཛེས་ཁྱད་རྫོགས་པ་ལེགས་པར་བཞེངས།",
    "ཆུ་ཚུར་ཁ་ནས་སློབ་དཔོན་ལེགས་བཞུགས་ཏེ།",
    "རྟགས་མཚན་བྱས་ཏེ་གདུལ་བྱའི་ཞིང་ཉིད་དུ།",
    "མཛད་སྒོའི་མཐའ་ནི་སུ་ཡིས་བརྗོད་པར་ནུས།",
    "རྒྱལ་པོ་ལ་སོགས་རྫུ་འཕྲུལ་གྱིས་དད་བྱས།",
    "ཁྱད་པར་འགྲོ་ལྡིང་བཏུལ་བའི་དུས་སྔ་ཕྱི།",
    "གང་འདུལ་མཛད་སྒོ་གནང་ཚུལ་ཐབས་མཁས་ཀྱིས།",
    "གངས་ལྗོངས་སུ་ཡང་བཞུགས་ཡུན་རིང་ཐུང་ནི།",
    "མཁའ་མཉམ་རྟག་བཞུགས་མཛད་ཕྲིན་ཅིག་ཆར་བ།",
    "བཞུགས་སུ་གསོལ་ནས་ཟླ་བ་བཞི་ཡི་རིང་།",
    "ཞང་བློན་རྣམས་ཀྱང་ཐབས་ཀྱིས་བྲིད་བྱས་ནས།",
    "དེ་སྐད་གསུངས་ནས་གསེར་ཕྱེ་གང་ཕུལ་ལས།",
    "ལེགས་བཞེས་གསེར་ལྷག་བཙད་པོ་ཉིད་ལ་གཏད།",
    "ཕྱི་ངོར་བསྐྲད་པ་ལྟར་བྱས་ཡར་བཞུད་སྐབས།",
    "སྐྱེལ་ཐུང་མཛད་མཁན་བྱས་ནས་བལ་ཡུལ་བསྐྱལ།",
    "རྒྱ་ནག་ཡུལ་དུ་ཕོ་ཉར་ཆེད་མངགས་བྱས།",
    "རྗེས་སུ་རིམ་པར་བོད་ཡུལ་ཕྱོགས་ལ་ཕེབས།",
    "མྱུར་ནས་སྤྱན་དྲངས་ལྷ་སྲིན་ལེགས་བཏུལ་ན།",
    "བོད་ཕན་ཆེ་ཚུལ་གསུངས་ལྟར་སྤྱན་འདྲེན་པ།",
    "ཁོང་ཉིད་སྔོན་ཕེབས་རྫུ་འཕྲུལ་སྟོབས་ལ་བརྟེན།",
    "ལྷ་སྲིན་དེ་རྣམས་བཅིངས་ཤིང་དམ་ལ་བཏགས།",
    "གཙང་བོའི་ཆུ་ལ་བྱེའུ་ཟུལ་བྱེད་པར་རྒྱུ།",
    "ཁྱད་པར་འོ་ཡུག་ཐད་ཀྱི་ཕར་ཀ་ནས།",
    "མཛད་ཐབས་ཅི་འཚལ་ཞེས་གསུངས་སྐད་ཅིག་དེར།",
    "དེ་ནས་རུ་མཚམས་སུ་ཡང་ཕེབས་པའི་སྐབས།",
    "གནམ་དུ་ཕེབས་ཚེ་ཐང་ལྷ་འདུལ་དགོས་གསུངས།",
    "གནོད་སྦྱིན་ཆེན་པོ་དམར་ཐབ་འཚལ་ཞེས་གསུངས།",
    "དེ་འདུལ་དགོས་གསུང་དགོངས་པར་བཞུགས་ཆས་ཚེ།",
    "སྐུ་དངོས་མ་ཕེབས་ཀྱང་ནི་དེར་གནས་ཀྱི།",
    "སྐད་ཅིག་དེར་ནི་རང་སར་བསྡད་ནས་ལོག།",
    "དེ་ནས་རིམ་ཕེབས་གུ་རུ་ཁོང་ཉིད་ཀྱིས།",
    "བོད་དུ་མུ་སྟེགས་ཀྱིས་འགེངས་མཐའ་ངན་གསུངས།",
    "དེར་བཞུགས་རྫུ་འཕྲུལ་སྟོབས་ཀྱིས་བྲག་གོང་བཅད།",
    "གཞོང་བར་སླེབ་ཚེ་འཁོར་ལ་གྲོ་ཐོབ་གསུངས།",
    "མཁར་ནག་ཏུ་ཕེབས་གནས་བདག་ཀླུ་བཙན་ཞིག།",
    "ལེགས་བྱས་འཕྲུལ་དེ་གཞིག་མེད་ཤྭ་བ་བརྐོས།",
    "དེ་རུ་ལེགས་ཕེབས་བོད་རྗེ་བཙན་པོ་དང་།",
    "དེ་ལ་སློབ་དཔོན་ཞལ་ནས་འདི་ལྟར་གསུངས།",
    "ཕ་བོང་དེ་ཉིད་ཤག་ཏེར་གས་ཤིང་འཐོར།",
    "སློབ་དཔོན་མ་ཧཱ་གུ་རུ་གདན་ཕེབས་ཞུས།",
    "གནང་ཆེན་གཟིམས་མལ་བ་ཀུན་བལྟ་བར་འོངས།",
    "དབྱུག་སྐོར་གྱིས་བཙལ་ཞིབ་བརྟག་བྱས་པས་ཀྱང་།",
    "སྐུ་གཟུགས་ཐམས་ཅད་སྔར་བཞིན་འཁོད་པ་ལ།",
    "དམར་པོ་རི་ལ་ཐོག་འབེབས་ཐང་ལྷ་སྟེ།",
    "སྤྱོད་ཚུལ་ཇི་བཞིན་གབ་སྦས་མེད་པར་སྨྲས།",
    "དེ་ནས་སློབ་དཔོན་གུ་རུས་འདི་སྐད་གསུངས།",
    "ཕེབས་ནས་དེར་བཞུགས་ཚེ་ན་ཀླུ་རིགས་ཆེ།",
    "གསེར་ཕྱེ་དྲེའུ་ཁལ་བཅུ་བཞི་འབུལ་ལགས་ན།",
    "དེ་ནས་འབྲོས་པར་འདོད་ཚེ་ཡན་ལག་བཞིར།",
    "དེ་མ་ཐག་ནས་ཁོ་ཉིད་གངས་རྩེར་བསྡད།",
    "མི་འཇུག་ན་ནི་ངེས་པར་བསྲེག་གོ་གསུངས།",
    "ད་ལན་དགོས་གལ་ཆེ་ཚུལ་གསུངས་པའི་སྐབས།",
    "ཆབ་སྲིད་ཆེན་པོ་ཤ་སྟག་འབྱུང་ཞེས་གསུངས།",
    "ཕོ་ཐོང་ཟེར་བ་དེ་ལུགས་ལྟར་བྱས་པས།",
    "གཞན་ཡང་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་དང་།",
    "སློབ་དཔོན་ཞལ་ནས་འདི་ལ་ཚེགས་མེད་གསུངས།",
    "ཉིད་ཀྱིས་དགོངས་པར་མཉམ་བཞག་ཡུད་ཙམ་ནས།",
    "སྐབས་དེའི་དགོས་པ་གྲུབ་ཅིང་གཟུངས་མ་བྱས།",
    "དེར་མ་ཟད་པར་ཕྱིས་སུ་གཟུངས་མ་གཉིས།",
    "འཇིག་རྟེན་ལས་སྤངས་སྒྲུབ་ལ་ཞུགས་པར་གྱུར།",
    "མ་གསུངས་པ་ནི་གསང་སྒྲོག་འགོག་ཕྱིར་ཡིན།",
    "སྤྱིར་ནི་བོད་དུ་ཡུན་རིང་བཞུགས་ནས་ཀྱང་།",
    "ལྡན་པར་བྱ་བའི་ཐུགས་འདོད་ཆེ་ན་ཡང་།",
    "ཐིག་སྣ་བ་བྱས་གང་དགོས་བྱ་བ་བསྒྲུབས།",
    "ལན་གཅིག་སློབ་དཔོན་དྲུང་དུ་ཕྱིན་བྱས་ཏེ།",
    "གྲམ་པ་ཐམས་ཅད་ཞིང་སར་བསྒྱུར་བྱས་ནས།",
    "ཡར་ཆབ་གཙང་པོ་གང་བདེ་སྦུབས་སུ་འཇུག།",
    "ལེགས་བདེ་འོང་ངམ་ཉམས་སད་མཛད་པར་གསོལ།",
    "ད་ནི་ས་ཞིང་གང་བྱེད་སློབ་དཔོན་གསུངས།",
    "ལྐོག་ཏུ་གྲོས་ཆུང་བྱས་ནས་འདི་སྐད་ལོ།",
    "གསེར་ཕྱེ་བྲེ་གང་ཕུལ་ནས་ཕྱག་བསྐོར་བྱས།",
    "གསེར་འདོད་ན་ནི་འདི་ལྟར་བྱས་ཆོག་གསུང་།",
    "གསེར་ལྷག་བཙད་པོ་ཉིད་ལ་སླར་གནང་སྟེ།",
    "ཞེས་གསུངས་བློན་རྣམས་ཟེར་ལྟར་ཆད་སོ་བྱས།",
    "གསུངས་པ་ལྟར་གྱི་རྣམ་པར་ད་ལྟ་ཡོད།",
    "ཅེས་གསུངས་མན་ངག་མཐར་རྒྱས་མ་རྫོགས་ཏེ།",
    "འོན་ཀྱང་མ་འོངས་གནས་ཚུལ་ལེགས་མཁྱེན་པས།",
    "རྣལ་འབྱོར་ཐེག་ཆེན་འབྲས་བུ་སྤྱོད་པར་ཤོག།",
    "མ་བསད་བོད་ལ་བྱད་མ་བྱེད་པར་འོང་།",
    "ཞལ་ནས་ནངས་པར་འུ་ཅག་ལ་འཚེ་བའི།",
    "ཞེས་གསུངས་ཡུངས་དཀར་སྤར་གང་གཏད་ནས་སུ།",
    "རྒྱ་བོད་མཚམས་ཀྱི་རི་གཅིག་ཡིན་པར་བཞེད།",
    "བོད་དུ་བཞུགས་ཡུན་བཀའ་ཆེམས་རྦ་རྒྱལ་གཉིས།",
    "ཐོག་མར་གླིང་དེའི་བྲག་ཕུག་ཅིག་ཏུ་བཞུགས།",
    "སློབ་དཔོན་ཅི་གསུང་སྒྲུབ་པར་ཁས་བླངས་བྱས།",
    "གཟི་བརྗིད་མ་བཟོད་འབྲོས་པར་བརྩམས་པ་ལ།",
    "ཀླུ་གཉན་གདུག་ཅན་རྣམས་ཀྱང་ལེགས་པར་བཏུལ།",
    "ཉེ་བའི་ནགས་ཚལ་ཞིག་ཏུ་ལེགས་བཞུགས་ཏེ།",
    "རྒྱལ་པོ་ཁྲོས་ཏེ་ནངས་པར་དམག་དང་བཅས།",
    "པར་ཆས་པ་ན།",
    "གདམས་པ་མང་དུ་གསུངས་ཤིང་སྐལ་བ་དང་།",
    "རྫོགས་པའི་རིམ་དང་ལས་ཚོགས་མང་དུ་གསུངས།",
    "ཁྱད་པར་སྔགས་འཆང་མཁའ་འགྲོ་མ་རྣམས་ཀྱང་།",
    "སློབ་དཔོན་ཉིད་ཀྱི་སྐུ་ལ་བསྟིམ་བྱས་ནས།",
    "ཆེ་ཆུང་སློབ་དཔོན་ཐུགས་ཀྱིས་གང་བྱས་སུ།",
    "བསྒྱུར་ནས་གཞན་དུ་འབྲོས་པར་བརྩམས་པ་ན།",
    "སྒོ་གསུམ་ནུས་སྟོབས་མཐའ་དག་ཉམས་པར་བྱས།",
    "སློབ་དཔོན་ཉིད་ཀྱི་སྐུ་ལ་བསྟིམས་བྱས་ནས།",
    "ལོ་ནི་བཅུ་གཉིས་ལྷག་ཙམ་བཞུགས་ནས་ཀྱང་།",
    "དེར་ཕེབས་ཆས་ཚེ་ཐོག་མར་སློབ་དཔོན་གྱིས།",
    "སློབ་དཔོན་བླ་གོས་གཤོག་པའི་ཚུལ་དུ་བྱས།",
    "གདུལ་བྱ་གང་དག་བློ་མཐུ་དང་འཚམས་པར།",
    "རང་སྣང་འོག་མིན་ཞིང་ཁམས་འབྱམས་ཀླས་པར།",
    "རླབས་ཆེན་མཛད་ཕྲིན་ཕྱོགས་དུས་རིས་མེད་པར།",
    "ཁྱད་པར་བསིལ་ལྗོངས་ཡུལ་གྱི་སྐྱེ་འགྲོ་ཀུན།",
    "ཕྱོགས་འདིའི་ཆ་ནས་གཞན་ལས་ཁྱད་པར་ཆེ།",
    "མཁྱེན་རབ་གཏེར་དུ་ལེགས་བསྐྱེལ་ཁུངས་དང་ལྡན།",
    "གཞན་ཡང་རྙིང་བཀའ་མང་པོའི་ཞལ་མཐུན་པར།",
    "དེ་དག་དགོངས་པ་གུང་བསྒྲིགས་ཞིབ་གཏུགས་བྱས།",
    "ངོ་མཚར་གཏམ་རྒྱུད་བསྣན་པ་བྱས་ཆོག་ཅིང་།",
    "འདིར་མ་ཟད་པར་གཞན་ཡང་དག་སྣང་ཚུལ།",
    "འཚམས་པར་སྤྲུལ་བའི་ཟློས་གར་ཅིར་ཡང་རྩེན།",
    "དེ་ནས་རྒྱལ་པོས་མཇལ་ཏེ་སྲས་སྐལ་བྱས།",
    "ཁྲི་ལ་བཞུགས་ནས་མཆོད་བཀོད་དང་བཅས་ཏེ།",
    "སྤྲུལ་པའི་སྐུ་ཉིད་བཞུགས་སུ་གསོལ་ནས་ཀྱང་།",
    "དབུལ་བའི་སྡུག་བསྔལ་བསལ་ནས་ཚིམས་པར་བྱས།",
    "མཁའ་འགྲོ་འོད་འཆང་མ་ནི་ཁབ་ཏུ་བཞེས།",
    "མ་གནང་ཐབས་མཁས་ཚུལ་གྱི་རྩེད་གར་མཛད།",
    "ཟ་ཧོར་ཡུལ་དུ་ལེགས་བྱོན་དེར་བཞུགས་ཀྱི།",
    "རབ་བྱུང་ཚུལ་གྱིས་བསྙེན་པར་རྫོགས་པ་མཛད།",
    "དགེ་སློང་མ་ཡི་རྣམ་པར་ལེགས་བཞུགས་དྲུང་།",
    "ཚེ་རྒྱུད་བྱེ་བ་ཕྲག་བརྒྱ་ལེགས་གནང་བས།",
    "གུ་རུ་ཡབ་ཡུམ་གཉིས་བཞུགས་རྫུ་འཕྲུལ་བསྟན།",
    "བསོད་སྙོམས་ལ་ཕེབས་ཡུལ་མི་དེར་གནས་རྣམས།",
    "གཞན་ཡང་གུ་རུའི་རྣམ་པར་འཕྲུལ་བ་ཡང་།",
    "སྐུ་ལ་རྫོགས་སོགས་དུར་ཁྲོད་ཆེན་པོར་ཕེབས།",
    "མཛད་ཆེན་དེ་འདྲ་གནང་བའི་མཚན་སྙན་ཀྱང་།",
    "འདྲེ་སྲིན་མཐུ་བོ་ཆེ་གསུམ་བར་ཆད་བྱས།",
    "གཞན་ཡང་དུས་སྐབས་ཅི་རིགས་པར་ཡང་ནི།",
    "ད་ལྟའི་བར་དུ་དར་ཞིང་རྒྱས་པར་བཞུགས།",
    "འདི་ནས་ལྷོ་ནུབ་སྲིན་ཡུལ་དུ་བཞུད་པར།",
    "འཕགས་ཡུལ་ན་བཞུགས་བསྟན་འགྲོའི་དོན་མཛད་པར།",
    "འཇའ་ལུས་འོད་སྐུར་ངེས་པར་བསྐྱེལ་བས་མཚོན།",
    "དེ་འདྲའི་ངོ་མཚར་ཡེ་ཤེས་རྣམ་པར་འཕྲུལ།",
    "གང་འདུལ་འཚམ་པར་དེར་སྣང་སྒྱུ་འཕྲུལ་གར།",
    "གཅིག་ལེགས་བཞེས་དུས།",
    "རྣམས་ཀྱིས་བར་ཆད་བྱས་ནས་བརྩིགས་མ་སྟེར།",
    "སློབ་དཔོན་གྱིས་ཀྱང་དུས་མཁྱེན་བལ་ཡུལ་ནས།",
    "བོད་དུ་རིམ་པར་ཕེབས་པའི་ལམ་ཞོར་དུ།",
    "མང་ཡུལ་ནས་བཟུང་མངའ་རིས་དབུས་གཙང་དང་།",
    "མཇལ་འཕྲད་ཞལ་འཛོམས་མཛད་ནས་དགྱེས་སྤྲོ་བྱས།",
    "ལྷ་སྲིན་ཐམས་ཅད་བཀའ་འོག་ཏུ་བསྡུས་ནས།",
    "གླིང་གསུམ་དང་བཅས་ལེགས་པར་གྲུབ་ནས་སུ།",
    "རྒྱས་བསྟན་པ་གཟུགས་པར་བྱ་དགོངས་ནས།",
    "དཔག་མེད་གནང་ཞིང་སོ་སོར་ནུས་མཐུ་བརྙེས།",
    "སྤྱིར་ན་གུ་རུ་བོད་དུ་བཞུགས་པའི་ཚུལ།",
    "ལོ་གྲངས་བརྒྱ་དང་བཅུ་གཅིག་བཞུགས་ལྟར་ན།",
    "དེ་རྗེས་ལོ་ཤས་བཞུགས་པར་སྣང་ཚུལ་ལྟར།",
    "ལོ་བདུན་ཟླ་དྲུག་བར་དུ་བཞུགས་ཚུལ་བསྟན།",
    "བསམ་ཡས་སུ་ནི་ལོ་བརྒྱད་བཞུགས་རྗེས་སུ།",
    "དབུས་གཙང་སྟོད་སྨད་སྒྲུབ་གནས་ཉེར་གཅིག་ཚོགས།",
    "བསྟན་པ་བསྣུབ་པར་མཁྱེན་ནས་རྒྱལ་པོ་ལ།",
    "བཞེངས་ནས་བོད་ཀྱི་ལྷ་སྲིན་དྲེགས་པ་ཅན།",
    "སྐབས་ཤིག་ལྷ་སྲས་མི་རུབ་བཙད་པོ་བཏང་།",
    "ལྷ་སྲས་མི་ཏིག་བཙད་པོ་རྒྱལ་སར་བཀོད།",
    "གཉེར་གཏད་མཛད་ཅིང་ཁོང་ཉིད་མ་འོངས་པར།",
    "ཁོང་ལ་ནན་བཤོལ་བཏབ་ཀྱང་མ་ཐེབས་པར།",
    "མཁའ་དབྱིངས་ལམ་ནས་རྔ་ཡབ་གླིང་དུ་ཕེབས།",
    "དེ་ཡི་དོད་དུ་ལེགས་བཞུགས་སྲིན་པོ་འདུལ།",
    "རྟག་པར་རྒྱུན་མི་ཆད་པའི་ཕྲིན་ལས་ཅན།",
    "ཁྱད་པར་ཕྱི་ཚུལ་སྲིན་པོའི་གླིང་བརྒྱད་དུ།",
    "གང་འདུལ་རྣམས་ལ་རིས་སུ་ཆད་མེད་པར།",
    "བླ་ན་མེད་པའི་རིག་འཛིན་ས་ལ་བཞུགས།",
    "རཏྣ་པུ་རི་ཞེས་པར་རྒྱལ་པོ་ཡང་།",
    "རྒྱལ་པོས་རིགས་བསླད་པར་དགོངས་སློབ་དཔོན་ཉིད།",
    "ལྷ་ལྕམ་གང་ཉིད་ཕྱག་རྒྱར་ལེགས་བཞེས་ནས།",
    "འཇའ་ལུས་རྡོ་རྗེའི་སྐུར་བཞུགས་སྤྲུལ་བསྒྱུར་གཞན།",
    "ཡང་དག་ལྷ་དགུ་སྒྲུབ་པའི་གཟུངས་མར་གནང་།",
    "རྣམ་འགྱུར་འདོད་དགུར་བསྒྱུར་ཅིང་ཁྱད་པར་དུ།",
    "བལ་འབངས་ཀཱ་ལ་སིདྡྷིའི་རྣམ་པར་ཤར།",
    "སློབ་དཔོན་ཆེན་པོས་དེ་ཉིད་གདུལ་བྱར་མཁྱེན།",
    "ངེས་པར་གྲུབ་པ་ཨེ་མ་ངོ་མཚར་ཆེ།",
    "གུ་རུ་མཆོག་ཉིད་སྟག་ཚང་དུ་བཞུགས་སྐབས།",
    "བཀའ་གནང་ཇི་བཞིན་ཕྱག་རྒྱར་ཕུལ་བ་ལྟར།",
    "གྲུབ་རྟགས་བསམ་མི་ཁྱབ་བསྟན་ཁྱད་པར་དུ།",
    "འཁྲུངས་མ་ཐག་ནས་ཕྱེད་སྐྱིལ་པུས་བཙུགས་བཞུགས།",
    "ཞལ་ནས་དབྱངས་གསལ་ངོ་མཚར་ཚིགས་བཅད་གསུངས།",
    "རྩ་གསུམ་གཅིག་སྒྲུབ་ཐབས་གནང་ཏི་སྒྲོ་སོགས།",
    "སྒོ་གསུམ་གཙང་ཞིང་ཡང་དག་སྤྱོད་པའི་འབྲས།",
    "སྤྱིར་ན་དབུས་གཙང་ཕྱོགས་སུ་སྔགས་བཙུན་རིགས།",
    "སྦྱོར་བྱས་དགའ་བཞིའི་ཡེ་ཤེས་ངོ་འཕྲོད་ནས།",
    "ལུས་མ་སྤངས་པར་ཨོ་རྒྱན་ཡུལ་དུ་བཞུད།",
    "མང་ཡུལ་དུ་བྱོན་ལོ་གཅིག་བཞུགས་པའི་རིང་།",
    "ལྷ་སྲས་མུ་ཁྲི་བཙད་པོའི་ངའེ་གདན་ཞུས་ལྟར།",
    "རིག་པ་ཚད་ཕེབས་དེ་རྗེས་ཉི་ཤུ་ནས།",
    "དེ་བཞིན་དགུང་ལོ་ཉིས་བརྒྱ་བཅུ་གཅིག་བཞུགས།",
    "འོད་ཀྱི་འདོ་ལི་འོང་བ་ལ་བཞུགས་ནས།",
    "འདི་སྐབས་ལྷ་སྲིན་རྣམས་ཀྱིས་སློབ་དཔོན་ལ།",
    "སློབ་དཔོན་ཞལ་ནས་ཧཱུཾ་ཞེས་གསུངས་པ་ཡིས།",
    "ས་གཞི་ཐམས་ཅད་ལས་སུ་རུང་བར་གནང་།",
    "ལས་བྱས་པ་ལས་བྱུང་བའི་གྲུབ་འབྲས་ཀྱང་།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་བཀོད་པ་ཀུན།",
    "སློབ་དཔོན་ཆེན་པོས་བཀའ་ལུང་གནང་བ་ལྟར།",
    "སྒྲ་བསྒྱུར་སློབ་བཅུག་ཚེགས་མེད་ཇི་བཞིན་མཁྱེན།",
    "ཁྱད་པར་སྐ་ཅོག་རྨ་གསུམ་ཕོ་ཉར་བཏང་།",
    "ལྷ་སྲས་དམ་འཛིན་རོལ་པ་ཡེ་ཤེས་རྩལ།",
    "ལྷ་སྲས་ཆེ་འབྲིང་ཆུང་གསུམ་ཡང་།",
    "མུ་རིམ་སྤྲུལ་པ་ལྷ་སྲས་ལོ་ཙཱ་བ།",
    "ལྷ་སྲས་ཆུང་བ་མུ་ཏིག་བཙད་པོ་ལ།",
    "སྲས་ལྔ་བྱུང་བའི་ནང་ནས་ཁྱད་པར་བ།",
    "ཟ་ཧོར་རྒྱལ་པོའི་སྤྲུལ་པར་སློབ་དཔོན་གྱིས།",
    "བཅུ་གཉིས་གཏེར་སྟོན་རྐྱང་བའི་མཛད་ཚུལ་གནང་།",
    "ཁྱད་པར་སྡིག་སྤྱོད་རྒྱལ་པོ་གླང་དར་མའི།",
    "དེ་དུས་སླར་ཡང་སློབ་དཔོན་གྱིས་གསུངས་པ།",
    "སྲོལ་འཛིན་ཤིང་རྟ་ཆེན་པོའི་རྣམ་པར་བཞུགས།",
    "སྐུ་ནི་ཤིན་ཏུ་བཙུན་པའི་ཚུལ་དུ་བཞུགས།",
    "ཞེས་གསུངས་པ་དང་ངེས་པར་མཐུན་པ་སྟེ།",
    "ཚེ་ཡི་རིག་འཛིན་བརྙེས་པས་ཡུན་རིང་བཞུགས།",
    "ཉི་ཟེར་ལས་ནི་ཅི་དགར་གཤེགས་བཞུགས་མཛད།",
    "ལོ་ཙཱ་ལེགས་པར་སྦྱངས་ནས་རྒྱ་གར་ལ།",
    "མཁར་ཆུར་ཕེབས་དགོས་བྱུང་བའི་སྐབས་ཤིག་ན།",
    "ཕུག་པར་བཞུགས་ཚེ་གཅུང་པོ་ཁྱིམ་ཐབ་པ།",
    "འདི་གཏོར་ཞེས་གསུངས་རྡེའུ་མང་ཙམ་གནང་།",
    "གཅུང་བོས་བཀའ་བཞིན་བྱས་པས་ཡུལ་གཞན་ལས།",
    "དགྱེ་རི་སྤྱང་དམར་ཕུག་ཏུ་ལེགས་བཞུགས་སྐབས།",
    "དངོས་གྲུབ་ཡིན་པར་ཤེས་ནས་ཁྱིམ་དུ་ཁྱེར།",
    "ལྷོ་བྲག་མཁར་ཆུའི་ཕུག་རིང་ལ་སོགས་པར།",
    "ཡབ་ནི་སྟག་སྒྲ་ལྷ་སྣང་ཞེས་པ་དང་།",
    "བསྙེན་པར་རྫོགས་ཤིང་མཁྱེན་རབ་བསམ་མི་ཁྱབ།",
    "ཕྱིས་སུ་མངའ་བདག་རྒྱལ་པོ་དང་མཚུངས་པར།",
    "བྱོན་པས་གྲོགས་དེས་ལེགས་མཁྱེན་སླར་སྤྲུལ་པ།",
    "ཕྲིན་ལས་རྒྱ་ཆེར་བྱུང་ཞིང་རྣམ་པར་འཕྲུལ།",
    "སྐལ་ལྡན་རྡོ་རྗེས་གཏེར་ནས་བཏོན་པར་གྲགས།",
    "ཚུལ་དུ་བཞུགས་པ་ཡིན་པས་གདུང་དབོན་བརྒྱུད།",
    "ཁོང་དང་བེ་རོའི་རྣམ་པར་འཕྲུལ་བ་ཡང་།",
    "སྔ་ཕྱི་བར་གསུམ་རྣམས་སུ་ཅི་རིགས་ཕེབས།",
    "ཕྱོགས་བཞིའི་འདྲེ་ཆེན་བཞི་བཏུལ་ལྷ་སྲིན་རྣམས།",
    "ཁྱད་པར་སློབ་དཔོན་ཆེན་པོའི་ཐུགས་སྲས་གྱུར།",
    "དྲེགས་པའི་བཀའ་བབས་དྲེགས་ལྡན་ལྷ་སྲིན་ཀུན།",
    "སྒྲུབ་གནས་སྤ་གྲོ་སྟག་ཚང་དུ་བཞུགས་སྐབས།",
    "གཙང་ཆུ་འདྲེས་པ་ཞེས་བྱུང་དེ་གང་རུང་།",
    "ཐད་དུ་ལོ་ཙཱ་འདི་ཉིད་འཁྲུངས་པར་བཤད།",
    "དེ་ཡང་ཐང་ཡིག་ལྟར་ན་ཡབ་ཏུ་གསུངས།",
    "སྐུ་ན་གཞོན་པའི་འི་དུས་ཀྱི་རྣམ་པར་འཕྲུལ།",
    "རྣམ་པར་སྣང་མཛད་སྲུང་བ་ཞེས་མཚན་བཏགས།",
    "གཙང་བན་ལེགས་གྲུབ་ཉིད་དང་ལྷན་ཅིག་ཏུ།",
    "རྒྱ་གར་དུ་ཕེབས་ཤྲཱི་སེདྷ་ལ་སོགས།",
    "ཐུགས་ཉམས་བཞེས་པས་དགོངས་པ་དབྱེར་མེད་གྱུར།",
    "ཁྱད་པར་རྒྱ་གར་དུ་ཕེབས་གྲོགས་པོ་ནི།",
    "ཕེབས་ནས་བསྟན་ལ་བྱ་བ་རྒྱ་ཆེར་མཛད།",
    "ཁྱད་པར་ཁོང་ལ་སྔར་འཁོན་ཆེ་བ་ཅན།",
    "སློབ་དཔོན་པདྨའི་ཐུགས་རྗེས་གསོས་པར་མཛད།",
    "མཆོད་བཞེས་ལུགས་ལ་པྲ་བརྟག་བྱེད་པ་ཡོད།",
    "ཐུགས་སྲས་རྗེ་འབངས་གྲོགས་གསུམ་ཞེས་གྲགས་པར།",
    "དགུ་པ་སྣ་ནམ་རྡོ་རྗེ་བདུད་འཇོམས་ནི་ གཙང་རོང་ཕྱོགས་ཀྱི་ཞང་བློན་སྣ་ནམ་རིགས།",
    "ཚུལ་དུ་ལེགས་བཞུགས་རྡོ་རྗེ་ཕུར་བའི་སྒོས།",
    "ཕེབས་ཤུལ་བྲག་ཁུང་གསེང་ནི་དེང་སང་ཡོད།",
    "ཐོགས་པ་མེད་པར་གླིང་བཞི་སྐད་ཅིག་བསྐོར།",
    "དེ་ལ་སོགས་པའི་ཁྱད་མཚར་མང་རབ་གནང་།",
    "མཐར་ནི་མཁའ་སྤྱོད་ཞིང་དུ་བགྲོད་པར་ནུས།",
    "ཨཱ་ཙར་ལུགས་སུ་དེ་འདྲར་བྱས་པ་མང་།",
    "སྐུ་ཚེའི་མཐའ་བར་ཚངས་སྤྱོད་མཆོག་ཚུལ་བཞུགས།",
    "འཛིན་པར་ནུས་པའི་མཐུ་དང་ལྡན་པ་སྟེ།",
    "མཚན་ཉིད་ལྡན་པར་མཁྱེན་ནས་རྗེས་བཟུང་ལྟར།",
    "དངོས་གྲུབ་མཆོག་བརྙེས་རྟེན་ནི་ཁྱིམ་པར་བཞུགས།",
    "མཐུ་ཆེན་གཞན་ལས་ཁྱད་འཕགས་ཚུལ་དུ་བཞུགས།",
    "དུས་མཐའི་བར་ལ་ཕྱག་བཞེས་ཅི་རིགས་སྣང་།",
    "སྐད་གཉིས་ལེགས་པར་སྨྲ་ལ་མཁས་པའི་ཕྱིར།",
    "འབྲི་མཁན་འདི་ཡིན་པར།",
    "ལེགས་བཞུགས་མཛད་པ་ཡ་མཚན་ཅི་ཡང་རྩེ།",
    "གཞན་སེམས་ཐོགས་མེད་མཁྱེན་པའི་དངོས་གྲུབ་བརྙེས།",
    "གདུལ་ཞིང་གང་ལ་ཉེར་མཁོ་རྣམ་པར་འཕྲུལ།",
    "མཁས་པར་སྦྱངས་ཏེ་མ་གཤིན་ཕུར་གསུམ་གྱི།",
    "གང་ཐད་ནས་ཀྱང་རྗེ་དང་མཉམ་ཚུལ་གསུངས།",
    "ཁྱད་པར་མར་ཁུ་ཝ་ལས་དྲངས་པའི་ཐད།",
    "རྗེ་ལས་ལྷག་པར་བྱུང་ཚུལ་ཞིབ་གསུངས་ལྟར།",
    "ཝ་ལས་དྲངས་པ་ཡིན་པར་གྲགས་སྐད་དེ།",
    "འདི་ཡི་གདུང་རབས་ཞིབ་པར་ལྷོ་བྲག་པ།"
  ]
}