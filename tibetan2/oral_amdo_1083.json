    "དེ་དོན་འགྱུར་བ་དུང་སྐྱོང་ལྷ་མོ་ཡི།",
    "འཇོམས་བྱེད་མཐུ་སྟོབས་ཐོག་གིས་མཐར་བྱེད་ཀྱང་།",
    "ཕལ་ཆེར་གཡའ་ཡིས་མོག་པོར་བྱས།",
    "ཕན་པར་རེ་བའི་ས་བོན་ལས།",
    "ངན་སྐྱུགས་ཁྲག་གི་རི་མོ་འཆར་། མུ་ཁྱུད་ཟད་པའི་བཙན་མཁར་ཉིད།",
    "རབ་གནས་སྟ་གོན་གྱི་བགེགས་བསྐྱོད་བྱེད་ཁར་ཤེས་རྒྱུད་འཁྲུག་ཅིང་འཚིག་པའི་ལྷོངས་དང་བགེགས་བསྐྲད་དུ་སོང་སྐབས་ཤེས་པ་ཧུར་ཕྱུངས་པའི་དཔའ་གདེངས་རྩོལ་མེད་དུ་འཆར་བ་དང་།",
    "འཁྲུངས་རབས་ལྷ་ཁང་གི་སྒོ་ནུབ་མའི་གདོང་ཙམ་ནས་ཡིད་ཤེས་ལ་ཨ་ཙ་ར་དང་བརྗེ་རྡུལ་ཉམས་འབོག་ཁྲེས་ཁུར་བ་ཞིག་བྱེད་ཉམས་བཛྫཱ་ཀཱ་ར་ཤཱནྟཾ་། ཀྱིས་འབྲོས་པའི་རྣམ་པ་ཤིན་ཏུ་གསལ་བ་དང་།",
    "སྟ་གོན་གྱི་ནུབ་མོའི་རྨི་ལམ་དུ།",
    "བྱད་འགྲོལ་གྱི་སྒྲུབ་པ་ཚུགས་ནས་ཞག་གསུམ་སོང་བའི་ནུབ་མོའི་རྨི་ལམ་དུ་དབུསན་ཁང་པ་བརྩེགས་པ་དབུ་རྩེའི་རྣམ་པ་ཅན་དམར་པོ་བད་དང་བཅས་པ་ཆུང་ངེ་བ་ཞིག་གི་མཐའ་སྐོརན།",
    "ཁང་པ་དེའི་འཁྱོག་ཞིག་ན་བུད་མེད་རྒན་མོ་གོས་ཧྲུལ་གྱོན་པ་ས་མན་ཞིག་གིས་སྒོ་ཞིག་ལ་སྒོ་ལྕགས་རྒྱག་པ་དང་མཉམ་དུ་འདིའི་རྐུན་མ་བསྲུང་མི་ང་ཡིན།",
    "ཁྱེད་རང་ཐོག་ལ་སོང་ཟེར་སྐས་ཤིག་བསྟན་བྱུང་བ་ལ་འཛེགས་ནས་ཕྱིན་པས་ཐོག་ཆགས་ནག་རྩི་འོད་ལྡེམ་མེ་བ་ཞིག་འདུག་པའི་ཁར་སླེབས་པ་ན་ཉི་མ་ཤིན་ཏུ་གསལ་བ་གུང་ཙམ་དུ་སླེབ་པ་དང་ཉེ་བའི་ནུབ་ཕྱོགས་ན་སྤྲིན་ནག་འཁྲིགས་ཤིང་སེར་བ་འབབ་པར་དོགས་པས།",
    "ང་རང་གི་འཁྲིས་དེར་མི་ངོ་མི་ཤེས་པ་ཁ་པ།",
    "དེའི་ནུབ་ཀྱི་མདུན་ན་རྡོ་བཅལ་སྐྱ་ལྡེབ་བེ་བ་ཧ་ཅང་མི་ཆེ་བའི་ནུབ་ན་མཁར་ཕྲ་རིང་རྩེ་མོར་དར་ལྕོག་རྒྱལ་མཚན་མང་པོས་ཟང་ཟིང་དུ་སྤྱད་པའི་རྡོ་བཅལ་དེར་སླེབ་པ་ན་མི་རིགས་མི་གཅིག་པ་མང་པོ་ཡང་གནས་མཇལ་ལ་ཚོགས་པ་ལྟ་བུ་དང་།",
    "གདོང་ལ་ཁྲག་གི་ཐིག་ལེ་སྣ་ཚོགས་བྱུགས་པ་ཞིག་གིས་ལག་གཡས་པུས་མོའི་སྟེང་དུ་ས་གནོན་ལྟར་བརྐྱང་།",
    "སྐོངས་དང་ཚོགས་བརྒྱ།",
    "སྒྲོལ་མ་རྣམས་འབུམ་ཚོ་ལྔ་རེ།",
    "མཐའ་མེད་མ་རྒན་འགྲོ་ལ་བརྩེ་བས་གཟིགས།",
    "སྲིད་པའི་ལྡུམ་རར་འདོད་ཡོན་དུག་གི་ཚལ།",
    "རེ་ལྟོས་དཔུང་དུ་སྦྲན་པའི་འཇིག་རྟེན་སྐྱབས།",
    "སྔར་སྲོལ་བཟང་པོའི་རི་མོ་བསུབ་པ་དང་།",
    "གཅམ་བུའི་གཏམ་དང་བཟའ་བཏུང་ཕྲ་མོ་ལ།",
    "ཅུང་ཟད་རྣོ་བའི་ཚིག་མདའ་ཕྲ་མོས་ཀྱང་།",
    "རྨོངས་པ་བདག་གིས་ནེ་ཙོའི་ཚིག་བཞིན་དུ།",
    "རེས་འགའ་བདེན་པའི་ཉི་མ་འཆར་ཡང་སྲིད།",
    "གང་ན་ཡང་སྔ་ཕྱིའི་འཁྲུལ་སྣང་གི་བརྗོད་པ་སྣ་ཚོགས་པ་དག་དོན་གཉེར་ཅན་གྱིས་ནན་ཏན་དུ་བསྐུལ་བའི་ངོར་ཆོ་ལོ་རིས་སུ་བསྒྲིགས་ནས་བཀོད་པའི་ཡི་གེ་པ་ནི་ཨོ་རྒྱན་རྣམ་གྲོལ་ལོ།",
    "ཆུ་ཟླའི་རོལ་རྩེད་། ཤིང་ཕག་ཟླ་བ་བཅུ་གཉིས་པའི་ཚེས་བརྒྱད་ཀྱི་ནུབ་མོའི་རྨི་ལམ་ལ།",
    "དེ་ནས་ངེད་རང་རྟ་ལ་ཞོན་ཏེ་ནུབ་ཕྱོགས་སུ་སོང་བ་ལས།",
    "བསམ་པར་འགྲོ་དགོས་པ་བྱུང་ན་ཅི་དྲག་གམ་སྙམ་པའི་སེམས་འཁུར་ཤིན་ཏུ་ཆེ་བ་བྱེད་པ་ཞིག་རྨིས། ཡང་ཉེར་གཅིག་གི་ཐོ་རེངས་ཀྱི་དུས་ནམ་རིམ་པ་དག་ལ་གསུང་གནང་སྟེ།",
    "ཁོང་པ་ད་རེས་ཁྲིད་པ་ཞུ་གསུང་།",
    "བསེ་སྒམ་ལྟ་བུའི་སྒམ་ཆུང་འགའ་ཡང་ཟུར་དུ་ཕྱེ་ནས་ཟིང་ཟིང་བྱེད་པ་ཞིག་རྨིས་པར་ཡིད་རློང་སློང་པོར་གྱུར་པའི་ཉམས་སྣང་བྱུང་གསུང་། ས་ཡོས་ཟླ་བ་ལྔ་པའི་ཚེས་བཅུ་གཉིས་ཀྱི་ནུབ་མོའི་རྨི་ལམ་དུ།",
    "འདི་འདྲ་འགྱེད་ལ་གནང་ན་ཅི་ཡོང་ཟེར་བལྟས་སོང་བར།",
    "ངེད་རང་གི་བསམ་པར།",
    "ང་རང་སེམས་མ་བདེ་བའི་ངང་ནས་ཕྱིན་པས་ཡར་འབྲོག་མཚོ་འགྲམ་ཡིན་སྙམ་པ་ཞིག་གི་མཐར་ཤ་མང་པོ་སྤངས་ནས་འདུག་པའི་ངང་ལ་གཉིད་སད། ས་ཡོས་ཟླ་བ་དགུ་པའི་བཛྲ་ཀཱ་ར་ཤཱནྟཾ་༡ག་གཟིགས་ལྔ་། ཚེས་ཉི་ཤུའི་ཐོ་རེངས་ཀྱི་འཁྲུལ་རྨིས་ལ།",
    "ཚེས་ཉི་ཤུའི་ནུབ་མོར་རྨི་ལམ་དུ།",
    "དེནས་ཐོར་ཐུན་གྲོལ་བའི་ཉེར་གཅིག་གི་ནམ་ལངས་སུ་ཉེ་བའི་རྨི་ལམ་དུ།",
    "འཁྲིས་དེར་མི་གོས་ཧྲུལ་གྱོན་པ་རྔ་མ་དཀར་པོའི་ཆུན་པོ་ཐོགས་པ་ཞིག་གིས་ང་རང་༡ཨ་ལ་གླེང་བསླང་སྣ་ཚོགས་བྱེད་པ།",
    "ངེད་རང་བྱང་བལྟ་སྟག་གདན་ཞིག་གི་ཁར་བསྡད་པ་ན།",
    "ང་རང་གི་བསམ་པར།",
    "མི་གཅིག་གིས་ངེད་ཀྱིས་ད་ཅི་ནས་ཕེབས་བསྒུགས་ཞུས་ཀྱང་མ་ཕེབས་པས་ཉི་མ་ཕྱི་མོར་སོང་།",
    "ད་ངེད་ཀྱིས་ཀྱང་མི་སླེབ་པ་འདུག་པས་རི་མོའི་ལྗགས་བཀོད་ཞུ་ཟེར།",
    "བསྐྱར་ནས་དྲི་ཐུབ་པའང་ཇི་འདྲ་ཡོང་ངམ་སྙམ་དེའི་སང་ནུབ་གཏོར་བསྔོ་དམོད་བོར་གྱིས་རྨི་ལམ་བསྒྲགས་ཀྱང་འདི་ཡིན་གཏད་སོ་མེད་པའི་ཟ་ཟིར་ལས་ངོས་ཟིན་གསལ་བ་ནི་མ་བྱུང་།",
    "ཁོང་པ་གཉིས་ཀྱིས་ཀྱང་སྔར་ལྟར་ཞུ་བ་སོགས་འདུག་པར་ངེད་རང་གི་བསམ་བློར།",
    "ཡས་ཕྱིན་གཉིས་ཀས་ཁ་ཐགས་ཆེ་བ་རེ་གནང་བྱུང་།",
    "ངེད་རང་གིས་ཀྱང་མཇལ་དར་ཕུལ་ནས།",
    "རྒྱ་སོག་རེ་ཞིག་ངང་ཙམ་གྱིས་འཇམ་ཐིང་སོང་བས་ཐུགས་འཁོལ་མི་དགོས་འདུག་གནང་བའི་མུར་གཉིད་སད། ཡང་ཟླ་བ་བཅུ་པའི་ཚེས་དྲུག་གི་ནུབ།",
    "ངེད་རང་གི་བསམ་བློར་ཕྱིར་གྲ་མི་འགྲིག་པ་འདི་ཚོ།",
    "ངེད་རང་གིས་གསོད་རྩིས་ཀྱིས་གཟན་གཡོགས་སོང་བར།",
    "འོན་ཀྱང་རྒྱ་སོག་གི་འདྲེ་གདོན་རྣམས་ཟ་ཁ་མ་གང་བ་ཡིན་འདུག་པས།",
    "ཀུན་བཟང་ཡང་རྩེའི་བྱང་གི་དཀར་གསལ་ནས་བལྟས་པས།",
    "བུད་མེད་རྒྱན་ཆ་འབྱོར་བ་ཞིག་གིས་ངེད་རང་ལ་རྒོལ་བ།",
    "རྐང་པ་ན་བ་ལྟ་བུས་ཤེལ་སྤྱད་ཁྲོད་དུ་འགྲོ་བ་རྣམས་ཀྱི་ཉམས་ཤར། ཡང་ཟླ་བ་བཛྲ་ཀླུ་ར་ཤཱནྟཾ་། བཅུ་གཅིག་པའི་ཚེས་གཅིག་གི་ནུབ།",
    "བར་ཆད་མི་ཡོང་བའི་ཁས་ལེན་བྱེད་ཟེར་བའི་མདུད་པ་དེ་ཨ་མ་ལགས་སྔར་གྱི་རྣམ་པ་ཇི་ལྟ་བ་ལྟར་འདུག་པ་ལ་གཏད་སོང་བ།",
    "གཏེར་བདག་གིས་རྣམ་གྲོལ་ལ་གཏང་རག་ཁྱེར་ཤོག་ངས་ཁས་ལེན་བྱས་པ་ཡིན་ཟེར།",
    "སྦྲུལ་སེར་པོ་ཆུང་ངུ་ཞིག་འདུག་པ་ལ་ཨ་མ་ལགས་ཀྱིས་ཕྱག་རེག་གྲབས་གནང་སོང་བར།",
    "ངེད་རང་གིས་གསར་པ་དེ་མགྱོགས་པོ་ཐབས་འཕྲུལ་གྱིས་མ་གཏང་ན་ལུས་ཉེན་ཆེ་ཟེར་བའི་མོད་ལ་གཉིད་སད། ཡང་ཟླ་བ་བཅུ་གཅིག་པའི་བཅུ་དགུའི་ནུབ།",
    "ངེད་རང་གིས་འདིར་མ་ཕེབས་ན་ཆོག་འོན་ཀྱང་ད་ཆ་སྐྱན་སྨིན་ཆེ་བས་ད་རེས་མ་གཏོགས་མཇལ་མི་ཡོང་།",
    "གཡུ་ཐོག་གི་སྦུབས་ནས་གསེར་ཟངས་ཀྱི་གཉྫི་ར་ཐོན་པ་ཞིག་འདུག་པའི་སྟེང་ཁང་གི་ནང་དེར་ཕེབས་ཨཀྵཔར་སྒམ་རགས་སོགས་ཆས་མང་པོ་འདུག།",
    "རྒྱ་ཤོག་མང་པོ་འདུག་པའི་ཁྲོད་དུ་ངེད་རང་གིས་སྤོས་རེང་གི་མེ་ཤོར་སོང་ཟེར་བའི་མོད་ལ་ཕྱིར་ཐོན་ནས་གཉིད་སད་པ་ཞིག་བྱུང་གསུང་། ཡང་ཟླ་བ་བཅུ་གཉིས་པའི་ཚེས་བཅུ་དྲུག་གི་ནུབ་མོ།",
    "ཐོ་རེངས་ཀྱི་ཐུན་བཉེར་རྒྱ་སྲང་ཞིག་ཏུ་ཕྱིན་པ་ན་ཁང་པ་སྤེའུ་ནག་རེང་ངེ་བ་མང་པོ་འདུག་པར།",
    "ངེད་རང་གིས་སྙན་དར་ཞིག་ཕུལ་ཞེས་ལབས་པར།",
    "ངེད་རང་ཡིན་པ་ངོ་ཤེས་པ་ལྟ་བུས་མི་ཞིག་གིས་སྲས་པོ་སྐུ་བསྙུང་ཡོད་པས་བྱབ་ཁྲུས་ཞིག་ལ་ཕེབས་རོགས་ཞུ་ཟེར་བར་མ་ཕྱིན་ན་ནི་མི་ཡོང་།",
    "ད་ལྟའི་གཟིམས་ཆུང་སྦུག་གི་མལ་སྒྲོམ་ནང་འདི་ཁར་བསྡད་འདུག་པ་ལ།",
    "ངེད་རྣམས་ཞིང་སྐྱོང་གི་ཌཱ་ཀི་ནཱི་ཡིན།",
    "ད་ལྟ་རྔ་ཡབ་གླིང་པ་ཐམས་ཅད་རྒྱ་འདྲེ་ཤོར་སོང་བས།",
    "མལ་སྒྲོམ་ནང་དུ་མར་མནན་ནས་རེ་ཞིག་ཐེགསན་མབ་གཏན་ནས་མི་འོང་ཟེར།",
    "དེར་ངེད་རང་གིས་ད་ལྟའི་ཚེའི་ཚད་ལ་དགའ་མོ་ཡོད།",
    "རེ་ཞིག་མི་འགྲོ་ཡོང་རན་པ་དང་ཁྱེད་རང་རྣམས་བསུ་བ་ལ་འོང་མི་དགོས་ཤར་མར་སླེབ་འོང་ངོ་བྱས་སོང་དེར་བཙུན་པ་དེས་བུད་མེད་ལྔ་པོ་དེ་ཨུ་ཚུགས་ཀྱིས་བརྫངས་པས་ཕྱིར་ལོག་སོང་བ་དང་།",
    "ངེད་རང་གི་བསམ་པར།",
    "དནི་ལོ་ཡང་ལྔ་བཅུ་ང་ལྔ་ཙམ་སླེབ་སོང་བས་ཕྱིན་ཀྱང་ཡོང་བ་འདྲ་སྙམ་བྱེད།",
    "ཨོ་རྒྱན་ཆེན་པོའི་དྲིན་གསོར་འཕྲིན་ལས་སྤེལ་ཕྱིར་རེ་ཞིག་སྡོད་དགོས་འདུག་ཟེར་བ་བྱས་སོང་།",
    "ངེད་རང་གིས་སྤྲུལ་པའི་སྐུ་མྱུར་དུ་ཕེབས་དགོས་སོ་ཞེས་ཞུས་པས།",
    "མྱུར་མཇལ་གྱི་སྨོན་པ་ཞུ་བས་སྐྱབས་འཇུག་ཐུགས་རྗེས་གཟིགས་དགོས།",
    "ཞེས་གསུང་བའི་མོད་ལ་གཉིད་སད།",
    "སོག་པོ་རྔ་མོང་ལ་ཁལ་བཀལ་བ་ལག་ན་དབྱུག་པར་ལུག་རོ་བཀལ་བ་ཞིག་འོངས་ནས།",
    "ང་རང་ལ་སྐྱབས་འཇུག་ཞུ་གི་ཡིན་ཟེར་བ་ཞིག་བྱུང་བར།",
    "མི་ཞིག་ན་རེ།",
    "རི་ཐམས་ཅད་ཀྱི་རྩེ་མོར་ཡང་དར་ལྕོག་དཀར་པོ་འབའ་ཞིག་བཙུགས་ནས་འདུག་པ་རྨིས། ཡང་ཟླ་བ་དྲུག་པའི་ཚེས་ལྔའི་ནུབ།",
    "ས་སྐྱ་ཡིན་སྙམ་པའི་ཁང་པ་ཞིག་གི་ནང་དུ་སླེབས།",
    "སྙན་དར་སོགས་སྤྱན་གཟིགས་མཚར་ཞིང་རྒྱས་པ་བག་དྲོ་ཆིལ་ལེ་བ་ཞིག་འདུག།",
    "ཕྱག་གཉིས་ཕྱག་མཚན་མེད་པར་སྙན་གཡས་གཡོན་གྱི་ཐད་དུ་སྤར་མོ་གཟིངས་ནས་འདུག།",
    "རྩིག་ཆུང་ཞིག་གི་སྟེགས་ལ་བུད་མེད་འཇིགས་སུ་རུང་བ།",
    "ཁ་ནས་དམོད་ཚིག་དང་འོ་དོད་འབོད་པ་ཞིག་འདུག་པས།",
    "ཡང་ཟླ་བ་བདུན་པའི་ཚེས་དྲུག་གི་ཐོ་རེངས་གཙུག་ལག་ཁང་རྙིང་པའི་བདེ་ཡངས་སུ་ཕྱིན་པས།",
    "ཤུག་སྡོང་ཞིག་གི་འཁྲིས་ན་གྲྭ་ཚང་གི་ཁྱི་ག་ཕྲུག་དེ་ཤིནས་འདུག།",
    "དེ་ནས་མཆོད་བཤོམས་ཤག་རྙིང་པའི་འགག་གི་སྐས་བརྒྱུད་སྟེང་དུ་འཛེགས་པ་ན་སྐས་མང་པོ་རིམ་བརྩེགས་སུ་འདུག་པའི་བར་ཁང་ཞིག་གི་ནང་དུ་ཕྱིན་པས།",
    "ང་རང་གི་ཞང་པོ་ཡིན་རྒྱུ་བའི་སོག་ཆས་སྤྲད་པ་སྟག་རྩེའི་ཞལ་ངོ་ཡིན་ཟེར་བ་ཞིག་དང་མཉམ་དུ་དཔུང་། པར་ལག་པ་བཀལ་ནས་བློ་ཉེ་དུངས་ཀྱིས་གཏམ་ཕར་ལབ་ཚུར་ལབ་བྱེད་བཞིན་དུ་ཕྱིན་པར།",
    "ང་རང་གི་བསམ་པར་ཞབས་བརྟན་ལྷ་ཁང་གི་ཨར་པོ་ཡིན་སེམས་པ་ལ།",
    "ང་རང་གིས་བསམ་པར་འདིས་གོ་མ་སོང་།",
    "ན་ཁ་ཞིག་གི་རགས་སྟེང་དུ་སླེབ་པར།",
    "ས་རྗེན་གྱི་སྟེང་དུ་བཏིང་སོང་བ་ལ།",
    "འདི་འདྲའི་རྟོག་འཇུག་ལ་༥ཆུང་བ་སྙམ་པའི་མོད་ལ་གཉིད་སད་པ་ཞིག་བྱུང་། ཡང་ཉེར་དྲུག་གི་ནུབ་མོ་འབྲི་ཁུང་དུ་ཕྱིན་པར།",
    "མདུན་གྲལ་ལ་ངེད་རང་གི་ཞབས་ཕྱི་རྣམས་དྲེའུ་རྔོག་དང་སྟག་སྟན་སོགས་ཀྱི་གདན་ལ་གྲལ་བསྒྲིགས་ཐོག།",
    "ངེད་རང་གི་གཏེར་མ་ཡིན་ཟེར་བའི་རྡོ་རྗེ་གྲོ་ལོད་ཀྱི་སྐུ་ཞིག་དང་།",
    "དེར་འབྲི་ཁུང་ཕྱག་མཛོད་ཀྱིས་ངེད་ཆིབས་སྐྱེལ་དུ་འགྲོ་དགོས་འདུག་པས་དེ་བར་འདི་ལ་སུས་ཀྱང་མ་རེག་ཟེར།",
    "ངེད་རང་གི་བསམ་བློར།",
    "གཞན་ཡང་བཀའ་བགྲོས་ལྟ་བུའི་བསླབ་སྟོན་མང་དུ་སྩལ་བ་རྨིས། ཡང་ཟླ་བ་དགུ་པའི་ཚེས་བདུན་ལ་གཞུང་གི་སྐུ་རིམ་དུ་ལས་བཞིའི་ནང་ཚན་གསུམ་པ་ཚུགས་པའི་ནུབ་མོའི་རྨི་ལམ་ལ།",
    "དེར་ངེད་རང་གིས།",
    "འདི་ལ་སྟོད་པ་ཞིག་གིས་བསླབས་པ་ཡིན་འདུག་ཟེར་བར།",
    "བྱ་གཉིས་པོ་དེ་ཇེ་ཆུང་ཇེ་ཆུང་དུ་སོང་ནས།",
    "དེའི་ལྷོ་ངོས་ནས་བྱང་དུ་ཕྱོགསཔར་རོལ་མོ་བ་འགས་དབྱངས་འཐེན།",
    "གཅིག་གི་འཕང་ན་ཕྲུ་གུ་ཞིག་བཟུང་འདུག།",
    "ཡི་གེ་བྱང་པོ་ཞིག་གི་ལུང་བསྟན་ཐོར་བུ་ཡོད་པ། ཡང་ཚེས་བཅུ་གཅིག་ལ།",
    "མི་མང་ཚོགས་པས་དེར་དགེ་སློང་འཇམ་དབྱངས་གྲགས་པས་འཕྲོས་ཞུ་ཟེར།",
    "རྩིག་པའི་གཡང་ངམ་ཟ་བར་འགྲོ་བ་ཤར་ཕྱོགས་ནས་འབྲོག་པ་ཞིག་གིས་བཞད་གད་དང་གླུ་ལེན་པ།",
    "ངེད་རང་གི་གྲྭ་ཚང་བཅས་ཚོགས་ནས།",
    "ཡང་ཁང་པ་མཐོ་བ་གཅོང་ཅན་ཞིག་ཏུ་སོང་བ་ན།",
    "ཁང་པ་ཀ་བ་བརྒྱད་ཙམ་གྱི་ཚོད་མུན་འཐིབ་བེ་བ་ཞིག་གི་གུང་ན།",
    "ཁྱི་ནག་པོ་འཇིགས་སུ་རུང་བ་ཞིག་གིས་མི་ཐམས་ཅད་འདེད་ཀྱིན་འདུག་པར།",
    "དེའི་སང་ཉིན་ཉེར་དྲུག་གི་ཞོག་ཟངས་ལུང་དུ་ཕྱིན་པར་བྱ་རོག་སྣུམ་བག་ཅན་ཞིག་ངེད་རང་གི་རྟའི་གཡས་གཡོན་དུ་ལྡིང་ཞིང་།",
    "ཏྲཀཱད་མཉེས་པའི་རྣམ་པ་གསལ་བར་གོ་ལྕགས་སྦྲུལ་ཟླ་བ་དང་པོའི་ཚེས་གཅིག་གི་ནུབ་སྒམ་པོ་བ་ཡིན་རྒྱུ་བ་ཞིག་གི་ནང་དུ་ཕྱིན་པར་རྗེ་བཀྲ་ཤིས་རྣམ་རྒྱལ་དུས་ཀྱི་མགོན་ཁང་ཡིན་ཟེར་བའི་ནང་མུན་འཐིབ་བེ་བ་ཞིག་གི་གུངན།",
    "ངེད་རང་གིས་ད་ནང་གང་ནས་ཕེབས།",
    "ད་གང་དུ་ཐེགས་ཞུས་སོང་བའི་ལན་དུ་ང་དེང་སང་ལྷ་ས་ནས་འོངས་པ་ཡིན།",
    "དོ་ནུབ་ཟར་ཕུར་འབྱོར་བ་འགྲོ་དགོས་ཡོད་གནང་བའི་མོད་ལ་བགཉིད་སད་བྱུང་ངོ། ཡང་ཟླ་བ་བཞི་པའི་ཚེས་གཉིས་ཀྱི་ཉིན་གཞུང་སའི་སྐུ་རིམ་རྫོངས་བྱས་པའི་ནུབ་མོའི་རྨི་ལམ་ལ།"
  ]
}