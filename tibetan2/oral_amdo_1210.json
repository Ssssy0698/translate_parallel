    "སློབ་དཔོན་བདག་ཉིད་དཔལ་ཁྲག་འཐུང་གི་དཔལ་གྱི་ཆས་སུ་བྱས་པའོ།",
    "དེར་མ་ཟད་འོག་ཏུ་ཡང་ནི་གསེར་གྱིས་གཞི་ལ་ཐུག་པར་མཚོན་ཆ་དགོད་པ་སྟེ་སྣ་ཚོགས་རྡོ་རྗེའི་ས་གཞི་བསྒོམ་མོ།",
    "ཐིག་གིས་བྲི་བ་དང་།",
    "འམ་ཞེས་པས་དེ་མེད་ན་བདུད་རྩི་ལྔ་དང་བཅས་པའི་ཁྲག་ཆེན་པོ་སྟེ་མི་ཡི་ཁྲག་གིས་བསྒོས་པའི་ཐིག་སྐུད་ཀྱིས་ཀྱང་།",
    "དཀྱིལ་འཁོར་ཆེ་ཆུང་གི་ཚད་ནི་རྩ་བའི་ཐིག་ཁྲུ་གང་བའམ་ཁྲུ་བཞི་འམ་ཁྲུ་བརྒྱད་པའོ།",
    "མཁའ་འགྲོ་ནི་དཔའ་བོ་དང་དཔའ་མོའོ།",
    "གོང་གི་རོ་བསྲེགས་སོལ་བའི་ཕྱེ་མ་དང་།",
    "མེ་ཏོག་གི་ཚོམ་བུ་དགོད་པར་ཡང་གསུངས་ལ།",
    "ཞལ་བཞི་མངའ་བའི་རེ་རེ་ལ་སྤྱན་གསུམ་གསུམ་དང་ལྡན་པ།",
    "ཧེ་རུ་ཀ་དེའི་མདུན་ནས་འཁྱུད་པའི་ཚུལ་གྱིས་གནས་པའི་ལྷ་མོ་ནི་རྡོ་རྗེ་ཕག་མོ་རབ་ཏུ་འཇིགས་མ།",
    "སྤྱན་གསུམ་མ་དྲག་མོའི་གཟུགས་ཅན་མ།",
    "རྡོ་རྗེ་ཕག་མོ་ཡི་ནི་རིགས་ལས་བྱུང་གའི་མཁའ་འགྲོ་མ་ནི་རབ་གཏུམ་མ་ལ་སོགས་པ་ཉི་ཤུ་རྩ་བཞི་རྣམས་ནི།",
    "རེ་རེ་ཁོ་ན་ནི་མ་ཡིན་ནོ།",
    "འོག་གི་མ་མོ་ཐམས་ཅད་ཕྱོགས་དང་ནི།",
    "ནམ་མཁའི་མཁའ་འགྲོ་མ་སྟེ་ཐུགས་འཁོར་གྱི་དཔའ་མོ་ཡེ་ཤེས་པ་རྣམས་ནི།",
    "རང་གི་ཡིད་ཀྱིས་ཐམས་ཅད་སྟེང་དུ་སྟེ་མཁའ་སྤྱོད་པའི་ཐུགས་འཁོར་གྱི་དམ་ཚིག་པ་ལ་དགོད་པ་སྟེ་གཞུག་གོ།",
    "གསུང་གི་དཀྱིལ་འཁོར་གྱི་དམ་ཚིག་པ་ལ་ཀུན་དུ་དགོད་པ་སྟེ་གཞུག་གོ།",
    "གང་ཡང་ས་འོག་གི་མཁའ་འགྲོ་མ་སྟེ་སྐུ་འཁོར་གྱི་མཁའ་འགྲོ་མ་ཡེ་ཤེས་པ་དེ་རྣམས་ནི།",
    "རས་ཀྱི་གོས་གསར་ཟུང་གིས་ནི་མགྲིན་པ་ལེགས་པར་དཀྲིས་པར་བྱ་ལ།",
    "གོས་ཟུང་གིས་ནི་ལེགས་པར་དཀྲིས་པའི་བུམ་པ་དགུ་བ་ཤར་རམ།",
    "སྟེང་དུ་བླ་རེ་དང་ནི་ལོགས་སུ་ཡལ་བ་དག་ཇི་ལྟར་མཛེས་པ་དེ་བཞིན་དུ་བྱའོ།",
    "གང་གིས་ནས་ལུས་ངག་ཡིད་ཀྱི་དངོས་པོ་ཀུན་གྱིས་སོ།",
    "རྔ་ནི་བཅུ་གཉིས་པའི་བུ་མོའོ།",
    "དེ་ལྟར་མིག་བཀབ་ནས་སུ་ཐལ་མོ་མེ་ཏོག་གིས་བཀང་བ་སྟེ།",
    "ཐལ་མོའི་བར་འཛིན་དུ་བཅུག་ལ།",
    "ཞེས་པ་ནི་ཁ་ཅིག་བདེ་མཆོག་ཞལ་ལྷོར་གཟིགས་པ་ལ་འཆད་ཅིང་།",
    "དེ་ནས་སྔར་ཐལ་མོའི་བར་དུ་བཟུང་བའི་མེ་ཏོག་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་དོར་བར་བྱའོ།",
    "དེ་ལྟར་འགྲོ་བ་སྒྲུབ་པ་པོ་དེ་ཡི་ཅི་བགྱི་སྟེ་བཀའ་བསྒོ་ཐམས་ཅད་ནི་མཁའ་འགྲོ་མ་དེ་དག་གིས་བྱེད་པར་ཐེ་ཚོམ་མེད་དོ།",
    "བུ་ག་སྟེ་ས་འོག་གི་བུ་གར་རྒྱུ་བ་དང་།",
    "མཁའ་འགྲོ་མ་དེ་རྣམས་ཀྱིས་སྒྲུབ་པ་པོ་དེ་ལ་ལན་ཅིག་བལྟོས་པ་སྟེ་གཟིགས་པ་ཙམ་གྱིས།",
    "ཐུན་མོང་གི་དངོས་གྲུབ་སྒྲུབ་པའི་ཚུལ་གཞན་བསྟན་པའོ།",
    "མཁའ་འགྲོ་མ་རྣམས་ནི་རང་གི་གནས་སྤྱིར་གཞལ་ཡས་ཁང་དང་།",
    "འཇིགས་བྱེད་ཆེན་མོ་དང་།",
    "ལྗང་ལྷ་མོ་སྟེ་སྔོ་གསངས་ལྷ་མོ་དང་།",
    "ཤིན་ཏུ་བཟང་མོ་དང་།",
    "རབ་སྟེ་ཤིན་ཏུ་དཔའ་མོ་དང་།",
    "བརྩོན་འགྲུས་ཆེན་མོ་བཞི་ནི་དེའི་མཚམས་བཞིར་གཡས་བསྐོར་གྱིས་འགོད་དེ།",
    "མཁའ་འགྲོ་མ་གྲངས་མེད་པ་རྣམས་ཀྱི་གཙོ་མོ་ཡིན་པའོ།",
    "སྔགས་ཀྱི་དེ་ཉིད་ནི་ལྷ་དྲུག་ཅུ་པོར་རང་རང་གི་མིང་།",
    "ལྟེ་བས་དེའི་ནང་གི་བྱ་རོག་གདོང་དང་ཧཱུ་ཏི་ལི་མར་སྣ་དང་།",
    "དབུས་ཀྱི་ཨ་ཡིག་གིས་རང་བཞིན་གྱིས་སྐྱེ་མེད་མཚོན་པར་གསུངས་ཏེ།",
    "གོང་གི་ཡི་གེ་དེ་དག་ཐམས་ཅད་ལེགས་པར་བསྡུས་པ་ལ་ནི་རྐང་པ་དང་པོའི་ལུས་སོ།",
    "དེ་དྲུག་ནི་རྡོར་སེམས་ལ་སོགས་པའི་དཔའ་བོ་དྲུག་གི་ཨོཾ་ལ་སོགས་པ་རང་མཉམ་པར་སྦྱོར་བ་སྟེ་སྦྱར་བར་བྱའོ།",
    "ཚུལ་ཇི་ལྟར་ན་ཧ་ལ་སོགས་པའི་ཡི་གེ་གཅིག་ཏུ་སྟེ་རེ་རེ་ཡང་དག་པར་གནས་པ་དང་སྦྱར་ཏེ།",
    "དཔལ་ཧེ་རུ་ཀར་བརྗོད་པ་བསྡུས་པའི་རྒྱུད་ལས་དཔའ་བོ་དྲུག་གི་གོ་ཆའི་སྔགས་བཏུ་བའི་ལེའུ་སྟེ་དྲུག་པའི་འགྲེལ་བའོ།",
    "ཡན་ལག་གི་དབྱངས་བཏུ་བ་དངོས།",
    "རྩ་སྔགས་ཀྱི་ལུས་བཏུས་པ་དེ་ནས་དབྱངས་ཡིག་བཅུ་གསུམ་པ་ཨོ་ནི་རྐང་བརྒྱད་ཀྱི་བཏུས་པའི་ཡི་གེ་གཉིས་པ་མ་དང་སྦྱར་བས་མོའོ།",
    "ཡི་གེ་དང་པོ་ནའི་སྲོག་གི་ཨ་ཐུང་ནི་ཐུ་མི་དགོས་པས་གཉིས་པའི་ཨོ་ནས་བཏུས་ཏེ་གཞན་ཡང་ཤེས་པར་བྱའོ།",
    "དབྱངས་ཡིག་གི་ནི་གཉིས་པ་ཨཱ་རིང་པོ་ཉིད་ནི་ཡི་གེ་ཉི་ཤུ་རྩ་གཅིག་པ་ཊར་སྦྱར་རོ།",
    "ཡི་གེ་ཉི་ཤུ་རྩ་བརྒྱད་པ་དེ་ཉིད་དང་ནི་དབྱངས་ཡིག་བཅོ་ལྔ་བ་ཨཾ་དང་སྦྱར་ཏེ་ཨ་ཕྱིས་ནས་ཐིག་ལེར་ལ་སྦྱིན་ནོ།",
    "ཡི་གེ་བཞི་བཅུ་རྩ་གཉིས་པ་ཉིད་སའི་འོག་གི་ཆར་ནི་སྒྲུབ་པ་པོས་མེ་སྟེ་ར་དང་སྦྱར་བར་སྟར་བྱ་བ་ཉིད་དེ།",
    "བཞི་བཅུ་རྩ་བདུན་པར་ཉིད་ནི་དབྱངས་ཡིག་གཉིས་པ་ཨཱ་རིང་པོ་དང་སྦྱོར་བའི་སྔགས་འདི་དག་ནི་རྡོ་རྗེ་སེམས་དཔའ་མཆོག་གི་ངོ་བོ་ཡིན་ཏེ།",
    "ཡི་གེ་ལྔ་བཅུ་རྩ་གཅིག་པ་ཤ་ནི་དབྱངས་ཡིག་ལྔ་བ་ཨུ་ཐུང་དུས་མཛེས་པ་མཆོག་ནི་ཡིན་པར་འདོད་དོ།",
    "དེ་ཡང་ས་བོན་གྱི་ཡི་གེ་མ་འདི་ཡི་འོག་གི་ཆར་ནི་བརྟག་པ་སྟེ་གདགས་པར་བྱའོ།",
    "ཡི་གེ་བདུན་ཅུ་རྩ་ལྔ་བ་ལྷ་ནི་མ་མོ་སྟེ་དབྱངས་ཀྱི་དྲུག་པ་ཨཱུ་དང་ལྡན་པ་འདི་ནི་རྣལ་འབྱོར་རབ་མཆོག་སྟེ།",
    "བདུན་ཅུ་རྩ་བརྒྱད་པ་ཀ་ཉིད་ནི་དབྱངས་ཡིག་གཉིས་པ་ཨཱ་དང་ལྡན་ཞིང་སྦྱར་བའི་ས་བོན་འདི་ནི་མཆོག་ཏུ་བཟང་པོ་དངོས་གྲུབ་ཀྱི་ཧུ་ཡི་མཆོག་ནི་ཡིན་པར་འདོད་དོ།",
    "སྔགས་བཅུ་གཞི་བཀོད་པའི་རེའུ་མིག་དག་ལས་བཏུས་པའི་སྔགས་འདི་དག་ནི་དཔལ་ཧེ་རུ་ཀ་མགོན་པོ་ཡི་རྩ་བའི་སྔགས་མཆོག་ཏུ་ཤེས་པར་བྱའོ།",
    "དཔལ་ལྡན་ཧེ་རུ་ཀ་ཁྲག་འཐུང་གི་ལྷ་རིག་པའི་རྒྱལ་པོའི་སྔགས་འདི་ནི་བཀླགས་པ་ཙམ་གྱིས་འགྲུབ་པ་འདོད་པའི་དོན་ཡོད་པར་བྱེད་པའོ།",
    "ཕ་དང་ཊ་སོ་སོར་བྱེད་པའི་ཚུལ་གཉིས་སྣང་བ་ལས་སྔ་མ་བདེ་སྙམ་མོ།",
    "རྣལ་འབྱོར་མ་དྲུག་གི་ས་བོན་ནི།",
    "སྦྱོར་ཚུལ་ནི་ཨོཾ་བཾ་ཧཾ་ཡཾ་ཧྲིཾ་མོ་ཧྲིཾ་ཧྲིཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཅེས་པའོ།",
    "གོ་ཆའི་སྔགས་དེ་རྣམས་ནི་མཁའ་འགྲོ་མ་ཡི་རིག་པ་ཆེན་མོ་ཡིན་ལ།",
    "རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པའི་སྔགས་ནི་མཁའ་འགྲོ་མ་ཡི་རིག་པ་ཆེའོ།",
    "རྣལ་འབྱོར་མ་དྲུག་གི་གོ་ཆའི་སྔགས་བཏུ་བའི་ཆོ་གའི་ལེའུ་སྟེ་བརྒྱད་པའི་འགྲེལ་བའོ།",
    "སྔགས་དེ་ནི་འཇིག་རྟེན་གསུམ་ན་ཞི་སོགས་ཀྱི་ལས་གང་ཅི་ཡོད་པ་རྣམས་ཐམས་ཅད་རིང་པོར་མི་ཐོགས་པར་སྐད་ཅིག་གིས་གྲུབ་པར་འགྱུར་པས་ལས་རྣམས་ཐམས་ཅད་བྱེད་པའོ།",
    "ལས་ཐུན་མོང་གི་རྣམ་གཞག་དང་།",
    "ཚར་གཅད་རྗེས་བཟུང་གི་ལས་དང་།",
    "རྩ་སྔགས་ཀྱི་མཐོང་ཆེ་གེ་མོ་མཱ་ར་ཡ་ཕཊ་ཅེས་སྦྱར་བར་བྱའོ།",
    "གཡས་བརྐྱང་གི་སྦྱོར་བའི་གར་དང་བཅས་པས་ས་གཡོ་བར་བྱེད་པ་དང་ཤིང་ལ་འཛེགས་ཏེ།",
    "རྩ་སྔགས་ལས་མེ་འབར་བ་དང་གཏུབ་པར་བསམས་པས་བཟླས་ན་ཁང་བཟང་དང་ཤིང་གི་རྩེ་མོ་ལ་སོགས་པ་ཕྱེ་མར་བྱེད་དོ།",
    "མེ་ཏོག་ལ་སོགས་པའི་དྲི་ཐམས་ཅད་ཕན་ཚུན་གང་དུ་འདོད་པ་རེར་འཕོའོ།",
    "བྱང་སེམས་རང་གི་ལྕེས་བླངས་ནས་ཕྱག་རྒྱུའི་ཁར་སྦྱིན་ཞིང་ལྷག་མ་རང་གིས་བཏུང་བའོ།",
    "ཞི་བ་འདུས་པའི་ལྷ་མོ་ཞེས་པའང་རང་དང་ཕྱག་རྒྱ་ལྷན་ཅིག་འདུས་པའོ།",
    "དེའི་ལག་མཐིལ་ན་ཡོད་པའི་དཔལ་གང་གིས་ཀྱང་མི་འགྲོག་པར་འགྱུར་རོ།",
    "སྒྲུབ་པ་པོ་གང་གིས་གསད་ལས་གྲུབ་པར་བྱ་བའི་ཕྱིར་བསྒྲུབ་བྱ་དེའི་མིང་ནས་བཟུང་སྟེ།",
    "རྩ་སྔགས་ལན་གཅིག་བཟླས་ན་བསྒྲུབ་བྱ་དེ་དེའི་མོད་ལ་འཆི་བར་འགྱུར་རོ།",
    "བ་ལང་གི་ཤ་དང་བཅས་པའི་སྦྱིན་སྲེག་སྟོང་རྩ་བརྒྱད་རྩ་སྔགས་ཀྱིས་ཕུལ་ན་ས་མ་ལུས་པ་ལ་ལོངས་སྤྱོད་པའི་རྒྱལ་སྲིད་འཐོབ་པར་འགྱུར་རོ།",
    "མེད་པར་འདོད་ན་ཞི་བའི་སྦྱིན་སྲེག་གིས་རྒྱལ་སྲིད་ཀྱི་གཡེང་བ་སྡུད་པར་འགྱུར་རོ།",
    "ལྷ་སྔགས་ངོ་བོ་ནི་མི་དད་པའི་བཅོམ་ལྡན་འདས་བདེ་མཆོག་གི་ཕྲེང་སྔགས་འདི་ལ་ནི།",
    "ཁྲུས་དང་ཉེ་རེག་ལ་སོགས་པའི་ཉེ་བར་སྤྱོད་པ་དང་།",
    "སླར་ཡང་དེའི་སྣ་གཡས་དང་རང་གི་སྣ་བུག་གཡོན་ནས་ཞུགས་བར་བསམས་ལ་རྩ་སྔགས་ལན་གཅིག་བཟླས་ན་བྱེ་བ་གཅོད་ཅིང་གསོད་པར་འགྱུར་རོ།",
    "དུར་ཁྲོད་ཀྱི་སོལ་བ་ལ་ལན་གཅིག་བཟླས་ནས་ཉི་ཤུ་དགུའི་ནུབ་མོ་སྤང་ལེབ་ལ་སོགས་པ་ལ་གཟའ་གང་ཡིན་པ་དེའི་མཚན་མའི་དབུས་སུ་འཁོར་ལོ་བྲིས་ལ།"
  ]
}