    "དུས་དང་སྐྱེ་གནས་ཐམས་ཅད་དུ་བདག་གི་གདུལ་བྱར་གྱུར་ནས།",
    "བདག་རང་གི་འཁྲུལ་པའི་སྣང་ངོར་ཤར་བ་ཡིན་གྱིས།",
    "ཁྱོད་ལ་བློ་སྦྱོང་གི་སྐྱེ་ཚུལ་ཡང་དེ་ལས་མི་འདུག་པས་སྙམ་དུ་རང་ལ་ཐག་བཅད་དེ།",
    "ད་རེས་དྲིན་ལེན་དུ་ལུས་སྦྱིན་པར་གཏང་དགོས་སྙམ་དུ་བསམ།",
    "བདག་གི་ལུས་འདི་དྲིན་ལན་དུ་སྟེར་བས།",
    "རང་གི་བསྐྱེད་རིམ་ལ་ལྟེམ་རྐྱང་ཤོར་ཅིང་།",
    "རང་གི་ཐུགས་ཀའི་ས་བོན་ལ་ཕོག་མཆོག་ཐུན་མོང་གི་དངོས་གྲུབ་ཐོབ་པར་བསམ་ཞིང་།",
    "བར་ཆད་ཀྱི་གེགས་ཅེས་པས་ས་ཟིན་ཐེར་ཟུག་ཡང་དག་ཏུ་གྲུབ་པ་མེད་པས་རང་གི་སེམས་ཀྱི་བྱེད་པས་ཇི་ལྟར་བལྟས་པ་བཞིན་ཕྱི་རོལ་དུའང་དེ་ལྟར་སྣང་།",
    "གར་མཁན་དག་དང་རི་མོ་བཟང་ལྟར་གནས་།",
    "མཆོག་ཐུན་མོང་དངོས་གྲུབ་སྟེར་བར་བྱེད།",
    "ཅེས་པ་སྟེ་རང་གི་ནང་གིས་བསམ་པའི་བྱེད་ལས།",
    "མེ་ཏོག་གི་ཆར་དུ་གྱུར་ཅིང་མི་སྙན་པའི་ངོ་བོ་བསྟོད་པའི་ཚིགས་བཅད་དུ་གྱུར་པ་ལྟ་བུའོ།",
    "གཉིས་པ་རང་གི་བསྐྱེད་རིམ་སྦྱོང་ཞིང་བོགས་དབྱུང་བ་དང་།",
    "ཡི་དམ་དང་མཇལ་བ་རེ་དགའ་སྟེ།",
    "སྣང་བ་ཐམས་ཅད་ཡི་དམ་གྱི་ལྷ་དང་ཞལ་མཇལ་བ་རེ་དགའ་སྙམ་དུ་བསམ་ཞིང་ངག་དུ་ཡང་བརྗོད།",
    "དེ་ཡང་ཡ་ང་བ་དང་ཁུ་འཕྲིག་གི་རྟོག་པ་བྱུང་ན།",
    "ཁྱོད་ཡི་དམ་གྱིས་འཇིགས་སམ་ཡི་དམ་དངོས་སུ་བྱོན་ན་དགའ།",
    "ཁྱོད་འཇིགས་ཤིང་ཡ་ང་བ་འདི་ཡི་དམ་དུ་མ་ཤེས་འདྲེ་གདོན་དུ་བཟུང་བས་ལེན་པ་ཡིན།",
    "རང་གི་མདུན་དུ་མི་མགོ་སྐམ་པོ་གསུམ་གྱི་སྒྱེད་པུ་བསམ།",
    "སྒྱེད་པུའི་ཁར་བཞག་དེའི་ནང་དུ་རང་གི་ལུས་དེ་བདུད་རྩིའི་ངོ་བོར་ཞུ་སྟེ།",
    "མཐར་བདག་ལ་མཉེས་ཏེ་མཆོག་ཐུན་མོང་གི་དངོས་གྲུབ་ཐོགས་པ་མེད་པར་གནང་བར་བསམ་ལ།",
    "ཡི་དམ་གྱི་ཆོ་འཕྲུལ་བྱུང་རེ་དགའ།",
    "མཚན་མོ་དེ་ལྟར་ཉམས་སུ་བླང་ཞིང་།",
    "དེ་ལྟར་རང་གི་བསྐྱེད་རིམ་ལ་བོགས་དབྱུང་བ་དང་།",
    "གཞན་ཡང་རང་གི་ཆག་ཁ་ལ་སོགས་པ་བར་ཆད་སེལ།",
    "རང་རང་གི་འགྲོ་དོན་བྱེད་པ་དང་དབྱེར་མེད་པར་བཞུགས་པ་ཡིན།",
    "མོས་གུས་བྱས་ཀྱང་མ་སྐྱེས་པ་ཡིན།",
    "ཕྱོགས་འཛིན་ཞེན་པའི་མོས་གུས་དེས་དོན་མི་འགྲུབ་པས།",
    "ཁྱད་པར་ལྷ་འདྲེའི་བར་ཆད་གདོན་གྱི་གནོད་པ་བྱུང་ན་རང་གི་མོས་གུས་ལ་ལྟེམ་རྐྱང་བྱུང་བ་ཡིན་པས།",
    "གདོན་དྲག་པོ་ལྟ་ན་ང་རོ་རྩེ་རེ་རེ་ཡོང་བར་འདུག་སྟེ།",
    "མོས་གུས་ལྟེམ་རྐྱང་མེད་པར་གསོལ་བ་བཏབ་པས།",
    "མྱུར་དུ་མོས་གུས་དག་སྣང་རྒྱ་ཆེན་པོ་འཆར་བར་འགྱུར་རོ།",
    "གཉིས་པ་མོས་གུས་ལ་བོགས་དབྱུང་ཞིང་།",
    "མོས་གུས་ཀྱི་ཁམས་དེ་ལས་མེད་ན་སྙམ་དུ་རང་ལ་ཐག་བཅད་ནས།",
    "རང་གི་མོས་གུས་ལ་བོགས་ཐོན།",
    "རང་གི་མོས་གུས་ལ་བོགས་སྦྱངས་པ་འོང་ངོ།",
    "རང་གི་དགེ་སྦྱོར་ལ་ལྟེམ་རྐྱང་བྱུང་བས།",
    "ཕྱག་རྒྱ་ཆེན་པོ་བཟང་པོ་ཞིག་གུད་དུ་བཙལ་མ་དགོས་པར་འདྲེ་གདོན་རྣམ་རྟོག་གི་བར་ཆད་དེ་ཉིད་གཉིས་མེད་ཕྱག་རྒྱ་ཆེན་པོར་རང་ངོ་ཤེས་པ་དེ་ལ།",
    "གཉིས་པ་རང་གི་རྟོགས་པ་ལ་བོགས་དབྱུང་ཞིང་།",
    "དེ་ལྟར་ཉམས་སུ་བླངས་པས་རང་གི་རྟོགས་པ་ལ་བོགས་མྱུར་དུ་ཐོན་ཅིང་།",
    "འཁོར་འདས་ཀྱི་བདེ་ལེགས་རང་གིས་བྱེད་པ་ཞེས་པ་དེ་ཉིད་ཡིན་ལ།",
    "ཇོ་མོ་ལབ་སྒྲོན་གྱི་བདུད་གཅོད་མ།",
    "བསྐྱེད་རིམ་མོས་གུས་ཕྱག་རྒྱ་ཆེན་པོའི་བཞི་ཀའི་བོགས་འདིས་འདོན་པ་ཡིན་གསུང་།",
    "ན་མོ་ཤྲཱི་བཛྲ་ཡོ་གི་ནི།",
    "བདག་གི་ཁ་སྒོར་ཐིམ་པ་དང་།",
    "ཧཱུྃ་ལས་ཧཱུྃ་འཕྲོས་ཧཱུྃ་གིས་སྦྱངས།",
    "ཧཱུྃ་བསྒོམ་ཧཱུྃ་གིས་འཕྲོ་འདུ་ཡིས།",
    "གསུང་གི་ཚིག་དང་དེ་གོང་གི་བརྡའ་དེ་ལ་བརྟེན་ནས།",
    "རྩེར་སོར་གང་གི་ཚད་ཙམ་ཤིན་ཏུ་གསལ་བར་བསྒོམ།",
    "ཧཱུྃ་གི་གདངས་དང་ལྡན་པའི་ཧཱུྃ་དྲག་པོ་གྱེན་ལ་འབུད་དོ།",
    "སའི་མཐིལ་ཤིན་ཏུ་དམའ་བར་ཡལ་བར་བསམ་མོ།",
    "སྐྲངས་པའི་དམིགས་མ་སོར་མོའི་རྩེ་ནས་བཏོན་ཏེ།",
    "ནམ་མཁའ་ལ་ཡལ་བར་བསམ་མོ།",
    "མོས་གུས་དྲག་པོ་བསྒོམ་དུ་གཞུག་རང་གི་ཐུགས་ཀར་ཧཱུྃ་མཐིང་ཁ་གསལ་གདབ།",
    "གང་དང་གང་ན་བའི་སར་ཧཱུྃ་ཕར་སོང་བས།",
    "སྣ་ནང་གི་ཧཱུྃ་ཐམས་ཅད་གཅིག་གིས་གཅིག་དེད་ཉི་རིར་རི་ཕྱིར་སོང་ནས།",
    "ན་མོ་ཤྲཱི་བཛྲ་ཡོ་གི་ནི་འཛག་བསྲུང་བཀའ་རྒྱ་མ་ལ་གསུམ།",
    "ཕལ་ཆེ་བ་ལ་གེགས་སུ་སོང་བ་མང་བར་འདུག་དམིགས་པ་འཁྲུལ་འཁོར་ལེགས་ལེགས་འདྲ།",
    "ཉན་ཙ་ན་ཡིད་མི་ཆེས་པ་ལྟ་བུ་གཅིག་གིས།",
    "དམིགས་པའི་ཡན་ལག་ཏུ་རྡོ་རྗེའི་བུ་གར་ཕཊ་དམར་སེར་མགོ་ཐུར་ལ་བསྟན་པ་ཞིག་ཡོད་པར་བསམ་དེའི་རྩེ་མོ་ནས་རྩ་བའི་བར་རྩེ་ནང་དུ་ཧཱུྃ་དཀར་པོ་མགོ་བོ་གྱེན་ལ་བསྟན་པ་བྲེང་ཆགས་སུ་ཡོད་པར་བསམ།",
    "རྡོ་རྗེའི་རྩེ་མོ་ནས་ནང་ན་ཡར་ཕྱི་ལོག་ཏུ་འབུ་རུ་རུ་བྱུང་སྟེ།",
    "གདམས་ངག་ཐང་དུ་ཕྱུང་ན་བྱིས་པའི་རྩེད་མོ་འདྲ།",
    "དེ་རྣམས་ནང་ནུབ་བཞིན་རྡོ་རྗེའི་བུ་གུ་རེ་རེ་བཅུག་པས།",
    "ཟབ་མོའི་རྩ་བ་མི་ཆོད་པས་།",
    "ཞབས་པད་གཙུག་གིས་བརྟེན་བྱས་ལ།",
    "ཟབ་མོ་གསུང་གི་བདུད་རྩི་འདི།",
    "རྒྱ་ཆེན་སྤྱོད་དང་ཟབ་མོ་ལྟ་བའི་བརྒྱུད།",
