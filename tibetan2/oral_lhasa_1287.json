    "དེ་ལྟར་ཚོགས་པ་རྒྱུ་བ་ན་རྣམ་པར་རྒྱུ་བའི་ལྷ་རྣམས་ཕན་ཚུན་དུ་གཏམ་བྱེད་དོ།",
    "རྣམ་པ་དུ་མར་རྣམ་པ་སྣ་ཚོགས་པའི་ལས་ཀྱིས་བྱས་པ་གང་༦ཡིན་པ་དེ་དག་རྣམས་ཀྱང་ཡང་དག་པ་ཇི་༐",
    "མུ་གེས་མནར་བ་རྣམས་ལ་སེམས་ཀྱིས་ཟིན་པར་༐",
    "ར་བ་ཏུ་དང་བར་གྱུར་པའི་ཡིད་ཀྱིས་ཟས་བསོད་པར་གྱུར་པ་རབ་ཏུ་མང་པོ་རྣམས་བྱིན་ལ་སྡོམ་པ་ཡང་དུས་ཚིགས་ལ་བཟུང་ངོ།",
    "ར་བ་ཏུ་གཏུམ་པ་མ་ཡིན་པའི་གཟུགས་ཞེས་བྱ་བ་དེས་འཐབ་བྲལ་བ་རྣམས་ཀྱི་མངའ་བ་དག་བྱས་ན་ས་ལས་བྱས་པར་གྱུར་ནས་ར་བ་ཏུ་ཤི་འཕོས་ཏེ་མིར་སྐྱེས་པར་གྱུར་པ་ལ་༢རྫུ་འཕྲུལ་ཆེན་པོ་དང་ལྡན་པ་མཆོག་ཏུ་གཟི་བཇིད་ཆེ་བའི་རྒྱལ་པོར་གྱུར་ཏོ།",
    "དེ་དེར་རྒྱལ་པོར་བྱས་པར་གྱུར།",
    "རབ་ཏུ་ཤི་འཕོས་པར་གྱུར་ཏེ།",
    "ལྷ་མ་ཡིན་དུ་སྐྱེས་པར་གྱུར་ན་ས་རྫུ་འཕྲུལ་ཆེ་བ་དང་།",
    "སྟོབས་ཆེན་པོ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "དེ་དེ་ལས་ཀྱང་ཤི་འཕོས་པར་གྱུར་ཏེ་སླར་ཡང་མིར་སྐྱེས་ནས་སྟོབས་ཆེན་པོ་དང་ལྡན་པའི་ཁྱིམ་བདག་ནོར་ཆེ་བར་གྱུར་ཏོ།",
    "མེ་ཕལ་ཆེན་པོ་རྣམས་ཀྱིས་སྲེག་པར་བྱེད་ད་དོ།",
    "བཅོམ་ལྡན་འདས་གསེར་ཐུབ་དེས་མཛད་པའི་མཆོད་རྟེན་དེའི་ན་ང་གང་ཡིན་པར་༡རྣམ་པ་དུ་མ་དང་།",
    "རྣམ་པར་རྟོག་པ་དུ་མར་ལས་དེ་དག་རྣམས་ད་མིགས་པ་དེར་ཉེ་བར་ཕྱིན་ནས་སླར་ཉིད་ཀྱང་ལས་ཀྱིས་བྱས་པ་དེ་དག་རྣམས་ལྟ་བར་འདོད་པས།",
    "རྟག་པར་ཡང་མཆོད་རྟེན་རྣམས་ལ་ལེགས་པར་བྱི་དོར་དང་།",
    "སྐྱེ་བ་རྣམས་ལེགས་པར་བྱས་པ་དང་།",
    "བཀུར་སྟི་དང་བཅས་པས་རྐྱེན་ཉེ་བར་གཞག་པར་གྱུར་པའི་ལས་དེས་ལུས་ཞིག་པ་ན་མཐོ་རིས་བདེ་འགྲོ་རྣམས་ལས་འཐབ་བྲལ་བའི་མངའ་བདག་ཏུ་སྐྱེས་པར་གྱུར་ཏེ།",
    "གཟི་བརྗིད་དང་ལྡན་པར་དུས་ཡུན་རིང་དུ་འདོད་པའི་ཡོན་ཏན་ལྔ་དང་ཡང་དག་པར་ལྡན་པས་བདེ་བ་རྣམས་ཉེ་བར་ལོངས་སྤྱད་༢ན་ས་ཤི་འཕོས་སོ།",
    "དེ་དེར་སྐྱེས་པར་གྱུར་པ་ན་སེམས་གཡོ་བར་གྱུར་པས་རི་དགས་བཤོར་༥ར་རོ།",
    "དེ་ལས་ཤི་འཕོས་ནས་ཀྱང་བྱ་ངང་ང་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་དག་རྣམས་དེའི་ལས་ཀྱིས་བྱས་པ་རྣམས་ཉེ་བར་རྟོགས་ནས།",
    "འདོད་པ་རྣམས་ཀུན་ཏུ་སྟེན་པར་མི་བྱེད་པ།",
    "ལས་ཀྱིས་བྱས་པ་༩རྣམས་ཀུན་ཏུ་རིག་པའི་ཕྱིར་ན་ལྷ་རྣམས་ཀྱི་བདག་པོར་གྱུར་ནས་ཀྱང་བག་མེད་པས་རྣམ་པར་རྒྱུ་བར་མི་བྱེད་དོ།",
    "དེའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་རྣམས་ཀྱང་རྗེས་སུ་མཐོང་བར་གྱུར་པ་ལ་དད་པ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "༣༥༥༧༧དང་ལྡན་པས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་བར་གྱུར་ལ།",
    "དེ་རབ་ཏུ་བྱུང་བར་གྱུར་ནས་ཀྱང་ཕྱིར་ཞིང་ཉིད་དུ་ཁ་ན་མ་ཐོ་བ་ཕྲ་རབ་ཙམ་ལ་ཡང་འཇིགས་པར་ལྟ་བར་གྱུར་ནས།",
    "དེ་དེ་ལས་རབ་ཏུ་ཤི་༡འཕོས་པར་གྱུར་ནས་ཀྱང་གླིང་བཞི་པའི་འཁོར་ལོས་སྒྱུར་༢བའི་རྒྱལ་པོར་གྱུར་ཏོ།",
    "དེ་ལས་ཀྱང་རབ་ཏུ་འཕོས་པར་གྱུར་ནས་གཞན་ཡང་རྒྱལ་ཆེན་རིས་བཞིའི་ལྷར་སྐྱེས་ས་སོ།",
    "མཐུ་སྟོབས་མཆོག་ཏུ་ཆེ་བ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "མཆོག་ཏུ་སྟོབས་དང་ལྡན་པའི་ལྷར་སྐྱེས་པར་གྱུར་ཏོ།",
    "ཤེས་རབ་རྣམས་ཕུན་སུམ་ཚོགས་པར་གྱུར་ཏོ།",
    "སྐྱེ་བ་གཞན་དག་རྣམས་གང་དང་གང་དག་ཏུ་སྐྱེས་པར་གྱུར་པ་ན་དེ་དེ་དག་རྣམས་སུ་ཡང་སྦྱིན་པ་དང་།",
    "ཀི་བ་བད་ག་པོར་ཉེ་བར་སྐྱེས་པར་གྱུར་ཏེ་མིང་ནི་མུ་སུ་ལུན་དྷ་ཡིན་ནོ།",
    "དེ་ལས་དེ་ད་ག་རྣམས་ཉིད་ཀྱི་རྒྱུན་རྣམས་ལེགས་པར་བསྒོམས་པར་གྱུར་ཅིང་སེམས་ཀྱིས་ཀྱང་ལས་རྣམས་ལེགས་པར་ཡོངས་སུ་༐",
    "སྦྱང་བ་བྱས་པར་གྱུར་པས་བག་དང་ལྡན་པར་གྱུར་ཏོ།",
    "སྲིད་སྐྱེས་སྡུག་བསྔལ་རྣམ་འཇོམས་པར།",
    "དེ་ལྟར་ཚོགས་པ་རྒྱུ་བ་ན་རྣམ་པར་སྤྱོད་པའི་ལྷ་དེ་དག་རྣམས་ཕན་ཚུན་དུ་གཏམ་བྱེད་དོ།",
    "གཞན་ཡང་མུ་སུ་ལུན་དྷ་དེ་ཉིད་དང་བཅས་པའི་ཚོགས་པ་རྒྱུ་བའི་ས་ན་རྣམ་པར་སྤྱོད་པའི་ལྷ་དེ་དག་མཆོད་རྟེན་དེ་ཉིད་ཀྱི་རྩིག་༨ལོགས་ལ་ལྟ་བར་རྩོམ་པར་གྱུར་ཅིང་ཤི་འཕོས་ན་ས་ཀྱང་འཐབ་བྲལ་གྱི་མངའ་བདག་འདི་གང་དུ་སྐྱེ་བར་འགྱུར།",
    "དེ་ནས་ལྷ་དེ་དག་རྣམས་ལྷའི་རིས་༡༡དེ་ལས་ཤི་འཕོས་པར་གྱུར་ན་ས་མུ་སུ་ལུན་དྷ་དེ་དང་ལྷན་༡༢ཅིག་ཏུ་ཐམས་ཅད་ཀྱང་བྱམས་པའི་གསུང་ར་བ་ལ་འཛམ་བུའི་གླིང་དུ་སྐྱེ་བར་འགྱུར་བ་མཐོང་སྟེ།",
    "ཡོན་ཏན་ཆེན་པོ་དང་ལྡན་པ་ད་ང་བདག་ཉིད་ཀྱི་སྐྱེ་བ་བཟང་པོར་གྱུར་པར་མཐོང་ངོ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་ལ་ཡང་རྒྱ་ཆེར་མཚན་ཉིད་སྟོན་པར་མཛད་དོ།",
    "དེ་དག་རྣམས་ཀྱིས་ཀྱང་དེ་དང་ལྷན་ཅིག་ཏུ་དེ་ཁོ་ན་བཞིན་ཐོས་པར་གྱུར་ཏོ།",
    "རྒྱས་པར་ནི་སྔ་མ་བཞིན་ནོ།",
    "ཡི་༢རངས་པར་གྱུར་པས་ལེགས་པར་གུས་པ་སྐྱེས་ཤིང་དགའ་བར་གྱུར་པས་བཞིན་གྱི་༢མདངས་རབ་ཏུ་དང་བ་དང་༤ལྡན་པར་གྱུར་ནས།",
    "ཐམས་ཅད་དང་ཡང་དག་པར་ལྡན་པ་རྣམས་གང་ན་བཅོམ་ལྡན་འདས་བྱམས་པ་བཞུགས་པ་དེར་བློ་རྣམ་པར་རྒྱས་༥པ་རྣམས་ཀྱིས་བརྒྱ་བྱིན་ཡོངས་སུ་བསྐོར་བ་བཞིན་དུ་ཉེ་བར་ལེགས་པར་འགྲོ་བའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འད་ས་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་ཉེ་བར་མཛེས་པར་གྱུར་པའི་སྐུ་བྱ་བ་ནི་རྒྱས་པར་ཏེ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་ཟད་པར་བྱེད་པ།",
    "ཀི་བརྣམས་སྟོན་པར་མཛད་དོ།",
    "འཁོར་འདི་དག་རྣམས་ནི་ཤིན་ཏུ་ཟབ་པར་གྱུར་པས་རྒྱ་མཚོ་ལྟ་བུའོ།",
    "འཐབ་བྲལ་གྱི་བདག་པོ་མུ་སུ་ལུན་དྷ་མགོ་བོས་ཞབས་དག་ལ་ལེགས་པར་ཕྱག་འཚོལ་ཅིག།",
    "འཁོར་དང་བཅས་པ་རྣམས་ཀུན་ནས་འོངས་པ་༤ལེགས་པར་འོངས་སམ།",
    "ཚངས་པར་སྤྱོད་པ་ལེགས་པར་སྤྱད་༥ད་མ།",
    "འདོད་པ་བསྟེན་པ་རྣམས་ཡོངས་སུ་སྤངས་པར་གྱུར་ཏ་མ།",
    "དེས་དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པས་བཀའ་སྩལ་པ་རྣམས་དེ་ལྟར་ཐོས་ན་ས་ཡིད་ར་བ་ཏུ་ད་གའ་ཞིང་གུས་པ་༧ལེགས་པར་སྐྱེས་པར་གྱུར་ཏོ།",
    "གང་དག་ལྷའི་འཇིག་རྟེན་དུ་དེའི་ལྷན་ཅིག་སྤྱོད་པར་གྱུར་པ་རྣམས་ས་སོ།",
    "གཞན་ཡང་ལྷའི་ཚོགས་དང་བ་ཅས་པ་༥རྣམས་ཀྱིས་ཞབས་གཉིས་ལ་མགོ་བོས་ཀུན་ནས་ཕྱག་བྱས་ཏེ།",
    "དེ་ནས་གཞན་ཡང་མུ་སུ་ལུན་དྷ་རབ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་འདོད་པའི་འཇིགས་པའི་སྐྱོན་སྟོན་པར་བྱེད་པས་ལྷ་དེ་དག་རྣམས་ཉིད་དང་ལྷན་ཅིག་ཏུ་ཚོགས་པ་རྒྱུ་བ་ན་སྤྱོད་པའི་ས་རྣམས་ལ་ཀུན་ཏུ་ལྟ་བར་བྱེད་དེ།",
    "ར་བ་ཏུ་ད་གའ་བར་གྱུར་པས་དེས་དཔྱོད་པར་བྱེད་པ་ན་སྣ་ཚོགས་པའི་ལྷའི་ཚོགས་རྣམས་ཀྱིས་གང་བ་ནགས་དང་།",
    "ཆུ་ཀླུང་ཕལ་པོ་ཆེ་རྣམས་ཀྱིས་གང་བར་གྱུར་པ་པད་མའི་རྫིང་བུ་དུ་མ་རྣམས་ལ་རྣམ་པ་ཐམས་ཅད་དུ་བྱ་ན་ང་ན་གནས་པ་རྣམས་ཀྱིས་རྣམ་པར་བརྗོད་པ་ད་གའ་བར་གྱུར་པ་སྒྲ་འབྱིན་པར་བྱེད་པ་དང་།",
    "ནགས་རྣམས་ཀྱིས་མཛེས་པར་གྱུར་པ་རྣམས་ན་ལས་ཀྱི་འབྲས་བུ་དམན་པ་དང་།",
    "ཁྱད་པར་དུ་འཕགས་པའི་ལས་ཀྱིས་ལྷའི་ཚོགས་རྣམས་གཅིག་ཏུ་སྲེད་པས་སྟེན་པར་བྱེད་པས་ཀུན་ཏུ་དང་བ་དང་།",
    "རབ་ཏུ་རངས་པས་རྔ་སྐད་ཡན་ལག་ལྔ་པ་ཤིན་ཏུ་བསྒྲགས་པར་གྱུར་ཅིང་།",
    "འཇིག་པའི་མཚན་ཉིད་གསུམ་དང་ལྡན་པ་འདུས་བྱས་རྣམས་ཀྱི་ས་རབ་ཀྱི་༦མཆོག་ཏུ་གྱུར་པའི་ལས་འདི་དག་རྣམས་ཐམས་ཅད་ཀྱང་བསྡུས་པ་དང་།",
    "དེ་ལ་ནིསྐྱོན་གསུམ་གྱིས་མ་རུངས་པར་གྱུར་པ།",
    "མཆོག་ཏུ་སྐྱིད་པར་གྱུར་པའི་ཚོགས་བདག་ཅག་༩རྣམས་གང་ཡིན་པ་ལ་ཡང་འཆི་བ་ཡང་༐",
    "འགྱིང་བ་རྩེ་བར་བྱེད་པས་ལྷན་ཅིག་ཏུ་མཆོག་ཏུ་སྐྱིད་པར་གྱུར་པ།",
    "དེ་ན་ས་རྒྱལ་པོར་དེ་དག་རྣམས་རྗེས་སུ་གཞུག་པའི་དོན་གང་ན་དེ་དག་རྣམས་ཡོད་པར་འགྲོའོ།",
    "དེ་དག་རྣམས་ཀྱང་ཉེ་བར་འོངས་པར་གྱུར་ཏོ།",
    "རྒོད་པར་བྱེད་ད་དོ།",
    "ཡོངས་སུ་སྤྱོད་པར་ཡང་བྱེད་དོ།",
    "ལྷ་རྣམས་ཀྱི་བདག་པོ་དེ་ཡིད་ར་བ་ཏུ་ཞི་བར་གྱུར་པས་གཞན་ཡང་གང་ན་ཚོགས་པ་རྒྱུ་བ་ན་རྣམ་པར་སྤྱོད་པའི་ལྷ་དེ་དག་རྣམས་ཀྱི་སའི་ཡུལ་ཕྱོགས་གཞན་ཅིག་ཡོད་པ་དེར་ཉེ་བར་ལེགས་པར་འགྲོ་སྟེ།",
    "པད་མའི་ཚལ་སྣ་ཚོགས་པ་རྣམས་ལ་བྱའི་ཚོགས་རྣམས་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "མཆོག་ཏུ་རྣམ་པར་དབེན་པའི་སའི་ཆ་༢ཤས་ན་གནས་པའི་མཆོད་རྟེན་མཐོང་ངོ།",
    "མཆོད་རྟེན་གཞན་རྣམས་ལ་ནི་ཚངས་པས་གསོན་པའི་ལྷ་རྣམས་ཉིད་ཀྱིས་བརྒྱུས་༡པར་གྱུར་ལ།",
    "སྔོན་བསྒོམས་པའི་སེམས་དང་ལྡན་པ་རྣམས་ལ་ཕན་པའི་དོན་དུ་དང་རྗེས་སུ་འཇུག་པར་བྱ་བའི་ཕྱིར་མཆོད་རྟེན་འདིའི་རྩིག་ལོགས་ལ་བྱས་པ་རྣམས་ཡིན་ནོ།",
    "སྲིན་བུ་མེ་ཁྱེར་དང་ཉི་མའི་ཁྱད་པར་བཞིན་དུ་དེའི་དཔལ་རྣམས་ལ་དཔེ་མེད་པ་ཡིན་ནོ།",
    "བསམ་གཏ་ན་ལ་སྙོམས་པར་འཇུག་པ་དང་།",
    "མྱ་ངན་ལས་འདས་པར་འགྲོ་བ་དང་།",
    "རང་བཞིན་གྱིས་མ་རིག་པས་གཡོགས་པ་རྣམས་ཀྱིས་ནི་ཆུ་བོ་ལྔ་ལེགས་པར་རྒལ་ནུས་པ་ཡང་མ་ཡིན་ནོ།",
    "འདིས་རབ་ཏུ་བྱུང་བ་ནི་དོན་མེད་པར་འགྱུར་རོ།",
    "ཐོས་པ་མེད་པ་དང་ཤེས་པ་མེད་པའི་ཕྱིར་ན་འདིའི་ཡིད་ཀྱིས་བསམས་པའི་མྱ་ངན་ལས་༧འདས་པར་འགྲོ་བ་ཡང་འགྲུབ་༨པར་མི་འགྱུར་རོ།",
    "ཀིཾད་ང་པོ་ཁོ་ན་ར་བསམ་གཏ་ན་ལ་སྙོམས་པར་ཞུགས་པ་ན་༡རྣམ་པར་སྲེག་པར་གྱུར་ནས་མཆོག་ཏུ་ཡང་ཡིད་རྣམ་པར་གཡེང་བར་བྱེད་པ།",
    "ཕྱི་ན་ས་འགྱོད་པར་བྱེད་པ་པོ་རབ་ཏུ་བྱུང་བ་ཐམས་ཅད་ཀྱིས་རྣམ་པར་སྤང་བར་བྱ་བ་འདི་ལྟ་སྟེ།",
    "སེམས་ཤིན་ཏུ་རྣམ་པར་གཡེང་བ་རབ་ཏུ་གཡོ་བའི་རྟོག་པ་རབ་ཏུ་གཡོ་བའི་བློད་ང་རྣམ་པ་དེ་ལྟ་བུ་ཉིད་ལ་སྟེན་༤པར་བྱེད་པ་དང་།",
    "གང་དག་ལ་ཡོད་པ་གང་ཡིན་པའི་སེམས་རྣམ་པར་གཡེང་བར་གྱུར་པ་ན་གང་རྟག་ཏུ་ཡང་གར་དང་བྲོ་ལ་དགའ་བས་ཀུན་ཏུ་ལྟར་འགྲོ་བ་ལ་སོགས་པས་དེ་མ་བསྡམས་པ་ཁོ་ན་ར་རྟག་པར་སྤྱོད་པར་འགྱུར་ཏེ།",
    "དེ་ནི་བློ་རྣམ་པར་གཡེང་བར་གྱུར་པ་ཐོས་པ་དང་མི་ལྡན་པ་ཡིན་ཏེ།",
    "གཞན་གྲོགས་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་ཀྱིས་རྣམ་པར་སྨོད་པར་བྱེད་དོ།",
    "རྙེད་པ་དང་བཀུར་སྟིས་ཟིལ་གྱིས་མན་ན་པར་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ལ་འདིས་བདག་ཉིད་རང་ཆུད་གཟནནས་གཞན་རྣམས་ཡང་ཆུད་གཟོན་པར་བྱེད་ད་དོ།",
    "བདག་ཉིད་རང་ཡོངས་སུ་ཉམས་པར་འགྱུར་བའི་བསམ་པ་ལ་སྦྱོར་ར་རོ།",
    "དེ་དེ་ལ་ཡང་དད་པར་མི་བྱེད་དོ།",
    "དེ་དེ་ལ་ཡང་ལོག་པར་སྨྲ་བར་འགྱུར་རོ།",
    "དེ་ནས་དེའི་དུས་ན་བཅོམ་ལྡན་འདས་འོད་སྲུང་དེས་ཚིགས་སུ་བ་ཅད་པ་གསུངས་པ།",
    "ཡིད་ནི་རྣམ་པར་གཡེང་བྱེད་པ།",
    "ཚངས་པར་སྤྱོད་པ་ཆུད་གཟོན་པའོ།",
    "ཚངས་པར་སྤྱོད་པ་ཆུད་གཟོན་པའོ།",
    "ཡིད་ལེགས་པར་སྡོམ་པར་བྱེད་པ་དང་།",
    "ཡིད་ཤིན་ཏུ་བར་ཡང་མཉམ་པར་གཞག་པར་ཡང་གསུམ་གྱིས་ཏེ།",
    "དེ་ལ་ཐམས་ཅད་ཉིད་ཀྱང་ལམ་དེ་དག་རྣམས་ལས་སེམས་མཉམ་པར་བཞག་པར་འགྱུར།",
    "སེམས་མཉམ་པར་བཞག་པ་མ་ཡིན་པ་རྣམས་དང་།",
    "ལམ་གསུམ་སུན་འདོན་པར་བྱེད་པ་ཡང་ཡིན་ནོ།",
    "གཡང་ས་རྣམས་བཞིན་དུ་བློ་དང་ལྡན་པའི་དགེ་སློང་བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་རྟག་ཏུ་ཡོངས་སུ་སྤང་བར་བྱའོ།",
    "དེ་དག་རྣམས་བག་མེད་པར་གྱུར་པ་ཡང་ལན་གྲངས་གཞན་ལ་མྱོང་བར་འགྱུར་བའི་ལས་ཀྱིས་༤གར་དང་གར་བྱེད་པ་རྔ་ཛྷ་ལ་ལ་ཀ་དང་།",
    "གླུ་མཁན་དུ་གྱུར་པ་གཞན་གྱི་ཁྱིམ་གྱི་སྒོར་བཀྲེན་པར་གྱུར་པའི་༐",
    "ཤེས་བྱ་ཉི་མ་སྟེན་པར་བྱེད་པ་རྣམས་སུ་དང་།",
    "དེ་ལྟར་ཁྱེད་རྣམས་ཡིད་ལེགས་པར་ལས་སུ་རུང་བར་གྱིས།",
    "ཚོགས་པ་འདུས་པ་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བ་དང་།",
    "འོང་བས་ཀུན་ཏུ་ཕྲད་པའི་ཚོགས་པ་འདུས་པའི་ཞེན་པ་དང་རྣམ་པར་བྲལ་བ་དང་སྤྲོ་བ་མེད་པར་གཅིག་པུ་དགའ་བ་དང་།",
    "དགེ་སྦྱོང་མ་ཡིན་པར་དགེ་སྦྱོང་དུ་ཁས་འཆེས་༢པ།",
    "གཉིས་པ་ཡང་རབ་ཏུ་སྤང་བར་བྱ་ཞིང་སྤྱད་པར་ནི་མི་བྱའོ་། འདི་ཡང་གང་ཞེ་ན།",
    "དེ་དེ་ལྟར་བྱེད་པ་ན་འདོད་པ་རབ་ཏུ་༧སྟོབས་དང་ལྡན་པར་འགྱུར་རོ།",
    "དེ་འདོད་པས་ཟིལ་གྱིས་མནན་པར་གྱུར་ནས་སེམས་ཀྱིས་༐",
    "ཡུལ་ཆུང་རྣམས་ནས་ཡུལ་གྱི་ལྗོངས་རྒྱུ་བའི་སྒོ་ནས་ངས་༡༢མང་དུ་བསྡུ་བར་བྱའོ་ཞེས་དེ་ལྟར་བསམས་༡༢པར་གྱུར་པས་བརྣབ་སེམས་འཕེལ་བར་འགྱུར་རོ་༡༢།",
    "དེ་བརྣབ་སེམས་ཀྱིས་ཟིལ་གྱིས་མནན་པར་གྱུར་པའི་ཡིད་ཅན་དྲི་མ་རྣམས་ཤིན་ཏུ་ད་པྱོད་༡༢པར་བྱེད་པ་པོ་ཡིན་གྱི་བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་སེམས་པ་པོར་ནི་མི་འགྱུར་རོ།",
    "གལ་ཏེ་མེད་པར་གྱུར་ན་དེས་ཏིལ་ཀུན་ན་ས་བཙིར་༢ཞིང་ཏིལ་རྣམས་ཀུན་ཏུ་འཚིར་བར་བྱེད་དོ།",
    "ཀི་བ་རྣམས་ཀྱིས་༡རྟེན་དུ་གྱུར་པ་རྣམས་ནོར་གྱི་དོན་དུ་དང་པོ་ཁོ་ནར་རྐོ་བར་བྱེད་པའམ་གཅོད་པར་༐",
    "དེས་བརྐོས་པར་གྱུར་པ་ན་ས་ལ་གནས་པར་གྱུར་པའི་སྲོག་ཆགས་ཤུན་པ་དང་རྩ་བ་ལ་རྟེན་༢པ་རྣམས་འཛིན་པར་བྱེད་པ་དང་།",
    "ཚད་རྣམས་ཀྱང་རབ་ཏུ་བཤིག་པར་བྱེད་དོ།",
    "གཅོད་པས་ནི་དེའི་ནང་ན་གན་ས་པའི་སྲིན་བུ་རྣམས་ཀྱང་གསོད་པར་བྱེད་དོ།",
    "དེའི་ཚེ་རྟེན་པར་གྱུར་པའི་སྲོག་ཆ་གས་རྣམས་ཀྱང་གསོད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་སེམས་ངན་པ་ལ་སྐྱོན་སྟོབས་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པའི་རང་བཞིན་ཅན་ཡང་མ་ཡིན་ནོ།",
    "རྣམ་པར་ཆུད་གཟན་༡༢ཞིང་རྣམ་པར་ཆུད་གཟོན་པར་བྱེད་ད་དོ།",
    "སྟོབས་ཀྱིས་ཀྱང་བཟློག་པར་མི་ནུས་ཏེ།",
    "དགྲ་བོ་འདི་ནི་ཤིན་ཏུ་སྟོབས་དང་ལྡན་པས་དེ་བརྟན་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "སྟོབས་ཆེན་པོས་བརྩོན་པ་དུ་མས་ཀྱང་འཇིག་རྟེན་ལས་འདས་པའི་ཕྱི་བཞིན་རྗེས་སུ་འབྲང་བར་འགྱུར་བས་ཟིལ་གྱིས་མནན་ནས་དེས་ཤིན་ཏུ་སྤྲོ་བའི་གནས་ལ་འདྲིས་པར་བྱེད་ཅིང་རྣམ་པར་རྟོག་པ་དང་མཉམ་པར་འཇུག་པ་གང་ཆེས་སྟོབས་དང་ལྡན་པས་རྗེས་སུ་འབྲང་བ།",
    "འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་རྣམས་བཟོད་པར་བྱས་ནས་གང་དག་ལུས་རབ་ཏུ་བྱུང་བར་གྱུར་པ།",
    "བཟློག་པར་དཀའ་༨བའི་འདོད་ཆ་གས་ཞེ་སྡང་གཏི་མུག་གང་ཡིན་པ་འདིས་འདོད་པའི་ཐག་པས་བཅིངས་ན་ས་ཤིན་ཏུ་བག་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཅེ་བར་གཞག་པ།",
    "༣༨༡མེད་པར་འཇིག་རྟེན་ཕ་རོལ་ཏུ་འཁྲིད་༡པར་བྱེད་དོ།",
    "དེ་ནས་དེའི་ཚེ་བཅོམ་ལྡན་འདས་དེས་ཚིགས་སུ་བཅད་༢པ་གསུངས་པ་ཇི་ལྟར།",
    "ཐོག་མཐར་མཆོག་ཏུ་ལེགས་པར་ནི།",
    "འདོད་པས་ཟིལ་གྱིས་གནོན་པར་བྱེད་དོ།",
    "དེ་ལྟར་དྲི་མ་རྣམས་ཀྱིས་ཟིལ་གྱིས་གནོན་པར་འགྱུར་བའི་སེམས་གཡོ་བས་གཏི་མུག་སྟོབས་ཆེ་བར་འགྱུར་རོ།",
    "ཀིཔར་འགྱུར་རོ།",
    "བསམ་གཏན་ལ་སྙོམས་པར་ཞུགས་པ་ན་རྣམ་པར་སྲེག་༧པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ལས་རྣམ་པ་སྣ་ཚོགས་པ་རྣམས་ཀྱིས་འཇིག་རྟེན་འདི་༡བོར་ནས་ཁ་དོག་སྣ་ཚོགས་པར་གྱུར་པ་གཞན་རྣམས་བྱེད་དོ།",
    "དེ་ལ་རབ་ཏུ་བྱུང་བ་རྣམས་ཀྱིས་རྟག་པ་ཁོ་ན་ར་ལས་རྣམ་པ་སྣ་ཚོགས་པ་རྣམས་ཤེས་པར་བྱ་སྟེ།",
    "འདུན་པས་རབ་ཏུ་སྦྱིན་པ་མདུན་༢དུ་བྱས་པས་མཆོག་ཏུ་རྒྱ་ཆེ་བར་གྱུར་པ་དྲི་མ་རྣམས་དང་།",
    "སེར་སྣའི་དྲི་མ་དང་རྣམ་པར་བྲལ་བར་གྱུར་པ།",
    "ཁྱད་པར་དུ་འཕགས་པའི་ལས་རྣམས་ཀྱི་ཚོན་མང་པོས་རྣམ་པར་བཀྲ་བར་བྱས་ས་སོ།",
    "གཞན་ཡང་འགྲོ་བ་གཞན་ལ་རྣམ་པར་བལྟབར་བྱ་སྟེ།",
    "ཡང་འགྲོ་བ་གཞན་ལ་རྣམ་པར་བལྟ་བར་བྱ་སྟེ།",
    "༣༨༥ནི་ནག་པོའི་ཚོན་རྣམས་ཉིད་ཀྱིས་ཀྱང་རྣམ་པར་བཀྲ་བར་བྱས་ཏེ།",
    "ཁ་དོག་ནག་པོར་གྱུར་པའི་མུན་པ་རྣམས་ན་རྒྱུ་ཞིང་སྤྱོད་པར་འགྱུར་རོ།",
    "དེ་ལ་གང་དག་མཆོག་ཏུ་སྡུག་བསྔལ་བར་གྱུར་པ་ཕན་ཚུན་དུ་འཇིགས་པས་འཇིགས་པར་གྱུར་པ་དེ་དག་རྣམས་ནི་ནག་པོའི་ཚོན་ཉིད་ཀྱིས་རྣམ་པར་བཀྲ་བར་བྱས་ས་སོ།",
    "དེ་དག་རྣམས་ནི་ནག་པོའི་ཚོན་གྱིས་རྣམ་པར་བཀྲ་བར་བྱས་ས་སོ།",
    "གང་དག་གསོད་པའི་འཇིགས་པ་ཅན་མ་ཡིན་པ་དེ་དག་རྣམས་ནི་དམར་པོའི་ཚོན་གྱིས་བཀྲ་བར་བྱས་ཏེ།",
    "དེ་ལྟར་འགྲོ་བ་ལྔ་པོ་དེ་དག་ཕལ་ཆེར་ཚོན་སྣ་ལྔས་བཀྲ་བར་བྱས་ས་སོ།",
    "བག་མེད་པར་རྗེས་སུ་ཚོལ་བར་གྱུར་པས་ཕན་༣༨༦ བཀའའགྱུར།",
    "བཀྲེས་པ་དང་སྐོམ་༢པས་བྱས་པའི་སྡུག་བསྔལ་རྣམས་ཀྱིས་ཉེ་བར་བཅོམ་པར་གྱུར་པའོ།",
    "དེས་དེ་ལྟར་རྣམ་པར་ངོ་མཚར་བ་རྣམས་ལ་མ་སྤྱད་པར་ཉམསསྨད་པ་དང་།",
    "དེ་ལ་མཆོག་ཏུ་ཡང་རྣམ་པར་བཀྲ་བར་གྱུར་པ་དེ་དག་ཉིད་ནི་འདི་ལྟ་སྟེ།",
    "དགའ་བར་བྱེད་པའི་རྟག་ཏུ་གར་བྱེད་པར་གྱུར་པའི་བདེ་བ་དང་སྡུག་བསྔལ་རྣམས་ད་མྱལ་བ་དང་།",
    "ད་གེ་སྦྱོང་རྣམ་པར་འཚིག་པར་གྱུར་པའོ།",
    "ཇི་སྲིད་ཚོན་གཞན་རྣམས་ཀྱིས་རྣམ་པར་བཀྲ་བར་བྱས་པ་ལ་དཔྱོད་པར་བྱེད་དོ།",
    "ཇ་༨༧ཡིད་དུ་འོང་བར་གྱུར་པ་ཡུལ་གྱི་འདོད་ཆགས་སྐྱེད་པར་བྱེད་པ་རྣམས་མཐོང་བར་གྱུར་ན་དེ་དེ་དག་རྣམས་ལ་ཆགས་པར་འགྱུར་རོ།",
    "འདི་ལྟར་སེམས་པར་བྱེད་དེ།",
    "གང་མྱ་ངན་ལས་འདས་པར་འགྲོ་བར་ཡང་འགྱུར་རོ།",
    "རབ་ཏུ་རྟོག་པར་མི་བྱེད་ད་དོ།",
    "དེ་ལྟར་ཡང་ད་གེ་སྦྱོང་ངན་པར་གྱུར་པ་འདིས་སྤྱོད་པར་མི་བྱེད་དོ།",
    "དེའི་ཕྱིར་ན་བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་ན་རྣམ་པར་སྲེག་༢པར་འགྱུར་བའི་ལས་རྣམས་མི་བྱའོ།",
    "རྣ་བས་རྣམ་པར་ཤེས་པར་བྱ་བའི་སྒྲ་ཡིད་དུ་འོང་བ་རྣམས་ཡང་༤སྟེ།",
    "རབ་ཏུ་རྟོག་པར་མི་བྱེད་ད་དོ།",
    "དེའི་ཚེ་འདིས་དཀར་པོའི་མཐའ་༢རྣམས་བྱས་པར་གྱུར་པ་ཡིན་ནོ།",
    "མཆོག་ཏུ་རྒྱ་ཆེ་བའི་ཚོན་དེས་ཀྱང་ལྷ་དང་མི་རྣམས་སུ་སྐྱེ་བར་འགྱུར་བར་མཆོག་ཏུ་རྣམ་པར་བཀྲ་བར་བྱས་པར་གྱུར་པ་ཡིན་ན་ནོ།",
    "གཞན་ཡང་སྒྲ་དེ་ཉིད་ཐོས་པར་གྱུར་ནས་སྨཱ་ནཔ་བློ་རབ་ཏུ་དམན་༦པ་ཐོས་པ་དང་མི་ལྡན་པ།",
    "བྱིས་པ་ས་སོའི་སྐྱེ་བོ་དེ་ལྟར་རབ་ཏུ་འཇུག་པར་བྱེད་དོ་ཇི་ལྟར་ཡིད་དུ་འོང་བའི་སྒྲ་ཚིམ་པ་སྐྱེད་པར་བྱེད་པ།",
    "གྱུར་པ་༢༢དེ་ཉིད་ཀྱི་དེ་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པས་རབ་ཏུ་རྟོག་པར་བྱེད་དོ།",
    "འདུན་༩པ་སྐྱེད་པར་བྱེད་དོ།",
    "བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་ན་རྣམ་པར་སྲེག་པར་འགྱུར་རོ།",
    "ཡུལ་གྱིས་འཇོམས་པར་བྱེད་དོ།",
    "འདི་ལྟར་སྣའི་རྣམ་པར་ཤེས་པསདྲི་རྣམས་ལའོ།",
    "བྱུང་ནས་ཀྱང་ཕྱིར་ལྡོག་པར་འགྱུར་རོ།",
    "གཞན་ཡང་དྲི་ཞིམ་པ་དང་མི་ཞིམ་པའི་དྲི་དེ་དག་རྣམས་ཉིད་སྣོམ་པར་བྱེད་པ་ན་དྲི་དེ་དག་རྣམས་ཉིད་ལ་ཆགས་པར་༧བྱེད་དོ།",
    "གཞན་ཡང་ལས་རྣམ་པར་བཀྲ་བ་རྣམས་ལ་འདི་ལྟ་སྟེ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པས་རོ་ཡིད་དུ་འོང་བས་༢ཡིད་དུ་འོང་བར་འགྱུར་བའི་རོ་རྣམས་མྱངས་པར་གྱུར་ན་ཡང་དགའ་བར་མི་བྱེད་དོ།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དང་ལྡན་པས་རོ་དེ་ཉིད་རྣམ་པར་འབྱེད་པར་བྱེད་པ་སྟེ།",
    "ཇི་ལྟར་རོ་འདི་དག་རྣམས་ནི་བྱུང་ནས་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "ལག་པའི་མཐིལ་གྱིས་བཅུག་པར་གྱུར་པའི་ཟས་འདི་དག་རྣམས་ནི་ལྕེ་ལ་༐",
    "རོ་དེ་དག་རྣམས་ཉིད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་འདིས་སེམས་པར་བྱེད་དོ།",
    "དེས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པས་རྣམ་པར་འབྱེད་པར་ཡང་བྱེད་དོ།",
    "འདི་ནི་དཀར་པོའི་ཁ་དོག་རྣམས་དང་ཡང་དག་པར་ལྡན་པས་ལྷ་དང་མི་རྣམས་སུ་མཆོག་ཏུ་སྐྱིད་པར་འགྱུར་རོ།",
    "དྲི་དང་ལྡན་པར་གྱུར་པ།",
    "མཆོག་ཏུ་གཙང་བར་གྱུར་པ་ཞེས་ཟས་དེའི་རྒྱགས་པས་རྒྱགས་ནས།",
    "ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པ་རྣམས་སྤྱོད་པ་འདི་དག་རྣམས་ནི་ཚོན་ནག་པོས་རྣམ་པ་སྣ་ཚོགས་པར་བྱས་ནས་དུད་འགྲོར་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་ལ་གང་དག་ཡང་དག་པ་ཇི་ལྟ་བ་ཁོ་ན་ར་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པས་འཁྲིད་༧པར་བྱེད་དེ།",
    "ཉེ་བར་འཆེ་བ་ཐམས་ཅད་ཀྱིས་འཁྲིདཔར་བྱེད་པ་ཡིན་ནོ།"
  ]
}