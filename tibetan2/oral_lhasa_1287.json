    "ཕུན་སུམ་ཚོགས་པའི་མཐའ་ཐམས་ཅད་ནི་རྒུད་པར་༐",
    "གཞན་ཡང་འཕྲུལ་དགའི་ལྷ་དེ་དག་རྣམས་ཉིད་ཀྱི་རྒུད་པར་༐",
    "དེ་ནས་དེའི་ཚེ་བཅོམ་ལྡན་འདས་དེས་ཚིགས་སུ་བཅད་པ་གསུངས་པ།",
    "དེ་ནི་དེ་བཞིན་གཤེགས་པས་གསུངས།",
    "བྱ་བར་མཁས་པས་ཤེས་པར་གྱིས།",
    "ལྷ་རྣམས་ལྷ་རྫས་ཀྱི་མ་རྙིངས་༤པའི་མེ་ཏོག་རྣམས་ཀྱིས་ཉེ་བར་བརྒྱན་པར་གྱུར་ཏོ།",
    "བག་མེད་པ་རྣམས་༩བག་མེད་པར་སྤྱོད་པའི་རྒུད་པ་དང་པོ་སྟེ།",
    "བག་མེད་པས་བག་མེད་པར་སྤྱོད་པ་རྣམས་ལ་ཀྱེ་མ་བར་ཆད་འདི་དག་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་འོང་བར་འགྱུར་ཏེ།",
    "འོན་ཀྱང་ཉམས་པར་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "ཇི་ལྟ་བུའི་བར་ཆད་བདག་ཅག་ལ་ཉེ་བར་འོངས་པར་གྱུར་ཏེ།",
    "འཆི་བའི་དུས་སུ་གྱུར་པ་ལས་གཞན་རྣམས་ཀྱང་རྒུད་པའི་རྒྱུ་འདི་ཉིད་ཀྱིས་འཆི་འཕོས་སོ་ཞེས་རྗོད་༨པར་བྱེད་པ་དེ་ཡང་ཐོས་ནས་བསོད་ན་མས་ཟད་པའི་ལྷ་དེ་ལྷ་རྫས་ཀྱི་ཡུལ་གཞན་དག་རྣམས་བཏང་བས་བྱས་པའི་སེམས་ཀྱི་གདུང་བས་ཀུན་ནས་སྲེག་༩པར་གྱུར་པ་ན་ཇི་ལྟར་ད་མྱལ་བ་རྣམས་ཀྱི་མེ་ཡིན་པ་དེ་བཞིན་དུ་ལུས་སྲེག་༡༢པར་བྱེད་དེ་༡༡།",
    "ལྷ་གང་ལེགས་པར་བྱས་པའི་ལས་ཀྱི་མཐའ་ལ་སྤྱད་པ་རྣམས་ཟད་པར་གྱུར་པ་དེ་དག་རྣམས་ཀྱི་རྒྱན་རྣམས་གང་དག་ཡིན་པ་དེ་དག་རྣམས་ནི་ཡན་ལག་ལྔ་པོ་རྣམས་དང་མཚུངས་པར་འགྱུར་ཞིང་འོང་སྟེ།",
    "སྙན་༡༢པའི་རང་བཞིན་དང་དགའ་བར་འགྱུར་བའི་སྒྲ་དང་ཡིད་རབ་ཏུ་རངས་པར་བྱེད་པ་དེ་དག་རྣམས་གཞི་དང་བཅས་པ་སྒྲུབ་པར་བྱེད།",
    "ཀི་བཾ་༢ དོ་། སྒྲ་འགའ་ཞིག་ནི་རྣམ་པར་གྱུར་པ་དང་ལྡན་པ་ཡིན་ནོ།",
    "སྒྲ་རྣམས་ནི་ལས་ཀྱིས་བྱས་པ་ཡིན་ན་ནོ།",
    "དེ་ལྟར་ལས་ཀྱིས་བྱས་པའི་རྒྱན་རྣམས་ཀྱི་སྒྲ་དེ་དག་ཐོས་ན་ས་ཤིན་ཏུ་ཡིད་མི་བདེ་བར་འགྱུར་རོ།",
    "གང་དག་འདུས་བྱས་སུ་གྱུར་པ་རྣམས་གང་ཞིག་འཇིག་པར་མི་འགྱུར་བ་དང་།",
    "གང་ཞིག་ཟད་པར་མི་འགྱུར་བའི་གནས་དེ་ནི་ཁམས་གསུམ་ན་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་ཟད་པར་བྱེད་པ།",
    "བག་མེད་པ་རྣམས་འཇོམས་པར་བྱེད་པ་པོ་༢།",
    "ལྷ་དང་མི་རྣམས་ལ་ཕན་པར་མཛད་པ།",
    "བཀྲ་ཤིས་པ་མཐར་ཐུག་པར་གྱུར་པ་རྣམས་ནི་བསྟན་པ་ཡིན་ན་ནོ།",
    "དེ་ལ་ཁྱེད་ཀྱིས་དེ་དག་རྣམས་ནི་ཐོས་པར་གྱུར་ན་དེ་ལ་དེ་བཞིན་གཤེགས་པ་༐",
    "ཇི་ལྟར་བདག་ཅག་རྣམས་ལ་ཕན་པར་འགྱུར་བ་དང་།",
    "འདི་ན་༧རིགས་ཀྱི་བུ་དག་ཐོས་པ་དང་ལྡན་པར་གྱུར་པ་དང་།",
    "སོ་སོར་རྣམ་པར་དཔྱོད་པའི་བློ་གྲོས་དང་།",
    "གཞན་རྣམས་ཀྱང་དེ་དང་ངང་ཚུལ་མཚུངས་ན་རྗེས་སུ་སྟེན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "འཕྲོགས་ཤིང་༤དེ་བཞིན་དུ་ཡོན་ཏན་བདུན་དང་ལྡན་པའི་གྲོགས་པོ་རྣམས་ལ་སྟེན་པར་བྱེད་པའོ།",
    "ཇི་ལྟར་བརྫོད་པ་དེ་ཁོ་ན་བཞིན་དུ་སྒྲུབ་པར་བྱེད་པའོ་། གཞན་དག་དེ་དང་ལྷན་ཅིག་ཏུ་སྤྱོད་པ་རྣམས་ལ་ཡང་དེ་དག་རྣམས་སྡོམ་དུ་འཇུག་ག་གོ།",
    "རྟག་པར་རྒྱུན་དུ་ཡང་ལུས་དང་ངག་དང་།",
    "ཕྱི་རོལ་དང་ནང་ཀུན་ན་ས་ཡོངས་སུ་དག་པའི་གསེར་དང་མཚུངས་པར་གྱུར་པ་སྟེ་༡།",
    "འདི་གང་ད་ག་བྱེད་པ་དེ་ཀུན་ནས་མཆོག་ཏུ་རྣམ་པར་དག་པར་བྱེད་དོ།",
    "དེ་བརྟན་པོར་འཛིན་པར་བྱེད་ད་དེ།",
    "དེ་ལྟར་བརྟན་པོར་འཛིན་པར་བྱེད་པ་ཡིན་ལ་༤།",
    "འདི་ན་ཡོན་ཏ་ན་དེ་དག་དང་མཚུངས་པའི་བདག་ཉིད་ཅན་གཞན་རྣམས་ལ་ཡང་སྟེན་༧པར་བྱེད་ལ།",
    "ཐོས་པ་དང་ལྡན་པར་གྱུར་པ་དང་།",
    "སྒྲུབ་པ་དང་ལྡན་པར་གྱུར་པ་དང་།",
    "ལེ་ལོ་མེད་པར་གྱུར་པ་དང་།",
    "དེ་དག་ཐོས་ནས་ཀྱང་༨རྒོད་བག་དང་ལྡན་པར་མི་འགྱུར་རོ།",
    "ཤེས་པ་རྣམས་ཀྱིས་ཆོག་༡ཤེས་པར་མི་བྱེད་པར་འགྱུར་རོ།",
    "གཞན་དག་རྣམས་ལ་ཡང་ལན་ཅིག་མ་ཡིན་ཞིང་ལན་ཅིག་མ་ཡིན་པར་འདྲིའོ།",
    "རྩོམ་པ་ཞན་པར་གྱུར་པའི་སྐྱེས་བུ་རྣམས་ཀྱིས་ནི་འཇིག་རྟེན་པའི་དོན་ཐམས་ཅད་ལ་ཡང་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་ལས་འདས་པ་ལ་ཡང་བརྩོན་འགྲུས་ད་མན་པ་རྣམས་དང་སྤྲོ་བ་མེད་པ་རྣམས་ཀྱིས་ནི་ད་གོས་པ་ཐམས་ཅད་ལས་ཡོངས་སུ་ཉམས་པར་འགྱུར་རོ།",
    "བདག་ཉིད་ཐམས་ཅད་ཀྱིས་གན་ས་སྐབས་ཐམས་ཅད་དུ་སྙོམ་ལས་ཀྱིས་ཉེ་བར་བཅོམ་པའི་སྐྱེས་ྐྱེས་བུ་བརྩོན་འགྲུས་དམན་པ་རྣམས་ནི་གཟི་བརྗིད་ཀྱང་ཕྱུགས་རྣམས་དང་མཚུངས་པར་འགྱུར་རོ།",
    "ཤེས་པ་དང་རྣམ་པར་ཤེས་པ་དང་།",
    "བགྲོད་པར་བྱ་བ་དང་།",
    "བགྲོད་པར་མི་བྱ་བ་རྣམས་ཀྱང་རྣམ་པར་མི་ཤེས་སོ།",
    "དེ་ལྟར་ཡང་མར་མེ་ལྟ་བུའི་ཤེས་རབ་ཀྱིས་ཐམས་ཅད་རྟོགས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དོན་ཐམས་ཅད་ཉམས་པར་བྱེད་པར་འགྱུར་རོ།",
    "གཞན་གྱི་ཁྱིམ་ལ་ཉེ་བར་སྟེན་༥པར་བྱེད་པ།",
    "གཞན་དུ་ནི་བརྩོན་འགྲུས་བརྩམས་པའི་བརྩོན་འགྲུས་དང་ལྡན་པ་སྤོང་༢བ་དང་ལྡན་པ་རྣམས་ནི་དོན་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ།",
    "མྱ་ངན་ལས་འདས་པའི་མཐར་ཐུག་པར་ཡང་འགྱུར་ན་གཞན་འཇིག་རྟེན་པའི་རྣམས་དང་།",
    "དེ་ནས་དེའི་ཚེ་བཅོམ་ལྡན་འདས་ཐམས་ཅད་སྐྱོབ་དེས་ཚིགས་སུ་བཅད་པ་གསུངས་པ།",
    "ལོག་པར་ལྟ་བ་ཉིད་ཀྱང་སྟེ།",
    "ཡུལ་དུས་ལེགས་པར་རྩོམ་མིན་ཞིང་།",
    "རྣམ་པར་སྤངས་པས་གང་ལ་ཡང་།",
    "རྩ་བ་ལེ་ལོ་ཡིན་པར་བརྗོད་། མི་རྣམས་སྐྱོན་ནི་རྗེས་འབྲེལ་བཅས།",
    "ལེ་ལོ་མེད་པ་བརྩོན་འགྲུས་བརྩམས་པར་གྱུར་པའི་ལྷའམ་མི་རྣམས་ཡང་༧རུང་སྟེ།",
    "དོན་རྣམས་ཐམས་ཅད་མེད་པར་མི་༨འགྱུར་རོ་། ཐམས་ཅད་ལས་༩དུས་ཐམས་ཅད་ཀྱི་ཚེ་ཐམས་ཅད་དུ་ཡོངས་སུ་ཉམས་པར་མི་འགྱུར་རོ།",
    "དྲན་པ་དང་ལྡན་པ་རྣམས་ནི་བག་མེད་པར་མི་འགྱུར་རོ།",
    "དེ་ཡང་ནས་ཡང་དུ་ཡང་དོན་གཞན་རྣམས་རྩོམ་༤པར་བྱེད་དོ།",
    "དེ་ལས་སྐྱེས་པའི་ཡིད་ལ་བྱེད་པས་ཁྲིད་པར་མི་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འདི་ན་མཛེས་པར་གྱུར་པ་རྣམས་ཀྱིས་དྲ་ན་པས་སེམས་ཀྱི་རྒྱུད་ད་ལ་བུས་དལ་བུས་དྲི་མ་རྣམས་མེད་ད་དོ།",
    "ཇི་ལྟར་མཛེས་པའི་རྫ་མཁན་བརྩོན་འགྲུས་བརྩམས་པར་གྱུར་པ་རྒྱུ་རྐྱེན་དང་གོམས་པ་རྣམས་ཀྱིས་འཇིམ་པའི་གོང་བུ་བུམ་པར་སྒྱུར་བར་བྱེད་ད་དེ།",
    "རྒྱུ་རྐྱེན་གཉིས་དང་ཡིད་ཀྱི་༡དྲན་པ་མཛེས་པ་བསྟེན་༡༡པ་ངེས་པར་རྫོགས་པ་ལས་གང་ཡོངས་སུ་རྫོགས་ན་དྲན་པ་བརྩམས་པས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་བུམ་པ་བཞིན་དུ་སྐྱེད་དོ།",
    "ལྷ་དག་ཇི་ལྟར་བདག་ཅག་རྣམས་ཀྱི་གོས་རྣམས་གསར་པ་གྱོན་པར་གྱུར་པའི་དུས་དེ་ཉིད་ན་ས་བཟུང་ན་ས་དེ་དག་རྣམས་རིམ་གྱིས་ཟད་པར་འགྱུར་རོ།",
    "ཀི་བ་རོ་། དེ་ཁོ་ན་བཞིན་དུ་གང་ཁོ་ནའི་ཚེ་ནས་མཛེས་པའི་དྲན་པ་ཉེ་བར་འཇོག་༡པར་གྱུར་པ་དེའི་དུས་དེ་ནས་༐",
    "བཟུང་ན་ས་༢སྐྱོན་ཐམས་ཅད་ཟད་པར་འགྱུར་རོ།",
    "དག་པ་༢ཇི་ལྟ་བའི་དྲན་པའི་ཐག་པས་ཡོངས་སུ་བཅིངས་ན་༤སེམས་ཡོངས་སུ་འཁྱམ་༥པར་མི་འགྱུར་རོ།",
    "རྟ་རྒོད་བཞིན་དུ་བསྲིངས་ན་ས་འཛིན་པར་བྱེད་དེ་༦འདས་པ་དྲན་པ་དང་ལྡན་པའི་སྐྱེས་བུ་རྣམས་ནི་ད་གའ་བའི་འདོད་ཆགས་མི་བཟད་༧པ་རྣམས་དམིགས་པ་༨སྤངས་ནས་གནས་སོ།",
    "དྲན་པས་དེ་བཞིན་དུ་ད་ལྟར་གྱི་ཡུལ་རྣམས་ལ་མིག་རྒྱུ་བར་བྱེད་པ་ན་སྒྲུབ་པས་ཟློག་པར་བྱེད་དོ།",
    "དྲན་པ་དང་དྲ་ན་པ་མ་ཡིན་པ་དག་ལ་རྗེས་སུ་སྒྲུབ་པས་ཇི་ལྟར་ལེགས་པར་རྟོགས་པར་བྱ་ཞེ་ན།",
    "གན་ས་སྐབས་ཐམས་ཅད་དུ་ཡང་རབ་ཏུ་ཉམས་པར་འགྱུར་རོ།",
    "འདི་ན་ལ་༢ལ་ཉེ་བར་གདུང་བར་མི་བྱེད་པར་གྱུར་པ་བློ་ཤིན་ཏུ་རབ་ཏུ་དང་བ།",
    "གང་ཟག་རྣམས་ལ་རབ་ཏུ་ད་པྱོད་པར་ཡང་མི་བྱེད་ལ་ཚངས་པར་སྤྱོད་པ་རྣམས་ལ་རབ་ཏུ་དཔྱོད་པར་ཡང་མི་བྱེད་པ་དང་།",
    "འཇུག་པར་འགྱུར་རོ།",
    "ཀུན་ན་ས་འདྲེ་བས་ཉེ་བར་འགྲོ་བར་ནི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་དག་དང་ལྷན་ཅིག་ཏུ་འོ་ཤིན་ཏུ་ངོ་མཚར་སྐྱེ་བའི་ཡོན་ཏན་དེ་ལྟ་བུ་རྣམས་དང་ལྡན་པའི་སྐྱེས་བུ་ནི་གཞན་ལ་ཉེ་བར་གདུང་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ན་གཞན་རྣམས་ལ་ཉེ་བར་གདུང་བར་མི་བྱེད་པ་ནི་ལྷ་དང་མི་རྣམས་ལ་གཅེས་པར་གྱུར་པ་ཡིན་ན་ནོ།",
    "དོན་དང་དོན་མ་ཡིན་པ་རྣམས་ལ་ལྟོས་པ་མེད་པར་༨ལྗོངས་རྒྱུ་བར་བྱེད་པས་ལེགས་པར་རྒྱུའོ།",
    "ས་གཡོ་བ་དང་ཟླ་བ་གཟས་འཛིན་པ་ཡང་སྟོན་༡༢པར་མི་བྱེད་ད་དོ་། རྙེད་པ་དང་བཀུར་སྟིའི་དོན་དུ་གཅིག་པུ་ཞིག་༐",
    "བཀྲ་བར་བྱས་པའི་མཆིལ་ལྷམ་དང་ཤིང་ལེབ་ཀྱི་སྟན་བཟང་པོ་དང་སྔས་ནང་ཚངས་༢ཅན་ཟླུམ་པོ་འཛིན་པ་མ་ཡིན་ནོ།",
    "བློ་རྣམ་པ་སྣ་ཚོགས་པར་གཡེང་བར་བྱེད་པ་ཡང་མ་ཡིན་ནོ།",
    "གྲོང་དང་ཐག་ཉེ་བར་གནས་པར་བྱེད་པས་དགའ་བར་འགྱུར་བ་མ་ཡིན་ན་ནོ།",
    "ཡོད་པ་མ་ཡིན་པའི་ཡོན་ཏ་ན་རྣམས་རྗོད་པར་མིབྱེད་ལ་ཡོད་པའི་ཡོན་ཏན་རྣམས་ཡང་རྗོད་པར་མི་བྱེད་དོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོན་ཏན་དང་སྐྱོན་རྣམས་སྟོན་པར་གྱུར་ན་ས་རྒྱབ་ཀྱི་ཤ་སྦྱིན་པར་བྱེད་པ་ཡང་མ་ཡིན་ནོ།",
    "ཡིད་གཏོད་པར་བྱེད་པ་མ་ཡིན་༡།",
    "སྒྲ་དེ་དག་རྣམས་གང་ཡིན་པའི་སྐྱོན་གྱིས་འཇིགས་པས་བྱ་རྣམས་ཀྱི་སྒྲ་དང་གཞན་གྱི་སྒྲ་རྣམས་ཀྱང་ཉན་པར་མི་བྱེད།",
    "སྒྲའི་སྐྱོན་གྱིས་ཡིད་འཕྲོགས་༢པར་མི་འགྱུར་རོ།",
    "ཡིད་དུ་འོང་ཞིང་ཡིད་དུ་འོང་བར་གྱུར་པའི་དྲི་རྣམས་ལ་ཡང་སྣ་ཕྱོགས་པར་འགྱུར་བའི་སྐྱོན་གྱིས་ཡིད་ཁྱེར་བའི་ཕྱིར་རོ།",
    "སྒྲོ་རྣམས་རྣམ་པར་བཀྲ་བར་གྱུར་པས་ད་གའ་བའི་ཁ་དོག་སྣ་ཚོགས་པའི་བྱ་རྣམས་འདོད་ཆགས་ལ་ཆེད་ཆེར་བྱེད་པར་གྱུར་པའི་ངང་ངུར་དང་།",
    "རྨ་བྱ་རྣམས་ཀྱང་ལྟ་བར་བྱེད་པས་རྣམ་པར་རྒྱུ་བ་མ་ཡིན་ནོ།",
    "སྐྱོན་ཆུང་ངུ་ཡང་མ་ཡིན་པ་ཡང་བར་དུ་གཅོད་པར་འགྱུར་བའི་ཡིད་ཀྱིས་རབ་ཏུ་འབད་པར་བྱེད་དོ།",
    "སྲིད་༢པ་ལ་སོགས་པ་རྣམས་ཀྱི་བཞིན་བདེ་བར་གནས་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "འདི་ནི་༢གཙང་བ་དང་བཅས་པའི་ལྷུང་བཟེད་ཀྱིས་རྒྱུ་བ་དེ་ཡང་ཟས་སྐོམ་རྣམས་མི་འཛིན་ཏོ།",
    "དགའ་བར་འགྱུར་བའི་ལྷུང་བཟེད་འཛིན་པར་འགྱུར་རོ།",
    "རུལ་པར་གྱུར་པའི་འབྲས་བུ་བ་ད་ར་དང་།",
    "བསོད་སྙོམས་ལ་འཇུག་པར་བྱེད་པ་ན་ཡང་།",
    "དེ་ཉིད་འཚོ་བ་རྣམ་པར་དག་པ་དང་།",
    "གཅིག་ཏུ་ཕན་པ་ག་ཙང་ཞིང་དག་པར་གྱུར་པ་ཡིན་ཏེ།",
    "དེ་ཇི་ལྟ་ཇི་ལྟར་བདག་ཉིད་ཀྱི་འགྲོ་བ་འདོད་པར་གྱུར་པ་དེ་ཁོ་ན་བཞིན་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་ནས་དེའི་དུས་ན་བཅོམ་ལྡན་འདས་ཐམས་ཅད་སྐྱོབ་དེས་ཚིགས་སུ་བཅད་པ་གསུངས་པར་གྱུར་པ།",
    "༣༢༡ལ་རབ་ཏུ་བསྔགས་པར་མཛད་དོ།",
    "ཡོངས་སུ་ལྷག་པར་གྱུར་པ་རྣམས་ཀྱིས་ཀྱང་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "དགའ་བ་རྣམས་ཐོབ་ནས་བག་མེད་པས་ཟད་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་ན་༨ལྷ་ས་བག་མེད་པར་བྱ་བར་མི་འོས་ཏེ་བདག་ཉིད་ཀྱིས་ལེགས་པར་གོ་བར་གྱིས།",
    "གང་བཅོམ་ལྡན་འདས་དེས་གསུངས་པ་དེ་དག་ཐམས་ཅད་ཁྱེད་ཀྱིས་ཐོས་སམ།",
    "སྡུག་པ་དང་རྣམ་པར་བྲལ་བ་རྣམས་དང་།",
    "གཞན་ཡང་ཕན་པར་བྱེད་པས་རྗེས་སུ་འཛིན་པའི་ཕྱིར་ན་འདི་སྐད་བརྗོད་པ་༢།",
    "སྦྱིན་པར་འགྲོ་བར་འདོད་པའི་ལྷ་རྣམས་བག་མེད་པས་བག་མེད་པར་གནས་པ་རྣམས་སྲིད་པ་གཞན་གྱི་དུས་ཀྱི་གནས་སྐབས་སྟེང་དུ་གནས་པར་གྱུར་པ་ན།",
    "བདེ་ལེགས་ཐོབ་པར་བྱ་ཞིང་ཐོབ་པའི་དོན་དུ་དང་།",
    "སྡུག་བསྔལ་མཐར་ཐུག་པར་གཞོམ་པའི་དོན་དུ་༐",
    "མྱ་ངན་ལས་འད་ས་པ་ཐོབ་པར་བྱའོ།",
    "དེ་ནས་ལྷ་དེ་དག་རྣམས་ཀྱིས་འཐབ་བྲལ་གྱི་བདག་པོའི་ཚིག་ཉེ་བར་ཐོས་པ་དང་གུས་པ་ལེགས་པར་༐",
    "སྐྱེས་པར་༢གྱུར་པས་རྒྱགས་པ་དང་ང་རྒྱལ་རྣམས་དང་རྣམ་པར་བྲལ་བ།",
    "ཉེ་བར་ལེགས་པར་ཕྱིན་པ་དེ་དག་རྣམས་ལ་གཞན་ཡང་འཐབ་བྲལ་བའི་བདག་པོ་དེས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "མཆོད་རྟེན་དེའི་ན་ང་ན་ཡང་༧འདུས་བྱས་མ་ལུས་པ་མི་རྟག་པ་དང་ཕུན་སུམ་ཚོགས་པ་རྣམས་རྒུད་པར་འགྱུར་བ་དང་།",
    "རྣམ་པ་སྣ་ཚོགས་པར་གྱུར་པ་རྣམས་གསལ་བར་མཐོང་ངོ།",
    "རྣམ་པར་ཁྲོས་པའི་ཡིད་ཀྱིས་ཀུན་ཏུ་ངུ་བར་བྱེད་པ།",
    "ལེགས་པར་བྱས་པའི་ལས་རྣམས་ཡོངས་སུ་ཟད་པ།",
    "སྲོག་གཅོད་པའི་སྐྱོན་དང་མ་བྱིན་པར་༡༡ལེན་པས་ཀྱང་ངོ།",
    "ཇི་ལྟར་སྲོག་གཅོད་པར་བྱེད་པ་ཡིན་ན།",
    "ཀི་བ་༢ བཞིའི་ལྷ་དེ་དག་རྣམས་ཡང་༡ལྷ་དང་ལྷ་མ་ཡིན་རྣམས་ཀྱི་འཁྲུག་པ་ལ་སྲོག་གཅོད་པར་བྱེད་ད་དོ།",
    "རྟག་ཏུ་ཡང་རྣམ་པར་རྒྱལ་བར་འགྱུར་ཏེ།",
    "ཅོད་པན་འཕྲོག་པ་དང་མཚོན་རྣམས་འཕེན་པར་བྱེད་དོ།",
    "རྣམ་པ་དེ་སྲིད་ཀྱི་གོས་རྣམས་ཀྱིས་བཀབ་པར་གྱུར་པའི་རྣམ་པ་དེ་སྲིད་ཀྱི་སྐྲས་གདོང་མི་༐",
    "ཀྱང་བད་༡འབབ་པར་གྱུར་པའི་རླ་ན་གྱི་ཚད་ཙམ་གྱི་ཆུ་ཡང་མི་རྙེད་དོ།",
    "ལྷའི་འཇིག་རྟེན་ལ་རྣམ་པར་རྒྱུ་བར་གྱུར་པ་ལས་ཤི་འཕོས་ནས་ཡི་དགས་ཀྱི་ས་གཞི་རྣམ་པ་སུམ་ཅུ་རྩ་དྲུག་ན་ཉེ་བར་འཚེད་པར་འགྱུར་བ་རྣམས་ལེགས་པར་མཐོང་༢ན་བྱ་རོག་དང་།",
    "མཉེན་པ་ཤིན་ཏུ་འཇམ་༢པར་གྱུར་པའི་རྣམ་པ་དེ་སྲིད་ཀྱི་མཐོ་རིས་ཀྱི་ས་རྣམས་༤ལ་སྤྱད་ནས་སླར་ཡང་ཡི་དགས་ཀྱི་སྲིད་པར་སྐྱེ་བར་གྱུར་ནས་མེ་མ་མུར་བདུན་གྱིས་ཤིན་ཏུ་རྩུབ་༦པ་དང་ལྡན་པ།",
    "རྡོ་རྗེའི་མཆུ་རྣམས་ཀྱིས་རྐོ་བར་བྱེད་པར་གྱུར་པ་༧། ༐",
    "དྲིའི་འབྱུང་གན་ས་རྒྱ་ཆེན་པོར་གྱུར་པ་རྣམ་པ་བརྒྱ་སྟོང་ཕྲག་དུ་མ་རྣམས་བསྣམས་༡༧ནས་ཕྱིས་ཡང་མི་གཙང་བ་རྣམ་པར་སྨེ་བར་གྱུར་པའི་༐",
    "ཐོ་བཙམས་༡པར་གྱུར་པའི་ཤིན་ཏུ་ཡང་མི་གཙང་བར་གྱུར་པ་རོ་དང་དྲི་རྣམས་བླ་ལྷག་པར་དམན་པར་གྱུར་པ་ལ།",
    "གལ་ཏེ་ཤེད་ན་ལོ་བརྒྱ་ཕྲག་དུ་མའི་ཤིན་ཏུ་མི་གཙང་བའི་༐",
    "ཡང་ན་ལུས་ཤིན་ཏུ་རིད་པར་གྱུར་པ་ཉིད་ཀྱིས་རྟུག་པ་རྣམས་ཟ་བར་བྱེད་པ་དེ་བཞིན་དུ་མཆོད་རྟེན་གྱི་ལོགས་ལ་མཐོང་བར་གྱུར་ལ་ལུས་ལ་ཡང་མཆོག་ཏུ་འཇམ་པར་གྱུར་པ།",
    "མེ་ཏོག་སྣ་ཚོགས་པའི་ཀུ་སུ་མའི་དྲི་དང་ཡང་དག་པར་ལྡན་པ་རྣམས་ལ་ཉེ་བར་བསྟེན་པར་བྱས་པའི་ལས་རྣམས་ཡོངས་སུ་ཟད་ནས།",
    "གཞན་ཡང་མཆོད་རྟེན་གྱི་རྩིག་ལོགས་ཀྱི་ཡུལ་ཕྱོགས་གཞན་ཞིག་ན་ཚོགས་པ་རྒྱུ་བ་ན་རྣམ་པར་རྒྱུ་བའི་༡ལྷ་དང་།",
    "ཆུ་ན་ནི་ཆུ་ལ་རྒྱུ་བ་རྣམས་ཕན་ཚུན་ཟ་བར་གྱུར་པ་ཤིན་ཏུ་འཇིགས་པར་གྱུར་པའི་གྲང་བ་དང་ཚ་བས་བྱས་པའི་ཤིན་ཏུ་རྩུབ་པར་གྱུར་པའི་གནས་སྐབས་རྣམས་༡ལ་ཉེ་བར་ལོངས་སྤྱོད་པར་གྱུར་པའོ།",
    "ཐང་ལ་ནི་ཐང་ལ་འགྲོ་བ་རྣམས་ཉི་མའི་འོད་ཀྱིས་བསྲེགས་པར་གྱུར་པས་ཡོངས་སུ་ཉམ་༢ཐག་པར་བྱེད་པའི་བཀྲེས་སྐོམ་གྱིས་ལུས་རྣམ་པར་བསྲེགས་༢པར་གྱུར་པ་རྣམས་ཕན་ཚུན་དུ་གསོད་ཅིང་འཆིང་བར་བྱེད་པའི་འཇིགས་པ་རྣམས་ཀྱིས་༤འཇིགས་པར་གྱུར་པ།",
    "མཆོག་ཏུ་སྡུག་བསྔལ་བར་གྱུར་པ་རྣམ་པ་བརྒྱ་སྟོང་དུ་མའི་གནས་སྐབས་ཉེ་བར་ལོངས་སྤྱོད་པར་བྱེད་པ།",
    "མི་ད་གེ་བའི་ལས་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐུལ་ན་ས་རྣམ་པ་དེ་སྲིད་དུ་ནགས་དང་ཉེ་བའི་ནགས་རྣམས་ན་དུད་འགྲོ་རྣམས་ཉེ་བར་ལོངས་སྤྱོད་པར་བྱེད་པ་རྣམས་བརྗོད་པར་སླ་བ་ཡང་མ་ཡིན་ན་ནོ།",
    "ཚོགས་པར་གྱུར་པ་དང་།",
