    "བཏང་སྙོམས་སུ་བྱ་བ་རྗེས་སུ་དཔག་པར་མི་འགྱུར་རོ།",
    "སྒྲུབ་པར་ཞེས་བྱ་བའི་སྒྲ་ནི་ལེན་པ་དང་འདོར་བ་དང་བཏང་སྙོམས་ཀྱི་མཚན་ཉིད་ཀྱི་བསྒྲུབ་པ་ལ་བྱའོ།",
    "འདིར་རྗེས་སུ་དཔག་པའི་སྒྲ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ལ་བྱའོ།",
    "དེ་བྱེ་བྲག་ཏུ་རྟོགས་པར་བྱ་བ་དེའི་ཕྱིར་རོ།",
    "ཡང་ན་དོན་སྒོག་ཏུ་གྱུར་པ་སྒྲུབ་པ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཡིན་ལ།",
    "འདིས་རྗེས་སུ་དཔོག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཚིགས་སུ་བཅད་པ་འདིས་རབ་ཏུ་བྱེད་པའི་ཡུལ་མཐའ་དག་བསྡུས་ནས་སྟོན་པར་བྱེད་དོ།",
    "བསྡུས་པའི་དོན་ནི་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་སྤྱི་ཕྱོགས་ཡིན་པར་གཟུང་རྗོན་ནི་དེའི་ཚེ་གཏན་ཚིགས་མ་གྲུབ་པར་འགྱུར་བའམ་གྲུབ་ན་ཡང་རྗེས་སུ་དཔག་པ་དོན་མེད་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ལ།",
    "དངོས་སུ་བསྟན་དུ་རུང་བ་ལ་ནི་དགོས་པ་མེད་པར་ཉེ་བར་གདགས་སུ་མི་རུང་སྟེ།",
    "ཉེ་བར་གདགས་པར་བྱ་བའི་དགོས་པ་བསྟན་པའི་ཕྱིར་མ་ཡིན་ཏེ།",
    "བརྟེན་པར་བྱ་བ་ནི་རྟེན་ཏེ།",
    "འདིར་ཉེ་བ་ནི་བློ་ལ་སྣང་བའམ་ཡང་ན་བསྒྲུབ་པར་བྱ་དགོས་པའོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་ཀྱང་ཉེ་བར་འཁྲུལ་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ཡང་བློ་ལ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་སྣང་ལ།",
    "ཁྱབ་པ་ཡིད་ཆེས་པར་བྱ་བའི་ཕྱིར་དེའི་ཆས་ཁྱབ་པ་ཞེས་བྱ་བ་ཡང་གདོན་མི་ཟ་བར་བརྗོད་པར་བྱ་དགོས་སོ།",
    "དེ་བརྗོད་མ་དེ་ཁོ་ནས་ཡོད་པར་འགྲུབ་སྟེ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་གྲུབ་ཀྱང་ངེས་པར་བྱ་བའི་ཕྱིར་ཡང་སྨོས་སུ་དོགས་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་མེད་པ་ལ་གཏན་ཚིགས་མེད་དོ་ཞེས་སྨོས་པ་གང་ཡིན་པ་དེ་ནི་འདི་ལྟར་གཏན་ཚིགས་ནི་མེད་པ་ཁོ་ན་ལས་ལོག་པ་ཡིན་བྱི།",
    "དེ་བས་ན་དེ་ལྟར་ངེས་པར་བྱ་བ་ཡིན་པར་དོགས་པ་བཟློག་པའི་ཕྱིར་ཉེ་བར་གདགས་པར་བྱའོ་ཞེས་བྱ་བར་གནས་སོ།",
    "ངེས་པར་བྱ་བ་ཡིན་པར་དོགས་པ་ཡོངས་སུ་སྤངས་པ་ཡིན་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "བསྒྲུབ་པར་བྱ་བ་དང་།",
    "དེ་ལྟ་བས་ན་ཉེ་བར་གདགས་པ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་ལ་དོགས་པར་བྱ་སྟེ།",
    "ཡང་ཞེས་བྱ་བའི་སྒྲའི་དོན་ནི་སྒྲུབ་པར་བྱེད་པའི་དཀའ་བ་ཡང་ཡོངས་སུ་སྤངས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཕྱོགས་དེའི་ཁྱད་པར་ལ་ལྟོས་པས་ན་དེའི་ཁྱད་པར་ལ་ལྟོས་པ་སྟེ།",
    "གང་ཞིག་ཕྱོགས་ཀྱི་རྗོཁྱད་པར་དུ་བྱེད་པ་དེ་ནི་ཕྱོགས་ཁོ་ན་ལ་ཡོད་ཀྱི་གཞན་ལ་ནི་མེད་དོ།",
    "དེ་ལྟ་བས་ན་དེ་གཞན་དུ་འཇུག་པར་ལྟ་ག་ལ་འགྱུར།",
    "མ་འབྱེལ་བ་རྣམ་པར་བཅད་པས་བྱེ་བྲག་ཏུ་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "འདིར་ནི་མ་འབྲེལ་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེས་ན་འདི་སྐད་དུ་སྒྲ་ལ་བྱས་པ་ཉིད་ཡོད་ཀྱི།",
    "མི་འདོད་པའི་ངེས་པར་གཟུང་བ་བསལ་བར་བྱ་བའི་ཕྱིར།",
    "གཞན་དང་འབྱེལ་པ་རྣམ་པར་བཅད་པས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ལ་ལར་ནི་གཞན་དང་འབྲེལ་བ་རྣམ་པར་གཅད་པ་སྣེངེས་པར་གཟུང་བར་འདོད་པའི་འདོད་རྒྱལ་འདི་ག་ལས་སྨྲས་པ།",
    "དེ་ཉིད་མ་འབྲེལ་བ་རྣམ་པར་བཅད་པ་ཞེས་བྱ་སྟེ།",
    "གཞུ་ཐོགས་པ་ཉིད་མི་སྲིད་པ་ཉིད་རྣམ་པར་གཅོད་པ་ཡིན་ལ།",
    "གཞན་ལ་ཕུལ་དུ་བྱུང་བ་ཡོད་དམ་མེད་པ་ཐེ་ཚོམ་ཟོས་ནས་མེད་པ་སྒྲུབ་པར་བྱེད་པའི་སྒྲ་སྦྱོར་བར་བྱེད་པ་དེར་ནི་གཞན་དག་དང་འབྱེལ་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གཞན་དང་འབྲེལ་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "གཞན་དང་འབྱེལ་པ་རྣམ་པར་གཅད་པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "ཁྱབ་པ་ནི་དེ་ལ་ཁྱབ་པར་བྱེད་པ་ཡོད་པ་ཁོ་ནའམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གདོན་མི་ཟ་བར་དེ་ཡོད་པ་ཁྱབ་པའི་སྒྲར་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་ང་ལ་ཁྱབ་པར་བྱེད་པ་ཁོ་ན་ཡོད་དོ་ཞེས་དེ་སྐད་དུ་ངེས་པར་གཟུང་ན།",
    "འོན་ཏེ་དེ་ཁོ་ན་ལ་ཁྱབ་པར་བྱེད་པ་ཡོད་དོ་ཞེས་ངེས་པར་གཟུང་ངོ་ཞེ་ན་ནི།",
    "འདིར་ཡང་གལ་ཏེ་དེ་ལ་ཁྱབ་པར་བྱ་བ་ཁོ་ན་ཡོད་དོ་ཞེས་ངེས་པར་གཟུང་ན་ནི་དེའི་ཚེ་མི་སྲིད་པ་ཅན་གྱི་མཚན་ཉིད་དུ་འགྱུར་ཏེ།",
    "འོན་ཏེ་དེ་ཁོ་ན་ལ་ཁྱབ་པར་བྱ་བ་ཡོད་དམ་ཞེས་ངེས་པར་གཟུང་བར་བྱའོ་ཞེ་ན་ནི།",
    "འདི་ལྟར་རྟག་པ་དག་ལ་ནི་གཞལ་བྱ་ཉིད་ཡོད་པར་གདོན་མི་ཟ་བ་བུཡིན་ནོ།",
    "འདིར་ནི་ཁྱབ་པར་བྱེད་པ་ལ་ལྟོས་ན་ནི་མ་འབྲེལ་པ་རྣམ་པར་བཅད་པས་ཁྱབ་པ་ཡིན་ལ།",
    "ཁྱབ་པར་བྱ་བ་ལ་ལྟོས་ན་ནི་གཞན་དང་འབྲེལ་པ་རྣམ་པར་བཅད་པས་འབྱེལ་པ་ཡིན་པས་འབྱེལ་པ་རྣམ་པ་ཐ་དད་པར་རྟོགས་སོ།",
    "དེའི་ཕྱིར་དང་པོར་དེ་གཉིས་ཁོ་ན་གཏན་ལ་དབབ་པ་བརྗོད་པར་བྱ་དགོས་སོ་ཞེས་སེམས་པར་འགྱུར་བ་དེའི་ཕྱིར།",
    "ཇི་ལྟར་ན་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པར་ཁྱབ་པ་འཕེན་པར་བྱེད་སྙམ་པ་ལ།",
    "ཁྱབ་པར་བྱེད་པ་ལོག་ན་ཡང་ལྡོག་པར་ངེས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་གང་ཞིག་ལོག་ན་ངེས་པར་ལྡོག་པར་འགྱུར་བ་དེ་ནི།",
    "དེའི་ཁྱབ་པར་བྱེད་པ་ཡིན་པར་འགྲུབ་པར་ཁྱབ་པ་ནི་ལྡོག་པ་ལ་རག་ལུས་པ་ཡིན་ནོ།",
    "མཇུག་བསྡུས་ཏེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟ་ན་ནི་འཕེན་པ་འབའ་ཞིག་སྒྲུབ་པར་ཟད་དོ།",
    "ཇི་ལྟར་དེ་ན་མངོན་སུམ་གྱི་སྒོ་ནས་དུ་བ་འགྲུབ་པར་འགྱུར།",
    "དེ་ལ་ནི་མངོན་སུམ་གྱིས་འཛིན་པར་སྲིད་དོ།",
    "དེ་ལྟ་བས་ན་ཉེས་པ་མཚུངས་སོ་ཞེས་བརྒལ་ཞིང་བརྟག་པར་བྱའོ།",
    "འོ་ན་ནི་འདི་ན་ཡང་ཕྱོགས་ཀྱི་ཡན་ལག་ཅན་ཡོད་པར་འགྱུར་བས་མཚུངས་སོ།"
  ]
}