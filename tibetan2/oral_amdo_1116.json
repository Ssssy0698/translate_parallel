    "ཁྱོད་ཀྱི་བསམ་པ་རྫོགས་པར་གྱུར་ཅིག་བརྗོད",
    "དེ་བཞིན་གཤེགས་པ་མོས་པས་བྱེད་པར་འགྱུར",
    "ཕུ་བོ་སྟོང་གི་བར་ཆད་བསྲུང་བ་ཡི",
    "ཕུ་བོ་སྟོང་གི་ཞུ་བ་པོ་བྱེད་པ",
    "༢༤ན་དེ་ནས་གཞོན་ནུ་སྟོང་པོ་དེ་དག་གིས",
    "བདག་གིས་ཁྱོད་རྣམས་བར་ཆད་བསྲུང་བ་དང་",
    "བདེ་མཛད་དོན་གཟིགས་རྒྱལ་ཞེས་བྱ་བ་དང་",
    "ཡུལ་གྲུ་འཛིན་གྱི་སྨད་འཚོང་བཟང་མོ་དང་",
    "གདུལ་བྱའི་ཞིང་དུ་གཟིགས་ནས་སྲོག་བློས་བཏང་",
    "དེ་ཚེ་གྲུ་འཛིན་སྨད་འཚོང་བཟང་མོ་དང་",
    "མི་གཞན་ཞིག་གིས་ཀན་པ་ཎི་ནི",
    "ལྔ་བརྒྱ་ཐོགས་ནས་སྨད་འཚོང་བཟང་མོ་ལ",
    "དེ་ནས་བཟང་མོའི་བུ་མོ་མངག་གཞུག་མས",
    "བཟང་མོས་བཟོད་པར་གསོལ་ཀྱང་གྲི་ཕྱུང་བསད",
    "དེ་ནས་བུ་མོས་ཇོ་མོ་བསད་དོ་ཞེས",
    "བཟང་མོ་དང་ནི་ལྷན་གཅིག་དགའ་མགུར་སྤྱད",
    "གོའུ་ཏ་མས་བཟང་མོ་མ་བསད་ན",
    "གོའུ་ཏ་མས་བཟང་༢༦བ་མོ་མ་བསད་ན",
