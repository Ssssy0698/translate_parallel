    "སྤུར་ཁང་གི་སྟེང་ན་བདག་མེད་མ་ལྷ་མོ་བཅོ་ལྔ་ཁྲ་ཁད་དེ་བཞུགས་འདུག་པ་ཁོང་བྱོན་པ་དང་ཞལ་ནང་དུ་བསྒྱུར་ཏེ་གཟིགས་སུ་མ་བཏུབ།",
    "དེར་ཞལ་སྟོན་པར་གསོལ་བ་བཏབ་པས་ཁྱོད་ཀྱིས་གསང་སྔགས་ཀྱི་རྣལ་འབྱོར་པ་ལ་འབར་ཡོད་པས་བཤགས་པ་གྱིས་གསུང་།",
    "ཞེས་པའི་ཕྱི་མ་ནི་ཡུལ་ན་ཏོག་གི་བྲམ་ཟེ་ཞིག་ལ་མཁའ་འགྲོ་མ་ཞིག་ཆུང་མར་ཡོད་པ་དེས་འབྲས་ཆན་ཕྱི་མ་འཚེད་ཀྱི་བར་ལ་ཉིན་ལམ་བཅུ་བཞིའི་ས་ནས་སྐྱེ་བདུན་ཞིག་གི་ཤ་བླངས་ཏེ།",
    "ལོག་པ་ཁྲག་གིས་གོས་པ་མཐོང་ནས་དྲིས་པ་ན།",
    "དེས་དྲང་པོར་སྨྲས་ཏེ་དོ་ནུབ་དེར་ཚོགས་ཀྱི་འཁོར་ལོ་ལ་འགྲོ་ཁྱོད་དང་འགྲོགས་པའི་སྐལ་བའང་ཟད་དོ་ཞེས་སྨྲས་པ་དང་།",
    "བྲམ་ཟེས་བདག་ཀྱང་ཁྲིད་ཅིག་ཅེས་བྱས་པས་ཁྱོད་གཙང་སྦྲའི་རྟོག་པས་སྣོད་དུ་མི་རུང་ཟེར།",
    "དེར་གཙོ་མོ་དང་ཚོགས་ཐམས་ཅད་དང་ཆུང་མས་བསྐུལ་བས་ཀྱང་ཟར་མ་འདོད་སྟེ་ཟོས་ན་དེ་ཉིད་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་སྐད།",
    "དེ་ནས་གཙོ་མོ་དེས་ནས་འབྲུ་བདུན་བྲམ་ཟེའི་ལག་པར་བླུག་སྟེ་པར་བ་བཙུམས།",
    "རྣལ་འབྱོར་ཕོ་མོ་རོལ་པ་ལ།",
    "གཅེར་བུ་མཚན་མོ་དུར་ཁྲོད་དུ།",
    "མཚན་མོ་གཅེར་བུ་རུས་རྒྱན་གོན།",
    "གར་གྱིས་རྒྱལ་པོའི་བུ་མོ་ལ།",
    "ཁྱོད་ལ་བར་ཆད་འབྱུང་ཞེས་གསུངས།",
    "ཉན་ཐོས་ཀྱི་སྤྱོད་པ་སོགས་འོག་མའི་གྲུབ་པའི་མཐའ་དང་སྤྱོད་པའི་ཀུན་རྟོག་གིས་མ་བསྡམས་ཤིང་།",
    "སྲེད་ཞེན་དང་ཐ་མལ་དུ་ལྟ་བ་མེད་པ་ཞིག་གིས་གནས་སྐབས་སྐྱེ་བོས་སྨད་པར་མི་འགྱུར་བ་ཙམ་གྱིས་༣༥ན་སྒྲུབ་ཅིང་།",
    "ནམ་ནུས་པ་ཐོབ་པ་ན་ནི་འཇིག་རྟེན་དང་འགལ་བའི་ས་ཟམསསྤྱོད་པ་ལ་ཞུགས་ཏེ་ནུས་པས་དེ་དག་གི་མ་དད་པ་ཟློག་ཅིང་སྔགས་ཀྱི་ཆེ་བ་འབྱིན་པ་སློབ་དཔོན་ཆེན་པོ་བིརྱ་པ་དང་རྡོ་རྗེ་དྲིལ་བུ་པ་དང་ནཱ་རོ་ཞབས་དང་མི་ཏྲི་པ་དང་གྲུབ་ཐོབ་ཨོ་རྒྱན་པ་ལྟ་བུ་ཡིན་ནོ།",
    "མ་རྒྱུད་ཀྱི་དམ་ཚིག་ཁྱོད་པར་བ་ཡིན་པའི་ཕྱིར།",
    "སྤྱིར་ཐབས་རྒྱུད་ལ་ལྷ་ཡབ་ལས་ལ་རྒྱུ་ཞིང་ཤེས་རབ་ཀྱི་རྒྱུད་ལ་ལྷ་མོ་ལས་ལ་རྒྱུ་བ་དང་།",
    "དཀྱིལ་འཁོར་མང་ཞིག་ལ་བྱང་གི་ལྷ་ལས་ལྷར་འགྱུར་བ་མང་བས།",
    "དེའི་ཚེ་འདིར་ལས་ཀྱི་མཁའ་འགྲོ་མ་ལས་ལྷར་རིགས་མོད་ཀྱང་།",
    "སྤྱི་འགྲོ་ཉིད་ཕལ་གྱིས་འཇུག་སླ་བར་གཟིགས་ནས།",
    "དེ་བཞིན་དུ་ཁྱད་པར་ཐ་དད་པ་མེད་མི་རུང་མ་གཏོགས་ཚོགས་བསགས་ཀྱི་ཡན་ལག་བདུན་པ་སོགས་ཕལ་ཆེར་དེང་སང་ཀུན་ལ་གྲགས་ཆེ་བའི་ཚིག་གིས་མཛད་པ་ནི་བློ་གྲོས་ཆུང་ངུ་རེ་རེ་འཇུག་སྲིད་ན་དེ་མང་བས་མི་སྐྲག་པའི་ཆེད་དུ་ཐུགས་རྗེས་དགོངས་པའོ།",
    "སླར་སྭ་བྷ་ཝ་བརྗོད་༥༩ན་པས་ཕྱག་རྒྱ་དེས་ཆང་གི་སྟེང་དུ་མདུན་ནས་གཡོན་བསྐོར་ཏུ་ཟླུམ་བསྐོར་བྱས་པས་བདུད་རྩིའི་རྒྱ་མཚོ་དཀར་མེར་བ་བསམ་པ་ཅི་བདེ་བའི་བརྡའོ།",
    "ས་བོན་དེ་ལས་ལྷ་མོ་ལྔར་གསལ་བཏབ་པ་ཚང་ནང་གི་དཀྱིལ་འཁོར་རོ།",
    "དཀྱིལ་འཁོར་འདི་གཉིས་ལའང་ཡེ་ཤེས་པ་གཞུག་པ་དང་མཆོད་བསྟོད་སོགས་རེ་རེ་ནས་གསུངས་མོད་ཀྱི།",
    "དེ་ནས་མདུན་གྱི་ནམ་མཁར་འཁོར་ལོ་སྡོམ་པ་ཡབ་ཡུམ་གྱི་དཀྱིལ་འཁོར་རྟེན་དང་བརྟེན་པར་བཅས་པ་སྐད་ཅིག་གིས་སྤྱན་དྲངས་པར་མོས་ཏེ།",
    "རྒྱས་པར་ན་དམ་ཚིག་པ་ལྷ་ལྔ་ནས་དྲུག་ཅུ་རྩ་གཉིས་མའི་བར་ཇི་ཙམ་མོས་པ་བསྐྱེད།",
    "ལག་པ་གཡས་ཅུང་ཟད་སྦུབས་པས་གུར་ལྟར་བཀབ་སྟེ་གཡོན་དུ་བསྐོར་བས་ཆང་ནང་དུ་བླུགས་ཚུལ་༤ན་གྱིས་ཆང་ནང་གི་ལྷ་ཚོགས་ལ་ཐིམ་པས།",
    "བདེ་སྟོང་གི་ཡེ་ཤེས་བདུད་རྩི་མཆོག་གི་ངོ་བོར་ཞུ་སྟེ་དབྱེར་མེད་དུ་འདྲེས་པར་བསམས་ལ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོ་གཉིས་མཛུབ་མོ་གཉིས་མཐེའུ་ཆུང་གཉིས་རྣམས་སོ་སོར་རྩེ་སྤྲད་དེ་ཐད་ཀར་བརྒྱངས་པའམ།",
    "གཉིས་པས་གསུང་གི་བདུད་རྩི་ཉི་མ་ལྟར་དམར་བ།",
    "ཞི་བའི་བཏུང་བའང་ལྷ་མོ་སྟེ།",
    "ལག་མཆོད་ཀྱང་བདེ་མཆོག་གི་ཕྱོགས་ལས་ལག་པ་གཡོན་གྱི་སོར་མོ་ལྔ་བསྡུས་པའི་དབུས་དང་དྲུག་ཏུ་གོ་ཆའི་དཔའ་བོ་དྲུག་དང་མཐིལ་དུ་དཔའ་མོ་དྲུག་བསྐྱེད་པ་དང་།",
    "འདི་ནི་རྒྱུད་ཀྱི་སྦས་དོན་མན་ངག་གིས་བརྒྱན་པ་ཆེས་ཟབ་པར་སྣང་ངོ།",
    "དེའི་སྟེང་ཆེ་བར་གནས་པའི་ཟུར་གསུམ་དུ་ཀ་པཱ་ལའི་མིང་གི་དང་པོ་ཐིག་ལེས་བརྒྱན་པ་ཀཾ་ཡིག་ལས་སྐུ་གསུང་ཐུགས་ཀྱི་རང་བཞིན་མི་མགོ་སྐམ་པོ་དངོས་གྲུབ་སྟེར་བའི་ཕྱིར།",
    "ཀ་ཨ་ཕ་རྒྱུད་ལས་ནི་རང་རྫས་ལྔ་ལ་བདུད་རྩི་ལྔ་དང་།",
    "ཨ་མྲི་ཏ་སྟེ་འཆི་མེད་དམ་བདུད་རྩི་སྟེ།",
    "དམ་ཚིག་པ་བཅུ་པོ་རང་རང་གི་སོ་སྒྲི་ཏའི་སྐད་ཀྱི་མིང་ཡིག་དང་པོ་བསྡུས་པ་ནི་སོ་སོའི་ས་བོན་ཏེ།",
    "དེའི་ཤར་དུ་བི་ལས་ནམ་མཁའི་དྭངས་མ་རྡོ་རྗེ་དྲི་ཆེན་གཟུགས་ཀྱི་ཕུང་པོ་དང་རྣམ་སྣང་གི་ངོ་བོ་ཤེལ་བཅག་པ་ལྟ་བུ།",
    "ནུབ་ཏུ་འུ་ལས་སའི་དྭངས་མ་བྱང་སེམས་དཀར་པོ་ཚོར་བ་དང་རིན་འབྱུང་གི་ངོ་བོ་དངུལ་ཆུའི་ཕུང་པོ་ལྟ་བུ།",
    "ཤར་ལྷོར་གོ་ལས་རྡོ་རྗེ་དབྱིངས་ཕྱུག་མའི་ངོ་བོ་བ་ལང་གི་ཤ།",
    "ལྷོ་ནུབ་ཏུ་ཀུ་ལས་གོས་དཀར་མོའི་ངོ་བོ་ཁྱིའི་ཤ།",
    "ཤ་ལྔ་པོ་རེ་རེ་ཡང་ཁ་དོག་དམར་ཞིང་འཚེར་བ་ཙནྡན་དམར་པོ་སྤུངས་པ་ལྟ་བུ་སྟེ།",
    "རྫས་བཅུ་ག་ཡང་རེ་རེ་ཞིང་ནམ་མཁའི་མཐས་ཀླས་པ་སོ་སོའི་ས་བོན་གྱིས་སླར་ཡང་དབུས་སུ་མཚན་པ་སྟེ་རྒྱུ་རྡོ་རྗེ་འཛིན་པ་དམ་ཚིག་གི་བདུད་རྩིའོ།",
    "བུད་མེད་ཤེས་རབ་སེམས་ནི་ཐབས།",
    "ཧཱུྃ་གིས་དམ་ཚིག་གི་བདུད་རྩི་དང་གཉིས་སུ་མེད་པ་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་རྒྱ་མཚོར་བྱིན་གྱིས་བརླབས་ཏེ་ཡི་གེ་གསུམ་གྱིས་བརྟན་པར་བྱའོ།",
    "དམ་ཚིག་གི་རྫས་ཀྱི་སྟེང་དུ་ཨཱ་ལི་ཀཱ་ལི་ལས་ཟླ་ཉི་ཁ་ཆོད་ཀྱི་ཚུལ་དང་།",
    "ཁ་ཊ་ག་སོགས་ཕྱག་མཚན་ཡུ་བའི་ཆང་བཟུང་གི་ཚུལ་དུ་བསྐྱེད་པ་དང་།",
    "མཛུབ་མོ་མདུད་བྱས་གུང་མོ་ངེས་པར་སྦྱར།",
    "ལག་པ་གཉིས་མཐེ་བོང་གཉིས་དང་གུང་མོ་གཉིས་སོ་སོར་རྩེ་སྤྲད་དེ་སོར་མོ་གཞན་ཕན་ཚུན་དུ་མེ་རི་ལྟ་བུར་བརྒྱངས།",
    "ཕོ་ཞེས་བརྗོད་པས་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་ཐམས་ཅད་ངེས་པར་འགུགས་པ་མ་རྒྱུད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྨད་དུ་བྱུང་བ་སྟེ།",
    "འབག་དཔལ་ས་སྐྱ་པ་རྣམས་འབར་བའི་ཕྱག་རྒྱ་ལ་མཛུབ་མོའང་གུང་མོ་ལྟར་སྐྱོད་པར་བྱེད་མོད།",
    "དེ་ནི་མ་ཡིན་ཏེ་མཛུབ་མོ་མདུད་བྱས་ཞེས་པའི་དོན་མ་ཚང་བས་སོ།",
    "དེ་ནས་མགྲོན་རྣམས་ལ་དམ་ཚིག་གི་སྔགས་དང་ཕྱག་རྒྱ་བསྟན་པ་ནི།",
    "གར་དང་རོལ་མོ་བྱེད་པ་དང་།",
    "འདིར་དེའི་དོན་མ་ཡིན་ཏེ་རི་གི་ཨ་ར་༩༤ལི་དང་བཛྲ་ཨ་ར་ལིའི་རྒྱུད་ལས་ཨ་ནི་ཨ་ཝ་དྷཱུ་ཏཱི་སྟེ་ཀུན་འདར་མ་དང་།",
    "ལྷག་མ་ནི་རྡོ་རྗེ་མཁའ་འགྲོ་མ་དམ་ཚིག་གིས་བརྟན་པར་བཞུགས་ལ་ལྟོས་ཤིག་ཅེས་པ་སྟེ་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་གཏོར་མ་ལ་ལྟོས་ཤིག་པའི་དོན་ཏོ།",
    "གཡས་བསྐོར་དང་གཡོན་བསྐོར་གྱིས་ཀྱང་ཐོད་པའི་ནང་གི་སྦྱིན་པར་བྱ་བ་རྣམས་རྡོ་རྗེ་ཐལ་མོ་ཁ་གྱེན་དུ་ཕྱེ་ལ་སྔགས་འདི་བརྗོད་དོ་ཞེས་པས།",
    "པདྨའི་བསྐོར་བ་སྔོན་དུ་འགྲོ་བས་རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་བ་ཐོད་པའི་ཕྱག་རྒྱས་གཏོར་སྔགས་བརྗོད་ཅིང་།",
    "བདག་ལ་དམ་ཚིག་གིས་སྲུངས་ཤིག།",
    "བདག་གི་བྱ་བ་ཐམས་ཅད་ལ།",
    "དེ་ལ་ཞིང་སྐྱོང་ཆེན་པོ་བརྒྱད་ནི་ཤིང་ཆེན་པོ་རེ་རེའི་ཡལ་གའི་དཀྱིལ་འཁོར་གྱི་དབུས་ནས་ལུས་ཕྱེད་ཐོན་པས་གནས་པ་རྣམས་སོ།",
    "བོད་རང་གི་ཡི་གེའི་བྱུང་བ་དང་འཕོ་འགྱུར་ཏོག་ཙམ་གླེང་བ།",
    "རང་རེ་གངས་ཅན་བོད་པ་ཚང་ལ་ཆེས་སྔ་མོའི་དུས་ནས་ཐུན་མིན་གྱི་བོད་སྐད་འཐུས་ཚང་ཞིག་ཡོད་སྟབས་དུས་ཚོད་ངེས་ཅན་ཞིག་གི་རིང་ལ་རང་རིགས་ཀྱིས་རང་སྐད་བསྐྱངས་པ་དང་།",
    "འདི་ནས་ཡར་བརྩིས་པའི་མི་ལོ་སྟོང་ལྷག་གི་ཡར་སྔོན་སྟེ་ཕྱི་ལོའི་དུས་རབས་བདུན་པའི་ནང་མི་བོ་ཆེ་བོད་རྒྱལ་སོ་གསུམ་པ་སྲོང་བཙན་རྒམ་པོའི་སྐུ་རིང་ལ་བློ་རིག་འགྲན་ཟླ་དང་བྲལ་བའི་བློན་ཆེན་ཐོན་མི་སམ་བྷོ་ཊ་ཞེས་མཚན་གྱི་གྲགས་པ་གོ་ལའི་ཁྱོན་ན་འབར་བ་གང་དེ་ཉིད་ཀྱིས་བོད་རང་གི་སྐད་ལ་གཞི་བཅོལ་ཞིང་གུཔྟའི་ཡི་གེ་སྤྱིར་བོད་ཡིག་གང་ལ་དཔེ་བྱས་མིན་གྱི་སྐོར་ནས་བཞེད་ཚུལ་མི་མཐུན་པ་དུ་མ་ཡོད་དེ།",
    "བློ་རྣལ་མས་དཔྱད་པ་བཏང་བ་ཡིན་ན་བོད་རང་གི་སྐད་དང་མཐུན་པའི་ཁྱད་ཡོན་ཅན་གྱི་ཡི་གེ་འཐུས་སྒོ་ཚང་བ་འདི་ནི་ཐོན་མིས་རྒྱ་གར་གྱི་ཡི་གེ་ལ་དཔེར་བྱས་ནས་གསར་དུ་བཟོས་པ་ཁོང་ཉིད་ཀྱི་གསུང་ལས་རྒྱ་ཡིག་ལྔ་བཅུ་ཐམ་པ་ལས།",
    "དཀའ་མོའི་ཚེགས་དང་དཀོན་མོའི་རྒྱུ་ལ་མི་འཛེམ་པར་ཡི་གེ་བཟོ་བའི་ངལ་བ་ཆེན་པོ་དེ་འདྲ་དང་དུ་བླངས་ནས་བློན་ཆེན་གང་མང་ཞིག་གི་སྐུ་སྲོག་ཀྱང་ཤོར་བར་གྲགས་པ་དང་།",
    "རྒྱལ་པོ་ཁོང་གིས་ཀྱང་ཐོན་མི་སམ་བྷོ་ཊ་དགའ་དད་ཆེན་པོས་གཙུག་ཏུ་བཀུར་ཞིང་།",
    "གཉིས་པ་རྟགས་ཀྱི་འཇུག་པའི་སྐབས་ཏེ་བསྟན་བཅོས་བརྒྱད་ཀྱི་ནང་གི་དྲུག་པའོ་ཞེས་པར་དཔགས་ན་གཞུང་འདི་གཉིས་ཐོན་མིས་བརྩམས་པའི་བསྟན་བཅོས་བརྒྱད་ཀྱི་དང་པོའི་ལྔ་པ་དང་།",
    "དེ་ལྟ་ན་བསྟན་བཅོས་རེ་རེ་ལའང་སྐབས་མང་དུ་ཡོད་པར་མངོན་ནོ་ཞེས་ཐུགས་ཕངས་ཆེན་པོས་དཔྱད་པ་སྣ་ཚོགས་བཏང་ཡོད་ནའང་།",
    "དཔྱད་པ་ག་ཙམ་བཏང་ཡང་རྙེད་དུ་མེད་པའི་འདས་དོན་ཞིག་ཏུ་སོང་ཙང་།",
    "བོད་ཀྱི་བརྡ་སྤྲོད་ཀྱི་ཕྱི་མོར་གྱུར་པ་སུམ་རྟགས་ཀྱི་རྩ་བ་གཉིས་པོ་གཞིར་བཟུང་ནས།",
    "གོ་སླ་ཞིང་འཇུག་བདེ་བའི་ཕྱིར་དུ་ལྗགས་རྩོམ་དང་རྩོམ་སྒྲིག་གི་མཛད་པ་རྒྱ་ཆེར་བསྐྱངས་ནའང་།",
