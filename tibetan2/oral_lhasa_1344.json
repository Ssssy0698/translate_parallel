    "ཀ་མ་མ་ཨ་ཡཔསྐྱེས་པའི་བདེ་བའི་དངོས་པོ་རྣལ་འབྱོར་པས་མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྣམས་ཀྱི་ནང་ནས་ཁྱད་པར་དུ་གསུམ་པོའི་མིང་ཡེ་ཤེས་སད་པའི་ཕྱིར་བསྟན་ན་སུམ་ཅུ་པོ་གཟུང་བ་དང་འཛིན་པ་སྤངས་པའོ།",
    "དེས་ན་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོ་བསྒོམས་པར་འགྱུར་རོ།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོ་བསྒོམས་པར་འགྱུར་པ་ཅིའི་ཕྱིར་ལགས།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་ཨེ་ཝཾ་མཱ་ཡཱ་ཞེས་པས་ཅི་ཞིག་བརྗོད་པ་ཨ་༣ ཕམ་བག་དལ་བན་ལགས།",
    "སྐད་ཅིག་མའི་ཁྱད་པར་ལས་འདི་རྣམས་ཀྱི་དབྱེ་བའོ།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་ཅིའི་ཕྱིར་མ་ཧཱ་ཀཱ་ལ་ཞེས་བརྗོད་པ་ལགས།",
    "ཡི་གེ་བཞི་རྣམ་པར་དག་པ་ནི་ནག་པོ་ཆེན་པོའོ།",
    "སྒྲ་བཞིའི་ཐ་སྙད་ཀྱིས་བརྗོད་པའང་རྣམ་པར་གྲོལ་བའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "གསང་བ་པ་རྣམས་ཀྱི་ཡབ་ནག་པོ་ནག་པོ་ཞེས་གྲགས་པ་འདིས་འཇིག་རྟེན་གསུམ་པོ་འདི་ཡང་སྡུད་པར་བྱེད་ཅིང་ཡང་སྐྱེད་པར་བྱེད་དོ།",
    "སྒྱུ་མ་རྣམ་པར་འཕྲུལ་པ་ཀུན།",
    "བཅོམ་ནས་ངེས་པར་བསྒྲུབ་པར་བྱ།",
    "དེའི་ཕྱིར་བ་ཧི་ཏྲ་ཡི་ཕྱེ་མ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "གང་ཞིག་རྒྱུད་འདི་ཀློག་གམ་འཛིན་ནམ་བརྗོད་དམ་རིག་པར་བྱེད་པ་དེ་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་དབུགས་དབྱུང་བར་བྱེད་ཅིང་བླ་ན་མེད་པའི་སྣོད་དུ་འགྱུར་རོ།",
    "དེའི་རོལ་པས་གྲུབ་པ་བརྒྱུད་འགྲུབ་པར་འགྱུར་རོ།",
    "ནག་པོ་ཆེན་པོས་བྱིན་གྱིས་བརླབས་པར་འགྱུར་རོ།",
    "འདི་ལས་ཕ་རོལ་གྱི་གྲོང་དུ་འཇུག་པའི་རིགས་པས་ཀྱང་དེ་བཞིན་དུ་སྟོང་པ་དང་སྟོང་པར་རྩེ་བར་བྱའོ།",
    "ཁ་དོག་ནག་པོ་མཆེ་བ་གཙིགས་པས་འཇིགས་པར་བྱེད་པ།",
    "དགའ་བ་བཞི་རྣམ་མཚོ་༣ ས་སན་པར་དག་པ་རྣམས་ནི་མདུན་དུ་ཀཱ་ལི་ཀཱ་གྲི་གུག་དང་ཐོད་པའི་ཕྱག་ཅན།",
    "ཕྱག་བཞི་པ་བསྐྱེད་པའོ། ཕྱག་དྲུག་པར་ལྡང་བ་ནི།",
    "འཁོར་ལོ་དྲུག་རྣམ་པར་དག་པ་ཐམས་ཅད་སྔ་མ་བཞིན་ཏེ།",
    "མཆེ་བ་གཙིགས་པས་འཇིགས་པར་བྱེད་པ།",
    "གང་ཞིག་ཤེས་པ་ཙམ་གྱིས་རྣལ་འབྱོར་པས་དངོས་གྲུབ་བརྒྱད་སྒྲུབ་པར་བྱེད་པའོ།",
    "འཇིགས་པའང་འཇིགས་པར་མཛད་པ།",
    "དང་པོས་གཤིན་རྗེ་མནན་པ་སྟེ་རིམ་པ་ཇི་ལྟ་བས་རྗེས་སུ་འབྲངས་ནས་ཤེས་པར་བྱའོ།",
    "རྣལ་འབྱོར་དང་རྣལ་འབྱོར་མ་ཡི་དངོས་གྲུབ་ཀྱང་བསྒྲུབ་པར་བྱའོ།",
    "དད་པས་ཡང་དག་པར་རབ་ཏུ་འཇུག་གོ།",
    "ཞལ་ཐམས་ཅད་རྣམ་པར་འགྱུར་བ།",
    "འ་གཙངའི་ས་བཅ་དབ་ཀ་ར་༧ བམ་པོ་ཉི་ད་ཀླུ་ཡི་རྒྱན་གྱིས་བརྒྱན་པ།",
    "ངེས་པར་ཕྱག་རྒྱའི་དངོས་གྲུབ་བོ།",
    "འཇིགས་པའང་འཇིགས་པར་མཛད་པ།",
    "ཤིན་ཏུ་འཇིགས་པའང་འཇིགས་པར་མཛད་པ།",
    "གཟུགས་གཞན་གྱི་ཁྱད་པར་ལས་ཀྱང་གང་ཉིད་ཀྱིས་ཕྱག་རྒྱའི་དོན་ཐོབ་པར་འགྱུར་རོ།",
    "གང་དུ་དངོས་པོ་དང་དངོས་མེད་རྣམ་པར་སྤངས་པ།",
    "ངེས་པ་ཉིད་དུ་ཕྱག་རྒྱའི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ལ་བསམ་པར་བྱའོ།",
    "འདི་ལྟར་དམ་ཚིག་བསམ་པར་བྱའོ།",
    "མཁའ་འགྲོ་དང་མཁའ་འགྲོ་མ་དང་འབྱུང་པོ་དང་ཤ་ཟ་དང་གནོད་སྦྱིན་དང་ལྷ་མ་ཡིན་དང་ནམ་མཁའ་ལྡིང་དང་མི་རྣམས་ཐམས་ཅད་དྲན་པ་ཙམ་གྱིས་ཞུམ་པ་དང་འཇོམས་པར་འགྱུར་རོ།",
    "ཉི་མའི་གདན་ལ་གནས་པ་སྐྱིལ་ཀྲུང་བྱེད་པའི་རོལ་པས་བཞུགས་པ།",
    "དངོས་གྲུབ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་པའོ།",
    "སེང་གེ་མནན་ཅིང་གཡོན་བརྐྱང་པའི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "འཇིགས་པའང་འཇིགས་པར་མཛད་པའོ།",
    "གཡོན་བརྐྱང་བའི་ཞབས་ཀྱིས་ལོག་འདྲེན་མནན་ནས་བཞུགས་པ།",
    "འཇིགས་པའང་འཇིགས་པར་མཛད་པ།",
    "ནན་ཏན་དུ་བྱེད་པ་དང་དྲན་པར་བྱེད་པ་དེས་ཀྱང་དངོས་གྲུབ་བརྒྱུད་འགྲུབ་ཅིང་ངེས་པར་བགེགས་ཉམས་པ་དང་རབ་ཏུ་ཞི་བར་འགྱུར་རོ།",
    "དཀའ་ཐུབ་དྲག་པོས་བཅོམ་ལྡན་འདས་ལ་དད་པའི་བློས་འབད་པས་བསམ་པར་བྱས་ན་བགེགས་རབ་ཏུ་ཞིའོ།",
    "དེ་ལ་འདིར་བྱ་བས་བསྒྲུབ་པར་བྱ་བ་བཅོམ་ལྡན་འདས་ཀྱི་དངོས་གྲུབ་ཀྱི་སྤྱོད་པའི་མཚན་ཉིད་དོ།",
    "ཤ་ཟ་རྣམས་ཀྱང་ཐམས་ཅད་བཀའ་བཞིན་བསྒྲུབ་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་ངེས་པར་ཡིད་ཀྱིས་བསམ་པར་བྱའོ།",
    "ནང་དུ་སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་བསམ་པར་བྱའོ།",
    "དེས་གྲུབ་པ་བརྒྱད་སྦྱིན་པར་འགྱུར་རོ།",
    "དེ་ལྟར་རྣལ་འབྱོར་པས་རྟག་ཏུ་བཞེངས་པ་ལས་ཐམས་ཅད་བསྒྲུབ་པར་བྱའོ།",
    "གསོད་པ་ལ་སོགས་པའི་ལས་རྣམ་པར་སྨིན་པ་ཅན་མ་བྱེད་ཅིག་ཅེས་དཔལ་ནག་པོ་ཆེན་པོའི་རྒྱུད་ལས་ཕྱག་རྒྱ་གཏན་ལ་འབེབས་པ་དང་ལྷ་བཞེངས་པའི་སྐབས་ཏེ་དང་པོ་རྫོགས་སོ།",
    "གཉིས་པར་ཅོད་པན་འཆིང་བའི་བྱ་བ་བྱེད་དུ་འཇུག་པའོ།",
    "གསུམ་པར་སློབ་དཔོན་དྲིལ་བུ་ལ་སོགས་པ་གྲངས་བཞིན་འཛིན་པས་སོ་སོར་འཛིན་དུ་འཇུག་པའོ།",
    "སྔོན་དུ་ནག་པོ་ཆེན་པོ་ཕྱག་བཞི་པའི་སྔགས་སྟོང་ཕྲག་བཟླས་པར་བྱའོ།",
    "ངེས་པར་བཟའ་བ་དང་བཏུང་བ་རྣམས་ཀུན་ཏུ་སྤྱད་དོ།",
    "གོ་ཀུ་ད་ཧ་ན་ལ་སོགས་པ་རྣམས་བསམ་པར་བྱ་སྟེ་ཁྲག་ལ་སོགས་པ་རིག་པས་སོ།",
    "འཁོར་ལོའི་དབྱིབས་ཅན་ཟླུམ་པོ་ནི་སྤྱི་བོ་ལ་སྟེ་ཀླུ་ཡི་རྒྱལ་པོ་དང་བཅས་པའི་རྣམ་པ་འཛིན་པར་བྱའོ།",
    "ཆང་དང་སྣ་མའི་མེ་ཏོག་ལ་སོགས་པ་དང་བདུད་རྩི་ལྔའི་གཏོར་མ་སླར་ཡང་སྦྱིན་པར་བྱའོ།",
    "དེའི་ཕྱི་ནས་དེ་མ་ཐག་ཏུ་ག་བུར་དང་ཙནྡན་དང་གུར་གུམ་དང་གླ་རྩི་ལ་སོགས་པ་རྣམས་ཀྱི་དྲི་བཟང་པོ་བསྣམ་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་དབྱེ་བ་མེད་པ་དེ་ལྟར་འབད་པས་བསྙེན་པར་བྱའོ།",
    "ངེས་པར་ནག་པོ་ཆེན་པོས་བྱིན་གྱིས་བརླབ་པར་འགྱུར་རོ།",
    "ངེས་པར་བྷ་གར་འོ་བྱེད་ཅིང་གཞིབ་སྟེ་བཏུང་བས་དངོས་གྲུབ་བརྒྱུད་འགྲུབ་པར་འགྱུར་རོ།",
    "༣་ མ་ལ་བ་༣། དཔལ་ལྡན་གཤིན་རྗེའི་གཤེད་དམར་པོའི་རྒྱུད་ཀྱི་རྒྱལ་པོ་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་བདག་མེད་མའི་བྷ་ག་ལ་བཞུགས་སོ།",
    "དེ་ལ་མགྲིན་པར་དམ་འཁྱུད་དེ།",
    "ཀྱེ་རྡོ་རྗེར་གསུངས་པ་དང་།",
    "སླར་ཡང་ཆེས་མང་དུ་གསུངས་ཀྱང་།",
    "སྣ་ཚོགས་རྒྱུད་རྣམས་སུ་གསུངས་ཀྱང་།",
    "བཞི་པར་བཏང་སྙོམས་རྣམ་བསྒོམ་བྱ།",
    "ཡོངས་བཏང་སྟོང་པར་བསམ་པར་བྱ།",
    "བཞི་པར་ཡི་གེ་དགོད་པའོ།",
    "དེ་ལས་ངེས་པར་བྱུང་བའི་འོད་ཟེར་རྣམས་ཀྱིས་ནམ་མཁའི་ཕྱོགས་སུ་དཔའ་བོའི་གཟུགས་དེ་ལ་འཇིག་རྟེན་གསུམ་པོ་ཐམས་ཅད་བསྡུས་ནས་སླར་ཡང་དེ་ཉིད་དུ་བཅུག་སྟེ།",
    "དཔལ་གཤིན་རྗེའི་གཤེད་དམར་པོའི་གཟུགས་སུ་བདག་ཉིད་བསམ་པར་བྱའོ།",
    "ལྗགས་འདྲིལ་བ་འཇིགས་པར་བྱེད་པ།",
    "ཀླུ་བརྒྱད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "སྤྱན་གསུམ་པ་ཤིན་ཏུ་འཇིགས་པར་བྱེད་པ་དམར་པོ་འབར་བའི་རྒྱུན་མི་ཟད་པ་འོད་ཟེར་སྣ་ཚོགས་ཀུན་ཏུ་འཁྲུགས་པ།",
