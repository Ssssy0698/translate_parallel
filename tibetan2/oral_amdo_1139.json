    "ཐོག་མ་ནས་རང་བཞིན་ངང་གིས་གྱིས་ངོ་བོ་མ་སྐྱེས་མ་བྱུང་བ།",
    "ཡུལ་གྱི་རྣམ་པ་ཁྱབ་འཇུག་ཇི་ལྟ་བ་ཤེས་ལ་ཚོགས་དྲུག་གི་རྟོག་པ་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་རགས་པས་བསྒྲིབས་པས་གསལ་བར་མི་མངོན་ཏེ།",
    "ཚོར་བ་བཟང་ངན་ཉམས་སུ་མྱོང་ཚོར་བ་དང་ཡུལ་ཀུན་རྣམ་པར་གཅད་རེག་པ་དང་།",
    "ལྔ་ནི་ཐུན་མོང་སྟེ།",
    "རྟག་ཏུ་རེག་དང་ཡིད་བྱེད་དང་།",
    "ཀུན་གཞི་རིག་མ་རིག་གི་སྐད་ཅིག་མའི་རྒྱུན་གྱིས་བཟང་ངན་གྱི་ཁྱད་པར་དབྱེ་བསྟན་བཅོས་པ་བའི་གྲངས་གཉིས་སུ་སྣང་བ་གང་སྙམ་པ་ལགཞི་དང་རྟེན་ཞེས་གྲགས་པ་ལ།",
    "འདི་དག་ཀྱང་རྒྱུ་འབྲས་ཐུན་མོང་བའི་ལམ་དང་།",
    "འབྲས་བུ་ཐུན་མོང་མ་ཡིན་པ་ཉིད་ཀྱི་ལམ་ལྔར་ཅི་རིགས་པར་སྦྱར་རོ།",
    "དུ་མའི་གྲངས་སུ་འདྲེན་པ་དེས་ཐུན་མོང་མ་ཡིན་པའི་ལམ་ཡིན་པར་ཡང་གསལ་ལོ།",
    "མ་རྟོགས་པས་ཀུན་ནས་ཉོན་མོངས་པར་སྣང་བའི་གཞིའོ།",
    "ཀུན་གཞི་ལས་མིང་གི་རྣམ་གྲངས་ཐ་དད་དུ་གྲགས་པ་ལའང་གཉིས་ལས།",
    "སབར་གྲགས་པའི་མིང་གི་རྣམ་གྲངས་ཇི་ལྟ་བུ་སྙམ་པ་ལ།",
    "དེ་རེ་རེ་ནས་བསྟན་པའི་ཕྱིར།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་རྣམ་པར་ཞེན་པའི་བག་ཆགས་དང་མི་འགྲེལ།",
    "ཀུན་གཞི་ལྔ་རེ་རེ་ལ་རྒྱུ་དང་འབྲས་བུ་གཉིས་ཡོད་པ་ནི།",
    "བྱེ་བྲག་གིས་རྣམ་པར་རྟོག་པ་མེད་པ་དང་།",
    "པས་ཨ་ཆ་ཨ་ཀ་ཀ་ཀ་ཐབ་ཀ་ལ་ལག་ལ་ཟ་ཀ་བསྨཆ་དད་པ་བླངས་ཤིང་ཁམས་གསུམ་གྱི་བག་ཆགས་ཀྱི་ས་བོན་ཀུན་གཞི་ལ་ཡོད་པ་སྲིད་པ་དག་རྣམསསྐད་ཅིག་མ་སྔ་མའི་བག་ཆགས་སྔ་མ་ཡོངས་སུ་རྫོགས་པའི་ཡན་ལག་དང་འདུས་འཕེན་པའི་ཡན་ལག་གིས་འབྲས་བུར་སྨིན་པར་བྱེད་པ་ལམ་དུ་སྦྱངས་པས་ས་བོན་ཟད་པ་དང་།",
    "རྐྱེན་ངན་པས་ཐ་དད་ཀུན་ནས་ཉོན་མོངས་པའི་གཞིར་འགྱུར་ལ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ལ་གནས་ཏེ་སྤོང་ངོ་ཞེ་ན་དྲི་མའི་ངོ་བོ་བས་སྤང་བའི་གཞིར་མི་བཏུབ་པས་མཆིང་བུ་རིན་ཆེན་དུ་མི་འགྱུར་བ་དང་འདྲའོ།",
    "ཡིད་ལ་གནས་པ་ལ་སྤང་དུ་ནི་ལམ་གྱི་དུས་ན་ཡིད་གཉེན་པོ་ལམ་གྱི་ཡེ་ཤེས་སུ་གྱུར་འགྲེལ་། པས་གཉེན་པོ་ལ་ཉོན་མོངས་པ་གནས་སུ་མི་རུང་སྟེ།",
    "ཚོགས་དྲུག་རང་རེའི་བག་ཆགས་རང་རེ་ལ་བསྒོའོ་འགྱུར་ཞེ་ན།",
    "རིགས་འདུས་ལ་བྱ་ན་གཞན་དུ་ཐལ།",
    "དེ་བཞིན་གང་གིས་འགག་འགྱུར་ན།",
    "ཞེས་པ་སྔ་མ་ལྟར་འགག་པའང་ཡང་རྐྱེན་གང་ཞིག་གིས་བརྒྱལ་ལམ་བོགས་སམ་མྱོས་པའི་དུས་ན་ཚོགས་དྲུག་འགག་པས།",
    "མཚུངས་པ་ཡིན་ཕྱིར་དེར་སྣང་སྟེསོ་སོའི་བྱེ་བྲག་དེ་ཙམ་མོ།",
    "གང་དང་གང་དུ་གང་ཉོན་མོངས།",
    "ཇི་སྲིད་དེ་རྒྱུན་བྱུང་ཚོར་རྣམས།",
    "མཚོ་ལས་ཡར་རླབས་མོ་ལྡང་བ་དང་།",
    "ས་ལས་རླངས་བྱུང་བ་ལྟར་ཡུན་ཇི་སྲིད་ཐོག་མཐའ་མེད་པར་བག་ཆེནཆགས་བསགས་པའི་སྐད་ཅིག་མའི་དེ་རྒྱུན་གྱི་བྱུང་ཚོར་ཀུན་རྐྱེན་གྱིས་མ་བསླང་ཡང་།",
    "ཀུན་གཞི་བག་ཆགས་འཛིན་པའི་ཐབས་དཔེ་གང་གིས་མཚོན་ཞེ་ན།",
    "ཐེར་སླང་སླང་དུ་གི་དྲེག་པ་དང་།",
    "འབྲས་བུ་ཆེ་མང་ཉུང་དུ་འགྱུར་བ་ལྟརབག་ཆགས་སྔ་མའི་ས་བོན་ཆེ་ཆུང་ལ་ཕྱི་མའི་རྐྱེན་ཆེ་ཆུང་གིས་འཕེལ་འགྲིབ་ཏུ་འགྱུར་རོ།",
    "བསྟན་བཅོས་པ་ལིང་ཐོག་གིས་རྫས་མི་མཐོང་བ་དང་།",
    "གཅིག་གིས་སྣ་ཚོགས་ཐ་དད་ལེན།",
    "གཅིག་གི་སྣ་ཚོགས་འབྲས་བུ་མཐོ་རིས་ངན་སོང་ཐ་དད་པའི་སྐྱེ་གནས་ལེན་པའོ།",
    "ཀུན་གཞི་བག་ཆགས་ཀྱང་རྒྱུ་བ་ཕྲ་བ་ལཚོགས་དྲུག་གིས་བསྒྲིབས་པས་རིས་སུ་ཐ་དད་མ་ཡིན་ངོ་བོ་ཙམ་བརྟགས་དཀའ་བའོ།",
    "ཞེས་པ་ཀུན་གཞི་གང་དེར་འདིར་འདུས་གཅིག་ལ་དགེ་སྡིག་གི་བག་ཆགས་ཚེ་འདིར་བསགས་པ་མཐུ་བརྟས་པ་དེས་འདྲེས་ཏེ་གཅིག་པ་ལྟ་བུར་སྣང་བ་ལསཀུན་ནས་ཉོན་མོངས་པའི་བག་ཆགས་སྤོང་ལརྣམ་པར་བྱང་བསྟན་བཅོས་པ་བའི་བག་ཆགས་དང་དུ་ལེན་པ་ནི།",
    "དྲི་ངའི་དྲི་འབྱུང་གང་གི་དྲི།",
    "སྒོག་པ་ཡུན་རིང་དུ་བརྡུངས་ན་ཕོར་བུ་ལ་ཞེན་ནསའཇུག་གང་སྒོག་པ་མེད་ཀྱང་ཕོར་བུ་གང་ལ་འགྱུར་སྔ་བྲོ་ཞིང་ཞེན་པ་མནམ་པ་དེསྒོག་ཕོར་གཉིས་ངོ་བོ་མི་འདྲ་ཡང་མི་མཐུན་ཐ་དད་ལ་རྒྱུ་ཡང་མི་གཅིག་སོ་སོ་ཐ་དད་ཀྱང་ཡུན་རིང་ན་དེ་ཉིད་ལ་འགོས་པ་ལྟརཀུན་གཞི་དེ་ཉིད་དང་དེ་རྒྱུན་བག་ཆགས་ཀྱང་དེ་ལྟ་བུ་ལ་ཚོགས་དྲུག་གི་ལས་མང་པོ་སྤྱད་པས་བསྒོའོ།",
    "ཀུན་གཞི་རྒྱུ་འབྲས་གཉིས་ཀ་ཡིན་པའི་དཔེ་ནི་གང་ཞེ་ནགང་གི་ངོ་བོ་དེ་གཅིག་ལ།",
    "གང་གིས་རྒྱུས་སངས་ཀུན་ཁྱབ་རྒྱུས།",
    "ཡན་ལག་གི་འཁོར་དུ་དང་ལྡན་པའོ།",
    "བྱེ་བྲག་ནི་མིང་གི་རྣམ་གྲངས་དང་ཁྱད་པར་བཀའ་གཉིས་བསྟན་པའོ།",
    "གང་དུ་གང་གིས་གང་ཕྱིར་གང་།",
    "གཉེན་པོ་གང་གིས་སེལ་ན་ས་ལྔ་པའི་ཡེ་ཤེས་ཀྱིས་སྣང་ངོ།",
    "གང་ཟག་གི་དངོས་པོ་བློ་ཆུང་བའི་སྤྱོད་ཡུལ་དུ་གྱུར་པས།",
    "ཞེས་པ་བོས་ནས་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ཉེ་བར་བསྟན་པ་ནི།",
    "ཞེས་པ་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ཀྱི་གནས་ནི།",
    "དེ་ཡང་འཇིག་ཚོགས་ནི་ཕུང་པོ་ལ་བདག་དང་བདག་གིར་ལྡན་ལ་ཕུང་པོའི་གཞི་ནི་ཀུན་གཞི་ཡིན་པས།",
    "ཕྱོགས་འཛིན་ཕྱོགས་མེད་རྣམས་དང་གཅིག་ཅེས་པ་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ཀྱི་འཁོར་ནི་གཉིས་ཏེ།",
    "ཐུན་མོང་ཕྱོགས་མེད་གི་འཁོར་ནི།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་མེད་ན་སྐྱོན་ལྔ་སྟེབདག་ཏུ་བསྟན་བཅོས་པ་གཏི་མུག་ཅེས་བྱ་བའི་སེམས་ལས་བྱུང་བའོ།",
    "ཉོན་མོངས་ཅན་གྱི་ཡིད་མེད་ན།",
    "ཞེས་པ་དེ་ལྟ་བུའི་ཡིད་དེ་འཛིན་དེ་གཟུགས་ཀྱི་ཕུང་པོ་དེ་ལ་བདག་གིར་དེར་འཛིན་པས་འཛིནམིང་གཟུགས་བཞི་ཕུང་པོ་ལ་ངར་འཛིན་བཀའ་ཞེ་བདུན་པས་ཕུང་པོ་ལྔ་ཀ་ལ་ཆགས་ཁམས་སོ་ཤིང་ཞེན་པའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་འདུ་བྱེད་ལྔ་བཅུ་རྩ་གཅིག་རིལ་དང་རྟག་ཏུ་གཅིག་རྒྱུན་དུ་འགྲོགས་པའོ།",
    "ཞེས་པ་རེ་ཞིག་པ་དང་གཏན་ཞེ་བརྒྱད།",
    "འདིར་རེ་ཞིག་པ་རྟག་ཏུ་འདུ་ཤེས་མེད་པ་དང་།",
    "ཞེས་པ་ལས་ནི་གཉིས་ཏེ་ཐུན་མོང་དང་ཁྱད་པར་རོ་ དེ་ལ་ཐུན་མོང་གི་ཡུལ་བཅད་པའི་བག་ཆགས་མང་པོ་ཀུན་གཞི་ལ་འགོད་དོ།",
    "ལྔ་དང་ཐུན་མོང་དེ་ཁྱད་པར།",
    "གང་གིས་འབྲས་བུ་ཡོངས་སུ་མྱོང་བའོ།",
    "དགེ་སྡིག་གི་རྣམ་པར་སྨིན་པ་མྱོང་བ་དང་དྲུག་གོ།",
    "གསང་བ་མཆོག་གི་བདག་པོ་དེ།",
    "རང་གི་ངང་གིས་འཇུག་འཚོལ་བ།",
    "སོ་སོར་རྟོགས་དང་ཉོན་མོངས་ཅན།",
