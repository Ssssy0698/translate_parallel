    "གསུང་གི་འགྱུར་བའི་དེ་མཚོན་ན།",
    "ཞེས་པ་གསུང་བརྡ་ཚིག་ཇི་ལྟར་ཡང་བརྗོད་པས་དོན་གྱི་དངོས་པོ་སྒྲོ་སྐུར་མེད་པར་མཚོན་པ་ནིསྟོན་པའི་བཀའ་ལུང་གི་ངོ་བོ་ཡིན་ནོ།",
    "ཞུས་ལན་ཕྲ་མོ་གང་གི་བསྟན་བཅོས་པ་མུན་པའི་སྤྱོད་ཡུལ་བསྟན་པའི་ལེའུ་ཞེས་པ་ལེའུའི་མཚན་བསྟན་པའོ།",
    "རྩ་བ་གང་ལ་གང་གི་སྣང་བ་ཡོངས་སུ་དག་པའི་སྤྱོད་ཡུལ་གང་ལགསདེ་སྐད་ཅེས་གསོལ་པ་ལས།",
    "གང་གིས་བཞུགས་པ་དེའི་ཚེ་དེའི་དུས་ན།",
    "དོན་དེ་ཉིད་དོན་ལ་རང་གི་བློ་ཡིད་ལ་བྱ་བསམ་མེད་པར་ངེས་པར་བཞག་པས་སེམས་ཉིད་གནས་འདུག་འགྲེལ་ན་ཡེ་ཤེས་ལྔ་དེ་ཁོ་ན་ལས་གཞན་ན་མེད་དོ།",
    "རྣལ་འབྱོར་གསུམ་དོན་དེ་ཡི་སྐབས་ན་སྔགས་། རྫོགས་ ཞེས་པ་ཏིང་ངེ་འཛིན་རང་གི་ངོ་བོ་ནི་མ་ཡེངས་སྐྱེ་འགགས་མེད་ཉིད་ཏིང་ངེ་འཛིན་ཏེ་རང་རིག་པ་མཉམ་པའི་ངང་ལས་མ་གཡོས་པའོ།",
    "གང་གི་འདི་མཐོང་དེ་ཡི་ཞལ་མཐོང་འགྱུར་སྔ་ཡིན་ཞེས་པ་རྒྱུད་འདིའི་དོན་སྟོན་པ་དེ་ཉིད་རྡོ་རྗེ་སེམས་དཔའ་ཉིད་ཡིན་ཏེ།",
    "མསྒྲིབ་པ་གཉིས་བྱང་ཚོགས་གཉིས་རྫོགས་པས་ན།",
    "གང་གི་ཕྱོགས་རྣམས་མཐུན་པར་ས་རྣམས་ནོན།",
    "ཞེས་པ་མོས་པ་ལས་བྱུང་བའི་མི་དམིགས་པ་དང་།",
    "དེའང་ཉོན་མོངས་པ་དང་ཤེས་བྱར་བསྙད་པ་དང་།",
    "འདི་ནི་ཀུན་འདུས་དགོངས་སྤྱོད་ཟབ་མོ་ཡིན།",
    "གང་གིས་གང་ལྟར་དེ་ཡི་དོན་མཐོང་ལྟར།",
    "གཉིས་སུ་མེད་པ་ནི་མི་བདེན་པ་རིས་སུ་མ་ཆད་ཅིང་སྤྱོད་ཡུལ་དང་གཉིས་ཐ་དད་མེད་དེ་རང་རིག་པ་ཙམ་མོ།",
    "མཐོང་དང་མ་མཐོང་རེ་རྩོལ་རྐྱེན་ཙམ་གྱི།",
    "མཐའ་གཉིས་ངང་གིས་བསལ་ཞེས་སྨྲ་བ་ཡང་།",
    "དོན་དམ་པར་རང་བཞིན་སྐྱེ་འགག་མེད་པ་ནམ་མཁའ་ལྟ་བུར་འདོད་པའི་སྐབས་དེས་གསང་སྔགས་ཀུན་འདུས་བདེན་པ་རྣམ་གཉིས་དབྱེར་མེད་ཀུན་ལ་མཐོང་བ་མེད་མ་མཐོང་སྟེརང་གིས་ལྟ་བས་བསྒྲིབས་སོ།",
    "རང་བྱུང་གི་ཡེ་ཤེས་བདེན་པ་གཉིས་ཀྱི་ཐ་སྙད་ལས་འདས་པའི་དོན་རང་རིག་པའི་མངོན་སུམ་དུ་ཤར་བའི་དུས་ན།",
    "དེ་ལྟར་བསྒོམས་པའི་ཚེ་རྣམ་རྟོག་གཟུགས་མཐོང་སྒྲ་ཐོས་ལ་སོགས་པའི་བྱུང་ཚོར་ཅི་བྱུང་ཡང་།",
    "གདམས་ངག་གི་ནན་ཏན་བསྟན་པའི་ཕྱིར།",
    "ངེས་པའི་དོན་ནི་གཞན་ཞིག་མེད་དེ་རང་རིག་ཁོ་ནར་ཟད་གི་སེམས་ཀྱི་དེ་ཁོ་ན་ཉིད་མ་བཅོས་བཀའ་བརྒྱདཔ་འབའ་ཞིག་ཏུ་ངེས་པར་གཟུང་བས་དེ་ལས་ལྷག་པ་མེད་དོ།",
    "གྲོགས་པོ་དག་དེ་ལ་མི་འདའ་བའི་རང་བཞིན་གང་ཞེ་ནའདི་ལྟ་སྟེཞེས་པ་མི་འདའ་བ་དམ་ཚིག་གི་རང་བཞིན་ཉེ་བར་སྟོན་པའོ།",
    "རྣལ་འབྱོར་པ་སུ་ཡང་རུང་བའི་བློ་ལ་བསྲུང་མི་བསྲུང་གི་རྟོག་པ་མེད་ན་མཆོག་གོ།",
    "བརྗེད་པ་མེད་པའི་དམ་ཚིག་གིས།",
    "ཚ་གྲང་གང་གིས་གདུང་བས་མི་ཉེན་ཞིང་དེ་ཉིད་ལས་སྐྱོབ་པ་དག་ཙམ་ལས་ལྷག་པར་བཟང་ཆེན་བ་དང་མཛེས་པའི་རྒྱན་ཕྱིར་མི་བཅོས་པ་དང་།",
    "མཆོད་རྟེན་དག་གི་ལས་མི་བྱ།",
    "ཀློང་ཡངས་ཆུབ་པའི་རྣལ་འབྱོར་ལ་གནས་པས་བྱ་བ་གང་གིས་ཀྱང་བསྟངས་སུ་མེད་པའི་ཕྱིར།",
    "སློང་མོ་བསོད་སྙོམས་མི་བྱ་བའི་གཏན་ཚིགས་ནི།",
    "ཆགས་སྡང་དང་གཡེང་བ་སྐྱེས་ན་བདག་གི་དོན་དུ་མི་འགྱུར་བ་དང་།",
    "དེ་དག་ནི་རྣལ་འབྱོར་མཆོག་གི་ལུས་སྤྱོད་དེ་རྣམ་གྲངས་བསྡོམས་ན་བརྒྱ་རྩ་བརྒྱད་དུ་འགྱུར་རོ།",
    "རྡོ་རྗེ་ངག་གི་སྤྱོད་ཡུལ་ཡང་།",
    "ངག་གིས་ཇི་སྐད་བརྗོད་པ་ལྟར་དེ་བཞིན་དང་མཐུན་པར་བྱ་བ་དང་།",
    "ཆགས་སྡང་གི་སེམས་མི་བྱེད་པ་དང་།",
    "གདུལ་བྱའི་གང་གི་བློ་ལ་མངོན་སྣང་བར་བྱ་བའི་ཕྱིར་ཆེད་དུ་སྤྱོད་པ་ལེགས་པར་ཡོངས་སུ་མཛེས་པར་བྱ་བ་དང་བག་ཡོད་པ་དང་།",
    "གང་གི་ཟུག་རྔུ་ཀུན་བྱང་དེ།",
    "གང་གིས་དགོངས་པ་ངེས་འགྲེལ་བ།",
    "གང་གི་གཟུགས་བརྙན་གང་སྣང་བ།",
    "ཕྲ་མོ་ཐ་མལ་ཆེན་པོ་ཡི།",
    "དངོས་མེད་ངོ་བོ་། མེད་པར་རང་སྣང་བ་སྟེ་སེམས་སྐྱེ་ལུགས་ཀྱི་མཚོན་པར་འགྱུར་ཏེདངོས་མེད་རང་སྣང་རྟགས་དང་མཐུན་པའི་དཔེ་གཉིས་དཔེ་ཐུན་མོང་གི་རྣམ་གྲངས་བསྟན་པ་སྒྲ་འགྲེལབཞིན་ནོ།",
    "ད་དུང་གསང་སྔགས་དེ་ཁོ་ན་ཉིད་ལ་ཞུགས་པ་ནི་མ་ཡིན་ཏེ་མོས་པ་ཙམ་མོ་ནོ།",
    "ཚུལ་ནི་མུན་པ་ནས་མཚན་མོའི་མེའི་འོད་དམ་སྐར་མ་ཆེན་པོའི་འོད་ལྟ་བུར་རབ་རིབ་སྣང་བ་ལྟར་སྣང་སྐྱེའོ།",
    "དེ་དག་ནི་ཤེས་པའི་མཚན་ཉིད་དུའང་འགྱུར་ཏེརྟོགས་པ་བཞི་ལ་སོགས་པའི་ཡན་ལག་གི་རྐྱེན་དང་ལྡན་ནོ།",
    "རྟོག་ཆེན་དག་གི་སྐབས་དག་ལ།",
    "ཐབས་མཆོག་དཔག་གིས་མི་ལང་བས།",
    "རང་གི་ངོ་བོ་འདོར་བ་དང་།",
    "ཞེན་པ་འདོར་བ་གཉིས་ལསའདིར་རང་གི་ངོ་བོ་ཡང་འདོར་བའི་དཔེ་སྒྲ་བཞིན་ནོ།",
    "དེ་སྐད་སྟོན་པ་མཆོག་གིས་བཀའ་སྩལ་པ་དེའི་ཚེ་ཕྲིན་ལས་གྲུབ་པས་ཅང་མི་གསུང་པའོ།",
    "ཚིག་ལྷག་མ་ནི་དེ་ལྟར་སྔ་འགྱུར་བཀའ་མ་པ་བསྟན་ཀྱང་དོན་གྱི་ངོ་བོ་བརྗོད་མེད་ཚིག་གི་ཡུལ་བྲལ་བས་མི་ཕེབས་པས་སྨྲར་མེད་པས།",
    "གང་གི་ཐུགས་ལས་བྱུང་བའི་ལུང་།",
    "གང་དྲན་བྱུང་ཡང་གང་དུའང་མི་རྒྱུ་བ་འཐོམ་ཞིང་བླུན་པ་དེ་རྨོངས་པའི་ས་ཏིའོ་འགྱུར་སྔ་མེད་དོན་ཤེད་ཀྱང་མ་བྱེ་སྟེ་མུར་འཛིན་མ་རིག་པས་ནོན་པ་ནི་འདུ་ཤེས་མེད་པའམ་མཐུན་པའི་ལམ་དུ་མུ་སྟེགས་སུ་བྱོལ་སོང་ལྟུང་ངོ།",
    "བདག་གིས་འདི་ཞེས་ངོ་བོ་གཅིག་ཏུ་གང་བཟུང་ན་མུ་པསྟེགས་རྟག་པར་ལྟུང་ངོ།",
    "གང་འདིར་གང་སྤངས་གང་ཚོལ་བ།",
    "དེ་ཉིད་མ་ནོར་བའི་ལམ་མོ།",
    "བྱུང་ཚོར་གཡོ་འགོག་ཐམས་ཅད་ཀྱང་།",
    "ཞེས་པ་ལ་སོགས་པ་ལམ་ཆེན་པོའི་འགྱུར་གཉིསསྔ་སྐབས་གང་འདིར་གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་ལ་སོགས་པ་འདོད་སྤྱོད་ནི་ཡོ་བྱད་ཆེན་པོ་མ་ཡིན་ཏེམཉམ་པ་དེ་ཉིད་ཆེན་པོ་མ་ནོར་བར་རྟོགས་པ་ནི་ཡོ་བྱད་ཀྱི་ཆེན་པོ་སྟེ་མཆོག་གོ།",
    "དེ་རང་གི་ངོ་བོ་བསྟན་པ་ནི་ཅི་ཞེ་ན།",
    "ཞེས་པ་ལ་སོགས་པ་སྐབས་གང་འདིར་རྣམ་པར་རིག་པ་དང་རྣལ་འབྱོར་སྤྱོད་པའི་ཀུན་རྫོབ་པ་དོན་གྱི་ཕྱོགས་ཤེས་པ་ཙམ་དག་གི་སྤྱིའི་གཞུང་ནིཡུལ་བསྟན་བཅོས་པ་འདི་ཀུན་སྣང་རིལ་གང་འདིར་སེམས་སྣང་བ་ལ་ཁོ་ན་བས་ངེས་པར་གཟུང་བའོ།",
    "ཁ་ཅིག་ཕྱི་མོ་པ་དག་ནི།",
    "མཚན་ཉིད་དང་ངེས་ཚིག་གིས་རྣམ་པར་བསྙད་ནས་རྟོགས་པར་བྱེད་པའོ།",
    "རྣམ་དག་གི་དོན་དང་མཐུན་པའོ།",
    "ཞེས་པ་ལ་སོགས་པ་གསང་སྔགས་བླ་ན་མེད་པ་དམ་པ་ཉིད་ཀྱི་ལྟ་བ་དམ་པ་གང་མཆོག་གི་བཞེད་པ་ནི།",
    "ཡེའམ་ངང་གིས།",
    "དེ་ལྟར་དོན་མ་མཐོང་བའི་མི་ཤེས་མུན་སྤྲུལ་རྣམས་བཀའ་བཅོ་བརྒྱད་གང་གི་ནི་དེ་ཁོ་ན་ཉིད་མཐའ་དང་བྲལ་བའོ་ཞེས་ཞེ་བས་རྟོགས་པར་བྱེད་འཛིན་ཞིང་ཚིག་ཏུ་བརྗོད་ལ།",
    "འདི་ལྟར་འདིར་ནི་གང་གི་རྒྱུ།",
    "དེ་ནའགྲེལ་། དག་གི་འབྲེལ་བ་བསྒྲུབ་པ་བ་དང་།",
    "གཏན་ཚིགས་རྒྱས་པ་འབའ་ཞིག་གི་སྦྱོར་བ་བྱེད་པ་དང་།",
    "དོན་གང་ལ་རིག་པ་མཆེད་འཕེལ་ཞིང་གང་གི་ཤེས་རབ་ཀྱིས་དོན་ཀློང་དུ་ཞུགས་ཏེ།",
    "རྣལ་འབྱོར་མིག་གི་སྒྲོན་མ་བསྟན་པའི་ལེའུ་ཞེས་པ་ཤེས་རབ་ཀྱི་སྤྱན་དང་ལྡན་བུའགྲེལ་། པའི་ལེའུའི་མཚན།",
    "དེ་ལ་གང་འདི་རང་རང་གི་བློ་རྩལ་ཁྱད་པར་ཆེ་ཆུང་གིས་སོ་སོསོའི་ལྟ་བའི་འཇུག་སྒོ་མི་མཐུན་པ་ཀུན་ནས་སོ་སོར་སྤྱོད་པས་དེ་བརྒྱ་བཞིན་དེའི་དེ་ཉིད་གཅིག་གི་ངང་ལས་ལྟ་བའི་རྩལ་འཕང་མཐོ་དམན་གྱིས་ཁྱད་པར་ས་མཐོ་དམན་གོང་འཕང་ཁྱད་པར་དུ་གྱུར་ཏེ།",
    "ཞེས་པ་ལ་སོགས་པ་གང་རྙེད་སུ་ཞིག་ཝན་གིས་སེམས་ཀྱི་དོན་དེར་རྙེད་མཐོང་བ་ནི་དོན་ཆེན་པོ་ལ་དེར་གནས་པ་འདུག་པའི་ཕྱིར་རྣལ་འབྱོར་ཆེན་པོའི་སྤྱོད་པའི་ས་པ་ཡིན་ཏེསའི་རིམ་པ་ཀུན་རང་རིག་གཅིག་ཏུ་པའི་ཡེ་ཤེས་ཆེན་འདུས་པོ་དེ་ལ་ཡོངས་རྫོགས་པ་འདུས་པའོ།",
    "རྣམ་པ་བཅུ་ཕྲག་གཅིག་གིས་རྫོགས།",
    "ཁྱད་པར་འཕགས་པའི་ས་བཅུ་བསྙད་དེཐུན་མོང་མ་ཡིན་པ་གསང་སྔགས་ཀྱི་ལམ་ཤ་སྟག་ཏུ་འགྱུར།",
    "ཐུན་མོང་གི་རིམ་པར་བརྒྱུད་པའང་ཆེན་འགོག་པ་མ་ཡིན་ནོ།",
    "ཚུལ་རྟགས་འཛིན་དང་མོས་པ་དང་།",
    "ཞེས་པ་གཞི་དེ་ལ་ཉེ་རིང་དང་མཐོ་དམན་གྱི་བྱེ་བྲག་གི་ས་ལྔ་སྟེ།",
    "གསང་སྔགས་ལ་མོས་པས་དེའི་ཚུལ་རྟགས་དང་ལྷའི་ཆ་ལུགས་འཛིན་པ་སྨིག་སྒྱུ་ལྟ་བུ་དང་།",
    "ཐུན་མོང་དུ་ནི་འཇིག་རྟེན་ཕལ་པའི་སེམས་བརྒྱད་ལས་རྣལ་འབྱོར་ལྔས་རིམ་པར་སྐྱེའོ།",
    "ཐོག་མར་གསང་བའི་དོན་སྤྱིའི་མཚན་ཉིད་དུ་ཤེས་པ་དྲང་རང་གི་མཚན་ཉིད་མགོ་གོ་བ་རྣལ་འབྱོར་པ་ལ་དཔྱོད་པའོ།",
    "སྤྱིའི་བདེན་པ་གཉིས་ལ་རང་གི་མཚན་ཉིད་དུ་གོ་བའི་བསམ་པས་མཐོ་དམན་གྱིས་གསུམ་མོ།",
    "དག་དང་མ་དག་གིས་སྤྱོད་པའོ།",
    "ཞེས་པ་དེ་དག་གིས་སློབ་པ་ཡང་བསམ་དཔྱོད་དག་པས་སྤྱོད་པ་དང་།",
    "དེ་དག་གི་གནང་བ་ཐོབ་ནས་རིགས་ངེས་པར་འགྱུར་བ་ཅན་གྱི་རྣལ་འབྱོར་ཏེ་གནས་ཤིང་སྤྱོད་པ་འདི་དག་བཞི་སྟེཔའདུན་པའི་རྣལ་འབྱོར་ཉིད་ལས་བྱེ་བྲག་གཉིས་སུ་གྱུར་པའོ།",
    "གསང་སྒོ་ལུང་གི་རྣལ་འབྱོར་དང་།",
    "གསང་སྔགས་མཚོན་པའི་སྒོ་ལུང་ཟབ་མོ་ལ་བརྟེན་ཅིང་གཉིས་མེད་དོན་ལ་བཟོད་པས་ད་དུང་དྲོད་གཡོ་བ་ཙམ་ལས་མ་ཐོབ་པ་དང་བསླབ་པའི་མཐའ་བཅུ་དང་མི་བྲལ་བར་སྤྱོད་པས་རྒྱུན་གྱི་རྣལ་འབྱོར་གཉིས་མེད་རྟོགས་པ་གཡོས་པའི་ཡེ་ཤེས་འཕེལ་བར་བྱེད་པ་དང་།",
    "མོས་པ་དག་ཅིང་འདུན་པའི་པ་གནས་ རྩལ་ཆེན་བློ་ཡི་བསྟི་གནས་ས།",
    "དེས་བསམ་མོས་པ་པའི་གཟུང་འཛིན་དྲི་མ་རགས་པ་མི་ཤེས་པའི་དྲི་མ་དག་ཅིང་།",
    "ཤེས་རབ་ཀྱི་གདེང་གི་རྩལ་ཆེན་༧ ས་ར་ཚ་ཅ་༡པོར་ལྷུན་གྲུབ་ཀྱི་དོན་ལ་སྦྱོར་བ་པ་དང་།",
    "ཐམས་ཅད་ཡེ་ཤེས་ཆེན་པོ་ཡུལ་འདུས་དང་བྲལ་བར་རྟོགས་པས་བསྒོམ་ལམ་ཐོབ་ལ་མ་རག་བར་རེག་པ་སྦྱོར་བའོ།",
    "དེ་དག་ཀྱང་ཐུན་མོང་གི་ས་དང་པོ་རབ་ཏུ་དགའ་བ་ནས་བདུན་པ་རིང་དུ་སོང་བའི་བར་ལྟ་བུ་སྟེསྤྱིར་བཅོས་པ་མཐོང་བསྒོམ་གྱི་ལམ་གཉིས་ཀ་ཚང་ཡང་འདིར་མཐོང་ལམ་འབའ་ཞིག་གི་ཁྱད་པར་དུ་རིགས་ཏེས་བདུན་པོ་དེ་ཉིད་འདིར་རྫོགས་པས་སྐྱེད་དུ་འགྲོ་བའོ།",
    "སོ་སོ་ག་ཀ་ཎྞཾ་། ཐུན་མོང་མ་ཡིན་པའི།",
    "ཡེ་ཤེས་རེ་རེ་འཆར་བའོ།",
