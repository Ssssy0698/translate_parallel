    "ང་ཚོའི་འུ་ཐུག་གི་དུས་རབས་འདིར།",
    "ཚིག་འདིའི་ཁྲོད་ནས་ང་རང་ལ་གོ་བ་གཏིང་ཟབ་ཅིག་ཆགས་པ་ནི་འཚོ་གནས་ཀྱི་འཇིགས་ཉེན་བྱ་བ་དེ་རེད།",
    "གཅིག་ནས་མིའི་རིགས་ཀྱི་གདོད་མའི་མྱོང་ཚོར་ཞིག་ལ་ཕྱིར་ལྡོག་དང་།",
    "གཉིས་ནས་མི་སྒེར་བའི་ཚེ་སྲོག་གི་དེ་ཉིད་ལ་སད་རྟོག་འབྱུང་དགོས་པ་དེ་ཡིན།",
    "སྙན་ངག་ཅིག་གི་ངོས་ཐད་ནས་གླེང་ན་ང་ཚོས་མིའི་མཇུག་བྱང་།",
    "རིགས་ཀྱི་གདོད་མའི་རང་བཞིན་གྱི་དྭངས་གཙང་གི་སྐད་ཆའི་སྲོག་འགྲོས་ཤིག་གི་བབ་དང་ཉམས་འགྱུར་བསྙེག་དགོས་ལ།",
    "དེ་མཚུངས་སུ་མི་རང་ཉིད་ཀྱི་ཚོར་རྟོག་ལ་གཞི་རྒྱ་ཆེ་བའི་མིའི་རིགས་ཀྱི་ཚེ་སྲོག་གི་སད་རྟོག་ཅིག་ཀྱང་འདྲོང་དགོས་པ་དེ་ཡིན་ཏེ།",
    "དེབ་འདིའི་རྩོམ་སྒྲིག་འགན་འཁུར་པ་ལྷ་མོ་འཚོ་ལགས།",
    "མཛའ་བརྩེ་ནི་དངོས་གནས་རླབས་ཆེ་བ་ཞིག་རེད།",
    "ལྷ་མོ་འཚོ།",
    "གཅན་མེ་སྟག་གིས་བརྩམས།",
    "རྡོ་རྗེ་པདྨ་གཙུག་ལག་གི་རྩིས་བསྟན་པའི་ལེའུསྟེ་བཅུ་བཞི་པའོ་།",
    "རྡོ་རྗེ་ཕུར་པ་གཙུག་ལག་གི།",
