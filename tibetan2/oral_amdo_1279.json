    "ཟ་བྱེད་ཆེན་མོའི་རྣལ་འབྱོར་མ་ས་ཧ་ཤོ་རི་ཀ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྣལ་འབྱོར་མའི་འཁོར་རབ་ཏུ་མང་ཞིང་བསམ་གྱིས་མི་ཁྱབ་པའི་ཧེ་རུ་ཀ་མཐའ་ཡས་པ་ཤ་སྟག་རྣམས་དང་།",
    "གཞན་ཡང་གསང་བའི་བུ་མོའི་འཁོར་འདི་ལྟ་སྟེ།",
    "གསང་བའི་བུ་མོ་དཀར་མོ་ཞེས་བྱ་བ་དང་།",
    "གསང་བའི་བུ་མོ་རྐུན་མོ་ཞེས་བྱ་བ་དང་གསང་བའི་བུ་མོ་རྨོངས་མོ་ཞེས་བྱ་བ་དང་།",
    "གསང་བའི་བུ་མོ་རོ་ལངས་མ་ཞེས་བྱ་བ་དང་།",
    "གསང་བའི་བུ་མོ་གཏུམ་མོ་ཞེས་བྱ་བ་དང་།",
    "གསང་བའི་བུ་མོ་སྨེ་ཤ་ཅན་ཞེས་བྱ་བ་དང་།",
    "གཞན་ཡང་དགའ་བའི་བུ་མོའི་འཁོར་འདི་ལྟ་སྟེ།",
    "དགའ་བའི་བུ་མོ་སེང་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "དགའ་བའི་བུ་མོ་བྱ་རྒོད་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "དགའ་བའི་བུ་མོ་སྟག་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "དགའ་བའི་བུ་མོ་ཝ་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "དགའ་བའི་བུ་མོ་དུར་བྱ་ཾགདོང་མ་ཞེས་བྱ་བ་དང་།",
    "དགའ་བའི་བུ་མོ་ཁྭ་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "གཞན་ཡང་ཤིན་ཏུ་གུས་པའི་བུ་མོའི་འཁོར་འདི་ལྟ་སྟེ།",
    "ཤིན་ཏུ་གུས་པའི་བུ་མོ་རྟ་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གུས་པའི་བུ་མོ་ཕག་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གུས་པའི་བུ་མོ་སྤྲེའུ་གདོང་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གུས་པའི་བུ་མོ་ཐལ་བྱེད་མ་ལ་སོགས་པ་ཤིན་ཏུ་གུས་པའི་བུ་མོའི་འཁོར་དང་།",
    "ཤིན་ཏུ་གསོད་པ་ཆེན་པོ་དཔལ་སྟག་གི་མགྲིན་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་པ་ཆེན་པོ་དཔལ་གཡག་གི་མགྲིན་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་པ་ཆེན་པོ་དཔལ་གཟིག་གི་མགྲིན་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་པ་ཆེན་པོ་དཔལ་ཕག་གི་མགྲིན་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་པ་ཆེན་པོ་དཔལ་དྲེད་མོའི་མགྲིན་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་གསོད་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་དུར་ཁྲོད་ཅེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་ག་ཏུན་ཁུང་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་གཏུམ་མོ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་མདའ་སྙེམས་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་སྒྲ་འབྱིན་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་འདྲེན་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོ་རྡོ་རྗེ་སྤོར་མ་ཞེས་བྱ་བ་དང་།",
    "ཤིན་ཏུ་གསོད་མ་ཆེན་མོའི་འཁོར་རབ་ཏུ་མང་པོ་རྣམས་དང་།",
    "ཡུམ་རྡོ་རྗེ་ཀུན་དུ་བཟང་མོ་ས་ང་ཤོ་རི་ཀས་ཀྱང་ཉིད་ཀྱི་སྐུ་ལ་རྣམ་པར་འཁྲིལ་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་དེས་དབྱིངས་ཀྱི་ངང་ལ་མི་གཡོ་བར་བརྣལ་༤བཞིན་དུ་ཡུམ་རྡོ་རྗེ་ཀུན་དུ་བཟང་མོས་སྟོང་པ་ཉིད་ཀྱི་གླུ་འདི་བླངས་ཏེ་རྣམ་པར་བསྐུལ་ཏོ།",
    "དེ་ནས་ཡུམ་ས་ང་ཤོ་རི་ཀ་ལ་གཟིགས་ཏེ།",
    "མཛད་དེ་། དེ་ནས་ཡུམ་ཀུན་དུ་བཟང་མོ་དེས་སྤྱན་ཟིམ་བག་གིས་རྣམ་པར་འདུད་པའི་ཚུལ་དུ་བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་ལ་རྣམ་པར་བལྟས་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་སྐལ་བཟང་དཔལ་ཁྱོད་བདག།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་དེས་གླུ་དེས་བསྐུལ་བར་ཐུགས་སུ་ཆུད་ནསབདེ་བ་ཆེན་པོའི་ངང་དེ་ལས་ཆོ་འཕྲུལ་ཆེན་པོར་རྣམ་པར་བཞེངས་ཏེ།",
    "མེད་པ་ཐམས་ཅད་ལ་གསང་བ་མཆོག་གི་བདག་པོ་དེས་ཀུན་ལ་ཁྱབ་པར་མཛད་དེ་། དེ་དག་གི་རང་བཞིན་དུ་རྣམ་པར་གནས་སོ།",
    "དེ་ནས་རྡོ་རྗེ་ཀུན་དུ་བཟང་མོ་དེ་ངོ་མཚར་དུ་གྱུར་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་དེས་རྡོ་རྗེ་རོལ་པའི་དེ་ཁོ་ན་ཉིད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་ཅང་མི་གསུང་བར་བཞུགས་སོ།",
    "དེ་ནས་ཡུམ་རྡོ་རྗེ་ཀུན་དུ་བཟང་མོ་དང་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་དེས་རྡོ་རྗེ་རོལ་པ་དེ་ཁོ་ན་ཉིད་ཀྱི་གླུ་དེས་གསོལ་བ་བཏབ་པ་མཁྱེན་ནས་འཁོར་ཐམས་ཅད་ལ་རྣམ་པར་གཟིགས་ཏེ་འཛུམ་པ་མཛད་དོ།",
    "སྲིན་མོ་དང་།",
    "བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་དེས་ཞལ་གྱི་མདངས་ཕྱུང་སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གསང་བ་མཆོག་གི་བདག་པོ་དེས་༦ མི་གནས་པའི་ཡེ་ཤེས་ཆེན་པོའི་ཀློང་ནས་ངེས་པར་བཞེངས་ནས་སེངྒེ་རྣམ་པར་རྒྱལ་བའི་སྒྲ་ལྟ་བུས་དོན་གྱི་བཀོད་པ།",
    "པུ་ཏི་ཨ་ཧོ་ཀུ་ལ་མ་ཏོང་བྱིང་ཏ་པ་དྲ་ཨ་མོ་གྷ་ཨཱི་ཤྭ་ར་ས་ཡ་ན།",
    "རྣམ་པར་བཞུགས་ནས་དམ་ཚིག་ཆེན་པོ་རྡོ་རྗེ་སེམས་དཔའ་ལ་ཞལ་གཟིགས་ཏེ།",
    "དེ་ནས་དམ་ཚིག་ཆེན་པོ་རྡོ་རྗེ་སེམས་དཔའ་དེས་བསྐུལ་བར་རྣམ་པར་རིག་ནས་རང་གི་སྟན་༡༢ལས་ལངས་ནས།",
    "རང་གི་མཚན་མ་གནས་ལྔར་རེག་པར་བྱས་ནས་ལྕེ་པདྨའི་སྟེང་དུ་བཞག་ནས།",
