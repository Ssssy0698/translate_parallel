    "ཇི་ལྟར་ཐམས་ཅད་མཁྱེན་པས་མང་དུ་ཐོས་པ་རྣམས་ལས་དོན་རྙེད་དོ་ཞེས་གསུངས་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོར་དགོངས་པའི་བསྡུ་བའི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "ཡིད་ལ་བྱེད་པ་རྒྱུ་འདུས་པའི་མཐུ་ལས་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ཉེ་བར་སྐྱེའོ།",
    "ཚོགས་ཀྱི་རང་བཞིན་གྱི་བྱེ་རྣམ་པར་ཤེས་པ་དེ་ལྟ་བུར་ཡང་ཁང་པ་དང་།",
    "དེས་ན་ཡུལ་དང་ཡུལ་ཅན་གྱི་དངོས་པོ་དེ་ནི་སྣང་བའི་ཚོགས་ཏེ་དོན་དམ་པར་ནི་མེད་དོ།",
    "ནམ་ཤེས་རབ་ཀྱིས་དཔྱད་དེ་ཤེས་པར་བྱ་བ་སྦོམ་པོ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྒྲ་དང་དོན་གྱི་ཐ་སྙད་ཀྱང་སྤྱིའི་རྣམ་པར་འཇུག་གོ།",
    "དེ་བཞིན་དུ་གཡོ་བ་མེད་པའི་སར་ཏིང་ངེ་འཛིན་ལ་གནས་པ་ཐམས་ཅད་མཁྱེན་པ་རྣམས་ཀྱིས་དུསོ་སོར་སད་པར་བྱ་བ་དང་།",
    "བྲོ་གྲོས་ཆེན་པོ་མུ་སྟེགས་བྱེད་ཐམས་ཅད་ཀྱིས་རྣམ་པ་བརྒྱད་དུ་རྣམ་པར་བརྟགས་ཏེ་ངས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་མི་རྟག་པ་དང་འབྱེལ་ཏོ།",
    "དེ་ལ་བློ་གྲོས་ཆེན་པོ་ལ་ལ་ནི་རབ་ཏུ་རྩོམ་པ་ལས་རྣམ་པར་ལྡོག་པ་མི་རྟག་པ་ཉིད་ཅེས་ཟེར་ཏེ།",
    "བློ་གྲོས་ཆེན་པོ་རབ་ཏུ་རྩོམ་པ་ཞེས་བྱ་བ་ནི་སྐྱེ་བ་ཡིན་ཏེ་ཞེས་པ་ནི་མུ་སྟེགས་བྱེད་པ་རྣམས་ཀྱིས་རྟག་པ་རྣམས་ཀྱི་འབྲས་བུ་སྐྱེད་པར་རྩོམ་པ་སྟེ།",
    "བྱེད་དེ་དག་རིམ་གྱིས་དངོས་པོར་སྐྱེས་པ་རྣམས་ཀྱང་སྐྱེ་བ་མེད་པར་རྣམ་པར་རྟོག་གོ།",
    "བུམ་པ་ལ་སོགས་པའི་རྫས་དབྱིག་པ་་ལ་སོགས་པས་འཇིག་པར་བྱེད་པ་དེ་ལྟ་བུ་ནི་ཡན་ལག་ཅན་གྱི་རྫས་ཀྱི་དབྱེབས་ནི་འཇིག་པ་སྟེ།",
    "ཁྱད་པར་ཅན་གྱི་ལྟ་བ་ཐམས་ཅད་མཁྱེན་པས་སྤུདགོངས་པར་བརྟག་གོ།",
    "ཐམས་ཅད་མཁྱེན་པས་ཀྱང་དེ་བཞིན་དུ་དངོས་པོ་ཐམས་ཅད་ལ་མི་མཐོང་བ་གཞིག་པ་ནི་མི་རྟག་པའོ་ཞེས་གསུངས་སོ།",
    "ཁ་ཅིག་ནི་དངོས་པོའི་དངོས་པོ་མེད་པ་མི་རྟག་པར་རྟོག་གོ་ཞེས་པ་ནི་ཇི་ལྟར་ཀྵ་པ་ན་ཀ་དང་།",
    "རྟག་པར་འགྱུར་བ་དང་།",
    "མི་རྟག་པར་འགྱུར་བ་དང་།",
    "རྟག་པ་དང་མི་རྟག་པར་འགྱུར་བ་དང་།",
    "རྟག་པར་འགྱུར་བ་ཡང་སྨྲ་བར་མི་བྱ་བ་དང་།",
    "མི་རྟག་པར་འགྱུར་བ་ཡང་སྨྲ་བར་མི་བྱ་བ་དང་།",
    "མི་རྟག་པར་འགྱུར་བ་ཡང་སྨྲ་བར་མི་བྱ་བ་དང་།",
    "དཔྱོད་པྱཔ་ཅན་རྣམས་ཀྱི་དངོས་པོ་རྣམས་ནི་སྤྱི་དང་ཁྱད་པར་དུ་ཐ་དད་པ་དང་ཐ་དད་པ་མ་ཡིན་པ་སྟེ།",
    "ཉམས་ངྐུཆེ་བའི་ལྷ་སྦྱིན་ཡང་དེ་འདི་ཉིད་དོ།",
    "གཡོས་པ་མེད་པ་ལ་སོགས་པ་ཐ་དད་པའི་དུས་ཀྱི་མཚན་ཉིད་དང་ལྡན་པ་རྣམས་ལ་གཅིག་པར་མི་རིགས་ཏེ།",
    "དེས་ན་ཐོག་མ་དང་ཐ་མའི་རང་བཞིན་གྱི་ཐུཁྱད་པར་ཐ་དད་པར་ཕྱེ་ན་རིམ་པ་དང་།",
    "ཡུལ་དང་དུས་ཐ་དད་པར་ཕྱེ་བའི་ཁྱད་པར་གྱིས་སྐྱེ་བ་དེ་དག་རང་བཞིན་གྱི་ཁྱད་པར་གྱིས་སྐད་ཅིག་པ་ཐོབ་པར་ཡིད་ཆེས་སོ།",
    "བསྒྲིབས་པ་དང་མ་བསྒྲིབས་པ་ལ་སོགས་པར་ཕྱེ་བ་དང་།",
    "དེ་དེ་ལྟར་ན་མུ་སྟེགས་བྱེད་ཐམས་ཅད་ཀྱི་མི་རྟག་པ་ཉིད་ནི་སྐད་ཅིག་མར་འཇིག་པ་མ་གཏོག་པར་རྫས་དང་ཡོན་ཏན་དང་ལས་དང་སྤྱི་དང་ཁྱད་པར་ལ་སོགས་པ་རྣམས་ཀྱི་ནི་མི་རུང་སྟེ།",
    "དངོས་པོ་གཞན་སྐྱེ་བ་ན་སྔ་མའི་དངོས་པོ་ཅིའི་ཕྱིར་ན་རྣམ་པར་འཇིག་པར་འགྱུར།",
    "འོན་ཏེ་རང་ཉིད་མི་ལྡོག་ན་གནས་པ་ཅན་ནི་ཐུསུས་ཀྱང་རྣམ་པར་གཞིག་པར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་མེད་པ་བྱེད་པས་ན་བྱེད་པ་ཉིད་དག་པར་བྱས་པར་གྱུར་པར་རྟོགས་སོ།",
    "སྤྱི་དང་ཁྱད་པར་དང་།",
    "ཡོངས་སུ་གྲུབ་པ་གཉིས་ཀྱི་རྣམ་པ་དང་བྲལ་བའི་ཆུད་པ་དེར་ཡང་སྐད་ཅིག་མའི་རྒྱུན་ཡང་དག་པར་རིག་པ་སྟེ།",
    "འགོག་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་དེར་མི་འབྱུང་ངོ།",
    "དོན་དམ་པའི་བདེན་པ་གཉིས་སུ་མེད་པ་ཡང་དག་པར་རིག་པ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པར་རྣམ་པར་མི་རྟོག་པ་ཉིད་གནས་སོ།",
    "སྐད་ཅིག་པ་གཞན་དུ་གསེར་ལ་སོགས་པ་བཞིན་དུ་མཚམས་སྦྱོར་བར་བྱེད་པ་ཉིད་དེ་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ལག་མཐིལ་གྱི་སྒྲ་ལ་སོགས་པ་ལྟ་བུར་ནི་མ་ཡིན་ནོ།",
    "སྤྱི་དང་ཁྱད་པར་དུ་བརྟགས་ན་དེ་རྗོབཞིན་ནོ།",
    "མཚན་ལ་མཚན་ཉིད་མེད་པར་འགྱུར།",
    "ཅིའི་སླད་དུ་ཞེས་པ་དང་ཐམས་ཅད་མཁྱེན་པས་རྒྱུ་གཞན་གསུངས་པ།",
    "སྙོམས་པར་འཇུག་པ་ལས་ལྡང་བའི་དུས་ན་ཕྱི་རོལ་གྱི་མཚན་མ་འཛིན་པའི་ཕྱིར་རོ།",
    "ཅིས་ན་དུས་ཐམས་ཅད་དུ་སྣང་བ་མེད་པ་ཉིད་དུ་སྟོམས་པར་མི་འཇུག་ཅེས་དེ་སྐད་དུ་ཐུགས་དོགས་ནས་བཀའ་པ་པ།",
    "སྣ་ཚོགས་ཀྱི་མཚན་ཉིད་མེད་པར་ཐོབ་པར་འགྱུར་ཞེས་པ་ནི་སྣང་བ་མེད་པའི་ཏིང་ངེ་འཛིན་ཏེ།",
