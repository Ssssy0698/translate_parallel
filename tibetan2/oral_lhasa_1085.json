    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཉེས་པར་བྱེད་པའི་ཡེ་ཤེས་ནི་རྡོ་རྗེ་ཆགས་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་ངེས་པའོ།",
    "རྗེས་སུ་མཉེས་པར་བྱ་བ་དང་།",
    "ལེགས་སོ་ཞེས་བྱ་བའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་པ་ཉིད་དོ།",
    "དེའི་ཤུགས་ནི་ལྷུན་གྱིས་གྲུབ་པར་འཇུག་པའོ།",
    "ཇྀ་༤ད་བཛྲ་ཀོ་ཥ་ཞེས་བྱ་བའི་སྔགས་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་མི་རྟོག་པའོ།",
    "ཐུབ་པར་དཀའ་བའི་བརྩོན་འགྲུས་ནི།",
    "དེ་རྣམ་པར་ལྐུའཇོམས་པར་མཛད་པས་ན་བདུད་ཐམས་ཅད་ཀྱི་དཀྱིལ་འཁོར་འཇོམས་པ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ལས་ཀྱི་ཏྲེཏིང་ངེ་འཛིན་ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཕྲིན་ཛྭལས་ལ་སོ་སོར་རྟོག་པའི་ནན་ཏན་ཉམས་སུ་ལེན་པའི་བརྩོན་འགྲུས་ཀྱི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་པའོ།",
    "དེ་རྣམས་རྣམ་པ་གཅིག་ཏུ་གྱུར་པ་ལས་བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔར་བསྐྱེད་པར་གྱུར་ཏོ།",
    "དེ་མངོན་སུམ་དུ་མཛད་ནས་བཞུགས་པའོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རྡོ་རྗེ་འབེེབས་པའི་བར་གྱི་ཚུལ་གྱིས་ཀྱང་བཞུགས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "སྔགས་ལྔས་བརྟན་པར་བྱས་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་ང་རྒྱལ་དང་ལྡན་པ་དང་།",
    "དེ་ཐམས་ཅད་ནམ་མཁའི་ཁམས་ཀྱི་ཚད་ཙམ་གྱེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེ་རྩེ་གཅིག་ཏུ་བདག་ཉིད་བསྐྱེད་ལ་གནས་པར་བྱའོ།",
    "དེ་རྣམས་གཅིག་ཏུ་གྱུར་ནས་བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔར་སྤྲུལ་ལ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཚུལ་གྱིས་གཞག་པར་བྱ་བ་ནི།",
    "གསུངས་པའི་རྣལ་འབྱོར་དང་དེ་བཞིན་དུ་རྣལ་འབྱོར་ཆེན་པོ་བྱ་བ་ནས།",
    "དེ་ཉིད་བསྟན་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བའི་སྒྲ་ནི་གནས་སྐབས་ཏེ་འདི་བརྩམ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་པ་ལེགས་པར་བྲི་ལ།་",
    "དེ་རྣམས་སུ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཡང་དག་པར་བྲི་བར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དུ་བཞུགས་པ་དང་།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་བཅས་ལ་མཉམ་པར་གཞག་པའི་ཚུལ་གྱི་སྤྱོད་ལམ་གྱེས་གཞུག་༨པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དཀྱིལ་འཁོར་རྣམས་སུ་འདུས་པར་གྱུར།",
    "ཅུང་ཟད་རབ་ཏུ་བརྗོད་པར་བགྱི།",
    "དེ་བཞིན་གཤེགས་རྣམས་བརྟན་པར་གྱུར།",
    "ཨོཾ་བཛྲ་རཀྵ་ཧཾ་༤ཞེས་བྱ་བས་རྡོ་རྗེ་བསྲུང་བའི་ལས་ཀྱི་ཕྱག་རྒྱ་བསྲུང་བ་ཐམས་ཅད་ཡང་དག་པར་བསྲུངས་ནས།",
    "སྔ་མ་བཞིན་དུ་རྗེས་སུ་གནང་བ་ནོད་པར་བྱ་སྟེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའོ།",
    "དེའི་ཡེ་ཤེས་བསླབ་བོ་ཞེས་བྱ་བ་ནི་བསྟན་པར་བྱའོ།",
    "སེམས་ནི་མཉམ་པར་གཞག་པར་འགྱུར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སེམས་མཉམ་པར་གཞག་ཅིང་རྩེ་གསྦུག་པར་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སེམས་དེས་ཀུན་དུ་ཁྱབ་པར་བྱ།",
    "ཞེས་བྱ་བ་སྟེ་ཁྱབ་པར་བྱ་ཞེས་བྱ་བ་ནི་རྒྱ་ཆེར་བྱ་བའོ།",
    "སེམས་དེ་ཀུན་དུ་ཁྱབ་པར་བྱ་ཞེས་བྱ་བའོ།",
    "ཇི་ཙམ་འདོད་པར་ཁྱབ་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ཇི་ཙམ་འདོད་པར་སྤྲོ་བ་ནི་ཇི་ཙམ་འདོད་པར་ཁྱབ་པའོ།",
    "སེམས་དེ་ཁམས་གསུམ་དུ་ཡང་ཁྱབ་པར་བྱ་ཞེས་བྱའོ་༤།་།",
    "དེ་ནས་གྲོང་ལ་སོགས་པར་རོ།",
    "དེ་ནས་བརྩམས་ཏེ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ནས་བརྩམས་ཏེ་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་གང་ཅི་ཡང་རུང་བ་ཤིན་ཏུ་མཉམ་པར་གཞག་ཅིང་རྩེ་གཅིག་པས་བསྒོམས་པའི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་དེ་ཀུན་ཏེ།",
    "དེ་དག་ཐམས་ཅད་བརྟན་པ་ཉིད་དུ་བྱེད་པར་འགྱུར་ཏེ།",
    "མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་རོ།",
    "ཉིད་ཀྱི་སྒྲ་ནི་ངེས་པར་གཟུང་བ་༢དང་ཐ་དད་པའི་རིམ་པ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།་",
    "བརྟན་པར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "བརྟན་པར་བྱ་བ་རྣམས་ཀྱིའོ།་།",
    "ལྕེ་རྐན་ལ་སྦྱར་བར་བྱས་ནས།",
    "བཛྲ་དྲྀ་བྷཱ་ཏིཥྛ་ཞེས་བྱ་བས་གཞུག་པར་བྱའོ།",
    "ངེས་པར་མཚན་མ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ནས་མཚན་མ་ཐོབ་ཅིང་བརྟན་པར་གྱུར་༤ནས།",
    "བསྒོམས་༦པས་དུབ་པར་འགྱུར་ན་སཾ་ཧ་ར་ཎ་བཛྲ་ཞེས་བྱ་བས་དེ་རྣམས་བསྡུས་ལ།",
    "ཆེན་པོའི་དབྱེ་བས་གསུམ་གསུམ་དུ་བྱས་ནས།",
    "དེས་བྱམས་པ་ཐོབ་པར་གྱུར་པ་ཡིན་ནོ།",
    "དེ་ནས་དེའི་རྗེས་ལ་ཇི་སྐད་དུ་གསུངས་པ་བཞིན་དུ་ཁྱབ་ཅིང་སྤྲོ་བར་བྱའོ།",
    "དེའི་སྡུག་བསྔལ་གྱིས་གཟིར་ཞིང་དེ་ལས་གདོན་པར་འདོད་པས།",
    "བསྒྲུབ་པ་ཡིས་ནི་ཁྱབ་པར་བྱ།",
    "གཞན་དུ་ན་༢ཅི་ནུས་པར་སྡུག་བསྔལ་བསལ་བ་ལ་འབད་པར་བྱའོ་ཞེས་པའོ།",
    "ནམ་མཁའ་བཞིན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
