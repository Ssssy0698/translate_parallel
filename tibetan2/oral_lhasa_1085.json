    "བདུད་ཀྱི་ཚུལ་གྱིས་མཉེས་པར་བྱེད།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་ཆོ་གས་རྡོ་རྗེ་ཆགས་པའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེའི་འོག་ཏུ་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རྡོ་རྗེ་ཆགས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "ཞེས་བྱས་ལ།",
    "རྡོ་རྗེ་གོ་ཆས་ཡན་ལག་ཐམས་ཅད་གོ་བསྐོན་པར་བསམ་པར་བྱའོ།",
    "རྡོ་རྗེ་གོ་ཆའི་སྤྱོར་བ་འདིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱང་མི་ཕྱེད་པར་གལ་ཏེ་གནོད་པར་བྱེད་པ་རྩོམ་པ་ན་དེ་ཡང་བསྲུང་བར་འགྱུར་ན་ག།",
    "རྣལ་འབྱོར་པ་གནོད་པའི་ཁྱད་པར་ཆེན་པོ་ལས་སྲུང་ནུས་པར་སྟོན་ཏོ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རྡོ་རྗེ་ལེགས་པའི་སྤྱོར་བ་བྱས་ནས།",
    "ཕྱིས་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རྡོ་རྗེ་ལེགས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཇི་སྲིད་སྒྲུབ་པ་པོའི་ལུས་སུ་ཞུགས་ཏེ་གཅིག་ཏུ་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རྡོ་རྗེ་ལེགས་པ་ཉིད་དུ་འགྱུར་ཞིང་ལེགས་པ་མ་ཡིན་པའི་ཚུལ་གྱིས་རྣམ་པར་རྟོག་པ་རྣམས་ལས་བདག་ཉིད་བསྲུང་བ་༧བྱས་པར་འགྱུར་རོ།",
    "གཞན་སྲུང་བར་བྱེད་པར་འདོད་ན་ཟླ་བ་གཅིག་ཙམ་བསྙེན་པ་བྱས་ལ་མཐར་མཚན་ཐོག་ཐག་བཟླས་པ་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྟ་ཏྲེབ་འདི་ལ་སྒེག་པའི་ཉམས་ཐམས་ཅད་སྦྱར་བར་བྱའོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་༩གསུངས་སོ།",
    "རིངས་པར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟ་བུའི་ཁྲོ་བོའི་ལྟ་བ་བྱས་ཤིང་མཉམ་པར་བཞག་ན་ནི།",
    "ཁམས་གསུམ་ཡང་ནི་འཇིགས་ཧཱུཾཔར་བྱེད།",
    "ཁྲོ་བོའི་ཉམས་ཐམས་ཅད་ཀྱིས་ཁྲོ་བོའི་ལྟ་བ་༧་བསྐྱེད་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་བསྲུང་བ་ལ་སོགས་པའི་ལས་འཇུག་པར་བྱའོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་མཚན་ཉིད་ཅན་གྱི་རྡོ་རྗེ་ལྟ་སབ།",
    "དཱིཔྟ་དྲྀཥྚི་སཾ་༩གུ་ཤ་ཛ་ཞེས་ཟློས་ཤིང་བསྒོམ་ཚོསྣཔར་བྱའོ།",
    "ཡི་གེ་མ་ལས་མིག་གཡས་པར་ཉི་མའི་དཀྱིལ་འཁོར་ཞི་བ།",
    "དེ་ནས་ཚ་བའི་རིམས་ལ་ཟླ་བ་རྡོ་རྗེ་ལྟ་བུའི་འོད་ཟེར་རྣམས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ལ་བལྟས་ལ་བྱབ་ཅིང་ཚ་བ་བསལ་བར་བྱའོ།",
    "གདོན་གྱིས་ཟིན་པ་ལ་ནི་འབར་བའི་ལྟ་༧བའི་འོད་ཟེར་རྣམས་ཀྱིས་གཞོམ་པར་བྱའོ།",
    "དེ་ནས་དེ་བཞིན་དུ་ལས་ཀྱི་དུས་སུ་ཡང་ལྷའི་རྣལ་འབྱོར་བྱས་ལ་བསྒྲུབ་པར་ཊྭཱབྱ་བ་དང་ལྷན་ཅིག་༢ཟླ་བའི་དཀྱིལ་འཁོར་གཅིག་ཉིད་ལ་གནས་པར་རྔུབློས་བསམས་ལ།",
    "ཕྱིས་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "རྡོ་རྗེ་བེེགས་ཀྱུའི་གཟུགས་གཡས་སུ་བསྐྱེད་པར་བྱའོ།",
    "ཡི་གེ་ཧཱུཾ་བཞི་རང་དང་གཞན་གྱི་རྣ་བའི་རྣམ་པར་ཤེས་པས་གཟུང་དུ་རུང་བའི་སྒྲའི་ཚིག་ཏུ་བརྗོད་པ་གསལ་བར་བརྗོད་ཅིང་བསྒྲུབ་པར་བྱ་བའི་ལུས་འཇིག་༡།",
    "རྣམ་པར་གཏོར་བར་འགྱུར་བར་བསམ་ཞིང་།",
    "ཡི་གེ་ཧཱུཾ་བཞིའི་རྡོ་རྗེའི་གོ་ཆས་བདག་ཉིད་གོ་བགོས་པར་༤་བསམ་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ལྕགས་ཀྱུ་ལ་སོགས་པས་དགུག་པ་དང་།",
    "དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་ཚུལ་གྱིས་རྡོ་རྗེ་སེམས་དཔའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེའི་འོག་ཏུ་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ཏེ།",
    "སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་རིན་ཆེན་གྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "བསད་ན་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "རྡོ་རྗེ་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རྡོ་རྗེ་ལས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "ཡང་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རྡོ་རྗེ་ལས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ཏེ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "རྡོ་རྗེ་དབྱེངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རྡོ་རྗེ་སེམས་དཔའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེའི་འོག་ཏུ་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་སེམས་དཔའ་རྡོ་རྗེ་མ་བཅིངས་ཏེ།",
    "དེ་ལྟར་སེམས་དཔའི་རྡོ་རྗེ་མཉམ་པར་བཞག་ལ་༥།",
    "ངེས་པར་འབབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་རིན་ཆེན་གྱི་རྣལ་འབྱོར་གྱིས་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རྡོ་རྗེ་རིན་ཆེན་མ་བཅིངས་ལ་རིན་ཆེན་རྡོ་རྗེ་བསྒྲུབ་པར་བྱའོ།",
    "ལས་ཀྱི་རྡོ་རྗེའི་རྣལ་འབྱོར་གྱིས་གཟུངས་ཀྱི་༩དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རྡོ་རྗེ་ལས་མ་བཅིངས་ལ།",
    "ལས་ཀྱི་རྡོ་རྗེ་བསྒྲུབ་པར་བྱའོ།",
    "དེས་དེའི་ལུས་སྣཉི་མ་ནུབ་པ་ལྟ་བུར་བྱ་བས་དགུག་པར་བྱའོ།",
    "བྱམས་པའི་ལྟ་བས་ལྟ་༥ཞིང་བསྒྲུབ་པར་བྱ་བ་དེའི་ནང་དུ་ཆུད་པར་བསམས་ན།",
    "ཡང་དག་པར་བསྲུང་བར་༦འགྱུར་རོ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དང་གཞན་དག་ཏུ་༩་ཡང་ལྷ་རྣམས་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དུ་གསུངས་པའི་ཕྱག་རྒྱ་བཞིས་རྒྱས་བཏབ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ་ཞེས་སྟོན་ཏོ།",
