    "བ་ལང་གི་མིང་ཤེས་ཀྱང་མཚོན་བྱ་དང་མཚན་གཞི་སོ་སོར་མི་ཤེས་པས་དེ་གཉིས་ཀྱི་འབྲེལ་བའང་མི་ཤེས་པའི་རྨོངས་པ༵་ལ་ནི་ནོག་ལྐོག་ཤལ་ཅན་འདི་ལ་བ་ལང་ཞེས་འདོགས་སོ་ཞེས་བརྡ་དྲན་པར་བྱེད་པའི་གཞི་དེ་ལ་ཐ་སྙད་སྒྲུབ་ཀྱི་རྗེས་དཔག་གི་རྟགས་འགོད་དགོས་སོ།",
    "སྤྱིར་བཏང་གི་དབྱེ་བ་དང་།",
    "མཚན་གཞི་དཀར་ཟལ་དང་མཚོན་བྱ་བ་ལང་གི་ཐ་སྙད་གཉིས་ལ་ཁེགས་ན་ནི།",
    "དང་པོ་མཚོན་བྱ་ལ་བརྟགས་ན་འགལ་བ་དང་མཚན་ཉིད་སོགས་ལ་ཐ་སྙད་ཐམས་ཅད་ཁེགས་པ་དང་དངོས་པོ་འགལ་བ་གཉིས་གཅིག་མཚན་གཞི་དང་གཅིག་མཚོན་བྱར་ཐལ་བའི་རྩོད་རིགས་གཏེར་མཆན་འགྲེལ།",
    "ཁ་ཅིག་གིས་མཚན་མཚོན་དོན་ལ་ངོ་བོ་གཅིག་པ་དང་།",
    "ཉན་ཐོས་པ་རྣམས་མཚན་ཉིད་སྐྱེས་སོགས་དང་འདུས་བྱས་གཉིས་ཐ་དད་དུ་འདོད་པ་དང་ཡང་ལ་ལས་དེ་གཉིས་གྲངས་མི་མཉམ་པ་དཔེར་ན་ས་བོན་གཅིག་གིས་འབྲས་བུ་དུ་མ་སྐྱེད་པ་དང་།",
    "བསྒྲུབ་བྱ་གཅིག་ལ་རྟགས་དུ་མ་རུང་བ་ལྟར་མཚན་ཉིད་གཅིག་གིས་མཚོན་བྱ་དུ་མ་དང་།",
    "གསུམ་པ་དེ་དག་གི་མིང་དོན་ཕན་ཚུན་བཟློག་པ་ཡི་ཞེ་འདོད་ཀྱིས་རྣམ་པར་གཞག་པས་འདིར་མི་གནོད་དོ།",
    "ལུགས་དང་པོ་དེ་མི་འཐད་དེ་མཚན་ཉིད་སོ་སོ་བ་ཡིན་པ་གཉིས་ཀྱིས་འཇོག་ན་ནི་རྣམ་འཇོག་གི་རྒྱུ་ཐ་དད་པས་མཚོན་བྱ་དེ་ཡང་གཉིས་སུའགྱུར་དགོས་ལ།",
    "དེས་ན་རང་ལུགས་ནི་རང་གིས་གཞལ་བྱ་རྟོགས་པ་ལ་མི་བསླུ་བ་དང་མ་ཤེས་དོན་གྱི་གསལ་བྱེད་གཉིས་པོ་གང་ཡིན་ཀྱང་རང་མཚན་རྟོགས་པ༵ར་དོན་ལ་མཐུན་ཏེ་ཁྱད་མེད་པས་མཚན་ཉིད་གཅིག་གི་རྣམ་གྲངས་ཡིན་ནོ།",
    "བ་ད༵ང་བྱེད༵་པོ་གང་གིས་མི་བསླུ་བ་དང་བྱ་བ་ཇི་ལྟར་མི་བསླུ་བ་གསུམ་གྱི་བདག་ཉིད་ཅན་ཡིན་ནོ།",
    "རྟོག་པ༵་ལོག་ཤེས་དང་ཐེ་ཚོམ་མོ་ཞེས་རྟོག་མེད་ལོག་ཤེས་ནི་མིན་ཏེ་ཟླ་བ་གཉིས་སྣང་དང་དེ་མིན་གྱི་ངེས་པ་མཉམ་དུ་སྲིད་པས་སོ།",
    "གཉིས་པ་རྗེས་དཔག་ནི་རྟོག་མེད་ཀྱི་སྒོ་ནས་སྣང་བས་མི་འཇུག་པས་སྣང་སྒྲུབ་ལྟ་བུའི་སྒྲུབ་པ་ཆིག་རྐྱང་ནི་མེད་ལརྗེས་དཔག་དེ་ནི་སེལ་བ་ཉིད་ཡིན་རྗེས་དཔག་དེའི་བསལ་བྱའི་ཡུལ་ནི་རྗེས་དཔག་དེ་མེད་པའི་སྔ་རོལ་དུ་ཤེས་པ་གང་གིས་གཞི་དེ་ཉིད་མེ་མེད་པའི་གནས་གཞན་དང་མཚུངས་པ༵་རུ་འཛིན་པ་ཡིན་ཕྱིར་ལོག་ཤེས་ཡོད་པ་ཡིན་པར་བཞེད་དོ།",
    "ངེས་དང་སྒྲོ་འདོགས་པ་གཉིས་པོ་ཞེན་ཡུལ་གཅིག་སྟེ་གཉིས་ཀས་རང་ངོའི་སེལ་བ་དེ་རང་མཚན་ལ་འཁྲུལ་བས་ཞེན་ཡུལ་རང་མཚན་ཁོ་ན་ཡིན་མོད་འོན་ཀྱང་ཞེན་པའི་འཛིན་སྟངས་དོན་མཐུན་དོན་མི་མཐུན་ཐ་དད་ཕྱིར་ན་བསལ་བྱ་སེལ་བར་འཐད་དོ།",
    "བོད་རྣམས་ན་རེ།",
    "གཅིག་པ་བཀག་པའམ་ལྡོག་པ་ཐ་དད་གང་ཡིན་ཞེས་བརྟག་ན་ཁ་ཅིག་རྗེས་དཔག་གི་ཡུལ་མེད་པས་དངོས་མེད་ཡིན་པས་གཅིག་པ་བཀག་པའི་ཐ་དད་དུ་འདོད་དོ་ཞེས་ཟེར།",
    "ཡུལ་ལ་ལྟོས་ནས་མངོན་ལྐོག་གིས་ཐ་དད་པ་ཡིན་ནོ།",
    "ཡང་སྐམ་སྐྱེས་ཀྱི་པདྨ་ལ་མཚོ་སྐྱེས་ཞེས་རེས་འགའ་འགལ་༣ཞིང་།",
    "ཁ་ཅིག་གིས་ནོར་བུའི་འོད་ལ་ནོར་བུར་འཛིན་པ་ལྟ་བུ་ཡུལ།",
    "ནམ་གུང་གི་བུ་ཚ་ལ་ཉིན་ཕྱེད་དུ་འཁྲུལ་བའི་རྨི་ལམ་ལྟ་བུ་དུས།",
    "དུས་སྔ་དྲོའི་སྲོག་ཆགས་ལ་ཕྱི་དྲོའི་སྲོག་ཆགས་སུ་རྟོག་པ་སོགས་དང་རྣམ་པ༵་ལ་འཁྲུལ་བ་སྒོ་རྒྱབ་ཀྱི་བུམ་པ་ལ་ཁང་ཕུག་གི་བུམ་པར་རྟོག་པ་ལྟ་བུ་རྣམས་འཁྲུལ་བ་ཡིན་པས་དེ་རྣམས་སྣང་བ་འཛིན་པའི་ཤེས་པ་དེ་དག་ཀྱང་མངོན་སུམ་ཡིན་པ་འགོག་ཅེས་ཟེར།",
    "འགའ་ཞིག་གིས་གཞན་ཁོ་ན་ལས་ངེས་ཞེས་ཟེར།",
    "མངོན་སུམ་གོམས་པ་ཅན་དེ་དོན་རིག་གཉིས་དང་རང་རིག་དང་རྟགས་ལས་རྗེས་སུ་དཔག་པ༵་བཞི་ནི་རང་གིས་འཇུག་ཡུལ་ལ་མི་བསླུ་བ་ཡིན་པར་རང་སྟོབས་ལས་ངེས་ནུས་པ་ཡིན་ནོ།",
    "དེ་དག་གིས་ནི་མངོན་སུམ་རྟོག་མེད་དང་།",
    "བྱེ་བྲག་གི་འདོད་ཚུལ་གཉིས།",
    "ཏིང་འཛིན་ལ་བརྟེན་པ་རྣལ་མངོན་དང་གང་ཟག་གི་སྒོ་ནས་དབྱེ་ན་སོ་སྐྱེས་མངོན་སུམ་དང་འཕགས་པའི་མངོན་སུམ་གཉིས་ཏེ་དེ་ལྟར་མངོན་སུམ་རྣམ་པར་དབྱེ།",
    "སྐྱེས་བུས་ཤིང་བཅད་ཀྱང་སྟ་རེས་བཅད་ཅེས་པ་དང་འདྲ་ལ།",
    "ཤེས་པ་རང་གི་ངོ་བོ་ལ་མ་འཁྲུལ་བའི་རིག་པ༵་ནི་རང་རིག་མངོན་སུམ་གྱི་མཚན་ཉིད་ཡིན་པར་མཁས་རྣམས་བཞེད་དོ།",
    "ཁ་ཅིག་རང་གིས་རང་རིག་ན་རང་ལས་རང་སྐྱེ་བར་ཡང་ཐལ་ཞེ་ན།",
    "རང་རིག་ནི་རིག་བྱ་རིག་བྱེད་དུ་ཕྱེ་ནས་རང་རིག་པ་མིན་གྱི་རང་གི་ངོ་བོ་བེམས་པོ་ལས་བཟློག་ཙམ་གྱི་མྱོང་བ་གསལ་རིག་གི་ངོ་བོར་སྐྱེས་པ་ལ་རང་རིག་ཅེས་ཐ་སྙད་བཏགས་པ་ཡིན་པ་དེས་ན་རང་རིག་རང་སྐྱེ་གཉིས་མཚུངས་པའི་གོ་སྐབས་ཡོད་མ་ཡིན།",
    "དེས་ན་ཐབས་ལ་ལྟོས་པའི་འབྲས་བུ་ཡང་གང་ཟག་གི་བདག་མེད་ཙམ་གཙོ་བོར་བྱས་ནས་ཐབས་སྣ་ཚོགས་ལ་གོམས་པ་ཞུན་པ༵ས་ན༵་ཉན་རང་གི་རྣམ་གྲོལ་གཉིས་ནི།",
    "སེམས་སྔ་ཕྱི་ཐུག་མེད་རང་རིག་གིས་མི་འགྲུབ་སྟེ་ད་ལྟ་རྒྱུ་འབྲས་ཡོད་ཀྱང་སེམས་མི་མཐུན་ཕྱོགས་གཞན་ལས་སྐྱེ་བར་མི་ཁེག་པ་དང་།",
    "ནང་གི་སྐེ་མཆེད་དྲུག་པོ་འདི་ལས་ཕྱི་མའི་སྐྱེ་མཆེད་གཞན་གྲུབ་སྟེ།",
    "ཕྱོགས་རེ་མགོ་ནོན་དང་།",
