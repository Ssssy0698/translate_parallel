    "བློའི་སྟེང་ན་སྔོན་པོར་སྣང་བ་དང་སྔོ་འཛིན་གཉིས་མེད་ན་སྔོན་པོ་དྲན་པ་དང་སྔོ་འཛིན་དྲན་པ་ལ་ཁྱད་མེད་པར་འགྱུར་ནའང་དེ་མིན་ཏེ་གཟུང་རྣམ་རེ་རེས་ལྷག་པའི་ཁྱད་ཡོད་པས་སོ།",
    "དེ་ལ་རྩོད་སྒྲུབ་ལས་གང་གི་སྒོ་ནས་ཐ་སྙད་འདོགས་པའི་ཕྱིར་དོན་དེ་ཁོ་ན་ལས་དངོས་སུ་སྐྱེས་པའི་རྣམ་པར་ཤེས་པ་ནི།",
    "ཤེས་པའང་དེར་ཐལ་དེའི་ཕྱིར་ཏེ་དེ་ལ་རང་ཡུལ་དེ་ལས་གཞན་ལ་དམིགས་ཡུལ་དུ་བྱས་པ་ལ་ལྟོས་པ་མ་ཡིན་པས་སོ།",
    "དོན་དེ་ལས་སྐྱེས་པའི་ཤེས་པ་མངོན་སུམ་མོ་ཞེས་པ་ལ།",
    "ཐ་སྙད་ཀྱིས་བརྗོད་བྱ་མ་ཡིན་པས་ཡུལ་གྱི་སྒོ་ནས་བསྟན་བྱའི་དོན་རེག་པས་ན་ཐ་སྙད་ཀྱི་ཡུལ་དུ་གྱུར་པ་འདི་ཡང་།",
    "རིགས་པ་ཅན་པ༵་རྣམས་ནི་མིག་སོགས་དབ༵ང་པོ་དང་གཟུགས་སོགས་དོན་སྦྱོར་ཞིང་ཕྲད་པ༵་ལས་སྐྱེས་པའི་ཤེས་པ༵་རྟགས་དང་ངོ་བོས་བསྟན་མི་ནུས་པས་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ༵་འཁྲུལ་པ་མེད་པ་འདིའོ་ཞེས་ཞེན་པ༵འི་བདག་ཉིད་ཅན་ནི་མངོན་སུམ་མོ་ཞེས་ཟེར་རོ།",
    "ཡང་ན་གལ་ཏེ་དེ་འཇལ་བྱེད་དབ༵ང་པོ་གཞན་ཞིག་ཡོད་དགོས་པར་ཐལ་ལོ།",
    "གཞན་ཡང་ཚད་འབྲས་ཐ་དད་དུ་བཞག་པ་དེ་མི་འཐད་པར་ཐལ།",
    "ཡོད་པ་སོགས་སྤྱི་དང་ཁྱད་པར་ལ་ལྟོས་པ་དང་བུམ་སོགས་རྫས་དང་སྔོ་སོགས་ཡོན་ཏན་དང་འགྲོ་སོགས་ལས་ལ་ལྟོས་ནས་འདིའོ་ཞེས་བཟུང་བ་ནི་མངོན་སུམ་མོ་ཞེས་བརྗོད་པར་མི་བྱ་སྟེ།",
    "རྫས་རྟེན་གཞན་ལ་རྟེན་པར་མི་འདོད་པ་ལའང་རྟེན་པར་ཐལ་བ༵ར་འགྱུར་ཏེ་སྔོ་སོགས་རྫས་ལྡན་དུ་རྟོག་པས་སོ།",
    "གཞན་ཡང་ཡུལ་སྒྲ་ལྟ་བུ་གཅིག་ལ་ཡང་དབྱིབས་དུ་མ་ཡོད་ཀུན་བཏུས་མཆན་འགྲེལཔར་ཐལ་ལོ།",
    "གཙོ་བོ་དེར་རྡུལ་ཕྲན་སོ་སོར་ཡོད་པས་གྲངས་མེད་ཐུག་མེད་དུ་ཐལ་ལོ་བདེ་སོགས་རབ་ཏུ་སྦྱོར་བའི་བྱེ་བྲག་གམ་ཁྱད་པར་ལས།",
    "རང་བཞིན་དང་རྣམ་འགྱུར་གི་ཚུལ་གཉིས་སུ་ཤེས་པར་མི་འདོད་ན།",
    "དེས་ན་འབྲས་བུ་སྒྲ་སོགས་གཅིག་གི་ངོ་བོར་འགྱུར།",
    "དེ་ཕྱིར་རྣམ་འགྱུར་རེ་རེའི་དངོས་པོ་ལ།",
    "ཡོན་ཏན་གསུམ་སོགས་འདོད་པ་འདིའི་གྲངས་ཅན་སྔ་མའི་ལུགས་ལས་ཁྱད་པར་འཕགས་མོད་ད་རུང་གཞི་སྐྱོན་བཅས་སོ།",
    "འགྲེལ་བྱེད་ཁ་ཅིག་ན་རེ།",
    "གླང་ཉིད་དེ་བ་ལང་གི་རིགས་སོགས་རིགས་ལྡན་དང་སྦྱོར་བ་ལས་ནི་དོན་དེ།",
    "དོན་རང་གི་མཚན་ཉིད་ནི་ཚིག་ལས་བསྟན་བྱ་མིན་ཏེ།",
    "དེ་གཉིས་ཀྱི་གཟུང་ཡུལ་རང་སྤྱི་ལས་ཐ་དད་ཕྱིར་རང་མཚན་དོན་དེ་ལས་གཞན་རེག་བྱ་དཔོག་པ་དང་སྔར་མཐོང་ངོ་ཐོས་སོ་ཞེས་སོགས་ཀྱི་སྒྲའི་ཐ་སྙད་ཉིད་ཀྱི་སྒོ་ནས་བསྟན་པ༵་ནི་སྤྱི་ཡིན་གྱི་རང་གི་ངོ་ངོ་བྱེ་བྲག་པའམ་རང་མཚན་བརྗོད་པ་མིན་ཏེ།",
    "ཡང་ན་རྗེས་དཔག་གི་ཡུལ་མིན་པ་ཞིག་ལུང་གིས་སྟོན་སྲིད་པས་སོ།",
    "ཁྱོད་ལ་མཚུངས་ཤེ་ན་མིན་ཏེ་ཡོངས་སུ་བརྟགས་ནས་ཡིད་ཆེས་ཚིག་ཀྱང་དཔྱད་གསུམ་གྱིས་དག་པའི་མི་བསླུ་བར།",
    "ཚུལ་གསུམ་ཚང་བ་རྟགས་སུ་བསྟན་པ་ངེས་ཚུལ་རེ་རེ་དང་གཉིས་གཉིས་པ༵་ཚུལ་གསུམ་མ་ཚང་ན།",
    "རྟགས་ཡང་དག་གི་དོན་མིན་པར་དོན་གྱིས་བྱས་སོ།",
    "ལྡོག་ཁྱབ་དོན་ལ་མ་གྲུབ་ཐམས་ཅད་དུ་སོང་བ་མིན་པའི་རྫས་ཀྱི་ཚད་ལ་དངོས་མིང་དང་རྡུལ་ཕྲན་རྟག་པ་ལའང་ཡོད་པར་འདོད་པས་རྗེས་འགྲོ་གཅིག་པུ་ཅན་དང་སྒྲ་རྟག་སྟེ་གཞལ་བྱ་མིན་པའི་ཕྱིར་རོ་ཞེས་ལྡོག་པ་གཅིག་པུ་ཅན་ནོ།",
    "མིག་གི་གཟུང་བྱའི་ཕྱིར་སྒྲ་མི་རྟག་ཅེས་པ་ཚུལ་དང་པོ་མེད་པ་ཅན་ནོ།",
    "དུ་ཡོད་དེ་ན་མེ་ཡོད་ཅེས་བརྟགས་པ་ཙམ་མོ།",
    "དེ་བཞིན་བརྗོད་ཚེ་ལ་ལ་མེ་ཡོད་ཅེས་མི་བརྗོད་པར་མེའི་འབྲེལ་བའོ་ཞེས་དྲུག་སྒྲས་སྟོན་རིགས་པར་ཐལ་ལོ།",
    "རྟགས་དེ་ཉིད་རང་གི་བསྒྲུབ་བྱ་གང་དང་མེད་ན་མི་འབྱུང་གི་འབྲེལ་བ་དེ་ཁོ་ན་ཡོངས་སུ་བཅད་ནས།",
    "ཨུཏྤལ་ལ་སོགས་རེ་རེ་རྟོགས།",
    "དྲི་བསུང་གི་བྱེ་བྲག་ཨུཏྤལ་གྱི་དྲིས་ཨུཏྤལ་མིན་པ་ལས་ལོག་པ་སོགས་རེ་རེ་རྟོགས་ཏེ་བྱེ་བྲག་པ་ཁྱོད་ལྟར་ན་ཡང་།",
    "ཡང་ན་མི་རྟག་བཞིན་གཞན་ཀུན་ཀྱང་རྟོགས་པར་ཐལ་ལོ།",
    "རང་གི་བསྒྲུབ་བྱའམ་ཆ་ཅིག་ཤོས་མེ་ཙམ་ཐོབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཁྱབ་པས་བ་ལང་དེས་དེ་རྭ་ཅན་མིན་ལས་ལྡོག་གི།",
    "བ་ལང་གི་དོན་ཡིན་པ་ཟློག་བྱེད་མིན་ཏེ་དེ་གཉིས་མི་འགལ་བས་སོ།",
    "མིག་གི་ཙ་",
    "གཟུང་བྱ་བུམ་པ་ལ་མཐོང་བས་སྒྲ་ལ་མི་རྟག་པ་རྟོགས་པར་ཐལ་ལོ།",
    "རིགས་པ་དེ་བཞིན་དོན་གཅིག་ལ་འདུ་བ་ལ་འཕྲོད་འདུ་སོགས་ལའང་ཕན་ཚུན་གོ་བ་སོགས་སུ་ཐལ་ལོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "གྭོ་བྱ་གོ་བྱེད་དུ་ཐལ་བར་འགྱུར་ཏེ་འབྲེལ་བ་དོན་གཞན་ལས་རྟོགས་པར་ཁས་བླངས་པས་སོ།",
