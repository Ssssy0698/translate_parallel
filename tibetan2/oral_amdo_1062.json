    "ཁྱོད་ན་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པ་དེ་ཉིད་ཀྱི་བྱིན་གྱི་རླབས་ཀྱིས་འཇིག་རྟེན་གྱི་ཁམས་འདིར་བྱིན་གྱིས།",
    "མའུ་འགལ་གྱི་བུ་གལ་ཏེ་ཁྱོད་རང་ག་རྫུ་འཕྲུལ་གྱི་སྟོབས་ཀྱིས།",
    "མོའུ་འགལ་གྱི་བུ་འདི་ཇིསྙམ་དུསེམས།",
    "མོའུ་འགལ་གྱི་བུ་ཁྱོད་ཀྱིས་རྣམ་གྲངས་འདས་ཀྱང་འདི་ལྟར་རིག་པར་བྱ་སྟེ།",
    "གལ་ཏེ་ཁྱོད་རང་གི་རྫུ་འཕྲུལ་གྱི་སྟོབས་ཀྱིས་འཇིག་རྟེན་གྱི་ཁམས་དེར་འགྲོན་ནི་བསྐལ་པས་ཀྱང་ཕྱིན་པས་མནུས།",
    "གང་གཱའི་ཀླུང་དགུ་བཅུ་རྩ་དགུའི་བྱེམསྙེད་འདས་པར་སོང་སྟེ།",
    "དེ་ནས་ཐམས་ཅད་དང་ལྡན་པའི་འཁོར་ངེས་ཐལམ་སྦྱར་ཏེ།",
    "གནས་བརྟནམོའུ་འགལ་གྱི་བུ་ཆེནཔ་བལྟ་བར་འཚལ་ལོ།",
    "མའུ་འགལ་གྱི་བུ་གང་དེ་བཞིན་གཤེགས་པའི་གསུང་གི་ཚད་དམ་མཐའ་ཡོངས་སུ་ཚོལ་བར་སེམས་པ་དེ་ནི།",
    "དབཞིནགཤེགས་པའི་གསུང་གིས་ཁྱབ་པོ།",
    "ཞི་བའི་བློ་གྲོས་འདི་ཡང་དེ་བཞིན་གཤེགས་བའི་གསུང་གི་གསང་བའོ།",
    "ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཚོས་སྟོན་པའི་གསུང་གི་ཡན་ལག་གི་རྣམ་པར་ཡང་དེ་སྙེད་དུ་འབྱུང་སྟེ།",
    "གསུང་གི་ཡན་ལག་དེ་བས་མང་།",
    "ཉོནམོངས་གཟུགས་མེད་ཞི་བར་བྱེད།",
    "དེ་ལྟར་ཉོན་མོངས་རྣམས་མེད་ཅིང་།",
    "དེ་ནི་ཚིག་གིས་བརྗོད་པ་ཡིན།",
    "ཞི་བའི་བློ་གྲོས་གཞནཡང་དེ་བཞིན་གཤེགས་པའི་གསུང་གི་གསང་བ་ནི།",
    "སྡུག་བསྤྲུལ་སྦྱོར་ཉིན་བར་སྣང་གི་ལྷ་རྣམས་ཀྱི་འདི་སྐད་ཅེས་བྱ་སྟེ།",
    "གངན་མི་རྣམས་ཀྱི་ཚིག་ཞི་བའི་བློ་གྲོས་གང་ཡུལ་ཆེན་པོ་བཅུ་དྲུག་ཏུ་བསྡུ་བས་བསྡུས་པའི་ཡུལ་སྟོང་གིས་འཛམ་བུའི་གླིང་འདིཡོངས་སུ་གང་སོཔ་རྣམ་པར་གཞག་པ་གཞནཡན་ནོ།",
    "ཡུལ་སྟོང་གིས་འཛམ་བུ་གླིང་།",
    "ཞི་བའི་བློ་གྲོས་སྟེང་གི་འཇིག་རྟེནགྱི་ཁམས་འདི་ན།",
    "གཅིག་གི་ཐེ་ཚོམ་དྲི་བ་གང་ཡིནཔ་དེ།",
    "བརྗོད་པ་གཅིག་གིས་དེ་དག་གི་ཐེ་ཚོམ་གྱི་དྲི་བ་ཐམས་ཅད་གཅོད་དེ།",
    "ཞིབའི་བློ་གྲོས་འདི་ཡང་དེ་བཞིནགཤེགས་པའི་གསུང་གི་གསང་བའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་དབུའི་གཙུག་གིསྟེང་ན་འདུག་གོ།",
    "བདག་ཅག་གིས་གསང་བ་པའི་བདག་པ་ལག་ན་རྡོ་རྗེས་མཐོང་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་གསུང་བསམ་གྱིས་མ་ཁྱབ་པ་འདི་ཐོས་པ་ནི་བདག་ཅག་གིས་རྙེད་པ་ལེགས་པར་རྙེད་དོ།",
    "མེ་ཏོག་གི་ཆར་ཆེན་པོ་ཡང་བབ་པ།",
    "༣ གི་བར་སྣང་ནས་ཚངས་པའི་འཇིག་རྟེན་གྱི་བར་དུ་མངོནཔར་འཕགས་ཏེ།",
    "ཇི་ལྟར་འདི་དག་གིས་ས་ཆེན་པོ་བརྟོལ་ཏེ།",
    "དེས་སྐྱེས་བུ་དེ་དག་གིས་ལེགས་པ།",
    "དེ་བཞིན་གཤེགས་པའི་གསུང་གི་གསང་བ་བསམ་གྱིས་མ་ཁྱབ་པ་བསྟནཔའི་ལེའུ་སྟེ་བརྒྱད་པ་འོ།",
    "དེ་དག་གི་རྣམ་པར་ཤེས་པ་དེ།",
    "གང་གི་ནུབ།",
    "གང་གནུབ་མོ་དེ་བཞིན་གཤེགས་པ་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས།",
    "དཀའཐུབ་གང་དག་བའི་བློ་གྲོས་དེ་ལ་ཁ་ཅིག་གིས་ནི་བྱང་ཆུང་སེམས་དཔའ་རྐང་པ་ཚུག་བཙུགས་ཏེ་འདུག་པར་མཐོང་།",
    "ཁ་ཅིག་གིས་ནི་ལག་པ་བཏེག་སྟེ་འདུག་པ་མཐོང་།",
    "ཁཅིག་ཁཅིག་གིས་ནི་གདུང་བ་ལྔས་གདུང་བར་མཐོང་།",
    "ཁ་ཅིག་གིས་ན་བ་ལང་གི་ཕྱི་བའི་ནང་ན་ཉལ་བར་ཁཅིག་གསནསྡོལེབ་ལ་སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ་འདུག་པར་མཐོང་།",
    "ཁཅིག་གིས་ན་རྩ་བ་ཀུ་ཤའི་གོས་གྱོན་པ་དང་།",
    "ཁ་ཅིག་གིས་ན་ཤིང་ཤུན་གྱི་གོས་གྱོན་པ་དང་།",
    "ཁཅིག་གིས་ནི་བཟའ་བ་དང་།",
    "ཁ་ཅིག་གིས་ན་གཉིད་དང་བྲལ་བར་མཐོང་ངོ།",
    "ཁ་ཅིག་གིས་ནི་འདུག་པ་འབའཞིག་ཏུམཐེང་ངོ།",
    "ལྟོ་འཕྱེ་ཆེན་པོ་བྱེ་བ་ཕྲག་དྲུགཙུ་ཡང་རང་རང་གི་ཟས་ཐོག་ཏེ།",
    "སྲས་ཆུདག་གིས་ས་གཞི་ཆག་ཆག་བཏབ།",
    "ཐམས་ཅད་ཚིག་གིས་བརྗོད་པར་མི་ནུས་པ།",
    "བཀོད་པ་དེ་དག་ཚིག་གིས་རྗོད་མ་ནུས།",
    "ལྷན་ཅིག་ཏུ་རང་གི་གནས་ནས་བྱུང་སྟེ།",
    "ཀླུམ་ཁྲག་ཁྲིག་དག་གིས་མདུན་བདར་ཏེ།",
    "གདུགས་དང་མེ་ཏོག་གིས་མཆོག་ཐོགས་ནས་སུ།",
    "མཚུངས་མེད་ཁྱེད་ཀྱིས་རེག་ནས་དེ་རིང་ངནསང་གསུམ་པའོ།",
    "སྤྱིར་ཞིང་དང་དུག་གིས།",
    "གཞནཞིག་ཡིན་པ་སྙམ་དུ་ཁྱོད་དོགས་ཤིང་ཐེ་ཙོམཟབས།",
    "ཚིགས་སུ་བཅད་པ་འདི་དག་གིས་མདེན་པརབསདད།",
    "ལྷའི་བུ་དེ་དག་གིས་ཀྱང་གཞན་དང་གཞན་དུ་མ་མཐོངམ་ཤེས་ཏེ།",
    "སྟེང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་ན་འཁོད་པའི་བདུད་བྱེ་བ་ཕྲག་བཞི་རྒྱལ་རེག་གོ།",
    "རྒྱལ་མཚན་རྣམ་པ་མང་པོ་ཐོགས་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དག་གིས་བསྐོར་ཏེ།",
    "བདུད་སྡིག་ཅན་དེ་དག་པོ་བཟློག་པ་རྣམ་པ་བཅུ་དྲུག་གིས་ཟློག་པར་བྱེད་དེ།",
    "སྡིག་ཅན་དག་ཕོངས་པར་འགྱུར་བ་གནོད་པར་དཀའ་བ་འདི་ལྟ་བུ་འདི་དག་གིས་ཅི་ཞིག་བྱསཐོང་འག།",
    "ཅིཞི་བའི་བགྲོས་བང་ཆུབ་ཀྱི་བསྙེན་བཀུར་བའི་ལྷ་རྣམས་ཀྱིས་བཟློག་པ་རྣམ་པ་བཅུ་དྲུག་གིས་བདུད་སྡིགཅན་རྣམས་བཟློག",
