    "ལྷ་སྔགས་ཡེ་ཤེས་སྐུ་དང་ཞིང་ཁམས་སུ།",
    "དགྲ་བཅོམ་ལྔ་བརྒྱའི་བཞུགས་གནས་ཏི་སེའི་གངས།",
    "ལྷ་ས་བསམ་ཡས་གཡོ་རུ་ཁྲ་འབྲུག་སྟེ།",
    "སྐུ་བཞིའི་གོ་འཕང་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "བརྟན་བཞུགས་འཁོར་ལོ་ལྔ་བརྩེགས་བཞུགས་སོ།",
    "འགྱུར་མེད་རྟག་བརྟན་བཞུགས་སུ་གསོལ།",
    "འགག་མེད་ལྷུན་གྲུབ་བརྟན་པར་གསོལ།",
    "དགྱེས་བཞིན་བསྐལ་བརྒྱར་བརྟན་བཞུགས་གསོལ།",
    "འགྱུར་མེད་ཕྱག་རྒྱས་འགེངས་པར་མཛོད།",
    "སྤར་བྱང་སྨོན་ཚིག་ཤིས་པར་གྱུར་ཅིག་ཕུལ་བྱུང་རྣམ་དཀར་གྱི།",
    "ལེགས་བྱས་ཟླ་བའི་འོད་དཀར་བསིལ་རྡུལ་གྱིས།",
    "ལེགས་བྱས་སྣང་བའི་ཕོ་ཉའི་ཁྱུང་སྔོན་སྐྱེས།",
    "མཁྱེན་གཉིས་འོད་སྟོང་འབར་བའི་ཕྲིན་ལས་ཀྱིས།",
    "ཐུབ་བསྟན་རྣམ་པར་རྒྱལ་བའི་དགེ་མཚན་འབར།",
    "ལེགས་གསུངས་གདམས་ཟབ་དུནྡྷུ་བྷིའི་སྒྲ་དབྱངས།",
    "མི་ཟད་འཇོ་བའི་རྣམ་དཀར་ལེགས་བྱས་ཕུལ།",
    "ངོ་མཚར་འཕྲུལ་གྱི་དཔར་ལས་རབ་བསྐྲུན་ཞིང་།",
    "ལོ་ལྔ་དྲུག་ར་བཞིར་ཕེབས།",
    "བོད་ལྗོངས་ཤིན་ཧྭ་པར་འདེབས་བཟོ་གྲྭས་པར་བཏབ།",
    "ཤོག་ཁ་བྲེ་ཁ་བར་འཇུག་ཤོག་གྲངས་ཡིག་འབྲུ་ཁྲི་ལོའི་ཟླ་པརགཞི་པར་ཐེངས་བཏབ།",
    "མར་ལྟང་གཤགས་པའི་ཀླན་ཀ།",
    "དེའི་ཚེ་ཡང་ཉེ་འཁོར་དེ་ནས་ཚ་ཚ་ཞེས་པའི་སྒྲ་གྲགས་པ་ལ་འཇིགས་མེད་ཚེ་བརྟན་གྱི་བསམ་པར།",
    "སྡོ་བསངས་ནམ་མཁའི་ཀློང་ན་དྲི་མེད་ཆུ་འཛིན་རབས་དཀར་པདྨའི་ཆུན་པོ་དལ་གྱིས་གཡོ་བ་ལྟར་རྣམ་པར་མཛེས་པའི་ཡུལ་མཆོག་ནས་འཇིགས་མེད་ཚེ་བརྟན་དང་།",
    "བརྟག་དཔྱད་ཞིབ་འཇུག་མ་བྱས་ན་མི་འཐད་སྙམ་སྟེ་མགོ་འཇགས་མ་ལ།",
    "རྐང་པར་གྱིག་ཧམ་མགོ་ཁྲ་རལ་རྡོལ་གྱོན་པ།",
    "རྐེད་པར་ཀོ་ཤུབས་སུ་བཅུག་པའི་གྲི་ཆུང་བཏགས་པའི་བྱིས་པ་ལོ་ན་བཅུ་ཙམ་དུ་སོན་པ།",
    "གཏམ་དེ་འགྲམ་དུ་གནས་པའི་ཕྲུ་གུ་དེའི་བློ་ལ་མ་བབ་པར།",
    "ལག་གཡས་པ་གྲི་འགོར་འཆང་བཞིན་བསྡད། ཨ་བོ་དགྲ་འདུལ་གྱིས་ཕྲུ་གུ་དེའི་འགོ་ནས་མཇུག་བར་ཞིབ་པར་བལྟས་རྗེས།",
    "ཁྱེད་གཉིས་ཀྱིས་ལྷ་མཛེས་མ་དང་གཏམ་གླེང་བྱས་ན་མི་འཐད།",
    "རྐང་པར་ཀོ་ལྷམ་ནག་པོ་འོད་ཐིང་ངེ་བ་ཞིག་གྱོན་ཏེ་གྲུང་ཧྲིལ་ཧྲིལ།",
    "ང་ལས་ཀ་གང་དུ་བཀོད་སྒྲིག་གནང་ཡོད་མེད་བཀའ་འདྲི་ཞུ་བར་བཅར་བ་ཡིན་ཞེས་སྐད་སྒྲ་ཆུང་ངུས་ཞུས་འཕྲལ།",
    "རྐང་པར་རས་ཧམ་ནག་པོ་གྱོན་པ་དེ་འདྲ་ཞིག་མིག་ལམ་དུ་འཆར་འཕྲལ་བརྗོད་མི་ཤེས་པའི་ཡ་མཚན་སྐྱེས་ཏེ་བསམ་པར།",
    "ཉལ་ཆས་སོགས་བཀལ་བ་དེ་བཞོན་རྟར་བྱས་ནས་རིངས་ནས་རིངས་བར་ཆས་ནི་ཆས་ཀྱང་ཡུལ་མཐོང་སྨོན་དུ་མ་སླེབས་ལ་མཁའ་དབྱིངས་ཀྱི་ཉི་མའང་ཡིད་ཐང་ཆད་དེ་ཕྱི་མིག་ལྟ་བཞིན་ནུབ་རིའི་རྒྱབ་ཏུ་བཞུད་ནས་ས་གཞིའང་མུན་པའི་ཡོལ་བ་ནག་པོས་བསྒྲིབས་ལ་ཁད་པས།",
    "སྐྲག་པ་དང་དུབ་པ་བཅས་དུས་གཅིག་ཏུ་བྱུང་བར་བཟོད་གླགས་མ་མཆིས་པར་བློ་རྩ་ཞུམ་པ་དང་།",
    "ལུས་ངག་ཡིད་ཀྱིས་ཅི་གསུངས་ལྷུར་བླངས་ཏེ།",
    "ཀླུང་དུ་ཤིང་གཤགས་པས་ར་བ་བསྐོར་བའི་ཞིང་ཁ་གླིང་གླིང་དུ་བྱས་པ།",
    "སྨུག་སྤྲིན་ཡང་རིམ་གྱིས་ཡལ་ཏེ་ས་གཞིར་ཉི་འོད་ཀྱིས་འཚེར་ཏེ་རྔུལ་བ་དང་སྣུམ་པར་བྱས་ཏེ་ཡུལ་གྱི་རྣམ་པ་སྔར་བས་མཛེས་པར་གྱུར།",
    "གཞོན་ནུ་མ་དེ་ནི་དཀར་དམར་ཞག་ཚོན་གྱིས་མ་བཅོས་པ་བཞིན་བཟང་གསར་བཞད་འདབ་བརྒྱའི་མཛེས་སྡུག་དང་དབྱེར་མེད་པ་ལ་གནག་ཅིང་སྣུམ་པའི་སྐྲ་ལོ་རིང་པོ་ལྷས་མ་ཕྲ་སྦོམ་དུ་མ་རུ་བྱས་པར་གཡུ་ཆུང་སྔོན་པོ་ཐར་ཐོར་དུ་བརྒྱན།",
    "སྤང་གཅལ་གྱི་དཀྱིལ་དུ་རྐང་པ་གཉིས་བགྲད་བགྲད་བྱས་ཏེ་ལངས།",
    "ཕྲག་པ་གཡོན་མ་ཐུར་དུ་གཞོལ་ནས་ཕུ་ཐུང་ས་ལ་ཐུག་པ་བྱས།",
    "ཀུན་མཁྱེན་ནམ་མཁའ་ནོར་བུ།",
    "སྔོ་ཌཱརྣམ་པར་འབྱེད་པའི་མཚོན་ཆ་ཀུན་སྤྱོད་ཉིད།",
    "སྐབས་དེར་མགོ་འཇགས་མས་གྲོད་པར་བཏུམས་པའི་མར་སྒོར་འཁྱིལ་འཁྱིལ།",
    "ཕྲག་པ་ཡ་གཅིག་རོང་རོང་བྱས་ནས་བསྡད་པས།",
    "ཚོགས་ཀྱི་གསབ་ཏུ་མགོ་འཇགས་མའི་བྱེད་ལུགས་བྱེད་སྟངས་ལ་ཞིབ་ཏུ་དཔྱད་ནས་ཡོད་པའི་རི་པའི་ཕ་རྒན་དགྲ་འདུལ་གྱི་བསམ་པར་མི་ངན་གྱི་ཁོག་པ་གཡོ་སྒྱུས་ཁེངས།",
    "འཛུམ་དམུལ་དམུལ་དུ་བསྡད་པ་བཅས་ཀྱིས་ད་གཟོད་ཤུབ་ཤུབ་འུར་འུར་གྱི་བཟླས་སྒྲས་ཁེངས་པའི་དོ་ར་དེའང་སྐད་ཅིག་ཉིད་དུ་དབེན་པའི་གནས་ལྟར་འཇམ་ཐིང་དུ་གྱུར་ཏེ་ཕྱུགས་ཟོག་གཟན་རྩྭ་ལ་རོལ་བའི་བལྡད་སྒྲ་སྐེའི་དྲིལ་བུ་གཡོ་བའི་ཏང་ཏང་སྒྲ་ལས་གཞན་གང་ཡང་དང་།",
    "དེའི་ཚེ་ན་ལྷ་མཛེས་མ་གྱོན་ཆས་གཙང་མས་བཀླུབས་ཏེ་བབ་ཆག་ལ་ལྟ་ན་སྡུག་པ།",
    "ཁྱེད་ཆུས་ཀྲང་མཆོག་ནས་གསུངས་རོགས་མཛོད་ཅེས་སྨྲས་སོ།",
    "མའོ་ཀྲུའུ་ཞིས་གསུངས་པ་ལྟར་རྨེ་ན་མེ་མདའ་འཁྱེར་བའི་དགྲ་བོ་རྩ་མེད་བཏང་ཚར་ན་ཡང་།",
    "དག་པའི་ལས་ལ་བརྩོན་པར་ཞུགས་པ་དེ།",
    "ཀུན་མཁྱེན་ནམ་མཁའ་ནོར་བུ་ནི་བསྟི་གནས་གཙང་ཞིང་དྲོ་སྐྱིད་ལྡན་པ།",
    "རྩོམ་འདི་སྤྱིའི་ཆ་ནས་ལེགས་པར་མཐོང་ཡང་།",
    "ལྷ་མཛེས་མ་ལན་འདེབས་པའི་སྤོབས་པ་ཡོངས་སུ་བྲལ་ཏེ་སྦིད་པ་དབུགས་ཤོར་བ་ལྟར་འཁུམ་མེར་བསྡད་པས།",
    "དེར་མགྲོན་པོ་རྩ་ཆེ་ཕེབས་ལེ་བསམ།",
    "གསོད་པ་དང་བཅས་སྤྱོད་ངན་ཡོད་དགུ་སྤེལ་ནས་སྐྱེ་བོ་མཚོག་དམན་རྒན་གཞོན་མཐའ་དག་ངར་ཤག་ཤག་ལྡང་ཤག་ཤག་བཟི་བིར་བིར།",
    "ལས་ཀ་ཅི་བྱས།",
    "དེ་ལྟར་བྱས་ནས་ལྟ་ན་ཉམས་དགའ་ཞིང་ཡིད་དུ་འོང་བའི་དབེནཔའི་གནས་མཆོག་དེ་སྐད་ཅིག་ཉིད་དུ་གཡུལ་ཆེན་པོ་འཁྲུག་པའི་ཤུལ་ལྟར་གང་སར་མེ་རོ་དུ་བ་འཚུབ་འཚུབ་དང་།",
    "གད་སྙིགས་བཅས་ཛ་ཛོཪ་རྣམས་ལེཊ་པར་བཅོསཏེ་ཁམས་ཤིན་ཏུ་དྭངས་བར་གྱུར་ཅིང་།",
    "ཁང་པའི་དཀྱིལ་གྱི་རྩིག་ངོས་སུ་མའོ་ཀྲུའུ་ཞི་སྐུ་ཚོ་དར་ལ་བབས་པ་ཕྱག་ཏུ་ཉི་གདུག་བསྣམས་པའི་སྐུ་པར་ཚོན་འདྲ་ཨན་ཡོན་དུ་ཕེབས་པ་ཞེས་པ་ཞིག་བཀལ་ཏེ་རླབས་ཆེན་གཙོ་འཛིན་ལ་གུས་བཀུར་གྱི་སེམས་པ་རྣམ་པར་གསལ་བ་བྱས།",
    "གྲོགས་བཟང་པོ་ཤ་འདིར་བཞུགས་ཚང་མ་གཉེན་ཉེ་དུ་དང་།",
    "ཁ་རྒྱུན་ལ་ལས་ག་ལེར་བྱས་ན་བསམ་དོན་གྲུབ།",
    "ཊཡིད་གཙང་མ་ནམ་མཁའ་དྭངས་དྭངས་ཡིན།",
    "བཟ་བཅས་ལུ་ལྷད་མེད་པར་མཆེད་པའི་བྱ་ཁྲི་སྲས།",
    "བར་སྐེད་པར་ནགས་ཀྱིས་ཡོངས་སུ་འཁྲིགས།",
    "བར་སྐེད་པར་ཆབ་ལོང་འཆིང་བ་འདྲ།",
    "ཆ་བྱ་ཁུ་བྱུག་ལྷོ་རུ་མ་བཞུགས་ན།",
    "ཡག་ཡག་ཙ་ཙ་ཞེས་མགོ་ལྕོག་ལྕོག་ལན་མང་དུ་བྱས་སོ།",
    "ཨ་ཧོ་བྱས་བྱས་ལས་ཀྱི་མཐའ་ལ་ཡིད་ཆད་ཀྱི་སྣོན་པ།",
    "ཎྜཌིི་བྱས་ནས་གྲུབ་པར་རློམས་པའི་བདེ་འབྱོར་ཀུན་བསགས་ཀྱང་།",
    "གོང་རིམ་གྱིས་བཀའ་བཀྱོན་གནང་དང་གནང་།",
    "དཔུང་པ་གཡོན་མ་རོང་ངེར་བསྡད།",
    "ཆེས་མཐོའི་བཀའ་སློབ་ཅེས་འདོན་མ་ཐག་ཏུ་གདན་སྟེང་དུ་ཅི་བདེར་བག་གཡེངས་སུ་བཞུགས་པའི་ལི་ཧྲུའུ་ཅི་དང་།",
    "དེའི་ཚེ་མགོ་འཇགས་མས་མུ་མཐུད་ནས་སྨྲས་པར།",
    "ལྷ་ས་བོད་པའི་གཏམ་དཔེ་ལ།",
    "ངོས་ལེན་མ་ཞུས་ན་བཟོ་ལྟ་སྤྲས་ཀྱི་ཡིན་ཞེས་ཁ་མང་གཅིག་ཏུ་བསྒྲགས་ནས་སྐད་ཅོར་འུར་འུར་གྱིས་རྣའང་འོན་པར་གྱུར།",
    "འོ་ཀྲུའུ་ཞིང་སྐྱོབས་རོགས་གནང་ཞེས་མགོན་སྐྱབས་ཀྱི་མཚན་ནས་བོས་པས།",
    "ད་ཅི་བྱས་ན་དགའཞེས་བློ་འདྲིས་པར།",
    "བརྩམས་ཏེ་ལངས་པའི་འབངས་གྱེན་ལྡོག་དང་བོད་སིལ་བུར་གྱུར་ནས་ལོ་ངོ་ཉིས་བརྒྱའི་ནང་རྒྱ་བོད་འབྲེལ་བའི་སྐོར་གླེང་བ་ཞེས་པའི་ཟིན་བྲིས་དེ་རུམ་དུ་གཟབ་ཏུ་བཅུགམ་རྒན་འཛོམས་དགས་སྦྱེན་པའི་རིན་ཆེན་ཕྲ་ཚོམ་སྣ་ཚོགས་བཏབ་པའི་རལ་གྲི་དེ་སྐེད་པར་བཏགས།",
    "ག་སྦྲུལ་ཆུང་བ་རྣམས་བརྟེན་ས་མེད་པར་ཚང་མ་ཞིག་སྟེ་ས་ཐོག་ཏུ་འགྱེལ།",
    "དེ་ནས་བྲག་ལ་མདའ་ཞིག་ཕངས་པས་བྲག་རྡོ་དང་དུག་སྦྲུལ་ཐམས་ཅད་ཕྱོགས་མཚམས་མ་ལུས་པར་ཐོར།",
    "དེ་ནས་བྲང་ཁོག་གཤགས།",
    "རྒས་ཀྱང་ཕྱི་ལམ་འགྲོ་རྩིས་མ་བྱས་དེར།",
    "མ་ཤི་འཆི་ལམ་འགྲོ་བའི་བརྫུ་བཏབ་པར།",
    "ནམ་མཁའ་ནོར་ར་བུ་ཁོའི་བཤེས་གཉེན་ཡིན་པས་དེ་ལ་འཐབ་རྩོད་བྱས་ན་ཁྱད་པར་ཅིམེད་ཅེས་སྨྲས་པ་དང་ཁུ་ཚུར་སྒྲེང་བཞིན་ངར་སྐད་འཛེར་འཛེ་ར་གྱིས།",
    "གུས་ཞབས་ཆེ་ལ་བབ་ཆགས་པོ་བཅས་བྱས་ན་མི་འགྲིག་གསར་བརྗེ་ནི་གྱེན་ལོག་བྱེད་པ་ཞིག་དང་།",
    "མའོ་ཨུང་ཏུང་བཅས་ཀྱིས་ཀུན་མཁྱེན་ནམ་མཁའ་ནོར་བུའི་ལག་གཉིས་རྒྱབ་ཏུ་བསྡམས་ཏེ་རྡུང་རྡེག་ཅིག་ཅར་གྱིས་སྐུལ་བཞིན་མདུན་དུ་སྐྱོད།",
    "སྐོམ་པ་ལས་བྱུང་བའི་སྡུག་བསྔལ་ཡུད་ཙམ་སེལ་བར་བྱས།",
    "དེར་ཤིང་སྣ་དང་གངས་ལྷ་མེ་ཏོག་སོགས་ཀྱིས་མཛེས་པར་བྱས་པའི་ཁྲོད་དུ་གནམ་གྱི་ཀ་བ་ལྟ་བུའི་སྡོང་རྒན་སྣུམ་ཞིང་ཡལ་འདབ་རབ་ཏུ་རྒྱས་པ།",
    "ཀུན་མཁྱེན་ནམ་མཁའ་ནོར་བུའི་ཐུཊ་ལ་ད་འདི་ནི་རྨི་ལམ་འདྲ་མིན་ནམ་དགོངས་ཏེ་ཞིབ་པར་གཟིཊནས་མངོན་སུམ་ཡིན་པ་མཁྱེན་འཕྲལ་གཤིན་རྗེའི་ཁ་ལས་སྐྱོབ་མཁནཨཱ་ཙིམགོན་སྐྱབས་འཕྲད་པ་བཞིན་དུ་ཐུགས་སྤྲོ་བས་འཕེལ་ཏེ།",
    "དེ་བསྐྱར་དུ་གླེང་ན་སེམས་པ་འཁྲུག་ཅེས་གསུངས་ནས་སྡུག་བསྔལ་གང་ཡང་མ་བྱུང་བའི་ཚུལ་དུ་སྔར་བཞིན་ཞབས་བཅག་སྟེ་གནས་སོ།",
    "དེ་འདྲ་མ་ཡིན་ཞེས་གསུངས་ཏེ།",
    "སྟོབས་ཀྱི་སྡིགས་པ་མེད་པར་འགྲོ་ཀུན་འདུད།",
    "མི་བསད་རྟ་འཁྱེར་འདི་འདྲ་ག་ལ་བྱེད་ཕོད་ཅེས་གསུངས་ཏེ་ཐུགས་ཤིན་ཏུ་སྐྱོ་སྣང་དང་འཕང་སྣང་མཛད།",
    "ལྷག་པར་དུ་སྙན་དངགས་ཀྱི་རྩོམ་མཐའ་དག་གོ་བདེ་ལ་དོན་ཟབ་པ།",
    "ཌ་ཌ་རིག་པའི་གནས་ཀྱི་བློ་སྒོ་ཡངས་པར་ཕྱེ།",
    "དྷུས་ཅིན་གྱི་མིག་ཤེལ་མཐུག་པོ་བཞེས་པ།",
    "རྙིང་པ་བཞིན་དུ་ནོངས་པར་གྱུར་ཏོ།",
    "ད་ཆ་འགོ་ཁྲིད་ཚོས་ང་ལ་གསུངས་ཡོང་དུས་ངས་ངོས་ལེན་ཞུ་དང་ཞུ།",
    "ད་ཁྱེད་ཀྱིས་གཅིག་གསུངས་དང་ཞེས་སྨྲས་པས།",
    "ངའི་ཁྱིམ་ལ་བུ་སྤུན་གསུམ་ཡོད་པར་ཆེ་བ་ལ་དགྲ་ལྷ།",
    "བར་ཕྱི་ལ་ཐོན་ཏེ་རྒྱགས་ཕྱེ་སྒྲུབ་པར་ཆས་ཏེ་འབྲུ་རྩམ་བང་ང་གང་བ་བྱས།",
    "ང་གཉིས་གནས་ཚང་དུ་ལོག་ནས་གྲོས་ཁ་མང་དུ་བྱས་པའི་མཐར་ནངས་པར་རི་ཤོ་ཞེས་བྱ་བའི་དགྲོག་ཤུཪ་ཏུ་བསྒུག་རྒྱུ་ཁ་འཆམ།",
    "ཁྲི་གདུགས་ཉི་མ་ཤར་རིའི་ཕྲག་པར་འཛེགས་པ་དང་ཡུལ་དེའི་འབྲོག་པ་རྒན་གཞོན་བྱིས་གསུམ་གཟབ་མཚོར་སྤྲས་ཏེ་ལ་ལ་རྟ་ལ་འཁྱེར།",
