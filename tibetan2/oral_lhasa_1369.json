    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་སྤྱོད་པ་ཀུན།",
    "འབྲས་བུ་རྒྱས་པར་གསུངས་པའོ།",
    "འབྲས་བུའི་རིམ་པ་ནི་གང་ལགས།",
    "ཕྱི་མའི་དུས་སུ་རིམ་པས་སྟོན་པའི་རྒྱལ་ཚབ་བྱེད་པར་ལུང་བསྟན་ཏོ།",
    "ཞིབ་པར་ཞིག་པོ་ཉི་མ་སེང་གེ་དང་།",
    "ཡི་གེ་གསུམ་གྱི་བཟླས་པ་བྱས་པས།",
    "འོད་གསལ་འགྲོ་འོང་མེད་པར་རྟོགས་པ་འདི་ནི།",
    "དངོས་གྲུབ་ཐོབ་པར་༡༩",
    "དམ་ཚིག་ཉམས་པར་གྱུར་ན།",
    "སྤྲོས་མེད་ལྷན་ཅིག་སྐྱེས་པར་རྟོགས་པ་འདི་ནི།",
    "༣ བདེ་བའི་རོ་སྟོང་པར་འབར་བས།",
    "ཐིག་ལེ་རྡོ་རྗེའི་དབྱིངས་སུ་ཆགས་པར་གྱུར་ནས།",
    "རང་གྲོལ་སྤང་བླང་མེད་པར་རྟོགས་པ་འདི་ནི།",
    "ཉམས་བཏང་བཞག་མེད་པར་འཆར་བ་འདི་ནི།",
    "མ་བཅོས་པར་རང་ཉམས་ལ་གནས་པ་འདི་ནི།",
    "༣༨ དུས་གསུམ་གྱི་ཤེས་པ་ཡིད་ལ་མ་བྱས་པས།",
    "ཤེས་པ་རྩིས་གདབ་མེད་པར་འཇོག་པ་འདི་ནི།",
    "འཛིན་རྟོག་རྩད་མ་བཅད་པར།",
    "མ་མེད་པ་དངུལ་སྒོང་དག་པའི་སྐོར་ཞེས་བྱ་བ་རྫོགས་སོ། ། ལམ་དྲི་མ་མེད་པ་གསེར་སྒོང་དག་པའི་སྐོར་བཞུགས་སོ།",
    "གང་ཡང་གདམས་པར་འགྲེ་བ་ཡིན་གྱིས།",
    "ལམ་དྲི་མ་མེད་པ་ཤེལ་སྒོང་དག་པའི་སྐོར་བཞུགས་སོ།",
    "དྲན་པ་སྤྲུལ་པར་མ་ཤེས་ན།",
    "སྣ་ཚོགས་ཞེན་མེད་དུ་ཤེས་པར་བྱ།",
    "འགྱུ་བའི་འཕྲང་བཙན་ཐབས་སུ་བཅད་པར་བྱ།",
    "གདིང་ལྡན་གྱི་རིག་པ་ཧུར་འདོན་པར་བྱ།",
    "རིག་པ་ཐོག་བབས་སུ་བརྒྱབ་པར་བྱ།",
    "ཕུ་ཐག་ད་ལྟ་ནས་ཆོད་པར་བྱ།",
    "གཉེན་པོ་ཡུལ་ལ་ཐུབ་པར་བྱ།",
    "བློ་ཡི་སྙེམས་ཐག་བཅད་པར་བྱ།",
    "རྟོག་པ་ཡུལ་ལས་བཅད་པར་བྱ།",
    "རྩ་བ་བྲལ་བའི་རང་བཞིན་ཤེས་པར་བྱ།",
    "གཉེན་པོའི་བྱ་ར་བ་བཤིག་པར་བྱ།",
    "སྐད་ཅིག་མའི་མཚངས་ཤེས་པར་བྱ།",
    "རིག་པ་དྭངས་སུ་གཞུག་པར་བྱ།",
    "རྣམ་རྟོག་རྒྱུན་པར་འཆོར་བས།",
    "སྒྲུབ་པ་དུམ་བུར་མཐུད་པར་བྱ།",
    "འདས་པའི་རྗེས་མི་བཅད་པར་བྱ།",
    "ཤེས་པ་སོ་མའི་རྒྱུན་མཐུད་པར་བྱ།",
    "དྭངས་མའི་ཤེས་པ་མི་བསླད་པར་བྱ།",
    "ལྟ་སྟངས་ལ་ངར་གདགས་པར་བྱ།",
