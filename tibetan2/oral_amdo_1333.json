    "ཚེ་སྐྱིད་ཀྱིས་དོན་གྲུབ་ཀྱིས་ཁོ་ཚོར་ཟེར་སྲོལ་ལ་བལྟས་ན་ཁོ་མོར་ཡང་ཅི་ཞིག་ཉོས་ཡོད་པ་འདྲ་སྙམ་པས།",
    "ཁོ་མོས་བུ་མོ་གཉིས་ཀའི་ངོ་མ་བཟློག་པ་ལྟར་ཕར་སོང་ནས་ཁུག་མ་དེའི་ཁ་ཕྱེ་ནས་རེ་རེ་བཞིན་ཕྱིར་ཕྱུངས།",
    "ཐོག་མར་བླངས་པ་ནི་བུ་མོ་གཉིས་ཀར་ཉོས་པའི་གྱོན་གོས་སྤུས་ལེགས་ཆ་ཚང་གཉིས་ཡིན་འདུག་པས་བུ་མོ་གཉིས་ཀས་རེ་རེ་ལག་ཏུ་བཟུང་ནས་ཧ་ཅང་དགའ་བར་གྱུར།",
    "མུ་མཐུད་དུ་སྔོག་པ་ན་བུ་མོ་གཉིས་ཀར་ཀོ་ལྷམ་ཆ་རེ་ཡོད་པ་དང་ཞབས་སུ་བུད་མེད་ཀྱི་གསར་དར་གྱོན་གོས་ཤིག་དང་དངོས་པོ་ཅུང་ལྗིད་མོ་ཞིག་ཡོད་པ་མཐོང་།",
    "ཁོ་མོས་མྱུར་དུ་ཕྱིར་བླངས་ནས་བལྟས་མ་ཐག་ཏུ་ཨ་ཙི་ཞེས་ཧ་ཅང་དགའ་བའི་སྐད་ཅིག་ཤོར།",
    "མཁར་གྲོང་འདིའི་ལས་བྱེད་བུད་མེད་འགའ་རེས་གྱོན་འདུག་པས་ཁོ་མོ་དེ་སྔོན་ནས་ཡིད་སྨོན་སྐྱེས་མྱོང་།",
    "ད་ཐེངས་ཁོས་དངོས་སུ་ལྭ་བ་རྩ་ཆེན་འདི་ཉོས་ཡོང་འདུག་པས་ཁོ་མོ་དགའ་སྤྲོ་མི་སྐྱེས་པ་ག་ལ་སྲིད།",
    "ད་ལྟ་ཁྱོད་གང་དུ་འགྲོ་ཡང་བུད་མེད་དེ་རྗེས་སུ་འཁྲིད་དགོས་ཀྱིན་འདུག་གམ་ཞེས་དྲིས།",
    "དོན་གྲུབ་དགོད་བཞིན་དུ་ད་ཐེངས་དངོས་གནས་དེ་འདྲ་ཞིག་ཏུ་གྱུར་ཐལ་ཟེར།",
    "ཁོས་དྲང་ཐད་དུ་ཁས་བླངས་སོང་བར་ཡ་མཚན་སྐྱེས།",
    "ཁོ་མོའི་ངོ་གདོང་འཕྲལ་མར་དམར་བོར་གྱུར།",
    "ཁྱོད་ངོ་མ་འཆལ་མོ་དེ་ལ་དགའ་ཡི་འདུག་གམ་ཞེས་དྲིས།",
    "དོན་གྲུབ་ཀྱིས་འདང་རྒྱག་པ་ལྟར་དུ་ཁོ་མོ་འཆལ་མོ་ཞིག་མ་རེད།",
    "ད་ཐེངས་ཁོ་མོས་ང་ལ་སེམས་འགུལ་ཐེབས་སུ་བཅུག་སོང་ཟེར།",
    "ངས་ཁོ་མོར་སྡིགས་ན་ཁྱོད་མི་དགའ་བ་ཡིན་ནམ།",
    "ཁྱོད་ལ་མལ་ཁྲིའི་སྟེང་ནས་སེམས་འགུལ་ཐེབས་སུ་བཅུག་པ་ཨེ་རེད།",
    "ཁོང་བཟའ་ཟླ་གཉིས་ལ་ཕྲུ་གུ་ཡོད་པ་མ་རེད་ཟེར།",
    "ཚེ་སྐྱིད་ཀྱིས་དེའི་རྐྱེན་གྱིས་ཁྱོད་ལ་ཕྲུ་གུ་བསླངས་བ་ཨེ་རེད་ཅེས་དྲིས།",
    "ཟེར་བ་ཨེ་རེད་ཅེས་དྲིས།",
    "དོན་གྲུབ་ཀྱིས་ཧ་ཅང་ནན་ཏན་ངང་མ་རེད།",
    "དོན་གྲུབ་ཀྱིས་ཧ་ཅང་རྒྱང་རིང་བའི་འཇིག་རྟེན་ཞིག་ལ་ལྟད་མོར་ལྟ་བ་བཞིན་མིག་གིས་ཧུར་རེར་ཁ་གཏད་ཀྱི་རྩིག་ངོས་སུ་ལྟ་བཞིན་དུ།",
    "ཁོ་མོ་རང་ཉིད་ཀྱི་ཁྱོ་གར་དགའ་བའི་བརྩེ་དུང་གཏན་ནས་ལྷོད་མ་མྱོང་ཟེར།",
    "ཁོ་མོ་ནི་ང་དང་བསྡུར་ན་ཅི་འདྲའི་རླབས་ཆེན་ཞིག་རེད་ཨང་།",
    "ཁོ་མོར་བསྡུར་ཚེ་ངས་ངོ་མ་རང་ཉིད་ཀྱི་ཉེས་པ་མང་པོ་ཞིག་མིག་གིས་མཐོང་ཐུབ་པ་འདྲ་ཟེར།",
    "ནུས་པ་མེད་ན་གཉེན་སྒྲིག་ཇི་ལྟར་བྱས་པ་རེད་ཅེས་དྲིས།",
    "དོན་གྲུབ་ཀྱིས་མགོ་བོ་འཕྲེད་དུ་གཡུགས་ཀྱིན་ཧ་ཅང་ཡིད་ཕངས་བའི་རྣམ་འགྱུར་ཞིག་བསྟན་ནས་མི་ཡིས་ནམ་ཡང་ཤོར་གྱིན་པ་ནི་གོ་སྐབས་ཤིག་རེད།",
    "གོ་སྐབས་རེ་རེ་ཕར་ཤོར་ཚེ་དེ་ཡི་ཚབ་ཏུ་འོང་བ་ནི་བསུབ་ཏུ་མེད་པའི་ཕངས་སེམས་ཤ་སྟག་ལས་ཅི་ཞིག་ཡོད་ཨང་།",
    "དང་ཐོག་ཁོང་གཉིས་ཀྱིས་གཉེན་སྒྲིག་བྱས་རྗེས་ཕན་ཚུན་གྱི་བྱ་བའི་སྟབས་བདེར་དམིགས་ནས་ལོ་འགའ་བྱིས་པ་མི་བཙའ་རྒྱུ་བྱས་པ་རེད།",
    "ཁོ་རང་ཡང་ཡི་ཆད་པར་གྱུར་ཅིང་འདི་ལྟར་སོང་ན་ཁོ་མོ་སྡུག་རྒྱུ་རེད་སྙམ་ནས་ཐེངས་མང་བོར་ཁོ་མོ་དང་གྲོས་བྱས་ཏེ་གཉེན་འཐོར་བྱེད་པའི་རེ་བ་ཞུས་ཀྱང་ཁོ་མོས་དང་ལེན་མ་བྱས་པར་ད་བར་དུ་བསྡད་པ་རེད།",
    "ལོ་བཅུ་ཕྲག་གི་རིང་ལ་ཁྱོ་ག་གཅིག་པུ་བསམ་ནས་འདི་ལྟར་མོ་ཧྲེང་ལྟར་ཡོང་བ་ནི་ངོ་མ་རླབས་ཆེན་རེད་ཨང་།",
    "ད་དུང་རེ་ལྟོས་བྱེད་སའི་བུ་ཕྲུག་ཅིག་ཀྱང་ཡོད་པ་མ་རེད་ཡ་ཞེས་ཟེར་བཞིན་སྔར་བཞིན་རྩིག་ངོས་སུ་བལྟས་ནས་བསྡད།",
    "སྐབས་འདིར་ཚེ་སྐྱིད་ཀྱིས་ཀྱང་ཕལ་ཆེར་ཁྱོ་གའི་ཞིབ་བརྗོད་ཀྱི་སྐད་ཆའི་བརྒྱུད་རིམ་ཁྲོད་ནས་གནས་ལུགས་ཅི་ཞིག་གི་ཧ་ཅུང་ཙམ་གོ་བས་ཁུ་སིམ་མེར་ཉན་ནས་སྡོད་པ་ལས་སྐད་ཆ་ཅི་ཡང་མ་བཤད།",
    "སྐབས་འདི་ཙམ་ལ་ཁོ་རང་གད་སྙིགས་བཞིན་དོར་བ་ནི་གནམ་ལ་མི་ཤོང་བའི་ནག་ཉེས་ཆེན་པོ་ཞིག་རེད།",
    "དེ་ལྟར་བྱས་ཚེ་བཟའ་ཚོའི་བརྩེ་དུང་ཟེར་བ་དེ་ནམ་ཡང་གླེང་ཐབས་མེད་པ་རེད།",
    "ཁོ་མོ་ནམ་ཡང་ཁོའི་སྡོད་གྲོགས་བྱས་ཏེ་སྐྱིད་སྡུག་མཉམ་འཁུར་བྱེད་རྒྱུ་ཡིན།",
    "དེ་དང་བསྡུར་ན་ང་ཚོ་མི་མང་པོ་ཞིག་གིས་ད་དུང་ཅི་ཡང་ཤེས་ཀྱིན་མི་འདུག་ཨང་།",
    "ཁོས་ཕལ་ཆེར་ཆིག་ལབ་རྒྱག་གིན་པ་ལྟར།",
    "ང་ཚོར་སྒེར་སེམས་ཆེ་རྒྱུ་ཐལ་དྲགས་པ་རེད།",
    "ད་དུང་དྲོད་ལམ་ལམ་གྱི་ཁྱིམ་གཞིས་ཤིག་འདི་ནི་ང་ཚོའི་བདེ་སྐྱིད་རེད་ཡ་ཟེར་ནས་ད་བར་དུ་སེམས་ཁོང་དུ་བསྐུངས་བའི་ཁུར་བོ་མང་པོ་ཞིག་ཕྱིར་ཕུད་པ་ལྟ་བུའི་དངན་པ་རིང་བོ་ཞིག་འཐེན།",
    "ལག་ཟུང་གིས་ཆུང་མའི་མིག་ཆུ་འབྱིད་བཞིན།",
    "ང་ཚོ་ནི་ནམ་ཡང་བྱིས་པ་ཞིག་དང་འདྲ་འདུག་ཟེར།",
    "མཉམ་ཞིག་བཞག་ཚེ་བུ་མོ་གཉིས་ཀྱིས་ཁོང་གཉིས་ཀར་བལྟས་ནས་དགོད་ཀྱིན་ཡོད་པ་རེད།",
    "ཚེ་སྐྱིད་ཕྱི་སྒོར་བུད་དེ་ཕ་བུ་གཉིས་ཀར་སྐྱེལ་མ་བྱས།",
    "དོན་གྲུབ་ཕར་ཙམ་སོང་རྗེས་སླར་ཡང་འདང་ཞིག་བརྒྱབ་རྗེས།",
    "ཁ་ཕྱིར་འཁོར་ཏེ་དོ་དགོང་ང་ཚོས་ཕྱི་རོལ་ནས་ཟ་མ་ཟ།",
    "ང་ཚོ་བཟའ་མི་གང་བོ་མཉམ་འཛོམས་ཀྱི་ཟ་མ་ཞིག་ཟ་ཟེར།",
    "དེ་དག་ཁོ་མོའི་དྲན་འཛིན་གྱི་མཚེའུ་ཡི་ངོས་སུ་ད་དུང་ཡང་གསལ་བོར་ཤར་ཡོད་པ་སྟེ།",
    "གཉེན་སྒྲིག་གི་ཉིན་མོའི་རྨི་ལམ་ལྟ་བུའི་རང་ཉིད་ཀྱི་སྤྲོ་སྣང་རྔ་ཡོད་ཚད་གློག་བརྙན་བཞིན་དུ་ཁོ་མོའི་མིག་ལམ་དུ་རབ་རིབ་ངང་ཤར་བྱུང་།",
    "བ་ཐ་དག་དེ་མ་ཐག་ཏུ་རང་ཉིད་ཀྱི་མིག་མདུན་དུ་མངོན་སུམ་དུ་མངོན་ཡོང་གིན་པ་མ་ཡིན་ནམ།",
    "གང་ལྟར་ཡང་ཁོ་མོས་རང་ཉིད་ཀྱི་ཆུང་ངུའི་དུས་ཀྱི་འཚོ་བ་ནམ་ཡང་བརྗེད་མི་སྲིད།",
    "གུ་དོག་པའི་ལུང་གོག་དང་ཁེར་རྐྱང་གི་གྲོང་ཚོ།",
    "མཛེས་སྡུག་གི་རེ་སྨོན།",
    "ཀྱག་ཀྱོག་གི་རྐང་རྗེས།",
    "ཨ་ཕས་དཔྲལ་གཉེར་བསྡུས་ཏེ་བསམ་བློ་ཡུན་རིང་བཏང་མཐར་ཧ་ཅང་དུང་བའི་མིག་ཟུང་གིས་ངའི་གདོང་ལ་ཞིབ་ལྟ་བྱེད་བཞིན་དེ་རིང་ཁྱོད་ཀྱིས་ཁྱིམ་ནས་ངལ་གསོས་ཤིག་ནོར་རྫིར་འགྲོ་མི་དགོས་ཟེར།",
    "ང་རང་དང་ཐོག་ཅུང་ཟད་ཡིད་མི་ཆེས་པར་གྱུར་ཏེ་ཨ་ཕའི་གདོང་ལ་བལྟས་ཏེ་སྡོད་དགོས་བྱུང་།",
    "ངས་ཨ་ཕའི་མིག་མདངས་དེ་མཐོང་ཐེངས་རེར་སེམས་གཏིང་ནས་སྐད་ཆས་མཚོན་ཐབས་མེད་པའི་བརྩེ་དུང་ཤུགས་དྲག་པོ་ཞིག་ཆུ་རླབས་ལྟར་འཕྱུར་ཡོང་ལ།",
    "ང་རང་མ་སོང་ན་ནོར་རྫི་མེད་པས་ག་ལ་རུང་ཟེར་སྙམ་ཡང་མགྲིན་པ་བརྣངས་པར་གྱུར་ངག་ལས་མ་འཁྲོལ།",
    "སྐབས་དེར་ཨ་ཕས་ངའི་ཕྲག་པར་ཐལ་མོས་རྡེབ་རྡེབ་འགའ་བྱས་ཏེ་དེ་ལྟར་ཐག་གཅོད་བྱས་ཟིན་པའི་བརྡ་བཏང་བ་དང་།",
    "ངའི་སེམས་ལྷོད་དུ་དབབ་པར་བྱ་བའི་ཆེད་དུ་ཡང་བསྐྱར་འཛུམ་ཙམ་བྱས་ཏེ་དེ་རིང་གཅིག་པུར་རྣམ་རྒྱལ་ལ་ནོར་བཅོལ་ཆོག་པ་རེད།",
    "ཁྱོད་རང་སེམས་བདེ་མོས་ཡུལ་དུ་སྡོད་ཅིག་ཟེར་བ་དང་།",
    "དེ་ནས་མ་ཡར་ལ་ལྟ་ཙམ་བྱས་རྗེས་ཡར་ལངས་ཏེ་ལུག་རྫིར་ཆས་སོང་།",
    "དོན་ངོ་མར་ངས་རང་ཉིད་ཀྱི་ཨ་མ་ངོ་མ་དེ་ཅི་འདྲ་ཞིག་ཡིན་པ་མི་ཤེས།",
    "ངས་ཤེས་དུས་ང་ལ་ཨ་མ་མི་འདུག་ལ་ཨ་ཕས་མ་ཡར་ཞིག་གསར་དུ་ཁྲིད་ཡོང་ནས་ཁྱོད་ཀྱི་ཨ་མ་འདི་རེད་ཅེས་པ་དེ་རེད།",
    "དེ་དུས་ད་དུང་ངས་སེམས་གཏིང་ནས་ཨ་ཕར་སྡིགས་མོ་བྱས་ཤིང་།",
    "སྐྱེས་པ་ཚོར་ཅིས་ཀྱང་བུད་མེད་ཅིག་དགོས་དོན་ཅི་ཡིན་ནམ་སྙམ་སྟེ་བསམ་བློ་ཐེངས་མང་བཏང་ཡང་ཧ་ཅི་ཡངི་གོ།",
    "ནམ་རྒྱུན་ངས་ཟ་མ་ཟ་བའི་སྐབས་དག་ཏུ་མ་ཡར་གྱིས་ཧ་ཅང་ལྷད་མེད་པའི་མིག་འོད་ཀྱིས་ང་ཁོ་ནར་ཅེར་འདུག་ལ་དེས་ངས་ཁོ་མོར་ཨ་མ་ཞེས་འབོད་པར་རེ་སྒུག་བྱེད་ཀྱིན་ཡོད་པ་དང་མཚུངས་བས་ངས་མ་མཐོང་བ་ལྟར་བྱས་ནས་བསྡད་པ་ཡིན།",
    "ལྷ་མོ་ནི་དེ་འདྲ་ལེགས་པོ་ཞིག་མ་རེད།",
    "དེ་ནི་ཁོ་མོ་བུད་མེད་ཀྱི་རིགས་ཡིན་པ་ཁོ་ནས་མིན་པར་དེ་ལ་རྒྱུ་རྐྱེན་ཞིག་ཡིན་པ་རེད།",
    "ང་རང་ཉིད་ཀྱི་ལྟ་ཚུལ་ལྟར་ན་བུད་མེད་ཀྱི་རིགས་ལ་ཡིད་སྨོན་སྐྱེས་དོན་མེད་དེ།",
    "ལྷག་པར་དུ་སྐྱེས་ཕོ་རབ་ཅིག་ལ་མཚོན་ན་དེ་འདྲ་ཡིན་པ་རེད།",
    "འདི་ལྟ་བུའི་དཀའ་ཐུབ་ཀྱི་བཟོད་པ་ནི་ངས་ནམ་ཡང་རྒྱུས་ལོན་བྱེད་དཀའ་བ་ཞིག་རེད།",
    "ང་རང་གི་ལྟ་ཚུལ་ལྟར་ན་ཁོ་མོ་ནི་མི་ཕལ་བ་ཞིག་མ་རེད་ལ་ཇི་ལྟར་བྱས་ཀྱང་འཕགས་མ་ཞིག་དང་གཉིས་སུ་མ་མཆིས།",
    "སྔོན་ཆད་ཀྱི་མི་རྣམས་ནི་དེ་འདྲ་ཡིན་པ་རེད་ཟེར།",
    "ཐ་ན་རྩམ་པའང་མི་ཟ་བ་རེད་དམ།",
    "ངས་ཀུ་རེའི་ངང་ཁོ་ལ་དེ་ལྟར་དྲིས།",
    "རྣམ་རྒྱལ་གྱིས་ཧ་ཅང་གདེང་ཚོད་ཡོད་པ་ལྟར་དེ་ལྟར་ཟེར།",
    "ཁོ་ཚོས་ཆུའང་མི་འཐུང་བར་རེད་དམ།",
    "ངའི་སེམས་ལ་ཁོས་ང་ལ་ཀུ་རེ་རྩེ་གྱིན་འདུག་སྙམ།",
    "ཆུའི་ཁྲོད་དུ་ཚེ་སྲོག་ཆུང་ངུ་མང་བ་རེད།",
    "དེ་དག་ང་ཚོའི་མིག་གིས་མཐོང་མི་ནུས་པ་རེད་ཟེར།",
    "ང་ཚོའི་མིག་གིས་མཐོང་མི་ནུས་པ་དེ་ཁྱོད་ཀྱིས་ཇི་ལྟར་མཐོང་ངམ་སྙམ།",
    "ཁྱོད་ཀྱིས་ཉེས་བ་བསགས་སོང་ཟེར་ནས་ང་དང་ཁ་བརྡ་བྱེད་མི་འདོད་པའི་རྣམ་འགྱུར་བསྟན་བྱུང་།",
    "གང་ལྟར་ཡང་ངས་ཁོ་མོའི་དཀའ་ཐུབ་ཀྱི་བཟོད་པ་འདི་ནི་སོ་སྐྱེ་ཕལ་བ་ལས་འདས་པ་སྟེ་འཕགས་མ་ཞིག་ཡིན་པའི་ངེས་ཤེས་རྙེད་བྱུང་།",
    "ཁོ་མོ་ནི་ངེད་ཚང་གི་བཟའ་བཏུང་གི་གཡོ་སྐོལ་མཁན་ཡིན་པར་མ་ཟད་མི་ཕྱུགས་ཡོད་ཚད་ཀྱི་བདག་པོའང་ཡིན་ཏེ།",
    "དུས་རྒྱུན་དོན་དག་གལ་ཆེན་ཡོད་ན་མ་གཏོགས་ངས་ཨ་ཕར་ཁེར་ཐུག་ཏུ་ལབ་གླེང་བྱེད་མི་ཕོད།",
    "ངས་དངོས་གནས་ཁོ་མོས་བྱེད་ཐབས་ཅི་ཞིག་སྤྱད་པ་ཡིན་པ་མི་རྟོགས།",
    "ཁོ་མོ་ནི་དེ་ལྟ་བུའི་རྒྱུ་འབྲས་ཀྱི་དབྱེ་བ་འབྱེད་ཅིང་རང་འདུལ་གྱི་ནུས་པ་ལྡན་པ་ཞིག་ཡིན་པ་དང་།",
    "ཡིན་ན་ཡང་ཁོ་མོས་ཨ་ཕ་ལ་རེ་བ་ཅི་བ་ཞིག་བཏོན་པ་ཡིན་ཚེ་ཨ་ཕས་ངེས་པར་དུ་སྒྲུབ་ངེས་ཡིན་ཞིང་།",
    "གལ་སྲིད་ཁོ་རང་གིས་སྐུ་དངོས་སུ་སྒྲུབ་མ་ཐུབ་ཀྱང་མི་གཞན་ལ་ཆེད་མངགས་ཀྱིས་སྒྲུབ་ཏུ་གཞུག་ངེས་ཡིན།",
    "དེར་མ་ཟད་ཨ་ཕས་དོན་དེ་བསྒྲུབ་མི་འདོད་པའི་སྐབས་ཀྱང་མ་ཡར་གྱིས་ཁོ་ལ་བལྟས་ཏེ་འཛུམ་མདངས་ཅུང་ཙམ་བསྟན་ཚེ་ཁོ་རང་མི་འཐད་ཀྱང་འཐད་པར་འགྱུར་ངེས་རེད།",
    "ལྷ་མོ་དེ་ལས་ལྡོག་སྟེ་བུད་མེད་ཚང་མ་དང་གཅིག་མཚུངས་ཡིན་པས་ང་རང་ཁོ་མོར་ཡིད་སྨོན་མ་སྐྱེས་པ་ཡིན།",
    "ཚང་མས་ལྷ་མོ་ནི་ཧ་ཅང་མཛེས་མ་ཞིག་རེད་ཟེར།",
    "ཚང་མས་ལྷ་མོ་ནི་ལོ་བཅོ་བརྒྱད་ཡིན་པ་རེད་ཟེར།",
    "ཁོ་རང་ལྷ་མོའི་ཕྱོགས་ཀྱི་ཁ་བརྡ་བྱེད་པར་དེ་འདྲ་དགའ་དོན་ཅི་ཡིན་པ་མི་ཤེས་མོད།",
    "ཐ་ན་ཁོ་མོའི་མིང་བརྗོད་པ་ཙམ་གྱིས་ཀྱང་ཁོ་རང་ལ་དགའ་བ་དཔག་མེད་ཅིག་རྒྱས་ཀྱིན་པ་ལྟ་བུའི་སྣང་བ་སྟེར།",
    "དེ་ལས་ཀྱང་ཡ་མཚར་བ་ཞིག་ནི་ཐེངས་ཤིག་ང་ཚོ་ནོར་རྫིར་འགྲོ་དུས་ཁོ་དང་ལྷ་མོ་གཉིས་ནགས་གསེབ་ཏུ་འཛུལ་ཏེ་ཕན་ཚུན་ལ་འོ་བྱེད་ཀྱིན་འདུག་ལ་ཁོང་གཉིས་ཀྱིས་ང་རང་ཕ་རོལ་ཏུ་ཡོད་པ་འང་གཏན་ནས་མཐོང་གིན་མི་འདུག་སྐབས་དེར་ང་རང་ཡང་དེ་གར་སྡོད་མ་བཟོད་པར་རྐང་འཇབ་ལག་འཇབ་ངང་བྲོས་ཏེ་རང་ཉིད་ཀྱིས་ཀྱང་ཁོང་གཉིས་མཐོང་མི་ཐུབ་པའི་གནས་ཤིག་ཏུ་ཕྱིན་ནས་ཡིབ་བསྡད་པ་ཡིན།",
    "ཁྱོད་རང་ངེད་གཉིས་དང་མི་འགྲོགས་དོན་ཅི་ཡིན་ཟེར།",
    "ཁོའི་དོགས་ཟོན་བྱེད་པའི་མིག་མདངས་ལ་བལྟས་ན་ཉེ་འཁོར་དུ་དངོས་གནས་ཧ་ཅང་འཇིགས་སུ་རུང་བའི་གདོན་འདྲེ་ཞིག་གིས་ང་ཚོའི་ཉམས་ཚོད་ལ་རྟོག་གིན་ལོས་ཡོད་སྙམ།",
    "ངས་ཁོ་རང་གི་བཟོ་ལྟར་བལྟས་ནས་བགད་པ་ཡིན།",
    "འདྲེ་གཉིས་རེད་ཅེས་བཤད།",
    "རྣམ་རྒྱལ་གྱིས་གཞི་ནས་ངས་ཁོང་གཉིས་ལ་ཀུ་རེ་རྩེ་བཞིན་ཡོད་པ་ཚོར་ཏེ།",
    "འདྲེ་དེ་གཉིས་ནི་ཁྱོད་ཀྱི་མིག་ཟུང་མ་རེད་དམ་ཟེར།",
    "ལྷ་མོས་ནི་དེ་ལས་ལྡོག་སྟེ་ང་ལ་ཧ་ཅང་མཛའ་བའི་རྣམ་འགྱུར་སྟོན་གྱིན་འདུག་ཁྱོད་ཀྱིས་ཤེས་རྒྱུ་ཞིག་ནི་མཛའ་བ་དང་དགའ་བའི་ནང་དོན་གཅིག་པ་མ་རེད།",
    "དེ་དག་ཁོ་མོ་དང་འབྲེལ་བ་ཅི་ཞིག་ཡོད་དམ།",
    "ལྷ་མོས་དོན་དག་ཅི་ཞིག་བྱུང་སོང་བ་མ་ཤེས་པར་ཐེ་ཚོམ་གྱི་མིག་མདངས་ཀྱིས་ང་ལ་བལྟས་ནས་སྡོད།",
    "ངས་ཁོང་ཁྲོ་དང་བཅས་ཁོ་མོར་ར་མ་རེའུ་ལྕོག་གི་སྟེང་དུ་འབུ་ཡོད་པ་ཁྱོད་ཀྱིས་མཐོང་མ་མྱོང་ངམ་ཞེས་སྤྱོས་བཞིན་ཕར་བརྒྱུགས་པ་ཡིན།",
    "འོན་ཀྱང་སྐབས་དེར་མ་ཡར་གྱིས་ཨ་ཕ་ལྟར་ཡིད་མི་དགའ་བའི་མདངས་བསྟན་མ་བྱུང་།",
    "དེ་ལས་ལྡོག་སྟེ་ཁོ་མོའི་འཕགས་མ་ལྟ་བུའི་འཛུམ་མདངས་དེ་སྟོན་བཞིན་ང་ལ་ཚོད་བགམ་པའི་ཚུལ་གྱིས།",
    "ལྷ་མོ་དེ་འདྲ་ཡག་པོ་ཡོད་པས་ཁྱོད་ལ་ཆུང་མར་མི་དགོས་དོན་ཅི་ཡིན་ཟེར་ནས་ཨ་ཕའི་གདོང་ལ་ལྟ་བར་བྱེད།",
    "ཁོ་མོའི་བཟོ་ལྟ་དེས་ཨ་ཕའི་རྣམ་འགྱུར་ལའང་འགྱུར་ལྡོག་འབྱུང་དུ་བཅུག་སྟེ་ཅུང་ལྷོད་བག་ཅན་དུ་གྱུར་སོང་།",
    "དེ་བས་ངའི་སྤོབས་པའང་ཇེ་ཆེར་རྒྱས་སོང་།",
    "ངའི་སྐད་ཆ་དེ་ཐོས་པས་ཨ་ཕ་དང་མ་ཡར་གཉིས་ཀྱིས་བཟོད་བསྲན་བྱེད་མ་ཐུབ་པར་བགད་དེ་བརྒྱལ་ལ་ཁད་བྱས་སོང་།",
    "ཡིན་ན་ཡང་མི་རོ་རྩེ་སྒྲུང་ཁྲོད་ཀྱི་མི་ཡི་ལུས་ལ་བ་གླང་གི་མགོ་བོ་ལྡན་པའི་མ་སང་ཡ་རུ་ཁ་ཁྲ་ལ་ང་རང་ཧ་ཅང་དགའ་བ་ཡིན།",
    "རྣམ་རྒྱལ་ནི་ལྷ་མོ་གླེང་བར་དགའ་བ་ལས་གཞན་ད་དུང་ནམ་རྒྱུན་ང་ལ་མི་རོ་རྩེ་སྒྲུང་གི་གཏམ་རྒྱུད་འཆད་རྒྱུར་ཡང་ཧ་ཅང་དགའ།",
    "གྲོགས་པོ་ཁྲེལ་མེད་ཚོས་གཡོ་ཐབས་སྤྱད་ནས་དོང་ནང་དུ་འགྲོ་རུ་བཅུག་རྗེས་ཕྱིར་མ་བླངས་པ་རེད།",
    "དེར་ཁྱོད་རང་ཁོང་ཁྲོ་མི་ལངས་སམ།",
    "ལན་རེར་ང་རང་ནོར་རྫིར་ཕྱིན་ཏེ་ནགས་ཚལ་སྟུག་པོའི་ཁྲོད་དུ་གཅིག་པུར་འགྲོ་དུས་མདུན་དུ་བདུད་མོ་ཨེ་ཡོད་དམ་སྙམ་ནས་སྐྲག་འོང་མོད།",
    "ཡིད་ཆེས་དེ་ཁོ་ནས་ང་རང་གཅིག་པུ་ནགས་གསེབ་ཏུ་འགྲོ་ཕོད་པའི་སྤོབས་པ་བསྐྱེད་ཡོང་བར་མ་ཟད་ང་རང་བདུད་མོར་འཕྲད་ཨེ་ཡོང་བའི་སྐྲག་སྣང་དེ་ཡང་རྩ་བ་ནས་མཐར་སྐྲོད་བཏང་འགྲོ་བ་རེད།",
    "གང་ལྟར་མི་བཟང་པོ་དག་གིས་གྲོགས་པོ་ལ་ཁྲེལ་མེད་བྱེད་མི་སྲིད་པ་བཞིན་དུ་རྣམ་རྒྱལ་གྱིས་ཀྱང་ང་ལ་ཁྲེལ་མེད་བྱེད་མི་སྲིད་ལ་ངས་ཀྱང་རྣམ་རྒྱལ་ལ་ཁྲེལ་མེད་བྱེད་མི་སྲིད།",
    "ད་དུང་མགོན་སྐྱབས་དང་ལྷ་མོ་གཉིས་ཀས་ཀྱང་ང་ལ་ཁྲེལ་མེད་ཀྱི་ལས་ཅི་ཡང་བྱེད་མི་སྲིད།",
    "རེད་ལགས།",
    "གལ་ཏེ་མི་ཚང་མས་མཛེས་པ་དག་བདམ་བསལ་བྱས་པ་ཡིན་ན་མི་མཛེས་བ་དག་ཅི་ཞིག་བྱེད་དགོས་ཟེར་ནས་ང་ལ་རྒྱབ་སྐྱོར་བྱས་སོང་།",
    "སྐབས་འདིར་ངའི་སེམས་སུ་སླར་ཡང་ཁོ་མོ་འཕགས་མ་ཞིག་ཡིན་པའི་ཚོར་སྣང་སྐྱེས་བྱུང་།",
    "ཨ་ཕ་དགོད་ཙམ་བྱས་ཏེ།",
    "མཛེས་པ་ལ་བསྙེགས་པ་ནི་མི་ཡི་རང་གཤིས་ཡིན་པ་རེད་ཟེར་ནས་མ་ཡར་ལ་མ་རབས་ཀྱི་མིག་མདའ་ཞིག་འཕངས་སོང་།",
    "ངས་བལྟས་ན་ལྷ་མོའི་སྟེང་དུ་མཛེས་པ་ཅི་ཡང་མི་འདུག་ཅེས་བཤད།",
    "ནོར་དེད་ནས་ཕྱིར་ལོག་ཡོང་བའི་ལམ་བར་དུ་ངས་མགོན་སྐྱབས་ལ་དོན་ངོ་མར་བདུད་མོ་ཟེར་བ་ཞིག་ཡོད་པ་ཨེ་རེད་ཅེས་དྲིས་པ་ན།",
    "སྔོན་ཆད་ཡོད་ཀྱང་སྲིད་མོད་ད་ལྟ་ཡོད་པ་ཐོས་མ་མྱོང་།",
    "གལ་ཏེ་ཡོད་པ་ཡིན་ན་ང་རང་ནར་སོན་ཚེ་མ་སངས་ཡ་རུ་ཁ་ཁྲ་ལྟར་བདུད་མོ་ཐག་པས་བཀྱིགས་ཆོག་པ་རེད།",
    "འོ་ན་འཕགས་མ་ཡོད་པ་རེད་དམ་ཞེས་དྲིས།",
    "ཕལ་ཆེར་ཡོད་རྒྱུ་རེད།",
    "ཚང་མས་མི་བཟང་པོ་དག་འཕགས་མ་དང་འདྲ་ཟེར་གྱིན་པ་མ་རེད་དམ་ཟེར།",
    "འཕགས་མ་ནི་མ་གཞི་ནས་ཡོད་འོས་པ་ཞིག་ཡིན་པ་རེད།",
    "འོ་ན་བདུད་མོ་ཟེར་བ་ནི་མི་ངན་པ་ལ་ཟེར་བ་ཨེ་ཡིན་ནམ་ཞེས་དྲིས་པ་ན་ཁོས་ཀྱང་ཕལ་ཆེར་ཡིན་པ་འདྲ་ཟེར།",
    "ལུས་བྱད་ཡ་མ་གཟུགས་ཡིན་ལ་ཆོ་འཕྲུལ་སྣ་ཚོགས་འཛོམས་པའི་གཏུམ་སྤྱོད་ཅན་ཞིག་ཡིན་པ་རེད།",
    "མཇུག་མཐར་ངའི་སེམས་ལ་ལྷ་མོ་དྲན་བྱུང་།",
    "ངས་མགོན་སྐྱབས་ལ་ལྷ་མོ་མཛེས་པོ་འདུག་གམ་ཞེས་དྲིས་པ་ཡིན།",
    "ཁྱོད་ཀྱིས་མཛེས་པར་སྙམ་ན་མཛེས་པ་རེད།",
    "དེ་བས་ངས་ཀྱང་ལྷ་མོ་དང་ངེད་གཉིས་ཀྱི་དོན་དག་དེ་མི་གཞན་དང་འབྲེལ་བ་ཅི་ཡང་མེད་ཤེས་སོང་།",
    "ཕལ་ཆེར་རྣམ་རྒྱལ་ནི་ལྷ་མོ་ལ་དགའ་བཞིན་ཡོད་པ་དང་འདྲ་ལ་ཁོས་ནི་ལྷ་མོའི་མཛེས་པ་དེ་གང་ཞིག་ཏུ་ཡོད་པ་རྟོགས་སོང་བ་དང་འདྲ།",
    "གང་ལྟར་ཁོང་གཉིས་ལྷན་དུ་ཡོད་དུས་ངའི་རྣ་བར་གཟན་པའི་དགོད་སྒྲ་དེ་རྒྱུན་མི་ཆད་པར་ཐོས་འོང་མོད་ངས་མི་དགའ་བའི་རྣམ་འགྱུར་ཅི་ཡང་བསྟན་མ་མྱོང་།",
    "ལྷ་མོ་ངེད་བཞི་བོས་ནོར་ཁྱུ་དེད་དེ་རི་མགོ་ལ་སོང་ཞིང་།",
    "རི་མགོ་ནས་ནོར་ཁྱུ་རང་སར་བཀྲམ་རྗེས་མི་གཉིས་རེ་ཚན་པ་རེ་བྱས་ཏེ་ནོར་ཁ་ལེན་རེས་ཀྱི་རྩེད་མོ་རྩེས་པ་ཡིན།",
    "རྣམ་རྒྱལ་ནི་ང་ཚོའི་ཁྲོད་ཀྱི་ལོ་ན་ཆེ་བ་ཡིན་པས་རྩེད་མོ་ཅི་ཞིག་རྩེ་རྒྱུ་བཀོད་སྒྲིག་བྱེད་མཁན་དང་མི་སྣ་བགོ་འགྲེམ་བྱེད་མཁན་ཡང་ཡིན་པས།",
    "རྩེད་མོ་རྩེ་བའི་དུས་སུ་རྣམ་རྒྱལ་གྱིས་བསམ་བློ་བཏང་ཡོད་པ་རེད།",
    "ཁོང་གཉིས་ཀྱིས་དྲི་བ་བཏོན་པ་ཐམས་ཅད་ལ་ལྷ་མོ་དང་ངེད་གཉིས་ཀྱིས་འདང་མ་བརྒྱབ་པར་དེ་མ་ཐག་ཏུ་ལན་འདེབས་ཐུབ་པ་བྱུང་ཚེ།",
    "ལྷ་མོས་ངས་ཅི་ཟེར་ལ་བལྟས་འདུག་པས་ངས་ཀྱང་ཐེ་ཚོམ་མེད་པར་ཁས་ལེན་བྱས་པ་ཡིན།"
  ]
}