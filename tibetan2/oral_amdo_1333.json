    "སྟབས་ལེགས་ཏེ་ད་ཐེངས་རང་ཉིད་ཀྱིས་ཚོར་རྟོགས་བྱུང་སོང་བས་ཁོ་ལ་ངོས་ཟིན་གསལ་བོ་ཞིག་ཐོབ་ཏུ་འཇུག་སྲིད་སྙམ།",
    "ཁོ་མོས་དེ་ལྟར་བསམ་བཞིན་གདོང་གི་ཤ་སྐྱིའི་གཏིང་རུམ་ནས་ཧ་ཅང་ཡིད་ཚིམ་པའི་འཛུམ་ཞིག་མངོན་བཔར་གྱུར།",
    "ཁྱོད་གཉིས་ནི་བྱིས་པ་རྩེད་ཀྱིན་པ་ཡིན་ནམ།",
    "ད་བར་དུ་རྩོད་རྒྱུ་ཅི་ཡང་མེད་ཀྱང་ད་ནི་བུ་མོ་གཉིས་ཀ་ནར་སོན་པའི་སྐབས་འདིར་ད་ནི་འུར་རྒྱག་རྒྱུ་ཅི་ཞིག་ཡོད་དམ་ཟེར།",
    "ཁོ་མོ་དལ་དལ་ངང་འབོལ་ཁྲིའི་སྟེང་ཕྱིར་བསྡད་ཅིང་བསམ་གཞིགས་ཀྱི་ཀློང་དུ་འཁྱམས་པར་གྱུར།",
    "གལ་ཏེ་དོན་གྲུབ་དང་ཁོ་མོའི་བར་དུ་དངོས་གནས་འབྲེལ་བ་དེ་འདྲ་ཞིག་ཡོད་ཚེ་ཁོ་མོ་དང་ཤི་འཛིང་རོ་འཛིང་བྱས་ཏེ་ཕྱིན་ཆད་ཁྱོ་གའི་གམ་དུ་འགྲོ་མི་ཕོད་པ་ཞིག་ཏུ་གཏོང་རྒྱུ་དེ་རེད།",
    "འོན་ཀྱང་དོན་དག་དེ་འདྲ་ཞིག་མེད་པ་ཡིན་ན་རང་ཉིད་ཀྱིས་ཁྱོ་གའི་གདོང་སྨད་པ་ཡིན་པར་མ་ཟད་མི་ཚེ་ལ་ངོ་ཚ་བཞག་པ་ཡིན་པས་ཅི་བྱའམ།",
    "ཁོ་མོ་ཐེ་ཚོམ་གྱི་ཁྱོགས་སུ་འཕྱང་ནས་རེ་ཞིག་ཅི་ཞིག་བྱེད་དགོས་པའང་མི་ཤེས་པར་གྱུར།",
    "ཁོ་མོས་དོན་གྲུབ་ཕྱིར་ཐོན་པ་རེད་སྙམ་ནས་དགའ་དྲགས་ཏེ་མྱུར་མོར་སོང་སྟེ་སྒོ་ཕྱེ་བ་ན།",
    "ཁ་གཏད་དུ་ལངས་འདུག་པ་ནི་རྒྱ་མོ་སྐྱིད་ཡིན་པས་ཁོ་མོའི་སེམས་དེ་འཕྲལ་འཁྱག་པར་གྱུར་བ་དང་ལྷན་དུ་རྒྱ་མོ་སྐྱིད་ཀྱི་ངོ་ལ་ལྟ་བའི་སྤོབས་པའང་མེད་པར་གྱུར།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་དེ་ལྟར་ཟེར་བཞིན་ལག་ནང་གི་ཐིག་སླ་ཞོར་དུ་ཁྱིམ་ནང་དུ་ཡོང་ལོབས་ཕྱོགས་ལྟར་འབོལ་ཁྲིའི་ཟུར་ཞིག་ཏུ་བསྡད།",
    "ཉིན་འདི་འགར་མགོ་བོ་ན་ཡིན་འདུག་པས་སྒོ་ཕྱིར་འབུད་མི་འདོད།",
    "རྒྱ་མོ་སྐྱིད་དེ་མུར་བྲེལ་བ་ལངས་ནས།",
    "རྒྱ་མོ་སྐྱིད་ནི་བུད་མེད་གྲུང་པོ་ཞིག་ཡིན་པས།",
    "ཨ་ཙི་བླུན་མ་འདིས་ཅི་བྱེད་ཀྱིན་འདུག་ཁྱོད་ཀྱིས་འདི་ལྟར་བྱས་ན་ཁོ་མོའི་འདོད་ཐོག་ཏུ་རྟ་བརྒྱུགས་པ་མ་རེད་དམ་ཅེས་ཟེར།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་ཁོ་མོའི་སྐད་ཆའི་ཧ་མ་གོ་བར།",
    "ཇི་ལྟར་ས་འཕྱར་རྡོ་འབུད་བྱེད་དམ་ཟེར་ནས་ཁོ་མོའི་གདོང་ལ་ཅེར་ནས་བལྟས།",
    "གལ་ཏེ་དོན་དག་དངོས་ནས་དེ་འདྲ་ཞིག་ཡིན་ཚེ་ཁོ་མོ་དང་ཤི་འཛིང་རོ་འཛིང་ཞིག་བྱས་ཏེ་ཕྱིན་ཆད་དོན་གྲུབ་ལ་ལྟ་མི་ཕོད་པ་ཞིག་བཟོ་རྒྱུ་ཡིན།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་ཁོ་མོའི་སྐད་ཆ་དེར་འདང་ཞིག་བརྒྱབ་རྗེས།",
    "ཚེ་སྐྱིད་ཀྱིས་ལྷ་མོ་སྒྲོལ་མ་བྱིས་པ་ཁང་དུ་བསྐྱལ་ནས་ཕྱིར་ཡོང་དུས་རྒྱ་མོ་སྐྱིད་ཀྱང་ལམ་ལ་ལངས་ཏེ་ཁོ་མོར་བསྒུགས་ནས་བསྡད་ཡོད་པ་རེད།",
    "ཁོང་གཉིས་ཀྱིས་ཀླུ་མོ་སྒྲོལ་མ་དེ་གའི་རྒྱ་མོ་སྐྱིད་ཀྱི་ངོ་ཤེས་རྒན་མོ་ཞིག་ལ་བཅོལ་བ་ན།",
    "རྒན་མོ་དེས་ཁྱོད་གཉིས་གང་ལ་འགྲོ་རྒྱུ་ཡིན་ཞེས་དྲིས་བྱུང་བས།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་ངེད་གཉིས་ལ་དོན་དག་ཅིག་བསྒྲུབ་རྒྱུ་ཡོད་ཅེས་བཤད།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་དུས་ཚོད་མང་པོ་འགོར་མི་སྲིད་ཟེར།",
    "ལམ་ལ་ཆས་རྩིས་བྱེད་དུས་རྒྱ་མོ་སྐྱིད་ཀྱིས་སེམས་ལ་ཅི་ཞིག་དྲན་པ་ལྟར།",
    "ངེད་གཉིས་ལ་ད་དུང་ལག་ཆ་ཞིག་ཀྱང་དགོས་པ་རེད་ཟེར།",
    "རྡུང་རེས་བྱེད་ན་ལག་ཆ་མེད་ན་ག་ལ་ཆོག་རྒྱ་མོ་སྐྱིད་ཀྱིས་ཧ་ཅང་ཉམས་མྱོང་ཡོད་པའི་ཚུལ་གྱིས་འདང་ཞིག་བརྒྱབ་ནས་རེད།",
    "ངེད་གཉིས་མི་གཉིས་ཡོད་པས་ཐོག་མར་ཁོ་མོ་བསྡམས་བཀྱིགས་བྱེད་དགོས།",
    "བསྡམས་བཀྱིགས་བྱས་ཏེ་གཅར་རྡུང་བྱས་ན་ཁོ་མོ་ངུ་བ་ལས་ཐབས་ཡོད་པ་མ་རེད།",
    "དེ་ལྟར་བྱས་ནས་གཅར་རྡུང་བྱས་ན་གཅིག་ནས་ཁོ་མོར་ངོས་ཟིན་ཐོབ་ཐུབ་པ་རེད་ལ་གཉིས་ནས་ང་ཚོའི་སཕེ་སྡང་ཡང་དྭངས་ཐུབཔ་རེད་ཟེར།",
    "ཁོ་མོ་གཉིས་ཀས་གྲ་སྒྲིག་ཡོད་ཚད་ཚགས་སུ་ཚུད་པར་བྱས་ནས་ལག་ཆ་དག་རྒྱབ་ཁུག་ནང་དུ་བཅུག་རྗེས་གཞི་ནས་ལམ་ལ་ཆས།",
    "ཁོ་མོ་གཉིས་ཡུལ་ནས་ཡོང་དུས་དཔའ་སྟོབས་སྟག་ལྟར་ཆེ་བ་ཡོད་ཀྱང་ཐག་ཉེར་སླེབས་ཀྱིན་སླེབས་ཀྱིན་རྒྱབ་ལ་རྡོ་ལོག་ཅིག་ཁུར་ཡོད་པ་ལྟར་རྐང་བ་ཇེ་ལྗིད་དུ་གྱུར།",
    "ཐ་ན་གཞུང་སྒྲུབ་ཐོག་ཁང་གི་སྒོ་ཁའི་ཐེམ་སྐས་ལ་འགོ་དུས་ཀྱང་ཚེ་སྐྱིད་ཨེན་ཙམ་གྱིས་ས་རུ་འགྱེལ་སོང་བ་རེད།",
    "སྒོ་ནང་དུ་འཛུལ་མ་ཐག་མི་ཞིག་ཕྱིར་ཡོང་བ་དང་འཕྲད་པས་ཚེ་སྐྱིད་ཀྱིས་སྐད་དམའ་མོས་ལྕགས་མོ་ཐར་གྱི་གཞུང་ལས་ཁང་གང་རེད་ཅེས་དྲིས་པ་ན།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་མྱུར་མོར་དག་བཅོས་བྱས་ཏེ་རྩ་འཛུགས་པུའུ་ཡི་གཞུང་ལས་ཁང་གང་རེད་ཅེས་དྲིས་པས།",
    "གཡོན་གྱི་གྲུ་གའི་ནང་དུ་ཡོད་པ་དེ་རེད་ཟེར།",
    "རྒྱ་མོ་སྐྱིད་ཀྱིས་འོ་ན་ང་འགྲོ་ལ་ཁོ་མོ་ཕྱིར་བོས་ཏེ་ཡོང་།",
    "སྐད་ཆ་ཁྱོད་ཀྱིས་དྲིས་ཤིག་ཟེར།",
    "རྒྱ་མོ་སྐྱིད་ལ་འཛེམ་དོགས་ཅི་ཡང་མེད་པར་སྐས་ཐོག་ནས་ཡར་འཛེགས་ཏེ་སོང་།",
    "ཁོ་མོའི་སེམས་ལ་འདི་གར་སྐད་ཆ་འདྲི་མི་བདེ་བས་ཕྱི་རོལ་གྱི་མི་མེད་ས་ཞིག་ཏུ་འཁྲིད་དགོས་སྙམ་བཞིན་ཁོང་གཉིས་མིག་མདུན་དུ་མངོན་ཡོང་བར་བསྒུགས་ནས་བསྡད།",
    "ཁོ་མོ་མྱུར་མོར་ཕར་སོང་སྟེ་དོན་དག་ཅི་འདྲ་རེད་ཅེས་དྲིས།",
    "རྒྱ་མོ་སྐྱིད་ཀྱི་ངོ་མདངས་སྐྱ་བོར་གྱུར་ཏེ།",
    "ཚེ་སྐྱིད་ཀྱིས་དོན་དག་ཅི་ཞིག་བྱུང་སོང་བ་མ་ཤེས་བས་སྔར་བས་ཀྱང་བྲེལ་འཚབ་ལངས་ཏེ་ཁོ་མོའི་སྔུན་བཀག་ནས་འགྲོ་རུ་མ་བཅུག་པར་ཁྱོད་ཀྱིས་དྲང་བོར་ཤོད་དང་།",
    "དོན་ངོ་མར་དོན་དག་ཅི་ཞིག་བྱུང་སོང་ཞེས་དྲིས་ནས་མ་གློད་པས་རྒྱ་མོ་སྐྱིད་ཀྱང་ཐབས་ཟད་པར་གྱུར།",
    "ཁོ་མོས་ཚེ་སྐྱིད་ཀྱི་ངོ་ལ་བལྟ་མི་ཕོད་པར་ཅུང་ཐོགས་བཞིན་དུ།",
    "ད་ལྟའི་ཁོ་མོའི་སེམས་ཁམས་ནི་ཅི་ཞིག་གིས་ཀྱང་མཚོན་ཐབས་མེད་པ་ཞིག་རེད་ལ་ཐ་ན་ཁོ་མོ་རང་ཉིད་ཀྱིས་ཀྱང་སྨྲ་མི་ཤེས་པ་ཞིག་རེད།",
    "ཁོ་མོས་ཤེས་པ་ཉག་གཅིག་ནི་རང་ཉིད་ཀྱིས་ད་ཐེངས་ཀྱི་དོན་དག་འདི་ལ་ཁ་གཏད་ཇི་ལྟར་གཅོག་པའི་ཐད་ཐབས་བཀོད་ལེགས་པོ་ཞིག་བཙལ་དགོས་པ་དེ་རེད།",
