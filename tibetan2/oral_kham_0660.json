    "གསེར་ཐོག་ལ་སེང་གཅིག་གདའ་བ་རྨིས།",
    "སེང་ཐོག་ལ་རྫ་གཅིག་གདའ་བ་རྨིས།",
    "ང་རང་རྒྱལ་པོ་བདེ་སྤྱོད་བཟང་པོ་ཡིན།",
    "པགས་པ་རྣམས་བཤུས་ནས་གོས་བྱས་པས་སྔར་བས་ཚོ་ཞིང་མདངས་དང་ལྡན་པར་འདུག་ཁོ་དེ་ནས་བཏོན་ཏེ་རྒྱལ་པོའི་སྐུ་མདུན་དུ་ཁྲིད་དོ།",
    "དེ་རྣམས་ཁུར་ནས་ལ་ཆེན་པོ་བརྒལ་བ་ན་མཚོ་ཆེན་པོ་གཅིག་འདུག་དེའི་འགྲམ་ན་དཀར་གོང་ལུག་ཙམ་ཞིག་འདུག་པའི་འགྲམ་དུ་ཉལ་བ་དང་།",
    "སྣ་རྡོག་རྩེ་ལ་དྲུད་པ་ཞིག་འདུག་པ་དེ་ལ་ཞགས་པ་འཕངས་ཏེ་ཟིན་ནས་ཚུར་འཐེན་པས།",
    "ལུས་ལ་དར་ཚོན་སྣ་ལྔའི་གོས་གྱོན་པ་ཞིག་འདུག་གོ།",
    "མིག་བཙུམས་པས་ཁྱི་དང་ཁོ་རང་གཉིས་མཚོ་ཁར་སླེབས།",
    "གཞན་ཡང་སྲོག་ཆགས་པའི་འབུ་སྲིན་ཚང་མས་མཁར་ལས་བྱེད་ཀྱིན་འདུག་གོ།",
    "ཕྱིའི་ར་བ་རྣམས་རྟ་གླང་བ་ཕྱུགས་ལ་སོགས་པས་ཁེངས་འདུག་གོ།",
    "དེ་ལས་འཇིགས་པ་བྱང་ཁམས་ན་འབྲོང་ཁྱུ་ལྡིང་བ་ཡང་འདུག་ཟེར།",
    "ཁོ་རང་ལ་གོས་ཁྱད་དུ་འཕགས་པ།",
    "རྟ་མགྱོགས་པོ་འདུག་གམ་བྱས་པས།་",
    "སྒྲོམ་བུ་གྲུ་བཞི་མ་ཞིག་འདུག་པ་དེ་རྒྱབ་ཏུ་ཁུར་བ་དང་སྣ་ས་ལ་མ་ཐུག་ཙམ་བྱས་ནས་འཁུར་དགོས་པའི་ལྗིད་ཚད་ཆེན་པོ་ཞིག་བྱུང་བས།",
    "རྒྱལ་པོས་དམག་འདྲེན་པ་འདུག་བྱས་པས།",
    "མང་ཉུང་འདུག་གམ་ཟེར།",
    "ཉི་མ་དང་ཟླ་བའི་སྟེང་ན་འདུག་པ་དང་།",
    "རྨི་ལམ་ཟིན་པ་ན་བདག་འདུག་པའི་གནས་ནི་འདིའོ།",
    "སུམ་རྨི་ལམ་ཆེན་པོ་འདི་ཉིད་ཀྱིས་ཤི་སྣང་རང་བཞིན་མེད་པ་ཉིད་དུ་གཏན་ལ་ཕབ་སྟེངེས་པའི་ཤེས་པ་མཐུ་བརྟས་པར་བྱའོ།",
    "མེ་ཡི་ཁྱི་ཕག་ནག་དུས་ལོ་བཅུ་གཉིས་།",
    "རང་རང་ནང་ཕྲད་ཚེ་བུ་བུ་གཅོད་འདྲེ།",
    "རང་རང་ལུས་ཀྱི་ཁ་དོག་དང་མཐུན་པའི།",
    "ཁབུ་བག་གཉིས་སོ་སོར་ཕ་ལོ་དང་མ་ལོ་ནས་དབུག་བླངས་ནས་རང་རང་སྐྱེས་ལོ་ལ་སྤྲད་དར་རྒུད་ལུས་རྫོགས་བཙས་པ་ཁྲུས་བྱེད་དང་།",
    "སོ་སོའི་མ་དེར་རང་རང་སྐྱེས་ལོའི་གྲངས།",
    "ལོ་ཟླ་ཞག་དུས་བྱ་སྤྲེལ་གང་རུང་དང་འདོམས་ན་བྱེ་བྲལ་ཡོང་།",
    "མནན་པའི་མན་ངག་རང་རང་ཐོད་པའི་ནང་།",
    "ལིངྒ་མིང་རུས་རང་རང་མགོ་བོ་ཅན་།",
    "ལོ་དང་ལོག་མིན་གནམ་ལོ་ཟླ་ཞག་དུས།",
    "༥ དུས་ཚོད་རང་རང་སྐྱེས་པའི་དུས་དང་ནི།",
    "ཀླུ་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་རྗེས་གནང་བཅས་ལ།",
    "༥ འཇམ་དཔལ་ཚེ་བདག་ནག་པོའི་ལས་མཐའ་ཡང་བཟློག་མེའི་སྤུ་གྲིའི་ལས་བྱང་རང་གཤེད་དབབ་པ་རྡོ་རྗེ་ཕ་ལམ་ལ།",
    "ཡང་བཟློག་མེའི་སྤུ་གྲིའི་དྲག་པོའི་སྦྱིན་སྲེག་དུས་ཀྱི་བྱིན་ཟའི་ཕུང་པོ་ལ།",
    "སྐུ་ཚེ་སྨད་དུ་བཀྲ་ཤིས་ལྷུན་པོའི་ཐོས་བསམ་གླིང་དུ་བཞུགས་འདུག་མཛད་རྣམ་མེད་པས་ཞིབ་ཆ་འབྲིར་མ་སྤོབས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དམར་སེར་ས་ལུགས་ལ།",
    "སྔ་འཕྲོས་ཁོ་རང་གོང་མའི་འཕྲིན་ལས་ཀྱི་སྟབས་ལི་ཐང་ཕྱོགས་སུ་འབུལ་སྡུད་ལ་ཕེབས།",
    "དགུང་ལོ་དོན་ག་ཅིག་བར་རང་རྣམ་འདི་བརྩམ་འདུག་དགུང་ལོ་ཇི་བཞུགས་ངེས་གཏན་མི་གསལ།",
    "ཁོང་དགུང་ལོ་བརྒྱད་ཅུ་ཙམ་བཞུགས་འདུག་རྗེ་འདིའི་མཛད་རྣམ་ཞིབ་པ་མ་མཇལ།",
    "རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཨ་ར་པ་ཙ་ན་དང་འབྲེལ་བའི་མཆོད་ཆོག་ཤེས་རབ་ཉིན་བྱེད་འདྲེན་པའི་ཤིང་རྟ་ལ།",
    "ཁོང་སྐུ་ཚེ་སྨད་དུ་ལྷ་ལྡན་ཀུན་བདེ་གླིང་དུ་བཞུགས་འདུག་མཛད་རྣམ་མ་རྙེད་པས་ཞིབ་ཆ་མ་འཁོད།",
    "འདི་ལས་དཔེ་ཅན་མཛེས་མའི་ཞལ་རས་དང་དཔེ་ཟླ་བ་གཉིས་གནས་གཞི་ཐ་དད་པའི་ཁྱད་པར་ཙམ་ལས་ཁྱད་པར་གཞན་མང་དུ་འདུག་ཀྱང་མེད་ཅེས་འུད་ཆེན་པོས་དཔེ་ཅན་ཕུལ་བྱུང་བར་བརྗོད་ཡོད་དོ།",
    "དཔེ་དོན་གཉིས་ལས་དོན་ལ་སྐྱོན་མེད་ཕྱིར་དཔེ་ལས་ཁྱད་དུ་འཕགས་པར་བསྟན་འདུག་གོ་དོན་གྱི་དཔེར་བརྗོད་ལ་བོད་མཁས་པས།",
    "དཔེ་ལས་དཔེ་ཅན་ཁྱད་འཕགས་ཡིན་པ་བསྟན་འདུག་དེའི་མཚན་གཞི་དཔེར་བརྗོད་ལ་རྩ་བ་ལས།",
    "འཇོམས་པར་བྱེད་པ་ཡང་འདྲ་ཕྱིར་དེ་གཉིས་མཚུངས་པ་དངོས་ཤུགས་གཉིས་ཆར་གསལ་བར་བསྟན་འདུག་མེལ་ཚེ་ཞེས་པ་ནི་སྲུང་བ་བྱེད་པའི་བྱ་བའི་མིང་ཡིན་ལ།",
    "འདི་གཉིས་ལ་ཁྱད་པར་ཆེན་པོ་འདུག་གོགོ་དོན་གྱི་དཔེར་བརྗོད་ལ་བོད་མཁས་པས།",
    "དེ་ནི་ལོས་ཡིན་ཏེ།",
    "འཁོན་དུ་འཛིན་དགོས་པའི་རྒྱུ་གང་ཡང་མེད་ཀྱང་རང་བཞིན་ཉིད་ཀྱིས་དཀར་གསལ་ཟླ་བ་ལ་འགྲན་ཟླ་བྱེད་ཅིང་ཟླ་བའི་དགྲར་གྱུར་པ་དང་།",
    "ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པས་སྙན་ངག་གསལ་བར་བྱེད་པའི་བསྟན་བཅོས་དབྱངས་ཅན་ཞལ་ལུང་ཉི་མ་འབུམ་གྱི་འོད་ཅན་དུ་རྒྱན་འདི་ལ་སྙན་ངག་མཁན་གྱི་བདོག་པའི་མཆོག་གཅིག་པུ་ཞེས་བསྔགས་བརྗོད་ཀྱི་མེ་ཏོག་ཕུལ་འདུག་རྒྱན་འདི་དང་རྟོག་པའི་མཚོན་ཐབས་གཉིས་ལ་འདྲ་ས་དང་མི་འདྲ་ས་མང་དུ་འདུག་པ་དང་།",
    "ཞེས་གསུངས་འདུག་འདི་གཉིས་ལས་གང་ཡིན་པ་ལ་དཔྱོད་ལྡན་རྣམས་ཀྱིས་དཔྱད་པར་འཚལ།",
    "དེའི་ཁར་ནུ་མའི་ངོས་སུ་སྐྱེས་པའི་སེན་རྗེས་གསར་བ་བབས་འདུག་པ་མཐོང་ནས་དགོད་བྲོའི་འགྱུར་བ་འཕེལ་བ་དང་།",
    "ཤིན་ཏུ་སྙན་པའི་ཕུང་པོར་གྲུབ་འདུག་ཤེས་པར་ལྡན་པ་མཛེས་ཤིང་མཁས་ལ་གསལ།",
    "དཀའ་ཉེན་ཆེ་སར་ག་དུས་ཡིན་ནའང་།",
    "བ་ཞིག་ཏུ་གསར་གཏོད་བྱེད་དགོས་པར་འདུག་བོད་ཀྱི་རྩོམ་རིག་གསར་རྩོམ་གྱི་ལག་ལེན་ལ་གཞིགས་ན་རྩོམ་རིག་གསར་རྩོམ་གྱི་སྤུས་ཚད་།",
    "ང་རང་རྒན་རྒོན་རྣམས་ཉི་མར་ལྡེ་སའི་འཕར་བ་དང་།",
    "ཐབས་ཟད་ནས་ལག་མགོ་མཆན་འོག་ཏུ་བཅུག་ནས་འདུག་པ་ལས་ཐབས་གཞན་མ་རྙེད།",
    "ང་ལའང་དེ་འདྲའི་དོགས་པ་ཞིག་འདུག་རྒན་རྒོན་རྣམས་ཀྱིས་མགྲིན་གཅིག་དབྱངས་གཅིག་ཏུ་བཤད།",
    "འོན་ཀྱང་རང་ཉིད་འདས་དགུན་ཟླ་བཅུ་གཉིས་པའི་གྲང་ངར་རུས་རྐང་ཟིན་པའི་ལམ་ནས་ཇི་ལྟར་འོངས་པ་དང་།",
    "དེ་བས་དབྱར་དྲུག་པའི་ནང་དུའང་རང་འཐག་ཁར་རང་འཐག་འཐག་མཁན་རྒྱུན་མི་ཆད།",
    "ན་འདུག་བལྟ་རུ་འོངས་པ་ཡིན།",
    "བྱ་བ་བགོས་པ་ནས་བཟུང་ཁོ་རང་ལའང་ཟླ་ཡོགས་ཡོད་པས་འཚོ་བ་དང་ཕྱོགས་གང་ཅིའི་ཐད་ལའང་དཀའ་ངལ་ཅི་ཡང་མ་མཆིས།",
    "མཛེས་པ་མི་མཐོང་དུས་ཀྱི་བཀླུབས་འདུག་པ་ནི།",
    "ལ་ལྷུང་མི་འདུག་ནུ་བོས་ཇ་ཐང་དང་སྣུམ་འཁུར་སུ་ནམ་མཁའི་སྐ་རགས་ཀྱི་གཟུགས་བརྙན་ཤར་བ་མདུན་དུ་བཤམས་ཏེ་བདག་ལ་ཟ་འཐུང་བྱེད་པར་དང་དབྱེར་མ་མཆིས།",
    "རང་རང་སེམས་ཀྱི་སྡུག་བསྔལ་ཐོངས་ལ་དགའ་བའི་རྩེད་འཇོར་རོལ་ཅེས་བསྐུལ།",
    "ག་མ་ང་རང་ཕྱུགས་རྫི་ཞིག་ཡིན་ན།",
    "ཡུའེ་ཧན་ཞེས་མའེ་ཀོས་ཁོ་རང་ཕྱིར་བོས་ཏེ།",
    "དངོས་གོནས་ཡག་པོ་བྱུང་མི་འདུག་ཁོ་ཚོས་ང་དཔྱད་གཞིའི་དཔེ་གཉེར་ཁང་དུ་མངགས་ནས།",
    "ཁོ་རང་ལ་ལྟ་བར་དེ་འདྲའི་རྔམ་མི་རུང་ཨང་ཧང་།",
    "ཁོ་རང་ལ་ངའོ་སྐྱེ་རྒྱུ་ཅི་ཡོད།",
    "མ་ཚད་ལ་སྦྱངས་མྱོང་ནའང་ད་ལྟ་ཅི་ཡང་མི་ཤེས་པ་ཞིག་ཏུ་གྱུར་འདུག་ཡིན་ནའང་དེ་ནི་རང་ཉིད་ལ་ནུས་སྟོབས་མེད་པ་མ་ཡིན་པར།",
    "གལ་ཏེ་མགུར་གླུ་འདིའི་ནང་དུ་ལྕང་མ་ལྕང་སྲུང་ཨ་ཇོ་ཞལ་ངོ།",
    "མགུར་གླུ་ཤོ་ལོ་ཀ་འདི་གོང་མས་མངགས་པའི་མཚན་མཁན་མཁས་པའི་ཚད་དུ་འཇོག་པ་དེས་སྐུ་ཉིད་ནི་འཕགས་པའི་སྐུའི་མཚན་ཉིད་ཡོངས་སུ་རྫོགས་པ་ཞིག་ཡིན་འདུག་ཅེས་བསྒྲགས་མཚམས་སུ་མཛད་པ་མ་ཡིན་ན་ཤོག་ཁག་གཉིས་གྲོས་ཆིངས་བྱས་ཏེ་ལྷ་ས་ནས་ཁ་འབྲལ་རྒྱུར་ཐག་བཅད་པའི་རྗེས་སུ་མཛད་པ་ཡིན།",
    "ཤི་བ་གཟི་བརྗིད་ལྡན་ཞེས་བསྒྱུར་འདུག་པ་དེ་ལས།",
    "གཉེན་པོ་ཉིང་ཀྱང་རང་སར་གྲོལ།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "གཅིག་པུར་འདུག་ན་སེམས་ལ་བརྟག། ༡༤",
    "བོད་ཡུལ་གྱི་ཆ་གཙང་སོགས་ཀྱི་བསྟན་བཅོས་ཁོ་ན་ལ་སྦྱངས་པ་མཛད་པ་ཞིག་ཡིན་པར་འདུག་སྙམ་པའི་མཚན་ཉིད་པ་མཐའ་དག་།",
    "ཁོང་རང་རི་རབ་ཀྱི་བྱང་ཤར་གྱི་རྩེར་གསུངས་པར་བཞེད་དོ།",
    "འཇིགས་བྱེད་ཀྱི་རྒྱུད་ཀྱི་གླེང་གཞིའི་སྐབས་ཀྱི་བཞུགས་པའི་གནས་སྟོན་པའི་རྒྱུད་ཚིག་དུས་འཁོར་འགྲེལ་ཆེན་དུ་དྲངས་པ་ལས།",
    "འདི་རྣམས་ཡིན་ནམ་མ་ཡིན་སྙམ་ཙ་ན།་",
    "ཉི་འ་བ་ཇི་ལྟ་བ་བཞིན་འདུག་པས་དད་པ་སྐྱེས་རྒྱུད་ཐམས་ཅད་བློ་ལ་ཟིན་པར་གསོལ་བ་བཏབ་པས།",
    "ནམ་ལངས་ཙ་ན་མདུན་གྱི་ནམ་མཁར་རྗེ་བཙུན་འཇམ་དབྱངས་བྱོན་ནས།",
    "དེ་ནས་རྒྱ་གར་དུ་བྱོན་པས་ཆུ་བོ་གང་གའི་འགྲམ་དུ་རྣལ་འབྱོར་པ་གསུམ་གཤིན་རྗེའི་འཁྲུལ་འཁོར་ལ་སྒྲུབ་བྱེད་འདུག་པས་གཡོག་བྱས་ཏེ་གདམས་པ་ཕྱག་ལེན་དང་བཅས་པ་བསླབས་པས་མཐུ་སྟོབས་ནུས་པ་ཕུལ་དུ་བྱུང་ཞེས་བོད་ཀྱི་གྲུབ་ཆེན་དཔལ་ས་པ་བཟ་བསམ་འཛིན་གྱིས་གསུང་ངོ།",
    "ལྷག་ཆད་ཨེ་འདུག་ལན་གསུམ་ཞུས།",
    "ནོར་འཁྲུལ་མི་འདུག་ལན་གསུམ་གསུངས།",
    "བལ་པོ་ཐུགས་རྗེ་ཆེན་པོ་བོད་དུ་སྤྱན་དྲངས་ནས་ཕྱིར་ཐེག་དུས་གསེར་སྲང་སྟོང་བརྫངས།",
    "འོན་སཔ་གང་༣ མ་གཉེར་ལ་ང་ལ་འཇིགས་པ་ཆེན་པོ་འདུག་པས་ང་མི་སྡོད་ཟེར་ཁོང་བྲོས།",
    "ཡར་ལྷ་ཤམ་པོ་ཁོ་རང་སླར་ཏིང་ངེ་འཛིན་གྱིས་གསོས་པས་སྐུ་མདུན་དུ་ལོ་བཅུ་དྲུག་ཙམ་གྱི་རྣམ་པ་ཅན་ཁྱེའུ་རྣམ་པ་ཅན་ཁྱེའུ་གཡུ་ཡི་སྨིན་མ་དང་དུང་སོ་འཁོར་མར་ཡོད་པ་ཞིག་བྱུང་སྟེ།",
    "མི་ལས་ལྷ་འདྲེ་ཁས་བླངས་དང་དམ་བཅའ་ལ་གནས་པ་འདུག་གསུང་ངོ།",
    "འགྲོ་འདུག་སྨྲ་བརྗོད་ཐམས་ཅད་ཤེས་པར་མཛད།",
    "ཇ་སྐོལ་བྱས་པའི་ཉིན་མ་དེ་ཉིད་རང་དུ་འདུག་གསུང་པ་དང་།",
    "ལན་ཁྱེར་མི་རྣམས་ཀྱི་དབུས་སུ་སླེབས་ཙ་ན་བྱང་སེམས་པ་འདས་ནས་གུ་རུ་དཀོན་གཞོན་པ་ཡབ་ཀྱི་གདན་སར་བསྐོས་ཚར་འདུག་གསུང་ངོ།",
    "ཁྱེད་ཀྱི་བུར་འདུག་པ་ཐིགས་པ་ཡིན་གསུངས་ནས་ཡི་དམ་གྱི་བྲིས་སྐུ་བྱིན་བརླབས་ཅན་སོགས་ཆེད་དུ་སྐྱེལ་མི་ས་ལ་།",
    "ཕུ་༣་ རྗེ་ཙ་ན་གས།",
    "ངམ་རིང་དུ་པན་ཆེན་ཕྱོགས་ལས་རྣམ་རྒྱལ་གྱིས་རིགས་གཏེར་ནང་འགལ་གྱི་ཕུང་པོ་འདི་ལ་ངས་མགོ་ནས་མཐར་ཆཊ་སུ་དགག་པ་བྱེད་པ་ཡིན་པས་ཁྱེད་རང་ས་སྐྱ་བ་རྣམས་གྲོས་གྱིས་ལ་ལན་ཐོབ་གསུང་པར་སུས་ཀྱང་མ་ནུས་པ་ན།",
    "རྗེའི་གསུང་ནས་ཁྱེད་རང་རྣམས་ས་བརྐོས་ངས་བཟུང་པ་༡་།་",
    "ཞབས་བསྙུང་ནས་མཐར་རྒྱས་སུ་ལོ་གཅིག་བཞུཊ་རིང་ལ་དེའི་མཆོད་གནས་གནས་བརྟན་པར་རྒྱུད་འབུམ་གྱི་ལུང་བཞུགས་འདུག་པས་ཁོང་ལ་གསར་།",
