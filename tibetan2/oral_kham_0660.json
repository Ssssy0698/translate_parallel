    "ཡིད་འཛིན་ཞིང་ཁམས་གཙང་མར་གདའ།",
    "གཟིམས་ན་འགྲོ་བའི་དོན་ལས་ཉམས་ནས་འགྲོ་བར་གདའ་བས་ཡར་བཞེངས།",
    "ཁ་སང་ནས་བསམས་པ་བཞིན་དུ་གླེང་ཞིང་འདུག་པ་ལས།",
    "མི་ཁྲག་བསྐོལ་བའི་སྟེང་དུ་མི་ཚིལ་བཞུ་ནས་མི་ཤ་དང་སྤགས་ནས་ཟ་ཞིང་གདའ་འོ།",
    "རྫུ་འཕྲུལ་ཅན་ཅིག་གདའ་སྟེ།",
    "དེ་རིང་རང་སྡུག་ཡོད་མཆི་ཟེར་ཞིང་དཔྲལ་བ་ལག་པ་བཀབ་སྟེ་བལྟས་པས།",
    "བདེ་བར་རིན་ཆེན་སྟན་ལ་འདུག།",
    "ལ་ལའི་ནང་ན་དགུན་ལ་སོགས་པ་དུས་སོ་སོ་བཞིན་དུ་འདུག་པ་ལ།",
    "སྲིན་ཕྲུག་དག་ཀྱང་དེའི་ཆ་དང་མཐུན་པ་དུ་མ་གདའ་བ་ལ།",
    "ཁྲག་རྩ་རྣམས་ནས་ཁྲག་འབབ་ཅིང་འདུག་པ་མཐོང་།",
    "དེ་ཙ་ན་ཐམས་ཅད་ཀྱིས་དཔའ་གདེང་བསྐྱེད་དེ་བརྡེག་པ་ལས་མ་ཤེས།",
    "ཕ་མས་བདག་གནང་པར་གདའ་བ་དང་།",
    "རང་རང་སྡུག་བསྔལ་དུ་མས་གཟིར།",
    "འདི་བས་དཀའ་བ་དུ་མ་གདའ།",
    "ལྷ་ཐུགས་དགོངས་རྫོགས་པར་བྱས་གདའ་འོ།",
    "རྒྱལ་བུས་ནི་མི་སྲིད་པ་སྲིད་པར་བྱས་གདའ་འོ།",
    "ཇི་སྐད་སྨྲས་པ་བཞིན་བྱས་འདུག་གོ།",
    "ད་ལྟ་ནི་རི་བོ་རྩེ་ལྔ་ན་ཁྱེ་ཆུང་ལེགས་པོ་ཞིག་ཏུ་གདའ་སྟེ།",
    "ཞེས་གསུངས་གདའ་ན།",
    "ལོ་ཙཱ་བ་གཉིས་པོས་དུས་དེ་ཙ་ནའང་བློན་པོ་བྱས་ནས་གདའ།",
    "ཇོ་བོས་གོང་དུ་གསུངས་པ་བཞིན་དུ་ཡུལ་དེ་ཐམས་ཅད་བདེ་བར་བྱེད་པར་གདའ།",
    "ཁྱེད་ཡབ་ཡུམ་ལ་སྲས་མི་གདའ་བས་ངས་བྱ་དགོས་ཟེར་བ་དང་།",
    "ཁྱེད་དད་པ་རབ་ཏུ་བརྟན་པ་ཞིག་འདུག།",
    "ནང་པར་གཉིད་སད་ཙ་ན་ལུས་ཀྱང་ཤིན་ཏུ་བདེ་བ།",
    "རྨི་ལམ་དུ་བྱུང་བ་བཞིན་འདི་ནི་དད་པ་རབ་ཏུ་བརྟན་པ་ཞིག་འདུག་ཟེར་ཏེ།",
    "ངའི་བུ་འདི་ཡ་མཚན་ཆེ་བ་ཞིག་འདུག་པ་ལ།",
    "རྒྱལ་བུ་མ་ཡར་ལ་མི་དགའ་བར་འདུག་སྙམ་དུ།",
    "རྒྱལ་པོའང་བུ་ལ་བརྩེ་བར་གདའ་སྟེ།",
    "བློ་སྣ་མ་མང་རང་ཚུགས་ཟུང་།",
    "ཆུ་ཤིང་ཆུ་ཤིང་བཟུང་ནས་གདའ།",
    "མི་རྟག་དུས་ཀྱིས་རྙིངས་གྱུར་ཚེ།",
    "རྒྱལ་པོ་གསེར་གྱི་མཆོད་རྟེན་ལ་བསྐོར་བ་བྱེད་ཀྱིན་འདུག་པ་མཐོང་ནས།",
    "དེ་རིང་ཀ་ལན་དྷ་ཀ་ཅིག་ཀྱང་གདའ་འོ་ཟེར་ནས།",
    "དེའི་མདུན་ན་ཆུ་མིག་ཅིག་ཀྱང་འདུག་པ་ལ།",
    "དེའི་དུས་སུ་ཁྱེད་རང་འདི་སྐད་དུ།",
    "རྒྱལ་པོས་ཀྱང་མ་ཚོར་བར་གདའ་འམ་གྱིས་ཤིག།",
    "ཁོང་རྒྱལ་པོས་ཀྱང་མ་ཚོར་གདའ་ལགས་སམ།",
    "རྒྱལ་པོས་ཀྱང་ཟུར་ཙམ་ཟེར་ཞིང་གདའ་འོ།",
    "རྒྱལ་པོས་ཀྱང་ཟུར་ཙམ་ཐོས་ནས་གདའ་འོ་གྱིས་ཤིག།",
    "ཁོང་རྒྱལ་བུས་ཀྱང་མ་ཚོར་གདའ་འམ།",
    "ནང་པར་བྱེའུས་བལྟས་པས་མེ་ཏོག་ཅིག་སྐྱེས་འདུག་པའི་རྩ་བ་ནས་བཅད་དེ།",
    "ཤུལ་དུ་མཆིལ་མ་ཅིག་བླུགས་ཏེ་བཞག་ནང་པར་ལྷ་དེ་བལྟ་ཞིང་འདུག་པས།",
    "ལྷའི་ཡུལ་ན་ཉི་མ་སྔ་སྐད་ལྟ་བུར་གདའ།"
  ]
}