    "བསྒྲུབ་ཛྭཔར་བྱ་བའི་ལུས་ལ་ཉེ་བར་རྗེས་སུ་མྱོང་བར་འགྱུར་ཞིང་བསྒྲུབ་༨་པར་བྱ་བ་མཆོག་ཏུ་བདེ་བ་དང་ཡིད་བདེ་བ་ཐོབ་པའོ།",
    "སྒྲུབ་༩པ་པོ་སྐད་ཅིག་ཙམ་ཡང་ཡོངས་སུ་མི་སྤོང་བ་གང་ཡིན་པ་དེས་སྤང་ན་སྡུག་བསྔལ་ཐོབ་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་དེའི་ལུས་ལ་ཐམས་ཅད་དུ་འཇིགས་པ་ཐམས་ཅད་ལས་བསྲུང་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པའི་ཁྲོ་བོ་གང་ཡང་རུང་བའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེའི་ལུས་ལ་ཞུགས་ནས་མཉམ་པར་སྤྲོས་ལ།",
    "གསང་བའི་༡ཁྲོ་བོའི་ཡེ་ཤེས་བསྒྲུབ་པ་དེས་ལས་རྣམས་བྱེད་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་དངོས་གྲུབ་ནི།",
    "སྒྲུབ་པ་པོ་རྣམས་འབྲས་བུ་ལ་སྤྲོ་བ་སྐྱེད་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་གསུངས་ཏེ།་",
    "འདི་རྣམ་པར་རྒྱལ་བས་ན་རྒྱལ་བ་སྟེ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའོ།",
    "དེར་ངེས་པའི་ཡེ་ཤེས་དེ་བསླབ་པར་བྱའོ།",
    "ཨོཾ་ཡ་ཐཱ་སཐྲུ་ཏ་ཐཱ་ག་ཏསྟ་ཐ་ཨ་ཧཾ་ཊཞེས་བྱ་བའི་བར་དུ་བྱས་ནས།",
    "ཤིང་ངམ་རྫས་ལས་བླུགས་པའི་གཟུགས་བརྙན་བྱས་པ་ས་ལ་བཞག་སྟེ།་",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "དེ་བཞིན་དུ་སྔགས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "ནུ་མའི་སྟེང་དུ་གནས་པར་ནི།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "འབར་བས་བསྐོར་བའི་དབུས་བཞུགས་པ།",
    "དེ་ལྟར་རྡོ་རྗེ་རིགས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོའི་མཚན་ཉིད་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོར་བྲི་བའི་ཆོ་ག་བསྟན་ཟིན་ཏོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རང་བཞིན་དུ་བསྒོམས་ནས་འགྲུབ་པ་དེའི་ཚེ་འགྲུབ་༡པར་འགྱུར་ཏེ།",
    "ཞེས་བྱ་བ་ནི་དཔལ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་ཆེན་པོ་བབྱུངས་ནས་དེ་བསྒོམས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་རིན་ཆེན་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་གྲུབ་པས་རྒྱལ་པོ་ཉིད་གྲུབ་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ལས་ནི་བྱེད་པར་འགྱུར།་",
    "ཞེས་བྱ་བ་ནི་༡༡ལས་ཀྱི་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་དང་ཁྲོ་བོ་ཆེན་པོ་རྡོ་རྗེ་ལས་ཀྱི་སྤྱོར་བས་གྲུབ་པར་གྱུར་ནས་རྡོ་རྗེ་ལྟར་མི་ཕྱེད་པའི་ལས་དེ་བྱེད་པར་འགྱུར་རོ།",
    "ཁྲོ་བོ་སེམས་དཔའི་སྔགས་ཀྱིས་གྲུབ་པར་གྱུར་ནས།",
    "རྡོ་རྗེ་ཧཱུཾཆགས་པས་ཆགས་པར་བྱེད་པའོ།",
    "ལེགས་པར་དགའ་བ་སྟེར་བར་བྱེད་པའོ།",
    "སྣཁམས་གསུམ་དུ་གཏོགས་པའི་རྫས་རྣམས་འབར་བའི་ལྟ་བས་བཀུག་ཅིང་བཞག་པ་ནི་མ་རུངས་པར་བྱེད་པའོ།",
    "ཁྲོ་བོ་རྡོ་རྗེ་ཉི་མ་ནི་ཕྱག་རྒྱ་ཆེན་པོ་ཁྲོ་བོའི་གཟི་བརྗིད་ཉི་མ་དང་མཚུངས་པར་སྟེར་བར་བྱེད་དོ།",
    "ཁྲོ་བོ་རྡོ་རྗེ་དབལ་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་དང་དཔལ་གྱི་ཁྲོ་བོས་ཁམས་གསུམ་པར་གཏོགས་པའི་སྟོབས་དང་མི་འཇིགས་པ་ལ་སོགས་པའི་དོན་རྣམས་བཀུག་པར་འགྱུར་རོ།",
    "ཕྱི་རོལ་གྱི་དགྲ་རྣམས་གཅོད་པར་བྱེད་དོ།",
    "རྒྱུའི་ཁྲོ་བོས་རང་དང་གཞན་དཀྱིལ་འཁོར་དུ་འཇུག་ཅིང་སྡུག་བསྔལ་འཕྲོག་པར་བྱེད་པའོ།",
    "ཁྱད་པར་ཅི་ལྟ་བུ་ཞིག་ཅེ་ན།",
    "ལག་ངར་རྡོ་རྗེར་བྱས་པ་དེ་ཉིད་ཀྱིས།",
    "ཞེས་བྱ་བ་ནི་མཇེའུ་ཆུང་གཉིས་ལྕགས་ཀྱུར་བྱས་ལ།",
    "ཕན་ཚུན་ལུ་གུ་རྒྱུད་དུ་སྦྲེལ་བར་བྱས་པ་ནི་མཐེའུ་ཆུང་ལྕགས་ཀྱུར་བཅིང་བར་བྱས་པ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "རྣམ་པར་སྣང་མཛད་དང་།",
    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ།",
    "གཡས་པ་ལྕགས་ཀྱུར་དགུག་པར་བྱ།"
  ]
}