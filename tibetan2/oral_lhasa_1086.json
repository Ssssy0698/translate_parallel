    "དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ཕྱག་བྱས་ལ།",
    "ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རིག།",
    "ཕྱག་བཞི་བྱས་ནས།",
    "ཐུགས་རྡོ་རྗེའི་བདག་ཉིད་ཡིན་ནོ་ཞེས་བསམ་པར་བྱའོ།",
    "དེ་ལྟར་རྣལ་འབྱོར་ཆེན་པོ་རྫོགས་པར་གྱུར་པ་ཡིན་ནོ།",
    "རྐེད་པར་རྡོ་རྗེ་ཁུ་ཚུར།",
    "བརླ་གཡས་པར་ལྕགས་ཀྱུ།",
    "བརླ་གཡོན་པར་ཞགས་པ།",
    "རྗེ་ངར་གཡས་པར་ལྕགས་སྒོག།",
    "རྗེ་ངར་གཡོན་པར་ཁྲོ་བོ་རྡོ་རྗེ་འབེབས་པའི་གནས་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་ཡན་ལག་ཐམས་ཅད་ལ་བཞུགས་ཏེ།",
    "ཕྱག་རྒྱ་དགྲོལ་བའི་དུས་སུ་རྣམ་པར་སྣང་མཛད་ནི་སྤྱི་གཙུག་ཏུ་དགྲོལ་ལོ།",
    "དོན་ཡོད་པར་གྲུབ་པ་ནི་ལས་ཀྱི་ཧཱུཾ་མཛད་ཀྱི་གནས་སུ་དགྲོལ་བར་བྱའོ།",
    "རྡོ་རྗེའི་ལྟེ་བ་ལ་ཡི་གེ་བ་ཧཱུཾ་བསམ་པར་བྱའོ།",
    "གསེར་གྱི་རུས་སྦལ་ཚད་གཞལ་དུ་མེད་པ་པདྨ་ཐམས་ཅད་ཀྱི་གཞིར་གྱུར་པར་བསམ་པར་བྱའོ།",
    "ནམ་མཁའི་ཕྱོགས་ཀྱི་ཡི་གེ་ཁཾ་༩་དཀར་པོ་རྣམ་པར་སྣང་མཛད་ཀྱི་རང་བཞིན་ཅན་འོངས་ནས།",
