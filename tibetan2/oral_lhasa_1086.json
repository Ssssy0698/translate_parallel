    "དེས་དང་པོ་ཉིད་དུ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་རིགས་སུ་འཇུག་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས།",
    "འཇུག་པ་དང་པོར་བྱས་པ་གང་ལ་ཡོད་པ་ནི་འཇུག་པའི་ཆོ་ག་རྒྱས་པའོ།་།",
    "དེ་ལ་རྡོ་རྗེ་སློབ་དཔོན་བདག་ཉིད་ཁྲོ་བོ་ཏི་རཱིརྙི་༡རིའི་ཕྱག་རྒྱ་བཅིངས་ཏེ་བཞུགས་ཤིག་ཅེས་བྱ་བ་ནི།",
    "དེ་ལ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པའི་རྡོ་རྗེ་ཁྲོ་བོ་དེ་དག་ཕན་ཚུན་མཐའ་མེད་པར་གྱུར་པ་ནི་ཏི་རཱིརྙི་རིའོ།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་རང་བཞིན་རྟོགས་པ་ནི།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་གསོལ་བ་གདབ་པར་བྱ་སྟེ་ཞེས་བྱ་བ་སྒོས་ཏེ།",
    "ཚར་གཅད་པར་རིགས་པ་རྣམས་ནི་ཚར་གཅོད་དོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "གདུག་ཅིང་མ་རུངས་པ་ཚར་གཅད་༨པར་འོས་པ་རྣམས་ཚར་གཅོད་པ།",
    "དེ་ཇི་ལྟར་བསྒྲུབ་པར་བགྱི་༩།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་བདག་ལ་ཇི་ལྟར་བསྒྲུབ་པར་བགྱི།",
    "དེ་སྐད་དུ་གསོལ་བ་འདེབས་པར་བྱེད་པའོ།",
    "ལྕགས་ཀྱུ་ལ་སོགས་པས་ལས་བྱས་ནས་ཞེས་བྱ་བ་ནི།",
    "བསྦུ་བ་བྱས་ནས་མཚན་བརྒྱ་རྩ་བརྒྱད་པས་བསྟོད་དོ།",
    "ཕྱག་རྒྱ་ཆེན་དུ་པོ་རྣམས་རྣམ་པར་སྣང་མཛད་ནས་བརྩམས་ནས།",
    "འཇུག་པ་བྱས་པའི་དེ་མ་ཐག་པ་ཉིད་དུ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་རིགས་སུ་ཞུགས་ཀྱིས།",
    "མིག་འབྱེད་པར་ནི་བརྩོན་པར་མཛད།་།",
    "དེ་རིང་ཉིད་དུ་འབྱེད་པར་བྱེད།",
    "མིག་གཡས་པ་དང་གཡོན་པར་ཡི་གེ་ཧི་ཏྲེལས་ཉི་མ་དང་ཟླ་བ་བསྐྱེད་ལ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ས་གཞི་༩ནི་ཁ་དོག་དཀར་པོ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཁ་དོག་སྔོན་པོ།",
    "ཅེས་གསུངས་སོ།",
    "དེ་ལྟར་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཟླུམ་པོར་བྱས་ལ།",
    "ལས་ཀྱི་ཧཱུཾ་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཟླུམ་པོར་བྱས་ལ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ལྔ་ལྔ་བྱས་ལ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་གདན་དེ་རྣམས་ལ་བཀོད་ལ།",
    "རྡོ་རྗེ་ཤུགས་ཀྱི་པྱཧཱུཾ་བཞི་བརྗོད་ཅིང་དཀྱིལ་འཁོར་དུ་ཞུགས་ལ་ལན་བདུན་བར་དུ་བསྐོར་བ་ཀྱེབྱས་ཏེ།",
    "རྣལ་འབྱོར་པས་ལེགས་པར་མཉམ་པར་བྱས་ནས།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་མཆོད་ནས་གོས་སྔོན་པོ་ལ་ཁྲོ་བོ་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་སྔགས་ལན་གསུམ་བཟླས་པའི་བདག་ཉིད་ལ་སྟོད་གཡོགས་དང་སྨད་གཡོགས་བྱས་ཏེ།",
    "ཚར་གཅད་པར་རིགས་པ་རྣམས་ནི་ཚར་གཅད་དོ།་",
    "དེ་ནས་རྡོ་རྗེའི་ཆུ་འཐུངས་ལ་བདག་ཉིད་ལ་དབབ་པར་བྱ་སྟེ།",
    "དབབ་པ་ཉེ་བར་བསྡུ་བ་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་སློབ་དཔོན་དུ་གྱུར་པས་ཆོ་ག་རྒྱས་པ་ཐམས་ཅད་རིམ་པ་བཞིན་དུ་བདག་ལ་མཛད་པར་བསམ་པར་བྱའོ།",
    "སླར་ཡང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་དེ་ཉིད་དུ།",
    "སརྦ་ཏ་ཐཱ་ག་ཏེ་མ་ཧཱ་བཛྲ་ས་མ་ཡ་ཧཱུཾ་ཛ་ཨ་ཞེས་བྱ་བའི་སྔགས་ཀྱིས་༩རྣམ་པར་སྣང་མཛད་ཀྱི་རྡོ་རྗེ་རྩེ་ལྔ་པ་བསམ་པར་བྱའོ།་།",
    "ཨོཾ་བཛྲ་ཨཱ་ཁུབེ་ཤ་མ་ཧཱ་ཀྲོ་དྷ་ཨཱ་༡་བེེ་ཤ་སརྦ་ས་མ་ཡ་ཧཱུཾ་ཨ་ཨ་ཞེས་བྱ་བས་ཁྲོ་བོ་རྡོ་རྗེ་ག་འབེེབས་པའི་རང་བཞིན་རྡོ་རྗེ་དྲིལ་བུའི་གཟུགས་སུ་བསམ་པར་བྱའོ།",
    "བཛྲ་ཨཱ་ཀྱྀབེེ་ཤ་ཀྲོ་དྷ་ཧཾ་ཞེས་བྱ་བས་ཁྲོ་བོ་རྡོ་རྗེ་འབེེབས་པའི་གཟུགས་སུ་བསམ་པར་བྱ་སྟེ།་",
    "དེ་ལྟར་ན་དཀྱིལ་འཁོར་རྡོ་རྗེ་སྒྲུབ་པར་འགྱུར་བའོ།",
    "ཁྲོ་བོ་རྡོ་རྗེ་སྲུང་བ་ལ་སོགས་པ་ཡང་དག་པར་བསྲུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས།",
    "ཡང་ཕྱག་བཞི་བྱས་ལ་མཆོད་ཡོན་ཕུལ་ནས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་ཕྱག་གྱིས་ཤིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་འདིར་འཇུག་པ་ལ་སྣོད་དུ་གྱུར་པ་དང་།",
    "དེ་ལྟར་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་རྒྱས་པར་བསྟན་ནས།",
    "གདོང་དྲི་ཞིམ་པར་བྱས་ཏེ།",
    "ཤར་ཕྱོགས་ཀྱི་སྒོ་ནས་དགུག་པར་བྱ་ཞིང་།",
    "གལ་ཏེ་འགའ་ཞིག་ལ་སྨྲས་ན་ཀླད་པཇིའགས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་བདག་ལ་དབབ་པར་གྱུར་ཅིག་ཅེས་སྨྲོས་ཤིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཡིན་པར་གྲགས།",
    "དེ་རིང་ཉིད་དུ་འབབ་པར་ཤོག།་",
    "ཡང་གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་གཡས་པའི་སེམས་མ་རྡོ་རྗེ་མ་དྲལ་ཞིང་ཧཱུཾ་ཨ་ཨ་ཨ་ཞེས་བྱ་བ་ལན་བརྒྱའི་བར་དུ་བརྗོད་པར་བྱའོ།",
    "སུ་བཛྲ་ཨཱ་བེེ་ཤ་ཡ་ཧཱུཾ་སུ་ཞེས་དབབ་པར་བྱ་ཞིང་།",
    "དེ་ནས་དེའི་ལུས་ལ་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཧཱུཾ་མཛད་གཞུག་པར་བྱའོ།",
    "མིག་འབྱེད་པར་ནི་བརྩོན་པར་མཛད།",
    "དེ་རིང་ཉིད་ནི་འབྱེད་པར་ཤོག།",
    "དར་གྱིས་གཡོགས་ནས་གཞག་པར་བྱའོ།",
    "དེ་ནས་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ལས།",
    "དམ་ཚིག་འདས་ན་སྲེག་པར་བྱེད།",
    "དེ་ནས་ལག་པ་གཉིས་ཀྱིས་དར་དཔྱངས་བཅིང་བའི་ཚུལ་དུ་བྱས་ལ།",
    "འཇིག་པར་བྱེད་པ་དམ་པ་ཡིན།་།",
    "ཞེས་བྱ་བ་དང་དེ་ཁོ་ན་ཉིད་ཀྱིས་༧རྟེརྡོ་རྗེ་སྦྱིན་པར་བྱའོ།་",
    "ནམ་མཁའ་མཉམ་པར་སྦྱོར་བ་ཡིས།",
    "ཐམས་ཅད་མྱུར་དུ་འགྲུབ་པར་འགྱུར།",
