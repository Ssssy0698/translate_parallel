    "དེ་ན་ཅག་ཅག་པ་ཞིག་འདུག་པ་སུ་ཡིན་བྱས་པས།",
    "འདི་ན་དུག་སྦྲུལ་དྲག་པོ་འདུག་ཅེས་བསྐོར་ནས་ཕྱིན་པས།",
    "ལོ་དྲུག་དཀའ་བ་སྤྱད་ཚེ་བློས་གཏོང་ལུགས་ཇི་འདྲ་མཛད་འདུག་དེ་ལ་ཁ་མིག་ཡར་ལྟ་བྱེད་དགོས།",
    "གནམ་སྒོ་ཕྱེ་ནས་གཞན་ཅི་ཡང་མི་འདུག་ཚེ།",
    "ནང་བར་གཡུ་ཁོ་རང་ལ་གཏད་སྐད།",
    "ད་ནི་སྤྱིལ་བུ་སྒོ་མེད་ན་ཡང་བག་ཚ་བ་མེད་པར་བདེའོ་ཞེས་ལན་གསུམ་གསུམ་བརྗོད་པར་འདུག་གསུངས།",
    "དབེན་པའི་གནས་སུ་སྒྲུབ་པ་ལ་རྩེ་གཅིག་ཏུ་གཞོལ་བ་ཤ་སྟག་མཛད་འདུག་ཀྱང་རྙེད་བཀུར་དང་སྙན་གྲགས་འབད་མེད་དུ་རྒྱས་པ་ལས།",
    "དེས་ན་ཚེ་བློས་ཐོངས་ན་རྙེད་བཀུར་སྙན་གྲགས་ཀྱང་འབད་མེད་ལྷུན་འགྲུབ་ཏུ་འོང་བར་གདའ།",
    "ཡང་དུས་ཕྱིས་ཙ་ན་ངའི་བརྒྱུད་འཛིན་ཡིན་ཟེར་ནས།",
    "ང་བདག་འགོང་པོ་ཕུང་རྒན་འདི་ལ་ཐུག་འདུག་པས།",
    "ཡང་ནམ་མཁའ་རྟེན་མེད་པ་ལ་རྔ་བོ་ཆེ་ཡང་དག་པ་གཅིག་འདུག་སྟེ།",
    "སྒྲ་དེ་ལ་རི་དྭགས་མང་པོས་ཉན་ཞིང་འདུག་མི་མང་པོ་དཔག་ཏུ་མེད་པ་འདུག་པ་ལ།",
    "ཅིར་སྣང་རང་སེམས་སུ་ཐག་བཅད་དོ།",
    "དེའི་རྩལ་ཐུགས་རྗེ་འགག་མེད་གང་ཤར་ཡང་རང་བཞིན་གྱིས་རྡུལ་ཙམ་དུ་ཡང་མ་གྲུབ་པས་གསུམ་ག་དབྱེར་མེད་ཟུང་འཇུག་ཆེན་པོར་ཤེས་པར་གྱིས་དང་།",
    "སྟོང་པ་ཅིར་ཡང་མ་གྲུབ་པ་གསལ་ལ་དྭངས་པ་ཞིག་འདུག་པ་དེ་མཐོང་ནས།",
    "དེས་ན་འཆི་ཁ་མའི་མི་ལ་ཡང་གདམས་ངག་འདི་ལས་ཟབ་པ་དང་ངོ་མཚར་བ་ཞིག་གཞན་ན་མེད་པར་གདའ།",
    "རྟོགས་པའི་དུས་མི་གདའ་བས།",
    "སེམས་ཀྱི་ངོ་བོ་སྟོང་པར་འདུག་པ་དེ་ལ་ལེགས་པར་ལྟོས།",
    "ཉམས་སུ་མྱོང་བ་ཞིག་འདུག་པ་དེ་ལྟ་བ།",
    "རང་ཇི་ལྟར་འདུག་ཀྱང་གསལ་སྟོང་དང་མི་འབྲལ་བ་དེ་སྤྱོད་པ།",
    "ང་ལ་ཤེས་པ་སྤྲོས་བྲལ་དུ་ལྷོད་བཞག་ཙ་ན།",
    "རྡུལ་ཕྲ་རབ་འདི་ཆ་བཅས་སམ་ཆ་མེད་ཁྱེད་རང་གང་ཡིན་པ་གྱིས།",
    "རྣལ་འབྱོར་ལུས་རྒྱུ་ཞིག་ཙ་ན།",
    "ནམ་མཁའ་འདི་ལ་སྐྱིལ་ཀྲུང་གྱིས་ལ་འདུག་དང་ཟེར་བ་ལ།",
    "དེ་ཡང་ཁ་ཟས་ཞིམ་པོ་དང་ཤིང་ཐོག་བཟང་པོ་རྙེད་ན་མ་ལ་སྟེར་ཞིང་ཁ་ཟས་ངན་པ་དང་ཤིང་ཐོག་སྐམ་པོ་དག་རྙེད་ན་ཁོ་རང་ཟ་བ་དེ་མཐོང་ནས་རབ་ཏུ་དགའ་བས།",
    "བདག་དུས་འདི་ནས་བཟུང་སྟེ།",
    "བཙུན་པ་ཐམས་ཅད་འབྱོན་པར་འདུག་དེ་ནས་ང་ལ་ལྟོ་སྟེར་མི་མི་འོང་ཟེར།",
    "དེ་ཁོང་མད་པར་གདའ་གསུངས་ནས་སྤྱན་ཆབ་ཉིལ་ཉིལ་མཛད་ཅིང་འདི་ལྟར་ཡང་གསུངས་སོ།",
    "ཁམ་པ་ལུང་པ་ཁོས་ཅི་མཛད་ཀྱིན་འདུག་གསུངས་པས།",
    "དེས་ན་ཇོ་བོ་བཀའ་བརྒྱུད་རྣམས་ཀྱང་ཐུགས་དམ་གྱི་གཙོ་བོར་འདི་ལ་མཛད་པར་གདའ་གསུངས།",
    "གཉིད་སད་དེ་བལྟས་པས་སྦྲང་བུ་མང་པོ་འདུག་ཆུར་ཕྱིན་པའམ་ས་ལ་འགྲེས་ན།",
    "སྦྲང་བུ་མང་པོ་འཆི་བར་འདུག་དགོངས།",
    "འཁོར་ལོ་ནམ་མཁའ་ལ་འཕགས་ནས་འདུག་པ་དང་།",
    "ཞེས་གསུངས་པས་བདག་འཛིན་ནམ་བྱུང་ཙ་ན།",
    "བརྟག་ན་བདག་གང་ཡང་མི་འདུག་པ་ལ།",
    "སྔར་ནི་ངས་འདི་ལ་གནོད་པ་འབའ་ཞིག་བྱས་འདུག་ད་ནི་འདིའི་གནོད་པ་བསལ་ཞིང་ཕན་པ་བསྒྲུབ་པར་བྱ་སྙམ་དུ་བསམ་ལ་གཏོང་ལེན་དྲག་ཏུ་བསྒོམས།",
    "དེ་ལྟར་ན་ཉེས་པ་ཐམས་ཅད་བདག་གཅེས་འཛིན་ལས་བྱུང་འདུག་པས།",
    "ད་ཅི་འདི་ན་ཡོད་དེ་ད་མི་འདུག་ཟེར།",
    "ང་ལ་གནོད་པར་མི་འདུག་ཕན་པར་འདུག།",
    "བདེ་བ་ཡོད་ན་སྙམ་པ་སྐྱེས་ཙ་ན།",
    "ཁྱེད་རང་ལ་འཁྱེར་རྒྱུ་གང་འདུག་ཁྱེར་ཅིག་བྱས།",
    "མྱ་ངན་གྱི་འདུག་སྟངས་བྱས་ལ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཐམས་ཅད་ཏིང་ངེ་འཛིན་དུ་འགྲོ་བ་ཞིག་ཡོད་དེ།",
    "ཁྱེད་ད་ཞག་བདུན་ནས་འཆི་བར་འདུག་པས།",
    "ངེད་རྣམས་ལ་གཏོར་མ་སྟེར་མཁན་མི་ཡོང་བ་འདུག་པས་ངུ་བ་ཡིན་ཟེར་སྐད།",
    "དགེ་སྡིག་ཁྱད་དུ་བསད་ནས་མངོན་མཐོ་ངེས་ལེགས་ཀྱི་སྲོག་གཅོད་པའི་སྡིག་ཅན་བཤན་པ་མཁན་དེ་ཡང་འདིར་འདུག་རང་གཅེས་འདིས་དུག་གསུམ་གྱི་རྐྱལ་བ་ཐོགས།",
    "བདག་གཅེས་འཛིན་གྱི་རྣམ་རྟོག་འདིས་སྔར་ཡང་སྡུག་ཏུ་བཅུག་ད་དུང་ཡང་འདི་དང་མ་བྲལ་ན་བདེར་མི་སྟེར་འདུག་ཅིང་།",
    "ད་ལྟ་ཡང་ལུས་འདི་ལ་གཅེས་པར་བཟུང་ནས་དུཁ་བར་འདུག་པས།",
    "ཅུང་ལྕི་འདུག་པས་རྐྱལ་ཤེས་པ་ཡོད་ན་གཅིག་འཐོན་རོགས་གྱིས།",
    "འདུག་པས་ལུས་ཀྱི་གཅེས་འཛིན་རྣམ་རྟོག་སྤངས།",
    "མང་པོ་འདུག་ཀྱང་འདི་ཉིད་ངོ་མཚར་ཆེ།",
    "ཅེས་སོགས་ཀྱི་བསྟོད་པ་མང་པོ་ཡང་འདུག་གོ།",
    "ཁོང་མཚམས་དམ་པོ་ཞིག་ཡོད་པར་འདུག་པས།",
    "སྤྲང་པོའི་སྐྱིད་སྡུག་ཁྱེད་རང་ཤེས།",
    "ཞབས་ཏོག་པ་གཅིག་བཀྱིགས་པ་གྲོལ་བྱུང་བའི་རྩ་ན་ཇག་པའི་རལ་གྲི་བཞག་འདུག་པ་ཁྱེར་ནས་བྲོས་ན་བསམ་ཡོད་ཙ་ན།",
    "ངེད་ཚོ་ཡང་ཕོངས་ནས་ཐབས་རྡུགས་པས་ཉིད་ལྟ་བུ་ཞིག་དང་ཐུག་ཟེར་གྱིན་འདུག་ཟེར།",
    "སྒྱུ་ལུས་མ་འབྱོངས་འདུག་པས་ད་དུང་སྦྱོངས་གསུངས་སྐད།",
    "ཁྱེད་བོད་ཀྱི་མི་འདི་བསམ་པ་ངན་པར་འདུག་གསུངས་སྐད།",
    "དེ་ལ་དམིགས་ནས་ཚོང་པ་མང་པོ་ཡོང་བར་གདའ་བ་དང་།",
    "བཙུན་པ་གཉེན་པོ་ཆུང་ཆུང་རྣམས་ཆུད་ཟ་བར་འདུག་པས་བཅག་པ་ཡིན།",
    "དུས་མཆོད་རང་དེ་བཟང་བར་འདུག་ངོ་མཚར་ཆེ་གསུངས།",
    "ང་རང་སྣང་བ་མ་དག་པ་ཡིན་གྱི།",
    "ལར་ཡང་འོ་སྐོལ་གྱིས་མི་ལ་སྐྱོན་བརྗོད་མང་པོ་བྱས་ཙ་ན།",
    "དགེ་སློང་དེ་འདྲེ་ཅན་གཅིག་འདུག་ཟེར་བ་ལྟ་བུའམ།",
    "གཞན་གྱིས་གནོད་པ་བྱས་པ་ཞེ་ལ་བཞག་ནས་གནོད་པའི་ལན་འཇལ་བའི་དུས་བྱུང་ཙ་ན་འཇལ་བ་དེ་སྤོང་བའོ།",
    "ཚོས་ཕྲུ་ཁ་ཕྱེ་ནས་བལྟས་པས་ཤ་རུས་འདུག་པ་ཟེར།",
    "དགེ་སློང་དེས་བེའུ་བརྐུས་པར་མི་གདའ་བས་གཏོང་བར་ཞུ་ཞུས་ནའང་རྒྱལ་པོ་ཡེངས་ནས་ཟླ་བ་དྲུག་ཏུ་བཏང་བ་མ་བྱུང་།",
    "ཐུགས་ཤིན་ཏུ་མད་པར་འདུག་གསུངས།",
    "མ་འགལ་བར་འདུག་ན་དགའ་བ་བསྒོམས་ཏེ།",
    "གོ་ཁ་ན་ཤིང་ཡང་མི་འདུག་ཐབ་ཁ་ན་ཆུ་དང་མེ་ཡང་མི་འདུག་པས།",
    "ངའི་འདི་ཧ་ཅང་རང་ཡང་བློས་བཏང་དྲགས་འདུག་པས།",
    "དེ་ལྟར་དགྲ་རྣམས་དགའ་བ་བསྐྱེད་ཅིང་རང་གཞན་གྱི་ཞེ་སྡང་ཞི་བར་བྱས་པ་དེ་གཅིག་ལགས་ཏེ་མི་འོང་མཆི།",
    "དལ་བར་བསྡད་དུ་ཕངས་པར་གདའ་བས།",
    "ཁོང་རང་ཡང་ངེས་ཤེས་སྐྱེས་ནས།",
    "སྐྱེས་པ་ཀུན་རྟ་རྩེད་ལ་སོགས་པ་མང་པོ་བྱེད་ཀྱིན་འདུག་པ་ལ།",
    "ཁྱད་པར་དུ་ལངས་ནས་རྟ་རྒྱུག་པ་ལ་ཆགས་ཀྱིན་གདའ་ཞུས་པས།",
    "ཕངས་པར་འདུག་གསུངས་ནས་མ་གནང་།",
    "དེས་ན་གནས་སྐོར་སོགས་འགྲོ་འདུག་མང་པོ་མི་བྱེད་པར་གནས་བཟང་པོ་གཅིག་ནས།",
    "མཇུག་ཏུ་བྲག་འོག་ཅིག་ན་འདུག་པས།",
    "ཚྭ་མེད་པས་ལུས་ལ་སྤུ་ཆེན་པོ་སྐྱེས་འདུག་པ་མཐོང་ནས།",
    "གཉེན་ལ་ཡང་ཕན་པ་ཞིག་འདུག་སྟེ།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "མ་འགལ་འདུག་ན་རང་ལ་དགའ་བ་སྒོམས།",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཚོད་ལོངས་པ་མི་འདུག་ཟེར།",
    "ང་ལ་ཡང་བཟའ་རྒྱུ་འདྲ་སྟེར་རམ་བསམས་ནས་ཡོད་ཙ་ན།",
    "སྐྱོ་ཚ་སྐོལ་བའི་ཟན་ཁ་ལེ་འདུག་པ།",
    "བུ་རམ་ཡང་འདུག་པས།",
    "ང་ལ་ཟན་མར་ཅིག་དང་སྐྱོ་ཚ་ཞིག་སྟེར་བར་འདུག་དེ་ཡང་ཟན་དང་སྐྱོ་ཚ་སྦགས་ནས་ཟ་བུ་རམ་ལ་བཅུད་བྱེད།",
    "མར་ལ་སྐུ་མཉེ་བྱེད་བསམས་ཏེ་དགའ་ནས་ཡོད་ཙ་ན།",
    "ཁྱེད་ཀྱིས་ལྔ་མ་ལེན་ཤོག་བྱས་དུས་ལག་ན་ཅི་འདུག་གསུངས།",
    "ལག་ན་ཕོར་གོག་སྟོང་པ་ཞིག་འདུག་ཞུས་པས།",
    "འོ་དེ་ཡིན་སྒྲུབ་པ་པོ་རྒྱགས་མེད་ཅིག་ཡིན་པར་འདུག་པས།",
    "གླང་ཐང་པ་ཆེན་པོ་སྐུ་འདའ་རུ་འཆའ་ཙ་ན།",
    "ཐ་མལ་གྱི་སྣང་བ་ཙམ་ཡང་མི་འདུག་གསུངས།",
    "རྒད་པོ་ང་ཡི་བྱ་བ་ཚར་ནས་གདའ།",
    "འགྲོ་འདུག་འགུལ་སྐྱོད་སོགས་བྱ་བ་གང་བྱས་ཀྱང་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས་མ་འདས་པ་ལྟར།",
    "ལྟོགས་ཡོད་དུས་རྩམ་པ་དང་ཤ་སོགས་ཟོས་ན་བདེ་ཆམ་མེ་འགྲོ་བར་འདུག་པས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གསུང་ན་ཅི་འདུག་མ་འོངས་པ་ན་ངའི་ཉན་ཐོས་ཡིན་ཟེར།",
    "ཅིས་ཀྱང་དགོས་པ་མེད་ཙ་ན།",
    "བྲག་སྟོད་མཐོན་པོར་བྱ་རྒོད་གནས་འདུག་སྟེ།",
    "འགྲོ་འདུག་འགུལ་བསྐྱོད་སོགས་བྱས་པས་ལུས་མི་བདེ།་",
    "ཕལ་ཆེར་ཤིང་མེ་ལ་བསྲེག་དུས་འཆི།",
    "ས་གཤག་དུས་ཞིང་ཐོག་ན་སྲིན་བུ་ཆེ་ཆུང་གང་ཡོད་ཐམས་ཅད་ས་འོག་ཏུ་བདས།",
    "ད་བློ་ལྡན་རྣམས་ཀྱིས་ཟས་འདི་ཡང་བདེ་བའི་རྒྱུ་རུ་མ་བསམས་པར་སྡུག་བསྔལ་བསྐྱེད་པའི་རྒྱུ་འབའ་ཞིག་ཏུ་འདུག་སྙམ་དུ་བསམ་པ་གལ་ཆེ།",
    "ཟས་བཟང་ངན་གང་ཡིན་རུང་སྲོག་འཚོ་ཙམ་གྱིས་ཆོག་པར་འདུག་སྙམ།",
    "གསུངས་པ་ལ་འཁྲིས་ནས་ཤ་བཞེས་ཀྱིན་འདུག་སྟེ།",
    "ཟ་བ་པོ་མེད་ན་གསོད་པ་པོ་མི་འབྱུང་ཟེར་བ་འདུག་གསུངས་པས།",
    "ཐགས་སུ་འཐག་དུས།",
    "དེ་འདྲ་རྗེ་མི་ལ་སོགས་སྔོན་གྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱིས་ལག་ལེན་ལ་ཡང་བཏབ་འདུག་དེང་སང་དེ་ལྟ་བུ་ཕར་ཞོག་དེའི་ཆ་འདྲ་ཙམ་ཡང་བྱེད་མཁན་མེད།",
    "རྗེས་འཇུག་རྣམས་ལ་ཅི་གསུངས་འདུག་དེ་ལྟར་བསྒྲུབ་དགོས་པ་ཡིན།",
    "ཇི་ལྟར་འདུག་ལ་བསམ་བློ་ཐོངས།",
    "འདོད་ཆགས་ཁོ་རང་བདེ་བ་ཡིན་ན་སྤྱད་ཀྱིན་བདེ་བ་ཆེར་འགྲོ་དགོས་ཏེ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནའི་ཞལ་ནས།",
    "ཐབས་མཆོག་ཁྱད་པར་ཅན་ཞིག་དེ་ན་གདའ།",
    "སྟོན་གྱི་ཁྱི་ལྟར་སྤྱོད་པ་རྣམས་ཀྱིས་ལས་ལ་མཁའ་འགྲོ་ཀུན་གྱིས་ཧིས་རིང་པོ་འདེབས་ཀྱིན་ཡོད་ཚོད་ན་འདུག་པས།",
    "རང་སྣང་ལྷའི་ཞིང་ཁམས་དང་རང་ལུས་ལྷ་རུ་གྱུར།",
    "ཡི་དམ་བརྙས་འདུག་དེ་བཞིན་དུ་རྟག་ཏུ་ངུ།",
    "དེ་ཡིན་ན་འོ་སྐོལ་རྣམས་ཀྱིས་ཡི་དམ་ལྷའི་ཀླུང་རྟ་དར་དུ་བཅུག་འདུག་དད་ངས་བསམས་ན་ཡི་དམ་ལྷའི་ཀླུང་རྟ་དར་བ་ཡིན་མིན་མི་ཤེས།",
    "ཨོཾཨཱ་ཧཱུྃ་བཏོན་ནས་ཟོས་ཀྱང་སྡིག་སྒྲིབ་མི་ཡོང་ཞེས་གསུངས་འདུག་ཟེར་ན།",
    "དེ་ཡིན་ན་ལས་སླ་བ་འདུག་ཨོྃཨཱ་ཧཱུྃ་མི་ཤེས་པ་མེད།",
    "འདོད་ཡོན་ལ་སྤྱད་ནས་སྒོ་རུ་སྐྱག་པ་གཏོང་བའི་འགྲོ་ཞོར་ལ་སྒོ་ཡི་ཡ་ཐེམ་ལ་བྲིས་པའི་པདྨོ་ཨུཏྟཱི་ཥའི་འོག་ཏུ་འཛུལ་ན་དེ་གཅིག་པུས་ཆོག་པར་གདའ།",
    "སྔགས་ཀྱི་སྒོར་ཞུགས་པས་ཐོག་མཐའ་བར་གསུམ་དུའང་འདོད་ཡོན་ལྔ་ལ་སྤྱད་ཆོག་ཅེས་རྒྱུད་དུ་མ་ནས་གསུངས་འདུག་དེས་ན་འདོད་ཡོན་ལ་སྤྱད་རུང་སྐྱོན་གྱིས་མི་གོས་པའི་རྟགས་ཡིན་ཟེར་ན།",
    "མིས་མི་བྱེད་པ་ཞིག་བྱེད་ཀྱི་འདུག་ཀྱང་མ་བྱས།",
