    "དེ་ནས་ཕྱིས་སྐྱ་བཞི་རོལ་གཅིག་བཏང་ནས་སྤྱན་དྲངས་ཙ་ན།",
    "འོན་ཀྱང་སྣོད་ལྡན་དང་མཇལ་བར་འདུག་གམ་ཡང་ཟེར་ཡིན་འདུག་པས་མཇལ་བ་ཡང་སྲིད་ཀྱིས་གསུང་།",
    "དཔལ་ཞི་བ་བཟང་པོ་ཅན་དུ་ཕྱིན་ནས་མཇལ་བ་ལ་གསེར་སྲང་གཅིག་ཕྱག་རྟེན་བྱས་ཙ་ན་ཕྱག་ནར་གྱིས་བརྐྱང་ནས་ལེན་དུ་མ་བཞེད།",
    "ཡང་ཤེས་རབ་སེང་གེ་ཅན་དུ་ཕྱིན་ཙ་ན།",
    "གསེབ་ན་འདུག་པ་ལ་གསེར་ཕུལ་བས་གཏོར་ནས་བཏང་།",
    "ཟེར་བའི་སྒྲ་གཅིག་གྲག་འོ་ན་གཉིས་ཀ་གཟུང་འཛིན་དུ་འདུག་པས་ད་ལྟ་གཅིག་པུས་བཙལ་དགོས་སྙམ་པ་དང་ཤེས་རབ་སེང་གེ་ལ་ད་གང་དུ་བཙལ་ཞུས་པས།",
    "ད་རིང་པོར་མི་ཐོགས་ཕར་རྙེད་གྱིས་སྙམ་ནས་ཞག་བདུན་བར་དུ་གསོལ་བ་བཏབ་ཙ་ན།",
    "ཟེར་བའི་སྒྲ་གཅིག་གྲག་ཡང་ཕྱིན་ཙ་ན་ཕྱུགས་རྫི་གཅིག་དང་འཕྲད་པ་ལ་ནཱ་རོ་པ་དྲིས་པས།",
    "རོ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ་གཅིག་འདུག་པ་དང་།",
    "ཡང་བཙལ་ཙ་ན་བྱེ་ཀླུང་གཅིག་ན་བཞུགས་ནས་འདུག་པ་ལ་གསེར་ཕྱེའི་ཚོམ་བུ་བཀོད་པའི་མཎྜལ་གཅིག་ཕུལ་ནས་གདམ་ངག་ཞུ་བྱས་པས།",
    "མར་པས་ཤུལ་དུ་བལྟས་ཙ་ན་གསེར་མཎྜལ་སྟེང་ན་སྤུང་ངེ་འདུག་དེ་ཚགས་བྱས་ནས་ཕྱི་ལ་འབྲང་ཙ་ན་ཐང་དཀྱིལ་གཅིག་ན་ནཱ་རོ་པ་ཉིད་ཀྱི་སྐུར་བཞུགས་ནས་འདུག་པ་ལ།",
    "མེ་ཏྲི་བ་ལ་ཕྱི་ཕྱག་ལ་ཕྱིན་ཙ་ན་ཕྱག་རྒྱ་ཆེན་པོའི་གདམ་ཟངག་རྩོལ་བདོའི་བར་འདུག་པ་དང་།",
    "རྒྱལ་ཁམས་སུ་ང་གྲགས་པ་ཆེ་བར་འདུག་གམ་མི་འདུག་གསུང་པ་ལ།",
    "ཞང་སྟོན་གྱིས་གྲགས་སྙན་ཆེ་བར་གདའ་བྱས་པས།",
    "ང་རང་སྙན་པར་མི་གྲགས་རྒྱུ།",
    "དེར་བཤོས་ཁྱེར་ནས་སྔོན་ལ་ཕྱིན་ཙ་ན་གཟིམས་མལ་ན་བཞུགས་ནས་འདུག་པ་དང་།",
    "དུ་བྱོན་ཙ་ན།",
    "འདི་ད་ལྟ་ཤི་ནས་ཡོད་ཙ་ན་སེ་ཏེ་བན་བན་བྱུང་ན་ཟེར་བ་ལ།",
    "འོ་ན་ང་རང་ཡང་གྲོང་འཇུག་གཅིག་བྱེད་ཟེར་བ་ལ།",
    "ཉིན་གཅིག་མ་དང་འཕྲད་ཙ་ན།",
    "དེར་གཡུང་སྟོན་གྱི་ལམ་རྒྱ་ཡོད་ཟེར་ནས་ཁ་རག་ལ་ལམ་རྒྱ་ལ་ཕྱིན་ཙ་ན་སྔགས་པ་ཡང་རྒན་སྐྲ་སེ་འབའ་ལེ་བ་གཅིག་འདུག་པ་ལ་རྟ་དྲུག་ལྟང་རྩེ་དང་བཅས་པ་རྣམས་ཕུལ་ནས་ངེད་ལ་མཐུ་ཞུ་དགོས་བྱས་པས།",
    "ཁྱེད་ཀྱིས་ང་གསོད་པའི་གྲབས་བྱེད་ཀྱིན་འདུག་སྟེ་ད་སེར་བ་འབེབས་སོ་བྱས་པའི་ཤོག་འཕྲིན་གཅིག་བསྐུར་ནས་བཏང་།",
    "དེར་ཡར་ལུང་དུ་ཕྱིན་ཙ་ན་སེར་བ་ཕེབས་སམ་ཟེར།",
    "དེ་ནས་ཡང་བུ་དང་མི་ལ་གཉིས་ཐུན་གསོར་བཅུག་དེ་ནས་སློབ་དཔོན་གྱི་གཡོག་བྱེད་ཀྱིན་བསྡད་ཙ་ན།",
    "བློ་བདེ་བ་གཅིག་ལ་དབྱར་དགུན་གསུམ་བསྡད་ཙ་ན།",
    "ང་རང་ཡང་ནུས་ཚད་ཀྱིས་ཁྲོ་གཉེར་ཅན་གྱི་བཟླས་པ་བྱེད་པ་ཡིན་ཏེ་ཉལ་མ་མྱོང་།",
    "ས་བཀྱག་ཏུ་སླེབས་པ་དང་མི་རྒན་ཕྲུ་བྱེད་པ་གཅིག་འདུག་པ་ལ།",
    "མི་ཀུན་ཕྱག་བྱེད་ཀྱིན་འདུག་པ་ལ་ཡང་རྟོག་པ་མ་ཞུགས།",
    "ཁོང་རང་ཡང་ཕྲུ་བྱེད་ཀྱིན་ཆང་གསོལ་གྱིན་འདུག་མི་ལ་ལ་ཡང་བྱིན།",
    "ད་ཅིའི་མི་རྒན་ཕྲུ་བྱེད་པ་དེ་གདན་ཁ་གཅིག་ན་འདུག་པ་ཙུག་བྱའམ་སྙམ་པས་སྐྱེངས་པ་གཅིག་བྱུང་བ་དང་ཚམ་མེ་ལུས་པ་དང་།",
    "རྒྱགས་ཕྱེ་བསྐུར་ནས་ཕྱིན་ཙ་ན།",
    "ཡང་མ་བསྡད་པར་འོངས་ནས་གཞུང་དུ་བརྡོལ་ཙ་ན།",
    "དེར་སེར་བ་གཅིག་ཕབ་ཙ་ན་ལོ་འདར་འདུར་དུ་ཁྱེར།",
    "ང་རང་ཕྱི་གཟུང་བའི་ཐག་པ་རྩད་ནས་ཆོད།",
    "ཆང་ས་གཅིག་ན་བྲག་དཀར་སྤོ་མཐོན་ལ་མི་ལ་རས་པ་ཟེར་བ་གཅིག་བསྒོམ་གྱིན་འདུག་སྟེ།",
    "བཀའ་བརྒྱུད་དགུ་བཅུ་གོ་བཞི་། བ་ཡིན་ནམ་སྙམ་ནས་བལྟར་འགྲོ་བ་དང་འགོ་བན་གཅིག་ཀྱང་འགྲོ་བ་དང་འཛོམས་ནས་ཕྱིན་ཙ་ན་མི་རིད་གཅིག་ངོ་མ་ཤེས།་",
    "ཡོན་བདག་བཟའ་མི་གཉིས་སྡུག་བསྔལ་གྱིས་ཟིན་ནས་འདུག་ཙ་ན།",
    "བྲག་གསེབ་ན་བཞུགས་པ་འདི་ལམ་ཡང་མི་བདེ་བར་འདུག་པས་ས་བདེ་བ་གཅིག་ཏུ་བཞུགས་པར་ཞུ་བྱས་པས།",
    "འདིར་མཐུན་རྐྱེན་མ་འཛོམས་ལ་ཉམས་མི་དགའ་བ་གཅིག་འདུག་པ་ལ།",
    "འབྲས་བུ་འཁྲུལ་ནས་འདུག་སྟེ་འཇིག་རྟེན་གྱི་ཆེན་པོ་གཅིག་ལས་མི་ཐོབ་པར་འདུག་པས་ད་ངས་ཅི་ཐོབ་ཀྱི་ཕྱུགས་ཀྱི་སྐལ་བ་རྣམས་རྗེ་བཙུན་མི་ལ་ལ་ཕུལ་བདུན་ཚིགས་ཞུས།",
    "པེ་ཏ་མ་ངོ་ནག་ཏིང་ངེ་འདུག་ནས།",
    "རང་སྣང་ཤེས་པ་དགའ་ཡིན་གདའ།",
    "དེར་ལོ་རས་སྤྱན་འདྲེན་དུ་ཕྱིན་ཙ་ན།",
    "བལ་བོད་ཀྱི་མི་འདུག་ཚད་ཞལ་བལྟ་བས་བསྐོར་ནས་ཡོད་ཟེར་བ་ལ།",
    "མི་ལའི་འཁོར་རྣམས་ཀྱིས་ཡོ་འགྲོ་ཡིན་འདུག་པའི་འོ་སྐོལ་ཡང་གཤེགས་སམ་བྱས་པས།",
    "ནངས་པར་ཙ་ན་ཤུལ་ཀྱང་མེད་པར་བདེ་ནས་འདུག་དེ་ལ་ཅི་མཛད་པས་བདེ་ཞུས་པས།",
    "ཡང་ཉིན་གཅིག་བྲག་རྩ་ན་ཐུགས་དམ་མཛད་ཀྱིན་བཞུགས་ཙ་ན།",
    "བཟའ་གཞན་མི་དགོས་པར་འདུག་གསུང་།",
    "ཡི་དམ་ལྷའི་ཞལ་མཐོང་བས་གྲུབ་ཐོབ་ཡིན་ཟེར་བྱས་པས་འོ་ན་གྲུབ་ཐོབ་མི་འདུག་གསུང་།",
    "དེར་གཟིམས་སྐྱོར་གློར་བལྟས་ཙ་ན།",
    "མེ་ཆ་གཅིག་དང་གྲི་གཅིག་འདུག་གོ།",
    "གདོན་གྱི་ཆོ་འཕྲུལ་ཡིན་ནམ་གསུངས་ནས་འདུག་ཙ་ན།",
    "དེར་ཇ་ཞོ་གཉིས་ཕྱག་རྟེན་རྒྱུ་ཁྱེར་ནས་ཉིན་ལམ་བཞི་བཅུ་ཕྱིན་ཙ་ན་བྲིན་སྙེ་ནམ་མཚམས་སུ་སླེབས།",
    "ཁྱེད་དུ་གདའ་ཟེར་བས།",
    "དགའ་རབ་འདུག་སྟེ་ལེགས་པར་བསྐྱང་ཡང་འབྲས་བུ་གཟུགས་མེད་ལྷ་བཅུ་ཐམ་པ་གསེར་འཕྲེང་།",
    "ད་ལྟར་དྲོས་ཀྱིན་གདའ་སྟེ་དགུན་རྐྱང་དྲོས་སམ་ཞུས་པས།",
    "གླེང་སློང་བྱེད་ཀྱང་ཉམ་མི་ང་བར་འདུག་གོ།",
    "དེ་ནས་བདུད་བཞིའི་བར་ཆད་ཀྱིས་མི་ཚུགས་པར་འདུག་སྙམ་པར་བྱུང་གསུང་།",
    "གཉིས་ཀ་ན་འབྱོན་པ་ཞལ་གྱིས་བཞེས་ཀྱིན་འདུག་པས་གཉིས་ཀའི་རྟོག་པ་ལ་ཙུག་ཡིན་ནམ་སྙམ་ནས་ཡོད་ཙ་ན།",
    "ཁྲིད་མཛད་ཀྱིན་གདའ་སྐད།",
    "ངས་ནི་མི་ལ་བཟླས་ཀྱང་མི་ཡལ་བར་འདུག་རྟོགས་པའི་གནས་ལུགས་ལབ་ནས་སླར་ལ་ཕན་ཐོགས་ཆེ་བར་འདུག་སྟེ།",
    "ད་ལྟ་དོན་དམ་སྐྱེ་སླ་བར་འདུག་གསུང་།",
    "ཁོ་བོ་སྐྱེས་ཙ་ན་ཟོ་ཞབས་གཅིག་འདོན་པ་སྙམ་བྱེད་ཙ་ན།",
    "དེ་ནས་ཡུམ་གྱིས་ཆབ་འཆག་པ་ལ་མ་འདི་ང་ལ་ངོ་ཚ་མི་སྟེར་བར་འདུག་སྙམ་པ་བྱུང་བས་སྐྱེ་བ་སྔ་ཕྱི་དྲན་པ་ལ་སོགས་ཐམས་ཅད་བརྗེད་གསུང་།",
    "མདང་ངའི་རྨི་ལམ་དུ་མི་བུར་གྱི་ལུང་པ་ཁེབས་པའི་མི་ཆེན་པོ་གཅིག་ཞྭ་གནམ་ཙམ་གཅིག་གོན་ནས་བྱུང་བ་རྨིས་ཙ་ན།",
    "འགྲོགས་ནས་སྒམ་པོ་བའི་སྤྱན་སྔར་བྱོན་ཙ་ན།",
    "དེ་ང་རང་སྔར་༧ ཤེས་པའི་གདམ་ངག་གསུང་དགོངས་ནས་བྲང་ཁང་དུ་བྱོན་ནས་ནང་དུ་གཟིམས།",
    "ལྟ་བ་ལྟ་རྒྱུ་ཐམས་ཅད་དང་བྲལ་བ་སྤྲོས་མེད་དུ་འདོད་པར་གདའ།",
    "དེ་ཙུག་བསླབས་པས་ཀྱང་བག་མི་འོང་པ་གཅིག་གདའ་བྱས་པས།",
    "དེ་ནས་གཙང་དུ་འཇིམ་གྱི་སྤྱན་སྔར་ཕྱིན་ཙ་ན།",
    "དེར་སྟོན་འཇམ་གྱིས་ཐོས་ནས་བྱུང་བས་ཁྱེད་ལ་ལས་སྒོམ་མ་སྐྱེས་པར་འདུག་ཟེར་གསུང་པ་ལ།",
