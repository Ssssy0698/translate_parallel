    "དེ་ལྟར་ནམ་མཁའ་ལྡིང་གི་རྒྱལ་པོ་ངང་པས་འགྲོ་བར་ཡང་བྱེད་པ་དང་།",
    "ད་པེར་ན་གང་གི་ཕྱིར་མི་རྣམས་ཀྱི་མིའི་འཇིག་རྟེན་༢ ༦ བཀའའགྱུར།",
    "ན་༡གང་ལ་ཉིན་མོ་ཡོད་པ་དེ་ལ་ཅིས་ཀྱང་མཚན་མོ་ངེས་པ་ཁོ་ན་ར་འབྱུང་ངོ།",
    "དེ་ལ་ལྷ་གང་ད་ག་ལེགས་པར་བྱས་པའི་ལས་རྣམས་ཤིན་ཏུ་ཟད་པར་གྱུར་པ་དེའི་ས་གཞི་༤འདི་དག་ག་གི་རྣམས་མནན་ན་ནེམ་ལ་བཏེག་ན་འཕར་བ་ཟད་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་ལྷ་དེ་དག་གི་ལེགས་པར་བྱས་པའི་ལས་ཀྱི་མཐའ་ལ་སྤྱད་པ་རྣམས་ནི་གདོན་མི་ཟ་བ་ཁོ་ན་ར་ཟད་པར་བྱུང་ངོ་ཞེས་ཀྱང་ཁ་ཅིག་ཟེར་ར་རོ།",
    "གཞན་ཡང་ལྷ་དེ་དག་གི་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "འདི་དག་གི་རྒུད་པ་རྣམས་ནི་འོང་ས་པར་གྱུར་ཏོ་། ཞེས་རྗོད་པར་བྱེད་དོ།",
    "བྱས་པར་གྱུར་པ་རྣམས་གང་གི་ཁྱད་པར་གྱིས་ཉི་མའི་དཀྱིལ་འཁོར་གྱིས་ཀྱང་བཅུ་དྲུག་ཆ་ར་ཡང་མི་ཕོད་ད་དོ།",
    "ཀི་བཾ་གཞན་དུ་སོང་བར་གྱུར་པ་དེ་ཡང་ཐོས་ནས་བམོད་ནམས་ཟད་པར་གྱུར་པའི་ལྷ་དེ་དག་རང་ཉིད་སོ་སོར་རབ་ཏུ་རིག་པར་བྱེད་ད་དོ།",
    "དེ་བཞིན་དུ་ལྷའི་བུ་མོ་རྣམས་ཀྱང་ཉམས་པ་མེད་པའི་ཤུགས་ཀྱིས་འགྲོའོ་༤།",
    "ལྟ་བབཞིན་དུ་ཟད་པས་ར་བ་ཏུ་འཇུག་པ་རྣམས་ཀྱིས་ཚིམ་པ་མེད་པར་གང་གི་ཕྱིར་ལས་རྣམས་ཀྱིས་བཅིངས་པའི་ལུས་ཅན་རྣམས་འཇིག་རྟེན་ཕྱི་མར་འགྲོ་བར་བར་བྱ་དགོས་སོ།",
    "དུད་འགྲོའི་སྐྱེ་གནས་རྣམས་སུ་བདག་ཅག་གི་ལྷའིརིས་ན་ས་ཤི་འཕོས་ན་ས་འགྲོ་བར་འགྱུར་བ་ན་ཡང་སྟེ།",
    "མུ་སུ་ལུན་དྷ་ཐོག་མར་གྱུར་པའི་ལྷ་དེ་དག་རྣམས་ཐམས་ཅད་ཀྱང་གང་ན་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་བཞུགས་པར་སྔར་བཞིན་དུ་དེར་ཉེ་བར་སོང་ངོ།",
    "དེ་ལྟར་ཡོན་ཏན་བདུན་དང་ལྡན་པའི་གྲོགས་པོ་སྟེན་༢པའི་སྐྱེས་བུ་རྣམས་ནི་བདག་ཅག་གི་འཇིག་རྟེན་ལས་ཤི་འཕོས་ནས་ལྷའི་འཇིག་རྟེན་དག་ཏུ་སྐྱེ་བར་འགྱུར་རོ།",
    "རྒྱལ་པོའི་བློན་པོ་ཡང་རུང་སྟེ་བདེ་བས་སྐྱེད་མོས་ཚལ་གྱི་ལྟད་མོ་ལ།",
    "ལུས་དང་ངག་གི་༩ལས་ཀྱི་མཐའ་རྣམས་ནི་༡༢ཞི་བ་དེ་དག་ནི་ལུས་ཞིག་ནས་མཐོ་རིསབདེ་འགྲོ་ལྷའི་འཇིག་རྟེན་དུ་སྐྱེའོ།",
    "ཁྱིམ་ནས་ཁྱིམ་དུ་སློངས་༡མོས་འཚོ་བར་གྱུར་པ།",
    "རྒྱུ་འདི་དག་གིས་ན་སྐྱེས་བུ་རྣམས་ཐམས་ཅད་ཀྱིས་ཀྱང་གནས་སྐབས་ཐམས་ཅད་དུ་ཡང་ལེ་ལོ་ཡོངས་སུ་སྤང་བར་བྱའོ།",
    "དེ་དག་ཡང་མོར་བྱེད་པ་དང་།",
    "རྟག་ཏུ་ཡང་རྐྱེན་རྣམས་ལས་མིག་གིས་གཟུགས་མཐོང་བ་ན་དེའི་ཚེ་འདུན་པའི་འདོད་ཆ་གས་༥ཀྱིས་ད་གའ་བར་མི་བྱེད་དོ།",
    "ཉོན་མོངས་པ་བདུད་ཀྱི་སྤྱོད་ཡུལ་རྣམས་ལ་དགའ་བར་མི་འགྱུར་རོ་། དེས་སྐྱེས་པའི་འཇིགས་པ་རྣམས་ཀྱང་ཀུན་ནས་ཤེས་ས་སོ།",
    "ལེགས་པར་དྲན་ན་ས་ཇི་ལྟར་ཆེ་གེ་མོ་ཞིག་གི་ཡུལ་ན་ད་མིགས་པ་འདི་དག་གིས་དང་།",
    "ཇ་༡ཇཔའི་ཡུལ་གྱི་རླན་གྱིས་ཀུན་ཏུ་བསྐྱེད་པར་གྱུར་པའི་དུས་དེའི་ཡིད་ལ་བྱེད་པའི་ཉོན་མོངས་པ་ངེས་པར་འཇོམས་པ་པོ་རང་གི་ངང་གིས་ནུས་པ་དང་ལྡན་པས་ཉོན་མོངས་པ་ངེས་པར་འཇོམས་པས་༡རབ་ཏུ་འཇོམས་པར་གྱུར་པ།",
    "ཞིབ་མོར་བྱེད་ཅིང་དྲི་མ་མེད་པར་བྱེད་དོ།",
    "འདིར་གང་གི་ཚེ་སྡུག་བསྔལ་དང་།",
    "ཚོང་དུས་དག་ཏུ་སོང་ན་ས་རྙེད་པ་དང་བཀུར་སྟིའི་༐",
    "མཐོང་བ་༨དུག་ཅན་བཞིན་དུ་རྣམ་པ་དུ་མར་ཡང་བུད་མེད་ཀྱི་འགྲོ་བ་རྣམས་ཡོངས་སུ་སྤོང་བར་བྱེད་དོ།",
    "གང་གི་ཕྱིར་ཡིད་འཕྲོག་པར་བྱེད་པ་དུད་འགྲོའི་སྐྱེ་གནས་པ་རྣམས་སས་མ།",
    "བུད་མེད་དག་གམ།",
    "ཆུ་ཤིང་གི་འབྲས་བུ་དང་།",
    "ཨ་མྲ་དང་།",
    "དངུལ་དང་གསེར་ལ་མོགས་པ་རྣམས་ཀྱང་ཡིད་ཀྱིས་སེམས་པར་མི་བྱེད་དོ།",
    "མོན་སྲན་གྲེའུ་རྣམས་མ་བཏགས་༡༧པར་ཟ་བར་མི་བྱེད་དེ།",
    "སྲིན་བུ་དག་འདི་དག་གི་ནང་ན་གན་ས་པ་ཡིན་༢༢པའི་ཕྱིར་རོ།",
    "རྔུལ་བ་ལས་བྱུང་ཞིང་རང་གི་ལུས་ལས་ལངས་པའི་སྲིན་བུ་རྣམས་སྤོང་བར་མི་བྱེད་དོ།",
    "ནོར་ཆེན་པོ་རྣམས་གང་གི་རྒྱུས་ལྷའི་སྐྱེ་བར་གྱུར་པ་ཁྱེད་ཀྱི་རྩེད་༥མོ་འདི་དག་ཡིན་གྱིས་༦དེ་ནི་བག་མེད་པས་འདའ་བར་མི་འོས་སོ།",
    "རབ་ཏུ་ལྷུང་བར་གྱུར་ཏ་རེ་༧།",
    "རྒུད་པའི་མི་ལམ་ལོག་གི་སྡུག་བསྔལ་གྱི་རང་བཞིན་རྣམས་ཀྱིས་༡གང་བར་གྱུར་པའི་ཕྱིར་ན།",
    "འགྱོད་པའི་དུས་སུ་ཕྱིན་པ་སྡུག་བསྔལ་ཆེན་པོ་སྐྱེས་པར་གྱུར་པ་ཀུན་ཏུ་ཉེ་བར་གནས་པ་རྣམས་ལ་ཅི་ཡང་བྱར་མེད་པའི་དུས་སུ་སོང་བ་ན་ལས་ཀྱི་ཐག་པས་ཀུན་ན་ས་བཅིངས་ན་ས་གཅིག་པུ་ཞིག་གྲོགས་མེད་པར་ཁྲིད་པར་གྱུར་པ་ན།",
    "དེ་དག་གང་ཡིན་པ་ལྷ་དག་གིས་༤ངེས་པར་གོ་བར་གྱིས་ཤིག།",
    "བཅོམ་ལྡན་འདས་གསེར་ཐུབ་འདིའི་མཆོད་རྟེན་དེར་འཇུག་པར་བྱ་བ་དང་ཇི་ལྟ་བ་བཞིན་དུ་བདག་ཅག་གིས་བལྟ་བར་བྱའོ།",
    "དེ་ན་ས་ལྷ་དེ་དག་ཉིད་ཐམས་ཅད་མུ་སུ་ལུན་དྷ་དང་བཅས་པ་རྣམས་གང་གི་ཚེདྲང་སྲོང་མཆོག་གི་སྐུ་གདུང་དེའི་དྲུང་དུ་ཉེ་བར་ལེགས་པར་འགྲོ་བའོ།",
    "རྩིག་༦པ་འདི་དག་གི་ལོགས་ལ་གང་དག་དེ་བཞིན་གཤེགས་པ་དེས་བསྟན་ཅིང་སྤྲུལ་པ་མཛད་པ་རྣམས་ལ་རྟག་པར་རྒྱུན་དུ་བལྟ་བར་ཡང་གྱིས་ཤིག།",
    "ལས་བདག་གིར་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཅེ་བར་གཞག་པ།",
    "ཇ་༢༧པ་དག་གི་མྱ་ངན་གྱིས་གདུངས་པར་གྱུར་༐",
    "བདེ་བའི་རེག་པ་རྣམས་ཕུན་སུམ་ཚོགས་པར་གྱུར་པ་ལས།",
    "སྐོམ་པསབསྲེགས་པའི་ལུས་ཅན་རྣམས་ཉི་མ་རེ་རེ་ཞིང་ངུ་བ་མཆི་མ་འཛག་པས་ངུ་བར་བྱེད་པའི་བཞིན་གྱིས་དུས་རིང་དུ་རྣམ་པ་དུ་མར་ཤིན་ཏུ་རྩུབ་པའི་ཡི་དགས་ཀྱི་སྡུག་བསྔལ་རྣམས་ཉེ་བར་ལོངས་སྤྱོད་པ་ཡིན་ཏེ།",
    "བག་མེད་པས་བསླུས་ནས་ལྷའི་འགྲོ་བ་ནས་ཡོངས་སུ་ཉམས་པར་གྱུར་པས་ཡི་དགས་ཀྱི་སྲིད་པར་སོང་བ་ཡིན་ནོ།",
    "རྣམ་པ་འདི་ལྟ་བུ་དག་གིས་ལེགས་པར་བྱས་པ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་སེམས་ཀྱིས་བསྒོམས་པར་གྱུར་པའི་ཡིད་ར་བ་ཏུ་དང་བས་འཕངས་པར་གྱུར་པས་སམ།",
    "རྐང་དྲུག་གི་འཇིགས་པ་ཆེན་པོ་དང་བཅས་པ་ད་གོན་པ་རྣམས་དང་།",
    "དེས་ཡང་ན་བུ་དང་བུ་མོ་རྣམས་ཡང་དག་པའི་བདེ་བས་ཡོངས་སུ་བསྐྱངས་པར་གྱུར་པས་སམ།",
    "རང་གི་ལས་ལ་རྣམ་པར་སྤྱད་པ།",
    "དེ་ལ་སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་ཀྱི་ལས་ཀྱི་འགྲོས་ཕྲ་མོ་འདི་དག་རྣམས་ཡང་༤འཐབ་བྲལ་བ་རྣམས་ཀྱིས་ཤེས་པར་བྱེད་ལ།",
    "རྒྱུ་གང་དག་གིས་༡རྒྱལ་ཆེན་རིས་བཞི་པ་རྣམས་ལ་འགྱུར་བའི་ཟུག་གཟེར་༢དེ་དག་རྣམས་བཅུ་༢འགྱུར་གྱིས་སུམ་ཅུ་རྩ་གསུམ་པ་༤རྣམས་འགྱུར་རོ།",
    "རྒྱུ་གང་གིས་ཞེ་ན།",
    "དེ་དག་རྣམས་སུ་ཁྱོགས་གང་དག་སྟེན་པར་བྱེད་པ་ལྷ་རྫས་ཀྱི་བདུད་རྩིས་ཚིམ་པར་བྱེད་པ།",
    "དེ་དག་གི་ཡན་ལག་སོ་སོར་གྱེསཔ་རྣམས་ནི་བརྗོད་པར་སླ་བ་ཡང་མ་ཡིན་ནོ།",
    "དེ་ལྟར་གཟུགས་བརྙ་ན་ལྟ་བུར་གྱུར་པ་དེ་དག་རྣམས་ཐམས་ཅད་ཉིད་ཀྱང་ཚོགས་པ་རྒྱུ་བའི་སར་སྐྱེས་པའི་འཐབ་བྲལ་གྱི་ལྷ་དེ་རྣམས་ཀྱི་མཆོད་རྟེན་གྱི་ལོགས་ལ་རབ་ཏུ་མཐོང་ངོ།",
    "རང་གིས་བྱས་པའི་ལས་ཀྱིས་ཏེ།",
    "རབ་ཏུ་༢འཆི་འཕོས་ནས་ཕག་མོའི་སྐྱེ་གནས་སུ་སྐྱེས་པར་གྱུར་པ་མཐོང་ངོ།",
    "དེ་ལས་དེ་དག་རྣམས་ཡོངས་སུ་ཟད་ཅིང་ཉམས་པར་གྱུར་ནས་ཕག་གི་མངལ་དུ་སྐྱེས་སོ་། དེའི་ལེགས་པར་བྱས་པའི་ལས་རྣམས་ནི་གང་དག་ཡིན་ཞིང་ལེགས་པར་བྱས་པའི་ལས་ཀྱིས་ཀྱང་དེར་སྐྱེས་པ་དང་།",
    "ཇི་ལྟར་ད་བང་པོ་དེ་དག་རྣམས་ཐམས་ཅད་ལྷག་མ་མ་ལུས་པ་རྣམས་ཀྱི་ཡང་༩ངན་སོང་དུ་འགྲོ་བའི་འགྲོ་བ་གཞན་རྣམས་མཐོང་བ་ལ་ཀོ་ཤི་ཀ་ལ་ནི་སྐྱེ་བ་བདུན་གྱི་མཐར་ཐུག་པར་མཐོང་ངོ།",
    "དེས་ན་བདག་གིས་ཁྱེད་རྣམས་ཉིད་ལ་ཕན་པའི་དོན་དུ་ད་ུ་དང་།",
    "འཆི་བའི་ཡུལ་དང་དུས་༤ཀུན་ན་ས་ཉེ་བར་གན་ས་པར་གྱུར་པའི་རྒྱུ་གཉིས་ཀྱི་དངོས་པོ་གཉིས་ཡིན་པར་བདག་གིས་ཐོས་ཏེ་རྒྱུ་གང་གིས་ཀོ་ཤི་ཀ་འདི་༥རིགས་གཉིས་པར་སྐྱེ་བར་འགྱུར་བ་ར་བ་ཏུ་མཐོང་བ་དང་།",
    "དྲང་སྲོང་གིས་ཀོ་ཤི་ཀ་དེ་ལ་འདི་སྐད་ཅས་༢བརྗོད་ད་དེ།",
    "ལྟ་བར་༤ཉོན་དང་ཐབས་གང་གིས་ཀོ་ཤི་ཀ་ཁྱོད་བདག་ཅག་རང་གི་སྟན་ལས་༐",
    "ཐམས་ཅད་གཟིགས་པ།",
    "འགོག་པ་དང་ལམ་མོ།",
    "གཏི་མུག་གི་མུ་༥ནག་གིས་མུན་པར་གྱུར་ཅིང་ཀུན་ལ་ཆགས་པ་༐",
    "བཅོམ་ལྡན་འད་ས་བདག་ཅག་གི་སྟན་འདི་ལས་བདག་སྡུག་བསྔལ་བར་མི་འགྱུར་བའི་ཐབས་བདག་ཅག་ལ་མཆིས་སས་མ།",
    "དེ་ལྟར་ངན་བུ་སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་ཀྱི་རྒྱལ་པོ་བྱེད་པར་འགྱུར་བ་རྒྱུ་འདི་དག་ཁྱོད་ཀྱིས་གཟིགས་སམ་བདག་གི་སྟན་དང་།",
    "ཀོ་ཤི་ཀ་གང་ན་ས་ཤི་འཕོས་པར་གྱུར་པ་སླར་ཡང་སྟན་དེ་ཉིད་ལ་སྐྱེ་བར་འགྱུར་བ་ཡོད་དེ་རྣམ་པ་དེ་ལྟ་བུ་རྨྱོང་བར་ངེས་པའི་ལས་གཞན་རྣམས་འགའ་ཞིག་གིས་ཀྱང་མི་བྱེད་པའི་རྒྱུ་གང་གིས་གང་གི་ཚེ་ཁྱོད་སྟན་༤ལ་སྐྱེ་བར་འགྱུར་ཞིང་སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་ཀྱི་རྒྱལ་པོ་བྱེད་པར་འགྱུར་རོ།",
    "རྒྱུ་འདི་དག་གིས་ངས་མཐོང་བ་ཡིན་ཞིང་ཁྱོད་ཀྱི་སྟན་དང་ལྷག་པའི་སྟན་དང་།",
    "སྐྱེ་བ་དང་ངན་སོང་གི་སྒོ་རྣམས་ཡང་བཅད་དོ།",
    "ལམ་གང་གིས་ནི་གོ་འཕང་༩མཆོག།",
    "བདག་ཅག་རྣམས་འགྲོ་བ་གང་ཞིག་ཏུ་འགྱུར་བ་ལྷའི་ཞལ་སྔ་ནས་རེ་ཞིག་བདག་ཅག་ལ་སོ་སོར་བསྟན་དུ་གསོལ་དེ་བཞིན་དུ་བྱའོ་ཞེས་བརྗོད་ནས་སླར་ཡང་མཆོད་རྟེན་དེ་ཉིད་ཀྱི་རྩིག་༢ལོགས་དེ་ཉིད་ལ་སོ་སོར་རྟོག་པར་བྱེད་ད་དོ།",
    "དེ་སླར་༩ཡང་སྲེད་༡༧པའི་ཡུལ་གྱི་སྲེད་པའིཆུ་ཀླུང་གིས་ཁྱེར་བས་ལེགས་པར་བྱས་པའི་ལས་རྣམས་ཟད་པར་གྱུར་ན་ས་ད་མྱལ་བ་ངུ་འབོད་དུ་ལྟུང་༡༢ངོ།",
    "ཇ་༤ིརང་གི་དོན་རྣམས་ལས་ཉམས་པར་གྱུར་ཏོ།",
    "ཞེས་དེ་ལྟར་ཡང་ཕན་ཚུན་དུ་རྗོད་པར་བྱེད་ད་དེ་གང་བདག་ཅག་རྣམས་ལ་ནི་ཕ་མ་དང་མཚུངས་པར་གྱུར་པའི་གཞན་རྣམས་འགའ་ཞིག་གིས་ཀྱང་མ་བྱས་པ་དེ་འཐབ་བྲལ་གྱི་མངའ་བདག་མུ་སུ་ལུན་དྷ་འདིས་བྱས་ཏེ།",
    "དེ་ལས་དེ་ཤི་འཕོས་ནས་ཀྱང་འཛམ་བུའི་གླིང་གི་རྒྱལ་པོ་རྫུ་འཕྲུལ་དང་ལྡན་པ་མཐུ་ཆེན་པོར་གྱུར་པར་སྐྱེས་སོ།",
    "གང་གིས་བྱིས་པ་རྣམས་༥འཚེད་པའི།",
    "གང་གིས་བྱིས་པ་རྣམ་༦འཚེད་པའི།",
    "དེ་ལས་གང་གིས་འཐབ་བྲལ་བ་རྣམས་ཀྱི་མངའ་བདག་བྱས་པར་གྱུར་༩ནས།",
    "དེ་ལས་ཀྱང་ཤི་འཕོས་པར་གྱུར་ན་ས་ཕྱིས་ཡང་བ་ལངསྤྱོད་པ་རྣམས་ཀྱི་གླིང་གི་མིར་སྐྱེས་སོ།",
    "དེ་ལས་ཀྱང་ཤི་འཕོས་པར་གྱུར་ནས་སླར་ཡང་མི་རྣམས་ལས་ཡུལ་ཆུང་གི་སྐྱེ་བོར་སྐྱེས་སོ།",
    "ཐལ་མོ་སྦྱར་བའི་ལས་རྣམས་འཇིགས་ཤིང་ཞུམ་པར་འགྱུར་བས་བྱེད་པ་དང་།",
    "ཇི་ལྟར་གང་གི་༢ཕྱིར་ཡང་འཛམ་བུའི་གླིང་གི་མི་རྣམས་ཀྱི་དྲུང་ན་ཟླ་ཱ་བས་ནི་ཀུན་ནས་གསལ་བར་བྱེད་དོ།",
    "དེ་དེ་ལས་ཀྱང་ར་བ་ཏུ་༢འཕོས་ན་ས་གཞན་ཡང་ཤར་གྱི་ལུས་འཕགས་པོའི་གླིང་གི་རྒྱལ་པོར་གྱུར་ཏེ།",
    "ཉོན་མོངས་ཟད་པར་སྤྱོད་པ་ཡིན།",
    "འདིའི་འགྲོ་བ་ནི་གང་དུ་འགྱུར་སྙམ་༩པས་དེ་དག་རྣམས་སླར་ཡང་རྩིག་པའི་ཡུལ་ཕྱོགས་དེ་ལ་ལྟ་བར་རྩོམ་མ་མོ།",
    "འདི་ནི་གཟུགས་འགོག་པར་འགྲོ་བའི་ལམ་མ་མོ།",
    "ཉོན་མོངས་པ་མེད་པ།",
    "ཀིས་རྣམས་ན་ལྷའི་བུ་མོ་བརྒྱ་སྟོང་དུ་མས་གླུ་དང་གར་ལེགས་པར་བྱེད་པ་དང་།",
    "སོ་བ་སྐྱེད་༢པའི་ལྷ་དང་ལྷ་མོའི་ཚོགས་ཀྱིས་འཁྲིགས་པར་གྱུར་པ་དང་། ༐",
    "ཨིན་དྲ་ནཱི་༨ལའི་རིའི་རྩེ་མོ་ཕན་ཚུན་ཀུན་ཏུ་འབར་བས་ཉེ་བར་མཛེས་པར་གྱུར་པའི་ཚོགས་པ་རྒྱུ་བ་ན་སྤྱོད་པའི་ས་དེ་དག་རྣམས་ལ་ཀུན་ཏུ་བལྟས་ནས་མུ་སུ་ལུན་དྷ་དེས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "རིའི་རྩེ་མོ་ན་ས་རིའི་རྩེ་མོར་རྩེ་བར་བྱེད་པ།",
    "བརྗོད་པ་ལྷ་བདག་ཅག་གིས་མཐོང་ལགས་༡སོ།",
    "གང་གི་ཕྱིར་ལས་རྣམས་ལས་༢༢ཡིན་པ་འདི་ཡང་སྒོ་གཅིག་གིས་སྡུག་བསྔལ་བར་འགྱུར་བའི་སྐྱེ་བ་མ་བཟློག་པ་ལས་ཡིན་ཏེ།",
    "སྦྱང་བར་༡༢གྱུར་པས་སྐད་ཅིག་རེ་རེ་ཞིང་སྟེན་༡༡པར་བྱེད་དོ།",
    "འཆི་བདག་གི་ཁས་ཀྱང་འཔིགས་པར་བྱེད་དོ།",
    "ལང་ཚོ་༡༢ཡང་གཅིག་ཏུ་དགའ་བ་མ་ཡིན་ནོ།",
    "འབྲལ་བར་འགྱུར་བ་མཐའི་སྡུག་བསྔལ་རྣམ་པ་མང་པོ་མཆོག་ཏུ་མི་བཟད་པའི་འཆི་༡༢བདག་གང་གི་ཚེ་འདི་དག་རྣམས་ངེས་པར་རྟོགས་པར་འགྱུར་རོ།",
    "རང་གི་ལུས་ཀྱི་འོད་འཕྲོ་བས་འོད་དང་ལྡན་པར་གྱུར་པ་མཆོག་ཏུ་རྒྱ་ཆེ་བའི་རྒྱན་དང་ཆ་བྱད་ཅན་གྱི་བུད་མེད་ཀྱི་འགྲོ་བ་སྟོང་གིས་ཡོངས་སུ་བསྐོར་ན་ས་རྣམ་པ་སྣ་ཚོགས་པའི་རྔ་སྐད་རྣམས་དང་།",
    "རང་གིས་བྱས་པའི་ད་གེ་བའི་ལས་རྣམས་དང་ལྡན་པ་རྣམ་པ་བརྒྱ་སྟོང་དུ་མའི་གཟུགས་ཀྱི་ད་པལ་རྣམས་འཛིན་པར་གྱུར་པས་གང་ན་ལྷའི་མངའ་བདག་མུ་སུ་ལུན་དྷ་འདི་ཡོད་པ་དེ་དང་དེར་རིངས་པ་རིངས་པར་ཐག་བསྙེན་པར་གྱུར་ཏོ།",
    "དེ་དག་རྣམས་ཀྱི་རྩེད་མོ་ལ་ལྟོས་པའི་ཕྱིར་རོ།",
    "དེ་དེ་དག་རྣམས་ཀྱི་ནང་དུ་སོང་ནས་ཡུད་ཙམ་ཅིག་རྒོད་ཅིང་༐",
    "འགྱིང་བ་དང་རྩེད་མོ་རྩེ་བ་དག་བྱས་སོ།",
    "ལྷ་རྣམས་ནི་འདོད་པ་དུ་མ་ལ་རྣམ་པར་ཆ་གས་པའི་སེམས་ཡིན་པས་ཀྱང་གཞན་དུ་རིའི་རྩེ་མོ་རྣམས་ལ་རྗེས་སུ་སྟེན་པར་བྱེད་པ་རྣམས་དང་།",
    "ཁམས་དུ་མས་རྣམ་པར་བཀྲ་བའི་རིའི་རྩེ་མོ་རྣམས་ལ་རྗེས་སུ་སྟེན་པ་རྣམས་ནི་བློ་མང་བར་གྱུར་པ་ཡིན་ན་ནོ།",
    "ཡུལ་དུ་མ་རྣམས་ལ་རྣམ་པར་ཆགས་པའི་ཡིད་དང་ཇི་ལྟ་བར་བྲལ་བའི་ལྷ་གང་ཡིན་པ་དེ་དག་རྣམས་ལྷན་ཅིག་ཏུ་གྱུར་པ་དེ་དག་ལ་འཐབ་བྲལ་གྱི་མངའ་བདག་གིས་འདི་སྐད་ཅེས་བརྗོད་དོ།",
    "ར་ང་གི་དོན་ལས་ལྡོག་པར་འགྱུར་བའི་ཡུལ་རྣམས་ཀྱི་དོན་གང་ཡིན་པ་ལས་ཟློག་༡པ་ཉིད་ཀྱིས་བདེ་ལེགས་བྱས་པར་འགྱུར་རོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་རྩེ་མོ་ཉེ་བར་དུད་པར་གྱུར་པ།",
    "དེ་ནས་ལྷ་དེ་དག་ག་གི་དྲུང་ནས་རྣམ་པ་དེ་ལྟ་བུའི་ཚིག་རྣམས་ཐོས་ནས་འཐབ་བྲལ་གྱི་བདག་པོ་དེས་འདི་སྐད་ཅེས་བརྗོད་ད་དེ།",
    "དེ་ནས་ལྷ་དེ་དག་མཆོད་རྟེན་དུ་ཞུགས་༡༢པར་གྱུར་པ་ན་ལྷའི་ཚོགས་རྣམས་ཀྱིས་མཐོང་བར་གྱུར་པ་ནི་དྲང་སྲོང་གི་མཆོག་འོད་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "གཟུགས་དཔེ་མེད་པ་དང་ལྡན་པས་བཅོམ་ལྡན་འད་ས་ཀྱི་སྐུ་གཟུགས་ཀྱི་མཆོད་རྟེན་དེའི་ནང་དུ་སོང་ནས་ལས་ཀྱིས་བྱས་པ་རྣམས་ལསེམས་པས་ལྟ་བར་བྱེད་དོ།",
    "རང་གི་བྱ་བ་རྣམས་ཀྱང་ཡོངས་སུ་བཅོམ་པར་འགྱུར་རོ།",
    "དེ་དག་གིས་དེའི་བར་དུ་གཅོད་པར་འགྱུར་རོ།",
    "ཡུལ་གྱི་ཆུ་མི་བཟད་པའི་རྩེ་མོར་གྱུར་པ་རྣམས་ལེགས་པར་རྒལ་ནུས་པ་ཡང་མ་ཡིན་ནོ།",
    "རི་མོའི་ལས་དང་།",
