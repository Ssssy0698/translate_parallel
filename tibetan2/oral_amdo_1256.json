    "དེ་མེད་པས་གང་གི་ཕྱི་བཞིན་འབྲང་བའི་དྲི་མ་གཞན་དེ་ཡང་མི་འབྱུང་ངོ།",
    "བུད་མེད་རྣམས་ནི་ཕལ་ཆེར་ཡང་ད་བྱེན་བྱ་བའི་བསམ་པ་ཅན་རྣམས་ཡིན་ནོ།",
    "བུད་མེད་རྣམས་ཀྱི་དེ་མེད་པས་དྲི་མ་གཞན་ཕྱི་བཞིན་རྗེས་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "རྒྱབ་ཀྱི་ཤ་ཟ་བའོ་། བུད་མེད་རྣམས་ཕྱི་བཞིན་༡རྣམ་པར་དབྱེ་བའི་བསམ་པ་ཅན་ཡིན་པ་གང་གི་ཕྱིར་དེ་དག་རྣམས་ཐམས་ཅད་ཀྱིས་ཀྱང་རྒྱབ་ཀྱི་ཤ་ཟ་བར་བྱེད་དོ་༢།",
    "གང་གི་ཚེ་རྣམ་པར་འབྱེད་པ་དེ་སྤངས་པར་གྱུར་པ་དེའི་ཚེ་རྒྱབ་ཀྱི་ཤ་ཟ་བ་སྤངས་པར་འགྱུར་རོ།",
    "བུད་མེད་རྣམས་ནི་གསུས་པ་འགེངས་པ་དང་།",
    "གང་གི་ཕྱིར་གསུསཔ་འགེངས་པའི་སྐྱོན་གྱིས་བུད་མེད་དག་བགྲོད་༧པར་བྱ་བ་མ་ཡིན་པའི་སྐྱེས་པ་རྣམས་ལ་ཡང་བགྲོད་པར་བྱེད་དོ།",
    "བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་བགྲོད་པ་གང་གི་ཕྱིར་ན་བུད་མེད་དེ་དག་རྣམས་ལ་ནི་སྐྱེ་བོ་ཐམས་ཅད་དོགས་པ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "སྐྱེས་པ་རྣམས་ཕན་ཚུན་དུ་རྣམ་པ་སྣ་ཚོགས་པར་གྱུར་པ་དེ་དག་རྣམས་ཀྱང་གང་གི་ཕྱིར་ཕལ་ཆེར་ནི་བུད་མེད་ཀྱི་རྒྱུ་ལས་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེའི་ཕྱིར་དེས་དེ་ལྟར་འདོད་ཆགས་རབ་ཏུ་བཅོམ་པའི་ཕྱིར་གཅིག་གི་སྟེང་ན་གཅིག་གན་ས་པའི་དྲི་མ་དེ་དག་རྣམས་ཐམས་ཅད་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "གཞན་དུ་ནི་བུད་མེད་གང་དག་དེ་བཞིན་དུ་མི་འགྱུར་རོ།",
    "ཀུན་ཏུ་འབྲེལ་པ་མེད་པ་རྣམས་རྣམ་པར་སྤངས་ཤིང་ལེགས་པར་བསྒོམས་ལ་ཡང་དང་ཡང་དུ་བསྟན་ཅིང་བསྒོམས་ལ་ལན་མང་དུ་བྱས་པའི་བུད་མེད་རྣམས་ནི་ལུས་ཞིག་ན་ས་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་གྱི་ལྷ་རྣམས་སུ་སྐྱེའོ།",
    "གང་དག་འདོད་པ་རྣམས་ལ་འདོད་ཆ་གས་དང་བྲལ་བའི་ལམ་མ་ཐོབ་པ་རྣམས་ནི་ལས་དང་སེམས་ཀྱི་ད་བང་གིས་འདོད་པ་ན་སྤྱོད་པ་རྣམས་ལས་འཐབ་བྲལ་བ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "༦ཇ་རྣམས་ཀྱི་ནང་གི་ཚོགས་པ་རྒྱུ་བ་ན་རྣམ་པར་སྤྱོད་པ་གང་ཡིན་པའི་སར་སྐྱེའོ།",
    "གཞན་ཡང་ལྷའི་ཚོགས་རྣམས་སུ་གོང་ན་ས་གོང་དུ་འཇུག་པར་བྱེད་པས་བུད་མེད་ཀྱི་སྲིད་པ་སྒྲུབ་པར་བྱེད་དོ།",
    "སྒྱུ་མ་མིག་འཕྲུལ་དེ་ལ་སོང་བའི་སེམས།",
    "སེམས་ནི་རྣམ་པ་དུ་མ་དག་གིས་ཀྱང་།",
    "དེ་ལྟར་མུ་སུ་ལུན་དྷ་དེས་ལྷ་དེ་དག་རྣམས་ལ་ལྷ་ཁྱེད་རྣམས་མིའི་བུད་མེད་དུ་གྱུར་པ་ན་༐",
    "དེ་གལ་ཏེ་བུད་མེད་ཀྱི་དངོས་པོར་གྱུརོ་པས་བསྐྱེད་༢༦ བཀའའགྱུར།",
    "དེའི་ཕྱིར་ན་གཅིག་པུ་ཞིག་གིས་ལྗོངས་རྒྱུ་བར་མི་བྱའོ།",
    "ད་པེར་ན་བདག་གི་རྐང་པ་འདེགས་པ་ལ་སེམས་དང་སེམས་ལས་བྱུང་བས་ཀུན་ཏུ་རྟོག་ཅིང་ཡིད་ལ་བྱེད་པས་དེ་རྐང་པ་ན་ས་༐",
    "ཆུ་རྒྱུས་ཀྱི་སྟོབས་ཀྱིས་སྦྲེལ་བའི་རྐང་པ་དེ་སོར་མོ་ལྔ་པོ་ཐམས་ཅད་༨ཀུན་ཏུ་སྦྲེལ་བ།",
    "པགས་པ་འཐུག་པོས་གཡོགས་༢པ་གང་ཡིན་པའི་པུས་མོ་གཅིག་དེས་ཡང་དག་པ་ཇི་ལྟ་བར་སོ་སོར་ལེགས་པར་རིག་པར་བྱེད་དོ།",
    "པུས་མོ་དང་།",
    "༦༧༢ཾ་༧ཡང་དག་པ་ཁོ་ནར་ལུས་ཀྱི་རྗེས་སུ་སོང་བའི་དྲན་པ་དགེ་སློང་གིས་ཆེས་སྟེང་ཉིད་དུ་རབ་ཏུ་གཡོ་བར་གྱུར་པའི་རང་གི་ལུས་འགྲོ་བ་ཉེ་བར་རྟོགས་པར་བྱེད་དོ།",
    "བདག་གི་དེ་ད་ག་རྣམས་ཤིང་གི་འཁྲུལ་འཁོར་གྱི་བུད་མེད་བཞིན་དུ་རྒྱུས་པའི་འཁྲུལ་༤འཁོར་གྱིས་ཀུན་ཏུ་སྦྲེལ་བ།",
    "བདག་གིས་༧རབ་ཏུ་བགད་པར་ཡང་མི་བྱའོ།",
    "རྣམ་པ་དེ་ལྟ་བུ་རྣམས་ལས་ནི་དེས་སྲོག་གི་ད་བང་པོའི་ཕྱིར་ཡང་རྒལ་བར་མི་བྱ་སྟེ།",
    "གཞན་ཡང་རྣམ་པ་གསུམ་པ་དགེ་སློང་གིས་རྒལ་བར་མི་བྱའོ།",
    "གཟུགས་གང་ཡིད་དུ་འོང་བ་མིག་གི་ཡུལ་ཉམས་སུ་རྨྱོང་བར་གྱུར་པ་ལ་འདུ་ཤེས་སྔོན་དུ་སོང་བས་ཐག་ཉེ་བ་དང་།",
    "གཞན་ཡང་དྲ་ན་པ་གཉིས་པས་ལེགས་པར་བཟུང་བར་གྱུར་པ་ནི་རྣ་བ་གང་དག་གིས་སྒྲ་རྣམས་ཐོས་པས་ཡིད་འཕྲོག་པར་བྱེད་པ་གང་གླུ་དང་།",
    "རོལ་མོའི་སྒྲ་དང་།",
    "གད་མོ་རྣམས་དང་།",
    "རྩེད་མོ་དང་།",
    "རྐྱེན་གྱིས་ནང་གི་བདག་ཉིད་དུ་སོན་པ་རྣམས་ཀྱང་ཡོངས་སུ་སྤོང་བར་བྱེད་དོ།",
    "ཀུན་ན་ས་ཉོན་མོངས་པ་ཅན་གྱི་བདེ་བ་ཡིན་པའི་ཕྱིར་འཐུག་༩པ་དང་།",
    "ལུས་སུ་གཏོགས་པའི་རེག་བྱར་གྱུར་པ་ལ་བརྐམ་པས་དྲ་ང་བར་གྱུར་པ་རྣམས་ལ་རྗེས་སུ་ཡི་རང་བར་མི་བྱེད་ད་དོ།",
    "དགེ་སློང་དག་གིས་ཤེས་པར་བྱ་སྟེ།",
    "ཀི་པ་༢ེལ་བྱེད་པའི་བྱ་བ་དང་ལྡན་པར་གྱུར་པས་བདག་ཉིད་ཀྱིས་སོ་སོར་རིག་པར་བྱེད་དོ་། ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་ཚོམ་བུར་གྱུར་པའི་ལུས་འདི་ནི་སྐད་ཅིག་གི་༡ཁོག་ཙེ་༢ལས་ཉེ་བར་འཚེ་བ་དང་བཅས་པ་ལུས་འདི་ཐམས་ཅད་ཀྱིས་སྟོང་པ་ལྟ་བུར་གྱུར་པ་ལ་ནི་བྱེད་པ་པོ་དང་།",
    "རྒྱུ་དང་རྐྱེན་ཕན་ཚུན་གྱི་ད་བང་གིས་ཐ་སྙད་ཀྱི་ལུས་འདི་ཀུན་ན་ས་བསྐྱེད་པས་རབ་ཏུ་འཇུག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ཇི་ལྟར་ན་ད་གེ་སློང་ཉིན་མོ་དང་མཚན་མོ་དུསདྲན་པ་དང་ཡང་དག་པར་ལྡན་པ་ཡིན་ཞེ་ན།",
    "དགེ་སློང་དག་འདི་ན་ད་གེ་སློང་གིས་མིག་བཙུམས་པ་དང་ཕྱེ་བ་རྟོགས་པར་བྱེད་དེ་སྐད་ཅིག་པའི་མིག་བཙུམས་པ་དང་།",
