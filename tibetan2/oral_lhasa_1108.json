    "གཉིས་པ་སོགས་དང་བཅུ་པ་བས་བཅུ་གཅིག་པ་སོགས་འཕེལ་བར་གསུངས་པས་སོ།",
    "ཅེས་གསུངས་པ་ལ་ལྔ་ལས་དང་པོ་མཚམས་སྦྱར་བ་ནི།",
    "མཁྱེན་གསུམ་དང་སེམས་བསྐྱེད་སོགས་གང་ཞེ་ན།",
    "ཞེས་གསུངས་པ་ལ་ལྔ་ལས་དང་པོ་མཚམས་སྦྱར་བ་ནི།",
    "ངེས་པར་བརྟན་པར་བྱེད་པའི་སྒོ་ནས་རྟོགས་པ་སྔར་ལས་ངེས་པར་བརྟན་པར་གྱུར་པའི་མཚན་ཉིད་ཅན་གྱི་ཏིང་ངེ་འཛིན་སེམས་ཀུན་ཏུ་གནས་པ་ཡིན་པས་སོ།",
    "དེའི་འབྲས་བུ་ཚོགས་གཉིས་ནི་དེ་དག་ལས་ཁྱད་པར་དུ་འཕགས་ཤིང་ཚད་ལས་འདས་པའི་ཚོགས་ཡིན་པས་སོ།",
    "འདུ་ཤེས་གཉིས་ནི་སེམས་བསྐེད་བཞི་དོན་དམ་དུ་ཐ་དད་པར་འདུ་ཤེས་པ་ནི་གཉིས་ཀྱི་འདུ་ཤེས་ཀུན་རྫོབ་ཏུ་ཐ་དད་མེད་པར་འདུ་ཤེས་པ་ནི་གཉིས་མེད་པའི་འདུ་ཤེས་སོ།",
    "ཡང་ན་ཡོད་པ་དང་མེད་པར་འཛིན་པ་ནི་གཉིས་ཀྱི་འདུ་ཤེས།",
    "སྟོང་གསུམ་གྱི་ཚད་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱིས་གཞལ་བར་ནུས་པས་རྟགས་མ་གྲུབ་ཅིང་།",
    "གོ་རིམ་བཞིན་དུ་དྲོ་བ་ལ་སོགས་པ་ངེས་འབྱེད་ཆ་མཐུན་གྱི་མིང་ཅན་གྱི་རྩེ་སྦྱོར་བཞིའི་ངོ་བོ་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ་རིམ་པ་བཞིན་དུ་དེ་རྣམས་ཀྱི་མཚན་ཉིད་ཡིན་པས་སོ།",
    "ཞེས་གསུངས་པ་ལ་ལྔ་ལས།",
    "སྒྲུབ་རྟོག་ཏུ་གྱུར་པའི་འཇུག་པ་གཟུང་རྟོག་ཡིན་པར་མཚོན།",
    "དེས་ན་ཁོས་ཡུལ་ཇི་ལྟར་བཟུང་བར་ལྟར་དོན་དང་མི་མཐུན་པའི་ཆ་ནས་རྟོག་པར་བཞག་སྟེ།",
    "ངོ་བོ་ནི་ཡུལ་དེ་གཉིས་ལ་དམིགས་ནས་རིམ་པ་བཞིན་དུ་ལེན་པ་དང་དོར་བ་འདོད་པའི་སྒོ་ནས་འཇུག་བྱ་དང་ལྡོག་བྱའི་གཟུང་བའོ་ཞེས་ཞེན་པའི་རྣམ་པར་རྟོག་པ་དེ་གཉིས་རིམ་པ་བཞིན་དུ་འཇུག་པ་དང་ལྡོག་པ་གཟུང་རྟོག་ཡིན་ནོ།",
    "ཡུལ་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པར་འཛིན་པའི་ངོ་བོ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པ་ལ་ལྔ་ལས།",
    "དེས་ན་འཛིན་པའི་རྣམ་པར་བཞག་པ་དང་པོའི་རྣམ་པར་བཞག་པ་ནི་མ་ཁྱབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "ང་དེའི་ཚེ་དེའི་དུས་ན་རི་དྭགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་ཡན་ལག་མ་སྨད་པ་ཞེས་བྱ་བར་གྱུར་ཏོ་ཞེས་གསུངས་པས་སོ་ཞེ་ན།",
    "དེ་སྐད་གསུངས་པ་དེ་དྲང་དོན་ཡིན་གྱིས།",
    "བཏགས་འཛིན་དུ་བཞེད་པར་མངོན་ནོ།",
    "སྒྲུབ་རྟོག་ཏུ་གྱུར་པའི་རྫ་ས་འཛིན་རྟོག་པར་མཚོན།",
    "སོ་སྐྱེའི་འཛིན་པ་ལ་དམིགས་ནས་སྐེས་བུ་རྫ་ས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་བློ་ཡིན་པ།",
    "ཕུང་པོ་མི་རྟག་པ་བཏགས་པ་ཙམ་དུ་འཛིན་པའི་མཐོང་ལམ་པའི་འཛིན་པ་ལ་དམིགས་ནས་སྐྱེས་བུ་བཏགས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་བློ་མཚན་གཞི།",
    "སྒྲུབ་རྟོག་ཏུ་གྱུར་པའི་བཏགས་འཛིན་རྟོག་པར་མཚོན།",
    "འཕགས་པའི་འཛིན་པ་ལ་དམིགས་ནས་སྐྱེས་བུ་བཏགས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་བློ་ཡིན་པ།",
    "རྫ་ས་འཛིན་དང་བཏགས་འཛིན་དུ་བདེན་པར་མ་གྲུབ་པའི་ཕྱིར་ཏེ།",
    "ཡུལ་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པར་འཛིན་པའི་ངོ་བོ་ཅན་ཡིན་ཏེ།",
    "འཛིན་པའི་ངོ་བོས་དབེན་པའི་ངོ་བོ་སྟེ་འཛིན་སྟངས་དོན་དང་མི་མཐུན་པར་འཛིན་པའི་བློ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་དགུ་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "སྤྱི་དང་ཁྱད་པར་གྱི་རང་བཞིན་གཉིས།",
    "ཁྱད་པར་གྱི་རང་རྒྱུ་དང་ལམ་དང་འབྲས་བུ་དང་གསུམ།",
    "རབ་འབྱོར་ཡུམ་ནས་རྣམ་མཁྱེན་གྱི་བར་ནི་ཤིན་ཏུ་དབེན་པའོ་ཞེས་ངོ་བོ་ཉིད་ཀྱི་རྟོག་པ་བཀག་པའི་དོན་གྱིས་གསུངས་སོ།",
    "ནམ་མཁའ་ལ་བྱེ་བྲག་མ་མཆིས་ཤིང་མི་གཡོ་བ་དང་རྣམ་པར་དག་པ་མཆིས་པའི་སླད་དུ་སྟེ།",
    "ཡུམ་ནི་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ་ཞེས་དེའི་རྟོག་པ་བསལ་བ་ཤེས་པར་བྱེད་པའི་དོན་གྱིས་གང་གསུངས་པ་ཡིན་ནོ།",
    "སྒྱུ་མའི་སྐྱེས་བུ་ནི་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "སླད་དུ་ཞེས་དེའི་རྟོག་པ་བཀག་པའི་དོན་གྱིས་གང་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ་ཞེས་དེའི་རྟོག་པ་བཀག་པའི་དོན་གྱིས་གསུངས་སོ།",
    "ཞེས་དེའི་རྟོག་པ་བསལ་བའི་དོན་གྱིས་གསུངས་སོ།",
    "བཅོམ་ལྡན་འདས་ཡུམ་ནི་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ་ཞེས་དེའི་རྟོག་པ་བསལ་བའི་དོན་གྱིས་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་དང་དེ་བཞིན་གཤེགས་པའིགསྤྲུལ་པ་ནི་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "དེ་བཞིན་དུ་བྱང་སེམས་ཡུམ་ལ་སྤྱོད་པ་ཡང་འདི་ལྟར་བདག་ལས་ཉན་ཐོས་ཀྱི་སའམ་མན་སྔར་བཞིན་དུ་བྱས་ནས་མི་རྟོག་པའི་སླད་དུའོ་ཞེས་དེའི་རྟོག་པ་བསལ་བའི་དོན་གྱིས་གསུངས་སོ།",
    "ཡུམ་ནི་མི་རྟོག་རྣམ་པར་མི་རྟོག་གོ་ཞེས་དེའི་རྟོག་པ་བསལ་བའི་དོན་གྱིས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་གོ།",
    "བླང་བྱའི་གཟུང་བར་བྱ་བ་ཉིད་དུ་འཇུག་པར་བྱའོ་ཞེས་འཇུག་བྱ་བཟུང་བར་ཞེན་པའི་ཚུལ་གྱིས་སོ།",
    "སོགས་པ་སྒོམ་ལམ་ཡང་དག་པར་འགྲུབ་པའི་ཐབས་མཁས་དང་།",
    "དེ་ཇི་ལྟར་རྣམ་པར་དགུ་ཡིན་ཞེ་ན།",
    "དེ་དགུ་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "ཡུམ་དང་མ་བྲལ་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔས་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་ཐོབ་བོ་ཞེས་ཉི་ཟླས་མཚོན་པའི་ཐབས་ཤེས་ཁྱད་པར་ཅན་དང་ལྡན་པའི་སྒོ་ནས་སྲིད་ཞི་མཉམ་ཉིད་དུ་རྟོགས་པ་དངོས་སུ་བསྟན་པའི་ཤུགས་ལ་བསྟན་ལ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་ཡང་ཡུམ་དང་བྲལ་ན་བདུད་དམ་བདུད་ཀྱི་རིགས་ཀྱི་ལྷ་རྣམས་ཀྱིས་ཚུགས་པར་སླ་བ་ཡིན་ནོ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་ཡང་ཡུམ་དང་མ་བྲལ་ན་བདུད་དམ་བདུད་ཀྱི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱིས་མི་ཚུགས་པ་ཡིན་ནོ་ཞེས་ཡོངས་སུ་འཛིན་པའི་ཁྱད་པར་ཤེས་པའི་དོན་གྱིས་གསུངས་ལ།",
    "རབ་འབྱོར་འདི་ལྟ་སྟེ་དཔེར་ན་མཁར་གྱི་རྒྱལ་པོ་རྣམས་ནི་འཁོར་ལོ་སྒྱུར་བའི་རྒྱལ་པོའི་རྗེས་སུ་མཐུན་པར་སྒྲུབ་ཅིང་ནང་ནུབ་བསྙེན་བཀུར་བྱ་བའི་ཕྱིར་འོང་བར་བྱེད་དོ།",
    "ཉི་ཚེ་བའི་སྤངས་པ་ཤེས་པར་བྱེད་པའི་དོན་གྱིས་གསུངས་ལ།",
    "ཆུ་ཀླུང་གངྒཱ་ཆུ་གང་ཇི་སྙེད་ཡོད་པ་དེ་དག་ཐམས་ཅད་ཀྱང་རྒྱ་མཚོ་ཆེན་པོར་ཕྱིན་ན་ལན་ཚྭའི་རོར་རོ་གཅིག་པར་འགྱུར་རོ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་ལྔ་ཡང་ཡུམ་གྱིས་ཡོངས་སུ་ཟིན་ན་རྣམ་མཁྱེན་དུ་ཕྱིན་པའི་ཚེ་འདི་ལྟ་སྟེ།",
    "དེར་དང་པོ་འགྲོ་བ་ཐབས་ཤེས་ཁྱད་པར་ཅན་གྱི་རྗེས་སུ་འབྲང་བ་ཤེས་པར་བྱེད་པའི་དོན་གྱིས་གསུངས་ལ།",
    "ཐབས་ཤེས་ཁྱད་པར་ཅན་དང་བྲལ་བས་རྣམ་མཁྱེན་གྱི་ལམ་དུ་ཞུགས་ནས་རྒྱུན་དུ་གནས་པ་དང་དེར་དང་པོ་འཇུག་པ་ལ་རྨོངས་ཏེ་མི་ཤེས་པ་དང་།",
    "རྣམ་པར་རྟོག་གོ།",
    "བླང་བྱའི་གཟུང་བར་བྱ་བ་མ་ཡིན་པ་ཉིད་དུ་ལྡོག་པར་བྱའོ་ཞེས་ལྡོག་བྱའི་གཟུང་བར་ཞེན་པའི་ཚུལ་གྱིས་སོ།",
    "འབྲས་བུ་གྱ་ནོམ་པར་འགྲོ་བའི་མི་ཤེས་པ་གཞན་རྗེས་སུ་འཛིན་པ་དམན་པ་དང་།",
    "འབྲས་བུ་རྣམ་མཁྱེན་དེས་ཐེག་ཆེན་གྱི་སྤངས་རྟོགས་ཀྱི་རིགས་ཐམས་ཅད་སྡུད་ཅིང་ཚང་ལ་རྫོགས་པར་ཐོབ་པས་སོ།",
    "དེ་དགུ་རྟོག་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་སོགས་གསུངས་ལ།",
    "རྣམ་པར་རྟོག་གོ།",
    "དམིགས་ཡུལ་སོ་སྐྱེའི་འཛིན་པ་ལ་དམིགས་ནས་སྐྱེས་བུ་རྫ་ས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་བློ་ཡིན་པས།",
    "འཛིན་རྟོག་དང་པོ་རྫས་འཛིན་རྟོག་པ་ཤེས་པར་བྱའོ།",
    "ཡུལ་ཡང་དོན་དམ་པར་འཛིན་འདོར་མེད་ཀྱང་ཀུན་རྫོབ་ཏུ་སྒྱུ་མ་བཞིན་དུ་ཡོན་ཏན་འཛིན་པ་དང་སྐྱོན་གཏོང་བར་ཤུགས་ལ་བསྟན་ཏོ།",
    "ཡང་ན་དེ་ལྟ་བུའི་ཡུལ་ལ་དམིགས་ནས་རྣམ་པ་རྫས་འཛིན་དུ་ཞེན་པའི་བློ་དེ་འཛིན་པ་དང་འདོར་བའི་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "རྣམ་མཁྱེན་གྱི་བར་དུ་ཡིད་ལ་མི་བྱེད་པས་རྣམ་མཁྱེན་ཡོངས་སུ་བཟུང་མ་བཏང་བ་ཡིན་ནོ་ཞེས་གཉེན་པོ་དངོས་སུ་བསྟན་པའི་དོན་གྱིས་གསུངས་ལ།",
    "ཡུལ་ཡང་ཡང་དག་པ་ཉིད་དུ་ན་བདེན་པར་ཡིད་ལ་མི་བྱེད་པར་ཡིད་ལ་བྱེད་པ་དང་།",
    "རབ་འབྱོར་དེ་ལྟར་སྤྱོད་པའི་བྱང་སེམས་ཆེན་པོའི་གཟུགས་གནས་པར་མི་འགྱུར་རོ་ནས།",
    "རྣམ་མཁྱེན་གྱི་བར་ལ་གནས་པར་མི་འགྱུར་རོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "གནས་པ་མེད་པའི་ཚུལ་གྱིས་ཡུམ་ལ་སྤྱོད་དོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "དེ་ནི་གནས་མ་ཡིན་ནོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "ཡུམ་ཡང་ཡུམ་དང་མ་བྲལ་བ་ནས་རྣམ་མཁྱེན་གྱི་བར་དུ་ཡང་རྣམ་མཁྱེན་དང་མ་བྲལ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་འདི་དག་ཀྱང་ཡུམ་གྱི་རྗེས་སུ་འབྲང་སྟེ་རྣམ་མཁྱེན་ཉིད་གང་ན་བ་དེར་གནས་པར་འགྱུར་རོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "དེ་དགུ་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "ཆེད་བཞིན་ངེས་པར་མི་འབྱུང་དང་།",
    "ཞེས་སོགས་གསུངས་པ་ལ་སློབ་དཔོན་ལྟར་ན།",
    "རྣམ་པར་རྟོག་གོ།",
    "དེ་བཞིན་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔའི་ཁ་ལོས་བསྒྱུར་བའི་ཡུམ་ཡང་རྣམ་མཁྱེན་ཉིད་གང་ན་བ་དེར་ལམ་མཉམ་པ་མཉམ་པ་ཉིད་ནས་འགྲོའོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "ཡུལ་ནི་དོན་དམ་པར་སྐྱེ་འགག་མེད་ཀྱང་ཀུན་རྫོབ་ཀྱི་ངོ་བོས་ཡོད་པས་རྒྱུ་དང་འབྲས་བུ་དང་སྐྱེ་བ་དང་འགག་པ་དང་།",
    "གཟུགས་ནས་རྣམ་མཁྱེན་གྱི་བར་དུ་ལྡན་པ་ཡང་མ་ཡིན་མི་ལྡན་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བར་རབ་ཏུ་བཏགས་པར་བྱ་སྟེ།",
    "རབ་འབྱོར་དེ་ལྟར་བྱང་སེམས་ཆེན་པོ་ནས་ཕྱིན་དྲུག་ལ་བརྩོན་པར་བྱའོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "ས་བདུན་པ་མན་ཆད་དུ་ཅིག་ཤོས་མཚན་འཛིན་མངོན་འགྱུར་བའི་བར་ཆད་དང་བཅས་པར་སྣང་བ་ཉིད་ཀྱིས་དེ་མན་དུ་མི་རྟོག་ཡེ་ཤེས་ཀྱི་རྒྱུན་དང་མི་ལྡན་པ་དང་།",
    "སོགས་ལ་གནས་པའི་རྣམ་པར་རྟོག་པ་ནི།",
    "གཟུགས་ནས་རྣམ་མཁྱེན་གྱི་བར་ལ་གནས་པར་བྱའོ་ཞེས་བརྩོན་པར་མི་བྱའོ།",
    "གཟུགས་ནས་རྣམ་མཁྱེན་གྱི་བར་ནི་གང་ལ་ཡང་མི་གནས་སོ་ཞེས་གཉེན་པོའི་དོན་གྱིས་གསུངས་ལ།",
    "རིགས་འཇིག་པའི་རྣམ་པར་རྟོག་པ་ནི།",
    "དོན་དུ་གཉེར་བ་མེད་པའི་རྣམ་པར་རྟོག་པ་ནི།",
