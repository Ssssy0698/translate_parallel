    "རྟེན་འདི་ཡ་མཚན་ཞིང་ཤིན་ཏུ་མགྱོགས་པ་ཞིག་བྱུང་འདུག་ནའང་།",
    "རང་བྱོན་དུ་གདའོ།",
    "སྐུ་རྣམས་རང་རང་དང་མཐུན་པའི་ན་བཟའ།",
    "དེ་མགོན་པོ་གྲི་གུག་ཡིན་པར་ངོས་འཛིན་གནང་འདུག་པས།",
    "རྒྱལ་བལ་གྱི་ས་མཚམས་ཀྱི་ནགས་ཁྲོད་ཆེན་པོ་ཞིག་ན་ཙན་དན་གྱི་སྡོང་པོ་འོད་ཟེར་ཕྱོགས་བཅུར་འཕྲོ་བ་ཞིག་འདུག་པ་དེ་དུམ་བུ་བཞིར་བཅད་པ་ལས།",
    "དོན་མ་བསླབ་པའི་ལོག་རྟོག་འདུག་པས་དེ་རྣམས་བསལ་བའི་ཕྱིར་ལུང་རིགས་མན་ངག་མཆོག་ལ་སྦྱངས་པའི་རྟོན་པ་བཞི་ལྡན་གྱིས་བྲིས་པའོ།",
    "དངངས་སྐྲག་སོགས་ཀྱི་རྐྱེན་ངན་སྣ་ཚོགས་འོག་དུས་མིན་འཆི་གོད་མང་པོ་བྱུང་སྟེ་ལོ་ཤས་ནང་བོད་མིའི་མི་འབོར་ཇེ་ཉུང་དུ་ཕྱིན་ཡོད་པ་འདིས་བོད་མི་རིགས་འཚོ་གནས་ཐུབ་མིན་གྱི་ཉེན་ཁ་ཆེན་པོ་བཟོས་ཡོད།",
    "ཡིན་ནའང་ངའི་རང་གཤིས་འདི་བཅོས་ཐུབ་ཀྱི་མི་འདུག་ལ།",
    "ང་རང་ལ་ཤེས་བྱ་ཡོན་ཏན་དང་ནུས་པ་གང་ཡང་མེད་ཀྱང་ཏང་དང་།",
    "དེང་སྐབས་མི་ཁྱད་མཚར་དེ་འདྲ་འདུག་ཝ་ཡེ།",
    "ཏོག་ཙམ་ཡག་ཏུ་ཕྱིན་འདུག་ཀྱང་ད་དུང་ཡང་ཡག་པོ་རང་མི་འདུག་འདོད་པ་ཚིམས་པ་ཞིག་མི་འདུག་དེར་བརྟེན་ཚང་མས་བོད་ཡིག་འདི་ཡག་པོ་སྦྱངས་པའི་རྨང་གཞིའི་ཐོག་ནས་རྒྱ་ཡིག་དང་རྒྱ་སྐད་ཡག་པོ་སྦྱོང་དགོས།",
    "གཞས་དང་དེ་ཚོ་ཡང་ཕྱི་རྒྱལ་གྱི་ཆ་ཚང་བསླབས་འདུག་ཟེར་ཡས་མེད་ཀྱང་།",
    "ང་རང་ལ་མཚོན་ན་རང་ཉིད་དགེ་ལུགས་པ་ཡིན།",
    "དེར་ཡོང་འབབ་ཤོག་སྒོར་སྟོང་ཕྲག་ཁ་ཤས་ཡོད་འདུག་ཀྱང་།",
    "དེ་དག་ནི་དེ་སྔ་ཨ་རིས་དམག་བསྐུལ་བྱེད་སྐབས་ཀྱི་གནས་ཚུལ་དང་འདྲ་པོ་འདུག་དཔེར་ན་མི་དེས་ཝི་ཏི་ནམ་ནང་ལོ་ཁ་ཤས་རིང་དམག་བརྒྱབ་ན་ཁོ་ལ་གླ་དངུལ་ག་ཚད་སྤྲོད་རྒྱུ་ཡིན་དང་།",
    "དེ་འདྲ་མ་བྱས་ན་མ་འགྲིགས་པ་ལོས་ཡིན།",
    "མ་འོངས་པར་མནའ་གན་བཞག་དགོས་པ་འདུག།",
    "ག་དུས་ཡིན་ནའང་རྒྱ་རིགས་ཚོ་དང་འགྲན་ཐུབ་ཀྱི་མི་འདུག།",
    "ང་རང་ནི་དེ་༦ ༣ བས་བརྗོད་མ་དགོས།",
    "ལྷག་པར་དུ་མི་སྣ་བཀོད་སྒྲིག་ཐད་དེ་བས་ཀྱང་བསམ་འཆར་མང་པོ་འདུག།",
    "སྒེར་གྱི་ངོས་ནས་ཀྱང་རང་སྐྱོན་རང་བརྗོད་བྱས་ཏེ་དེ་སྔའི་ནོར་འཁྲུལ་རྣམས་ཡོ་བསྲང་བྱེད་དགོས།",
    "ཡིན་ནའང་དགག་པ་ནི་དགག་པ་རང་དང་དངོས་ཡོད་བདེན་པའི་གནས་ཚུལ་ནི་ག་དུས་ཡིན་ཡང་བདེན་པ་རང་ཡིན།",
    "སྐབས་དེར་ང་རང་ལྷ་སར་ཡོད་སྟབས་འགྲིགས་ཙམ་བྱུང་།",
    "ངས་མི་དེ་ཚོའི་རིགས་ལ་དོན་དམ་པའི་ཤེས་བྱ་མི་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "༡༩༦༤ ལོར་ང་རང་པེ་ཅིང་དུ་བཀའ་འགུགས་ཀྱིས་སྐྱོན་བརྗོད་གནང་སྐབས་འགོ་ཁྲིད་ཁ་ཤས་ཀྱིས་གསུངས་དོན།",
    "ཕྱོགས་ཚང་མའི་ནུས་ཤུགས་དགོས་པའི་ཐོག་དགྲ་ཕྱོགས་དང་རང་ཕྱོགས་གཉིས་ཀའི་ནུས་ཤུགས་ལ་བསམ་བློ་གཏོང་ཐུབ་པ་དགོས་པ་ཡིན།",
    "དེང་སྐབས་མི་འགའ་ཤས་ཀྱིས་རྒྱ་དཀར་ནག་བར་སླར་ཡང་དམག་འཁྲུག་ལངས་གྲབས་འདུག་ཅེས་ཤོད་ཀྱི་ཡོད་ཀྱང་།",
    "བོད་ནང་གཡོན་གྱི་ཤུགས་རྐྱེན་ཡོད་པ་དེ་དག་ཕན་ཐོགས་གང་འདུག།",
    "༡༩༥༨ ལོར་ང་རང་མཚོ་སྔོན་ལ་ཡོད་དུས་གོ་ཐོས་བྱུང་བ་ཞིག་ལ།",
    "ཞེས་བཀའ་སྩལ་འདུག།",
    "ང་རང་ད་ལྟ་ཡང་ལྟ་བ་དེ་རང་ཡིན།",
    "དེ་ལ་ང་རང་བསམ་འཆར་གང་ཡང་མེད།",
    "ཐོག་མར་ངའི་བསམ་པར་དུས་ཚོད་ཧ་ཅང་ཐུང་དྲགས་འདུག་པས་ཅུང་ཟད་རིང་དུ་གཏོང་དགོས་མིན་ནམ་སྙམ་པའི་ཚོར་བ་ཤུགས་དྲག་པོ་ཞིག་བྱུང་།",
    "དེར་བརྟེན་ང་རང་ནི་བོད་ལྗོངས་ལ་གཏོགས་པ་ཙམ་དུ་མ་ཟད།",
    "ལམ་ཕྱོགས་འདི་ལེགས་པོ་འདུག་གམ་མི་འདུག་ཅེ་ན།",
    "ང་རང་སྡོད་སའི་ཁང་པ་འདི་ཧ་ཅང་ལེགས་པོ་ཡོད་ཀྱང་།",
    "འདི་འདྲ་སེམས་ཀྱི་བཟོད་ཀྱི་འདུག་གམ།",
    "ང་རང་ན་ནིང་ཟླ་བ་དང་པོ་དང་ད་ལོའི་ཟླ་བ་དང་པོར་འདིར་སླེབས་པའི་མཐོང་ཚུལ་གཉིས་བསྡུར་ནས་བལྟས་ན།",
    "ཟི་ཁྲོན་ལའང་བྱུང་མི་འདུག་གམ།",
    "ས་ཆ་ཁ་ཤས་ལ་དེ་བས་ཀྱང་ཡག་པོ་བྱུང་མི་འདུག།",
    "མའོ་ཀྲུའུ་ཞིས་བསམ་འཆར་འདི་གསན་ནས་ཡག་པོ་འདུག་གསུང་ཡོད།",
    "༡༩༦༣ ལོར་ང་རང་མར་ཕྱིན་པའི་རྗེས་སུ་བོད་ཀྱི་གནས་ཚུལ་དང་།",
    "དེ་ནི་དབྱེ་བ་འབྱེད་དགོས་པ་ཞིག་ཡིན་པར་ང་རང་བསམ་གྱི་ཡོད།",
    "ང་རང་ནི་ལས་ཀ་ཧ་ཅང་བྱེད་ཁག་པོ་འདུག་དེར་བརྟེན་ང་རང་ལ་འདི་སྐོར་བསམ་འཆར་གཅིག་ཡོད།",
    "ང་ནི་དེ་འདྲ་མ་བྱས་ན་སྙམ་པ་དྲན་གྱི་འདུག་ལོ་དུས་གང་འདྲ་ཡིན་དང་།",
    "འདི་ཡག་པོ་རང་མི་འདུག་ངས་ཁ་སང་ཡང་ཞུས་པ་ཡིན།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་གཉིས་སུ་དབྱེ་བ་འདི་ཡང་རང་བཟོ་ཁོ་ནས་ཐ་སྙད་བྱས་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "འདི་ཡང་ཀུན་རྫོབ་ཀྱི་བདེན་པར་འགྱུར་ཞིང་དེའི་ཡང་རང་བཞིན་ནི་བརྗོད་པར་མི་ནུས་སོ།",
    "ཞེས་པ་ཞིག་གསལ་བར་བསྟན་འདུག་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་མྱུ་གུར་སྣང་ཙམ་དང་རང་བཞིན་སྐྱེ་མེད་བཞིན།",
    "རང་རང་ལ་གྲགས་པའི་རིགས་པས་གནོད་པས་རྣལ་འབྱོར་གོང་མ་ལ་ལྟོས་མི་དགོས་པའི་ཕྱིར།",
    "བོད་ཕྱི་མ་གང་དག་སློབ་དཔོན་འདི་ཐ་སྙད་དུ་ཡང་རང་རིག་མི་བཞེད་དོ།",
    "རིག་བྱ་རིག་བྱེད་ཐ་དད་པ་གཉིས་མེད་ཀྱང་རང་རིག་ཏུ་མི་འགལ་ཏེ།",
    "དེའི་ཕྱིར་ཐ་སྙད་དུ་ཡང་རང་རིག་ཁས་མི་ལེན་པ་ནི།",
    "གཉིས་བྲལའཆད་དུས་ཞལ་ཤེས་གསུམ་ཟེར་བ་འདི་ལ་འཆད་ཚུལ་མང་པོ་ཞིག་འདུག་ཀྱང་།",
    "ཕུརམ་བཅས་ཕྲན་བུ་ཞིག་འདུག་པ་འདི་ལྟར་འབུལ་ལམ་ཞུས་ཡོད།",
    "འདི་ལའངདཔེ་དག་མིན་ཅི་རིགས་འདུག་པས་ཕྲན་གྱི་དཔེ་ཅུང་ཟད་དག་པ་ཡིནརྩིས།",
    "འབྲས་བུ་སྐུ་གཉིས་ཟུང་འཇུགཙུའདུགར་བཝེདདོ།",
    "ཡིད་འོང་གནས་སུ་འདུག་ནནི།",
    "གཡང་སའམ་དེ་བཞིན་བཙོན་པ་རའདུག།",
    "ཆུང་མ་སྡུག་དང་རང་བྱེད།",
    "གྲུལ་དང་འཁྲིག་དུས་སྐད་ཅིག་ཙམ།",
    "གླ་རང་འཁྲིག་དུས་སྐད་ཅིག་ཙམ།",
    "ཙོག་ཙོག་པོར་ནི་འབུམ་འདུག་པ་གང་ཡིན་པ།",
    "བཅུ་དྲུག་དུས་སུ་རྫོགས་པར་འགྱུར་ཞེས་དང་།",
    "འཛམཔའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
