    "དེའི་དགོངས་པ་ནི་བརྗོད་ཚིག་ཏུ་སྨྲ་བས་དེ་ཁོ་ན་ཉིད་རྟོགས་པར་བྱ་བའི་ཆེད་དུ།",
    "ཚེ་སྔ་ཕྱི་ཡང་མེད་དེ་ད་ལྟ་འབའ་ཞིག་མུ་བཅད་ན་ཡོད་པ་ཙམ་དུ་མཐོང་དེ་མེད་ན་ཆད་པར་ལྟུང་ངོ།",
    "ས་བཅུ་དང་རྣལ་འབྱོར་བཅུ་ལ་སོགས་པ་རྣམ་གྲངས་བསྟན་བཅོས་པ་ལས་དེ་རིམ་གྱིས་འཇུག་པའི་ལམ་འཕེལ་ཞིང་གོང་ནས་གོང་དུ་འགྲོ་བར་ནི་མི་འགྱུར་གྱིགཅིག་ཅར་འཇུག་པའི་ལམ་མཆོག་ཉིད་དུ་ཕེབས་པ་དམ་པའི་ལམ་ཉིད་རྙེད་ནི་མ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་སོ།",
    "མཐོང་དང་མ་མཐོང་ཁྱད་པར་གྱིས།",
    "དོན་དེ་མཐོང་དང་རྟོགས་མ་མཐོང་མ་རྟོགས་ཀྱིས་ཁྱད་པར་གྱིས་ཇི་ལྟར་བལྟས་པ་ལྟར་སེམས་ཉིད་གང་ལྟར་ལྟས་དགུ་དེ་ལྟར་སྣང་སྣ་ཚོགས་སུ་གསལ་འགྲེལཀྱང་ངོ་བོ་དེ་སྣང་བ་ཁོ་ན་ཉིད་ལས་གཞན་དུ་གྱུར་པ་ནི་མ་ཡིན་མི་དམིགས་པའོ།",
    "དགོངས་པ་ཀུན་ནས་འདུས་པས་གསུངས།",
    "དེ་བས་ན་གཉིས་བྲལ་གྱི་དེ་ཉིད་ལྟ་བ་གཏིང་དཔག་མེད་དཀའ་བ་ནི་དེ་བཞིན་གཤེགས་པའི་ཡང་གཞལ་ཡས་བཞུགས་གནས་ཁྱད་པརཆེན་རྨད་བྱུང་ཅན་ཡོན་ཏན་རིན་ཆེན་ཆེན་པོའི་གཞལ་ཡས་ཡིད་བཞིན་ཁང་ངོ།",
    "དེའི་ངོ་བོ་འཕྲལ་དུ་མ་བྱས་བསྒྲུབ་པར་ཡེ་ཉིད་རང་བྱུང་བ་ལ་སྤྱོད་ཡུལ་ཕྱི་ནང་མེད་མ་དམིགས་པས་ཕྱི་དང་ནང་། མེད་དེ་ཀུན་ཏུ་འང་ནང་དུ་གྱུར་པའོ།",
    "གཉིས་མེད་པར་བྱས་པ་ལ་སྤྱོད་པ་མི་འགོག་སྤྱད་པ་མེད་པ་ནི་བརྟུལ་ཞུགས་བླ་ན་མེད་པ་མཆོག་ཏུ་ཡིན་པར་བདེ་བར་གཤེགས་པ་ཀུན་འདུས་རྣམས་ཀྱིས་ཀྱང་བཀའ་སྩལ་གསུངས་པའོ།",
    "དེ་ལྟ་བུ་ལ་དངོས་གྲུབ་རྒྱུན་མི་བར་ཆད་མེད་པ་ཞེས་པར་བསྟན་བཅོས་པ་རྒྱལ་བ་ཀུན་གྱིས་དགོངས་པ་བཀའ་སྩལ་པའོ།",
    "དེའི་དོན་རྒྱས་པར་འགྲེལ་པའོ།",
    "ལྕི་། དེ་ནས་ལངམངའ་བདག་ལ་སོགས་པ་གྲོགས་ཀྱི་སེམས་དཔའ་རྣམས་ཀྱིས་ཞེས་པརྗེས་འཇུག་བཀའ་སྩལ་མ་ཐག་པར།",
    "ཅེས་པ་ལ་སོགས་པ་འཆད་པའི་སྐྱེས་བུས་བོས་ནས་ལན་གསུངས་མ་པ་ནི།",
    "མ་རིག་པའི་གཞི་མིང་ཡང་མེད་པར་བསྟན་པའོ།",
    "གང་མུན་པའི་ཤེས་པ་ནི་གང་འདི་ལས་ལོག་པར་ཤེས་པའོ།",
    "ཞེས་པ་ལོག་ལྟ་ལ་ཆགས་པ་བ་རྣམས་ལྟ་གཞུང་མི་མཐུན་པ་སུམ་ཆེན་བརྒྱ་དྲུག་ཅུ་ལ་སོགས་པར་སྨྲ་ཞིང་།",
    "རྩ་བ་རྟག་པ་དང་ཆད་པར་འདོད་པ་མུ་སྟེགས་ཀྱི་ཤེས་པའོ།",
    "བྱིས་པ་རྣམས་ནི་འདི་ལྟ་སྟེགང་མེད་པར་སྨྲ་ཞིང་ཡོད་པར་འདོད་པའོ།",
    "གང་ཟག་ལ་བདག་མེད་པར་སྨྲ་ཞིང་པའོ་ དེའི་ཚུལ་རྒྱས་པར་བསྙད་པ་ནི་འདི་ལྟར་འདོད་དེ།",
    "དེ་ལས་སའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལ་སོགས་པར་སྣང་བ་ཡང་རྡུལ་གྱི་ངོ་བོར་འདོད་པ་དང་།",
    "གནས་པ་ལ་སོགས་པའི་བྱེ་བྲག་ཐ་དད་དུ་ཕྱེ་བ་ལས་མི་རྟག་པ་ལ་སོགས་པར་ཡང་མཐོང་སྟེ།",
    "མེད་པར་སྨྲ་ཞིང་ཤེས་ཡུལ་སྐད་ཅིག་སྔ་འགྱུར་བཀའ་མ་ཀག་མཐའ་མ་དང་རྡུལ་ཙམ་ཡོད་པར་འདོད་པའོ།",
    "རྣལ་འབྱོར་པ་སྤྱོད་པའི་ཀུན་རྫོབ་ཡུལ་གྲང་ན་གང་དུ་སེམས་སུ་འདོད་པ་ལ་གཙོ་བོར་མཚན་ཉིད་དུ་དོན་དམ་པ་ཀུན་རྫོབ་སྒྱུ་མ་ཉིད་ཀྱང་མེད་དེ་མ་སྐྱེས་པར་གཅིག་པའོ།",
    "དོན་དམ་པར་ནི་དེ་ཉིད་སེམས་སྐད་ཅིག་མ་ཉིད་དེ་ནི་སྔ་འགྱུར་བཀའ་མ་དེཔ་ཕམ་ཐ་༧༡་ཀཟམསམཐོ་དངོས་པོ་མེད་མ་གྲུབ་པའི་ཕྱིར་གཏན་ཚིགས་དེས་ན་ངོ་བོ་སྟོང་པ་ཉིད་ལ་དམ་པ་ཉིད་དུ་ངེས་པའི་དངོས་པོ་ཅིར་ཡང་མ་གྲུབ་པར་འདོད་པའོ།",
    "བརྗོད་པས་མི་ཕེབས་པས་ཚིག་ལ་མ་འདས་གདགས་པ་ལས་གྲོལ་བའོ།",
    "བྱིས་པ་རྣམས་ནི་རྩོད་པར་འགྱུར།",
    "མི་ཤེས་གང་ཞིག་རྟོག་པར་བྱེད།",
    "ཅེས་པ་དཔེར་ན་ནམ་མཁའ་ཡེ་སྟོང་པ་ལ་དེ་ལ་མི་ཤེས་པའི་བླུན་པོ་དག་ནམ་མཁའ་ནི་དངོས་པོ་མེད་པའོ་བར་རྟོག་པར་ཡིད་ལ་བྱེད་དོ།",
    "ནམ་མཁའི་མཚན་ཉིད་གང་ཤེས་མབརྒྱ་དག་ནི་མེད་དོ་བར་ཡེ་ནས་ཡོངས་མི་རྟོག་བསམ་པར་ཡང་མི་འཛིན།",
    "ཡིན་པར་མི་རྟོག་ཚིག་ཏུ་མི་བརྗོད་དེ་བསམ་པ་ཅིར་ཡང་མི་སྐྱེའོ།",
    "ཇི་ལྟ་བའི་དོན་མཐོང་བའི་གང་ཤེས་མི་ཆེན་པོ་རྣམས་ཡེ་ནས་མཐའ་བྲལ་བ་ཉིད་དུའང་འགྱུར་སྔ་མི་རྟོག་ཡིད་ལ་མི་བྱེད་རྗེས་སུ་མི་འབྲང་ཞིང་ཞེ་བས་མིན་པར་མི་རྟོག་མི་འཛིན་ཏེཚིག་ཏུའང་མི་བརྗོད་པ་ནི་དོན་ལ་རྣལ་དུ་ཕེབས་པའི་མི་རྟོག་པ་ཉིད་དོ།",
    "ཁྱད་པར་བྱེ་བྲག་ཐ་དད་པར།",
    "རྣམ་པ་བྱེ་བྲག་མ་འདྲེས་ལ་ཐ་དད་པར་ཡང་ངེས་འབྱེད་ཅིང་དེ་ལ་ཤེས་པར་འཇུག་པ་དང་།",
    "དོན་རྟོགས་པར་དཀའ་བའི་ཤེས་བཀའ་ཝཾ་བཅུ་དགུ་རབ་དང་དོན་ཇི་བཞིན་པ་དབྱེར་མེད་པར་འབྲེལ་བར་བྱེད་པའོ།",
    "དེས་ཤེས་བྱ་ཀུན་མཚན་ཉིད་མ་འདྲེས་པར་འབྱེད་པ་ཡིན་ཤེས་པར་བྱེད་པའོ།",
    "འགྲེལཤེས་རབ་རྟོག་དཔྱོད་ཀྱིས་སྐྱེ་མཆེད་འཕེལ་ཞིང་ཀུན་རྒྱས་པར་གྱུར་པ་ཉིད།",
    "དེ་ཉིད་དོན་ཇི་བཞིན་པ་རྟོགས་པར་གསེར་མཐོང་ག་ལ་རིག་རིག་པ་མ་ཡིན་པས་གྲོགས་པོ་དག་དེ་ལ་ཆེད་དུ་གྱིས་ཤིག་པར་གདམས་པ་ཆེན་སྟེ་ཐག་ལྟ་བས་བཅད་པར་འགྱུར་རོ།",
    "དགོངས་པ་དམ་པ་ཞེས་པ་ངོ་བོ་བསྟན་ལེགས་པར་བགྲོས་པའོ།",
    "ཅེས་པ་ལ་མབརྒྱསོགས་པ་སྐྱེས་བུས་བོས་ནས་ཞུས་པ་ལ་ལེགས་པ་གནང་བ་ནི་སྒྲ་ཇི་བཞིན་ནོ།",
    "སྔ་མ་ལ་བརྟེན་ནས་ཕྱི་མ་སྨིན་པར་བྱེད་པའི་ཕྱིར་མིང་འཐོབ་སྟེ།",
    "རིན་ཆེན་སྣ་འགའ་ཐོབ་ཆེན་པའི་ཁྱད་པར་ཆེ་ཆུང་ལས་ཡིག་ཚང་ཐབས་ཆེན་སྒོ་དགུའི་ཐབས་སོ་སོར་སྤྱོད་དོ།",
    "སྟོན་པའི་ཁྱད་། པར་དང་སའི་རིམ་པ་དང་ཁྱད་པར་ཡང་དོན་གྱིས་དེ་ལྟར་ཡོད་པ་ཡིན་མཐོ་དམན་དེ་ལྟ་བུའོ།",
    "འདིར་གཞུང་བཙན་པར་བྱ་བའི་ཆེད་དུ་གསང་སྔགས་ཉིད་དུ་མཇལ་བར་སྦྱར་རོ།",
    "ལེགས་པར་འདུན་པ་རྣལ་འབྱོར་ལྔ།",
    "འདི་༩དག་ཚོགས་ལམ་པའི་ཕྱིར་དང་པོར་རྣམ་པར་དཀར་བའི་སྤྱོད་པ་ལ་གནས་པ་ཞེས་བྱའོ།",
    "འཕྲོ་འདུའི་ཚད་དག་འཆད་པར་འགྱུར་བས་མ་སྦྱར་ཏོ།",
    "མཉམ་པའི་དོན་ལ་བློ་འདུན་པའི་གནས་ནས་བདེ་བ་ཆེན་པོ་ནས་ནམ་མཁའི་ངོགས་བཞིན་མཐོང་ལ་མ་རགས་པར་གནས་པ་ནི་བར་ཆད་མེད་པའི་ལམ་སྟེ།",
