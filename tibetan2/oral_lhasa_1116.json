    "ལུས་ནི་སྒྲིབ་པ་རྣམ་པར་སེལ་བ།",
    "དེ་ལྟར་བསྒོམས་པའི་འབྲས་བུ་ནི་འདི་དག་སྐྱེད་པར་བྱེད་དེ།",
    "སྒྲིབ་པ་རྣམ་པར་སེལ་བས་ལུས་ཀྱི་རྫུ་འཕྲུལ་དང་ཡིད་ཀྱི་གཟུགས་དང་སྤྲུལ་པ་སྐྱེད་པར་བྱེད་དོ།",
    "གཞན་ཡང་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་རྡོ་རྗེའི་རྫུ་འཕྲུལ་ཡང་སྐྱེད་པར་བྱེད་དོ།",
    "ཟག་པ་ཐམས་ཅད་ཟད་པའི་ཡེ་ཤེས་སྐྱེད་པར་བྱེད་དོ།",
    "མཉམ་པར་སྦྱོར་བའི་དུས་སུ་འཕགས་པ་གཤིན་རྗེ་གཤེད་ལག་པ་གཉིས་ཏེ་ལྕགས་ཀྱུའི་དོན།",
    "འཕགས་པ་བདུད་རྩི་འཁྱིལ་པ་ལས་ཀྱི་ཕྱིར་ལས་ཀྱི་དུས་སུ་བདེ་བ་ཆེན་པོའི་གནས་གཉིས་མཉེས་པར་བྱེད་པ་སྟེ་དྲིལ་བུའི་དོན་ཏོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་བསྐྱེད་པར་འདོད་པའི་རྣལ་འབྱོར་པས།",
    "དེ་ཉིད་རྣམ་པར་སྦྱངས་ནས་ཡང་དག་པའི་ལམ་དུ་འགྲོ་བའི་ཕྱིར་ན་དེ་བཞིན་གཤེགས་པའོ།",
    "དཔེར་ན་ཟངས་དང་འཁར་བ་ལ་སོགས་པ་རྫས་ཀྱི་དངོས་པོ་གཅིག་ལ་ཆོལ་ཟངས་སུ་བྱས་པའི་དུས་ན་ནི་བཙོག་པར་འཛིན་ཅིང་མཆིལ་སྣབས་ལ་སོགས་པ་འདོར་བར་བྱེད།",
    "དེ་ལ་གཞོང་བ་ལ་སོགས་པར་བྱས་ན་ནི་གཙང་བར་འཛིན་ཅིང་།",
    "དེ་ཉིད་རང་བཞིན་རྣམ་པར་དག་པར་བསྒོམས་ན་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་བསྐྱེད་པའི་རྒྱུ་ཡང་ཡིན་པས་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "རྒྱུད་ཀྱི་དོན་ངེས་པར་བསྟན་པ་འདི་ཡིན་ནོ།",
    "དཀྱིལ་ཞེས་པ་ནི་པདྨོ་སྟེ་དེ་ནི་བཞུགས་པར་སྦྱར།",
    "དེ་ཡང་ཇི་ལྟར་བཞུགས་ཤེ་ན།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཆུ་ལྟ་བུའི་ངོ་བོ་ཟླ་བ་ལྟ་བུར་དཀར་ཞིང་དག་པའི་ཚུལ་དུ་བཞུགས་སོ།",
    "ཝཾ་ནི་རྡོ་རྗེ་མ་ནི་རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་ཡེ་ཤེས་ཀྱི་ས་བོན།",
    "བི་ཛ་ཧ་རའི་སྒྲས་ནི་བཞུགས་པའི་དོན་ཏོ།",
    "བཞུགས་སོ་ཞེས་པའི་སྒྲས་ནི་རྣམ་པར་གནས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "འདི་ལྟར་དུས་མཚོན་པ་ཡང་དུས་གསུམ་ལ་སོགས་པ་དུས་ངེས་པར་བསྟན་པ་ནི་མ་ཡིན་ནོ།",
    "ལྷན་ཅིག་ཅེས་བྱས་ན་ཚིག་འབྲེལ་ཅིང་བདེ་སྟེ།",
    "སྟོན་པ་མྱ་ངན་ལས་འདས་སོ་ཞེས་ནི་རྒྱུད་གཞན་གང་ལས་ཀྱང་མ་གསུངས་སོ།",
    "རྒྱུད་སྡུད་པར་མཛད་པ་དག་མེད་དོ་ཞེས་གཞན་དག་སྨྲའོ།",
    "རྒྱུད་འདི་དག་གཉིས་སུ་མེད་པར་གནས་པའི་ཕྱིར་རོ་ཞེའོ།",
    "དེ་ནི་གཉིས་སུ་མེད་པར་གནས་པའི་དོན་ཏོ།",
    "དེ་ཡང་སུའི་ཐད་ན་བཞུགས་ཤེ་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱི་འཁོར་ན་བཞུགས་སོ།",
    "གང་དང་གང་བཞུགས་པ་བསྟན་པའི་ཕྱིར་འདིར་སོ་སོའི་མཚན་ཡང་སྨོས་སོ།",
    "སྐུ་དང་གསུང་མི་ཕྱེད་པར་བསྟན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟར་ཚིག་འགྲུབ་ནས་སེམས་དཔྱོད་པར་བྱེད་དེ།",
    "ཐམས་ཅད་དུ་འགྲོ་བའི་གཟུགས་ལྷུན་གྱིས་གྲུབ་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟར་དྲི་རྡོ་རྗེས་བདག་དང་གཞན་གྱི་སེམས་ཚིམ་པར་བྱེད་པ་བསྟན་ནས།",
    "མི་བསྐྱོད་པ་རྡོ་རྗེ་ཞེས་པའི་དེ་བཞིན་གཤེགས་པ་གང་དག་ཞེ་སྡང་དང་ལྡན་པའི་སེམས་དེའི་ངོ་བོར་གནས་པར་བསྟན་ཏོ།",
    "རྣམ་པར་སྣང་མཛད་རྡོ་རྗེ་ཞེས་བྱ་བའི་དེ་བཞིན་གཤེགས་པ་ནི་གང་དག་གཏི་མུག་དང་བཅས་པ་རྣམས་ལ་དེའི་ངོ་བོར་རྣམ་པར་སྣང་མཛད་ཀྱི་ཚུལ་དུ་གནས་པར་བསྟན་ཏོ།",
    "རིན་ཆེན་འབྱུང་ལྡན་ཞེས་པའི་དེ་བཞིན་གཤེགས་པ་ནི་གང་དག་ང་རྒྱལ་དང་ལྡན་པའི་སེམས་ཀྱི་ཚུལ་དུ་རིན་ཆེན་འབྱུང་ལྡན་དེའི་ངོ་བོར་གནས་པར་བསྟན་ཏོ།",
    "གདོན་མི་ཟ་བ་རྡོ་རྗེ་ཞེས་བྱ་བའི་དེ་བཞིན་གཤེགས་པ་གང་ཕྲག་དོག་དང་ལྡན་པའི་སེམས་དེའི་ངོ་བོར་གདོན་མི་ཟ་བའི་རྡོ་རྗེ་གནས་པར་བསྟན་ཏོ།",
    "དེ་དག་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པ་ནམ་མཁའི་དབྱིངས་དང་མཉམ་པར་བསྟན་པ་འདི་དག་ནི་ཕྱག་རྒྱ་ཆེན་པོའི་གཟུགས་ལྷུན་གྱིས་གྲུབ་པར་བསྟན་ཏེ།",
    "བསྟན་པ་ཞེས་པ་ནི་གསུངས་པའི་དོན་ཏོ།",
    "རྒྱུད་འདི་ཉིད་ཀྱང་འཕགས་པ་ཉིད་ཀྱི་སྐུ་དང་མཉམ་པའི་ཚུལ་དུ་བྱིན་གྱིས་བརླབས་པར་ཤེས་པར་བྱའོ།",
    "ཡང་ན་དེ་བཞིན་ཉིད་རྣམ་པར་བསྒོམས་ལ་དེ་ལས་སྣང་བའི་ཡེ་ཤེས་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་སྐྱེས་པས་ཡིག་འབྲུའི་རྒྱུར་འགྱུར་ཏེ་སྔགས་ཀྱི་འབྲུ་སྐྱེད་པར་འགྱུར་རོ།",
    "དེ་ལས་ལུས་ཀྱི་བདག་པོ་བཅོམ་ལྡན་འདས་རབ་ཏུ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་ཡང་མཚན་དང་གཉིས་སུ་མེད་པའི་སྦྱོར་བར་ལྡན་པ་པདྨའི་གནས་ན་བཞུགས་པའི་ནམ་མཁའི་ཕྱོགས་ན་རྒྱུད་ལས་སྨོས་པའི་ལྷ་ཐམས་ཅད་ཀྱི་རང་བཞིན་གྱི་ཡན་ལག་དང་ཉིང་ལག་ཏུ་བློས་རྣམ་པར་རྟོག་སྟེ།",
    "དེ་ཡང་ཇི་ལྟར་རྣམ་པར་རྟོག་ཅེ་ན།",
    "འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་ང་རྒྱལ་ཕྲག་དོག་དེ་ཁོ་ན་ཉིད་རྣམ་པ་ལྔ་དང་བདག་ལྡན་པར་རྣམ་པར་རྟོག་པར་བྱེད་དོ།",
    "གཏི་མུག་རྣམ་པར་སྣང་མཛད།",
    "ས་བོན་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་སྟེ།",
    "འདོད་ཆགས་ལ་སོགས་པ་འདི་དག་དེ་བཞིན་གཤེགས་པའི་སྐུར་རྣམ་པར་བརྟག་གོ།"
  ]
}