    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྔགས་ཀྱི་ཚུལ་ནི་སྣང་མཛད་ཆེན་པོའི་རྣམ་པར་གང་གྱུར་པ་དེ་སྙོམས་པར་ཞུགས་ནས་ཞེས་ཏེ།",
    "ཐུགས་རྗེས་གཟུང་བའི་ཕྱིར་སྔགས་བསྡུས་པ་གསུངས་པའོ།",
    "དེའི་མཐུ་གསུངས་པ་ནི་དེ་ནས་འདི་ནི་ཞེས་པ་སྟེ།",
    "དེའི་མདུན་དུ་ཡེ་ཤེས་སེམས་དཔའི་དཀྱིལ་འཁོར་ཡང་བསམ་པར་བྱའོ།",
    "དེའི་རྡོ་རྗེའི་དབུས་སུ་བསམ་པར་བྱའོ།",
    "ཕྱག་མཚན་ཡང་གསུངས་པ།",
    "ཀྱོ་བ་ནི་རྡོ་རྗེ་ལྕགས་ཀྱོའི་ཁྱད་པར་གྱིས་སོ།",
    "སྔགས་ཀྱི་ཆེ་བ་གསུངས་པ་འདི་ནི་ཞེས་པ་ལ་སོགས་པའོ།",
    "རིག་པའི་སྐྱེས་བུར་གསུངས་པ་ནི་དེ་ནས་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "དེ་ཉིད་ལ་ཞུགས་ཏེ་གསུངས་སོ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "དེ་ལས་བྱུང་བ་ནི་རིག་པའི་སྐྱེས་བུ་སྟེ་དེ་བསྒྲུབ་པར་བྱ་བའི་ལེའུ་འདི་གསུངས་སོ་ཞེས་སོ།",
    "ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྐུ་ལ་སོགས་པ་བསྐྱེད་པའི་ས་བོན་ཡིན་པས་མཉེས་པར་བྱེད་པའོ།",
    "ཡང་བསྒྲུབ་པའི་ཡན་ལག་དང་ལྡན་པས་གསལ་བར་བྱེད་པའི་ཁྱད་པར་གྱི་ལས་བསྟན་པའི་ཕྱིར།",
    "དེ་ལ་གསལ་བ་ནི་ཟླ་བའི་དཀྱིལ་འཁོར་ཏེ་དེ་ནམ་མཁའི་ཡང་ཡིན་ལ་རྡོ་རྗེ་ཡང་ཡིན་པས་དེ་སྟེ་རྣམ་པར་དག་པའི་གཞལ་ཡས་ཁང་དེར་ཞེས་སོ།",
    "དེས་ནི་ཚེ་རིང་བ་ལ་སོགས་པའི་ཡོན་ཏན་གསུངས་པ།",
    "གོང་མའི་རིམ་པས་ཏིང་ངེ་འཛིན་གསུམ་རྫོགས་པར་བྱས་ཏེ།",
    "ད་ནི་འཇམ་དཔལ་སྒྲུབ་པ་ཡོན་ཏན་དང་བཅས་པར་བསྟན་པའི་ཕྱིར།",
    "རྡུལ་ཕྲན་རྡོ་རྗེའི་ལུས་ཞེས་པ་རྣམས་ཐོབ་པར་བསྟན་ཏེ།",
    "དེས་ནི་ཇི་སྐད་གསུངས་པའི་ཡོན་ཏན་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "ཡང་གསུངས་པ་ནམ་མཁའི་ཞེས་པ་རྣམས་ཏེ།",
    "ཨོཾ་བསམས་ན་འདིར་གསུངས་པའི་ཡོན་ཏན་དང་ལྡན་པར་འགྱུར་རོ།",
    "ལུས་དང་ངག་དང་ཡིད་གསུམ་སྐུའི་རྡོ་རྗེ་ལ་སོགས་པ་འདིར་གསུངས་པའི་ཡོན་ཏན་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཞེས་པའི་ཚིགས་བཅད་གསུངས་ཏེ།",
    "ཤིན་ཏུ་ཡང་འགྲུབ་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཡན་ལག་རྣམས་དང་ལྡན་པར་བྱའོ།",
    "སྤྲོ་བ་ལ་སོགས་པ་བྱས་ནས་འཇམ་དཔལ་དང་འདྲ་ཞིང་ཐམས་ཅད་འཇམ་དཔལ་ཉིད་སྣང་བར་འགྱུར་ལ་དངོས་ཉིད་ཚངས་པ་དང་བརྒྱ་བྱིན་ལ་སོགས་པས་ཀྱང་མཐོང་བར་མི་ནུས་ཞེས་པ་ཡིན་ནོ།",
    "རྡོ་རྗེ་གསུམ་གྱི་མཚན་མ་ལྕགས་གསུམ་གསེར་དང་ཟངས་དང་དངུལ་གསུམ་གྱིས་དཀྲིས་པ་ཨོཾ་ལ་སོགས་པའི་ས་བོན་དང་ལྡན་པར་བྱས་ཏེ།",
    "འཁོར་ལོ་འོད་འཕྲོ་ཞེས་པས་ནི་དེ་ཉིད་བསྒྲུབ་པར་བསྟན་པ་སྟེ།",
    "སོ་སོའི་ཇི་སྐད་གསུངས་པའི་ཡོན་ཏན་དང་ལྡན་པར་འགྱུར་རོ།",
    "དེ་རྫོགས་པར་བྱ་བའི་ཕྱིར།",
    "འཁོར་ལོ་སྒྲུབ་པ་ལ་སོགས་པ་གོང་དུ་གསུངས་པའི་དོན་གསལ་བར་བྱེད་པ་དང་།",
    "གོང་མ་བཞིན་དུ་གཞན་ལ་ཡང་སྒྲུབ་པར་གསུངས་པ་ནི་ཏྲི་ཤཱུ་ལ་ཀྱོ་བ་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་འཁོར་ལོའི་མཆོག།",
    "ད་ནི་རྣམ་པའི་མཆོག་ཅེས་པ་ལ་སོགས་པས་ནི་དབྱེར་མེད་པའི་རྣམ་པར་དག་པའི་ཕྱིར།",
    "བཟའ་བའི་སྦྱོར་བ་གསུངས་སོ།",
    "ཕྱག་རྒྱ་བཞི་སྐུ་ཉིད་ལ་ལྡན་པར་བསྟན་པའི་ཕྱིར།",
    "བདུད་རྩི་ལྔ་དག་པར་བྱེད་པའི་ཆོ་གས་ཟོས་ན་རྡོ་རྗེ་གསུམ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ཀུན་ཞུ་བ་ལ་སོགས་པར་བྱ་བ་དང་།",
    "ཆོ་ག་དེའི་ཡོན་ཏན་གསུངས་པ།",
    "བགྲོད་པར་འགྱུར་ཞེས་པའི་བར་དུ་གསལ་བར་སྨོས་སོ།",
    "འདིར་ལུས་རྣམ་པར་གཞག་པའི་ཕྱིར།",
    "ཡན་ལག་བཞི་འབྲས་བུ་དང་བཅས་པ་གསུངས་པ།",
    "སོ་སོའི་བྱེ་བྲག་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ལས་རྣམས་བརྩམ་པར་བྱ།",
    "དེ་རུ་སྤྲོ་བའི་སྒོ་ནས་ཕྱག་བཙལ་མཆོད་དང་བཤགས་དང་བསྔོ་བ་དང་།",
    "མཉེས་པར་བྱས་ཀྱང་མི་འཆགས་ཏེ།",
    "བསྟེན་ན་མྱུར་དུ་འགྲུབ་པར་འགྱུར།",
    "ཐམས་ཅད་མཁྱེན་པ་མི་འགྲུབ་པའི་ཕྱིར།",
    "རྡོ་རྗེའི་སྐྱེ་མཆེད་རིམ་པ་འདིས་རྣམ་པར་སྤྱད་པའོ།",
    "ལུང་ནས་སྐུ་གསུམ་གྱིས་རྣམ་པར་དག་པའི་དོན་དུ།",
    "གསོལ་བ་གདབ་པ་མེད་པར་ཐམས་ཅད་སྐུ་གསུང་ཐུགས་སུ་བྱིན་གྱིས་བརླབས་པ་ནི་ཆེན་པོའི་སྐྱེས་བུ་བྱེད་པའི་འབྲས་བུ་དང་ཆེན་པོའི་སྒྲུབ་པའོ།",
    "ཕཊ་སེར་པོས་སེམས་བྱུང་བ་དགག་པའི་ལས་ཁྱད་པར་གྱི་ངོ་བོས་བསྐྱོད་པ་དེ་ནི་སྒྲུབ་པའོ།",
    "ཉེ་བར་བསྒྲུབ་པ་ནི་རིགས་ཀྱི་མཆོག་ཏུ་གང་གྱུར་པའི་མིག་ལ་སོགས་པའི་སྐྱེ་མཆེད་རྣམས་རྡོ་རྗེའི་བདག་ཉིད་ཀྱི་རྣམ་པར་དཔྱད་པ་སྟེ།",
    "རྡོ་རྗེ་ཅན་ཉིད་ཀྱི་གཟུགས་བསམ་པར་བྱའོ།",
    "རྣལ་འབྱོར་པ་ཉིད་ཡེ་ཤེས་རྡོ་རྗེ་སྟེ་དེས་འགྲུབ་པར་འགྱུར་རོ།",
    "སྐུ་གསུང་ཐུགས་གསུམ་ཀའི་ངོ་བོ་གསུངས་བ།",
    "བསྙེན་པ་ཁོ་ནས་གཞན་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "འདིར་གོང་དུ་རིམ་པར་བཀོད་པ་ནི་ཆུང་ངུའི་ཡན་ལག་ཏུ་ཤེས་པར་བྱའོ།",
    "ཞུས་པའི་དེ་མ་ཐག་གསུངས་པ་དེ་ནས་སྟོན་པ་ལ་སོགས་པ་སྟེ།",
    "གསུངས་སོ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "ཕྱག་རྒྱ་ཆེན་པོས་དབྱིངས་ཁྱབ་པར་བྱའོ།",
    "ཞེས་པ་ནི་སྣང་མཛད་ལ་སོགས་པར་གནས་ཤིང་དེ་རྣམས་ཉིད་སོ་སོ་དག་ཏུ་སྤྲོ་བར་བྱའོ།",
    "ལུས་ལ་སོགས་པ་བདག་མེད་པར་ཤེས་པའི་སེམས་ཀྱིས་སྔགས་རྣམས་བརྗོད་ནས།",
    "ད་ནི་སྤྱིའི་དེ་མ་ཐག་སྐུ་ལ་སོགས་པ་ཁྱད་པར་གྱི་བཟླས་པ་བསྟན་པའི་ཕྱིར།",
    "དེས་ཡང་དག་པར་རིག་པའི་སྒོ་ནས་བརྟགས་པ་ནི་རིན་ཆེན་འབྱུང་ལྡན་གྱི་བཟླས་པ་ཡིན་ནོ།",
    "དེ་ནི་ཐོགས་མེད་ཅེས་ཏེ་དོན་གྲུབ་ཀྱི་བཟླས་པ་ཡིན་ནོ་བཟླས་པ་གཞན་གསུངས་པ།",
    "དེ་ལ་འདོད་པ་ནི་ལོག་པར་འདོད་པའོ།",
    "དེའི་དོན་གྱིས་མྱོས་པར་འགྱུར་བ་རྣམས་སྐྱོབ་ཅིང་ཕན་གདགས་པའི་ཕྱིར།",
    "ཡང་གཞན་གསུངས་པ།",
    "སྦྱོར་བའི་ཆོ་ག་དང་ལྡན་པར་བྱེད་པའོ།",
    "རིགས་རྣམས་ཀྱི་སྦྱོར་བ་གསུངས་པ།",
    "དེ་ལ་འདོད་པ་ནི་འདོད་པར་བྱ་བའོ།",
    "དེ་ལ་བརྩོན་པ་དང་ལོངས་སྤྱོད་པ་དང་གང་ལྡན་པས་རིག་མ་འདོད་ན་ནི་བསྟེན་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "ལུས་ཀྱིས་ཞེས་པ་ལུས་ངག་ཡིད་གསུམ་རྣམ་པར་དག་པ་སྣང་མཛད་ལ་སོགས་པ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པར་འགྱུར་རོ།",
    "བདག་ཉིད་ཀྱི་སྐུ་གསུམ་ལ་གཟུད་པ་བྱས་ནས་སྤྲོ་བ་ལ་སོགས་པ་བྱའོ།",
    "དེ་ལྟར་ཆོ་ག་བཞིན་བྱས་ནས་མ་གྲུབ་ན།",
    "གསད་པར་བྱ་བའི་ཆོ་ག་བསྟན་ཏོ།",
    "འཁོར་ལོ་དང་ལྡན་པའི་སྣང་མཛད་རྡོ་རྗེ་ནི་དེའི་ཕྱག་ན་བསྣམས་པར་བསྒོམས་ཏེ།",
    "དེ་ལ་འཁོར་ལོ་ཅན་ཞེས་པ་གཙོ་བོར་བྱས་པའི་གཤིན་རྗེ་གཤེད་དོ།",
    "དེ་རྣམས་ལས་བྱུང་བའི་སྐུ་གསུམ་གྱི་ས་བོན་དབྱིངས་ཉིད་དུ་བརྟག་པར་བྱའོ།",
    "ད་ནི་རྒྱ་མཚོ་མནན་པའི་ཆོ་ག་གསུངས་པ་རྣམ་པའི་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེ་ལ་རྡོ་རྗེ་སེམས་དཔར་གང་གྱུར་པ་དེའི་གནས་རྣམས་སུ།",
    "སྣང་མཛད་ལ་སོགས་པ་རིམ་པར་བཀོད་ནས།",
    "དགྲ་རྨོངས་པར་བྱེད་པ་ནི་དགྲའི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "རྒྱས་པར་བྱ་བ་ནི་ནོར་བུ་ཞེས་བ་ལ་སོགས་པའོ།",
    "དེ་རྣམས་ཀྱིས་མངོན་སྤྱོད་ཀྱི་ལས་ཀྱི་ཁྱད་པར་བསྟན་ཏོ།",
    "གཞན་དག་ནི་གོང་དུ་བྱས་སོ།",
    "གང་བར་བསྒོམས་པས་མེའི་དཀྱིལ་འཁོར་དེ་ལ་གནས་པའི་དགྲ་རྣམས་བརླག་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ཞལ་གསུམ་པ་ཞེས་པ་ལ་སོགས་པ་རིམ་བཞིན་སྨོས་སོ།",
    "ཁྲོ་བོ་གཞན་ཡང་གསུངས་པ།",
    "ཆོ་ག་བཞིན་དུ་འདིའི་དོན་བསྒོམས་ན་དེའི་ཞེས་པ་ལ་སོགས་པ་ཇི་སྐད་གསུངས་པའི་ཡོན་ཏན་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཕྱི་མ་ཉིད་ཀྱང་རྗེས་སུ་དཔག་པར་བྱའོ།",
    "ལྷའི་ཏིང་ངེ་འཛིན་ལས་གྱུར་བའི་ཁྲོ་བོས་དེ་ཉིད་འགྲུབ་པར་འགྱུར་རོ།",
    "ད་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་ཕྲིན་ལས་རྣམས་སྔགས་ཀྱིས་དགུག་པའི་རྣམ་པར་སྤྲུལ་པའི་དོན་བསྟན་པའི་ཕྱིར་བཅུ་བཞི་པའི་དེ་ནས་ཞེས་པ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་དང་ལྷན་ཅིག་པའི་ཡབ་རྣམས་ཀྱང་གསུངས་པར་མངོན་ནོ།",
    "ལས་རྣམས་སྒྲུབ་པའི་ཕྱིར་དེ་ལ་སྙོམས་པར་ཞུགས་ནས་ཤེའོ།",
    "དེར་མ་ཟད་དེ་ཉིད་རྣམ་པར་བསྒྱུར་བས་རྒྱས་པ་ལ་སོགས་པའི་ལས་རྣམས་སྒྲུབ་ཅིང་བསྐུལ་བར་མཛད་པ་སྟེ།",
    "དེས་ཤི་བ་ཉིད་མཚམས་སྦྱོར་བའི་ཤེས་པ་ནྲྀ་ཨཾ་གུ་ཤ་ཛས་བཀུག་ནས་རོ་གོང་མ་ལ་བསྟིམས་པ་དེ་ལས་གཙོ་བོའི་སྐུར་གྱུར་ནས་གཉིས་སུ་མེད་པར་བྱས་ན་སོས་པར་འགྱུར་རོ།",
    "དེས་ཀྱང་ལས་རྣམས་བསྒྱུར་བའི་སྒོ་ནས་འགྲུབ་པར་བསྟན་ཏོ།",
    "དམ་ཚིག་ཙམ་གྱིས་ཞེས་པ་རིགས་སུ་གང་གྱུར་པས་དེའི་སྔགས་སྨྲས་པ་ཙམ་གྱིས་ཀྱང་བྱེད་པར་འགྱུར་རོ།",
    "བཟླས་པ་ལ་སོགས་པ་བྱས་ནས་གང་བྱ་བ་རྣམས་འགྲུབ་པར་བསྟན་ཏོ།",
    "སྔགས་ཀྱི་ཆེ་བ་བསྟན་པ་འདི་ནི་གསུངས་མ་ཐག་ཅེས་པ་ལ་སོགས་པའོ།",
    "དེ་ལ་ཚུལ་བཞིན་བྱས་ན་ཞེས་པ་ནི་ཆོ་ག་བཞིན་ཏེ།",
    "ལས་ཐམས་ཅད་པར་གང་གྱུར་པས་རས་མ་ལ་སོགས་པ་བབ་མ་ལ།",
    "འདིར་ཡང་གཞན་གྱིས་མི་ཐུབ་པར་གྱུར་པས།",
    "མིད་བར་དུ་བཅུག་ནས་བསྐུལ་ཚིག་དང་ལྡན་པའི་སྔགས་བརྗོད་པར་བྱའོ།",
    "དེའི་སྦྱོར་བས་དུག་རྣམས་མེད་པར་བྱེད་པའོ།",
    "དེ་རྣམས་ལ་ཁྲག་དང་གཅིན་གྱིས་སྦྲུས་པ་ལ་གཟུགས་བྱས་ཏེ།",
    "འཇིག་རྟེན་གསུམ་དུ་ཆར་བ་དབབ་པ་ནི་སྟོབས་པོ་ཆེར་གང་གྱུར་པས་བསྙེན་པ་རྣམས་སྔོན་དུ་བྱས་ཏེ།",
    "དེས་ཀླུ་རྣམས་ཀྱིས་ཆར་གྱི་རྒྱུན་འབེབས་པར་བསམས་ནས།",
    "དེ་ལྟ་བུའི་ཆོ་གས་འགྲུབ་པར་འགྱུར་རོ།",
    "བདག་གནོད་མཛེས་ཀྱི་རྣལ་འབྱོར་དུ་བྱས་ལ།",
    "གྲོག་མཁར་གྱིས་ལ་སོགས་པ་ལས་སྟོབས་པོ་ཆེའི་གཟུགས་བྱས་ཏེ།",
    "སྟོབས་པོ་ཆེ་ཆོ་གས་རྫོགས་པར་བྱས་ནས།",
    "བཀུག་ཅིང་བཟླས་ན་ལྷ་མཐུ་བོ་ཆེ་ལ་སོགས་པ་ཀུན་འགུགས་པར་འགྱུར་བའི་དོན་ཏོ།",
    "གྲོག་མཁར་གྱི་ས་ལ་སོགས་པ་ལས་བསྒྲུབ་བྱའི་གཟུགས་བརྙན་བྱས་ཏེ།",
    "རྡོ་རྗེའི་ལྕགས་ཀྱོ་སྤྲོས་ཏེ་བསྔགས་ཏེ་ལྷ་རྣམས་ཐམས་ཅད་འགུགས་པར་འགྱུར་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་གསུམ་གྱི་དེ་མ་ཐག་གསུངས་པ་ནི་ཐམས་ཅད་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "མི་འཆི་བའི་སྔགས་གོང་དུ་བསྟན་པ་ལན་གྲངས་ལྔ་བཅུ་བརྗོད་ན་དགུག་པར་འགྱུར་བས་ན་དགུག་པར་བྱའོ།",
    "རིགས་གང་དུ་གྱུར་པའི་རྣལ་འབྱོར་པས་རྡོ་རྗེ་ཀྱོ་བའི་ཇི་ལྟ་བ་དང་ལྡན་པར་བྱའོ།",
    "བཙག་གམ་རྡོ་རྒྱུས་གང་རུང་ཁར་བཅུག་ནས་བསྙེན་པ་ལ་སོགས་པ་རྫོགས་ནས་དང་པོར་ཟླ་བ་གཟས་ཟིན་པ་ནས་མཐར་གྱི་བར་དུ་སྤྲོ་བ་ལ་སོགས་པའི་ཆོ་ག་བྱས་ན་ཚངས་པ་ལ་སོགས་པ་གང་དགུག་པའི་མིང་བྲིས་ནས།",
    "སྔགས་བཟླས་པ་ལ་སོགས་པ་བྱས་ན་གདོན་མི་ཟ་བར་འོང་བར་འགྱུར་རོ།",
    "སྔགས་བཟླས་པ་དང་ལྡན་པས་བཀུག་ལ་སྤྱད་པར་བྱའོ།",
    "དེ་ལ་ཀུན་གྱི་ཕྱག་རྒྱ་ནི་གང་ཡིན་པའི་ཁྱད་པར་རོ།",
    "དེ་སོ་སོའི་སྔགས་ཀྱི་ཁྱད་པར་གྱིས་སྤྲོ་བ་ལ་སོགས་པ་དང་།",
    "དེའི་གནས་ལ་སོགས་པ་དང་ལྡན་པར་བསྟན་པ་ནི་དགུག་པའི་ཐབས་སུ་གསུངས་པ་ཡིན་ཏེ།",
    "བསྐུལ་བ་དང་ལྡན་པའི་སྔགས་བཟླ་བ་ལ་སོགས་པ་བྱས་ཏེ་བཀུག་ནས་སྤྱད་པར་བྱའོ།",
    "རྒྱན་ཆ་དང་ལྡན་པ་རྣམས་འགུགས་པར་འགྱུར་རོ།",
    "གཉིས་སུ་མེད་པའི་རང་བཞིན་དུ་སྦྱོར་བ་དང་ལྡན་པས་འགུགས་པར་བསྟན་ཏོ།",
    "ད་ནི་སྔགས་འབའ་ཞིག་ཁོ་ན་བཟླས་པས་འགྲུབ་པར་བསྟན་པ་ནི།",
    "དྲག་པོའི་སྦྱོར་བའི་བསྒྲུབ་བྱའི་ཁྱད་པར་ནི་རྡོ་རྗེ་སློབ་དཔོན་སྨོད་པ་དང་ཞེས་པ་རྣམས་སོ།",
    "ཕྱོགས་བཅུའི་ཞེས་པ་ལ་སོགས་པ་ནི་གསོད་ནུས་པར་བསྟན་པ་སྟེ།",
    "ཁྲོ་བོའི་ངང་ཅན་གྱིས་དེའི་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་ངེས་པར་འཇིག་པར་འགྱུར་རོ།",
    "གཤིན་རྗེ་གཤེད་ལ་སོགས་པར་གང་གྱུར་པས།",
    "གཟུགས་བརྙན་བྱས་ལ།",
    "དེ་ཉིད་ནི་རྡོ་རྗེ་རྒྱ་གྲམ་གྱིས་ཀྱང་མནན་པར་བྱའོ།",
    "དེའི་ཆོ་ག་ནི་ཡ་མཱནྟ་ཀ་ལ་སོགས་པར་གང་གྱུར་པས།",
    "དགྲའི་སྒོའམ་གྲོང་དུ་བཞག་ན་བསྐྲད་པར་འགྱུར་རོ།",
    "ལས་གཞན་གསུངས་པ་ཏ་ལའི་ཞེས་པ་རྣམས་ཏེ།",
    "འཆིའམ་འོན་ཏེ་བསྐམས་པར་འགྱུར་བས།",
    "རྡོ་རྗེ་ཕུར་བུས་གདབ་པར་བྱ།",
    "དེ་ལ་སྐུ་ལ་སོགས་པ་ངེས་པར་འཆིང་བ་ནི་ངེས་པར་གཅིག་ཏུ་དབྱེར་མེད་པ་སྟེ།",
    "འདིའི་ཆོ་ག་ནི་གང་དུ་གང་གྱུར་པས་ཆོ་ག་བཞིན་དུ་གཟུགས་བརྙན་བྱས་ཏེ།",
    "ལྕགས་ལས་བྱས་པའི་ཕུར་བུ་སྨད་གསལ་ཤིང་སྟོད་དགྲ་བགེགས་ལྟ་བུའི་གཟུགས་བསམས་ནས།",
    "གང་ལྡན་པས་ཨོཾ་གྷ་གྷ་གྷཱ་ཏ་ཡ་ཞེས་པའི་སྔགས་བཟླས་ཤིང་གདབ་པར་བྱའོ།",
    "དེས་ཐུགས་ཀྱི་རྡོ་རྗེ་ལ་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་གདབ་པར་བྱའོ།",
    "ད་ནི་སྣང་མཛད་ཀྱི་རིགས་དང་འབྲེལ་པའི་གཤིན་རྗེ་གཤེད་ཀྱི་ཕུར་བུས་དེའི་སྐུའི་རྡོ་རྗེ་ལ་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་གདབ་པར་བསྟན་པའི་ཕྱིར།",
    "རྣམ་པར་སྣང་མཛད་ཅེས་པའི་ཚིག་སྨོས་སོ།",
    "སྐུའི་རྡོ་རྗེ་ལ་སོགས་པ་གོང་དུ་གསུངས་པ་རྣམས་ལ་བདུད་རྩི་ཉིད་ཀྱི་ཕུར་བུས་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་གདབ་པར་བསྟན་པ་ཡིན་ཏེ།",
    "གཟུགས་བརྙན་བྱས་ལ་གང་ཡིན་པ་བཀུག་ནས།",
    "གཤིན་རྗེ་གཤེད་ལ་སོགས་པར་གང་གྱུར་པས་དེའི་ཕུར་བུས་ཇི་ལྟ་བ་བཞིན་གདབ་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ལ་སྐུའི་རྣམ་པར་སྤྲུལ་པ་ཞེས་པ།",
    "དམ་པའི་དོན་གྱིས་འདི་སྐད་གསུངས་སོ་ཞེས་སོ།",
    "ད་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་བསྒྲུབ་པ་གསུངས་པ།",
    "དང་པོར་གསང་བའི་དབྱིངས་སུ་རྣམ་པར་སྣང་མཛད་དུ་བསྒོམས་ནས།",
    "སྨེ་ཤ་ལ་སོགས་པ་བྱིན་གྱིས་བརླབ་པར་བྱས་ཏེ།",
    "སྦྱོར་བའི་ཆོ་གས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "རྡོ་རྗེ་སེམས་དཔར་གང་གྱུར་པས་བཙོ་བླག་མཁན་ལ་སོགས་པའི་གཟུངས་བྱིན་གྱིས་བརླབ་ཞེས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "སྦྱོར་བའི་ཆོ་ག་ལ་གནས་ནས་གསང་བའི་དོན་ལ་འཇུག་པར་བྱའོ།",
    "སྣང་བ་མཐའ་ཡས་སུ་གང་གྱུར་པར་བྱས་པས།",
    "གསང་བའི་ཆོ་གས་བསྒྲུབ་པར་བྱ་བ་ལ།",
    "དབུགས་ཞི་བར་བྱ་བ་གང་ཡིན་པ་གསང་བའི་དོན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "དེའི་ཆོ་ག་ཤེས་པ་ཉིད་ཀྱིས་སྐུ་ལ་སོགས་པའི་སྦྱོར་བ་གང་རྣམས་བསམ་པར་བྱའོ།",
    "ཉིན་གུང་ལ་སོགས་པར་བཀུག་ནས།",
    "སྔགས་ཀྱི་བར་དུ་ཡང་མིང་བཅུག་ནས་སྟོང་བཟླས་ཏེ་བསྲེག་པར་བྱའོ།",
    "དེའི་ཡོན་ཏན་དང་སྐྱོན་གསུངས་པ།",
    "དགྲ་བགེགས་གང་ཡང་རུང་བའི་གཟུགས་བྲིས་ཏེ་དགུག་པ་བྱས་ལ།",
    "བསད་པའི་ཆོ་ག་གཞན་གསུངས་པ།",
    "བདག་བདུད་རྩི་འཁྱིལ་པ་ལ་སོགས་པར་བསྒོམས་ནས།",
    "མིད་པ་བཅད་པར་བསྒོམས་ན་འགྲུབ་གསུངས་པའོ།",
    "ཡང་ན་མནན་པའི་ལས་ཀྱིས་བསད་པ་གསུངས་པ།",
    "ཡང་གཞན་གསུངས་པ་དཀྱིལ་འཁོར་ཞེས་པ་སྟེ།",
    "ཕཊ་ཅེས་པ་གསང་བའི་དོན་གསུངས་པ་སྟེ།",
    "མི་བསྐྱོད་པའི་སྐུར་བསྒོམས་ནས་ཡུམ་གྱི་པདྨ་རྒྱས་པར་བྱས་ནས་གསང་བ་ལ་སྦྱོར་བའི་ཆོ་གས་ཧཱུཾ་བསྒོམས་ཏེ།",
    "གནས་ཡིད་དང་མཐུན་པར་བསྐྱེད་པའམ་རྫོགས་པས་རང་ཉིད་ལྷའི་རྣལ་འབྱོར་དུ་བྱས་ཏེ།",
    "བསམ་གཏན་གྱི་ཆོ་ག་ཡང་གསུངས་པ།",
    "དབབ་པའི་ཆོ་ག་གསུངས་པ།",
