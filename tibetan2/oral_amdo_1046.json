    "གཏེར་སྒྲོམ་རེབ་དང་གཏེར་སྒྲོམ་གནས།",
    "དྲེག་གྲུམ་འབམ་འཇུག་རེ་འཁུམས་བཤིག་པར་བྱེད།",
    "གཡང་མོ་ཐང་གི་མེ་ཏོག་སེར་པོ་ཐ་ཐོར་དུ་བཞད་འདུག་རྫིང་གི་རྒྱ་ཁྱོན་སྨི་གྲུ་བཞི་མ་དྲུག་ཙམ་རྡོ་བརྩིགས་དང་།",
    "ན་ཐང་འདྲེས་མཚམས་ཀྱི་རྡོ་ཧྲུག་གི་སེང་དབར་ནས་ཆུ་འབུར་འབུར་དུ་ཡར་ཚད་འཕགས་ཏེ་འཁོལ་བཞིན་ཐོན་གྱིན་འདུག་ཆུ་ཚན་དེ་ཏཱ་ལ་སྐུ་འཕྲེང་རིམ་བྱོན་རྣམས་ཁྲུས་གསོལ་གྱི་ཆུ་རྫིང་ཡིན་པས་སྔར་སྐྱེ་བོ་གཞན་སུས་ཀྱང་དེར་ཆུ་ཚན་རྒྱུག་གི་མེད་པ་རེད།",
    "ཆུ་རྫིང་ནང་ས་རོ་རྡོ་རོ་རྒྱངས་ཏེ་བེད་སྤྱོད་བྱེད་ས་མེད་པ་བཟོས་ཡོད་པ་རེད།",
    "ལྷག་པར་གྲོ་ལོ་ཁའི་ཆུ་རྫིང་གི་མཐིལ་དུ་སྔར་རྡོ་གཡམ་གཅལ་དུ་བསྒྲིགས་ཡོད་པ་ཉམས་གསོ་དང་།",
    "ཆུ་ཚན་གྱི་རྒྱ་ཁྱོན་ནི་སྤྱི་ལེ་གྲུ་བཞི་མ་ཉི་ཤུ་ལྷག་ཙམ་གྱི་དཀྱིལ་དུ་སྔར་གྱི་རྡོ་བཙུགས་གྲུ་བཞི་མ་སྐར་མ་བཞི་བཅུ་ཙམ་འབུར་ཐོན་དང་།",
    "གྲོ་ལོ་ཐང་གི་ནུབ་ཕྱོགས་རྫིང་ཕྱིའི་གཙང་ཆུ་དྭངས་གཙང་བྱང་ནས་ལྷོ་རུ་རྒྱུ་བ།",
    "བྱང་ཤར་ས་ཐག་རིང་པོ་ན་ཡོད་པའི་གངས་རིའི་རྩེ་མོ་མཐོང་བ།",
    "ཤར་ཕྱོགས་ཉི་མ་གླིང་གི་རི་བོ་མཎྜལ་གྱི་ཚོ་མ་བུ་ལྟ་བུ་དང་།",
    "སླར་ཡང་ལོ་ལབ་ནས་བོ་སྟོད་ལ་མ་སླེབས་ཙམ་དེར་གློག་ཁང་གསར་པ་ཆེ་བ་ཞིག་གསར་རྒྱག་བྱས་ཡོད་པ་རེད།",
    "ཆུ་ཚན་ལ་ཕེབས་མཁན་དང་བཅས་པར་མགྲོན་ཁང་གསར་རྒྱག་བྱས་པ་ཡིན་ན་འོལ་དགའ་ཡུལ་ལུང་གི་ཐོན་ཁུངས་མར་ཕྱུར་དང་།",
    "ཆང་ཁ་ལྡིར་གང་ཨའུ་ཧྥང་ཙམ་ལ་རིན་དངུལ་ཁ་གང་ཞེས་སྐར་ཕྱེད་གསུམ་བྱེད་པ་དྲན་གྱི་འདུག་དེ་དུས་ལྷ་སར་འབྲུ་རུའི་ཁལ་རེར་རིན་དངུལ་སྲང་གང་ཞོ་ལྔ་རེ་ཡིན་ཚོད་འདུག་མར་ལྷ་སྲང་གི་འདེགས་ཁལ་རེར་རིན་འབྲུ་རུའི་ཁལ་གཉིས་རེ་རྒྱུ་ཁྱབ་ཏུ་བྱེད་པས་དངུལ་ལ་ཕབ་ན་མར་འདེགས་ཁལ་རེར་རིན་དངུལ་སྲང་དོ་ཞོ་ལྔ་དང་སྲང་གསུམ་ཡས་མས་དང་།",
    "ཇ་འབྲུ་དང་སྦག་ཆུང་རེར་རིན་དངུལ་སྲང་མེད་ཞོ་གསུམ།",
    "ཇ་རིལ་རེར་རིན་དངུལ་སྲང་མེད་ཞོ་གང་།",
    "འབྲི་བེའུ་སྐྱེ་རྒྱུ་ཡོད་པ་རེར་རིན་འབྲུ་རུའི་ཁལ་བཅོ་ལྔ་རེ་དང་།",
    "བཤའ་གཡག་ལེགས་པ་རེར་རིན་དངུལ་སྲང་ཉི་ཤུ་རྩ་བཞི་རྩ་ལྔ་རེ།",
    "ལུག་རེར་རིན་དངུལ་སྲང་གང་ཞོ་ལྔ་དང་།",
    "ར་རེར་རིན་དངུལ་སྲང་གང་ཞོ་དོ།",
    "བཞོན་དྲེལ་ལེགས་པ་རེར་རིན་དངུལ་སྲང་དྲུག་ཅུ་བདུན་ཅུ་ཙམ་རེ།",
    "ཤ་མོག་མོག་ཅུང་ཆུང་བ་གསུམ་རེར་རིན་དངུལ་ཁ་གང་།",
    "ལུག་ཤ་ཁོག་རེར་རིན་དངུལ་སྲང་དོ་རེ་བྱེད་ཅིང་།",
    "བཀའ་བློན་སོགས་དཔོན་རིགས་ཀྱི་སྐུ་མདུན་དུ་བཅར་སྐབས་འབུལ་མཚན་ལུག་ཤ་ཁོག་རེ་ངེས་པར་དུ་འབུལ་དགོས།",
    "ཁ་བཏགས་རེ་འབུལ་སྲོལ་ཆགས།",
    "ནོར་གླིང་གང་ཡིན་གྱི་གཟིམ་ཆུང་འགག་ཏུ་དྲུང་ཇ་ཚོགས་པའི་དུས་སུ་ཐོན་ཕྱག་མཇལ་ཁར་བཅར་དགོས་ཐོན་གནང་ཞེས་གནང་ཆར་དངུལ་སྲང་མེད་ཞོ་བདུན་སྐར་ལྔ་ཡོད་པའི་ཤོག་ཆག་ལ་ཆའི་རྟགས་ཐམ་དམར་པོ་བརྒྱབ་པ་ཞིག་གསོལ་རས་གནང་སྲོལ་འདུག་པ་ཚོད་དཔག་བྱས་ན་སྔར་ལུག་ཤ་ཁོག་རེ་གསོལ་རས་མེད་དམ་སྙམ།",
    "གཞུང་འབྲུ་ཚོང་མཚམས་བཞག་པ་དང་དེ་མ་ཐག་ཏུ་རིན་གོང་འཕར་ཏེ་རིང་པོར་མ་སོང་བར་འབྲུ་རུའི་ཁལ་རེར་རིན་དངུལ་སྲང་བཞི་དང་ཞོ་ལྔ་བྱས་སོང་།",
    "མར་ལ་ཡང་ལྷ་སྲང་གི་འདེགས་ཉག་ལྔ་རེར་རིན་དངུལ་སྲང་གང་རེ་བྱེད་མུར་བཞི་སྲང་དང་།",
    "མཐར་ཉག་སྲུང་བྱས་ཏེ་མར་འདེགས་ཁལ་རེར་རིན་དངུལ་སྲང་ཉི་ཤུ་ཐམ་པ་རེ་དང་།",
    "ཇ་སྦག་ཆུང་རེར་རིན་དངུལ་སྲང་གང་ཞོ་ལྔ་རེ།",
    "ཇ་རིལ་རེར་རིན་དངུལ་སྲང་མེད་ཞོ་ལྔ་རེ།",
    "ཟི་ལིང་ཕོ་རྟ་འགྲོས་མ་ལེགས་པ་རེར་རིན་དངུལ་ཊམ་རྡོ་དྲུག་བདུན་ཙམ་རེ།",
    "བཞོན་དྲེལ་ལེགས་པ་རེར་རིན་ཊམ་རྡོ་ལྔ་ནས་དྲུག་བར།",
    "ཁལ་དྲེལ་རེར་རིན་ཊམ་རྡོ་གསུམ་ནས་བཞི་བར་བཅས་བྱས་ཏེ་ཉོ་ཚོང་བྱེད་ཀྱི་འདུག་རྟ་དྲེལ་ཉོ་ཚོང་གི་དུས་ཚོད་བཟང་ཤོས་ནི།",
    "བོད་ཟླ་བརྒྱད་པའི་ཚེས་ཤར་ལ་ཟི་ལིང་གི་ཚོང་པ་ལྷ་སར་འབྱོར་དུས་ཚོང་པ་མང་ཆེ་བས་རྟ་དྲེལ་ཚོང་གཉེར་བྱེད་པ་ཡིན་པས་དེ་དུས་རྟ་དྲེལ་སྤུས་དག་མང་པོ་འདེམས་སྒྲུག་གིས་ཉོ་རྒྱུ་ཡོད།",
    "དེའི་དུས་སུ་འཁོར་ལོའི་རིགས་དར་ཁྱབ་མེད་པར་བརྟེན་རྟ་དྲེལ་ལ་མཐོང་ཆེན་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "རྭ་སྒྲེང་རྒྱལ་ཐོག་སྐབས་ཉོ་ཐང་རིམ་འཕར་གྱིས་བར་སྐབས་ཤིག་ལ་འབྲུ་རུའི་ཁལ་རེར་རིན་དངུལ་སྲང་བརྒྱད་རེ་དང་།",
    "ཇ་སྦག་ཆུང་རེར་རིན་དངུལ་སྲང་དོ་རེ་བྱེད་སྐབས་ལྷ་སར་སྐུ་མ་མང་བ་ས་རིབ་མ་རིབ་ནས་ཁང་པའི་སྒེའུ་ནང་ཤིང་སྐས་བཙུགས་ཏེ་རྐུན་མ་མང་པོ་ཤོར་བར་རྐུན་མ་འདུག་གོ་ཞེས་སྐད་འབོད་བྱེད་སྐབས་རྐུན་མ་བས་ཞེད་སྣང་མི་བྱེད་པར།",
    "རྐུ་མ་མ་རྐུ་རང་རྐུ་རེད།",
    "དེའི་སྐབས་བཀའ་ཤག་གི་རྒྱལ་སྒོའི་ལྡེབས་སུ་ཡིག་བསྐུར་སྦྱར་བའི་ནང་།",
    "མར་འདེགས་ཁལ་རེར་རིན་དངུལ་སྲང་སུམ་ཅུ་ནས་སུམ་ཅུ་སོ་ལྔ་སྐོར།",
    "ཇ་སྦག་ཆུང་རེར་རིན་དངུལ་སྲང་གསུམ་ནས་བཞི་བར།",
    "ཇ་རིལ་རེར་རིན་དངུལ་སྲང་གང་ནས་སྲང་གང་ཞོ་ལྔ་བར།",
