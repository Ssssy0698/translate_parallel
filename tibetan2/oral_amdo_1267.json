    "འདི་ནི་ཁྲ་འབྲུག་སྒྲོལ་མ་ལྷ་ཁང་ཞུ་བའི་སྙན་གྲགས་ཆེན་པོ་དེ་རེད་ལ།",
    "ལྷ་ཁང་དེར་རྟེན་གཙོ་ཉེ་སྲས་བརྒྱད་མི་ཚད་ཙམ་རེ་ཟི་ཁྱིམ་ལས་གྲུབ་པའི་སྐུ་ཡིན།",
    "ལྷ་ཁང་གི་སྒོ་ནང་གི་འགྲམ་དེར་བཞེངས་བཞིན་ཉེ་སྲས་རྣམས་ལ་སྣེ་ལེན་གྱི་ཚུལ་དུ་ཕྱག་གཉིས་ཀྱི་བརྡ་དང་བཅས་ཡར་ཕེབས་ཡར་ཕེབས་ཞེས་གསུང་བྱོན་པ་དང་།",
    "ཕྱག་སྟོང་པ་མི་འབྱུང་ཕྱིར་ཞལ་ཟས་ཤིག་ཕྱག་མཐིལ་དུ་བཞག་ནས་ཡོད་པ་དེ་རེད།",
    "འདིའི་ཕུ་རུ་ཡར་ལྷ་ཤམ་པོ་གངས་ཀྱི་ར་བ་ཞེས་འབྲོག་མི་ལོ་ཙཱ་བ་དཔལ་གྱི་ཡེ་ཤེས་ཀྱིས་མ་མོ་སྒྲུབ་པའི་གནས་སོགས་ཡོད་ཀྱང་མཇལ་མ་ཐུབ།",
    "སྤྱིར་ཡར་ཀླུང་གི་རྒྱབ་ཕྱོགས་ལྷོ་ཁ་སྟོད་སྨད་དུ།",
    "གུང་ཐང་འབུམ་མོ་ཆེའམ།",
    "ཡར་ཀླུང་ཤེལ་བྲག་གི་སྒྲུབ་གནས་ཆེན་པོར་སྒྲུབ་ཕུག་ལྟེ་བར་གུ་རུའི་སྐུ་གསུང་བྱོན་མ་དང་།",
    "འདིའི་རྒྱབ་རི་བཙན་ཐང་སྒོ་བཞི་ཞེས་པའི་རྩེ་མོར་བོད་རྒྱལ་གཉའ་ཁྲི་བཙན་པོ་དང་པོ་བབ་ས་དེ་ཡིན།",
    "གོང་གི་གུང་ཐང་འབུམ་པ་ནས་འཕྱོངས་རྒྱས་ཕྱོགས་སུ་ཕྱིན་ན་བེ་རོ་ཙ་ན་བཞུགས་ས་སྤ་གོར་དགོན་དང་སྒྲིབ་ཕུག་རོགས་པ་རྩ་སོགས་ལམ་ཁར་ཡོད་འདུག་ཀྱང་རྒྱུས་མེད་པས་མཇལ་མཁན་དཀོན།",
    "དེ་ནས་ཡར་ཕྱིན་པའི་ལམ་ཁར་ཁུ་སྟོན་བརྩོན་འགྲུས་གཡུང་དྲུང་གི་གདན་ས་སོལ་ནག་ཐང་པོ་ཆེར་འབུམ་ནག་ཟིལ་པ་ཅན་སོགས་རྟེན་རྙིང་མང་ཙམ་དང་།",
    "དེ་ནས་རིམ་པར་པཎ་ཆེན་བྱམས་པ་གླིང་པའི་གདན་ས་སྐུ་འབུམ་མཐོང་གྲོལ་ཆེན་མོའི་ནང་ལྷ་ཁང་ཤིན་ཏུ་དངོས་གཙང་ཅན།",
    "གྲྭ་ནང་བརྒྱད་གླིང་ཚོགས་པ།",
    "ལྷ་མོ་དུད་སོལ་མ་གསུང་བྱོན།",
    "འདུ་ཁང་ཕུག་གི་གཙོ་ཁང་དུ་པཎ་ཆེན་ག་ཡ་རྡ་རའི་དབུ་ཐོད་བཞུགས་པའི་ཐུབ་སྐུ་སོགས་ཁྱད་པར་ཅན་ཡོད།",
    "ང་ཚོ་ལྷོ་གནས་རྒྱས་པར་འགྲོ་རྒྱུར་གཙང་པོ་ལྷོ་རྒྱུད་ནས་མར་ཕྱིན།",
    "མངའ་བདག་ཉང་གི་གཏེར་ནས་བྲག་སྲིན་མོའི་སྦར་རྗེས།",
    "འདི་ནས་མངའ་བདག་ཉང་གིས་བཀའ་བརྒྱད་བདེ་གཤེགས་འདུས་པ་གཏེར་ནས་བཞེས་པ་ཡིན།",
    "འདི་དང་ཉེ་བར་ལྷ་མོ་མཁར་ཆེན་ཞེས་ཡུལ་ཉེར་བཞིའི་དེ་བཱི་ཀོ་ཊ་ཡིན་པར་བཞེད་ཅིང་།",
    "བདེ་མཆོག་གི་གནས་ཁྱད་པར་ཅན།",
    "ལྷོ་བྲག་ལྷ་ཁང་ནས་མར་སོང་ན་ཟམ་པར་ཟམ་གླ་དགོས་ཤིང་།",
    "ཟམ་པའི་ཚུར་ཕྱོགས་ཀྱི་གྲོང་པ་འགའ་རེར་སྟེང་ཐོག་ཐུག་ནག་བཙུགས་ཡོད་པ་དེ་ཚོས་དུག་སྟེར་གྱི་རེད་ཟེར་སྲོལ་འདུག་ཟམ་པའི་ཕ་རིར་ཚེ་ལམ་དཔལ་གྱི་རི་ཞེས་གུ་རུའི་སྒྲུབ་ཕུག་དང་།",
    "མི་ལའི་སྒྲུབ་གནས་ལྟག་གཉའ་ལུང་བསྟན་ཕུག་མི་ལའི་སྲས་མཁར་དགུ་ཐོག་གི་ཐོག་རྩེག་བརྒྱད་སོགས་སྒྲུབ་གནས་ཁྱད་པར་ཅན་དང་།",
    "ཕྱི་ནང་གི་རྟེན་ཐམས་ཅད་མཇལ།",
    "འདི་རུ་སྡོད་པ་ལས་གཞན་དུ་མི་འགྲོ་ཞེས་གསུང་འབྱོན་སྟབས་རི་མགོའི་མཚོ་ཁར་རྡོའི་རྩིག་ར་དེའི་ནང་བཞུགས་པ་རེད་ཟེར།",
    "མཚོ་འདི་ཡང་འགའ་ཞིག་གིས་གྲགས་པའི་མཚོ་ཆེན་བཞིའི་གྲས་སུ་བརྩི་ཞིང་།",
    "ས་འདི་སྔ་མོ་བཀའ་བརྒྱུད་པའི་གདན་ས།",
    "ཕྱིས་སུ་པད་གླིང་གི་རྒྱུད་འཛིན་གསུང་སྤྲུལ་རིམ་བྱོན་གྱིས་བསྐྱངས།",
    "རྟ་རྒོད་ཀྱི་ར་རྟཱ་རེད་ཟེར་བ་སོགས་མཇལ་རྒྱུ་ཡོད།",
    "དགོང་མོ་མཚོ་འགྲམ་བྲག་འབུར་ཞིག་གི་ཕག་ཏུ་རྡོ་ར་ཡོད་སར་ཉལ།",
    "མཚན་མོར་མཚོ་གླང་གིས་མཚོ་འོག་ནས་སྐད་རྒྱག་པ་དང་།",
    "རྭ་རྩེ་འཁྱག་རུམ་ལ་ཐུག་པ་རེད་ཅེས་སྒྲ་ཡང་ཐོན།",
    "སང་སྔ་མོར་ཕྱིན་པས་གྲང་ངར་དང་།",
    "བར་མཚམས་ཤིག་ཏུ་ཕྱུགས་རྫི་ལྟ་བུ་འབྲོག་པ་ངོ་གདོང་ནག་པོ་ཅན་ཞིག་དང་ཐུག་སོང་ལ་འགྲོ་ལམ་སྐད་ཆ་དྲིས་པར།",
    "མི་རེ་རེ་བཞིན་མགོ་ནས་རྐང་བར་ལྟ།",
    "ང་ཚོས་ཇ་བཀོལ་ཏེ་བསྡད།",
    "རྒྱུན་རིང་ཙམ་སོང་བར་འབྲོག་པ་དེས་ང་ཚོའི་བྱེད་སྟངས་ལ་བལྟས་ནས་གཏམ་ལན་དུ་ཕར་ཚད་ན་ཡོད་པའི་ཇོ་དར་ཡུ་བ་སྐྱ་ཧྲེང་ངེ་བ་ཡོད་པ་དེ་ཚོ།",
    "གཙང་ཕྱོགས་ལ་རུ་གཉིས་སུ་གྲགས་པའི་གཡས་རུ་ཤེལ་མཁར་རྒྱལ་རྩེའི་ལྷོ་ཕྱོགས་ཉེ་རོ་ལུང་ནས་སྒོ་བཞི་རེ་ཐང་ཞེས་སར་སླེབས།",
    "རྒྱལ་རྩེ་ཁོག་ལ་ཉང་གསེར་གཞུང་རིང་མོ་ཞེས་གྲགས།",
    "ཉང་ཆུ་ལྷོ་ཕྱོགས་སུ་འདུལ་གྱི་གཙུག་ལག་ཁང་གི་གྲས་སུ་གྲགས་པ་གནས་གསར་ལྷ་ཁང་དུ་ཡུམ་ཆེན་མོའི་སྐུ་བཞུགས་པ།",
    "ཡུམ་གྱི་དགོངས་རྫོགས་སུ་བཞེངས་པའི་མཆོད་རྟེན་མཐོང་གྲོལ་ཆེན་མོ་སོགས་དང་།",
    "ཞ་ལུ་མཐིལ་གྱི་འོག་ཏུ་ཉང་སྨད་རྒྱན་གོང་དུ་ལྷ་མོ་རབ་བརྟན་མའི་མགོན་ཁང་བྱིན་ཅན་ཡོད།",
    "རྡོ་མ་མོའི་གྲོད་པ་ཞེས་གྲགས་པ་ནོར་བུ་ཡིན་ཟེར་བ་སོགས་ཡོད་ཀྱང་མཇལ་ཞུས་བྱས་ན་བརྒྱ་མཆོད་དང་།",
    "གནས་བརྟན་བཅུ་དྲུག་གི་ཐང་ཀའི་པར་སོགས་ཡོད།",
    "སྣར་ཐང་ཉེ་བར་གཙང་ཆུ་མིག་རིང་མོ་ཞེས་པ།",
    "ཁྱད་པར་བླ་བྲང་གཞུང་དུ་ངོར་ཆེན་རྡོ་རྗེ་འཆང་གི་གཟིམ་ཆུང་།",
    "ཁྲི་དམར་མ་ཞུ་བ་དེ་ནི་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་སྐུ་དངོས་བཞུགས་ཁྲིར་ཐིམ་པའི་གཟི་བྱིན་ཅན་དེ་རེད།",
    "གཡུ་མཁར་མོའི་སྒྲོལ་མ་སེམས་དཔའ་སུམ་བརྩེག།",
    "དབུ་རྩེར་ས་པཎ་གྱི་ཕྱག་བྲིས་འཇམ་དབྱངས་གར་གཟིགས་མ་ཞེས་པ།",
