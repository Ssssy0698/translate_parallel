    "དེ་དང་ཉེ་བར་སྔར་མཚན་ཉིད་གྲྭ་ཚང་ཆེ་བ་སྐྱོར་མོ་ལུང་དང་།",
    "རྒྱ་ནག་ནས་ཀླུ་ཡིས་གདན་དྲངས་པའི་ནོར་མཛོད་ཆེན་མོ།",
    "འཕན་ཡུལ་དུ་ཇེ་རེ་ལྷ་ཁང་ཆེན་མོའི་ཤུལ་དང་།",
    "ད་ནི་ཕ་ཡུལ་དུ་ཕྱིར་ལོག་རྒྱུར་བརྟེན་གངས་ཅན་ཡུལ་གྱི་ལྷ་སྐལ་ར་ས་འཕྲུལ་སྣང་གཙུག་ལག་ཁང་གི་ཇོ་བོ་ཡིད་བཞིན་ནོར་བུ་ཤཱཀྱ་མུ་ནེ་དང་།",
    "ར་བ་ཆེན་མོའི་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེ།",
    "གསེར་རྐོང་ཕུལ་བ་སོགས་བསམ་པ་རྣམ་དག་གི་སྒོ་ནས་ཕྱི་མའི་འགྲོ་དོན་གང་ན་ཅི་མཆིས་ཡང་བསྐྱར་ཞུས།",
    "འདི་རིགས་ནི་ཕ་ཡུལ་ན་མེད་པ་རེད།",
    "དེ་ནས་མི་རེས་ཁྱོག་ཚད་རེ་ཁུར་ནས་རང་ཡུལ་དུ་ཁ་ཕྱོགས་ཏེ་ལྷ་ས་ནས་ཐོན།",
    "མཚོ་མོ་ར།",
    "དེར་སླེབས་དུས་ལམ་འོག་བྲག་གསེབ་དེ་ནས་ཤ་ཁྱི་ཞིག་གིས་རི་དྭགས་གནའ་བ་ཞིག་བཀག་ནས་འདུག་ཁྱི་འདིས་གནའ་བ་འདི་བསད་ན་ཤ་ཟ་རྒྱུ་རྙེད་ས་རེད་ཟེར་རེས་བྱས།",
    "མི་ང་ཚོ་ཡུལ་འདི་ན་རི་དྭགས་ཀྱི་ཤ་དང་།",
    "པགས་པ་ཟ་གོན་གྱིས་མི་ཚེ་སྐྱེལ་མཁན་རེད་ཅེས་ཟེར།",
    "དེ་ནས་ཤར་གངས་ལ་ལུང་པའི་ལ་བུད་ཟེར་བ་ལྟར་ཚུར་ཕྱོགས་ནས་ལུང་པའི་ལ་བུད་ལྟ་བུ་ཡོད།",
    "ལ་ཉག་ངོ་མར་གཡས་གཡོན་དུ་གངས་ཐོག་རྩེག་གཉིས་ཙམ་རེ་ཡོད་པ་དེའི་དབར་ནས་འགྲོ་དགོས།",
    "ང་ཚོས་ཐུགས་རྗེ་ལེགས་འབུལ་ཞུ་ཐུབ་པ་བྱུང་།",
    "དེའང་ཤར་རྒྱལ་བ་ཙོང་ཁ་བ་ཆེན་པོས་འབྲོག་རི་བོ་དགེ་ལྡན་པར་རྒྱལ་བའི་གླིང་ཕྱག་བཏབ་པ་ནས་མི་ལོ་༣༣ སོང་བའི་ལོ་དེར་ཕྱག་བཏབ་པས་ཆགས་སྔ་ཤོས་ཀྱི་དགོན་གནས་གྲགས་ཆེ་བ་ཞིག་ཡིན་པ་རེད།",
    "སྐམ་ཐོག་གྲུ་ཁ་བཅས་ས་ཚུགས་རེར་ལྷ་ས་ནས་བོད་གཞུང་གིས་སྐམ་ཐོག་གྲུ་ཁ་བར་ཨང་གྲངས་བཀོད་པ་ལྟར་བརྩིས།",
    "དཔལ་སྤུངས་དགོན་དུ་ངའི་ཉེ་འབྲེལ་ཇོ་ཆུང་གི་གྲྭ་ཤག་ཏུ་བསྡད།",
    "ཐོག་མར་གཙུག་ལག་ཁང་གི་རྟེན་གསུམ་མཇལ་སྲོལ་ཡོད་པ་དང་།",
    "དེ་ནས་ཟླ་གསུམ་རིང་རང་མོས་དང་།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་ལྷ་བཅུ་གསུམ་དཀྱིལ་འཁོར་གཏོར་བཟློག་སྔ་རྗེས་ཐེངས་གཉིས་ལ་ཉིན་ལྔ་རེ།",
    "ལོ་དེར་ལོ་ལེགས་ཡག་པོ་བྱུང་བ་རེད།",
    "དེས་དགུན་ཁར་ཞིང་ས་ལ་རླན་གཤེར་བསྡད་ཆེ་བ་འདུག་འབྲོག་ས་ནས་དགུན་ཁར་ནོར་ཕྱུགས་ཀྱི་ལུད་རྣམས་ཞིང་ཁར་དབོར་ཏེ་བསགས་པ་སོགས་བྱས་པས་ལོ་ཏོག་གི་ཐོན་སྐྱེད་བཟང་དུ་གྱུར་ཀྱང་།",
    "ང་ཚོའི་ས་ཞིང་གི་གཡས་གཡོན་དུ་མི་སེར་དཀྱུས་མ་ས་ཞིང་ཆུང་ངུ་ལས་མེད་པ་རྣམས་ལ་ཞིང་ལས་ཡག་པོ་བྱེད་ཐུབ་པས་ལོ་ཐོག་ཡག་པོ་ཡོང་།",
    "ང་ཚོའི་ས་ཞིང་ལ་ག་ཚོད་བྱས་ཀྱང་རྒྱ་ཆེ་བས་དེ་ལྟར་ཡོང་གི་མི་འདུག་ས་ཞིང་མང་པོ་ཞིག་བདག་ཏུ་བཟུང་བས་དཀའ་ངལ་སྣོན་མ་ལྟ་བུ་དང་།",
    "གླ་འབབ་ཀྱི་དོད་དུ་ས་ཞིང་བགོ་བཤའ་བྱས་ན་ཇི་འགབ་མོལ་བསྡུར་བྱས་པར།",
    "ས་ཞིང་བགོ་རྒྱུར་དགའ་མོས་བྱེད་མཁན་མང་།",
    "དེ་ནས་ས་ཞིང་གི་རྒྱ་ཁྱོན་ལས་སུམ་ཆ་གཅིག་ཙམ་ཐག་ཆོད་ཀྱིས་ཕམ་རྒྱལ་མེད་པར་བགོ་བཤའ་བརྒྱབ།",
    "ཕྱི་ལོ་༡༩༥༥ ལོར་ཡང་བསྐྱར་ས་ཞིང་རྒྱ་ཁྱོན་གྱི་ཕྱེད་ཆ་ཙམ་མི་མང་ལ་ཆ་བགོས་བྱས།"
  ]
}