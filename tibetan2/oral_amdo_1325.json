    "ཤཱཀརྨ་སཔདྨ་ག་རེའི་སྒྲ་གཅན་རྟག་ལོངས་སོ།",
    "དེའི་ནོར་དྲུག་གིས་བགོས།",
    "རི་མཁའ་རིའི་ཆ་བརྒྱ་དོན་བདུན་རྣམས་སྒྲ་གཅན་གྱི་ཉིན་ཞག་རེའི་རྟག་ལོངས་སོ།",
    "ཟླ་བ་དག་ལ་མིག་དང་ཉི་མ་བསྲེས་པ་མིག་གིས་རྣམ་བསྒྱུར་ཟླ་བའི་ཚིག་ལ་གཅིག་བསྲེས་ཏེ།",
    "གཉིས་པ་ཉིན་རེའི་སྒྲ་གཅན་ནི།",
    "བསྒྱུར་ཐོབ་ཆུ་སྲང་དྲུག་གིས་ནི།",
    "ཚེས་ཟླ་དག་པ་ལ་རྩིས་འཕྲོ་ཟླ་བ་བརྒྱ་དང་ཉེར་གཉིས་བསྲེས་པ་དེ་ཚེས་ཞག་གི་ཕུང་པོར་བྱ་བའི་ཕྱིར་སུམ་ཅུས་བསྒྱུར།",
    "དཔལ་དུས་ཀྱི་འཁོར་ལོའི་མན་ངག་ལས་ཉིན་རེའི་སྒྲ་གཅན་གསལ་བར་བྱེད་པ་སྟེ་བཞི་པའོ།",
    "བཞི་པ་མཇུག་རིང་གི་རྩིས་ལ་དལ་མྱུར་གཉིས་ལས་དང་པོ་ལ་མཐོང་ནུབ་ཀྱི་དུས་མཚམས་བཟུང་བའི་ཕྱིར།",
    "སྲིན་པོའི་ལོ་ལ་སྲང་གི་ཁྱིམ།",
    "དྲུག་ཅུ་པའི་སྟེང་གི་ཤིང་ཕོ་སྤྲེའུའི་ལོ་ཧོར་ཟླ་དང་པོའི་ཡར་ཚེས་བརྒྱད་ལ་རྗེ་རང་བྱུང་རྡོ་རྗེ་སྐུ་བལྟམས་ནས་ལོ་སོ་གཉིས་པའི་སྟེང་སྲིན་པོ་སྟེ་ཤིང་མོ་ཡོས་ལོ་སྟོན་ཟླ་འབྲིང་པོ་སྲུང་གི་ཁྱིམ་དུ་ཉི་མ་གནས་ཚེ་མཇུག་རིང་སྲོད་ལ་གཟིགས་ལ་སྲང་གི་ཁྱིམ་ཟླ་རྫོགས་པ་དང་ནུབ་སྟེ་དལ་འགྲོས་ཀྱི་མགོ་རྩོམ་པ་དུས་མཚུངས་པས་དེ་མཐོང་ནུབ་ཀྱི་དུས་མཚམས་སུ་ངེས་བཟུང་མཛད་དེ།",
    "དེ་ནས་དོན་གཉིས་རེ་ནུབ་པར་འགྱུར་བ་འབའ་ཞིག་གོ།",
    "འོག་མ་མེས་བསྒྱུར་དྲུག་གིས་བགོ།",
    "སྟེང་དུ་མིག་གིས་བསྒྱུར་ལ་བྱིན།",
    "ལོ་གསུམ་དང་ཕྱོགས་གསུམ་གྱིས་འགྲོས་རེ་རྫོགས་ལ།",
    "ཟླ་བ་སོ་བདུན་ཕྱེད་བཅས་ལ་གཉིས་ཀྱིས་བསྒྱུར་བའི་ཟླ་བ་དོན་ལྔས་མྱུར་འཁྱོག་གི་འགྲོས་རྫོགས་ཤིང་།",
    "སུམ་ཅུ་རྩ་བདུན་ལག་པས་བསྒྱུར་བའི་ཟླ་བ་རྣམས་ཀྱིས་མཇུག་རིང་དག་ནི་མྱུར་དང་འཁྱོག་པོར་འགྱུར།",
    "ཁ་ཅིག་མཇུག་རིང་ལོ་དལ་འབྱུང་གི་འགྲོས་གཉིས་མི་འདོད་པ་ནི་མི་འཐད་དེ།",
    "ས་སྐྱེས་དང་མཇུག་རིང་ནི་ས་སྐྱེས་མཇུག་རིང་སྟེ་འཁྱོག་པོ་ལ་ཞེས་པ་དཀྱིལ་འཁོར་ཕྱེད་ཡོངས་སུ་བཏང་ནས།",
    "དེ་ནས་འཁྱོག་འགྲོས་ལོ་གསུམ་ཕྱོགས་གསུམ་ནུབ་ཏུ་གདོང་ཕྱོགས་པས་རྩོ་མ།",
    "འགྲོས་གཞན་ནི་མེད་པས་དེ་ནས་འཁྱོག་འགྲོས་ཀྱིས་བཟློག་དགོས་པར་འགྱུར་ཞིང་།",
    "འཁྱོག་འགྲོས་ཀྱི་མཐར་ནི་རྒྱབ་ཏུ་མཐོང་བར་གསུངས་ལ།",
    "འགྲོས་རེ་རེ་ནི་ཡུན་ལོ་གསུམ་ཕྱོགས་གསུམ་དུ་ངེས་པའི་ཕྱིར་ཟླ་བ་སོ་བདུན་ཕྱེད་བཅས་ན་ལན་རེ་མཐོང་བར་ཐལ་བའི་སྐྱོན་ཡོད་དོ།",
    "འཁྱོག་འགྲོས་ལ་བུ་ལོན་འཕེལ་བའི་དོད་འབྱུང་འགྲོས་ལ་ནོར་འཕེལ་བས་བསབས་དགོས་པའི་ཕྱིར་མྱུར་འཁྱོག་གི་འགྲོས་ཡོད་ན་དལ་འབྱུང་གི་འགྲོས་ཀྱང་ཡོད་པར་གྲུབ་བོ།",
    "འོན་ཀྱང་དུ་བའི་འགྲོས་བཞི་དང་གཟའ་ལྔའི་མྱུར་རྐང་གི་འགྲོས་བཞི་མིང་མཚུངས་པ་ཙམ་ལས་འགྲོས་དངོས་ནི་མི་མཚུངས་ཏེ།",
    "མཇུག་རིང་གི་འགྲོས་རེ་ལ་ལོ་གསུམ་ཕྱོགས་གསུམ་རེ་ཡོད་པའི་ལོ་གསུམ་པོ་དལ་བར་རྒྱུ་ཞིང་ཕྱོགས་གསུམ་པོ་མྱུར་བར་རྒྱུ་བས་སོ།",
    "དེ་ཡང་ཉི་མ་དང་ལྷན་དུ་གནས་པ་ལས་མྱུར་འགྲོས་ཀྱི་དལ་བར་རྒྱུ་བ་ལོ་གསུམ་པོ་ལ་ཉི་མའི་རྟག་ལོངས་ལས་ཞག་རེ་བཞིན་དུ་ཆུ་སྲང་ཕྱེད་དང་གསུམ་རེ་ལྷག་པར་སྤྱོད་པས་ལོ་གསུམ་བང་ལ་ཉི་མ་ལས་ཤར་དུ་ཆུ་ཚོད་ཞེ་ལྔས་མགྱོགས་པར་སླེབ།",
    "དེ་ནས་དལ་འགྲོས་ལོ་གསུམ་པོ་ལ་ཞག་རེ་བཞིན་ཆུ་སྲང་ཕྱེད་དང་གསུམ་གྱིས་དམན་པ་སྟེ་ཉི་མའི་རྟག་ལོངས་ཉིད་བྲི་གང་མེད་པར་སྤྱོད་པས་ཉི་མ་དང་ལྷན་དུ་གནས།",
    "དེ་ནས་འཁྱོག་འགྲོས་ལོ་གསུམ་པོ་ལ་ནི་ཉི་མའི་རྟག་ལོངས་ལས་ཞག་རེ་བཞིན་ཆུ་སྲང་ཕྱེད་དང་གསུམ་རེས་དམན་པར་སྤྱོད་པས་ལོ་གསུམ་ན་ཉི་མ་ལས་ནུབ་ཏུ་ཆུ་ཚོད་ཞེ་ལྔ་འཕགས་པའི་སར་ལུས།",
    "འཁྱོག་འགྲོས་ཀྱི་ལོ་གསུམ་ལ་བུ་ལོན་ཏེ་དམན་པ་དང་།",
    "ཉི་མ་ཤར་དུ་ཕྱོགས་པས་ལོ་གསུམ་ལ་ཇི་ཙམ་སྤྱད་པ་དེ་ལས་ལོ་རེ་བཞིན་ཆུ་ཚོད་ཞེ་བཞིས་ལྷག་པ་དང་བཅས་པ་མཇུག་རིང་གིས་འཁྱོག་འགྲོས་ལོ་གསུམ་ལ་ཕྱིར་བཟློག་ཏུ་སྤྱོད་པར་ཐལ་བའི་ཕྱིར་ལེགས་པར་བརྟགས་ཏེ་སྨྲས་ན་ལེགས་སོ།",
    "འཁྱོག་འབྱུང་ལ་རྒྱབ་ནས་རིམ་མིན་དུ་ནོར་དང་བུ་ལོན་དུ་འགྱུར་བ་སྟེ།",
    "མཇུག་རིང་ཉི་མ་དག་དང་ལྷན་ཅིག་རྣམ་པར་རྒྱུ་སྟེ་མྱུར་འཁྱོག་དག་ལ་མདུན་དང་རྒྱབ་ནས་སོ།",
    "རང་གི་ཟླ་བ་སུམ་ཅུ་དྲུག་གིས་དེ་རྒྱུ་ཆུ་ཚོད་དག་ཀྱང་འཇིག་རྟེན་གྱིས་ནི་ཚེས་གྲངས་བསྒྱུར།",
    "སྔར་གྱི་ཞག་རེའི་ལོངས་སྤྱོད་སྲུང་གཉིས་དང་དབུགས་གསུམ་པོ་ཕྱོགས་གསུམ་གྱི་ཞག་ཞེ་ལྔས་བསྒྱུར།",
    "འདིར་ནི་ང་དྲུག་རྐང་བཅས་ལ་ཆུ་ཚོད་རེར་བྱེད་དགོས་པས་ང་དྲུག་བཞིས་བསྒྱུར།",
    "སྲང་དྲུག་ཅུ་ལ་ཆུ་ཚོད་དུ་བྱས་པའི་ཆུ་ཚོད་གཅིག་སྲང་ང་གཉིས་དབུགས་གསུམ་སྟེ་མྱུར་བར་རྒྱུ་པ་བབས་བའི་ཕྱོགས་གསུམ་གྱི་ཞག་རེ་བཞིན་སྤྱོད་པ་སྟེ།",
    "ཕྱེད་བཅས་ཟླ་བར་ཆུ་ཚོད་གཉིས་ནི་ཉིན་ཞག་སོ་སོར་འཆར་ཏེ་མྱུར་འཁྱོག་དག་ལ་མདུན་དང་རྒྱབ་ཏུའོ།",
    "ཕྱེད་བཅས་ཟླ་བར་ཆུ་ཚོད་གཉིས་ནི་ཉིན་ཞག་སོ་སོར་འཆར་ཏེ་ལོ་གསུམ་གྱི་མཐར་ཆུ་སྲང་གི་ལོངས་སྤྱོད་རྣམས་ཡོངས་སུ་བཏང་ནས་ཕྱོགས་གསུམ་གྱི་བར་དུ་ཉིན་ཞག་སོ་སོར་ཆུ་ཚོད་གཉིས་ལོངས་སྤྱོད་དེ་མྱུར་བ་ལ་མདུན་དང་འཁྱོག་པོ་ལ་རྒྱབ་ཏུའོ།",
    "མཇུག་རིང་འཆར་བ་ལ་ཡང་ཕྱོགས་གསུམ་གྱི་ཉིན་ཞག་གིས་རྒྱུ་བའི་རྐང་པ་བསྒྱུར་བ་ནི་ཆུ་སྲང་གི་ཚོགས་ཕྱེད་དང་བཅས་པའི་བརྒྱ་བཅུ་གཉིས་སུ་འགྱུར་ཏེ་དེ་ཉིད་མཇུག་རིང་ཤར་བ་ནས་ཉིན་ཞག་སོ་སོ་ལ་འགྱུར་རོ་ཞེས་པ་ནི་བྱ་བར་རིག་པར་བྱའོ།",
    "སྟེང་མ་དྲུག་གིས་བསྒྱུར་བར་བྱ།",
    "རྒྱུད་འགྲེལ་དུ་མྱུར་ལོངས་ང་དྲུག་རྐང་༧༥ན་བཅས་ཀྱི་ཆུ་ཚོད་གཉིས་རེར་གསུངས་པ་ནི་ཉི་མའི་རྟག་ལོངས་ལས་ལྷག་པར་སྤྱོད་པའི་ལྷག་པའི་ཆ་ཡིན་ལ།",
    "ཉི་མའི་ཉིན་ཞག་ངརངསྒྲ་པ་༥ པའམ་རྒྱ་ཟཀ་ཀ་གི་རྟག་ལོངས་ཆུ་ཚོད་བཞི།",
    "དབུགས་གསུམ་བགྲོད་དེ་ཁྱིམ་ཁྱོན་གཅིག་ཏུ་ཆུ་ཚོད་ལྔ་ཙམ་གྱིས་མ་ལོངས་པའི་ཚད་དུ་སླེབ་ལ།",
    "ཁྱིམ་ཁྱོན་གྱི་ས་ནི་ཉི་ཟེར་གྱིས་ཟིལ་གྱིས་ནོན་པས་དེར་དུ་ཡོད་གསལ་བར་མཐོང་མི་མཐོང་ལ་ནི་དཔྱད་པ་འཇུག་པ་འཇུག་པར་སྣང་ངོ།",
    "འོ་ན་སྟེང་མ་དྲུག་གིས་བསྒྱུར་བ་ལ་སོགས་ཀྱི་ཚེ་ཉི་མའི་རྟག་ལོངས་བསྲེས་ཟིན་པས་སླར་ཉི་མ་དག་པའི་ལོངས་སྤྱོད་ལ།",
    "ཕྱི་མ་ནི་ཉི་མ་ལས་རིང་དུ་སོང་བས་ཉི་མའི་རྟག་ལོངས་དོར་རམ་སྙམ་པའི་དོགས་པ་སེལ་བའི་ཕྱིར་རོ།",
    "མྱུར་བའི་ལོངས་སྤྱོད་འདི་ཡང་མྱུར་འགྲོས་ཀྱི་མཐར་རྟག་ལོངས་ལ་ནོར་དུ་འགྱུར་བར་གསུངས་པའི་ཤུགས་ལས་འཁྱོག་འགྲོས་ཀྱི་མཐར་བུ་ལོན་དུ་འགྱུར་བར་གྲུབ་སྟེ་གཞན་དུ་ན་རྟག་ལོངས་མྱུར་ལོངས་དང་བཅས་པ་འཁྱོག་འགྲོས་ཀྱི་མཐའི་ཕྱོགས་གསུམ་ལ་ནུབ་ཏུ་ཕྱིར་ཕྱོགས་པས་སྤྱོད་ན།",
    "དུ་བས་ལྷག་པོ་དང་བཅས་པ་ནུབ་ཏུ་སྤྱད་པས་ཧ་ཅང་བགྲོད་ཐལ་བའི་ཕྱིར་དང་།",
    "འཁྱོག་འགྲོས་ཀྱི་མཐའི་ཕྱོགས་གསུམ་ལ་ནུབ་ཏུ་བུ་ལོན་དང་།",
    "དེ་ནི་ཉི་མའི་ལྷག་པར་འགྱུར་ཏེ་ངེས་པར་དུས་ཀྱིས་བསྒྱུར་བ་ཉི་མའི་ཟླ་བར་ཉིན་ཞག་རེའོ།",
    "སྒྲ་གཅན་ཟླ་བའི་ལོངས་སྤྱོད་མིག་གིས་རྣམ་པར་བསྒྱུར་ཏེ་ཕྱོགས་ཀྱི་ལོངས་སྤྱོད་དག་གིས་བགོས་པ་ལས།",
    "མཇུག་རིང་ཉི་མ་དག་དང་ལྷན་ཅིག་རྣམ་པར་རྒྱུ་སྟེ་མྱུར་འཁྱོག་དག་ལ་མདུན་དང་རྒྱབ་ནས་སོ།",
    "འདིར་སྔར་གྱི་དལ་བའི་བྱ་བ་ལ་ཟླ་བ་ཕྱེད་དང་བཅས་པའི་སུམ་ཅུ་རྩ་དྲུག་གི་ལྷག་མའི་ཟླ་བ་གང་ཞིག་གཟའ་རྣམས་ཀྱིས་མ་སྤྱད་པའི་ཟླ་བ་དེ་ཉིད་ཡོན་ཏན་བརྒྱད་ཀྱིས་བསྒྱུར་ཏེ་དེ་ལས་དྲུག་ཅུའི་ཆས་ཆུ་ཚོད་བརྒྱད་བཟུང་བར་བྱའོ།",
    "ཟླ་བའི་དྲི་དང་རོ་དང་གཟུགས་དང་རེག་དང་སྒྲའི་ཡོན་ཏན་ཏེ་༧༣བ་རྐང་པ་ལྔའོ།",
    "འཇིག་རྟེན་གྱི་གྲགས་པས་སྒྲ་གཅན་གྱི་ལོའི་དཀྱིལ་འཁོར་ལོ་བཅོ་བརྒྱད་པོ་ཞག་སུམ་བརྒྱ་དྲུག་ཅུས་བསྒྱུར་བས་བགོས་པས་སྲང་བཅོ་ལྔ་ཐོབ་སྟེ་ཁྱིམ་ཞག་རེའི་ལོངས་སྤྱོད་དོ།",
    "སྒྲ་གཅན་ཟླ་བའི་ལོངས་སྤྱོད་མིག་གིས་རྣམ་པར་བསྒྱུར།",
    "ཞག་རེའི་ལོངས་སྤྱོད་སྲང་བཅོ་ལྔ་པོ་ཕྱོགས་གཅིག་གི་ཞག་བཅོ་ལྔས་བསྒྱུར་ཏེ་སུང་གི་འཁོར་ལོ་དྲིལ་བས་ཆུ་ཚོད་གསུམ་སྲང་ཞེ་ལྔ་ཡོད་ཀྱང་གནས་གཅིག་ཏུ་བསྡུ་ཕྱིར་སྲང་དུ་བསྒྱུར་བའི་ཉིས་བརྒྱ་དང་ཉེར་ལྔ་ནི་བགོད་བྱེད་དེ།",
    "ཕྱོགས་ཀྱི་ལོངས་སྤྱོད་དག་གིས་བགོས་པ་ལས།",
    "བཞི་པོ་ནི་མཇུག་རིང་དལ་བར་རྒྱུ་བའི་ཞག་གཅིག་གི་ཆུ་ཚོད་དེ།",
    "དེའི་ལོངས་སྤྱོད་རྟོགས་ཕྱིར་སྒྲ་གཅན་གྱི་ཟླ་རེའི་ལོངས་སྤྱོད་ཆུ་ཚོད་བདུན་དང་སྲང་སུམ་ཅུ་ལས་ཆུ་སྲང་བདུན་དང་དབུགས་གསུམ་ཕྲོགས་ཏེ་སོ་སོར་གསུམ་གྱིས་བསྒྱུར།",
    "དེ་ལ་ཉི་མའི་བྱེད་རྩིས་ཀྱི་རྟག་ལོངས་ཆུ་ཚོད་བཞི་དང་སྲང་ཉི་ཤུ་སྦྱངས་ཤུལ་ཆུ་སྲང་གཉིས་དང་དབུགས་གསུམ་ནི་ཉི་མ་ལས་ལྷག་པར་སྤྱོད་པའི་ཆ་སྟེ་མྱུར་འགྲོས་ལ་ཉི་མའི་མདུན་ནས་ནོར་དུ་འགྱུར་ཞིང་འཁྱོག་འགྲོས་ལ་ཉི་མའི་རྒྱབ་ནས་བུ་ལོན་དུ་བྱེད་པ་སྟེ།",
    "མཇུག་རིང་ཉི་མ་དག་དང་ལྷན་ཅིག་རྣམ་པར་རྒྱུ་སྟེ་མྱུར་འཁྱོག་དག་ལ་མདུན་དང་རྒྱབ་༩༤བ་ནས་སོ།",
    "དབུགས་སྲང་གི་འཁོར་ལོ་དྲིལ་བའི་ཆུ་ཚོད་ཞེ་ལྔ་པོ་ནི་མཇུག་རིང་གི་འདས་པའམ་བུལ་བའི་ལོངས་སྤྱོད་ཡིན་ལ།",
    "བྱང་གི་ཕྱོགས་སུ་འགྲོ་བར་བྱེད།",
    "རང་གི་ཞིང་ལ་འཇུག་པའི་ཕྱིར།",
    "དེ་ནས་དལ་འགྲོས་ཀྱི་དལ་བ་ལོ་གསུམ་དང་འཁྱོག་འགྲོས་ན་ཀྱི་དལ་བ་ལོ་གསུམ་གྱི་མཐར་ཕྱོགས་གསུམ་ལ་བྱང་བགྲོད་ཀྱི་ཚེ་ཉི་མའི་ནུབ་ཏུ་ཐོ་རངས་སྣང་ཞིང་སླར་འབྱུང་འགྲོས་ཀྱི་ཐོག་མའི་ཕྱོགས་གསུམ་ལ་ཞིང་ལ་འཇུག་པས།",
    "རང་གི་ཞིང་ལ་འཇུག་པའི་ཕྱིར།",
    "སྟེང་མ་དྲུག་གིས་བསྒྱུར་བར་བྱ།",
    "འོག་ཏུ་མེས་བསྒྱུར་དྲུག་གིས་བགོ།",
    "དེ་ནི་ཉིན་རེའི་ལོངས་སྤྱོད་ཡིན།",
    "མྱུར་བར་ཐོན་པའི་ཚེ་ཐོན་པའི་ཞག་དུ་སོང་གནས་གསུམ་དུ་བུ་སྟེ་ཆུ་ཚོད་དང་ཆུ་སྲང་དང་དབུགས་ཀྱི་དོན་ནོ།",
    "སྟེང་མ་དྲུག་དང་བོར་མ་བཅོ་བརྒྱད་དང་འོག་མ་གསུམ་གྱིས་བསྒྱུར་ཏེ་ཉི་མའི་ཉིན་ཞག་གི་རྟག་ལོངས་ལ་མྱུར་བའི་ལོངས་སྤྱོད་ལྷག་པོའི་ཆ་ཆུ་ཚོད་གཅིག་སྲང་ང་གཉིས་དབུགས་གསུམ་བསྲེས་པ་ཞག་རེ་བཞིན་ཤར་དུ་ནོར་དང་ནུབ་ཏུ་བུ་ལོན་དུ་འགྱུར་བས་སོ།",
    "དབུགས་སྲུང་ཆུ་ཚོད་ཀྱི་འཁོར་ལོ་དྲིལ་ཏེ་ཉི་རྐང་དག་པར་བྱ་ཕྱིར་ཚེས་དེའི་ཉི་དག་ལ་རིམ་པའི་ཚེ་བྱིན་ཞིང་རིམ་མིན་གྱི་ཚེ་དོར་བའི་ལྷག་གིས་མཇུག་རིང་རྒྱུ་སྐར་གང་ལ་གནས་པ་སོགས་ཤེས་སོ།",
    "མྱུར་བའི་སྒྱུར་བྱེད་ནི་མྱུར་བར་རྒྱུ་བའི་ཚོའི་ཉིན་རེའི་ལོངས་སྤྱོད་ཡིན་ལ།",
    "དལ་བའི་སྒྱུར་བྱེད་ཉི་མའི་རྟག་ལོངས་དང་བཅས་པ་ནི་དལ་བར་རྒྱུ་བའི་ཚེ་ཉིན་རེ་བཞིན་གྱི་ལོངས་སྤྱོད་དོ།",
    "དེ་ཡང་སྲིན་པོའི་ལོ་ཧོར་ཟླ་བཅུ་པ་ནས་ད་ལྟའི་མེ་སྤྲེལ་ཧོར་ཟླ་བརྒྱད་པའི་བར་ལ་ལོ་ཉིས་བརྒྱ་ཉེར་གཅིག་གིས་ཚེས་ཟླ་ཉིས་སྟོང་བདུན་བརྒྱ་ཞེ་གཅིག་དང་།",
    "དལ་འགྲོས་ཀྱི་དལ་བར་རྒྱུ་བ་ལས་ཟླ་བ་གཉིས་དང་ཞག་ཉེར་ལྔ་ཐལ་བ་ཡིན་ནོ།",
    "དུས་མཚམས་འདི་དག་ཏུ་ཡང་རེས་འགའི་མི་མཐོང་བ་སྲིད་ལ།",
    "མཇུག་རིང་གི་སྐབས་རྫོགས་སོ།",
    "ཆུ་སྲང་དྲུག་གིས་བསྒྱུར་ཐོབ་དབུགས།",
    "རི་ཟླ་མེའི་ཆ་བཅུ་བདུན་ཡོད་པས་ལོ་དག་ལ་དེ་བསྲེས་ནས་བགོད་བསྒྱུར་བྱེད་རིགས་ཀྱང་བྱ་སླ་བའི་ཕྱིར་ལོ་བདག་གི་རྩིས་འཕྲོ་རྫོགས་མཚམས་དང་བསྟུན་ཏེ།",
    "དེ་ཡང་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་གྲུབ་རྩིས་ལས་བྱུང་བ་ལས་ཀྱང་ཅུང་ཞིབ་པར་བརྩིས་ན་ཉིན་ཞག་སུམ་བརྒྱ་རེ་ལྔ་ཆུ་ཚོད་བཅོ་ལྔ།",
    "དབུགས་གཅིག་གི་རི་ཟླ་ཡོན་ཏན་གྱི་ཆ་བརྒྱ་ཉེར་གཅིག་ཡོད་པར་གྲགས་ལ།",
    "དེས་ན་ལོ་སུམ་བརྒྱ་དང་བཅུ་བདུན་ན་ལོ་བདག་གི་དཀྱིལ་འཁོར་རྫོགས་ཏེ་གཟའ་གནས་སུ་སུམ་བརྒྱ་གོ་དགུར་ལོངས།",
    "རི་ཟླ་མེའི་ཆ་བརྒྱ་ཉེར་གཅིག་གིས་བསྒྱུར་ཏེ་སོ་སོར་འཁོར་ལོ་དྲིལ།",
    "རྩིས་འཕྲོ་སྟེང་འོག་མིག་དང་སུམ་ཅུ་བསྲེས་ནས་གཟའ་གནས་བདུན་གྱིས་བགོས་ན་དག་པར་འགྱུར་མོད་ཀྱི་གནས་ཉུང་ངུར་བསྡུས་ན་རི་མོ་བྱེད་བདེ་བའི་ཕྱིར་ལོའི་གཟའ་ལོངས་སྤྱོད་དང་བཅས་པ་རྣམས་སུམ་བརྒྱ་བཅུ་བདུན་གྱིས་བསྒྱུར་ཏེ་འཁོར་ལོ་རྣམས་དྲིལ་བས་གཟའ་སས་བརྨ་སྶ་ཀ་ཀ་སྨ་༣ གནས་སུ་སུམ་༧༧ན་བརྒྱ་གོ་དགུ་ཡོད།",
    "དེས་ན་རི་ཟླ་མེ་ནི་ལོ་དག་གི་དཀྱིལ་འཁོར་རོ།",
    "ཞིབ་མོར་ན་དཀྱིལ་འཁོར་ཆའི་བར་དུ་བྱའོ།",
    "དེ་ནི་ལུག་གི་འཕོ་མཚམས་སོ།",
    "བུ་མོར་རིག་བྱེད་ཟུང་མིག་བྱིན།",
    "གཟའ་གནས་ནས་བདུན་གྱིས་བགོས་པའི་ལྷག་ནི་སོ་སོའི་རི་མོ་སྟེ།",
    "དེ་བཞིན་དུ་རྟག་ལོངས་རེ་སྣོན་པ་དང་འཁོར་ལོ་དྲིལ་བ་ནི་རིགས་འགྲེ་ལ།",
    "ཆུ་ཚོད་རེ་ལྔ་བྱིན་པས་གཟའ་བཞི་ཆུ་ཚོད་ཉེར་བཞི་ནི་བུ་མོའི་འོ།",
    "ཆུ་ཚོད་སུམ་ཅུ་བྱིན་པས་གཟའ་དྲུག་ཆུ་ཚོད་ང་གཅིག་ནི་སྲང་གིའོ།",
    "སེང་གེར་མིག་བུག་བུ་མོར་ནི།",
    "བུག་མིག་གཟའ་དང་རི་འབྱུང་གི།",
    "གཅིག་དང་ང་བདུན་བྱིན་པས་ཉི་མ་ཉ་སྤངས་ནས་ལུག་གིས་ཁྱིམ་དུ་འགྲོ་བར་འགྱུར་རོ།",
    "འོག་གི་ཆུ་ཚོད་སྟེང་དུ་གཞུག།",
    "ཉི་དག་གི་སྐར་མ་ཆུ་ཚོད་དུ་བསྒྱུར་ཞིང་འོག་གི་ཆུ་ཚོད་དང་བསྡོམས་པའི་ཆུ་ཚོད་ཀྱི་ཕུང་པོ་ནི་བགོ་གཞི་སྟེ་རྩིས་རྒྱུན་རྟོགས་པའི་ཕྱིར་རོ།",
    "ཁྱིམ་༧༩བ་ཁྱོན་ནི་བགོད་བྱེད་དེ་བགྲོད་བྱའི་ཡུལ་ཡིན་པས་སོ།",
    "འདིར་ཆུ་ཚོད་ལ་ཁྱིམ་ཁྱོན་གྱིས་བགོས་ནོར་འདས་པའི་ཁྱིམ་ཟླར་གྱུར་པ་བཞིན་དུ།",
    "ཆུ་ཚོད་ཀྱི་ཕྱེད་ཆའི་ཕུང་པོ་ལ་ཁྱིམ་ཁྱོན་གྱིས་ཐོབ་ནོར་ནི་ད་ལྟའི་ཁྱིམ་དེ་ལས་ཞག་ཇི་ཙམ་སྤྱད་ཟིན་པའི་གྲངས་སོ།",
    "ལྷག་མ་ཆུ་ཚོད་དང་ཆུང་སྲང་དང་དབུགས་སུ་བྱས་ཏེ་ཁྱིམ་ཁྱོན་གྱིས་ཐོབ་ནོར་ནི་ད་ལྟའི་ཁྱིམ་ཞག་དེ་ལས་ཇི་ཙམ་སྤྱད་ཟིན་ཤར་བའོ།",
    "སྤྱིར་ཉིན་ཞག་རེའི་དང་པོ་སྐྱ་རེངས་ནས་འཛིན་པར་གསུངས་ཀྱང་།",
    "ཤར་རིའི་རྩེར་ཁྱིམ་གང་གི་རྐང་པ་གཅིག་ཤར་བ་ན།",
    "བྱང་བགྲོད་མཐར་ཐུག་ནས་དགུན་ཉི་མ་ལོག་གི་བར་ཟླ་བ་དྲུག་པོའི་ཟླ་བ་རེ་ལ་གྲིབ་མ་ཆ་རེ་དང་ཆ་གཅིག་གི་དྲུག་ཆ་རེ་འཕེལ་ཏེ་དགུན་ཉི་བཟློག་ཚེ་ཐུར་གྲིབ་མཉམ།",
    "དགུན་ཉི་ལོག་ནས་དབྱར་ཉི་མ་ལོག་གི་བར་ཟླ་བ་དྲུག་པོའི་ཉིན་གུང་ལ་གྲིབ་མ་ཆ་རེ་དང་ཆ་རེའི་དྲུག་ཆ་རེ་ཟླ་རེ་ལ་འགྲིབ་པས་དབྱར་ཉི་བཟློག་ཚེ་གྲིབ་མ་རང་ལ་ཐིམ་པར་འགྱུར་དགོས་པའི་ཕྱིར་རོ།",
    "ལྷོ་བགྲོད་ལ་མཚན་མོ་རིང་ཞིང་།",
