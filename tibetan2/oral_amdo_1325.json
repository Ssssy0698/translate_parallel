    "༦ན་ཞིབ་མོར་ན་ཅུང་མ་ལོངས་པར་མངོན་ཏེ།",
    "གཞན་དུ་ན་ཁྱིམ་ཞིག་དང་ཉིན་ཞག་ཡུན་མཉམ་པས་དཀྱིལ་འཁོར་མཚུངས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་ཁྱིམ་ཞག་ནི་ཞག་གི་རྩ་བ་ཡིན་ལ།",
    "དེ་ལ་ཉིན་ཞག་རེ་བཞི་དང་ཉིན་ཞག་གཅིག་གི་རི་མཁའ་རིའི་ཆ་རེའི་བུ་ལོན་སྦྱངས་པས་ཉིན་ཞག་ཏུ་འགྱུར་རོ།",
    "དེས་ནས་དང་པོར་ཁྱིམ་ཞག་གི་དཀྱིལ་འཁོར་ནི།",
    "ཁྱིམ་ཞག་གི་དཀྱིལ་འཁོར་དེ་ཁྱིམ་ཞག་རེ་ལ་ཆུ་ཚོད་དྲུག་ཅུ་རེ་ཡོད་ལ་དེས་རྒྱུ་སྐར་གྱི་ཆུ་ཚོད་སྟོང་དྲུག་བརྒྱ་ཉི་ཤུ་ལ་བགོས་པས་ཐོབ་ནོར་གྱི་གྲངས་རྒྱུ་སྐར་ཉེར་བདུན་དུ་ལོངས་པའི་ཕྱིར་རོ།",
    "ཚེས་ཞག་གི་དཀྱིལ་འཁོར་ནི།",
    "སྟེང་གི་ཕུང་པོར་བྱིན་བསྣན་ཏེ།",
    "ཡང་ནི་ལྷག་མ་དྲུག་གིས་བསྒྱུར།",
    "ཐོབ་ནོར་བཅུ་གཅིག་ནི་སྟེང་གི་ཕུང་པོར་བྱིན་ཞིང་བསྣན་ཏེ་ཁྱིམ་ཞག་སུམ་བརྒྱ་དྲུག་ཅུ་པོ་ལ་ཟླ་ཤོལ་གྱི་རྒྱུར་འགྱུར་བའི་ཚེས་ཞིག་རིལ་པོ་བཅུ་གཅིག་རེ་ལྷག་པ་བསྣན་པས་ཚེས་ཞག་གི་ཕུང་པོར་གྱུར་པ་སྟེ་ཚེས་ཞག་སུམ་བརྒྱ་བདུན་ཅུ་རྩ་གཅིག་ཡོད་དོ།",
    "འོག་གི་ལྷག་མ་ལྔ་ནི་ཞག་དུ་མ་ལོངས་པའི་ཆ་སྟེ།",
    "སླར་ཡང་དྲུག་ཅུ་རྩ་ལྔའི་ཆས་བགོས་ཐོབ་བཞི་ནི་ཚེས་ཞག་གི་གནས་དེ་ནས་འོག་ཏུ་བཞག་སྟེ་ཆུ་ཚོད་དོ།",
    "ལྷག་མ་བཞི་བཅུ་ཡང་ནི་ཆུང་སྲང་གི་དོན་དུ་དྲུག་ཅུས་བསྒྱུར་ཏེ་བགོད་སྐུཨུ།",
    "ཡང་ནི་ལྷག་མ་དྲུག་ཅུ་པོ་དབུགས་ཀྱི་དོན་དུ་དྲུག་གིས་བསྒྱུར་ཏེ་དྲུག་ཅུ་རྩ་ལྔའི་ཆས་བགོས་པས་ལྔ་ཐོབ་པ་དེ་ཡང་ཆུ་སྲང་གི་འོག་ཏུ་བཞག་པ་དབུགས་སོ།",
    "ལྷག་མ་སུམ་ཅུ་སོ་ལྔ་ལུས་པ་བཅུ་གསུམ་གྱིས་བསྒྱུར་ཏེ་མདའ་རོས་བགོས་པས་བདུན་ཐོབ་པ་ནི་དབུགས་ཀྱི་ལྷག་མའམ་ཡན་ལག་གི་ཚོགས་ཏེ་དབུགས་ཀྱི་འོག་ཏུ་བཞག་གོ།",
    "ཉིན་ཞག་གི་དཀྱིལ་འཁོར་ནི།",
    "སྟེང་གི་ཕུང་པོར་དབྲི་བར་བྱ།",
    "དེ་ལས་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་དུ་བྱ་བའི་ཕྱིར་དང་པོར་རྗེས་འབྲེང་རྣམས་གནས་གཅིག་ཏུ་སྡུད་དགོས་པས།",
    "ཚེས་ཞག་སུམ་བརྒྱ་དོན་གཅིག་པོ་ཆུ་ཚོད་དྲུག་ཅུས་བསྒྱུར་བ་ལ་འོག་གི་ཆུ་ཚོད་བཞི་པོ་བཅུག་པས།",
    "དེ་ཆུ་སྲང་དུ་བསྒྱུར་བ་ལ་འོག་གི་སྲང་བཅུག་པས།",
    "དེས་ནི་སྟེང་གི་ཕུང་པོར་དབྲི་བར་བྱ་སྟེ་ཁྲི་ལྷག།",
    "དེ་སྲང་གིས་དྲིལ་བས།",
    "དེ་ཆུ་ཚོད་ཀྱི་འཁོར་ལོས་དྲིལ་བས་སུམབརྒྱ་རེ་ལྔ་ཐོབ་ནས་ལྷག་མ་བཅུ་དྲུག་ལུས་ཏེ།",
    "དྲུག་བརྒྱ་དོན་བཞི་ཉིན་ཞག་གི།",
    "དབྱུག་གུ་བཅུ་དྲུག་དང་ནི་ཆུ་སྲང་བཅུ་བཞི་དབུགས་གཅིག་ཡན་ལག་དང་བཅས་པ་ནི་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་རོ།",
    "ཞག་གསུམ་པོ་ཐུན་མོང་གི་དོན་བསྡུ་ཕྱིར།",
    "དཀྱིལ་འཁོར་སོ་སོ་འདིས་ནི་རྒྱུ་སྐར་གྱི་འཁོར་ལོ་ལ་བགོས་པས་ཐོབ་ནོར་ནི་ཞག་སོ་སོའི་ཞག་རེའི་རྟག་པའི་ལོངས་སྤྱོད་དེ།",
    "ཞག་རེའི་ལོངས་སྤྱོད་རྟོགས་པའི་ཕྱིར་གང་ཞིག་ཉིན་ཞག་གཅིག་པོ་ནི་སྐར་མ་ཉེར་བདུན་གྱིས་བསྒྱུར་ཏེ།",
    "ཐོབ་པའི་དབྱུག་གུ་ཉིན་རེ་རེ།",
    "དྲུག་གིས་བསྒྱུར་༩༡ན་བས་དབུགས་སུ་འགྱུར།",
    "ཡུལ་གྱི་ཆུ་ཚོད་མཁའ་སྟོང་བུག་རོ་ལ་མཁའ་མིག་རྒྱལ་པོ་ལ་ཞག་གསུམ་པོ་སོ་སོའི་ཉི་མའི་དཀྱིལ་འཁོར་ལོངས་སྤྱོད་དང་བཅས་པ་རྣམས་ཀྱིས་བགོས་པས་ཐོབ་པའི་དབྱུག་གུ་ནི་ཞག་སོ་སོའི་ཉིན་རེ་རེ་བཞིན་ཡུལ་སྟེང་དུ་ཆུ་ཚོད་ཇི་ཙམ་ཆོད་པའི་གྲངས་ཡིན་ལ།",
    "ལྷག་མ་དྲུག་གིས་བསྒྱུར་བ་ལ་དཀྱིལ་འཁོར་གྱིས་ཐོབ་པ་དབུགས་སུ་འགྱུར་ལ།",
    "དེ་ནས་ཡུལ་གྱི་ཆུ་ཚོད་ལ་ཁྱིམ་ཞག་གི་དཀྱིལ་འཁོར་མཁའ་དུས་མེས་བགོས་པས་ཐོབ་པ།",
    "ཁྱིམ་ཞག་རེ་ཡི་རྟག་ལོངས་ཡིན།",
    "ཉིན་ཞག་གི་དཀྱིལ་འཁོར་ལ་གནས་ཉུང་དུས་བྱ་སླ་བའི་ཕྱིར་འདོད་ཆ་མན་བོར།",
    "དབུགས་སུ་གཅིག་གིས་བརྒྱན་པ་ཡིན།",
    "བགྲོད་པའི་དང་པོ་ཉིན་རེ་བཞིན།",
    "ཉི་མའི་ཞག་སོ་སོའི་ལོངས་སྤྱོད་འདི་ཡིས་ནི་རང་རང་གི་ངེས་པ་བསྒྲུབ་པར་བྱ་འཆ་ཚ་རྨཀཱཞིང་།",
    "ངེས་པ་དེ་ལས་ཉི་སྐར་ལ་སོགས་པ་རྟོགས་པར་བྱ་བའི་དོན་དུ་རང་རང་གི་རྟག་ལོངས་འདི་དག་དབྱུག་གུ་དང་ཆུ་སྲུང་ལ་སོགས་པ་རྣམས་སུ་ཉིན་རེ་རེ་ཞིང་སྦྱར་ཞིང་བསྣན་ནས་ཐོབ་ནོར་ཉི་སྐར་གྱི་གནས་སུ་གཞུག་པར་བྱའོ།",
    "བགྲོད་པའི་དང་པོ་ལྷོར་བགྲོད་པ་རྐང་པ་རིམ་པར་སྤྱོད་པ་དང་པོ་ནས་༩༥༣བརྩམས་ཏེ་ཉིན་རེ་རེ་བཞིན་ཡང་སླར་ཡང་བྱང་དུ་བགྲོད་པར་འགྱུར་བ་རིམ་མིན་གྱི་དང་པོའི་ཆར་ཐུག་གི་བར་དུ་སྔར་གསུངས་པའི་ཉི་མའི་རྐང་པའི་ལས་རྣམས་ཆོ་ག་མ་འཁྲུགས་པ་ཡིས་ཉི་མའི་རྐང་པ་བུ་ལོན་དུ་སྦྱང་བར་བྱ་ཞིང་།",
    "ཟླ་བ་དང་མཇུག་རིང་གི་ཡང་ངེས་པ་མི་གསལ་བར་འགྱུར་བ་འདི་ནི་རྩ་བ་ཉམས་པའི་ལྗོན་ཤིང་བཞིན་ནོ།",
    "ཟླ་བའི་ལོངས་སྤྱོད་ཉིན་རེ་ལའོ།",
    "ཚེས་ཟླ་གཅིག་གི་རྟག་ལོངས་ཡིན།",
    "རི་མོ་དེ་ནི་ཟླ་བའི་ལོངས་སྤྱོད་དེ་ཉིན་རེ་རེ་བཞིན་ལ་ཟླ་བས་ཡུལ་སྟེང་དུ་ཇི་ཙམ་བགྲོད་པའི་ཆའོ།",
    "ཡང་ཡུལ་གྱི་ཆུ་ཚོད་ལ་སུམ་ཅུས་བགོས་པས་ཆུ་ཚོད་ང་བཞི་ཐོབ་ལ་དེ་དང་༩༤ན་ཉི་མའི་ཚེས་ཞག་གི་རྟག་ལོངས་བསྲེས་ཀྱང་རི་མོ་སྔར་བཞིན་བུགས་བའཆར་རོ།",
    "གང་གིས་ཟོས་པ་ཟླ་ཉི་མའོ།",
    "རྒྱུ་སྐར་གྱི་དབྱུག་གུའི་འཁོར་ལོ་ལས་དབྱུག་གུའི་ཐ་མའི་མཐར་ཐུག་པར་ཟླ་བའི་རང་འགྲོས་གང་གིས་ཇི་ཙམ་གྱིས་ཟོས་པའི་ཉིན་ཞག་ཉེར་བདུན་ནི་ཟླ་བའི་ཉི་མའམ་ཞག་གི་དཀྱིལ་འཁོར་ཡིན་ལ།",
    "ཞག་གི་ཆུ་ཚོད་དྲུག་ཅུ་ཡང་།",
    "ཚེས་ཞག་རེ་ལ་ཆུ་ཚོད་དྲུག་ཅུར་བྱས་པའི་འདོད་ཆ་གཅིག་གི་བར་ཁྱད་དེ།",
    "༦༣ཟླ་བས་ཡུལ་གྱི་འདོད་ཆ་གཅིག་སྤྱོད་པའི་རིང་ལ་ཞག་གི་འདོད་ཆ་གཅིག་དང་།",
    "འདོད་ཆ་གཅིག་གི་མིག་བདུན་མཁའ་རི་ཟླ་བའི་ཆ་བཞི་བརྒྱ་དོན་བརྒྱད་སྦྱོང་པའི་དོན་ནོ།",
    "མཁའ་མཁའ་ཆུ་འདོད་མིག་གིས་བསྒྱུར།",
    "མཁའ་མཁའ་མཚོ་འདོད་མིག་གིས་བསྒྱུར།",
    "ཐོབ་ནོར་ཟླ་བའི་ཚེས་ཞག་གི།",
    "འབད་པས་གྲུབ་པའི་རི་མོ་ཡིན།",
    "ཉིན་ཞག་དང་ཚེས་ཞག་གི་བར་ཁྱད་སྦྱངས་པས་ཤེས་ཏེ།",
    "ཉིན་ཞག་དྲུག་ཅུ་རྩ་བཞི་དང་ཉིན་ཞག་གི་རི་མཁའ་རིའི་ཆ་རེ་སོང་བ་ན་ཚེས་ཞག་དྲུག་ཅུ་རྩ་ལྔར་འགྱུར་བས་བསྒྱུར་བགོད་འདི་ལྟ་སྟེ།",
    "འོག་གི་ཆ་ཤས་གནས་གཉིས་སྦྱང་།",
    "ཚེས་རེའི་རྟག་ལོངས་རྣམ་པར་དག།",
    "ལོངས་སྤྱོད་བཙལ་ཚུལ་ནི་གཟའ་རྣམས་ཐུན་མོང་དུ་བསྟན་པར་བྱའོ།",
    "ཐུན་མོང་དུ་ལོངས་སྤྱོད་བཙལ་ཚུལ་གཉིས་ཀྱི་དང་པོ་ནི།",
    "མྱུར་ནང་གི་དཀྱིལ་འཁོར་དང་མྱུར་རྐང་གི་རྐང་འཛིན་རྟག་ལོངས་ཙམ་རེ་འདིར་འཆད་དོ།",
    "མྱུར་རྐང་གི་རྐང་དཀྱིལ་དང་རྐང་འཛིན་མི་འཆད་དེ།",
    "ཉིན་མའི་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་ཉིད་དྲག་གཟའི་མྱུར་རྐང་གི་རྐང་དཀྱིལ་ཡིན་པའི་ཕྱིར་དང་།",
    "མྱུར་རྐང་གི་རྐང་འཛིན་ཡང་ཉིན་རྩིས་ཀྱི་ཉི་བར་དལ་དག་གིས་དམན་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེས་ན་ཞི་གཟའི་མྱུར་རྐང་གི་དཀྱིལ་འཁོར་ནི།",
    "དྲག་གཟའ་གསུམ་གྱི་དལ་རྐང་གི་དཀྱིལ་འཁོར་ནི།",
    "ཉིན་ཞག་རེ་རེ་ཞིང་ལོངས་སྤྱོད་པའི་ཆ་རྟོགས་པའི་ཕྱིར་དང་པོར་བསྒྱུར་བྱ་ཉིན་ཞག་གཅིག་ལ་སྒྱུར་བྱེད་སྐར་མ་ཉེར་བདུན་གྱིས་བསྒྱུར་ཏེ་ལོངས་སྤྱོད་བྱའི་ཡུལ་སྐར་མ་ཉེར་བདུན་དུ་ངེས་པས་སོ།",
    "འོན་ཀྱང་ཐོབ་པ་ནི་མ་ཡིན་ཏེ་གཟའ་ལྔ་སྒྲ་གཅན་དང་བཅས་པ་སུས་ཀྱང་ཞག་རེ་ལ་སྐར་ཁོངས་རེ་བགྲོད་མི་ནུས་པའི་ཕྱིར་རོ།",
    "བགོས་པའི་ལྷག་མའམ་མ་ཐོབ་ན་བགོ་བྱ་དེ་ཉིད་ཆུ་ཚོད་ཀྱི་དོན་དུ་དྲུག་ཅུས་བསྒྱུར་ནས་ཡང་དཀྱིལ་འཁོར་གྱིས་ཐོབ་པ་ནི་དབྱུག་གུའམ་ཆུ་ཚོད་དེ་གཟའ་རང་རང་གིས་ཞག་རེ་ལ་ཡུལ་སྟེང་དུ་རང་འགྲོས་ཀྱིས་ཆུ་ཚོད་ཇི་ཙམ་སྤྱད་པའི་གྲངས་ཡིན་ལ།",
    "ལྷག་སངས་ཀྱིས་ནི་མྱུར་རྐང་གིས་ཇི་ཙམ་སྤྱད་པའི་ལོངས་སྤྱོད་ཀྱི་ཆུ་ཚོད་དོ།",
    "དེ་བཞིན་དུ་སླར་ཡང་ལྷག་མ་དྲུག་གིས་བསྒྱུར་ནས་དཀྱིལ་འཁོར་ཆས་ཐོབ་པ་དབུགས་དང་།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་གྱི་ཆ་ཡིས་ནི་རྣམ་པར་ཕྱེ་བས་ཐོབ་པ་དེ་རྣམས་གཟའ་གཞན་གྱི་ཞག་རེའི་རྟག་ལོངས་དང་།",
    "ལྷག་སངས་ཀྱི་ཞག་རེའི་སྒྱུར་རྐང་གི་ལོངས་སྤྱོད་ཀྱི་རི་མོའོ།",
    "རི་དང་རྒྱལ་བ་མིག་གིས་བགོ།",
    "དབུགས་སུ་རྩེ་མོ་འདོད་ཆ་ལྔ།",
    "གལ་ཏེ་སྒྲ་གཅན་གྱི་ཚེས་ལོངས་ལས་ཉིན་ཞག་གི་ལོངས་སྤྱོད་དུ་སྒྲུབ་པར་འདོད་ཀྱང་སྒྲ་ག་ཅན་གྱི་ཚེས་ཞག་ལས་ཉིན་ཞག་ཏུ་བྱས་པས་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་གྲུབ།",
    "དེ་གནས་གཅིག་ཏུ་བསྡུས་ཏེ་ཡུལ་གྱི་ཆུ་ཚོད་ལ་བགོས་པས་ཐོབ་པ་ཉིན་ཞག་གི་རྟག་ལོངས་ཏེ།",
    "དེ་ལ་ཀླུ་ལག་སྦྲུལ་མིག་གིས།"
  ]
}