    "རྟག་ལོངས་ཀྱི་སྟེང་དུ་རྐང་པ་གང་ལ་གནས་པས་དབྲི་བསྣན་དུ་འགྱུར་ཚུལ་ཁོ་ནས་ཆོག་པའི་ཕྱིར་རྐང་པ་རེ་རེ་བ་ཡིན་ཞིང་།",
    "རི་མོ་དེས་ནི་དལ་བའི་ལོངས་སྤྱོད་གནས་གཅིག་ལ་རིམ་པ་ལ་དོར་ཞིང་རིམ་མིན་གྱི་ཚེ་བྱིན་ཏེ་སྔར་བསྟན་པའི་འཕེལ་འགྲིབ་ཀྱི་ཕྱིར་རོ།",
    "མྱུར་ནང་གི་ཆ་ལས་གཞན་དག་ཟིན་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་མྱུར་རྐང་གི་རྩིས་ལ་རྐང་འཛིན་བཙལ་བ་ནི།",
    "དལ་དག་གནས་གཉིས་གཅིག་གིས་ནི།",
    "གནས་གཞན་ཞིག་གིས་དེས་ནི་ཚེས་ཀྱི་ཉི་དག་ལ་སྦྱོང་སྟེ་རང་གི་དལ་དག་གིས་དམན་པའི་ཉིན་ཞག་གི་ཉི་བར་ནི་དྲག་གཟའ་གསུམ་སོ་སོའི་མྱུར་རྐང་གི་ལོངས་སྤྱོད་ཡིན་པའི་ཕྱིར་རོ།",
    "སྦྱངས་ལྷག་གི་སྐར་གནས་ནི་རྐང་འཛིན་དངོས་སོ།",
    "ཅུང་ཞིབ་པར་ན་ཉི་གླུ་ལ་ཉི་མའི་ཉིན་ཞག་གི་རྟགས་ལོངས་ཆུ་ཚོད་བཞི་སྲང་ཉེར་དྲུག་འདོད་ཆ་བརྒྱད་རྣམས་ཚེས་བསྒྱུར་བྱིན་པའི་ཉི་བར་ལ་བྱེད་རིགས་སོ།",
    "ཚེས་རྒྱུ་ལ་ཉིན་ཞག་གི་རྟག་ལོངས་བྱིན་པར་ཟད་ཀྱི།",
    "སྤྱི་སྨས་སྦྱངས་ལྷག་ནི་མྱུར་རྐང་གི་ལོངས་སྤྱོད་དག་པ་སྟེ།",
    "དེའི་སྐར་མ་རེར་ལོངས་པ་ན་མྱུར་རྐང་གི་རྐང་པ་རེ་འཕོ་ལ།",
    "གཞན་དུ་ན་རིམ་རིམ་མིན་དུ་ཆུ་ཚོད་སུམ་ཅུ་རེ་ལྷག་ཆད་དུ་འགྱུར་ལ།",
    "དེ་ནས་གནས་གསུམ་ལ་ཉེར་གསུམ་རེ།",
    "གནས་ལྔ་པ་དང་དྲུག་པ་ལ་ཉེར་གཅིག་རེ།",
    "ཅུ་ན་ར་དེ་ཡང་མྱུར་རྐང་གི་རྟག་ལོངས་ཟུར་དུ་མ་གསུངས་པས།",
    "དེའི་ལོངས་སྤྱོད་མྱུར་རྐང་གི་རྐང་པ་གང་ལ་གནས་པས་སོ་སོར་བསྒྱུར།",
    "དཀྱིལ་འཁོར་ཆའམ་བུག་མིག་ལག་པའི་ཆ་འདོད་ན་ཡང་བྱས་ཏེ་རང་རང་གི་གནས་བཅུག།",
    "དྲུག་ཅུས་བགོས་པའི་ནོར་རྣམས་ནི་རྐང་པ་དེ་སྤྱོད་དུས་ཀྱི་ཞག་རེ་བཞིན་རིམ་པ་ལ་སྔ་རྐང་དུ་ནོར་དང་ཕྱི་རྐང་དུ་བུ་ལོན་དུ་སྤྱོད།",
    "བུག་མིག་ལག་པའི་ཆ་བརྒྱ་ཉེར་བཞི་ཡོད་པ་རྣམས་རིམ་རྐང་དང་པོ་དང་རིམ་མིན་ཐ་མ་རྒྱུ་ཚེ་ཞག་རེ་བཞིན་དལ་དག་ལ་ནོར་དུ་སོང་སྟེ་སྤྱོད་པ་བཞིན་ནོ།",
    "འདི་བཞིན་དུ་ཞིབ་མོར་བརྟགས་པས་ཤེས་ནུས་ཀྱི་ཡི་གེས་འཇིགས་སོ།",
    "རྐང་གནས་རེ་རེ་ཡང་མཚུངས་པ་བསམས་ནལ་པ་༡ མིན་པས།",
    "ཕྱི་རྐང་གི་དྲག་པོ་ལ་སོ་གསུམ།",
    "འདིར་ཁ་ཅིག་རྐང་པ་རྣམས་ལ་རྒྱལ་བ་མེ་མིག་སོགས་སྟེང་ནས་འོག་ཏུ་བརྩེགས་མར་བྲིས་པ་ལ་རིམ་རིམ་མིན་གཉིས་ཀ་ལ་སྟེང་ནས་འོག་ཏུ་འདྲེན་ཚུལ་གཅིག་པ་ཁོ་ན་བྱེད་མོད།",
    "དཔེར་ན་ཁྱིམ་བཅུ་གཉིས་སྒོར་མོར་གནས་པ་ལ་ཉི་རྐང་སྤྱོད་ཚེ།",
    "ཀར་སེང་བུ་མོ་གསུམ་ལ་རིམ་པའི་སྔ་རྐང་གནས་རེ་རེ་སྲང་སྡིག་གཞུ་གསུམ་ལ་རིམ་པའི་ཕྱི་རྐང་གནས་རེ་རེ་སྟེ་ལྷོ་བགྲོད་ཀྱི་ཁྱིམ་དྲུག་ལ་རིམ་རྐང་ཚར་གཅིག།",
    "ལུག་གླང་འཁྲིག་གསུམ་ལ་རིམ་མིན་གྱི་ཕྱི་རྐང་སྟེ་སྒོར་མོར་སྤྱོད་དགོས་པའི་ཕྱིར།",
    "འོན་ཀྱང་ཉི་ཟླ་དང་དལ་ཀོང་རྣམས་ལ་སྔ་རྐང་དང་ཕྱི་རྐང་རི་མོའི་གནས་གཅིག་པས་གོ་བ་འཆུག་པ་ཙམ་ལས་སྐྱོན་གཞན་མི་འབྱུང་མོད།",
    "གཟའ་ལྔའི་མྱུར་རྐང་ལ་དེ་ལྟར་བྱས་ན་རི་མོ་འཇུག་སྟེ་རིམ་མིན་ཡང་རིམ་པར་བརྩིས་པའི་སྐྱོན་ཆགས་པའི་ཕྱི་དེ་ཡང་གོ་སླ་བའི་ཕྱིར་དཔེར་བརྗོད་ན།",
    "སྒོར་མོར་གནས་པ་ལ་མིག་དམར་གྱི་མྱུར་རྐང་གིས་རིམ་རིམ་མིན་ལོངས་སྤྱོད་༥༦ག་ཚུལ་འགོད་ནི།",
    "སྔར་གྱི་རྐང་པ་གོ་ལྡོག་སྟེ་ནག་པ་ལ་རིམ་མིན་གྱི་སྔ་རྐང་དང་པོ་ང་གསུམ་ནས་ནམ་གྲུ་ལ་རིམ་མིན་གྱི་ཕྱི་རྐང་ཐ་མ་རྒྱལ་བ་བགནས་པ་ལྟ་བུ་སྟེ་འདི་ནི་རྣམ་གསལ་གྱི་དཔེ་ཙམ་ཡིན་མོད།",
    "སྔ་རྐང་ཕྱི་རྐང་ལ་རྐང་གནས་མང་ཉུང་གི་ཁྱད་པར་ཡོད་པ་ནི་རིམ་པའི་སྔ་རྐང་དང་རིམ་མིན་གྱི་ཕྱི་རྐང་ལས་དུས་རིང་པོས་རྫོགས་པས་གནས་མང་ལ།",
    "བསྒྱུར་ཐོབ་ཆུ་སྲང་དྲུག་གིས་ནི།",
    "གཟའ་ལྔ་པའི་དལ་རྐང་གི་རྐང་པ་ནི་ཉི་རྐང་ལྟར་ཐོབ་ནོར་གྱི་གནས་སུ་སྡོམ་ལ།",
    "ཕྱི་རྐང་གནས་བཅུ་ལ་མ་ཟོས་པ་སྡོམ་མོ།",
    "རྐང་བཟུང་སྡུན་མས་ཆུ་ཚོད་བསྒྱུར་བ་ལ་ཉིན་ཞག་གི་ཆུ་ཚོད་དྲུག་ཅུས་བགོས་པའི་ནོར་ནི་ཡང་དག་རྒྱུ་བའི་ཆུ་ཚོད་དོ།",
    "ལྷག་མ་སྲང་དབུགས་སོགས་བྱས་ཏེ་འོག་གི་ལོངས་སྤྱོད་བསྡོམས་པ་ལ་སྔར་ལྟར་བགོའོ།",
    "རང་རང་གི་རྐང་མཚམས་མ་འདས་ན་ཆུ་ཚོད་འོག་མ་གོང་མ་ལ་བསྲེ་ཞིང་།",
    "རི་མོ་དེ་ནི་སྔར་གྱི་དལ་དག་གནས་གཅིག་ལ་རིམ་མིན་ལ་སྦྱང་ཞིང་རིམ་པ་ལ་བྱིན་པ་དེ་ནི་མིག་དམར་གྱི་མྱུར་བ་དག་པ་སྟེ་ལི་ཐུ་ལ་དགོད་དོ།",
    "ཉི་བར་གནས་གཅིག་གིས་དེ་བྱིན་དོར་གྱི་གཞི་བྱས་ཏེ་དལ་དག་ཏུ་སྒྲུབ།",
    "དལ་དག་གནས་གཅིག་གིས་དལ་ལོངས་ལ་སྦྱངས་ནས་མྱུར་རྐང་འཛིན།",
    "གཉིས་པ་གཟའ་ལྷག་གི་རྩིས་ལ་དལ་མྱུར་གཉིས་ཀྱི་དང་པོ་རྩིས་འཕྲོ་བསྲེ་བ་ནི།",
    "སོ་སོར་གནས་རེར་བསྡུ་ཕྱིར་རྩིས་འཕྲོ་གནས་གསུམ་པོ་སོ་སོར་བརྒྱས་བསྒྱུར་ཏེ་འཁོར་ལོ་དྲིལ་བས་མཚོ་རི་མི་བདག་ཏུ་ལོངས།",
    "རི་མོ་ཉུང་བའི་སླད་དུ།",
    "དཀྱིལ་འཁོར་རི་བུག་རི་ཀླུ་ལ་རྩིས་འཕྲོ་ཆུ་རི་མི་བདག་གིས་སྦྱངས་ལྷག་མེ་ཉི་རི་སྤྱི་ཉི་ནས་ལྷག་འགྱུར་དུ་དོར་བ་སྟེ།",
    "རྩིས་འཕྲོ་ཟུག་ནས་འདོར་དུ་མ་ལྡང་གི་བར་དཀྱིལ་འཁོར་རེ་བསྣན་ནས་དོར་ཞིང་།",
    "རི་བུག་རི་ཀླུས་དང་པོར་ཐོབ་པ་དོར་བ་ནི་རྩིས་འཕྲོ་ཟུག་ནས་ལྷག་པའི་རང་ཞག་ཏུ་སོང་དོར་བའོ།",
    "རི་མོ་དེ་ནི་གཟའ་ལྷག་གི་རྐང་པའི་ལོངས་སྤྱོད་དོ།",
    "འོག་གི་ཆུ་ཚོད་སྟེང་དུ་གཞུག།",
    "ཞི་གཟའི་དལ་རྐང་གི་རྟག་ལོངས་ནི་ཉི་མ་དང་མཚུངས་ཤིང་རྐང་པས་ཁྱད་པར་དུ་བྱེད་པ་མ་གཏོགས་རྟག་ལོངས་འབའ་ཞིག་པའི་དཀྱིལ་འཁོར་ཡང་ཉི་མ་དང་མཚུངས་པའི་ཕྱིར།",
    "ལྷ་མཚམས་ཀྱི་ཕྱེད་ཕྱི་མ་ནི་གཟའ་ལྷག་གི་སྐྱེས་སྐར་དུ་འགྱུར་རོ།",
    "དེ་ཡང་ལྷ་མཚམས་ཀྱི་ཕྱེད་ནས་བཟུང་སྟེ་ཁྱིམ་༥༨བ་ཁྱོན་གསུམ་རེ་རེ་ལ་ཆུ་ཚོད་བཅུ་དང་།",
    "དེ་ནས་ཁྱིམ་ཁྱོན་གསུམ་སོ་སོ་ལ་གསུམ།",
    "དེ་ནས་རིམ་མིན་གྱི་ཁྱིམ་ཁྱོན་དྲུག་ལ་སྔར་གྱི་གོ་ལྡོག་པས་སྤྱོད་པས་དལ་རྐང་གི་རི་མོ་རྣམས་དེ་ལྟར་དུ་བྲིས་སོ།",
    "ཞིབ་པར་ན་ཉི་མའི་ཉིན་ཞག་གི་རྟག་ལོངས་ཆུ་ཚོད་བཞི།",
    "འདོད་ཆ་བརྒྱད་རྣམས་རྐང་གནས་སོ་སོས་བསྒྱུར་ཏེ་མདའ་ཡོན་ཟླ་བས་བགོས་པས་རྐང་པ་སོ་སོའི་ཞག་རེའི་ལོངས་སྤྱོད་འཆར་རོ།",
    "རི་མོ་དེས་ནི།",
    "གཉིས་པ་མྱུར་རྐང་གི་རྩིས་ལ།",
    "དལ་དག་གཅིག་གིས་ལོངས་སྤྱོད་སྦྱང་།",
    "དེ་ཡང་ཞི་གཟའ་གཉིས་ཀྱི་རྟག་ལོངས་ནི་ཉི་མའི་ཉིན་ཞག་གི་རྟག་ལོངས་ཁོ་ན་ཡིན་པས་ཟུར་དུ་མ་གསུངས་ལ།",
    "ཞེས་པ་སྟེ་རྐང་འཛིན་གྱི་ལོངས་སྤྱོད་དེ་ལ་དལ་དག་གིས་སྦྱངས།",
    "ལྷག་མ་སྲང་དུ་བསྒྱུར་བ་སོགས་བྱས་པས་གྲུབ་དོན་གྱི་རི་མོ་རྣམས་རྐང་པ་དེ་སྤྱོད་པའི་ཞག་རེ་ལ་ནོར་རམ་བུ་ལོན་དུ་འགྱུར་བའི་ཕྱིར་རྐང་གནས་ཀྱི་རི་མོ་དེ་ལྟར་བྲིས་སོ།",
    "གལ་ཏེ་ཞི་གཟའ་གཉིས་ཕྱིར་༥༩བ་བཟློག་པ་དང་ལྷོ་བྱང་དུ་བགྲོད་པ་མེད་པར་ཉི་མའི་རྟག་ལོངས་ཀྱི་སྟེང་དུ་མྱུར་རྐང་གི་རྐང་འཛིན་ལོངས་སྤྱོད་ནོར་ཁོ་ནར་སྤྱོད་དེ་རྒྱུ་སྐར་ལ་བགྲོད་པ་ལྷུར་ལེན་ན་ཞག་གྱ་བདུན་སོགས་ནས་དཀྱིལ་འཁོར་འཁོར་ནུས་པའི་མྱུར་རྐང་གི་མཐུ་ཡོད་པའི་དོན་ཡིན་ཡང་།",
    "རྐང་འཛིན་ལོངས་སྤྱོད་དང་ཉི་མའི་བར་ཁྱད་སྐར་མ་རེར་ལོངས་ཚེ་མྱུར་རྐང་གི་སྔ་རྐང་ངམ་ཕྱི་རྐང་རེ་དལ་དག་ལ་ནོར་རམ་བུ་ལོན་དུ་འགྱུར་བ་སྟེ་ཁྱད་པར་དུ་གཟའ་ལྷག་གི་མྱུར་རྐང་ལས་རིམ་པའི་སྔ་རྐང་རྫོགས་ཚེ་ནོར་སྤྱད་པ་བསགས་པས་སྐར་མ་གཅིག་དང་ཆུ་ཚོད་སོ་བདུན་དུ་ལོངས་ཏེ་དེས་གཟའ་ལྷག་མགྱོགས་ཏེ་ཉི་མའི་སྤུན་ཆོད་པས་མྱུར་འགྲོས་དང་།",
    "རིམ་མིན་གྱི་སྔ་རྐང་ལ་སྐར་མ་གཅིག་དང་ཆུ་ཚོད་སོ་བདུན་བུ་ལོན་དུ་སོང་སྟེ་ཉི་མའི་རྗེས་ལ་ལུས་པ་འཁྱོག་པོ།",
    "ཕྱི་རྐང་ལ་ནོར་དུ་སོང་སྟེ་ལྷན་དུ་གནས་པ་འབྱུང་འགྲོས་ཏེ།",
    "མྱུར་རྐང་གི་རིམ་རིམ་མིན་རེ་རྫོགས་པ་ན་སླར་ཡང་ཉི་མ་དང་ལྷན་དུ་གནས་པས་དལ་རྐང་གི་རྒྱུ་སྐར་འཁོར་ཚུལ་ཉི་མ་དང་ཁྱད་པར་མེད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཟླ་སྐྱེས་ཀྱི་ལོངས་སྤྱོད་ལ་སྟེ་གཟའ་ལྷག་གི་ལོངས་སྤྱོད་དུ་ཉི་མས་སྦྱང་བར་བྱའོ།",
    "འདིར་བཟའ་མཐོན་པོ་ཡིས་གཟའ་དམའ་མོ་ལ་རྣམ་པར་སྦྱོང་ཞེས་པ་ནི་ངེས་པ་སྟེ།",
    "ཞི་གཟའི་དལ་ལོངས་ལ་ཉི་དག་གིས་སྦྱངས་པའི་ལྷག་མས་མྱུར་རྐང་འཛིན་པར་བྱེད་དེ།",
    "དེའི་ཚེ་སྦྱངས་ལྷག་མེད་ན་མྱུར་རྐང་གི་འགྲོས་བཞི་རྫོགས་པའོ་ཞེས་གསུང་བ་ཤིན་ཏུ་ལེགས་པས།",
    "དལ་དག་གཅིག་གིས་ལོངས་སྤྱོད་སྦྱང་།",
    "མཁའ་མཁའ་རོ་དང་མིག་གིས་ཕྲི།",
    "སོ་མེ་རྒྱ་མཚོ་ནི་མྱུར་ཨབ་རྐང་གི་དཀྱིལ་འཁོར་རོ།",
    "འོག་གི་ཆུ་ཚོད་སྟེང་དུ་གཞུག།",
    "དེ་རྣམས་ལ་དལ་རྐང་གི་རྐང་གནས་སོ་སོས་བསྒྱུར།",
    "ཁྱིམ་ཁྱོན་གྱིས་བགོད་པ་སོགས་བྱས་པའི་འབྲས་བུ་རྣམས་ནི་རྐང་པ་རང་རང་ལ་སྤྱོད་དུས་ཀྱི་ཞག་རེ་བཞིན་ནོར་རམ་བུ་ལོན་དུ་འགྱུར་བའོ།",
    "དལ་དག་གནས་གཉིས་གཅིག་གིས་ནི།",
    "དལ་དག་གཅིག་གིས་ཉི་བར་ལ་སྦྱངས་པས་ནི་དྲག་གཟའི་རྐང་འཛིན་ལོངས་སྤྱོད་ཡིན་ལ།",
    "རི་དང་རྒྱལ་བ་མིག་གིས་བགོ།",
    "འོག་གི་ཆུ་ཚོད་སྟེང་དུ་གཞུག།",
    "རྟོག་ལོངས་ནི་ཉི་མའི་ཉིན་ཞག་གི་རྟག་ལོངས་ཉིད་ཡིན་པས།",
    "དེ་ལ་པ་སངས་ཀྱི་དལ་རྐང་སོ་སོས་བསྒྱུར་ཏེ་ཁྱིམ་ཁྱོན་གྱིས་ཐོབ་པ་ནི་རྐང་པ་དེ་དུས་ཀྱི་ཞག་རེའི་ཆ་སྟེ་རྟག་ལོངས་ལ་ནོར་རིམ་བུ་ལོན་དུ་འགྱུར་བའོ།",
    "དལ་དག་གཅིག་གིས་ལོངས་སྤྱོད་སྦྱང་།",
    "འདི་ལ་དལ་དག་གིས་སྦྱངས་ལྷག་མྱུར་རྐང་སོ་སོས་བསྒྱུར།",
    "སྔར་བཞིན་བྱས་པའི་འབྲས་བུ་ནི་སོ་སོའི་ཞག་རེའི་འཕེལ་འགྲིབ་བོ།",
    "རིམ་པའི་ཕྱི་རྐང་གི་དང་པོར་དྲུག།",
    "པ་སངས་ལ་ཆུ་ཚོད་རེ་ཙམ་གྱི་ཁྱད་པར་ལས་མེད་ཀྱང་།",
    "ལྷག་པས་སྐྱེས་ཁྱིམ་དུ་སླེབ་ནས་དལ་རྐང་གསུམ་འདས་པ་ན་ཆུ་ཚོད་སུམ་ཅུ་སོ་དྲུག་གི་ཁྱད་འཇུག་ཅིང་།",
