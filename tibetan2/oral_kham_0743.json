    "དུས་རྒྱུ་གང་འདུག་གད་ཕྱོགས་དུས་རྒྱལ་བ་སྲས་དང་བཅས་རྣམས་དང་།",
    "དེ་ཕྱིར་བེ་རོ་ཙ་ན་ངས",
    "ལུས་ངག་བྲན་གཡོག་ལྟར་འདུག་ན",
    "འདུག་ས་འདི་དང་གདན་ས་འདིར་ད་ལྟ་ཉིད་དང་མྱུར་བ་ཉིད",
    "གང་སྣང་སྣང་ཡང་རང་བཞིན་སྟོང་",
    "གདོད་མའི་རྒྱལ་ས་མཐོན་པོ་རུ་བགྲོད་འདོད་ཡོད་ན་བགྲོད་ཐབས་གདའ",
    "ནམ་ཞིག་དུས་ལ་བབས་པའི་ཚེ",
    "གཅེར་མཐོང་རང་ངོ་ལ་ལྟོས་དང་།",
    "འཁྲུལ་སྣང་རང་གྲོལ་དུ་ཤེས་ན།",
    "སྤྲིན་བྲལ་མཁའ་དབྱིངས་བཞིན་གསལ་འདུག།",
    "འཁོད་པ་རང་ལག་ཏུ་འདུག་གོ།",
    "མ་འཚོ་མ་སྐྱོང་རང་བབ་གསལ་ཧྲིག་གེ",
    "སྟོངས་ཀྱང་རང་བཞིན་གསལ་བའི་ཡེ་ཤེས་ཡིན།",
    "ཀྱེ་མ་མི་ཚེ་སྟོང་ཟད་གྱུར་ལ་འགྱོད། ༦ འོན་ཀྱང་རང་ཅིག་ལས་འབྲེལ་བཟང་པོའི་མཐུས།",
    "སྤྱང་བདག་ནི་སྒོ་གསུམ་བག་མེད་དུ་འདུག་པས།",
    "བླང་འོས་ཀྱི་ཞལ་གདམས་སྨྲ་རྒྱུ་ནི་མི་འདུག།",
    "དེ་ཤེས་ན་པད་འབྱུང་རང་ཞལ་དེ་མཐོང་འོང་།",
    "བློས་གང་ལྟར་བཏགས་ཀྱང་མཐོང་རྒྱུ་ཞིག་མི་འདུག།",
    "ཁོང་རྣམ་དཔྱོད་ཅན་འགའ་རྟོག་གེ་རུ་ལུས་འདུག།",
    "ཡུན་རིང་བོར་འདུག་ཆས་ཀྱི་རྟག་འཛིན་སྤོངས་ལ་ཉི་མ་སྟོང་ཟད་དུ་མི།",
    "ལྷུན་གྲུབ་སྣང་ཆ་རང་བྱུང་རང་ཤར་བ།",
    "རང་བྱུང་རང་ཤར་སྒྱུ་མའི་རོལ་གར་བཞིན།",
    "སྒོམ་དང་མི་བསྒོམ་གཉིས་ཀ་བློས་བྱས་ཡིན་འདུག།",
    "བྱ་སྤྱོད་རྩོལ་སྒྲུབ་རང་རྒྱུད་འཆིང་བྱེད་ཡིན་འདུག།",
    "སྐྱོན་བྲལ་མཁའ་དབྱིངས་ཇི་བཞིན་མངོན་སུམ་གསལ་འདུག།",
    "གཞོན་ནུ་བུམ་སྐུ་དེའི་རང་ཞལ་མཇལ་འདུག།",
    "རང་འདོད་ཡིད་བྱེད་བློ་ངན་ཕག་ཏུ་ཡིབ་འདུག།",
    "དེ་ལ་ངེས་ཤེས་ཅུང་ཟད་སྐྱེ་བར་འདུག་ཀྱང་།",
    "རྣམ་རྟོག་རྩིས་གདབ་ལྷ་འདྲེས་འདུག་ཏུ་མི་སྟེར།",
    "གཉུག་མའི་རྒྱལ་ས་དེ་ཐག་རིང་འདུག་གོ། ༦",
    "དེ་འགྲིག་འགྲིག་འདྲ་ཡང་ཉན་འདོད་ཅིག་མི་འདུག།",
    "སེམས་འཁྲུལ་སྣང་འཇུག་ལྡང་རང་དེངས་སུ་འགྲོ་བས།",
    "མ་བཤམས་ཀྱང་རང་བྱུང་བཀོད་པའི་རྒྱན།",
    "མ་ཞི་མཛད་འཕགས་མའི་གནས་སུ་གདའ།",
    "འཁྲུལ་སྣང་རང་དག་ཀློང་དུ་ཕཊ་སྒྲ་ཡིས་ཤིགས་ཤིག།",
    "མི་རྟག་སྒྱུ་མའི་རང་མཚང་སྟོན་འདུག།",
    "ཉམས་སྤྲོས་དགའ་སྟོན་ལ་རོལ་འདུག།",
    "ཅི་བྱེད་མེད་པར་ཧད་དེ་ལུས་འདུག།",
    "རང་ཡུལ་རི་ལུང་ཁང་ཁྱིམ་འདུག་གནས།",
    "ལས་ངན་བག་ཆགས་འབྲས་བུ་རྩྭ་སྐྱ་ལས་མི་འདུག།",
    "ཡིད་ཀྱང་གཏིང་ནས་འཕྱོད་འཕྲོད་བྱེད་འདུག།",
    "༧ སྔར་ཡང་རང་ཅག་ཚ་ཞང་གཉིས་ཀྱིས།",
    "ཡུན་རིང་འདུག་པའི་གོ་སྐབས་མ་མཆིས།",
    "ཟིལ་མངར་སྦྲང་རྩིར་རོལ་བཞིན་ཉམས་དགའ་རུ་འདུག་ཚེ།",
    "སྦྲང་ཆུང་ཁོ་ཚོའི་སྣང་བ་སྐྱིད་སྐྱིད་ཅིག་འདྲ་འདུག།",
    "ངང་ཆུང་ཁོ་ཚོའི་སྣང་བ་སྐྱིད་སྐྱིད་ཅིག་འདྲ་འདུག།",
    "སྒོ་གསུམ་ཐ་མལ་བ་རུ་རྒས་ནས་འདུག།",
    "རྣམ་རྟོག་ལང་ཤོར་ཐུལ་བའི་དུས་ནི་མི་འདུག། ༧",
    "ཀུན་མཁྱེན་རོང་ཀློང་རང་ལུགས་གངས་ཀྱི་རི་རྩེར།",
    "ལོག་རྟོག་སྲིན་བྱའི་བློ་མིག་དུས་གཅིག་ལྡོང་འགྲོ། ༡༥",
    "མི་ཚེ་ཕལ་ཆེར་ཞིག་ཟད་ལ་ཐུག་འདུག།",
    "ཅི་ལྟར་བསམས་ཀྱང་ཡིད་སྐྱོའི་གཞི་མ་རུ་འདུག་པས།",
    "གང་དུ་བསྡད་ཀྱང་མཐུན་རྐྱེན་འབྱོར་བ་དེ་དཀའ་འདུག།",
    "རང་ཅག་སྙིགས་འགྲོའི་རྒྱུད་ལ་དབྱེར་མེད་དུ་འདྲེས་འདུག།",
    "ཚོང་དཔོན་རིན་ཆེན་རྒྱུས་ལ་མཁས་པ་བཞིན་ཡིན་འདུག།",
    "བུ་ལྷ་དང་རང་རིག་དབྱེར་མེད་ངང་།",
    "ང་རང་རྒྱུད་ཀྱི་ཡོན་ཏན་མ་ལགས་ཏེ།",
    "རང་ངན་འགྲོའི་གྲོང་སྒོར་ཁྲིད་ནས་འདུག།",
    "ཤིན་ཏུ་དམན་ཕྱིར་ཡ་རབས་གཤིས་སྤྱོད་དེ་དཀོན་འདུག།",
    "དེང་དུས་ཇི་བཞིན་སྒྲུབ་མཁན་ཉིན་སྐར་བས་དཀོན་འདུག།",
    "ཡ་རབས་སྤྱོད་བཟང་རྙེད་པའི་དུས་སྐབས་ཤིག་མི་འདུག། ༩",
    "ཀུན་གྱིས་བརྙས་ཤིང་རང་ཡང་བློ་ཕམ་གྱི་གནས་ལགས། ༡༦",
    "གཞན་དག་བཞད་གད་བྱས་ཀྱང་རང་བསྟོད་དུ་རློམ་འདུག། ༢",
    "སེར་སྣས་བསགས་པའི་ནོར་ལ་ཕན་འབྲས་ནི་ཆུང་འདུག།",
    "ཏ་ལེར་ཚེ་འདིའི་བསླུ་བྲིད་ཡིན་འདུག།",
    "ཙ་ན་ཤི་འོང་སྙམ་ནས་འཆི་བ་ལ་སྐྲག་ན།",
    "ཕ་ཅིག་པདྨ་ཀཱ་རའི་ཞལ་ཆེམས་སུ་འདུག་གོ།",
    "ན་འཆི་སྐྱེ་རྒ་དང་བྲལ་འདུག།",
    "ཐ་མལ་བག་མེད་དུ་འདུག་པའི་དུས་མ་ཡིན།",
    "ལུས་ལ་འཆང་ན་བསྲུང་བྱ་དེ་ས་གཉན་དང་ཆུ་མིག་ཀླུ་གཉན་གྱི་སྟེང་སོགས་ལ་འདུག་ཀྱང་མི་གནོད་དོ།",
    "གྲམ་པའི་ཁར་སླེབས་དུས་གྲམ་པའི་ཕ་རོལ་ཏུ་གཅན་ཚའི་མ་ཎི་ལྷན་ནེར་ལྷང་ངེར་ཆགས་འདུག་གྱང་རྩི་སེར་པོ་བྱུགས་པའི་ལྕགས་རི་ཆེན་པོས་བསྐོར་པའི་དབུས་སུ་གཡུ་གྱོན་གྱིས་སྤྲས་པའི་རྒྱ་ཕིབས་དང་གསེར་ཏོག་གསལ་ལེར་མཐོང་ཐུབ་པས།",
    "གཡུ་གྱོན་གྱིས་སྤྲས་པའི་ཁང་རྩེག་དེ་སྒོ་ཆེན་གྱི་ཁ་གཏད་དུ་བཞེངས་འདུག་ལ།",
    "ད་ལྟ་དངོས་སུ་མཇལ་རྒྱུ་ཡོད་པའི་བང་སོ་བཅུ་གཉིས་ཙམ་ལས་མི་འདུག་བོད་ཀྱི་བཙན་པོར་བང་སོ་འདེབས་པའི་སྲོལ་ནི་པུ་དེ་གུང་རྒྱལ་རིང་ནས་བྱུང་བར་གྲགས་ལ།",
    "ཞིབ་ཏུ་བལྟས་ན་བརྗིད་ཉམས་ཀྱི་ཁྲོད་དུ་སྐྱོ་ཉམས་ཤིག་ཀྱང་མངོན་འདུགདཔའ་བོ་གཡང་དུ་མཆོངས་སའི་བྲག་ཁར་གཡང་མཆོངས་དཔའ་བོ་ནམ་ཡང་མི་ནུབ་པར་གྱུར་ཅིག་ཅེས་པའི་རྡོ་བྱང་ཞིག་བསླངས་ཡོད་པ་དང་།",
    "དེ་དག་དུས་ནམ་ཞིག་ལ་བྱུང་བའི་ལོ་ཚིགས་གསལ་བོར་བརྗོད་དཀའ་ན་ཡང་།",
    "ང་རང་དངོས་སུ་འབིས་རྣམ་པར་སྣང་མཛད་ལྷ་ཁང་དང་བྲག་བརྐོས་ཡི་གེ་དགལ་མཇལ་བའི་སྐལ་བཟང་ཐོབ།",
    "ང་རང་ལྷ་སྐུ་དེ་དག་ལ་ཞིབ་ཏུ་མཇལ་དུས།",
    "གཏམ་རྒྱུད་ལ་དགའ་བའི་མཁས་པ་ཚོས་ད་དུང་ཨ་ཅེ་རྒྱ་བཟའི་གཏམ་རྒྱུད་གསར་དུ་སྒྲིག་དུས།",
    "གནས་ལུགས་ཀྱིས་དགག་དགོས་དོན་ཡང་མི་འདུག་བྲ་མ་ལུང་ནི་ཟི་ལིང་དང་ཐག་ཉེ་བའི་ས་ཆ་ཞིག་ཡིན་པ་དང་།",
    "ངའི་སེམས་ལ་ཟ་ཁང་འདིས་གཙང་སྦྲ་ལ་དོ་སྣང་ཆེན་པོ་བྱེད་བཞིན་འདུག་སྙམ།",
    "བླ་གྲྭ་མང་བོ་ཞིག་ཕེབས་འདུག་ལ།",
    "ལྷ་ས་ན་ཁོ་འདུག་སའི་གནས་ཤིག་མི་འདུག་ཅེས་རྩེད་མཚར་བྱས་པ་ནང་བཞིན།",
    "ཁོ་རང་ཡང་འཁོན་གྱི་གདུང་རྒྱུད་ཡིན་པ་དང་།",
    "རྦབ་ཆུ་ལ་སྐོར་བ་བརྒྱབ་ནས་ལྟ་སྐོར་བྱེད་མཁན་ཚོས་ཆར་ལྭ་གྱོན་པ་དང་ཆར་གདུགས་བཀར་ནས་འགྲོ་བཞིན་འདུག་རྦབ་ཆུའི་རྒྱབ་ལོགས་སུ་བྲག་ཕུག་ཅིག་ཡོད་པ་དང་།",
    "ཤར་ཕྱོགས་སུ་རྒྱུ་བའི་རྫ་ཆུ་བསིལ་མས་ཁྱེད་རང་གླེང་ལ།",
    "དེ་ལོས་ཡིན།",
    "སྲོལ་རྒྱུན་གྱི་འདུ་ཤེས་ཤུགས་དྲག་པའི་ང་རང་འགག་སྒོ་དེ་ལས་ཐར་མ་ཐུབ།",
    "ས་ཆ་ཆེས་ཐབས་སྡུག་ཅིག་ལ་བགོས་འདུག་སྙམ་པའི་ཚོར་བ་ཞིག་སྐྱེས་མ་བྱུང་།",
    "འགྲན་སྡུར་དེ་ནི་ཆེས་དཀའ་ཁག་ཆེ་བ་ཞིག་ཏུ་གྱུར་འདུགམཚམས་ཤིག་ལ་རྟ་རྒྱུག་བྱེད་ས་ནས་ཀི་ལྡིར་བྱས་བྱུང་།",
    "རྟ་རྒྱུག་སར་མི་ཚོགས་ཕྱོགས་གཉིས་སུ་ཆད་དེ་ཕན་ཚུན་ལ་གཡུལ་གྱི་འཐབ་ར་སྤྲད་འདུག་གདོང་མཆོང་པ་ནི་སྐྱེས་པ་ཚོ་ཡིན་ལ།",
    "ང་རང་དབུས་གཙང་ལ་ཐོག་མར་མཇལ་སྐོར་དུ་འགྲོ་དུས།",
    "རང་ཉིད་ཀྱི་གཤེད་མ་ཡང་རང་ཉིད་ཡིན་པའི་གནས་ལུགས་རྟོགས།",
    "ང་རང་ཉིད་ཀྱི་མིག་ཀོང་ལས་ཕྱི་རོལ་ཏུ་མཆེད་དུས།",
    "ང་རང་གཞི་རིམ་དུ་ཡོད་དུས་ངས་འདི་ལྟ་བུ་ཞིག་བསྒྲུབས་ཟིན་ལ།",
    "བྱིས་པ་ལ་བོད་ཡིག་དུས་ལྟར་ཟུར་ཁྲིད་བྱེད་བཞིན་ཡོད་ལ།",
