    "བསམ་པ་དག་པས་ཤེས་པར་བྱ།",
    "དོན་དམ་པའི་སེམས་བསྐྱེད་པ་དེ་ཡངས་རབ་ཏུ་དགའ་བ་ཡིན་པས་དེའི་རབ་ཏུ་དགའ་བ་ཁྱད་པར་དུ་འཕགས་པའི་རྒྱུ་སྟོན་ཏེ།",
    "དོན་དམ་པ་པའི་སེམས་བསྐྱེད་པ་དེ་ཉིད་ལ་དོན་དམ་པ་རྣམ་པ་དྲུག་ཏུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་སྐྱེ་བ་ནི་ས་བོན་དང་མ་དང་མངལ་དང་མ་མའི་བྱེ་བྲག་ལས་རིག་པར་བྱའོ།",
    "ས་ཇི་ལྟར་རྣམ་པར་གཞག་པ་བཞིན་ཡིད་ལ་བྱེད་པས་སོ།",
    "རྟོག་པ་ཉིད་དུ་ཤེས་པ་དེ་ཉིད་ལ་ཡང་རྣམས་པར་མི་རྟོག་པའི་ཕྱིར་རོ།",
    "ལྷག་པའི་བསམ་པ་ནི་ཁྱད་པར་རྟོགས་པའི་བསམ་པའོ།",
    "རྣམ་པར་གཡེང་བས་མི་གཡོ་བའི་ཕྱིར་རོ།",
    "གདུལ་བའི་ལོ་ཏོག་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "སེམས་མ་བསྐྱེད་པ་སྨད་པར་ཚིགས་སུ་བཅད་པ།",
    "སེམས་བསྐྱེད་པ་བསྔགས་པར་ཚིགས་སུ་བཅད་པ།",
    "དེའི་ཕྱིར་འདི་ངན་འགྲོས་འཇིགས་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་འདི་བྱ་བ་མང་པོས་ཡོངས་སུ་སྐྱོ་བས་ཀྱང་འཇིགས་པར་མི་འགྱུར་རོ།",
    "མི་བྱེད་པའི་སྡོམ་བ་ཐོབ་པར་ཚིགས་སུ་བཅད་པ།",
    "ཇི་ལྟར་ངན་པར་བྱེད་པའི་ལས་ལ་འཇུག་དེའི་བསྡུས་པའི་དོན་ནི།",
    "སེམས་མི་ལྡོག་པར་ཚིགས་སུ་བཅད་པ་གཉིས་ཏེ།",
    "བསམས་བཞིན་སྐྱེ་བ་རྫུ་འཕྲུལ་རྣམ་པར་འཕྲུལ།",
    "སྡུག་བསྔལ་གྱིས་འཇིགས་བདག་ག་པར་ཚིགས་སུ་བཅད་པ།",
    "ལེ་ལོ་སྨད་པར་ཚིགས་སུ་གཅད་པ།",
    "རྒྱལ་སྲས་རྣམས་ཀྱི་སྒྲུབ་པ་ཡིན་པར་འདོད།",
    "རང་དང་གཞན་གྱི་དོན་ཁྱད་པར་མེད་པར་ཚིགས་སུ་བཅད་པ།",
    "དེ་ལ་གཉིས་ཀ་ཁྱད་པར་མེད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གཞན་གྱི་དོན་ཁྱད་པར་དུ་བྱ་བར་ཚིགས་སུ་བཅད་པ།",
    "བདག་ལ་སྡུག་བསྔལ་མི་བཟད་གདུང་པར་རབ་བྱེད་པ།",
    "ཤིན་ཏུ་བརྩེ་བ་མེད་པར་རབ་ཏུ་འཇུག་མ་ཡིན།",
    "ཇི་ལྟར་འདིའི་གཞན་གྱི་དོན་བདག་ཉིད་ཀྱི་དོན་ལས་ཁྱད་པར་དུ་འཕགས་པ་དེ་སྒྲུབ་པར་བྱེད་དེ།",
    "གཞན་གྱི་དོན་སྒྲུབ་པར་རྣམ་པར་དབྱེ་བར་ཚིགས་སུ་བཅད་པ་གཉིས་ཏེ།",
    "ལེགས་པར་སྟོན་དང་མགུ་བྱེད་འཇུག་པ་དང་།",
    "ཡོན་ཏན་ཁྱད་པར་ཅན་འགྲུབ་དེ་བཞིན་དུ།",
    "ཞུགས་པ་རྣམས་ཀྱི་ཐེ་ཚོམ་གཙོད་པའི་ཕྱིར་དོན་ལ་རྣམ་པར་ངེས་པར་བྱེད་དང་།",
    "སེམས་གནས་པར་བྱེད་པ་དང་།",
    "ཤེས་རབ་རྣམ་པར་གྲོལ་བར་བྱེད་པ་དང་།",
    "མངོན་བར་ཤེས་པ་ལ་སོགས་པ་ཡོན་ཏན་ཁྱད་པར་ཅན་རྣམས་ཡང་དག་པར་འགྲུབ་པར་བྱེད་པ་དང་།",
    "གཞན་གྱི་དོན་སྒྲུབ་པ་ཕུན་སུམ་ཚོགས་པར་ཚིགས་སུ་བཅད་པ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་འཆད་པར་འགྱུར་བ་དང་།",
    "འགྱིང་བ་མེད་པར་མགུ་བར་འགྱུར་བ་དང་།",
    "དོན་རྣམ་པར་ངེ་བྱ་བ་ལ་མཁས་པའི་སྒྲུབ་པ་ཡིན་ཏེ།",
    "མ་དུལ་བས་ནི་གཞན་དག་ལ་གདམས་པ་ལ་སོགས་བསྟན་པར་མི་ནུས་སོ།",
    "གཞན་དག་རིགས་སུ་སྐྱེས་པ་ལ་སོགས་པར་བྱ་བར་མི་ནུས་སོ།",
    "དེའི་ཕྱིར་ཡང་ཕུན་སུམ་ཚོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྒྲུབ་པ་ཁྱད་པར་དུ་བྱ་བར་ཚིགས་སུ་བཅད་པ་གཉིས་ཏེ་འདོད་ལྡན་སྐྱེ་བོ་འཇིགས་པ་ཆེ་ལ་འཇུག།",
    "རྟག་ཏུ་དེ་མ་ཐོབ་པར་སྡུག་བསྔལ་འགྱུར།",
    "གཉི་གའི་དོན་བྱས་མྱ་ངན་འདའ་བར་འགྱུར།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་གྱིས་དོན་དམ་པར་སྡུག་བསྔལ་བའི་ཕྱིར་རོ།",
    "འདི་ནི་སྒྲུབ་པའི་ཁྱད་པར་གཞན་ཡིན་ནོ།",
    "སྐྱེ་བོ་ན་ནི་བློ་ལྡན་ཉེས་པར་མི་འཛིན་ཏེ།",
    "མི་འདོད་བཞིན་དུ་ལོག་པར་སྒྲུབ་པར་འགྱུར་རོ་ཞེས།",
    "ཡོན་ཏན་སྣ་ཚོགས་ཚོགས་ཀྱིས་རྣམ་པར་འཕེལ།",
    "འཕེལ་བ་མེད་ཅིང་རྣམ་པར་དག་པའང་མེད།",
    "རྣམ་པར་དག་འགྱུར་དེ་ནི་དོན་དམ་མཚན།",
    "གཉིས་མེད་པའི་དོན་དེ་ཡང་རྣམ་པ་ལྡས་ཡང་དག་པར་སྟོན་ཏོ།",
    "རྣམ་པར་དག་པར་འགྱུར་བ་མེད་དོ།",
    "དེ་ལྟར་ན་གཉིས་མེད་པའི་མཚན་ཉིད་རྣམ་པ་ལྔ་པོ་དེ་ནི་དོན་དམ་པའི་མཚན་ཉིད་ཀྱི་པར་རིག་པར་བྱའོ།",
    "བདག་ཏུ་ལྟ་བའི་ཕྱིན་ཅི་ལོག་དགག་པར་ཚིགས་སུ་བཅད་པ།",
    "ངན་པར་གནས་མིན་མཚན་ཉིད་མི་འདྲ་ཕྱིར།",
    "ངན་པར་གནས་པ་ཉིད་ཀྱང་མ་ཡིན་ཏེ།",
    "ཕྱིན་ཅི་ལོག་སྨད་པར་ཚིགས་སུ་བཅད་པ་གཉིས་ཏེ།",
    "སྐྱེ་བོ་ཇི་ལྟར་གཞན་གྱིས་བྱས་ལ་བརྟེན།",
    "སྡུག་བསྔལ་གྱི་རང་བཞིན་དེ་ནི་ཡེ་ཤེས་ཀྱིས་རིག་པར་བྱ་མི་དགོས་ཏེ།",
    "བདག་མེད་པར་ཞི་བ་རུང་བར་ཚིགས་སུ་བཅད་པ།",
    "འདི་ལ་དོན་དམ་ཚུལ་གྱིས་ཞི་བ་དང་། སྐྱེ་བ་དེ་གཉིས་ཁྱད་པར་ཅི་ཡང་མེད།",
    "ཕྱིན་ཅི་ལོག་སྨད་པ་བྱས་ནས་དེའི་གཉེན་པོ་དོན་དམ་པའི་ཡེ་ཤེས་ལ་འཇུག་པར་ཚིགས་སུ་བཅད་པ་བཞི་སྟེ།",
    "བྲལ་བ་མངོན་སུམ་ཉིད་དུ་རྟོགས་པར་འགྱུར།",
    "སེམས་ལས་གཞན་མེད་པར་ནི་བློས་རིག་ནས།",
    "མཐུའི་མཚན་ཉིད་རྣམ་པར་དབྱེ་བས་ཚིགས་སུ་བཅད་པ།",
    "མཐུ་འགྲུབ་པ་ཡི་དམ་པ་ཐོབ་པར་འགྱུར།",
    "བདུད་གནས་གཞལ་མེད་ཁང་མཐོ་མཛེས་པ་དག་བདུད་བཅས་ཀུན་དུ་བསྐྱོད་ཅིང་སྐྲག་པར་བྱེད།",
    "འོད་ཟེར་གྱི་ལས་རྣམ་པར་གཉིས་སྟོན་ཏེ།",
    "རྣམ་པར་རོལ་པའི་ལས་དང་སྤྲུལ་པའི་ལས་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་དེ་ནི་མཆོག་ཚོགས་ནང་དུ་ཏིང་ངེ་འཛིན།",
    "དཔག་མེད་རྣམ་པར་རོལ་པ་ཀུན་སྟོན་ཞིང་།",
    "དགའ་ལྡན་གྱི་གནས་ན་བཞུགས་པ་ལ་སོགས་པ་མཆོག་སྤྲུལ་པའོ།",
    "སྐྱེ་དགུ་རྣམས་ལ་ཚིག་གཟུང་འོས་པར་འགྱུར།",
    "དཔག་ཏུ་མེད་པར་བརྟན་པ་ཐོབ་པའི་མཐུ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་དང་།",
    "དད་པ་ནི་དེ་སྟོན་པར་བྱེད་པ་ལའོ།",
    "མཐུ་ཅན་ཉིད་ནི་རྟོགས་པར་བྱ་བ་ལའོ།",
    "དགའ་བ་ལ་སོགས་པ་ཆེན་པོ་ཉིང་སྟོན་པར་བྱེད་དོ།",
    "ཡོན་ཏན་ཤེས་པ་ནི་དི་ལྟར་བཅོམ་ལྡན་འདས་དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱས་པར་འབྱུང་ལྟ་བུ་སྟེ་རྒྱུའོ།",
    "ཁྱད་པར་འགྲོ་དང་འགྲོ་བའི་མཆོག་གྱུར་ལུས།",
    "ཡོངས་སུ་སྨིན་པ་འཕེལ་བར་འགྱུར་བའི་ཕྱིར་ཁྱད་པར་དུ་འགྲོ་བ་ནི་རང་བཞིན་ནོ།",
    "དེ་ལ་ཡིད་གཞུངས་པ་དང་མཐུན་པའི་རྣམ་པར་སྨིན་པ་དག་ནི་རྒྱུའོ།",
    "ཉེས་པར་སྨྲས་པ་དོན་རབ་ཏུ་ཤེས་པ་ནི་ཡིད་གཞུངས་པ་ཡོངས་སུ་སྨིན་པའི་རང་བཞིན་ནོ།",
    "རྟེན་རྟོགས་པར་བྱ་བར་རུང་བ་ནི།",
    "ཁྱད་པར་རྙེད་དང་གཞན་གྱི་ཕྱོགས་སུན་འབྱིན།",
    "ཁྱད་པར་རྟོགས་པ་དང་།",
    "རྟེན་བརྩོན་འགྲུས་རྩོམ་པར་བཟོད་པ་ནི་རང་བཞིན་ནོ།",
    "བདག་ཡོངས་སུ་སྨིན་པ་རྣམ་པ་ཏེ་གཞན་ཡོངས་སུ་སྨིན་པར་བྱ་བའི་སྟོན་པར་གྱུར་པ་དང་།",
    "གཉེན་པོའི་ཕྱོགས་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཡོངས་སྨིན་རབ་སྨིན་མཐུན་པར་སྨིན་བྱེད་གཞན།",
    "ལེགས་པར་སྨིན་བྱེད་རྟོགས་པ་སྨིན་བྱེད་དང་།",
    "ཕྱི་རོལ་པའི་ཡོངས་སུ་སྨིན་པ་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་མཆོག་ཏུ་སྨིན་པར་བྱེད་པ་ནི།",
    "རབ་ཏུ་སྨིན་པར་བྱེད་པའོ།",
    "འཚམ་པར་སྨིན་པར་བྱེད་པ་ནི་མཐུན་པར་སྨིན་པར་བྱེད་པའོ།",
    "གུས་པར་སྨིན་པར་བྱེད་པ་ནི་ལེགས་པར་སྨིན་པར་བྱེད་པའོ།",
    "རྟོགས་པས་སྨིན་པར་བྱེད་པ་ནི་རྟོགས་པ་སྨིན་པར་བྱེད་པའོ།",
    "ཕྱིན་ཅི་མ་ལོག་པའི་དོན་གྱིས་རྟག་ཏུ་སྨིན་པར་བྱེད་པ་ནི་རྟག་ཏུ་སྨིན་པར་བྱེད་པའོ།",
    "ཡོངས་སུ་ཉམས་པར་མི་འགྱུར་བའི་དོན་གྱིས་གོང་ནས་གོང་དུ་རིམ་གྱིས་སྨིན་པར་བྱེད་པ་ནི་གོང་ནས་གོང་དུ་སྨིན་པར་བྱེད་པ་སྟེ།",
    "འགྲོ་ཀུན་རྣམ་པར་སྨིན་བྱེད་གནས་པས་ལྟར།",
    "སྐྱེ་བོ་བདག་ལ་བྱམས་པར་མི་འདོད་ན།",
    "ཕན་པ་དང་བདེ་བ་ལ་ཡང་དག་པར་སྦྱོར་པའི་ཕྱིར།",
    "ཕ་མ་དང་གཉེན་བཤེས་ཀྱི་བསམ་པ་ལས་ཁྱད་པར་དུ་འཕགས་པ་དང་།",
    "འཇིག་རྟེན་བདག་ལ་བྱམས་པ་ལས་ཁྱད་པར་དུ་འཕགས་པའི་བསམ་པ་ཡིན་ནོ།",
    "མཉམ་པར་སྦྱིན་པའི་ཡོན་ཏན་ངོམས་མི་འགྱུར།",
    "མི་མཉམ་པ་མེད་པར་སྦྱིན་པ་དང་།",
    "ངོམས་པ་མེད་པར་སྦྱིན་པས་སོ།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "ཕོངས་པ་མེད་པར་འདོད་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་ཕྱིར་དང་།",
    "བསྟན་པ་རང་བཞིན་ལྷག་པར་འཚེ་བ་མེད།",
    "ཕན་རྣམ་གཉིས་འདོགས་རྣམ་པར་སྨིན་པ་དང་།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "གནོད་པ་བྱེད་པ་དྲག་པོ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པས་ཡོངས་སུ་སྨིན་པར་བྱེད་དེ།",
    "ཕན་པ་བྱེད་པའི་བློ་ཉིད་ནི་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བ་དང་མཐུན་པར་འཇུག་པ་ལས་རིག་པར་བྱའོ།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "ཤེས་རབ་ཇི་ལྟ་བུས་ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་དེ་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ།",
    "དགོངས་པའི་དོན་གྱི་ཚུལ་ལ་ཤིན་ཏུ་རྣམ་པར་ངེས་པའི་ཤེས་རབ་ཀྱིས་ཡོངས་སུ་སྨིན་པར་བྱེད་དོ།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "དེའི་ཕྱིར་དེ་དག་བསྟན་པ་ལ་གུས་པས་བདག་དང་གཞན་གྱིས་ཡོན་ཏན་ཡང་དག་པར་འཕེལ་བར་བྱེད་པ་ཉིད་ཀྱིས་སོ།",
    "འཇིག་རྟེན་ཡོད་དང་མཉམ་པར་འཇུག་པས་འདུལ།",
    "ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་རྣམ་པ་ཇི་ལྟ་བུ་དག་དང་།",
    "འབྲིང་ནི་བདུན་པ་ལ་གནས་པའི་ཡིན་པར་རིག་པར་བྱའོ།",
    "འཇིག་རྟེན་ཡོད་པ་ཇི་སྲིད་པ་དེ་དང་མཉམ་པར་འཇུག་པས་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་ཚིགས་སུ་བཅད་པ་གཉིས་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་འཐོབ།",
    "ཡང་དག་པར་འགྲུབ་པ་དང་།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ཇི་ཙམ་སྤངས་པས་ཡང་དག་པར་འགྲུབ་པ་འདི་ནི་ཡང་དག་པར་འགྲུབ་པའོ།",
    "སྒྲིབ་པ་ཐམས་ཅད་ཀྱི་དྲི་མ་མེད་པ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་འཐོབ་པ་ནི་ངོ་བོ་ཉིད་དོ།",
    "ཉེས་པར་སྤྱོད་པ་ཐམས་ཅད་དང་།",
    "བཟློག་ཅིང་འབྱོར་པར་བྱ་བའི་ཕྱིར།",
    "ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་འབྱོར་པར་བྱ་བའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལམ་ཐོབ་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་དེ་ནི་དེར་བཞུགས་ནས།",
    "གཉིས་པ་འདིས་ནི་གནས་ཡོངས་སུ་གྱུར་པ་དེ་གཞན་ལས་ཁྱད་པར་དུ་སྟོན་ཏེ།",
    "གནས་ལ་ཞེས་བྱ་བ་ནི་གནས་ཡོངས་སུ་གྱུར་པ་གང་ཡིན་པ་དེ་ཡང་དག་པར་སྟོན་ཏོ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་སྟོན་པར་འཇུག་པས་གཉིས་སུ་འཇུག་པའོ།",
