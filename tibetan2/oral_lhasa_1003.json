    "འདི་ནི་ལས་ཉིད་ཉེ་བར་མཚོན་པའི་ཕྱིར་ལས་ཀྱི་ཕྱག་རྒྱ་བསྟན་པར་ཟད་ཀྱི།",
    "དེས་ཡན་ལག་དང་བཅས་པའི་སྐུ་ཕྱག་རྒྱ་ཆེན་པོ་ཆ་ལུགས་ཡོངས་སུ་རྫོགས་པའི་ངོ་བོ་ཉིད་ཉེ་བར་སྟོན་ནུས་པར་དོན་གྱིས་ཤེས་པར་བྱའོ།",
    "ལས་དང་བྱེད་པ་པོ་ཐ་མི་དད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེའི་རང་བཞིན་ལྷ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་རྣམ་པར་དག་པའི་མཚན་ཉིད་དང་ལས་ཀྱི་ཕྱག་རྒྱར་གྱུར་པ་ཐ་མི་དད་པའི་ཕྱིར་ན་དེ་སྐད་བརྗོད་དོ།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་རྣམ་པ་གཉིས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་རྣམ་པ་གཉིས་ཏེ་ཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་བཞི་པོ་ལ་སོགས་པར་བསྟན་པ་དེ་དག་ཀྱང་སྤྱིར་རྣམ་པ་གཉིས་སུ་ཤེས་པར་བྱ་སྟེ་ཞེས་པའི་དོན་ཏོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལས་བྱུང་བའི་ལྷ་སྟེ།",
    "དེ་དག་བྱེ་བྲག་དང་ཁྱད་པར་མེད་པར་ཤེས་པ་དེ་ནི་དམ་ཚིག་ཅན་གྱི་སྐྱེ་བོས་བཏགས་པའི་ལྷ་ཞེས་བྱའོ།",
    "གང་ལྷའི་ངོ་བོ་ཉིད་དམ་ཞེས་པ་ནི་དེའི་སྐུ་ཕྱག་རྒྱ་ཆེན་པོ་ཆ་ལུགས་ཡོངས་སུ་རྫོགས་པར་གྱུར་པའི་སྐུའོ།",
    "དེའི་ཆ་ཤས་སུ་བྱེ་བྲག་མེད་པར་ཤེས་པ་ནི།",
    "དང་བྱེ་བྲག་མེད་པར་ཤེས་པ་ནི་ལྷར་བཏགས་པའོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཕྱག་རྒྱ་བསྒོམ་ཞིང་འཆིང་བའི་སྒྲུབ་པ་པོ་དེ་ལ་དེ་ལྟར་བྱིན་གྱིས་རློབ་པར་གསུངས་སོ།",
    "ཡི་གེའི་རང་བཞིན་རྣམས་ལས་རིམ་གྱིས་ལྷའི་སྐུ་རྫོགས་པར་འགྱུར་བར་བསྒོམས་ན།",
    "དངོས་སུ་ལྷར་བརྟགས་པའི་ངོ་བོ་ཉིད་ཁོ་ནར་བྱིན་གྱིས་རློབ་པར་མཛད་པས་ཡི་གེའི་རང་བཞིན་ལ་ལྷའི་ངོ་བོ་ཉིད་ཅེས་བྱ་སྟེ།",
    "དེ་གཉིས་ཀྱང་དོན་ཐ་མི་དད་པར་བལྟའོ།",
    "དེ་བཞིན་དུ་འགྱུར་བ་ཅིས་མངོན་ཞེ་ན་དེ་ལྟར་འགྱུར་བའི་གཏན་ཚིགས་རྒྱུད་གཞན་རྣམ་པར་སྣང་མཛད་ཀྱི་རྒྱུད་ལས་ཀྱང་གསུངས་པ་བདག་ལྷར་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྷའི་རང་བཞིན་དུ་བྱིན་གྱིས་རློབ་པར་འདོད་ན།",
    "ཕྱག་རྒྱའམ་རྣམ་པར་རྟོག་གོ་ཞེས་པ་ནི།",
    "རྒྱུད་དེ་ཉིད་ལས་གསུངས་པ།",
    "རྡོ་རྗེའི་ལུས་སུ་བསྒྲུབ་པར་བྱ།",
    "དེ་བཞིན་དུ་གཞན་ཡང་རྒྱུད་དེ་ཉིད་ལས་གསུངས་པ།",
    "ཡི་གེ་ལ་སོགས་པ་དེ་དག་བསམས་པ་ཙམ་གྱིས་ཇི་ལྟར་འདོད་པ་དེ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་ཞེས་པའི་དོན་ཏོ།",
    "གཏན་ཚིགས་ཀྱི་དོན་འབྱིན་པར་བྱེད་པའི་ཐ་ཚིག་གོ།",
    "འཇིགས་པ་ཆེན་པོ་ལས་སྐྱོབ་པར་བྱེད་པའི་ཕན་གདགས་པའོ།",
    "ཅེས་པ་ནི་གང་འདོད་པའི་དངོས་པོར་གྱུར་པའི་དོན་ཏེ་བསྒྲུབ་ན་འགྲུབ་འགྲུབ་པར་བྱེད་པའི་ཕྱིར་རྒྱས་འདེབས་པ་ཡང་དེ་ལྟར་འདོད་དོ།",
    "དེའི་གཏན་ཚིགས་ཀྱང་རྒྱུད་ལས་གསུངས་པ།",
    "འགལ་བའམ་བཤིགས་པར་མི་ནུས་སོ་ཞེས་གསུངས་སོ།",
    "དེ་བཞིན་དུ་གཞན་དག་ལ་ཡང་ཞེས་པ་ནི་གོང་དུ་བསྟན་པ་དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་རྒྱུད་གསང་བའི་བདག་པོ་ཞེས་པ་ནི།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་དེ་ལ་བོས་པའི་ཚིག་གོ།",
    "འོ་ན་དེ་ལྟར་དེ་བཞིན་དུ་ཕྱག་རྒྱས་འགྲུབ་པར་གསུངས་ན།",
    "དེ་ལྟ་ན་ནི་དེའི་རྗེས་སུ་མཐུན་པར་འཇུག་པའི་གདུལ་བྱ་ཀུན་ཡང་དེ་ལྟ་བུའི་ཡོན་ཏན་དང་ལྡན་པར་འོས་ན་དེ་ལྟར་མ་གྱུར་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱེས་བུའི་སྐལ་བ་ཞེས་པ་ནི་སྐལ་བ་ཡང་གཅིག་ཏུ་ཟད་པ་མ་ཡིན་པས་མི་མཉམ་པར་གསུངས་ཏེ།",
    "རབ་འབྲིང་དང་ཐ་མར་གྱུར་པ་དག་ཡོད་པར་བསྟན་པའོ།",
    "དེ་ཡང་གཅིག་ཏུ་ཟད་པར་བསྟན་པའོ།",
    "མཉམ་པར་གཞག་པ་ཞེས་པ་ནི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་དག་ཀྱང་སྒྲུབ་པ་པོ་ཉིད་ཀྱིས་ཇི་ལྟར་སྒྲུབ་པ་ལ་རག་ལཔར་བསྟན་ཏོ།",
    "ཕྱག་རྒྱའི་ངེས་ཚིག་གཞན་དག་ཀྱང་སྟོན་པར་བྱེད་པས་ན་ཡང་ཞེས་སྨོས་སོ།",
    "མྱ་ངན་ལས་འདས་པར་བཅིངས་པ་ནི་ཉན་ཐོས་ཞི་བའི་མཐར་ལྷུང་བ་རྣམས་ཏེ།",
    "སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པར་བཅིངས་པ་དེ་དག་ལས་གྲོལ་བར་བྱེད་པའོ།",
    "དེ་བས་ན་བདག་ཉིད་ཆེན་པོ་དེས་དེ་རིག་པར་བྱས་ནས་ཞེས་པ་ནི།",
    "དེ་རིག་པར་བྱས་ནས་ཞེས་པ་ནི།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཆེན་པོ་དེ་ལས།",
    "སྒྲུབ་པ་པོ་དེ་བཞིན་དུ་བསྒྲུབས་༩ན་འགྲུབ་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་དེ་དག་བསྒྲུབས་ན་མྱུར་དུ་འགྲུབ་པའི་ཐབས་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་བཞི་བསྟན་ཏེ།",
    "རྒྱུདའི་༥༤༡༣༣༢ཉིད་དེ་བཞིན་ཁོང་དུ་ཆུད་པར་བྱས་ནས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟར་སྒྲུབ་པ་པོ་དེས་གོང་དུ་ཕྱག་རྒྱ་བཞི་ལ་སོགས་པའི་མཚན་མ་ལ་སོགས་པ་བསྟན་པ་དེ་དག་ཁོང་དུ་ཆུད་པར་བྱས་ནས།",
    "སྒྲུབ་པའི་རྣལ་འབྱོར་པ་དེས་གདོན་མི་ཟ་བར་འགྲོ་བ་མང་པོ་རྣམས་ལ་ཕན་གདགས་པར་བྱ་བའི་ཕྱིར།",
    "གང་འདོད་པའིའཕགས་པ་རྣམས་ཀྱི་དངོས་གྲུབ་སྒྲུབ་པར་བྱའོ་སྙམ་པའི་བསམ་པ་འཆང་བར་བྱེད་པའོ།",
    "གོ་འཕང་དམ་པ་འཐོབ་པར་འདོད་པས་ཞེས་པ་ནི།",
    "འགྲོ་བ་མང་པོ་ལ་ཕན་གདགས་པར་བྱའོ་སྙམ་པ་ནི་ཐོབ་པར་འདོད་པའོ།",
    "བཟུང་བའི་ཐབས་ནི་གང་ལ་དད་པའི་ཕྱོགས་ཀྱི་ལྷའི་དཀྱིལ་འཁོར་དུ་མེ་ཏོག་དོར་ནས་གང་ལ་བབས་པའི་ལྷ་དེ་ཉིད་ལྷར་གཟུང་སྟེ་བསྒྲུབ་པར་བྱའོ།",
    "མཉེས་པར་བྱ་བའི་ཡན་ལག་ཅེས་པ་ནི།",
    "བཞིན་དུ་བསྲུང་བར་བྱའོ་ཞེས་པར་བསྟན་ཏོ།",
    "དཀྱིལ་འཁོར་ཆེན་པོ་ཞེས་པ་ནི་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཏེ་སྐུའི་བདག་ཉིད་ཡིན་པས་དེས་ཕྱག་རྒྱ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་པར་གྱུར་པའི་ཕྱིར་ན་དེ་སྐད་ཅེས་བརྗོད་དོ།",
    "དམ་ཚིག་དང་ཞེས་པ་ནི་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་སྟེ།",
    "འདི་ལས་གསུངས་པའི་ཆོ་གའི་རིམ་པས་སྡོམ་པ་གཟུང་བའོ།",
    "ཁྱད་པར་དུ་ཡང་ལེགས་པར་བསྒྲུབ་པའི་རྒྱུད་ཆེན་པོའི་བསྲུང་བར་བྱ་བའི་དམ་ཚིག་རིམ་པར་ཕྱེ་བའི་ལེའུ་ལས་གསུངས་པའོ།",
    "སྤྱོད་པ་ཞེས་པ་ནི་འཇུག་པར་བྱ་བའི་ཐབས་ཏེ།",
    "རྒྱུད་འི་༡༣༣༦བ་རིམ་པར་ཕྱེ་བའོ།",
    "སྤྱོད་ཡུལ་ཞེས་པ་ནི་བསྒྲུབ་པར་བྱ་བའི་གནས་རྣམས་ཏེ།",
    "དེ་ཡང་བྱ་བའི་རྒྱུད་ཆེན་པོ་དེ་ཉིད་ལས་གསུངས་པའོ།",
    "ཆོ་ག་བཞིན་དུ་མཁས་པར་བྱས།",
    "གོམས་པར་བྱས་པའོ།",
    "སྔགས་བཟླས་པ་ལ་སོགས་པ་ལ་དགའ་བར་བྱ་ཞིང་སྒྲིན་པར་བྱ་སྟེ།",
    "ཅིའི་ཕྱིར་ཀློད་པར་མི་བྱ་ཞེ་ན།",
    "བདག་དང་གཞན་གྱི་དོན་མ་ལུས་པར་གྲུབ་པ་ལ་དེ་ཐོག་མར་འགྲོ་བའི་ཕྱིར་རོ་ཞེས་གསུངས་ཏེ།",
    "དམ་ཚིག་ཀྱང་སྐབས་འདིར་ནི་༧འབྲས་བུ་འདོད་པ་རྣམས་ཀྱིས་མི་འདའ་བར་བྱས་པས་ཞེས་པ་ནི།",
    "སོགས་ཀྱི་སྒྲས་དེ་གཉི་གའི་ཕྱོགས་ན་རིགས་མཐུན་པར་གྱུར་པའི་ལས་གཞན་རྣམས་སྡུད་པར་བྱེད་པའོ།",
    "དེ་ལྟར་བྱ་བ་ནི་སྟོན་པས་གསུངས་པའི་ཚུལ་གྱིས་ཁྱད་པར་རོ་ཞེས་བདུད་རྩི་དཔུང་བཟངས་ཀྱི་རྒྱུད་ལས་གསུངས་སོ།",
    "འདིས་ཀུན་རྟོགས་ཤིང་ཆུད་པར་འགྱུར་བས་ན་ཞེས་པ་ནི།",
    "ཁྱད་པར་དུ་འཇུག་པ་ཞེས་པ་ནི།",
    "དེ་ལས་གཞན་པ་ཞེས་པ་ནི་དེ་དང་ཆ་མཐུན་པར་གྱུར་པའི་རྒྱུད་གཞན་ཏེ།",
    "རྒྱུད་༥༤༡༣༣༨བསྡུས་པ་ལ་སོགས་པ་གཞན་དག་སྡུད་པར་བྱེད་དོ།",
    "སྤྱི་དང་ཁྱད་པར་གསུངས་པའི་དམ་ཚིག་སྟེ།",
    "དེ་གཉིས་ལས་རྒྱུད་གཞན་ལས་གསུངས་པ་ཞེས་པ་ནི།",
    "སྦྱོར་བའི་རྒྱུད་ཆེན་པོ་ཐམས་ཅད་ཀྱི་དོན་འདུས་པར་བསྟན་པ་ཡིན་པསདམ་ཚིག་ཐམས་ཅད་ཀྱང་དེར་འདུས་པར་མངོན་ན།",
    "དེ་ཡང་དོན་གྱི་རྗེས་སུ་བརྟགས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་སྟེ་འདི་ལྟར་རྒྱུད་གཞན་ལས་དམ་ཚིག་གསུངས་པ་དེ་ཡང་དོན་གྱི་རྗེས་སུ་བརྟགས་ན།",
    "དི་ཉིད་ཀྱི་ནང་དུ་འདུས་པར་མངོན་ཏེ་ཞེས་པ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རྒྱུད་ལས་གསུངས་པ།",
    "ལྡང་བ་ནི་གནས་པའི་དོན་དེ་ལས་ལངས་ནས་འགྲོ་བའི་དོན་ལ་འཇུག་པར་བྱེད་པ་སྟེ།",
    "ཐ་མི་དད་པས་ནི་དེ་དག་ལ་གནས་པར་བྱ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་བསྟན་པ་ལ་ཞུགས་པའི་བརྟུལ་ཞུགས་གཏང་ནས་གཞན་གྱི་ལྟ་བ་འཛིན་པར་བྱེད་པའམ།",
    "སློབ་དཔོན་སྨད་པར་མི་བྱ་ཞིང་།་",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་རྣམས་ནི་སློབ་དཔོན་ལ་རྒྭསྨོད་པར་བྱེད་པའི་སྐྱོན་བསྟན་པའོ་། དུག་དང་དབྱིག་དུག་ཅེས་པ་ལ།",
    "སྐྱོན་དུ་གཟུང་བ་དག་ཡོད་པ་དག་ནི་སྦ་ཞིང་བཅབ་པར་བྱ་བ་ཡིན་པ་ལས་དེ་ལས་བཟློག་པ་ལ་ནི་མི་སྤྱོམས་པ་ཞེས་བྱའོ།",
    "འོན་ཀྱང་དེ་དག་ཐམས་ཅད་ནི་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་དེའི་རང་བཞིན་དང་ཁྱད་པར་ལས་དེ་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "འགྱུར་བ་ཅན་དུ་གྱུར་པའི་ངོ་བོ་བས་ཕལ་གྱིས་གོ་ཞིང་དཔགས་པར་དཀའ་བའི་མཚན་ཉིད་དང་ལྡན་པ་སྟེ།",
    "དཔལ་མཆོག་དང་པོ་ལས་ཀྱང་གསུངས་པ།",
    "དེའི་རྣམ་པར་སྨིན་པ་ཉམས་སུ་མྱོང་བའི་སྡུག་བསྔལ་བཟོད་པར་དཀའ་བ་ཉམས་སུ་མྱོང་བ་ཆེན་པོ་སྟེ།",
    "ཇི་ལྟར་འདོད་པས་དེ་བཞིན་དུ་སྤྱད་ནས་འདི་ལྟར་བྱ་བར་གསུངས་ཏེ་གང་ཞེ་ན།",
    "དེའི་ལོངས་སྤྱོད་ནི་རྣམ་པ་བཞི་སྟེ་འོག་ནས་གསུངས་སོ།",
    "ཇི་ལྟར་གར་མཁན་གྱིས་གར་བསྒྱུར་བའི་མཚན་ཉིད་ཅི་ལ་ཡང་ཐོགས་པ་མེད་པ་བཞིན་དུ་བདག་གཞན་གྱི་དོན་བརྒྱ་ལྷག་ཕྲད་པར་མཛད་པའི་མཚན་ཉིད་རྡོ་རྗེ་གར་རྣམས་སོ།",
    "དེ་ལྟ་ན་ནི་འདོད་ཆགས་དང་བྲལ་བ་གཞན་གྱིས་དཔྱས་འདོགས་ཤིང་ཉིད་ཀྱིས་གསུངས་པའི་དོན་དང་ཡང་འགལ་བར་འགྱུར་རོ་ཞེ་ན་སྨྲས་པ།",
    "འགྲོ་བ་ཀུན་གྱི་སྒྲ་རྣམས་ཇི་བཞིན་པར།",
    "དེ་བཞིན་དུ་འགྲུབ་པར་གསུངས་སོ།",
    "དེ་ལ་དང་པོ་སྐུའི་གསང་བའི་མཚན་ཉིད་གསུངས་པ།",
    "སྣ་ཚོགས་པ་མངའ་ཞིང་རྒྱ་ཆེ་བ་དག་སྟོན་པར་མཛད་པའོ།",
    "སེང་གེ་ལ་སོགས་པའི་གདན་ལ་བཞུགས་པའོ།",
    "སྣ་ཚོགས་པའི་ཚུལ་དུ་བཞུགས་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེདེ་ལྟ་བུར་གཟུགས་གཅིག་ལས་དངོས་པོ་གཞན་དང་གཞན་དུ་སྟོན་པར་མཛད་པ་འདི་ནི་སྐུའི་གསང་བའོ།",
    "བདག་ལ་གསལ་གྱི་གཞན་གྱིས་མི་ཐོས་པར་བརྗོད་པ་སྟེ།",
    "ད་ནི་ཐུགས་ཀྱི་གསང་བའི་མཚན་ཉིད་གསུངས་པ།",
    "རྣམ་གཅིག་གསུམ་ཆར་ཚང་བའི་མཚན་ཉིད་དང་ལྡན་པར་བསྟན་པའོ།",
    "འོ་ན་དོན་དེ་ལྟ་བུ་དག་ཚུལ་ཇི་ལྟར་བསྒྲུབ་པར་བྱ་སྟེ།",
    "དེ་ལྟར་བསྟན་པའི་དོན་དེ་དུས་རྟག་ཏུ་ཡང་དང་ཡང་དུ་བསྒོམས་ན་འགྲུབ་པར་བསྟན་པ་སྟེ།",
    "ཅུང་ཟད་ཙམ་གྱིས་མི་འགྲུབ་པར་བསྟན་ཏོ།",
    "གསུམ་གྱི་སྦྱོར་བས་འགྲུབ་པར་འགྱུར་ཏེ་ཞེས་པ་ནི།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་སྦྱོར་བ་དེའི་ཚུལ་དུ་བསྒོམས་པ་ཁོ་ནས་འགྲུབ་པར་བསྟན་པ་སྟེཐབས་གཞན་གྱི་ཚུལ་དུ་བསྒྲུབ་པ་དགག་པའོ།",
    "གཞན་དུ་མ་ཡིན་ཀུན་མཁྱེན་གསུངས།",
    "དེ་ཁོ་ན་ལྟར་བྱའི་དེ་ལས་གཞན་དུ་བྱས་ན་མི་འགྲུབ་ཀྱི་འདི་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ་ཞེས་ཡིད་ཆེས་པའི་ཁུངས་བསྟན་པའོ།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་ལ་སོགས་པ་བཞིར་བསྟན་པ་དེ་དག་རྒྱུ་འབྲས་བུ་བཅས་པ་ཐམས་ཅད་གསང་བ་གསུམ་པོ་དེར་འདུས་པར་བསྟན་ཏོ།",
    "མནོས་ནས་ཉམས་པར་བྱས་པའོ།",
    "དེ་ལྟར་ཉམས་པར་བྱས་མ་ཐག་ཏུ་བྱིན་གྱིས་རློབ་པར་མི་མཛད་པའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གསུངས་སོ།",
    "འོན་ཏེ་གཞན་དག་ལ་བསྟན་པར་བྱ་བའི་སྣོད་ཀྱང་ཡོད་ཅེ་ན་སྨྲས་པ།",
    "ཐད་ཀར་སྦ་བར་བྱ་བ་ཡང་མ་ཡིན་གྱི་བསྟན་པར་སྣང་བའི་སྣོད་གསུངས་པ།",
    "གང་ཞིག་གང་ཡང་རུང་བ་དག་ཞུགས་པར་གྱུར་པ་སློབ་དཔོན་ལ་སྒྲིབ་པར་མི་འགྱུར་ཞིང་ཞུགས་པ་དེ་ཡང་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དགའ་བ་རྣམ་པ་གཉིས་དང་ལྡན་པར་འགྱུར་བས་མཚན་དགའ་བ་ཆེན་པོ་ཞེས་བརྗོད་དོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་དམ་ཚིག་ལ་གནས་པ་ནི་ཞེས་པ་ནི་གོང་དུ་བསྟན་པའི་དོན་དེ་ཁོ་ན་དང་ལྡན་པའོ།",
    "འཇིག་རྟེན་པའི་ལམ་སྒྲུབ་པས་བདག་ཅེས་བྱ་བའི་རྫས་ཅན་ཁ་ལོ་སྒྱུར་བའི་བྱེད་པ་པོར་ལྟ་བ་དེ་དག་པར་འདོད་པའི་ཕྱིར་ཁྲུས་བྱེད་པ་དང་།",
    "དེ་ལྟར་ཡང་རྟོག་པ་བསྡུས་པ་ལས་གསུངས་པ།",
    "བསྡམ་དང་གཙང་སྦྲ་འདིར་མི་དགོས།",
    "བདག་ཏུ་སྦྱོར་བས་འགྲུབ་པར་འགྱུར།",
    "དེས་འགྲུབ་པར་འགྱུར་ཞེས་གསུངས་སོ།",
    "ཡང་རྟོག་པ་ཐམས་ཅད་བསྡུས་པ་ཉིད་ལས་འདི་སྐད་གསུངས་ཏེ།",
    "འཁོར་ལོ་དང་རྡོ་རྗེ་དང་པདྨ་དང་སོགས་ཀྱི་སྒྲས་དེ་ལས་གཞན་པ་དབྱིབས་གང་ཡང་རུང་བར་བྱས་པའི་ཕྱག་རྒྱའི་དབྱིབས་དང་མཚན་མར་བྱས་པ་དག་མི་བགོམ་པ་དང་།",
    "བཅའ་བའི་རྣམ་པ་ལས་བྱས་པའི་གཟུགས་བརྙན་མཐོང་ན་མི་བཟའ་བ་དང་།",
    "རྐང་པས་འགོམ་པར་བྱ་བ་དང་།",
    "འོ་ན་དེ་དག་དེ་ལྟར་བསྲུང་བ་ཡིན་ནམ་འོན་ཏེ་གནང་བའི་དབྱེ་བས་ཡང་ཡོད་ཅེ་ན།",
    "རྒྱུད་༥༤རྗོད་པར་བྱེད་པ་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་རྣལ་འབྱོར་ལ་གནས་པའི་སྒྲུབ་པ་པོ་དག་ནི་གནང་སྟེ།",
    "དེ་ལྟར་ཡང་གཏན་ཚིགས་རྒྱུད་ལས་གསུངས་པ།",
    "ངེས་པར་དམ་ཚིག་ཉམས་པར་འགྱུར་། ཞེས་གསུངས་ཏེ།",
    "འགོམས་པར་གྱུར་ན་དམ་ཚིག་ཉམས་པར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "ནན་ཏན་གྱིས་རྡོ་རྗེ་ཤུགས་དང་ལྡན་པར་བྱའོ།",
    "བརྟག་པར་བྱ་ཞེས་པ་ནི།",
    "ཤེས་རབ་ཅན་གྱིས་བསྲུང་དགོས་པར་བསྟན་ཏོ།",
    "ཁྱད་པར་དུ་ནི་དཀྱིལ་འཁོར་དུའོ་ཞེས་པ་ནི།",
    "དཀྱིལ་འཁོར་དུ་འཇུག་པའི་ཚེ་ལྷའི་མཚན་མ་ལ་མི་འགོམ་པའི་ཕྱིར་ཁྱད་པར་དུ་ཡང་རྡོ་རྗེ་ཤུགས་ཀྱི་སྔགས་དང་།",
    "ཕྱག་རྒྱར་ལྡན་པར་བྱ་དགོས་པར་བསྟན་ཏོ།",
    "བགོམ་༧པ་བྱས་ཀྱང་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "གོང་དུ་ཤུགས་ཞེས་བྱ་བའི་སྒྲར་བརྗོད་པ་བཞིན་དུ་ཕྱག་རྒྱའི་རྣལ་འབྱོར་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ལྔ་དང་ཡེ་ཤེས་ཀྱི་སེམས་དཔའ་ཆེན་པོ་རྣམས་ལས་གང་ཡང་རུང་བ་གཅིག་རྣལ་འབྱོར་དུ་བྱས་ནས་ལྷ་ཐམས་ཅད་ཀྱང་རྣལ་འབྱོར་དུ་བྱས་པར་འགྱུར་བས་ན།",
    "ཅེས་པ་ནི་དེ་བས་ལྷའི་རྣལ་འབྱོར་འདི་ནི་རབ་ཏུ་བརྟག་པར་བྱ་སྟེ།",
    "མཚན་མ་ལ་སོགས་པ་དེ་ཁོ་ན་ཉིད་ཀྱི་སྤྲུལ་པ་ཡིན་པར་མི་ཤེས་པ་རྣམས་ལ་གསང་བར་གསུངས་སོ།",
    "རྣལ་འབྱོར་ཞེས་བརྗོད་པའི་སྒྲས་དེ་ཡང་དངོས་པོ་དེ་ལྟར་བསྟན་པ་དེ་ཁོ་ན་ཡིན་པར་འདོད་དེ།",
    "ཕྱག་རྒྱ་བཞིའི་རང་བཞིན་དུ་བདག་སྦྱོར་བ་བྱས་པའོ།",
    "ཞེས་པ་ནི་བདག་ཉིད་ནི་བདག་ཉིད་དམ་ཚིག་སེམས་དཔར་བསྒོམས་པ་ལ་བྱའོ།",
    "ཡེ་ཤེས་སེམས་དཔའ་དེ་གཞུག་པར་བྱའོ།",
    "བཅུག་ནས་གཉིས་སུ་མེད་པར་བྱས་ལ་དེའི་རྗེས་སུ་བསྒྲུབ་པ་སྟེ།",
    "དེ་ཡང་གཞུག་པའི་ཐབས་ནི་ལྕགས་ཀྱུ་ལ་སོགས་པའི་ཕྱག་རྒྱ་དང་སྔགས་སུ་ལྡན་པའི་ཆོ་གའི་རིམ་པས་བྱ་བར་གསུངས་སོ།",
    "སྦྱོར་བའི་རྒྱུད་གཞན་ལས་ཀྱང་གསུངས་པ།",
    "རྡོ་རྗེ་སེམས་དཔར་བདག་སྦྱོར་བ།",
    "ཞེས་གསུངས་པ་ནི།",
    "ལྷ་གང་དང་གང་བསྒྲུབ་པར་འདོད་པ་དེ་ཉིད་ཀྱི་ཕྱག་རྒྱ་གང་དང་གང་ཡིན་པ་བཅིངས་ཤིང་བསྒོམས་ན།",
    "ལྷ་གང་གྲངས་མེད་ཅིང་བརྗོད་ཀྱིས་མི་ལང་བ་དག་ཡོད་ན་དེ་དག་ཀུན་གྱི་དམ་ཚིག་བརྗོད་ན་ནི་ཇི་སྲིད་འཚོ་བའི་བར་དུ་བརྗོད་པས་ཀྱང་མི་རྫོགས་པར་འགྱུར་ལ།",
    "གལ་ཏེ་འགའ་ཙམ་ཁོ་ནའི་བརྗོད་ན་ནི་དེའི་སྒྲ་ཡང་པར་འགྱུར་ན།",
    "འདི་ལྟར་བརྗོད་པ་ཇི་ལྟར་སྟོན་པར་བྱེད་ཅེ་ན།",
    "གཞུང་འདི་ལྟར་ལྷ་སོ་སོར་ངེས་པའི་དམ་ཚིག་བསྟན་པས་ན།",
    "དམ་ཚིག་ཀྱང་རྣམ་པ་ལྔར་གསུངས་སོ་ཞེས་བརྗོད་དོ།",
    "ལྷ་ཇི་སྙེད་པོ་དག་ཀྱང་གྲངས་འདི་ལྟར་ངེས་པ་དམ་ཚིག་ཀྱང་འདིར་བཞིན་དུ་གསུངས་སོ།",
    "འོ་ན་འདིར་དམ་ཚིག་ལྔར་བསྟན་པ་འདི་ལྷ་ཡང་དེ་ལྟར་ཤེས་པར་བྱ་བ་ཡིན་ནམ་ཞེ་ན།",
    "བར་གཤེགས་པ་ལྔ་གཅིག་ཏུ་བསྡུས་པའི་བདག་ཉིད་དེ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དོ།",
    "འོ་ན་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ལ་རིགས་ལྔར་འདོད་པ་དེ་དག་དང་མི་མཐུན་པར་སྟོན་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེ་བཞིན་གཤེགས་པ་ལྔ་རྣམས་གཅིག་ཏུ་གྱུར་པ་ཞེས་པ་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་གཉིས་མི་མཐུན་པར་སྟོན་པ་འགལ་བས་སྐྱོན་དུ་འགྱུར་རོ་ཞེ་ན།",
    "འོ་ན་དེ་དག་དེ་ལྟར་ངེས་པར་བརྟག་གམ་འོན་ཏེ་གཞན་དུ་འགྱུར་ཞེ་ན་སྨྲས་པ།",
    "ཕྱི་མའང་དེ་བཞིན་དུ་འགྱུར་བར་ཤེས་པར་བྱ་སྟེ།",
    "འདི་དག་ནི་རྡོ་རྗེའི་རིགས་སུ་གསུངས་པའོ།",
    "པདྨའི་རིགས་སུ་བཞི་གསུངས་པ་ལ།",
    "སྣང་བ་མཐའ་ཡས་ཀྱི་གནས་ན་པདྨོའི་ཏིང་ངེ་འཛིན་ཞེས་བྱ་བ་བཞུགས་ནས།",
    "སྣ་ཚོགས་ཀྱི་པདྨ་ཞེས་པ་ནི་གདོན་མི་ཟ་བར་གྲུབ་པའི་གནས་ན་སྣ་ཚོགས་ཀྱི་པདྨའི་མདུང་རྩེ་ཞེས་བྱ་བ་འདི་བཞུགས་ཏེ།",
    "སྒོ་གསུམ་གྱི་སྤྱོད་པ་སྦྱིན་པ་ལ་སོགས་པ་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་དུ་སྤྱོད་པར་མཛད་པའོ།",
    "གདོན་མི་ཟ་བར་གྲུབ་པའི་གནས་ན་རིན་ཆེན་འབབ་པ་ཞེས་བྱ་བ་བཞུགས་ནས་དགོས་པ་ཐམས་ཅད་འབེབས་པར་བྱེད་པའོ།",
    "འོ་ན་ཅིའི་ཕྱིར་དེར་འདུས་པར་སྟོན་ཞེ་ན།",
    "འོ་ན་གོང་དུ་རིགས་ཀྱི་དབྱེ་བ་རྒྱས་པར་བསྟན་ཟིན་ན།",
    "རྡོ་རྗེའི་རིགས་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་སུ་འདུས་པར་བསྟན་པ་ནི་རིགས་བཞིར་བརྗོད་དོ།",
