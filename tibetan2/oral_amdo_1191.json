    "འདི་ན་སོར་མོའི་འདུ་འགོད་བགྱིས་པ་ཡིན།",
    "རྒྱལ་བའི་བཀའ་དང་ཚད་ལྡན་མཁས་པའི་གཞུང་བཞིན་འཁྲིད་པའི་མིག་བུ་དང་བྲལ་རང་བཟོའི་ཚང་ཚིང་སྡུག་པོའི་ཁྲོད་དུ་རིངས་པར་འཁྲུངས་པའི་རང་འདོད་གླེགས་བམ་རིང་པོའི་འཁར་བ་འཁྱོག་པོ་ལ་བརྟེན་ཐེ་ཚོམ་ཅན་གྱི་ལམ་དུ་གོམ་པ་གྱ་ཚོམས་འདོར་བ་འཛེམས་མེད་པ་།",
    "འདི་འདྲའི་རིང་ལུགས་ལྟོ་འཕྱེ་ནག་པོའི་གཟུགས་ཀྱིས་ཁ་བའི་རིང་ལྗོངས་ཁྱབ་ཅིང་འཁྱོག་པོའི་འགྲོས་ཀྱིས་གཞུང་ཆེན་མང་པོའི་ནམ་མཁའ་མ་སྒྲོད་རང་བཟོར་སྨྲ་བའི་སེང་གེའི་མགོ་ན་ལྟག་ཆོད་མགྲིན་པ་ཆེར་བཏེགས་པས།",
    "ཐལ་རང་ཉི་ཟླའི་འགྲོས་གཉིས་ཧྲིལ་པོར་ཟོས་ན་ཟབ་མོའི་གཞུང་ཆེན་ཀུན་ཀྱང་མོག་པོར་བྱས་པའི་ནག་པོའི་མདངས་ཀྱིས་ས་ཆེན་འདི་ཁྱབ་རྟག་ཏུ་རློམ་པའི་འོད་ཀྱིས་ཁེངས་པའི་རྒྱུ་སྐར་ཚོགས་རྣམས་རྣམ་པར་བཀྲའདི་དག་རྣམས་ཀྱི་རང་མཚང་སྟོན་བྱེད་རིགས་པའི་རྩེ་བརྒྱ་གདེངས་པའི་ཚངས་པའི་འཁོར་ལོ་འདི་ཡིས་ལྟོས་འགྲོ་ནག་པོའི་མགྲིན་པ་དྲལ་ནས་ཐལ་རང་ཉི་ཟླའི་འགྲོས་ཀྱིས་ཐུབ་བསྟན་གླིང་བཞི་རྟག་པརགསལ་གྱུར་ཅིག།",
    "གུས་པའི་ཐལ་མོ་ཅི་ཡང་སྦྱོར་བྱེད་ཅིང་།",
    "བློ་གསལ་མང་པོའི་རེ་བ་སྐོང་བར་ཤོག།",
    "ན་མོ་མཉྫུ་ཤྲཱི་ཡེ།",
    "རང་རིག་མངོན་སུམ་མོ།",
    "རང་གི་རྟེན་དཔེ་ཁོ་ན་ལ་བརྟེན་པ་ཡིན་གྱི་སྒྲུབ་བྱེད་ཀྱི་གཏན་ཚིགས་ལ་བརྟེན་པ་མ་ཡིན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ན་གྲགས་པའི་ལུང་གིས་ཤིན་ལྐོག་མི་སྒྲུབ་པའི་ཕྱིར།",
    "ཤེས་བརྗོད་ཀྱི་ཡུལ་དུ་སོང་བའི་ཆ་ནས་ཀུན་རྫོབ་དང་།",
    "འདི་ནི་རྗེས་དཔག་གི་ནང་དུ་འདུས་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་རུང་ན་ཉེས་པ་སྔ་མ་དེ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "དོན་དམ་པའི་བདེན་པ་ཡིན་ན་སྒྲ་རྟོག་གི་ཡུལ་ལས་འདས་པ་ཡིན་པས་ཁྱབ་གང་སྒྲ་རྟོག་གིས་བཟུང་བྱ་ཡིན་ན་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡིན་པས་ཁྱབ་པ་ཡིན་ནོ།",
    "ཁྱོད་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡིན་པའི་ཕྱིར།",
    "ཁྱོད་ཀུན་རྫོབ་བདེན་པ་ཡིན་པའི་ཕྱིར་ཞེས་པ་ལ་ལན་ཇི་ལྟར་འདེབས་ཞེ་ན།",
    "ཀུན་ལ་ཐུན་མོང་དུ་གྲགས་པ་དེ་ཉིད་ཡིན་ལ།",
    "རང་གིས་ཁས་ལེན་པ་ནི་མ་ཡིན་ཏེ།",
    "བདེན་པར་མེད་པ་ཡིན་པར་ཐལ།",
    "བདེན་མེད་སྒྲུབ་པར་སོང་བའི་ཕྱིར།",
    "དེ་ཡང་དངོས་པོར་སྨྲ་བ་ཁྱོད་ཀྱིས་མ་གོ་བ་ཡིན་ཏེ།",
    "རྟགས་བསལ་ལ་ལན་མི་འདེབས་མོད།",
    "བཏབ་ཀྱང་དངོས་འགལ་དུ་སོང་བ་མ་ཡིན་ཏེ།",
    "ཐེ་ཚོམ་ཟ་བའི་སྒོས་རྟགས་མ་གྲུབ་པ་ནི་གཞུང་གི་སྐབས་དེ་ཉིད་དུ་གསལ་བའི་ཕྱིར་རོ།",
    "ཁྱབ་པ་ཁྱོད་ཀྱི་བློ་ངོར་གྲུབ་པ་ཡིན་ཏེ།",
    "སྤྲོས་པ་ལས་མ་འདས་པའི་ཕྱིར་དེ་ཡང་ཁྱོད་ཀྱི་བློ་ངོར་གྲུབ་པ་ཡིན་ནོ།",
    "དངོས་ཀྱི་འགལ་ཟླ་བཀག་པ་ན་དེའི་དངོས་ཀྱི་ལོག་ཕྱོགས་ཁས་ལེན་དགོས་སོ་ཞེས་ཟེར་བ་ནི་དངོས་པོར་སྨྲ་བའི་རྟོག་གེ་པ་དག་གི་ལུགས་ཡིན་གྱི་ལུགས་འདི་ལ་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "བདེན་སྟོང་དུ་ཐལ་བ་ལ་འདོད་ལན་འདེབས་པ་དང་།",
    "བདེན་སྟོང་ཡིན་པའི་ཕྱིར་ལ་རྟགས་མ་གྲུབ་ཀྱི་ལན་འདེབས་པ་འདི་ནི་ཅུད་ཟད་ཞིབ་མོའི་རྣམ་གཞག་ཡིན་ལ།",
    "དངོས་འགལ་ནི་ཁས་བླངས་པ་ལས་འབྱུང་གི་ཁོ་བོ་ཅག་ནི་དོན་གང་ལ་རྟགས་མ་གྲུབ་ཀྱི་ལན་བཏབ་ཀྱང་ཕྱོགས་གཞན་དེ་བཀག་པ་ཡིན་གྱི་དེའི་འགལ་ཟླ་ཁས་བླངས་པ་མེད་པའི་ཕྱིར།",
    "དཔེར་ན་ཡོད་པའི་ཕྱིར་ལ་རྟགས་མ་གྲུབ་ཀྱི་ལན་བཏབ་པ་ན་ཡོད་པ་ཙམ་བཀག་གི་ཡོད་པ་མ་ཡིན་པར་ཁས་མ་བླངས།",
    "འོ་ན་རྟགས་དེ་གཉིས་ལ་རྟགས་མ་གྲུབ་ཀྱི་ལན་འདེབས་པ་ཡང་མི་རིགས་པར་ཐལ།",
    "འོ་ན་སྔ་མ་ལ་འདོད་ལན་འདེབས་པ་ཡང་མི་འཐད་པར་ཐལའདོད་ལན་བཏབ་པའི་ཚེ་ན་ཁས་བླངས་གཅིག་བྱུང་བའི་ཕྱིར་ཞེ་ན།",
    "འོ་ན་མྱུ་གུ་མེད་པ་ཙམ་ཞིག་དགག་པར་འདོད་ནས་ཡོད་པར་ཐལ་བ་ལ་འདོད་ལན་བཏབ་ཀྱང་ཉེས་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དགག་པ་གཞིར་བྱས་པ་ལ་མ་ཡིན་པར་དགག་པ་དང་མེད་པར་དགག་པ་གཉིས་སུ་དབྱེ་བ་རྒོལ་བའི་བསམ་ངོ་དང་རྟོག་གེའི་ལུགས་ལ་གྲགས་པ་ཡིན་གྱིསྒྲུབ་པ་ལ་གཉིས་སུ་འབྱེད་པ་དེ་དེ་དག་གང་གི་ཡང་ལུགས་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "སོ་སོ་རང་གི་རིག་པའི་ཡེ་ཤེས་ཀྱིས་ཉམས་སུ་མྱོང་བའི་ཆ་ཡིན་པའི་ཕྱིར་དང་།",
    "རང་གི་ས་རང་མ་རིག་པའི་ཤེས་པ་འགའ་ཡང་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "སྣང་མཁན་རང་གི་སེམས་རྒྱུད་ཀྱིས་བསྡུས་པའི་ཕྱིར་ཏེ།",
    "སྙད་དུ་ཡང་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "ཡེ་ཤེས་དེའི་རང་སྣང་ལ་ཤེས་བྱ་གང་གི་ཡང་སྣང་བ་མི་འཆར་བའི་ཕྱིར་དང་།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པའི་མཚན་ཉིད་ནི།",
    "དེ་དང་མཚུངས་པར་ལྡན་པའི་ཆགས་སོགས་ཉོན་མོངས་པ་རྣམས་དང་།",
    "དེ་དག་གིས་ཀུན་ནས་བསླང་བའི་ལས་དང་།",
    "དེ་གཉིས་ཀྱི་རྣམ་སྨིན་དུ་གྱུར་པའི་སྡུག་བསྔལ་གྱི་ཕུང་པོ་རྣམས་ཀྱང་ཉོན་མོངས་པ་མ་ཡིན་ཀྱང་དེའི་སྒྲིབ་པར་བཞག་པ་ཡིན་ཏེ།",
    "གོང་གི་མཚན་ཉིད་དེ་ཚང་བའི་ཕྱིར།",
    "ཉོན་མོངས་པ་དེ་དག་གི་བག་ཆགས་ལ་ནི་གཉིས་ཏེ།",
    "ཉོན་མོངས་པའི་ས་བོན་དང་དེས་བཞག་པའི་གནས་ངན་ལེན་ཉོན་མོངས་སྤངས་པའི་གང་ཟག་གི་རྒྱུད་ལ་འང་ཡོད་པའོ།",
    "དང་པོ་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པ་ཁོ་ན་ཡིན་ལ།",
    "སོ་སོ་སྐྱེ་བོའི་རྒྱུད་ཀྱི་གཉིས་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པར་ངེས་ཏེ།",
    "བྱེ་བྲག་ཉོན་མོངས་པ་ཅན་གྱི་མ་རིག་པར་བཞག་དགོས་པ་ཡིན་ཏེ།",
    "ཡང་སྲིད་འཕེན་འགྲུབ་ཀྱི་ལས་འགའ་ཞིག་གི་དུས་ཀྱི་ཀུན་སློང་ཡིན་སྲིད་པའི་ཕྱིར།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་དང་མཚུངས་ལྡན་དུ་བྱུང་བ་དེའི་ཚེ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་མ་རིག་པ་ཡིན་ཀྱང་འདི་ཉོན་མོངས་པའི་སྒྲིབ་པར་གྱུར་པའི་མ་རིག་པ་དེར་མི་འཇོག་སྟེ།",
    "སྲིད་པའི་ཡན་ལག་གིས་བསྡུས་པའི་མ་རིག་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཉོན་མོངས་སྒྲིབ་པ་སྤོང་བྱེད་ཀྱི་གཉེན་པོ་དངོས་ནི།",
    "གང་ཟག་གི་བདག་མེད་མངོན་སུམ་དུ་རྟོགས་པའི་ཡེ་ཤེས་སོ།",
    "ཡང་གང་ཟག་གི་བདག་མེད་མངོན་སུམ་དུ་རྟོགས་པ་ལ་ཕྱི་རོལ་གྱི་ཡུལ་བདེན་མེད་དུ་རྟོགས་པ་སྔོན་དུ་འགྲོ་མི་དགོས་ཀྱང་།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་སྤོང་བ་ལ་བདེན་མེད་དུ་རྟོགས་པ་སྔོན་དུ་འགྲོ་དགོས་ཏེ།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་མ་ལུས་པར་སྤངས་ཟིན་པའི་ཕྱིར།",
    "མ་དག་ས་བདུན་དུ་ཉོན་མོངས་སྤོང་བ་དེ་ཡང་ཉོན་ཡིད་འཁོར་གྱི་ཉོན་མོངས་སམ།",
    "ཉོན་མོངས་པའི་ས་བོན་སྤོང་བ་ཡིན་གྱི་ཡིད་ཤེས་འཁོར་གྱི་ཉོན་མོངས་སྤོང་དགོས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་མོད་ཀྱི་སྐབས་དེར་བདེན་འཛིན་སྤངས་ཟིན་པ་ནི་མ་ཡིན་ཏེ།",
    "མཚན་འཛིན་རང་གི་ངང་གིས་འབྱུང་ན་སློང་དགོས་པའི་དོན་མེད་པའི་ཕྱིར།",
    "ཐེག་ཆེན་མཐོང་སྤངས་སུ་གྱུར་པའི་བདེན་འཛིན་ལ་གཉིས་ཏེ་ཉོན་མོངས་པ་ཅན་ཡིན་པ་དང་མ་ཡིན་པའོ།",
    "ཡིད་ཤེས་འཁོར་དུ་བྱུང་བའི་ཆགས་སོགས་ཉོན་མོངས་པ་དང་མཚུངས་པར་ལྡན་པའི་རང་རྒྱུད་ཀྱི་ཕུང་པོ་ལ་བདེན་པར་འཛིན་པའི་བློའོ་།",
    "དེའི་གཉེན་པོར་གང་ཟག་གི་བདག་མེད་ཁོ་ན་ཆེད་དུ་གཉེར་ནས་སྒོམ་ཞིང་།",
    "དེ་ཡང་ཐེག་དམན་གྱི་སྦྱོར་ལམ་དུ་ཉོན་མོངས་པ་ཅན་གྱི་མ་རིག་པའི་གཉེན་པོར་གང་ཟག་གི་བདག་མེད་ཆེད་དུ་གཉེར་ནས་སྒོམས་པ་ལས་མཐོང་ལམ་དུ་དེ་མངོན་སུམ་དུ་མཐོང་བ་བྱུང་།",
    "མཐོང་སྤངས་སུ་གྱུར་པའི་ཤེས་སྒྲིབ་ནི་མི་སྲིད་པར་ཁྱེད་ཅག་གིས་ཁས་བླངས་པའི་ཕྱིར།",
    "ཐེག་ཆེན་གྱི་མཐོང་ལམ་ནས་ཡང་སྲིད་འཕེན་འགྲུབ་ཀྱིས་ལས་དང་ཉོན་མོངས་གཉིས་ཀ་སྤངས་ཟིན་པའི་ཕྱིར།",
    "ཉོན་མོངས་པ་ཅན་དང་།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་དང་མཚུངས་པར་ལྡན་པའི་ཕྱི་རོལ་ཡུལ་ལ་བདེན་པར་འཛིན་པ་རྣམས་སོ།",
    "སོ་སོ་སྐྱེ་བོའི་འཕགས་པ་གང་གི་རྒྱུད་ལ་ཡོད་ན་འང་རུང་།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་དང་མཚུངས་པར་མི་ལྡན་པའི་བདེན་འཛིན་མཐའ་དག་གོ།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་དང་མཚུངས་པར་ལྡན་པའི་བདེན་འཛིན་ཀུན་བཏགས་རྣམས་སོ།",
    "གཉིས་པ་ནི་དེ་དང་མཚུངས་པར་མི་ལྡན་པའི་བུམ་སོགས་ལ་མཚན་མར་འཛིན་པའི་བློ་ཙམ་མོ།",
    "མ་དག་པའི་གནས་སྐབས་ཀྱི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་འཁོར་དང་བཅས་པའོ།",
    "སོ་སོ་སྐྱེ་བོའི་རྒྱུད་ཀྱི་བདེན་འཛིན་མཐའ་དག་ཆགས་སོགས་ཉོན་མོངས་པ་དང་མཚུངས་ལྡན་དུ་འབྱུང་དུ་རུང་བས་ཉོན་མོངས་པ་ཅན་གྱི་མ་རིག་པ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པར་བཞག་ལདེ་ལའང་ཀུན་བཏགས་དང་ལྷག་སྐྱེས་ཀྱི་དབྱེ་བས་ཐེག་དམན་གྱི་མཐོང་སྤངས་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མཚན་འཛིན་ཡིན་པའི་ཕྱིར།",
    "ཅེས་པའི་གཞུང་གིས་བསྟན་པའི་རྟོག་པ་དེ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་དང་བྲལ་བའི་མཚན་འཛིན་ཙམ་མོ།",
    "གང་དེའི་གཞུང་གི་དཀའ་བའི་གནས།",
    "ཐ་སྙད་དུ་ཡང་ཕྱི་རོལ་གྱི་དོན་མེད་ཅིང་གཟུང་འཛིན་གཉིས་སྣང་གི་ཤེས་པ་ཐ་སྙད་དུ་ཡོད་པ་དང་།",
    "དེ་ལ་མིང་གི་རྣམ་གྲངས་ནི།",
    "དོན་དམ་པའི་བདེན་པ་འཇོག་པའི་ཚེདོན་སྣང་གི་ཤེས་པ་ཁས་བླངས་པསའཕགས་པའི་བདེན་པ་ལས་ཉམས་པའི་ཕྱིར་རོ།",
    "འོ་ན་འཇིག་རྟེན་གྱི་ཐ་སྙད་བདེན་པ་འཇོག་པའི་ཚེཕྱི་རོལ་གྱི་དོན་དང་དོན་སྣང་གི་ཤེས་པ་གཉིས་ཀ་ཁས་ལེན་དགོས་ན།",
    "གཞན་དུ་འཕགས་པའི་ཐ་སྙད་དུ་ཕྱི་རོལ་གྱི་དོན་ཡོད་པར་སྒྲུབ་ན་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་བསྟན་བཅོས་ལ་གྲགས་པའི་རིགས་པས་འཇོག་པར་ཐལ་བ་དང་།",
    "འོ་ན་སེམས་ཙམ་པ་ན་རེ།",
    "ཐ་སྙད་དུ་ཡང་ཕྱི་རོལ་གྱི་དོན་མེད་པསདེ་ལྟོས་པའི་དོན་སྣང་གི་ཤེས་པ་མེད་པར་རིགས་སུ་ཆུག་ཀྱང་།",
    "ཁྱོད་ཀྱིས་གཟུང་འཛིན་གཉིས་སྟོང་གི་སེམས་གསལ་རིག་དེ་ཡོད་པར་ཁས་ལེན་པ་མི་རིགས་ཏེ།",
    "རང་གིས་རང་ཉིད་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "ཁྱོད་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་གྲུབ་ཐ་སྙད་བདེན་པ་དངོས་པོ་སྟོབས་ཞུགས་ཀྱི་རིགས་པས་དཔྱད་ནས་པར་སྨྲ་བ་དང་།",
    "ཁྱོད་ལས་སྔར་གྱི་མྱོང་བ་དཔོག་ནུས་པ་མ་ཡིན་ཏེ།",
    "དོན་སྣང་གི་ཤེས་པ་གཟུང་འཛིན་གཉིས་ཀྱིས་སྟོང་པར་ཁས་མི་ལེན་ཏེ།",
