    "གང་གི་ཕྱིར་ན་སྟོན་པ་ལ་འཁྲུལ་པ་སོགས་མི་མངའ་བས་རྒོལ་བ་དེས་མི་འཕྲོག་པར་བྱེད་པ་ཡིན་པ་དེའི་ཕྱིར།",
    "གང་གི་འདུས་བྱས་མཚན་ཉིད་གང་། འདུས་མ་བྱས་པའི་མཚན་ཉིད་གང་།",
    "མིང་གི་རྣམ་གྲངས་གཞན་གྱི་དངོས་པོ་དང་ཡང་དག་མཐའ་དང་།",
    "ཡང་ན་མཆོག་གི་དོན་གྱིས་ན་གཞན་ཞེས་བྱ།",
    "རང་གི་ལག་ན་གནས་པའི་སྐྱུ་རུ་ར་བཞིན་དུ་སྲིད་པ་གསུམ་པོ་འདི་དག་མ་ལུས་པ་གདོད་མ་ནས་སྐྱེ་བ་མེད་པར་མངོན་སུམ་དུ་རྟོགས་པའི་བྱང་སེམས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྟག་ཏུ་འགོག་པར་རྟོགས་པའི་ལྷག་པའི་བསམ་པ་དང་ལྡན་པ་ཡིན་མོད་ཀྱི།",
    "དེ་ཉིད་ཀྱི་སྟེ་ཟབ་མོ་སྟོང་པ་ཉིད་ཀྱི་ཕྱོགས་ཀྱི་གཤོག་ཡངས་དཀར་པོ་རྒྱས་པར་གྱུར་པ་དང་ལྡན་ཞིང་།",
    "སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་ནི་འགོག་པར་འཇུག་པར་འགྱུར་ཞིང་།",
    "ཉོན་མོངས་ཀྱིས་དག་པའི་ས་བརྒྱད་པ་བཤད།",
    "ས་བདུན་པར་སློང་མི་དགོས་ལ་འདིར་སློང་དགོས་པ་ནི་ས་དེ་དག་ཏུ་ཉོན་མོངས་སྤངས་མ་ཟིན་པས་དེའི་གཉེན་པོར་ཡང་འཇུག་ལྡང་བྱེད་ལ།",
    "ས་འདིར་ཉོན་མོངས་སྤངས་ཟིན་པས་མྱུར་དུ་སྙོམས་པར་འཇུག་པ་ཡིན་ནོ།",
    "གཉིས་པ་ལ་ཉོན་མོངས་པ་སྤངས་པར་བསྟན་པ་དང་།",
    "ཉོན་མོངས་པ་སྤངས་པར་བསྟན་པ།",
    "ས་བརྒྱད་པ་ལ་ཁམས་གསུམ་གྱི་ཉོན་མོངས་པ་དེ་རྩ་བ་དང་བཅས་པ་དྲི་མ་དེ་དག་ཉེ་བར་ཞི་བར་འགྱུར་བ་ཡིན་ཏེ་ཆགས་པ་མེད་པའི་བློ་ས་བརྒྱད་པའི་ཡེ་ཤེས་ནི།",
    "སྐྱོན་ཉོན་མོངས་རྣམས་དང་ལྷན་ཅིག་མི་གནས་པའི་ཕྱིར།",
    "ས་འདིར་ཉོན་མོངས་ཟད་པའི་ཤེས་བྱེད་བསྟན་པར་སློབ་དཔོན་འདི་བཞེད་དོ།",
    "ལུས་ནི་བརྒྱ་པོ་རེ་རེ་ཞིང་ཡང་རྒྱལ་བའི་སྲས་པོ་བརྒྱ་ཕྲག་དག་དང་རྗེས་སུ་འབྲེལ་བའང་སྟོན་པའི་སྒོ་ནས་རང་གི་འཁོར་དང་བཅས་པས་མཛེས་ཤིང་འབྱོར་པ་ཐོབ་པའི་ཕྱིར།",
    "ངག་གི་སྤྱོད་ཡུལ་མིན་པ་སྡོམ་པ་སྟེ།",
    "རེ་ཞིག་ཅེས་པ་ནི།",
    "དེ་བཞིན་དུ་ལྷ་དང་ལྷ་མ་ཡིན་ལ་སོགས་པ་དག་ཀྱང་བ་སྤུའི་ཁུང་བུ་རེ་རེ་སྐད་ཅིག་རེ་རེ་ལ་མ་འདྲེས་པར་གྲངས་ལས་འདས་པ་སྟོན་པར་ནུས་སོ།",
    "སྔོན་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་དུ་གང་གི་དོན་དུ་འབད་པར་གྱུར་པའི་གོ་འཕང་མཆོག་ཏུ་ཞི་བ་བླ་ན་མེད་པའི་ཡེ་ཤེས་དེ་དང་པོར་འོག་མིན་དུ་ནི་ཁྱོད་ཀྱིས་བརྙེས་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ན།",
    "ཁྱོད་ཀྱིས་སྔོན་སྟོབས་བཅུ་བསྐྱེད་པའི་གེགས་སུ་གྱུར་པའི་མུན་པ་སེལ་བའི་ས་བཅུ་ལ་སླར་ཡང་སྟེ་ཡང་ཡང་འབད་པར་གྱུར་ཅིང་དེ་ནས་ས་བཅུ་གཅིག་པ་མངོན་དུ་མཛད་པའི་ཕྱིར།",
    "ཡོན་ཏན་མཐའ་དག་གི་མཐར་ཐུག་པ་ཡིན་ཏེ།",
    "ཁྱོད་ཀྱིས་སྐད་ཅིག་གིས་ནི་ཤེས་བྱ་ཐམས་ཅད་ཐུགས་སུ་ཆུད་པའི་ཡེ་ཤེས་བརྙེས་པ་ཡིན་ཏེ།",
    "སྐད་ཅིག་གིས་ནི་ཤེས་བྱ་ཐུགས་སུ་ཆུད་ཅེས་ཇི་སྙེད་པ་མཁྱེན་ཚུལ་བསྟན་པ་ཡིན་ནོ་། གཉིས།",
    "ཁོ་ན་རེ།",
    "ཁྱོད་ལ་ཡུལ་ཅན་གྱི་བློ་གྲོས་མི་འཇུག་པར་ཐལ།",
    "ཁྱེད་ཀྱི་གཞན་ལ་དེ་ཉིད་འདི་ལྟ་བུའོ་ཞེས་སུ་ཞིག་གིས་སྟོན་པར་འགྱུར་ཏེ་སྟོན་མི་ནུས་པར་ཐལ།",
    "གང་གི་ཚེའམ་ཕྱིར་ན་ཡུལ་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པ་ཉིད་ཁོ་ན་ཉིད་ཡིན་ཞིང་བློ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་དང་བྲལ་བ་དེ་ཚེ་དེ་ཁོ་ན་ཉིད་དེའི་རྣམ་པའི་རྗེས་སུ་བྱེད་པ་ལ་རྟེན་པ་ལས།",
    "སྔོར་སྣང་གི་སེམས་ནི་སྔོན་པོ་གང་གི་རྣམ་པ་ཅན་དུ་སྐྱེ་བར་འགྱུར་བ་ན།",
    "སྔོ་སྣང་གི་སེམས་དེའི་ཡུལ་སྔོན་པོ་དེ་ཡོངས་སུ་ཤེས་པར་ཐ་སྙད་བྱེད་པ་དེ་བཞིན་ནོ།",
    "འདིར་འགྲེལ་པར་དེའི་ཕྱིར་བཏགས་པ་ལས་དེ་ཁོ་ན་ཉིད་རྟོགས་སོ་ཞེས་རྣམ་པར་བཞག་གི།",
    "དངོས་སུ་ནི་འགའ་ཞིག་གིས་འགའ་ཞིག་ཤེས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ཁོ་ན་ཉིད་ལ་མཉམ་པར་བཞག་པའི་ཚེ་ཡུལ་ཡུལ་ཅན་གཉིས་ཀའང་ཆུ་བཞག་པ་ལྟ་བུར་སོང་བས་ཐ་དད་དུ་མ་སྐྱེས་པའི་ཕྱིར།",
    "འགའ་ཞིག་གིས་ངོ་བོ་ཉིད་ཀྱིས་གྲུབ་པ་མ་ཡིན་པར་བཏགས་པ་ཙམ་ལས་རྟོགས་ཤེས་སོགས་ཀྱི་སྤྲོས་པ་བྱེད་པ་ནི་ངལ་བ་དོན་མེད་པ་ཡིན་ཏེ།",
    "ཡུལ་རང་གི་ངོ་བོས་མ་གྲུབ་པ་ལས་རྟོགས་ཤེས་སྨྲས་པས།",
    "ཁྱོད་རང་བཞིན་གྱིས་ཞི་བ་ཡིན་ཡང་།",
    "ཁྱོད་ལ་ད་ལྟ་སྐྱེས་པའི་འབད་རྩོལ་གྱི་རྣམ་པར་རྟོག་པ་མེད་བཞིན་དུ།",
    "ཤེས་བྱ་གཟུང་འཛིན་གཉིས་སྣང་གི་བུད་ཤིང་སྐམ་པོ་མ་ལུས་པ་ཤེས་རབ་ཀྱི་མེས་བསྲེགས་པས་སྤྲོས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ལས་དང་ཉོན་མོངས་པའི་སྐྱེ་འགག་དང་ཡིད་ཀྱི་རང་བཞིན་གྱི་སྐྱེ་བ་དང་།",
    "དང་པོ་ལ་རང་གི་དུས་གསུམ་གྱི་མཛད་པ་ཇི་ལྟར་སྟོན་པའི་ཚུལ།",
    "གཅིག་རང་གི་དུས་གསུམ་གྱི་མཛད་པ་ཇི་ལྟར་སྟོན་པའི་ཚུལ།",
