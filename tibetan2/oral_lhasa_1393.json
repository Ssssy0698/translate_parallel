    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནྲི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛ་ཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "ཏྲི་ས་མ་ཡ་ཧཱུྃ་ཧཱུྃ་དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནྲི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "ཏྲི་ས་མ་ཡ་ཧཱུྃ་ཧཱུྃ་དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ་ནི་དྲི་མཱར་ཡ་རྦད་རྦད",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ་ནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་མཾ་ས་༁ྃ",
    "སརྦ་ས་མ་ཡ་བྷོ་བྷོ་ཛཛདགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ་ནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ་ནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "སརྦ་ས་མ་ཡ་བྷོ་བྷོ་ཛཛདགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནྲི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "ཏྲི་ས་མ་ཡ་ཧཱུྃ་ཧཱུྃ་དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "དགྲ་བགེས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནི་ཏྲི་མཱ་ར་ཡ་རྦད་ཆད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "ཏྲི་ས་མ་ཡ་ཧཱུྃ་ཧཱུྃ་དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ་ནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད་ཏྲག་རཀྴ་མཱ་ར་ཡ་རྦད་ཆོད་ཐུམ་རིལ་རྦད",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "སརྦ་ས་མ་ཡ་བྷྱོ་བྷྱོ་ཛཛད་གྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "ཏྲི་ས་མ་ཡ་ཧཱུྃ་ཧཱུྃ་དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ་ནྲི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "དགྲ་བགེས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཐུམ་རི་ལི་ལི་ཁུག་ཁུག་ནྲི་ཏྲི་མཱ་ར་ཡ་ཚིནྡྷ་ཚིནྡྷ་བྷནྡྷ་བྷནྡྷ་ཛ་ཧཱུྃ་བཾ་ཧོ",
    "གནོད་པར་གྱུར་ན་འགོ་བའི་ལྷ་ཡང་རུང་",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛནི་ཏྲི་མཱ་ར་ཡ་རྦད་རྦད",
    "ལྷག་མ་མེད་པར་བཞེས་ཤིག་ཁ་རཾ་ཁཱ་ཧི",
    "རྣ་བ་ལ་འོན་མགྲིན་པར་རྫི་། རྫི་རྐང་ཞབས་སུ་ཡང་ཨ་ཙ་ཨ་ཙ་ཚིགས་མགོ་བཞི་ལ་ཛ་ཧཱུྃ་བཾ་ཧོ།",
    "རྣམ་པར་ཤེས་པ་༴",
    "རྣ་བ་ལ་འོན་འོན་མགྲིན་པར་རྫི་རྫི་དཔུང་པ་གཉིས་ལ་ཡུམ་ཤེས་སུ།",
    "དགྲ་སྲི་བྱད་མ་ཆེ་གེ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ཏྲི་དུ་ཛ་ཏྲི་དུ་ཛ",
    "ཁྲི་འཕོ་དགྲ་སྲི་བྱད་མ་ཆེ་གེ་ལྷ་སྲུང་དང་བཅས་༴",
    "ཅེས་བྲི་ལིངྒའི་གཡས་སུ་ལོ་དང་ཟླ་བ་ལ་དར་བའི་དགྲ་སྲི་བྱད་མ་ལྷ་སྲུང་ཐམས་ཅད་མཱ་ར་ཡ་རྦད་ནན་སོད་ཅིག་ཆིངས་ཤིག་བྲི།",
    "གཡོན་ཞག་དང་ཟ་མ་དར་བའི་དགྲ་སྲི་བྱད་མ་ལྷ་སྲུང་ཐམས་ཅད་མཱ་ར་ཡ་རྦད་ནན་ཆིངས་ཤིག་སོད་ཅིག་བྲི།",
    "མགོ་བོ་ཁོས་བདུན་རྒྱུད་རྩད་ནས་ཆོད་ཅིག་ཐམས་ཅད་མཱ་ར་ཡ་ཆད་ནན་ཆིངས་ཤིག་སོད་ཅིག་སྤྱི་བོར་མགོ་ཐོག་ཏུ་ཕབ་པས་དགྲ་སྲི་ཐམས་ཅད་བྱད་མ་ལྷ་སྲུང་ཐམས་ཅད་མ་ར་ཡ་རྦད་ནན་ཆིངས་ཤིག་སོད་ཅིག་བྲི།",
    "དེ་ནས་གཡས་བསྐོར་དུ་སྔ་དགྲ་ལག་ཏུ་བླངས་པའི་དགྲ་སྲི་བྱད་མ་ལྷ་སྲུང་ཐམས་ཅད་མཱ་ར་ཡ་རྦད་ནན་ཆིངས་ཤིག་སོད་ཅིག་ཕྱི་དགྲ་ཡིད་ལ་བཤམས་པའི་དགྲ་སྲི་བྱད་མ་ལྷ་སྲུང་ཐམས་ཅད་མ་ར་ཡ་རྦད་ནན་ཆིངས་ཤིག་སོད་ཅིག་ད་དགྲ་ཐད་དུ་ལང་བའི་དགྲ་སྲི་༴",
    "རྒྱུ་སྐར་ཉེར་བརྒྱད་ཀྱི་སྟེང་ནས་ལངས་པའི་དགྲ་སྲི་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་མ་ར་ཡ་རྦད་ནན་ཆིངས་ཤིག་སོད་ཅིག་བྷྱོ་བཟློག་བྲུབ་ཅིག་དགྲ་སྲི་བྱད་མ་ལྷ་སྲུང་བྱད་གཏད་རྦོད་གཏོང་ཁྲམ་ཁ་ཐམས་ཅད་ཏྲི་དུ་ཛ་བྷྱོ་བཟློག་ཏྲི་དུ་ཛ་བྷྱོ་བཟློག་མ་ར་ཡ་ཏྲག་རགྴ་བྱད་གཏད་ཁྲམ་གསུམ་ཐམས་ཅད་ས་ཐུན་ཡ་བྷྱོ་བཟློག་ཨོ་བིརྱ་དགྲ་བགེགས་བྱད་མ་ཐམས་ཅད་བྷྱོ་བཟློག་ཁྲི་འཕོ་༴",
    "སརྦ་ཙིཏྟ་གཟེར་ཐུམ་བིག་ནན་ཏྲི་ནན་རྦད་ཡ་བཟློག་ཡ་གནོད་བྱེད་རྦད་འདྲེ་རྦོད་གཏོང་ལྷ་སྲུང་དང་བཅས་པའི་སྲོག་ལ་མཱ་ར་ཡ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་དགྲ་བོ་སོད་སོད་དུམ་པྲ་དུམ་ཀེ་མི་དུམ་ཨ་ཨ་ཡང་ཡང་རཾ་རཾ་ངཾ་ངཾ་ལཾ་ལཾ་དགྲ་བོ་དགྲ་སྲི་སྟཾ་བྷ་ཡ་ནན་མཱ་ར་ཡ་ནན།",
    "དགྲ་སྲི་ཐུམ་རིལ་ཪྣྲི་མྱོག་ཁུག་ཁུག་ཛ་ཛ་སྒྲིབ་སྒྲིབ་ཝཀྐཱ་སྟྭཾ་བྷ་ཡ་ནན་བསྟན་དགྲ་དམ་སྲི་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་བིག་ནན་ཐམས་ཅད་དེ་ཤམ་དེ་ཤྭ་བྷུར་། འགྲུབ་བྷི་ཤ་ཙཀྲ་ཧ་ལ་ཧ་ལ་ཏབ་ཏ་ཧལ་ཏ་ཧཱུྃ་ས་མ་ཡ་སྒྲིབ་ཧྲིང་སྲི་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་སྟཾ་བྷ་ཡ་རགྴ་ནན་ཧཱུྃ་ཧཱུྃ་ལཾ་ལཾ་ཧཱུྃ་ལཾ་ཧཱུྃ་ལཾ་དགྲ་བོ་སྟྭཾ་བྷ་ཡ་ནན་མཱ་ར་ཡ་བུར་འདྲ་ནན་ཝི་ཏྲི་ར་ཨ་ན་ནན་ཀྱི་ཧྲི་ཀྲི་སྟཾ་བྷ་ཡ་རགྴ་རྦད་སོད་མ་ར་ཡ་རྦད་ནན་དགྲ་བོ་སྟཾ་བྷ་ཡ་ནན་མ་ར་ཡ་བླང་ཆིངས་ཤིག་ཛ་སོད།",
    "སྒྲོག་ཏུ་བཅུག་པར་བྱེད་པའི་དགྲ་བོ་ཐམས་ཅད་༴",
    "རྣམ་པར་ཤེས་པ་ནན།",
    "སྐྱེ་མཆེད་དྲུག་རྣམ་པར་ཤེས་པ་ཚོགས་བརྒྱད",
