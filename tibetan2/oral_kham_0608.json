    "ཧ་ཅང་ཞུ་ཐུབ་ཀི་མི་འདུག་སྟེ།",
    "དེ་ཚོའི་གས་ཡོངས་གགས་བས་ཐུབ་ཀི་མི་འདུག་སོ་སོས་གང་བེད་དགོས་དེ་བས་པ་ཡིན་ན།",
    "དེ་ཏོག་ཙམ་ང་རང་ལ་ཡང་ཨིན་སྐད་ཐོག་ནས་ཞུས་ན་སེབས་མཁན་འད་ཞིག་འདུག་གང་འདུག་ཞུས་པ་ཡིན་ན།",
    "དཔེར་ན་གསོག་སྒར་སོབ་གྲྭའི་འགམ་ལ་ས་ཆ་སྟོང་པ་འདུག་འོན་ཀང་ས་ཉོ་རྒྱུ་དེའང་དེང་སང་རོག་ཁྲ་ཚ་པོ་འདུག་ལ།",
    "ཡིན་ནའང་གོང་དུ་ང་རང་ཡང་དེ་འད་བཀའ་གནང་ཡོང་དུས།",
    "དེར་བརྟེན་ད་ལྟ་ར་ཤོད་ཀི་དཔེ་སྟོན་སོབ་གྲྭའི་ཁང་པ་ཚང་མ་བཤིག་ཁང་པ་དེ་ཚོ་བེད་སོད་མི་འདུག་སེ་ལེན་ཁང་གསར་པ་བརྒྱབས།",
    "གང་འད་འདུག་དེ་ཚོར་དགོངས་པ་བཞེས་རོགས་གནང་།",
    "ནུབ་ལ་འགོ་མི་ཆོག་ལབ་མི་འདུག་ཅེས།",
    "གོས་ཆོད་བཞག་འདུག་ན།",
    "ལྡོག་ཕོགས་རང་རང་ཚུར་གསུང་སོད་མཁན་འད་ཞིག་ཡིན་དུས།",
    "ཕི་ལོག་ནས་ཡོང་མཁན་ཤ་སྟག་ཡིན་པ་གསལ་ཁ་རང་མི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "བསར་དུ་ཞུ་རྒྱུ་ཞིག་མི་འདུག་སྐབས་དང་དུས་སུ་ཡང་བསར་དོགས་པ་རྣམ་རྟོག་བྱུང་བ་ཡིན་ན།",
    "དོན་མེད་སི་ཚོགས་ནང་ལ་བསམ་ཚུལ་མ་ཆགས་པ་ཞིག་བཟོ་དགོས་ཀི་འདུག་ཅེས་ཞུ་འདོད་བྱུང་།",
    "བོད་ཀི་ར་དོན་ལའང་རང་བཞིན་ཕན་ཐོགས་གང་ཙམ་བྱུང་ཡོད་པ་ཀུན་གསལ་ཡིན།",
    "ཝ་ཎ་བོད་ཀི་ཆེས་མཐོའི་གཙུག་ལག་སོབ་གཉེར་ཁང་བཅས་ནས་མཐུན་འགྱུར་གང་ཐུབ་གནང་འདུག་ད་དུང་མུ་མཐུད་དགོས་ངེས་མཐུན་འགྱུར་གང་དག་གནང་དགོས་གལ་ཆེར་མཐོང་།",
    "མུ་མཐུད་གནས་དགོས་སྐོར་གཅིག་མཚུངས་གསུངས་བཞིན་འདུག་ན།",
    "སང་ཉིན་གནངས་ཉིན་ག་དུས་ཡིན་ནའང་སི་ཡོངས་ཀི་བགོ་གེང་སྐབས་ལ་སིག་གཞི་བསར་བཅོས་རང་ལ་དམིགས་བསལ་མི་དགོས་པ་བས་ཏེ།",
    "གསུངས་ཀྱང་རང་ལུགས་སྟོབས་བཞིས་སྡིག་ལྟུང་ཀུན།",
    "འོན་ཀྱང་སྡིག་ལྟུང་གཉིས་གཉེན་པོས་དག་ཚུལ་དང་དེ་གཉིས་ལྡོག་དུས་མི་གཅིག་པ་བཅས་བཞེད་དེ།",
    "གཞུང་འདིའི་ནང་རང་ཅག་གནས་པའི་གླིང་བཞི་པའི་འཇིག་རྟེན་གྱི་ཁམས་འཛམ་བུ་གླིང་འདི་ནི་མིའི་གླིང་གཞན་ལས་༨ ཆམ་ཆརྒྱ་ཆཅཅ་མཁྱད་པར་དུ་འཕགས་པར་བསྟན་པ་དང་།",
    "ལ་ལ་ཁང་པའི་ནང་དུ་འདུག་ཅིང་རྟ་ལུག་འབྲུ་གཡག་མཛོ་སོགས་ལ་བརྟེན་ཏེ་འཚོ་བར་བྱེད།",
    "པ་ད་༤ ལ་ཡང་ཋ་ཀུ་ར་བྷོ་ཙ་ནའམ་མི་ཆེན་ཞལ་ཟས་སུ་གྲགས་པ་འབྲས་དཀར་པོ་དྲི་ཞིམ་ཞིང་རོ་མངར་བ་བོངས་ཆེ་བ་དང་།",
    "རྒྱ་སྲན་ཙ་ན་ཀ་དང་།",
    "དུག་སྦྲུལ་གདུག་པ་ཅན་ཨ་ཙིག་ཟེར་བ་ཤིན་ཏུ་ཆེ་བ་གླང་པོ་གསོན་པོར་མིད་ཐུབ་པ་དང་།",
    "ས་ཡི་གོ་ལར་ཡང་དེ་འདྲ་ཞིག་བྲིས་འདུག་ལ་འདི་དག་ནི་བར་སྐབས་སུ་ཅུང་ཟད་སྤྲོས་པ་ཡིན་ནོ།",
    "དུག་སྦྲུལ་གདུག་པ་ཅན་ཨ་ཙིག་ཟེར་བ་ཤིན་ཏུ་ཆེ་བ་གླང་པོ་གསོན་པོར་མིད་ཐུབ་པ་དང་།",
    "ས་ཡི་གོ་ལར་ཡང་དེ་འདྲ་ཞིག་བྲིས་འདུག་ལ་འདི་དག་ནི་བར་སྐབས་སུ་ཅུང་ཟད་སྤྲོས་པ་ཡིན་ནོ།",
    "ཡུལ་དེ་ནས་བྱང་ཤར་གྱི་ཕྱོགས་སུ་ཛ་ཧྲེ་བ་ན་ཟེར་བའི་ནགས་མཐུག་པོ་བརྒྱུད་དེ་ཉིན་གཅིག་ལྷག་ཙམ་ཕྱིན་ཙ་ན་མ་ཀླུ་དེ་ཤའམ་དེང་སང་བཱ་ལི་ཡ་དེ་ཤ་སྟེ་སྟོབས་ལྡན་གྱི་ཡུལ་ཟེར་བ་གྱད་ཀྱི་ཡུལ་ཡོད།",
    "དེར་རྒྱང་གྲགས་ལྷག་ཙམ་གྱི་ས་ཐམས་ཅད་རྡུལ་སེར་ནག་འདྲེས་མར་འདུག་པ་ལ།",
    "སྟོན་པ་འདས་རྗེས་ལག་ན་རྡོ་རྗེས་སྨྲེ་སྔགས་བཏོན་པའི་གནས་སོགས་སུ་དད་ལྡན་རྣམས་ཀྱིས་མཆོད་རྟེན་བཞེངས་པ་རྣམས་དེང་སང་ཡོད་ཚོད་འདུག་ལ།",
    "མུ་སྟེགས་པ་དེ་དག་ཕལ་ཆེར་རྒྱ་གར་ནས་འོངས་པ་ལས་ཡུལ་དེ་ཉིད་ཀྱི་མི་མང་པོ་ཡོད་ཚོད་མི་འདུག་ཡུལ་དེ་དག་ཕལ་ཆེ་བར་བཤྲཱི་རྩེད་སྤྱོད་ཅན་དང་གདུག་པའི་མཁའ་འགྲོ་མ་མང་ཞིང་།",
    "དེང་སང་ཁོ་རང་དང་རུས་གཅིག་པའི་བྲམ་ཟེ་ཤེ་ལ་ཛེ་ཟེར་བ་རྒྱལ་སར་འཁོད་དེ།",
    "ཕེ་རང་ཐོར་སི་ཀེ་སིས་བྱས་པའི་གོ་ལའི་ཁ་བྱང་ན་ཡང་གཎྜིནའི་ཡུལ་ཞེས་པ་འདུག་ལ།",
    "དགྲ་བཅོམ་པ་ཉི་མ་གུང་པས་གུར་ཀུམ་གྱི་ས་བོན་བཏབ་པ་ཡིན་ཟེར་བ་ཁ་ཆེ་གུར་ཀུམ་སྐྱེ་བའི་ཐང་ཞིག་ཡོད་པ་ངེད་ཀྱི་གྲྭ་རིགས་གནས་སྐོར་བ་དགེ་ལེགས་ཟེར་བས་ཀྱང་དངོས་སུ་མཇལ་འདུག་ཡུལ་དེའི་བྱང་ཤར་སྦལ་ཏི་དང་ཉེ་སར་གནས་ཉེར་བཞིའི་ནང་ཚན་ཏེ་མ་ལ་ཡའི་གནས་ཡོད།",
    "ཐོ་དཀར་དང་རྒྱ་ནག་གཉིས་ཀས་ཡུར་བར་དྲངས་པས་ཆུ་ཆར་ཟེར་བ་བདེན་མི་བདེན་མ་ངེས་ཀྱང་དོན་འགྱུར་གྱི་ཐེ་ཚོམ་གྱི་གནས་སུ་འདུག་པ་འདི་ནི་མྦྷ་ལའི་ལམ་ཡིག་ལས་གསུངས་པའི་སི་ཏ་དེ་མ་ཡིན།",
    "ཡུལ་བ་པས་ཐབས་ཁམས་པ་ལ་འཁོར་ཡང་མི་ཆུང་ཙམ་ཞིག་ཡོད་ཚོད་འདུག་ཡུལ་དེའི་མི་རྣམས་ཀྱི་ཆ་ལུགས་གོས་དང་ལྷམ་སོགས་ཕལ་ཆེར་ཁ་ཆེ་དང་འདྲ་ཡང་།",
    "དེ་དག་ཁ་ཕྱེ་བས་ཐམས་ཅད་དངུལ་ཡིན་འདུག་པ།",
    "བོད་དྲང་པོ་གསུམ་གསུངས་འདུག་པ་རིམ་བཞིན་སྟོད་མངའ་རིས་སྐོར་གསུམ་དང་།",
    "གནས་ཀྱང་ཤིན་ཏུ་ཉམས་དགའ་བ་རྭ་སྒྲེང་དང་ཕྱོགས་མཚུངས་ཤིག་ཡིན་ཚོད་འདུག་པ་དེང་སང་བདག་པོས་དབེན་སྟབས་གཙུག་ལག་ཁང་སོགས་ལ་ཕྱུགས་རྭ་བྱེད་ཀྱིན་ཡོད་ཟེར་བ་ཐོས།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྒྲུབ་ཕུག་དང་ཕྱག་ཞབས་སོགས་ཀྱི་རྗེས་སོགས་གནས་ཡ་མཚན་ཅན་མང་པོ་ཡོད།",
    "གླིང་མ་ཡས་ལ་མཁས་པ་པན་བ་བ་ང་རང་ན་ནང་༣་།",
    "ཕག་གྲུ་ཨ་ཁབ་ལབ་པས་ཟབ་ཀ་ཁག་༣ པ་ལ་ཚན་ཀ་སློབ་བརྒྱུད་དང་བཅས་པའི་གདན་ས་དགེ་ལུགས་སུ་བསྒྱུར་ཡོད་པ་མང་པོ་ཡོད་ཚོད་འདུག་འབྲུ་གུ་དང་ཉེ་སར་ཀ་དྲོད་ཟེར་བའི་གནས་སོགས་ཡོད།",
    "སྔོན་དུས་ཀྱི་རྒྱལ་བློན་དང་ལོ་ཙཱ་བ་སོགས་པ་རྒྱ་ནག་དང་ཧོར་གྱི་རུས་མིང་ཅན་མང་པོ་འདུག་པས་རིགས་དང་ཆད་ཁོངས་གཅིག་ཏུ་ངེས་ཚོད་མི་འདུག།",
    "ཞག་ཤན་ནས་ཆེར་མི་རིང་བར་གོང་མ་ཤུན་ཊིའི་དམར་གདུང་དུ་གྲགས་པ་དཔོན་པོའི་ཉམས་ཅན་ལ་བཟང་པོའི་འདུག་སྟངས་ཅན་གྱི་ལྷ་ཁང་ཡོད།",
    "རྗེས་སན་ལུང་པས་པེ་ཅིང་དང་ཅང་ནན་གཉིས་ཀྱི་བར་ན་ཡུལ་ཞིག་ཡོད་པ་དེའི་མི་རྣམས་ཀྱི་མིག་གྱེན་ཐུར་དུ་ཡོད་པར་གསུངས་པ་ཞན་དུང་ཡིན་ཚོད་འདུག་ལ།",
    "ཇོའོ་མིན་ཟེར་བ་རྒྱ་གར་ང་ནིཅང་རང་རམ་ས་འ་སཙམ་འ་ས་ཡ་མ་གྱི་སེམས་ཙམ་པའི་སློབ་དཔོན་འགའ་ཞིག་དང་།",
    "ངག་དང་རང་བཞིན་འཇམ་ཞིང་།",
    "ལག་ན་མཚོན་ཆ་སྣ་ཚོགས་ཐོགས་ཏེ་འགྲོ་ཡང་རང་བཞིན་འཇམ།",
    "ཡུ་རྟེ་ཤི་ཡ་ཡའམ་ཨོ་ཏེ་པ་ཟེར་བའི་རྒྱལ་ཁམས་ཨོ་ཊི་ནའི་ཡུལ་ཡིན་ཚོད་འདུག་ཡུལ་དེ་ཉིད་དྲོ་གྲང་ཕལ་ཆེར་སྙོམས་པ་ལ་ཅུང་ཟད་དྲོ་ཤས་ཆེ་བ།",
    "ཟླ་མ་མས་ན་སོགས་ལི་ཡུལ་དུ་ངོས་བཟུང་འདུག་ཀྱང་།",
    "སུམྦྷ་མཁན་ཆེན་གྱིས་ཧོ་ཐོན་དང་རྒྱ་གར་གྱི་ཀླ་ཀློ་དག་ལ་ཁྱད་པར་ཆེན་པོ་ཡོད་ཅེས་གསུངས་འདུག་པ་དེ་ནི་ལེགས་པར་མ་བརྟགས་པའི་ཚིག་ཡིན་ལ།",
    "ཧོར་ཐུ་བ་རྒྱལ་པོས་བཞེངས་པ་ཡིན་ཚོད་དུ་འདུག་ལ།",
    "ཨ་ཀེ་མ་ཏ་སོགས་མཁས་པ་དང་གྲུབ་ཐོབ་པ་མང་ཙམ་བྱུང་འདུག་པ་ཐམས་ཅད་གང་ཟག་ཕལ་པ་ཡིན་ཟེར།",
    "ཏེ་པཱ་ར་ཐ་ཨ་ཙིསི་ཁོན་དང་།",
    "རྒྱལ་པོའི་ལག་པ་བཏེགས་མ་ཐག་ཨཀི་མེ་ཏ་རང་ཉིད་ཀྱིས་གྲུའི་ནང་ན་འཕྲུལ་འཁོར་ཡོད་པ་བསྐྱོད་དུ་བཅུག་པས་དེ་མ་ཐག་གྲུ་ཁོ་རང་རྒྱ་མཚོར་ཞུགས་པ་དང་།",
    "ཡུལ་དེ་ཉིད་ཀྱི་པ་མ་མ་རྒྱལ་པོ་ནི་ཡུལ་དེའི་མི་ཡོན་ཏན་ཆེ་ཞིང་རང་བཞིན་བཟང་བ་རྣམས་ཀྱི་ནང་ནས་བསྐོ་བར་བྱེད་པ་ཡིན་ཞིང་།",
    "གཅེར་བུ་བྱ་སྒྲོ་དང་ཤིང་ལོ་སོགས་བབསག་ད་༣ ༤ ནའ་མ་ཟད་བསྟན་༥ ས་འལན་ཀཀ་འདས་ན་ན་པས་བླུན་པོ་འབའ་ཞིག་ཡིན་ཡང་རང་རྒྱུད་ཅུང་ཟད་འཇམ།",
    "དུས་འཁོར་ལུགས་དང་འགལ་ཚོད་ཆེར་མི་འདུག་སྟེ།",
    "རིམ་གྱིས་ཀླ་ཀློ་དག་ཡུལ་འདིར་འདུག་ཉེན་ཡོད་པར་དགོངས་ནས།",
    "རིགས་ལྡན་པ་ཁོང་རྣམས་ནས་ཀྱང་དེ་འདྲའི་རིགས་ཡོད་པའི་དོགས་ཟོན་བྱེད་ཀྱིན་ཡོད་འདུག་པས་དེ་ཙམ་ལས་མ་སྤྲོས་སོ།",
    "བོད་ཀྱི་མི་དེར་སླེབས་པ་ཆེར་མི་འདུག་པས།",
    "རྒྱུ་དང་རང་བཞིན་བསྟན་པ།",
    "དེ་བས་ན་ཇི་ལྟར་སེང་གེ་ནི་གང་ནས་གང་དུ་འགྲོ་ཡང་རུང་འདུག་ཀྱང་རུང་སྟེ་ས་འདིའི་སྟེང་ན་བག་ཚ་བ་དང་།",
    "ཚོར་བ་དང་བྲལ་ིབས་མི་འདུག་པའོ་ཞེས་བྱ་བས་ཚོར་བ་གསུམ་མེད་པས་གང་ལ་ཡང་ཆགས་པ་མེད་པ་བསྟན་ཏེ།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་རྣམ་པ་གསུམ་དང་བྲལ་བས་མི་འདུག་པ་སྟེ།",
    "མི་གཡོ་ཞིང་བརྟན་པར་འདུག་པས་ན་ཤིན་ཏུ་བརྟན་པ་ཞེས་བྱའོ།",
    "དམུ་རྒོད་རྣམ་པ་བཞི་པོ་ཡང་དག་པའི་སྒྲུབ་པ་ལ་འདུག་ཏུ་མི་བཏུབ་པས་གནས་ལ་དམུ་རྒོད་དང་།",
    "འགྲོ་བ་དང་འདུག་པ་ལ་སོགས་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་མཉམ་པར་གཞག་པས་མ་ཉམས་པ་ཞེས་བྱ་སྟེ།",
    "འཛིན་པའི་དངོས་པོ་མེད་པར་ཡང་རང་བཞིན་གཅིག་ཅེས་བྱ་བར་སྦྱར་རོ།",
    "འགྲོ་བ་དང་འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་ཐམས་ཅད་དུ་མཉམ་པར་གཞག་པ་དང་།",
    "གནས་གཅིག་ན་འདུག་ཅིང་ཉན་པའོ།",
    "འོང་བ་དང་འགྲོ་བ་དང་གནས་པ་མེད་ཅེས་བྱ་བ་ནི་སྐྱེ་བ་དང་འགག་པ་དང་འདུག་པ་མེད་པ་སྟེ།",
    "ཚུལ་བཞིན་དེ་ངོ་བོ་ཉིད་ཀྱིས་དག་པས་ནམས་ཀྱང་རང་བཞིན་གཞན་དུ་མི་འགྱུར་བ་ལ་བྱའོ།",
    "ཕུང་པོའི་མཚན་ཉིད་དང་རང་བཞིན་གང་ཡིན་པ་རྟོགས་པའོ།",
    "ང་རང་བཞིན་མེད་ཅིང་དེ་མ་ཐག་ཏུ་འཇིག་པ་ཡིན་པར་མཐོང་ནས།",
    "ཕུང་པོ་ལྔ་ཡང་རང་བཞིན་མེད་པས་མ་འོངས་པའི་དུས་ཀྱི་ཚེ་དང་མཚམས་སྦྱོར་བ་མེད་པའོ།",
    "སྐྱེ་བ་ཐམས་ཅད་སྐྱེ་བ་མེད་ཅིང་མི་སྐྱེ་བའི་མཚན་ཉིད་ཀྱི་འགོག་པ་གང་ཡིན་པ་དེ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་མེད་པར་ཤེས་པ་ནི་མི་སྐྱེ་བའི་མཚན་ཉིད་མི་འགོག་པ་ཞེས་བྱའོ།",
    "ཕྱིས་ཀྱང་བདག་ཉིད་ིའདུག་གོ་སྙམ་དུ་སེམས་པ་ནི་རྟག་པར་འདུ་ཤེས་པའོ།",
    "ལུས་ལྷོད་པར་གྱུར་པ་ན་ལྡང་བ་དང་འདུག་པ་ལ་ལུས་ལྕི་བའོ།",
    "འདུག་པ་ཐོབ་པ་ནི་ཡུལ་ལ་དམིགས་པའི་ཚེ་སེམས་རྩེ་གཅིག་པ་ལ་གནས་པ་ཐོབ་པ་སྟེ།",
    "གང་ཐག་ཉེ་བ་ན་འདུག་པའི་གཟུགས་ཐམས་ཅད་དོ།",
    "ཞི་གནས་ལ་རབ་ཏུ་གནས་པས་གཙེ་བ་མེད་ཅེས་བྱ་བ་ནི་ཏིང་ངེ་འཛིན་སེམས་རྩེ་གཅིག་པའི་མཚན་ཉིད་ལ་ལེགས་པར་འདུག་པས་ཏིང་ངེ་འཛིན་དང་མི་མཐུན་པའི་ཕྱོགས་ཕྱིན་ཅི་ལོག་ཏུ་རྟོག་ཅིང་དཔྱོད་པ་ལ་སོགས་པའི་སྐྱོན་མེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ཉིད་དུ་འདུག་གོ་ཞེས་བྱ་བ་ཡན་ཆད་ཀྱིས་ཐམས་ཅད་གཟུགས་སུ་འཛུད་པ་བསྟན་ཏོ།",
    "ཡང་ན་དང་པོར་རྒྱུ་དང་རྐྱེན་ཚོགས་ནས་འབྲས་བུ་སྐྱེས་ཀྱང་རྒྱུ་འབྲས་བུར་མ་འཕོས་པར་ཤེས་པ་ནི་ཐ་མར་མི་འགྲོ་བ་ཤེས་པའོ་།་ཡང་ན་དང་པོར་རྒྱུ་དང་རྐྱེན་ིབར་དུ་མི་འདུག་པར་ཤེས་པ་ནི་སྐད་ཅིག་མའི་རང་བཞིན་ནམ་དངོས་པོ་མེད་པའི་ཕྱིར་མཐའ་གཉིས་ཀྱི་བར་ན་ཡང་མི་གནས་པར་ཤེས་པའོ།",
    "ཕུང་པོ་རྣམས་ལ་སྒྱུ་མར་ཤེས་པ་ནི་ཇི་ལྟར་སྒྱུ་མ་རྒྱུ་རྐྱེན་གྱིས་སྐྱེད་པས་སྣང་ཡང་རང་བཞིན་མེད་པ་བཞིན་དུ།",
    "དངོས་པོ་མེད་པ་ནི་ད་ལྟར་གྱི་དུས་ན་ཡང་རང་བཞིན་མེད་པའོ།",
    "འདོད་ཆགས་སྤྱོད་པ་རྣམས་ཀྱི་ཚུལ་དང་རང་བཞིན་ནམ་རྣམ་པར་དབྱེ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལེན་པ་གསུམ་ཆར་ཡང་རང་བཞིན་མེད་པར་ཤེས་པ་ནི་དོན་ཏོ།",
    "མི་གནས་པ་ནི་ཅུང་ཟད་ཀྱང་འདུག་པའི་མཐུ་མེད་པ་སྟེ་དེ་བས་ན་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ནང་ན་ཡང་མི་འདུག་ཕྱི་རོལ་ན་ཡང་མི་འཕྲོས།",
    "ཇི་ལྟར་རྨི་ལམ་ན་དངོས་པོ་རྣམ་པ་སྣ་ཚོགས་སྣང་བ་ཡང་རང་བཞིན་སྟོང་པ་དེ་བཞིན་དུ།",
    "སེམས་ལ་གཟུང་བ་དང་འཛིན་པ་ལ་སོགས་པ་རྣམ་པ་དུ་མར་སྣང་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "སྐྱུ་རུ་རའི་འབྲུ་འདུག་པ་བཞིན་དུ་མཐོང་ཞེས་བྱ་བ་ཡན་ཆད་ཀྱིས་བསྟན་ཏོ།",
    "འདོད་པའི་ཁམས་བདུད་ཀྱི་སྤྱོད་ཡུལ་ན་འདུག་ཀྱང་འདོད་པ་དང་།",
    "ང་རང་སྐྱེ་བ་༣༣༢ པེ་སྣར་ཉམས་པ།",
    "པེ་འདུག་པར།",
    "ང་རང་༥༨༢ པེ་སྣར་རྟགས།",
    "རྟག་ཏུ་འདུག་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "འདུག་པ་སུ་ཡིན།",
    "ཡང་གནོད་པ་དང་བཅས་པའི་ལུས་ཀྱི་འདུ་བྱེད་འདུག་བྱས་པས་ཇི་ཙམ་གནོད་པ་དང་བཅས་པའི་བར་གྱི་འཇིག་རྟེན་དུ་སྐྱེ་བར་འགྱུར་རོ་ཞེས་གསུངས་པས་དབུགས་ཕྱི་ནང་དུ་རྒྱུ་བ་ནི་སྐྱེ་བའི་རྒྱུ་ཡང་མ་ཡིན་ནོ།",
    "སེམས་ཀྱི་རྒྱུད་ལ་ས་བོན་བརྟས་པ་དེ་ཡང་ཡུན་ཇི་སྲིད་ཅིག་ཏུ་འདུག་ཅེ་ན།",
    "ཇི་ལྟར་ཐོག་མར་ནུར་ནུར་པོར་འདུག་གོ།་།",
    "བཙས་ཕྱིན་ཆད་འདུག་པ་ནི་རབ་ཏུ་བྱུང་བ་ཡིན་ནོ།",
    "འདུག་པ་ན་ལུས་མདུན་དུ་གུག་པའི་ཕྱིར་རོ།",
    "འབྱོར་པ་དང་ལྡན་པ་ཡིད་བདེ་བ་མང་བ་ཁོ་ན་དག་དུས་བྱེད་པ་དམིགས་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་ལངས་ཏེ་འགྲོ་བ་དང་འདུག་སྟེ་ཟ་བ་ལྟ་བུའོ།",
    "པེ་སྣར་འདུག།",
    "ཉེ་བ་ཡིན་པའི་ཕྱིར་དང་ཞེས་བྱ་བ་ནི་མཆོག་ཡིན་པའི་ཕྱིར་དང་གཙོ་བོ་ཡིན་པའི་ཕྱིར་གཞན་དག་པས་སྤྱན་སྔ་ན་འདུག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཇི་སྲིད་དུ་རྒྱུན་གྱིས་རྒྱུ་གནས་པར་འདུག་པ་དེ་སྲིད་དུ་རྒྱུན་ཁོ་ནས་འབྲས་བུ་གནས་པ་ཡིན་ནོ།",
    "ནང་ལ་ཚུལ་བཞིན་མ་ཡིན་པར་ཇི་ལྟ་བུ་ཞིག་ཏུ་འདུག་པ་གང་ཡིན།",
    "དེ་སེམས་དེ་བསྟན་ཅིང་བསྒོམས་ལན་མང་དུ་བྱས་པས་དམན་པར་འདུག་འདུག་པ་ལས་གོང་དུ་འཕོའོ།",
    "ཙི་༡༣ གལ་ཤིན་ཏུ་འདུག་པ་ལས་གོང་དུ་ཤིན་ཏུ་འཕོའོ།",
    "སྟན་ལ་འདུག་པ་དང་།",
    "ཁྲིའུའི་ིསྟེང་ན་མི་འདུག་པ་ལ་ཁྲིའུ་རུ་ཉེ་བར་བཏགས་ནས་འདི་སྐད་དུ་ཁྲིའུ་སྨྲའོ་ཞེས་བྱ་བ་དང་།",
    "འདུས་པ་ཞེས་བྱ་བ་ནི་གསུམ་པོ་རྣམས་ིརྒྱུ་དང་འབྲས་བུར་འདུག་པ་ཙམ་ཡིན་ནོ།",
    "འདུག་པ་ན་ལུས་མདུན་དུ་གུག་པའི་ཕྱིར་རོ།",
    "མ་རིག་པས་ནི་བདེན་པ་མཐོང་བའི་ཡུལ་བཀག་སྟེ་འདུག་པ་ཡིན་ཏེ།",
    "མཉམ་དུ་འདུག་པར་ཡང་འགྱུར་རོ།",
    "སྔོན་གྱི་མཐར་ཡང་མ་ཡིན་དབུས་སུ་༧ཡང་སྲེད་པ་དང་ལེན་པ་གཉིས་ནི་མ་རིག་པ་དང་ལྷན་ཅིག་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སྲེད་པ་དང་ལེན་པའི་ཡན་ལག་ནི་སྲེད་པར་བྱེད་པའི་ལས་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྲེད་པའི་རྐྱེན་གྱིས་བྱུང་བའི་ལེན་པས་རྣམ་པར་ཤེས་པའི་རྒྱུན་ལ་བག་ཆགས་སུ་འདུག་པའི་ལས་རྣམས་སྲིད་པར་གྱུར་པར་བྱེད་དོ།",
    "དཔེར་ན་ལངས་ཏེ་འགྲོ་བ་དང་འདུག་སྟེ་ཟ་བ་ལྟ་བུའོ་ཞེས་བྱ་བ་ནི་ལྡང་བ་དང་འགྲོ་བའི་བྱ་བ་གཉིས་ལ་གལ་ཏེ་འདིར་བྱེད་པ་པོ་ཐ་མི་དད་པ་ཡོད་ན་ནི་དེས་ན་དུས་སྔ་མ་ལྡང་བའི་བྱ་བ་ལ་སྟེ་ཞེས་བྱ་བ་འདི་ཡོད་པ་ཡིན་ནོ།",
    "འདུག་པ་དང་ཟ་བའི་བྱ་བ་གཉིས་ལ་ཡང་གལ་ཏེ་བྱེད་པ་པོ་ཐ་མི་དད་པ་ཡོད་པ་ཡིན་ན་དེས་དུས་སྔ་མ་འདུག་པའི་བྱ་བ་ལ་སྟེ་ཞེས་བྱ་བ་འདི་ཡོད་པ་བཞིན་དུ་འདི་ལ་ཡང་བྱ་བ་བྱེད་པ་གཉིས་ཡོད་དེ།",
    "དཔེར་ན་ཚོར་བ་ལ་སོགས་པའི་རྫས་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་ཏུ་དུ་མ་མི་འདུག་པ་བཞིན་ནོ།",
    "བཟོ་ལ་སོགས་པ་ཤེས་པའི་མི་མཐུན་པའི་ཕྱོགས་སུ་འདུག་པ་ན།",
    "པེ་སྣར་འདུག་༩༩༦ ༧ པེ་སྣར་པོ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་སྤྲིན་དང་ཁུག་རྣ་དང་གཟུགས་ནག་ནོག་དུ་འདུག་པ་ལ་སོགས་པ་ནི་ཡོངས་སུ་མ་དག་པ་ཉིད་ཀྱིས་ཡོངས་སུ་སྤང་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་དང་།",
