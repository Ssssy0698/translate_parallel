    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་ཚེ་དང་ལྡན་པ་མོངྒལ་གྱི་བུ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཚེ་དང་ལྡན་པ་མོངྒལ་གྱི་བུ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་མངོན་དུ་ཕྱོགས་པའི་རྫུ་འཕྲུལ་ཐོབ་པས་དེ་དང་པོར་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་སོང་ནས་འདུག་གོ་དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་མཚན་མ་དེ་ལྟ་བུ་བྱུང་བ་མཛད་པའི་མཚན་མ་ཇི་ལྟ་བུ་བྱུང་བ་མཛད་པས་རྒྱ་མཚོའི་ཀླུའི་རྒྱལ་པོ་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ཀླུའི་རྒྱལ་པོ་མཛེས་དགས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བདེ་བའི་ལམ་གྱིས་མྱ་ངན་འདས་རེག་པ།",
    "གང་གི་བདེ་བས་བདེ་བར་གཤེགས་པ་བསྐྱེད།",
    "བདེ་བའི་ལམ་གྱིས་མྱ་ངན་འདས་རེག་འགྱུར།",
    "སྟོན་པའི་གསུང་གིས་མཛེས་པ་དེ་དགའ་ནས།",
    "བློ་དགེ་ཉོན་མོངས་ཚོགས་ལས་རྣམ་གྲོལ་ཞིང་།",
    "མི་མཆོག་དམ་པ་བདག་གི་སྤྱོད་སྤྱོད་པ།",
    "སྲོག་གི་ཕྱིར་ཡང་ཡིད་ནི་མི་ལྡོག་ཅིང་ རྟག་ཏུ་སྤྱོད་ཚེ་ཉོན་མོངས་མེད་ཡིད་ཀྱིས།",
    "བདེ་གཤེགས་གསུང་གིས་ལྷ་ཡི་མཛེས་པ་ཀླུ།",
    "སྤྱད་པ་སྤྱོད་ཚེ་ཁྱོད་ཀྱི་རྗེས་སློབ་ཅིང་།",
    "ཁྱོད་དང་མཉམ་མེད་གོང་ན་ཡོང་མ་ཡིན།",
    "སྟོན་པའི་ཉན་ཐོས་རྫུ་འཕྲུལ་ཆེ་བའི་མཆོག་མོངྒལ་བུ་ཡིས་རྒྱལ་ལ་ཡོངས་ཞུས་པ།",
    "གང་གིས་དཔག་ཏུ་མེད་པའི་འཛུམ་མཛད་པ།",
    "མོངྒལ་བུ་ཡིས་རྒྱལ་ལ་ཉེར་ཞུས་པ་ ཐེ་ཚོམ་གཅོད་མཛད་རྒྱལ་བས་བཀའ་སྩལ་པ།",
    "མོངྒལ་བུ་ཁྱོད་དེ་ལྟར་ཤེས་པར་གྱིས།",
    "བླ་ན་མེད་པ་དག་གི་དགའ་བས་ཁྱབ།",
    "ཚིགས་བཅད་སྣ་ཚོགས་དག་གིས་རྒྱལ་བ་བསྟོད།",
    "ཡན་ལག་བརྒྱད་ལྡན་གསུང་གིས་ལུང་བསྟན་ཏོ།",
    "སྐམ་ལ་བཞུགས་པ་སྲེད་བསྐམས་གང་ཟག་མཆོག་འགྲོ་བའི་དོན་ཕྱིར་ཁྱོད་ཞུ་བཀའ་སྩལ་གསོལ།",
    "བདུད་ཕྲག་སྟོང་དག་གིས་ཀྱང་མི་བསྐྱོད་པ།",
    "ཉོན་མོངས་ཀུན་སྤངས་དེ་ནི་ལུང་བསྟན་པ།",
    "གཞལ་མེད་དགའ་བའི་སེམས་ནི་རབ་དང་བས་ཉོན་མོངས་ཐམས་ཅད་སེལ་ཅིང་མ་སྨད་པ།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་ཨུཏྤལ་མིག་གིས་བཅོམ་ལྡན་འདས་ལ་ཚིགས་སུ་བཅད་པའི་དབྱངས་ཀྱིས་ཞུ་བ་ཞུས་པ།",
    "ཀུན་གཟིགས་མྱུར་དུ་བདག་གི་སོམ་ཉི་ཁུམ།",
    "དེས་པ་ཨུཏྤལ་མིག་གི་ཀླུ་དེས་ནི།",
    "ཉོན་མོངས་ཀུན་གཡོ་ཡིད་ནི་ཞི་གྱུར་ཏེ།",
    "ཁྱོད་ལ་བསྐྱེད་ནས་ཞི་གནས་རྟོགས་གྱུར་ཅིང་།",
    "ཀླུ་དེའི་སྔོན་གྱི་མཐའ་ནི་གཟིགས་པས་ན།",
    "ཞིང་གི་དམ་པ་དག་ཀྱང་འགོད་འགྱུར་ཏེ།",
    "བདེ་གཤེགས་ཁྱོད་སྲས་ཇི་ལྟར་སྤྱད་བགྱིས་ན།",
    "རྐང་གཉིས་དམ་པ་མཆོག་གིས་དེ་ལུང་སྟོན།",
    "ཁ་ན་མ་ཐོ་མེད་ཅིང་གནས་ཞིར་འཇོག་སྟོན་པའི་གསུང་གིས་ཀླུ་དེ་བསྐུལ་བས་ན།",
    "ཚིགས་བཅད་སྣ་ཚོགས་དག་གིས་རྒྱལ་བསྟོད་པ།",
    "ཁྱོད་ཀྱི་ཞལ་དུ་ལྷར་བཅས་འགྲོ་ཀུན་ལྟ།",
    "འདི་ལྟར་ཐལ་མོ་སྤྱར་ནས་སྐྱབས་སུ་མཆི།",
    "འདི་ལྟར་བདེ་གཤེགས་ཁྱོད་ཀྱི་ཡེ་ཤེས་དང་།",
    "སྟོན་པ་ཁྱོད་ཀྱིས་ཐེ་ཚོམ་བསལ་བ་ལྟར།",
    "ཁྱོད་ཀྱིས་བདག་གི་སོམ་ཉི་ཐེ་ཚོམ་བསལ།",
    "གང་ཟག་བདག་གིས་ཀླུ་ཡི་བདག་པོ་ཡི།",
    "ཀླུ་དེ་སྟོན་པའི་གསུང་གིས་དགའ་གྱུར་ནས།",
    "ཁྱོད་ཀྱིས་འགྲོ་བའི་དོན་ནི་རྒྱ་ཆེར་མཛད།",
    "ཉོན་མོངས་ཐམས་ཅད་བསལ་བས་ལུང་། བསྟན་པ།",
    "ཉོན་མོངས་བཅོམ་པས་དེས་ན་རྒྱལ་ཞེས་བྱ།",
    "མཆོག་ཏུ་དད་པ་དག་གི་སེམས་ཀྱང་ཤེས།",
    "སྟོན་པའི་གསུང་གིས་ཀླུ་དེ་དགའ་གྱུར་ནས།",
    "སྟོབས་བཅུའི་འཇིགས་པས་རྣམ་གནོད་ཁྱོད་ལ་ནི།",
    "དེ་དག་ཐམས་ཅད་གཟིགས་པའི་སྤྱོད་ཡུལ་སྤྱོད།",
    "སྟོན་པའི་གསུང་གིས་ཀླུ་དེ་དགའ་གྱུར་ནས།",
    "ཁ་ལོ་སྒྱུར་མཆོག་ཁྱོད་ལ་ཞུ་བགྱི་བ།",
    "འདྲེན་པ་ཁྱོད་སྲས་ཇི་ལྟར་སྤྱད་བགྱིས་ནས།",
    "སྟོན་པའི་གསུང་གིས་ཀླུ་དེ་དགའ་གྱུར་ནས།"
  ]
}