    "འཇམ་དབྱངས་བསྟན་འཛིན་ཁྱོད་ཀྱིས་ངའི་མགུར་འབུམ་པར་དུབ་ཀོད་ན་བསྟན་འགྲོ་ལ་ཕན་ཐོགསཔ་ལོང་།",
    "ཚུལའདི་འདྲའི་མགོན་ཁྱོད་མཛད་པ་རྣམས།",
    "དོན་དེ་ཕྱིར་ཐུན་མོང་གདུལ་བྱའི་ངོར།",
    "སྒྲའི་རྩེམོའི་ཆ་ཤས་ཙམ་ཞིག་ནི།",
    "དེ་ཡང་རྗེ་འདི་ཉིད་མེ་མོ་ལུག་གི་ལོ་བཡབ་དེ་ཉིད་དང་།",
    "རབ་ཏུ་བྱུང་ནས་བསླ་བ་བྱ་རྣམས་མིག་གི་འབྲས་བུ་བཞིན་དུ་སྲུང་བར་མཛད་དོ།",
    "ཉེས་པ་ཆེན་པོའི་དཔུང་འཇོམས་དཔུང་གི་མཆོག།",
    "རྗེ་འདི་ཉིད་ཀྱིས་བསྡུས་སྦྱོར་གྱི་ཐལ་འགྱུར་ཅིག་ཐུགས་ལ་བཀོད་ནས་འདི་ལ་ལན་ཐེབས་མཁན་དཀོན་མོད་བསམས་ནས་ཡོད་ཙ་ན་དེ་ཁོང་གི་ཐུགས་ཀྱིས་མཁྱེན་ཏེ།",
    "དེའི་ལན་འདི་ཡིན་མོད་ཅེས་གསུང་བྱུང་བས།",
    "སྒྲོལ་མ་ཉེར་གཅིག་གི་རྗེས་གནང་།",
    "རྗེ་རང་ཉིད་ཀྱིས་མཛད་པའིགསུང་རྒྱུན་དུ་མའི་ལུང་དང་བཅས་པ་དབར་ལུང་རྗེས་གནང་མན་དགི་སྐོར་རྣམས་བུམ་པ་གང་བྱོའི་ཚུལ་དུ་གསན།",
    "ལྷ་མོ་བཞི་ཞུས་སོ་ཤས་དང་།",
    "བློ་སྦྱོང་སྙན་བརྒྱུདཆེན་མོ་སོགས་བློ་སྦྱོང་གི་སྐོར་མང་བོ།",
    "ཐུགས་རྗེ་ཆེན་པོ་སོགས་ཡི་དམ་གྱི་ལྷ་འག་ལ་ཞིག་གི་རྗེས་གནང་དང་།",
    "ལུང་གི་སྐོར་འགའ་ཞིག་གསན།",
    "རྡོ་རྗེ་ཕག་མོའི་རྗེས་གནང་སོགས་གསན།",
    "དྲིནལན་རེ་དྲན་ཡང་དད་པ་གཡོ།",
    "མཐའ་དབུས་ཀྱི་ལྗོངས་འདིར་ཕྱོགས་རིས་སུམ་སོང་བར་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཞབས་ལ་གཏུགས་ཏེགསུང་གི་བདུད་རྩིའི་བགོ་སྐལ་ལ་སྤྱད་ནས།",
    "རེ་བ་གོང་གྲུབ་པ་ཐོབ་པའི་གནས་བརྒྱད་སོགས་རེབ་གོད་གི་ཕྱོགས་ཀྱི་དབེན་གནས་མང་བོ་དང་།",
    "རོང་བོ་མར་ནང་གིབྲག་དཀར་སོགས་དང་།",
    "སྟག་ཚང་ལྷ་མོ་སོགས་མཛོད་གོ་དང་།",
    "ཡི་དམ་ལྷ་དང་མོ་རྩིས་བྱས་པ་ལ་བརྟེནནས།",
    "ཟང་ཟིང་གི་དྭ་དངོས་པོ་གང་བྱུང་རྣམས་གྲྭ་ཚང་གི་མཐུན་རྐྱེན་དུ་འབུལ་བམཛདཔའི་སྒོནས།",
    "སྐབས་དེརརྗེ་འདི་ཉིད་ཀྱིས་རྒན་གྱའི་གྲྭ་ཚང་གི་བླམར་ཡང་མཛད་ནས་གྲྭ་ཚང་གཉིས་ཀ་སྐྱོང་བར་མཛད་པའི་སྐབས་ཤིག་མར་བསོད་ལ་བྱོན་པས།",
    "དེ་དག་གི་བར་སྐབས་ཤིཤིག་ཏུ་རྗེ་འདི་ཉིད་སྐུ་ཁམས་བསང་བའི་ཕྱིར་ཤིང་དྲུང་ཞིགན་བཞུགས་པའི་ཚེ་བུང་བ་མང་བོ་དང་།",
    "འཇམ་དབྱངས་སྤྱན་རས་གཟིགས།",
    "དགུང་ལོ་སོ་བརྒྱད་བཞེས་པ་ཉི་སྒྲོལ་བྱེད་ཅེས་ཤིང་ཕོ་སྤྲེའུའི་ལོ་ལ་གྲྭ་ཚདགི་འདུ་ཁང་གི་མགོ་བརྩམས་ཏེ།",
    "དབེན་ག་ནས་དེ་ཉིད་རྒྱ་བོད་ཀྱི་ཁྱིམ་པ་ཕོ་མོས་གང་འདུག་པས་ཡི་མུག་པའི་སྐྱོ་བ་དྲག་པོ་བྱུང་།",
    "དེ་དུས་ར་ཤིག་གི་བར་ལ་གྲྭ་ཚང་སྐྱོང་བཞག་གི་བར་ཐུགས་དམ་གྱི་ཉམས་ལེན་དང་ཕྱུག་དཔེ་རྣམས་ལ་གཟིགས་རྟོག་ལེགས་པངམ་ཛད་པས།",
    "དེ་ཡང་གནས་སྐབས་དང་མཐར་ཐུག་གི་ཕན་བདེ་༥༢། ཐམས་ཅད་འགྲུབ་པའི་ཐབས་ནི།",
    "ལང་ཚོ་ཡོལ་བ་རྣམས་ཀྱིས་གནས་པ་བདེ།",
    "ཁྱོད་ཀྱིས་མཚན་ཉིད་ཀྱི་གྲྭ་ཚང་སྐྱོ་ས་ལ།་",
    "རི་ཁྲོད་པ་བརྒྱ་ལྷག་རེ་མི་འདུ་བའི་ངེས་པ་ཡང་མེད།",
    "རི་ཁྲོད་པ་ཧོར་ཚད་ལྷུན་གྲུབ་ཚང་གིས།",
    "དེ་ནས་བཟུང་སྟེ་ཁོང་གི་ཐུགས་ལ་མི་ངེས་པ་རྨི་བདེ་བའི་སྐབས་འགའ་ཡོད་པ་ཐམས་ཅམངས་འདུག་གསུངས།",
    "གསེར་ཞུནམས་བྲིས་པའི་བརྒྱད་སྟོང་བའི་གླེགས་བམ་ཞིག་ཞལ་ཕྱེ་ཕྱེ་ནས་ཡོད་པ་ཞིགརྨིས་པས་ཁོང་གི་ཞལ་བོ་བཀའ་བཅུ་བ་འདི་གང་ཟགཁྱ་དཔརཅན་ཞིག་ཡིན་འདུག་ངལ་རྨི་ལམ་འདི་ལྟ་བུ་ཞིག་བྱུང་ཞེས་གྲོགས་རྣམས་ལ་སྨྲས་པ་རྗེ་ཉིད་ཀྱིས་ཀྱང་ཐོས་གསུངས།",
    "ཡང་གྲུབ་ཆེན་གོང་མའི་བཞུགས་གནས་ཅིག་ཏུ་བྲ་བགཅིག་གི་རྨི་ལམ་དུ།",
    "ས་མོ་ཕག་གི་ལོའི་ཟླ་བ་དངཔོའ་ཅུང་ཟད་བསྟུར་བའི་ཚུལ་བསྟན་པའི་ཚེ།",
    "ཕྱག་རྔུ་ལ་ཡང་ཡང་བལྟས་ཀྱང་སྔར་ལུགས་བཞིན་དུ་གནས་པ་སོགས་བྱུང་བས་བཞུགསསུ་རེ་ནས།",
    "ཉི་མའི་འོད་གསལ་འཇའཚོན་བླ་རེ་བྲེས།",
    "རེབ་གོང་ཕྱོགས་སུ་སྤྱན་འདྲེན་མཛད་པའི་ཚེ།",
    "སྐུ་ལུས་རེསའགའ་ཡང་ཞིང་རེས་འགའ་ལྕི།",
    "ལ་ལས་སྤྱན་གྱིས་གཟིགས་པར་མཐོར་བ་དང་།",
    "དགུང་ལོ་ལྔ་བཅུ་རྩ་ལྔ་རྩ་དྲུག་གི་སྐབས་ཤིག་བསྟ་བདག་ཆེན་པོ་ཞིང་སྐྱོང་ནངསོས་ཙོང་ཁའི་ཕྱོགས་སུ་སྨྱོན་དྲངས་ཏེ་མ་ཎི་བུམ་སྒྲུབ་ཀྱི་ཚོགས་དཔོན་མཛད་ནས།",
    "ནམ་མཁའི་མཐོངས་སུ་ཤར་བའི་སྣེ་གཅིག་བྱང་གི་ཕྱོགས་སུ་མི་མཐོངབ་ཙམ་དང་།",
    "ཁོར་གི་དགོངས་རྫོགས་ལ་དམིགས་ནས།",
    "བཀྲ་ཤིས་འཁྱིལ་དུ་ཕེབས་ནས་ཟླ་བ་གཅིག་གི་རིང་ལ་སྙམཚམས་དམ་པོ་མཛད་ནས་བཞུགས་པ་སཁམས་པར་དྭངས།",
    "དངསལོ་འདི་ཙམ་ན་འབོད་མཁན་ཅིག་གཏོང་གི་དེ་དུས་ཤོག་གསུངས་པཅིག་རྨིས་པས།",
    "རྗེ་འདི་ཉིད་ཀྱིས་བདག་དང་གྲྭ་ཚང་གི་གྲྭ་བ་འགའ་ཞིག་ཞབས་ཕྱིར་ཁྲིད་དེ།",
    "ཕྱོགས་དེའི་སྐྱ་སེར་ཐམསད་ང་སྔུས་མ་ཎི་དུང་ཕྱུར་གཅིག་གི་མགོ་བཙུགས་ནས་འཕྲོ་ཁོ་རང་ཚོ་ལ་བསྒྲུབ་ཏུ་བཙུག་སྟེ།་",
    "ནང་གི་དགོན་གསར་གྱེས་ཐང་དུ་ཕེབས་ནས་ཀྱང་།",
    "ལྷ་དྲགགི་སྟེརྗེ་ཆེན་པོ་ཁ་སར་པཱ་ཎི་དང་།",
    "ཐུག་པ་ཆེནཔོ་ཅ་པཱུཀ་། གནས་བརྟན་བཅུ་དྲུག་དང་བཅས་པའི་ཞལ་གཟིགས་ལེགས་པར་བྱུང་གསུངས།",
    "མིང་ངོ་ཁྱོད་ཀྱིས་མ་ཤེས་ན།",
    "ཆིབས་ལས་གཞོལ་ཏེ་ཕྱག་འབུལ་གནང་སོང་།",
    "རྗེ་འདི་ཉིད་ལ་གཡོན་བསྐོར་ཞིག་བྱས་ནས་སླར་རང་གཞས་སུ་འཕུར་སོང་བཞིག་བྱུང་།",
    "དེ་ནས་བྲག་དཀར་དུ་ཕེབས་ནས་རྒྱུནརིང་ཙམ་བཞུགས་པའི་སྐབས་ཚོ་ལ་ཞལ་གཟིག་དབྱུད་སྟེ།",
    "རྗེ་བཙུན་མི་ལ་དང་རྗེ་མར་བ་གཉིས་བཞུགས་པ་ཞལ་གཟིགས།",
    "ཁྱོད་ཀྱིས་ཟུངས་ལ་གཞན་ཕན་མཛོད།",
    "རྗེ་འདི་པ་ཡང་སྐབས་མང་བོརགནས་དེར་ཕེབས་ནས་སྒྲུབ་པ་རྩེ་གཅིག་ཏུམཛད་ར་བཞུགས་རིང་ཚོ་ལ་ཉམས་མགུར་ཡང་མང་དུགསུངས་པ་ནི་འདི་ལྟར།",
    "དེ་ཚོ་ལ་ཡང་རྗེ་འདི་ཉིད་ཀྱིས་། གྲུབ་རྟགས་བསྟན་པ་རེད་ཅེས་ཐམས་ཀྱིས་གླེང་ངོ།",
    "བསགས་སྦྱང་རྒྱ་ཆེན་པོ་མསོང་བར་ཁྲིད་ཉན་ཀྱང་རྒྱུད་ལམི་སྐྱེ།",
    "དེ་དག་གི་ཚུལ་རྗེ་ཉིད་ཀྱིས་ཉམས་མགུར་དུ་བ་ཞེས་པ་ནི།",
    "ཁྱོད་ཀྱི་སར་གནས་ཀྱི་སེམས་དཔའ་གསུམ་ལ་ཞབས་ཏོག་བྱེདཔ་འོང་ཞེས་པ་ཡོད་པས།",
    "རྗེའ་དི་ཉིད་པ་མགོན་པོ་ཚེ་དཔག་མེད་ཀྱི་ཞལ་གཟིགས་ཤིང་།",
    "ཆུ་དམར་བློ་བཟང་ཚང་གིས་གཙོ་བྱས་ཨལའབུལ་རྒྱུ་བསྐུར་པ་གནང་།",
    "ད་རེས་ཐུགས་བྲེལ་ཆེབས་གསུང་ཐུབ་པ་མི་འདུག་ཁྱེད་ཚེ་ཐམས་ཅད་ཀྱིས་དུས་རྒྱུན་དུ་ཁོར་ལ་གསོལ་བ་དྲག་ཏུ་ཐོབ་དང་།",
    "དགུང་ལོ་རེ་གསུམ་བཞེས་བ་ས་མོ་བྱའི་ལོ་ལ།",
    "ཞུ་གས་རིང་ལ་སྤྱན་བཙུམས་ནས་བཞུགས་ནའང་སྒྲོལ་མ་ལྷ་ཁང་གི་ལྷ་ཐམས་ཅད་གསལ་བོར་མཐོང་གིནང་དུག་གསུངས།",
    "བདག་གིས་ཀྱང་དུད་པ་བྱས་ན་དེར་ཉན་ནོ་ཞེས་འཕྲིན་ཡིག་དང་།",
    "རྨི་ལམ་ཡང་མ་ཡིན་མངོན་སུམ་པངམ་ཡིན་གཉིད་མ་སོང་བའི་སྐབས་དེལྟ་བུ་ཡིན།",
    "ཁོང་གིས་ཕྱག་ཕུལ་ན་དགོངས་པ་དང་ཕྱག་གཡོང་།་",
    "རྗེ་བཙུན་ཙོང་ཁ་ཆེན་པོ་རྣལ་འབྱོར་པ་ཕྱག་ཞཆུ་ཤིང་གི་འཁར་བ་བསྣམསང་ཞིག་གི་རྣམ་པར་བྱོནནས།",
    "གསུངས་པ་དེ་ཅི་ལ་ཟེར་རྒྱུ་རེ་དེ་ལགས་ཞུས་པ་ལ།",
    "རྗེ་ཁྱོདཉིད་སྲིད་མཐར་ཞབས་པད་བརྟན།",
    "དོན་དེ་སྒྲོགས་ལྷ་བྱ་གོང་མོ་དེ།",
    "གླུ་འབྲུག་སྒྲ་ལྡིར་ཞིང་སོང་ངོ་ལགས།",
    "ཁོང་གི་ཞལ་ནས།",
    "ན་མོ་གུ་རུ་མཉྫུ་གྷོ་ཥཱ་ཡ།",
    "ཇོ་བོ་ཡེར་བའི་བྲག་ལབཞུགས་པའི་སྐབས་ཤིག་འབྲོམ་རྒྱལ་བའི་འབྱུང་གནས་ཀྱིས་ཁྱེ་སྔོན་པོ་སོགས་དབྱས་ཏནས་ཁྱེའུ་རེ་རེས་ཀྱང་འབུལ་བའི་རྣམ་གྲངས་མང་དུངུལ་བའི་དུས་ཀྱི་ཁྲེའུ་དཀར་བོ་ཞིག་ཡིན།",
    "གལ་ཏ་ཁྱོད་རང་གིས་ནན་དེ་ལྟར་བྱེད་ནུབཀའ་གདམས་གླེགས་བམ་སོགས་ལ་གཟི་ཤེས་དང་མེ་འཕྲད་པ་བཞིན་དུ་འགྲོ་བས།",
    "དྲུང་འཁོར་འགའ་ཞིག་གིས་ཞལ་ཕྱིར་ཡང་ཡང་གཟིགས་པ་ཅི་ཡིན་ཞུས་པས།",
    "གྱིས་བཞེས་པ་རེད་བསམས་པ་བྱུང་།",
    "མཛད་པའི་འཕེནཔ་བཏར་སྦྱོང་སོགས་བློ་སྦྱོང་གི་སྐོར་དང་།",
    "ལན་ཅིག་ལོ་རྙིང་གི་སྐུ་རིམ་ལ་སྒང་གི་གཟིམས་ཁང་དུ་ཕེབས་ནས།",
    "བདེ་མཆོག་རྒྱུད་ཀྱང་ཚང་མ་རེ་གསུངསབཞི་གདུང་།",
    "ཆུ་མོ་གླང་གི་ལོའི་ལོ་སར་གྱི་སྐབས་སུ་བདག་དབུས་ནས་ཕྱིར་སླེབསཏེ།",
    "བསྡུས་སྦྱོར་དང་གཞུང་ཆེན་མོ་གང་ལ་ཡང་སུ་གང་གིའང་རིགས་པས་འགྲན་དུ་ཆེ།",
    "ཟནམོང་མ་ཡིན་པ་རྫོགས་རིམ་གྱི་རྟོགས་པ་ཁྱད་པར་ཅན་བརྙེས་པ་པ་བརྟེནནས།",
    "། ཡོན་ཏན་རེ་རེས་ང་རྒྱལ་ནས།",
    "རབ་བྱུང་པ་མོས་ན་བཟའི་ཚལ་བུ་ཡང་།",
    "ལྷང་ལྷང་འཐེན་པའི་གཟིགས་སྣང་གསམལ་བར་བྱུང་།",
    "ལོ་དེའི་སྟོན་དུས་རེབ་གོང་ཡུལ་ཕྱོགས་སུ།",
    "སྐྱེ་དགུའི་ཕན་བདེའི་རྩ་བར་ལེགས་གཟིགས་ནས།",
    "རིགས་གཏད་ཟབ་མོའི་བཀའ་དྲིན་རྫོགས་པར་མནོས།",
    "ལྕགས་མོ་ལུག་པ་མཚུངས་མེད་ཐམསཅད་མཁྱེན།",
    "ཆུ་མོ་བྱ་པ་སྙིགས་དུས་ཤཱཀྱའི་གཙོ།",
    "མཐོང་བའི་མོད་ལ་ཐུགས་ནི་ཆེར་གཡོས་ནས།",
    "འདི་ལྟའི་ས་ཕྱོགས་མིག་གིས་མི་མཇོར་ཞིང་།",
    "རེང་གོང་ཕྱོགས་ཀྱི་རོང་འབྲོག་མང་བོལ།",
    "ཆུ་མོ་ལུག་པོའི་དབྱར་གྱི་དུས་ཀྱི་ཚེ།",
    "ཡང་འགྱེད་ལེགས་བསྒྲུབས་པཎ་ཆེན་ཐམས་ཅད་མཁྱོན།",
    "འབུལ་བ་ཞབས་ཏོག་རྫོགས་ལྡན་སྤྲིན་བཞིན་བསྒྲུབས་རྣམས་ཕལཆད་འདུ་ཁང་ཚོན་རྩི་དང་།",
    "ཁྱོན་མོའི་སྡིག་རྒྱུན་ལེགས་པར་གཅོད་པ་དང་།",
    "སླར་ཡངས་མོ་ཀླང་པོའི་དབྱར་གྱི་དུས།",
    "རངགི་འཁྲུངས་ཡུལ་རེབ་གོང་ཕྱོགས་སུ་བྱོན།",
    "ལམ་གྱི་ཡོ་བྱད་གང་ལེགས་དབུས་གཙང་གི།",
    "ཡོས་ལོའི་དབྱར་སྟོན་ནས་བཟུད་འབྲུག་གི།",
    "ཆུ་མོ་སྦྲུལ་ལོའི་ཧོར་ཟླ་བདུནཔ་ལ།",
    "ཤིངམོ་ལུག་ལོའི་དབྱརསོས་དུས་ཀྱི་ཚེ།",
    "རེབ་གོང་ཕྱོགས་སུ་སྤུནའདྲེན་མཛད་པའི་ཚེ།",
    "སྐུ་ལུས་རེས་འགའ་ཡང་ཞིང་རེས་འགའ་ལྕི།",
    "ལ་ལས་སྤྱན་གྱིས་གཟིགས་པང་མཐོང་བ་དང་།",
    "ནསབདུན་ཆུ་དོན་དགུབས་མོ་ཕག་གི་བར་སྒྲུབ་པ་རྩེ་གཅིག་ཏུ་མཛད།",
    "ངམ་ཤུགས་ཀྱིས་རྙེད་པའི་ནོར་རྫས་རྣམས་བླམ་དཀོན་ཅོག་གི་ཕྱོགས་སུབ་ཏང་པ་ཡིན།",
    "འཇའ་ཚོན་གྱི་རྩེ་མོ་རྣམསརེབགོང་ཕྱོགས་ལ་བསྟན་འདུག་ཟེར།",
    "འདིའི་གནས་ཚུལ་གྱི་སྐད་ཆ་མངའ་རིས་དྲུང་པ་རྒྱལ་ཚབ་པསོགས་དབུསགཙང་གི་མཁས་གྲུབ་མངབོས་གསན་ནང་ཏིང་འཛིན་གྱི་སྟོབས་ཡིན་པར་འདུག།",
    "ཁོ་བོ་ལ་ཁྱོདམཚན་ཉིད་པ་ཡིན་ཀྱང་།",
    "ན་ཤིན་ཏུ་གཞོན་པའི་དུས་ནས་རྩེད་མོ་དང་ཀུ་རེ་སོགས་བག་མེདཔའི་གནས་ལ་བསམ་པ་གཏིང་ནས་ལོག་བས་གྱེད་མོ་སོགས་ཚེརམི་མཛད་ཅིང་།",
    "གསུང་ཐོས་པས་མོས་གུས་ཚད་ལས་འདས་པ་འཁྲུངས།"
  ]
}