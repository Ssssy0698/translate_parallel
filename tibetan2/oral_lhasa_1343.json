    "གདན་གྱི་ཁྱད་པར་མི་འདྲ་སྟེ།",
    "མངོན་བྱང་བཞི་པ་མཚུངས་པར་སྦྱར།",
    "ཁྱད་པར་ཡོད་པ་མ་ཡིན་ཞེས།",
    "རྫོགས་པའི་རིམ་པའང་མཚུངས་པར་སྦྱར།",
    "དེ་ལྟར་མཉམ་པར་བཞག་པ་ལས་ལངས་ཏེ།",
    "གཞན་མཉམ་པར་མ་བཞག་པའི་རྣལ་འབྱོར་རྣམས་ཀྱི་བཟླས་པའི་རྣལ་འབྱོར་ལ།",
    "ཡང་ན་ལྷའི་རྣལ་འབྱོར་གྱིས་གནས་པར་བྱའོ།",
    "ཐུན་མཚམས་ཀྱི་བྱ་བ་ཐམས་ཅད་གོང་དང་མཐུན་པར་སྤྱད་དོ་ཞེས་གསུང་ངོ།",
    "སྙན་པར་སྨྲ་བ་དང་།",
    "སྡུག་པ་དང་མི་སྡུག་པས་བྱས་པའི་ལྟ་བ་སྟོང་པ་ཉིད་དུ་མཐོང་བ་དང་།",
    "ཕྱག་ནི་སྟོང་པ་བཅུ་དྲུག་མཚོན་པར་བྱེད་པ་སྟེ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་།",
    "བཙུན་མའི་ཞུ་བདེའི་ཡེ་ཤེས་ཏེ་དེ་ལྟ་བུ་དང་ལྡན་པས་དོན་གྱི་ཡེ་ཤེས་རྟོགས་པར་ཤོག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རྣལ་འབྱོར་པ་མཆོག་ལ་བཟོད་པར་གསོལ་ཞིང་ཁེངས་བསྐྱུང་བ་ནི།",
