    "དྲོད་དང་ནུས་པ་ཐོབ་པར་བསྟན་ཏེ།",
    "རྒྱུ་བཞི་དང་ལྡན་པས་བརྩམས་པར་རིགས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་དེ་རྟོགས་ནས་ལམ་ཁྱད་པར་ཅན་ལ་འཇུག་པར་གྱུར་ཅིག་པར་བསྟན་པའོ།",
    "རྣམ་པར་ཕྱེ་ལས་ངལ་བར་གྱུར་པ་ཡི།",
    "འགྲོ་བའི་མ་རིག་དཔྱིས་འབྱིན་བྱེད་པར་ཤོག།",
    "རྫོགས་སོ། གུ་རུས་དཔར་རྩ་སྤེལ་བའོ།",
    "དཔལ་ནག་པོ་ཆེན་པོའི་གཞུང་ལགས་སོ།",
    "སྙམ་དུ་བློ་ནི་བསྐྱེད་བྱས་ལ།",
    "སྐད་ཅིག་སྟོང་པར་བསྒོམ་བྱས་ཏེ།",
    "གདུག་པ་མ་ལུས་ཞི་བྱས་ཏེ།",
    "དགུག་གཞུག་བརྟན་དང་མཉེས་པར་བྱ།",
    "མན་ངག་བཞིན་དུ་བཟླས་པར་བྱ།",
    "རྐང་པ་བརྒྱད་པས་བསྟོད་པར་བྱ།",
    "བར་དུ་འབད་དེ་བསྒྲུབ་པར་བྱ།",
    "། གདུལ་ཞིང་སྣོད་བཅུད་ཀྱི་འཇིག་རྟེན་རིམ་པར་ཕྱེ་བ།",
    "སུ་དེ་ཤི་ཀཱ་ལེགས་པར་སྟོན་པ།",
    "མིང་དེ་གསུམ་ནི་བརྗོད་བྱ་གཙོ་བོར་བྱས་པ་ཡིན་ལ།",
    "འདི་ནི་རྗོད་བྱེད་གཙོ་བོར་བྱས་པའོ།",
    "བི་ཀྲ་མ་ཤཱི་ལའི་གཙུག་ལག་ཁང་ན་བཞུགས་པའི་མཁས་པ་རྣམས་ཀྱིས་བསྟན་བཅོས་ཐམས་ཅད་རྩིས་འགོ་ཡན་ལག་ལྔ་ཡིས་འཆད་པར་བྱེད་དེ།",
