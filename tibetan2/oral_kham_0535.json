    "སེང་གེའི་ཁྲི། ། ལྷ་སར་སླེབས་པའི་དགུན་དུས་དང་པོ་དེའི་གནས་ཚུལ་རྣམས་དེ་ཙམ་དྲན་གྱི་མི་འདུག།",
    "མཛད་སྒོ་དེའི་སྐོར་ཡང་དེ་ཙམ་དྲན་གྱི་མི་འདུག།",
    "ཅེས་སྔོན་བརྡ་ཕུལ་འདུགདེ་ལྟ་ནའང་གནས་སྟངས་དེའི་ཐོག་རྒྱུན་རིང་པོ་གནས་ཐུབ་མེད།",
    "དྲན་སོས་པར་ཐེངས་གཅིག་ནམ་རྒྱུན་ལས་རྒྱུན་རིང་བ་གཉིད་ཤོར་འདུག་པས།",
    "དབྱིན་ཡིག་མ་དཔེ་དཔར་ཐེངས་དང་པོའི་ནང་སྐྱུང་ཀ་ཞེས་འཁོད་འདུག་ན་དེ་གཉིས་པོ་ཁུངས་བཙན་པར་བརྩིས་སོ།",
    "རྗེས་སུ་ང་རང་ཆེ་རུ་ཕྱིན་རྗེས་ཡང་བསྐར་མེ་ཁེ་ནོ་ཡོ་ཆས་ཐོལ་པ་ཁ་ཤས་འདིའི་དོན་ནི།",
    "གསེར་གྱི་ཆུ་ཚོད་ཧ་ཅང་རྫིག་པོ་ཞིག་བཅས་ཕྱག་རྟགས་སུ་བསྣམས་ཕེབས་འདུག།",
    "ཕྲུ་གུ་ཆུང་ཆུང་ཞིག་ཡིན་པའི་ཆ་ནས་གོས་ཆེན་གྱི་ཐང་བསྒྲིལ་ལ་དགའ་སྣང་སྐྱེ་ཐུབ་ཀྱི་མི་འདུགཡང་ངོས་ལ་ང་རང་ཧ་ཅང་དགའ་པོ་ཡོད་པའི་ཆུ་ཚོད་འཁོར་ལོའི་མེ་འཁོར་གྱི་རྩེད་ཆས་ཡག་པོ་ཞིག་དང་ཞ་ཉེའི་དམག་མིའི་རྩེད་ཆས་ཧ་ཅང་ཡག་པོ་ཞིག་ཡོད།",
    "ངོས་རང་ལག་པ་བདེ་པོ་གང་འཚམ་ཡོད་པར་བརྟེན་འདི་བར་ང་རང་འགྲན་བསྡུར་ཤོར་དོགས་པའི་སེམས་ཁྲལ་མེད།",
    "ངོས་ནས་སྐུ་མདུན་སྐུ་གོང་མའི་སྐུ་ཆས་ནང་རྩེ་ཏོག་ཏུ་བ་སོའི་མཛེས་རྒྱན་བསྐོན་ཡོད་པའི་ཕྱག་འཁར་ཞིག་འདུག་པ་དེ་རྩེད་ཆས་སུ་བེད་སྤྱོད་བྱེད་རྒྱུར་ཉར་གྱི་ཡོད།",
    "སྡོད་ཤག་དེ་གྲིབ་ནག་ནང་རང་འཇགས་སེང་གེའི་ཁྲི།",
    "འདི་ལ་བརྟེན་ནས་ག་དུས་ཡིན་ཡང་ས་རུབ་རྗེས་ཁང་པའི་ནང་དུ་ཡར་འཛུལ་ཚར་བ་ངེས་གཏན་བྱེད་ཀྱི་ཡོད།",
    "ཀྱང་གཞུང་གནས་ནས་དེ་བཀག་འགོག་གནང་འདུག།",
    "སྐུ་གོང་མའི་སྐུ་ཆས་ཁོངས་སུ་འཛམ་གླིང་དམག་ཆེན་དང་པོའི་སྐོར་གྱི་དབྱིན་སྐད་ཀྱི་པར་དེབ་དེ་འདྲ་ཆག་པ་མང་པོ་འདུག།",
    "དེ་གཉིས་ཀ་ངོས་རང་ལ་ཧ་ཅང་ཆེ་དྲགས་འདུག་སྟབས་དེ་ཚོའི་ནང་རས་ཧྲུག་བརྒྱངས་ཏེ་ཏག་ཏག་བྱེད་ཀྱི་ཡོད་པ་ལྟ་བུ་བཟོས་པ་ཡིན།",
    "དེ་སྐུ་གོང་མ་དང་རུ་སུའི་རྒྱལ་པོ་ཛར་གཉིས་དབར་འབྲེལ་བ་ཡག་པོ་ཡོད་སྟབས་ཛར་གྱིས་སྐུ་གོང་མར་ཕྱག་རྟགས་བསྐུར་བ་ཞིག་ཡིན་འདུག།",
    "འཕྲུལ་སྒམ་དེ་འཁོར་སྐྱོད་བྱེད་ཀྱི་མི་འདུག་པས་བཟོ་ཐབས་བྱས་པ་ཡིན།",
    "ནེ་ཙོ་དེས་ང་རང་ལའང་དེ་མཚུངས་དགའ་པོ་བྱེད་རོགས་བྱས་ན་སྙམ་སྟེ་དེར་བྱམས་པོ་ཐེངས་ཁ་ཤས་བྱས་ཀྱང་དོན་སྨིན་མ་བྱུང་།",
    "སྐབས་དེར་ཕྲན་ཆུའི་ནང་དུ་ལྷུང་སྟེ་ཆུའི་ནང་དིམ་འགོ་ཚུགས་ཡོད་འདུག།",
    "མི་དེའི་མིང་དྲན་གྱི་མི་འདུག་ཀྱང་ནམ་ཡང་བརྗེད་མི་ཐུབ་པའི་གནས་ཚུལ་ཞིག་ལ།",
    "དེ་དང་ཆབས་ཅིག་རྟག་ཏུ་གུས་ཞབས་དང་ཡ་རབས་བྱེད་སྟངས་རྣམས་ཧ་ཅང་ཡག་པོ་བྱེད་ཀྱི་འདུག།",
    "འོན་ཀྱང་དེ་རྗེས་སྣུམ་འཁོར་དེ་རྣམས་བེད་སྤྱོད་མེད་པར་ལུས་ཏེ་ནོར་གླིང་དུ་ཁང་པ་ཞིག་ནང་བཟོ་བཅོས་མེད་པར་བཞག་འདུག།",
    "འོན་ཀྱང་བཟོད་སྒོམ་ཐུབ་ཀྱི་མི་འདུག་པས་ཉིན་གཅིག་ཁ་ལོ་བ་ཁོ་པ་ས་ཆ་གཞན་ཞིག་ཏུ་ཕྱིན་པ་ཤེས་སྐབས་སྣུམ་འཁོར་དེ་ཚོའི་ཁོངས་ནས་གཅིག་ཕྱི་ལོགས་སུ་ཁྲིད་དེ་གཏོང་རྒྱུ་ཐག་བཅད་པ་ཡིན།",
    "བཀྲ་ཤིས་ཚེ་རིང་ནམ་ཡང་བརྗེད་ཀྱི་མི་འདུག།",
    "ག་དུས་ཡིན་ཡང་དུས་ཆེན་འདིའི་ཐོག་ཚོར་སྣང་འདྲེས་མ་ཞིག་སྐྱེས་ཀྱི་ཡོད།",
    "ཏེ་སྡོད་ཀྱི་འདུག།",
    "ལོ་བདུན་བརྒྱད་ཙམ་ཡིན་སྐབས་གཙུག་ལག་ཁང་དུ་སྡོད་ཐེངས་དང་པོ་དང་གཉིས་པའི་སྐབས་ཞབས་འདྲེན་ཏོག་ཙམ་ཞུས་ཡོད་པ་དྲན་སོས་ཀྱི་འདུག།",
    "འོན་ཀྱང་གཙུག་ལག་ཁང་མཐའ་སྐོར་གྱི་བར་སྐོར་གྱི་ལམ་དེ་ད་ལྟའང་ཡོད་མུས་ཡིན་འདུག།",
    "རྩེད་འགྲན་བྱེད་མཁན་ཚོའི་ཁྲོད་ནས་ཁ་ཤས་ཀྱིས་འགྲམ་ནས་རྒྱུག་མཁན་གྱི་རྟ་རྣམས་ཀྱི་རྔ་མ་ནས་འཇུས་ཏེ་སོ་སོ་རྟས་འཐེན་དུ་བཅུག་ཡོད་འདུག།",
    "སྟབས་མ་ལེགས་པར་ཁ་ཟས་བཟོ་ཐེངས་གཉིས་པ་འདིའི་སྐབས་ཕྲན་གྱི་ཆེད་དུ་ཆེད་མངགས་ཟུར་དུ་བཞག་པའི་སྣུམ་དེ་ཙག་ལེགས་པོ་ཆོད་མི་འདུག་པས།",
    "དེ་སྐབས་ག་དུས་ཡིན་ཡང་སྐུ་མདུན་སྐུ་གོང་མའི་གནང་སྟངས་ལྟར་བྱེད་ཐུབ་པའི་ལོ་ཚད་ལ་གང་མགྱོགས་བསླེབ་རོགས་བྱས་ན་སྙམ་གྱི་ཡོད།",
    "འདིའི་ཐོག་བསམ་བློ་གཏོང་སྐབས་ཕྲུ་གུ་སྤྱོད་པ་འཚུབ་པོ་དེས་ལས་ཀ་ཡག་པོ་ཞིག་ཀྱང་བྱས་འདུག་སྙམ་པ་དྲན་གྱི་ཡོད།",
    "རྩིག་ངོས་ཀྱི་འདྲ་པར་ཁ་ཤས་ཀྱོག་ཀྱོག་ཆགས་འདུག།",
    "མི་ཁ་ཤས་ཀྱིས་སྐད་སྒྲ་ཡོང་ས་དེའི་ཕྱོགས་ཀྱི་ནམ་མཁའི་ནང་འོད་མདངས་དམར་པོ་ཁྱད་མཚར་པོ་དེ་འདྲ་མཐོང་མཁན་ཡང་བྱུང་འདུག།",
    "རིམ་པས་གསལ་པོ་ཆགས་པར་དེ་བོད་ཀྱི་ཤར་ནུབ་ཀྱི་ཕྱོགས་ཡོངས་རྫོགས་སུ་མི་མང་པོས་ཚོར་ཡོད་པ་ཞིག་ཡིན་འདུག།",
    "ནུབ་ཕྱོགས་སུ་ལྷ་ས་ནས་མེ་ལི་སུམ་བརྒྱའི་མཚམས་ན་ས་སྐྱའི་བར་དུ་དེ་ཚོར་འདུག།",
    "ཉིན་ཤས་རྗེས་ཧེན་རིག་ཧ་རར་ཐུག་སྐབས་ཁྱེད་རང་ལྟར་ན་ས་ཡོམ་གཅིག་པུ་མིན་པར།",
    "གནས་ཚུལ་ཉེན་ཁ་ཆེན་པོ་ཞིག་བྱུང་ཡོད་པ་ཐག་ཆོད་སྙམ་སྟེ་ཤེས་འདོད་ཀྱིས་སྒོམ་ཐུབ་ཀྱི་མི་འདུག།",
    "དེའི་ནང་རྒྱ་མིས་བོད་ཀྱི་དམག་སྒར་ཐོག་དྲག་རྒོལ་བྱས་ཏེ་བོད་པའི་འགོ་དཔོན་དེར་སྲོག་སྐྱོན་བྱུང་འདུག་ཅེས་བཀོད་ཡོད་འདུག།",
    "ཀུ་ཤུ་དེ་མིད་རྒྱུ་དཀའ་ལས་ཁག་པོ་བྱུང་བ་ད་ལྟའང་དྲན་གྱི་འདུག།",
    "དེ་སྐབས་ནམ་ཆ་ཚང་ལངས་མེད་པས་ཚང་མ་གསལ་པོ་མཐོང་ཐུབ་ཀྱི་མི་འདུག།",
    "དེ་མིན་གཅིན་པ་བྲོ་བའི་ཚོར་སྣང་ཤུགས་ཆེ་རུ་ཆེ་རུ་ཕྱིན་པ་མ་གཏོགས་གཞན་གང་ཡང་དྲན་གྱི་མི་འདུག།",
    "ད་ལན་ང་རང་ལ་མི་མང་དཀྱུས་མ་ཚོའི་མི་ཚེའི་གནས་སྟངས་ངོ་མ་ཇི་འདྲ་ཡིན་མིན་ཤེས་རྟོགས་ཐུབ་རྒྱུའི་གོ་སྐབས་རྩ་ཆེན་པོ་ཞིག་རག་ཡོད་པ་ཤེས་བྱུང་།",
    "ཆིབས་བསུ་ཞུ་མཁན་མི་མང་བརྒྱ་ཕྲག་མང་པོ་འདུ་འཛོམས་བྱས་འདུག་ལ།",
    "པ་ཞིག་འདུག།",
    "འོན་ཀྱང་ས་ཆ་འདིའི་ཡུལ་ལྗོངས་ཀྱི་མཛེས་བཀོད་ཧ་ཅང་ལེགས་པོ་འདུག།",
    "རྒྱུག་ཆུ་དེའི་ཕར་ཕྱོགས་སུ་དེ་ཙམ་ཐག་མི་རིང་བའི་སར་རི་གཟར་ཞིག་འདུག།",
    "རྒྱུག་ཆུའི་དཀྱུས་ཀྱི་མཚམས་འགའ་ཞིག་ཏུ་གཡས་གཡོན་གཉིས་ཀར་རི་ཁ་ཤས་གནམ་སྔོ་ཐིང་ངེར་ཡོད་པའི་ནང་ཡར་ཁར་ཐུག་ལངས་ཏེ་བསྡད་ཡོད་པ་དེ་འདྲ་འདུག།",
    "རི་ཆེ་ཞིང་མཐོ་བ་དེ་དག་ཀྱང་ཐག་རིང་པོ་མིན་པའི་ས་ན་འདུག།",
    "ལྷ་ས་ནས་མ་ཐོན་གོང་ཕྱི་རྒྱལ་ཁག་ལ་བཏང་བའི་སྐུ་ཚབ་ཚོགས་པ་ཚོའི་ཁོངས་ནས་རྒྱ་ནག་ཏུ་སྐྱོད་མཁན་དེ་མ་གཏོགས་གཞན་ཚང་མ་འགྲོ་སའི་དམིགས་ཡུལ་གྱི་རྒྱལ་ཁབ་དེ་ཚོར་སླེབས་ཐུབ་མི་འདུག།",
    "དེ་དུས་གནས་ཚུལ་དེའི་ཤུགས་རྐྱེན་གང་ཡིན་རྟོགས་སྐབས་སེམས་ནང་སྐྱོ་སྣང་ཧ་ཅང་ཆེན་པོས་ཁེངས་པ་དྲན་སོས་ཀྱི་འདུག།",
    "ཁོ་པ་ཉིད་དངོས་སུ་པེ་ཅིང་ལ་རྒྱ་མིའི་མཉམ་སྐད་ཆ་ཤོད་པར་སྐྱོད་ཆོག་ཅེས་འཆར་སྟོན་བྱས་འདུག།",
    "ངོས་འཕྲལ་དུ་རྒྱ་གར་ལ་ཐོན་དགོས་ཞེས་འབོད་སྐུལ་ཤུགས་ཆེན་པོ་གནང་འདུག།",
    "དེ་སྐབས་ཁོང་ནས་ཀ་ལི་ཀ་ཏར་ཡོད་པའི་ཨ་རིའི་དོན་གཅོད་ཁང་དེར་འབྲེལ་གཏུགས་བྱས་ཏེ་ཁོང་རང་ཨ་རིར་བསྐྱོད་རྒྱུའི་ཆོག་མཆན་ཐོབ་ཟིན་འདུག།",
    "ཕྲན་འཕྲལ་དུ་རྒྱ་གར་ནང་ཡོང་ཐུབ་པ་བྱ་གལ་ཤིན་ཏུ་ཆེ་ཞེས་བཀོད་འདུག།",
    "ཁོ་པ་ངའི་སྔོན་ཙམ་དུ་ལྷ་ས་ནས་ཐོན་ཏེ་ཀ་སྦུག་ཏུ་བསྡད་ཡོད་འདུག།"
  ]
}