    "ངེས་པར་གནོད་མཛེས་ནི་གསོད་པ་གཙོ་བོའི་ལས་ས་སོ།",
    "ཆོ་ག་ནི་གང་རྒྱུད་གཞན་དུ་གསུངས་པ་སྟེ་དེར་མཐོང་བའོ།",
    "དེ་ལྟར་ཡང་ཆོ་ག་དེ་ཡང་འདིར་རྟོགས་པར་བྱའོ་ཞེས་༢དགོངས་པའོ།",
    "སྒྲིབ་པཐམས་ཅད་ལས་གནོད་པར་བྱེད་ཅེས་སུམྦྷའོ།",
    "ངེས་པར་གནོད་པར་བྱེད་དོ་ཞེས་པ་ནི་སུམྦྷའོ།",
    "ཧཱུྃ་ཡིག་རྣམས་ཀྱིས་འཛིན་པ་ལ་སོགས་པ་ལ་ངེས་པར་སྦྱོར་བའོ།",
    "དེ་ལ་ཤིན་ཏུ་དཔའ་བའི་མཚོ་སྐྱེས་ཀྱི་སྣོད་གཉིས་རློན་པར་རམ།",
    "ཐོད་པ་གཉིས་སྦྱར་བའི་འཁྲུལ་འཁོར་གཉིས་ཀྱི་དབུས་སུ་བསྒྲུབ་བྱ་བསམས་ནས་སྤེལ་ཚིག་དང་བཅས་པའི་སྔགས་ཟློས་ཤིང་ལག་པ་གཡས་པས་གཟུང་བའི་རྡོ་རྗེས་ཡང་ཡང་དུ་བརྡེགས་༡པས་འཇིག་པར་བྱེད་དོ།",
    "དགོད་པ་གཞན་ནི་གདུལ་བྱ་རྣམ་པ་སྣ་ཚོགས་པ་ལས་གཞན་དུ་གསུངས་ས་སོ།",
    "འདིར་འདི་ནི་༡འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་རྣལ་འབྱོར་ཏེ།",
    "འགྲོ་བ་རྡོ་རྗེ་འཛིན་པའི་གོ་འཕང་ཐོབ་པའི་ཆེད་དུ་བགེགས་མེད་པར་བྱའོ་ཞེས་བསམས་ནས།",
    "དེ་སྐད་དུ་ཡང་གསུངས་པ།",
    "སྔགས་གསུངས་པ་ལས་སོ།",
    "དེ་ལྟར་ན་ཡང་རྒྱུད་འདི་ནི་ལྷ་ཐམས་ཅད་པ་ཁོ་ན་འོ་ཞེས་གསུངས་པར་འགྱུར་རོ།",
    "གསུམ་མམ་བདུན་ནམ་ཉི་ཤུ་རྩ་གཅིག་གམ་བརྒྱ་རྩ་བརྒྱད་དུ་གདོན་པར་བྱ་སྟེ།",
    "དེ་ལྟར་གོམས་ནས་ཐུན་བཞིར་རྗེས་སུ་བསྒྲུབ་པ་ལ་༢གླགས་ཚོལ་བ་རྣམས་ཀྱི་རྗེས་སུ་བསམ་པ་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "ཕྱིར་ལ་དེ་རྣམས་ཁོ་ན་ལ་ལས་ལ་གནོད་པ་ལས་ལྟུང་ངོ་ཞེས་པ་བསྒོམ་བྱའི་ཕྱིར་ཟློག་༢འདི་གསུངས་སོ།",
    "ཇི་སྐད་གསུངས་པའི་སྔགས་ྔགས་བཟླས་པ་ལས་སྲུང་བའོ་ཞེས་པའོ།",
    "གནས་སྐབས་ཐམས་ཅད་དུ་སྲུང་བའི་དོན་དུ་བྲི་བྱའི་ཕྱིར་བཟློག་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལས་ཕྱི་རོལ་པདྨའི་འདབ་མ་བཅུ་དྲུག་རྣམས་ལ་ཤར་ལ་སོགས་པར་གཡོན་སྐོར་གྱིས་རིམ་པ་ཇི་ལྟ་བར་ཟླ་བ་དང་ཐིག་ལེ་དང་བཅས་པའི་དབྱངས་བཅུ་དྲུག་རྣམས་སོ།",
    "དེ་ལས་ཕྱི་རོལ་འཁོར་ལོའི་རྩིབས་བཅུ་དྲུག་རྣམས་ལ་ཤར་ལ་སོགས་པར་གཡོན་སྐོར་གྱིས་རིམ་པ་ཇི་ལྟ་བར།",
    "དེ་བཞིན་དུ་བྱང་ལ་སོགས་པར།་",
    "ཆོ་ག་ཇི་ལྟ་བར་བསྒོམས་པའི་ཁང་པ་བརྩེགས་པ་དང་བ་ཅས་པའི་རྣམ་པར་སྣང་མཛད་ཀྱི་ངོ་བོའི་རིག་པའི་རྒྱལ་པོའི་གཟུགས་ཀྱིས།་",
    "བསྒྲུབ་བྱ་ཁོ་ན་ཁྲོ་བོའི་ཚོགས་དང་ཁྱད་པར་དུ་བགེགས་མཐར་བྱེད་ཀྱི་ཚོགས་སྤྲོས་པས་ལེགས་པར་བསྲུངས་པ་ལ།་",
    "ལས་ཀྱི་དབྱེ་བ་ལས་ཁ་དོག་དང་བསམ་པ་དང་རབ་ཏུ་སྦྱོར་བར་བྱེད་པ་དང་བསྐུལ་བའི་དབྱེ་བ་རྟོགས་པར་བྱའོ།",
    "ཏྲ་གཞན་ཡང་ཞི་བའི་ལས་སུ་ལས་རབ་འབྱམ་ཐམས་ཅད་འདུས་པར་གསུངས་ཏེ།",
    "དེ་ལྟར་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱི་རྣལ་འབྱོར་གྱིས་ཁ་སྦྱོར་འབྱེད་པ་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "འབྱེད་པའི་ཆེད་དུ་གསོལ་བ་གདབ་པར་༐",
    "ཁྱེད་རྣམས་ཀྱིས་འདི་རྗེས་སུ་གནང་བ་ཁོ་ནའོ་ཞེས་མཁྱེན་པར་གསོལ་བར་བྱའོ།",
    "དེ་ལྟར་གསུངས་པའི་ཆོ་ག་ཡིས།",
    "ཕྱིན་ཅི་ལོག་ཏུ་བརྟགས་བྱས་ཤིང་།",
    "སྐྱེ་བོ་རྣམས་ནི་བསད་བྱས་ནས།",
    "ཡི་གེ་བར་དུ་ཆོད་བྱས་ནས་། ཞེས་པ།",
    "རྣམས་ཞེས་༦རྟེན་དང་བརྟེན་པ་དག་ཐ་མི་དད་པར་བརྟགས་པ་ལས་བརྗོད་པའོ་། དེ་ལྟར་གཞན་དུ་ཡང་ཇི་ལྟར་རིགས་༡པ་རྟོགས་པར་གྱིས་ཤིག།",
    "ཅིས་གོ་ཆ་རིམ་པས་བསྒོམ་ཞེ་ན་གསུངས་པ།",
    "སྲུང་བའི་འཁོར་ལོར་ཧེ་རུ་ཀ་རྡོ་རྗེ་སེམས་དཔར་བྱས་ནས་ཡེ་ཤེས་སེམས་ད་པའ་མི་བསྐྱོད་པ་བཅུག་སྟེ་དེ་དང་རོ་གཅིག་པར་བྱས་ནས།",
    "ཧེ་རུ་ཀ་ཉིད་དེ་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱི་གཟུགས་ཉིད་དུ་དྲན་པར་བྱའོ།",
    "འཇིགས་རུང་ནི་སྦྲུལ་གྱི་རྒྱན་དང་རྣམ་པར་འགྱུར་བའི་ཞལ་ཉིད་ལ་༢སོགས་པ་རྣམས་ཀྱིས་སོ།",
    "ཁྱད་པར་གཞན་ཡང་ཇི་ལྟར་རིགས་པར་བརྟག་པར་བྱའོ།་",
    "ད་ང་པོར་གསལ་བར་བྱས་པའི་ཆོ་ག་དང་འདྲའོ།",
    "སེ་ན་༢ཞེས་པ་ལ་སོགས་པའི་གནས་སུ་ཏ་༤ཡིག་ཟླུམ་པོའི་ཁོག་པར་འཁོར་ལོ་ཟུར་དྲུག་པ་སྟེ།་",
    "འཆད་པར་འགྱུར་བའི་རིགས་པས་ཀུ་རུ་ཀུལྐེ་བསྒོམས་༩པས།",
    "གྱོ་དུམ་གྱི་ནང་དུ་སྟེ་གནོད་པར་བྱེད་པའི་ཆེད་དུ་མི་འཇུག་གོ་ཞེས་པའི་དོན་ཏོ།",
    "ཞི་བ་ལ་སོགས་པའི་ལས་ཀྱི་དབྱེ་བས་ཁ་དོག་དང་བསམ་པ་དང་ཕྱོགས་ལ་སོགས་པའི་དབྱེ་བ་ནི་ཕྱི་བར་བྱས་ཟིན་པའི་རྗེས་སུ་འབྲང་བ་ལས་ཇི་ལྟར་རིགས་པར་རྟོགས་པར་བྱའོ། ༐",
    "དཔལ་ཡང་ད་ག་པར་སྦྱོར་བའི་རྒྱུད་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ་༡།",
    "ལྔ་པར་དཀྱིལ་འཁོར་ག་སུངས་ན་དེའི་རབ་གནས་ནི་མ་གསུངས་ཤིང་།",
    "ཐང་སྐུ་ལ་སོགས་པ་ཡང་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཉིད་དུ་གསུངས་ན།",
    "འཆད་པར་འགྱུར་བ་རྗེས་སུ་སྒྲུབ་པར་འགྱུར་རོ་ཞེས་བསླབ་པར་དགོངས་པས་སོ།",
    "ལས་རྣམས་ཐམས་ཅད་ཅེས་པ་བཟླས་པ་དང་རབ་གནས་དང་དེའི་འཁོར་ས་ཡོངས་སུ་སྦྱོར་བ་ལ་སོགས་པ་རྣམས་བསམ་གཏན་ཁོ་ན་རྗེས་སུ་བསྒྲུབ་པ་ལས་བསྒྲུབ་པར་བྱའོ།",
    "རྣམ་གཉིས་དེ་བཞིན་གཤེགས་པས་གསུངས།",
    "ཞེས་གསུངས་སོ།",
