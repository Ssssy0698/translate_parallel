    "གར་ཆང་ཁར་བཟུང་པའི་མཁུར་བཀང་བྱས་པ་བཞིན་དུ་ཟིམ་ཞེས་པའི་དོན་དེ་གསུམ་ཚིག་གཅིག་གི་སྒོ་ནས་བསྟན་པ་ཡིན་ནོ།",
    "ཕལ་པ་ཆང་གིས་མྱོས་པ་ལྟར་འདི་ནི་འཕོ་མེད་བདེ་བ་ཆེན་པོའི་རོས་རྟག་ཏུ་མྱོས་པའམ་དགྱེས་པར་ཚིམ་པའི་དོན་ནོ།",
    "རི་བོ་མནྡ་རའི་སྟེང་ནས་ཁྱབ་འཇུག་གིས་བཟུང་།",
    "དེ་ནས་དཔལ་མོ་བྱུང་བ་དེས་རང་ཉིད་ཀྱིས་ཁྱབ་འཇུག་བླངས་ཏེ་དེའི་ཆུང་མར་གྱུར།",
    "དེ་ནས་བུད་མེད་ཤིན་ཏུ་ཡིད་འོང་ཞིག་བྱུང་བ་ལ་ཁྱོད་སུ་ཡིན་དྲིས་པས་ང་ནི་ཆང་ཞེས་བྱ་སྟེ།",
    "ཁྱབ་འཇུག་ཤིན་ཏུ་གཟུགས་བཟང་བའི་བུད་མེད་དུ་སྤྲུལ་ནས་བདུད་རྩིའི་གན་དུ་བསྡད།",
    "ལྷ་མིན་རྣམས་ཀྱིས་བུད་མེད་དེ་ཁོ་བོ་ཅག་གི་བུད་མེད་ཡིན་ནོ་སྙམ་ནས་བདུད་རྩིའི་སྲུང་མར་བཞག་ནས།",
    "དང་པོར་ཕྱི་རོལ་ཏུ་ཁྲུས་བྱེད་པ་ལ་སོགས་པའི་ཤུལ་དུ་བརྒྱ་བྱིན་གྱིས་བདུད་རྩི་བརྐུས་ཏེ་རང་གི་ཁང་པར་ཁྱེར་ཏོ།",
    "ཁྱབ་འཇུག་གི་འཁོར་ལོས་དེའི་མགོ་དེ་མ་ཐག་ཏུ་བཅད།",
    "དེ་ལྟར་ཆང་གི་གཏམ་རྒྱུད་དང་སྦྱར་ན།",
    "ཆུ་དང་ལྡན་པ་རྒྱ་མཚོ་ལས་བྱུང་བའི་བུད་མེད་པདྨ་གཞོན་ནུ་ལྟར་ཡིད་དུ་འོང་བ་དེ་ལ་ཆང་ཞེས་བྱ་སྟེ།",
    "དེ་འདྲའི་ཆང་ཞེས་བྱ་བའི་བུད་མེད་ཀྱི་གཟུགས་ཅན་བཏུང་བའི་རྣམ་པར་གྱུར་པ་དེ་དུས་ནམ་བྱུང་ན།",
    "ཡང་ན་དཔལ་མོ་ལ་སྦྱར་ཏེ་ཆུ་དང་ལྡན་པ་ནི་ཆུ་མཚོ་ལས་བྱུང་བའོ།",
    "མཛེས་པའི་སྒྱུ་རྩལ་སྤྲིན་གྱི་རྒྱལ་པོ་དང་མཐུན་པར་སྒྱུར་བ་མོ་འདི་ཆུ་ཤེལ་ཏེ་ཟླ་བ་ལྟར་དཀར་བསིལ་ཨར་མོ་ནིག་གི་རྡོ་དང་།",
    "ཡང་རྩུབ་མོའི་གབ་ཚིག་ལྟར་ན།",
    "དེ་ནས་མགོ་བརྩམས་ཏེ་སྐྱེས་བུ་དང་བུ་མོ་དེ་དག་འདོད་པའི་ཆང་གིས་མྱོས་པར་བྱེད་དོ།",
    "ཉིན་མཚན་གྱི་ནང་ནས་ཉི་འོད་དང་བྲལ་བ་མཚན་མོ་ལ་སོགས་པ་མཚོན་ཞིང་།",
    "ཆང་གིས་མྱོས་པ་དངོས་དང་།",
    "མཛེས་མའི་མིག་དང་འགུགས་པའི་ཕོ་ཉ་མོ་སྦྱར་བ་སྟེ་ཇི་ལྟར་ན་མིག་འཁྱོག་སྟེ་ལྟ་བ་དང་ཕོ་ཉ་མོའི་ངག་འཁྱོག་པ་སྟེ་གཞན་ལ་ཇི་བཞིན་མི་བརྗོད་པའོ།",
    "དེའི་ཕྱིར་འཁྱོག་ཅིང་ཞེས་སོ།",
    "མཛེས་མ་དེ་ཆགས་པའི་གནས་སྐབས་མཛའ་བོ་ལ་གསལ་བར་སྟོན་པར་བྱེད་པ་མོའོ།",
    "དེ་ལྟར་བྱེད་པ་མོ་མཛེས་མ་ཡིས་བསྐུལ་བའི་ཟུར་མིག་དང་ནི།",
    "སྦྲན་པར་བྱེད་པའི་ཕོ་ཉ་མོས་ཀྱང་མཛའ་བོ་འགུགས་པའི་བྱ་བ་བྱེད་པས་དེ་གཉིས་ཀྱི་བྱ་བ་མཛའ་བོ་འགུགས་པའི་སྒོ་ནས་གཅིག་ཡིན་པར་བརྗོད་དོ།",
    "ལུས་སམ་ངག་འཇམ་ཞིང་འདོད་པས་མྱོས་པའི་སྒྲ་གདངས་སྙན་པ་ཅན་ཡིན་པའི་སྒོ་ནས་ཁུ་བྱུག་གི་སྒྲ་དང་མཛེས་མ་གཉིས་ཀ་སྦྱར་ནས་དེ་གཉིས་ཀྱི་དབྱེ་བ་ཐ་དད་པ་ནི།",
    "ཁུ་བྱུག་གི་སྒྲ་ནི་ཐོས་པར་གྱུར་ཏེ།",
    "ཉི་མ་དང་འདོད་པ་ཚིག་འདི་དག་གི་སྒོ་ནས་སྦྱར་བ་སྟེ།",
    "ཡང་བུད་མེད་ཀྱི་སྐྱེ་གནས་ཆུ་ལྡན་མ་དང་སྦྱར་བ་ལས་འདོད་པ་དག་ཅེས་སུ་སྦྱར་རོ།",
    "དེ་བཞིན་དུ་གཞུ་ཉིད་ལ་ནི་འཁྱོག་པོ་སྟེ་བཀྲ་ཏཱ་སྟེ་འཁྱོག་པོའི་སྒྲ་དབྱིབས་འཁྱོག་པ་དང་།",
    "སེམས་ཀྱི་རྒྱུད་མི་དྲང་བར་འཁྱོག་པོར་གྱུར་པ་གཉིས་ཀ་ལ་གོ་རུང་ཡང་།",
    "རྒྱལ་པོ་དང་གཞུ་ལ་སྒྲ་འདི་སྦྱར་བར་བྱས་ཚེ་རྒྱལ་པོ་དེ་རྒྱུད་འཁྱོག་པོ་ཅན་མ་ཡིན་པས་གཞུ་ཉིད་ལ་སྒྲ་དེ་ངེས་སོ།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱིས་དཔུང་པས་བསྲུང་བ་ཡི་ས་གཞིའི་ཁྱོན་ལ་ཚེར་མ་ནི།",
    "མེ་ཏོག་པདྨའི་ཡུ་བ་ཉིད་ཁོ་ན་ལ་མཐོང་གི་དེ་ལས་གཞན་དུ་ཚེར་མ་མེད་པའི་ས་གཞི་འཇམ་པ་འབའ་ཞིག་པའོ།",
    "སྐྱེ་རྒུའི་བདག་མོ་ཉིད་དུ་བྱུང་བའམ་གྱུར་པ་ནི་ཚངས་པ་དང་མིའི་རྒྱལ་པོའོ།",
    "རྒྱལ་པོ་དཔའ་ཞིང་གྲུང་བ་ཞེས་སྔ་མ་དག་གིས་བཤད།",
    "གཞོན་ནུས་མདུང་ཐུང་གིས་ལྷ་མིན་འཇོམས་པའི་ནུས་པ་འཛིན་ལ།",
    "ཁྱབ་འཇུག་གིས་སྔོན་ལྷ་མ་ཡིན་གླང་གི་གཟུགས་ཅན་དུམ་བུར་བཅད་ཅིང་བསད་པར་གྲགས་པས་སོ།",
    "བི་བུདྷ་མིན་པར་ཤེས་པ་ནི།",
    "དངོས་པོ་འགའ་ཞིག་གི་འབྲས་བུ་བྱེད་པའི་ཁྱད་པར་རབ་ཏུ་བསྟན་པའི་ཕྱིར།",
    "མེ་ཏོག་གི་གཞུ་ཅན་འདོད་ལྷ་དག་གི་མཚོན་ཆ་མདའ་ལྔ་པོ་དེ་ནི་མཚོན་ཆའི་ཡོན་ཏན་རྩུབ་པ་དང་རྣོ་བའང་མིན།",
    "ཡིད་འོང་མ་འདི་དག་ལྷའི་བུ་མོ་ཡིན་ཞིང་།",
    "དེ་ལྟ་མོད་ཀྱི་གཟུགས་མཛེས་པས་ལྷ་ཚངས་པའི་ཡང་ཆགས་བྲལ་གྱི་དཀའ་ཐུབ་གཞོམ་པ་ཉིད་སྒྲུབ་པར་ནུས་སོ།",
    "ཆགས་པའི་ཟུར་མིག་ཉིད་ཀྱིས་བུད་མེད་རྣམས།",
    "གང་གི་གཞལ་ཡས་ཁང་འདྲེན་བྱེད་ཀྱི་ཤིང་རྟ་ལ་འཁོར་ལོ་གཅིག་པ་ལས་མེད་པ་དང་།",
    "ཤིང་རྟ་འདྲེན་བྱེད་ཀྱི་ཁ་ལོ་པ་དྲང་སྲོང་འགྲོས་སྐྱོང་གི་བུ་ཡིན་ལ།",
    "བྱ་ཁྱུང་གི་ཕུ་བོར་གྱུར་པ་སྐྱ་རིང་དེའི་བརླ་ཆག་ནས་མེད་པས་ཉམས་པ་དང་།",
    "གསུམ་པ་དཔེར་བརྗོད་ཀྱི་རིམ་པ་འདི་ཡིས་ཁྱད་པར་བརྗོད་པའི་རིགས་སུ་གྱུར་པའི་དཔེར་བརྗོད་ཀྱི་དབྱེ་བ་རྣམས་ཀྱང་འདི་ལས་མཚོན་ནས་རང་གི་བློས་བརྟག་པར་བྱའོ།་",
    "འདི་ལ་ཁ་ཅིག་བསྟོད་པ་ན་གཞན་ཡོན་ཏན་ཁྱད་འཕགས་དེ་དག་དང་མཚུངས་པར་སྦྱོར་བ་ཡིན་མོད་ཀྱི།",
    "གོང་གི་མཚན་ཉིད་དེས་སྨད་པའི་མཚུངས་སྦྱོར་ལ་མི་ཁྱབ་པར་མི་འགྱུར་རོ།",
    "དབུས་ན་རྒྱལ་པོ་ཁྱོད་ཉིད་ཀྱང་སྟེ།",
    "ཁྱེད་རྣམས་ལ་འཇིག་རྟེན་སྐྱོང་བ་ཞེས་པའི་མིང་གིས་སྒྲ་འདི་ནི་ཡུལ་གཞན་ལ་འཇུག་པ་མེད་པར་རྣམ་པར་འཛིན་ནོ།",
    "གློག་གི་རྩེ་དགའ་གཡོ་བའི་བྱ་བ་དག་དང་ནི་སྤྲིན་གྱི་འདུ་འགོད་རྩོམ་པའང་རང་གི་ངང་གིས་སམ།",
    "སྤྲིན་གཅིག་གིས་ཡུལ་ནམ་མཁའི་ཁམས་ཆགས་བྲལ་སྐྱོ་བའི་རྣམ་པར་བྱས་པ་དང་།",
    "གང་གི་སྐེད་པ་མཆོག་ཏུ་ཕྲ་ཞིང་རོ་སྨད་རབ་ཏུ་སྦོམ་པ་དང་།",
    "ལྟེ་བ་གཏིང་ཟབ་ལ་དམའ་ཞིང་ནུ་མ་འབུར་ལ་མཐོ་བའི་བུད་མེད་ལུས་ཀྱིས་གང་ཟག་སུ་ཞིག་མ་བཅོམ་སྟེ་ཆགས་ལྡན་ཐམས་ཅད་ཀྱི་བརྟན་པ་དེས་འཕྲོག་པའམ་བཅོམ་པར་བྱས་སོ།",
    "མཁྲང་ལ་ཟླུམ་པ་ཆུ་ཤིང་གི་བརླ་དང་།",
    "འདི་ལ་རྗེས་དེ་དག་གི་ཡིད་དུ་འོང་བས་བདེ་བ་འབའ་ཞིག་བསྐྱེད་རིགས་ཀྱིས་གདུང་མི་འོས་ན་ཡང་གདུང་བ་བསྐྱེད་པ་ནི་རྫས་དང་ལས་འགལ་བའོ།",
    "གཞི་གཅིག་གི་བྱ་བ་འགལ་པ་ནི།",
    "བུད་མེད་དང་བྲལ་བའི་མགྲོན་པོ་ཡི་མིག་ལ་མཆི་མ་ཟག་པར་བྱེད་དོ།",
    "ཞེས་གཞི་མེ་ཏོག་གི་རྡུལ་རྣམས་ཀྱིས་མིག་ལ་མ་རེག་པ་དང་།",
    "ཀྱེ་ངག་སྙན་པར་སྒྲོག་མ་ཁྱོད་ཀྱི་མིག་གི་འབྲས་བུ་ནག་པ་དང་།",
    "ཀྲྀཥྛ་ནག་མོ།",
    "ནག་མོ་སྙན་སྒྲོག་ཁྱོད་ཀྱི་མིག།",
    "ནག་མོ་ཞེས་པ་སྐབས་འདིར་སྲིད་སྒྲུབ་ཀྱི་ཆུང་མ་དྲོ་བ་དཱི་ཡིན་ལ།",
    "ཁྱོད་རང་གི་ཁྱོ་བོ་སྲིད་སྒྲུབ་ལ་ཆགས་ཀྱང་།",
    "ཞེས་པར་འགྱུར་ཏེ་འདི་སྐབས་ཀྲྀཥྛ་ཁྱབ་འཇུག་གི་འཇུག་པ་བཅུ་ཡི་ནང་ཚན་ནག་པོ་ཞེས་པ་དེ་ཡིན་པས་ཁྱབ་འཇུག་གི་མིང་ཡིན་ཞིང་།",
    "ཁྱབ་འཇུག་དེ་སྐྱ་བསེང་གི་བུ་སྲིད་སྒྲུབ་ལ་ཆགས་ཏེ་བརྩེ་བས་སྐྱོང་བ་ཡིན་ཡང་།",
    "དང་པོ་སྤྱིར་བསྟོད་བྱར་གྱུར་པ་འདི་ལ་ཅིས་མི་བསྟོད་སྙམ་པའི་བསྟོད་འོས་ཀྱི་སྐབས་སུ་བབ་པ་ཞིག་མིན་ན་ཡང་རང་གི་གནས་སྐབས་ཀྱི་འདོད་པས་བསྟོད་པ་ནི་སྐབས་སུ་མ་བབ་པའི་བསྟོད་པ་ཡིན་ནོ།",
    "སྐབས་མིན་ཡང་འདོད་པ་དེའི་ངོར་བསྟོད་བྱར་འོས་པ་ལྟ་བུར་སོང་པའི་ཕྱིར་བརྗོད་པ་ལེགས་པར་འགྱུར་རོ།",
    "གཞན་ངོ་སྲུང་གིས་མི་བསྟེན་པའི་རི་དྭགས་འདི་རྣམས།",
    "རྒྱལ་པོའི་བྱ་བས་སྐྱོ་བས་དེ་དག་གིས་རི་དྭགས་ཀྱི་སྤྱོད་ཚུལ་འདི་དག་འདི་ལྟར་བསྔགས་པའང་ཆ་འགའ་ཞིག་ནས་བརྗོད་འོས་པ་ལྟར་འགྱུར་རོ།",
    "འདིར་དོན་མེད་པའི་སྨྲ་བ་མང་པོ་ལ་དགའ་བ་ཅན་ཞིག་གིས་མི་གཉིད་དུ་སོང་བ་ཞིག་ལ་འཕྱ་བར་བརྩམ་པ་ལ་དེས་སྨྲས་པ་ལྟར་བརྗོད་པ།",
    "མང་དུ་སྨྲ་དང་ཆགས་སྡང་རྣམ་རྟོག་གིས།",
    "དེར་མ་ཟད་དེའི་ཕྱི་ཞིག་ཏུ་ར་གླུའི་རིགས་ལས་བྱུང་བ་རྒྱལ་པོ་ཤིང་རྟ་བཅུ་པའི་བུ་དགའ་བྱེད་རཱ་མ་ཎར་གྲགས་པ་སྲིན་ཡུལ་འཇོམས་མཁན་དེ་ཡང་དྲང་སྲོང་གི་རིགས་ལས་བྱུང་བའི་དྲང་སྲོང་དངོས་མིན་ཡང་།",
    "ཚུལ་དེ་ཉིད་ད་ལྟ་དཔུང་བཞི་དང་ལྡན་པའི་རྒྱལ་པོ་ཁྱོད་ཀྱིས་ཀྱང་བྱས་པ་ཡིན་མོད།",
    "འདི་ལ་ཁྱོད་ནི་རྒྱགས་པར་མ་མཛད་ཅིག་ཅིའི་ཕྱིར་ན་ཁྱོད་དང་མཚུངས་པ་གཞན་རཱ་མ་གཉིས་པོ་ཡང་ཡོད་པའི་ཕྱིར་རོ།",
    "སྔོན་གྱི་སྐྱེས་བུ་ཁྱབ་འཇུག་ལས་བཅད་ནས་རྒྱལ་སྲིད་ཀྱི་དཔལ་ཆེན་པོ་འདི་རྒྱལ་པོ་ཁྱོད་ཀྱིས་ལོངས་སུ་སྤྱོད་པར་མཐོང་ན།",
    "རྒྱལ་པོ་བུ་རམ་ཤིང་པའི་རྒྱུད་དུ་སྐྱེས་པ་ཡ་རབས་ཁྱོད་ཀྱིས་ཚུལ་འདི་ལྟ་བུ་ནི་བགྱི་བར་རིགས་སམ་ཅི།",
    "ཁྱབ་འཇུག་གི་དཔལ་ཀྱང་ཕྲོག་ནས་ལོངས་སྤྱོད་ནུས་པའི་དཔའ་བ་ཕུན་ཚོགས་ཡོད་པར་བསྟོད་པའོ།",
    "ཚིགས་བཅད་འདི་བུ་རམཤིང་པའི་རྒྱུད་ཀྱི་རྒྱལ་པོ་བཟང་ལྡན་ཟེར་བས་ཁྱབ་འཇུག་གི་ཆུང་མ་དཔལ་མོ་ལ་ལོངས་སྤྱད་པའི་གཏམ་རྒྱུད་དང་སྦྱར་བ་ཡིན་ཟེར་བའང་འདུག་གོ།",
    "དེས་ན་ས་གཞི་འདི་ནི་ཁྱོད་ཁོ་ནའི་མ་ཡིན་ཏེ།",
    "བྷ་ཛི་གའི་སྒྲ་ལག་འགྲོར་མ་ཟད་སྐྱེ་བོ་ངན་པ་ལ་ཡང་འཇུག་པས་ས་སྟེང་གི་སྐྱེ་བོ་ངན་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་བྷོ་ག་ཞེས་པ་ལོངས་སྤྱོད་དེ།",
    "དེ་དག་གིས་ལོངས་སྤྱོད་དུ་ཆགས་པ་སྟེ་གནས་པར་གྱུར་པའི་ཕྱིར་ན།",
    "ཁྱོད་ཙམ་དུ་མ་ཟད་སྐྱེ་བོ་གཞན་དེ་དག་གིས་ཀྱང་སྤྱད་བྱ་ཡིན་པས།",
    "ཁྱོད་ཁོ་ན་འདི་ལ་ང་རྒྱལ་ཅི་ཞིག་བྱ་ཞེས་པའི་དོན་དུའང་འགྱུར་བས་སྦྱར་བའི་ཟོལ་བསྟོད་དོ།",
    "སྦྱར་བ་མིན་ཡང་ངག་གཞན་དག་གི་ཟོལ་གྱིས་བསྟོད་པའི་རྣམ་པ་རྣམས་ནི་བརྗོད་བྱ་མཁས་པ་དང་མཛངས་པ་མཛེས་པ་སོགས་ཀྱི་ཁྱད་པར་ལས་དང་།",
    "ཕུན་སུམ་ཚོགས་པ་རྣམས་ཀྱི་འབྲས་བུ་དག་གི་སྒོ་ནས་གྲོགས་པོ་རྣམས་ལ་ཕན་འདོགས་པས་རྗེས་སུ་འཛིན་པ་ནི་ངེས་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "སྐབས་འདིར་ཉི་མས་པདྨ་ལ་དཔལ་སྟེར་བ་དག་ནི་དམ་པ་དག་གིས་གྲོགས་སུ་འཛིན་པ་བསྟན་པའི་ཕྱིར་རམ།",
    "ཆེད་དུ་ཡིན་ནོ་ཞེས་འཆད་པ་ནི་ཉི་མ་ལ་རབ་བརྟགས་བྱས་པར་སོང་ཞིང་དོན་ལེགས་པའང་མེད་པས་དེ་ལྟར་མ་ཡིན་ཏེ།",
    "འདི་ལ་སྟོན་བྱེད་རྗེས་སུ་བྱས་ན་ཟླ་དངོས་ཀྱི་དཔེ་ལྟ་བུར་འགྱུར་མོད།",
    "ཡོན་ཏན་དང་ལས་རྣམས་ལྷན་ཅིག་གི་ཚུལ་དུ་ཡོད་པའི་དངོས་པོ་བརྗོད་པ་ནི་ལྷན་ཅིག་བརྗོད་པའི་རྒྱན་ནོ།",
    "བྲལ་བས་ཉེན་པ་དག་གིས་བརྗོད་པ་སྐད་དུ་བྱས་པ།",
    "ད་ནི་མཚན་མོ་འདི་དག་རྣམས་བདག་གི་ཤུགས་རིང་འབྱིན་བའི་དབུགས་དང་ལྷན་ཅིག་རིང་ངོ།",
    "ཟླ་བའི་རྒྱན་ལྡན་མཚན་མོའི་ནམ་མཁའ་སྔོ་བསངས་མ་རྣམས་ཀྱང་བྲལ་ཉེན་གྱིས་གདུང་བས་མདངས་ཉམས་པ།",
    "མགྲོན་པོ་དེ་དག་གི་མཆི་མ་དང་མཉམ་དུ་མ་ལ་ཡ་ཡི་ཀླུང་དག་འབབ་བོ།",
    "ཁུ་བྱུག་གིས་སྒྲ་སྙན་སྒྲོག་པའི་རྒྱུ་ལས་ཡིད་འོང་གི་སྐལ་བ་བཟང་པོ་དང་།",
    "དཔྱིད་དུས་ཀྱི་ཉིན་མོར་བབ་པའི་སྐྱེ་བོའི་ཀུན་དགའ་དང་དེ་རྣམས་དུས་ལྷན་ཅིག་ཏུ་འཕེལ་བར་གྱུར།",
    "དགྲ་ཟླར་གྱུར་པའི་ས་སྤྱོད་རྒྱལ་པོ་རྣམས་ལ་མཚོན་བསྣུན་པ་སྟེར་བར་བྱེད་པའི་རྒྱལ་པོ་ཁྱོད་ཀྱི་ལག་པ་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བྱེད་འདི་ཡིས།",
    "དགྲ་ཟླའི་རྒྱལ་པོ་དེ་དག་གི་གཞན་ལས་རྒྱལ་བའི་གྲགས་པ་ཀུ་མུད་དཀར་པོ་ལྟ་བུ་དྲི་མ་མེད་པ་ཡུན་རིང་པོ་དག་ཏུ་བསྒྲུབ་ཅིང་བསགས་པ་འཕྲོག་གོ།",
    "ངག་གིས་བརྗོད་པ་དང་།",
    "ཡིད་ཀྱིས་བསམ་པའི་སྤྱོད་ཡུལ་མ་ཡིན་པའི་དགེ་ལེགས་ཀྱི་སྣང་བ་དམ་པས་ཁྱོད་ལ་སྲུངས་ཤིག་ཅེས་པ་དགེ་ལེགས་ཀྱི་དོན་ཙམ་ཞིག་བརྗོད་བསམ་ལས་འདས་པ་མིན་ཡང་།",
    "ཞེས་པའི་སྣང་བ་དམ་པ་དེས་ཁྱོད་ལ་སྲུངས་ཞེས་དང་།",
    "གསུམ་པ་ཞར་བྱུང་དུ་སྐབས་འདིར་སྙན་ངག་མཁན་སྔ་མ་དག་གིས་དོན་རྒྱན་སོ་ལྔ་ལས་མང་བའི་རྣམ་གྲངས་བཀོད་པ་དེ་དག་འདིར་མ་འདུས་སམ་སྙམ་པའི་དོགས་པ་བཅད་པ་ནི་རྗེས་འགྲོ་མེད་པའི་རྒྱན་དང་།",
    "ཟླ་བ་པདྨ་དག་གི་ནི།",
    "མཛེས་པ་ལས་འདས་ཁྱོད་ཀྱི་གདོང་།",
    "རབ་རྟོག་ཆ་ཤས་ཀྱི་རྒྱན་ཞེས་གྲགས་པ་འདི་ཡང་ནི་རབ་རྟོག་དག་གི་དབྱེ་བ་ཉིད་ཡིན་གྱི།",
    "དེ་ལྟར་འབྲེལ་བ་ཅན་མ་ཡིན་པས་ཚིག་རྐང་སོ་སོས་དོན་རེ་རེ་སྟོན་པ་ཕན་ཚུན་མི་བལྟོས་པས་ཐམས་ཅད་སྟོབས་མཚུངས་སུ་བྱས་པ་ཉིད་ཅེས་པའི་ལུགས་གཉིས་ཡོད་པ་ནི་སྤྱིར་བཏང་སྤེལ་མ་ཡི་རྒྱན་དག་ཐམས་ཅད་ལ་ནི་ཁྱབ་ཅིང་མཚོན་པར་བྱ་བ་ཡིན་ནོ།",
    "མཛེས་མ་ཁྱོད་ཀྱི་བཞིན་གྱི་དཔལ།",
    "པདྨ་དག་གིས་འགོག་པར་བྱེད་དོ་ཞེས་ཤུགས་ཀྱིས་མཚུངས་པ་གསལ་བར་བྱེད་པས་དཔེ་རྒྱུན་དུ་ཡང་འགྲོའོ།",
    "སྐབས་འདིར་ཡུ་བ་དང་དམག་གི་དཔུང་བཀོད་པའི་བྱེ་བྲག་ཐད་ཀར་བརྐྱང་བ་དབྱུག་པ་ལྟ་བུ་གཉིས་ལ་སྦྱར་བ་ཡིན་པས་སྦྱར་བའི་རྒྱན་ཡང་འདྲེས་ཏེ་དེ་ལྟར་རྒྱན་གསུམ་བསྲེས་པའོ།",
    "དེ་ལ་བང་མཛོད་དང་དཔུང་གི་བཀོད་པ་དབྱུག་པ་ལྟ་བུ་གཉིས་ལ་སྒྲ་སྦྱར་དུ་ཡོད་མོད།",
    "འདི་ལ་སྔ་མ་དག་པ་དཔྱད་པ་ཞུགས་ནས་ངེས་པར་བརྗོད་པ་ཅི་ཡང་མ་མཐོང་ཡང་བདག་གིས་འདི་ལྟར་སེམས་ཏེ།",
    "དཔུང་གི་བཀོད་པ་དབྱུག་པ་ལྟ་བུ་གཉིས་ཀ་ཡང་ཕ་རོལ་ལས་རྒྱལ་བའི་ཡན་ལག་ཏུ་གྱུར་པ་ཡིན་ལ།",
    "དབྱུག་པ་ལྟ་བུའི་དཔུང་གི་བཀོད་པ་དང་མཚུངས་པའི་ཡུ་བ་ཕུན་སུམ་ཚོགས་པ་ཡོད་པས་གདོང་ལས་རྒྱལ་བའམ།",
    "དེའི་དཔལ་འགོག་པ་ལ་དཀའ་བ་ཅི་ཡོད་ཅེས་པའི་དོན་ཡིན་པར་འདུག་གོ་སྙམ་མོ།",
    "དཔུང་གི་བཀོད་པ་དབྱུག་པའི་སྒྲ་པདྨ་ལ་གྲུབ་ཀྱང་དོན་མ་གྲུབ་པས་སྒྲུབ་བྱེད་དུ་མི་འོས་ཞེས་དགག་པར་མི་རིགས་ཏེ།",
    "བརྗོད་འདོད་ཀྱིས་ཉམས་མཚར་བ་བརྗོད་པ་འདི་འདྲ་དུ་མ་སྙན་ངག་གི་ལུགས་ལ་ཡོད་ཀྱང་འགལ་བ་ཅུང་ཟད་མེད་པ་ཤེས་པར་བྱའོ།",
    "སྤྱིར་བརྗོད་ཚུལ་འདི་ལ་དངོས་པོ་རྣམས་ཀྱི་རང་གི་རང་བཞིན་དྲང་པོར་བརྗོད་པ་དང་།",
    "གཞན་དཔེ་སོགས་དང་སྦྱར་ཏེ་བརྗོད་པ་ནི་འཁྱོག་བརྗོད་ཅེས་བྱ་བའི་ངག་གི་རང་བཞིན་ཐ་དད་པ་གཉིས་ཡོད་དེ།",
    "དེའི་ནང་གི་འཁྱོག་པོར་བརྗོད་པ་ཐམས་ཅད་ལ་ཕལ་ཆེར་སྦྱར་བའི་སྒོ་ནས་ངག་གི་དཔལ་རྒྱས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་འཁྱོག་བརྗོད་ཀྱི་རྒྱན་རྣམས་ཀྱི།",
    "རབ་སྤེལ་བལྟོས་པ་ཅན་གྱི་སྐབས་འདིར་ཡང་སྦྱར་བ་དང་བཅས་ཏེ་བརྗོད་མོད་ཀྱི།",
    "བཞི་པ་རབ་རྟོག་གི་རྒྱན་ཡིན་པས་དེ་རྣམས་འདྲེས་པའི་རབ་སྤེལ་གྱི་རྒྱན་དུ་འགྱུར་ལ།",
    "ཚིག་འདི་ལ་ངོ་མཚར་བ་རྨད་བྱུང་གི་ཉམས་གནས་པས་ཡིད་འཕྲོག་པ་ཡིན་པ་བཞིན་ནོ།",
    "དེས་མཚོན་ནས་སྙན་ངག་གི་ཚིགས་བཅད་ཕལ་མོ་ཆེ་རབ་སྤེལ་གྱི་རྒྱན་བྱས་པ་མང་སྟེ།",
    "སྔ་མ་དག་གིས་ལོ་ཙཱ་བས་རྣམ་སྲས་ལ་བསྟོད་པའི་ཚིགས་བཅད་དཔེར་བྱས་པ།",
    "སྤྲིན་བྲལ་ཉི་འོད་སྟོང་གི་གཟི་འབར་བ།",
    "གཉིས་པ་དེ་ལྟར་རྗོད་བྱེད་ངག་གི་རྒྱུན་ལ་ཡོད་པ་དགོངས་ཅན་གྱི་རྒྱན་ཞེས་པའི་མིང་གིས་བསྟན་པའི་ཡོན་ཏན་དེ་ཇི་ལྟ་བུ་ཞིག་ཡིན་སྙམ་ན།",
