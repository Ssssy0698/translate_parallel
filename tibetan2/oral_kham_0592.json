    "མར་གསོ་མ་ལ་འདུག་པ་དང་མཚུངས་སམ།",
    "རྙོག་པའི་དུས་ཉེ་བ་ན་འདུག་ག་གོ།",
    "ཤཱ་རིའི་བུ་མི་གཞན་གྱིས་བསམ་གཏན་ན་༡༧འདུག་པའི་དགེ་སློང་ལ་ཡོན་ཕུལ་བས་ནི་གནམ་གྱི་ལྷས་ཡོན་ཕུལ་༡༧བ་ཙམ་མ་མི་༐",
    "ཐོབ་ཟིན་པ་དང་སེམས་མི་ཞེན་མི་བསྒོ་བར་ཟན་ཅི་ཐོབ་པ་ཁྱེར་ཏེ་གྲོང་ཁྱིམ་ནས་བྱུང་ལ་ཆུ་གཙང་མའི་འགྲམ་ལམ་སྤྱད་དུ་རུང་བའི་གནས་སུ་འདུག་ལ།",
    "རྐང་པ་བཀྲུས་ཏེ་འདུག་ནས་ཟས་མདུན་དུ་བཞག་སྟེ།",
    "དུས་དུས་སུ་བསམ་གཏན་ན་འདུག་པ་སྲེད་པ་དེ་ལྟ་བུའི་ད་གེ་སློང་ནི་ངས་ཀྱང་ཡོན་དུ་གནང་ང་ངོ།",
    "ལམ་ངན་པར་ལྷུང་ཞིང་འདུག་པ་ནི་དཔེར་ཕག་གུས་ཁྲི་སྟན་བཟང་པོ་བཏང་བ་དང་མཚུངས་སོ།",
    "འགྲོལྡོག་ས་ལ་ཉལ་འདུག་ག་གན་ས།",
    "༧གཡུང་ཕི་པེ་སྣར་ཅོ་འདུག་༤༢༨ ༡ཞོལ་ན།",
    "ན་མ་མཁའི་ངོས་ལ་འདུག་ཅིང་སེམས་དང་བས།",
    "ཚངས་པའི་ལྷ་གང་ལ་ལ་དག་ལུས་དང་སྲོག་ལ་ལྟ་༡༢བ་དང་བཅས་པར་གན་ས་པ་དེ་ད་ག་ནི་ཡོངས་སུ་ཟག་པ་བྱུང་བ་བྱུང་བ་རྣམས་ཀྱིས་སེམས་ཟིན་ནས་འདུག་གོ།",
    "ཚངས་པའི་ལྷ་གང་དག་ཁ་ཅིག་ལུས་དང་སྲོག་ལ་མི་ལྟ་༡༢བ་དེ་དག་ལ་ནི་ཡོངས་སུ་ཟག་པ་བྱུང་བ་བྱུང་བ་རྣམས་ཀྱིས་སེམས་ཀུན་ཏུ་ཟིན་ཅིང་འདུག་པར་མི་འགྱུར་རོ།",
    "ལུས་ལ་མཆིས་པའི་ཉེས་དང་ཡོན་ཏན་གདའ།",
    "སེམས་ལ་མཆིས་པའི་ཉེས་དང་ཡོན་ཏན་གདའ།",
    "དེ་ཡི་ཐ་མ་འཚལ་བར་ནུས་ཀྱང་གདའ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་དགེ་སློང་རབ་ཏུ་ཞི་བའི་བློ་གྲོས་དེས་དེ་བཞིན་གཤེགས་པ་གཟི་བརྗིད་དཔག་མེད་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ན་ས་དགེ་སློང་ཞི་བའི་བློ་གྲོས་དེས་བཅོམ་ལྡན་འད་ས་དེ་བཞིན་གཤེགས་པ་ཤིན་ཏུ་ཕྲ་སེམས་དེ་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཟླ་བ་སྐུར་བཅས་ས་ལ་ལྷུང་ཡང་གདའ།",
    "ལྷུན་པོ་རྡིབ་༡ཀྱང་གདའ།",
    "སྐད་ཅིག་ཀྱང་མི་འདུག་ཅིང་།",
    "༦༩༩ གཡུང་ཕི་པེ་སྣར་གང་རང་འབྱུང་།",
    "བྱ་ཁྭས་བཏུང་དུ་རུང་བར་མུ་དང་ཁ་ད་ཆད་དུ་འདུག་པ།",
    "དེ་ལོ་གཅིག་དུས་བཞི་ལ་མཁོ་སྤྲོད་བྱེད་ཀྱི་ཡོད།",
    "ཀོའོ་ལིང་སོན་ཀལ་ཆན་ཁེ་ཡི་འཚོ་བཅུད་ས་བཟོ་བ་དང་སྨྱུག་དུས་སུ་བསྡུར་ཚད་ཡི་བཙོག་ཁུ་ཐེངས་གཏོར་དགོས།",
    "ལྷ་སར་འགྱིག་ཤོག་གུར་ཁང་ནང་ལོ་གཅིག་དུས་བཞིར་ཚལ་རིགས་ཐོན་སྐྱེད་ཐུབ་ཀྱི་ཡོད་ལ་དཔྱིད་ཀ་དང་དབྱར་ཁ་གཙོ་བོ་ཀྭ་ཡི་རིགས་དང་ཇའེ་ཙེ།",
    "གལ་ཏེ་གཟན་ཆག་དུས་ཡུན་རིང་པོ་ལུས་ན་འཚོ་རྒྱུ་སྣེ་མང་བརྒྱ་ཆ་ནས་བརྒྱ་ཆ་བར་ཁ་སྣོན་བྱས་ཏེ་འཚོ་རྒྱུ་ཤོར་བ་ཁ་གསབ་བྱེད་དགོས།",
    "ལག་པས་སྐྱོར་ཏེ་ཡར་བསླངས་ཀྱང་རང་ཚུགས་མི་ཟིན་པ་དང་།",
    "ལོ་གཅིག་དུས་བཞིའི་ནམ་དུས་དང་བསྟུན་ནས་བྱ་ལྟོ་སྟེར་དགོས་པ་དཔེར་ན་དབྱར་ཁ་དང་སྟོན་དུས་ཞོགས་ལྟོ་ཆུ་ཚོད་པར་སྟེར་དགོས་པ་དང་ཉིན་གུང་ཆུ་ཚོད་པོར་སྟེར་དགོས།",
    "གློག་སྒྲོན་ཆ་སྙོམས་སྒར་དགོས་པ་དང་དུས་བཀག་ཏུ་གློག་སྒྲོན་ཞིབ་བཤེར་དང་གཙང་སེལ་བྱེད་དགོས་ཤིང་གློག་སྒྲོན་འཕྲོ་བརླག་ཕྱིན་པ་དག་དུས་ཐོག་ཏུ་གསར་པ་བརྗེ་དགོས།",
    "རྩི་ཤིང་རང་བཞིན་གྱི་སྤྲི་དཀར་གཟན་ཆག་ནི་སྤྲི་དཀར་རིགས་ཀྱི་གཟན་ཆག་ནང་བེད་སྤྱོད་མང་ཤོས་ཀྱི་རིགས་ཤིག་ཡིན།",
    "པད་ཁར་ཚ་ལ་མ་འདང་ན་མྱུག་དུས་འཁུམས་ནས་མི་སྐྱེ་བ་དང་མེ་ཏོག་བཞད་དུས་འབྲས་བུ་མི་འདོགས་པ།",
    "གཏོར་ལུད་བྱེད་སྐབས་མྱུག་དུས་དང་མཐེའུའི་དུས།",
    "ལུད་རྒྱག་སྐབས་སོ་སོར་མྱུག་དུས་དང་མེ་ཏོག་ཐོག་མར་བཞད་པའི་དུས།",
    "གྲོར་ཚ་ལ་མ་འདང་ན་སྨྱུག་དུས་སྙེ་མ་རྒྱུན་གཏན་མི་གཏོང་བ་དང་དུས་མཇུག་ཏུ་སྙེ་མ་བཏགས་ཀྱང་འབྲུ་རྡོག་མེད་ཅིང་སྙེ་སྟོང་མང་བས་ཐོན་ཚད་དམའ་བ་དང་སྤུས་ཚད་ཞན་པོ་ཡོད།",
    "མྱུག་དུས་དང་མེ་ཏོག་ཐོག་མར་བཞད་དུས་སུ་གར་ཚད་ལ་བརྒྱ་ཆ་ཀྱི་ཚ་ལའི་གཤེར་ཁུ་སོ་སོར་ཐེངས་གཏོར་ན་སྔོ་རྩྭ་སོས་པ་ཐོན་ཚད་བརྒྱ་ཆ་ཡན་མཐོ་རུ་འགྲོ་ཐུབ།",
    "བོད་ཀྱི་ལོ་ཙྪ་བ་རྦེ་ར་ཙ་ནས་བསྒྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ།",
    "དེ་བཞིན་ཉིདདང་རང་བཞིན་དང་།",
    "དེ་ཡང་རང་སྣང་ཞེས་སུ་བཤད།",
    "ཡུམ་གྱི་སྤྱི་རྒྱ་ཡིན་ཏེ་ལས་མཆོག་དུས་སུ་སྦྱར།",
    "དེ་ཕྱིར་ཐུགས་རྗེ་ཆེན་པོས་འབྲེལ་པའི་འགྲོ་དྲུག་དུས་གནས་མུན་སེལ་སྣང་།",
    "མ་སྐྱེས་སྒྱུ་མ་སྣང་དང་རང་བཞིན་མེད་པར་གཅིག།",
    "གྲོགས་ངན་སྤངས་དང་རང་བཞིན་དབྱེ་བ་དང་།",
    "རང་རང་བདེ་བས་རང་མཆོད་ཚེ།",
    "ཏ་ཀི་ཧཱུཾ་དང་རང་སྔགས་ཀྱིས།",
    "དེའང་འབུ་ཏ་ལོ་ཙ་ནེ་སྭཱ་ཧཱ།",
    "ཕྱོགས་གཞན་དུ་རྡོ་རྗེ་གསུམ་གྱི་སྔགས་འབྱུང་རྔུབ་འདུག་པ་ལ་འབད་པ་དང་།",
    "སྦྱན་ལམ་བར་ཆད་བསྲུང་བའི་ཕྱིར་འདུག་ན་འབྲུ་བཞིས་མཚམས་གཅད་ཅེས་པ།",
    "ཏ་ལའི་ལྗོན་ཤིང་རང་བཞིན་གནས་གསུས་ཞེས་པ།",
    "སྐྱེ་མེད་དབྱིངས་དང་རང་རིག་གཉིས་སུ་ཡང་དག་འུབ།",
    "དང་ནི་གདམ་ངག་སྟེ་ཕྱག་རྒྱ་ཅིག་པའི་རྣལ་འབྱོར་ཡན་ཆད་ཐོབ་དང་བསྙེན་པ་རྟགས་ཕྱིན་ནས་རོའ་སྟེང་དུ་འདུག་པའི་ཕྱིར།",
