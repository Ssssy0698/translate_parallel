    "འདོད་པ་བསྐྱོད་པར་བྱེད་པ་འགྲོ་བ་དང་གི་ཡིད་ལའོ།",
    "མཆོག་དགའ་གང་བ་ཡན་ལག་མཆོག་ལ་རི་བོང་འཛིན་པ་ཁུ་བར་བྱས་ནས་འབར་བའི་ཐིག་ལེ་བཟངཔོ་འཛག་ཁྱད་དགའ་ཨོཊྚས་བཀུག་པ་མཆོག་གི་བདེ་བ་རང་བཞིན་གྱིས་སྟེར་ཐིག་ལེ་དག་ནི་གྲོལ་བ་གསུམ་གྱི་མཐར་ལྷན་ཅིག་སྐྱེས་དགའ།",
    "བལྟ་དང་རེག་དང་འགྲོགས་ལ་འཛག་པའི་བདེ་བ་འདི་དག་དགའ་བའི་དབྱེ་བ་ལ་སོགས་དག་གིས་སོ།",
    "འདོད་པ་དགའ་བར་བྱེད་ཏེ་དེ་དང་པོ་དག་ཀྱང་མི་རྣམས་ཀྱི་ནི་མིག་གིས་བལྟ་བ་དག་ལས་སོ།",
    "ཕྱི་ནས་གང་བ་རབ་ཏུ་སྦྱར་བ་ལ་སྟེ་སླར་ཡང་མཆོག་གི་དགའ་བ་ཉིད་དོ་རང་ལུས་ལ།",
    "འདོད་པའི་སྐུའི་དགའ་དང་དགའ་བ་གསུང་གི་དགའ་བ་དང་ནི་འདར་པ་ཐུགས་ཀྱི་དགའ་བ་དང་འགྱུར་མེད་ཡེ་ཤེས་ཀྱི་དགའ་དག་དང་བཞི་པོ་ཡིས་ནི་སྦྱོར་བ་དེ་གཅིག་སྟེ།",
    "གང་བ་སྐུའི་དགའ་བ་དང་ནི་ནུས་ཡེ་ཤེས་ཀྱི་མཆོག་དགའ་དང་སྐྱེ་བ་དག་ཐུགས་ཀྱི་མཆོག་དགའ་དང་མཆོག་གི་དགའ་བ་ཉིད་ནི་གསུང་གི་མཆོགདགའ་གཉིས་པར་ངེས་པར་འགྱུར།",
    "འབར་བ་སྐུའི་ཁྱད་དགའ་དང་ནི་ཐིག་ལེ་ཡེ་ཤེས་ཀྱི་ཁྱད་དགའ་གཉིད་ཡུར་དག་ཐུགས་ཀྱི་ཁྱད་དགའ་དང་སླར་ཡང་ཁྱད་པར་དགའ་བ་ཉིད་གསུང་གི་ཁྱད་དགའ་ནི་གསུམ་པའོ།",
    "ཞེས་པ་ལྟར་ཤེས་རབ་མ་ལ་མིག་གིས་བལྟས་པ་ལས་རང་གི་ཡིད་ལ་འདོད་ཆགས་གཡོ་བའི་བདེ་བ་སྐྱེས་པ་ནི།",
    "དེ་རྣམས་ཀྱང་བདེ་བ་རིམ་གྱི་སྐྱེ་བའི་དབྱེ་བས་བྱིས་པ་གཞོན་ནུ་ལང་ཚོ་རྒད་པོ་སྨིན་པ་སྟེ།",
    "བསམ་གཏན་བཞི་པའི་རྩེ་མོ་འཆང་།",
    "ཞུ་བདེ་འགྱུར་མེད་ཀྱི་དགའ་བ་བཞི་དང་བཅུ་དྲུག་རིམ་གྱིས་བསྐྱེད་པ་ལས་འབྲས་བུ་དག་པ་གཉིས་ལྡན་གྱི་སྐུ་བཞི་དང་བཅུ་དྲུག་རང་བཞིན་འགྱུར་བ་མེད་པའི་བདེ་བ་ཆེན་པོ་དང་སྟོང་པ་ཉིད་ཟུང་དུ་འཇུག་པ་དུས་ཀྱི་འཁོར་ལོའི་གོ་འཕང་ཐོབ་པར་འགྱུར་རོ་ཞེས་གསུང་བར་བསམ་མོ།",
    "སྲིད་པའི་ངན་འགྲོ་ལས་ཁྱོད་འདས།",
    "ཁྱོད་ཀྱིས་ནམ་ཡང་མི་བྱའོ།",
    "༦འདོད་པ་ཀུན་ལ་སྤྱོད་པས་ཁྱོད།",
    "བུད་མེད་རིན་ཆེན་སྤང་མི་བྱ།",
    "མི་འཇིགས་ཁྱོད་ལ་སྡིག་མེད།",
    "རང་གི་དམ་ཚིག་མི་བཟད་བདེ་སྟེར་བསྟེན་པར་གྱིས།",
    "འདི་ལྟར་ཁྱོད་ཀྱི་བཀའ་དྲིན་གྱིས།",
    "བདག་གི་གསོན་པའང་འབྲས་བུར་བཅས།",
    "ཁྱོད་ཀྱི་འདོད་པ་རབ་རྫོགས་མཛོད།",
    "ཁྱོད་ལ་བདག་ནི་འབུལ་ལགས་ཀྱིས།",
    "རྡོ་རྗེས་ཚངས་ཐིག་གི་ལམ་ནས་བདེ་ཆེན་འཁོར་ལོའི་རྡོ་རྗེ་ཇི་སྲིད་པར་ཕྱིས་ལ།",
    "གསོལ་གདབ་སྡོམ་བཟུང་སོ་ཤིང་འཁྱོར་ཆུ།",
    "འདི་ནི་འདི་འདྲའི་ཚུལ་ལ་མོས་པ་ཡི།",
    "དེ་ཉིད་གཟིགས་པ་རྣམས་ལ་བཟོད་པར་གསོལ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་གཅིག་ན་།",
    "ཡཀྴ་འབར་བྱེད་དང་གནོད་སྦྱིན་ཀུ་བ་རེ་ལ་སོགས་ཏེ།",
    "ཞུགས་མ་ཐག་ཏུ་རྡོ་རྗེ་འཆང་གི་གསུང་ལས་རྟ་མགྲིན་སྤྲུལ་ཏེ།",
    "རྡོ་རྗེ་འཆང་གི་ལྗགས་ཀྱི་སྟེང་དུ་གནས་སོ་།",
    "ཐམས་ཅད་མིང་གི་མཚན་ཉིད་ཙམ་དུ་གྱུར་ཏོ་།",
    "ང་ནི་ཉོན་མོངས་ཞི་བྱེད་པ་།",
    "དེ་ནས་ཡང་བཅོས་ལྡན་འདས་ཀྱིས་མ་མོ་རྩད་ནས་བཅད་པ་འདི་གསུངས་སོ་།",
    "སརྦ་ཤ་ཏྲུམ་ཆེ་གེ་མོ་མ་ར་ཡ་རྦད།",
    "ཐལ་བ་ཆུ་བོའི་གཞུང་ལ་འོ་།",
    "སྦྱིན་སྲེག་གི་ལེའུ་སྟེ་དགུ་པའོ་།་།",
    "རྡོ་རྗེ་གསུང་གི་གཙོ་བོར་ཤོག།",
    "ཚིག་གིས་མཉེས་པར་བྱ་བའི་ཕྱིར་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱི་དེ་དག་གི་ཕྱག་རྒྱ་འདི་དག་གསུངས་སོ་།",
    "ཁྲོ་མོ་གུང་ཚིགས་བར་པ་དགུག།",
    "དམོད་པའི་དྲག་སྔགས་འདི་དག་གོ།",
    "སྲིན་མོ་གློག་འཕྲེང་གི་དྲག་སྔགས་ཀྱི་ལེའུ་སྟེབཅུ་དྲུག་པའོ་།",
    "གདུག་པ་ཞེ་སྡང་དུག་གི་མཚོ་།",
    "གཞོན་ནུ་རྣམས་ལ་སྟོང་ཚེ་རེ་།",
    "བྱོལ་སོང་རྣམས་ལ་བརྒྱ་བཟླས་ལ་།",
    "དྲེགས་པ་ཕོ་མོ་འཁོལ་བ་རྣམས་།",
    "སྲིན་མོ་ནམ་གྲུ་མཚོ་ལྔའི་ལེའུ་སྟེ་བཅུ་བདུནཔའོ་།",
    "རྣལ་འབྱོར་ཚིག་གིས་རྣལ་འབྱོར་པའི།",
    "ཧཱུྃ་ལས་བྱུང་བའི་རྡོ་རྗེ་རྩེ་མོ་ལྔ་པ་ལ།",
    "བྱུང་བའི་ལྷ་མོ་རྣམས་བསམ་པར་བྱའོ།",
    "དཀར་པོ་དང་དུད་ཀ་དང་དུང་དང་པདྨ་ལ་སོགས་པ་ནི་ལག་པ་གཡས་པའི་སོར་མོ་ལ་དགོད་དོ།",
    "གི་ཝང་དང་དྲི་མ་གསུམ་དང་འཇིགས་པ་དང་སའི་གདུགས་ནི་གཡོན་པ་ལ་དགོད་དོ།",
    "ལྐོག་མར་ཟླ་བ་ལེགས་པར་བསམས་པ་ལ་གནས་པའི་པདྨའི་འདབ་མ་གཅིག་གིས།",
    "ཕྱག་གཉིས་པ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་དུ་བཞུགས་པ།",
    "བགེགས་རྣམས་ཚིག་པར་གྱུར་པར་བསམ་མོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་པར་བྱ་སྟེ།",
    "འཇོག་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།",
    "ནུབ་ཏུ་ནམ་མཁའ་ལྡིང་གི་གདན།",
    "མེ་ཕྱོགས་རྡོ་རྗེ་གདོང་གི་གདན།",
    "གཉིས་པ་དེའི་སྟེང་དུ་ཡི་གེ་ཧཱུྃ་ལ་ཕྱོགས་ཀྱི་འདབ་མ་ལ་གནས་པའི་ལྷ་མོ་བཞིས་བསྐུལ་བར་བསམ་པར་བྱ་སྟེ།",
    "སེང་གེའི་གདན་གྱི་སྟེང་དུ་རང་གི་གནས་སུ་སྦྱང་ཞིང་།",
    "སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་ཅིང་མཆོད་ཡོན་དང་།",
    "སྒྱུ་མ་ལྟ་བུར་ལྷག་པར་མོས་པས།",
    "ལྷ་མོ་དེ་ལྟར་བསྒོམ་བྱ་བ།",
