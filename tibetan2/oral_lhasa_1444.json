    "རྣམ་པར་གཏན་ལ་དབབ་པ་བསྡུས་པ་ལས་ཀྱང་།",
    "གཞན་དག་གནོད་པར་བྱེད་པ་ལ་མི་བཟློགས་པ་དང་།",
    "ཉན་ཐོས་ཀྱི་སྡོམ་པ་ནི་རྟེན་མ་ཡིན་པར་རྟོགས་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་གཟུང་བར་བྱའོ།",
    "ལྷའི་ཡུལ་དུ་ཕྱིན་པར་མི་འགྱུར་ཡང་དེར་ལམ་དུ་ཞུགས་པ་ཞེས་བྱ་བ་ཡིན་པ་དེ་བཞིན་དུ།",
    "འདི་ན་གང་ཟག་ཁ་ཅིག་ཉན་ཐོས་ཐོབ་པར་བྱ་བའི་བསམ་པ་སྔོན་དུ་བཏང་ནས་སྲོག་གཅོད་པ་སྤོང་བ་ལ་སོགས་པའི་སྡོམ་པ་ཡང་དག་པར་བླངས་པའི་ཚེ།",
    "དེ་ཉིད་ཉན་ཐོས་ཀྱི་སྡོམ་པར་ནི་མི་འགྱུར་ཏེ།",
    "ཉན་ཐོས་ཐོབ་པར་བྱ་བའི་བསམ་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཉེ་བར་ལེན་པའི་རྒྱུ་གང་མེད་པར་འདོད།",
    "སེམས་བསྐྱེད་ཀྱང་དེ་དག་ལས་ལྡོག་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "མྱ་ངན་ལས་འདས་པའི་བསམ་པ་ཡང་ཇི་ལྟ་བུ་བསྐྱེད་པར་བྱ་བ་མི་ཤེས་ལ་སྡོམ་པ་ཡང་གང་ལེན་པར་བྱེད་པ་མི་ཤེས་ཤིང་།",
    "དེ་ལྟར་རིགས་དང་མི་ལྡན་པ་ལ་ཡང་སྡོམ་པ་སྐྱེ་བ་དེ་ནི་རྐྱེན་ཇི་ལྟ་བ་བཞིན་དུ་བསམ་པ་སྐྱེས་པའི་སྒོ་ནས་སྡོམ་པ་ལེན་པ་ལ་འཇུག་པར་བྱེད་པའི་སྤྲོས་པའི་བག་ཆགས་ཐོག་མ་མེད་པའི་དུས་ཅན་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ལ་ཡོད་པ་ཉིད་ཡིན་ཏེ།",
    "དཔེར་ན་མུ་སྟེགས་ཅན་གཞན་རྣམས་ཀྱི་བདག་ལ་སོགས་པ་གྲོལ་བར་བྱ་བའི་ཕྱིར་སྡོམ་པ་ལེན་པ་ལ་འཇུག་པར་བྱེད་པ་ཉིད་བཞིན་དུ།",
    "དེ་ཡང་བདག་གྲོལ་བ་ཞེས་བྱ་བའི་འབྲས་བུ་ཐོབ་པར་བྱེད་པ་ཉིད་དམ།",
    "ཅེས་གསུངས་པའི་ཕྱིར།",
    "ད་ནི་ཡང་དག་པར་བླངས་པ་མི་ཉམས་པར་བསྲུང་བའི་ཚུལ་གྱིས་འཇུག་པ་རྒྱས་པར་བྱ་བའི་ཕྱིར།",
    "རིགས་སུན་འབྱིན་པར་མི་བྱ་བའི་དོན་དུ་བསླབ་པ་ལ་འབད་པར་བྱ་བར་སེམས་ལ་གོ་བ་གོ་བར་བསྟན་ཏོ།",
    "ལྷག་མས་ནི་ཕན་ཡོན་བསྟན་པའི་སྒོ་ནས་ཡང་དག་པར་མི་ཉམས་པར་སེམས་ལ་གོ་བ་གོ་བ་ཉིད་དུ་བསྟན་ཏེ།",
    "བསླབ་པ་ལ་བསླབས་པས་ཅི་རིགས་པར་བདག་དང་གཞན་ཉིད་ཀྱི་དོན་འགྲུབ་པར་བྱེད་པའི་རྒྱུ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བརྩོན་འགྲུས་ཀྱི་ངོ་བོ་ཉིད་ཀྱིས་བག་ཡོད་པ་ལ་གནས་པར་བྱ་དགོས་པས།",
    "ལེའུ་གསུམ་པ་གསུངས་སོ།",
    "ཅུང་ཟད་བརྟགས་ཀྱང་ལེགས་པར་བརྟགས་པ་དེ་ཉིད་གཟོད་བརྟགས་ལ་སྒྲུབ་ཀྱི།",
    "དེ་བཞིན་གཤེགས་པ་ཉིད་ཁོ་ནས་མཁྱེན་གྱི།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "སེམས་བསྐྱེད་པ་བཏང་ན་ནི་ཉམས་པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "གཞན་དག་སྨོན་པའི་སེམས་བསྐྱེད་པར་འདོད་པའི་བར་ཆད་བྱས་སམ།",
    "བདག་ཉིད་ཀྱིས་བརྩོན་པར་མ་བྱས་ན།",
    "སྔར་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་མི་ཕན་པ་བཞིན་དུ་ཕྱིས་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་ཕན་པར་མི་འགྱུར་བས།",
    "བདག་ཉིད་ཀྱིས་བརྩོན་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "ཕྱིས་དལ་འབྱོར་ཐོབ་པའི་དུས་སུ་འབད་པར་བྱའོ་སྙམ་ན་དེ་ནི་ཤིན་ཏུ་རྙེད་པར་དཀའ་བས་ད་ལྟ་ཉིད་དུ་འབད་པར་བསྟན་པའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "དགྲ་ལ་སོགས་པའི་འཚེ་བ་མེད་པས་དུས་ཕྱིས་བསླབ་པ་ལ་བརྩོན་པར་བྱའོ་སྙམ་ན།",
    "དེ་ལྟར་ཡིན་པར་ཅི་མངོན་ཞེ་ན།",
    "ཡུལ་ཁྱད་པར་ཅན་ལ་ཞེ་སྡང་བསྐྱེད་པ་ལྟ་བུའོ།",
    "སྐད་ཅིག་གཅིག་བྱས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "དེ་ལྟ་བས་ན་ད་ལྟར་གྱི་དུས་སུ་བརྩོན་པར་མ་བྱས་པའི་ཉེས་དམིགས་མཇུག་བསྡུས་ཏེ་བསྟན་པའི་ཕྱིར།",
    "དེ་བས་ན་ཤིན་ཏུ་རྙེད་པར་དཀའ་བའི་དལ་འབྱོར་ཕུན་སུམ་ཚོགས་པ་རྙེད་པའི་དུས་སུ་བདག་ཉིད་ཀྱི་བྱ་བ་དང་བྱ་བ་མ་ཡིན་པ་ཤེས་བཞིན་དུ།",
    "སྔགས་ཀྱིས་རྨོངས་པར་བྱས་པ་བཞིན་དུ་བདག་ཉིད་ལ་གནོད་པ་བྱ་བ་ཡིན་པས།",
    "བདག་ཉིད་ཀྱི་སེམས་ལ་རྟེན་ཅིང་བདག་ཉིད་ལ་ཚེ་འདི་དང་ཕྱི་མར་གནས་པ་ནི་བྱེད་ན་ཤིན་ཏུ་ཡང་བཟོད་པར་བྱ་བའི་གནས་མ་ཡིན་པས།",
    "འོན་ཏེ་ཐ་མལ་པའི་དགྲ་བཞིན་དུ་བསྡུམས་བྱས་པས་ཕན་ནམ་ཞེ་ན།",
    "མཐུན་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "བྱ་ལྕགས་ཀྱི་མཆེ་བ་ཅན་ལ་སོགས་པ་བདག་ལ་གནོད་པར་བྱེད་པའི་ཕྱིར།",
    "དེ་བས་ན་དེ་ཡང་སྤོང་བར་བྱ་བ་དང་བརྩོན་པར་བསྐྱེད་པའི་ཕྱིར།",
    "དེ་སྤང་བ་ལ་བརྩོན་འགྲུས་རྩོམ་པར་མ་ནུས་སོ་སྙམ་པ་ལ།",
    "ཐ་ན་གཉིད་ཀྱང་མི་ལོག་པར་བརྩོན་འགྲུས་རབ་ཏུ་རྩོམ་པར་བྱེད་ན།",
    "དེའི་གནས་སྐབས་ཀྱིས་སྡུག་བསྔལ་དེ་དག་བཟོད་ཅིང་དང་དུ་ལེན་པར་བྱེད་ན།",
    "ཕྱིར་ཞིང་འཇིག་རྟེན་དག་ངོམས་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཅིའི་ཕྱིར་གནོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "མ་ཡིན་པས་དེ་ལ་བཟོད་པར་བྱ་བའི་དོན་ཏོ།",
    "གཞན་ཡང་འཇིག་རྟེན་ན་དོན་ཆུང་ངུའི་ཕྱིར་ཡང་སྡུག་བསྔལ་ཆེན་པོ་དག་ལ་བཟོད་པར་བྱེད་པ་མཐོང་ན།",
    "ཤིན་ཏུ་ཡང་བཟོད་པར་བྱ་དགོས་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཚེ་ཐ་མལ་པའི་དགྲ་རྣམས་གཞན་དུ་བདག་ལ་གནོད་པར་མི་འགྱུར་རམ་ཞེ་ན།",
    "བརྩོན་པར་བྱེད་པའི་ཕྱིར་མ་སྤངས་པར་ཟད་ཀྱི།",
    "རང་བཞིན་མེད་པས་གོམས་བྱས་པས།",
    "ད་ནི་བག་ཡོད་པ་ལ་གནས་པར་བྱ་བའི་ཕྱིར།",
    "བསླབ་པ་བསྲུང་བར་བྱ་བའི་ཚིགས་སུ་བཅད་པ་གཅིག་གསུངས་ཏེ།",
    "དེ་ལ་དང་པོར་རྩ་བ་གཉིས་ཀྱིས་ནི་ཡང་དག་པར་བསླབ་པ་མི་ཉམས་པར་འགྱུར་བའི་ཕན་ཡོན་བསྟན་ཏོ།",
    "ཕྱུག་པོར་འགྱུར་བས་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་ན་ནི།",
    "སེམས་འདི་ཉིད་ལུས་དང་ལོངས་སྤྱོད་ལ་སོགས་པ་ལ་ལྷག་པར་མ་ཆགས་པས་བསྲུངས་ཏེ།",
    "གཞན་ལ་གཏོང་བའི་སེམས་དང་ལྡན་པ་ཉིད་ཀྱིས་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་གཞན་དག་ཕྱུག་པོར་བྱ་བ་ཚེགས་མེད་པར་ཡང་འགྲུབ་པས་ལག་ཏུ་འོང་ཞེས་བྱ་སྟེ།",
    "སྲོག་གཅོད་པ་སྤོང་བ་ཞེས་བྱ་བ་ནི་ཉ་ལ་སོགས་པ་མི་འཆི་བར་བྱ་བའི་དོན་དུ་སྲོག་གཅོད་པར་བྱེད་པའི་ཉ་པ་ལ་སོགས་པ་དེ་དག་སྲོག་གཅོད་པ་ལ་ནི་མི་བྱ་སྟེ།",
    "བདག་ཉིད་ལ་སྲོག་གཅོད་པ་སྤོང་བའི་སེམས་ཐོབ་པ་ཙམ་གྱིས་ཉ་པ་ལ་སོགས་པ་སྐྲོད་པའི་ཚེགས་མེད་པར་ཡང་སྲོག་གཅོད་པ་སྤོང་བ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "ལེ་ལོ་ཅན་གྱི་གང་ཟག་རྣམ་པར་གཡེང་བ་དང་།",
    "ཤེས་རབ་འཆལ་བའི་གང་ཟག་སྤོང་བ་ལ་སོགས་པའི་ཚེགས་མེད་པར་བདག་ཉིད་ཀྱི་སེམས་གནོད་སེམས་དང་ལེ་ལོ་དང་།",
    "རྣམ་པར་གཡེང་བ་དང་།",
    "བཟོད་པ་ནས་ཤེས་རབ་ཀྱི་བར་དུ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའི་ཕྱིར།",
    "དེ་བས་ན་བདག་ཉིད་ཀྱི་སེམས་གནོད་པར་བྱེད་པའི་བསམ་པ་ལས་བཟློག་པ་ཙམ་གྱིས་འགྲུབ་སྟེ།",
    "དཔེར་ན་རྐང་པ་ལ་ཚེར་མས་མི་ཚུགས་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནི་བསྒྲུབ་པར་བྱ་བའི་གནས་ཡིན་པ་དེ་བཞིན་དུ་འདིར་ཡང་དེ་དང་འདྲའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "བསམ་གཏན་དང་པོའི་བར་ཆད་མེད་པའི་ལམ་དང་མཚུངས་པར་ལྡན་པ་བསམ་གཏན་གྱི་སྡོམ་པས་བསྡུས་པའི་སེམས་གསལ་པོ་གཅིག་ཙམ་བསྐྱེད་ན་ནི།",
    "དེའི་ཚེ་ལས་ཀྱི་ལུས་ངག་གཉི་ག་དང་བཅས་ཀྱང་འབྲས་བུ་ཁྱད་པར་ཅན་ཐོབ་པ་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "རྣམ་པར་དག་པ་དམ་པ་དང་།",
    "བག་མེད་པ་ལས་ལེགས་པར་བསྲུང་བར་བྱའོ།",
    "འོན་ཏེ་དེའི་སྦྱངས་པའི་ཡོན་ཏན་བཅུ་གཉིས་ལ་སོགས་པ་ཡང་དོན་མེད་པར་འགྱུར་ཞེ་ན་མ་ཡིན་ཏེ།",
    "སེམས་བསྲུང་འདོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཤེས་བཞིན་ལ་གནས་པ་ནི་བྱ་བ་དང་བྱ་བ་མ་ཡིན་པ་ཤེས་པར་གྱུར་པ་ལ།",
    "དེ་སྤོང་བའི་ཕྱིར་དྲན་པ་དང་ཤེས་བཞིན་ལ་གནས་པར་བྱ་སྙམ་པའི་དོགས་པ་བསུས་ན།",
    "མ་ཡིན་པ་ཤེས་པའི་ཕྱིར་དེ་དག་ལ་གོ་རིམས་བཞིན་དུ་བསྒྲུབ་པ་དང་སྤོང་བའི་མཐུ་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མང་དུ་ཐོས་པ་ལ་སོགས་པ་ཇི་སྙེད་བྱས་སུ་ཟིན་ཀྱང་འདིར་ནི་བརྗོད་དུ་མི་རུང་སྙམ་པའི་ཤེས་བཞིན་མེད་པའི་ཕྱིར་བརྗེད་ངས་པར་འགྱུར་བས་ཐོས་པ་ཉིད་ཀྱང་ཆུད་ཟ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་དྲན་པ་ཉམས་པར་གྱུར་ན་གོང་དུ་བསྟན་པ་བཞིན་གྱི་ཉེས་དམིགས་ཡོད་པས་དྲན་པ་མི་འཆོར་བར་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་ཉམས་པར་གྱུར་ན་ཡང་སྔར་བསྟན་པའི་ཉེས་དམིགས་དྲན་པར་བྱས་ནས་སླར་དགུག་པར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གུས་བྱེད་ལ་ཞེས་བྱ་བ་ནི་བསླབ་པ་ལ་གུས་པར་བྱེད་པ་སྟེ།",
    "ཁྲེལ་ཡོད་པ་དང་ལྡན་ཞིང་བསླབ་པ་ལ་གུས་པར་བྱེད་པའི་རྒྱུས་བསླབ་པ་ཀུན་ལས་བཏུས་པ་ལས།",
    "གལ་ཏེ་བསླབ་པ་ལས་ཉམས་པར་གྱུར་ན།",
    "འོན་ཏེ་དེ་ལྟར་བྱས་ན་ཡོན་ཏན་ཅི་ཡོད་ཅེ་ན།",
    "བྱ་བ་དང་བྱ་བ་མ་ཡིན་པ་བརྗེད་པར་མ་གྱུར་པ་ན།",
    "དེ་ལས་ཀྱང་དང་པོར་བྱ་བ་ཐམས་ཅད་ཀྱི་ཐོག་མར་འགྲོ་བའི་ཤེས་བཞིན་གྱིས་སེམས་ཀྱི་སྤྱོད་ལམ་ལ་བརྟག་པར་བྱ་བ་བསྟན་པའི་ཕྱིར།",
    "སྐྱོན་མེད་པའི་སེམས་ལ་ཤིང་བཞིན་དུ་ཟུང་ཐུབ་པར་བྱའོ་ཞེས་གནས་པར་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལས་བཟློག་པའི་སྐྱོན་མེད་པའི་སེམས་ཀྱང་ཤེས་པར་བྱའོ།",
    "འགྲོ་བར་མི་བྱ་བ་ལ་སོགས་པ་ཤེས་པར་བྱས་ནས་ལས་ལ་འཇུག་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "བྱ་བ་མ་ཡིན་པ་ཤེས་པར་བྱས་ནས་བསྒྲུབ་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ལུས་དང་ངག་དང་ཡིད་ཀྱི་སྤྱོད་ལམ་ལ་བརྟག་པར་བྱ་བའི་ཕྱིར་ལུས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དབྱེ་བ་ཐམས་ཅད་ཀྱི་ཐོག་མར་འགྲོ་བའི་ཤེས་བཞིན་གྱིས་བྱ་བ་དང་བྱ་བ་མ་ཡིན་པ་ཤེས་པར་བྱས་ནས།",
    "དངོས་སུ་ལུས་ཀྱི་སྤྱོད་ལམ་བརྟག་པར་བསྟན་ལ།",
    "འགྲོ་བའི་སྤྱོད་ལམ་ལ་བརྟག་པར་བསྟན་ཏོ།",
    "ཚིགས་སུ་བཅད་པ་གཉིས་པས་ནི་ཡིད་ཀྱི་སྤྱོད་ལམ་ལ་བརྟག་པར་བསྟན་ཏོ།",
    "དེ་བཞིན་དུ་ཟ་བ་དང་ཉལ་བ་ཡང་མི་བརྗེད་པར་བྱའོ།",
    "སྨྲ་བ་ཡིན་ཞེས་བརྗོད་པར་བྱ།",
    "འདི་དང་འདི་ལྟར་བྱའོ་ཞེས་བྱ་བ་མ་ཡིན་པ་བསྡོགས་པར་ཡང་ཤེས་པར་བྱའོ།",
    "མི་འཇིགས་པའི་སྦྱིན་པ་བྱིན་པར་མི་འགྱུར་ལ།",
    "བརྫུན་དུ་སྨྲས་པར་གྱུར་ན་ནི།",
    "སྔ་མ་ཡང་ལེགས་པར་ཟིན་པ་ཉིད་དུ་འགྱུར་ལ།",
    "སྔ་མའི་འཕྲོ་མ་ལུས་པ་ཕྱི་མ་ཡང་ཐང་ཆོད་པར་བྱར་ཡོད་པའི་ཕྱིར།",
    "གཉི་ག་ལེགས་པར་ཟིན་པ་གཅིག་ཏུ་འགྱུར་གྱི།",
    "སྔ་མའི་འཕྲོ་ལུས་པའི་ཕྱིར་སྔ་ཕྱི་གཉི་ག་ལེགས་པར་ཟིན་པར་མི་འགྱུར་ལ།",
    "སྔ་མ་མ་ཟིན་པར་ཕྱི་མ་མི་བྱ་བ་ཉིད་དུ་མི་ཤེས་པའི་ཕྱིར།",
    "དེ་བས་ན་དེ་ལ་འཇུག་པར་ཤེས་བཞིན་གྱི་ཚོར་བར་གྱུར་མ་ཐག་ཏུ་སྤོང་བར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "གང་ཚེ་བསྐྱོད་པར་འདོད་གྱུར་ཏམ།",
    "མི་བཟོད་ཅེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གཉིས་གསུངས་ཏེ།",
    "གཉེན་འདབ་ལ་སོགས་པ་ལ་ལྷག་པར་ཆགས་པ་ནི་སྦྱིན་པའི་མི་མཐུན་པའི་ཕྱོགས་ཡིན་ནོ།",
    "བདག་ཉིད་ཀྱང་དེ་སྒྲུབ་པར་འདོད་པའི་དད་པའོ།",
    "དེ་ལྟ་བུའི་ཚུལ་གྱིས་གཞན་གྱི་དོན་བྱེད་པ་ལ་བརྩོན་པར་བྱའོ།",
    "གཞན་དགའ་བྱེད་ལ་ཞེས་བྱ་བ་ནི་གང་ལ་བརྩོན་འགྲུས་བརྩམ་པར་བྱ་བའི་ཡུལ་ལོ།",
    "གསུམ་པས་ནི་དལ་བ་འབྱོར་པ་རྙེད་པར་དཀའ་བར་བསམས་ནས་སེམས་བསྲུང་བར་བསྟན་ཏོ།",
    "དལ་བ་འབྱོར་པ་ཤིན་ཏུ་རྙེད་པར་དཀའ་བ་ལས་དེ་ཐོབ་པའི་དུས་སུ་དེ་ཐོབ་པ་ཆུད་མི་ཟ་བར་བྱའོ་སྙམ་ནས་སེམས་བསྲུང་བ་སྟེ།",
    "ལུས་ལྷག་པར་ཆགས་པའི་ཚུལ་གྱིས་མ་བསྲུངས་ན་དེའི་ཚེ།",
    "དེ་ལྟར་ཡིན་དུ་ཟིན་ཀྱང་ཡིད་ཀྱིས་ལུས་དེ་ལྷག་པར་ཆགས་པའི་སྒོ་ནས་སྲུང་བར་བྱེད་དོ་ཞེ་ན།",
    "མི་གཙང་བ་ཡིན་པའི་ཕྱིར་རྟེན་དུ་གཟུང་རིན་མི་ཆོག་སྙམ་བསམ་པའོ།",
    "ཇི་ལྟར་མི་གཙང་བ་ཡིན་སྙམ་པ་ལ།",
    "དེ་ལྟ་བུའི་དོན་མེད་པར་ཞེས་བྱ་བའི་སྒོ་ནས་སྦྱིན་པར་བྱ་བ་མ་ཡིན་པས།",
    "ལེགས་པར་སྨྲས་པ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཅི་གཞན་གྱི་ངོ་བོ་འབའ་ཞིག་བསྟོད་པར་བྱ་བའམ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "གཞན་གྱི་གཡམ་ཡང་བརྗོད་པར་བྱ་བ་ཡིན་པས།",
    "དེས་ང་རྒྱལ་བསྐྱེད་པར་མི་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཚེགས་ཆུང་བས་ནི་སྔ་མ་ལ་འགྱོད་པ་མེད་པར་འགྱུར་ཞིང་།",
    "ཕྱི་མ་སྒྱིད་ལུག་པར་མི་འགྱུར་ལ།",
    "འོངས་ཆེ་བས་ནི་མྱུར་དུ་ཚོགས་བསགས་པར་འགྱུར་བས།",
    "དགའ་དང་ལྡན་བྱས་ནས་ཞེས་བྱ་བས་ནི་སྔར་བྱས་པ་ལ་རྗེས་སུ་ཡི་རང་བ་བསྐྱེད་ཅིང་ད་ལྟར་བྱས་པ་ལ་ནི་ཕན་ཡོན་མཐོང་བའི་སྒོ་ནས་དགའ་བ་སྐྱེད་པ་མ་འོངས་པ་ལ་ནི་སྔ་མས་ཆོག་པར་མི་འཛིན་ཏེ།",
    "ཁྱེད་འདོད་པའི་ཚུལ་གྱིས་དགའ་བ་དང་ལྡན་པར་བྱས་ནས།",
    "བདག་ཉིད་ཀྱིས་རྟག་ཏུ་བྱའི་གཞན་ལ་ལྟོས་པར་མི་བྱ་སྟེ།",
    "དེ་ལས་ཁྱད་ཞུགས་པར་གཏོང་བ་ཆེན་པོ་དང་།",
    "ཤིན་ཏུ་གཏོང་བ་ལ་སོགས་པ་ལ་ཁྱད་ཞུགས་པར་སྤྱད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་དེ་ལྟར་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་གོང་ནས་གོང་དུ་སྤྱད་པར་བྱ་བ་ཡིན་ན།",
    "དེ་ལྟར་ཆེ་ཆུང་དུ་འགྱུར་བ་མེད་པའི་ཚེ་ནི་འོག་མ་གཙོ་ཆེར་དང་དུ་བླང་བ་ཉིད་དུ་རིག་པར་བྱའོ།",
    "གཞན་གྱི་དོན་དེ་ནི་ཆེ་བ་ཡིན་པས་གཙོར་དེ་ཉིད་ལ་འབད་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་རིག་བྱས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "མཚམས་མེད་པ་བྱེད་པའི་མི་གསང་བར་གནང་བ་ལྟ་བུའོ།",
    "དེ་ནི་ཚངས་པར་སྤྱོད་པའི་རྟེན་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟར་བྱས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བདེན་པའི་སྟོབས་མ་གྲུབ་པས་སྲོག་དང་ཚངས་པར་སྤྱོད་པའི་བར་ཆད་དུ་འགྱུར་བའི་ཕྱིར་རོ་སྙམ་དུ་བསམ་པ་སྟེ།",
    "ད་ནི་གང་ལ་བསླབ་པར་བྱ་བའི་ཡུལ་བསྡུས་ཏེ་བསྟན་པར་བྱ་བའི་ཕྱིར་རང་ངམ་གཞན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "སྤྱོད་ལམ་ཐམས་ཅད་དུ་ཇི་ལྟར་བསླབ་པ་སྟེ་སྤྱོད་ཡུལ་ཡོངས་སུ་དག་པ་ལས་ཇི་སྐད་གསུངས་པ་བཞིན་དུ་བསླབ་པར་བྱའོ།",
    "རིག་པའི་གནས་ལྔ་དག་ལས་བྱང་བར་མ་བྱས་ན།",
    "ཅེས་གསུངས་པ་ལྟ་བུའོ།",
    "རྣམ་པར་དག་པ་དང་།",
    "ཡོངས་སུ་བསྔོ་བ་དམ་པས་ཡོངས་སུ་རིག་པར་བྱའོ།",
    "རྒྱུ་དང་པོ་ནི་རྟག་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་བསྟན་ཏེ།",
    "མཁས་པ་དང་བཙུན་པའི་ཡོན་ཏན་གཉིས་དང་ལྡན་པ་ལས་ཤེས་པར་བྱའོ།",
    "དེའི་རྗེས་ལ་བསླབ་པ་ཕྲ་བ་གཞན་དག་ཀྱང་ཤེས་པར་བྱ་བའི་ཕྱིར་འཕགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "འོན་ཏེ་དེའི་རྗེས་ལ་ཇི་ལྟར་གསུངས་ཤེ་ན་གང་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བཀག་པ་རྣམས་ནི་སྤྱད་པར་མི་བྱའོ།",
    "ཚེ་འདི་ལ་གནོད་པར་མ་ཟད་ཀྱི་འདི་དང་ཕྱི་མ་གཉི་ག་དང་བདག་ལ་གནོད་པ་བྱེད་པར་མ་ཟད་ཀྱི།",
    "དངོས་སུ་གནོད་པ་བྱེད་པར་མ་ཟད་ཀྱི་བརྒྱུད་པ་དང་དངོས་དང་བརྒྱུད་པ་གཉི་གའི་སྒོ་ནས་གནོད་པར་བྱེད་པས་སོ།",
    "བཟོད་པ་རྣམ་པ་གསུམ་གྱི་སྒོ་ནས་སྤང་བར་བྱ་བ་ཡིན་པས་དང་པོ་གནོད་པར་བྱེད་པ་ལ་ཇི་མི་སྙམ་པའི་སྒོ་ནས་ཡིད་མི་བདེ་བ་སྤང་བར་བསྟན་པའི་ཕྱིར།",
    "རྩ་བ་གཉིས་པས་ནི་ཡིད་མི་བདེ་བ་སྤོངས་ཤིག་ཅེས་གདམས་པར་བསྟན་ཏོ།",
    "ཐ་མལ་པའི་ངང་ལ་བརྟན་པར་གནོས་ཤིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་ན་དོན་མེད་པར་ཡང་སྦྲུལ་ལ་སོགས་པའི་གནོད་པ་བཟོད་ན།",
    "སྡུག་བསྔལ་བཟོད་པའི་ཕན་ཡོན་ཤེས་པར་བྱས་ལ།",
    "དེ་ལ་དགའ་བ་བསྐྱེད་པར་བྱ་བའི་མི་སྔ་མ་རྣམས་བཞིན་དུ་ཡིད་མི་བདེ་བ་བསྐྱེད་པར་མི་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "གཞན་ཡང་སྡུག་བསྔལ་གྱི་ཡོན་ཏན་ཤེས་པར་བྱ་བའི་སྒོ་ནས་ཡིད་མི་བདེ་བ་སྤང་བའི་ཕྱིར།",
    "མ་རིག་པའི་རྐྱེན་གྱིས་འདུ་བྱེད་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཉེས་པ་ནི་ཉེས་པར་བྱེད་པའི་རྒྱུ་ཡིན་པས་ཉེས་པ་སྟེ་འདོད་ཆགས་ལ་སོགས་པ་རྣམས་སོ།",
    "མ་སྐྱེས་པར་དེ་མེད་ན་ནི།",
    "ནམ་མཁའ་བཞིན་དུ་འབྲས་བུ་མི་སྐྱེད་པར་ཤིན་ཏུ་ཡང་གསལ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནི་རྟག་པར་འགྱུར་བ་མེད་པའི་ཕྱིར་གྲོགས་ཅི་ཞིག་བྱར་ཡོད།",
    "ཅུང་ཟད་ཀྱང་མ་བྱས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེས་ནི་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་ཡོད་པར་གྲུབ་ན་ཡང་ཞེས་ཁས་བླངས་ནས་བཅད་དོ།",
    "དེ་ནི་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་ཉིད་ཀྱང་མ་གྲུབ་པར་བསྟན་པའི་ཕྱིར།",
    "དེའི་བྱེད་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟར་ཤེས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གཉིས་གསུངས་སོ།",
    "གལ་ཏེ་རང་དགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གལ་ཏེ་གཞན་དག་གནོད་པར་བྱེད་པ་དེ་རྐྱེན་ལ་མི་ལྟོས་པར་ཁས་ལེན་པའི་ངེས་པ་བསྟན་ཏོ།",
    "བྱིས་པས་ཡང་དག་མ་ལགས་པས།",
    "སྤྱོས་ཤིང་བརྒྱབ་པ་བཟོད་པར་བགྱི།",
    "ལུས་ནི་གཟུགས་ཅན་མ་ཡིན་པའི་ཕྱིར་དང་ཞེན་པས་བདག་ཏུ་གཟུང་བའི་ཕྱིར་དེ་ལ་བརྡེག་པ་ལ་སོགས་པས་གནོད་པ་བྱ་བར་ནུས་ཀྱི་མི་སྙན་པར་སྨྲ་བ་ལ་སོགས་པ་རྣམས་ཀྱི་ནི་ལུས་ལ་ཡང་གནོད་པ་བྱ་བར་མི་ནུས་ན་གཟུགས་ཅན་མ་ཡིན་པ་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཏེ།",
    "ཡིད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གཉིས་གསུངས་སོ།",
    "འོན་ཏེ་མི་སྙན་པར་སྨྲ་བ་དེ་ནི་བདག་ལ་མི་དགའ་བ་ལ་མ་ཡིན་པའི་ཕྱིར་དེ་བདག་མི་འདོད་དེ་ཁྲོའོ་ཞེ་ན།",
    "གལ་ཏེ་ཐ་མལ་པའི་ངང་ལ་གནས་པའི་སེམས་བསྟན་པ་ཉམས་པར་བྱེད་པས།",
    "རྒྱུ་དེའི་ཕྱིར་མི་སྙན་པར་སྨྲ་བ་ལ་ཁྲོའོ་ཞེ་ན།",
    "འོ་ན་ནི་སྔོན་ཆད་སྙན་པར་སྨྲ་བ་ལ།",
    "སྐུ་གཟུགས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལ་ཞེ་སྡང་བསྐྱེད་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "འདིར་སྡུག་བསྔལ་ཡང་ཕྱི་མ་ལ་ཕན་པར་འགྱུར་བར་བྱ་བའི་ཕྱིར་དང་།",
    "དེ་ལྟར་མཐོང་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེ་སྡང་སྤོང་བའི་དོན་དུ་དེའི་རྒྱུ་ལྷག་པར་ཆགས་པ་སྤང་བར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཏེ་དེ་སྤོང་བའི་གནས་སྐབས་ཀྱི་སྡུག་བསྔལ་བཟོད་པར་མི་ནུས་སོ་ཞེ་ན།",
    "དེ་སྤོང་བའི་ཐབས་སུ་གྱུར་པའི་སྡུག་བསྔལ་བཟོད་པར་བྱ་བ་ཡིན་པས།",
    "ཞེ་སྡང་བཟློག་པར་བྱ་དགོས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷག་པར་ཆགས་པ་སྤང་བའི་གནས་སྐབས་ཀྱི་སྡུག་བསྔལ་འདི་ནི་ཅི་སྟེ་བཟོད་པར་མི་ནུས་ཏེ།",
    "ངེས་པར་ལེགས་པ་ཡང་འགྲུབ་པའི་ཕྱིར།",
    "སྒྱིད་ལུག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཏེ་དེ་ལྟར་ན་བྱས་ན་ཕན་ཡོན་ཅི་ཡོད་སྙམ་ན།",
    "དེར་མ་ཟད་ཀྱི་གཞན་ལ་ཡོན་ཏན་ཇི་ལྟ་བ་བཞིན་དུ་བརྗོད་ཅིང་དགའ་བར་བྱེད་པ་འདི་ནི་བསྡུ་བའི་དངོས་པོ་བཞི་ལས་སྙན་པར་སྨྲ་བ་ཞེས་བྱ་སྟེ།",
    "སྟོད་པར་མི་བྱེད་དོ།",
    "བདག་ལ་སྟོད་པར་བྱེད་པའི་གང་ཟག་གཞན་ལ་བདག་ཡིད་དགའ་ཞིང་བདེ་བ་སྐྱེད་པར་འདོད་པར་བྱེད་ན།",
    "ཕ་རོལ་པོ་དེ་བདག་རང་ལ་ཡིད་དགའ་ཞིང་བདེ་བ་སྐྱེ་བར་ཇི་སྟེ་མི་འདོད་པར་བྱེད་དེ།",
    "གདོན་མི་ཟ་བར་འདོད་པར་བྱ་དགོས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་ཡིད་སྨོན་བྱས་པའི་གཞིས་སྡུག་བསྔལ་དེ།",
    "ཕ་རོལ་པོ་ལ་གྲུབ་པའི་ཕྱིར་དེ་ལ་གདགས་པར་བྱེད་དོ་ཞེ་ན།",
    "གལ་ཏེ་དེས་མཚུངས་པར་འགྱུར་བའི་ཕྱིར་དེ་ལ་བདག་དགའ་བར་བྱེད་དོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "ད་ནི་བསྟོད་པ་ལ་སོགས་པ་ལ་ལྷག་པར་དགའ་བར་བྱ་བ་ཡིན་གྱི།",
    "གཞན་ཡང་འགྱུར་བའི་སྡུག་བསྔལ་གྱི་ངོ་བོ་ཉིད་ཡིན་པས་དེ་ལ་ཆགས་པར་མི་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་ཆགས་པར་བྱ་བ་མ་ཡིན་ནམ་སྟོད་པར་བྱེད་པའི་གང་ཟག་དེ་བདག་ལ་དགའ་བ་ཡིན་པའི་ཕྱིར་དེ་ལ་བདག་ཆགས་པར་བྱེད་དོ་སྙམ་ནས།",
    "དེ་ལྟར་ཡང་བྱ་དགོས་སོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅིའི་ཕྱིར་དག་པར་མི་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ད་ནི་སྟོད་པར་བྱེད་པ་ལ་སོགས་པའི་ཉེས་དམིགས་ཤེས་པར་བྱ་བའི་སྒོ་ནས་དེ་ལ་ཆགས་པ་སྤོང་བར་བསྟན་པའི་ཕྱིར།",
    "ད་ནི་གནོད་པ་བྱེད་པའི་ཕན་ཡོན་ཤེས་པར་བྱ་བའི་སྒོ་ནས་དེ་ལ་ཁྲོ་བར་མི་བྱ་བ་བསྟན་པའི་ཕྱིར།",
    "དེའི་ཕན་ཡོན་ཤེས་པར་བྱ་བའི་སྒོ་ནས་དེ་ལ་ཁྲོ་བར་མི་བྱའི་དགའ་བར་བྱ་བ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟར་གནོད་པར་བྱ་བའི་བསམ་པ་དང་ལྡན་པས་བཟོད་པའི་རྒྱུ་ཉིད་ཡིན་གྱི།",
    "འོན་ཏེ་ཇི་ཙམ་དུ་བདག་ལ་ཕན་འདོགས་པར་མཛད་ཅེ་ན།",
    "འོན་ཏེ་གང་དག་བདེ་བས་ཐུབ་པ་རྣམས་དགྱེས་པར་འགྱུར་ཞིང་།",
    "བརྩོན་འགྲུས་བརྩམ་པར་བྱ་བ་བསྟན་པའི་ཕྱིར།",
    "ད་ནི་བརྩོན་འགྲུས་ཀྱི་ལེའུ་ལས་རྣམ་པར་གཞག་པ་བསྟན་པའི་ཕྱིར།",
    "གཅེས་དང་མི་གཅེས་པ་ཇི་ལྟ་བ་བཞིན་དུ་མི་ཤེས་པས་གཅེས་པར་བྱ་བ་མ་ཡིན་པ་ལ་གཅེས་སུ་གཟུང་བའི་ཕྱིར་འཇིགས་པར་ཟད་པས།",
    "འཇིགས་པར་མི་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བསྐལ་པ་བྱེ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བཟོད་ཅིང་དང་དུ་བླང་བར་བྱའི་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མི་དགོས་པར་བསྟན་པའི་ཕྱིར།",
    "ཚོད་མ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཏེ་གོམས་པར་འགྱུར་བ་དེ་ལྟ་ཡིན་ན་ཡང་ཚ་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་དང་ཡན་ལག་ལ་སོགས་པ་མ་ཚང་བའི་རྒྱུས་སེམས་ལ་མི་དགའ་བ་སྐྱེ་བའི་ཕྱིར་ཆོ་ག་ཤིན་ཏུ་འཇམ་པོ་མ་ཡིན་ནོ་ཞེ་ན།",
    "སེམས་ལ་གནོད་པ་བྱེད་པའི་ལོག་པར་རྟོག་པའི་གཉེན་པོ་རང་བཞིན་མེད་པ་ཉིད་དུ་མཁས་པའི་ཕྱིར།",
    "འཕགས་པ་ཕུང་པོ་གསུམ་པ་ལས་ཇི་སྐད་གསུངས་པ་བཞིན་དུ།",
    "མཆོག་ཏུ་སྤྲོ་བ་བསྐྱེད་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཆོག་པར་མི་འཛིན་པའི་བརྩོན་འགྲུས་ཀྱི་སྒོ་ནས་སྙོམ་ལས་ཀྱི་སྟོབས་གཞོམ་པའི་ཕྱིར།",
    "ཆོག་པར་མི་འཛིན་པ་སྟེ།",
    "དགའ་བའི་དཔུང་བསྐྱེད་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བྱས་པའི་ཕན་ཡོན་བདག་དང་གཞན་གྱི་དོན་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའི་ཕན་ཡོན་ལ་བསམས་པས།",
    "བྱ་བར་མི་རིགས་པ་ལས་ལྡོག་ཅིང་བྱ་བར་རིགས་པ་ལ་སྦྱོར་བས་རིགས་པའི་དཔུང་བསྐྱེད་པར་བསྟན་པའི་ཕྱིར།",
    "བྱ་བར་རིགས་པ་ནི་བདག་དང་གཞན་དུ་བརྗེ་བར་འགྱུར་བ་ཡིན་ལ་ལོག་པར་ནི་བྱ་བར་མི་རིགས་པ་ཡིན་ནོ།",
    "བྱ་བར་རིགས་པའི་ལས་ལས་མི་ལྡོག་པར་བརྟན་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལས་དེ་ལ་མི་ལྡོག་པར་བརྟན་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ད་ནི་བྱ་བར་རིགས་པའི་ལས་ཇི་སྙེད་བྱས་ཀྱང་།",
    "དེས་ཆོག་པར་མི་འཛིན་པར་ཡང་ནས་ཡང་དུ་བྱེད་འདོད་པའི་དགའ་བའི་དཔུང་བསྐྱེད་པར་བསྟན་པའི་ཕྱིར།",
    "ཡང་འཇིག་རྟེན་དག་ན་ལས་གང་ཞིག་བྱས་པས་འདོད་པའི་བདེ་བ་འགྲུབ་པའི་ངེས་པ་མེད་པ་ལ་ཡང་འགྲུབ་པར་སྲིད་པ་ཙམ་གྱི་སྒོ་ནས་ཀྱང་།",
    "ཡང་ནས་ཡང་དུ་བརྩོན་འགྲུས་རྩོམ་པར་བྱེད་ན།",
    "གདོན་མི་ཟ་བར་འདོད་པའི་བདེ་བ་འགྲུབ་པར་འགྱུར་བའི་ལས་ལ་ཡང་ནས་ཡང་དུ་བརྩོན་འགྲུས་བརྩམས་ན་འདོད་པའི་བདེ་བ་ཐོབ་པའི་ཕྱིར།",
    "ཡང་ནས་ཡང་དུ་བརྩོན་འགྲུས་བརྩམ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཕྲལ་གྱི་བདེ་བ་ཙམ་ལ་བལྟས་ནས་དེས་ངོམས་པར་མི་བྱེད།",
    "ཡང་ནས་ཡང་དུ་བརྩོན་འགྲུས་བརྩམ་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དྲན་པ་ཉམས་པར་འགྱུར་ན་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "མཚོན་པ་ཙམ་དུ་ཟད་ཀྱི་ཤེས་བཞིན་ལ་ཡང་རིག་པར་བྱའོ།",
    "དེས་ན་གདམས་ངག་མི་བརྗེད་པར་བྱ་ཞིང་བདག་ཉིད་ཀྱི་ལུས་སེམས་ཀྱི་སོ་གློད་དེ་ཧ་ཅང་ཡང་བསྒྲིམ་པ་མ་ཡིན་པར་བྱས་ལ།",
    "ལས་ལ་མ་ཞུགས་པའི་གོང་རོལ་ནས་བྱ་བ་ཐམས་ཅད་ཀྱི་ཐོག་མར་འགྲོ་བའི་བཤེས་བཞིན་ལ་གནས་པར་བྱས་ན།",
    "དེ་ལྟར་མ་བྱས་ན་ཉེས་པ་ཅི་ཡོད་སྙམ་པ་ལ།",
    "སྙོམ་ལས་ཀྱི་སྟོབས་གཞོམ་པར་བྱ་བ་མཇུག་བསྡུས་ཏེ་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟར་མི་མཐུན་པའི་ཕྱོགས་གཞོམ་པར་བསྟན་ནས།",
    "ཁྱད་པར་དུ་འཕགས་པར་བསྟན་པར་བྱའོ་སྙམ་དུ་སློབ་དཔོན་གྱི་ཐུགས་ལ་གཞག་ནས།",
    "སློབ་དཔོན་གྱི་དགོངས་པ་མ་ཤེས་པར་མཐོང་སྟེ།",
    "ཅིའི་ཕྱིར་བདག་བཞིན་དུ་གཞན་ལ་ཕན་པར་བྱ་ཞེ་ན།",
    "ཡང་གཞན་གྱི་དོན་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ད་ནི་ཡང་ཁས་བླངས་ནས་བརྗོད་པར་བྱ་སྟེ།",
    "གོམས་པར་གྱུར་ན་དཀའ་བ་མེད་པའི་ཕྱིར།",
    "དེ་ཉིད་མེད་ན་ཞེས་བྱ་བ་ནི་ཤིན་ཏུ་འདྲིས་པར་གྱུར་པའི་ཕྱིར་འདྲེ་ལ་སོགས་པ་དེ་ཉིད་མེད་ནའོ།",
    "ལས་གང་ཞིག་ལ་བརྩོན་འགྲུས་བརྩམ་པར་བྱ་ཞེ་ན།",
    "སྐྲག་པར་འགྱུར་བའི་ཕྱིར་གསང་བར་བྱ་བ་དེ་ལ་བརྩོན་འགྲུས་བརྩམ་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "བདག་ཉིད་ལ་ཕན་གདགས་པར་མི་བྱ་ཞེ་ན།",
    "བདེ་བས་ཕན་གདགས་པར་བྱ་རིན་མི་ཆོག་གོ་སྙམ་ནས།",
    "འཇིགས་པ་གནས་ཆུང་ངུ་ལ་ཡང་ཞེས་བྱ་བ་ནི་སྐྲག་པར་བྱ་རིན་མི་ཆོག་པ་ལ་ཡང་ངོ།",
    "སུ་ཞིག་དགྲ་བཞིན་དུ་སྡང་བར་མི་བྱེད་ཅིང་དགྲ་བཞིན་དུ་བརྙས་པར་མི་བྱེད་དེ།",
    "ལུས་འདི་ལ་དགྲ་བཞིན་དུ་སྡང་ཞིང་བརྙས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་བདག་མཐོ་བར་འདོད་ནས་བདག་ལ་སྟོད་པར་བྱེད་པའོ།",
    "གཞན་ལ་སྤྲོ་བྱས་ན་ཞེས་བྱ་བ་ནི།",
    "དེ་ལྟ་ཡིན་པར་ཅི་མངོན་སྙམ་པ་ལ།",
    "བདག་དང་གཞན་དུ་བརྗེ་བར་མི་བྱ་བའི་སྒོ་ནས་དེ་སྤོང་དུ་གཞུག་པར་བྱ་བའི་ཕྱིར།",
    "གནོད་པ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་ཀྱི་བདེ་བ་དང་ཡིད་བདེ་བ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་ལྟ་བས་ན་བདག་དང་གཞན་གྱི་རྒྱུད་ལ་བྱེ་བྲག་ཕྱེ་བ་མེད་པར་བདག་དང་གཞན་གྱི་བརྗེ་བར་བྱ་བ་ཉིད་དུ་སྤྱིར་གདགས་པ་བསྟན་པ་ཞེས་བྱའོ།",
    "དོན་ནི་དེ་ལ་ཕན་པར་འགྱུར་རོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཅི་ནས་ཀྱང་བདག་ལ་ཕྲག་དོག་བྱས་པའི་སྒོ་ནས་ཏེ།",
    "གཞན་སྐྱིད་པར་བྱ་བའི་དོན་དུ།",
    "གཞན་དག་མཐོ་བར་བྱ་བའི་ཕྱིར་གཞན་ལ་བསྟོད་པར་བྱ་བའམ།",
    "དེ་ལས་ཡོ་བྱད་དག་ལོང་ལ་སྦྱིན་པ་བྱིན་ཅེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "གཞན་དག་ཀྱང་དེ་ལ་དགོད་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡང་སྤྱོད་ལམ་ཐམས་ཅད་དུ་བདག་དང་གཞན་བརྗེ་བར་མི་བྱེད་པའི་ཉེས་པ་བསལ་ཕྱིར་ལྷན་ཅིག་རྗེས་སུ་སྤྱོད་པའི་ཤེས་བཞིན་གྱིས་བརྟག་པར་བྱ་བ་ཡིན་པས་ན།",
    "བདག་ནི་བྲན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་དྲུག་གསུངས་ཏེ།",
    "བཅབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་ལ་གནོད་པ་བྱས་པ་དེ་ད་ཕྱིན་ཆད་ནི་དེའི་ལན་གྱི་ཚུལ་དུ་གཞན་པ་བྱ་བ་དེ།",
    "དེ་དག་འགྲུབ་པར་བྱེད་པའི་སྡུག་བསྔལ་དང་དུ་བླང་བར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་གྱི་དོན་བྱས་པའི་ཕན་ཡོན་གྱི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདག་དང་གཞན་དུ་འགྲུབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷག་མཐོང་བསྐྱེད་པར་བྱ་བའི་ཕྱིར།",
    "ཞི་གནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལེའུ་བདུན་པ་གསུངས་ཏེ།",
    "ཞི་གནས་ཀྱི་ཚོགས་ལ་གནས་པར་བྱ་བ་དང་།",
    "ཚོགས་ལ་གནས་པ་དེས་མཉམ་པར་གཞག་པའི་གནས་སྐབས་སུ་ཇི་ལྟར་བཙལ་བར་བྱ་བ་དང་གཉིས་ཀྱིས་བསྟན་ཏེ།",
    "སྔ་མ་ཞི་གནས་ཀྱི་ཚོགས་ལ་གནས་པར་བྱ་བ་ལ།",
    "དེ་ལས་བཟློག་པས་ནི་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཆགས་པར་བྱེད་པ་མི་རིགས་ལ།",
    "གཉེན་ལ་སོགས་པ་ཡང་མི་རྟག་པ་ཡིན་པའི་ཕྱིར་ཆགས་པར་བྱ་བར་མི་རིགས་ཏེ།",
    "ད་ནི་གཉེན་ལ་སོགས་པ་ལ་ལྷག་པར་ཆགས་པའི་ཉེས་དམིགས་བསྟན་པའི་སྒོ་ནས།",
    "དེ་ལ་ལྷག་པར་ཆགས་པ་སྤང་བའི་ཕྱིར།",
    "མཐོང་ཡང་ངོམས་པར་མི་འགྱུར་བས།",
    "ཐ་མར་ཞེས་བྱ་བ་ནི་འཆི་བའི་དུས་སུ་འགྱོད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འཇིག་པར་འགྱུར་ཞེས་བྱ་བ་ནི་མྱ་ངན་ལས་འདས་པ་མི་འཐོབ་པའི་ཕྱིར་རོ།",
    "ཕན་པར་སྨྲས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེའི་ཉེས་དམིགས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བས་ན་དེ་དག་དང་རྟག་ཏུ་འགྲོགས་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཉམ་པར་གཞག་ཕྱིར་ཞེས་བྱ་བ་ནི་རྒོད་པའི་མཚན་ཉིད་ཀྱི་མཐོ་བ་དང་།",
    "ད་ནི་བསམ་གཏན་གྱི་སྒྲིབ་པ་ལྔ་ལས་འདོད་པའི་རྣམ་པར་རྟོག་པ་སྤང་བའི་ཉེས་དམིགས་བསྟན་པའི་སྒོ་ནས།",
    "དལ་འབྱོར་ཆུད་ཟོས་པར་བྱས་པའམ།",
    "དེའི་དཔེ་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟར་ཕྱི་རོལ་གྱི་ཡོ་བྱད་ལ་འདོད་པའི་རྣམ་པར་རྟོག་པ་སྤང་བར་བསྟན་ནས།",
    "དེ་ལ་ཆགས་པར་མི་བྱེད་ན།",
    "ཆགས་པར་བྱར་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ད་ནི་གོས་ཀྱི་སྒོ་ནས་ཆགས་པར་བྱར་མི་རིགས་པར་བསྟན་པའི་ཕྱིར།",
    "སྔ་མ་ལས་ངན་པར་གྱུར་པ་མེད་པར་གྱུར་པའི་ཕྱིར་རོ་སྙམ་པའི་བསམ་པའོ།",
    "ཅིའི་ཕྱིར་འདོད་པར་བྱེད་ཅེས་བྱ་བ་ནི་བླ་ལྷག་ཏུ་བཟང་བར་གྱུར་པ་མེད་པའི་ཕྱིར་རོ་སྙམ་དུ་བསམས་པའོ།",
    "དེ་ནི་མི་གཙང་བ་ཡིན་པའི་ཕྱིར།",
    "ཆགས་པར་བྱ་བར་མི་རིགས་པར་བསྟན་པ་ནི།",
    "ད་ནི་དྲིའི་སྒོ་ནས་ཆགས་པར་མི་རིགས་པར་བསྟན་པའི་ཕྱིར།",
    "སེམས་མཉམ་པར་གཞག་པར་བྱ་བར་གདམས་པའི་ཕྱིར།",
    "ད་ནི་སེམས་མཉམ་པར་གཞག་པའི་གང་ཟག་དེས་གོ་འཕང་ཁྱད་པར་ཅན་ཐོབ་པར་བྱ་བའི་དོན་དུ།",
    "ཤེས་རབ་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་ལེའུ་བརྒྱད་པ་གསུངས་ཏེ།",
    "དེ་ལ་གང་ལ་བརྟེན་ཏེ་བསྐྱེད་པར་བྱ་ཞེ་ན།",
    "དེ་ཐོབ་པར་བྱ་བའི་དོན་དུ་ཤེས་རབ་བསྐྱེད་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མྱ་ངན་ལས་འདས་པ་ནི་ངེས་པར་ལེགས་པའོ།",
    "དེ་ལྟར་བསམ་གཏན་ལྡན་པ་དེས་མྱ་ངན་ལས་འདས་པ་དང་བདེ་བ་ཐོབ་པར་བྱ་བའི་དོན་དུ་ཤེས་རབ་གང་བསྐྱེད་པར་བྱ་སྙམ་པ་ལ།",
    "འདིས་ནི་ཡུལ་བདེན་པ་གཉིས་ལ་དམིགས་པའི་ཤེས་རབ་དེ་བསྐྱེད་པར་བྱའོ་ཞེས་བསྟན་ཏེ།",
    "སྒྲའི་ཡུལ་མ་ཡིན་པ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "ཡང་ལྷའི་བུ་དོན་དམ་པར་དོན་དམ་པའི་བདེན་པ་ནི་ཐ་སྙད་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "ཤེས་པར་བྱ་བ་དང་བྲལ་བའི་ཕྱིར་རོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་རིག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡིན་ལ།",
    "བློ་ཡིས་རྣམ་པར་གཞིགས་ན་ནི།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པས་གང་ལྟར་ཡང་མ་གྲུབ་པའི་ཕྱིར།",
    "སྒྲོ་བཏགས་པའི་སྤྲོས་པ་རྣམ་པར་ཆད་པ་ཙམ་དུ་ཟད་པས།",
    "དོན་དམ་པར་ནི་དོན་དམ་པའི་བདེན་པ་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ཡུལ་གྱི་ངོ་བོར་གྱུར་ན་ནི།",
    "ལྷའི་བུ་དོན་དམ་པའི་བདེན་པ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་ཡུལ་ལས་ཀྱང་ཡང་དག་པར་འདས་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་དང་།",
    "ཡི་གེ་དང་སྐད་དང་བརྡས་བསྟན་པ་དག་གོ་ཞེས་བྱ་བ་ཇི་སྐད་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དེ་ལ་རྣལ་འབྱོར་སྤྱོད་པས་འཇིག་རྟེན་ཕལ་པའི་འདོད་པ་སུན་འབྱིན་པར་བྱེད་ཅིང་འཇིག་རྟེན་ཕལ་པ་ལས་གོང་མར་གྱུར་པ་འབྱོར་པའི་འདོད་པ་དེ་ནི།",
    "གང་དེ་ལྟར་རྣལ་འབྱོར་སྤྱོད་པ་པས་ནི་ཇི་ལྟར་སུན་འབྱིན་པར་བྱེད་ཅེ་ན།",
    "ཡང་དག་ཉིད་དུའང་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་སྣང་བ་བཞིན་དུ་ཕྱི་རོལ་གྱི་དོན་ཉིད་དུ་ཡང་དག་པར་རོ།",
    "དེ་གྲུབ་པར་བྱེད་པའི་རིགས་པ་མེད་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་མི་གཙང་བ་ལ་གཙང་བར་འཛིན་པ་བཞིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "འཇིག་རྟེན་གཟུད་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདས་པར་གྱུར་ཏོ་ཞེས་གསུངས་པའི་ཚུལ་གྱིས།",
    "སྐྱེ་བའི་ཕྱིར་དོན་དམ་པར་ཡོད་དོ་ཞེ་ན།",
    "འོ་ན་དེ་ལྟར་དོན་དམ་པར་ངོ་བོ་ཉིད་མེད་པ་ཡིན་ན།",
    "དེའི་ཚེ་ལོ་བརྒྱའམ་སྟོང་ལ་སོགས་པར་ཡུན་རིང་དུ་གནས་པར་མི་རུང་བ་ཞིག་ན།",
    "དོན་དམ་པར་ཡོད་པ་ནི་མ་ངེས་ཀྱི།",
    "གལ་ཏེ་དོན་དམ་པར་མེད་པ་ཉིད་ཡིན་ན་ནི།",
    "དོན་དམ་པར་ཡོད་ཅེས་བྱ་བ་དེ་ཡང་མ་ངེས་པ་ཉིད་དོ་སྙམ་དུ་བསམས་ནས།",
    "དོན་དམ་པར་མེད་པའི་ཕྱིར་ནི་མ་ཡིན་ལ།",
    "དེའི་ཚེ་ཁྱད་པར་མེད་པ་དེ་བཞིན་དུ་སྒྱུ་མ་ལ་ཡང་ཅིའི་ཕྱིར་མི་འབྱུང་ཞེ་ན།",
    "གཉི་ག་ཡང་དོན་དམ་པར་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "སློབ་དཔོན་གྱིས་ཉེས་པ་དེ་ཉིད་སོ་ན་གནས་པར་སྒྲུབ་པའི་ཕྱིར།",
    "ཇི་ལྟར་རལ་གྲིའི་སོ་དེ་ཉིད་ལ་གཅད་པར་བྱ་བ་དང་གཅོད་པར་བྱེད་པ་གཉིས་མེད་པའི་ཕྱིར།",
    "ཤེས་པ་དོན་དམ་པར་ཡོད་པ་ཉིད་དུ་མི་འཐད་པའི་ཉེས་པ་སོ་ན་གནས་ལ།",
    "སྣང་དུ་ཟིན་ཀྱང་དོན་དམ་པར་མེད་པའི་དོན་ཡིན་པས།",
    "ཤེས་པ་གསལ་བར་ཡང་རིག་པར་བྱ་བ་དང་།",
    "རིག་པར་བྱེད་པ་གཉིས་མེད་ཀྱང་།",
    "རིག་བྱེད་གཞན་ལ་མི་ལྟོས་པར་རིག་པའི་རང་བཞིན་ཡིན་པའི་ཚུལ་གྱིས་རང་རིག་པ་ཡིན་པའི་ཕྱིར།",
    "ཡུལ་སྒྱུ་མ་ཙམ་མེད་དུ་ཟིན་ཀྱང་ཤེས་པ་དོན་དམ་པར་ཡོད་པ་འགལ་བ་མེད་དོ་ཞེ་ན།",
    "དེ་མི་འཐད་པར་སྒྲུབ་པའི་ཕྱིར།",
    "དེ་ལྟར་རང་རིག་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རང་རིག་པར་བྱེད་ཅེས་བྱ་བ་མི་འཐད་དུ་ཟིན་ཀྱང་།",
    "རྐྱེན་གཞན་གྱི་སྟོབས་ཀྱིས་ཀྱང་ཤེས་པ་དེ་རང་རིག་པར་བྱེད་པ་ཉིད་དུ་མི་འཐད་དོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཁས་ལེན་པར་རིགས་ན།",
    "རང་བཞིན་མེད་པར་ཁས་ལེན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "རྣལ་འབྱོར་པ་ཆེན་པོ་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་གྱི་བར་དུ་སྟོང་པ་ཉིད་ལ་གོམས་པར་བྱས་པས་ནི།",
    "ཡིད་བཞིན་ནོར་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེས་མི་བྱ་ཀ་ལ་གཏད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ད་ནི་གང་འཇིགས་པར་འགྱུར་བའི་བདག་ཅེས་བྱ་བ་མ་གྲུབ་པས།",
    "ད་ནི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་བདག་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "ད་ནི་ཡིད་བདག་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "ཡིད་ཀྱི་མཚན་ཉིད་ཉམས་པར་འགྱུར་བའམ།",
    "ད་ནི་མ་འོངས་པའི་སེམས་བདག་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "ད་ནི་དེ་ལྟར་བའི་སེམས་བདག་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "གལ་ཏེ་ཡིན་ན་དེ་བདག་ཏུ་འཛིན་པའི་སེམས་ཡིན་པར་མི་རུང་སྟེ།",
    "དཔེར་ན་བུམ་པ་ཡིན་ན་བུམ་པ་ལ་འཛིན་པའི་སེམས་ཡིན་པར་མི་རུང་བ་བཞིན་ནམ།",
    "བུམ་པ་ལ་འཛིན་པའི་སེམས་ཡིན་ན་བུམ་པ་ཡིན་པར་མི་རུང་བ་བཞིན་ནོ།",
    "ད་ནི་འདས་པའི་སེམས་བདག་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "གལ་ཏེ་ཡིན་ན་ནི་འདས་པའི་སེམས་བཞིན་དུ་བདག་ཀྱང་འགགས་ནས་མེད་པར་འགྱུར་བའམ།",
    "དེ་གཉིས་ཀྱི་སོ་སོའི་མཚན་ཉིད་ཉམས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་བདག་མ་ཡིན་པར་བསྟན་ནས།",
    "ད་ནི་ཁམས་བཅོ་བརྒྱད་བདག་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "འདུ་ཤེས་དང་མཚུངས་པར་ལྡན་པའི་འདུ་བྱེད་ཀྱི་ཕུང་པོ་སྟེ།",
    "དངོས་སུ་སེམས་ལས་བྱུང་བ་རྣམས་བདག་མ་ཡིན་པར་བསྟན་པ་པའི་ཕྱིར།",
    "བདག་ཉིད་ཡིན་པར་མི་འཐད་དོ་ཞེས་བསྟན་པའི་དོན་དུ་སེམས་འདི་ཉིད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།"
  ]
}