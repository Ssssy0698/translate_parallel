    "༩༢བསྡུར་འབྲས་རེའུ་མིག་༡༡༣༤༦༢ རིགས་པའི་ཐིགས་པའི་རྒྱ་ཆེར་འགྲེལ་པ།་",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་ལེའུ།་",
    "༢༧༧བསྡུར་འབྲས་རེའུ་མིག་༢༧༩༣༤༦༤ རིགས་པའི་ཐིགས་པའི་དོན་བསྡུས་པ།་",
    "རྒ་༨བསྡུར་འབྲས་རེའུ་མིག་༥༤༣༤༦༦ གཏན",
    "རེ་ཤརགྲེའབ་པ།་",
    "༨༥༩བསྡུར་འབྲས་རེའུ་མིག་༨༨༦རྩེ་མོ།་",
    "རིགས་ཐིགས་ཚིག་རེ་ནས་ནི་རྣམ་པར་དབྱེ།",
    "འདི་ལྟར་རབ་ཏུ་བྱེད་པ་འདི་ཐོས་པ་ལས་ཡང་དག་པའི་ཤེས་པའི་རང་གི་ངོ་བོ་མ་ནོར་བར་ཤེས་པར་འགྱུར་བས།",
    "བྱ་བ་ནི་འབྲས་བུ་ཡིན་པས་དེའི་ཕྱིར་ཡང་དག་པའི་ཤེས་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་འདི་ཙམ་མོ་ཞེས་བྱ་བར་གནས་སོ།",
    "དེའི་ཕྱིར་དེ་ནི་བྱ་རོག་གི་སོ་བརྟག་པ་བཞིན་དུ་གནས་པ་མ་ཡིན་པར་ཁྱོད་ཡོངས་སུ་ངལ་བར་འགྱུར་རོ་ཞེས་འདྲི་བར་འགྱུར་བ་དེའི་ཕྱིར་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པ་ནི་ཡང་དག་པར་ཤེས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་ཞེས་པ་འདི་སྨོས་ཏེ་དེས་ནི་དགོས་པའི་ཡང་དགོས་པ་བསྟན་ཏོ།",
    "དེ་བས་ན་ཚིག་གི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ཡང་དག་པའི་ཤེས་པ་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པ་ལས་རྗོམཁོ་བར་གྱུར་པ་ལས་དེའི་ཕྱིར་བསྒྲིམས་ཏེ་དེ་ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "དེ་ནི་རེ་ཞིག་བསྡུ་བའི་དོན་ཡིན་ནོ།",
    "ཡན་ལག་གི་དོན་ནི་ཡང་དག་པའི་ཤེས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པས་ན་ཞེས་བྱ་བ་ལ་འདིར་མི་སླུ་བའི་ཤེས་པ་ནི་ཡང་དག་པར་ཤེས་པ་སྟེ།",
    "སྔོན་གྱི་སྒྲས་ནི་འདི་རྒྱུ་ཡིན་པར་བརྗོད་དེ་གང་གི་ཕྱིར་འབྲས་བུ་བས་རྒྱུ་སྔ་བ་དེའི་ཕྱིར་དེ་སྔོན་དུ་ཞེས་བརྗོད་དེ་ཡང་དག་པའི་ཤེས་པའི་རྒྱུ་ཅན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེས་ན་འདི་སྐད་དུ་གང་གི་ཕྱིར་ཡང་དག་པའི་ཤེས་པ་ནི་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པའི་སྔོན་མེདུ་བཏང་བ་ཅན་ཡིན་པ་དེའི་ཕྱིར་དེ་བསྟན་ཏོ་ཞེས་བྱ་བར་བསྟན་པར་འགྱུར་རོ།",
    "མ་ནིང་གི་རྟགས་ཀྱིས་བསྟན་པ་དང་གཙོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ་དང་།",
    "དེ་ལ་གྲངས་ལ་ལོག་པར་རྟོག་པ་ནི་ཁ་ཅིག་གི་ནི་གཅིག་སྟེ།",
    "ཁ་ཅིག་གི་ནི་གསུམ་སྟེ།",
    "རང་གི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ་ནི་འདི་ལྟ་སྟེརྐ།",
    "ཁ་ཅིག་གིས་ནི་མངོན་སུམ་གྱི་ཡུལ་ནི་རང་གི་མཚན་ཉིད་ཁོ་ནའོ།",
    "གཞན་དག་གིས་གཞན་དུ་བརྗོད་པ་ལྟ་བུའོ།",
    "དེ་ལྟ་བས་ན་དེ་ལྟ་བུའི་ལོག་པར་རྟོག་པ་རྣམ་པ་བཞི་བསལ་བས་རྣམ་པ་ཐམས་ཅད་དུ་མ་ནོར་བར་ཡང་དག་པའི་ཤེས་པའི་རང་གི་ངོ་བོ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལ་རེ་ཞིག་དང་པོ་ཁོ་ནར་གྲངས་ལ་ལོག་པར་རྟོག་པ་བསལ་བའི་ཕྱིར།",
    "རྣམ་པ་གཉིས་པོ་གང་གིས་ཡིན་པ་ནི་སྒེམི་ཤེས་པས་དེའི་ཕྱིར་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པའོ་ཞེས་བྱེ་བྲག་གིས་བསྟན་ཏོ།",
    "རང་གི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ་བསལ་བར་བྱ་བའི་ཕྱིར།",
    "དེ་ནི་རེ་ཞིག་བསྡུས་པའི་དོན་ཡིན་ནོ།",
    "ཡན་ལག་གི་དོན་ནི་རྟོག་པ་རྣམས་དང་བྲལ་བ་ནི་རྟོག་པ་དང་བྲལ་བ་སྟེ།",
    "སྨྲས་པ་མ་འཁྲུལ་བ་སྨོས་པ་ནི་རེ་ཞིག་རབ་རིབ་ཅན་གྱི་ཤེས་པ་འཁྲུལ་པ་རྣམ་པར་གཅད་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་གོ་རྗེས་སུ་དཔག་པ་ཡང་མངོན་སུམ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དོན་གྱི་བྱེ་བྲག་རང་གི་ངོ་བོའི་མཚན་ཉིད་ཀྱི་ངོ་བོ་ནི་བརྗོད་པར་མི་ནུས་ཏེ་དེ་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲའི་བྱེ་བྲག་གིས་ནི་མི་ནུས་ཏེ་དེ་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འཁྲུལ་པ་ལ་སོགས་པས་འཁྲུལ་པ་མ་བསྐྱེད་པ་ཞེས་བྱ་བ་ལ་རབ་རིབ་ཅེས་བྱ་བ་ནི་མིག་གི་གནོད་པའོ།",
    "འཁྲུལ་པ་དག་གིས་འཁྲུལ་པ་མི་སྐྱེད་༡་པ་ནི་རབ་རིབ་དང་།",
    "རྟ་རྒོད་མ་ཁྲིད་དེ་མི་འོང་གི་བ་དྲུས་མ་ཁྲིད་དེ་འོང་བས་འདི་ལྟར་དེ་ཉིད་བེའུ་དང་འབྲེལ་བར་མཐོང་བ་དེ་བཞིན་དུ།",
    "འདིར་ཡང་རྟོག་པ་དང་འཁྲུལ་པ་ནི་ཤེས་པ་ཁོ་ན་དང་འབྲེལ་པར་མཐོང་གི་གཞན་དག་ནི་མ་ཡིན་པས་ཤེས་པ་ཁོ་ན་མངོན་སུམ་དུ་འདོད་དོ།",
    "རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་ནི་དེར་རང་གི་ཡང་ཡིན་ལ་ཡུལ་ཡང་ཡིན་པས་རང་གི་ཡུལ་ཏེ།",
    "བདག་གི་དམིགས་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རང་ཡུལ་གྱི་དེ་མ་ཐག་པ་ནི་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་སྟེ།",
    "དེ་ནི་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་ཡང་ཡིན་ལ་ཡུལ་ཡང་ཡིན་པས་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་ཡུལ་ལོ།",
    "འདིར་རང་གི་ཡུལ་བྱི་དེ་མ་ཐག་པ་ཡུལ་ཞེས་བྱ་བའི་སྒྲས་ནི་གཟུང་བ་དང་འཛིན་པའི་ཕྱིར་རྟོག་དྷིཔར་བྱེད་པ་མ་ཡིན་པའི་སྐྱོན་དང་།",
    "དེ་བས་ན་གཟུང་བ་དང་འཛིན་པ་མེད་པར་ཐལ་བའི་ཉེས་པ་ཡང་ཡོངས་སུ་རྗོལྟ་ག་ལ་འགྱུར་རོཛེེ།",
    "གང་གི་ཚེ་དེ་མ་ཐག་པའི་སྒྲ་རིགས་མཐུན་པ་ལ་ཡང་བྱ་བ་དེའི་ཚེ་རིགས་མི་མཐུན་པའི་ཡུལ་ལ་འཛིན་པར་ཡང་ཐལ་བར་ག་ལ་འགྱུར།",
