    "དེ་ནས་ཡོད་ཚད་གློར་བཏང་ཚར་བ་དང་ངེད་གཉིས་སྤོག་ར་ནས་ཀ་ཋ་མན་ཌུ་བར་གནམ་གྲུ་ནང་འོང་པས་གླ་ཆ་ལས་ལག་འཁྱེར་སོགས་གང་ཡང་དགོས་ཀྱི་མི་འདུག།",
    "དེ་བཞིན་ཤིང་རྩ་རིགས་ལོ་གཅིག་ཙམ་ཟ་དགོས་བྱུང་འདུག།",
    "ན་༨མ་༤༧ཐུབ་ན་བསམ་པ་འདུག།",
    "ཨ་འབྲུག་མགོན་པོ་བཀྲ་ཤིས་མཆོག་ནས་དེ་འདྲ་ཚུགས་ཐུབ་པ་ཡིན་ན་གལ་ཆེན་པོ་ཞེ་དྲག་འདུག།",
    "བླངས་ཟིན་པའི་མིང་ཐོ་རྣམས་སྤྱན་འབུལ་ཞུས་པས་ཡག་པོ་བྱུང་འདུག་གསུངས།",
    "དེར་ཡོད་མི་རྣམས་སོ་སོའི་ལམ་དུ་གཏོང་ན་མ་འགྲིག་སྟབས་འཇའ་ན་པུར་ལ་འོང་རྒྱུ་བྱས་པས་ཕྲན་དེར་སླེབས་པ་དང་ཚང་མ་དེར་སླེབས་ནས་བསྒྲུགས་འདུག་པས་ལམ་གྲོན་བགོ་སྤྲོད་བྱས་ཏེ་འགྲོ་ཡུལ་ལ་བཏང་ནས།",
    "ཕྲན་དམག་སྒར་ནང་སླེབས་དུས་དམག་མི་དྲུག་སྟོང་ཙམ་སླེབས་ཚར་འདུག།",
    "སྔོན་འགྲོའི་མགོ་འཛིན་གསུམ་ནས་བཞི་བར་དགོས་ཀྱི་འདུག་ན་སུ་དང་སུ་འགྲོ་རྒྱུ་ཡིན།",
    "སུ་དང་སུ་གཏོང་དགོས་མིན་དེ་རིང་གྲོས་བསྡུར་བྱས་ནས་གཏོང་རྒྱུ་ཐག་གཅོད་འཕྲལ་དུ་བྱེད་དགོས་ཀྱི་འདུག་མ་གཏོགས།",
    "དེར་བརྟེན་ཕྲན་མགོ་བྱེད་དུ་འགྲོ་ཐུབ་པ་མི་འདུག་ཞུ་རྐྱེན་དེ་འདྲ་ཡིན།",
    "ཨུ་བན་ནས་དེ་གལ་ཆེན་པོ་མི་འདུག།",
    "སྤྱིར་བཏང་ང་རང་དམག་སྒར་འདིར་སྡོད་མཁན་ཡིན།",
    "དམག་མི་ནང་སྐྲ་མ་བཞག་ན་མི་འགྲིག་བ་ཞིག་འདུག་ཞུས་པ་དང་།",
    "རྒྱ་གར་གྱི་དམག་མི་རྣམས་སྐུ་མེད་པའི་མགོ་རིལ་མང་པོ་འདུག་ག།",
    "སྐབས་དེར་ཁོང་གཤག་བཅོས་ཀྱི་རྨ་ཁ་དྲག་སྐྱེད་གཙང་མ་མ་བྱུང་བ་མ་ཚད་གཟུགས་པོ་ཡང་ཡོངས་སུ་སོས་མ་ཐུབ་པར་གསང་སྤྱོད་བཅས་སུ་འཁར་རྒྱུག་དང་མི་གཞན་ལ་བརྟེན་ནས་ཕེབས་བཞུགས་གནང་དགོས་འདུག།",
    "ངེད་གཉིས་དེར་ཉིན་གསུམ་བཞི་ཙམ་སྒུག་བསྡད་བྱས་ཏེ་རྒན་ཡེ་ཤེས་རྩད་གཅོད་བྱས་ཀྱང་རྒན་གར་ཡོད་ཤེས་ཀྱི་མི་འདུག།",
    "དགོངས་འགལ་མེད་པ་ཞུ་ཞེས་གསུངས་འདུག་པས།",
    "གྲོང་བ་ན་བཞིན་འདུག་ཟེར།",
    "རང་དམག་ཡོད་ཚད་རི་མགོ་བསྐོར་ནས་ཕྱོགས་གཅིག་ཏུ་འཁྲིད་དེ་འགྲོ་རྒྱུ་བྱས་ན་བསམ་པའི་ང་ལ་ཡང་བསམ་ཚུལ་འདུག་ཟེར་བས་ངས་དེ་བཞིན་བྱས་ཀྱང་ཁྱད་མེད་བཤད།",
    "དེ་སྔོན་བོད་ནང་རྒྱ་ལ་དམག་རྒྱག་དུས་རྟ་དམག་ཁོ་ན་ཡིན་སྟབས་དཀའ་ངལ་དེའི་བརྒྱ་ཆ་སུམ་ཅུ་ཙམ་ཡང་མ་བྱུང་།",
    "ཨ་དམག་གཅིག་ཤོར་བ་ལས་ཕར་དགྲ་བོ་དམག་མི་འགའ་ཤས་བསད་པས་ལྷག་མ་ཕྱིར་བྲོས་བྱས་འདུག།",
    "དེ་མིན་གོ་ལག་གང་ཡང་བཞག་མི་འདུག།",
    "དེ་མིན་ད་དུང་མང་པོ་ཞིག་ནས་བསྟོད་བསྔགས་ཉིན་ལྟར་སླེབས་ཀྱིན་འདུག།",
    "ཚེས་༡༤ ཉིན་ནས་དེ་ཕྱོགས་ཀྱི་དགྲ་བོའི་དམག་སྒར་ཁག་དེ་དག་རིམ་བཞིན་གཏོར་བར་བཏང་བས་ཉིན་བཞིན་ས་ལེན་ཐུབ་ཀྱིན་འདུག།",
    "སྐྲ་དང་མིག་བཅས་བོད་རིགས་དང་འདྲ་པོ་ཞིག་འདུག།",
    "ནོར་འཁྲུལ་དེ་དག་མུཀ་ཏི་ཕོ་ཇི་བ་ཚོ་ཡིན་འདུག།",
    "༢ སྐབས་སུ་ཨུ་ཚུགས་བྱས་ཏེ་གླེན་དེད་ཤུགས་ཆེར་བྱས་རྐྱེན་སྟབས་མ་ལེགས་པར་བརྒྱ་ཤོག་བཅོ་ལྔ་པ་གཅིག་པུའི་ལྡིང་དཔོན་གསུམ་དང་དམག་མི་བཅས་༢ཙམ་ཉིན་གཅིག་དང་དུས་གཅིག་ས་གནས་གཅིག་ལ་ཤོར་འདུག་པ་མ་ཚད་རྨས་མ་ཡང་མང་པོ་ཞིག་བཟོས་འདུག།",
    "ཡིན་ན་ཡང་དེ་མ་ཐག་འདས་གྲོངས་ཕྱིན་མི་འདུག་དེར་བརྟེན་སྤྱི་ཁྱབ་དམག་སྤྱི་ཁང་ལ་ཏར་འཕྲིན་བཏང་ནས་གནམ་གྲུ་ལེན་པར་འོང་དགོས་པར་མངགས་ཆ་བྱས་འདུག།",
    "དགྲ་བོས་ཡ་ལན་སློག་མཁན་ཡང་མི་འདུག།",
    "ངས་མཐོང་བ་ལ་གནམ་གྲུ་ཆེ་ཆུང་གཉིས་དང་ཆུ་གྲུ་གཉིས་བཅས་གཏོར་འདུག།",
    "ཇ་ཁང་བཅས་ཀྱིས་སྣེ་ལེན་བྱེད་མཁན་གྱིས་ཇ་དང་ལ་སྒྲ་འམ་མངར་ཟས་བཅས་ཁྱེར་ནས་དགའ་བའི་འཛུམས་མདངས་དང་བཅས་ཏེ་བསུ་མ་བྱེད་མཁན་གྱིས་འཚང་ཁ་བྱེད་བཞིན་འདུག།",
    "ཅེས་གསུངས་འདུག།",
    "དེའི་འགན་སུ་ཡིས་འཁུར་རྒྱུ་ཡིན་ཞེས་དྲི་བ་ཆ་ཚང་བྱེད་ཀྱི་འདུག།",
    "བྱམས་པ་སྐལ་ལྡན་ལགས་རི་ཧེ་འབེ་ལི་ཀྲེ་ཤན་གཞིས་ཆགས་ཀྱི་ལྟ་རྟོག་བྱེད་མཁན་དུ་བསྐོ་བཞག་བྱས་ཡོད་པས་གང་འདྲ་འདུག་ཅེས་གསུངས་པས།",
    "སྐུ་ཞབས་བྱམས་པ་སྐལ་ལྡན་ལགས་ལྡི་ལིར་ནས་ཡར་འབྱོར་འདུག་ཟེར་བ་གོ་བ་དང་།",
    "ཕྲན་རང་ནས་བྱམས་པ་ཁྱེད་རང་བློ་སེམས་མི་བདེ་བ་ཞིག་ཆགས་འདུག།",
    "ཁོང་ནི་གདོང་གཤིས་འགྱུར་ནས་ཁོང་ཁྲོའི་རྣམ་པ་ཆེ་རུ་བཏང་བ་མ་གཏོགས་ངའི་སྐད་ཆ་ཚིག་གཅིག་ཀྱང་ཉན་འཇོག་བྱེད་ཀྱི་མི་འདུག།",
    "ཁྱེད་རང་བསམ་བློ་ཡག་པོ་གཏོང་རོགས།",
    "བྱམས་པས་དེ་ཡག་པོ་འདུག་གསུངས་ནས་གུས་གཉིས་བསམ་ཚུལ་མཐུན་པ་འདྲ་པོ་བྱུང་སྟེ་དེ་ག་རང་ཞུ་རྒྱུ་བྱས་པ་ཡིན།",
    "ཁྱེད་རང་ཕར་འགྲོ་ཤོག།",
    "ལྷག་ཙ་ན་མ།",
    "སྐབས་དེར་དམག་སྒར་ནས་འོང་དུས་ངེད་གཉིས་ཀའི་གསོག་དངུལ་ལེན་རྒྱུ་བསྡོམས་པས་ཧིན་སྒོར་ཆིག་ཁྲི་དགུ་སྟོང་ཐམ་པ་ཏག་ཏག་ལས་མི་འདུག།",
    "ད་དུང་ཁྱེད་རང་དྷ་རམ་ས་ལར་ལས་བྱེད་བྱས་པ་ཡིན་ན།",
    "དེས་ཡི་གེ་བསྐུར་འདུག།",
    "ཞབས་ཕྱི་དེ་ཚོས་གསལ་པོ་གསལ་རྐྱང་ཤེས་ཀྱི་འདུག་ག་ཟེར་ནས།",
    "དགོང་དྲོའི་ཁ་ལག་བཅས་དཔེ་མི་སྲིད་པའི་གྲ་སྒྲིག་ཡག་པོ་བྱས་འདུག།",
    "གཡག་རྔན་ལ་སླེབས་དུས་དེར་ཇ་བཟོ་གྲྭ་རིགས་མང་པོ་འདུག་པ་ཁག་ལ་ལྟ་སྐོར་དུ་འཁྲིད་བྱུང་།",
    "ཉག་ཆུ་ཁར་སླེབས་དུས་ཉིན་གུང་ཁ་ལག་གྲ་སྒྲིག་བྱས་འདུག་པར་དེ་ལྷོད་བསྡད་བྱས་ནས་འོང་།",
    "དེ་ནས་ཐང་དཀར་ལ་སླེབས་དུས་ཡང་ཇ་དང་ཞལ་ཏོག་གྲ་སྒྲིག་བྱས་འདུག་པ་དེ་ཟོས་ནས་ལི་ཐང་ལ་དགོང་དྲོའི་ཆུ་ཚོད་ལྔ་དང་ཕྱེད་ཀ་ཙམ་ལ་འབྱོར།",
    "དེ་རྗེས་ཉིན་ལྔ་དྲུག་མཚམས་ཞིག་ལ་ཉེན་རྟོག་པའི་དཔོན་པོ་གཉིས་ངེད་གཉིས་སར་འོང་ནས་ཁྱེད་གཉིས་ལ་སྐུ་སྲུང་དགོས་ཀྱི་མེད་གསུངས་འདུག་སྟབས།",
    "དེ་ནས་བཟུང་ངེད་གཉིས་ལ་སྐུ་སྲུང་བ་མ་བྱུང་བས་འགྲོ་འདུག་ཨ་རྩ་མ་བ་མ།",
    "དེར་དབྲ་ཡུལ་འབྲོག་གསུམ་གྱི་རྟ་པ་བརྒྱ་ལྷག་ཙམ་གྱིས་སྐྱ་བསུ་དང་བསང་དུད་ནམ་མཁའ་གང་བའི་བསུ་མ་བྱེད་མཁན་གྲ་རྒྱས་ཕུན་སུམ་ཚོགས་པའི་གྲ་སྒྲིག་བྱས་ཏེ་བསྒུགས་འདུག།",
    "དེར་ཇ་ཆང་འོ་ཞོ་དང་ཞལ་ཏོག་སོགས་གྲ་སྒྲིག་རྒྱས་པོ་བྱས་འདུག།",
    "དེ་སྐབས་ལུང་པའི་ནང་ཆར་ཆུ་མ་བཏང་རྐྱེན་ཞིང་ཁར་ལོ་ཏོག་བཏབ་པ་རྣམས་སྐྱེས་མ་ཐུབ་པར་ཡུལ་མི་རྣམས་སེམས་ཁྲལ་ཆེན་པོའི་ངང་བསྡད་འདུག།",
    "དེ་ཚོས་རྒྱ་ཡིག་ཕྲན་བུ་ཤེས་པ་ལས་བོད་ཡིག་ནི་ཚིག་གཅིག་ཤེས་ཀྱི་མི་འདུག།",
    "ངའི་བུ་གཅིག་པུ་དེ་མ་གཏོགས་བལྟ་ས་གཞན་མི་འདུག་ཟེར།",
    "ཞོ་འོ་མ་སོགས་ཟས་རིགས་ཡོད་ཚད་འབེལ་འབེལ་ལྷུག་ལྷུག་གྲ་སྒྲིག་བྱས་འདུག་པས་དེར་ཉིན་གྲངས་བཅུ་གསུམ་ཙམ་བསྡད།",
    "རྩེད་རིགས་ནི་རྟ་རྩལ་འགྲན་བསྡུར་བྱེད་མཁན་རྟ་སྟོང་ཕྲག་བརྒལ་བ་འདུག།",
    "བལྟ་ན་མཛེས་པ་གང་ལེགས་འདུག་པ་མ་ཟད།",
    "རྩེ་དགོན་ལ་སྔོན་མ་འདྲ་པོ་བཟོས་འདུག།",
    "དེ་མིན་མགོ་ལོག་ཨོ་ཐོག་བཅས་ནང་འོང་སར་ཤིང་ནགས་གཅིག་ཀྱང་མ་ལུས་པ་བཅད་ཚར་འདུག།",
    "གློག་ཁང་རྒྱག་ཐུབ་ཀྱི་མི་འདུག།",
    "ལམ་འགག་བཟོ་ཐུབ་ཀྱི་མི་འདུག།",
    "ཁྱེད་རང་ཐུགས་ཁྲལ་གནང་མི་དགོས།",
    "ཕྲན་ལ་ཁྱེད་རང་རྒྱ་གར་ནས་༧གོང་ས་མཆོག་ཕེབས་གྲ་བསྒྲིགས་སྟངས་ཀྱི་མཐོང་མྱོང་མང་པོ་ཡོད་པས་མ་ཚད།",
    "ཁྲིན་ཏུར་ཉིན་ཤས་མགྲོན་ཁང་ཆེ་ཤོས་ཤིག་ནང་གྲ་སྒྲིག་བྱས་འདུག་པ་དེར་བསྡད་རྗེས་གནམ་ཐོག་ནས་པེ་ཅིང་དུ་འབྱོར།",
    "རིའི་ནང་ལ་འགྲོ་ལམ་ཟམ་པ་དང་གློག་བཅས་ཀྱི་གྲ་སྒྲིག་འདུག།",
    "སྒྲོལ་མའི་སྐུ་མིན་ནམ་བསམ་པ་ཆག་སྐྱོན་བྱས་པ་ཞིག་མཇལ་རྒྱུ་འདུག།",
    "ཨམདུན་དུ་མཚོ་ཆུང་ཆུང་དེ་འདྲ་འདུག།",
    "ཟ་ཁང་ཡང་མང་པོ་འདུག།",
    "མཆོད་གཤམ་དཀྱིལ་དུ་༧རྒྱལ་བ་ཡིད་བཞིན་ནོར་བུའི་སྐུ་པར་ཆུང་ཆུང་ཞིག་གཤམ་འདུག།",
    "བོད་རིགས་བླ་གྲྭ་བཅས་འདྲ་མིན་འདུག།",
    "ཇི་སོགས་མཇལ་ཁ་ཐོབ་མཁན་ཁག་ཅིག་བྱུང་འདུག།",
    "ངས་ཁས་ལེན་བྱས་པའི་མི་གོ་མ་ཆོད་པ་ཞིག་ཆགས་ཀྱིན་འདུག་བསམ་ནས་མཇལ་ཁ་རག་ཐབས་ཨུ་ཚུགས་ཀྱིས་ཐེངས་ཁ་ཤས་བཅར་ནས་ཞུས་ཀྱང་བསྒུགས་ཀྱང་མཇལ་ཁ་རག་མིན་མ་ངེས་པ་ཞིག་ཇེ་གསལ་ཆགས་བསྡད་ཀྱིན་འདུག།",
    "སྐབས་དེར་༧སྐུ་མདུན་གྱིས་ཕྲན་བོད་ནས་དྷ་སར་འབྱོར་ནས་མཇལ་ཁ་བཀག་པ་མཁྱེན་ནས་ཕྲན་འོང་དགོས་པ་བཀའ་ཕེབས་འདུག།",
    "ཀྲུང་གོའི་གཞུང་ལ་ཁྱེད་རང་དགའ་པོ་ཡོད་མེད་དང་།",
    "སྐབས་དེར་ཕྲན་བལ་ཡུལ་ནས་ལྷ་ས་སླེབས་པ་དང་དུས་ཚོད་ཏག་ཏག་འཁེལ་འདུག།",
    "མཆན་བུའོ་གནས་ཚུལ་དེ་ཚོ་གོ་དུས་སེམས་པ་དགའ་པོ་འདུག།",
    "བདེ་སྲུང་དྲུང་ཆེ་བྱམས་པ་སྐལ་ལྡན་གྱིས་ཁྱེད་རང་གཉིས་བོད་དུ་འགྲོ་དུས་བསད་གྲབས་བྱས་འདུག་ཟེར།",
    "དེ་ལ་ཁྱེད་ཀྱིས་རོགས་པ་བྱེད་དགོས་ཞེས་པ་ཞིག་བཏང་བ་ལས་གཞན་གང་ཡང་མི་འདུག་ཟེར།",
    "ཡི་གེ་ད་ལྟ་ཁྱེད་རང་ལག་ཏུ་ཡོད་དམ་དྲིས་པས།",
    "དེ་རྗེས་ཐུག་དུས་ཡི་གེ་འཁྱེར་ཡོད་དམ་དྲིས་པས་ངའི་ཡི་གེ་དེ་བལ་ཡུལ་དོན་གཅོད་ལ་སྤྲད་པས་བལ་ཡུལ་དོན་གཅོད་ཀྱིས་ལྡི་ལིའི་དོན་གཅོད་ལ་མར་བཏང་ཟིན་འདུག་ཟེར་བས།",
    "བཅོ་ལྔ་ཚེ་རིང་བཅས་ཀྱང་འདུག།",
    "དེ་དུས་ཨ་ཐར་གྱིས་རྒྱུན་ལས་འདེམས་སྟངས་དང་ཕུ་པ་དཔོན་དྷ་སར་བསྡད་མཁན་ཡིན་པའི་འཆར་གཞི་རྣམས་བཀའ་བློན་འཇུ་ཆེན་ཐུབ་བསྟན་ལགས་ལ་ཁ་པར་བརྒྱུད་དེ་ཞུས་འདུག་པ་དང་།",
    "སྐབས་དེར་ཨ་ཐར་གྱིས་དེ་མ་ཐག་རྡོར་གླིང་ལ་ཁ་པར་བཏང་འདུག་ཀྱང་ཕུ་པ་དཔོན་ཕྱིར་ཐོན་ཟིན་པ་དང་ཐུག་འདུག།",
    "གྲའུར་དཔོན་གྱིས་ཚིག་ཁ་བསྒྱུར་ནས་བོད་ནང་ལ་ལས་འགུལ་སྤེལ་རྒྱུ་ཞིག་གྲ་སྒྲིག་བྱེད་དགོས་པ་འདུག།",
    "ངས་བོད་ནང་ལས་འགུལ་སྤེལ་ཐུབ་ན་ཡག་པོ་འདུག།",
    "དེ་རྗེས་ཤིག་ལ་ཨ་ལགས་འཇིགས་མེད་ལྡི་ལིར་བོད་ཀྱི་དོན་གཅོད་ཁང་ནང་སླེབས་པ་ཞིག་ལ་ཨ་ཐར་དང་ཐུག་འདུག་པ་དང་།",
    "དེ་རྗེས་བརྟག་དུས་ཕུ་པ་དཔོན་ཡིག་ཚང་དུ་ཡོད་པ་དང་ང་ཡང་དེར་སླེབས་ཀྱིན་ཡོད་སྟབས་དེར་འཛོམས་མ་བདེ་པ་ཡིན་པ་འདྲ།",
    "སུ་འདུག་དྲིས་པས།",
    "ནག་ཁུང་རྡོ་རྗེ་བལ་ཡུལ་ནས་ག་དུས་སླེབས་པ་ཡིན་ནམ་དྲིས་པས།",
    "ཡག་རྒྱུ་ཞིག་མི་འདུག་ཟེར།",
    "དེ་རྗེས་བརྟག་དཔྱད་བྱས་བསྡད་པས་ལྐོག་ལྐོག་ཟུར་ཟུར་མང་པོ་ཞིག་འདུ་འཛོམས་ཐེངས་མང་བྱས་འདུག་པ་གོ་རྒྱུ་འདུག།",
    "ཞུ་ཡུལ་དང་བཅར་ཡུལ་ཡོད་ཚད་ཐུགས་དགྱེས་ཚོར་གྱིས་རྒྱབ་སྐྱོར་མི་གནང་བ་སུ་ཡང་མི་འདུག།",
    "རྡོ་རྗེས་འགན་ཁུར་པའི་གྲས་སུ་མ་འཇོག་རོགས་ཟེར་ནས་འགན་ལེན་བྱེད་ཀྱི་མི་འདུག།",
    "དེ་མེད་པ་བཟོ་རྒྱུ་ཐབས་ཤེས་ཤིག་བྱེད་དགོས་ཀྱི་འདུག་ཟེར།",
    "ཨ་འབྲུག་སྦྱིན་བདག་ཡོད་པའི་སྐབས་ཁྱེད་ཀྱིས་གཞིས་ཆགས་བཙུགས་འདུག་ག།",
    "ལྷོ་གཞིས་ཁག་ལྔ་དང་རང་བདེན་ཚོགས་ཆུང་།",
    "ང་རང་སྒེར་བཅས་ནས།",
    "དེ་མིན་ང་རང་ལ་ཡོན་ཏན་མེད་དུས་ཡོན་ཏན་ཟེར་བ་གང་ཞིག་ཡིན་མིན་ངོས་ཟིན་གྱི་མི་འདུག།",
    "ཕན་ཚུན་འབྲེལ་མཐུད་ཀྱི་སྐུ་ངལ་ཡོང་ངེས་ཀྱི་བསམ་ཚུལ་འདུག་པ་དང་།",
    "ཞེས་པའི་རྡོ་ཐར་གྱིས་དེབ་ཅིག་བཏོན་འདུག་པ་དེ།",
    "གལ་སྲིད་མགོན་པོ་རི་ནས་ཁྱེད་རང་རྩེད་ཐང་ལ་ཕྱིར་ལོག་འོང་ཡོད་མེད་མི་ཤེས།",
    "ད་དུང་ཤོག་གྲངས་༡༡༤ ནང་སྔོན་རྒྱ་མིའི་ལག་ནས་ཕྲོགས་པའི་གོ་ལག་ཆ་རང་འགྲིག་རྣམས་སྲུང་བྱ་བ་ཞིག་ཀྱང་མ་བཞག་པར་བདག་མེད་དུ་ལུས་འདུག།",
    "ཁྱེད་རང་རྩེད་ཐང་གཏན་ནས་སླེབས་མེད་དུས།",
    "རྩེད་ཐང་རང་དམག་ལ་མེ་སྒྱོགས་གསུམ་མ་གཏོགས་གཏན་ནས་མེད།",
    "རྩེད་ཐང་ལ་ཛམ་བྷས་མེ་སྦྱོགས་ལེན་རྒྱུ་ཞིག་ག་པ་ལྷག་འདུག།",
    "ཅེས་བཀོད་འདུག།",
    "དེ་མ་ཤེས་ན་གཅིག་སྒྲིལ་མེད་པ་དང་ཆོལ་ཁ་ཕྱོགས་ཞེན་གྱིས་ཆུ་སྒང་དམག་དཔུང་འཛུགས་དུས་དབུས་གཙང་མ་བཅུག་པ་མིན་འགྲོ་བསམ་སྲིད།",
    "འགའ་ཤས་ཀྱིས་དབུས་གཙང་མི་ལ་བློ་ཁོག་མེད་ནས་འོང་མ་ཕོད་པ་མིན་འགྲོ་འམ་བསམ་སྲིད།",
    "སྤྱི་ཟླ་༣ ཚེས་༢༢ དང་བོད་ཟླ་༢ ཚེས་༡༣ ཉིན་འཕྱོངས་རྒྱས་ནས་ཕྱིར་ལོག་བྱས་ཏེ་རྩེད་ཐང་རང་དམག་ཡོད་སར་འོང་ནས།",
    "སྐབས་དེར་ས་བགོས་རྒྱག་དུས་རྩེད་ཐང་ལ་དམག་རྒྱག་མཁན་དམག་སྤྱི་དགུ་ནི།",
    "ཞེས་པ་ཕྱི་ལོ་༡༩ལོར་པར་སྐྲུན་བྱས་འདུག་པ་དང་།",
    "དེབ་འདི་ནང་མགོ་འཚོས་ལ་མ་འཚོས་པ་མང་དག་ཅིག་བྲིས་འདུག།",
    "ང་རང་རྒྱ་གར་ནང་འགྲོ་ཐུབ་ས་མི་འདུག་ཁྱེད་རྣམས་ཡག་པོ་བྱས་ནས་མར་ཕེབས་རོགས་བཅས་ཡིག་ངག་གཉིས་ཐོག་ནས་རྒན་གྱི་རོགས་པ་དེ་མར་བཏང་ནས་ལན་འབྱོར་བྱུང་།",
    "འདིའི་སྐོར་ལ་ང་རང་བསམ་ཚུལ་གང་ཡང་མེད།",
    "དེ་རིང་ང་རང་གཉིས་ངོ་ཐུག་བྱུང་བ་དགའ་པོ་བྱུང་།",
    "བྲག་གཡང་ཤུག་གསེབ་ཞིག་ཏུ་ལྷུང་འདུག་པའི་རྐེ་ནས་ཐུང་མདའ་ལེན་ཐུབ་བྱུང་སྐབས་ལག་ཡ་ཤུག་གསེབ་ཏུ་འཁར་འདུག་པར་གསེར་གྱི་མཛུབ་དཀྲིས་ལེན་ཐུབ་ཙམ་བྱུང་འཕྲལ་ཕུང་པོ་རོང་དུ་ཤོར་སྟབས་བྱ་ཐབས་དབེན་ཅིང་ཡར་ཙམ་སླེབས་སྐབས་རིང་མདའ་ཐང་དུ་ལྷུང་འདུག་པ་བཅས་ལག་སོན་ཇི་བྱུང་ལྷ་སར་དོ་བདག་ཁྱིམ་ཚང་དུ་རྩིས་འབུལ་ཞུས་ཡོད་པར་བརྟེན།",
    "ཕྲན་གཉིས་དང་སློབ་འགོ་འཛིན་དུ་བསྐྱོད་ཅིང་རང་ནུས་གང་ཐོན་གྱི་སྲི་ཞུ་བཏོན་འཕེར་ཐུབ་པ་ཞུས་པ་མ་ཟད།",
    "སྐུ་སྒེར་སྐུ་ངོ་བྱམས་ཚུལ་ལགས་སུ་བཀའ་མངགས་ཞུས་ཟེར་བ་ལྟར་བྱམས་ཚུལ་ལགས་སུ་བཅར་སྐབས་ཁྱེད་རང་སྡོད་གནས་ཁ་བྱང་བཞག་ཞོགས་ངས་བཀའ་འཁྲོལ་འཕྲལ་བརྡ་ལན་བཏང་ཡོང་ཞེས་གསུངས་སྟབས་དྷ་སར་ཉིན་ཤས་བཀའ་བསྒྲུགས་ཞུས་རིང་དེར་༧གོང་ས་མཆོག་ལ་དྭགས་ཕྱོགས་སུ་ཆིབས་ཁ་བསྒྱུར་ཏེ་མཇལ་ཕྱག་མ་ཐོབ་སྟབས་ལྡི་ལིར་འབྱོར་བསྡད་སྐབས་གོང་ས་མཆོག་བཞུགས་སྒར་དུ་ཞབས་སོར་འཁོད་རྗེས།",
    "གཞུང་དམངས་བར་བརྩེ་གདུང་ཉམས་བརླགས་འགྲོ་བཞིན་པ་སླར་སོར་ཆུད་ཐབས་བཅོས་བསྒྱུར་གནང་འོས་དགོངས་བཞེས་གནང་གལ་ཆེ་འདུག་པ་བཅས་ཀྱི་གནས་བབ་སེམས་དཀར་གྱི་ཞུ་བ་དང་།",
    "རྐྱེན་མ་འོང་སྔོན་གྱི་བཟློག་པ་བྱེད་དགོས་པ་ང་རང་ལ་ལས་འགན་ཞིག་ཏུ་བརྩིས་སྡོད་ཀྱིན་ཡོད་སྟབས།",
    "དེ་ཚོ་ལ་བལྟས་ན་གསར་དུ་འབྱོར་བའི་གྲྭ་རིགས་དེ་དག་གཞན་གྱིས་བེད་སྤྱོད་བྱས་འདུག་པ་ཞིག་ལས་མ་མངོན།",
    "སྤྱིར་བཏང་ཁྱེད་ཚོས་ལི་ཐང་པ་སྤྱི་ཡི་དོན་དུ་ཤ་ཞེན་གྱིས་སྐད་ཆ་འདྲ་པོ་བྱས་ཏེ་བཀོད་འདུག་ཁྱེད་ཚོ་ལི་ཐང་པ་ལ་ཤ་ཞེན་ཆེན་པོ་ཡོད་ན་སེར་སྨད་སྤོམ་ར་ཁང་ཚན་ནང་ལི་ཐང་པའི་གྲྭ་ཇི་ཙམ་ཡོད་དམ་དྲིས་པས་ག་ཚད་ཡོད་མི་ཤེས་ཟེར།",
    "སྐབས་དེར་སྐུ་མདུན་ལ་བཅར་ཆོག་པ་སྔོན་ཞུས་སྐབས་མདའ་དཔོན་ཟུར་པ་ཡོད་ཚད་འཛོམས་རྒྱུ་ཡིན་པ་སྙན་གསན་ཞུས་ཡོད་འདུག།",
    "སྤྱོད་ཡུལ་མིན་ཡང་རང་གཞན་ལ།",
    "ཁ་ཅིག་ནི་རྫས་སུ་ཡོདཀྱང་རང་རིག།",
    "དེལྟརན་ཡུམ་འདི་ནི་ཉན་ཐོས་དང་རངས་ངས་རྒྱས་རྣམས་བ་སྐྱེད་པས་ག་ང་ཟག་ལ་བདག་མེད་པ་ཙམ་ཞིག་ཡིན་ལ།",
    "ཀ་རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "རང་ཡང་ད་ངོས་བོས་ངེས་ཀྱང་རང་ངེས་པར་བྱེད་པའི་རྟགས་བཟུང་སླ་བ་ཡང་མེད་པའི་ཕྱིར་ཐ་སྐར་གདགས་པའི་གཞིར་མ་གྱུར་པསན་འདི་ཕྱི་ར་མི་ལྡོག་པའོ་ཞེས་གང་ངམ་གསུངས་ཏེ།",
    "དེའི་འདུག་འམ་རྗེས་སུ་དཔག་པས་རབ་ཏུ་གྲུབ་པའི་ཕྱིར་རིའི་བདག་ཉིད་མེར་སྣང་བ་ཞི་མ་ཡི་ནཏེ།",
