    "ཁྱོད་རྫོགས་པར་སྐྱེས་པ་ན་མཐོང་སྤང་རྟོག་པ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་ཉོན་མོངས་པའི་བག་ཆགས་བརྒྱ་རྩ་བརྒྱད་སྤངས་པ་ཡིན་ཏེ།",
    "ཁྱོད་རྫོགས་པར་སྐྱེས་པ་ན་མཐོང་སྤང་གཟུང་འཛིན་གྱི་རྟོག་པ་བརྒྱ་རྩ་བརྒྱད་སྤངས་པས་སོ།",
    "ཡན་ལག་གི་དབྱེ་བ་ཡུལ་གྱི་སྒོ་ནས་སོ་སོར་རྣམ་པ་དགུ་དགུར་ཕྱེ་ལ།",
    "ཉིང་ལག་གི་དབྱེ་བ་འདོད་ཁམས་ན་སོ་དྲུག།",
    "གཟུགས་མེད་ཁམས་ན་སོ་དྲུག་གི་དབྱེ་བས་སོ།",
    "རང་གི་སྤང་བྱ་སྒྲིབ་གཉིས་ཀྱི་འཇིགས་པ་མེད་ཅིང་དེ་རྣམས་འཇོམས་པར་བྱེད་པའི་ཕྱིར།",
    "ཁྱོད་རང་གི་མི་མཐུན་ཕྱོགས་སྤང་བྱ་རྟོག་པ་སྤོང་བ་དང་།",
    "རང་གི་སྤང་བྱ་རྟོག་པ་སྤོང་བ་དང་འབྲས་བུ་ཡོན་ཏན་ནི་རྟེན་ཁྱོད་ཐོབ་པ་སྔོན་དུ་འགྲོ་བ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཁྱོད་དེ་གཉིས་ཀྱི་ཐོག་མར་བསྟན་པས་དེ་གཉིས་གོ་སླ་བས་སོ།",
    "བསམ་གཏན་དང་པོ་ནས་བཟུང་སྟེ་འགོག་པའི་བར་དུ་སོང་ནས།",
    "བྱེ་བྲག་ཏུ་དངོས་གཞི་ཐོད་རྒལ་གྱི་སྙོམས་འཇུག་གི་ཆེད་དུའོ།",
    "འགོག་པའི་བར་དུ་ལུགས་དང་མཐུན་པར་སོང་ནས་སོ།",
    "དངོས་གཞི་ཐོད་རྒལ་ཆུང་ངུ་སྔོན་དུ་བཏང་ནས་དངོས་གཞི་ཐོད་རྒལ་ཆེན་པོའི་སྙོམས་འཇུག་གི་ཆེད་དུ།",
    "ལྔ་དང་དྲུག་དང་བདུན་དང་བརྒྱད་པ་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་སྙོམས་འཇུག་གི་བར་བོར་ནས།",
    "རྒྱུན་གཅིག་གིས་འགོག་པ་ནས་འགོག་པ་ལ་མི་འཇུག་པས།",
    "དེ་བཞིན་དུ་སོགས་པ་གཉིས་དང་གསུམ་དང་བཞི་དང་ལྔ་དང་དྲུག་དང་བདུན་དང་བརྒྱད་པ་སྲིད་རྩེ་བོར་ནས་འགོག་པའི་སྙོམས་འཇུག་ལ་ཐུག་གི་བར་དུ་ཞུགས།",
    "ཉན་ཐོས་པ་ཁ་ཅིག་ན་རེ།",
    "གཅིག་བརྒལ་ནི་རེ་རེ་བོར་ནས་སོ།",
    "སོང་ཞིང་ནི་ལུགས་དང་མཐུན་པའོ།",
    "སྲིད་རྩེ་དོར་བའི་ཟག་བཅས་བདུན་ལ་རེ་རེ་བོར་ནས་ལུགས་དང་མཐུན་པ་དང་མི་མཐུན་པ་དང་།",
    "ཟག་མེད་བདུན་ལ་རེ་རེ་བོར་ནས་ལུགས་དང་མཐུན་པ་དང་མི་མཐུན་པར་འཇུག་པ་ནི་ཉེ་སྦྱོར་ཡིན་ནོ།",
    "ཐོད་རྒལ་གྱི་སྙོམས་འཇུག་ཡིན་པས་གོང་གི་དེ་མི་འཐད་དོ་ཞེ་ན།",
    "འདི་ཐེག་ཆེན་ཐུན་མོང་མ་ཡིན་པའི་ལུགས་ཡིན།",
    "བྱང་སེམས་འགའ་ཞིག་གིས།",
    "གཟུགས་སོགས་ལ་ཕྱིན་ཅི་ལོག་གི་བདེན་ཞེན་འགོག་པས་ཞི་བ་དང་།",
    "བྱང་སེམས་འགའ་ཞིག་གིས་ཡུལ་དགུ་ལ་རྣམ་པར་རྟོག་གོ།",
    "རེས་འགའ་དམིགས་པ་ཡང་མེད།",
    "བྱང་སེམས་འགའ་ཞིག་གིས་ཡུལ་དགུ་ལ་དམིགས་པའི་སོ་སྐྱེའི་འཛིན་པ་དགུ་ལ་སྔ་མ་མཐོང་སྤང་གི་སྐབས་སུ་བསྟན་པ་བཞིན་དུ་སྐྱེས་ཁུ་རྫས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་ཚུལ་གྱིས་རྣམ་པར་རྟོག་གོ།",
    "སྔ་མ་གཟུང་རྟོག་གི་སྐབས་སུ་བསྟན་པ་བཞིན་དུ་དེའི་སྐབས་དེར་སྤང་བྱའི་རྟོག་པ་ཡིན་པའི་ཕྱིར།",
    "ཉོན་མོངས་པ་ཅན་གྱི་མ་རིག་པས་བསྡུས་པའི་ཕུང་པོ་ལྔ་ཅི་རིགས་པར་ཚོགས་པའི་རྒྱུན་ལ་འཕགས་པ་འགའ་ཞིག་གིས་བཏགས་པ་ཙམ་དུ་འཛིན་པའི་འཛིན་པའོ།",
    "ཁྱོད་ཀྱིས་བཏགས་འཛིན་རྟོག་པའི་དབྱེ་བ་དགུ་གསུངས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "ཁྱོད་ཀྱིས་དེ་གསུངས་པས་བཏགས་འཛིན་རྟོག་པ་དེ་ཇི་ལྟར་རྣམ་པ་དགུ་ཡིན་སྙམ་པའི་དོགས་པ་སེལ་བའི་ཕྱིར།",
    "བྱང་སེམས་འགའ་ཞིག་གིས་ཡུལ་དགུ་ལ་དམིགས་པའི་འཕགས་པའི་འཛིན་པ་དགུ་ལ་སྔ་མ་མཐོང་སྤང་གི་སྐབས་སུ་བསྟན་པ་བཞིན་དུ་སྐྱེས་བུ་བཏགས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་ཚུལ་གྱིས་རྣམ་པར་རྟོག་གོ།",
    "དེས་ན་འཕགས་པའི་འཛིན་པ་ལ་དམིགས་ནས་སྐྱེས་བུ་བཏགས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་བློ་ནི་ཐ་མ་སྒྲུབ་རྟོག་ཏུ་གྱུར་པའི་བཏགས་འཛིན་རྟོག་པ་ཡིན་པར་ཤཱཀྱ་ཐུབ་པའི་མཆོག་གི་སྤྲུལ་པའི་སྐུས་བཞེད་པས་དབྱེ་གཞི།",
    "ཉོན་མོངས་པ་རྣམས་ཀྱི་རང་བཞིན་ལ་རྨོངས་པའི་དང་།",
    "རྣམ་མཁྱེན་ཐོབ་པ་ལ་གེགས་བྱེད་པའི་སྒྲིབ་པ་སྤོང་པའི་ཐབས་ལ་རྨོངས་པ་སྟེ་མི་ཤེས་པ་ལ་འཕགས་པ་འགའ་ཞིག་གིས་བཏགས་པ་ཙམ་དུ་འཛིན་པའི་འཛིན་པ་ལ་དམིགས་ནས་སྐྱེས་བུ་བཏགས་འཛིན་ཅན་གྱི་འཛིན་པར་ཞེན་པའི་བློ་སྒོམ་ལམ་རྩེ་སྦྱོར་གྱི་གཞོམ་བྱར་གྱུར་པ་ནི།",
    "སྔ་མ་གཟུང་རྟོག་གི་སྐབས་སུ་བསྟན་པ་བཞིན་དུ་དེའི་གནས་སྐབས་དེ་ན་སྤང་བྱའི་རྟོག་པ་ཡིན་པའི་ཕྱིར།",
    "བདུད་རིགས་ཀྱི་ལྷ་དང་མུ་སྟེགས་ཅན་ལ་སོགས་པའི་རང་གི་ངོ་བོ་རང་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པར་མ་ཤེས་པས་མི་མཉམ་པ་ཉིད་མ་ཤེས་པ་དང་།",
