    "ངོ་བོ་ཉིད་ཀྱི་སྐ་དེ་ཁྱོད་ཀྱི་རང་བཞིན་ཡིན་ཏེ།",
    "ཁྱོད་ངོ་བོ་ཉིད་ཀྱི་སྐུའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར།",
    "སྦྱོར་བ་བཞི་པོ་དེ་ཁྱོད་ཀྱི་རྒྱུ་ཡིན་ཏེ།",
    "རང་གི་ཡུལ་ཅན་བྱང་སེམས་འཕགས་པས་རྟོགས་པའི་ཕྱིར།",
    "སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་དང་།",
    "དེའི་འཁོར་དུ་སྟོང་གསུམ་དང་མཉམ་པའི་པདྨའི་གདན་བྱེ་བ་ཕྲག་ཁྲིག་གིས་གང་བར་སྣང་བ་འབྱུང་ངོ།",
    "པུས་མོའི་ལྷ་ང་གཉིས་ནས་འོད་ཟེར་གྲངས་མེད་པ་བརྒྱ་སྟོང་ཕྲག་བཅུ་སྤྲོས་པས་དུད་འགྲོ་དང་།",
    "ཕྱག་གི་མཐིལ་གཉིས་ནས་འོད་ཟེར་གྲངས་མེད་སོགས་སྤྲོས་པས་ལྷ་མ་ཡིན་གྱི་གནས་ཐམས་ཅད་སྣང་བས་ཁྱབ་པར་བྱས་ནས་སྡུག་བསྔལ་རྣམས་ཞི་བར་བྱེད་དོ།",
    "དེ་དག་གི་ལུས་ལ་ནུབ་པར་བྱེད་དོ།",
    "འཇིག་རྟེན་ལན་བཅུར་བསྐོར་ནས་སྟེང་གི་ནམ་མཁའ་ལ་འོད་ཟེར་གྱི་དྲྭ་བའི་དཀྱིལ་འཁོར་དུ་བྱས་ཏེ་དེ་བཞིན་གཤེགས་པ་རྣམས་མཆོད་དོ།",
    "ངན་སོང་ཞི་ཞིང་།",
    "རང་གཞན་གྱིས་ཡོངས་སུ་དག་པའི་ངོ་བོ་བྱང་སེམས་ཀྱི་རྣམ་བྱང་གི་བདེན་པ་གཉིས་དང་།",
    "གཞན་འབུམ་ལས་དངོས་པོ་བརྒྱད་པོ་རེ་རེ་ཡང་མིང་གི་རྣམ་གྲངས་མང་པོའི་སྒོ་ནས་རྫོགས་པར་བསྟན་པའི་ཕྱིར།",
    "ཡུམ་གསུམ་པོ་ཐམས་ཅད་ཀྱི་བརྗོད་བྱའི་དོན་གྱི་རིམ་པ་མངོན་རྟོགས་རྒྱན་འདིས་ལེགས་པར་བསྡུས་པ་མ་ཡིན་པར་ཐལ།",
    "ཁྱད་པར་དེ་ཡང་ཚིག་གི་ཁྱད་པར་ཁོ་ནར་ཟད་ཀྱི་དོན་ཁྱད་པར་མེད་དོ།",
    "ཐེམས་སྦྱོར་ཚིག་གི་སྦྱོར་བ་དང་།",
    "དེས་གནང་བ་ཐོབ་ཅིང་གདམས་ངག་གི་ཆ་གནང་ནས་བརྩམས་པའི་ཕྱིར།",
    "རང་གཞན་གྱི་དོན་གྱི་ཆེད་དུ་སེངྒེ་བཟང་པོ་བདག་གིས་འབད་ནས་བགྱིས་པའི་འགྲེལ་པ་ནོར་བ་ཡོད་སྲིད་ན།",
    "ཁྱོད་ཀྱིས་བརྩམས་པའི་འགྲེལ་པ་འདི་ལ་ནོར་བ་ཡོད་སྲིད་དེ།",
    "བསྟན་བཅོས་མངོན་རྟོགས་རྒྱན་གྱི་བརྗོད་བྱའི་དོན་མ་ལུས་པ་ཁྱོད་ཀྱི་མངོན་སུམ་གྱི་སྤྱོད་ཡུལ་མ་ཡིན་བཞིན་དུ་དེའི་འགྲེལ་པ་བརྩམས་པའི་ཕྱིར།",
    "དེ་ཁྱོད་ཀྱི་མངོན་སུམ་གྱི་ཡུལ་མ་ཡིན་ཏེ།",
    "བསྟན་བཅོས་མངོན་རྟོགས་རྒྱན་གྱི་བརྗོད་བྱའི་དོན་ཀུན་ཁྱོད་ལས་ཕྱི་རོལ་ཏེ་ཤིན་ཏུ་ལྐོག་གྱུར་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཁྱོད་ཡུམ་དོན་ལ་ཤེས་རབ་མི་གསལ་བའི་སྐྱེ་བོ་ཡིན་པའི་ཕྱིར།",
    "བསྟན་བཅོས་ཀྱི་དོན་ཀུན་ཁྱོད་ལ་ཤིན་ཏུ་ལྐོག་གྱུར་ཡིན་ན།",
    "བསྟན་བཅོས་ཀྱི་དོན་ཀུན་ཁྱོད་ཀྱིས་མངོན་སུམ་གྱི་ཡུལ་གང་ན་ཞིག་ཡིན་ཏེ།",
    "ཀྱེ་མ་ཡུམ་གྱི་ལུགས་འདི་ཡུན་རིང་མོ་ཞིག་ཏུ་བློ་སྦྱངས་ཤིང་།",
    "བློ་གྲོས་གསལ་བའི་མིག་གིས་ལེགས་མཐོང་ནས།",
    "རང་གི་གྲུབ་པའི་མཐའ་ལ་ལྷག་པར་ཆགས་གྱུར་ནས།",
    "སྒོར་ཁྱོན་པོད་དོན་དགུ་ཡོད།",
    "ལོ་བརྒྱར་ཡང་ལ་ལས་མཆི་ལ་མའི་ཐལ་བ་དང་།",
    "གང་དག་གཟུགས་དང་གཟུགས་མེད་པ་ན་སྤྱོད་པ་དེ་དག་ཀྱང་སྐད་ཅིག་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་བ་ལས་འདས་མོད་ཀྱི།",
    "འདི་ལྟར་རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ནི་བྱ་བ་མང་བྱེད་པ་མང་སྟེ།",
    "བདག་གི་འདས་པ་དང་།",
    "རྗེས་སུ་ཡི་རང་བའི་མཆོག་གིས་རྗེས་སུ་ཡི་རང་བར་གྱིས་ཤིག།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་དེ་ལྟར་ཞུགས་ལ་རྒྱལ་པོ་གྱིས་ཤིག།",
    "ཀུན་ནས་ཉོན་མོངས་།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་དེ་ལྟར་ཞི་བ་རྣམ་པར་ཐར་བ་ཐོབ་ཀྱང་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་མ་ཞི་བ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁྱོད་མོས་པར་བྱའོ།",
    "ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ང་ཀ་ཤི་ཀའི་རྒྱལ་པོར་གྱུར་པ་གང་ཡིན་པ་དེས་འདི་ལྟར་ཕུག་རོན་གྱི་ཕྱིར་བདག་གི་ཤ་ཁྲ་ལ་བྱིན་པ་དེ་ཤེས་རབ་འཆལ་པ་ཡིན་ནམ།",
    "མ་ཕམ་པ་ཁྱོད་ཀྱིས་བསྐལ་པ་དྲུག་ཅུར་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་བསྒྲུབས།",
    "དེ་ལ་ཐོག་མར་རེ་ཞིག་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་བསྐྱེད་པར་བྱ་སྟེ།",
    "དེས་རེ་ཞིག་ལུང་གི་དོན་ཀུན་ཏུ་འཛིན་པར་བྱེད་དོ།",
    "ཡང་དག་པའི་དངོས་པོའི་རང་གི་ངོ་བོ་ནི་དོན་དམ་པར་ན་སྐྱེ་བ་མེད་པ་ཁོ་ན་སྟེ།",
    "རིགས་པ་དང་ལུང་གིས་གཏན་ལ་དབབ་བོ།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "དེ་ལྟར་རེ་ཞིག་ལུང་གིས་བརྟག་པར་བྱའོ།",
    "རིགས་པས་བརྟགཔར་བྱས་ན་ལུང་གི་དོན་གུད་དུ་བཀྲི་མི་ནུས་ཏེ།",
    "རྟག་པ་ཡིན་པས་དེ་ལ་གཞན་དག་གིས་ཕན་གདགས་མི་དགོས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་དེ་དག་ནི་རྟག་པ་ལས་སྐྱེར་མི་རུང་ངོ།",
    "དཔེར་ན་རྡུལ་ཕྲ་རབ་རྣམས་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་འདྲེས་ནས་གོང་བུ་རྡུལ་ཕྲ་མོ་ཙམ་ཉིད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "ཇི་སྟེ་ཕྱོགས་གཅིག་གིས་ཕྲད་ན་ནི་དེའི་ཚེ་སྐད་ཅིག་ལ་ཆ་ཤས་ཡོད་པར་འགྱུར་རོ།",
    "དེ་ལ་རེ་ཞིག་གཟུགས་ཅན་བུམ་པ་ལ་སོགས་པ་དེ་དག་ནི་རྡུལ་ཕྲ་མོ་ཐ་དད་པའི་ངོ་བོ་ཉིད་ཡིན་པས་ན་རང་བཞིན་གཅིག་པ་མ་ཡིན་ནོ།",
    "རྡུལ་ཕྲ་མོ་ཤར་ནུབ་ན་གནས་པ་རྣམས་ཀྱང་ཤར་ལ་སོགས་པའི་ཕྱོགས་དང་ལྡན་པ་ཉིད་ཀྱིས་ཐ་དད་པ་རྣམས་ཀྱང་རྣམ་པར་ཕྱེ་ན་མི་འགྲུབ་པའི་ཕྱིར་རྡུལ་ཕྲ་མོ་རྣམས་ནི་བསགས་པའི་བདག་ཉིད་ཡིན་པས་ན།",
    "བློ་གྲོས་ཆེན་པོ་གླང་གི་རྭ་ཡང་རྡུལ་ཕྲ་མོར་བཤིག་ན་མི་འདུག་གོ།",
    "རྡུལ་ཕྲ་མོ་རྣམས་ཀྱང་སོ་སོར་བཤིག་ན་རྡུལ་ཕྲ་མོའི་མཚན་ཉིད་ལས་མི་གནས་སོ་ཞེས་སོ།",
    "རང་གི་སེམས་ནི་ཕྱི་རོལ་སྣང་།",
    "གང་གི་ངོ་བོ་ཉིད་གཅིག་ཏུ་མ་གྲུབ་པའི་ཕྱིར་དུ་མའི་ངོ་བོར་ཡང་མི་རུང་སྟེ།",
    "གཟུགས་ལ་སོགས་པའང་བདག་ཉིད་ཀྱིས་སྣང་བར་བྱེད་ན་རྣམ་པར་ཤེས་པའི་རང་གི་ངོ་བོར་གྱུར་པ་རྣམས་བརྫུན་པ་ཉིད་ཡིན་པས་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱང་བརྫུན་པ་ཡིན་པར་ཁས་བླངས་པར་གྱུར་ཏོ།",
    "ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ།",
    "མོས་པར་བྱ།",
    "དེ་ལ་རྣལ་འབྱོར་པས་སེམས་གནས་པར་བྱ་བའི་ཕྱིར་ཐོག་མ་ཁོ་ནར་རེ་ཞིག་ཞི་གནས་བསྒྲུབ་པར་བྱའོ།",
    "གཟུགས་ཅན་མ་ཡིན་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་ཏེ།",
    "ལས་དང་པོ་བའི་རྣམ་པར་གཡེང་བའི་ཉེས་པ་བསལ་བའི་ཕྱིར་རེ་ཞིག་འདུས་པ་དེ་ལ་ནི་དམིགས་པའི་རིགས་སོ།",
    "གང་གི་ཚེ་ཡིད་ལ་བྱེད་པ་ཁུགས་པར་གྱུར་པ་དེའི་ཚེ་ཕུང་པོ་དང་ཁམས་ལ་སོགས་པའི་བྱེ་བྲག་གིས་རྒྱས་པར་ཡང་དམིགས་པར་བྱེད་པ་ཁོ་ན་སྟེ།",
    "འདི་སྐད་དགོངས་པ་ངེས་པར་འགྲེལ་པ་ལ་སོགས་པ་ལས་ཀྱང་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སྟོང་པ་ཉིད་རྣམ་པ་བཅོ་བརྒྱད་ལ་དམིགས་པ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་དམིགས་པའི་རྣམ་པ་ཀུན་ཏུ་བཀའ་སྩལ་ཏོ།",
    "གང་གི་ཚེ་བར་སྐབས་སུ་འདོད་ཆགས་ལ་སོགས་པས་སེམས་ཕྱི་རོལ་དུ་རྣམ་པར་གཡེང་བར་བྱེད་པ་དེའི་ཚེ་རྣམ་པར་གཡེང་བར་ཤེས་པར་བྱས་ལ་མི་སྡུག་པ་ལ་སོགས་པ་བསྒོམས་པས་རྣམ་པར་གཡེང་བ་ཞི་བར་བྱས་ཤིང་མྱུར་དུ་དེ་ཉིད་ལ་སེམས་ཕྱི་ཕྱིར་གཞུག་པར་བྱའོ།",
    "གང་གི་ཚེ་ལ་མི་དགའ་བར་མཐོང་བ་དེའི་ཚེ་ཏིང་ངེ་འཛིན་གྱི་ཡོན་ཏན་ལ་ལྟ་བས་དེ་ལ་དགའ་བ་བསྒོམ་ཞིང་རྣམ་པར་གཡེང་བ་ལ་ཉེས་པར་ལྟ་བས་མི་དགའ་བ་རབ་ཏུ་ཞི་བར་བྱའོ།",
    "ཇི་སྟེ་གང་གི་ཚེ་རྨུགས་པ་དང་གཉིད་ཀྱིས་ནོན་ཏེ།",
    "དེ་རྣམས་ཀྱི་གཉེན་པོར་སྤོང་བའི་འདུ་བྱེད་བརྒྱད་བསྒོམ་མོ།",
    "དེ་ནས་འདོད་པས་བརྩོན་འགྲུས་རྩོམ་མོ།",
    "དེ་བས་ན་དད་པ་ལ་སོགས་པ་ནི་ལེ་ལོ་སྤང་བའི་ཕྱིར་བསྒོམ་མོ།",
    "དེའི་གཉེན་པོར་སེམས་པ་བསྒོམ་མོ།",
    "གང་གི་ཚེ་སེམས་རྣལ་དུ་འཇུག་པ་དེའི་ཚེ་རྩོལ་བ་ཉེས་པ་ཡིན་ཏེ།",
    "དེའི་གཉེན་པོར་དེའི་ཚེ་བཏང་སྙོམས་བསྒོམ་མོ།",
    "འདི་ལྟར་གང་གི་ཚེ་བཏང་སྙོམས་ཀྱི་ཚོར་བ་དང་ལྡན་ཞིང་རྟོག་པ་དང་བཅས་པ་དང་།",
    "གང་གི་ཚེ་འདོད་པའི་སྲེད་པ་དང་།",
    "གང་གི་ཚེ་རྟོག་པ་དང་དཔྱོད་པ་དང་བྲལ་ཏེ་བསམ་གཏན་དང་པོའི་སའི་སྲེད་པ་དང་བྲལ་བར་གྱུར་ནས་དགའ་བ་དང་བདེ་བ་དང་།",
    "གང་གི་ཚེ་བསམ་གཏན་གཉིས་པའི་སའི་སྲེད་པ་དང་བྲལ་བར་གྱུར་ཏེ་བདེ་བ་དང་།",
    "གང་གི་ཚེ་བསམ་གཏན་གསུམ་པའི་སའི་སྲེད་པ་དང་བྲལ་ཏེ་སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་ཞིང་།",
    "ཟིལ་གྱིས་གནོན་པའི་སྐྱེ་མཆེད་ལ་སོགས་པ་ཡང་དམིགས་པ་དང་རྣམ་པ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་སྦྱར་བར་བྱའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་མུ་སྟེགས་ཅན་རྣམས་ཀྱི་བཞིན་དུ་ཏིང་ངེ་འཛིན་ཙམ་གྱིས་ཉོན་མོངས་པ་སྤོང་བར་མི་འགྱུར་རོ།",
    "དེ་ཡི་ཉོན་མོངས་ཕྱིར་ཞིང་རབ་འཁྲུག་སྟེ།",
    "དེ་ལྟར་རྣལ་འབྱོར་པ་གང་གི་ཚེ་གཉིས་མེད་པའི་ཤེས་པ་སྣང་བ་མེད་པའི་ཤེས་པ་ལ་གནས་པར་གྱུར་པ་དེའི་ཚེ།",
    "ཤེས་རབ་ཀྱི་མིག་གིས་བརྟགས་ན་གཟུགས་ལ་སོགས་པ་སྔར་དམིགས་པ་དམིགས་སུ་རུང་བའི་མཚན་ཉིད་དུ་གྱུར་པ་དེ་དག་མི་དམིགས་པའི་ཕྱིར་ཐག་པ་ལ་སྦྲུལ་དུ་ཤེས་པ་བཞིན་དུ་སྤང་གི།",
    "ཤེས་རབ་ཀྱི་མིག་གིས་མ་བལྟས་ན་མུན་ཁུང་ན་འདུག་པའི་མི་ལྟར་ཁྱིམ་གྱི་ནང་ན་ཡོད་པའི་བུམ་པ་ལ་སོགས་པ་སོམ་ཉི་ཟ་བར་གྱུར་པ་བཞིན་དུ་རྣལ་འབྱོར་པ་ཡང་གཟུགས་ལ་སོགས་པ་ཡོད་པར་སོམ་ཉི་ཟ་བ་ལྡོག་པར་མི་འགྱུར་རོ་།",
    "དེ་ལྟ་བས་ན་ཏིང་ངེ་འཛིན་གྱི་ལག་གིས་སེམས་གཟུང་སྟེ་ཤིན་ཏུ་ཆ་ཕྲ་བའི་ཤེས་རབ་ཀྱི་མཚོན་གྱིས་གཟུགས་ལ་སོགས་པ་ལོག་པར་རྣམ་པར་རྟོག་པའི་ས་བོན་གྱི་ཟུག་རྔུ་སེམས་དེ་ལ་ཡོད་པ་བསལ་བར་བྱའོ།",
    "འདི་ལྟར་གང་གི་ཚེ་ཞི་གནས་ཀྱིས་དམིགས་པ་ལ་སེམས་བརྟན་པར་བྱས་པ་དེའི་ཚེ་ཤེས་རབ་ཀྱིས་རབ་ཏུ་བརྟགས་ན་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་འབྱུང་སྟེ།",
    "གང་གི་ཚེ་རྣལ་འབྱོར་པས་ཤེས་རབ་ཀྱི་མིག་གིས་བརྟགས་ན་དུས་གསུམ་དུ་ཡང་དངོས་པོ་མི་དམིགས་པ་དེའི་ཚེ་ཅི་ཞིག་བཀག་པས་དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པར་བྱེད།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་ཡང་དག་པར་སྤོང་ངོ།",
    "འདི་ལྟར་ཉོན་མོངས་པའི་སྒྲིབ་པ་ནི་མ་སྐྱེས་པ་དང་མ་འགགས་པའི་དངོས་པོ་རྣམས་ལ་དངོས་པོ་ལ་སོགས་པར་ཕྱིན་ཅི་ལོག་པའི་རྩ་བ་སྟེ་རྒྱུ་ཡིན་ནོ་ཞེས་འཕགས་པ་བདེན་པ་གཉིས་བསྟེན་པ་ལ་སོགས་པ་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་ཏོ།",
    "རྣལ་འབྱོར་གོམས་པ་འདིས་དངོས་པོ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་སྤངས་པའི་ཕྱིར་དངོས་པོ་ལ་སོགས་པར་ཕྱིན་ཅི་ལོག་པ་མ་རིག་པའི་ངོ་བོ་ཉིད་ཉོན་མོངས་པའི་སྒྲིབ་པའི་རྩ་བ་སྤོང་སྟེ།",
    "དེའི་ཕྱིར་རྩ་བ་བཅད་པས་ཉོན་མོངས་པའི་སྒྲིབ་པའི་རྩ་བ་ཡང་དག་པར་སྤོང་ངོ།",
    "ཇི་ལྟར་ཉོན་མོངས་པ་རྣམས་ཡོངས་སུ་ཤེས་པ་ཡིན།",
    "ལྟ་བ་ཀུན་ནས་ལྡང་བ་དེ་ལས་ཉོན་མོངས་པ་རྣམས་འབྱུང་ངོ།",
    "དེ་ལྟར་སྐྱེ་བ་མེད་པར་གནས་པ་དེའི་ཉོན་མོངས་པ་རྣམས་ཤིན་ཏུ་ཐུལ་བར་བལྟ་བར་བྱ་སྟེ།",
    "ལྷའི་བུ་གང་གི་ཚེ་ཉོན་མོངས་པ་རྣམས་སྣང་བ་མེད་པའི་ཡེ་ཤེས་ཀྱིས་དོན་དམ་པར་ཤིན་ཏུ་སྟོང་པ་དང་།",
    "ཤིན་ཏུ་དངོས་པོ་མེད་པ་རབ་ཏུ་ཤེས་པ་དེའི་ཚེ་ལྷའི་བུ་ཉོན་མོངས་པ་རྣམས་ཡོངས་སུ་ཤེས་པ་ཡིན་ནོ།",
    "ལྷའི་བུ་དེ་བཞིན་དུ་ཉོན་མོངས་པ་རྣམས་རབ་ཏུ་ཤེས་པ་དེའི་ཉོན་མོངས་པ་རྣམས་རབ་ཏུ་ཞི་བར་འགྱུར་རོ།",
    "འཇམ་དཔལ་ཉོན་མོངས་པར་གྱུར་པ་རྣམས་ཀྱི་རིགས་གང་།",
    "སྒྲིབ་པ་ནི་ཕྱིན་ཅི་ལོག་གི་མཚན་ཉིད་ཡིན་པའི་།",
    "འདི་ལྟར་ནང་གི་ཤེས་བྱ་སྨྲ་བ་རྣམས་ཀྱི་གཉིས་མེད་པའི་མཚན་ཉིད་ཀྱི་ཤེས་པ་དམ་པ་མཆོག་ཡིན་པར་འདོད་པ་གང་ཡིན་པ་དེ་ཡང་བདག་མེད་དོ།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་ནོ།",
    "ལ་ལ་ནི་ཉོན་མོངས་པའི་སྤྲུལ་པའོ།",
    "དེ་ནས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་སྐྱིལ་མོ་ཀྲུང་མ་བཤིག་པར་ལངས་ལ་འདི་སྙམ་དུ་བསམ་པར་བྱ་སྟེ།",
    "ཀུན་རྫོབ་ཏུ་ཡོད་པར་བསམ་མོ་།",
    "ངག་གི་ལས་གང་ཅི་ལགས་པ་དང་།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ཤེས་རབ་ཀྱི་གནས་སྐབས་ན་ཐབས་ལ་བརྟེན་པ་མི་འབྱུང་མོད་ཀྱི།",
    "མོས་པ་ཤིན་ཏུ་བརྟན་པ་ཙམ་དུ་ཟད་དེ།",
    "རབ་ཀྱི་མཆོག་གི་གནས་སྐབས་བཞིས་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཞིར་རྣམ་པར་གཞག་སྟེ།",
    "འདི་ལྟར་གང་གི་ཚེ་ཕྱི་རོལ་གྱི་དོན་རྣམ་པར་འཇིག་པ་ན་ཤེས་པའི་སྣང་བ་ཅུང་ཟད་གསལ་བ་བྱུང་བ་དེའི་ཚེ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་དྲོ་བར་གྱུར་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཤེས་པའི་སྣང་བ་དེ་ཉིད་འབྲིང་ཙམ་དུ་གསལ་བར་གྱུར་པ་དེའི་ཚེ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྩེ་མོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གང་གི་ཚེ་དེ་ཉིད་ཚེས་གསལ་བར་གྱུར་ཏེ་ཕྱི་རོལ་གྱི་དོན་མི་སྣང་བའི་ཤེས་པའི་སྣང་བ་བྱུང་བ་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་ཙམ་ལ་གནས་པའི་ཕྱིར་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཟོད་པ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེའི་བར་དུ་ནི་མོས་པས་སྤྱོད་པའི་ས་ཡིན་ནོ།",
    "ས་དེར་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་བརྒྱ་རྩ་བཅུ་གཉིས་སྤོང་ངོ།",
    "དེ་དག་ཏུ་བསྒོམས་པས་སྤང་བར་བྱ་བ་ཁམས་གསུམ་པའི་ཉོན་མོངས་པ་བཅུ་དྲུག་སྤོང་ངོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་གཉིས་པར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་གསུམ་པར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་བཞི་བར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་ལྔ་པར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་དྲུག་པ་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་བདུན་པར་རྣམ་པར་གཞག་གོ།",
    "ས་འདི་ལྷུན་གྱིས་གྲུབ་པའི་ལམ་དང་འབྲེལ་པའི་ཕྱིར་ཤིན་ཏུ་རིང་དུ་སོང་བས་རིང་དུ་སོང་བ་ཞེས་བྱའོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་བརྒྱད་པར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་དགུ་པར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་ཚེ་ནུས་པ་དེའི་ཚེ་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་བཅུ་པར་རྣམ་པར་གཞག་གོ།",
    "ཤིན་ཏུ་བརྟགས་ཀྱང་རང་བྱུང་གི།",
    "དེ་ལྟ་བས་ན་རྟོག་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་བཅོམ་ལྡན་འདས་རྣམས་ལ་དད་པ་བསྐྱེད་ལ་དེ་དག་གི་ཡོན་ཏན་ཡོངས་སུ་བསྒྲུབ་པའི་ཕྱིར་རྣམ་པ་ཐམས་ཅད་ཀྱིས་རབ་ཏུ་འབད་པར་བྱའོ།",
    "ན་མོ་གུ་རུ་མཉྫུ་གྷོ་ཥཱ་ཡ།",
    "འཇམ་དབྱངས་དབྱངས་ཅན་ལྷ་མོས་དགེ་ལེགས་སྩོལ།",
    "གི་གུ་ཞབས་ཀྱུ་འགྲེང་བུ་དང་།",
