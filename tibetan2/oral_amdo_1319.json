    "མཚོ་ཞེས་བྱ་བ་ཡོད་དེ་གང་དུ་གནས་ཤིང་ཁྲུས་བྱེད་པའི་སྐྱེས་པའམ་བུད་མེད་དེས་ཡིད་ལ་འདོད་པའི་འབྲས་བུ་ལེགས་པར་ཐོབ་པར་འགྱུར་རོ།",
    "གནས་སུ་སྐྱེས་པ་དང་བུད་མེད་གང་གིས་ཡང་དག་པར་བསྟེན་ཅིང་ཁྲུས་བྱེད་པ་དེ་བུད་མེད་རྣམས་སྐལ་བ་བཟང་པོར་འགྱུར་བ་སོགས་པའི་ལེགས་པའི་འབྲས་བུ་ཐོབ་པར་འགྱུར་རོ།",
    "སྐྱེས་པའམ་བུད་མེད་དག་གིས་དེར་ཁྲུས་བྱས་ན་མིའི་ཕུན་སུམ་ཚོགས་པའི་བདེ་བ་ལ་ལོངས་སྤྱད་ནས་མཐར་སྐྱེ་རྒ་འཆི་བ་སྤངས་ཏེ་རྒྱལ་བའི་གོ་འཕང་ཐོབ་པར་འགྱུར་རོ།",
    "འོང་ནས་ཀྱང་དེ་ལ་དྲིས་པ་བདག་ཉིད་ཆེན་པོ་གནས་འདི་ནས་པ་འབའ་འབའ་ཨ་མས་ཁ་༡ པ་འཇམ་དཔལ་གྱི་རི་རྩེ་མོ་ལྔ་པ་ལ་ཐག་ཇི་ཙམ་ཞིག་དེས་སྨྲས་པ།",
    "དེ་བས་ན་དེ་རིང་བདག་གི་གཙུག་ལག་ཁང་དུ་ངལ་བསོས་ལ་གདོད་བྱང་ཕྱོགས་ཀྱི་ལམ་དུ་སོང་ཞིག་ཅེས་སྨྲས་པས་དེས་ཅང་མི་སྨྲ་བར་ཁས་བླངས་སོ།",
    "རབ་ཏུ་ཞི་བའི་སྔགས་ཀྱིས་རྣམ་པ་མི་ཤེས་པར་མདུན་གྱི་སེང་གེ་དང་སྟག་དག་གི་རྫུ་འཕྲུལ་བརྟུལ་ནས་ཐོང་གཤོལ་ནི་སྐྱེ་བོས་རྟོགས་པར་བྱ་བའི་སླད་དུ་བཞག་གོ།",
    "སོང་ནས་ཀྱང་ད་ལྟ་ཉལ་བར་མི་འོས་སོ་ཞེས་བསམས་ནས་དེ་ཉིད་ཀྱི་ཁྱིམ་གྱི་སྒོ་དྲུང་དུ་བཏུད་ནས་གནས་ཏེ་བདག་ཉིད་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེན་པོ་ཅན་འདི་གང་དང་གང་གཏམ་དུ་མཛད་པར་འགྱུར་ཞེས་གཉིད་དུ་མ་སོང་བར་བྱས་སོ།",
    "དེར་འཇམ་དཔལ་ལ་ལྷ་མོ་སྐྲ་ཅན་མས་དྲིས་པ།",
    "གཙུག་ལག་ཁང་དུ་འོངས་པའི་དགེ་སློང་འདི་སུ་ཞིག་རྒྱུ་གང་གིས་འདི་རུ་འོང་།",
    "བདག་གི་ལྷ་མོ་འཇིག་རྟེན་གསུམ་གྱི་ཡུམ།",
    "དགེ་སློང་འདིས་ལམ་འདི་ནས་འཇམ་དཔལ་གྱི་རི་བོ་རྩེ་མོ་ལྔ་པར་འགྲོ་ཞིང་དོན་ཆེན་པོ་མཚན་ཡང་དག་པར་བརྗོད་པའི།",
    "ལྷ་མོ།",
    "ལྷ་མོ་ཁྱོད་ལ་གཅེས་པས་གསལ་བར་བསྟན་པ་སྟེ།",
    "ལྷ་མོ་སྐྲ་ཅན་མའང་སྔ་བར་ལངས་ནས་སྒོ་དབྱེ་བ་ན།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་སུ་ཞིག་དགེ་སློང་བོས་པ་དེ་ནི་བདག་ཅག་གི་ཁྱིམ་གྱི་སྒོ་དྲུང་དུ་མཆིས་ཏེ་ཤི་བའམ་གསོན་པ་མ་ཤེས་སོ།",
    "བཅོམ་ལྡན་འདས་དེར་བྱོན་པ་བདག་གིས་ཇི་ལྟར་འཚལ་བར་བགྱི།",
    "ཡིད་བདེ་བ་སྐྱེས་ཏེ་སྟོན་པ་འཇམ་དཔལ་ལ་གཡས་སུ་བསྐོར་བ་ལན་གསུམ་བྱས་ནས་ཞབས་ལ་སྤྱི་བོས་བཏུད་དེ་དེའི་དྲུང་ནས་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་བཅོམ་ལྡན་འདས་བདག་གིས་མ་མཐོང་ལགས་སོ།",
    "སྟོན་པ་བཅོམ་ལྡན་འདས་ཁྱོད་ལ་བདག་གིས་མི་ཤེས་པས་ནོངས་པར་བྱས་ཏེ།",
    "དེ་བས་ན་ལྡོང་བར་གྱུར་ཏེ་བདག་གི་ཉེས་པ་བཟོད་པར་མཛད་པའི་འོས་སོ།",
    "ཁྱོད་ཀྱི་རང་གི་ལས་ཀྱི་འབྲས་བུ་འདི་ཞི་བར་མི་འགྱུར་མོད།",
    "དེ་ལྟ་ནའང་ཁྱོད་ཀྱི་ཡེ་ཤེས་ཀྱི་མིག་གིས་ལྟོས་ཤིག་ཅེས་གསུངས་ནས་དེ་ཉིད་དུ་མི་སྣང་བར་གྱུར་ཏོ།",
    "དེས་རང་གི་བུ་རྒྱལ་པོ་གྲགས་པ་མང་པོ་ཅན་ཤཀྟི་ནུས་པའི་ལྷ།",
    "དེ་མ་ཐག་དེར་འཇམ་དཔལ་གྱི་སྤྲུལ་པའི་རང་བཞིན་སློབ་དཔོན་འཇམ་པའི་ལྷ་ཞེས་བྱ་བ་དེའི་མཆོད་རྟེན་ཀྱང་མཇུག་མའི་རྩེ་མོའི་གནས་དེ་ཉིད་དུ་མཐུ་སྟོབས་ཆེན་པོ་རབ་ཏུ་གསལ་བའི་ཆེད་དུ་དད་པས་བྱས་སོ།",
    "ལྷ་མོ་ནོར་འཛིན་མའི་གནས་ཉིད་ཀྱི་ཕྱིར་ནོར་གྱི་གྲོང་བ་སུ་པུ་རི།",
    "མེ་ལྷའི་གནས་ཉིད་ཀྱི་ཕྱིར་མེའི་གྲོང་ཨགི་པུ་རི།",
    "མིའི་སྐྱེ་བོ་མང་པོས་གང་བར་གྱུར་པ་དེ་ནམ་ཞིག་དུས་གཞན་ཞིག་གི་ཚེ་ན་བལ་པོའི་ཡུལ་འདི་ཉིད་དུ་ལོ་བདུན་དུ་ཆར་མ་བབས་པས་ལོ་ཉེས་པར་གྱུར་ཏོ།",
    "གླང་རུའི་རི་འདི་ལ་ཞི་བའི་གྲོང་དུ་གྲུབ་པའི་སློབ་དཔོན་ཞི་བྱེད་ལྷ་ཞེས་བྱ་བ་ཡོད་དེ་དེར་སོང་ནས་དེ་ལ་གསོལ་བ་གདབ་པར་བྱའོ།",
    "འོངས་ནས་ཀྱང་ཞི་བྱེད་ལྷའི་ཞབས་ལ་ཕྱག་བྱས་ནས་ཐལ་མོ་སྦྱར་ཏེ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ད་ལྟ་བ་ཐམས་ཅད་མཁྱེན་པ་ལགས་མོད།",
    "ད་ལྟ་ཀླུ་བསྒྲུབ་པར་བྱའི་ཕྱི་ནས་ཁྱོད་ཀྱིས་ཀྱང་བགེགས་ཞི་བའི་དོན་དུ་སྒྲུབ་པར་གྱིས་མཁས་པ་དང་གས་ཁམས་༡ ནྟི་མ་ཨམས་པས་རྣམས་ཀྱིས་དུས་དང་དུས་སུ་ཆར་འབེབས་པར་གྱིས་ཤིག་ཅེས་བསྒོས་སོ།",
    "དེའི་ཕྱིར་རྒྱལ་པོ་དེས་སྟོབས་ཉིད་ཀྱི་དྲངས་ཏེ་ཀླུའི་གནས་གང་ནས་དེ་དེ་བཞིན་དུ་སོང་ངོ།",
    "སོང་ནས་ཀྱང་བོས་ཏེ་དེ་ལྟ་བུ་བསྟན་པར་བྱས་ཀྱང་ཀརྐོ་ཊས་ཅུང་གྱིས་ཤིག།",
    "རྒྱལ་པོས་སློབ་དཔོན་ཆེན་པོ་ལེགས་སོ་ཞེས་ཞི་བྱེད་ལྷའི་བསྒོ་བ་ལྟར་མཉན་ནས་བསྒྲུབ་སྟེ་དེའི་ཕྱིར་ཁྱོད་འགུགས་པའི་དོན་དུ་བདག་འོངས་སོ།",
    "ཞེས་དེ་སྐད་བསྟན་པར་ནས་ཀྱང་མི་འོང་བ་དེའི་ཚེ་ཁྱོད་ཀྱི་སྟོབས་ཀྱིས་དྲོངས་ཤིག་ཅེས་བསྟན་པའང་བདག་གིས་སློབ་དཔོན་ཞི་བྱེད་ལྷས་མྱུར་དུ་ཤོག་ཅིག་ཅེས་ཉེ་བར་བསྟན་ཏོ།",
    "ཁྱོད་གཅིག་པུ་མ་འོངས་པ་ལ་གྲུབ་པའི་རོ།",
    "དེར་བདག་གི་བཀས་འདི་སྐད་བརྗོད་དེ།",
    "བདག་གི་མཐུས་དེའི་དྲུང་དུ་ཉེ་བར་གནས་པར་འགྱུར་སྟེ་མཚོ་དེར་དུརྦ་དང་ཀུནྡ་འཕང་སྟེ་དེ་གང་དུ་འཁོར་ཞིང་འོག་ཏུ་སོང་བ་དེ་ཉིད་དུ་དེའི་ནུས།",
    "སྒྲུབ་པ་པོ་སློབ་དཔོན་ཆེན་པོ་མཚོའི་ཆུ་ཟབ་མོ་དེར་ཇི་ལྟར་བགྲོད་པར་ཀརྐོ་ཊ་དེ་ལོངས་ཤིག་གལ་ཏེ་མི་འོངས་ནི་དེའི་ཚེ་སྟོབས་ཀྱིས་དྲོངས་ཤིག་ཅེས་བསྟན་ཏོ།",
    "དེས་ན་ཁྱོད་གྱིས་ཨཱ་དྷཱ་ར་ཞེས་བྱ་བའི་མཚོར་སོང་ནས་མཚོའི་བདག་པོ་ཀླུའི་རྒྱལ་པོ་ལ་སོགས་པའི་ཀླུའི་རྒྱལ་པོ་ཐམས་ཅད་འོངས་ཀྱང་ཀླུའི་རྒྱལ་པོ་ཀརྐོ་ཊ་གཅིག་པུ་མ་འོངས་བྱེད་ལྷས་དེ་འགུགས་པའི་དོན་དུ་རྒྱལ་པོ་ལ་ཡང་དག་པས་བསྟན་ཏེ།",
    "གྲུབ་པའི་སློབ་དཔོན་རྫུ་འཕྲུལ་ཆེན་པོ་ཤེས་རབ་ཅན་ཞི་བྱེད་ལྷ་དེའང་བྱ་བ་རྣམས་བྱས་ནས་རང་གི་གྲོང་གི་མདུན་དུ་དཔག་ཚད་ཀྱི་ཚད་ཀྱི་ས་འོག་ཏུ་ཡིད་བཞིན་གྱི་ནོར་བུ་དཔག་བསམ་ལྗོན་པས་བརྒྱན་ཅིང་ཡིད་དགའ་བའི་སའི་མཐོ་རིས་སུ་ཤིས་པའི་དཔལ་གྱི་བདེ་བའི་བུ་གར་ཏིང་ངེ་འཛིན་མཛད་ནས་བཞུགས་སོ།",
    "བདག་གིས་བྱས་བའི་ལེགས་བྱས་ནི།",
    "གང་གིས་རྟག་ཏུ་འཇིག་རྟེན་ཀུན།",
    "གང་དུ་མཆོག་གི་དེ་ཉིད་དེ་ལ་སྦྱོར་བའང་ཤེས།",
    "༧ གཞན་དུ་མཛེས་བྱེད་དང་ནི་ཁྲོ་མོ་དང་།",
    "༨ ཐུན་མོང་དང་ནི་རྣམ་པར་འགལ་བྱེད་དང་།",
    "དང་པོར་ཆ་ཤས་ནོར་ལྷའི་བུ་དང་ནོར་ལྷའི་མོན་དྲེ།",
    "རབ་བྱུང་ཆེ་ཞེས་དེ་ཚེ་མིང་གིས་ལོ་རུ་འགྱུར།",
    "དེ་ནི་ལྷ་རྣམས་ཀྱི་ནི་མཚན་མོར་བཤད།",
    "ལྟད་མོ་ཅན་དང་སྟོབས་ཟླ་ནུས་ཟླ་དང་།",
    "༢རང་མིང་རྒྱུ་སྐར་མིང་གི་མགོན་ཅན་ཟླ།",
    "སྟོང་པ་རྣམས་སུ་འབིགས་དང་གསོང་འཆིང་འཇོམས་པ་དང་།",
    "༨ རྫོགས་པ་རྣམས་ལ་བཀྲ་ཤིས་བག་མ་ལྟད་མོ་དང་།"
  ]
}