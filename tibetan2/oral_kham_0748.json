    "བརྫུན་ཞེས་ཏེ་དེ་རྣམས་ཐམས་ཅད་དུ་སྤང་བར་བྱའོ་ཞེས་པ་འདི་ལ་རྒྱུ་ཅི་ཡང་མེད་དེ་བརྫུན་པ་གང་ནམ་ཡང་རང་དང་གཞན་གྱི་དོན་དུ་སྦྱོར་བ་མི་འགྱུར་བ་དེ་རྣམས་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཐམས་ཅད་ཡོངས་སུ་དོར་བའི་མཚན་ཉིད་དུ་སྤང་བར་བྱའོ་། གང་ཡང་དངོས་དང་བརྒྱུད་པས་རང་དང་གཞན་ལ་ཉེ་བར་མཁོ་བའི་ཡོན་ཏན་དེ་རྣམས་བརྩེ་བ་ཆེན་པོ་རྣམས་ཀྱིས་ཅི་ལྟར་དུས་ཐམས་ཅད་དུ་སྤང་།",
    "འདུག་ཀྱང་རུང་ཉལ་༧ཀྱང་རུང་།",
    "ཉེ་བར་འཇོག་སྟེ་སེམས་བརྟན་པར་གྱུར་ཀྱང་རང་བཞིན་གྱིས་རགས་པ་ཉིད་ཀྱིས་ན་གཞན་དུ་ཡང་རྣམ་པར་གྲོལ་བ་ལས་གོང་ནས་གོང་དུ་ཕྲ་བར་བྱེད་པས་དེ་ཁོ་ན་ལ་འཇོག་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་གཉི་ག་དུས་ཐམས་ཅད་ཁོ་ནར་བསྟན་པར་བྱའོ།",
    "ཾགང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པ་དེ་ཁོ་ན་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "གཉིས་ཀ་དག་ཀྱང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གཞན་གྱིས་ཉེ་བར་བསྟན་པ་མེད་པར་ཡང་རང་ཉིད་མཁས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འོ་ན་འབྱུང་འགྱུར་དང་བྱུང་ཟིན་དག་དུས་ཀྱིས་བར་དུ་ཆོད་པས་ན་དེས་ཅི་ལྟར་སྟོན་ཞེ་ན།",
    "དེ་ལ་ཨ་ར་པ་ཙ་ན་ལ་སོགས་པའི་ཡི་གེ་རྣམས་ལ།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་པ་ལས་པདྨ་དེ་ལ་འདུག་པར་ཀུན་དུ་སྣང་ངོ།",
    "ཏིང་ངེ་འཛིན་གྱིས་གནས་པ་ནི་གང་རང་བཞིན་གྱིས་༧ མཉམ་པར་གཞག་པ་དང་།",
    "རྫི་མ་གནས་པའི་གོ་སྐབས་སྣུམ་ལ་མཐིང་གར་འདུག་པ་དང་།",
    "དམའ་བར་འདུག་སྨྲས་རྗེས་༩ བཟླས་པས།",
    "ལ་ནི་འགྲོའོ་སྙམ་པའི་བློ་སྐྱེས་ཏེ་འགྲོ་ཞིང་འདུག་པའི་ཕྱིར་ཅེས་པ་ལྟ་བུ།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ་ཞེས།",
    "སྦྲུམ་མ་ལ་ཉལ་པོ་བྱས་ན་ལྟོ་ན་བུ་འདུག་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "འདོད་པ་ན་སྤྱོད་པའི་རང་འཁྲུངས་མ་ཡིན་པ་དང་རང་འཁྲུངས་པ་ལས་ནི་ཉེ་ཨ་བར་སྤྱོད་པ་ཀུན་ནས་སློང་བའོ་ཞེས་གསུངས་པས།་",
    "པེ་སྣར་ས་ཡི་དལ་བར་མི་འདུག་པ།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "དྨེ་པེ་སྣར་ཉན་ཐོས་དང་རང་རྒྱལ་བ།",
    "རྒྱུ་འབྲས་ཁས་ལེན་པ་ཡང་མི་རིགས་པར་བསྟན་པའི་ཕྱིར་དང་རང་དང་གཞན་དང་གཉིས་ཀ་དང་།",
    "དེ་དོན་གཉིས་ཀར་མི་མཐུན་ཕྱོགས་ཡིན་ན་དེ་ལ་ཞུགས་པས་ཁྱབ་པ་མ་གྲུབ་པས་སྔ་སོ་ཉིད་ན་འདུག་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་རྣམས་རྟོག་མེད་ཡིན་ན་ཡང་འོན་ཀྱང་རང་བཞིན་གྱི་རྟོག་པ་ལ་ལྟོས་ཏེ་འདི་ལྟར་གསུངས་སོ།",
    "ཁོ་རང་བཞིན་བརྒྱ་དྲུག་ཅུ་ཡིན་ནོ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ཚུལ་ཁྲིམ་བརྟུལ་ཞུགས་ཡོན་ཏན་རྫོགས་ལ་འདུག།",
    "བརྟལ་ཞུགས་ཡོན་ཏན་རྫོགས་ལ་འདུགསྲིད་པའྀ་ཟད་པའི་མཐའ་ལ་ང་གནས་ཏེ།",
    "དེཙམདུ་ཡང་བདེ་བར་འདུག།",
    "ཤན་དུ་རང་པ་ལ་སགོས་པ་སྙད་ཀན་འབར་ཞིང་འདུག་ཅེས་བྱ་བ་དང་།",
    "དེ་ལས་རའི་ལུས་ཐམས་ཅད་དུ་སྐོམ་པ་མེད་ཅིང་རང་པའི་རྣམ་པ་ལྷའི་སྐུར་གྱུར་ཏོ།",
    "ཕོག་པ་ཡང་ཉན་ཐོས་དང་རང་སདྲརྒྱས་ཐམས་ཅད་ཀྱིས་མི་བཟོད་དོ།",
    "ཞལ་བདུན་ཙམ་གྱི་ནམ་མཁའ་ལ་འདུག་ནས་ཚིག་འདྲི་ཞེས་སྨྲས་སོ།",
    "མདུན་དུ་འདུག་པ་ལྟ་ཅི་སྨོས།",
    "བཅོམ་ལྡན་འདས་ལ་བསྟོད་ནས་ཡང་བསྐོར་བ་བྱས་སྟེ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ཀྱྀ་དྲུད་དུ་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུའི་མདུན་ཏུ་འདུག་གོ་རིའི་ཚེ་ན་ཚེདང་ལྡན་པ་ཤཱ་རིའི་བུ་སྣམ་སྦྱར་འདྲུབ་པར་གྱུར་ཏེ།",
    "བེ་རོ་ཙ་ནཱ་བྷི་སཾ་བོ་དྷི་ཏནྟྲ་སྱ་སད་བྲྀཏྟི་ནཱ་མ།",
    "བྱིན་གྱིས་རློབ་པ་ཞེས་པ་ནི་དཀྱིལ་འཁོར་དང་སྔགས་དང་ཕྱག་རྒྱའི་སྒོ་ནས་ལུས་ངག་ཡིད་གསུམ་གྱི་ཆ་ལུགས་དང་རང་བཞིན་དུ་ལྷག་པར་གཞག་ཅེས་པའི་དོན་ཏོ།",
    "ཚིག་ལྷུར་ལེན་པའི་གདུལ་བའི་འགྲོ་བ་རྣམས་ཀྱིས་དེ་ལྟར་རྒྱུ་དང་རང་བཞིན་དང་འབྲས་བུ་ལ་སོགས་པ་རྣམ་པར་ཕྱེ་སྟེ།",
    "སྔགས་དེ་རྣམས་ཀྱི་རྒྱུ་དང་རང་བཞིན་དང་འབྲས་བུ་ཐོབ་པའི་ཐབས་ལམ་ནི་ཚུལ་ཏེ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་གསང་བ་པའི་བདག་པོ་ཕྱག་ན་རྡོ་རྗེ་འཁོར་འདུས་པ་དེ་ཉིད་ན་འདུག་པས།",
    "ལྷའི་རྣབས་ལམ་རིང་པོ་ན་འདུག་པའི་སྒྲ་ཡང་རི་དང་རྩིག་པ་ལ་སོགས་པས་མི་སྒྲིབ་པར་ཐོས་ཤིང་།",
    "ས་གོང་མ་ལ་སོགས་པས་རིམ་གྱིས་རྫོགས་པར་བྱེད་པ་ཡང་རང་བཞིན་དེ་ལས་ཐ་དད་པ་མ་ཡིན་གྱི།",
    "ཞགས་པའི་སེམས་གང་ཞེན་གང་ཐམས་ཅད་དུ་བདག་ཉིད་བཅིངས་ཤིང་འདུག་པའོ་ཞེས་པ་ནི་ཞགས་པ་ལྟ་བུའི་སེམས་ཏེ།",
    "གང་རྐང་པ་གཉིས་ལ་འདུག་སྟེ་སེམས་པའོ་ཞེས་པ་ནི་ལྕགས་སྒྲོག་ལྟ་བུའི་སེམས་ཏེ་ལྕགས་སྒྲོག་ནི་རྐང་པ་གཉིས་འཛིན་པར་བྱེད་དེ།",
    "བྱུང་མ་ཐག་ཏུ་ཞིག་ཅིང་མེད་པར་འགྱུར་བ་མི་རྟག་པས་འདུག་པའི་གནས་མེད་པ་ལ་ཕུང་པོར་བརྟགས་པའི་དངོས་པོ་གང་ཡང་མེད་པར་ཤེས་སོ།",
    "ལོ་ལ་སོགས་པར་འདུག་ཅིང་བདེ་བ་དང་སྡུག་བསྔལ་རྣམ་པ་མང་པོ་མྱོང་བར་མཐོང་ལ།",
