    "དེ་མ་ཚང་བ་ལ་སོགས་པ་ཡང་དཔེ་བསྒྲུབ་པར་བྱ་བས་སྟོང་པ་ལ་སོགས་པའི་ཉེས་པ་ཡིན་ནོ།",
    "འོན་ཏེ་སྤྱི་བསྒྲུབ་པར་བྱ་བ་འདོད་པའི་ཕྱིར་ཁྱད་པར་འཕེན་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདི་ལ་ནི་དེ་མི་འཕེན་ན་སྒྲུབ་པར་བྱེད་པའི་འབྲས་བུ་ཅི་ཡིན།",
    "གལ་ཏེ་སྒྲུབ་པར་བྱེད་པས་ཡུལ་དུ་བྱས་པ་མ་ཡིན་ན་ཇི་ལྟར་དེས་དེ་འགྲུབ།",
    "དེས་དེ་ལ་བརྟེན་པའི་སྒྲུབ་པར་བྱེད་པ་ལས་རྙེད་པར་འགྱུར་ཞིང་།",
    "གཞན་སུན་འབྱིན་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་གསལ་བར་རྒྱལ་པོའི་གྲ་སའི་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "དེས་ན་གྲུབ་པ་འཕེན་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པའི་ནུས་པས་ཁྱབ་པའི་དོན་གྱིས་རྣམ་པ་ཇི་སྙེད་པ་དེ་ཐམས་ཅད་ནི་སུན་འབྱིན་པས་ཀྱང་ཡིན་ནོ།",
    "གཉི་ག་དེ་ལྟ་བུའི་དངོས་པོར་སྲིད་ན་གང་ཡང་རུང་བ་བྲྗོད་པར་ནུས་པ་ཡིན་ཏེ།",
    "དཔེར་ན་ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་གང་ཡང་རུང་བ་ཞིག་པའོ་ཞེས་བྱ་བ་ལྟ་བུ་ཡིན་གྱི།་།",
    "གལ་ཏེ་ལུས་ཉིད་ཀྱིས་དོན་གཞན་གྱི་ངོ་བོ་ཡིན་ན་ནི་དེ་ཉིད་དེ་སྐད་དུ་བྲྗོད་པར་འགྱུར་ན།་",
    "གསལ་བ་ཐམས་ཅད་ཡོད་པར་མི་སྲིད་ན་དེའི་སྤྱི་མི་འཐད་པའི་ཕྱིར་རོ།",
    "ལུས་རྗེས་སུ་འགྲོ་བ་མེད་པར་དོགས་པ་བུམ་པ་དང་ཡང་འགལ་བའི་ཕྱིར་རོ།",
    "ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་དག་ལས་གང་ཡང་རུང་བ་གཅིག་ལ་ཟས་སྦྱིན་པར་བྱ་བ་ཡིན་ཏེ།",
    "ལྷ་སྦྱིན་ལ་མ་ཡིན་ཞིང་མཆོད་སྦྱིན་ལ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ལྟ་བུ་ཡོད་པ་སྲིད་དམ།",
    "ལྷ་སྦྱིན་འབའ་ཞིག་ལ་མ་ཡིན་ནོ་སྙམ་དུ་བསམས་པའི་ཕྱིར་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "དེའི་ཕྱིར་གཅིག་ཡོངས་སུ་གཟུང་ཡང་མི་འགལ་བ་ཡིན་ན་གང་ཡང་རུང་བ་སྨོས་པ་འདི་ནུས་པར་འགྱུར་ཏེ།",
    "འདིའི་ཡུལ་ནི་རྣམ་པར་བརྟག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་བུམ་པ་ཁོ་ན་འམ་ལུས་ཁོ་ནས་གཉིས་པ་དང་བཅས་པར་ནི་མི་འདོད་དོ།",
    "གཉིས་གཅིག་ལ་བསྒྲུབ་པ་ལ་ཡང་རྣམ་པར་བརྟག་པ་དང་བསྡུ་བ་ཡང་མི་འཐད་པ་ཡིན་ན་ད་ཅི་ཞིག་སྒྲུབ་པར་ནུས་ཏེ།",
    "རྣམ་པར་བརྟག་པ་དང་གཅིག་ཏུ་སོ་སོར་ངེས་པ་འགལ་བའི་ཕྱིར་རོ།",
    "དོན་རྣམས་ལ་ཡང་སྤྱིར་བྲྗོད་ཀྱང་ཤུགས་ཀྱི་ཁྱད་པར་གནས་པའི་ཕྱིར་ཡང་ལུས་ཉིད་རྟོགས་པར་འགྱུར་གྱི་བུམ་པ་ནི་མ་ཡིན་ནོ།",
    "དཔེར་ན་འགའ་ཞིག་འོངས་སོ་ཞེས་བྱ་བས་རིའམ་ཤིང་ལ་ནི་དོགས་པར་འགྱུར་བ་མ་ཡིན་པ་བཞིན་ནོ།",
    "སྒྲ་དང་བུམ་པའི་ཁྱད་པར་གྱིས་རྟོགས་ན་ནི་མི་རྟག་པ་ལ་ཡང་མཚུངས་སོ་ཞེ་ན།",
    "མི་རྟག་པ་ཉིད་གྲུབ་པས་ན་སྒྲ་དེ་དང་ལྡན་པར་སྒྲུབ་པའི་ཕྱིར་རོ།",
    "སྒྲ་མི་རྟག་པའི་སྒྲ་དང་ལྡན་པ་མ་ཡིན་ནོ་དེ་ལྟར་གྱུར་པར་འདོད་ན་ནི་སྒྲ་ལ་མི་རྟག་པའི་སྒྲ་སྒྲུབ་པའི་ཕྱིར་སྒྲ་མི་རྟག་པར་མི་འགྱུར་གྱི།",
    "སྒྲ་མི་རྟག་པའི་སྒྲ་དང་ལྡན་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་འདོད་པའི་སྤྱི་གྲུབ་བ་མ་གནོད་པར་བྱས་པ་ཡིན་ནོ།",
    "དེའི་ཁྱད་པར་གྱི་སྒོ་ནས་བྱེད་པའི་ཕྱིར་དེས་ཐ་སྙད་དུ་བྱེད་དོ།",
    "བསྟན་བཅོས་ཁས་བླངས་པའི་ཕྱིར་དེ་ལ་མཐོང་བ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་དོགས་པ་སྲིད་པར་འགྱུར་རོ།",
    "ལོག་པར་རྟོགས་པ་ཡང་མཐོང་བ་ཉིད་དེ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་དྲི་ལ་སོགས་པའི་ཡོན་ཏན་བཟློག་པའི་ཕྱིར་གཏན་ཚིགས་འགལ་བར་འགྱུར་རོ།",
    "འོན་ཏེ་རྒོལ་བས་ཀྱང་འདོད་པས་སྒྲུབ་པར་བྱེད་དོ།",
    "སྤྱིའི་ཕྱོགས་གཅིག་ཏུ་གྱུར་པའི་ཁྱད་པར་ཡིན་པ་ཞེས་བྱ་བ་ཙམ་གྱིས་ནི་སྐབས་མ་ཡིན་པ་འདོད་པར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་ན་འདི་ནི་སྐབས་འགའ་ཞིག་ལས་འགྱུར་བ་དང་དེ་ཉིད་ཀྱིས་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "འཁྲུལ་པ་ཡིས་ནི་གནོད་པར་འགྱུར།",
    "ལུང་ལ་ལྟོས་པ་མེད་པར་བཤད།",
    "དེས་གྲུབ་དེ་ནི་ལེགས་པར་གྲུབ།",
    "དེ་ཚེ་བསྟན་བཅོས་ཡོངས་འཛིན་པར།",
    "བསྟན་བཅོས་ཀྱིས་ནི་གནོད་པར་འགྱུར།",
    "སྤང་པར་བྱ་ཡི་གཞན་མིན་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་གཅིག་ཉིད་ལ།",
    "མ་གྲུབ་པར་ནི་ཇི་ལྟར་འགྱུར།",
    "རྒྱུ་དག་སྒྲུབ་པར་བྱེད་པའི་དོན།",
    "ཅི་སྟེ་རྟོགས་པར་འགྱུར་མ་ཡིན།",
    "དོན་རྣམས་ཐམས་ཅད་མཚུངས་བྱས་ནས།",
    "དེའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ལ་གནོད་པར་བྱེད་པ་ཁོ་ན་འགལ་བ་ཡིན་ནོ།",
    "དེ་ནི་གཞན་གྱིས་བྱས་ན་ཡང་མཚུངས་པའི་ཕྱིར་འགལ་བར་འགྱུར་རོ།",
    "གཞན་གྱིས་བྱས་ན་ཡང་དམ་བཅའ་བའི་སྐྱོན་དུ་འགྱུར་བ་ཁོ་ནའོ་ཞེ་ན།",
    "གནོད་པར་བྱ་བའི་དོན་ཅན་གྱི་བསྟན་བཅོས་ཁས་བླངས་པས་ན་གཞན་དུ་ཡང་འགྱུར་རོ།",
    "ཕྱོགས་ཀྱི་མཚན་ཉིད་ལས་ཕྱི་རོལ་དུ་གྱུར་པའི་དོན་ཅན་རང་ཉིད་ཀྱི་སྒྲས་ཀྱང་དོན་ཅུང་ཟད་རྒྱས་པར་མི་བྱེད་དོ།",
    "དེ་ལ་ཡང་རྣམ་པར་དཔྱོད་པའི་སྐབས་ཉིད་ཀྱིས་གཞི་རབ་ཏུ་གྲགས་པ་ཡིན་པར་གྲུབ་པའི་ཕྱིར་འདི་ནི་ཅི་ཡང་མ་ཡིན་ནོ།",
    "དེ་ལྟར་རབ་ཏུ་བཀོད་པའི་ངོ་བོ་མཚུངས་པར་མ་གྲུབ་ཅན་དག་ནི་ཁྱད་པར་གྱི་རྟེན་ཅན་གྱི་ཐ་སྙད་རྟེན་མ་ཡིན་པའི།",
    "གྲུབ་པ་དང་སྒྲུབ་པར་བྱེད་པའི་ངོ་བོར་བསྟན་པ་ཡིན་པར་དགོས་ན་བསྒྲུབ་པར་བྱ་བ་ཁོ་ནར་བསྟན་པར་བྱ་བ་ཞེས་བྱ་བ་འདི་འབྲས་བུ་བཅས་པར་འགྱུར་རོ།",
    "གཏན་ཚིགས་ནི་ཁྱད་པར་དང་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་གཏན་ཚིགས་ལ་སོགས་པའི་སྐྱོན་མཐའ་དག་ཕྱོགས་ཀྱི་སྐྱོན་ཡིན་པར་འགྱུར་ཏེ།་",
    "ལྟོས་པ་མེད་པར་མ་ཁྱབ་དང་།",
    "ལོག་པར་རྟོགས་པ་མཐོང་བའི་ཕྱིར།",
    "འདོད་པའི་ཚིག་ལ་ཡན་ལག་ཉིད་ཡིན་པས་དེས་གཏན་ཚིགས་མ་གྲུབ་པ་ལ་སོགས་པ་འགོག་པར་བྱེད་དོ།",
    "རྒོལ་བ་བདག་ཉིད་ཀྱིས་འདོད་པ་རྗེས་སུ་དཔག་པར་བྱ་བ་ཉིད་དུ་རྗོད་པ་འདིས་ནི་མི་འདོད་པ་དང་འདྲེས་པའི་འདོད་པ་ཡང་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ཞིང་།",
    "དེ་ལ་གནོད་ན་ཡང་ཕྱོགས་དང་གཏན་ཚིགས་ཀྱི་སྐྱོན་དུ་འགྱུར་བ་མེད་པར་རིག་བར་བྱ་སྟེ།",
    "ཇི་ལྟར་བསྒྲུབ་པར་བྱ་བ་ཡིན་པ་བཀག་པ་མེད་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་ནམ་མཁའི་ཡོན་ཏན་ཉིད་དང་དོན་གཅིག་ལ་འདུ་བ་ཅན་མི་རྟག་པ་ཉིད་མེད་པར་ཡང་སྒྲུབ་པར་བྱེད་པ་བཞིན་ནོ།",
    "རྗེས་སུ་དཔག་པའི་དུས་སུ་བསྟན་བཅོས་ལ་མི་བརྟེན་པར་རྗོད་པ་འདི་ཉིད་ཀྱིས་སྐབས་སུ་གཏོགས་པ་མ་ཡིན་པ་ཕྱོགས་སུ་བྱེད་པ་ཡང་གསལ་བ་ཡིན་ལ།",
    "བསྟན་བཅོས་ལ་བརྟེན་པའམ་ཕྱིར་རྒོལ་བ་དེ་རྟོགས་པ་དོན་དུ་གཉེར་བ་ཡིན་ན་ནི་དོན་ཏེ་ཕྱོགས་སུ་བྱེད་པར་འགྱུར་གྱི།",
    "དེ་ལྟ་མ་ཡིན་ན་འདི་མ་འབྲེལ་པ་བྲྗོད་པ་ཉིད་ཡིན་པས་རྣ་གཏད་པར་མི་བྱ་བར་འགྱུར་རོ།",
    "གཉི་ག་བསྟན་བཅོས་ལ་མི་བརྟེན་པར་འགའ་ཞིག་ཡོངས་སུ་རྟོག་པ་ན་སྐབས་མ་ཡིན་པ་ཕྱོགས་སུ་བྱེད་པའི་སྐབས་ཅི་ཞིག་ཡོད།",
    "གལ་ཏེ་ཁྱད་པར་གྱི་སྤྱི་འཕེན་པའི་ཕྱིར་དེ་གྲུབ་ན་འདོད་པ་ཉིད་འགྲུབ།",
    "སྤྱི་དོན་དུ་གཉེར་བ་ནི་གདོན་མི་ཟ་བར་སོ་སོར་ངེས་པའི་ཁྱད་པར་དོན་དུ་གཉེར་བར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་གཞན་ལ་རྩོད་པ་མེད་པ་ཡང་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དོན་གཞན་དུ་འགྲོ་བའི་ཕྱིར་ཚར་གཅད་པར་འགྱུར་རོ།་།",
    "བསྟན་པར་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་བསྟན་པར་བྱ་བ་ཡིན་དུ་ཆུག་ན་མངོན་སུམ་གྱི་དོན་དང་།",
    "འགལ་བ་དག་ནི་གཅིག་ལ་ཡང་དག་པའི་ཤེས་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "བདག་གམ་གཞན་དོན་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་བའི་སྒོ་ནས་ངག་འཇུག་པར་འདོད་པ་ནི་ཡིད་ཆེས་པ་ཡིན་ཏེ།",
    "པར་གཞག་པ་དེ་ལ་བརྟེན་པའི་ཕྱིར།",
    "མ་མཐོང་བ་རྟོགས་པར་བྱེད་པའི་བསྟན་བཅོས་ཐམས་ཅད་དེ་སྐད་མ་བྲྗོད་པའི་ཕྱིར་བཀག་པ་ལ་སྐྱོན་ཡོད་པ་མ་ཡིན་ནོ།",
    "གེགས་བྱེད་པར་འགྱུར་རོ།",
    "རྗེས་སུ་དཔག་པ་དང་ལྡན་པ་དོན་ཇི་ལྟ་བ་བཞིན་དུ་འཇུག་པ་ལ་རིགས་པ་མེད་པའི་དམ་བཅས་པས་ཇི་ལྟར་གནོད་པར་འགྱུར།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གནོད་པས་བྱེད་པས་ཁས་བླངས་པས་ན་རྗེས་སུ་དཔག་པ་ལས་ཕྱི་རོལ་ཏུ་གྱུར་པ་མ་ཡིན་ཡང་ཁས་བླངས་པ་ལོགས་ཤིག་ཏུ་བྱས་པ་ནི་ཡུལ་གྱི་དབྱེ་བ་བསྟན་པའི་ཕྱིར་ཏེ།",
    "དེས་ན་དེ་ནི་གནོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དད་པ་དེས་ན་གེགས་བྱེད་པ་ཡིན་གྱི་གནོད་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "སྔ་མས་བཞག་པ་ཕྱི་མས་ཉམས་པར་བྱེད་པའི་ཕྱིར་ཁས་བླངས་པ་དང་འགལ་བ་ཡིན་ནོ།",
    "དེ་ནི་ཕྱོགས་ཁ་ན་མ་ཐོ་བ་མེད་པར་བསྟན་པ་ལ་ཡང་མཚུངས་པའི་ཕྱིར་ཇི་ལྟར་ཕྱོགས་ཀྱི་སྐྱོན་ཡིན་ཞེ་ན།་",
    "གང་ཞིག་ཚིག་ཇི་ཙམ་གྱིས་བསྒྲུབ་པར་བྱ་བ་དེ་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དོན་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པར་རྗོད་པས་སྨྲ་བ་པོ་ལ་ཀླན་ཀར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱིས་དོན་དེ་གཞན་གྱི་ཁ་ནས་རྣམ་པར་གཞག་ནས་ཡང་འགོག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གྲགས་པ་ཡང་འགལ་བའི་དོན་གྱི་དམ་བཅའ་བ་ལ་གནོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྐྱེས་བུའི་འདོད་པ་འདོད་པ་ཙམ་དང་རྗེས་སུ་འབྲེལ་པས་འདོད་པའི་སྒྲས་བྲྗོད་པར་བྱ་བ་ཉིད་ནི་དོན་རྣམས་ལ་དགག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འདོད་པ་ཙམ་གྱིས་འཇུག་པའི་ཕྱིར་ཐམས་ཅད་ངོ་བོ་ཉིད་ཀྱིས་བྱས་པ་དང་མ་བྱས་པའི་སྒྲར་རུང་བ་ཡིན་ལ།",
    "སྐད་དུ་རྗོད་པ་ནི་འདི་དགག་པར་མི་ནུས་པ་ཉིད་དམ།",
    "དེས་ན་སྒྲས་གྲུབ་པ་དག་ནི་མ་གྲུབ་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་སྒྲ་ལས་བྱུང་བའི་གྲགས་པ་དང་ཞེས་གསུངས་སོ།",
    "གེགས་ཡོད་པར་དོགས་པ་རྣམས་ནི་ཐེ་ཚོམ་ཟ་བས་མི་འགྲུབ་པའི་ཕྱིར་ཏེ།",
    "དོན་གྱིས་གོ་བས་རྗེས་སུ་དཔག་པའི་ཡུལ་ལ་འགལ་བ་ལ་མི་འཁྲུལ་བ་ཅན་མེད་པར་སྟོན་པ་ཡིན་ནོ།",
    "མཚན་ཉིད་ཁྱད་པར་མེད་པ་ལ་མཐོང་བ་ནི་གཞན་ལ་ལྡོག་པ་ངེས་པར་བྱེད་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་དེ་ལར་ངེས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་རྗོད་པར་འདོད་པའི་གྲངས་གཅིག་པ་ཅན་ཉིད་ཀྱང་ཡུལ་འདི་ལ་མི་འདོད་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔག་པའི་ཡུལ་ལ་འགལ་བ་མི་འཁྲུལ་བ་ཅན་མེད་པར་སྟོན་པ་ཡིན་ནོ།",
    "ཡང་ན་འཇིག་རྟེན་གྱི་རྗོད་པ་ལ་རྗེས་སུ་དཔག་པ་མེད་པར་རྗོད་པ་ཡིན་ནོ།",
    "དེས་ནི་གྲགས་པ་རྗེས་སུ་དཔག་པ་ལས་ཡུལ་ཐ་དད་པ་ཡིན་ནོ་ཞེས་རྗོད་པར་འགྱུར་རོ།",
    "རི་བོང་ཅན་ཟླ་བར་མི་འདོད་པ་དེ་གྲགས་པ་གཞན་གང་ཞིག་འདོད་པར་འགྱུར་ཏེ།",
    "གྲགས་པས་གྲུབ་པར་ཁས་ལེན་ན་ནི་རི་བོང་ཅན་ལ་ཡང་མི་བཟློག་པའི་ཕྱིར་རོ།",
    "གནོད་པ་མེད་པར་རྗོད་པ་ཡིན།",
    "དེས་ན་ཡུལ་གྱི་ཁྱད་པར་ནི།",
    "ཐ་དད་བྱས་ཡིན་སྔ་མ་ཡིན།",
    "དཔེར་ན་སྒྲ་ནི་མཉན་པར་མི་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "མངོན་སུམ་མིན་པར་གྲུབ་པའི་ཕྱིར།",
    "བརྡེགས་པ་བཟོད་པར་མཐོང་བ་དག་ལས་འཁྲུལ་པས་དེ་ལྟར་འགྱུར་རོ།",
    "དེའི་གནས་སྐབས་མ་ཡིན་པ་ནི་མི་རྟག་པ་ཡིན་པར་སྨྲ་ལ།",
    "དེ་ལ་ཡང་མི་དམིགས་པ་ལས་མ་གཏོགས་པ་རྣམ་པར་གཞག་པའི་རྟེན་གཞན་ནི་འགའ་ཡང་མེད་དོ།",
    "གལ་ཏེ་ཡོད་ན་དབུས་ཀྱི་གནས་སྐབས་བཞིན་དུ་དམིགས་པར་འགྱུར་རོ།",
    "དེ་ལས་སྐྱེས་པས་ནི་རྒྱུ་དེ་དེ་སྐྱེད་པའི་རང་བཞིན་ཡིན་པར་འགྲུབ་ཀྱི།",
    "མེད་པར་ཁྱད་པར་མེད་པ་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་ཅེ་ན།",
    "དེ་ཁོ་ན་ལྟར་དམིགས་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ཡོད་ན་ཡང་བྲྗོད་ཟིན་ཏོ།",
    "ཇི་ལྟར་གཞན་ཡོད་ན་དེ་ཡོད་པར་འགྱུར་ཏེ།",
    "དགོས་པ་མེད་པའི་ཕྱིར་ཉེ་བར་གདགས་པར་མི་བྱའོ་ཞེ་ན།",
    "ཤུགས་ཀྱིས་དོན་གོ་ན་རྟོགས་པར་དཀའ་བ་ཡོངས་སུ་སྤང་བའི་ཡང་ཕྱིར་རོ།",
    "དཔེར་ན་ནག་པ་འཕོང་སྐྱེན་ནོ་ཞེས་བྱ་བ་ལྟ་བུར་མ་འབྲེལ་པ་རྣམ་པར་གཅོད་པས་ཁྱད།",
    "པར་དུ་བྱས་པའི་ཕྱིར་ཏེ།",
    "དེ་ནི་བྲྗོད་པར་འདོད་པའི་བཟློག་པ་ཐམས་ཅད་ལ་མཚུངས་པ་ཡིན་ཏེ།",
    "དངོས་སམ་ཤུགས་ཀྱིས་ལྡོག་པར་རྟོགས་པ་ཐམས་ཅད་ལ་མཚུངས་པའི་ཕྱིར་རོ།་།",
    "མ་འབྲེལ་པ་ལས་རྟོགས་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "གཉིས་ལས་གཅིག་ལ་ཡང་ཡོད་པར་རྟོགས་པའི་སྒྲུབ་པར་བྱེད་པ་མེད་པའི་ཕྱིར་ན་འཇུག་པ་དང་ལྡོག་པ་དག་ལ་ཐེ་ཚོམ་གྱི་རྒྱུ་ཉིད་དེ།",
    "གཏན་ཚིགས་གཉིས་པོ་འདི་གཅིག་ལས་བསྡུས་པས་ནི་རྣམ་པའི་ཁྱད་པར་ཐམས་ཅད་ལ་ཐེ་ཚོམ་ཟ་བ་ཡིན་ནོ།",
    "དེ་ཡང་གཅིག་ཏུ་ངེས་པར་མ་ངེས་པ་ཉིད་ནི་མ་ཡིན་ནོ།",
    "དེས་ངེས་པར་བྲྗོད་པར་བྱ་བའི་ཡོན་ཏན་གཞན་དུ་བྲྗོད་པའི་ཕྱིར་ན་སྐྱོན་ཉིད་དོ།",
    "གང་ཡང་རུང་བ་ལ་མ་གྲུབ་པ་ཡང་སུན་འབྱིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲུབ་པར་བྱེད་པའི་ནུས་པ་བཅོམ་པའི་ཕྱིར་རོ།",
    "གཉི་ག་ལ་གྲུབ་པར་བསྟན་པར་བྱ་བ་གཉི་ག་ལ་མ་གྲུབ་པ་ནི་ཕྱིན་ཅི་ལོག་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་ནི་འདིར་ཡང་ངེས་པར་བསྟན་པར་བྱ་བ་མ་ངེས་པ་ཕྱིན་ཅི་ལོག་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཏན་ཚིགས་དང་འགལ་བ་ཁོ་ན་ངེས་པ་ལས་སྒྲུབ་པ་དང་སུན་འབྱིན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "བྱས་པའི་ཕྱིར་མི་རྟག་གོ།",
    "བྱས་བའི་ཕྱིར་རྟག་གོ།",
    "དབྱེ་བ་ལ་ནི་མཐུན་པའི་ཕྱོགས་ལ་ལྟོས་ནས་ཡོད་པའམ་མེད་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "དགག་པའི་ཡུལ་གཞན་ཡིན་ཡང་སྦྱོར་བ་ནི་རྣམ་པར་ཕྱེ་ནས་འཇུག་པའི་ཕྱིར་རོ།",
    "རྩོད་ཕྱིར་ཁྱད་པར་སྤྱི་དག་སྟེ།",
    "མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་དང་།",
    "འགའ་ཞིག་ཡོད་དུ་ཆུག་ཀྱང་དེའི་བདག་ཉིད་ཉམས་པར་མ།",
    "བྱས་པར་ནུས་པ་བཟློག་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེ་ལ་ཁྱད་པར་སྐྱེ་བ་མེད་པར་ནི་ཅུང་ཟད་བྱེད་པ་ཞེས་བྱ་བ་མ་ཡིན་ནོ།",
    "དེ་དག་ཁྱད་པར་ཅུང་ཟད་བྱེད་པར་ནི་མི་སྨྲའི།་",
    "ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པ་ལྟོས་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ཏེ་ནུས་པའི་རང་བཞིན་རྟག་ཏུ་སྐྱེད་པའམ་མི་སྐྱེ་པར་འགྱུར་རོ།",
    "རྒྱུ་དང་རྐྱེན་གྱི་ནུས་པ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པས་བསམ་གྱིས་མི་ཁྱབ་པའི་ཕྱིར་རོ།",
    "འདིའི་འདི་ཞེས་ཉིད་བར་བསྡུ་བ་ནི་རྣམ་པར་རྟོག་པས་སྤྲུལ་པ་ཉིད་དུ་འགྱུར་གྱི།",
    "མེར་ཉེ་བར་བཏགས་པས་ནི་བྲམ་ཟེའི་ཁྱེའུ་མཚེད་པ་སྒྲུབ་པར་བྱེད་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དེས་ཁྱད་པར་བྱས་པར་རྟོགས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་སྒྲ་རྟག་པ་རྣམས་ནི་འགའ་ཞིག་ཡོད་ན་ཁྱད་པར་ཉམས་པའམ་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "དེ་ལས་ཁྱད་པར་ཐོབ་པ་དག་འབྲས་བུ་ལ་ཉེ་བར་སྦྱོར་བའི་ཕྱིར་རོ།",
    "ལྟོས་པར་བྱ་བའི་རྩོལ་བའམ།",
    "ཕན་འདོགས་པ་མ་ཡིན་པ་ནི་ལྟོས་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་དང་།",
    "དེ་ཤེས་བྱ་མ་ཡིན་པར་ཡང་འགྱུར།",
    "གལ་ཏེ་འགའ་ཞིག་ལ་ནུས་པ་འཐོབ་པ་འམ་ཉམས་པར་མི་འགྱུར་བ་དེ་ལྟ་ན་དེ་རྟག་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེས་ན་དེའི་བདག་ཉིད་ལ་འདི་ཅུང་ཟད་བྱེད་པར་རྟོགས་པ་ཡིན་ཏེ།",
    "དཔེར་བྲྗོད་པ་འདི་ཉིད་ཀྱིས་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་ཀྱི་ཡུལ་བསྟན་པ་ཡིན་ཡང་འབྲས་བུའི་དཔེར་བྲྗོད་པ་ལས་རང་བཞིན་ལོགས་ཤིག་ཏུ་བྱས་པ་ནི་ཐམས་ཅད་དེའི་བདག་ཉིད་དུ་རྟོགས་པར་མི་འགྱུར་བར་བྱས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རྟོགས་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "བློ་སྒྲ་ཐེ་ཚོམ་མེད་པར་འགྱུར།",
    "ཉེ་བར་བྲྗོད་པ་མེད་པར་གྲུབ་པ་དག་ལ་ཐ་སྙད་དེ་རྟོགས་ཀྱང་རྣམ་པ་ཇི་ཞིག་ལྟར་ཡུལ་ཡོད་ན་ཡང་ཡུལ་ཅན་མི་བརྟན་པར་བྱེད་དོ།",
    "དེ་ཡང་འདིས་སྔར་ལན་ཅིག་མ་ཡིན་པར་སྤྱད་ཟིན་པའི་ཕྱིར་རོ།",
    "ཐ་དད་པར་ནི་དཔེར་མ་བྲྗོད།",
    "མི་དམིགས་པ་ལས་ནི་ཁྱད་པར་བྱེད་པའི་རང་བཞིན་མེད་པའི་ཐ་སྙད་དུ་རུང་བ་ཉིད་བསྒྲུབ་བོ།",
    "ཁྱབ་པ་ཡང་གཞན་དུ་ཐ་སྙད་དེ་ཙམ་ལས་གྲུབ་པ་སྟེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "རང་ལས་ཁྱད་པར་ཅན་གྱི་ཤེས་པ་ཡོད་པ་ལས་ཏེ།",
    "འགའ་ཞིག་ཏུ་ཐམས་ཅད་མ་རྟོགས་ན་དངོས་པོ་མེད་པར་མི་རྟོགས་པའི་ཕྱིར་རོ།",
    "མྱོང་བའི་ཁྱད་པར་རྟོགས་པ་ནི་རྣམ་པ་དེ་ལྟ་བུའི་བདག་ཉིད་ཉམས་སུ་མྱོང་བ་ལས་ཡིན་ནོ།",
    "དེས་ན་རང་ཉིད་གྲུབ་པའི་ཁྱད་པར་ནི་དོན་གྱི་དོན་ཁྱད་པར་དུ་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་མྱོང་བའི་ཁྱད་པར་ཡང་མྱོང་བ་གཞན་གྱི་ཁྱད་པར་ལས་ཡིན།",
    "ཐུག་པ་མེད་པར་འགྱུར་བས་ཁྱད་པར་འགའ་ཡང་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "ད་བཞིན་དུ་མྱོང་བ་ན་མྱོང་བ་གཞན་གྱི་ཡོད་པ་དང་ཁྱད་པར་དག་ལས་དེ་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "རང་བཞིན་ཁྱད་པར་ཅན་མྱོང་ལས།",
    "དེ་ལས་ཁྱད་པར་ཅན་དམིགས་ཉིད།",
    "ཞེས་ངེས་པར་བྱེད་པ་ཤུགས་ཀྱིས་གཞན་ནམ་གཞན་མྱོང་བ་མེད་དོ་ཞེས་ངེས་པར་བྱེད་དོ།",
    "གལ་ཏེ་རང་ལས་ཁྱད་པར་ཅན་གྱི་ཤེས་པ་མེད་ཀྱང་མེད་པའི་བློར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "ངའི་ལག་པ་བྱུགས་སོ་ཞེས་བྱ་བར་འགྱུར་བ་དེ་ཉིད་ལས་མེད་པར་རྟོགས་པ་ཡིན་ཏེ།",
    "དེ་མེད་ན་མེད་པར་མི་རྟོགས་པའི་ཕྱིར་རོ།",
    "རྐྱེན་རྣམས་ཡོད་པ་ན་དམིགས་སུ་རུང་བ་མ་དམིགས་པས་མེད་པར་འགྲུབ་བོ།",
    "དེའི་ཕྱིར་གཉིད་ལོག་པ་ལ་སོགས་པའི་གནས་སྐབས་སུ་འགའ་ཞིག་མེད་པར་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "དེས་ན་ཁྱད་པར་ཅན་གྱི་དམིགས་པ་མེད་པའི་ཕྱིར་ན་དེར་འགའ་ཡང་མེད་པར་རྟོགས་པ་ནི་མ་ཡིན་ནོ།",
    "དམིགས་སུ་རུང་བ་མ་དམིགས་པས་ཀྱང་ཁྱད་པར་ཅན་དམིགས་པ་དེ་ཉིད་ཀྱི་རྣམ་པ་གཅིག་ཏུ་ངེས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཁྱད་པར་ཅན་དམིགས་པ་དེ་ཉིད་གཞན་མི་དམིགས་པ་ཡིན་ནོ།་།",
    "མི་དམིགས་པ་ལས་རྟོགས་པར་འགྱུར།་།",
    "མྱོང་བ་ནི་བདག་ཉིད་ཀྱི་ཁྱད་པར་ལ་སྒྲུབ་པར་བྱེད་པ་གཞན་མེད་པ་ཡིན་གྱི།",
    "རང་ལས་ཁྱད་པར་ཅན་གྱི་ཤེས་པ་ཡོད་པ་ལས་ཀྱང་མ་ཡིན་ནོ།",
    "ལྟོས་པ་ནི་ཁྱད་པར་ཐོབ་པའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་དང་།",
    "དེ་ཡང་དངོས་པོའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་དངོས་པོ་མེད་པར་མི་འགྱུར་རོ།",
    "དེས་ན་དངོས་པོ་མེད་པ་ལས་སྐྱེའོ་ཞེས་བྱ་བས་ནི་དངོས་པོ་ལས་མི་སྐྱེའོ་ཞེས་རྒྱུ་བཀག་པ་བྱས་པར་འགྱུར་རོ།་།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་དངོས་པོ་མེད་པ་ཞེས་དངོས་པོ་མེད་པ་ཞེས་དངོས་པོ་ཉིད་འགའ་ཞིག་མིང་གཞན་གྱིས་བྲྗོད་པར་འགྱུར་རོ།",
    "དགག་པ་རྣམ་པར་རྟོག་པར་འགྱུར་བ་དེ་ལྟར་སྐྱེས་པ་དེ་ནི་མཐོང་བ་ཉིད་ཡིན་ནོ།",
    "ལྡོག་པ་སྒྲུབ་པར་ནུས་མ་ཡིན།",
    "ཡང་ན་དགག་པར་བྱ་བའི་དོན་ལ་གནོད་པར་བྱེད་པའི་ངོ་བོ་ཉེ་བར་བཀོད་པའི་སྒོ་ནས་རབ་ཏུ་སྦྱོར་ཏེ།",
    "དེའི་ངོ་བོར་འགྱུར་བ་གཞན་ལ་ལྟོས་པར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་གང་ངོ་བོར་འགྱུར་བ་གཞན་ལ་ལྟོས་པར་ཁས་བླངས་པ་དེ་ནི་དེའི་ངོ་བོར་ངེས་པར་འགྱུར་བ་མ་ཡིན་ཏེ།་",
    "དེ་དག་ཚང་བ་དང་གེགས་མེད་པར་མ་ངེས་པའི་ཕྱིར།",
    "མི་དམིགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དེ་ལ་ཇི་ལྟར་མེད་པའི་ཐ་སྙད་བསྒྲུབ་པའམ་ཡོད་པའི་ཐ་སྙད་བཀག་པར་འགྱུར།",
    "རྣམ་པར་རྟོག་པས་ཡོངས་བསྒྲུབ་པ།",
    "དེ་དངོས་ཉེར་ལེན་ཅན་མིན་པར།",
    "དེ་ནི་འཆད་པ་པོ་དང་ཉན་པ་པོའི་རྣམ་པར་རྟོག་པ་བསྟན་པ་ཡིན་ཏེ།",
    "ཇི་ལྟར་སྣང་བའི་དངོས་པོ་བསྟན་པར་འདོད་པས་སྦྱོར་བའི་ཕྱིར་དང་།",
    "དེའི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "པའི་རང་བཞིན་ནི་དེའི་ཡུལ་ཉིད་དུ་ངེས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་མ་ཡིན་ཞེས་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་སེམས་པར་བྱེད་དོ།",
    "འདིར་སྒྲའི་རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་དོན་དེ་ཉིད་ལ་བསྙེན་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཐམས་ཅད་ཀྱི་ཚེ་འདི་ཡོད་པ་དང་མེད་པར་སྤྱོད་པ་འཇུག་པ་ན་རྣམ་པར་རྟོག་པའི་སྣང་བ་སྤངས་ཏེ་གང་ལ་སྐྱེས་བུའི་དོན་འདི་འབྲེལ་པ་དངོས་པོ་ཉིད་ལ་གནས་པར་བྱེད་དེ།",
    "དེ་ཡང་འཇིགས་པ་ལ་བྱས་པ་དང་ཡོད་པ་ཉིད་བཞིན་དུ་ཁྱད་པར་གྱི་བྱེ་བྲག་ལ་ལྟོས་པའམ་འབའ་ཞིག་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྲྗོད་ཟིན་ཏོ།",
    "གལ་ཏེ་ཡོད་པའི་མི་རྟག་པ་ཉིད་དམ་གཞན་ལ་གཏན་ཚིགས་ཡིན་ན་བསྒྲུབ་པར་བྱ་བར་ཡང་ཅི་སྟེ་མི་འདོད།",
    "དེ་དེ་ལྟར་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་ཁྱད་པར་ཅན་དུ་འགྱུར་ན།",
    "ཁྱད་པར་ནི་བསྒྲུབ་པར་ནུས་པ་མ་ཡིན་ཏེ།་",
    "ཁྱད་པར་དེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འགལ་བར་ནི་མ་ཟད་དོ།",
    "དངོས་པོའི་ཁྱད་པར་ཙམ་ཞིག་ནི།",
    "ཐམས་ཅད་དུ་ཡོད་པ་བསྒྲུབས་ན་ཁྱད་པར་བསྒྲུབ་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཁྱད་པར་གྱིས་ཟིན་པ་ཉིད་འདིས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "ཁྱད་པར་གྱིས་ཟིན་བསྒྲུབ་བྱ་འདིར།",
    "གཏན་ཚིགས་རྗེས་འགྲོ་མེད་པར་འགྱུར།",
    "ཁྱད་པར་བསྒྲུབ་བྱར་འགྱུར་བ་ཡིན།",
    "གཞི་དེས་དེ་ཁྱད་པར་དུ་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "མི་ལྡན་པ་རྣམ་པར་གཅོད་པས་ཁྱད་པར་དུ་བྱས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེར་ནི་དེ་དང་མི་ལྡན་པ་རྣམ་པར་གཅད་པས་སྤྱི་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "གཙོ་བོ་ལ་སོགས་པའི་སྒྲས་བྲྗོད་པར་བྱ་བའི་དེན་ཉིད་འགའ་ཡང་མེད་པའི་ཕྱིར།་",
    "དེ་ནི་ཁྱད་པར་མེད་པ་ཁོ་ན་ཡིན་ནོ།",
    "ཅི་ད་ནི་ཤེས་བྱ་ཡོད་དོ་ཞེས་ཏེ་དེ་བསྒྲུབ་པར་འགྱུར་རམ།",
    "དེ་ལྟ་ན་ཡང་ཅི་ཞིག་འགྲུབ་པར་འགྱུར།",
    "གལ་ཏེ་བློས་བསྐྱེད་པ་རྣམ་པར་རྟོག་པ་ལ་སྣང་བ་ནི་སྒྲའི་དོན་ཡིན་ལ།",
    "འོན་ཀྱང་གཙོ་བོ་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱི་ཁྱད་པར་གྱི་རྟེན་མ་ཡིན་པས་ན་དེ་ཡང་སྒྲའི་དོན་ཙམ་དུ་རྣམ་པར་གནས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་དང་སྔ་མ་བཞིན་དུ་བྲྗོད་པར་བྱ་བ་འགའ་ཞིག་ཡོད་དོ་ཞེས་བསྒྲུབ་པར་བྱ་བར་འགྱུར་རོ།",
    "སྒྲའི་དོན་རང་ཉིད་ནི་ཡོན་ཏན་གྱི་ཁྱད་པར་འགའ་ཞིག་ལ་བརྟེན་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་འདི་དག་ནི་ཁྱད་པར་མེད་པ་ཡིན་པས་དེ་དག་ལ་དོན་གྱི་ཉེ་བར་ལེན་པ་ཅན་ཉིད་སྒྲུབ་པ་ནི་དོན་ཡོད་པ་ཙམ་ཉིད་བསྒྲུབ་པ་ཡིན།",
    "ཁྱད་པར་སྒྲུབ་པ་ནི་མ་ཡིན་པའི་ཕྱིར་དོན་མེད་དོ།",
    "གཞན་དུ་ནི་མེའི་སྤྱི་དེ་ཉིད་དེར་མ་གྲུབ་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་མེ་ཙམ་གྱིས་ཁྱབ་པ་གྲུབ་པ་དེ་ནི་གང་དུ་རང་ཉིད་སྣང་བ་དེ་ཉིད་དུ་མེའི་བློ་སྐྱེད་པར་བྱེད་དོ།་།",
    "དེ་ལ་བསྒྲུབ་པར་བྱ་བ་བསྟན་པས་ནི་ཅི་ཡང་མི་དགོས་ཏེ།",
    "དེ་ལ་མ་བསྟན་ན་ཡང་ཇི་ལྟར་དེའི་ཁྱད་པར་ཅན་གྱི་རྗེས་སུ་འགྲོ་བ་ཡིན།",
    "དུ་འགྲོ་བ་ཅན་ཡིན་ན་ཡང་དམ་བཅའ་བ་སྒྲུབ་པར་བྱེད་པ་ལས་སུས་ཟློག་པར་བྱེད།",
    "གཞན་དུ་བསྟན་པར་བྱ་བ་སྟེ།",
    "དེ་ལ་རབ་གྲུབ་དེ་ལྡན་པར།",
    "དེ་ཡི་ཁྱད་པར་གཟུང་མེད་པར།",
    "ཡོད་པ་ཙམ་ལ་བརྟེན་ན་ཡང་སྒྲུབ་པར་བྱེད་པའི་ནུས་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "ཡོད་པ་བསྒྲུབ་པར་བྱ་བ་ལ་དེའི་གཏན་ཚིགས་ཐམས་ཅད་སྐྱོན་གྱི་རིགས་གསུམ་ལས་མི་འདའ་སྟེ།",
    "གལ་ཏེ་དགག་པ་ནི་ཡོངས་སུ་ཆད་པ་ཁོ་ན་ལ་གནས་པར་འདོད་པ་དེའི་ཕྱིར་ཉེ་བར་བྲྗོད་པ་མེད་པ་ལ་ནི་ལུས་ཅན་ཉིད་མ་ཡིན་པ་ལ་སོགས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ན་དེ་རྣམ་པར་བཅད་པ་ཙམ་དེ་ནི་གཉི་ག་ལ་ཡང་ཡོད།",
    "བསྒྲུབ་པར་བྱ་བ་མེད་པའོ།",
    "ཕྱོགས་ཀྱི་རྣམ་པར་དབྱེ་བ་ལ་ལྟོས་པ་ནི་མ་ཡིན་ཏེ།་"
