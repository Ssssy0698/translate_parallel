    "འོ་ན་ནི་རྣམ་པར་རོག་པ་མེད་འི་ཕྱིར་གསལ་བར་སྣང་བའི་རི་ལམ་གི་ཤེས་པ་མངོན་སུམ་དུ་འགྱུར་རོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "འོ་ན་རྣམ་ངེས་སུ་མངོན་སུམ་གི་མཚན་཈ིད་བསན་པ་དང་འདིར་མངོན་སུམ་གི་མཚན་཈ིད་བསན་པའི་ཚུལ་ལ་ཁད་པར་ཅི་ཡོད་ཅེ་ན།",
    "འོ་ན་རྣམ་ངེས་སུ་མངོན་སུམ་གི་མཚན་཈ིད་བསན་པ་དང་འདིར་མངོན་སུམ་གི་མཚན་཈ིད་བསན་པའི་ཚུལ་ལ་ཁད་པར་ཅི་ཡོད་ཅེ་ན།",
    "མཚོན་བྱ་གྲུབ་ཟིན་རེས་སུ་བརོད་ནས་མཚན་཈ིད་གཟུང་ཡུལ་ལ་མ་འཁྲུལ་བ་སྒྲུབ་པར་བྱེད་པ་སྒྲུབ་པའི་སྒྲས་བསན་པ་ཡིན་ནོ།",
    "རོག་པ་མ་ཡིན་ཞིང་རང་གི་གཟུང་ཡུལ་ལ་མ་འཁྲུལ་བའི་ཤེས་པ་མངོན་སུམ་གི་མཚན་཈ིད་དུ་འཇོག་པ་ལྟར་ན།",
    "འདོད་རྒྱལ་བའི་སྒྲ་རྣམས་ལ་མིང་གིས་ཁད་པར་དུ་བྱས་ནས་དོན་བརོད་པར་བྱེད་དེ།",
    "ཕྱི་མ་གཞན་གིས་བརགས་པ་ངོས་བཟུང་ནས་དེ་མ་ཡིན་པར་སོན་པའོ།",
    "གཞན་གིས་བརགས་པའི་རོག་པའི་རེན་ནི་དུ་མ་ཡོད་དེ།",
    "ཡོན་ཏན་གི་སྒྲ་བ་གླང་དཀར་པོ་ཞེས་བྱ་བ་དང་།",
    "སྒྲ་མི་རག་པར་རོགས་པའི་རེས་དཔག་དོན་སྦྱོར་རོག་པ་མ་ཡིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གཞུང་གི་སྒྲ་ཅི་བཞིན་པ་ལ་དེ་ལྟར་ཡིན་པའི་ཕྱིར།",
    "རོག་པ་གཞི་མ་གྲུབ་པར་ཐལ།",
    "ཡིད་མངོན་གཟུང་དོན་གི་སོ་ནས་དང་།",
    "རོག་པ་མ་ཡིན་པ་མངོན་སུམ་གི་མཚན་཈ིད་ཀི་ཟུར་དུ་སོས་པ་ལ་ལུང་འགལ་སྤང་བ་དང་།",
    "རྔ་དེ་དེའི་ཐུན་མོང་མིན་པའི་རྒྱུ་ཡིན་པས་དེའི་སོ་ནས་ཐ་སྙད་བྱས་པས་དེ་ཐུན་མོང་མིན་པར་གོ་ནུས་པའི་ཕྱིར་དང་།",
    "མིང་དེ་ཐུན་མོང་མིན་པར་གོ་བར་ནུས་པའི་ཕྱིར།",
    "དེ་ལ་བརེན་ནས་ཐུན་མོང་མིན་པར་གོ་མི་ནུས་ཀུན་བཏུས་རབ་བྱེད་རྒྱན།",
    "དབྱུ་གུ་ནི་ཟངས་ལ་སོགས་པ་གཞན་དང་ཐུན་མོང་བ་ཡིན་ལ་དབྱུ་གུའི་སྒྲ་ཞེས་སོས་ན་ཅི་རྔ་ལ་བརེན་པ་ཡིན་ནམ་ཟངས་ལ་སོགས་པ་གཞན་ལ་བརེན་པ་ཡིན་སྙམ་དུ་རེ་བ་དང་བཅས་པར་འགྱུར་གི་བདེ་བག་ཏུ་མི་གོ་བའི་ཕྱིར་ཞེ་ན།",
    "མིང་དེས་ཐུན་མོང་མིན་པར་གོ་ནུས་པའི་ཕྱིར།",
    "དེ་ལ་བརེན་ནས་ཐུན་མོང་མིན་པར་གོ་མི་ནུས་པའི་ཕྱིར།",
    "ཡུལ་རྣམས་ནི་རྒྱུ་གཞན་དང་ཐུན་མོང་བ་ཡིན་ལ།",
    "ཡུལ་ཤེས་ཅེས་སོས་ན་ཅི་མིག་ལ་བརེན་པ་ཡིན་ནམ་ཡིད་ལ་བརེན་པ་ཡིན་སྙམ་དུ་རེ་བ་དང་བཅས་པར་འགྱུར་གི་བདེ་བག་ཏུ་གོ་བར་མི་ནུས་པའི་ཕྱིར།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དང་ལྡན་པས་སོན་པོ་ཤེས་ཀི་སོན་པོའོ་སྙམ་དུ་ནི་མ་ཡིན་ནོ།",
    "ཞེས་པའི་ཚིག་ས་མ་ག་཈ིས་ཀིས་རང་མཚན་རང་གི་གཟུང་ཡུལ་དུ་བྱེད་པའི་མ་འཁྲུལ་བའི་ཤེས་པར་བསན་པ་ཡིན་ནོ།",
    "སློབ་དཔོན་དབྱིག་ག་཈ེན་གིས་གང་ཡང་སྐྱེ་ཆེད་ཀི་རང་གི་མཚན་཈ིད་ལ་སོ་སོ་རང་གི་མཚན་཈ིད་ཀི་ཡུལ་ཅན་ཡིན་གི།",
    "རས་ཀི་རང་གི་མཚན་཈ིད་ལ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་དང་འགལ་སེ།",
    "རང་གཟུང་ཡུལ་དུ་བསགས་པའི་རས་རང་གི་གཟུང་ཡུལ་དུ་བྱེད་ན་སི་དོན་གཞན་རང་གི་གཟུང་ཡུལ་དུ་བྱེད་པས་མ་ཁབ་པར་ཐལ།",
    "སི་དོན་གཞན་གཅིག་རང་གི་གཟུང་ཡུལ་དུ་བྱེད་པ་མིན་གི་རང་གི་གཟུང་དོན་བསགས་པའི་རས་ཀིས་རང་འདྲའི་རྣམ་པ་གཏད་པའི་སོ་ནས་བསྐྱེད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "གཅིག་མིན་དོན་གིས་བསྐྱེད་བྱའི་ཕྱིར།",
    "རོག་པས་བཏགས་པ་ཙམ་རང་གི་གཟུང་ཡུལ་དུ་མི་བྱེད་ཀང་རང་གི་གཟུང་ཡུལ་མེད་པ་མ་ཡིན་སེ།",
    "རང་རང་གིས་གཞན་དང་མི་འདྲེས་པར་རིག་པར་བྱ་བ་མིང་གི་ཐ་སྙད་ཀིས་དོན་དམ་པར་བསན་པར་མི་ནུས་ཅིང་བསན་པར་བྱ་བ་མིན་པའི་ངོ་བོ་཈ིད་རང་མཚན་པའི་སྒྲ་རང་གི་གཟུང་ཡུལ་དུ་བྱེད་པའི་ཕྱིར།",
    "ལས་སྐྱེས་པའི་མངོན་སུམ་གི་ཤེས་པ་རོག་པ་མེད་པ་ཡིན་ཡང་ཞེས་སོགས་གསུངས་པ་མངོན་སུམ་གི་མཚན་཈ིད་སོན་པའི་ཚིག་གིས་རོག་པ་མ་ཡིན་པར་བསན་ཟིན་ཡང་འདིར་སོས་པ་ནི་གཞན་གི་ལོག་རོག་དང་དགག་པའི་ཁད་པར་ལ་ལྟོས་པ་ཡིན་ཏེ།",
    "རང་གི་བདག་རེན་དང་དེ་མ་ཐག་པའི་རེན་དང་གཟུང་དོན་དང་ལྡན་པའི་ཕྱིར།",
    "གཞུང་གི་དོན་ནོ།",
    "ཁ་ཅིག་ན་རེ།",
    "ལོག་པའི་ཤེས་པ་མི་སིད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "མཁས་པ་ཆེན་པོའི་གསུང་ལ་བདག་ལྟ་བུས་཈ེས་པ་བརོད་པ་མི་རིགས་ཀང་མཁས་མཆོག་ས་མ་གཞན་གི་རིགས་པའི་ལམ་ལ་བརེན་ནས་དགག་སྒྲུབ་བྱེད་ན་཈ེས་པ་མེད་པར་མཐོང་སེ།",
    "འཛིན་རྣམ་ནི་རང་རིག་གི་འཇོག་བྱེད་ཡིན་པའི་ཕྱིར།",
    "འོ་ན་འཛིན་རྣམ་ཡང་རང་རིག་གི་འཇོག་བྱེད་དུ་འགྱུར་ཏེ།",
    "རེས་དཔག་ཀང་མངོན་སུམ་ཡིན་ནོ།",
    "རེས་དཔག་རང་གི་གཟུང་ཡུལ་ལ་མ་འཁྲུལ་བར་འགྱུར་ཏེ།",
