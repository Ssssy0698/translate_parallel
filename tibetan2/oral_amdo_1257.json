    "དེའི་ཕྱིར་གཟའ་དགུ་པོ་རྣམས་ཀྱི་དཔྱད་ར་༢ནི་ད་གེ་སྦྱོང་གིས་མི་བྱའོ།",
    "ཉོན་མོངས་པ་རྣམས་སྤོང་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "དགེ་སྦྱོང་༢ངན་པ་དགེ་སྦྱོང་དུ་ཁས་འཆེས་པས་དེ་དག་རྣམས་མ་རྩེས་༤པར་ཀུན་ནས་ཉོན་མོངས་པར་གྱུར་པ་གཞན་རྣམས་དཔྱོད་པར་བྱེད་དོ།",
    "དེ་དག་རྣམས་མྱ་ངན་ལས་འདའ་བར་འགྱུར་བའི་དགོས་༧པ་དང་བཅས་པས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་ཉེ་བར་འཚེ་བ་དང་བཅས་པར་གྱུར་པའི་སུམ་ཅུ་རྩ་དྲུག་གིས་ལུས་དཔྱོད་པར་མི་བྱེད་དོ།",
    "ལུང་དུ་མ་བསྟན་པ་ལ་དམིགས་པའི་བད་ག་གི་སེམས་ཆེ་གེ་མོ་ཅིག་སྐྱེས་པར་གྱུར་ཏེ།",
    "ངན་པ་དགེ་སྦྱོང་གི་གཟུགས་བརྙ་ན་དེ་འཇིག་རྟེན་པའི་ལམ་གྱིས་སྐད་ཅིག་དང་།",
    "བསམ་གཏ་ན་བྱེད་པ་ན་བར་དུ་གཅོད་པར་གྱུར་པ་འཇིག་རྟེན་པའི་༨རིམ་པ་གཞན་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་རྣམས་ཀྱིས་ཀྱང་རྒྱུ་སྐར་གྱི་དཔྱད་ར་རྣམས་དཔྱོད་པར་བྱེད་ད་དོ།",
    "ཇི་ལྟར་རྒྱུ་སྐར་ཆེ་གེ་མོ་གཟའ་ཆེ་གེ་མོས་༢ཉེ་བར་གཟིར་བར་གྱུར་ནས་མནར་བར་བྱེད་དོ།",
    "ལང་ཚོའི་རྒྱུ་སྐར་རྣམས་ནི་རྒས་པའི་གཟའ་རྣམས་ཀྱིས་ཉེ་བར་འཛིན་ནོ།",
    "མི་ད་གེ་བའི་སེམས་བསྐྱེད་པའི་གཟའ་རྣམས་ཀྱིས་ཉེ་བར་ཟིན་ནོ་༡༢། མི་སྡུག་པའི་རྒྱུ་སྐར་རྣམས་ནི་ཞེ་སྡང་གི་གཟའ་རྣམས་ཀྱིས་ཉེ་བར་ཟིན་ནོ་༡༢། ཤེས་པའི་རྒྱུ་སྐར་རྣམས་༡༢ནི་གཏི་མུག་གི་གཟའ་རྣམས་ཀྱིས་ཉེ་བར་ཟིན་ན་ནོ་། དགེ་སྦྱོང་ངན་པ་དགེ་སྦྱོང་དུ་ཁས་འཆེས་པར་གྱུར་པ་དེ་རང་ཉིད་ཀྱི་༨ བཀའའགྱུར།",
    "དུས་དཔྱོད་པ་ཡང་རང་བཞིན་ཇི་ལྟ་བུ་མ་ཡིན་པའི་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་གྱི་ཤེས་པ་རྣམས་དང་བདེ་བའི་མཐར་ཐུག་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་པ་ཀུན་ནས་ཉོན་མོངས་པ་འདོད་ཆགས་དང་།",
    "དེ་དག་གི་རྩ་བ་ལས་ནི་༩གཏི་མུག་ཡིན་པས་སྐྱོན་གསུམ་པོ་འདིས་གཡོགས་༡པར་གྱུར་པ་དེ་ནི་དགེ་སྦྱོང་མ་ཡིན་ལ་ཁྱིམ་པ་ཡང་མ་ཡིན་ནོ།",
    "འདི་དག་ནི་ཀུན་ན་ས་ཉོན་མོངས་པ་ཡིན་ནོ།",
    "གཏི་མུག་གིས་རབ་ཏུ་གཡོ་བར་བྱེད་དེ།",
    "ཕྱོགས་རྣམས་དངསཔ་དང་ལྡན་པ་དང་མཛེས་པ་དག་གིས་གཡས་ཕྱོགས་ནས་བསྐོར་བར་འགྱུར་བ་མཐོང་ངོ།",
    "སྐྱ་རེངས་དམར་པོ་དེའི་ཀུན་དུ་ཆ་བྱད་༢ཀྱིས་ཉི་མ་ནམ་མཁའ་ལ་ཤར་ནས་གནས་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་མཁྱེན་པར་ཁས་འཆེས་པའི་དགེ་སྦྱོང་ངན་པ་དང་བྲམ་ཟེའི་ཆ་བྱད་ཅན་རྣམས་ཀྱིས་སྡུག་བསྔལ་བར་བྱས་པར་གྱུར་ཏ་ར་ཏ་རེ།",
    "རང་གི་ཁྱིམ་ནི་ཡོངས་སྤངས་ནས།",
    "དེ་ནི་རྒོད་དང་ཡང་མོར་འགྱུར་། ནོར་མེད་པར་ཡང་མྱུར་དུ་འགྱུར།",
    "གང་ཡང་ཚོགས་པ་རྣམ་༡༢སྤངས་ཤིང་།",
    "མཚན་མོ་གསུམ་གནས་གཅིག་པུ་གནས།",
    "དགེ་སློང་གི་རྟགས་འབའ་ཞིག་འཛིན་པར་གྱུར་པ།",
    "དགེ་སློང་དུས་གཅིག་ཏུ་བདག་གིས་དགེ་སློང་གཞན་དང་ངང་མ།",
    "བསོད་སྙོམས་པ་རྣམས་ཀྱིས་ཀྱང་གཞན་སྦྱིན་པར་བྱེད་པ་རྣམས་དང་བྲལ་༡༧བར་གྱུར་ནས་ཡང་དེ་དག་ལ་མའམ་སྲིང་མོ་ཞེས་བྱ་སྟེ།",
    "རང་གི་རྐང་རྩེ་གཉིས་ལ་མིག་ཕབ་སྟེའོ།",
    "དགེ་སློང་གིས་༡བུད་མེད་དེ་དག་རྣམས་ལ་བལྟ་༢བར་ཡང་མི་བྱའོ།",
    "བུད་མེད་ལྟ་བས་ཀུན་བསླང་བའི།",
    "བུ་དང་བུ་མོ་རྣམས་བལྟ་བ་དང་།",
    "རྩོམ་པ་དེ་དག་གིས་བརྣབ་སེམས་མང་བ་༡རྣམ་པར་རྒྱུ་བར་འགྱུར་རོ།",
    "དགེ་སྦྱོང་ངན་པ་དེའི་ཐོས་པ་ཐམས་ཅད་ཀྱང་ངན་པས་ཉིན་མོ་བདེ་བར་གནས་པ་མ་ཡིན་ཞིང་མཚན་མོ་ཡང་མ་ཡིན་ནོ།",
    "ཇི་ལྟ་ཇི་ལྟར་བདག་གི་འདི་དག་རྣམས་ཀྱིས་དགེ་སློང་གང་དེའི་རྙེད་པ་དང་བཀུར་སྟི་དེ་རྣམས་བདག་ལ་འགྱུར་རོ།",
    "མཚན་མོར་མ་ཡིན་པ་དང་།",
    "ངག་གིས་མཚོན་ནི་བྱེད་པ་པོ།",
    "སྐབས་མིན་བར་ནི་ཡང་མོར་འགྲོ།",
    "དེ་ལྟར་གྱུར་པ་ནི་ཕྱོགས་གཅིག་གིས་འཇིགས་པ་ཡིན་ནོ།",
    "གཞན་ཡང་སྡུག་བསྔལ་རྣམས་མཐོང་བར་གྱུར་པས་དགེ་སྦྱོང་གི་༡ད་ངོས་པོར་འགྱུར་བ་རྣམས་གང་དག་ཅེ་ན།",
    "གཟུགས་ཀྱི་ཁམས་དང་གཉིས་ན་ཡོད་པ་ཡིན་ལ་༢གང་གི་ཕྱིར་གང་ན་༢ལུས་ཡོད་པ་དེ་ནི་ཚོར་བའོ།",
    "དེ་ལ་ཀུན་ན་ས་སློང་བ་པོའི་ཚོར་བ་ཇི་ལྟར་གཟུགས་ཀྱི་ཁམས་ན་ཡོད་ན་སྡུག་བསྔལ་ནི་གང་གི་ཚེ་བསམ་གཏན་གྱིས་དུབ་༤པར་གྱུར་༐",
    "ལུས་ཀྱང་ཉོན་མོངས་པར་འགྱུར་རོ།",
    "དེས་རེག་པར་གྱུར་པས་ཀྱང་སྔོན་མེད་པའི་ཚོར་བ་རྣམས་འདིའི་ལུས་ལ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་མ་གཏོགས་༐",
    "རྩེ་མོ་ནས་རྩེ་མོ་དང་།",
    "གང་དག་གི་དོན་དུ་རབ་ཏུ་བྱུང་བའི་ཁམས་དེ་དག་རྣམས་ནི་བོར་བར་གྱུར་ནས་ཀྱང་ཁམས་གཞན་དག་རྣམས་དཔྱོད་པར་བྱེད་དོ།",
    "དབྱིག་གི་ཁམས་ནི་དེ་བཞིན་དུ།",
    "ཉོན་མོངས་རི་བོས་སྲེག་པར་བྱེད།",
    "སྤྱད་པ་༡༢རྣམས་དོན་མེད་པར་ཉོན་མོངས་པར་འགྱུར་རོ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་ཡུལ་ལྔ་པོ་སྒྲ་དང་།",
    "རེག་བྱ་དང་།",
    "བུད་མེད་ལ་ད་ད་ཆེ་བ་དང་མ་ཡིན་ཉོ་ཚོང་གིས་ཉེ་བར་འཚོ་བ་དང་མ་ཡིན།",
    "ལམ་དུ་འགྲོགས་པ་ཡང་དགེ་སློང་གིས་མི་བྱའོ།",
    "རྣམ་པར་དག་པའི་སྐྱེས་བུ་ལ་ཡང་གང་གི་ཕྱིར་གཞན་གྱི་སྐྱོན་རྣམས་སྲིད་པར་འགྱུར་བར་སྐྱེ་བོ་མང་པོ་དོགས་༡ཏེ།",
    "ལྷ་དང་ལྷ་མོས་ཡང་སྟེན་༧གང་།",
    "སྲུང་གིས་༧ཚིགས་སུ་བཅད་པ་གསུངས་པ།",
    "དེ་ལྟར་ཡེ་ཤེས་ཀྱི་རྒྱལ་པོ་དགེ་སློང་གིས་བསྟེན་པར་བྱའི་ཐ་མལ་པ་ནི་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཡུལ་ལྗོངས་རྣམས་སུ་ཚོགས་པ་འདུ་བར་བྱེད་པ་པོ་རང་གི་སྐྱེ་བོ་རྣམས་ལྟ་བ་ལ་དགའ་བར་གྱུར་པ།",
    "རང་༦གི་སྐྱེ་བོ་རྣམས་ཀྱིས་༧ཕེའུ་འདེབས་ས་སོ་། དེ་རོ་ལ་སྲེད་པར་གྱུར་པས་གང་དག་རྣམས་ལ་གང་དང་ཅི་ཡང་རུང་སྟེ།",
    "༣༥ེ་༢༧ལྗོངས་རྒྱུ་བར་བྱེད་པས་རྒྱུ་བར་གྱུར་པ་ན་རང་གི་དོན་ལས་ཡོངས་སུ་ཉམས་པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་གཞན་༡དག་གི་ཡུལ་འཁོར་རྣམས་འཇོམས་པར་བྱེད་པའམ།",
    "དེ་དག་གི་རྩ་བ་ལས་གྱུར་པའི་ཉོན་མོངས་པ་རྣམས་བག་ལ་ཉལ་དང་བཅས་ན་ས་རྩ་བ་ན་ས་བཅད་ནས་འདོན་པར་བྱའོ།",
    "ཟས་འབའ་ཞིག་གི་བློ་དང་ལྡན།",
    "འདི་ཡིད་རྟག་ཏུ་དེ་ལ་སོང་།",
    "གང་གི་ཡེ་ཤེས་མར་མེ་ཡིས།",
    "དེའི་ཕྱིར་ཡོན་ཏན་དེ་དག་རྣམས་མཉན་༡༢ལ་དགེ་སློང་གིས་བརྐམ་ཞིང་ཆ་གས་པར་མི་བྱའོ།",
    "གལ་ཏེ་བདག་དགེ་སློང་དེ་དག་དང་སྨྲས་པར་གྱུར་ན་འདི་དག་གིས་ཇི་ལྟ་བར་ཉེ་བར་བསྟན་པས་བདག་ཟིལ་གྱིས་གནོན་པར་འགྱུར་རོ།",
    "གང་གི་ཚེ་དགེ་སློང་རབ་ཏུ་བྱུང་བར་གྱུར་པ་དེའི་ཚེ།",
    "དམིགས་པ་ཡང་ཇི་ལྟ་བུར་ཡིད་ལ་བྱ་བ་ཡིན་རྣམ་པ་གང་དག་གིས་དམིགས་པ་ལས་ཉམས་པར་འགྱུར་བ་ཡིན།",
    "སྐྱིལ་མོ་ཀྲུང་ལས་ལྡང་བར་གྱུར་ནས་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "ཇི་ལྟར་བདག་གིས་ཁེངས་པར་བྱས་པ་དེ་དག་རྣམས་ནི་དོན་མེད་དོ་ཞེས་སྐྱོ་བ་སྐྱེ་བར་གྱུར་ན་ས་༐",
    "གང་གི་ཚེ་གྲོགས་པོ་མང་པོ་ཡོད་པར་གྱུར་པ་དེའི་ཚེ།",
    "གང་གི་ཚེ་ལེ་ལོ་ཅན་མིང་ཙམ་གྱི་དགེ་སློང་དུ་གྱུར་ནས་གཞན་གྱི་ཁྱིམ་རྣམས་སུ་རྗེས་སུ་རྒྱུ་བར་བྱེད་པ་ཡིན་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ཞི་བར་མི་༧འགྱུར་རོ།",
    "གང་གི་ཚེ་གྲོགས་པོ་དེ་དག་ལ་ལྟ་བར་བྱེད་པ་དེས་ནི་༩ད་མིགས་པའི་བར་དུ་གཅོད་པར་བྱེད་པར་འགྱུར་རོ།",
    "དགེ་སློང་གིས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་གྱི་སྲེདཔ་རྣམས་འཕེལ་བར་བྱེད་པ་པོའི་ཁྱིམ་པའི་གྲོགས་པོ་མི་བྱའོ།",
    "གང་༡དག་དོན་དམ་པ་མ་ཡིན་པ་དེ་དག་གིས་ནི་གྲོགས་པོར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "༤ ༥ི་༧རྣམས་ཀྱིས་ངན་སོང་དུ་འཇུག་པར་འགྱུར་བ་རྣམས་མི་བྱའོ།",
    "མི་རྣམས་གྲོགས་ནི་དེ་ཡིན་ཏེ་། གྲོགས་༢གང་གིས་ནི་འདོད་པ་འཐོབ།",
    "གང་གིས་རྣམ་པ་དུ་མ་དང་།",
    "རེག་བྱ་དང་།",
    "གང་དག་གིས་འཇིགས་པ་དང་བཅས་པར་འགྱུར་བ་འཇིག་རྟེན་ཕ་རོལ་དུ་ཕན་པ་མ་ཡིན་པ་བྱེད་པརའགྱུར་བ་དེ་དག་རྣམས་ནི་གྲགས་པོའི་གཟུགས་ཀྱི་དགྲ་བོ་རྣམས་ཡིན་ནོ།",
    "དགེ་སློང་གང་དག་ར་བ་ཏུ་ཆ་གས་པར་གྱུར་པ་རྣམས་ནི་རང་གི་བྱ་བ་ལས་ཡོངས་སུ་ཉམས་པར་བྱེད་པ་དང་།",
    "ཀུན་དུ་དགའ་བར་གྱུར་པས་ཕན་ཚུན་དུ་བསྟན་བཅོས་ཀྱིས་ཀུན་དུ་བརྗོད་པ་དག་གིས་ད་གའ་བར་གྱུར་པས་རྒྱལ་པོའི་ཁྱིམ་དུ་ཆུད་པར་དགེ་སློང་གན་ས་པར་བྱེད་དེ།",
    "གང་གི་ཕྱིར་ཀུན་དུ་འདྲེས་པར་གནས་པ་ཐམས་ཅད་ནི་ཡོངས་སུ་སྤང་བར་ནུས་ལ།",
    "མུན་པ་ཡུན་རིང་གིས་བསླང་གང་།",
    "ཡེ་ཤེས་མེས་ནི་ཉོན་མོངས་པའི།",
    "བུད་ཤིང་༢ཆེན་པོ་ཆེར་འབར་བྱེད།",
    "རེག་བྱ་དང་།",
    "༤་ེམུན་པའི་ཚོགས་སུ་གྱུར་པའི་ཉོན་མོངས་པའི་ཚོགས་འདི་དག་རྣམས་བསྲེག་པར་བྱ་ནུས་པ་མ་ཡིན་ན་༡།",
    "དུད་འགྲོ་རྣམས་སུ་ཉི་མ་རེ་རེ་༢ཞིང་བྱིས་པའི་སྐྱེ་བོ་འདི་དག་ཐམས་ཅད་༐",
    "འོངས་པ་དེ་ལྟར་ཕྱིར་སོང་ངོ།",
    "དེ་ནས་ལྷ་དེ་དག་རྣམས་བཅོམ་ལྡན་འདས་འོད་སྲུང་གི་༩མཆོད་རྟེན་དེ་ལས་ཕྱིར་འོངས་པར་གྱུར་པ་གང་གི་ཚེ་དེ་མུ་སུ་ལུན་དྷ་ལ་འདྲིའོ།",
    "ལྷ་ཇི་ལྟར་རྣམ་པ་གང་གིས་ཁྱོད་ཀྱིས་མཆོད་རྟེན་དེ་མཐོང་།",
    "བུང་བ་རྒྱ་ཆེ་བ་ནས་བུང་བ་རྒྱ་ཆེ་བར་ལྷ་མོ་བརྒྱ་སྟོང་དུ་མས་ཡོངས་སུ་བསྐོར་བ་དེ་བཞིན་དུ་རྒྱན་དང་ཆ་བྱད་དང་ལྡན་པའི་ལྷ་བརྒྱ་སྟོང་གིས་ཀུན་དུ་གང་བར་གྱུར་པས་མདུན་ན་གར་བྱེད་པར་གྱུར།",
    "སྐྱེད་མོས་ཚལ་ནས་སྐྱེདམོས་ཚལ།",
    "དེ་བཞིན་དུ་ན་མ་མཁའ་ལ་ཡང་ཁང་པ་བརྒྱ་སྟོང་གིས་ཡོངས་སུ་བསྐོར་བར་གྱུར་ནས་ལྷ་བརྒྱ་སྟོང་གིས་གང་བས་རོལ་མོའི་སྒྲ་དང་།",
    "དེ་བཞིན་དུ་རིའི་རྩེ་མོ་རྣམས་ལས་གཞན་དུ་ཡང་མཐོང་བ་པད་མ་བརྒྱ་སྟོང་དུ་མ་སྐྱེས་པའི་ཀླུང་རྣམས་ཀྱིས་ལེགས་པར་རྣམ་པར་ཕྱེ་བའི་ཕྱོགས་ཀྱི་ཆ་དང་།",
    "ལྷའི་འཇིག་རྟེན་འདི་རྒྱ་ཆེན་པོར་ཁང་བུ་བརྒྱ་སྟོང་གིས་ཡོངས་སུ་བསྐོར་བར་གྱུར་ན་ས་༩ཐམས་ཅད་ལ་ཀུན་ཏུ་ཐོགས་པ་མེད་པ་ར་ང་འགྲོ་བར་བྱེད་དེ།",
    "དེ་བཞིན་དུ་ནམ་མཁའ་དང་གསུམ་ལ་ཡང་དེ་ལྟར་རྩེ་བར་གྱུར་པ་ན་འགའ་ཞིག་ན་བ་དག་གིས་རིང་བ་ནས་མཐོང་བར་གྱུར་པ་ལ་འོད་ཟེར་དེ་དག་རྣམས་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་པར་བྱེད་པའི་འོད་ཟེར་དྲུག་གི་རང་བཞིན་གྱི་རིར་གྱུར་པ།",
    "གང་གིས་བདག་ཅག་ལྷའི་ཚོགས་རྣམས་ཐམས་ཅད་དང་བཅས་པ་ནམ་མཁའི་དཀྱིལ་ནས་ལྟུང་༧བར་གྱུར་ཅིང་འོད་ཀྱང་ཀུན་ནས་ཉམས་པར་བྱས་པར་གྱུར་ཏོ།",
    "མཆོད་རྟེན་དགེ་སྦྱོང་རྣམས་ཀྱིས་བསྒྲུབ་༢པར་མི་ནུས་པ་དེ་དག་རྣམས་ཀྱི་རིམ་པ་བསྒྲུབ་པ་དེ་དག་ནི་རྒྱུ་གང་གི་ཕྱིར་དེ་དག་རྣམས་ཀྱི་དྲུང་ན་ཆེས་ཁྱད་པར་དུ་འཕགས་པར་གྱུར་པ་གཞན་ནི་འགའ་ཞིག་ཀྱང་མེད་པའི་ཕྱིར་ན།",
    "རྒྱུ་འདིས་ན་ཁྱོད་ཀྱང་ལྷུང་བར་འགྱུར་བ་ཡིན་ཞེས་ང་༤ལ་ར་བ་ཏུ་རྣམ་པར་ཡངས་པ་དེས་བརྗོད་དོ།",
    "གང་བཅོམ་ལྡན་འདས་དེ་དག་གིས་བསྟན་པའི་ལྷ་དང་མི་རྣམས་ལ་ཕན་པར་གྱུར་པ་འདི་དག་རྣམས་ཀྱང་ཐོས་སོ།",
    "དེ་ནས་ལྷ་དེ་དག་རྣམས་ཀྱིས་འཐབ་བྲལ་བའི་མངའ་བདག་དེའི་ཚིག་རྣམས་ཐོས་པར་གྱུར་ནས་གང་ཡང་ས་གཞན་དག་པ་རྣམས་ནི་དེ་དག་རྣམས་སུ་ལེགས་པར་ཉེ་བར་སོང་ངོ།",
    "མུ་སུ་ལུན་དྷ་ཡང་རང་གི་ས་ལ་རབ་ཏུ་ཞུགས་པར་གྱུར་༦ཏོ།",
    "དེ་ཡང་མཆོག་ཏུ་འདོད་པ་སྐྱེད་པར་བྱེད་པའི་༢ཚིག་རྣམས་འདོན་པར་བྱེད་པ་དང་ཕྱི་བཞིན་འབྲང་བར་ཡང་ངང་མོ་དག་རྣམ་པར་རྒྱུའོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་ཁ་དོག་གི་སྒྲོ་དང་ལྡན་པ་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་ཡིད་འཕྲོག་པར་གྱུར་པའི་འདོད་པ་སྐྱེད་པར་བྱེད་པ་དེ་དག་རྣམས་ཀུན་ཏུ་མཐོང་བར་གྱུར་ན་ས་ཀྱང་ཡིད་ལ་སྒོམ་༢པར་མི་བྱེད་ད་དོ།",
    "པད་མ་དམར་པོའི་ལྗོན་ཤིང་གིས་ཉེ་བར་མཛེས་པ་འབབ་ཆུ་དང་ཆུ་ཀླུང་༩དང་རྫིང་བུ་སྣ་ཚོགས་པས་ཀུན་ཏུ་གང་བར་གྱུར་པ་གང་གིས་ལེགས་པར་བྱས་པའི་ལས་ཀྱི་མཐའ་ལ་སྤྱད་པ་རྣམས་འདི་སྟེན་༡པར་བྱེད་པ།",
    "ཤིང་དེ་དག་རྣམས་ཀྱི་འོད་དེ་དག་གིས་ཀྱང་ཉེ་འཁོར་དུ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "ཉེ་འཁོར་ཀུན་ཏུ་སྣང་བར་བྱེད་པའི་འདབ་མ་དང་ཡལ་ག་དང་ལོ་མ་དང་ཚི་འུ་པ་རྣམས་ལ་ལྷའི་བུ་མོའི་ཚོགསཀྱིས་ཡོངས་སུ་བསྐོར་བར་གྱུར་ནས་༧དེ་དག་རྣམས་ན་མ་མཁའ་ལ་ཉེ་བར་འཕགས་པའི་ཤིང་དེ་དག་རྣམས་ཉི་མ་མང་པོ་རྣམས་བཞིན་དུ་ནམ་མཁའ་༨ཐམས་ཅད་དེ་དག་གིས་རྣམ་པར་སྣང་བར་བྱེད་དོ།",
    "དེ་དག་གི་སྔོན་ན་ལྗོན་ཤིང་དེ་དག་རྣམས་ལམ་སྟོན་པར་བྱེད་པ་པོ་བཞིན་དུ་འགྲོའོ།",
    "དེ་ནས་ལྷ་དེ་དག་འདི་སྙམ་དུ་སེམས་ཏེ་ལྗོན་ཤིང་དེ་དག་རྣམས་གང་ལ་ཡང་བདག་གིས་ཞོན་པར་ནི་མ་གྱུར་ཏོ།",
    "དེ་དག་འཁོར་དང་བཅས་པ་རྣམས་རྒྱགས་ཤིང་འདོད་པ་ཐམས་ཅད་ཀྱིས་བདེ་བར་གྱུར་པས་ལྷ་རྣམས་ཡལ་ག་ལསོང་བར་གྱུར་ནས་ནགས་ད་མར་པོ་ན་དགའ་བར་བྱེད་དོ།",
    "གཞན་ཡང་ལྷ་གང་དག་གང་ལ་གསེབ་༧ཏུ་སོང་བར་གྱུར་པ་དེ་དག་རྣམས་ཀྱང་གང་དེ་ཁོ་ན་བཞིན་དུ་འགྱུར་རོ།",
    "འབབ་ཆུ་དང་རྫིང་བུ་སྣ་ཚོགས་པས་ཀུན་ཏུ་གང་བར་གྱུར་པ་དེ་བཞིན་དུ་ལྷའི་བུ་མོའི་ཚོགས་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་བའོ།",
    "འབབ་ཆུ་དང་རྫིང་བུ་རྣམས་དང་པད་མའི་ཚལ་སྣ་ཚོགས་པ་ཕུན་སུམ་ཚོགས་པ་བྱའི་ཚོགས་དུ་མས་ཡོངས་སུ་གང་བར་གྱུར་པ་མེ་ཏོག་གི་ཚོགས་རྣམས་དང་ཉེ་བར་༐",
    "ལྗོན་ཤིང་གི་གསེབ་ནས་༡༡ལྗོན་ཤིང་གི་༡༢གསེབ་ཏུའོ།",
    "གཞན་དང་ར་ང་ཉིད་ཀྱི་འོད་དང་ལྡན་པ་འོད་དང་ཆ་བྱད་༦དུ་མ་རྣམས་ཀྱིས་རྒྱན་༧དུ་བྱས་པའི་ལུས་ཅན་གྱི་ལྷའི་བུ་མོ་དག་གིས་ཕྱི་བཞིན་འབྲང་བར་གྱུར་པས་འགྱིང་བར་གྱུར་པ་༨རྒོད་པར་གྱུར་ན་གང་ན་པད་མ་རཱ་གའི་ནགས་ཡོད་པ་དེར་ཉེ་༩བར་ལེགས་པར་འགྲོའོ།",
    "དེ་དག་རྣམས་ལས་༡སེམས་ཤིན་ཏུ་ཆགས་པར་གྱུར་པའི་གླང་པོ་རྣམས་པད་མ་ཟ་བར་གྱུར་པ་དེ་དག་རྣམས་ཕན་ཚུན་དུ་ལྷན་ཅིག་པར་གླང་མོ་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ནས་ཤིན་ཏུ་གཙང་བར་གྱུར་པའི་ཆུ་ཡང་ཡོན་ཏན་བདུན་དང་ལྡན་པ་ཆུ་བལ་གྱི་སྐྱོན་རྣམས་དང་བྲལ་བ་འདམ་གྱི་དྲི་མའི་སྐྱོན་རྣམས་དང་བྲལ་བ་རིང་བ་དང་ཐུང་བའི་སྐྱོན་དང་བྲལ་བ་དང་བར་གྱུར་པ་རེག་ན་བདེ་བར་གྱུར་པ་སྟེ།",
    "ཀི་བེ་༢ ཇི་ལྟ་ཇི་ལྟར་གླང་པོ་དེ་དག་འདོད་པར་འགྱུར་བའི་རྣམ་པ་དེ་ལྟ་བུའི་རེག་བྱར་འགྱུར་རོ།",
    "པད་མའི་ན་གས་དེ་ན་ལྷ་མོ་རྣམས་ཀྱི་གླུ་དང་ལྷ་དེ་དག་རྣམས་ཀྱི་གླུའི་སྒྲ་རྣམས་ཀྱང་རྣམ་པར་སུན་འདོན་པར་བྱེད་པའི་སྒྲ་གླང་པོ་རྣམས་ཀྱི་༡ན་ང་ན་ངར་བ་སྐྱིམ་པ་ལྟ་བུར་གྱུར་པའི་སྒྲས་ཉེ་༢འཁོར་ཀུན་ན་ལེགས་པར་གླུ་ལེན་པ་བཞིན་དུ་མཐོ་རིས་ཉེ་བར་རྙེད་པར་གྱུར་ཏེ་རི་དང་ཚང་ཚིང་རྣམས་ལས་ཀྱང་སྒྲ་བརྙན་གྱི་སྒྲ་རྣམས་ཐོས་པར་གྱུར་ནས་ལྷ་དེ་དག་རྣམས་ཡང་༢གང་ན་པད་མའི་ན་གས་ཞེས་བྱ་བའི་ནགས་ཡོད་པ་དེར་རྣམ་པ་སྣ་ཚོགས་པའི་རྒྱན་གྱིས་རྣམ་པར་འབར་བར་གྱུར་པའི་ལུས་ཅན་རྣམས་ཉེ་བར་འགྲོའོ།",
    "ལྷའི་བུ་མོའི་ཚོགས་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ནས་དེ་ཁོ་ན་༤བཞིན་དུ་ལྷ་དེ་དག་རྣམས་པད་མའི་ནགས་སུ་རྩེ་བར་བྱེད་དོ།",
    "དེ་དག་དེ་ལྟར་ད་གའ་བར་གྱུར་པའི་ལྷ་དང་ལྷ་མོའི་ཚོགས་ཀྱིས་གང་བ་རྣམས་དུས་༥ཡུན་རིང་བར་དགའ་བར་བྱེད་ཅིང་གར་ཡང་བྱེད་དོ་། དེ་ལྟར་དེ་དག་རྣམས་བག་མེད་པར་གྱུར་པས་ལེགས་པར་བྱས་པའི་ལས་རྣམས་ཟད་པར་འགྱུར་རོ།",
    "གྱུར་པའི་༥མཚན་ཉིད་གཞན་ཡང་ཡོད་དེ་གང་ཞེ་ན་དེ་འདི་ལྟ་སྟེ་ལྷ་འམ་ལྷ་མོ་ཡང་རུང་སྟེ་གར་བྱེད་པར་གྱུར་པའི་གླང་པོ་ཆེའི་རྒྱབ་དུ་ཞོན་པར་བྱེད་དོ།",
    "དེ་ན་ས་གང་དག་ཆེས་བག་མེད་པར་གྱུར་པ་དེ་དག་གི་ཡིད་ལྷ་རྣམས་ཀྱིས་རྟོགས་པར་གྱུར་ཏོ།",
    "ར་ང་གི་ལས་འབྲས་སྤྱོད་པ་ལ།",
    "དེ་ན་ས་ལྷ་དང་བཅས་པ་རྣམས་ཉིད་ཀྱི་ཡིད་ཀྱིས་ཤེས་པར་གྱུར་ནས་ཅང་མི་སྨྲ་བར་གྱུར་ཏེ་པད་མའི་ནགས་དེ་ལས་ཕྱིར་སོང་ངོ།",
    "སོང་ཞིང་།",
    "པད་མའི་གསེབ་ཏུ་༥སོང་ན་ས་ལྷན་ཅིག་སྤྱོད་པ་དང་བ་ཅས་པ་དེ་དག་རྣམས་ཡུལ་དེར་དུས་ཤིན་ཏུ་རིང་བར་རྩེ་བར་གྱུར་ནས།",
    "གཞན་ཡང་དེ་ཁོ་ན་བཞིན་དུ་གཟུགས་བརྒྱ་སྟོང་དུ་མར་གྱུར་པའི་ལྷ་རྫས་ཀྱི་གསེར་དང་བེ་ཌཱུརྱ་དང་དངུལ་དང་པད་མ་རཱ་ག་རྣམས་ཀྱིས་༦ལེགས་པར་རྣམ་པར་ཕྱེ་བར་གྱུར་པའི་ཆ་ཤས་དང་རྟ་བབས་དང་ཁང་བུ་བརྒྱ་སྟོང་དང་ལྡན་པ་པད་མ་བརྒྱ་སྟོང་གིས་ཉེ་བར་མཛེས་པར་གྱུར་པ་རྒྱ་ཆེན་པོའི་བདེ་བ་ལ་དམིགས་པ་ཞེས་བྱ་བའི་རི་ལ་འཛེག་པར་བྱེད་དོ།",
    "རི་ཐམས་ཅད་ལ་ཡང་མཆོག་ཏུ་བདེ་བར་གྱུར་པའི་འདོད་པ་རྣམས་ཀྱིས་ཡོངས་སུ་ཁྱབ་པ་རྔ་སྐད་བརྒྱ་སྟོང་སྒྲོགས་པར་གྱུར་པས་གང་བ་སྒྲ་འབྱིན་པའི་སྒྲ་རྣམ་པ་སྣ་ཚོགས་པ་རྣམས་དང་ཁ་དོག་སྣ་ཚོགས་པ་ནང་དུ་རེག་བྱར་སྣང་བའི་གཟི་བརྗིད་ཅན་དེ་དག་གིས་སྟོད་༧༦༦ བཀའའགྱུར།",
    "རེག་བྱ་དང་།",
    "ཁ་ཅིག་ནི་ཁྱོགས་༥ཀྱི་ཁང་བུའི་སྟེང་ནས་ཁ་ཅིག་ནི་ངང་པའི་རྒྱབ་ནས་ཁ་ཅིག་ནི་པད་མའི་ན་ང་དུ་ཞུགས་ནས།",
    "ཡུལ་ཕྱོགས་ཁ་ཅིག་ནི་ད་ངུལ་དང་ཤེལ་དང་མུ་ཏིག་གི་འོད་རྣམས་ཀྱི་མཆོག་ཏུ་ཡིད་དུ་འོང་བར་གྱུར་པ་དེ་དག་རྣམས་ཀྱི་འོད་ཀྱིས་ཤིན་ཏུ་༐",
    "༤༦༧ིགྲང་མོ་རྣམས་རབ་ཏུ་འབབ་པར་བྱེད་པ་རྣམས་མཐོང་ང་ངོ།",
    "ཁ་ཅིག་ནི་མཆོག་ཏུ་མཛེས་པར་གྱུར་པ་མཆོག་གི་ལས་བྱས་པའི་ཟས་རྣམས་ཉེ་བར་ཟ་བར་བྱེད་ད་དོ།",
    "ནགས་དེ་ན་༨བེ་ཌཱུ་རྱ་འི་ར་ང་བཞིན་གྱི་ལྗོན་ཤིང་རྣམས་ལ་མེ་ཏོག་གི་༩ཚན་ཀ་རྣམས་ཀྱིས་རྒུ་བར་གྱུར་ནས་རྣམ་པར་བཀོད་པས་ཉེ་བར་མཛེས་པར་གྱུར་པ་འབབ་ཆུ་དང་ཆུ་ཀླུང་དང་རྫིང་བུ་རྣམས་བརྒྱ་སྟོང་དང་ལྡན་པ།",
    "ནགས་གང་དག་གི་༡༧དངུལ་གྱི་ར་ང་བཞིན་གྱི་ལྗོན་ཤིང་རྣམས་༡༧ལ་གསེར་བ་ཙོ་མའི་རང་བཞིན་གྱི་འཁྲི་༡༨ཤིང་གིས་ཡོངས་སུ་འཁྲིལ་བ་བུང་བ་བརྒྱའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ་བྱའི་ཚོགས་ཀུན་ན་ས་སྒྲོགས་པར་བྱེད་པ།",
    "བྱ་༤བརྒྱ་སྟོང་གིས་དེ་ན་རྩེ་བར་གྱུར་ཅིང་སྒྲ་སྒྲོགས་པར་གྱུར་པ་འབབ་ཆུ་དང་ཆུ་ཀླུང་དང་པད་མའི་ནགས་རྣམས་ཀྱིསཉེ་བར་མཛེས་པ།",
    "ཉེ་འཁོར་ན་ཡང་རབ་ཏུ་དགའ་བའི་ལྷ་དང་ལྷ་མོའི་ཚོགས་རྣམས་ཀྱིས་གང་བས་རབ་ཏུ་གླུ་ལེན་པར་གྱུར་པ་འདོད་པ་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པ་རྣམས་ཀྱིས་ཉེ་བར་མཛེས་པར་གྱུར་པའོ།",
    "གི་འཁྲི་༧ཤིང་གིས་ཉེ་བར་མཛེས་པར་གྱུར་པ།",
    "ལྷ་དང་ལྷ་མོའི་ཚོགས་ཀྱིས་གང་བ་པད་མའི་ནགས་བརྒྱ་སྟོང་གིས་མཛེས་པར་བྱས་པ་རྣམ་པར་རྟོག་པ་དུ་མ་རྣམས་དང་བལྟ་༐",
    "གང་གིས་འདུ་འཛིའི་སྐྱོན་རྣམས་སྤངས།",
    "དེ་ལྟར་བདེན་པར་སྨྲ་བར་བྱེད་པའི་བྱ་དེ་དག་གིས་འཁོད་པར་གྱུར་པའི་ལྷ་དེ་དག་རྣམས་ལ་རྗོད་༢པར་བྱེད་དོ།",
    "དེ་དག་གི་དྲུང་ན་ས་ཐོས་པར་གྱུར་ནས་ཀྱང་ལྷ་གང་དག་ཤིན་ཏུ་བག་མེད་པས་རྒྱུ་བ་མ་ཡིན་པ་དེ་དག་རྣམས་ཀྱིས་ནི་ཐོས་པར་འགྱུར་རོ།",
    "རི་དེའི་རྩེ་མོ་ལ་ཡང་ཀུན་ནས་མཐོང་ན་དགའ་བ་ཞེས་བྱ་བའི་རི་ཡོད་དེ།",
    "གང་གི་ཕྱིར་སྟོང་ཕྲག་དུ་མའི་རི་འདི་དག་ཐམས་ཅད་ཀྱི་ན་ང་ན་ཉེ་འཁོར་ཀུན་ལས་ཀྱང་ཆེས་མཐོ་བ་ནི་རིའི་རྩེ་མོ་དེ་ཡིན་པར་འདོད་དེ་༨ཀུན་ལས་ལེགས་པར་མཐོང་ངོ།",
    "ལྷན་ཅིག་སྤྱོད་པའི་འཁོར་དང་བཅས་པའི་ལྷ་རྣམས་ཀྱིས་སྣ་ཚོགས་པའི་གླུ་དང་རོལ་མོའི་སྒྲ་དང་གར་དང་བཅས་པ་དེ་ལ་འཁོད་པར་གྱུར་ཏོ།",
    "ལྷ་དང་ལྷ་མོའི་ཚོགས་རྣམས་རི་དེའི་རྩེ་མོ་ལ་འཁོད་པས་ཀྱང་མཐོང་བར་གྱུར་པ་རྣམས་ལ་ལེགས་པར་བྱས་པའི་ལས་དུ་མ་རྣམས་ཀྱིས་སྤྲུལ་པར་གྱུར་པ་ཆེ་ཞིང་ཁ་དོག་དུ་མ་དང་ལྡན་པའི་མཚོ་༩གསལ་བར།",
    "ཀཱ་༥རཎ་ཌ་བ་དང་ངང་ངུར་གྱི་ཚོགས་ཀྱིས་ཀུན་ཏུ་གང་བ་བྱའི་སྐད་རྣམ་པ་སྣ་ཚོགས་པ་རྣམས་ཐོས་པར་བྲེལ་བའི་སྒྲ་སྙན་པས་གང་བ་པད་མ་དང་ཨུད་པ་ལ་དང་ཀུ་མུ་ད་དང་ནི་ན་ད་དང་པད་མ་དམར་པོའི་མེ་ཏོག་གི་དབྱིབས་ལེགས་པ་༐",
    "དང་མན་དཱ་༡༢ར་བའི་ཤིང་གིས་ཡོངས་སུ་ཁྱབ་པ་གསེར་དང་ནོར་བུའི་སྟེགས་བུ་རྣམས་ཀྱིས་ཡོངས་སུ་གང་བར་གྱུར་པ་སྟེ།",
    "འད་བ་མ་དེ་དག་རྣམས་ནི་མཆོག་གི་དྲི་དང་ཡང་ལྡན་ནོ།",
    "ཁ་ཅིག་ནི་པད་མ་ལ་འདུག་པར་གྱུར་ནས་ལྷ་མོ་དང་བཅས་པས་ཡོངས་སུ་བསྐོར་ནས་རྩེ་བར་བྱེད་དོ།",
    "ཁ་ཅིག་ནི་ཨུད་པ་ལ་ལ་ལྷག་པར་གན་ས་ཏེ་ལྷ་མོའི་ཚོགས་རྣམས་དང་བཅས་པས་རྩེ་བར་བྱེད་དོ།",
    "ཁ་ཅིག་ནི་ཐང་ལ་གནས་པའི་ཕུག་མཆོག་རྣམས་སུ་སོང་ནས་རྗེས་སུ་སྤྱོད་པ་དང་བཅས་པ་འདོད་པའི་ཡོན་ཏན་ལྔ་ཕུན་སུམ་ཚོགས་པ་རྣམས་ལ་གླུ་དང་རྒོད་པ་དང་འགྱིང་བར་གྱུར་པས་ཁང་བུ་རྣམས་སུ་དགའ་བར་བྱེད་དོ།",
    "ཁ་ཅིག་ནི་ཡུལ་ཕྱོགས་གཞན་དུ་ལྷ་མོའི་ཚོགས་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ན་ས་ར་རོ་བའི་སྐྱོན་དང་བྲལ་བའི་བཏུང་བ་ཕལ་༢པོ་ཆེ་རྣམས་འཐུང་བར་བྱེད་དེ།",
    "གླུ་ལེན་པར་གྱུར་ཅིང་རོལ་མོའི་སྒྲ་རྣམས་ཀྱིས་ཀྱང་རབ་ཏུ་དགའ་བའི་ཡིད་ཅན་ན་ནོ།",
    "ཁ་ཅིག་ནི་གཞན་ན་རྔ་སྐད་ཡན་ལག་ལྔ་དང་ལྡན་པས་ལྷན་ཅིག་རྗེས་སུ་འགྲོགས་པར་གྱུར་པའི་ལྷ་མོའི་༢ཚོགས་དང་བཅས་པས་ད་གའ་བར་བྱེད་པ་དང་།",
    "ཁ་ཅིག་ནི་མཚོ་དེ་ཉིད་ལ་ལྷན་ཅིག་སྤྱོད་པ་རྣམས་དང་བཅས་ནས་ཆུའི་རྩེད་མོ་བྱེད་དོ།",
    "དྲི་དང་༤རེག་བྱ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་འདོད་པ་བཞིན་དུ་བསིལ་བ་དང་དྲོ་བའི་རེག་བྱ་དེའི་སེམས་བསྐྱེད་པ་དང་དུས་གཅིག་ཉིད་དུ་ཆུ་༐",
    "ཇི་ལྟར་རི་མོ་རྟག་གནས་འཇིག།",
    "གང་ཡང་བག་མེད་པར་སྤྱོད་པ་དེ་དག་རྣམས་ཀྱིས་ནི་མི་ཐོས་པ་སྟེ་རྣམ་པར་གཡེང་བར་གྱུར་པའི་ཡིད་ཀྱིས་དེ་དུས་ཡུན་རིང་དུ་མཚོ་༡༢དེར་རྩེད་མོ་བྱེད་པར་འགྱུར་ལ།",
    "རི་དེའི་རྒྱབ་ན་སྡོང་བུའི་ཤིང་ཞེས་བྱ་བ་གང་དག་གི་རྩ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "སྣ་ཚོགས་སེམས་ཀྱི་ད་བང་གིས་ནི།",
    "དེ་ན་ས་ལྷ་དེ་དག་གིས་དེ་མ་བརྩིས་༢པར་སླར་ཡང་དེ་ཁོ་ན་བཞིན་དུ་ཡུལ་རྣམས་ལ་བག་མེད་པར་གྱུར་ཅིང་འདོད་པ་ལྔས་ཡིད་འཕྲོག་པས་དེ་ཁོ་ན་བཞིན་དུ་དགའ་བར་བྱེད་པ་དང་རྩེ་བར་ཡང་བྱེད་དོ།",
    "ཇི་ལྟར་སྔོན་གྱི་བུད་མེད་ཀྱི་སྐྱེ་བོ་རྣམས་ལྟ་བ་རྗེས་སུ་དྲན་པར་མི་བྱེད་དོ།",
    "རྩེད་༥མོ་རྩེ་བར་འགྱུར་ཞིང་དགའ་བར་འགྱུར་བ་དཔེ་མེད་པའི་སྒྲ་དང་རེག་བྱ་དང་རོ་དང་གཟུགས་དང་དྲི་ས་རྒྱགས་པ་ལ།",
    "ཅི་ལྟ་ཅི་༡ལྟར་རབ་ཏུ་བཅུག་པ་དེ་ལྟ་དེ་ལྟར་མེ་ཆེས་ཕལ་ཆེ་བར་འགྱུར་ཏེ་བུད་ཤིང་རྣམས་སྲེག་པར་༐",
    "ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པའི་རིའི་རྩེ་མོ་རྣམས་སུ་ཡུལ་གྱི་བུད་ཤིང་རྣམས་རབ་ཏུ་འབར་བར་གྱུར་པས།",
    "ལྷའི་བུ་མོའི་ཚོགས་དང་བཅས་པས་བསྐོར་བར་གྱུར་ནས་པད་མའི་ཚལ་ནས་༩པད་མའི་ཚལ་རྣམས་དང་།",
    "ལྷ་མོ་མེད་པར་ལྷའི་ཚོགས་ཀྱིས་ནི་༤མ་ཡིན་ནོ།",
    "དེ་ན་ཡང་དེ་སྲིད་ཁོ་ནར་ལྷ་མོ་དང་བཅས་ནས་ཏེ་༧།",
    "འདི་ལྟར་ནགས་དེའི་ཉེ་འཁོར་རྣམས་ན་ངང་ང་པ་དེ་དག་གིས་རྣམ་པར་གསལ་བར་བྱེད་དོ།",
    "དེ་དག་རྣམས་ཀྱང་ཇི་ལྟར་རྗེས་སུ་འཐུན་པར་མཆོག་ཏུ་རྣམ་པར་བཀྲ་བར་༢བྱས་པའི་སྒྲོའི་ཆ་ཤས་རྣམ་པར་བཀྲ་བར་གྱུར་པའི་ངང་ང་མོ་རྣམས་དང་ལྷན་ཅིག་ཏུ་རྩེ་བར་བྱེད་དོ།",
    "མཚོ་དག་དང་རྫིང་བུ་རྣམས་དང་ཇི་ལྟར་པད་མའི་ནགས་རྣམས་ལ་ཡང་ངོ་ལེགས་པར་འབབ་པའི་རི་ཆུ་ཀླུང་༢གི་རླབས་རྣམས་ལ་དང་དེ་བཞིན་དུ་པད་མའི་ཚལ་རྣམས་ལ་དང་དེ་བཞིན་དུ་ཡང་འཇམ་པ་མནན་ན་ནེམས་༤པའི་ས་གཞི་ཆ་ཀུན་ལ་དང་མེ་ཏོག་དང་ལྡན་པ་རྣམས་ལ་ཡང་དགའ་བར་བྱེད་དོ།",
    "དེ་དག་རྣམས་ཀྱིས་ཀྱང་ལྷ་མོ་དེ་དག་རྣམས་ཀྱི་ཡིད་ཀྱི་རྗེས་སུ་འཐུན་པར་གྱུར་ནས་ཡིད་ཆེས་རབ་ཏུ་དགའ་བར་གྱུར་པས་འདི་ལྟར་རྟོག་པར་བྱེད་དེ་༡༧ཇི་ལྟར་ལྷ་རྣམས་འདི་ན་ངང་པའི་ནགས་ཞེས་བྱ་བའི་ངང་པ་རྣམས་ཀྱི་ནགས་མཆོག་ཏུ་དགའ་བར་གྱུར་པ་ཇི་ལྟ་བ་ཁོ་ན་བཞིན་དུ་རྣམ་པར་མཛེས་པར་གྱུར་པ་རྣམས་ལ།",
    "ཇི་ལྟར་འདི་ན་ལྷའི་ངང་པའི་ནགས་ཞེས་བྱ་བ་ནགས་ཆེན་པོ་མཆོག་ཏུ་དགའ་བར་གྱུར་པ་ཇི་ལྟ་བ་བཞིན་དུ་དེ་དག་གིས་རབ་ཏུ་མཛེས་ཏེ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་པད་མའི་རྫིང་བུ་དང་ལྡན་པའི་རིའི་རྩེ་མོ་ཉེ་བར་༐",
    "དེ་ནས་དེ་བཞིན་དུ་ལྷ་མོ་དེ་དག་རྣམས་དང་ལྷ་དེ་དག་༐",
    "ཞུགས་པར་གྱུར་པ་ན་མཐོང་བ་རྣམས་ལ་ལྗོན་ཤིང་གི་ཚལ་རྣམ་པ་སྣ་ཚོགས་པ་རྣམ་པ་དུ་མ་དང་རྣམ་པ་སྣ་ཚོགས་པའི་རི་དགས་རྣམས་དང་།",
    "ནགས་ཀྱི་ཚང་ཚིང་རྣམས་སུ་དང་ཆུ་ཀླུང་གི་ངོགས་རྣམས་སུ་དང་།",
    "གཏོད་པར་༡༨བྱེད་ཅིང་ལྷའི་བུ་མོའི་ཚོགས་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་བར་གྱུར་ན་ས་ཀྱང་ཉེ་བར་ལེན་པར་བྱེད་ཅིང་སླར་ཡང་ངང་༡༨པའི་ནགས་དེ་ཉིད་དུ་རབ་ཏུ་འཇུག་ག་གོ།",
    "བརྒྱ་ཕྲག་དུ་མར་གྱུར་པའི་རྨ་བྱའི་ཁྱུ་རྣམས་ཀྱང་ལྗོན་ཤིང་གི་ཚང་ཚིང་དང་ཉེ་བར་གྱུར་པ་རྣམས་༡༨ན་ཉེ་བར་རྟོག་སྟེ།",
    "ཁ་ཅིག་ནི་གཅིག་པུ་ཞིག་ཏུ་གྱུར་ནས་ཤིང་འཐུག་༢པོ་རྣམས་ཀྱི་ན་ང་དུ་ནོར་བུ་བདུན་གྱིས་སྤྲས་པའི་ཐིག་ལེས་རྣམ་པར་བཀྲ་བ་རྣམས་ལྗོན་ཤིང་གི་༤འདབ་མ་རྣམས་དང་ལྷན་ཅིག་ཏུ་རྩེ་བར་བྱེད་ད་དོ།",
    "ད་གའ་བར་གྱུར་པའི་ནགས་ཆེན་པོ་དེའི་ཆུ་༡༢ཀླུང་དེ་དག་རྣམས་ལ་ཡང་ཆུ་ལ་རྒྱུ་བར་གྱུར་པའི་བྱ་རྣམས་གྲང་མོར་གྱུར་པའི་ཆུ་འཐུང་བར་བྱེད་དོ།",
    "བདེ་དང་སྡུག་བསྔལ་དག་གིས་ཀྱང་།",
    "གང་གི་བློ་ནི་ཡོན་ཏན་ལྡན།",
    "ངན་སོང་ཤིན་ཏུ་ཆེན་པོར་འགྱུར།",
    "༨ཀུན་ནས་ཕྲོགས་༡པར་གྱུར་པའི་ཕྱིར་ན་བྱ་དེ་དག་གིས་ཅི་བརྗོད་ཅེས་ཟེར་ནས་གོ་བར་མི་འགྱུར་རོ།",
    "འོག་གི་ས་ན་གནས་པར་གྱུར་པའི་ལྷ་སུམ་ཅུ་རྩ་གསུམ་པའམ་རྒྱལ་ཆེན་རིས་བཞི་པ་རྣམས་ཀྱང་རུང་སྟེ་གཞན་འགའ་ཞིག་ན་ཡང་རྣམ་པ་དེ་སྲིད་ཀྱི་གཟི་བརྗིད་ཅན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "༦རྣམས་དང་ལྡན་པ་དང་རིའི་རྩེ་མོ་རྣམས་དང་བྱའི་སྒྲ་དགའ་བ་རྣམས་དང་ལྡན་པར་གྱུར་པ་ཡིན་ནོ།",
    "རང་གི་འོད་ཟེར་རྣམས་ཉིད་ལྷ་མོ་དེ་དག་གིས་ལྷ་གསར་༢དུ་སྐྱེས་པ་དེ་ལ་རྗོད་༤པར་བྱེད་ད་དོ།",
    "དཀར་པོ་དག་གི་འོད་ཟེར་བརྒྱ་སྟོང་གིས་བསྐོར་ནས་ནགས་དང་བཅས་པའི་ཡུལ་གྱི་ནོར་བུའི་ནགས་དེ་དང་།",
    "ལྷ་མོ་དེ་དག་ཉིད་དང་ལྷན་ཅིག་ཏུ་དེར་ཉེ་བར་ལེགས་པར་ཕྱིན་ན་ནས།",
    "ཅི་སྟེ་ཡང་བདག་ཅག་རྣམས་ལྷའི་ནོར་བུ་གཞན་རྣམས་གང་ཡིན་པའི་ནང་དུ་ཇི་ལྟ་བར་སོང་ལ་ནམ་མཁའི་ད་ཀྱིལ་དུ་འཁོད་ནས་རྣམ་པར་རྒྱུ་བར་བྱ་སྟེ་མཐོ་རིས་ལ་བལྟ་བའི་དོན་དུ་དེ་བཞིན་དུ་བདག་ཉེ་བར་འགྲོ་བར་བྱའོ།",
    "ཆུ་ཀླུང་དང་འབབ་ཆུ་དང་རྫིང་བུ་དང་ན་གས་སྐྱེད་མོས་ཚལ་དང་པད་མའི་ཚལ་དང་དགའ་ཚལ་དང་རི་དང་རིའི་རྩེ་མོ་དང་ཚང་ཚིང་དག་གིས་ལེགས་པར་གང་བར་གྱུར་པ་མཐོང་ན་དགའ་བ་དུ་མ་རྣམས་ཕྱོགས་གཞན་དང་གཞན་ན་མཐོང་བར་གྱུར་པ་རྣམས་ལ།",
    "ཁ་དོག་དང་དབྱིབས་སྣ་ཚོགས་པའི་སའི་ཆ་རྣམས་དང་དྲི་དང་ལྡན་པར་གྱུར་པའི་མེ་ཏོག་གིས་ཀུན་ཏུ་བེབས་པས་ཆ་གས་པར་བྱེད་དོ།",
    "གཞན་ཡང་ལྷས་ཡུལ་ཕྱོགས་གཞན་རྣམས་སུ་མཐོང་བར་གྱུར་པ་ལ་གང་དག་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་ལྷ་དང་ལྷ་མོའི་ཚོགས་རྣམས་ཀྱིས་ལེགས་པར་གང་བས་རྒོད་པ་དང་འགྱིང་བ་དང་རྩེ་འཇོ་༐",
    "དེ་ནས་དེ་དག་བཏུང་བའི་ས་གཞིར་སོང་ནས་རྣམ་པ་སྣ་ཚོགས་པའི་ནོར་བུའི་སྣོད་རྣམས་སུ་རྨྱ་ོས་བྱེད་དེ་དག་འཐུང་བར་བྱེད་ད་དོ།",
    "དེ་ཡང་ཡུལ་དེ་དག་རྣམས་ཀྱིས་ཀུན་ཏུ་རྨོངས་པར་གྱུར་ནས་ཕྱིར་ཞིང་ཉིད་ཀྱང་ལྷའི་བུ་མོ་དེ་དག་ཉིད་དང་ལྷན་ཅིག་ཏུ་གར་དང་རབ་ཏུ་དགའ་བར་ཡང་བྱེད་དོ།",
    "གཞན་ཡང་དེ་ཡུལ་རྣམས་ཀྱིས་རྒྱགས་པར་གྱུར་ནས་དེ་དག་རྣམས་དང་ལྷན་ཅིག་ཏུ་ཆུའི་རྩེད་མོ་བྱེད་པར་འགྱུར་རོ།",
    "ལྷའི་བུ་མོ་དེ་དག་རྣམས་ཉིད་དང་ལྷའི་བདེ་བ་མཆོག་ཏུ་ད་པེ་མེད་པ་རྣམས་མངོན་སུམ་དུ་ཉེ་བར་ལོངསསྤྱོད་པ་༢བྱེད་དོ།",
    "དེ་ནས་གཞན་ཡང་དེ་དག་རྣམས་ཉིད་ཀྱི་དཀྱིལ་དུ་སོང་ན་ས་ལྷ་དེ་གཅིག་པུ་གླུ་ལེན་ནོ།",
    "ཇི་ལྟར་མེ་ནི་བུད་ཤིང་རྣམས་ཀྱིས་ངོམས་པར་མི་འགྱུར་ལ་དེ་བཞིན་དུ་འདོད་པ་དང་བ་ཅས་པས་འདོད་པ་དང་ལྡན་པ་རྣམས་རྣམ་པར་ངོམས་པ་མི་སྐྱེའོ།",
    "ཕྱིར་༡༡བཞིན་འབྲང་བར་གྱུར་པའི་འཁོར་རྣམས་ཐམས་ཅད་དང་དེ་སོང་ན་ས་ཕྱིར་ཞིང་ཉིད་ཀྱང་སྔ་ན་མ་མཐོང་བའི་ཡུལ་ཕྱོགས་གཞན་རྣམས་སུ་འཇུག་པར་བྱེད་དོ།",
    "དེ་ལྟར་བྱས་པས་ནགས་དེ་དག་ནི་བལྟ་བར་ནུས་པ་ཡང་མ་ཡིན་ནོ་། དེ་བཞིན་དུ་འབབ་ཆུ་དང་རྫིང་བུ་དང་ནགས་དང་ཉེ་བའི་ནགས་དང་ཤིང་གི་ཚོགས་རྣམས་དང་ལྷ་དང་ལྷ་མོའི་ཚོགས་རྣམ་པ་དུ་མ་རྣམས་ཀྱང་དེ་ན་མཐོང་ངོ་། དེ་ཁོ་ན་བཞིན་དུ་རྔ་སྐད་ཡན་ལག་ལྔ་དང་ལྡན་པས་རྩེ་བར་གྱུར་པས་གཞན་ཡང་མཁའ་ལྡིང་གི་རྒྱལ་པོ་དུས་བཟངས་༢དེ་རྣམ་པར་ཡངས་པའི་པད་མའི་རྫིང་བུ་གང་ན་གནས་པར་གྱུར་པ་དེར་ལྷའི་བུ་མོའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ་དང་བ་ཅས་ནས་དེ་དག་རྣམས་ལེགས་པར་༐",
    "གྱུར་པའི་༤འཇིག་རྟེན་ཀུན་ཏུ་གསལ་བར་བྱེད་པའི་ཉི་མ་ཡང་གང་དག་གིས་ཁྱད་པར་གྱིས་སྲིན་བུ་མེ་ཁྱེར་ཙམ་དུ་ཡང་མ་ཡིན་ནོ།",
    "མི་རྣམས་ཀྱི་ཡང་གང་གི་ཕྱིར་རོའི་མཆོག་ཏུ་གྱུར་པ་རྣམས་ལ་འདི་ལྟ་སྟེ།",
    "༥ེ་༧ད་ང་ཡང་དག་པར་ལྡན་པ་དེ་གང་གིས་དཔེར་བྱེད་པར་འགྱུར།",
    "དེ་དག་རྣམས་བསྡོམས་ན་ས་གཅིག་ཏུ་བྱས་པས་ཀྱང་ལྷ་རྣམས་ཀྱི་མེ་ཏོག་ཐམས་ཅད་ཀྱི་ཐ་མར་གྱུར་པ་ནིམ་པའི་ལོ་མའི་བཅུ་དྲུག་གི་ཆ་ར་ཡང་མི་ཆོག་གོ།",
    "ལྷ་རྣམས་ཀྱི་རེག་བྱ་ནི་དཔེ་༡༢མེད་པ་དང་ཡང་དག་པར་ལྡན་པ་ཡིན་ཏེ་ལྷ་རྣམས་ཀྱི་གང་ཡིན་པ་ལ་ནི་མི་རྣམས་ཀྱིས་རྟོགས་པའི་ཡུལ་མ་ཡིན་ནོ།",
    "མི་རྣམས་ཀྱི་རེག་བྱ་རྣམས་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གྱུར་པ་རྣམས་ཀྱང་འདི་ལྟ་སྟེ།",
    "མོན་དར་དང་།",
    "ལྷ་རྣམས་ཀྱི་རེག་བྱ་ཐམས་ཅད་ལས་ཐ་མར་༡༢གྱུར་པ་འདི་ལྟ་སྟེ།",
    "རྒྱུ་དེས་ན་ལྷ་རྣམས་ཀྱི་རེག་བྱ་ཡང་ད་པེ་མེད་པ་ཡིན་ལ་དེ་དག་ལ་ཡང་ད་པེ་བྱ་བར་ནུས་པ་མ་ཡིན་ནོ།",
    "ཆགས་པར་གྱུར་པ་དེ་དག་རྣམས་ཐམས་ཅད་བསྡོམས་པས་ཀྱང་ལྷ་རྣམས་ཀྱི་རྒྱན་གྱི་མཆོག་གི་བཅུ་དྲུག་ཆར་ཡང་མི་ཆོག་པར་འདོད་ད་དེ།",
    "རྒྱལ་ཆེན་རིས་བཞིའི་ཡུལ་དང་སུམ་ཅུ་རྩ་གསུམ་པའི་ཁྱད་པར་གང་ཡིན་པའི་ཁྱད་པར་འདི་དག་གིས་ཀྱང་།",
    "ལྷ་དེ་དག་ངང་པའི་ནགས་དེ་ན་རྩེད་༡མོ་རྩེ་བར་གྱུར་པ་ལས་བར་སྣང་ལ་འགྲོ་བའི་རྒྱལ་པོ་དེ་དང་ཉེ་བར་ཕྱིན་པར་གྱུར་ཏེ་༢།",
    "དེ་དག་རྣམས་གང་ཡིན་པ་དེའི་པད་མ་གཅིག་པོ་གང་ལ་འདི་རྩེ་བར་བྱེད་པ་དེ་ནི་ཚད་དཔག་ཚད་ཙམ་མོ།",
    "རྡོ་རྗེའི་ཟེའུ་འབྲུ་རྣམས་ཀྱིས་རེག་ན་བཟོད་པར་གྱུར་པ་བླ་ན་མེད་པའི་དྲི་དང་ཁ་དོག་རྣམས་དང་ལྡན་པ་དཔེ་མེད་པར་གྱུར་པ་འོད་ཟེར་དུ་མ་རྣམས་ཀྱིས་རྣམ་པར་སྣང་བར་བྱས་པ་འདབ་མ་སྟོང་ཕྲག་བརྒྱ་པ་གང་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཅེ་བར་གཞག་པ།",
    "དྲུག་གིས་རྣམ་པར་རྨོངས་པ་ཡང་།",
    "བུད་མེད་མཐོང་བས་བརྒྱལ་བ་ཡི།",
    "ལས་ཞགས་གཅིག་གིས་བཅིངས་ནས་ནི།",
    "ལྷ་མོའི་ཚོགས་ཀྱིས་རྣམ་རྨོངས་པས།",
    "བུད་མེད་དེ་ནི་ཤེས་མིན་པས།",
    "མོས་བྱིས་༧པ་དང་མཚུངས་པའི།",
    "ཟས་ལ་ཆ་གས་པ་འབའ་ཞིག་གིས།",
    "མཐོན་པོའི་རང་བཞིན་འཕྱང་མོ་ཞོན།",
    "དེ་ནས་ཡང་ནམ་མཁའ་ལྡིང་གི་རྒྱལ་པོ་དེ་མུན་པའི་སྣོད་ཀྱི་ལྷ་དེ་དག་རྣམས་ལ་གཞན་ཡང་རྗོད་པར་བྱེད་པ།",
    "ཇི་ལྟར་ཡུལ་འདི་དག་གིས་རྣམ་པར་རྨོངས་པར་གྱུར་པ་དེས་ན་ཕན་པའི་ཚིག་འདི་དག་རྣམས་མི་ཐོས་ས་སོ།",
    "རྔ་མུ་ར་བའི་ཚོགས་དང་ཆགས་པར་འགྱུར་བའི་གླུ་དང་རོལ་མོའི་སྒྲ་ཐམས་ཅད་ཉམས་པར་བྱེད་དོ།",
    "དེ་ནས་ལྷ་གང་དག་རྣམ་པར་ཡངས་པའི་པད་མའི་རྫིང་བུ་ན་རྩེད་༥མོ་རྩེ་བར་བྱེད་པ་དེ་དག་ལས་དེ་རྣམས་ཐམས་ཅད་ཀྱང་གང་ནས་སྒྲ་ཐོས་པར་གྱུར་པ་དེར་ཁ་ཕྱོགས་ཏེ་གནས་ས་སོ།",
    "དེ་ནས་རིང་བ་ཉིད་ནས་༦འོངས་པར་གྱུར་པ་ནི་ཁང་བུ་བརྒྱ་སྟོང་གིས་ཡོངས་སུ་བསྐོར་ཅིང་༧ལྷ་རྫས་ཀྱི་གླུ་མཁན་གྱི་སྒྲས་ཆགས་པ་སྐྱེད་༨པར་བྱེད་པའི་སྒྲ་རྣམས་ཉེ་བར་བསྒྲགས་པར་གྱུར་པ་སྟེ།",
    "༥༡སྟོང་གིས་ཀྱང་ཉེ་བར་གླུ་ལེན་པར་གྱུར་པས་ཤིན་ཏུ་འཐབ་བྲལ་བ་རྣམས་ཀྱི་བདག་པོ་འོངས་པར་༐",
    "ངང་པ་དེ་དག་གིས་ཀྱང་དགའ་བའི་དབྱངས་དག་ཀྱང་ཉེ་བར་བསྒྲགས་སོ།",
    "དམ་པ་ཁྱོད་ཀྱི་ཡོན་ཏན་འདི་དག་ཀྱང་ཤེས་ལགས་ཀྱི་འཇིགས་པར་མ་མཛད་ཅིག།",
    "འདིར་དེ་སྐད་ཅེས་ཕན་ཚུན་དུ་བརྗོད་ནས་མཁའ་ལྡིང་གི་རྒྱལ་པོ་དེ་ཡང་འཐབ་བྲལ་གྱི་བདག་པོ་དང་ལྷ་བརྒྱ་སྟོང་དུ་མས་༥ཁང་བུ་རྣམས་དང་ངང་པ་དུ་མ་རྣམས་ཀྱིས་ཀྱང་ཡོངས་སུ་བསྐོར་བར་གྱུར་ན་ས་གང་ན་རྣམ་པར་ཡངས་པའི་པད་མའི་རྫིང་བུ་དེར་ཉེ་བར་ལེགས་པར་འགྲོ་སྟེ།",
    "དེ་བཞིན་དུ་རྣམ་པ་དེ་སྲིད་ཀྱི་བག་མེད་པའི་ས་རྣམས་ལ་འཇུག་པར་འགྱུར་བའི་འོད་ཟེར་གྱི་མཆོག་དང་ལྡན་པར་གྱུར་པ་རྣམས་རྔ་སྒྲ་དང་ལྡན་པར་སོང་ནས་རྣམ་པར་ཡངས་པའི་མིང་ཅན་གྱི་རྫིང་༡འདིར་ཞུགས་༢པར་གྱུར་ཏོ་། དེ་ནས་ཕྱིན་པར་གྱུར་པ་དང་ལྷ་གཞན་ཆེས་རབ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་པད་མའི་རྫིང་བུ་དེར་རྩད་༢མོ་རྩེ་བ་རྣམས་ཀུན་ན་ས་ལེགས་པར་མཐོང་བར་གྱུར་པས་རྩེད་མོ་རབ་ཏུ་རྩེ་བར་རྩོམ་མོ།",
    "ཆུའི་རྩེད་༩མོ་ལ་རྣམ་པར་ད་གའ་བ་དང་པད་༡༢མའི་རྩེ་མོ་ལ་རྣམ་པར་དགའ་བ་རྣམས་དང་ཡང་བྲལ་བར་གྱུར་པ་དང་བྱས་པར་གྱུར་པའི་ལས་རྣམས་ཆུད་མི་འཛའ་༡༡བ་ལ་ཀུན་ཏུ་བལྟས་ན་ས་ན་མ་མཁའ་ལ་འགྲོ་བའི་རྒྱལ་པོ་དེ་ལ་འཐབ་བྲལ་གྱི་བདག་པོ་དེས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བདག་གིས་༤གཏམ་འདི་ཅི་སྨྲས་པ་དང་རྣམ་པ་ཇི་ལྟ་བུ་ཅིག་ཀྱང་བདག་གིས་སྨྲས་བྱ་བ་དང་བདག་གིས་གང་ལ་སྨྲ་བར་བྱ་བ་ཡང་སྟེ།",
    "དེ་དེ་ལྟར་ཡང་མོར་འགྱུར་རོ།",
    "བདག་གི་ལེགས་པར་བྱས་པའི་དོན་རྣམས་ནི་ཅི་ཡིན།",
    "དེ་ཁོ་ནར་སྐྱེས་པར་གྱུར་པའི་སྐྱེས་བུ་རྣམས་དང་ལྷ་རྣམས་ཀྱང་དེ་ཁོ་ན་བཞིན་དུ་ཚེའི་འདུ་བྱེད་རྣམས་ཟད་པར་འགྱུར་ཞིང་ལེགས་པར་བྱས་པའི་ལས་རྣམས་ཟད་པར་གྱུར་ན་ས་ནི་འཆི་བད་ག་གི་རྒྱ་ལ་པོ་འོང་བར་འགྱུར་ལ།",
    "འདི་ལྟ་སྟེ་ལང་ཚོ་དང་ན་ད་མེད་པ་དང་སྲོག་དང་ཕུན་སུམ་ཚོགས་པ་རྣམས་སོ།",
    "འཇིགས་པའི་གན་ས་སུ་གྱུར་ཅིང་༢ཡིད་མི་ཆེས་པ་ཇི་ལྟར་བུད་མེད་རྣམས་དང་མཚུངས་པ་གཞན་ཉིད་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཅི་ལྟར་མེའི་ལྷན་ཅིག་སྐྱེས་པ་ཚ་བ་ཡིན་པ་དེ་བཞིན་དུ་བུད་མེད་རྣམས་ཀྱི་ཡང་གཡོ་དང་འདོད་པ་ཅན་དང་།",
    "ང་རྒྱལ་དང་མི་སྙན་པར་བྱེད་པ་དང་ལོག་པར་བསྒྲུབ་༦པ་དང་ཀུན་དུ་འདྲེས་པའི་སེམས་དང་སྐྱོན་དེ་རྣམས་བུད་མེད་དང་ལྷན་ཅིག་སྐྱེས་པ་ཡིན་ཏེ།",
    "བག་མེད་པས་ཀུན་ནས་འཁྲིད་༧པར་གྱུར་པའི་སྐྱེས་བུ་ངན་པ་དེ་ཚིག་༨ཙམ་འབའ་ཞིག་གིས་རབ་ཏུ་རྣམ་པར་བཅོམ་པར་གྱུར་ནས་དེ་དག་ཉིད་ལ་ཡིད་ཆེས་པར་བྱེད་དོ།",
    "པ་མཆོག་༨གིས་བག་མེད་པ་ཡོངས་སུ་སྤང་བར་གྱིས་ཤིག་དེ་དག་ནི་མྱ་ངན་ལས་འདས་པའི་སྒོ་གཏ་ན་ཡིན་ན་ནོ་། འདི་ལྟ་སྟེ།",
    "འཇིག་རྟེན་གཉིས་སུ་འཆིང་བར་བྱེད་པ་ཡང་གང་གི་ཕྱིར་བུད་མེད་དག་ཡིན་པར་གྱུར་པ་དེ་བཞིན་དུ་ཡང་རིག་ལ་གཟུགས་ཀྱི་༢འཁྲུལ་བར་ཡང་མི་འགྱུར་རོ།",
    "གང་དག་བུད་མེད་ཀྱི་བག་མེད་པས་ཀུན་དུ་ཁྲིད་པར་མི་འགྱུར་བ་རྣམས་སོ།",
    "དེ་བཞིན་དུ་ལང་ཚོ་ལ་ནམ་ཡང་ཡིད་ཆེས་པ་༢བསྐྱེད་པར་མི་བྱེད་དེ་༤ལང་ཚོ་འདི་དག་རྣམས་ཐམས་ཅད་ཀྱང་རྒ་བས་ཉེ་བར་ཟིལ་གྱིས་གནོན་པར་འགྱུར་བས་དེ་ལང་ཚོས་སྒྲུབ་པར་མི་བྱེད་དོ།",
    "ནམས་ཀྱང་འཆི་བདག་གི་རྒྱལ་པོས་འཕྲོག་པར་བྱེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེས་འཆི་བདག་གི་དུས་ཀུན་དུ་ཤེས་སོ།",
    "བག་མེད་འཆི་བ་དེ་དག་གི།",
    "གང་གིས་ལུས་ཅན་རྣམ་༡བསྡམས་པའི།",
    "དེ་ནི་ངན་སོང་རྣམས་ཀྱི་དང་པོའི་རྩེ་མོ་ཡིན།",
    "དེ་བག་མེད་པའི་སྐྱོན་རྣམས་གང་དང་གང་གིས་༤སྡུག་བསྔལ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ལུས་ངག་གི་བྱ་བ་རྣམས་ཀྱང་སློབ་༡༢པར་བྱེད་དོ།",
    "གྱུར་པ་༦གང་གི་ཚེ་མཐོང་བ་དེའི་ཚེ་དེ་༧ལས་གཞན་པའི་བག་མེད་པ་རྣམས་ལ་ཡང་འཇིགས་པར་འགྱུར་རོ།",
    "དེ་དག་རྣམས་ལས་ཀྱང་གཞན་དུ་གྱུར་པའི་ལྷ་ལྷག་མ་རྣམས་ཁ་ཅིག་ནི་རྣམ་པར་ཡངས་པ་དེ་ཉིད་ཀྱི་ནང་ན་རྩེད་མོ་རྩེ་བར་བྱེད་དོ།",
    "མཆོག་ཏུ་གྱུར་པའི་ཡང་དག་པའི་ལྟ་བ་དང་ལྡན་པ་གང་གིས་ཕ་རོལ་ལ་ཡིད་གདུང་བར་མི་བྱེད་པ་དང་དྲང་པོ་དང་ཡིད་དྲང་པོར་གྱུར་པས་སྲོག་གཅོད་པ་དང་མ་བྱིན་༢པར་ལེན་པ་ཡང་སྤངས་པར་གྱུར་པ་རྣམས་ནི་སྔར་བཞིན་ནོ།",
    "དེ་ལྟར་ཡང་ཅུང་ཟད་ཅིག་ཀྱང་བུད་མེད་དག་ལ་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པར་གྱུར་པས་ལྟ་བར་མི་བྱེད་ད་དེ།",
    "དེ་ལ་སྐྱེས་པར་གྱུར་པ་ནི་ལྷ་རྫས་ཀྱི་ཡུལ་རྣམས་ལ་ལོངས་སྦྱོད་པར་གྱུར་པའི་བུད་མེད་བརྒྱ་སྟོང་གིས་ཡོངས་སུ་བསྐོར་བ་ལས་ཀྱི་མཐའ་རྣམས་ཡོངས་སུ་དག་པ།",
    "ཤིང་གང་དག་ལ་ཞོན་པར་གྱུར་པ་དེ་དག་རྣམས་ཀྱང་དེ་ཁོ་ན་བཞིན་དུ་རེག་༢པར་བཟོད་པར་འགྱུར་རོ།",
    "གང་གི་ཚེ་བདག་ཅག་རྣམས་འབྲས་༦བུ་འདི་དག་རྣམས་ལས་མཆོག་ཏུ་རོ་དང་དྲི་དང་ཁ་དོག་དང་རེག་བྱ་རྣམས་ཕུན་སུམ་ཚོགས་པའི་བཏུང་བ་འབྲས་བུ་དེ་དག་ལས་འབབ་པར་གྱུར་༧མོ་ད།",
    "དེ་ན་ས་སེམས་བསྐྱེད་པ་ཙམ་ཉིད་ན་ལྷ་དེ་རྣམས་ཉིད་ཀྱི་དྲུང་དུ་འབྲས་བུ་བཟང་པོ་དེ་དག་ལས་བཏུང་བ་སྔ་ན་མེད་པ་རོ་དང་ཁ་དོག་གི་ཡོན་ཏ་ན་དང་ལྡན་པ་རབ་ཏུ་འབབ་པའོ།",
    "དེ་ཡང་ལྷས་ནོར་བུའི་ར་ང་བཞིན་གྱི་སྣོད་ལེགས་པར་བཞག་ན་ས་ལྷ་མོ་དང་བཅས་པ་རྣམས་འཐུང་བར་བྱེད་དོ།",
    "ཡིད་ཀྱི་རྗེས་སུ་འཐུན་པའི་རེག་བྱ་འདོད་པར་གྱུར་པ་རྣམས་གང་དག་ཁོ་ན་ཡིན་པ་ལྷ་རྣམས་ཀྱིས་རེག་བྱ་རེག་པར་འདོད་པ་དེ་ཉིད་༐",
    "ཡོན་ཏན་རྣམས་ཕུན་སུམ་ཚོགས་པར་གྱུར་པའི་ཡུལ་ལྔ་པོ་རྣམས་ལ་རྣམ་པར་སྤྱོད་དོ་། དེ་དག་དེ་ལྟར་རྣམ་པར་རྒྱུ་ཞིང་རྩེད་མོ་རྩེ་བ་ལ་༡བློས་ལྷུང་བར་གྱུར་པས་དུས་ཡུན་རིང་པོར་ཡུལ་གྱི་བདེ་བས་ངོམས་པ་མེད་པ་རྣམས་ཀྱིས།",
    "དད་པར་༢རྩ་བ་དང་ཡལ་ག་དང་ཡལ་ག་ཕྲ་མོ་དག་དང་ལྡན་པར་གྱུར་པ་ཡིན་ལ་དེ་ལ་ངོས་གཅིག་གི་ཉེ་འཁོར་ཀུན་ནས་མཆོག་ཏུ་དཀར་བ་དང་།",
    "ནགས་དེར་གཏོགས་པའི་ཤིང་རེ་རེའི་འོད་ཀྱང་དེ་བཞིན་དུ་འགྱུར་ཏེ།",
    "རྩ་བ་དང་འདབ་མ་དང་ཡལ་ག་དང་ཡལ་ག་ཕྲ་མོ་དང་ལྡན་པས་ཆེན་པོར་གྱུར་པ་ཆུ་ཀླུང་༡དང་འབབ་ཆུ་དང་རྫིང་བུ་ཕུན་སུམ་ཚོགས་པ་དུ་མ་དང་ལྡན་པ་ར་༐",
    "ནགས་ཆེན་པོ་དེ་ཉིད་ཀྱི་ལོགས་གཞན་ལ་ཡང་ནགས་རྣམ་པར་སྣང་བར་བྱེད་པ་ནི་ཨིན་དྲ་ནཱི་ལའི་ལྗོན་ཤིང་གི་ནགས་ཡིན་ཏེ།",
    "རྩ་བ་དང་ཡལ་ག་དང་འདབ་མ་དང་ཟེ་བ་དང་ལྡན་པར་གྱུར་པ་ཉེ་འཁོར་རྣམས་ནི་མཆོག་ཏུ་སྔོ་བ་དང་ལྡན་པས་ཡིད་འཕྲོག་པར་གྱུར་པའི་འཁྲི་༢ཤིང་གི་ཤིང་རྣམས་དང་ལྡན་པ་ལ་རྣམ་པ་སྣ་ཚོགས་པར་ཡིད་འཕྲོག་པར་བྱེད་པའི་བདེ་བའི་སྒྲ་དང་ལྡན་པར་གྱུར་པའི་བྱ་རྣམས་ཀྱིས་གང་བ།",
    "པད་མའི་རྫིང་བུ་རྣམ་པ་དུ་མ་དག་གིས་ཀྱང་ཉེ་བར་མཛེས་པར་གྱུར་པའི་ཉེ་བའི་ནགས་རྣམས་ཀྱི་རྣམ་པར་སྣང་བར་བྱེད་དོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་ཁ་དོག་གི་མེ་ཏོག་དུ་མ་རྣམས་དང་ལྡན་པ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཅེ་བར་གཞག་པ།",
    "ཚག་ཚིག་༤དང་ཤིང་གི་ཚང་ཚིང་དང་འཁྲི་༥ཤིང་གི་ཁང་པ་དང་མེ་ཏོག་གི་འབྱུང་གན་ས་རྣམས་ཀྱིས་ཉེ་བར་མཛེས་པར་གྱུར་པ་སྟེ།",
    "ལྷའི་ཚོགས་གཞན་དག་བརྒྱ་ཕྲག་རྣམས་ཀྱིས་ཀྱང་ལན་ཅིག་མ་ཡིན་པར་བསྟེན་པར་གྱུར་པ་འཁྲི་༩ཤིང་གི་ཁང་པ་དང་པད་མའི་རྫིང་བུ་དང་།",
    "ཆུ་ཀླུང་གི་ངོས་དང་།",
    "ལྗོན་ཤིང་གི་ཚང་ཚིང་རྣམས་སྟེན་༡པར་གྱུར་པས་ཆེས་དགའ་བར་གྱུར་པ་གླུ་དང་།",
    "གླུ་ལེན་པར་བྱེད་དོ་། རྟག་ཏུ་ཡང་ཡུལ་རྣམས་ལ་ཕྱོགས་པར་གྱུར་པའི་ཡིད་དང་བག་མེད་པ་ལ་འགྲོ་བར་བྱེད་པའི་ཡིད་ཀྱིས་ནགས་ཀྱི་གསེབ་རྣམས་སུ་རྟག་ཏུ་ལྷ་མོ་རྣམས་དང་རྩེ་བར་བྱེད་དོ།",
    "ལྗོན་ཤིང་གི་ཡལ་གའི་བར་དུ་སོང་ནས་རབ་ཏུ་བརྟན་པའི་འགྲོས་ཀྱིས་རྗེས་སུ་ཐུགས་བརྩེ་བར་གྱུར་པས་ལྷ་དེ་དག་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ངན་སོང་རྣམ་པ་ལྔ་པོར་ཡང་།",
    "ཟོ་ཆུན་འཁོར་མོའིལིམ་ལོག་ལྟའི་༧།",
    "གློག་དང་ཟོ་ཆུན་འཁོར་མོ་༩མཚུངས།",
    "དགའ་བར་གྱུར་པའི་བུད་མེད་ཀྱང་།",
    "བཏུང་བ་མངར་པོ་དེ་དག་གི།",
    "ངན་སོང་མྱུར་དང་མི་བཟད་པའི།",
    "དགའ་བར་གྱུར་པའི་བུད་མེད་ནི།",
    "རྒྱུ་གང་གིས་ལྷ་དེ་དག་རྣམས་ཀྱིས་ཅུང་ཟད་ཐོས་པར་གྱུར་པས་སྐྱེ་བ་གཞན་རྣམས་རྗེས་སུ་དྲན་པར་གྱུར་ཅིང་༢།",
    "རྣམ་པ་དུ་མར་གྱུར་པའི་མེ་ཏོག་རྣམས་ཀྱིས་གང་འགའ་ཞིག་གི་དྲི་ནི་དཔག་ཚད་ལྔར་འགྲོའོ།",
    "ཁ་ཅིག་གི་ནི་ཉི་ཤུར་རོ།",
    "ཁ་ཅིག་གི་ནི་དཔག་ཚད་སུམ་ཅུ་རྩ་གཉིས་སུ་དྲི་རབ་ཏུ་རྒྱུའོ།",
    "དེ་ལྟར་ནགས་དེ་ན་མཆོག་ཏུ་དྲི་ཕུན་སུམ་ཚོགས་པར་གྱུར་པའི་རྣམ་པ་དུ་མའི་མེ་ཏོག་རྣམས་དང་ཡང་ཉེ་བར་ལྡན་པས་ལྷ་མོ་དང་ལྷ་དག་རྒྱགས་པས་ཐམས་ཅད་རྩེ་བར་གྱུར་༐",
    "བཏུང་བ་དེ་ཡང་སྒྲ་དང་རེག་བྱ་དང་རོ་དང་གཟུགས་ཕུན་སུམ་ཚོགས་པར་འབབ་བོ།",
    "དེ་མཐོང་བར་གྱུར་ནས་ལྷ་དེ་དག་རབ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་འཐུང་བར་འདོད་པར་གྱུར་ནས་ཆུ་ཀླུང་གི་འགྲམ་དུ་འཁོད་དོ།",
    "གང་ན་མེ་ཏོག་གི་ཁང་པ་ཞེས་བྱ་བ་ཡོད་པ་དེར་ཉེ་བར་ལེགས་པར་འགྲོ་བར་བྱེད་དེ་༥།",
    "བྲོ་གར་དང་གླུ་དང་རོལ་མོའི་སྒྲ་དང་བཅས་ནས་རྒྱགས་པས་རྣམ་པར་རྒྱུ་བ་རྣམས་འགྱིང་བག་གིས་འགྲོ་བར་བྱེད་དོ།",
    "འཁྲི་༡ཤིང་གི་ཁང་བུ་རྣམས་སུ་ཞུགས་སོ།",
    "ཨིན་དྲ་ནཱི་༩ལའི་རང་བཞིན་གྱི་འཁྲི་༡ཤིང་གིས་མཛེས་པར་བྱས་པའི་འཁྲི་༢༢ཤིང་གི་ཁྱིམ་གང་ཡིན་པ་དེ་ལ་ནི་དངུལ་གྱི་རང་བཞིན་གྱི་འདབ་མ་རྣམས་ཀྱིས་ཕུབས་སུ་གྱུར་པར་བྱས་ཤིང་།",
    "ཤེལ་གྱི་འཁྲི་༡ཤིང་རྣམ་པར་བརྒྱངས་པ་ཉེ་བར་ཕུབ་པར་གྱུར་པའི་འཁྲི་༡༢ཤིང་གི་ཁང་པ་གང་ཡིན་པ་དེའི་ཚེ་ནི་དེ་ལ་གསེར་གྱི་འདབ་མ་རྣམས་ཀྱིས་ཉེ་བར་མཛེས་པར་གྱུར་པ་དང་།",
    "སྔོན་པོ་ཆེན་པོའི་ཁ་དོག་གི་འབྲས་བུས་མཛེས་པར་གྱུར་པའོ།",
    "ལྷན་ཅིག་སྤྱོད་པའི་འཁོར་དང་བཅས་པ་རྣམས་སོང་ན་ས་ལྷའི་མཆོག་དེ་དག་དགའ་བར་བྱེད་དོ།",
    "༦མངོན་དུ་ཕྱོགས་པ་ཉིད་ཀྱིས་ཤིང་གི་རྩ་བར་བྱུང་ཞིང་གནས་ནས་༐",
    "ཡོངས་སུ་འཆམ་པར་བྱེད་དེ་འཁོར་ལོའི་འགྲོས་ཀྱིས་རྩེད་མོ་རྩེ་བར་བྱེད་པའི་འགྲོས་ཅན་རྣམས་ལྷན་ཅིག་སྤྱོད་པ་དང་བཅས་ནས་བཞད་གད་བྱེད་པ་ཡིན་ན་ནོ།",
    "ཁ་ཅིག་ནི་ཁྱུར་གྱུར་པར་ཉེ་བར་གནས་ནས་སྒྲོ་དག་ཀུན་ཏུ་གྱོན་པས་ལུས་གོང་བུར་བྱས་ཤིང་ཀུན་བློ་འཐུན་པར་གྱུར་པས་དེ་དག་རྣམས་སོང་སྟེ།",
    "གང་ན་གླུའི་སྒྲ་དེ་ཡོད་པར་གྱུར་པའི་མེ་ཏོག་གི་ཁང་པ་དེར་འགྲོ་སྟེ།",
    "༥༢རྣམས་ནས་ཀྱང་སྣ་ཚོགས་པའི་སྒྲོ་རྣམ་པར་བཀྲ་བའི་ལུས་ཅན་གྱི་བྱ་གང་དག་གིས།",
    "མེ་ཏོག་རབ་ཏུ་རྒྱས་པའི་འཁྲི་༡ཤིང་དག་ཁ་ནས་ཁྱེར་ནས་གང་ན་དེ་མེ་ཏོག་གི་ཁང་པའི་ནགས་ཡོད་པ་དེར་བསྙེན་ཏེ་འོང་བར་བྱེད་ད་དོ།",
    "ཁ་དོག་སྣ་ཚོགས་པའི་འོད་ཀྱིས་རྒྱན་དུ་བྱས་པ་རྣམས་གང་ན་མེ་ཏོག་གི་ཁང་པ་ཡོད་པར་ནམ་མཁའི་དཀྱིལ་ན་མཛེས་པར་གྱུར་པས་དེར་འབབས་༢པར་བྱེད་ད་དོ།",
    "གཞན་དག་རྣམས་ནི་རྨ་བྱ་དག་གི་རྒྱབ་ཏུ་ཞོན་ན་ས་ས་སོ།",
    "དེ་ལྟར་རྣམ་པར་འགྱུར་བ་དུ་མར་གྱུར་པའི་རྣམ་པར་རྟོག་པའི་དོན་དུ་མཛེས་པ་དང་ཡང་དག་པར་ལྡན་པས་ལེགས་པར་འོངས་པའི་ལྷ་དེ་དག་རྣམས་ལ་ཇི་ལྟ་བ་བཞིན་དུ་དེ་ཁོ་ན་ཉིད་བརྗོད་པ་ཞེས་བྱ་བའི་བྱ་དེ་དག་གིས་ཚིགས་སུ་བ་ཅད་པ་བརྗོད་པ་ཇི་ལྟར།",
    "གང་གིས་གང་ལ་ཇི་ལྟ་བཞིན་། མཛེས་པ་བྱས་པར་གྱུར་པས་ནི།",
    "ལས་ཀྱི་བློ་ཡི་རི་མོ་ནི།",
    "སེམས་ཡང་མོར་ཡོངས་སུ་འཇུག་པའི་རྒྱུར་འགྱུར་བའི་རྒྱུ་འདིས་དེ་འདིར་རྣམ་པར་བཀྲ་བ་ཉིད་བརྗོད་པར་བྱ་བར་ཡང་མི་ནུས་ས་སོ།",
    "མེ་ཏོག་གི་ནགས་རྣམས་ཀྱི་ནང་དུ་འགྲོ་བ་དང་།",
    "རྫིང་བུའི་གསེབ་རྣམས་སུ་ཡང་སོང་བར་གྱུར་ནས་ཀྱང་ལྷན་ཅིག་ཏུ་གླུ་ལེན་ནོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་སྒྲ་རྣམས་ཐོས་པས་ཡིད་འཕྲོག་པར་བྱེད་པ་གང་ཡང་དེས་ལྷ་མོ་དེ་དག་གི་གླུ་ལེན་པར་བྱེད་པ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་རྩེ་བར་གཞག་པ།",
    "གང་གིས་རིའི་རྩེ་མོ་རྣམས་ཐམས་ཅད་ཀུན་ཏུ་བསྒྲགས་པར་གྱུར་པ་དེས་ཀུན་ཏུ་གང་བར་བྱེད་པ་བཞིན་དུའོ།",
    "དེ་ཐོས་ནས་རི་གཞན་དག་རྣམས་ཀྱི་རྩེ་མོའི་རི་དགས་དེ་དག་རྣམས་ནི་རང་བཞིན་ཁོ་ནསགླུ་ལ་ད་གའ་བས་དེས་གླུ་དེ་ཐོས་པར་གྱུར་ནས་བརྒྱ་ཕྲག་རྣམས་དང་གལ་ཏེ་ན་སྟོང་ཕྲག་རྣམས་སུ་ཡང་ང་ངོ།",
    "ཁ་ཅིག་ནི་ཤིང་གཞན་གྱི་གསེབ་ཏུ་སོང་ནས་ཉན་ནོ།",
    "སྣའི་༤བློ་འཕྲོག་པར་བྱེད་པ་ཡང་ནགས་དེ་ན་རྣམ་པ་སྣ་ཚོགས་པའི་མེ་ཏོག་གི་ཉེ་བར་མཁོ་བ་རྣམས་མཐོང་བས་རྣམ་པར་མཛེས་སོ།",
    "གླིང་བུ་དང་རྫ་༧རྔ་དང་པི་བང་༨གི་སྒྲ་དང་གླུ་སྙན་པའི་སྒྲ་དང་བྱ་རྣམས་ཀྱི་ཡང་སྒྲ་དང་སྒྲ་རྒྱ་ཆེན་པོར་གྱུར་པ་ཡིད་འཕྲོག་པ་རྣམས་ས་སོ།",
    "ད་བང་པོ་གཅིག་གི་ཡུལ་རྣམས་ཀྱིས་ཀྱང་ནགས་དེ་ནི་ཤིན་ཏུ་རྣམ་པར་མཛེས་པ་ཡིན་ནོ།",
    "འདི་ལྟ་སྟེ་རྩེད་མོའི་རི་༐",
    "འདི་ལྟ་སྟེ་ཡོན་ཏན་ཆེན་པོ་རྣམས་ཕུན་སུམ་ཚོགས་པར་གྱུར་པའི་ཡོན་ཏན་བདུན་དང་ལྡན་པའི་སྒྲ་དང་རེག་བྱ་དང་རོ་རྣམས་འདོད་པར་གྱུར་པ་ཀུན་ཏུ་རྟོག་པའི་ཡོན་ཏན་རྣམས་ཕུན་སུམ་ཚོགས་པ་རྣམས་དང་སྒྲའི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་རྣམས་ཀྱང་ཀུན་ཏུ་མཐོང་ངོ།",
    "ཤིན་ཏུ་ཡིད་དུ་འོང་བའི་རི་དེའི་ཡོན་ཏན་དེ་དག་རྣམས་སྐྱེ་བོ་དག་གཏི་མུག་གིས་ལྷན་ཅིག་ཏུ་ཟིན་པར་གྱུར་པས་ཀྱང་ལྷ་དེ་དག་གིས་མཐོང་བ་ཡིན་ནོ།",
    "ད་མ་པའི་ལམ་རྣམས་ལས་ཉམས་པ་བདེ་བ་དང་རྗེས་སུ་མི་འཐུན་པར་གྱུར་པའི་བདེ་བ་གང་ཡིན་པ་རྣམས་འབའ་ཞིག་གིས་ཀྱང་ཀུན་ཏུ་འཁྲིད་༥པར་གྱུར་པ་རྣམས་ཀྱིས་ཀུན་ནས་རིག་པ་ཡང་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་གཙོ་བོར་གྱུར་པའི་བྱ་རྣམས་དག་གི་སྒྲ་འགའ་ཞིག་ཙམ་ཉན་པར་བྱེད་དོ།",
    "ལྷ་དག་གིས་ཡོངས་སུ་བསྐོར་བར་གྱུར་ནས་ཆེས་རབ་ཏུ་དགའ་བར་གྱུར་པའི་ཡིད་ཀྱིས་ཏེ།",
    "པད་མའི་ཁ་ཟུམ་པ་ཉིད་ལས་ཀུན་ཏུ་བྱུང་བར་གྱུར་པའི་བདུད་རྩི་གང་དག་ནི་མཆོག་ཏུ་ལྷ་རྫས་ཀྱི་རོ་དང་དྲི་དང་རེག་བྱ་ཕུན་སུམ་ཚོགས་པ་ཟད་པ་༐",
    "དེ་ལྟར་ལྷ་དེ་ལྷ་མོའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ནས་དགའ་བར་བྱེད་པ་དང་གླུ་ཡང་ལེན་པར་བྱེད།",
    "ཚོགས་པ་ཕན་ཚུན་དུ་༥གྲོགས་བྱེད་༦པར་གྱུར་ནས་རྒྱགས་པ་ལ་དོན་གཅིག་པས་དེ་དེ་ལྟར་དེ་ཉིད་ཁོ་ནའི་གཞིས་ནགས་རྣམས་ན་རབ་ཏུ་རྒྱུ་ཞིང་རྣམ་པ་སྣ་ཚོགས་པའི་རྩེད་མོ་རྣམས་བྱས་ནས་སླར་ཡང་ཡུལ་དེ་ཉིད་ཀྱིས་ངོམས་པ་མེད་པས་གང་ན་བེ་ཌཱུ་རྱ་དང་ལྡན་པར་གྱུར་པའི་རི་དེར་ཉེ་༧བར་འགྲོ་བར་བྱེད་དོ།",
    "བྱ་རྣམས་ཀྱི་གནས་མཆོག་ཏུ་དགའ་བར་གྱུར་པ་རྣམས་ལ་རིའི་བང་རིམ་དང་རི་ཁྲོད་དང་ཕུག་དང་རི་རོང་༩དང་ཚང་ཚིང་དང་མཛེས་པའི་ན་གས་དང་མཚོ་དང་པད་མའི་ཚལ་དང་མེ་ཏོག་གི་ཐང་ཕུན་སུམ་ཚོགས་པ་རྣམས་ལ་རྣམ་པ་གསུམ་གྱི་ངང་པ་ཀུན་ནས་སྒྲ་འབྱིན་པར་བྱེད་པའི་ངོས་རྣམས་ལ།",
    "དེ་དག་གི་གྲངས་ནི་འདི་ཡིན་ཏེ་༢།",
    "འཆི་བདག་གིས་ནི་སྐྱེབ་འཐུང་།",
    "རྒ་བ་ཡིས་ནི་ལང་ཚོ་འཐུང་།",
    "སྐད་ཅིག་ཡུད་ཙམ་སྐབས་ཡོད་མིན་། ངག་གིས་གྲོལ་བ་དེར་མནར་བ།",
    "རྣམ་རྟོག་མཁའ་ལྡིང་གིས་གང་བའི།",
    "དེ་ལྟར་ཕུག་གི་སྒོ་དེ་དག་རྣམས་ལ་ལྷ་རྣམས་ལ་ཕན་པར་འདོད་པའི་ཕྱིར་ན་དེ་བཞིན་དུ་བྲིས་པར་གྱུར་ཏོ།",
    "གང་གི་ཕྱིར་སྟོབས་དང་ལྡན་པ་རྣམས་ནི་དཀར་པོའི་ཕྱོགས་ཡིན་ལ།",
    "དེ་དག་གི་དེ་ལྟར་ཡུད་ཙམ་དེས་ཀྱང་སྐྱེ་བ་གཞན་བརྒྱ་སྟོང་རྣམས་ཆུད་གཟན་པར་མ་གྱུར་ཏོ།",
    "ཕུག་གང་༩དག་གི་སྒོ་ལ་ཚིགས་སུ་བཅད་པ་མཐོང་ཞིང་ཡིད་བྱུང་བར་གྱུར་ནས་བག་མེད་པས་རྣམ་པར་མི་རྒྱུ་བར་གྱུར་པ་རྣམས་དང་།",
    "དེ་ནས་གང་དག་གིས་ཚིགས་སུ་བཅད་པ་དེ་མཐོང་བ་རྣམས་དང་ཡང་ཏྲ་",
    "༥ ༡གང་དག་གིས་མ་མཐོང་བ་དེ་དག་རྣམས་ཐམས་ཅད་ཀྱང་སྒོ་དེ་ན་ས་ཞུགས་ཏེ།",
    "གང་གིས་ཆང་ནི་དུག་མཚུངས་མཐོང་།",
    "ཆ་ང་གིས་ཡིད་ནི་གཡེང་བར་བྱེད།",
    "རེ་ཞིག་རང་གིས་མི་ཤེས་ན།",
    "བད་ག་གིས་འདིར་ནི་ཅི་ཞིག་སྨྲ་། མཛེས་མིན་ངག་གི་སྤུ་གྲིའི་མཚོན།",
    "ཆ་ང་གིས་དུས་གསུམ་ཆུད་གཟོན་བྱེད།",
    "དེ་ལྟར་ཕུག་གི་ནང་ན་གནས་པར་གྱུར་པའི་བྱ་དེ་དག་རྣམས་རྟག་པར་རབ་ཏུ་དགའ་བ་དང་ལྡན་ཞིང་།",
    "ཆ་ང་གི་སྐྱོན་རྣམས་ཀྱང་ཤེས་སོ།",
    "དག་གིས་དགའ་བར་བྱེད་དོ།",
    "དེ་དག་རྣམས་དུས་ཡུན་རིང་པོ་ཕུག་དེ་དག་ཏུ་ལྷ་རྫས་ཀྱི་མཆོག་རྣམས་སྣ་ཚོགས་པ་ཡིད་འཕྲོག་པར་བྱེད་པ་རྣམས་ཀྱིས་རྩེད་མོ་རྩེས་པར་གྱུར་ནས་གང་ཁོ་ནས་ཇི་ལྟར་ཞུགས་པར་གྱུར་པ་དེ་ཁོ་ན་བཞིན་དུ་ཕྱིར་འགྲོའོ།",
    "ཕྱིར་སོང་ནས་ཀྱང་གཞན་ཡང་ཡུལ་རྣམས་ལ་སྲེད་པར་གྱུར་པས་བག་མེད་པར་རྣམ་པར་རྒྱུ་བ་རྣམས་ན་གས་དང་ཉེ་བའི་ནགས་དག་ལྟ་བ་ལ་དགའ་བའི་ཡིད་ཀྱིས་ལྷན་ཅིག་སྤྱོད་པ་དང་བཅས་པས་པད་མའི་ཚལ་གྱི་ནང་དང་ཆུ་ཀླུང་དང་ཚང་ཚིང་དག་ཏུ་དགའ་བར་བྱེད་དོ།",
    "དེ་དག་གིས་རང་བཞིན་ནི་ནམ་ཡང་ཀུན་ནས་འཁུམ་པར་མི་འགྱུར་རོ།",
    "ལྔ་ཡིས་༧ཉི་མ་རེ་རེ་ཞིང་རབ་ཏུ་འཕེལ་བར་གྱུར་པའི་སྔ་ཕྱི་རིམ་པས་ངོ་མཚར་བ་རྣམས་སྐྱེད་པར་བྱེད་པ་དང་ཡིད་ཀྱི་རྗེས་སུ་འཐུན་པར་བྱེད་པ་དང་དཔེ་མེད་པ་དང་ཡོན་ཏན་དང་ལྡན་པར་གྱུར་པས་ཀྱང་དེས་དེ་དག་ནམ་ཡང་ངོམས་པ་སྐྱེ་༨བ་མ་ཡིན་ནོ།",
    "དེ་དག་གི་གལ་ཏེ་ལེགས་པར་བྱས་པའི་ལས་སུ་གྱུར་པ་ལན་གྲངས་གཞན་ལ་རྨྱོང་བར་འགྱུར་བའི་ལས་ཀྱིས་༤མི་རྣམས་སུ་སྐྱེས་ནས་དེ་འཛམ་བུའི་གླིང་དུ་མཆོག་ཏུ་སྐྱིད་དེ་༥བར་འགྱུར་ཏེ་ཤིན་ཏུ་མཐོ་བའི་རིགས་སུ་གར་དང་གླུ་དང་དགོདཔ་དང་འགྱིང་བག་དང་བཅས་པར་སྐྱེའོ།",
    "སྐྱེས་བུ་ཡང་མེ་ཏོག་ཕྲེང་དང་པི་བང་༨དང་རྒྱན་དང་ཆ་བྱད་བཟང་པོ་དང་མཆོག་ཏུ་འཕགས་པའི་གཟུགས་དང་ལྡན་པ་ཕུན་སུམ་ཚོགས་པ་མཆོག་དང་ལྡན་པ་ཡུལ་ལྗོང་ས་ཀྱི་མཆོག་དག་ཏུ་ཉེ་བར་སྐྱེ་བར་འགྱུར་ཏེ་རྒྱལ་པོའམ་རྒྱལ་པོའི་བློན་པོ་ཡང་རུང་སྟེ་༩ཡུལ་ཀཱ་༡༢ཤིའམ་ཀོ་ཤ་ལ་༡༡འམ་གླིང་ཕྲན་དག་ཏུ་ཡང་ལས་དེའི་རྒྱུ་འཐུན་པའི་འབྲས་བུ་དག་གིས་སོ།",
    "གང་གིས་སྔོན་སྐྱེ་བ་གཞན་དུ་ཉམས་སུ་རྨྱོང་བར་གྱུར་པའི་འཁྲིག་པ་ཐོས་༡ནས་ཆགས་པར་བྱེད་པ་དང་།",
    "གྱུར་པ་ན་༩ཡང་འདིའི་རྣམ་པ་སྣ་ཚོགས་པའི་དྲི་དང་རོ་དང་རེག་བྱ་རྣམས་དང་དེ་ཡུལ་དུ་མ་རྣམས་ལ་དགའ་བར་གྱུར་པས་ནགས་ཀྱི་ནང་རྣམས་སུ་རྒྱུ་བར་བྱེད་ཅིང་ལྷ་རྫས་ཀྱི་ལྟི་༡ལྟོ་ཅན་རྣམས་འགྱིང་བར་གྱུར་པ་ལྷ་མོ་བརྒྱ་སྟོང་གིས་ཉེ་བར་༐",
    "དེ་མཚོ་དེ་དག་ཏུ་རྩེད་མོ་བྱས་ནས་སླར་ཉིད་ཀྱང་གང་ན་ལྷ་གཞན་དག་རྣམས་མཆོག་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་འགྲོ་བར་བྱེད་པ་དེར་ལྷ་གསར་དུ་སྐྱེས་པ་དེ་ལྷ་མོའི་ཚོགས་དེ་དག་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ནས་གར་དང་གླུ་དང་རོལ་མོའི་སྒྲ་དང་བཅས་ནས་འགྲོ་བར་བྱེད་དོ།",
    "ཁང་བཟངས་༩རྩེ་མོ་དགའ་བ་ལས།",
    "བེ་ཌཱུརྱ་ཡི་རྩེ་མོ་ལ།",
    "ཁྱོགས་ཀྱི་ཁང་བུ་དགའ་བར་ནི།",
    "རྩེ་མོ་བེ་ཌཱུརྱ་རྣམས་ལ།",
    "དེ་ལྟར་ཡང་བྱ་དེ་དག་གིས་ཕན་པར་འགྱུར་བ་དང་།",
    "ལང་ཚོ་ཡང་ནི་འགོར་བ་མིན།",
    "ཏྒ་༦གཞན་ཡང་ནགས་ཆེན་པོ་གཉིས་པར་གྱུར་པ་རབ་ཏུ་དང་བར་སྣང་བ་ཆེན་པོ་ཞེས་བྱ་བའི་ནགས་སུ་ལྷ་དེ་དག་རྣམས་རྩེད་མོ་དང་བཅས་ནས་སོ།",
    "རི་བོའི་མཆོག་དེ་ཉིད་ཀྱི་སའི་ཆ་རྣམས་ལ་ཡུལ་གྱི་རྒྱགས་པས་མྱོས་པར་གྱུར་པ་གླང་པོ་ཆེན་པོ་བཞིན་དུ་དེ་དག་རྣམས་ནགས་དེ་ན་དུས་རིང་དུ་རྩེད་མོ་རྩེས་ནས།",
    "བརྒྱན་པ་མེ་ཏོག་བརྒྱ་སྟོང་གིས་ཉེ་བར་མཛེས་པར་གྱུར་པ་༧།",
    "བག་མེད་པར་གྱུར་པས་དེ་དག་གི་གཞན་ཡང་མཐོང་བར་གྱུར་པ།",
    "དེ་ལ་༢ལྷ་རྣམས་རབ་ཏུ་ཞུགས་ནས་ཤིན་ཏུ་རབ་ཏུ་དགའ་བར་གྱུར་པའི་ཡིད་ཀྱིས་རྣམ་པ་སྣ་ཚོགས་པའི་འདོད་པའི་ཡོན་ཏན་རྣམས་ཕུན་སུམ་ཚོགས་པའི་ཕུག་དང་ཉེ་བའི་ནགས་དང་རྫིང་བུ་དང་ལྡན་པ་ཤིང་འཁྲིལ་པ་ཀུན་དུ་དུད་པའི་ཁང་པ་དང་མེ་ཏོག་གི་ནགས་དང་པད་མའི་ནགས་དང་ས་༢གཞིའི་རྣམ་པར་མཛེས་པའི་ཆ་ཤས་དང་མེ་ཏོག་གི་ཚལ་གྱི་ས་གཞི་དང་ཕུག་དང་རིའི་ཁྲོད་དང་ཚང་ཚིང་དང་རིའི་ཁོང་སེང་༤རྣམས་ལ་ད་གའ་བར་བྱེད་ད་དོ།",
    "རྩུབ་མོ་སྟེན་པ་ཤེས་པར་འགྱུར།",
    "རྟག་ཏུ་བསམ་པ་སོང་བདག་རྣམས།",
    "འདིས་ནི་རང་གི་མཚན་ཉིད་བརྗོད།",
    "གཞན་ཡང་གང་ན་རིའི་རྩེ་མོ་སྟོང་ཡོད་པ་དེར་ཉེ་༩བར་འགྲོ་བར་བྱེད་དོ།",
    "ལྷ་མོ་དག་ཀྱང་ལྷ་དང་ལྷན་ཅིག་ཏུ་རྒྱགས་པས་ར་བ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་དེ་ལ་འཁོད་པར་བྱེད་དོ་། ཇི་ལྟར་འདོད་པས་འགྲོ་བར་བྱེད་པ་རྣམས་ཁ་ཅིག་ནི་ནམ་མཁའ་ལས་སོ།",
    "ཁ་ཅིག་ནི་བུད་མེད་ཀྱི་འཁོར་༩ན་ང་གི་བཙུན་མོའི་འཁོར་གྱིས་ཡོངས་སུ་བསྐོར་ཅིང་༡།",
    "ཏྒ་༦ངན་པར་གྱུར་པ་རྣམས་སྲེད་༡པའི་ཆུ་ཀླུང་གིས་ཁྱེར་བར་གྱུར་པ་ན།",
    "དེའི་ཉེ་འཁོར་ན་ལྷ་དེ་དག་ལྷ་མོའི་ཚོགས་དང་ལྷན་ཅིག་ཏུ་དགའ་བར་གྱུར་ཅིང་༡རྩེ་བར་བྱེད་པས་འགྲོ་བར་བྱེད་དོ།",
    "དེ་དག་རྣམས་དེ་ལྟར་རྒྱུ་བར་གྱུར་པ་ན་དེ་དག་གིས་ལན་མང་དུ་རིའི་མཆོག་ལ་ཀུན་ཏུ་བལྟས་ནས། ༐",
    "སོ་སོ་སོ་སོར་ར་ང་གི་འདུན་པས་རྒྱུ་བར་གྱུར་པ་དང་རང་གི་འདུན་པས་འགྲོ་བར་བྱེད་པ་རྣམས་གང་དུ་འདོད་པར་ལུས་ངག་གི་སྤྱོད་པ་ངལ་སོ་བར་གྱུར་པས་རྣམ་པར་རྒྱུ་ཞིང་གནས་པར་བྱེད་ད་དོ།",
    "ལྷའི་ཚོགས་ཐམས་ཅད་ཀྱི་ཡིད་འཕྲོག་པར་གྱུར་པའི་ཡིད་ཀྱི་མུན་པ་རྣམས་ཤིན་ཏུ་འཕྲོག་པར་བྱེད་པས་རིའི་རྩེ་མོའི་སྒྲ་དེ་དག་རྣམས་༥༦ བཀའའགྱུར།",
    "རང་གི་ལས་འབྲས་སྤྱད་ནས་ནི།",
    "སྤྱད་ནས་འཆི་བདག་གིས་རྟོག་༤པའི།",
    "ཟོས་ནས་འཆི་བདག་གིས་༐",
    "ཟོས་ནས་འཆི་བདག་གིས་རྟོག་༦པའི།",
    "ཟོས་ནས་འཆི་བདག་གིས་རྟོག་༨པ།",
    "གང་གི་སེམས་ནི་སྒོམ་མིན་དང་།",
    "སྤྱད་༢ནས་འཆི་བདག་གིས་ལྟ་བའི།",
    "འབྲས་བུའི་ནགས་དང་༤སྐྱེད་མོས་ཚལ་དང་དཔག་བསམ་གྱི་༥ཤིང་དང་དངུལ་དང་བེ་ཌཱུ་རྱའི་རང་བཞིན་དང་གསེར་བཙོ་མའི་རང་བཞིན་གྱི་རྣམ་པ་དུ་མར་མཐོང་ན་དགའ་བར་གྱུར་པ་ལྗོན་ཤིང་རྣམས་ལ་ཡང་ལྷན་ཅིག་སྤྱོད་པ་རྣམས་དང་བཅས་པའི་ལྷ་དེ་རྣམས་དགའ་བར་བྱེད་ཅིང་རྩེ་བར་ཡང་བྱེད་པ་ལས།",
    "དེ་ལྟར་བག་མེད་པས་ཁྱོད་བག་མེད་པར་མ་གྱུར་རམ་༥།",
    "ཕྱིར་ཞིང་ཁོ་ན་ལྷ་རྣམས་ཀྱི་མངའ་བདག་བྱེད་པར་གྱུར་པ་གང་གི་ཕྱིར་ལྷ་རྣམས་ལས་ཀྱང་བརྒྱ་འགྱུར་དུ་བདེ་བ་རྣམས་ལ་ཉེ་བར་ལོངས་སྤྱོད་པར་གྱུར་པའི་རྣམ་པ་དེ་ལྟ་བུའི་བདེ་བ་གང་ཡིན་པ་རྣམས་ཀྱིས་ཀྱང་འཁྲིད་པར་མི་བྱེད་པ་དེ་དག་ནི་ཤིན་ཏུ་ངོ་མཚར་བ་གཞན་ཡིན་ནོ་། གང་གི་ཕྱིར་ལེགས་པར་བྱེད་པའི་རྐྱེན་རྣམས་དང་སྡུག་བསྔལ་གྱི་རྐྱེན་གྱི་ཤུགས་རྣམས་ཀྱིས་ཀྱང་འཛིན་པར་བྱེད་པ་ཡིན་ན་ནོ།",
    "བུ་དང་བུ་མོ་ཡང་དག་པར་༡༢བདེ་བར་ཡོངས་སུ་སྐྱོང་བར་བྱེད་པ་ཡིན།",
    "དེ་ལ་གཙང་བའི་རང་གི་སྐྱེ་བོ་དང་ཡང་དག་པར་ལྡན་པའི་རྒྱལ་པོ་ཉུང་ཟད་ཀྱི་རང་བཞིན་ཅན་མ་ཡིན་པར་འགྱུར་བའི་རྣམ་པ་ཅི་ལྟ་བུས་སྐྱེ་བོ་དེ་ག་ཙང་བ་ལ་སྦྱོར་བས་གཞན་ལ་ཕན་པ་ལ་༥རབ་ཏུ་ཞུགས་པ་ཡིན་ཞེ་ན།",
    "དེ་རྣམ་པ་དེ་ལྟ་བུ་དག་གིས་སྐྱེ་བོ་གཞན་དང་བདག་ཉིད་ཀྱང་ལེགས་པར་འཇུག་པར་བྱེད་དེ་རྒྱས་པར་ཡང་བྱེད་ད་དོ།",
    "འཇིག་རྟེན་གཉིས་སུ་ཕན་པ་བྱེད་པར་གྱུར་པའི་སྐྱེ་བོ་རྣམ་པ་དེ་ལྟ་བུ་དེ་དག་གི་སྐྱེ་བོ་དང་ལྡན་པའི་རྒྱལ་པོས་རྒྱལ་ཁམས་ཀྱང་སྐྱོང་བར་བྱེད་ཅིང་རང་དང་གཞན་ཡང་འཛིན་པར་བྱེད་པ་རྣམས་ནི་ལུས་ཞིག་ནས་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་འཐབ་བྲལ་གྱི་ལྷ་རྣམས་ཀྱི་མངའ་བདག་ཏུ་འགྱུར་རོ།",
    "མནརབར་གྱུར་ནས་རིམ་གྱིས་འཕེལ་བར་གྱུར་པའི་རང་གི་དངོས་པོ་རྣམས་རིགས་པ་མ་ཡིན་པས་འཕྲོག་པར་བྱེད་ན།",
    "གྲོགས་པོའི་དྲུང་དུ་ཚིག་རྩུབ་མོ་རྣམས་སྨྲ་བར་ཡང་མི་བྱེད་ད་དོ།",
    "རྒྱལ་པོ་དེ་བཟོད་པ་དང་ལྡན་པར་གྱུར་པའི་རྒྱུ་དེ་དག་དང་རྐྱེན་དེ་དག་གིས་ལུས་ཞིག་ནས་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་འཐབ་བྲལ་བའི་ལྷ་རྣམས་ཀྱི་མངའ་བདག་ཏུ་འགྱུར་རོ།",
    "ཕན་འདོགས་པའི་རྒྱུས་དང་༧རང་གི་སྐྱེ་བོ་ཡིན་པའི་རྒྱུས་དང་སྔོན་ཕན་བཏགས་པའི་རྒྱུས་དང་།",
    "འབྲེལ་བར་གྱུར་པའི་རྒྱུས་དང་སྐྱེ་དགུའི་བདག་པོར་གྱུར་པ་དང་དམག་གི་དཔོན་པོ་ཡིན་པའི་རྒྱུས་ཀྱང་མ་ཡིན་ཏེ།",
    "གཞན་གྱི་དཔུང་གིས་འཇིགས་པར་མི་འགྱུར་རོ།",
    "རྐྱེན་དེ་དག་གིས་ཀྱང་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་༨འཐབ་བྲལ་བའི་མངའ་བདག་ཏུ་སྐྱེ་བར་འགྱུར་༩རོ།",
    "འདི་ལ་དགྲ་རྣམས་ཀྱིས་བར་དུ་གཅོད་པ་ཕྲ་མོ་ཙམ་ཡང་བྱ་བར་གླགས་མི་ཐོད་༤དོ།",
    "གཅིག་ཏུ་ངན་སོང་གི་སྒོ་རྣམ་པར་སྡོམ་པ་དང་གཅིག་ཏུ་རྣམ་པར་སྨིན་པ་བདེ་བར་འགྱུར་རོ།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་དང་།",
    "རྣམ་པ་དེ་ལྟ་༦བུའི་སྦྱིན་པ་རྣམས་གང་གི་ཚེ་རྒྱལ་པོ་དེས་ད་གེ་སྦྱོང་དང་བྲམ་ཟེ་རྣམས་ལ་གཏོང་བར་བྱེད་པ་དེ་ཡང་ལུས་ཞིག་ནས་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་འཐབ་བྲལ་བའི་ལྷ་རྣམས་ཀྱི་བདག་པོར་ལས་དེའི་རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱིས་༐",
    "མེད་པར་སྨྲ་བར་གྱུར་པ་གང་གིས་སྦྱིན་སྲེག་མེད་དོ།",
    "གདུང་བ་ལྔས་དུས་བྱེད་པ་ནི་དེ་དག་གི་འཇིག་རྟེན་ཟད་པར་འགྱུར་ཏེ།",
    "གང་དག་གིས་རྒྱུ་དང་འབྲས་བུ་ཡང་དག་པ་༦ཇི་ལྟ་བར་བརྗོད་པ་དེ་དག་རྗེས་སུ་འཛིན་པར་བྱེད་ད་དོ།",
    "བུད་མེད་ཐམས་ཅད་ནི་རྣམ་པར་འབྱེད་པའི་རང་བཞིན་ཅན་ཡིན་ན་ནོ།",
    "༥༧མནན་པར་གྱུར་པ་གང་གི་ཕྱིར་ལེ་ལོ་ཅན་རྣམས་ཐམས་ཅད་ཀྱང་བུད་མེད་འཛིན་པར་བྱེད་དོ།",
    "སྐྱེས་བུ་རང་གི་དོན་རྣམས་ལས་༢ཡོངས་སུ་ཉམས་པར་བྱེད་དོ།",
    "ཕྲག་དོག་གི་སྐྱེ་གནས་ཅན་དེ་དག་རྣམས་ཀྱིས་༐",
    "བུད་མེད་ཀྱིས་འཚོ་བར་གྱུར་པ་དེ་དག་ནི་སྦྲུལ་ནག་པོ་མཐོང་བ་༧དུག་ཅན་དེ་དག་གིས་ཡོངས་སུ་ཉམས་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་བུད་མེད་ཀྱིས་༨འཚོ་བར་གྱུར་པའི་རྒྱལ་པོ་ཞེ་ལྡོག་གོ།"
  ]
}