    "གང་གིས་གཟུང་བའི་ངོ་བོ་དང་བྲལ་བའོ།",
    "རང་གི་ཆ་སེར་པོ་ལ་སོགས་པའི་རྣམ་པ་འཛིན་པ་དང་།",
    "རང་ལས་ཐ་དད་པའི་གཟུང་བར་བྱ་བ་ས་ལ་སོགས་པ་རང་གི་མཚན་ཉིད་མེད་པའི་ཕྱིར་ལ།",
    "རྒྱུད་གཞན་གྱེ་གཟུང་བར་བྱ་བའི་ངོ་བོར་མེད་པའི་ཕྱིར་གཟུང་བའི་རྣམ་པས་སྟོང་པ་ཡིན་ལ་དེ་ལ་ལྟོས་པའི་རྣམ་པར་ཤེས་པར་བྱེད་པས་རྣམ་པར་ཤེས་པ་ཡིན་པའི་ཕྱིར་ཤེས་པའི་བྱེད་པ་པོ་ཉིད་དུ་རབ་ཏུ་བརྟགས་པ་གང་ཡིན་པ་དེ་མེད་པའི་ཕྱིར་འཛིན་པའི་རྣམ་པས་སྟོང་པ་ཡིན་རྨི་རྣམ་པར་ཤེས་པའི་རང་གི་མཚན་ཉིད་ཀྱང་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མེད་པའི་ཕྱིར་ནི་མ་ཡིན་ནོ།",
    "ཁྱད་པར་གཞན་སྤངས་ནས་རང་གི་ངོ་བོ་ཉིད་དེ་ལྟར་བསྟན་པའི་ཕྱིར་ཏེ།",
    "རང་གི་བྱད་ལ་སོགས་པ་དེ་ལྟར་མཐོང་བ་ནི་མ་ཡིན་ཏེ།",
    "རང་གི་བྱད་ལ་སོགས་པ་དེ་མངོན་སུམ་དུ་ཕྱོགས་པར་མཐོང་བའི་ཕྱིར་དང་།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་མེ་བོང་ཤིན་ཏུ་ཆུང་བའི་ངོས་ལ་རང་གི་བྱད་ཤིན་ཏུ་ཆེན་པོ་ཡང་གཟུགས་བརྙན་ཤིན་ཏུ་ཆུང་བར་དམིགས་ལ།",
    "དེ་བཞིན་དུ་མཚོ་ཆུ་དྲི་མ་མེད་པའི་འགྲམ་ན་གནས་པའི་ཤིང་དང་རི་ལ་སོགས་པའི་གཟུགས་བརྙན་ཤིང་དང་རིའི་རྩེ་མོ་ཐུར་དུ་བལྟས་པ་དམིགས་ན།",
    "དེ་ལྟ་བས་ན་དེ་ལྟ་ཡིན་གྱི་ཤེས་པ་ནི་རང་གི་བྱད་ལ་སོགས་པ་འཛིན་པ་མ་ཡིན་ཏེ།",
    "བཙུན་པ་དགེ་སྲུངས་ན་རེ།",
    "ནང་གི་ཤེས་བྱའི་ངོ་བོ་ནི།",
    "མཇུག་ཐོགས་ཤེས་ལ་ཞེས་བྱ་བ་གི་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ཀུན་གཞི་ཞེས་བྱ་བ་ལ་ནུས་པ་གང་ཡིན་པ་རྣམ་པ་དེ་ལྟ་བུའི་དོན་སྣང་བས་བསྒྲུབས་པ་དེ་ཁོ་ན་ཉིད་དུ་མི་འདོད་དོ།",
    "གང་གི་ཕྱིར་སློབ་དཔོན་གྱིས་རྡུལ་ཕྲ་རབ་ལ་སོགས་པ་ལས་མ་གཏོགས་པའི་དམིགས་པ་རིགས་པ་མ་ཡིན་ནོ་ཞེས་རྒྱས་པར་བསྟན་ནས།",
    "དེ་བཞིན་དུ་མོས་ལས་དམིགས་པ་དང་།",
    "སྲོག་ཆགས་ཐམས་ཅད་ཀྱི་སྣང་བར་གྱུར་པ་ཐུན་མོང་གི་མིག་ལྟ་བུར་རྣམ་པར་གཞག་གོ།",
    "གང་གི་བྱེད་པ་པོ་གང་ཡིན་པ་དེ་ནི་དེས་བརྗོད་དེ།",
    "གལ་ཏེ་ཡང་རྫས་ལ་སོགས་པ་དེ་དག་རང་གི་བྱངོ་བོས་མངོན་སུམ་ཡིན་གྱི།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་མཐོ་རིས་འདོད་པ་སྦྱིན་སྲེག་གིས་མཆོད་སྦྱིན་བྱའོ་ཞེས་བྱ་བ་ནི་འཇུག་པར་བྱེད་པའོ།",
    "འདིས་ནི་ཕྱིན་ཅི་བོག་གི་རྒྱུ་འདོད་ཆགས་ལ་སོགས་པའི་ཉེས་པའི་ཚོགས་མེད་པས་ཕྱིན་ཅི་མ་ལོག་པའི་ཤེས་པའི་རྒྱུ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ།",
    "འདི་ལྟར་ལོག་པ་ཉིད་ཀྱི་རྒྱུ་ཉེས་པ་རྣམས་གང་ལ་ཉེ་བ་དེ་ཉིད་ལ་རང་གི་འབྲས་བུ་ལོག་པ་ཉིད་ཉེ་བར་གནས་པར་བྱེད་ཀྱི་གཞན་ནི་མ་ཡིན་ཏེ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "འགྱུར་ན་ཡང་རྟེན་མེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ཡང་རིག་བྱེད་ལ་སོགས་པའི་ཕྱིར་གང་གིས་གཏན་ཚིགས་ཐེ་ཚོམ་ཟ་བའི་མ་གྲུབ་པར་ཡང་འགྱུར་བ་ཉེས་པའི་དོགས་པ་ག་ལས་ཡིན།",
    "རེ་ཞིག་བྱེད་པ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རེ་ཞིག་རིག་བྱེད་ཀྱི་བྱེད་པ་པོ་མངོན་སུམ་གྱིས་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "འགའ་ཞིག་གིས་མ་མཐོང་བའི་མེ་དང་ལྷན་ཅིག་དུ་བའི་འབྱེལ་པ་གཟུང་བར་ནུས་པ་མ་ཡིན་ཏེ།",
    "ཡང་གི་སྒྲས་མངོན་སུམ་དང་བྲལ་བ་འབའ་ཞིག་ཏུ་མ་ཟད་པའོ།",
    "རིག་བྱེད་ལས་མ་གཏོགས་པའི་མ་བྱས་པ་མེད་པའི་ཕྱིར་རེ་ཞིག་མ་བྱས་པ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་ན་དངོས་པོ་མེད་པར་རང་གི་ངོ་བོར་དེ་མེད་དོ་ཞེས་བྱ་བ་དེ་ལྟ་བུར་རྟོགས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟར་ན་དངོས་པོར་གྱུར་པའི་ཕྱིར་འོ་ན་མི་རྟག་པ་ཉིད་བསྒྲུབ་པར་བྱ་བར་འགྱུར་རོ་ཞེས་གཞན་གྱི་ཚིག་གི་གོ་སྐབས་དོགས་པར་བྱེད་པ་ནི།",
    "རང་གི་ངོ་བོའི་སྒྲུབ་པར་བྱེད་པ་ནི་རང་གི་བསྒྲུབ་པ་སྟེ།",
    "འོན་ཏེ་སྟོབས་མཚུངས་པ་དག་ཇི་ལྟར་གཅིག་གིས་ཅིག་ཤོས་ལ་གནོད་པ་ཡིན།",
    "གང་གིས་དེ་མངོན་སུམ་དང་མཚུངས་པ་ཉིད་ཡིན་པ་ཇི་ལྟར་རྗེས་སུ་དཔག་པ་ལས་ལུང་སྟོབས་དང་ལྡན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "རྣམ་པ་གཅིག་ཏུ་ན་ལུང་གིས་གནོད་པར་མ་གྱུར་མོད།",
    "ཡུལ་ཐམས་ཅད་དུ་ངོ་ཤེས་པའི་ཕྱིར་ཁྱབ་པ་ཉིད་ཀྱང་གྲུབ་པས་སུ་ཞིག་གིས་རྟག་སྣེཔ་དང་ཁྱབ་པ་དག་གི་བཟློག་པ་ངེས་པར་འགྱུར་ཏེ།",
    "འདིའི་ཞེས་བྱ་བ་ནི་ཕྱིན་ཅི་ལོག་གིའོ།",
    "སེན་མོ་དང་རྩྭ་དང་།",
    "གང་གི་ཕྱིར་དེ་ལ་ཡང་སྒྲ་འདི་དག་ནི་དེ་ཉིད་ཡིན་ནོསྐེ།",
    "ཁྱད་པར་འགའ་ཞིག་གིས་ཞེས་བྱ་བ་ནི་དམན་པ་ཉིད་དང་སྟེང་དུ་འགྲོ་བ་ལ་སོགས་པས་སོ།",
    "བ་ལང་གི་སྒྲའི་གསལ་བ་དག་ལ་བློ་རྣམས་ཡུལ་དང་དུས་མྱུར་བ་དང་།",
    "བར་མ་ལ་སོགས་པར་སྣང་བའི་ཁྱད་པར་ཐ་དད་པ་གང་དག་ཡིན་པ་དེ་དག་ནི་དོན་གཅིག་གི་ཡུལ་ཅན་ཡིན་པའམ།",
    "ད་ལྟར་སྐྱེས་པའི་བ་ལང་གི་བློ་བཞིན་ནོ།",
    "ཡང་ན་གང་དང་གང་བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་གྱི་བློ་ཡིན་པ་དེ་ནི་ད་ལྟར་གྱི་བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་ཡིན་ཏེ།",
    "དེར་སྐྱེས་པའི་བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་བཞིན་ནོ།",
    "ཁར་རྩང་གི་བ་ལང་གི་སྒྲའི་བློ་ཡང་བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་ཡེན་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་སོ།",
    "ཁར་རྩང་སྒེགི་བ་ལང་གི་སྒྲའི་བློ་ནི་དཔེའོ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཁར་རྩང་གི་བ་ལང་གི་སྒྲ་ཡིས་ཤེས་པས་དམིགས་པའི་བ་ལང་གི་སྒྲའོ།",
    "གཏན་ཚིགས་དེ་ཕྱིར་ཞེས་བྱ་བ་ནི་བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་ན་ཁར་རྩང་དང་དེ་རིང་གི་བློ་གཉི་ག་ཡུལ་གཅིག་པ་ཡིན་ཏེ།",
    "བ་ལང་གི་སྒྲའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་བ་ལང་གི་སྒྲ་གཅིག་གི་བློ་དེ་བཞིན་ནོ།",
    "དེ་ཡང་ན་ཡུལ་ལ་སོགས་པའི་ཁྱད་པར་ཐ་དད་པའི་བ་ལང་ཉིད་ཀྱི་བློ་མཐའ་དག་ནི་བ་ལང་གི་བློ་གཅིག་གིས་བསྐྱེད་པར་བྱ་བ་ཡིན་ཏེ།",
    "བ་ལང་གི་བློ་ཡིན་པའི་ཕྱིར་བ་ལང་གཅིག་གི་བློ་བཞིན་ནོ།",
    "བ་ལང་གི་སྒྲ་གཅིག་གིས་བསྐྱེད་པར་བྱ་བ་ཉིད་ནི་བསྒྲུབ་བྱ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་རོ།",
    "སྔར་བསྟན་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནི་བ་ལང་གི་སྒྲའི་ཤེས་པ་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དུ་བ་སྤྱིའི་ཆ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་དཔེ་སྟེ་རང་གི་མཚན་ཉིད་རྗེས་སུ་མི་འགྲོ་བའི་ཕྱིར་རྟགས་མ་ཡིན་པས་སྤྱིའི་ཆ་ཁོ་ན་དཔེ་ཡིན་ནོ།",
    "གལ་ཏེ་རིགས་ལས་ཏེ་རིགས་ཀྱི་ངོ་བོས་བུམ་པ་ལ་སོགས་པ་གཅིག་ཉིད་དུ་ཐལ་བར་འགྱུར་བས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་དེའི་ཚེ་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "ཅི་སྟེ་གསལ་བའི་ངོ་བོ་རྣམས་གཅིག་ཉིད་དུ་ཐལ་བར་འགྱུར་བས་བསྒྲུབ་ན་དེའི་ཚེ་ཡང་འཁྲུལ་པ་མེད་དོ།",
    "གཞན་ཡང་སྒྲ་མི་རྟག་པ་ཉིད་དུ་དམ་བཅའ་བ་རྗེས་སུ་དཔག་པ་དང་དོན་གྱིས་གོ་བ་དག་གིས་གནོད་པར་སྟོན་ཏོ།",
    "གང་དག་གི་འབྲེལ་པ་བཅོས་མ་མ་ཡིན་པ་དེ་དག་ནི་བཅོས་མ་མ་ཡིན་པ་སྟེ།",
    "དེ་ནི་གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་ཏེ།",
    "བ་ལང་གི་གསལ་བ་གཅིག་ནི་མཐར་ཐུག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་དོན་གྱིས་གོ་བ་ནི་གང་དག་བ་ལང་གི་གསལ་བ་གཅིག་ལ་མངོན་སུམ་དུ་ཕྱོགས་པའི་སྤྱིའི་དུ་མ་གནས་པ་ན་བ་ལང་གི་སྒྲ་ལས་ངེས་པར་གཟུང་བའི་བ་ལང་ཉིད་རྟོགས་པ་དེ་ནི་སྒྲ་རྟག་པ་ཉིད་མེད་པར་འཐད་པ་མ་ཡིན་ནོ།",
    "འདི་སྙམ་དུ་གལ་ཏེ་ཡུན་རིང་མོས་རྟོགས་པ་དེ་ལྟ་ན་ཡང་ཇི་ལྟར་སྒྲའི་དུས་ཐམས་ཅད་དུ་ཡོད་པ་ཉིད་གྲུབ་སྙམ་དུ་སེམས་ན།",
    "དེ་སྙེད་པའི་དུས་ནི་ཐ་དད་པའི་རང་གི་དོན་རྟོགས་པར་བྱེད་པའི་དུས་སོ།",
    "འོན་ཏེ་བུམ་པ་ལ་སོགས་པ་དུས་དེ་སྙེད་དུ་བསྟན་པ་རྣམས་ཀྱང་ཐོ་བ་ལ་སོགས་པ་དག་གིས་ཕྱིས་འཇིག་པ་དེ་བཞིན་དུ་སྒྲ་ཡང་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།",
    "མཐོང་བ་ནི་མངོན་སུམ་མོ།",
    "གཞན་དུ་ན་མ་མཐོང་བ་རྟོག་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "སྣང་བ་མ་བཟུང་བར་དེའི་གསལ་བར་བྱ་བ་བུམ་པ་ལ་སོགས་པ་འཛིན་པར་རིགས་པ་མ་ཡིན་ནོ་སྙམ་དུ་བསམས་ནས་རྩོད་པར་བྱེད་པ་ནི་གང་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གང་གི་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་སྒྲ་ཙམ་འབའ་ཞིག་རྣ་བས་གཟུང་བར་བྱ་བ་མ་ཡིན་པ་དེ་ལྟ་ན་ཡང་སྒྲ་དང་འབྲེལ་པ་འཛིན་པ་ནི་ཡོད་པའི་ཕྱིར་བློ་གཉིས་སུ་འགྱུར་བ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དེ་དག་གི་གསལ་ཁྲུབའོ།",
    "གལ་ཏེ་རང་གི་ངོ་བོ་ཙམ་འཛིན་དུ་ཆུག་མོད།",
    "གང་གི་ཚེ་སྒྲ་ཙམ་ཆེན་པོ་དག་གིས་རྣ་བ་ལ་འདུ་བྱེད་པ་ཆེན་པོ་བྱེད་པ་དེའི་ཚེ་སྒྲ་ལ་ཆེན་པོ་ཉིད་དུ་རྟོགས་ལ།",
    "གང་གི་ཚེ་ཆུང་ངུས་ཆུང་ངུ་ཡིན་པ་དེའི་ཚེ་ཆུང་བ་ཉིད་དོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་འདུ་བྱེད་ཀྱི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་གོང་ནས་གོང་དུ་ཐ་དད་པ་ཡང་སྦྱར་བར་བྱའོ།",
    "འོན་ཏེ་གང་ཆེན་པོ་ལ་སོགས་པ་འཛིན་པ་དེ་ཁྱོད་ཀྱི་ལུགས་ཀྱིས་གསལ་བར་བྱེད་པ་ལ་གནས་པ་ཉིད་ཡིན་གྱི།",
    "ཇི་ལྟར་སྦལ་པའི་ཞག་གིས་མིག་བྱུགས་པས་གདུང་མ་སྦྲུལ་གྱི་ངོ་བོར་མཐོང་སྟེ།",
    "ཇི་ལྟར་གསལ་བར་ཆུང་བ་དང་ཆེ་བ་དག་གིས་དེ་ལ་བརྟེན་པའི་གསལ་བ་ལ་བརྟེན་པའི་སྤྱི་ཆུང་བ་དང་ཆེ་བ་དག་གིས་རྟོགས་པ་ཡིན་ནོ།",
    "ཆེན་པོ་ལ་སོགས་པ་ཐ་དད་པ་ཡོད་པའི་ཕྱིར་རང་གི་ངོ་བོས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ཇི་ལྟར་རྟོགས་པར་བྱ་ཞེ་ན།",
    "དེ་ནོ་ཐམས་ཅད་དུ་སོང་བ་ཡིན་པའི་ཕྱིར་རོ།"
  ]
}