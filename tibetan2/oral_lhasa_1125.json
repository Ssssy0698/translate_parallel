    "དེ་དག་ཉིད་གནོད་པར་བྱེད་པའི་ཕྱིར་གདུག་༡པའོ།",
    "རབ་ཏུ་འཇུག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་གང་དུ་ཚེ་ཇི་སྲིད་པར་གསུངས་པ་དེ་སྲིད་དུ་ཐམས་ཅད་མི་འཐོབ་པའོ།",
    "རྐུ་༩བ་ནི་མ་བྱིན་པར་ལེན་པ་སྟེ།",
    "སྤྱད་པར་བྱ་བས་ན་ལོངས་སྤྱོད་ད་དེ།",
    "དེས་ནི་ཕན་པར་འདོད་པའི་བཤེས་དང་འབྱེ་ཞིང་འབྲལ་བར་འགྱུར་ར་རོ།",
    "འཇིག་རྟེན་ཕ་རོལ་ལ་སོགས་པ་མེད་པའི་རྣམ་པ་ཅན་གྱི་ལྟ་བ་ནི་ལོག་པར་ལྟ་བ་སྟེ།",
    "དེ་ཐོབ་པར་འགྱུར་ཏེ།",
    "ཡང་ལོག་པར་ལྟ་བ་ཁོ་ནར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཀུན་དུ་བསྟེན་༡པས་ན་བསླུས་པ་སྟེ་འཐོབ་པར་འགྱུར་ཞེས་བྱ་བ་ལྷག་མ་ཡིན་ནོ།",
    "དེ་གཉིས་ཀྱི་འབྲས་བུ་ནི་མི་འདོད་པ་འདི་གཉིས་ཡིན་པར་དམིགས་ནས་༐",
    "ཞེ་སྡང་ནི་གསོད་པར་བྱེད་པའི་བདག་ཉིད་ད་དོ།",
    "བདེ་བ་ནི་ཚིམ་པར་བྱེད་པའི་ཚོར་བའོ།",
    "རྒྱས་པ་ཞེས་བྱ་བའི་སྒྲ་ནི་ཐམས་ཅད་ལ་བརྗོད་པར་བྱའོ།",
    "གཟུགས་མེད་པ་ནི་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སོགས་པ་སྙོམས་པར་འཇུག་པ་བཞི་སྟེ།",
    "ནི་ཞེས་བྱ་བའི་སྒྲ་ནི་དེ་ཁོ་ན་ཞེས་བྱ་བ་ངེས་པར་བཟུང་བ་ཡིན་ན་ནོ།",
    "དེ་ཉིད་ངེས་པར་ལེགས་པ་ཡིན་ན་ནོ།",
    "ཕྲ་ཞེས་བྱ་བ་ནི་ཕྲ་བ་སྟེ་རྣམ་པར་ཤེས་པར་༡དཀའ་བ་ཡིན་ན་ནོ།",
    "གང་ལ་ཟབ་པར་སྣང་བ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ་། བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་ཐོས་པ་དང་མི་ལྡན་པ་རྣམས་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་དུ་ནི་ཡོད་པར་མི་འགྱུར་རོ་སྙམ་པ་སྟེ།",
    "གཞན་དུ་༤ཡོད་པར་མི་འགྱུར་རོ་སྙམ་པ་སྟེ།",
    "དེ་ལྟར་རྣམ་པར་རྟོག་པའི་བྱིས་པ་བླུན་པོ་ནི་སྐྲག་པར་འགྱུར་ར་རོ།",
    "ལུང་ཉེ་བར་འགོད་པར།",
    "ཡང་དག་པར་ལྡན་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ལ་དེ་གཅིག་ཏུ་ངེས་པར་གསུང་བའི་ངང་ཚུལ་ཡོད་༢པས་ན་དེ་གསུང་བའོ།",
    "གལ་ཏེ་འདི་༨གཉི་ག་བདེན་པ་ཞིག་ཏུ་གྱུར་ན་བདེན་པ་མཐོང་བའི་དུས་ན་ཡང་འདི་གཉིས་ཡོད་པར་འགྱུར་བ་ཞིག་ན་ཡོད་པ་ཡང་མ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དག་ག་གོ།",
    "བརྫུན་པ་ནི་མི་བདེན་པར་ར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དེ་སྟོན་པར་བྱེད་ད་དེ།",
    "ལྟ་བ་ང་ན་པར་ལྷུང་བས་དམིགས་སོ་ཞེས་བྱ་བ་ཡིན་ན་ནོ།",
    "དེ་ཉིད་དུས་མཉམ་པ་ཉིད་ཡིན་ན་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པའི་ངེས་པ་མི་རུང་བའི་ཕྱིར་ར་རོ།",
    "ཕྲ་བའི་ཕྱིར་དུས་མི་རྟོགས་པར་ཟད་༩ད་དོ།",
    "དེ་ལྟར་བརྟགས་ན་ངར་འཛིན་པ་ནི་ཟད་པར་འགྱུར།",
    "ཅི་སྟེ་ཅིའི་ཕྱིར་འཇིགས་པར་བྱེད་ཅེས་བྱ་བ་ཡིན་ན་ནོ།",
    "དངོས་པོ་ཡིན་པར་༧མི་སྲིད་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་འོ་ན་ཅི་ཞེ་ན་དངོས་པོ་མེད་པ་ཡང་ངོ།",
    "གལ་ཏེ་རྣམ་པ་ཐམས་ཅད་དུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་སྨྲ་༡ན་མེད་པར་ལྟ་བ་ལ་བརྟེན་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ད་ང་བསམ་གཏན་ལ་སོགས་པ་མེད་དོ་ཞེས་ལྟ་བ་ནི་མེད་པར་ལྟ་བ་སྟེ།",
    "མྱ་ངན་ལས་༡འདས་པ་དངོས་པོ་དང་དངོས་པོ་མེད་པར་ཡང་མེད་དོ་ཞེས་དེ་སྐད་དུ་སྨྲ་བས་ཡང་དག་པའི་ལྟ་བ་བསལ་ནས་མེད་པར་ལྟ་བ་ལ་བརྟེན་པའི་ཕྱིར་ལོག་པར་ལྟ་བ་ཁོ་ན་ལ་ཡང་དག་པར་བརྟེན་པར་འགྱུར་རོ་ཞེས་དེ་དགག་པའི་ཕྱིར་མེད་པ་དང་།",
    "མེད་པ་དང་ཡོད་པར་༦ལྟ་བ་ཉེ་བར་ཞི་བའི་ངོ་བོ་དེའི་ཕྱིར་ར་རོ།",
    "འདས་པ་ཞེས་བྱ་བའི་དོན་ཡང་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ན་ཇི་ལྟར་དངོས་པོ་ལ་སོགས་པའི་ངོ་བོ་ཡིན་པར་འགྱུར།",
    "གཞན་ལ་ལྟོས་༩ཏེ་ཡང་མེད་པར་བརྗོད་སོགས་པས་གཟུགས་སུ་རུང་ཞིང་གནོད་པ་བྱར་རུང་བས་ན་གཟུགས་སོ།",
    "ཆུ་མ་ཡིན་པ་ལ་ཆུའི་རྣམ་པར་མཐོང་བས་ས་སོ།",
    "སྨིག་རྒྱུ་ལ་འདི་ནི་ཆུ་ཡིན་ནོ་ཞེས་བྱ་བའི་རྣམ་པར་བསམས་ནས་ཏེ།",
    "གལ་ཏེ་ལན་འགའ་ཞིག་སྨིག་རྒྱུ་དེ་ལ་ཆུ་ཡོད་པར་མཐོང་བར་གྱུར་ན་ནི་ལ་ལར་ཡོད་པར་མཐོང་བས་འདི་ན་མེད་དོ་ཞེས་བྱ་བར་རུང་ངོ།",
    "དེ་བཞིན་དུ་སྨིག་རྒྱུ་ལྟ་བུའི་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་ན་སྨིག་རྒྱུ་དང་འདྲའོ།",
    "གཞན་ལ་ཡོད་པ་གང་ཡིན་པ་སུན་ཕྱུང་བ་བྱས་པ་གང་ཡིན་པ་དེ་ཉིད་དངོས་པོའི་སྟོབས་ཀྱི་༤དོན་གྱིས་མེད་པར་བསླན་དགོས་ཞེས་བྱ་བར་སེམས་ན་དེ་དྲང་བའམ་འཐོབ་༥པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟར་ཐབས་དེས་མེད་པ་པ་ཉིད་ཀྱི་དོན་རྒྱས་པར་བཀག་པས་ན།",
    "དེ་ཡང་བསམ་གཏན་དང་འདོན་༡པ་ལྷུར་ལེན་པའི་ཚངས་པར་སྤྱོད་པ་ལ་སོགས་པའི་ཡོན་ཏན་གྱིས་བརྒྱན་པ་ལ་མེད་དོ།",
    "འོན་ཏེ་རྙེད་པ་དང་བཀུར་སྟི་རྣམ་པར་ཆད་ཀྱིས་དོགས་པས་ཉེས་༢པར་སྤྱོད་པ་བོར་ནས་ལེགས་པར་སྤྱད་པ་སྤྱོད་དུ་ཟད།",
    "སེམས་ནི་མེད་པར་ལྟ་བས་གནས་སོ་ཞེ་ན།",
    "འགྱུར་བའི་ཚོགས་ལ་ནི་ཡང་དག་པར་ན་མེད་པ་ཉིད་དུ་ཤེས་ཏེ།",
    "གོས་མེད་པ་རྣམས་ཀྱང་ཡིན་པར་སྨྲ་བ་སྟེ།",
    "ཐམས་ཅད་དུ་ཟད་པས་སྐད་ཅིག་མ་ཡིན་པར་ཡང་རྟག་པར་སྨྲ་བ་རྣམས་མི་འདོད་པས་རྣམ་པ་གཉི་ག་ཡང་༐",
    "ཡང་དག་པར་ན་མི་འཐད་པའི་ཕྱིར་དེ་ལྟར་སྐད་ཅིག་མ་མ་ཡིན་ན་ནོ།",
    "ཇི་ལྟར་མེད་ཅེས་བརྗོད་པར་བྱ།",
    "འདི་ནི་དེ་ཁོ་ན་ཉིད་བསམ་པར་བརྗོད་པ་ཡིན་ན་ནོ།",
    "བརྟག་དགོས་ཞེས་བྱ་བ་འདིས་ནི་འདི་རྟོག་པས་༦ཀུན་ནས་བསླང་བ་ཐ་སྙད་༧པ་ཡིན་གྱི་ཡང་དག་པ་ནི་མ་ཡིན་ནོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "ཇི་ལྟར་སྐད་ཅིག་མའི་ཐ་མ་ལ་སོགས་པ་ལ་བསམ་པ་བྱས་པ་དེ་བཞིན་དུ་ཐོག་མ་ལ་སོགས་པ་ལ་ཡང་བྱའོ།",
    "དེ་ལྟ་ཡིན་ན་མེད་པར་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དུ་མ་ནི་གཅིག་ལ་ལྟོས་༡ནས་ཡིན་གྱི་དེ་མེད་པར་ནི་མ་ཡིན་པས་གཅིག་ཀྱང་མེད་ལ་དུ་མ་ཡང་མེད་ད་དོ།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་གཅིག་ཁས་བླངས་པར་གྱུར་ན་ནི་དེ་ལ་ལྟོས་༢ིནས་དེར་༤འགྱུར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "མེད་པ་ཉིད་ནི་དེ་ལྟ་ཡིན་པར་འགྱུར་གྲང་ན།"
  ]
}