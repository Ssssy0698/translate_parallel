    "ཡུལ་དོན་སློབ་དཔོན་བྱེ་བྲག་གིས།",
    "དགེ་སློང་གི་ལོ་དྲི་བ་ལས་ཀྱང་།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱི་རྨི་ལམ་དུ།",
    "བདུད་སྡིག་ཏོ་ཅན་དགེ་སྦྱོང་གི་ཆ་བྱད་འཛིན་པ་ཞིག་གིས།",
    "ཞེས་རྒོལ་ན་ལན་གདབ་པར་དཀའ་བ་ཡིན་མོད།",
    "གྱེས་པ་བཅོ་བརྒྱད་ཀྱི་རྩོད་པ་ཞི་བར་བྱས་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ལ།",
    "དགོས་པ་གང་གཙོ་བརྟག་དགོས་མོད།",
    "ཟུར་བཅག་གི་སྐད་དང་།",
    "འབྲིང་དུ་འདོན་པའི་ཚིག་གི་ཐ་སྙད་བརྗོད་པའི་ཕྱིར།",
    "གོང་དུ་བཀོད་པའི་རྟོག་དཔྱོད་ཞིབ་མོ་དེ་དག་ལ་བརྟགས་ནས་དཔྱད་པར་བྱའོ།",
    "དགེ་སློང་གིས་དགེ་སློང་ལ་བྱིན་ལེན་རུང་བ་མེད་ན།",
    "མིང་གི་རྣམ་གྲངས་ཡིན།",
    "དགེ་སློང་རྣམ་དག་ཏུ་ཐལ།",
    "དགེ་སློང་རྣམ་དག་ལ་བྱིན་ལེན་སྟོབ་པ་པོའི་གང་ཟག་ཏུ་མི་རུང་བར་ཐལ།",
    "འབྲས་བུ་བདེ་སྡུག་གི་བྱེད་པ་པོ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་ཏེ།",
    "དེའི་རྣམ་སྨིན་ངན་སོང་མི་འབྱིན་ལ།",
    "དགེ་སློང་གིས་རྐྱེན་དགོས་ལ་མ་ལྟོས་པར།",
    "ཕྱི་དྲོའི་ཁ་ཟས་ཟོས་པས་རྣམ་སྨིན་ངན་སོང་འབྱིན་པའི་ཁྱད་པར་དེ།",
    "ཀུན་སློང་ཉོན་མོངས་པ་ཅན་ཁོ་ནས་ངེས་པར་བྱེད་དགོས་པ་དང་།",
    "རང་བཞིན་དང་འབྲེལ་བའི་བཅས་ལྟུང་གི་བྱ་བ་དེ།",
    "སྡུག་བསྔལ་གྱི་རྒྱུ་ནི་ཉོན་མོངས་པ་དང་།",
    "ཀུན་སློང་ཉོན་མོངས་པ་ཅན་གྱིས་བྱས་པ་ཞེ་སྡང་གིས་ཀུན་ནས་བསླང་ནས་ས་བརྐོས་པ་ལྟ་བུ་དང་།",
    "འདོད་པའི་ཉོན་མོངས་པས་ཀུན་ནས་བསླང་བའི་ལུས་ངག་གང་རུང་གི་ལས་སུ་དམིགས་པའི་ཕྱིར།",
    "ཉོན་མོངས་པས་ཀུན་ནས་བསླང་བ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེ་འདྲ་དེ་དགེ་སློང་གིས་སྤྱད་པ་ན།",
    "དེའི་ཤེས་བྱེད་ཀྱང་སྡུག་བསྔལ་གྱི་རྒྱུ་ནི་ཉོན་མོངས་པ་དང་།",
    "སྤྱི་ཁྱབ་ནས་ལུས་ངག་གི་བཅས་པ་རྐྱང་པ་དེ་དང་དེ་དག་བསྲུངས་པས།",
    "དེ་དང་དེའི་ཀུན་སློང་དུ་དགོས་པའི་ཉོན་མོངས་པ་དེ་དང་དེ་དག་དང་དུ་མི་ལེན་པའི་ཚུལ་གྱིས་འགོག་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེའི་ཀུན་སློང་དུ་ཉོན་མོངས་པ་དགོས་པའི་ངེས་པ་མེད་པའི་ཕྱིར།",
    "དེའི་ཀུན་སློང་གི་སྤྱི་བཀག་པས།",
    "བྱེ་བྲག་ཉོན་མོངས་པ་ཅན་ཁེགས་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "བཅས་ལྟུང་རང་གི་ངོ་བོ་ལུང་མ་བསྟན་ཞིག་ཀྱང་།",
    "རྫུན་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར།",
    "གསོ་སྦྱོང་གི་ཚེ་ཅང་མི་སྨྲ་བས་འདའ་བར་བྱེད་ན།",
    "ཀུན་སློང་གི་ཉེས་པ་འགོག་པའི་ཕྱིར་དུ་སྤང་དགོས་པ་ནི་མ་ཡིན་ཏེ།",
    "རབ་བྱུང་གི་སྡོམ་ལྡན་ལ་ཕྱི་དྲོའི་ཁ་ཟས་བཀག་པས།",
    "དེའི་ཀུན་སློང་ཉོན་མོངས་པ་ཅན་སྤྱིར་ཁེགས་པ་ཡིན་ཀྱང་།",
    "དེའི་ཚེ་ན་ཀུན་སློང་ཉོན་མོངས་པ་ཅན་གྱིས་མ་བྱས་པས།",
    "དེས་ན་ཉོན་མོངས་པ་ཅན་གྱིས་ཀུན་ནས་བསླང་བའི་བཅས་རྐྱང་རྣམས་ལ་དུས་དྲན་གྱི་སྒོ་ནས་གནང་བ་མེད་དོ།",
    "ཁྱིམ་པ་རང་གིས་མ་བྱས་ཀྱང་།",
    "དགེ་སློང་གི་ནི་བྱ་བ་རྣམས།",
    "ལུས་དང་ངག་གིས་བཅས་པ་རྣམས།",
    "བསྲུངས་པས་དེ་ཡི་ཀུན་སློང་གི།",
    "ཉོན་མོངས་གསུམ་པོ་འགག་པར་འགྱུར།",
    "རྒྱ་མཚོ་ཇི་བཞིན་ངང་གིས་གང་།",
    "ཡེ་བཀག་དང་ཡེ་གནང་འགོག་པའི་སྐབས་ཀྱི་གཞུང་གི་དོན་མ་ལུས་པ་དཔྱིས་ཕྱིན་པ་ཉིད་དུ་འཆད་ཤེས་པར་འགྱུར་རོ།",
    "བྱེ་བྲག་ཏུ་ངན་སོང་གི་སྡུག་བསྔལ་གྱི་རྒྱུ་ཉོན་མོངས་པ་དང་།",
    "ཀུན་སློང་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་སེམས་ཀྱིས།",
    "དེས་ངན་སོང་དུ་སྐྱེ་བའི་རྒྱུ་ཉོན་མོངས་པ་ཅན་གྱི་ལས་བསགས་པར་འགྱུར་ཏེ།",
    "སྨོན་སེམས་གཏོང་བྱེད་ཀྱི་ཀུན་སློང་དུ་ཉོན་མོངས་པ་ཅན་དགོས་པ་མ་ཡིན་ཏེ།",
    "རྣམ་སྨིན་ངན་སོང་གི་ཕུང་པོ་འབྱུང་དུ་རུང་བར་འགྱུར་ཏེ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་དང་།",
    "བདག་གི་འགྲོ་བ་ཅི་འདྲར་འགྱུར།",
    "བྱེ་བྲག་ངན་སོང་གི་རྒྱུ་ཚོགས་གྲངས་ཚང་བ་མ་ཡིན་ཏེ།",
    "སྨོན་སེམས་བཏང་བའི་འོག་ཏུ་ལན་གཅིག་ངན་སོང་དུ་སྐྱེས་ནས།",
    "གཞན་དོན་དུ་དགེ་སློང་གི་སྡོམ་པ་ལ་ལྟོས་པའི་ཕམ་པ་བཞི་སྤྱད་པ་གཅིག་སྲིད་པ་དེ་ཡང་།",
    "བཟོད་པ་མ་ཐོབ་གོང་དུ་ཡིན་ན་ངན་སོང་འཕེན་འགྲུབ་ཀྱི་རྒྱུར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེའི་རྒྱུར་འགྱུར་བ་ལ་ཡན་ལག་གི་རྩི་བ་རྣམ་པར་གཞག་པ་ཇི་ཙམ་དགོས་པ་དེ་དག་ཚང་བའི་ཕྱིར་དང་།",
    "སྡོམ་གསུམ་བསྟན་བཅོས་འཛམ་གླིང་གི།",
    "གཉིས་པོ་གང་གི་ལུགས་དང་མཐུན།",
    "སྤྱིར་རྗེ་བཙུན་ས་སྐྱ་པའི་གསུང་གིས།",
    "དཀྱིལ་ཆོག་གི་རྒྱ་གཞུང་སོ་སོ་ནས་སེམས་སྐྱེད་ཀྱི་སྡོམ་པ་ལེན་པའི་ཆོ་ག་གསུངས་པ་རྣམས།",
    "བོད་ཕྱི་རབས་པ་གཞན་དག་གིས་ཉེས་པ་བརྗོད་པ་དེ་དག་སྤང་བར་དཀའ་ཞིང་།",
    "གཉིས་པོའི་ཁྱད་པར་ལྟ་བས་འབྱེད་པར་ཐལ་ལོ་སྙམ་པ་དང་།",
    "སེམས་སྐྱེད་གཉིས་པོ་སོ་སོའི་ཡན་ལག་ཏུ་དབུ་སེམས་ཀྱི་ལྟ་བ་རྟོགས་དགོས་པར་ཐལ་ལོ་སྙམ་པ་དང་།",
