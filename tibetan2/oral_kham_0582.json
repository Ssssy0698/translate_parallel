    "ལས་དེ་ལས་ཉམས་པ་དེའི་ཚེ་ནི་འོག་མིན་འགྲོ་ཞེས་མི་བྱ་སྟེ།",
    "དེ་འདྲ་དེ་ཚངས་རིས་སུ་སྐྱེས་ནས་སྔར་གྱི་སྤེལ་སྒོམ་སོར་ཆུད་པར་བྱས་པ་དེའི་ཚེ་ཡང་འོག་མིན་འགྲོ་ཞེས་མི་བྱ་སྟེ་དེར་སྐྱེ་བའི་ལན་གྲངས་གཞན་ལ་མྱོང་འགྱུར་གྱི་ལས་དང་མི་ལྡན་པའི་ཕྱིར།",
    "འོག་མིན་འགྲོ་ནི་འཕར་གསུམ་གྱི་དབྱེ་གཞི་ཡིན་པས་ལོགས་སུ་མི་བགྲང་བར་དགྲ་བཅོམ་ཞུགས་པ་ཁ་སྐང་སྟེ།",
    "དབྱེ་ན་འོག་མིན་འགྲོ་དང་།",
    "དེའི་ཤེས་བྱེད་ཀྱང་རང་རྒྱུད་ལ་ལྡན་པའི་གང་ཟག་དེ་རྟོགས་པ་མཐར་ཐུག་པའི་གནས་སུ་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་དང་།",
    "དག་པ་པ་ཡིན་ཀྱང་རང་སའི་སྲེད་པས་རོ་མྱང་བ་དང་བྲལ་བ་དེའི་ཚེ་ནི་རྒྱུའི་སྙོམས་འཇུག་ཏུ་མི་བཞག་སྟེ།",
    "དེ་ཡང་རང་དོན་མཐར་ཐུག་པ་ནི་ངོ་བོ་ཉིད་ཀྱི་སྐུ་དང་།",
    "དེར་གྲུབ་པ་ན་ཁ་ཕྱིར་ལྟའི་ཤེས་པ་རྣམས་ཀྱང་རང་། ། རིག་པར་གྲུབ་པའི་ཚུལ་རྒྱས་པར་གསུངས་པ་བཞིན་ནོ།",
    "དེ་དག་ཀྱང་རང་རྒྱལ་གྱིས་ཤེས་བྱ་ཡོངས་སུ་དཔྱོད་པའི་གེགས་ཡིན་གྱི།",
    "དེ་མ་ཡིན་ཀྱང་རང་ཤུགས་ཀྱིས་རྒྱུན་ཆད་པར་འདོད་ན་འདས་ལམ་དེ་དེ་སྐབས་ཀྱི་དགག་བྱ་འགོག་བྱེད་དུ་འགལ་ཏེ། ། འགོག་བྱེད་ཀྱི་ལམ་རྒྱུན་ཆད་ན་དེའི་དགག་བྱ་འགོག་མི་ནུས་པའི་ཕྱིར།",
    "ཤཱ་རིའི་བུ་བྱང་ཆེན་བྱམས་པ་འདི་མངོན་སུམ་དུ་འདུག་ན།",
    "ཁྱེད་རང་ལྟར་ན་འགོག་པ་ནས་སྲིད་རྩེར་ནུད་པ་གང་ཞིག།",
    "དེ་ཉིད་ལ་ཡང་རང་བཞིན་གྱི་སྐུ་གཉིས་སུ་འབྱེད་པ་མི་འགལ་ཏེ།",
    "དེ་ནས་སུ་བྷ་ཝའི་སྔགས་ཀྱིས་རང་འདུག་པའི་གནས་སྟོང་པར་བསྒོམ།",
    "ཕྱོགས་དང་དུས་ཀྱིས་ཕྱེ་ཙ་ན་གཅིག་ཏུ་མ་གྲུབ་ཅིང་།",
    "ཡོད་པ་མེད་ཙ་ན་དེ་ལ་ལྟོས་པ་མེད་པ་མི་འགྲུབ་པས།",
    "མ་ཐུབ་ཙ་ན་དལ་བུས་གཏང་ངོ།",
    "ཡེ་ཤེས་མཁའ་འགྲོའི་ང་རྒྱལ་དང་ལྡན་པས་ཁམས་ཆ་མཉམ་ལུས་ཙོག་པུར་འདུག་ལ།",
    "དབུགས་ཕྱིར་རྒྱུ་ཙ་ན་དེའི་འོད་ཀྱིས་རྩ་སུམ་ཅུ་རྩ་གཉིས་པོ་ཐམས་ཅད་གསལ་གདབ།",
    "གེལ་བའི་འདུག་སྟངས་ཀྱིས་རོའི་སྟེང་ན་བཞུགས་པ།",
    "ཡང་རང་ཉིད་ནག་པོ་ཆེན་པོར་གསལ་བའི་ཐུགས་ཀའི་ཧཱུྃ་ཡིག་ལས་འོད་ཟེར་དཔག་ཏུ་མེད་པ་འཕྲོས།",
    "ཡང་རང་ཉིད་ནག་པོ་ཆེན་པོར་གསལ་བའི་ཐུགས་ཀའི་ཧཱུྃ་ལས་འོད་ཟེར་དཔག་ཏུ་མེད་པ་འཕྲོས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཁྲི་ཆེན་པོ་ལ་འདུག་པ།",
    "སྤྱི་བོ་ཚུགས་སུ་འདུག་པ་བསྐྱེད།",
    "ཅེས་ཐུན་བཞི་ལ་སོགས་པར་འབད་ན་གནོད་པའང་རང་ཞི་ལ་འགྲོ།",
    "སླར་ཡང་རང་ཉིད་ཁྲོས་པའི་ཞབས་བརྡབས།",
    "དེ་ལྟ་བུའི་ཚུལ་གྱིས་བསྙེན་པ་ལེགས་པར་ཐིམས་ནས་བསྟན་པ་དང་རང་གཞན་གྱི་དོན་དུ་ལས་ཀྱི་ཚོགས་རབ་འབྱམས་བསྒྲུབ་པ་ལ་ཞེ་གསུམ།",
    "མཐར་མདུན་གྱི་ཡབ་ཡུམ་ཡང་རང་ལ་བསྟིམས་ལ།",
    "གང་ལྟར་ཡང་རང་དང་རིག་མ་འཁོར་ལོ་བདེ་མཆོག་ཡབ་ཡུམ་གྱི་གསལ་སྣང་ལྷག་པར་བརྟན་པས་ཡབ་ཡུམ་གྱི་བཞིན་རས་མཆོག་ཏུ་མཛེས་ཤིང་ཡིད་དུ་འོང་བ་སོགས་སྐྱེ་མཆེད་ཕུན་སུམ་ཚོགས་པ་ལ་ཕན་ཚུན་ཆགས་པའི་ཟུར་མིག་གཡོ་བས་བལྟས་པས་བདེ་བ་སྐྱེས་པ་ན།",
    "ཨ་ལས་ཟླ་སྟེང་རང་སེམས་ཧིདམར་པོ།",
    "མདུན་བསྐྱེད་རང་ལ་བསྟིམ་ཞིང་རང་ཡན་ལག་བཞི་རྫོགས་ཀྱི་ལྷར་གསལ་བས་རྣལ་འབྱོར།",
    "ཉལ་ལྡང་ཁ་ཟས་འགྲོ་འདུག་ལ་སོགས་པ་ལམ་དུ་འགྱུར་བའི་ཐབས་ཀྱི་རྣལ་འབྱོར་བསྐྱེད་རིམ་སྤྱིའི་རིག་པས་འཕྲུལ་ཤེས་པར་བྱའོ།",
    "དེའང་རང་ལུས་ལྷ་སྐུ་སྣང་སྟོང་སྒྱུ་མ་དང་།",
    "གཉིས་སྣང་རང་གྲོལ་གྱི་ཉམས་མྱོང་ལ་བརྟེན་པ་ཐོབ་པའི་རྟོགས་པ་དང་འབྲེལ་བའི་ལྟ་བས་བསྐྱེད་རྫོགས་ཀྱི་རྣལ་འབྱོར་ཐམས་ཅད་ལ་རྒྱས་ཐེབ་པར་བྱ་བ་ནི།",
    "དུར་ཁྲོད་ཀྱི་རས་ལ་ཉེ་བར་འདུག་ནས་སྔགས་བཟླ་ཞིང་དྲལ་ཏེ།",
    "འདུག་དང་ཁྲོ་དང་དགོད་པ་དང་།",
    "རང་རང་འཐོབ་བྱའི་འབྲས་བུ་ལ་དམིགས་ནས།",
    "རྒྱུད་གཞུང་ཀུན་ལས་བསྔགས་ཤིང་རང་རིག་པའི།",
    "གང་དེས་སྤྲུལ་པའི་ཚོགས་དང་རང་རྒྱུད་པའི།",
    "ཅིར་སྣང་རང་སེམས་སྣང་བ་རང་རིག་པ།",
    "རང་རང་གཞུང་བཞིན་ལེན་དང་གཏོང་བའི་རྒྱུ་ནི།",
    "དང་པོ་ཉིད་ནས་རང་རང་ལམ་འཇུག་དང་།",
    "སེམས་དང་ན་ཆུང་སེམས་བྱུང་རང་གསལ་སྐད་ཅིག་མ།",
    "ཀུན་ཀྱང་རང་རང་ལུགས་ཀྱི་ཀུན་རྫོབ་ཀྱི།",
    "ནུས་པའི་མཐུ་དང་རང་བཞིན་ནོ།",
