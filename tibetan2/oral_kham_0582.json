    "ཉིན་བཅོ་ལྔའི་སྔོན་དུ་ང་རང་ཡུལ་དུ་ཕྱིན་པ་ཡིན།",
    "སྤྱི་སྤྱོད་རླངས་འཁོར་འདི་མིས་བཀང་འདུག་སྤྲོ་སྤྲོ།",
    "ཁོ་རང་ལམ་སང་ཁྱིམ་དུ་ལོག་མ་འདོད།",
    "རྟ་རྣམས་ཀྱིས་རྩྭ་ཟ་བཞིན་འདུག་མགོ་ལོག་ཏུ་རྩྭ་ཐང་ཡངས་པོ་ཡོད།",
    "ཆུ་ཚོད་ཕྱེད་ཀ་ཆུ་ཚོད་ཕྱེད་ཀའི་རྗེས་སུ་ང་རང་ཡུལ་དུ་ལོག་རྒྱུ་ཡིན།",
    "ཁོ་རང་ཉིད།",
    "རྒྱ་ལམ་སྟེང་དུ་དོན་རྐྱེན་ཡ་ང་བ་ཞིག་བྱུང་འདུག་རྟ།",
    "ང་རང་ལོ་བཅུ་ཡིན།",
    "ང་རང་སྐས་ལ་འཛེགས་ཏེ་ཁང་བའི་ཀླད་དུ་འགྲོ་རྒྱུ་ཡིན།",
    "ཟླ་གཅིག་མི་འགོར་བར་ང་རང་ལོ་བཅུ་གསུམ་ལོན་འགྲོ།",
    "ཇ་དེམ་ལས་གཤེར་ཁུ་འཕྱུར་བཞིན་འདུག་ཐོ་འགོད་བྱེད་པ།",
    "ང་རང་སྒྲ་སྡུད་འཕྲུལ་འཁོར་ནས་རོལ་དབྱངས་ལ་ཉན་པར་དགའ་ངེས་པར་དུ།",
    "ང་རང་དེ་ངོ་མ་ཡིན་པར་ཡིད་ཆེས་དཀའ།",
    "ཡུལ་དུ་ལོག་པའི་ལམ་དུ་ང་རང་ཐང་ལ་འགྱེལ་ནས་ལག་པའི་མཁྲིག་མ་རྨས།",
    "ཐེངས་ཤིག་ཐེངས་ཤིག་ལ་ང་རང་ཧ་ཅང་ན་བྱུང་།",
    "འོན་ཀྱང་ང་རང་གཏན་ནས་མི་འཐད།",
    "ང་རང་མི་གཞན་དང་མཉམ་དུ་འདུག་པར་དགའ།",
    "ང་རང་སང་ཉིན་མ་འོང་ན་བཟང་ཡང་སྲིད།",
    "ག་དུས་ཡིན་ཡང་ཡིད་སེམས་འཁྲུགས་པོ་བྱུང་ཚེ།",
    "གཏམ་བརྗོད་པས་དྲིལ་བསྒྲགས་ཀྱི་དགེ་མཚན་གླེང་བཞིན་འདུག་རྒྱུ་ནོར།",
    "ཁོ་ཚོས་སོ་སོར་འདུག་རྒྱུ་ཐག་གཅོད་བྱས།",
    "རང་བྱུང་རང་རིག་གསལ་སྟོང་ཟུང་དུ་འཇུག།",
    "འགྲོ་འདུག་ཟ་ཉལ་སྨྲ་བརྗོད་ཅི་བྱེད་ཀུན།",
    "ཡིན་ཀྱང་རང་སྐལ་བྱང་ལྟའི་བྱ་སྐྱིབས་ཅན།",
    "འོན་ཀྱང་རང་སེམས་དཀར་བའི་ཨཱ་དརྴ།",
    "སེམས་ཀྱི་འདུག་ཚུལ་འཆར་ཚུལ་གང་ཡིན་དེ།",
    "འགྲོ་འདུག་བྱ་བྱེད་ཀུན་དང་བསྲེ་ཐུབ་ན།",
    "ལུས་བཏུད་པས་ནི་སྤྱན་སྔར་འདུག།",
    "ཁོ་ན་ཊབད་ན་བྱག་སྤྱི་རྣམ་མཁན་ལྟར་མ་བྱས་སུ་སྐལ་ལོ་ཞེས་འགོག་ལོ་བྱསུ་ར་ནི་ལེན་མ་སྒོཙ་ནའི་མདའ་སྟེ།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག་པ་དང་།",
    "ཁམས་ཀྱི་དབྱེ་བ་དང་རང་བཞིན།",
    "བདག་ཕུང་རང་བཞིན་གཅིག་པ་དགག་པ་དང་།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ།",
    "བྱ་བ་དང་རང་བཞིན་གྱིས་ལྡན་པར་ཡོད་པའི་རྐྱེན་ཀྱང་འོན་ཏེ་ན་ཞེས་པ་མེད་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར་རོ།",
    "འགྲོ་བར་རྩོམ་པའི་ལམ་གསུམ་པོ་གང་ཡང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར་རོ།",
    "ལྡོག་ས་གསུམ་པོ་གང་ལས་ཀྱང་རང་བཞིན་གྱིས་མི་ལྡོག་པའི་ཕྱིར་རོ།",
    "འགྲོ་བ་པོ་ཡིན་པར་གྱུར་པ་དེ་འགྲོ་སའི་ལམ་རྣམ་པ་གསུམ་པོ་གང་དུའང་རང་བཞིན་གྱིས་འགྲོ་བར་མི་བྱེད་ལ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག་པ།",
    "དེ་ཡོད་པའི་ཕྱིར་གཟུགས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་ཅེས་ལན་འདེབས་ཤིང་སྨྲ་བར་བྱེད་པ་དེ་ཡིས་ཐམས་ཅད་དུ་ཡང་དག་པའི་ལན་བཏབ་པ་མིན་ཏེ།",
    "སྒྲུབ་བྱེད་བསྒྲུབ་བྱ་མཚུངས་པས་ལྟར་གྱིས་ཡོད་པའི་ཕྱིར་གཟུགས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་ཅེས་སྨྲ་བར་བྱེད་པ་དེ་ཡིས་བྱས་པའི་ཚེ་རྒོལ་བ་གང་ཞིག་སྐྱོན་གདགས་པའི་བསམ་པས་ཚོར་བ་ལྟ་བུ་རང་བཞིན་རབ་ཏུ་བྱེད་པ་བཞི་པའོ།",
    "མཚན་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་ཉིད་མ་ཡིན་ཏེ།",
    "སྔར་རྒྱས་པར་བཀག་པ་དེའི་ཕྱིར་ནམ་མཁའི་ཁམས་ནི་དངོས་པོ་དུའང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར་ཞེས་པའོ།",
    "མུན་པ་སེལ་བའི་སྒོ་མེ་དང་ནི་ཡུལ་གང་དག་ན་མར་མེ་དེ་འདུག་ཅིང་འོད་ཀྱིས་ཁྱབ་པ་ནའང་མུན་པ་མེད་པས་དགག་པའོ།",
    "བའང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉི་གའི་སྐྱེད་བྱེད་དུ་འགྱུར་བས་སྐྱེ་སོགས་གཞན་ལྟར་ཏེ་དཔེར་ན་མར་མེས་རང་དང་གཞན་གཉིས་ཀ་སྣང་བར་བྱེད་པ་དེ་བཞིན་དུ་སྐྱེ་བྱེད་དུ་རང་བཞིན་གྱིས་གྲུབ་ན་ཐམས་ཅད་དུ་འབྲལ་མི་རུང་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉི་ག་སྒྲིབ་པར་འགྱུར་བ་ཐེ་ཚོམ་མེད་པར་འདོད་དགོས་པར་འགྱུར་ཏེ་མཚུངས་པའི་ཕྱིར་རོ།",
    "ཉིད་སོགས་ཀྱང་རང་བཞིན་གྱིས་མེད་དོ།",
    "བྱེད་པོ་ཡིན་པས་ལས་ཡིན་པ་བྱས་ན་བྱེད་པ་པོ་ལས་དོན་གཞན་པའི་བྱ་བ་ཡོད་མི་དགོས་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱོགས་ལྟར་ན་དགོས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱོགས་ལྟར་མའི་ལམ་དུ་ཞུགས་པའི་ཕྱིར་རོ།",
    "ལྟོས་ཀྱང་རང་བཞིན་ཡོད་པ་མི་འགལ་ཏེ།",
    "སྡུག་བསྔལ་ནི་བྱིན་པའི་གང་ཟག་དང་ལེན་པའི་གང་ཟག་གང་ལ་ལྟོས་ཀྱང་རང་བཞིན་གྱིས་གཞན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕྲད་བཞིན་པ་དང་ཕྲད་པ་དང་ཕྲད་པ་པོ་ཡང་རང་བཞིན་གྱིས་མེད་པས་བུམ་པ་དེ་ཉིད་དེ་དང་ཕྲད་པ་མེད་ལ།",
    "གཞན་དང་གཞན་ཡང་རང་བཞིན་གྱིས་༣༦བ་གཉིས་པ་ལ་གཉིས།",
    "དེ་ལྟ་ནའང་རང་བཞིན་ནི་རྒྱུ་རྐྱེན་གྱིས་བྱས་པ་ཅན་ཡིན་ཞེས་ཇི་ལྟ་བུར་ན་རུང་བར་འགྱུར་ཏེ།",
    "སྐད་ཅིག་དང་རྒྱུན་གང་ཡང་རང་བཞིན་གཉིས་པ་ནི།",
    "ཁམས་ཀྱི་དབྱེ་བ་དང་རང་བཞིན།",
    "རྐྱེན་མིན་ལས་བྱུང་བ་ནི་ཐ་སྙད་དུའང་ཡོད་པ་མིན་པ་དེའི་ཕྱིར་ལས་སུ་མ་ཟད་བྱེད་པ་པོ་ཡང་རང་བཞིན་གྱིས་མེད་ལ།",
    "དེ་ལྟ་ནའང་རྟེན་དངོས་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་འདོད་དགོས་ཏེ།",
    "དེ་ལྟར་རྒྱུས་འབྲས་བུ་རང་བཞིན་གྱིས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ན་རྒྱུ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་འཐད་པར་མི་འགྱུར་ལ།",
    "གལ་ཏེ་གཞན་ལ་བརྟེན་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་མི་གཞན་དངོས་ནི་རང་དང་གཞན་གྱི་རྣམ་གྲངས་སོ།",
    "དུའང་རང་བཞིན་གྱིས་གདགས་པར་མི་ནུས་ཏེ།",
    "སྡུག་མི་སྡུག་གཉིས་རང་བཞིན་མེད་པས་ཆགས་སྡང་རང་བཞིན་ཡོད་པ་དགག་པའོ།",
    "ཕྱིན་ཅི་ལོག་དང་མེད་པའི་ཕྱིར་ཆགས་སྡང་རང་བཞིན་གྱིས་མེད་ཅེས་པའོ།",
    "དེའི་རྒྱུ་ཅན་གྱི་ཞེ་སྡང་རང་བཞིན་གྱིས་ཡོད་པར་ག་ལ་འདོད་ཆགས་རང་བཞིན་གྱིས་ཡོད་པར་ག་ལ་འགྱུར་ཏེ་མི་འགྱུར་ཞིང་།",
    "ལོག་པར་འཛིན་པའམ་ཡང་དག་པ་ཉིད་དུ་འཛིན་པ་གང་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ན།",
    "ཀུན་འབྱུང་རང་བཞིན་ཉིད་ཀྱིས་ནི།",
    "གཞན་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ལ་གནོད་པ་བྱེད་ན་བུམ་པ་སོགས་དངོས་པོ་ཐམས་ཅད་མ་བྱས་པར་ཡོད་པར་འགྱུར་བར་དེ་ལྟ་ན་བུམ་པ་བཟོ་བ་སོགས་བྱ་བ་ཅི་ཡང་མེད་པར་འགྱུར་ཞིང་།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་གྲུབ་པ་སྤྱིར་དགག།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་དཔེའོ།",
    "དེ་ཚུལ་ཡང་རང་བཞིན་གྱིས་ཡོད་ན་གཞན་དུ་འགྱུར་བ་མི་རིགས་པས་རྟག་ལ།",
    "ཕན་ཚུན་ལས་ཀྱང་རང་བཞིན་ཡོད་པར་མ་གྲུབ་སྟེ།",
    "དེ་ཡང་རང་བཞིན་གྲུབ་པའི་ཕྱོགས་ལ་གཅིག་དུས་སུ་གཅིག་ཡོད་དགོས་པར་རིགས་པས་འཕུལ་བ་ཡིན་གྱི་རང་ལུགས་ལ་མ་ཡིན་པའི་ཚུལ་ཤེས་པར་བྱའོ།",
    "ལས་རང་བཞིན་རྣམས་གོ་དཀའ་བར་འདུག་པས་ཡི་གེ་ཆད་ལྷག་བྱུང་བ་ཡིན་ནམ་ད་དུང་དཔྱད་དོ།",
    "མ་ཡིན་ཏེ་རྟགས་སུ་སྨྲས་པའི་རྟོག་བློ་དེའང་རང་བཞིན་མེད་པས་བསྒྲུབ་བྱ་དང་མཚུངས་པའི་ཕྱིར་རོ།",
    "འདུས་པའང་རང་བཞིན་གྱིས་འདུས་པས་མི་འདུས་པའི་སྐབས་མེད་ཅིང་།",
    "ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་པས་རྣམ་པར་ཤེས་པ་ཡང་མེད་དོ།",
    "རྟེན་འབྱུང་དང་རང་བཞིན་འགལ་བར་བསྟན་ནས་འགོག་པ་ཡིན་ལ།",
    "འདིར་འགྲེལ་པ་རྣམས་ཀྱིས་རྩ་བའི་དགོངས་པ་དཔྱིས་ཕྱིན་པ་མ་ཐོན་པར་འདུག་པས་རང་འགྲེལ་དང་ཟླ་བའི་འགྲེལ་པ་དེ་དག་དངོས་ཡིན་མིན་ཐེ་ཚོམ་གྱི་གཞིར་སྣང་ཞིང་།",
    "དེའང་རང་བཞིན་མེད་ཅེས་བྱ་བའང་མེད།",
    "རྐང་པ་གཉིས་པའི་འགྱུར་མ་དག་པར་མེད་པ་དེ་ཡང་རང་བཞིན་མེད་པར་འགྱུར་ལ།",
    "ཡང་འགོག་བྱེད་ཕྱིས་ལ་དགག་བྱ་སྔ་བའང་མི་འཐད་ཅིང་དགག་བྱ་དང་འགོག་བྱེད་ཅིག་ཅར་ཡང་མི་འཐད་པའི་ཕྱིར་དེས་ཀྱང་རང་བཞིན་མེད་པ་མི་འགྲུབ་བོ།",
    "འགོག་བྱེད་ཀྱི་ཚིག་ཀྱང་རང་བཞིན་མེད་པ་ཉིད་ཀྱིས་མ་ངེས་གང་ལ་ཡང་མེད་པས།",
    "མེ་བཞིན་དུ་མུན་པ་ཡང་རང་གཞན་གཉིས་ཀ་བདག་ཉིད་ལ་སྒྲིབ་པར་༩བ་འགྱུར་ལ།",
    "གང་གཞན་དུ་མེ་འདུག་པ་སྟེ་ཡོད་པའི་ས་ཕྱོགས་ནའང་མུན་པ་མེད་ལ།",
    "མར་མེ་ལའང་རང་གསལ་འདོད་དགོས་ཏེ།",
    "དེའི་ཕྱིར་མུན་པས་ཀྱང་རང་ཉིད་བསྒྲིབས་པར་འདོད་དགོས་ལ།",
    "ཡང་རང་བཞིན་འདོད་ཕྱིན་ཆད་ཤེས་པ་ལ་རང་མྱོང་གཞན་མྱོང་གཉིས་སུ་ཁ་ཚོན་ཆོད་པ་ལྟར་མར་མེ་ལའང་ཁ་ཚོན་ཆོད་དགོས་ཤིང་།",
    "མིང་ཡང་རང་བཞིན་མེད་པར་བསྟན་ཟིན་ལ།",
    "ཅི་ཡང་རང་བཞིན་མེད་པས་ན་ང་ནི་རང་བཞིན་གྱིས་ཅི་ཡང་མི་འགོག་གོ།",
    "ལྷག་མ་གཟུང་བ་དང་འཛིན་པོ་སོགས་ལའང་རྟེན་འབྱུང་དང་རང་བཞིན་འགལ་བའི་ཚུལ་དེ་བཞིན་དུ་སྦྱར་བར་བྱ་བ་ཡིན་པས།",
    "ཕྱིས་པ་དང་ཅིག་ཅར་བ་ཡང་རང་ལུགས་ལ་སྐྱོན་མེད་ཅིང་།",
    "རྐྱེན་གྱིས་བཅོས་པར་ཤེས་པས་ཀྱང་རང་བཞིན་མིན་པར་རང་སྟོབས་ཀྱིས་ཤེས་པས་དེ་གཉིས་དོན་གཅིག་ཚུལ་དེ་ལྟར་ཡིན་ལ།",
    "དེའང་རང་བཞིན་གྱིས་དག་པ་ལ་དག་པར་མཐོང་དུ་མི་འཇུག་པའི་སྒྲིབ་བྱེད་གཏི་མུག་བསལ་བའི་སྒོ་ནས་སྤངས་དགོས་ཏེ།",
    "རྐྱེན་ལ་བརྟེན་ནས་སྐྱེ་འཇིག་བྱེད་པ་དང་རང་བཞིན་གྱིས་སྐྱེ་འཇིག་བྱེད་པ་གཉིས་དངོས་སུ་འགལ་བའི་ཕྱིར་རོ།",
    "དེའང་རང་བཞིན་གྱིས་རྣམ་ཆེན་པོ་ལས་བསྒྲལ་ཏེ་རྣམ་གྲོལ་ནོར་བུའི་གླིང་དུ་སོན་པར་འགྱུར་རོ།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་སྤྱིར་དགག་པ།",
    "དེ་ལྟར་སྐད་ཅིག་གསུམ་གྱི་བདག་ཉིད་དུ་བརྟགས་པའི་ཕྱིར་འཇིག་དཔེར་ན་སྐད་ཅིག་དེ་ལ་མཐའ་ཡོད་པར་བརྟགས་པ་དེ་བཞིན་ཐོག་མ་དང་དབུས་ཀྱང་ལས་ཀྱང་རང་བཞིན་གྱིས་གནས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཟུགས་ཞེས་བརྗོད་པའི་མིང་ཙམ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་མེད་དེ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་འདི་ནི་ཆད་སྟོང་ངོ།",
    "ཉན་ཐོས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་མར་མེ་ཤི་བ་བཞིན་དུ་ཉན་ཐོས་དང་རང་སངས་བྲཀ་༡༣ཀཤྲརྒྱ།",
    "མ་ཞུ་བ་གཉིས་ཀྱི་བར་ན་འདུག་པའམ།",
    "སྟན་གཅིག་པ་ནི་སྟན་གཅིག་ལ་འདུག་ནས་ཅི་ཙམ་ཟ་བར་བྱེད་པ་དེ་ཟ་བ་སྟེ།",
