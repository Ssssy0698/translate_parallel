    "ད་དུང་ད་དུང་ལྷ་མོའི་ཨ་མས་ལྷ་མོ་རང་ཉིད་ངེད་ཚང་ལ་ཡོང་བར་འཐད་ཀྱིན་མི་འདུག་ཟེར་བ་ནི་རྫུན་གཏམ་སྟེ་མ་ཡར་གྱི་མགོ་གཡོགས་བྱེད་ཙམ་ཡིན་པ་མིན་ནམ།",
    "ཁོ་མོས་མོས་སྔར་བཞིན་ངས་ཁོ་མོར་ཨ་མ་ཞེས་ཨེ་འབོད་པའི་ཐད་ལ་ཧུར་བརྩོན་ཅི་ནུས་བྱེད་ཀྱིན་ཡོད་པ་སྟེ།",
    "ང་རང་ནོར་རྫི་ནས་ཕྱིར་ཡུལ་དུ་ཐོན་མ་ཐག་མྱུར་དུ་ཨེ་ལྟོགས་ཐལ་དང་ཨེ་གྲང་ཐལ་ལ་སོགས་པའི་བྱམས་བརྩེའི་དྲོད་ཀྱིས་ཁེངས་པའི་འཚམས་འདྲི་བྱེད་བཞིན་ཇ་འདྲེན་དང་ཟས་འདྲེན་བྱེད་པ་དང་།",
    "ངའི་རེ་ཞུ་བྱེད་པའི་ངོ་མདངས་མཐོང་རྗེས་དེ་འཕྲལ་སེམས་ཇེ་སྙིར་གྱུར་ཏེ་འདང་རྒྱག་ཙམ་བྱས་ཤིང་ཅུང་ཐེ་ཚོམ་དང་བཅས།",
    "འོན་ཀྱང་ཨ་ཕ་ཨེ་འཐད་དམ་ཟེར་ནས་ཅེ་རེར་ང་ལ་ལྟ་བར་བྱེད།",
    "ད་ནི་ངས་ཀྱང་བསམ་ཤེས་ཡོད་པས་ཁྱིམ་ནང་གི་གནས་ཚུལ་ཅི་ལ་མི་ཤེས།",
    "མ་ཡར་གྱིས་ཡུན་རིང་ཙམ་ལ་ཅི་ཡང་མི་ཟེར་བར་ཁ་རོག་གེར་འདང་རྒྱག་གིན་སྡོད་ཅིང་།",
    "གང་ལྟར་ཁྱོད་ཀྱིས་ཡེ་གེ་འདོན་ཐུབ་ན་ཧ་ཅང་བཟང་བ་རེད།",
    "རྗེས་ཕྱོགས་ནས་ཕན་ཐོགས་ཡོད་པ་རེད།",
    "འོན་ཀྱང་ཁྱོད་ཀྱི་ཨ་ཕས་ཅི་ཟེར་རམ་ཟེར་ནས་མུ་མཐུད་དུ་འདང་རྒྱག་པར་བྱེད།",
    "ཁོ་མོས་ནམ་རྒྱུན་དོན་གང་དང་ཅིའི་ཐད་ནས་ཀྱང་ང་ལ་རྒྱབ་སྐྱོར་བྱེད་ཅི་ནུས་བགྱི་བ་ལགས་མོད།",
    "གལ་ཏེ་ངའི་ཡིད་དགའ་བའི་དོན་ཞིག་ཡིན་ན་ཁོ་མོས་སྡུག་ཅིའདྲ་མྱོང་དགོས་ཀྱང་བཟོད་བསྲན་ནུས་པའི་རྣམ་འགྱུར་དེ་དག་གིས་ཁོ་མོ་དངོས་གནས་འཕགས་མ་ཞིག་དང་མཚུངས་པ་མ་རེད་དམ།",
    "སྐབས་དེར་ངའི་ངག་ནས་ཚིག་གཅིག་ཀྱང་མི་འཁྲོལ་བར་གྱུར་སོང་།",
    "ཨ་ཕ་ལུག་རྫི་ནས་ཕྱིར་ལོག་དུས་ནམ་རྒྱུན་ལྟར་སྤྲོ་སྣང་གིས་ཁེངས་ཏེ་ཁ་བརྡ་འགའ་རེ་བྱས་རྗེས་ཇ་འཐུང་བར་བྱེད་མོད།",
    "ང་རང་ཁུ་སིམ་མེར་ཨ་ཕའི་འགྲམ་དུ་བསྡད་ནས་ལན་རེར་མ་ཡར་ལ་ལྟ་ཙམ་བྱས་པ་ཡིན།",
    "ཨ་ཕས་ཧུར་རེར་ང་ལ་བལྟས་ཏེ།",
    "མ་རེད།",
    "ཨ་ཕ་སྔར་ལས་ཀྱང་ཡ་མཚར་བར་གྱུར་ཏེ་ཕར་མ་ཡར་ལ་ལྟ་བཞིན།",
    "ཅི་ཞིག་བྱས་སོང་བ་རེད་ཟེར།",
    "ཁྱོད་ཀྱིས་བལྟས་ན་ཅི་བྱེད་རྒྱུ་ཟེར་ནས་ཨ་ཕའི་གདོང་ལ་བལྟས་ནས་འདུགཨ་ཕས་དེ་མུར་ཧུར་རེར་ང་ལ་བལྟས་བྱུང་ཞིང་།",
    "ཁོའི་མིག་གཉིས་ཧ་ཅང་ཆེ་རུ་བགྲད་འདུག་པས་ངའི་སྣང་ངོར་ཕལ་ཆེར་མཛོ་མོའི་མིག་གི་ཆེ་ཆུང་ཡོད་པའི་སྣང་བ་སྐྱེས་བྱུང་།",
    "ཨ་ཕ་ཅུང་ཙམ་ལ་ཅེར་ནས་བསྡད་རྗེས་གཞི་ནས་ཁ་གྲགས་བྱུང་།",
    "འོན་ཀྱང་ང་ཚོས་ད་བར་དུ་ཕྱུགས་འཚོས་ནས་འོང་བ་རེད་ཡ་ཟེར་བ་དང་།",
    "དེ་ནི་མ་ཡར་གྱིས་ཀྱང་ཁོ་ལ་རྒྱབ་སྐྱོར་བྱེད་དགོས་པའི་བརྡ་རེད།",
    "ཁོ་མོའི་བཟོ་ལྟར་བལྟས་ན་དངོས་གནས་སྐྲག་གིན་འདུག་པས་ང་རང་ཡང་ཅུང་ཟད་སྐྲག་པར་གྱུར་སོང་།",
    "ཨ་ཕས་མུ་མཐུད་དུ་མིག་ཅེར་ཅེར་བྱས་ཏེ།",
    "ཐ་ན་མིག་འབྲས་ཁོ་ན་རྐུ་མཁན་ཡང་ཡོད་པ་རེད་ཟེར།",
    "མ་ཡར་ནི་ཧ་ལས་ཏེ་ང་ལ་བལྟས་ནས་མིག་ཅེར་འདུག་པས་ངའི་སེམས་ཀྱང་ཐེ་ཚོམ་གྱི་རྒྱ་རུ་ཚུད་སོང་།",
    "ཨ་ཕ་འཐད་ཀྱིན་མེད་པ་ནི་ངས་ཀྱང་གསལ་བོར་ཤེས་ཡོད་དེ།",
    "ཁོའི་རེ་བ་ནི་ལྷ་མོ་ལྟ་བུའི་བུ་མོ་ཞིག་ངའི་ཆུང་མར་བླངས་ཏེ་མ་ཡར་དང་ཁོང་གཉིས་ལྟར་སྡོད་རྒྱུ་དེ་རེད་ལ།",
    "དེ་ལྟར་གྲུབ་ཚེ་ཁོའི་འགན་ཁུར་ཡང་འགྲུབ་སོང་སྙམ་གྱིན་ཡོད་པ་རེད།",
    "ངས་ཨ་ཕར་གཏུག་རྒྱུ་ཡིན་ཟེར་ནས་ནོར་ཁྱུ་བསྐྱུར་ནས་མར་ཕྱོགས་སུ་བུད་སོང་།",
    "ལྷ་མོས་ཕར་ཕྱོགས་ནས་དོན་དག་ཅི་ཞིག་བྱུང་བ་མ་ཤེས་པར་མགོན་སྐྱབས་ཀྱི་རྗེས་སུ་བརྒྱུགས་ནས་བཤོལ་འདེབས་བྱེད་ཀྱིན་འདུག་མོད།",
    "ཁོས་མི་ཉན་པར་ཤར་རེར་ཡུལ་ཕྱོགས་སུ་བུད་སོང་།",
    "ཁྱོད་གཉིས་ཀྱིས་ཁོ་ལ་ཅི་ཞིག་བྱས་པ་ཡིན་ཟེར་བས།",
    "ཁོས་ང་ལ་ཡི་གེ་འདོན་དུ་མ་བཅུག་པ་རེད།",
    "མི་རློམ་ན་ཁྱོད་ཀྱིས་རྣམ་རྒྱལ་ལ་དྲིས་དང་ཆོག་ཅེས་བཤད།",
    "དེ་ལྟར་སྙམ་ནས་ངའི་སེམས་ཀྱི་སྐྲག་སྣང་དེ་ཡང་རིམ་བཞིན་འགྱོད་སེམས་ཤིག་ཏུ་གྱུར་སོང་།",
    "མགོན་སྐྱབས་ཀྱི་ཨ་ཕས་ངེད་གཉིས་ལ་སྡིགས་ངེས་རེད་ཟེར་ནས་དེ་ལས་གཡོལ་འདོད་ཀྱི་ཐབས་ཤིག་འཚོལ་བར་བྱེད།",
    "རྣམ་རྒྱལ་ནི་སྔར་བས་ཀྱང་འདང་རྒྱག་གི་ནང་དུ་ལྷུང་སོང་།",
    "ངའི་བསམ་པར་ཨ་ཕས་མི་གཞན་གྱིས་ང་ལ་སྡིགས་མོ་བྱས་ཚེ་ང་ལ་འགེབས་སྲུང་བྱེད་ངེས་པ་མ་གཏོགས།",
    "ང་ཚོ་སྐྲག་སྐྲག་ངང་ནོར་རྫི་ནས་ཕྱིར་ཡུལ་དུ་ལོག་ཡོང་དུས་ལྷ་མོ་ཚང་ལ་འགྲུལ་པ་འགའ་ཡོང་འདུག་པར་མ་ཟད།",
    "ངའི་ཨ་ཕ་དང་མགོན་སྐྱབས་ཀྱི་ཨ་ཕ།",
    "རྣམ་རྒྱལ་གྱི་ཨ་ཕ་གསུམ་གའང་དེ་གར་སོང་ནས་ཆང་འཐུང་གིན་འདུག་ཟེར།",
    "དེ་བས་ངའི་སེམས་ལ་གཞི་ནས་ནམ་ལངས་པ་ལྟ་བུའི་སྣང་བ་ཞིག་སྐྱེས་ཤིང་མགོན་སྐྱབས་ཀྱང་གྲོགས་པོའི་ལ་རྒྱ་ཡོད་པའི་སྐྱེས་ཕོ་རབ་ཅིག་རེད་སྙམ་བྱུང་།",
    "ངས་མ་ཡར་ལ་ཨ་ཕ་ལྷ་མོ་ཚང་ལ་འགྲོ་དོན་ཅི་རེད་ཅེས་དྲིས།",
    "དེ་རིང་ལྷ་མོ་གནས་ལ་འགྲོ་བར་གཉེན་རྟགས་རྒྱག་པ་རེད་ཟེར།",
    "ང་རང་ཡིད་མི་ཆེས་པར་གྱུར་ཏེ་རེ་ཞིག་ལ་ཁོ་མོའི་བཞིན་ལ་ཅེར་ནས་འདུག་དགོས་བྱུང་།",
