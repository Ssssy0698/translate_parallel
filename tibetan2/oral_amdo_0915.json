    "གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "དེ་ནས་གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "དེ་ནས་གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "དེ་ནས་གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "རང་གི་ལག་ནས་སྟོབས་ཤིང་ཚིམ་པར་བྱེད་དེ་རྣམ་གྲངས་དུ་མར་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་རང་གི་ལག་ནས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གྲོང་པའི་བུ་མོ་དགའ་མོ་དང་།",
    "དགེ་སྦྱོང་ཆེན་པོ་ཡུན་རིང་པོ་ཞིག་ལགས་ན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འོད་སྲུང་གལ་ཏེ་ཁྱོད་ལ་མི་བདེ་བ་མེད་ན་ཁྱོད་ཀྱི་མེ་ཁང་དུ་ང་ཞག་གཅིག་ཅིག་འདུག་གོ།",
    "འོན་ཀྱང་དེ་ན་ཀླུ་གདུག་པ་ཞིག་གནས་ཏེ་དེས་ཁྱོད་ཐོ་བཙམས་པར་འགྱུར་དུ་མཆིའོ།",
    "འོད་སྲུང་ཁྱོད་ཀྱིས་རེ་ཞིག་གནང་བར་གྱིས་ཤིག་དང་ཐོ་བཙམས་པར་མི་འགྱུར་རོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་གལ་ཏེ་ཁྱོད་ལ་མཐོ་མི་འཚམ་ན་དགེ་སྦྱོང་ཆེན་པོ་ཅི་བདེ་བ་ཁོ་ནར་བཞུགས་ཤིག།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གྱི་མེ་ཁང་གང་ན་བ་དེར་གཤེགས་ཏེ་བྱོན་ནས་མེ་ཁང་གི་ཕྱི་རོལ་དུ་ཞབས་བསིལ་ནས་མེ་ཁང་གི་ནང་དུ་ཞུགས་ཏེ།",
    "ཉིད་ཀྱིས་རྩྭའི་གདིང་བ་བཤམས་ནས་སྐུ་དྲང་པོར་བསྲང་སྟེ་སྐྱིལ་མོ་ཀྲུང་བཅས་ནས་དྲན་པ་མངོན་དུ་ཕྱོགས་པར་བཞག་སྟེ་བཞུགས་སོ།",
    "ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་མཚན་མོ་རྒྱུ་སྐར་ལ་ལྟ་བ་ན་མེ་ཁང་ཐམས་ཅད་འབར་རབ་ཏུ་འབར།",
    "མེ་ལྕེ་གཅིག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དགེ་སྦྱོང་ཆེན་པོ་གོ་ཏ་མ་འདི་ལྟར་མཛེས་པ་ཀླུ་གདུག་པས་ཐལ་བར་བྱས་པར་མ་གྱུར་གྲང་།",
    "ཀྱི་ཧུད་ཉོན་མོངས་བདག་གི་ཚིག་མ་ཉན་ཏོ་སྙམ་མོ།",
    "ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་དེ་ལ་སྦྱིན་པ་དེ་ལྟ་བུ་ཞིག་བྱའོ་སྙམ་མོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་ཁྱོད་ཀྱི་ལྷུང་བཟེད་ན་བསྣམས་ཏེ་བྱོན་པ་ཅི།",
    "འོད་སྲུང་ཀླུ་གདུག་པ་གང་གི་མཐུས་ཁྱོད་ཀྱི་མེ་ཁང་དུ་མིར་གྱུར་པ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཅག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དེའི་ཚེ་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གྱི་བསྟི་གནས་ན་བྲམ་ཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་ཙམ་མེ་ལ་ཡོངས་སུ་སྤྱོད་པ་རེ་རེའི་མེ་ཐབ་གསུམ་གསུམ་སྟེ།",
    "དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་དེ་རྣམས་མེ་ལ་ཡོངས་སུ་སྤྱོད་པར་འདོད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་དེ་རྣམས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "དགེ་སྦྱོང་ཆེན་པོ་བདག་གི་ཉེ་འཁོར་ན་གནས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "འདིར་བདག་གི་བྲམ་ཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་ཙམ་མེ་ལ་ཡོངས་སུ་སྤྱོད་པར་འཚལ་ན།",
    "བདག་གི་ཉེ་འཁོར་ན་དགེ་སྦྱོང་ཆེན་པོ་བཞུགས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་བགྱིད་དོ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི།",
    "བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དགེ་སློང་ཆེན་པོ་བདག་གི་ཉེ་འཁོར་ན་གནས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་དོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འདིར་བདག་གི་བྲམ་ཟེའི་ཁྱེའུ་རྣམས་ཞུགས་ལ་ཡོངས་སུ་སྤྱད་ནས་ཞུགས་དགུམ་པར་འཚལ་ན་དགུམ་པའི་རྔོ་མ་ཐོགས་ནས་བདག་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བདག་གི་ཉེ་འཁོར་ན་དགེ་སྦྱོང་ཆེན་པོ་བཞུགས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་བགྱིད་དོ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་ནི་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་དུ་གོང་མ་བཞིན་ནོ་སྙམ་མོ།",
    "བདག་གི་ཉེ་འཁོར་ན་དགེ་སྦྱོང་ཆེན་པོ་གནས་ན་དེའི་མཐུ་ཞིག་བྱུང་བར་མ་གྱུར་གྲང་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་འདིར་བདག་གི་མེ་ཁང་ཐམས་ཅད་འབར་རབ་ཏུ་འབར།",
    "མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་ཕྲེག་པར་བགྱིད་པ་དེ་ལ་བདག་འཁོར་དང་བཅས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བདག་གི་ཉེ་འཁོར་ན་དགེ་སྦྱོང་ཆེན་པོ་བཞུགས་ན་དེའི་མཐུ་ཞིག་བྱུང་བར་མ་གྱུར་གྲང་སྙམ་བགྱིད་དོ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དེ་ནས་རྒྱལ་པོ་ཆེན་པོ་བཞི་པོ་དག་ཁ་དོག་འཕགས་པས་མཚན་མོ་ལ་བབ་པ་ན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་དོང་སྟེ་ལྷགས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་དེ་རྣམས་དཔེར་ན་མེའི་ཕུང་པོ་འབར་རབ་ཏུ་འབར།",
    "མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་ཕྲེག་པར་བྱེད་པ་བཞི་ཡོད་དོ་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་ནང་པར་སྔར་ལངས་ཏེ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་ཕྲེག་པར་བགྱིད་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བཞི་མཆིས་སོ་སྙམ་མོ།",
    "མཁས་པ་ཀུན་ནས་ཉོན་མོངས་ལས།",
    "དེ་ལྟ་མོད་ཀྱི་འདིར་མདང་སུམ་རྒྱལ་པོ་ཆེན་པོ་བཞི་པོ་དག་ཁ་དོག་འཕགས་པས་མཚན་མོ་ལ་བབ་པ་ན་ང་གང་ན་བ་དེར་འོངས་ཏེ་ལྷགས་ནས་ངའི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་དེ་རྣམས་དཔེར་ན་མེའི་ཕུང་པོ་འབར་རབ་ཏུ་འབར།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་དེ་ཉིད་ཀྱི་མཚན་མོ་རྒྱུ་སྐར་རྣམས་ལ་ལྟ་བ་ན།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ་ཞེས་བྱ་བའི་བར་དུ་གོང་མ་བཞིན་ནོ།",
    "དེ་ནས་མི་མཇེད་ཀྱི་བདག་པོ་ཚངས་པ་ཁ་དོག་འཕགས་པས་མཚན་མོ་ལ་བབ་པ་ན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "མེའི་ཕུང་པོ་ཆེན་པོ་ལྔ་པོ་དེ་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་ཕྲེག་པར་བྱེད་དོ་ཞེས་བྱ་བའི་བར་དེ་དག་པས་ཀྱང་ཆེས་ལྷག་ཅིང་ཆེས་འཕགས་ལ་ཆེས་བཟང་བ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་དེ་ཉིད་ཀྱི་མཚན་མོ་རྒྱུ་སྐར་རྣམས་ལ་ལྟ་བ་ན་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ན་མེའི་ཕུང་པོ་ཆེན་པོ་འབར་ཞེས་བྱ་བ་ནས།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ་ཞེས་བྱ་བའི་བར་དུ་གོང་མ་བཞིན་ནོ།",
    "ཀྱེ་མ་དགེ་སྦྱོང་ཆེན་པོ་ཞག་བདུན་ཞིག་འདི་ནས་གཞན་དུ་སོང་ཡང་ཅི་མ་རུང་སྙམ་མོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་ཁྱོད་ཅིའི་སླད་དུ་ཞག་བདུན་འདི་ནས་གཞན་དུ་བཞུད་ལགས།",
    "འོད་སྲུང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཁྱོད་ཀྱི་འདུག་གནས་ན་མཆོད་སྦྱིན་ཞག་བདུན་དུ་བྱེད་པ་ལ་བབ་ནས་འདི་སྙམ་དུ་གལ་ཏེ་མ་ག་འི་མི་རྣམས་ཀྱིས་དགེ་སྦྱོང་ཆེན་པོ་ནི་འདི་ལྟར་རྫུ་འཕྲུལ་ཆེ་ཞིང་འདི་ལྟར་མཐུ་ཆེ་བ་ཡིན་ནོ་བར་ཤེས་ན་དེ་ཁོ་ན་ལ་བྱ་བ་བྱེད་པར་སེམས་ཀྱི་བདག་ལ་ནི་དེ་ལྟ་མ་ཡིན་པའི་གནས་འདི་ཡོད་པར་འགྱུར་གྱིས་ཀྱེ་མ་དགེ་སྦྱོང་ཆེན་པོ་ཞག་བདུན་ཞིག་འདི་ནས་གཞན་དུ་སོང་ཡང་ཅི་མ་རུང་སྙམ་སེམས་པ་མ་ཡིན་ནམ།",
    "ངའི་ཐུགས་ཀྱིས་ཁྱོད་ཀྱི་སེམས་ཤེས་ནས་ཞག་བདུན་འདི་ནས་གཞན་དུ་སོང་ངོ།",
    "འོད་སྲུང་ཁྱོད་ཀྱི་མཆོད་སྦྱིན་ཞག་བདུན་དུ་བྱས་ཟིན་ནས་འདི་སྙམ་དུ་བདག་ལ་ཞག་བདུན་དུ་རྙེད་པ་དང་།",
    "ངའི་ཐུགས་ཀྱིས་ཁྱོད་ཀྱི་སེམས་ཤེས་ནས་ང་འོངས་པ་ཡིན་ནོ།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གྱིས་བཅོམ་ལྡན་འདས་ཀྱི་ཆེད་དུ་རང་ཁོ་ནས་གཡོས་བྱས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འོད་སྲུང་དེའི་ཕྱིར་སོང་ཤིག་ང་ཡང་འོང་ངོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་སོང་ནས་རིང་པོ་མ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལོན་པར་མཁྱེན་ནས་ཇི་ལྟར་ཐུགས་མཉམ་པར་བཞག་ན་ཤིང་འཛམ་བུ་ཞེས་བྱ་བ་གང་གིས་འཛམ་བུ་གླིང་དུ་གདགས་པ་དེ་ལས་ཁ་དོག་དང་དྲི་དང་རོ་དང་ལྡན་པའི་འཛམ་བུའི་སྙེ་མ་རྣམས་ཀྱིས་ལྷུང་བཟེད་བཀང་ནས་བསྣམས་ཏེ།",
    "དགེ་སྦྱོང་ཆེན་པོ་ཁྱོད་ཀྱི་ལྷུང་བཟེད་ན་ཅི་མཆིས།",
    "འདིར་ངས་འོད་སྲུང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་མཁྱེན་ནས།",
    "ཇི་ལྟར་ཐུགས་མཉམ་པར་བཞག་ན་ཤིང་འཛམ་བུ་ཞེས་བྱ་བ་གང་གིས་འཛམ་བུ་གླིང་དུ་གདགས་པ་དེ་ལས་ཁ་དོག་དང་དྲི་དང་རོ་དང་ལྡན་པའི་འཛམ་བུའི་སྙེ་མ་རྣམས་ཀྱིས་ལྷུང་བཟེད་བཀང་ནས་འདིར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱིས་གལ་ཏེ་འདོད་ན་ལོངས་སྤྱོད་ཅིག།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཤིང་འཛམ་བུ་ཞེས་བྱ་བ་གང་གིས་འཛམ་བུའི་གླིང་དུ་གདགས་པ་དེ་དང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་དུ་གཤེགས་ནས་མ་རྨོས་མ་བཏབ་པའི་འབྲས་སཱ་ལུས་ལྷུང་བཟེད་བཀང་སྟེ་བསྣམས་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གྱི་བསྟི་གནས་གང་ན་བ་དེར་གཤེགས་ཏེ་བྱོན་ནས་གདན་བཤམས་པ་ཉིད་ལ་བཞུགས་སོ།",
    "མཐོང་ནས་ཀྱང་འདི་སྐད་ཅེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དགེ་སྦྱོང་ཆེན་པོ་ཁྱོད་ཀྱི་ལྷུང་བཟེད་ན་ཅི་མཆིས་འདིར་ངས་འོད་སྲུང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་མཁྱེན་ནས་ཇི་ལྟར་ཐུགས་མཉམ་པར་བཞག་ན་བྱང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་དུ་གཤེགས་ནས་མ་རྨོས་མ་བཏབ་པའི་འབྲས་སཱ་ལུའི་འབྲས་ལྷུང་བཟེད་བཀང་ནས་འདིར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱིས་གལ་ཏེ་འདོད་ན་ལོངས་སྤྱོད་ཅིག།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཆུ་འདི་སྔོན་ནི་མེད་ན་ཆུ་འདི་ད་ལྟར་གང་ནས་བྱུང་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འོད་སྲུང་འདིར་ཁྱོད་ལས་བསོད་སྙོམས་བཞེས་ནས་ཕྱོགས་འདིར་བཞུགས་ཏེ་ཞལ་ཟས་ཀྱི་བྱ་བ་མཛད་པ་ན་ང་ལ་ཆུས་ཆུའི་དགོས་པ་ཞིག་བྱུང་ངོ།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཨརྫུ་ནའི་ཡལ་ག་ཆེན་པོ་འདི་ད་སུ་ཞིག་གིས་བཏུད་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཨརྫུ་ནའི་ཡལ་ག་ཆེན་པོ་འདི་སྔོན་ནི་དུད་པར་མ་གྱུར་ན་ད་སུ་ཞིག་གིས་བཏུད་སྙམ་བགྱིད་དོ།",
    "འོད་སྲུང་འདིར་ཕྱེ་མ་རེད་ནང་དུ་ཡང་དག་འཇོག་ལས་བཞེངས་ནས།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ངའི་ཕྱག་དར་ཁྲོད་པའི་ཤ་ནའི་རས་གང་དུ་བཀྲུ་སྙམ་མོ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་ཕྱག་དར་ཁྲོད་པའི་ཤ་ནའི་རས་དག་བཀྲམ་མོ།",
    "རྡོ་ལེབ་ཆེ་ལ་རིང་བ་འདི་དག་སྔོན་ནི་མེད་ན་རྡོ་ལེབ་ཆེ་ལ་རིང་བ་འདི་དག་ད་སུ་ཞིག་གིས་ཁྱེར་ཏེ་འོངས་སྙམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྡོ་ལེབ་ཆེ་ལ་རིང་བ་འདི་དག་ད་སུ་ཞིག་གིས་འཚལ་ཏེ་མཆིས་སྙམ་བགྱིད་དོ།",
    "ངས་དེ་ལ་ཕྱག་དར་ཁྲོད་པའི་ཤ་ནའི་རས་རྣམས་བཀྲམ་མོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་འདི་སྙམ་དུ་སེམས་ཏེ་འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་དེ་ལྟར་མཛེས་པ་ཆུ་ཆེན་པོ་བྲུག་པས་ཁྱེར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མ་ལ་བདག་གིས་དགེ་སྦྱོང་ཆེན་པོ་བཙལ་སྙམ་དུ་བསམས་ནས་ཤིང་གཅིག་པའི་གྲུའི་ནང་དུ་ཞུགས་ཏེ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "འོད་སྲུང་རལ་པ་ཅན་ཁྱོད་ནི་དགྲ་བཅོམ་པ་མ་ཡིན།",
    "དགེ་སྦྱོང་ཆེན་པོ་གོ་ཏ་མའི་ཐུགས་ཀྱིས་བདག་གི་སེམས་མཁྱེན་ཏོ་སྙམ་དུ་རིག་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོ་འཐོབ་པ་ལྟ་ན་དགེ་སྦྱོང་ཆེན་པོའི་སྤྱན་སྔར་བདག་ཚངས་པར་སྤྱོད་པ་སྤྱད་པར་བགྱིའོ།",
    "འོད་སྲུང་ཁྱོད་ཀྱི་འཁོར་ལ་བལྟས་སམ།",
    "འོད་སྲུང་དེའི་ཕྱིར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རེ་ཞིག་འཁོར་ལ་ལྟོས་ཤིག།",
    "འདིར་ཁྱོད་ལྟ་བུའི་མི་གྲགས་པ་དང་ལྡན་པ་ཤེས་ཉེན་ཅན་རྣམས་ཀྱིས་ནི་འཁོར་ལ་ལྟ་བ་ལེགས་པ་ཡིན་ནོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་རང་གི་བསྟི་གནས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བྲམ་ཟེའི་ཁྱེའུ་རྣམས་ལ་སྨྲས་པ།",
    "བླུགས་གཟར་རྣམས་ཆུ་ཀླུང་ནེ་རཉྫ་ནཱའི་འགྲམ་དུ་བོར་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་འཁོར་ལྔ་བརྒྱ་དང་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེས་དགེ་སློང་གི་དངོས་པོར་གྱུར་ཏོ།",
    "ག་ཡཱ་འོད་སྲུང་གཉིས་འཁོར་ཉིས་བརྒྱ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཆུ་ཀླུང་ནེཉྫ་ནཱའི་མཇུག་གི་འགྲམ་གྱི་བསྟི་གནས་ན་དཀའ་ཐུབ་སྤྱོད་དོ།",
    "བདག་ཅག་གི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་རྒྱལ་པོའམ།",
    "མ་ལ་བདག་གིས་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་བཙལ་ལོ་སྙམ་མོ།",
    "གང་གི་ཕྱིར་ད་ལྟར་ལྗེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཙས་ནས་ལོ་བརྒྱ་ཉི་ཤུ་ལྷག་ལོན་པ་རྒས་འཁོགས་གཏུགས་པ་མ་ག་འི་མི་རྣམས་ཀྱིས་བཀུར་སྟིར་བྱས།",
    "དགེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོ་འཐོབ་པ་ལྟ་ན།",
    "ཁྱོད་ཀྱིས་འཁོར་ལ་བལྟས་སམ།",
    "འོད་སྲུང་དག་དེའི་ཕྱིར་རེ་ཞིག་འཁོར་ལ་ལྟོས་ཤིག།",
    "འདི་ལྟར་ཁྱོད་ལྟ་བུའི་མི་གྲགས་པ་དང་ལྡན་པ།",
    "ཤེས་ཉེན་ཅན་དག་གིས་ནི་འཁོར་ལ་ལྟ་བ་ལེགས་པ་ཡིན་ནོ།",
    "ག་ཡཱ་འོད་སྲུང་སྤུན་རང་གི་བསྟི་གནས་གང་ན་བ་དེར་དོང་སྟེ་ཕྱིན་ནས་བྲམ་ཟེའི་ཁྱེའུ་རྣམས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་བདག་ཅག་གིས་འཁོར་ལ་བལྟས་ལགས་ཏེ།",
    "བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོ་འཐོབ་པ་ལྟ་ན་བདག་ཅག་ཀྱང་དགེ་སྦྱོང་ཆེན་པོའི་སྤྱན་སྔར་ཚངས་པར་སྤྱོད་པ་སྤྱད་པར་བགྱིའོ།",
    "དེས་དགེ་སློང་གི་དངོས་པོར་གྱུར་ཏོ།",
    "ག་ཡཱ་གང་ན་བ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྐུའི་སྟོད་ལས་ཆུ་གྲང་མོའི་རྒྱུན་འབེབས་པར་མཛད་དོ།",
    "སྐུའི་སྨད་ནས་ཆུ་གྲང་མོའི་རྒྱུན་འབེབས་པར་མཛད་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "དགེ་སློང་དག་ཁྱོད་ཀྱི་སེམས་ནི་འདི་ལྟ་བུའོ།",
    "ཁྱོད་ཀྱི་ཡིད་ནི་འདི་ལྟ་བུའོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དང་།",
