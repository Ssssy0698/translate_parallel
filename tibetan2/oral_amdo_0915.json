    "བཅོམ་ལྡན་འདས་གལ་ཏེ་མི་བཞུད་དང་བདག་གི་མཐུས་བསྲེ་བར་བགྱི་ལགས་སོ།",
    "གང་ཞིག་ཡུལ་གྱི་རྒྱལ་མོར་མ་ཆགས་ཤིང་།",
    "གཞི་མེད་ན་ནི་གང་གི་གཞི་ཡིས་བསྲེ།",
    "གང་ཞིག་ཡུལ་གྱི་རྒྱལ་མོར་མ་ཆགས་ཤིང་།",
    "གཞི་མེད་ན་ནི་གང་གི་གཞི་ཡིས་བསྲེ།",
    "གཞི་མེད་ན་ནི་གང་གི་གཞི་ཡིས་བསྲེ།",
    "རབ་ཏུ་བྱུང་བ་ཡིན་གྱིས་ཁྱོད་ཀྱང་རབ་ཏུ་བྱུང་ཤིག།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་རྒྱལ་པོ་ཟས་གཙང་ལ་སླར་མཆི་བར་དམ་བཅས་ལགས་སོ།",
    "འཆར་ཀ་འདི་ནི་ཁྱོད་ཀྱི་བྱ་བ་ཡིན་ཏེ།",
    "དེང་ཕན་ཆད་བུད་མེད་དང་ལྷན་ཅིག་ཁང་པ་གཅིག་ཏུ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་དག་གོ།",
    "བཙུན་པ་བཀའ་བཞིན་འཚལ་ཞེས་འཆར་ཀས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའིབུའི་རྐང་པ་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་སོང་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ།",
    "འཆར་ཀ་སོང་ལ་ཁྱོད་མོད་ཁོ་ནར་རྒྱལ་པོའི་ཁབ་ཏུ་མ་འཇུག་པར་སྒོར་སྡོད་ལ་ཤཱཀྱའི་དགེ་སློང་འོངས་སོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཁྱོད་ཀྱིས་རྒྱལ་པོའི་ཁབ་ཏུ་ཡང་གནས་པར་མི་བྱའོ།",
    "གཙུག་ལག་ཁང་དུའོ་ཞེས་བརྗོད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ་སོང་ཤིག།",
    "ས་བདག་རྣམས་ནི་ཚིག་གིས་ཏེ།",
    "དེ་ནང་དུ་ཞུགས་པ་རྒྱལ་པོ་ཟས་གཙང་གིས་མཐོང་ནས་སྨྲས་པ།",
    "ཁྱོད་སླར་འོང་ངོ་ཞེས་སྨྲས་པ་མ་ཡིན་ནམ།",
    "དུལ་བར་གནས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལྷ་བདག་གི་དུལ་བ་དང་ཉེ་བར་ཞི་བ་ནི་ཅུང་ཟད་ཙམ་ལགས་སོ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་བློན་པོ་རྣམས་ལ་བསྒོ་བ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀས་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་རྣམ་པ་རི་མོར་བྲིས་ཏེ་བསྟན་ཏོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་མོང་གལ་གྱི་བུ་ཆེན་པོ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏེ།",
    "མོང་གལ་གྱི་བུ་སོང་ལ་དགེ་སློང་རྣམས་ལ་བཅོམ་ལྡན་འདས་སེར་སྐྱའི་གཞིར་གཤེགས་ཏེ་ཡབ་སྲས་གདན་འཛོམ་ན།",
    "བཙུན་པ་བཀའ་བཞིན་འཚལ་ཞེས་ཚེ་དང་ལྡན་པ་མོང་གལ་གྱི་བུ་ཆེན་པོས་བཅོམ་ལྡན་འདས་ལས་མཉན་ནས་དགེ་སློང་རྣམས་ལ་སྨྲས་པ།",
    "ཁྱུ་མཆོག་བ་ལང་གི་ཚོགས་ཀྱིས་བསྐོར་བ་ལྟ་བུ།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་བུ་སྟོང་གིས་བསྐོར་བ་ལྟ་བུ།",
    "ཉི་མ་འོད་ཟེར་སྟོང་གིས་བསྐོར་བ་ལྟ་བུ།",
    "མིག་མི་བཟང་ཀླུའི་ཚོགས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པའི་སྐུ་ཉི་མའི་འོད་ཟེར་སྟོང་བས་ལྷག་པའི་འོད་ཅན།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་གཞོན་ནུ་དོན་ཐམས་ཅད་གྲུབ་པ་འབབ་ཆུ་རོ་ཧི་ཏ་ཀར་བྱོན་ཏོ་ཞེས་ཐོས་སོ།",
    "ཅི་ཡབ་སྲས་ཀྱི་ཞབས་ལ་ཕྱག་བྱེད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འོན་ཏེ་སྲས་ཡབ་ཀྱི་ཞབས་ལ་ཕྱག་བྱེད་པ་བལྟའོ་སྙམ་མོ།",
    "དེ་ལྟ་བརྒྱ་སྟོང་ཕྲག་དུ་མས་ཞབས་འབྲིང་བྱས་ནས་སྟེང་གི་ནམ་མཁའ་ལས་གཤེགས་ཏེ་དེས་དེ་སྲིད་དུ་དཀའ་བ་བརྒྱ་སྟོང་སྤྱད་པས་བདུད་རྩི་ཐོབ་ནས་ང་ཞབས་ཀྱིས་གཤེགས་པ་ལྟ་ཞེས་མ་དད་པ་སྐྱེས་པར་འགྱུར་རོ་སྙམ་ནས།",
    "སྐུའི་སྟོད་ནས་ཆུ་གྲང་མོའི་རྒྱུན་འབེབས་པར་མཛད་དེ།",
    "སྐུའི་སྨད་ནས་ཆུ་གྲང་མོའི་རྒྱུན་འབེབས་པར་མཛད་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "དགེ་སློང་རྣམས་ནི་ཏ་ལ་དྲུག་གི་སྲིད་ཙམ་ནའོ།",
    "བཅོམ་ལྡན་འདས་དྲུག་གི་སྲིད་ཙམ་ན་ནི་དགེ་སློང་རྣམས་ལྔའི་སྲིད་ཙམ་ནའོ།",
    "བཅོམ་ལྡན་འདས་བཞིའི་སྲིད་ཙམ་ན་ནི་དགེ་སློང་རྣམས་གསུམ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བཅོམ་ལྡན་འདས་གཉིས་ཀྱི་སྲིད་ཙམ་ན་ནི་དགེ་སློང་རྣམས་ཏ་ལ་གཅིག་གི་སྲིད་ཙམ་ནའོ།",
    "བཅོམ་ལྡན་འདས་མི་བདུན་གྱི་སྲིད་ཙམ་ན་བཞུགས་ན་ནི་དགེ་སློང་རྣམས་མི་དྲུག་གི་སྲིད་ཙམ་ནའོ།",
    "བཅོམ་ལྡན་འདས་དྲུག་གི་སྲིད་ཙམ་ན་ནི་དགེ་སློང་རྣམས་ལྔའི་སྲིད་ཙམ་ནའོ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་ཆོ་འཕྲུལ་དེ་ལྟ་བུ་དེ་དང་།",
    "འདི་ནི་ཉོན་མོངས་སེལ་མཛད་ཉིན་བྱེད་དོན་ནི་ཀུན་ཏུ་སྟོན་མཛད་ལགས།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་གིས་ལུས་བཏུད་ནས་ཞབས་ལ་ཕྱག་བྱས་ཏེ་ཚིགས་སུ་བཅད་པས་གསོལ་པ།",
    "བློ་གྲོས་ཡངས་པ་ཁྱོད་ལ་འདི་དང་ནི།",
    "དེ་ནས་ཤཱཀྱ་དང་ཤཱཀྱ་མོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ཟས་གཙང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་ཤཱཀྱ་དང་ཤཱཀྱ་མོ་རྣམས་ལ་གོ་བར་བྱ་བའི་ཕྱིར་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གང་གི་ཚེ་ན་གཞོན་ནུ་དོན་ཐམས་ཅད་གྲུབ་པ་བལྟམ་པ་ན་ས་ཆེན་པོ་གཡོས་པར་གྱུར་ཅིང་འཇིག་རྟེན་འདི་ཐམས་ཅད་སྣང་བ་རྒྱ་ཆེན་པོས་གསལ་བར་གྱུར་ཏེ།",
