    "དེ་ནི་ལུས་དེ་ཉིད་ཀྱིས་དགེ་སྦྱོང་གི་འབྲས་བུ་བཞིལས་དགེ་སྦྱོངགི་འབྲས་བུ་གང་ཡང་རུང་བ་ལལ་ཐོབ་པར་འགྱུར་བའི་སྐལ་བ་མེད་དོ།",
    "ཀུནནསཉོནམོངས་པརའགྱུར་ཞིང་དེ་ཙམགྱིས་ནི་ངའི་སེམས་དངས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ནི་ལྷ་དང་མི་དང་ལྷ་མ་ཡིན་དུ་བཅས་པའི་འཇིག་རྟེན་གྱིས་དགེ་སྦྱོང་གི་ཆ་བྱད་ཅན་གྱི་ཆུན་པོར་རིག་པར་བྱ་སྟེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ནི་ལམ་མོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ནི་ལམ་ཀྲ་མོ་ ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ནི་སཱང་བའོ།",
    "བཅོམ་ལྡནའདས་དབེན་པ་ནི་ཀུནནས་ཉོན་མོངས་པར་མི་འགྱུར།",
    "སྟོང་པ་ཉིད་ནི་ཀུན་ནས་ཞོན་སུམོངས་པར་མི་འགྱུར།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་པདེའི་དོན་བདག་གིས་ཇི་ལྟར་འཚལ་བར་བགྱི།",
    "ཅི་འོན་ཀྱང་བདག་དང་བདག་གིར་བྱ་བ་དབེན་ཞིང་སྟོང་ངམ།",
    "བདག་གིར་བྱ་བ་མེད་པ་དེ་ལ་འཛིན་པ་མེད།",
    "དེ་ལ་ཀུན་ནས་ཉོན་མོངས་པ་གང་ཡང་མེད་པས།",
    "གང་གིས་སྤྱོད་པ་དང་།",
    "འདི་དགགིས་ནི་ཤས་གསུངས་པ་ཡིནནོ།",
    "ཅི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དེའི་རྒྱས་བསོདནམསམང་ངུའཕེལ་ལམ།",
    "རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་གཞན་ལ་སྟོན་པ་དང་།",
    "རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའདིག་ཞན་ལ་སྟོན་པ་དང་།",
    "རབ་འབྱོར་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གངཤེ་ས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་གཞན་ལ་སྟོན་པ་དང་།",
    "དེ་ནི་འདི་ལྟར་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུཕྱིན་པ་ལ་སྐྱོད་པའི་ཚེ།",
    "སྦྱིན་བདག་གི་སྦྱིནཔ་དག་པརའགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རེལ་ཞུ་ཡིན་པའི་སྟོང་པ་ཉིད་དང་།",
    "འ་སེམས་དབའ་ཆེན་པོ་སྦྱོར་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་དེ་ལྟ་བུ་ཁྱོད་ཀྱིས་མཐོང་ངམ།",
    "རིགས་ཀྱི་བུ་དར་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་ཞིང་འཆང་བ་དང་།",
    "སྟོང་གི་ཆ་དང་།",
    "བྱེབ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲག་སྟོང་གི་བར་གྱི་ཆ་དང་།",
    "༣ལྡན་པ་མངོནཔར་ཤེས་པ་ལྔ་དང་ལྡན་པ་དེ་དག་ཐམས་ཅད་ནི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གངཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུཕྱིན་པ་ཟབ་མོའདི་མི་ག་ཡང་བའི་སེམས་ཀྱིས་འཛི་ནཔ་དང་།",
    "དགེ་སློང་འཛམབུའི་གླིང་གི་སེམསཅན་དག་བ་བཅུའི་ལས་ཀྱི་ལམ་དང་ལྡན་པ།",
    "གཔཤེས་རབ་ཀྱིཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོའདི་འཛིན་པ་དད་འཆང་བ་དད།",
    "བྱང་ཆུག་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་༩ གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ལ་དེ་ལྟར་སྤྱོད་པ་དེ་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་རྟག་ཏུ་དགོངས་པ་ཡིན་ཏེ།",
    "འདི་དག་ཀྱངབྱངཆུབསེམས་དཔའ་སེམས་དཔའ་ཆེནཔོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནཔ་ཟབ་མོ་འདི་ལ་སྤྱོད་པའི་ཚེ་འདིའི་ཡོན་ཏན་དུ་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་འཕེལ་བ་དྲུག་པ་ཡིན་ནོ།",
    "སེམས་མོས་པར་མ་བྱས་པདེའི་དྲུང་དུ་བདུད་སྡིག་ཅན་དག་བཙོ་བའི་བསམ་པས་ཉེ་བར་འོད་དོ།",
    "འོནཏམམ་ཡིན་ཞེས་ཐེཚོམ་དུ་གྱུར་པ་དེདག་གི་དྲུངདུ་བདུད་སྡིག་ཏོ་ཅན་བརྩེ་བའིབ་སམ་པས་ཉེ་བར་འོང་ངོ།",
    "ཀུན་ཆུབ་པར་བྱས་པས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "ཁྱེད་ཀྱིས་ལྟ་རྙེད་རེ་སྐན་ཞེས་ཟེར་ན།",
    "ཁྱོད་ནི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་པྱན་པ་ལ་སྐྱེད་པ་མ་ཡིནནོ།",
    "ཀུན་དགའ་བོ་གཞན་ཡང་གང་གི་ཚེ་བྱངཆུབསེམས་དཔའ་བདགཉིད་མཆོག་ཏུ་རློམ་སེམས་བསྐྱེད་ན།",
    "མཚནམ་དེ་དག་གིས་ཉོནམོངས་པ་བསྐྱེད་ཅིང་།",
    "བདག་གི་གནས་ནི་སྟོངས་པརམིའགྱུར་རོ།",
    "དེ་ལ་དེ་དག་གིས་ཐོས་སམམཐོང་ནམཐུནཔར་སྤྱདཔར་འགྱུར་ཏེ་དེ་ལ་དེ་དག་གིས་ཐོས་སམམཐོང་ནམཐུནཔར་སྤྱོད་ཅིང་དེ་བཞིན་དུ་སློབ་སྟེ།",
    "ཉོན་མོངས་པཤིན་ཏུའཕེལ་བར་འགྱུར་ཏེ།",
    "འཐབ་མོ་དང་།",
    "བྱིན་ཆད་སྡོམ་པ་འཛིན་ཞིང་བདག་གིས་ནི་ཐོབ་པར་བྱ་བཉེསཔར་ཐོབ་སྟེ།",
    "དེ་ལྟར་བདག་གཞན་ལམི་སྙན་པར་སྨྲ་ཞིང་ཕྱིར་བཟློག་པ་ནི་མི་ཚུལ་གྱིས་བདག་གིས་དེ་ལྟར་མི་བྱའི།",
    "བདག་གིསགླེན་པ་དང་ལྐུག་པབཞིན་དུ་བྱའོ།",
    "བདག་གིས་དེ་དག་ལ་གནོད་སེམསསུམི་བྱའོ།",
    "སྡུག་བ་སྔལ་ཐམས་ཅད་ལས་ཡོངས་སུ་དགྲོལ་བར་བྱ་བ་དག་གོ་སྙམ་མོ།",
    "འདི་ནི་བདག་གི་གྲོགས་ཏེ་གྲུ་གཅིག་ཀཏུཞུགས་པའོ།",
    "འདིས་ཇི་ལྟར་བསླབ་པར་བྱབ་དེ་བཞིན་དུབ་དག་གིས་ཀྱང་བསླབ་པར་བྱའོ།",
    "རྣམ་པ་ཐམསཅད་མཁྱེན་པ་ཉིད་ཀྱི་བ་ར་གང་ལ་བསླབ་པར་བྱ་བ་དེ་ཉིད་ལ་བདག་གིས་ཀྱང་བསླབ་པར་བྱའོ་སྙམ་དུསེམས་བསྐྱེད་དོ།",
    "དེ་ལ་བདག་གིས་བསླབ་པར་མི་བྱའོ།",
    "བདག་གིས་ཀྱང་དེ་ལྟར་བསླབ་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་གང་གིས་དེ་བཞིན་གཤེགས་པཞེས་བརྗོད་པའི་དེ་བཞིན་ཉིད་དེ་དང་།",
    "བྱོལ་སེང་གི་སྐྱེ་གནས་དང་།",
    "ཕྱིར་མི་ལྡོག་པའི་སར་ཆུད་པར་འདོད་བས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་སྤྱན་པ་ཟབ་གང་མོ་འདི་ཉིད་ལ་བ་སླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་འཕེལ་བ་བཅུག་ཅིག་པ་ཡིན་ནོ།",
    "རབ་འབྱོར་དེ་ནི་འདི་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོའདིར་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐམས་ཅད་འདུས་སོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་འཕེལ་བ་བཙུགསུམ་པ་ཡིན་ནོ།",
    "དེབཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་རེ་རེ་ལ་ཡང་སྐུ་ཚེ་འི་མཐར་ཕྱི་ནགྱི་བར་དུ་བྱར་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོས་རྒྱུན་མཆད་པར་ན་བཟའ་དང་།",
    "རབ་འབྱོར་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་སོགད་ཆེཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོའདི་འཛིན་ཞིང་།",
    "གང་གི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུཕྱིན་པར་འགྱུར་བ་དང་།",
    "གང་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནཔར་འགྱུར་བ་དང་།",
    "འདི་དག་གིས་ནི་རྣམ་པར་འཕེལ་བ་བསྟན་པ་ཡིནནོ།",
    "གང་གིས་བླན་མེདཔ་ཡང་དག་པར་རྫོགས་རོ་། པའི་བྱང་ནུབ་ཏུ་སེམས་བསྐྱེད་པ་དག་ལཱ་ཅི་ལྟོས།",
    "བདེ་བར་མོས་ཤིང་ལེགས་པར་བགྱི་བར་མོས་ཏེ།",
    "སྐྱེ་བ་ག་ཅིག་གིས་ཐོགས་པའི་བྱད་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་རྣམསཀྱིསེམས་བསྐྱེད་རྒྱལཔོ།",
    "ཀོ་ཤ་ཀ་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་དང་།",
    "ཀོ་ཤི་ཀ་སྟོང་གསུམ་གྱི་སྟོང་ཆེ་ན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་རྒྱ་མཚོ་ཆེན་བ་རྣམས་ལ་ཆུའི་ཕུང་པོ་ཆེན་པོ་ཇི་སྙེད་ཡོད་པ་དེ་དག་ནི་སྐྲའི་རྩེ་མོ་བརྒྱར་གཤགས་པའི་ཆ་གཅིག་གིས་ཆུའི་ཐིགས་པ་བླངས་པའི་ཚད་ཀྱིས་ཚད་གཟུང་བར་རུང་ཡང་སྲིད་ཀྱི།",
    "བཅོམ་ལྡན་འདས་གང་གིས་སེམས་བསྐྱེད་པ་འདི་བསྒྲུབས་ཏེ།",
    "ནམ་ཡང་རེག་ཡིད་དུ་མི་འོང་བ་རིག་པརམི་འགྱུར་རོ།",
    "བྱོལ་སེང་གི་སྐྱེ་གནས་དང་།",
    "དོན་འདི་ལ་ཁྱོད་ཀྱང་ཡང་དག་པའི་མཐའ་གང་མངོན་དུ་བྱས་པས་ཉན་ཐོས་ཀྱི་ས་འམ།",
    "གང་གིས་ཞུམ་པར་འགྱུར་བ་དང་།",
    "གང་གིས་ཞུམ་པར་འགྱུར་བ་འམ།",
    "རབ་འབྱོར་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱི་ཁམས་དག་ནསེམསཅནགངཇི་སྐྱེད་ཅིག་བོད་པ་ཐམས་ཅད་བདུད་སྡིག་ཅན་དུ་གྱུར་ཏེ།",
    "བདུད་སྡིག་ཅན་དེ་དགརེ་རེས་ཀྱར་དེ་སྐད་ཀྱི་བདུད་སྡིག་ཅནམངོནཔ་ར་སྤྲུལ་ཀྱང་དེ་ཐམས་ཅད་ཀྱིས་བྱུར་ཆུབ་སེམས་དཔའསེམས་དཔའཆེན་པོ་དེལ་བར་ཆད་བྱ་བར་མི་ནུས་སོ།",
    "དེ་བས་ནརིགས་ཀྱི་བུ་ཁྱོད་ཀྱིསའདི་ལྟ་སྟེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱི་རྣམ་པར་སྤྱོད་པ་དེས་རྣམཔར་སྤྱད་པ་དང་།",
    "རབ་འབྱོར་གང་ཁྱོད་འདི་སྐད་དུག་དེ་བཞིན་ཉིད་ལ་གནས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་སྒྱུ་མ་ཡང་ཡང་དག་པརརྗེས་སུམ་མཐོང་།",
    "བཙོམ་ལྡ་ནའདས་དེ་ནི་འདི་ལྟར་གང་ཉོན་མོངས་པར་འགྱུར་བ་འམ།",
    "སྦྱིནཔའི་ཕ་རོལ་ཏུ་ཕྱིན་པར་མིའགྱུར་རེ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོད་པ་ཉིད་ཀྱི་བར་དུ་མིའགྱུར་རེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་དོན་བདག་གིས་འཚལ་བ་ལྟར་ན་དཀའ་བ་ཅུང་ཟད་ཀྱང་མི་བགྱིད་ནཇི་ལྟར་བྱད་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་དཀའ་བ་བགྱིད་པ་ལགས།",
    "གང་གིས་མངོན་དུབགྱི་བའི་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་མི་དམིགས།",
    "བླན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བུད་ཆུབ་ནི་ཉེའོ་ཞེས་བགྱི་བར་མི་སེམས་སོ།",
    "གླང་གི་གཟུགས་ཀྱིསའཁྲུལ་འཁོར་ཞིག་སྦྱར་ན།",
    "དེ་དོ་ན་གང་གི་སླད་དུ་བགྱིས་པའི་དོན་དེ་བསྒྲུབ་ཀྱང་འཁྲུལ་འཁོར་དེ་ནི་རྣམ་པར་མི་རྟོག་གོ།",
    "བཅོམ་ལྡནའདས་དེ་བཞིན་དུ་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱི་ན་པ་ཡང་དོན་གང་གིས་སླད་དུ་བརྗོད་པའི་དོན་དེ་བགྱིད་ཀྱངཤེས་རབ་ཀྱི་ཕརོལ་དུཕྱིན་པ་ནི་རྣམ་པར་མི་རྟོག་པའོ་ཞེས་བྱ་བ་ནིབྱ་བ་འབྲས་བུ་དང་བཅས་པའི་རྣམ་པར་རྟོག་པ་ཡི་ནཏེ།",
    "འདི་དག་གིས་ནིའཇུག་པའི་ཕྱོགས་ཀྱི་རྟེནཅན་གཟུང་བའི་རྟོག་པ་དང་པོ་རྣམ་པ་དགུགསུངས་པ་ཡིན་ནོ།",
    "ཁྱིམ་ཐབ་དཔའབོས་ཤིན་ཏུ་བསྲུངས་པའི་བུད་མེད་ཤིན་དུཕུན་སུམ་ཚོགས་པའིཁྱིམ་ན་འདུག་པ་ནི་འཕྱོནམ་པ་རྣམས་ཀྱིས་མི་ཚུགས་པ་ཡིན་ནོ།",
    "ཆུ་ཀླུང་ཕྲ་མོ་གངཇི་སྙེད་ཅིག་ཡོདཔ་དེ་དག་ཐམསཅད་ནི་ཆུ་ཀླུང་ཆེན་པོ་གཾ་གཱ་གང་ན་བ་དེར་དོད་སྟེ།",
    "ལནཚྭའིརེར་རོ་གཅིག་པར་འགྱུར་རོ།",
    "རྟ་རིན་པོ་ཆ་དེ་དག་ནི་དཔུང་གི་ཚོ་གས་ཡན་ལག་བཞི་དང་ལྡན་པའི་མདུན་དུ་འདོང་ངོ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་ཕ་རོལ་ཏུ་ཕྱིནཔ་ལྔ་པོ་འདི་དག་གི་མདུན་དུའགྲོ་སྟེ།",
    "དེཅིའི་ཕྱིར་ཞེ་ནགོག་དེ་དག་གི་རང་བཞིནནི་དེ་ཡིན་ཏེ།",
    "མལ་བདགགིས་སེ་མས་ཅན་དེ་དག་གི་དོན་དུ་སྦྱིན་པའི་ཕརོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པར་བྱའོ།",
    "དེ་སེམསཅན་དེ་དག་གི་དོན་དུ་ཕྱི་ནང་གི་དངོས་པོ་རྣམས་ཡོངས་སུགཏོང་སྟེ།",
    "ཡནལག་དང་རི་ལག་བཅད་ཀྱང་ཞེ་སྡང་གི་སེམས་མི་བ་སྐྱེད་དོ།",
    "གལ་ཏེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མེད་ན་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་འདི་དགགིས་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་འཐོབཔར་མི་འགྱུར་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྟེནན་ཕ་རོལ་ཏུ་ཕྱིན་བལྔ་བོ་རདི་དག་གིས་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་འཐབ་པར་འགྱུར་རོ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་བ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྟེན་ནཕ་རོལ་ཏུཕྱིན་པལྔ་པོ་འདི་དག་གིས་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་འཐོབ་པར་འགར་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ཅིའི་སླད་དུ་བརོལ་ཏུཕྱིན་པ་ལྔ་པོ་དདག་གི་རབཅེས་པགྱི།",
    "རབ་འབྱོར་རྣམ་གྲངས་དེསན་ཞེས་རབཀྱ་བ་རོལ་ཏུཕྱིན་བ་ནི་ཕ་རོལ་ཏུཕྱན་པ་ལྔ་པོ་འདི་དག་གི་རབ་ཅེས་བྱ།",
    "འདི་དག་གིས་ནི་གཟུང་བའི་རྣམ་པར་རྟོག་པ་གཉིས་བརྣམ་པདགུགསུངས་པ་ཡིན་ནོ།",
    "གནས་པ་མེད་པའི་ཚུལ་གྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཡྔོད་དོ་ཞེས་བྱ་བ་ནི་དངོས་ཁོང་གུ་པོ་ལ་མ་རེན་པར་ཞེན་པའི་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "བདག་ནི་ཞེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལམིན་སྒོམ་མོ།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་དཔུང་གི་ཆོགས་ཡན།",
    "རྣམ་པ་ཐམས་ཅདམཁྱེནཔ་ཉིན་གང་ན་བ་དེརགཞས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་འགྲོ་བ་ལ་ཐོགས་པའི་རྣམ་པ་དརྟོག་པ་ཡིན་ཏེ་འདི་དགགིས་ནི་འདིན་པའི་རྟོག་པ་དང་པོ་རྣམ་པ་དགུ་ག་གསུངས་པ་ཡིན་ནོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་དོན་དེ་ཡང་བརྗོད་མོད་ཀྱི་གཟུགས་ཡོངས་སུ་མི་འཛིན་ཏོ།",
    "དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རྔོལ་ཏུ་ཕྱིན་པ་ཡང་ཚོས་ཐམ་ས་ཅད་ཀྱི་སྒོ་སྟེ།",
    "འདི་དག་གིས་ནི་འཛིན་པའི་རྟོག་པ་གཉིས་པརྣམ་པ་དགུགསུངས་པ་ཡིན་ནོ།",
    "ཀོནི་ཀག་ཁྱོད་ཀྱིས་དེ་སྐད་དུ་སྨྲས་ཏེ་དེ་སྐད་དུ་བརྗོད་པས་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་རྗེས་སུ་བརྗོད་པ་དང་།",
    "གང་གི་ལུས་ལ་དཔེ་བྱད་ཡོད་པར་འགྱུར་བལྟནིསྲས།",
    "སྟོད་གི་ཆ་དང་།",
    "བརྒྱ་ཕྲག་སྟོང་གི་ཆདང་།",
    "རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་རྗེས་སུ་ཐོབ་ནས་བག་ཆགས་ཀྱི་མཚམས་སྦྱོར་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པའི་དེ་བཞིན་གཤེགས་བདགྲ་བཅོམ་པ་ཡང་དག་བར་རྫོགས་པའི་ས་སརྒྱས་སུ་འགྱུར་རོ་ཞེས་བྱ་བནི་མཐོང་བའི་ལམགྱིཕན་ཡོན་ཡིནནོ།",
    "དགེ་སློང་དེ་དག་གིས་ཐལ་མོ་སྐྱར་ཏེ་བཏུད་པའི་ཚེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་དེ་དག་གི་བསམ་པཐུགས་སུ་ཆུད་དེ།",
    "བུས་མོ་གཡས་པའི་ལྟང་ས་ལ་གཙུགས་ནས་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུཐལ་མོ་སྦརབབཏུད་དེ།",
    "གང་ཤོས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐབ་མོ་འདི་ལ་སྐྱོད་པའི་རིགས་ཀྱི་བུ་དང་།",
    "རིགས་ཀྱི་བུམོ་དེས་འདི་ལྟར་བདག་ནི་མིའི་ནང་ནས་ཤི་འཕོསནས་འདིར་སྐྱེས་པའམ།",
    "དགའ་ལྡན་གྱི་ལྷའི་རིས་སུ་ཤེསརབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་ཟབམོ་འདི་རྐྱ་ཆེར་ཐོས་པའོཞེས་བྱ་བར་གཏོག་ན་པར་རིག་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་ཤས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབམོ་འདི་ནབ་དང་།",
    "ཉན་ཐོས་རྣམས་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནབ་ཟབམོ་འདི་རྗེས་པམ་ཡིནནོ་ཞེས་བྱ་བར་རིག་པར་བྱའོ།",
    "ཀུན་དགའ་བོ་རིགས་ཀྱི་བུའམའིགས་ཀྱི་བུ་མོགན་ལལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིནཔ་དང་།",
    "ཀུན་དག་འབོ་རོགིས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོགང་ལལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་བསྟན་པ་འདི་ཐོས་ནཕྱིར་མི་ལྡོག་ཅིང་ངན་ངུ་མི་བརྗོད་ལ།",
    "ཀུན་དགའ་བོ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེ་སྔོན་གྱི་རྒྱལ་བ་ལ་བྱ་བ་བྱས་པ།",
    "ཀུན་ཆུབ་པར་བྱས་ནས་དེའི་འོག་ཏུ་ཆུད་གསན་ཏེ་བོར་ཡང་དེ་ཙམ་གྱིས་ཀུན་དགའ་བོ་ཁྱོད་ལ་སྐྱོན་དུ་ངས་མི་བརྩིའི་ཀུན་དགའབོ་གལ་ཏེ་ཁྱོད་ཀྱིས་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབམོ་འདི་གཟུང་སྟེ།",
    "དེ་ཙམ་གྱིས་ནི་ཀུན་དགའ་བོ་ཁྱོད་ལ་ངས་སྐྱོན་དུ་གཟུང་ངོ།",
    "རྒྱ་འདྲུགཀུན་དགའ་བོ་དེ་བསན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནཔ་ཟབ་མོ་འདི་ཁྱོད་ལ་གཏད་ཀྱིས།",
    "ཀུན་དགའ་བོ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གདལ་ལས་ཤེས་༢བ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟག་པོ་འདི་འཛིན་པ་དང་།",
    "ཀུན་དགའ་བོརགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིནཔ་དེས་ནའདས་བ་དང་།",
    "ཀུན་དགའ་བོ་གད་ལ་ལ་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་བསྟན་པ་ལརི་མ་གྲོ་དང་།",
    "མོས་པ་སྐྱེས་པ་དེས་ནི་འདས་པ་དང་།",
    "མོས་པ་བསྐྱེད་པར་འགྱུར་རོ།",
    "ི་ནས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདིལས་ཚིག་འགའ་ཡང་ཁྱོད་ཀྱིས་ཆུད་མ་ཟོས་པར་གྱིས་ཤིག།",
    "ཀུན་དགའ་བོརིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛི་ནཔ་དང་།",
    "གཞནལ་ཡང་ཞེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་རྣམ་གྲངས་དུ་མར་རྒྱ་ཆེར་ཆད་པ་དང་།",
    "དགྲ་བཅོམ་པ་དེ་དག་གིས་སྦྱིན་པ་ལས་བྱུང་བའི་བསོད་༧ བཅོབ་ནམས་བྱབའི་དངོས་པོ་དང་།",
    "ཀུན་དགའ་བོ་ཉི་མ་ཕྱེད་ལྟ་ཞོག་གི།",
    "ཉོན་མོངས་པམེདཔ།",
    "དེའི་ཕྱིར་དེ་དག་གིས་མ་མཐོང་བར་གྱུར་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚ་དང་ལྡནཔ་ཀུན་དགའབོལ་བཀའ་སྩལ་པ་ཀུན་དགའབོ་ཁྱོད་ཀྱིས་དེ་བཞིན་གཤེགས་བ་མི་འཁྲུགས་པའི་ས་སརྒྱས་ཀྱི་རྐང་དང་།",
    "ཀུན་དགའ་བོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབམོ་འདི་ཡི་གེ་ཐམས་ཅད་ལ་འཇུག་པའོ།",
    "ཀུན་དགའ་བོ་ཞེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ནི་འདས་པ་དང་།",
    "རང་རང་གི་བསྟན་ལ་འཇུག་པར་མི་འདོད་དོ།",
    "དེ་ནས་ཆེ་དང་ལྡནཔ་རབ་འབྱེགྱིསབཙེམོ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བྱམས་པའི་དག་གི་ལས་དང་།",
    "སེམསཅནཐམསཅད་དང་ཐུནམོང་དུ་བྱས་ནསབླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱ་ཆུབ་ཏུ་ཡོངས་སུ་བསྔོ་སྟེ།",
    "དེ་ཇི་ལྟརགང་གིས་ཡོངས་སུབསྔོ་བ་དང་།",
    "བདག་གིས་ནི་སྦྱིན་པ་ཡོངས་སུ་ག་ཏང་བར་བྱ་སྟེ།",
    "བདག་གིས་ནི་སྦྱིན་པ་ཡོངས་སུ་མི་བཏང་བར་མི་བྱའོ་ཞེས་དེ་ལུས་དང་སེམས་ཀྱི་བརྩོན་འགྲུས་བ་སྐྱེད་དེ།",
    "སེམསཅན་ཐམས་ཅད་དང་ཐུན་མོང་དུ་བྱས་ནས་བླནམེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱང་ནུབ་ཏུ་ཡོངསུ་བསྔོ་སྟེ།",
    "དེཇི་ལྟར་གང་གིས་ཡོངས་སུབསྔོ་བ་དང་།",
    "ཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "དེ་ཡང་ཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "ཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "ཅི་ནས་ཀྱང་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "དེ་ཇི་ལྟར་གངགིས་ཡོངས་སུ་བསྡོ་བ་དང་།",
    "བཅོམོ་ལྡན་འདས་ཇི་ལྟར་ན་བྱང་རྔུབ་སེམས་དཔའསེམསདཔའཆེན་བོ་བཟོདཔའི་ཕརོལ་ཏུ་ཕྱིན་པ་གཅིག་ལ་གནས་ཤིང་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུའཛིན་པ་ལགས།",
    "དེ་ཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་དང་། ། གང་ཡོངས་སུ་བསྔོབ་དང་།",
    "དཔག་ཚད་བྱེབ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གི་བར་རམ།",
    "ཇི་ལྟར་དེ་ལ་འདུ་ཤེས་རྣམ་པགསུམ་པོ་གང་ཞིག་གིས་ཡོངས་སུ་བསྔོབར་བྱེད།",
    "གཞན་གང་གིས་སྲོག་གཙོད་པ་སྔངས་པ་དེ་དག་གིས་ལེགས་པ་བརྗོད་ཅིང་མཐུན་པས་དགའ་བར་བྱེད་པ་ཡིན།",
    "གཞནགང་གིས་འདོད་པས་ལོག་བཇག་ཡམ་པ་སྤྲངས་པ་དེ་དག་གི་ལེགས་པ་བརྗོད་ཅིང་མཐུན་པས་དགའ་བར་བྱེད་པ་ཡིན།",
    "གཞན་གང་གིས་ཕྲམ་སྔངས་པདེདག་གི་ལེགས་པ་བརྗོད་ཅིང་མཐུན་པསདགའ་བར་བྱེད་པ་ཡིན།",
    "བདག་གིས་ཀྱང་ཚིག་འཁྱལ་པ་སྤངས་པ་ཡིན།",
    "གཞནགངགས་ཚིག་འཁྱལ་པ་སྤངས་པ་དེ་དག་གིས།",
    "གཞནགང་གིས་ཆགས་སེམས་སྤངས་པ་དེ་དག་གི་ལེགས་པ་བརྗོད་ཅིང་མཐུནཔས་དགའ་བ་བྱེདཔ་ཡིན། ། བདག་གིས་ཀྱང་གནོད་སེམས་སྤངས་པ་ཡིན།",
    "བདག་གིས་ཀྱང་ལོག་པར་ལྟ་བ་སྤངསཔ་ཡིན།",
    "གཞནགང་གིས་ལོག་པར་ལྟ་བ་སྤངས་པ་དེ་དག་གི་ལེགས་པ་བརྗོད་ཅིང་བཐུན་པས་དགའ་བར་བྱེད་པ་ཡིན་ཏེ།",
    "དེཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "གཟུག་མེད་པའི་སྙོམས་པར་འཇུག་པ་དེ་དག་གི་རྣམ་པར་སྨིནཔ་ཡོངས་སུ་མི་ལེན་ཏེ།",
    "དེ་ཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "དེ་ཇི་ལྟར་གངགིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "དེ་ཇི་ལྟར་འདི་ལ་གང་གིས་བསྔོ་བར་བྱེད་པ་འམ་གད་བསྔོ་བར་བྱེད་པ་འམ་གད་དུ་བསྔོ་བར་བྱེད་པའི་འདུ་ཤེས་རྣམ་པ་གསུམ་མི་འཇུག་པ་དེ་ལྟར་ཡོངས་སུ་བསྔོབར་བྱེད་དོ།",
    "དེ་ཇི་ལྟར་གང་གིས་བསྔོ་བ་དང་།",
    "རྩིག་པ་ལས་ཐལ་བ་དང་།",
    "རིལས་ཐལ་བ་ཐོགས་པ་མེད་པར་འགྲོ་སྟེ།",
    "དེ་ལྟར་བདག་དེ་ནས་ཤི་འཕོས་ནས་ཆེ་ག་མོ་ཞིག་ཏུ་སྐྱེས་སོ་ཞེས་བྱ་བ་ནས།",
    "དེ་ཇི་ལྟརགང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་མི་དམིགས་སོ།",
    "མིག་གི་འདུས་ཏེ་རྡེག་པ་མི་དམིགས་སོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཆོར་བ་མི་དམིགས་སོ།",
    "ད་ཇི་ལྟར་གངགིས་ཡོངས་སུ་བསྔོབ་དང་།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལ་ང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་མི་དམིགས་ཏེ།"
