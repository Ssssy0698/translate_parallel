    "ཕྲད་པའི་དུས་དང་འབྲལ་བའི་དུས་སུ་ཡང་རང་བཞིན་གཞན་སྐྱེ་བ་ནི་དེ་དག་གི་དེ་ལྟ་བུར་མི་རྟག་པ་ཉིད་དེ།",
    "ཤིང་དང་ཐལ་བ་ལ་སོགས་པ་དང་འོ་མ་དང་ཞོ་དང་མར་སར་པ་ལ་སོགས་པ་བཞིན་ནོ།",
    "དེ་དག་ལ་ནམ་རྡུལ་ཕྲ་མོའི་མཐར་ཐུག་པར་ཡན་ལག་དང་བྲལ་བར་འགྱུར་བ་དེ་ན་སྐྱེ་བ་མེད་པའི་མི་རྟག་པ་ཉིད་དུ་ཐམས་ཅད་མཁྱེན་པས་དགོངས་པར་བརྟག་གོ།",
    "དེ་བཞིན་དུ་ཡང་ས་ལ་སོགས་པའི་རྡུལ་ཕྲ་མོ་རྣམས་རྟག་པ་ཉིད་ན་སུ་མི་རྟག་པར་འགྱུར།",
    "རྡུལ་ཕྲ་མོ་མ་གཏོགས་པར་སྦོམ་པོའི་རྫས་མྲེད་པའི་ཕྱིར་རོ།",
    "ཥྤེ་ཡི་ཡ་ཡི་ཀ་དང་ཁྱད་པར་ཅན་ལ་སོགས་པ་རྣམས་ཀྱི་བྱེད་པ་དང་ལྡན་པའི་འདུས་ཁྱེཔའི་རྡུལ་ཕྲ་མོ་རྣམས་ཀྱང་ཆ་ཐ་དད་པར་ཕྱེ་བ་ནི་རྟག་པ་མེད་དོ་ཞེས་ཐམས་ཅད་མཁྱེན་པས་དགོངས་པའོ།",
    "དེད་དཔོན་བཞིན་དུ་བདག་གིས་དགའ་ས་རྙེད།",
    "འགོག་པའི་གོ་རིམས་ཀྱིས་མཚམས་སྦྱར་བའི་མཚན་ཉིད་ལ་མཁས་པ་གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཤེས་རབ་ཀྱིས་དཔྱད་དེ་ཤེས་པར་བྱ་བ་སྦོམ་པོ་དང་སྟིཕྲ་མོ་མི་སེམས་ཤིང་མི་དམིགས་སོ།",
    "གང་གིས་ཡུལ་རྣམས་འཛིན་པ་ནི།",
    "ཁམས་གསུམ་པ་བདག་དང་བདག་གི་མེད་པ་ནི་གཉིས་སུ་སྨྲ་བ་རྣམས་ཀྱི་བདག་ཏུ་རྣམ་པར་རྟོག་པའི་བརྟག་དུཔའི་སྐྱེས་བུ་མང་ངོ།",
    "རྟག་པ་མ་སྐྱེས་པས་ན་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་བཞིན་དུ་མེད་དོ།",
    "རྣལ་འབྱོར་པ་རྣམས་རྣལ་འབྱོར་གོམས་པར་བྱེད་པ་ན་སོ་སོར་བདག་གིས་རིག་པའི་ཁྱད་པར་དུ་འགྱུར་ཏེ།་",
    "མེ་གཅིག་གི་ཞེས་པའི་ཤིང་གི་་མེ་ལྕེ་རྣམས་རིང་པོ་དང་ཐུང་ངུ་ལ་སོགས་པའི་ཁྱད་པར་བཞིན་དུ་ཁྱེའགྱུར་རོ།",
    "མ་སྐྱེས་པས་ན་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་བཞིན་ནོ།",
    "ཡང་ན་རྩེད་མོ་ལ་མོས་པར་འགྱུར་བའམ།",
    "རང་གི་མཚན་ཉིད་ནི་ལུས་འདི་ལ་སྐྲ་དང་སོ་ལ་སོགས་པ་ཡོད་དེ།",
    "དེ་ལ་རྡུལ་ཕྲ་མོའི་ཚོགས་ལ་མི་མཛེས་པ་བསྒོམ་མོ།",
    "ཐབས་དང་ཉོན་མོངས་པ་ཟད་པ་དང་བྲལ་བ་སྟེ།",
    "གང་གི་ཚེ་མི་དམིགས་པ་དེའི་ཚེ་བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ་ཁྱོཡང་དག་པར་རིག་པ་རང་ཉིད་ཀྱིས་གནས་ཏེ།",
    "སྐད་ཅིག་མའི་རྒྱུན་བརྗོད་དུ་མེད་པར་རང་གི་ཁྱརིག་པ་མངོན་སུམ་དུ་བྱའོ།",
    "དེ་དག་གི་མ་བྱས་པའི་རྒྱུ་ནི་མོ་གཤམ་གྱི་བུ་ལ་སོགས་ང་།་",
    "སྐད་ཅིག་མའི་ཀྱེརྒྱུན་རྟག་པས་རྟག་གི།",
    "ཀུན་བརྟགས་པར་མི་རུང་བ་ནི་མ་སྐྱེས་པའི་ཕྱིར་རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་དུ་དངོས་པོ་མེད་དོ།",
    "གང་གི་ཚེ་ན་སྐད་ཅིག་པ་གཅིག་ཡོད་པ་དེའི་ཚེ་ན་སྐད་ཅིག་པ་གཉིས་པོ་མེད་པས་སུས་ཀྱང་མི་སྐྱེད་སྙེདོ།",
    "སྐད་ཅིག་གི་རྣམ་པར་རྟོག་པ་མེད་མོད་ཀྱི།",
    "ཁ་ཅིག་ནི་མི་སྐྱེ་བ་ལ་ཆད་པར་སྨྲ་བར་ལྷུང་བས་སེམས་རི་བོང་གི་རྭ་ལྟ་བུར་ཡོངས་སུ་རྟོག་ཅིང་རྨི་ལམ་དང་།",
    "རེ་ལྡེ་དང་རྩིག་པ་ལ་སོགས་པ་ཐ་དད་པར་ཤེས་པ་བཞིན་ཏེ།",
    "རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པ་དང་འགལ་བའི་ཕྱིར་རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་དུ་དངོས་པོ་མེད་དོ།་",
    "ཤིང་དང་ཐལ་བ་ལ་སོགས་པའི་རིམ་པ་ཐ་དད་པ་དང་།",
    "དེའི་ཕྱིར་མུ་སྟེགས་བྱེད་རྣམས་ཀྱི་བདག་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་ཐ་དད་པར་ཕྱེ་བ་ནི་དེ་དག་གི་རྟག་པར་མི་རིགས་ཏེ་དེས་ན་རྗེས་སུ་དྲན་པ་དང་།",
    "བདེ་བ་ལ་སོགས་པ་སྐད་ཅིག་ཏུ་འཇིག་པ་ལ་རུང་གི་རྟག་ཅིང་མི་འགྱུར་བ་ལ་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་ནི་ཇི་ལྟར་ཐོས་པ་ལས་བྱུང་བ་མེའི་མེ་སྟག་ཕྲ་མོ་ཡར་བ་བཞིན་དུ་འགྱུར་བ་དེ་དག་ལས་རྣམ་པར་ཤེས་པ་སྟུག་པོ་འབྱུང་སྟེ།",
    "རི་མོ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས།",
    "བདག་གི་ཡང་ཕྱི་རོལ་ཀྱི་དོན་གང་ཡང་མེད་དེ།",
    "ཁྱད་པར་ཅན་ལ་སོགས་པས་བརྟགས་སྣི་པ་སའི་རྫས་སྦོམ་པོ་དང་ཕྲ་མོ་རྣམ་པར་གཞིགས་པ་ན་ཁང་པ་དང་།",
    "རྟོག་པ་ནི་མ་སྐྱེས་པས་ན་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་བཞིན་ནོ།",
    "རྩེད་མོ་ཡང་དེ་ལ་ཇི་ལྟར་ན་ཡོད།",
    "ནམ་ཤེས་རབ་ཀྱིས་དཔྱད་དེ་སྦོམ་པོ་དང་ཕྲ་མོའི་ཆ་ཐ་དད་པར་ཕྱེ་བ་ན་ཁང་པ་དང་།",
    "ཉོན་མོངས་པའི་ཡིད་རྟག་ཏུ་ངར་བྱེད་པར་འཇུག་པ་དང་བདུན་ནོ།",
    "བདག་དང་བདག་གིར་ཆགས་པ་དང་།",
    "བརྒྱལ་བ་ལ་སོགས་པ་བཞིན་དུ་དེར་ཡུལ་དང་ཡུལ་ཅན་གྱེ་དངོས་པོ་རང་གི་སྣང་བ་ཉིད་ལ་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་རྣམས་འཇུག་གོ།",
    "དེ་དག་གི་ཕྱི་རོལ་གྱི་དམིགས་པ་མེད་པའི་ཕྱིར་ཡང་དག་པ་མ་ཡིན་པར་ཡོངས་སུ་རྟོག་པས་བསྐྱེད་པའི་ཡུལ་ལ་དམིགས་པ་རྣམས་སོ།",
    "བུད་མེད་དང་སྐྱེས་པ་ལ་སོགས་པའི་མཚན་ཉིད་དོ།",
    "རང་གི་སེམས་སྣང་བའི་གཟུགས་རབ་རིབ་ཅན་དང་རྨི་ལམ་དང་མིག་འཕྲུལ་ལ་སོགས་པའི་ཤེས་པ་བཞིན་དུ་ཁོང་དུ་ཆུད་པར་བྱེད་དོ།",
    "འབྲས་བུ་མོད་ལ་མྱོང་བར་འགྱུར།",
    "སེམས་ནི་སྐད་ཅིག་གི་རྒྱུན་དུ་འབྱུང་ཞིང་རྒྱུ་དང་འབྲས་བུའི་དུས་སུ་ཆད་པ་མེད་པས་བདེ་བ་དང་།",
    "གཞན་དག་ནི་རང་གི་བློའི་རྣམ་པར་རྟོག་པའི་བདེ་བ་དང་སྡུག་བསྔལ་མི་མྱོང་བ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལ་སྙོམས་པར་ཞུགས་པ་བསམ་གཏན་བཞི་དང་།",
    "ཁ་ཅིག་གིས་ནི་ཇི་ལྟར་རྟག་པའི་དངོས་པོ་མེད་པ་དེ་ལྟར་སྐད་ཅིག་གི་དངོས་པོ་མེད་ཅེས་ཏེ།",
    "སྐད་ཅིག་གི་སྐྱེ་བ་དང་གནས་པ་དང་རྒ་བ་དང་།",
    "བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ་མཆོག་ཏུ་དག་ཅིང་གཉིས་སུ་མེད་པའི་དོན་དམ་པའི་བདེན་པ་ཡང་དག་པར་རིག་པར་མྱོང་བ་ནི་རེདངོས་པོ་མེད་པ་མ་ཡིན་ཏེ།",
    "རྨི་ལམ་བཞིན་དུ་དེ་དག་གི་ཡེ་ཤེས་གཉིས་ཀྱི་རྣམ་པ་ཅན་ཏེ་གཉིས་སུ་མེད་པ་ཉིད་ནི་མ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་ཡིད་རབ་ཏུ་གྱུར་པ་ན་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཞེས་བྱའོ།",
    "འཇུག་པའི་རྣམ་པར་ཡེ་ཤེས་པ་དྲུག་གི་ནང་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་སུ་བརྗོད་དོ།",
    "ཉོན་མོངས་པ་དང་ཉོན་མོངས་པ་བདུན་རྣམས་ཀྱིས་དེའི་རྒྱུ་དང་དེ་ལ་དམིགས་པའི་ཕྱིར་རོ།",
    "གང་ཟག་ལ་བདག་མེད་པ་ཡོངས་སུ་ཤེས་པས་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པ་ལྡོག་གོ།",
    "དེ་བཞིན་དུ་ཡང་བདག་དང་བདག་གིར་ཆགས་པ་ལོག་པ་ན་ལས་ཀྱི་སྒྲིབ་པ་ལྡོག་སྟེ།",
    "ཉོན་མོངས་པ་དང་ཉོན་མོངས་པ་མེད་པའི་མི་ཤེས་པའི་རྒྱུད་ཐམས་ཅད་རྩ་བ་ནས་ཕྱུང་བ་མཆོག་ཏུ་ཡོངས་སུ་དག་པའི་འདོད་ཆགས་དང་བྲལ་བ་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པ།",
    "བདག་དང་རྡུལ་ཕྲ་མོའི་རྫས་ལ་སོགས་པ་རྣམ་པར་རྟོག་པའི་ཡུལ་མེད་དེ།",
    "མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པ་བཞིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་བདག་གི་སོ་སོ་རང་གིས་རིག་པ་ལ་འཇུག་པ་དང་།",
    "དེ་ལ་བློ་གྲོས་ཆེན་པོ་རྣམ་པར་རྟོག་པ་ནི་གང་དག་གིས་མིང་དུ་བརྗོད་ཅིང་འདི་ནི་གླང་པོ་དང་།",
    "བུད་མེད་ལ་སོགས་པ་ཡིན་ཏེ།",
    "བློ་གྲོས་ཆེན་པོ་ཡང་དག་པའི་ཡེ་ཤེས་ནི་གང་གིས་མིང་དང་།",
    "གང་གིས་བུད་མེད་དང་སྐྱེས་པ་ལ་སོགས་པ་མཛིས་པ་དང་མི་མཛེས་པའི་མཚན་མ་འཛིན་པ་ནི་རྣམ་པར་རྟོག་གོ།",
    "ཡང་དག་པའི་ཡེ་ཤེས་དེ་ནི་གང་གི་ཚེ་ན་ཤེས་རབ་ཀྱིས་དཔྱད་དེ་ཤེས་པར་བྱ་བ་སྦོམ་པོ་དང་།",
    "ཕྲ་མོ་མི་དམིགས་པ་དེའི་ཚེ་བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ་དེ་བཞིན་ཉིད་ལ་གནས་པར་འགྱུར་རོ།",
    "ཐལ་བ་དང་།",
    "འོན་ཏེ་རང་གི་མཚན་དུ་གྲུབ་པའམ།",
    "བུད་མེད་དང་སྐྱེས་པ་ལ་སོགས་པའི་གཟུགས་སོ།",
    "བདག་དང་བདག་གིར་འཛིན་པ་རྣམས་གཉིས་ཞི་བས་བདག་མེད་པ་གཉིས་སྐྱེའོ།",
    "གང་གིས་ཡི་གེ་དང་།",
    "ཤེས་རབ་ཀྱིས་དཔྱོད་པའི་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱིས་གང་གི་ཚེ་སྤོམ་བོ་དང་ཕྲ་མོའི་མཚན་མ་མི་དམིགས་པ་དེའི་ཚེ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དང་བདུན་ནོ།",
    "མ་སྐྱེས་པའི་ཕྱིར་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་བཞིན་ཏེ།",
    "ཅིག་ཅར་ཀྱི་དོན་བྱེད་པར་འགལ་བའི་ཕྱིར་རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་དུ་དངོས་པོ་མེད་དོ།",
    "ད་ལྟར་གྱི་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དོ་ཞེས་གསུངས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "ཨུ་དུམ་ཝཱ་རའི་མེ་ཏོག་གི་དཔེས་ནི་རབ་ཏུ་དང་བ་རྣམས་ལ་ཐོབ་དཀའ་བར་གསུངས་སོ།",
    "སྣང་བ་མེད་ཅིང་གཉིས་སུ་མེད་པ་དེ་ཁོ་ན་ཉིད་དེར་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གང་གཱའི་ཀླུང་གི་བྱེ་མའི་ཁྱད་པར་དུ་སྣང་བ་དཔེར་འཇོག་པར་མི་མཛད་དོ།",
    "གཏི་མུག་གི་དྲི་མ་མེད་པའི་ཕྱིར་རོ།",
    "བདག་ཏུ་ཆགས་པ་རྣམས་ལ་ནི་བདག་གི་དོན་དུ་ཡོད་ཀྱི།",
    "ཉོན་མོངས་པ་སྤངས་པའི་ཕྱིར་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པའོ།",
    "སྙོམས་པར་འཇུག་པ་རྣམས་ནི་ཞེས་བྱ་བ་ལ་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་ནི་ཟག་པ་སྟེ།",
    "རང་གི་སེམས་སྣང་བ་མ་རྟོགས་པའི་ཕྱིར་ཏེ།",
    "ནམ་ཤེས་རབ་ཀྱིས་དཔྱད་དེ་ཕྱི་རོལ་གྱི་སྦོམ་བོ་དང་ཕྲ་མོ་མི་དམིགས་པ་དེ་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཤིན་ཏུ་གྱུར་ཏེ།",
    "བདག་དང་གཙང་བའི་དངོས་པོ་ཕྱིན་ཅི་ལོག་པ་རྣམས་ཀྱིས་དེའི་ཕྱིར་ཡང་ཉོན་མོངས་པར་མི་འགྱུར་རོ།"
  ]
}