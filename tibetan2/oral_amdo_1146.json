    "ཇི་ལྟར་ན་ཤིན་ཏུ་མྱུར་དུ་འཇིག་པའི་རྣམ་པས་སྐད་ཅིག་པ་དྲུག་གི་བར་དུ་གནས་པར་རུང་།",
    "སོར་མོའི་ཡན་ལག་རིམ་གྱིས་བྱེརེག་ནས་ཕྲད་པའི་འོག་ཏུ་སྐྱེས་པའི་སྒྲ་ལ་སྐད་ཅིག་པར་ཐོས་སོ་ཞེས་པ་དེ་བཞིན་དུ་གྲུབ་པའི་མཐའ་ཐམས་ཅད་ལ་སྐད་ཅིག་པར་རབ་ཏུ་གྲུབ་པའོ།",
    "འོན་ཀྱང་སྣང་བ་དང་བཅས་པ་ཐམས་ཅད་མཁྱེན་པའི་དག་པ་འཇིག་རྟེན་གྱི་ཡེ་ཤེས་ཀྱིས་སྐད་ཅིག་རེ་རེར་པྱོང་བ་ལྟ་བུར་ཐོག་མ་དང་ཐ་མའི་དུས་ཀྱི་རིམ་པ་ཐ་དད་པ་དང་།",
    "འདོད་ཆགས་ལ་སོགས་པའི་སྒྲིབ་པ་དང་བྲལ་བ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་དུས་གསུམ་གྱི་དོན་གང་ཡིན་པ་དོན་དེ་དབེན་པར་སྣང་བ་ནི་མིག་གི་ལིང་ཏོག་མེད་པ་ལྟ་བུའི་ཡེ་ཤེས་པ་ལའོ།",
    "གང་གི་ཚེ་ན་འདོད་ཆགས་ལ་སོགས་པ་དང་བྲལ་བར་གྱུར་པ་དེའི་ཚེ་ན་ཉོན་མོངས་པ་ཀུན་དང་བྲལ་བའི་ཡེ་ཤེས་ཀུན་ཏུ་འཇུག་གོ།",
    "དེ་ཚོན་དུ་མས་རི་མོ་བྲིས་པ་བཞིན་ནོ།",
    "གང་གི་ཚེ་ན་མཚན་མ་ཤེས་རབ་ཀྱིས་དཔྱད་དེ།",
    "སྦོམ་པོ་དང་ཕྲ་མོ་རྣམ་པར་གཞིགས་ཏེ།",
    "དེ་ལ་རང་གི་མཚན་ཉིད་ནི་ཐུན་མོང་མ་ཡིན་པའོ།",
    "སྤྱིའི་ནི་སྤྱིར་རྗེས་སུ་སོང་ཞིང་རྣམ་པར་རྟོག་པའི་རྣམ་པར་བརྗོད་པར་བྱའོརྨྱེ།",
    "སྐྱེ་བ་དང་འཇིག་པ་རྟོགས་པར་བྱེད་པ་ནི་སྐད་ཅིག་གི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "བདག་གིས་སྐད་ཅིག་པ་ཡང་པྱོང་བ་ན་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པ་ཡོད་ཅེས་པ་དེ་ཡང་དག་པར་ཚོར་བར་དབྱེ་བ་ན་བདག་དང་།",
    "དེ་དག་གི་སྤྱིའི་མཚན་ཉིད་ནི་མི་ཞུརྟག་པ་དང་།",
    "ཕྱིའི་གཟུགས་མེད་པས་ན་སྲ་བ་ལ་སོགས་པའི་རང་གི་མཚན་ཉིད་དང་།",
    "སྤོམ་པོ་དང་ཕྲ་མོ་ཕྱོགས་ཀྱི་ཆ་ཐ་དད་པར་ཕྱེ་སྟེ།",
    "གཞན་དུ་ནི་དགོངས་པ་མེད་པར་རིག་བུསྔགས་འཛིན་པ་ལྟ་བུར་དེ་སྐད་སུ་ཞིག་གིས་སྟོན་པར་འགྱུར།",
    "ཡུལ་དང་དུས་ལ་སོགས་པའི་བྱེ་བྲག་གིས་ལ་ལ་དཔག་ཚད་གཅིག་དང་།",
    "སྔགས་དང་མིག་རྩི་གྲུབ་པ་རྣམས་ཀྱིས་རེ་ལྡེ་དང་།",
    "པྲ་སེ་ན་བྱས་པས་དུས་གསུམ་གྱི་ཚིག་གི་དོན་ཐམས་ཅད་སྣང་ངོ།",
    "དེས་ན་བག་ཆགས་དང་བཅས་པའི་འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་མིག་གི་ལིང་ཏོག་དང་བྲལ་བ་བཞིན་དུ་དྲྀཤེས་པར་བྱ་བའི་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་ཆགས་པ་མེད་པར་འཇུག་གོ།",
    "གང་གིས་རང་བཞིན་གྱིས་འོད་གསལ་བའི་ཆུད་པའི་རང་བཞིན་ལ་ལྷག་པར་ཅུང་ཟད་ཀྱང་འཐོབ་དུཔར་བྱེད་པ་མེད་དེ།",
    "བདག་གི་སོ་སོ་རང་གི་འཕགས་པའི་ཡེ་ཤེས་ཀྱིས་རྟོགས་པའི་སྤྱོད་ཡུལ་ཞེས་པ་ནི་འཕགས་པ་རྣམས་ཀྱི་རང་གིས་ཡང་དག་པར་རིག་པ་ཙམ་སྟེ།",
    "གང་ནས་ཀྱང་མི་འོང་བ་ལ་འགག་པ་ན་ཡང་ཚོགས་སུ་མི་འགྱུར་བ་སྟེ།",
    "བརྒྱལ་བ་ལ་སོགས་པ་བཞིན་དུ་རྣམ་པ་སྣ་ཚོགས་རྣམ་པར་ཤེས་པ་ལ་སོ་སོར་སྣང་བ་གང་གི་ཚེ་བྱེད་ན་ཤེས་རབ་ཀྱིས་དཔྱད་དེ།",
    "གང་གི་ཚེ་ན་ཡང་དཔྱད་ཅིང་ཡུལ་མི་དམིགས་པ་དེའི་ཚེ་སྣང་བ་མེད་ཅིང་བསམ་པ་མེད་པ་དོན་དམ་པའི་བདེན་པ་མི་གཉིས་པའི་བྱེ་བྲག་ལ་ཤེས་རབ་རབ་ཏུ་འཇུག་གོ།",
    "གང་གིས་ཡུལ་རྣམས་འཛིན་པ་ནི།",
    "ཉོན་མོངས་པ་བག་ཆགས་དང་བཅས་པ་སྤངས་པས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་ཁྱད་པར་ཏེ།",
    "གང་གི་ཚེ་ཤེས་རབ་ཀྱིས་དབེེད་ཅིང་ཕྱི་རོལ་གྱི་རྡུལ་ཕྲ་མོ་དང་།",
    "གང་གི་ཚེ་ཕྱི་རོལ་གྱི་སྦོམ་པོ་དང་།",
    "ཕྲ་མོ་དང་།",
    "རྡུལ་ཕྲ་མོ་ལས་ཀུན་བརྟགས་པར་དཔྱད་ཅིང་ཕྱོགས་ཀྱི་ཆར་འབྱེད་པས་ཕྱེ་བ་ན་མི་དམིགས་པ་དེའི་ཚེ་རྨི་ལམ་དང་།",
    "མཆོག་གི་ཡང་མཆོག་ཏུ་བྱེད་པར་ཕྱེ་བས་ཁྱད་པར་ཐོབ་པོ།",
    "རྟག་པ་ནི་མ་སྐྱེས་པས་ནི་ཉུམོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་བཞིན་དུ་མེད་དོ།",
    "དེ་བཞིན་དུ་ཡང་བདག་གི་གཟུགས་དང་།",
    "དེ་ཡང་སོ་སོའི་ཚིག་གི་དོན་དང་།",
    "མུ་སྟེགས་བྱེད་དག་གིས་ཞེས་པ་ནི་རྣམ་པ་ཀླསྣ་ཚོགས་སུ་སྤྲུལ་པའི་སྒྲའི་དོན་དུ་མར་སྦྱོར་བ་ལ་སོགས་པ་སྟེ།",
    "འཇིག་རྟེན་ཕན་པར་དབྱངས་གཅིག་ཁྱོད་ཀྱི་ལས།",
    "མོས་པ་སྣ་ཚོགས་ལས་ནི་དབྱངས་འབྱུང་སྟེ།",
    "རང་གི་རྣམ་པར་རྟོག་པ་གོམས་པ་འཇུག་ཅེས་བྱ་བ་ནི་རང་གི་རྣམ་པར་རྟོག་པ་ལ་གོམས་པས་འཇུག་གོ་ཞེས་ཐམས་ཅད་མཁྱེན་པས་གསུངས་པ་ལ་ཚིག་སྦྱོར་བར་བྱ་སྟེ།",
    "མུ་སྟེགས་བྱེད་དག་གི་འགྱུར་བ་རེ་རེར་རྣམ་པར་བརྟགས་ཏེ་ཡོད་པ་དང་མེད་པ་ནི་གང་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཡོད་པ་ཁྱེའགྱུར་བར་མི་རིགས་ཏེ་ཡོད་པའི་ཕྱིར་རོ།",
    "རང་གི་སེམས་སྣང་བ་མ་གཏོགས་སྒེཔར་ཕྱི་རོལ་གྱི་དངོས་པོ་རྣམས་རྨི་ལམ་བཞིན་ཏེ།",
    "ཕྱི་རོལ་ཀྱི་སྦོམ་པོ་དང་ཕྲ་མོ་ཕྱོགས་ཀྱི་ཆ་ཐ་དད་པར་བྱ་བ་ན་ཁང་པ་དང་།",
    "གཉིས་སུ་མེད་པའི་སྐད་ཅིག་མའི་ལྔརྒྱུན་བརྗོད་དུ་མེད་པ་ཡང་ཡེ་ཤེས་ཡང་དག་པར་རིག་པ་ཙམ་གྱི་ཕྱིར་དེར་སྐད་ཅིག་པ་རེ་རེར་རྣམ་པར་རྟོག་པ་མེད་དོ།",
    "ཁ་ཅིག་གིས་མཐོང་བ་ནི་མི་འཐད་གྱེཔ་མ་ཡིན་ནོ་ཞེས་སོ།",
    "དོན་དམ་པའི་བདེན་པས་མི་སྐྱེ་ཞེས་མོད་ཀྱི།",
    "རྟག་པ་ནི་མ་སྐྱེས་པས་ན་མོ་གཤམ་རྨི་བུ་ལ་སོགས་པ་བཞིན་ནོ།",
    "ཕྲ་མོ་རྣམ་པར་གཞིག་ཅིང་མི་དམིགས་པ་དེ་ནི་མི་གཉིས་པར་སྨྲ་བ་རྣམས་ཀྱིས་གཉིས་ཀྱི་རྣམ་པར་སྟོང་པར་ཆུད་ཅིང་ཡོད་པ་དང་མེད་པའི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ།",
    "ཁ་ཅིག་གིས་ནི་སྐྱེས་པས་ན་རྨི་ལམ་དང་མིག་འཕྲུལ་ལ་སོགས་པ་རང་བཞིན་དུ་ཟུ་མེད་དོ་ཞེས་སྨྲ་བ་སྟེ།",
    "བཟོད་པ་ཐོབ་ན་ངན་སོང་འགྲོ་བ་མེད།",
    "གང་གི་ཚེ་ན་ཡང་ཤེས་རབ་ཀྱིས་དཔྱད་དེ།",
    "གཞན་ཡང་བློ་གྲོས་ཆེན་པོ་ཕྱི་རོལ་གྱི་དངོས་པོ་དངོས་པོ་མེད་པར་ཅེརང་གི་སེམས་སྣང་བའི་མཚན་ཉིད་ཁོང་དུ་ཆུད་ཅིང་།",
    "སྣང་བ་མེད་པ་རང་གི་སེམས་ཙམ་གྱི་རྗེས་སུ་འབྲང་བ་དང་།",
    "བསམ་པ་མེད་པ་དོན་དམ་པའི་བདེན་པ་མི་གཉིས་པར་ཡང་དག་པར་རིག་པ་བརྗོད་དུ་མེད་པ་རང་གི་རིག་པའི་མཚན་ཉིད་ཀྱི་རྒྱུན་ལ་ནི་རྣམ་པར་རྟོག་པ་མེད་ན་ཤེས་པར་བྱ་བའི་རྣམ་པ་འཛིན་པར་འགྱུར་བ་ལྟ་ག་ལ་ཞིག།",
    "གཞན་ཡང་བློ་གྲོས་ཆེན་པོ་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་མཚམས་སྦྱོར་བ་རྣམ་པ་གསུམ་མོ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པས་མཚམས་སྦྱོར་བ་ལས་འགྲོ་བ་ལྔར་མཚམས་སྦྱོར་བར་འགྱུར་རོ།",
    "ཉོན་མོངས་པ་རྣམས་ཀྱི་རྔུམཚམས་སྦྱོར་བ་ཆད་ནས་ནི་སྲིད་པའི་མཚམས་སྦྱོར་བ་མེད་པར་འགྱུར་རོ།",
    "རང་གི་རྣམ་པར་རྟོག་པས་འཆིང་།",
    "ཞེས་པ་ནི་རང་གི་སེམས་མཉམ་པར་མི་འཇོག་པའི་མ་རིག་པས་རྟག་པ་དང་།",
    "གང་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་སྐད་དུ་རྣམ་པར་རྟོག་པ་གང་དང་གང་གིས་དངོས་པོ་གང་དང་གང་རྣམ་པར་བརྟགས་པ་དེ་དག་ནི་ཀུན་བརྟགས་ཛུ་པ་ཉིད་དེ།",
    "གང་གི་ཚེ་ན་ཤེས་རབ་ཀྱིས་དཔྱད་དེ།",
    "ཕྲ་མོ་རྣམ་པར་གཞིག་ཅིང་མི་དམིགས་པ་དེའི་ཚེ་བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ་དོན་དམ་པའི་བདེན་པ་མི་གཉིས་པར་ཡང་དག་པར་རིག་པ་འཕགས་པ་རྣམས་ཀྱིས་རང་བཞིན་གྱིས་འོད་གསལ་བའི་དངོས་པོར་ཀྲུཆུད་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་དེ་གལ་ཏེ་འཕགས་པ་རྣམས་ཀྱི་འཕྲུལ་དང་ཤའི་མིག་གིས་མ་ལགས་ཀྱི།",
    "འཕགས་པའི་ཤེས་རབ་ཀྱི་མིག་གི་༡དངོས་པོའི་ངོ་བོ་ཉིད་རྟོགས་པ་ཞེས་བྱ་བ་རྒྱ་ཆེར་ཏེ།",
    "འཕགས་པ་བློ་གྲོས་ཆེན་པོས་གསུངས་པའི་དོན་ཇི་བཞིན་པ་ལས་བརྟགས་བྱེན་འཕགས་པ་དང་བྱེས་པའི་ཤེས་པ་གཉིས་ཀ་ཡང་རང་གི་ཡུལ་དུ་ཞུགས་པས་ན་བྱིས་པའི་ཤེས་པ་ཇི་ལྟར་ན་རྣམ་པར་ལྡོག་པར་འགྱུར་ཞེས་གླེངས་པའོ།",
    "འཕྲུལ་ཀྱི་མིག་གིས་ནི་ལྷ་དང་དེ་ལས་གཞན་པས་ནི་ཤའི་མིག་གིས་ཏེསྔོ།",
    "ཕྱིན་ཅི་མ་ལོག་པ་ཡང་མ་ལགས་སོ་ཞེས་པ་ནི་རང་གི་ཡུལ་ལ་གྷུརྟོགས་པའི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་འཕགས་པ་རྣམས་ཀྱིས་དངོས་པོ་རྣམས་དུཇི་ལྟར་རྣམ་པར་བརྟགས་རྔོ་པ་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ལ་སྤྱོད་ཡུལ་མ་ལགས་པའི་ཕྱིར་དེ་བཞིན་དུ་མི་འགྱུར་རོ།",
    "བརྗོད་དུ་མེད་པའི་རང་གི་མཚན་ཉིད་ཀྱིས་ཕྱསྐད་ཅིག་གི་རྒྱུན་ལ་བསྟན་པ་མ་མཆིས་སོ།",
    "བྱིས་པ་རྣམས་ལ་ཡང་མེ་ལ་སོགས་པ་རང་གི་ཧུསྣ་མྱོང་བ་ལ་སྒྲ་དང་དོན་སྤྱིའི་ཐ་སྙད་དོ།",
    "བྱིས་པ་རྣམས་ལ་ཡང་རང་གི་ཡུལ་ལ་དངོས་པོར་རྣམ་པར་བརྟགས་ཏེ་སྒོ་འདོགས་པས་ན་སུའི་དངོས་པོ་ཡིན་པ་མ་ངེས་པས་ཐུག་པ་མ་མཆིས་པར་འགྱུར་རོ་ཞེས་འཕགས་པ་བློ་གྲོས་ཆེན་པོས་གླེངས་པ་ལ་ཐམས་ཅད་མཁྱེན་པས་ཀྱང་ལན་དུ་བཀའ་སྩལ་པ།",
    "ངས་དངོས་པོའི་རང་བཞིན་བསྟན་པ་ནི་མ་བྱས་མོད་ཀྱི་ཞེས་པ་སྟེ།",
    "བརྟགས་པ་དང་རང་གི་མཚན་ཉིད་རང་བཞིན་གཞན་པ་དག།",
    "གཞན་པ་དག་གི་སྤྱོད་ཡུལ་དུ་འགྱུར་རོ་ཞེས་དེ་སྐད་དུ་བློ་གྲོས་ཆེན་པོས་གླེངས་པ།",
    "དངོས་པོའི་རང་བཞིན་གྱི་རང་གི་མཚན་ཉིད་ནི་འབྲས་བུའི་སྐད་ཅིག་པ་སྐྱེ་༢ནུས་པའོ།",
    "རང་གི་མཚན་ཉིད་ཀྱི་ཤེས་པའི་རྒྱུ་ནི་གསལ་བའི་དོན་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་ཏེ།",
    "དེ་བཞིན་དུ་གཞན་དག་གིས་སྨྲས་པ།",
    "ངས་དངོས་པོའི་རང་བཞིན་ནི་བསྟན་པར་མ་བྱས་མོད་ཀྱི་ཞེས་པ་ནི་ཡང་དག་པར་རིག་པའི་སྐད་ཅིག་པའི་རྒྱུན་གྱི་རང་བཞིན་བརྗོད་དུ་མེད་པས་ན་ཇི་ལྟར་ན་སྟོན་ཞེ་ན།",
    "ཕྲ་མོར་སྣང་བ་ཤེས་རབ་ཀྱིས་རྣམ་པར་དཔྱད་པ་ན་མེད་དེ།",
    "དེ་བཞིན་དུ་མི་དམིགས་པའི་ཚུལ་ལ་ཡང་གང་དམིགས་པའི་མཚན་བྱེཉིད་ཐོབ་པ་ལས་མི་དམིགས་པས་ན་དེ་འདི་ན་མེད་དེ་རི་བོང་གི་མགོ་ལ་རྭ་བཞིན་དུ་འདིར་བུམ་པ་མི་དམིགས་པ་སྟེ།",
    "གཉིས་ཀྱི་༢་རྣམ་པ་རྣམས་རྨི་ལམ་ལ་སོགས་པ་བཞིན་དུ་སྐྱེའོ་ཞེས་རང་གི་དངོས་པོ་བསྟན་པའི་ཕྱིར་སྐྲག་པར་མི་འགྱུར་རོ།",
    "དེ་ལ་མཚན་ཉིད་རང་བཞིན་མེད་པ་ནི་མཚན་ཉིད་གང་དག་གི་རྟག་པ་དང་།",
    "ཕྱི་རོལ་གྱི་རྡུལ་དུ་རྟོག་པའི་མཚན་ཉིད་དེ་དག་གི་དངོས་པོའི་རང་བཞིན་དུ་མ་སྐྱེས་པའོ།",
    "གང་གི་ཚེ་ན་སྐད་ཅིག་པ་གཅིག་ཡོད་པ་དེའི་ཚེ་ན་སྐད་ཅིག་པ་གཉིས་པོ་མེད་དེ།",
    "སྣང་བ་དང་མི་སྣང་བ་དག་མཚན་ཉིད་ཐ་དད་པའི་ཕྱིར་ཤིང་དང་ཐལ་བ་ལ་སོགས་པ་བཞིན་ཏེ།",
    "མ་སྐྱེས་པའི་ཕྱིར་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་བཞིན་དུ་མེད་པའོ།",
    "ཅིག་ཅར་དང་རིམ་གྱིས་དོན་བྱེད་པར་འགལ་བ་སྙེན་རྟག་པ་ནི་རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་དུ་མི་སྲིད་དོ།",
    "དེ་ལྟར་མི་དམིགས་པ་ཡང་རི་བོང་གི་མགོ་ལ་རྭ་བཞིན་དུ་ས་གཞི་བུམ་པས་དབེེན་པའི་དངོས་དང་མི་འབྲལ་བ་སྟེ།",
    "གང་གི་ཚེ་ན་དམ་འཆའ་བ་མ་སྐྱེས་པ་དེའི་ཚེ་ན་བདག་ཉིད་ཀྱིས་དངོས་པོ་མེད་པའི་ཕྱིར་ཕྱི་མའི་ཡན་ལག་དང་འབྲེལ་པ་མི་རུང་སྟེ།",
