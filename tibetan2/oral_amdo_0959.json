    "ངས་ཁོ་མོ་ལ་བསྟོད་པ་ཙམ་ཡིན།",
    "སང་ཁོ་མོ་གནས་ལ་འགྲོ་རྒྱུ་རེད་ཟེར།",
    "པོ་གཡུས་གཏམ་དེ་ཐོས་ནས་སྐད་ཆའི་ནང་ན་གོ་རྒྱུ་གཞན་པ་ཞིག་ཡོད་པར་བསམས་ནས་དངངས་སྐྲག་སྐྱེས་ཏེ་མྱུར་མོར་ལག་གི་ཞོ་ཤ་བསྐྱུར་ཏེ།",
    "འདྲི་རྒྱུར་ཅི་ཟེར་གྱིན་ཡོད།",
    "ད་བར་ཁྱོད་ཕ་ཡུལ་ལ་ལོག་རྒྱུ་ཡིན་ཟེར་བ་ཡིན་ནམ།",
    "ནས་ཁྱོད་ལ་བླུ་དགོས་དོན་ཅི་རེད་ཅེས་པར།",
    "ཤིས་རིན་གྱིས་ཁྱེད་ཀྱི་སྐད་དེ་ཡ་མཚན་པ་ཞིག་རེད།",
    "ང་རང་གི་ཁྱིམ་མི་ཐམས་ཅད་ས་ཆ་གཞན་དུ་བསྡད་ཡོད་པས།",
    "ཕྱིར་ཐེངས་རེ་གཏོང་རྒྱུའི་ལུགས་སྲོལ་ཡོད།",
    "ཡང་ན་ཨ་ཡེ་རྨོ་མོའི་ཐུགས་ལ་འབབ་པ་ཞིག་ཡིན་པས།",
    "ང་ཆུང་དུས་ནས་ཨ་ཡེ་རྨོ་མོ་ལ་ཞབས་ཕྱི་ཞུས་པ་དང་།",
    "རྗེས་སུ་ལོ་འགའ་ཡི་རིང་ལ་སྲས་མོ་ཧྲི་ཞང་ཡུན་ལ་ཞབས་ཕྱི་ཞུས་པ་རེད།",
    "དེའི་རྗེས་སུ་ཡང་ཁྱོད་ཀྱི་བྲན་མོར་འོངས་ནས་ལོ་འགའ་འགོར་སོང་།",
    "ཁྱོད་ལ་ཞབས་འདེགས་ཞུ་བ་བཟང་ཟེར་ནས་ང་འགྲོ་རུ་མི་འཇུག་པའི་དཔེ་ཡོད་མི་སྲིད།",
    "དེང་སོང་རྒྱུ་རྐྱེན་གང་ཡང་མེད་པར་ང་ལ་འདིར་བཀག་ནས་འགྲོ་རུ་མ་བཅུག་ན།",
    "ཁྱོད་ལ་ཡང་ཕན་ཐོགས་མེད་ཅིང་ང་རང་དང་ཕ་མ་སྤུན་ཟླ་རྣམས་ཁ་བྲལ་དུ་གཏོང་བའི་དོན་བཞུ་ཝ་དགུ་བ།",
    "ཨ་ཡེ་རྨོ་མོ་དང་ལྷ་ལྕམ་རྣམས་ཀྱིས་ཀྱང་བྱེད་མི་འདོད་པ་རེད་ཟེར།",
    "ཐ་རྔ་མ་འདིར་ང་གྲོགས་མེད་ཁེར་རྐྱང་དུ་ལུས་སོ་ཞེས་ཟེར་ཞོར་དུ་ཚ་ཐབ་ཐོག་བུད་དེ་མལ་དུ་ལོགཡིན་པ་ཉིན་དེར་ཤིས་རིན་རང་གི་ཁྱིམ་དུ་སོང་སྐབས།",
    "ལྟོས་རང་གི་དྲིན་ཅན་ཕ་མ་ལྟོགས་གྲིར་འཆི་རུ་འཇུག་པའི་ལུགས་སྲོལ་ཡོད་མ་དམ།",
    "ཟ་རྒྱུ་འཐུང་རྒྱུ་ཐོག་ནངས་སྔ་མོ་དང་དགོང་ཕྱི་དྲོར་ཚང་མ་བདག་པོ་དང་འདྲ་མཚུངས་ཡིན་རྡུང་སྡིག་ཁུར་མི་དགོས།",
    "ཁོ་མོའི་ཨ་མ་དང་ཕུ་བོ་གཉིས་ཀས་མོ་བློ་ཐག་རྦད་ཆོད་ཀྱིས་ཕྱིར་ཡོང་མི་འདོད་པ་ཤེས་སོང་།",
    "དེ་མིན་ཅ་ཚང་གི་གཟིམ་ཤག་ནང་དང་པོ་ནས་མི་ལ་དམའ་འབེབས་མི་བྱེད།",
    "སྤྱིར་བཏང་ཁྱིམ་དབུལ་དུ་སྐྱེས་པའི་བུ་མོ་ལའང་དེ་འདྲར་བརྩི་བཀུར་ཐོབ་མི་ཐུབ།",
    "ང་འདིར་བསྡད་ནས་མ་སོང་ན་ཆོག་ཟེར།",
    "ཁྱོད་ཀྱིས་ཤོད་དང་།",
    "ཁྱོད་ཚོ་གང་ལ་འགྲོ་བསམ་ན་དེ་རུ་སོང་ཟེར་བར།་",
    "ཤིས་རིན་དངངས་ཤིང་སྐྲག་སྟེ་མྱུར་མོར་ཁོའི་ཁ་བསུམས་ནས་སྲས་བཟང་ལགས།",
    "ད་ནི་ལྷག་ཏུ་རྗེ་ངར་སོང་བ་རེད་ཅེས་ཞུས།",
    "བུ་འདི་སྐྱེས་པ་ནས་བཟུང་རེ་ཐག་ཆད་དོ་སྙམ།",
    "ཡོད་ནའང་ཚང་མ་གནའ་མིས་ཚོད་ཚོད་ཀྱིས་བརྩམས་པ་རེད་ཅེས་ཟེར།",
    "ཁ་ནས་གང་བྱུང་གི་ཚིག་དག་ཐོན་པ་ཡིན་པས།",
    "མྱུར་མོར་ཤོད་ཅིག་ཟེར་བར།",
    "ཡུས་དགོད་ཀྱིན་ཁྱོད་འདིར་ཡུན་རིང་བོར་བསྡད་ཕྱིན།",
    "འཕྲལ་མར་ལག་པ་བཀྲུས་ཏེ་མལ་དུ་གཟིམ་ཚུལ་འདིར་ཞིབམོར་ཞུ་མ་དགོས་ལགས།",
    "གམ་ན་ཡོད་པའི་གཡོག་མོ་རྣམས་རང་རང་གང་འདོད་སར་སོང་ཕྱིར།",
    "བྱེད་བཞིན་སྲིང་མོ་བཟང་བོ།",
    "ཅིག་ང་རང་ཚོས་ཁ་བརྡ་བྱེད་ཟེར།",
    "པོ་གཡུ་ཁང་པའི་ཕྱི་རིམ་ཏུ་སོང་ནས་ཅིག་བལྟས་ཏེ་ཕྱིར་འོངས་ནས་འཛུམ་དམུལ་དམུལ་དུ་ངས་སྔས་མགོ་དེ་རིགས་མི་སྣས།",
    "རྒན་མོ་བཙོག་ཏོ་གང་ཞིག་གི་ཡིན་པ་མི་ཤེས་ཟེར།",
    "རང་གིས་སྔས་འབོལ་གཞན་ཞིག་ཁྱེར་འོངས་ནས་སྔས་མགོ་བྱས་ནས་མཉིས་ཀས་ངོ་གཏད་ནས་ཉལ།",
    "བསམ་ན་ཆ་སྒམ་ནང་གི་དྲི་ཞིམ་འགོས་པར་ཁྲིགས་ཁྲིགས་མེད་ཟེར།",
    "དྲི་ཞིམ་དེ་མཚར་བོ་ཞིག་རེད།",
    "སྤྱིར་བཏང་གི་དྲི་ཞིམ་བདུག་ལེབ་དང་།",
    "ཁྱོད་ལ་ངར་བ་ཞིག་མ་བྱས་ན་ཁྱོད་ཀྱིས་མི་ཤེས།",
    "ཞོར་དུ་ཡར་ལངས་ནས་ལག་པ་གཉིས་ལ་ཧ་བརྒྱབ་ཅིང་ཏེ་གཡུའི་མཆན་འོག་ཏུ་བཅུག་ནས་ཙི་གུ་སྒོག་ཏེ་གཡུས་ཙི་གུ་སྒོག་པ་རེག་པ་ཙམ་གྱིས་མི་བཟོད་པས།",
    "ཁྱོད་ཀྱིས་སུན་འབྱིན་བྱས་ན་ཆོག་ཟེར་བས།",
    "འཇིག་རྟེན་ཐོག་གི་མི་རྣམས་ཀྱིས་དགུ་ཐུག་བསྐོལ་ནས་འཐུང་ལ།",
    "དེང་སྐབས་ང་ཚོའི་རི་ཕུག་ན་སིལ་ཏོག་གི་རིགས་ཉུང་བས།",
    "སིལ་ཏོག་གི་རིགས་སྣ་ཁ་དུ་ཡོད་ཅེས་དྲིས་པ་ལ།",
    "སིལ་ཏོག་གི་རིགས་སྣ་ཁ་ལྔ་ལས་མི་འདུག་ཙོ་རི་དམར་པོ་དང་།",
    "འཕྲལ་མར་བཀའ་མཚོན་མདའ་མོ་ཞིག་ཕྱུང་ནས་འབྲུ་བརྐུ་བར་སུ་འགྲོ་ཞེས་དྲིས་པ་ལ།",
    "བྱི་བ་ཞིག་གིས་མདའ་བླངས་ནས་ང་འགྲོ་ཟེར།",
    "ཤིན་ཏུ་རིད་ཅིང་སྟོབས་ཤུགས་ཉམས་པའི་བྱི་ཆུང་ཞིག་གིས་ང་འགྲོ་ཟེར།་",
    "བློ་སྒམ་པས་ང་རང་ད་ཐེངས་སོང་ན་ཁོ་ཚོ་ལས་མང་པོ་ཞིག་བརྐུ་ཐུབ་ཟེར།",
    "བྱི་ཆུང་གིས་ལན་དུ་ངས་ཁོ་ཚོ་བཞིན་ཐད་ཀར་རྐུ་བའི་ལད་མོ་མི་བྱེད།",
    "སྤྲུལ་ཅིག་ཟེར་མ་ཐག་ཆེས་མཛེས་ཤིང་ཡིད་དུ་འོང་བའི་སྲས་མོ་ཞིག་ཏུ་སྤྲུལ།",
    "ཁེ་ཉིན་དགོང་མོ་བཙུན་མོ་ཡོན་ཁྲུན་གྱི་མདུན་དུ་རྩོམ་འབྲི་དུས་ཤིང་ཏ་ལའི་སྙན་ཚིག་དེ་ཤེས་ཡོད་ཀྱང་ཡིད་ལ་མ་དྲན་པར་སྡུག་ཐུག་མི་གཞན་པས་གྲང་ངར་བཟོད་དཀའ་བའི་སྐབས།",
    "ཁྱོད་ནི་དངོས་གནས་ངའི་ཨ་ལྕེ་བཟང་པོ་ཡིན་ཏེ།",
    "ན་མོ་ནི་ཧོན་ལོག་པ་ཡིན་ནོ་ཟེར།",
    "སར་སོང་ནས་ལྟ་དུས།",
    "དེ་ནས་ཡང་ཁྱེད་རང་ཡིད་མི་ཆེས་ན་བུ་མོ་གཞན་པ་ལ་དྲིས་ཞེས་བཤད།",
    "གཞན་པ་ཚང་མ་ཁྱོད་ལ་ཕྱོགས་པས།",
    "ང་རང་ཁྱོད་དང་མཉམ་པས་ཨ་ཡེ་རྨོ་མོ་དང་མ་ཡུམ་གྱི་དྲུང་དུ་གནས་ལུགས་ཞུ་བར་འགྲོ།་",
