    "དེ་ལ་རང་ལ་མངོན་དུ་ཕྱོགས་ཤིང་ཙོག་ཙོག་པོར་འདུག་སྟེ།",
    "ཞེས་བྱ་བས་ལན་གསུམ་དུ་ཕྱག་བྱས་ལ་འདུག་སྟེ།",
    "ཁྱེད་རང་གཅིག་པུ་ཡིན་ནམ།",
    "ས་རཱི་དཀར་པོ་བབ་ཆགས་ཤིག་གྱོན་འདུགང་ཡར་ལངས་ནས་གུས་ཞབས་ཆེན་པོས།",
    "ང་རང་ངོ་ཚ་བ་དང་དོགས་པ་སྐྱེས་ནས་དང་ལེན་མ་བྱས།",
    "ཁོ་ལ་སྐྱོན་མི་འདུག་ཅེས་བཤད།",
    "འདིར་དོགས་ཟོན་བྱེད་དགོས་སའི་འཁྱམ་པོ་མང་པོ་འདུག་པས།",
    "དུས་དེའི་བར་ལྷོད་ཀྱིས་བཙོག་འདུག་བྱས་པའི་འགྲུལ་པ་རྣམས་མེ་འཁོར་འབབ་སྟེགས་སྟེང་འགུལ་སྐྱོད་རྒྱག་འགོ་ཚུགས།",
    "འདིར་ཤོག་སྟོང་པ་འདུག་ཅེས་སྐད་བརྒྱབ།",
    "ཞོགས་པ་དེར་བར་ཁྱམས་ནས་གཉིད་ལས་སད་དུས་ནམ་མཁར་སྤྲིན་ནག་འཁྲིགས་འདུག་པ་དང་།",
    "ཁྱེད་རང་འདིའི་གཡས་གཡོན་ལ་སྡོད་ཀྱི་ཡོད་དམ།",
    "ངས་ཡུད་ཙམ་རིང་རང་ཉིད་ལོ་ན་ཉི་ཤུར་སོན་པའི་སྐྱེས་པ་ཞིག་ཡིན་པ་བརྗེད་ནས།",
    "ཁྱེད་རང་ང་དང་འདྲ་པོ་འདུག་ང་ཡང་རང་མགོ་ཐོན་པ་བྱེད་རྒྱུར་དགའ།",
    "ད་ཆ་ཤུལ་དུ་ང་རང་གཅིག་པུ་ལྷག་ཡོད་སྟབས།",
    "ཁྱེད་རང་ལ་གྲོགས་པོ་མང་པོ་ཡོད་དམ།",
    "ཁྱེད་རང་གྲོགས་པོ་ཡག་ཤོས་གཉིས་པར་བརྩིས་ཆོག་ཅེས་བཤད།",
    "ང་རང་ཁྱེད་ཀྱི་གྲོགས་པོ་ཡག་ཤོས་གཉིས་པ་དེ་བྱེད་རྒྱུར་དང་ལེན་བྱས་ཆོག་ཅེས་བཤད།",
    "ང་ཕྱིར་ལོག་ནས་ལྡུམ་ར་འདིའི་ནང་ཐུག་ཆོག་དེ་ཡག་པོ་མི་འདུག་གམ།",
    "ངའི་རྨོ་རྨོ་ཨམ་སྡོང་འོག་ཏུ་ཐག་པའི་ཉལ་ཁྲིའི་སྟེང་བསྡད་འདུག་དེ་དུས་དབྱར་སྨད་ཡིན་པས།",
    "ལྡུམ་རའི་ནང་ཉི་མ་མེ་ཏོག་བཞད་འདུག་ཅིང་།",
    "ད་དུང་འཁྲི་ཤིང་ཡང་སྐྱེས་འདུག་འོན་ཀྱང་།",
    "མཁྲིག་མའི་མཚམས་སུ་སླེབས་པའི་སྟོད་གོས་ཕུ་ཐུང་ཡོད་པ་ཞིག་གྱོན་འདུག་ད་དུང་ལག་གདུབ་མང་པོ་གྱོན་འདུག་ཕྱིའི་ཆ་ལུགས་དེ་འདྲ་ཡིན་མིན་ལ་མ་ལྟོས་པར།",
    "ལག་གཉིས་སྐེད་གཟེར་བྱས་ནས་བསྡད་འདུག་ལ།",
    "དྲན་ཡག་པོ་སོས་ཀྱི་འདུག་གམ།",
    "དེར་ཁྱིམ་ཚང་ཁ་ཤས་གནས་སྡོད་བྱེད་ཀྱི་འདུག་ངའི་སྡོད་ཁང་དང་དུ་ཁུང་མ་གཏོགས་ཁང་ཐོག་ལེབ་ལེབ་ཡིན།",
    "ཁྱེད་རང་དངོས་གནས་གདོན་འདྲེ་འདྲ་པོ་འདུག་ཅེས་ལབ།",
    "ང་ཡིད་ཆེས་ཀྱི་མི་འདུག་ཟེར།",
    "འདི་གློག་བརྙན་ཁང་འདྲ་པོ་འདུག་སྒེའུ་ཁུང་འདི་བརྙན་རས་དང་།",
    "ཕྱི་རོལ་གྱི་འཇིག་རྟེན་འདི་གློག་བརྙན་འདྲ་པོ་འདུག་ཅེས་ཟེར།",
    "ཐོག་ཁར་ལྡུམ་ར་ཞིག་བཟོ་ན་གང་འདྲ་འདུག་ཅེས་བསམ་ཚུལ་བཤད།",
    "ཕྱི་ཉིན་ཞོགས་པ་སོ་ཕག་མ་གཏོགས་ས་ཡོད་ཚད་ཆར་ཆུས་ཁྱེར་འདུགདེར་བརྟེན།",
    "ཁོ་རང་ཉིད་ཀྱི་སྤོབས་ཉམས་ཤོར་ཡོད་སྟབས།",
    "ང་ཁྱེད་རང་ལ་ཧ་ཅང་དགའ་པོ་ཡོད།",
    "སྒེའུ་ཁུང་ནས་མགོ་བོ་ཕྱི་རུ་ག་དུས་འདོན་ཆོག་མིན།",
    "ངས་ཀྱང་ཁྱེད་རང་མཐོང་མ་བྱུང་།",
    "ཕྱི་ལོགས་ལ་གང་འདྲ་འདུག་གམ།",
    "ཁྱེད་རང་སྒེའུ་ཁུང་ཕྱི་ལོགས་ལ་བལྟས་ན་གང་འདུག་ཅེས་དྲིས།",
    "དེ་ཕྱེ་འདུག་པ་ན་ངས་ཕྱིའི་ཡུལ་ལྗོངས་ལ་རྟོག་ཞིབ་བྱེད་ཀྱི་ཡོད་པའི་ཚུལ་བསྟན།",
    "ཁྱེད་ཀྱི་ངོ་གདོང་དེ་སྤྲོ་སྣང་འདྲེན་འོས་པ་ཞིག་འདུག་ཅེས་བཤད།",
    "ངའི་ངོ་གདོང་འདི་སྤྲོ་སྣང་འདྲེན་འོས་པ་ཞིག་འདུག་ཟེར་བར་དགའ་པོ་བྱུང་།",
    "ཁོས་སྦེ་ག་འགྲན་སྡུར་ཞིག་ལ་ལྟ་བཞིན་འདུག་ཁོ་ཧ་ལམ་ལོ་ཉི་ཤུ་ཙམ་ཡིན་པ་དང་།",
    "ཁྱེད་རང་སྦེ་འགྲན་པ་ཞིག་དང་འདྲ་པོ་འདུག་ཅེས་ལབ་པ་ཡིན།",
    "ང་ཁྱེད་རང་འོག་ཏུ་ལས་ཀ་བྱེད་འདོད་ཡོད།",
    "ཁྱེད་རང་མཐོང་དུས་ཁྱེད་ལས་ལྷག་པའི་མི་ཞིག་མེད་པ་ཚོར་བྱུང་།",
    "ཁྱེད་རང་སྤྲེལ་ལད་ཚ་བ་ལ་ཨང་།",
    "ང་ལ་གླ་ཆ་ཡང་སྤྲོད་ཀྱི་མི་འདུག་ཅེས་བསམ་བློ་འཁོར།",
    "ཨ་རུན་གཉིད་ཁུག་ཟིན་འདུག་བར་ཁྱམས་བརྒྱུད་ནས་ཟླ་འོད་ཉལ་ཁྲིའི་སྟེང་དུ་ཕོག་ངས་ཉལ་ཆས་གྱོན་བཞིན་ཙོག་པུར་བསྡད་དེ།",
    "ང་རང་ཉལ་ཆས་འོག་ནས་ཕྱིར་ཐོན་ཏེ།",
    "ཁོས་ལྷོད་ཀྱིས་དབུགས་འབྱིན་རྔུབ་བྱེད་བཞིན་གཉིད་ཁུག་འདུག་ཁོའི་ངོ་གདོང་གཙང་ཞིང་གཉེར་མ་གཅིག་ཀྱང་མ་མཐོང་།",
    "ཚོང་ཁང་ཚང་མ་སྒོ་བརྒྱབ་འདུག་ཀྱང་།",
    "འཁྱམ་པོ་ཁ་ཤས་ཤིག་ཉལ་ཆས་སྲབ་པོས་བཏུམས་ནས་ཉེ་འཁོར་དུ་བསྡད་འདུག་སྐབས་དེར་ཆུ་ཚོད་བཅུ་གཉིས་ཟིན།",
    "ཨ་རུན་ད་དུང་གཉིད་ཁུག་བཞིན་འདུག་ངས་སླར་ཡང་རྐང་ལག་བཞི་པོ་བཙུགས་ནས་གོག་འགྲོས་བྱས་ཏེ།",
    "ལས་ཀ་དེ་བཞག་ནས་འགྲོ་འདོད་འདུག་ཅེས་བཤད།",
    "པི་པལ་ན་གཱར་དངུལ་ཁང་སྦོ་ལུག་གྲབས་འདུག་ཟེར།",
    "དེ་རིང་རང་ཁྱིམ་དུ་ལོག་ནས་སང་ཉིན་ལེན་པར་ཡོང་རོགས་ཞུས།",
    "གླ་ཆ་དུས་ཐོག་ཏུ་མི་སྤྲོད་པའི་སྒང་ལ་ངའི་ལས་ཀ་མང་དུ་བཏང་འདུག་ཅེས་སྐད་ཆེན་པོ་བརྒྱབ།",
    "ང་ལ་ཡིད་ཆེས་ཀྱི་མི་འདུག་གམ།",
    "གསུམ་པ་དེ་ནི་ཡ་ཡུད་ཅན་ཞིག་འདུག་ཅེས་ལབ་བྱུང་།",
    "སྐད་ཆ་དེ་ངའི་ཁ་ནས་ཐོན་པར་ང་རང་ཉིད་ཀྱང་ཧང་སང་བྱུང་།",
    "ཁྱེད་རང་འདིར་སྡོད་ཀྱི་ཡིན་ནམ།",
    "ཁྱེད་རང་རྗེས་ལུས་ཐེབས་འདོད་མེད་ན།",
    "ཌིའུ་ལཱི་མེ་འཁོར་འབབ་ཚུགས་ཀྱི་ལྟ་རྟོག་པ་བརྗེ་པོ་བརྒྱབ་འདུག་ལྟ་རྟོག་པ་སྔོན་མ་དེ་གཟའ་འཁོར་གཅིག་གོང་གནས་སྤོས་བཏང་ཟིན་པ་དང་།",
    "ཁང་པ་གླས་ནས་སྡོད་མཁན་ནི་ང་རང་གཅིག་པུ་ཡིན་ཡང་།",
    "ངའི་ཐག་བསླས་ཉལ་ཁྲིའི་ཐག་པ་དམ་དུ་གཏོང་དགོས་འདུག་ཉལ་ཁྲིའི་དཀྱིལ་གྱི་ཀོང་དོང་དེ་ཇེ་ཆེར་ཕྱིན་འདུག་པས།",
    "ཉལ་ཁྲི་དེ་ང་ལ་ཆུང་དྲགས་འདུག་ངའི་རྐང་སྣེ་ཉལ་ཁྲིའི་མཇུག་ནས་མ་ཐོན་ཡང་།",
    "ངའི་ཀླད་པས་ལས་ཀ་ཡག་པོ་བྱེད་ཀྱི་མི་འདུག་ཉེ་ཆར་རང་བྲིས་པའི་སྒྲུང་ནང་དུ་མི་གསོད་དོན་རྐྱེན་གསུམ་ཡོད་ཀྱང་།",
    "སྲིད་བློན་གྱི་ཁང་པ་ལྟ་བུའི་སྡོད་ཁང་ཆེན་པོ་ཞིག་འདུག་ཅེས་བཤད།",
    "ཁོའི་མགོ་དང་ཕྲག་པ་གྲོ་ཡིས་གཡོགས་འདུག་ངས་གོམ་སྟབས་ཇེ་མགྱོགས་སུ་བཏང་སྟེ་ཉེ་སར་བཅར་དུས།",
    "ཁོ་ལ་ཕལ་ཆེར་བརྒྱལ་གཟེར་ཕོག་ཡོད་པ་འདྲ་འདུག་བུ་ཆུང་དེའི་གདོང་པ་སྐྱ་བོར་གྱུར་འདུག་ལ།",
    "དོན་དངོས་ཐོག་ང་མཐོང་མི་འདུག།",
    "ཁྱེད་ཀྱིས་སོ་སོའི་ལྕེ་ལ་སོ་བཏབ་འདུག་སེམས་ཁྲལ་མ་བྱེད།",
    "ད་ང་ལ་སྐྱོན་མི་འདུག་ཅེས་བཤད།",
    "བརྒྱལ་གཟེར་དྲག་ན་དཀའ་ངལ་ཅི་ཡང་མི་འདུག་ལ།",
    "ཁྱེད་རང་གང་དུ་སྡོད་ཀྱི་ཡོད་དམ།",
    "ཁྱེད་རང་གང་དུ་སྡོད་ཀྱི་ཡོད་ཀྱང་།",
