    "རེས་འགའ་དགེ་སློང་ཉིད་དུ་སྤྲུལ།",
    "ཆོ་འབྲང་ཕུན་སུམ་ཚོགས་པ་ལ་གཟིགས་པ་དྲི་མ་མེད་པས་གཟིགས་ཤིང་བརྟགས་པའི་སྒོ་ནས་ལྷུམས་སུ་ཞུགས་པར་མཛད་པ་ལས།",
    "མཚོ་དམའ་མོ་གཡུ་ཡི་མཎྜལ་ཡོད།",
    "ཀྱེ་གངས་རིའི་མགོན་པོ་སྤྱན་རས་གཟིགས།",
    "གནས་དེ་ན་ཁྱོད་ཀྱི་ཞིང་ཁམས་ཡོད།",
    "ཞིང་དེ་ན་ཁྱོད་ཀྱི་གདུལ་བྱ་ཡོད།",
    "ཡུལ་རེབ་གོང་གསེར་མོའི་ལྗོངས་ཞེས་གྲགས་པར།",
    "མརྒད་མདངས་ཀྱིས་མཛེས་པའི་སྤང་ལྗོངས་ནེའུ་གསིང་གི་གཡུ་ལོ་ཐགས་སུ་བཀྲ་བའི་འཛིན་མར།",
    "མཐའ་སྐོར་དུ་གཡའ་བྲག་སྤང་གསུམ་སྤེལ་མར་བརྩེགས་པའི་རྫ་རི་སྨུག་པོ་རྒྱལ་བོ་གདན་ལ་བཞུགས་འདྲའི་རྩེ་མོ་མཁའ་ལ་བསྙེགས་པའི་ངོས་སུ་རི་དྭགས་དང་གཅན་གཟན་མང་བོ་བག་ཕེབས་གར་གྱིས་རོལ་བ།",
    "མངོན་རྟོགས་རྒྱན་གྱི་ས་དགུ་བའི་ཡོངས་སྦྱོང་གི་སྐབས་སུ།",
    "དེ་ལྟ་བུའི་རིགས་རུས་ཆོ་འབྲང་གི་ཁྱད་པར་ནི།",
    "མ་མེས་ཟུང་བདུན་གྱི་བར་སྤྱོད་པ་ལ་སྐྱོན་མེད་པའི་བུད་མེད་གང་ཡིན་པ་དེར་གཟིགས་ནས་ཉིང་མཚམས་སྦྱོར་བ་ཡིན་པས།",
    "ཇུ་ཆེན་རྒྱལ་མོ་ཚོ་བཅོ་བརྒྱད་དམ།",
    "ཁོང་གིས་ཀྱང་ཆུང་དུས་ནས་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ལ་ཐུགས་དམ་གཙོ་བོར་མཛད།",
    "བཞུགས་པའི་མཆོད་རྟེན་ཆེན་མོ་སོགས་བཞེངས་ཏེ་རབ་གནས་མཛད་པར།",
    "གཅིག་གིས་མགར་རྩེ་མཐིལ་དང་།",
    "གཅིག་གིས་མགར་རྩེ་ལོ་བུ་ཐུ།",
    "གཅིག་གིས་མགར་རྩེ་གྱ་ས་སོགས་སུ་གཞི་བཟུང་བས་མགར་རྩེ་ཁག་གསུམ་དུ་གྱེས།",
    "དུས་དེར་མོང་གོལ་ཧན་འབྲི་གུང་གི་ཡོན་བདག་ཏུ་གྱུར་པའི་སྐབས་སུ་ཁེལ་སྟབས།",
    "ཇིང་གིར་ཧན་གྱི་བུ་བཞི་བ་ཐོ་ལོའི་བུ་ཧུའུ་ལའི་ཧུ་ནས།",
    "ཏོ་གེར་ཨམ་བྷན་བོད་སོག་གི་དབྱེ་འབྱེད་པ་ལ་ཕེབས་དུས་དཔོན་ཇུ་ནང་གིས་ཞུས་པ་ལྟར་སྔགས་འཆང་དེའི་སྲས་གཉིས་པ་ལ་ནང་སོ་དང་།",
    "ཡབ་ཀྱི་མཚན་ལམ་དུ་རི་ཀླུང་སྔོ་ལྗང་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་ཞིག་གི་ཡུལ་དུ།",
    "ཁོ་ཚང་གི་སྦྲ་གུར་ཕེབས་ཏེ་ཡོད་ཅིང་།",
    "དར་ཤིང་རིང་བོ་དར་དཀར་ལྷབ་ལྷུབ་གཡོ་བ་རྩེ་མོར་ཉི་ཟླས་བརྒྱན་པ་དང་།",
    "ཉི་མ་བདུན་དུས་གཅིག་ཏུ་ཤར་ཏེ་མིག་གིས་ལྟ་བར་མི་བཟོད་པའི་འོད་ཟེར་གྱིས་ས་གཞི་ཐམས་ཅད་ཁྱབ་པ་ཞིག་རྨིས།",
    "སྔར་ཡབ་ཀྱི་མཚན་ལམ་དུ་དར་ཤིང་རྩེར་ཉི་ཟླ་ཟུང་གིས་བརྒྱན་པ་དང་།",
    "ཀུན་གཟིགས་ལྔ་བ་ཆེན་པོས།",
    "གསུང་གི་བརྗོད་པ།",
    "ཐུགས་ཀྱི་འཁྱེར་སོ་གང་གི་ཆ་ནས་ཀྱང་ས་ལ་གནས་པའི་སེམས་དཔའ་ཆེན་པོའི་ངང་ཚུལ་སྦེད་པར་མི་ནུས་པར་ལྷན་སྐྱེས་རང་ནས་གྲུབ་པ་སྐྱེ་བོ་ཀུན་ལ་མངོན་སུམ་དུ་གྲུབ་པས།",
    "སྐྱིལ་ཀྲུང་གིས་དྲང་བོར་བཞུགས་པ་དང་།",
    "རྣམ་ལྔར་གཟིགས་པས་དྲི་མེད་པད་མཚོ་རུ།",
    "སྨིན་ལེགས་དབྱིག་གི་བློ་གྲོས་མར།",
    "རྒྱལ་སྲས་དཔྱིད་ཀྱི་ལང་ཚོའི་དཔལ།",
    "གསེར་ལྡན་སྒེག་མོའི་ཕང་བ་རུ།",
    "ངོ་མཚར་འདབ་སྟོང་གྲོལ་བའི་མཛེས་སྡུག་གིས།",
    "འཇམ་དཔལ་དབྱངས་དངོས་ངུར་སྨྲིག་གར་གྱི་རྣམ་རོལ་ཁྲི་རྒན་འཇམ་དབྱངས་ཐུབ་བསྟན་རྒྱ་མཚོ་སོགས་རྒྱལ་བསྟན་སྲོག་གི་ཀ་བ་འཛིན་པའི་སྐྱེས་ཆེན་དམ་པ་ནམ་མཁའི་རྒྱུ་སྐར་ལ་འགྲན་པ་དག་གི་རིགས་ཀྱི་ཅོད་པན།",
    "འཇམ་མགོན་སྙན་བརྒྱུད་ཀྱི་བསྟན་པའི་བདག་པོ་སྐྱབས་རྗེ་༧ཨ་རོལ་རྡོ་རྗེ་འཆང་རྗེ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོ་སྔར་རབ་བྱུང་བཅོ་ལྔ་བའི་མེ་ཁྱི་ལོར་མྱ་ངན་ལས་འདའ་བའི་ཚུལ་སྟོན་པར་ཉེ་བའི་སྐབས་སུ།",
    "སྐྱབས་རྗེ་དེ་ཉིད་ཀྱི་ཐུགས་སྲས་དམ་པ་དེ་དག་གིས་གདུང་བའི་དབྱངས་ཀྱིས་གསོལ་བ་རྩེ་གཅིག་ཏུ་བཏབ་པ་ན།",
    "རེབ་གོང་རི་ཁྲོད་པ།",
    "བཤེས་གཉེན་ཆེན་པོ་ཉིད་རྗེ་ཞྭ་དམར་བའི་དྲུང་དུ་ཕེབས་ནས་ཨ་རོལ་རྡོ་རྗེ་འཆང་གི་ཡང་སྤྲུལ་རྗེ་ཉིད་ཀྱིས་ཅིས་ཀྱང་ཐག་གཅོད་གནང་དགོས་ཚུལ་དང་།",
    "གལ་སྲིད་ཁོང་གིས་ཐག་མ་བཅད་ན་ཟན་བསྒྲིལ་བྱེད་པ་མ་གཏོགས་ཐབས་མེད་ཚུལ་སོགས་སྐྱབས་མགོན་མཆོག་གི་བཀའ་ངག་ཇི་ལྟ་བ་བཞིན་ཞུས་ཏེ་ཕྱག་ཡིག་སོགས་ཕུལ་བ་ན།",
    "སྐྱབས་རྗེ་ཞྭ་དམར་རྡོ་རྗེ་འཆང་མཆོག་གིས་བཀའ་ལན་གྱི་ཕྱག་ཡིག་འདི་ལྟར་སྩལ་ཏེ།",
    "ཁོ་རང་རེབ་གོང་ནས་བླ་བྲང་ཕྱོགས་སུ་ཡོང་བའི་ལམ་ཞིག་ཏུ།",
    "ཁྱིམ་ཚང་འདི་ནི་འབྱོར་བ་མཐའ་གཉིས་སུ་མ་ལྷུང་བ་ཞིག་རེད་སྙམ་པ་ཤར་བ་ཞིག་རྨིས་ཞེས་དང་།",
    "གུར་ལྷ་མོའི་བསྐང་བཤགས་གསུངས་ཞེས་བཀའ་སྩལ་རྗེས།",
    "རེབ་གོང་ཕྱོགས་ཀྱི་བླ་སྐྱ་དཔོན་གསུམ་ཚོགས་པའི་དབུས་སུ།"
  ]
}