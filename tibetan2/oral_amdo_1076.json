    "ལ་ལནི་ཉོན་མོངས་བས་སྤྲུལ་པའོ།",
    "བཅོམ་ལྡན་འདས་ལས་དང་པོ་པའི་གང་ཟག་གིས་༣༨ ངོ་བོ་ཉིད་སོང་པ་ཉིད་ཡོངས་སུ་འཚལ་བར་བགྱིནཇི་ལྟར་གདམས་ཤིང་རྗེས་སུ་བསྟནཔར་བགྱི།",
    "དེ་ལ་གང་ཡོངས་སུ་ཤེས་པར་བྱ་བ་ངོ་བོ་ཉིད་སྟོང་པ་ཞིག་ཅེས་བྱ་བ་ལ་༧༣ ཡོད་པར་འགྱུར་རེ་སྐན་ཞེས་བྱ་བ་ནི་མྱ་ངན་ལས་འདས་པ་ལ་དགོད་པའི་ཕྲིན་ལས་ཡིན་ནོ།",
    "འདི་དག་གིས་ནི་ཕྲིན་ལས་རྣམས་གསུངས་སོ།",
    "ཚེ་དང་ལྡན་པ་མོངྒལ་གྱི་བུ་ཆེན་བོ་དང་།",
    "གང་གིས་དག་པར་གཏུགས་པ་འཇིག་རྟེན་དོན་དུ་མཉམ་པར་བཞག་པས་སླང་པར་གྱིས།",
    "༡༣༧༣ མོས་པ་སྒོམ་ལམ་དངོས་དང་ཕན་ཡོན་དང་བཅས་པ།",
    "༧གཉིས་པ་རྩེ་མོའི་རྩེ་སྦྱོར།",
    "༣༨༣༩༩ གསུམ་པ་མཇུག་གི་དོན་བཅས་སོ།",
    "མཛད་པས་འགྲོ་ཀུན་རེ་བ་སྐོང་མཁས་པ།",
    "བོད་ཁམས་གདུལ་བྱའི་རེ་བ་སྐོང་མཛད་པ།",
    "གཞུང་གི་དོན།",
    "མཇུག་གི་དོན་ནོ།",
    "གཞུང་གི་ཆ་མང་པོ་ཕྱོགས་གཅིག་ཏུ་བསྡོམས་པས་ན་བམ་པོ་ལྔ་ཡོད་པའི་དང་པོ་འདི་ནས་འཆད།",
    "ནང་གི་རྐྱེན་བསྟན་བཅོས་ཀྱི་དོན་མཐའ་དག་རྟོགས་པའི་ཤེས་རབ་དང་ལྡན་པར་བསྒྲུབ་པ།",
    "གང་གིས་ན་འཕགས་པ་ཐོགས་མེད་ཀྱིས་སོ།",
    "གང་གིས་ན་འགྲོ་བའི་དོན་མངོན་མཐོ་དང་ངེས་ལེགས་ཀྱི་རྩ་ལག་ཏུ་གྱུར་པའི་དབྱིག་གཉེན་དེས་སོ།",
    "གཉིས་སྟོང་བདེན་གྲུབ་ལ་ཞེན་པས་རང་གི་མོས་པ་གཙོ་བོར་བྱེད་པས་ཡིན་གྱི།"
  ]
}