    "རྡོ་རྗེ་ཅན་གྱི་ཡུམ་གྱི་མཁར་སླར་ཡང་ལྷ་མོ་བཞི་རྣམས་སུ་གྱུར།",
    "རྡོ་རྗེ་ཅན་གྱི་དཀྱིལ་འཁོར་གྱི་ཤར་གྱི་འདབ་མ་ལ་གོ་རཱི་དཀར་མོ་གཡས་ལྕགས་ཀྱུ་འཛིན་པ།",
    "ལྷོར་ཙོ་རཱི་སེར་མོ་རྡོ་རྗེ་ཞགས་པ།",
    "ནུབ་ཏུ་བེ་ཏཱ་ལཱི་དམར་མོ་རྡོ་རྗེ་ལྕགས་སྒྲོག་བྱང་དུ་གྷསྨ་རཱི་ལྗང་གུ་རྡོ་རྗེས་མཚན་པའི་དྲིལ་བུ།",
    "བྱང་ཤར་དུ་པུཀྐ་སཱི་ནག་མོ་རི་རབ།",
    "ལྷོ་ནུབ་ཏུ་གདོལ་པ་མོ་སྔོན་མོ་མེ་ཐབ།",
    "ཕན་པའི་དཀྱིལ་འཁོར་གྱི་ཤར་གྱི་འདབ་མ་ལ་སྐམ་པ་མོ་ནག་མོ་གཡས་སྐམ་པ།",
    "ལྷོར་ཞགས་པ་མོ་སེར་མོ་གཡས་ཞགས་པ།",
    "ནུབ་ཏུ་དོལ་ཟླུམ་མ་དམར་མོ་ཉ་རྒྱ།",
    "བྱང་ཤར་དུ་མེ་ཏོག་མ་དཀར་མོ་མེ་ཏོག་ཤར་ལྷོར་བདུག་སྤོས་མ་དུད་ཀ་སྤོས་སྣོད།",
    "ལྷོ་ནུབ་ཏུ་མར་མེ་མ་སེར་མོ་མར་མེ།",
    "བྱང་ཤར་དུ་སྒེག་མོ་དཀར་མོ་གཡས་ཁུ་ཚུར་རྐེད་པར་འཇོག་པ།",
    "ལྷོ་ནུབ་ཏུ་གླུ་མ་སེར་མོ་གཡས་ཁ་ནས་ཚིགས་འབྱིན་པའི་ཚུལ་བྱེད་པ།",
    "ནུབ་ཏུ་ལྕགས་སྒྲོག་མ་ནག་མོ་ལྕགས་སྒྲོག་བྱང་དུ་འཁྱུད་མ་ལྗང་གུ་གཡས་འཁྱུད་པའི་ཚུལ་བྱེད་པ།",
    "བྱང་ཤར་དུ་གླིང་བུ་མ་སེར་མོ་གླིང་བུ།",
    "ཤར་ལྷོར་པི་ཝང་མ་དཀར་མོ་པི་ཝང་།",
    "ནུབ་བྱང་དུ་རྫ་རྔ་མ་དཀར་མོ་རྫ་རྔ་འཛིན་པ།",
    "རྟ་མཆོག་གི་དཀྱིལ་འཁོར་གྱི་ཤར་གྱི་འདབ་མ་ལ་སྒོ་ལྕགས་མ་དཀར་མོ་གཡས་སྒོ་ལྕགས།",
    "ལྷོར་ལྡེ་ཀྱོག་མ་སེར་མོ་ལྡེ་ཀྱོག་ནུབ་ཏུ་སྒོ་གླེགས་མ་དམར་པོ་སྒོ་གླེགས།",
    "བྱང་དུ་གོས་འཛིན་མ་སྔོན་མོ་གོས།",
    "བྱང་ཤར་དུ་སྤྱན་མ་དཀར་མོ་འཁོར་ལོའི་ལྟེ་བར་སྤྱན་གྱིས་མཚན་པ།",
    "ཤར་ལྷོར་མཱ་མ་ཀཱི་སྔོན་མོ་རྡོ་རྗེ།",
    "ལྷོ་ནུབ་ཏུ་གོས་དཀར་མོ་དམར་མོ་པདྨ།",
    "ཕྱིའི་ཤར་སྒོར་ལྕགས་ཀྱུ་མ་དཀར་མོ་གཡས་ལྕགས་ཀྱུ།",
    "ལྷོ་སྒོར་ཞགས་པ་མ་སེར་མོ་ཞགས་པ།",
    "ནུབ་སྒོར་ལྕགས་སྒྲོག་མ་དམར་མོ་ལྕགས་སྒྲོག་བྱང་སྒོར་དྲིལ་བུ་མ་ལྗང་གུ་དྲིལ་བུ་འཛིན་པ།",
    "གཡས་པས་རང་རང་གི་ཕྱག་མཚན་འཛིན་ཅིང་།",
    "དེ་ནས་རང་གི་ཤེས་པ་མཚམས་ཀྱི་ལྷ་མོ་བཞིའི་ང་རྒྱལ་དུ་འཕོས་ཏེ།",
    "ཁྱོད་ནི་ཞེ་སྡང་རྡོ་རྗེ་ཡོངས་སྐྱོང་བ།",
    "སྦོས་མོ་སོགས་ཀྱི་གནས་ལུགས་པའི།",
    "མེ་ཏོག་ལ་སོགས་རང་གི་གླུས།",
    "མཚམས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གླུས།",
    "དེའི་ཚེ་མེ་ཏོག་མ་ནི་བདག་ལ་མྱུར་དུ་གཟིགས་ཞེས་སོགས་འདོན་པ་བསྒྱུར་དགོས་སོ།",
    "སཱི་ནི་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "ཁྱོད་ནི་གཏི་མུག་རྡོ་རྗེ་ཡོངས་སྐྱོང་བ།",
    "རི་ཁྲོད་མ་ནི་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "ཁྱོད་ནི་འདོད་ཆགས་རྡོ་རྗེ་ཡོངས་སྐྱོང་བ།",
    "གཏུམ་པར་ལྡན་པ་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "གཡུང་མོས་རྡོ་རྗེ་ཉི་མ་དང་།",
    "ཌོམྦི་ནཱི་ནི་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "བྱང་གི་ཐིག་ལེ་ཁྃ་ཏཱྃ་གི་ས་བོན་འོད་འབར་ཞིང་འཇིགས་པར་གྱུར།",
    "ཞལ་ཕྱག་ལྷག་མ་རྣམས་དང་ཡུམ་རྣམས་རྒྱུའི་རྡོ་རྗེ་འཆང་གི་སྐབས་ལྟར་གསལ་གདབ་བོ།",
    "རལ་གྲི་རྣམས་རང་རང་གི་ས་བོན་གྱིས་མཚན་པ།",
    "བཅུད་ཐམས་ཅད་མཁའ་འགྲོ་ལྔའི་ལྷ་ཚོགས་སུ་བྱས་པར་བསམ་མོ།",
    "ཚོགས་ཞིང་གི་སྐབས་ལྟར་ལྷ་མོ་བརྒྱད་ཀྱིས་མཆོད་ནས།",
    "ཁྱོད་ནི་རྣལ་འབྱོར་མ་ཚོགས་སོགས་ཀྱིས་བསྟོད།",
    "ཡེ་ཤེས་པ་རྣམས་ཀྱི་ཐུགས་ཀར་རེག་པའི་ཚུལ་དུ་བྱས་པས་ཡེ་ཤེས་པ་རྣམས་སྲུང་བའི་འཁོར་ལོའི་ནང་དུ་དགུག་པར་བསམས་ལ་ལུས་ཀྱིས་ལྕགས་ཀྱུའི་ཕྱག་རྒྱ་བཅས་ཏེ།",
    "དེ་བཞིན་དུ་ཙོ་རཱི་སེར་མོ་ཞགས་པ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ་ཡེ་ཤེས་པ་རྣམས་ཀྱི་མགྲིན་པར་རེག་པའི་ཚུལ་དུ་བྱས་པས།",
    "ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་རྟེན་དང་བརྟེན་པར་བཅས་པ་རང་གི་དམ་ཚིག་གི་འཁོར་ལོ་ལ་བཅུག་པར་བསམས་ལ་ཞགས་པའི་ཕྱག་རྒྱ་དང་།",
    "བེ་ཏཱ་ལཱི་དམར་མོ་ལྕགས་སྒྲོག་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ནས་དཀྱིལ་འཁོར་པ་ཐམས་ཅད་ཀྱི་ཞབས་ལ་ལྕགས་སྒྲོག་གིས་རེག་པའི་ཚུལ་དུ་བྱས་པས་ཡེ་ཤེས་པ་དང་དམ་ཚིག་པ་དབྱེར་མེད་གཅིག་ཏུ་གྱུར་པར་མོས་ལ་ལྕགས་སྒྲོག་གི་ཕྱག་རྒྱ་དང་།",
    "གྷསྨ་རཱི་དྲིལ་བུ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ་གཞལ་ཡས་ཁང་གི་ཕྱི་ནང་ཐམས་ཅད་གང་བས་ལྷ་རྣམས་དགྱེས་པ་ཁྱད་པར་ཅན་བསྐྱེད་ཅིང་།",
    "དེ་ནས་ལྷ་ཐམས་ཅད་ཀྱི་མིག་ཏུ་མྃ་ལས་གཏི་མུག་རྡོ་རྗེ་མ་དཀར་མོ།",
    "རྣ་བར་དྃ་ལས་ཞེ་སྡང་རྡོ་རྗེ་མ་སྔོན་མོ།",
    "སྣར་པྃ་ལས་སེར་སྣ་རྡོ་རྗེ་མ་སེར་མོ།",
    "ལྕེ་ལ་རྃ་ལས་འདོད་ཆགས་རྡོ་རྗེ་མ་དམར་མོ།",
    "སྤྱི་བོར་ཨྃ་ལས་སྐུ་རྡོ་རྗེ་མ་དཀར་མོ།",
    "མགྲིན་པར་ཨཱ་ལས་གསུང་རྡོ་རྗེ་མ་དམར་མོ།",
    "གྲུ་མོ་ན་ཁ་ཊྭཱཾ་ག་འཛིན་ཅིང་རོའི་སྟེང་ན་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་གྱིས་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པར་བསམས་ལ།",
    "ཨོཾ་ཨེ་ཧྱེ་ཧི་བྷ་ག་ཝཱན་མ་ཧཱ་ཀཱ་རུ་ཎི་ཀ་པཉྩ་ཀུ་ལ་ས་པ་རི་ཝཱ་ར་བཛྲ་ས་མཱ་ཛ་ཞེས་བརྗོད་ལ་ལྷ་མོ་བརྒྱད་ཀྱིས་མཆོད་ཅིང་།",
    "ཁྲོ་བོ་ཁྲོ་མོ་རྣམས་ཀྱིས་བགེགས་བསྐྲད་པར་བསམ་ཞིང་།",
    "གཙོ་བོ་ཡབ་ཡུམ་གཞན་བཞི་ལ་རང་རང་གི་རིགས་ཀྱི་བདག་པོས་དབུར་བརྒྱན་པའི་རྣམ་སྣང་གྱི་སྤྱི་བོར་འཁོར་ལོ་དཀར་པོ།",
    "འཁོར་གྱི་ལྷ་མོ་བྱང་ཤར་བ་དང་ཤར་ཕྱོགས་པ་རྣམས་ལ་མི་བསྐྱོད་པ།",
    "རང་རང་གི་གཙོ་བོས་དབུར་བརྒྱན་པ་འདི་ཉིད་གུར་ལེའུ་དང་པོའི་དག་པའི་སྐབས་དང་།",
    "མི་ཐུབ་ཟླ་བའི་གཞུང་གི་དགོངས་པ་ཡིན་ནོ།་།",
    "འཁོར་གྱི་ལྷ་མོ་རྣམས་ལ་རང་རང་གི་གཙོ་བོས་དབུར་བརྒྱན།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཀུཎྜ་ལི་ཧ་ན་ཧ་ན་ཧ་ཱུྃ་ཧ་ཱུྃ་ཧ་ཱུྃ་ཕཊ།",
    "ཟླ་བའི་སྟེང་དུ་ཤར་དུ་གོ་ལས་བ་གླང་གི་ཤ་ལྷོར་ཀུ་ལས་ཁྱིའི་ཤ་ནུབ་ཏུ་ད་ལས་རྟའི་ཤ་བྱང་དུ་ཧ་ལས་གླང་པོ་ཆེའི་ཤ་དབུས་སུ་ན་ལས་མིའི་ཤ་ཤ་ལྔ་པོ་རེ་རེའི་སྟེང་དུ་ཤར་དུ་བྷྲ་ཱུྃ་ལས་དྲི་ཆེན།",
    "དེ་ཐམས་ཅད་ཀྱི་སྟེང་གི་ནམ་མཁའ་ལ་ཨོཾ་ཡིག་དཀར་པོ་མགོ་ཐུར་དུ་ལྟ་བ།",
    "དེའི་སྟེང་དུ་ཧ་ཱུྃ་ལས་རྡོ་རྗེ་ཧ་ཱུྃ་གིས་མཚན་པ་བསམ་པར་བྱའོ།"
  ]
}