    "༡༥༨༩ བསྡུར་འབྲས་རེའུ་མིག་༡༥༨༩༡༨ དུ་ར་ཁྲོད་བརྒྱད་ཅེས་བྱ་བ།་",
    "༡༥༩༢བསྡུར་འབྲས་རེའུ་མིག་༡་༥༩༢༡༩ བརྡ་ངེས་པར་བཟུང་བ་བཞུགས།་",
    "༡༥༩༡བསྡུར་འབྲས་རེའུ་མིག་༡༥༩༨༡༡ གནས་ལ་སོགས་པ་གཏན་ལ་དབབ་པ།་",
    "ད་པལ་ཡང་ད་ག་པར་སྦྱོར་བའི་རྒྱུད་ཀྱི་རྒྱལ་པོའི་རྒྱ་ཆེར་འགྲེལ་པ་མན་ངག་གི་སྙེ་མ་ཞེས་བྱ་བ།",
    "རྡོ་རྗེ་སྒེག་མོའི་དགའ་བ་ཤིན་ཏུ་མང་དང་གཉིས་སུ་མེད་པའི་སྐུ་ཡིས་འགྲོ་རྣམས།",
    "མུན་པའི་ཚོགས་རྣམས་ནུབ་པར་མཛད་པའི་སྤྲུལ་པ་རྣམས་ཀྱིས་ནང་གི་འོད་ཟེར་འཆར་མཛད་ཀྱང་།",
    "བྱིན་གྱིས་བརླབས་པས་དེ་གསུང་གི།",
    "རྡོ་རྗེ་བཙུན་མོས་བསྐུལ་བའི་ཕྱིར།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་པ་ལ་སོགས་པའོ།",
    "རྡོ་རྗེ་ལྟ་བུ་བདེ་བ་ཆེན་པོ་རོ་གཅིག་པ་འགྲོ་བ་ཐམས་ཅད་ལ་ཕན་པ་བྱེད་པ་འབྲས་བུ་རྡོ་རྗེ་འཆང་གི་ངོ་བོ་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ནི་དགོས་པའི་དགོས་པའོ་ཞེས་འཕངས་སོ།",
    "སུམ་ཅུ་རྩ་དྲུག་པར་ནི་སྔར་གསུངས་པའི་གནས་ལ་སོགས་པ་རྣམས་སུ་ཚོགས་ལ་འདུ་བ་ན་རྣལ་འབྱོར་པའི་རོལ་མོ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེའི་ཕྱིར་སྟོན་པ་པོ་ལས་ཇི་སྐད་ཐོས་པ་བཞིན་དུ་གཅིག་གིས་སྨྲ་བར་བྱེད་ཅི་ང་།",
    "དེའི་ཕྱིར་ཨེ་ཝཾ་གྱི་༡ཡི་གེ་འདི་རྒྱུད་ཀྱི་དོན་མཐའ་དག་གིས་དོན་དང་ལྡན་པར་བསྟན་ཏོ།",
    "འདི་བདག་གིས་མངོན་སུམ་དུ་བྱས་པ་ནི་མ་ཡིན་ཏེ།",
    "གཞན་ཕྲ་མོ་རྣམས་ཀྱིས་ལྟ་ཅི་ཞེས་བསླབ་པའི་དོན་དུ་ཐོས་པ་སྨོས་ས་སོ།",
    "ཡང་ན་དུས་གཅིག་གི་ཚེ་འདི་ཐོས་ཤིང་།",
    "དེ་རྡོ་རྗེ་རྩེ་མོར་གསུངས་པ་ཉོན་མོངས་བདུད་སོགས་འཇོམས་པའི་ཕྱིཕྱིར།",
    "ཤེས་རབ་ཀྱིས་གཞོམ་ཉོན་མོངས་དེ།",
    "ངེས་པའི་ཚིག་གིས་ན་ཕྱིས་པའོ།",
    "གཞན་རྣམས་ལ་དེ་བཞིན་ཁོ་ནར་གསུང་ངོ་ཞེས་པ་ངེས་པའི་ཚིག་གིས་སྒྲུབ་པས།",
    "དེ་ཉིད་བཙུན་མོ་སྟེ་བླ་ན་མེད་པའི་དགའ་བའི་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་ན།་",
    "འཁྱུད་པའི་བརྟེན་པར་བྱ་བ་ལྷ་མོའི་པད་མ་ཞེས་བྱ་བ་རྟེན་གྱི་ངོ་བོ་ལ་བཞུགས་༡སོ།",
    "མང་པོའི་ཚིག་ནི་རྡོ་རྗེ་སྙེམས་མ་ནི་བཙུན་མོ་ཐམས་ཅད་བསྡུས་པའི་རྣམ་པ་ཅན་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "ཨ་ཝརྫི་ཏ་ཝན་༡ཀུན་ནས་འདུན་པར་མཛད་པ་གང་གི་ཚེ་ཡིན་པ་དེའི་ཚེ་དེ་ལས་དེར་བདག་གིས་ཐོས་སོ་ཞེས་སྔ་མ་དང་སྦྲེལ་ལ་ལོ།",
    "བྷ་ག་དེར་དེ་བཞིན་གཤེགས་པ་མཐའ་དག་བཙུན་མོ་དང་བ་ཅས་པ་གནས་སོ་ཞེས་པ་དེར་ནི།",
    "དེའི་བཙུན་མོ་ཕྱག་རྒྱ་ཆེན་མོ་བཅོམ་ལྡན་འདས་མ་ཤེས་རབ་ཆེན་མོ་ཀུན་དུ་བཟང་མོའི་མིང་གཞན་ཅན་ན་ནོ་། དེའི་བྷ་ག་ནི་སྟོང་པ་ཉིད་དོ།",
    "རེ་བ་མ་ལུས་རྫོགས་པར་མཛད།",
    "དེའི་རང་གི་ངོ་བོ་ཅི་ཞིག་པའོ།",
    "ཡང་དག་སྦྱོར་བྱུང་ཞེས་པ་ནི་དང་པོའི་གཅིག་གི་ཚིག་ཕྱིས་པའོ།",
    "དངོས་པོ་རྣམས་ཀྱི་སྟོང་པ་ཉིད་ཀྱི་ངོ་བོ་ནི་རང་བཞིན་དང་རྣམ་པ་ཞེས་པ་དོན་གཞན་མ་ཡིན་ཏེ་རང་གི་ངོ་བོ་ཞེས་པའི་དོན་ཏོ།",
    "སོ་སོར་རྡོ་རྗེ་གསུམ་གྱི་རང་བཞིན་ཉིད་ཀྱི་ཕྱིར་སྐུ་གསུང་ཐུགས་ནི་རྣམ་པ་གསུམ་མོ།",
    "དེ་རྗོད་པར་བྱེད་པ་ཉིད་ཀྱིས་ན་དེ་ལྟར་ཐ་སྙད་དུ་བྱས་པ་ནི་གཞུང་གི་རྒྱུད་ཀྱི་ཁྱད་པར་འདུས་པ་ལ་སོགས་པ་རྣམས་ས་སོ།",
    "གང་གི་ཕྱིར་འདི་ཡོད་པ་ཁོ་ན་ན་ཐབས་ཀྱི་རྒྱུད་བྱེད་པ་པོ་འཇུག་པའི་ཕྱིར་ཏེ།",
    "གུས་པ་དང་བཅས་པར་བར་མ་ཆད་པར་དུས་རིང་པོར་གོམས་པ་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་རྣལ་འབྱོར་པའི་མངོན་སུམ་སོ་སོ་རང་གིས་རིག་པར་བྱ་བ་ས་མངོན་དུ་མཛད་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་དངོས་པོ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "རིགས་པས་གྲུབ་དང་རང་ཚིག་ག་གིས་། གནོད་མེད་བསྟན་བཅོས་གང་ཡིན་ཏེ།",
    "ལུང་གིས་ཀྱང་ཚུ་རོལ་མཐོང་བ་རྣམས་ཀྱིས་ངེས་པའོ་ཞེས་པའི་དོན་ཏོ་ཞེས་པ་ནི།",
    "ཉན་ཐོས་གང་ཟག་གི་བདག་མེད་པ་ཉིད་མངོན་སུམ་དུ་བྱས་པ་ཉིད་ཀྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་པ་རྣམས་ཀྱི་ཡང་སྟེ།",
    "ཤེས་རབ་དང་ཐབས་དེ་དག་གཉིས་སུ་མེད་པར་གྱུར་པས་གང་གི་བདག་ཉིད་དེ་རང་བཞིན་ཡིན་པ་དེ་ནི་དེ་སྐད་དེ།",
    "ཡང་དག་པར་སྦྱོར་བ་ཟུང་འཇུག་གི་ངོ་བོའོ།",
    "དེ་རྣམས་ཀྱི་རང་བཞིན་དེ་གཉུག་མའི་ངོ་བོ་གང་གི་བདག་ཉིད་དེ་རང་གི་ངོ་བོ་ཡིན་པ་དེ་ནི་དེའི་བདག་ཉིད་ཅན་ཏེ་དེ་ལས་གཞན་པའི་བརྟན་པ་དང་གཡོ་བའི་དངོས་པོའི་རང་བཞིན་མེད་པའི་ཕྱིར་རོ།",
    "ཚིག་གི་དོན་རྣམས་ནི་སྔར་བཞིན་ནོ།",
    "མན་ངག་གི་བྱ་བ་ལས་བྱུང་ངོ་ཞེས་པ་མན་ངག་ལས་བྱུང་བ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཆ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་དང་ཐུན་མོང་བ་སྟེ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་བདེ་བ་ནི་ཐུན་མོང་མ་ཡིན་པའོ།",
    "རྣལ་འབྱོར་གྱི་རྒྱུད་ཀྱི་ཚིག་གི་དོན་བརྗོད་པས་ནི་ཤེས་རབ་ཀྱི་དེ་ཁོ་ན་ཉིད་ཀྱང་གཙོ་བོར་འཆད་པར་འགྱུར་རོ།",
    "བདག་གིས་ཏེ་རྡོ་རྗེ་སེམས་དཔའ་བདག་ཉིད་ཁོ་ནས་སྐལ་བ་དང་ལྡན་པའི་གདུལ་བྱ་རྣམས་ལ་སོ་སོར་རྟོག་པའི་བསམ་པས་༐",
    "དེ་ལྟར་ཡང་གསོལ་བ་འདེབས་པ་པོ་གཙོ་བོ་ཉིད་ཀྱི་ཕྱིར་ཉོན་ཞེས་གཅིག་གི་ཚིག་སྟེ།",
    "དྲི་མ་རྣམས་ནི་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་རྣམས་ཏེ།",
    "རང་གི་མཚན་ཉིད་འཛིན་པ་ར་བྱེད་དོ་ཞེས་པ་ཁམས་སོ།",
    "གཙུག་ལ་ག་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་བྱ་བ་རང་གི་ངོ་བོས་དོན་དམ་པར་གཟུགས་ཀྱི་ཁམས་ཀྱིས་སྟོང་པ་རྣམས་ཞེས་པའི་དོན་ཏོ།",
    "མིག་བདག་ཉིད་ཅེས་བྱ་ཞེས་པ་འདིས་རང་གི་ངོ་བོས་སྟོང་པ་རྣམས་ལ་རྣམ་པར་ཤེས་པ་སྟེ།",
    "དེ་དག་གིས་སྟོང་པ་རྣམས་ཀྱིའོ།",
    "མྱོང་བ་པོ་ཡང་ཤེས་པའི་ཡང་གིས་དེའི་རྣམ་པར་ཤེས་པའོ།",
    "ཡང་གིས་དེའི་རྣམ་པར་ཤེས་པའོ།",
    "གཟུགས་ཀྱི་ཁམས་དང་མིག་གི་ཁམས་དག་དང་མིག་གི་རྣམ་པར་ཤེས་པའི་ཁམས་ནས།་",
    "དེ་ལ་ཚིམ་པར་བྱེད་པ་ད་ང་ཡོངས་སུ་གདུང་བར་བྱེད་པ་དང་དེ་གཉི་ག་ལས་གྲོལ་བའི་རང་གི་ཡུལ་གྱི་རང་གི་ངོ་བོ་མངོན་དུ་བྱ་བས་ཡུལ་ཉམས་སུ་མྱོང་བ་རྣམ་པར་ཤེས་པའི་ཉམས་སུ་མྱོང་བའི་རིག་པ་ནི་ཚོར་བ་ཞེས་བརྗོད་དོ།",
    "གང་གི་ཕྱིར་ན་གཉིས་སྤངས་པ་སྟེ།",
    "མེད་དེ་གང་གི་ཕྱིར་ཀུན་རྫོབ་ཏུ་བཅོམ་ལྡན་འདས་ཀྱིས་སེམས་ཙམ་ཉིད་དུ་བསྟན་གྱི་དོན་དམ་པར་ཡོད་པ་ནི་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "གང་མཐའ་འདི་དག་གི་དབུས་ནི་དཔྱད་དུ་མེད་པ་བསྟན་དུ་མེད་པ་རབ་ཏུ་མི་གནས་པ་གནང་བ་མེད་པ་རྣམ་པར་རིག་པ་མ་ཡིན་པ་གནས་མེད་པ་སྟེ།",
    "ནང་གི་ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་ངོ་བོར་མི་གནས་པ་ཉིད་ཀྱི་ཕྱིར་རབ་ཏུ་མི་གནས་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་ཁམས་ཀྱི་རང་གི་ངོ་བོ་ལས་འདས་པ་ཉིད་ཀྱི་ཕྱིར་རྣམ་པར་རིག་པ་མ་ཡིན་པའོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པ་མཐའ་དག་གི་གནས་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་གནས་མེདལའོ་ཞེས་བརྗོད་ད་དོ།",
    "རང་གི་སེམས་ཀྱི་༡ངོ་བོའི་བདག་ཉིད་ཅན་གྱི་དངོས་པོ་དོན་དམ་པ་ཅུང་ཟད་ཡོད་པར་གྱུར་ན་དེའི་ཚེ་དེ་ཡོད་དོ་དེ་མེད་དོ་ཞེས་པའམ་རྟག་གོ་ཞེས་པའམ་མི་རྟག་གོ་ཞེས་མངོན་ཕར་ཞེན་པ་མཐར་ཅི་ལྟར་འགྱུར་ཇི་སྲིད་དུ་དངོས་པོའི་དོན་གྱི་དེ་ཁོ་ན་ཉིད་ཀྱི་རྗེས་སུ་སོང་བ་ན་ཡིད་ལ་བྱེད་པ་ཚུལ་བཞིན་པ་༢ཁོ་ན་ནི་ལྷུང་བའི་གནས་སོ་ཞེས་རིགས་པ་མ་ཡིན་ཞིང་།",
    "ད་བུས་ན་དངོས་པོའི་རང་གི་ངོ་བོ་མེད་ན་དོན་མེད་དོ་ཞེས་འཛིན་པ་ཡང་མཐའ་མ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།་",
    "སྒྱུ་མའི་རང་གི་མཚན་ཉིད་མིན།",
    "སྤྱི་དང་ཁྱད་པར་དག་ལས་གཞན་པའི་ཡང་རྟོགས་པར་བྱ་བའི་རང་གི་ངོ་བོ་མི་སྲིད་པའི་ཕྱིར་རྟོགས་དཀའ་བའོ།",
    "གལ་ཏེ་གང་གི་ཕྱིར་བག་ཆགས་ཀྱི་རྗེས་སུ་མོན་པ་དེའི་ཕྱིར་དེ་རྣམས་ཀྱིས་ཀྱང་མི་ཤེས་སོ།",
    "དེ་ཁོ་ན་མཛའ་བ་དང་བྲལ་བ་དང་མི་མཛའ་བ་དང་ཕྲད་པ་ལ་སོགས་པ་ཉེ་བར་འཚེ་བ་མང་པོའི་རྒྱུ་ཉོན་མོངས་པའི་ཆུ་སྲིན་ལ་སོགས་པས་ཡོངས་སུ་བསྐོར་བ་ཉིད་ཀྱིས་༡༐",
    "མཚན་ཉིད་དེ་གསུངས་པ་མཚོན་པ་རྣམས་ཀྱི་སྟེ་མཚོན་པར་བྱ་བ་རྣམས་ཀྱི་མཚོན་བྱེད་དེ་རང་གི་ངོ་བོ་མཚོན་པར་བྱ་སྟེ་ངེས་པར་བརྟག་པར་བྱའོ།",
    "ཤེས་པས་ཏེ་སྟོང་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱིས་བལྟ་བྱ་སྟེ་དེ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་རང་གི་ངོ་བོར་མཚོན་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ལྟར་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ལྷའི་རྣལ་འབྱོར་ནི་བསྐྱེད་པ་དང་རྫོགས་པའི་རིམ་པ་དག་གིས་གོམས་པར་བྱའོ་། དོན་འདི་ཁོ་ན།",
    "དེའི་སྤྱི་བོར་གནས་པའི་མདུད་པའི་བུ་ག་ནས་ལས་ཀྱི་གཏུམ་མོའི་རྣལ་འབྱོར་གྱིས་སས་མ།",
    "དེ་ཁོ་ན་འཇིག་རྟེན་གསུམ་ཉིད་དེ་རང་གི་དོན་ལ་ཡ་ཎའོ།",
    "ཁུ་བ་དང་བདེ་བ་དག་གི་བར་ནི་ཤེས་རབ་དང་ཐབས་ཀྱི་རྣམ་པར་དབྱེ་བ་སྟེ།",
    "སྙོམས་པར་ཞུགས་པའི་ལྷ་དག་གི་ལྟར་ཡིན་གྱི།",
    "དེའི་ཙམ་སྟེ་མཐའ་དག་ཉིད་མཆོག་སྟེ་ཕུལ་དུ་བྱུང་བ་གང་གི་ཡིན་པ་དེ་དེ་སྐད་དོ་༡།",
    "མཆོག་གི་རྫུ་འཕྲུལ་མ་ལུས་པ་དང་ལྡན་པ་ཞེས་པའི་དོན་ཏོ།",
    "ཕྲ་བ་སྟེ་དོན་དམ་པར་ཟབ་པ་ཉིད་ཀྱི་ཕྱིར་ཀུ་ཤའི་རྩེ་མོ་ལྟ་བུའི་བློ་ཅན་གྱི་སྤྱོད་ཡུལ་ལོ།",
    "གང་གིས་ཉེ་བར་འཇལ་བ་ཡིད་ཡིན་པ་དེ་ནི་ཡིད་དཔེ་ཅན་ཞེས་པ་གཙུག་ལག་སྟེ་ཡིད་ཀྱི་རང་བཞིན་ཞེས་པའི་དོན་ཏོ།",
    "འཁོར་ལོ་གཞན་དུ་རེས་འགའ་གནས་ཀྱི་དུས་ཐམས་ཅད་དུ་མ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "ཉེ་བ་ལས་དེ་རྣམས་ཁོ་ནའི་འོ་ཞེས་པ་ཀུན་དུ་སྡུད་པ་ལས་བཅུ་གསུམ་མོ།",
    "གཙུག་གི་འཁོར་ལོའི་རྩ་བཞི་པོ་རྣམས་ཀྱི་དབུས་སུ་ཨ་ཝ་དྷཱུ་ཏཱི་ལྔ་པའི་ཆ་ཁོ་ན་ཆ་ཙམ་སྟེ།",
    "རྩའི་མདུད་པའི་བུ་ག་ལ་བརྟེན་པའི་ས་བོན་ཏེ་ཧཱུཾ་ཡིག་ནག་པོ་བཅོམ་ལྡན་འདས་ཀྱི་རང་གི་ངོ་བོ་དཔྱིད་ཅེས་བྱ་བྱ་བའོ་། ཕྱེད་ཅེས་བྱ་བ་ལས་༢ལ་སོགས་པའོ།",
    "ཕྱི་མོ་ཕྱེད་པ་ཡང་དེ་སྟེ་གསལ་བྱེད་ནི།",
    "ཕྱི་མོ་ཕྱེད་པ་ཅན་ནོ་ཞེས་པའི་རིགས་པ་ལས།",
    "མན་ངག་ལས་མགྲིན་པའི་དབུས་སུ་ཨོཾ་མོ།",
    "ཉོན་མོངས་དེ་བཞིན་ནོ་ཞེས་པ་ཉོན་མོངས་པ་རྣམ་པར་དག་པའི་ས་བོན་སྨྼྻུཾའོ།",
    "བརྒྱད་ཀྱི་ཡན་ལག་གིས་ཞེས་ཀློག་པ་ལ་ཡང་དེ་ལྟར་རོ།",
    "གང་གི་ཕྱིར་དེས་དེའི་བདག་ཉིད་དུ་འགྲོ་ཀུན་ཁྱབ་པས་སོ།",
    "བདེ་བ་ཆེན་པོའི་རང་བཞིན་ཅན་གྱི་རྣལ་འབྱོར་པ་དེའི་ཡང་རང་གི་ད་ང་ཁོ་ནས་ཇི་ལྟར་འདོད་པ་སྤྲོ་བ་དང་སྡུད་པའི་ཕྱིར།",
    "ཅི་ཞིག་ལས་ལས་ཀྱི་སྒྲིབ་པ་འམ་ཉོན་མོངས་པའི་སྒྲིབ་པ་ཡིན།",
    "རང་གི་ནུས་པ་ནི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "གང་གི་ཕྱིར།",
    "ཁ་དོག་ཏུ་བྱ་བས་ན་ཁ་དོག་སྟེ་རང་གི་ངོ་བོའོ།",
    "དེ་ལས་ཞེས་པ་རང་གི་ནུས་པ་ལས་ས་སོ།",
    "ཉོན་མོངས་བུད་ཤིང་རྣམས་བསྲེགས་ཤིང་།",
    "ལྟད་མོ་དཀའ་སྤྱད་སྟོན་པ་དང་།",
    "གང་གི་ཕྱིར།",
    "སྲིང་མོ་ནི་རྡོ་རྗེ་ཐོག་པ་ལ་ཡང་དག་པར་ཞུགས་པ་སྟེ།",
    "དེ་དག་གི་ཆོ་ག་སྟེ་ཕྱག་རྒྱ་དང་།",
    "གང་གི་ཕྱིར་ཡང་གསུངས་པ་ཇི་སྲིད་ཁུ་བ་ལྡན་གྱུར་པ།",
    "འདིར་བྲམ་ཟེ་མོ་དང་རྒྱལ་རིགས་མོ་དང་རྗེའུ་རིགས་མོ་ད་ང་དམངས་རིགས་མོ་རྣམས་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་རིགས་ཅན་མ་རྣམས་སོ།",
    "བདུད་རྩི་རྡོ་རྗེ་མོ་ནི་རྒྱལ་རིགས་མོ་ཁོ་ན་སྟེ།",
    "བ་ལང་རྫི་མོ་ཡང་དམངས་རིགས་མོའོ།",
    "གཏི་མུག་གི་༴",
    "ཞེ་སྡང་གི་རིགས་སུ་ཕྲ་མ་དང་ཕྲག་དོག་ད་ག་ཡང་ན་སྟེ་ཞེ་སྡང་ལས་བྱུང་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འདུས་པར་ཡང་རྡོ་རྗེ་གསུམ་མི་ཕྱེད་པའི་ངོ་བོར་རྣམ་པར་གཞག་སྟེ་ཁྱོད་རྣམས་ཀྱིས་སེམས་ལུས་ཀྱི་རྣམ་པར་བསྐྱེད་ཅིག་ཅེས་པ་ལ་སོགས་པས་ས་སོ།",
    "ཕུང་པོ་ལྔ་རྣམས་ནི་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་དང་༡རྣམ་པར་ཤེས་པ་རྣམས་ས་སོ།",
    "ཚངས་པ་ལ་སོགས་པའི་ཚིག་རྣམས་རང་གི་གཞུང་ལུགས་སུ་མ་གྲགས་པ་ཉིད་ཀྱི་ཕྱིར་དོན་གསུངས་པ།",
    "དེ་ནི་རང་གི་ངོ་བོས་མྱ་ངན་ལས་མ་འདས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་དེ་ལ་རྒྱུན་གྱིས་གནས་པ་ཉིད་ཀྱི་ཕྱིར་ཐམས་ཅད་དོ་ཞེས་པའི་དོན་ཏོ།",
    "འདི་ཐམས་ཅད་གང་གི་བདག་ཉིད་ཡིན་པ་དེ་ཁོ་ན་ཉིད་དེ་ནི་ད་དུང་ཡང་མི་ཤེས་སོ་ཞེ་ན་གསུངས་པ། ༐",
    "འོ་ན་ལྷའི་ཁྱད་པར་རྣམས་བསྒྲུབས་ཟིན་མོད།",
    "ལུས་ལ་འབྱུང་ཞེས་པ་ལྷ་སྟེ་ཡི་གེ་བསྣན་པ་དང་ཕྱིས་པ་ད་ག་གིས་སོ།",
    "རེག་མིན་ཞེས་པ་སྟོང་པ་ཉིད་དང་རོ་གཅིག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འབྲི་བ་ནི་རི་མོ་སྟེ་རྡུལ་དང་འདམ་ལ་སོགས་པ་རྣམས་ལ་རྐང་པའི་གཟུགས་བརྙ་ན་ནི་རྐང་པའི་རི་མོའོ།",
    "སོར་མོ་ཉེད་པའང་དེ་བཞིན་ན་ནོ།་།",
    "བདེ་དེ་རང་གིས་ལོངས་སྤྱད་བྱ།",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་དང་པོའོ།",
    "དེ་ལ་ནང་གི་ལུས་ནི་མིག་ལ་སོགས་པ་ལྔའོ།",
    "ཕྱིའི་ལུས་ནི་རང་གི་ལུས་ལས་ཕྱི་རོལ་གྱི་གཟུགས་ལ་སོགས་པ་ལྔའོ།",
    "ཚོར་བ་ལ་སོགས་པ་རྣམས་ཀྱི་གསུམ་ཉིད་ནི་ལུས་རྣམ་པ་གསུམ་རྣམས་ལ་དམིགས་པའི་བྱེ་བྲག་གིས་ས་སོ།",
    "འདི་ནི་ལུས་སོ་བདག་གི་ལུས་སོ་རྟག་པའོ་མི་རྟག་པའོ་བདེ་བའོ་སྡུག་བསྔལ་བའོ་ཞེས་པ་འདི་ལྟ་བུ་ལ་སོགས་པར་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་ཏེ།་",
    "ཡང་གིས་གདུང་བ་མེད་པ་ཉིད་སྡུད་པར་བྱེད་དོ།",
    "ངེས་པའི་ཚིག་གི་མཚན་ཉིད་ཀྱིས་སོ།",
    "ཤེས་བཞིན་ནི་བྱིང་བ་དང་རྒོད་པ་དག་གི་གཉེན་པོ་སྟེ།",
    "རྨུགས་པ་དང་གཉིད་དག་གི་ཟས་ནི་རྨྱ་བ་དང་མི་དགའ་བ་དང་གླལ་བ་དང་ཟས་ལ་སྙོམས་མ་ཤེས་པ་དང་སེམས་ཞུམ་པ་ཉིད་ཅེས་པ་ལྔ་རྣམས་སོ།",
    "དེ་དག་གི་ཟས་ནི་ཉེ་དུའི་རྟོག་པ་དང་ལྗོངས་ཀྱི་རྣམ་པར་རྟོག་པ་དང་མི་འཆི་བའི་རྣམ་པར་རྟོག་པ་དང་།",
    "དེ་དག་གི་བྱ་བ་ནི་སེམས་རྣམ་པར་མ་ཞི་བར་བྱེད་པའོ།",
    "ཉོན་མོངས་པ་རྣམས་ལས་དབེན་པ།་",
    "ཤིན་ཏུ་སྦྱངས་པ་དང་ཏིང་ངེ་འཛིན་དང་བཏང་སྙོམས་གསུམ་རྣམ་རྣམས་ནི་གང་གིས་གང་ལ་བརྟེན་ནས་གང་ཞིག་ཉོན་མོངས་པ་མེད་པ་ཞེས་པས་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་ཡན་ལག་སྟེ།",
    "གང་ཕྱིར་ཀུན་ནས་ཉོན་མོངས་པའི་རྒྱུ་གནས་ངན་ལེན་གྱི་མི་མཐུན་པའི་ཕྱོགས་ནི་ཤིན་ཏུ་སྦྱངས་པ་སྟེ་དེའི་ཕྱིར་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་རྒྱུའོ།",
    "དེ་རྣམས་ཀྱི་ས་༡ལམ་འདི་ཉོན་མོངས་པ་ལས་རྣམ་པར་གྲོལ་བ་མངོན་དུ་བྱ་བའི་ཆེད་དུ་བསྐྱེད་བར་བྱའོ།",
    "པས་ཀུན་༡ནས་བསླང་བའི་ངག་གིས་དེ་གོ་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "རྟག་པ་ནི་གང་གི་འདོད་པ་ལ་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་སྐད་ཅིག་གཅིག་ཏུ་ཡང་རང་བཞིན་ཡོད་པ་སྟེ།",
    "སྡུག་བསྔལ་དང་ཀུན་འབྱུང་གི་བདེན་པ་དག་ནི་ཟག་པ་དང་བ་ཅས་པ་དག་སྟེ།",
    "ཤིང་གི་རྩ་བ་བཞིན་དུ་སྐྱེ་བ་དང་གནས་པ་དང་འཕེལ་བའི་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གཟུགས་དང་གཟུགས་མེད་པ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་ད་ང་ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་དང་འདོད་པའི་ཁམས་ཀྱི་འཇིག་ཚོགས་དང་མཐར་འཛིན་པར་ལྟ་བ་དག་དང་དེ་དང་མཚུངས་པར་ལྡན་པའི་གཏི་མུག་ནི་ལུང་དུ་མ་བསྟན་པའོ།",
    "རྣམ་པར་གྲོལ་བའི་ཕུང་པོ་ནི་མི་སློབ་པའི་ལམ་མ་མོ།",
    "ངག་གིས་ཏེ་སླུ་བར་བྱེད་པས་བདག་ཉིད་གདུང་བ་སྟེ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་སེམས་ཉིད་ཀྱི་ཕྱིར་དེའི་ཚེ་འདི་ཉིད་དུ་དང་ཕྱི་མར་ར་རོ།",
    "བདག་ཉིད་ཉོན་མོངས་པ་སྟེ།",
    "གང་ལས་ཉོན་མོངས་པ་ཅན་གྱི་སེམས་ཀྱིས་ས་སོ།",
    "དེ་ས་ཏེ་ངག་གི་ཉེས་པར་སྤྱོད་པ་རྣམ་པ་བཞི་དང་བྲལ་བས།",
    "བདག་ཉིད་ཀྱི་རྙེད་པས་ཚིམ་ཞིང་མ་ཞེན་པ་ཉིད་དང་ཚོད་ཤེས་པས་ཉེ་བར་ལོངས་སྤྱོད་པ་ལ་སོགས་པ་ཁ་ན་མ་ཐོ་བ་དང་བྲལ་བ་གང་༢ིཡིན་པ་དེ་ཉིད་དོ།",
    "མི་འཁྱོགས་པ་ནི་ལམ་ལོག་པ་ཡོངས་སུ་སྤངས་པའོ།",
    "འཇམ་དཔལ་གང་གིས་ལུས་ནམ་མཁའ་དང་མཉམ་པར་མཐོང་བ་འདི་ནི་ལུས་ལ་ལུས་ཀྱི་རྗེས་སུ་བལྟ་བའི་དྲན་པ་ཉེ་བར་གཞག་པའོ།",
    "གནས་སྐབས་འདིར་རྣལ་འབྱོར་པའི་མོས་པ་གཙོ་བོ་ཉིད་ཀྱི་ཕྱིར་དང་ཡོན་ཏན་གྱི་རྟེན་དུ་གྲུབ་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་དང་བཅས་པའི་མོས་པ་སྤྱོད་པའི་ས་འདིའོ་ཞེས་རྣམ་པར་གཞག་༢གོ།",
    "གང་གི་ཕྱིར་འདིར་གཞན་གནོད་པ་བྱེད་པ་ལ་ཇི་མི་སྙམ་པ་དང་སྡུག་བསྔལ་དང་དུ་ལེན་པ་དང་།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྫས་སུ་ན་དྲུག་པོ་འདི་རྣམས་མིང་གིས་བཅུར་འགྱུར་ཏེ།",
    "གང་གིས་སྐྱེ་བ་སོ་སོར་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་སྤྱོདཔའོ།",
    "ལས་ལྡོག་པར་བྱེད་པ་དང་ཉོན་མོངས་པ་སེལ་བར་བྱེད་པ་དང་།",
    "གང་གིས་ཉི་མ་སོ་སོའམ་སྐད་ཅིག་སོ་སོར་དེ་རྣམས་ལ་སྤྱོད་པའོ།",
    "མོས་པ་སྤྱོད་པའི་ས་དང་ལྷན་ཅིག་བཅུ་གཉིས་དང་ལས་དང་པོ་པའི་ས་དང་ལྷན་ཅིག་བཅུ་གསུམ་རྣམས་ས་སོ།་།",
    "ས་འདི་རྣམས་ལ་སོ་སོ་རང་གིས་ཇི་ལྟར་རིག་པར་ཕྱི་མ་ཕྱི་མའི་སེམས་ཀྱི་གནས་སྐབས་རྣམས་སུ་རིམ་པས་སྐྱེ་བའི་ཕུལ་དུ་བྱུང་བ་ྱུང་བ་མཆོག་དང་རབ་མཆོག་ལ་སོགས་པའི་དབྱེ་བས་ལྷའི་མིག་དང་ལྷའི་རྣ་བ་དང་གཞན་གྱི་སེམས་ཤེས་པ་དང་སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པ་དང་།་",
    "འདི་ཐམས་ཅད་ནང་གི་ཚུལ་དུ་གསུངས་པ།",
    "འདི་གསུངས་མོད།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་རང་གི་སེམས་ཟླ་བའི་རྣམ་པར་ལྟོས་ཤིག་ཅེས་པ་ལ་གོགས་པའོ།",
    "རང་ལུས་གནས་ཞེས་པ་ལ་སོགས་པ་སྟེ་རང་གི་ལུས་ལས་ལོག་༡པ་མ་ཡིན་པར་འཇུག་པའི་ཕྱིར་རང་ལུས་གནས་པའོ།",
    "ནག་མོ་ཞེས་ཀློག་པ་ལ་ནི་ནག་པོའི་གདོང་ཅན་ཞེས་པ་མིང་གཞན་ཏེ།",
    "གཏུམ་མོ་ཞེས་པ་གཏུམ་བྱེད་མའོ།",
    "རོ་མ་ནི་ངག་གི་ངོ་བོར་ར་རོ།",
    "སྤྲོས་པ་མེད་པའི་རང་གི་ངོ་བོ་རྣམས་ཏེ་སྟོང་པ་ཉིད་དང་རོ་གཅིག་པ་རྣམས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་གཉིས་པའོ།་",
    "གསང་ཆེན་ཞེས་པ་ལ་སོགས་པ་ནི་འདི་སྐད་བདག་གིས་ཞེས་པ་ལ་སོགས་པའི་ངག་གི་དོན་འདིར་ཡང་བསྟན་པར་བྱའོ།",
    "དེར་རི་རབ་ཀྱི་སྟེང་གི་ཁང་པ་བརྩེགས་པར་གནས་པའོ།",
    "ཡང་ན་དེ་ལྟ་ཁོ་ནའི་གསང་ཆེན་དུ་སྟེ་འཁྱུད་པའི་ལྷ་མོའི་བྷ་ག་ལའོ།",
    "ཡང་ན་མཆོག་གི་ཡེ་ཤེས་ཀྱི་ཡུལ་ནའོ།",
    "ཡང་ན་ཕ་རོལ་དགྲ་བོ་ཉོན་མོངས་པ་རྣམས་རྒྱུའི་གནས་སྐབས་སུ་གང་གིས་གསོད་པར་བྱེད་ཅིང་ཆུང་ངུར་བྱེད་པ་སྟེ་མཆོག་གོ།",
    "དགྱེས་པས་ན་ཀྱེ་སྤྱན་མ་ལ་སོགས་པ་མཐའ་ཡས་པའི་ལྷ་མོ་དང་ཡང་དག་པར་སྦྱོར་བའི་བདེ་བ་ཆེན་པོའི་རོལ་པའི་བྱ་བས་དགའ་བར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་མཆོག་ཏུ་བདེ་བ་བསྐྱེད་པའི་སྤྱོད་ཡུལ་ནའོ་། ཐམས་ཅད་བད་ག་ཉིད་ལ་ཞེས་པ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་ཉིད་ཀྱི་ཕྱིར་གསང་ཆེན་ཐམས་ཅད་དོ།",
    "གཞན་ཡང་ར་ཞེས་པ་ལ་སོགས་པའི་ཡི་གེ་བཅུ་དྲུག་གིས་བརྗོད་པར་བྱ་བའི་ཁམས་རྣམས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པའོ་ཞེས་ཉི་ཤུ་རྩ་གཅིག་༐",
    "ཡིད་ཐུབ་༡མཆོག་ནི་༢ཕུལ་དུ་དབྱུང་དུ་མེད་པའི་རྗེས་སུ་ཆགས་པས་ལྷ་མོ་ཐམས་ཅད་ཀྱི་ཡིད་སྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ནི་འདོད་ཆགས་ལ་སོགས་པ་སྤྱོད་པ་རྣམས་རྡོ་རྗེ་སེམས་ད་པའ་ལ་སོགས་པའི་ཆོ་ག་འདོད་པར་འགྱུར་ཞིང་དེ་རྣམས་ཀྱི་འདོད་ཆགས་ལ་མོ་གས་པའི་གཉེན་པོ་རྣམས་ནི།",
    "རང་གི་སེམས་ལས་ཐ་དད་པར་གྱུར་པའི་བརྟན་པ་རྣམས་ཀྱང་མེད་པའི་ཕྱིར་རོ།",
    "དེ་དག་ལས་ཤཾ་བདེ་བ་དང་བར་མཆོག་གང་གི་ཡིན་པ་སྟེ།",
    "མཁའ་འགྲོ་མ་༢རྣམས་ནི་ནང་གི་རྡུལ་གྱི་ངོ་བོ་རྣམས་སམ་རྩ་རྣམས་ཏེ།",
    "གླང་པོ་ཆེ་ལ་སོགས་པའི་སྒྱུ་མ་བཞིན་དུ་མི་བསྐྱོད་པ་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་བུད་མེད་ཀྱིས་གདུལ་བའི་སྐྱེ་བོ་འདུན་པར་བྱ་བའི་ཆེད་དུ་གོ་རཱི་ལ་སོགས་པའི་རྡོ་རྗེ་ལྷ་མོའི་གཟུགས་ཀྱི་སྒྱུ་མ་སྟོན་པའི་ཕྱིར་རོ།",
    "མཁའ་འགྲོ་མའི་སྒྱུ་མ་ལྡོམ་པ་༤རྡོ་རྗེ་འཛིན་པ་ཁོ་ན་འབྲས་བུའི་རྒྱུད་ཀྱི་རང་གི་ངོ་བོ་སྐྲུ་བཞིའི་བདག་ཉིད་ད་དོ།་།",
    "འདི་ཁོ་ན་མཆོག་ཏུ་རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའོ།",
    "འབྲས་བུའི་རྒྱུད་ནི་སྔར་སེམས་ད་པའི་༡སྒྲས་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "དངོས་དང་བརྒྱུད་པས་ནི་ཐུན་མོང་བར་ཞར་ལས་༢བྱུང་བར་བརྗོད་ནས་ད་ལྟ་ནི་གཙོ་བོར་བརྫོད་པ་ར་བྱའོ་༢།",
    "འདི་རྣམས་ལ་མ་ནིང་གི་རྟགས་ཉིད་ནི་ལུང་ཉིད་ད་དོ།",
    "བུད་མེད་རྣམས་ཐམས་ཅད་ནི་རང་གི་གཟུགས་སྒྲིབ་པ་དང་བཅས་པའི་རྟེན་འགའ་ཞིག་སྒྲིབ་པ་ཕྲ་མོར་བྱས་པ་ཉིད་ཀྱིས་དང་༢འགའ་ཞིག་སྒྲིབ་པ་མེད་པ་ཉིད་དུ་ཡོངས་སུ་བསྒྱུར་བ་རྣམས་ཀྱིས་སྒྱུ་མའི་རང་བཞིན་དུ་གྲུབ་སྟེ།",
    "བུད་མེད་དེ་རྣམས་ཐམས་ཅད་ཀྱང་རིམ་པ་གཉིས་ལ་ལྷའི་རང་གི་ངོ་བོར་མོས་པར་བྱའོ་ཞེས་གསུངས་པ།",
    "སྣ་ཚོགས་ཞེས་པ་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པ་སྣ་ཚོགས་པའི་གཟུགས་ས་སོ།",
    "དེ་མཁའ་འགྲོ་མ་སྟེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་རང་གི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་པ་དེ་ལྟར་བརྗོད་པ་བུད་མེད་རྣམས་ལ་དེའི་བདག་ཉིད་དུ་མོས་བཞིན་པ་འདིའོ།",
    "སྟོང་པ་ཉིད་ཀྱིས་ཡོངས་སུ་དག་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་པ་དེ་ལྟར་ལྷག་པར་མོས་པའི་སྤྱན་མ་ལ་སོགས་པ་ལྷ་མོའི་རང་བཞིན་འདི་རྣམས་ཀྱི་རིགས་རྣམས་སུ་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་འཛིན་པ་ལ་སོགས་པ་རྣམས་ཀྱི་གང་ཡང་རུང་བའི་གཟུགས་རང་རང་གི་གཟུགས་མཁའ་འགྲོ་མས་ཡོངས་སུ་བསྐོར་བ་ར་བདག་ཉིད་རྫོགས་པར་བྱེད་པའི་རྣལ་འབྱོར་པས་འགྲུབ་བོ་ཞེས་པ་དགོངས་པའོ།",
    "ཐམས་ཅད་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་རྣམས་སོ།",
    "དེ་བཞིན་ཏེ་སྒྲིབ་པ་གཉིས་ཀྱི་བག་ཆགས་ཆ་ཕྲ་མོ་དང་ལྷན་ཅིག་པ་ཉིད་དུ་གཤེགས་པའི་ཕུང་པོ་ལྔ་པོ་རྣམས་གང་དུ་ཟིལ་གྱིས་གནོན་ཅིང་སྟོང་པ་ཉིད་དུ་བྱེད་པའོ།",
    "ཏིང་ངེ་འཛིན་དེ་ཁོ་ནའི་ཇི་ལྟ་བ་བཞིན་སྙོམས་པར་ཞུགས་པ་ཕྱག་རྒྱ་ཆེན་པོ་དང་ཡང་དག་པར་སྦྱོར་བའི་གོ་འཕང་མཆོག་གི་ངོ་བོ་རྒྱུ་རྡོ་རྗེ་འཛིན་པའི་རང་གི་ངོ་བོ་གསུངས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "གལ་ཏེ་རྣམ་པར་མི་རྟོག་ན་ཅི་ལྟར་དམ་ཚིག་བསྟེན་པ་ལ་སོགས་པ་ལས་རང་གི་རྟོག་པའི་གནས་སྐབས་ཀྱི་ཁྱད་པར་རམ་གཞན་གྱི་དོན་རྫོགས་པར་བྱེད་ཅེ་ན་གསུངས་པ།",
    "རྣམ་མི་རྟོག་པར་མོས་པ་ལའང་སྟེ་གྱུར་པ་ལ་དམ་ཚིག་བསྟེན་པ་ལ་སོགས་པའི་རྟོག་པ་རྣམས་ཐམས་ཅད་རྣལ་འབྱོར་པས་རྫོགས་པར་བྱེད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལ་ལྷག་པར་མོས་པ་ན་ཕལ་ཆེར་གཞན་དོན་ལ་ཕྱིར་ཕྱོགས་པ་སྲིད་ད་དེ།",
    "རྣམ་པར་མི་རྟོག་པར་ལྷག་པར་མོས་པ་བསྟན་པའོ།",
    "རབ་ཏུ་ཞི་བ་ནི་ཉོན་མོངས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་རྒྱུ་དང་འབྲས་བུས་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་སྒྲུབ་པར་བྱེད་པ་དང་ལྡན་པ་དེའི་ཕྱིར་རྡོ་རྗེ་འཛིན་པ་དེ་ལ་ཡང་དག་པར་བསྟོད་པའོ།",
    "དེ་གཉིས་ཀ་རྗོད་པར་བྱེད་པའི་གཞུང་གི་ཚོགས་ཀྱང་ང་ངོ།",
    "གཅིག་གིས་སྒོམ་བྱེད་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "གཅིག་གིས་ཏེ་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་བད་ག་ཉིད་ཀྱིས་སྣ་ཚོགས་པ་རོ་གཅིག་པ་ཉིད་དུ་ཉམས་སུ་མྱོང་ངོ་ཞེས་པས་གཅིག་གིས་མྱོང་བྱེད་དེ་རིན་ཆེན་འབྱུང་ལྡན་ནོ།",
    "དེ་ལ་རྣལ་འབྱོར་ནི་ལྷག་པར་མོས་པ་སྟེ་དེས་སོ།",
    "མཐོང་བྱེད་ལ་སོགས་པ་ལ་སོ་སོར་སྣང་བཞིན་པ་བལྟ་བྱ་ལ་སོགས་པ་ནི་རྡོ་རྗེ་སེམས་ད་པའི་རང་གི་ངོ་བོ་ཁོ་ནར་མོས་པས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "གལ་ཏེ་རང་བཞིན་གྱིས་མཉམ་པར་གཞག་༡པ་ཡིན་ན་འོ་ན་མི་མཉམ་གཞག་པར་ལྷག་པར་མོས་པས་ཅི་བྱ་ཞེ་ན།",
    "གང་གི་ཕྱིར་རྟོགས་པར་མ་གྱུར་ཏོ།",
    "ཕུང་པོར་ཞེས་པའི་རིགས་ལ་གཅིག་གི་ཚིག་ག་གོ།",
    "དེ་མངོན་སུམ་དུ་བྱ་བ་ཉིད་ཀྱི་ཆེད་དུ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ལྷག་པར་མོས་པ་རིགས་ས་སོ།",
    "སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱིས་ཤེས་བྱ་མངོན་སུམ་དུ་བྱ་བའི་རང་བཞིན་ཏེ་དོན་དམ་པ་སྟོང་པ་ཉིད་གང་གི་རང་བཞིན་ཡིན་པའོ།",
    "དེའི་ཕྱིར་མོས་པར་བྱའོ་༐",
    "གང་གི་ཕྱིར་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཆུ་བོའི་རྒྱུན་ཞེས་པ་རིགས་པ་༡གཅིག་གི་ཚིག་དང་དྲུག་པའི་དོན་ལ་མང་པོ་སྟེ།",
    "དེ་སྐད་དུ་མཐའ་དྲུག་གི་རྒྱ་ཆེར་འགྲེལ་དུ།",
    "ནང་གི་དབྱེ་བ་འདི་ཉིད་ནི།",
    "དེ་ཁོ་ན་ཉིད་རྒྱས་པར་ཏེ་རྒྱ་ཆེན་པོ་རབ་ཏུ་རྒྱས་པར་སྟོན་པའི་ངོ་བོས་སྟོན་པ་གང་གིས་རབ་ཏུ་བྱ་བ་དེ་ནི་དེ་ཁོ་ན་ཉིད་རྒྱས་པར་སྟོན་པའི་རབ་ཏུ་དབྱེ་བའོ་ཞེས་པའོ། ༐",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་གསུམ་པའོ།་",
    "མི་འཇིགས་པ་ལ་སོགས་པ་ཡོན་ཏན་མ་ལུས་པ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཕུལ་དུ་བྱུང་བ་དང་ལྡན་པ་འདིར་འགྱུར་རོ་ཞེས་པས་དེ་དང་ལྡན་པའི་ཕྱིར་དེ་རྒྱ་ཆེ་བའི་ངོ་བོ་ཅན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཁ་ཅིག་ཏུ་བཙུན་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་༡བརྗོད་ཅི་ང་།",
    "གང་གི་ཕྱིར།",
    "གལ་ཏེ་ཡང་དེ་བདེ་བ་ཆེན་པོའི་རང་བཞིན་ཡིན་ན་དེ་ཡང་རབ་ཏུ་དགའ་བའི་ས་ནས་རྩོམ་མོ་ཞེ་ན་གསུངས་པ།",
    "ཁྱོད་ཅེས་པ་ཇི་ལྟར་ཞེས་ཉེ་བར་བྱེད་པ་སྟེ།",
    "གང་གིས་ཞེས་པ་སྟེ་ལས་ཀྱི་ཕྱག་རྒྱ་ལ་སོགས་པའི་ཐབས་ལས་སྐྱེས་པས་ཞེས་དགོངས་པའོ།",
    "རང་ལུས་གནས་པས་ཞེས་པ་རིགས་ལ་གཅིག་གི་ཚིག་གོ།",
    "གང་རྣམས་ཀྱིས་གང་རྣམས་ཤིན་ཏུ་བཅིངས་པ་དེ་རྣམས་གདུང་བར་བྱེད་དེ་རང་གི་ཡན་ལག་རྣམས་ཀྱིས་སོ།",
    "མིང་ད་ང་གཟུགས་འཕེལ་བར་སོན་པ་ནི་མིག་ལ་སོགས་པ་སྐྱེ་མཆེད་དྲུག་གི་རྐྱེན་དུ་འགྱུར་རོ།",
    "དེ་ལས་ཚོར་བ་རེག་པ་དང་རྗེས་སུ་མཐུན་པ་བདེ་བ་དང་སྡུག་བསྔལ་བ་དང་བཏང་སྙོམས་ཉམས་སུ་མྱོང་བའི་ངོ་བོའོ།",
    "སྲེད་པ་དང་ལེན་པ་དག་གི་ཁྱད་པར་ཅི་ཞེ་ན།",
    "གང་ཞིག་གནས་སྐབས་ཀྱི་བར་འདི་རྣམས་ལ་རེག་པ་༡ཡིན་གྱི།",
    "འདུ་བྱེད་དང་སྲིད་པ་ལས་ཀྱི་ལམ་མ་མོ།",
    "ཡན་ལག་ལྷག་མ་རྣམས་རྣམ་པར་སྨིན་པའི་ལམ་མོ།",
    "འདིར་ཉོན་མོངས་པ་གཙོ་བོ་སྟེ།",
    "མི་ཤེས་པ་སྤངས་པ་ལས་ཉོན་མོངས་པ་རྣམས་ཀུན་དུ་མི་རྒྱུ།",
    "ཉོན་མོངས་རྣམས་ཀྱིས་མ་རྨོངས་པ།",
    "གང་གི་ཕྱིར་འཆིང་བའི་རྒྱུ་ཡིན་པ་དེའི་ཕྱིར་ཉོན་མོངས་པ་འདི་རྣམས་བསལ་བར་བྱའོ་ཞེས་གསུངས་པ།",
    "ཅི་ལྟར་སྦྱོར་བས་ཉོན་མོངས་པ་རྣམས་གཞོམ་པ་ཡིན་ཞེ་ན་གསུངས་པ།",
    "འོ་ན་འགའ་ཞིག་གི་ཡང་བུད་མེད་ཀྱི་གཟུགས་ཉམས་སུ་མྱོང་བ་ཡང་བཀག་པའི་ཕྱིར་འགལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལ་ལུས་དང་ངག་གི་ལས་ཐམས་ཅད་ནི་ཀུན་ནས་བསླང་བར་བྱ་བ་སྟེ།",
    "ཁྱོད་ཀྱིས་འདོད་པ་ལྔ་ལ་སྤྱོད།",
    "གང་ཞིག་མོས་པས་སྟེན་བྱེད་པ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རེག་པ་ལས་སྐྱེས་པའི་བདེ་བ་ཡོངས་སུ་གྱུར་པ་ནི་བླ་ན་མེད་པའི་འབྲས་བུའི་རྒྱུར་གསུངས་སོ།",
    "རྒྱུའི་དངོས་པོ་རྟོགས་པར་བྱེད་པ་དེའི་ཚེ་བཅོམ་ལྡན་ལྷ་མོ་སྐྱོན་ཅི་ཡང་མེད་དོ་ཞེས་སོ།",
    "ཇི་སྐད་དུ་མཆོག་གི་དང་པོའི་རྒྱུད་དུ་གསུངས་པ།་",
    "གང་གིས་རྨོངས་པ་འཆིང་འགྱུར་བ།",
    "སྟོང་པའི་རྣམ་པ་ཅན་མིག་གིས་། མཐོང་བ་རྣམ་པར་རྟོག་མེད་པའི།",
    "གསུངས་པ་གང་དང་གང་གིས་ཞེས་པ་སྟེ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ངོ་བོས་སོ།",
    "དཔེར་ན་ལྷའི་མེ་དང་ཁྱིམ་བདག་གི་དང་སྦྱིན་སྲེག་ལ་སོགས་པའི་མེ་རྣམས་ཐ་དད་ཀྱང་བུད་ཤིང་རྣམས་དང་རྡོ་དྲེག་གི་གོས་ལ་སོགས་པའི་དྲི་མ་སྲེག་པ་ནི་མེའི་རང་བཞིན་ཐམས་ཅད་ཡིན་པ་བཞིན་ནོ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་ལ་སོགས་པ་གང་རྣམས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ངོ་བོར་ལྷག་པར་མོས་པར་བྱ་བ་དེ་རྣམས་ཀྱང་འདི་ཁོ་ན་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རང་གི་ངོ་བོས་ཀྱང་ཞེས་གསུངས་པ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེ་གསལ་བར་བྱེད་པ་ནི་གཉིས་ཀར་རྩེ་མོ་ལྔ་པའི་རྡོ་རྗེའོ།",
    "གང་གི་ཕྱིར།",
    "འཇོམས་རྟོགས་གཉིས་རྩེ་མོ་ལྔ་པའི་ངོ་བོ་༡རྣམ་པར་ཤེས་པའོ།",
    "འདུ་བྱེད་ནི་ཕྲག་དོག་གི་རང་བཞིན་ཏེ།",
    "ཕྲག་དོག་ཀྱང་སྐུལ་བར་བྱེད་པའི་ངོ་བོ་ཁོ་ནའོ་ཞེས་པས་འདུ་བྱེད་རྣམས་ཕྲག་དོག་གི་ངོ་བོའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཞེ་སྡང་རྡོ་རྗེ་ལ་སོགས་པ་རྣམས་ཕྱག་རྒྱ་ཆེན་པོ་ད་ང་ཡང་དག་པར་སྦྱོར་བ་མཆོག་གི་གོ་འཕང་རྣམས་སུ་བརྗོད་པར་བྱ་སྟེ།",
    "བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ནི་གང་གིས་དེ་ལྟར་སོ་སོར་བརྟགས་པའི་འགྲོ་བའི་བྱ་བ་རྗེས་སུ་བསྒྲུབ་པར་མཛད་པའོ།",
    "དོན་དམ་པར་ནི་ཡེ་ཤེས་ལྔ་རྣམས་ཐ་དད་པ་དང་ཐ་མི་དད་པ་ལ་སོགས་པའི་སྤྲོས་པ་མཐའ་དག་གིས་སྟོང་པ་ཉིད་ཁོ་ནའོ།་།",
    "མིག་ནི་གཏི་མུག་རྡོ་རྗེའོ་ཞེས་པ་ལ་སོགས་པས་ནང་གི་བདག་ཉིད་ཀྱི་སྐྱེ་མཆེད་རྣམ་པར་དག་པའི་རང་བཞིན་དུ་འཆད་པར་འགྱུར་བ་རྣམས་དང་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་ཕྱིའི་སྐྱེ་མཆེད་གཟུགས་ལ་སོགས་པ་རྣམ་པར་དག་པའི་རང་བཞིན་རྣམས་དང་།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་སེམས་ནི།",
    "གང་གི་ཕྱིར་འདི་ལྟར་ཡིན་པ་དེའི་ཕྱིར་ཟུར་གསུམ་འདིར་ཏེ།",
    "ཨེ་ཡིག་གི་དབྱིབས་ཅན་ཉིད་དུ་སྟེ་གྲུ་གསུམ་ཉིད་ཀྱི་ཕྱིར་ར་རོ།",
    "དབུས་སུ་ཝཾ་ཡིག་གིས་བརྒྱན་པ།",
    "རི་གཱི་ལྷ་མོ་རོལ་བ་ནི་རྡོ་རྗེ་འཛིན་པའོ་༢ཞེས་ས་སོ།",
    "ངག་གི་རང་བཞིན་ཐམས་ཅད་ཀྱི་ཡང་ངོ་ཞེས་སྐབས་སུ་བབ་པ་བརྗོད་པ་གསུངས་པ་དེའི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "པདྨ་ནི་འདིར་སྐྱེས་པ་དང་བུད་མེད་དག་གིའོ།",
    "དགུ་པ་ནི་མཁའ་འགྲོ་གདོང་གི་རྩའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་རང་བཞིན་མེད་པ་ཉིད་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡེ་ཤེས་དག་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གྱེན་དུ་རི་མོའི་རྣམ་པར་བྲིས་པ་ནི་ནཱ་ད་རུ་བརྗོད་དོ།",
    "མེད་ཅེས་པ་ལ་སོགས་པ་སྟེ་གང་གི་ཕྱིར་མ་སྐྱེས་པའི་རང་བཞིན་ནི་ཤིན་ཏུ་བརྟན་པར་མི་སྐྱེ་བར་མོས་པ་ལ་ཐམས་ཅད་སྔགས་ཁོ་ནའོ་ཞེས་པ་དགོངས་པའོ།",
    "ཅེས་པ་ཤེས་རབ་དང་ཐབས་དག་གི་སྐྱེ་བ་གང་གིས་མཚོན་པར་བྱ་བ་དེའོ།",
    "ཐབས་ཆེན་པོ་ཞེས་པ་ཐབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་རང་གི་ངོ་བོའོ།",
    "སྣ་ཚོགས་གཟུགས་ནི་སྤྲུལ་པ་སྣ་ཚོགས་ཀྱིས་སྤྲོ་བའི་ཕྱིརེ་རོ།",
    "འདིར་༡ནི་བུད་མེད་དང་སྐྱེས་པ་དག་གི་ལྟེ་བའི་འོག་གི་གནས་ནི་སྐྱེ་གནས་ཏེ།",
    "ཨེ་ཝཾ་མཱ་ཡཱ་ཡི་གེའི་བརྗོད་པར་བྱ་བའོ་ཞེས་པ་བརྗོད་པར་བྱ་བ་དང་རྗོད་བྱེད་དག་དབྱེར་མེད་པར་མོས་པས་བསྐྱེད་པའི་རིམ་པ་ལ་ཁ་ཅིག་ཏུ་ཨེ་ཝཾ་མཱ་ཡའི་ཡི་གེའི་རང་གི་ངོ་བོ་རྣམས་དང་།",
    "ཨེ་ཡིག་གིས་ནི་ཞེས་པ་ལ་སོགས་པའོ།",
    "གྱེན་དུ་ལྟ་བའི་ལྟེ་བའི་ཆུ་སྐྱེས་དང་འོག་ཏུ་ཕྱོགས་པའི་སྤྱི་བོའི་མཚོ་སྐྱེས་ནི་ཨེ་ཡིག་སྟེ་ཨེ་ཡིག་གི་དབྱིབས་ཅན་གྲུ་གསུམ་ཤེས་རབ་ཀྱི་རང་བཞིན་དུ་མོས་པར་བྱའོ།",
    "གང་ལས་བདག་གིས་ཐོས་པའོ།",
    "གང་གི་ཕྱིར་འདི་སྐད་ཤེས་རབ་ད་ང་ཐབས་ཀྱི་བདག་ཉིད་འདོད་ཆགས་ཆེན་པོ་བདེ་བ་ཆེན་པོའི་ངོ་བོ་བཅོམ་ལྡན་འདས་རྒྱུད་འདིར་རྟག་ཏུ་སྟེ་རྒྱུན་མ་ཆད་པ་ཉིད་དུ་བརྗོད་བར་བྱ་བ་ཉིད་ཀྱིས་༢གནས་ཤིང་དེའི་རྗོད་པར་བྱེད་པ་ཡང་རྒྱུད་དོ་ཞེས་ལྡན་པར་གསལ་བར་བྱེད་དོ།",
    "གང་གི་ཚེ་སྟོན་པ་པོ་ལས་རྒྱུད་ཐ་དད་པར་ཉན་པ་པོ་དང་སྡུད་པ་པོ་གདུལ་བྱའི་ངེས་པ་ལས་འགྱུར་བས་ནའོ།",
    "དེ་ནི་མི་དག་གི་སྟེ་བུད་མེད་དང་སྐྱེས་པ་དག་གི་སྣ་སྟེ།",
    "དེ་ཉིད་རྩེ་མོ་སྟེ།",
    "སོངབ་དང་ནི་ཕྱིར་སོང་བ་ཐིག་ལེ་མེ་བཞིན་དུ་ཡོངས་སུ་གདུང་བ་སྡུག་བསྔལ་གྱི་སྟེ་སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པ་ཉམས་སུ་མྱོང་བས་འབབ་པ་ནི་གལ་ཏེ་བདེ་བ་སྟེ་ཡོངས་སུ་གདུང་བའི་ཕྱིར་རོ།",
    "བསམ་གྱིས་མི་ཁྱབ་ཉིད་གྱུར་ནི་བཞི་པའི་སྐད་ཅིག་གི་ངོ་བོ་འོ།",
    "མི་དམིགས་སོ་ཞེས་པ་གང་གི་ཕྱིར་མེད་པར་དགག་པ་ཙམ་ནི་ཀུན་རྫོབ་ཏུ་ཡང་༡མ་ཡིན་ནོ་ཞེས་གཞན་དུ་བསྒྲུབ་༢ཟིན་ཏོ།",
    "ཅི་ལྟར་ཞེ་ན་གང་གི་ཕྱིར།",
    "རོ་སྟེ་རང་བཞིན་འདིའི་མཉམ་པའོ་ཞེས་པ་རོ་མཉམ་མོ།",
    "ཕུན་སུམ་ཚོགས་པ་གང་གིས་ན་མང་པོ་རྣམས་ཀྱིས་བསྟེན་པར་བྱ་བ་དེ་ནི་དཔལ་ཏེ།",
    "གཞན་གྱི་དོན་རྣམ་པ་ཐམས་ཅད་པ་ལ་ལོངས་སྤྱོད་རྫོགས་པ་དང་སྤྲུལ་པ་པའི་སྐུ་ད་ག་གིས་རྟག་ཏུ་ལྡོག་པ་མེད་པའི་བྱ་བ་ཅན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་མཐའ་དག་བཙུན་མོ་དང་ལྷན་ཅིག་ཅེས་པ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཐམས་ཅད་ཀྱང་ཡིན་ལ་བཙུན་མོ་རྣམས་ཀྱང་ཡིན་པ་སྤྱན་མ་ལ་སོགས་པ་རྣམས་ཏེ།་",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པ་ཡོངས་སུ་མ་ཉེས་པའི་དོན་དུ་དེ་བཞིན་གཤེགས་པ་རྣམས་རང་གི་རིགས་དང་རྗེས་སུ་མཐུན་པའི་བུད་མེད་ལྷ་མོའི་གཟུགས་སུ་སྤྲུལ་པར་མཛད་དེ།",
    "རིག་མའི་ཚོགས་འཇུག་པ་བུད་མེད་ཀྱི་ཡོན་ཏན་ལྷག་པ་ཕུན་སུམ་ཚོགས་པ་སྐྱེས་པས་ཤིན་ཏུ་དགྱེས་པ་བསྐྱེད་པའི་ཆེད་དུ།",
    "སྟོང་པ་ཉིད་ཁོ་ན་ཉོན་མོངས་པ་མཐའ་དག་འཇོམས་པ་པོའོ།",
    "དེའི་ཕྱིར་ཉོན་མོངས་པའི་སེམས་སྤངས་པ་ལས་དག་པའི་སེམས་ཏེ་དག་པའི་ཤེས་རབ་ཡེ་ཤེས་དོ།"
  ]
}