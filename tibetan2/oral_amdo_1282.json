    "དེ་ནི་ཐུན་མོང་བསྲུང་བྱ་སྟེ།",
    "ཁྱབ་པར་རྒྱུ་བའི་ཚུལ་དག་གིས།",
    "ཁ་དོག་ཡན་ལག་ཉིང་ལག་གིས།",
    "བརྗོད་དང་ཚིག་གིས་ཕེབས་པ་མིན།",
    "གང་གིས་སྦྱིན་པར་མི་ནུས་པ།",
    "ད་ལྟར་ནུས་པ་རང་གིས་མྱོང་།",
    "རང་གི་རྩ་བཅུད་སོ་སོ་ལས།",
    "བདག་གིས་ཤེས་བྱའི་དམ་ཚིག་ཡིན།",
    "རེག་ལྟར་ཤེས་པའི་དམ་ཚིག་ནི་། གཉིས་སུ་མེད་པའི་དམ་ཚིག་ཡིན།",
    "ཡང་དག་དོན་སྟོན་ལ་སོགས་པ་། གསུང་གི་དམ་ཚིག་བརྒྱད་པོ་ཉིད།",
    "ཟབ་མོ་དག་ལ་གེགས་འབྱུང་དང་།",
    "རང་གིས་ཉམས་པ་མ་ཚོར་ཞིང་།",
    "བདག་གི་ས་བོན་ཚིག་པ་སྟེ།",
    "མཆོག་དང་ཐུན་མོང་ལ་སོགས་པ།",
    "ཐུན་མོང་དག་ལ་མོས་ཞུགས་པས།",
    "ཐུན་མོང་ཡོ་བྱད་ཏིང་འཛིན་དང་།",
    "ཟག་བཅས་ཐུན་མོང་དངོས་གྲུབ་ཡིན།",
    "གང་དུ་མཆོག་གི་རྣལ་འབྱོར་པ།",
    "མཆོག་ལྡན་མཆོག་གིས་མཆོག་ཐོབ་པས།",
    "མཆོག་གི་དངོས་གྲུབ་ཐུན་མོང་མིན།",
    "གཅིག་༩དང་ལྔ་གསུམ་གང་ཟག་གིས།",
    "ཆེ་གེ་མོ་ཞིག་ཛ་ཧཱུྃ་ཞེས།",
    "བདེན་པ་བདར་ཞིང་ངག་གིས་བཅིང་།",
    "རོལ་མོ་སྒྱུ་མཁན་དག་དེ་ཡིས།",
    "སྣ་ཚོགས་ཁྲོ་བོ་ཁྲོ་མོ་ཡིས།",
    "ཐུགས་ལས་ཆུ་ཡི་ལྷ་མོ་བསྐྱེད།",
    "བུམ་པར་ལྷ་མོ་འོད་དུ་ཞུ།",
    "སྔོན་དུ་བྱ་བ་སྔོན་སོང་བས།",
    "ཕོ་མོ་ལ་སོགས་ཡིན་པ།",
    "༤༦༥རང་གི་རྟོག་པ་ཇི་བཞིན་དུ།",
    "ལྷ་མོ་ཡིད་འོང་འོད་འབར་མ།",
    "དང་པོའི་རྟགས་ནི་ཡིན་པར་བཤད།",
    "ༀགྱི་འོད་དང་ཨ་མྲྀ་ཏས།",
    "༡༢ཞིང་། ཧ་ཡ་གཱི་བས་གད་མོས་བསྡིགས།",
    "ཧེ་རུ་ཀ་ཡི་ཞབས་ཀྱིས་གནོན་། རྟ་མགྲིན་༡༩གད་མོ་དྲག་པོས་བསྡིགས།",
    "ཡང་ན་བདག་གི་འོག་ཏུ་གནོན།",
    "ཕྲ་མོ་དེར་ནི་ལྷུང་བར་འགྱུར།",
    "འཕྲུལ་གྱི་འོ་མ་དག་གིས་སྦྱར།",
    "རང་གི་བསམ་པ་བསྒྲུབ་པར་བྱ།",
    "ཕྱིན་པ་མེད་པར་མཐར་སོང་བ།",
    "ཟབ་མོ་ཀུན་རྫོགས་བརྟུལ་ཞུགས་ཅན།",
    "ལྷ་མོ་རྣམས་དང་ལྷན་ཅིག་ཏུ།",
    "དངས་སྙིགས་ཕྱེ་བའི་ཉམས་དག་གིས།",
    "ཐུན་མོང་ཁྱད་པར་ཡོན་ཏན་རྫོགས་། བྱ་བའི་ལས་ལ་མ་རྨོངས་ཤིང་།",
    "དུག་གསུམ་ཐལ་ཆེན་ཚ་བའི་མར།",
    "ཕྲ་མོའི་ལས་རྣམས་སྨོས་ཅི་དགོས།",
    "ཨོཾ་ཆེ་གེ་མོ་ཤཱིནྟཾ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "སྭཱ་ཆེ་གེམོ་པུཎྚི་ཀུ་རུ་སྭཱ་ཧཱ།",
    "ཧཱི་ཆེ་གེ་མོ་པཱ་ཤཾ་ལིངྒའི་གནས་ཀྱང་ལས་བཞིའི་ཧཱུྃ་ཆེ་གེ་མོ་མཱར་ཡ་ཕཊ།",
