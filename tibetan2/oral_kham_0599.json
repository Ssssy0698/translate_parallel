    "དེ་མ་ཐག་ཏུ་བཤགས་པ་གལ་ཆེ་བར་འདུག་གོ།",
    "དེ་ནས་སྲོད་ལ་དགེ་སྦྱོར་བག་ཙམ་བྱས་ནས་གཉིད་ལོག་འདུག་ནས་ནངས་པར་ང་དང་ཕྲད་དུ་བྱུང་ཙ་ན།",
    "ཕྱུགས་ཀྱི་འདྲེ་བརྡུང་ཨེན་ཙམ་འཆོལ་བ་གཅིག་ཡོང་བར་འདུག་བྱས་པས།",
    "དེའང་ལས་ངན་གྱི་རྣམ་སྨིན་འདི་འཇིགས་པར་འདུག་པས།",
    "སྣང་བ་བདེན་མེད་དུ་རྟོགས་པར་མ་གྱུར་པར་གདོན་དང་སྨྱོ་བ་བཏུལ་བར་གྲིབ་དང་འགྲས་ཆེན་པོ་འོང་བར་འདུག་པས།",
    "རྒྱལ་པོ་འདི་གཏན་ནས་བརླག་པ་གཅིག་བྱེད་དགོས་སྙམ་ཙ་ན་སློབ་དཔོན་པད་མ་བྱོན་ནས།",
    "ང་རང་ནམ་འཆི་མི་ཤེས།",
    "ཡང་ན་ཚོང་འདུས་ཀྱི་འོ་མར་འགྲོ་བར་འདུག་པས།",
    "གཟིམ་ཆུང་ན་མཁའ་འགྲོ་མ་མང་པོ་འདུག་མི་མ་ཡིན་མང་པོ་ཡང་འདུག་པས།",
    "ང་རང་ཡང་མངོན་དགར་འགྲོ་དགོས་སྙམ་ཙ་ན་གཉིད་སད་དོ།",
    "ཁོང་རྣམས་ཀྱིས་ང་ལ་གསང་འདུག་ནས།",
    "ཡང་ཚེས་བཅུ་བཞིའི་ཉི་མ་ཕྱེད་ཡོལ་ཙ་ན་བཅུ་གཅིག་ཞལ་བྱོན་ནས།",
    "སྔ་དྲོ་ན་བསགས་པས་ད་ཚོགས་སམ་བྱས་པས་ཚོགས་གདའ་ཟེར།",
    "སང་ན་སར་ཐུག་ཙ་ན་ཤ་བ་ཉུང་མས་སྣང་བ་བཞིན།",
    "རྩེ་གཅིག་སྒྲུབ་པ་བྱེད་པའང་མི་འོང་བར་འདུག་གོ།",
    "འོ་ན་དར་རྒུད་འོང་བ་གདའམ་ཞུས་པས།",
    "དེ་ལ་སོགས་པ་ཞུས་ན་མང་པོ་འབྱོན་པར་འདུག་སྟེ།",
    "བླུན་པོ་ཅོལ་ཆུང་སྡར་མའི་ངང་ཚུལ་རང་བྱོན་དུ་འདུག་གོ།",
    "ཚུལ་འདི་བསམ་ཞིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམ་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཕུང་བོ་ལྔ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུ་ཡང་མེད་པའི་ཕྱིར།",
    "དེས་བདག་དང་ཕུང་བོའི་སྟེང་དུ་ཡང་རང་བཞིན་གཅིག་དང་ཐ་དད་ཁེགས་པ་ན་རང་བཞིན་ཙམ་དུ་འཛིན་པའི་སྒྲོ་འདོགས་སེལ་བ་ཡིན་ནོ།",
    "གང་ཟག་རང་རྐྱ་བ་དང་རང་བཞིན་གཞན་དུ་མེད་དེ།",
    "གང་ཟག་རང་རྐྱ་བ་དང་རང་བཞིན་གཅིག་ཏུ་མེད་དེ།",
    "སྒྲ་མི་རྟག་པར་ཡང་རང་ལུགས་ལ་དམ་བཅའ་མི་ནུས་པར་རྟོག་ངོ་ཙམ་དུ་ཡོད་པར་ཁས་ལེན་པ་ནི།",
    "སྤྱི་མཚན་གཟུང་ཡུལ་དུ་བྱས་པ་དང་རང་མཚན་གཟུང་ཡུལ་དུ་བྱས་པ་གཉིས་མཐོང་ཞིང་།",
    "དེ་ཡང་རང་བཞིན་དང་འབྲས་བུའི་རྟགས་ཀྱིས་ཁྱབ་བྱེད་དུ་གོ་བར་བྱེད་པ་ནི་འདོད་པ་ཙམ་གྱིས་ལྡོག་པ་མིན་ནོ་ཞེས་བསྟན་པའི་དོན་དུ་རྟགས་ཡང་དག་གཉིས་བཀོད་དེ།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་གཉིས།",
    "རང་ཡིན་དང་རང་མ་ཡིན་དང་རང་ཡིན་སོགས་ཤིན་ཏུ་ཁས་ལེན་དགོས་ཤིང་།",
    "སྔ་རྒོལ་མེད་པའི་གང་རང་ཉིད་ལ་དུ་བས་དུ་ལྡན་ལ་མེ་ཡོད་དུ་སྒྲུབ་པའི་ཚེ་དུ་བ་ལྟ་བུ་དང་།",
    "རང་རང་སྐུ་ཡི་དབྱིབས་དང་ཕྱག་མཚན་སོགས།",
    "རང་རང་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཡི།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མེད་པ་ཀུན་རྫོབ་ཀྱི་བདེན་པ་དང་།",
    "སྟོན་པ་དངོས་ཐུབ་པ་ཡིན་ཡང་རང་ཉིད་ཀྱི་གཞན་ལ་སྡུག་བསྔལ་ཞི་བའི་ཐབས་རྫོགས་པར་སྟོན་ནུས་པ་ལ།",
    "དེ་ཡང་རང་མ་ཡིན་དུ་མ་འདུས་པའི་བསགས་པ་ལ་དམིགས་པ་མ་ཡིན་གྱི།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཡང་རང་རིག་པའོ་ཞེས་པ་སྟེ།",
    "དེས་ན་རྟོག་པའང་རང་རིག་མངོན་སུམ་གྱི་མྱོང་བྱ་ཡིན་པས་རང་རིག་ཉིད་དུ་བཏགས་པ་ཡིན་གྱི།",
    "དེའི་མྱོང་བྱེད་འཛིན་པའི་རྣམ་པ་ཡང་རང་རིག་མངོན་སུམ་ཉིད་དུ་འདོད་པས་དེ་ལ་དངོས་མིང་འཇུག་པ་ཡིན་ནོ།",
    "སྒོའི་བུ་གུ་ན་ནོར་བུའི་འོད་འདུག་པ་མཐོང་བའི་ཚེ།",
    "དོན་ཁས་བླངས་ཀྱང་རང་བཞིན་འབྲས་བུར་རིགས་པ་དང་།",
    "སྣང་བ་དེ་གཉིས་ལས་གང་རང་རིག་པ་དེ་ནི་འབྲས་བུར་འགྱུར་རོ།",
    "དེ་ཡང་རང་རིག་དང་མངོན་སུམ་རྟོག་པ་མེད་པ་ངེས་པར་ཁས་བླང་བར་བྱའོ།",
    "ཡང་རང་འགྲེལ་དུ།",
    "ཐུབ་པའི་བསྟན་པ་ལ་ཅོ་འདྲི་ཞིང་རང་གཞན་ཀུན་ཕུང་བར་བྱེད་པར་ཟད་དོ།",
    "ཁྱད་པར་མཐོང་བ་གཉིས་ཉིད་དང་རང་བཞིན་དང་རྣམ་འགྱུར་དང་།",
    "ཁོ་ན་དང་རང་ཉིད་ནི།",
    "སྒྲ་ཉིད་ཀྱི་སྤྱི་བཞིན་ཞེས་པ་བྱེ་བྲག་པ་རང་རང་བསྒྲུབ་བྱ་ལ་ངེས་ཤེས་བསྐྱེད་ཅིང་།",
    "དེ་ལ་ཡང་རང་མཚན་གྱིས་ཁྱབ་པ་ཡིན་ཏེ།",
    "གསལ་རྫས་ཐ་དད་དུ་ཁས་བླངས་པས་རྒྱལ་པོས་བསྐོས་པས་མི་ལ་མི་དེ་ནི་ང་རང་ངོ་ཞེས་འབངས་ལ་རྒྱལ་པོར་བཏགས་པ་བཞིན་དུ།",
    "རྣམ་རྟོག་དེ་ཡང་རང་རིག་མངོན་སུམ་གྱི་མྱོང་བྱ་ཡིན་པས་ན་སྟེ་ཡིན་པའི་ཕྱིར་རོ།",
    "འགྱུར་འདི་མ་གཏོགས་རྩ་བ་དང་རང་འགྲེལ་གྱི་འགྱུར་གཞན་ཡོད་པར་གྲགས་ནའང་མ་རྙེད་ཅིང་།",
    "ཁྱབ་བྱེད་མ་དམིགས་པའི་རྟགས་འཇུག་དུས་དང་།",
    "རང་བཞིན་འགལ་དམིགས་དང་རང་བཞིན་མ་དམིགས་པ་གཉིས་ཀྱིས།",
    "འོ་ན་ཁྱེད་རང་ལ་ཡང་ཚུལ་གཉིས་ཀྱི་མཚན་གཞི་གང་ཡིན།",
    "ཁྱེད་རང་འདོད་པ་ལྟར་གྱི་དེའི་ལྡོག་ཁྱབ་མ་གྲུབ་པས་མ་ཁྱབ་པ་ཉམས་སོ།",
    "འོ་ན་ཁྱེད་རང་ལྟར་ཡང་འབྲེལ་བ་ཤེས་ཟིན་མ་བརྗེད་ན་བརྗོད་མི་དགོས་ལ།",
    "ཁྱབ་པ་བརྗོད་མི་ནུས་ང་ཁྱེད་རང་འདོད་པས་གཞུང་ཕྱི་མ་དང་འགལ་ལོ་ཞེ་ན།",
    "ཁྲ་བོ་ལ་ཡོད་པའི་ན་སེར་སྐྱ་ལ་ཡོད་པར་འགལ་བའི་དོན་དུ་སྨྲ་བར་བྱེད་ཅིང་དངོས་པོ་དང་རང་མཚན་དོན་གཅིག་པས་རྟགས་ཡང་དག་ཡིན་ན་དངོས་པོ་མིན་པར་འཆད་པར་བྱེད་དོ།",
    "དངོས་པོ་ལ་ས་མ་ཁྱབ་པས་གཏན་ཚིགས་བྱས་པ་སོགས་དངོས་པོ་ཡིན་ཡང་རང་མཚན་མིན་པས་དཔེ་ལ་རྗེ",
    "སྒྲ་དང་གྲུབ་བདེ་རྫས་གཅིག་ལ་ངེས་མ་ངེས་ཆ་གཉིས་འདུག་པའི་ཕྱིར།",
    "ངེད་ལ་བཀོད་པའི་ཉེས་པ་ཁྱེད་རང་ལ་ཡང་མཚུངས་སོ་ཞེ་ན།",
    "སྤྱི་དོན་གཞན་མེད་པའི་རྫས་ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས་རང་འབྲས་གཅིག་བསྐྱེད་པར་ངེས་ཏེ།",
    "དེ་ཡང་རང་སྤྱིའི་རྣམ་དབྱེ་ལ་མི་མཁས་པས་ནོངས་སོ།",
    "གལ་ཏེ་སྤྱི་འཛིན་གྱི་སྣང་བས་དོན་བརྡ་བྱས་ཀྱང་རང་མཚན་ལ་མི་བསླུ་བར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟར་ན་དེ་མ་ཡིན་རྣམ་པར་བཅད་པ་ཡང་རང་མ་ཡིན་བཅད་པའི་སྒོ་ནས་བརྗོད་དགོས་པ་སོགས་ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ནུས་པ་འཇུག་པ་ཡང་རང་བཞིན་ཤིན་ཏུ་ཐ་དད་པ་ཁོ་ནར་འགྱུར་བས།",
    "འོ་ན་ཁྱེད་རང་ལྟར་ན།",
    "རང་བཞིན་དེ་གཉིས་གཅིག་པ་ཡིས་རྒྱུ་དུ་མ་གནས་སྐབས་ཐ་དད་ཀྱང་རང་བཞིན་གཅིག་ཡིན་པས།",
    "ཁྱབ་བྱེད་མ་དམིགས་པའི་རྟགས་འཇུག་དུས་ནི།",
    "གཞན་དག་ཡི་གེའི་ངོ་བོ་མི་འགྱུར་བར་འདོད་ཅིང་རང་ལུགས་གདངས་ཀྱི་རྣམ་པ་གཞན་དུ་མི་འགྱུར་བའི་དོན་ཡིན་ནོ།",
    "བུམ་པའི་དངོས་པོ་དང་དེའི་འཇིག་པ་བུམ་པའི་དངོས་པོར་མེད་པ་དག་དུས་མཉམ་དུ་ལྷན་ཅིག་ཏུ་ཡོད་པར་འགྱུར་ལ།",
    "འོ་ན་ཁྱེད་རང་ལ་ཡང་བུམ་པ་ཕྱིས་ཞིག་ནས་མེད་པར་འགྱུར་རོ།",
    "ཆོ་ག་ལ་སོགས་པ་གསར་དུ་རྩོམ་ཤེས་ཤིང་རང་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་འབྲས་བུ་འབྱིན་ནུཔཱུ་བྱིན་གྱིས་རློབ་པའི་མཐུ་དག་དང་ལྡན་པའི་སྐྱེས་བུ་ཡིན་པའི་ཕྱིརཁྱབ་སྟེ།",
    "འོ་ན་ཁྱེད་རང་ཡང་།",
    "ཐ་སྙད་ཀྱི་ཁྱད་པར་ཅི་འདུག་སོམས་ཤིག་མིག་མི་གཡོ་བར་གནས་པ་ན་གཟུགས་རིམ་གྱིས་འཛིན་ཡང་།",
    "ཁྱེད་རང་སྒྲུབ་བྱེད་དུ་འདོད་པ་ལ་ཡང་བརྟག་པ་དེ་མཚུངས་སོ་ཞེ་ན།",
    "བདག་དུས་ཕྱོགས་ནམ་མཁའ་བཞིའོ།",
    "འབྲས་བུ་མི་སྐྱེད་པ་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "འོ་ན་ཁྱེད་རང་ལ་ཡང་ས་སོགས་མྱུ་གུ་མི་སྐྱེད་པའི་སྐབས་དང་ཁྱད་པར་མེད་པས་མྱུ་གུ་མི་སྐྱེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འབྲས་བུ་མི་སྐྱེད་པ་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "འགལ་རྐྱེན་གྱིས་བཅོམ་པས་འབྲས་བུ་མི་སྐྱེད་པ་ཁྱེད་རང་ཡང་འདོད་པས་སོ་ཞེ་ན།",
    "རྟེན་མི་བརྟེན་པ་ཉིད་དུ་འགྱུར་ན་ཁྱད་པར་དག་མཐའ་མེད་དུ་མི་འཕེལ་ཡང་རང་བཞིན་དེ་འདྲ་མིན་པའི་ཕྱིར།",
    "གཞན་དུ་ན་ཁྱེད་རང་ལ་ཁས་བླངས་འགལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཡང་ན་ཕུང་བོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་དུ་མེད་པ་དེ་རང་བཞིན་མེད་པས་ཁྱབ་སྟེ།",
    "ཞེན་བྱེད་ཀྱི་བློ་དང་རང་བཞིན་གཉིས་བེམ་པོ་དང་།",
    "འོ་ན་ཁྱེད་རང་ལྟར་ན་ཆགས་བྲལ་གང་ཡིན་ཞེ་ན།",
    "འོ་ན་ཁྱེད་རང་ཡང་བྱམས་སོགས་གོམས་པ་དང་གཟུངས་སྔགས་བཟླས་པ་ལས་སྒྲིབ་པ་འདག་པར་འདོད་པ་དང་འགལ་ལ།",
    "ཁོ་བོ་ཅག་ལྟར་ན་ལྡན་མིན་འདུ་བྱེད་ཀྱིས་བསྡུས་པའི་མིང་རང་མཚན་དངོས་སུ་བརྗོད་ནས།",
    "སྒྲ་དེས་འཆད་ཉན་བྱེད་པའི་བློ་ཁོ་ན་དང་འབྲེལ་བའི་མིང་རང་མཚན་བརྗོད་པའི་ཕྱིར།",
    "ཕྱི་རོལ་དོན་གྱི་རྣམ་པ་སྣང་བའི་བློ་ཁས་ལེན་པ་མེད་པའི་ཕྱིརམིང་རང་མཚན་གྱི་རྣམ་པ་ཤར་བར་ཁས་ལེན་ནོ་ཞེ་ན་ཡང་།",
    "དེ་འདྲའི་མིང་རང་མཚན་ལོག་སྟོབས་ཀྱིས་རང་འཛིན་ཤེས་པ་ལྡོག་པ་གྲུབ་པ་མེད་པའི་ཕྱིར།",
    "རིགས་པ་དེས་ནི་མིང་སོགས་ཀྱང་རང་སྣང་མཁན་གྱི་ཤེས་པ་ལས་དོན་གཞན་མིན་པར་བརྗོད་པ་ཡིན་ཏེ།",
    "འཆད་ཉན་བྱེད་པ་བོའི་བློ་དང་དོན་རང་མཚན་གང་དང་ཡང་འབྲེལ་མེད་ཀྱི་མིང་རང་མཚན་བརྗོད་དོ་ཞེ་ན་ཡང་།",
    "གལ་ཏེ་དོན་རང་མཚན་དང་འབྲེལ་བ་དང་ལྡན་པའི་མིང་རང་མཚན་བརྗོད་དོ་ཞེ་ན།",
    "འདས་མ་འོངས་ཀྱི་དོན་ལ་བརྟེན་པའི་མིང་རང་མཚན་སྒྲའི་བརྗོད་བྱ་མིན་པར་དེ་ནི་མཚན་དང་ལྷན་ཅིག་ཟད་ཅིང་མ་སྐྱེས་ནས་མེད་པའི་ཕྱིར།",
    "འཇིག་པ་དངོས་པོ་ཡོད་ཙམ་དང་རང་ཆས་སུ་རྗེས་སུ་འབྲེལ་བའི་ཕྱིར།",
    "དེ་ལ་དཔྱོད་པ་ཡང་རང་མཚན་དཔྱོད་པའི་ཡུལ་དུ་དོར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "མི་རུང་ཞེས་དཔྱད་པར་བྱ་བའི་གཞི་ཡང་རང་མཚན་དང་།",
    "རང་མཚན་མིན་པ་ལ་རང་མཚན་ལྟར་སྣང་བའི་རྣམ་པ་གཞན་གྱིས་ཀྱང་རང་མཚན་གསར་དུ་རྟོགས་པ་མཐོང་བའི་ཕྱིར།",
    "འཁྲུལ་བ་ཡིན་ཡང་རང་མཚན་ལ་མི་བསླུ་བའི་དཔེ་སྟོན་པ་ནི།",
    "འོད་སྒོ་གསེབ་ན་འདུག་པ་མཐོང་ནས།",
    "སྔར་ཡོད་ཀྱང་ཡོད་པ་ཉིད་དང་རང་རྒྱུ་དང་ཅིག་ཏུ་འབྲེལ་བར་བྱེད་པ་བོ་རྒྱུ་ཡིན་ལ་རྒྱུ་འབྲསལྷན་ཅིག་ཕྲད་པའི་ཆ་འབྲས་བུ་ཡིན་གྲག་ན།",
    "མིན་པའི་དོན་ཡང་རང་མཚན་མངོན་སུམ་དུ་སྣང་བ་ལྟར་མིན་པ་དོན་གྱི་ཆ་ཤས་ཀྱི་སྤྱི་ཤར་ནས།",
    "ཤིང་སྒྲ་དེའི་བརྗོད་བྱ་ཤིང་འཛིན་རྣམ་པར་རྟོག་པའི་གཟུགས་བརྙན་ནི་ཤིང་རང་མཚན་དེ་ཐོབ་པ་ཡི་མཐར་ཐུག་པ་རྣམས་དང་འབྲེལ་བའི་ཕྱིར།",
    "གཞན་རིག་ཏུ་འདོད་པ་དེ་དག་ཀྱང་རང་རིག་མིན་ན་འདིས་གཞན་ཡང་རིག་པར་བྱེད་པ་མིན་པའི་ཕྱིར།",
    "གཙོ་བོ་རྟོག་པ་གཅིག་ཁོ་ན་འདུག་ལ།",
    "འཁོར་རྟོག་པ་རྫས་ཐ་དད་དུ་མ་འདུག་གོ་སྙམ་དུ་གང་ལས་ངེས།",
    "རྟོག་པ་རྫས་ཐ་དད་དུ་མ་དུས་ཅིག་ཅར་སྦྲུལ་མགོའི་གདེངས་ཀ་ལྟར་འདུག་མི་འདུག་ལེགས་པར་བསམས་ན་དེ་མ་ཐག་ཤེས་པར་འགྱུར་རོ།",
    "དེ་མྱོང་རང་རིག་མངོན་སུམ་ལ་གསལ་བར་སྣང་བའི་ཕྱིར་ཞེ་ན།",
    "དེ་བཞིན་དུ་འདི་ན་སྦྲུལ་འདུག་ཅེས་བརྗོད་པ་ཙམ་གྱིས་སྦྲུལ་འཛིན་སྐྱེ་བ་བཞིན་དུ།",
    "སྔོན་པོ་ཤེས་པའི་རྫས་སུ་འདོད་པ་དེ་ལའང་རང་མྱོང་བའི་མངོན་སུམ་དེ་རྫས་གཞན་དུ་ཡོད་པ་མ་ཡིན་ཏེ།",
