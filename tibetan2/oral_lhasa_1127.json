    "དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཛོད་ཅེས་བྱ་བ་ནི་ཕ་རོལ་དུ་སོན་པར་གྱིས་ཤིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རིགས་འདི་ལ་མི་དང་མི་མ་ཡིན་པས་བྱས་པའི་གནོད་པ་མེད་པར་བསྟན་༦ཏོ།",
    "ཁྱིམ་ན་གནས་པ་རྣམས་ལ་དུས་ཐམས་ཅད་དུ་ཚངས་པར་སྤྱད་པ་དཀའ་བའི་ཕྱིར་ན་༡ཉིན་ཞག་གཅིག་པའི་ཚངས་པར་སྤྱོད་པ་ལ་ཡང་སྦྱར་བའི་ཆེད་དུ་གསོ་སྦྱོང་ཡན་ལག་བརྒྱད་པ་བསྟན་པའི་ཕྱིར།",
    "དེ་བས་ན་དེ་དག་ལ་ཇི་ལྟར་རིགས་པར་༐",
    "དེ་༡༧ཁྱིམ་པ་རྣམས་ལ་ནི་འདོད་པས་ལོག་པར་གཡེམ་པ་སྤང་དཀའ་བའི་ཕྱིར་༡༧།",
    "མི་གཙང་བའི་རྟེན་དང་ངོམས་མི་ཤེས་པ་དང་།",
    "དེ་ལ་མི་སྙན་པ་༤དང་སྨད་པ་ནི་ལྐོག་ད་ང་ལྐོག་མ་ཡིན་པའི་བྱེ་བྲག་ལས་རིག་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱི་ཡིད་ཀྱི་ཡུལ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེ་དག་ནི་ནོར་བདུན་ལགས་པར་ཐུབ་པས་གསུངས་ཏེ།",
    "དེར་ནི་རྒྱུའི་དོན་ཡིན་པར་གསལ་བ་ཁོ་ནར་གོའོ།",
    "ནོར་མི་བདོག་ཀྱང་ཡང་དག་༨འབྱོར་པ་ལགས།",
    "དེ་ཡང་ཆོག་ཤེས་པས་ཡང་དག་པར་འབྱོར་བ་ཡིན་ཏེ།",
    "གལ་ཏེ་ནོར་མེད་དུ་ཟིན་ཀྱང་ཆོག་ཤེས་ན་དབུལ་བཞིན་དུ་ཡང་ནོར་དང་ལྡན་པ་ཁོ་ན་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་བས་ན་སྤང་བར་བྱའོ་། དེ་ལས་རང་བཞིན་གྱིས་༧དགྲ་ནི་གང་ཞིག་སྐྱེས་པ་གསོད་པར་༐",
    "དེ་ལྟ་༡༧ན་ཕན་ཐོགས་པར་འགྱུར་བ་དེ་བཞིན་དུ་ཟས་ཀྱང་ཧ་ཅང་ཉུང་ངུ་ཡང་མ་ཡིན་ཧ་ཅང་མང་པོ་ཡང་མ་ཡིན་པར་བསྟེན་པར་བྱ་སྟེ།",
    "གནོད་པ་ཡང་བསྐྱེད་༡༧པར་མི་འགྱུར་ར་རོ།",
    "དོན་འདི་ཉིད་རིགས་པ་ཡིས་ཞེས་བྱ་བ་འདིས་སྟོན་པར་བྱེད་ད་དོ།",
    "འདོད་ཆགས་ཞེ་སྡང་མེད་པར་བསྟེན་བགྱི་སྟེ།",
    "རྒྱགས་ཕྱིར་མ་ལགས་ཏྲ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འཚག་པར་༢བྱའོ་སྙམ་ནས་ཟས་ཟ་བ་གང་ཡིན་པ་དེ་ནི་འདོད་ཆགས་ཀྱིས་༢ཟ་བ་ཡིན་ནོ།",
    "ཡོངས་སུ་རྫོགས་པར་བྱས་ནས་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "ཉིན་པར་འཆག་པ་དང་།",
    "དེ་ལྟར་ལུས་དང་སེམས་ལས་སུ་རུང་བར་བྱས་ནས།",
    "དེ་ལ་བྱམས་པར་བྱེད་པས་ན་བྱམས་པ་སྟེ།",
    "སྡུག་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རངས་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རིགས་པར་ལྟ་བས་ན་བཏང་སྙོམས་ཏེ།",
    "དགའ་བ་ནི་བདེ་བ་དང་མི་འབྲལ་བའི་རྣམ་པར་ཞུགས་པའོ།",
    "བཏང་སྙོམས་ནི་བར་མ་༡གནས་པའི་རྣམ་པར་ཞུགས་པ་སྟེ།",
    "ཇི་སྲིད་དུ་འདིའི་སེམས་ཆུང་ངུ་བྱུང་བ་དེ་སྲིད་དུ་འཇུག་པར་བྱེད་དོ།",
    "དེ་ནས་གང་ཟག་སྡུག་པ་ལ་སེམས་གཏོད་པར་བྱེད་ད་དེ།",
    "དེ་ལ་ཡང་ཇི་སྲིད་དུ་འདི་ལ་གང་ཟག་སྔ་མ་དང་མཉམ་པའི་སེམས་སྐྱེས་པ་དེ་སྲིད་དུ་སེམས་གཏོད་པར་བྱེད་ད་དོ།",
    "དེ་ནས་གང་ཟག་༦ཐ་མ་ལ་གཏོད་པར་བྱེད་ད་དེ།",
    "དེ་༥སྲིད་དུ་གང་ཟག་ཐ་༦མ་གཉིས་དང་མཉམ་པའི་སེམས་སྐྱེས་པ་དེ་སྲིད་དུ་གཏོད་པར་བྱེད་ད་དོ།",
    "དེ་ནས་གང་ཟག་མི་སྡུག་པ་ལ་སེམས་གཏོད་པར་བྱེད་ད་དེ།",
    "དེ་ལ་ཡང་དེ་སྲིད་དུ་གཏོད་པར་བྱེད་ད་དོ།",
    "གལ་ཏེ་འདི་ལ་གང་ཟག་ཤ་ཁོན་ཅན་ཞིག་ཡོད་ན་དེ་ལ་འདི་བདེ་བར་གྱུར་ཅིག་སྙམ་པའི་སེམས་སྐྱེད་༧པར་བྱེད་ད་དེ།",
    "རྫོགས་པར་བྱས་ནས་གནས་སོ་ཞེས་བྱ་བའི་བར་རྒྱས་པར་གསུངས་པ་ལྟ་བུ་ཡིན་ན་ནོ།",
    "དགའ་བ་ནི་གང་ཟག་སྡུག་པ་ལ་དམིགས་ནས་རིམ་པ་འདི་༢ཉིད་ཀྱིས་བསྒྲུབ་པར་བྱའོ།",
    "འདི་སྐད་དུ་བྱམས་པ་ལ་སོགས་པ་དེ་ལྟར་བསྒོམས་པས་ནི་མྱ་ངན་ལས་འདས་པ་འཐོབ་༧པར་འགྱུར་ར་རོ།",
    "འོན་ཏེ་ཇི་ཞིག་ལྟར་མྱ་ངན་ལས་འདས་པ་མ་ཐོབ་ན་འོན་ཀྱང་ཚངས་པའི་འཇིག་རྟེན་བདེ་བ་ཐོབ་པར་འགྱུར།",
    "འདི་ལྟར་རྣམ་པར་སྤངས་ཞེས་བྱ་བའི་སྒྲས་ནི་འདོད་པ་རྣམ་པར་སྤངས་པ་ད་ང་།",
    "སྤྱོད་༡པ་རྣམ་པར་སྤངས་པ་དང་།",
    "དགའ་བ་རྣམ་པར་སྤངས་པ་དང་།",
    "འབྲས་བུ་ཅི་ཞིག་ཐོབ་པར་འགྱུར་ཞེ་ན།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་བསྟན་པའི་ཕྱིར།",
    "ཚངས་དང་འོད་གསལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་བསམ་གཏན་དང་པོ་བསྒོམས་པས་ནི་ཚངས་རིས་ཀྱི་ལྷ་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེ་བར་འགྱུར་ར་རོ།",
    "བཞི་པས་ནི་འབྲས་བུ་ཆེ་བའི་ལྷ་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་ལ་བསམ་གཏན་དང་པོ་ལ་སོགས་པ་འདོད་པ་རྣམ་པར་༐",
    "བདེ་བ་དང་སྡུག་བསྔལ་རྣམ་པར་སྤངས་པས་༦ནི་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་༧ཡང་མ་ཡིན་པའི་ཚོར་བ་སྟོན་པར་བྱེད་ད་དོ།",
    "ལས་ཀྱི་༨ལྕི་བ་ཉིད་ནི་རྒྱུ་བཞི་པོ་སྦྱོར་བའི་ཁྱད་པར་དང་།",
    "བསམ་པའི་ཁྱད་པར་དང་།",
    "རབ་ཏུ་དང་བ་དྲག་པོ་དང་ལྡན་པའི་བསམ་པའི་ཁྱད་པར་ལས་ལྕི་བར་འགྱུར་ར་རོ།",
    "ལས་བྱས་པ་ཡང་གཉེན་པོ་སྟོབས་དང་ལྡན་པས་ཟིལ་གྱིས་མནན་ན་ཉམ་ཆུང་ངུར་འགྱུར་ལ།",
    "ལས་དེ་ཉིད་གཉེན་པོ་མེད་པར་གྱུར་ན་སྟོབས་དང་ལྡན་པར་འགྱུར་ར་རོ།",
    "དེ་ལ་ཡོན་ཏན་ནས་མནར་སེམས་ཀྱི་དངོས་པོ་དགུ་ལ་ཞརིག་པར་བྱའོ།",
    "བདག་ལ་གནོད་པར་བྱས་སོ།",
    "བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་གསུམ་ཚན་དང་པོ་དང་།",
    "བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་གསུམ་ཚན་གཉིས་པ་དང་བདག་དང་མི་མཛའ་བ་ཡིད་དུ་མི་འོང་བ་གནོད་པར་འདོད་པ་ཕན་པར་མི་འདོད་པ་གང་ཡིན་པ་དེ་ལ་ཕན་པར་བྱས་སོ།",
    "བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་གསུམ་ཚན་གསུམ་པའོ།",
    "ཀུན་ནས་མནར་སེམས་དེ་ནི་སྔོན་གྱི་ཁོན་དང་འབྲེལ་བ་ལས་རིག་པར་བྱའོ།",
    "ཐམས་ཅད་རྣམ་པར་སྨིན་པ་མི་།",
    "རྣམ་པར་སྨིན་པ་ཡིད་དུ་མི་འོང་བ་ཅན་ཁོ་ནར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་གཙང་བ་ནི་སུངས་༦པ་དང་རུལ་བའི་མི་ག་ཙང་བ་ཉིད་དང་ལྡན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "མི་ནི་ཡང་དག་པའི་ཤེས་རབ་ཀྱིས་ལེགས་པར་བརྟགས་ན་དེ་ལྟ་བུ་ཡིན་ན་ནོ།",
    "མ་བཞག་༧པ་དེ་ད་ག་ནི་ལོག་པར་འཛིན་ཏོ།",
    "མི་གཙང་བ་ལ་ག་ཙང་ངོ་སྙམ་དུ་འདུ་ཤེས་ཕྱིན་ཅི་ལོག་ད་ང་།",
    "བད་ག་མེད་པ་ཡིན་པར་རྟོགས་པར་མི་ནུས་ཏེ།",
    "གཟུགས་ནི་བདག་མ་ཡིན་ཞེས་གསུངས་ཏེ།",
    "དེ་ལས་གཞན་པ་ཞིག་ཡིན་པར་འགྱུར་གྱུར་གྲང་།",
    "གཟུགས་ནི་བདག་མ་ཡིན་གསུངས་ལ།",
    "རྣམ་པར་ཤེས་པའི་བར་ཡང་བདག་མ་ཡིན་ཞེས་གསུངས་ཏེ།",
    "རིགས་པ་བརྫོད་པར་བྱ་སྟེ།",
    "རྒྱུ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་སྐྱེ་བ་དང་འཇིག་པ་༤དེ་ལ་ཁྱད་པར་ཡོད་ན་ནི་རྟག་པ་ཉིད་དུ་མི་འགྱུར་ར་རོ།",
    "མེད་པའི་ཕྱིར་གཏན་མེད་པ་བཞིན་ན་ནོ་། རང་བཞིན་ཡང་འདི་ཉིད་ཀྱིས་ཅི་རིགས་པར་བཀག་པར་རིག་པར་བྱའོ།",
    "སྐྱེས་བུ་སྤྱོད་པར་བྱེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཡོད་པའི་ཕྱིར་སྐྱེས་ཟིན་པ་བཞིན་བསྐུར་བ་འམ་སའི་འོག་ཏུ་འཛུད་པར་བྱེད་ཅིང་།",
    "ཡང་ན་ནི་དུད་འགྲོའི་སྐྱེ་གནས་སུ་གཏོགས་པའི་སྲོག་ཆགས་སྣ་ཚོགས་ཟ་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དེ་ལ་ལུས་ཞེས་བྱ་བ་ནི་རྣམ་པར་འགྱེས་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "མཐར་སྐམ་༢ཞེས་བྱ་བ་ནི་སའི་འོག་ཏུ་འཛུད་པར་བྱེད་ཅིང་།",
    "ཐ་མར་མི་གཙང་ཞེས་བྱ་བ་ནི་དུད་འགྲོའི་སྐྱེ་གནས་སུ་གཏོགས་པའི་སྲོག་ཆགས་སྣ་ཚོགས་ཟ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་འདིའི་དོན་ཡིན་ནོ།",
    "རྣམ་པར་འཇིག་དེངས་མྱགས་པར་འགྱུར་བ་སྟེ།",
    "མཁྱེན་པར་མཛོད་ཅེས་བྱ་བ་ནི་རྟོགས་པར་གྱིས་ཤིག་པའོ།",
    "དེ་ལྟར་འདུ་བྱེད་དུ་གཏོགས་པ་ཐམས་ཅད་མ་ལུས་པར་བསྲེགས་ནས་རང་ཡང་འཆི་བར་འགྱུར་ཏེ།",
    "དེ་ལ་ཁྱད་པར་ནི་འདི་ཡོད་དེ་ཉི་མ་གཉིས་༐",
    "སྐྱབས་མེད་པ་༡༧ནི་སྡུག་བསྔལ་ལས་ཡོངས་སུ་སྐྱོབ་པར་བྱེད་པའི་རྗེ་དཔོན་འགའ་ཡང་མེད་པའི་ཕྱིར་ར་རོ།",
    "འགྱུར་བའི་༡ཡུལ་དུ་གནས་པ་དང་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒྱལ་པོ་འཕགས་པའི་ལམ་གྱིས་༡༧སྣོད་ཉིད་ཡིན་པར་སྟོན་ཏོ།",
    "ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་ཅན་༡༧ཡིན་ན་ནོ།",
    "མི་རྣམས་ཀྱི་མ་བརྒྱུད་༢པ་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་ང་༢ིསྨྲའོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "པར་ཅེས་བྱེད་པའོ།",
    "གང་དུ་རྐང་པ་བཞག་པ་ན་པགས་པ་དང་ཤ་དང་ཁྲག་ཞིག་པར་འགྱུར་ལ།",
    "བཏེག་ན་པགས་པ་ཉདང་ཤ་དང་ཁྲག་སླར་སྐྱེ་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་དུད་འགྲོའི་སྐྱེ་གནས་སུ་གཏོགས་པའི་སྡུག་བསྔལ་ནི་སྤྱི་དང་ཁྱད་པར་དུ་བསྟན་པར་རིག་པར་བྱའོ།",
    "འགྱོད་པ་མེད་པ་ཉིད་ཀྱིས་རྣམ་པར་སྨིན་པ་གཅིག་ཏུ་སྡུག་བསྔལ་བའི་ཕྱིར་ར་རོ།",
    "བར་ཆད་མེད་པར་སྡུག་བསྔལ་རྟེན་གྱུར་པ།",
    "བར་ཆད་མེད་པར་སྡུག་བསྔལ་གྱི་ཚོར་༡༧བས་ཉེན་པ་དག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ཉེས་པར་སྤྱད་པའི་ལས་ཀྱི་ཞགས་པ་༡༧ནི།",
    "སྣ་ཚོགས་པ་༢༥ཞེས་བྱ་བ་ནི་བཀྲེས་པ་དང་སྐོམ་པ་ལ་སོགས་པར་རིག་པར་བྱའོ།",
    "རོ་གཅིག་ཅེས་བྱ་བ་ནི་སྡུག་བསྔལ་བར་ཆད་མེད་པ་ཉིད་དུ་སྟོན་པར་བྱེད་དོ་༢༦།",
    "ཞེས་བྱ་བ་ཧསོགས་པ་གནོད་པ་དུ་མའི་སྣོད་དུ་གྱུར་ཅིང་རྟེན་དུ་གྱུར་པ་ཡིན་པར་ཤེས་པར་གྱིས་ཤིག་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "ཡང་སྲིད་མེད་པར་བགྱི་སླད་འབད་འཚལ་ཏེ།",
    "ཞེས་བྱ་བ་ནི་ལུས་དང་སྲོག་ལ་མི་ལྟ་བའི་བརྩོན་འགྲུས་ཆེན་པོ་དེ་ལྟ་བུ་༤ཡང་སྲིད་༥མེད་པར་བྱ་བའི་ཕྱིར་འབད་པར་བྱ་དགོས་སོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "འདི་བས་ཁྱད་པར་དུ་འཕགས་པའི་དགོས་པ་གཞན་ནི་མེད།",
    "བསླབ་པ་གསུམ་ཡོངས་སུ་རྫོགས་པར་བྱས་ནས་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་གྱིས་ཤིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "འདུན་པའི་འདོད་ཆགས་དེས་འདོད་པ་ལ་སོགས་པ་ཉེ་བར་བླངས་པར་འགྱུར་བས་ས་སོ།",
    "གཟུགས་མེད་པའི་སྲིད་པ་ཞེས་གསུངས་ས་སོ།",
    "འཐོབ་བགྱིད་འཕགས་ལམ་ཞཡན་ལག་དེ་བརྒྱད་ལགས།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་བྱ་བ་ལ་སྦྱོར་བར་བྱེད་ད་དོ།",
    "ལམ་སྐྱེས་བུའི་རྩལ་གྱིས་༢བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་སྟོན་པར་བྱེད་དོ།",
    "གནམ་ལས་བབས་པ་༦མ་ལགས་ཞེས་བྱ་བ་ནི་དེ་ད་ག་དང་པོ་ཉིད་ནས་ཤེས་པ་ཡོངས་སུ་གྲུབ་ཟིན་པ་ཅིག་༧ལས་འདིར་ལྷགས་པ་མ་ཡིན་པའོ།",
    "ལས་འཐོན་༡མ་ལགས་ཞེས་བྱ་བ་ནི་སྐྱེས་བུའི་རྩ་ལ་མེད་པར་གྱི་ན་ལོ་ཏོག་བཞིན་ཐོན་༢ིཔ་མ་ཡིན་པའོ།",
