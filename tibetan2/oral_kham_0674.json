    "དུས་དེའི་མ་དང་རང་རྩ་དར་ན་གཞི་ལ་གནས་པ་དང་།",
    "རང་ལ་དགྲ་རྩ་བྱུང་བ་དེ་དང་འདྲ་ན་ཚུལ་རྒོལ་བའི་ཚེ་རང་ལ་དགྲ་ཡིས་ཚུགས་ལ་དུས་ཀྱི་མ་རྩ་དང་རང་རྩ་དར་ན་ཚུལ་རྒོལ་བྱུང་ཡང་རང་ལ་དགྲས་ཚུགས་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ན་བླ་རྩ་འདི་སྐྱོན་མེད་པར་གནས་ན་རྟེན་བླ་དང་དེ་ལ་བརྟེན་པའི་ཚེ་ཡང་རང་མལ་དུ་གནས་ལ།",
    "གཉིད་ཆག་པ་དང་འགྲོ་འདུག་མང་དུ་བྱས་པ་དང་།",
    "ཚ་བའི་དྲོད་ཡལ་འགྲོ་བའི་དུས་སུ་ཀུ་ཡ་དང་སྤྲིས་མ་བརྟག་ཆུ་དེ་གྲང་ལ་ཁད་པའི་དུས་ནས་ལྡོག་དུས་སྔ་ཕྱི་དང་ལྡོག་ཚུལ་དང་གྲང་ཚར་ནས་ལོག་རྗེས་གསུམ་བརྟག་གོ།",
    "རྩ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "ཆུ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "ལྡོག་དུས་ཀྱི་ཚུལ་ལ་བརྟག་ན།",
    "དབུས་གསུམ་ནི་མགོ་ནས་མར་ཕ་མེས་དང་རང་དང་བུ་ཚའི་ས་ཡིན་ནོ།",
    "ཡང་ན་རིགས་ཀླུ་ཡིན་ཀྱང་རང་བཞིན་གྱི་གདུག་པ་ཆེ་ཞིང་འཚེ་བའི་རིགས་ལ་ཟེར།",
    "མི་སྨྲ་མི་འགུལ་ཙོག་པུར་ལྷོད་པར་འདུག།",
    "སྨྲ་འགུལ་སྤང་ལ་ཙོག་པུར་འདུག་པ་གཅེས།",
    "རྒྱ་བཤལ་སྐྱུག་དུས་ཙན་དན་གུར་གུམ་དང་།",
    "རྩར་བརྒྱར་རང་རང་ཁ་ཕྱེད་བར་དུ་བསྒྱུར།",
    "ལི་ལ་མེ་ཟླ་ཞག་དུས་བཞི་ཡི་བླ་གནས་བརྩི།",
    "མཆིན་སྐག་དུས་ཚོད་དང་སྦྱར་བ་ལྟོ་གཏེར་སྲིད་པའི་གཏེར་ཁྱིམ་གྱི་ལུགས།",
    "ཚིག་བཅད་གཞུང་འདི་བདེ་མཆོག་དང་སམ་བུ་ཊི་གཡུ་ཐོག་གསུམ་གྱི་དགོངས་པ་དང་མཆན་སེར་དང་ཕྱུགས་ཀྱི་བླ་གནས་ཕུག་ལུགས་མཆན་སྐྱ་ཟུར་ལུགས་མཆན་སྐག་དུས་ཚོད་དང་སྦྱར་བའོ།",
    "ཟླ་ཞག་དུས་ལ་གཏར་སྲེག་སྤང་བ་ཡིན།",
    "འདུག་མི་ཚུགས་དང་སྐྲངས་ལ་མཆོག་ཏུ་ཕན།",
    "བེ་རོ་ཙ་ན་མཁས་པ་མི་དགུ་སོགས།",
    "བེ་རོ་ཙ་ན་མཁས་པ་མི་དགུ་སོགས།",
    "ཅུང་ཟད་མཐུན་མིན་འདུག་པས་འདིར་མ་བཀོད།",
    "དུས་དང་རང་བཞིན་དང་།",
    "དལ་བར་འདུག་པ་དང་།",
    "སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་འཛིན་པ་དང་།",
    "སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་བར་འཛིན་པ་དང་།",
    "བོད་ཀྱི་ལོ་ཚ་ཙཱ་བ་བེ་བེ་རོ་ཙ་ནས་བསྒྱུར་ཞིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པའོ།",
    "རྗེས་མར་སླར་ཡང་མན་རྒྱུད་སྡོང་འགྲེམས་རྒྱས་པ་ཞིག་དགོས་པ་ངེས་ཅན་ཡིན་པར་བསམ་རུང་རང་ཉིད་ཤེས་བྱ་དམན་པ་དང་།",
    "འགྲོ་སྲོག་དུས་མིན་འཇིག་པ་ལ།",
    "འཛམ་གླིང་རང་ལུས་འདོམ་གང་གྲུ་བཞི་སྟེ།",
    "ནས་རང་རང་གནས་སུ་འཕེལ་ཞིང་གསོག་པར་བྱེད།",
    "རྒྱུ་ནི་རང་རང་སྐྱེད་པའི་རྐྱེན་ཡིན་ཏེ།",
    "༤ འགྲོ་འདུག་བྱ་ཐབས་བསྟན་པ་ནི།",
    "གསུང་སྤྲུལ་ཡིད་ལས་སྐྱེས་ཀྱིས་གུས་པ་དང་བཅས་པའི་སྒོ་ནས་དམའ་བའི་ས་ལ་འདུག་སྟེ་རྒྱུད་འདིར་ཞུ་ཚུལ་བསྟན་པ་བཅས་གསུམ་ལས།",
    "འགྲེལ་པ་ཟླ་ཟེར་གྱི་དུམ་བུའི་ནང་ལྕེ་ལ་ཤར་བ་གསུངས་འདུག་ཀྱང་རྩ་ཚིག་ནང་མེད་པས་བཀོད་མེད།",
    "འདི་ལ་མཆན་བུ་ལ་ལར་ཟན་སྐམ་ལོ་ལོན་པ་ཞེས་འདུག་ཀྱང་ཡིག་སྐྱོན་ཡིན་ནམ་སྙམ་པས་དཔྱད་གསུངས།",
    "ན་ལེ་ཤམ་གྱིས་ཁ་བསྒྱུར་བས་སྦྱང་བར་བྱ་ཞེས་གསུངས་འདུག་པས་དཔྱད།",
    "ཞེས་པ་འདུག་པས་དཔྱད་པར་འཚལ།",
    "ཟེར་བ་ཡོད་འདུག་པའི་རྗེས་འབྲངས་ནས་ཕལ་ཆེར་ཏུ།",
    "སྐྲན་གསུམ་ཞེས་གསུངས་འདུག་ཀྱང་ཡི་གེ་མ་དག་པ་འདྲ།",
    "ཞེས་པ་ནས་དེ་རྟགས་བཅོས་ཐབས་རང་རང་ལེའུར་བལྟ།",
    "རང་རང་རྩ་ལ་གཏར།",
    "རུས་ལ་ཞེན་ན་ཞེས་པ་ནས་འགྲོ་འདུག་གྱོང་།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག་པའི་ལོ་མ།",
    "མེ་ཏོག་དང་པོ་ཆུ་སྐྱུར་སྐྱུག་དུས་སུ།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "ཏ་ཙ་ནི་འདི་སྐབས་འུ་སུ།",
    "སྤྱོད་ལམ་འདུག་རྗེས་དྲག་པོའི་ལས་བྱས་ཤིང་།",
    "ལྔ་པ་རྒྱུད་ཀྱི་སྒོ་ནས་དབྱེ་བ་བསྟན་པ་ལ་ཡང་རང་རྒྱུད་ཅད་དང་གཞན་རྒྱུད་ཅན་གཉིས་ལས།",
    "གནས་ཀྱི་ཚ་བ་འཇུག་སྒོ་གང་གནས་གསལ་བའི་ལོ་མ་གཅིག་ལྔ་པ་རྒྱུད་ཀྱི་སྒོ་ནས་བརྟག་པ་ལ་ཡང་རང་རྒྱུད་ཅན་དང་།",
    "བསིལ་དྲོད་སྙོམས་པའི་གནས་ནི་ཞེས་པ་ནས་དབེན་པར་འདུག།",
    "གྲང་བ་ལ་གཅིག་ཆུ་འགགས་དང་རིམས་ཀྱི་ཆུ་འགགས་གཉིས་ཏེ་བཅུ་བཅས་དྲིལ་བས་བཞི་བཅུ་གསུངས་འདུག།",
    "ཁ་ཡེད་ཅེས་པ་ལ་བེ་སྔོན་དུ་ཁ་གཡེར་བ་སྟེ་ལབ་མང་སྨྲ་བ་ཞེས་གསུངས་འདུག།",
    "སྤྱོད་ལམ་བསིལ་གནས་དལ་འདུག་གཉིད་མི་ལོག།",
    "ཀག་དུས་བསྟན་པ་བཅས་གསུམ།",
    "ཀུན་ལ་ཀ་ར་དཀར་པོའི་ཞེས་པ་ནས་རང་རང་སྒོས་རྩ་གཏར།",
    "བཅོམ་ལྡན་འདས་ཀྱི་རྐང་པ་བརྒྱད་པ་དང་སྒོ་མཚམས་མ་བརྒྱད་གཉིས་སུ་མེད་པར་ཟློས་ཀྱིན་གདའ་གསུང་ངོ།",
    "མགྲིན་པ་ནི་འོག་ན་འདུག་ཀྱང་ཐབས་ཡིན་ལ།",
    "སྤྱི་བོ་ནི་སྟེང་ན་འདུག་ཀྱང་ཤེས་རབ་ཡིན་ནོ་ ཕྱི་རོལ་ནང་ན་ཡང་དག་གནས།",
    "སྣང་ཡང་རང་བཞིན་མེད་པའི་དཔེ་དུ་མས་བསྟན་ཏོ་ དེ་ཉིད་ཀྱི་ཕྱིར་ཇི་ལྟར་ན་ལ་སོགས་པས་མཚོན་བྱ་སྐྱེ་མེད་བརྗོད་པ་དང་བྲལ་བ་སྟེ།",
    "ཁོའི་མིག་གཉིས་རབ་རིབ་ཏུ་གྱུར་བ་དང་རྣ་བ་འོན་པར་གྱུར་ཞིང་སྐྱིད་པ་གཉིས་ཀྱང་ལྷམ་ལྷམ་དུ་འདར་བཞིན་འདུག་ལ།",
    "ང་ཡི་ཁྱིམ་ནས་འདུག་ཀྱང་འོས་ལ།",
    "ཉིན་གུང་ལ་བསླེབས་འདུག་པ་ན་ཉི་མའང་ཤིན་ཏུ་ཚ་གདུག་ཆེ།",
