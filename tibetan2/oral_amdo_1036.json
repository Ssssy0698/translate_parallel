    "མཛུབ་མོ་གཡས་པའཱི་ར་བ་མཐེ་བོང་གཡོན་པས་མནན་པའོ།",
    "མཛུམ་མཛུབ་མོ་རེ་མོ་བཀུག་པས་ནཱི།",
    "ཞེས་བྱ་བ་ནཱི་མཛུམ་མཛུབ་མོ་ག་཈ཱིས་ཀཱི་རེ་མོ་སེ།",
    "ཚིགས་གསུམ་པ་བཀུག་པ་གང་ཡཱིན་པ་དེ་ནཱི་མཛུམ་མཛུབ་མོའི་རེ་མོ་བཀུག་པའོ།",
    "མཛུམ་མཛུབ་མོ་བཀུག་པ་དེ་ཡང་གུང་མོ་མ་཈མ་པའཱི་ཚིགས་གསུམ་པར་སར་བར་བྱ་སེ།",
    "གུང་མོ་མ་཈མ་པའཱི་ཚིགས་གསུམ་པ་དེ་དང་མཛུབ་མོའི་རེ་སྤྲད་པར་བྱའོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་཈ཱིད་ཅེས་བྱ་བ་ནཱི་རོ་རེ་ཐལ་མོའོ།",
    "གུང་མོ་རོ་རེར་བྱ་བ་ནཱི་གུང་མོ་ག་཈ཱིས་གཞཱིབ་པར་བྱའོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "སེམས་དཔའ་རོ་རེ་མའཱི་གནས་ཀཱིའོ།",
    "གུང་མོ་ག་཈ཱིས་ནཱི་ནོར་བུར་བྱ།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཐལ་མོ་དེ་཈ཱིད་ལས་གུང་མོ་ག་཈ཱིས་རཱིན་པོ་ཆེའཱི་ཚུལ་དུ་བྱས་པ་ནཱི་རོ་རེ་རཱིན་ཆེན་མའཱི་གནས་དང་རཱིན་ཆེན་འབྱུང་ལྡན་གཱི་གནས་ཀཱིའོ།",
    "རོ་རེ་ཐལ་མོ་དེ་཈ཱིད་ལས་གུང་མོ་དང་སྲཱིན་ལག་དང་མཐེའུ་ཆུང་པདྨ་ཁ་མ་བྱེ་བ་ལྟ་བུར་བྱ་བ་ནཱི་པདྨོ་ཞེས་བྱ་བ་སེ།",
    "རོ་རེ་ཐལ་མོའི་ལག་མཐཱིལ་ག་཈ཱིས་སྤྲད་ལ་མཐེ་བོང་དང་མཐེའུ་ཆུང་ག་཈ཱིས་གཞཱིབས་ཏེ།",
    "སོར་མོ་ལྷག་མ་དྲུག་མ་འབྱར་བར་གཅཱིག་ལ་གཅཱིག་ཕན་ཚུན་བལྟ་བར་བྱས་པ་ནཱི་གདོན་མཱི་ཟ་བར་གྲུབ་པའཱི་གནས་དང་རོ་རེ་ལས་མའཱི་གནས་ཀཱིའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་ག་཈ཱིས་གཤཱིབ་པ་བྱས་པ་ནཱི་རོ་རེ་སེམས་དཔའཱི་གནས་ཀཱིའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་ག་཈ཱིས་ལྕགས་ཀྱུའཱི་ཚུལ་དུ་བྱས་པ་ནཱི་རོ་རེ་རྒྱལ་པོའི་གནས་ཀཱིའོ།",
    "དེ་཈ཱིད་ཅེས་བྱ་བ་ནཱི་མཛུབ་མོ་ག་཈ཱིས་ལྕགས་ཀྱུར་བྱས་པའོ།",
    "མཐེ་བོ་ག་཈ཱིས་ཀཱི་རེ་མོ་ནོན་ཅཱིག་ཅེས་བྱ་བའཱི་དོན་ཏོ།",
    "འདཱི་ནཱི་རོ་རེ་ཆགས་པའཱི་ཕྱག་རྒྱ་སེ་མདའཱི་སྒྲོ་ལྟ་བུའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་ག་཈ཱིས་བཀུག་ལ་རེ་མོ་མཐེ་བོས་མནན་ནས་སེ་གོལ་གཏོགས་པའཱི་ཚུལ་དུ་བརབ་པ་ནཱི་རོ་རེ་ལེགས་པའཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་ག་཈ཱིས་རཱིན་པོ་ཆེར་བྱ་བ་ནཱི་རོ་རེ་རཱིན་ཆེན་གཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་རཱིན་ཆེན་ཞེས་བྱ་བ་སེ།",
    "རཱིན་པོ་ཆེ་དང་བཅས་པའཱི་མཛུབ་མོ་གང་ཡཱིན་པ་དེ་ནཱི་མཛུབ་མོ་རཱིན་ཆེན་ཅན་ཏེ།",
    "མཛུབ་མོ་རཱིན་པོ་ཆེ་ལྟ་བུར་གནས་པ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "འོད་འབར་བ་ཞེས་བྱ་བ་ནཱི་གུང་མོ་ག་཈ཱིས་འོད་དེ་འོད་ཟེར་གཱི་ཚུལ་དུ་བརྐྱང་བ་ནཱི་རོ་རེ་གཟཱི་བརཱིད་ཀཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་དེ་཈ཱིད་ལས་སྲཱིན་ལག་ག་཈ཱིས་གཞཱིབས་ལ།",
    "མཐེའུ་ཆུང་རཱིན་པོ་ཆེའཱི་ཚུལ་དུ་བྱས་པ་ནཱི་རོ་རེ་དཔལ་གཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་ཁའཱི་ཕྱོགས་སུ་དངས་ལ་སེག་པས་དགྲོལ་ཞཱིང་སོ་སོར་དབྱེ་བ་ནཱི་རོ་རེ་བཞད་མོའི་ཕྱག་རྒྱའོ།",
    "ཀུན་གཱི་རེ་མོ་རབ་ཏུ་དགེད།",
    "རོ་རེ་ཐལ་མོ་ལས་མཐེ་བོ་ག་཈ཱིས་གཞཱིབས་ཏེ།",
    "སྲཱིན་ལག་དང་མཐེའུ་ཆུང་གཱི་བར་དུ་མཐེ་བོ་ག་཈ཱིས་ཀཱི་རེ་མོ་གཞུག་པ་ནཱི་རོ་རེ་རྣོན་པོའི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་འཁོར་ལོའི་ཚུལ་དུ་བརྐྱང་བ་ནཱི་རོ་རེ་རྒྱུའཱི་ཕྱག་རྒྱའོ།",
    "དེ་཈ཱིད་ཅེས་བྱ་བ་ནཱི་རོ་རེ་ཐལ་མོ་དེ་཈ཱིད་དོ།",
    "རོ་རེ་སྨྲ་བའཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་ག་཈ཱིས་ཀཱི་སེང་དུ་མཐེ་བོ་ག་཈ཱིས་ཀཱིས་མནན་ན་མཐེ་བོས་རོ་རེ་བཀག་པར་འགྱུར་ཏེ་རོ་རེ་ལས་ཀཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་མཛུབ་མོ་ག་཈ཱིས་བསམས་ལ་མཐེ་བོའི་དྲུང་དུ་གཞུག་ཅཱིང་མཐེ་བོ་ག་཈ཱིས་ཀཱིས་མནན་ན་མཛུབ་མོ་དེ་ག་཈ཱིས་ནང་དུ་གཞུག་པ་ཡཱིན་ཏེ།",
    "རོ་རེ་སྲུང་བའཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ལས་ཀཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་མཐེ་བོ་ག་཈ཱིས་དབྱེ་ཞཱིང་བརྐྱང་བ་སེ།",
    "རོ་རེ་གནོད་སཱིན་གཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་གནོད་སཱིན་གཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་སྲཱིན་ལག་དང་མཐེ་འུ་ཆུང་ག་཈ཱིས་ཀཱི་བར་དུ་མཐེ་བོ་ག་཈ཱིས་ཀཱི་རེ་མོ་བཅུག་སེ་བཞག་ན་རོ་རེ་ཁུ་ཚུར་གཱི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "དེ་ལྟར་ཕྱག་རྒྱ་ཆེན་པོ་བསན་ཟཱིན་ནས་ད་ནཱི་རོ་རེ་གསང་བ་ཞེས་བྱ་བ་ལ་སོགས་པས་དམ་ཚིག་གཱི་ཕྱག་རྒྱ་རྣམས་སོན་ཏེ།",
    "དེ་ནཱི་སྔར་རོ་རེ་ཐལ་མོ་ལས་བྱུང་བར་གསུངས་པ་གང་ཡཱིན་པ་དེ་ད་འདཱིར་ནཱི་རོ་རེ་བཅཱིངས་པ་ལས་བྱུང་བ་ཡཱིན་ནོ།",
    "མཚན་རྣམས་ཀཱིས་ཞེས་བྱ་བ་ནཱི་འདཱིར་རོ་རེ་ཐལ་མོ་ལས་བྱུང་བའཱི་མཚན་མ་རྣམས་ཀཱིས་སོ།",
    "ཐལ་མོ་ནང་དུ་བཀུག་པས་སོ།",
    "ཞེས་བྱ་བ་ནཱི་ཐལ་མོའི་ནང་ནཱི་ཐལ་མོ་ཁོང་སོང་དུ་ཁ་སར་བའཱི་ནང་དུའོ།",
    "རོ་རེ་ཐལ་མོ་ལས་བྱུང་བའཱི་གསང་བ་ཆེན་པོའི་མཚན་མ་གང་ཡཱིན་པ་དེ་཈ཱིད་ནཱི་ཐལ་མོ་ཁོང་སོང་ངོ་ཞེས་བྱ་བ་ནཱི་མན་ངག་གོ།",
    "ནང་གནས་པའཱི་མཚན་མས་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཐལ་མོའི་ནང་ནས་ཕྱག་རྒྱའཱི་མཚན་མས་བསན་པར་བྱ་སེ།",
    "ཕྱག་རྒྱའཱི་ལྷ་མོ་རྣམས་ཀཱི་ལས་འདཱི་ནཱི་དཀཱིལ་འཁོར་ལ་སོགས་པ་ཤཱིན་ཏུ་གསང་བ་ཡཱིན་པས།",
    "ཕྱག་རྒྱ་ཆེན་པོ་མ་གསུངས་མོད་ཀཱི།",
    "འོན་ཀང་ལྷ་མོ་དེ་དག་཈ཱིད་འདཱིར་ཕྱག་རྒྱ་ཆེན་པོ་ཡཱིན་ནོ།",
    "རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ཆེན་པོར་ལས་ཀཱི་ཕྱག་རྒྱ་རྣམས་ཀཱི་མཚན་཈ཱིད་ཇཱི་ལྟར་གསུངས་པ་ཡང་དེ་བཞཱིན་དུ་བྱ་སེ།",
    "དེ་རྣམས་ནཱི་རོ་རེ་ཁུ་ཚུར་ག་཈ཱིས་ལས་འབྱུང་།",
    "འདོད་པ་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེ་སེམས་དཔའོ།",
    "རོ་རེ་སེམས་དཔའཱི་ཏཱིང་ངེ་འཛིན་གཱིས་ཕྱག་རྒྱ་དེ་རྣམས་ལ་མཆོག་ཏུ་སྡུག་པར་བདེ་བའཱི་སེམས་ཀཱིས་རྣལ་འབྱོར་བསོམ་པ་རཱིམ་བཞཱིན་དུ་བཅཱིངས་པར་གྱུར་ན་ངེས་པར་དངོས་གྲུབ་སཱིན་པར་འགྱུར་རོ།",
    "གང་གཱི་ཕྱཱིར་འདཱི་རྣམས་ནཱི་ཐམས་ཅད་ཀཱི་བདག་཈ཱིད་དུ་གནས་ཏེ་ཐམས་ཅད་ཀཱི་བདག་཈ཱིད་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེ་སེམས་དཔའ་སེ།",
    "རང་བྱུང་རྣམས་ཀཱི་ལྷ་མོ་བརན།",
    "རོ་རེ་སེམས་དཔའཱི་རྣལ་འབྱོར་ལ་ཕྱཱིན་ཅཱི་མ་ལོག་པར་གནས་པ་ལ།",
    "དེ་ལྟར་སྒྲུབ་པ་པོ་རྣམས་ལ་རབ་ཏུ་ཆགས་པའཱི་ལྷ་མོས་རང་གཱི་བདག་པོ་བཏང་ང་རེ་ཞེས་བྱ་བ་སེ།",
    "དེ་བས་ན་འདཱི་ནཱི་ཁད་པར་མཱི་ཤེས་པས་བདག་ཅག་རྣམས་ཀཱི་གནས་སུ་འོས་པ་མ་ཡཱིན་ནོ་སམ་ནས་ཕྱག་རྒྱ་དེ་དག་གཱིས་རག་པའཱི་བདག་པོ་བཏང་ང་རེ་ཞེས་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནཱི་ནམ་བདག་཈ཱིད་ཕྱག་རྒྱ་འཆཱིང་བར་འདོད་པ་དེའཱི་ཚེ་བདག་཈ཱིད་ལ་རོ་རེ་དབབ་པ་བསེད་པར་བྱའོ།",
    "ནམ་གཞན་ལ་འཆཱིང་བར་འདོད་པ་དེའཱི་ཚེ་དེ་ལ་རོ་རེ་དབབ་པ་བསེད་པར་བྱའོ།",
    "རོ་རེ་དབབ་པ་བྱས་ནས་ནཱི།",
    "ཞེས་བྱ་བ་ནཱི་ཇཱི་སྐད་གསུངས་པའཱི་ཚུལ་གཱིས་རོ་རེ་དབབ་པ་བསེད་པའོ།",
    "ཞེས་བྱ་བ་ནཱི་ནམ་བདག་ལ་རོ་རེ་དབབ་པ་བསེད་པ་དེའཱི་ཚེ་ན་བཅཱིང་བའོ།",
    "གསང་བའཱི་གསང་བ་རོ་རེའཱི་དཀཱིལ་འཁོར་དུ་གསུངས་པ་ནཱི་རོ་རེ་བསམས་པ་དགྲོལ་བར་བྱའོ།",
    "ལས་ཀཱི་གསང་བ་ནཱི་རོ་རེ་ཐལ་མོའི་ནང་དུའོ།",
    "རཱིན་པོ་ཆེའཱི་གསང་བ་ནཱི་རཱིན་པོ་ཆེའཱི་ཐལ་མོའི་ནང་དུ་དགྲོལ་བར་བྱའོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ནཱི་ཐལ་མོར་དགྲོལ་བར་བྱ་སེ།",
    "ཐ་མར་རོ་རེ་ཐལ་མོ་སཱིང་གར་དགྲོལ་བར་བྱའོ།",
    "ད་ནཱི་རཱིན་ཆེན་རོ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནཱི་བརན་པར་བྱ་བའཱི་ཆོ་ག་སོན་ཏེ།",
    "དགྲོལ་ནས་ཀང་མཛུབ་མོ་ག་཈ཱིས་ཀཱིས་སྔར་གསུངས་པའཱི་ཚུལ་བཞཱིན་དུ་གོ་ཆ་བཅཱིང་བར་བྱའོ།",
    "བཅཱིང་ཞེས་བྱ་བ་ནཱི་ཕྱག་རྒྱ་རྣམས་བཀྲོལ་ནས་ཡང་ཐལ་མོ་བརབས་པས་མ་཈ེས་པར་བྱ་བ་ནཱི་བཅཱིང་བ་ཞེས་བྱ་བའོ།",
    "ཐལ་མོ་བརབས་པས་ཀུན་བཅཱིངས་པ།",
    "ཐལ་མོ་བརབས་པས་མ་཈ེས་པར་བྱ།",
    "ཞེས་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ལས་ཇཱི་སྐད་གསུངས་པ་བཞཱིན་དུ།",
    "རོ་རེ་སེམས་དཔའ་ཅཱི་དགར་བཟས།",
    "དེ་རྣམས་ཀཱི་རོ་རེ་ཕ་མོ་ནཱི་ཡེ་ཤེས་ཀཱི་རོ་རེ་སེ།",
    "སུས་ཀང་གཞོམ་དུ་མེད་པ་དེ་ལ་ནཱི་རོ་རེ་ཕ་མོ་ཞེས་གསུངས་སོ།",
    "རྣལ་འབྱོར་གཱི་རྒྱུད་ལ་གསང་སྔགས་ཀཱི་སོར་སོད་པའཱི་རྣལ་འབྱོར་པ་རྣམས་ལ་ཏཱིང་ངེ་འཛིན་གཱི་ཡེ་ཤེས་ཀཱི་མཚན་མར་བཅོམ་ལྡན་འདས་ཀཱིས་བསན་པའཱི་ཡེ་ཤེས་གང་ཡཱིན་པ་དེ་ནཱི་རོ་རེ་ཕ་མོའི་ཡེ་ཤེས་སོ།",
    "རེ་མོ་ལྔ་པའཱི་རོ་རེའཱི་ཕྱག་རྒྱའཱི་ཚུལ་དུ་ཡོངས་སུ་བསོམ་པར་བྱའོ།",
    "དེ་བསོམ་པའཱི་ཕྱཱིར་དཀཱིལ་འཁོར་གང་གཱིས་དམ་ཚིག་སཱིན་པར་བྱེད་པ་དེ་ནཱི་རོ་རེ་ཕ་མོའི་ཡེ་ཤེས་ཀཱི་ཕྱག་རྒྱའཱི་དམ་ཚིག་གཱི་དཀཱིལ་འཁོར་རོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀང་ཡཱིན་ལ་རོ་རེ་སེམས་དཔའ་ཡང་ཡཱིན་པས་ན།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་སེམས་དཔའོ།",
    "དེའཱི་ཡེ་ཤེས་ཕ་མོ་དེ་བསོམ་པར་བྱ་བའཱི་ཕྱཱིར་དམ་ཚིག་ནཱི་དཀཱིལ་འཁོར་དེ་བྱཱིན་གཱིས་བརླབ་པ་ཞེས་བྱ་བའཱི་ཏཱིང་ངེ་འཛིན་གང་ཡཱིན་པའཱི་ཏཱིང་ངེ་འཛིན་དེ་ལ་བཅོམ་ལྡན་འདས་མཱི་བསོད་པ་ཡང་སོམས་པར་ཞུགས་ཏེ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀང་ཡཱིན་ལ་རོ་རེ་རཱིན་པོ་ཆེ་ཡང་ཡཱིན་པས་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་རཱིན་པོ་ཆེའོ།",
    "དེའཱི་ཡེ་ཤེས་ཕ་མོ་དེ་བསོམ་པར་བྱ་བའཱི་ཕྱཱིར་དམ་ཚིག་གཱི་དཀཱིལ་འཁོར་དེ་བྱཱིན་གཱིས་རློབ་པ་ཞེས་བྱ་བའཱི་ཏཱིང་ངེ་འཛིན་གང་ཡཱིན་པའཱི་ཏཱིང་ངེ་འཛིན་དེ་ལ་བཅོམ་ལྡན་འདས་རཱིན་ཆེན་འབྱུང་ལྡན་ཡང་སོམས་པར་ཞུགས་ཏེ།",
    "དེའཱི་ཡེ་ཤེས་ཕ་མོ་དེ་བསོམ་པར་བྱ་བའཱི་ཕྱཱིར།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀང་དེ་ཡཱིན་ལ་རོ་རེ་ལས་ཀང་དེ་ཡཱིན་པས་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་ལས་སོ།",
    "དེའཱི་ཡེ་ཤེས་ཕ་མོ་དེ་བསོམ་པར་བྱ་བའཱི་ཕྱཱིར་དམ་ཚིག་གཱི་དཀཱིལ་འཁོར་དེ་བྱཱིན་གཱིས་རློབ་པ་ཞེས་བྱ་བའཱི་ཏཱིང་ངེ་འཛིན་གང་ཡཱིན་པའཱི་ཏཱིང་ངེ་འཛིན་དེ་ལ་བཅོམ་ལྡན་འདས་གདོན་མཱི་ཟ་བར་གྲུབ་པ་ཡང་སོམས་པར་ཞུགས་ཏེ་རང་གཱི་རཱིག་པའཱི་མཆོག་འདཱི་གསུངས་སོ།",
    "དེ་ནས་དེ་བཞཱིན་གཤེགས་པ་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནཱི་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ལ་གནས་པའཱི་རོ་རེ་སེམས་དཔའ་ཡང་དག་པར་སྐུལ་བར་བྱེད་པའཱི་ཏཱིང་ངེ་འཛིན་སོན་ཏེ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོའི་རོ་རེ་ཞེས་བྱ་བ་ནཱི་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱིར་གཏོགས་པའཱི་ཡེ་ཤེས་ཕ་མོའི་རོ་རེ་ཏཱིང་ངེ་འཛིན་གང་ལ་རབ་ཏུ་སྣང་བ་དེ་ནཱི།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོའི་རོ་རེ་ཞེས་བྱ་བའཱི་ཏཱིང་ངེ་འཛིན་ཏོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ཀ་ནས་ཞེས་བྱ་བ་ནཱི་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ཀ་ལ་གནས་པའཱི་རོ་རེ་སེམས་དཔའཱི་ཏཱིང་ངེ་འཛིན་གཱི་ཡེ་ཤེས་བསྐུལ་བ་དེ་ལས་རོ་རེ་ཡེ་ཤེས་ཕ་མོའི་འོད་ཟེར་རྣམས་བྱུང་ནས་སོ།",
    "ཏཱིང་ངེ་འཛིན་གཱི་ཡེ་ཤེས་ཀཱི་རོ་རེའཱི་སྐུར་དམཱིགས་ཏེ་ཞེས་བྱ་བ་ལ།",
    "ཏཱིང་ངེ་འཛིན་གཱི་ཡེ་ཤེས་཈ཱིད་ནཱི་རོ་རེ་ཡཱིན་པས་ན་ཏཱིང་ངེ་འཛིན་གཱི་ཡེ་ཤེས་ཀཱི་རོ་རེའོ།",
    "བཅོམ་ལྡན་འདས་རོ་རེ་སེམས་དཔར་གྱུར་ཏེ་ཞུགས་པའོ།",
    "བཅོམ་ལྡན་འདས་རོ་རེ་སེམས་དཔའ་དེ་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་ཡེ་ཤེས་ཕ་མོའི་ཏཱིང་ངེ་འཛིན་གཱིས་བསྐུལ་བ་དང་།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོའི་དམ་ཚིག་ཆེན་པོའི་རོ་རེ་བརན་པར་བྱ་བའཱི་ཕྱཱིར།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ཀ་ནས་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་འོད་ཟེར་དུ་གྱུར་ནས་བྱུང་སེ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོའི་དམ་ཚིག་ཆེན་པོའི་རོ་རེ་འདཱི་གསུངས་པ་ཡཱིན་ཏེ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་དུ་གཏོགས་པ་ཡང་ཡཱིན་ལ་ཡེ་ཤེས་ཕ་མོ་ཡང་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོ་ཡང་ཡཱིན་ལ་དམ་ཚིག་ཆེན་པོའི་རོ་རེ་ཡང་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོ་དམ་ཚིག་ཆེན་པོའི་རོ་རེའོ།",
    "རོ་རེ་ནཱི་དམ་ཚིག་ཆེན་པོའི་དོན་སྒྲུབ་པར་བྱེད་པའཱི་རོ་རེ་ཡཱིན་པས་ན་དམ་ཚིག་ཆེན་པོའི་རོ་རེའོ།",
    "སྨྲས་མ་ཐག་ཏུ་ཞེས་བྱ་བ་ནཱི་བསན་པའཱི་རེས་ཐོགས་཈ཱིད་ལའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོ་དེ་཈ཱིད་རོ་རེའཱི་དབྱཱིབས་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཕ་མོའི་རོ་རེའཱི་དབྱཱིབས་སོ།",
    "རོ་རེ་ཕ་མོ་བདག་སེ་ཆེ།",
    "ཕ་བའཱི་རོ་རེའཱི་བདག་཈ཱིད་ཀང་བདག་ཡཱིན་ལ།",
    "སྣའཱི་རེ་མོ་ལ་གནས་ཤཱིང་ཕ་མོ་ཡཱིན་པ་ལས་ཀང་དེ་ལྟར་སྣང་བའོ།",
    "ཤཱིན་ཏུ་ཕ་བའཱི་རོ་རེ་དེའཱི་གནས་སྣའཱི་རེ་མོ་ཡཱིན་པའཱི་ཏཱིང་ངེ་འཛིན་གཱི་དམཱིགས་པར་བསན་ནས།",
    "ད་ནཱི་རབ་ཏུ་ཕ་བའཱི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་མཚན་མ་རྒྱས་པར་བྱ་བའཱི་ཚུལ་གཱིས་ཞེས་བྱ་བ་ལ་སོགས་པས་རྣལ་འབྱོར་པ་རྣམས་ལ་བསོམ་པའཱི་ཚེ་མཚན་མ་གང་ཞཱིག་སེ་བར་འགྱུར་བ་དེ་སོན་ཏོ།",
    "རབ་ཏུ་ཕ་བ་ཡང་དེ་ཡཱིན་ལ་རོ་རེ་ཡང་དེ་ཡཱིན་པས་ན་རབ་ཏུ་ཕ་བའཱི་རོ་རེའོ།",
    "རབ་ཏུ་ཕ་བའཱི་རོ་རེ་ཡང་ཡཱིན་ལ་ཡེ་ཤེས་ཀང་ཡཱིན་པས་རབ་ཏུ་ཕ་བའཱི་རོ་རེ་ཡེ་ཤེས་སོ།",
    "དེའཱི་མཚན་མ་ཡཱིན་པས་ན་རབ་ཏུ་ཕ་བའཱི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་མཚན་མའོ།",
    "དེ་ལ་རེག་པའཱི་མཚན་མ་ནཱི་རྣལ་འབྱོར་པས་སྣའཱི་རེ་མོར་བསོམས་པ་ན།",
    "འདཱི་ནཱི་རེག་པའཱི་མཚན་མའོ།",
    "གཟུགས་ཀཱི་མཚན་མ་ནཱི་སྣའཱི་རེ་མོར་རོ་རེ་གངས་ལྟར་དཀར་བ་ལ་སོགས་པ་ཇཱི་ལྟ་བུར་བསོམས་པ་དེ་ལྟ་བུའཱི་རོ་རེ་཈ཱིད་སྣའཱི་རེ་མོ་ལས་ལོགས་ཤཱིག་པའཱི་཈ེ་འཁོར་གཞན་ན་ཡང་སྣང་བར་འགྱུར་ལ།",
    "དེ་ལྟར་ན་རབ་ཏུ་ཕ་བའཱི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་མཚན་མ་ནཱི་རྣམ་པ་ག་཈ཱིས་སོ།",
    "དེའཱི་སྤྲོ་བར་བྱ་བ་ནཱི་རབ་ཏུ་ཕ་བའཱི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་མཚན་མ་རྒྱས་པར་བྱ་བ་དང་།",
    "དེ་ལྟར་རཱིམ་གཱིས་ནམ་མཁའཱི་དབྱཱིངས་ཐམས་ཅད་རབ་ཏུ་ཕ་བའཱི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་མཚན་མ་རྣམས་ཀཱིས་ཁབ་པར་བྱས་སོ་ཞེས་བྱ་བ་ནཱི་སྤྲོས་པས་ཁབ་པའོ།",
    "ཡེ་ཤེས་ཀཱི་རོ་རེའཱི་དབྱཱིངས་སུ་བདག་཈ཱིད་བྱཱིན་གཱིས་བརླབས་ཞེས་བྱ་བ་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེ་སེམས་དཔའཱི་རྣལ་འབྱོར་གཱི་སོབས་ཀཱིས་རོགས་པར་བསྒྲུབས་ནས་ཞུགས་པའོ།",
    "དེ་ནས་དེ་཈ཱིད་ཀཱི་ཚེ་ན་ཞེས་བྱ་བ་ནཱི་ཕ་བའཱི་རོ་རེ་ཡེ་ཤེས་ཀཱི་སྐུས་ཁབ་པའཱི་དུས་཈ཱིད་དུའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱིར་གཏོགས་པའཱི་རོ་རེའཱི་ཡེ་ཤེས་ཕ་མོ་གང་ཡཱིན་པ་དེ་བྱཱིན་གཱིས་བརླབ་པའཱི་ཕྱཱིར།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཡེ་ཤེས་ཀཱི་རོ་རེ་ལས་ཞེས་བྱ་བ་ལ།",
    "ཡེ་ཤེས་ཕ་མོ་ནཱི་ཡེ་ཤེས་ཀཱི་རོ་རེའོ།",
    "སཱིང་པོ་འདཱིས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེ་བསྐུལ་བ་དང་།",
    "ཕ་མོའི་རོ་རེའཱི་ཡེ་ཤེས་ཀཱི་དབྱཱིབས་ཏེ།",
    "ཡེ་ཤེས་ཕ་མོར་འཇུག་པའཱི་ཚུལ་གཱིས་ཞེས་བྱ་བ་ལ།",
    "ཡེ་ཤེས་ཕ་མོ་ནཱི་རོ་རེའཱི་ཡེ་ཤེས་ཏེ།",
    "དེར་འཇུག་པའཱི་རྣལ་འབྱོར་ནཱི་ཡེ་ཤེས་ཕ་མོར་འཇུག་པའཱི་ཚུལ་ལོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ལ་ཞེས་ཁད་པར་མེད་པར་གསུངས་མོད་ཀཱི།",
    "དེའཱི་སེང་དུ་ཕ་མོའི་རོ་རེའོ།",
    "བསོམས་པའཱི་སོབས་ཀཱིས་ཡེ་ཤེས་རེ་རེས་ཀང་ཁམས་གསུམ་པ་ཐམས་ཅད་ཁབ་པ་ཡཱིན་པའཱི་ཕྱཱིར་རོ།",
    "རོ་རེ་སེམས་དཔའཱི་ཡེ་ཤེས་ཡཱིན་པས་ན་རོ་རེ་སེམས་དཔའཱི་ཡེ་ཤེས་སོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ནཱི་རོ་རེ་སེམས་དཔའ་ལ་སོགས་པ་བཞཱིའོ།",
    "དེའཱི་ཕྱག་རྒྱ་རྣམས་ལས་ཕྱག་རྒྱ་ཆེན་པོ་ལ་དམཱིགས་པ་ལས་སེམས་རེ་གཅཱིག་པའཱི་ཁད་པར་ལ་ནཱི་ཏཱིང་ངེ་འཛིན་ཆེན་པོ་ཞེས་གསུངས་སོ།",
    "དེ་ནས་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ཕྱག་ན་རོ་རེ་ཞེས་བྱ་བ་ནཱི་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་ཡཱིན་པའོ།",
    "རང་གཱི་ཐུགས་སུ་ཞེས་བྱ་བ་ནཱི་ཕ་མོའི་རོ་རེའཱི་གཟུགས་སུ་བཞུགས་པའཱི་རཱིན་ཆེན་འབྱུང་ལྡན་གཱི་ཐུགས་སོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀང་ཡཱིན་ལ་རོ་རེ་ཡང་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའོ།",
    "རོ་རེ་རཱིན་པོ་ཆེས་མཚན་པའཱི་ཏཱིང་ངེ་འཛིན་ཡཱིན་པས་ན་རོ་རེའཱི་ཏཱིང་ངེ་འཛིན་ཏོ།",
    "དེ་ནས་ཕྱག་ན་རོ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པའཱི་གཞུང་གཞན་སོས་པ་ཡཱིན་ཏེ།",
    "རོ་རེ་སཱིང་པོ་ནཱི་དེ་བཞཱིན་གཤེགས་པ་དང་རོ་རེ་རྣམས་ཀཱི་སཱིང་པོ་སེ།",
    "རང་གཱི་སཱིང་ག་དང་རོ་རེའཱི་སཱིང་པོ་ནཱི་རང་གཱི་སཱིང་ག་དང་རོ་རེའཱི་སཱིང་པོའོ།",
    "དེར་ཞུགས་ནས་སཱིང་པོ་བཞཱི་འབྱུང་པའཱིབའཱི་རྣལ་འབྱོར་རོ་རེའཱི་དབྱཱིབས་སུ་བདག་཈ཱིད་བྱཱིན་གཱིས་བརླབས་ནས་ཞུགས་པའོ།",
    "རང་གཱི་སཱིང་པོ་དང་རོ་རེའཱི་ཐུགས་ཀ་ནཱི་རང་གཱི་སཱིང་པོ་རོ་རེའཱི་ཐུགས་ཀའོ།",
    "དེ་཈ཱིད་རོ་རེ་ཡཱིན་པས་ན་རང་གཱི་སཱིང་པོ་རོ་རེའཱི་ཐུགས་ཀའཱི་རོ་རེ་སེ།",
    "ཡེ་ཤེས་ཕ་མོར་འཇུག་པའཱི་ཚུལ་གཱིས་ཞེས་བྱ་བ་ནཱི་སྣའཱི་རེ་མོ་ལས་སྣའཱི་བུ་ག་གཡས་པར་ཅཱི་ནས་ཀང་མཱི་རེག་པར་འཇུག་པ་དེ་ལྟ་བུའཱིབའཱི་གཟུགས་སུ་བདག་཈ཱིད་སྤྲུལ་ནས།",
    "རྣལ་འབྱོར་གང་གཱིས་འཇུག་པ་དེ་ནཱི་ཡེ་ཤེས་ཕ་མོར་འཇུག་པའཱི་ཚུལ་ལོ།",
    "རོ་རེའཱི་ཐུགས་དེར་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཕ་མོ་ཐམས་ཅད་དུ་སོང་བ་དེ་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་སུ་ཞུགས་པའོ།",
    "ཡང་རོ་རེ་ཤཱིན་ཏུ་ཕ་མོའི་དབྱཱིབས་སུ་ཞེས་བྱ་བ་ནཱི་རང་གཱི་སཱིང་པོ་བསེད་པའཱི་ངོ་བོ་཈ཱིད་དུ་བྱཱིན་གཱིས་བརླབས་ཏེ་བཞུགས་པའོ།",
    "ཐུབ་པར་དཀའ་བ་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེ་གོ་ཆ་སེ།",
    "བདུད་ཐམས་ཅད་ཀཱི་དཀཱིལ་འཁོར་འཇོམས་པ་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེ་གནོད་སཱིན་ཏེ་དེའཱི་ཡེ་ཤེས་སོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་འཆཱིང་བའཱི་ཡེ་ཤེས་ནཱི་རོ་རེ་ཁུ་ཚུར་ཏེ།",
    "ལྷག་མ་རྣམས་ཀཱི་སཱིང་པོ་དང་ཕྱག་རྒྱ་རྣམས་ནཱི་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པ་ཡཱིན་པར་ཤེས་པར་བྱའོ།",
    "གང་གཱི་ཕྱཱིར་གདོན་མཱི་ཟ་བར་གྲུབ་པའཱི་ཐུགས་ཀ་ནས་སཱིང་པོ་བཞཱིར་གྱུར་ཏེ་བྱུང་བ་སོས་མོད་ཀཱི།",
    "ཡེ་ཤེས་ཕ་མོའི་མཚན་མས་ཁབ་པའཱི་ཚུལ་གཱིས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རོ་རེ་ཕ་མོས་ཁབ་པར་བྱེད་པའཱི་ཚེ།",
    "གྱུར་པ་ནཱི་རེད་པའོ།",
    "རང་རང་གཱི་མཚན་མ་རོ་རེ་ལ་སོགས་པ་཈ཱིད་ཀཱི་ཐུགས་ཀའཱི་ཟ་བའཱི་དཀཱིལ་འཁོར་ལ་བཞག་ནས་རོ་རེ།",
    "དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ཆེན་པོ་དགོས་པའཱི་ཚུལ་གཱིས་ཞེས་བྱ་བ་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ཆེན་པོའི་དབྱཱིབས་སུའོ།",
