    "མི་གསལ་ན་ལོ་དྲུག་ཅུ་ལོན་ཡང་གཞན་ལ་གནས་ཏེ་འདུག་པར་བྱའོ།",
    "གནས་ཀྱི་སློབ་དཔོན་ཏེ་གང་ནུབ་གཅིག་ཙམ་ཡང་གནས་བཅས་ཏེ་འདུག་པའོ།",
    "ནམ་མཁའ་ལ་འདུག་སྟེ་ས་ལ་འདུག་པའི་ལས་བྱེད་ན་བྱས་པ་མ་ཡིན་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ཙོག་པུས་འདུག་པའོ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱང་གཞན་ལ་གནས་བཅས་ཏེ་འདུག་པར་བྱའོ།",
    "འདུག་ཏུ་མི་འདོད་པ་ནི་མ་ཡིན་ནོ།",
    "དེར་གསོ་སྦྱིན་གཉིས་པའི་བར་དུ་འདུག་པར་མི་བྱའོ།",
    "དབྱར་ཕྱི་མར་ཉེ་བར་ཞུགས་ནས་ཡང་སོ་སོར་བརྟགས་ལ་ཟླ་བ་གཉིས་ཀྱི་བར་དུ་འདུག་པར་བྱའོ།",
    "རྒྱང་གྲགས་ལྡན་འདུག་ན་ཉི་མ་དྲུག་གམ་བདུན་ཞིང་ངོ།",
    "མཚམས་ཀྱི་ནང་ན་འདུག་ན་དུས་གསུམ་དུའོ།",
    "དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན་ཞེས་བྱ་བ་ནི་ནང་པ་དང་།",
    "མ་འདུག་ཤིག་ཅེ་འམ།",
    "འདུག་པར་བྱ་བ་དང་།",
    "ཇི་ལྟར་གཞན་དུ་ཕྱོགས་ཤིང་འདུག་པར་མི་བྱ་བ་དང་།",
    "ནམ་མཁའ་ལ་འདུག་པས་ས་ལ་འདུག་པ་ལ་དང་།",
    "ས་ལ་འདུག་པས་ནམ་མཁའ་ལ་འདུག་པ་འམ།",
    "མཚམས་ཀྱི་ནང་ན་འདུག་པས་མཚམས་ཀྱི་ཕྱི་རོལ་ལ་འདུག་པ་འམ་སླར་ཟློག་པ་ཡང་རུང་སྟེ།",
    "སྡོད་ཅིག་ཅེས་བྱ་བ་ནི་ཅང་མ་སྨྲ་བར་འདུག་ཤིག་པའོ།",
    "འདུག་ཀྱང་ལག་བས་འཛིན་ལ་འགྲོ་ཡང་དེ་བཞིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཉེ་དགའ་ལས་བརྩམས་ནས་བྲམ་ཟེ་དང་གཙང་སྦྲ་འདོད་པའི་ཁྱིམ་དུ་ཁྲི་ལ་འདུག་པའི་ཕྱིར་བཅས་སོ།",
    "མ་གཟས་པར་ཞེས་བྱ་བ་ནི་མ་འོངས་པར་ཁ་གདགས་ཏེ་འདུག་པས་ན་ཁར་བོང་བ་བཅུག་ནས་ཉེས་པའི་ཕྱིར་རོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཞེས་བྱ་བ་ནི་ཁྱིམ་བདག་ལ་དྲི་བར་བྱའོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱ།",
    "མདུན་ནམ་རྒྱབ་ཏུ་འདུག་ན་མ་འགྱེད་ཤིག་མ་འཐབ་ཤིག།",
    "དེ་ནས་མདུན་དུ་འདུག་ལ་བསྔགས་པ་དང་།",
    "ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་བེ་ཙ་ན་ར་ཀྵི་ཏས་བསྒྱུར་བའོ།",
    "ཁྱིམ་དུ་འདུག་པ་ལས་ཕྱིར་འགྲོ་ཉུང་བ་དང་།",
    "འགྲོལ་བྱེད་པའི་འབོད་སྐད་སྒྲོག་དུས་དེར་ཧྥ་རན་སི་ནས་བྱ་བ་འདི་ལྟ་བུ་ཞིག་བྱུང་བ་སྟེ།",
    "ཡུང་ཆིན་གསུམ་གྱིས་གཡུལ་སའི་དམག་ཨུ་བཙུགས་པ་དེ་ང་རང་ཉིད་ཀྱིས་བལྟས་ན་ཧ་ཅང་མི་འགྲིག་པ་ཞིག་ཡིན།",
    "ཡང་བྲག་ཁུང་དུ་དུས་ཚོད་མང་པོར་འདུག་མི་བཟོད་པས།",
    "མི་ལ་ལས་ད་རུང་རང་འགུལ་གྱིས་རང་ཉིད་ཀྱི་མེ་མདའ་དང་རྫས་མདའ་མི་གཉིས་ཀྱིས་འཁུར་དགོས་པ་ཕྱིར་སྤྲད།",
    "གཡོན་ལྷུང་ཉེན་མཆོང་རིང་ལུགས་པས་ཀྲུང་གོའི་གསར་བརྗེའི་ཡུན་རིང་རང་བཞིན་དང་དོ་མཉམ་མིན་པའི་རང་བཞིན་ལ་རྒྱུས་ལོན་བྱུང་མེད།",
    "ཕམ་ཁའི་ཕྱོགས་ལ་འདང་རྒྱག་རྒྱུ་ཕལ་ཆེར་བརྗེད་འདུག་ཁོ་ཚོས་གནས་བབ་དངོས་ཅི་ལྟར་ཡིན་པར་མི་ལྟ་བ་དང་འོས་མེད་འགྲིག་ཐབས་གང་ཡིན་ཚང་མར་ཁས་མི་ལེན་ཞིང་།",
    "ཀྲུང་གུང་ཀྲུང་དབྱང་བྱང་ཕྱོགས་ཅུས་ས་ཞིང་གསར་བརྗེའི་དམག་འཁྲུག་དུས་སྐབས་ཀྱི་ཡིག་ཁུག་ཅེས་པའི་ཤོག་ངོས་ནས་སྟེང་དུ་འཁོད་ཡོད།",
    "ཀྲུང་གུང་ཀྲུང་དབྱང་བྱང་ཕྱོགས་རུས་ས་ཞིང་གསར་བརྗེའི་དཱམག་འཁྲུག་དུས་སྐབས་ཀྱི་ཡིག་ཁུག་ཅེས་པའི་ཐོག་ངོས་ནས་སྟེང་དུ་འཁོད་ཡོད།",
    "རུ་ཁག་ཡོངས་ཀྱི་ཟ་མ་དང་དམག་མཁོ་དངོས་རྫས་གྲབས་གསོག་བྱེད་པར་འགན་འཁུར་དུ་བཅུག་དུས་དེར།",
    "དགྲ་དམག་མང་ཞིང་རང་དམག་ཉུང་བས་ཐོན་བཞི་བ་ག་དུས་ཡིན་ཡང་རྩ་རྫོགས་བྱེད་པའི་ཉེན་ཁར་སླེབས་ཡོད།",
    "དགྲ་དང་རང་ཕྱོགས་གཉིས་ཀྱི་སྟོབས་ཤུགས་ལ་གནམ་ས་ལྟ་བུའི་ཁྱད་པར་ཤོར་བར་བརྟེན།",
    "རྙོག་འཛིང་རང་བཞིན་ལའང་གང་ལེགས་སྒོས་ངོས་འཛིན་བྱས་པ་མི་འདང་བ་ཕྱིར་མངོན་ཡོད།",
    "ཁོང་རང་ཉིད་ཧྲན་ཧའེ་ཀོན་འགག་སྒོའི་ནང་ལོགས་སུ་བསྐྱོད་དེ་རྒྱབ་རོགས་ཞུ་འབུལ་གྱིས་ཡང་བསྐྱར་འཇའ་འགོག་བྱེད་པར་འདོད་དོ།",
    "ང་རང་ཧྲན་ཧའེ་ཀོན་བཀག་སྒོའི་ནང་ལོགས་སུ་ཕྱིན་ནས་རོགས་སྐྱོར་གྱི་ཞུ་བ་ཕུལ་ཏེ།",
    "དེ་ལྟར་མ་བྱས་ཚེ་ང་རང་ཤི་ཡང་མིག་བཙུམ་མི་ཐུབ་ཅེས་བཀོད་ཡོད།",
    "གཉེན་སྒྲིག་བྱས་ཚར་རྗེས་ཁོང་བུགཉིས་ཤར་ནུབ་གཉིས་སུ་བསྐྱོད་ནས་རང་རང་ས་ནས་ལོགས་དགར་སྡོད་པའི་འཚོ་བའི་མགོ་བརྩམས་ལོར།",
    "ཁོ་རང་ནན་ཅིན་ནས་ས་ཆ་གཞན་ཞིག་ལ་གནའ་རྫས་རྟོག་དཔྱོད་ཏུ་སྐྱོད་པའི་ལམ་བར་དུ་ཅི་ནན་བརྒྱུད་ཀྱང་ཁོ་རང་ཁྱིམ་དུ་མ་ལོག་པར་བཟའ་ཟླ་ལ་འཕྲིན་ཡིག་ཅིག་བྲིས།",
    "ཉིན་དེར་ཁོ་རང་ཁྲང་ཧྲ་རུ་བསྐྱོད་དགོས།",
    "ཁོ་རང་འཇིག་རྟེན་གསར་བ་ཞིག་ཏུ་སླེབས་པའི་སྣང་བ་ཤར།",
    "ཁོ་རང་ནི་དཀའ་སྡུག་མྱོང་ཐུབ་པའི་མི་ཞིག་ཡིན་ཏེ།",
    "ཁོ་རང་མཚར་བོ་སྐྱེས་ནས་གུང་ཁྲན་ཏང་ཡོན་ལའང་ནོར་འཁྲུལ་འབྱུང་སྲིད་དམ་སྙམ་བྱུང་།",
    "ཁོ་རང་སྔོན་ཐོན་དུ་རྫུས་ནས་བཙན་རྒྱལ་རིང་ལུགས་འལ་ངོ་རྒོལ་དང་།",
    "དེ་དུས་ཁོ་རང་ལོ་ཡིན་ནོ།",
    "སྐྱེས་བུ་ཞིག་མི་རིགས་བགཞན་གྱི་བྲན་གཡོག་བྱེད་རྒྱུ་དཔེ་མི་སྲིད་ཅེས་གསུངས།",
    "རྟག་པར་འཇའ་རྫུན་དམག་བརྒྱ་ཕྲག་འགའ་བཅའ་སྡོད་བྱས་འདུག་ཏ་ཧྲ་གཙང་བོའི་འཐབ་འཁྲུག་འདི་ནི་དགྲ་བོ་དེ་དག་རྩ་མེད་དུ་གཏོང་བའི་ཆེད་དུ་ཡིན།",
    "ཁོ་རང་ལོར་ཀྲུང་གོ་གུང་ཁྲན་ཏང་དུ་ཞུགས་ཤིང་།",
    "ཁྲོམ་སྐོར་རུ་ཁག་ཧར་པེན་གྱི་རླངས་འཁོར་འབབ་ཚིགས་ཀྱི་ཉེ་འཁོར་དུ་སླེབས་ཙ་ན།",
    "དཔུང་གཤུག་བྱེད་པ་འི་སྐབས་སུ་མགོ་ལ་མེ་མདེལ་ཕོགས་ནས་གཟི་བརྗིད་ངང་རང་སྲོག་ཤོར།",
    "ཁོས་ང་རང་ལམ་འདི་དང་ས་ཆ་འདིར་གསལ་ཆ་ཡོད་པས་རྗེས་ཀྱི་མི་རྣམས་ཀྱིས་ངའི་བཀའ་ལ་ཉོན་ཞེས་བཤད།",
    "སྤྱན་གཉིས་ཀྱི་རྩྭའི་སྤྱིལ་བུ་ཞིག་ལས་མི་འདུག་པས།",
    "ཁོའི་ཁྱིམ་མི་ཡོངས་དབུལ་ཕོངས་ཀྱིས་མནར་ཞིང་འདུག་པསསློབ་སྦྱོང་འཕྲོ་མཐུད་བྱེད་མ་ཐུབ་པར་ཕྱིར་རང་ཡུལ་དུ་མི་ལོག་ཀ་མེད་བྱུང་།",
    "དུས་འདིར་སུང་ཀྲུང་ཧྲན་གྱིས་ལྷོ་ནུབ་ཕྱོགས་ཀྱི་དམག་སྟོབས་ཆེ་བ་རྣམས་བསྡུས་ཏེ་བསྟན་པ་སྐྱོང་བ་ཞེས་པའི་འཐབ་འཁྲུག་སློང་བཞིན་པར་འཁེལ་བར་འདུག་ཅིང་།",
    "གཞན་ད་ལྟའི་ལམ་ལུགས་འདིས་ཀྱང་རང་གཞན་ཀུན་ལ་མི་བཟོད་པའི་སེམས་ཤིག་སྦྱིན་པར་བྱེད་པས་ཡིན།",
    "རྒྱང་རིང་པོའི་དམིགས་འབེན་ཞིག་ལ་བསྙེགས་པ་ཡིན་༩ ཞེས་བྲིས་འདུག་ལོའི་ཟླ་པའི་བཙན་གནོན་རྣམས་བཟློག་པ་དང་།",
    "གུང་ཁྲན་རིང་ལུགས་ཀྱི་ལས་དོན་ཡར་ངོའི་ཟླ་ལྟར་འཕེལ་བ་ལའང་རང་ཉིད་ཀྱི་ཡོད་ཚད་ཕུལ་བ་ཡིན་ནོ།",
    "རྒྱལ་སྲུང་དམག་དང་རང་སྲུང་དམག་གཉིས་ཀྱི་མཉམ་འབྲེལ་ཟླ་གཉིས་ལྷག་རིང་ལ་མ་གཏོགས་རྒྱུན་སྐྱོང་མ་ཐུབ།",
    "ང་ལ་ཚགས་ལཱ་རྙིང་པ་ཞིག་གོན་རྒྱུ་ཡོད་ཅེས་སྨྲས་ཏེ་གསར་པ་དེ་ཡང་ཕྱིར་འབྲེལ་ཡོད་ལས་ཚན་ལ་སྤྲད་འདུག་པའོ།",
    "དེ་མིན་ཁོ་རང་གཏམ་རྒྱུད་འལ་ཉན་རྒྱུར་དགའ་བོ་ཡོད།",
    "དེ་བས་ཁོ་རང་ལོ་དགུར་སླེབས་པ་ན་སྒེར་བཙུགས་སློབ་གྲུར་འདོན་པར་བསྐྱལ།",
    "པེ་ཅིན་ཟློས་གར་འཁྲབ་སྟོན་བྱས་སྟབས་ཚང་མ་ཁོ་ལ་དགའ་བོ་འདུག་ཟླ་པའི་ཉིན་ཞིག་ལ།",
    "ཁོ་རང་ངོས་ནས་སྐབས་འཚོལ་རིང་ལུགས་ལ་རོགས་རམ་བྱས།",
    "ཁྲི་དཔུང་སྤྱི་ཁྱབ་བཀོད་འདོམས་པུའུ་ཡིས་བཀོད་པའི་དམག་འཐབ་ཀྱི་འཆར་གཞིར་ཁོ་རང་ཉིད་ཀྱིས་དངོས་སུ་ཞིབ་འཇུག་བྱེད་པ་ཡིན།",
    "ཁོ་རང་འཆི་ལ་ཉེ་སྐབས་ལག་པ་གཡོན་ཕྱོགས་སྐྲངས་ཀྱང་ཁོ་རང་བློ་སེམས་མ་ཕམ་པར།",
    "འཆི་རྒྱུར་ང་རང་མི་སྒྲོག་ལ།",
    "ལོ་ངོ་བཅོ་ལྔའི་རིང་རང་ཉིད་དང་མཉམ་དུ་དཔུང་བ་མཉམ་གཤིབ་ཀྱིས་འཐབ་འཛིང་བྱས་མྱོང་བའི་འཐབ་གྲོགས་ལ་མྱ་ངན་བྱས་ཡོད་དེ།",
    "དགྲ་བོའི་འཇིགས་སྐུལ་ལ་འཆི་རྒྱུར་སྐྲག་ན་གུང་ཁྲན་ཏང་ཡོན་མིན་ཞེས་པའི་ལན་བཏབཧྲི་ཡུས་རྨིན་བའི་གྱིས་དཔའ་ངར་ལྡན་པའི་ངང་རང་སྲོག་བློས་བཏང་།",
    "ཁོས་བྱ་བའི་སྟེང་སྔར་ལས་ལྷག་པའི་སེམས་ཤུགས་དང་རང་རྟོགས་བསྐྱེད།",
    "ཡུལ་དམག་རྣམས་ནི་རྣམ་རིག་བཀྲ་ཞིང་བློ་རིག་ལྡན་པའི་འཐབ་གྲོགས་ཆུང་ཆུང་དེ་ལ་དགའ་བོ་འདུག་ལོའི་དཔྱིད་ཀར།",
    "ཁོ་རང་ངོ་གནོངས་ཏེ་མགོ་བོ་མར་སྒུར།",
    "ལུང་ཧུ་ད་དུང་ཚུར་བླངས་མེད་པས་ལས་འགན་ཡོངས་སུ་འགྲུབ་ཡོད་པར་རྩིས་ག་ལ་ཆོག་ང་རང་ཁོ་ན་ལས་མེད་ཀྱང་ལས་འགན་ལེགས་འགྲུབ་བྱེད་དགོས་ཞེས་བཤད།",
    "ཁོ་རང་དཀའ་ཁག་ལ་འཕྲད།",
    "ཏུང་ཚུན་རུའེ་ཡིས་ཟམ་པའི་སྟེང་ལ་ལྟ་ཞིང་ཡང་མདུན་ཕྱོགས་སུ་འགྱེལ་བཞིན་པའི་འཐབ་གྲོགས་ཚོར་བལྟས་པས་ཁོ་རང་ལ་བྲེལ་འཚུབ་སྐྱེས།",
    "མ་དཔེ་རུ་མཆན་རྟགས་གསལ་མི་འདུག་བློན་ཕྲུག་གནམ་ལྷ་རྒྱལ།",
    "འཁྲབ་གཞུང་རྩོམ་པ་པོ་ཁོང་ནི་ཉེ་བའི་ལོ་ཤས་རིང་རང་ལྗོངས་ཀྱི་གཏམ་བརྗོད་ཟློས་གར་གྱི་འཁྲབ་གཞུང་རྩོམ་པ་པོའི་ཁྲོད་ནས་གྲུབ་འབྲས་ཆེ་ཙམ་ཐོབ་པའི་རྩོམ་པ་པོ་ཞིག་ཡིན་ཞིང་།",
    "ཁྱེད་རང་ཕེབས་དང་།",
    "ཕར་ཙམ་འདི་པའ་རྐུབ་བཀྱག་མང་པོ་འདུག་ང་ཡིན་གཅིག་མིན་གཅིག་ཨང་ཀི་བརྒྱད་པ་འདི་དགོས་ཡོད།",
    "ཁྱེད་རང་སུ་བསྒུགས་མཁན་ཡིན་པའ།",
    "ཁྱེད་རང་བདེ་སྐྱིད་ཀྱི་དགའ་རོགས་ཡིན་ལགས།",
    "སྣང་ཆུང་བྱེད་བཞིན་ང་རང་གཉིས་ཀྱི་ཆ་རྐྱེན་འདི་འདྲ་ཤོར་ཚར་ནི་མེད་པའ།",
    "མ་གཞི་ནས་ང་རང་གཉིས་ཆ་རྐྱེན་འགྲན་བསྡུར་གཅིག་བཏང་ན་ཁྱེད་རང་བསྡུར་ཕོད་པ་འདུག་ཀས་ལགས།",
    "བྱས་ན་ང་རང་གཉིས་ཤུགས་ཆེ་ལོས་བསྡུར་གས།",
    "ང་རང་གཉིས་དྲག་རྩལ་གཅིག་བསྡུར་གས།",
    "ད་ང་གཉིས་གཟུགས་པོའི་ཐོག་ལ་བསྡུར་ཡས་ཁོ་རང་བསྡད་མི་འདུག་ཀའ།",
    "རྒྱུ་ཨཨོའོ་བུ་ཁྱེད་རང་རྒྱ་ནག་ལ་ཕེབས་མྱོང་ཡོད་པའི་བཟོ་འདྲ་གཅིག་མི་འདུགགཞོན་ནུ།",
    "བྱས་ན་ང་རང་གཉིས་ཐང་རྒྱལ་རབས་ཀྱི་སྙན་ངག་བསྐྱོར་མཁས་ལོས་གཅིག་བལྟ་ཀས།",
    "ད་སྤོ་བོ་ལགས་ཁྱེད་རང་གཅིག་སྐྱོར་གནང་དང་།",
    "དེའི་ཁར་རང་རྒྱ་ནག་ཏུ་ལོ་དེ་གས་བསྡད་ནི་མེད་པར་བོད་ཡིག་ཅི་དའ་བརྗེད་མི་འདུག་གས།",
