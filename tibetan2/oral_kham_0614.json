    "འབེབས་པ་དེའི་སང་ཞོགས་རྩེག་དུས་བཞིན་ཚུར་ཉུང་བས་འབེབས་སོ།",
    "ཞེས་པའི་དེབ་སྟོད་སྨད་བྲིས་པ་དེའི་ནང་ཞིབ་འཁོད་ཡོད་འདུག་པ།",
    "བབས་ཆགས་ཅན་ཞིག་བཅས་ཕེབས་བྱུང་བར་ཁོང་ནས་ཁྱེད་རང་བོད་མིའི་གཞིས་སྒར་གྱི་འགོ་འཛིན་ཡིན་ནམ་ཞེས་དྲི་བ་གནང་བར་དེ་ལན་ཞུས་པ་དང་།",
    "རི་ཀླུང་ས་བབས་བཅས་ལ་ཐུགས་སྣང་གནང་སྟེ་ཡུལ་ལྗོངས་ཡག་པོ་འདུག་ཅེས་དང་།",
    "རང་རང་དགོས་མཁོ་ཕུད་པས་ངའི་སྐྱེ་ཡུལ་དང་མི་ཚེའི་འགན་འཁུར།",
    "དེ་འདྲ་ཡིན་དུས་རང་ས་ནས་མ་ནོར་ཚེ་མ་འོངས་པར་ལོ་མང་རིམ་མཐུད་དུ་ལས་གཞི་འདི་ཕན་ཐོགས་ཆེ་ཤོས་ཀྱི་གྲལ་ཞིག་ཏུ་རྩིས་ཆོག་པ་ཡིན་བསམ་གྱི་འདུག་༦ངའི་སྐྱེ་ཡུལ་དང་མི་ཚེའི་འགན་འཁུར།",
    "གསང་སྤྱོད་ཀྱི་བརྒྱ་ཆ་༥ འབབ་ལ་སྒོར་༡༧༢༡ཙམ་བྱེད་ཀྱི་འདུག་ལགས།",
    "འདི་ལོ་ཕྱི་ཟླ་༤༤ པ་ནས་བཟུང་རང་གཞུང་དབུས་ཀྱི་གནས་སྟངས་དང་།",
    "གཞན་ལ་མི་འདུག་མི་འདུག་ཟེར།",
    "དབྱར་ག་འོང་གའི་དཀྱིལ་དུ་ག་འདྲ་འགྲོ་དགོས་འབའ་ཞེས་གཙང་པའི་ཁ་རྒྱན་ལ་ཡོད་པ་བཞིན་བྱས་ན་འགྲིགས་ཀྱི་མི་འདུག་བསམ་སྟེ་ལས་ཀ་དེར་འཇུག་པ་ཡིན།",
    "ནང་དྲུང་གཞོན་པ་ནས་ཀྱང་ཡུན་རིང་དུས་ཚོད་བཏང་སྟེ་མཇུག་བསྡོམས་བགྱིས་པས་ཆུ་མགོ་གངས་ལ་གཏུགས་ཟེར་བ་བཞིན་ནང་སྲིད་ལྷན་ཁང་རང་ལ་གཏུགས་ཡོད།",
    "དེ་མིན་མེ་ལ་བསྲེགས་ཅེས་བཀོད་གནང་འདུག་པ་དེ་ཉམས་ལེན་ཅི་ཐུབ་དང་།",
    "བོད་སྤྱིའི་བསྟན་སྲིད་ལ་གནོད་ཉེན་འདུག་པས་ཁྱེད་ཀྱིས་འཕྲལ་དུ་གཏད་རུལ་ཞིག་སྦ་དགོས་ཞེས་ཕེབས།",
    "གཏོང་གནང་མི་འདུག་པ་མ་ཟད།",
    "ནང་སྲིད་ཀྱི་དགོས་མཁོར་བགྲེས་ཡོལ་ཕྱིར་འགྱངས་ཞུས་པ་ཕྱི་དྲིལ་དུ་ལས་འགན་བཀོད་སྒྲིག་གནང་འདུག་པ་དེ་བཞིན་གཞན་མང་པོ་བྱུང་འདུག་པ་སྒྲིག་འགལ་དུ་མི་འགྱུར་རམ་སྙམ།",
    "གཏོང་གནང་མི་འདུག་པ་མ་ཟད།",
    "འདི་ག་ལས་ཁང་ནས་གོང་རིམ་ལ་སྙན་སེང་བཀའ་འཁྲོལ་ཁོང་རང་ནས་གནང་འཐུས་དང་།",
    "ཚེས་༨ ཉིན་བདེ་དོན་དང་རང་བདེན་ཚོགས་མི།",
    "རིམ་པ་དེ་དག་ནི་གཞུང་སྲོལ་མཛད་ལམ་ལྟར་ཡིན་འདུགདེ་རྗེས་རང་ཤག་ཏུ་འཁོད་བསྟུན་རྣམ་ཀུན་འབྲེལ་འདྲིས་དགའ་ཉེཚོས་མཇལ་དཪ་འབུལ་སྲོལ་ལྟར་ཁག་འགའ་ཤས་ཕེབས་ཏེ་འཚམས་འདྲི་གནང་ཞིང་།",
    "སྤྱིར་བཏང་རང་གཞན་སུ་དང་སུ་ཡིན་ཀྱང་།",
    "དེ་སྔོན་ཕྲན་དྲུང་ཚེའི་ལས་ཁུར་ཞུ་སྐབས་ཚོགས་གཙོས་བཀའ་ཤག་ཏུ་སྙན་སེང་གནང་ལམ་ཞིག་བྱུང་འདུག་ཀྱང་།",
    "བོད་རྒྱལ་ཁབ་མི་རིགས་དང་བཅས་པའི་ད་ལྟའི་གནས་སྟངས་བསྙེལ་མེད་ཐུགས་ལ་བཅངས་ཏེ་མིག་ལྟོས་བཟང་འགྲན་གྱི་སྒོ་ནས་རང་རང་ཁུར་འཁྲིའི་སྲི་ཞུ་སྒྲུབ་འོས་གང་ཅིར་ལྷག་བསམ་རྣམ་དག་རང་ནུས་གང་ཡོད་འདོན་སྤེལ་ཡོང་བ་ཞེས་ཞོར་འཕྲོས་སུ་འབོད་བསྐུལ་ཞུ་རྒྱུ་ཡིན།",
    "ཐོག་མར་ཁྱེད་རང་ལེགས་སྐྱེས་ཀྱི་བྱ་དགའ་འཐོབ་མཁན་ཚང་མང་བཀྲིས་བདེ་ལེགས་ཞུ་རྒྱུ་ཡིན།",
    "ནུས་པ་ཐོན་པ་ཞིག་ཡོང་བར་ཚང་མས་འབད་བརྩོན་བྱ་རྒྱུ་གལ་ཆེན་པོ་འདུག་དཔེར་ན།",
    "ལས་ཀའི་ཐོག་ཧུར་བརྩོན་མེད་པའི་བཟོ་ལྟ་མཐོང་བཞིན་དུ་བཟང་པོ་བྱས་ནའང་ཡག་པོ་འདུག་ངན་པ་བྱས་ནའང་ཡག་པོ་འདུག་ཅེས་འདྲ་ཆགས་པོ་དང་།",
    "དེ་རྗེས་གཙུག་ལག་ཁང་རང་དུ་གསོལ་སྟོན་ཟབ་འབུལ་ཞུས་པར་གྲྭ་ཚང་ནས་མཐུན་འགྱུར་དང་།",
    "ནུས་པ་ཐོན་པ་ཞིག་ཡོང་ཐབས་ལ་ཚང་མས་འབད་བརྩོན་བྱ་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཅེས་དང་།",
    "དྭང་བླངས་ལྔ་བཅས་འདུག་པའི་གྲས་ཕྲན་གྱི་དྲན་ཚུལ་ལྟར་ན།",
    "མི་ཁྱེད་ལ་དེ་འདྲ་ཡོང་དགོས་མེད་སྙམ་ཚུལ་བརྗོད་སྐབས་བགྲེས་ཡོལ་པ་དེ་དག་ལ་ངས་བྱས་ཡུས་སྣེ་གཅིག་མེད་ཀྱང་སྡུག་དུས་སེམས་འགུལ་གྱི་མཐུན་འགྱུར་ཆེ་ཆུང་ལ་མ་ལྟོས་པར་དེ་ལྟར་དྲན་པ་ཙམ་ནི་རིན་ཐང་ཧ་ཅང་ཆེ་བའི་སེམས་མཐུན་ལ་ཡིད་ཀྱི་གཏིང་ནས་དགའ་སྐྱོའི་སྣང་བ་ཞིག་བྱུང་།",
    "དེ་ནི་དེང་སང་བསམ་བློ་གཏོང་དུས་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་བསམ་པས་མ་ཚད།",
    "དེ་རིང་ཞུས་པ་ཡིན་ན་ཡང་ཚིག་དོན་གཉིས་ཀྱི་ཐོག་ནས་འབྲེལ་མཚུངས་འདུག་བསམ་གྱི་འདུག་མ་མཁྱེན་པ་མཁྱེན་པ་བཟོ་རྒྱུ་དེ་གཞུང་ཞབས་འདེམས་བསྐོའི་ལས་འགན་ཡིན་པ་དང་།",
    "རང་རང་བློ་གྲོས་དང་འཚམས་པའི་གོ་བ་ལེན་སྟངས་གཏིང་ཟབ་ལོད་ཡོང་རྒྱུ་ཡང་།",
    "༣༡༧སར་གཏུགས་མཁན་ཞིག་མ་བྱུང་བར་དུ་ཨའུ་ཙམ་མིན་འགྲོ་བསམ་ནས་སྡོད་མཁན་ཞིག་ཡིན་ན།",
    "རང་བཙན་དང་རང་བཙན་ཟེར་ནས་མང་པོ་ཞིག་བཤད།",
    "མི་ཚེ་གཅིག་མི་གོ་ཆོད་པ་བྱེད་པའི་གོ་སྐབས་དཔེ་མི་སྲིད་པའི་བཟང་པོ་ཞིག་ཆགས་བསྡད་ཡོད།",
    "གཉེན་བཤེས་ལས་སྣེར་འཇུག་སྲོལ་གྱི་བསམ་ཚུལ་འདུག་པར་གཞུང་ཞབས་འདེམས་ལྷན་གྱི་བསམ་ཚུལ་ཇི་ཡོད་གསུངས་ཐད།",
    "རང་རང་ལྟོ་གོས་ཀྱི་ལས་ཀར་ཁ་ཡོད་ལག་ཡོད་བྱེད་ཐབས་ལྷུར་ལེན་ལྟ་བུའི་ངང་ཚུལ་འདི་ལྟའི་ནང་རང་ཉིད་ཀྱི་ཤེས་འཇོན་དང་།",
    "དེ་ལྟར་མ་བྱུང་བའི་སྐབས་སུ་ཡག་པོ་མི་འདུག་༡༩༨༣ ལོར་ཚོགས་མི་མཇལ་བཅར་བ་ཚོར་སྩལ་བའི་བཀའ་སློབ།",
    "གངས་ཅན་བོད་མི་རིགས་ཀྱི་རྐང་འདྲེན་ཆགས་རྒྱུར་བརྟེན་ལས་དོན་དགོངས་བཞེད་ལྟར་འགྲུབ་མིན་ཇི་ལྟར་ཡང་རང་ནུས་གང་ཡོད་ཉིན་གཅིག་སྡོད་པའི་ཚེ་མེད་ཀྱང་།",
    "ཟེར་གྱི་འདུག་ཅེས་སུན་སྣང་བྱས་ནས།",
    "དེ་ནི་མི་རྣམས་ལོ་ན་ཆུང་ངུ་ནས་བསམ་བློའི་གོམས་གཤིས་ཀྱི་ནང་རང་བཞིན་གྱིས་འཇགས་པ་ཞིག་མ་བྱུང་ན་མི་ཡོང་།",
    "མི་ཡོང་བ་མེད་སྙམ་པའི་སྤོབས་པ་སྐྱེ་བའི་གཞི་རྩའི་ཐོག་དུས་ནས་དུས་སུ་བཀའ་ངའི་སྐྱེ་ཡུལ་དང་མི་ཚེའི་འགན་འཁུར།",
    "ས་གནས་འགོ་འཛིན་གྱི་འོས་བསྡུ་གནང་སྐབས་སྒྲིག་དོན་འགལ་མེད་གནང་དགོས་ཞེས་འཁོད་འདུག་བཅས་ཞུས།",
    "དེ་རྗེས་ར་ཝང་ལ་ཞེས་པའི་གཞིས་སྒར་དེར་བསྐྱོད་དེ་ཞུ་སྒོ་ཁག་སྔར་རྒྱུན་ཐོག་ཉིན་གཅིག་དུས་ཚོད་བཏང་སྟེ་གཡས་གཡོན་དུ་གནས་མཇལ་ཞུས་པ་ཡིན།",
    "གཞིས་མི་རྣམས་ཉམ་ཆུང་རང་རང་ལྟོ་གོས་ལ་དཀའ་ལས་རྒྱག་མཁན་དང་།",
    "འོས་བསྡུ་ལས་ཁང་རང་ལའང་ས་གནས་ལས་དོན་དང་།",
    "ང་རང་ནི་གོང་དུ་ཞུས་པ་བཞིན་དགོངས་ཞུ་འབུལ་བ་ལས་གནས་ཚུལ་མེད་ན་ཁྱེད་གཉིས་ནས་ལས་མཇུག་གནང་སྟེ་བཞུགས་དགོས་ཞེས་ཡང་ནན་བསམ་ཚུལ་ཞུས་པར་གོང་བཞིན་གསན་བཞེས་མེད་པར་མཐའ་དོན་ངའི་སྐྱེ་ཡུལ་དང་མི་ཚེའི་འགན་འཁུར།",
    "དེ་མིན་ཚེ་འདིར་བདེ་སྡུག་མཐོ་དམན་ཅི་བྱུང་ཡང་མི་བཟོད་པ་བྱ་དོན་མི་འདུག་བསམས་ཏེ་ལས་དོན་ཁུར་ལེན་བྱ་གལ་བཀའ་དགོངས་བཞིན་ཞུ་རྒྱུར་བློ་ཐག་བཅད་པ་ཡིན།",
    "ང་རང་ལོ་ན་ཆུང་ཆུང་སྐབས་ནས་བསྒྱུར་བཅོས་གཏོང་རྒྱུ་དང་།",
    "ཕྱིའི་ཞབས་རིམ་ཆེད་རང་རང་འཁོས་དཔག་ལ་གཞིགས་པའི་ཞལ་འདེབས་བསྡུ་འབུལ་དང་།",
    "རྡོར་གདན་དུ་ས་གནས་འོས་བསྡུའི་ཚོགས་མིའི་སྐོར་ངལ་བའཕྲད་དེ་འོས་བསྡུའི་ཟུང་དྲུང་ས་གནས་སུ་ཆེད་གཉེར་གྱིས་སྔ་འགྱེལ་རྗེས་མཐུད་ལམ་སྟོན་བྱ་འོས་བྱས་ཏེ་འཐུས་ཀ་ཚང་ངེས་བྱུང་འདུགཟླ་༧ ཚེས་༨ ཕྱེད་ཡོལ་ཚོུད་༡༢།",
    "ས་གནས་འོས་བསྡུའི་འགན་འཛིན་ནས་ཀྱང་མཇུག་གནོན་གང་ལེགས་ཐོག་ཉེ་ཆར་སྤྱི་འཐུས་རྣམ་པ་གསུམ་ནས་ཀྱང་འོས་བསྡུའི་བཀའ་ཁྱབ་ལ་རྩ་འཛིན་དགོས་པའི་བཀའ་སློབ་གནང་འདུག་ཀྱང་།",
    "༥༥༣དོན་སྨིན་ལྡན་པ་བྱུང་འདུག་ཅེས་གསལ།",
    "ནུས་པ་ཡོད་མིན་ལ་མ་ལྟོས་པར་བསམ་བློའི་ནང་རང་བཞིན་གྱིས་བློ་གཡེང་ཞིག་ཡོང་ཞིང་།",
    "དེ་མཚམས་མཇལ་དཪ་འབུལ་ལམ་ཞུས་པར་མི་ངོ་ཤེས་པ་ཡིན་སྟབས་བསྟོད་ར་གཏོང་དགོས་པ་མི་འདུག་དུས་ཚོད་དཀའ་ངལ་ཆེ་བའི་སྒང་ལ་དཀའ་ལས་མཉམ་དུ་རྒྱག་མཁན་ཡིན་དུས་ངས་དུས་ནམ་ཡང་བརྗེད་མི་ཡོང་།",
    "རང་རང་སྐབས་སུ་བབས་པའི་ལས་དོན་ལ་ཕྱོགས་ཚང་མས་ངལ་བ་ལྷུར་ལེན་ཞུ་མཁན་ཞེ་གཅིག་ཡིན་ཀྱང་།",
    "ཉ་སོགས་དུད་འགྲོ་ཅི་ཙམ་མང་པོ་གསོད་ཀྱི་མི་འདུག་གམ།",
    "བྱེད་དགོས་ཀྱང་འགུལ་ཐབས་མེད་པའི་མཛུབ་རྒྱན་གྱོན་མཁན་འདུག་ཚིག་ཁེབས་དེ་འདྲ་གྱོན་མཁན་ཚོས་སྤགས་ཇི་ལྟར་བྱས་ཏེ་གཡོ་སྦྱོར་བྱེད་ཀྱི་ཡོད་དམ་སྙམ་པ་དྲན་གྱི་འདུགདོ་སྣང་བྱེད་དགོས་པ་ཞིག་ལ་བར་སྐབས་རྒྱ་གར་དུ་ཡོད་པའི་བཙན་བྱོལ་བོད་མི་ཚོར་མཚན་ཤས་གསར་པ་ཁ་ཤས་ཐོན་བཞིན་ཡོད།",
    "དེའི་ནང་སྟག་ཕུ་པདྨ་བཛྲར་སྐུ་ཚེའི་སྟོད་དུ་དག་སྣང་བྱུང་བ་མང་པོ་ཞིག་འཁོད་འདུག་ལ།",
    "ཡང་རང་ལུགས་ངུར་སྨྲིག་ན་བཟའ་དང་།",
    "དེའི་ཐོག་ལུང་འཛིན་གཅིག་པུ་མ་ཡིན་པར་རིག་པའི་རྣམ་གཞག་ཤུགས་ཆེའི་རྒྱ་བསྐྱེད་གཏོང་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་བའི་ཁྲོད་རབ་བྱུང་བཙུན་མ་མང་པོ་ཞིག་ཡོད་པ་དང་།",
    "ཨ་རིར་དབྱིན་སྐད་སྦྱང་ནས་བསྡད་འདུག་དེ་ཕྱིན་ཆད་ཐུགས་ཕན་གསོས་པ་ཡོད།",
    "དེར་བརྟེན་སྤྱིར་རང་རང་སོ་སོས་བསགས་པའི་ལས་ཀྱི་འབྲས་བུ་དེ་སོ་སོས་མྱོང་དགོས་ཀྱི་ཡོད།",
    "དེ་ལྟར་ནའང་རང་གཞན་ལ་མངོན་མཐོ་ངེས་ལེགས་ཀྱི་ཕན་གདགས་པར་འདོད་པས།",
    "ལོ་ཀའི་ཕ་མ་སོགས་དང་རང་ལ་རང་ཐབས་མི་མཁས་ཤིང་བསམ་པ་དམན་ལ།",
    "སྐྱེས་འགག་དུས་མཉམ་པར་འགྱུར་རོ།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "བྱེ་བྲག་ཏུ་གསུམ་ལྡན་གང་ཞིག་ཉན་ཐོས་དང་རང་རྒྱལ་དང་བྱང་སེམས་ཀྱི་ས་ལ་བརྟེན་པ།",
    "བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "འོག་མིན་འགྲོ་ནི།",
    "དགྲ་བཅོམ་འབྲས་ཞུགས་དོར་ནས་འོག་མིན་འགྲོ།",
    "འོག་མིན་འགྲོ་འཕར་གྱི་དབྱེ་གཞིར་གསུངས་ལ།",
    "འོག་མིན་འགྲོ་རྣམས་ཐ་དད་དུ་གསུངས་པ་དང་འགལ་ལོ།",
    "འོག་མིན་འགྲོ་ལས་གཞན་རྣམ་པ་གཉིས་སོ།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ལའང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆགས་པ་མ་མཆིས་པ་སྟེ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་ནི།",
    "འདུག་ས་སྤོང་བ་ལ་ཞེན་པ་དགག་པའི་ཕྱིར་ཅོག་བུ་པ་དང་།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
