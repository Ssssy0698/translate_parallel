    "བཙོན་རར་འདུག་པར་བྱེད་པ་དང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "ཕ་རོལ་སྨྲ་ཞིང་འདུག་པ་དེའི་བར་དྲན་པ་ལ་གནས་བཞིན་དུ་ཅུང་ཟད་ཙམ་མཉན་པ་ནི་ཉན་མཁན་གྱི་སྒོ་ནས་དང་།",
    "གཞན་གྱི་འདོད་པ་དེ་སླར་ཁོ་རང་ལ་གནོད་པར་འགྱུར་བའམ་དེས་རང་ལ་གནོད་པ་དང་།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "ཉིན་ཞག་དུས་ནི་བསླབ་པ་གཅིག་གཟུང་བ།",
    "སྤྱོད་འཇུག་རྩ་འགྲེལ་གྱི་དཔེ་རྙིང་སྔ་མ་ཐམས་ཅད་དང་གཞན་དུ་ལུང་དྲངས་པ་རྣམས་སུ་ཡང་བསྲོགས་ཏེ་ཞེས་འདུག་པས་སོ།",
    "འདུག་ན་ཡང་བདག་འདུག་གོ་སྙམ་དུ་རབ་ཏུ་ཤེས་སོ།",
    "འགྲེལ་པ་རྣམས་སུ་བསླབ་པ་ལ་གུས་པའི་བརྩོན་པ་ལྷུར་ལེན་ཞེས་པ་ཙམ་ལས་བག་ཡོད་ལ་སྦྱར་བ་མི་འདུག་གོ།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "གང་ལྟར་ཡང་དེ་ནས་ནི་སྐབས་སྐབས་སུའམ་བར་བར་དུ་ལུས་འདི་སྔར་བསམ་པ་བཞིན་གྱི་འགྲོ་བ་དང་འདུག་པ་སོགས་ཀྱི་སྤྱོད་ལམ་དེ་ཉིད་ལ་གནས་མི་གནས་དང་དགེ་མི་དགེ་གང་ལ་འཇུག་སོགས་ཀྱི་སྤྱོད་ལམ་ཇི་ལྟ་བུར་གནས་པ་ཡིན་ཞེས་ཤེས་བཞིན་བྱ་ར་བས་བལྟ་བར་བྱ་ཞིང་།",
    "ལུས་ཀྱིས་འདི་ལྟར་འགྲོ་བྱ་དང་འཆགས་བྱ་སོགས་སྦྱར་ནས་ཤེས་པར་བྱ་དགོས་ཏེ་འདིས་དངོས་སུ་གནས་པའམ་འདུག་པའི་ཀུན་སྤྱོད་བསྟན་ནས་འགྲོ་འཆགས་སོགས་ཀྱི་སྤྱོད་པའང་ཤུགས་ལ་བསྟན་པས་སོ་ཞེས་འཆད་པའམ།",
    "ཙ་ན་ཀར་ཡང་།",
    "གཞན་གྱིས་དེ་དག་བྱེད་པའི་རྗེས་སུ་ཡང་རང་དགར་སྨྲ་ཞིང་མཉན་པ་དང་བལྟ་བ་སོགས་ཀྱི་སྒོ་ནས་འདུག་པར་མི་བྱ་ལ།",
    "གཞན་དོན་སྒྲུབ་པའི་མཐུན་རྐྱེན་རྣམས་དང་རང་ཉིད་ལྡན་པར་བྱ་བ་ནི།",
    "སྦྱིན་དང་སྙན་སྨྲ་སོགས་ཐབས་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་གཞན་དགའ་ཞིང་མགུ་བར་བྱེད་པ་ལ་བརྩོན་པ་སྟེ་དེ་ལྟ་བུའི་ཡོན་ཏན་རྣམས་དང་རང་ཉིད་ལྡན་པར་བྱས་ནས་གཞན་དོན་སོགས་ལ་འཇུག་པར་བྱའོ།",
