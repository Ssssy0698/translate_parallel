    "རྣམ་པ་ལ་འཇིག་པ་ངེས་པར་ཡོད་པ་ལྟོས་མེད་སྒྲུབ་པའི་རྒྱུ་ཡིན་ལ།",
    "ལྟོས་མེད་ལས་ངེས་པར་འགྱུར་བར་སྒྲུབ་པར་ནི་དུས་ལས་ངེས་པར་འགྱུར་བ་བསྒྲུབས་པས།",
    "གལ་ཏེ་སྐྱེ་བ་དང་ལྡན་པ་ཀུན་འཇིག་པ་དང་ལྡན་པར་གྲུབ་ཀྱང་འཇིག་པ་རྒྱུ་ངེས་པ་ལས་མ་བྱུང་བར་མི་འགྲུབ་སྟེ།",
    "འདི་ལ་སྐྱེ་བ་དོན་གཞན་ལ་སོགས་པ་འཇིག་པའི་རྒྱུ་ངེས་པར་ཁས་བླངས་པ་དེས་ཀྱང་འཇིག་ལྡན་གྱི་དངོས་པོ་མ་བྱས་པར་འཇིག་པ་འབའ་ཞིག་བྱ་བར་མི་ནུས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རྒྱུ་ངེས་པ་མེད་པར་གྲུབ་བོ་ཞེས་བྱ་བའོ།",
    "ཡོད་པའམ་སྐྱེ་བ་ཅན་ཐམས་ཅད་མི་རྟག་པའི་ངོ་བོར་གྱུར་པར་བསྟན་པས།",
    "སྐྱེ་བ་ཅན་ཐམས་ཅད་ནི་འཇིག་པ་དང་ལྡན་པར་གྲུབ་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཉིད་གཞུང་འཛུགས་པའོ།",
    "མཐོང་བའི་དངོས་པོ་མཚན་ཉིད་དང་མི་རྟག་པའི་མཚན་ཉིད་དག་གཞི་ངེས་པ་ལ་མི་ལྟོས་པར་མཚོན་ཉིད་ཙམ་རྣམ་པར་དབྱེར་མེད་པར་གྲུབ་བོ།",
    "དཔེར་ན་མཐོང་བའི་སྔོན་པོའང་སྔོན་པོ་ཉིད་ཀྱི་མཚན་ཉིད་ཙམ་གྱིས་སྔོན་པོ་མ་ཡིན་པ་དང་བྲལ་བ་ཡིན་ནོ་ཞེས་གྲུ་བཞི་ལ་སོགས་པའི་ཁྱད་པར་ངེས་པ་ལ་མ་ལྟོས་པར་མཚན་ཉིད་རྣམ་པར་དབྱེར་མེད་པར་གྲུབ་ན།",
    "འཇིག་པ་དུས་ལ་ངེས་པར་འགྱུར་བ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "དངོས་པོ་ལ་ངེས་པར་ཡོད་པ་དང་།",
    "རྣམ་པ་ལ་ངེས་པར་ཡོད་པ་ནི་གྲུབ་ཟིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ངེས་པ་ལ་མི་ལྟོས་པར་སྒྲུབ་བོ།",
    "དེའི་ཕྱིར་སྐྱེད་པའི་རྒྱུ་ལས་གཞན་ལ་མི་ལྟོས་པར་ཡོད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ།",
    "སྐྱེད་བྱེད་ལས་གཞན་ལ་མི་ལྟོས་པ་ནི་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་ཡིན་ལ།",
    "འགའ་ཞིག་མི་རྟག་པར་གྲུབ་ཀྱང་།",
    "སྐྱེས་བྱེད་ལས་གཞན་དུ་གྱུར་པ་དང་སྐྱེད་བྱེད་ཀྱི་ཁྱད་པར་ལ་ལྟོས་པ་གཉིས་ག་གནོད་པའི་ཕྱིར་ན་རྒྱུ་ངེས་པ་བཀག་པ་ཡང་ལྟོས་པ་མེད་པ་ཁོ་ན་ཡིན་ནོ།",
    "གསུམ་པ་འདི་ལ་དོན་རྣམ་པ་ལྔས་ངེས་པར་བྱ་སྟེ།",
    "ཁྱད་པར་ལ་རྟེན་པའི་དྲི་བ་དང་།",
    "ཁྱད་པར་ལས་སྐྱེས་པའི་དུ་བ་མདུན་དུ་མ་བྱས་པར་དུ་བ་སྤྱི་ཙམ་ཉེ་བར་བཟུང་ནས་སམ།",
    "ཁྱད་པར་ཅན་ལས་སྐྱེས་པ་དེ་དུ་བ་མདུན་དུ་བྱས་ནས་ཡིན།",
    "བསྐྱེད་བྱ་སྐྱེད་བྱེད་ཡོད་པར་མ་གྲུབ་པའི་ཕྱིར་ཏེ།",
    "དུ་བ་ཙམ་ནི་གཞན་དུ་ཙནྡན་གྱི་མེ་མེད་པར་ཡང་ཡོད་པས་དེས་བསྐྱེད་པར་མ་གྲུབ་བོ།",
    "ཁྱད་པར་ཅན་ལས་བྱུང་བའི་དུ་བ་དེ་ནི་དུ་བ་གཞན་ལས་ཁྱད་པར་དུ་གྱུར་པ་ཡིན་པས་དེས་རྒྱུའི་ཁྱད་པར་གོ་བར་འདོད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེས་ན་དུ་བ་ཙམ་གྱི་རང་བཞིན་ལས་མེ་རྟོགས་པ་ལྟར་ཁྱད་པར་ཅན་གྱི་མེ་ཡང་རྟོགས་པར་འགྱུར་ཏེ།",
    "མེ་ཙམ་དཔོག་པ་ན་ཡང་མེས་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་གཞན་མ་ངེས་པའི་ཕྱིར་ཏེ།",
    "མི་རྟག་པ་ལ་སོགས་པ་མེས་བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་གཞན་མ་ངེས་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཁྱད་པར་ལ་རྟེན་པའི་དྲི་བའོ།",
    "ཁྱད་པར་ཅན་གྱི་འབྲས་བུ་རྟོགས་པ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "དེའི་མཚན་ཉིད་ཅན་ཁྱད་པར་གཞན་ལ་ཁྱད་པར་ཅན་གྱི་འབྲས་བུར་མཐོང་བའི་སྤྱིའི་མཚན་ཉིད་ལ་ལྟོས་ནས་ཁྱད་པར་ཅན་གྱི་འབྲས་བུར་ངེས།",
    "དཔེར་ན་ཚང་མང་དུ་དུ་བ་དེ་ཉིད་མེ་དེ་ལྟ་བུ་ལས་སྐྱེ་བར་གྲུབ་པས་དེའི་རྒྱུ་རྗེས་སུ་དཔག་པར་བྱ་བ་མ་ཡིན་པ་བཞིན་ནོ།",
    "གཞན་དུ་དུ་བའི་རང་བཞིན་ཅན་མེའི་ཁྱད་པར་མེད་ཀྱང་སྐྱེ་བར་མཐོང་བའི་ཕྱིར།",
    "དེ་ཉིད་དུ་ཁྱད་པར་གྱི་འབྲས་བུར་མ་ངེས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ལ་དྲིས་པ་ལ་སྤྱི་ལ་བརྟེན་ནས་ལན་བརྗོད་པ་མ་འབྲེལ་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་གྱི་མཐར་ཐུག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཁྱད་པར་ཅན་གྱི་བསྐྱེད་བྱའི་ཁྱད་པར་མ་རྟོགས་པར་དུ་བ་ཙམ་དུ་རྟོགས་པ་ནི་དངོས་པོ་ལ་མེའི་འབྲས་བུ་ཡིན་ཡང་འབྲས་བུར་རྟོགས་པར་མི་ནུས་ཏེ།",
    "གཞན་དུ་བའི་མཐོང་བ་སྤྱིའི་མཚན་ཉིད་ཀྱི་རྗེས་སུ་འབྲངས་ནས་ངེས་པར་བྱེད་པ་ངོ་ཤེས་ཀྱི་བློས་ཀྱང་དེ་ལྟར་མི་རྟོགས་པའི་ཕྱིར་རོ།",
    "གཞན་གྱིས་སྤྱི་ལ་བརྟེན་ནས་ཁྱད་པར་ལ་དྲིས་པའི་ལན་བཏབ་པ་མ་གོ་སྟེ།",
    "ཁྱད་པར་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "གཅིག་ལ་ཡོད་པའི་དུ་བའི་ཆ་ནས་ཁྱད་པར་གྱི་མེའི་འབྲས་བུ་ཡིན་པ་སྤངས་ལ།",
    "འོན་ཀྱང་གཉི་ག་རྣམ་པར་དབྱེར་མེད་པར་བསྐྱེད་བྱ་ཡིན་པ་ཁོ་ནའོ།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་གྱི་མཚན་ཉིད་རྟོགས་པ་ལ་མ་ལྟོས་པར་དུ་བ་ཙམ་གྱི་སྤྱིའི་རང་བཞིན་དུ་རྟོགས་པ་ནི་གསལ་བ་གཞན་ལ་མཐོང་བའི་རྗེས་སུ་འབྲངས་ཀྱང་ཁྱད་པར་ཅན་གྱི་མེའི་འབྲས་བུར་ངེས་མི་ནུས་པས་རྟགས་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་དངོས་པོ་ལ་དུ་བ་ཙམ་གྱི་རང་བཞིན་ཡང་ཁྱད་པར་གྱི་མེའི་འབྲས་བུ་ཡིན་ན།",
    "ཁྱད་པར་ལ་བརྒལ་བ་སྤྱིས་ལན་འདེབས་པ་མ་འབྲེལ་པ་ཡང་མ་ཡིན་ཏེ།",
    "སྤྱིའི་མཚན་ཉིད་ནི་གཞན་དུ་དེའི་འབྲས་བུ་མ་ཡིན་པར་སྣང་བས་དེའི་རྗེས་སུ་འབྲངས་ཀྱང་།",
    "མ་ངེས་པར་ཟད་དོ་ཞེས་བྱ་བའི་ལན་གྱིས་ཐམས་ཅད་དུ་གོ་བྱ་གོ་བྱེད་ཡིན་པ་སྤོང་ན་འོ་ན་མ་རྟོགས་པ་ཉིད་མི་འཐད་དེ།",
    "དཔེ་ལ་དུ་བ་ཙམ་མེའི་བསྐྱེད་བྱར་གྲུབ་པ་བཞིན་དུ་ཁྱད་པར་གྱི་ཡང་བསྐྱེད་བྱར་གྲུབ་པའི་ཕྱིར་རོ།",
    "དཔེ་ལ་མཐོང་བའི་མེ་ཙམ་དེ་ནི་ཁྱད་པར་མི་སྤོང་བས་མེ་ཙམ་གྱི་རང་བཞིན་ལྟར་ཁྱད་པར་དེ་ཡང་སྐྱེད་བྱེད་ཀྱི་རང་བཞིན་དུ་ངེས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ཡིན་དང་དཔེ་ལ་མཐོང་བའི་རྗེས་སུ་འབྲངས་པས་དུ་བ་ཙམ་ཐམས་ཅད་དུ་ཡང་ཁྱད་པར་གྱི་འབྲས་བུར་ངེས་པར་འགྱུར་ཏེ།",
    "དེའི་རྗེས་སུ་འབྲངས་པས་དུ་བ་གཞན་ཡང་ཁྱད་པར་གྱི་འབྲས་བུར་མི་འགྲུབ་སྟེ།",
    "ལན་འདི་ངེས་པར་ཟུང་ཤིག།",
    "ཡུལ་དང་དུས་གཞན་ན་མེད་པའི་དངོས་པོ་ཙམ་ནི་མ་ཡིན་ཏེ་མི་ནུས་པའི་ཕྱིར་རོ་ཞེས་འོག་ཏུ་བསྟན་པར་བྱའོ།",
    "ཁྱད་པར་གྱི་མཚན་ཉིད་ནི་མེད་ཀྱང་།",
    "དེས་ན་སྤྱི་དང་ཁྱད་པར་དངོས་པོ་གཅིག་ཀྱང་མཚན་ཉིད་རྣམ་པར་ཕྱེ་བ་ན་གཅིག་ནི་སྐྱེད་བྱེད་དང་།",
    "ཁྱད་པར་གྱི་འབྲས་བུར་ནི་མ་ཡིན་པས།",
    "མའི་ཡུལ་ངེས་པ་ན་དེ་ཐམས་ཅད་བཀག་པར་ཡང་གྲུབ་བོ།",
    "འདི་ཡང་འོག་ཏུ་གསལ་བར་བརྗོད་པར་བྱའོ།",
    "འདི་ལ་དངོས་པོ་ལ་ཆ་དོན་དམ་པར་མེད་དོ།",
    "ཁྱད་པར་མི་འཇུག་པས་ཐ་དད་པར་རྣམ་པར་བརྟགས་པ་ཡིན་ལ།",
    "དེ་ཡང་ཆ་ཐ་དད་དུ་ངེས་པར་བྱས་པ་ཙམ་འཁྲུལ་གྱི།",
    "བྱས་པ་དང་མི་རྟག་པའི་རང་བཞིན་ཙམ་ལ་ནི་མི་སླུ་བ་བཞིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དངོས་པོའི་རང་བཞིན་དུ་མ་གྲུབ་པ་རྣམ་པར་བརྟག་པ་ལ་མ་ལྟོས་པར་ནི་རྒྱུ་འབྲས་ཉིད་མི་འགྲུབ་སྟེ།",
    "ལྡོག་པ་དངོས་པོའི་གནས་པར་མ་གྲུབ་པས།",
    "རྣམ་པར་བརྟགས་པ་ཙམ་ཡིན་པའི་ཕྱིར་དང་།",
    "ལོག་ན་ལོག་པས་མེའི་འབྲས་བུ་ཡིན་ནོ་ཞེས་ལྡོག་པ་རྣམ་པར་བརྟགས་ནས།",
    "རྒྱུ་འབྲས་ཀྱི་མཚན་ཉིད་ངེས་པར་བྱ་བ་ཡིན་ནོ།",
    "རྗེས་སུ་འགྲོ་བ་ཙམ་འཁྲུལ་པར་བརྗོད་པས་བཀག་ཟིན་ཏོ།",
    "རྣམ་པར་རྟོག་པ་གསུམ་པ་ལྟར་ན་ཡང་ལྡོག་པ་མ་གྲུབ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་བཞི་པ་ཡང་མི་འཐད་དོ།",
    "དུ་བའི་རིགས་འབྱུང་ངོ་ཞེས་མཚན་ཉིད་རྣམ་པར་ཕྱེ་བ་ནི་བརྟགས་པ་ཡིན་པ་ལ་མི་འཐད་པ་མ་མཐོང་ངོ།",
    "དེ་ལ་རྗེས་སུ་འགྲོ་བའི་སྒོ་ནས་ངེས་པར་བྱེད་ན་ནི་སྔ་མ་གསུམ་ཡིན་ལ།",
    "ལྡོག་པའི་སྒོ་ནས་ངེས་པར་བྱེད་ན་ནི་ཕྱི་མ་གསུམ་ཡིན་ནོ་ཞེས་སོ།",
    "འོན་ཏེ་ཕན་ཚུན་ཁྱད་པར་ཅན་ཡིན།",
    "དེ་ནི་འབྲེལ་པ་ངེས་པར་གྲུབ་པའི་སྟོབས་ཀྱིས་རྗེས་སུ་འགྲོ་བའི་ཁྱབ་པའམ།",
    "དེ་ངེས་པ་ནི་ལྡོག་པ་མེད་པར་སྒྲོ་འདོགས་པ་ལ་གནོད་པའོ།",
    "དེ་ལྟར་ན་དོན་གྱིས་རྟོགས་པའི་ལྡོག་པ་རྗེས་འགྲོའི་ཁྱད་པར་དུ་གྲུབ་བོ།",
    "ཡོད་པ་ཡིན་པས་ཅི་རིགས་པར་དེ་འདིས་སེལ་བའི་ཕྱིར་རོ།",
    "མེད་ན་ལྡོག་པར་འཛིན་པས།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ཕན་ཚུན་ཁྱད་པར་ཅན་དང་།",
    "ཁྱད་པར་གྱི་དངོས་པོར་འབྲེལ་པ་འཛིན་ལ།",
    "རྒྱུ་འབྲས་ཀྱི་མཚན་ཉིད་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ཕན་ཚུན་འབྲེལ་པ་ལས་གཞན་པའི་ཁྱད་པར་མེད་པའི་ཕྱིར་ན།",
    "དུ་བ་མེ་མེད་པར་ཡང་མཐོང་བའི་ཕྱིར་རོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "དེས་ན་རྣམ་པར་རྟོག་པ་དང་པོ་མེད་དོ།",
    "དེས་ན་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ཕན་ཚུན་ཁྱད་པར་ཅན་ནི་འདོད་རྒྱལ་བ་ཡིན་ཏེ།",
    "གཏན་དུ་ཡོད་པར་དོགས་པ་མི་སེལ་བས།",
    "ཡུལ་དེ་ན་ཡོད་པ་ནི་སྔར་དམིགས་པའི་གནས་སྐབས་ཀྱི་ཡུལ་དང་ཤེས་པ་གཅིག་ལ་འདྲེར་རུང་བས་དམིགས་པར་རུང་བ་ཉིད་ངེས་སོ།",
    "དུ་བས་དབེན་པར་དམིགས་པ་ཉིད།",
    "དུ་བ་མ་དམིགས་པའི་དོན་ཡིན་པས་སྣང་བ་མི་དམིགས་པའི་ཁྱད་པར་གྲུབ་བོ།",
    "དེས་ན་མ་སྐྱེས་པར་དགག་པར་ནུས་སོ།",
    "དེ་ཡང་མི་རིགས་པར་མ་མཐོང་ངོ།",
    "སྔར་ཡོད་ན་སྣང་དུ་རུང་བ་ལས་མེད་པར་རྟོགས་ལ།",
    "དེ་ཡང་ད་ལྟར་རྒྱུན་སྐྱེ་བཞིན་པར་མཐོང་བ་ལས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་མེད་པས་སྔར་མཐོང་བའི་གནས་སྐབས་ཀྱི་ས་ཕྱོགས་དང་ཤེས་པ་གཅིག་ལ་འདྲེ་བ་ངེས་པས།",
    "སྔར་མེད་པར་ངེས་པ་གཉིས་ཕན་ཚུན་བརྟེན་པ་དང་།",
    "དང་པོ་ནི་སྔར་མེད་པར་ནི་སྣང་བ་མ་དམིགས་པ་ལས།",
    "སྣང་བ་ཉིད་དུ་ངེས་པ་ནི་སྐྱེ་བཞིན་པར་ངེས་པ་ལས་ཡིན་ལ།",
    "སྐྱེ་བཞིན་པ་ཡང་སྔ་ན་མེད་པར་རྟོགས་པས་ཁྱབ་སྟེ།",
    "གཉིས་པ་ནི་སྐྱེ་བཞིན་པར་ངེས་པ་ཉིད་ཀྱིས་ཡུལ་དེའམ་གཞན་ན་སྔོན་པོ་ཡོད་པ་བཀག་པ་ངེས་པར་གྲུབ་པས།",
    "འོན་ཀྱང་དེའི་སྟེང་དུ་མི་དམིགས་པ་གཉིས་ལྡོག་པ་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ་ནི།",
    "རྒྱུ་གཞན་རྣམ་པར་བཅད་ནས་ངེས་པའི་ཁྱད་པར་སྒྲུབ་པའི་དོན་ཏོ།",
    "དེ་ལས་གཅིག་མེད་ན་ཡང་མི་དམིགས་པ་ཞེས་གསུངས་པས།",
    "འདི་ལ་ཡང་རྫ་མཁན་གྱི་རྩོལ་བ་དང་འཇིམ་པ་ལ་སོགས་པ་སྔ་མ་ལས་གཞན་འཇུག་པ་ཆད་ན་བུམ་པ་གཞན་སྐྱེ་བ་མེད་པར་མཐོང་བ་ལས་ལྡོག་པ་ངེས་ཏེ།",
    "དེས་ན་སྐད་ཅིག་ལ་བརྟེན་ནས་རྒོལ་བ་ནི་སྐབས་ཀྱི་དོན་མ་རིག་པར་ཟད་དོ།",
    "མངོན་སུམ་དང་མི་དམིགས་པ་ལྔས་དངོས་པོ་གཉིས་རྒྱུ་འབྲས་སུ་འགྲུབ་པར་བརྗོད་པ་ན་དེ་གཉིས་ཐ་དད་པར་མངོན་སུམ་གྱིས་གྲུབ་པ་ལ་ཡིན་པར་རྟོགས་སོ།",
    "དེ་ལྟ་ན་ཡང་ཚུ་རོལ་མཐོང་བའི་མངོན་སུམ་གྱིས་སྐད་ཅིག་ཐ་དད་པར་མི་རྟོགས་པས་རྒྱུན་གཉིས་རྒྱུ་འབྲས་སུ་དེས་གྲུབ་པར་གོ་བ་ཁ་ནའོ།",
    "དེས་ན་ཐ་དད་པ་ཉིད་མངོན་སུམ་གྱི་ཡུལ་མ་ཡིན་པ་ལ་མངོན་སུམ་དང་མི་དམིགས་པ་ལྔ་འཇུག་མི་སྲིད་པས་སྐབས་མ་ཤེས་པར་རྩོད་པར་གསལ་ལོ།",
    "བར་མ་ཆོད་པ་ལ་ལྟོས་པར་སྤྱིར་མངོན་སུམ་དུ་མཐོང་བས་སོ།",
    "མཚན་ཉིད་རྒྱུ་འབྲས་སུ་ངེས་པར་བྱ་བ་ཡིན་གྱི་སོ་སོར་ངེས་པའི་རྫས་ཙམ་ནི་མ་ཡིན་པའི་ཕྱིར་ལ།",
    "མཚན་ཉིད་དེ་ཡང་སྐད་ཅིག་ལ་ཡོངས་སུ་གཅད་པར་མི་ནུས་པས་སྐད་ཅིག་བརྒྱུད་པ་དུ་མ་ལ་ངེས་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "སྐད་ཅིག་རྣམ་པར་མ་ཕྱེ་བས་དུ་བ་མེ་སྔོན་དུ་འགྲོ་བར་ངེས་པ་ཁོ་ནའོ།",
    "འདིར་མེ་ལས་སྐྱེ་བར་མཐོང་བའི་དུ་བ་གསལ་བ་དེ་མེ་མེད་པར་སྲིད་པ་འདིས་འགོག་པ་ནི་མ་ཡིན་ཏེ།",
    "དཔེར་ན་དུ་བའི་གསལ་བ་གཅིག་ལ་དེའི་མཚན་ཉིད་འབྲས་བུར་ངེས་པར་བྱེད་པའི་ཚེ།",
    "དེ་ཉིད་ཀྱི་ཚེ་དུ་བའི་གསལ་བ་གཞན་མེ་མ་ཡིན་པ་ལས་སྐྱེ་བར་མཐོང་ན་ངེས་པར་བྱ་བའི་མཚན་ཉིད་དེ།",
    "དེས་ན་མངོན་སུམ་དང་མི་དམིགས་པ་ལྔས་དུ་བའི་མཚན་ཉིད་ཙམ་མེའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་རྗེས་སུ་བྱེད་པར་ཡོངས་སུ་བཅད་པས་འགལ་བ་རྣམ་པར་གཅོད་པའི་ཕྱིར་མི་འཁྲུལ་པ་གྲུབ་བོ།",
    "མཚན་ཉིད་དེ་མེ་ལ་མི་འཁྲུལ་པར་ཤུགས་ཀྱིས་ངེས་ཏེ།",
    "དེའི་ཡུལ་གྱི་རང་བཞིན་ཅན་འདི་ཡིན་པར་རྟོགས་པའི་བློ་ཕྱི་མའི་འཇུག་པ་དཔྱད་པས་ངེས་ཀྱང་སླ་སྟེ།",
    "འཁྲུལ་པ་སྲིད་པར་དོགས་པ་སེལ་བ་ནི་དངོས་སུ་དཔྱོད་པ་ཉིད་ཡིན་ནོ།",
    "དུ་བའི་རང་བཞིན་ཙམ་གྱིས་མེའི་འབྲས་བུ་མཐོང་བ་ན་མེའི་འབྲས་བུ་ཉིད་དུ་བའི་རྒྱུ་ལས་གཞན་ལ་མི་ལྟོས་པར་ཡོད་པ་ཡིན་པས་དུ་བའི་རྒྱུ་ཙམ་ལ་མེའི་འབྲས་བུ་རྒྱུས་པ་ཡིན་ནོ།",
    "དེས་ན་མེ་མ་ཡིན་པ་ལས་དུ་བ་སྐྱེ་ན་མེའི་འབྲས་བུར་སྐྱེད་པའི་ནུས་པ་མེད་པ་ལས་དུ་བར་བསྐྱེད་པར་བརྗོད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་དུ་བའི་སྐྱེད་བྱེད་མ་ཡིན་པ་ལས་དུ་བ་སྐྱེ་བར་བརྗོད་པར་འགྱུར་ཏེ།",
    "འདིར་ནི་ཡོད་པ་མི་རྟག་པར་བྱེད་པའི་ནུས་པ་ལས་བྱུང་བས་གང་དུ་ཡང་མི་རྟག་པ་མེད་པར་མི་སྲིད་པ་བཞིན་དུ།",
    "ནུས་པ་གཅིག་ལས་བྱུང་བས་དུ་བ་མཐའ་དག་མེའི་འབྲས་བུས་ཁྱབ་པར་རྒྱུའི་སྒོ་ནས་གྲུབ་པར་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེའི་ཚེ་དུ་བའི་གསལ་བ་གཞན་ནམ་སྔར་རམ་ཕྱིས་དུ་བའི་གསལ་བ་གཞན་མེ་མ་ཡིན་པས་སྐྱེ་ཡང་ད་ལྟའི་གནས་སྐབས་ཀྱི་མེ་དུད་རྒྱུ་འབྲས་སུ་རྟོགས་ནུས་པར་འགྱུར་རོ་ དེ་ལྟ་ན་ནི་མེ་དང་དུས་མཉམ་པའི་རི་ལ་སོགས་པའི་སྐད་ཅིག་རྣམས་ཀྱང་དུ་བའི་རྒྱུ་ཡིན་པ་དང་།",
    "ཐ་སྙད་མ་འཆོལ་བ་དང་རྒྱུ་འབྲས་ངེས་པར་ཡང་མཐོང་སྟེ།",
    "ཐ་དད་པ་རྒྱུ་ལ་ལྟོས་པར་མཐོང་བ་དང་།",
    "པར་འགྱུར་ལ།",
    "རྒྱུ་འབྲས་སུ་མཐོང་བས་གནོད་པར་རྗོད་ན།",
    "དེ་ལྟ་ན་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པ་ལ་རྒྱུ་འབྲས་སུ་ཡིད་ཆེས་པ་མི་སྲིད་པའམ།",
    "མི་འཁྲུལ་པར་གྲུབ་པ་དང་།",
    "ནམ་ཡང་འགའ་ཡང་གཞན་ལས་མི་སྲིད་པར་ངེས་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ལྟ་ན་དུ་བ་མཐའ་དག་དང་མེ་མཐའ་དག་མ་མཐོང་བར་དེ་མི་ངེས་པས་ཐམས་ཅད་མི་ཤེས་པས་དེ་ངེས་པར་ག་ལ་སྲིད།",
    "དེས་ཀྱང་རྒྱུ་འབྲས་སུ་ངེས་པར་འགྱུར་ཏེ།",
    "འབྲས་བུས་ཀྱང་མི་འཁྲུལ་པ་བསྒྲུབ་པའི་སྐབས་ཡིན་པས་ཕན་ཚུན་བརྟེན་པར་འགྱུར་རོ།",
    "མི་འཁྲུལ་པ་ཉིད་སྔར་གྲུབ་ནས་རྒྱུ་འབྲས་སུ་ངེས་པར་བྱེད་ན་བདེན་པ་ཞིག་ན།",
    "གཞན་དུ་ཁྱབ་པ་མ་གྲུབ་པར་འགྱུར་བས་སོ།",
    "དུས་ལ་སོགས་པའི་ཁྱད་པར་བཀག་པས་དུ་བ་ཡོད་པ་ཉིད་བཀག་པ་སྒྲུབ་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་རྟག་ཏུ་མེད་པར་འགྱུར་རོ།",
    "འདི་མེད་པར་ཡོད་པས་ཡུལ་དང་དངོས་པོ་གཞན་ན་ཡོད་ལ།",
    "དེ་བཞིན་དུ་ཀུན་ན་ཡོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འདི་ཡོད་ཀྱང་མེད་པས་འདི་ན་ཡང་མེད་པར་འགྱུར་ཏེ།",
    "ལྟོས་པར་བྱ་བ་བཀག་པས་དུ་བ་ཡོད་པ་འགོག་པ་ནི་མ་ཡིན་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "རྒྱུ་དང་ལྡན་པར་འགྱུར་ཏེ་རྗེས་སུ་འགྲོ་ལྡོག་ལས་གཞན་དུ་རྒྱུ་འབྲས་ཀྱི་མཚན་ཉིད་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་རྒྱུ་དང་ལྡན་པར་དཔགས་པས་དངོས་པོའི་རྒྱུ་འབྲས་རྟོགས་པ་ཡིན་ནོ།",
    "མཚོན་བྱའི་ཐ་སྙད་དུ་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའོ།",
    "མེ་དེས་བསྐྱེད་པར་བྱ་བ་ཞེས་བྱ་བ་འབྲས་བུའི་ངོ་བོ་ཉིད་ཡིན་ཏེ།",
    "དེ་ཉིད་ན་ཡོད་པར་རྟོགས་ལ།",
    "འབྲེལ་པའི་ཁྱད་པར་དེའི་བདག་ཉིད་ལ།",
    "གཞན་གྱི་ལོག་པར་རྟོགས་པ་སྤོང་བ་ནི།",
    "རྟག་ཏུ་དེ་ལྟར་ཡོད་པར་དོགས་པས་བསླུས་པའམ།",
    "མི་རྟག་པར་མི་ངེས་པའི་རྒྱུ་ནི་མཐོང་བ་ལ་རྟག་པར་སྒྲོ་འདོགས་ཀྱི་རྒྱུ་ཡིན་ནོ།",
    "དཔེར་ན་གློག་སྔ་ཕྱིའི་བར་དུ་མེད་པར་དམིགས་པ་བཞིན་ནོ།",
    "དེ་ལྟར་མི་རྟག་པར་ངེས་པའི་རྒྱུ་གཉིས་པོ་དེ་གཉི་ག་མེད་པ་ནི་རྟག་པར་སྒྲོ་འདོགས་པའི་རྒྱུ་ཡིན་པས།",
    "གང་རུང་གཅིག་མ་ཚང་ན་རྟག་པར་སྒྲོ་འདོགས་མེད་པར་བརྗོད་ལ།",
    "དེས་ན་རྟག་པར་འཁྲུལ་པ་མེད་པ་ཁོ་ནའོ།",
    "རྟག་པར་སྒྲོ་འདོགས་པའི་བག་ཆགས་སོ།",
    "རྒལ་བ་ཉིད་ལན་དུ་བྱས་པར་འགྱུར་རོ་ཞེས་སུན་འབྱིན་པ་ནི་མི་བདེན་ཏེ།",
    "སྐད་ཅིག་མར་དམིགས་པ་དང་ཡོད་པར་དམིགས་པ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "ཡོད་པ་དམིགས་པའི་དོན་ནི་རྟག་ཏུ་ཡོད་པ་དམིགས་པ་ལ་བརྗོད་པར་འདོད་པས།",
    "ཡོད་པར་དམིགས་པ་ནི།",
    "སྔོན་ཞུགས་པའི་སྒྲོ་འདོགས་རྟག་ཏུ་ཡོད་པར་ངེས་པ་ལ་དེར་བརྗོད་པས་ན།",
    "དང་པོ་ལྟར་ན་ཡོད་པ་དམིགས་པ་དང་ཁྱད་པར་མེད་དེ།",
    "བློ་ཞན་པས་ཞེས་བརྗོད་པ་ནི་བརྒལ་པ་ཉིད་ལེན་དུ་བྱས་པར་འགྱུར་རོ།",
    "བློ་ཞན་པ་དང་ཡོད་པ་དམིགས་པ་དག་མཐོང་བ་ལོག་པར་སྒྲོ་འདོགས་ཀྱི་རྒྱུར་རྟོག་པ་ནི་མི་འཐད་དེ།",
    "ནུས་པ་མེད་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་གཉིས་པ་ནུས་པ་མེད་པར་གྲུབ་པ་ནི།",
    "ནུས་པ་མེད་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཡོད་པ་དམིགས་པ་ནི་མཐོང་བ་ལ་ཕྱིན་ཅི་ལོག་སྐྱེད་པར་མི་ནུས་པ་ཁོ་ན་སྟེ།",
    "སྔར་ལོག་པར་རྟོགས་པའི་སྒྲོ་འདོགས་ཡོད་པ་དང་བློ་ཞན་པ་ཡོད་པ་ཁྱད་པར་མེད་ཀྱང་མཐོང་བས་དེ་བཟློག་པར་དམིགས་པས།",
    "མཐོང་བའི་ནུས་པ་ཟིལ་གྱིས་གནོན་པའི་མཐུ་མེད་པར་ངེས་པ་བཞིན་ཏེ།",
    "མཐོང་བ་ཉིད་གནོད་བྱེད་དུ་མཐོང་བས་སྟོབས་དང་ལྡན་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་སྐད་ཅིག་སྔ་ཕྱི་ཐ་དད་ཀྱང་ཕན་ཚུན་དབེན་པར་མ་རྟོགས་པའི་ཕྱིར་འཁྲུལ་པའི་རྒྱུར་འཐད་དོ།",
    "ཡང་ན་ཡོད་པ་དམིགས་པ་ནི་ད་ལྟར་ཡོད་པ་དམིགས་པ་ཡིན་པས་དེ་ནི་དུས་གཞན་དུ་ཡོད་པར་འཁྲུལ་པའི་རྒྱུ་ཡིན་ལ།",
    "གཞན་དུ་ཡོད་པར་འཁྲུལ་པ་ད་ལྟའི་མཐོང་བ་མི་ངེས་པའི་རྒྱུར་ཇི་ལྟར་འགྱུར།",
    "ད་ནི་མི་རྟག་པ་ཉིད་གཞན་ཡིན་པར་འདོད་པ་སུན་དབྱུང་བའི་ཕྱིར།",
    "དེ་ལ་མི་དགོས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མི་རྟག་པ་གཞན་དེས་དངོས་པོ་རྟག་པ་ལས་རྣམ་པར་མི་འབྱེད་པའི་ཕྱིར་ཏེ།",
    "མཐར་དངོས་པོའི་བདག་ཉིད་མི་རྟག་པའི་རང་བཞིན་དུ་ཁས་བླང་པར་བྱ་བས་ཉེ་བར་སྒྱུར་བྱེད་གཞན་གྱིས་ཅི་བྱ།",
    "གལ་ཏེ་ཉེ་བར་སྒྱུར་བྱེད་གཞན་མེད་ན་དེའི་རང་བཞིན་མི་རྟག་པར་མི་འགྲུབ་པས་གཞན་ཁས་ལེན་ཏོ་ཞེ་ན།",
    "རང་ཉིད་མི་རྟག་པ་མ་ཡིན་པའི་རང་བཞིན་དུ་བསྐྱེད་ན་གཞན་གྱིས་མི་རྟག་པར་བསྒྱུར་བར་འགལ་ལོ་ཞེས་སྟོན་པ་ནི་རང་བཞིན་གྱིས་ཞེས་བྱ་བའོ།",
    "ཡུལ་འགའ་ཞིག་ན་རྫས་ཀྱི་རིགས་ཁ་ཅིག་རོ་སྐྱུར་བ་ལ་སོགས་པ་ཅི་ཞིག་ལྟར་ཁོ་ན་མཐོང་བ་ཞེས་ངེས་པར་བཟུང་བས།",
    "དེ་ལྟར་མ་མཐོང་ཡང་དེ་ལས་ལྡོག་པར་ཁས་ལེན་པ་ལ་མངོན་སུམ་གྱིས་གནོད་པ་བརྗོད་པ་ནི་གཞན་ན་གཞན་དུ་སྣང་ངོ་ཞེས་བྱ་བའོ།",
    "ཡུལ་འགའ་ཞིག་ཏུ་རྫས་ཀྱི་རིགས་ཁ་ཅིག་རྣམ་པ་འགའ་ཞིག་ལས་གཞན་དུ་མ་མཐོང་བས་རྣམ་པ་གཞན་ལས་ལྡོག་པར་འདོད་པ་ལ།",
    "གཞན་ལ་མེད་པར་ངེས་པ་ལ།",
    "གཞན་དུ་སྲིད་པའི་རྗེས་སུ་དཔག་པས་གནོད་དོ་ཞེས་གསུངས་པ་ནི་ཡུལ་དེ་པ་རྣམས་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ནུས་པའི་ཁྱད་པར་དཔེར་བསྟན་པ་དང་།",
    "དཔེར་བསྟན་པ་དེ་ཉིད་ལ་གཞན་གྱི་ལོག་པར་དགག་པའོ།",
    "དང་པོ་ནི་རྒྱུའི་ཁྱད་པར་སྲིད་པ་རྣམས་ལ་ཡོན་ཏན་གཞན་དུ་སྲིད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "དེས་ན་ལྟོས་པ་དང་བཅས་པ་ནི་ངེས་པར་འགྱུར་བས་འགལ་བས་ཁྱབ་པའི་ཕྱིར།",
    "ངེས་པའི་མཚན་ཉིད་ཀྱི་མི་འཁྲུལ་པ་ལ་ལྟོས་བཅས་ཀྱིས་གནོད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ལ་དེ་མི་འཁྲུལ་བས་རྗེས་སུ་དཔག་པར་ནུས་སོ་ཞེས་དཔེར་བསྟན་པ་ནི།",
    "རྒྱུ་ཁྱད་པར་མེད་ན་ནི་ཞེས་བྱ་བའོ།",
    "རྗོད་འདོད་ལ་ཡོད་པའི་ཁྱད་པར་དང་རྐན་དང་ལྕེ་ལ་སོགས་པའི་ཁྱད་པར་གྱི་བྱེད་པའི་ཡུལ་ཡང་འབྲས་བུའི་ཁྱད་པར་ཡིན་པར་གྲུབ་བོ།",
    "རྗོད་འདོད་ཙམ་གྱི་རང་བཞིན་དུ་གྱུར་པའི་སྐྱེས་བུས་བསྐྱེད་པར་བྱ་བ་ཁྱད་པར་ཡིན་པ་འགོག་པ་ནི།",
    "རྗོད་འདོད་ཙམ་གྱིས་སྐྱེད་པར་བྱ་བའི་ཁྱད་པར་མེད་པས་ན།",
    "ཁྱད་པར་སྐྱེས་བྱ་མེད་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "གལ་ཏེ་རྗོད་འདོད་ཀྱི་མཚན་ཉིད་ཙམ་དེ་ཁྱད་པར་གྱི་རྒྱུ་ཡིན་ན་ནི་རྒྱུའི་མཚན་ཉིད་ཐ་མི་དད་པ་ལས་འབྲས་བུ་ཐ་དད་པའི་མཚན་ཉིད་འགལ་ཏེ།",
    "སྐྱེས་བུའི་བྱས་པའི་རྒྱུ་ཡིན་ལ།",
    "དེ་ལྟར་ན་སྐྱེས་བུའི་བསྐྱེད་བྱར་གྲུབ་པའི་ཁྱད་པར་དེ་སྐྱེས་བུས་མ་བྱས་པར་འདོད་པ་ལ་དམིགས་ན་ནི།",
    "ལྷན་ཅིག་མཐོང་བས་དེ་དང་རྒྱུ་གཅིག་པར་ཁས་ལེན་པ་ལ་གནོད་པར་བརྗོད་པ་དང་།",
    "འདོད་ཆགས་དང་བྲལ་བ་སྲིད་པ་བཀག་པས་འདོད་ཆགས་ཀྱི་རྒྱུ་ཅན་དུ་སྒྲུབ་པར་མི་ནུས་པ་དང་།",
    "སྐྱེས་བུའི་ཡོན་ཏན་ཁྱད་པར་གྱི་རྒྱུ་ལ་མི་ལྟོས་པའི་དགོས་པ་དང་།",
    "སོགས་དཔོག་པར་འགྱུར་ཏེ།",
    "ཆགས་ལྡན་ཉིད་ནི་སྨྲ་བ་པོ་ཉིད་ཀྱི་སྐྱེད་བྱེད་ལས་རྒྱུའི་ཁྱད་པར་གཞན་ལ་མི་ལྟོས་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟར་ནས་མ་ཡིན་ཏེའི་བར་གྱིས་ནི་ཁྱད་པར་གྱི་རྒྱུ་ལ་མི་ལྟོས་པའི་མཚན་ཉིད་དགག་པའི་དོན་བསྟན་ཏོ།",
    "དང་པོ་ནི་ཡོན་ཏན་ཐམས་ཅད་ལ་ཁྱད་པར་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "སྨྲ་བ་པོ་ཉིད་ཀྱི་མཚན་ཉིད་ཁྱད་པར་མེད་ཀྱང་བླུན་པ་དང་།",
    "གཏོང་བ་ཆེ་བ་ལ་སོགས་པའི་སྐྱེས་བུའི་ཡོན་ཏན་ལ་ཁྱད་པར་དམིགས་པས་དེ་དག་ནུས་པ་ཅིག་པར་འགལ་ཏེ་སྨྲ་བ་པོའི་ནུས་པ་ཁྱད་པར་མེད་ཀྱང་ཡོན་ཏན་སྐྱེད་པའི་ནུས་པ་ཁྱད་པར་ཡོད་པ་འགལ་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་ནི་ལེགས་པར་བྱ་བའི་བྱེ་བྲག་ལས་ཁྱད་པར་རྟོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "སྐྱེས་བུ་ཙམ་དང་སྨྲ་བ་པོ་ཙམ་དུ་བྱེད་པའི་རྒྱུ་ལས་ཐ་དད་པའི་རྒྱུའི་ཁྱད་པར་ལས་ཆགས་པ་ཆེ་བ་དང་།",
    "དེ་ནི་ལྷན་ཅིག་མཐོང་བས་རྒྱུ་གཅིག་པར་ཁས་ལེན་པ་ལ་གནོད་པ་བརྗོད་པའོ།",
    "དེ་ལས་ཀྱང་དཔག་པར་བྱ་བ་ནི་དཔོག་བྱེད་ཀྱི་རྒྱུ་ལས་གཞན་ལ་མི་ལྟོས་པས་ཁྱབ་པ་གྲུབ་བོ་ཞེས་ཟེར་ན།",
    "ཆགས་བྲལ་དང་ཕན་ཚུན་སྤངས་པའི་འགལ་བ་ནི་གྲུབ་ཀྱང་དེའི་ངོ་བོ་བཀག་པར་འགྱུར་གྱི།",
    "ཆགས་བྲལ་ནི་བློའི་ཁྱད་པར་ཡིན་པས་དེ་དང་ཕན་ཚུན་སྤངས་པས་འགལ་བའི་ཚིག་ལ་སོགས་པ་ནི།",
    "ལྷན་ཅིག་མི་གནས་པའི་འགལ་བས་དེ་དགག་ནུས་ཀྱང་དེ་ཉིད་མ་གྲུབ་བོ་ཞེས་སྟོན་པ་ནི་མི་སྲིད་པར་ནས་མི་འགྲུབ་པའི་ཕྱིར་རོའི་བར་རོ།",
    "དེ་ལྟར་གསུམ་གྱིས་གཞན་བཀག་པས་དེའི་རྒྱུ་ཅན་དུ་མི་འགྲུབ་པར་བསྟན་ནས།",
    "སྔར་རིག་བྱེད་ཀྱི་ཚིག་ཀྱང་སྐྱེས་བུས་བྱས་པ་ཡིན་ཏེ།",
    "སྐྱེས་བུས་མ་བྱས་པ་ལ་ཡོད་པའི་ཁྱད་པར་དང་བྲལ་བ།",
    "ཚིག་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་ཏེ།",
    "ཁྱད་པར་ཐམས་ཅད་ལ་ཁྱབ་པའི་ངོ་བོ་སྤྱིའི་རང་བཞིན་འབྲས་བུར་གྲུབ་བོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "འོ་ན་རིག་བྱེད་ཀྱི་ངག་དང་ངག་གཞན་ལ་ཡང་རིགས་མི་མཐུན་པའི་ཁྱད་པར་ཡོད་ཀྱང་བལྟར་མི་རུང་བ་ཡིན་ནོ།",
    "དེས་ན་ཁྱད་པར་བལྟར་མི་རུང་བ་གཞན་དང་བྲལ་བའམ།",
    "བལྟར་མི་རུང་བའི་ཁྱད་པར་དེའི་ངོ་བོར་འགལ་བ་དང་།",
    "གཉིས་པ་བལྟར་མི་རུང་བའི་ཁྱད་པར་དེའི་ངོ་བོར་འགལ་བ་འདི་ལ་རྣམ་པ་གཉིས་ཏེ།",
    "ཁྱད་པར་མངོན་སུམ་ལ་མི་སྣང་བའམ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པ་སེལ་བས་ལན་བརྗོད་པ་ནི།",
    "པར་རྣམ་པ་དང་ལྡན་པའམ།",
    "རྣམ་པ་དང་ལྡན་པའི་ཁྱད་པར་མཐོང་བ་ལ་དེ་མེད་པར་འཁྲུལ་པའི་རྒྱུ་ནི་མི་སྲིད་དེ།",
    "འོ་ན་རྣམ་པ་དང་མི་ལྡན་པའི་རང་བཞིན་ཡོད་པ་མྱོང་ཡང་མེད་པར་འཁྲུལ་པའི་རྒྱུ་ནི་སྲིད་པ་ཡིན་ནོ།",
    "དེས་ན་འདི་ཡང་ཐ་མི་དད་པར་ངེས་པའི་མཚན་ཉིད་འཁྲུལ་པ་མཐོང་བས།",
    "ཐ་མི་དད་པར་ངེས་པའི་རྣམ་པར་རྟོག་པ་འཁྲུལ་པར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "ཡོན་ཏན་ཐམས་ཅད་ལ་ཁྱད་པར་མཐོང་བའི་ཕྱིར་དང་།",
    "འབྲེལ་པར་ནི་འགལ་བར་འགྱུར་རོ་སྙམ་ན།",
    "ལེགས་པར་བྱ་བའི་བྱེ་བྲག་ལས་ཁྱད་པར་རྟོགས་པའི་ཕྱིར་ན།",
    "དེ་ལྟར་གོམས་པར་བྱེད་པ་ནི་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཁྱད་པར་རྣམས་ནི་གཞན་ལ་ཡང་བྱ་བར་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བས་དེ་དང་གཞན་ཁྱད་པར་མེད་པར་མཐོང་བར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་མཐོང་བ་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་ནི་ཁྱད་པར་མེད་པའི་སྒྲུབ་བྱེད་མ་ཡིན་ནོ་ཞེས་དོགས་ན།",
    "འཁྲུལ་པར་མི་འགྲུབ་བོ་ཞེས་བྱ་བའོ།",
    "གནོད་པར་བྱེད་པ་མེད་པས་ཞེས་བྱ་བའོ།",
    "ཁྱད་པར་བལྟར་མི་རུང་བ་ཡོད་པ་ལ།",
    "མེད་པར་འཁྲུལ་པའི་རྒྱུ་ནི་དེའི་བདག་ཉིད་ཀྱི་བལྟར་རུང་ཁྱད་པར་མེད་པ་ཡིན་པར་མི་འཐད་དེ་འགལ་བའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "དེའི་ཕྱིར་དེ་ཙམ་དང་འབྲེལ་པའི་ཞེས་བྱ་བ་ལ་སོགས་པས་གཉིས་ཁོ་ན་ལ་ལྡོག་པ་ངེས་པ་ཡོད་པར་བསྟན་པ་དང་།",
    "དགག་པའི་གཏན་ཚིགས་གྲངས་ངེས་པར་གྲུབ་པ་གསུམ་སྟེ།",
    "གཉི་ག་སྣང་བ་མི་དམིགས་པར་བསྡུ་བ་དྲན་པར་བྱ་བའོ།",
    "འདིའི་དོན་ནི་བསྒྲུབ་པའི་གཏན་ཚིགས་འབྲེལ་པ་ལ་ལྟོས་པ་ནི་ལོག་པར་རྟོགས་པའི་ཡུལ་ཉིད་མ་ཡིན་ནོ།",
    "དེས་ན་དེ་ལ་དཔེར་འབྲེལ་པ་སྟོན་པའི་སྒོ་ནས་སྒྲུབ་པའི་རྟགས་འབྲེལ་པ་ལྟོས་པར་མ་བསྒྲུབས་པས་ཀྱང་དེ་ལྟར་གྲུབ་བོ།",
    "དགག་པ་འབྲེལ་པ་ལ་ལྟོས་པར་བསྒྲུབ་དགོས་ལ།",
    "དགག་པ་འབྲེལ་པ་ལ་ལྟོས་པར་ཡང་འདི་ལྟར་འགྲུབ་སྟེ།",
    "དེ་ཡང་དཔེ་ལ་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ དཔེ་ཡང་འབྲེལ་པ་དྲན་པ་ལ་མཁོ་བ་ཡིན་ཏེ།",
