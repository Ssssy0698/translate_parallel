    "ངོ་ཚ་སྤངས་ནས་གསལ་བྱས་ང་རྒྱལ་གྱིས་མ་ཡིན།",
    "དེས་འདིར་བློ་བཟངས་རིགས་ཚུལ་ཅན་གྱིས་བཟོད་པར་མཛོད།",
    "གདོང་དག་པ་ལ་སོགས་པ་བྱས་ཏེ།",
    "དྲི་རྣམས་ཀྱིས་མཎྜལ་གྲུ་བཞི་བྱས་ལ།",
    "མེད་ན་ཐམས་ཅད་ཡིད་ཀྱིས་བྱས་ནས་དེ་ལ་ཇི་ལྟར་རྙེད་པའི་སྟན་བདེ་བ་ལ་ཉེ་བར་གནས་ནས།",
    "ནམ་མཁའི་ངོས་ཐམས་ཅད་ཁྱབ་པར་བལྟས་ནས།",
    "ཞེས་བྱ་བས་བརྟན་པར་བྱའོ།",
    "དེའི་རང་བཞིན་གྱི་ར་བ་དང་གུར་ཡང་བསམ་པར་བྱའོ།",
    "བཾ་དཀར་པོ་ལས་བྱུང་ཞིང་དབུས་སུ་བུམ་པས་མཚན་པའི་ཆུའི་དཀྱིལ་འཁོར་དཀར་པོ་འབར་བའི་མེའི་གཟི་བརྗིད་ལྟ་བུའི་རྡོ་རྗེའི་གུར་གཡོགས་པར་བསམ་པར་བྱའོ།",
    "ལྟེ་བར་རྡོ་རྗེ་ཧཱུྃ་མཛད་གནས་པས་བགེགས་སྐྲོད་པར་བྱེད་པར་བསམ་པར་བྱའོ།",
    "དེ་ལ་སྔར་གསུངས་པའི་ཤར་གྱི་རྩིབས་ལ་གཤིན་རྗེ་གཤེད་ཁ་དོག་ནག་པོ་ཞལ་གཡས་གཡོན་གཉིས་དཀར་བ་དང་དམར་བའོ།",
    "རྡོ་རྗེ་ལྕགས་ཀྱུ་དང་དབྱུག་པ་དཀར་པོ་དང་སྔར་གསུངས་པའི་གཟུགས་ཅན་གྱི་རལ་གྲི་དང་ནོར་བུ་འཛིན་པའོ།",
    "འདི་རྣམས་ལས་འདོད་པའི་རྒྱལ་པོ་མ་གཏོགས་པ་གཤིན་རྗེ་གཤེད་ལ་སོགས་པ་དྲུག་ནི་གཙིགས་པའི་ཁྲོ་བོ་སྟེ་འཇིགས་པའི་རྣམ་པར་སྨིན་མ་གཡོ་ཞིང་ཁྲོ་གཉེར་དང་བཅས་པའི་ཀླུ་མཐའ་ཡས་སྔོན་པོས་གྱེན་དུ་བརྫེས་པའི་སྐྲ་སེར་པོ་བཅིངས་པའོ།",
    "འཇོག་པོ་དཀར་པོས་རྣ་རྒྱན་བྱས་པའོ།",
    "པདྨ་དཀར་པོས་དོ་ཤལ་བྱས་པ།",
    "ཀརྐོ་ཊ་ལྗང་གུས་སེ་རལ་ཁར་བྱས་པ།",
    "རིགས་ལྡན་ཁྲོ་བོས་དཔུང་རྒྱན་བྱས་པ།",
    "དུང་སྐྱོང་སེར་པོས་གདུ་བུ་བྱས་པ།",
    "ནོར་རྒྱས་དཀར་པོས་སྐེ་རགས་བྱས་པ།",
    "པདྨ་དཀར་པོས་རྐང་གདུབ་བྱས་པ།",
    "རོལ་པའི་ཁྲོ་བོ་སྟེ་ཅུང་ཞིག་མཆེ་བ་གཙིགས་པར་སྣང་བ།",
    "ཀུན་རྫོབ་དང་ཡོངས་སུ་རྒྱལ་བ་ཤེས་པ་རྣམ་པར་དག་པའོ།",
    "ཡང་རྡོ་རྗེ་ཧཱུྃ་མཛད་ནི་ཡེ་ཤེས་བཅུ་པོ་འདི་རྣམས་རྣམ་པར་དག་པ་སྒྲ་ཇི་བཞིན་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ནོ།",
    "བླ་ན་མེད་པའི་ཤེས་རབ་ཀྱི་རང་བཞིན་ཟླ་བ་རྣམ་པར་བསམས་ནས།",
    "དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་ཀ་ལ་སོགས་པ་ཉིས་འགྱུར་གསལ་བྱེད་སུམ་ཅུ་རྩ་བཞི་ཕྲེང་གཉིས་ཀྱི་དབུས་སུ་གནས་པ།",
    "བདག་ཉིད་མཉེས་ཤིང་གཉི་གའི་རྗེས་སུ་ཆགས་པར་བྱས་ནས།",
    "བློ་ཡིས་སྐྱེ་བོའི་ཚོགས་དབུགས་དབྱུང་བའི་ཕྱིར་དེར་གཞུག་པར་བྱའོ།",
    "བྲུཾ་ཨཱཾ་ཛྲཱིཾ་ཁཾ་ཧཱུྃ་ཞེས་བྱ་བས་རྣམ་པར་སྣང་མཛད་རིན་ཆེན་འབྱུང་ལྡན་འོད་དཔག་ཏུ་མེད་པ་དོན་ཡོད་གྲུབ་པ་མི་བསྐྱོད་པ་རྣམས་བཏོན་ནས་ཐམས་ཅད་དེ་དང་དེའི་དོན་བྱེད་པར་དམིགས་ནས།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "སྤྱོད་པ་དྲི་མེད་ཀུན་དུ་བཟང་པོ་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "ཡོན་ཏན་རིན་ཆེན་མང་པོའི་གཏེར་གྱུར་བདག་ལ་དགྱེས་པར་མཛོད།",
    "གསོལ་བ་བཏབ་པས་བདག་ཉིད་ཀྱི་ཐུགས་རྡོ་རྗེའི་ནང་དུ་ཞུགས་པར་བལྟའོ།",
    "ཞེས་པས་བྱིན་གྱིས་བརླབ་ཅིང་བརྟན་པར་བྱའོ།",
    "སྔར་བཞིན་དུ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རྡུལ་ཕྲ་རབ་ཀྱི་ངོ་བོ།",
    "གཉིས་པའི་ལུས་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བློས་བཅུག་ལ་རྡུལ་ཕྲ་རབ་སོ་སོ་ལ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་བདག་ཉིད་དུ་ལྷག་པར་བསམ་པར་བྱ་སྟེ།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཡི་གེ་མཾ་གྱི་ས་བོན་ལས་དེ་བཞིན་གཤེགས་པ་སྤྲོ་བ་ལ་སོགས་པ་སྔོན་དུ་འགྲོ་བ་ལས་གཞལ་ཡས་ཁང་ན་གནས་པའི་ལྷ་བཅུ་དགུའི་བདག་ཉིད་ཅན་གྱི་མི་བསྐྱོད་པ་གཙོ་བོར་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ཁ་དོག་ལ་སོགས་པ་དེ་ཉིད་དུ་གསལ་བར་བྱས་ནས།",
    "ཅི་ལྟར་རིགས་པའི་དཔག་ཏུ་མེད་པའི་སྤྲུལ་པས་འགྲོ་བའི་དོན་བྱས་ནས་བསྡུས་ཏེ།",
    "སླར་འོངས་ཏེ་སྔར་གྱི་སྣ་ཚོགས་པདྨ་དང་ཟླ་བའི་གདན་ལ་བཞུགས་སོ།",
    "ཨཱ་རོ་ལྀཀ་ཅེས་པས་འདུ་ཤེས་ཀྱི་ཕུང་པོ་རྣམ་པར་དག་པ་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ལུས་ཐམས་ཅད་དང་རྩ་བའི་ཞལ་དམར་པོ།",
    "པྲཛྙཱ་དྷྲྀཀ་ཅེས་པས་འདུ་བྱེད་ཀྱི་ཕུང་པོ་རྣམ་པར་དག་པ་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ལུས་ཐམས་ཅད་དང་རྩ་བའི་ཞལ་ལྗང་གུ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་རང་བཞིན་རོ་རྣམ་པར་དག་པ་རོས་གང་བའི་ལྷུང་བཟེད་དམར་པོ་དང་།",
    "ཡ་མཱནྟ་ཀྲྀཏ་ཅེས་བྱ་བས་གཤིན་རྗེ་གཤེད་དད་པའི་རང་བཞིན་སྔར་གསུངས་པའི་ཁ་དོག་དང་ལྡན་པ་ཤར་ཕྱོགས་ཀྱི་སྒོ་རུའོ།",
    "དཀྱིལ་འཁོར་པ་སོ་སོའི་མིག་ལ་སོགས་པ་བྱིན་གྱིས་བརླབ་པ་ནི་རབ་ཀྱི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་དང་།",
    "ཡང་རྡོ་རྗེ་སེམས་དཔའ་དང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་ཐུགས་རྡོ་རྗེ་དང་མཱ་མ་ཀཱི་དང་ཕྱག་ན་རྡོ་རྗེ་དང་སྒྲ་རྡོ་རྗེ་མ་དང་ཤེས་རབ་མཐར་བྱེད་ལ་སོགས་པ་ཁྲོ་བོ་རྣམས་ཀྱི་མི་བསྐྱོད་པའོ།",
    "རྣམ་པར་སྣང་མཛད་དག་པ་ཆེ།",
    "ཅེས་བྱ་བས་གཞལ་ཡས་ཁང་ན་གནས་པའི་ཀ་བ་དང་བུམ་པ་རྣམས་བདག་ཉིད་ལ་བསྟོད་པ་བྱེད་པར་བསམ་པར་བྱའོ།",
    "བྲུཾ་ལ་སོགས་པའི་འོད་ཟེར་ནི་རྣམ་པར་བཞུ་སྟེ།",
    "དེ་ཉིད་ཀྱི་ནང་དུ་ཞུགས་པར་བསམས་ནས།",
    "དེ་རུ་རྣམ་པར་བཀོད་པའི་རབ་ཏུ་གསལ་བའི་ཨོཾ་དཀར་པོའི་འོད་ཟེར་གྱིས་བཀུག་པའི་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་རྣམས་བཅུག་ནས་དེ་ཉིད་གསུམ་གྱིས་ལན་མང་དུ་བསྔགས་ཏེ།",
    "འཇིག་རྟེན་གསུམ་མ་ལུས་པར་སྣང་བར་བྱས་ཏེ་ཡང་དང་ཡང་དུ་དེ་ཉིད་དུ་ཐིམ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཐིག་ལེའི་རྣལ་འབྱོར་རོ།",
