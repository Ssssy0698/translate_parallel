    "འདི་ནི་ཁྱོད་ཀྱི་དམ་ཚིག་གསང་།",
    "རིགས་རྣམས་ཀུན་གྱིས་ཁྱོད་བརླག་འགྱུར།",
    "རྡོ་རྗེ་ཚིག་གིས་ཨ་ཞེས་བྱ་བ་ཇི་སྲིད་ཟླ་བ་གཅིག་གིས་སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་བ་དེ་ཇི་སྲིད་ཀྱི་བར་དུ་བཟླས་བརྗོད་བྱའོ།",
    "དེ་བཞིན་དུ་གཞན་ཐམས་ཅད་ནི་དམ་ཚིག་གི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་དུ་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གང་གི་ཚེ་སྒྲུབ་པ་དང་རབ་ཏུ་ལྡན་པའི་རྣལ་འབྱོར་པ་ལ་བདུད་དག་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཟུགས་ཀྱི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཡུལ་ལས་རྣལ་འབྱོར་པའི་སེམས་ཕྱིར་ཕྱོགས་པར་བྱ་བའི་ཕྱིར་འཇུག་པ་མཐོང་ན།",
    "ཐམས་ཅད་རྡོ་རྗེའི་ལས་ཀྱི་མཆོག་གིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེའི་བསྡུ་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པ་གང་གིས་འདོད་ཆགས་ལ་སོགས་པ་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་དུ་བསྒོམས་པའི་མཚན་ཉིད་ཀྱིས་སྤོང་བར་གྱུར་པ་སྟེ།",
    "ཉོན་མོངས་པ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "ཉོན་མོངས་པའི་ངོ་བོ་ཉིད་ལ་ཆགས་པའི་མཚན་ཉིད་ཀྱི་རྗེས་སུ་ཆགས་པ་དང་།",
    "རེག་པ་དང་།",
    "ཉོན་མོངས་པའི་ངོ་བོ་ཉིད་མནར་སེམས་དགུ་པོའི་དངོས་པོའི་དབྱེ་བ་དང་གནས་མེད་པ་ལ་འཁྲུལ་པ་ནི་བཅུ་པ་སྟེ།",
    "དེ་དག་གི་ངོ་བོ་ཉིད་སྣ་ཚོགས་པའི་ཚུལ་དུ་རྣམ་པར་རྟོག་པ་ནི་སྤྲོས་པའོ།",
    "ཞེ་སྡང་གི་སྤྲོས་པ་མེད་པར་གྱུར་པ་ཉིད་ནི།",
    "ཞེ་སྡང་གི་སྤྲོས་པ་མེད་པ་དེས།",
    "དོན་དམ་པར་ནི་གཏི་མུག་ལ་གཏི་མུག་གི་དངོས་པོ་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "ཚིག་གི་དགོད་པ་གཞན་ནི་སྔ་མ་བཞིན་ནོ།",
    "ཀྱང་ཞེས་བྱ་བའི་སྒྲས་ནི་ཉུང་ཟད་ཅིག་བསད་པས་ནི་ཤིན་ཏུ་ཡང་ངན་སོང་དུ་སྐྱེ་བར་མི་འགྱུར་རོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "མཛུབ་མོ་གཉིས་ཀྱིས་བསྡིགས་ནས་ནི།",
    "པུས་མོ་གཡས་པ་དགུག་པའི་ཚུལ་གྱིས་གནས་པ་ལས་བར་དུ་མཐོ་ལྔས་ཆོད་པར་འཇོག་པ་འདི་ནི།",
    "དེ་སྟོན་པར་བྱེད་པའི་སྒྲ་ཧཱུཾ་གི་གཟུགས་ཅན་ཡང་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཡིན་ནོ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་གིས་བཅིངས་ནས།",
    "སླར་ཡང་དམ་ཚིག་གིས་བཅིངས་ནས།",
    "དེ་དག་གིས་གཙིགས་ཤིང་ཤིན་ཏུ་ཁྲོ་བས་ཚེམས་ཀྱི་སྒྲོས་གནོན་པ་སྟེ།",
    "རྡོ་རྗེ་ནི་རྩེ་མོ་བཞི་པའི་རྡོ་རྗེ་འབར་བའོ།",
    "ཚིག་འོག་མ་རྣམས་ལ་རེ་རེ་ཞིང་ཡང་སྦྱར་བར་བྱའོ།",
    "རང་གི་དཀྱིལ་འཁོར་གྱིས་བྱིན་གྱིས་བརླབས་ནས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ལྷ་ལ་སོགས་པ་དེ་དག་རང་གི་དཀྱིལ་འཁོར་ལ་གནས་པའི་ཁྲོ་བོའི་ཆ་ལུགས་ལ་ཞུགས་ནས།",
    "རང་གི་དཀྱིལ་འཁོར་ལས་བཀུག་སྟེ།",
    "ངན་སོང་ལ་སོགས་པ་ཐམས་ཅད་དོ།",
    "དེ་ལས་བྱུང་བའི་ཐབས་ཀྱི་ཁྲོ་བོའི་གཟུགས་ཅན་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པའི་ཁྲོ་བོའི་ཚུལ་ཏེ་ཐུན་མོང་ངོ།",
    "གདུག་པ་ཐམས་ཅད་རང་གི་བཀའ་ལ་ངེས་པར་སྦྱར་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡི་ནང་གི་དཀྱིལ་འཁོར་ནི།",
    "དེ་གང་གིས་བསྡུས་ཤིང་བཅིངས་པ་དེ་ནི་རྡོ་རྗེ་ཧཱུཾ་མཛད་བསྡུས་པའོ།",
    "གང་གི་ཕྱིར་ལྷ་ཐམས་ཅད་ཀྱི་སྔགས་ནི་འདིར་ཡི་གེ་ཧཱུཾ་ཞེས་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "བར་སྣང་གི་ཕྱོགས་སུ་སྔ་མ་བཞིན་དུ་ཡང་དག་པར་གཞག་པར་བྱ་སྟེ།",
    "གཡས་པ་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རང་གི་མཚན་མ་བསྡམས་ཤིང་སྟང་སྟབས་དང་བཅས་པ་བཞུགས་པའོ།",
    "ཕྱིའི་མཚམས་བཞིའི་ལྷའི་སྣམ་བུ་ལ་སྒེག་མོ་ལ་སོགས་པའི་ཁྲོ་མོ་བཞི་དེ་བཞིན་དུ་བྲི་བར་བྱའོ།",
    "བྱང་གི་སྒོར་མདུང་རྩེ་གསུམ་པ་དགོད་པའོ།",
    "གཅིག་གིས་སྨད་གཡོགས་བྱ།",
    "དེ་ཡང་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་སོར་མོ་རྣམས་ནང་དུ་འབར་བ་ལྟ་བུར་བཞག་སྟེ།",
    "མཐེ་བོང་རྡོ་རྗེ་བསྒྲེང་བ་འདི་ནི་རྡོ་རྗེ་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་འཛིན་ཅིང་བདག་གིར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་རྡོ་རྗེ་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཡོངས་སུ་འཛིན་པ་སྟེ།",
    "དམ་ཚིག་ཕྱག་རྒྱ་བཅིངས་པ་དང་བཅས་པས་དཔལ་རྡོ་རྗེ་ཧཱུཾ་མཛད་དུ་བདག་ཉིད་ལྷག་པར་མོས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་པ་དང་བཅས་པའི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ང་རྒྱལ་དང་ལྡན་པར་གྱུར་པས།",
    "ཡང་རང་གི་སྦྱོར་བས་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ལ་འཇུག་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་ཡོངས་སུ་བཟུང་བའི་རྡོ་རྗེ་དང་།",
    "མེ་ཏོག་གི་ཡལ་ག་ལས་རྣམ་པར་རྒྱལ་པའི་བུམ་པ་དང་།",
    "བུམ་པ་གང་བ་རྣམས་ལ་ཧཱུཾ་ཞེས་བྱ་བ་རེ་རེ་ཞིང་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་ལ་དཀྱིལ་འཁོར་གྱི་སྒོ་བཞི་ཕྱེ་སྟེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱས་ཧཱུཾ་དྲྀ་ཤྱ་ཛ་ཧཱུཾ་བོཾ་ཧོ་ས་མ་ཡ་སྟྭཾ།",
    "འཇུག་པའི་ཕྱག་རྒྱ་ཉིད་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ན་བཟའ་དང་བླ་རེ་ལ་སོགས་པ་ཕུལ་ལ།",
    "ཕྱི་རོལ་དུ་གླུ་དང་གར་དང་རོལ་མོ་དང་།",
    "ལྕགས་སྒྲོག་དང་འབེབས་པ་ཡོངས་སུ་བཟླས་པས་རང་གི་གདོང་གཡོགས་ཏེ།",
    "ཡང་རྡོ་རྗེ་དབབ་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ནས།",
    "དེ་ནས་བླངས་ལ་ཧཱུཾ་ཉིད་ཀྱིས་རང་གི་མགོ་ལ་བཅིང་བར་བྱའོ།",
    "རྡོ་རྗེ་ཐལ་མོས་བསྐོར་བར་ཕྱག་བྱས་ལ།",
    "དེ་ལ་དང་པོའི་ཁོ་ནར་དམ་ཚིག་གི་ཕྱག་རྒྱས་ཡོངས་སུ་བཟུང་བའི་རྡོ་རྗེ་དང་།",
    "མེ་ཏོག་གི་ཡལ་ག་ལས་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ལ་སྔགས་འདི་བཟླས་བརྗོད་ཉི་ཤུ་རྩ་གཅིག་བྱ་སྟེ།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
    "དེ་ནས་འདིས་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཆེན་པོར་བྱིན་གྱིས་བརླབས་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཉིན་རེ་སྦྱོར་བས་ཇི་སྲིད་ཟླ་བ་གཅིག་ཙམ་གྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ནས།",
    "ཧཱུཾ་གིས་རང་གི་གནས་སུ་དགོད་པར་བྱས་ལ།",
    "ཉིན་རེའི་སྦྱོར་བས་ཇི་སྲིད་ཟླ་བ་གཉིས་པའི་ཉ་ལ་བབ་པ་དེ་སྲིད་ཀྱི་བར་དུ་དཔག་ཏུ་མེད་པའི་བཟླས་བརྗོད་ཀྱིས་བསྒྲུབ་པར་བྱའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་ཟླ་བ་གཅིག་གི་བར་དུ་བཟླས་བརྗོད་དཔག་ཏུ་མེད་པ་བྱས་ནས།",
    "རང་གི་ལག་ཏུ་ཧཱུཾ་ལས་རྡོ་རྗེ་འབར་བ་བསམས་ལ་ཕྱོགས་གང་ན་བསྒྲུབ་པར་བྱ་བ་གནས་པ་དེ་ལ་རང་གི་ལག་ཏུ་བསམས་པའི་རྡོ་རྗེ་བསྒྲུབ་པར་བྱ་བ་ངེས་པར་གནོན་པའི་བསམ་པས་བསྣུན་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ཕྲ་མོ་འབིགས་བྱེད་ཀྱིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱའི་གཡས་པའི་མཛུབ་མོ་ལྕགས་ཀྱུས་གཡོན་ལོགས་ནས་གཡོན་པའི་མཛུབ་མོ་བཟུང་ལ།",
    "འདི་ནི་རྡོ་རྗེ་ཕྲ་མོ་འབིགས་བྱེད་དོ།",
    "དེ་གང་གིས་འགྱུར་ཞེ་ན།",
    "ཧཱུཾ་ཆེ་གེ་མོ་གྷཱ་ཏ་ཡ་ཧཱུཾ།",
    "རང་གི་ས་བོན་གྱི་སྦྱིན་སྲེག་གིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྔགས་པ་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པས་ཟིལ་གྱིས་གནོན་པ་དང་།",
    "དེ་ཡང་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ལྷ་མོར་བསམ་པར་བྱའོ།",
    "རང་གི་ས་བོན་རྡོ་རྗེ་རིགས་ཀྱི་གཟུགས་ཅན་གྱིས་ནམ་མཁའ་ཀུན་དུ་བཀང་ལ།",
    "རང་གི་ལུས་ལ་བྱེ་མའི་བུམ་པ་ལ་ཆུའི་བུམ་པ་བླུགས་པ་བཞིན་དུ་ཞུགས་ནས་བདག་ཉིད་རྡོ་རྗེའི་རིགས་ཀྱི་རྡུལ་ཕྲ་རབ་ལས་གྲུབ་པ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་གཞིག་པའི་ཕྱིར།",
    "རིའི་རྒྱལ་པོ་རི་རབ་ལ་སོགས་པའི་རི་བོ་ཆེན་པོ་རྣམས་སུ་ལྕགས་སྒྲོག་གིས་བཅིང་བར་གྱུར་པར་བསམ་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་གིས་བཅིངས་ལ།",
    "ཧཱུཾ་ནཱ་ག་ཆེ་གེ་མོ་ཧཱུཾ་ཞེས་ཤིན་ཏུ་ཁྲོས་པས་བཟླས་བརྗོད་བྱས་ལ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་ལུ་གུ་རྒྱུད་དུ་བཅིངས་ལ།",
    "ཡང་གཡོན་པའི་མཛུབ་མོས་སོ་བཟུང་སྟེ།",
    "ཧཱུཾ་ཀཱ་མ་དེ་བ་བ་ཤ་མ་ན་ཡ་ཧཱུཾ་ཞེས་བཟླས་བརྗོད་བྱས་ལ་རང་གི་ལུས་ལས་བྱུང་བའི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་རིམ་གྱིས་བཀུག་ནས།",
    "རེག་བྱ་རྣམས་སྤྲུལ་ལ་ཉེ་བར་དབབ་པར་བྱའོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཡོན་པ་འཁོར་ལོའི་ཚུལ་དུ་འཕྲེད་དུ་བཞག་ལ།",
    "དེ་ནས་དེ་ལ་མཛུབ་མོ་གཡས་པས་ཡང་དང་ཡང་དུ་དྲལ་བར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་འཁོར་ལོ་དྲལ་བ་སྟེ།",
    "གཡོན་པའི་མཛུབ་མོ་དང་།"
  ]
}