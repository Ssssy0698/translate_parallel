    "ཡེ་ནས་མ་བྱས་རང་བྱུང་རང་ཤར་བའི།",
    "ཇི་ལྟར་སྣང་ཡང་རང་བཞིན་མ་གྲུབ་པར།",
    "བདེ་བའི་མལ་དུ་དྲང་སྲོང་འདུག་སྟངས་བྱ།",
    "འདུག་སྟངས་བཅས་ཏེ་སྤྱི་བོའི་ནམ་མཁའ་ཡི།",
    "ལིང་ངེར་འདུག་པར་བསྒོམ་ལ་སེམས་བཟུང་ངོ།",
    "འདིའི་དུས་འདུག་སྟངས་ལྟ་སྟངས་ལ་སོགས་ཀྱིས།",
    "འདུ་འཛི་ནང་དུ་མི་འདུག་པར།",
    "འདུག་ས་སྡོད་བདེ་འགལ་རྐྱེན་མེད།",
    "འདུག་སྟངས་གཙོ་བོར་བྱ་བ་ཡིན།",
    "དྲང་སྲོང་འདུག་སྟངས་གཙོ་བོར་བྱ།",
    "སེང་གེའི་འདུག་སྟངས་གཙོ་བོར་བྱ།",
    "སྔ་དྲོ་གླང་བོའི་འདུག་སྟངས་བྱ།",
    "དགུང་ལ་སེང་གེའི་འདུག་སྟངས་བྱ།",
    "ཕྱི་དྲོ་དྲང་སྲོང་འདུག་སྟངས་བྱ།",
    "སྲོད་ལ་དྲང་སྲོང་འདུག་སྟངས་བྱ།",
    "ནམ་དགུང་གླང་བོའི་འདུག་སྟངས་བྱ།",
    "འདུག་སྟངས་དག་ལ་བསླབ་ཀྱང་ཆོག།",
    "རྒྱུན་དུ་སྐུ་གསུམ་འདུག་སྟངས་གྱེས།",
    "སྤྱིར་ཡང་རང་ཉིད་ཞེས་པའི་ཚིག་དེ་ལ།",
    "རྒོལ་བ་བྱེ་བྲག་པ་དེས་ནི་སྒྲ་མི་རྟག་པ་ཡིན་པའི་སྒྲུབ་བྱེད་བཀོད་ཀྱི་སྒྲ་རྟག་པ་ཡིན་པའི་སྒྲུབ་བྱེད་མ་བཀོད་འདུག་པའི་ཕྱིར་རོ་ཞེས་འཆད་པ།",
    "རྒོལ་བ་བྱེ་བྲག་པ་ཁོ་རང་རྒོལ་བ་སྐྱོན་ཅན་ཡིན་ཏེ།",
    "སྐབས་དེའི་གཞན་དོན་བསྒྲུབ་བྱ་ཡང་དག་ཡིན་པས་ཁྱབ་བོ་ཞེས་བསྟན་འདུག་པའི་ཕྱིར་རོ་ཞེ་འཆད་པ་ལ།",
    "རང་ལུགས་སྐྱོང་བ་ལ་དཀའ་གནས་ལས་གྲོལ་བར་མི་འདུག་པས།",
    "ང་རང་མི་ཞིག་ཡིན་པའི་ཆ་ནས་ངས་བསམ་བློ་ཇི་ལྟར་གཏོང་དགོས་ཞེས་པའམ།",
    "ཡང་ན་ང་རང་ཇི་ལྟར་འགྲོ་བ་ཡོངས་ལ་ཕན་པ་བསྒྲུབ་ནུས་པའི་མི་ཞིག་བྱེད་དགོས་ཞེས་པའམ།",
    "དོན་དངོས་སུ་རང་གཞན་ཀུན་ལ་གང་ཕན་སོགས་ཀྱི་ཆ་ལ་བློ་གཏོང་དགོས་དོན་མི་འདུག་ཟེར་བའམ།",
    "ཁོ་རང་གསོད་ཡུལ་དང་དུར་ས།",
    "རང་རང་སྐལ་བ་ཇི་བཞིན་སྤྲུལ་བའི་སྐུ།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ་དེ་ནི།",
    "བསྡད་ན་འདུག་གྲོགས།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་ཁུངས་བཙུན་དང་ཕྱག་ལེན་མ་ནོར་བ་ཞིག་ཏུ་གླེང་ས་མི་འགྲོ་ཡང་ཐམས་ཅད་ཀྱི་གཞི་རྩ་མ་ཎི་དང་འབྲེལ་ནས་རང་རང་སེམས་ཀྱི་དུང་བ་དང་དད་པ་དབྱངས་སུ་གྱེར་བ་ཤ་སྟག་ཡིན།",
    "ཕན་ཁེ་དང་གྱོང་གུད་སོགས་ཀྱི་ཕྱོགས་ལ་བསམ་གཞིགས་དང་སེམས་ཁུར་བྱེད་མཁན་གྱི་དཔྱོད་ལྡན་པའང་མི་ཉུང་བ་ཞིག་འདུག་སྟེ།",
    "ཡང་ན་བསམ་ཚུལ་གླེང་འོས་ཀྱི་ཆུ་ཚད་ཅི་ཡང་མི་འདུག་ནའང་།",
    "འབྲས་བུའི་དུས་སོགས་དུས་གསུམ་གང་དུའང་རང་གཞན་གང་རུང་ལ་གནོད་པའི་རྒྱུ་རུ་མི་འགྱུར་བའི་ངེས་པ་མེད་དེ།",
    "ནང་རིག་པའི་གཞི་རྐང་མ་བཟུང་བར་བོད་མི་རིགས་ཀྱི་རིག་གཞུང་རང་སྐྱ་ཐུབ་པ་ཞིག་ཚུགས་ཐབས་མེད་པ་གསལ་བོ་ཡིན་ནོ།",
    "ཕྱིའི་དངོས་པོའི་དཔལ་ཡོན་ཇི་ཙམ་རྒྱས་ཀྱང་དེ་ལ་བློ་འགེལ་ས་ཡེ་ནས་མི་འདུག་ལ།",
    "སྡུག་བསྔལ་མ་ལུས་པ་བསྐྱེད་པའི་རྩ་བ་ནི་སེམས་ལ་ཐུགས་འདུག་པ་མ་ཟད།",
    "མི་རིགས་ཀྱི་དར་རྒུད་སོགས་ལ་བསམ་བློ་མི་གཏོང་རང་གཏོང་ཡིན་ཞེས་ཁོ་བོས་ཚིག་ཐག་བཅད་ནས་སྨྲ་ཐུབ།",
    "ལུས་ལ་འོད་འཕྲོ་བ་བརྒྱད་མཐོང་ནས་པར་བརྒྱབ་འདུག་པས།",
    "མི་རིགས་མི་རིགས་ཟེར་ཡང་མི་རིགས་ཀྱི་རྩ་བ་ནི་སྐད་དང་ཡི་གེ་ལ་ཐུག་འདུག་གོ།",
    "ཅུང་ནོར་འདུག་ཅིའི་ཕྱིར་ནོར་འདུག་ཅེ་ན།",
    "ང་རང་ནི་ཆེས་དབུལ་ཕོངས་ཀྱི་གྲྭ་རྐྱང་ཞིག་ཡིན་ལ།",
    "བྲ་ཉེ་ཞེས་པ་གནའ་རབས་བོན་གྱིས་བཏགས་པའི་མིང་རང་སོར་གནས་པ་དང་།",
    "བོད་ཟླ་བཅུ་པའི་ཚེས་བཅོ་ལྔའི་ནམ་ཕྱེད་མཚམས་ལ་བལྟས་ནས་ཉ་དྲུག་འཛོམས་དུས་ཟླ་བའི་བྱང་དུ་སྨིན་དྲུག་འདུག་ན་ཆར་བཟང་།",
    "ཟེར་བ་དི་ནི་ལྷོ་ཕྱོགས་དེད་ནས་སེར་དྲག་གཏོང་ཉེ་དུས་སུ་སོག་སྤུངས་བརྒྱབ་ནས་མེ་སྦར་ན་སེར་བ་ཆར་བར་འགྲོ་བ་མང་ཟེར་སྲོལ་འདུག་ལྷགས་ཕྱོགས་དེ་ལས་ལྡོག་ན་སེར་བ་རི་རྩེར་འཁྱུད་པའམ་ཡང་ན་ཆུ་གཞུང་དུ་འགྲོ་བ་མང་།",
    "སྤྲིན་པ་ཁ་དོག་སེར་སྔོ་བྱུང་ཚེ་ཆར་མྱུར་བར་འབབ་རྒྱུ་སོགས་འཇའ་ཡི་ཟུག་ཕྱོགས་དང་ཟུག་དུས་ཟུག་སྟངས་སོགས་ཀྱི་བརྟག་པ་ལ་བརྟེན་ནས་གནམ་གཤིས་སྔོན་དཔག་བྱེད་པ།",
    "བྱ་གོ་བོས་ཚང་གསོག་དུས་གཅན་གཟན་གྲ་ལེགས་པས་གསོད་ཐབས་བྱེད་པ་དང་།",
    "ཕྱུགས་ཟོག་འདོགས་ཐག་ནས་གློད་འཕྲལ་ལམ་སེང་ཕྱིར་མི་འགྲང་བར་ཉལ་ནས་སྡོད་ཀྱིན་འདུག་ན་དབྱར་ཐན་མུས་ལ་ཆར་དང་ཞོད་མུས་ལ་ཐན་ཟེར།",
    "དེའི་ཉེ་འགྲམ་སོགས་ལ་འབལ་རྩྭ་མང་བོ་སྐམ་བསྲེས་བྱས་འདུག་ན་སྟོན་དུས་ཕྱི་སད་དང་དགུན་དུས་ཁ་བ་བུ་ཡུག་འཚུབས་ཆེ་ཟེར།",
    "འཁྱགས་ནས་འདུག་ན་སད་འབྱུང་ངོ།",
    "མཚམས་བརྒྱད་དུ་སྤར་ཁ་བརྒྱད་བཀོད་དེ་ལོ་ཟླ་ཞག་དུས་དང་།",
    "སུ་ཞིག་སྐྱེ་དུས་ཀྱི་ཟླ་ཞག་དུས་ཀྱི་འབྱུང་ཁམས་སོ་སོའི་གནས་ལུགས་དེ་ལ་བརྟེན་ནས་ཚེ་འདིར་ལེགས་ཉེས་ཀྱི་རྐྱེན་ཅི་དང་ཅི་ཞིག་ཡོད་པ་དང་།",
    "དེའི་ཚེ་ཕུར་བའི་བསམ་པར་ང་རང་ལས་གཞན་པའི་སྒྲ་ལ་མཁས་པ་མེད་སྙམ་ནས་ཁེངས་པ་སྐྱེས་པས།",
    "ལྔ་བརྒྱ་དུས་ཀྱི་ཐ་མར་གྱུར་ཙ་ན།",
