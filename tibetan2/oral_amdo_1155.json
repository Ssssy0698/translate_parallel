    "བ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རིག་པ་ཙམ་མོ།",
    "ཀ་ཞེས་བྱ་བ་ནི་གང་གིས་ཏེ།",
    "རང་རང་གི་ས་བོན་གྱིས་མཚན་ཞིང་ཡི་གེ་གཉིས་པོས་ངེས་པར་སྦྱར་བར་བྱའོ།",
    "མྱ་ངན་ལས་འདས་པའི་ཁྱད་པར་དུ་མི་བསམ་མོ།",
    "བྷ་ཞེས་བྱ་བ་ནི་སྲིད་པ་ཡིན་པས་ཨུ་ཞེས་བྱ་བ་དང་འདི་དག་གིས་ཉེ་བར་ཞི་བར་གྱུར་པའོ།་།",
    "ཨ་ཞེས་བྱ་བ་ནི་ཡིད་ཀྱི་དམིགས་པ་སྟེ་ཐིག་ལེ་ཙམ་མོ།",
    "མ་ཞེས་བྱ་བ་ནི་དེའི་ལྟེ་བའི་ནོར་བུའོ་། དེ་རུ་གང་ཞིག་ཏུ་གྱུར་པ་དེ་དག་གི་ཁུ་བའོ།",
    "དེ་དག་གིས་ཐིག་ལེ་ཙམ་ནི་རང་གི་རིག་པའོ་ཞེས་བྱ་བའོ།",
    "སྦྱོར་བ་འདིས་འདི་ལྟར་རྣམ་པར་བསམས་༤ན་རྣལ་འབྱོར་པས་རང་གི་འདོད་པ་རྙེད་པར་འགྱུར་ཏེ།",
    "ག་ཞེས་བྱ་བ་ནི་གང་གིས་སོ།",
    "ཁེ་ཊ་ནི་རང་གི་ས་བོན་གྱི་འོད་ཟེར་སྤྲོ་བ་འོ།",
    "བྲེ་ཀྵ་༢ནཾ་ནི་སླ་ར་ཡང་རང་གི་ས་བོན་བསྡུ་བའོ།",
    "རྔེ་འུ་ཆུང་ནི་འགྲོ་བ་འདི་དག་སྒྲ་བརྙན་ལྟ་བུར་མོས་པར་བྱ་བའོ།",
    "རེག་མིན་ནི་སྟོང་པ་ཉིད་ཀྱི་བསམ་གཏན་ནོ།",
    "ཚོང་མ་ནི་གཅིག་དང་དུ་མའི་ཆས་རང་གི་སེམས་ཡོངས་སུ་སྨིན་པའོ།",
    "འདི་རྣམས་གཅིག་ཏུ་གྱུར་པའི་དངོས་པོ་ལ་བདག་ཉིད་དེའི་བདག་ཉིད་ཡིན་ནོ་ཞེས་མོས་པར་བྱ་བ་སྟེ།",
    "ཀོལླ་ཨི་རེ་ཞེས་བྱ་བ་ནི་མགོ་བོའོ།",
    "བོ་ལ་༢མུསྨྲ་ཎི་ཞེས་བྱ་བ་ནི་ལྟེ་བར་གནས་པ་ཐིག་ལེའི་རང་བཞིན་ཅན་གཏུམ་མོ་སྤྲོ་བ་དང་།",
    "རེ་ནི་བོད་པའོ།",
    "གཟུགས་ལྷ་མོའི་ཚོགས་ལ་ཀི་ཨ་ཨི་ན་༧རོ་ལཱ་༨ནི་གཡུལ་ཏེ་ན་རོ་ལཱ།",
    "གཞན་ཡང་ཀོལླ་ཨི་རེ་ནི་སྤྱི་བོར་རང་གི་གཡས་པའི་གཡས་པ་དང་།",
    "ངག་གི་རྡོ་རྗེའི་རྒྱུན་དང་།",
    "སྟེང་གི་ཁ་དང་རྡོ་རྗེ་ཁུ་བར་བྱེད་པ་པོའི་རང་བཞིན་གྱིས་བརྐྱང་མ་གནས་པ་ནི་ཀཀྐོ་ལ་༡༧ཞེས་བརྗོད་དོ།",
    "དེ་དག་གི་ཐ་སྙད་གཅིག་ཏུ་འགྱུར་བར་བྱེད་པ་སེམས་ཀྱི་རྡོ་རྗེའི་ཚུལ་གྱིས་ཀུན་འད་ར་མ་ནི་ལག་པའོ།",
    "ཀུན་རྫོ་བ་ད་ང་དོན་དམ་པའི་རླབས་ད་ག་གིས་བཙིར་བ་ཞེས་བྱ་བ་ནི་བཙིར་བ་ད་ང་འོ་དང་འཁྱུད་པ་ལ་སོགས་པ་རྣལ་འབྱོར་པ་སྦྱོར་བ་རོ་མཉམ་པར་བྱེད་པ་ལོངས་སྤྱོད་པ་ལ་རླབས་གཉིས་ནི་བཟའ་༡༧བའོ།",
    "ཞེས་བྱ་བ་ནི་མཆོག་གི་གནས་སོ།",
    "ཡང་ན་བོ་ལའི་༡རྐོལླ་ཨི་རེ་ནོར་བུར་གནས་པ་ནི་བོ་ལ་༢སྟེ་རོ་མ་དང་གསང་བའི་རྡོ་རྗེའོ།",
    "ལ་ཀོ་ལཱ་ཨི་རེ་༢།",
    "བོ་ལཱ་ཀོ་ལཱ་ཨི་རེཾ་ཀཀྐོ་ལ་༨མུསྨྲ་ཎི་མར་ལ་མར་ཇི་ལྟ་བའོ།"
  ]
