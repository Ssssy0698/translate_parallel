    "བཅོམ་ལྡན་འདས་ཀྱིས་འདུས་བྱས་མི་རྟག་པ་ཉིད་དུ་གསུངས་པ་གང་ཡིན་པ་དེ་ནི་འདུས་བྱས་ཀྱི་མཚན་ཉིད་ངེས་པ་ཡིན་ན།",
    "དེ་ཁོ་ན་བཞིན་དུ་གནས་པ་ནི་སྐད་ཅིག་མ་དང་པོ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་མཐར་ཡང་འཇིག་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་དེ་ཉིད་འདི་ཡིན་ནོ་ཞེས་བྱ་བར་ནི་ངེས་པར་མི་བཟུང་ངོ།",
    "མིག་ལ་སོགས་པའི་འདུ་བྱེད་། རྣམས་ནི་དེས་སེམས་དང་ལྷན་ཅིག་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རྗེས་སུ་ཟིན་པར་འཇུག་པའི་སྒོ་ནས་རྟེན་དང་བཅས་པར་ཟིན་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པའི་རྐྱེན་གྱིས་མིང་དང་གཟུགས་ཞེས་ཀྱང་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དེའི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་སྐད་ཅིག་མའི་འབྲས་བུ་སྐད་ཅིག་མ་མ་ཡིན་པར་ནི་མི་རུང་ངོ།",
    "དེ་བཞིན་དམན་དང་ཁྱད་པར་འཕགས།",
    "རྒྱུ་དང་ཚད་ཀྱི་ཁྱད་པར་དང་།",
    "དེ་བཞིན་དམན་དང་ཁྱད་པར་འཕགས།",
    "འདུས་བྱས་ཐམས་ཅད་སྐད་ཅིག་མ།",
    "རྒྱས་པས་ནི་ཟས་དང་ཉལ་བ་དང་ཚངས་པར་སྤྱོད་པ་དང་སྙོམས་པར་འཇུག་པས་རྒྱས་པ་གང་ཡིན་པའོ།",
    "འགྱུར་བ་ནི་འདོད་ཆགས་ལ་སོགས་པས་ཁ་དོག་ལ་སོགས་པ་རྣམ་པར་འགྱུར་བའི་སྒོ་ནས་གང་ཡིན་པའོ།",
    "ཡོངས་སུ་སྨིན་པར་ནི་མངལ་ན་གནས་པ་དང་བྱིས་པ་དང་།",
    "རྒན་པོའི་གནས་སྐབས་དག་ན་གང་ཡིན་པའོ་། དམན་པ་ཉིད་དང་ཁྱད་པར་དུ་འཕགས་པ་ཉིད་དུ་ནི་ངན་འགྲོ་དང་བདེ་འགྲོར་སྐྱེ་བ་རྣམས་ཀྱི་གང་ཡིན་པ་སྟེ་གོ་རིམས་བཞིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་རྒྱུས་སྐད་ཅིག་མ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "གལ་ཏེ་དེ་རྒྱུ་ཉིད་ཀྱི་ཁྱད་པར་དུ་མ་གྱུར་ན།",
    "དེས་ན་རྒྱུ་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱི་འཇུག་པའི་ཁྱད་པར་ཕྱི་མ་ཕྱི་མ་དམིགས་པར་འགྱུར་རོ།",
    "ཁྱད་པར་ཡོད་ན་ནི་ཕྱི་མ་ཕྱི་མ་དག་ལས་དེ་གཞན་ཡིན་པའི་ཕྱིར་སྐད་ཅིག་མ་ཉིད་དུ་གྲུབ་པོ།",
    "རྒྱས་པར་སྐྱེ་བ་ལ་ནི་སྐྱེ་བ་དོན་མེད་པའི་ཕྱིར་ཏེ།",
    "སྐད་ཅིག་མ་ཉིད་མེད་ན་དེ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "རྟེན་གནས་བཞིན་དུ་དེ་ལ་བརྟེན་པ་མི་གནས་པར་མི་རུང་བ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་རྟེན་ཉིད་དུ་མི་སྲིད་པར་འགྱུར་རོ།",
    "འགྱུར་པར་སྐྱེ་བ་དང་ཡོངས་སུ་སྨིན་པར་སྐྱེ་བ་ལ་ནི།",
    "འགྱུར་བ་དང་ཡོངས་སུ་སྨིན་པར་སྐྱེ་བ་ལ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་དམན་པ་དང་།",
    "ཁྱད་པར་ཅན་དུ་སྐྱེ་བ་ལ་ཡང་སྐད་ཅིག་མ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "ཡུལ་གཞན་དུ་བར་ཆད་མེད་པར་སྐྱེ་བའི་མཚན་ཉིད་ཀྱི་འགྲོ་བ་ནི་རྒྱུ་དུ་མས་རིག་པར་བྱ་སྟེ།",
    "སྐད་ཅིག་མ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "གཟུགས་བརྙན་དུ་སྐྱེ་བ་ལ་ནི་སེམས་ཀྱི་རྗེས་སུ་འཇུག་པའི་ཕྱིར་སྐད་ཅིག་མ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ཡང་སྐད་ཅིག་མ་ཡིན་པར་རིག་པར་བྱའོ།",
    "གནོད་པས་བྱས་པ་ནི་བསྣུན་པ་ལ་སོགས་པས་སོ།",
    "དུས་ཀྱིས་བྱས་པ་ནི་དུས་གཞན་གྱི་བར་དུ་ཡོངས་སུ་གནས་པས་སོ།",
    "དེ་ཁོ་ན་བཞིན་དུ་སྐད་ཅིག་མ་ཉིད་དུ་རིག་པར་བྱའོ།",
    "སྐད་ཅིག་མ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "ཇི་ལྟར་བྱས་པས་ཤེ་ན།",
    "དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "མར་མེ་ལ་སོགས་པ་སྐད་ཅིག་མར་རབ་ཏུ་གྲུ་པའི་དངོས་པོ་དག་ལ་ཡང་མི་གཡོ་བའི་གནས་སྐབས་ན་དེ་མི་འཛིན་པའི་ཕྱིར་སྐད་ཅིག་མ་ཉིད་མ་ཡིན་པར་ཅིའི་ཕྱིར་མི་འདོད།",
    "དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "མར་མེ་ལ་སོགས་པ་ནི་སྐད་ཅིག་མ་ཉིད་ཀྱི་རྗེས་སུ་འཇུག་པར་རབ་ཏུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "མིག་ལ་སོགས་པ་གནས་ལ་དེ་དག་ལ་བརྟེན་པའི་རྣམ་པར་ཤེས་པ་རྒྱུན་གྱིས་འགྲོའོ་ཞེས་བྱ་བར་ནི་མི་རུང་ངོ།",
    "དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་མི་རྟག་པ་ལ་རྟག་པར་ཕྱིན་ཅི་ལོག་པར་ཡང་མི་འགྱུར་རོ།",
    "གང་ཟག་ལ་བདག་མེད་པ་རབ་ཏུ་བསྒྲུབ་པའི་ཕྱིར་བདག་མེད་པ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་བཅུ་གཉིས་ཏེ།",
    "གང་ཟག་བཏགས་པར་ཡོད་ཉིད་དུ།",
    "དགོས་པ་མེད་པར་མི་རིགས་སོ།",
    "ཅི་གང་ཟག་ཡོད་པ་ཞེས་བརྗོད་པར་བྱ་བའམ་མེད་པ་ཞེས་བརྗོད་པར་བྱ་ཞེ་ན།",
    "ཡང་དེ་རྫས་སུ་མེད་དོ་ཞེས་བྱ་བ་ཇི་ལྟར་རིག་པར་བྱ་ཞེ་ན།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་མེད་པ་ལ་བདག་གོ་སྙམ་དུ་ཕྱིན་ཅི་ལོག་གོ་ཞེས་གསུངས་སོ།",
    "ཡང་གཟུགས་ལ་སོགས་པ་ཞེས་བྱ་བའི་གཞི་གང་ལ་གང་ཟག་ཅེས་འདོགས་པ་གང་ཡིན་པ་དེ་དང་ཅི་གང་ཟག་གཅིག་པ་ཉིད་དུ་འོན་ཏེ་གཞན་པ་ཉིད་དུ་བརྗོད་པར་བྱ་ཞེ་ན།",
    "དེ་ལྟར་ན་གང་ཟག་བཏགས་པར་ཡོད་པའི་ཕྱིར།",
    "བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དུ་རིགས་ཏེ།",
    "འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དགོས་པ་མེད་པར་མི་རིགས་སོ།",
    "འོན་ཏེ་དཔེ་ཙམ་གྱིས་གང་ཟག་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དུ་འདོད་དེ།",
    "དེ་དག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
