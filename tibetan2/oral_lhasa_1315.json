    "རྟག་ཏུ་ལྷུན་གྱིས་གྲུབ་པར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱིས་གནས་པའི་ཕྱིར་རོ།",
    "གདོན་མི་ཟ་བར་བྱ་དགོས་པ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་རྩ་བ་དྲུག་སྟེ་མཆོད་བསླབ་ཡང་དག་བླང་བ་དང་།",
    "རྟག་ཏུ་བྱ་བ་རྣམ་པར་བྱེ་དཔའི་ཚིགས་སུ་བཅད་པ་གཉིས་ཏེ།",
    "མཚན་མ་རྣམ་པར་མི་རྟོག་པ།",
    "གཙོ་བོའི་དངོས་པོ་རྣམས་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་རྩ་བ་དྲུག་པ་སྟེ།",
    "རིགས་པ་བཞིར་ནི་ཤེས་པར་བྱ།",
    "རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་དང་།",
    "ལོགས་པར་སྒྲུབ་པའི་དེ་བཞིན་ཉིད་དང་།",
    "རྣམ་པར་དག་པའི་དེ་བཞིན་ཉིད་དང་།",
    "ཡང་དག་པའི་སྒྲུབ་པའི་དེ་བཞིན་ཉིད་ལ་བརྟེན་ནས་བདེན་པ་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "རིགས་། པ་གདགས་པ་རྣམ་པར་གཞག་པར་ནི་རྣམ་པར་བཞི་སྟེ།",
    "ཡང་དང་པར་འགྲུབ་པ་དང་།",
    "རྣམ་པར་ལྔའི་སྒོ་ནས་རིག་པར་བྱ་སྟེ།",
    "ཡོངས་སུ་ཚོལ་བའི་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ།",
    "དེ་གཉིས་འབྲེལ་པ་ལ་ངོ་བོ་ཉིད་དང་ཁྱད་པར་འདོགས་པ་དང་གདས་པ་ཙམ་དུ་ཡོངས་སུ་ཚོལ་བ་ནི།",
    "ངོ་བོ་ཉིད་དང་ཁྱད་པར་འདོགས་པ་ཡོངས་སུ་ཆོལ་བྱིན་པར་རིག་པར་བྱའོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ཡོངས་སུ་ཤེས་པ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་བརྒྱད་དེ།",
    "དོན་ཀུན་གྲུབ་པར་བྱེད་པར་འགྱུར།",
    "ངོ་བོ་ཉིད་དང་ཁྱད་པར་དུ་འདོགས་པ་ཡོངས་སུ་ཚོལ་བ་དང་ལྡན་པའོ།",
    "དེ་ཡང་མིང་ལ་སོགས་པ་འདི་དག་ཐམས་ཅད་མི་དམིགས་པ་ལས་རིག་པར་བྱ་སྟེ།",
    "ཕྱེད་འོག་མས་ནི་ཡང་དག་པར་ཇི་ལྟ་བ་བཞིན་ཡོངས་སུ་ཤེས་པ་ནི་ཆེ་བའི་བདག་ཉིད་དང་ལས་ཀྱིས་སྟོན་ཏོ།",
    "རྟེན་ནི་མིག་ལ་སོག་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལྟར་མི་རྟོག་པ་རིམ་པ་དེ་ལྟ་བུས་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་རྣམ་པར་འཇིག་པ་ནི་འབྲལ་བ་སྟེ།",
    "དེའི་ཐབས་ནི་མཚན་མའི་གཉེན་པོ་རྣམ་པར་མི་རྟོག་པའོ།",
    "བློ་ལྡན་དེ་ཟད་བྱེད་པར་འདོད།",
    "གཉིས་སུ་འཛིན་པ་རྣམ་པར་སྤངས་པ་ཉིད་ཀྱིས་ཀུན་བརྟགས་པ་དང་།",
    "དེ་ཟད་པར་བྱེད་པ་ནི་དེ་ཟད་པའི་ཆེད་དུའོ།",
    "རྣམ་པར་ཐ་དད་མེད་བསྒོམས་ཤིང་།",
    "དོན་ཡོད་པ་དེ་བཞིན་ཉིད་སྣང་བ་ཉིད་ནི་གནས་གཞན་དི་གྱུར་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ཡོངས་ཤེས་བྱས་ནས་དེ་སྤངས་ངོ།",
    "དེ་ལྟ་བས་ན་བར་ཆད་བྱེད་པར་ཡོངས་སུ་ཤེས་པར་བྱས་ནས་དེ་ལྟར་སྣགས་བ་དེ་སྤང་བར་བྱའོ།",
    "དཔག་ཏུ་མེད་པ་རྣམ་པར་དབྱེ་བའི་། ཚིགས་སུ་བཅད་པ།",
    "ཡོངས་སྨིན་རྣམ་པར་སྦྱང་བྱ་དང་།",
    "ཐོབ་བྱ་སྨིན་པར་རུང་བྱ་དང་།",
    "རྣམ་པར་སྦྱང་བར་བྱ་བ་ནི་སྣོད་ཀྱི་འཇིག་རྟེན་གྱིས་བསྡུས་པའི་འཇིག་རྟེན་གྱི་ཁམས་སོ།",
    "ཡོངས་སུ་སྨིན་པར་རུང་བར་བྱ་བ་ནི་གདུལ་བའི་ཁམས་སོ།",
    "དོན་བྱེ་བྲག་ཏུ་མི་ཤེས་པ་རྣམས་ཀྱང་བྱེ་བྲག་ཏུ་ཤེས་པར་འགྱུར་རོ།",
    "ཐེ་ཚོམ་ཟ་བ་རྣམས་ཀྱི་ཐེ་ཚོམ་ཡང་གཅོད་པར་འགྱུར་རོ།",
    "ཐབས་ལ་མཁས་པར་གྱུར་པ་དང་།",
    "བསྐལ་པ་གྲངས་མེད་པ་གསུམ་དུ་རྟག་ཏུ་གུས་པར་བྱས་ཏེ་སྦྱོར་བའི་ཕྱིར་རོ།",
    "ཡང་དག་པར་འགྲུབ་པ་ཆེན་པོ་ཉིད་ནི།",
    "མྱ་ངན་ལས་འདས་པ་ཆེན་པོ་སྟོན་པ་ཡང་དེ་ཉིད་ལ་རིག་པར་བྱའོ།",
    "མཚན་མ་མེད་པར་སྤྱོད་པ་ནིས་ས་བདུན་པ་ལའོ།",
    "འདོད་ལ་མ་ཆགས་ལས་གསུམ་རྣམ་པར་དག།",
    "དྲན་གཙོ་ཤིན་ཏུ་མཉམ་པར་གཞག་པའི་བདག།",
    "དེ་ལ་དྲན་པ་གཙོ་བོ་ནི་བསམ་གཏན་དང་ལྡན་པ་དྲན་པའི་སྟོབས་ཀྱིས་སེམས་མཉམ་པར་འཛེག་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སོ།",
    "དེ་ལ་སྡུག་བསྔལ་ལས་རྣམ་པར་གྲོལ་བ་ནི།",
    "ཁ་ན་མ་ཐོ་བ་ཕྲ་ར་བ་ཙ་མ་དག་ལ་ཡང་འཇིགས་པར་ལྟ་བས་སོ།",
    "མཚུངས་པར་སྟོན་དང་འབྲས་བུ་ཆེན་པོ་ཡིས།",
    "ཐབས་རྣམས་རྟོགས་པར་འགྱུར་བའི་ཁྱད་པར་རྒྱུ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཀུན་ཏུ་སྟོན་པ་ན་ཡང་མི་ཟད་པར་རྟོགས་པ་དང་།",
    "ཡང་དག་མིན་རྟོག་ཡིན་པར་རྟོགས་པའི་རྒྱུ།",
    "འདིར་ཡང་སེམས་དང་ཡིད་རྣམ་པར་ཤེས་པ་རྟོགས་པ་དང་།",
    "དེ་རྣམས་ཀྱང་ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པ་ཉིད་དུ་རྟོགས་པའི་སྒོ་ནས་རྟོགས་པའི་ཁྱད་པར་རྣམ་པ་བཞི་སྟོན་ཏེ།",
    "དེ་ལ་སེམས་ནི་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པའོ།",
    "ཡིད་ནི་དེ་ལ་དམིགས་པ་བདག་ཏུ་ལྟ་བ་ལ་སོགས་པ་དང་མཚུངས་པར་ལྡན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་གོ།",
    "ཀུན་བརྟག་པ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་གསུམ་རྟོག་པའི་སྒོ་ནས་རྟོགས་པའི་ཁྱད་པར་རྣམ་པ་ལྔ་སྟོན་ཏེ།",
    "དེ་ལ་མ་རྟོགས་པ་ཉིད་དུ་རྟོགས་པ་སོ་སོར་རྟོགས་པས་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་རིག་པར་བྱའོ།",
    "འདིར་ནི་རྟོགས་པའི་ཁྱད་པར་རྣམ་པ་ལྔ་སྟོན་ཏེ།",
    "རྟོགས་པ་འཁོར་གསུམ་ཡོངས་སུ་དག་པར་རྟོགས་པའི་ཕྱིར་རོ།",
