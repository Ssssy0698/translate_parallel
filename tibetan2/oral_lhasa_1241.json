    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་གང་གཟུགས་ལ་སོགས་པ་སྣང་བ་དེ་ཕྱི་རོལ་ན་ཡོད་པ་མ་ཡིན་ཏེ་རྣམ་པར་ཤེས་པ་ལས་ཐ་དད་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "སེམས་ནི་སྣ་ཚོགས་ཉིང་སྣང་ཞེས་བྱ་བ་ནི་སེམས་ཉིད་རྣམ་པ་སྣ་ཚོགས་པར་སྣང་བའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལུས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལོངས་སྤྱད་པར་བྱ་བ་ཡིན་པས་སོ།",
    "གནས་རྣམས་སེམས་གང་ལ་སྣང་བ་དེ་ལ་དེ་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་དགོངས་པ་ནི་འདི་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཟུགས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཟུགས་སྤངས་པའི་རྣམ་པར་ཤེས་པ་ཙམ་རྫས་སུ་ཡོད་པར་སྟོན་པའི་དོན་དུ་ནི་མ་ཡིན་ནོ་ དེ་ཉིད་ཀྱི་ཕྱིར།",
    "དྲང་དོན་ཉིད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཟུགས་ཁྱད་པར་ཅན་གྱིས་མཐོ་བ་ཉིད་དུ་སེམས་པ་ནི་ང་རྒྱལ་ལོ།",
    "དེ་དག་ལས་ཉམས་པར་འགྱུར་བའོ།",
    "དེ་ལ་དཔེ་སྟོན་པ་ནི་ཕྱི་རོལ་གྱི་ཡུལ་ལ་ཆགས་པ་འཇོམས་པའི་ཀེང་རུས་ལྟར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ལུང་དྲང་བའི་དོན་ཡིན་པའི་ཤེས་བྱེད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཡང་ལུང་འདི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དགོངས་པ་ངེས་པར་འགྲེལ་པ་ལ་སོགས་པའོ།",
    "བརྟགས་པ་མེད་པ་ཉིད་དང་ཞེས་བྱ་བ་ནི་གཉིས་སུ་མེད་པའི་ཤེས་པ་ལ་གཟུང་བ་དང་འཛིན་པར་ཡོངས་སུ་བརྟགས་པ་སྟེ་མེད་པའོ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལེན་པའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ནི་འདིས་བག་ཆགས་ཐམས་ཅད་ལེན་པའི་ཕྱིར་ལེན་པའི་རྣམ་པར་ཤེས་པའོ།",
    "ཟབ་ཅིང་ཞེས་བྱ་བ་ནི་བྱིས་པ་རྣམས་ཀྱིས་རྟོགས་པར་དཀའ་བས་སོ།",
    "ཕྲ་ཞེས་བྱ་བ་ནི་ཉན་ཐོས་རྣམས་ཀྱིས་རྟོགས་པར་དཀའ་བས་སོ།",
    "ཅེས་བྱ་བ་ནི་ཅི་ལྟར་ཆུ་བོ་ཆེར་སྐྱེས་པའི་ཚེ་ཆུ་བོས་ཤིང་ལ་སོགས་པ་མང་པོ་ཁྱེར་བ་དེ་བཞིན་དུ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཡང་བག་ཆགས་མང་པོ་སོག་པས་སོ།",
    "ཅིའི་ཕྱིར་ཉན་ཐོས་ལ་སོགས་པ་ལ་མ་གསུངས་ཤེ་ན།",
    "བདག་དུ་རྟོག་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་དེ་རྣམས་ལ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་བསྟན་པར་གྱུར་ན་དེའི་ཚེ་བྱེད་པ་པོ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པའི་བདག་ཏུ་ཡོངས་སུ་རྟོག་པར་འགྱུར་རོ་སྙམ་ནས་མ་གསུངས་སོ།",
    "འདི་ཞེས་བྱ་བ་ནི་སེམས་ཙམ་སྟོན་པར་བྱེད་པའི་ལུང་གཉིས་སོ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་སེམས་ཙམ་གསུངས་པ་དེ་ཡང་དྲང་བའི་དོན་དུ་གསུངས་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེའི་མཚན་ཉིད་ཅན་གྱི་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེས་སོ།",
    "ཐོག་མ་ནས་རྣམ་པར་དག་པ་ཉིད་ཅེས་བྱ་བ་ནི་ནམ་མཁའ་བཞིན་དུ་གདོད་མ་ནས་དྲི་མ་མེད་པས་སོ།",
    "དེ་ཉིད་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དཔེ་དོན་དང་སྦྱར་བར་བྱ་བའི་ཕྱིར་ཕུང་པོ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དྲི་མ་ཉིད་སྟོན་པ་ནི་འདོད་ཆགས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བློ་གྲོས་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རོ་ མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་བ་ནི་འདིར་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བས་མྱ་ངན་ལས་འདས་པ་ནི་སྟོང་པ་ཉིད་ཁོ་ན་ལ་བྱའོ།",
    "བདག་མེད་པས་འཇིགས་པར་འགྱུར་བའི་གནས་རྣམས་སྤང་བའི་དོན་དུ་ཞེས་བྱ་བ་ནི་བདག་མེད་པ་གཉིས་ཁོ་ན་བདག་ཆད་པར་དོགས་པས་འཇིགས་པའི་གནས་ཡིན་ལ་དེ་སྤང་བའི་དོན་དུ་སྟེ་ཅིག་ཅར་སྟོང་པ་ཉིད་བསྟན་ནས་སྐྲག་པར་འགྱུར་བས་སོ།",
    "རྣམ་པར་མི་རྟོག་པའི་གནས་ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ལོ།",
    "འདིའི་དོན་ནི་གལ་ཏེ་དང་པོ་ཉིད་དུ་སྟོང་པ་ཉིད་ལ་སོགས་པའི་སྒྲ་དོན་སྟོང་པ་ཉིད་ལ་སོགས་པའི་སྒྲས་བརྗོད་པར་འགྱུར་ན།",
    "དེ་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བློ་གྲོས་ཆེན་པོ་དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་རྟོག་པའི་མཚན་ཉིད་རྣམ་པར་ལོག་པ་ཞེས་བྱ་བ་ལ།",
    "རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལོག་པ་ཡིན་ཏེ།",
    "སྟོང་པ་ཉིད་རྣམ་པར་རྟོག་པའི་ཡུལ་མ་ཡིན་པ་དང་།",
    "མཚན་ཉིད་ཐམས་ཅད་རྣམ་པར་ལོག་པ་ཡིན་ཏེ།",
    "སྨོན་པ་མེད་པའི་རང་བཞིན་ཅན་གྱི་རྣམ་པར་དག་པ་གསུམ་གྱི་སྤྱོད་ཡུལ་ལ་བསམ་པ་གཏད་པའོ།",
    "ཡང་དེ་ཉིད་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དྲང་བའི་དོན་ཉིད་ཡིན་པ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་སྟོན་པ་མ་ཡིན་པར་རོ།",
    "རིགས་པའི་སྒོ་ནས་དྲང་བའི་དོན་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རིགས་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་སེམས་ཙམ་དུ་གསུངས་པ་དེ་དོན་དམ་པར་ཡོད་པ་ཉིད་སྒྲུབ་པའི་དོན་དུ་མ་ཡིན་གྱི།",
    "ཅེས་ཤེས་པ་མེད་པ་བདེ་བླག་ཏུ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་དོན་དུ་ཡིན་ནོ་ཞེས་པའོ།",
