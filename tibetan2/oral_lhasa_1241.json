    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མ་གྲུབ་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་ནི་རྫས་སྒྲུབ་པར་བྱེད་པའི་ཕྱོགས་ལའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མ་གྲུབ་པའི་དྲན་པས་མ་གྲུབ་པའི་རང་རིག་སྒྲུབ་པར་འགྱུར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གལ་ཏེ་འདིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་མ་ངེས་པ་ཉིད་དུ་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་ནོར་བུ་ཆུ་ཤེལ་དང་ནོར་བུ་མེ་ཤེལ་དག་གོ།",
    "དེ་མེད་པར་མེད་པས་ཞེས་བྱ་བ་ནི་རང་རིག་མེད་པར་དེའི་རྒྱུ་ཅན་དྲན་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ད་ནི་རང་རིག་ཁས་བླངས་ཀྱང་དྲན་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་སྟེ་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་རྣམ་པར་དཔྱོད་པ་བཏང་ནས་ཀྱང་།",
    "གཞན་ཕྱིར་མ་ཤེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་ཤེས་པའི་རྒྱུད་ཡིན་པས་ན་ཤེས་པའི་རྒྱུད་དེ་བྱམས་པའི་ཤེས་པའི་རྒྱུད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བྱམས་པ་དང་ཉེར་སྦས་ཀྱི་ཤེས་པ་དག་ནི་རྒྱུད་གཅིག་ཏུ་གཏོགས་པ་དང་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་གཞན་ཡིན་པ་ཙམ་གྱི་སྒོ་ནས་དྲན་པ་མེད་པར་ཅི་ལྟར་སྒྲུབ་ཅེ་ན།",
    "གཏན་ཚིགས་འདིས་ནི་ཁྱད་པར་དག་ཀྱང་འཇོམས།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོའི་མཚན་ཉིད་ཅན་གྱི་ཁྱད་པར་དག་འཇོམས་པར་བྱེད་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
