    "དེ་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྟན་པ་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་པའི་བློ་གྲོས་ཅན་རྣམས་ཀྱི་འབྲས་བུ་བསྟན་པའི་སྒོ་ནས་དོན་དམ་པའི་བདེན་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇིག་རྟེན་ཕན་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཚན་མས་སྟོང་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཀུན་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པའི་རྣམ་པའི་དབྱེ་བ་བསྟན་ནས་ཀུན་རྫོབ་ཀྱི་བདེན་པ་བསྟན་པ་ནི་ཐབས་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདིར་ཐ་སྙད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་དོན་དམ་པར་བརྗོད་དུ་མེད་པ་ཡིན་དུ་ཟིན་ཀྱང་ངོ་བོ་ཉིད་ཀྱིས་དབེན་པའི་སྟོང་པ་ཉིད་ལ་བློས་སྒྲོ་བཏགས་ནས་ཉན་པ་དང་སྟོན་པར་མཛད་པའོ།",
    "ཐ་སྙད་ལ་ནི་མ་བརྟེན་པར།",
    "རྗོད་པར་བྱེད་པ་དང་།",
    "བརྗོད་པར་བྱ་བའི་མཚན་ཉིད་ཅན་གྱི་སྤྲོས་པ་རྣམས་ཁས་མ་བླངས་ན་དོན་དམ་པའི་བདེན་པ་སྟོན་པར་མི་ནུས་པས།",
    "མ་བསྟན་ན་ནི་ཁོང་དུ་ཆུད་པར་མི་ནུས་ལ།",
    "དེས་ན་མྱ་ངན་ལས་འདས་པ་ཐོབ་པའི་ཐབས་ཡིན་པར་ངེས་པས་ཅི་ལྟ་བ་བཞིན་དུ་གནས་པའི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཁས་བླང་པར་བྱ་དགོས་ཏེ།",
    "དེ་ལ་དོན་དམ་པའི་བདེན་པ་ནི་ཐབས་ལས་བྱུང་བར་གྱུར་ཅིང་ཞེས་བྱ་བ་ནི་དོན་དམ་པའི་བདེན་པ་ནི་ཐོབ་པར་བྱ་བ་ཅན་ཡིན་པས་ཐབས་ལས་བྱུང་བ་ཡིན་ལ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་གྱི་ཕྱོགས་སུན་འབྱིན་པ་ཙམ་ལ་མཁས་པར་ཞེས་བྱ་བ་ནི་སེམས་ཙམ་དུ་སྨྲ་བའི་ཕྱོགས་སུན་འབྱིན་པ་ཙམ་ལ་མཁས་པར་འགྱུར་བའོ།",
    "འཐད་པས་མི་རིགས་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ཅོ་འདྲི་བའི་སྒོ་ནས་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུག་དང་བཅས་པའི་ཟས་བྱིན་ནས་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འབྲས་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྟན་པའི་ཀུན་རྫོབ་ཀྱི་སྒོ་ནས་ཤེས་པ་དང་ཤེས་བྱ་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་གྱི་སྤྲོས་པ་ཐམས་ཅད་བཟློག་པར་འགྱུར་བས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་བསྟན་པ་ལ་ཁུངས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇིག་རྟེན་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གལ་ཏེ་འཇིག་རྟེན་ན་ཀུན་རྫོབ་ཡོད་པར་མ་གྱུར་ན་དེའི་ཚེ་ངས་ཀྱང་ཁས་ལེན་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞིར་ཞུགས་པ་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པར་ཞུགས་པའོ།",
    "འདིའི་དོན་ནི་གལ་ཏེ་དགྲ་བཅོམ་པ་བཞིན་དུ་འཇིག་རྟེན་པ་རྣམས་ལ་ཡང་ཕུང་པོ་སྣང་བ་མེད་པར་གྱུར་ན་དེའི་ཚེ་འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་ཀྱང་ཁོ་བོས་ཀུན་རྫོབ་ཁས་བླང་བར་མི་བྱའོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དགྲ་བཅོམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་ཐམས་ཅད་དུ་ཀུན་རྫོབ་ཡོད་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྷག་མ་མེད་པར་མྱ་ངན་ལས་འདས་པ་རྣམས་ལ་ཕུང་པོ་རྣམས་རྒྱུན་ཆད་པས་སོ།",
    "གཞན་ལ་ལྟོས་ནས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདིའི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གནོད་པ་ཡོད་པས་འཇིག་རྟེན་རྒྱལ་བར་གྱུར་ན་འཇིག་རྟེན་ཁོ་ན་ལ་བརྟེན་པར་བྱའོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁོ་བོ་ཅག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ལྡོག་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གང་འཇིག་རྟེན་ལ་ལྟོས་པའི་ཤེས་པ་དང་ཤེས་བྱ་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་གྱི་སྤྲོས་པ་ཡིན་ལ།",
    "དེ་བཟློག་པར་བྱ་བའི་ཆེད་དུ་སྟེ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་དངོས་པོར་སྨྲ་བའི་ཆུའི་རྣམ་པར་ཡོངས་སུ་གྱུར་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་དངོས་པོར་ཡོད་དོ་ཞེས་སྨྲ་བ་གང་ཡིན་པ་དེ་ཉིད་ཆུའི་རྣམ་པ་ཅན་དུ་ཡོངས་སུ་འགྱུར་བར་འཁྲུལ་པ་ཡིན་ལ།",
    "དཔེར་ན་འགའ་ཞིག་བེ་ཌཱུརྱས་ས་གཞི་བསྟར་བ་ལ་ཆུ་བཅུ་བའི་དོན་དུ་བུམ་པ་སོ་མ་བཏང་བ་སྨྱུགས་པར་བྱེད་པ་དེ་བཞིན་དུའོ།",
    "དུམ་བུ་རྣམ་པར་བརྒྱར་ཀློག་པ་ན་ཞེས་བྱ་བ་ནི་ས་གཞི་བསྟར་བ་མཁྲེགས་པ་ཡིན་པས་དེ་བུམ་པ་སོ་མ་བཏང་ཡང་སྨྱུགས་པར་བྱེད་ན་དུམ་བུ་བརྒྱར་འགྱུར་བ་སྲིད་པ་ཡིན་ལ།",
    "རྟག་བདག་བྱེད་པ་པོ་བཀག་པར་རྟོགས་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིའི་དོན་ནི་ཁམས་གསུམ་པ་ནི་སེམས་ཙམ་སྟེ་ཞེས་གསུངས་པ་དེ་ཕྱི་རོལ་གྱི་དོན་འགེགས་པ་པ་ལ་གཞོལ་བ་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་བདག་ལ་སོགས་པ་རྣམས་བྱེད་པ་པོ་ཡིན་པར་བཀག་ནས་སེམས་ཁོ་ན་བྱེད་པ་པོར་བསྟན་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "སེམས་ཁོ་ན་བྱེད་པ་པོ་ཉིད་དུ་བསྟན་པར་ཅི་ལྟར་ཤེས་ཤེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལུགས་སུ་བྱུང་བའི་རྣམ་པར་ཞེས་བྱ་བ་ནི་མ་རིག་པའི་རྐྱེན་གྱིས་འདུ་བྱེད་ཡིན་ལ་འདུ་བྱེད་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚུལ་གྱིས་སོ།",
    "འགའ་ཞིག་ཡོད་པར་གྱུར་ན་དེའི་ཚེ་དེ་ལ་ལྟོས་ནས་བྱ་བ་འཇུག་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "གང་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འཇོམས་པར་བྱེད་པ་སྟེ།",
    "གང་ལས་གསུངས་ཤེ་ན།",
    "གཙོ་བོ་ཞེས་བྱ་བ་ནི་ཕྱིས་འཆད་པར་འགྱུར་བའི་རང་བཞིན་ནོ།",
    "དེ་ལ་གང་ཟག་དང་གཙོ་བོ་དག་ནི་ཕྱིས་འགེགས་པར་འགྱུར་རོ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་ནི་རྣམ་པར་ཤེས་པ་མེད་ན་མི་སྣང་བའི་ཕྱིར་སེམས་ཀྱི་བདག་ཉིད་ཅན་ཁོ་ནའོ།",
    "གཞན་དུ་ན་བདག་ལས་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་སེམས་ཀྱང་མ་གྲུབ་པས་དེ་སྐད་དུ་ཇི་ལྟར་བརྗོད་པར་བྱ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་ཞེས་བྱ་བ་ནི་བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་དང་མུ་སྟེགས་པ་རྣམས་མཚུངས་པའི་ཕྱིར་དེ་དག་ཀྱང་མུ་སྟེགས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དོན་ཕྱིན་ཅི་མ་ལོག་པར་ཁོང་དུ་མ་ཆུད་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་འཇིག་རྟེན་པ་ཉིད་དུ་ཁས་ལེན་པ་འུག་ཕྲུག་པས་ཀྱང་རྡུལ་ཕྲ་རབ་གཅིག་དང་གཉིས་ལ་སོགས་པའི་རིམ་པས་བྱས་པའི་བུམ་པ་ལ་སོགས་པ་རྣམས་ལ་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་ཁས་ལེན་པའོ།",
    "དེ་ཐོབ་པར་བྱེད་པའི་ཐབས་ཡིན་པས་ན་བསྟན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "འདི་ནི་རྟོག་པ་རྣམས་ཀྱང་སྲིད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ལ།",
    "ད་ནི་རྟོག་པ་འདི་རྣམས་ད་ལྟ་ཡང་ཡོད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ད་ལྟ་ཉིད་དུ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་བྱས་ཟིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དགོས་པ་བསྒྲུབ་ཟིན་པས་སོ།",
    "ཙམ་གྱི་སྒྲས་ཞེས་བྱ་བ་ནི་སེམས་ཙམ་པ་འཇིག་རྟེན་བྱེད་པ་པོར་གསུངས་ཞེས་བྱ་བ་འདིར་ཙམ་གྱི་སྒྲ་གང་སྨོས་པ་དེས་སོ།",
    "ཤེས་བྱ་འགོག་པར་མི་ནུས་པར་བརྗོད་ནས་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོ་གཞན་བཀག་པའི་དགོས་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཕྱི་རོལ་འགོག་པར་མི་སྲིད་པར་བསྟན་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཙམ་གྱི་སྒྲས་སེམས་གཙོ་བོ་ཉིད་དུ་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་རྟོགས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "པ་འགོག་པ་མ་ཡིན་པའི་རྣམ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སེམས་ཙམ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདིའི་དོན་ནི་གལ་ཏེ་དོན་དམ་པར་འགྱུར་ན་དེའི་ཚེ་རང་བཞིན་གཞན་ལ་ལྟོས་པ་མེད་པའི་ཕྱིར་གཏི་མུག་དང་ལས་ལ་ལྟོས་པར་མི་འགྱུར་བ་ཡིན་པ་ལས་ལྟོས་པ་ཉིད་ཀྱང་ཡིན་པས་དེས་ན་རྣམ་པར་ཤེས་པ་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་གྲུབ་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཕགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་རྣམ་པས་སོ།",
    "མ་རིག་པས་བྱས་པའི་ཞེས་བྱ་བ་ནི་མ་རིག་པ་ལས་བྱུང་བའོ།",
    "མིང་དང་གཟུགས་རྣམ་པར་འཕེལ་བ་ནི་སྐྱེ་མཆེད་དྲུག་གོ་ཞེས་བྱ་བ་ནི་གཟུགས་མེད་པའི་ཕུང་པོ་རྣམས་འཕེལ་བ་ལས་ཡིད་ཀྱི་སྐྱེ་མཆེད་ཡིན་ལ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་རྣམ་པར་འཕེལ་བ་ལས་མིག་ལ་སོགས་པའི་སྐྱེ་མཆེད་ལྔའོ།",
    "སྲེད་པ་རྣམ་པར་འཕེལ་བ་ནི་ལེན་པའོ་ཞེས་བྱ་བ་ནི་སྲེད་པ་དེ་རབ་ཏུ་སོན་པ་ནི་ལེན་པའོ།",
    "ཕུང་པོ་ཡོངས་སུ་སྨིན་པ་ནི་ཞེས་བྱ་བ་ནི་གོང་ནས་གོང་དུ་སྐད་ཅིག་མ་ཁྱད་པར་ཅན་སྐྱེ་བས་རྙིངས་པར་འགྱུར་བའོ།",
    "རྒས་པའི་ཕུང་པོ་འཇིག་པ་ནི་ཞེས་བྱ་བ་ནི་ཕུང་པོ་རྙིངས་ནས་འཇིག་པར་འགྱུར་བའོ་ཞེས་པའོ།",
    "དེ་ལ་མ་རིག་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུ་ཡང་འབྱིན་པའོ་ཞེས་བྱ་བ་ནི་ལས་བསྐྱེད་པའི་དོན་དུ་བག་ཆགས་ཀྱི་མཚན་ཉིད་ཅན་གྱི་ནུས་པ་གཏོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
