    "དེ་ལ་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གལ་ཏེ་ཕྲད་པ་དང་མ་ཕྲད་པའི་ཕྱོགས་ལ་སྐྱོན་བརྗོད་པའི་འཇིགས་པས་རྒྱུས་འབྲས་བུ་སྐྱེད་པ་ཁས་མི་ལེན་ན་དེ་ལ་སྐྱོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཅི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱུ་རྒྱུ་ཉིད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ན་མ་བརྟགས་པར་གྲགས་པའི་རྒྱུ་དང་འབྲས་བུ་ལ་སོགས་པ་འཇིག་རྟེན་པའི་དངོས་པོ་རྣམས་ཡོད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "རྣམ་པར་དཔྱད་པ་འདི་འགྱུར་གྱི།",
    "ཞེས་བྱ་བ་ནི་ཕྲད་ནས་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་དཔྱད་པ་སྟེ།",
    "རྣམ་པར་དཔྱད་པའི་ཡུལ་ནི་རྫས་སུ་ཡོད་པ་ཡིན་པས་སོ།",
    "དེ་ལ་བསམ་དུ་མེད་པ་ཉིད་དེ་ཞེས་བྱ་བའི་ཕྲད་པ་ལ་སོགས་པའི་རྣམ་པར་དཔྱོད་པ་བསམ་དུ་མེད་པའོ།",
    "འདིར་ཁ་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁ་ཅིག་ཅེས་བྱ་བ་ནི་རྒྱུ་དང་འབྲས་བུ་རྫས་སུ་ཡོད་པར་འདོད་པའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྟག་པ་མཚུངས་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ཇི་ལྟར་ཞེ་ན།",
    "སུན་འབྱིན་འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུ་ཕྲད་ནས་སྐྱེད་པར་བྱེད་དམ།",
    "འོན་ཏེ་མ་ཕྲད་པར་སྐྱེད་པར་བྱེད་ཅེས་གང་སུན་འབྱིན་སྨྲས་པ་དེས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་སུན་དབྱུང་བར་བྱ་བ་ཕྲད་ནས་སུན་འབྱིན་ནམ།",
    "འོན་ཏེ་མ་ཕྲད་པར་ཡིན།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སུན་དབྱུང་བྱ་སུན་འབྱིན་པའི་ནུས་པ་ཡོད་པ་ཞེས་བྱ་བ་ནི་ཕྲད་ནས་འབྲས་བུ་སྐྱེད་པར་བྱེད་དམ།",
    "འོན་ཏེ་མ་ཕྲད་པར་སྐྱེད་པར་བྱེད་ཅེས་བྱ་བའོ།",
    "ཤུགས་ཀྱིས་ཞེས་བྱ་བ་ནི་སུན་འབྱིན་པར་བྱེད་པ་སུན་འབྱིན་པ་ནུས་པ་མེད་པ་ཉིད་དུ་བསྟན་པས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མ་ཁེགས་པས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་གྲུབ་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སུན་འབྱིན་པར་བྱེད་པའི་ཕྱོགས་དེ་རྣམ་པར་འཇོམས་ཤིང་རླག་པར་བྱེད་དེ།"
  ]
}