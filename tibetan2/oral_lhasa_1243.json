    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་བས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ངར་འཛིན་པའི་ཡུལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "གཉིས་ཀ་ལ་རྟེན་དང་བརྟེན་པའི་ཕྱོགས་དགག་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྟེན་དང་བརྟེན་པའི་ཕྱོགས་གཉིས་ཀ་བསལ་བའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "མ་དམིགས་པར་འདོད་པས་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་མུ་སྟེགས་པས་བཏགས་པའི་བདག་ཡོད་པ་ཡིན་གྱི་མ་དམིགས་པ་ཡིན་ནོ་ཞེས་འདོད་པས་ཀྱང་ངོ།",
    "འདི་ནི་ཕུང་པོ་རྣམས་རྟེན་འགྲུབ་པར་འགྱུར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་འདི་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདེན་པའི་རྣམ་པར་གཞག་པ་མ་ཆད་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་འདི་ལས་འདི་འབྱུང་ཞེས་བྱ་བའི་སྐྱེ་བ་ཉིད་འཇིག་རྟེན་པའི་ཐ་སྙད་ཙམ་དུ་ཡོད་པས་སོ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤིང་རྟ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡན་ལག་རྣམས་ལ་ཤིང་རྟ་ཡོད་པར་མི་འགྱུར་བ་དང་།",
    "ཤིང་རྟ་དེ་ལ་ཡང་ཡན་ལག་ཡོད་པར་མི་འགྱུར་བ་ཡིན་ཏེ།",
    "ཐ་དད་ཡོད་ན་གཉིས་ཀ་རྟེན་དང་བརྟེན་པར་འགྱུར་བ་ལས་ཐ་དད་པ་ཉིད་མེད་པས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་འདིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱོགས་ལྔ་པོ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་ཀྱི་ཕྱོགས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་སྟོན་པ་བརྩམས་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ནི་ཚོགས་པ་དང་དབྱིབས་དག་གོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གང་ལས་ཤེ་ན་ཞེས་བྱ་བ་ནི་ཚོགས་པ་ཙམ་མེད་པར་གང་ལས་ཤེས་ཤེ་ནའོ།",
    "དབྱིབས་སྨྲ་བའི་ཕྱོགས་ལ་སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཚོགས་པའི་ཡིན་པར་ཞེས་བྱ་བ་ནི།",
    "སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་ལ་གནས་པའོ་ཞེས་པའོ།",
    "སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་མ་བཏང་བའོ།",
    "ལན་འདེབས་པ་ནི་བྱེ་བར་གྱུར་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར་བྱེ་བར་གྱུར་པ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིང་རྟའི་ཡན་ལག་འཕང་ལོ་ལ་སོགས་པ་རྣམས་ཀྱི་དབྱེ་བས་བྱེ་བར་གྱུར་པའི་སྐབས་དང་ཁྱད་པར་མེད་པས་སོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དབྱིབས་གཞན་ཁོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིང་རྟ་ཉིད་ཀྱི་དུས་ན་གལ་ཏེ་དབྱིབས་ཀྱི་ཁྱད་པར་ཡོད་པར་འདོད་ན་དེའི་ཚེ་སྔར་གྱི་གནས་སྐབས་ལས་འཕང་ལོ་ལ་སོགས་པའི་དབྱིབས་ཀྱི་ཁྱད་པར་བཟུང་བར་འཕང་ལོ་ལ་སོགས་པའི་དབྱིབས་གཞན་ཁོ་ན་འཛིན་པར་འགྱུར་བའོ།",
    "འཕང་ལོ་ལ་སོགས་པའི་དབྱིབས་ཀྱི་ཁྱད་པར་གཞན་དུ་འཛིན་པར་ཡོད་པ་ནི་མ་ཡིན་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་ཞིག་སྔར་ཡོད་པར་གྱུར་པ་ཞེས་བྱ་བ་ནི་བྱེ་བར་གྱུར་པའི་གནས་སྐབས་ནའོ།",
    "དེ་ལས་ཞེས་བྱ་བ་ནི་སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་ལས་སོ།",
    "དེ་ཞེས་བྱ་བ་ནི་སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་ལས་གཞན་པའི་དབྱིབས་སོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཡན་ལག་རྣམས་ཀྱི་དབྱིབས་ཀྱི་ཁྱད་པར་ནི་ཤིང་རྟ་མ་ཡིན་ནོ་ཞེས་བསྟན་ནས།",
    "ད་ནི་ཚོགས་པའི་དབྱིབས་ཀྱི་ཁྱད་པར་ཡང་ཤིང་རྟ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡང་མི་རིགས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ན་ཚོགས་པ་མེད་པའི་ཕྱིར་ཚོགས་པ་ལ་བརྟེན་པའི་དབྱིབས་ཀྱི་རང་བཞིན་ཅན་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་བརྟེན་ནས་ཤིང་རྟ་ཅི་ལྟར་འགྱུར་ཏེ་རྫས་སུ་མེད་པའི་ཚོགས་པ་ནི་དབྱིབས་ཀྱི་ཉེ་བར་ལེན་པར་མི་རིགས་པས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཏགས་པ་ནི་རྫས་ཀྱི་རྟེན་ཅན་ཁོ་ནར་ཁས་བླངས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་མང་པོས་བཀུར་བ་བས་རྫས་སུ་ཡོད་པའི་ཉེ་བར་ལེན་པ་ལ་བརྟེན་ནས་དབྱིབས་སུ་ཉེ་བར་འདོགས་པར་འདོད་པས་སོ།",
    "ཅི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་བདེན་པ་ཡི་རྒྱུ་ལ་བརྟེན་བྱས་ནས།",
    "འབྲས་བུའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བརྫུན་པའི་རང་བཞིན་ཅན་གྱི་འབྲས་བུ་ཐམས་ཅད་སྐྱེ་བ་ཡིན་པར་ཤེས་པར་གྱིས་ཤིག་ཅེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མ་རིག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིས་ནི་བུམ་པ་ལ་སོགས་པ་ཡང་བསྟན་པ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་བའི་ཕྱིར།",
    "འདིས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་གནས་རྣམས་ལ་ཞེས་བྱ་བ་ནི་དབྱིབས་ཁྱད་པར་ཅན་ལ་གནས་པ་རྣམས་ཏེ།",
    "ཅི་ལྟར་ཤིང་རྟ་ལ་རྣམ་པར་དཔྱད་པར་བྱས་པ་དེ་བཞིན་དུ་གཟུགས་ལ་སོགས་པ་ལ་ཡང་བྱ་སྟེ།",
    "ཚོགས་པའི་ཡིན་པར་རྟོག་པ་ཞེས་པའི་རྣམ་པར་དཔྱད་པ་འདིར་ཡང་འཇུག་པར་བྱའོ།",
    "གཞན་ཡང་གལ་ཏེ་གཟུགས་ལ་ཡོད་པར་གྱུར་ན་དེའི་ཚེ་དེ་རྣམས་ཀྱི་དབྱིབས་བུམ་པར་འགྱུར་བ་ཞིག་ན།",
    "འོན་ཀྱང་གཟུགས་ལ་སོགས་པ་ཉིད་མེད་པ་དེ་རྣམས་ཀྱི་དབྱིབས་བུམ་པར་ཅི་ལྟར་འགྱུར་ཞེས་པའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་རིགས་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པའི་དབྱིབས་བུམ་པར་རིགས་པ་མ་ཡིན་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ལས་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པས་སོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དབྱིབས་ཀྱི་རྣམ་པར་དཔྱད་པ་ནའོ།",
    "ཤིང་རྟ་འོན་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པའི་ལོ་ཀ་ན་ཐ་སྙད་མེད་པར་འགྱུར་བ་ལས་ཐ་སྙད་མཐོང་བའི་ཕྱིར་ཤིང་རྟ་ཡོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་རྒྱས་པར་སྟོན་པ་ནི།",
    "ཤིང་རྟ་ལ་སྐྱེ་བ་མེད་པ་ཡིན་དུ་ཆུག་རྣམ་པར་མ་དཔྱད་པར་ཤིང་རྟའི་ཐ་སྙད་བྱེད་པ་ཡིན་ནོ་སྙམ་ན།",
    "གྲུབ་པའི་མཐའ་པས་གཞན་ཞེས་བྱ་བ་ནི་ལོ་ཀའི་ཐ་སྙད་ཙམ་གྱིས་དངོས་པོ་རྣམས་ཡོད་པར་འཇོག་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "རྣམ་པ་བདུན་གྱི་སྒོ་ནས་དཔྱད་ན་ཤིང་རྟ་ཡོད་པར་མ་གྲུབ་པས་ཅི་ལྟར་ཤིང་རྟའི་སྒོ་ནས་ཐ་སྙད་བྱེད་ཅེས་པའོ།",
    "རང་ཉིད་ཀྱི་ཕྱོགས་ལ་ཉེས་པ་མེད་པ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁོ་བོ་ཅག་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤིང་རྟ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱོགས་འདི་ལ་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཐམས་ཅད་འཐད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇིག་རྟེན་གྲགས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ཤིང་རྟ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བུའི་རྣམ་པར་གནས་པའི་ཞེས་བྱ་བ་ནི་མ་བརྟགས་ན་ཉམས་དགའ་བའི་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཙམ་གྱིས་རྣམ་པར་གནས་པའོ།",
    "ཕྱིན་ཅི་ལོག་ཏུ་རྟོགས་པ་དེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཡན་ལག་ཚོགས་པ་ཙམ་ཡོད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་གལ་ཏེ་རྣམ་པར་དཔྱད་ན་ནི་དེའི་ཚེ་ནི་གཉིས་ཀ་ཡང་ཡོད་པ་མ་ཡིན་ལ་གལ་ཏེ་རྣམ་པར་མ་དཔྱད་ན་ནི་དེའི་ཚེ་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཙམ་དུ་ནི་གཉིས་ཀ་ལ་ཡོད་པ་ཡིན་ཏེ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ཡན་ལག་ཅན་ཡོད་པར་སྨྲ་བའོ།",
    "ཅི་ལྟར་དགག་པར་བྱ་ཞེ་ན།",
    "ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡན་ལག་དང་ཡན་ལག་ཅན་ལ་སོགས་པའི་འཇིག་རྟེན་ལ་གྲགས་པའི་ཀུན་རྫོབ་དེ་བརླག་པར་མ་བྱེད་ཅིག་ཅེས་པ་སྟེ།",
    "དེ་བརླག་ན་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཆད་པར་འགྱུར་བའོ།",
    "མ་དཔྱད་པར་གྲུབ་པའི་ཀུན་རྫོབ་ཁས་བླངས་ན་དེ་ཁོ་ན་ཉིད་ལ་བདེ་བླག་ཏུ་འཇུག་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཁོ་ན་ཉིད་ལ་བདེ་བླག་ཏུ་ཇི་ལྟར་འཇུག་པར་འགྱུར་ཞེས་འདྲི་བ་ནི།",
    "ལན་ནི་རྣམ་བདུན་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དངོས་པོའི་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པར་འགྱུར་ན།",
    "དེ་ཡི་གྲུབ་པ་དེ་བཞིན་འདོད་པར་བྱ།",
    "ཞེས་བྱ་བ་ནི་མ་བརྟགས་ན་ཉམས་དགའ་བ་ཙམ་གྱིས་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཀྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡོད་པར་འདོད་པར་བྱ་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཉེ་བར་རྟོག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཉེ་བར་རྟོག་པའི་ཞེས་བྱ་བ་ནི་རྣམ་པར་དཔྱོད་པར་བྱེད་པའོ།",
    "ཀུན་རྫོབ་ཉམས་པར་ཡང་མི་འགྱུར་བ་སྟེ་ཞེས་བྱ་བ་ནི་མ་བརྟགས་ན་ཉམས་དགའ་བ་ཙམ་གྱི་ཀུན་རྫོ་བ་ཁས་ལེན་པས་སོ།",
    "ཕན་ཡོན་དང་བཅས་པའི་ཞེས་བྱ་བ་ནི་ཁོ་ན་ཉིད་དང་བདེ་བླག་ཏུ་འཇུག་པར་འགྱུར་བས་སོ།",
    "འདིར་སྨྲས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤིང་རྟ་ཡོད་ཉིད་མིན་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡན་ལག་ཅན་མེད་པར་ཡན་ལག་དག་ཀྱང་མེད་དོ་ཞེས་ཅི་ལྟར་བརྗོད་ཅེ་ན་ཞེས་བྱ་བ་ནི་ཤིང་རྟ་མེད་ཀྱང་ཤིང་རྟའི་ཡན་ལག་དག་ནི་ཡོད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནི་དེ་ལྟར་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ནི་ཤིང་རྟའི་ཡན་ལག་རྣམས་ངོ་བོ་ཉིད་ཀྱིས་ཡན་ལག་ཏུ་གྲུབ་པར་གྱུར་ན་དེའི་ཚེ་འབྲེལ་པ་མ་མཐོང་བས་ཀྱང་རྟོགས་པར་འགྱུར་བ་ལས་རྟོགས་པ་ཡང་མ་ཡིན་ནོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གཞན་ཡང་ཤིང་རྟ་མི་རིགས་པའི་ཤིང་རྟའི་ཡན་ལག་ཀྱང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིང་རྟ་ཚིག་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཇི་ལྟར་མེས་ཤིང་རྟ་ཚིག་པར་འགྱུར་བ་ན་འཕང་ལོ་ལ་སོགས་པའི་ཤིང་རྟའི་ཡན་ལག་རྣམས་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡན་ལག་ཅན་ཏེ་ཤིང་རྟའི་མཚན་ཉིད་ཅན་ཤེས་རབ་ཀྱི་མེས་བསྲེགས་པར་འགྱུར་བ་ན་ཡན་ལག་རྣམས་ཀྱང་ཚིག་པ་ཉིད་ཡིན་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཤིང་རྟ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་དཔྱོད་པའི་གཙུབ་ཤིང་གཙུབས་པ་ལས་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་དཔྱོད་པ་ཉིད་ཤིང་གཙུབས་པ་ཡིན་ཏེ།",
    "ཇི་ལྟར་མེས་སྲེག་པར་བྱེད་པ་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་མེས་ཀྱང་ཤིང་རྟ་མི་དམིགས་པའི་མཚན་ཉིད་ཅན་དུ་སྲེག་པར་བྱེད་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མི་དམིགས་པའི་སྲེག་པར་བྱེད་པ་ཅན་གྱི།",
    "ཤིང་རྟ་ལུས་པ་མེད་པར་བསྲེགས་པས་ན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་དག་ཀྱང་ཚིག་པར་གྱུར་པའོ།",
    "ཇི་ལྟར་ཤིང་རྟ་ལོ་ཀའི་ཐ་སྙད་ཙམ་དུ་ཁས་ལེན་པ་དེ་བཞིན་དུ་བདག་ཀྱང་བཏགས་པ་ཙམ་དུ་ཡོད་པ་འཇིག་རྟེན་གྱི་གྲགས་པ་ལས་ཁས་བླང་བར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིང་རྟ་རྣམ་པར་དཔྱོད་པའི་ཚུལ་ལ་བསམས་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པ་བདུན་གྱི་སྒོ་ནས་རྣམ་པར་དཔྱད་ན་ཤིང་རྟ་མི་འཐད་པ་ཡིན་ནོ་སྙམ་པའི་ཚུལ་སེམས་ལ་བཞག་ནས་སོ།",
    "པར་གཞག་པ་ཞེས་བྱ་བ་ནི་ཤིང་རྟའི་ཡན་ལག་ལ་བརྟན་ནས་ཤིང་རྟ་འདོགས་པའི་རང་བཞིན་ཅན་ནོ།",
    "དེ་ཁོ་ན་ཉིད་ལ་བདེ་བླག་ཏུ་འཇུག་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་སྔར་བསྟན་ཟིན་ཏོ།",
    "འཇིག་རྟེན་གྲགས་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཞན་དུ་འཇིག་རྟེན་གྱི་ཐ་སྙད་འཆད་པར་འགྱུར་བས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་འཕང་ལོ་ལ་སོགས་པ་དག་ལ་བརྟེན་ནས་ཤིང་རྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཇི་ལྟར་འཇིག་རྟེན་གྱི་རྗེས་སུ་འབྲངས་ནས་བདག་ཏུ་ཁས་ལེན་པ་དེ་བཞིན་དུ་ལས་དང་བྱེད་པ་པོ་ལ་སོགས་པའི་ཐ་སྙད་བཏགས་པ་ཡང་འཇིག་རྟེན་གྱི་ཐ་སྙད་མི་གཅད་པར་བྱ་བའི་ཕྱིར་འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་ཁས་བླང་བར་བྱ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་འཕང་ལོ་ལ་སོགས་པ་དག་ཤིང་རྟའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིང་རྟ་ལྟར་ཁས་བླང་བར་བྱའོ་ཞེས་བྱ་བ་ནི་བཏགས་པར་ཡོད་པ་ཙམ་དུ་ཁས་བླང་བར་བྱའོ་ཞེས་པའོ།",
    "དེ་ལྟར་བརྟེན་ནས་བཏགས་པ་ལ་ཡོན་ཏན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བརྟན་པ་དང་མི་བརྟན་པ་ལ་སོགས་པའི་རྟོག་པའི་རྟེན་ཉིད་མ་ཡིན་པ་ཉིད་ལས་ཞེས་བྱ་བ་ནི་གལ་ཏེ་དངོས་པོ་ཡོད་ན་བརྟན་པ་དང་མི་བརྟན་པར་འགྱུར་བ་ཡིན་ལ།",
    "དངོས་པོ་ཡོད་མིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཕུང་པོ་དག་ལ་བརྟེན་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ཉེ་བར་ལེན་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟར་གལ་ཏེ་བདག་རྟག་་ན་རྟག་པར་སྨྲ་བར་འགྱུར་བ་དང་།",
    "བདག་བྱས་པར་འདོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེས་ན་བདག་ནི་བྱས་པ་མ་ཡིན་ནོ།",
    "བསྟན་པ་ཡང་མི་འཐད་པ་དེ་བསྟན་བཅོས་ཀྱི་ཁུངས་ཀྱི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འགྲོ་བ་གཅིག་ལ་གནས་སུ་ཟིན་ཀྱང་འགྲོ་བ་སྣ་ཚོགས་པ་འཛིན་པར་འགྱུར་བས་སོ།",
    "སྒྱུར་བའི་རྒྱལ་པོ་ང་ལས་ནུ་ཞེས་བྱ་བར་གྱུར་ཏོ་ཞེས་བྱ་བ་དེ་ཇི་ལྟར་ཁོང་དུ་ཆུད་པར་བྱ་ཞེ་ན།",
    "དེ་ལྟར་གསུངས་པ་དེ་ནི་གཞན་ཉིད་དགག་པ་ཙམ་ཡིན་གྱི་དེ་ཉིད་དུ་སྟོན་པར་མཛད་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཉེ་བར་ལེན་པ་ཐ་དད་པར་འགྱུར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གལ་ཏེ་སྔོན་གྱི་བདག་ཉིད་དེ་ཉིད་ད་ལྟར་གྱི་ཡིན་པར་འགྱུར་ན།",
    "དེའི་ཚེ་ཕུང་པོ་ལྔའི་མཚན་ཉིད་ཅན་གྱི་ཉེ་བར་ལེན་པ་ལ་ཁྱད་པར་མེད་པར་འགྱུར་རོ།",
    "བདག་ནི་ཉེ་བར་ལེན་པ་ལ་ཁྱད་པར་མེད་པ་ཡང་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཉེ་བར་ལེན་པ་ནི་ཁྱད་པར་དུ་གྱུར་པ་ཡིན་ཏེ།",
    "དེས་ན་ཉེ་བར་ལེན་པ་ཁྱད་པར་ཅན་མ་ཡིན་པའི་ཕྱིར་བདག་ཉིད་དེ་ཉིད་དུ་རིགས་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཉེ་བར་ལེན་པ་ཁྱད་པར་ཅན་ཡིན་དུ་ཆུག།",
    "དེ་ལ་ལན་ནི་ཉེ་བར་ལེན་པ་ལས་མ་གཏོགས་པར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
