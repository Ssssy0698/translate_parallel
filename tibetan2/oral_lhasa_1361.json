    "གནོད་སྦྱིན་ཛ་ཞེས་བགྱྀ་བ་འྀ་རྀགས་ལགས་ཤེས་ཀྱང་མཆྀ།",
    "གང་ལགས་ཀྱང་མྱྀ་མངོན་ཏེ།",
    "རྗེ་གཉའ་ཁྲི་ཁོང་ཡང་བོད་ཀ་གཡའ་དྲུག་གམ་སྤུར་རྒྱལ་རང་ཁོངས་ཀྱི་མི་དངོས་མིན་པར་རྒྱལ་ཕྲན་གཞན་ནས་གདན་དྲངས་པ་ཞིག་ཡིན་ཕྱིར་རུས་རྒྱུད་དང་ཁྱིམ་རྒྱུད་ལ་དེ་འདྲའི་མཐོང་ཆེན་མ་བྱས་ཤིང་།",
    "གང་ཟག་ལ་སྦྱོར་སྐབས་འུ་ནི་ཆུང་བའི་དོན་དུ་འཇུག་པས་ཞེ་སར་གོ་བའི་ངེས་པ་མེད་པར་མ་ཟད།",
    "གནམ་ཀོལ་དུ་གནང་བའང་ཅྀས་བས་ཞིག་མཆིས་ན།",
    "ནང་དོན་ཆེས་ཆེ་བ་དང་རིན་ཐང་ཆེས་ཆེ་བའི་མིང་ཚིག་དག་ཡིན་པར་གོར་མ་ཆག་ཕྱིར།",
    "དེ་ལྟར་གཞུང་ལུགས་འཐུས་ཚང་ཞིག་ཏུ་གྲུབ་པར་མངོན་ལ།",
    "ཉེ་བའི་དུས་སུ་ཚེ་རིང་དོན་གྲུབ་ལགས་ཀྱིས་ལྡེའུའི་རིགས་ལ་སྒྲུང་ལྡེའུ་དང་།",
    "འོན་ཀྱང་བརྗོད་དོན་གང་ཞིག་ཡིན་རུང་དེ་ལ་འོས་འཚམས་ཀྱི་ཚད་གཞལ་བྱེད་ཅིག་མེད་པར།",
    "དེ་གཞལ་བྱེད་ཀྱི་ཐབས་དམ་པར་མངོན་སུམ་དང་རྗེས་དཔག་གཉིས་ལས་དགོས་པ་མ་མཆིས་ཤིང་།",
    "ཡུལ་དངོས་པོའི་གྲུབ་ལུགས་སམ་སྡོད་ལུགས་ཡུལ་ཅན་རིག་པ་བློས་ཇི་མ་ཇི་བཞིན་དུ་མཐོང་བའི་རྟོག་མེད་མངོན་སུམ་ཡིན་པར་མ་ཟད།",
    "མཚན་ཉིད་ཀུན་གྱི་སྤྱི་སྐྱོན་ཡིན་ཞེས་གསུངས་པ་ལྟར།",
    "མི་དཔོག་པར་འདོད་ནས་རྐང་ལག་བཞི་ལྡན་ཞེས་ཁྱབ་བྱེད་དང་འགལ་བའི་སྐྱོན་ཤོར་བ་དང་།",
    "ཆུ་དཔོག་པར་འདོད་ནས་ཚ་ཞིང་བསྲེག་པ་ཞེས་ངོ་དང་འགལ་བའི་སྐྱོན་ཤོར་མི་རུང་བ་ལྟ་བུ་སོགས་ཞིབ་ཏུ་དཔྱད་ན་རིགས་མཐུན་མི་ཉུང་བ་ཞིག་ཡོད་པར་རིགས་སོ།",
    "རྒྱལ་བོ་གཅིག་པུས་བརྒྱ་ཁ་གཅིག་ཆོད་མི་བྱེད་པར་གནས་ཚུལ་དངོས་ལ་བརྟག་དཔྱད་དཔྱིས་ཕྱིན་པ་གནང་ནས།",
    "མངོན་སུམ་གྱི་བརྟག་དཔྱད་གཏོང་ཐབས་ནི་ལྡེའུའི་རིག་པ་ཁྱད་པར་བ་ཞིག་ཏུ་མཐོང་སྟེ།",
    "ཞིབ་དུ་དཔྱད་ན་གཏམ་དཔེ་ནི་བོད་བཙན་པོའི་དུས་སྐབས་ཤིག་ནས་རྒྱ་ཁྱབ་དུ་བཀོལ་བཞིན་ཡོད་པར་གདོན་མི་ཟ་སྟེ།",
    "ལྷག་པར་གོང་དུ་བརྗོད་པ་བཞིན་གཏམ་དཔེ་ཞེས་པའི་ཚིག་དོན་ལས་དཔགས་ཐུབ་པར།",
    "དེང་སྐབས་དམངས་ཁྲོད་དུ་གང་སར་སྤྱོད་བཞིན་པའི་གཏམ་དཔེ་ཁོངས་སུའང་ཚིག་སྦྱོར་འོས་འཚམས་སྒོས་བརྗོད་དོན་ཐད་ཀར་སྟོན་པའི་གཏམ་མི་ཉུང་བ་ཞིག་མཆིས་ཞེས་གསུངས་པ་ལྟར།",
    "སྲོག་སྲིད་ཉིས་མ་སྟོར་པར་བྱ་འོ།",
    "དེའི་ནང་ནས་ཀྱང་མཆོག་ཏུ་གྱུར་བའམ་གཙོ་བོ་ནི་རང་ཉིད་ཀྱི་ཚེ་སྲོག་དང་ཁྱིམ་སྲིད་གཉིས་ཀ་ཡིན་པས་དེ་མི་བརླག་པར་ནན་གྱིས་སྐུལ་བ་དང་།",
    "ཆབ་སྤེལ་ཚེ་བརྟན་ཕུན་ཚོགས་ཀྱིས་འབྲུ་འགྲེལ་བྱས།",
    "རྟགས་དཔེ་ཅི་ཡང་མི་དགོས་པར་ཐད་ཀར་བརྗོད་པའི་ལེགས་ཉེས་བླང་དོར་གྱི་དབྱེ་བ་འབྱེད་པའི་གཏམ་ཞིག་ཡིན་པ་དང་།",
    "བཀའ་གདམས་པར་ཕྱི་འཇམ་དགོས།",
    "བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་ཀྱི་རྟགས་འགོད་རིག་པ་ལྟ་བུའི་གསང་བ་ལྐོག་གྱུར་འཇལ་བའི་དཔེ་ཞིག་གཏན་ནས་མ་ཡིན་པར།",
    "དུས་སྐབས་དེའི་རིང་ལ་འཛམ་གླིང་ཧྲིལ་བོར་ད་ལྟའི་ཚན་རིག་ལག་རྩལ་ལྟ་བུ་ཞིག་གང་དུའང་མཐོང་དུ་མེད་པར་མ་ཟད།",
    "རྟགས་སྦྱོར་ཅི་ཡང་མི་དགོས་པར་ཐད་ཀར་དྲང་བརྗོད་བྱས་པའི་གཏམ་ཞིག་ཡིན་པ་དང་།",
    "དཔལ་དོན་གྲུབ་རྒྱལ་སོགས་ཀྱི་གསུང་རྩོམ་ལས་ལན་གཅིག་མིན་པར་མཐོང་ཞིང་།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "དེ་ན་འགྲོ་བ་མིའི་རིགས་ཀྱི་རིག་པ་བློ་གྲོས་ཀྱིས་ཤུལ་བཞག་བྱས་པའི་རིགས་པའི་གཞུང་ལུགས་ཤིག་ཡིན་ཕྱིན།",
    "རྒྱལ་སྲིད་ལྡེའུས་བསྐྱངས་ཞེས་པའི་བརྗོད་དོན་གཙོ་བོ་ཞིག་ཏུའང་བགྲང་ཆོག་པར་སེམས།",
    "ཡང་ན་རྒྱ་བོད་འཇལ་འདུམ་བྱས་པའི་རྡོ་རིང་ཡི་གེ་ལས་འཕྲུལ་གྱི་ལྷ་བཙན་པོ་འོ་ལྡེ་སྤུ་རྒྱལ།",
    "གཤེན་ཁྲི་བཞེར་འདོན་གཉིས་བར་འཁྲུག་འཛིང་བྱུང་ནས་གཤེན་གྱིས་དབས་བསད་པར།",
    "ཞེས་གསུང་ཡོད་པར་མ་ཟད།",
    "ཟིང་བོ་རྗེས་གྱོད་དོན་དེར་ཐག་གཅོད་དྲངས་བོ་མ་བྱས་ཚེ་མྱང་དབས་གཉིས་ཀས་མཉམ་དུ་ཟིང་བོར་ངོ་ལོག་སྟེ།",
    "གཙང་དཀར་བཅུ་གཉིས་དང་ཁོ་ན་བདག་དང་བཅུ་གསུམ།",
    "དེ་ནི་མནའ་རབས་ལྡེའུའི་རིག་པ་བཀོལ་བའི་མཚོན་དོན་རྨ་མེད་པ་ཞིག་ཏུ་བགྲང་ཆོག་པར་སེམས་སོ།",
    "དེ་ནི་གཏན་ཚིགས་ལྡེའུའི་རིག་པ་ལས་བྱུང་བའི་རྗེས་དཔག་འཇལ་བའི་ཐབས་ཤེས་གནའ་རབས་བོད་མིས་དངོས་སུ་ལག་ལེན་དུ་བསྟར་བའི་སྲོལ་ལུགས་ཤིག་ཀྱང་ཡིན་པར་སེམས་སོ།",
    "བདེན་རྫུན་གྱི་དབྱེ་བ་རྗེས་དཔག་རིག་པས་གཞལ་ཚུལ་འདིར་གནའ་རབས་གཏུགས་བཤེར་གྱི་ཡི་གེ་དག་ལས་དཔེ་འདྲེན་ཙམ་བྱས་ན།",
    "ལྷག་པར་ལེའུ་གསུམ་པ།",
    "དེ་ནི་ཧ་ཅང་དཔྱོད་དགོས་པའི་གནས་ཤིག་ལས་ཚིག་གཅིག་གཉིས་ཙམ་གྱིས་སུས་ཀྱང་ཁ་ཚོན་གཅོད་མི་རིགས་པར་སེམས།",
    "དེའི་གཏན་ཚིགས་རིགས་ལམ་གྱིས་བོད་མིའི་བློ་གྲོས་ལ་ཤུགས་རྐྱེན་ཐེབས་པར་བསྒྲགས་པ་ནི་དེ་བས་ཀྱང་དགོད་བྲོ་བ་ཞིག་མ་ཡིན་ནམ།",
    "དེ་ནི་ཤིན་ཏུ་སྤྱིར་བཏང་བའི་མཚུངས་དཔེ་སྦྱོར་བ་ཁོ་ན་ཙམ་ཞིག་གཏན་ནས་མ་ཡིན་པར།",
    "གཙོ་བོ་ལྐོག་གྱུར་གྱི་བསྒྲུབ་བྱ་ཞིག་དཔོག་པར་སྒྲུབ་བྱེད་ཀྱི་དཔེ་སམ་རྟགས་བཀོད་ལ་བརྟེན་ནས་དཔོགས་པའམ་གཏན་ལ་འབེབས་པའི་རིགས་ལམ་ཞིག་སྟེ།",
    "ཤིན་ཏུ་ལྐོག་གྱུར་གྱི་བྱ་བ་ཆེ་ཆུང་ཕྲ་རགས་ཚང་མར་བརྟག་དཔྱད་དང་ཐག་གཅོད་བྱས་པ་ཞིག་ཏུ་གོར་མ་ཆག་ཅིང་།",
    "གཙོ་བོ་དཔེ་དང་འབྲེལ་སྦྱོར་ངེས་ཅན་ཞིག་གྲུབ་དགོས་པར་མ་ཟད།",
    "ཡར་ཀླུང་གཙང་བོ་ཆུའི་ནང་ནས་ཆེ་བ་ཡིན་པའི་རང་དང་རྒྱུས་ཆེ་བའི་རང་བྱུང་ཁམས་ཀྱི་དངོས་ཡོད་དག་བཀོད་པ་ལྟ་བུའོ།",
    "བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་བཀོད་ན་ཚུལ་གསུམ་གྱི་གཏན་ཚིགས་འགྲུབ་ཐུབ།",
    "བརྗོད་པ་མཛེས་པར་བྱེད་པའི་ཚིག་རྒྱན་ཁོ་ན་ཙམ་དུ་གོ་བར་ཧ་ཅང་མི་རིགས་ཏེ།",
    "ཞེས་པར་ཡིད་ཆེས་ཀྱི་རྟགས་ཡང་དག་ནི་ཤེས་བྱ་ཤིན་ཏུ་ལྐོག་གྱུར་གཏན་ལ་འབེབས་བྱེད་ཀྱི་གཏན་ཚིགས་ཤིག་ཡིན་པ་དང་།",
    "སྲིད་པའི་ཡེ་མཁྱེན་འཕྲུལ་རྒྱལ་དེས་མ་སང་གཉན་གྱི་ཡུལ་དུ་གཏན་ལ་ཕབ་སྟེ་གཉན་བོན་ཐང་ཐང་ཁྲོལ་བ་ལ་གནང་།",
    "ཅི་བྱས་ཅིའི་མ་ཕན་ནོ།",
    "ཡེ་མཁྱེན་དགྲ་བླའི་མངོན་ཤེས།",
