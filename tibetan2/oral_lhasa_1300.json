    "ས་སྟེང་སྣོད་ཀྱི་ཁྱད་པར་གཞན་དང་གཞན་གྱུར་པས།",
    "དེ་བཞིན་རྒྱལ་སྲས་ཐམས་ཅད་མཁྱེན་གསུང་ཐམས་ཅད་ཀྱང་།",
    "འཛམ་བུ་གླིང་པའི་མི་ཐམས་ཅད་འདི་སྐད་ཅེས་འདིར་སྤྲིན་མི་འཁོར་རོ་ཞེས་བརྗོད་པར་བྱེད་དོ།",
    "ཨ་ལ་ལ་སྤྲིན་ཆེན་པོ་འདིས་ཆར་གྱི་རྒྱུན་འབེབས་པར་བྱེད་ཅིང་ས་གཞི་ཆེན་པོ་ཡང་ཀུན་ཏུ་ཚིམ་པར་བྱེད་དོ།",
    "ཞེས་ཀྱང་བརྗོད་པར་བྱེད་དོ་ཞེས་དང་།",
    "གཉིས་པ་བྱེད་ཀྱང་དེ་ལྟར་རྣམ་པར་མི་རྟོག་པ་ནི།",
    "རྒྱུ་གདགས་པར།",
    "དེ་ལས་ཆུའི་ཐིགས་པར་འགྱུར་རོ།",
    "གཞན་ཡང་མི་རྣམས་ཀྱིས་དེ་ལྟ་བུའི་ལས་རྣམས་བྱས་ཤིང་བསགས་ཏེ།",
    "དེ་དག་བྱས་ཤིང་བསགས་པས་མི་མ་ཡིན་པ་རྣམས་འཁྲུགས་ནས་ཆུའི་ཐིགས་པ་འབབས་ཏེ།",
    "བདག་ལྟའི་བག་ལ་ཉལ་བརྟགས་པའི་ལོག་པར་ངེས་པ་ཅན་དག་ལ་རང་སྡང་སེམས་ཀྱིས་གནོད་པ་འབྱུང་ཡང་།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་དང་ཡེ་ཤེས་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡུལ་ལ་འཇུག་པ་བསྟན་པ་ལས་ཀྱང་རྒྱ་ཆེར་གསུངས་སོ།",
    "དཔེར་ན་མི་གཙང་བ་དྲི་ཞིམ་མེད་པ་བཞིན་འགྲོ་བ་ལྔ་པོ་དག་ན་བདེ་བ་མེད་དོ།",
    "དེས་འགྱུར་བ་དང་འདུ་བྱེད་ཀྱི་དུབ་ཡང་འདྲེན་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་འགོག་པ་མངོན་དུ་བྱེད་པའི་ཐབས་ལམ་ནི་རྒྱུ་ལ་བརྟེན་པར་བྱ་བ་ཡིན་ནོ།",
    "རབ་ཏུ་བྱུང་ནས་ཆུ་བོ་ནེ་རཉྫནའི་འགྲམ་དབེན་པར་དཀའ་ཐུབ་སྤྱོད་པ་དང་།",
    "བྱེད་པའི་ལས་ཁྱད་པར་དུ་འཕགས་པའོ།",
    "ཀུ་མུ་ད་ནི་རབ་ཏུ་ཟུམ་པར་འགྱུར་ཡང་ཆུ་སྐྱེས་ཁ་བྱེ་བའི་ཡོན་ཏན་དང་།",
    "གདུལ་བྱ་མིན་པ་ལ་གནོད་པའི་རྟོག་པ་མེད་པར་འཇུག་གོ།",
    "བྱ་བ་གཞན་ལོ་ཐོག་ལ་སོགས་པ་དག་སྨིན་པར་བྱེད་པ་ལྟར་དཔེ་དེ་བཞིན་དུ།",
    "ཇི་ལྟར་ན་རྒྱང་རིང་པོར་སྣང་བར་བྱས་པས་རྒྱ་ཆེན་པོའི་འོད་ཟེར་སྟོང་དང་ལྡན་པའི་ཉི་མ་ཤར་བའི་སྐབས་འདིར་འདིའི་འོད་ཟེར་གླིང་བཞིའི་འཇིག་རྟེན་ཀུན་ཏུ་སྣང་བར་བྱས་ནས་རིམ་གྱིས་ནི་དང་པོར་རི་རབ་ལ་སོགས་པའི་རི་མཆོག་རི་ཆེན་པོ་རྣམས་དང་།",
    "ཤེས་བྱའི་དོན་མ་ལུས་པ་གསལ་བར་སྟོན་པར་མཛད་དོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་ནོར་བུ་རིན་ཆེན་ཕན་བདེ་སྒྲུབ་པའི་རྟོག་པ་མེད་བཞིན་ཇི་ལྟར་འདོད་པའི་ནོར་འབད་པ་མེད་པར་དག་ལ་རབ་ཏུ་སྟེར་བ་ལྟར།",
    "གཉིས་པ་སྐལ་བ་མེད་པས་རྙེད་པར་དཀའ་བ་ནི།",
    "དེ་ལ་དགོས་དོན་འདོད་ཅིང་དོན་དུ་གཉེར་བ་ཐམས་ཅད་ཀྱིས་འགྲོ་བ་འདིར་འདོད་དོན་ཐོབ་པ་རབ་ཏུ་རྙེད་པར་དཀའ་སྟེ།",
    "དཔེ་དེ་བཞིན་དུ་བདེ་བར་གཤེགས་པ་ཡང་གདུལ་བྱ་ཀུན་གྱི་དོན་མཛད་ཀྱང་འགྲོ་བ་ཤིན་ཏུ་སྐལ་བ་ངན་པས་མཐོང་བ་རྙེད་པར་དཀའ་བར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་གསུང་གདུལ་བྱ་གཞན་གྱི་རྣམ་རིག་ལས་བྱུང་པ་ཡང་བརྗོད་འདོད་ཀྱི་རྣམ་པར་རྟོག་པ་མེད་ལ།",
    "ཇི་ལྟར་ས་ལ་སྐྱེ་བའི་རྩི་ཤིང་སོགས་ཀུན་བསྐྱེད་པར་བྱའོ་སྙམ་པའི་རྣམ་རྟོག་མེད་པའི་ས་གཞི་དེ་ལ་བརྟེན་ནས་ནི་རྩི་ཤིང་ནགས་ཚལ་ཀུན་གོང་ནས་གོང་དུ་འཕེལ་བ་དང་།",
    "ཕྲིན་ལས་རྟོག་པ་དང་འབད་པ་མེད་པར་ལྷུན་གྲུབ་ཏུ་འཇུག་པ་དེའི་དོན་རྟོགས་པར་བྱ་བའི་ཕྱིར་བེ་ཌཱུརྱའི་ས་གཞི་ལ་བརྒྱ་བྱིན་གྱི་གཟུགས་བརྙན་ཤར་བ་ལ་སོགས་པ་དཔེ་དག་ནི་རྣམ་པ་དགུ་བརྗོད་པ་དེ་ལས་ནི་དེའི་དོན་དགུའི་བསྡུས་པའི་དོན་ངེས་པར་བཟུང་སྟེ།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་ཐུགས་ཀྱི་ཕྲིན་ལས་མཛད་པ་ནི་དྲི་མ་མེད་པའི་བེ་ཌཱུརྱའི་ས་གཞིར་བརྒྱ་བྱིན་གྱི་གཟུགས་བརྙན་ཤར་བ་དང་།",
    "ཐམས་ཅད་མཚོན་ནུས་པའི་དཔེ་ནི་མེད་པར་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་དང་ཡེ་ཤེས་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡུལ་ལ་འཇུག་པ་བསྟན་པར།",
    "ཡེ་ཤེས་སྣང་བ་རྒྱན་དུ་ཡང་རྒྱ་ཆེར་གསུངས་སོ།",
    "རྟོགས་པར་བྱ་བའི་གནས་དེ་བཞིན་གཤེགས་པའི་ཁམས་དང་།",
    "དེ་རྣམས་ཀྱི་གཞན་དོན་སྒྲུབ་པ་ཕྲིན་ལས་ཏེ་རྒྱལ་བ་ཁོ་ན་ཡིས་ནི་མཁྱེན་པའི་ཡུལ་རྣམ་པ་བཞི་པོ་སྔར་ཇི་སྐད་བརྗོད་པ་འདི་བློ་ལྡན་བྱང་སེམས་ཀྱི་ཁམས་དེ་རང་གཞན་ལ་ཡོད་པ་དང་།",
    "ཅིའི་ཕྱིར་ན་དེ་ལས་དེ་རྫོགས་པར་འགྱུར་ཏེ།",
    "སེར་སྣ་སོགས་སྤངས་པས་རྫོགས་ཤིང་དག་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དེ་རྣམས་རྫོགས་པའི་གེགས་འཁོར་གསུམ་དུ་རྣམ་པར།",
    "གང་དག་སྟོང་པ་ཉིད་ཀྱི་ཚུལ་འདི་ལས་སེམས་ཕྱིན་ཅི་ལོག་ཏུ་རྣམ་པར་གཡེང་ཞིང་རྣམ་པར་འཕྲོ་ལ་མཉམ་པར་མི་འཇོག་ཅིང་།",
    "རྩེ་གཅིག་ཏུ་མི་འགྱུར་བ་དེས་ན་དེ་དག་སྟོང་པ་ཉིད་ལ་སེམས་རྣམ་པར་གཡེངས་པ་ཞེས་བརྗོད་དོ།",
    "དོན་དམ་དེ་ཁོ་ན་ཉིད་མཆོག་ཇི་ལྟ་བ་རྫོགས་པར་ནི་ཚུལ་བཞིན་ཏེ་ཕྱིན་ཅི་མ་ལོག་པར་ཀུན་མཁྱེན་གྱིས་མཁྱེན་གྱི།",
    "རྙེད་གྲགས་སོགས་ལ་ལྷག་པར་བརྐམ་པའི་ཕྱིར་དང་།",
    "དེ་ལ་མནར་མེད་རྣམས་ཀྱི་འགྲོ་བ་ཤིན་ཏུ་འཇིགས་པར་འགྲོ་བར་མི་འགྱུར་ལ།",
