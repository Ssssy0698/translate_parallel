    "གཉིས་ནི་སོ་སོར་གཉིས་སྣང་གི་དངོས་པོའོ།",
    "དེ་ཡང་རང་གི་ཤེས་པ་ཙམ་ཡེ་ཤེས་ཡིན་ཏེ།",
    "ཅིར་སྐྱེས་ཅིར་སྣང་ཐམས་ཅད་རང་གི་སེམས་ཡིན་པས་སེམས་མེད་ན་མི་སྐྱེ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "རང་གི་སེམས་ལས་བྱུང་བར་བསྟན་ཏོ།",
    "གང་གིས་ཡེ་ཤེས་ཁྱད་པར་ཅན་ནི་ཡེ་ཤེས་ཀྱི་དེ་ཁོ་ན་ཉིད་དེ་གཞུག་མ་མ་བཅོས་པའི་ཤེས་པ་ལ་བྱ་སྟེ།",
    "ཡེ་ཤེས་བྱིན་བརླབས་ནི་རང་གི་སེམས་ཀྱི་བྱིན་བརླབས་ཡིན་ཏེ་སེམས་ལས་གཞན་མེད་དོ།",
    "དེ་ཙམ་ན་རང་ལ་ཡི་དམ་གྱི་ལྷ་ལན་གསུམ་དུ་གསོས་འདེབས་མི་ཞིག་ཡོད་ན་ངན་སོང་དུ་འགྲོ་མི་སྲིད་གསུངས་སོ།",
    "གར་དང་རི་མོ་ལྟ་བུ་ནི་དེ་དག་གིས་བསླུ་བ་དང་དོན་མེད་པར་བསྟན།",
    "འོ་ན་ལེའུ་དེ་ལ་ཅིའི་ཕྱིར་སྦྱོར་བའི་གདན་གྱི་བདག་གི་གདན་ཞེས་བྱ་ཞེ་ན།",
    "དཔལ་གདན་བཞི་པ་ཡང་དག་པར་རྣམ་པར་གཟིགས་པའི་འགྲེལ་པ་ལས་སྦྱོར་བའི་གདན་གྱིས་བདག་གི་གདན་རྣམ་པར་ཕྱེ་བའི་ལེའུ་དང་པོའོ།",
    "ཅི་ལྟ་བུ་གཅིག་བསམ་ན་ཞལ་གཅིག་ཕྱག་གཉིས་པ་ཞབས་སེམས་དཔའི་དཀྱིལ་མོ་ཀྲུང་བཅས་པ།",
    "གཡོན་པས་རྣ་བའི་རྩར་ཁ་ཕྱེ་བའི་ཨུཏྤལ་འཛིན་པར་བསྒོམ་མོ།",
    "དེ་ནས་གནས་དྲུག་ཏུ་ཡི་གེ་དགོད་པ་ལ་ཨོཾ་ཏཱ་རེ་སྭཱ་ཧཱ་ལ་སོགས་པ་བཀོད་ནས་ཡེ་ཤེས་སེམས་དཔའ་སྤྱན་དྲངས་ལ་གཉིས་སུ་མེད་པར་བསྲེ་བའམ།",
    "དེའི་མཐར་སྔགས་ཀྱིས་བསྐོར་བ་དམིགས་ལ་ཨོཾ་ཏཱ་རེ་ཏུཏྟ་རེ་ཏུ་རེ་སྭཱ་ཧཱ་ཞེས་སྔོན་དུ་བསྙེན་པ་འབུམ་བཟླས་སོ།",
    "སྒྲོལ་མའི་སྔོན་དུ་བསྙེན་པ་སོང་བས་ལས་དྲུག་འགྲུབ་ཅེས་པའི་དོན་ཏོ།",
    "བདག་ཉིད་ལྷ་མོ་སྒྲོལ་མར་བསྒོམས་པའི་ཐུགས་གར་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་ལ་ཏ་རེ་ཏུ་རེ་ཏུཏྟ་རེ་སྭཱ་ཧཱ་ཞེས་པའི་ཡིག་འབྲུ་བརྒྱད་བསམ།",
    "དབུས་སུ་ཟླ་མོ་ལ་རཀྵ་རཀྟ་ཞེས་པ་བསྒོམ།",
    "མུ་ཁྱུད་ལ་ཨཱ་ལི་རྣམས་བཀོད་ལ་འཁོར་ལོའི་ལྟེ་བར་བསྒྲུབ་བྱ་བསྒོམས་ལ་བསྲུང་བའི་བསམ་པས་ཨོ་ཏ་རེ་ཏུཏྟ་རེ་ཏུ་རེ་ཆེ་མོ་ལ་རཀྟ་རཀྵ་སྭཱ་ཧཱ་ཞེས་བཟླས་ན་རྒྱལ་པོའི་བཙོན་ར་དང་དགྲ་ལ་སོགས་པ་ལས་བསྲུང་བའི་ལས་སུ་འགྱུར་རོ།",
    "ཐ་མ་སྭཱ་ཧཱ་གཉིས་ཀྱི་བར་དུ་རྒེ་མོ་པྲཛྙཱ་པུཏྟཾ་ཀུ་རུ་ཡེ་སྭཱ་ཧཱ་ཞེས་པའོ།",
    "དབུས་སུ་ནི་རེ་མིག་དབུས་མ་ལའོ།",
    "ནང་གི་རེ་མིག་དགུའི་ཡི་གེའོ།",
    "ཨཱ་ལི་བཅུ་གཉིས་པོ་ཕྱི་རོལ་གྱི་རེ་མིག་བཅུ་གཉིས་ལ་དགོད་པའོ།",
    "ཏ་ལོག་གི་ཡི་གེ་ལྔ་སྟེ།",
    "དང་པོ་ནི་ནང་གི་རེ་མིག་དགུ་པོའི་ཁ་དོག་དཀར་པོའོ།",
    "གཉིས་པ་ནི་རེ་མིག་བཅུ་གཉིས་པོ་སེར་པོའོ།",
    "གསུམ་པ་ནི་རེ་མིག་བཅུ་དྲུག་པོ་དམར་པོའོ།",
    "ཨོཾ་ཤྲཱི་སྭཱ་ཧཱ་ཞེས་འབུམ་ཕྲག་གཅིག་བཟླས་པ་ནི་ལས་བཞི་ཀའི་ཐུན་མོང་གི་བསྙེན་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཨོཾ་སུཾ་སྭཱ་ཧཱ་ཞེས་པ་ལ་སོགས་པ་འབུམ་ཕྲག་རེ་རེ་བཟླས།",
    "ཨོཾ་ཕཊ་སྭཱ་ཧཱ་ལ་སོགས་པ་རེ་མིག་གཉིས་པ་དང་གསུམ་པ་དང་བཞི་པ་ལ་བརྒྱ་རྩ་བརྒྱད་བཟླས་སོ།",
    "ཨོཾ་སུ་རྒེ་མོ་སརྦ་བྷུ་ཊི་ཤན་ཏིང་ཀུ་རུ་ཡེ་སྭཱ་ཧཱ།",
    "མེ་འབར་བ་ནི་མཉམ་པའི་འོད་ཅེས་པ་ནི་འཁོར་ལོ་ལ་འོད་མེ་ལྟར་བྱུང་བས་བསྒྲུབ་བྱའི་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ཐུལ་ཐུལ་ཚིག་པར་བསམ་མོ།",
    "ཨོཾ་ཨ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་བཅུ་གཉིས་པོ་རེ་རེ་ལ་འབུམ་ཚོ་རེ་རེ་བཟླས་པ་ནི་དགོས་ཀྱི་བསྙེན་པའོ།",
    "ཨོཾ་ཨ་ཧྥེ་མོ་པུཊྚི་ཀུ་རུ་ཡེ་སྭཱ་ཧཱ།",
    "མེ་འབར་བ་ནི་མཉམ་པའི་འོད་ཅེས་པ་ནི་འཁོར་ལོ་ལས་འོད་ཟེར་མེ་ལྟ་བུ་བྱུང་བས་བསྒྲུབ་བྱའི་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་བཏུལ་བཏུལ་ཚིག་པར་བསམ་མོ།",
    "ཉོན་མོངས་ཀུན་ནི་བཀྲེས་སྐོམ་དང་ཚེ་ཐུང་བ་ལ་སོགས་པའོ།",
    "ཨ་དེ་ནས་གྲོ་ག་ལ་སོགས་པ་ལ་དགྲའི་མིང་རུས་བྲིས་ལ་སྐུད་པ་སྔོན་དམར་གྱིས་དཀྲིས་ནས་འཁྲུལ་འཁོར་གྱི་དབུས་སུ་བཞག་ཕྱི་རོལ་གྱི་མུ་ཁྱུད་ལ་རྒེ་མོ་མཱ་ར་ཡ་ཧཱུྃ་ཕཊ་ཞེས་པ་ཤོང་ཚད་བྲི།",
    "ཉོན་མོངས་ཀུན་ནི་དགྲའོ།",
    "དེ་ནས་འཁྲུལ་འཁོར་དེ་ཁྱེར་ལ་རང་གི་ཕྱིའི་ཁྱི་མོ་དཀར་མོ་གཅིག་ཁྲིད་ནས།",
    "དེའི་ཁར་དྲི་ཆེན་དུམ་ཅིག་བཏང་དེའི་ཁར་ཡང་སས་གཡོགས་ལ་རང་གི་དྲི་ཆེན་ཡོད་ཚད་བཏང་ངོ།",
    "གོང་གི་མིང་ནི་རྨེ་མོ་སྤེལ་བའོ།",
    "དེ་ནས་བསྒྲུབ་ཅིང་ལས་ལ་སྦྱར་བ་ལ་གང་འདོད་གཟུགས་ནི་བསྒྲུབ་བྱ་བུད་མེད་ལ་སོགས་པའོ།",
    "དེ་ནས་ཡེ་ཤེས་མཁའ་འགྲོ་མར་གསལ་བའི་ལག་པ་གཡོན་པའི་མཛུབ་མོ་ལ་ཧཱུྃ་བསམས་ཏེ།",
    "མཛུབ་མོ་ཐོར་ཏོ་བསྐྱོད་བྱ་ཞིང་།",
    "ཨོཾ་ཧཱུྃ་ཧྥེ་མོ་ཨཀཆུ་ཡ་ཛཞེས་བཟླས་སོ།",
    "ད་ནི་ལྷ་མོ་ནོར་རྒྱུན་མས་རྒྱས་པའི་ལས་བསྒྲུབ་པ་བསྟན་པའི་ཕྱིར་འདབ་མ་བརྒྱད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་ཏེ།",
    "དེ་ཡང་གནས་ཁང་ཡིད་དང་མཐུན་པར་སོང་ལ།",
    "ས་བོན་ནི་གྲོགས་མོ།",
    "དབུས་སུ་བསྟན་པའི་ས་བོན་ནི་བྲོ་མོ།",
    "ཨོ་བྲོ་རྒེ་མོ་ཨཱ་ཡུ་ཛ་ནྱ་པུཊྚི་ཀུ་རུ་ཡེ་སྭཱ་ཧཱ་ཞེས་བཟླས་ན་ཚེ་རྒྱས་པར་འགྱུར་རོ།",
    "ཨོ་བྲོ་རྒེ་མོ་པུ་ནྱ་པུཏྟིཾ་ཀུ་རུ་ཡེ་སྭཱ་ཧཱ།",
    "དམར་པོར་སོང་ནས་འདོད་ཆགས་ཆེ་བའོ།",
    "དཔལ་གདན་བཞི་པ་ཡང་དག་པར་གཟིགས་པའི་རྣམ་པར་འགྲེལ་པ་ལས།",
    "དེའི་འོག་ཏུ་ནི་བསྙེན་པ་སྔོན་དུ་སོང་བའིའོ།",
    "གཉིས་མེད་གཏོར་མའི་ལས་གང་གིས་འབེབས་ཀྱང་མཁའ་འགྲོ་མ་ལ་གཏོར་མ་སྦྱིན་པའོ།",
    "རཚ་ཡམས་སྐད་ཅིག་གིས་ནི་ཆང་དེ་འཐུངས་མ་ཐག་ཏུ་ཡེ་ཤེས་འབབ་པར་འགྱུར་རོ།",
    "ཕེབས་མ་ཐག་ཏུ་ཞེས་པ་ནི་སྔགས་དང་རྫས་ལ་སོགས་པས་ཕབ་པས་ཡེ་ཤེས་ཕེབས་མ་ཐག་ཏུ་རྣལ་འབྱོར་པ་སྟེ་རྡོ་རྗེ་སློབ་དཔོན་གྱིས་རྡོ་རྗེ་ཅན་ཁྱོད་ལ་སོགས་པའི་དབྱངས་བླང་ངོ།",
    "བདག་ཉིད་རང་དགར་སྦྱར་བ་ནི་བསྙེན་པ་སྔོན་དུ་སོང་བས་ནམ་དགའ་བ་ན་བལྟས་པས་ཡེ་ཤེས་འབེབས་པར་བྱེད་དོ།",
    "འབེབས་ན་ནི་དཔའ་བོ་དང་དཔའ་མོ་རྣམས་ལ་ཡེ་ཤེས་ཕེབས་ནས་གར་བྱེད་དོ།",
    "ཨོཾ་བྷེ་ཏ་ལི་ཞེས་པའི་སྔགས་དེ་ལ་རང་གི་ཡི་དམ་གྱི་ལྷའི་ང་རྒྱལ་གྱིས་སྔོན་དུ་བསྙེན་པ་འབུམ་བྱ།",
    "གཅན་གཟན་ནམ་རྣལ་འབྱོར་པ་གཞན་གྱིས་རེག་པ་བྱེད་པ་མེད་དེ་ཅུང་ཟད་ཙམ་ཡང་མི་རེག་གོ།",
    "དེ་བཞིན་དུ་ཐལ་བ་ལ་ཨོ་བྷེ་ཏ་ལི་ཞེས་པ་འདི་ལན་བདུན་དུ་བཏབ་ཁ་ལ་གཏོར་ན་ཞིང་སྲིན་གྱིས་ཟ་བ་དེ་ཅུང་ཟད་ཙམ་ཡང་མི་ཟའོ།",
    "འཁོར་ལོ་དེ་རེ་མིག་དགུ་པ་མུ་ཁྱུད་དང་བཅས་པ་གཅིག་བྲིས་ལ་རེ་མིག་དགུ་ལ་མཁའ་འགྲོ་མ་དགུའི་སྔགས་སྤེལ་ཚིག་དང་བཅས་པ་བྲི།",
    "ཞབས་གཡས་བརྐྱང་ཞིང་གཡོན་བསྐུམ་པ་མེ་རི་དང་མེ་དཔུང་གི་ནང་ན་བཞུགས་པའོ།",
    "དེ་ཡང་རྒྱ་གར་གྱི་ཡུལ་ན་མི་གཅིག་ལ་ཆུང་མ་མཁའ་འགྲོ་མ་ཐ་མལ་པའི་བུད་མེད་ཀྱི་གཟུགས་གཟུང་པ་གཅིག་ཡོད་པ་ལ།",
    "མོ་སྲོད་ཀྱི་རིགས་ལ་སྟོར་ནས་སོང་བས་ཁོའི་བསམ་པ་ལ་འདི་སྐྱེས་པ་གཞན་གྱི་གན་དུ་འགྲོའམ་སྙམ་ནས།",
    "མོའི་རྒྱབ་ཏུ་རས་བལ་གྱི་གྲུ་གུ་རིང་པོ་ཞིག་གི་སྣ་བཏགས།",
    "དེ་ནས་མོ་སོང་པའི་ཤུལ་ན་ཕར་རས་བལ་གྱི་གྲུ་གུ་རྡོག་ཅིང་ཕྱིན་པས་དུར་ཁྲོད་གཅིག་ན་མཁའ་འགྲོ་མའི་ཟླ་ལ་ཚོགས་ཀྱི་འཁོར་ལོ་བྱེད་ཀྱི་འདུག།",
    "ལ་ལ་ན་རེ་རྒྱ་མཚོ་ཆེན་པོ་ཧུབ་ཀྱི་གདབ་བམ་ཟེར།",
    "ཁོའི་ཆུང་མ་ན་རེ་རི་བོ་དྷེ་ཤ་རྐང་པའི་སེན་མོས་བརྡེག་གམ་ཟེར་རོ།",
    "དེ་ནས་ཁོ་ཕྱིར་ལ་ལོག་ནས་ཉལ་ཙམ་ན་མོ་བྱུང་ནས་ངའི་གོས་དེ་གདངས་ལས་ཕོབ་དང་ཟེར་རོ།",
    "ཁོས་རི་བོ་དྷེ་ཤ་ཡང་རྐང་པའི་སེན་མོས་ཐེག་ན་གོས་མི་ལོན་ནམ་བྱས་པས།",
    "མོ་ཁྲོས་ཏེ་ང་གསང་སྔགས་ཀྱི་གསང་སྤྱོད་བྱེད་པ་འདིས་ཚོར་ནས་འདུག་ཟེར་ཏེ་སྐུད་པ་དམར་པོ་དཀྲིས་པས་ལྕེ་སྤྱང་དུ་གྱུར་ཏེ་འཁྱམས་སོ།",
    "ཕྱིས་ཁོ་སྐུད་པ་ཆད་པས་མི་རྒན་གཅིག་ཏུ་སོང་བས་ཡང་མོའི་གན་དུ་སོང་བས་ཡང་སྐུད་པ་བཏགས་པས་ལྕེ་སྤྱང་དུ་སོང་ནས་འཁྱམས་ཏེ་ཤིའོ།",
    "རལ་གཅིག་མའི་བསྐྱེད་རིམ་སྔོན་དུ་སོང་བས་ཡུམ་སྲེ་ར་ཞེས་པའི་སྔགས་སྔོན་དུ་སོང་བ་ལ།",
    "ངག་ཏུ་ཨོཾ་ཡཾ་པྲ་ར་ཡུ་ཆེ་གེ་མོ་ཡུ་གྲུ་ཊ་ཞེས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་བསྐྱོད་པའི་ལས་འགྲུབ་པར་འགྱུར་རོ།",
    "རལ་གཅིག་མའི་བཅས་བསྐྱེད་རིམ་སྔོན་དུ་སོང་བས་ཡུ་ཕྲེ་རའི་སྔགས་ལ་སྔོན་དུ་བསྙེན་པ་བྱའོ།",
    "དེ་ཡང་ས་སྟེགས་ཀྱི་དཀྱིལ་འཁོར་གྲུ་བཞི་པ་གཅིག་གི་དབུས་སུ་དོང་གྲུ་གསུམ་པ་ཞིག་བྲུས་དེའི་མཐའ་མར་སེང་ལྡེང་གི་ཕུར་པ་སོར་བརྒྱད་པ་བརྒྱད་གདབ།",
    "དོང་གི་ནང་དུ་དུར་ཁྲོད་ཀྱི་སོལ་བས་ནག་པོར་བྱ།",
    "སྔགས་ཨོཾ་ཏིཥྛ་ཆེ་གེ་མོ་ཨ་ཀར་ཡ་ཧཱུྃ་ཧེ་ཕྲོ་ཕུ་ཕཊ་ཅེས་བཟླས་ཤིང་བསྒྲུབ་བྱ་དེ་ཡང་ནས་ཡང་དུ་བཀུག་ཅིང་བསྟིམ་མོ།",
    "ད་ནི་དྲག་མོ་མཁའ་འགྲོ་མས་རྨོངས་པའི་ལས་བསྒྲུབ་པ་སྟོན་ཏེ།",
    "དེ་ནས་ལས་ལ་སྦྱར་བ་ལ་དགྲའི་ལིངྒ་གཅིག་བྲིས་ལ་རཾ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་ལ་སོགས་པས་དྲག་མོ་མཁའ་འགྲོ་མར་བསྒོམས་ཏེ།",
    "མཁའ་འགྲོ་མ་ལ་གཏོར་མ་བྱིན་ནས་ལིངྒ་རེ་ལ་སྔགས་རེ་བཟླས་ཤིང་ཉ་ལ་བྱིན་ནས་བརྒྱ་རྩ་བརྒྱད་ཐེམ་པ་ན་དགྲའི་མཐུ་ཐམས་ཅད་རྨོངས་པའི་ལས་སུ་འགྱུར་རོ།",
    "དེའི་དབུས་སུ་བུད་མེད་དེའི་མིང་དང་རུས་བྲིས་ལ་གཞུག།",
    "དེ་ནས་རང་གདོལ་པ་མཁའ་འགྲོའི་ང་རྒྱལ་གྱིས་རྐང་པ་གཡོན་པས་གཟིར་ཞིང་སྔགས་ཨོཾ་སུཾ་བྷ་ཡ་སྟེ་བྷ་ཡ་ཧཱུྃ་ཆེ་གེ་མོའི་བྷ་ག་ན་མུ་ཏྲི་ཕོ་ཕྲོ་ཕཊ་ཅེས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་བྷ་གའི་ཆུ་སྡོམ་ཞིང་གཟེར་བའི་ལས་འདི་འགྲུབ་པ་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "དེ་ནས་མོ་ཞུ་བ་བྱེད་ནས་བཅིངས་པ་ལས་དགྲོལ་བར་འདོད་ན་མིང་བྱང་དང་བྷ་གའི་གཟུགས་དེ་ཆུ་དང་།",
    "དེའི་ནང་དུ་ཁྱིམ་མོ་བཙའ་ལངས་པའི་སྤུས་དགང་།",
    "ཨོ་ཀྲོ་དྷི་ཤྭ་རི་ཕུ་རུཾ་ཕཊ་ཅེས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ཤིང་རང་གི་རྡོ་རྗེ་བྷ་གའི་དབྱིབས་དེ་ལ་རེག་རེག་བྱས་ནས་བྷ་ག་གཙེས་ཤིང་གཟིར་ཏེ་ན་བ་དང་རྡོག་པ་དང་སྒྲུང་བར་འགྱུར་རོ།",
    "ཕྱུང་བ་ནི་རྡོ་རྗེ་རེག་པའི་འཕྲོ་བཅད་པའོ།",
    "ཆགས་པ་ཆེ་བའི་བུད་མེད་བདེ་བ་ཕབ་ནས་ཆགས་པ་ཞི་བར་བྱ་བ་དང་།",
    "སྐུ་ནི་བུད་མེད་དེའི་མཆན་ཁུང་གཡོན་པར་ཟླ་བའི་དཀྱིལ་འཁོར།",
    "ཁྲོ་བོ་ནི་མཛུབ་མོའི་རྩེ་མོར་རོ།",
    "བདུད་རྩིའི་ཡི་གེ་ནི་སུ་མོ།",
    "སོར་མོ་བསྐྱོད་པ་ནི་མཛུབ་མོའི་སུཾ་གྱིས་སྐུའི་ཨ་མཉེ་བའོ།",
    "སྨྱོ་བྱེད་ནི་ཐང་ཕྲོམ་མོ།",
    "མིའི་ཡུངས་མར་ནི་མིའི་ཞུན་མར་ལ་ཨའི་ཨ་མ་མར་མེའི་མར་བྱ།",
    "དེ་ནས་མེ་མར་བཏང་ལ་ཐོད་པས་ཁ་བཅད་ནས་བསྙེན་པ་སྔོན་དུ་སོང་བས་མཁའ་འགྲོ་མའི་བསྙེན་སྔགས་ནི་ཨོཾ་ཧཱུྃ་སྭཱ་ཧཱ།",
    "བརྒྱད་བརྒྱ་ནི་སྔགས་རེ་ལ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའོ།",
    "དཔལ་གདན་བཞི་པ་ཡང་དག་པར་རྣམ་པར་གཟིགས་པ་ལས།",
    "ནང་གི་རྡོ་རྗེ་དྲིལ་བུ་དང་།",
    "རྫོགས་རིམ་གྱི་རྡོ་རྗེ་དྲིལ་བུ་ནི་རྡོ་རྗེ་ནི་ལྟེ་བའི་གཏུམ་མོའི་མེའོ།",
    "བར་དུ་གཅོད་པའི་བདུད་དུ་བྱུང་བ་དེ་ཡང་བདུད་ཀྱི་བར་དུ་གཅོད་པ་མ་ཡིན་པས་རང་གི་སེམས་ཡིན་ནོ།",
    "རང་གིས་རང་སེམས་ནི་རང་གི་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་དེ་ཉམས་མྱོང་གིས་གདུལ་བའོ།",
    "བཟོད་པའི་མེ་ཏོག་ནི་མཎྜལ་ལ་མེ་ཏོག་གི་ཚོམ་བུ་བཀྲམ་པ་བཞིན་དུ་ཟག་མེད་ཀྱི་ཉམས་སུ་མྱོང་བ་ལ་བཟོད་པའི་མེ་ཏོག་གིས་རྣལ་འབྱོར་པ་རྟེན་གྱི་གང་ཟག་གི་ལུས་ལ་དགྲམ་པའོ།",
    "རང་རེ་ཉམས་གང་དགའ་བའི་ས་ཕྱོགས་སོ།",
    "སྐྱེས་བུ་གཅིག་གི་ཚད་ནི་ཕྱག་རྒྱ་མ་དེ་ལ་ལག་པས་སླེབ་ཚོད་དུ་བཞག་པའོ།",
    "གཞན་ཡས་ཁང་དེའི་ནང་དུ་པདྨ་དང་ཟླ་བའི་དབུས་སུ་ཧཱུཾ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པར་བསྒོམས་ཏེ།",
    "དེ་ལ་ཀྵ་དང་ཡུ་ལ་སོགས་པའི་ས་བོན་དགོས་པའམ་ཡང་ན་དགོད་བྱ་ཞེས་པ་ལ་སོགས་པའི་ཚིག་བཞིས་མིག་གཉིས་དང་ལྕེ་ཆུང་དང་མགྲིན་པ་དང་དཔུང་པ་གཉིས་དང་ལྟེ་བ་དང་གསང་དམས་པ་གནས་སུ་ཧཱུྃ་དཀར་པོ་རེ་རེ་དགོད་གསུངས་སོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་ཚིག་རྐང་དྲུག་གིས་ལྷའི་སྐུའི་ཐུགས་ཀར་ཧཱུྃ་བསྒོམས་ལ་འོད་ཟེར་སྤྲོ་བསྡུ་བྱ་བ་བསྟན་ནོ།",
    "རྡོ་རྗེ་མཛུབ་མོ་ལ་སོགས་པས་བདེ་བ་བསྐྱེད་པའི་ཕྱིར་རྩ་བསླང་བ་སྟོན་ཏེ།",
    "ལག་པ་གཡོན་པའི་མཛུབ་མོའི་རྩེ་མོར་བདུད་རྩིའི་ཡི་གེ་ཧཱུཾ་བསམས་ལ།",
    "མཛུབ་མོ་བཙུགས་ཏེ་འཁྲུད་པའོ།",
    "ལྷ་མོ་ནི་ལས་རྒྱ་མའོ།",
    "རྐང་མཐིལ་གཉིས་ནི་ཐབས་ཤེས་རབ་གཉིས་ཀའི་རྐང་པ་སོར་མོ་བཙིར་ཞིང་བསྐུམ་པའོ།",
    "གློ་གནས་ནི་ལས་ཀྱི་ཕྱག་རྒྱ་མའི་གློ་ངོས་གཅིག་གི་སྟན་ལ་འདུག་པའོ།",
    "གཡས་ཀྱི་པུས་མོ་ནི་ཤེས་རབ་མའི་པུས་མོ་གཡས་པ་ཐབས་ཀྱི་རྐང་པ་གཡོན་པས་མནན་པའོ།",
    "ལག་གཉིས་ནི་ལག་པ་གཉིས་ཀས་ཐབས་ཀྱི་ཤེས་པ་སྤྲིན་བསྐུར་བའི་ཕྱིར་རྣ་བའི་རྩར་སེན་མོ་གདབ་བོ།",
    "ལྷ་མོ་རང་གི་ལུས་ནི་ཤེས་རབ་མའི་ལུས་ཀྱི་གནས་བརྒྱད་དུའོ།",
    "ཆུ་སྐྱེས་དག་གི་མེ་ཏོག་ནི་པདྨ་སྟེ།",
    "གསང་བ་ནི་རྩ་ཀ་ཀ་མུ་ཁ་ཞེས་པ་བྱ་རོག་གི་གདོང་པ་ཅན་ནོ།",
    "རྩེ་མོ་གསུམ་ནི་མཛུབ་མོ་དང་གུང་མོ་དང་སྲིན་ལག་གསུམ་བསྒྲེང་བའོ།",
    "མཁའ་འགྲོ་མ་ནི་རྩ་བྱ་རོག་གི་གདོང་ཅན་ནོ།",
    "མཛུབ་མོ་ལ་སུ་བསྒོམས་པའི་ཕྱག་རྒྱས་ཤེས་རབ་མའི་སྐུ་གཡོན་པར་ཟླ་བའི་སྟེང་དུ་ཨ་བསྒོམས་པ་དེ་ལ་བསྐུལ་ཞིང་བྲུད་པར་བྱའོ།",
    "གནས་ཀུན་ནི་རྣ་བ་ལ་སོགས་པ་སེན་མོས་གདབ་པའི་གནས་ཀུན་དུ་སེན་མོས་གདབ་པའོ།",
    "རྡོ་རྗེ་རྩེ་མོའི་ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་རྩེ་གསུམ་གྱི་ཕྱག་རྒྱས་སོ།",
    "ཧཱུྃ་གི་སྒྲ་ནི་ཐབས་ཀྱིས་ཨོཾ་ཨཱ་ཧཱུྃ་སྭཱ་ཧཱ།",
    "རྡོ་རྗེའི་རྩེར་ཞེས་པ་ནི་རྡོ་རྗེ་རྩེ་མོར་གཟུང་ཞེས་པའོ།",
    "བདག་ལྷ་ནི་བདེ་བས་ལུས་ཀྱི་ལྷ་ཉི་ཤུ་རྩ་གསུམ་མཉེས་པར་བསམ་མོ།",
    "དེ་ཁོ་ན་ཉིད་གཟུང་བྱ་སྟེ་ཞེས་བྱ་བ་ནི་ནང་གི་རྡོ་རྗེ་དྲིལ་བུའི་དོན་ཤེས་ནས་ཕྱིའི་རྡོ་རྗེ་དྲིལ་བུ་གཟུང་ལ།",
    "ཕྱིའི་རྡོ་རྗེ་དྲིལ་བུའི་དོན་དེ་ཤེས་པས་ནང་གི་རྡོ་རྗེ་དྲིལ་བུ་ཡང་གཟུང་བའོ།",
    "ཟག་པ་མེད་པའི་ཉམས་སུ་མྱོང་བ་རང་གི་རྒྱུད་ལ་རབ་ཏུ་སྦྱོར་བར་འགྱུར་རོ།",
    "ཐམས་ཅད་ལྷ་ནི་རྡོ་རྗེ་དྲིལ་བུ་གཉིས་ཀའི་ལུས་ཀྱི་ལྷ་དོན་དམ་ཟག་མེད་ཀྱི་ཉམས་མྱོང་གིས་མཉེས་པར་འགྱུར་རོ།",
    "ད་ནི་བུ་མོས་གྲོགས་བྱས་ཏེ་ཐབས་བདེ་བ་བསྐྱེད་པའི་ཕྱིར་ཐབས་གཙོ་བོས་གྱུར་པ་སྟོན་ཏེ།",
    "བདེ་བའི་སྟན་ནི་སྙོམས་འཇུག་གི་དུས་སུའོ།",
    "སྙོམས་འཇུག་གི་དུས་སུ་དང་པོར་འཛུམ་པ་དང་།",
    "གཟུང་བ་ནི་རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོར་གཟུང་བའོ།",
    "འགྲུབ་འགྱུར་ནི་མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་བོ།",
    "ཏཾ་པོ་ལ་ནི་ཤིང་ཐོག་གི་བྱེ་བྲག་གོ།",
    "འབུམ་དུ་བཟླས་པ་ནི་ཐུན་མོང་གི་བསྙེན་པ་བྱ་བའོ།",
    "གཉིས་སྦྱོར་ནི་རྐང་ལག་གི་གར་རོ།",
    "མཉམ་པའི་སྟབས་ནི་རྐང་ལག་གི་སོར་མོ་ནང་དུ་བསྣོལ་བའོ།",
    "ཏི་ར་ཁྲ་མ་ནི་གོང་གི་དེ་ཉིད་ལ་གཞོགས་གཡོན་ངོས་སུ་བསྐྱེད་པའོ།",
    "གཅིག་པུ་གནས་པ་ནི་རྐང་པ་གཅིག་ས་ལ་གཞག་ནས་གཅིག་གིས་སྣ་ཚོགས་སུ་བསྒྱུར་བའོ།",
    "མཆོད་སྡོང་གི་ཚུལ་ནི་རྐང་པ་གཉིས་གཤིབས་ནས་བྱིན་པ་བསྲང་བའོ།",
    "པུས་མོ་མནན་པ་ནི་ཙོག་ཙོག་པུར་འདུག་ནས་དཔུས་མོའི་སྟེང་དུ་ལག་པའི་གྲུ་མོ་བཙུགས་པའོ།",
    "བསེག་ཀྱང་ནི་རྐང་པ་གཉིས་ཀྱི་སོར་མོས་ནུ་མ་མཉེ་བའོ།",
    "ཕྱེད་ཀྱིས་འཁྱུད་པ་ནི་ལུས་ཀྱི་ཕྱོགས་གཅིག་གིས་ཕན་ཚུན་དུ་རེག་པའོ།",
    "ལུས་ལ་རེག་པ་ནི་ལུས་སྦྱར་ཞིང་བསྐྱོད་པའོ།",
    "ལྐོག་ལྐོག་ལ་རེག་པ་ནི་མཛུབ་མོ་དང་གུང་མོས་ལྟོས་ལྷོ་བཏེག་ནས་འོ་བྱ་བའོ།",
    "སྣ་ཚོགས་ནི་སོ་དང་སེན་མོས་གདབ་པ་ལ་སོགས་པའོ།",
    "དེའི་དཔེ་ནི་མཚན་མོ་ཟླ་བ་མེད་པ་ལ།",
    "ཟླ་བ་ཉིན་མོ་ཇི་ལྟར་སྣང་ཞེས་བྱ་སྟེ།",
    "ཉིན་མོ་ཇི་ལྟར་སྣང་ཞེས་པ་ནི།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་མཆོག་དང་ཐུན་མོང་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བའོ།",
    "དེ་ནི་རྣལ་འབྱོར་པ་ཞེས་པ་ནི་ནང་གི་ལམ་ཐབས་ཤེས་རབ་དབྱེར་མེད་ཀྱི་དོན་ལ་གཞོལ་བ་དེ་རྣལ་འབྱོར་པ་ཡིན་ནོ།",
    "ནང་གི་ནི་རྡོ་རྗེ་དང་པདྨའི་བར་དུའོ།",
    "ཐལ་སྦྱར་ནི་སྙོམས་འཇུག་ཟིན་པའི་ཚེ་ནའོ་དགྱེས་ཤིང་ཐུགས་ཚིམ་ནི་སྙོམས་འཇུག་བྱས་པའི་ཟག་མེད་ཀྱི་ཉམས་སུ་མྱོང་བའོ།",
    "དེ་ནས་སྟོང་པར་བསྒོམས་པའི་ངང་ལས་གདན་པདྨ་དང་ཟླ་བའི་དབུས་སུ་ཡི་གེ་ཧཱུཾ་ལས་རོ་ལངས་མའི་གཟུགས་སུ་བསྒོམ་མོ།",
    "དཔའ་བོ་ཁྲག་གིས་སྦགས་པའི་རས་སམ།",
    "ལྷ་མོ་ནི་ལྷ་མོའི་ལུས་ལས་སོ།",
    "དེར་མེ་ལྷ་བསྒོམས་པའི་ཐུགས་ཀར་ལྷ་མོ་སེང་གེ་མ་བསམ།",
    "གོང་གི་མཚན་ཉིད་ལྡན་པས་མཆོད་ནི་ཉ་ཤ་དང་སྒོག་པའི་བྱི་སྐུ་ལ་སོགས་པ་བཅུག་པའི་གཏོར་མ་ཡང་དབུལ་ལོ།",
    "དབུས་སུ་མེ་སྦར་ནི་ཐབ་ཁུང་གི་དབུས་ཀྱི་མེའོ།",
    "ཨོཾ་སཾ་མ་ར་ཡུ་ཕི་ཕུ་ཕཊ་ཅེས་པ་ནི་སྦྱིན་བསྲེག་གི་སྔགས་སོ།",
    "དེ་ནས་ལྷ་མོ་ནི་ལྷ་མོའི་གཟུགས་སུ་མཛེས་པར་སྟོན་པའོ།",
    "ང་ནི་ལྷ་མོ་སེང་གེ་མ་དང་དགོས་པ་ཅིའི་ཕྱིར་བསྒྲུབ་ཅེས་པ་དང་།",
    "བདག་གིས་ལས་བྱ་རྒྱུ་ཅི་ཡོད་ཅེས་པའོ།"
  ]
}