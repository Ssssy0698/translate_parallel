    "འགྱོད་བཤགས་རྟེན་དགེ་རྩ་གང་འབྱོར་དགོས།",
    "སྐྱབས་དམ་པ་ཡུལ་མཆོག་གནས་བཞི་མཁྱེན།",
    "རྩལ་སྣང་སྲིད་མ་ལུས་ཐོག་མེད་མཁྱེན།",
    "ཕྱི་གཙང་མཛེས་ནབ་བཟའ་གོས་དྲུག་གཟོབ།",
    "ནང་རྣམ་དག་བཤགས་སྦྱོང་ཐོས་བསམ་བསྒོམ།",
    "བཀྲ་ཤིས་དཔལ་འབར་འཛམ་གླིང་ཡོངས་ལ་ཉི་མས་གླིང་བཞི་སྐོར་བ་ལྟར་ཁྱབ་པར་ཤོག་བཀྲ་ཤིས་པར་ཤོག།",
    "། བོན་དྲང་ངེས་དགོངས་དོན་གྱི་ཉམས་མགུར་ཁུ་བྱུག་དབྱངས་སྙན་བཞུགས། ། ཅི་པར་དེ་བ་ཌཱཀྐི་པ་ཏ་ཡ།",
    "དཔལ་ཆེན་པོ་ཀུན་མཁྱེན་ཤར་རྫ་པ།",
    "ཁྲི་ཉི་ཟླ་པད་མའི་གདན་ལ་བཞུགས།",
    "སྙན་གཏད་པའི་ངང་ནས་གསན་པར་ཞུ།",
    "ཞེས་གསུངས་པ་ལྟར་དུ་བདེན་པ་ཆེ།",
    "གནས་རི་ཁྲོད་བཞུགས་སྟངས་འདི་ལྟར་དགོས།",
    "སེམས་བཟུང་ཐབས་ཉམས་ལེན་རིམ་པར་སློབས།",
    "ཉམས་མཉམ་པར་བཞག་ན་མཉམ་བཞག་ཟེར།",
    "ལོ་བརྒྱ་རུ་བསྒོམས་ཀྱང་ཟད་པར་སྐྱེ།",
    "གནས་དགའ་དང་འགྱུ་སྡུག་མེད་པར་དགོས།",
    "དེ་ཡེ་ཤེས་མེ་རུ་འབར་བར་གསུངས།",
    "བསྐྱེད་རྫོགས་ཀྱི་དམ་ཡེ་ཤེས་པར་བྱ།",
    "ལྷ་ཐེར་གཟུགས་རགས་བསྐྱེད་མ་ཡིན་པར།",
    "ལྷ་སྔགས་ཀྱི་ཏིང་འཛིན་ཁྱེར་སོ་གསུམ།",
    "ཡུལ་གར་བསྡད་གཞི་བདག་གང་ཡིན་ལ།",
    "དམ་འགལ་ན་འབྲས་བུ་འཚིག་པར་བཤད།",
    "དོན་དམ་པར་ཡིན་ནམ་ཀུན་རྫོབ་ཡིན།",
    "མང་དུ་མར་རྒྱལ་བ་གོང་མས་གསུངས།",
    "གཙང་བཙོག་པ་མེད་པའི་ལམ་འཁྱེར་དེ།",
    "དགེ་སྦྱོར་གྱི་བར་ཆོད་ཆེ་སྡིག་གསུངས།",
    "གྲོགས་ཁྱེད་ལ་གསང་ཚིག་མེད་པར་བཀྲོལ།",
    "དུས་རྒྱུན་པར་ཉམས་ལེན་འདི་ལ་གཟོབས།",
    "བར་མེད་ཟོལ་སོགས་མེད་པར་འབད།",
    "ཞི་གནས་ཏིང་འཛིན་གོམས་པར་མཛོད།",
    "འདི་ཞེས་ངོས་བཟུང་མེད་པར་དགོས།",
    "འགལ་འཁྲུལ་སྐྱབས་གནས་གཉིས་ལ་བཤགས།",
    "། ཞུ་གཡས་ལེགས་པོའི་བསྟོད་པ་བཞུགས། ། ཨེ་མ་ཧོ།",
    "དྲུག་ཅུ་རྩ་གཅིག་ཧ་ར་མཁྱེན་པའི་བདག།",
    "བཀྲ་ཤིས་པར་ཤོག་ཞུས་སོ།",
    "གང་འདུལ་རྣམ་རོལ་མཁྱེན་བརྩེ་ནུས་པའི་གཟུགས།",
    "རྣམ་མཁྱེན་རྒྱལ་བའི་ཐུགས་རྗེའི་འོད་ཟེར་བཅུད།",
    "རྣམ་མཁྱེན་གཤེན་རབ་ཐུགས་ཀྱི་ཀློང་དཀྱིལ་ནས།",
    "དུན་ཙེ་པར་བུའི་མགོ་ཅན་ལ་སོགས་བསྒྲལ།",
    "དབྱིངས་ཀྱི་ལྷ་ལྔ་དབུ་ལ་བཞུགས་པའི་བརྡའ།",
    "མ་རུང་འདུལ་ཕྱིར་ཁྱུང་ཆེན་ཁྲི་ལ་བཞུགས།",
    "དབལ་གྱི་རྭ་ཡིས་ལོག་འདྲེན་བརླགས་པར་བྱེད།",
    "ཞལ་ནི་གནམ་སར་ངོམ་པས་རྒྱལ་འགོང་བཞེས།",
    "རྫོགས་སྐུའི་མཚན་རྟགས་བརྒྱད་ཅུས་སྤྲས་པ་བཞུགས།",
    "རྟེན་བརྒྱད་མི་ཡུལ་གདུལ་བྱའི་དོན་ལ་བཞུགས།",
    "བཀའ་གཏེར་མགར་སྟོན་ཁྲོ་རྒྱལ་ཡབ་སྲས་གནང་།",
    "རྟེན་འདི་ཞུ་གཡས་ལེགས་པོར་ལྷ་སྐལ་བབས།",
    "གངས་ཅན་འདྲེན་པའི་ལྷ་སྐལ་རྒྱ་མཚོའི་དབུས།",
    "ཕན་པར་བྱེད་པ་ལ་ནི།",
    "ཞེས་གསུངས།",
    "ཁྱད་པར་རྟེན་འདི་ཟོལ་པོས་བསྟོད་འདོད་ཙམ་མ་ཡིན་ཏེ།",
    "བསླུ་བ་མེད་པའི་རྟེན་མཆོག་ཁྱད་པར་ཅན་ཡིན་ནོ།",
    "དེ་ལྟར་ལྷ་སྐལ་རྟེན་མཆོག་ཞི་བར་འགྱུར།",
    "གངས་ཅན་འདྲེན་པའི་ལྷ་སྐལ་རྒྱ་མཚོའི་དབུས།",
    "ཞེས་གསུངས།",
    "ཀུན་མཁྱེན་འཇའ་ལུས་ཤར་རྫ་པ་ཆེན་པོའི་རྒྱལ་ཚབ་བློ་གྲོས་རྒྱ་མཚོའི་ཞལ་སྔ་ནས།",
    "ཞེས་མཁས་གྲུབ་གཉིས་ལྡན་གྱི་སྐྱེས་བུ་དུ་མའི་ཞལ་ལུང་ལ་ཡིད་རྟོན་པར་རིགས་སོ།",
    "ཀུན་མཁྱེན་ཤར་རྫ་ཆེན་པོ་ལ་གསོལ་བ་འདེབས།",
    "སྤངས་རྟོགས་ཡོན་ཏན་ལྷུན་རྫོགས་མཁྱེན་པའི་གཏེར།",
    "བསྟན་འགྲོའི་ཕན་བདེ་པད་ཚལ་བཞད་པར་མཛོད།",
    "མཁའ་ཟླ་ཆུ་ཟླའི་ཚུལ་བསྟན་རྣམ་པར་འཕྲུལ།",
    "གཡུང་དྲུང་གཙུག་གཤེན་རྒྱལ་བའི་རྣམ་པར་ཐར།",
    "བསྐལ་པས་མ་འཇིག་ཞབས་པད་བརྟན་པར་ཤོག།",
    "བཀྲ་ཤིས་པར་ཤོག།",
    "གཡུང་དྲུང་འོད་གསལ་གླིང་པར་གསོལ་བ་འདེབས།",
    "མངའ་བདག་དྲི་མེད་མཁྱེན་བརྩེ་ནུས་པའི་གཟུགས།",
    "གཡུང་དྲུང་འོད་གསལ་གླིང་པར་གསོལ་བ་འདེབས།",
    "གཡུང་དྲུང་འོད་གསལ་གླིང་པར་གསོལ་བ་འདེབས།",
    "གཡུང་དྲུང་འོད་གསལ་གླིང་པར་གསོལ་བ་འདེབས།",
    "གཡུང་དྲུང་འོད་གསལ་གླིང་པར་གསོལ་བ་འདེབས།",
    "འཕོ་འགྱུར་མེད་པར་ཞབས་པད་རྟག་བརྟན་ཤོག།",
    "བཀྲ་ཤིས་པར་ཤོག་ཞལ་དྲོ།",
    "ལྷག་པའི་བསླབ་གསུམ་རྒྱུད་ལ་རྫོགས་པར་ཤོག།",
    "ཡོན་ཏན་བློ་གྲོས་རིག་རྩལ་མཁྱེན་པའི་ཕྱིར།",
    "བཀྲ་ཤིས་པར་ཤོག་ཞུས་སོ།",
    "འཕོ་འགྱུར་མེད་པར་ཞུ་ཡི་གདུང་རབས་འཚོ།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་དགེ་མཚན་གསོལ།",
    "རྒྱལ་བསྟན་གསལ་བྱེད་ཀུན་མཁྱེན་ཤར་རྫ་པའི།",
    "རྣམ་འདྲེན་སྐལ་བཟང་གྲགས་པར་གསོལ་བ་འདེབས།",
    "མཐར་ཐུག་སྐུ་གསུམ་ས་ལ་འཁོད་པར་ཤོག།",
    "རྒྱལ་ཀུན་སྤྱི་གཟུགས་བླ་ཆེན་དྲན་པ་མཁྱེན།",
    "འདི་ཕྱི་བསམ་དོན་མ་ལུས་འགྲུབ་པར་མཛོད།",
    "རྒྱལ་བའི་ཞིང་ཤར་བསྟན་འགྲོ་ཁྱད་པར་འཕགས།",
