    "རྡོ་ཏིང་བཅས་ནི་བསྐལ་པ་ཡ་ཐོག་དུས་ཀྱི་རོལ་ཆ་ཡིན་པ་རིག་པས་དཔྱད་ཐུབ།",
    "བསྐལ་པ་ཡ་ཐོག་དུས་སུ་ཐོག་མར་གནའ་མི་རྣམས་ཀྱིས་གཅན་གཟན་རི་དྭགས་དང་།",
    "ཡང་རང་རྒྱལ་གྱི་ཧྲང་རྒྱལ་རབས་ཀྱི་དུས་སུ་བྲན་གཡོག་བདག་པོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ནི་ལྷ་ཡི་སྲས་པོ་ཡིན་ཟེར་བ་དང་།",
    "གཉའ་ཁྲི་བཙན་པོ་དེ་སྤོ་པོའི་ཡུལ་ནས་བྱོན་པ་དེ་དོན་དངོས་དང་མཐུན་པ་ཞིག་འདུག་སྙམ།",
    "སྤོ་མི་རྣམས་ཀྱིས་བོད་ཀྱི་ས་གནས་གཞན་ལ་གནས་པའི་བོད་མི་རྣམས་ལ་སྤྲོ་བུ་ཞེས་འབོད་སྲོལ་འདུག་དོན་འདིའི་ཐོག་ནས་ཐོག་མར་བོད་རིགས་ཀྱི་འབྱུང་ཡུལ་ནི་སྤོ་བོའི་ཡུལ་ནས་ཡིན་པ་གསལ་པོ་མཐོང་ཐུབ།",
    "ད་ལྟ་ཁྱུང་པོ་སྟེང་ཆེན་ཁོངས་ཀོ་བོ་དགོན་གྱི་ལྡེབས་རིས་སུ་གདན་ས་དེ་ཆགས་ཚུལ་གྱི་དཀྱིལ་འཁོར་ཞིག་དངོས་སུ་མཇལ་རྒྱུ་ཡོད་པས་མཐོང་བ་ཙམ་གྱིས་ཧ་ལས་དགོས་པ་ཞིག་འདུག།",
    "ལྷ་འི་དཀོར་མདུང་རང་འདེབས་དང་།",
    "སྐྱེ་འཆི་དང་སྡུག་བསྔལ་གང་བྱུང་ཡང་རང་ཉིད་གཅིག་པུས་མྱོང་དགོས་ཞེས་བཀའ་ཡང་ཡང་བསྩལ།",
    "སོ་སོ་སྐྱེ་བོ་མི་བརྗེད་པའི་གཟུངས་མ་ཐོབ་པ་རྣམས་ལྷག་ཆད་དུ་འདོན་པར་འདུག་ནས།",
    "སྲོག་ཆགས་དང་རྩི་ཤིང་མེ་ཏོག་ལ་སོགས་སློབ་དཔོན་མ་བསྟེན་ཡང་རང་བཞིན་གྱིས་གཟུགས་སུ་ཐོན་པ་འབྲི་མཁྱེན་པ་དང་།",
    "བཟོ་མཐའ་མ་འདྲེས་རང་རང་བརྒྱུད།",
    "འོན་ཀྱང་དེང་སྐབས་བོད་ཡིག་ག་དུས་གསར་གཏོད་བྱས་མིན་དང་།",
    "སྔོན་དུས་བོད་ཀྱི་རྒྱལ་པོ་ལ་སྐུ་བོན་བྱ་བ་ཞིག་འདུག་པ་དེ་མདུན་ན་འདོན་གྱི་ཚོད་ཙམ་ཡིན་ཟེར།",
    "དེས་ན་རྒྱ་བཟའ་ཀོང་ཇོའི་ཐུགས་ན་བོད་ཡུལ་འདི་ཁྱད་དུ་འཕགས་པ་ཞིག་འདུག་སྙམ་ནས་བོད་ལ་བྱོན་རྒྱུའི་ཞལ་བཞེས་སོ།",
    "ལོར་རྒྱལ་སྲིད་འཛིན་པ་ནས་བཟུང་རང་འགུལ་གྱིས་མཐོ་བོད་ལ་ཕོ་ཉ་མངགས་ཏེ་མཛའ་མཐུན་གྱི་འབྲེལ་བ་བཙུགས་པ་མ་ཟད།",
    "བྱིངས་དང་མིང་ངམ་རྟགས་གང་ཞིག་ཡིན་རུང་རང་བཞིན་དུ་བྱ་དགོས་ཟེར།",
    "ཁོལ་རྟ་རྣམས་ཀྱང་རང་སར་བསྒྱུར་ཏེ་དམག་མི་ལྷག་མ་རྣམས་ཕྱིར་བྲོས།",
    "སྣ་ནམ་བཟའ་སྔར་བས་ཞེ་སྡང་སྐྱེས་ནས་ཀོང་ཇོ་ལ་བློ་ཉེ་བའི་ཚུལ་བྱས་ཏེ་ལྷ་སྲས་ཚུར་འཕྲོག་ང་རང་ལ་སྐྱེས་པ་ཡིན་ནོ་ཟེར་བསྙོན་བྱས།",
    "བོད་འབངས་ཁག་གཅིག་ཀྱང་དོགས་པར་གྱུར་ནས་ཁ་ལོག་དུས་དེར་བཙན་པོས་སྦ་གསལ་སྣང་དང་སྦ་སང་ཤི།",
    "པདྨའི་སྡོང་པོ་ཞིག་སྐྱེས་པའི་ནང་དུ་ཁྱེའུ་ལོ་བརྒྱད་ལོན་པའི་ན་ཚོད་ཞིག་འཁྲུངས་ནས་འདུག་པ་དང་།",
    "འདི་ནི་སྤྲུལ་པའི་སྐུ་ཞིག་འདུག་པས།",
    "དེ་ལ་ཀླུ་གཏེར་འཇུག་དགོས་པར་འདུག་གསུངས་པ་ལྟར།",
    "པ་གོར་བེ་རོ་ཙ་ན་རྐང་མགྱོགས་བྱ་དང་མཉམ།",
    "རྩི་ཤིང་རང་སྡུད་བྱེད་པའི་གཙོ་གྱིམ་བུ་ཚོ།",
    "ནུབ་བ་གླང་སྤྱོད་ཀྱི་གླིང་གསུམ་ཟླུམ་པོ་ལ། ༡བི་རོ་ཙ་ནའི་གླིང་ན།",
    "པ་གོར་ཧེ་འདོད་ཀྱི་བུ་བི་རོ་ཙ་ན།",
    "དེ་ནས་བི་རོ་ཙ་ན་དང་།",
    "པ་གོར་བི་རོ་ཙ་ནི་མུ་མཐུད་རྒྱ་གར་འཕགས་པའི་ཡུལ་དུ་སློབ་དཔོན་གྱི་དྲུང་ནས་མན་ངག་རྒྱ་མཚོའི་ཀློང་དང་།",
    "བེ་རོ་ཙ་ནས་རྐང་མགྱོགས་བསྒྲུབས་པས་ཞག་བདུན་ནང་ཕེབས།",
    "བསྟེན་ནས་སྤུང་ངོ་༢་ བ་རོ་ཙ་ནའི་ན་བཟ་ཁོགས་ཏེ་ཟངས་ཁ་གྱུར་དུ་བཅུག་སྟེ་ཆུར་བསྐར།",
    "པ་གོར་ཧེ་འདོད་ཀྱི་བུ་བི་རོ་ཙ་ན།"
  ]
}