    "དུ་བརྒྱལ་༢༤ཞིང་འདུག་པར་འགྱུར་བས་ཁྱེད་ཀྱིས་དེ་དག་བཟའ་བར་མི་བྱའོ།",
    "ཚོང་ད་པོན་དེ་ཡང་དེ་ཉིད་ཀྱི་བསྔགས་པ་བརྗོད་༧ཅིང་འདུག་སྟེ་ཤེས་ལྡན་དག་དེད་དཔོན་བྱི་དབྱིག་པ་དེས་རྩྭའམ་༨།",
    "ཡང་རི་བྲགས་ཤིག་༡ན་ཕག་འཚོང་ཞིག་འདུག་སྟེ།",
    "མཐའ་གཅིག་༢ཏུ་འདུག་ནས་འཚོ་བྱེད་གཞོན་ནུས་གསོས་ཀྱིས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ་༢༡།",
    "ཇི་ལྟར་སེམས་མཉམ་པར་བཞག་༢༦ན་དགེ་སློང་སྟོང་ཉིས་བརྒྱ་ལྔ་བཅུ་སྤྲུལ་ཏེ་འདུག་གོ།",
    "འཚོ་བྱེད་གཞོན་ནུས་གསོས་རྒན་པའི་མཐའ་ལོགས་ན་འདུག་པས་༢མཐོང་ནས་དེས་བསམས་པ།",
    "གཅིག་ཅིག་༢འདུག་པ་དེས་ཀྱང་དེ་ལ་བཟོས་བསྙེན་བཀུར་བྱས་པས་དེ་ལ་ཆུང་མས་སྨྲས་པ།",
    "ཤེས་ལྡན་དག་ངས་ཡུན་ཇི་སྲིད་ཅིག་ཏུ་འདིར་ཞུགས་ཏེ་འདུག་པར་བྱ།",
    "འདི་ཉིད་དུ་འཁོད་དོ་སྙམ་ནས་མཉན་ཡོད་དང་ཧ་ཅང་མི་རིང་བ་ན་ཀུན་དགའ་ར་བ་ཞིག་འདུག་པ་དེར་དེ་དག་དོང་ངོ།",
    "སྒོ་མ་བཅད་པར་འདུག་པ་དང་།",
    "དབྱར་ཁང་འདུག་པ་དང་།",
    "འདི་ལྟར་འདས་པའི་དུས་ན་ཡང་འདིས་དོན་མཐུན་མང་པོ་སེང་གེའི་འཇིགས་པ་ལས་ཡོངས་སུ་བསྐྱབས་པར་གྱུར་ཏེ་དེ་ཉོན་ཅིག་དགེ་སློང་དག་སྔོན་བྱུང་བ་འདས་པའི་དུས་ན་རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "མཉན་ཡོད་ན་ཚོང་དཔོན་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་དགའ་བར་བྱེད་༡༧།",
    "མདུན་དུ་འདུག་ནས་དེས་༡༧དེའི་སྣམ་སྦྱར་དེ་ལ་ཡང་དང་༡༨ཡང་དུ་རྟོག་༡༧ན་ས་དགེ་སློང་དེས་སྨྲས་པ།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་ལྷན་ཅིག་གནས་པ་འདུག།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་དགེ་ཚུལ་འདུག།",
    "དེའི་འོག་ཏུ་ད་གའ་བོའི་ལྷན་ཅིག་གནས་པ་འདུག།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་དགེ་ཚུལ་འདུག།",
    "སྐྱེ་བོ་ཕལ་པོ་ཆེའི་ཚོགས་ཀྱི་ན་ང་དུ་ཞུགས་ཤིང་འདུག་གོ།",
    "ཆེ་དང་ལྡན་པ་འཆར་ཀ་ཁ་ན་ང་དུ་བལྟས་ཏེ་འདུག་གོ།",
    "དེའི་ཚེ་ན་བཙུན་པ་འཆ་ར་ཀ་དེ་ཉིད་ན་འདུག་པར་གྱུར་ཏམ་འདུག་གོ།",
    "སྦེད་མ་དགེ་སློང་མའི་དབྱར་ཁང་ན་ཕྱག་དར་བྱེད་ཅིང་འདུག་པ་དེས་ཚེ་དང་ལྡན་པ་འཆར་ཀ་ཐག་རིང་པོ་ཁོ་ན་ནས་མཐོང་སྟེ་མཐོང་ན་ས་ཀྱང་འདི་སྐད་ཅེས་སྨྲས་༢༡ས་སོ།",
    "གང་ཚུན་ཆད་ཁྱེད་ཅག་བསོད་སྙོམས་ལ་དོང་བ་དེ་ཚུན་ཆད་ནས་སྦེད་མ་མ་འདུག་པ་དེ་ནི་བདེན་ཏེ་༢༡།",
    "ཤར་གྱི་ཀུན་དགའ་ར་བ་ན་རི་དགས་འཛིན་གྱི་མའི་ཁང་བཟངས་༤ན་འདུག་ག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་འོད་སྲུང་ཆེན་པོ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེའི་ཚེ་ན་མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ལ་ཡུན་རིང་པོ་ནས་སྨོན་པ་འདི་ལྟ་བུ་༐",
    "འཛེགས་ཏེ་སྟན་བཤམས་༢པ་ཉིད་ལ་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ན་ས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་འོད་སྲུང་ཆེན་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ལས་ཀྱི་མཐའ་གཉིས་བྱེད་དུ་འཇུད་༡དེ་ཚོང་དང་།",
    "ཕྱོགས་འདི་གོ་སྐབས་དབེན་པ་ཡིན་གྱི་༥འདི་ཉིད་དུ་འདུག་པར་བྱའོ་སྙམ་ནས།",
    "དེས་དེ་ཉིད་དུ་འདུག་པར་བརྩམས་ཏེ་མཉན་ཡོད་དུ་བསོད་སྙོམས་བརྒྱུས་ནས་དེ་ཉིད་དུ་གནས་འཆའོ།",
    "ཁོ་བོས་༢༤ཞིང་དེའི་དྲུང་དུ་སྤྱིལ་བུ་བྱས་ཏེ་སྤྱིལ་བུ་དེར་དགེ་སློང་བསོད་སྙོམས་པ་ཞིག་འདུག་པས་དེའི་མཐུས་ཞིང་༢༤དེ་ཤིན་ཏུ་ལོ་ཐོག་༢༤ཕུན་སུམ་ཚོགས་པར་གྱུར་ཏོ།",
    "ཡང་ཡང་དང་ནི་འདུག་༡༡གནས་གཅིག།",
    "རྒྱལ་པོའི་ཁབ་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "མཐོང་ནས་ཀྱང་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ་༡གསོལ་པ།",
    "རྒྱལ་པོའི་ཁབ་ན་ཚོང་ད་པོན་བུ་མེད་པ་ཞིག་དུས་ལ་བབ་ན་ས་ནོར་ཅན་དག་དང་།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས།",
    "དེ་ནས་ཁྱིམ་བདག་དྲག་ཤུལ་ཅན་བསོད་སྙོམས་པ་དེའི་མདུན་༢༢དུ་འདུག་པ་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེའི་ཀུན་དུ་སྤྱོད་པ་ནི་ཚེས་བརྒྱད་དང་།",
    "རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་གཅིག་འདུག་པ་དེས་ཕྱོགས་བཞིའི་དགེ་སྦྱོང་དང་།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་དོན་དུ་འདུག་གནས་བྱེད་དུ་བཅུག་སྟེ།",
    "དེ་འདུག་གནས་དེ་ན་ཕྱོགས་བཞིའི་དགེ་སྦྱོང་ད་ང་།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་དོན་དུ་འདུག་གན་ས་བགྱིད་དུ་སྩལ་བ་དེར་བཞུགས་༡༨ཤིག་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་དད་པ་ཅན་ཞིག་འདུག་པ་དེ་ཟོང་ཐོགས་ཏེ།",
    "ཇི་ཙམ་ན་གཅེར་བུ་པ་ངོ་ཚ་དང་ཁྲེལ་བོར་བ་ཤ་སྟག་ཡིན་པར་མཐོང་ནས་མངོན་སུམ་དུ་མི་སྙན་པ་བརྫོད་པ་ནི་སྡུག་བསྔལ་༩བ་ཡིན་པས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལངས་ཏེ་༡སོ་ཤིང་བོར་ནས་སྣམ་སྦྱར་དམར་སེར་གྱོན་ཏེ་རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་སྒོ་ན་འཆ་ག་ཅིང་འདུག་གོ།",
    "ཁྱིམ་བདག་དེས་དེར་གན་ས་མལ་བཙལ་ནས་ཁྲི་དང་ཁྲིའུ་དག་འདུག་གན་ས་དེར་བསྐུར་༢༢རོ།",
    "འདུག་གནས་ཀྱང་མ་ཡིན་ན་ཁྱེད་ཅག་འདིར་གར་འཇུག།",
    "འདུག་གན་ས་ཀྱང་མ་ཡིན་ནོ་ཞེས་མ་ཟེར་ཅིག།",
    "གལ་ཏེ་འདུག་ན་ནི་འདུག་ཏུ་ཟད།",
    "ཁྱིམ་བདག་དེ་ཡང་གནས་ཁང་དུ་ཞུགས་ཏེ་འདུག་པ་དང་།",
    "འདི་ལྟར་གང་དེ་ན་འདུག་པ་དེ་ལ་བདག་བསོད་སྙོམས་ཀྱིས་མཁོ་བ་སྟོབས་པར་༐",
    "མངོན་སུམ་དུ་མི་སྙན་བརྗོད་༡པ་ནི་སྡུག་བསྔལ་༢བ་ཡིན་པས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ན་ས་བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བ་ན་༢༡རི་བྲགས་དེར་ཕྱིན་ནས་ཁྱིམ་བདག་དེའི་འདུག་གནས་སུ་ཞུགས་སོ།",
    "འདུག་ན་ས་ཁྱིམ་བདག་དེས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ལ་འདི་༡༧སྐད་ཅེས་སྨྲས་ས་སོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་དགེ་སློང་མི་ན་བས་བསོད་སྙོམས་གཅིག་བཟའ་བར་བྱའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་༦འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་༡༧དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ན་ས་༡༨།",
    "ཁུར་༡༧བ་དག་དུས་ཀྱིས་སྟོབས་པར་གྱུར་ལ།",
    "སྟན་གང་ལ་འདུག་པར་གྱུར་པའི་སྟན་དེ་ལས་༩ལངས་པར་གྱུར་༐",
    "སྟན་གང་ལ་འདུག་པར་གྱུར་པའི་སྟན་དེ་ལས་ལངས་པར་མ་གྱུར་པས་ཏེ།",
    "དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་༢པུར་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་༡༧དགེ་སློང་དག་དུས་མ་ཡིན་པར་བ་ཅའ་བ་དང་།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་ནག་པོའི་གཙུག་ལག་ཁང་ན་འབྲས་ཆན་༤སྐམ་པོ་རབ་ཏུ་མང་པོ་དག་བཏིང་ཞིང་འདུག་ག་གོ།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ན་ས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་༢༢བར་བྱེད། ༐",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་དང་།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་མ་ཡིན་པ་ན་འདུག་པས་དང་།",
    "ཞིག་འདུག་པ་༢དེ་དེ་ན་མི་རོ་མྱགས་པ་ཟའོ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "ཁ་ཟེར་བར་བྱེད་ནས་དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་༢༢པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཤེས་པ་ཅན་དགེ་སློང་རྣམས་༡ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་ཤིག་༡དང་།",
    "ཤེས་པ་ཅན་དེ་དགེ་སློང་རྣམས་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་པ་དང་།",
    "གསེར་གྱི་སྣོད་ན་འདུག་པའི་མར་མེ་ལྟ་བུ།",
    "འདུག་ཤིག་༡༧དང་སྦྱིན་ནོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གཙུག་ལག་ཁང་ལ་མ་ཀ་ན་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་༡བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་འད་ས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ་ཇི་སྲིད་དུ་བདག་ཅག་གསོན་པ་དེ་སྲིད་དུ་བསྟན་པ་ལ་གཅེས་པ་བསྐྱེད་པར་བྱས་༡༡། ༐",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ནང་ན་གནས་པའི་ཚེ་ཡང་ཞེས་བྱ་བ་ནི་འདུག་པའི་ཚེ་ཡང་ང་ངོ།",
