    "དེ་ལྟར་ཕྱི་ནང་གི་འཇུག་པའི་རིམ་པ་རྣམས་སོང་ནས།",
    "ཨོཾམཎི་པདྨེ་ཧཱུྃ་ཧྲཱི་བུདྡྷ་ལོ་ཀེ་ཨྰ་ར་བཛྲཨ་ཉྩིའིཝཱམི།",
    "གཟུགས་ཀྱིཕུང་པོ་རྣམ་སྣང་གི་ངོ་བོར་གནས་གྱུར།",
    "ཐལ་མོ་སྦྱར་ཏེ་གསོལ་བཔ་འདིའི་རྗེས་ཟློསམཛོད།",
    "རྐང་འོག་ཏུ་འཁོར་ལོ་བཞག་ཅིང་དུང་དང་གླེགས་བམ་གཏད་པས་བདེ་སྟོང་ཟུང་འཇུག་གི་ངང་ནས་གཞན་དོན་བྱེད་པའི་གནང་བ་ཐོབ་པར་གྱུར་སྙམ་པའི་མོས་པ་མཛོད།",
    "ཕྱག་རྒྱ་སྐུའི་དམ་ཚིག་གསུམསྦྱིན་པས་ཕྱི་ནང་གི་རྡོར་དྲིལ་ཁ་སྦྱོར་ལས་བྱུང་བའི་བདེ་སྟོང་གིསརྒྱུད་གང་བས་དོན་གཉིས་སྒྲུབ་པའི་ནུས་པ་ཁྱད་པར་ཅན་བཞག་ཅིང་།",
    "ཆུའི་ལྷག་མ་སྤྱི་བོར་འཁྱིལ་བ་ལས་རིགས་ཀྱི་བདག་པོས་དབུ་བརྒྱན་པ་ལ་ནམ་མཁར་བཞུགས་པའི་གདན་གསུམཚང་པའི་ལྷ་ཐམས་ཅད་ཀྱང་ཐིམ་པར་གྱུར་པ་ལ་དཀྱིལ་འཁོར་གྱི་ལྷ་དང་སློབ་དཔོན་ལྷན་ཅིག་པས་ཤིས་བརྗོད་ཀྱི་མེ་ཏོག་གཏོར་བས་རབ་ཏུ་གནས་པོར་བྱས་པའི་མོས་པ་མཛོད།",
    "ཁྱེད་རང་པརྣམས་དཀྱིལ་འཁོར་གྱི་གཙོ་འོང་གསལ་བར་གྱུར་པ་ལ་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་མར་མེ་གཅིག་ལས་གཉིས་ཆད་ལྟང་བྱོན་ནས་རང་རང་གི་བསྐར་གནས་སོ་སོར་ཐིམ་པས་ཅིར་སྣང་ལྷ་བཁྱེན་སྐུ་སྒྱུ་མ་ལྟ་བུའི་རོལ་པས་རང་གཞན་གྱི་དོན་སྒྲུབ་པའི་ནུས་པ་ཁྱད་པར་ཅན་ཐོབ་པའི་མོས་པ་མཛོད།",
    "ཧྲཱི་ལྷ་མོ་ལྕགས་སྒྲོག་མ་ཡི་དཔང་།",
    "གཏུམ་མོའི་ཡེ་ཤེས་བསྐྱེད་དུ་གསོལ།",
    "བུ་ཁྱོད་ཀྱིས་བརྟེན་གཉིས་འཛིན་གྱི།",
    "ཐབས་འདི་ལ་བརྟེན་ནས་བདེ་ཉི་ཤུ་སྟོང་གི་ཡེ་ཤེས་མངོན་དུ་བྱའོ་སྙམ་པ་ཚོས་ཀྱི་འདུ་ཤེས་ཏེ།",
    "སྟེ་དེ་ལྟར་བདེ་གསལ་གྱི་ངང་དེར་རང་རིག་པའི་ངོ་བོ་ལ་ཆེར་གྱིས་ལྟོས་ལ་བསས་བཞག་གི་སོམ་བསླད་པར་རང་བབས་སུ་ཤིགསས་ཞོག་ཅིག།",
    "དེའི་དོན་ཚིག་གིས་ངོ་སྤྲད་པ། ། ཅན་འཇིགའདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "བརྗོད་ཐལ་སྟོང་གསལ་ཡེ་ཤེས་ལྔའི།",
    "འཇམ་མཛེས་ལས་དང་ཉོན་མོངས་ཐལ།",
    "ཟང་ཐལ་ཡེ་ཤེས་རྒྱུན་ཆད་མེད།",
    "སེམས་ཉིད་གཉུག་མའི་གཤིས་གང་ངུའང་མ་གྲུབ་པའི་རང་སངས་རང་རིག་སེམས་བྱུང་གི་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བ་རྩེའིརྣམ་པར་མི་རྟོག་པ།",
    "ལ་བ་ནམ་མཁའ་དངས་པའི་དཀྱིལ་ལྟ་བུ་དེ་ནི་རང་བྱུང་གི་མཀལའཡེ་ཤེས་ཏེ་དབཔའི་ཡེ་ཤེས་ཡིན་ནོ།",
    "དེ་ལྟར་ལེགས་པར་ཐོབ་པའི་གཏང་རག་གི་དོན་དུ་མཎྜལ་ཕུལ་མཛོད།",
    "ཅེས་མཎྜལ་ཐལ་དུ་བཅུག།",
    "བདག་གིས་བླ་ནམེད་པའི་རྣལ་འབྱོར་མཆོག།",
    "རཾ་ཡཾ་རཾ་གིས་རྩེའི་བསང་སྦྱང་།",
    "འཁོར་ལོ་རྡོ་རྗེ་མེ་ཕུང་གིས།",
    "ཨོཾཨཱ་དྷཱཝ་ཤུདྡྷ་སརྦདྷཎ་སཱདྷུཝ་བུདྡྷེཧཾ།",
    "རལ་པའི་ཐོར་ཚུགས་སུམ་བརྩེགས་ཀྱི་རྩེ་མོར་སྣང་བ་མཐའ་ཡས་ཀྱི་ཞལ་ཕྱུང་བ།",
    "སྐུ་སྨད་དར་འཇའ་རིས་ཀྱི་ན་བཟའ་ཞབས་ལ་པ་པདྨའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པཞེས་གསལ་གདབ་གཉིས་ལཔའི།",
    "འགྲོདྲུག་སྡུག་བསྔལ་ཐུགས་རྗེས་གཟིགས",
    "དམ་ཚིག་གི་འཁོར་ལོ་དང་རོ་གཅིག་ཏུ་གྱུར་བར་བསམ།",
    "ཐུགས་རྗེའི་སྤྱན་གྱིས་འགྲོ་ལ་གཟིགས།",
    "དེ་ཀུན་ཁྱོད་ཀྱིས་བཟོད་མཛད་རིིགས།",
    "མངུན་དུ་པུདྨ་འདབ་དྲུག་གི་ལྟེ་བར་ཧྲཱི་དང་འདབ་མ་དྲུག་ལ་ཡིག་དྲུག་རྡེའི་ཕྱག་མཚན་གྱིས་བསྐོར་བའི་ཙོ་ཀྶཾ་རྒྱབ་ཏུ་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་སྐོར་གྱི་གླེགས་བམ་དང་ཤེལ་ཕྲེང་།",
    "མེ་ཏོག་གི་སྣོད་གཉིས་པ་ལ་གཉིས།",
    "གཡོན་གནམ་ལྕགས་ཀྱི་ཕུར་བུ་འདྲིལ་བདུར་ཁྲོད་ཀྱི་ཆས་བརྒྱད་ཀྱིས་བརྒྱན་པའི་གནས་གསུམ་ངུ་ཨོཾ་ཨཱ་ཧཱུྃ་གིས་མཚན་པ་ལས་འོད་ཟེར་འཕྲོས།",
    "ཐུགས་ཀར་ཉི་མའི་སྟེང་དུ་ཞཱི་ཡིག་དམར་པོའི་མཐར་སྔགས་ཕྲེང་གིས་བསྐོར་བ་ལས་འོད་ཟེར་འཕྲོས།"
  ]
}