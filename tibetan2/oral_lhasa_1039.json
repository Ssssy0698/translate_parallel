    "ཕྲན་རླངས་འཁོར་གྱི་མཁྲིས་དེར་བསྡད་ཡོད་པས་མིག་དམར་བཀྲ་ཤིས་ཀྱིས་རླངས་འཁོར་གྱི་སྒྲོམ་སྐྱོར་སྟེང་ནས་སྒུར་སྒུར་ངང་མར་བལྟས་ཏེ་སྔོན་ནས་ང་གཉིས་ངོ་ཤེས་པར་རྟེན་མགོ་གཡུགས་ཙམ་བྱས་ཤིང་སྡོད་ཨཱ་ཟེར་བྱུང་།",
    "ལན་མ་སློག་ཚེ་བློ་ཕམ་འོང་རྒྱུར་རྟེན་ཡུན་ཙམ་ཅི་དྲན་མེད་པར་ལུས།",
    "བཙོན་པ་འདས་གསོན་གཉིས་ཀྱི་ཆེད་ལས་འགུལ་གྱི་དབུ་འཁྲིད་གནང་བ།",
    "བཅས་ཉལ་ཁང་སོ་སོ་ནས་བཏོན་ཏེ་རྐང་རྗེན་མར་ཆུ་རས་གཅིག་པུ་ལས་གྱོན་མ་བཅུག་པར་རྒྱུག་བཅུག་པ་དང་གློག་རྒྱུག་དང་།",
    "དེའི་ནང་ནས་བློ་བཟང་བསྟན་འཛིན་ལ་རྐང་ལྕགས་ཡོད་བཙོན་པ་འདས་གསོན་གཉིས་ཀྱི་ཆེད་ལས་འགུལ་གྱི་དབུ་འཁྲིད་གནང་བ།",
    "དེ་ལྟའི་མནར་གཅོད་དྲག་པོ་སང་ཉིན་ཞོགས་པ་ཆུ་ཚོད་བཞི་པར་གཞི་ནས་མཚམས་བཞག་ཙམ་བྱུང་།",
    "དེ་ནས་ངས་བཙོན་པའི་བཙོན་པ་འདས་གསོན་གཉིས་ཀྱི་ཆེད་ལས་འགུལ་གྱི་དབུ་འཁྲིད་གནང་བ།",
    "༣༡རས་ཀྱི་ཁ་གདན་དཀར་པོ་ཆེན་པོ་གཅིག་མར་བཤགས་ནས་བློ་བཟང་བསྟན་འཛིན་གྱིས་སྲིན་བལ་གྱི་སྨྱུ་གུའི་ཚབ་བྱས་ཏེ་སྣག་ཚ་ནག་པོས་ཡིད་སྐྱོ་བའི་ངང་ནས་འདས་པོ་ལྷག་པ་ཚེ་རིང་ལ་མྱ་ངན་ཞུ་ཞེས་དང་།",
    "བཙོན་པ་འདས་གསོན་གཉིས་ཀྱི་ཆེད་ལས་འགུལ་གྱི་དབུ་འཁྲིད་གནང་བ།",
    "འཆི་རྒྱུར་གྲ་སྒྲིག་བྱས་ནས་བསྡད་ཡོད།",
    "༤༡ཟུར་འཁྲིད་བྱས་ཏེ་དྲི་རྩད་བྱས།",
    "ཨ་རིའི་སྐུ་ཚབ་ཚོགས་པར་བདེ་སྡུག་ཡི་གེ་ཕུལ་བ།",
    "ངས་སྐུ་ཞབས་ཁོང་ཕེབས་གཏན་ཡིན་ནམ་ཞེས་དྲིས་ཨ་རིའི་སྐུ་ཚབ་ཚོགས་པར་བདེ་སྡུག་ཡི་གེ་ཕུལ་བ།",
    "བཙོན་པ་ཚང་མ་བསྡུ་སྐོང་བྱས་ཏེ་ཁ་ཤས་གཞས་གཏོང་བཅུག་པ་དང་།",
    "མཐར་ཐུག་དེ་འགྲུབ་པར་ཐག་མི་རིང་།",
    "དེ་རྗེས་ཤིག་ནས་མ་དང་མཉམ་དུ་རྡེ་ར་རྡོན་ཀ་ལ་མན་གྲེ་ཀྲའོ་རུ་གནས་སྤོས་བྱས་ནས་མ་སུ་རི་བོད་ཁྱིམ་དང་།",
    "ཁོ་པ་གྲྭ་བཞི་བཙོན་དུ་སྡོད་རིང་མི་རིགས་ཀྱི་ལ་རྒྱ་གཏིང་བརྗེད་ཀྱིས་རྒྱ་དམར་གྱི་རྒྱུག་ཁྱི་གསོན་པ་ཞིག་བྱས་ནས་ཆབ་སྲིད་བཙོན་པར་སྒོ་གང་ས་ནས་གནོད་པ་སྐྱེལ་བའི་གཏི་ཐུག་པའི་མི་ངན་ཞིག་ཡིན།",
    "ལོ་ཀས་ཅུད་ངལ་སྒྱུར་ཁང་དབུ་བརྙེས་པའི་ཉིན་གཉིས་པ་དེར་ཁོ་གཉིས་འདོམ་གང་གྲུ་བཞིའི་མུན་ཁང་ནས་གློད་ཀྱང་དེ་ནས་བཟུང་གཉིས་ཀའི་མིག་ཤེས་ལ་སྐྱོན་ཤོར་ཆེན་པོ་བྱུང་སྟེ་རང་ཉིད་ཀྱི་ཕོར་པར་ཡང་རྡོག་པས་རྫི་བ་དང་།",
    "བསྟན་པ་ཕུལ་བྱུང་ལགས།",
    "གང་ལགས་ཞེ་ན།",
    "སྤྱི་ལོ་༡༩༩༢ ཟླ་༨ ནང་སྐྱབས་བཅོལ་དུ་ཕེབས་ནས་ད་ལྟ་བལ་ཡུལ་དུ་བཞུགས་ཡོད།",
    "མ་འོངས་ཆབ་སྲིད་བཙོན་པའི་གནས་བབ་ཡར་རྒྱས་གཏང་དགོས་ཞེས་ངོ་རྒོལ་རྒྱ་ཆེར་བྱས།",
    "༨༥སྐུ་ཞབས་ཐུབ་བསྟན་ཚེ་རིང་ལགས་ནི།",
    "རྒན་ལགས་རྣམ་པས་གུས་པར་ཡིད་ཆེས་གནང་བ་ཐུགས་རྗེ་ཆེ།",
    "སླད་ཕྱིན་ངས་མ་འགྲིག་པ་བྱུང་ན་ཐད་ཀར་མདུན་དུ་སྐྱོན་བརྗོད་གནང་རོགས་ཞེས་བརྗོད།",
    "གཙང་སྦྲ་དོད་པ།",
    "གུས་པར་འོས་པའི་རྒན་བདག་ལགས།",
    "པར་འདི་རང་གཞུང་བདེ་སྲུང་ལྷན་ཁང་ནས་མཁོ་འདོན་གནང་།",
    "པར་འདི་རང་གཞུང་བདེ་སྲུང་ལྷན་ཁང་ནས་མཁོ་འདོན་གནང་།",
    "པར་འདི་རང་གཞུང་བདེ་སྲུང་ལྷན་ཁང་ནས་མཁོ་འདོན་གནང་།",
    "བློ་བཟང་བསྟན་འཛིན་ལགས་ནི།",
    "༡༩༦༦ ལོར་ལྷ་ས་སྦྲ་ནག་ཞོལ་དུ་། བོད་ཀྱི་དགུ་བཅུ་གསུམ་ལས་འགུལ་ཚོགས་པ་ནི་བཙན་རྒོལ་རྒྱལ་སྐྱོབ་ཀྱི་ལས་འགུལ་ནང་འཛུལ་ཞུགས་བྱས་ནས་བཙན་འཁྲུངས།",
    "བོད་ཀྱི་ཆབ་སྲིད་བཙོན་པའི་ཚོགས་པ་འདི་ཡི་མིང་ལ་གྱི་དབུ་ཁྲིད་གནང་བས་འདོམ་གང་གྲུ་བཞིའི་མུན་ཁང་དུ་ཟུར་བཅུག་ཐེངས་བཞི་དང་ལོ་གཅིག་དང་ཟླ་བ་བརྒྱད་བོད་ཀྱི་དགུ་བཅུ་གསུམ་ལས་འགུལ་ཚོགས་པ་ཞེས་ཟེར།",
    "དེ་གསུམ་གྱི་མི་སྣ་ངེས་པར་ཚང་དགོས་པ་སོགས་ཀྱི་ཆ་རྐྱེན་གང་ཡང་མེད།",
    "གང་ལྟར་ཤར་ཡང་དོན་ལ་བདེན་པར་མ་གྲུབ་པ་སྟེ།",
    "ཞེས་གསུངས་པ་དེ་ནི་གང་ཟག་གཅིག་ཙམ་མམ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཞེས་གསུངས་ཤིང་།",
    "དེ་ལྟ་བུའི་ལྷན་སྐྱེས་ཀྱི་མ་རིག་པ་དེ་ལས་ང་དང་བདག་ཏུ་འཛིན་པའི་རྣམ་པར་རྟོག་པ་ཤར།",
    "རང་སྣང་ལ་རང་སྣང་དུ་མ་ཤེས་པར་ཕྱིའི་ཡུལ་དུ་བཟུང་སྟེ།",
    "ཞེས་གསུངས་ལ།",
    "དོན་དམ་པར་ནི་ཡེ་གདོད་མའི་གནས་ལུགས་ཀྱང་སྐུ་གསུམ་དབྱེར་མེད་དུ་ལྷམ་མེ།",
    "མཐར་སྒྲིབ་བྱེད་སངས་ནས་མཁྱེན་གཉིས་རྒྱས་པའི་འབྲས་བུ་མངོན་དུ་གྱུར་དུས་ཀྱང་སྐུ་གསུམ་དུ་ལྷན་ནེར་བཞུགས་པ་ཉིད།",
    "ཐབས་གཞན་བསྟེན་ན་རྨོངས་པར་ཤེས་པར་བྱ།",
    "ཡོད་མེད་ཡིན་མིན་རྟག་ཆད་བཟང་ངན་མཐོ་དམན་ལ་སོགས་ཀྱི་སྒྲོ་སྐུར་མ་བྱས་པ།",
