    "དེ་ལྟར་ཕྱིས་བསྒྲུབ་པར་བྱ་བའི་འབྲས་བུའི་རིག་ལས་པར་བསྟན་ནས།",
    "དེནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདའ་བའི་ཉེས་པ་སྟེ་གསང་བའི་དོན་སྨྲས་པར་སྤྱནའོ།",
    "དེ་བས་ན་དེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཕྱག་རྒྱ་མི་ཤེས་པ་ལ་མི་བསྟུན་ན་དེ་ལ་ནམྷི་སུ་ལ་ཡང་བསྟན་པར་མི་བྱ་བར་འགྱུར་ཏེ།",
    "རྒྱུན་གྱིས་བརླབ་པ་ལ་སོགས་པ་བྱས།",
    "ཕྱིན་གྱིས་བརླབ་པ་ལ་ཕྱོགས་པ་བྱས་པ་བསླབ་པར་བྱའོ།",
    "ཞེསབྱ་བ་གསུངས་ཏེ།",
    "དེ་ལ་བ་ལྷ་དེའི་ལུས་བསྟན་པར་བྱ་བའི་ཕྱིརསམ་ཡསཱི་ཞེས་བརྗོད་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ཇི་ལྟར་བསམ་པར་བྱ་ཞེན།",
    "བདག་སེམས་དཔའི་ལུས་སུ་བསྒོམ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡིན་པར་མངོན།",
    "ཡང་དང་ཡང་དུ་གཅིག་ཏུ་བྱས་ནསམང་པོདཔྱོད་པ་དང་།",
    "དེ་བས་ན་འདི་པུཀྱི་ཕྱག་རྒྱ་ཆེན་པོའི་དབུས་ན་བཞུགས་པའི་ཕྱིར་དང་།",
    "དགྱེས་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "༥༢ ལུས་ཐོབ་པར་འགྱུར་རོ།",
    "དེབསྒྲུབས་པན་ཞེས་བྱ་བ་ནི་རིའི་ཕྱག་རྒྱ་ཆེན་པོ་བསྒོམས་པས་དེ་དང་མཚུངས་པར་གྱུར་རོ།",
    "དེ་བཅིངས་པས་ནཱ་ཞེས་བྱ་བ་ནིཔའི་ཕྱག་རྒྱ་ཆེན་པོ་བསྒོམས་པས་ཞེས་བྱ་བའི་དོན་ཏོ་ཁྱག་རྒྱ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་ཐམས་ཅད་གྲུབ་པ་འཐོབ་པར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "དེ་བས་ན་དེ་བསྟན་པར་བྱ་བའི་ཕྱིར་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེདག་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "མཐོ་བོ་གཉིས་ཀ་མཉམ་པར་གངས་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "འདི་སྒྲུབ་པར་བྱེདཔས་ན་སྒྲུབ་པ་སྟེ།",
    "དེའི་ཕྱིར་དམ་པ་ཡནི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེས་ན་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་སེམས་མའི་རྡོ་རྗེ་བཅིས་པསན་ཞེས་བྱ་བ་ལ་སོགསཔ་གསུངས།",
    "སྔགསཔ་རྡོ་རྗེ་སེམས་པའ་དང་མཚུངས་པར་འགྱུར་རོ།",
    "སེམསཅན་གྱི་དོན་གྱི་ཡུལམན་པར་འདོད་པ་སྐྱེད་པར་བྱེད་པའོ།",
    "རྡོ་རྗེ་འཁོར་པོ་བསྟན་བྱས་པས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཁོར་ལོའི་ཕྱག་རྒྱ་བཅིངས་པས།",
    "གཟུགས་བཟང་བ་ཉིད་འཐོབ་པར་འགྱུར་རོ།",
    "ཡེ་ཤེས་ཀྱི་སྣང་བ་ཡོངས་དག་པ་འཐོབ་པརའགྱུར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔར་འགྱུར་རོཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྔགས་པས་འདི་བརྗོད་ན་དེའི་ལས་ནོརྣལ་འབྱོར་མཉམཔར་འཇོག་པའི་ཚེ་འམ།",
    "ཡང་ནམས་ཀྱི་ལྟའི་དགའ་བ་འཐོབ་པར་འགྱུར་བའོ།",
    "༥༢ པར་འགྱུར་ཞེས་སྟོན་ཏོ།",
    "ཕྱག་རྒྱ་བཞིའི་ཡེ་ཤེས་བསླབ་པར་བྱའོ་ཞེ་གདུངས་པས།",
    "དེ་ནས་ལས་ཀྱི་འཇུག་པར་བྱེད་པ་པོ་ཞེས་སྟོན་པ་མིན་ནོ།",
    "ཛེ་རྗེ་མེད་ན་སེམས་ཀྱིས་ཀྱང་བསམ་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་བསྐྱིས་པའི་སྦྱོར་བ་དེས་ཀྱང་མགོ་གཡོན་དུ་འདུད་པས་འདུད་པར་བྱའོ།",
    "དེའི་ཕྱིརདེ་རྣམས་འགྲུབ་པར་འགྱུར།",
    "དེའབེབས་པར་སྲིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ཕྱགརྒྱཐམས་ཅདཀྱིཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མ་ཉིད་དུ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེནས་ནམཁའི་ཁམས་རྣམས་ལས་སས་རྒྱས་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེའི་དབྱིངས་གཞུག་པར་བྱའོ།",
    "དེས་ཡིས་དེ་ཉིད་ཀྱི་ཕྱག་རྒྱསབྱེན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཇི་སྐད་གསུངས་པ་ཕྱུགས་བརྗོད་པསསོ།",
    "ཞེས་གསུངས་པའི་ཕྱིརོ།",
    "ལན་འགའ་ཡི་ལོ་ལ་སོགས་པའི་སྐྱོན་གྱིས་བྱ་བམ་རྫོགས་པར་ཡང་བདག་ཉིད་གཏོང་བར་འདོད་པར་འགྱུར།",
    "དེ་ལྟ་བུསཏཱབདེ་འགྲོར་འགྲོ་བར་ཡང་རྙེད་པར་དཀའ་ན།",
    "བཟློག་པའི་ཆོ་ག་ཇི་ལྟར་འདོད་པར་ཞེས་བྱ་བསྟཅི་དགའ་བའོ།",
    "ཞེས་ཇི་སྐད་གསུངསཔ་ལྟ་བུའོ།",
    "བཅོམ་ལྡན་འདས་ཀུན་ཏུ་བཟང་པོས་གསུངས་ཞེས་བྱ་བ།",
    "ཁ་ཅིག་ག་དེ་ཉིད་ཀྱིས་སེམས་རྩེ་གཅིག་པར་འགྱུར་ད་དེའི་ཆོ་ག་ཡང་དེ་ཉིད་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་ངེས་པར་གཟུང་བསྟེ།",
    "རོའི་བསྡུས་པ་ནི་ཡང་དག་པར་བསྡུས་པ་སྟེ།",
    "དེ་ལྟར་བསྡུས་པ་ཡིན་པས་ན་རྡོ་རྗེརིན་ཆེནབླནམེདཔར་འགྱུར་ཏེ།",
    "དེ་བས་ན་འདིར་ཇི་ལྟ་ཞུགས་པ་དེ་རྣམས་ལ་དེ་དང་དེ་དགཉིད་ཀྱིས་ཆིམ་པར་བྱའོ།",
    "དམགུ་བར་བྱས་ཏེ་ཞེས་བྱ་བ་ནི་དགའ་བར་བྱས་པའོ།",
    "ཇིལྟར་སྦྱིན་པར་བྱ་ཞེ་ན།",
    "ཇི་ལྟར་ཞུས་པ་རྣམས་སླར་བཀྱེ་སྟེ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་སླར་བཟུང་བ་སྐྱོ།",
    "དེ་ནས་ཡང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་གསོལ་བ་གདབ་པར་བྱའོ།",
    "གང་དུ་དགྱེས་པར་གཤིགས་པར་བསལ་ཞིང་།",
    "༥༢ མཆོག་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་ཁྱད་པར་འདི་ཡོད་དོ།",
    "ཇི་ལྟར་ན་དེ་རྣམས་སླར་ཡང་སྙོམབ་པར་ཞུགས་པར་མཛོད།",
    "སྒྲུབ་པ་རྣམས་ཀྱང་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་གསུངས་པ་ཡིནནོ།",
    "དེ་དག་ལ་དགོད་པའི་སྔགས་ཀྱང་དེ་རྣམས་ཉིད་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་ནི་ཞེས་བྱ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་བྱསུ་དཀྱིལ་འཁོར་ཐམས་ཅད་བྲི་བར་བྱའོ།",
    "མཆོད་རྟེན་ཁྲི་ལ་ལེགས་ཕུག་པ་ཞེས་བྱ་བ་ནི་ཝིར་བྱས་པའི་སྟེང་དུ་མཆོང་རྟེན་བཤིག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་སློབ་དཔོན་ཉིད་དང་པོར་འཇུག་པར་བྱའོ།",
    "ཡནི་ལ་གཏོད་པའི་དགོས་པ་བྱེད་པ་གང་ཡནི་པ་དེ་ལ་བསླབ་པར་བྱ་ཞིང་ཡང་དག་པར་བསྟན་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱག་རྒྱུ་རྣམས་ནི་རྣམ་པ་མང་བས་ན་དེ་ལ་དང་པོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བསླབ་པོ་ཞེས་བྱ་བ་ན་བསྟན་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་ཆགས་པར་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ནས་དེར་བདག་ཉིད་ལྕགས་ཀྱུར་བསམ་པར་བྱའོ།",
    "དཔུང་ཕ་ཡས་པ་བརྐྱང་ལ་ལག་པ་བཀྱག་ནུས་ལྕགས་ཀྱུ་ལྟ་བུར་བཞག་པར་བྱའོ།",
    "འོག་མ་རྣམས་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "སས་རྒྱས་ཉིད་ཀྱང་སྲུང་བར་བྱེད་ཅེས་བྱ་བ་ནི་འདི་སྐད་ ཐམས་ཅད་སྲུང་ནུས་པར་འགྱུར་རོ་ཞེས་པ་སྟེ།",
    "གཅུ་ཞེས་བྱ་བ་ནི་ངེས་པར་ཤེས་བྱ་བའི་དོན་ཏོ།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱང་འགུགས་པར་བྱེད་པའོ།",
    "ཁམས་གསུམཱ་ཡང་འཇིག་པར་བྱེད་ན་གཞན་ལྟ་སྨོས་ཀྱང་དགོས་ཤེས་པའོ།",
    "བྱམས་པའི་ལྟེ་བ་ཡན་པར་བཤད།",
    "ཞེས་བྱ་བ་ཟློས་ཤིང་རྒྱུན་མི་འཆད་པར་འདོན་པ་དང་།",
    "ཚིག་ཏུ་བརྗོད་པ་གསལ་བ་ཡིས་ཞེས་བྱ་བ་ནི་རྣ་བའི་རྣམ་པར་ཤེས་པས་བཅུད་དུ་རུང་བའི།",
    "དམ་པར་གྱུར་པས་སོ།",
    "དེས་བསད་དོཞེས་བྱ་བ་ཁྲོ་བོའི་ལྟ་བས་དེ་བསད་ཅིང་བསྒྱེལ་བར་བྱས།",
    "སྲིད་འདོད་ཀྱིས་བར་དུ་འདུ་ཤེས་མེད་པར་བྱའོ་ཞུས་བྱ་པའི་དོན་ཏོ།",
    "སླབ་བོ་ཞེས་བྱ་བ་ནི་བསྟན་པར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "པས་བལྟསདས་སྟོད་ལ་དབབ་པར་བྱ་བ་ནི་གཅིག་གམ་གཉིས་སམ་མང་པོ་ནས་འགྲོ་བ་ཐམས་ཅད་ཀྱི་བར་དུའོ།",
    "འདུ་ཤེས་མེད་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྤྱིར་བསྡུས་ཏེ་བཔ་བ་བྱས་ཀྱང་རུང་དེནས་ཞིས་བྱ་བ་ནི་གཞནཡངཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཉེ་བར་དགོད་པར་མཛད་པ་ཡནི་ཏེ།",
    "༥༢ བ་ཤིནཏུ་གསང་བའི་ལས་རྣམས་ལ་གསང་བའི་གསང་བར་གསུངས་པ་གང་ཡའི་བ་དེ་རྣམས་ཀྱི་ལས་སྟོན་པར་བཞེད་ནས།",
    "དེང་དུ་བྱིངས་ཀྱི་དཀྱིལ་འབོར་ཆེན་པོར་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱི་མཚན་ཉིད་ཇི་ལྟར་གསུངས་པ་ཡང་དེ་བཞིན་དུ་བྱ་སྟེ།",
    "ས་མ་ཡཏྟཾ་ཞེས་སྨྲ་ཞིང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདོད་ལ་ཆགས་པ་བདེ་བའི་བདག་ཅམ་བྱ་བ་གསུངས།",
    "སྙམ་ངུ་འགའ་ཞིག་རྟོག་པར་འགྱུར་ན།",
    "བཅིང་བ་ལ་སོགས་པའི་ལས་ཡིན་པས་ནི་བཅིང་བའི་རྒྱུ་ལ་བརྩི་བ་ཞེས་གསུངས་སོ།",
    "ཞིམ་བཞར་ལ་འཆང་བར་འདོད་པ་དེའི་ཚེ་དེ་ལ་རྡོ་རྗེ་དབབ་པ་བསྐྱེད་པར་བྱའོ།",
    "རྡོ་རྗེ་དབབ་པ་བྱས་ནས་ནི་ཞྭ་པ་བྱ་བ་ནི་ཇི་སྐདགསུངས་པའི་ཚུལ་གྱིས་རྡོ་རྗེ་དབབ་པ་དབབ་པ་བསྐྱེད་པ་དེའི་ཚེ་ན་བཅིང་བའོད།",
    "ནམཁན་ལ་སྐྱེད་པར་བྱེད་པ་དེའི་ཚོ་ནི་འཆིང་དུ་གཞུག་པར་བྱའོ།",
    "དམ་ཚིག་ནི་གཞུང་ལུགས་སུ་རྣམ་པར་བཞག་པའོ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་རྣམ་པར་སྣང་མང་ད།",
    "དེ་ནས་དེ་བཞིན་བཤུགས་པ་བཅོམ་ལྡན་འདས་ཞེས་བྱ་པ་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ལ་གནས་པའི་རྡོ་རྗེ་སཾམིས་པར་ཡང་དག་པར་སྐུལ་བར་བྱེད་པའི་ཉིང་ངེ་འཛིན་སྟོན་ཏོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་སྣང་བར་བྱས་སོ།",
    "ཞེསཁྱ་བ་འདིས་ནི་ཏིང་ངེ་འཛིན་གྱི་ཤས་ཀྱི་འཕྲོ་འ་སྟེན་ཏེ། སྣང་བར་བྱས་པ་ནི་གསལ་བར་བྱས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཡེ་ཤེས་གཅིག་ཏུ་འདུས་པར་གྱུར་ཏེ།",
    "བདག་ཉིད་བྱིན་གྱིས་བརླབས་ཏེ་ཞེས་བྱ་བ་དེར་བྱས་པའོ།",
    "ཁམས་གསུམ་ཡངནརྒྱས་པར་བྱེད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་སྐུས་ཁྱབ་པར་བྱས་ལ།",
    "དེ་ནས་གཟུགས་ཀྱི་མཚནམརྣམས་ཀྱིས་ཚོད་ཀྱི་དབྱིངས་ཐམས་ཅད་ཁྱབ་པར་བྱ་བའི་ཚུལ་གྱིས་ཞེས་བྱ་བ་ལ།",
    "གང་གཙོ་ཏིང་ངེ་འཛིན་རྫོགས་པར་གྱུར་པ་ན།",
    "ནམཁའིང་བྱིངས་ཐམས་ཅདནིརཡཁའི་ཁམས་ཐམས་ཅད་དུ་ཁྱད་པར་ཁྱབ་པར་བྱས་པས་ན་ཁྱབ་པར་བྱས་པ་ཞེས་བྱའོ།",
    "ཕྱག་རྒྱ་རྣམས་ཀྱི་རིགས་ཀྱི་རྣམ་པར་དབྱེ་བ་དགོས་པསན་རིམ་གྱིས་ཡང་དང་ཡང་དུ་འཇུག་པ་སྐྱོན་བ་ནི་ནོ།",
    "དའི་སེམས་དཔའ་བཅུ་དྲུག་བསྐྱེད་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པའི་གཞུང་གསུངས་ཏེ།",
    "ལུས་ཤིན་ཏུ་སྦྱངས་པས་བདེ་བ་ཡོང་བར་དཔལྡན་པསནསེམས་རྩེ་གཅིག་པར་འགྱུར་རོ་ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "ཁམས་གསུམ་དུ་ཡང་ཁྱབ་པར་འགྱུར་ཞེས་བྱ་བ་ལ།",
    "རྣམ་པའི་ཁམས་རྣམསུ་ཡང་ཁྱབ་པར་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནི་མཉམ་པར་བཞག་པའི་ཉམས་ཀྱིས་མཉམ་པར་བཞག་པའོ།",
    "དེས་ན་འདི་ཕྱོགས་ཀྱི་ཆས་ཐུབ་པར་བྱ་བ་མ་གསུངས་ཏེ།",
    "དེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཆག་པ་འམ་ཉལ་བ་དེས་རྣམ་པར་རྟོག་པའོ།",
    "གོམས་པར་བྱ་ཞེས་བྱ་བ་ནི་བསྒོམ་བ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་ཤིན་ཏོ།",
    "གནས་རྣམས་ཀུན་ཏུ་བསམ་པར་བྱ་བཞིནམཁའ་ལ་སོགས་པའི་གནས་ཐམས་ཅད་དུའོ།",
    "༥༢ ཀྱིས་ཁྱབ་པར་བྱེད་པའོ།",
    "༥༢ བ་༥བྱ་བ་ནི་གལ་ཏེ་ཕ་རོལ་གྱི་སྟོན་པར་ཡང་འགྱུར་བ་སྲིད་པས།",
    "དེ་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་བདག་ཉིད་ཅེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བདག་ཉིད་ནི་འདུ་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པ་ལས་བྱུང་བའི་ལམ་འདི་དང་།",
    "དེ་དང་ལྷན་ཅིག་ཐ་མི་དད་བ་མམ་པ་བདག་གཉིས་མཉམ་པར་སྦྱར་ན།",
    "ང་རྒྱལ་དེས་དགོས་པ་འགྲུབ་པར་འགྱུར་བའི་ཕྱིརར།",
    "དེ་སྟོན་པར་བྱེད་པའི་རིག་པ་གང་ཡིན་པ་དེ་ལ་མེད་སྔགས་ཀྱི་སྤྱོད་མ་ཞེས་བྱའོ།",
    "ནལ་སོགས་པར་བྲི་བའོ།",
    "ཙུག་ལག་ཁང་དང་གནས་ཁང་ལ་སོགས་པར་ཅི་ནུས་སུ་གང་བར་བྱའོ།",
    "དྲོའི་ཕྱག་རྒྱ་སྟེ་དེའི་ཡེ་ཤེས་བསླབ་པར་བྱ་བའོ།",
    "དི་ཇི་ལྟར་བསླབ་པར་བྱ་ཞེན།",
    "ཅི་ཞིག་བྱས་པས་ཞེན།",
    "རིམ་གྱིས་སངསརྒྱས་ཀྱི་བདེ་བ་ཉིད་ཀྱང་འཐོབ་པར་འགྱུར་བའོ།",
    "གང་ཉམས་པར་མི་འགྱུར་པའོ།",
    "དོབཔ་པར་བྱའོ་ཞེས་པའོ།",
    "རབ་ཏུ་དང་བའི་སེམས་ཀྱིས་དེ་བཞིན་བཤེགས་པ་རྣམས་ཀྱི་ཡོན་ཏནརྣམས་མངོན་སུམ་དུ་བྱས་ནས།",
    "བསྟོད་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་བསྟོདཾ་པར་བྱའོ།",
    "དེ་བསླབ་པར་བྱའོ་ཞེས་པའོ།",
