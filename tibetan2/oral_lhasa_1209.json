    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ཀར་རྣམ་པ་དེ་བཞིན་བཤེགས་པ་ཐམས་ཅད་ཀྱི་སྤྱན་སྡུར་ཞེས་བྱ་བན་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱན་སྔར་རོ།",
    "བཀའནོད་པར་བྱེད་པའོ།",
    "གསོལ་བ་བཏབ་པའི་ཚེ་བཀའ་མནོས་འོན་ཀྱང་ཁྱད་པར་གྱི་བཀའམནོས་པའི་ཕྱིར་ཡང་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྣང་མཛོད་ཀྱི་ཐུགས་ལ་དེ་དག་ཐམས་ཅད་གཅིག་གྱུར་པས་སོ།",
    "ཐམས་ཅད་ཤེས་པས་ན་ཀུན་མཁྱེན་ནོ།",
    "༥༢ བ་ཆུད་པར་བྱ་བའི་ཕྱུ་པ་བསྐྱལ་ཡག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིགཔཔོདྷིཙྪཱམ་པར་འཇིག་པར་བྱེད་པའོ།",
    "གྲོགས་པོ་རྣམས་བསྒྲུབ་པརགྱིས་ཤིག་ཅེས་བྱའོ།",
    "གནས་པར་བྱ་བ་ཡིན་པ་ལ་སོགས་པའོ།",
    "སེམས་ཙཱནང་བོན་ཉིད་མ་མཐོང་བ་རྣམས་འཇིགས་པ་བསྐྱེད་པར་བྱེད་པའི་གཟུགས་ཀྱིས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ནམའི་ངོས་ཁྱབ་པར་བྱེད་པའོ།",
    "༥༢ བ་པར་གྱུར་ཏོ།",
    "ང་ཉིདརྫུ་འཕྲུལ་ཆེ་བ་ཡ་པ་གཞོན་རྣམས་ལ་འདུད་པར་མི་བྱེད་ཅེས་པའོ།",
    "ལྷ་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་བསྐྱོལ་བ་ལ་སོགས་པའི་ལྷ་དེ་དག་ཐམས་ཅད་ལ་བོས་ནས་འདི་སྐད་ཅེས་གསུངས་ཏེ།",
    "ཡང་དག་པར་རྫོགས་པའི་སངསརྒྱས་ཕྱག་རྒྱ་དང་བཅས་པ་དང་།",
    "བཙོམ་ལྡན་འདས་ཀུན་ཏུ་བཟང་པོའི་ཆེ་བ་བདག་ཉིད་བསག་པར་བྱ་བའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་ཚོས་ཡང་དེ་རྣམཱསཚར་བཅད་པར་བྱ་བའི་ཕྱིར་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེའི་ཕྱིར་བུ་མ་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ངའི་བཀའ་མི་ཉན་ཏམ་ཞེས་གསུངས་པ་དང་།",
    "མི་ཉན་ཏོ་ཞེས་བྱ་བའི་པར་དུ་རྒྱས་པར་མུས་པ་ཡིན་ནོ།",
    "ལྷ་ཆེན་པོ་ལ་བཀའ་ཉན་པར་མི་འདོད་པར་མཁྱེན་ནས་རབ་ཏུ་ཁྲོས་པ་ས་ཁྱ་བ་ཀྲབ་ཏུ་འཁྲུགས་པ་སྟོན་ཅིང་།",
    "དེནས་བཅོམ་ལྡན་འདས་ཀྱིས་རྗེས་གནང་བ་དང་།",
    "དང་བ་བསྐྱེད་པར་བྱུ་བའི་ཕྱིར་རོ།",
    "སྔར་ནི་ཡང་དག་པར་མ་བླངས་པས་ད་ལྟར་དལ་འབར་དུ་འཇུག་པའི་ཚེ་བ་མ་ལ་སྒྱུ་འསུ་འགྲོ་བ་ལ་སོགས་པ་ལ་འདུད་པ་རཚང་འཁོར་དུ་འཇུག་པའི་གཞུང་ལུགས་བསྟན་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེའི་འོག་ཏུ་ང་ཆུབ་སེམས་དཔའི་སྤྱོད་པ་ཤིན་ཏུ་མལ་པར་འཁཀ་པས་སྤྱདཔར་བྱའོ་ཞེས་པའོ།",
    "གདོང་གཡོགས་བཅིངས་ལ་འཇུག་པའི་སྐུད་པོ་འརྗོད་དུ་གཞུག་ཅིང་གཞུག་པར་བྱའོ།་།",
    "ཁྲོ་བོའི་ཏིང་འཛིན་ལ་བཅས་པའི་སྔགས་པ་གང་ཡིན་པས་དམ་ཚིག་འང་སྦྱར་བར་བྱས་ན་ཁྱེད་རྣམས་དེའི་མདུན་དུ་འཁོད་ཅིག་པའོ་ཙིའི་ཕྱིང་ཞེན།",
    "ལྟར་བསྒྲུབ་པར་བགྱི་ཞེས་བྱ་བནི་ལྟར་འབུ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལེགས་པར་བཀའ་སྩལ་དུ་གསོལ་ཞེས་བྱཁནི་གསལ་བར་བཀའ་སྩོལ་ཅིགཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེནས་བར་སྐབས་དེར་བཅོམ་ལྡན་འདས་ཀྱིས་སེམས་དེ་རིནམས་ཀྱི་ཚེ་ཟད་པར་མཁྱེནནས།",
    "འོ་དོད་ཆེར་འབོད་པ་ཞེས་བྱ་བ་ནིའི་སྙན་པར་འབོད་པའི་དོན་ཏོ།",
    "བསྒྲུབ་ཡོ་བྱོས་ཤིག་ཅེས་བྱ་བ་ནི་བྱིན་གྱིས་རློབ་པར་གྱིས་ཤིག་པའོ།",
    "བི་ཤོ་དྷ་ཡ་ནཱ་ཤ་ཡ་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྦྱོངས་ཤིག།",
    "རྣམ་པར་ཤིག་ཅིག་ཅེས་ཟེར་ཏེ།",
    "ཚེ་ཡང་ཟད་པ་ཞིག་ན་དེ་རྣམ་པར་སྦྱོངས་ལརྣམ་པར་ཤིག་ཅིག་ཅེས་པའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་ཚིག་དེ་ཐོས་ནས་བཅོམ་ལྡན་འདས་ཕྱུགན་རྡོ་རྗེས་དཀྱིལ་འཁོར་སྟོན་པར་མཛད་པ་ན་དེ་བཞིན་བ།",
    "དེ་རྣམས་རྣམ་པར་འཇིག་པ་ནི་ཚོར་གཅོད་པར་མཛད་པའོ།",
    "རབ་ཏུ་བརྒྱན་པ་བརྒྱན་པ་བྱས་པའོ།",
    "དཀྱིལ་འཁོར་ཕྱི་དལ་སྲད་བུ་ཧྥ་ཞེས་བྱ་རི་སྔགས་པས་དང་པོར་ཕྱིའི་དཀྱིལ་འཁོར་དེ་ལྟར་ཐིག་གདབ་པར་བྱའོ།",
    "རྟ་བབས་དང་བཅས་པར་གནས་པསན་རྩ་བས་བཅས་སོ།",
    "དེ་ལ་དཀྱིལ་འར་དེའི་དབུས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་བཞག་པར་བྱ་སྟེ།",
    "སྙནམི་བདེ་པ་ཕ་གུའི་སྟན་ཞེས་གསུངས་པར་ཟད་དོ།",
    "སྣམ་བུའི་ཕྱི་རིམ་གྱི་གནས་ལྷག་མ་རྣམམུནིམ་མ་རྣམས་དགོད་པར་བྱའོ།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལགསོལབ་གདབབོ།",
    "བསྟན་པ་ལ་འཁུ་བར་བྱེད་པ་གང་ལགས་པ་དེ་ཐམནི་ཚར་བཅད་དོ་ཞེས་བྱ་བ་སྟེ།",
    "མཉམ་པར་བཞག་པའི་སེམས་ཀྱིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་པའི་ཕྱིར་རོ།",
    "དོནི་དཀྱིལ་འཁོར་མཐོང་བས་འཇིག་རྟེན་གསུམ་པོ་མུཕོའ་ངག་འར་རྣམ་པར་རྒྱལ་བར་ནུས་པར་འགྱུར་རོ་ཞེསབྱ་ཁནི་ཇི་ལྟར་བཅོམ་ལྡན་འདས་དོཛིཏྟཾ་ཨཱཛད་འཇིག་རྟེན་གསུམ་པོ་མ་ལུས་པ་ལས་རྣམ་པར་རྒྱལ་བར་མཛད་པ་ལྟར་དེ་ཡང་དེ་བཞིན་དུ་འགྱུར་བའོ།",
    "དེ་ནས་ཡེ་ཤེས་རྣམས་བསྐྱེད་དོ་ཞེས་བྱ་བའི་ལས་ཀྱི་ལུང་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་རྗེ་ཁྲོ་བོར་མཉམ་བཞག་ནས་ཞེས་བྱ་བ་ནི་ཁྲོ་བོའི་སྙོམས་པར་འཇུག་པ་ལ་གནས་པའོ།",
    "སྐྱེ་བོ་ཀུན་ལ་འབེབས་པར་བྱེད་ཅེས་བྱ་བ་ནི་ལ་ཚོན་པོ་ནས་བརྩམས་ནས་ང་ལ་མ་འབེབས་པ་གང་ཡང་མེད་དོ་ཞེས་འི་དོན་ཏོ།",
    "དེའི་ཕྱིར་བསྡུ་བ་བྱས་ན་དེ་དག་ཐམས་ཅད་སེར་འཚོ་བར་འགྱུར་རོ།",
    "དེ་ཇི་ལྟར་རྒྱས་གདབ་པར་བྱ་ཞེན།",
    "ཕྱག་རྒྱས་བཏབ་པར་དེ་འགྱུར་རོཞེས་བྱ་བ་ནི་དགོས་པར་འགྱུར་བའི་ལྷ་རྣམས་ཀྱིས་རིག་པར་འགྱུར་ཞིང་ཡོངས་གཟུང་བར་འགྱུར་བའོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ལེགས་པར་བརྗོད་པས་ན་བརྗོད་པར་བྱ་བ་སྟེ།",
    "དེ་དང་དེ་དྲན་པམེད་པར་འགྱུར་བའི་དོན་ཏོ།",
    "དེ་ལྟོར་དྲན་པ་མེད་པར་བྱས་ནས།",
    "ཕྱག་རྒྱ་ལས་ནི་ཞེས་བྱ་བའི་ཇི་སྐད་གསུངས་པའི་ཕྱག་རྒྱ་བཞི་པོས་སོ།",
    "དེའི་ཞེས་བྱ་བརྒྱུ་བསྒྲུབ་པར་བྱ་བའིའོ།",
    "དེ་ལྟར་ཇི་སྐད་གསུངས་པའི་ཚུལ་གྱིས་ཡེ་ཤེས་པསྐྱིདནས།",
    "དེ་ལྟར་བརྩིས་པ་བྱས་ན་རྟག་པ་ཉིད་དུ་སུང་བར་འགྱུར་རོ།",
    "གང་གསོ་གང་ཞིག་ཇི་ལྟར་དགབ་པར་བྱ་ཞེ་ན།",
    "དབྱེ་པ་ཞེས་བྱ་བ་དབྱེ་བ་བྱས་པའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེནཔོའི་ཚོ་ག་རྒྱས་པརྫོགམ་སོ།",
    "སུ་འ་རྒྱུན་ལས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་འགྲེལ་པ་ག་ག་འཇིག་རྟེན་གསུམ་ལས་རྒྱལ་ཞིང་བཏུལ་ནས་བསྟན་པ་ལ་བཀོད་དེ།",
    "དེནས་ཡང་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལསོགས་པ་གསུངས།",
    "དེས་བསྐོར་ནས་ནང་ན་བཞུགས་ཞེས་བྱ་འི་དོན་ཏོ།",
    "༥༢ བ་བཞིན་གཤེགས་པ་ལྕམས་ཅད་ཀྱི་དོན་བསྒྲུབས་ནས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བཅོམ་སྔོན་འདས་འདི་ཇི་ལྟར་རྙེད་པར་འགྱུར་ཞེས་ཟེར་ལ།",
    "གསུངས་པའི་བཀའ་སྩལ་པ།",
    "དམ་པ་སྟེ་ཞེས་བྱ་བ་ནི་དགོས་པ་དམ་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར།",
    "ཞིག་པར་བྱ་ཞི་བྱ་བ་ནི་གོ་རིམ་བཞིན་ཇི་ལྟ་བ་བཞིན་དུ་བྲི་བར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོགའབར་དབུས་སུཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཉི་མའི་གནསུ་ཟླམའི་དཀྱིལཝཁོར་བྲིས་པར་རྡོ་རྗེ་བྲི་བར་བྱའོ།",
    "༥༢ བྱས་ལ་དེའི་སྟེང་དུ་པདྨ་ཤིང་ལ་སོགས་པ་ལས་དངོས་སུ་བྱའོ།",
    "དཀྱིལ་འཁོར་དམ་པ་བཞི་པར་ཡོང་།",
    "རྡོ་རྗེ་ཐམས་ཅད་གོ་ཆ་ཆོག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལས་ཀྱི་རིགས་ལ་ནི་ཆོ་འཕྲུལ་ལ་སོགས་པའི་ལསརྣམས་ལ་ལྷག་པར་སྤྱོད་དེ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོར་འཇུག་པའི་ཆོ་གས་ཀློབམ་བཅུག་ལ།",
    "ན་པོའི་རིགས་ལ་བྱ་བར་གསུངས་སོ་། འདི་དགཀྱང་གླུད་བསྲུང་བ་ཙམ་དུ་ཟད་དེ།",
    "དེལ་དང་བ་ཉིད་དུ་ཞེས་བྱ་བལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅདིའི་རྣམ་པར་སྣང་མཛོད་ལ་སོགསཔ་སྟེ།",
    "ཁྱད་པར་ནི་དེ་ཙམ་དུ་ཟད་དོ།",
    "མཉེས་པར་བྱས་པས་སྔགས་པ་དེ་བརྫུན་པཾངྒའགྱུར་རོ།",
    "མཉེས་པར་བྱས་པའི་རྣམ་པས་བཅོམ་ལྡན་འདས་མཉེས་པར་གྱུར་ནས་དེ་ཅི་ཞག་མཛད་འི་ཕྱིར་དགོས་པ་ཐམས་ཅད་ནི།",
    "དེ་བས་ན་དེ་བསྟན་པའི་ཕྱིར་དེ་བཞིན་གར་གྱི་ཆོ་ག་ཡས་ཞེས་བྱ་བ་གསུངས་པ་ཡནིའོ།",
    "རྒྱ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྟོད་པ་ཉིད་ཀྱི་རལ་གྲིས་གཅོད་ཅིང་རྣམ་པར་མ་ཞིག་པར་བྱའོ་ཞེས་བྱ་པའི་དོན་ཏོ།",
    "གཙུག་ཏོར་གནས་སུ་དེ་བཞིན་དུ་པདན་ནས་བཞག་པར་བྱའོ།",
    "གཡོན་དུ་ང་དམའ་ཇེ་དམའ་ཕབ་ལ་གཡོན་ཕྱོགསུ་བསྐོར་ཞིང་ཐུར་དུ་དབབ་པར་བྱའོ།",
    "དེ་བསླབ་པ་ཞེས་བྱ་བ་ནི་དརྣམས་ཀྱི་སྦྱོར་བ་ཉེ་བར་བསྟན་པར་བྱ་བའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་ཉེ་བར་བསྟན་པར་བྱ་ཞེ་ན།",
    "གཡས་ཀྱི་རྡོ་རྗེ་ཁུ་ཚུརམཆན་ཁུང་གཡོན་པར་གཞུག་ཅིང་།",
    "དུ་ནི་རྡོ་རྗེ་རིག་གྱི་གསང་བའི་ཕྱག་རྒྱའི་ཡེ་ཤེས་བསླབས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བོན་པོའི་རིགས་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་རོ།",
    "དེ་ཉིད་ནུ་མ་གཡས་པའི་ཐད་ངལག་པ་གཉིས་ཀྱིས་རལ་གྲི་འདེབས་པ་འདྲ་པར་བཞག་པ་ནི་དངུནོན་པོའ་ིགནས་ཀྱི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བཅིངས་པ་ལས་ཞེས་བྱ་བ་ནི་དོརྗེ་བཙཱརསཾ་པ་ཆུང་དུ་བྱས་པ་ལས་སོ།",
    "དལ་བོར་དུ་བྲིས་ནས་ཀྱང་ཕྱག་རྒྱ་བཅིངས་པའི་དུས་སུ་བརྗོད་པར་བྱའོ།",
    "རྡོ་དབུ་ཚུར་ཞེས་བྱ་བནི་བཅིང་བ་ནང་དུ་བྱས་པ་འདི་ཉིད་རྡོ་རྗེ་ཁུ་ཚུར།",
    "གཉིས་བྱས་ཏེ་ཞེས་བྱ་བ་ནིནེམ་པར་དབྱེ་བའོ།"
  ]
}