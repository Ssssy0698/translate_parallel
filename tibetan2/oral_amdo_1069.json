    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "མཛུབ་མོ་གཉིས་ནང་དུ་བཀུག་ལ་དེས་མཐེ་བོ་བྱེགཉིས་ཀའི་རྒྱབ་བཀབ་པ་ནི།",
    "བདག་ཉིད་བསྲུང་བའི་ཕྱིར་རང་གི་གཙུག་ཏོར་སྦྱར་བར་བྱའོ།",
    "མཐེ་བོ་གུང་མོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དབྱིངས་སུ་གསུངས་པ་ཉིད་ཀྱིས་ཏྲེསྣརྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ།",
    "མཐེ་བོ་དང་གུང་མོ་དང་མཐེའུ་ཆུང་རྣམས་སོ་སོར་བསྒྲེང་བར་བྱས་པ་འདི་ནི།",
    "ཅེས་བྱ་བའི་སྔགས་འདིས་སྤྱི་གཙུག་གི་སྟེང་དུ་གཟི་བརྗིད་ཕུང་པོའི་འཁོར་ལོའི་ལག་པ་འདི་བཞག་པས།",
    "ཕྱག་གཡས་པའི་གུང་མོ་ལ་རྡོ་རྗེ་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་བསྐོར་ཞིང་གནས་པ།",
    "ཞབས་གཡོན་པ་གདན་ལ་ཕྱེད་ཀྲུང་གི་སྤྱོར་བྱེ་བས་བཞུགས་པ་བསམ་པར་བྱའོ།",
    "དེ་ཉིད་ལས་གུང་མོ་དང་༩སྲིན་ལག།",
    "སོར་མོ་རབ་ཏུ་བསྡམས་པས་ན།",
    "རིག་པ་མཆོག་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་སྲིན་ལག་གཉིས་དང་གུང་མོ་གཉིས་ཀྱི་རྒྱབ་བསྐུམ་ནས།",
    "རིག་པ་མཆོག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དོ།",
    "ཞེས་བྱ་བ་ནི་རིག་པ་ཆེན་པོ་དམ་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་སྤྱི་བོ་ནས་བརྩམས་ཏེ་དགོད་པའི་སྦྱོར་བས་ལུས་ཐམས་ཅད་བསྟན་རྙིཔའི་ཚུལ་གྱིས་བསྐོར་ལ་ཡང་དེ་ཉིད་ཀྱི་ཕྱོསྤྱི་བོར་གཞག་པ་ཁུའདི་ནི་སྣ་ཚོགས་རྡོ་ཇེའིའོ།་།",
    "གཡོན་པའི་སོར་མོ་དབུས་མ་གསུམ།",
    "སྒྱུ་མའི་རྡོ་རྗེ་ལ་སོགས་པ་ནས་ཆུ་ཟླའི་མཐར་ཐུག་པའི་རང་གི་རྡོ་རྗེའི་རྔུརིགས་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་དུ་གྱུར་པ་དེ་རྣམས་ནི་འདི་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱའོ།",
    "གང་དག་གི་ཞེ་ན།",
    "དེའི་ཕྱིར་འཁོར་ལོ་ལ་སོགས་པའི་རང་གི་ཕྱག་རྒྱའི་ཚུལ་གྱིས་དེ་དག་རྔུདགོད་པར་བྱའོ།་།",
    "གཡོན་པའི་ཁུ་ཚུར་གྱི་མཛུབ་མོ་བརྐྱང་བ་གཡས་པའི་ཁུ་ཚུར་གྱི་རྒྱབ་ཏུ་གཞག་པ་ནི་རྡོ་རྗེ་སྒྱུ་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་མཐེབ་གདོང་སྦྱར་ལྡུབ་དང་།",
    "ཞེས་བྱ་བ་ནི་གཡོན་པའི་ཁུ་ཚུར་གྱི་མཐེ་བོ་དང་མཛུབ་མོ་གཉིས་ཕན་ཚུན་དུ་ཙོགདོང་སྦྱར་ལ་ཟླུམ་པོར་བྱས་ཏེ་ཐུར་དུ་བསྟན་ནས་དྲིལ་བུ་འཛིན་པ་ལྟར་བྱེད་པ་ནི་རྡོ་རྗེ་དྲིལ་བུའོ།",
    "གཡས་པའི་མཐེ་བོང་གི་སྟེང་དུ་གཞག་པ་ནི་ཐུབ་པ་རྡོ་རྗེའིའོ།",
    "བསྒྱིངས་བཅས་མཛུབ་མོ་ཁར་མཆེ་བ།",
    "གཡོན་པའི་ཁུ་ཚུར་གྱི་མཛུབ་མོ་ལྕགས་ཀྱུ་ལྟར་ཁར་མཆེ་བའི་ཚུལ་དུ་བཞག་ནས།",
    "གཡོན་པའི་ཁུ་ཚུར་གྱི་ལག་ངར་གྱི་ཞགས་པ་གཡས་པའི་ཁུ་ཚུར་གྱིས་འདྲེན་པའི་ཚུལ་དུ་བྱེད་པ་ནི་ཀླུ་རྡོ་རྗེ་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཨུ་མ་ལ་སོགས་པའི་མ་མོ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་འཇིག་རྟེན་གསུམ་ཀྱི་འཁོར་ལོ་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དུ་འཆད་པར་འགྱུར་རོ།",
    "མ་མོའི་ཚོགས་ཀྱི་མཐར་ཐུག་པའི་འཇིག་རྟེན་པའི་ལྷ་རྣམས་ཀྱི་ལས་ཀྱི་ཕྱག་རྒྱ་ནི་འཇིག་རྟེན་པའི་འཁོར་ལོའི་ལས་ཀྱི་དཀྱིལ་འཁོར་དུ་གསུངས་པ་དེ་གཟུང་བར་བྱའོ།",
    "ཐིག་སྐུད་འདེབས་པ་དང་ཚོན་འདྲི་རྔུབའི་དུས་སུ་ཐོག་མར་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་བྱས་ལ།",
    "སེམས་དཔའ་གང་གི་ཕྱག་རྒྱ་གང་།",
    "ཕྱིའི་རྡོ་རྗེ་རིགས་རྣམས་ཀྱང་རྡོ་རྗེ་ཐལ་མོ་དང་།",
    "དམ་ཚིག་གི་རྡོ་རྗེ་ཁུ་ཚུར་བཅིང་བར་བྱའོ།",
    "དེ་ནས་དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་ས་མ་ཡོལྷཧཾ་ཞེས་བརྗོད་དོ།",
    "རྡོ་རྗེ་༡་རིག་པ་མཆོག་ལ་སོགས་པའི་དབྱིངས་སུ་དེ་དག་གི་ཕྱག་རྒྱ་ཆེན་པོར་བྱིན་གྱིས་བརླབས་ཏེ།",
    "དེ་ཉིད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བྱ་བས་རང་གི་ལུས་ལ་བཅུག་ནས་ས་མ་ཡ་ཙཱུ་ཞེས་བརྗོད་པས།",
    "རང་གི་ཕྱག་རྒྱ་ཆེན་པོའམ།",
    "རྡོ་རྗེ་འཆང་གི་ཕྱག་རྒྱ་གྱེན་དུ་བཀྲོལ་ཏེ།",
    "དེ་ལྟ་བུས་ནི་རང་གི་ལྷ་གཤེགས་སུ་གསོལ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་ཉིན་རེ་ཞིང་བྱས་ལ།",
    "རྡོ་རྗེ་མདུང་གི་ཕྱག་རྒྱ་ཆེས།",
    "དབྱུག་པའི་འུཤིང་གི་ཚངས་པའི་ཕྱག་རྒྱ་གང་ཡིན་པ་དེས་མྱ་ངན་ལས་འདས་པ་སྟེར་བའོ།",
    "ཞི་བའི་མཆོག་གི་རྡོ་རྗེ་འོད་ཀྱི་ཕྱག་རྒྱ་གང་ཡིན་པ་དེས་ཐམས་ཅད་གསོད་པར་བྱེད་དོ།",
    "ད་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གཙོ་བོར་གྱུར་པའི་འཇིག་རྟེན་གསུམ་གྱི་གཟུངས་ཀྱི།",
    "རེ་རེ་ཞིང་ཡང་བཟླས་པ་ཁྲི་བྱ་བའམ།",
    "མཁའ་ལྡིང་གི་གདན་ལ་ཟླ་བའི་དཀྱིལ་འཁོར་དང་ལྡན་པ་བྲི་བར་བྱའོ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་༢དཀྱིལ་འཁོར་ཀྱི་ཚུལ་གྱིས་བསྐོར་བ་བྲི་བར་བྱའོ།",
    "ལྷོ་ནུབ་ཀྱི་མཚམས་སུ་དཔལ་མོ།",
    "བདེན་བྲལ་གྱི་མཚམས་སུ་དཔལ་མོའི་པདྨ།",
    "ལྷ་མོ་རྣམས་ཀྱང་བྲི་བར་བྱ།",
    "ནུབ་ཕྱོགས་ཀྱི་རྡོ་རྗེ་ཕྱག་རྒྱའི་ལྷོའི་ཕྱོགས་སུ་རྡོ་རྗེ་གཏུན་ཛྭཤིང་གི་གཏུན་རིངས་དང་།",
    "དེ་དག་གི་རིམ་པ་ནི་སྒྱུ་མ་རྡོ་རྗེ་དང་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་རྣམས་ནི་ཇི་ལྟར་བྲིས་པ་བཞིན་མ་སྨྲ་ཤིག་པའོ།",
    "དམ་ཚིག་ཕྱག་རྒྱ་འདི་ཁྱོད་ཀྱི།",
    "མ་དང་སྲིང་མོ་རྣམས་དང་ནི།",
    "ཆུང་མ་བུ་མོ་རྣམས་རྗེས་འབྲང་།",
    "གང་གི་ཚེ་སློབ་དཔོན་གྱི་ལག་ན་གནས་པའི་རྡོ་རྗེ་རྩེ་གསུམ་པ་རྡོ་རྗེ་འཆང་བའི་ཕྱག་རྒྱའི་སྟེང་དུ་བཞག་སྟེ།",
    "ཨོཾ་རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་སྣརིགས་སུ་ཞུགས་ཀྱིས་ངས་ཁྱོད་ལ་ཡེ་ཤེས་གང་གིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་རིགས་ཀྱི་དངོས་གྲུབ་ཀྱང་འགྲུབ་པར་འགྱུར་ན།",
    "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་ཆེན་པོ་མ་མཐོང་བ་རྣམས་ལ་མ་སྨྲ་ཞིག།",
    "ཁྱོད་ཀྱི་དམ་ཚིག་ཉམས་པར་གྱུར་ཏ་རེ།",
    "སུའི་མདུན་དུ་ཡང་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་རྣམས་མ་སྨྲ་ཤིག།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
    "དེང་ཕྱིན་ཆད་ཁྱོད་ཀྱི་ཕྱག་ན་རྡོ་རྗེ་ང་ཡིན་གྱིས།",
    "ཁྱོད་ཀྱིས་ང་ལ་བརྙས་པར་མ་བྱེད་ཅིག།",
    "དེ་ནས་རྡོ་རྗེ་འབེེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱའི་གསང་བ་འདི་སྨྲོས་ཤིག་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ཨུ་མ་ལ་སོགས་པ་བུད་མེད་ཀྱི་གཟུགས་རབ་ཏུ་སྦས་ནས་མདུང་རྩེ་གསུམ་པ་ལ་སོགས་པའི་གཟུགས་སུ་གནས་པས་གསང་བའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱའི་གསང་བ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གསང་བའི་བཙུན་མོའི་དངོས་གྲུབ་བོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ཡིན་ཀྱི་སྐུའི་ཕྱག་རྒྱ་ནི་མ་ཡིན་ནོ།",
    "ཆུང་མ་བུ་མོ་རྣམས་རྗེས་འབྲང་།",
    "སྲིང་མོ་དང་།",
    "བུ་མོ་རྣམས་ནི་གོ་སླའོ།",
    "རྗེས་སུ་འབྲང་བ་ནི་གོགས་མོའམ་ཕྱི་བཞིན་འབྲང་བའོ།",
    "ཨུ་མ་ལ་སོགས་པ་བུད་སྐེད་ཀྱི་གཟུགས་ཀྱི་རྒྱུད་གཞན་མ་ཡིན་པ་དེ་བས་ན།",
    "དེ་ནས་དངོས་གྲུབ་ཐོབ་ནས་དུས་ཕྱིས་གང་གི་ཚེ་ཆུང་མའི་༤ལོངས་སྤྱོད་པས་ཉེ་བར་སྤྱད་པ་དེའི་ཚེ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་ཁྲོ་མོ་སྒེག་མོ་ལ་སོགས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ལ་ཕྱག་བྱས་ཏེ།",
    "དེ་ནས་ལྷ་མོ་ཨུ་མ་ལ་སོགས་པའི་ཕྱག་རྒྱ་རྣམས་ཀྱི་༡༡བསྒྲུབ་པ་འབྱུང་སྟེ།",
    "ཨོཾ་བཛྲ་ཤཱ་ལ་ཨ་གྲེ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རིག་པ་རྣམས་ཀྱིས་ལྷ་མོ་ཨུ་མ་སྤྲུལ་ལ་བསྦུ་བ་བྱ་སྟེ།",
    "རྡོ་རྗེ་མདུང་ལ་སོགས་པའི་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་བསྒྲུབས་ཏེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།་།",
    "ལྷ་མོ་ཨུ་མ་དེ་ཉིད་དང་བཅས་པ་བསམས་ནས་ཁྲི་བཟླས་ནས།",
    "རང་གི་མཚན་མ་ལ་ལྕགས་ཀྱུ་ཁ་དོག་དམར་པོ་འོད་ཟེར་དམར་པོ་འཕྲོ་བ་བསམས་པས་བསྒྲུབ་པར་བྱ་བ་བུད་མེད་ཀྱི་གཟུགས་ཅན་གྱི་རྟགས་ཕུག་ནས་དྲངས་པར་བསམ།",
    "གང་ཡང་ལྷའི་བཙུན་མོ་བསྒྲུབ་པར་འདོད་པ་དེ་ཉིད་ཀྱི་སྤྱོར་བ་དེས་བསྒྲུབ་པར་བྱའོ།",
    "མ་དང་སྲིང་མོ་དང་༦བུ་མོ་ལ་སོགས་པ་བསྒྲུབ་པར་འདོད་ན་སྦྱོར་བའི་དངོས་པོ་མི་བྱའོ།",
    "འོད་ཟེར་དམར་པོ་འབར་བའི་ལྕགས་ཀྱུས་བསྒྲུབ་པར་བྱ་བའི་བུད་མེད་ཀྱི་པདྨ་ཕུག་ནས་དྲང་བར་བྱའོ།",
    "དེ་དོད་ལྟར་ཕྱི་རོལ་གྱི་རྡོ་རྗེའི་རིགས་ཀྱི་ལྷ་མོ་ཐམས་ཅད་བཙུན་མོ་ལ་སོགས་པའི་གཟུགས་ཀྱིས་བསྒྲུབ་པར་བྱའོ།",
    "དངོས་གྲུབ་ཀྱི་ཡེ་ཤེས་བསླབ་པ་བསྟན་པའི་རྗེས་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྒྲུབ་༦པར་བྱའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱའི་མཛུབ་མོའི་རྩེ་མོ་གཉིས་སྤྱི་གཙུག་ཏུ་གཞག་པ་འདི་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོའི་གཡས་ངོས་གཉིས་དཔྲལ་བར་གཞག་པ་ནི་རིན་ཆེན་ཧཱུཾ་མཛད་ཀྱིའོ།",
    "དེ་ཉིད་སྤྱི་བོར་བཞག་ནས་གཉིས་སུ་བྱས་པ་ནི་ལས་ཀྱི་ཧཱུཾ་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་ཉིད་ལས་གཡས་པའི་སོར་མོ་དབུས་མ་གསུམ་མདུང་རྩེ་གསུམ་པ་ལྟར་བྱས་ལ།",
    "གཡོན་པའི་མཛུབ་མོ་ཀཱུགནོན་པ་ལྟར་བྱེད་པ་འདི་ནི་རྡོ་རྗེ་རིག་པ་མཆོག་གིའོ།",
    "གཡོན་པའི་ཁུ་ཚུར་གྱིས་མཚན་མ་ཐམས་ཅད་ཀྱི་ཚུལ་གྱིས་རྡོ་རྗེ་མཛུབ་མོས་སྙུད་པའི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གཡོན་པའི་རྡོ་རྗེ་མཛུབ་མོ་དེ་ཉིད་ཀྱིས་འདུས་པའི་ཕྱག་རྒྱ་བཅིངས་ལའཆད་པར་འགྱུར་བའི་ཚུལ་གྱིས་གཟུངས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "གཡོན་པའི་ཁུ་ཚུར་ཀྱི་སོར་མོ་ཐམས་ཅད་བརྐྱང་ལ་མཛུབ་མོ་ཅུང་ཟད་བསྐུམས་ཏེ་༨།",
    "ཞེས་བྱ་བ་ནི་གཡོན་པའི་ཁུ་ཚུར་ཀྱི་༩མཛུབ་མོའི་གདོང་དང་མཐེ་བོང་གི་གདོང་གཉིས་སྦྱར་ལ།",
    "གཡོན་པའི་ཁུ་ཚུར་ཀྱི་མཛུབ་མོ་རང་གི་མཇེ་བོའི་སྟེང་དུ་བཞག་ལ།",
