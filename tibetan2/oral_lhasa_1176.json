    "ཡང་དག་པར་རིག་པའི་སེམས་ཙམ་ལ་ནི།",
    "མཚན་མ་ཡོད་པ་མ་ཡིན་པས་ན་བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ་དོན་དམ་པའི་བདེན་པ་མི་གཉིས་པར་རིག་པ་ལ་མི་རྟག་པ་དང་།",
    "གཅེས་པ་ལ་སོགས་པའི་འབྲས་བུ་ཡོད་པར་མི་འགྱུར་རོ།",
    "གང་རྗོདོན་གྱིས་སྟོང་པའི་རྣམ་པར་ཤེས་པ་དེ་ནི་སླུ་བས་ཁྱབ་པ་ཡིན་ཏེ།",
    "དེ་སྟེ་ཐམས་ཅད་དོན་གྱིས་སྟོང་པ་ཡིན་ན་ནི་སླུ་བས་ཁྱབ་པར་མི་འགྱུར་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པས་དགོངས་པ་ཡང་རྨི་ལམ་གྱི་དུས་ན་སྨིག་རྒྱུ་དང་མཚོ་ལ་སོགས་པར་སླུ་བ་དང་སླུ་ཡོརྟབ་མེད་པའི་འབྲས་བུ་ཡང་དམིགས་པས་ན།",
    "སྣང་བ་མེད་པའི་བློ་ལ་རྣམ་པར་འབྱེད་པའི་ཤེས་རབ་ཀྱིས་འཇུག་པར་བྱེད་པའི་ཕྱིར་གང་དཔྱོད་པ་སྟེ།",
    "སྦོམ་པ་ཀྱེདང་ཕྲ་བ་རྣམ་པར་འབྱེད་པ་རྗེས་སུ་མི་དམིགས་པའི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཁོང་དུ་ཆུད་པར་བྱེད་ཅིང་།",
    "མི་གཉིས་པར་ཡང་དག་པར་རིག་པ་ལ་ནན་ཏན་བྱེད་པའོ།",
    "དེ་ལ་མཁས་པར་གྱུར་པ་དང་།",
    "དེ་ལ་སའི་ཡོན་ཏན་རྒྱ་ཆེར་གསུངས་པ།",
    "སྔར་ཕྱི་རོལ་དངོས་པོ་མེད་པར་བསྟན་པའི་ཕྱིར་ཏེ།",
    "མཐའ་བཞིའི་ཚུལ་རྣམ་པར་དག་ཅིང་བྲལ་བར་གསུངས་པ་བཞིན་ནོ།",
    "གཤེར་བ་སྣང་བའི་རྣམ་པར་རྟོག་པ་ནི་ཕྱི་ནང་དུ་སྣང་བའི་ཆུའི་ཁམས་བསྐྱེད་དོ།",
    "ཚ་བ་ནི་མེའི་རྣམ་པར་རྟོག་པའོ།",
    "བོག་པ་ལ་བདེན་པར་ཆགས་པས་ནི་སྣེཡང་དག་པ་མ་ཡིན་པ་ལ་བདེན་པར་སྒོ་བཏགས་ཏེ་ཆགས་པའི་ཕྱིར་རོ།",
    "འཛིན་པ་དང་གཟུང་བའི་རྣམ་པར་ཉེ་བར་རྟོག་པ་དེ་ལས་ཕུང་པོ་ལྔ་འབྱུང་ངོ།",
    "དེ་ལ་ཁྱད་པར་ཅན་ལ་སོགས་པས་དངོས་པོའི་མཚན་མ་ལ་སོགས་པའི་མཚན་ཉིད་དུ་བརྟགས་པ་ནི་རྭ་དང་ལྡན་པ་དང་།",
    "རྡུལ་གཉིས་དང་རྡུལ་གསུམ་ལ་སོགས་པའི་རྒྱུ་སྤུན་རྣམས་ཀྱི་རིམ་པར་བྱེད་པ་དང་ལྡན་པས་སྐྱེ་བོ་ཞེས་གཞན་གྱི་རྔུགྲུབ་པའི་མཐའ་ནི་ཐམས་ཅད་མཁྱེན་པའི་སྔ་མའི་ཕྱོགས་སོ།",
    "ཕན་ཚུན་དུ་མི་མཐུན་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་མཚན་ཉིད་ཐ་དད་པ་སྟེ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པ་རྣམ་པར་སྤངས་པ་ཞེས་བྱ་བ་ནི་གང་ན་དངོས་པོ་དང་དངོས་པོ་མེད་པ་གཉིས་ཀྱི་རྣམ་པར་རྟོག་ང་ཡོད་པ་དེར་གྲངས་སུ་འབྱེད་པའི་ཐ་སྙད་དོ།",
    "དེ་ནི་རྟོག་པ་དང་རྣམ་པར་རྟོག་པའི་འཛིངས་པ་ལས་འདས་ཤིང་མི་གཉིས་པར་ཡང་དག་པར་རིག་པ་ཞེས་བྱའོ།",
    "འཕགས་པའི་ཡེ་ཤེས་རྟོགས་པ་ནི་མི་གཉིས་པར་ཡང་དག་པར་རིག་པའོ།",
    "ཤིན་ཏུ་རྨོངས་པ་ནི་ཕུང་པོར་རྣམ་པར་རྟོག་པ་བགེགས་དང་འཁྲུལ་བའོ།",
    "རྣམ་པར་ལྡོག་ནས་ཞེས་བྱ་བ་ནི་བོར་ནས་སོ།",
    "རབ་ཏུ་དབེེན་རྔོཔ་ཞེས་བྱ་བ་ནི་འཛིན་པ་དང་གཟུང་བར་སྣང་བའི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་དོན་དམ་པའི་བདེན་པ་མི་གཉིས་པའི་ཆུད་པ་བསྟན་པར་བྱའོ།",
    "ཡོད་པ་དང་མེད་པར་བརྗོད་དུ་མེད་ཀྱང་ཞི་བ་རྟག་པའོ་ཞེས་བྱེ་བྲག་གོ།",
    "མཚན་ཉིད་སྣ་ཚོགས་ཀྱི་དངོས་པོ་མེད་པའི་མྱ་ངན་ལས་འདས་ཛེེཔ་ནི་ཚངས་པའི་སྤྱིའི་རྣལ་འབྱོར་ལ་མཚན་མ་རྣམས་ཀྱི་སྤུསྣ་ཚོགས་སུ་གསལ་བའི་རང་བཞིན་མེད་པ་དེ་ནི་མྱ་ངན་ལས་འདས་པའོ་ཞེས་རྟོག་པར་བྱེད་དེ།",
    "སྒྲ་ཡི་མཐུར་ནི་རྣམ་པར་གནས།",
    "གང་ཟག་ལ་བདག་མེད་པར་ཕུང་པོ་རྣམས་ཀྱི་རྒྱུན་འཆད་པ་ནི་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "ཅེས་པར་རོ།",
    "དེའི་ཕྱིར་གསུངས་པ།",
    "དེ་ཉིད་རྒྱུ་དང་དམིགས་པའི་ཕྱིར་རྣམ་པར་ཤེས་པ་བདུན་རྣམས་ཞེས་པ་ལ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "ཡང་ན་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེའི་རྒྱུ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་དེ་བཟློག་པ་ན་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "ཇི་ལྟར་འདིའི་འོག་ཏུ་གསུངས་པ།",
    "ཇི་ལྟར་ང་དང་འདི་ངའི་ཞེས་པར་རོ།",
    "བྱེད་པའི་ཁྱད་པར་སྔ་མ་དང་ཡང་སྦྱར་བར་བྱའོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མ་གཏོགས་པར་འདུས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གནས་ཀྱི་རྒྱུར་གྱུར་པ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མིག་ལ་སོགས་པའི་ཤེས་པ་རྣམས་དང་།",
    "དེ་གཉིས་གཟུགས་ལ་སོགས་པའི་སྐྱེ་མཆེད་དམིགས་པའི་རྣམ་པར་སོ་སོར་སྣང་བ་དེ་བཞིན་དུ་གཉིད་ཀྱིས་མ་ལོག་པའི་དུས་ན་ཡང་ཕྱི་རོལ་གྱི་དོན་མེད་པར་གཉིས་རྣམ་པར་སོ་སོར་སྣང་ངོ།",
    "རྣམ་རྟོག་རྣམ་པར་ཤེས་པ་ལས།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པར་རྣམ་པར་སྤངས་པའི་ཕྱིར་རོ།",
    "སྙན་པ་ལ་སོགས་པའི་དབྱངས་སྣ་ཚོགས་པ་རྣམ་པར་རྟོག་པ་ནི་བརྗོད་པ་ལ་རྣམ་པར་རྟོག་པའོ།",
    "དེ་ལྟ་བུའི་གང་རྣམ་པར་རྟོག་པའོ།",
    "གང་ཆུང་ཟད་མྱ་ངན་གྱི་སྨིག་རྒྱུ་ལ་སོགས་པ་ཆུར་འཁྲུལ་བའི་རང་བཞིན་རི་དྭགས་སྐོམ་པ་ལྟ་བུའི་སྨྲ་བར་བྱ་བ་དེ་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ལ་སོགས་པ་གཉིས་ཀྱི་རྣམ་པར་སྣང་བ་རྣམ་པ་དེ་ལྟ་བུ་ལ་རང་བཞིན་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "གང་ན་འཐད་པ་ཞེས་བྱ་བར་ཀློག་པ་ལ་དེར་རྒྱུའི་མཚན་ཉིད་ཁྱབ་པར་སྨྲ་བ་ནི་གང་ཟེ་རྣམ་པ་དེ་ལྟ་བུ་ཡིན་པའམ།",
    "འཐད་དོ་ཞེས་རང་བཞིན་གསུམ་གྱི་མཚན་མ་ལ་དེ་ལྟར་གསུང་བར་དགོངས་པར་རྟོག་གོ།",
    "རྩོད་པའི་རྣམ་པར་གཟུད་པའི་དུས་ན་བདག་མེད་དོ་ཞེས་བསྟན་པར་བྱ་སྟེ།",
    "བདེ་བ་དང་སྡུག་བསྔལ་དུ་པྱོང་བ་ཐ་དད་པར་དབྱེ་བ་ན་ཆུད་པ་མ་གཏོགས་པར་དམིགས་སུ་མེད་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་གསུངས་པ།",
    "འདི་ནི་མེད་དོ་ཞེས་པར་མཚན་ཉིད་རྟོག་འུཔར་བྱེད་དེ།",
    "སྒྱུ་མའི་གནས་ནི་རྣམ་པར་རྟོག་པའི་རྣམ་པ་དུ་མར་གང་སྣ་ཚོགས་སུ་ཕྱི་རོལ་གྱི་མཛེས་པ་དང་།",
    "འདུས་པའི་གཟུགས་ལ་གཟུགས་སམ་གཟུགས་ལ་སོགས་པ་ཡོད་དོ་ཞེས་ཐ་དད་པར་བརྟགས་པ་ནི་གཟུགས་ལ་སོགས་པ་མ་གཏོགས་པར་རྫས་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་དེ་དག་མ་གཏོགས་པར་གཅིག་པུ་ཉིད་མི་སྲིད་ལ།",
    "དེ་ལྟར་ན་ཐ་དད་པ་དང་ཐ་དད་པ་མ་ཡིན་པར་ཐ་སྙད་དུ་བྱའོ།",
    "ཐ་དད་པར་གང་རྟོགས་པ་དེ་ནི་མི་རུང་ངོ།",
    "འདུས་པའི་གཟུགས་ལ་སྒྱུ་མའི་གཟུགས་གཅིག་ཏུ་ངེས་པས་ན་ཐ་དད་པར་དམིགས་སུ་མེད་པའི་ཕྱིར་ཐ་དད་པར་ཡང་མི་རུང་ངོ།",
    "དོན་དམ་པར་ན་གཉིས་ཀ་ཡང་མེད་ཅེས་དགོངས་པའོ།་།",
    "འཇིག་རྟེན་ཆགས་པ་ལྟར་ཡོད་པ་དང་མེད་པ་ལྟར་སྟིམི་ཆགས་པར་བྱའོ་ཞེས་དེའི་ཕྱིར་གསུངས་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "རྟོག་པ་ལ་ནི་རྣམ་པར་འཇུག།",
    "ལས་ལ་སོགས་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་རྗེས་སུ་རྟོག་པའོ།",
    "ནོར་པའི་རྣམ་པར་སྒྲའི་དོན་སྤྱིར་འཛིན་པར་བྱེད་དེ།",
    "བདག་ཉིད་ལ་བདག་ཉིད་ཀྱིས་རྣམ་པར་མི་རྟོག་ཅེས་སོ།",
    "གང་ན་བརྟགས་པར་ཀློག་པ་དེར་དེ་ཡོད་པ་ཉིད་ནི་རྟ་ལ་རྟོག་པ་ཡང་བ་ལང་མཐོང་བའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "དོན་དམ་པའི་བདེན་པ་ཚིགས་སུ་བཅད་པ་སྤྱིར་གསུངས་པ།",
    "དེ་བཞིན་དུ་མཚན་མ་ཡང་གང་དོན་སྣ་ཚོགས་སུ་བྱ་བ་བྱེད་པར་གཟུགས་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་བར་ཀུན་རྟོག་པ་དེ་ལྟ་བུ་དེ་ཡང་ཕྱོགས་ཀྱི་ཆ་ཐ་དད་པར་དབྱེ་བ་ན་མི་འགྲུབ་པ་ནི་གཟུག།",
    "རྫས་ལ་སོགས་པར་རྟོག་གོ།",
    "རྣམ་པར་སྤངས་པ་དག་པ་ནི།",
    "གྲུབ་པ་དེ་བཞིན་ཉིད་པར་བསྟན།",
    "དེ་བསྒྲུབ་པར་མཛད་པ།",
    "རབ་རིབ་ཅན་ལ་སོགས་པའི་གཟུགས་ཀྱིས་ཡང་དག་པར་རིག་པ་ལ་སྒྲིབ་པ་བཞིན་ནོ།",
    "མི་ཤེས་པའི་མུ་སྟེགས་ཅན་རྣམས་ཀྱི་བྷུ་ཡན་ལག་ཅན་གྱི་རྫས་ཡན་ལག་རྣམས་ལས་ཧཱུཾསྐྱེས་སོ་ཞེས་སྨྲས་པའི་དོན་དེ་ཉིད་གསུངས་པ།",
    "དོན་དམ་པའི་བདེན་པའི་གྲུབ་པ་མི་གཉིས་པར་ཡང་དག་པར་རིག་པའོ།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སྣང་བ་མེད་ཅིང་དོན་དམ་པའི་བདེན་པ་གཉིས་སུ་མེད་པར་ཡང་དག་པར་རིག་པའི་དངོས་པོ་ནི་རྣམ་པར་མི་རྟོག་པ་སྟེ།",
    "དེའི་ཏིང་ངེ་འཛིན་ལས་བཞེངས་ཏེ་སྣང་བ་དང་བཅས་པའི་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པ་རྣམས་ལ་སྣ་ཚོགས་ནི་དངོས་པོ་གཅིག་ཏུ་སྣང་ངོ།",
    "རྒྱུ་སྤུན་ལ་སོགས་པ་མ་གཏོགས་པར་སྣམ་བུ་ལ་སོགས་པའི་རྫས་ཀྱི་ཐ་སྙད་མེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ན་ཡང་གང་གཅིག་ཡིན་པ་སྣ་ཚོགས་མ་ཡིན་པ་ཞེས་པ་དང་གསུངས་པ།",
    "དེ་མེད་པའི་ཕྱིར་སྣ་ཚོགས་སུ་ཤེས་པ་ཡང་ཡང་དག་པར་ན་ཡུལ་མེད་པ་ཉིད་དོ།",
    "འོན་ཀྱང་ནང་གློངས་པའི་མཐུ་ལས་འཁྲུལ་བའི་ཤེས་པ་སྣ་ཚོགས་ཀྱི་རྣམ་པར་གེསྣང་ངོ།",
    "རྣམ་པར་གཞག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "མི་གཉིས་པའི་ཆུད་པ་མེད་དོ་ཞེས་དེ་ལྟར་རྣམ་པར་རྟོག་པ་ན་ལེགས་པའི་ལམ་ལས་འཇིག་པར་འགྱུར་བ་ནི་རྙག་ཀྱེ་པར་འགྱུར་བ་སྟེ།་",
    "དེ་སྟེ་ནོར་པ་ལམ་དུ་འཇུག་པར་འགྱུར་རོ།",
    "བརྟགས་པ་དང་གྲུབ་པ་མེད་པར་སྐུར་པ་ལ།",
    "དེ་སྟེ་བརྟགས་པ་སྣམ་བུ་ལ་སོགས་པའི་རྫས་དངོས་པོའི་བདག་ཉིད་དུ་ཡོད་པ་མ་ཡིན་པར་གྱུར་ལ།",
    "གཞན་གྱི་རྒྱུ་སྲུན་ལ་སོགས་པའི་རྒྱུ་དོན་དམ་པར་དངོས་པོའི་རང་བཞིན་དུ་བདེན་ན་ནི་དེའི་ཚེ་དངོས་པོ་མེད་པར་དངོས་པོ་སྟེ་ཞེས་པར་རྟོག་པར་བྱེད་དོ།",
    "མིང་ནི་རྒྱུ་སྤུན་དང་སྣམ་བུ་ལ་སོགས་པར་བརྗོད་པ་སྟེ།",
    "རྡུལ་འདུས་པ་གཞན་གྱི་སྣང་བའི་གཟུགས་ལ་མཚན་མར་གཅིག་པར་སྒོ་བཏགས་པས་ན་ཀུན་བརྟགས་པ་ཉིད་དོ།",
    "ཞེས་པས་སྟོང་པའི་ཕྱིར་དེའི་ཚེ་ཤེས་པར་བྱ་བ་མེད་པས་ཤེས་པ་འཛིན་པར་ཡང་མི་འབྱུང་ངོ།",
    "མི་གཉིས་པར་ཡང་དག་པར་རིག་པའི་རང་བཞིན་དོན་དམ་པའི་དག་པ་གནས་པར་འགྱུར་རོ།",
    "ཀུན་བརྟགས་པ་ནི་རྣམ་པ་བཅུ་སྟེ་ཞེས་པ་ཀློག་པ་ནི་བརྗོད་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པའི་གྲངས་ཀྱིས་བརྟག་པ་བཅུ་གཉིས་སུ་ཀླག་པར་བརྟག་གོ།",
    "ཅེས་པ་ནི་རྣམ་པའི་དོན་དུ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལུས་དང་ལོངས་སྤྱོད་དང་གནས་སུ་སྣང་བ་ཁམས་བརྒྱད་དུ་བརྟག་ཕྱེཔར་བརྟག་གོ།",
    "རྣམ་པར་རྟོག་པ་དང་ཡང་དག་པའི་ཡེ་ཤེས་དང་།",
    "དེ་བསྒོམས་ན་ཞེས་པ་ནི་བླང་བ་དང་དོར་བའི་ཁྱད་པར་ཀྱིས་སོ།",
    "བརྗོད་པ་སྤྱིར་རྣམ་པར་རྟོག་པ་གཉིས་ཀྱི་རྣམ་པའོ།",
    "གཉིས་ཀྱིས་སྟོང་ཞིང་གཉིས་སུ་མེད་པར་ཡང་དག་པར་རིག་པ་ལས་གྲུབ་པའི་རང་བཞིན་མེད་ན་དེ་ཇི་ལྟར་གཟུང་བ་དང་འཛིན་པའི་མཚན་ཉིད་ཀྱིས་གཉིས་ཀྱི་རྣམ་པའི་བློས་རྣམ་པར་བརྟགས་པ་ཡོད་པ་དང་མེད་པའི་རྣམ་པར་རྟོག་པས་སྤངས་པའོ།",
    "གྲུབ་པའི་དངོས་པོ་ཡོད་དེ་ཕྱོགས་གོས་ཀྱི་རང་བཞིན་ལ་དངོས་པོ་དང་དངོས་པོ་མ་ཡིན་པར་གཉིས་སུ་བརྟགས་པ་ལྟ་བུ་དང་།",
    "སྤྱོད་པ་ཅན་རྣམས་ཀྱི་ཐ་དད་པ་དང་ཐ་དད་པ་མ་ཡིན་པར་བརྟགས་པ་ལྟ་བུ་ཡང་མ་ཡིན་ཏེ།",
    "བརྗོད་པའི་རྣམ་པར་རྟོག་པ་མེད་དོ།",
    "དེས་ན་མི་གཉིས་པའི་ཏིང་ངེ་འཛིན་ཀྱི་དུས་ན་དངོས་པོ་དང་དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པ་སྤངས་པའི་མྱོང་བར་གྲུབ་པའི་དངོས་པོ་ཡོད་དོ་ཞེས་ཐམས་ཅད་མཁྱེན་པས་དགོངས་པར་རྟོག་གོ།",
    "སྣ་ཚོགས་ཀྱི་ཕྱིར་དེར་རིགས་མཐུན་པའི་རྣམ་པར་སྒོ་འདོགས་པ་རྣམ་པར་རྟོག་པ་འབྱུང་ངོ།",
    "འོན་ཀྱང་གཉིས་ཀྱི་རྣམ་པས་སྟོང་པ་ལ་སོགས་པའི་གཅིག་པར་སྒོ་བཏགས་ཏེ་འཇུག་པའི་མཚན་མ་སྟོན་ཏོ།",
