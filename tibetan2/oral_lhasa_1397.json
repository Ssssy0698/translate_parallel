    "རི་རབ་རྒྱ་མཚོ་ལས་ཀྱང་ལྷག་པར་གསུངས།",
    "མི་གཙང་ས་ལུད་ཕྱགས་པའི་བྲན་དུའང་གྱུར།",
    "སྔོན་ཆད་མ་བྱིན་པ་དང་མ་བསྡད་པའི།",
    "གནས་དེ་གང་ནའང་ཡོད་པ་མ་ལགས་ཤིང་།",
    "སྔོན་ཆད་མ་བྱས་པ་དང་མ་མྱོང་བའི།",
    "དགེ་སྡུག་བདེ་སྡུག་གང་དེའང་ཡོད་མ་ལགས།",
    "སྲིད་པ་གཞན་དུ་དེ་ལས་བཟློག་པར་མཆིས།",
    "མཐར་ཐུག་ངེས་པར་ལེགས་པའི་གོ་འཕང་མཆོག།",
    "བཤེས་གཉེན་དམ་པ་གུས་པས་བསྟེན་པར་འཚལ།",
    "རྣམ་པར་དཔྱད་དེ་ངེས་པར་འཛིན་པའོ།",
    "རྣམ་པར་དཔྱོད་པ་ཤེས་ལྡན་རྣམས་ཀྱི་ལུགས།",
    "རྒྱུ་འབྲས་བསླུ་བ་མེད་པར་བདེན་པ་སྟེ།",
    "ནུས་པར་སྣང་བ་ཡང་དག་ཀུན་རྫོབ་ལགས།",
    "ཡེ་ཤེས་སྐུ་ནི་དོན་དམ་བདེན་པ་ལགས།",
    "རང་བཞིན་རྣམ་དག་དོན་དམ་བདེན་པ་ལགས།",
    "སྣ་ཚོགས་གསུངས་པའི་དགོངས་པ་མི་ཤེས་པས།",
    "ཐོབ་པར་བྱ་དང་བསྟེན་པར་བྱ་ཕྱིར་བསྟན།",
    "འབྲས་བུ་འགྲུབ་པའང་དམན་པར་གང་གྱུར་པ།",
    "ཉན་རང་ཞི་བདེ་དག་ལའང་འགོད་པར་མཛད།",
    "ཤིན་ཏུ་རྒྱས་པའི་མཚུངས་མེད་དམ་པ་ལགས།",
    "ཤེས་རབ་བསླབ་པ་ལགས་པས་སྤེལ་འཚལ་ལོ།",
    "རྟག་ཏུ་འགྲོ་ལ་ཕན་པར་ཞུགས་པ་སྟེ།",
    "མ་བྱིན་ལེན་དང་ལོག་པར་གཡེམ་པ་དང་།",
    "རྫུན་དུ་སྨྲ་དང་མྱོས་པར་འགྱུར་བའི་ཆང་།",
    "གླུ་གར་ལ་སོགས་སྤོང་བ་བསྙེན་གནས་ལགས།",
    "སོར་བཤགས་བཞི་དང་ཉེས་བྱས་བརྒྱ་བཅུ་གཉིས།",
    "ལ་སོགས་སྤང་བ་དགེ་སློང་སྡོམ་པར་གསུངས།",
    "རྟག་ཏུ་གཞན་ལ་ཕན་པར་སྤྱོད་པ་དང་།",
    "ཕན་དང་བདེ་བའི་ཁྱད་པར་ཤེས་པ་ཡིས།",
    "སྤང་ཞིང་གནང་བ་རྣམས་ནི་བསྟེན་པ་འོ།",
    "རྣལ་འབྱོར་མ་ཀུན་མཉེས་པར་བྱེད་ལ་སོགས།",
    "རྒྱ་ཆེར་གསང་བའི་རྒྱུད་ལས་གསུངས་པ་ལྟར།",
    "ཟད་བྱེད་གཅེར་བུ་པ་སྟེ་ལྔ་རུ་གསུངས།",
    "རྟ་གཙང་མཆོད་སྦྱིན་བྱས་པས་མཐོ་རིས་ཀྱི།",
    "འདུས་བྱས་མི་རྟག་ཉིད་དུ་གྲུབ་ཕྱིར་རོ།",
    "སྲོག་ཆགས་བསད་དེ་མཆོད་སྦྱིན་བྱས་པ་ལས།",
    "ཀུན་ལ་ཁྱབ་པར་འགྲོ་བ་ཡིན་ཕྱིར་རོ།",
    "སེམས་སྐྱེ་བ་ཡི་ནུས་པའང་མེད་པར་མཚུངས།",
    "དེས་ན་ཚུར་རོལ་མཛེས་པར་སྨྲ་བ་ཡི།",
    "ཕྱུགས་ཀྱིས་མཆོད་སྦྱིན་བྱས་ན་དེ་མཉེས་ཏེ།",
    "ཡན་ལག་བཅད་ན་སྲོག་ཀྱང་ཉམས་པར་འགྱུར།",
    "སྲོག་ཀྱང་དེ་ལྟར་གྱུར་ན་རྟག་པར་འགལ།",
    "གདུགས་ཀྱི་རྣམ་པ་རྟག་པར་འདོད་ན་ཡང་།",
    "འབྲས་བུ་ལ་སོགས་སྐྱེད་པར་བྱེད་པའི་ཕྱིར།",
    "སྲོག་དང་བཅས་པར་འདོད་པའང་མི་འཐད་དེ།",
    "བུར་ཤིང་དུམ་བུ་དུ་མར་བྱས་པ་ན།",
    "དུམ་བུ་གཞན་རྣམས་སྲོག་དང་མི་ལྡན་པར།",
    "བདེན་པར་སྨྲ་དང་ཚངས་པར་སྤྱོད་ལ་སོགས།",
    "མཁས་པས་སུན་དབྱུང་པར་ཡང་མི་བྱའོ།",
    "འདུས་མ་བྱས་གསུམ་རྟག་པའི་རྫས་གྲུབ་དང་།",
    "འདུས་བྱས་སྐད་ཅིག་ངོ་བོར་རྫས་གྲུབ་ཅིང་།",
    "ཁྱད་པར་ལྡན་མིན་འདུ་བྱེད་རྫས་གྲུབ་དང་།",
    "གང་ཟག་བདེན་པར་འདོད་པ་མི་འཐད་དེ།",
    "ཡུལ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཡིན་གྱི།",
    "འདུས་མ་བྱས་གསུམ་མེད་དགག་ཡིན་པས་ན།",
    "དུས་གསུམ་འདུས་བྱས་སྔ་ཕྱི་ལ་ལྟོས་ནས།",
    "བཏགས་པ་ཡིན་གྱི་རྫས་གྲུབ་མིན་པར་འདོད།",
    "ངོ་བོར་གྲུབ་པ་མེད་པར་འདོད་ན་ཡང་།",
    "མཚུངས་པར་ཅི་ཡང་མེད་པ་མ་ཡིན་ཏེ།",
    "དོན་ཡང་བདེན་པར་ཡོད་པ་མ་ཡིན་ལ།",
    "དོན་ལ་བདེན་པར་འདོད་པ་མ་ཡིན་ཏེ།",
    "འགྱུར་མེད་ཡོངས་གྲུབ་དོན་ལ་གནས་པར་བཞེད།",
    "གོང་མ་གོང་མའི་མཆོག་ཏུ་ཤེས་པར་བྱ།",
    "ཞི་བདེ་ལ་ཡང་རིམ་གྱིས་འགོད་པར་མཛད།",
    "འཁོར་ལོ་བར་པར་དངོས་འཛིན་དགག་པའི་ཕྱིར།",
    "མཐུན་པར་གང་ལ་གང་འདུལ་སྟོན་པས་ཟབ།",
    "མཐར་ཐུག་སྟོན་པས་ཕྱི་མ་མཆོག་ཏུ་གསུངས།",
    "གཉིས་མེད་རྩ་བའི་རྒྱུད་རྣམས་མཆོག་ཏུ་གསུངས།",
    "གདོད་ནས་ལྷུན་གྱིས་གྲུབ་པར་གནས་པ་ལ།",
    "དག་པ་གཉིས་ལྡན་འབྲས་བུའི་རྒྱུད་ཅེས་གསུངས།",
    "དོན་དམ་བདེ་སྟོང་ཟུང་འཇུག་སྟོན་པར་མཚུངས།",
    "ལེགས་པར་བརྟགས་ཏེ་ཚུལ་མིན་རྣམ་རྟོག་སྤང་།",
    "ཟས་ཀྱི་ཚོད་ཀྱང་རིག་པར་བྱ་སྟེ་བསྟེན།",
    "ཚོགས་ལམ་ཆུང་ངུར་ལུས་འདི་མི་གཙང་ལ།",
    "རྫུ་འཕྲུལ་རྐང་པ་བཞི་ལ་གནས་པར་བྱ།",
    "མི་མཐུན་ཕྱོགས་ཀྱིས་རྫི་བ་མེད་པར་བསྒོམ།",
    "གཟུང་འཛིན་གཉིས་ཀ་མེད་པར་རྟོགས་པ་ཡི།",
    "གོམས་པར་བྱེད་ཅིང་ས་དགུ་ཟག་མེད་ལ།",
    "གོ་འཕང་ཕུན་སུམ་ཚོགས་པ་ཐོབ་པར་འགྱུར།",
    "བརྒྱད་པ་ཡན་ཆད་གྲུབ་པའི་ས་ཞེས་གསུངས།",
    "གོང་ནས་གོང་དུ་ཁྱད་པར་འཕགས་པ་ཐོབ།",
    "དེ་བརྒྱ་སྣང་བྱེད་འགྲོ་བརྒྱ་སྨིན་པར་བྱེད།",
    "རྣམ་དག་བསླབ་པ་གསུམ་ལ་རྣམ་པར་གནས།",
    "ཟག་མེད་ཕུང་པོ་ལྔ་ཡང་རྣམ་པར་སྦྱོང་།",
    "ཕ་རོལ་ཕྱིན་བཅུ་རྣམ་པར་དག་པ་ཐོབ།",
    "ཞི་གནས་ལྷག་མཐོང་ཡོན་ཏན་རྣམ་པར་འཕེལ།",
    "དོན་གཉིས་འབད་མེད་ལྷུན་གྱིས་གྲུབ་པར་གསུངས།",
    "རྒྱུན་མི་འཆད་པར་གདུལ་བྱ་དག་པ་ལ།",
    "ལེགས་པར་སྟོན་མཛད་ལོངས་སྤྱོད་རྫོགས་སྐུའང་འགྲུབ།",
    "སོ་སོར་རྟོགས་པའི་ཡེ་ཤེས་འགྲུབ་པར་འགྱུར།",
    "གཞན་དོན་བྱ་བ་བསྒྲུབ་ལ་བརྩོན་བྱས་པས།",
    "དྲི་མ་དག་པས་མངོན་དུ་འགྱུར་བར་གསུངས།",
    "ཀུན་འགྲོའི་ལམ་དང་བསམ་གཏན་ཁྱད་པར་དང་།",
    "མངོན་སུམ་མཁྱེན་པས་ཐབས་དང་སྐྱབས་དང་ནི།",
    "ཤེས་རབ་དང་ནི་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཚིམ་བྱེད་ཡོན་ཏན་རྣམས་ཀྱང་འགྲུབ་པར་གསུངས།",
    "དཔེར་ན་ལྷ་ཡི་རྔ་ཆེན་འབད་མེད་པར།",
    "ཆར་གྱིས་ལོ་ཐོག་སྨིན་པར་བྱེད་པ་ལྟར།",
    "དཔེར་ན་ནོར་བུ་རིན་ཆེན་འབད་མེད་པར།",
    "ཁྱད་པར་ལྟ་བའི་སྙིགས་མར་གྱུར་བས་ན།",
    "ལྟ་སྒོམ་སྤྱོད་པ་རྣམ་པར་དག་པ་ཡིས།",
    "གོ་འཕང་མཆོག་ལ་དམིགས་ཏེ་འབད་བྱས་ནས།",
    "བསྒྲུབ་པར་ནུས་ལ་འདོད་པའི་དད་པ་སྟེ།",
    "བསམ་གཏན་གསུམ་ལའང་རིམ་གྱིས་མཉམ་པར་བཞག།",
    "ཁྱད་པར་གཞན་དོན་བསྒྲུབ་ཚུལ་མཁས་པ་ཡི།",
    "ཤེས་རབ་གསུམ་ཡང་རྣམ་པར་སྤེལ་འཚལ་ལོ།",
    "གཞན་ལ་ཕན་པར་སྤྱོད་པའི་ཆ་རྣམས་ནི།",
    "ཐམས་ཅད་ཡེ་ཤེས་ཚོགས་སུ་འགྱུར་བར་གསུངས།",
    "བསྒོམས་ཏེ་ཡེ་ཤེས་ཚོགས་ལ་འབད་པར་བྱ།",
    "དེ་ལྟར་ཚོགས་གཉིས་བསྒྲུབ་ལ་འབད་པར་འཚལ།",
    "བྱ་བ་གང་ཡིན་ལེགས་པར་ཡོངས་བརྟགས་ཏེ།",
    "ཕན་པར་འགྱུར་བ་རྟག་ཏུ་བསྟེན་འཚལ་ལོ།",
    "བཞུགས་པའི་སྤྱན་སྔར་འདུན་པ་དྲག་པོ་དང་།",
    "བྱས་ཚུལ་དཀར་ཆག་ནང་ནས་གསལ་བ་རྣམས།",
    "འབྲི་ཞིང་ཐུགས་ཉམས་སུ་ཡང་བཞེས་པ་དང་།",
    "དོན་གཉེར་གཞན་ལའང་བསྐུལ་ཞིང་གནང་བ་ཡིས།",
