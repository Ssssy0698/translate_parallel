    "བོད་ཁམས་མུན་པར་རྟོག་པའི་མ་རུངས་པ།",
    "ཐུབ་བསྟན་རྩེ་དགའ་ཐམས་ཅད་རྒྱས་པར་མཛོད།",
    "ཀུན་ཏུ་སྤྱོད་པར་མངའ་གསོལ།",
    "དགྲ་གསོད་གཤན་པར་མངའ་གསོལ་བ།",
    "སྡང་དགྲ་འདུལ་དང་ཕུན་ཚོཊ་ལེཌ་བྱས་དབལ།",
    "བསྟན་བསྲུང་ཇག་མེའི་གསོལ་ཁ་ཧཱུཾ་སྒྲ་བཅུ་དྲུག་བཞུགས།",
    "རྒྱ་མཚོ་ཆེན་པོ་བྱས་ཏེ་འབུལཾ།",
    "སུས་ཀྱང་ཚུགས་པར་མནུསསོ།",
    "བདག་ཅག་སྒྲུབ་པ་བོའི་ཁ་བཟུང་ཤགས་ཐོག་ལེགས་པ་བརྒྱ་དང་སྤྲོད།",
    "འཇམ་དཔལ་ཡེ་ཤེས་གྲུབ་པར།",
    "ཤེས་བྱ་ཀུན་མཁྱེན་ཞབས་ལ་གསོལ་བ་འདེབས།",
    "བརྒྱུད་འདེབས་གཅིག་བ་། དཔལ་ཡེ་ཤེས་མགོན་བའི་ལས་མཐའ་བོས་དགྲ་འཇོམས་པའི་སྤུ་གྲི་བཞུགས་སོ།",
    "ལིངྒ་གཏུབ་པའི་བར་བསྟེན་དུས་ཀྱི་གདབ་ལས་ལསོ་སོར་རུས་འདོན་པ་ཚོམས་ཁྱདཔར་མེད་དོ།",
    "དེ་ནས་འཕང་བའི་ཕྱིར་ཡིད་རོ་དེ་ལ་ཡིད་བརྒྱ་དང་ཉེར་གཅིག་པ་བརྒྱད་ཚན་བཤོས་བུ་དེ་དང་མཉམ་པ་ཟོར་གྱི་ཕྱིར་བཀོད་པ་ཉིན་ཕྱེད་ནས་བརྩམས་ཚོགས་ལས་བྱས་ནས།",
    "རིངས་པར་དེད་ལ་དྲག་ཏུ་གསོད།",
    "མགྱོགས་པར་ཁུག་ལ་ངེས་པར་གསོད།",
    "དེ་ཡི་རྣམ་པར་ཤེས་པ་བརྒྱད།",
    "། དགྲ་བགེགས་ཐམས་ཅད་བརླག་པར་བྱེད།",
    "འགུགས་པར་བྱེད་པའི་ལྕགས་ཀྱུ་ཐོབ།",
    "བཟློག་པར་དཀའ་བའི་དྲག་ཤུལ་ཅན།",
    "སྲིད་པར་དགེ་སྡིག་ཅི་སྤྱང་པའི།",
    "དགྲ་བོ་ཆམ་ལ་འབེབས་པར་འཚལ།",
    "ཏེལ་པ་རྣམ་པར་ཤེས་ལ་ཡ།",
    "དགྲ་བོའི་ལོ་ཐོག་བརླག་པར་མཛོད།",
    "དགྲ་བོའི་མདུན་མ་བཤིག་པར་འཕེན།",
    "ཡུལ་མཁར་ལོ་ཏོག་འཇོམ་པར་དབེན།",
    "གཏམ་སྙན་ཀུན་གྱིས་ཐོས་པར་སྒྲོགས།",
    "དེ་ཕྱིར་བད་དཀར་ཚལ་རྒྱུག་མི་བྱེད་པར།",
    "དཔལ་ཀླུ་ཡེ་ཤེས་ཀྱི་མགོན་པོའི་བསྙེན་དུས་དགོས་པའི་ཡི་གེ་ཉུང་ངུ་ཞིག་འགོད་པར་བྱ་སྟེ།",
    "ཚོགས་ཀྱི་མཆོག་གྱུར་ས་ལ་བཞུགས།",
    "ཕྱིན་ཆད་སྡིག་ལས་ལྡོག་པར་བགྱི།",
    "ཐུགས་རྗེས་དགོངས་ཏེ་བཞེས་ནས་བསྐྱབ་ཏུ་གསོལ་། སྟོན་པ་གསང་བདག་ཨིནྡྲ་བྷཱཏི་དང་།",
    "ཕག་གྲུ་ཞང་དང་གླིང་རས་གཙངཔ་རྒྱ།",
    "ཟླ་བ་ཕྱེད་པས་མཚན་པའི་རལ་པའི་ཐོར་ཚུགཅན་མི་མགོ་སྐམ་པོ་ལྔས་དབུ་བརྒྱན་ཅིང་རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པ།",
    "བརྒྱན་ཅིང་ཐུགས་ཀར་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཧཱུཾ་ཡིག་སྔོན་པོས་མཚན་པར་གྱུར།",
    "ཅེས་པས་བསྐོར་ཏེ་ངག་ཏུ་བཟླ་ལ་དེའི་ཚེ་སྔགས་བཅས་འོད་ཟེར་ལ་དཔལ་འཁོར་ལོ་སྡོམ་པ་ཡབ་ཡུམ་གྱི་སྐུ་བཞུགས་པ།",
    "བྷིལྷ་དང་བཅས་པ་འོད་དུ་ཞུ་ནས་རོ་བཅུད་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་གྱུར།",
    "དྲེགས་པའི་ལྷ་སྲིན་ཀུན་གྱིས་ཁེངས་བསྐྱུང་ནས།",
    "ཆེན་པོའི་ཟུར་ཕུད་རྣམས་ཀྱི་རྒྱན་བྱས་ཏེ།",
    "རང་མཐུས་བརྗོད་པར་མ་ནུས་ཉིདཾ་ལགས་ཀྱི།",
    "ཅེས་ཅོག་གྲྭ་བསྟན་པའི་ཉི་མས་གསུངས་སོ།",
    "བདེ་བའི་རྒྱུ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "སྡོམ་གསུམ་གཙང་མའི་མཆོད་ཡོན་ཀུན་ནས་འཁྱིལ།",
    "གཞོམ་དཀའི་འཆི་བདག་གཡུལ་ལས་རྣམ་པར་རྒྱལ།",
    "དཔལ་ལྡན་འབྲུག་པའི་བསྟན་པ་རྒྱས་པར་མཛོད།",
    "ཕྱོགས་ཀྱི་འཁོར་ལོ་གྲིབ་མས་རྣམ་པར་གནོན།",
    "དྲག་ཤུལ་ཆེན་པོས་དྲགྲ་བགེགས་འཇོམས་པར་མཛོད།",
    "ཞེས་གན་བཞུགས་ཀྱང་སྤྱན་འདྲེན་ནོ།",
    "ང་མེད་དོན་རྟོགས་སྤྱོད་ཡུལ་ལགས་ཞེས་བསྟོད།",
    "ཁ་ཙམ་མིན་པར་དམ་རྫས་ཀྱིས་བསྐང་ཞིང་།",
    "ཀ་དག་དབྱིངས་སུ་སྡུག་ཀུན་མཐོལ་ལོ་བཤགས།",
    "ཀུན་མཁྱེན་གསུང་།",
    "ད་ལྟ་སྙིགས་མ་ལྔ་ཡི་དུས་། གཤེགས་གྲོང་བཞུགས་པའི་གནས་ངན་ཡང་།",
    "ལྷ་མིན་གཡུལ་ངོ་ཕམ་པར་མཛད།",
    "དམ་ཚིག་ཡེ་ཤེས་གཉིས་སུ་མེད་པར་གྱུར།",
    "བཞུགས་སུ་གསོལ་བ་ནི།",
    "དགྱེས་པའི་ཚུལ་གྱིས་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "ཨོཾ་ཧྲི་ཤགྲ་རུ་རཾནཱ་ག་ཙིཏྟ་ཏྲཾ།",
    "འཁོར་ལྷ་མ་སྲིན་རྒྱ་མཚོ་ལྟ་བུའི་དབུས་ན་བཞུགས་པའི་སྤྱི་བོར་ཨོཾ།",
    "མགྲིན་པར་ཨཱ",
    "དམ་ཚིག་ཡེ་ཤེས་གཉིས་སུ་མེད་པར་གྱུར།",
    "དྲི་བཟང་ཆབ་ཀྱི་རྒྱ་མཚོ་རྣམ་པར་འཁྱིལ།",
    "གཙང་མའི་མཆོད་རྫས་མ་ཚང་མེད་པ་འདི།",
    "ལེགས་པར་བསྲུང་ཞིང་སྐྱོབ་པའི་ཕྲིན་ལས་མཛོད།་",
    "འཆི་མེད་བདུད་རྩིར་བྲཞུ་བས་དགྱེས་པར་འཚལ།",
    "བོས་ན་བྱོན་པར་ཁས་བླངས་དམ་བཅས་། འབཞིན་། དེ་རིང་བུ་ཡིས་སྒྲུབ་པའི་གནས་མཆོག་འདིར།",
    "ལྷག་པར་ཁྲོས་པའི་མཐུ་རྩལ་ཅན།",
    "གསང་བའི་མཚན་ནས་འབོད་ལགས་ན།",
    "དེ་གསུམ་ཀའང་ཞབས་གཉིས་བརྐྱང་བསྐུམས་བསྒྲད་པའི་ཚུལ་གྱི་བཞུགས་པ།",
    "ཐམས་ཅད་ཀྱང་མཚོན་ཆ་སྣ་ཚོགས་པ་ཐོགས་ནས་གདུག་པ་ཅན་སྒྲོལ་བ་ལ་རིངས་པར་གཏུམ་ཞིང་རྔམ་དྲ།",
    "དངོས་འབྱོར་ཡིད་ཀྱིས་སྤྲུལ་བྱས་ནས།",
    "ཁྱད་པར་དུ་རྣལ་འབྱོར་པ་བདག་ཅག་དཔོན་སློབ་འཁོར་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་འགལ་རྐྱེན་བར་ཆད་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ཞི་ཞིང་མཐུན་རྐྱེན་བསམ་པའི་དོན་ཐམས་ཅད་ཡིད་བཞིན་དུ་འགྲུབ་པར་མཛད་དུ་གསོལ།",
    "བཅོལ་བའི་འཕྲིན་ལས་འགྲུབ་པར་མཛད།",
    "མནབ་འོས་འཁྱིལ་གྱི་གནངས་ཆེན་ནོར།",
    "ཁྲམས་ཅད་གཞོབ་ཀྱང་མེད་པར་སྲེག།",
    "སུས་ཀྱང་ཚུགས་པར་མི་ནུས་། བསྐུལ་བ་ནི།",
    "ལྷ་སྲིན་ཐམས་ཅད་འབངས་སུ་བཞག།",
