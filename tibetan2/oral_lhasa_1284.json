    "དོན་དང་མཐུན་པར་ཚུལ་བཞིན་མ་བྲིས་ཏེ།",
    "ཐུགས་རྗེས་ཚངས་པར་རབ་ཏུ་བཤགས་སུ་གསོལ།",
    "བཟོད་པར་གསོལ་ལོ་ཚདས་པར་སྩལ་དུ་གསོལ།",
    "མན་ངག་གཞུང་དང་འགལ་བ་བཟོད་པར་གསོལ།",
    "བློ་ཞན་དོན་མ་རྟོགས་པ་བཟོད་པར་གསོལ།",
    "ཚོགས་ལ་གཡོ་སྒྱུ་བྱས་པ་བཟོད།",
    "ཉམས་ཀྱི་དྲོད་མ་སྐྱེས་པ་བཟོད་པར་གསོལ།",
    "དང་པོ་སྒྲུབ་དང་བསྒྲུབ་པོར་བྱས་ནས་ནི།",
    "བཀའ་ཡི་ཆད་པའི་གནས་སུ་གྱུར་ལགས་ན།",
    "ཡེ་ཤེས་ཐུགས་རྗེ་ཅན་ལ་བཟོད་པར་གསོལ།",
    "ཐུགས་དང་འགལ་བར་གྱུར་པ་མཐོལ་ལོ་བཤགས།",
    "གནས་ལུས་ལོངས་སྤྱོད་མཐུ་སྟོབས་འཕྲུལ་བསམ་གྱིས་མི་ཁྱབ་པར་གྱུར་པ།",
    "རྨ་བྱའི་སྒྲོསནི་རྒྱན་ཆ་བྱས།",
    "ཅེས་རྒྱུད་ལས་གསུངས་སོ།",
    "ད་ལྟ་ཉིད་དུ་རྗེས་སྩོལ་བའི་ལམ་དེ་ཉིད་ལ་གནས་པར་ཤོག།",
    "ཅེས་པ་གདན་བཞིའི་རྒྱུད་ལས་གསུངས་སོ།",
    "ཅེས་སྐབས་དང་བསྟུན་པའི་ཤིས་བརྗོད་ཅི་རིགས་པར་བྱའོ།",
    "དེ་ལྟར་བསྙེན་པ་བྱས་ནས།",
    "ལོ་དང་ཟླ་བར་མ་བཞག་པར།",
    "རྒྱན་གྱི་གཏོར་མ་འདི་བཞེས་ལ།",
    "བཅོལ་བའི་འཕྲིན་ལས་འགྲུབ་པར་མཛོད།",
    "བསྟན་པ་བསྲུང་ཕྱིར་ལས་འདི་བསྒྲུབ་པར་བགྱི།",
    "དམ་བཅས་བཞིན་དུ་འཕྲིན་ལས་སྒྲུབ་པར་མཛོད།",
    "བསྟན་པ་བསྲུང་བའི་ལས་རྣམས་སྒྲུབ་པར་མཛོད།",
    "རྡོར་གླིང་འབྲུག་སྒར་དཔེ་མཛོད་འགན་འཛིན་གཉིས་ནས་གསར་བསྐྲུན་ཞུས་པར་ཐུགས་མཁོ་མཆིས་རིགས་འདི་གར་བཀའ་གནང་ཞུ།",
    "མཁའ་འགྲོའི་ཚོགས་ཀྱིས་བཟོད་པར་མཛོད།",
    "གཞན་ཡང་དགེ་སློང་ལས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་ཤེས་པ་དེ་འཐབ་བྲལ་བའི་ས་རྣམས་ལ་རྣམ་པར་ལྟ་༢བར་བྱེད་པ་ན།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་མཐོང་བར་གྱུར་པ་ནི་འཐབ་བྲལ་བའི་ལྷ་རྣམས་ཀྱི་ས་ཇི་ལྟ་བ་བཞིན་དུ་ཡོད་པ་བཞོན་༤པ་རྒྱ་ཆེ་བ་ལ་རྣམ་པར་རྒྱུ་བ་ཞེས་༐",
    "བཤེས་གཉེན་༧བདག་ཉིད་ལ་བདེ་ལེགས་སྟོན་པར་བྱེད་པས་ནི་དཔེ་མེད་པའི་༐",
    "ལྷ་རྫས་ཀྱི་འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་རྣམས་རྣམ་པ་དུ་མར་ཕུན་སུམཚོགས་པ་རྣམ་པར་བརྟག་པར་བྱ་བ་དུ་མར་གཞན་རྣམས་དང་མཚུངས་པ་མ་ཡིན་པའི་ལྷ་རྣམས་སུ་སྐྱེའོ་། ལྷ་རྣམས་ཀྱིས་ནགས་རྣམས་མཐོང་བས་ནི་མ་ཡིན་གྱི་ནགས་འདི་དག་ཏུ་ཞུགས་པ་ཙམ་ཉིད་ན་ལྷ་ཁྱེད་རྣམས་འདིར་ཤིན་ཏུ་ངོ་མཚར་བར་གྱུར་པར་མཐོང་བ་ཡིན་ལ།",
    "གང་ཡང་ལྷ་རྣམས་ཀྱི་མངའ་བདག་མུ་སུ་ལུན་དྷ་སྡོན་དུ་བྱས་ནས་ལྷ་འདི་དག་རྣམས་ན་ང་རྣམས་སུ་འཇུག་པར་གྱུར་པ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "༥ཏན་ལྔ་ཕུན་སུམ་ཚོགས་པའི་དཔལ་ལ་སྤྱོད་པར་བྱེད་པ་རྣམས་ཡིན་ཞིང་།",
    "དེ་ཡང་བདག་ཅག་ཐམས་ཅད་ཀྱི་མངའ་བདག་ཏུ་གྱུར་པ་ཕ་བཞིན་དང་མ་བཞིན་དུ་འཐབ་བྲལ་གྱི་ས་རྣམས་སུ་ལེགས་པ་༢སློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "རྒོད་པར་བྱེད་པ་རྣམས་ཀྱིས་ཀྱང་རྔ་སྒྲ་ཡན་ལག་ལྔ་དང་ལྡན་པས་ཕན་ཚུན་ཐབས་ཅིག་ཏུ་དགའ་བར་གྱུར་ཅིང་།",
    "གཞན་ཡང་ལྷ་དེས་མཐོང་བ་ནི་པད་མའི་ན་གས་དེ་དག་རྣམས་ན་རྣམ་པ་སྣ་ཚོགས་པའི་བྱ་རྣམས་ཆུ་ལ་རྒྱུ་བ་དག་ཀྱང་ཕན་ཚུན་དུ་དགའ་ཞིང་ཀུན་ཏུ་སྤྱོད་པར་ཡང་བྱེད་དོ།",
    "དེ་མཆོག་ཏུ་དགའ་བའི་དང་བར་གྱུར་པ་ཅན་གྱི་ཆུ་དེ་འཇུག་ངོས་༤རྣམས་ན་ལྷ་དེ་རྣམས་ལ་ལ་ནི་གསེར་གྱི་འདབ་མ་ཅན་གྱི་པད་མ་བླངས་ན་ས་བདུད་རྩི་འཐུང་ཞིང་གླུ་༥ཡང་ལེན་པར་བྱེད་ད་དེ།",
    "པད་མའི་ནགས་དེ་དག་ཉིད་ཁོ་ན་ན་བལྟ་བར་བྱ་བའི་ཆེས་༩མཆོག་ཏུ་དགའ་བའི་ཡུལ་ལྔའི་ཡོན་ཏན་རྣམས་དང་ཡང་དག་པར་ལྡན་༐",
    "གླུ་ཡང་ལེན་པར་བྱེད་དེ་མཆོག་ཏུ་དགའ་བའི་ཡིད་དང་ལྡན་པས་སོ།",
    "ཁ་ཅིག་ནི་སིལ་མ་དང་ཡང་དག་པར་ལྡན་པའི་མེ་ཏོག་རྣམས་ཡོངས་སུ་བླངས་ནས་ལྷན་ཅིག་ཏུ་སྤྱོད་པ་རྣམས་དང་།",
    "བདག་ཉིད་ཀྱང་སྣོམ་༡༢པར་བྱེད་དོ།",
    "གསེར་དང་དངུལ་གྱི་རང་བཞིན་རྣམས་ལ་ད་གའ་བར་བྱེད་ཅིང་ཀུན་ཏུ་སྤྱོད་པར་ཡང་བྱེད་དེ།",
    "ཇི་སྲིད་དུ་འདོད་ཅིང་སྡུག་ལ་ཡིད་དུ་འོང་བར་འགྱུར་བའི་ལས་བྱས་ཤིང་བསགས་པ་རྣམས་༡༢ཟད་པར་མ་གྱུར་གྱི་བར་དུའོ།",
    "དེ་རྣམས་ནས་འཕོས་ནས་ལན་གྲངས་གཞན་ལ་རྨྱོང་བར་འགྱུར་བའི་ལས་རྣམས་ཀྱིས་གལ་ཏེ་མི་རྣམས་དང་སྐལ་བ་མཚུངས་པར་གྱུར་པའི་མིར་༢སྐྱེས་ན་ཡང་དེ་དག་ཏུ་གཞོན་ཤ་ཅན་དང་།",
    "གཞན་ཡང་དགེ་སློང་ལས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་ཤེས་པ་དེ།",
    "འཐབ་བྲལ་གྱི་ལྷ་རྣམས་ཀྱི་ས་ལ་རྣམ་པར་ལྟ་བར་བྱེད་པ་ན།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་འཐབ་བྲལ་བ་༤རྣམས་ཀྱིས་༥རྒྱུན་གནས་༦ན་རྣམ་པར་རྒྱུ་བ་ཞེས་བྱ་བ་ཡོད་༧པ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་ངོ།",
    "མ་བྱིན་པར་ལེན་པ་རྣམས་རྣམ་པར་སྤང་ས་ཤིང་ཀུན་ནས་ཡོངས་སུ་དག་པར་གྱུར་ལ།",
    "འདོད་པས་ལོག་པར་གཡེམ་པ་ཡང་མི་སྟེན་༩ཅིང་།",
    "གོམས་པར་མི་བྱེད་ལ་ལན་མང་༡དུ་བྱེད་པར་མི་འགྱུར་བ་ནི་འདི་ལྟ་སྟེ།",
    "སེམས་རྒྱུད་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པས་ཟིལ་གྱིས་ནོན་པར་གྱུར་ན་དེ་ཡང་ཕྱིར་སྤོང་བར་བྱེད་དོ།",
    "ཀུན་ཏུ་རྟོག་པར་མི་བྱེད་དོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་རྣམ་པར་འདོད་ཆགས་པའི་བག་ཆགས་༡༢སྟོང་ཕྲག་དུ་མའི་རྣམ་པར་རྟོག་པ་དང་།",
    "རྣམ་པར་རྟོག་པ་དུ་མ་དང་ལྡན་པའི་རོལ་ཆས་ལག་པ་བྲེལ་བ་རྣམས་ཏེ།",
    "འཐུན་པ་རྣམས་དང་རྣམ་པར་འབྲལ་བར་འགྱུར་བའི།",
    "རྣམ་པར་མི་རྟོག་པར་འགྱུར་བའི་གོ་སྐབས་དེ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "ལྷ་དེ་དག་ལ་ཉེ་བར་བརྟེན་ནས་རྣམ་པར་རྟོག་པ་དུ་མས་གླུ་ལེན་ཅིང་འཇོ་ཞིང་སྒེག་པར་ཡང་བྱེད་དོ།",
    "དེ་ན་ས་གསར་དུ་སྐྱེས་པས་སྔར་མ་མཐོང་བ་རྣམས་མཐོང་ནས་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ།",
    "དེ་ནས་སེམས་བསྐྱེད་པ་ཙམ་ཉིད་ན་དེ་ལྟར་ལེགས་པར་བྱས་པའི་ལས་ཀྱིས་བསྐུལ་ནས་གཞོན་ནུ་མ་དེས་འདི་སྐད་ཅེས་སྨྲས་༩ཏེ།",
    "གལ་ཏེ་ཇི་ལྟར་ཁྱེད་༢༢རྣམས་ཇི་ལྟ་༡༢བ་བཞིན་དུ་གལ་ཏེ་ངའི་ཡིན་པར་གྱུར་ན།",
    "དེ་དག་རྣམས་ཀྱིས་ཅིས་ཀྱང་བདག་ནགས་དང་ཉེ་བའི་ནགས་རྣམས་ཀུན་ཏུ་ལྟ་༡༢བའི་དོན་དུ་འབད་པར་བྱེད་པར་འགྱུར་བ་ཡིན་ལ།",
    "གཞོན་ནུ་ནགས་དང་ཉེ་བའི་ནགས་རྣམ་པ་དུ་མ་དག་རྣམས་རྣམ་པ་སྣ་ཚོགས་པའི་ལྷའི་ཚོགས་ཀྱིས་ལེགས་པར་གང་བ་མཐོང་ན།",
    "རྣམ་པ་དུ་མར་རྒྱགས་པས་གནས་ཉེ་བར་བསྟེན་པར་གྱིས་ཤིག།",
    "དེ་དག་ཕན་ཚུན་དུ་བརྡོས་པར་གྱུར་པས་ལྷ་དེ་དང་ཡང་ཕན་ཚུན་དུ་ལེགས་པར་མཐོང་ནས་ལྷ་དེ་དགའ་བ་ཉིད་སྐྱེས་ལ།",
    "ནགས་དེ་ན་ཡང་བརྒྱ་སྟོང་བྱེ་བ་ཁྲག་ཁྲིག་དུ་མའི་ཚོགས་པ་རྣམས་ཀྱིས་ལེགས་པར་གང་བ།",
    "མ་རྣམས་༩བརྟོལ་ཞིང་ཉམས་པ་མེད་པར་དེ་དག་རྣམས་གང་ནས་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཅེ་བར་གཞག་པ།",
    "ཆེན་པོ་མུ་སུ་ལུན་དྷའི་གནས་དེར་རབ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་ལེགས་པར་ཉེ་བར་འགྲོ་བར་བྱེད་དོ།",
    "མཉན་པར་བྱ་བ་རྒྱ་༥ཆེན་པོའི་སྒྲ་རྣམས་ཀྱང་ཐོས་པར་གྱུར་ཏེ་དགའ་བ་དང་།",
    "གང་ཡང་འདིར་རྣམ་པ་འདི་ལྟ་བུའི་ཅ་ཅོ་རྒྱ་ཆེན་པོ་སྙན་ཞིང་སྙོམས་ལ་རྣམ་པར་འདྲེས་པའི་སྒྲའི་ཚོགས་རྣམས་དང་གར་༧ཡང་ཐོས་པར་འགྱུར་རོ།",
    "དགའ་ལྡན་གྱི་མངའ་བདག་རབ་ཏུ་ཞི་བ་བཞིན་དུ་རྩེ་ཞིང་དགའ་ལ་ཀུན་ཏུ་སྤྱོད་པར་ཡང་བྱེད་དོ།",
    "གཞན་རབ་ཏུ་ཞི་བ་ཞེས་བྱ་བ་གཞན་གང་ལ་རྣམ་པ་འདི་ལྟ་བུའི་ས་དག་ཡོད་པར་གྱུར་པའི་དེ་གང་ཡིན་ན་ཞེས་ལྷ་དེས་ལྷན་ཅིག་སྤྱོད་པ་དེ་དག་རྣམས་ལ་སླར་སྨྲས་པ།",
    "༡༧པ་དེ་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ།",
    "གཟི་བརྗིད་ཀྱི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་དེ་བཞིན་དུ་དཔེ་མེད་པར་རྣམ་པར་འབར་རོ།",
    "དཔེར་ན་ཉི་མས་གཟའ་དང་སྐུར་མ་དང་རྒྱུ་སྐར་ཐམས་ཅད་ཀྱི་འོད་ཟིལ་གྱིས་མན་ན་ནས་རྣམ་པར་སྣང་བར་བྱེད་དོ།",
    "ལྷ་འདི་དག་རྣམས་ཀྱི་ལས་ཀྱི་ལམ་གོང་ནས་གོང་དུ་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་རྣམས་ལ་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "དེ་ནས་ལྷ་གསར་དུ་སྐྱེས་པ་དེ་བརྒྱ་ལ་ཅིག་ན་ཡང་འཐབ་བྲལ་གྱི་མངའ་བདག་དེ་དང་ཉེ་བར་རིམ་གྱིས་སླེབ་༢པར་གྱུར་པ་ན་ཇི་ལྟར་དེ་དག་གཙོ་བོར་གྱུར་པ་རྣམས་དང་གཟུགས་དང་ཆ་བྱད་དང་མདངས་དང་འོད་དང་ཚད་དང་ཤིན་ཏུ་༐"
  ]
}