    "མོ་གསར་བག་མར་འགྲོ་བའི་རྟགས།",
    "ཙྩཾ་ཉྙོ་༡ ཎཾ་སྣང་ས་འོད་འབུམ་ལས་དཔུང་ཚོགས་ཀྱི་ལྷག་མར་གྱུར་པ་དེ་རྣམས་ཀྱང་ཕྱོགས་དང་ཕྱོགས་སུ་སྟོབས་ཅི་ཡོད་ཀྱིས་བང་རྒྱུགས་ཏེ་བྲོས།",
    "ཁོ་རང་སེམས་སྐྱོ་བའི་ངང་ནས་ཡུལ་དུ་ལོག་ནས་སོང་ངོ།",
    "འགྲོ་བ་བཟང་མོ་ལས་ཨ་ཞང་ན་རེ།",
    "ཁྱེད་རང་མ་སྨད་ངའི་སར་སྡོད་ལ་ཞིང་གི་སོ་ནམ་གྱིས།",
    "དེའི་དུས་སུ་འདི་གསུམ་རེ་རེ་བཞིན་གཏོད་ཅིག་གསུངས།",
    "དེ་ཀླན་ཀ་འཚོལ་འདོད་ཀྱི་གཏམ་ཞིག་རེད།",
    "སྤྲེའུ་བློ་བཟང་གིས་འདི་སྐད་ཟེར་རོ།",
    "ཀྱེ་ཀྱེ་གོང་མོ་དང་ནེ་ཙོ་ཚུར་ལ་གསོན།",
    "གིས་གཞོན་ནུའི་བགྲོད་པ་འགོག་ཏུ་རེ་བའི་ཚིག་དེ་ལྟར་བརྗོད་པ་ན་རྒྱལ་བུས་ལན་སྨྲས་པ།",
    "ན་ནིང་གི་ལོ་དེ།",
    "དེབ་ཀ་པ་ལས་ལོར་སྐུ་ཞབས་སུན་ཀྲུང་ཧྲན་གྱིས་འགོ་ཁྲིད་གནང་བའི་ལྕགས་ཕག་ལོའི་གསར་བརྗེ་དེས་བཀས་བཀོད་རྒྱུད་འཛིན་གྱི་གོང་མའི་ལམ་ལུགས་ཤུལ་མེད་དུ་བཏང་སྟེ་ཀྲུང་ཧྭ་མི་སེར་རྒྱལ་ཁབ་གསར་དུ་བཙུགས་པ་རེད།",
    "ཟླ་སྟོད་ཕྱོགས་ལ་མཇལ་མོང་།",
    "སྣང་ས་འོད་འབུམ་ལས་ངོ། འགྲོ་བ་བཟང་མོ་ལས་དེའི་སང་ཉིན་ཉ་པ་དེ་མཚོ་མཐའ་ཞིག་ཏུ་གཉིད་ནས་བསྡད་ཡོད་པའི་ཚེ།",
    "ཀྵ་ཆུ་ངོགས་གཏམ་རྒྱུད་ལས་བུ་མོ་ཁྱོད་ནི་དེ་རིང་གང་ནས་ཡོང་།",
    "ཁྱོད་ལ་ཕ་མ་གཉེན་ཚན་ཇི་འདྲ་ཡོད།",
    "བུ་མོ་ཁྱོད་ཀྱི་མིང་ལ་ཇི་སྐད་ཟེར།",
    "མཁའ་ལམ་མི་གནས་གུང་དུ་ཕེབས་སོང་། ཚུཎཊྛ་༡ གཏམ་པད་མ་ཚལ་གྱི་ཟློས་གར་ལས་མ་འདྲིས་སྐྱེ་བོ་ལམ་དུ་འཕྲད་ཚད་ཀྱིས།",
    "ཚོ་ད་ཉམས་མྱོང་འབེལ་གཏམ་ལས་ཁྱོད་ཀྱི་སོར་རྩེ་ལས་བརྒྱུད་ནས།",
    "འདི་ནི་བྱེད་པོ་སུ་ཞིག་གིས།",
    "གཞོན་ནུ་མ་ཁྱོད་ལག་ཏུ་བྱིན།",
    "ཆུ་ཤིང་བསྟན་བཅོས་ལས་གུསུ་ཞིག་གང་གིས་འགྲན་ཟླར་གྱུར་པ་ནི།",
    "ཨ་མ་སྣང་ས་ཅིས་ཀྱང་བཞུགས་རོགས་མཛོད།",
    "གཞོན་ནུ་དྲུག་གི་རྟོགས་བརྗོད་ལས་ིརང་དང་གཞན་དོན་བྱེད་སྙམ་གང་ཡིན་ཡང་།",
    "མི་ཇི་ཙམ་ཉུང་ན་དེ་ཙམ་གྱིས་ཡག་གི་རེད་བསམ་གྱི་ཡོད་པ་དང་།",
    "རྒྱ་ཁྱོན་ཇི་ཙམ་ཆུང་དུ་བཏང་ན་དེ་ཙམ་གྱིས་ཡག་གི་རེད་བསམ་གྱི་ཡོད་པ་རེད།",
    "ཤུགས་ཀྱིས་གཞོན་ནུ་ཟླ་མེད་ག་ལ་བ་དེར་སོང་།",
    "བལྟས་མི་འདུག་བལྟས་ཡོད་པ་མ་རེད།",
    "སྐྱ་མིན་སེར་མིན་འགྲན་ཟླ་བྲལ་བ་འགྲན་ཟླ་མེད་པ་བྱེད་ཐབས་ཟད་པ་བྱེད་ཐབས་མེད་པ་ངས་གཏོང་གི་མིན།",
    "ཁོས་གཏོང་གི་མ་རེད།",
    "ཁོས་འཚོང་གི་མ་རེད།",
    "ཕྱི་འགྱངས་སོང་ན་གུས་མེད་དུ་གྱུར་བས་མི་འགྲོ་ཐབས་མེད་འདུག་ན་རྗེས་སུ་བཀའ་བསྟུན་ཞུས་ཆོག་པར་ཁྱེད་དགོངས་པ་དྭངས་པར་ཞུ།",
    "༦གཞོན་ནུ་དྲུག་གི་རྟོགས་བརྗོད་དེ་ནས་བདུད་མོ་ཤི་མ་རོ་ལ་མདའ་གྲི་མདུང་གསུམ་ཕྱོགས་བཞི་ནས།",
    "ཆར་འབབ་པ་བཞིན་བརྒྱབ་ནས་བདུད་མོ་བསད།",
    "བོད་ཀྱི་ཤིང་གི་བྱང་བུ་ལས་ལྷ་བཙན་པོ་ཁྲི་སྲོང་ལྡེ།",
    "མཐོ་བཙན་བྲག་དམར་ཁྱོད་ལ་མ་ཆགས་ན།",
    "གཡོ་ཅན་ཚིག་གིས་ཕ་རོལ་སླུ།",
    "ཆེ་ཐག་རྙིའི་སྒྲོག་གིས་མ་ཟིན་པ།",
    "༧བོད་རྒྱ་ཚིག་མཛོད་ཆེན་མོ་ལས་ཚིག་ཕྲད་ཁ་གསབ།",
    "བོད་རྒྱ་ཚིག་མཛོད་ཆེན་མོ་ལས་གྲག་དཔེ་དེ་རྣམས་གཏེར་དུ་སྦས་ཞེས་གྲུག་དེབ་དམར་གསར་མ་ལས་རྒྱུན་དུ་གཞན་གྱིས་བསྐྱུང་དགོས་པའི།",
    "བྱ་རོག་གིས་ནི་བཟུང་བ་ཡི།",
    "འདི་ཟོ་དང་ཞེས་སྨྲས་པས་ཟོ་དང་གོང་པོ་རི་དང་འདིར་རྩེད་མོ་རྩེས་དང་བྱས་པས་ཚེས་དང་དུ་མིང་ཆགས་ཞེས་གྲག་གོ།",
    "༥ ༦ ཏེ་ཏཱ་ཨཾ་མཁས་པའི་དགའ་སྟོན་ལས་གྲི་གུམ་གྱི་སྤུར་ཉང་ཆུར་བོར་ནས་ཀོང་པོར་ཁྱེར་སྟེ་ཀླུ་སྲིན་ཧོ་ཏེ་རེའི།",
    "བྲན་མོ་བྱེ་མ་ལག་རིང་ཞེས་པས་ཟིན།",
    "༡ རྒྱུ་བྱ་སྤྲེལ་གཏམ་རྒྱུད་ལས་པུ་ཏི་གུང་རྒྱལ་དང་བློན་ནུ་འུ་རུ་ལ་སྐྱེས་རྒྱལ་བློན་འདི་དག་གི་དུས་སུ་འཇིག་རྟེན་པ་རྣམས་ཞིང་ལ་སོ་ནམ་བྱེད་པའི་སྲོལ་དར་ཞིང་།",
    "འབྲི་ཁུང་པས་ཁོང་རང་རེ་མངའ་འོག་ན་ཡོད་པའི་ཞྭ་སེར་བ་རྣམས་ཞྭ་དམར་བར་གཏོང་ཟེར།",
    "༤ ཚོ་སྟག་གཟིག་གཡུལ་འཁྲུག་ལས་སྐད་ཕྱིས་ཇོ་བོ་ཨ་ཏི་ཤའི་ཞལ་ནས།",
    "ཙིཏྟཾ་༡ ཎ་ཊྛིཏཾ་ི་༡མཁས་པའི་དགའ་སྟོན་ལས་དད་ལོག་ཅན་གྱི་མི་དེ་ལ་ཉེ་དུ་ཞིག་གིས་གདོན་གྱི་ཕག་ཏུ་ཁྱུང་པོ་ཇོ་སྲས་གདན་འདྲེན་པའི་གྲོས་བཏབ།",
    "ཁོ་ན་རེ་རྨ་ལ་ཕན་ན་ཁྱིའི་ཚིལ་ཡིན་ནའང་ཚིལ་གྱིས་བོས་ཤོག་ཅེས་ཟེར་སྐུད།",
    "ཀྱེ་མ་ཀྱི་མ་ཁོ་བོའི་རྒྱལ་སྲིད་ཀྱི་བྱ་བ་བུད་མེད་ཀྱིས་ཤེས་སམ།",
    "རྒས་པར་གྱུར་པའི་སྡུག་བསྔལ་མི་བཟོད་པ་འདི་ལ་གཟིགས།",
    "ཎཾ་༢༩ གཞོན་ནུ་དྲུག་གི་རྟོགས་བརྗོད་ལས་ཀྱེ་ཧུད་ཀྱེ་ཧུད་རྒན་མོ་མི་སྡུག་ཁྲོ་གཉེར་མ།",
    "ཀུན་འགྲོའི་ལམ་དུ་ཁྱོད་ཉལ་མི་མཛེས་པས།",
    "ནི་གཏམ་པད་མ་ཚལ་གྱི་ཟློས་གར་ལས་ཀྱེ་མ་ཀྱི་ཧུད་ཀྱེ་མ་ཀྱེ་ཧུད་ཡུམ་ཁྱོད་གང་དུ་བཞུགས།",
    "བདག་གི་ངང་ཚུལ་འདི་ལ་གཟིགས་སུ་གསོལ།",
    "ཀྱེ་མ་ཀྱི་ཧུད་བུ་མོ་སེམས་པ་སྐྱོ།",
    "ཞེས་ཏེ་དེར་སོང་།",
    "རྫུཙྩ་ཀཾ་ད་རྨ་གཞོན་ནུ་དྲུག་གི་རྟོགས་བརྗོད་ལས་ག་ཨེ་མ་ཧོ་ཨེ་མ་ཧོ།",
    "ཆུཙྪཱ་ཧཾ་གྱི་༩༦༧ གཞོན་ནུ་ཟླ་མེད་ལས་ཨ་མ་མ་མ་རྔོན་པས་ནོར་བུ་སྤྱི་བོར་ཁྱེར་ནས་འདི་སྐད་དོ།",
    "ཨ་མ་མ་མ་འདི་འདྲའི་སེམས་ཉིད་ཀྱི་དགའ་བ།",
    "ཨ་མ་མ་མ་འདི་འདྲའི་སེམས་ཉིད་ཀྱི་སྐྱོ་བ།",
    "ཅེས་རྒྱལ་པོའི་སྟག་དོང་གི་དཀར་ཐག་ནས་བཟུང་སྟེ་སྤྱན་ཆབ་བསིལ།",
    "ཅི་མ་རུང་གཞོན་ནུ་ཟླ་མེད་དེ་ཉིད་ཀྱི་མིང་གི་སྒྲ་དབྱངས་ཙམ་ལའང་རྗེས་སུ་ཆགས་ཤིང་དེ་དང་ལྷན་ཅིག་ཏུ་མཛའ་བར་གྱུར་ན་ཅི་མ་རུང་སྙམ་པའི་བསམ་པ་ཐུན་མོང་མ་ཡིན་པ་ཁོ་ན་འཆར་བཞིན་པ་ཡིན།",
    "འཆི་མེད་བུ་མོ་སྟོང་ཕྲག་གི་མཛེས་པ་མ་ལུས་པ་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ཀྱང་།",
    "འདིའི་བརྒྱ་སྟོང་གི་ཆར་ཡང་བསྒྲུན་དུ་མེད་པའི་མཛེས་སྡུག་ཡོན་ཏན་ཡོངས་སུ་རྫོགས་པ།",
    "རྒྱུ་༡གཞོན་ནུ་ཟླ་མེད་ལས་ཨ་རེ་ཨ་རེ་མདང་དགོང་གི་ཆོ་འཕྲུལ་དེ་ཅི་ཡིན་ནམ་སྙམ་ནས།",
    "ཉམསཱཝ་ཏགསཚུ་ཚུ་༡ ཋཙྩཾ་གཏམ་པད་མ་ཚལ་གྱི་ཟློས་གར་ལས་ཧེ་ཧེ་ཧེ་ཉམས་རྟོགས་མེད་པའི་སྒོམ་ཆེན་རྒོད་རེ་བྲོ།",
    "རང་དོན་མི་འཁྱོངས་གཞན་དོན་ཡ་རེ་མཚན།",
    "རྨི་སྣང་ས་འོད་འབུམ་ལས་༧སྦལ་པ་ན་རེ།",
    "ཙིཏྟཾ་རྒྱུགོ་ཙྪཱ་གཏམ་པད་མ་ཚལ་གྱི་ཟློས་གར་ལས་སྐྱབུ་མོ་བདག་ལ་ཕ་མ་ལོས་ཀྱང་ཡོད།",
    "དེ་མ་བྱེད་ཟེར་བ་ལས་རེ་བདེན།",
    "ཅ་༤༤ཏཝཚ་བངཝ་༤ཡ་ག་ལ་ག་ལ་སྦྱོར་ཚུལ་ག་ལ་༡ ཚོ་ངས་ག་ལ་ཤེས་ཎྜཚོ་ཆ་ངས་ཤེས་ཀྱི་མེད་ཊྛིཏྟཾ་ལུ་སུང་གིས་སྟག་རྒོད་ག་ལ་ཡོད།",
    "དེ་ནི་རི་བོང་ཅལ་འདྲོག་རང་རེད་ཟེར་ནས་གཅིག་ལབ་རྒྱག་བཞིན་དུ་ཤར་རེར་སོང་།",
    "བདུད་མོ་ཤི་མ་རོ་ལ་མདའ་གྲི་མདུང་གསུམ་ཕྱོགས་བཞི་ནས་ཆར་འབབ་པ་བཞིན་བརྒྱབ་ནས་བདུད་མོ་བསད།",
    "༡ ཙྪ་ཙི་ཙ་བུ་མོ་སྣང་ས་སྐྱེ་འབྲས་ལེགས་ན་ཡང་།",
    "མི་ཆེན་དཔོན་པོའི་བཙུན་མོ་ག་ནས་ག་ལ་ཡོང་།",
    "བུ་མོ་སྣང་ས་ཅིས་ཀྱང་གཏོང་གྲོགས་མཛོད།",
    "འོ་ན་ཁྱོད་བུ་མོས་ཉི་མ་དེ་རིང་ནས་བཟུང་སྟེ།",
    "གཡག་ཆེད་པོ་ལ་མདའ་ཕྲ་མོས་འཕངས་ན་སོད་ཀྱང་།",
    "ཐ་མ་ནི་གཡགིས་བསྐོརད།",
    "ཚནྡྷོཙྪ་ཉྙོ་ལྕེ་ཚེ་༡ཏང་གི་སྒྲིག་ཡིག་ལས་ཧན་ཧྥུ་སྐྲག་ནས་བྲོས་རྩིས་བྱས་ཀྱང་བྲོས་ལོང་མ་བྱུང་བར་ཀོན་ཀུང་གིས་གྲི་གཅིག་བསྣུན་ཏེ་མགོ་ནས་རྐང་པའི་བར་ཕྱེད་གཤགས་བཏང་ཐོགདགྲ་དམག་རྣམས་ཀྱང་ཁ་ཐོར་དུ་བཏང་།",
    "བཅོ་ལྔ་དྲུག་འཐུས་ཐོག་རྟ་དམག་ལྔ་སྟོང་ཁྲིད་ནས་ནམ་སྐྱ་རེངས་ཤར་བ་དང་མཉམ་དུ་ཆས་ཏེ།",
    "འགྲོ་བ་བཟང་མོ་ལས་དེ་ནས་བཟུང་སྟེ་བྱ་སྤྲེལ་ཐམས་ཅད་ཀྱིས་དོན་དེ་ལས་འགལ་བ་མི་བྱེད་པའི་ཁར།",
    "༢༧ཁང་ཆེན་དམར་པོའི་རྨི་ལམ་ལས་ཀུའོ་ཀྲི་ཁྲེང་གིས་ལམ་སང་མགྱོགས་པོ་ཡར་གདན་འདྲེན་ཞུས་ཟེར་བ་དང་ཆབས་ཅིག་ཁོ་རང་ཡང་ཡར་ལངས་ཏེ་སྐུ་མགྲོན་བསུ་བར་ཕྱིན།",
    "རྣམས་བཀུག་ནས་ར་མོ་ཆེའི་གཙུག་ལག་ཁང་བཞེངས།",
    "དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་ལས་དེ་བཞིན་རྨ་དེ་བཞིན་ཟླ་དེ་མཚུངས་དུས་མཚུངས་དེ་ནས་ཙྪ་ནགས་ཚལ་ཤིན་ཏུ་མང་མོད་ཀྱང་།",
    "བཟའ་ཤིང་གི་ར་བ་སོགས་རྩི་ཤིང་ནགས་ཚལ་འཛོམས།",
    "དེ་ནས་ཚང་མ་འཇགས་ཉལ་གྱིས་སོང་བ་དང་།",
    "ཆུ་བོ་བརྒལ་རྒྱུ་ཟེར་བ་དེ་སྐད་ཆ་སྟོང་པ་ཞིག་རེད།",
    "ཙ་བྱ་མགྲིན་སྔོན་ཟླ་བ་ལས་དེས་ན་དེ་དག་ནི་བོད་དང་ཉེ་བ་མོན་ཡུལ་ཁ་ཅིག་ལ་བོད་ཀྱི་སྒྲར་བྱས་པ་དུ་མ་སྣང་བས་དེ་ལྟ་བུ་ཞིག་ཏུ་ཟད་དོ།",
    "མི་དམངས་ཀྱི་འཚོ་བའང་ཡག་ཏུ་ཕྱིན་པ་རེད།",
    "ད་ལན་རང་རེ་ལ་བདེན་པ་ཡང་མེད་འདུག་ཟེར།",
    "བྱ་སྤྲེལ་གཏམ་རྒྱུད་ལས་རྒྱང་མྱང་སྟོད་རི་ནང་པའི་མི་ངོ་བུ་མོ་ངོ་མ་ཡིན་པས་མི་ཚད་ཕྱི་ནང་ལས་ཀའི་འགན་འཁུར་ཚང་མ་བྱེད་ཀྱིན་ཡོད་པ་ཁྱོད་ཀྱིས་ད་དུང་མ་ཤེས་སམ།",
    "དེ་ལྟ་ནའང་མི་འགྱོད་དེ་ངའི་རེ་བ་རྣམས་ཡོངས་སུ་རྫོགས་པ་ཡིན་ནོ་ཞེས་སྨྲས།",
    "མ་འགྲིག་ངང་ལ་ལུས་སོང་ན།",
    "ད་༩ འགྲོ་བ་བཟང་མོ་ལས་གཞོན་ནུ་ཟླ་མེད་གཅིག་པོར་གཤེགས་པ་འདི་ལྟ་ན་ནགས་ཚལ་གྱི་ཀླུངས་ཆེན་པོར་འཇུག་པ་ལྟ་ཞོག་ལམ་ཡང་མི་བརྡོལ་ཏེ།",
    "སྐུ་ལུས་ཀྱང་གྲང་མོར་སོང་ནས་ཚེ་མ་ཟིན།",
    "རང་ཉིད་ཀྱི་བྱ་བ་ཕྲ་མོ་ཙམ་ལའང་བློ་གྲོས་རྨོངས་པ་བགྲང་བའི་ཁུར་གྱིས་དུབ་པ།",
    "མནལ་བ་ཙམ་ཞིག་ལས་དོན་གཉེར་མེད་པ་ཡིན་མོད།",
    "ཐབས་ཤེས་སྟབས་བདེ་ཞིག་སྤྱད་ནས་ཐག་གཅོད་བྱས་ན་ཕན་རྒྱུ་ཕར་བཞག་གནོད་པ་ཧ་ཅང་ཆེན་པོ་ཡོང་གི་རེད།",
    "བ་ཙི་ཚེ་གལ་ཏེ་སུ་ཞིག་གིས་གསར་བརྗེ་བྱེད་སྐབས་སུ་ཐོགས་ཐུག་མེད་པ་དང་།",
    "མི་དེ་རླབས་ཆེན་གསར་བརྗེ་པ་ལུའུ་ཞུན་གིས་གསུངས་པ་ལྟར།",
    "ཁྱེད་མ་སྨད་གསོ་རེས་བྱེད་ཟེར།",
    "དེའི་སྔོན་ལ་བྱུང་བ་ཞིག་མ་རེད།",
    "དེབ་ཀ་པ་ལས་ཀྱི་མགོ་ཐོག་ཏུ་བསྡད་མི་ཆོག་༩ ༩ ཀྲུང་གོའི་གུང་ཁྲན་ཏང་གི་སྒྲིག་ཡིག་ལས་ལྷ་སྲས་ཡིད་འཕྲོག་ལྷ་མོ་སུས་མཐོང་རུང་།",
    "ལེགས་པར་བསྒྲུབས་ཀྱང་སྐྱོན་སྲིད་མོད།",
    "དུག་ཆེན་ལུས་ལ་གནོད་མོད་ཀྱི།",
    "ཀཾ་ཙྩཾ་ཙི་བྱ་མགྲིན་སྔོན་ཟླ་བ་ལས་ནགས་ཚལ་ཤིན་ཏུ་མང་མོད་ཀྱང་།",
    "བཞི་པར་ཐོན་མི་བགྲངས་མོད་ཀྱང་།",
    "ཞེས་ཟེར་ཞིང་ནོར་བཟང་གི་དཔུང་མཐོང་བ་ཙམ་གྱིས་མདའ་རྡོ་མང་པོ་བརྒྱབ།",
    "འབྲི་མ་དགོས་པའི་རི་མོ་གཟུགས་འགྲོས་སྣ་ཚོགས་བྲིས་གཤིས།",
    "རྗེས་སུ་ཡང་བསླབས་པའི་ཡི་གེ་ལས་མ་བསླབས་པའི་རི་མོ་ཐོན་བསྐྱེད་ཆེ་བ་བྱུང་།",
    "ཆ་སྤྲོ་མཁས་པའི་དགའ་སྟོན་ལས་ཡུམ་ཟླ་འོད་མ་དེ་ནི་རང་རིགས་ཀྱི་བུ་མོ་ལ་ལྷག་པར་བརྩེ་བའི་ཕྱིར་ཚིག་དེ་ཐོས་མ་ཐག་ལྕག་མའི་རྩ་བ་བཅད་པ་ལྟར་འགྱེལ་ཞིང་བརྒྱལ་ལ་བཞུགས།",
    "ཐག་གཅོད་བྱེད་ཡས་ཀྱི་ཐབས་ཤེས་ཀྱང་འདྲ་གི་མ་རེད།",
    "ཀྲུང་གོ་རྙིང་པའི་རྣམ་པ་མགྱོགས་པོར་གྱུར་བ་རེད།",
    "དེབ་ཀ་པ་ལས་ང་ཚོས་སྐད་ཆ་སྦྱོང་རྒྱུར་འབད་བརྩོན་མ་བྱས་པར་བརྟེན།",
    "གནའ་རབས་ཀྱི་མི་རྣམས་ཀྱི་སྐད་ཆའི་ནང་ནས་ད་དུང་སྐྱེ་སྟོབས་ཡོད་པ་མང་པོ་ཞིག་ང་ཚོས་བེད་སྤྱོད་གང་ལེགས་དང་བབ་འོས་ལྡན་པ་ཞིག་བྱེད་ཐུབ་ཀྱི་ཡོད་པ་མ་རེད།",
    "ཁི་ཡཱ་ཟི་ལིང་གི་དམག་མི་དང་བཅས་གཏོས་ཆེ་བ་འབྱོར་རྒྱུའི་གནས་ཚུལ་བྱུང་བར་བརྟེན།",
    "ནིཙྩཾ་ཙྩཾ་བཀའ་བློན་རྟོགས་བརྗོད་ལས་ང་ཚོ་ནི་མི་དམངས་ལ་ཞབས་འདེགས་ཞུ་མཁན་ཞིག་རེད།",
    "དེར་བརྟེན་ང་ཚོར་སྐྱོན་ཡོད་ན།",
    "མི་ཚོས་སྐྱོན་བརྗོད་བྱེད་པ་དང་སྟོན་པར་སྐྲག་དགོས་ཀྱི་མ་རེད།",
    "༨དེབ་ཀ་པ་ལས་རང་རྒྱལ་ལ་ཞིང་ལས་བྱེད་མཁན་མི་གྲངས་དུང་ཕྱུར་ལྔ་ལྷག་ཙམ་ཡོད་པ་རེད།",
    "གྱི་གྱི་གཞོན་ནུ་དྲུག་གི་རྟོགས་བརྗོད་ལས་ཡུན་རིང་ནགས་སུ་འཁྱམས་ཏེ་གཞོན་ནུ་མཆོག།",
