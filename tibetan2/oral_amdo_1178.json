    "ག་༤བའག་༩༤༤༤ཅཆ་༤༤ཝ་༩༤རྗེས་འཇུག་མ་ནིང་ན་ར་ལ་གསུམ་མིང་གཞི་མ་ནིང་གི་མཐར་ཞུགས་པའི་ཚེ་ཡང་འཇུག་ད་དྲུག་ཡོད་མེད་ཇི་ལྟར་རུང་མིང་གཞི་དྲག་ཞན་གཉིས་ཀ་དང་མ་འཕྲད་པས་སྒྲ་དྲག་ཞན་གང་དུའང་མི་འགྱུར་བར་བར་མ་ཉིད་དུ་གནས་པར་མཚན་མེད་མ་ནིང་ཞེའོ།",
    "མིང་གི་ཁོངས་ནས་ཚིག་ཕྱུང་ནས།",
    "ཚིག་གིས་དོན་རྣམས་སྟོན་པར་བྱེད།",
    "མོ་ཡིག་ཡི་གེ་མེད་པ་ན།",
    "སི་ཏུའི་འགྲེལ་ཆེན་ལས་རྗེས་འཇུག་གི་ཡི་གེ་བཅུ་པོ་དེ་རྣམས་དགོས་པ་ཅིའི་ཕྱིར་དུ་འཇུག་པར་བྱེད་ཅེ་ན།",
    "མིང་གཅིག་གམ་གཉིས་སམ་དུ་མ་སྦྲེལ་དུ་ཟིན་ཀྱང་མཚམས་སྦྱོར་བར་བྱེད་པའམ་དོན་གསལ་བར་བྱེད་པའི་རྣམ་དབྱེ་དང་ཕྲད་སོགས་ཕལ་ཆེར་རྗེས་འཇུག་ལས་བྱུང་ཞིང་རྗེས་འཇུག་ལ་ལྟོས་པ་དེ་རྣམས་མ་ཞུགས་ན་དོན་གྱི་ཁྱད་པར་བརྗོད་པའི་ཚིག་ཏུ་འགྲུབ་པ་མི་སྲིད་པས་མིང་གི་ཁོངས་ནས་ཚིག་དབྱུང་བའི་ཕྱིར་འཇུག་སྟེ།",
    "དེ་ལྟ་བུའི་ཚིག་གིས་འཇིག་རྟེན་དུ་དོན་རྣམས་རྗོད་པར་བྱེད་པའི་ཕྱིར་དོན་མཚོན་པའི་བརྗོད་པ་ཇི་སྙེད་པའང་རྗེས་འཇུག་གི་ཡི་གེ་རྣམས་འཇུག་པའི་དགོས་པར་གྲུབ་བོ།",
    "མོ་ཡིག་དབྱངས་དང་མི་ལྡན་ན།",
    "ངག་གི་བརྗོད་པ་ཡོད་མིན་ཏེ།",
    "མིང་གི་ཁོངས་ནས་ཚིག་ཕྱུང་ནས།",
    "ཚིག་གིས་དོན་རྣམས་སྟོན་པས་སོ།",
    "ཚོ་དུས་དང་སྐུལ་ཚིག་དངོས་པོ་བདག་གཞན་ཊྚ་གཙོ་བོར་སྔོན་འཇུག་གི་ནུས་པ་དང་སྦྱར་ནས་རྗེས་འཇུག་རྣམས་ཀྱིས་ཀྱང་ཅི་རིགས་པར་བདག་གཞན་དང་དུས་གསུམ་གྱི་དོན་རྣམས་དེ་དང་མཚུངས་པར་འགྱུར་བ་ཡིན་གྱི་སྐབས་འགའ་ཞིག་ཏུ་མ་གཏོགས་པར་རྗེས་འཇུག་གི་ནུས་པ་གཙོ་ཆེ་བས་ནི་མ་ཡིན་ནོ།",
    "མོས་མོ་འདྲེན་པ་མ་ནིང་གིས་མ་ནིང་འདྲེན་པ་ཆ་ཕྱི་མ་དག་གི་འདྲེན་ཚུལ་ནི།",
    "མོ་ཡིས་མོ་ཡི་མིང་མཐའ་དྲང་།",
    "མ་ནིང་གིས་ནི་མ་ནིང་ངོ།",
    "མིང་སྔ་མའི་མཐའི་རྗེས་འཇུག་ཕོ་ཡིག་གིས།",
    "དེ་བཞིན་དུ་མོ་ཡིག་གིས་མོའི་མིང་མཐའ་དྲང་བ་དང་།",
    "མ་ནིང་གིས་མ་ནིང་གི་མིང་མཐའ་དྲང་བར་བྱའོ།",
    "ལྟད་མོ།",
    "སོགས་ཕོས་མོ་དྲངས་པ་ལྟ་བུ་དམིགས་བསལ་དེ་འདྲ་ཐར་ཐོར་ལ་ངེས་པ་མེད་དེ།",
    "༡ བཙྪ་བསམ་གཏན་ནི་མི་ཁ་རི་ཁ་ཐུག་ཅིག་ཡིན་པས་གནས་ཚུལ་གསལ་པོ་བྱུང་ཕྱིན་རང་གིས་བྱས་ནོར་ཤོར་བ་རྣམས་ཁས་ལེན་གྱི་ཡོད།",
    "ཆ་ཝ་ཆ་ཨཱཅལ་ཁ་ཨ་ཕུར་ཕུར་གཏོང་རྡབ་རྡབ་གཏོང་ལག་ལེན་བསྟར་རང་རྐྱ་འཕེར་ཧྥ་མགོ་མཇུག་སློག་བར་མཚམས་ཆད་གཙང་དག་བཟོ་ཨཱ་གཉའ་གནོན་མྱོང་རྒྱུ་དོགས་པ་ཐ་རྒྱུ་རྒྱབ་རྟེན་བཅོལ་འཇིགས་སྣང་སྐུལ་འདྲོག་འགོ་ལང་ན་རྫུ་བཏབ་རྫུན་རྐུབ་བུད་དྲག་ཆས་སྤུས་སྐྱབས་འཇུག་ཞུ་༡རང་ཚོད་ཟིན་བྲན་དུ་བཀོལ་ཁ་ལོ་བསྒྱུར་གོང་དུ་འཕེལ་རྒྱལ་ཁབ་ཀྱིས་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་རྒྱལ་ཡོངས་མི་རིགས་ཁག་ཐུན་མོང་དུ་དར་རྒྱས་ཕུན་སུམ་ཚོགས་པོ་ཡོང་བར་སྐུལ་འདེད་གཏོང་ངེས་ཡིན།",
    "མཐ་ཝ་ཆསུམ་ང་ཚོས་དེང་རབས་ཅན་དང་ཚད་ལྡན་གྱི་གསར་བརྗེའི་དམག་དཔུང་ཞིག་འཛུགས་རྒྱུའི་ཐད་གལ་འགངས་ཆེ་བའི་འབད་བརྩོན་བྱས་ཡོད།",
    "མི་དམངས་ཀྱི་འཚོ་བའང་ཡག་ཏུ་ཕྱིན་པ་རེད།",
    "འགྲིག་པ་ང་ཚོས་ཤེས་ལེ་ཡིན།",
    "ཙྪཱ་བྱ་སྤྲེལ་གཏམ་རྒྱུད་ལས་ཁོ་ཚོ་ལམ་བར་ཀུར་རེ་ཀོར་རེ་བྱས་ནས་དུས་ཐོག་ཏུ་སླེབས་མ་ཐུབ་པ་རེད།",
    "འབྲི་ཤེས་ཀྱི་རེད།",
    "དེར་ཝང་ཤིའི་ཧྥུང་གིས་དགོད་བཞིན་དུ་ངས་བཞད་གད་ཀྱི་ཡུལ་དུ་མ་སོང་བ་བྱས་ན།",
    "འབྱོར་མེད་གྲལ་རིམ་གྱིས་རང་གི་འཇིག་རྟེན་ལྟ་ཚུལ་ནང་བཞིན་འཇིག་རྟེན་སྒྱུར་བཀོད་བྱེད་བསམ་གྱི་ཡོད་ལ།",
    "འབྱོར་ལྡན་གྲལ་རིམ་གྱིས་ཀྱང་རང་གི་འཇིག་རྟེན་ལྟ་ཚུལ་ནང་བཞིན་འཇིག་རྟེན་སྒྱུར་བཀོད་བྱེད་བསམ་གྱི་ཡོད་པ་རེད།",
    "མ་རུངས་ཕྱོགས་འདིའི་སྐྱེ་བོས་ལྟ་སྣང་དུ། ཁྱོད་ལ་དད་དང་གུས་པ་ལྷུར་ལེན་ཀྱང་།",
    "རེ་ཞིག་སྒྲིན་པོའི་བློ་ཡིས་བག་ཐོན་དང་།",
    "ཉིན་ལྟར་རེ་བཞིན་མཚམས་མ་ཆད་པར་རི་བོ་རྐོ་གིན་བསྡད་པ་རེད།",
    "དེབ་ཀ་པ་ལས་སྣང་བ་འབུམ་ལྡན་འདིའི་རྒྱལ་ཁབ་ཀྱི་སྲིད་འབྱོར་ཕུན་སུམ་ཚོགས་པ་བདག་ཉིད་ཀྱི་བརྟུལ་ཞུགས་ཀྱིས་བདག་གིར་བྱས་ཟིན་པ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "༩ ཆུ་ངོགས་གཏམ་རྒྱུད་ལས་ཨ་མ་ལགས།",
    "ང་ཚོའི་སྡུག་བསྔལ་གྱི་འཚོ་བ་དེ་མཇུག་འགྲིལ་གྲབས་ཡོད་པ་དང་།",
    "བོད་རིགས་མི་དམངས་ཀྱིས་མི་ཚེ་མི་རབས་ནང་རེ་སྒུག་བྱེད་པའི་བཀྲ་ཤིས་པའི་དུས་བཟང་དེ་སླེབས་གྲབས་ཡོད་པ་རེད།",
    "དེ་བསམ་བློ་གཏོང་ན་གཏོང་རན་རེད།",
    "གཞོན་ནུ་དྲུག་གི་རྟོགས་བརྗོད་ལས་ཁྱོད་ཀྱིས་མར་མེ་འདི་གསད་པར་བསམས་ཀྱང་།",
