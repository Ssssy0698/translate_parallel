    "ཀྱེ་ཡི་སྒྲས་ཀྱང་བོད་པའི་ངོ་བོ་གསལ་བ་ལས་གཞན་མི་སྟོན་ཀྱང་རང་ངོས་ནས་དོན་སྟོན་པར་བཞག་དགོས་ཏེ།",
    "གོ་སོགས་ཕྲད་གཞན་ཡང་སླར་བསྡུ་སོགས་གསལ་བྱེད་ཡིན་པས་མིང་ཡིན་པ་དང་རང་ངོ་ནས་དོན་གསལ་བྱེད་དུ་འཇོག་དགོས་ན།",
    "རྙོག་དྲྭ་འདུག་ཟེར།",
    "བྱ་བྱེད་ཀྱི་ལས་དག་དུས་གསུམ་གར་ཡོད་རུང་བའི་ཕྱིར།",
    "རྒྱ་གར་དང་བོད་ཀྱི་མཁས་པས་མི་ཚད་དེའི་སྟེང་དུ་རྒྱ་ནག་དང་རྒྱ་སེར་གྱི་མཁས་པ་སྟོང་ཕྲག་བརྩེགས་ཀྱང་སྐྱོན་དེ་སྐྱོན་ལོས་ཡིན།",
    "དེ་རྣམས་ལ་ཐོན་མིའི་དགོངས་པ་ལྟར་དགར་བ་ཞེས་མི་འདོགས་པར་འབྱེད་པ་ཞེས་བསྒྱུར་དགོས་དོན་ཅི་ལ་ཐུག་འདུག་གམ།",
    "ཡང་རྩོད་ལན་དུ་གལ་པོ་ཆེ་ལ་ནན་ཏན་དུ་བརྣན་པའི་ནི་སྒྲ་དེས་ཞེས་བཀོད་ལ་ག་དགོས་པར་ནི་སྒྲ་དེས་ཞེས་བཀོད་དགོས་པར་ནི་སྒྲ་དེ་ཆེད་དུ་བཅད་འདུག་ཀྱང་།",
    "གཞན་ལ་གང་འཕངས་ཀྱི་སྐྱོན་ཁྱེད་རང་ལའང་མཚུངས་པར་འཇུག་ལ།",
    "ཕྱི་མ་གུག་རྟགས་ནང་བཀོད་པ་གཉིས་ངོ་ཚ་བོར་བའི་སྒོ་ནས་ཆེད་དུ་བཅད་འདུག་པ་དེ་དག་དེ་རིང་རང་སོར་བཞག་ནས།",
    "སྦྱངས་པ་གཏིང་སབ་བྱེད་དགོས་པ་གདའ་གསུང་།",
    "སྦྱངས་པ་གཏིང་ཟབ་བྱེད་དགོས་པ་གདའ་གསུང་།",
    "བདག་དུས་ཁྱད་པར་བསྒྲུབ་ཕྱིར་འཇུག་༣",
    "བདག་དུས་ཁྱད་པར་བསྒྲུབ་ཕྱིར་དུ་འཇུག་པའི་གཟུགས་འགྱུར་གྱི་བྱ་ཚིག་ལ་དགོངས་པ་ཡིན་པའི་ཕྱིར།",
    "སྤྱིར་བྱ་ཚིག་ལ་བདག་དུས་ཁྱད་པར་བསྒྲུབ་ཕྱིར་འཇུག་པའི་བྱ་ཚིག་དང་།",
    "ཕྱིར་མར་བདག་དུས་ཀྱི་ཁྱད་པར་ཚིག་གྲོགས་ཀྱིས་འབྱེད་པས་གོ་ཆོད་ཅིང་།",
    "༢གསར་སྣོན་དང་ཁ་སྐོང་སོགས་ཀྱིས་རྩ་འགྲེལ་ལ་བཟོ་བཅོས་བྱེད་པ་ཞེས་པ་མི་འཐད་པ་ལོས་ཡིན།",
    "དེས་ན་རྩ་འགྲེལ་བཟོ་བཅོས་བྱས་པའི་མིང་ངན་ཁུར་མིན་ཡང་རང་རང་ལ་རག་ལས་པའོ།",
    "ཤ་ཁྱི་གཉིས་ནི་སྒོ་རྭའི་ནང་དགའ་ལྷང་ལྷང་ངང་པར་འགྲོ་ཚུར་འགྲོ་བྱེད་བཞིན་གདའ།",
    "རྒུན་འབྲུམ་ངོ་མ་སྐྱུར་པོ་ཡིན་འདུག་ཅེས་སྨྲས།",
    "རྒྱང་རིང་ནས་ཝ་མང་འདུས་པ་མཐོང་ཞིང་རང་གཅིག་པུས་གླགས་ཁེལ་ཨེ་ཡོང་སྙམ་སྟེ་ནགས་སྲུང་བ་དང་རྔོན་པ་གཞན་བོས།",
    "ཁོས་ཅིས་ཀྱང་རང་ཉིད་ལ་བརྟེན་ནས་ཟས་ཞིམ་པོ་འཚོལ་ཐུབ་པས་ཁོ་ལ་བདེ་སྐྱིད་སྟེར་མཁན་གྱི་ཁ་པར་ལ་བསྔགས་བརྗོད་མི་བྱེད་ག་ལ་སྲིད།",
    "བསམ་བློ་ཡག་པོ་ཞིག་གཏོང་དགོས་འདུག་རང་ལ་ཀ་ར་ཉོ་འམ།",
    "སྐབས་དེར་ང་རང་བློ་རྩེ་གཅིག་སྒྲིམ་གྱིས་གནམ་གྲུ་བཟོ་བར་བྲེལ་ནས་ཁོང་ལ་ཁ་ཡ་བྱེད་སེམས་མེད་སྟབས་རྒྱུས་མེད།",
    "ངས་བྱས་ན་དད་པ་བྱེད་དོན་ནི་སྐར་མ་འདིའི་སྒང་ལ་ང་ལས་ལྷག་པ་མེད་སྙམ་གྱི་འདུག་ཅེས་སྨྲས།",
    "རང་གཅིག་པུ་ལས་མི་འདུག་ཟེར་བས་ཁྱེད་ཀྱིས་ངའི་འདོད་བློ་བསྐངས་ནས་ཅིས་ཀྱང་དད་བཀུར་ཐེངས་གཅིག་གྱིས་དང་ཞེས་བརྗོད།",
    "རྒྱལ་སྲས་ཀྱིས་ངས་དད་བཀུར་བྱས་ཆོག་ཅེས་ཟེར་ནས་ལམ་ལ་སྐྱོད་བཞིན་མི་རྒན་དེ་ཚོ་ཐང་ཐང་མི་འདུག་བསམས་རྒྱལ་སྲས་ཀྱིས་ཨར་རྐྱལ་གཅིག་ཡོད་པའི་སྐར་མར་འཚམས་འདྲི་ཞུ་བའི་དུས་ཚོད་ཧ་ཅང་ཐུང་རུང་སྐྱོ་ངད་ཤིན་ཏུ་ཆེན་པོ་སྐྱེས།",
    "ཁྱེད་རང་སའི་གོ་ལར་ལྷུངས་ནས་གླིང་ཆེན་ཨ་ཧྥེ་རི་ཁའི་ས་ངོས་སུ་ཡོད་ཟེར།",
    "ངའི་བསམ་ཚོད་ལ་དྲུག་བདུན་ཞིག་འདུག་ལོ་འགའི་སྔོན་ལ་ངས་ཁོ་ཚོ་མཐོང་བྱུང་ཡང་གང་ན་ཡོད་མིན་གཏན་ནས་མི་ཤེས།",
    "ཁོང་ནི་བྱ་འཕུར་བ་བཞིན་སྐྱོད་བཞིན་ང་ལ་ཨ་ཙི།",
    "ལའེ་པུའུ་ལ་པིས་ང་གསེར་དངུལ་བང་མཛོད་བཅོམ་འདོད་མི་འདུག་ལ་འདྲེ་དང་ངན་པ་ལག་སྦྲེལ་གཏན་ནས་བྱེད་ཀྱི་མིན།",
    "དེང་ཞནི་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "ཉན་ཐོས་དང་རང་སརྒྱས་བ།་",
    "དེ་བཞིན་སེམས་ཀྱང་རང་ཡུལ་ལ།",
    "གང་དག་ལངས་ལ་ལངས་པར་འདུ་ཤེས་མེད་འདུག་ཀྱང་འདུག་པར་འདུ་ཤེས་ཡོད་མ་ཡིན།",
    "ལོ་ཙཱ་བ་དགེ་སློང་བེེ་རོ་ཙ་ནས་བསྒྱུར།",
    "སོ་སོ་ན་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷན་ཅིག་མི་གནས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མཉམ་དུ་མི་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "མཉམ་དུ་མི་འདུག་པ་ཉིད་སྟོན་པ་ནི་འདི་ལྟ་སྟེ།",
    "གཅིག་དང་འདུག་པ་ནི་གཅིག་ལ་གནས་པའོ།",
    "རིམ་གྱིས་གནས་པ་ན་ཞེས་བྱ་བ་ནི་རིམ་གྱིས་འདུག་པའོ།",
    "འབྱེལ་པ་ཞེས་བྱ་བའི་ངོ་བོ་དེ་ཉིད་གཞན་ཞིག་ཡོད་པར་ཟད་པའི་ཕྱིར་གཞན་དེ་ཡོད་པས་དངོས་པོ་གང་ཡང་འདྲེས་པར་གྱུར་པ་མེད་པའི་ཕྱིར་ཡང་དག་པར་ཇི་ལྟར་འབྲེལ་པ་ཡོད་ཅེས་བྱ་བ་ནི་གང་ན་གཉིས་འདུག་པ་དེའི་ནང་དུ་གསུམ་པ་འོངས་ན་དེ་དེར་ལྷག་པ་ཡིན་གྱི་དེ་ཉེ་བས་གཉིས་ཀྱི་ངོ་བོ་འདྲེས་པར་འགྱུར་བ་ནི་མེད་དོ།",
    "མ་འགགས་ན་ཡང་ལྷན་ཅིག་ཏུ་འདུག་པ་གཉིས་ཕན་པར་བྱ་བ་དང་ཕན་པར་བྱེད་པའི་དངོས་པོ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཅི་སྟེ་ཡང་རྒྱུ་དང་འབྲས་བུ་གཉིས་ཚོགས་པར་འདོད་ན་དེའི་ཚེ་དུས་གཅིག་ཏུ་ཚོགས་པ་གཉིས་ལ་ཕན་པར་བྱ་བ་དང་ཕན་པར་བྱེད་པའི་དངོས་པོ་མེད་པས་ཤིན་ཏུ་ཡང་འབྲེལ་པ་ཅན་མི་འཐད་དོ།",
    "ཇི་ལྟར་སྦྱོར་བ་ལ་སོགས་པ་དང་ལྡན་པར་རུང་བའི་དངོས་པོ་རྟག་ན་ནི་ཞེས་བྱ་བ་ནི་ཅི་སྟེ་ཡང་འབྱེལ་པ་ཅན་ནི་དུས་ཐམས་ཅད་དུ་སྦྱོར་བ་ལ་སོགས་པའི་གཞིར་རུང་བའི་ངོ་བོར་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གང་ཡང་རང་བཞིན་དུ་གྱུར་པ་མེད་ན་དེ་ལ་ཇི་ལྟར་ཡང་ཐོབ།",
    "ཡང་དག་པར་སྦྱོར་བ་ལའི་རྟོགས་པ་ཐ་དད་པ་མེད་དེ་ཁར་གཞོང་འདི་ལ་རྒྱ་ཤུག་རྣམས་དང་ཁྲི་འདི་ལ་ལྷ་སྦྱིན་འདུག་པ་དང་།",
    "དེའི་ཁྱད་པར་ནི་དོན་གཅིག་ཏུ་འཛིན་པར་ངེས་པ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་ཉེ་བར་བསྐྱེད་པར་རུང་བའི་བདག་ཉིད་དུ་འདུག་པ་ཡིན་ནོ།",
    "འཁྲུལ་པ་ནི་སོ་ན་འདུག་པ་ཁོ་ནའོ་སྙམ་དུ་སེམས་ན་དེའི་ཕྱིར།",
    "སྤོབས་པ་མེད་པས་བྱེད་པར་འགྱུར་བས་མི་སྨྲ་བར་འདུག་པར་གྱུར་པའི་ཕྱིར་ཏེ།",
    "སྒྲུབ་པའི་ངོ་བོ་ཡང་རང་བཞིན་གྱི་ངོ་བོ་དང་རྒྱུའི་ངོ་བོར་འགྱུར་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པས་མི་གསལ་བའི་དོན་རྣམས་སོ།",
    "གྲུབ་པ་དེ་ཡང་རང་ཡོད་ན་བདག་ཉིད་དུ་ཉེ་བ་སྟེ།",
    "གང་བསྐལ་པ་རྣམ་པ་གསུམ་གྱི་ངོ་བོ་བསྒྲིབས་པ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱི་མཚན་ཉིད་རི་རབ་དང་ར་མ་ན་དང་ལྷ་ལ་སོགས་པའི་ངོ་བོ་ལྟ་བུ་དེས་མ་བསྐལ་པ་རྔུ་ནི་རང་བཞིན་ཁྱད་པར་ཅན་དུ་བརྗོད་དོ།",
    "རིན་མེད་པར་ཡང་རང་ངོ་བོ་འཇོག་པ་ནི་བཞད་གད་དུ་བྱེད་པའོ།",
    "འདིས་ནི་འགལ་བའི་འབྲས་བུ་དམིགས་པའི་ཡང་ཡུལ་དང་རང་བཞིན་གྱིས་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་ཏུ་སྒྲུབ་པ་ནི་གོ་སླ་བ་ཉིད་དོ།",
    "གཉིས་པོ་མི་བརྗོད་པ་ནི་མི་སྨྲ་བར་འདུག་པས་སོ།་།",
    "འོ་ན་ཡོད་པའི་བདག་ཉམས་པ་དང་མེད་པའི་བདག་ཐོབ་པར་ཁས་བླངས་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་གཅིག་པའི་རྣམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བ་གང་ཡིན་པ་འདིའི་ཕྱོགས་ལ་དམ་བཅའ་དྷིསྔ་མ་དེ་ནི་འདིར་གྲུབ་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟར་འདིར་རྐང་མིག་བདག་ཉིད་འདིར་རང་བཞིན་འགྱུར་བའི་མཚན་ཉིད་འདྲི་བར་བྱེད་ཅིང་རང་བཞིན་དང་འབྱེལ་པ་མེད་ཅིང་ངེས་པ་མེད་པས་རང་བཞིན་གྱི་དོན་ལ་རག་ལས་པའི་ཕྱིར་ཚིག་ལ་འཇུག་པར་བྱེད་དོ།",
    "དེ་ལྟ་ན་གྲངས་ཅན་དེའི་གཏན་ཚིགས་མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པའི་སྐྱོན་བརྗོད་པས་བརྩད་པ་ན་གསལ་བ་འདི་དང་རང་བཞིན་གཅིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་སུན་དབྱུང་བར་འགྱུར་རོ།",
    "སྤོབས་པ་མེད་པས་མི་སྨྲ་བར་འདུག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དེའི་སྒྲ་བརྗོད་པར་མི་ནུས་པས་མ་འབྱེལ་པ་ཡིན་ནོ།",
    "རྩོད་པའི་དུས་སུ་སྤོབས་པ་མེད་པས་མི་སྨྲ་བར་འདུག་ནས་ཅུང་ཟད་ཀྱང་བརྗོད་པ་མེད་དོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའི་དོན་རྣམས་ལ་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པའི་མཐོང་བའི་ཤེས་པ་ལོག་པས་བསྐལ་པ་དེ་དག་ལ་མེད་པར་སྒྲུབ་པར་བྱེད་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "གྲུབ་པ་ཡང་རང་ཡོད་ན་ཡོད་པ་གྲུབ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་ཁྱད་པར་ཅན་བསྟན་པ་ནི་གང་བདག་ཉིད་མ་ཡིན་པའི་སྣང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་གྱིས་ཕན་ཚུན་ནུས་པ་དེ་ལས་ཅིས་མ་ཡིན་ཞེ་ན།",
    "དེ་བཞིན་དུ་འདུས་པ་ཡང་རང་སྣང་བའི་ཤེས་པའི་རྒྱུའི་དངོས་པོར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཉེས་པ་དེའི་སོ་ན་འདུག་སྟེ།",
    "ལྟོ་ནི་རྐེད་༧ན་འདུག་ལ་དེ་ཡང་ཡངས་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་བུམ་པ་ལ་སོགས་པ་ཡང་རྫས་སུ་ཡོད་པ་ཞིག་ཡིན་པར་གྱུར་ན་ནི་དེའི་ཚེ་དེ་དག་ཀྱང་རང་དང་འབྲེལ་པ་ཅན་ཡོངས་སུ་བསལ་ཀྱང་།",
    "དེ་ནི་ནམ་ཡང་མདུན་ན་མི་འདུག་ན།་",
    "ལོ་ཙཱ་བ་དགེ་སློང་བེེ་རོ་ཙ་ནས་བསྒྱུར་བའོ།",
    "དུ་མའི་དབུས་ན་འདུག་པའི་ཕྱིར།",
    "རྒྱུན་དང་རང་བཟོའི་རྒྱུན་བཞིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གནས་ཕྱིར།",
    "དོན་བྱ་བ་བསྒྲུབ་པ་དེའི་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་ཤེས་ན་ནི་འཇུག་པ་དེའི་ཡུལ་ཅན་ཡིན་ནོ།",
    "ཡུལ་གཞན་ན་འདུག་པ་ལེན་པར་འདོད་པ་ན་ཡུལ་གཞན་ན་འཇུག་པ་ངེས་པར་ཉམས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཁྱིམ་གྱི་དང་ར་གཅིག་ན་འདུག་པའི་མེའི་ཕུང་པོ་བཞི་ལས་གང་ཡང་རུང་བ་ཞིག་བླང་བར་བྱ་བ་ཡིན་ཏེ།",
    "ཉེ་བ་ན་འདུག་པའི་བར་ཆད་དང་བཅས་པའི་ལོ་མ་དམིགས་པའི་ཕྱིར་བར་ཆད་དང་བཅས་པ་ཉིད་དུ་འཛིན་ལ།",
    "རིང་པོ་ན་འདུག་པས་ནི་བར་ཆད་མི་མཐོང་བས་མི་སྣང་བའི་ཕྱིར་ལོ་མ་འབའ་ཞིག་སྣང་བ་ན་སྔོན་པོའི་དངོས་པོ་གཅིག་ཏུ་སྣང་བར་ཤེས་པ་ཡིན་ནོ།",
    "གཞན་ན་འདུག་པ་ལ་མ་ངེས་པ་ཉིད་ཀྱི་ཤེས་པའི་སྣང་བ་ལ་ལྟོས་ནས་འཁྲུལ་བ་ཡིན་གྱི་འདྲེས་པ་མཐོང་བ་ནི་མ་ཡིན་ནོ།",
    "དཔེར་ན་ཁྱད་པར་ཅན་གྱི་དབྱིབས་དང་ལྡན་པའི་རལ་གུ་བཟུང་བ་ལས་དེ་དང་མཐུན་པའི་དངོས་པོ་དེའི་ནང་ན་འདུག་པ་རྗེས་སུ་དཔོག་པ་བཞིན་ནོ།",
    "དྲུང་ན་འདུག་པའི་མངོན་སུམ་ཉིད་ཀྱིས་ཡིན་ནོ།",
    "ཡང་གང་ཞིག་ཆུས་དབེེན་པའི་ཕྱོགས་སུ་ཆུའོ་ཞེས་སྒོ་འདོགས་པ་གཉིས་ཀ་དང་འདྲེས་པའི་རྣམ་པར་རྟོག་པ་དེ་ཡང་རང་བཞིན་གཉིས་མཐོང་བ་ལ་རག་ལས་པ་ཁོ་ནའོ།",
    "སྐད་ཅིག་མ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ལ་དཔེ་མི་སྲིད་དོ་ཞེས་གང་སྨྲས་པ་དེ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "དུས་དེ་རྫོགས་ཀྱང་རང་བཞིན་དེ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་བརྗོད་པ་ན་དེ་དག་དུས་ཅུང་ཞིག་གནས་པའི་རང་བཞིན་ཅན་ཡིན་ནོ་ཞེས་ཁས་བླངས་པར་འགྱུར་རོ།",
    "འབྲས་བུ་དང་རང་བཞིན་དང་མི་དམིགས་པའོ།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའོ།",
    "འབྲས་བུ་མི་དམིགས་པ་ལ་སོགས་པ་མ་དམིགས་པའི་སྤྱོར་བ་འདི་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་མི་དམིགས་པ་ཉིད་དུ་འདུ་བར་འགྱུར་རོ།",
    "དེའི་བདག་ཉིད་དང་དེ་ལས་བྱུང་བ་དག་ཀྱང་རང་བཞིན་དང་འབྲས་བུ་དག་ཉིད་ཀྱི་ཕྱིར་དེ་དག་ཉིད་ཀྱིས་དངོས་པོ་གྲུབ་པོ།",
    "ཡིད་དང་རང་རིག་པའི་རྣལ་འབྱོར་པའི་ཤེས་པའོ།",
    "འབྲས་བུ་ཚུལ་གསུམ་པའི་རྟགས་དང་རང་བཞིན་ཚུལ་གསུམ་པའི་རྟགས་དང་།",
    "དེ་ལྟ་ན་འབྲས་བུ་དང་རང་བཞིན་དག་ལས་མི་དམིགས་པ་ཇི་ལྟར་ཐ་སྙད་ཅེ་ན།",
    "དགག་པར་བྱ་བ་དུ་བའི་གང་རང་བཞིན་དེ་འདི་ལྡུ་མི་དམིགས་པའོ།",
    "འབྲས་བུ་མི་དམིགས་པ་ལ་སོགས་པའི་སྦྱོར་བ་བཅོ་ལྔ་པོ་འདི་རྣམས་ཀྱང་རང་བཞིན་མི་དམིགས་པའི་ངོ་བོ་ཉིད་ཁོ་ནར་རྟོགས་པར་བྱ་སྟེ།",
    "བལྟར་མི་རུང་བ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་བསྐལ་བར་ཡང་དག་པར་འབྱུང་ངོ།",
    "གཞན་ཡང་རང་བཞིན་པའི་འབྲེལ་པ་ཞེས་པའི་དོན་ཅི་ཞིག།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་མེད་པའི་ཕྱིར་རོ།",
    "ཐ་དད་ན་ཡང་རང་བཞིན་གྱེས།",
    "འདོད་པ་དེ་རྣམས་ཀྱང་རང་ཉིད་ཡོད་པ་ཉིད་ཙམ་གྱི་རྒྱུ་ཅན་ཡིན་པས་ཅིས་བྱེད་པ་མ་ཡིན་ན་ཞེས་པས་དེ་ཁོ་ན་འདི་ཉེ་བར་དམིགས་པ་ཡིན་ནོ།",
    "དེ་རྣམས་ཅང་མི་སྨྲ་བར་འདུག་སྟེ།",
    "དེ་དག་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེ་དག་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེ་དག་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེ་དག་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེ་རྣམས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་ཉེ་དགའ་བོ་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ན་འཆག་ཅིང་འདུག་པ་དེས་དེ་རྒྱང་རིང་པོ་ནས་མཐོང་ནས་སྨྲས་པ།",
    "ཚེ་དང་ལྡན་པ་ཉེ་དགའ་བོ་འོད་མའི་ཚལ་གྱི་སྒོ་ན་འཆག་ཅིང་འདུག་གོ།",
    "འཕགས་པ་བདེ་བར་འདུག་གམ།",
    "དེས་ལག་ཏུ་བླངས་ཏེ་འདུག་གོ།",
    "དེས་ཁར་བཅུག་ནས་འདུག་གོ།",
    "བཞིན་བཟངས་བཅངས་ཏེ་འདུག་པ་འདི་ཡིན་ནོ།",
    "དེ་དང་ཧ་ཅང་མི་རིང་བ་ཞིག་ན་གཅེར་བུ་པ་ཞིག་འདུག་པ་དེས་བསམས་པ།",
    "དེའི་ལུས་ཐམས་ཅད་ཚིག་ན་ལྟོའི་ཉེན་ཀོར་དེ་བཞིན་དུ་འདུག་གོ།",
    "དེ་བརྐྱང་ཞིང་འདུག་གོ།",
    "ལྷ་འཁྲུལ་འཁོར་གྱི་སྦྱོར་བ་ལས་དེ་དག་རྒྱུ་བར་གདའོ།",
    "བྱ་དག་སྐད་འབྱིན་ཏམ་མི་འབྱིན་པའི་ཚུལ་ལས་གདའོ།",
    "མེ་སྐྱེས་ཀྱིས་དེ་ཐོས་ནས་ཆོམ་རྐུན་པ་དག་འདུག་པར་གྱུར་ཅིག་ཅེས་ཡིད་ལ་ཡང་བསམས་ཚིག་ཏུ་ཡང་བརྗོད་པ་དང་དེ་དག་གང་ནས་ཇི་ལྟར་འཛེགས་པ་དེ་ཉིད་ན་དེ་བཞིན་འཁོད་པར་གྱུར་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ཁྱིམ་བདག་མེ་སྐྱེས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་བསམས་པ།",
    "གང་ཡང་ཕམ་རྒྱལ་མེད་ནས་རྒྱལ་པོ་གཉེན་ལྡན་རྐོམ་ཚུགས་བཅས་ཏེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "ང་ཇི་ལྟར་རྐོམ་ཚུགས་བཅས་ཏེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་མི་འདུག་ཏུ་རུང་།",
    "གང་དག་ཤིང་འཚོང་བ་དེ་དག་ནི་ངའི་ཡུལ་ན་མ་འདུག་ཤིག་ཅེས་དྲིལ་སྒྲོགས་ཤིག་དེ་ལྟར་བྱས་པ་དང་།",
    "རྒྱལ་པོ་རྐོམ་ཚུགས་བཅས་ཏེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་ནས།",
    "ངོ་མཚར་དང་ལྡན་པའི་ཡིད་ཀྱིས་དེ་ཉིད་དུ་འདུག་གོ།",
    "དེ་མྱ་ངན་གྱི་ཁང་པར་ཞུགས་ཏེ་རྐོམ་ཚུགས་བཅས་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "ངོ་མཚར་དང་ལྡན་པའི་ཡིད་ཀྱིས་དེ་ཉིད་དུ་འདུག་གོ།",
    "འཕགས་པ་དག་ཁྱེད་མགོ་ནི་དྲེགས་ལ་མཆན་ཁུང་ནི་རལ་བུ་ཅན་དུ་འདུག་ན་ཁྱེད་ཀྱི་གདོང་མཛེས་པར་ག་ལ་འགྱུར།",
    "འཕགས་པ་དག་ཁྱེད་མགོ་ནི་དྲེགས་ལ་མཆན་ཁུང་ནི་རལ་བུ་ཅན་དུ་འདུག་ན་ཁྱེད་ཀྱི་སྐྲ་མཛེས་པར་ག་ལ་འགྱུར།",
