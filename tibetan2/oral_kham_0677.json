    "ང་རང་གྱི་རྨོངས་འཆར་འདྱི་ཡྱིན།",
    "ཁ་ནང་གྱི་རྨ་ཁ་ནང་རང་ལ་སོས་ཐབས་དེ་འདྲ་ཞྱིག་གནང་ཐབས་དང་།",
    "འདྱི་བ་རྒྱུ་ཐོག་ལ་རྱིས་འགོ་མྱིང་ཐོ་འདྱི་ད་ལྟའྱི་རྱིས་ཀྱི་འགྲོ་སྟངས་ཐོག་ནས་མ་བདེ་བ་མེད་ན་ཡག་ཏུ་གང་བཟོ་རྒྱུ་འདུག་བསམ་ཤེས་ཞུས་ཀྱི་ཡྱིན་ཞེས་ཞུ་རྒྱུ་ཡྱིན།",
    "སོབ་གཉེར་གྱི་ཐོག་ལ་འགྲྱིག་འདུག་བསམ་རྒྱུ་དེ་འདྲ།",
    "དེ་ཚོའྱི་ཐོག་ལ་ཡག་པོ་འདུག་བསམ་པའྱི་དེ་འདྲ་སེབ་ཡོད་དུས།",
    "དེ་དང་མཉམ་དུ་བོད་ཀྱི་ཟློས་གར་ཚོགས་པའྱི་ཚོགས་ཁང་གསར་རྒྱག་ཐོག་ལ་བཀོད་གནང་འདུག་དངུལ་འབོར་ལྟ་བུ་ཡྱིན་ན།",
    "ཆུ་བབ་ཀྱི་འདུག་ཟེར་རྒྱུ་དང་།",
    "ཅ་ལག་ཆག་འགྲོ་ཡྱི་འདུག་ཟེར་རྒྱུའྱི་གནས་ཚུལ་མང་པོ་ཞྱིག་སེབ་ཡོང་དུས།",
    "གང་ལྟར་སྤུས་ཚད་ལྡན་པ་ཞྱིག་འདུག་བསམ་རྒྱུའྱི་ཐོག་ལ་ཡྱིན་གཅྱིག་ཐུགས་སང་གནང་བ་དང་དགོངས་བཞེད་གནང་རོགས་གནང་ཞེས་ངའྱི་ངོས་ནས་འབོད་བསྐུལ་ཞུ་རྒྱུ་ཡྱིན།",
    "དེ་ཚོ་ནང་ལ་ཚང་མར་རོབ་པ་དང་ཁྱབ་པ་ཞྱིག་ཡོང་གྱི་མྱི་འདུག་མ་གཏོགས།",
    "ཁོ་རང་གྱིས་དེ་རྱིང་བཀའ་ལུང་སན་འདྲེན་ཞུ་རྒྱུ་རྱིམ་པ་བཞྱི་ཙམ་ཞྱིག་ཡར་ཕྱིན་པ་ཡྱིན་ན།",
    "གཏོང་དགོས་པ་དེ་ངས་གལ་འགངས་ཆེན་པོ་མཐོང་གྱི་འདུག་ཕག་སེལ་སྱི་འཐུས་ཀྱིས་གསུངས་པ་ལྟར།",
    "དང་པོ་འཆར་གཞྱི་སྱིག་དུས་ནས་ཚང་མས་གོ་སྐབས་བཞེས་ཐུབ་པ་དང་།",
    "ཡང་ལན་དེ་མང་པོ་འཕོས་འགྲོ་ཡྱི་འདུག་ལན་གསལ་པོ་ཞྱིག་གནང་རོགས་གནང་།",
    "སྱིར་བཏང་འབོད་བསྐུལ་མང་པོ་ཞྱིག་འདུག་ངས་བསར་ཟློས་ཞུ་མ་དགོས་པའྱི་ཐོག་ནས་དེ་འདྲ་ཡྱིན།",
    "བསྔགས་བརོད་གནང་བ་ནང་བཞྱིན་བསྔགས་བརོད་གནང་འོས་པ་དེ་འདྲ་ཆགས་ཀྱི་འདུག་ཅེས་བསར་ཟློས་ཞུ་རྒྱུ་ཡྱིན།",
    "མར་གང་ལ་གང་འཚམ་ཕྱི་པ་དང་འགངས་པ་ཞྱིག་ང་རང་གྱི་ངོས་ནས་མཐོང་ཚུལ་དང་ངོས་ལེན་ཞུ་ཡྱི་ཡོད།",
    "གལ་ཆེན་པོ་འདུག་ཅེས་ཞུས་པ་ཡྱིན།",
    "རྱིས་དང་འབེལ་བའྱི་སྔོན་མ་འགྲོ་སྟངས་ཤྱིག་འདུག་ད་ལྟ་གཞན་ཕར་བཞག་སྟེ།",
    "དཔལ་ལྡན་ཚོགས་གཙོ་མཆོག་གཞྱི་རྐང་རྒྱབ་མདུན་ཤོག་བུ་གཅྱིག་འདུག་ངས་དྲན་ཚོད་དང་ཤེས་ཚོད་བས་པ་ཡྱིན་ན།",
    "ཕལ་ཆེར་ཕུལ་བ་གཅྱིག་གཉྱིས་ངས་དྲན་གྱི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "དེའྱི་འོག་ལ་གྲྭ་བཙུན་སྱིག་འཛུགས་ཀྱི་ཚོགས་ཆུང་ཟེར་རྒྱུ་ཞྱིག་འདུག་ངས་སྔོན་མ་ཡང་དྲྱིས་པ་ཡྱིན།",
    "ངས་མ་འོངས་པར་སྱིག་འཛུགས་དེ་དགོས་ཀྱི་མྱི་འདུག་དྲན་གྱི་ཡོད།",
    "དེ་ཚོར་ཐག་གཅོད་བ་རྒྱུའྱི་སྱིག་འཛུགས་དགོས་ཀྱི་འདུག་མ་གཏོགས།",
    "ལྷག་པར་དུ་བཀའ་ཤག་གོང་མའྱི་སྐབས་ནས་བཟུང་རང་ཁ་རང་གསོ་དེ་ཤུགས་ཆེན་པོ་བེད་དུས།",
    "ན་ནྱིང་ཕྱི་ཟླ་༡ པ་ཡྱིན་ན་དེའྱི་གཡས་གཡོན་ལ་གཅྱིག་སྤུངས་བཞག་དུས་མཁས་པ་དེ་ཚོར་དེབ་གྲངས་༡༡ དེ་འདྲ་སྤྲད་འདུག་དེབ་གྲངས་༡༡ སྤྲད་ས་དེ་ཚོའྱི་དཔེར་ན།",
    "དངོས་གནས་དྲང་གནས་ང་རང་ཡང་བསམ་བོ་གཏོང་སྟངས་དང་།",
    "དེའྱི་ནང་ལ་རྱིས་འགོ་འདྱི་དེབ་དེ་དང་འབེལ་བ་ར་བ་ཉིད་ནས་མྱི་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "བསྟན་དང་འགྲོ་བ་ཀུན་ལ་འཚེ་བེད་ན་ཟེར་དུས་བསྟན་པ་དང་འགྲོ་བར་འཚེ་བེད་བཞྱིན་འདུག་ཟེར་དུས།",
    "དགེ་ལྡན་པའྱི་ཁོངས་སུ་མཁན་ཞྱིག་ཡྱིན་ན་གུ་རུ་རྱིན་པོ་ཆེའྱི་སྐུ་བརན་ཡྱིན་ནའང་ནང་དུ་བཞག་དུས།",
    "དེ་ཡྱིན་དུས་་གོང་ས་སབས་མགོན་ཆེན་པོ་མཆོག་གྱིས་དེ་དམ་དྲག་བ་རྒྱུ་དེ་བོད་བསྟན་པ་ཆབ་སྱིད་ལ་གནོད་ཀྱི་འདུག་ཅེས་དངོས་གནས་དྲང་གནས་མྱི་ལོ་དྲུག་ཅུའྱི་རྱིང་ལ་དཀའ་ལས་བརྒྱབས་ནས་གོང་ས་མཆོག་གྱིས་བཀའ་སོབ་ཕེབས་པ་ནང་བཞྱིན་གཡས་སོར་གཡོན་སོར་ཟེར་བ་ནང་བཞྱིན།",
    "རོགས་སོར་དང་ལེགས་གསོལ་ཞེས་པ་ཞྱིག་བཀོད་འདུག་དེའྱི་རྱིས་འགོ་གསུམ་པའྱི་ནང་དུ་གཟྱིགས་པ་ཡྱིན་ན།",
    "ཐ་ན་ཛ་དྲག་གྱི་རོགས་སོར་ཟེར་ནས་ལོག་ས་སུ་སྔོན་རྱིས་ཤྱིག་བཀོད་གནང་འདུག་རོགས་སོར་དེ་གང་འདྲ་ཡྱིན་མྱིན་ཁ་གསལ་ཞྱིག་གསུང་རོགས་གནང་།",
    "དེ་ཁྱབ་བསགས་ག་ཚོད་བས་ནའང་འཛུལ་མཁན་དེ་དཀོན་པོ་ལྟ་བུ་ཞྱིག་ཡོང་གྱི་འདུག་སྟེ།",
    "ཁུངས་དང་ལྡན་པ་ཁོ་ཚོས་བཀོད་འདུག་རྒྱ་ནག་གྱི་བེད་སོད་གཏོང་གྱི་ཡོད་པ།",
    "དེ་བཞྱིན་ཁོ་རང་གནས་ས་ལ་ཆ་མཚོན་པ་ཡྱིན་ན།",
    "སེམས་ཁམས་འཕོད་བསྟེན་དང་འབེལ་བའྱི་ཐོག་ནས་ལས་གཞྱི་ཞེས་གསར་པ་ཞྱིག་བཀོད་གནང་འདུག་ལས་གཞྱི་དེ་གང་འདྲ་སེལ་གནང་གྱི་ཡོད་ན།",
    "ཁོང་རྣམ་པ་ཚོར་ང་རང་སེམས་ཁལ་ཞྱིག་འདུག་གཟུགས་པོའི་ལུས་སྟོབས་དང་འབེལ་བའྱི་ཐོག་ནས།",
    "ཞུས་ན་རུང་གྱི་མྱི་འདུག་སྟེ་ཡྱིན་ནའང་།",
    "མང་པོ་ཞྱིག་སེམས་ཁམས་འཕོད་བསྟེན་གྱི་དཀའ་ངལ་ཡོད་པ་ཞྱིག་ཆགས་ཀྱི་འདུག་ར་བའྱི་ན་ནྱིང་ཡང་དེ་མཚུངས་སན་སེང་ཞུས་ཡོད།",
    "དེ་འདྲའྱི་གནས་སྟངས་དང་གནས་ཚུལ་དེ་འདྲ་འཁོད་པ་ཞྱིག་ཆགས་འདུག་ལྷག་དོན་དུ་ཚོགས་པའྱི་མྱིང་འབོད་ཞུས་པ་ཡྱིན་ན།",
    "ངས་གོ་སྐབས་འདྱིའྱི་བརྒྱུད་ནས་ཁོ་རང་དྲན་གསོ་ཞུས་པ་དང་སགས།",
    "དེའྱི་ནང་ནས་ཡར་ལ་གཅྱིག་གཉྱིས་ཤྱིག་འགོག་འདུག་ཟེར་ཡོང་དུས།",
    "གང་ཅྱིའྱི་ཐད་ནས་ཕག་ལས་ཡག་ཐག་གཅོད་གནང་གྱི་འདུག་དེ་ཚོའྱི་ཐོག་ལ་འབེལ་ཡོད་བཀའ་བོན་དབུས་པའྱི་དྲུང་ཆེ་དང་ལས་བེད་ཚང་མར་བསྔགས་བརོད་དང་།",
    "འབེལ་ཡོད་ཚང་མས་ལམ་སྟོན་བཀའ་སོབ་གནང་གྱི་འདུག་སྟེ།",
    "ངས་ཟ་ཡྱི་མྱིན་གདའ་ཟེར།",
    "དུས་ཚོད་ག་དུས་ཤྱིག་ལ་ཡྱིན་ནམ།",
    "ངས་དེ་འདྲ་ཞྱིག་གཟྱིགས་དགོས་འདུག་ཞུས་ཀྱི་ཡོད།",
    "མར་ཕོགས་ལ་གནང་ཐུབ་ན་ཡག་པོ་འདུག་སམ།",
    "གང་ཅྱིའྱི་ཐོག་ནས་ངས་ཡག་པོ་ཞྱིག་འདུག་སམ།",
    "དེ་ཚོའྱི་ཐོག་ལ་ངེས་པར་དུ་དོ་སང་གནང་དགོས་ཀྱི་འདུག་སམ།",
    "སྱིར་བཏང་བཙན་བོལ་སྱི་ཚོགས་འདྱིའྱི་ནང་ལ་ཞུས་ཤེས་མཁན་ཞྱིག་གྱི་ག་དུས་ཡྱིན་ནའང་ཞུས་བསྡད་པ་དང་གཅྱིག་རག་པའྱི་བཟོ་ལྟ་བས།",
    "ཞུས་མ་ཤེས་མཁན་དེར་ག་དུས་ཡྱིན་ནའང་གཅྱིག་ཀང་མ་རག་ཁོ་ཉམ་ཐག་གྱི་ཁོངས་ལའང་མ་ཚུད།",
    "ཁོང་རྣམ་པ་གཉྱིས་ལ་དེ་འདྲ་ཞྱིག་གནང་ཐུབ་པ་ཡྱིན་ན་ཡག་པོ་མྱི་འདུག་གམ།",
    "ཡྱིན་ནའང་མར་གོ་རོགས་སེལ་རྒྱུའྱི་ཆེད་དུ་ཕྱི་ལ་གནང་དགོས་ཀྱི་འདུག་ཅེས་གསུངས་པ་ནང་བཞྱིན་མ་འོངས་པར་ཡྱིན་ན་ས་གནས་ག་པར་གནང་དགོས་ཀྱི་འདུག་དེའྱི་ཐོག་ལ་དགོངས་པ་ཆེ་བཞེས་གནང་རྒྱུ་ཆགས་བསྡད་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "ངས་ད་ལྟ་ཉམ་ཐག་འདྱི་ཡོད་ཅེས་ཁ་གྲངས་ཏག་ཏག་ཅྱིག་ཞུ་ཐུབ་ཀྱི་མྱི་འདུག་ཁ་སང་བར་དུ་དགུ་བརྒྱ་དྲུག་བཅུ་ལྷག་ཙམ་ཞྱིག་ཡོད་བསམ་པའྱི་ཚོར་བ་ཡོད།",
    "བས་ཙང་དེ་དག་ཚང་མར་དགོངས་པ་བཞེས་པའྱི་ཐོག་ནས་གོམ་པ་རྒྱག་དགོས་པའྱི་གནས་སྟངས་ཤྱིག་ཆགས་བསྡད་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "སྱི་འཐུས་ཙ་ནེ་ཚང་དོན་གྲུབ་བཀྲ་ཤྱིས་ལགས།",
    "སྱི་འཐུས་ཙ་ནེ་ཚང་དོན་གྲུབ་བཀྲ་ཤྱིས་ལགས་ནས།",
    "འབེལ་བ་མང་པོ་བས་ནས་དེར་དོགས་འདྲྱི་གནང་རོགས་ཟེར་ནས་ཞུས་ཀྱི་འདུག་ང་རང་གྱི་གང་ཤེས་པ།",
    "ཡྱི་འགྲོ་སྟངས་མ་ཤེས་ནས་མགོ་རོག་མཁན་མང་པོ་བྱུང་འདུག་དེ་ཡྱིན་དུས་དང་།",
    "ལྷན་ཁང་ལ་ང་རང་བཅར་ནས་གཞྱིས་ཆགས་གང་ཡྱིན་ཞུ་ཡྱི་ཡྱིན།",
    "ང་རང་ཡྱིན་ནའང་འབེལ་ཡོད་ལས་བེད་མཉམ་དུ་གོ་བསྡུར་ཞུ་སྟེ་མ་འོངས་པར་གནས་ཚུལ་དེ་རྱིགས་མྱི་ཡོང་བའྱི་དམ་དོན་གནང་དགོས་ཀྱི་འདུག་ཅེས་ངས་ཞུས་ཆོག་པ་བགྱིས།"
  ]
}