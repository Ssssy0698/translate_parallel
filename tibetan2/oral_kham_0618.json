    "རང་རྒྱུད་གཞན་གྲགས་སྤྱིའི་རྣམ་གཞག་དང་རང་རྒྱུད་ཁས་མི་ལེན་པ་འཐད་པའོ།",
    "མཐའ་བཞིའི་སྐྱེ་བ་བཀག་པས་ཁེགས་ལ་༨བ་ཐ་སྙད་ཙམ་དུ་ཡིན་ན་ཡང་རང་རིག་སྒྲུབ་པའི་རྟགས་སུ་མི་རུང་སྟེ།",
    "མྱོང་ཙམ་ཡོད་པར་གྲུབ་པས་ཀྱང་རང་མྱོང་ཡོད་པར་མི་འགྲུབ་སྟེ།",
    "དེའི་ཞེན་ཡུལ་བཀག་པ་གོམས་པར་བྱས་པ་ཙམ་གྱིས་སྲིད་པ་ལས་གྲོལ་ནུས་པར་དོན་སེམས་དང་རང་རྒྱུད་པ་རྣམས་མཐུན་ནོ།",
    "རྟེན་འབྱུང་རང་བཞིན་མེད་པ་མངོན་སུམ་དུ་རྟོགས་པའི་ཚེ་བདེན་པའི་སྣང་བ་ལྡོག་དགོས་ཏེ།",
    "དེའི་འདུག་ལུགས་འཁྲུལ་མེད་དུ་མཐོང་བས་ཡིན་ནོ།",
    "དེའི་འདུག་ལུགས་འཁྲུལ་མེད་དུ་མཐོང་བའི་ཚེ་ན་ཡང་བདེན་པར་སྣང་ན།",
    "ཚོགས་འཁོར་དང་དཔའ་བོའི་བཟའ་བའི་དུས་ལྟ་བུའི་ཚིག་དུས་ལ་བབ་པ་དང་།",
    "དེར་ནི་མངོན་སུམ་དང་རང་དོན་དང་།",
    "པར་བཞེད་ཅེས་གསུང་བ་ཡང་རང་དོན་གྱི་སྐབས་སུ་འཆད་པར་འགྱུར་རོ།",
    "སྨིག་རྒྱུའི་ཁ་དོག་སྣང་བ་ལ་ཆུ་འདུག་སྙམ་དུ་ཞེན་ནས་ཞུགས་པས་དོན་མི་ཐོབ་པ་བཞིན་ནོ།",
    "དེ་ལྟར་ཡང་ཊཱིཀྐ་འཐད་ལྡན་དུ་སྣང་བ་ཡང་རང་ཉིད་རྟོག་པ་མེད་པར་ངེས་པའི་རང་བཞིན་དེ་ཁོ་ན་བཞིན་དུ་ངེས་པའི་ཕྱིར།",
    "སྔོན་པོ་ལ་སོགས་པ་གང་ཞིག་རང་འཛིན་ཤེས་པའི་གཟུང་བའི་སྣང་བ་དེའི་ལག་རྗེས་བཞག་པའི་སྒོ་ནས་ཤེས་པ་དེ་བདག་ཉིད་ཀྱིས་རྗེས་སུ་འགྲོ་བ་དང་རང་འདྲའི་རྣམ་པ་དངོས་སུ་མ་གཏད་ན་ཤེས་པ་དེ་ལྡོག་པའི་རྗེས་སུ་མཐུན་པར་བྱེད་པའི་དོན་དེ་ནི་མངོན་སུམ་པ་དང་།",
    "གལ་ཏེ་རྟོག་པ་ལ་ཡང་རང་མཚན་གྱི་རྣམ་པ་སྣང་བའི་ཕྱིར་རང་མཚན་གྱི་རྣམ་པ་ཤར་བས་ཡུལ་མངོན་གྱུར་དང་།",
    "ཅེས་པ་དང་དོན་གཅིག་པས་བརྗོད་འདོད་ལ་དོན་སྤྱི་སྣང་བ་དཔོག་པ་མིན་གྱི་བརྗོད་འདོད་དཔགས་པ་ཙམ་གྱིས་ཕ་རོལ་པོའི་དོགས་པ་མི་ཁེགས་ལ་ཁ་ཅིག་བུམ་པའི་རྣམ་པ་ཅན་གྱི་བློ་དཔོག་༢ན་ཟེར་བ་ཡང་དོན་སྤྱི་ཤར་བ་ལ་བྱེད་ན་བརྗོད་འདོད་ལས་མ་འདས་ཤིང་རང་མཚན་གཟུང་ཡུལ་དུ་བྱེད་པ་ལ་ཟེར་ན་གཟུང་ཡུལ་ལ་མ་འཁྲུལ་བའི་བློ་དཔོག་མི་ནུས་ཤིང་།",
    "དེ་མི་སྣང་ཡང་རང་བཞིན་འགལ་བ་འཛིན་པར་མི་འགྲུབ་བོ།",
    "མིང་རང་མཚན་དང་དོན་སྦྱོར་བའི་རྟོག་པ་ཡིན་པ་དགག་པ་དང་།",
    "གཉིས་པ་ལ་ཡུལ་ལ་སྦྱར་བ་ནི་གཟུགས་མིང་རང་མཚན་གྱི་བདག་ཉིད་དང་རྟེན་ཀྱང་མ་ཡིན་ལ།",
    "རྟོག་པ་ལ་དོན་སྤྱི་སྣང་བར་འདོད་ཅིང་རང་མཚན་གྱི་སྣང་བ་མི་སྣང་བར་འདོད་པ་མི་རིགས་ཏེ།",
    "བསྔགས་པ་བྱ་ཞིང་བསྟོད་པར་འོས་པ་དེར་འདུག།",
    "མི་རྟག་པར་ངེས་པའི་ངེས་ཤེས་ཀྱིས་ཀྱང་དེ་ཉིད་ཞིག་དུས་སུ་སྐྱེ་བ་ཡིན་གྱི།",
    "དེ་མྱོང་རང་རིག་མངོན་སུམ་ལ་གསལ་བར་སྣང་བའི་ཕྱིར་ཅེ་ན་ནི།",
    "གྲངས་ཅན་གྱིས་སྔར་བཀོད་པ་དེ་རྣམས་ཕྱི་རོལ་གཟུང་དོན་དུ་བྱེད་པའི་མཚན་ཉིད་དུ་མི་རུང་ཞིང་རང་འདྲའི་རྣམ་པ་དངོས་སུ་གཏོད་བྱེད་གཟུང་དོན་གྱི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "བློ་དེ་ཡང་མྱོང་བ་དང་རང་བཞིན་གཅིག་ཉིད་དུ་མངོན་སུམ་གྱིས་མཐོང་བའི་ཕྱིར།",
    "མེད་དགག་དངོས་མེད་ཡིན་ཅིང་རང་མཚན་མ་ཡིན་ལ།",
    "འདིར་བསྟན་པའི་རྣལ་འབྱོར་མངོན་སུམ་སེམས་ཙམ་པས་ཀྱང་རང་ལུགས་ལ་ཞལ་གྱིས་བཞེས་ཀྱང་།",
    "ཡང་ན་ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་དུ་མེད་པ་དེ།",
    "བརྟག་པ་མཐའ་བཟུང་རང་ལུགས་ལའང་ཁས་ལེན་པས་ཉེས་པ་མཚུངས་སོ་ཞེ་ན།",
    "དུས་ཅིག་ཅར་པ་ལ་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་མེད་ན་ཁྱེད་རང་ལ་ཡང་ཉེས་པ་མཚུངས་སོ་ཞེ་ན།",
    "ཕྱི་རོལ་པ་རྣམས་འཁྲུལ་པ་དེརད་ལྟར་གྱི་རིགས་པ་སྨྲ་བར་རློམ་པ་རྣམས་ཀྱང་འཁྲུལ་པ་ཤིན་ཏུ་མང་བར་འདུག་གསུངས་པ་ཤིན་ཏུ་མད་པར་སྣང་ངོ།",
    "མ་རིག་པས་མ་བསླད་པའི་མངོན་སུམ་གྱི་གཟུང་ཡུལ་ཡིན་ཅིང་རང་འཇལ་བའི་མངོན་སུམ་དེ།",
    "དེ་ལྟ་ན་རང་རང་བཞིན་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "ཚུལ་གསུམ་པའི་རྟགས་བྲིས་པ་མཐོང་༡༥བ་བ་དང་སྦྱོར་བ་གོམས་པའི་ངག་ལས་ཀྱང་རང་ལ་རྟོགས་པ་སྐྱེ་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "རང་རྒྱུད་ཀྱི་རྟོག་པ་ཡུལ་ལ་འཇུག་ཚུལ་ཇི་ལྟར་འདུག་སྙམ་དུ་མ་བརྟགས་པའི་གཏམ་ཡིན་ཏེ།",
    "བུམ་པའོ་སྙམ་པའི་རྟོག་པ་དེས་བུམ་པ་འདུག་གོ་སྙམ་པ་ཙམ་ཞིག་ཞེན་སྟངས་ལ་ཡོད་དམ།",
    "འདི་ཕྱི་རོལ་ལོ་སྙམ་པ་ཡོད་ཀྱང་རང་ལ་སྣང་བའི་གཟུང་རྣམ་དང་རྗ་སྐུ་པ་ཞེན་སྟངས་ལ་ཡོད་སྙམ།",
    "རང་མཚན་ལ་མི་སླུ་བ་ཡིན་ཀྱང་རང་མཚན་གསལ་བར་སྣང་བ་དེ་ཡི་ངོ་བོས་སྟོང་པའི་རང་མཚན་གྱི་གཟུགས་བརྙན་དེ་ལ་དམིགས་ནས་རང་མཚན་དེ་ཡི་ངོ་བོར་ཞེན་པའི་ཕྱིར།",
    "སྒོ་གསེབ་ཏུ་འོད་མཐོང་བ་ན་དེར་ནོར་བུ་འདུག་གོ་སྙམ་དུ་བསམས་ཀྱང་ར་བའི་ཕུག་ཏུ་ཐོབ་པའི་ཕྱིར།",
    "གཞལ་བྱ་ཡིན་ན་རང་མཚན་ཡིན་པའི་ཁྱབ་པ་དེ་ཉིད་གཞལ་བྱར་ཁས་བླངས་ནས་ཡང་རང་མཚན་མ་ཡིན་པ་མི་སྲིད་པར་འདོད་པ་ཉམས་སོ།",
    "ཡུལ་དང་རང་བཞིན་འདྲ་མ་ཡིན།",
    "དེས་ན་བྱས་པ་འཇིག་པར་འགྱུར་བ་ཡུལ་དང་དུས་དང་རང་བཞིན་བྱེ་བྲག་པའི་རྒྱུ་ལ་བལྟོས་པ་མ་ཡིན་པར་བྱས་པ་ཡོད་ཙམ་དུ་ལག་རྗེས་འཇོག་པའི་རིགས་ཀྱི་རྒྱུ་ནུས་པ་ཐོགས་མེད་དེ།",
    "ཉེས་པ་འདི་དག་ནི་རང་མཚན་དགག་སྒྲུབ་ཀྱི་གཞིར་མི་རུང་བར་འདོད་པ་དེ་དག་ལ་ཡང་རང་ཚིག་འགལ་བའི་གནོད་པ་འབབ་པར་བསྟན་ཏེ།",
    "རང་ཉིད་བསླད་པའང་རང་ཉིད་ཀྱིས་ཤེས་པ་མ་ཡིན་ཏེ།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའི་གཏན་ཚིགས་རྣམས་སུ་ངེས་པའི་ཕྱིར།",
    "རང་བཞིན་གྱི་རྟགས་སུ་མ་ཟད་འབྲས་བུ་དུ་བ་ཡང་མེ་དང་རང་བཞིན་འབྲེལ་བ་གྲུབ་པ་ཡིན་ཏེ་དུ་བ་དེའི་རང་བཞིན་མེ་དེ་ལས་བྱུང་བའི་ཕྱིར་རོ།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བ་རྣམས་སུ་ཡོད་པའི་ཕྱིར།",
    "དུས་ཕྱིས་འགྲོ་ལྡིང་བས་ཀྱང་ཡུལ་དབུས་པ་དག་དུས་ཀྱི་ཁྱད་པར་དང་གསོད་པ་ལ་བརྡ་བྱེད་པ་མཐོང་ན་འགྲོ་ལྡིང་བས་ཀྱང་སྔར་གྱི་དེ་ལས་གཞན་དུ་གྱུར་ནས་སྒྲ་དེ་གཉིས་དུས་ཀྱི་ཁྱད་པར་དང་གསོད་པ་ལ་སོགས་པ་དག་ཏུ་རྟོགས་པ་བཞིན་ནོ།",
    "དེས་ན་གྲགས་པའི་གཏན་ཚིགས་ཡང་དག་འདོད་པ་དག་རང་དོན་ལེའུའི་སྐབས་ན་འདུག་མི་འདུག་ལེགས་པར་རྟོགས་ཤིག།",
    "བྱས་པ་དེ་ཡོད་ཙམ་དང་རང་ཆས་སུ་རྗེས་སུ་འབྲེལ་བ་ཅན་འཇིག་པའི་བདག་ཉིད་ཀྱི་གཏན་ཚིགས་བྱས་པ་དེ་ནི་སྒྲ་འཇིག་པར་སྒྲུབ་པའི་རང་བཞིན་གྱི་གཏན་ཚིགས་ཡིན་ནོ།",
    "འདིར་སྨོས་པའི་ཕྱོགས་འདིས་གཞན་དུ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་དབྱེ་བ་ཤེས་པར་བལྟ་བར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "འདིའི་ཁྱབ་པ་ནི་འབྲས་བུ་བྱེད་པ་ལ་རིམ་པས་བྱེད་པ་དང་དུས་གཅིག་ཏུ་བྱེད་པ་གཉིས་འདུག་པ་མངོན་སུམ་གྱིས་གྲུབ་ཅིང་།",
    "ཁོ་བོ་ཅག་ཀྱང་རང་མཚན་གྱི་མཚན་གཞི་འཛིན་ཏེ་ཞེ་ན།",
    "འགལ་བ་ལ་མི་འཁྲུལ་བའི་དཔེ་མི་སྲིད་པ་མ་ཡིན་ཏེ།",
    "བྱས་པ་དེ་རང་ཡོད་ཙམ་དང་རང་ཆས་སུ་འཇིག་པ་རྗེས་སུ་འབྲེལ་བའི་ཕྱིར།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡང་རང་བཞིན་འབྲེལ་བ་ངེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གདོན་ཀྱང་རང་སེམས་འཁྲུལ་པའི་རྩལ",
    "རང་སྣང་རང་བཞིན་མེད་པར་ཤེས།",
    "སྐུ་ཡང་རང་ལ་ཐིམ་པ་ཡིས།",
    "མེད་དོ་སྙམ་པའང་རང་གྲེལ་བ།",
    "ནང་རང་བྱུང་ལོངས་སྤྱོད་རྫོགས་པའི་གནས་འོག་མིན་སྟུག་པོ་བཀོད་པའི་དབྱིངས་སུ།",
    "ན་རག་བཤགས་བསྐང་ཞི་ཁྲོ་གསང་བ་ཡོངས་རྫོགས་དང་རང་ཤར་གཉིས་ལས་བསྟན་པ་ཕྱོགས་གཅིག་ཏུ་བསྔགས་ཏེ་བསྲེ་བསླད་ཚིག་གཅིག་ཙམ་ཡང་མེད་པར་ལྷག་བསམ་ངག་བའི་སྒོ་ནས་པདྨའི་མིང་ཅན་གྱིས་དགེ་གནས་སུ་བྲིས་པའོ། ལག་ལེན་རྒྱུག་བྱང་ནི།",
    "བདེ་སྟོང་རང་བྱུང་མངོན་གྱུར་སྩོལ།",
    "ལོ་ཟླ་ཞག་དུས་ཟ་མའི་ལྷ",
    "དམ་ཉམས་དགྲ་ལ་རྦད་ཙ་ན་སྲོག་བདུང་ནག་པོ་བྱ་རོག་གདོང་",
    "བཅུ་གཅིག་པ་རྡོ་རྗེའི་འདུག་སྟངས་ནི།",
    "བཅས་དང་རང་བཞིན་ཉམས་པའི་སྡིག་ལྟུང་ཀུན།",
    "རང་རང་སྐད་དང་བློ་འཚམ་པའི།",
    "རང་རང་ལས་ཀྱི་ཕྲིན་ལས་བཅོལ།",
    "ཆེ་ཐབས་དང་སྙན་གྲགས་བསྒྲུབ་བ་ལ་སོགསཅི་དང་ཅི་བྱས་ཀྱང་ཡིད་བརྟན་དང་བློ་ལྟོས་རུང་བ་མི་འདུག།",
    "ཡང་རང་ཉིད་གང་ནས་ཕྱིན་ཆ་མེད་པའི་ལུང་བ་ཐག་རིང་ངོམ་འཚལ་བ་ཞིག་ཏུ་སླེབས།",
    "གར་འགྲོའི་གཏད་སོ་མེད་པར་ཐོམ་ཐོམ་ཡོད་ཙ་ན།",
    "ད་ནི་འགྲོས་ས་ཡང་མི་འདུག་སྙམ་ནས་ངུ་སྐད་ལྷང་ལྷང་འབོད་པའི་ཚོ།",
    "སྟོབས་ལྡན་གྱི་འདབ་ཆགས་འཇིགས་པ་ཅན་འདི་ལྟ་བུས་བདག་ཉིད་གསོན་ཟས་བྱེད་པ་ཨ་ཙི།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡིདཔལ་ལ་སྡང་ཕྱིར་ཡིད་ཀྱི་སྡུག་བསྔལ་ཆེ།",
    "ཞེས་གསུངས་འདུག་པས་ཧ་བྷོ་ཧ་བྷོ།",
    "དགྲྭ་དང་དེའི་ཕྱོགས་ལ་སྡང་ཞེན་མི་བཟདཔར་བྱེད་པ་འདི་ཡང་མ་བརྟགས་པའི་སྐྱོན་དུ་འདུག།",
    "ལུས་ནི་འགྲོ་དང་འདུག་པ་དང་།",
    "དེས་ཡུལ་སྣང་རང་བཞིན་མེད་པར་གྲོལ་བའི་དགོས་པ་ཡོད་དོ།",
    "ཀུན་མཁྱགྱིས་ཁཅིག་རྐང་མཐིལ་ས་ལ་ཕབ་ནསཙོག་པུར་འདུག་པའི་གཡས་གཡོན་གཉིས་སུ་ལག་པའི་མཐིལ་ས་ལ་འཛུགས་པར་འདོད་དེ།",
    "སེང་གེའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ།",
    "སྐད་ཅིག་མ་དང་པོར་རང་སྣང་རང་བཞིན་མེདཔར་ཡིད་ཆེས།",
    "འཇོག་རྒྱུ་ནི་མེད་དེ་ལྷུན་གྲུབ་ཏུ་འདུག་གོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་བློ་ལས་འདས་པཡང་འདི་གར་འདུག་གོ།",
    "རྫོགས་ཆེན་ཁེས་བསླུས་ཡོང་བསམ་པ་རང་མི་གདའ།",
    "ཕྱོགས་ལྷུང་ནི་མི་འདུག་རྫོགས་ཆེན་གྱི་ལྟབ།",
    "ཐབསྤྱོད་དང་རང་བཞིན་སྤྲུལ་པའི་སྐུའི་ཞིང་དུ་དབུགས་འབྱིན་ཞིང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པའི་མཎྜལ་ཕུལ་ནས་གསོལ་བ་གདབ་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "བདག་ལ་དེ་ལྟར་གྱི་གདེང་མི་འདུག།",
    "དད་ལོག་སྣང་བ་བསྒྱུར་ནུས་པ་ཞིག་འོང་བར་གདའ་སྟེ་བཀའ་དྲིན་ཆེ།",
    "འགྲོ་འདུག་སྟེངས་སུ་བྱས་ནས་ནི།",
    "འགྲོ་འམ་ཉལ་ལ་འདུག་ཀྱང་རུང་།",
    "ཉན་ཐོས་དང་རང་ས་ས་རྒྱས་དང་།",
    "འཁོར་མང་པ་དང་མཉམ་པར་འདུག་པའི་དུས་ན།",
    "འགྲེ་ཉལ་འདུག་སྡོད་ཅི་བྱེད་ཀྱང་།",
    "ང་ཡང་རང་བཞིན་མེད་པར་དམིགས།",
    "ཀུན་ཏུ་བཟང་དང་ལོ་ཙ་ན།",
    "དཀྱིལ་འཁོར་སྟེང་དུ་བདག་འདུག་ལ།",
    "དྲག་ཤུལ་ཆེན་པོ་འདུག་པརབཀའ་སྩལ་པ།",
    "འགྲོ་ན་སྟབས་སྡུག་འདུག་ཚུལ་ཤིས།",
    "འགྲོ་ན་སྟབས་སྡུག་འདུག་ཚུལ་ཤེས།",
    "ཕྱོགས་ཙམ་རྟོགས་པ་ཉན་ཐོས་དང་རང་རྒྱལ་བ་གཉིས།",
    "དེ་ལའང་རང་བཞིན་རྒྱུར་ལྟ་བས།",
    "ཞེས་ཅིར་སྣང་རང་སེམས་ཀྱི་སྣང་བ་ཙམ་དུ་ཟད་ལ།",
    "ཤེས་རབ་ཀྱིས་། བློ་ཤིན་ཏུ་མ་སྦྱངས་པ་གང་ཞིག་དུས་ཀྱིས་མནར་བའི་སྐྱེ་བོ་ལྔ་བརྒྱ་ཐ་མ་པ་ལ་སྐྱེས་པ་དག།",
    "འཁྲུལ་ཀྱང་རང་བཞིན་ལས་མ་འདས་པའི་ཚུལ།",
    "དེ་ལྟ་ན་ཡུལ་ཡུལ་ཅན་གྱི་རང་བཞིན་ནམ་གནས་ཚུལ་འདི་ལྟ་བུ་ཡིན་ཀྱང་རང་བཞིན་འདི་ལས་སེམས་དེ་རྟག་བདག་སོགས་སུ་སྒྲོ་འདོགས་པའི་རྐྱེན་གཞན་གྱིས་ནི་ཕྱིན་ཅི་ལོག་ཏུ་གོལ་བར་འགྱུར་ཞིང་།",
    "ཞེས་ཡོངས་སུ་དག་པ་འབྲས་བུའི་དུས་ཀྱི་དབྱིངས་དང་རང་བཞིན་དུ་གནས་པའི་རིགས་ལ་ངོ་བོའི་ཆ་ནས་འགྱུར་བ་དང་བཟང་ངན་གྱི་ཁྱད་པར་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "དེས་ཐབས་མཁས་སྦྱོར་བས་མྱུར་དུ་འཚང་རྒྱ་བ་སྔགས་ཀྱི་ཐབས་རྣམས་ཀྱང་རང་སྟོབས་ཀྱིས་མངོན་དུ་བྱེད་ནུས་པ་ལྟ་བུའོ།",
    "དེ་འདྲའི་གོང་བུ་དེ་གྲང་བའི་རྐྱེན་དང་ལྡན་ན་དུས་ཤིན་ཏུ་ཡུན་རིང་པོར་འདུག་ཀྱང་མར་གསར་གྱི་གོང་བུ་ལྟར་འདུག་གོ།",
    "ཆུ་དྲག་པོ་ལམ་སྲོལ་དུ་འཛུད་པ་ལྟར་དྲན་པས་སླར་ཡང་རང་ཤུལ་དུ་བླན་ཏེ་བཞག་པ་ནི་གསུམ་པའོ།",
    "སྐྱོན་མེད་པ་ན་བཏང་སྙོམས་སུ་འདུག་པ་སྟེ་སྤྲོ་རྩོལ་དྲན་དང་ཤེས་བཞིན་བཏང་སྙོམས་ལྔས་ཡང་ནས་ཡང་དུ་བསྒྲུབས་པས།",
    "དྲུག་པ་བཀྲི་བ་དང་ངེས་པའི་དོན་དུ་གསུངས་པའི་སྡོམ་པ་ཇི་སྙེད་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པའི་ཚུལ་དུ་འདུས་ཤིང་རྣམ་པར་དག་པ་ནི་གོང་དུ་བསྟན་པ་བཞིན་ནོ།",
    "ལུས་ཀྱི་ནི་ཕྱག་རྒྱ་དང་བྲོ་དང་གར་དང་ལྟ་སྟངས་དང་འདུག་ཚུལ་ལ་སོགས་པ་དང་།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "ལྷ་དེ་ཡང་རང་རྒྱུད་པ་མིང་གཟུགས་མཚན་མའི་རྣམ་པ་ཉི།",
    "ཤིང་རྟ་ལ་སོགས་རྟ་ལ་འདུག་སྤྱོད་པ།",
    "དེ་ཡང་སློབ་དཔོན་གྱི་གཡོན་ཕྱོགས་སུ་གནས་པ་གཟུངས་མ་མཚན་ཉིད་དང་ལྡན་པ་ལ་འདུག་སྟངས་སོགས་ཚུལ་བཞིན་དུ་བྱས་ལ།",
    "དེ་ནས་ཐ་མལ་གྱི་འདོད་ཆགས་མ་སྤང་རང་སར་དག་ནས་ལྷན་སྐྱེས་བདེ་བའི་ཡེ་ཤེས་ཆེན་པོར་གསལ་བའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་གྱི་མཚམས་ནི་རྣམ་པར་རྟོག་པ་བགེགས་ཡིན་ལ།",
    "དེ་ཙ་ན་ཉི་མ་ལ་མུན་པའི་གཞི་མེད་པ་ལྟར་དོན་དམ་རིག་པ་བྱུང་ཆུབ་ཀྱི་སེམས་དེ་ནི་གཟུང་འཛིན་གྱི་སྤྱོད་ཡུལ་ཅན་གྱི་མཚན་མའི་དམིགས་པའི་མཐའ་ཐམས་ཅད་ཀུན་ཏུ་དག་པ་ཡིན་པས་ན་རང་བཞིན་བརྒྱད་ཅུའི་ཀུན་རྟོག་ལྟ་བུ་ཁམས་གསུམ་གྱི་སེམས་དང་སེམས་ལས་བྱུང་བ་མཐའ་དག་ལས་ཀྱང་རབ་ཏུ་འདས་ནས་ཀྱང་ཐམས་ཅད་སྟོང་པ་ཆེན་པོའི་ངང་ལས་མི་གཡོ་བའོ།",
    "ཧཱུྃ་ཧ་ཧེ་ཕཊ་བྷྱོ་རཾ་ཞེས་བརྗོད་པ་ཙམ་གྱིས་སོ་སོའི་ཡིག་། འབྲུར་གྱུར་ནས་སོ་སོའི་གནས་ན་བསྐལ་མེ་ལྟར་འབར་ཞིང་འདུག་པ་ལ།",
    "ཕྱག་རྒྱ་བཞིས་བཅིངས་ལ་ཁོ་རང་དངོས་སུ་བསམ་པའམ་མཚན་མའི་རྫས་ལ་དགྲ་བགེགས་དགུག་པ་སྲོག་མེད་ཀྱི་སྒྲུབ་རྫས་སམ།",
    "ཐོག་མར་སློབ་དཔོན་བདག་ཉིད་དཀྱིལ་འཁོར་གྱི་ནུབ་ཕྱོགས་སུ་འདུག་སྟེ་རྡོ་རྗེ་ཤུགས་ཀྱི་ཕྱག་རྒྱས་བཏེགས་པས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་མདུན་གྱྀ་མཁའ་ལ་སྨིན་མཚམས་ཡན་ཆད་འོད་ཕུང་འདབ་འདྲེས་སུ་བཞུགས་པར་བསམས་ལ།",
    "རྡོ་རྗེའི་ལུས་ཉིད་ཀྱི་བསྒུལ་བསྐྱོད་ཕྱག་རྒྱ་འགྲོ་འདུག་གར་དུ་ཤེས་ཤིང་གཟུངས་ཀྱི་ཕྱག་རྒྱ་ལ་བརྟེན་ནས་བདེ་བའི་བརྟུལ་ཞུགས་གྲུབ་པའི་ལམ་གཙོ་བོར་བྱེད་པ་དང་།",
    "དེ་ཡང་རང་བཞིན་དང་ཐབས་ལ་མཁས་པས་དེ་བསྒྲུབ་པའི་ཚུལ་གྱིས་ཀུན་ཀྱང་འཆི་བ་མེད་པའི་བཅུད་ལེན་དུ་གྱུར་པར་སྒྲུབ་ཚུལ་ནི་བདུད་རྩིའི་རྒྱུད་ལས་གསུང་པས་ན།",
    "སྤྱིར་ངང་དང་རང་བཞིན་དང་བདག་ཉིད་ཆེན་པོ་སྟེ་སྣང་སྲིད་རྣམ་པར་འ་། དག་པའི་དབྱིངས་ནས་སྐྱེད་པའོ།",
    "ཏིང་འཛིན་དང་རང་བཞིན་གྱི་ཕུར་པ་འདི་གཉིས་ལ་འདུས་བྱས་རྫས་ཀྱི་ཕུར་པར་ཅི་ལ་བཏགས་སྙམ་ན་འདུས་བྱས་རྫས་ཀྱི་ཕུར་པ་ལྷ་གྲངས་དང་མཉམ་པ་དལ་དུ་བཀོད་ནས་དེ་ལ་དམིགས་རྟེན་བྱས་ཏེ།",
    "བརྒྱད་པ་དམག་ཟས་བྱིན་ཅིང་དམག་དུས་བཏབ་པ་ནི།",
    "ལས་གྲུབ་པ་དང་གཏང་རག་དུས་སུ་བཏང་ལ་ཕྱིས་ཀྱི་ལས་གཉེར་གཏད་བྱ་བའོ།",
    "དེ་ལྟར་བརྟེན་མ་ཤེས་ན་འཁོར་ལ་ཆགས་ཤིང་རང་དཔལ་སོ་དམའ།",
    "དེ་ལྟར་བརྟེན་མ་ཤེས་ན་ནོར་ལ་གཟན་ཅིང་རང་ཉིད་ལྟོག་པོར་འགྲོ།",
    "དང་པོ་སྲོག་སྡོམས་གཟེར་བཞིའི་སྒོ་ནས་ལྷའི་ཐུགས་སྲོག་ཕྲོག་ཏེ་ལྷ་དང་རང་གཉིས་སུ་མེད་པར་བྱ་བ་དང་།",
    "ཕལ་པ་མི་ལ་སོགས་པ་ལའང་རང་སྲོག་དང་མིང་གཉིས་སུ་འདུ་བས་དེ་འཕྲོག་ཅིང་གཟིར་བའི་ལས་ཀྱིས་ཇི་ལྟར་དམིགས་པ་བཞིན་ལས་འགྲུབ་བོ།",
    "རྨི་ལམ་དུ་གླེགས་བམ་ཁང་སྟེང་དུ་བབ་པ་སོགས་རྨིས་པ་ལྟར་ཁང་སྟེང་དུ་གླེགས་བམ་རྣམས་བབས་འདུག་པ་དོན་མ་ཤེས་པའི་ཚུལ་མཛད་ནས་སློབ་དཔོན་ཀུ་ཀུ་རཱ་ཛ་ལ་བསྟན་ཀྱང་མ་ཤེས་ནས།",
    "བདག་ལ་བོད་ཀྱི་རྒྱལ་པོས་གསེར་ཕྱེ་བྲེ་གང་བསྐུར་ནས་སྐྱེས་ལན་པཎྜི་ཏ་མཁས་པ་བོད་དུ་རྫོངས་ཤིག་ཞུས་འདུག་པས་ཁྱེད་རྣམས་ཀྱི་ནང་ནས་མཁས་པ་ཞིག་བོད་དུ་གཤེགས་པར་འཚལ་ཞེས་ཞུས་པས།",
    "བེ་རོ་ཙ་ན་སྟེ་རྒྱ་གར་གྱི་སློབ་དཔོན་གཉིས།",
    "བདེ་བའི་སྟན་འདུག་སོགས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཀུན་དུ་རྒྱུ་དང་གཅེར་བུ་པ་དང་འཚེ་བ་ཅན་ཐམས་ཅད་དེ་བཞིན་གཤེགས་པའི་མདུན་དུ་འདུག་པར་ནུས་པ་མེད་དོ།",
