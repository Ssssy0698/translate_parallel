    "རྒྱལ་བས་བསྟེན་པ་བདག་གིས་འདིར་སྨྲས་ཀྱིས།",
    "ཕྱོགས་བཅུའི་རྒྱལ་བ་ཀུན་གྱིས་དེ་དག་གི།",
    "དང་ཞིང་མོས་དང་གུས་པ་རབ་བསྐྱེད་ནས།",
    "ཉོན་མོངས་རྣམ་པར་སེལ་བའི་གཞི་རྟེན་ཡིན།",
    "དད་པ་རང་འབྱུང་ཡོན་ཏན་རྣམས་ཀྱང་ཚོལ།",
    "ཡོན་ཏན་ཞིང་གི་ས་བོན་མ་རུལ་བ།",
    "དད་པས་མོས་པའི་ཁྱད་པར་དགའ་རྣམས་ཀྱི།",
    "དེ་དག་མོས་པའི་ཁྱད་པར་རྒྱ་ཆེན་འགྱུར།",
    "གང་དག་མོས་པའི་ཁྱད་པར་རྒྱ་ཆེ་བ།",
    "དེ་དག་སྐད་ཅིག་རེ་ལ་ཕྱོགས་བཅུ་ཡི།",
    "མོས་པ་ཀུན་གྱི་བསྒྲུབ་པ་ཤེས་པ་རྣམས།",
    "ཁྱེའུ་དང་བུ་མོ་བུད་མེད་ལུས་རྣམས་དང་།",
    "དེ་དག་ལུས་དང་ངག་གི་རྣམ་འཕྲུལ་དང་།",
    "གང་དག་ལུས་དང་ངག་གི་རྣམ་འཕྲུལ་དང་།",
    "ཉོན་མོངས་རྣམ་དག་དོག་པ་ཁ་ཅིག་དང་།",
    "གསེར་གྱིས་བརྒྱན་པའི་རིན་ཆེན་བླ་རེ་རྣམས།",
    "ཕྱོགས་རྣམས་དག་ན་རོལ་མོ་ཇི་སྙེད་པ།",
    "མེ་ཏོག་ཕལ་ཆེན་མེ་ཏོག་བླ་རེ་དང་།",
    "བདུག་པ་ཕལ་ཆེན་བདུག་པའི་བླ་རེ་དང་།",
    "ཕལ་ཆེན་སྤོས་དང་སྤོས་ཀྱི་བླ་རེ་དང་།",
    "ཕྱེ་མ་ཕལ་ཆེན་ཕྱེ་མའི་བླ་རེ་དང་།",
    "ན་བཟའ་ཕལ་ཆེན་ན་བཟའི་བླ་རེ་དང་།",
    "ཕལ་ཆེན་གདུགས་དང་གདུགས་ཀྱི་བླ་རེ་དང་།",
    "རིན་ཆེན་ཕལ་ཆེན་རིན་ཆེན་བླ་རེ་དང་།",
    "པདྨ་ཕལ་ཆེན་པདྨའི་བླ་རེ་དང་།",
    "བདེ་དང་ལྡན་ལ་ཉོན་མོངས་ཆུང་ཡོད་པ།",
    "གར་མཁན་རྔ་མཁན་གྱད་དང་རོལ་མོ་མཁན།",
    "གང་ལ་ལྷར་བཅས་འཇིག་རྟེན་མོས་འགྱུར་བ།",
    "མུ་སྟེགས་ཉེ་རེག་ཡུལ་དུ་རྒྱུ་རྣམས་སུ།",
    "ཚེར་མ་རྩྭ་དང་ཐལ་བར་ཉལ་བ་དང་།",
    "དེ་དག་བསམ་པ་མོས་པ་རྟོགས་བྱས་ཤིང་།",
    "ལ་ལ་དག་ལ་གསལ་ཞིང་དྲང་ཚིག་གིས།",
    "ལ་ལ་དག་ལ་ལྷ་ཡི་གསང་ཚིག་གིས།",
    "ཀླུ་ཡི་ངེས་ཚིག་གནོད་སྦྱིན་ངེས་ཚིག་གིས།",
    "དེ་དག་འགྲོ་བདེ་མཆོག་གི་ཏིང་ངེ་འཛིན།",
    "བླ་ན་མེད་པའི་ཡེ་ཤེས་མཆོག་གི་རྒྱུ།",
    "དེ་དག་རྟག་ཏུ་གཏོང་ལ་དགའ་མོས་འགྱུར།",
    "དེ་དག་རྟག་ཏུ་བཟོད་མོས་དགའ་བར་འགྱུར།",
    "སྐྱེ་བོ་ཉོན་མོངས་རིན་ཆེན་རྣམས་ཀྱིས་བསྡུས།",
    "མི་ལ་མེད་སྤོས་ཡིད་འོང་ཚོར་གྱུར་ནས།",
    "སིལ་སྙན་དག་གིས་རྒྱལ་བ་རྣམས་བསུ་ཞིང་།",
    "དབུལ་པོ་དག་གིས་རིན་ཆེན་གཏེར་རྣམས་འཐོབ།",
    "སྐུ་གཟུགས་རི་མོ་སྣ་ཚོགས་མང་པོ་དང་།",
    "རེག་ན་རྩུབ་པ་འཇམ་ཞིང་བདེ་བར་འགྱུར།",
    "བཅོས་བུའི་རས་མང་འཇམ་ཞིང་རེག་བདེ་རྣམས།",
    "བྱུང་བ་ཐོས་ནས་མོས་པ་ཐམས་ཅད་ཚིམ།",
    "འོད་ཟེར་སྒོ་མོ་དེ་དག་ལ་སོགས་པ།",
    "ཡོན་ཏན་གང་གིས་འོད་ཟེར་གང་གྲུབ་པའི།",
    "མོས་ཉམས་ཕལ་པ་རྣམས་ཀྱིས་མི་མཐོང་སྟེ།",
    "བློ་གྲོས་ཡངས་པ་རྣམས་ལ་དེ་དག་མོད།",
    "དེ་དག་སྐྱེ་བོ་ཆེ་ལ་ཡོད་མོད་ཀྱི།",
    "དེ་བཞིན་སྐྱེས་ཆེན་འོད་ཟེར་དེ་དག་མོད།",
    "མོས་པ་ཉམས་པ་རྣམས་ཀྱིས་མི་མཐོང་སྟེ།",
    "བློ་གྲོས་ཡངས་པ་རྣམས་ལ་དེ་དག་མོད།",
    "དད་ཅིང་མོས་ལ་དང་བ་སྐྱེས་གྱུར་ན།",
    "ཀུན་ཀྱང་ཐལ་མོ་སྦྱར་ནས་ལྟ་ཞིང་འཁོད།",
    "ཕྱོགས་བཅུ་ཀུན་དུ་རང་གི་ལུས་སྟོན་ཏོ།",
    "དེ་བཞིན་ཕྱོགས་བཅུ་དག་གི་ཞིང་རྣམས་སུ།",
    "དེ་དག་མིག་གི་ལམ་ལ་མཉམ་བཞག་ཅིང་།",
    "མིག་གི་ལམ་ནས་དྲན་ལྡན་རྣམ་པར་ལྡང་།",
    "རེག་པའི་ལམ་ནས་བདག་ཉིད་ཆེན་པོ་ལྡང་།",
    "འཇིག་རྟེན་བདེ་བ་སྐྱེད་པའི་རེག་ལ་ཞུགས།",
    "རེག་པའི་ལམ་ལ་མཉམ་པར་བཞག་གྱུར་ཅིང་།",
    "ལང་ཚོ་ཤུགས་ལ་གནས་པ་རྣམས་ལས་ལྡང་།",
    "ལང་ཚོ་ཤུགས་གནས་རྣམས་ལ་མཉམ་བཞག་ཅིང་།",
    "སྐྲ་རྩེ་གཅིག་གི་ཁྱོན་ལས་རྣམ་པར་ལྡང་།",
    "སྐྲ་རྩེ་གཅིག་གི་ཁྱོན་ལ་མཉམ་བཞག་ཅིང་།",
    "སྐྲ་རྩེ་ཀུན་གྱི་ཁྱོན་ལས་རྣམ་པར་ལྡང་།",
    "སྐྲ་རྩེ་ཀུན་གྱི་ཁྱོན་ལ་མཉམ་བཞག་ཅིང་།",
    "ཡོན་ཏན་བསམ་ཡས་བསགས་པ་དེ་དག་གི།",
    "དེ་དག་སོ་སོ་རང་གི་གཟུགས་བརྙན་མཐོང་།",
    "གང་གི་གཟུགས་གང་གནས་གང་ཆ་བྱད་གང་།",
    "རྒྱ་མཚོའི་ལྷ་མོ་སྒྲ་ལྡན་ཞེས་བྱ་བ།",
    "རང་གི་སྐད་ཀྱིས་སྐད་ཀུན་ཚིམ་པར་བྱེད།",
    "ཚངས་པའི་བུ་མོ་ཡིད་ལས་བྱུང་བ་དེ།",
    "བརྟུལ་ཞུགས་གྲུབ་མཐུན་དབྱངས་ཀྱི་ཡན་ལག་གི།",
    "མཆེ་བ་དེ་དག་སོ་སོ་རེ་རེ་ལའང་།",
    "རྫིང་རེ་ལ་ཡང་པདྨ་སྣ་ཚོགས་པ།",
    "པདྨ་རེ་རེའང་ལྷ་ཡི་བུ་མོ་དག།",
    "དེ་དག་རྩེད་མོ་གླུ་གར་ཚུལ་ལ་མཁས།",
    "གླང་པོ་མཆོག་གི་རྣམ་འཕྲུལ་དེ་ལྟར་སྣང་།",
    "དེ་སྙེད་བརྒྱ་བྱིན་རང་གི་ལུས་ལས་སྤྲུལ།",
    "འཇིགས་ནས་དམག་བཅས་དེ་ཡི་མོད་ལ་འབྱེར།",
    "ཞི་བའི་སྒྲ་བསྒྲགས་ཉོན་མོངས་སེལ་བར་བྱེད།",
    "གཅིག་ལྟར་ལྷ་མོ་ཀུན་ཀྱང་དེ་བཞིན་ནོ།"
  ]
}