    "ཚོགས་བསགས་རིམ་པ་སྔོན་སོང་ནས་",
    "ཨོཾ་ཨ་པ་རི་མི་ཏ་ཨཱ་ཡུརྫྙཱ་ན་ས་ཏྭ་ས་མ་ཡ་ཨེ་ཧྱེ་ཧི་ཛ་ཧཱུྃ་བྃ་ཧོ་ན་མོ་ན་མཱ་མི་སརྦ་པཱུ་ཛ་ཧོ",
    "སྤོས་བསྲེག་རོལ་མོ་སྙན་པར་འཁྲོལ",
    "རྡོ་རྗེ་ཚེ་ཡི་ཕོ་ཉ་མོ",
    "བདག་གི་བླ་ཚེ་ཆད་ཉམས་བཅས",
    "དྲི་བཟང་བུད་ཤིང་མེ་སྦར་ལ",
    "༡༥༩བསྡུར་འབྲས་རེའུ་མིག་༡༦༨༦༣ འཕགས་པ་ཡོན་ཏན་བསྔགས་པ་དཔག་ཏུ་མེད་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༢༥བསྡུར་འབྲས་རེའུ་མིག་༢༦༨༦༩ འཕགས་པ་ཙནྡན་གྱི་ཡན་ལག་ཅེས་བྱ་བའི་གཟུངས།",
    "༢༡༢བསྡུར་འབྲས་རེའུ་མིག་༢ ༡༣ ༨ ༧ འཕགས་པ་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་སྒྲོན་མ་མཆོག་གི་གཟུངས།",
    "༢༤༢བསྡུར་འབྲས་རེའུ་མིག་༢༤༢༨༧༦ བཅོམ་ལྡན་འདས་སྣང་བ་མཐའ་ཡས་ཀྱི་གཟུངས་སྔགས།",
    "༢༤༤བསྡུར་འབྲས་རེའུ་མིག་༢ ༤༥༨༧༧ འོད་དཔག་མེད་མཐོང་བར་འགྱུར་བའི་གཟུངས།",
    "༢༤༧བསྡུར་འབྲས་རེའུ་མིག་༢༤༧༨༧༨ འཕགས་པ་པདྨའི་སྤྱན་ཞེས་བྱ་བའི་གཟུངས།",
    "༢༤༩བསྡུར་འབྲས་རེའུ་མིག་༢༥༨༧༩ སྣང་བ་མཐའ་ཡས་རྗེས་སུ་དྲན་པ།",
    "༢༥༢བསྡུར་འབྲས་རེའུ་མིག་༢༥༢༨༨ ཟླ་བའི་འོད་ཀྱི་མཚན་རྗེས་སུ་དྲན་པ།",
    "༢༥༨བསྡུར་འབྲས་རེའུ་མིག་༢༥༨༢ ༥༩ ༨ ༨༣ འཕགས་པ་དྲི་མ་མེད་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༢༦༨བསྡུར་འབྲས་རེའུ་མིག་༢༦༩༨ ༨༤ འཕགས་པ་ཁྱད་པར་ཅན་ཞེས་བྱ་བའི་གཟུངས།",
    "༢༩༨བསྡུར་འབྲས་རེའུ་མིག་༢༩༩༨༨༧ འཕགས་པ་བྱམས་པའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ།",
    "༣༡༣བསྡུར་འབྲས་རེའུ་མིག་༣༡༤༨༨༩ འཕགས་པ་ཀུན་དུ་བཟང་པོའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ།",
    "༣༢༤བསྡུར་འབྲས་རེའུ་མིག་༣ ༢༥༨༩ འཕགས་པ་ལག་ན་རྡོ་རྗེའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ།",
    "༣༤༢བསྡུར་འབྲས་རེའུ་མིག་༣༤༣༨༩༢ འཕགས་པ་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ།",
    "༣༩༤བསྡུར་འབྲས་རེའུ་མིག་༣༩ ༧༣༩༨༣༩༨༤༣༩༨༩༧ འཕགས་པ་ནོར་བུ་ཆེན་པོ་རྒྱས་པའི་གཞལ་མེད་ཁང་ཤིན་ཏུ་རབ་ཏུ་གནས་པ་གསང་བ་དམ་པའི་གསང་བའི་ཆོ་ག་ཞིབ་མོའི་རྒྱལ་པོ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༥༣བསྡུར་འབྲས་རེའུ་མིག་༤༦༨༩༨ འཕགས་པ་མེ་ཏོག་བརྩེགས་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༧༣བསྡུར་འབྲས་རེའུ་མིག་༤༧༤༩ འཕགས་པ་གཟུངས་ཆེན་པོ།",
    "༤༨༤བསྡུར་འབྲས་རེའུ་མིག་༤༨༤༩༢ འཕགས་པ་བྱམས་པས་དམ་བཅས་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༨ ༧བསྡུར་འབྲས་རེའུ་མིག་༤༨ ༧༩༣ འཕགས་པ་སྒྲིབ་པ་རྣམ་པར་སེལ་བ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༩བསྡུར་འབྲས་རེའུ་མིག་༤༩༩༤ འཕགས་པ་འཇམ་དཔལ་གྱི་ཞལ་ནས་གསུངས་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༩༢བསྡུར་འབྲས་རེའུ་མིག་༤༩༣༩༥ འཕགས་པ་འཇམ་དཔལ་གྱིས་དམོད་བཙུགས་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༩༦བསྡུར་འབྲས་རེའུ་མིག་༤༩༦༩༦ འཕགས་པ་འཇམ་དཔལ་གྱི་མཚན།",
    "༤༩༨བསྡུར་འབྲས་རེའུ་མིག་༤༩༨༩༧ རྗེ་བཙུན་འཕགས་པ་འཇམ་དཔལ་གྱི་ཤེས་རབ་དང་བློ་འཕེལ་བ་ཞེས་བྱ་བའི་གཟུངས།",
    "༥བསྡུར་འབྲས་རེའུ་མིག་༥༡༩༨ འཕགས་པ་འཇམ་དཔལ་གྱི་སྔགས་ཡི་གེ་འབྲུ་གཅིག་པའི་ཆོ་ག་༥༢བསྡུར་མཆན།",
    "ཐམས་ཅད་བྱམས་ཤིང་མོས་པར་འགྱུར་བའི་ཆོ་གའི་ལེའུ།",
    "༦༤༩བསྡུར་འབྲས་རེའུ་མིག་༦༥༤༩༡༤ ས་བཅུ་པའི་གཟུངས།",
    "༦༦༢བསྡུར་འབྲས་རེའུ་མིག་༦༦༣༩༡༥ འཕགས་པ་དོན་ཡོད་ཞགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༦༦༩བསྡུར་འབྲས་རེའུ་མིག་༦༧༩ ༡༦ འཕགས་པ་ཀུན་དུ་བཟང་པོ་ཞེས་བྱ་བའི་གཟུངས།",
    "༦༧༧བསྡུར་འབྲས་རེའུ་མིག་༦༧༨༩༡༧ འཕགས་པ་ནཱི་ལ་ཀཎྜ་ཞེས་བྱ་བའི་གཟུངས།",
    "༦༨༨བསྡུར་འབྲས་རེའུ་མིག་༦༩དེབ་གོ་བདུན་པའི་དཀར་ཆག་༡༥༩༡༩ འཕགས་པ་མེ་ཁ་ལ་ཞེས་བྱ་བའི་གཟུངས།",
    "༧༣བསྡུར་འབྲས་རེའུ་མིག་༧༣ ༡༩༢༦ འཕགས་པ་སྒོ་མཐའ་ཡས་པས་སྒྲུབ་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༧༥༤བསྡུར་འབྲས་རེའུ་མིག་༧༥༨༩༢༧ འཕགས་པ་སྒོ་བཟང་པོ་ཞེས་བྱ་བའི་གཟུངས།",
    "༧༧༡བསྡུར་འབྲས་རེའུ་མིག་༧༧༤༩༢༨ འཕགས་པ་སྒོ་དྲུག་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༧༧༧བསྡུར་འབྲས་རེའུ་མིག་༧༧༨༩༢༩ འཕགས་པ་ཡི་གེ་དྲུག་པའི་རིག་སྔགས།",
    "༧༨༡བསྡུར་འབྲས་རེའུ་མིག་༧༨༢༩༣ ཚིགས་སུ་བཅད་པ་གཉིས་པའི་གཟུངས།",
    "༧༨༤བསྡུར་འབྲས་རེའུ་མིག་༧༨༥༩༣༡ འཕགས་པ་ལུས་ཀྱི་དབྱིབས་མཛེས་ཞེས་བྱ་བའི་གཟུངས།",
    "༧༩༤བསྡུར་འབྲས་རེའུ་མིག་༧༩༥༩༣༣ མཆོད་རྟེན་གཅིག་བཏབ་ན་བྱེ་བ་བཏབ་པར་འགྱུར་བའི་གཟུངས་༧༩ ༦བསྡུར་མཆན།",
    "༧༩ ༨བསྡུར་འབྲས་རེའུ་མིག་༧༩༨༩༣༤ འཕགས་པ་གཙུག་གི་ནོར་བུ་ཞེས་བྱ་བའི་གཟུངས།",
    "༨༧༩༣༥ འཕགས་པ་རྒྱལ་མཚན་གྱི་རྩེ་མོའི་དཔུང་རྒྱན་ཅེས་བྱ་བའི་གཟུངས།",
    "༨༡༡བསྡུར་འབྲས་རེའུ་མིག་༨༡༣༨ ༡༤༩༣༦ འཕགས་པ་གསེར་ཅན་ཞེས་བྱ་བའི་གཟུངས།",
    "༨༡༩བསྡུར་འབྲས་རེའུ་མིག་༨ ༢༡༨༢༢༩ ༣༧ འཕགས་པ་ཐམས་ཅད་ལ་མི་འཇིགས་པ་རབ་ཏུ་སྦྱིན་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༨༣༡བསྡུར་འབྲས་རེའུ་མིག་༨ ༣ ༢༩༣༩ འཕགས་པ་འགྲོ་ལྡིང་བའི་རིག་སྔགས་ཀྱི་རྒྱལ་པོ།",
    "༨ ༣༨བསྡུར་འབྲས་རེའུ་མིག་༨ ༣༩༩༤ འཕགས་པ་གཞན་གྱིས་མི་ཐུབ་པ་མི་འཇིགས་པ་སྦྱིན་པ་ཞེས་བྱ་བ།",
    "༨ ༥བསྡུར་འབྲས་རེའུ་མིག་༨༥༡༩༤༢ སྟོང་འགྱུར་ཞེས་བྱ་བའི་གཟུངས།",
    "༨༥ ༧བསྡུར་འབྲས་རེའུ་མིག་༨༥༧༩༤༤ འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་བརྒྱ་པའི་གཟུངས།",
    "༨༥༩བསྡུར་འབྲས་རེའུ་མིག་༨༥༩༩༤༥ འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་ཉི་ཤུ་ལྔ་པའི་གཟུངས།",
    "༨༦༡བསྡུར་འབྲས་རེའུ་མིག་༨༦༡༩༤༦ འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བརྒྱད་སྟོང་པའི་གཟུངས།",
    "༨༦༥བསྡུར་འབྲས་རེའུ་མིག་༨༦༥༩༤༨ ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གཟུང་བར་འགྱུར་བའི་གཟུངས།",
    "༨༦༧བསྡུར་འབྲས་རེའུ་མིག་༨༦༨༩༤༩ ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་ཐོབ་པར་འགྱུར་བའི་གཟུངས།",
    "༨ ༧༢བསྡུར་འབྲས་རེའུ་མིག་༨༧༢༩༥༡ ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་བརྒྱ་པ་གཟུང་བར་འགྱུར་བའི་གཟུངས།",
    "༨ ༧༤བསྡུར་འབྲས་རེའུ་མིག་༨ ༧༤༩༥༢ འཕགས་པ་ཕལ་པོ་ཆེ་གཟུང་བར་འགྱུར་བའི་གཟུངས།",
    "༨༨༢བསྡུར་འབྲས་རེའུ་མིག་༨༨༢༩༥༦ འཕགས་མ་སོ་སོར་འབྲང་མ་ཆེན་མོ་གཟུང་བར་འགྱུར་བའི་གཟུངས་༨༨༢བསྡུར་མཆན།",
    "༨༨༦བསྡུར་འབྲས་རེའུ་མིག་༨༨ ༧བ་དཀར་ཆག་གི་ཟུར་མཆན།",
    "བཙུན་མོ་སྲས་བཅས་སོ་སོའི་འཁོར་ཀུན་དང་།",
    "བེའུ་འདྲ་དཔལ་གྱི་ལྷ་མོ་འོད་ཟེར་ཅན།",
    "སྲས་འཕན་དུང་ཅན་རི་མཁར་ནག་མོ་དང་།",
    "མ་བདུན་སྲིང་མོ་བདུན་དང་སྲིང་མོ་བཞི།",
    "ནག་མོ་ཆེན་མོ་རལ་པ་གཅིག་ལ་སོགས།",
    "ལྷ་མོ་ཆེན་མོ་གནོད་སྦྱིན་ཆེན་མོ་དང་།",
    "སྲིན་མོ་ཆེན་མོ་ཤ་ཟ་ཆེན་མོ་དང་།",
    "གང་གི་མིང་ལའང་བཀྲ་ཤིས་དཔལ་འབར་བ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁྱོད་ཚུར་ཤོག།",
    "ཞིང་གི་མཚན་ཉིད་ནམ་མཁའ་ལྟ་བུར་ཡང་ཤེས་པར་གྱིས་ཤིག།",
    "བདག་ཅག་ཉོན་མོངས་མཚོན་གྱིས་རྨས་པ་རྣམས།",
    "གང་གིས་གང་ལ་སྤྱི་བོས་མཐུ་སྐྱེད་ཅིང་།",
    "ཟབ་མོ་རྒྱལ་བའི་བཀའ་ལ་ཀུན་གསོན་ཅིག།",
    "༩བསྡུར་འབྲས་རེའུ་མིགགཟུངས་འདུས།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་སྐོང་བ།",
    "ལུས་དང་ངག་དང་ཡིད་ཀྱི་ལས་ཀྱི་མཐའ་དོན་ཡོད་པ་ལ་མོས་པ།",
    "འདིས་ཁྱོད་ལ་སྟོན་པར་འགྱུར་རོ།",
    "དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་བཅོམ་ལྡན་འདས་ལ་མངོན་དུ་ཕྱོགས་ཏེ་འདུག་ནས་སོར་མོ་བཅུའི་ཐལ་མོ་སྦྱར་ཏེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཐམས་ཅད་མཁྱེན་ཅིང་ཐམས་ཅད་གཟིགས་པ་བཅོམ་ལྡན་འདས་ཉིད་ཀྱིས་ཅིའི་སླད་དུ་མི་བཤད།",
    "འདིས་ཁྱོད་ལ་སྟོན་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་བཞིན་གཤེགས་པས་བདག་ལ་དགོངས་ན་བདག་གིས་སྐྱེས་བུ་དམ་པ་འདི་ལ་དྲི་བར་བགྱིའོ།",
    "འཇམ་དཔལ་ཁྱོད་ཀྱིས་ཏིང་ངེ་འཛིན་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་སྙེད་ཐོབ་པ་ཡིན་ན་དེ་བཞིན་གཤེགས་པ་ལ་གསོལ་བ་གདབ་ཅི་དགོས།",
    "ཁྱོད་ཀྱིས་ཚིག་འདི་ལེགས་པར་སྨྲས་ཏེ།",
    "ཡང་རིགས་ཀྱི་བུ་ཁྱོད་ནི་སྟོང་པ་ཉིད་ལ་གནས་པའི་ཏིང་ངེ་འཛིན་བསམ་གྱིས་མི་ཁྱབ་པ་དང་ལྡན་པའོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁྱོད་ཀྱིས་བདག་ལ་སྐབས་ཕྱེ་ན་ཁྱོད་ལ་བདག་ཡི་གེ་འབྲུ་གཉིས་ཤིག་འདྲིའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་དག་པའི་སྒོ་འདི་ནི་མོས་པར་བགྱི་དཀའ་བ་ལགས་སོ།",
    "འོ་ན་ཅི་ཁྱོད་སོ་སོའི་སྐྱེ་བོའམ།",
    "འོ་ན་ཅི་ཁྱོད་སློབ་པའམ།",
    "འོ་ན་ཁྱོད་ཅི་ཤེས་རབ་དང་ལྡན་པའི་མཆོག་ཡིན་ནམ།",
    "ཤེས་རབ་དང་ལྡན་པའི་མཆོག་ཀྱང་མ་ཡིན་ན་དེ་ཉིད་ཁྱོད་དམིགས་པ་ཅན་དུ་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁོ་བོ་ནི་སྐྱེས་བུ་དམ་པ་རྒྱ་མཚོ་ལྟར་གཏིང་དཔག་དཀའ་བ་ཁྱོད་དང་འགྱེད་པར་མི་བྱེད་དོ།",
    "བཙུན་པ་ཤ་ར་དྭ་ཏིའི་བུ་ཁྱོད་ནི་རྒན་རབས་ཐུ་བོ་མཆོག་ཡིན་གྱིས་བཙུན་པ་ཤ་ར་དྭ་ཏིའི་བུ་དེ་སྐད་མ་ཟེར་ཅིག།",
    "རིགས་ཀྱི་བུ་དོན་དེ་ཉིད་ཤེས་པར་བྱ་བའི་ཕྱིར་ཁྱོད་ལ་དཔེ་བྱའོ།",
    "རིགས་ཀྱི་བུ་དོན་དེ་ཉིད་ཤེས་པར་བྱ་བའི་ཕྱིར་ཡང་ཁྱོད་ལ་དཔེ་བྱའོ།",
    "རིགས་ཀྱི་བུ་དེ་བཞིན་དུ་ཁྱོད་ནི་སྟོབས་དང་ལྡན་པ།",
    "དཔེར་ན་མི་དམུས་ལོང་གིས་ཤུལ་དུ་མཆི་བའམ།",
    "དེ་བཞིན་དུ་གླང་པོ་ཆེ་ཆེན་པོ་ལྟ་བུ་འདི་དག་གི་མདུན་ན་བདག་ནི་དམུས་ལོང་དང་མཚུངས་པར་མཐོང་སྟེ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་དེ་བཞིན་དུ་ཁྱོད་ནི་ཏིང་ངེ་འཛིན་མཐའ་ཡས་ཤིང་བསམ་གྱིས་མི་ཁྱབ་པ་ཐོབ་པ་ཡིན་ནོ།",
    "མོས་པ་དང་རྣམ་པར་གྲོལ་བ་དུ་མ་ཤེས་པ་དང་།",
    "སྙོམས་པར་འཇུག་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ལྷའི་མིག་གི་ཤེས་པ་དང་།",
    "ངག་གི་ལས་འབྲས་བུ་ཡོད་པ་དང་ལྡན་པ་ཡིན།",
    "གང་ཟག་གཞན་རྣམས་ཀྱི་བསམ་པ་ཤེས་པར་བྱེད་ཅིང་མོས་པ་ལ་རྟོག་པ་ཡིན།",
