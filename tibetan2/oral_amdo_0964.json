    "མིག་གི་ཆགས་པ་དང་ལྟ་བ་དང་དགའ་བ་དང་སྲེད་པ་དང་།",
    "རེག་པ་དང་།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་གང་གི་ཕྱིར།",
    "གང་གི་ཕྱིར་དེ་མངོན་སུམ་དུ་བྱས་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་ནི་འདོད་ཆགས་ཆེན་པོ་ལ་སོགས་པ་ཉོན་མོངས་པ་རྣམས་སོ།",
    "དེ་ལྟར་རེ་ཞིག་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་རབ་ཏུ་དགའ་བ་རྣམ་པར་དག་པ་ལ་སོགས་པ་སྟོན་པས་དཀྱིལ་འཁོར་སྦྲུལ་པར་བྱ་བའི་ཕྱིར་བསྐུལ་བ་དང་།",
    "དེ་ཉིད་ནི་དཀྱིལ་འཁོར་ཐམས་ཅད་བ་སྟེ་གང་གི་ཕྱིར་དཀྱིལ་འཁོར་ཐམས་ཅད་ནི་རྡོ་རྗེ་སེམས་དཔའ་ཡོངས་སུ་གྱུར་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་དག་གི་སེམས་དཔའི་མཆོག་ནི་རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་རང་གི་བདག་ཉིད་ཀྱི་དེ་ཁོ་ན་ཉིད་ནི་རང་གི་དེ་ཁོ་ན་ཉིད་དེ་རབ་ཏུ་དགའ་བ་རྣམ་པར་དག་པའི་ཚུལ་ལོ།",
    "འདིས་ནི་སྔགས་པ་རྣམས་ཀྱི་དམ་ཚིག་པའི་སྦྱོར་བ་དང་དཀྱིལ་འཁོར་གྱི་མཆོག་གི་ཏིང་ངེ་འཛིན་སྟོན་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་གསང་བའི་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་བཞུགས་སོ་ཞེས་བྱ་བའི་བར་འདིས་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་སྟོན་ཏོ།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱི་རང་གི་ལས་རྣམས་ལ།",
    "རྣལ་འབྱོར་གྱི་གསང་བ་ལས་དང་པོའི་སྦྱོར་བ་དང་དཀྱིལ་འཁོར་གྱི་མཆོག་དང་ལས་ཀྱི་མཆོག་གི་ཏིང་ངེ་འཛིན་རྣམས་ལ་སྙོམས་པར་འཇུག་པར་བྱའོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཁྱམས་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ་ཞེས་བྱ་བ་ནི་གཞལ་ཡས་ཁང་གི་ཕྱི་རོལ་ཀུན་ནས་བསྐོར་ཕྱོགས་སུ་ཁྱམས་ཀྱིས་བསྐོར་བ་ལ་ནི་ཁྱམས་རྣམས་ཞེས་བྱའོ།",
    "སྣ་ཚོགས་པའི་བ་དན་གྱི་རྩེ་མོར་དྲིལ་བུའི་མཆོག་བཏགས་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཕྱག་གཡོན་ན་གཞུ་བསྣམས་པ་ཕྱག་གཡས་ཀྱི་མཐེ་བོ་དང་མཛུབ་མོ་གཉིས་ཀྱིས་རྡོ་རྗེ་མདའ་འདྲེན་པ་ལ་བརྩོན་པར་མཛད་པའོ།",
    "རྡོ་རྗེ་ཐོགས་པའི་ལག་པས་གར་བྱེད་པའི་སྒེག་མོ་ལ་སོགས་པ་བྲི་བར་བྱའོ།",
    "ནང་གི་སྒོ་རྣམས་ལ་ཡང་དེ་བཞིན་དུ་བལྟ་བར་བྱའོ།",
    "གང་གི་ཕྱིར་མཆོག་གི་སྒྲས་ནི་ཁྱབ་འཇུག་དང་།",
    "བྱང་གི་ཕྱོགས་སུ་ནི་ཕག་དང་གཤིན་རྗེ་དང་ཚོགས་ཀྱི་བདག་པོ་ཆུང་མ་དང་བཅས་པའོ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་ལེགས་པར་བྲིས་ནས་ཐ་མ་རྣམས་སྤོས་ཆུས་བྱུགས་ལ་མེ་ཏོག་གི་སིལ་མ་བཀྲམ་སྟེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཛུབ་མོ་ལྕགས་ཀྱུ་གཉིས་སུ་བྱས་ལ།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་ལེགས་གནས།",
    "ཡི་གེ་ཧཱུཾ་ཉིད་དང་རྡོ་རྗེའི་མེ་ཏོག་གི་ཐལ་མོ་ཁ་ཕྱེ་བའི་མཆོད་ཡོན་གྱི་ཕྱག་རྒྱ་བཅོམ་ལྡན་འདས་འཁོར་དང་བཅས་པའི་ཐུགས་ཀའི་ཟླ་བའི་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཧཱུཾ་གི་མཐར་བཅོམ་ལྡན་འདས་འཁོར་དང་བཅས་པ་ལེགས་པར་བཞག་ལ་དེ་ཉིད་བརྗོད་ཅིང་རྡོ་རྗེའི་ལྟ་བས་བལྟས་ལ།",
    "ཡི་གེ་ཧཱུཾ་གིས་ལྗགས་ལ་རྡོ་རྗེ་བཟང་པོ་བསྐྱེད་དེ།",
    "རྡོ་རྗེ་སེམས་ཁྱོད་རབ་ཏུ་བདེ་བའི་མཆོག།",
    "རྡོ་རྗེ་ཐལ་མོ་གཉིས་བསྐོར་ལ།",
    "སྤྱི་བོར་བཞག་པ་ནི་བཞད་པ་མོའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་གཡོན་པའི་མཛུབ་མོ་བཀུག་པ་ཡུ་བར་བྱས་ལ་གཡས་པའི་མཛུབ་མོ་བཀུག་པས་པི་ཝང་བརྡུང་བའི་ཚུལ་དུ་བྱེད་པ་ནི་རྡོ་རྗེ་གླུ་མཁན་མའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་གར་བྱས་ནས་སྤྱི་བོར་རྡོ་རྗེ་ཐལ་མོ་བཅིང་བ་ནི་རྡོ་རྗེ་གར་མཁན་མའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པའི་མཛུབ་མོ་གཡོན་པ་ཡུ་བར་བྱས་པ་ལ་མཛུབ་མོ་གཡས་པ་བཀུག་ནས་བརྡུང་བ་ནི་སྒྲའིའོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་འགྱུར་བ་དེས་ན་དེ་བཞིན་གཤེགས་པ་དང་།",
    "སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་འདུག་ལ།",
    "རབ་ཏུ་དགའ་བའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་ལྔ་པོའི་བསྡུས་པའི་ཕྱག་རྒྱའོ།",
    "མོས་པ་དེ་རྣམས་ཀྱིས་ཀྱང་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་དང་།",
    "རྡོ་རྗེ་བྲི་བའི་ཕྱག་རྒྱ་ནི་འཕགས་པ་རྡོ་རྗེ་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "གཞན་དག་གི་ནི་མཚན་མ་ཐོབ་པར་གྱུར་པས་ན།",
    "དེ་ཡང་འདི་ནི་རང་གི་སེམས་བརྟན་པར་བྱ་བ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཉིད་ནི་ཡིན་པར་བཤད།",
    "གནོད་སྦྱིན་མོ་ལ་སོགས་པ་ཡང་ཆུང་མ་ལ་སོགས་པའི་གཟུགས་ཀྱིས་བདག་ཉིད་སྟོབས་པར་བྱེད་དོ།",
    "བདག་བསྲུང་བ་ལ་ནི་ཡུངས་ཀར་ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པའི་གཟུགས་སུ་བསྐྱེད་ལ་རང་གི་སྤྱི་བོར་བཞག་ལ།",
    "དེ་བཞིན་དུ་རེངས་པར་བྱ་བ་ལ་ནི་སེང་གེ་ལ་སོགས་པའི་མདུན་དུ་རྡོ་རྗེ་སེམས་དབའ་བསམ་པར་བྱའོ།",
    "རི་མོ་ཚོར་བ་དང་།",
    "རེག་པ་མྱོང་བར་མི་འགྱུར་བ་དང་།",
    "དེ་གང་གིས་འགྱུར་ཞེ་ན།",
    "གང་གི་ཕྱིར་དེ་ནི་རྡོ་རྗེ་མེ་ལྟར་རབ་ཏུ་འབར་བའི་དཀྱིལ་འཁོར་རྒྱས་འདེབས་པའི་ལས་ཅན་ཡིན་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་རང་གི་ལག་གིས་བཏོན་ཏེ།",
    "རྡོ་རྗེ་ཧཱུཾ་ལས་བྱུང་བའི་ལག་པ་གཡས་པའི་མཛུབ་མོའི་རྩེ་མོ་དེ་དང་།",
    "གཡོན་པའི་ཧཱུཾ་གི་གཞུ་རྒྱུད་འདྲེན་པའི་ཚུལ་ནི་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་ཕྱག་རྒྱ་སྟེ།",
    "སྣང་བར་བྱ་བ་ལ་ནི་རྡོ་རྗེ་ཐོགས་ལ་རྩེ་མོ་འབར་བ་འཕྲོ་བའི་ཚུལ་གྱིས་བསྐོར་བ་བྱ་བ་ཡིན་ནོ།",
    "ལུས་བདེ་བར་བྱ་བ་ལ་ནི་རྡོ་རྗེ་བསྡམས་པས་རང་གི་མཚན་མ་བཟུང་ནས་བཟླས་བརྗོད་བྱ་སྟེ།",
    "རྡོ་རྗེ་མཆོག་གི་གཟུགས་ཀྱི་ཕྱག་རྒྱ་ནི་གར་ལས་བྱུང་བའི་རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ་གུང་མོ་གཉིས་མཛུབ་མོ་འཁྱུད་དེ།",
    "མཐེ་བོང་གཉིས་ཀྱི་མཛུབ་མོའི་རྩེ་མོ་སྦྱོར།",
    "འདི་བཅིངས་ལ་རྡོ་རྗེ་ཡིད་ལས་བྱུང་བར་ལྷག་པར་མོས་པས་ཐམས་ཅད་དུ་གཟུགས་སུ་སྣང་བར་བྱའོ།",
    "སྒྲ་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་གར་ལས་བྱུང་བའི་རྡོ་རྗེ་བསྡམས་པ་ལས་གཡོན་པའི་མཛུབ་མོའི་རྩེ་མོ་བཀུག་པ་ནི་ཡུ་བ་ཡིན་ལ་གཡས་པའི་མཛུབ་མོས་དེ་ལ་བརྡུང་པ་སྟེ།",
    "གར་ལས་བྱུང་བའི་རྡོ་རྗེའི་ལག་མཐིལ་མཉེད་ཅིང་དབུགས་འབྱིན་པ་དང་བཅས་པའི་ཧཱུཾ་གི་གླུས་དྲི་ཞིམ་པོ་ཚོར་བར་བྱའོ།",
    "ཡི་གེ་ཧཱུཾ་གིས་གླུ་ལེན་པར་བྱེད་པ་ནི་དབབ་པའོ།",
    "ཐམས་ཅད་གླུ་ལེན་དུ་གཞུག་པ་ལ་ནི་དེ་བཞིན་དུ་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཡི་གེ་ཧཱུཾ་ལས་རང་གི་ལྕེ་ལས་རྡོ་རྗེ་བསྐྱེད་དེ་གླུ་ལེན་དུ་གཞུག་པའི་བསམས་པས་ལྕེ་བསྐྱོད་ཅིང་ཧཱུཾ་གི་བཟླས་བརྗོད་བྱའོ།",
    "བབས་ནས་ལན་སྟོན་པ་ལ་ནི་རྡོ་རྗེ་དབབ་པ་ལས་རྡོ་རྗེ་བཅིངས་པའི་རང་གི་སྲིན་ལག་དང་མཐེའུ་ཆུང་གི་བར་དུ་མཐེ་བོང་བཅུག་ལ་བསྐྱོད་པ་འདི་དང་།",
    "ཡི་གེ་ཧཱུཾ་གི་བཟླས་པས་ཐམས་ཅད་བབས་ནས་ལན་སྟོན་པ་ལ་ནི་སྦྱོར་རོ།",
    "མཛུབ་མོ་གཉིས་རྡོ་རྗེར་བྱ།",
    "དེའི་མདུན་དུ་རང་གིས་རྡོ་རྗེ་གསོར་ཞིང་ཧཱུཾ་ཞེས་བྱ་བ་བཟླས་ལ།",
    "ཆེ་གེ་མོ་གདོན་གྱིས་འཛིན་དུ་ཆུག་ཤིག་ཅེས་བསྐུལ་བར་བྱའོ།",
    "སྦྱར་བ་ལ་ནི་ཁྲོས་པས་མིག་མི་འཛུམས་པར་ལྟ་བས་བལྟ་བར་བྱ་བ་ནི་རྡོ་རྗེ་ལྟ་བའི་དུག་གི་ཕྱག་རྒྱའོ།",
    "དུག་ཐམས་ཅད་བཟའ་བ་ལ་ནི་དང་པོའི་རྡོ་རྗེའི་མཛུབ་མོ་གཉིས་སྦྱར་ལ་རྐང་པའི་སོར་མོ་སྒྱུར་བར་བྱེད་ཅིང་།",
    "དུག་གི་སྟེང་དུ་བཞག་ལ།",
    "ཡི་གེ་ཧཱུཾ་གིས་བདུད་རྩིས་དུག་བདུད་རྩིར་གྱུར་པར་བསམ་པ་ནི།",
    "མཁའ་འགྲོ་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱས་གཡོན་པའི་མཛུབ་མོ་ཐད་ཀར་ཕྲེད་དུ་བཞག་སྟེ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་ཕཊ་ཀྱི་ཁྲོ་བོ་སྟོང་གི་ཕྱག་རྒྱ་སྟེ།",
    "བདག་གི་རྩེ་མོ་ལྟ་བུར་བྱས་ལ་གྱེན་དུ་བསྒྲེང་བ་དེ་ནི་རྡོ་རྗེ་རྒྱལ་མཚན་གྱི་ཕྱག་རྒྱ་སྟེ།",
    "དང་པོའི་རྡོ་རྗེའི་ཕྱག་རྒྱ་བཅིངས་ལ་མཐེ་བོང་དང་མཐེའུ་ཆུང་གི་རྩེ་མོ་བཞི་ལས་མེ་སྟག་རྣམ་པར་འཕྲོ་བའི་ཚུལ་དུ་བྱ་བ་འདི་ནི་རྡོ་རྗེ་མེ་ཤེལ་ལོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་གཡས་པ་བསྒྲེང་ལ་གཡོན་པའི་མཛུབ་མོ་ལྕགས་ཀྱུར་བྱ་བ་ནི་པྲ་སེ་ན་ཐམས་ཅད་དབབ་པའོ།",
    "མཛུབ་མོ་གཉིས་ནི་སྡིགས་མཛུབ་བསྒྲེང་།",
    "རྫུ་འཕྲུལ་དང་ཆོ་འཕྲུལ་དག་གི་ཁྱད་པར་ནི་ནམ་མཁའ་ལ་འགྲོ་བ་ནི་རྫུ་འཕྲུལ་ལོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་གཉིས་ལྕགས་ཀྱུར་བྱས་ལ་གཅིག་ལ་གཅིག་མདུད་པ་བྱས་ལ་གཅུ་ཞིང་གཅུ་བར་བྱ་བ་འདི་ནི་ལྷ་ཐམས་ཅད་དབབ་པར་བྱེད་པའི་རྡོ་རྗེ་སྐོར་བར་བྱེད་པའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་བསྒྲེང་བས་བཟློག་པ་ནི་རྡོ་རྗེ་སྲིད་སྲུང་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་ཐལ་མོ་ལས་མཛུབ་མོ་གཉིས་གཤིབས་ལ་དཔྲལ་བར་བཞག་ནས།",
    "སོར་མོ་ལྷག་མ་རྣམས་འོད་ཟེར་འགྱེད་པའི་ཚུལ་དུ་བྱས་པ་འདི་ནི་རྡོ་རྗེ་ཁྲོ་གཉེར་ཅན་གྱི་ཕྱག་རྒྱ་སྟེ་གློག་འབབ་པ་ཐམས་ཅད་ཟློག་པར་བྱེད་པའོ།",
    "དང་པོའི་རྡོ་རྗེའི་ཕྱག་རྒྱ་ནི་བདེ་བ་ཆེན་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "གང་ལག་པ་གཡས་པའི་མཛུབ་མོ་ལྕགས་ཀྱུར་བྱ་བ་ནི་རྡོ་རྗེ་བསྙེམས་པའི་ལྕགས་ཀྱུའི་ཕྱག་རྒྱའོ།",
    "གཏན་ཚིགས་གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་གི་ཕྱིར་དེ་བཞིན་ཉིད་དང་སྟོང་པ་ཉིད་དང་།",
    "ཡང་ན་བདག་གི་རྣམ་པའི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ནི་དོན་ཡིན་ལ།",
    "གཏན་ཚིགས་གང་གི་ཕྱིར་ཞེ་ན།",
    "གཏན་ཚིགས་གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་བྱིན་གྱིས་རློབ་པ་ནི་བསྟན་པར་བྱས་པ་དེ་ལ་དམིགས་པའི་སེམས་རྩེ་གཅིག་པ་གང་གིས་ཁྱད་པར་དུ་བྱས་པ་གང་ཡིན་པ་དེ་ལ་ནི་མིང་འདི་ཉིད་ཅེས་བྱ་སྟེ།",
    "སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ལ་ལྷག་པར་མོས་པར་བྱས་པའི་བཟླས་པ་ནི་བརྟན་ཞིང་ངེས་པའི་བཟླས་པའོ།",
    "རྣམ་པར་རྒྱལ་བ་དེའི་བསྡུ་བ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྒྲུབ་པ་གང་གིས་མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ལ་མིང་འདི་ཉིད་ཅེས་བྱ་སྟེ།",
    "དེའི་སྤྲོས་པ་ནི་ཁ་དོག་དང་དབྱིབས་དང་རེག་པ་དང་ཉེ་བར་སྤྱོད་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "དེ་བས་ན་འདོད་ཆགས་ཀྱི་སྤྲོས་པ་མེད་པ་ཉིད་ཀྱི་ཞེ་སྡང་གི་སྤྲོས་པ་མེད་པ་ཉིད་དུ་འགྱུར་རོ།",
    "ཞེ་སྡང་གི་དངོས་པོ་ཉེ་བར་མི་དམིགས་པས་གཏི་མུག་གི་དངོས་པོ་དམིགས་པར་མི་འགྱུར་ཏེ།",
    "དེ་བས་ན་གཏི་མུག་གི་སྤྲོས་པ་མེད་པ་ཉིད་དུ་འགྱུར་རོ།",
    "མིག་གི་རྫི་མ་འདྲེན་པ་ནི།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་སོར་མོ་རྣམས་འབར་བ་ནང་དུ་བསྣོལ་ལ།",
    "མཐེ་བོའི་རྡོ་རྗེ་བསྒྲེང་པ་འདི་ནི་རྡོ་རྗེ་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ་འདིས་བཛྲ་བཛྲ་ཧཱུཾ་ཞེས་ཟློས་ཤིང་དཀྱིལ་འཁོར་དུ་འཇུག་པར་བྱའོ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་རྩེ་ལྔ་པ་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་ཁྲོས་པར་འགྱུར་བས།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱའི་ལག་པ་གཡས་པའི་མཛུབ་མོའི་ལྕགས་ཀྱུ་གཡོན་ལོགས་ནས་གཡོན་པའི་མཛུབ་མོ་དྲང་བར་བྱས་ཏེ།",
    "འདི་ནི་རྡོ་རྗེ་གླུའི་ཁྲོ་བོའི་ཕྱག་རྒྱ་ཕྲ་མོ་འབིགས་པར་བྱེད་པའོ།",
    "རང་གི་ས་བོན་ནི་སྒྲ་ཇི་བཞིན་པར་ཡང་འདོད་མོད་ཀྱི།",
    "གཡོན་པའི་མཛུབ་མོའི་ཕྲ་སྐམ་གྱིས་བཟུང་ལ་དྲང་བར་བྱ་བ་ནི་རྡོ་རྗེ་སྐྱེས་བུ་སྟེ།",
    "འཁོར་ལོའི་ཚུལ་དུ་བྱས་ལ་གཡས་པའི་ཁྲོ་བོའི་མཛུབ་མོ་ཡང་དང་ཡང་དུ་བརྡབ་པ་འདི་ནི་རྡོ་རྗེ་འཁོར་ལོ་དྲལ་བའོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་མཛུབ་མོ་གཉིས་ཀྱི་ལྕགས་ཀྱུ་ནི་རྡོ་རྗེ་ཁྲོ་བོའི་ཚོགས་ཀྱི་སྲིན་མོའོ།",
    "མཛུབ་མོ་གཉིས་ཀྱི་ལྕགས་ཀྱུས་མཆེ་བ་ལྟར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་ཁྲོ་བོ་མ་རུངས་པའི་སྲིན་མོའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་མཛུབ་མོ་གཉིས་རྩེ་མོར་སྦྱར་བ་ནི་རྡོ་རྗེ་སེམས་དཔའི་ཁྲོ་བའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་སོར་མོ་ཐམས་ཅད་འབར་བའི་དབུས་སུ་མཐེ་བོང་བཞག་པའི་རྡོ་རྗེ་འདི་ནི་བདེ་བ་ཆེན་པོའི་རྡོ་རྗེའི་དམ་ཚིག་གི་ཁྲོ་བོའོ།",
    "ད་ནི་གཏི་མུག་གི་གཉེན་པོར་གྱུར་པ་པདྨའི་རིགས་སྟོན་པར་བཞེད་པས།",
    "ཡང་ན་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའམ།",
    "དེ་རྣམས་ལ་གཟིགས་པ་ནི་དཀྱིལ་འཁོར་གྱི་དེ་ཁོ་ན་ཉིད་ལ་སོགས་པ་ཡོངས་སུ་ཤེས་པའོ།",
    "འདི་ཡང་རྡོ་རྗེ་ཐལ་མོ་ཁོང་སྟོང་དང་བཅས་པ་ལས་གུང་མོ་དང་མཐེ་བོང་ཁ་ཕྱེ་ལ་འདབ་མ་བཞི་པ་བྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ་མཛུབ་མོ་གཉིས་བརྐྱང་ནས་བསྙམས་ཏེ་བཀུག་ནས་མིག་ལྟ་བུར་བྱས་ནས་ཁྲོ་གཉེར་དུ་གཞག་ལ་འདི་ཐམས་ཅད་གསད་པར་བྱའོ།",
    "གདེང་བའི་ཚུལ་གྱིས་ལག་པ་གཡོན་པ་བསྐུམས་ལ་ལག་པ་གཡས་པ་རང་གི་མགོ་བོའི་སྟེང་དུ་བཞག་པ་ནི་པདྨ་ཆེན་པོའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ལྟ་བས་བལྟ་བར་བྱེད་པ་འདི་ནི་པདྨ་ཆེན་པོ་རྣམ་པར་གཟིགས་པའི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་ཐམས་ཅད་རབ་ཟླུམ་པའི།",
    "ཉོན་མོངས་པ་ཅན་དང་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཀུན་དུ་རྨོངས་པ་དང་བྲལ་བས་ཁམས་གསུམ་གྱི་བདག་པོར་གྱུར་པ་ནི།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་ནི་ཟས་དང་སྐོམ་དང་མལ་ཆ་དང་སྟན་ལ་སོགས་པའི་རྣམ་པའོ།",
    "དེ་ལ་ཕྱག་རྒྱ་ནི་འདི་ཡིན་ཏེ་རྡོ་རྗེ་ཐལ་མོ་ལས་མཐེ་བོང་དང་མཛུབ་མོའི་སོར་མོ་བཞི་ཁ་ཐུར་དུ་བརྐྱང་ལ།",
    "རྡོ་རྗེ་རིན་ཆེན་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ལས་གུང་མོ་དང་སྲིན་ལག་དང་མཐེའུ་ཆུང་གི་སོར་མོ་བརྐྱང་ལ་སྲིན་ལག་དང་།",
    "དེ་ཐོབ་པར་སྟོན་པར་བྱེད་པའི་དམ་ཚིག་གི་ཁུ་ཚུར་དེ་འཛིན་པར་མཛད་པས་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཁུ་ཚུར་འཛིན་པའོ།",
    "གནས་སྐབས་དེ་ཉིད་དུ་གསུང་གི་ཕྱག་རྒྱ་ཡོངས་སུ་འཛིན་པ་ནི་ལྕེ་ལ་རྡོ་རྗེ་དཀར་པོ་རྩེ་ལྔ་པ་བསམས་ལ་སྔགས་ཐམས་ཅད་བརྗོད་པའོ།",
    "དམ་ཚིག་གི་རྡོ་རྗེའི་ཁུ་ཚུར་བཅིངས་ལ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་དམ་ཚིག་གི་ནི་རྒྱུ་ཡིན་པས་རྡོ་རྗེ་སྲ་བའི་ཕྱག་རྒྱ་ཐམས་ཅད་དེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའ་དེའི་དངོས་གྲུབ་མཆོག་གི་རྒྱུར་རྒྱས་བཏབ་པའོ།",
    "ཏིང་ངེ་འཛིན་རྡོ་རྗེ་ཡང་ཏིང་ངེ་འཛིན་མཆོག་གི་ཕྱག་རྒྱས་རྡོ་རྗེ་རྩེ་ལྔ་པ་བསྣམས་པའོ།",
    "སྣ་ཚོགས་རྡོ་རྗེ་འཛིན་པའི་དམ་ཚིག་གི་རྡོ་རྗེའི་ཁུ་ཚུར་དང་།",
    "དམ་ཚིག་གི་པདྨའི་ཁུ་ཚུར་དང་།",
    "དམ་ཚིག་གི་ལས་ཀྱི་ཁུ་ཚུར་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་ཕྱིའི་མཚམས་རྣམས་སུ་ནི་སྒེག་མོ་ལ་སོགས་པའོ།",
    "རྡོ་རྗེ་ལས་ཀྱི་མཚན་མ་འཛིན་པའི་ལྷ་མོ་དེའི་དབྱིབས་དང་མཐུན་པ་ཉིད་དུ་བྲི་བར་བྱའོ།",
    "དེའི་འོག་ཏུ་སྤྱན་དྲངས་པ་ལ་སོགས་པ་ཐམས་ཅད་བྱས་ལ་དམ་ཚིག་གི་ཁུ་ཚུར་བཅིངས་ཏེ།",
    "རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ་རང་གི་སྲིན་ལག་དང་།",
    "མཐེའུ་ཆུང་གི་བར་དུ་མཐེ་བོ་བཅུག་ལ་མཛུབ་མོ་བཀུག་ལ་བཙིར་བ་འདི་ནི་དམ་ཚིག་གི་ཁུ་ཚུར་གྱི་མཚན་ཉིད་དོ།",
    "རྡོ་རྗེ་ཆེན་པོའི་ཁུ་ཚུར་ནི་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་ལྕགས་སྒྲོག་ཏུ་བཅིང་བ་བྱས་ལ།",
    "རྡོ་རྗེ་བཞེད་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་བཞེད་པའི་ཁུ་ཚུར་ཏེ།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་མཛུབ་མོ་དང་མཐེ་བོང་ལྕགས་སྒྲོག་ཏུ་བྱ་བའོ།",
    "རང་གི་སྲིན་ལག་དང་མཐེའུ་ཆུང་གི་བར་དུ་མཐེ་བོ་བཞག་པ་འདི་ནི་རྡོ་རྗེ་འབེབས་པའི་ཁུ་ཚུར་རོ།",
    "རྡོ་རྗེ་འབར་བ་དེས་ཕྱོགས་བཅུའི་བསྒྲུབ་པར་བྱ་བ་ཐམས་ཅད་རེངས་པར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་དམིགས་པའི་ཁུ་ཚུར་རོ།",
    "རྡོ་རྗེ་རྔ་བོ་ཆེའི་ཁུ་ཚུར་གྱིས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་ལ་བརྟེན་པ་ལ་བལྟས་པ་དང་།",
    "དམ་ཚིག་གི་རྡོ་རྗེའི་ཁུ་ཚུར་གྱི་ལག་མཐིལ་གཉིས་ཀྱིས་མཐེ་བོང་བཟུང་ལ་ཕྱག་རྒྱ་ཐམས་ཅད་དགྲོལ་བར་བྱ་སྟེ།",
    "འདི་ནི་རྡོ་རྗེ་ཐལ་བའི་ཁུ་ཚུར་རོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཁར་བཞག་པ་འདི་ནི་རྡོ་རྗེ་རྗེ་མ་མོའི་ཁུ་ཚུར་ཏེ།",
    "དམ་ཚིག་གི་རྡོ་རྗེའི་ཁུ་ཚུར་གྱིས་བསྒྲུབ་པར་བྱ་བ་ཕྱེ་མར་བརླག་པའི་བསམ་པས་ས་ལ་བཙིར་བ་འདི་ནི་རྡོ་རྗེ་བཟང་པོའི་ཁུ་ཚུར་རོ།",
    "དང་པོའི་རྡོ་རྗེའི་ཕྱག་རྒྱའི་མཛུབ་མོས་གུང་མོ་མནན་ལ་མཐེ་བོང་དང་སྦྱར་ཏེ།",
    "མིག་གི་འབྲས་བུ་ལྟ་བུར་བྱས་ནས་སྲིན་ལག་དང་།",
    "རང་གི་ཕྱག་རྒྱ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་ཚོགས་རྣམས་ཀྱིས་ཚོགས་པར་བྱས་ལ་ཆུའི་ནང་དུ་གནས་ཏེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ལ་གཡོན་པའི་མཛུབ་མོ་དང་མཐེ་བོའི་བུ་གར་གཡས་པའི་མཛུབ་མོ་བཅུག་པ་འདི་ནི་སྣ་ཚོགས་རྡོ་རྗེ་ཁུ་ཚུར་ཏེ།",
    "འདི་ཉིད་མོས་པའི་ཁྱད་པར་གྱིས་མི་སྣང་བར་འགྱུར་ཏེ།",
    "དེ་ལྟར་མོས་པ་ལས་སྣང་བ་ཡིན་ནོ།",
    "པདྨའི་དམ་ཚིག་གི་ཁུ་ཚུར་གྱིས་རྡོ་རྗེའི་པདྨ་ཡོངས་སུ་འཛིན་པ་ནི་རྡོ་རྗེ་ཡེ་ཤེས་ཀྱི་ཁུ་ཚུར་རོ།",
