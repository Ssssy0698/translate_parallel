    "ཞི་བ་ལ་སོགས་པའི་སྦྱིན་སྲེག་གི་ཚེ།",
    "དེ་ཡང་སྦྱིན་སྲེག་ལེན་པ་དེ་ཉིད་དེ་ལྷ་རྣམ་པ་གསུམ་མོ།",
    "སྦྱིན་སྲེག་གི་དགང་གཟར་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱང་རྒྱུད་འདི་ལས་མ་གསུངས་པས།",
    "དེ་ལ་ཞི་བ་ལ་སོགས་པའི་སྦྱིན་སྲེག་གི་དགང་གཟར་གྱི་མཚན་ཉིད་འདི་ནི་སྤྱིའི་རྣལ་འབྱོར་གྱི་རྒྱུད་ལས་གསུངས་པ་སྟེ།",
    "ཁྱད་པར་དུ་ནི་ཞི་བའི་སྦྱིན་སྲེག་གི་དགང་གཟར་ནི་ཟླུམ་པོ་སྟེ།",
    "སྦྱིན་སྲེག་གི་ཆོ་ག་ཐམས་ཅད་ལ་ཇི་ལྟར་རིགས་པར་བློས་རྣམ་པར་ཕྱེ་ལ་ལས་ཀྱི་རྗེས་སུ་མཐུན་པར་སྦྱར་བར་བྱའོ།",
    "ཞི་བ་ལ་སོགས་པའི་སྦྱིན་སྲེག་གི་ཐབ་ཀྱི་མཚན་ཉིད་ནི།",
    "དེ་རྒྱུད་ཀྱི་དོན་ལ་འཇུག་པ་༡༡༨༣བཞིན་དུ་རབ་ཏུ་རིངས་པའི་ཞི་བ་ལ་སོགས་པའི་སྦྱིན་སྲེག་གི་ལས་རྣམས་གནས་ལ་སོགས་པའི་གང་ཡང་རུང་བར་ཇི་ལྟར་འདོད་པའི་སྦྱིན་སྲེག་གི་ལས་ལ་རྟག་ཏུ་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་དུ་རྩོལ་བ་དང་ལྡན་པར་ལས་སྒྲུབ་པ་པོས་བྱའོ།",
    "དེ་ལ་རེ་ཞིག་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོར་གསུངས་པ།",
    "དེ་ལ་རེ་ཞིག་སྔར་སྨོས་པའི་རིམ་གྱིས་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་དང་།",
    "དེ་ལས་འདི་ནི་རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ལས་གསུངས་པའི་གསང་བའི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་སྟེ།",
    "སེང་གེ་དང་ལྔའོ་། ནང་གི་དཀྱིལ་འཁོར་གྱི་ཤར་དུ།",
    "དེ་ལྟར་སྦྱིན་སྲེག་གི་ཐབ་བྱས་ནས།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པརང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་བདག་དང་མི་གཉིས་པར་གྱུར་པ་མངོན་དུ་བྱ་སྟེ།",
    "སྦྱིན་སྲེག་གི་ཡོ་བྱད་དང་བཅས་པར་བསང་གཏོར་བྱའོ།",
    "མདུན་ན་བཞུགས་པའི་རི་མོའི་སྐུ་གཟུགས་ལ་སོགས་པ་ལ་མངོན་དུ་ཕྱོགས་ཏེ་འདུག་ནས་ཐབ་ཏུ་ཤིང་ལྗོན་པ་དང་༤ མངར་པོ་ལས་བྱུང་བའི་བུད་ཤིང་རབ་ཏུ་སྐམ་པོ་གཞུག་གོ།",
    "བདག་དང་མི་གཉིས་པའི་རྣལ་འབྱོར་པ་ཞི་བའི་ལས་དང་རྗེས་སུ་མཐུན་པའི་རྩྭ་ཀུ་ཤའི་ཁྲེས་ལ་སོགས་པ་ལ་སྐྱིལ་མོ་ཀྲུང་དུ་འདུག་གམ།",
    "རང་གི་ལྷའི་རྣལ་འབྱོར་ལ་གནས་ཀྱང་རྣལ་འབྱོར་པ་ཁྲོས་པར་༥བྱས་ཏེ།",
    "རྡོ་རྗེ་མེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ནས།",
    "རྡོ་རྗེ་མེའི་དམ་ཚིག་གི་གསང་སྔགས་ཧཱུཾ་གི་བར་དུ་བཅུག་པས།",
    "དེ་ལ་འདི་ནི་རྡོ་རྗེ་མེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་ལ་འདི་ནི་རྡོ་རྗེའི་མེའི་དམ་ཚིག་གི་གསང་སྔགས་སོ།",
    "མྲྀ་ཏའི་མེ་ཡང་མིད་པ་རིང་ལ་གཟི་མདངས་ཆེན་པོ་བགྲང་ཕྲེང་དང་རིལ་བ་སྤྱི་བླུགས་ཐོགས་པ་ཐོར་ཚུགས་སེར་པོ་སྤུ་ཅན་ལས་དང་རྗེས་སུ་མཐུན་པའི་ཁ་དོག་ཏུ་བསམ་མོ།",
    "ཡམ་སྲེག་ཤིང་གི་ཐོར་ཏོ་གཉིས་མར་ལ་བསྐུས་པ་གསུམ་བསྲེགས་ལ་གུང་མོ་དང་སྲིན་ལག་དང་།",
    "དེའི་འོག་ཏུ་རྡོ་རྗེ་སེམས་དཔའ་བཟླས་བརྗོད་བྱས་པའི་མཆོད་ཡོན་གྱི་སྣོད་བྱུག་སྤོས་གཙང་མ་དྲི་ཞིམ་པོ་སྙདང་མེ་ཏོག་ཅན་གྱི་ཆུས་བཀང་བ་དག་གིས་གཡོན་རོལ་དུ་གཞག་གོ།",
    "རང་གི་མདུན་དུ་ཡང་དགང་གཟར་དང་བླུགས་གཟར་བཞག་ནས་རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་བདག་དང་མི་གཉིས་པར་གྱུར་པ།",
    "དེར་རང་གི་ལྷའི་དམ་ཚིག་གི་སེམས་དཔའ་བཅུག་སྟེ།",
    "རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའ་བདག་ཏུ་གྱུར་པ་ཉིད་དུ་མངོན་དུ་བྱ་སྟེ།",
    "ཐབ་དེ་དག་གི་དབྱིབས་ཀྱི་ཁྱད་པར་དེ་ལས་གསུངས་པ་གང་ཡིན་པ་དང་།",
    "བུད་ཤིང་དང་སྲེག་རྫས་དང་།",
    "རྡོ་རྗེའི་རིགས་ཀྱིས་རིགས་རྒྱས་པར་བྱ་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་ཀྱི་མར་དང་བསྲེས་པའི་འབྲས་ཀྱི་སྲེག་བླུགས་བྱས་ན་རིགས་ཀྱི་ནོར་དང་འབྲུ་དང་བུ་ཚ་ལ་སོགས་པ་དང་ལྡན་པ་འབྱོར་བའི་མཚན་ཉིད་རྒྱས་པར་འགྱུར་རོ།",
    "དེ་ལ་འདི་ནི་རྡོ་རྗེའི་རིགས་ཀྱིས་རིགས་རྒྱས་པར་བྱེད་པའི་མཚན་ཉིད་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་ཚེ་རིང་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་དག་འདི་ནི་རྗེས་སུ་ཆགས་པར་བྱེད་པའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་བཅིང་བའི་༩སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "ཡམ་སྲེག་ཤིང་ཚ་བས་མེ་སྦར་ལ་འབྲས་བུ་ཁ་བའི་སྦྱིན་སྲེག་གིས་དགྲ་ལ་དྲག་ཤུལ་བྱའོ།",
    "དེ་ལ་འདི་ནི་དྲག་ཤུལ་སྤྱོད་པའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་འདོད་པའི་གཟུགས་ཅན་དུ་གྱུར་པའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་མི་སྣང་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་རྡོ་རྗེའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པ་ནམ་མཁའ་ལ་འགྲོ་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "ལྕུག་མ་བྲེས་པ་ལྟ་བུ་ཕྲ་མོའི་གཟུགས་རྩ་བ་མེད་པར་སྐྱེའོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
