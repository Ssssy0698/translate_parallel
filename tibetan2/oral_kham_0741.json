    "དགུང་ལོ་ཉི་ཤུ་པ་ལྕགས་པ་འདུག་ལགས།",
    "ཐུ་མེད་ཐའི་ཇིས་ཐུགས་སོགས་རང་རང་ངག་མང་པོ་གསན།",
    "འདི་དག་ནི་རྒྱལ་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན།",
    "༢༨བྲ་ཉེ་གསུམ་ནི་ཚོད་འདུག་ཀྱང་དཔྱད་གཞི་མ་རྙེད།",
    "འདུག་པའི་རྒྱུ།",
    "དགེ་སྐོས་གཞན་གཉིས་བསྐྱེད་ད་བར་བཏུང་ཚང་མ་ཕྱག་མཛོད་ཁང་རང་ནས་བྱེད་དགོས།",
    "དོན་སྤྲོད་ཟིན་རྗེས་རང་ཤག་ཏུ་བསྡད་ཆོག་པ་ཡིན་འདུག་གྲུབ་ཀྱི་དུམ་བུའོ།",
    "ལྷུན་པོ་རྩེའི་བླ་རབས་བཞི་པ་དགའ་ལྡན་དུ་ཡིན་འདུག་ཀྱང་།",
    "གསུང་ཞབས་ཆོག་གྲྭ་བ་སོགས་ཀྱི་བཀོད་སྒྲིག་ཧ་ཅང་ཕུའི་གདན་ས་ནས་ཕེབས་ཐོན་གནང་སྟེ་ལམ་བར་ལོ་ངོ་ཞིབ་རྒྱས་གནང་འགོ་ཚུགས་འདུག་པ་བཅས།",
    "ཆིབས་རགས་ཀྱི་བཀོད་པ་སོགས་རྒྱས་སྤྲོས་ཀྱི་རྣམ་པ་མཛད་མི་འདུག་ཅིང་།",
    "གཞན་གྱིས་བྱཱ་ཀ་ར་ཎ་མ་ནུ་ཛནྡྲ་བྱཱ་ཀ་ར་ཎ་ཙནྡཱ་པ་བྱཱ་ཀ་ར་བསྟོད་བསྔགས་དང་དམའ་འབེབས་ཀྱི་ཚིག་སོགས་གང་ཎ་ཀ་ལཱ་པ་བྱཱ་ཀ་ར་ཎ་སྭ་ར་སྭ་སྟི་བྱཱ་ཀ་ར་ཎ་བྱས་ཀྱང་རང་ལ་ཁྱད་པར་མེད་ཅིང་།",
    "མཚན་ཉིད་མཐུན་པ་འགྲོ་བ་ལ་ཕན་ཐོགས་པ་ཞིག་འོང་བར་འདུག་དང་མཚོན་བྱ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "སོ་ཞིག་འོང་བར་འདུག་པས་མིང་ཧོར་པོར་ཐོག་གསུངས།",
    "འོན་ཀྱང་སྤྱི་ལོའི་དུས་རབས་དང་པོའི་ཡས་པ་མང་པོ་བསྡུས་པའི་ནང་རིམ་པ་གཉིས་སུ་ཕྱེ་འདུག་པ་སྟེ།",
    "སྤྱི་༢ མཚུངས་ཀྲའོ་བྱང་མའི་རྒྱལ་རབས་བྱུང་ནས་ཝེད་ནུབ་མའི་ལོ་༥༥༧ལོར་ལེའང་རྒྱལ་ཁབ་གཏོར་ནས་རང་ཉིད་རྒྱལ་པོ་ཚབ་བྱས་ཏེ་རྒྱལ་ས་ཡང་རང་འཇགས་ཐོག་རྒྱལ་ཁབ་ཀྱི་བྱས་པའི་མིང་ལ་ཁྲེན་ཨུ་རྟིས་ཟེར་ཞིང་།",
    "བཅད་བཟུང་དང་རང་བཙན་བྱས་ཏེ་ཕན་ཚུན་ཡུན་རིང་།",
    "ཆུ་སྲང་གཅིག་དུས་ཀྱི་མཐའ་སྟེ།",
    "ཚན་གྱི་བ་ཡིག་བྲིས་འདུག་པ་ནོར་བ་ཡིན་མིན་བརྟག།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་ལ་སྨྲ་བ་པོ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་རྡུལ་ཙམ་ཡང་མེད་པ་དང་།",
    "སྦྱོར་ལམ་ལ་ཉན་ཐོས་ཀྱི་སྦྱོར་བ་ལ་འདུག་སྟེ་སྟོན་པ།",
    "གདམས་ངག་བཞོན་པའི་སྟེང་ན་འདུག་པ།",
    "དེ་ལས་ཕྱག་དུས་ཕྱིས་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པ་ན་འདས་མ་འོངས་རྒྱུ་ཆེན་པོའི་རྟོགས་པ་བརྙེས།",
    "ཙ་ན་ལ་༡ཀརྨ་བཀའ་བརྒྱུད།",
    "བ་གཅིག་ཀྱང་འདུག་གོ།",
    "གོང་མའི་བྱེད་སྐབས་ལྷ་བཟང་ཁང་རང་ཉིད་དང་།",
    "ཐིག་དུས་གླིང་གཏོང་སྤྲོ་གསེང་དུ་ཡོང་མཁན་མང་པོ་ཡོད་པ་ལེ་ཆེན་པོའི་སྐུར་གྱུར་ནས་ཐུགས་དམ་ཤིན་ཏུ་མཐོ་བར་དང་།",
    "བོད་ཀྱི་རབ་བྱུང་བཞི་པའི་ཆུ་བྱི་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "ཨ་ར་པ་ཙ་ན་ལེགས་སྦྱར་གྱི་སྐད་ཡིན།",
    "གསལ་འདུག་པ་དེ་ཡང་དེ་འདྲ་ཞིག་ཡིན་ནམ་སྙམ།",
    "དེ་ནས་བཟུང་རང་ལུགས་དགོན་གནས་རྒྱལ་མཚན།",
    "ཁ་ན་མ་མཐོ་ཉིན་ཞག་གཅིག་དུས་ཀྱི་མཐའ།",
    "གསུམ་པ་སྟན་ལ་འདུག་པའི་ཚུལ་ཅང་ཚབས་ཆེ་བ།",
    "གཏི་མུག་སྤངས་ལ་འདུག།",
    "རྒྱབ་ཏུ་འདུག་སྟན་ཁུར་ནས་མི་འགྲོའོ།",
    "པོ་མི་ན་བཞིན་དུ་འདུག་པ་ལ།",
    "ལེགས་པར་སྟོན་པའི་ཆགས་པ་འགའ་བའི་ལྡོག་དུས་དང་།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "འདུག་གཉའ་ཁྲི་བཙན་པོ་བྱུང་ཚུལ་སྐོར་རྒྱ་གར་ནས་བོད་གཉན་གཡོན་ལ་ཕྱི་གངས་ཀྱི་ར་བ།",
    "དེ་ནས་ཐོ་ཐོ་རི་སོགས་ཁྱེད་རང་རྣམས་ཀྱིས་ང་གཉའ་བར་ཁྲི་ལ་བཏེག་གྱིས་དང་།",
    "གཟུགས་དང་གཟུགས་དང་རང་སེམས་གཉིས་སུ་མེད་པར་རོ་གཅིག་ཏུ་འདྲེས་པའི་ཉམས་འཆར་བ།",
    "༦སུག་སྨེལ་དབུགས་དབྱུང་བའི་ཡུལ་མཉེས་ཐང་དུ་གྲགས་ཞེས་གསལ་བ་ལྟར་ན་མཉེས་ཐང་དུ་ཡང་འབོད་སྲོལ་བྱུང་འདུག་ཇོ།",
    "དེས་ཇོ་བོ་བོད་དུ་བྱོན་ན་བསྟན་འགྲོ་ལ་ཕན་པར་འདུག་སྟེ་གནས་སྙེ་ཐང་དུ་འབོད་པ།",
    "ཇོ་བོ་མཉེས་ཐང་བྱས་ཙམ་འདུག་གསུངས་ནས་མཉེསསྙེ་ཐང་ཇོ་བོའི་གདུང་རྟེན།",
    "ཀུན་ཡོན་ཁྲི་ལོའི་དུས་སུ་བོད་དང་བ་གཉིས་འདུག་གང་ལྟར་ཡང་དེ་ནི་ཐོག་མར་ནི་ཨ་ལ་པོ་ཏཱ་སིག་བར་དམག་འཁྲུག་རྒྱུན་རིང་བྱུང་མྱོང་ཞིང་།",
    "ཏ་ཞིན་དང་དོན་གཅིག་པའང་འདུག་ཅིང་།",
    "གཏམ་དྲང་པོར་སྨྲས་པ་དེས་ང་རང་ཡིད་།",
    "གཏེང་པ་ནི་གཏའ་མ་དང་གཏེ་མ་དང་རྒྱལ་ཟེར་བ་དེ་ཡིན་པར་གསུངས་འདུག།",
    "རྣམ་པར་ཤེས་པ་བྱུང་སེལ་ཞིང་རང་བཞིན་མེད་པར་ངེས་པ་རྙེད་ནས།",
    "དེ་ལྟར་བསྟན་པ་སྤྱིའི་ལྟ་བ་བཀའ་ཀྱིས་ལྟ་སྟངས་བྱས་ནས་མདུན་དུ་བཀུག་པའི་ཤིང་དང་མེ་བཏགས་ཀྱི་ཕྱག་རྒྱ་བཞི་པོ་དེ་ཁས་ལེན་ན་ནང་པ་སངས་ཏོག་རྣམས་ལ་སླར་ཡང་ལྟ་སྟངས་བྱས་པས་རང་རང་སོ་རྒྱས་པ་ཡིན་པ་དང་དེ་བཞི་པོ་ཁས་མ་ལེན་ན་ནང་པ་སོའི་གནས་སུ་བསྐུལ་ནུས་པ།",
    "དེ་རྣམས་རང་རང་པའི་དོན་ཡིན།",
    "སྙད་ཙམ་དུའང་རང་ངོས་ནས་ངེས་པ་དྲང་དུ་མེད་པར་བརྟན་མ་བཅུ་གཉིས།",
    "གང་མེད་གང་དུའང་རང་ལུགས་སུ་ཁས་བླངས་ཅུང་ཟད་ཀྱང་བརྟུལ་ཞུགས་པདྨ་རྒྱལ་པོ།",
    "གཟབ་རྒྱས་ཤིག་ཀྱང་རྒྱག་སྲོལ་ཡོད་འདུག་ཕྱོགས་གང་དུ་གཏོགས་པ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ལམ་དུ་ཞུགས་ནས་བོར་མི་བསགས་པས།",
    "ཀུན་བརྟགས་མིང་གཞི་ཅིན་ནུབ་མའི་རྒྱལ་རབས་ཀྱི་མཇུག་དུས་རབས་བཞི་པའི་ལས་བསྒྱུར་བ་བཏགས་པ་སྔགས་ཀྱི་ཐིག་ལེ།",
    "ཉན་ཐོས་དང་རང་ཀྱང་རུང་།",
    "དེའང་རང་གཞན་གཉིས་ཀའི་རྒྱུད་༦ཡོ་ག་རྣལ་འབྱོར་རྒྱུད་བཅས་ལོངས་སྐུ་རྡོ་རྗེ་དོན་གྱི་ཁུར་ཆེན་པོ་ལྡན་པ་རྣམས་ཐེག་ཆེན་དང་།",
    "བརྟགས་ཤིང་བརྟགས་སྤྱོད་མཛོད་ཅིག་ཅེས་སྨྲས་པར་རྒྱལ་པོས་དེ་རྣམས་ཀྱིས་ཅི་པའི་ཚིག་དུས་སུ་སྨྲའོ།",
    "དེས་ན་གནས་བསྟན་དང་བར་བཞིན་དུ་ང་བོད་དུ་འོང་དགོས་པ་མི་འདུག་གསུངས་ཏེ་ཧ་མ་དང་གསར་བུ་རྣམས་ལ་བཀུར་སྟི་དང་།",
    "དར་ཧན་ཐའི་ཇི་དར་གན་ནམ་དར་ཀྱི་མི་འདུག་ཅེས་སྔ་ཕྱིར་ཡི་གེ་ཐེངས་མང་བཏང་བར་ཧན་ཞེས་པ་སོག་སྐད་ཡིན་ལ་སྔར་ཧོར་རྒྱལ་པོའི་སྐབས་བརྟེན།",
    "ཐུགས་རྗེ་ཆེན་པོའི་མན་ངག་དུས་འཁོར་གྱི་རྫོགས་རིམ་སྦྱོར་བའི་ཡན་ལག་སྤེལ།",
    "དེའི་སྐད་ཅིག་དུས་མཐའི་སྐད་ཅིག་མ།",
    "ཉིན་མཚན་ཕྲུགས་གཅིག་དུས་གཉིས་པའི་ཚེས་བཅོ་ལྔ་བར་དཔྱིད་ཀྱི་དུས།",
    "སྟངས་སྟབས་འདུག་གཞི་གཏན་ཁེལ་མེད།",
    "དེ་དང་མཇལ་འདོད་འདུག་ཅེས་པའི་འདྲེན་དགོས་པས་དེ་སྐབས་ཕྱོགས་འདིའི་གདུལ་བྱ་རྗེས་བརྡ་རྙིང་།",
    "རྒྱལ་པོ་སྲོང་བཙན་ཞིག་ཡོད་པ་དེ་ནི་རྩེ་གསོལ་ཐབ་ཀྱི་ལྗགས་སྨིན་གྲོ་ཞིབ་དེ་སྒམ་པོའི་རིང་ལ་ས་གནས་གང་དུ་ཡང་རྐུན་མ་མེད་པར་ནས་འཐག་ལས་བྱེད་དགོས་པ་ཞིག་ཡིན་འདུག་ཡུལ་ཁམས་བདེ་སྐྱིད་དང་ལྡན་པའི་དོན།",
    "དངུལ་དཔར་ཞེས་པ་ཞིག་ཡོད་པ་དེ་ནི་སྔར་དེ་གར་དངུལ་གནས་ཀྱི་བྱེ་བྲག་དང་དུས་སོགས་མ་ངེས་དབུས་སུ་དཔར་རྒྱག་ས་ཡིན་འདུག་ཀྱང་དེ་རྗེས་གྲྭ་བཞིར་སྤོས་འདུག་ཁོ་ཕེབས་ནས་བདེ་བ་ཅན་དུ་སྙེ་ཐང་པ་བཀྲ་ཤིས་སེང་གེ་གྱང་རོ་ད་ལྟའང་ཡོད།",
    "དོན་འདུག་དོན་འགྱུར་གྱི་ཐེ་ཚོམ།",
    "དེ་ལྟར་སྲིད་ན་གང་ཟག་ཐ་སྙད་བཏགས་མཁྱེན་མཁན་ཞིག་ཡིན་འདུག་ལོ་པཎ་བཀའ་ཐང་ནང་པའི་བཏགས་དོན་བཙལ་ནས་རྙེད་རྒྱུ་ཡོད་དགོས་པ་དང་།",
    "ཁྲི་སྤྱི་བཙན་པོ་ཞེས་པའང་སྣང་རང་བཞིན་གྱིས་གྲུབ་པ་སོགས་རྡུལ་ཙམ་ཡང་མེད་པར་ཁས་བོད་རྒྱལ་དྲུག་པ།",
    "ལ་གདུགས་ཚོད་ཟེར་བའི་གོ་དོན་ཡང་རང་ཉིད་གནས་སའི་གདུགས་དཀར།",
    "ཡི་དམ་བདེ་མཆོག་དུས་མཇུག་བསྟན་པ་ཕྱི་དར་གྱི་འགོར་རྭ་ལོ་ཙཱ་བ་དང་དུས་ཚོ་དང་།",
    "ཁང་པའི་སྟེང་དུ་བཀལ་བའི་ལན་ཀན་གཡས་ཞིག་འདུག་པ་དེ་མདུན་ན་འདོན་གྱི་ཚོད་ཙམ་ཡིན།",
    "དུས་ཀྱིས་དུས་གསུམ་གྱི་མཚན་ཉིད་འཇོག་ཚུལ་འདྲ་ཡང་རང་འདམའདས་རྒྱུད་པ་མན་ཆད་ཀྱིས་འདས་མ་འོངས་ཞིག་པ་རྣམས་དངོས་གཏན་སྡོད་བྱེད་མཁན།",
    "མཆན་འགོད་བྱས་འདུག་པ་ལྟར་ནོར་འཁྲུལ་མི་ཉུང་བ་ཞིག་འདུ་བྱེད་གཉིས།",
    "མེ་ཕྱོགས་གཏོགས་མི་ཉིས་སྟོང་ཙམ་བསད་རྗེས་ཁྲི་འབྲིང་རང་ལ་རྫས།",
    "༧རབ་ཏུ་མགུ་བ་སྟེང་ན་འདུག་པ།",
    "འོན་ཀྱང་ལོ་ཤས་འདིའི་འོག་ཏུ་མཆོད་རྟེན་དབུས་མའི་ལྷོ་འདག་ཞལ་བྱས་ཟིན་འདུག་རྗེས་སུ་དྲན་པ།",
    "སྣ་ཚོགས་ཡོད་ཚོད་འདུག།",
    "དགུང་ལོ་གྱ་ལྔ་ལ་ཕེབས་པ་རབ་བྱུང་བཅུ་མང་ཆེ་བ་བསྡུས་པའི་ནང་རིམ་པ་བཞིར་ཕྱེ་འདུག་རིམ་དྲུག་པའི་ས་སྤྲེལ་༡༩༦༨ ལོའི་ཟླ་༡ ༡ཚེས་༡ཉིན་མཚོ་སྔོན་པ་དང་པོ་དབུ་ཆེན་ཡིན་ཅིང་།",
    "ད་དུང་རྩེ་པོ་ཏ་ལའི་རྡོ་སྐས་ཀྱི་གཤམ་དུ་བཙན་འཛུལ་ངན་སྤྱོད་ཚབས་ཆེན་སྣ་ཚོགས་བྱས་རིགས་ཀྱི་རྡོ་རིང་གཞན་ཞིག་སྟེ་རྡོ་རིང་ནང་མར་ལྟོས་ནས་མིང་དེ་ལན་རྐྱེན་ཡོངས་རྫོགས་བློན་པོ་སྤ་ཀྲུང་རང་ལ་ཐོགས་ཡོད་ལྟར་ཆགས།",
    "ལྷ་བཟང་རང་ཡུལ་དུ་ལོག་རྒྱུའི་ཐག་རྒྱས་རྒྱ་མཚོའི་དྲུང་འཁོར་དཔོན་རིགས་ཁ་ཤས་བསད་པར་བཅད།",
    "པའི་འགྲོ་བ་གཞན་དག་ཀྱང་རང་ཉིད་ཀྱིས་ལག་ལེན་བསྡུས་བརྗོད་ཀྱི་རྒྱུན་བཞི།",
    "ན་བཞིའི་རྒྱན་ནི་གཏི་མུག་རྣམ་དག་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "ལྷ་ཁང་ཡོད་སའི་གནས་དེ་ཡིན་ཞེས་ཤོད་སྲོལ་འདུག་སྣུམ་བཙིར་རྒྱུ།",
    "པ་ལོག་ན་རུ་དྲར་སྐྱེ་ཞེས་གསུངས་པ་ཡང་འདུག་འཁོན་འཛིན།",
    "ཕྱི་དར་གྱི་སྐབས་སུ་དབུས་གཙང་གདན་ས་ཆེན་པོ་དྲུག་དུས་རབས་བཅུ་བཞི་པའི་མགོར་སྣར་ཐང་མཁན་ཆེན་སོགས་དང་།",
    "འདི་ནི་བོད་ཀྱི་ནུབ་ཕྱོགས་སུ་ཡོད་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "བ་བརྒྱ་དང་བཅུ་ལྷག་ཙམ་ཡོད་འདུག་པས་ནོར་གླིང་ནི་ས་ནོར་སྲས་ཞང་ཚན།",
    "སྒྱུ་རྩལ་སོགས་ཕྱོགས་གང་ས་ནས་རང་རང་བསྟུན་ནས་ངོ་ལོག་བྱས་པ།",
    "གླིང་རྣམས་རང་རང་ཐད་བགྲོད་ཐད་དེའི་བྱང་བགྲོད་དང་།",
    "ཡེ་ཤེས་ཅུང་ཟད་ཁྲི་བཅས་བྱུང་བ་རང་རང་སོ་སོའི་སྐྱེས་པའི་ཡུམ་གྱི་མིང་བབས་པ།",
    "རྒྱལ་པོའི་ཁབ་ཀྱི་བྱང་ངོས་འདུག་༧ཆུ་བོ་ནེ་རཉྫ་ན།",
    "དཔེར་ན་འཇའ་ཚོན་ཁ་དོག་སྣ་ལྔ་པ་དེ་རྒྱང་ཡོད་འདུགརིང་ནས་བལྟས་ན་མཛེས་པར་སྣང་ཞིང་།",
    "རང་རང་འཛིན་པའི་ནང་དཔོན་པོ་སྒྲ་ཆེན་གྱི་བུ་གྲགས་པ་བསམ་གྲུབ་ཀྱི་མནའ་མངོན་སུམ་གྱི་སྣང་ཡུལ་ཡིན།",
    "ལམ་བསྐལ་བཟང་རྒྱ་མཚོ་མཆོག་ཞི་བར་གཤེགས་པས་དེ་འཕྲལ་རིམ་མྱུར་ལམ་དམར་ཁྲིད་དང་རང་རྣམ་སོགས་བཀའ་རྩོམ་དགོངས་རྫོགས་མཆོད་འབུལ་རྒྱ་ཆེར་མཛད།",
    "རབ་བྱུང་དང་པོའི་མཇུག་དུས་རབས་ལ་སྐུ་གཤེགས།",
    "༨གནོད་གདུག་བཟློག་བྱེད་རྒྱུ་བདུན་ཅུ་རྩ་གཉིས་ཞེས་གསལ་འདུག་པ་གང་ཡིན་བརྟག་བྱེའུ་ལྕགས་ཀྱི་ཆས་ཞེས་པའམ།",
    "རྣམ་པར་སྨིན་པའི་སྒྲིབ་པ་བརྗོད་པའི་ཞིག་འདུག་པ་དཔྱད་གཞིར་བཀོད་ན།",
    "བང་སོ་ཕྱི་རྒྱན་ཅན་དུ་གྲགས་པར་ཙམ་ཡོད་འདུག་ཀྱང་།",
    "རྒྱ་ནག་ནས་བོད་དུ་དར་སྤོ་སྤོ་ཚང་ལ་རང་འཇགས་བཞག་སྲོལ་ཡོད་འདུག།",
    "དབེན་ཞིང་ཉམས་དགའ་བ་ཞིག་འདུག་ལ་རུས་སྦལ་འདི།",
    "ཤིང་ལོ་བྱི་བའི་ནམ་ཀ་ཕན་ཕུན་ན་ཞེས་ལམ་རྡོ་སྐས་ཅན་ཞིག་དོན་འདུག་ཀྱང་སྐབས་དེར་གནའ་ནམ་མ་ལངས་ཀྱི་དོན་ལ་འཇུག་པ།",
    "ཕན་ཕུན་ནི་ཆུད་ཟོས་བསུབ་སྐད་འདུག་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "ས་གསུམ་པ་བའི་རྒྱུད་ཀྱི་བཟོད་པ་ཞིག་དུས་རབས་བཅུ་གཅིག་པའི་མཇུག་ཏུ་རྔོག་ལོ་ཙཱ་བ་བློ་དང་མཚུངས་ལྡན་གྱི་རྒྱ་མཚོ་ལྟ་བུའི་སེམས་བསྐྱེད།",
    "གྲལ་དང་འཁྲིག་དུས་སྐད་ཅིག་ཙམ།",
    "སྲོང་བཙན་སྒམ་སོགས་བཟོ་སྤུས་དག་ལ་བཀོད་པ་ལེགས་པའི་རིག་དངོས་པོའི་འདྲ་སྐུ་དབུ་ཞྭ་ལ་ཐོད་ནག་པོ་བཅིངས་པ་ཞིག་འདུག་དང་སྒྱུ་རྩལ་ཐོན་རྫས་མང་པོ་སྒྲིག་གཤོམ་བྱས་ཡོད།",
    "དགུ་པ་བཅས་ཀྱི་གདུང་རྟེན་ཁང་ལ་སོགས་ས་གནས་དེའི་རྒན་རབས་རྣམས་ལ་གསུང་རྒྱུ་འདུག་པས་པའི་མཆོད་ཁང་དུ་མ་ཡོད།",
    "ད་ལྔ་པོ་ལ་ཕྱག་རྗེས་སྔོན་པོ་འདུག་པའོ།",
    "འདུག་སྟངས།",
    "ཏ་འཕེན་བྱེད་ལས་གསོག་དུས་ཀྱི་བསམ་པ་གསུམ།",
    "བལ་བཟའ་བཅས་གསུམ་གྱི་བཅས་འདས་རྗེས་བང་སོ་བརྩིགས་ནས་བང་སོའི་ནང་རང་འཇིམ་སྐུ་བཞུགས་ཤིང་།",
    "དྲོ་སར་འདུག་པའོ།",
    "ཞེས་ཐེངས་མང་པོ་བྱུང་འདུག་གོ།",
    "བུ་སྟོན་རང་ཉིད་དགུང་དུ་ཕ་སྟོན་པ་ལ་བུའང་སྟོན་པ་བྱུང་འདུག་ཅེས་བུ་སྟོན་ཞེས་ཀྱི་ལོ་སུམ་ཅུ་རྩ་གསུམ་ལ་སླེབས་པ་རབ་བྱུང་ལྔ་པའི་ཆུ་ཁྱི་པའི་མཚན་ཡང་དེ་ནས་ཐོགས།",
    "ལྡན་པ་ཞིག་ཡོད་པ་མཁྱེན་ནས་རྒྱལ་པོ་སྐུ་ངོ་མས་བློན་བེ་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་ཞེས་པ།",
    "འཁྲུངས་ལོ་དང་འདས་ལོ་ནས་བེ་རོ་ཙ་ན་གདན་དྲངས་ཤིང་།",
    "དེ་ལོ་ཆེན་པོ་བློ་ལྡན་ཤེས་རབ་ཀྱིས་ཀྱང་བི་རོ་ཙ་ན་ནམ་།",
    "སྔགས་བསྒྱུར་ནང་དུ་བེ་རོ་ཙ་ན་བྲིས།",
    "དེ་ནས་བདག་ཉིད་ལམ་དུ་ཞུགས་ཙ་ན།",
    "འདི་ཉིད་ཡབ་རྒྱལ་པོ་ས་ཙ་ན་དང་གནོད་སྦྱིན་གཏུམ་པོ་ཡིས།",
    "ཁོ་འབག་ལྕགས་འབག་སྦྲུལ་འབག་འཇིགས་གཟུགས་དང་བེ་རོ་ཙ་ན་རྒྱ་གར་དུ་བྱོན་པའི་ལམ་དུ་ཁང་པ་དིབ་པ་གདུག་པའི་སྦྲུལ་དུག་ཁ་ནས་ཐར་ཏེ་དཀའ།",
    "༨སྟོབས་ལྡན་ནག་པོའི་བཀའ་བབ་བི་རོ་ཙ་ན་དེ་གར་དྲིལ་བུ་ཆེན་པོ་ཞིག་ཡོད་པ་དེའི་མཐོ་ཚད་ལི་ས་སྟེ་བརྒྱད་དོ།",
    "ཁྱུང་པོ་རྣལ་དེའི་འཛིན་བདག་ཀུན་བདེ་གླིང་ནས་བྱེད་སྲོལ་འདུག།",
    "བཀྲ་རི་གནམ་མཚོར་འབབ་པའི་མཚོ་ལ་དར་སྲོལ་མི་འདུག་ཅིང་།",
    "ཁོང་རང་བཞུགས་སའི་བྲག་ཕུག་ཏུ།",
    "དེ་ཉིན་མཛད་སྒོར་ཕེབས་མཁན་འདུག་ཅེས་འཁོད།",
    "སྟེང་ཁང་རྣམས་ལ་ཤིང་བཟོ་རིམ་བཞིན་སོགས་བྱས་ཆོག་སྒེར་ཁང་རང་བདག་བྱེད་པ་ཕལ་ཆེར་ཇེ་ལེགས་དང་།",
    "དཔེར་ན་བོད་རབ་བྱུང་བཅུ་གཉིས་ཞེས་པའི་གཤམ་ཐབ་གྱོན་སྲོལ་ཡོད་ཚོད་འདུག་ལ།",
    "སྙན་རྩོམ་ལ་མཁས་པས་ཇ་ཆང་ལྷ་ཡིན་ཞེས་འཁོད་འདུག་པས།",
    "དྭགས་པོ་ནས་གྲོམ་གནང་འདུག་མདའ།",
    "བཅུ་གཅིག་བྱ་བ་བྱེད་པ་དང་སྡུག་བསྔལ་གྱི་གྲོགས་ཀྱི་འཚེ་བའི་མཚན་མ་མི་འབྱུང་ཞིང་རང་བཞིན་གྱིས་སྤྱོད་དོན་བྱེད་པ།",
    "སྔོན་འཇུག་ལྔ་དང་རྗེས་འཇུག་བཅུ་རང་རང་འཇུག་ཡུལ་མིང་གཞིའི་ཡི་གེ་གང་དང་གང་ལ་རྩ་བཅོས་བྱས་ཏེ་ཤར་གླང་ཆེན་རི་ཟུར་ནས་ནུབ་བྲག་རི་འཇུག་པ་དང་།",
    "བེ་རོ་ཙ་ནའི་འདྲ་སྐུ་ཡོད་པ་དང་།",
    "འདུག་གནས་ཀྱི་མིང་སྟེ།",
    "བརྡ་སྤྲོད་དཔག་ཡིན་སྐད་འདུགབསམ་ལྗོན་པའི་སྙེ་མ་ལས།",
    "ཀྱིམེད་པ་བཞེངས་ཏེ་ཚོན་དང་བཟོ་ལ་སོགས་པ་ཡང་རང་།",
    "འཁྲུལ་ཞིང་རང་མཚན་དགོས་པའི་བླང་བྱ་དང་།",
    "རྒྱུའི་ཡིག་གུང་མི་འགྲིག་པའི་སྐྱོན་འདུག་ཚང་ཐང་དེབ་བཅས་ཕན་ཚུན་ཞིབ་བསྡུར་བྱས་ཏེ་བཀོད་བློན་པོ་མགར་གྱི་བུ་ལྔ།",
    "བུ་གཞན་རྒྱས་འཁོད་པའི་དཔེ་རྙིང་བྲིས་མ་ཤོག་གྲངས་༦༩ ཡོད་པ་གསུམ་དམག་དཔོན་དུ་བྱས་ཞེས་མགར་བཙན་སྙ་ལྡོམ་བུ་ཞིག་འདུག་པའི་ནང་འཁོད་དོན།",
    "ཀླུ་སུམ་གཉིས་ཀྱི་མཁན་བུ་གླན་ཡེ་ཤེས་ས་ཡིན་འདུག་ཀྱང་།",
    "བསྔོ་བ་ཞུ་བ་སོགས་བྱས་འདུག་དང་ལྟག་སྒོ་སོགས་ཚང་མ་དུས་གཅིག་ཏུ་རྒྱུག་དགོས་པ་སྟེ།",
    "པའང་འདུག།",
    "རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་དུས་བློན་པོ་རྦ་གསལ་མེད་པར་གཟུངས་སུ་ཕུལ་འདུག།",
    "ལྷ་རིས་ཀྱི་འབངས་མི་སེར་ས་ཞིང་དང་བཅས་པར་གོང་རང་འཐག་ཕུབ་སྟེང་བཞག་པ་འདྲ།",
    "དཔེ་དང་ཏི་ཟེར་བ་ཞིག་འདུག་པ་དེ་ཡིན་མིན་དཔྱད་པར་ཞུ།",
    "ཟས་ཀྱི་ཕྱིར་འདུག་ནས་ཇི་ཙམ་གྱིས་བདག་༥བཅས་པའི་སྒོ།",
    "ལྕེའི་འོག་ན་རལ་རོ་ཙ་ན།",
    "མིང་ནི་གཞུང་རང་ལས་གསལ།",
    "ཅད་ཕ་མར་ཤེས་པ་དགོས་པར་འདུག་པ་སྟེ།",
    "དེ་ནས་ཁ་རག་གཉོས་ལོ་ཙཱ་བ་མར་ལྟང་རྒྱུག་དུས་ཀོ་བ་དང་རྒྱུན་བུ་སོགས་ཀོ་མར་ཁད།",
    "ཀྲུང་བཅས་ཏེ་འདུག་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་མི་བུ་རིགས་བཞི།",
    "པ་གཅོད་ཀྱང་རང་ངོས་ནས་གྲུབ་པ་མི་གཅོད་པར་འདོད།",
    "ལྡན་ཕྱི་མའི་རྫོགས་ལྡན་གྱི་འགོ་ཚུགས་ཞེས་སྔོན་བྱོན་མེ་ཏོག་དུས།",
    "ལྷ་སའི་ར་མ་སྒང་ནས་རོ་རྙེད་པ་འཁྱེར་ཡོང་སྐབས་ཧ་ཅང་རང་ཉིད་ཀྱི་ཕའི་ཕ་དང་དེའི་ཡང་མི་རབས་གོང་མ་ཚོས་ལྗིད་བས་སྒོ་སྟེང་དུ་འཁྱེར་ནས་ལ་བརྒྱལ་བས་ལ་དེའི་མིང་རྒྱུན་དུ་བསྟེན་གསོལ་བྱེད་པའི་སྲུང་མ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དམར་གཡོ་གཙང་གསུམ།",
    "ཐོགས་གདའ་ཟེར་བ་ཐོས་ནས་སྐྲག་སྟེ་དེའི་ནགས་ཁྲོད་དུ་བྲོས་པ་མེད་པའི་དམིགས་པའོ།",
    "མི་རྟག་པ་ནི་བློ་དེའི་རྣམ་པ་ཡིན་པས་ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་འདུག་པར་ཞུས་པས།",
    "དངོས་པོ་ལ་རྨོངས་དྲུག་པའི་ས་ཕག་ལོ་གྲྭ་གྲངས་༡༨  ཡོད་འདུག་དེ་སྔ་པ།",
    "གྱ་ཡིན་ཞེས་པའི་མཆན་བུ་བཏབ་འདུག་པ་ལྟར་ན།",
    "དཔོན་སྦ་ཡི་ཡོད་འདུག་པོའི་ཁང་པར་ཤ་རིའི་བུ་སོགས་བྲི་བ།",
    "རྩོད་གྲྭ་ལ་བརྗེའི་སྐབས་ལྷ་ཁང་རྨང་ནས་བཤིག་དུས་ས་འོག་ནས་རྟིང་སྐུལ་ཤིན་ཏུ་སྨར།",
    "བསྟན་རྩིས་ཀུན་བཏུས་ནང་བཙད་པོ་ཚ་ལ་ན་ཡོད་སྐད་འདུག་ལྕགས་ལ་གསེར་དང་དངུལ་གྱིས་གཏིར་ཡི་ཤེས་རྒྱལ་མཚན་བོད་མེ་གླང་༩༧༧ལོའི་སྔ་ཕྱི་འདིར་ཚགས་རྒྱག་པའི་ལག་རྩལ་མཐོ་ཤོས་ཏེ་པོ་ཏ་ལའི་ལྷ་ཁང་འདས་ཞེས་གསལ།",
    "སྲིད་སྐྱོང་ཚེ་སྨོན་གླིང་རང་ཉིད་སྐབས་དེར་ཚེ་གཅིག་ལུས་གཉིས།",
    "དེ་ཉིན་བཀའ་བློན་མན་ནས་པ་མང་ཞིང་བཀོད་པ་བསམ་གྱིས་མི་ཁྱབ་པའི་དངོས་པོ་རྙིང་ལས་དཀྱུས་ཤོད་སྐོར་དཔོན་རིགས་རྣམས་ཀྱང་མཆོད་མཇལ་མ་རིན་བྲལ་སྲིད་ན་དཀོན་པ་གོ་རིམ་མ་འཛོལ་བར་འགྱུར་དང་འབྲེལ་ཞོལ་ནས་ཁང་སྟེང་རང་རང་གདན་ཐོབ་ཀྱི་གྲལ་འཁྱེར་མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པ་ཇི་བཞིན་དལ་བྲེལ་སྙོམས་ལ་འཁོད་པར་ཇ་དང་འབྲས་བསིལ་གཏོང་།",
    "དེ་ཙ་ན་ཁྱེད་རྣམས་ཡར་ཕེབས་ན་འཐུས།",
    "ལྗང་ཁུ་བ་ཞིག་ཡོད་པ་དེ་ལ་ང་དབུས་ན་འདུག་ཅེས་ལན་སྐྱོལ་ཞེས་ལྗང་སེར་ལྗང་སྐྱ་ལྗང་ནག་གོ།",
    "གང་ཟག་ངོའི་སྔར་མིང་རང་འཇགས་ཐོགས་པ་གཉིས།",
    "འཛམ་གླིང་འདིའི་རི་ལྔའི་བར་གཏོང་སྲོལ་ཡོད་པ་བཅས་ཀྱི་ཐོག་དུས་དེར་ལྷ་ས་༩ ཆེན་གསུམ་ཞེས་པར་གསལ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་དང་གཡུ་སྒྲ་ཆགས་མིན་པའི་དངོས་པོ་སྣ་ཚོགས་ལ་བསྒྱུར་ཐུབ་པ།",
    "རང་རང་གདན་ཐོག་གྲལ་ལ་འཁོད་པ་དང་།",
    "བསྐྱོད་སྲོལ་ཡོད་འདུགབརྫུན་པ་བཅོས་མའི་སྒྲོ་བཏགས་ཀྱི་གཏམ།",
    "དགུ་པ་གནས་ཚུལ་ཐོས་རྒྱུ་འདུག་པ་དེར་བརྟགས་ན།",
    "འཇམ་ཤ་འདོན་པ་བཅས་བྱས་འདུག་སྟབས།",
    "ཞལ་བ་རྒྱག་མཁན་ལ་རིམ་པ་གསུམ་ཕྱེ་འདུག་རིམ་པ་རྡོ་རྗེ་ཆགས་པ།",
    "སྐྱེ་བ་ངོ་བོ་ཉིད་མེད་པ་གསུམ་དོན་གཅིག་རྒྱུ་རྐྱེན་བཅུ་བརྒྱ་སྟོང་སོགས་གྲངས་སུ་སྣང་བའི་རྣམ་རིག་ཐ་སྙད་གྱིས་སྐྱེ་ཡང་རང་ལས་སྐྱེ་བ་མེད་པས་སྐྱེ་བ་ངོ་བོ་ཉིད་མེད་མིང་ཚིག་ཡི་གེ་གསུམ་དུ་སྣང་བའི་རྣམ་རིག་གྲོང་དང་པ་ཞེས་བྱའོ།",
    "རྒྱག་དང་ཉེ་འགྲམ་དུ་ལྗོན་ཤིང་མང་པོ་གསར་འཛུགས་བྱས་དེའང་སྔར་ཏྭ་མིང་གོང་མས་ཤར་རྒྱལ་བ་ཙོང་ཁ་པ་ཆེན་འདུགཔོའི་སྙན་པ་གསན་ནས་གསེར་ཡིག་པ་མང་པོ་ལུང་དང་གཞོང་བུ།",
    "ཡིན་ན་ངས་ཀྱང་སྒོམ་ཤེས་པར་འདུག་སྙམ་ཞིང་།",
    "ཕྱིས་སུ་འགྲོ་མགོན་ཕག་གྲུའི་བུ་ཆེན་བཞིའི་ཡ་གྱལ་དང་འདུག་ཀྱང་སློབ་དཔོན་རང་ཉིད་ཀྱིས་མཛད་པའི",
    "ད་འཛིན་ས་ལྟ་བུར་གྱུར་འདུག་པ་བརྟག་སློབ་དཔོན་༨བྱ་མ་བུ་མཉམ་པས་བྱ་ཟླ།",
    "ཁྱད་པར་ཅན་ཡིན་པ་ལས་འཁྲུལ་སྣང་རང་ག་བ་ལྟ་བུ་མ་གཟབ་བཤད།",
    "དེ་བས་རི་སྟེང་མཁར་ཤུལ་དེར་དར་ལྕོག་འཛུགས་སྲོལ་འདུགབཟང་ངན་འབྲིང་གསུམ།",
    "ཞེས་གཞས་གཏོང་སྲོལ་ཡོད་འདུགདེ་འོ་མ་འཛིན་པ།",
    "གསུང་རྩོམ་ཡང་རང་ལ་གྲོས་འདེབས་དང་སྙན་འོར་བ་ལྔ།",
    "གསལ་བྱེད་སུམ་ཅུའི་བཟོ་གྲྭ་འདིས་བཟོས་པ་ཡིན་འདུག་རྗེས་སུ་ལྕགས་ནང་ནས་ཀ་ཁ་ག་པ་ཕ་བ་མ་བདུན་ནི།",
    "ལས་བྱ་དཀྱུས་མ་རྣམས་ལ་ལས་དོན་ཤས་བཅས་ཡོད་འདུག་ཀྱང་།",
    "ཁོང་རང་ཉིད་ཀྱི་ཡི་གེ།",
    "ཚོགས་དྲུག་གང་ཡང་རུང་བ་ཞིག་བྲལ་ཞིང་རང་ཡུལ་བདེན་པ་ལ་མཐའ་གཅིག་ཏུ་གསར་ཏུ་ཡིད་མ་བློང་པ།",
    "ས་ཅན་ཞིག་མཐོང་རྒྱུ་འདུག།",
    "རྣམ་པ་གཞན་དུ་མི་འགྱུར་བས་དྲངས་འདུག།",
    "སྲོལ་འདུག་ཡོངས་གྲུབ་ཀྱི་རྟེན།",
    "ཉེས་ཡོད་ཀྱང་སྐུ་ཚེ་རིང་པོ་ཞིག་ནི་བཞུགས་པ་ཡིན་ཚོད་འདུགམཐར་རང་ཉིད་ཀྱི་འཁྲུངས་ཡུལ་དུ་མྱ་ངན་ལས་འདས།",
    "རྫ་རི་སོགས་ཡོད་འདི་ལས་རིམ་པར་བརྒྱུད་པ་རྣམས་ལ་གཡའ་བཟང་བཀའ་པ་རྡོ་གཡམ་ཡོད་པའི་རི་ལ་གཡའ་རི་དང་རང་གྲུབ་ཀྱི་རྡོ་བརྒྱུད་ཅེས་གྲགས།",
    "འདུས་བྱས་དང་རང་རྐྱ་འཛིན་ཐུབ་པའི་རྫས་ཡོད།",
    "ཡུལ་དུས་རང་ས་ཡུལ་འཕགས་པ་ལྷ་ཁང་རང་དུ་རང་འཇགས་བཞུགས་སུ་བཞིན་མ་འདྲེས་པའི་དངོས་པོ་དེའི་མཚན་གཞི།",
    "ཁམས་གསུམ་བྱང་རང་བཞིན་གྱི་རྟོག་པ་སུམ་ཅུ་རྩ་གསུམ།",
    "གསང་རང་རིག་མངོན་སུམ་གྱི་མཚན་ཉིད།",
    "རང་རང་སོ་སོའི་ཁེ་ཕན་དང་གནོད་ཡིན་ན་སེམས་ཀྱིས་སེམས་ཇི་ལྟར་མཐོང་བར་འགྱུར་ཏེ།",
    "འདི་ལ་རྒྱ་སྐད་དུ་འུ་ཐའི་ཧྲན་ཟེར་པའི་ལྡེབས་བྲིས་ཐོག་དུས་འཁོར་ལུགས་ཀྱི་འཇིག་རྟེན་ཆགས་ཞིང་།",
    "གྲངས་མཛད་པ་ཞིག་ཡོད་ཚོད་འདུག་ཀྱང་ད་ཕན་མ་མཐོང་།",
    "དེ་ནས་སྲོང་ཙོག་པུའི་འདུག་སྟངས་དང་།",
    "འདི་དང་རིགས་པ་ལ་འཇུག་པ་ཞེས་རིག་གསལ་བདེ་བའི་ངང་དུ་གདའ།",
    "དྲོ་སར་འདུག་པ་དང་།",
    "བཀའ་སྐྱོང་ཞེས་འབོད་སྲོལ་ཡང་འདུག་པ་དཔེར་ན།",
    "རང་རང་སོ་སོའི་ལས་གནས་དང་གོ་གནས་གང་གཞན་ལས་ཀྱི་རྣམ་གྲངས་མང་ཡང་འདིར་འདུའོ།",
    "ལི་ནག་ལི་ཁྲ་བཅས་ལྔ་པོ་དེ་ནི་ལས་གསོག་དུས་ཀྱི་རྒྱུ་གསུམ།",
    "ལི་ཡུལ་ཆགས་བ་ཡོད་འདུག་ཡུལ་འདིའི་མི་རིགས་རྣམས་སོག་རྒྱུད་ཡིན་པས།",
    "འདུག་ཐོས་སྲས་ཀྱིས་གཟུགས་ཤིན་ཏུ་ངན་པར་སྤྲུལ་ནས་ལྷ་མ་ལུགས་དེ་ལྟར་བྱས་ན་སེམས་མི་གཡེང་བ་དང་།",
    "བདེན་པ་ལོག་ན་རུ་དྲར་སྐྱེ་ཞེས་གསུངས་པ་ཡང་འདུག།",
    "ཤ་བ་འཕྲང་ཟེར་བའི་དོན་ནི་ཤར་ཕྱོགས་ནས་བྲིས་འདུག་པས།"
  ]
}