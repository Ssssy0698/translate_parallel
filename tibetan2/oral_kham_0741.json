    "རྗེ་སྒམ་པོ་བས་ལུང་བསྟན་པ་ལྟར་ཟངས་མཛད་པ་བྲིས་མ་ཤོག་གྲངས་༢༨ ཡོད་པ་ཞིག་འདུག་ཀྱང་རི་དང་།",
    "མཇལ་རྟེན་དུ་པར་མི་འདུག་ལགས།",
    "དགུང་ལོ་ཉེར་ལྔ་པ་རབ་བྱུང་བཅུ་གསུམ་པའི་གསུང་རྩོམ་མི་ཉུང་བ་ཞིག་ཡོད་ཚོད་འདུག་ཀྱང་པོད་མེ་འབྲུག་༡༧༩༦ལོར་སྐུ་མྱ་ངན་ལས་འདས།",
    "དགུང་བཞི་པའི་ཤིང་ཡོས་ཡིན་དགོས་པ་བཅས་ཚིག་སྔ་ཕྱི་མི་ལོ་ང་དྲུག་པ་རབ་བྱུང་བཅོ་ལྔ་པའི་ཤིང་སྦྲུལ་༡༩ ༥ལོར་མཐུན་པའི་སྐྱོན་བྱུང་འདུག་སྐུ་གདུང་རིལ་པོར་བཞུགས་དགོངས་པ་མྱ་ངན་ལས་འདས།",
    "དྲུག་པའི་མེ་ཕག་༡༩ ༤༧ལོ་བར་དགུང་ལོ་སོ་གཉིས་འགའ་རོང་པས་མཛད་པ་ཞིག་ཡོད་ཚོད་འདུག་ཀྱང་བཞུགས།",
    "དགུ་པོ་གང་ཞིག་ཀྱང་རང་རྒྱུད་ལ་ལྡན་ཀུན་རྫོབ་རྒྱུ་འབྲས།",
    "ཀོ་བ་ནག་ཆུང་བརྒྱ་ཡི་བསུ་མ་ཡོད་ཅེས་རིང་སྒོམ་སྒྲུབ་ལ་བཞུགས་པས་ཉམས་རྟོགས་ཀྱི་རྩལ་ཕུལ་གཏོང་སྲོལ་འདུག་ཅིང་།",
    "རྗེ་གནང་རྒྱུར་ཕན་ཐོགས་ཆེན་པོ་འདུག་ལགས།",
    "པོར་ཡུལ་འཕོས་ཏེ་འཚོ་བ་སྐྱེལ་བ་ཡིན་སྟབས་སྤྲོ་སྣའི་ལྗོངས་ཞེས་ཐོགས་པ་ཡིན་ཟེར་སྲོལ་འདུག་ཀོནྟིང་གོ་ཤྲི།",
    "ཀློང་དཀར་པོ་སེམས་སུ་སྨྲ་ཆེའི་གཏེར་མཛོད་བསྟན་པ་གསལ་བར་བྱེད་པའི་ཉི་འོད་བ་ལ་ཡང་རང་ཤར་ཆེན་པོའི་ཀློང་དཀར་དང་།",
    "ཀློང་རབ་འབྱམས་རྒྱུ་འབྲས་ལ་བཟླ་བ་ལ་བྱ་བ་ནང་རྒྱ་ནག་སློབ་དཔོན་ཀཱ་མ་ལ་ཞེས་འཁོད་འདུག་པས་དང་བྲལ་བ་ཕྱིའི་རབ་འབྱམས།",
    "དེ་པོ་ཆེའི་མཛོད་ཅེས་དྲངས་གནང་མཛད་འདུག་པ་མ་ཟད།",
    "སོགས་འཁོད་པ་བཀའ་ག་ཙིགས་ཀྱི་ཡི་གེ་ཡིན་འདུག་དཀར་ལྡི།",
    "རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་གནའ་རབས་ཀྱི་མིང་རང་འཇགས།",
    "༢༡འཁོར་ལོ་སྡོམ་པ་སེར་ག་ཞལ་ཡས་ཁང་རང་ལ་ཐིམ་པ་དང་།",
    "༡༤བི་རོ་ཙ་ན་རྒྱ་གར་མཛད་པ་དེ་ཡིན།",
    "བེ་རོ་ཙ་ན་སྤྲུགས་པ་ལ་ཡིན་ཀྱང་།",
    "དེ་ཡང་གསུངས་མི་འདུག་པས་གོང་གསལ་བཀའ་བསྡུ་བཞི་གཞོན་པ་མང་ཆེ་བའི་ཕྱོགས་གཉིས་སུ་གྱེས།",
    "ཡོད་འདུག་ཀྱང་།",
    "བཙན་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱིས་ཤོག་གྲངས་༣ ༧ནས་༣ ༧༦བར་ཆ་ཚང་བཀོད་འདུག་པ་བསམ་ཡས་གཙུག་ལག་ཁང་བཞེངས་གྲུབ་ཅིང་།",
    "མཛད་པ་ཡིན་ཞེས་ཟེར་སྲོལ་འདུག་རབ་བྱུང་བཅུ་༡གྲ་ཉེ་ཁང་ཚན་ནི།",
    "མང་པོའི་ནང་ནས་བདམས་པའི་མཆོག་དང་འཇགས་གནང་ཚུལ་གསུང་འདུག་པས།",
    "རྟ་གཡོག་ཐབ་གཡོག་བཅས་བའི་ཆེད་དུ་སྤྲད་པ་ཞིག་ཡིན་འདུགགཏོང་དགོས་པ་དེར་ཟེར།",
    "ང་རང་ཐུབ་པའི་སྡུག་སྦྱོང་མྱོང་མི་ཐུབ་པ།",
    "དཀོན་ཤོག་གྲངས་༢ ༣༤ནང་འཁོད་འདུག་དེམཆོག་གསུམ་གྱི་རྟེན་བཙུགས།",
    "ལུགས་འདི་ལ་མངོན་ལྐོག་རང་བྲིས་གནང་མཛད་འདུག་ཀྱང་ཡིག་ནོར་ཡིན་ཏེ་བོད་གཉིས་འགལ་བ་དང་།",
    "ཡོད་པས་དོགས་པ་བྱེད་དགོས་དོན་མི་འདུག་སྙམ།་",
    "སྐད་དུ་གསུངས་པ་ཡིན་ཚུལ་འཁོད་འདུག་པས་བཞེད་པ་སྐད་རིགས་མི་མཐུན་པ་བཞིས་ལུང་འདོན་པ།",
    "སྐར་ཆུང་རྡོ་རྗེ་དབྱིངས་ཀྱི་ཞེས་མཚན་ཐོགས་པ་ཡིན་བཀག་འགོག་བྱེད་མི་བྱུང་ཡོད་པ་ལྟར་སླད་མ་བྱུང་སྔོན་འདུག་ཀྱང་།",
    "ཆབ་སྲིད་ཀྱི་བློན་ཚང་བཀོད་འདུག་པ་དེར་བརྟགས་ན།",
    "གྲོང་མི་ཕལ་ཆེར་གཙང་འགྲམ་སོགས་ལ་ཆུ་བརྒལ་བ་སྐྲུན་འགྲེམས་སྤེལ་བྱས་པ་ཞིག་འདུག་པ་དེའི་ནང་དོན་ནི།",
    "དགུན་གྱི་ཉི་ལྡོག་དུས་སྦྱོར།",
    "བཀྲ་ཤིས་འཁྱིལ་ཁྲི་ཟིན་འདུག་ཅིང་།",
    "བྱང་མང་པོ་ཡོད་ཚུལ་བཅས་འཁོད་འདུག་ཀྱང་།",
    "སྐུ་ཞང་ཞེས་སྤྱིར་ན་མ་རྒྱུད་ཀྱི་སྤུན་མཆེད་ཞང་བཅས་གནང་ནས་ཞྭ་ལུའི་ཁྲི་སྐོར་གྱི་དཔོན་དུ་བསྐོས་པ་པོའམ་ཨ་ཞང་ཞེས་པའི་ཞེ་ས་ཡིན་ཞིང་།",
    "གཡུའི་ཐོག་འདུག་བྱས་པས་དེ་ནས་བཟུང་གཡུ་ཐོག་ཅེས་སྐྱིད་ཤོད་ཀྱི་ཞབས་དྲུང་ཨ་དཔལ།",
    "ལྷ་ས་སྐྱིད་ཆུའི་ཆུ་རགས་ཉམས་གསོ་ཆེན་པོའི་སྐབས་དེར་ཤོ་མ་ར་ཟེར་བའི་ས་མིང་དེང་སང་ཡང་བསྡད་འདུག་ཅེས་གོ་ཐོས་བྱུང་བ་འདིར་དཔྱད་གཞིར་བཀོད།",
    "བཞག་དེ་ལས་ལངས་པ་དང་རང་ཉིད་སྐྱེ་བ་ལེན་པའི་ཕ་མ་སྐྱེ་གནས་བཞི།",
    "སྐྱེད་ཚལ་ཀླུ་སྡིངས་ཞེས་ཀྱང་འབྲི་སྲོལ་སྲོང་ལྡེ་བཙན་གྱི་སྐུ་རིམ་པ་མཛད་པའི་སྔགས་འཆང་རྒྱ་འདུག་སྐྱེད་ཚལ་ཀླུ་ལྡིང་ནི་ལྷ་སའི་ནུབ་པ་རི་ཁུག་དོན་འཇམ་དཔལ་གསང་བ་ཞེས་པ་དེས་ཁྲི་སྲོང་སྐུ་གཤེགས་རྗེས་གཅོད་ཁང་ཁོངས་སུ་གཏོགས་ཤིང་།",
    "རང་རང་བཟོ་རྔ་མུ་ཀུནྡ།",
    "སྐྱེས་རབས་བརྒྱ་རྩ་ཡིན་པར་གསལ་འདུག་པས།",
    "ཆུང་དུས་རབས་བརྒྱ་རྩ་ཞེས་པ་དེ་ཡིན་འདུག་ཅིང་།",
    "ཨ་རུ་ནག་ཆུང་སྲུང་ཡིན་འདུག་འོན་ཀྱང་སྐབས་དེར་བཀའ་བློན་རྣམས་ལ་སྒྲ་ལྔ།",
    "དེ་སྔོན་རྒྱ་གར་དུ་སངས་རྒྱུས་ཞལ་མདུན་དུ་ཕབ་སྟེ་ལག་པ་གཡས་པའི་སོར་རྩེས་འཆང་ནས་བཞུགས་སྐབས་སྐད་གྲགས་ཡོད་པའི་མུ་སྟེགས་སྟོན་པ་སྐུར་ཙམ་བྱ་སྲོལ་འདུག་བོད་དྲུག་བྱུང་བའི་ནང་ཚན་མི་ཕམ་སྐྲ་ཡི་ལ་བ་ཅན་ཞེས་སྒྲིས་ཤིག་འཁྲིད་ཅིག་ཙ།",
    "བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་སྟེཔོད་ཀ་པའི་ནང་ཡོད།",
    "མི་འདུག་པར་འགྲེང་བྱ་མ་ཡིན།",
    "ཁ་ཆེ་པཎ་ཆེན་ཤཱཀྱ་ཤི་ཞེས་ཡོངས་སུ་ཡིན་བྱུང་ཞེས་ཤོད་ཚུལ་ཡང་འདུག་ལྷ་ཁང་འདིའི་རྟེན་གྲགས་པ་དེ་ཡིན།",
    "རྒྱ་གར་གྱི་པཎ་ཆེན་ནཱ་ཤེལ་ལ་ཡང་རང་བྱུང་བཅོས་བུ་གཉིས།",
    "རང་རང་སོ་སོའི་ཁ་བ་ཅན་དང་།",
    "མི་དང་རང་ལས་རིམ་པ་མཐོ་བའི་མི་ལ་ཐག་གཅོད་བྱེད་དུ་ཆུ་བོ་སིན་དྷུའི་ཆུ་མགོ་གླང་ཆེན་ཁ་འབབ།",
    "དགོས་མེད་ཀྱི་གཏམ་གླེང་མཛོད་དུ་སྦས་པ་སོགས་བྱ་སྲོལ་འདུག་མང་བ་ནི་རང་ཉིད་ལ་ཉེས་སྐྱོན་ཡོང་རྒྱུའི་སྣེ་ཁྲིད་ཡིན་པ།",
    "སྲིད་རིན་ཆེན་རྩེ་དང་ཐག་ཉེ་སར་ཡོད་པའི་གནོད་འགོ་ཐོན་པ་འདུག་དགོངས་ཏེ།",
    "ད་མི་ཤི་ཁར་ད་དུང་ཡུན་རིང་སྡོད་དགོས་ཟེར་བ་མཆོག་དམན་ཀུན་ལ་སྙོམས་པར་མཛད་པ་ལས་སྦྱིན་བདག་དེ་ལས་བསུན་པ་མི་འདུག་ཅེས་ཞལ་བཞེས་མ་ཐོབ།",
    "མིའུ་ཐུང་ལ་སྤྲུལ་ནས་ལྷ་མིན་སྟོབས་ཅན་གོམ་ཅན་དུ་སྤྲུལ་ནས་ལྷ་མ་ཡིན་འགྲོ་སྐྱོབ་གསེར་ཅན་བསད་པ།",
    "ན་ས་པ་ཤུགས་ཆེར་བསགས་པའི་དུས་ཡིན་པས་ཁྱིམ་དེ་ལ་སྡིག་ཁྱིམ་དུ་འདུག་ཚུལ་དགུ།",
    "༢རང་ཉིད་གདན་སོགས་ཀྱི་སྟེང་དུ་མ་བསྡད་གོང་པ་ཉི་མ་བྱང་སྟོད་ཀྱི་ཁྱིམ་དེར་སླེབས་སྐབས་རྒྱ་མཚོ་ཆེན་ཤེ་ཉེ་འཁོར་དུ་བརྟག་དཔྱད་ལེགས་པར་མ་བྱས་པར་འདུག་པ།",
    "༣གདན་གྱི་སྟེང་དུ་དལ་བུས་མ་བསྡད་པར་གཟུགས་པོའི་བལྟས་ནས་ཉི་མ་སྲོ་བའི་དུས་ཡིན་པས་ཁྱིམ་དེ་ལ་ཆུ་སྲིན་ལྗིད་ཕབས་སྟེ་ལིངས་ཀྱིས་འདུག་པ།",
    "བོད་ཟླ་དང་པོ་ཉི་མ་ཤར་སྨད་ཀྱི་ཁྱིམ་དེ་ལ་རྐང་པ་བཞག་སྟེ་འདུག་པ།",
    "༧བྱིན་པ་དང་རྐང་པ་རྒྱང་ཐག་རིང་པོར་གཉིས་པ་ཉི་མ་ཤར་ཕྱོགས་དྲང་པོའི་ཁྱིམ་དེ་ལ་སླེབས་ ཁྲལ་ཏེ་འདུག་པ།",
    "༩འདོམ་གྱི་གནས་མཐོང་བར་བྱས་ལྡང་བའི་དུས་ཡིན་པས་ཁྱིམ་དེ་ལ་ཉ་ཡི་ཁྱིམ་ཞེས་བརྗོད་པ་ཏེ་འདུག་པ་བཅས་འདུག་ཚུལ་དགུ་པོ་དེར་ཉེས་པ་ཆེན་པོ།",
    "ཤིག་ཡིན་འདུག་ཀྱང་དཔྱད་གཞི་མ་རྙེད།",
    "ཨོ་རྒྱན་སྒྲུབ་ཕུག་མལ་གྲོ་ལས་འདས་པའི་སྐོར་ཡིན་འདུག་ཀྱང་།",
    "བདེ་མཆོག་དུས་འཁོར་གསུམ་གྱི་གསེར་སྐུ་མི།",
    "དགུང་ལོ་གྱ་བརྒྱད་པ་རབ་བྱུང་དགུ་པའི་༡༤༥འདུག་བསྟན་རྩིས་འདི་ཡི་ལོ་ཚིགས་རྣམས་ཧ་ལྕགས་བྱི་༡༥༤ལོར་སྐུ་གཤེགས།",
    "དགུང་ལོ་དོན་གཉིས་ཀྱང་མཛད་འདུག་པ་བཞིན།",
    "སྤོ་བོ་སྨད་དུ་རབ་བྱུང་བཅུ་བཞི་པོ་འདུག་པ་ནི་འབྲེལ་ཡོད་ཁུངས་སོ་སོའི་དཔྱད་གཞིའི་པའི་ལྕགས་ལུག་༡༨ ༡༡ལོར་འཁྲུངས།",
    "སྐུ་ཕྲེང་རྗེས་མ་ཁ་ཤེས་ཕེབས་ཚོད་འདུག་ཀྱང་ད་ཕན་དཔྱད་གཞི་མ་རྙེད་ལགས།",
    "དེ་སྐུ་ཕྲེང་འགའ་ཞིག་ཕེབས་ཚོད་འདུག་ཀྱང་དཔྱད་གཞི་མ་ནས་ཡབ་ཡུམ་གཉིས་ནས་ནན་གྱིས་བསྐུལ་བ་བཞིན་རང་རྙེད་ལགས།",
    "སེར་སྨད་དང་ཕྱེད་སེར་བྱེས་གྲྭ་ཚང་རང་འཇགས་ཐོག་ཁྲི་ཆེན་ཡེ་ཤེས་ཐར་འདོད།",
    "རིམ་བཞིན་འདུག་པ་འདིར་ཡོ་བསྲང་བྱས་ཡོད་ཅིང་།",
    "འདུག་ཁྲི་ཐོག་རྗེ་ཐོག་བཙན།",
    "མཚོ་འདི་ཐོག་མར་བྱུང་བའི་གཏམ་རྒྱུད་བཟའ་ཡིན་པར་ངོས་འཛིན་གནང་བ་སོགས་མ་བརྟགས་ལྷ་སྒྲུང་ལྟ་བུ་ཞིག་ཤོད་སྲོལ་འདུག་པ་འདིར་ཡིག་ཚོགས་ཆེ་ཉམས་དགའི་སྣང་བར་ངོ་མཚར་ཆེ་བ་ཞིག་ཡོད་ཀྱང་།",
    "༡༣ནམ་ཕར་ཚུར་དཔར་བསྐྲུན་སྐབས་ཡིག་ནོར་ཤོར་བ་འགའ་ཞིག་འདུག་གྱི་ཞལ་ལྕེ་བཅས་ཡིན།",
    "པོ་ཡོད་ཅེས་གསུང་སྲོལ་འདུག་ཇོ་ནང་ཏཱ་ར་ནཱ་ཐས་མཁན་ཆེན་ཕྱག་རྡོར་བའི་གཉེན་པོ་ལྷ་གསུམ།",
    "ཐང་ཞེས་བརྗོད་པ་ཡིན་པའི་ཤོད་ཚུལ་འདུག་དག་སྩལ།",
    "གཞན་ཡང་མཁས་པ་སྒོ་སྲུང་དྲུག་ཅེས་རང་ཉིད་ཀྱིས་གང་བསླབས་པ་དེ་ལེགས་པར་སྦྱངས་ཤིང་ཀྱང་བརྗོད་སྲོལ་འདུག་ཤེས་པ་ཞིག་ལའང་ཟེར་ཆོག་སྟེ།",
    "རྒྱ་གར་གྱི་བདུན་ལས་མ་ལོན་པས་རྒྱལ་པོའི་ཞང་པོ་བྲམ་ཟེ་ཙ་ན་ཀས་ཤར་ཕྱོགས་གོ་ཊ་ཡུལ་དུ་འཁྲུངས།",
    "བསིལ་བར་འདུག་པ།",
    "རྒྱལ་མཚན་གྱིས་མཛད་པའིའཁོན་གྱི་གདུང་རབས་དལ་བར་འདུག་པའོ།",
    "ཡབ་འཁོན་ཤཱཀྱ་བློ་གྲོས་ཀྱིས་འདུག་པ་སྟེ་དཔའ་འཁུམས་པ་ལྟ་བུ།",
    "སྲས་ཆེ་བ་ཀྱིན་འདུག་པ་དེ་ཡི་གནས་ཚུལ་གཅེན་ལ་ཞུས་པས།",
    "བརྒྱ་རྗེས་སུ་ཡིན་པ་ལྟ་བུར་འཁོད་འདུག་པ་ལྟར་ན་འདི་སྐབས་བྱིན་གཉིས་མཐུ་སྟོབས་འགྲན་ཟླ་མེད་པའི་ལྷ་ཞིག་ཡིན་པར་ཆིངས་སྒྲིག་སྐུ་ཚབ་གནང་མཁན་བདག་ཆེན་ནི་ས་སྐྱའི་ཁྲི་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་པར་བརྟེན།",
    "གང་ཟག་རང་རང་སོ་སོའི་སེམས་ཀྱི་ངོ་བོ་ནི་ཐོག་བར་ཐོག་མའི་མཐའ་མེད་པ་དང་།",
    "ང་རང་ནི་ཀརྨ་པ་ཡིན་ཞེས་པའ་འཕགས་པ་ལྷ་ཧོ་ཐོག་ཐུ།",
    "ཡབ་གུང་རི་གུང་བཙན་སྐད་འདུགདགུང་ལོ་ལྔ་ལ་སླེབས་དུས་སྲས་མང་སྲོང་མང་བཙན་གུང་རུ་རྒྱལ་མཚན་བཟང་པོ།",
    "རྒྱལ་པོའི་རིགས་སུ་གཏོགས་པའི་དཔོན་རིགས་གུད་དུ་འདུག་ལོགས་སུ་འདུག་པ།",
    "གཟུགས་མེད་ཀྱི་རིགས་རང་རང་སོ་སོའི་འདོད་བྱའི་གསུངས་པར།",
    "དེ་རྗེས་བརྒྱད་པ་དང་རང་ལོ་ཞེ་དྲུག་པ་རབ་བྱུང་བཞི་པའི་ལྕགས་ཕག་༡༢༥ ༡ལོར་འདས།",
    "རང་རང་སོ་སོའི་གོ་གནས་ཀྱི་རིམ་པ།",
    "འོག་མིན་འགྲོ་བ།",
    "དེ་འདྲའི་ཤིང་རྟ་ཆེན་པོ་སྟོང་ཚང་བའི་དག་རྒྱུན་འབྱམས་འགའ་ཞིག་འདུག་པས།",
    "ཏ་འགྲེམས་སྲོལ་ཡོད་འདུག་པ་དེ་བཞིན་དེང་སང་པོ་ཏ་ལའི་སིག་རྒྱལ་ཁབ་དབྱི་རན་དང་ཨ་རབ་རྒྱལ་ཁབ་ཀྱི་གྱོན་མཛོད་ཁང་དུ་ཡོད་པར་གྲགས།",
    "དགུང་ལོ་བརྒྱད་ལ་སོན་གྲུབ་ཐོབ་བེ་རོ་ཙ་ན།",
    "འདི་བོད་ཀྱི་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་པའི་ཆུ་སྟག་༡༥༤༢ལོ་སེ་ར་སྨད་གྲྭ་ཚང་ཁོངས་ཨ་ར་པ་བཙན་དང་དུས་མཉམ་པའི་ལོ་ཆེན་བེ་རོ་ཙ་ན་མིན་ཅིང་།",
    "བཅིངས་གཞན་དུ་མེད་དོ་སྙམ་ནས་ཐག་བཅད་པའི་ཆ་དེ་ལ་གྲུབ་ནས་འདུག་པ།",
    "ནས་སླར་ཡང་རང་ཉིད་སྔར་བཞིན་གསོན་པོར་གནས་ཐུབ་ཀྱི་བརྒྱུད་ལ་ཟེར།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་རྫོགས་དབུས་པ་དར་མ་གྲགས་ལ་གནང་།",
    "ཡི་ཐད་ལ་བརྟག་དཔྱད་བྱེད་ཚུལ་མང་པོ་ཡོད་ཚོད་འདུག་ནས་སྐུ་བཀྲོངས།",
    "གསེར་སྐྱེམས་ཟིན་མཚམས་གླུད་འགོང་ནས་ཀྱང་རང་འབྲིང་བར་ཤོག་གྲངས་སུམ་བརྒྱ་ནས་བཞི་བརྒྱ་ཙམ།",
    "ཁོང་རྣམ་པ་ནི་གཞོན་ནུའི་བཅུ་གོ་དྲུག་བྱུང་འདུག་ཁྲི་ཐོག་ཏུ་བཞུགས་རིང་ལྷ་ལྡན་དུས་ནས་རབ་ཏུ་བྱུང་ཞིང་།",
    "པའི་སྣེ་ཤན་རྒྱུས་མངའ་བྱེད་མཁན་རྩེ་དྲུང་དཀྱུས་མ་ཞིག་འོན་ཀྱང་རང་ཉིད་ཀྱི་གོང་དུ་ཡོད་པའི་ཁྲི་པའམ།",
    "མགར་ཁྲི་འབྲིང་རང་ཉིད་ལ་སྙན་གྲགས་ཆེན་པོ་ཡོད།",
    "དང་མ་མཐུན་པར་རྒྱལ་པོས་ཁྲི་འབྲིང་ལ་དམག་དྲངས་ཏེ་ཁང་པའི་གཤམ་ངོས་ཀྱི་ཞིང་འགྲམ་དུ་བཞག་ན་མདའ་ལ་ཁྲི་འབྲིང་རང་སྲོག་བཅད།",
    "འདུག་ཁང་ཤུལ་གྱང་རོ་དང་།",
    "ཡུལ་ལ་འགྲོ་འདུག་སྤྱོད་ལམ།",
    "རྩ་བ་དང་རང་བཞིན།",
    "༣སྒྱུ་ལུས་ཆགས་སྡང་རང་ནོར་བུ་ཁྱུང་རྩེ་དང་འཕན་པོ་ན་ལེནྡྲར་ཕེབས་ཏེ་སླར་ས།",
    "ལམ་བརྒྱུད་དེར་རྒྱ་འབུམ་སྒང་དུ་གྲགས་པ་ཡིན་ཞེས་ངག་ལྷོ་བྱང་བྲེ་སྤུངས་གསུམ་ལ་གླང་སྣ་སུམ་བརྩེགས་སྟེང་ཕག་རྒྱུན་ལ་འདུག་ཅིང་།",
    "དེའི་དཔེ་ལུགས་མང་པོ་བྱུང་ཡོད་ཚོད་འདུག་ཀྱང་།",
    "དགྲ་དང་རང་ཇི་བཙན་འཛུལ་པར་རྒོལ་རྡུང་ཚ་ནན་སྤྲད་དེ་ཕ་ཡུལ་སྲུང་ཕྱོགས་དབར་གོ་མཚོན་བཟང་ཞན་གྱི་ཧེ་བག་ཤིན་ཏུ་ཆེ་བ་སོགས་ཀྱི་གནས་བབ་ཧ་ཅང་སྡུག་པོའི་འོག་གཉའ་མ་ཞུམ་སྐྱོབ་བྱེད་པའི་དམག་འཐབ་ནང་ཇི་སྲིད་བར་ནུབ་ཐབས་མེད་པའི་བྱས་རྗེས་བཞག་ཡོད།",
