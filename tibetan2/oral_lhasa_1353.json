    "ཕ་རོལ་ནས་ཡུན་རིང་ཙམ་ལ་ཁ་མི་གྲགས་པར་བསྡད།",
    "དོན་དེ་ཕ་རོལ་བོའི་བསམ་ཡུལ་ལས་འདས་པ་ལྟར་གྱུར་ཅིང་ཐེ་ཚོམ་ཅི་ཡང་མེད་པར།",
    "གཉིད་མ་ཁུགས་པར་ནམ་གུང་ཙམ་ལ་གཞི་ནས་གཉིད་པར་གྱུར།",
    "ནམ་རྒྱུན་རླངས་འཁོར་ཆུང་བར་བསྡད་ནས་ཡུལ་དུ་ཡོང་དུས་མི་ཚང་མས་ཡིད་སྨོན་བྱེད་ཀྱིན་པ་མིན་ནམ།",
    "ཚེ་སྐྱིད་ཀྱིས་ཁོ་གཉིས་ལ་ཁ་ཡ་བྱེད་མ་ཕོད་པར་ལྭ་བ་ཁོ་ནར་བལྟས་ནས་བསྡད།",
    "ཚེ་སྐྱིད་ཀྱིས་མུ་མཐུད་དུ་ཚོང་བདག་མར་རིན་གོང་གཏམ་མ་ཕོད་པར།",
    "ཚེ་སྐྱིད་དང་ཐོག་ཁ་སྐྱེངས་པའི་ཚུལ་གྱིས་དགོད་ཙམ་བྱས་ཤིང་།",
    "དོན་གྲུབ་ཀྱིས་ངུ་དགོད་ཅིག་བྱས་ནས་མགོ་བོ་འཕྲེད་དུ་གཡུག་བཞིན།",
    "ཚེ་སྐྱིད་ཀྱི་དབུགས་སྟོད་དུ་འཚངས་བྱུང་ཡང་འགོག་རྒོལ་ཅི་ཡང་བྱེད་མི་ཕོད་པར་དེ་མུར་ངོ་མདངས་དམར་བོར་གྱུར་ཏེ་མགོ་བོ་དུད་ནས་བསྡད།",
    "ང་དང་ཆུང་མ་གཉིས་ལོ་བཅུ་ཙམ་ལ་ལྷན་དུ་བསྡད་ཀྱང་།",
    "ཚེ་སྐྱིད་ཀྱིས་ཁོ་ལ་ལན་མི་གདབ་པར་ཤབ་ཤུབ་ངང་བགད།",
    "ཚེ་སྐྱིད་ཀྱིས་འཛུམ་ཤིག་ཤིག་ངང་མགོ་ནང་དུ་ལྡེམ་ཙམ་བྱས།",
    "མི་ཚང་མས་ཧ་ལས་དང་ཡ་མཚན་གྱི་རྣམ་འགྱུར་སྣ་ཚོགས་བསྟན་ནས་འདི་ནི་དོན་དངོས་ཡིན་པར་ད་དུང་ཡིད་ཆེས་བྱེད་མི་ཕོད་པ་ལྟར་ཕན་ཚུན་ལ་འདྲི་བ་དང་གླེང་བར་བྱེད།",
    "འདང་རྒྱག་མི་དགོས་པར།",
    "དོན་གྲུབ་ནི་སྔར་བས་ཀྱང་ཐེ་ཚོམ་གྱི་རྒྱར་ཚུད་པར་གྱུར་ནས།",
    "ཚེ་སྐྱིད་ཀྱིས་མུ་མཐུད་དུ་སེམས་འགུལ་དྲག་པོ་གནོན་མ་ནུས་པར་དེ་མ་ཐག་ཏུ་དོན་གྲུབ་ཀྱི་མགྲིན་པར་འཁྱུད།",
    "སྟོན་ཁར་ཞིང་འབྲེག་པ་དང་ཤོག་སྐྱེལ་བ་སོགས་ཀྱང་བྱེད་ཐུབ་པར་མ་ཟད།",
    "ནས་སླར་ཡང་མིག་ཟུང་ཟུམ་ནས་གཉིད་རྩིས་བྱས་བྱུང་ན་ཡང་།",
    "དོན་གྲུབ་ཀྱིས་ཁོང་དགོད་ཅིག་བྱས་ནས་སྔོན་ལྟར་མིག་མི་འབྱེད་པར།",
    "ངུ་དགོད་ཅིག་བྱས་ནས་ད་ནི་དེ་ཁོ་ན་ཡིན་མིན་ལ་རྩད་གཅོད་བྱེད་དོན་ཅི་ཞིག་ཡོད་དམ་ཟེར་ནས་ཅུང་སེམས་མི་སྐྱིད་པར་གྱུར་ཏེ་འདས་པའི་དོན་དག་ཡོད་ཚད་ད་ལྟ་རང་ཉིད་དང་འབྲེལ་བ་ཅི་ཡང་མེད་པ་ལྟ་བུའི་རྣམ་འགྱུར་ཞིག་བསྟན་ནས་བསྡད།",
    "ཚེ་སྐྱིད་ཀྱིས་ཁོའི་སྐད་ཆའི་ཧ་མ་གོ་བར་མགོ་བོ་རྨོངས་པར་གྱུར།",
    "དོན་གྲུབ་ཀྱིས་ཡང་བསྐྱར་ངུ་དགོད་ཅིག་བྱས་ནས་མགོ་བོ་འཕྲེད་དུ་གཡུགས་ཀྱིན་དུ།",
    "ཚེ་སྐྱིད་ཀྱིས་མུ་མཐུད་དུ་སྐད་ཆ་འདྲི་མི་ཕོད་པར་གྱུར།",
    "ཚེ་སྐྱིད་ཀྱིས་ཟས་སྣོད་དག་ཉར་ཚགས་བྱས་ཤིང་ཁྱིམ་ནང་ཡོངས་ལ་གད་བདར་གཙང་མ་ཞིག་བྱས་རྗེས།",
