    "རྡོ་རྗེ་དང་པདྨ་དག་གི་སྣ་དག་ལས་འོད་ཟེར་བྱུང་ཞིང་།",
    "གྱེན་དུ་སོང་སྟེ་རབ་ཏུ་གྲགས་པའི་སྣའི་རྩེ་མོ་ནས་རྒྱུའོ།",
    "ཁམས་ཀྱི་དཀྱིལ་འཁོར་གཅིག་གིས་ཁམས་བཞི་རྣམས་ལ་ཁྱབ་པའོ་ཞེས་ས་སོ།",
    "ནང་གི་དུས་ནི་ཡིན་པར་འདོད།་།",
    "དཀྱིལ་འཁོར་རེ་རེ་ལ་ནི་གང་ན་གཅིག་ཡིན་པ་དེ་ན་བཞི་རྣམས་སོ་ཞེས་པའི་རིག་པ་ལས་གཞན་པའི་ལས་གསུམ་ཕལ་བའོ་ཞེས་ཐུན་ཕྱེད་ཀྱི་དཀྱིལ་འཁོར་སོ་སོ་ལ་གཙོ་བོའི་ཏྲ་ལས་གཉིས་གསུངས་ཤིང་།",
    "དུས་ཀྱི་འ་ཁོར་ལོར་བསྟན་པ་རྒྱུད་གཞན་དང་མི་འགལ་བའི་དོན་གྱི་ཆ་འགའ་ཞིག་གི་ནི་ཁོ་བོས་རང་གཞུང་གི་ཕྱོགས་རྣམས་སུ་རྗེས་སུ་འབྲང་ཞིང་།",
    "གདུལ་བྱ་འགའ་ཞིག་གི་བསམ་པའི་རྗེས་སུ་འཇུག་པས་འགལ་བའང་ཁ་ཅིག་སྤངས་ས་སོ།",
    "ཞེས་པ་འདི་ལ་མན་ངག་གིས་ཉིན་མཚན་སོ་སོར་ཐུན་ཚོད་ཕྱེད་པ་སོ་སོ་ལ་བཞི་རྣམས་སོ་ཞེས་པས་ཐུན་ཚོད་ཕྱེད་པ་ཉི་ཤུ་རྩ་བཞི་རྣམས་ཀྱིས་ཁམས་བཞིའི་དཀྱིལ་འཁོར་རྣམས་ཏེ།",
    "མི་ཕྱེད་མ་ལ་སོགས་པ་རྩ་སུམ་ཅུ་རྩ་གཅིག་རྣམས་སུ་དབུགས་སུམ་ཅུ་རྩ་གཅིག་གི་རྗེས་སུ་བདུད་འདྲལ་མ་ཞེས་བྱ་བ་དུས་ཀྱི་རྩར་དབུགས་རེ་རེ་རྒྱུ་བའི་ཕྱིར་དང་ལྷག་མ་གཅིག་གི་ཕྱེད་རྒྱུ་བའི་ཕྱིར་རོ། ༐",
    "ངག་གི་བ་ཞེས་པ།",
    "ཕལ་ཆེར་ཁུ་བ་འོག་ཏུ་འབབ་པའི་ཕྱིར་འོག་གི་སྒོ་སྟེ།",
    "ར་ས་ནཱ་ནི་སྡུད་པ་མོ་ཕལ་ཆེར་གྱེན་དུ་ཁྲག་འབབ་པའི་ཕྱིར་སྟེང་གི་སྒོའོ།",
    "གང་གི་ཕྱིར་དེ་རྣམས་ཀྱི་འོག་ཏུ་ལྟེ་བའི་ཆུ་སྐྱེས་ལ་རྣམ་པར་གནས་ཤིང་སྟེང་དུ་འགྲོ་བ་ན་ནི་གཤེགས་སུ་གསོལ་བ་སྟེ།",
    "དེའི་རང་གི་ངོ་བོའི་འགྲོ་བ་ནི་ཉིན་མོ་དང་མཚན་མོར་རོ།",
    "གང་གི་ཕྱིར་ལྷན་ཅིག་སྐྱེས་པར་གནས་ཤིང་འགའ་ཞིག་གི་འབད་པ་མེད་པར་༡ཡང་སྔ་མའི་ལས་ཀྱི་སྤྲུལ་པ་ལས་གྲུབ་པ་སྟེ་རྫོགས་པ་རྣམས་སོ།",
    "འཇུག་པ་ནི་འོག་གི་སྒོ་སྟེ་དེ་ལ་ཞོན་པའི་སེམས་འགྲོ་བ་དང་འོང་བའི་ཐབས་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ངག་རྣམས་ཀྱི་ཡང་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་ངག་གི་བའོ།",
    "དེ་ཁོ་ན་དཀྱིལ་འཁོར་གྱི་དབྱེ་བ་དང་ངག་གི་རྒྱུད་ཉིད་དུ་བརྗོད་པར་མི་འདོད་པས་སེམས་ཁོ་ནའི་སྒོ་རྣམ་པ་གཉིས་ས་ཞེས་པ་ཡིད་ཀྱི་བའོ།",
    "ལ་ལ་ནཱ་དང་ར་ས་ནཱ་དག་ནི་རིམ་པ་ཇི་ལྟ་བར་ཕལ་ཆེར་ཁུ་བ་དང་རྡུལ་དག་འོག་དང་སྟེང་དུ་འབབ་པའི་ཕྱིར་འོག་ད་ང་སྟེང་གི་ཡིད་ཀྱི་བའི་སྒོ་ཉིད་དུ་བརྗོད་དོ།",
    "ར་ས་ནཱ་ནི་ཅུང་ཟད་ཁུ་བ་དང་ཤས་ཆེར་ངག་ཅེས་བྱ་བ་དང་རྡུལ་དང་ཉི་མ་འབབ་པའི་ཕྱིར་ངག་གི་དང་༡རྡུལ་གྱི་དང་ཉི་མའི་དང་ཤེས་རབ་ཀྱི་རྩ་ཞེས་པར་ཏེ་ཕལ་ཆེར་རོ།",
    "ཨ་ཝ་དྷཱུ་ཏཱི་ནི་ཤས་ཆེར་ཁུ་ཁྲག་དང་སེམས་དང་མུན་པ་དང་སྒྲ་གཅན་འབབ་པའི་ཕྱིར་སེམས་ཀྱི་དང་མུན་པའི་དང་སྒྲ་གཅན་གྱི་དང་མ་ནིང་གི་རྩ་ཞེས་པར་རོ།",
    "ཉིན་དང་མཚན་མོའི་གཟུང་བར་བྱ།",
    "དབྱུ་གུ་གཉིས་པ་ལ་ཡིད་ཙམ་མ་མོ།",
    "ཐམས་ཅད་འདོད་པ་ནི་རྩ་གསུམ་རྣམས་སུ་ཉིན་མཚན་གྱིས་དྲུག་བརྒྱ་ལྷག་པའི་སྟོང་ཕྲག་ཉི་ཤུ་རྩ་གཅིག་གི་ད་བུགས་རྣམས་སུ་འགྱུར་རོ་ཞེས་པའོ།",
    "དེ་རྣམས་ཁོ་ན་བགྲང་ཕྲེང་གིས།",
    "ཁྱོད་ཀྱི་ནི་ཉིད་ཀྱིའོ།",
    "རྒྱབ་ཀྱི་སྟོད་ནི་རྒྱབ་ཀྱི་དབུས་ལས་སྟེང་གི་སྒལ་ཚིགས་ཀྱི་སྟེང་གི་ཆ་སྟེ།",
    "ཞེས་པ་སྨིན་མ་དག་གི་དང་མིག་དག་གི་དབུས་ན་གནས་པའི་ཆའོ།",
    "མིག་དག་གི་ཞེས་པ་མིག་གཉིས་ནི་དེ་ཝཱི་ཀོ་ཊའོ།",
    "ཐུགས་ཀྱི་འཁོར་ལོར་ཞེས་པ་མགོ་བོ་ལ་སོགས་པ་རྣམས་དང་མ་ལ་ཡ་ལ་སོགས་པ་ནང་ད་ང་ཕྱིའི་ཡུལ་རྣམས་སེམས་ཀྱི་རང་གི་ངོ་བོར་ཐ་སྙད་བྱས་སོ།",
    "གཞན་གྱི་དོན་དུ་དེ་ལ་སྤྱོད་པའི་ངང་ཚུལ་ཅན་མཐོ་རིས་སུ་སོན་པའི་རྡོ་རྗེ་ལྷ་མོ་རྣམས་ཀྱི་འོ།",
    "ས་ནི་ས་གཞི་སྟེ་ངག་གི་ཐ་སྙད་ཀྱི་རྟེན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "སོར་མོ་ཞེས་པ་རྐང་པ་ལ་སོགས་པའི་སོར་མོ་རྣམས་སོ།",
    "གསེར་གླིང་ནི་འཛམ་བུའི་༢གླིང་གི་ནང་དུ་གཏོགས་སོ།",
    "རང་གི་ལུས་སྐྱེས་ཞེས་པ།",
    "རང་གི་སེམས་ཀྱི་སྣང་བ་ཙམ་སྒྱུ་མའི་རང་བཞིན་འགྲོ་བའོ་ཞེས་དགོངས་པའོ།",
    "འདི་ཉིད་ཀྱི་ཕྱིར་འདི་རྣམས་སུ་སྟེ་རང་བཞིན་གྱི་འཁོར་ལོ་གསུམ་དུ་རྣམ་པར་གཞག་༡པ་རྣམས་སུ་རྡོ་རྗེ་ལྷ་མོ་རྣམས་བཞུགས་པའོ།",
    "རྩའི་ངོ་བོ་རྣམས་ཀྱང་ལྷ་མོ་སྟེ་ཕྱག་ལ་སོགས་པ་རྣམས་དང་ལྡན་པ་ལྷ་མོའི་གཟུགས་རྣམས་ཀྱང་རྩའོ་ཞེས་ཁྱད་པར་མེད་པ་རྟོག་པར་བྱེད་པ་ལྷུར་ལེན་པའོ།",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་ཉི་ཤུ་གཅིག་པའོ།་",
    "གཏུམ་མོ་འབར་བའི་དུས་ནའོ།",
    "ཅུང་ཟད་དབྱེ་བའི་ཁ་ཅན་ཉིད་ཀྱིས་ན་ཆུ་ཤིང་གི་མེ་ཏོག་ལྟ་བུའོ།",
    "ཇི་ལྟར་རྒོད་མ་ཁའི་མེ་རྒྱ་མཚོ་མ་ལུས་པའི་ཆུ་ལ་སོགས་པ་ཁམ་དུ་བྱེད་པ་དེ་ལྟར་འདི་ཕུང་པོ་ལ་སོགས་པའི་བུད་ཤིང་མ་ལུས་པའོ།",
    "གང་གི་ཕྱིར་བཅོམ་ལྡན་འདས་མ་བདག་མེད་མ་ཁོ་ན་བད་ག་མེད་ཉིད་དེ་རང་བཞིན་མེད་པ་སྤྲོས་པ་མཐའ་ད་ག་ལས་ལྡོག་པའི་ངོ་བོའོ།",
    "གང་གི་ཕྱིར་རྣལ་འབྱོར་མའི་སྟེ་ཏི་ལ་ཀའི་རང་གི་ངོ་བོ་བདག་ཉིད་ལ་དབྱེར་མེད་པར་བཟུང་ནས་གནས་ཏེ།",
    "དེ་ནི་ཐུང་ངུ་སྟེ་ཕྱི་མོ་གཅིག་པའོ།",
    "ཐིག་ལེ་ཞེས་པ་ནི་ཕྲ་མོའོ།",
    "འདིར་ཕྱི་མོ་གཅིག་པ་ལ་སོགས་པས་ནང་གི་བརྗོད་པའི་དུས་གསལ་བར་བྱས་ཀྱི།",
