    "ཁྱབ་པ་ནི་དེའི་རང་གི་ངོ་བོས་ཁྱབ་བྱ་ད་ང་དེའི་བདག་ཉིད་ཀྱིས་༤ཁྱབ་བྱེད་འདི་ཡིན་ཏེ།",
    "གང་འཆད་པར་འགྱུར་བ་དེ་ནི་ཕྱི་དང་ནང་གིས་ཤེས་པའོ།",
    "དེ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ནི་རང་བཞིན་མེད་པ་ཉིད་དོ།",
    "དེ་ལས་འདི་དམ་ཚིག་གི་དོན་བྱུང་ཞིང་སྐྱེས་སོ།",
    "ནང་གི་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེ་ནི་མེ་སྟེ་ལྷན་ཅིག་སྐྱེས་པའི་གཏུམ་མོའོ།",
    "དེ་དེའི་རང་བཞིན་གྱི་མེ་དྲོ་བ་རྡུལ་གྱི་ངོ་བོ་རྣལ་འབྱོར་གྱི་གཏུམ་མོ་ཐབ་ཁུང་གི་དབུས་ཀྱི་༢འོག་གསང་བའི་ཆུ་སྐྱེས་སུ་གནས་སོ།་།",
    "སྒྲ་ཙམ་ནི་གཏུམ་མོ་རྡུལ་གྱི་རི་མོ་གོམས་པའི་སྐབས་ན་ནང་གི་བརྗོད་པ་དང་ལྡན་པའོ།",
    "དེ་ཡང་གཏུམ་མོ་སྦོར་ཞིང་།",
    "གང་གི་ཕྱིར་ལྷན་ཅིག་སྐྱེས་པ་ལ་གནས་པ་ནི་དེའི་བདག་ཉིད་ཀྱིས་གཟུགས་ཀྱི་ཕུང་པོ་ལ་སོགས་པ་ལྷ་རྣམས་ཀྱི་དཀྱིལ་འཁོར་ཏེ།",
    "གཅིག་གིས་བར་དུ་ཆོད་པའི་འདབ་མ་བཅུ་དྲུག་རྣམས་སུ་དབྱངས་བཅུ་དྲུག་རྣམས་སོ།",
    "ཨ་ཡིག་ལ་སོགས་པའི་ཡི་གེ་འདི་རྣམས་ཟླ་ཕྱེད་དང་ཐིག་ལེ་ད་ང་བཅས་པ་བ་མོ་ལྟ་བུ་འཛག་པ་རྣམས་སོ་ཞེས་ཤེས་པར་བྱ་སྟེ།",
    "ངོས་དག་ནི་ཧཱུྃ་ཡིག་གི་ངོས་སོ།",
    "ལ་ལ་ནཱ་དང་ར་ས་ནཱའི་རྩ་དག་ནི་མགོ་བོའི་འཁོར་ལོ་ནས་གསང་བའི་འཁོར་ལོར་ཇི་སྲིད་པར་མདུད་པ་རྣམས་སུ་ལྕགས་སྒྲོག་གི་རྣམ་པས་ཨ་ཝ་དྷཱུ་ཏཱི་ལ་འཁྱུད་ནས་གནས་པ་དག་གོ།",
    "ནི་སྟེ་གང་གི་ཕྱིར།",
    "དཔའ་བོ་ཁུ་བའི་རྣམ་པ་རྣམས་ཀྱིས་དང་མཁའ་འགྲོ་མ་བདེ་བའི་ཚུལ་དང་ཁྲག་གི་ཚུལ་ཏེ།",
    "ཡང་ན་འགྲོ་བ་དང་འོང་བ་དག་གང་དག་གི་ངེས་འབྲེལ་དག་སྟེ་དགོས་པ་དག་གོ་ཞེས་ཀྱང་ཚིག་རྣམ་པར་སྦྱར་རོ་། ནི་སྟེ་གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར་འདི་རྣམས་ཀྱི་རྩ་སོ་སོར་ཕྱི་རོལ་དུ་འགྲོ་བ་ན་ནུབ་པ་སྟེ་ནུབ་པར་འགྲོ་བ་དང་སྡུད་པ་དང་ཐིམ་པ་སྟེ་གཉིད་ལོག་པའི་གནས་སྐབས་བཞིན་ན་ནོ།",
    "ཨཱ་ལི་དང་ཀཱ་ལི་དག་གི་ཡང་འགྲོ་བ་དང་འོང་བའི་རྒྱུ་དག་ནི་དེ་དག་གོ་ཞེས་རྟོགས་པའི་ཆེད་དུ་གསུངས་པ།",
    "གཡོན་དང་ཅིག་ཤོས་ཀྱི་ངོས་སུ་གནས་པའི་རྩ་དག་གི་ད་བུས་ཨ་ཝ་དྷཱུ་ཏཱི་རུ་བྱ་བ་ཎྜདཔའ་བོ་ལ་སོགས་པའི་ཁམས་རྒྱས་པ་ལ་སོགས་པ་སྟེ་དེར་ངེས་པར་བྱས་པ་རྣམས་སོ་། དབུས་སྨོས་པས་ནི་ཨ་ཝ་དྷཱུ་ཏཱི་རུ་ཡང་ཨཱ་ལི་དང་ཀཱ་ལི་དག་འབབ་པར་གསལ་བར་མཛད་དོ།",
    "སྲིན་པོ་ནི་གཏུམ་མོ་སྟེ།",
    "འོག་གི་ཆ་རྣམས་སུ་སྟེ་ལྟེ་བའི་འོ།",
    "རིམ་པ་དང་རིམ་པ་མ་ཡིན་པས་རེ་རེར་ཡང་ཁམས་རྣམས་འབྱིན་པར་བྱེད་སྡུད་པར་བྱེད་དོ།",
    "གང་གི་ཚེ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཡང་སྣའི་རྩེ་མོ་ལས་དང་རྡོ་རྗེའི་རྩེ་མོ་ལས་འཕོས་ཤིང་ནུབ་པ་ནི་བདེ་བ་ཉམས་སུ་མྱོང་བ་རྣམ་པར་འཆད་པའི་ཕྱིར་ན།",
    "སྣ་ཡི་རྩེ་མོར་ནན་ཏན་དུ།",
    "རྟག་ཏུ་ནི་མཚན་མ་འབྱུང་གི་བར་དུའོ།",
    "གང་གི་ཕྱིར་ཕུང་པོ་རྣམས་ད་ང་མིག་ལ་སོགས་པ་རྣམས་དེས་སྤྲོ་བ་ནི་༢སྤྲུལ་པའོ།",
    "རྙོག་པ་མེད་པ་སྟེ་ཉོན་མོངས་པའི་རྙོག་པ་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་དངོས་པོ་ལ་སོགས་པར་འཛིན་པ་གཉིས་སྤངས་པའོ།",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་ཉི་ཤུ་གསུམ་པའོ།་།་",
    "ཕྱི་རོལ་དང་ནང་གི་ཀུན་རྫོབ་ཨ་ཡིག་ལ་ཅི་ཞིག་ཡིན་ཞེ་ན་གསུངས་པ།་",
    "གང་པོ་ལ་ལས་སྐྱེས་པའི་བདེ་བ་ཕྱག་རྒྱ་ཆེན་པོ་ཁོ་ན་ཨ་ཡིག་གི་ངོ་བོ་ཅན་ནི་དེའི་ཞེས་པའི་དོན་ཏོ།",
    "འོ་ན་བདེ་བ་ཆེན་པོ་འདི་ཤེས་རབ་འབའ་ཞིག་གིས་འགྱུར་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "གསང་བད་ག་གི་སྟེ་ཨ་དང་ཧཾ་ཡིག་དག་གི་སྙོམས་པར་ཞུགས་པ་སྟེ་རོ་མཉམ་པར་གྱུར་པས་ས་སོ།",
    "དེ་ལྟར་ཤེས་རབ་དང་ཐབས་དག་གི་སྡོམ་པ་གསུངས་ནས།",
    "སོ་སོར་དང་ཚོགས་པ་ཡང་ང་ངོ།",
    "སྐྱེ་གནས་ནི་འདིར་བུད་མེད་དང་སྐྱེས་པ་དག་གི་ལྟེ་བའི་འོག་གི་གནས་སོ།",
    "གང་གི་ཕྱིར་དཔག་ཏུ་མེད་པ་བརྒྱུད་པའི་ངོ་བོར་བརྟན་པ་སྟེ་གནས་པ་ཡིན་པ་དེའི་ཕྱིར་དེ་ཡང་འདིར་བསྐྱེད་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "གང་གི་ཕྱིར་ཡང་སྐྱེ་གནས་ཀྱི་འཁོར་ལོར་སྤྲུལ་པའི་སྐུར་འགྱུར་བ་དེའི་ཕྱིར་དེ་ཁོ་ན་སྤྲུལ་པའི་སྐུའི་ངོ་བོར་ལྡོམ་པའོ།",
    "གླེགས་བམ་ཁ་ཅིག་ཏུ་འདི་ལྷུང་བ་ནི་དགོངས་༤པར་དཀའ་བའི་བྱ་རོག་གི་རྐང་པ་ཅན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "རོའི་ངོ་བོ་ཅན་རྣམས་ཀྱི་ཞེས་པ་རོ་དྲུག་གི་ངོ་བོ་ཅན་རྣམས་ཀྱིའོ།",
    "འདིར་ནི་ངག་གི་ངོ་བོ་ཉིད་ཀྱིས་ཀྱང་སྟེ།་",
    "ཤེས་རབ་དང་ཐབས་རོ་གཅིག་པ་དག་གི་རྟེན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཅི་ཞིག་གིས་འབྲས་བུ་འདི་ཉེ་བར་སྤྱོད་ཅེ་ན་གསུངས་པ།",
    "བརྟན་པ་ཉིད་དང་ལྡན་པའི་ཕྱིར་གནས་བརྟན་པས་དགེ་སློང་གི་ཚོགས་སོ།",
    "གང་གི་ཕྱིར་སྤྱི་བོར་གནས་པ་དེའི་ཕྱིར་འདི་བདེ་བ་ཆེན་པོ་ཁོ་ནར་སྡོམ་པའོ།",
    "སྤྱི་བོར་ཐལ་མོ་སྦྱར་བ་ནི་སྤྱི་བོར་ཐལ་མོ་སྦྱར་བ་སྟེ།",
    "ངག་གི་བཟླས་པ་དང་རྡོ་རྗེ་བཟླས་པའི་མཚན་ཉིད་ཅན་ན་ནོ།",
    "མ་རྟོགས་པའི་སྣང་རུང་ནིམེད་པ་ཁོ་ནའོ་། ཡང་རེས་འགའ་བའི་ལྷན་ཅིག་སྐྱེས་པའི་བདེ་བ་ལུས་ལས་བྱུང་བ་ནི་དཔེ་ཉིད་ཀྱིས།",
    "བཙུན་མོ་ཞེས་པ་ལ་སོགས་པའོ་། བཙུན་མོ་ནི་ཤེས་རབ་མ་སྟེ།",
    "ཕན་ཚུན་ལྟོས་པ་དང་བཅས་པ་འདི་ནི་རེ་རེ་ལ་ནུས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཡང་ཁུ་བ་དང་ལུས་དག་གིས་ཁྱབ་པ་སྟེ།",
    "དེའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བའི་བདེ་བ་དོན་དུ་གཉེར་བས་འདི་ལྟ་བུ་ཁོ་ནའི་དོན་རིམ་པ་དག་གིས།་",
    "དེ་ལྟར་གང་གི་ཕྱིར་འབྲས་བུ་དངོས་པོ་མ་ཡིན་ཞིང་དངོས་མེད་ཀྱང་མ་ཡིན་པ།",
    "རང་གི་ངོ་བོ་ནི་རང་བཞིན་ཏེ།",
    "རང་གི་ཞེས་པ་ལ་སོགས་པའོ།",
    "གལ་ཏེ་རང་གི་ངོ་བོ་ཁོ་ན་མྱ་ངན་ལས་འདས་པ་ཡིན་ན།",
    "དྲི་མ་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་དང་༤།",
    "འཇིག་རྟེན་སེམས་དཔའ་མེད་གང་གིས།",
    "རྨོངས་སྤངས་ནི་དུག་གི་དེ་ཁོ་ན་ཉིད་ཅེས་པའི་ཕྱིར་རོ།",
    "གཏི་མུག་གི་གཉེན་པོ་རྣམ་པར་རྟོག་པ་གཞན་རྟོགས་པར་བྱས་ནས།",
    "འདོད་ཆགས་ནི་ཉོན་མོངས་པའི་འདོད་ཆགས་སོ།",
    "ཉོན་མོངས་པ་དང་རྣམ་པར་རྟོག་པའི་བུད་ཤིང་སྲེག་༡པའི་ཕྱིར་ར་རོ།",
    "ནི་སྟེ་གང་གི་ཕྱིར།",
    "གང་དང་གང་གིས་ཞེས་པ་ཁྱབ་པར་འདོད་པ་བསྟན་པ་སྟེ།",
    "རེག་པ་ལྔ་རྣམས་སུ་འགྱུར་ཏེ།",
    "གང་འདི་སྲ་བའི་བག་ཆགས་ནི་གཏི་མུག་གི་ངོ་བོའོ།",
    "བདེ་བའི་བདག་ཉིད་ཀྱི་སེམས་ནི་བདག་ལ་ཆགས་པ་འདིའི་མཚན་ཉིད་དེ་རང་གི་ངོ་བོ་ཞེས་པས་ཆགས་པའི་མཚན་ཉིད་ཅན་ནོ་། དེ་ཡང་ནམ་མཁའ་རྣམ་པར་དག་༡པའི་ཁམས་ཁོ་ན་སྟེ།",
    "དག་པ་ཁོ་ནར་མོས་པར་བྱ་ཞིང་།",
    "དེ་ལ་བཙུན་མོའི་ཀུནྡུ་རུ་ལ་སོ་སོར་རིགས་རྣམས་ལ་རིགས་དུ་མ་༐",
    "གཅིག་གི་རང་གི་དངོས་པོ་ནི་རིགས་མཐའ་ཡས་པའི་ཐུན་མོང་བའི་ངོ་བོ་མཆོག་ཏུ་རྟག་བ་སྟེ་རིགས་མཐའ་ཡས་པ་རྣམས་སྤྲུལ་པར་བྱེད་ཅིང་མཐའ་མེད་པའི་དུས་སུ་གནས་པའི་ཕྱིར་རོ།"
  ]
}