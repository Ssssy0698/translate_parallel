    "ཨོ་༡ཌི་ཡ་ན་དང་པུརྞ་གི་རི་ད་ང་ཀཱ་མ་རཱུ་པའོ།",
    "པཱུརྞ་གི་རི་ད་ང་ཀཱ་མ་རཱུ་པའོ།",
    "ཏྲ་དུར་ཁྲོད་ནི་རབ་སོང་གི་ས་གཞི་དང་རྒྱ་མཚོའི་ངོགས་ས་སོ།",
    "གནས་བཞིས་ནི་ལྷ་མོ་བཞི་རྣམས་དང་རི་རབ་ཀྱི་རྩེ་མོ་ལ་རི་གཱི་གནས་སོ་ཞེས་གསུངས་པ་དང་།",
    "འདིར་ཐུན་མོང་དུ་བྱིས་པ་རྣམས་ཡུལ་དུ་འཁྱམ་པའི་དོན་དུ་ཛཱ་ལནྡྷ་ར་ལ་སོགས་པས་གནས་ལ་སོགས་པར་གསུངས་ཤིང་།",
    "དེ་དང་དེར་སོན་པའི་རྩ་རྣམས་ཀྱང་ལྷ་མོ་རྣམས་ཞེས་པར་རོ།",
    "དེ་དང་དེར་སོན་པའི་རྩའི་རང་བཞིན་༢ངོ་བོ་རྣམས་སུ་རྡོ་རྗེ་ལྷ་མོ་རྣམས་༢ིཞེས་པར་ལྷག་པར་མོས་པའི་དོན་དུ་རྣམ་པར་གཞག་༤ག་གོ།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་ཅན་རྣམས་གཟིགས།",
    "རང་གི་ལྷག་པའི་ལྷ་དམིགས་ཏེ།",
    "གང་ཡང་ཕྱི་རོལ་དུ་དང་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོར་དང་ལུས་ལ་ཡང་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་ས་རྣམ་པར་གཞག་༢པ་དེ་ཡང་དྲང་བའི་དོན་ཏེ་གང་ཕྱིར་དེ་ད་ང་དེའི་སར་ལྷག་པར་མོས་པ་ལས་འཇིག་རྟེན་ལ་ས་འདས་པའི་ས་དེ་ད་ང་དེ་གསལ་བར་གྱུར་༤པའི་ཆེད་དུ་འབད་པར་གྱུར་ན་ཅི་མ་རུང་ཞེས་པས་སོ།",
    "ཤིང་ལ་སོགས་པའོ་། ཙུ་ཏ་ནི་ཤིང་ཨ་མྲ་སྟེ་གང་དུ་ལྷ་མོ་ཨ་མ་བི་ཀ་དང་ཞིང་སྐྱོང་མེ་ཡོད་པའོ།",
    "ཀ་རཉྫ་ལ་གནས་པའི་ལྷ་མོ་ཀ་རཉྫ་ལ་གནས་པ་མོ་དང་ཞིང་སྐྱོང་དྲིལ་བུ་ཆེན་པོའོ།",
    "ཤིང་ཀ་དམ་པ་ལ་ལྷ་མོ་བཞིན་བཟངས་མ་དང་ཞིང་སྐྱོང་རྒྱུ་ཅན་ནོ།",
    "ཤིང་མྱ་ངན་མེད་ལ་གནས་པའི་ལྷ་མོ་གསང་བ་མ་དང་ཞིང་སྐྱོང་སྟོབས་པོ་ཆེའོ།",
    "གང་དུ་ལྷ་མོ་གཏུམ་མོ་ད་ང་།",
    "རི་རུ་རའི་༢རྩེ་མོ་ནི་འདུ་བའི་གནས་ཏེ།",
    "འཛིན་མར་ཤིང་ཏ་ལ་སྟེ་གང་ན་ལྷ་མོ་བདེ་བྱེད་མ་དང་ཞིང་སྐྱོང་སྐྲ་གྱེན་དུ་བརྗེས་པ་ཅན་ནོ།",
    "གང་དུ་ལྷ་མོ་མེ་ལྕེའི་གདོང་པ་ཅན་དང་ཞིང་སྐྱོང་དྲིལ་བུའི་སྒྲ་ཅན་ན་ནོ།",
    "དམར་སེར་པྲེ་ཏའི་གྲོང་དུ་ཤིང་ཛ་ཌཱ་༢སྟེ་གང་དུ་ལྷ་མོ་ད་མར་སེར་མོ་དང་ཞིང་སྐྱོང་བྱིན་པ་ཆེན་པོ་ཅན་ནོ།",
    "ཨེ་ལའི་གྲོང་དུ་ཤིང་ཨཱ་ལ་ཏ་ན་སྟེ་གང་དུ་ལྷ་མོ་བོང་བུ་ལ་གནས་མ་དང་ཞིང་སྐྱོང་གླང་པོའི་རྣ་བ་ཅན་ན་ནོ།",
    "ཁ་ཆེར་རིའི་རྩེ་མོ་སྟེ་གང་དུ་ལྷ་མོ་བ་ལང་སྣ་མ་དང་ཞིང་སྐྱོང་རྩའི་བྱིན་པ་ཅན་ནོ།",
    "མ་རུ་རུ་ཐང་ཆེན་པོ་སྟེ་གང་དུ་ལྷ་མོ་རིམ་པ་མོ་དང་ཞིང་སྐྱོང་གཙིགཙིགས་པ་ཅན་ནོ།",
    "གང་དུ་ལྷ་མོ་རོ་ལངས་མ་དང་ཞིང་སྐྱོང་སྤུའི་བྱིན་པ་ཅན་ནོ།",
    "པོ་ཎ་ཌ་བརྦྷ་ན་རུ་སྐྱེ་མཆེད་ཀྱི་བྱེ་བྲག་སྟེ་གང་དུ་ལྷ་མོ་རྒན་བྱད་མ་དང་ཞིང་སྐྱོང་བུམ་པ་ཅན་ནོ།་།",
    "རྒྱལ་བ་ཅན་དུ་ཁང་པ་བརྩེགས་པ་སྟེ་གང་དུ་ལྷ་མོ་བཞིན་རས་དང་བ་དང་ཞིང་སྐྱོང་རལ་བ་གསུམ་པའོ།",
    "གང་དུ་ལྷ་མོ་ཀློག་གི་ཞལ་ཅན་དང་ཞིང་སྐྱོང་དྲིལ་བུའི་སྒྲ་ཅན་ན་ནོ།",
    "གང་དུ་ལྷ་མོ་མེའི་ཁ་དང་ཞིང་སྐྱོང་ལྷ་ཆེན་པོའོ།",
    "གང་ལ་ལྷ་མོ་འཇིག་རྟེན་གྱི་མ་དང་ཞིང་སྐྱོང་རི་རབ་ཆེན་པོའོ།",
    "སྒྱུ་མའི་གྲོང་དུ་ཤཱ་ཁོ་ཊ་༦སྟེ་གང་༡ལྷ་མོ་འོད་ལྡན་མ་དང་།",
    "ཨ་མྲ་གཅིག་པར་ཨཱ་མྲ་སྟེ་༐",
    "གང་ཅ་ཏྲ་དུ་༡ལྷ་མོ་ལུས་སྲུལ་མ་དང་ཞིང་སྐྱོང་བརྟུལ་ཞུགས་ཆེན་པོའོ།",
    "རྒྱལ་པོའི་ཁབ་ཏུ་ཨཱ་ཡ་ཏ་ན་ནའི་བྱེ་བྲག་སྟེ་གང་དུ་ལྷ་མོ་རྒུད་པ་འཇིགས་མ་དང་ཞིང་སྐྱོང་ངྷི་ལ་ལཱའི་༢སྒྲ་ཅན་ནོ།",
    "བོད་དུ་བྲག་བརྩིགས་༢པ་སྟེ་གང་དུ་ལྷ་མོ་ལྷན་ཅིག་སྐྱེས་མ་དང་ཞིང་སྐྱོང་ལོངས་སྤྱོད་ཅན་ནོ།",
    "ཞིང་འདི་རྣམས་སུ་བུ་མོ་གང་།",
    "མཚན་མོ་འདུ་བར་རབ་ཏུ་བྱེད།",
    "གནས་ད་ང་ཉེ་བའི་གནས་ད་ག་གི་ཉེ་བ་ཉིད་ནི་ཕན་ཚུན་ཕན་གད་གས་པར་བྱ་བ་ད་ང་ཕན་འདོགས་པ་པོའི་དོན་གྱི་འབྲེལ་བའི་སྒོ་ནས་ཡིན་གྱི།་",
    "ཕྱི་རོལ་གྱི་གནས་དང་ཉེ་བའི་གནས་དག་གི་ཕན་ཚུན་དུ་ཕན་འདོགས་པ་ནི་བརྟེན་པ་རྣལ་འབྱོར་མ་རྣམས་ཕན་ཚུན་ཕན་འདོགས་པའི་ཕྱིར་ཉེ་བར་བཏགས་པ་ཁོ་ནའོ་། དེ་བཞིན་དུ་ཞིང་དང་ཉེ་བའི་ཞིང་ལ་སོགས་པ་རྣམས་ལ་ཡང་རྟོགས་པར་བྱའོ།",
    "འདུན་པ་ནི་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་དོན་དུ་གཉེར་བ་སྟེ་རྟོག་པ་ནི་འདི་ལྟ་འདི་ལྟར་བད་ག་གིས་བྱའོ་ཞེས་རྟོག་བྱེད་དོ།",
    "འདུ་བ་རིང་དུ་སོང་བའི་ས་སྟེ།་",
    "འཐུང་བ་སྟེ་ཉོན་མོངས་པའི་ཕུང་པོ་འདིས་གཅོད་པའོ་ཞེས་པ་འཐུང་གཅོད་མོས་པས་སྤྱོད་པའི་སའོ།",
    "འདིས་ནི་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་ས་སྐྱེད་པར་བྱེད་པའི་རིམ་པས་ཉོན་མོངས་པ་རྣམས་སྤང་བར་བྱ་བའོ།",
    "དེའི་ཕྱིར་དེའི་རྟེན་ཀཱ་རཱ་ཎྱ་པཱ་ཊ་ལ་སོགས་པ་དང་པུལླི་ར་མ་ལ་ཡ་ལ་སོགས་པ་རྣམས་དང་ཀཱ་རཱ་ཎྱ་པཱ་ཊ་ཀ་ལ་སོགས་པ་ད་ང་ཉེ་བའི་ས་གཞི་རྣམས་ཀྱང་མོས་པས་སྤྱོད་པ་ལ་སོགས་པའི་ས་ཉིད་དུ་ལྷག་པར་མོས་པར་བྱེད་ད་དེ།",
    "ཕྱི་རོལ་དུ་འཛིན་པས་སླུ་བ་ཕྲ་མོ་ལས་ཀྱང་གྲོལ་བའི་ཆེད་དུའོ།",
    "གང་གི་གྲིབ་མ་བདུན་རྣམས་སུ་འགྱུར་ཏེ།",
    "དེ་གང་གི་ཚེ་རང་ཉིད་ཤི་བ་དེའི་ཚེ་ཁྱད་པར་དུ་བཟའ་བར་བྱའོ་ཞེས་པ་ལྷག་མའོ།",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་བཅུ་བདུན་པའོ།་",
    "པདྨ་ནི་བདེ་བ་ཆེན་པོ་ལ་སོགས་པའི་པདྨ་རྣམས་ཏེ་རིགས་ལ་གཅིག་གི་ཚིག་གོ།",
    "ཁ་ཅིག་གིས་ནི་འགའ་ཞིག་ཏུ་བདག་གི་གདན་ལ་སོགས་པ་རྣམས་རྣམ་པ་གཞན་དུ་རྣམ་པར་འཇོག་པ་ནི་བསམ་པར་བྱའོ།",
    "བདག་གི་གདན་ནི་ཐབས་ཡིན་ནོ།",
    "ངག་གི་ལམ་གྱི་སྤྱོད་ཡུལ་འདས།",
    "མགོན་མེད་ནི་བདག་གི་གདན་ཏེ།",
    "སྐུ་གསུངས་ཐུགས་རྣམས་ཀྱི་རྡོ་རྗེ་སྟོང་པ་ཉིད་ཀྱི་བདག་ཉིད་རྣམས་རྡོ་རྗེ་སེམས་དཔའ་གང་གི་ཡིན་པ་སྟེ།",
    "གང་གི་ཕྱིར་ཤེས་རབ་ཐབས་བདག་སྟེ།",
