    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་རྟག་པའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་གཙོ་བོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་མི་འགྱུར་བའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་སྐྱེས་བུའི་མཚན་ཉིད་འཛིན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་བྱེད་པ་པོའི་མཚན་ཉིད་འཛིན་པའོ།",
    "བོན་ཉིད་ཀྱི་དབྱིངས་རྣམ་པར་དག་པའི་འབུམ།",
    "དེ་ལྟར་ན་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་རྣ་བའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་སྣའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ལྕེའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ཡེ་ཤེས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ཡང་དག་པར་སྤོང་བ་བཞིའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞིའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་དགུའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ལམ་གྱི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་རྣམ་པར་དག་པའི་སྤྱོད་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་ལེགས་པར་འབྱུང་པའི་ཡོན་ཏན་གྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་སྙོམས་པར་གནས་པའི་ངང་ཉིད་ཀྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "དེ་ལྟར་ན་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྒྱུ་ལས་མ་བྱུང་པའོ།",
    "རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་རང་བཞིན་ཡང་དག་པ་ནི་རྟག་པའི་རང་བཞིན་ནོ།"
  ]
}