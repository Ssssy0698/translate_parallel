    "ཡང་དག་པར་སྤོང་བ་རྣམས་རྟག་པ་མ་ཡིན་འཇིག་པ་མ་ཡིན་ཏེ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་རྟག་པ་མ་ཡིན་འཇིག་པ་མ་ཡིན་ཏེ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་རྟག་པ་མ་ཡིན་འཇིག་པ་མ་ཡིན་ཏེ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་རྟག་པ་མ་ཡིན་འཇིག་པ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ།",
    "སྨོན་པ་མྱེད་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "བསྟན་པ་འདི་ཐོས་ན་མི་འཇིགས་མྱི་སྔང་སྐྲག་པར་མྱི་འགྱུར་རོ།",
    "དེའི་ཚེ་འདི་ནི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་རྣ་བའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་སྣའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་ལྕེའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམྱིགས་ཤིང་མི་ལེན་མི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམྱིགས་ཤིང་མི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་རྣམ་པར་ཤེས་པའི་ཁམས་ཞེས་བགྱི་བར་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་རྣམ་པར་ཤེས་པ་ཞེས་བགྱི་བར་རྣམ་པར་ཤེས་པ་ལ་མྱི་དམིགས་ཤིང་མྱི་ལེན་མི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བགྱི་བར་འདུས་བྱས་སྟོང་པ་ཉིད་ལ་མྱི་དམིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བགྱི་བར་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་ཡང་དག་པར་སྤོང་བ་རྣམས་ཞེས་བགྱི་བར་ཡང་དག་པར་སྤོང་བ་རྣམས་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བགྱི་བར་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བགྱི་བར་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "དེའི་ཚེ་འདི་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཞེས་བགྱི་བར་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ལ་མྱི་དམྱིགས་ཤིང་མྱི་ལེན་མྱི་གནས་ཏེ།",
    "གཟུགས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "འདུ་ཤེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འདུ་བྱེད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མྱིག་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྣ་བ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྣ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ལྕེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ལུས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཡིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "གཟུགས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྒྲ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དྲི་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "རོ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "རྩེའི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཆུའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མྱེའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ནམ་མཁའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "མ་རིག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "འདུ་བྱེད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མྱིང་དང་གཟུགས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "སྐྱེ་མཆེད་དྲུག་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྲེད་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ལེན་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྲིད་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྐྱེ་བ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྒ་ཤི་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ནང་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཕྱི་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དྲན་པ་ཉེ་བར་ཚིགཞག་པ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྫུ་འཕྲུལ་ཀྱི་རྐང་པ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྟོབས་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྨོན་པ་མྱེད་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མྱི་འཇིགས་པ་བཞི་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཐམས་ཅད་ཤེས་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "དེ་ནི་འདི་ལྟར་གཟུགས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས།",
    "ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་གཟུགས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཚོར་བའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ཚོར་བ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་ཚོར་བའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ཚོར་བ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་འདུ་ཤེས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་འདུ་ཤེས་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་འདུ་ཤེས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་འདུ་ཤེས་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་འདུ་བྱེད་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་འདུ་བྱེད་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་འདུ་བྱེད་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་འདུ་བྱེད་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་ཤེས་པའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རྣམ་པར་ཤེས་པ་མ་ལགས་ཏེ།",
    "དེ་ལྟར་ན་རྣམ་པར་ཤེས་པ་དང་མ་སྐྱེས་པ་དེ་གཉིས་སུ་མ་མཆིས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་རྣམ་པར་ཤེས་པའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རྣམ་པར་ཤེས་པ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣ་བའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རྣ་བ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་རྣ་བའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རྣ་བ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་སྣའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་སྣ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་སྣའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་སྣ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ལྕེའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ལྕེ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་ལྕེའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ལྕེ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ལུས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ལུས་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་ལུས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ལུས་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཡིད་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ཡིད་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་ཡིད་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་ཡིད་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་གཟུགས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་གཟུགས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་སྒྲའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་སྒྲ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་སྒྲའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་སྒྲ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་དྲིའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་དྲི་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་དྲིའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་དྲི་མ་ལགས་སོལ།",
    "བཅོམ་ལྡན་འདས་རོའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རོ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་རོའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རོ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣ་བའི་རྣམ་པར་ཤེས་པའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རྣ་བའི་རྣམ་པར་ཤེས་པ་མ་ལགས་ཏེ།",
    "དེ་ལྟར་ན་རྣ་བའི་རྣམ་པར་ཤེས་པ་དང་མ་སྐྱེས་པ་དེ་གཉིས་སུ་མ་མཆིས་ཏེ་གཉིས་སུ་བགྱིར་མ་མཆིས་སོ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
    "དེའི་སླད་དུ་རྣ་བའི་རྣམ་པར་ཤེས་པའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་རྣ་བའི་རྣམ་པར་ཤེས་པ་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་སྣའི་རྣམ་པར་ཤེས་པའི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་སྣའི་རྣམ་པར་ཤེས་པ་མ་ལགས་ཏེ།",
    "དེ་ལྟར་ན་སྣའི་རྣམ་པར་ཤེས་པ་དང་མ་སྐྱེས་པ་དེ་གཉིས་སུ་མ་མཆིས་ཏེ་གཉིས་སུ་བགྱིར་མ་མཆིས་སོ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་གཉིས་མ་ལགས་མང་བ་མ་ལགས་ཐ་དད་པ་མ་ལགས་ཏེ།",
