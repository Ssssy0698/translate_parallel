    "འོ་ན་དགའ་ཡུལ་རང་ཡིན་མིན་གྱི་གང་ཟག་སུ་ཀུན་ལའང་དགའ་མཁན་གཞན་ཞིག་དགའ་བ་དེས་ཀྱང་རང་ལ་གཞན་དགའ་བ་དེ་བཞིན་དུ་རང་ཉིད་དགའ་བར་བྱ་དགོས་ན།",
    "༣ལུས་སེམས་དལ་དུ་འདུག་པའི་སྙོམ་ལས་ལ་བདེ་བར་བཟུང་ནས་བདེ་བ་དེའི་རོ་མྱང་བ་དང་།",
    "འདི་ཤེས་པར་བྱས་ནས་སྙོམ་ལས་ལ་མི་འདུག་པར་རང་གཞན་མཐའ་དག་སྐྱེ་འཆིའི་རྒྱ་ལས་གྲོལ་བའི་ཐབས་ལ་བརྩོན་འགྲུས་ཀྱི་སྟོབས་བསྐྱེད་པར་བྱའོ།",
    "འདུག་བདུན་",
    "བི་བྷུ་ཏ་ཡང་འཆད་ཚུལ་འདི་དང་མཐུན་པར་འདུག་སྙམ་ལ།",
    "ཐུན་མིན་འགའ་ཞིག་འཆད་ཚེ་དེ་ཇི་ལྟ་བ་བཞིན་མཛད་འདུག་པས།",
    "རང་རང་ཡིད་ལ་གང་དགོས་འདོད་དགུའི་ཆར",
    "ཐ་སྙད་བཏགས་པ་རུ་འདུག་པ་དོན་དུ་བཟུང་།",
    "བར་ཆད་རང་སེམས་སུ་འདུག་པ་འདྲེ་རུ་བཟུང་།",
    "རྣམ་རྟོག་ཡེ་ཤེས་སུ་འདུག་པ་སྐྱོན་དུ་བཟུང་ སྤང་བྱ་དྲི་མར་བལྟས་པ་྾།",
    "ཞེ་སྡང་རང་གཟུགས་ཕོ་གདོན་རྒྱལ་པོ་དང་།",
    "འདིས་ཀྱང་རང་འདྲའི་སྐལ་མཉམ་ལ།",
    "ཁྱབ་བདག་གཟུགས་ཅན་མ་ཡིན་འགྲོ་འོང་མེད།",
    "གདུལ་བྱ་ཀུན་ལ་རང་རང་སྐལ་བ་དང་།",
    "དངོས་པོ་དེ་མེད་ཙ་ན་དེའི་བ་༴",
    "དེ་ཙ་ན་གེགས་སེལ་ལོགས་ནས་ཅི་ཞིག་དགོས་ཏེ་མི་དགོས་སོ།",
    "ཐོག་མར་རྣལ་འབྱོར་གྱི་ཡོ་བྱད་ཀུན་བསགས་ཏེ་བདེ་བའི་སྟན་ལ་འདུག་ནས།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧ་རི་ནི་ས་ཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "གཉུག་མ་གཤིས་ཀྱི་གནས་ལུགས་གསུམ་པོ་དབྱེར་མེད་ཕྱག་རྒྱ་ཆེན་པོའི་ལྟ་བ་རང་བྱུང་རང་བབ་བཅོས་མེད་དུ་བསྐྱང་ལ།",
    "གདུལ་བྱ་ཀུན་ལ་རང་རང་སྐལ་བ་དང་།",
    "རང་རང་ཇི་ལྟར་འདོད་པས་ཚིམ་གྱུར་ནས་རིགས་དྲུག་སོ་སོའི་སྡུག་བསྔལ་ལས་གྲོལ་ཏེ།",
    "བདག་རང་ངོ་ཤེས་པར་གསོལ་བ་འདེབས་ ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་འདུག་སྤྱོད་ལམ་གྱི་རྣལ་འབྱོར།",
    "སྤྱི་བོའི་འདོམ་གང་ཙམ་གྱི་ནམ་མཁར་ལིང་ངེར་འདུག་པ་ལ་སེམས་གཏད་པས་མི་རྟོག་པའི་ཡེ་ཤེས་འཆར་རོ།",
    "གསར་རྙིང་རང་ལུགས་རྒྱས་བསྡུས་གང་རུང་བྱ་བ་ལས་ཟུར་དུ་སྨོས་མ་དགོས་ཀྱང་།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་དང་སེམས་དཔའི་འདུག་སྟངས་ཀྱིས་རལ་པའི་མཉམ་པར་སྦྱོར་བ།",
    "འཕྲོ་འཇོག་ཙ་ན།",
    "དེང་དུས་རང་དང་རང་འདྲའི་སྒྲུབ་པ་པོ་རྩེ་གཅིག་ཏུ་སྒོམ་མི་ནུས་པ་རྣམས་ལ་ཉེ་བར་མཁོ་བ་ཆེ་ལོང་ཕྱོགས་གཅིག་ཏུ་བཀོད་པའོ།",
    "སྤྱོད་ལམ་ཐ་མལ་འཆོར་བའི་སྒོམ་ཆེན་ནི་ ནམ་ཡང་རང་རྒྱུད་གྲོལ་བའི་དུས་མེད་པས།",
    "འཁྲུལ་སྣང་རང་སར་གྲོལ་བར་ཐེ་ཚོམ་མེད",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག་ོ།",
    "ཛྙཱ་ན་ཀཱ་ཡ་ཝཱ་གཱི་ཤྭ་ར་ཨ་ར་པ་ཙ་ན་ཡ་ཏེ་ན་མ",
    "སྐྱེས་མ་ཐག་ཏུ་འགྲོ་བའི་བདག་ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "སརྦ་ཏ་ཐཱ་ག་ཏཱ་སུ་ག་ཏ་པ་ར་བ་ཙ་ན།",
    "བགེགས་རྣམས་འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "རང་རང་བདེ་བར་གཤེགས་ནས་ཀྱང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས།",
    "བཛྲ་མུཚོགས་ཞིང་རང་གནས་སུ་གཤེགས།",
    "བཅོམ་ལྡན་འདས་མ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཐིམ་པས།",
    "ཨོཾ་ནག་པོ་ཏིག་པ་རཱ་ཙ་ནཱ་ག་རཀྵ་ས་པ་རི་྾ སྨྱོན་ཁ་ལའོ།",
    "དེ་ལྟར་བསྒྲུབ་པའང་རང་རིག་དོན་གྱི་ལྷ།",
    "ཧ་ཧ་ཌ་ཌ་ཞེས་བཞད་གང་ཞིག་དུས་ཀུན་དུ་ནི་ཤིན་ཏུ་རབ་ཏུ་འཇིགས་མཛད་པ།",
    "གང་དུ་འདུག་པའི་གནས་རྣམས་སུ།",
    "འཁྲུལ་སྣང་རང་ངོ་ཤེས་པར་྾།",
    "ཡང་རྒྱལ་པོའི་ཞལ་ནས་ངའི་མེས་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་ཤེལ་གྱི་གཉན་པོ་གསང་བ་འདི་ཇི་ལྟར་ཡིན་པར་འདུག་ཀློག་དང་གསུངས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་བརྒྱ་པའང་བསྒྱུར་ཟེར་བའང་འདུག་ཅེས་གསལ་བ་དང་།",
    "རྒྱལ་ཁམས་སུ་བན་དེ་རིལ་མི་བཞག་པར་ཆད་ནས་ཀུན་བསྐྲད་པ་ལས་གདོང་དམར་གྱི་དགེ་སློང་རྣམས་ཁྲོས་ཏེ་དགེ་སློང་འདི་རྣམས་བསྐྲད་ན་བདག་ཅག་ཀྱང་འདི་ན་མི་འདུག་གོ།",
    "བོད་སྐད་དུ་སྒྱུར་བར་དག་ཀྱང་བྱུང་ཞེས་གདའས་ཀྱིས།",
    "བོད་སྐད་དུ་བསྒྱུར་བ་དག་ཀྱང་བྱུང་ཞེས་གདའས་ཀྱིས།",
    "གདའས་ལ་སོགས་པ་མིང་མཐའི་འ་མ་བསྡུས་པར་རང་སོར་ཡོད་པ་རྣམས་ཡི་གེ་ཟོར་ཡང་པའི་ཕྱིར་དངོས་སུ་བྲི་མི་དགོས་པར་བཅོས་པ་དང་།",
    "ཁྱི་ལོ་དེ་ཡང་བཙན་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་ནམ་སད་ན་ལེགས་མཇིང་ཡོན་གྱི་སྐུ་རིང་རྟའི་ལོ་སྟེ་ཕྱི་ལོ་༨༡༤ ལོར་སྒྲ་སྦྱོར་བམ་པོ་གཉིས་པ་ཕྱོགས་བསྒྲིགས་བྱས་པའི་རྗེས་ཀྱི་ཁྱི་ལོ་ཡིན་དགོས་པར་འདུག་གང་ལ་ཞེ་ན།",
    "དེ་དག་ཕལ་ཆེ་བ་ལ་ལོ་ཚ་བའི་མཚན་མ་བྲིས་པས་ཐམས་ཅད་ཀྱིས་མི་ཤེས་པར་འདུག་པས་བྲིས་སོ།",
    "དག་ཆ་ཚིག་སྦྱོར་མི་ལེགས་པའི་སྐྱོན་གྱི་རིགས་དག་བཅོས་བྱས་པའི་དཔེ་དེ་བསྟན་པ་རྒྱས་པ་རྒྱན་གྱི་ཉི་འོད་ཅེས་བྱ་བ་འདི་ཡིན་པར་འདུག་གོ།",
    "ངེད་ཀྱི་མི་འབྲུ་ལ་གནོད་ཟེར་ནས་འདུག་ཏུ་མ་བཅུག་པར་བསྐྲད་དེ་དགའ་བ་གདོང་དུ་ཕྱིན་ནས།",
    "སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པ་ཐིག་ལེ་བུམ་པའི་འགྱུར་འདུག་ནའང་།",
    "འདི་དང་གཅིག་པ་འདུག་པས་མ་བྲིས་སོ།",
    "སྐུ་ཚབ་ལ་བརྟེན་དགོས་པར་གདའ་བས།",
    "སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་བྲིས།",
    "གང་ལྟར་རུང་རྒྱའི་སྐད་བོད་ཀྱི་ཡི་གེར་བྲི་ཚུལ་མི་གཅིག་པའི་ཁྱད་པར་ཞིག་འདུག་རྒྱལ་རྩེ་ཐེམ་སྤངས་མའི་དཀར་ཆག་གུས་ཉིད་དང་།",
    "ཚ་པ་གོང་འོག་པོད་གྲངས་གཉིས་འདུག་དེས་ན་དེ་ལ་གཞི་བཅོལ་བའི་སྣར་ཐང་དང་།",
    "ཆད་པ་བཅུག་ནོར་བ་བཅོས་པ་ཞིག་ཡིན་པར་འདུག་དེ་ཡང་ནོར་བ་བཅོས་དགོས་པ་ཡིག་ཕྲེང་མང་པོ་ཡོད་རིགས་དེ་ཐད་ཀྱི་པར་ཤིང་གསར་བརྐོ་བྱས་པ་དང་།",
    "ཚ་པ་གོང་འོག་པོད་གྲངས་གཉིས་འདུག་དེས་ན་དེ་ལ་གཞི་བཅོལ་བའི་སྣར་ཐང་དང་།"
  ]
}