    "བོད་མི་རིགས་ཀྱི་རྟོགས་པའི་གཞིགས་སྟེངས་ལ་རྩོད་སྒྲུབ་ཀྱི་རྨང་གཞི་སྔར་ནས་གྲུབ་འདུག་པས།",
    "རང་མཐོང་དང་རང་ལ་ཡིད་ཆེས་ཀྱི་འདུ་ཤེས་དང་།",
    "ལས་ཀ་འདི་དུས་ཚོད་དམ་འཛིན་བགྱིས་ཏེ་ཐུང་ཐུང་མྱུར་མྱུར་དུ་བསྒྲུབ་དགོས་པ་ཞིག་ཏུ་གདའ།",
    "མིའི་རང་བཞིན་རིན་ཐང་དགོས་མཁོར་བསྙེག་པའི་དུས་ལ་བསླེབས་ཙ་ན།",
    "འགྲོ་བ་མིའི་རིགས་དང་རང་བྱུང་ཁམས་ཡོངས་ཀྱི་དངོས་མཐུན་སྤྱིར་བཏང་བའི་རང་བཞིན་གྱི་ངོས་འཛིན་ཡང་དག་ཞིག་ཐོབ་དགོས་པས།",
    "རང་རང་ཡུལ་ཅན་བྱེད་པོ་ཡིན་པར་འདོད་ནས་མི་གཞན་ཡུལ་ཁོ་ནར་འདོད་པ་ནི།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ་ལྟ་བུར་འདོད་པ་དང་མཚུངས།",
    "གསལ་བ་འགའ་ཞིག་དུས་ཡིན་ཏེ།",
    "འདུག་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི།",
    "མདུན་དུ་འདུག་སྟེ་ཞེས་བྱ་བ་ནི་མདུན་དུ་འཁོད་པའི་ཕྱག་ན་རྡོ་རྗེའོ།",
    "དེས་གཞན་རྣམས་འབྱེད་པར་བྱེད་ཅིང་རང་ཉིད་དབྱེར་མི་ཕྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཡང་རང་ཉིད་རྩི་བས་དྲུག་དང་ལྡན་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དམག་དཔུང་རངས་པའོ།",
    "གོ་འཕང་ཞེས་བྱ་བ་ནི་འདུག་པའི་གནས་སོ།",
    "ཞེས་བྱ་བ་ནི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ཕྱག་རྒྱའི་རྣམ་པ་གསུམ་གྱིས་རྡོ་རྗེ་བཟླས་པའི་ངོ་བོ་འདུག་པའི་གནས་སོ།",
    "བདེ་བ་ཆེན་པོའི་གོ་འཕང་ཞེས་བྱ་བ་ནི་དེ་འདུག་པའི་གནས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་སྒྲིབ་པ་དང་བྲལ་བ་དང་རང་བཞིན་གྱིས་འོད་གསལ་བའི་ངོ་བོའོ།",
    "དེའི་གོ་འཕང་ནི་འདུག་པའི་གནས་ཏེ།",
    "དེའི་གོ་འཕང་ནི་འདུག་པའི་གནས་སོ།",
    "གོ་འཕང་ཞེས་བྱ་བ་ནི་འདུག་པའི་གནས་སོ།",
    "དབྱངས་དང་ཞེས་བྱ་བ་ནི་དུས་གཉིས་ལ་ཡང་རང་དང་འོས་པའི་སྒྲ་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་རིག་པར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་མཐའ་གཉིས་སྤངས་པ་ནི་བྲལ་བའོ།",
    "དེ་རྣམས་ཀྱི་བརྒྱ་དང་བརྒྱད་དང་རང་བཞིན་ནི་བརྒྱ་རྩ་བརྒྱད་དོ།",
    "འོད་གསལ་གོ་འཕང་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱིས་འོད་གསལ་བའི་རྣམ་པའི་འདུག་པའི་གནས་སོ།",
    "ཞེས་བྱ་བ་ནི་འདུག་པ་དང་གནས་བ་ལྡང་བ་སྤངས་པའི་ཕྱིར་རོ།",
    "རྟེན་ཅིང་འབྲེལ་འབྱུང་རང་བཞིན་གྱིས།",
    "རང་ཉིད་ཉམས་མྱོང་རང་ངོ་བོ།",
    "དེའི་ཡན་ལག་དུས་ཀྱི་རབ་ཏུ་དབྱེ་བ་ནི།",
    "མཇུག་སྒྲོ་རྨ་བྱའི་སྒྲོ་མདངས་བརྒྱན་འདྲའི་བྱ་ཡིད་དུ་འོང་བ་ཞིག་འདུག་པ་མཐོང་བ་དང་།",
    "ཁོག་སྨད་ཀླུ་རིས་ཁྱུགས་སེ་བྱས་པའི་བྱ་ཞིག་འདུག་ཅེས་ཞུས་པ་དང་།",
    "བྱ་གཟུགས་འཇའ་འོད་འཁྲིགས་སེ་འདུག་པ་མཐོང་བ་དང་།",
    "བསྐལ་པ་སྟོངས་འགྲོ་བཞིན་འདུག་ན།",
    "ལྷ་བུའི་བསམ་པར་ངས་དེ་སྔ་དཀའ་སྡུག་དུ་མ་སྤྱད་ནས་དག་པའི་ཞིང་ཁམས་སུ་ཡར་སླེབས་མ་ཐག་སླར་ཡང་མི་ཡུལ་དུ་མངག་རྒྱུ་བྱས་གདའ།",
    "ད་ལྷ་བུ་མ་སྤྲད་ན་ཡག་པོ་ཞིག་འོང་ས་མེད་གདའ་དགོངས་པ་དང་།",
    "ཁྱེད་རྣམས་ཀྱི་ནང་ནས་ཕེབས་ཐུབ་མཁན་མང་པོ་གདའ།",
    "ཀླུ་ཡུལ་དུ་འདུག་བསམ།",
    "ད་སྟོབས་དང་ནུས་པ་ཅི་གདའ་བལྟ་དགོས་བསམས་ནས་འདུག་པའི་སྐབས།",
    "རྟ་སྲབ་དར་ཚོན་སྣ་ལྔ་བཅས་ཀྱིས་བསྐོར་བ་ཞིག་དགོས་འདུག་པས་དེ་རྣམས་སུ་ཡིས་བསྒྲུབ་ཅེས་གསུངས།",
    "ས་བདག་ནག་པོ་བཅས་ཆམ་ལ་ཕབ་པའི་ཕོ་ཉ་གཅིག་དགོས་འདུག་འགྲོ་མི་སུ་ཡིན་དྲིས་པས།",
    "ལྷ་བུ་ཁོང་ཕར་ཙམ་བྱོན་ཏེ་ཡང་ཐུགས་བསམ་ཞིག་བཞེས་ནས།",
    "ད་ལྷ་བུ་ཁྱེད་ཕེབས་ན་གསུངས་པས་ལྷ་ཡི་བུ་ཏོག་དཀར་པོ་ཐུགས་ཤིན་ཏུ་དགྱེས་ཏེ་སློབ་དཔོན་ལ་ཕྱག་གསུམ་ཕུལ་བར་གདའོ།",
    "ཁྱེད་ལ་དགོས་གལ་ཆེ་བ་ང་ལ་གདའ་ན་ཕུལ་ཆོག་ཟེར།",
    "སྐད་ཅིག་ཙམ་ལ་ལྷོ་འཛམ་བུ་གླིང་ལ་བསྐོར་བ་བྱེད་ཐུབ་པའི་ལྷ་རྟ་གཅིག་དགོས་འདུག་པས་དེ་སུ་ཡིས་གནང་ཞེས་ཞུས།",
    "དེ་རིང་ཁྱེད་རྣམས་རང་རང་སོ་སོའི་གནས་ལ་བྱོན།",
    "དེ་རིང་གཉེན་འཕྲད་དུ་ཡོང་ལེ་འགྲིག་གདའ་ཟེར་བཞིན་བུ་གཉིས་ཁྱིམ་དུ་གདན་དྲངས།",
    "ཐམས་ཅད་རང་སྣང་རང་གསལ་དང་།",
    "ལྷོ་སྤྲིན་དཀྱིལ་ན་གསལ་ལེར་འདུག།",
    "འཛམ་གླིང་རྒྱན་དུ་ཤར་ནས་འདུག།",
    "མ་རོང་ལྕམ་གྱི་བསམ་པར་ངེད་ཀྱི་བུ་ཆུང་བ་ངར་ཆེ་བས་མཐའ་མ་དགྲ་ལག་ཏུ་ཤོར་ཉེན་གདའ།",
    "ཕ་སྤྱི་དཔོན་རོང་ཚ་ཁྲ་རྒན་གྱིས་ཆེ་བ་འདུག་ཐབས་དང་།",
    "ཡིན་ན་ཡང་ཧོར་གྱིས་གླིང་ས་སྔར་བཞིན་བཟུང་ནས་སྤྱི་དཔོན་སོགས་དབྱར་དགུན་སྟོན་དཔྱིད་མེད་པར་ཧོར་ཡུལ་དུ་ཁྲལ་འཇལ་བཞིན་གནས་པར་གདའོ།",
    "དེ་སྟེ་འདྲ་མ་ཨེ་འདྲ་གདའ་གསུངས་ནས་དཔའ་གླུ་ཐུང་ཐུང་ལ་དྲངས་ཏེ་གླུ་འདི་བླངས་སོ།",
    "ད་མི་འདུག་འགོག་ཡུལ་སྟོད་ལ་འགྲོ།",
    "དཔུང་རོགས་རུ་བཀོད་ཀྱི་གླུ་འདི་ལྟར་གསུངས་པ་གདའོ།",
    "དེ་དཔྱད་ན་འདྲ་མ་ཨེ་འདྲ་གདའ།",
    "མིན་ཡང་ཀླུ་གཙུག་ན་ཕ་མིང་དུ་འགྱུར་བས་དེ་ལྷག་མི་འདུག་སྙམ་ནས་མདའ་གསེར་ལྟོང་མ་ཞིག་ལ་མདའ་རྒྱུག་བྱེད་ཀྱི་སྔགས་བཏབ་སྟེ་མདའ་མགུལ་དུ་ཡི་གེ་འདི་ལྟར་བྲིས།",
