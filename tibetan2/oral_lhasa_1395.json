    "རང་ཉིད་ཁེར་རྐྱང་དུ་གནས་སྡོད་བྱས་པ།",
    "མི་ཉག་རབ་སྒང་ཞེས་སྒང་དྲུག་ཏུ་གྲགས་པའི་ནང་ནས་བྲག་གཡབ་ནི་ཟླ་ཆུ་གཙང་པོ་ཟླ་ཆུ་ཞེས་བརྗོད་དོན་ནི།",
    "དྭངས་ཤིང་གཙང་བའི་མཚོ་དང་མཚེའུ།",
    "ཡ་མཚན་ཁྱད་པར་ཅན་གྱི་བྱམས་མདུན་བྱམས་པ་རང་འཁྲུངས།",
    "བྲག་གཡབ་ཀྱེ་ནེ་དགོན་ཕྱག་བཏབ་ནས་བཞུགས་དུས།",
    "བྱམས་མདུན་ཕེབས་པ་དང་བྱམས་པ་ཞེས་མཚན་གསོལ།",
    "མེ་ཏོག་རྣམ་པར་བཀྲ་བའི་ས་ཆ་དེར་གནས་པའི་གཅན་གཟན་དང་རི་དྭགས།",
    "ཞི་བདེ་བག་ཕེབས་ཀྱི་ངང་དུ་གནས།",
    "བར་ཁམས་སུ་འགྲོ་དོན་སྐྱོང་དགོས་ཞེས་བཀའ་མངགས་གནང་བ་དང་།",
    "དེ་ནས་མ་དགོན་བཀྲ་ཤིས་གཡང་འཁྱིལ་ཞེས་པ་དེ་མཁར་ས་སྟེང་དུ་ཕྱག་བཏབས་ནས་དཔལ་གསང་བ་འདུས་པའི་ལྷ་གྲངས་སུམ་ཅུ་སོ་གཉིས་དང་མཚུངས་པར་ཁང་ཚན་སུམ་ཅུ་སོ་གཉིས་བྱུང་།",
    "སྐུ་ཕྲེང་གཉིས་པ་བྱམས་མདུན་དུ་ཕེབས་སྐབས་གནས་པོ་རྡོ་རྗེ་གུར་མགོན་དང་དངོས་སུ་མཇལ་འཕྲད་གནང་ཞིང་།",
    "བཀའ་ལན་གནང་དོན།",
    "ལྷག་པར་དུ་བྲག་གཡབ་དང་ས་སྦྲེལ་ཡིན་པ།",
    "གཙང་གསར་དགོན་ས་དགོན་བརྒྱད་ཀྱི་ནང་ནས་ཆེ་ཤོས་ཡིན་པ་ནང་ཕུར་པའི་སྒྲུབ་མཆོད་བཙུགས་པ་གནང་བ་དང་།",
    "འབྲོག་པར་ཕྱུགས་རིགས་མང་ཉུང་ལ་དཔག་པའི་ཤ་མར་དང་།",
