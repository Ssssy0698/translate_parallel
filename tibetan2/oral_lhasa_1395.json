    "ཆགས་ཡུལ་ནི་བྲག་གཡབ་ལྷ་སྲུང་ཡུལ་པ་ཟེར།",
    "འུར་རྡོ་བཅས་ལ་བརྟེན་ནས་ཐེངས་ཁ་ཤས་དམར་འཛིང་བྱས།",
    "དེའི་སྐབས་རྒྱལ་མཆོག་བཅུ་གསུམ་པ་ཆེན་པོ་མཆོག་ནས་དམིགས་བསལ་གྱིས་གཟིམ་འགག་བསྐོ་གནང་བ་དང་།",
    "དེ་རྗེས་གཟིམ་འགག་ཁྲི་པ་ཡང་བསྐོས་གནང་བ་དང་།",
    "མེ་མདའ་མགར་ཐབ་ནང་བསྲེགས་པ་དང་བཅགས་པ་སོགས་བྱས།",
    "དག་ཡིག་ངག་སྒྲོན་དང་སུམ་རྟགས་བཅས་ངག་བསྐྱོར་བྱས་ནས་ནང་དོན་བསླབས་པ་དང་།",
    "སྐབས་འགར་ཕྱག་འཇུག་གནང་བ་དང་།",
    "ཕེབས་བྱམས་དར་སེར་དང་རྨ་བྱའི་གདུགས་འཛིན་སོགས་རྟ་པ་ཆིག་སྟོང་བརྒལ་བ་ཡིས་རུ་གཉིས་སུ་བསྒྲིགས་ཏེ་བཤར།",
    "རྒྱལ་སྲིད་སྣ་བདུན་དང་སྐུ་གསུང་ཐུགས་རྟེན་བཅས་བརྒྱ་འབུལ་བྱས།",
    "གསོལ་ཇ་བཅས་ཚང་མར་ཁྱབ་པར་བྱས།",
    "དེ་རྗེས་མ་དགོན་དུ་ཕེབས་བཞུགས་གནང་།",
    "༡༩༤༨ ལོར་དབྱར་སེང་བྱམས་མདུན་དུ་ཕེབས་ཤིང་།",
    "བྱས་ན་དཀྱུས་ལ་སྤྱི་ཁྲེ་བཅུ་ལྷག་ཙམ་དང་ཞེང་ལ་སྤྱི་ཁྲེ་བཞི་ཙམ།",
    "བུ་སྐུ་གཟུགས་བདེ་པོ་ཡིན་ནམ་ཟེར།",
    "ལྷ་སྲུང་ཡུལ་པའི་ནང་ཐེངས་མང་འགྲོ་མྱོང་།",
    "༡༩༥ ལོ་འགོར་བྱམས་མདུན་བྱམས་པ་རང་འཁྲུངས་ཀྱིས་སྤྱན་ཆབ་བསིལ་ཏེ་སྤྱན་ནས་བབས་པའི་ཆུས་ཞལ་གསེར་དག་པར་བྱས།",
    "དཔོན་འབངས་དམ་ཚིག་མ་མཐུན་པའི་རྐྱེན་གྱིས་ཤིན་ཏུ་སྡུག་པོ་ཡོང་ངོ་བབས།",
    "༡༩༥ ཕྱི་ཟླ་དང་པོའི་ནང་བྱམས་མདུན་དུ་འདུ་འཛོམས་བྱས།",
    "རྒྱ་དམག་ཕམས་པར་ཤོག་ཅིག་རྒྱལ་བ་བསྟན་འཛིན་རྒྱ་མཚོ་སྐུ་ཚེ་ཞབས་པད་བརྟན་པར་ཤོག་བོད་གངས་ཅན་གྱི་བསྟན་པ་ཡུན་ནས་ཡུན་དུ་དར་བ་ཤོག་རྒྱ་མི་གུང་ཁྲན་ཏང་རྩ་མེད་འགྲོ་བ་ཤོག་ཟེར་བའི་འབོད་སྒྲ་ལྡིར།",
    "བཅུ་དཔོན་བཅས་ངོ་སྤྲོད་བྱས།",
    "རང་དམག་ལ་མེ་མདའ་དང་མདེའུ་ཡི་ཆ་རྐྱེན་ཞན་པོ་ཡིན་པས་བྲག་གཡབ་དམག་ལྔ་བརྒྱ་པོ་ལ་ད་ཡོད་དམག་མདའ་རྙིང་པ་ཁ་རིང་བརྗེས་ནས་ཁ་ཐུང་ངམ་ཁ་དུམ་གནང་རྒྱུ་དང་།",
    "ལྷག་པར་དུ་མདེའུ་གང་མང་གནང་རྒྱུ།",
    "ལྷག་པར་དུ་མདེའུ་མང་ཙམ་གནང་རྒྱུ།",
    "ག་དང་དམག་དང་མཉམ་དུ་རྒྱ་དམག་ལ་འཐབ་འཁྲུག་བྱས།",
    "དེ་ནས་བཟུང་ཉིན་མཚན་གསུམ་ལ་དམག་འཐབ་རྒྱུན་མ་ཆད་པ་བྱས།",
    "དམག་མི་རྣམས་ལ་བསྟན་ནས་མཚོན་མ་ཟུགས་པའི་གནས་ཚུལ་ངོ་སྤྲོད་བྱས།",
    "ས་རུབ་པ་དང་ཕྱིར་འཐེན་བྱས།",
    "སྔོན་འགྲོའི་མི་སྣ་ཁག་ཅིག་ས་ཚུགས་རིམ་རྒྱུད་དུ་རྟ་འུལ་སོགས་གྲ་སྒྲིག་བྱེད་མཁན་གཞུང་ལམ་ཐོག་བཏང་སྟེ་ལྷ་སར་བསྐྱོད་རྒྱུ་བྱས།",
    "ལ་ལས་མེ་མདའ་གཉིས་གསུམ་རྒྱབ་ཏུ་ཁུར་ཏེ་མདུན་དུ་མདེལ་སྒམ་འཁྱེར་བ་སོགས་བྱས།",
    "དམག་མི་བཅས་ཀྱི་སྒེར་རྟ་ཚང་མ་རྒྱ་མིས་བཙན་འཕྲོག་བྱས།",
    "སྨར་ཁམས་ཕྱོགས་ནས་བོད་དམག་བྲོས་ཡོང་བ་རྣམས་ལ་བྲག་གཡབ་མི་སེར་གྱིས་ཞག་སྡོད་གནས་ཚང་དང་བཟའ་བཏུང་སྣེ་ལེན་བྱས།",
    "བཅིངས་འགྲོལ་དཔུང་དམག་ལྷ་སར་བསྐྱོད་ཚེ་སྔོན་ལ་གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་བཀའ་ཁྲོལ་ཐོབ་དགོས་པ་དང་།",
    "སྤྱི་མཛོད་མཁར་མགོ་ཀྲུའུ་རིན་གཞོན་པ་རྣམས་ཀྱི་གྲལ་དུ་བསྐོ་བཞག་བྱས།",
    "སྤོའོ་ཐང་སྨད་ནས་བྲག་གཡབ་ཀྱི་རྒྱ་དོས་དབོར་མཁན་ཚང་མ་ཕྱིར་འཐེན་བྱས།",
    "ཡང་ལྷ་སྲུང་ཡུལ་པའི་ནང་ས་ལེ་ཚང་ཞེས་པ་དེའི་ཁང་པའི་ལྷོ་སྒོའི་འགྲམ་ལ་ལྕང་སྡོང་ཧ་ཅང་ཆེན་པོ་ཞིག་ཡོད་ཅིང་།",
    "དེར་ཀླུ་གནས་ཀྱི་ཡོད་པར་ངོས་འཛིན་བྱེད་པ།",
    "བྲག་གཡབ་མི་སེར་འགོ་པ་སོགས་ཀྱིས་ཕེབས་བསུ་ཟབ་རྒྱས་ཞུས་པ་དང་།",
    "རྟ་རྒྱུགས་པ་དང་མེ་མདའ་འཕེན་པར་དགའ་པོ་ཡོད་ལ།",
    "གཙང་དགོན་གྱི་བླ་གྲྭ་ཉི་ཤུ་ཙམ་དང་།",
    "དེ་དུས་རྒྱ་དམག་དང་ཐུག་རོགས་བྱས་ན་མང་པོ་ཞིག་བསད་ཆོག་བསམ།",
    "༡༩༥༨ ལོར་རང་ལོ་༢༡ ལ་སླེབས་དུས་ལྷ་སྲུང་ཡུལ་པའི་ཐེམ་དུད་སུམ་བརྒྱ་མ་ཟིན་ཙམ་ཡོད་པ་ནས་རྟ་ཟམ་བསྐོ་རྒྱུའི་འོས་བསྡུས་ཤིང་འོས་ཤོག་མང་ཉུང་གོ་རིམ་བྱས།",
    "ཉེན་གཡོལ་ཡོང་མཁན་རྣམས་སྡོད་བཟོད་བདེ་ཙམ་ཡོད་པ་དང་བྲག་གཡབ་གཞུང་དང་ས་གནས་མི་དམངས་ཚོས་ཁོ་ཚོར་རོགས་སྐྱོབས་གང་ལེགས་བྱས།",
    "གླིང་ཁ་བརྒྱ་དཔོན་འཆི་མེད་རྡོ་རྗེས་ཕྲན་ལ་དམག་ལངས་ཏེ་རྒྱ་མིར་ངོ་རྒོལ་དགོས་པའི་སྐུལ་མ་ཡང་ཡང་བྱས་བྱུང་བས།",
    "༡༩༥༨ ལོའི་དབྱར་ཁ་སྨར་ཁམས་དམག་དང་རྒྱ་དམག་གཉིས་འཐབ་འཁྲུག་ཤུགས་ཆེན་བྱས་རྗེས་སྨར་ཁམས་དམག་རྣམས་བྲག་གཡབ་ཀྱི་ས་ཐོག་ཕྱིར་འཐེན་བྱས།",
    "དེ་ལ་ཞིབ་འཇུག་གནང་རོགས་ལབ་པ་དང་།",
    "ཅེས་བཀའ་གནང་བྱུང་།",
    "རྒྱ་མིས་བོད་ལ་བཙན་འཛུལ་བྱས་པ་ནས་བཟུང་བྲག་གཡབ་ཀྱིས་བཙན་རྒོལ་རྒྱལ་སྐྱོབ་དམག་འཁྲུག་རྒྱག་རྒྱུའི་ཐབས་ཇུས་བཀོད་ཡོད་པ་ནི།",
    "ཁྱེད་ཀྱིས་ནུས་ལྡན་གྱི་རྒྱ་མིར་ལན་རྒྱབ་པར་མ་ཟད།",
    "དེ་འོག་མགྲོན་ཆེ་བསྟན་པ་མཁྱེན་རབ།",
    "ལྐོག་བརྔན་ཟ་བ་བཅས་མི་ཆོག་༣དམག་མིས་ངེས་པར་དུ་དམག་དཔོན་གྱི་བཀོད་འདོམས་ལ་ཉན་དགོས།",
    "ཤོ་སྦག་རྒྱག་པ་བཅས་མི་ཆོག་༥གསོན་བཟུང་བྱས་པའི་དགྲ་དམག་དང་མགོ་བཏགས་ཞུ་མཁན་བྱུང་རིགས་ལ་རང་དམག་དང་འཚོ་བ་གཅིག་མཚུངས་སྤྲོད་དགོས།",
    "དམག་སྒར་ཚང་མར་ཁྱབ་པར་བསྒྲགས་པ་དང་།",
    "གྲྭ་ཤག་དང་ལྷ་ཁང་སྟོང་པའི་ནང་ལ་མེ་མདའ་བརྒྱབ་ནས་ལྷ་སྐུ་དང་མཆོད་གཤམ་སོགས་བཅག་གཏོར་བྱས།",
    "སྐྲ་དུང་ལྟར་དཀར་བའི་གྲྭ་རྒན་བློ་བཟང་ཉལ་ས་ནང་བསྡད་ཡོད་ཀྱང་མེ་མདའ་རྒྱབ་ནས་བཀྲོངས།",
    "ཡུད་ཙམ་ཞིག་ནས་མི་གཅིག་ཚུར་ཡོང་ནས་ང་ལ་ལྟ་ཡག་ཅིག་བྱས་ཏེ་བག་ལེབ་གསུམ་ང་ལ་སྤྲད་དེ་ཁམས་སྐད་ཐོག་ནས།",
    "བྲག་དམག་རྣམས་ལ་རྟ་སྒ་རྒྱག་ལོང་དང་རྟ་བཞོན་ལོང་མ་བྱུང་ཡང་སོ་སོའི་མེ་མདའ་ཁྱེར་ཏེ་རྒྱ་དམག་ལ་རྒོལ་འཛིང་བྱས།",
    "ལག་མདའ་ལན་ཁྲུ་བརྒྱབ་རྒྱུའི་གྲ་སྒྲིག་བྱས་ཏེ་མགོ་བཏགས་ཀྱི་ཡིན་ལུགས་བརྗོད་པ་དང་།",
    "དམེ་སྟོད་ཀྱི་རྟ་དམག་༡༤ དང་བརྒྱ་དཔོན་སྐལ་བཟང་བཅས་ཕྱིར་གཏོང་བྱས།",
    "བྱམས་སྐྱོང་བྱས་ཆོག་ཅེས་འབོད་པ་བརྒྱབ།",
    "བྲག་དམག་ཚོས་བོད་མདའ་བརྒྱབ་རྒྱུ་དེ་གཙོ་བོ་བྱས་ཏེ་བོད་མདའི་རྫས་དུད་ཀྱིས་བར་སྣང་ཁྱབ།",
    "རྒྱ་དམག་མང་པོས་ཕྱོགས་ཡོངས་ནས་མེ་མདའ་དང་ལག་འབོམ་བརྒྱབ་སྟེ་ཚུར་རྒོལ་ཤུགས་ཆེན་བྱས།",
    "ཁི་ལ་ལྡེ་འཆང་ལ་ཚེ་བཙོན་གྱི་ཐག་གཅོད་བྱས།",
    "སྦི་ཐི་སྦང་ནས་མེ་མཆེད་མ་ཐུབ་པར་བརྟེན།",
    "དེ་འཕྲོས་རྣམས་ཕྱིར་བྲོས་བྱས།",
    "ད་དུང་ཡི་གེའི་ནང་ལྷ་སར་ཟིང་འཁྲུག་ཞོད་འཇགས་བཏང་ཟིན་པ་དང་།",
    "རྒྱ་དམག་ཚུ་རིར་དོན་བྱུང་ན་དམར་འཛིང་བྱེད་རྒྱུའི་སེམས་ཐག་བཅད་ནས་བསྡད།",
    "༣བྲག་གཡབ་ཤར་ཕྱོགས་སུ་དཔུང་འཇུག་བྱས་པ།",
    "ལ་ཞེས་པའི་ལ་ཐོག་ཏུ་ལྷ་སྲུང་འབྲོག་པའི་དམག་ལ་བརྒྱ་དཔོན་བྱམས་པས་བཀོད་འདོམ་འོག་རྒྱ་དམག་ལྔ་བརྒྱ་ཙམ་དང་འཐབ་འཁྲུག་ཉིན་མཚན་གཉིས་ཙམ་བྱས་ཀྱང་རྒྱང་ཐག་རིང་བའི་རྐྱེན་གྱིས་རྒྱ་དམག་ག་ཚོད་བསད་མིན་མ་ངེས།",
    "མངའ་རྒྱུད་ཡུལ་པའི་བརྒྱ་དཔོན་བཀྲ་ཤིས་མགོན་པོས་བཀོད་འདོམ་བྱས་པའི་འོག་ཞལ་དཀར་ཞེས་པའི་རིའི་ཐོག་རྒྱ་དམག་དང་ཛ་དྲག་ཆེན་པོས་དམར་འཛིང་ཉིན་གང་བྱས་ཏེ་རྒྱ་དམག་ཁ་ཤས་བསད་རྨས་བཏང་བ་དང་།",
    "དེར་འབྱོར་མ་ཐག་རྒྱ་དམག་དང་འཐབ་འཛིངཤུགས་དྲག་ཆེན་པོ་བྱས་ཏེ་རྒྱ་དམག་ཉི་ཤུ་སུམ་ཅུ་ཙམ་བསད་པ་དང་།",
    "རྒྱ་དམག་ཕྱིར་འཐེན་བྱས་པ་དེ་ནི་དམག་ཇུས་ཀྱི་གཡོ་སྐོར་བཏང་བ་ཡིན་སྟབས་ལམ་ཁ་གཡས་གཡོན་གཉིས་ནས་རྒྱ་དམག་མང་པོ་སྒུག་ཡོད་པའི་བར་དུ་བྲག་དམག་ལྔ་བཅུ་དྲུག་ཅུ་ཙམ་ཚུད་པ་དང་རྒྱ་དམག་ཚོས་དུས་གཅིག་ཏུ་གཡས་གཡོན་གཉིས་ནས་མེ་མདའ་སེར་བ་བབས་པ་ལྟར་རྒྱབ་ནསལ་གཤིས་བརྒྱ་དཔོན་སྒྲོ་བེ་ཨ་བོའི་རྐང་པ་བཅགས།",
    "ཐག་རིང་ཙམ་གྱི་རི་ཞིག་བཟུང་ནས་འཐབ་རྒོལ་བྱས་ཀྱང་འཁྲུལ་མདའ་ཉུང་ཤས་ཡོད་པ་རྣམས་ཀྱི་མདེའུ་རྫོགས་པ་དང་།",
    "འཕྲོས་ལུས་བྲག་དམག་རྣམས་བྲོས་ཅི་ཐར་བྱས།",
    "ཐེངས་གཅིག་གཉིས་ཙམ་བྱས་ཀྱང་ཁས་མ་བླངས།",
    "དེའི་སྔོན་ཙམ་ནས་བྱམས་མདུན་བླ་བྲང་དང་དཔོན་ཁག་རྣམས་ཀྱི་ཁང་པར་སྒོ་ཐེལ་བརྒྱབ་ནས་མི་རྣམས་ཁང་པའི་ཁེབས་འོག་སོགས་ལ་སྡོད་བཅུག་ཡོད།",
    "བསད་རྨས་ཁ་ཤས་བྱས།",
    "དཔེར་ན་ལྷ་སྲུང་ཡུལ་པའི་ནང་རྒྱ་དམག་སྟོང་ཕྲག་ཙམ་བྱུང་བ་དེ་ཚོས་རྟ་སྡུག་པ་ཁ་ཤས་མ་གཏོགས་ཚང་མ་ཁྲིད།",
    "བྲག་གཡབ་རྒྱ་ཧྲད་གཉེར་པ་དང་མཛོ་ཐང་སྟོབས་རྒྱལ་གཉིས་ཀྱིས་དམག་དཔོན་བྱས་པའི་རྩལ་བཟང་ཡུལ་འབྲོག་གཉིས་ཀྱི་རྟ་དམག་སུམ་བརྒྱ་ལྷག་ཙམ་ལ་བརྒྱ་དཔོན་སྐལ་བཟང་བཀྲ་ཤིས།",
    "རྒྱ་དམག་དྲུག་བརྒྱ་བདུན་བརྒྱ་ཙམ་གྱིས་ས་དེ་བཟུང་སྟེ་རི་སྟེང་དུ་འཛིང་རགས་བཟོས་ནས་འགོག་སྲུང་བྱས།",
    "ངའི་འཁྲིས་ལ་ཡོད་པ་ལྷ་སྲུང་ཡུལ་པའི་ཞལ་ངོ་ཆུང་རྒྱུད་འཇམ་དབྱངས་བློ་གྲོས་དང་།",
    "དེ་ནས་རྒྱ་དམག་ཚོས་སྔར་ལས་ལྷག་པའི་མེ་མདའ་མང་པོ་བརྒྱབ་པ་དང་མེ་སྒྱོགས་རྒྱུན་མ་ཆད་པར་གང་སར་བརྒྱབ།",
    "དེར་དཔའ་མ་ཞུམ་པར་འཛིང་དང་རྒྱལ་ཁ་རང་ལག་ལ་ཡོད།",
    "དཔོན་གཡོག་ལྔ་པོ་སྦྲ་ནང་ཉལ་བསྡད་ཡོད་ཀྱང་མྱུར་བར་ལངས་ནས་མེ་མདའ་ཁྱེར་སྟེསྦྲ་སྒོར་ཐོན་པ་དང་རྒྱ་དམག་ནོར་ལྷས་ནང་བསླེབས་ཚར།",
    "ཇ་བསྐོལ་བ་སོགས་བྱེད་བཞིན་པའི་སྐབས་དེར་བློ་ཡུལ་དུ་མེད་པར་རྒྱབ་ཕྱོགས་ཀྱི་རི་སྒང་ནས་མེ་སྒྱོགས་ཀྱི་སྒྲ་བསྟུད་མར་གྲགས་ཤིང་མདེའུ་དམག་སྒར་ཐོག་ཏུ་ལྷུང་བྱུང་།",
    "དེ་དགོང་མཚན་འགྲུལ་བྱས་ནས་ཡོང་བའི་ལམ་བར་དུ་གླིང་ཁ་བརྒྱ་དཔོན་འཆི་མེད་རྡོ་རྗེ་དཔོན་དམག་རྣམས་དང་ཐུག་བྱུང་།",
    "འབོམ་དབྱུག་པ་སོགས་གང་ཡང་བྱས་མ་བྱུང་།",
    "ཉིན་བཞི་པའི་ཐོག་ལྷ་སྲུང་འབྲོག་པའི་རུ་བའི་ཐོག་གནམ་གྲུ་འཕུར་ཡོང་བ་དང་ཟོག་ཚང་མ་འབྲོག་ས་ནས་ཕྱོགས་གཅིག་ལ་ནག་ཉིལ་ཉིལ་དུ་འགྲོ་བའི་སྟེང་དུ་གནམ་གྲུས་མཐུ་གཞུར་གྱིས་མདའ་ཆར་ཕབས་པ་དང་འབར་མདེལ་ཆེན་པོ་དེ་འདྲ་ཉིན་གསུམ་ལ་བརྒྱབ་ནས་ཕྱུགས་ཟོག་བརྒྱ་ཕྲག་ཁ་ཤས་བསད་པ་དང་།",
    "དེ་ནས་བཟུང་ཕྱོགས་གཅིག་ནས་སྐུལ་སློང་གཏོང་བ་དང་ཕྱོགས་གཞན་ཞིག་ནས་འཐབ་འཛིང་གཏིང་ཇེ་ཟབ་དང་དྲག་རྩུབ་ཇེ་ཆེར་བྱས་པ་མ་ཟད།",
    "ཡར་ཐོན་པ་ཟེར་བའི་བོད་མི་ཁ་ཤས་ལ་གྲི་དང་མེ་མདའ་སྤྲད་ཐོག་གཞན་གྱི་རྒྱུ་ནོར་འཕྲོག་ལེན་བྱས་པ་ནས་ཁོ་ཚོར་བརྔན་པ་སྤྲད་པ་སོགས་བྱས།",
    "ལོ་ཤས་སྔོན་ལ་འདིར་གཉེན་འཕྲད་ལ་གཅིག་ཡོང་ནས་ཉི་མ་ཁ་ཤས་བསྡད་མྱོང་།",
    "ཉེས་རྡུང་བཏང་ནས་དྲན་མེད་དུ་བརྒྱལ་དུས་ཆུ་གྲང་གཤོས་ཏེ་སོས་ཐབས་བྱས།",
    "གལ་སྲིད་གཉེན་སྒྲིག་མ་བྱས་ན་འཐབ་རྩོད་དང་།",
    "དང་ལེན་མི་བྱེད་མཁན་རྣམས་ལ་ཉེས་རྡུང་དང་བཙོན་བཅུག་བྱས།",
    "ཕབས་པར་བརྟེན་མཐར་བཟའ་ཟླ་སྒྲིག་དགོས་བྱུང་བ་དཔེར་ན།",
    "ལྷ་སྲུང་འབྲོག་པ་ཝ་ལ་བཀྲ་ཤིས།",
    "དཔའ་ལུ་བཀྲིས་མགོན་པོ་གསུམ་ནི་རང་འགུལ་གྱིས་མགོ་བཏགས་ཞུས་པ་ཡིན་སྟབས་ཆབ་སྲིད་བརྩོན་ལེན་བྱེད་པར་འགྲོ་དགོས་ཞེས་རྒྱ་དམག་སུམ་བརྒྱ་བཞི་བརྒྱ་ཙམ་དང་མཉམ་དུ་ལྷ་སྲུང་ཡུལ་འབྲོག་ནང་ཁྲིད།",
    "མ་འདས་རོགས་ཞུས་ཀྱང་ཞལ་བཞེས་མ་གནང་།",
    "སླར་ཡང་རྒྱ་མི་དེའི་མེ་མདའ་ཚུར་བླངས་ནས་རྒྱག་གྲབས་བྱས་ཀྱང་།",
    "བདུད་མདའ་རིན་ཆེན་བསམ་འགྲུབ་སོགས་ཀྱིས་རྒྱ་དམག་ལ་དམར་འཛིང་དྲག་པོ་བྱས་ཏེ་རྒྱ་དམག་ཉི་ཤུ་སུམ་ཅུ་ཙམ་བསད་པ་དང་རྨས་པ་དེ་གྲངས་རྩིས་བྱས་མཐར་བདུད་མདའ་རིན་ཆེན་བསམ་འགྲུབ་དང་མི་གསུམ་བསད།",
    "བྲག་ཕུག་ནང་ཡོང་ནས་སྔར་བཞིན་བསྡད།",
    "དེ་ནང་ཟླ་བ་གཅིག་ཙམ་བསྡད་ཀྱང་ཧ་གོ་མཁན་མེད།",
    "རྒྱབ་སྣོན་རྒྱ་དམག་སུམ་བརྒྱ་ཙམ་འབྱོར་ཏེ་བྲག་ཕུག་ཁ་ལ་མེ་སྒྱོགས་བརྒྱབ་ནས་ཉིན་གཉིས་པར་རྒྱ་དམག་བཞི་བྲག་ཕུག་ཀྱི་ནང་དུ་ལག་འབོམ་དབྱུག་པར་བཏང་།",
    "དེས་རྐྱེན་བྱས་ཏེ་རྒྱ་དམག་མང་པོས་རྗེས་དེད་བྱས་ནས་རྫ་ཡུལ་ས་མཚམས་ལ་བརྒྱ་དཔོན་སྐལ་བཟང་བཀྲིས་གཙོས་མི་བཅུ་གཅིག་བསད།",
    "དེ་སྔོན་རྒྱ་མི་ཐོག་མར་ཡོང་དུས་ནས་བཟུང་ད་ལྟའི་བར་གྱི་གསང་བའི་གནས་ཚུལ་རྣམས་ཞིབ་ཕྲ་གསུང་པར་ཉན་རྒྱུ་བྱུང་།",
    "སོགས་ཀྱི་ཆར་དྲག་བབས་པ་ལྟར་བྱས།",
    "དེ་ནས་རྒྱ་མིས་རྗེས་དེད་མ་བྱས་པ་ཕན་ཚུན་གཉིས་ཀས་མེ་མདའ་རྒྱག་བཞིན་བསྡད།",
    "དེ་ནས་སྤྱི་མཛོད་རྒྱ་གར་དུ་ཕེབས་རྒྱུའི་གཏན་འཁེལ།",
    "དེའི་ཕྱི་ཉིན་དམག་སྒར་སྤོ་བསྐྱོད་བྱེད་པའི་སྐབས་དང་བསྟུན་ཏེ་གསང་སྟབས་ཀྱིས་སྐུ་འཁོར་རྣམས་ཕེབས།",
    "ཁོ་ཚོ་ལམ་གཞན་བརྒྱུད་ནས་སྨར་ཁམས་བསམ་པ་གྲུ་ཁའི་ཕྱོགས་སུ་ཕྱིར་ལོག་བྱས།",
    "དེ་ནས་བྱམས་མདུན་དུ་རྟ་དམག་དང་རྐང་དམག་ཆིག་སྟོང་ལྷག་ཙམ་འབྱོར་བ་དེ་ཚོས་ཟླ་བ་གཅིག་ལྷག་ཙམ་བསྡད།",
    "རྒྱུན་རིང་གྲ་སྒྲིག་བྱས་མཐར།",
    "དེ་ནས་རྒྱ་དམག་ཁག་བགོས་ཀྱིས་རི་གཤེར་ཡོང་བ་དང་ཐེངས་ཅིག་རྒྱ་དམག་བཞི་བཅུ་ཙམ་ཞིག་ལམ་གཡས་གཡོན་དུ་འཇབ་སྒུག་བྱས་ཏེ་ས་འགག་བཙན་པོ་ཞིག་བཟུང་སྟེ་སྒུག་རའི་ནང་དུ་འཛུལ་ཚར་བ་དང་མེ་མདའ་བརྒྱབ་སྟེ་རྒྱ་དམག་གཅིག་ཀྱང་མི་གཏོང་རྒྱུའི་དམ་བཅའ་བཞག་ནས་སྒུག་རྒྱ་དམག་རྣམས་སྒུག་སའི་དམིགས་ཡུལ་དེའི་ནང་མ་སླེབས་གོང་ནས་འཕྲིན་རྒྱལ་ཞེས་པའི་དམག་མི་དེས་སྦག་ཆུང་ཁ་ཤོར་བའི་རྐྱེན་གྱིས་རྒྱ་དམག་རྣམས་ཕྱིར་འཐེན་བྱས་པ་དང་།",
    "གཉིད་སད་པ་དང་ཁོ་ཚོ་ཚང་མ་ལངས་བཅུག་ནས་ས་ཁག་བཞི་ལ་ཚོ་བགོས་ཏེ་རྒྱ་དམག་བྱུང་ན་རྒྱག་ཆོག་ཆོག་བྱས།",
    "ཕྱི་ཉིན་རྒྱ་མིའི་རྟ་དམག་ཉིས་བརྒྱ་ཙམ་བྱུང་སྟེ་གྲོང་པ་དེའི་ནང་བསྡད།",
    "ད་དུང་གཡས་རིའི་ཕྱོགས་ནས་རྒྱ་མིའི་རྟ་དམག་མང་པོས་རྗེས་དེད་བྱས།",
    "དེ་ལ་དམིགས་བསལ་གྱི་སེམས་ཁྲལ་བྱེད་མི་འོས་ལ་སེམས་ཁྲལ་བྱས་ཀྱང་ཕན་ཐོགས་མེད།",
    "མི་སུམ་ཅུ་སོ་གཅིག་དེ་ཐབ་ཚོ་གཅིག་བྱས།",
    "དེ་ནས་ལུང་པ་གཞན་གཅིག་ནང་འཛུལ་ནས་བསྡད།",
    "ལུག་རྫིས་དོ་དགོང་ལུང་པ་འདིའི་མདའ་ལ་རྩམ་པ་དོ་པོ་གཅིག་དང་ཤ་མར་ཕྲན་བུ་ཁུར་ནས་ཡོང་དུས་རིན་པ་མེ་མདའ་གཅིག་སྤྲོད་དགོས་ཟེར་དོན་བཞིན་སྤྲད་རྒྱུ་བྱས།",
    "བཀྲ་ཤིས་ཀྱིས་རྒྱ་དམག་ལ་མེ་མདའ་ཚད་ནས་རྒྱག་གྲབས་སྐབས་ཕྱིར་བལྟས་བྱས་ནས།",
    "གཅུང་པོའི་ཕུང་པོའི་སར་སྡོད་ཀྱི་ཡིན་ལབ་པས་ཚང་མས་ང་ལ་འགྲོ་དགོས་པའི་སྐུལ་མ་བྱེད་པར་མ་ཟད།",
    "དེ་ནས་རོགས་པ་ཚོས་རང་ལ་སེམས་གསོ་ཡང་ཡང་བྱས།",
    "དེའི་རོགས་པ་གཅིག་བཅས་གཏན་འཁེལ་བྱས།",
    "སྟག་གཡག་སོགས་ལ་བསྡད།",
    "ལྷ་སྲུང་ཡུལ་པའི་རང་གྲུབ་ཁང་པའི་ནང་བཟུང་བའི་མི་རྣམས་འཐབ་འཛིང་བྱེད་བཞིན་པའི་སྐབས་གཙང་གསར་ཕྱག་མཛོད་གྲགས་པ་བློ་གྲོས་ཀྱི་གྱོན་ཆས་ཕུད་དེ་ཨུ་ཡོན་པད་མ་མགོན་པོས་གྱོན།",
    "ཐག་རིང་ཙམ་ནས་མེ་མདའ་བརྒྱབ་ནས་པད་མ་མགོན་པོ་བསད་པས་མི་ཚོས་ལྷ་སྲུང་མའི་ཆོ་འཕྲུལ་ཡིན་པར་བཤད།",
    "ཆར་པ་བབས་རྐྱེན་གྱིས་མི་ཕལ་ཆེར་གུར་ནང་འཛུལ་བསྡད་ཡོད་པ་དང་ཐུག་པས་གུར་ལ་གཏད་དེ་མེ་མདའ་ཆར་པ་བབས་པ་ལྟར་རྒྱབ་བྱུང་།",
    "ཁ་ཤས་ཀྱི་རྒོལ་འཛིང་བྱས།",
    "དགེ་འཕེལ་སོགས་ཀྱིས་རྒོལ་འཛིང་བྱས་ཏེ་རྒྱ་དམག་ཤི་རྨས་མང་ཙམ་བཏང་ཐུབ་པ་བྱུང་།",
    "ལོ་གཉིས་ཙམ་རིང་ལྷ་སྲུང་ཡུལ་འབྲོག་གཉིས་ཀྱིས་རྒྱ་དམག་ལ་རྒོལ་འཛིང་བྱས་ནས་དཔའ་བོ་མང་པོའི་སྲོག་ཤོར་ཡོད།",
    "བལྟས་ཏེ་མགོ་བཏགས་རྒྱུ་བྱས།",
    "གཞན་རྣམས་ལའང་དེ་དོན་གང་དགོས་ལྟ་རྒྱུའི་བཀོད་སྒྲིག་བྱས།",
    "མེ་མདའ་སྦག་ཆེན་དེ་ས་སྦས་བྱས།",
    "དམག་སྒར་འཐོར་ནས་རི་ལ་ཞག་བརྒྱད་དགུ་ཙམ་བསྡད་པའི་རིང་ཧ་ལམ་ཉིན་ལྟར་ཆར་ཞོད་ཆེན་པོ་བབས་ཅིང་གྱོན་ཆས་ཕྱི་ནང་ཚང་མ་རློན་པར་གྱུར།",
    "དེར་ཉིན་བཅུ་ལྷག་ཙམ་བསྡད།",
    "ཟ་ཆས་དང་གྱོན་ཆས་སྤྲད་པ་སོགས་བྱས་ཀྱང་།",
    "སྤྱི་བཤགས།",
    "རྐང་ཐང་བྱས་ཏེ་གོ་འཇོའི་ཕྱོགས་སུ་ཡོང་།",
    "གལ་སྲིད་སྒོ་བཅགས་ནས་ནང་ལ་འཛུལ་བྱུང་ན་རྒྱ་དམག་བསད་གང་ཐུབ་བྱས་ཏེ་རྒྱ་རྟ་བཞོན་ནས་བྲོས་གང་ཐར་བྱེད་རྒྱུ་དང་།",
    "དེ་ནས་ས་ཐག་རིང་ཙམ་ལ་རི་ལ་བྲོས་བྱས་པ་ཡིན།",
    "མི་གཅིག་མ་གཏོགས་དེ་མིན་བདུན་པོ་གྲོངས་བའི་གནས་ཚུལ་ཐོས་པར་སེམས་སྡུག་ཆེན་པོ་བྱུང་བ་དང་།",
    "སྔར་བྱས་ཉེས་པ་ལ་བརྩད་གཅོད་མི་བྱེད།",
    "ཕྱི་ཉིན་ངེད་གསུམ་གྱི་གྲོང་པའི་ནོར་ལུག་རྣམས་ལྷན་པོ་མཚས་ཟེར་བའི་གཡས་གཡོན་གྱི་རི་ཐང་མེད་པར་ཁྲ་ཆིལ་ལེར་བརྒྱབ་བྱུང་།",
    "དེ་ནས་ངས་མགོ་བཏགས་རྒྱུར་ཐག་གཅོད་བྱས།",
    "མདའ་དཔོན་དེས་ངས་རྟ་དམག་ཨང་དང་པོའི་ཚབ་བྱས་ཏེ་ཁྱེད་ལ་དགའ་བསུ་ཞུ་རྒྱུ་དང་།",
    "ངས་ཁོང་གཉིས་ལ་སྣེ་ལེན་དང་དགའ་བསུ་གནང་བར་ཐུགས་རྗེ་ཆེ་ལབ།",
    "གཙང་དག་གསུམ་སྟེ།",
    "ངས་དེར་འབྲི་རྩིས་བྱས་པས་ཐོག་ཁར་འགྲོ་ཟེར།",
    "འོན་ཀྱང་ཁོ་པ་བཙོན་འཇུག་བྱས་ཏེ་གནས་ཚུལ་ལ་བལྟས་ཏེ་ཐག་གཅོད་བྱེད་རྒྱུ་ཡིན།",
    "མྱོང་ཞིང་རྒྱུས་རྩ་བ་ནས་མེད་པ་ཞིག་ཡིན་ནའང་བཀོད་སྒྲིག་བྱས་པའི་མི་ཞིག་ཡར་ལངས་ནས།",
    "མཛེས་སྡུག་ལྡན་པའི་ཡུལ་ལུང་དང་ཐོན་ཁུངས་འཛོམས་པའི་ཞིང་ས་དང་ཁང་པ་ཤ་ཤེད་བཟང་བའི་ཕྱུགས་རིགས་སོགས་བློས་གཏོང་བྱས་པ་དང་།",
    "གོང་སྨོས་ལྟར་༡༩༦༡ ཟླ་༡༢ ཚེས་༡ ཉིན་བཙོན་འཇུག་ཁྱབ་སྒྲགས་བྱས།",
    "མཉམ་སྦྲེལ་རྒྱལ་ཚོགས་བཅས་སུ་རྒྱ་དམར་གྱིས་བོད་བཙན་བཟུང་བྱས་པས་མ་ཚད།",
    "བོད་མི་མང་པོ་གསོད་བཞིན་ཡོད་ལུགས་གསུངས་པ་དང་།",
    "གང་ཡང་མ་བཞག་པར་ཕུད།",
    "དེ་བཞིན་དྲིལ་བསྒྲགས་དང་རྒྱབ་རྡུང་ཐེངས་མང་བྱས་བྱུང་།",
    "ཡི་གེ་མེད་པར་གྱིས་ཟེར་བ་ལྟར་བྱས།",
    "རྒྱ་གར་གྱིས་དེ་ལས་ལྷག་པའི་ས་ཆ་མང་པོ་བཙན་བཟུང་བྱས་པ་ལ་བརྟེན།",
