    "མཛེས་སྡུག་སྣ་གཅིག་གི་ཡང་རྩེར་འཕགས་ཀྱང་།",
    "མི་ཉག་གི་མཛེས་འདོན་ད་བཟོད་ཁྱོད་ཁྱོད་དུ་གྲུབ་བོ།",
    "དེས་ན་ཁྱོད་ཀྱི་སྙན་དུ།",
    "ཁེངས་པའི་ཉམས་ཀྱིས་ཁྱོད་ཀྱི་མདུན་དག་ཏུ།",
    "ཏུན་ཧོང་སྒྱུ་རྩལ་གྱི་ཡང་རྩེའམ་མཚོན་བྱེད་དུ་འཇོག་པ་རྒྱ་སྐད་དུ་ཧཱིས་ཐེན་ཞེས་པ་མཁའ་ལ་འཕུར་པའི་ལྷ་མོའི་གཟུགས་རིས།",
    "སྙན་ངག་འདི་ནི་རྩོམ་མཁན་ཏུང་ཧོང་བྲག་ཕུག་ལ་གནས་སྐོར་ཏུ་ཕྱིན་པའི་མཐོང་སྣང་ཞིག་རེད།",
    "སྒྱུ་རྩལ་ནི་སྒྱུ་རྩལ་ལ་ཤེས་རྟོགས་དང་དེར་དུངས་ཞེན་ཟབ་མོ་ལྡན་པ་དག་གི་སྤྱོད་ཡུལ་ཡིན།",
    "སྐད་ཅིག་མར་རྟོགས་པའི་མཛེས་པ་དེ་ཚེ་གང་གི་དྲན་ཤིང་དུ་འགྱུར་བ་བཞིན།",
    "སྙན་ངག་འདི་བཀླགས་མ་ཐག་ང་ཚོས་སྐད་ཅིག་མར་རྟོགས་པའི་མཛེས་པ་དེས་རྩོམ་མཁན་གྱི་རྟོག་པ་བརྡོལ་ཅིང་བརྟན་ཆགས་ཀྱི་གཟུགས་རིས་ཤིག་སྒྱུ་རྩལ་གྱི་མཁའ་དབྱིངས་སུ་གར་དུ་མངགས་པ་ཤེས་ཐུབ།",
    "མཛེས་སྡུག་དར་གྱི་ཤམ་བུ་ལྷབ་ལྷུབ་ཏུ་གཡོ་བཞིན། ལྕུག་ཕྲན་ལུས་ཀྱི་ཟློས་གར་ནམ་མཁའ་ལ་སྒྱུར་བ་ཨེ་མ་མཁའ་ལ་རྒྱུ་བའི་འཆི་མེད་ཀྱི་བུ་མོ།",
    "སྨྱུག་རྩེ་དེས་རྒྱང་ནས་མཐོང་བའི་མཛེས་སྣང་གི་ཆ་བྱད་དེ་ཐོག་མར་བརྟན་ཆགས་ཀྱི་རི་མོ་ཞིག་ནས་རང་སེམས་ཀྱི་ཚོར་རྟོག་ལས་འགུལ་སྐྱོད་ཀྱི་རྣམ་པར་བསྒྱུར་ཅིང་རིམ་བཞིན་མཛེས་སྡུག་གི་བཞིན་དཔལ་ཞེས་ཉེ་ས་བཅར་ཏེ།",
    "མཐོང་བའི་མྱོང་སྣང་དེ་རྩོམ་མཁན་རང་གིས་མཛེས་པ་རྟོག་ཚོར་བྱུང་བའི་སྤྲོ་བ་བླ་ལྷག་གི་འཇིངས་སུ་ཞུགས་བཞིན་ཡིད་སེམས་སུ་བསླངས་པའི་བསྟོད་བསྔགས་ཟ་འོག་གི་རིས་སུ་བསྟར་འདུག་དེ་བས་རྩོམ་མཁན་གྱིས་མཐོང་བ་ནི་བརྟན་ཆགས་ཀྱི་གཟུགས་རིས་ཤིག་མིན་པར་མྱོང་རོལ་ཁྲོད་གར་དུ་ཆས་པའི་མཁའ་འགྲོ་སྟེ།",
    "གལ་ཏེ་ལྗང་བུའི་འབོད་པ་ལས་ང་ཚོར་འཁྲེང་སེམས་ལྕི་མོ་ཞིག་གི་ཁུར་བོ་བཀལ་ཡོད་ན།",
    "མཁའ་འགྲོའི་གཟུགས་རིས་ལས་ང་ཚོས་མྱོང་ཐུབ་པ་ནི་ན་ཆུང་མཛེས་མ་ཞིག་གི་སྨྲ་བསམ་བརྗོད་མེད་ཀྱི་གར་གྱི་སྟངས་སྟབས་ཡིན།",
    "སྙན་རྩོམ་འདི་ལས་ཀྱང་རྩོམ་མཁན་གྱིས་རང་གི་ཚོར་ཤེས་དེ་སྒྱུ་རྩལ་ཞིག་གི་མྱོང་རོལ་ལས་ཕྱིར་མཚོན་བྱས་ཡོད།",
    "ང་ཚོའི་བོད་པ་རྣམས་ལ་སྔ་མོ་ནས་གྲུབ་པའི་གོམས་གཤིས་ལྟར་ལྷ་ཞེས་མིང་ཙམ་ཐོས་པ་ནས་ཅི་ཡིན་ངེས་མེད་དུ་སྐྱབས་སུ་བཅོལ་བྱེད་ཀྱི་རྟེན་ཡུལ་མིན།",
    "ཨོ་ལགས་སོ་ཡིན་ནོ་བདེན་ཏོ་ཞེས་གཟུགས་མེད་ཀྱི་སྐྱབས་ཡུལ་ཞིག་ལ་རེ་བཅོལ་བྱེད་པ་ནི་གནའ་སྔ་མོ་ནས་ང་ཚོའི་གོམས་གཤིས་སུ་བག་ཏུ་ཉལ་ཡོད་ཀྱང་།",
    "ང་ཚོས་དེའི་བྱེད་པོར་དད་པ་ལས་གཟུགས་རིས་ཤིག་ལ་འདི་ཕྱིའི་སྐྱབས་སུ་འཛིན་པ་ནི་ཇི་འདྲའི་གླེན་རྟགས་ཚ་བ་ལ།",
    "དེར་བརྟེན་སྙན་ངག་པས་སྐད་ཆའི་ལམ་ནས་ང་ཚོར་གཟུགས་རིས་ཤིག་གི་སྣང་བརྙན་ཙམ་གྱི་བསྐྱར་པར་དེ་ཕྱིར་བཀྲམ་པ་ཙམ་མིན་པར།",
    "མི་རིགས་རང་གི་རྒྱུད་ན་ལུས་པའི་སྒྱིད་ལུག་བག་འཁུམས་ཀྱི་རང་གཤིས་དེར་ཡང་རྒོལ་རྡུང་དྲག་པོ་བྱས་ཡོད་སྙམ།",
    "དེས་ན་ཁྱོད་ཀྱི་སྙན་དུ།",
    "སྤྱིར་སྙན་རྩོམ་འདི་བཀླགས་མ་ཐག་ང་ཚོའི་ཉམས་སྣང་ཞིག་ལ་མཁའ་འགྲོའི་གཟུགས་རིས་དེ་སྐད་ཆའི་ལམ་བོད་ཀྱི་སྙན་ངག་གསར་བ་བདམས་དཔྱད།",
    "ནས་གསོན་ཉམས་ལྡན་པ་ཙམ་བཞེངས་སྐྲུན་བྱས་ཡོད་པ་ལས་གཞན་ཅི་ཡང་མེད་སྙམ་མོད།",
    "ཞིབ་མོར་བཀླགས་ན་ཚིག་བར་དུ་རྩོམ་མཁན་ལ་འཁུར་སེམས་ལྕི་མོ་ཞིག་དང་ཕྱིར་རྒོལ་གྱི་འདུ་ཤེས་བླ་ལྷག་ལྡན་པར་མ་ཟད།",
    "རང་གི་སྤུན་ཟླར་འཆང་བའི་ལྷག་བསམ་དང་ཞེ་བརྩེ་དེའང་ངང་ངམ་ཤུགས་ཀྱིས་རྟོགས་ཐུབ་པ་ཡིན།",
    "སྤྲོ་སེམས་ཀྱིས་རང་བློ་བསྒྱུར་པའི་དུས་རབས་དེར་མཚོན་ན་རང་ལྟ་འདི་ལྟར་མངོན་ཆུང་དུ་མཚོན་པ་ནི་སྙན་ངག་གི་སྒྱུ་རྩལ་མཚོན་སྟངས་ཐད་ཀྱི་འཕེལ་རྒྱས་སུ་རྩིས་ན་ཅིས་མི་ཆོགསྒྱུ་རྩལ་ནི་དཔེ་འགྲེ་མིན་པ་བཞིན།",
    "སྙན་ངག་འདིར་ལང་ཚོའི་རྦབ་ཆུའི་ཤན་ཅུང་ཐེབས་ཡོད་རུང་།",
    "གཡའ་ཤིང་གི་ལོ་མལྗང་བུ།",
    "གཡའ་ཤིང་གི་ལོ་མ་གཉིས་དམ་དུ་འཁྱུད།",
    "དམར་ཆུང་གི་སེམས་པ་གཉིས་གཅིག་ཏུ་བསྡོངས།",
    "སྐབས་དང་སྐབས་སུ་ཐོས་པ་ནིམེ་ཏོག་གི་འདབ་མ་ལྷུང་བའི་སྒྲ་དང་།",
    "འདི་ནི་ན་ཆུང་ཞིག་གི་ཐོག་མའི་དུངས་བརྗོད་ཀྱི་སེམས་གཤིས་སྟེ།",
    "ཐོག་མའི་སྟབས་ཀྱིས་ཐད་ཀར་འདོད་འདུན་མངོན་གསལ་དུ་མཚོན་པའི་སྤོབས་པ་དང་བྲལ་བས་ངོ་གནོང་དང་དོགས་གནསསེམས་ཆུང་གི་ཡིད་ཉམས།",
    "ལྷག་དོན་ཐོག་མ་འདིའི་ཡིད་འོང་གི་ཉམས་སྣང་དེ་སོ་ལྟ་དང་གཟབ་ཉན།",
    "ཞེས་ཕན་ཚུན་གྱི་འདོད་འདུན་དེ་ཕྱི་དངོས་ཀྱི་རྐྱེན་དང་བསྟུན་ནས་དོགས་གནས་ཤིག་གིས་མཛེས་པོར་འཁྲིད་བཞིན།",
    "ཕན་ཚུན་ལ་གཅེས་སེམས་ཀྱིས་ཟིན་པའི་སྤྱོད་སྟངས་དེ་ཡང་སེམས་ཞིབ་མོར་བག་ཡོད་དུ་ག་ལེར།",
    "ཐུན་མོང་དུ་གྱུར་པ་དེར་ཐུན་མོང་མ་ཡིན་པའི་ཟིལ་ཤུགས་ཤིག་མངའ་སྟེ།",
