    "མ་མཐའ་ཡང་དེ་དག་གི་སྐོར་གྱི་རྒྱུན་ཤེས་ཀྱི་རྨང་གཞི་མཐུག་པོ་ཞིག་འཛོམས་ཚེ་ད་གཟོད་དགོས་ངེས་ཀྱི་ལག་ཆེ་རང་ལ་ཡོད་པར་གྱུར་པ་ཡིན།",
    "རྒྱུན་མང་བོ་ཞིག་གི་མྱུ་གུའང་ཡུལ་གྲུ་མང་བོར་འབུ་བཞིན་ཡོད།",
    "བསམ་བློའི་རྫོབ་པོའི་གྲིབ་ནག་གི་རིགས་ཞུགས་ཤིང་ཁེལ་པ་ཅན་ཡོད་དེ།",
    "དེའི་ཕྱིར་རང་ཉིད་ཁྱིམ་གྱི་གྲུ་ཁའི་ཐལ་གཞོང་ནང་གི་གད་སྙིགས་སུ་སོང་བ་མིན་ནམ།",
    "སྨྱོ་ལབ་མྱོས་གཏམ་ཡིན་ན་གཞན་གྱིས་བརླམས་ཤིང་ཆང་རག་གིས་ཤེས་པ་ཡོངས་སུ་ཉམས་པར་བྱས་པས་སོ་ལྟ་དང་གཟབ་ཉན།",
    "དེ་དག་གི་ལབ་བརྡོལ་ལ་དམིགས་ས་གཏད་ཡུལ་ཅི་ཡང་མེད་ན་འགྲེལ་མེད་པའང་ཤིན་ཏུ་བདེན།",
    "སྤྱིར་ཚོགས་གསུམ་གྱི་ངོ་བོར་གྲུབ་པ་གང་ཞིག་ནང་རྒྱུ་ཕྱི་རྐྱེན་དག་གིས་བསྒྱུར་པས་རྣམ་པ་དང་སྣང་ཚུལ་ཕུན་སུམ་ཚོགས་པ་འབྱུང་ལ།",
    "དེ་ནི་ཚིག་རྣམས་སྔ་ཕྱིའི་འགྲེལ་དང་སྐབས་བབ་སྟོབས་ཀྱིས་གཞན་དང་གཞན་ལ་འབྲེལ་ནས་འགྲོ་རྒྱུ་ཡོད་པས་སྐྱེད་འབུད་པའི་ཆ་ཞིག་ཡོད་པ་མངོན་མོད།",
    "གཞུང་ལུགས་ཡང་དག་གི་ཁྲིད་སྟོན་ལ་མ་བརྟེན་པར་འོལ་ཚོད་ཀྱིས་ང་ཚོ་གར་ཡང་མི་ཕྱིན་པའི་ཚུལ་འདི་རྟོགས་གལ་ཆེ་ལ།",
    "ཁྱད་པར་དུ་ལམ་ལོག་ལ་གོལ་ན་ཕྱིར་ལྡོག་པར་དཀའ་བ་དང་གནོད་པ་བརྗོད་ཀྱིས་མི་ལང་བའི་ཚུལ་རྣམས་གཞར་ཡང་ང་ཚོའི་གཞེན་སྐུལ་གྱི་ཅོང་བརྡར་འགྱུར་རྒྱུ་དེ་བས་ཀྱང་གལ་ཆེ་བར་སྙམ་མོ།",
    "རྩོམ་མཁན་རླབས་ཆེན་ཡིན་མིན་ཐག་གིས་གཅོད་མཁན་ཡིན་ལ།",
    "དེའི་ཐད་རྩོད་པ་སྤྱིར་བཏང་གིས་མེད་མོད།",
    "རྩོམ་པ་ཕུལ་བྱུང་དུ་ངང་གིས་སོང་བ་ཡིན་ནོ།",
    "དཔྱད་པ་ཕྲན་བུ་རེ་རེའི་ཆིངས་སུ་བརྗོད་དོན་ཚང་བར་དམ་པོར་བྱས་ཡོད་པ་རྐྱང་རྐྱང་རེད།",
    "བརྗོད་བྱ་ཚིགས་བཅད་སྙན་ངག་དང་ལུགས་གསར་སྙན་ངག་གི་ལུས་ལ་བརྟེན་པའི་འཇིག་རྟེན་དུངས་ཀ་བརྗོད་པ་ཅན་དང་།",
    "མི་ཚེའི་གནས་ལུགས་ཟབ་མོ་ཅན་བརྗོད་པ།",
    "སྐྱོན་ཡོན་གཉིས་ཀར་མཛུབ་མོ་རི་སྟོན་ཙམ་མིན་པར་མིག་ཐོགས་ལག་ཟིན་དུ་སྟོན་པར་བྱེད་པ།",
    "སྐད་ཆ་ནི་བསམ་གཞིག་གི་ཐད་ཀར་མཚོན་བྱེད་ཡིན་ལ།",
    "༩ སོ་ལྟ་དང་གཟབ་ཉན་གྱིས་སྙན་ངག་པ་དང་སྙན་ངག་ལ་སྤྲོ་བ་རྣམས་ཀྱི་བར་དུ་གཅིག་གིས་སེམས་ནང་གི་རིག་པ་དང་བརྩེ་བའི་འོད་སྣང་སྤྲོ་བྱེད་དང་།",
    "ཅིག་ཤོས་ཀྱིས་དེ་འདྲའི་འོད་ཀྱི་རྦ་རླབས་སྡུད་པར་བྱེད་པ་ལ་མཛའ་གཅུགས་དར་ལིང་རིང་མོ་ཞིག་འཐེན་པའི་ལས་སུ་ཡོངས་ནས་ཞུགས་པ་ཡིན་པས།",
    "སྐད་ཆའི་བཀོལ་སྤྱོད་སོགས་རེ་རེ་བཞིན་དཔྱད་པ་གཏོང་བའི་སྲོལ་དོར་ཡོད་པར་མ་ཟད།",
    "འབྲེལ་མེད་ཀྱི་ཨ་ལོང་ཡང་ལོང་སྦྲེལ་བར་བྱེད་པའི་རིགས་ཀྱི་སྐྱོན་མཚང་གི་ངང་ཚུལ་རྣམས་འགོག་ཆེད་ཡིན་པ་སྨོས་ཅི་འཚལ།",
    "འགྱུར་ཁུགས་སྙན་པའི་རོལ་མོའི་འཇེབས་པ་དེ་ཅུང་ཙམ་ཞན་ནའང་།",
    "ཞན་ཆ་ཆུང་ངུ་དེའི་རིགས་རང་ཉིད་འཕེལ་རྒྱས་སུ་འགྲོ་བའི་གོ་རིམ་ཁྲོད་ངང་གིས་སེལ་བར་འགྱུར་བའང་གདོན་མི་ཟ།",
    "དཔྱོད་པ་པོ་བཅས་ཀྱིས་ཐུན་མོང་གི་སྟོབས་ཤུགས་འདོན་དགོས་པ་དང་།",
    "རྩོམ་རིག་ཞིབ་འཇུག་དང་དཔྱད་བརྗོད་ཀྱི་ལས་དོན་ལ་མོས་པ་ཆེ་ཞིང་བློ་ཁ་བརྟན་པོར་ཡོད་པས་ལོ་འདི་འགའི་རིང་ལ་གྲུབ་འབྲས་མི་དམན་པ་བླངས་དང་ལེན་བཞིན་ཡོད་ཅིང་།",
    "དཔེ་དེབ་རིན་ཐང་གི་ཁྱོགས་པ་འདི་བསྐྲུན་པ་དང་ཡོངས་ཁྱབ་ཏུ་བཀྲམ་པའི་རྨང་གཞིའི་ཐོག་བོད་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་ལས་དོན་ལ་སྔར་ལས་ཆེ་བའི་སྟོབས་ཤུགས་འབུལ་རྒྱུ་དང་སྔ་མོ་ནས་རྩོམ་རིག་དཔྱད་བརྗོད་ཐད་ཀྱི་མཁས་ཆེན་དུ་འགྱུར་རྒྱུའི་རེ་བ་ཆེ་ལགས།",
    "ལང་ཚོའི་རྦབ་ཆུ།",
    "ཆལ་ཆིལ་དུ་འབབ་པའི་རྦབ་ཆུ་རེད།",
    "ཟ་འོག་གི་རི་མོ།",
    "ལང་ཚོའི་གླུ་དབྱངས་ནི་དྲི་ཟའི་གླུ།",
    "སྙན་ཞིང་འཇེབས་པའི་གླུ་འདི་ནི་བོད་གངས་ཅན་གྱི་གཞོན་ནུ་རྣམས་ཀྱི་ལང་ཚོའི་རྦབ་ཆུ་རེད།",
    "འཐབ་འཛིང་གི་ཉམས་འགྱུར།",
    "ལང་ཚོ་ཡི་གླུ་སྒྲ་རེད།",
    "རྦབ་ཆུ་ཡི་ལང་ཚོ་ཡ།",
    "ལང་ཚོ་ཡི་རྦབ་ཆུ།",
    "རེད་ལགས།",
    "ངམ་གྲོག་གི་གཡང་ལས་མཆོང་བར་སྤོབས།",
    "ཁྱེད་ལ་གསར་བྱུང་གི་ཆུ་སྣ་བསྡུ་བའི་སྤོབས་པ་དང་ལྡན་པས།",
    "ཁྱེད་ཀྱི་ལུས་སེམས་གཙང་ལ་ལང་ཚོའི་དཔལ་ཡོན་རྒྱས།",
    "དུག་མ་འོངས་པའི་ལམ་འདྲེན་རེད།",
    "ང་ཁྱེད་ཀྱི་དྲི་མ་བྲལ་བའི་ཆུ་ཐིགས་རེ་རེའི་ནང་དུ།",
    "ཁྱེད་ཀྱི་གཟེགས་མ་འབར་བའི་རྡུལ་ཕྲན་རེ་རེའི་ནང་དུ།",
    "རྙིང་ཞེན་གྱི་རྡུལ་ཕྲན་སོགས་མཆིས་ཀྱང་སྲིད་མོད།",
    "ཁྱེད་ལ་ལང་ཚོའི་རྔམ་བརྗིད་དང་སྐྱེས་སྟོབས་ཀྱི་དཔལ་དང་ལྡན་པས།",
    "དགུན་དསུམ་གྱི་བཙག་གིས་ཁྱེད་ཀྱི་སེམས།",
    "ཁྱེད་ཀྱི་དུས་རབས་ཀྱི་བཞུར་སྒྲ་སྙན་མོསང་ཚོ་ལ་སྐུལ་མ་དང་སྟོབས་ཤུགས་བསྩལ་བྱུང་གསན་བྱུང་ངམ་རྦབ་ཆུ་ལགས།",
    "ལག་རྩལ་གྱི་བུ་མོ་བག་མར་བསུ་ན་ཁྱོ་བོ་སུ་ཡིས་བྱལགས་སོ་རྦབ་ཆུ་ལགས།",
    "ཁྱེད་ཀྱི་དྭངས་ཤིང་གསལ་ལ་སྙན་ཞིང་འཇེབས་པའི་གླུ་སྒྲ་ལས་བྱུང་བའི་ལན་དེ་དག་ང་ཚོའི་སེམས་སུ་རྡོ་ལ་རི་མོ་བརྐོས་པ་ལྟར་བཟུང་ཡོད།",
    "བ་ཚྭའི་དྲི་དང་འགྲོགས་པའི་ཁ་སང་གིས་དེ་རིང་གི་སྐོམ་པ་ག་ལ་སོད།",
    "ལང་ལོང་འཐོར་བའི་གཟེགས་མ་ལས་ང་ཚོ་སྟེ།",
    "ལེ་ལོ་ང་ཚོའི་མི་རབས་འདིར་འཇུག་ཡུལ་གཏན་ནས་མེད།",
    "མུན་ནག་ལོག་སྤྱོད་ང་ཚོའི་དུས་རབས་འདིར་གནས་ས་ཡེ་ནས་མེད།",
    "ང་ཚོའི་སེམས་ནི་ཁྱེད་ཀྱི་འགྲོས་དང་བསྟུན་ནས་གཡོ་བ་དང་།",
    "ང་ཚོའི་ཁྲག་ཀྱང་ཁྱེད་ཀྱི་རྒྱུན་དང་འགྲོགས་ནས་བཞུར་གྱིན་ཡོད།",
    "ང་ཚོས་རང་རེའི་མི་རིགས་འདིར།",
    "བོད་གངས་ཅན་གྱི་མི་རབས་གསར་བ་རེད།",
    "བོད་གངས་ཅན་གྱི་གཞོན་ནུའི་གོམ་སྒྲ་རེད།",
    "འཐབ་འཛིང་གི་གླུ་དབྱངས།",
    "རྦབ་ཆུའི་ལང་ཚོ་ལ་ཡལ་བ་མེད་ཅིང་།",
    "ལང་ཚོའི་རྦབ་ཆུ་ནི་དེ་བས་ཀྱང་ཉམས་པ་མེད།",
    "འདི་ནི་བོད་གངས་ཅན་གྱི་གཞོན་རབས་རྣམས་ཀྱི་ངག་ལས་བྱུང་བའི་ལང་ཚོའི་རྦབ་ཆུ་རེད།",
    "བོད་གངས་ཅན་གྱི་གཞོན་ནུ་རྣམས་ཀྱི་སེམས་ན་འབབ་པའི་ལང་ཚོའི་རྦབ་ཆུ་རེད།",
    "གངས་རིའི་ར་བས་བསྐོར་པའི་བོད་ཡུལ་འདི་གནའ་སྔ་མོ་ནས་སྙན་ངག་གི་ཞིང་ཁམས་དང་གླུ་གར་གྱི་རྒྱ་མཚོ་ཞེས་པའི་བསྔགས་ཡུལ་དུ་གྱུར་ཡོད།",
    "གནས་སྐབས་དེ་ལྟ་བུ་ནི་གཅིག་ན་དགའ་འོས་པའི་གྲུབ་འབྲས་ཤིག་ཏུ་འཁུམས་མོད།",
    "གཞན་ཞིག་ནས་བསམ་བློ་བཏང་ན་དེ་ནི་བོད་ཀྱི་སྙན་ངག་གི་སྐྱོ་གར་ཞིག་ཀྱང་ཡིན།",
    "ང་ཚོས་རྩོམ་ལུས་དེ་ལས་བརྒལ་ནས་གཞན་པའི་རྣམ་པའམ་ལག་ཐབས་ཤིག་བེད་སྤྱོད་པ་ལས་མུ་མཐུད་དུ་གསར་གཏོད་སོགས་མེད་པར་གཞིར་བཞག་དེ་ཁོ་ནར་འཇུག་ན་བོད་ཀྱི་སྙན་ངག་ནི་དུས་ནམ་ཡང་གྲུབ་འབྲས་ཤིག་གི་རྫོགས་ཚིག་ལས་གསོན་སྟོབས་བྲལ་བ་ཡིན།",
    "དབྱེ་མཚམས་དེའི་མཚོན་བྱེད་ནི་དཔལ་དོན་གྲུབ་རྒྱལ་ལགས་ཀྱིས་ལྟ་གྲུབ་ལས་བརྒལ་བའི་རང་གཤིས་ཀྱི་བཅིངས་འགྲོལ་ཅིག་ལས་ང་ཚོར་བཀྲམ་པའི་ལང་ཚོའི་རྦབ་ཆུ་ཡིན།",
    "ལང་ཚོའི་རྦབ་ཆུ་ནི་བདེ་སྐྱིད་དེ་ལས་བྱུང་བའི་འབོད་པ་ཞིག་གམ་རེ་ལྟོས་ཤིག་ཡིན།",
    "ཆལ་ཆིལ་དུ་འབབ་པའི་རྦབ་ཆུ་རེད།",
    "དུས་རབས་ཉི་ཤུའི་ལོ་རབས་བརྒྱད་ཅུ་ནི་ང་ཚོའི་མི་རིགས་འདི་ལ་མཚོན་ན།",
    "རང་གི་འཚོ་བབ་ལ་ཐོག་མའི་བློ་འབྱེད་བསམ་བློ་སྐྱེས་པ་དང་དེང་རབས་འདུ་ཤེས་ཀྱི་རྟོག་པ་སད་པའི་སྟ་གོན་གྱི་དུས་དང་རང་ཉིད་ངོས་ཟིན་པའི་སྔོན་འགྲོའི་དུས་སྐབས་ཡིན།",
    "ལང་ཚོ་ནི་དེའི་མཚོན་བྱེད་ཡིན།",
    "སྙན་རྩོམ་ཧྲིལ་བོར་ཚོར་ཤེས་དྲག་པོ་ཞིག་གིས་སྣེ་ཁྲིད་དེ་ཕྱི་བཀོད་ཀྱི་བརྗོད་ཡུལ་དང་ནང་སེམས་ཀྱི་འགྱུར་བ་གཉིས་བརྗོད་བྱའི་འགྲོས་དང་བསྟུན་ནས་འཕྱོ་ཞིང་།",
    "ཆུ་ཡི་བཞུར་སྒྲ་གསལ་ཞིང་སྙན་འཇེབས་ལྡན་ལ། ལང་ཚོའི་གླུ་དབྱངས་ནི་དྲི་ཟའི་གླུ།",
    "ལང་ཚོ་ནི་ཚེ་སྲོག་ཀུན་གྱི་འོད་འཚེར་བའི་དུས་སྐབས་ཡིན།",
    "ལང་ཚོ་ནི་འབྱུང་འགྱུར་ཅིག་གི་རེ་འདུན་ཡིན།",
    "གསར་བ་གང་ཡིན་ཀྱང་འབྲས་བུ་ཞིག་གི་དན་རྟགས་དང་གསར་བ་གཞན་ཞིག་གི་སྟ་གོན་ཡིན་པས།",
    "རྩོམ་མཁན་གྱིས་བོད་མིའི་མཛེས་དཔྱོད་ཀྱི་གོམས་གཤིས་ལྟར་དཔེ་འོས་འཚམས་རེ་སྦྱར་ཏེ་རྦབ་ཆུའི་ལང་ཚོའམ་གཞོན་ནུའི་ལང་ཚོ་དེའི་མཛེས་སྡུག་ཕྱི་རུ་བཀྲམས།",
    "ང་ཚོ་ལ་གཟི་བརྗིད་དང་སྟོབས་ཤུགས་བསྩལ།",
    "རེད་ལགས།",
    "ཁྱེད་ཀྱི་ལུས་སེམས་གཙང་ལ་ལང་ཚོའི་དཔལ་ཡོན་རྒྱས།",
    "སྙན་ངག་ཅིག་གིས་གནས་ལུགས་སམ་ཉམས་མྱོང་ཞིག་གཞུང་ལུགས་ལྟར་བརྗོད་ཐབས་བྲལ་བས།",
    "ལྷག་པར་དུ་འབྱུང་འགྱུར་གྱི་བདག་པོ་སྟེ་ན་གཞོན་དག་རྡོག་རྩ་གཅིག་སྒྲིལ་སྒོས་རྦབ་ཆུ་ལྟར་སྤོབས་སེམས་ཆེན་པོར་མདུན་ནས་མདུན་དུ་བསྐྱོད་པ་ནི་ཇི་འདྲའི་ལས་གལ་ཆེན་པོ་ཞིག་རེད་ཨང་།",
    "ང་ཚོ་སྟེ་གངས་ཅན་པ་རྣམས་དེང་གི་དུས་འདིར་ཡང་རོང་འབྲོག་དང་།",
    "མ་འོངས་པའི་ལམ་འདྲེན་རེད།",
    "རྩོམ་མཁན་གྱིས་འཁུར་སེམས་དྲག་པོ་ཞིག་དང་རེ་ལྟོས་ཆེན་པོར་རང་སེམས་ཀྱི་ཚོར་སྣེ་དེ་བསྡུས་བརྗོད་སྒོས་རྦབ་ཆུའི་ངོ་བོར་སྦྱར་ཏེ་ཁྱེད་མེད་ན་ཞེས་ན་ཆུང་རྣམས་ལ་འབོད་སྐུལ་དང་ལམ་སྣེ་བསྟན་པར་མ་ཟད།",
    "དུས་རབས་ཀྱི་མདུན་སྐྱོད་ཁྲོད་མི་སྒེར་རམ་ཐུན་མོང་གང་རུང་ཞིག་ལ་གུ་ཡངས་ཀྱི་སྐབས་གླགས་བྲལ་ཞིང་།",
    "ལྷག་པར་དུ་སྨིན་ཟིན་པའི་འབྲས་བུ་ཞིག་གིས་འབྲས་བུ་གསར་བ་ཞིག་གི་ཚབ་བྱེད་ཐབས་བྲལ་བས།",
    "བ་ཚྭའི་དྲི་དང་འགྲོགས་པའི་ཁ་སང་གིས་དེ་རིང་གི་སྐོམ་པ་ག་ལ་སོད།",
    "མི་རིགས་ཤིག་འཕེལ་རྒྱས་སུ་འགྲོ་བ་ལ་ན་གཞོན་ནི་རེ་ལྟོས་ཡིན།",
    "ན་གཞོན་ནི་མི་རིགས་ཤིག་གི་ཡོད་ཚད་དེ།",
    "བོད་མི་རིགས་ལ་མཚོན་ན་དཔལ་ཡོན་གསར་བ་ཞིག་གི་སྣེ་ལེན་དང་།",
    "སྤོབས་པས་ཁེངས་པའི་རེ་བ་ནི་ཚིག་འབྲུ་རེ་རེར་འཁོལ་ཞིང་།",
