    "བདག་ཅག་གི་བརྩེ་བ་མདུན་ན་ཉེ།",
    "སེམས་ནང་གི་རེ་སྒུག་མདུན་ལ་གཏོད།",
    "སེམས་ནང་གི་སྨོན་འདུན་མདུན་ལ་གཏོད།",
    "ཐུན་མོང་གི་སྣང་ངོར་དགུན་ནི་ཉམ་ཐག་པའི་དུས་ཚིགས་ཤིག་ཡིན་ལ།",
    "སྤང་ཐང་ཡངས་པོར་ཁ་བས་བཀླུབས་ཏེ་སྙན་ངག་གི་ཉམས་སྣང་ལྡན་ཡང་སྲོག་ལྡན་མང་བོའི་གཤེད་དུ་འགྱུར་ངེས།",
    "དེ་ལས་ལྡོག་ཏེ་སྤྲོ་སེམས་འཁོལ་བའི་རེ་ལྟོས་ཀྱིས་ཁེངས་ཡོང་བ་ཞིག་ཡིན།",
    "འདི་ལས་ང་ཚོས་མཐོང་ཐུབ་པ་ནི་སྐད་ཆའི་བཀོལ་སྤྱོད་ཅེས་པའི་བྱེད་ནུས་ག་འདྲ་ཡིན་པ་དང་།",
    "དུས་བཞིའི་འཁོར་ལོའི་བགྲོད་པའི་གུར་ཁང་ལ། དགུན་གྱི་བུ་མོས་དཔྱིད་ཀྱི་ན་ཆུང་སྦྲུམ་ཞེས་རྩོམ་མཁན་གྱིས་ཡར་སྐྱེད་ཀྱི་སེམས་པ་ཞིག་དང་།",
    "འབྱུང་འགྱུར་ལ་རེ་བས་ཁེངས་པའི་སེམས་འགྱུ་དེ་མི་སེམས་སྤྲོ་བའི་སྤོབས་པ་དང་བཅས་གསལ་ལྷང་ངེར་རྟོགས་པ་ལས་གཞན།",
    "མི་ཚེའམ་འཚོ་བར་འཆང་བའི་རྣམ་དག་གི་རྣམ་འགྱུར་དེ་མངོན་གསལ་དོད་པོར་མཚོན་ཡོད་པར་མ་ཟད།",
    "ཀྭ་ཡེ་གྲོགས་པོ་དག་སེམས་ནང་གི་སྨོན་འདུན་མདུན་ལ་གཏོད་ཅེས་ཚིག་ངོས་ལས་ཁ་གཡང་ཞིག་གི་ཕྱོགས་སུ་ལྷུང་བའི་དོགས་པ་འབྱིན་མོད།",
    "གོང་གི་ཚན་པ་དག་དང་སྦྲེལ་ན་རྩོམ་མཁན་གྱིས་རང་གི་འདོད་འདུན་དེ་ཐོག་མར་ཤོང་རྒྱ་ཆེ་བའི་སྒྱུ་རྩལ་གྱི་ཡུལ་ཁམས་ཤིག་ཏུ་བཞག་ནས།",
    "རེ་ལྟོས་ཀྱིས་ཁེངས་པའི་དཔྱིད་ཀྱི་ན་ཆུང་མངལ་དུ་སྦྲུམ་ཞེས་དུས་སྐབས་དེར་མཚོན་ན་ཏང་གི་ཡང་དག་ལམ་ཕྱོགས་དང་།",
    "དེར་བརྟེན་མཇུག་གི་ཚན་པ་དེའང་ངང་ངམ་ཤུགས་སུ་སེམས་ཁོང་ལས་བྱུང་བའི་དགའ་འབོད་ཅིག་དང་།",
    "དེ་སྤྱིར་སྙན་རྩོམ་འདི་ཐོག་མར་བཀླགས་མ་ཐག་ཕལ་བའི་ཚིག་གི་གོམ་འགྲོས་ལས་བརྗོད་བྱའང་མཛུབ་མོ་རི་སྟོན་གྱི་ཚུལ་དུ་སོང་མོད།",
    "ལྷད་མ་ཞུགས་པའི་སེམས་འདུན་དང་མངོན་ཆུང་གི་ཚིག་ཤུགས་ལས།",
    "སྨུག་པ་བན་བུན་གྱི་ཀློང་ན་རེ་བཞག་སྟོང་ཕྲག་གི་མྱུ་གུ་འབུ་བཞིན་ཡོད་པའི་ཚོར་སྣང་གསར་བ་ཞིག་སྦྱིན་འོངས་པ་རང་མ་ཡིན་ནམ།",
    "སྙན་རྩོམ་འདི་ལས་ང་ཚོས་བདེན་དཔང་བྱེད་ཐུབ་པ་ནི།",
    "འཚོ་བར་བསྐྱར་དཔར་ཙམ་རྒྱག་པའམ་ཡང་ན་སྒྱུ་རྩལ་གྱི་ལས་སྣོན་ཅི་ཡང་མེད་པར་དོན་མེད་ཀྱི་གླེང་མོལ་ལྟ་བུ་ཞིག་མིན་ལ།",
    "དེ་ལས་གཞན་ཚིག་གི་རྒྱུ་ཙམ་གྱི་དམ་ལྷོད་དམ་ཐབས་རྩལ་དུ་རློམ་པའི་བོད་མིའི་མཛེས་དཔྱོད་ཀྱི་གོམས་གཤིས་ལས་འགོངས་པའི་ཅི་ཡིན་ཆ་མི་འཚལ་བའི་བཟི་གཏམ་འབའ་ཞིག་དང་།",
    "ཡང་ན་ཚིག་གི་སྦྱོར་སྟངས་བརྡ་སྤྲོད་དང་འགལ་ནས་ཅི་ཡང་སྟོན་མི་ནུས་པའི་ཚིག་དུམ་འགའ་ལ་གོ་དཀའ་བ་ཞེས་པ་དང་སྙན་ངག་གོ་དཀའ་བ་གཉིས་གཏན་ནས་མི་འདྲའོ།",
    "སྲིད་པའི་རྩེ་མོ་རུ་གནས་བཅས་པས།",
    "བདག་གི་མཐོང་ཡུལ་དུ།",
    "མཚན་མོ་དེ་ལ།",
    "བདག་གིས་ཡང་ཡང་དཔྱད་ཀྱང་རྟོགས་ཨང་།",
    "ཁྱེད་ནི་ཁ་བ་ལྡིང་ཐེངས་གཅིག་གིས་བརྡིབས་ཤིང་ཉིལ།",
    "ལྷ་ས་ནི་ཕ་ཁུ་མང་བོའི་ཡིད་སེམས་ཀྱི་མཐར་ཐུག་གི་ལོག་མལ་ཅིག་ལྷ་ས།",
    "སེམས་ཁམས་སུ་མི་རབས་དུ་མར་བག་ཏུ་ཉལ་བའི་བསླུ་བྲིད་ཀྱི་གཡབ་མོ་ཞིག་ལྐོག་གྱུར་ལ་ནམ་ཡང་བསླུ་བྲིད་ཅིག་དང་།",
    "སྙན་རྩོམ་འདིའི་ཁྲོད་ལྷ་སའི་ཕྱི་རྣམ་གྱི་བཀོད་པར་ཞིབ་འབྲི་ཅི་ཡང་བྱས་མེད་མོད།",
    "ཤིག་ནན་མོ་ཚིག་གི་ཤུགས་སུ་སྐུང་།",
    "བདག་གི་མཐོང་ཡུལ་དུ།",
    "དེ་ལས་བྱུང་བའི་སེམས་བྱུང་དེ་ཕྱི་དངོས་ནས་བལྟས་ན་རང་སྣང་ཁེར་རྐྱང་གི་ཚོར་བ་དག་བསྟན་པར་སྣང་ཡང་།",
    "ཅེས་བློས་གཏོང་གི་སྤོབས་ཤུགས་སུ་སྡུག་བསྔལ་འབུམ་ཕྲག་གི་བང་རིམ་ཡང་བརྩིགས་ཡོད་ལ།",
    "རྩོམ་མཁན་གྱིས་དུས་དང་བར་སྟོང་གི་ཚད་བཀག་ལས་བརྒལ་ཏེ་གནས་སྐབས་དེ་ལྟ་བུ་འབྱུང་རྐྱེན་གྱི་འདྲི་གཞི་ཁྱེར་ཏེ་བྱུང་འདས་ལ་ལྡོག་འཇུག་སྟེ།",
    "དེང་རབས་དཔལ་ཡོན་གྱིས་གནམ་ས་བླ་འོག་བརྗེ་བའི་དེང་གི་དུས་འདིར།",
    "ང་ཚོའི་མཁྲེགས་འཛིན་དང་ཞེ་ལྷོད།",
    "བག་ཕབ་ནི་ཇི་འདྲའི་ཁེར་རྐྱང་ཞིག་གམ་ནུས་མེད་ཅིག་རེད་ཨང་།",
    "ཁེར་རྐྱང་གི་འབྱུང་རྐྱེན་དང་དེ་སེལ་སླད་ཁ་གཡང་ཙམ་གྱིས་རང་སེམས་མ་སྐོང་པར།",
    "སྙན་རྩོམ་འདིའི་བརྗོད་བྱའང་རིམ་པ་མཐོ་ཤོས་ཤིག་གི་གནས་སུ་སྐྱེལ་འདུག་སྙམ།",
    "འོས་འཚམས་ཀྱི་འབོད་སྒྲ་དུ་མས་བརྗོད་འདོད་ཀྱི་ཀུན་སློང་དེ་རིམ་བརྒྱུད་བྱས་ཐོག་རྟོག་འཆར་གྱི་ཕྱག་ཟུང་གིས་དྲངས་པ་ནི་ཁེར་རྐྱང་གི་ཡུལ་གྲུ་ཞིག་དང་།",
    "ལ་རྩེའི་དར་ལྕོག་དང་ཨ་མས།",
    "ཁྱོད་རང་བགད་མྱོང་ལ་ངུས་པའང་གྲངས་མེད།",
    "བདག་ཁྱོད་ལ་རྒྱུས་མངའ་མེད་ན་ཡང་།",
    "ངས་ཁྱོད་ཀྱི་གཏམ་རྒྱུད་བྲིས་ཆོགཔ་སངས་ལགསམི་ཚེ་ནི་དཀའ་སྡུག་གི་འགྲུལ་བཞུད་ཐེངས་ཤིག་སྟེ།",
    "ད་གཟོད་རང་རང་གི་མགྲིན་ངག་ཨ་མར་ལྷག་བསམ་འབུལ་བའི་ཉེ་ལམ་ཙམ་ཨེ་ཡིན།",
    "འདི་ལྟ་བུའི་ཚོར་འདུ་དང་ཉམས་སྣང་ལས་བདག་གིས་ཀྱང་དྭངས་གཙང་གི་གླུ་སྐད་ཅིག་རྒྱང་ནས་ཉེ་སར་བཞུར་འོང་བའི་རྟོག་འཁྲུལ་ཁྲོད་དྲན་པ་རྐུ་བའི་གླུ་མ་དེའི་མཛེས་ཉམས་མཐོང་བྱུང་།"
  ]
