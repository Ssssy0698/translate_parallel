    "ཞལ་ལུ་གཅིག་གིས་ང་རང་བསྐྱེལ་བར་ནུས།",
    "འཛུམ་དང་གད་མོའི་མར་མེ་མི་གཡོ་རོགས།",
    "ལན་རེར་འཛོམས་ཀྱང་དུས་རྒྱུན་ཧྲེང་པོར་ལུས།",
    "བྱིས་པའི་དུས་ཀྱི་ཉི་མ་ཞིག་ཁྱེད་རང་ཞེད་སའི་སྦྲུལ་ཁྲ་བོ་དེདེའི་བཙུན་མོ་ལྟ་བུའི་ཆུ་མིག་དེའི་འགྲམ་དུ་ཡོདདེའི་མཐའ་འཁོར་དུ་རེ་ལྕག་པ་ཞེས་པའི་མེ་ཏོག་གིས་བསྐོར་ཡོདམེ་ཏོག་དེའི་མིང་ལཁྱེད་ཀྱིས་སྦྲུལ་ཞགས་ཞེས་བོསཁྱེད་རང་མནལ་ལས་སད་ནའངརྩྭ་ཡི་དྲི་བསུང་དང་ཟིལ་བའི་བརླན་བཤེར་གྱིསཁྱེད་རང་རྨི་ལམ་གཞན་ཞིག་ཏུ་ཁྲིད་དེ་རུཁྱེད་ཚང་གི་སྲུང་མ་བསང་དུད་ཀྱི་གཙང་བོའི་ཁ་རུ་གཡེངཁོས་བར་སྣང་ལ་འཇའ་རིས་ཤིག་བྲིསའབྲི་བྱེད་ཀྱི་སྨྱུ་གུ་དག་ཁྱོད་ཀྱི་རུམ་དུ་བླུགས་སྤྲིན་པ་དམའ་ས་ནས་འཁྲིགས་ཏེསྒྲུང་པ་དག་ལ་གུར་ཕུབ་གློག་ཞགས་ཐག་རིང་ནས་འཁྱུག་སྟེགཞས་པ་དག་ལ་ལན་བཏབ་ཁྱེད་ཀྱིས་མིག་ཟུང་འབྱེད་ཙམ་བྱེད་དུས་ནེའུ་ཆུང་ལུ་གུའི་ཚར་ཡག་གིསཁྱོད་ལ་ཨ་མའི་མར་ལོ་ཁྱེར་ཡོང་གིན་འདུག་ཉིན་དེར་ཁྱེད་ཚང་གི་སྲུང་འབྲི་སར་རྒ་བུ་མཚོ་མ་ཞིག་བཙསཉིན་དེ་ནི་ཁྱེད་ཀྱི་སྐྱེས་སྐར་ཡིནཉིན་དེརཁྱེད་ཀྱི་ཨ་ཕསརྒ་བུ་མཚེ་མ་དེ་ཚེ་ཐར་ལ་བཏང་ཉིན་དེརཁྱེད་རངཁྱེད་ཚང་གི་སྦྱའི་ཕུགས་དར་གྱི་གྲིབ་མའི་འོག་ནས་གན་རྐྱལ་ལ་སྡོད་དུས།",
    "མཐའ་ཡས་པ་དག་གི་རྒྱུན་ནི་ལེགས་སོང་སྐུད་དབྱར་ཁ་ཞིག་ལ་ཞེད་སྣང་བྱུང་བ།",
    "དུས་མཐའི་མཚན་མོ།",
    "དུ་བའི་གཏེར་མཛོད་དེ་ལ་གཟིགས།",
    "མིག་གིས་ནམ་མཁའ་མི་མཐོང་ཞིང་།",
    "གྲོགས་དང་གྲོགས་མོའང་མི་མཐོང་བར།",
    "ཀྭ་ཡེ་བུ་མོ་དལ་ཙམ་བྱོས།",
    "དུས་མཐའི་མཚན་མོ་སླེབས་བྱུང་ངོ།",
    "གློག་གི་ཚག་སྒྲ་མཆེད་པ་ཡིས།",
    "མིག་གི་བུང་བ་ཟུམ་ཟུམ་འདར་བ་ནི།",
    "ཆུ་ལ་ཆུ་ཡི་གཟེར་མ་བརྒྱབ་ཆུ་ཡི་ལྕཔ་༨ ཆུ་ཡི་གཟེབ་དེ་ལ་ཚག་སྒྲ་མཆེདཆུ་ལས་སྐྱེས་པ་ནི་མི་ཕོ་སྟོབས་ཆེན་ཞིག་གི་མཆུ་དམར་པོ་དེ་ལ་དུད་པའི་ཡི་གེསྐུ་པོ་ཁྲ་ཁྲ་འབབ་མ་ཐུབ་པའི་ཟླ་མཚནརྒྱུས་པའི་ཨུ་ཚོས་སྙིགས་ཟོམ་ལས་སྙན་ངག་ཐུས་ཤིག་ལྕགས་ཀྱི་ལག་པ་ཅན་དག་བཙོན་གྱི་བུ་མོ།",
    "མགོ་ནང་གི་ཙི་ཙི་རྣམས་གཏན་ནས་མི་གཉིད་པར་འདུག་པགས་པ་བཤུས་མ་ཐག་གི་ཡུ་མོ་ཞིག་ལའཇག་མ་རྐང་གཅིག་གིས་འཕྲད་ཙམ་བྱེད་པ་ལྟརའདམ་དྲི་འཐུལ་བའི་མུན་ཁྲོད་དུ་ལྡིང་བཞིན་འགྲོ་དགོས་ནམ་གུང་གི་ཕོ་ཉ།",
    "རྩེད་གྲོགས་སྐྱིད་པོ་ཞིག་ལག་པ་རྣོན་པོས་སྟེ་ཐག་བཅད་པ་དངལུག་ཤ་རློན་པ་བཞིན་དུ་ས་ལ་ལྷུངགྲིབ་མའི་གདོང་ལ་འགྲམ་རུས་ཕྱེད་ཀ་ཞིག་སོ་སྒྲ་འཆའ་བཞིན་སྐུ་དང་བ་སྤུ་སྐྱེདམེ་ལྕེའི་ནང་གི་ངུ་སྐད་དེམདེའུ་ཤོར་མས་རྒྱུང་དུ་བསྒྱུརདུས་ཚོད་སྒྲིམ་མཁན་འདི་ནི་ངས་མཐོང་འདོདསྟོང་པ་རྩིག་མཁན་འདི་ལའང་ང་མཇལ་འདོདམཚན་མ་བརླག་ཀྱང་ཆགས་པའི་གྲུ་མ་ཆེ།",
    "ཚོད་བྱེད་ཀྱི་དམོད་ཚིག་དག་གིསདེའི་མགོ་མནན་སླ་ངའི་ནང་ནས་ཞུ་བ་ཞིག་འཕྱུར་བ་དེ་ཐོམ་བུས་དཀྲུག་ནུས་མེད་པར་བུས་པ་བཞིན་གདུང་བ།",
    "རང་དྭཐུང་ལ་ཚེ་ཞིང་ཁྱིམ་གྱི་འཆིང་རྒྱུར་ཚུད་མི་ལྟདོད་ངའི་བུ་མོཞི་ཡིན་ཨིན་ཚེས་པའི་སྙནང་༦གུ་པེཨ་རིའི་སྐན་ཡས་པ་༧ཀྱིས་བརྩམས།",
    "༢སྙན་ངག་འདི་མ་དྷིའི་ང་ལ་སྦྱིན་འགའི་སྔོན་དུ་རྩོམ་པ་པོས་སྐྱེ་དངུལ་རྭ་ནུས་པའོ་བདུནས་འཔག་གི་མདུན་ན་ས་བསང་ལུང་འདིར་ཀ་ཡ་ཞེས་པས་འདས་པའི་དུས་སྟོན་འོ།",
    "སེལུས་ཀྱི་གོས་ཕུདགྲིའི་ཤུབས་བཙལ་ཞོན་རྟ་རི་ལ་ཕུདཞེ་རྒོད་གཏིང་ནས་འཁྲིགས་ཏེའཇག་རྩྭའི་གསེབ་ཏུ་ཡིབ་ཡོད་པའང་ཤེས་ངེས་གལ་ཏེར་བའི་ནང་ནས་མོ་ཊའི་དུང་བརྡ་ཐེངས་འག།",
    "ར་གྲགས་ཚེ་དེ་ནི་སང་ཉིན་ཕྱི་དྲོ་ཁྲིན་ཏུའུ་ལ་འགྲོ་བའི་ཁྱོད་ཀྱིསད་ལྟའི་ཁྱོད་འབོད་ཀྱིན་པ་ཡིན་ཨང་རྨ་ཆུ།",
    "ཁྲག་རྩིས་དཀྲོལ་བའི་ཨ་ལ་ལ་མོ།",
    "ངས་སྙན་ངག་ལབརྟེན་ནུས་ཞིང་གཅིག་བཏབ་རོང་པ་ཚོ་དགྱེསཀྱིན་མི་འདུག་ངས་མིང་གི་གློག་དང་ཕྲད་ཀྱི་ཨང་ཀིར་བརྟེན་ནསམདུན་གྱི་ནམ་མཁའ་གང་བར་བྱསབུ་མོ་ཞིག་ལྷམ་ཎིང་ཙོག་གིས་དྲེགས་ཏེ་ཚུར་ཡོང་གིན་འདུག་ཁ་པར་འཚོང་མཁན་ཞིག་ཡིན་པ་འདྲངོས་གངས་རི་ཁུར་ནས་ཕག་པར་ཁོ་ཤུ་བཏབ་མེ་འབུད་བཀྲིན་ཟིལ་བ་ལྕེ་ཡིས་བལྡགས་འཛིའི་ནང་གི་ཚས་ཚོཀ་ཚཀ་ཚ་ཀ་བརྩཁབཙཀ་གླུ་བ་ཚེ་མི་འུརཚོང་ལཱཙཎྜ་ཚོབསམ་ར་ཙིས་༥རྩམ་པ་པས་༡༣་དུ་མྱུར་ད་དང་",
    "པ་ལག་ལསྤྲུག་ཡུལ་ཨཎཱ་ཚིག་ཚུ་བྱ་ཆུང་བའ་ཤུན་དང་མཉམ་པ་ཀཱ་བྷཱ་ཧུཾ་དེ་ལྟར་བྱས་ཚེ་དེའི་བསྟན་པོར་༥་ འགྲུས་བུ་འབྱུང་དབུས་གའུགམོ་བ་དུང་ལྟ་འོནུ་ང་རོ་པར་འགྱུར།",
    "དུས་ཚོད་ཁོ་རང་གི་མཚན་མོའི་ཟློས་གར་ཁོག་པའི་ནང་གི་ཉོན་མོངས།",
    "རྟ་རྒནུ་འཕོངས་ཀྱི་སྣ་གླུ་བརྗེད་སོང་སློག་ཚར་འདབས་ཀྱི་ཟིལ་བ་ཞུ་སོང་།",
    "ཉི་ཐིག་འོག་གི་སྲུང་མའི་ཐང་ཀ་ཞལ་ཡོལ་སྔོན་པོ་དུ་བས་བདུག་པ།",
    "བསང་འབོད་འདོད་ཀྱང་མགྲིན་པ་བརྣངས་པས་མཆི་མ་ཀོ་རེར་ཁྱོད་ལ་བལྟས་ཀྱང་།",
    "ཁྱོད་ཀྱིས་ལག་ཏུ་ཁ་པར་ཐོགས་ནས་ལྡབ་ལྡིབ་སྐད་ཀྱིས་ང་ལ་གཙེས་བྱུང་།",
    "རྨི་ལམ་ནང་དུ་ང་རང་སྦྲང་རྩིས་བརྣངས་པར་གྱུར་ཇོ་མོ་བླ་རིའི་རྩེ་ནས་བརྩེ་བའི་ངན་སྔགས་བཟླ་འདོདཁ་བའི་འདབ་མ་ཟིན་དུས་ཁྱོད་སེམས་འཛིན་ཐུབ་བམཉི་མར་འགྲོགས་ཏེ་མགོ་སྦྲ་ནག་ཆུང་ཡང་ནུབ་སོང་ཟེརགྲོང་མཐའི་འུར་ལྕག་མཐའ་མས་གདུང་བ་ཇེ་ལྗིར་བཏངམེ་འཁོར་ཇི་ཙམ་དལ་ཡང་ཁྱོད་ཀྱི་ས་ཚུགས་དེར་མི་སྡོད་དལ་བུར་འགྲོ་བ་དེ་ནི་ཁུར་བོའི་ནང་ནས་ཇེ་ལྕིར་སོར་ཁྲིན་ཏུའུ།",
    "ས་ནག་པོ་དལ་ཚོར་བཅག་བཅག་བྱ་རོགསདེའི་གསེབ་ཀྱི་ལྗང་སྨྱུག་བསྣད་ཚེ་སྟོན་པར་ཁ་ཟས་ཡོད་དཀའ་དགའ་དྲགས་ནས་མགོ་ཐོག་མ་སྒྲིབས་རོགསསྐུར་ཁུར་ཕྱེ་རོགསགནམ་རྒན་མའི་མིག་ཤེལ་ལ་དུ་དྲེག་ཆགས་ན་ལས་ཀྱི་སྡོམ་དྲ་འཆོལ་འགྲོགཉིད་མཐུག་པོར་ཟུག་སྟེ་བདུད་མོའི་རྗེས་སུ་མ་འགྲོ་རོགསབ།",
    "ཤེལ་གྱི་དྲ་མའི་ཕྱི་སུ་ས་མོ་སྲུབ་མོ་བབས་ཁྱོད་ད་དུང་གཉིད་མེདགང་ལ་སྒུ་པའང་མ་ཡིནསྡོད་བཟོད་མེད་པའང་མ་ཡིནཁྱོད་ལ་ཁྱོད་ཀྱི་ཁེར་ཧྲེང་གི་སྣང་བ་སྐྱིདཁྱོད་ལ་ཁྱོད་ཀྱི་ནམ་གུང་གི་རྒུན་ཆང་སྐྱིད།",
    "ནངས་སྔ་མོར་ཡར་ལ་ལང་བའི་དུས།",
    "ངའི་སེམས་དོན་གླིང་བུས་རོལ་མོར་བྱས།",
    "གནས་འཁོར་པའི་ཀློང་གི་མགྲོན་པོ་རྣམས།",
    "ལང་ཚོས་དྲེགས་པའི་གཞོན་ནུ་མས།",
    "ང་སེམས་པ་སྐྱོ་ནས་ཆུ་ཁར་སོང་།",
    "ངའི་སེམས་དོན་ཚོན་གྱིས་རི་མོར་བྱས།",
    "ཐ་སྙད་ཀྱིས་འཆིང་བའི་ཕོ་མོ་རྣམས ང་དང་རི་མོའི་མཐའ་རུ་འདུས།",
    "སྐད་ཅིག་གི་བདེ་བ་རྙེད་པ་ལྟར།",
    "དུས་མཚན་མོར་འདོད་པས་གཟིར་བའི་དུས།",
    "ཅི་བྱ་གཏོལ་བྲལ་དུ་ལུས་པ་རྣམས་ང་དང་སྙན་ངག་གི་མཐའ་རུ་འདུས།",
    "མི་རྣམས་འཚང་ཁ་ཀློག་ཤིག་གིས་འདུས་བྲུ་འགའ་ཞིག་གིས་གར་བྱེད་པ་དང་།",
    "ཡང་ལ་ལས་ཧ་རྡོ་སོགས་སྐད་སྒོ་སྣ་ཚོགས་འབྱིན་པ་འ་རེ་ཞིག་ག་ང་སྙན་ངག་འདི་སེམས་ལ་མྱུར་བར་སྒྲུམ་ངས་དེའི་ཕྱི་ཉིན་གྱི་ཞོམས་པར་ཁེར་ང་བ་འོ།",
