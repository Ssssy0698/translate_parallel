    "གང་ཞིག་ཤིན་ཏུ་དེ་ཁོ་ན་ཉིད་ལ་མོས་པའི་རྣལ་འབྱོར་པ་ནི།",
    "དེ་ལ་དེ་ཁོ་ན་ཉིད་ལ་མོས་པའི་རྣལ་འབྱོར་པའི་མཚན་ཉིད་ཡིན་ཏེ།",
    "གང་གི་ཚེ་ལས་དང་པོ་པའི་རྣལ་འབྱོར་པས་རང་ལ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ཆོ་ག་རྒྱས་པ་ནས་བརྩམ་མེཔར་བྱ་བའི་ཚོགས་ཐམས་ཅད་ཐུན་བཞིའི་སྦྱོར་བས་ཉིན་རེ་ཞིང་མཚན་མ་ཐོབ་པར་འགྱུར་བའམ།་",
    "དང་པོར་ལྷག་པར་མོས་པ་ཙམ་གྱིས་ནི་མ་ཡིན་ནོ།",
    "གང་གིས་ཡིད་ནི་མཚོན་པར་བྱ།",
    "བུ་མོ་གཞོན་ནུས་བརྒྱན་པ་དང་།",
    "རོལ་མོ་སྣ་ཚོགས་བརྡུང་བ་དང་།",
    "གང་ཚེ་སྐད་ཅིག་རེ་རེ་སེམས།",
    "ཉོན་མོངས་གསུམ་ནི་རྣམ་དག་པས།",
    "ཉོན་མོངས་དགྲ་རྣམས་ཞི་ཕྱིར་དང་།",
    "ཤིན་ཏུ་ཉོན་མོངས་ཞི་བའི་ཕྱིར།",
    "རྗེས་སུ་ཆགས་པ་བུད་མེད་ནི།",
    "རྣལ་འབྱོར་རང་གི་དམ་ཚིག་བདག།",
    "དེ་ཕྱིར་རྣལ་འབྱོར་ཀུན་བདག་གིས།་།",
    "རང་གི་ལྷ་ཡི་སྤྱོར་བ་ཡིས།",
    "རང་གི་རིགས་ཀྱི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་སྒྲ་ནི་ཕྱག་རྒྱའོ།",
    "རང་གི་རིགས་ཀྱི་ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་བསྒྲུབ་པར་བྱ་བའི་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་སྒྲ་ནི་རིགས་ཐུཔ་ཡིན་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་ཏོ།",
    "སྐྱིལ་མོ་ཀྲུང་ལ་སོགས་པའི་ཧཱུཾངེས་པ་ནི་ཡོ་བྱད་དེ།",
    "ལྷག་པར་མོས་པའི་དོན་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "ཡང་གི་སྒྲ་ནི་རྒྱུད་ཕྱི་མ་ལ་ལྟོས་ཙུཔའོ།",
    "དེ་དག་གི་ཡོ་བྱད་དང་།",
    "རང་གི་ལྷ་ནས་བརྩམས་ནས་སྒེག་མོ་ལ་སོགས་པ་བརྒྱད་དང་།",
    "རྡོ་རྗེའི་ཚིག་གིས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་ནས།",
    "རང་གི་གདན་ལ་སྔ་མ་བཞིན་དུ་ཕྱག་རྒྱ་ཆེན་པོས་འདུག་སྟེ།",
    "རང་གི་དེ་བཞིན་གཤེགས་པའི་མདུན་དུ་ཡོངས་སུ་བརྟགས་ནས་རྣལ་འབྱོར་གྱི་གནས་ལ་བཛྲ་དྷཱ་ཏུ་ཞེས་བརྗོད་ཅིང་སྤྲུལ་ལ།",
    "སྒེག་མོ་ལ་སོགས་པའི་རྣམ་པ་བརྒྱད་དང་།",
    "རེ་བ་རྣམས་ནི་ཡོངས་སུ་སྐོང་།",
    "རྡོ་རྗེ་ཆེན་མོའི་དགའ་བ་ཐོབ།",
    "བདག་གི་ལུས་ལ་བསྒོམས་ན་རྒྱས་པའི་ལས་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "ཐལ་མོའི་སྒྲས་དུག་གིས་ཆེབརྒྱལ་བ་ལས་སད་པར་བྱེད་དོ།",
    "རྡོ་རྗེ་སྒེག་མོ་ལ་སོགས་པའི་ལྷ་མོ་རྣམ་པ་བརྒྱད་བྲི་བར་བྱའོ།",
    "རྡོ་རྗེ་འབེེབས་པའི་མཐར་ཐུག་པའི་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་རྣལ་འབྱོར་པས་རང་གི་ལྷར་བསྒོམས་ལ།",
    "དེའི་འོག་གི་ཆ་ལ་མི་བསྐྱོད་པའི་གནས་སུ་རྡོ་རྗེ་སེམས་དཔའ།",
    "རས་གང་ལ་རི་མོ་འབྲི་བ་དེའི་ཚེ་འབྲུ་དང་།",
    "དེའི་སྟེང་དུ་བླ་རེ་བྲིས་པ་ཛིདང་།",
    "དེའི་འོག་ཏུ་གདུགས་དཀར་པོ་ལ་གཙུག་ཏོར་དཀར་མོ་བཟླས་པ་དང་།",
    "གལ་ཏེ་འགའ་ཞིག་དེ་བསྒྲུབ་པར་འདོད་ན་རྡོ་རྗེ་ཕྲ་མོ་ནས་བརྩམས་ཏེ།",
    "བདག་ཉིད་དམ་མདུན་དུ་རང་གི་ལྷའི་གཟུགས་སུ་བསྒོམ་བྱེ་པར་བྱའོ།",
    "ཐོ་རངས་བཀའ་༧དམ་ཚིག་གི་ཏིང་ངེ་འཛིན་ཐོབ་པར་འགྱུར་རོ།",
    "རས་རིས་ཀྱི་རང་གི་རིག་པའི་མདུན་དུ་སྟོང་ཕྲག་བརྒྱ་བཟླས་པར་བྱའོ།",
    "ལན་ཅིག་བརྗོད་པ་ཙམ་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རང་གི་རིག་པ་ཇི་ལྟ་བ་བཞིན་དུ་བསྒྲུབས་ལ།",
    "ལན་ཅིག་བརྗོད་པས་ཞེས་བྱ་བ་ནི་རང་གི་རིག་པ་ལྷཇི་ལྟ་བ་བཞིན་དུ་བསྒྲུབས་པའོ།",
    "སྔ་མ་བཞིན་དུ་རིག་པ་ཟློས་ཤིང་བསྒྲུབས་ན་ཕྱིས་རང་གི་རིག་པའི་རས་རིས་ཀྱི་མདུན་དུ་ཐུན་བཞིར་ཟླ་བ་གཅིག་སྟོང་རྩ་བརྒྱད་བཟླས་པ་བྱས་ནས།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྦྱོར་བས་ཡི་གེ་འབུམ་གྱི་བཟླས་པ་རྫོགས་ཀྱི་བར་དུ་བྱའོ།",
    "སོར་མོས་སྤྲིན་རྣམས་འཇིག་༩པར་བྱེད་དོ།",
    "ཀླུ་རྣམས་རེངས་པར་བྱེད་དོ།",
    "སྐྱེས་པ་དང་བུད་རྔེད་རྣམས་རེངས་པར་བྱེད་དོ།",
    "བྱིས་པ་རྣམས་རེངས་པར་བྱེད་དོ།",
    "སྡིགས་མཛུབ་ཙམ་གྱིས་འགྲོ་བ་རེངས་པ་དང་གླང་པོ་ཆེ་གསོད་པར་བྱེད་དོ།",
    "དུག་གིས་མུབརྒྱལ་བ་ལས་སློང་བར་བྱེད་དོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པ་རང་གི་ཁྲོ་བོའི་སྔགས་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ནས་རས་ལ་རི་མོ་བྲི་བར་བྱའོ།",
    "རས་ལ་རྡོ་རྗེ་རི་མོ་གྲུ་བཞིར་བྲིས་ནས་བསྙེན་གནས་དང་ལྡན་པའི་རི་མོ་མཁན་གྱིས་དཀྱིལ་འཁོར་དུ་ཞུགས་པས།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞི་རུ་སྟོང་བཟླས་ཤིང་ཟླ་བ་གཅིག་གི་མཐར་ཐུག་པ་དེ་སྲིད་ཀྱི་བར་དུ་བྱའོ།",
    "ཇི་སྲིད་དུ་རང་གི་ཁྲོ་བོའི་སྔགས་ཟློས་ཤིང་ཕྱག་རྒྱ་བཅིངས་པ་དེ་ལ་ཧཱུཾ་ཞེས་བྱ་བའི་སྒྲ་བྱུང་གི་བར་དུ་བཟླས་པར་བྱའོ།་",
    "རང་གི་གཟུངས་ཀྱི་རིག་པའི་ཡི་གེ་འབུམ་བཟླས་པར་བྱའོ།",
    "ཇི་སྲིད་དུ་ཟླ་བ་གཅིག་གི་མཐར་ཐུག་པའི་བར་དུ་བྱས་ལ་མཐར་ཟླ་བ་ཉ་ལ།",
    "ཉིན་རེ་བཞིན་དུ་ཐུན་བཞི་སྤྱོར་བ་བྱས་ལ།",
    "ཟླ་བ་གཅིག་ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྦྱོར་བས་སྟོང་རྩ་བརྒྱད་གྱེབཟླས་པར་བྱའོ།་།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་རྣལ་འབྱོར་གྱེས་ཀྱེསྟོང་རྩ་བརྒྱད་ཟླ་བ་གཅིག་བཟླས་པར་བྱའོ།་།",
    "རིན་ཆེན་སྒེག་མོ་ལ་སོགས་པ་རྣམས་དང་།",
    "རང་གི་གཟུངས་ཀྱི་རིག་ཕྱཔ་སྟོང་རྩ་བརྒྱད་བཟླས་ཤིང་།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྦྱོར་བས་ཟླ་བ་གཅིག་གི་བར་དུ་བཟླས་པར་བྱའོ།",
    "ནམ་མཁའ་དང་མཉམ་པའི་ཡེ་ཤེས་དེ་ཡང་བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པ་སྤངས་ཤིང་།",
    "རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ནས།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྦྱོར་བས་ཟླ་བ་གཅིག་བཟླས་པར་བྱའོ།",
    "ཐུན་བཞིའི་སྤྱོར་བས་ཉིན་རེ་ཞིང་སྟོང་རྩ་བརྒྱད་ཟླ་བ་གཅིག་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་དུ་འགྱུར་བའི་བྱེཡོ་བྱད་ཀྱི་ཆོ་ག་རྒྱས་པར།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་རྣམས་ཀྱི་ཐུན་མོང་ནི་སྤྱིར་རོ།",
    "རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་བ་ཉིད་ཀྱི་ཕྱག་རྒྱའི་ཡོ་བྱད་གསུངས་པ་ནི།",
    "རང་གི་རིགས་ཀྱི་གཟུངས་ཀྱི་ཕྱག་རྒྱ་བཅིང་སྟེ་༡་འདི་སྐད་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་རང་གི་རིགས་ཀྱི་གཟུངས་ཀྱི་རིག་པ་བཟླ་བར་བྱའོ།",
    "རང་གི་རིགས་ཀྱི་དེ་ལ་སྤྲོས་པ་ནི་རྣམ་པར་རྟོག་པ་ལས་བྱུང་བས་ན་སྤྲོས་པ་སྟེ།",
    "ངག་གི་རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་མེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རིག་པ་རྣམས་ཀྱི་ཐུན་མོང་དུ་རྡོ་རྗེ་བཟླས་པའོས།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་བཟླས་པའི་གེཆོ་ག་རྒྱས་པར་བསྟན་ནས།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་དངོས་གྲུབ་ཀྱི་ཆོ་ག་རྒྱས་པར་གསུངས་སོ།",
    "གཏེར་དང་གཏེར་གྱི་ལྷ་དང་ཞིང་སྐྱོང་དང་ཕྱོགས་སྐྱོང་མིརྣམས་བབྱུངས་ལ་གནས་དེར་སོང་སྟེ།",
    "ཕྱག་བཞི་བྱས་ནས་རྡོ་རྗེ་ལྕགས་སྒྲོག་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།་།",
    "འི་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "རང་གི་སྔགས་ཀྱི་ཡི་གེ་འབུམ་བཟླས་ལ།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྤྱོར་བས།",
    "སྟོང་རྩ་བརྒྱད་ཟློས་ཤིང་ཟླ་བ་གཅིག་གི་བར་དུ་བྱའོ།",
    "ཕྱག་བཞི་པའི་མཐར་ཐུག་པའི་རྗེས་སུ་སྤྱད་ནས་ནང་གི་སྔགས་སྔ་མ་བཞིན་དུ་སྟོང་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རས་རིས་ཀྱི་མདུན་དུ་རང་གི་ལྷའི་ཏིང་ངེ་འཛིན་གྱིས་གཡོན་པའི་བསྙེམས་པ་དང་བཅས་པས་པདྨ་བླངས་ལ་ལག་པ་གཡས་པས་པདྨ་བཟུང་༥ལ།",
    "པདྨ་འབྱེད་ཅིང་པདྨ་རབ་ཏུ་དམར་བ་བསྒོམས་ནས་ཉིན་རེ་བཞིན་འུཐུན་བཞིའི་སྤྱོར་བས་ཟླ་བ་གཅིག་ཙམ་གྱི་བར་དུ་སྟོང་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྦྱོར་བས་ཇི་སྲིད་འབུམ་ཡོངས་སུ་རྫོགས་པ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་པར་བྱའོ།",
    "རང་གི་ལྷའི་སྤྱོར་བས་འབུམ་བཟླས་པར་བྱའོ།",
    "རྡོ་རྗེ་འབེེབས་པའི་མཐར་ཐུག་པའི་ཕྱག་རྒྱ་ཐམས་ཅད་ནི་དེ་དག་གི་ཐབས་ཏེ།",
    "གང་གིས་ཤེ་ན།",
    "རང་གི་ཁ་ནས་གཞན་ཞལ་དུ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་ཁ་ནས་གཞན་གྱི་ཞལ་དུ་འཇུག་པར་བསྒོམས་ན་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱའོ།",
    "དེ་ལྟར་རང་གི་ཁ་ནས་གཞན་གྱི་ཞལ་དུ་བསྒོམས་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "ངག་གི་རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་སྟེ།",
    "སྒེག་མོ་ལ་སོགས་པ་བརྒྱད་དང་།",
    "འཕགས་པ་ཉན་ཐོས་ཡང་དག་པར་སོང་བ་དང་།",
    "དེ་ཇི་ལྟར་རྡོ་རྗེ་འབྱུང་ཞེ་ན་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་གང་གིས་རྡོ་རྗེ་ལ་སོགས་པ་བསྐྱེད་པ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་བྱུང་གགི་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཡེ་ཤེས་ཀྱི་ཚུལ་དེ་གང་གི་ཡིན་ཞེ་ན།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ནས་དྲིལ་བུའི་མཐར་ཐུག་པའི་རང་གི་མཚན་མ་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་རྡོ་རྗེར་བསྒྲུབས་ནས་ཡེ་ཤེས་སེམས་དཔའ་འཇུག་པའི་དུས་སམ།",
    "དེའི་ཕྱིར་བདག་ཉིད་ཀྱི་རྣལ་འབྱོར་གྱི་དུས་སུ་རྡོ་རྗེ་རྒྱལ་པོ་ལ་སོགས་པ་རྣམས་རང་གི་མཚན་མ་ལས་བསྐྱེད་པ་མ་ཡིན་ལ།",
    "གང་ཞིག་གིས་ནི་ཐོས་འགྱུར་བ།",
    "ཞེས་བྱ་བ་ནི་གང་གི་ངོ་བོས་བརྟགས་པའི་རང་བཞིན་ཀྱི་རྟོག་པ་ནི་དེ་བཞིན་གཤེགས་པའི་སྣརྟོག་པས་ཞེས་གསུངས་སོ།",
    "ད་ནི་རྡོ་རྗེ་རིགས་ཀྱི་ཆོ་ག་བཞིན་དུ་རི་མོ་བྲིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རི་མོ་བྲིས་ཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པའི་གཟུགས་སུ་རྣམ་པར་རྟོག་༧༨པས་བརྟགས་པའོ།",
    "དེ་སྐད་ཅིག་རེ་རེ་ཞིང་པདྨའི་རིགས་བསྐྱེད་པའི་རྒྱུར་གྱུར་པར་གནས་པའི་ཕྱིར་རོ།",
    "ཚིག་གིས་བཅས་དུཔ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངག་གི་རིག་པ་མཆོག་གྲུབ་ཅིང་།",
    "ཞེས་བྱ་བ་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཐོབ་པས་ན་གང་དུགི་རིག་པ་མཆོག་གྲུབ་པའོ།",
    "གང་གིས་དེ་ལྟར་མ་རིག་བཅོམ།",
    "རང་གི་རིག་པ་མཆོག་གྲུབ་སྟེ།",
    "གང་གི་ཚེ་ཡེ་ཤེས་འདི་སྒྲུབ་པ་པོའི་༥རྒྱུད་ལ་བསྐྱེད་པའི་རྒྱུར་གྱུར་པ་ནི་རིགས་སོ།",
    "གང་གི་ཡིན་པར་རིག་པར་བྱ་ཞེ་ན།",
    "གང་གིས་མཐོང་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་པའོ།",
    "བདག་གིས་ཆོ་ག་ཇི་བཞིན་དུ།",
    "རང་གི་གཟུངས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་བབྱུངས་ནས།",
    "རང་གི་ལྕེ་ལ་སྨྲར་གྱུར་པ།",
    "ཞེས་བྱ་བ་ནི་དེ་བཟླས་༦པས་རང་གི་ལྕེ་ལ་གང་ཡང་རུང་བ་སྨྲ་བར་འགྱུར་རོ།",
    "ད་ནི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་ཐམས་ཅད་ཀྱིས་༧ཟློས་པ་པོས་ཐུན་མོང་དང་།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་བ་ནི་སྤྱིའོ།་།",
    "བསྒྲུབ་པའི་དུས་སུ་སྐྱིལ་མོ་ཀྲུང་གང་ཙུ་རུང་བ་དེས་འདུག་ལ་བསྒྲུབ་པ་དང་བཟླས་པ་བྱའོ།",
    "རང་གི་ལྷའི་གཟུགས་སུ་བདག་ཉིད་མདུན་དུ་བསྒོམས་ལ།་",
    "རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་བཅས་ལ།",
    "ཇི་ལྟར་བྲིས་པ་དང་རྗེས་སུ་མཐུན་པར་རང་གི་ལྷའི་གཟུགས་ཀྱི་བདག་ཉིད་དམ།",
    "ད་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསུང་གི་གསང་བའི་ཕྱག་རྒྱ་བསྒྲུབ་པ་གསུངས་པ་ནི།",
    "ཞེས་བྱ་བ་ནི་ལྕེའི་རྩེ་མོ་ནི་མི་བསྐྱོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་ལྒོཕྱག་རྒྱ་བསྒྲུབ་པའི་རྒྱུད་བསྟན་ནས།",
    "བསྒྲགས་པ་གཞན་དུ་ཧཱུཾ་ཞེས་བྱ་བ་གང་ཡིན་པ་ཁྲོ་བོ་གང་གིས་ཡི་གེ་འབྲུག་སྒྲ་ལྟར་སྒོགས་པའོ།",
    "ཧཱུཾ་ཞེས་བྱ་བ་འབྲུག་སྒྲ་ལྟར་ས་འོག་གི་མཐར་ཐུག་པར་ཧཱུཾཐོས་པས་ན་ཟབ་པའོ།",
    "ཤིན་ཏུ་ཡོངས་སུ་གསལ་ཚིག་གིས།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་ཐམས་ཅད་ཀྱི་ཀྱེགསང་བའི་ངག་གི་ཕྱག་རྒྱ་བསྒྲུབ་པ་བསྟན་ནས།",
    "གང་གིས་ཤེ་ན།",
    "རང་གི་ལྷའི་གཟུགས་གདོད་མ་ནས་མ་སྐྱེས་པ་ཡིན་ནོ་ཞེས་བསྒོམ་ཞིང་བཟླས་པ་བྱའོ།",
    "རང་གི་ལྷའི་ང་རྒྱལ་བསྐྱེད་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་རྣལ་འབྱོར་རམ་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་རྣལ་འབྱོར་ཉིན་རེ་ཞིང་ལན་ཅིག་བྱ་བའམ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སྔ་མ་བཞིན་དུ་ཉིན་རེ་ཞིང་ལན་ཅིག་ནོར་བུའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ་ཕྱག་བཞིའི་མཐར་ཐུག་པའི་ཆོ་ག་རྗེས་སུ་སྤྱད་དེ།",
    "ད་ནི་རིགས་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་ཕྱག་རྒྱའི་ཐུན་མོང་དུ་བསྒྲུབ་པའི་ཆོ་ག་ནི་དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལས་ལྷའི་ཁྱད་པར་གང་གིས་ཧཱུཾསྐུའི་གསང་བ་གང་ཡིན་པ་འདི་ནི་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ།",
    "རང་གི་སེམས་དཔའི་ཏིང་ངེ་འཛིན།",
    "སྔ་མ་བཞིན་དུ་ལྷ་ཐམས་ཅད་གཤེགས་སུ་གསོལ་ལ་སྤྲུལ་པ་རྣམས་རང་གི་ལུས་ལ་གཞུག་དཱུཔར་བྱས་ནས།",
    "དེའི་སྟེང་གི་ཟླ་བའི་དཀྱིལ་འཁོར་གཉིས་པ་ལ་སེམས་དཔའ་སེམས་དཔའ་ཞེས་བརྗོད་དེ་མཚན་བདུན་ཡིན་ནོ།",
    "སྨྲ་བ་ཆེ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་གསུང་བའི་ངོ་བོས་ཐམས་ཅད་སོང་བས་ན་སྨྲ་བ་ཆེའོ།",
    "སེམས་དཔའ་ཆེན་པོ་ཞེས་བྱ་བ་ནི་ངག་གི་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཡེ་ཤེས་ཀྱིས་ཐམས་ཅད་༢་སོང་བའི་ཕྱིར་རྡོ་རྗེ་གསུང་བའི་ངོ་བོ་ཉིད་ནི་སེམས་དཔའ་ཆེན་པོའོ།་",
    "སེམས་དཔའི་རྒྱུ་ཁྱོད་ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་སེམས་དཔའ་དེ་དག་གི་རྒྱུ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་ཏེ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པའི་ངོ་བོས་ཐ་དད་དུ་སོང་བའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཆེན་པོ་ཁྱོད་ཅེས་བྱ་བ་ནི་ཤེས་རབ་ཀྱི་ཀྱེ་ཆེན་པོ་འདི་ལ་མངའ་བས་ན་ཤེས་རབ་ཆེན་པོ་སྟེ།",
    "མཆོག་གི་མཆོག་ཅེས་བྱ་བ་ནི་མཆོག་རྣམས་ཀྱི་མཆོག་གོ།",
    "ཕྱི་དང་ནང་གི་དངོས་པོ་ཡོངས་སུ་གཏོང་བས་ན་ཐམས་ཅད་གཏོང་བའོ།",
    "རྡོ་རྗེ་མགོན་པོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་དེ་དག་གི་བདག་གི་ལྐུ་བདེ་བ་ཆེན་བོའོ།",
    "རྡོ་རྗེ་ཉི་མ་ཡེ་ཤེས་ཀྱི་ཉི་མའི་སྣང་བས་ཕྱི་ནང་གི་མུན་པ་དང་བཅས་པ་བསལ་འུབར་བྱེད་པའི་ཕྱིར་རོ།",
    "དཔའ་ཆེན་པོ་ནི་ཡིན་པས་ན་དཔའ་ཆེན་པོ་སྟེ།",
    "རང་བཞིན་གྱིས་འོད་གསལ་བའི་སྐུ་ནན་ཏན་དུ་བྱེད་པའི་བརྩོན་འགྲུས་ཀྱི་རང་བཞིན་རྡོ་རྗེ་ཁུ་ཚུར་༡༡གཟུགས་ཀྱི་ཁམས་ན་སྤྱོད་པའི་བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པ་རྩད་རྟེནས་འདོན་པའི་ཕྱིར་བདེ་སྤྱོད་ཅེས་བྱ་བ་ལ།",
    "དག་པ་ཞེས་བྱ་བ་ནི་ལས་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་པས་དག་པའོ།",
    "གསུང་གི་མཆོག་ཅེས་བྱ་བ་ནི་ངག་གི་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཡེ་ཤེས་ནི་ཕྱ་གསུང་གི་མཆོག་གོ།",
    "ཤིན་ཏུ་གསུང་བ་ཆེ་བ་ཞེས་བྱ་བ་ནི་གསུང་གིས་ནམ་མཁའི་ཁམས་ཐམས་ཅད་ཁྱབ་པའི་ཕྱིར་ན་ཤིན་ཏུ་གསུང་ཆེའོ་ཀྲུ།",
    "གཉིས་པ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དང་།",
