    "རྣམ་པར་གྲོལ་བའི་ལམ་གྱིས་སྤོང་བར་བྱེད་དེ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་གྱིས་སོ་སོར་བརྟགས་པ་ཐོབ་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་གྲོལ་བ་སྤོང་བའི་ལམ་རྣམ་པ་གཉིས་ཀྱང་སྤོང་བར་མི་འགྱུར་ལ།",
    "སོ་སོར་བརྟགས་པའི་འདུས་བྱེ་མ་བྱས་ཀྱང་གུད་ན་མི་དམིགས་ཏེ།",
    "འོན་ཀྱང་ཤེས་པའི་སྟོབས་ཀྱིས་གོང་ནས་གོང་དུ་ས་བོན་གྱིས་བསྐྱེད་པའི་གནས་ངན་ལེན་རྣམ་པར་སེལ་ཏོ།",
    "རྣམ་པར་སྨིན་པའི་ཕྱོགས་གང་ཡིན་པ་རྣམས་དང་།",
    "བརྟགས་ན་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "བྱེ་བྲག་ལས་རྣམ་པར་གཞག་པ་ཡིན་ཏེ།",
    "བག་ལ་ཉལ་གྱི་སྒྲིབ་པ་ཐམས་ཅད་སྤོང་བར་རིག་པར་བྱ་སྟེ།",
    "ཤེས་བྱའི་སྒྲིབ་པའི་ཕྱོགས་དང་མཐུན་པའི་གནས་ངན་ལེན་ནི་རྣམ་པ་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་དག་པའི་ཡེ་ཤེས་ཐོབ་པ་ཉིད་ཀྱང་ཡིན་ནོ།",
    "ཇེག་པ་གསུམ་གྱིས་རྣམ་པར་འཇོག་སྟེ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ཇི་སྐད་བསྟན་པ་ལྟ་བུའོ།",
    "འདི་ལྟར་བསྟན་པ་རྣམས་ཐ་དད་པར་གྱུར་ཅིང་ལྤགས་ཤུན་ལ་ཡོད་པ་ལྟ་བུ་ལ་སོགས་པ་གསུམ་བསྟན་པ་ཡང་དོན་གྱིས་་སྤང་བར་བྱ་བ་ལ་རགས་པ་དང་།",
    "བརྟགས་ན་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "གནས་ངན་ལེན་རྣམ་པ་གསུམ་ལས་རྣམ་པ་དུ་ཞིག་སྤངས་པས་བྱེ་བག་ལ་ཉལ་དེ་དག་རབ་ཏུ་དབྱེ་བ་ལགས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཞེས་གསུངས་ཀྱི་ཡང་དག་པའི་དོན་དུ་ནི་མ་ཡིན་ཏེ།",
    "རིགས་ཀྱི་བུ་རྣམ་པ་གཉིས་ཀྱིས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལེན་དུ་གསུངས་པ་སྟོན་ཏོ།",
    "རྣམ་པར་ཕྱེ་ནས་བསྟན་པའོ།",
    "རྐང་ལ་ཡོད་པ་ལྟ་བུ་སྤངས་པ་ཉིད་བསྟན་ཅིང་ལོགས་ཤིག་ཏུ་རྣམ་པར་ཕྱེ་སྟེ་མ་བསྟན་པའོ།",
    "གནས་ངན་ལེན་འདི་གཅིག་སྤངས་པའི་དོན་གྱི་ཕྱིར་ནི་གྲོགས་ཡང་དག་པར་བཅོམ་པ་དང་།",
    "གྲོགས་ཡང་དག་པར་བཅོམ་པ་ལ་སོགས་པ་གསུམ་གྱི་དོན་གྱི་མཚན་ཉིད་རབ་ཏུ་མ་ཕྱེ་བས་ས་དང་པོ་པས་ལྤགས་ཤུན་ལ་ཡོད་པ་ལྟ་བུའི་གནས་ངན་ལེན་སྤངས་ན་གྲོགས་ཡང་དག་པར་བཅོམ་པ་དང་།",
    "ཉམས་སྟོབས་ཆུང་བ་ཉིད་ཀྱི་དོན་གདོད་རབ་ཏུ་གསལ་བར་འགྱུར་བའི་ཕྱིར་ལྤགས་ཤུན་ལ་ཡོད་པ་ལྟ་བུ་སྤངས་པའི་ཕྱིར་ནི་དང་པོ་དང་གཉིས་པ་དེ་དག་རབ་ཏུ་ཕྱེ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "གཉིས་པ་ནི་ས་བརྒྱད་པ་ལ་སྤྲི་ལ་ཡོད་པ་ལྟ་བུའི་གནས་ངན་ལེན་སྤངས་པས་ཤིན་ཏུ་ཕྲ་བའི་དོན་གསལ་བར་འགྱུར་བའི་ཕྱིར་སྤྲི་ལ་ཡོད་པ་ལྟ་བུ་སྤངས་པའི་ཕྱིར་ནི་གསུམ་པ་དེ་རབ་ཏུ་དབྱེ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "ལོགས་ཤིག་ཏུ་རྣམ་པར་ཕྱེ་སྟེ་རྣམ་པར་མ་བསྟན་ཏོ།",
    "དེ་ནི་འདི་སྐད་དུ་ཤེས་བྱའི་སྒྲིབ་པ་ལས་རྐང་ལ་ཡོད་པ་ལྟ་བུའི་གནས་ངན་ལེན་ནི་ཤིན་ཏུ་ཕྲ་བའི་ཕྱིར་རྣམ་པར་གྲོལ་བའི་ལམ་གྱི་ཚེ་མེགདོད་སྤོང་བས་ཟད་པར་འགྱུར་ཏེ།",
    "གནས་སྐབས་འདི་ནི་བག་ལ་ཉལ་རྣམ་པ་གསུམ་གྱི་གནས་ངན་ལེན་དང་བྲལ་བའི་དོན་ལོགས་ཤིག་ཏུ་རྣམ་པར་ཕྱེ་ནས་མི་སྟོན་གྱི།",
    "གསུམ་པ་ནི་ཤེས་བྱའི་སྒྲིབ་པར་གཏོགས་སོ་ཞེས་བསྟན་པའི་ཕྱིར་ཏེ།",
    "སྔར་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེར་བརྟགས་ནས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "བསྐལ་པ་གྲངས་མེད་པ་གསུམ་ཀྱི་དུས་ཀྱིས་དུཐོབ་པར་འགྱུར་རོ་ཞེས་འབྱུང་སྟེ།",
    "སློབ་དཔོན་གཞན་ཁ་ཅིག་ནི་འདི་སྐད་དུ་བསྟན་བཅོས་བྱེད་པས་སྔར་རགས་པ་བསྟན་ལ་ཕྱིས་ཕྲ་བ་བསྟན་པར་འདོད་པ་རྣམས་རིམ་གྱིས་འཇུག་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "འདི་ལྟར་ཕྲ་བ་ནི་ཁོང་དུ་ཆུད་པར་དཀའ་ཞིང་གསལ་བར་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འཇིག་པ་ཤིན་ཏུ་མྱུར་བ་ཇི་ལྟ་བུ་ལགས།",
    "བཅོམ་ལྡན་འདས་ཤིན་ཏུ་མྱུར་བ་ལགས་སོ།",
    "དེ་ནི་ཉི་མ་དང་ཟླ་བའི་དཀྱིལ་འཁོར་འདྲེན་པར་བྱེད་པའོ།",
    "དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་ཡང་དག་པའི་སྐད་ཅིག་མའི་ཚད་ནི་མ་གསུངས་པར་ཤེས་སོ།",
    "ཅི་འཕགས་པ་ཤཱ་རིའི་བུས་ཀྱང་ཤེས་པར་མི་ནུས་སམ།",
    "ཐུན་ཕྱེད་ཅེས་གསུངས་པ་ནི་ཆར་གྱི་དུས་སོ།",
    "ཐུན་ཞེས་གསུངས་པ་ནི་ཟླ་བ་བཞི་ལ་བྱའོ།",
    "རྒྱ་ཆེར་དེ་ཉིད་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "བསྐལ་པ་ནི་འདུས་བྱས་ཀྱི་འདུ་བྱེད་རྣམ་པར་འབྱེད་པའི་ནང་ན་མཐར་ཐུག་པའི་གནས་སྐབས་ཡིན་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "དེའི་བསྟན་བཅོས་དེ་ལས་བསྐལ་པ་ནི་རྣམ་པ་བཞིར་རིག་པར་བྱའོ།",
    "བསྐལ་པ་དཔག་ཏུ་མེད་པས་འགྲུབ་པའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ།",
    "སྐྱོན་ནི་གང་ལགས།",
    "ཡོན་ཏན་ནི་གང་ལགས་པར་རིག་པར་བགྱི་ལགས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི།",
    "ལན་གསུངས་པས་བསྟན་ཏེ།",
    "ཞུ་བ་གསོལ་བའི་དགོངས་པ་ནི་ལན་དུ་ག་སུངས་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "གཉིས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་ཡང་དག་པར་ལན་དུ་གསུངས་པ་སྟོན་ཏོ།",
    "རྒ་བ་ལ་སོགས་པ་སྡུག་བསྔལ་ནི་ཡང་དག་པར་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "སྦུག་བསྔལ་བསྐྱེད་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
