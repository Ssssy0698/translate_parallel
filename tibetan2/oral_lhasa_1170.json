    "རྣམ་པར་ཤེས་པའི་རྣམ་པར་རིག་པའོ།",
    "རྣམ་པར་ཤེས་པ་དག་ལ་ཡང་དག་པ་ཉིད་དུ་འཛིན་པ་དང་།",
    "འཇིག་རྟེན་གྱི་སྤྲོས་པ་དག་ལ་སེམས་ཀྱིས་བརྩོན་པར་བྱེད་པ་དང་།",
    "འདི་ཡང་ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པ་བསྟན་ཏེ།",
    "འདི་ནི་དང་པོ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་དུདག་སོ་སོའི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ཇི་ལྟ་བ་ཞིག་ལགས་ཞེས་ཞུས་པའོ།",
    "གོ་རིམས་བཞིན་དུ་སྦྱིན་པའི་སྟོབས་ཀྱིས་སྤུ་ལོངས་སྤྱོད་ཆེན་པོ་ཐོབ་པར་འགྱུར་བ་དང་།",
    "གཞན་ཡང་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མ་གཏོགས་པས་སོ།",
    "ལན་དུ་གསུངས་པ་བསྟན་ཏེ།",
    "རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པ་དང་།",
    "མ་གུས་པའི་སྦྱོར་བའི་ཕྱིར་དང་ཞེས་བྱ་བ་ནི་གཉིས་པ་གོ་རིམས་བཞིན་དུ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པའོ།",
    "གསུམ་པ་རྒྱུན་ཆད་པ་་མེད་པར་བསྒོམ་ཤྭེཔ་ནི་ནན་ཏན་བརྩོན་འགྲུས་ཀྱིས་ཐུསྐད་ཅིག་གཅིག་ལ་བསྒོམ་ཞིང་ཡོངས་སུ་སྐྱོ་བ་མེད་པའི་ཕྱིར་རོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ནི།",
    "འདིར་ནི་དང་པོ་སེམས་བསྐྱེད་པ་བཀོལ་བའི་ཕྱིར་རྣམ་པ་བཞིར་གསུངས་པ་ཡིན་ནོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ཀྱི་སྤྱོད་པ་ཁྱད་པར་བསྒོམ་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་གཅིག་ཁོ་ན་ལས་སྤྱོད་པར་འགྱུར་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་གཞན་རྣམས་ཀྱི་སྤྱོད་པ་ཡོངས་སུ་སྤོང་བར་འགྱུར་བས་ཚུལ་བཞིན་མ་ཡིན་པ་ཞེས་བྱ་སྟེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ལ་སྤྱོད་པ་ན་གལ་ཏེ་སྤྱོད་པ་གཞན་དང་བྲལ་བར་གྱུར་ན་ཚུལ་བཞིན་མ་ཡིན་པ་ཞེས་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཐམས་ཅད་མ་ལགས་པའི་སྤྱོད་པ་གང་ལགས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་བཞི་པ་ཞུས་པ་དང་།",
    "ལན་གསུངས་པ་དང་།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་ནི་ཐབས་མ་ཡིན་པའི་སྤྱོད་པར་གྱུར་པའི་གཏན་ཚིགས་བརྟག་པ་སྟེ།",
    "དཔེར་ན་འཇིག་རྟེན་ན་མི་གཙང་བ་ནི་ཆེ་ཡང་རུང་ཆུང་ཡང་རུང་ནམས་ཀྱང་དྲི་ཞིམ་པོའི་དངོས་པོར་མི་འགྱུར་བ་བཞིན་ནོ།",
    "དེ་ལ་མི་གཙང་བ་ནི་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་གྱི་དཔེར་བསྟན་པའོ།",
    "འདི་ཡང་རྣམ་པ་གཉིས་པོ་ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "འདི་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་དག་ལ་རྣམ་པར་དག་པའི་ཕྱིར་ཞེས་ཞུས་པའོ།",
    "སྔ་མ་ལྔ་ལས་རྣམ་པར་དག་པ་གུད་ན་མེད་པར་བསྟན་པ་དང་།",
    "འདི་ལྟར་ང་ནི་གོང་དུ་ཆགས་པ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནས་ཡང་དག་པར་ཡོངས་སུ་བསྔོ་བ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བའི་བར་གྱི་མཚན་ཉིད་ལྔ་པོ་དག་མ་གཏོགས་པར་གུད་ན་རྣམ་པར་དག་པའི་མཚན་ཉིད་ཡོད་པར་མི་གསུང་ངོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།་",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་སྤྱོད་པས་གཞན་ཤེས་པར་བྱས་ནས་གྲགས་པ་དང་རྙེད་པ་མི་ཚོལ་བའི་ཕྱིར་རོ།",
    "ལྕི་བའི་ཉེས་པར་འགྱུར་བའི་ཕྱིར་རོ།་།",
    "ལྔ་པ་བག་མེད་པར་མི་བྱེད་པའི་མཚན་ཉིད་བསྟན་པ་སྟེ།",
    "ཅུང་ཟད་ཙམ་དང་ངན་ངོན་ཙམ་གྱེས་ཆོག་པར་མི་འཛིན་པ་ཞེས་བྱ་བ་ནི་དྲུག་པ་ཆོག་པར་མི་འཛིན་པའི་མཚན་ཉིད་བསྟན་པ་སྟེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པའི་མཚན་ཉིད་སོ་སོ་ཐ་དད་པར་བསྟན་པ་ཡང་རྣམ་པ་བདུན་ཡོད་དོ་ཞེས་བྱ་བ་ནི་འདི་མན་ཆད་གཉིས་པ་སོ་སོ་ཐ་དད་པའི་མཚན་ཉིད་བསྟན་པའོ།",
    "མཚན་ཉིད་རྣམ་པ་བདུན་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པ་དང་།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་རྣམ་པར་དག་པས་སྦྱིན་པ་རྣམ་པར་དག་པ་སྤྱོད་པ་དང་།",
    "ལྟ་བ་རྣམ་པར་དག་པས་སྦྱིན་པ་རྣམ་པར་དག་པ་སྤྱོད་པ་དང་།",
    "སེམས་རྣམ་པར་དག་པས་སྦྱིན་པ་རྣམ་པར་དག་པ་སྤྱོད་པ་དང་།",
    "ངག་རྣམ་པར་དག་པས་སྦྱིན་པ་རྣམ་པར་དག་པ་སྤྱོད་པ་དང་།",
    "ཤེས་པ་རྣམ་པར་དག་པས་སྦྱིན་པ་རྣམ་པར་དག་པ་སྤྱོད་པ་དང་།",
    "དྲི་མ་རྣམ་པར་དག་པས་སྦྱིན་པ་རྣམ་པར་དག་པ་སྤྱོད་པ་ཞེས་བྱ་བ་ནི་གཉིས་པ་སྦྱིན་པའི་རྣམ་པར་དག་པའི་མཚན་ཉིད་རྣམ་པ་བདུན་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པའོ།",
    "དེ་ལ་དངོས་པོ་མ་བརྟགས་པ་ལ་སོགས་པ་མ་ཡིན་པས་སྦྱིན་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་རྣམ་པར་དག་པ་ཞེས་བྱའོ།",
    "བདག་ནི་སྦྱིན་པར་བྱེད་པའོ།",
    "ལྟ་བ་རྣམ་པར་དག་པ་ཞེས་བྱའོ།",
    "སྦྱིན་པའི་མིང་དང་ངོ་བོ་ཉིད་ལ་སོགས་པ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ལ་སོགས་པས་སྦྱིན་པ་གཏོང་བ་གང་ཡིན་པ་དེ་ནི་ཤེས་པ་རྣམ་པར་དག་པ་ཞེས་བྱའོ།",
    "གཏི་མུག་ལ་སོགས་པའི་དྲི་མ་ཡོངས་སུ་སྤངས་ནས་སྦྱིན་པ་གཏོང་བ་གང་ཡིན་པ་དེ་ནི་དྲི་མ་རྣམ་པར་དག་པ་ཞེས་བྱའོ།",
    "གདོད་སྦྱིན་པ་རྣམ་པར་དག་པ་ཡོངས་སུ་གྲུབ་པར་གྱུར་འཏེ།",
    "ཞིབ་ཏུ་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཡོངས་སུ་དག་པ་དེ་དག་ཐམས་ཅད་ཀྱང་རྣམ་པ་བཅུར་རིག་པར་བྱའོ།",
    "དེ་ལ་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོངས་སུ་དག་པ་རྣམ་པ་བཅུ་གང་ཞེ་ན།",
    "དེ་རྒྱ་ཆེན་པོ་སྦྱིན་པར་བྱེད་པ་ནི་འདི་ལྟ་སྟེ།",
