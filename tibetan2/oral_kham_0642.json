    "དེ་ཡང་རང་མཚན་ལ་མི་རྟག་པའི་སྤྱི་སྦྱར་ནས་བཟུང་ངོ་སྙམ་པ་རྣམས་ཀྱི་ཞེ་འདོད་ལ་གསུམ་སྟེ།",
    "གལ་ཏེ་རང་མཚན་ལ་ཡང་ཡང་ཤེས་པ་མེད་དུ་ཆུག་ཀྱང་རང་མཚན་དེ་ལ་ཡོད་པའི་སྤྱི་རྟག་པ་དེ་རང་མཚན་གྱི་སྒོ་ནས་ཡང་ཡང་ཤེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དུ་བ་སོགས་རྟགས་ལས་སྔར་གྱི་མེ་དེ་འདི་ན་ཡང་འདུག་གོ་སྙམ་པ་ནི་རྟགས་དེ་མེ་ཙམ་ལ་མ་འཁྲུལ་པ་ཡིན་པས་འབྲས་རྟགས་ཡིན་ཀྱང་སྔར་གྱི་དེ་འདིའོ་སྙམ་པ་ནི་འཁྲུལ་བ་ཡིན་ནོ།",
    "རིམ་ཅན་དུ་མཐོང་བ་ནི་གཅིག་དུས་ན་གཅིག་མེད་པས་དུས་ཅིག་ཅར་གསལ་སྣང་ཡོད་མི་སྲིད་ལ།",
    "རིགས་མེད་པའི་ཕྱིར་སྒྲས་ཀྱང་རང་མཚན་གོ་བར་མི་འགྱུར་རོ་ཞེ་ན།",
    "མི་མཐུན་པ་མཐའ་དག་བསྟན་ནས་འདི་ལ་མི་འཇུག་ཅེས་བསྟན་པར་ནི་སུས་ཀྱང་མི་ནུས་པས་སྒྲ་དང་རང་མཚན་འབྲེལ་མི་ནུས་ཏེ།",
    "གལ་ཏེ་བརྡ་དྲན་པ་དེ་ནི་དོན་དེ་མཐོང་བ་ཙམ་དང་རང་ཆས་སུ་འབྲེལ་ནས་སྐྱེ་བའི་ཕྱིར་བརྡ་དྲན་མེད་པ་མི་སྲིད་དོ་ཞེ་ན།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "དང་པོ་ལྟར་དོན་དང་བདེ་བ་གཉིས་ཀྱིས་སོ་སོ་སོོ་སོར་ཏེ་ཡན་གར་བ་ཡང་རང་འཛིན་ཤེས་པ་སྐྱེད་ནུས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འགའ་ཞིག་སྟེ་གྲངས་ཅན་པས་ནི་བདེ་སོགས་ཕྱི་རོལ་ན་དེ་ཙམ་ལྔའི་བདག་ཉིད་དུ་གནས་པ་ཉིད་དང་ནི་དེ་ཡང་སེམས་མེད་པ་དང་རང་ལས་གཞན་པར་གྱུར་པའི་ཤེས་པས་གཟུང་བར་སྨྲ་སྟེ་ཞེས་སོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "མ་བསྟན་ཀྱང་འདི་ན་སྦྲུལ་འདུག་ཅེས་བརྗོད་པས་སྦྲུལ་འཛིན་སྐྱེ་བ་བཞིན་ནོ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་པའོ།",
    "དངོས་དང་རང་མྱོང་བ་ཡི་དཔེ།",
    "སྐྱེས་བུའི་རྒྱུད་ཀྱི་ཤེས་པ་སྔོ་སོགས་ཤེས་པ་བཞིན་དུ་སྔོ་འཛིན་ཡང་རང་བློ་རང་ལ་ལྐོག་ཏུ་མ་གྱུར་པར་མྱོང་བ་དང་དྲན་པས་གྲུབ་པ་ལ་བསྙོན་དུ་མེད་དོ།",
    "དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་ཡིན།",
    "དཀར་སྣང་ནི་མ་བསླད་པའི་ཕྱིར་རྣམ་པ་གཏོད་བྱེད་ཀྱི་ཕྱི་དོན་དུང་རང་ཉིད་དཀར་པོ་ཉིད་དུ་ཡོད་ཅེས་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཇི་ལྟར་རང་རང་སོ་སོས་མཐོང་བ་དེས་དོན་དེ་དང་དེ་ལྟ་བུར་རིག་པའི་ཐ་སྙད་བྱེད་ཀྱང་ཡུལ་གྱི་སྣང་བ་དེ་ལ་བརྟན་མི་བརྟན་དང་།",
    "དེའི་ཕྱིར་ཕྱི་དོན་འདོད་པའི་ལུགས་ལའང་རང་རིག་འབྲས་བུ་ཡིན་པར་འགྱུར་རོ།",
    "དེས་ན་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུ་ཡིན་ན་དོན་མི་འདོད་པའི་ལུགས་ལ་ལྟ་ཅི་སྨོས་ཞེས་ཤེས་པར་འགྱུར་རོ།",
    "མིན་ཀྱང་རང་རིག་འབྲས་མི་འགལ།",
    "དེ་ཡང་རང་ལ་རང་ཡུལ་དུ་བདེན་ན་ཡུལ་དང་ཡུལ་ཅན་དང་དེ་རིག་པ་གསུམ་དུ་གནས་པས་དེ་གསུམ་ཐ་དད་དུ་འགྱུར་ལ།",
    "འཛིན་རྣམ་ལ་འཛིན་རྣམ་གཞན་མེད་ཀྱང་རང་རིག་མེད་པར་མི་འགྱུར་བའི་རྣམ་གཞག་ཐམས་ཅད་བདེ་བླག་ཏུ་གྲུབ་པ་ཡིན་ཏེ།",
    "བསྙོན་དུ་མེད་པའི་བློ་རྣམ་བཅས་དང་རང་རིག་པ་ལ་སྡང་བའི་བསམ་པ་དོར་བར་བྱས་ན་ལེགས་སོ།",
    "འོན་ཀྱང་བློ་གཅིག་དུས་གཅིག་ཏུ་སྣ་ཚོགས་སུ་འཆར་དུ་རུང་བའི་ཕྱིར་བློ་དང་དོན་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་བློ་ཡི་གཟུང་འཛིན་རྫས་གཅིག་ཏུ་གྲུབ་པས་རྣམ་བཅས་དང་རང་རིག་གྲུབ་པར་གྱུར་ན་དེ་འདྲའི་ལྷན་ཅིག་དམིགས་ངེས་དེས་ཕྱི་དོན་མེད་པར་འགྲུབ་སྟེ།",
    "གཞན་ལུགས་འགོག་དང་རང་ལུགས་བཞག།",
    "སྔར་ཞིག་ཟིན་དེ་ད་ལྟ་གསལ་པོར་སྣང་བ་མི་སྲིད་ཀྱང་རང་དང་དུས་མཉམ་པའི་རང་མཚན་ད་ལྟ་བ་དེ་རྗེན་ཅེར་གསལ་བར་སྣང་ངོ་ཟེར་ན།",
    "དོན་འདོད་པའི་ཞེན་ངོར་བྱས་ན་གཟུང་བའི་རྣམ་པ་དེས་ཁ་ཕྱིར་བལྟས་ཀྱི་དོན་རིག་པར་འདོད་པས་གཞན་རིག་དང་རང་རིག་ཐ་དད་པ་ལྟ་བུའི་ཚུལ་གཉིས་པ་ཅན་གྱི་བློར་བསྒྲུབས་ཀྱང་དོན་དུ་མྱོང་བ་དེ་ནི་རང་རིག་ཁོ་ན་ལས་གཞན་རིག་པ་མི་སྲིད་པར་ཤུགས་ཀྱིས་འགྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞན་མཐོང་བ་དང་རང་མ་མཐོང་བའི་ཆ་ཞེས་པ་ནི་འཁྲུལ་བས་སྒྲོ་བཏགས་པ་ཙམ་ལས་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "དུས་མཉམ་པས་ནི་ཕན་མི་འདོགས་ལ་དུས་མི་མཉམ་པའི་རྒྱུ་སྔ་མས་ཀྱང་རང་འདྲའི་རྣམ་པ་བློ་ལ་མི་བྱེད་པར་འདོད་པས་ན་ཅི་ལྟར་ཡུལ་དང་ཡུལ་ཅན་དེ་ནི་མཐོང་བ་ཞེས་པ་དང་།",
    "བདེ་མྱོང་རང་བློ་མངོན་སུམ་བསྒྲུབ།",
    "བདེ་མྱོང་རང་རིག་ཡིན་དམ་བཅའ།",
    "དེ་ལྟ་ན་རྣམ་བཅས་དང་རང་རིག་པ་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་དོན་ཙམ་མྱོང་བར་མ་ཟད་གཞན་ཤེས་པ་དེའང་རང་ཉིད་ཉམས་སུ་མྱོང་བའམ་མཐོང་བར་གདོན་མི་ཟ་སྟེ།",
    "དེ་ལྟ་ན་སྔོ་འཛིན་དེའང་རང་ཉིད་ཀྱི་ངོ་བོར་མྱོང་བ་དང་ཡུལ་ཅན་གྱི་ཚུལ་དུ་མི་སྣང་བར་སྔོན་པོ་བཞིན་དུ་ཡུལ་དུ་སྣང་བར་འགྱུར་རོ།",
    "དེ་ལས་སྐྱེས་པའི་ཤེས་པ་གསལ་བ་དེ་ཡང་རང་རིག་པས་མ་མྱོང་ན་གསལ་བར་མི་རྟོགས་ལ།",
    "དངོས་དང་རང་ལ་དེ་མི་མཚུངས།",
    "ལུང་རང་ལ་བརྟེན་ནས་ཀྱང་བསྒྲུབ་བྱ་དངོས་ལ་གནོད་པའམ།",
    "ལུང་དང་རང་ཚིག་བསྡུས་ཏེ་བཤད།",
    "དེ་ཡང་རང་ལུགས་ལ་རྡུལ་ཕྲན་རྟག་པ་མིན་ཀྱང་གཞན་ཕྱི་རོལ་པའི་འདོད་ངོར་མཐུན་ཕྱོགས་བྱས་ཚེ་དེ་ལ་རྟགས་འདི་མ་གྲུབ་པར་སྟོན་པའི་ཆེད་དོ།",
