    "ལེའུ་དྲུག་པའི་རབ་ཏུ་བྱེད་པ་དང་པོས་བདེ་མཆོག་གི་གླེང་གཞི་བསྟན་ཅིང་དགའ་བའི་རྡོ་རྗེའི་ལུས་ཀྱི་སྐྱེ་བ་ཤེས་བྱར་བསྟན་པ་དང་།",
    "དེ་ལྟར་ལེའུ་དྲུག་གི་རབ་ཏུ་བྱེད་པ་ཉི་ཤུ་རྩ་བཞིས་མཆོག་གི་དངོས་གྲུབ་བསྒྲུབ་པ་བསྟན་ཏོ།",
    "ཤེས་རབ་སྲས་པོ་ཁྱོད་སྨྲོས་ཤིག།",
    "ཕྱག་ན་རྡོ་རྗེ་ཁྱོད་སྨྲོས་ཤིག།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གསུམ་གྱིས་སྡུད་པ་པོའི་གླེང་སློང་བ་བསྟན་ཏེ་༡འདི་སྐད་ཅེས་བྱ་བ་༐",
    "གནས་གང་དུ་ཞེ་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་ད་ང་ཐུགས་རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་ལ་བཞུགས་༡པའོ།",
    "ཡེ་ཤེས་དེའི་གཟུང་བའི་རྣམ་པའི་ཆ་ནི་ཤེས་རབ་སྟེ་བཙུན་མོའོ།",
    "གནས་ནི་ལུས་ངག་ཡིད་གསུམ་བདེ་བ་རོ་གཅིག་པའི་བཙུན་མོའི་བྷ་གའོ།",
    "འཛུམ་པ་མཛད་པ་ནི་རང་གི་སེམས་འོད་གསལ་བ་ཀློ་བུར་གྱི་དྲི་མ་དག་པའོ།",
    "གང་ཟག་གསུམ་གྱི་ཤེས་བྱའི་ཐུན་མོང་གི་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་རྒྱུད་དེ།",
    "གཟུགས་ལ་སོགས་པ་ཡུལ་དྲུག་སྟོང་ཞིང་མེད་པས་ན་དམིགས་པའི་རྣམ་པར་ཤེས་པ་དྲུག་རི་བོང་གི་རྭ་བཞིན་དུ་སྐྱེ་བར་ཐལ་བར་མི་འགྱུར་རོ་ཞེས་ཞུས་པ་ཡིན་ནོ།",
    "རི་བོང་གི་རྭ་ལྟར་མེད་པའམ་རྣམ་པར་བ་ཅད་པ་ཙམ་འབའ་ཞིག་ནི་མ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་སྒྲིབ་༐",
    "ཕྱོགས་གཅིག་གི་བག་ཆགས་ཀྱི་ས་དཀྲིས་པས།",
    "དེའི་༢བུ་ག་དགུའི་མཐའ་ལས་མི་འདའ་བ་རྐང་པ་ནས་སྤྱི་གཙུག་གི་མཐར་ཐུག་པའམ།",
    "པའི་སོར་མོ་གཉིས་དང་།",
    "ཡང་ན་ལྟེ་བའི་ཁུང་ནས་མར་སོར་དགུའི་མཐར་ཨ་ཝ་དྷཱུ་ཏཱིའི་རྩེ་མོར་གནས་པ་ཡང་འུསོར་གཉིས་ཀྱི་མཐར་ཚངས་པའི་བུ་གའི་མཐར་གནས་ཀྱང་ཟེར་ར་རོ།",
    "འདིར་གང་གིས་བཀག་ཅེ་ན།",
    "དེ་ལ་སྟེང་དུ་མེའི་ས་བོན་ཏེ་༡དྲག་མོའི་ས་བོན་ཀྵུཾ་ངོ།",
    "སའི་ས་བོན་ནི་གཏུམ་མོའི་ཡི་གེ་ཧཱུཾ་ངོ།",
    "གཏུམ་མོའི་ས་བོན་ནི་རྫོགས་པའི་ཡི་གེ་ཡུཾ་མོ།",
    "ཆུའི་ས་བོན་ནི་མཁའ་འགྲོ་མའི་ས་བོན་སུཾ་མོ།",
    "གཏི་མུག་གི་ས་བོན་ནི་སེང་གེ་མའི་ཡི་གེ་མྺཱཾ་ངོ།",
    "ཞེ་སྡང་གི་ས་བོན་ནི་སྟག་མོའི་ཡི་གེ་སྨྼྻུཾ་ངོ།",
    "གོམ་པ་གཅིག་གིས་མྱ་ངན་འདས།",
    "༢གང་གི་ཚེ་རྣམ་པར་རྟོག་པའི་ལུས་ཞིག་ནས།",
    "དེས་ན་དེ་ལྟར་ངོ་ཤེས་པའི་སེམས་དེ་ཉིད་ཉོན་མོངས་པའི་སྒྲིབ་པས་མི་གོས་ཤིང་ཤེས་བྱའི་སྒྲིབ་པའི་དྲི་མ་སྤངས་པའོ།",
    "བྲམ་ཟེ་མོ་ལ་སོགས་པ་བཞི་ནི་གནས་ལ་སོགས་པ་ལས་སྐྱེས་པ་འཇིག་རྟེན་དུ་གྲགས་པ་ཡིན་ནོ།",
    "དཔའ་བོའི་ལྷ་མོ་བཀས་བསྒོས་སྐྱེས།",
    "རྒྱལ་རིགས་ནི་རྒྱལ་སྲིད་ད་ང་ལྡན་པའི་བུ་མོའོ།",
    "དམངས་རིགས་ཤན་པ་མོ་དགནི་ཉ་པ་དང་ཤན་པ་དང་ལྷམ་མཁན་ལ་སོགས་པ་རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་རིགས་སོ་། ལྷག་མའི་རིགས་བཞི་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་མ་གཏོགས་པ་བཞི་དང་མཐུན་པར་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ནི་སླར་སོང་ནས།",
    "ཤེས་རབ་འདི་ནི་ཞེས་བྱ་བ་ནི་མཚན་ཉིད་ཀྱིལྟ་བ་བཞིན་དུ་རང་གིས་རྟོགས་ཤིང་།",
    "དེ་བཞིན་ཉིད་རང་གིས་མཁྱེན་ནས་སླར་བྱོན་ནས་ཉིད་ཀྱིས་གཟིགས་པའི་ལམ་དུ་གཟུང་བ་ནི་རྣལ་འབྱོར་གྱིས་མངོན་སུམ་རིག་པ་འདིས་བུད་མེད་རྣམས་ལ་ཤེས་རབ་ཅེས་བྱའོ།",
    "སྔ་མ་ནི་དེ་བཞིན་གཤེགས་པ་དང་མཚན་ཉིད་མཐུན་པས་བུད་མེད་ལ་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ཡིན་ལ།",
    "ཕྱི་མ་ནི་དེ་བཞིན་གཤེགས་པས་མཁྱེན་ནས་བུད་མེད་རྣམས་ཤེས་རབ་རབ་ཏུ་བསྟན་པ་ཡིན་ནོ།",
    "འཁོར་ལོ་ནོར་བུ་ཅན་སྒྲ་དང་ཚོགས་ཀྱི་སྣ་ཚོགས་རྡོ་རྗེ་འཛིན་པ་ལས་ཀྱི་རིགས་བསྡུ་བའོ།",
    "འོད་གསལ་བའི་རང་བཞིན་བསྒོམ་མོ།",
    "སྐལ་བ་དྲུག་དང་ལྡན་པའི་ཉོན་མོངས་པ་འཇོམས་པས་ན་བཅོམ་ལྡན་འདས་ཞེས་བྱའོ།",
    "མ་དང་སྲིང་མོ་བུ་མོ་རྣམས་ཤེས་རབ་༡ཀྱང་བརྡར་བཏགས་ལ་ཚོས་མཁན་ད་ང་གར་མཁན་དང་གཡུང་མོ་ཞེས་ཀྱང་བརྡར་བརྗོད་ལ།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཉམས་སུ་བླངས་ན་འོད་གསལ་བའི་རང་བཞིན་ཉིད་༢རྟོགས་ན་ངག་གི་བརྗོད་པ་ཐམས་ཅད་བཟླས་པ་དང་།",
    "ངག་གིས་ཇི་སྙེད་བརྗོད་པ་རྣམས།",
    "རྒྱུན་རྣམས་༤རྣལ་འབྱོར་པ་རང་གི་ད་གའ་བ་གསུམ་ལས་ལུས་དང་སེམས་མངོན་སུམ་དུ་ལོངས་སྤྱད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ཤེས་རབ་བརྩོན་འགྲུས་ཀྱི་གྲོགས་དང་བཅས་པས་ཉོན་མོངས་པ་མ་ཞསྐྱེས་པ་༐",
    "འདུན་པ་བསྐྱེད་ཅིང་དངོས་གཞི་ལ་འབད་དེ་རྗེས་ལ་བརྩོན་འགྲུས་རྩོམ་མོ།",
    "ཏིང་ངེ་འཛིན་བཞི་ལ་རེ་རེས་ཀྱང་མི་མཐུན་པའི་ཕྱོགས་༐",
    "པ་དང་འུཏིང་ངེ་འཛིན་དང་བཏང་སྙོམས་ནི་ཉོན་མོངས་པ་མེད་པའི་ཡན་ལག་གོ།",
    "ཉོན་མོངས་པའི་གཉེན་པོ་ནི་རྩོལ་བའོ།",
    "ཉེ་བའི་ཉོན་མོངས་པའི་གཉེན་པོ་ནི་མངོན་ཤེས་སོ།",
    "ངོ་བོ་ཉིད་ལ་ཕྱིན་ལོག་ག་གིས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འཁོར་ལོ་བཞིའི་རྩ་གཙོ་མོ་བརྒྱ་ཉི་ཤུ་བསྟན་པ་དང་།",
