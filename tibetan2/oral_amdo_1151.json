    "ཨོཾ་བཛྲ་གུ་ཧྱེ་ཞེས་པ་ལ་སོགས་པ་རང་རང་གི་སྔགས་སྔར་གསུངས་པ་རྣམས་ཀྱིས་གོ་རཱི་ལ་སོགས་པ་ལྷ་མོ་བཅུ་དྲུག་པོ་རྣམས་ལ་ད་བུལ་བར་བྱའོ་ཞེས་པ་ཁྱད་པརཏེ།་",
    "དེ་ལྟར་བསྐྱེད་པའི་རིམ་པའི་གཏོར་མའི་ཆོ་ག་རྣམ་པ་གསུམ་མོ།",
    "ཆོ་ག་འདི་རྣམས་ལ་ཡང་ཞི་བ་ལ་སོགས་པ་གཙོ་བོའི་བྱ་བའི་དབྱེ་བ་ལས་དུས་དང་ཕྱོགས་དང་ཁ་དོག་གི་དབྱེ་བ་རྟོགས་པར་བྱའོ།་།",
    "ཆུ་ལྷ་དང་བདེན་བྲལ་དག་གི་བར་དུ་ཐགས་བཟངས་རིས་དང་སའི་ལྷ་མོ་དག་ལའོ།་།",
    "མན་ངག་གི་༢སྙེ་མར་སྙེ་མ་སུམ་ཅུ་བཞི་པའོ།་",
    "ཕོ་ཉ་མོ་ནི་རྡོ་རྗེ་རྣལ་འབྱོར་མའོ།",
    "དེ་ལ་ཕོ་ཉ་མོའི་གཙང་སྦྲ་ནི་བཅོམ་ལྡན་འདས་མའི་གཟུགས་སུ་བསྒོམས་པས་སོ།",
    "ཟླ་བ་ནི་གཏུམ་མོ་ལ་སོགས་པ་བསྒོམས་པས་སོ།",
    "མཛེས་པའི་སྟོན་མོ་ནི་བདུད་རྩི་མྱོང་བའི་ཆོ་ག་བསྒོམས་པས་སོ།་།",
    "དེའི་རང་གི་སེམས་འདོད་ཆགས་ལ་སོགས་པས་དྲི་མ་ཅན་དུ་གྱུར་པས་འབྲས་བུ་མེད་པ་ནི་དག་བྱེད་མ་ཡིན་ནོ།་།",
    "དུང་ལ་སོགས་པ་རྣམས་རང་གི་རྒྱུ་དག་བྱེད་མ་ཡིན་པ་ཉིད་དུ་འདོད་པ་རྣམས་ལས་ཡང་དག་པར་བྱུང་བ་རྣམས་ཀྱང་གཙང་བྱེད་ཉིད་དུ་འཇིག་རྟེན་ཡང་དག་པར་འདོད་ན།",
    "སོ་སོའི་སྐྱེ་བོ་ཉིད་ལ་རང་བཞིན་གྱིས་ཡོངས་སུ་དག་པའི་དེ་ཁོ་ན་ཉིད་ལ་༡ལྷག་པར་མོས་པ་ལས་དེའི་རྒྱུ་ཅན་དང་དེའི་རང་བཞིན་ཐམས་ཅད་དག་བྱེད་ཁོ་ན་ཡིན་ན་དྲི་མ་མེད་༢ཅིང་རྣམ་པར་དག་པའི་དེ་ཁོ་ན་ཉིད་རྟོགས་པ་ན་ནི་བཅོམ་ལྡན་འདས་དང་།་",
    "གང་གི་ཕྱིར་རྣམ་པ་འདི་ལྟ་བུ་ཁོ་ན་དག་བྱེད་ཡིན་པ་དེའི་ཕྱིར་མཆོད་བྱ་སྟེ།་",
    "ཚོན་ཡང་པདྨར་གནས་པའི་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་རྣམ་པ་ཅན་དུ་ལྷག་པར་མོས་ཏེ།",
    "འབྲི་སྨྱུག་ནི་ཤེས་རབ་ཡེ་ཤེས་ཀྱི་རང་གི་ངོ་བོར་ལྷག་པ་ར་མོས་ནས་ཤེས་པ་ཁོ་ན་ཁྱད་པར་ཏེ།",
    "མན་ངག་གི་༢སྙེ་མར་སྙེ་མ་སུམ་ཅུ་ལྔ།་",
    "ཡང་དང་ཡང་དུ་རྣལ་འབྱོར་གོམས་པས་ད་བང་དུ་གྱུར་པའི་རྣལ་འབྱོར་པ་རྣམས་ནུས་པ་ཉེ་བར་སྟོན་པ་ལ་གྲུབ་པའི་དུས་སུ་ཡང་རྡོ་རྗེ་སྒེག་མོ་རྣམས་ལ་རོལ་བར་གསུངས་པ།",
    "འདི་ལྟར་ཞེས་པ་ལ་སོགས་པ་རོལ་མོ་སྟེ་འདོད་པའི་རྒྱལ་པོའོ།",
    "བུད་མེད་ཁྲག་ནི་མེ་ཏོག་སྟེ་དེས་ཆུ་སྐྱེས་༐",
    "དེ་ལ་མཎྜལ་གྲུ་བཞི་པའི་དབུས་སུ་རྡོ་རྗེ་འཛིན་པའི་གཟུགས་སུ་གནས་པས་འདབ་ཆགས་ཆུ་སྐྱར་གྱི་རྐང་པ་བཞིན་དུ་སྟེང་དུ་བྱས་པའི་རྐང་པ་གཡོན་པའི་རྟིང་པས་འགུགས་པའི་ཚུལ་གྱིས་ཆེ་གེ་མོ་ཨཱ་ཀཪྵ་ཡཱ་མི་ཁེ་མ་ཧཱུྃ་ཞེས་བསྒྱིངས་པ་དང་བཅས་པ་བརྗོད་ཅིང་དེ་དེའི་རྐང་པའི་འོག་ཏུ་གནས་པ་དཀྱིལ་འཁོར་དུ་གདུང་བར་བྱའོ།",
    "ཀྱེ་ཁྲོ་བོ་སྔོན་པོ་མཛེས་པ་ཁྱོད་དེ།",
    "ཕྱག་གིས་ནི་དབྱུག་པ་ནོར་བུ་རྣམས་ཀྱིས་བཅིངས་པ་འཛིན་ཏོ།",
    "གི་བསལ་༢བ་དེ་ཀུན་དོར་ཏེ་རྡོ་རྗེའི་གླུ་ཞེས་པའི་དོན་ཏོ།",
    "སྒྱུག་མོ་ནི་སྒྱུག་མོ་ཉིད་ད་དོ།",
    "སྒྱུག་མོ་ཅན་ཞེས་ཀློག་པ་ལ་ཡང་དེ་ལྟར་རོ།",
    "གཞན་རྣམས་ལ་རེ་རེའོ།",
    "གླུ་གར་དེ་བཞིན་རོལ་མོ་དང་།",
    "འཁོར་ལོར་ཡོན་བཅས་སྟོན་མོ་ནི།",
    "རོལ་མོ་དང་གླུ་དང་གར་དང་ཕྱག་རྒྱའི་བྱ་བའི་དེ་ཁོ་ན་ཉིད་བཞི་རྣམས་ཀྱིས་གསལ་བའོ་ཞེས་པ་བྱ་བའི་དེ་ཁོ་ན་ཉིད་བཞིའི་རྒྱལ་པོའོ།",
    "མན་ངག་གི་༢སྙེ་མར་སྙེ་མ་སུམ་ཅུ་དྲུག་པའོ།་",
    "མཆོག་གི་སྐྱེས་བུ་དོན་དུ་གཉེར་བས་ཀྱང་རིམ་པ་གཉིས་བསམ་གཏན་པར་བྱེད་དོ།",
    "དེ་རྣམས་ཀྱི་རྩེ་མོ་མཆོག་བླ་ན་མེད་པ་སྟེ།",
    "གང་གི་ཕྱིར་འདིས་ཀྱང་དང་རྡོ་རྗེ་སེམས་དཔའི་གཟུགས་གཙོ་བོར་སེམས་དཔའི་ཆོ་གས་ཀྱང་དང་།",
    "སོར་མོ་བསྐྱོད་པ་ལ་སོགས་པས་ཀྱང་ཇི་ལྟར་རིགས་པར་འདུས་བྱ་སྟེ།",
    "ཞེ་སྡང་བདག་ཉིདགདོལ་པ་མོ།",
    "ཞེས་པ་འདིས་རིགས་ངེས་པར་༡རྟོགས་པ་ཡང་དང་པོ་པའི་ལྷག་པར་མོས་པ་ལ་ལྟོས་པ་ཁོ་ན་སྟེ།",
    "གདོལ་མོ་པདྨ་འི་རིགས་ལས་སྐྱེས།",
    "གཡུང་མོ་རྡོ་རྗེའི་རིགས་ཉིད་དང་།",
    "བུད་མེད་ནི་གདོལ་བའི་བུད་མེད་དམ།",
    "གཡུང་མོའི་བུད་མེད་དམ།",
    "ལྷ་མོའི་ཁྱད་པར་གྱི་ངོ་བོ་ཉིད་བརྗོད་པའི་ཆེད་དུ་གསུངས་པ།",
    "རང་གི་ཤེས་རབ་ནི་རིམ་པ་ཇི་ལྟ་བར།",
    "རང་བཞིན་རང་གི་བདེ་ཞི་བ།",
    "ཟླ་བ་དྲུག་ཏུ་རིག་མའི་བརྟུལ་ཞུགས་སྤྱད་ནས་ཉིན་མོ་བདུན་རང་གི་ལྷ་བལྟ་བ་བྱས་ཏེ།",
    "གང་གི་ཚེ་ཉིན་མཚན་དུ་མར་མེའི་འོད་ཀྱི་རྒྱུན་བཞིན་དུ་རྟག་ཏུ་དེ་ཁོ་ན་ཉིད་ཀྱི་རྣལ་འབྱོར་ལ་མངོན་དུ་ཕྱོགས་པར་ནུས་པ་དེའི་ཚེ།",
    "ཐོ་རངས་ཀྱི་ཐུན་ནས་བརྩམས་ལ་རྫོགས་པའི་རིམ་པའི་རྣལ་འབྱོར་ཁམས་གསུམ་པ་ཐམས་ཅད་གཅིག་པའི་རང་བཞིན་མཉམ་པར་གཞག་པ་དང་མཉམ་པར་མ་བཞག་པར་གཅིག་པའི་ངོ་བོར་ལྷག་པར་མོས་ནས།",
    "དེ་ནས་རབ་ཀྱི་མཐར་ཐུག་པར་སོན་པའི་དགའ་བ་བཞིའི་དེ་ཁོ་ན་ཉིད་མངོན་དུ་བྱེད་པ་ལས་སྐྱ་རེངས་འཆར་བའི་དུས་སུ་འགྲུབ་སྟེ།",
    "སྐྱ་རེངས་ཤར་བའི་དུས་སུ་ཤིན་ཏུ་ཡོངས་སུ་དག་པའི་ཡེ་ཤེས་བདུད་རྩི་ཡོངས་སུ་རྫོགས་པས་ཕྱག་རྒྱ་ཆེན་པོ་གྲུབ་པ་རྡོ་རྗེ་འཛིན་པའོ་ཞེས་པའོ།",
    "སྐྱ་རེངས་འཆར་བའི་དུས་སུ་ནི།",
    "ལེ་ལོ་འདི་ཡང་འདི་ལ་ཐེ་ཚོམ་དང་ཕྱིན་ཅི་ལོག་དག་གིས་ཚུལ་གཞན་ལ་ཞུགས་པ་དང་འདིར་ཞུགས་པ་ཉིད་ན་ཡང་དོན་མ་རྟོགས་པ་ཉིད་ཀྱིས་རྨོངས་པ་འམ་མ་ཞུགས་པའི་ད་བང་དུ་བྱས་ནས་གསུངས་པའོ།",
    "མན་ངག་གི་སྙེ་མར་སྙེ་མ་སུམ་ཅུ་བདུན་པའོ།་",
    "གང་དུ་ནི་ཉིན་མོར་རབ་གནས་སུའོ།",
    "གང་གི་ཕྱིར་རྡོ་རྗེ་སློབ་དཔོན་ནི་རྡོ་རྗེ་འཛིན་པ་སྟེ།",
    "དེ་ལ་གང་གི་ཚེ་ཤར་ཕྱོགས་སུ་ལྗོན་ཤིང་དང་རི་ལ་སོགས་པ་རྣམས་འཁྲུག་པ་ཆེན་པོར་འགྱུར་༢ི་བ་དེའི་ཚེ་ཤར་ཕྱོགས་མཐོ་བར་སྣང་སྟེ་ནུབ་ཕྱོགས་དམའ་བར་རོ།",
    "གང་གིས་རྒྱ་མཚོ་ཆེན་པོ་འཁྲུག་པ་དེ་ལྟ་བུའི་སྒྲ་དེ་གང་རྣམས་ཀྱི་ཡིན་པ་དེ་རྣམས་ནི་དེ་སྐད་ད་དོ།",
