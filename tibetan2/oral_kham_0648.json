    "དཔེར་ན་འགྲོ་བ་ཀུན་དང་སློབ་པ་དང་མི་སློབ་པ་དང་རང་རྒྱལ་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་བཞིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གདན་བཤམས་པའི་ཕྱོགས་ཀྱི་ཉེ་འཁོར་དུ་འདུག་པར་འོས་པའི་གནས་ལས་ཕྱི་རོལ་ན་འདུག་པའི་ཕྱིར་ཡུལ་ལས་འདས་པའོ།",
    "མི་འདུད་རབ་ཏུ་མི་འདུད་ཁེངས་པར་མ་ཡིན་གུས་པར་མ་ཡིན་པར་མི་གནས་པར་འདུག་སྟེ།",
    "དུས་ཐམས་ཅད་དུ་དེ་བཞིན་དུ་འདུག་པས་ན།",
    "དམིགས་པ་གང་ལ་གནས་ཤིང་འདུག་ཅི་ལ་གནས་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེའི་ཚེ་ཅི་ལ་གནས་ཏེ་ཞེས་བྱ་བ་ནི་དམིགས་པ་གང་ལ་སེམས་འདུག་ཅེས་བྱ་བའོ།",
    "དུས་ཐམས་ཅད་དུ་དེ་བཞིན་དུ་འདུག་པའི་ཕྱིར་དང་འདུས་མ་བྱས་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་དག་པའི་མཐའ་བརྩོན་པར་བགྱིས་ན་ཞེས་བྱ་བ་འདིས་ནི་རྡོ་རྗེའི་གདན་ལ་འདུག་པ་ལ་སོགས་པ་ཕྱིན་ཅི་ལོག་ཡིན་བར་བསྟན་ཏེ།",
    "དགོས་པ་ལ་ལའི་ཕྱིར་སོན་པར་གྱུར་པ་ལ་ཞེས་བྱ་བ་ནི་གྲོང་ལ་སོགས་པའི་ནང་དུ་ཡུན་རིང་དུ་མི་འདུག་པ་དང་།",
    "འདི་གཉིས་ལྷན་ཅིག་ཏུ་འདུག་པར་རྣམ་པ་མང་དུ་བསྟན་པའི་ཕྱིར་རོ།",
    "སྦྱོར་བའི་ཚུལ་ལ་གུས་པས་རྟག་ཏུ་བསྟེན་ཅིང་འདུག་ཤིག་དང་ཇི་ལྟ་ཇི་ལྟར་ཡང་དག་པར་བླངས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཡང་དག་པར་བླངས་ཏེ་འདུག་ཤིག་དང་།",
    "དེས་ནི་ཞི་གནས་དང་ལྷག་མཐོང་དང་དེ་གཉི་གའི་གགས་སུ་གྱུར་པ་ཡོངས་སུ་སྤོངས་ལ་འདུགཤིག་པར་བསྟན་ཏོ།",
    "འདུག་པ་དེ་ལྟ་དེ་ལྟར་ཏིང་ངེ་འཛིན་འདིའི་ཡོན་ཏན་མཐོང་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལ་ཇི་ལྟ་ཇི་ལྟར་ཞེས་བྱ་བ་ནི་ལན་མང་དུ་བྱེད་པ་བསྟན་པ་ཡིན་ཏེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བ་དང་།",
    "གནས་པ་ནི་འདུག་པ་སྟེ།",
    "བཞུགས་པ་ནི་འདུག་པའོ།",
    "དེ་ལྟར་འདུག་པ་དེ་ཡང་དེ་དག་བདག་མེད་པ་གཉིས་སྟོན་པའི་བདག་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉན་པའི་འོས་སུ་གྱུར་པ་ཡིན་ནོ།",
    "སྒོར་འདུག་པ་བདེན་ནམ་ཞེས་བྱ་བའི་བར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་འཇམ་དཔལ་དབྱངས་ལ་འདྲི་བའོ།",
    "མུན་རུམ་གྱི་ནང་ན་བུམ་པ་ལ་སོགས་པ་འདུག་པ་བཞིན་ནམ།",
    "གནས་པ་ཞེས་བྱ་བ་ནི་འདུག་པ་སྟེ།",
    "དེ་ལ་དམིགས་ཤིང་འདུག་ཅེས་བྱ་བའི་བར་དུ་ཡིན་ནོ།",
    "སྤྱི་འམ་བློ་ལ་གཟུགས་བརྙན་དུ་འདུག་པ་ཞིག་ཡིན་གྲང་།",
    "དུས་ཐམས་ཅད་དུ་ཆ་ཤས་དང་བཅས་པར་འདུག་པ་ཡིན་ནོ།",
    "ཡོན་ཏན་གང་དག་ཡིན་པ་གཉེན་པོ་གོམས་པ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པར་འགྱུར་བ་སྟེ།",
    "སྒྲའི་དོན་མེད་དུ་ཟིན་ཀྱང་རང་བཞིན་ལ་གོ་འགལ་བ་ཅི་ཡོད་ཅེ་ན།",
    "ཞི་བ་འདི་གཉིས་ཀྱི་ནང་ན་ཤིན་ཏུ་ཞི་བར་འདུག་པ་ཡིན་ནོ་ཞེས་བྱ་བས་ནི་འདི་ཞི་བ་ཉིད་དུ་ངེས་པ་དང་།",
    "འདུག་གོ་ཞེས་བདག་རྣམ་པར་རྟོག་པར་གྱུར་ན།",
    "ཕྱི་མའི་མཐར་འདུག་པ་མ་ཡིན་ན་སྔོན་གྱི་མཐའ་ནས་མ་ཡིན་ཞེས་བྱ་བ་དེ་རིགས་པ་མ་ཡིན་ནམ།",
    "མ་བགྱིས་པ་ནས་མ་འགགས་པའི་བར་ནི་མཉམ་པ་ཉིད་དུ་འདུག་པ་ཡིན་ཏེ།",
    "བར་དུ་ཞེས་སྨོས་པས་ཐོག་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལ་སོགས་པའི་རྣམ་པ་རྣམས་གཟུང་ངོ།",
    "རྟག་པར་དུས་ཐམས་ཅད་དུ་འདུག་པའི་ངོ་བོ་ལ་བྱེད་པ་མེད་དོ་ཞེས་སྦྱར་རོ།",
    "གཞན་ཡང་རུང་བ་དེ་བཞིན་གཤེགས་པ་དེ་བཞུགས་པ་དེར་དགའ་བ་དང་གུས་པ་བསྐྱེད་ནས་ཕྱོགས་དེར་མངོན་དུ་བལྟས་ཏེ་འདུག་པར་བྱའོ།",
    "འོན་ཀྱང་དེ་དག་ལ་འདི་སྐད་ཅེས་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོངས་སུ་བསྒྲགས་པ་འདི་ཡང་དག་པར་ཟུང་ལ་འདུག་ཅིག་དང་ཞེས་བྱ་སྟེ།",
    "ཡང་ན་ཡིད་མ་གཏོད་ཅིག་ཅེས་བྱ་བ་ནི་མཉན་ཏོ་སྙམ་དུ་དེ་ལྟར་མ་འདུག་ཅིག་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "ཤམ་ཐབས་ཞེས་བྱ་བ་ནི་ཁྱིམ་དུ་འདུག་པ་དང་མཐུན་པའི་གོས་མནབས་པ་སྟེ།",
    "འདུག་ཅེས་བྱ་བ་ནི་སྟན་ལ་འདུག་པའོ།",
    "གཞན་དུ་ན་ནི་འདུག་གོ་ཞེས་བྱ་བ་དེ་ཙམ་ཁོ་ནས་གཉིས་ཀ་སྨོས་པར་འགྱུར་རོ།",
    "དེ་དག་དུས་མཉམ་པ་ཙམ་གྱིས་ཀྱང་ཐོབ་པར་བྱ་བ་དང་།",
    "རྣམ་པར་རྟོག་པ་དེ་ཡང་རང་བཞིན་གྱིས་འཁྲུལ་པ་ཡིན་པས་དེས་སྒྲོ་བཏགས་པའི་རྣམ་པ་དེ་ཡང་བརྫུན་པ་ཉིད་དོ།",
    "ཤེས་རབ་ལ་འཇུག་པ་ནི་ཕུང་པོ་ལྔ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་བལྟའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་ཉིད་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་བལྟའོ་ཞེས་པ་ལ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ་ཞེས་པ་ནི་ཕུང་པོ་ལྔ་པོ་དེ་དགནི་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དོ།",
    "དེ་ཡང་བཏགས་པས་སྒྱུ་མ་དང་རྨི་ལམ་དང་འདྲ་ལ་རང་བྱུང་རང་ཞི་བ་ཡིན་ཡང་།",
    "དེ་ནས་སྐྱོ་བ་དང་སྤྲོ་བ་དེ་ཡང་རང་།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ལྟའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཁྱིམ་མུན་ནག་ཡུན་རིང་པོར་འདུག་པ་ལ།",
    "དེ་ལྟར་རང་རང་དང་མཐུན་པའི་སྡུད་པ་པོས་ནི་བསྟན་པ་ཡང་དག་པར་བསྲུང་པའི་དོན་དུ།",
    "དེ་ཉིད་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་རྟོགས་པའི་ཕྱིར་མཚན་མ་མེད་པ་ཉིད་རྟོགས་པ་ནི།",
    "རང་རང་རྟོག་པ་དང་ལྡན་པའི་ཕྱིར་རོ།",
