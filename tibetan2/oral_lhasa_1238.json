    "དེ་ལ་བཀླགས་ཏེ་ཤིན་ཏུ་དག་པར་འགྱུར།",
    "ཡང་དག་པར་བླངས་ཏེ་བསླབ་པའི་གཞི་རྣམས་ལ་སློབ་ཅིང་ཞེས་བྱ་བ་ནི་ཀུན་ནས་ཡོངས་སུ་རྫོགས་པར་བསླབ་པའི་གཞི་རྣམས་ལ་སློབ་པའི་ཕྱིར་རོ།",
    "སྦྱངས་པའི་ཡོན་ཏན་བཅུ་གཉིས་ཡང་དག་པར་བླངས་ཀྱང་ཞེས་བྱ་བ་དེ་ལ་སྦྱངས་པའི་ཡོན་ཏན་བཅུ་གཉིས་ནི་བསོད་སྙོམས་པ་དང་།",
    "བྱས་པ་ཆུད་གསོན་པའི་ཚུལ་ཅན་ཞེས་བྱ་བ་ནི་སྔར་གྱི་ས་བོན་སྐྱེད་དང་བཅས་པ་ལ་ལོངས་སྤྱོད་ཅིང་ས་བོན་མི་འདེབས་པསོ་ སྔར་གྱི་ས་བོན་ཙམ་ཡང་ཞེས་པ་ལ།",
    "སྔར་འཕངས་པ་མ་ལུས་པ་ཉེ་བར་ལོངས་སྤྱོད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་སྔར་སྦྱིན་པ་བཏང་བས་འབྲས་བུ་གང་འཕངས་པ་དེ་མ་ལུས་པར་ལོངས་སྤྱོད་པ་ཟིན་པར་འགྱུར་རོ།",
    "སློང་བར་འགྱུར་ཞེས་བྱ་བ་ནི་ལྷ་དང་མི་དག་རྙེད་པར་འགྱུར་ཞེས་པའོ།",
    "དེས་ན་ཞེས་བྱ་བ་འདོན་པར་འགྱུར་བ་མེད་པས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནི་གནོད་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གཏམ་ཟད་ནས་ཞེས་བྱ་བ་ནི་གསུངས་པ་གང་ཡིན་པའོ།",
    "རྒྱུ་དང་འབྲས་བུ་རྒྱུད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྦྱིན་པའི་འབྲས་བུ་ལོངས་སྤྱོད་པའི་ཚེ་ཡང་སྦྱིན་པ་གཏོང་བས་འབྲས་བུའི་ཚོགས་ཉེ་བར་འཕེལ་ཞིང་དུས་རིང་པོར་ལོངས་སྤྱོད་པ་པོ་ཉེ་བར་ལོངས་སྤྱོད་པར་འགྱུར་རོ་ཞེས་པའོ།",
    "གསུངས་སྐྱེས་དང་ཞེས་བྱ་བ་ནི་ཉན་ཐོས་རྣམས་ཏེ།",
    "གཡོག་འཁོར་ངན་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་གཏུམ་པོ་ལ་སོགས་པ་དེའི་འཁོར་དུ་འགྱུར་བའོ།",
    "མི་མ་ཡིན་པའི་སྒྲ་ཐོས་པར་འགྱུར་བས་སོ།",
    "མ་ངེས་པའི་སྤོབས་པར་འགྱུར་བའོ་ཞེས་བྱ་བ་ནི་དེའི་ཚིག་མི་བཙན་པར་འགྱུར་བའོ།",
    "ངེས་པར་ལེགས་པའི་རྒྱུ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལས་ཀྱི་ལམ་ཡང་དག་པར་བླངས་པའི་འོག་ཏུའོ།",
    "ཤེས་རབ་ཀྱི་རྣམ་པས་ཞེས་བྱ་བ་ནི་རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་རང་བཞིན་ཅན་སྟོང་པ་ཉིད་ཀྱི་རྣམ་པ་ཅན་གྱིས་སོ།",
    "དེ་ཉིད་ཤེས་པ་ལ་གལ་ཏེ་འདིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལས་གཞན་རྣམས་ཀྱི་ངེས་པར་ལེགས་པའི་ཡང་ངོ།",
    "ད་ནི་སེམས་བསྐྱེད་པ་གསུམ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སེམས་དང་སེམས་ལས་བྱུང་བ་དང་ལྡན་པ་ཡང་མ་ཡིན་པ་དང་འདུས་མ་བྱས་སོ།",
    "ཞི་བའི་བདག་ཉིད་ཅན་གྱི་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཞི་བའི་བདག་ཉིད་ཅན་གྱིའོ།",
    "ཅེས་གསུངས་པས་སོ།",
    "མ་འོངས་པ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "དོན་དམ་པའི་བཟོད་པའི་རྒྱུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཕར་གནོད་པ་བྱས་པས་དེ་ཁོ་ན་ལོག་ན་ཁོན་གྱིས་དེ་ལ་ཅི་ཞིག་བྱ་ཞེས་བྱ་བ་ལ།",
    "ཕར་གནོད་པ་བྱས་པས་ཞེས་བྱ་བ་ནི་དགྲ་བོ་ལ་སླར་གནོད་པ་བྱས་པས་སོ།",
    "དེའི་ཁོན་ལྡོག་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་སླར་གནོད་པ་བྱས་པས་ཁོན་ལྡོག་པར་འགྱུར་ནའོ།",
    "ཁོན་གྱིས་དེ་ལ་ཅི་ཞིག་བྱས་ཞེས་བྱ་བ་ནི་གང་སྔར་དགྲ་བོས་གནོད་པ་བྱས་པ་དེ་ལ་ཁོན་གྱིས་ཅི་ཞིག་བྱས།",
    "ཅུང་ཟད་ཀྱང་མ་བྱས་ཏེ།",
    "བྱས་ཟིན་པ་དེ་ལྡོག་པར་མི་འགྱུར་རོ།",
    "རྣམ་པར་སྨིན་པ་ཡིད་དུ་མི་འོང་བ་ཉིད་ཡིན་པར་བསྟན་པའི་སྒོ་ནས་ཁོན་སྤངས་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་ཡིད་དུ་མི་འོང་བ་འཕེལ་བ་བསྟན་པའི་སྒོ་ནས་ལྡོག་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལན་དུ་གནོད་པ་བྱས་པས་ཞི་བ་ཞེས་བྱ་བ་ལ།",
    "ཞི་བ་ནི་སླར་གནོད་པ་བྱས་པས་ཁྲོ་བ་ཞི་བར་འགྱུར་བའོ།",
    "དེའི་གནོད་པས་ཕམ་པར་འདོད་པ་ཞེས་བྱ་བ་ནི་གནོད་པ་བྱས་པའི་སྒོ་ནས་རྒྱལ་བར་འདོད་པ་གང་ཡིན་པའོ།",
    "པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་ཉམས་སུ་མྱོང་བར་ཟད་པའོ།",
    "དེ་ཉིད་གོ་ཞེས་བྱ་བ་ནི་སྔར་བྱས་པའི་ལས་ཀྱི་འབྲས་བུ་གང་ཡིན་པའོ།",
    "གཞན་ལ་གནོད་པ་དང་ནི་ཁྲོ་བས་ཞེས་བྱ་བ་ནི་གནོད་པར་བྱེད་པ་གཞན་དག་ལ་གནོད་པར་བྱེད་ཅིང་ཁོན་བྱེད་པས་སོ།",
    "སོགས་པའི་སྒྲས་ནི་མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་བསྡུ་བར་བྱའོ།",
    "སྔར་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ཉམས་སུ་མྱོང་བ་དང་།",
    "དེ་ཡང་གཞན་གྱིས་སེམས་ངེས་པར་དཀའ་བ་ཡིན་པས་སོ།",
    "ངེས་པ་ཡིན་དུ་ཟིན་ཀྱང་ཞེས་བྱ་བ་ནི་ཡོན་ཏན་དང་ལྡན་པས་ཁྱད་པར་ངེས་པ་ཡིན་དུ་ཟིན་ཀྱང་ངོ།",
    "བདེན་པར་གྱུར་པའི་སྐྱོན་ལ་ལྷག་པར་སྒྲོ་འདོགས་པའོ།",
    "བདེན་པར་གྱུར་པ་དང་།",
    "བདེན་པ་མ་ཡིན་པའི་ཉེས་པ་ལྷག་པར་སྒྲོ་འདོགས་པ་ནི་ཉེས་པ་ཆུང་ངུ་ལ་ཆེན་པོ་ཉིད་དུ་སྒྲོ་བཏགས་ནས་སོ།",
    "དེ་ལ་ནུས་པ་དང་མི་ལྡན་པ་རྣམས་ཀྱི་མི་བཟོད་པ་ནི་བདག་ཉིད་ལ་གནོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེས་གཞན་རྣམས་ལ་གནོད་པར་བྱེད་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ནུས་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་བདག་དང་གཞན་གཉིས་ཀ་ལ་གནོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེས་གཞན་དག་ལ་གནོད་པ་བྱེད་པར་མི་ནུས་པའི་ཕྱིར་རོ་ འདི་ནི་ནུས་པ་དང་མི་ལྡན་པ་དང་།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དམ་པ་མ་ཡིན་པར་བཀྲི་ཞེས་བྱ་བ་ནི་ཁྲོ་བ་རྣམས་དབྱུག་པ་དང་།",
    "མཚོན་ཆ་ལ་སོགས་པ་འཛིན་པ་ལ་འཇུག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཛེས་ཤིང་ཞེས་བྱ་བ་ནི་དེའི་གཟུགས་མཐོང་ན་གཞན་ལ་དགའ་བ་ཁྱད་པར་ཅན་སྐྱེ་བས་སོ།",
    "ད་ནི་མཇུག་བསྡུ་བའི་སྒོ་ནས་མི་བཟོད་པ་སྤང་བར་བྱ་བ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར་དེའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་གོ་སླའོ།",
    "འདོད་པའི་འདོད་ཆགས་ཞེས་བྱ་བ་ནི་འདོད་པར་བྱ་བས་ནི་འདོད་ཆགས་ཏེ།",
    "ཉེ་བར་མཚོན་པའི་དོན་ཏེ་ཞེས་བྱ་བ་ནི་འདིས་གཞན་ཡང་མཚོན་པར་བྱ་བ་ཡིན་ཏེ།",
    "དཔེར་ན་གང་ན་བྱ་རོག་འདི་གནས་པ་དེ་ནི་ལྷ་སྦྱིན་གྱི་ཁང་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུ་སྟེ།",
    "དེ་བཞིན་དུ་འདིར་བསམ་གཏན་གྱི་སྒྲས་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "ཡིད་ཀྱི་ཉེས་པར་སྤྱོད་པས་དབྱིག་པ་འཛིན་པ་དང་།",
    "རྟོག་པ་མེད་པའི་གནས་སྐབས་ན་སོ་སོར་རྟོག་པར་བྱེད་པའི་ཡིད་ཀྱི་གང་ཡིན་པ་དེ་ནི་དཔྱོད་པ་ཡིན་ལ་དེ་ཡང་སེམས་ཀྱི་ཕྲ་བ་ཡིན་ནོ།",
    "དེ་ལྟ་བུའི་འདོད་པའི་གཉེན་པོར་གྱུར་པ་རྟོག་པ་དང་དཔྱོད་པ་དག་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རྟོག་པ་དང་དཔྱོད་པ་དང་བཅས་པ་དང་།",
    "གནས་སོ་ཞེས་བྱ་ནི་བསམ་གཏན་ལ་སྙོམས་པར་ཞུགས་ནས་གནས་པའོ།",
    "དེ་གཉིས་ལ་སེམས་བརླན་ཏེ་རྣམ་པར་རྟོག་པ་མེད་པ་དང་།",
    "དཔྱོད་པ་མེད་པའི་རྒྱུར་གྱུར་པ་ལ་སེམས་གཏད་དེ་སེམས་དམིགས་པ་གང་ལ་སེམས་འཕྲོ་བར་གྱུར་པ་དེ་ལས་ཐ་དད་དུ་བྱས་ཏེ།",
    "སེམས་ཀྱི་རྒྱུད་གཅིག་ཏུ་གྱུར་པ་ཞེས་བྱ་བ་ནི་དེས་སེམས་ཞི་བར་བྱས་ཏེ།",
    "བཏང་སྙོམས་ལ་གནས་ཤིང་ཞེས་བྱ་བ་ནི་སེམས་འཁྲུག་པར་བྱེད་པའི་རྟོག་པ་དང་དཔྱོད་པ་དག་དང་།",
    "དེའི་ཕྱིར་བདེ་བ་ལུས་ཀྱིས་མྱོང་ལ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པ་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ནི་ཞེས་བྱ་བ་ནི་གཟུགས་མེད་པའི་སེམས་དང་མཚུངས་པ་ཉིད་དུ་བྱེད་པའི་ཕྱིར་རོ།",
    "པས་དེ་རྣམས་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ་སྟེ།",
    "ནམ་མཁའ་མཐའ་ཡས་པ་ཞེས་བྱ་བ་ནི་ནམ་མཁའ་མཐའ་ཡས་པ་ཉིད་རྣམ་པར་ཤེས་པའི་དམིགས་པ་ཉིད་དུ་བྱེད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལས་ཡང་དག་པར་འདས་ཏེ་ཞེས་བྱ་བ་ནི་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་འདོད་པ་དེས།",
    "རྣམ་པརཤེས་པ་མཐའ་ཡས་ཞེས་གསུངས་སོ།",
    "དེ་རྣམ་པ་ཐམས་ཅད་དུ་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ལས་ཡང་དག་པར་འདས་ཏེ་ཞེས་བྱ་བ་ནི་དེ་སྔར་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ལ་སྙོམས་པར་ཞུགས་པའི་དུས་ན་ཅུང་ཟད་ཡོད་པའི་འདུ་ཤེས་ལས་བཟློག་པ་ཡིན་ལ།",
    "ད་ནི་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདུ་ཤེས་ལ་རག་ལས་པ་ཉིད་དུ་མཐོང་ནས་ཅི་ཡང་མེད་པའི་འདུ་ཤེས་ལས་ལོག་པ་ཡིན་པས་འདུ་ཤེས་མེད་ཅེས་གསུངས་པ་ཡིན་ནོ།",
    "པའི་སྙོམས་པར་འཇུག་པ་བཞིན་དུ་རྣམ་པ་ཐམས་ཅད་དུ་འདུ་ཤེས་ཐམས་ཅད་འགགས་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "འདུ་ཤེས་མེད་མིན་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདིའི་རྣམ་པར་གཞག་པ་ནི་བསམ་གཏན་དང་།",
    "རྣམ་པར་བྱང་བ་དང་།",
    "རྣམ་པར་གཞག་པ་དང་།",
    "རྣམ་པར་དག་པའི་སྒོ་ནས་རིག་པར་བྱའོ།",
    "འདི་ལ་ལྟ་བ་ལྷག་པར་ཡོད་པས་ན་ལྟ་བ་ལྷག་པ་ཞེས་ཀྱང་བྱ་ལ།",
    "ཁྱད་པར་དུ་རྟོགས་པ་དེས་སེམས་པ་ས་མཐོ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྣམ་པར་བྱང་བ་ཇི་ལྟར་ཞེ་ན།",
    "རྣམ་པར་གཞག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "སྙོམས་པར་འཇུག་པའི་རྣམ་པར་གཞག་པ་དང་།",
    "ཚོད་ཟིན་པའི་རྣམ་པར་གཞག་པ་དང་།",
    "དེ་ལྟར་བསམ་གཏན་ལ་བཞིའི་སྒོ་ནས་རྣམ་པར་གཞག་པའོ།",
    "གཟུགས་མེད་པ་ལ་རྣམ་པ་གསུམ་གྱི་སྒོ་ནས་རྣམ་པར་གཞག་པ་བྱེད་པ་ཡིན་ཏེ།",
    "ཅིའི་ཕྱིར་རྟོག་པ་ལ་སོགས་པ་ཡན་ལག་ཉིད་དུ་རྣམ་པར་འཇོག་པ་ཡིན་ཞེ་ན།",
    "རྣམ་པར་འཚེ་བའི་རྟོག་པ་རབ་ཏུ་སྤོང་བའི་ཕྱིར་རོ།",
    "ད་ནི་རྟོག་པ་དང་དཔྱོད་པ་དང་བྲལ་བའི་ཕྱིར་དམིགས་པ་ལ་སེམས་ཆེས་མཉམ་པར་འཇོག་པ་གང་ཡིན་པ་སྟེ།",
    "བདེ་བ་དང་སེམས་རྩེ་གཅིག་པ་ནི་སྔར་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "སྙོམས་པར་འཇུག་པའི་རྣམ་པར་གཞག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ཡིད་ལ་བྱེད་པ་རྣམ་པ་བདུན་གྱི་སྒོ་ནས་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་པ་ཡིན་ལ།",
    "རབ་ཏུ་རྣམ་པར་དབེན་པ་དང་།",
    "དགའ་བ་ཡང་དག་པར་སྡུད་པ་དང་།",
    "བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་ཞུགས་པ་ལ་ཡིད་ལ་བྱེད་པ་རྣམ་པ་བདུན་ཅི་ལྟར་ལྡན་པར་འགྱུར་ཞེ་ན།",
    "དེ་ཡང་ཐོས་པ་དང་བསམ་པ་དག་དང་འདྲེས་པར་བྱའོ།",
    "དེ་གོམས་པ་ལས་དང་པོར་སྤོང་བའི་ལམ་དང་ལྷན་ཅིག་ཏུ་གྱུར་པ་ཡིད་ལ་བྱེད་པ་ནི་རབ་ཏུ་རྣམ་པར་དབེན་པ་ཡིད་ལ་བྱེད་པ་སྟེ།",
    "དབེན་པ་ཅུང་ཟད་ཀྱིས་དགའ་བ་དང་བདེ་བ་འདྲེས་པར་འགྱུར་བ་དེ་དུས་རྒྱུན་དུ་ཡིད་ལ་བྱེད་པ་དྲན་པའི་སྒོ་ནས་བྱིང་བ་དང་།",
    "རྒོད་པ་སྤོང་བའི་དོན་དུ་སེམས་དགའ་བར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་དགའ་བ་སྡུད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཀུན་ནས་དཀྲིས་པ་ཀུན་ཏུ་མི་སྤྱོད་པར་གྱུར་ནས་སྤངས་པ་དང་།",
    "མ་སྤངས་པ་རྟོགས་པར་བྱ་བའི་དོན་དུ་དེ་སྐྱེ་བ་དང་རྗེས་སུ་མཐུན་པ་སྡུག་པའི་མཚན་མ་ཡིད་ལ་བྱེད་པས་སོ་སོར་རྟོག་པ་གང་ཡིན་པ་དེ་ནི་སྤྱོད་པའི་ཡིད་ལ་བྱེད་པའོ།",
    "དེའི་དེ་མ་ཐག་ཏུ་བསམ་གཏན་དང་པོའི་དངོས་གཞིའི་སྙོམས་པར་འཇུག་པ་ཐོབ་པ་ནི་སྦྱོར་བ་མཐར་ཐུག་པའི་འབྲས་བུ་ཡིད་ལ་བྱེད་པའོ།",
    "ཐོབ་པར་བྱ་བ་དག་ཡང་དག་པར་ཤེས་ནས་ཐོབ་པའི་དོན་དུ་སེམས་སྨོན་པར་བྱེད་པའོ།",
    "ཇི་ལྟར་བསམ་གཏན་དང་པོའི་སྙོམས་པར་འཇུག་པ་ལ་ཡིད་ལ་བྱེད་པ་བདུན་ཡོད་པ་དེ་བཞིན་དུ་ཡོད་མིན་མེད་མིན་གྱི་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པའི་བར་དུ་ཇི་ལྟར་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "དེ་ལ་ས་གོང་མ་རྣམས་སུ་དེ་ལས་བཟློག་པ་ཞི་བ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "ཚོད་ཟིན་པའི་རྣམ་པར་གཞག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "བསམ་གཏན་དང་པོ་ཇི་ལྟ་བ་བཞིན་དུ་བསམ་གཏན་དང་སྙོམས་པར་འཇུག་པ་ལྷག་མ་རྣམས་ལ་ཡང་ངོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་བསམ་གཏན་གསུམ་པ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེར་གནས་གཙང་མས་ལྔ་ཡིན་པས་སོ།",
    "གྱ་ནོམ་པ་ཉིད་ཡོད་པར་ཡོངས་སུ་ཤེས་པ་ཡིན་ནོ།",
    "དམའ་བ་ཉིད་ནི་ཚེ་ལ་སོགས་པའི་ཁྱད་པར་གྱིས་སོ།",
    "ཇི་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལས་ཏིང་ངེ་འཛིན་བརྒྱ་ཕྲག་གཅིག་གསུངས་པ་ལྟ་བུའོ།",
    "གཟུགས་མེད་པ་རྣམས་ཀྱིས་བསྡུས་པ་ཡང་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་དག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "རབ་ཀྱི་མཐར་ཐུག་པའི་བསམ་གཏན་དང་པོ་ནས་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་བར་ལ་རྣམ་པར་དག་པ་ཞེས་བྱ་སྟེ།",
    "ཡོན་ཏན་ཁྱད་པར་ཅན་བསྒྲུབ་པའི་དོན་དུ་ལས་སུ་རུང་བ་ཉིད་མཐར་ཐུག་པར་བྱེད་པས་སོ།",
    "ཚོགས་རྫོགས་པར་བྱ་བའི་ཆེད་དུ་དུས་དང་དུས་མ་ཡིན་པ་ལ་དམིགས་པའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པ་དང་།",
    "པའི་འཚེ་བ་མེད་པར་སྟོན་པ་ནི་ཁོན་མེད་པ་ཞེས་བྱའོ།",
    "གནོད་པ་མེད་པ་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་ཡུལ་གྱིས་བྱས་པའི་འཚེ་བ་མེད་པས་སོ།",
    "དེ་ཉིད་རྒྱས་པར་སྟོན་པ་ནི་ཐམས་ཅད་དང་ལྡན་པའི་འཇིག་རྟེན་ཁྱབ་པར་བྱས་ནས་བསྒྲུབས་ཏེ་གནས་སོ་ཞེས་སྨྲས་སོ།",
    "ས་ཡང་གཡོ་བར་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྒྱས་པར་བསྟན་པ་སྟེ།",
    "ལག་པས་འཛིན་ཅིང་ཞེས་བྱ་བ་ནི་རིག་པར་བྱེད་དོ་ཞེས་པའོ།",
    "ཀུན་ཏུ་ཉུག་པར་བྱེད་དོ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་འཇུག་པར་བྱེད་པའོ།",
    "ཚངས་པའི་འཇིག་རྟེན་གྱི་གཞལ་ཡས་ཁང་ལ་ཡང་ལག་པས་འཛིན་ཅིང་ཀུན་ཏུ་ཉུག་པར་བྱེད་ཅེས་པའི་དོན་ཏོ།",
    "རྣམ་པར་དག་པ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་གསལ་བར་ཐོས་པས་སོ།",
    "སོགས་པ་པ་དང་ལྡན་པ་ལ་འདོད་ཆགས་ལ་སོགས་པ་དང་ལྡན་པར་ཤེས་པའོ།",
    "མཉམ་པར་གཞག་པ་དང་ཞེས་བྱ་བ་ནི་བསམ་གཏན་དང་པོ་ལ་སོགས་པའི་ས་པའོ།",
    "མཉམ་པར་མ་བཞག་པ་ཞེས་བྱ་བ་ནི་འདོད་པའི་ཁམས་པའོ།",
    "དེ་ནི་སྔོན་གྱི་གནས་རྣམ་པ་དུ་མ་རྗེས་སུ་དྲན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྷའི་མིག་རྣམ་པར་དག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རྣམ་པར་དག་པ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་གསལ་བར་མཐོང་བའི་ཕྱིར་རོ།",
    "སྙོམས་པར་འཇུག་པ་དང་ཞེས་བྱ་བ་ནི་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལ་སོགས་པའོ།",
    "འདོད་ཆགས་ཞེ་སྡང་ཡོངས་སུ་ཟད་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་མ་སྨོས་པ་གཏི་མུག་ཡོངས་སུ་ཟད་པར་བསྡུ་བར་བྱ་བའི་ཆེད་དུའོ།",
    "དེའི་ལྟ་བར་འགྱུར་བའི་འཆིང་བ་རྣམས་ནི་སྔ་ནས་སྤངས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ལོག་པར་ལྟ་བ་དང་།",
    "འཕེལ་བར་བྱ་བ་མ་ཡིན་པར་ཞེས་བྱ་བ་ནི་ཡང་འཕེལ་བ་མེད་པས་སོ།",
    "དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྟེན་གྱི་ཁྱད་པར་དང་ཞེས་བྱ་བ་ནི་ཕལ་ཆེར་ཁྱིམ་པ་རྣམས་སོ།",
    "དེ་ཉིད་ཚིགས་སུ་བཅད་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྦྱིན་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྟེན་གྱི་ཁྱད་པར་བསྟན་པ་ཡིན་ནོ།",
    "བསྔགས་ཞེས་བྱ་བ་ནི་གསུངས་པའོ།",
    "ཞེས་བྱ་བ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་གསུངས་པ་ཡིན་ནོ།",
    "གཟུགས་སྣ་ཚོགས་དང་ལྡན་པའི་རྒྱུ་ཡིན་ནོ་ཞེས་བྱ་བ་འདིས་ནི་སྤྲུལ་པའི་སྐུ་གསུངས་པ་ཡིན་ནོ།",
    "ཉན་ཐོས་པ་ལ་སོགས་པས་བསམ་པར་མི་ནུས་པས་བསམ་གྱིས་མི་ཁྱབ་པའོ།",
    "འགྲོ་བའི་མུན་པ་རྣམ་པར་འཇོམས་པར་འདོད།",
    "ད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྷག་པར་བསྟན་པའི་སྒོ་ནས་ཞེས་པ་ནི་ས་བཞི་པར་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རབ་ཏུ་སྟོན་པར་འགྱུར་བས་སོ།",
    "འབར་བར་གྱུར་པའི་ཞེས་བྱ་བ་ནི་ལྷག་པར་གྱུར་པ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འོད་འཕྲོ་བའི་ངེས་ཚིག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
