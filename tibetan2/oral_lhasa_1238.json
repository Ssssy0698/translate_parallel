    "སྐྱེས་བུའི་དོན་ནི་རྗོད་པར་བྱེད།",
    "ངག་དེ་དཔྱད་པར་འོས་པ་ཡིན།",
    "ཞེས་གསུངས་ཏེ།",
    "ཅི་ལྟར་ཉེས་པ་ཟད་པའི་ཚིག་ཡོངས་སུ་གཅོད་པར་ནུས་པ་མངོན་སུམ་དང་།",
    "རྗེས་སུ་དཔག་པས་རྟོགས་པར་བྱ་བའི་དོན་ལ་མི་སླུ་བ་དེ་བཞིན་དུ་ཤིན་ཏུ་ལྐོག་ཏུ་གྱུར་པའི་དོན་ལ་ཡང་ཉེས་པ་ཟད་པའི་ཚིག་མི་སླུ་བ་ཡིན་ནོ།",
    "དཔེར་ན་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པས་རྟོགས་པར་བྱ་བའི་དོན་རྟོགས་པ་བཞིན་ནོ།",
    "ཀུན་རྫོབ་ཏུ་སྐད་ཅིག་མ་དང་བདག་མེད་པ་དང་ལྡན་པར་གནས་གསུམ་བསྟན་པ་ཡིན་པས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གཙོ་བོའི་དོན་ལ་མི་སླུ་བས་རྗེས་སུ་དཔག་པ་གཞན་ལའང་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "ད་ནི་སྟོང་པ་ཉིད་སྟོན་པའི་སྣོད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བས་ནི་གང་སྔར་གོམས་པས་རྒྱུད་ལ་སྟོང་པ་ཉིད་ཀྱི་ས་བོན་མ་བཞག་པ་དེ་རྣམས་ལ་བསྟན་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གཞན་དག་ལ་སྟོང་པ་ཉིད་སྟོན་པར་བྱེད་པའི་བསྟན་བཅོས་ཅིའི་ཕྱིར་མི་སྟོན་ཅེ་ན།",
    "དེའི་ཕྱིར་དེ་དག་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལོག་པར་ཞུགས་པའི་བསམ་པ་དང་ལྡན་པ་ཞེས་བྱ་བ་ནི་དམིགས་པར་གྱུར་པའི་དངོས་པོ་རྣམས་སྟོང་པ་ཉིད་ཅི་ལྟར་ཡིན་སྙམ་དུ་དངོས་པོ་ལ་དམིགས་པའི་སྒོ་ནས་སྟོང་པ་ཉིད་ལ་གཤེ་བའི་བསམ་པས་སོ།",
    "ཡང་ན་དངོས་པོ་ཆད་པའི་རང་བཞིན་ཅན་སྟོང་པ་ཉིད་ཡིན་པར་རྟོགས་ནས་གདོད་ནས་སྐྱེ་བ་མེད་པའི་སྟོང་པ་ཉིད་ལ་གཤེ་བའི་བསམ་པ་ཡོད་པས་སོ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལེགས་པར་མ་བསྒྲུབས་རིག་སྔགས་བཞིན།",
    "བློ་གྲོས་དམན་པ་རླག་པར་བྱེད།",
    "རྟོགས་པར་དཀའ་བ་མཁྱེན་ནས་སུ།"
  ]
