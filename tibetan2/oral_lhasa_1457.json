    "ཇི་ལྟར་ཚིག་འཁྱལ་པར་ིསྨྲས་པར་འགྱུར་ཞེ་ན།",
    "གལ་ཏེ་གཞན་གྱི་བདོག་བདག་ལ་འདོད་པ་སྐྱེད་པར་བྱེད་ན་དེ་ལྟར་ན་བརྣབ་སེམས་སུ་འགྱུར་བ་ཡིན་ནོ།",
    "ཇི་ལྟར་ལོག་པར་ལྟ་བར་འགྱུར་ཞེ་ན།",
    "ཆང་རྣམས་ལས་ལྡོག་པར་མཛོད་ཅིག་ཅེས་བྱ་བ་ལ།",
    "མང་པོའི་ཚིག་ནི་ཆང་ནི་མྱོས་པར་འགྱུར་བ་ཉིད་དུ་ཁྱད་པར་མེད་ཀྱང་རྒྱུའི་ཁྱད་པར་ལས་རིག་པར་བྱ་སྟེ།",
    "སྦྱར་བའི་ཆང་ནི་མེ་ཏོག་ལས་མནན་པ་ལ་སོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྤྱད་པར་བྱ་བ་ཡིན་པས།",
    "ལོངས་སྤྱོད་དེ་འདི་ནི་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཟས་དང་སྐོམ་ལ་སོགས་པའི་ཚིག་བླ་དྭགས་སོ།",
    "འདིས་ནི་ལོངས་སྤྱོད་རྣམས་ལ་ཀུན་དུ་འཛིན་པ་ལྡོག་པར་བྱེད་དོ།",
    "མཁྱེན་ནས་ཞེས་བྱ་བ་ནི་རྟོགས་པར་བྱས་ནས་སོ།",
    "ཚུལ་བཞིན་ཞེས་བྱ་བ་འདིས་ནི་གུས་པར་བྱ་བ་བསྟན་ཏོ།",
    "དེ་ནི་གཅིག་ཏུ་རྣམ་པར་སྨིན་པ་ཡིད་དུ་འོང་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་དག་བསོད་སྙོམས་ཀྱི་གུས་པར་བྱས་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་འདོད་པ་སྡུག་པ།་",
    "༡༨༨འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "འདིས་ནི་འདིར་སྦྱིན་པ་ལ་བརྟེན་པར་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་མ་ཉམས་པ་ནི་ཇི་ལྟར་ཡང་དག་པར་བླངས་པ་ལས་གཅིག་ལས་ཀྱང་མ་འདས་པའི་ཕྱིར་རོ།",
    "དེ་གཉི་ག་མེད་པར་བསྟན་པའི་ཕྱིར།་།",
    "ཏིང་ངེ་འཛིན་སྒྲུབ་པར་བྱེད་པ་ཡང་ཡིན་ཏེ།",
    "བཟོད་པ་ནི་འདིར་གཞན་གྱིས་གནོད་པ་བྱས་པ་ལ་མི་མཇེད་པའི་བཟོད་པ་དང་།",
    "དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཛོད་ཅེས་བྱ་བ་ནི་ཕ་རོལ་དུ་སོན་པར་གྱིས་ཤིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རིགས་འདི་ལ་མི་དང་མི་མ་ཡིན་པས་བྱས་པའི་གནོད་པ་མེད་པར་བསྟན་ཏོ།",
    "ཁྱིམ་ན་གནས་པ་རྣམས་ལ་དུས་ཐམས་ཅད་དུ་ཚངས་པར་སྤྱད་པ་དཀའ་བའི་ཕྱིར་ན་ཉིན་ཞག་གཅིག་པའི་ཚངས་པར་སྤྱོད་པ་ལ་ཡང་སྦྱར་བའི་ཆེད་དུ་གསོ་སྦྱོང་ཡན་ལག་བརྒྱད་པ་བསྟན་པའི་ཕྱིར།",
    "ཆོམ་རྐུན་ནི་མ་བྱིན་པར་ལེན་པའོ།",
    "སྩོལ་བར་བགྱིད་ཅེས་བྱ་བ་ནི་སྦྱིན་པར་བྱེད་པའོ།",
    "དེ་རྣམས་དང་ལྷན་ཅིག་འགྲོགས་པར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཁྱིམ་པ་རྣམས་ལ་ཡང་བག་དང་བཅས་པར་བྱ་བ་ཡོད་པས་དེ་དག་དེ་ལ་དགོད་པར་བཞེད་ནས།",
    "བཟློག་པ་ནི་བག་མེད་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དང་པོ་ཉིད་ནས་ཅི་སྟེ་མ་སྨྲས་ཁོ་བོ་སྔར་བག་མེད་པར་གྱུར་ཟིན་པས།",
    "གང་ཞིག་སྔོན་ཆད་བག་མེད་པར་གྱུར་པ་དེ་ཡང་གལ་ཏེ་ཕྱིས་བག་ཡོད་པ་ལ་བརྟེན་ན་དེ་ནི་མཛེས་པ་ཉིད་དེ།",
    "འདིས་བདག་ཕམ་པར་བྱས་སོ།",
    "སྦྲང་རྩི་མེ་ཏོག་མི་གཙང་ལྟ་བུའི་ཚིག།",
    "ལོག་པར་སྨྲ་ལྡན་སྐྱེས་བུ་རྣམས་ཀྱིས་ནི།",
    "བསྔགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།་།",
    "ཚིག་ལོག་པ་ནི་མི་གཙང་བ་ལྟ་བུ་སྟེ།",
    "དེ་བས་ན་དེ་དག་ལ་ཇི་ལྟར་རིགས་པར་བསྒྲུབ་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ཁྱིམ་པ་རྣམས་ལ་ནི་འདོད་པས་ལོག་པར་གཡེམ་པ་སྤང་དཀའ་བའི་ཕྱིརི།",
    "འོན་ཀྱང་ན་ཚོད་དང་མཐུན་པར་རོ།",
    "གལ་ཏེ་མི་གཙང་བ་ཉིད་དུ་བསམས་སུ་ཟིན་ཡང་གཙང་བའི་སེམས་བྱུང་ན།",
    "འདིར་ཡང་བསྲུངས་ན་བདེ་བ་ཐོབ་པར་འགྱུར་ཏེ།",
    "ཅེས་གསུངས་པ་ལྟ་བུའོ།་།",
    "དུག་ནི་གསོད་པར་བྱེད་པའི་བདག་ཉིད་ཀྱིས་སོ།",
    "འོན་ཀྱང་མཇུག་ཏུ་ཕུང་བསྐྱེད་པར་བྱེད་པ་ཁོ་ན་ཡིན་པས་མཁས་པ་རྣམས་ཀྱིས་ཁ་ཟས་དུག་ཅན་བཞིན་ིསྤང་བར་བྱ་བ་ཁོ་ན་ཡིན་ནོ།",
    "མི་གཙང་བའི་རྟེན་དང་ངོམས་མི་ཤེས་པ་དང་།",
    "གཞན་ཡང་ངོམས་པར་བྱ་བའི་ཕྱིར་ལུས་ཀྱི་ལ་ཉེ་བར་སྤྱོད་པར་འདོད་ན།་",
    "ཇི་ལྟར་མཛེ་ཅན་སྲིན་བུས་བཙུགས་པ་བསལ་བའི་ཕྱིར་མི་བསྟེན་ཀྱང་ཞི་བར་མི་འགྱུར་བ་དེ་བཞིན་དུ་བྱིས་པ་དག་འདོད་པའི་གདུང་བ་བསལ་བའི་ཕྱིར་ཡུལ་རྣམས་བསྟེན་ཀྱང་ངོམས་པར་མི་འགྱུར་གྱི་རྣམ་པར་ཉམས་པར་འགྱུར་བ་འབའ་ཤིག་ཏུ་ཟད་དེ།",
    "ཅེས་བྱ་བ་ནི་ཕྱིན་ཅི་མ་ིལོག་པའི་ཚུལ་དུ་ཡང་དང་ཡང་མངོན་དུ་བྱས་ནས་མནོས་ཤིག་ཅེས་བྱ་བའི་ཏོ།",
    "སྟོང་པ་དང་བདག་མེད་པའི་རྣམ་པ་ཅན་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "རིགས་དང་ལྡན་པ་རྒྱལ་རིགས་ཤིང་སཱ་ལ་ཆེན་པོ་ལྟ་བུ་ལ་སོགས་པར་སྐྱེས་པ་དང་ལྡན་པ་གང་དག་ཡིན་པ་དང་།",
    "གུས་པར་བྱ་བ་མ་ཡིན་ལ།",
    "ཡིད་བརྟན་པར་བྱ་བ་ཡང་མ་ཡིན་གྱིས།",
    "འདི་ཁོ་ན་ལ་འབད་པར་བྱའི།",
    "འཇིག་རྟེན་མཁྱེན་པ་རྙེད་དང་མ་རྙེད་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་འཕགས་པའི་ལམ་སྐྱེ་བ་དང་མཐུན་པ་ཁོ་ན་སྟོན་པར་བྱེད་དོ།",
    "དེ་ལ་མི་སྙན་པ་དང་སྨད་པ་ནི་ལྐོག་དང་ལྐོག་མ་ཡིན་པའི་བྱེ་བྲག་ལས་རིག་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱི་ཡིད་ཀྱི་ཡུལ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེའི་ཚེ་ཨིན་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་སྨིན་པར་འགྱུར་རོ།",
    "དེ་ཡང་སྡོམ་པ་རྣམ་པ་བརྒྱད་དུ་རིག་པར་བྱའོ་། འདི་ལྟ་སྟེ།",
    "དེ་དག་ནི་ནོར་བདུན་ལགས་པར་ཐུབ་པས་གསུངས་ཏེ།",
    "དེར་ནི་རྒྱུའི་དོན་ཡིན་པར་གསལ་བ་ཁོ་ནར་གོའོ།",
    "ཁྱད་པར་དུ་འཕགས་པ་ཡིན་པར་གསུངས་སོ།",
