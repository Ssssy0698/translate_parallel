    "སླར་ཡང་རང་ཉིད་ཞེ་སྡང་རྡོ་རྗེ་འཇིགས་ཤིང་རྔམ་པ་མི་བཟད་པའི་ཁྲོ་བོའི་སྤྲིན་སྤྲོ་བའི་སྐུར་གྱུར་པའི་མིག་གཉིས་མ་དང་ཊ་ལས་ཉི་མ་དང་ཟླ་བ།",
    "གཞན་རྣམས་ཀྱང་ཇི་ལྟར་འོས་པར་འདུག་ནས།",
    "ཚུལ་ཕྱག་སྔོན་དུ་འགྲོ་བས་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན།",
    "ཞེས་འདུག།",
    "སའི་དབུས་སུ་བརྗིད་བག་དང་བཅས་པས་འདུག་སྟེ།",
    "སླར་ཡང་རང་ཉིད་ཞེ་སྡང་རྡོ་རྗེ་འཇིགས་ཤིང་རྔམ་པ་མི་བཟད་པའི་ཁྲོ་བོའི་སྤྲིན་སྤྲོ་བའི་སྐར་གྱུར་པའི་མིག་གཉིས་མ་དང་ཊ་ལས་ཉི་མ་དང་ཟླ་བ།",
    "གཞན་རྣམས་ཀྱང་ཇི་ལྟར་འོས་པར་འདུག་ནས།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཁྱད་པར་དུ་ཡང་ལྷག་པ་གཟུགས་བརྙན་གྱི་དཀྱིལ་འཁོར་གྱི་རྟེན་ཡོ་བྱད་དང་བཅས་པ་འདི་དག་དུས་འདི་ནས་བཟུང་སྟེ་ཇི་སྲིད།",
    "དེནས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ་ཕུར་བུ་དཀྱིལ་དར་གྱི་ཅོད་པན་ཅན་བཅུ་མདུན་དུ་བཀོད།",
    "ཞེས་སུམྦྷ་དང་རང་སྔགས་ཀྱིས་བཀུག་པ་གཟུགས་ལ་གཞུག་སྶཾཔའི་སེམས་ཕབ་སྟེ།",
    "སླར་ཡང་རང་གནས་སུ་ལངས་ཏེ་འཁོད་པས་ཀ་གཟུགས་བརྙན་གྱི་དཀྱིལ་འཁོར་ལ་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་བྱིན་འབེབས་པ་དང་གནས་དང་དཀྱིལ་འཁོར་མངའ་གསོལ་བ་རྣམས་ཀྱང་བྱ་བར་གསུངས་སོ།",
    "ཅེས་བརྗོད་དེ་སློབ་བུས་ཕྱག་བྱས་མཎྜལ་ཕུལ་ཏེ་འདུག་པ་ལ།",
    "དྲི་ཞིམ་པོས་བྱུགསནས་བདེ་བའི་སྟན་ལ་མཉམ་དུ་འདུག་པ་ར་བ་དང་ཡོལ་བ་སོགས་ཀྱིས་བསྒྲིབས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "ཁྱད་པར་དུ་ཡང་ལྷག་པ་གཟུགས་བརྙན་གྱི་དཀྱིལ་འཁོར་གྱི་རྟེན་ཡོ་བྱད་དང་བཅས་པ་འདི་དག་དུས་འདི་ནས་བཟུང་སྟེ་ཇི་སྲིད།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "གཞན་རྣམས་ཀྱང་ཇི་ལྟར་འོས་པར་འདུག་ནས།",
    "ཞེས་གདབ་རིམ་ལས་ལྡོག་ཕྱོགས་སུ་ཕྱུངས་ལ་ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་འུའུའུའུཟཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷནི་སྭཱ་ཧཱ།",
    "ཡེ་ཤེས་དང་རང་བཞིན་གཞན་དུ་འགྱུར་བ་མེད་ཅིང་།",
    "དེ་གཉིས་བདེ་བའི་སྟན་ལ་འདུགནས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུརན།",
    "གཞི་དང་རང་བཞིན་འབྲས་བུ་དང་།",
    "རུས་ཚིགས་དུམ་བུ་སུམ་བརྒྱ་དྲུང་ཙ་ནཱི་དང་།",
    "མ་གཏོགས་ཁྱེད་རང་བོན་ལ་ལྟོ་ཟས་ཀྱི།",
    "ཁྱེད་རང་ས་དགེ་རྙིང་འབྲུག་བྱང་ཆབ་ས་ཡ།",
    "དེ་ལ་རྟེན་གྱི་གཙོ་བོ་འདི་ལྟར་འདུག།",
    "གཏེར་དུ་ཡོད་ཅེས་བཅོས་མའི་ལུང་དུ་འདུག།",
    "གྲོང་མང་འདུག་པས་དེར་ཕྱིན་བསོད་སྙོམས་སློང་།",
    "ཀུན་ཀྱང་འཇིགས་སྐྲག་ཆེས་ཆེར་བྱེད་པར་འདུག།",
    "བཞེས་ནས་ཁྱེད་རང་དཀའ་ཐུབ་ཐོགས་མེད་འདུག།",
    "བསེ་རག་ཡི་དྭགས་ཁ་རུ་མངོན་འབེབས་འདུག།",
    "མི་ཚད་ཙམ་ཡང་མང་དུ་མཇལ་དུ་འདུག།",
    "དེ་བཞིན་ཙོག་པུར་ལྔ་ལྡན་འདུག་སྟངས་མང་།",
    "དེ་ལྟར་སྨྲས་འདུག་མགོ་པ་ཐུགས་དཔྱད་མཛོད།",
    "ཁོ་རང་ངོ་ཚ་སྐྱེས་ནས་འདི་ལྟར་སྨྲས།",
    "དེ་ནི་ང་ཡི་གནས་མགྲོན་གཅིག་པ་འདུག།",
    "ཤིན་ཏུ་འཕྲོད་ཅིང་རབ་ཏུ་ཕན་པར་འདུག།",
    "བཙོན་གཡོག་ལྐུགས་པར་འདུག་པས་མིང་གང་འབོད།",
    "བློ་གཏད་གཅིག་ལ་འདུག་པ་སུ་ལ་གཏོད།",
    "མི་གཅིག་བཙོན་དུ་འདུག་པ་དཀའ་ཐུབ་དང་།",
    "བཙོན་གཡོག་ལྐུགས་པར་འདུག་པ་དཀའ་ཐུབ་རང་།",
    "སྙན་བརྒྱུད་ངོ་བོར་ཤོར་བས་མ་ཟབ་འདུག།",
    "བསྐྱེད་རྫོགས་ངོ་བོར་ཤོར་བ་མ་གསལ་འདུག།",
    "ལྟ་དགོངས་ངོ་བོར་ཤར་བས་མ་མཐོ་འདུག།",
    "ལུས་ཀྱང་མི་ཤིགས་གཡུང་དྲུང་རང་ལུགས་གྱུར།",
    "ཡིད་ཀྱང་མི་འཁྲུལ་ཀུན་བཟང་རང་སར་གྲོལ།",
    "མ་བརྩལ་རང་འབྱུང་རང་ཤར་འདོད་དགུའི་དབྱིག།",
    "བསོད་སྙོམས་སློང་ནས་བསྔོ་བ་བྱེད་པར་འདུག།",
    "དགེ་སློང་ཚུལ་ལྡན་ལོ་ཆུང་ཞིག་འདུག་པ།",
    "བོན་ཆུང་ཞེས་བྱ་བོན་པོ་ཡོད་འདུག་ཚེ།",
    "དེ་ཡི་སྐྱེས་མཐའ་ད་ལྟ་ཁྱེད་རང་མངོན།",
    "སྔར་མིའི་གཏམ་གྱི་ཁ་དཔེ་ལ་འདུག་ཅེས།",
    "ཡང་ཡང་བལྟས་པས་དེ་རུ་ཁྲིག་གེར་འདུག།",
    "དེ་ལ་མཁར་སིལ་བཙུག་པས་རྡོ་རིལ་འདུག།",
    "ཡང་ཡང་བལྟས་པས་རྡོ་རིལ་དངོས་སུ་འདུག།",
    "བུག་པ་མཐོ་ཚད་འཛམ་ནག་སྐུ་སོགས་འདུག།",
    "འགྲོ་རྩིས་ཡིན་པས་ས་ཐག་གང་འདྲ་འདུག།",
    "ཅེས་སོགས་དྲིས་པའི་ཟླ་ལམ་གཅིག་འདུག་ཅེས།",
    "ཡང་སྟོན་ཀླུ་བྲག་ཅེས་པར་བོན་བསྟན་འདུག།",
    "ལ་སོགས་བཀའ་རྟགས་མཇལ་ཆོག་མང་དུ་འདུག།",
    "དེ་ཡང་རང་ལ་འབྱོར་བ་ཆེ་བར་ཡོད་ན་ཆེ་བར་བསྐ་ཚ་ཁྱབཏང་དགོས་ཏེ།",
    "དེ་ནི་ཉན་ཐོས་རྣམས་དང་རང་རྒྱལ་གྱིབྱ་གཞན་འདབ་མ་ཡོངས་སུ་རྫོགས་ལའང་མེད།",
    "བྱི་དོར་བྱས་པ་ནི་རོ་ཙ་ན་ལ་སོཌ་པའི་ནོར་བུས་ཕྱིས་པ་དང་།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱེད་རང་ཉིད་ཀྱི་ཉེས་པ་འཆགས་པར་མ་ཟད།",
    "ས་བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།་",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "དཔར་ཆཅི་ཕྱིར་བདག་ཡིད་བདེ་བར་འདུག།",
    "དང་པོ་བདག་ཉིད་དབུགས་དབྱུང་བ་ལ་ཡང་རང་དོན་གྲུབ་པས་དང་དུ་ཆག་མའི་ཁུ་བར་གཞན་དོན་གྲུབ་པས་དགའ་བ་སྐྱེད་པའོ།",
    "སྐྱེས་རབས་ལསརབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུགདུལ་བའི་དཔལ་ནི་རྣམ་པར་བསྐྱེད།",
    "དུག་གསུམ་གྱི་སེམས་སེམ་ཞིང་འདུག་ན་རི་དྭགས་དང་གཅན་གཟན་རྣམས་དང་ཁྱད་པར་མེད་དོ།",
    "ཤེས་བྱའང་རང་བཞིན་གྱིས་ཡོད་མིན།",
    "དབུས་ཡོད་ན་དེ་ལ་བལྟོས་པའི་མཐའ་ཡང་ཡོད་དེ་རྡུལ་ཕྲ་རབ་གཅིག་ལ་ཡང་གཡས་གཡོན་དབུས་གསུམ་དུ་ལེའུ་བཞི་པབག་ཡོད་པ་བསྟན་པ་འགྱུར་ཞིང་དེའི་དབུས་ཀྱི་ཆ་ཁོ་ན་ལའང་རང་སའི་གཡས་གཡོན་དབུས་གསུམ་དུ་འགྱུར་བ་སོགས་ཇི་སྲིད་དབུས་སུ་འཛིན་པ་ཡོད་པ་དེ་སྲིད་གཡས་གཡོན་སོགས་མཐའི་འཛིན་པ་ཡང་འཇུག་པའི་ཕྱིར།",
    "གཟེགས་ཟན་པ་དང་དཔྱོད་པ་པའོདེ་ཐམས་ཅད་ནི་བདག་དང་དུས་གསུམ་རྟག་ཅིང་རང་བཞིན་དང་ཡོན་ཏན་དང་ཐམས་ཅད་དུ་ཁྱབ་པར་འདོད་ལཁྱད་པར་གྲངས་ཅན་པ་ནི།",
    "དེས་བྱས་པའི་ཕྱུགས་མཆོད་སྦྱིན་དུ་བསད་པས་དེ་མ་མཉེས་པར་འགྱུར་ལཡང་ན་མཆོད་སྦྱིན་བྱས་ཀྱང་བྱེད་པ་པོ་ལ་ཕན་པར་མི་འགྱུར་ཏེ་མཆོད་སྦྱིན་བྱེད་པོ་ཡང་རཧྥ་ཎ་ཁོ་རང་དུ་ཟད་པའི་ཕྱིར་དང་།",
    "རྨི་ལམ་ནི་སོ་སོར་སྣང་བ་ཙམ་སྟེ་བཟུང་བར་བྱ་བ་མིན་ཞིང་རང་བཞིན་གྱིས་སྟོང་པ་ཡོད་པ་མ་ཡིན་པའི་ངོ་བོ་ཉིད་དོ།",
    "ཏིང་རྒྱལ་ལསངོ་བོ་ཉིད་སྟོང་རང་བཞིན་འོད་གསལ་བ།",
    "ང་རང་ན་དེ་ཉིད་རིག་པས་དོན་མེད་གསུངས།",
    "འདུག་ན་ཡང་བདག་འདུག་གོ།",
    "རྟ་ཟོཊ་སྐ་ཅེས་པའི་འབྲུར་སྣང་ཞིང་གོང་མའི་མཚན་ཉིད་ཀྱི་ནུས་པའི་ཟུར་ལ་བརྟགས་ནའང་ངོ་ཚ་ཤེས་པ་འཐོབ་པར་འདུག་ཅིང་ངོ་ཚ་ཤེས་པ་ནི་གུས་འཇིགས་གཉིས་ཀར་དུ་མི་འདུ་བས་རྒྱ་དཔེ་ལ་ངེས་པར་ཡོད་པ་ཞིག་ལོ་ཙྭ་བས་ཟུར་ཆད་པར་སྣང་ངོ།",
    "འདུག་རྒྱལ་པོ་རྟ་ཞིསྐད་ཅིག་གཅིག་ཀྱང་མི་འཆོར་བར།",
    "ཞེས་གསུངས་ཏེགླང་པོ་ཆེ་ནི་སྟོབས་ཆེ་ཞིང་རང་བཞིན་གྱིས་མི་སྲུན་པ་ཡིན་ལ།",
    "ལུགས་ཀྱི་བསྟན་བཅོས་ཙ་ན་ཀར་ཡང་།",
    "རྙེད་སོགས་ལ་འདུན་པའི་བློ་འདུག་པ་དང་།",
    "གཞན་དོན་འདོར་བ་དང་རང་དོན་ལ་དམིགས་པའི་བློ་དང་།",
    "རྒྱལ་སྲས་གསང་བའི་གནས་ཀུན་དེ་ཡི་མཛོད་ན་འདུག།",
    "དེ་ཡང་རང་བཞིན་གྱིས་རྟག་པ་དང་གནས་སྐབས་ཀྱི་སྐྱེ་བ་དང་འཇིག་པ་དག་དང་ཡང་མ་འབྲེལ་བར་འདོད་དོ།",
    "ཞེས་པའི་གཞུང་རྐང་པ་གཉིས་ལྷག་པོར་ཡོད་པའི་འབྲུ་འདུག་ལ།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་ནས།",
    "མེ་ཏོག་ཐོགས་ཏེ་སྒོ་ཕྱོགས་འདུག།",
    "སློབ་དཔོན་བདག་དཀྱིལ་འཁོར་གྱི་སྒོ་དྲུང་དུ་འདུག་པ་དང་།",
    "གཤེགས་སུ་གསོལ་ཞིང་རང་ལ་བསྲུང་བའོ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱིཨཱ་ཡུ་ཤྲཱི་ཧཱུྃ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་ཞེས་པའི་ཡི་གེ་དྲུག་འཁོར་ལོ་གཡས་དང་།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་༉ལོ་ཀ་ཤྲཱི་ཧཱུྃ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་སརྦ་ཨཱཎཱ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "དོན་ལ་མེད་པ་རང་དུ་འདུག་གོ་སྙམ་ན།",
    "དེའང་དཔྱད་བཟོད་ཤེས་པ་མ་གྲུབ་ཅེས་ཀུན་གཞི་དང་རང་རིག་མེད་པའི་སྒྲུབ་བྱེད་བསྟན།",
    "ཕྱི་དོན་སྣང་ཙམ་གྱི་སྒོས་དེའི་ཐ་སྙད་མ་བཤིག་པར་འཇོག་པ་དང་རང་བཞིན་མེད་པ་འགལ་དོན་མེད་དོ།",
    "མགྲིན་པར་བཀོད་པ་གཉིས་འདུག་པས་ཁྱུད་མེད་འདྲ།",
    "ལས་སྔགས་བརྗོད་ཅིང་རང་དག་རིག་མ་བསངས",
    "ཆུ་བུར་དེ་མི་འཇིག་པར་འདུག་པ་ཞིག་མི་སྲིད་པ་ལྟར་ངེས་པར་འཆི་བ་དང་།",
    "རྣམ་མང་འགྲོ་བའི་རང་རང་སྐད་དུ་ཐོས།",
    "ནམ་ཞིག་འདི་སྣང་འདུག་པར་ཉེ་བ་དང་།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "གསུམ་ག་དགོས་པར་འདུག་པསགཞུང་ལྟར་གྱི་ཡོ་བྱད་རྣམས་ཚོགས་པར་བྱས་ཏེ།",
    "སེང་གེའི་ཁྲི་སྟེང་རང་ཉིད་རྣལ་འབྱོར་མ།",
    "རང་རང་བློ་ཡི་བུ་ག་དང་འཚམས་པར།",
    "རིན་ཐང་ཅན་གྱི་གདན་ཆེན་པོ་ལ་ི་འདུག་པ་དང་།",
    "གདུལ་བྱ་སྤྱི་ལ་ངེས་པར་ཕན་ཐོགས་པ་ལ་བསྟན་པ་ཡོངས་རྫོགས་ཚང་དགོས་ཚུལ་ཤུམས་ཅད་བསྟན་འདུག་པས།",
    "འགྲོ་འདུག་སོགས་ཀྱི་སྤྱོད་ལམ་ཐམས་ཅད་སྒོམ་དང་བསྲེ་ཐུབ་པ་དང་།",
    "འདུས་པ་ཞེས་དང་སོགས་སྒྲ་སྦྱར་བར་འདུག་པས་ཞིབ་ཏུ་ཤེས་དགོས་སོ།",
    "སྟོང་ཕྲག་དོན་གཉིས་ཙ་ནས་རབ་གཡོས་པའི།",
    "ལེགས་སྦྱར་མཉམ་པར་བཞག་དུས་བསྐྱངས་པ་དང་།",
    "དེ་ལ་རྡོ་རྗེ་འཆང་ཞེས་རྗེ་ཉིད་ཀྱི་གསུང་དུ་མང་པོ་འདུག་གོ།",
    "འདི་ལས་གཞན་དུ་གྱུར་པའི་ལམ་བགྲོད་ཚུལ་ཞིག་དུས་གསུམ་གྱི་ཉན་རང་འཕགས་པ་ཐམས་ཅད་ལ་མེད་དོ།",
    "ལྟ་བ་གང་རང་བློ་དང་འཚམས་པ་དེའི་རྗེས་སུ་ཞུགས་ན་དོན་ཤིན་ཏུ་ཆེ་བས་ན།",
    "ཁར་མི་འགྲོ་བ་ཡང་མང་དུ་འདུག་པར་གསུངས་པ་ནི་རྗེ་ཉིད་ཀྱི་རྗེས་འཇུག་ལ་བལྟ་པར་གསུངས་སོ།",
    "དེ་དག་ཀྱང་རྒྱལ་བ་སེང་གེའི་ང་རོའི་འཁོར་དུ་སྐྱེས་ནས་མཆོག་ཐོབ་པར་དབེན་ས་བཀའ་འབུམ་དུ་གསུངས་པ་སྤྲུལ་བའི་གླེགས་བམ་ན་ཡོད་པ་ཡིན་འདུག་པས་ཆེས་བསམ་གྱིས་མི་ཁྱབ་བོ།",
    "ཐོག་མར་ཁོ་རང་དང་མཛའ་བའི་དགེ་སློང་གཅིག་མངགས་ཏེ།",
    "དམག་ནང་དུ་ཞག་གཅིག་འདུག་པ་དང་།",
    "མགྲོན་དུ་བོས་པ་ལས་དུས་ལྷག་པར་འདུག་པ་དང་།",
    "འདུག་ཚུལ་ལ་དགུ་དང་།"
