    "ཅེས་སོགས་ཀྱི་གསུང་ལན་མང་དུ་ཕེབས།",
    "ད་ཐེངས་བྱིངས་འདྲེན་དང་མཆོད་དཔོན་བཅས་ཕེབས་པ་ཡང་ཤིན་ཏུ་ལེགས།",
    "ངེད་ཀྱིས་ཁྱེད་ལ་ལྕགས་མཁར་གྱི་ཞིབ་ཁྲིད་གནང་ཞེས་གསུང་ཕེབས་པ་དང་།",
    "ཞེས་ཕྲན་བུ་ལ་གསུང་འཕྲོས་སུ་ཕེབས།",
    "ཡལྟ་གྲུབ་མི་གཙང་བ་ཞིག་ཚོགས་གྲས་སུ་ཡོད་ད།་",
    "མཚམས་གྱིས་ཞེས་གསུངས་ནས་མ་གནང་།",
    "འོ་ན་ཉིན་ཤས་སྡོད་རྩིས་བྱས་ན་ཞེས་ཞུས་པ་དང་།",
    "ཞེས་བཀའ་གསུང་ཕེབས།",
    "ཕྱི་ཉིན་མགར་རྩེ་དགོན་དུ་བཞུགས་རྩིས་ཡོད་ཀྱང་ཉི་ཚོད་ཅུང་སྔ་བས་ཞོ་འཕོང་ལུང་བར་ཕེབས་འཕྲལ།",
    "བཀའ་དྲིན་ཁོ་ནས་འཇིགས་སྐྲག་ལས་ཐར་བ་བྱུང་ཞེས་འདི་གའི་ཁྲིད་གནང་དུས་སུ་གསུང་འཕྲོས་ཀྱི་ཚུལ་དུ་བསྩལ།",
    "ཚུལ་འདི་ཙམ་ཡང་བླ་སློབ་ཀྱི་འགྲན་ཟླ་མེད་པའི་རྣམ་པར་ཐར་བ་ཁོ་ནར་སྣང་ངོ།",
    "དེ་ནས་༧ གོང་ས་མཆོག་སྤྲུལ་ཪིན་པོ་ཆེ་ད་ལྡན་ཕེབས་ཀྱིས།",
    "རྣམ་གཉིས་གདན་ས་བདེ་ཆེན་དུ་ཕེབས་འཕྲལ།",
    "འཚམ་པར་འཇུག་པའི་ཚུལ་འདི་སུ་ཡིས་འགོག།",
    "དགུང་ལོ་སོ་ལྔ་བཞེས་པ་ཆུ་རྟ་སྟེ་སྤྱི་ལོ་༡༩༤༢ལོར།",
    "མཱ་པོའུ་ཧྥང་ནས་ཆབ་སྲིད་ལ་གཞིགས་ནས་ཁོང་རྣམ་གཉིས་ཡང་ཡང་གདན་ཞུ་བ་མངགས་པ་ལྟར་ཟི་ལིང་ཕྱོགས་སུ་ཕེབས།",
    "ཁམས་གསུམ་རྣམ་རྒྱལ་དུ་བཞུགས་གདན་འཇགས།",
    "བདུན་པའི་ཡར་ངོའི་ཚེས་བཅུར་ཁོང་རྣམ་གཉིས་དབུར་བཞུགས་ཀྱིས་མཚན་ཞབས་བླ་གྲྭ་ལྷན་རྒྱས་ནས་རྗེ་ང་འདྲ་མའི་མདུན་ནས་འཇིགས་བྱེད་ལྷ་བཅུ་གསུམ་མའི་བདག་འཇུག་མཛད་དེ་བསྟན་པ་རྒྱས་པའི་ཐུགས་སྨོན་གནང་ཞིང་།",
    "འཇིགས་བྱེད་དམར་བོ་མདའ་འགེངས་ཀྱི་རྗེས་གནང་།",
    "དགུང་ལོ་སོ་དྲུག་བཞེས་པ་ཆུ་ལུག་སྟེ་སྤྱི་ལོ་༡༩༤༣ལོར།",
    "འཇིགས་བྱེད་ཞལ་ཕྱག་ཡོངས་རྫོགས་ཡུམ་བཅས་ཀྱི་རྗེས་གནང་སོགས་དང་།",
    "སོགས་གསན་བཞེས་མཛད།",
    "གཙང་ཞྭ་ལུ་མཐིལ་དཀར་བོ་དགོན་གྱི་གཞུང་གསུམ་ལ་ལོ་ཁ་ཤས་ཀྱི་རིང་དཀའ་ཚེགས་ཆེན་པོས་ཡང་ཡང་སྙན་སྒྲོན་ཞུས་པ་ལྟར།",
    "ངས་འཛིན་ཞབས་དྲུང་ལ་ཞུས་དང་དེས་ཆོག་ཅེས་གསུང་ཕེབས་པ་ནང་བཞིན།",
    "ཕྱག་ལེན་ཕྲ་ཞིབ་སློབ་པ་གལ་ཆེ་ཞེས་ཕེབས་པར་བརྟེན།",
    "ཕྱག་ལེན་གྱི་སྐོར་དང་བསྙེན་པ་གཏོང་ལུགས་ཀྱི་བཀའ་སློབ་ཅིས་ཀྱང་ཐུགས་རྗེས་འཛིན་པར་ཞུས་པས་ཐུགས་དགྱེས་པའི་ཞལ་བཞེས་གནང་།",
    "༧གོང་ས་མཆོག་དང་ལྷན་ཕེབས་ཀྱིས་བདེ་ཆེན་དུ་ཕྱག་ཕེབས།",
    "རྗེ་འཆང་ལ་ཞུས་པར་བརྟེན།",
    "ཞལ་ནས་གྲྭ་ས་ཆེན་པོ་ཞིག་ལ་ཆ་བཞག་ན་ལེགས་ཚུལ་གྱི་གསུང་ཕེབས།",
    "ཀུན་རིག་རྣམ་པར་སྣང་མཛད།",
    "དགུང་ལོ་སོ་བདུན་བཞེས་པ་ཤིང་སྤྲེལ་ཏེ་སྤྱི་ལོ་༡༩༤༤ལོར།",
    "༧གོང་ས་མཆོག་ལྷན་ཕེབས་ཀྱིས་ཁྲི་ཀའི་གོང་བ་གྲྭ་ཚང་ཐོས་བསམ་དར་རྒྱས་གླིང་དུ།",
    "ཇོ་བོ་ཆེན་པོར་མཆོད་འབུལ་རྒྱ་ཆེར་བསྟར་ཏེ་བསྟན་འགྲོའི་ཕན་བདེ་འཕེལ་རྒྱས་ཀྱི་ཆེད་སོགས་སྨོན་གནས་རྣམས་སུ་ཐུགས་འདུན་དྲག་པོས་མཚམས་སྦྱོར་ནན་ཏན་གནང་།",
    "ཡོངས་འཛིན་རྡོ་རྗེ་འཆང་ཚེས་གསུམ་གྱི་ཉིན་སྐུ་འབུམ་དུ་ཕེབས་ནས་༧བླ་ཁོ་རྡོ་རྗེ་འཆང་དང་།",
    "བག་ཙེ་རྣམས་ཀྱི་རྗེས་གནང་བཅས་བླ་ན་མེད་པའི་བཀའ་དྲིན་གྱིས་བསྐྱངས་པ་རྣམས་གསན་བཞེས་མཛད།",
    "ཡོངས་འཛིན་རྡོ་རྗེ་འཆང་སྐུ་འཁོར་ལྷན་རྒྱས་བཅས་དགོན་གསར་དགེ་ལྡན་རྣམ་རྒྱལ་གླིང་དུ་ཕྱག་ཕེབས།",
    "དགུང་ལོ་སོ་བརྒྱད་བཞེས་པ་ཤིང་བྱ་སྟེ་སྤྱི་ལོ་༡༩༤༥ལོར།",
    "བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་དུ་ཕེབས་ནས་ཁོང་བླ་ཁོ་རྡོ་རྗེ་འཆང་དགུང་གྲངས་བརྒྱད་ཅུ་བཞེས་པར།",
    "དེ་ཤིན་ཏུ་ལེགས་ཞེས་བཀའ་ལུང་ཕེབས་པར་བརྟེན།",
    "དེ་ནས་ཉིན་ཁ་ཤས་ལ་སྤྲོ་སངས་ཀྱི་ཚུལ་དུ་བཞུགས་སྐབས་སུ།",
    "གཙང་ཞིང་ཡིད་དུ་འོང་བའི་སྤང་ལྗོངས་མེ་ཏོག་སྣ་ཚོགས་པས་མཛེས་པ་སོགས་ངོ་མཚར་ཆེ།",
    "གཙོ་བོ་གདན་ས་འདིར་ཡུན་རིང་བཞུགས་རྒྱུའི་ཐུགས་སྨོན་གནང་དགོས་ཚུལ་དང་།",
    "དེར་ཚོགས་ཀུན་གྱི་དད་གདུང་སྤྲོ་དགའི་དྲི་བསུང་རྣོན་པོས་ཕྱོགས་ཀྱི་འཁོར་ལོ་འགེངས་པར་གྱུར་ཏོ།",
    "དགུན་ཁར་གྲྭ་ཚང་ལ་བྱ་བ་ལས་ཀྱི་འཁོར་ལོ་རྒྱས་ཕྱིར་ཞབས་རིམ་གང་མང་སྒྲུབ་འཇུག་གནང་བ་སོགས་འཁོར་ལོ་གསུམ་གྱི་མཛད་བཟང་འདབ་བརྒྱ་ཕྱོགས་བརྒྱར་རྒོད་པས་རྒྱལ་བསྟན་པདྨོའི་དགའ་ཚལ་རྒྱས་པར་མཛད་དོ།",
    "ཅེས་གསུང་ཕེབས་པར།",
    "དེ་ཡང་ས་འོག་ལྷོ་ཕྱོགས་རིམ་པ་བདུན་གྱི་འོག་ས་གཤིན་རྗེ་མ་ཧེ་གདོང་ཅན་ཕྱག་ན་ལྕགས་ཀྱུ་ཐོགས་པ་བྱོན་ནས་འཕྲིན་ལས་བཀའ་བཞིན་སྒྲུབ་པར་ཞལ་གྱིས་བཞེས་པའི་དོན་དུ་ཨེ་འགྲོ་སྙམ་ཡང་བླུན་པོ་བདག་འདྲས་དཔྱད་པའི་རྔོ་ག་ལ་ཐོགས།",
    "སྒྲིབ་བྲལ་མཁྱེན་བརྩེའི་དཀྱིལ་འཁོར་ཡོངས་རྫོགས་པ།",
    "དགུང་ལོ་སོ་དགུ་བཞེས་པ་མེ་ཁྱི་སྟེ་སྤྱི་ལོ་༡༩༤༦ལོར།",
    "བར་སྐབས་དེར་༧ཁོང་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པར་དངོས་འབྱོར་གྱི་མཆོད་སྤྲིན་བསྟར་ཏེ་གཟིམ་ཆུང་མཇལ་ཁ་ཞུས་པར།",
    "ཐུགས་དགྱེས་པའི་གསུང་གླེང་མང་དུ་ཕེབས།",
    "རིག་བྱེད་མའི་རྗེས་གནང་ཡང་གསན་བཞེས་དང་།",
    "གནང་རྒྱུན་ལྟར་གཙུག་དགུ་རྡོར་ཕྲེང་ནས་ཚུར་བསྣན།",
    "ཟུར་བཀས་སྤྱི་བཀའི་གོ་ཆོད་མིན་གྱི་དྲི་བ་སོགས་ཕྲན་ལ་ཡ་ཐུགས་བརྩེ་བས་འདོམས་པར་མཛད་དོ།",
    "ཟླ་བཞི་བའི་ཚེས་བཅུ་བཞི་དང་བཅོ་ལྔར་བསྒྲུབ་བྱ་མང་བོ་ལ་རབ་བྱུང་དང་དགེ་ཚུལ་དུ་སྒྲུབ་པའི་ལས་གྲྭ་བ་གྱིས་ཞེས་བཀའ་ཕེབས་པ་ལྟར་ཁོང་ནས་དད་གུས་ངོས་གང་དགོས་ཀྱི་ཕྱག་གཡོག་མཛད།",
    "ཐར་ཤུལ་དགོན་དུ་ཡང་ཕྱིང་དཀར་བ་བབས་ཏེ་གསུང་སྣ་ཚོགས་འབྱོན་ཚུལ་གོང་སྨོས་ལྟར་རྒྱས་པར་ཞུས་པས།",
    "ཡི་གེ་དབུ་ཅན་འདོན་ཐུབ་ཙམ་ལས་ཅི་ཡང་མི་ཤེས་ཞུས་པར།",
    "ངས་བརྟག་པ་ཞིག་བྱས་ཆོག་ཅེས་ཐུགས་དགྱེས་ཉམས་མཛད།",
    "གཅོད་ཁྲིད་བཅས་སྨིན་རྒྱས་སུ་བསྩལ་བ་གསན་བཞེས་གནང་།",
    "གསུམ་སྤྱི་སྒྲུབ་ཀྱི་ཁྲིད་གནང་།",
    "དྭགས་པོ་སྒོམ་ཆེན་གྱི་ལམ་རིམ་ལེགས་གསུང་ཀུན་གྱི་ཉིང་ཁུའི་ལུང་བཅས་གནང་།",
    "འདན་མ་གྲུབ་ཆེན་གྱིས་ཞུས་པའི་ཞལ་བཞིའི་དོན་བསྟོད་ཀྱི་ལུང་བསྩལ་བ་གསན་བཞེས་མཛད།",
    "ཚེ་རབས་རྗེས་འཛིན་གྱི་སྐྱབས་ཞུས་ནན་ཏན་གནང་།",
    "དགུང་ལོ་བཞི་བཅུ་བཞེས་པ་མེ་ཕག་སྟེ་སྤྱི་ལོ་༡༩༤༧ལོར།",
    "ཤི་གསོན་གྱི་བསྔོ་མིང་བྱུང་ཚད་ལ་མཆོག་གསུམ་གྱི་ཐུགས་རྒྱུད་བསྐུལ་ཏེ་འདི་ཕྱིའི་ལེགས་ལམ་དུ་ཐུགས་སྨོན་གྱིས་མཚམས་སྦྱོར་གནང་།",
    "མཚམས་གྲོལ་འཕྲལ་དུ་རང་དགོན་དུ་ཕེབས་ནས་འདུ་ཁང་གསར་བཞེངས་ཀྱི་སྐོར་ལ།",
    "ཀྱེ་ཕུར་ནས་ཤིང་ཆ་འདྲེན་པ་སོགས་བྱེད་དགོས་ཞེས་གསུངས་པ་ལྟར་བསྒྲུབས་ནས་ཟླ་བ་བཞི་བར་ལས་མགོ་བརྩམས་ཤིང་།",
    "དགུང་ལོ་ཞེ་གཅིག་བཞེས་པ་ས་བྱི་སྟེ་སྤྱི་ལོ་༡༩༤༨ལོར།་",
    "བརྟན་བཞུགས་ཕུལ་བར་གསུང་ལན་གནང་བ་ཡོངས་འཛིན་གྲགས་པའི་ཞལ་སྔ་ནས་ཀྱིས་བརྡ་སྐྱོར་གསལ་བོར་གནང་ཚུལ་ཕྲན་ལ་གསུང་འཕྲོས་སུ་བསྩལ།",
    "དེ་བཞིན་ལྷོད་མེད་བགྱིད་དགོས་ཀྱི་བཀའ་གསུང་ཕེབས།",
    "ཡོངས་འཛིན་ཡེ་ཤེས་རྒྱལ་མཚན་པས་གུང་ཐང་བསྟན་པའི་སྒྲོན་མེར་ཆེད་དུ་གནང་བའི་ལམ་རིམ་ཚོགས་ཞིང་བཞེངས་ཚུལ་ཁྱད་དུ་མཚར་བ།",
    "ལས་མི་རྣམས་ཀྱང་ཉེ་ཞོ་མེད་པར་ལས་ཡོན་སོགས་ཀྱིས་ཚིམས་ཤིང་དགའ་སྤྲོའི་ངང་ཕྱོགས་སུ་བཞུད།",
    "དེའི་ཆ་རྐྱེན་དུ་རབ་གནས་ཀྱི་ཆོ་ག་ཤིང་དཔར་དུ་འཁོད་པ་སོགས་ཀྱིས་ཐུགས་སྨོན་གང་རྒྱས་གནང་།",
    "གསུམ་པའི་བདེ་མཆོག་སྒྲུབ་མཆོད་བཅས་ཀྱི་དབུར་བཞུགས་ཀྱིས་དག་ཐེར་ལེགས་མཛད་གནང་།",
    "དགུང་ལོ་ཞེ་གསུམ་བཞེས་པ་ལྕགས་སྟག་སྟེ་སྤྱི་ལོ་༡༩༥ལོར།",
    "ཁོང་རྣམ་གཉིས་ཀྱིས་རང་དགོན་གྱི་གནས་ཚུལ་དྲི་གནང་མཛད་པར་ཞིབ་རྒྱས་ཞུས།",
    "ཞལ་མཐུན་པར་འདི་ལྟར།",
    "དེ་ནས་རང་དགོན་དུ་ཕེབས་ནས་རྒྱ་བཟའ་སྤྲུལ་པའི་སྐུ་སོགས་ཀྱིས་ཞུས་ངོར་སྐྱབས་ཁྲིད།",
    "བསྙུང་ཞིག་བཞེས་པའི་ཞབས་རིམ་དུ།",
    "དེ་ནས་ཁོང་རྟ་མགོན་སྦྲགས་སྒྲུབ་ཀྱི་བསྙེན་པར་བཞུགས་ཏེ་ཁ་སྐོང་སྦྱིན་སྲེག་བཅས་གྲུབ་འཕྲལ་བསྙུང་གཞི་ལྷག་མེད་དུ་དྭངས་ཚུལ་བསྟན།",
    "གྲྭ་ཚང་ལ་བདུད་ཚར་གཅོད་པའི་སྔགས་ཀྱི་རྡེའུ་འབུམ་རྒྱས་པ་ཞིག་བླུགས་སུ་འཇུག་གནང་མཛད་དེ་ཁོང་སྐུ་མཚམས་བཅད་རྒྱ་གནང་།",
    "དགུང་ལོ་ཞེ་བཞི་བཞེས་པ་ལྕགས་ཡོས་ཏེ་སྤྱི་ལོ་༡༩༥༡ལོར།",
    "ཚོགས་པས་ཚིམས་པར་མཛད།",
    "དེ་ནས་འཁྲུངས་ཡུལ་དུ་རིབ་ཙམ་ཕེབས་ནས་ཚ་ལའི་ཆུ་ཚན་དུ་བདུན་ཕྲག་གཉིས་བཞུགས།",
    "སྤྲུལ་བའི་སྐུའི་མཚམས་ཞུར་ཕེབས་པ་གདན་འཛོམས་སུ་མཇལ་ནས་ཕན་ཚུན་ཐུགས་དགྱེས་པའི་གསུང་གླེང་མང་དུ་འཕེལ།",
    "དེ་ནས་ཡུན་རིང་མ་འགྱངས་པར་སྐུ་ཞི་བར་མནོལ་ཚུལ་བསྟན།",
    "ཁོང་ཡོངས་འཛིན་རྡོ་རྗེ་འཆང་ཟླ་བརྒྱད་པའི་ཡར་ཚེས་ལ་སྐུ་འབུམ་དུ་ཕེབས་ནས།",
    "སྦྱངས་པའང་དཔྱིས་ཕྱིན་པ་བྱེད་འཇུག་གནང་།",
    "རྒྱལ་གྱི་དྲི་ཙམ་ཡང་མེད་པར་མ་ཆགས་འཕགས་པའི་རིགས་ལ་གས་པའི་རྣམ་པར་ཐར་བ་ངོ་མཚར་བའོ།",
    "དགུང་ལོ་ཞེ་ལྔ་བཞེས་པ་ཆུ་འབྲུག་སྟེ་སྤྱི་ལོ་༡༩༥༢ལོར།",
    "ལྷག་ལྷའི་བསྙེན་མཚམས་ལ་བཞུགས་པའམ།",
    "དགུན་ཐོག་རྟ་མགྲིན་གསང་སྒྲུབ་སོགས་ཀྱི་བསྙེན་མཚམས་ཀྱི་བཅད་རྒྱའི་ངང་བཞུགས་སོ།",
    "དགུང་ལོ་ཞེ་དྲུག་བཞེས་པ་ཆུ་སྦྲུལ་ཏེ་སྤྱི་ལོ་༡༩༥༣ལོར།",
    "སྤྱན་དབྱེའི་ཆོ་ག་དང་མཐར་རྒྱས་པའི་སྦྱིན་སྲེག་འབུལ་བ་སོགས་ཀྱིས་ཐུགས་ཁུར་ཉམས་བཞེས་གནང་།",
    "སྐལ་ལྡན་བགྲང་ལས་འདས་པའི་དད་གུས་ཝུ་བ་དཀར་བོ་འཛུམ་པའི་དགའ་བའི་ཆུ་གཏེར་ཕྱོགས་སུ་གྱེས་པར་གྱུར་ཏོ།",
    "དགུང་ལོ་ཞེ་བདུན་བཞེས་པ་ཤིང་རྟ་སྟེ་སྤྱི་ལོ་༡༩༥༤ལོར།",
    "ལེན་ཞིབ་པར་སློབ་ཏུ་བཅུག་སྟེ་གཤར་སྦྱངས་མཐིལ་ཕྱིན་བགྱིས་པས།",
    "འགོ་བླ་བརྒྱུད་ནས་མཇུག་རྡུལ་ཚོན་ཆབ་འདྲེན་གྱི་བར་ཆིག་སྐྱ་ཕེར་བའི་བཀའ་དྲིན་བསྐྱངས་པ་སྟེ་འབྱུང་འགྱུར་གྱི་བསྟན་རྒྱུན་ལ་དགོངས་པའི་ཐབས་མཁས་རྨད་དུ་བྱུང་བའི་རྣམ་པར་ཐར་བའོ།",
    "ཕྱི་ཉིན་རྡུལ་ཚོན་ཆབ་འདྲེན་གྱི་བར་ཀུན་ཏུ་ཕྱི་ནང་འགལ་རྐྱེན་གཡུལ་ལས་རྒྱལ་བའི་ངང་ཐམས་ཅད་དགའ་དད་སྤྲོ་གསུམ་འགྲན་པའི་བདེ་སྐྱིད་དབྱར་གྱི་མཚོ་ཆེན་རྒྱས་པར་གྱུར་ཏོ།",
    "ལོ་རྙིང་ནང་བཅད་རྒྱའི་ངང་བཞུགས་སོ།",
    "དགུང་ལོ་ཞེ་བརྒྱད་བཞེས་པ་ཤིང་ལུག་སྟེ་སྤྱི་ལོ་༡༩༥༥ལོར།",
    "ཕྱོགས་འདུས་ཀྱི་སེར་སྐྱ་བརྒྱ་དང་བདུན་ཅུར་ཉེ་བ་དལ་འགྲོས་ཀྱིས་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་དུ་ཕེབས།",
    "བསྟར་ཐོག་ཞབས་པད་བརྟན་བཞུགས་དང་ཚེ་རབས་རྗེས་འཛིན་གྱི་སྐྱབས་ཞུ་ནན་ཆེར་གནང་།",
    "ཉིད་ནས་གྲྭ་ཚང་གང་ཞིག་འཛུག་རྒྱུ་ཡིན་ཞུས་པར།",
    "ཡང་བསྐྱར་གྱིས་ངས་འདུ་ཁང་གསར་བཞེངས་བྱེད་དགོས་ཞེས་གསུངས་གནང་བྱུང་བས།",
    "ཟབ་ཡངས་མཁྱེན་པ་གཡས་སུ་འཁྱིལ་བའི་མཚོར།",
    "འཕྱུར་བའི་རླབས་ཕྲེང་དུས་ལས་ཡོལ་མེད་པར།",
    "མུན་པའི་ཁྲོད་ན་ལོག་པར་རྒྱུ་བ་ལ།",
    "སེམས་བསྐྱེད་འབོག་པའི་ཆོ་ག་རྒྱས་པར་མཛད་དེ།",
    "དེ་ནས་རང་ཡུལ་དུ་ཕེབས་ནས་༧གོང་ས་མཆོག་ཀུན་བདེ་གླིང་དུ་བཞུགས་པ་ལ་མཇལ་འཕྲད་དང་།",
    "དགུང་ལོ་ཞེ་དགུ་བཞེས་པ་མེ་སྤྲེལ་ཏེ་སྤྱི་ལོ་༡༩༥༦ལོར།",
    "ཟླ་བདུན་པར་དེར་ཕེབས་ནས་བེ་རུ་མཁན་སྤྲུལ་སོགས་ཀྱིས་གཙོས་བླ་སྤྲུལ་ཁག་དང་གྲྭ་ཚང་ལ།",
    "འཇམ་དབྱངས་དཀར་བོ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "དགུང་ལོ་ལྔ་བཅུ་བཞེས་པ་མེ་བྱ་སྟེ་སྤྱི་ལོ་༡༩༥༧ལོར།",
    "གནས་བརྟན་བཅུ་དྲུག་བྲག་རི་མ་བཞེངས་བཀོད་ཁྱད་མཚར་ཅན་སོགས་སྐུའི་རྟེན་བཞེངས་ཀྱི་རིམ་པ་མང་བོ་ལེགས་གྲུབ་གནང་།",
    "ཤར་རྫོགས་ཆེན་ཞི་བ་འཚོ་ཚང་སྐུ་ཞི་བར་གཤེགས་པའི་དགོངས་རྫོགས་སུ་ཁོང་རྡོ་རྗེ་འཆང་གདན་དྲངས་པ་ལྟར་ཞབས་ཕྱི་བཅུ་ཕྲག་ལྷག་བཅས་ཤར་ལྷ་ལྕམ་སྒར་དུ་ཕེབས་ནས།",
    "ཕྱིར་རང་དགོན་དུ་ཕེབས་ནས་བཅད་རྒྱར་བཞུགས་སོ།",
    "དགུང་ལོ་ང་གཅིག་བཞེས་པ་ས་ཁྱི་སྟེ་སྤྱི་ལོ་༡༩༥༨ལོའི་གནམ་ལོ་གསར་ཚེས་ཀྱི་དུས་སྟོན་སོགས་འཆར་ཅན་རྒྱུན་ལྡན་གནང་།",
    "ཨ་ལགས་ཡོངས་འཛིན་ལ་ད་ལོ་བར་ཆད་ཆེ།",
    "བརྒྱད་པའི་ཚེས་མགོར་བཙོན་འཇུག་བྱས་ཏེ་ངལ་རྩོལ་གྱིས་བསྒྱུར་བཀོད་བྱེད་མགོ་བརྩམས།",
    "ལོ་གསུམ་དང་ཟླ་ངོ་བཞིའི་མཐར་བཙོན་གྲོལ་ལྟ་བུ་ཞིག་ཐོབ་ནས་སླར་རང་ཡུལ་དུ་ཕྱིན་ཐུབ་པ་བྱུང་ཞེས་ཕེབས།",
    "དགུང་ལོ་ང་བཞི་བཞེས་པ་ལྕགས་གླང་སྟེ་སྤྱི་ལོ་༡༩༦༡ལོར།",
    "སྟོན་པས་མ་བྱས་པ་དང་མི་འཕྲད་ཅིང་།",
    "བྱས་པ་ཆུད་མི་ཟ་ཞེས་གསུངས་པ་སོམས།",
    "དགུང་ལོ་ང་ལྔ་བཞེས་པ་ཆུ་སྟག་སྟེ་སྤྱི་ལོ་༡༩༦༢ལོར།",
    "ཞེས་གནང་བའང་ལུགས་ཟུང་ལ་མཁྱེན་སྤྱན་ཡངས་པའི་གསུངས་སོ།",
    "དགུང་ལོ་ང་དྲུག་བཞེས་པ་ཆུ་ཡོས་ཏེ་སྤྱི་ལོ་༡༩༦༣ལོར།",
    "ཟླ་དྲུག་པའི་ནང་ཚ་ལ་ཆུ་ཁོལ་དུ་བདུན་ཕྲག་གཉིས་བཞུགས།",
    "དགུང་ལོ་དོན་གསུམ་བཞེས་པ་ལྕགས་སྤྲེལ་ཏེ་སྤྱི་ལོ་༡༩༨ལོར།",
    "བོ་ཨ་ལགས་བློ་བཟང་དང་།",
    "བཞུགས་པའི་ཚུལ་ལ་སུ་ཡང་སོམ་ཉི་བྲལ།",
    "ཧོར་ཟླ་བཅུ་གཅིག་པའི་དམར་ཕྱོགས་དགའ་བ་གཉིས་པར།",
    "དེ་ཕྱོག་སུ་ཕེབས་བཞུད་དང་།",
    "གཅོད་ལ་རིངས་པར་ཆས་པ་ཞིག།",
    "དགུང་ལོ་དོན་བཞི་བཞེས་པ་ལྕགས་བྱ་སྟེ་སྤྱི་ལོ་༡༩༨ ༡ལོར།",
    "ཁོང་རྡོ་རྗེ་འཆང་མགུར་རྣམ་རྒྱལ་གླིང་དུ་ཕྱག་ཕེབས།",
    "ཟླ་གསུམ་པར་ཁོང་རྡོ་རྗེ་འཆང་སྐུ་འབུམ་བྱམས་པ་གླིང་དུ་ཕེབས།",
    "དེར་བཞུགས་རིང་ལ་སྐུ་འབུམ་དཔར་ཁང་དུ་བཞུགས་པ་ཕལ་ཆེར་གྱི་ལེའུ་བཅུ་གསུམ་པ།",
    "དགུང་ལོ་དོན་ལྔ་བཞེས་པ་ཆུ་ཁྱི་སྟེ་སྤྱི་ལོ་༡༩༨༢ལོར།",
    "རིམ་གྱིས་གཟིམ་ཁང་དང་གྲྭ་ཤག་བཅུ་གསར་ཕིབས་གནང་།",
    "ཁོང་བླ་བྲང་དུ་ཕེབས་རྒྱུའི་བཀའ་ནན་ཆེ་བར་བརྟེན།",
    "ལོ་རྗེས་མར་འདོན་རྒྱུ་བྱས་ཆོག་ཅེས་བཀའ་ལུང་ཕེབས་པར།",
    "དགུང་ལོ་དོན་དྲུག་བཞེས་པ་ཆུ་ཕག་སྟེ་སྤྱི་ལོ་༡༩༨༣ལོར།",
    "རིགས་གསུམ་སྤྱི་སྒྲུབ་ཀྱི་རྗེས་གནང་བཅས་ཀྱིས་ཚིམས་པར་མཛད།",
    "ཀུན་རིག་ལྷ་སོ་བདུན་མ་དང་།",
    "རིགས་གསུམ་སྤྱི་སྒྲུབ་ཀྱི་རྗེས་གནང་དང་།",
    "འཇིགས་བྱེད་ལྷ་བཅུ་གསུམ་མའི་སྒྲུབ་མཆོད་གསར་འཛུགས་ཀྱི་ཆེད་དུ་སྤྱི་རྫས་ཕོན་ཆེན་སྦྱོར་འཇགས་གནང་སྟེ་ཕྱོགས་སོ་སོར་དགེ་ལྡན་ལུགས་བཟང་འཕེལ་དར་གྱི་སྨོན་པས་མཚམས་སྦྱོར་མཛད།",
    "ཞེས་པའི་དགོངས་དོན་བཞིན་ཐུགས་ཉམས་སུ་བཞེས་ན།",
    "ཞེས་ཐུགས་བརྩེ་བས་ཞལ་བཞེས་དང་དབུགས་དབྱུང་བར་མཛད་དེ།",
    "ཡང་དག་པའི་ལམ་བཟང་དུ་བཀྲི་བའི་ཐབས་མཁས་སུ་གནང་།",
    "ཕྱག་ལེན་རྣམ་པར་དག་པ་ལ་སྦྱོར་བའི་ཐབས་སུ་གང་འགྱུར་གནང་།",
    "ཟླ་གསུམ་པའི་ཚེས་ཉེར་བདུན་ལ་བདེ་ཆེན་དུ་ཕེབས་ཤིང་།",
    "འཇམ་དཔལ་དཔའ་བོ་གཅིག་གྲུབ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "ལོ་སྔ་མ་ནས་ཞལ་བཞེས་གནང་བ་ལྟར།",
