    "ལུང་དང་སྤྱོད་པ་ཙམ་དུ་ཟད་པ་ལ་བསྟན་པ་དེ་ཡང་མེད་པར་གྱུར་པའི་དུས་ན་ལུང་ཉི་ཚེ་བཞུགས་སོ།",
    "ཀུན་དུ་སྤྱན་ཞེས་པ་ནི་ཐམས་ཅད་མཁྱེན་པ་དང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་གཉིས་དང་ལྡན་པའོ།",
    "འདི་ལ་གཞན་གྱིས་དད་པར་དཀའ།",
    "ལྡེམ་ངག་དྲང་སྲོང་ཞེས་གསུངས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་དགོངས་པ་དང་མཐུན་པར་བྱ་བའི་ཕྱིར་ཤཱ་རིའི་བུས་གསོལ་ཏེ།",
    "འཇིག་པར་ལྟ་བ་ཞེས་པ་ནི་ཡོད་མེད་དུ་ལྟ་བའི་མཐའོ།",
    "བདག་ཏུ་ལྟ་བ་ནི་ལོག་པར་ལྟ་བའོ།",
    "ཕྱིས་འདིར་ནི་ངེས་པའི་དོན་སྟོན་པ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "ཁང་པ་ཞེས་པ་ནི་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་ཉིད་ཁང་ཁྱེམ་ལྟ་བུར་བལྟའོ།",
    "སྤྱིར་ཁང་པ་གཡོ་བ་ཀྱེནི་རྣམ་པར་ཤེས་པའི་དཔེ་སྟེ།",
    "ཕུང་པོ་བཞི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ཡང་བུ་རྣམས་ཀྱིས་སྦྱིན་པར་བྱས་པ་དེ་བསླངས་པ་དང་།",
    "ཡང་ན་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པ་ཐོབ་ཏུ་ཟིན་གྱེས་ཀྱང་ལྷག་མ་མ་ལུས་པའི་མྱ་ངན་ལས་འདས་པ་མ་ཐོབ་པའི་ཕྱིར་སྦྱིན་པར་བྱས་པ་དེ་བླངས་སོ།",
    "དྲིལ་བུ་རབ་ཏུ་དཔྱངས་ཞེས་པ་ནི་སྤྱང་པར་བྱ་བའི་རྒྱན་ཏེ་སྤོབས་པ་རྣམ་པ་བདུན་ལ་སོགས་པས་སྤོབས་པའི་རྒྱན་ཞེས་པའི་དོན་ཏེ།",
    "སྦྱིན་པ་དང་ཚིག་སྙན་པ་དང་ཕན་པར་སྤྱོད་པ་དང་དོན་མཐུན་པའོ།",
    "གདིང་བ་ནི་ཡང་དག་པའི་འཚོ་བ་སྟེ་རྒྱུ་དང་ལོག་པར་སྤྱོད་པ་སྒོ་གསུམ་ནས་མི་རྒྱུ་ཞེས་པའི་དོན་ཏོ།",
    "བང་མཛོད་དང་ནོར་མང་པོ་དག་ནི་འདུས་བྱས་དང་འདུས་མ་བྱས་པའི་ཡོན་ཏན་ནོ།",
    "བཅོམ་ལྡན་འདས་དེ་ལྟ་མ་ལགས་སོ་ཞེས་པ་ནས་སྲོག་དང་ལྡན་པར་བགྱིས་པའི་སླད་དུའོ་ཞེས་པའི་བར་དུ་ནི་དྲིས་པའི་ལན་བཏབ་པ་སྟེ།",
    "ཆེན་པོ་སྦྱིན་པའི་བསམ་པས་ཆུང་ངུར་བརྗོད་དེ་ཆེན་པོ་ཐོབ་པར་བྱས་པས་འགལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "ཇི་སྐད་སྨྲས་པ་བུབཞིན་ནོ་ཞེས་པ་ནི་དོན་དེ་ཉིད་ཡིན་པར་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་བསྟན་པར་བྱས་སོ།",
    "ཡེ་ཤེས་ཕུན་སུམ་ཚོགས་པས་བདག་དང་གཞན་གྱི་དོན་རྫོགས་པར་མཛད་པ་དང་།",
    "སྐྱེ་རྒ་ན་འཆིས་རྙིངས་པར་བྱེད་པ་ནི་ཁང་པ་རྙིངས་པ་ལྟ་བུའོ།",
    "མི་ཕོངས་པར་རྩེན་ཞེས་གཞན་ལ་རག་ལུས་པ་མེད་པའི་ཕྱིར་རོ།",
    "སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "མཁས་པར་གྱུར་པ་ཞེས་པ་ནི་མཐུ་རྣམ་བཞི་སྟོན་ཏེ་མཁས་པ་ནི་རྒྱུ་དང་ལྡན་པའི་མཐུའོ།",
    "བརྩོན་པར་བྱེད་ཅེས་པ་ནི་ཚོགས་པའི་མཐུའོ།",
    "ཕ་རོལ་ལས་ཐོས་ཞེས་པ་ཡང་འཕགས་པའི་མན་ངག་པས་འབྲས་བུ་རྙེད་པར་འགྱུར་གྱི་གཞན་གྱིས་བྱམ་ཡིན་ཞེས་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ནི་སྟོང་པ་མཁྱེན་པའི་ཡེ་ཤེས་སོ།",
    "དང་པོ་ཚིགས་སུ་བཅད་པ་ཕྱེད་ཀྱིས་ནི་འཇིག་རྟེན་གསུམ་ན་དེ་བཞིན་གཤེགས་པ་བཞུགས་པའི་དཔེ་བསྟན།",
    "བདག་མེད་པ་དང་མི་གཙང་བ་དང་སྟོང་པའི་དོན་བསྟན།",
    "རྣམ་པར་ཤེས་པ་བརྒྱད་ནི་མཁར་ལྟ་བུའོ།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་དང་མ་རིག་པ་ལ་སོགས་པས་གླགས་ཤིང་བརྟན་པར་གནས་པའོ།",
    "ཆགས་པར་འགྱུར་བ་དང་།",
    "བྱ་རྒོད་དང་ཕུག་རོན་ལ་སོགས་པ་རིམ་པར་སྦྱར་རོ།",
    "སྐྱོ་བ་དང་སྤང་བར་བྱ་བ་ཡིན་གྱི་དགའ་བའི་གནས་མ་ཡིན་པར་བསྟན་པའོ།",
    "གནས་དང་གནས་ན་རྣམ་པར་འཆའ་ཞིང་ཟ།",
    "དེ་ལ་ཚིག་དང་པོ་གསུམ་གྱིས་ནི་ལོག་པར་ལྟ་སྙེབའི་དཔེ་བསྟན།",
    "ཞེས་བུཔའི་བར་དུ་ནི་ལོག་པར་ལྟ་བ་ལ་སོགས་ཏེ་ལྟ་བ་རྣམ་ལྔས་རྒྱས་ཤིང་འཕེལ་བར་གྱུར་པ་ཉིད་འགྲངས་པར་གྱུར་པ་སྟེ།",
    "བརྟུལ་ཞུགས་བསྙེམས་པ་གཙོ་ཡིན་པར་འཛིན་པས་འཇིག་རྟེན་ལས་འདས་པའི་དོན་ཚོལ་བ་ཉིད་དོ།",
    "ལོག་པའི་བརྟུལ་ཞུགས་ཀྱིས་རྣམ་པར་གྲོལ་བའི་དགའ་བ་ཚོལ་བ་ནི་ཁྱེ་འཁང་བས་དགའ་བར་བྱེད་པ་བཞིན་ནོ།",
    "རྟག་པར་འཛིན་པ་དང་།",
    "ཆད་པར་འཛིན་པ་གཉིས་ཏེ།",
    "ཆད་པར་འཛིན་པ་ནི་རྒྱུ་དང་།",
    "མུ་སྟེགས་ཅན་རྣམས་ཕྱིན་ཅི་ལོག་སྣ་ཚོགས་ཀྱིས་ལོག་པར་ལྟ་བ་ནི་དཔེར་གནོད་སྦྱིན་ལ་སོགས་པའི་གདོན་ལྟ་བུ་སྟེ།",
    "མི་དེ་ཁྱེམ་གྱི་ཕྱི་རོལ་ཏུ་ཤཱཉུབྱུང་ཞེས་པ་ཡང་ཇི་ལྟར་ཁྱིམ་བདག་མེད་པའི་ཁང་པ་བཅོས་ཤིང་ལྟ་བ་མེད་པ་འདྲུམས་ཤིང་ཞིག་པར་གྱུར་པ་བཞིན།",
    "ཤི་བས་ནམ་དུ་ཡང་འཇིགས་རྒྱ་པར་འགྱུར་ཞེས་པའི་དོན་ཏོ།",
    "ལུས་དང་སེམས་ཚིག་པར་བྱེད་པས་མེའི་དཔེ་བསྟན།",
    "རྣམ་པར་ཤེས་པ་ནི་ཕུང་པོ་བཞི་རྣམས་ཀྱི་གནས་སུ་གྱུར་པའི་ཕྱིར་ཁང་པ་ལྟ་བུར་བལྟའོ།",
    "དེ་ན་རྗོདུས་བྱས་ཤི་ལ་སྤྱང་ཀི་དག།",
    "གྲུབ་པའི་གནས་བདེ་བ་ལ་དགོད་པར་སེམས་པའོ།",
    "ཞེས་པ་ནི་སྡུག་བསྔལ་འཇིགས་པ་ཆེན་པོ་དང་ལྡན་པར་བསྟན་པ་སྟེ།",
    "གནོད་སྦྱིན་ནི་ལས་ངན་པར་སྤྱོད་པའོ།",
    "དེ་ལ་ཡང་དང་པོར་བཞོན་པ་བྱིན་པར་ཁས་བླང་བ་དང་།",
    "བཞོན་པ་ཁྱེམ་གྱི་ཕྱི་རོལ་ན་ཡོད་པར་བསྟན་པ་དང་།",
    "བཞོན་པ་ང་ལ་ཡོད་ཅེས་པ་ནི་བཞོན་པ་སྦྱིན་པར་ཁས་བླངས་པའོ།",
    "བཞོན་པ་དེ་འདྲ་ཡོད་པར་ཤེས་ནས་སུ།",
    "སེང་གེའི་ཁྲི་ལ་བཞུགས་ཞེས་པ་ནི་མི་འཇིགས་པའི་ས་ལ་གནས་པ་སྟེ།",
    "ཅེས་པའི་བར་དུ་ནི་མི་དེ་མཛོད་ཀྱི་མཐུ་དང་ལྡན་པ་ནི་འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་མཛོད་དང་ལྡན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཟག་པ་མེད་པའི་ཕུང་པོ་ལྔ་དང་ལྡན་པའི་སྐུ་སྟེ།",
    "གདིང་བ་འཇམ་པོ་ལ་སོགས་པའི་རྒྱུ་ནི་རྣམ་པར་དཀར་བ་སྒྲིབ་པ་གཉིས་དང་བྲལ་བའི་རྐྱེན་སྤྱོད་པ་དམ་པ་དང་ལྡན་པ་འཚོ་བ་རྣམ་པར་དག་པའི་གདན་ལ་བཞུགས་ཞེས་པའི་དོན་ཏོ།",
    "ཟག་པ་ཟད་པར་མཁྱེན་པའོ།",
    "དེའི་འོག་མ་གཉིས་ཀྱིས་ནི་དགའ་བའི་མཆོག་ཡིན་པར་བསྟན་ཏོ།",
    "དེ་ལ་ཡོན་ཏན་བཞི་ནི་དམ་པ་ཁྱད་པར་ཅན་སྒྲིབ་པ་མེད་པས་རྣམ་པར་དག་པ་དང་།",
    "བསམ་གཏན་དང་སྟོབས་དང་ཏིང་ངེ་འཛིན་ཞེས་པ་ནི་ལོངས་སྤྱོད་ཀྱི་གནས་དམ་པ་ཡིན་པར་བསྟན་པའོ།",
    "ནུབ་དང་ཉིན་པར་ལོ་དང་བསྐལ་པ་འདའ་བར་བྱེད།",
    "འབྲས་བུ་ཐམས་ཅད་ཇེག་པ་ཆེན་པོ་དང་ལྡན་པར་བསྟན་ཏོ།",
    "སྔར་ཚིགས་བཅད་བཅུ་བཞིས་དྲང་བ་དང་ངེས་པའི་དོན་ལ་འཇུག་པར་བསྟན།",
    "ཇེག་པ་རྣམ་གཉིས་ལྟ་བུ་ལས་ཁྱད་པར་དུ་བསྟན་པའོ།",
    "བདུན་དག་ལ་བསྟན་དུ་མི་རུང་བར་གསུངས་པ་སྟེ།",
    "ཁྲོ་གཉེར་བྱས་ཞེས་པ་ནི་ལུས་དང་སེམས་མ་དད་པའི་ཚུལ་སྟོན་པའོ།",
    "ངན་བྱས་པ་ནི་བརྙས་པ་སྨད་པ་ཕྲག་དོག་བྱས་པ་ཁོན་དུ་གཟུང་པའོ།",
    "ཝར་གྱུར་པའི་རྣམ་པར་སྨིན་པ་ནི་རྔོས་འཁོངས་པ་མི་གཞར་བ།",
    "ཚིག་སྨྲས་པ་མིས་ཡིད་མི་ཆེས་པར་གྱུར་པ།",
    "གཞན་གྱི་རྐུན་པོ་བྱས་པར་གྱུར་པ་ཡང་།",
    "དེ་དག་སེམས་མི་དྲན་ཞིང་འོན་པར་གྱུར།",
    "མི་མ་རབས་སུ་འགྱུར་བ་རིམ་བཞིན་ཅི་རིགས་པར་སྦྱར་རོ།",
    "ཞེས་པའི་བར་དུ་ནི་མི་མ་རབས་སུ་གྱུར་པ་ལྷོ་རྣམ་པར་སྨིན་པ་བསྟན་ཏེ།",
    "མི་མཛེས་པར་གྱུར་པ་དང་།",
    "སྤྱོད་པ་ངན་པར་གྱུར་པ་སྟེ།"
  ]
