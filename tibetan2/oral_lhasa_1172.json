    "འབྲས་བུ་ནི་རྒྱུས་བསྒྲུབས་པ་དོན་ཡོད་པར་བྱེད་པའོ།",
    "གླེང་གཞིའི་ལེའུ་བསྟན་ནས་ཡང་དག་པའི་གཞུང་ཉིད་བསྟན་པར་བཞེད་དེ།",
    "དེའི་ལུང་བསྟན་པར་དགོངས་པའི་ཕྱིར་དེའི་འོག་ཏུ་དགེ་སློང་ལྔ་བརྒྱ་ལུང་བསྟན་པའི་ལེའུ་བསྟན་ཏོ།",
    "དངོས་སུ་འཆད་པ་དང་འདོན་པ་རྣམས་ལྟ་སྒོས་ཀྱང་མི་དགོས་པར་བསྟན་པའི་ཕྱིར་དེའི་འོག་ཏུ་སྐྱེ་མཆེད་དྲུག་རྣམ་པར་དག་པའི་ཡོན་ཏན་གྱི་ལེའུ་བཞག་གོ།",
    "བཅོམ་ལྡན་འདས་མྱ་ངན་ལས་འདས་པའི་འོག་ཏུ་དགེ་སློང་རྣམས་ཇི་ལྟར་བཅོམ་ལྡན་འདས་ལ་གནས་འཆའ་བ་བཞིན་མ་འོངས་པ་ན་སུ་ལ་བརྟེན་པར་བཀྱི།",
    "ཅི་ལ་གནས་པར་བགྱི།",
    "དད་པས་ནི་འཇུག་ནུས་པར་འགྱུར།",
    "ཡེ་ཤེས་ཀྱིས་ནི་འབྱུང་ནུས་པར་འགྱུར་ཏེ།",
    "གཞན་གྱིས་སྨྲས་པ་དེ་ལྷག་ཆད་མེད་པར་ཟློས་ཙཔ་དེ་ལ་ཡང་འདི་སྐད་ཅེས་བྱ་སྟེ།",
    "ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་ཞེས་བཏགས་པ་ལ་བདག་ཅེས་གདགས་པ་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཙམ་གྱི་དུས་སོ།",
    "དེ་ལ་རྣམ་པར་ཤེས་པའི་དུས་ནི་འཆད་པ་དང་ཉན་པ་རྣམས་ཀྱི་ཡིད་ལ་དུས་གསུམ་ལྟ་བུར་སྣང་ཞིང་ཡུན་རིང་ཐུང་དང་ཉིན་མཚན་དུ་སྣང་བ་དེའི་དུས་ཏེ།",
    "རྒྱལ་པོའི་ཁབ་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་བཞུགས་ཞེས་པ་ནི་གནས་ཕུན་སུམ་ཚོགས་པ་བསྟན་ཏེ།",
    "དེར་གནས་པ་དང་བཞུགས་པ་དང་བཞེངས་ཞེས་པའི་དོན་ཏེ།",
    "འཕགས་པ་དང་ལྷ་དང་ཚངས་པའི་བཞུགས་ས་ལས་ཁྱད་པར་དུ་བསྟན་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་དེར་བཞུགས་ཞེས་སྨོས་སོ།",
    "གདོན་གྱི་གནས་སུ་གཅིག་པུར་སྒྱུགས་པར་བྱས་པ་ལས།",
    "གཞན་གྱི་ཚིག་ཟློས་པ་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་ལྷན་ཅིག་ཏུ་ཐོས་པ་ཡང་མང་དུ་ཡོད་པར་བསྟན་པས་གཞན་དག་ཡིད་ཆེས་པར་འགྱུར་བའི་གཏན་ཚིགས་དང་གཉིས་སུ་ཕྱེ་བ་ཕུན་སུམ་ཚོགས་པ་བསྟན་པས་གཞན་ཡིད་ཆེས་པར་འགྱུར་བའི་གཏན་ཚིགས་ཏེ།",
    "དེ་ལ་བཀྲི་ཞུབ་དང་ངེས་པའི་དོན་བསྟན་པ་ནི་ཇི་ལྟར་བཅོམ་ལྡན་འདས་སྤྲུལ་པ་བཞུགས་པའི་ཞིང་ཉན་ཐོས་རྣམས་ལ་ངེས་པའི་དོན་སྟོན།",
    "བདུད་དང་མུ་སྟེགས་འཇིག་པར་བྱེད་པ་དང་།",
    "འཚོ་བ་གཙང་མས་ཉྫུའཚོ་ཞིང་སྒོ་གསུམ་དག་པར་གནས་པའོ།",
    "སློབ་པ་དང་མི་སློབ་པ་ལས་འཕགས་པའི་ཕྱིར་ཁྱད་པར་ཆེ་བ་དང་།",
    "སྟོང་ཕྲག་བཅུ་གཉིས་སྙེད་བཞུགས་པའི་ཕྱིར་གྲངས་མང་བས་ཆེ་བའོཐབས་ཅིག་ནི་གནས་པ་གཅིག་པའི་ཐ་ཚིག་གོ།",
    "མ་རིག་པ་ཡང་དངོས་སུ་མ་རིག་པ་ཉིད་ཀྱིས་ཟག་པར་བྱེད་པའི་ཕྱིར་མ་རིག་པའི་ཟག་པའོ།",
    "ཏིང་ངེ་འཛིན་གྱི་སྒྲིབ་པ་སྤངས་པས་སེམས་རྣམ་པར་གྲོལ་བ་དང་།",
    "རང་བཞིན་སྒྲིབ་པ་སྤངས་པས་ཤེས་རབ་རྣམ་པར་གྲོལ་བའོ།",
    "མ་རིག་པ་དང་སྲེད་པ་ལ་སོགས་པ་སྤངས་པས་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་དང་།",
    "དེ་དང་སྦྱོར་བའི་སེམས་གནས་འཕོས་པས་སེམས་རྣམ་པར་གྲོལ་བ་དང་།",
    "སེམས་དང་ཤེས་རབ་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བའི་ཕྱིར་རྟ་ཅང་ཤེས་བཞིན་དུ་ཞི་ཞིང་དུལ་བ་དང་།",
    "མ་ཉམས་པ་ལ་འགྲོ་བ་བཞིན་གང་བགྲོད་པའི་གནས་སུ་སོན་པ་དང་ཐོགས་པ་མེད་པར་གྱུར་པ་སྟེ།",
    "དེའི་ཕྱིར་བྱ་བ་བྱས་པ་བྱེད་པ་བྱས་པའོ།",
    "བྱ་བ་བྱས་པ་བྱེད་པ་བྱས་པའི་ཕྱིར་ཁུར་བོར་བ་སྟེ།",
    "ཟག་པ་ཟད་པ་ཉིད་བཀའ་ཡང་དག་པས་སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་སྟེ།",
    "འཇུག་པར་ཡང་འོས་པ་སྟེ།",
    "སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་ཀྱི་སྤོབས་པ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "གཅིག་པུ་དབེེན་པར་འོས་པ་སྟེ།",
    "ཟས་དང་གོས་ལ་སོགས་པ་ཡོ་བྱད་ཐམས་ཅད་མི་སོག་མི་སྡུད་པས་ཆོག་ཤེས་པར་གནས་པ་ནི་ཇི་ལྟར་གླང་པོ་ཆེ་འདུ་འཛི་དང་བྲལ་བ་བཞིན་ནོ།",
    "འཇིག་རྟེན་རྣམས་ཀྱི་བསམ་གཏན་དགའ་བའི་རོ་ལ་ཆགས་པ་མེད་པའི་ཕྱིར་སྲིད་པར་སྤྱོར་བ་ཡོངས་སུ་སྤངས་པའོ།",
    "རྫུ་འཕྲུལ་གྱིས་རོལ་པའི་ཕྱིར་བཀའ་ཡང་དག་པས་སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བའོ།",
    "དགྲ་བཅོམ་པའི་འབྲས་བུ་ལ་འདུས་བྱས་ནི་བསྟན་དུ་ཡོད་པ་འདུས་མ་བྱས་ནི་བསྟན་དུ་མེད་པའི་འབྲས་བུའོ།",
    "ཡོན་ཏན་ཁྱད་པར་ཅན་ཐོབ་པ་ནི་གླང་པོ་ཆེ་ལྟར་གཟི་བརྗིད་ཆེ་བས་མཐུ་དང་རྫུ་འཕྲུལ་ཕུན་སུམ་ཚོགས་པའོ།",
    "ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་ནི་བྱེད་པ་བྱས་པ་རྫོགས་པ་སྟེ།",
    "ཤེས་རབ་ནི་བསླབ་པར་བྱ་བ་དང་།",
    "དེ་གསུམ་རྫོགས་པར་གྱུར་པ་ནི་མི་སློབ་པའོ།",
    "གཞན་ནི་སོ་སོའི་མཚན་ཉིད་དོ་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པ་ཞེས་པ་ནི་ཆུད་པ་རྟོགས་པའི་དོན་རྣམ་པ་བཞིའོ།",
    "ཕྱི་རོལ་མུ་སྟེགས་ཅན་གྱི་རྟོགས་པ་ལས་ཁྱད་པར་དུ་བསྟན་པའི་ཕྱིར་ཡང་དག་པའི་རྟོགས་པ་དང་།",
    "ཐོབ་པར་འགྱུར་བ་ཕྱིར་མི་ལྡོག་པའོ།",
    "ཐོབ་པ་ནི་ས་དང་པོ་པའོཐོབ་པར་འགྱུར་བ་ནི་ས་བརྒྱད་པ་ཡན་ཆད་དོ།",
    "དང་པོ་བརྒྱད་ཀྱིས་ནི་འདུས་བྱས་ཀྱི་ཡོན་ཏན་བསྟན།",
    "སེམས་པར་ནུས་པ་འཛིན་པར་ནུས་པ་སྟེ།",
    "འཕགས་པར་གྱུར་པ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཕུང་པོ་ལྔ་ལ་སོགས་པ་འཕགས་པའི་ལམ་ལ་སྟོང་པ་འཁོར་ལོའི་ཡན་ལག་ཏུ་གནས་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་རིང་བསྲེལ་དང་མཆོད་རྟེན་མངོན་དུ་བཞུགས་པ་ལ་མཆོད་ཅིང་རིམ་གྲོ་བྱེད་པ་དང་།",
    "ཡང་ན་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་རིང་བསྲེལ་དང་མཆོད་རྟེན་མངོན་དུ་བྱས་ཏེ།",
    "ཚིག་སྙན་པ་དང་ཡིད་དུ་འོང་བ་གྲངས་མེད་པ་ཕྱོགས་བཅུར་ཁྱབ་པར་བྱས་ཏེ་མཆོད་ཅིང་རིམ་གྲོ་བྱེད་པ་དང་།",
    "ཡང་དག་པའི་དབྱིངས་ཉིད་ལས་ཡེ་ཤེས་ཕྱིར་མི་ལྡོག་པར་འཇུག་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་བསྟན་པ་འཛིན་པས་ཕྱོགས་སུ་རྣམ་པར་གྲགས་ཤིང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་བརྒྱ་སྟོང་མང་པོར་རྣམ་པར་གྲགས་པ་སྟེ།",
    "དེ་ལ་སོགས་པ་དང་ཐབས་ཅིག་ཏུ་བཞུགས་པ་ནི་བསྡུས་པའི་ཚིག་གོ།",
    "ས་ལ་གནས་པ་དང་ནམ་མཁའ་ལ་གནས་པར་དབྱེའོ།",
    "སྐར་མ་ནི་ཆུ་ཤེལ་ལས་བྱས་ཏེ།",
    "མ་སྐྱེས་དགྲའི་གླེང་གཞི་ནི་མ་བཙས་པའི་སྔ་རོལ་ཏུ་ཕ་བསད་པའི་བསམ་པ་དང་བཅས་པའི་ཕྱིར་མ་སྐྱེས་པར་ཕའི་དགྲར་གྱུར་པ་སྟེ།",
    "མ་འོངས་པ་ན་ཆུད་པར་འགྱུར་བའི་འཁོར་རོ།",
    "སྡུག་བསྔལ་ཆེན་པོ་ཞི་བར་བྱེད་ཅིང་བདེ་བ་ཆེན་པོ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་རིང་བསྲེལ་བསྟན་པར་བྱེད་པ།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་ས་བོན་གཅིག་བསྐྱེད་ཁྲུཔས་བརྒྱ་སྟོང་མང་པོ་བསྐྱེད་པར་འགྱུར་རོ།",
    "བརྒྱ་སྟོང་མང་པོ་ལས་ཀྱང་དེ་བཞིན་དུ་བསྐྱེད་དེ་མཐའ་ཡས་པར་འགྱུར་བ་བཞིན།",
    "ཡང་འདི་ཛེེདུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་རིང་བསྲེལ་བསྟན་པར་བྱེད་པ་སྟེ།",
    "མཐའ་ཡས་གདོན་མི་ཟ་ཞེས་པ་ནི་བྱིན་གྱི་རླབས་ཀྱི་ཁྱད་པར་བསྟན་པའོ་བུ།",
    "བཞུགས་པའང་རྣམ་པ་གཉིས་ཏེ།",
    "བཀྲ་ཤིས་པའི་ཚུལ་དུ་བཞུགས་པ་ལས་འདི་ནི་དང་པོའི་ཚུལ་དུ་བཞུགས་པའོ།",
    "ཏིང་ངེ་འཛིན་ཕུན་སུམ་ཚོགས་པ་ལ་བཞུགས་པས་སྐུ་དང་ཐུགས་མི་གཡོ་བར་གྱུར་པའོ།",
    "ཞིང་རྣམ་པར་གཡོ་བ་ལ་བཞུགས་པའོ།",
    "ཡང་ན་བཅུད་ཀྱི་འཇིག་རྟེན་ན་བཞུགས་པ་སྟེ།",
    "ཅིའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛིན་དུ་བཞུགས་ཞེས་སྨོས་སོ།",
    "ཚུལ་འདི་བསྟན་པས་གཞན་དག་ཀྱང་སེམས་ཤིན་ཏུ་ངེས་པར་བྱས་པ་ནི་ཐོས་པ་འཛིན་པའི་མཚན་ཉིད་ཧུ་༡པས་གཞན་དག་ཀྱང་སེམས་ངེས་པར་བསྟན་པ་དང་།",
    "ཐུགས་རྗེས་ཁྱབ་པར་མཛད་ཅེས་པའི་དོན་ཏོ།",
    "སྐྱེད་པའི་རྒྱུ་ནི་འགྲོ་བ་དྲུག་པོ་ཀུན་ཀྱང་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པས་བསྐྱེད་པའི་རང་བཞིན་ཅན་མ་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པའོ།",
    "ཡང་འགྲེལ་པ་ལས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་དྲིས་པ་དེའི་ལུང་བསྟན་པར་ནུས་པ་ནི་འཇམ་དཔལ་དེ་ཕུན་སུམ་ཚོགས་པ་གཉིས་དང་ལྡན་པའི་ཕྱིར་ཏེ།",
    "མེ་ཏོག་དེ་དག་ཙན་དན་ཀྱི་དྲི་བསུང་དང་ལྡན་ཞིང་ཡིད་དུ་འོང་བས་ཞིང་དེ་མཛེས་པར་བྱེད་པའོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པས་དཔེ་དང་དོན་གསལ་བར་སྟོན་པའོ།",
    "ཞེས་པ་ལས་ནི་ཆ་ཙམ་སྨོས་པར་བྱ་ཞེས་པའི་བར་དུ་ནི་ཚིགས་སུ་བཅད་པ་འདིས་ནི་འཁོར་རྣམ་བཞི་སྣང་བར་བསྟན་ཏེ།",
    "ངུར་སྤྲིག་གོས་རྣམས་རབ་ཏུ་གྱོན་པར་བྱེད།",
    "ཡོངས་སུ་བསམས་པས་ཉེ་བར་རྟོགས་དྷིཔར་གྱུར།",
    "ཅེས་པའི་བར་དུ་ནི་ཤེས་རབ་དང་ཏིང་ངེ་འཛིན་དང་ལྡན་པར་གྱུར་པའོ།",
    "ཅེས་པའི་བར་དུ་འདིས་ནི་ཐུགས་རྗེས་འདྲེན་པར་བསྟན་ཏེ།",
    "དེ་ལས་སྤྱོད་པ་ཡོངས་སུ་རྫོགས་པར་འགྱུར།",
    "ཞེས་པའི་བར་དུ་ནི་བསླབ་པ་ལ་གནས་ཤིང་སྒོ་གསུམ་ལ་སྤྱོད་པ་སྐྱོན་མེད་པར་གྱུར་པའོ།",
    "ཆགས་པ་མེད་པར་སྦྱིན་པ་དང་།",
    "དེ་ལ་ཁ་ཟས་ཀྱི་སྦྱིན་པ་བྱས་ན་ནི་མུ་གེའི་བསྐལ་པར་མི་སྐྱེ།",
    "འབྲས་བུ་བྱིན་པས་ནི་འཕགས་པའི་འབྲས་བུ་བཞི་དང་ལྡན་པར་འགྱུར།",
    "རྫིང་དང་ཁྲོན་པ་བྱིན་པས་ནི་རྣམ་པར་གྲོལ་བའི་ཆུ་དྲི་མ་མེད་པ་དང་ལྡན་པར་འགྱུར་ཞེས་གསུངས་སོ།",
    "ཞེས་པའི་བར་དུ་ནི་མཆོད་རྟེན་དེ་བྱས་པས་འཇིག་རྟེན་ཐམས་ཅད་ལ་མཛེས་པ་ནི་དཔེར་ན་ལྷའི་མེ་ཏོག་པ་རི་ཡ་ཏ་རྒྱས་པ་བཞིན་དུ་མཛེས་པ་བསྟན་ཏོ།",
    "ཐེ་ཚོམ་སོལ་ལ་དགའ་བ་བསྐྱེད་པར་གྱིསཀྱེ།",
    "ཞིང་རྣམ་པར་དག་པ་འདིའི་དོན་ཆུང་བ་མ་ཡིན་པར་བསྟན་པའོ།",
    "ཕྱིས་ཁྱད་པར་དུ་གྱུར་པ་ལས་ལན་བཏབ་པ་དང་།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་སྤངས་པའི་ཕྱིར་ཡང་དག་པར་རྫོགས་པ་སྟེ།་",
    "སྣོད་ཀྱི་འཇིག་རྟེན་འཇིག་པ་དང་ཆགས་པ་མཁྱེན་པ་དང་།",
    "རྒྱུ་རྐྱེན་ལ་སོགས་པ་ཀུན་མཁྱེན་པའོ།་།",
    "དོན་དང་ཚིག་ཚང་བ་ཁྱད་པར་དུ་འཕགས་པ་ནི་དོན་བཟང་བ་ཚིག་འབྲུ་བཟང་བ་མ་འདྲེས་པ།",
    "ཡོངས་སུ་དཀར་བ་ནི་རྣམ་པར་གྲོལ་བར་འགྱུར་བའོ།",
    "ཚངས་པར་སྤྱོད་པ་ནི་འཕགས་པའི་ཡན་ལག་བརྒྱད་དང་འགོག་པའི་བདེན་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་སྟེ།",
    "འགྲེལ་པ་ལས་རྒྱུ་ཁྱད་པར་ཅན་མངོན་དུ་མཐོང་བའི་རྒྱུ་སྟེ།",
    "རིགས་དམ་པ་དང་མིང་དམ་པ་དང་ལྡན་པར་བསྟན་པའི་གཏན་ཚིགས་སྨོས་པའོ།",
    "འཇུག་པར་འགྱུར་བའི་རྒྱུ་དང་དྲན་པའི་རྒྱུའོ།",
