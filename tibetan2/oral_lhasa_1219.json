    "རང་བཞིན་གྱིས་གྲུབ་པའི་དངོས་པོ་ཇི་ལྟར་མེད་པ་དེ་ལྟར་སྔར་རྣམ་པར་ཡོངས་སུ་དཔྱད་ཟིན་པའི་ཕྱིར།",
    "རྩོད་པས་གཞན་ཕམ་པ་དགོས་པ་མ་ཡིན་པར་བསྟན།",
    "ཅེས་གསུངས་པ་ལྟར་རོ།",
    "དེས་ན་ངེད་ལ་འབྲས་བུ་དང་བཅས་པར་བསྟན་པའོ།",
    "གཞན་གྱི་གཞུང་ལུགས་འཇིག་པར་བྱེད་པ་འགལ་ལོ་ཞེ་ན།",
    "གཞན་གྱི་གཞུང་ལུགས་འཇིག་པར་གྱུར་ཀྱང་།",
    "གཞན་གྱི་ལྟ་བ་ལ་ཞེ་སྡང་བས་མ་ཡིན་པར།",
    "དེས་ན་ངེད་ལ་འབྲས་བུ་དང་བཅས་པར་བསྟན་པ།",
    "འདོད་ཆགས་དང་ཁོང་ཁྲོ་རྣམ་པར་བསལ་ཏེ།",
    "སྐྱེ་རྒ་ན་འཆི་ལ་སོགས་པའི་སྐྱོན་རྣམས་མ་ལུས་པ་འཇིག་ཚོགས་ཕུང་པོ་ལ་བདག་ཏུ་ལྟ་བ་ལས་བྱུང་བར་བློ་ཡིས་མཐོང་བར་གྱུར་ཅིང་ངའོ་སྙམ་པའི་འཛིན་སྟངས་ཀྱི་གཟུང་བྱར་གྱུར་པའི་བདག་ནི་འཇིག་ལྟ་འདི་ཡི་འཛིན་སྟངས་ཀྱི་ཡུལ་དུ་རྟོགས་པར་བྱས་ནས་ཏེ།",
    "འཇིག་ལྟའི་དམིགས་པར་གྱུར་པའི་བདག་དེ་ཡོད་ཅིང་།",
    "གང་ཞིག་འཇིག་ཚོགས་ལ་ལྟ་བའི་དམིགས་པར་གྱུར་པ་བདག་ཅེས་བྱ་བ་འདི་ཅི་ཞིག།",
    "དེ་རྣལ་འབྱོར་པས་ཐོག་མར་བདག་ཁོ་ན་རྣམ་པར་དཔྱོད་པར་བྱེད་དོ་། ཞེས་དང་།",
    "དེ་གཉིས་ཀྱི་ནང་ནས་ཐོག་མར་བདག་འགོག་པར་གསུངས་ཤིང་བདག་ནི་འདི་ཡི་ཡུལ་དུ་རྟོགས་བྱས་ནས།",
    "རིགས་པས་རྣམ་དཔྱད་བྱས་པའི་ཚེ་བདག་མི་འགྲུབ་པར་བསྟན་པ།",
    "རྫས་གཞན་ཁེགས་པ་ན་རྟེན་བརྟེན་པ་སོགས་ཁེགས་པར་བསྟན་པའོ།",
    "ངར་འཛིན་གྱི་དམིགས་པར་གྱུར་པའི་བདག་དེ་ཁྱད་པར་ལྔ་ལྡན་དུ་བརྟགས་པ་ཡིན་ཏེ།",
    "རྟག་པའི་དངོས་པོ་ཡིན་པ་དང་རྣམ་འགྱུར་རྣམས་ཀྱི་བྱེད་པ་པོ་མ་ཡིན་པའི་ཁྱད་པར་དང་།",
    "ཁྱད་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ན།",
    "དེར་མ་ཟད་འཇིག་ལྟའི་གཟུང་བྱར་གྱུར་པའི་བདག་དེའི་འདོད་ལུགས་ཀྱི་དབྱེ་བ་ཅུང་ཟད་ལ་རྟེན་ནས་མུ་སྟེགས་ཅན་རྣམས་ལུགས་ནི་ཐ་དད་པར་གྱུར་ཏེ།",
    "བྱ་བའི་ཤུགས་ཤེས་པའི་ཡོན་ཏན་དགུ་དང་ལྡན་པར་སྨྲ་བ་དང་།",
    "འདི་ཡི་རྟེན་ཞེས་པ་དམིགས་རྣམ་གཉིས་སུ་ཕྱེ་བའི་དམིགས་པ་ལ་བྱེད་གསུངས་པ་མི་འཐད་དེ།",
    "དེ་ཁོ་ནར་ངར་འཛིན་གྱི་ཡུལ་མ་ཡིན་པར་མ་ཟད་ཀུན་རྫོབ་ཏུ་ཡང་ཡོད་པ་དང་།",
    "གཞན་ཡང་མུ་སྟེགས་ཀྱིས་བརྟགས་པའི་བདག་དེའི་ཁྱད་པར་ཀུན་ཀྱང་དེ་ཁོ་ན་ཉིད་དུ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "བྱེ་བྲག་པའི་བསྟན་བཅོས་ལས་བདག་དེའི་ཁྱད་པར་མུ་སྟེགས་རྣམས་ཀྱིས་གང་བསྟན་པ་དེ་ཀུན་ལ།",
    "ཞེས་གསུངས་པ་ནི་གཞུང་འདིས་གསལ་བར་བཀག་སྟེ།",
    "ཞེས་པའི་འགྲེལ་པར།",
    "འགྲེལ་པར་ཕྱོགས་འདིས་ནི་བདག་ཏུ་སྨྲ་བ་ཐམས་ཅད་དུ་མ་སྐྱེས་པ་ཉིད་ཀྱི་གཏན་ཚིགས་དང་།",
    "ཁྱད་པར་ནི།",
    "ཞེས་པར་འགོག་པའི་ཕྱིར།",
    "དེ་ལྟར་མ་ཡིན་པར་སྤྱིར་མ་སྐྱེས་པ་ཞེས་བཀོད་ནས་དེ་ཡང་དངོས་པོ་མ་ཡིན་པ་ལ་བློ་རྩེ་གཏོད་པ་ཁྱེད་ཀྱི་ལྟར་ན།",
    "དེ་ལྟར་མ་ཡིན་པར་རྟགས་གཞན་གྲགས་སུ་བྱས་ནས་ཁྱབ་པ་རང་ལུགས་སུ་འཇོག་ན།",
    "འགྲེལ་པར་འདི་ནི་ངར་འཛིན་པའི་ཡུལ་དུ་འང་མི་རུང་སྟེ།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་གསུངས་པས་སོ།",
    "ཕུང་པོ་མ་གཏོགས་པ་སྟེ་མེད་པའི་སར་བདག་དེ་ཡན་གར་དུ་འཛིན་པར་མ་གྲུབ་པའི་ཕྱིར།",
    "གལ་ཏེ་ཕུང་པོ་རྣམས་ལས་གཞན་། ཕུང་པོའི་མཚན་ཉིད་མེད་པར་འགྱུར།",
    "ཚེ་རབས་འདིར་ཁྱད་པར་ལྔ་ལྡན་གྱི་བདག་མི་ཤེས་ཀྱང་སྔོན་ཚེ་རབས་གཞན་ལ་གོམས་པས་བཟུང་བ་ཡིན་ནོ་ཞེ་ན།",
    "གང་དག་དུད་འགྲོར་བསྐལ་པ་མང་པོར་སྐྱེ་བ་བསྐྱལ་བར་གྱུར་པ་དེ་དག་ཀྱང་མ་སྐྱེས་པ་དང་རྟག་པས་ཁྱད་པར་དུ་བྱས་པའི་བདག་རྫས་གཞན་འདི་མ་མཐོང་ལ།",
    "ངར་འཛིན་དེ་དག་ལའང་འཇུག་པར་མཐོང་བའི་ཕྱིར།",
    "ཕུང་པོ་ལྔ་ཆར་ཡང་བདག་ལྟའི་རྟེན་དུ་གྱུར་པའི་བདག་དེ་ཡིན་པར་འདོད་ཅིང་།",
    "སློབ་དཔོན་ལེགས་ལྡན་འབྱེད་ཀྱིས་རྣམ་པར་ཤེས་པ་གང་ཟག་ཏུ་འདོད་ཅིང་།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་ནི་ཡང་སྲིད་ལེན་པའི་ཕྱིར་བདག་ཡིན་ནོ།",
    "བདག་རྟག་པ་བཀག་པས་བདག་ཁེགས་པར་འདོད་པ་ནང་འགལ་བར་བསྟན་པས་མཇུག་བསྡུ་བའོ།",
    "བདག་ནི་རྫས་སུ་གྲུབ་པར་འགྱུར་ཏེ།",
    "ཕྱིན་ཅི་ལོག་སྟེ་ཀུན་བརྟགས་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "ངེས་པར་བདག་ཆད་པར་འགྱུར་ཏེ།",
    "འདོད་ན་ཆད་པའི་ལྟ་བ་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "རྟག་པའམ་ཆད་པར་འཛིན་པ་དེ་མཐར་འཛིན་གྱི་ལྟ་བར་ཁྱེད་ཀྱིས་འདོད་པས་སོ།",
    "ཕུང་པོ་མི་རྟག་པ་ལ་སོགས་པར་ལུང་བསྟན་དུ་ཡོད་པའི་ཕྱིར།",
    "ཉེས་པ་འདི་ནི་བརྟེན་ནས་བཏགས་པའི་ང་ཙམ་བདག་ཡིན་པར་འདོད་པ་འང་མཚུངས་སོ།",
    "རྣལ་འབྱོར་པས་བདག་མེད་པར་མཐོང་བའི་ཚེ།"
  ]
