    "བསླབ་དེབ་ཀྱི་རྒྱབ་ཤོག་དཔེ་ཁུག་ལ་གཙུབ་པས་སྐྱ་བོར་གྱུར་པ་དང་གྲུ་སྣེ་ཡང་ཆད་འདུག་ཕལ་ཆེར་བསླབ་དེབ་ཀྱི་ནང་དོན་ཡང་ཕན་ཚུན་འབྲེལ་མི་ཐུབ་པ་འདྲ།",
    "ང་རང་ཕ་ཡུལ་གཅིག་པའི་སློབ་གྲོགས་དག་དང་མཉམ་དུ་གནའ་མཁར་ཟི་ལིང་ལ་ཕྱིན་པ་ཡིན།",
    "ང་རང་གནའ་མཁར་ཟི་ལིང་དུ་ཆས་པ་ཡིན།",
    "བོད་ཁམས་ཀྱི་རྒན་དར་གཞོན་གསུམ་ཚང་མར་མི་དང་རང་བྱུང་ཁམས་མཉམ་གནས་བྱེད་དགོས་ན།",
    "རྩོམ་ཧྲིལ་བོ་ཤུགས་དྲག་པའི་བརྩེ་དུངས་ཀྱིས་ཕྱུག་འདུག་པ་ཞིག་ཀྱང་ཡིན།",
    "སློབ་གྲོགས་འུ་ཐུག་ཐབས་ཟད་ཀྱི་ངང་ཡར་ལངས་ཙ་ན།",
    "དུས་རབས་གསར་བའི་ན་གཞོན་ངེད་ཅག་ལ་གདའ་འོ།",
    "ང་རང་ལའང་སྨྲ་མི་ཤེས་པའི་དགའ་སྤྲོ་ཞིག་སྐྱེས།",
    "ང་རང་ལ་ཕམ་ཁ་དང་སྡུག་བསྔལ་ལ་མགོ་མི་སྒུར་བའི་རང་གཤིས་ཤིག་ཀྱང་རིམ་གྱིས་ཆགས།",
    "དང་ཐོག་ང་རང་རྒྱུས་མེད་ཀྱི་བྱིས་པ་མང་བོའི་ཁྲོད་ནས་གསར་དུ་སླེབས་པའི་བག་གསར་བཞིན་གྲག་འགུལ་ཅི་ཡང་མེད་པར་ཁུ་སིམ་མེར་བསྡད་ལ།",
    "རྩོམ་གྱི་ཁ་བྱང་དང་བརྗོད་བྱ་གཉིས་ཀྱང་རྟ་བོ་སྒ་ཡིས་བརྒྱན་པ་བཞིན་གཞི་གཅིག་ཏུ་གྲུབ་འདུག་དཔྱིད་དཔལ་བསུ་བའི་འབོད་པ།",
    "ང་རང་བྱི་ལ་ཁྲ་རིས་མར་ཧ་ཅང་དགའ།",
    "ཕྱི་ཉིན་བྱི་ལ་དེའི་རྐང་བ་རྨས་འདུག་པས་གྱོལ་ལྡིང་བྱས་ནས་འགྲོ་བཞིན་ཡོད།",
    "རྒྱང་རིང་རྒྱང་རིང་ཞིག་ན་བདག་པོ་བཟའ་ཟླ་གཉིས་ཀ་སྦག་སྦག་འཁོར་ལོར་ཞོན་ནས་བྱ་འཕུར་བ་ལྟར་ཡོང་བཞིན་འདུགསྐབས་དེར་ངའི་ཡིད་སེམས་སྤྲོ་ལྷང་ངེར་གྱུར་ཏེ་མིག་ཟུང་གཡོ་བ་མེད་པར་བདག་པོའི་ཕྱོགས་སུ་ཅེར།",
    "ང་རང་ས་མཐའི་གནས་ཀྱི་ཚོང་པ་དེར་བཙོངས་ཏེ།",
    "ངས་ཁྱེད་རང་ཉལ་མེད་པ་མཐོང་ནས་འདིར་ཡོང་བ་ཡིན་ཞེས་བཤད།",
    "ཁྱེད་རང་ངལ་གསོ་རོགས་ཞེས་སྨྲས་པ་ན།",
    "གཞན་ཡང་རྩོམ་མཁན་ཆུང་ཆུང་འདིའི་ལྷད་མ་འདྲེས་པའི་སེམས་གཤིས་དེའང་རྗོད་བྱེད་ཀྱི་འགྲོས་དང་བསྟུན་ནས་ཀློག་མཁན་གྱི་མིག་ལམ་དུ་མངོན་འདུག་གོ།",
    "ཁྱེད་རང་ད་ལྟ་གང་ན་བཞུགས།",
    "དེའི་རྐྱེན་གྱིས་ངས་ཚོད་ཚོད་ལ་ཁྱེད་རང་དྲན།",
    "བུ་ཆུང་ང་རང་ཕ་ཡུལ་དང་རྒྱང་ཐག་རིང་ས་ནས་ཕྱིར་ལོག་ཐབས་བྲལ་ནའང་།",
    "རྩོམ་གྱི་བརྗོད་བྱའང་རང་བཞིན་ཉིད་དུ་འབུར་དུ་དོད་འདུག་གོ།",
    "ཁོའི་གདོང་དམར་ནག་ཏུ་གྱུར་པ་དང་ཆང་དྲི་ཁང་བའི་ནང་ལ་ཁྱབ་འདུག་པར་མ་ཟད།",
    "སྔམ་པ་གཅིག་རྗེས་གཉིས་མཐུད་དུ་འཐེན་བཞིན་འདུག་ངས་མྱུར་དུ་ཆུ་ཁོལ་མ་ཞིག་བླུགས་ཏེ་ཁོའི་གདོང་དང་རྐང་བ་བཀྲུས་པ་ཡིན།",
    "ང་རང་སྟབས་མ་ལེགས་པར་ཆུ་ནང་དུ་ལྷུང་།",
    "མི་རྣམས་ཀྱིས་ང་རང་གསོན་མི་ཐུབ་སྙམ་བྱུང་།",
    "ང་རང་ལོ་བཅུ་གཉིས་ལ་སོན་པའི་ལོ་དེར།",
    "བརྗོད་བྱ་འབུར་དུ་ཐོན་འདུག་ཅུང་མི་འདང་ས་ནི།",
    "སྡོང་རའི་ནང་དུ་ལྕང་སྡོང་དང་མ་གལ་གྱི་ཡལ་ག་བཅགས་ནས་གང་སར་གཡུགས་འདུག་པ་ནི་བྱིས་པ་པྲ་ཆལ་འགའི་ལག་རྗེས་ཡིན་ལ།",
    "ཁྱེད་ཉིད་ཤ་ཚོན་པོ་ཟོས་ནས་འདུག་ཁོམ་མེད་ལ།",
    "ཁོ་རང་ཕལཕལ་ཆེར་ཕོ་ལོ་སུམ་ཅུ་ཡས་མས་སུ་སླེབས་འདུག་གཟུགས་ཅུང་ཐུང་ལ་གདོང་སྒོར་ཞིང་ཤ་རྩ་སྨུག་པ་དང་།",
    "ཡི་གེ་འ་ཆུང་རང་བྱུང་དུ་བབས་འདྲའི་བྲག་རི་ཞིག་ཡོད་ལ།",
    "སྐབས་དེར་ངའི་སྣང་ངོར་ང་རང་ཡང་ལྡུམ་རའི་ཁྲོད་ཀྱི་ལི་ཤིའི་མེ་ཏོག་ཆུང་ཆུང་ཞིག་ཏུ་གྱུར་ཏེ།",
    "བདེ་སྐྱིད་ཀྱི་འཚོ་བ་སོགས་ལ་བསྟོད་བསྔགས་བྱེད་སྐབས་རྩྭ་ཕྲན་ང་ལའང་བསྟོད་བསྔགས་ཀྱི་མེ་ཏོག་གཏོར་བཞིན་འདུག་ཡིན་ནའང་།",
    "ང་རང་སྙན་ངག་པ་ཞིག་ཡིན་ན།",
    "ཁྱེད་རང་གངས་ལྗོངས་ཀྱི་མཚན་སྙན་དང་ཆབས་ཅིག་ཏུ་ཉི་ཟླའི་རྒྱུ་བ་མ་འགག་བར་དུ་བརྟན་གྱུར་ཅིགདཔྱད་བརྗོད།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "དེ་ནས་ས་བརྒྱད་པ་ཐོབ་པའི་པ་གོར་བེ་རོ་ཙ་ནས་ལྕགས་ཐུར་ཅན་དང་།",
    "བེ་རོ་ཙ་ནའི་འགྱུར་བར་ཁབ་ཅན་དང་གསུམ།",
    "བེ་རོ་ཙ་ནའི་འགྱུར་རོ།",
    "ཡང་རང་བཞིན་གྱིས་སྟོང་ན།",
    "ཡང་རང་བཞིན་གྱིས་སྟོང་ན་འགྲོ་འོང་སོགས་ཀྱི་བྱ་བ་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ནམ་མཁའི་དབྱིངས་སུ་ཡོངས་སུ་དག་པ་ལ་འདུག་པའམ།",
    "ལྕང་འབུམ་མ་ན་མ་བསྡུས་པར་བརྐྱང་ནས་འདུག་གོ།",
    "འགྲེས་འཆོལ་བ་མང་དུ་འདུག་གོ།",
    "སྐབས་དེ་ལ་འགྲེས་འཆོལ་བ་མང་དུ་འདུག་སྟེ།",
    "གསར་པ་ཕལ་ལ་ཡང་བཅུག་ནས་འདུག་གོ།",
    "འགྲེས་འཆོལ་བ་དང་མ་ཚང་པ་མང་རབ་འདུག་པ་མ་བཟུང་ངོ།",
    "འདི་ལྟར་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་དེ་ནི་ཟག་པ་མ་མཆིས་ཤིང་ཁོང་དུ་ཆུད་པ་མ་མཆིས་པ་སྟེ་ཞེས་པ་ནས་སེམས་དེ་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཞེས་སོགས་སོ།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་པ་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོང་དུ་ཆུད་པ་མེད་དོ་ཞེས་པའི་བར་གྱིས་བསྟན་ནོ།",
    "དེ་ལ་སྔགས་ཀྱི་ཚིག་ཡི་གེ་འབྲུ་ལྔ་ཨ་ར་པ་ཙ་ནའོ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་རོ།",
    "ཞར་ལ་བྱེ་བྲག་དུས་གསུམ་ལ་སྦྱར་ནས་མ་བཅིངས་མ་གྲོལ་བར་བསྟན་པའོ།",
    "བྱེ་བྲག་དུས་གསུམ་ལ་སྦྱར་ནས་བཅིངས་གྲོལ་མེད་པར་བསྟན་པ་ནི།",
    "ཉི་ཁྲིལ་འདུག་ཀྱང་འབུམ་རྣམས་ལ་ཆད་པར་སྣང་ངོ།",
    "འགྲིབ་པའམ་གང་བར་མི་གདའོ།",
    "འདི་ལྟར་སྣང་བ་ཐམས་ཅད་རྨི་ལམ་གྱི་རང་བཞིན་ཁོ་ནར་འདུག་སྙམ་པ་ལས་མ་གཡོས་པར་བྱ།",
    "སྟོང་བཞིའི་འོད་གསལ་དངོས་མིན་འདུག་པས་རྣམས་དབྱེ་ཤེས་པ་གལ་ཆེ་བར་སྣང་ངོ།",
    "དེ་ལྟ་བུས་ཀྱང་མ་ལྡོག་པར་ངེས་པར་འཆི་བ་འདུག་ན།",
    "ངོ་བོ་ངོས་བཟུང་དུ་གྲུབ་པ་མི་འདུག་སྙམ་དུ་ཤེས་པར་འགྱུར།",
    "འཇོག་དུས་དམིགས་མེད་དུ་འཇོག་གནས་དུས་ཡེངས་མེད་དུ་གནས།",
    "འདི་འདྲ་ཞིག་འདུག་ཅེས་སུས་ཀྱང་མཚོན་མི་ནུས་ཤིང་ངོ་བོར་གྲུབ་པ་མེད་པ་ཞིག་ཡིན་པས།",
    "བརྟན་གཡོ་སྣོད་བཅུད་ཐམས་ཅད་མེ་ཡི་རང་བཞིན་དུ་གྱུར་ཏེ་བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་དཔུང་ཆེན་པོས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ལ་ཁྱབ་པ་ལྟ་བུ་ལ་སེམས་རྩེ་གཅིག་ཏུ་གཞོལ།",
    "འདུག་སར་མཆོག་གསུམ་རྟེན་ལ་གཙང་སྦྲ་ཆེ་བ།",
    "ཁྲོམ་མང་པོ་ཚོགས་པའི་གསེབ་ཏུ་དེ་འདྲ་མཚན་ལྡན་མ་ཡིད་འོང་མཐོང་བ་དང་འདུག་ཚེ།",
    "ཡུམ་འདུག་སྟེ་རྐང་པ་ཡབ་ཀྱི་རྒྱབ་ཏུ་འཁྲིལ།",
    "སླར་ཡང་རང་ཉིད་ཡི་དམ་སྐུར་གསལ་བའི།",
    "གཏོར་མ་འདིས་ཚིམས་རང་རང་གནས་སུ་དེངས།",
    "ཤར་གྲོལ་རིས་མེད་ཉིན་མཚན་བར་མེད་བླང་དོར་མཐའ་འདས་དགག་བསྒྲུབ་མཉམ་དག་དུས་གསུམ་གྱི་མཚན་མ་བློ་ལས་འདས་ཤིང་།",
    "སློབ་དཔོན་གྱི་སྤྱན་སྔར་འདུག་སྟེ།",
    "སྤྱན་སྔར་འདུག་སྟེ་བླང་བར་བྱ།",
    "གཞན་གྱི་ལུགས་ནི་མང་པོ་འདུག་སྟེ།",
    "ཨོཾ་རུ་རུ་ཕུ་རུ་ཛྭ་ལ་ཏིཥྛ་ལོ་ཙ་ནི་སརྦ་ཨ་ཐ་ས་དྷ་ན་སྭཱ་ཧཱ།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "གནས་དབེན་པར་བདེ་བའི་ིསྟན་ལ་འདུག་སྟེ།",
    "བཛྲ་བེ་རོ་ཙ་ན་ནཱི་ཡེ།",
    "བཛྲ་བེ་རོ་ཙ་ན་ནཱི་ཡེ།",
    "སྐྱེས་ཀྱང་རང་ཞིར་འགྲོའོ།",
    "འགྲོ་འདུག་བསྒོམ་ལ་མ་ཡེངས་པ་ཙམ་གྱིས་ཆོག་གོ།",
    "བྱིང་ན་འདུག་པ་གསེང་བར་བསྒོམ།",
    "འགྲོ་འཆག་ཉལ་འདུག་སྨྲ་ལ་སོགས།",
    "མི་བསྒོམ་རི་ཁྲོད་འགྲིམ་པའི་བྱ་དགའ་ལ་གདམས་པ་ཡིན་འགྲོ་བ་ཀུན་ལ་ཕན་ཐོགས་ཤོག། ལྕི་",
    "ཡོན་ཏན་ཐམས་ཅད་ཁོ་རང་ལ་རང་ཆས་སུ་ཡོད་པ་དང་།",
    "འདུག་པ་དེ་རང་སེམས་ཀྱི་ངོ་བོའོ།",
    "གཤིས་ཀྱི་འདུག་ལ་ཡིན་ཏེ།",
    "རིག་པ་སྣ་། གས་བདེ་བར་འཆར་བར་འདུག་ཨང་སྙམ་པའི་རྣལ་འབྱོར་པ་ལ་ཉམས་སྐྱེས་ཙམ་ན།"
  ]
}