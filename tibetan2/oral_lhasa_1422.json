    "སྦྱོར་བ་ཕྱིན་ཅི་མ་ལོག་པར་བསྒོམས་པ་ལས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་གཏམ་བརྗོད་པ་ཐོབ་པས་སྨྲ་བའི་སྐྱེས་བུ་ཉིད་དུ་གྱུར་པའི་ཡོན་ཏན་འབྱུང་ངོ།",
    "སྦྱོར་བ་ཕྱིན་ཅི་མི་ལོག་པར་བསྒོམས་པ་ལས་དེ་བཞིན་གཤེགས་པས་གྲོགས་མཛད་པ་ཐོབ་པས་མི་ཕྱེད་པ་ཉིད་ཀྱི་ཡོན་ཏན་འབྱུང་ངོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་ཕྲག་མང་པོ་རབ་ཏུ་དགོད་པར་བགྱིའོ།",
    "ཡང་དག་པར་བསྟན་པ་དང་།",
    "ཡང་དག་པར་ལེན་དུ་གཞུག་པ་དང་།",
    "ཕྱིར་མི་ལྡོག་པར་ལུང་བསྟན་པར་རིག་པར་བགྱི་འོ་ཞེས་བྱ་བའི་ཚིག་སྨྲས་སོ།",
    "ཕྱིར་མི་ལྡོག་པར་ལུང་བསྟན་ངཔར་བགྱིའོ་ཞེས་བྱ་བའི་ཚིག་སྨྲས་སོ།",
    "ཕྱིར་མི་ལྡོག་པར་ལུང་སྟོན་པར་འགྱུར་བ་དེ་དག་ལ་ངས་རྗེས་སུ་ཡི་རང་བར་མཛད་དོ་ཞེས་པའི་དོན།",
    "སྦྱོར་བ་ཕྱིན་ཅི་མ་ལོག་པར་བསྒོམས་པས་དེའི་དམ་བཅས་པའི་ཚིག་ལ་རྗེས་སུ་ཡི་རང་བ་ཐོབ་པས།",
    "ཡང་དག་པར་ལེན་དུ་འཇུག་པ་དང་།",
    "ཡང་དག་པར་གཟེངས་བསྟོད་པ་དང་།",
    "ཡང་དག་པར་རབ་ཏུ་དགའ་བ་བྱེད་པར་འགྱུར་རོ་ཞེས་པའི་དོན།",
    "ལ་ལས་རྙེད་པར་མི་འགྱུར་བ་ལགས།",
    "སྦྱོར་བ་ཕྱིན་ཅི་མ་ལོག་པར་བསྒོམས་པས།",
    "ཕྱིན་དྲུག་ལ་ལེགས་པར་སྤྱོད་པར་འགྱུར་བ་དང་།",
    "དྲུག་ཏུ་ངེས་པར་རྟོགས་པར་བྱ།",
    "རབ་འབྱོར་འདི་ལ་བྱང་སེམས་ཆེན་པོས་ཡུམ་ལ་སྤྱོད་པའི་ཚེ་ཚེགས་ཆེན་པོས་ཕྱིན་དྲུག་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་སྟེ་རབ་འབྱོར་དེས་ན་སྤོབས་པ་ཧ་ཅང་ཕྱི་སྟེ་སྐྱེ་བར་འགྱུར་བ་ཡིན་ཏེ།",
    "རབ་འབྱོར་འདི་ནི་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིགས་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་གཞན་ཡང་གླལ་བ་དང་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧རྒོད་པ་དང་ཕན་ཚུན་སྟེག་ཅིང་ཡུམ་འདྲི་བར་འགྱུར་ན།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིགས་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིགས་པར་བྱའོ་ཞེས་པའི་དོན།",
    "སེམས་རྣམ་པར་གཡེང་བ་དང་།",
    "སེམས་ཡི་གེ་གཞན་དང་གཞན་ལ་ཆགས་ཤིང་ཡུམ་འཛིན་པ་དང་འཆང་བ་དང་ཀློག་པ་དང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པར་འགྱུར་ན།",
    "རབ་འབྱོར་གཞན་ཡང་བྱང་སེམས་ཆེན་པོ་འདི་སྙམ་དུ་བདག་ཡུམ་འདིར་ལུང་མ་བསྟན་ཏོ་སྙམ་དུ་སེམས་པར་འགྱུར་ཞིང་མ་དད་པའི་སེམས་ཀྱིས་སྟན་ལས་ལངས་ནས་འགྲོ་བར་འགྱུར་ན།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིགས་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་སྒྲུབ་པའི་ཡུམ་བོར་ཞིང་།",
    "ཡལ་ག་དང་འདབ་མ་དང་ལོ་མ་གཟུང་བར་བྱ་བར་སེམས་པར་འགྱུར་བ་དག་སྟེ།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིགས་པར་བྱའོ།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "དཔེར་ན་མི་ལ་ལ་ཞིག་གླང་པོ་ཆེ་གཉེར་བར་གྱུར་ལ་དེས་གླང་པོ་ཆེ་རྙེད་ནས་གླང་པོ་ཆེའི་རྗེས་བཙལ་བར་བྱ་བར་སེམས་པར་གྱུར་ན་རབ་འབྱོར་དེ་ཇི་སྙམ་དུ་སེམས།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་འདི་ལྟ་སྟེ་དཔེར་ན་མི་ཞིག་རྒྱ་མཚོ་ཆེན་པོ་བལྟ་འདོད་པར་གྱུར་ཏེ་རྒྱ་མཚོ་ཆེན་པོ་མཐོང་ནས།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་དང་མཉམ་པ་ཞིག་བྱ་བར་འདོད་པས་ཉི་མ་དང་ཟླ་བའི་གཞལ་མེད་ཁང་ལས་ཚད་འཛིན་པའི་སྐྱེས་བུ་དེ་མཁས་པའི་རིགས་ཡིན་ནམ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ།",
    "འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་ཁ་དོག་དང་དབྱིབས་ཀྱང་དེ་འདྲ་སྟེ་ཁྱད་པར་མེད་དོ་ཞེས་སྙོམས་པར་བྱེད་ན་ཞེས་པ་ནས།",
    "རབ་འབྱོར་འདི་ཡང་བྱང་སེམས་ཆེན་པོས་བདུད་ཀྱི་ལས་སུ་རིགས་པར་བྱའོ་ཞེས་པའི་དོན།",
    "གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧འཁྲུག་པ་མེད་ཅིང་བརྗོད་དུ་མེད་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཡུམ་ནི་བྲི་བར་ནུས་པ་མ་ལགས་སམ།",
    "ཡུམ་ནི་ངོ་བོ་ཉིད་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་པ་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་གྱི་ངོ་བོ་ཉིད་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "འཆད་པ་པོ་དང་ཉན་པ་པོ་དག་སྔ་མ་དང་ཕྱི་མ་གང་ཡང་རུང་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧བ་དང་འབྲེལ་པས་འདུན་པའི་ཡུལ་ཐ་དད་པས་ཉམས་པ་དང་།",
    "འདི་ཡང་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ།",
    "ཉན་པ་པོ་སྔ་མ་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "འདི་ཡང་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ།",
    "འདི་ཡང་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རིག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ཉན་པ་པོ་དང་སྨྲ་བ་པོ་གོ་བཟློག་ནས་གསུངས་པའི་དོན།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "རྣམ་པར་སྤྲོས་པས་གོ་བ་ཉིད་དང་།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན་གཟུངས་ཐོབ་པ་དང་མ་ཐོབ་པ་དག་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱ་བར་མི་འདོད་པར་གྱུར་ན་འདི་ཡང་བདུད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "དེ་བཞིན་དུ་བཟློག་སྟེ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "གཟུགས་ཀྱི་ཁམས་ནི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་འདི་ལྟར་བདེའོ།",
