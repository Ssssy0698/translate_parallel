    "སུ་ནིཏ་ནི་ཧ་ཅང་གི་དབུལ་ཞིང་ཕོངས་པ་ཞིག་ཡིན་སྟབས།",
    "དེར་བརྟེན་ཁོང་གིས་དུས་རྒྱུན་དུ་ནས་ཆེས་ཐབས་སྡུག་ཅིང་ཡིད་མུག་པ་སྟེ།",
    "ཉིན་གཅིག་ཁོང་གིས་ལུས་ལ་རལ་ཧྲུལ་དུ་སོང་བའི་གྱོན་གོས་ཆུང་ངུ་ཞིག་གོན་ཏེ།",
    "གཟུགས་པོར་དྲེག་པས་ཁེངས་ཤིང་རྡུལ་ནག་འཛར་བཞིན་ཐལ་རྡུལ་དང་གད་སྙིགས་ཕྱག་སྟེ་གཙང་སྦྲ་བྱེད་སྐབས།",
    "ཁོང་གིས་མྱུར་སྟབས་ངང་སྲང་ལམ་གྱི་གད་སྙིགས་དང་ཐལ་རྡུལ་རྣམས་བསྒྲུགས་ཏེ་སྦེ་པོར་བླུགས་ནས་དེ་མགོ་ལ་འཁུར་བཞིན་གད་སྙིགས་གཡུག་སར་ཕྱིན།",
    "ལམ་ཟུར་ནས་ཡིབ་སའི་གནས་མ་རག་པར་སྒལ་བ་གྱང་ཟུར་གྱི་རྩིག་པ་ལ་གྱུར་ཏེ་ཡར་ལངས་ནས་བཅོམ་ལྡན་འདས་ལ་དད་གུས་ཀྱིས་ཐལ་མོ་སྦྱར་ནས་བསྡད།",
    "ཁོང་གིས་སྙན་ཞིང་འཇེབས་པའི་གསུང་དབྱངས་ཀྱི་གདངས་ལ་དྲངས་ཏེ་སྨྲས་པ།",
    "ཁྱོད་ཀྱིས་ལས་ཀ་འདི་མཚམས་བཞག་སྟེ་རབ་ཏུ་བྱུང་བར་འདོད་དམ་ཞེས་བཀའ་འདྲི་གནང་བར།",
    "སུ་ནི་ཏ་ལ་མཚོན་ན་དེ་སྔོན་མི་སུ་གཅིག་གིས་ཀྱང་དེ་འདྲའི་གླེང་མོལ་བྱེད་མྱོང་མེད་སྟབས།",
    "ཁོང་གི་སེམས་ལ་བླ་ན་མེད་པའི་དགའ་བདེ་ཡིས་ཁེངས་ཤིང་མིག་ཟུང་མཆི་མས་བརླན།",
    "དུས་ནམ་ཡིན་ཡང་ཁོང་གིས་སྐྱེ་བོ་གཞན་གྱི་དྲུང་ནས་བཀའ་བཀོད་ལ་ཉན་རྐྱང་བྱེད་པ་ལས་བྱམས་བརྩེའི་ཚིག་གཅིག་ཀྱང་ཐོས་མྱོང་མེད་པས།",
    "ངས་དུས་རྒྱུན་བཀའ་བཀོད་ལ་སྒུག་རྐྱང་བྱེད་པ་ལས་ང་ལ་བྱམས་བརྩེའི་ཚིག་གིས་སྐྱོང་མཁན་གཅིག་ཀྱང་མེད།",
    "ཁོང་གིས་ཉན་ཐོས་ཀུན་དགའ་བོ་ལ་གསུང་གནང་སྟེ།",
    "མུན་ནག་གི་སྤྲིན་རུམ་ཁྲོད་ནས་སླར་ཡང་བཅོ་ལྔའི་དུང་ཟླ་དང་སྐར་ཚོགས་ཁྲ་ལྷམ་མེར་ཤར་བ་ཇི་བཞིན།",
    "སྤྱིར་བཏང་གི་འགྲོ་བ་མིའི་རྣམ་དཔྱོད་ཀྱི་མཁྱེན་ཚད་ལས་ཕ་རོལ་ཏུ་སོན་ཏེ་འཇིག་རྟེན་གྱི་བྱ་དངོས་ཡོད་དོ་ཅོག་ཁོང་དུ་ཆུད་པར་མ་ཟད།",
    "ཁོང་གི་ཐུགས་མཁྱེན་པའི་ཡེ་ཤེས་དེ་ཡང་འབད་པ་མེད་པར་མདུན་ནས་མདུན་དང་བླ་ནས་བླ་རུ་འཕེལ་བར་གྱུར་ཏོ།",
    "ངའོ་སྙམ་པའི་མིང་ཙམ་གྱི་བདག་དེ་གཟིགས་ཤིང་།",
    "ཕན་མེད་གནོད་འབྱུང་གི་རང་བཞིན་ཅན་གྱི་དངོས་པོ་དག་ལ་ཡིད་ཆགས་ཤིང་སྲེད་དེ།",
    "འཕྲལ་མ་ཉིད་དུ་འཛད་མཐའ་མེད་ཅིང་ཉེན་ཚབས་ཆེ་བའི་འཁྲུལ་སྣང་གི་ཕུང་པོ་དག་སྐྲུན་པར་བྱེད།",
    "རང་རྒྱུད་ཀྱི་མུན་ནག་སྟུག་པོའི་མ་རིག་པ་དེ་ཡང་ལྷག་མེད་དུ་བཅོམ་ནས་འཁྲུལ་སྣང་གི་ཕུང་པོ་དག་རང་ཡལ་དུ་འགྲོའོ།",
    "དེ་ལྟར་ལུས་ཁང་གི་རྒྱུ་ཆ་སྲེད་ལེན་དག་ལེགས་པར་བཅོམ་སྟེ།",
    "ནང་གི་ཉམས་རྟོགས་གོང་མཐོར་འཕེལ་བ་ལ་ཅུང་ཟད་ཀྱང་ཕན་ཐོགས་མེད་པས་སོ།",
    "ནང་གི་ཉམས་རྟོགས་གོང་མཐོར་འཕེལ་བ་ལ་ཡང་ཕན་ཐོགས་ཡེ་ནས་མེད།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་དུལ།",
    "དེ་དུས་ཁོང་གིས་སངས་རྒྱུས་ཀྱི་གོ་འཕང་འཚོལ་བཞིན་པའི་སྐབས་ཡིན་སྟབས་ཞལ་བཞེས་མ་གནང་།",
    "ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་ཞུགས་འབུལ་ལམ་སྦྱིན་སྲེག་གི་ཆོ་ག་སྤངས་པ་ཡིན།",
    "ཞེས་ཞུས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ཀྱི་པད་མོ་ལ་མགོ་བོས་གཏུགས་ཏེ་སྨྲས་པ།",
    "ང་ནི་ཁོང་གི་ཉན་ཐོས་སོ་ཞེས་གསུངས་པས།",
    "འོད་མའི་ཚལ་ཞེས་བྱ་བ་ཧ་ཅང་གི་ཁ་ཁུ་སིམ་ཞིང་རབ་ཏུ་ཕྱུག་པའི་སྡུག་སྡོང་གིས་ལེགས་པར་བརྒྱན་པའི་སྐྱེད་ཚལ་དེ་ཕུལ་བས།",
    "འབྱོར་ཕྱུག་ཕུན་སུམ་ཚོགས་པའི་ཁྱིམ་བདག་ཅིག་གི་བུ་མོ་སྟེ་གཏོང་བ་ཡངས་ཤིང་དད་སྟོབས་ཆེ་བ་ཞིག་ཡིན།",
    "ཕྱིས་སུ་མོ་རང་ལོ་ན་བཅོ་ལྔར་སོན་སྐབས།",
    "མཛངས་མ་འདིས་ངེད་ཅག་གི་སློབ་དཔོན་གྱི་ཆུང་མ་བྱས་ན་ཅི་འདྲའི་འོས་ཤིང་འཚམ་པར་འདུག་སྙམ་དུ་བསམས་སོ།",
    "དེ་ནས་བྲམ་ཟེ་དེ་རྣམས་ཀྱིས་གཞོན་ནུ་མ་ཝི་ས་ཁ་དང་ཁོང་ཚོའི་སློབ་དཔོན་པུན་ན་ཝད་དྷ་ན་རྣམ་གཉིས་ཀྱི་གཉེན་སྒྲིག་ལ་གྲ་སྒྲིག་གི་སྟ་གོན་བྱས།",
    "གཞོན་ནུ་མ་ཝི་ས་ཁ་ཡི་གཉེན་སྒྲིག་གི་ཉིན་མོར།",
    "རྣམ་དཔྱོད་ཕུལ་དུ་བྱུང་བའི་རང་གི་ཡབ་ཆེན་གྱིས།",
    "སྐྱེ་བོ་གཞན་གྱི་མདུན་དུ་རང་གི་ཁྱོ་ག་དང་ཡང་ན་ཁྱོ་གའི་ཕ་མ་སྟེ་གྱོས་སྒྲུག་གཉིས་ལ་སྨད་ར་སོགས་བྱེད་མི་ཉན་ཞིང་།",
    "ཐ་ན་ཁོང་ཚོའི་ཞན་ཆ་དང་ནང་གི་རྩོད་རྙོག་ཙམ་ཡང་ཕྱི་མིའི་སར་གང་བྱུང་དུ་སྒྲོག་མི་ཉན།",
    "རང་གི་གཉེན་ཚན་སོགས་ཀྱིས་གཡར་བའི་དངོས་པོ་ཚུར་མི་སྐྱེལ་ནའང་།",
    "ཁོང་ཚོར་གང་མཁོ་བའི་ཅ་དངོས་ངེས་པར་དུ་གཡར་དགོས།",
    "རང་ཉིད་ཀྱི་ཁྱོ་ག་དང་གྱོས་སྒྲུག་སོགས་ཕེབས་སྐབས་རྐུབ་སྟེགས་སམ་གདན་ལས་ཡར་ལངས་ཏེ་ཁོང་ཚོར་གུས་བཀུར་ཞུ་དགོས།",
    "རང་གིས་ཟ་མ་མ་ཞུས་པའི་སྔོན་དུ།",
    "རང་གི་ཁྱོ་ག་དང་གྱོས་སྒྲུག་སོགས་ལ་ཞལ་ལག་ཕུལ་ཡོད་མེད་ལེགས་པར་ལྟ་དགོས་པར་མ་ཟད།",
    "ཉིན་གུང་གི་དུས་སུ་ཉལ་ན་གཏན་ནས་མི་རུང་བ་ཡིན།",
    "རང་གི་གྱོས་སྒྲུག་དང་ཁྱོ་ག་ལ་འབྲེལ་བ་གཟབ་ནན་བྱེད་དགོས།",
    "གཞོན་ནུ་མཝི་ས་ཁ་མཉན་ཡོད་དུ་མནའ་མར་སླེབས་པའི་ཉིན་མོ་དེ་ནས་བཟུང་།",
    "ཉིན་ཞིག་གཞོན་ནུ་མ་ཝི་ས་ཁའི་གྱོས་པོ་མི་ག་ར་ཡིས་གསེར་ཕོར་ཞིག་ཏུ་འབྲས་ཐུག་མངར་མོ་འཐུང་བཞིན་པའི་སྐབས།",
    "དགེ་སློང་ཞིག་ཁོང་ཚང་གི་ཁྱིམ་དུ་འཛུལ་ནས་བསོད་སྙོམས་བསླངས་པ་ན།",
    "གཞོན་ནུ་མོཝི་ས་ཁ་ཡིས་གུས་པའི་སྒོ་ནས་དགེ་སློང་དེ་ལ།",
    "ངའི་གྱོས་པོས་བཞེས་བཞིན་པ་དེ་ནི་འབྲས་ཐུག་རྙིང་པ་ཞིག་རེད།",
    "ཁོང་གི་རྗེས་སུ་འབྲངས་ཏེ་དད་གུས་གཡོ་བ་མེད་པའི་སྒོ་ནས་མཐུན་འགྱུར་ཞུ་བཞིན་པ་སོགས་གྱོས་པོ་མི་ག་རའི་བློར་མ་བབ་པས།",
    "ཁོང་གིས་གཞོན་ནུ་མ་ཝི་ས་ཁ་ལ་མི་དགའ་བའི་སེམས་འཛིན་ཆེན་པོ་བྱེད་ཀྱི་ཡོད།",
    "དེར་བརྟེན་ཁོང་གིས་སྔོན་ཚུད་ནས་རང་གི་བུ་དང་མནའ་མ་གཉིས་ཀྱི་གཉེན་སྒྲིག་ལ་གཏོར་བཤིག་བྱེད་རྒྱུའི་གོ་སྐབས་བཙལ་ན་ཡང་།",
    "ཝི་ས་ཁ་ཡིས་ངའི་ཁྱིམ་ཚང་ལ་ངན་སྨྲས་ཀྱིས་དམའ་ཕབ་སྟེ་ཞབས་འདྲེན་ཞུས་སོང་བསམ་ནས་དེའི་གོ་སྐབས་དམ་འཛིན་གྱིས།",
    "གཞོན་ནུ་མ་ཝི་ས་ཁ་ཁོང་ཚོའི་ཁྱིམ་ཚང་ནས་ཕྱིར་སྐྲོད་བྱེད་རྒྱུའི་བཀའ་རྒྱ་བཏང་།",
    "གལ་སྲིད་ངའི་བུ་མོ་ལ་སྐྱོན་ཆ་འདྲ་འདུག་སྙམ་ན་བརྟག་དཔྱད་ཞིབ་འཇུག་བྱེད་རོགས་གྱིས།",
    "མི་ག་རས་ཀྱང་མོ་རང་གི་ཞུ་བ་དང་ལེན་བྱས་ཏེ་རིགས་རུས་ཀྱི་དཔང་མི་བརྒྱད་བོས་ནས་ན་རེ།",
    "གལ་སྲིད་མོ་རང་ལ་སྐྱོན་ཆ་འདྲ་ཡོད་ཚེ་ཁྱིམ་ཚང་འདི་ནས་ངེས་པར་དུ་ཕྱིར་སྐྱོད་བྱེད་རྒྱུ་ཡིན།",
    "ངའི་གྱོས་པོས་བསོད་སྙོམ་དུ་ཕེབས་པའི་དགེ་སློང་ཁོང་སྣང་མེད་དུ་བཞག་སྟེ་མུ་མཐུད་འབྲས་ཐུག་འཐུང་ནས་བསྡད་སོང་།",
    "ཕྱིས་སུ་ཡང་གྱོས་པོ་ཁོང་གིསདེ་ལྟའི་གོ་ནོར་ལན་མང་ཤོར་ནའང་།",
    "རིམ་བཞིན་གྱོས་པོ་ཁོང་གིས་རང་ཉིད་ཀྱི་སྐྱོན་ཆ་ངོས་ཟིན་པ་མ་ཟད།",
    "གསུང་གི་གདམས་པ་ལ་ཉན་པས་མི་ག་ར་ཡིས་རྒྱུན་དུ་ཞུགས་པའི་གོ་འཕང་ཐོབ་བོ།",
    "གཞོན་ནུ་མ་ཝི་ས་ཁ་ཡིས་རང་གི་རྣམ་དཔྱོད་ཀྱི་རྩལ་དང་ཕུལ་དུ་བྱུང་བའི་བཟོད་སྲན་ལ་བརྟེན་ནས།",
    "རང་ཉིད་ཀྱི་ཁྱོ་གའི་ཁྱིམ་ཚང་དེ་ཡང་དགའ་སྤྲོ་དང་འོད་སྣང་གིས་ཁེངས་པའི་ནང་པའི་ཁྱིམ་ཚང་ཞིག་ཏུ་བསྒྱུར་ཐུབ་པ་བྱུང་།",
    "སྤྱིར་བཏང་གཞོན་ནུ་མ་ཝི་ས་ཁ་ནི་ཧ་ཅང་གི་གཏོང་ཕོད་ཡངས་ཤིང་།",
    "དེ་ནི་མོ་རང་ལ་མཚོན་ན་མི་ཚེའི་ནང་གི་ཆེས་བདེ་སྐྱིད་ཆེ་ཤོས་དེ་རེད།",
    "བུད་མེད་རྣམས་ལ་ཚང་དགོས་པའི་ཡོན་ཏན་རྣམ་པ་བརྒྱུད་གསུངས་ཤིང་།",
    "ཡོན་ཏན་དེས་རང་གི་ཚེ་འདི་ཕྱིའི་དོན་དང་གཞན་གྱི་དོན་ཡང་རྒྱུ་ཆེར་འགྲུབ་བོ་ཞེས་གསུངས།",
    "བུད་མེད་རྣམས་ཀྱིས་རང་ལ་འཁྲི་བའི་ལས་ཀ་ལེགས་པོར་བྱེད་རྒྱུ།",
    "གཡོག་པོ་གཡོག་མོར་ལྟ་རྟོག་གནང་རྒྱུ་རང་གི་ཁྱོ་ག་ལ་གུས་ཞབས་དགོས་པ།",
    "ཁོང་གི་རྗེས་སུ་འབྲང་སྟེ་ཁོ་ལ་བསྟོད་བསྔགས་བྱེད་མཁན་ཡང་མི་ཉུང་བ་ཞིག་ཡོད།",
    "ཁོང་གིས་བྱམས་དང་བརྩེ་བའི་གསུང་ངག་གི་སྒོ་ནས་ན་རེ།",
    "སྣ་སྒྲོག་གིས་ཁོང་གི་ཞབས་ཀྱི་ཐལ་རྡུལ་རྣམས་རང་གི་སྤྱིབོར་གཏོར་ཞིང་།",
    "བཅོམ་ལྡན་འདས་ལ་ཁ་ཕྱོགས་ནས་ཕྱིར་སྣུར་གྱིས་ཐག་རིང་སར་སོང་ནས་བསྡད་པ་སོགས།",
    "སློབ་དཔོན་གཞན་གྱི་མན་ངག་ལ་ལྟོས་མི་དགོས་པར་རང་གི་འབད་བརྩོན་གྱིས་དགྲ་བཅོམ་པའི་གོ་འཕང་འཐོབ་པར་འགྱུར་རོ།",
    "སྲས་མོ་ཁེ་མ་ནང་པར་བསྒྱུར་བའི་སྐོར་ནི་ཁྱད་དུ་འཕགས་པའི་དཔེ་མཚོན་དཀོན་པོ་ཞིག་ཀྱང་ཡིན།",
    "སྲས་མོ་ཁེ་མ་ནི་ལྷིང་འཇགས་པའི་མཚན་དུས་ཀྱི་མཚེའུ་ལ་བཅོ་ལྔའི་དུང་ཟླ་ཤར་བ་བཞིན།",
    "སྣ་མའི་མེ་ཏོག་གི་དྲི་ངད་དེ་ཡང་བར་སྣང་ཀུན་ཏུ་ཁྱབ་བཞིན་འདུག་གོ།",
    "ཞོགས་བྱེའུདག་གིས་སྙན་ཞིང་འཇེབས་པའི་གྲེ་འགྱུར་དབྱངས་སུ་འཐེན་པ་ལས་ཀྱང་ཆེས་ཡིད་དུ་འོང་བ་ཞིག་སྟེ།",
    "མ་ཟད་གསུང་སྐད་དེའི་ཚིག་འབྲུ་དེ་དག་ཀྱང་རེ་རེ་ནས་ཤེས་རབ་ཀྱི་ཚིག་ཏུ་གྲུབ་བོ།",
    "མོ་རང་གཞོན་ནུ་མ་དེའི་མཛེས་སྡུག་གི་འགྱུར་བག་ལ་ཧང་སངས་ཏེ་རང་ཉིད་ཀྱི་སྤུན་ཟུང་ལས་ཀྱང་གཞོན་ནུ་མ་དེར་ཡི་རང་བསྔགས་བརྗོད་ཀྱི་འོད་མདངས་འཚེར།",
    "སྲས་མོ་ཁེ་མ་ཡི་སེམས་སུ།",
    "ཞལ་གྱི་མཆུ་སྒྲོས་དང་སྣ་དང་དཔུང་པ་མཛུབ་མོ་དང་བཅས་པ་ཇི་འདྲའི་བྱོན་ལེགས་པ་ཞིག།",
    "གང་ལྟར་གཞོན་ནུ་མ་ཁོང་ནི་སྔོན་ཆད་ངས་མཐོང་བའི་མཛེས་སྡུག་གི་ལང་ཚོ་རྒྱས་པའི་གཞོན་ནུ་མ་དག་ལས་ཀྱང་ཆེས་མཛེས་སྡུག་ལྡན་ལ།",
    "ཐ་ན་ཁོ་མོ་རང་ཉིད་ལ་བལྟོས་ནའང་ཇི་འདྲའི་ཡིད་དུ་འོང་བ་ཞིག་རེད་ཨང་སྙམ་སྟེ།",
    "ཡུད་ཙམ་རིང་སྲས་མོ་ཁེ་མ་ཡིས་རང་གི་མིག་གཉིས་འཁྲུལ་གྱི་ཡོད་པ་མིན་ནམ་སྙམ་པ་ཞིག་བྱུང་།",
    "འོ་ན་སྲས་མོ་ཁེ་མ་ཡིས་གཞོན་ནུ་མ་དེའི་ལང་ཚོའི་རྒྱུད་རིམ་མཐོང་ཡོད་དམ་ཞེ་ན།",
    "ད་དུང་མཉེན་ལྕུག་བརྗིད་བག་ལྡན་པའི་རྐང་ལག་རྣམས་ཀྱང་སྐམ་ལ་རིད་པའི་ཉམ་ཐག་པར་གྱུར་ཏེ་སྐད་ཅིག་ཙམ་གྱི་རིང་གཞོན་ནུ་མ་དེ་ནི་ལོ་ན་བརྒྱད་ཅུར་སོན་པའི་རྨོ་མོ་ཞིག་ཏུ་གྱུར་ནས་ས་ལ་འགྱེལ།",
    "དེ་ལྟར་སྲས་མོ་ཁེ་མ་ཡིས་རྒས་ཤིང་འཁོགས་པའི་རྨོ་མོ་དེ་ཤི་ནས་མཐར་རུས་གོང་རྣམས་ཀྱང་འཐོར་ཞིག་ཏུ་ཕྱིན་ཏེ་ཐལ་རྡུལ་དུ་གྱུར་པའི་བར་གྱི་ཆད་རིམ་རྣམས་དངོས་སུ་མཐོང་མ་ཐག།",
    "མོ་རང་གིས་ཀྱང་ཉིན་ཞིག་རང་ཉིད་རྒས་ཏེ་མཐར་ཤི་རྒྱུ་ཡིན་པ་ཤེས་ཤིང་།",
    "མིའི་མི་ཚེ་དང་རང་ལུས་སོགས་མི་རྟག་པའི་རང་བཞིན་ཅན་དུ་རྟོགས་ནས་རང་གི་ཕྱིའི་རྣམ་པ་ལ་བརྟེན་པའི་ང་རྒྱལ་དེ་ཡང་ཞི་བར་གྱུར།",
    "ཧ་ཅང་གི་གཏོང་ཕོད་ཡངས་པ་ཞིག་ཡིན་པར་བརྟེན་ཁོང་ལ་མགོན་མེད་ཟས་སྦྱིན་ཞེས་པའི་མཚན་དེ་ཐོགས་པ་རེད།",
    "སྐྱེད་ཚལ་དེའི་རིན་གོང་ནི་ཉོས་པའི་ས་གཞི་དེའི་རྒྱ་ཁྱོན་ལ་གསེར་གྱི་ཊམ་ཀས་བཀབ་སྟེ་དེའི་ཚད་ཀྱིས་གཞམ་ནས་ཉོས་པ་ཞིག་གོ།",
    "ཁོང་གིས་སྦྱིན་པའི་སྐོར་གྱི་བཀའ་ཁྲིད་དེའི་ནང་།",
    "བསླབ་པའི་གཞི་ལྔ་པོ་དེས་ང་ཚོའི་ལུས་ངག་གི་ལས་ངན་མང་དག་ཅིག་འཇོམས་ཐུབ་བོ།",
    "འོན་ཀྱང་ཚོགས་རླབས་པོ་ཆེ་སྡུད་པར་བྱེད་པའི་ཐབས་ལམ་མཆོག་ཏུ་གྱུར་པ་ནི།",
    "འགྱུར་བའི་རང་བཞིན་ཅན་གྱི་ཕྱིའི་དངོས་པོའི་ཡིན་ལུགས་ལ་བལྟས་ནས་ནང་གི་ཉམས་རྟོགས་གོང་མཐོར་གཏོང་རྒྱུ་དེ་ཡིན་ནོ།",
    "རིགས་བཞིའི་བདེ་བ་ལས་བརྩམས་པའི་གསུང་གི་གདམས་པ་ནི།",
    "མགོན་མེད་ཟས་སྦྱིན་ནི་རང་གི་སྐུ་ལུས་ནས་འོད་ཟེར་ཁྲོམ་ཁྲོམ་དུ་འཕྲོ་བཞིན་པ་ཞིག་ཡོད་སྟབས་ཧ་ཅང་གི་སྤོབས་སེམས་ཆེན་པོ་དང་ལྡན་པ་ཞིག་ཀྱང་ཡིན།",
    "བྲམ་ཟེ་ཁོང་ལ་རང་གི་ཞིང་ཁར་ས་ཞིང་འདེབས་ལས་སོགས་རྨོས་རྒྱག་མཁན་གྱི་ཞིང་ལས་པ་ལྔ་བརྒྱ་ཡོད་པས།",
    "ཁོང་གིས་ཞིང་ལས་པ་རྣམས་ལ་འབྲས་ཐུག་བགོ་འགྲེམས་བྱེད་བཞིན་པའི་སྐབས།",
    "ཡང་མགོ་རྨོངས་པའི་བྲམ་ཟེ་དེ་ན་རེ།",
    "ཁྱོད་ཀྱིས་ཞིང་ཁར་ས་བོན་འདེབས་ལས་བྱེད་ཀྱིན་ཡོད་ཅེས་གསུང་ནའང་།",
    "ཁོ་བོས་ཁྱོད་ཀྱིས་ས་བོན་འདེབས་ལས་བྱས་པ་གཏན་ནས་མཐོང་མ་མྱོང་།",
    "ངས་ཟས་དང་ལུས་ངག་གི་ཉེས་པ་རྣམས་སྲུང་སྡོམ་བྱས་ཤིང་བདེན་པ་བདར་ཏེ་ཡིད་ཀྱི་ཞིང་ཁ་རུ་སྐྱེས་པའི་རྩྭ་ཡན་དག་གཙང་བཟོ་བྱས་པས།",
    "མཐར་དེ་དག་གི་འབྲས་བུར་འཆི་བ་མེད་པའི་གོ་འཕང་ཐོབ་པར་གྱུར།",
    "བྲམ་ཟེ་དེས་རང་གི་སྐྱོན་དང་ནོར་འཁྲུལ་ངོས་ཟིན་ཏེ་ན་རེ།",
    "ཁྱེད་ནི་འཆི་བ་མེད་པའི་གོ་འཕང་གི་སྟོན་ཐོག་ཐོབ་པའི་ཆ་ནས་ཞིང་པ་ཡིན་ལགས་ན་ད་ཁྱེད་ཀྱིས་འོ་འབྲས་ཐུག་པ་འདི་བཞེས་རོགས་གནང་།",
    "ཞེས་ལྷུང་བཟེད་ཆེན་པོ་ཞིག་གི་ནང་འོ་འབྲས་ཐུག་པ་གང་བླུགས་ཏེ་ཕུལ་བར།",
    "གཞོན་ནུ་མ་། མ་གན་དི་ཡ་ཞེས་པའི་གཞོན་ནུ་མ་དེ་ནི་ཕྱུག་བདག་མང་པོས་མནའ་མར་སློང་འདོད་པའི་བུད་མེད་མཛེས་མ་ཞིག་ཡིན།",
    "འོན་ཀྱང་མོ་རང་གི་ཕ་མ་གཉིས་ཀྱིས་དུས་ནམ་ཡིན་ཡང་གཉེན་དུ་སློང་མཁན་ཚོ་རང་ཉིད་ཀྱི་བུ་མོ་ལ་འཚམ་པོ་མི་འདུག་སྙམ་སྟེ་ཁས་ལེན་བྱེད་ཀྱི་མེད།",
    "ཕ་མ་གཉིས་ཀྱིས་མོ་རང་ལ་འོས་ཤིང་འཚམ་པའི་བཟའ་ཟླ་ཞིག་རྙེད་ནའང་།",
    "མོས་རྒྱལ་སྲས་ཤིག་ཡིན་ན་མ་གཏོགས་སྤྱིར་བཏང་གི་བཟའ་ཟླ་དཀྱུས་མ་ཞིག་དང་ལེན་བྱེད་ཀྱི་མེད།",
    "ཁོང་གིས་གཞོན་ནུ་མ་མ་གན་དིའི་ཕ་མ་གཉིས་ཀྱི་ནང་གི་རྟོག་པ་སད་དེ།",
    "ཁོང་གི་སྐུའི་མཛེས་ཉམས་དང་ཡ་རབས་ཞི་དུལ་གྱི་སྤྱོད་ལམ་དེས།",
    "ཁྱེད་ནི་ངའི་བུ་མོ་ལ་འོས་ཤིང་འཚམ་པའི་བཟའ་ཟླ་སྐྱོན་མེད་ཅིག་ཏུ་ངེས་པས།",
    "ངས་རང་གི་བུ་མོ་ཁྲིད་དེ་ཁྱེད་ལ་སྤྱན་འབུལ་མ་ཞུས་བར་དུ་ཁྱེད་ཀྱིས་གནས་འདི་ནས་སྒུག་རོགས་གནང་།",
    "དེ་བཞིན་ངའི་བུ་མོ་ཡང་ཁྱེད་ལ་འོས་ཤིང་འཚམ་པར་ཡོད།",
    "ཁོང་གི་དྲི་ལན་གྱི་ཚབ་ཏུ་ས་གཞི་ཆེན་པོའི་སྟེང་ཞབས་རྗེས་ཤིག་བཞག་སྟེ་བྱོན་ནོ།",
    "བྲམ་ཟེ་ཁོང་ལ་དགའ་སྣང་གི་ཚོར་བ་རབ་ཏུ་རྒྱས་ཤིང་བཀྲ་ཤིས་པའི་གནས་ཚུལ་དེ་རང་གི་ཆུང་མ་ལ་མོལ་བཞིན་བུ་མོ་ལ་སྨྲས་པ།",
    "ངའི་བརྩེ་བའི་བུ་མོ།",
    "ཁྱོད་ཀྱིས་མྱུར་མོར་གྱོན་གོས་གོན་དང་།",
    "དེ་རིང་ངས་ཁྱེད་ལ་འོས་ཤིང་འཚམ་པའི་བཟའ་ཟླ་ཁྱད་པར་བ་ཞིག་མཐོང་སོང་།",
    "མོ་རང་གིས་ཞབས་རྗེས་དེའི་རྟགས་དང་མཚན་མ་ལ་བརྟགས་ཏེ་ན་རེ།",
    "འཇིག་རྟེན་གྱི་བདེ་བའམ་འདོད་པའི་བདེ་བ་ཡོངས་སུ་སྤངས་པའི་སྐྱེས་མཆོག་ཁྱད་པར་བ་ཞིག་གི་ཞབས་རྗེས་ཡིན་པར་སྙམ།",
    "ཁྱོད་ཀྱིས་དེ་སྔོན་ཆུ་འཁྱིལ་ནང་དུ་ཆུ་སྲིན་དང་།",
    "ཁང་པའི་དཀྱིལ་ན་ཇག་ཚོགས་ཀྱང་མཐོང་གི་ཡོད།"
  ]
}