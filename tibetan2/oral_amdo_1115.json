    "ཞེས་བརྡ་ལན་ཞིག་བཞག་སྟེ་མོ་རང་ཕ་ཁྱིམ་ཕྱོགས་སུ་གཏད་ནས་ཕྱིན།",
    "དེའི་དགོང་མོ་ཁྱོ་ག་ཕྱིར་རང་ཁྱིམ་དུ་ལོག་སྐབས།",
    "ཁྱོད་ཀྱི་ཆུང་མ་མོ་རང་གི་ཕ་མའི་ཁྱིམ་དུ་ཕྱིན་སོང་།",
    "དེ་ནས་ཁོང་མྱུར་སྟབས་ངང་མོ་རང་གི་རྗེས་ཟིན་པར་བརྒྱུགས་ཏེ།",
    "ཨུཏ་པ་ལས་ཁས་ལེན་མ་བྱས་པར་ཡུལ་ལུང་གཞན་པ་ཞིག་ཏུ་སླེབས་པའི་བར་མུ་མཐུད་ཕྱིན་པ་ན་ཁྱོ་གས་ཀྱང་མོ་རང་གི་རྗེས་དེད་ནས་སོང་།",
    "དེ་ཙ་ན་མོ་རང་ལ་སྐྱེ་གཟེར་རམ་ཕྲུ་གུ་བཙའ་ཁའི་ན་ཟུག་ལངས་ཏེ་ཅུང་མ་འགོར་བར་བུ་ཞིག་སྐྱེས།",
    "དེ་ནས་མོའི་བསམ་པར།",
    "ཡང་བསྐྱུར་མོ་རང་ཕྲུ་གུ་ཞིག་བཙའ་བ་ལ་མངོན་དུ་ཕྱོགས་པས།",
    "ཁྱོ་གས་ཀྱང་སྔར་ལྟར་རྗེས་འདེད་ཀྱིས་མོའི་སྡུན་བཀག་སྟེ།",
    "ཕྱིར་རང་ཁྱིམ་དུ་ལོག་དགོས་པའི་ཞུ་བ་ཇི་ཙམ་བྱས་ཀྱང་མོས་ཁས་ལེན་མ་བྱས་པས།",
    "དེ་སྔོན་ནང་བཞིན་མོའི་རྗེས་དེད་ནས་ཕྱིན།",
    "སྲས་མོ་ཨུཏ་པ་ལས་རང་གི་ཁྱོ་ག་ལ་སྨྲས་པ།",
    "ང་ལ་ཕྲུ་གུ་སྐྱེ་ཁའི་སྐྱེ་གཟེར་ལངས་སོང་པས་ཡར་ལ་ལང་ཙམ་ཡང་བྱེད་མི་ཐུབ།",
    "དེས་ན་ཁྱོད་ཀྱིས་དྲག་ཆར་འདི་ལ་གཡོལ་སའི་གནས་ཤིག་འཚོལ་རོགས་གྱིས།",
    "ཁྱོ་གས་སྟ་རེ་ཞིག་ཁྱེར་ཡོད་པས་ཁོང་དྲག་ཆར་ཁྲོད་གཡས་གཡོན་གང་སར་བརྒྱུགས་ཏེ།",
    "རང་གི་ཆུང་མ་དྲག་ཆར་ལས་སྐྱོབ་ཕྱིར་ཤིང་སྡོང་དང་ལོ་མ་སོགས་འཚོལ་དུ་ཕྱིན།",
    "སྐབས་དེར་ཁོས་གྲོག་མཁར་ཞིག་གི་སྟེང་རྩྭ་ཡན་སྐྱེས་པ་མཐོང་བས་དེར་བརྒྱུགས་ཏེ་རྩྭ་ཡན་རྣམས་བཅད་ནས།",
    "སྲས་མོ་ཨུཏ་པ་ལས་རང་གི་ཁྱོ་ག་ཕྱིར་ལོག་རྒྱུར་ངང་བསྒྲུག་བྱས་ནས་བསྡད་པར།",
    "མོ་རང་གི་སྐྱེ་གཟེར་ཤུགས་ཆེ་རུ་ནས་ཆེ་རུ་ཕྱིན་ཏེ་ཅུང་མ་འགོར་བར་ཕྲུ་གུ་ཞིག་བཙས།",
    "མོའི་སྐད་ཤུགས་ཡོད་ཚད་བཏོན་ནས་ངུ་འབོད་བྱས་ཏེ་སྡུག་སྐད་བརྒྱབ།",
    "གང་ལྟར་ཁ་ཐབས་ཞན་པའི་སྲས་མོ་ཨུཏ་པ་ལར་མཚོན་ན་བྱེད་ཐབས་གང་ཡང་མ་རྙེད་པར་བཙས་མ་ཐག་པའི་བུ་ཆུང་རུམ་དུ་བཅུག་སྟེ་ལག་པ་དང་པུས་མོ་ས་ལ་བཙུགས་ནས་ཕྲུ་གུ་གཉིས་རང་གི་ལྟོ་འོག་ཏུ་བསྡམ་སྟེ་མཚན་གང་པོར་གཉིད་ཀྱང་མ་ཁུག་པར་དུས་ཚོད་སྐྱེལ་དགོས་བྱུང་།",
    "བུ་ཆེ་བ་མོ་རང་གི་མཛུབ་མོར་འཐམ་བཅུག་ནས་ཁོང་གཉིས་ལ་སྨྲས་པ།",
    "ད་ང་ཚོ་འགྲོ།",
    "ཁྱེད་གཉིས་ཀྱི་ཨ་ཕས་ནི་ང་ཚོ་འདིར་གཡུག་ནས་ཕྱིན་སོང་།",
    "དེ་ནས་སྲས་མོ་ཨུཊ་པ་ལ་རང་གི་ཁྱོ་ག་གང་དུ་ཕྱིན་སའི་ལམ་ཁ་དེ་དེད་ནས་སོང་བ་ན་གྲོག་མཁར་དང་ཐག་ཉེ་སར་སླེབས་དུས།",
    "མོས་མྱ་ངན་གྱི་འོ་དོད་འབོད་བཞིན་འདི་ལྟར།",
    "ངའི་ཁྱོ་ག་ནི་ལམ་ཁ་འདི་ན་གྲོངས་འདུག།",
    "དེ་ནས་མོ་རང་ཨ་ཅི་ར་ཝ་ཏི་ཟེར་བའི་གཙང་པོ་ཞིག་བརྒལ་དགོས་བྱུང་ཞིང་།",
    "གཙང་པོ་དེ་ནི་ཆུ་ལོག་གིས་ཡོངས་སུ་རྒྱས་ཏེ་རླབས་འཕྲེང་འཕྲོ་བཞིན་མཆིས་ནའང་།",
    "དེ་ལྟར་མོ་རང་གཙང་པོ་དེའི་ཁར་སླེབས་ཏེ་བསམ་པར།",
    "མ་ཟད་ཕྲུ་གུ་སྐྱེ་སྐབས་ཟུངས་ཁྲག་མང་པོ་ཕྱི་ལ་ཐོན་པས་དུས་གཅིག་ལ་ཕྲུ་གུ་གཉིས་ཀ་གཙང་པོའི་ཕར་འགྲམ་དུ་སྐྱེལ་ཐུབ་ཀྱི་མ་རེད་སྙམ་ནས།",
    "ཕྲུ་གུ་ཆེ་བ་གཙང་པོའི་འགྲམ་དུ་བཞག་ཅིང་ཆུང་བ་རྒྱབ་ལ་འཁུར་ནས་གཙང་པོའི་ཕ་རོལ་བརྒལ་ཏེ་ཤིང་གི་ལོ་མ་དང་ཡལ་འདབ་འགའ་བཅད་དེ་བུ་ཆུང་ཐོག་བཀབ་ནས།",
    "ནམ་མཁའ་ནས་ཁྲ་གླག་ཅིག་གིས་ཕྲུ་གུ་ཆུང་བ་ཤ་དུམ་ཞིགཏུ་ནོར་ནས་ཕྲུ་གུའི་ཐོག་མར་བབ་ཅིང་ནམ་མཁའ་ལ་ཁྱེར་ནས་འཕུར།",
    "ཨ་མས་དེ་མཐོང་མ་ཐག་ལག་པ་གཡུག་སྟེ་སྐད་ཤུགས་ཡོད་ཚད་བཏོན་ནས།",
    "ཨ་མས་ཕྲུ་གུ་ཆེ་བ་སྐྱོབ་ཕྱིར་ཁོའི་ཕྱོགས་སུ་གང་ནུས་ཀྱིས་ཆུ་གཤགས་ཏེ་ཡོང་ནའང་ཕྲུ་གུ་དེ་སྐྱོབ་མ་ཐུབ་པར་ཆུས་ཁྱེར།",
    "དེའི་ཐོག་ཕྲུ་གུ་ཆུང་བ་ནི་ཁྲ་གླག་གིས་ཁྱེར་བས།",
    "སྲས་མོ་ཨུཏ་པ་ལ་སྡུག་བསྔལ་དང་སྐྱོ་གདུང་གིས་རབ་ཏུ་ནོན་པར་གྱུར་ཏེ་ན་རེ།",
    "ངའི་བུ་ཆེ་བ་ནི་ཆུ་ཀླུང་གིས་ཁྱེར་ཞིང་།",
    "ཆུང་བ་ནི་ཁྲ་གླག་གིས་ཁྱེར།",
    "ད་ངས་ཅི་ཞིག་བྱ་དགོས་པ་རེད།",
    "ཅེས་མྱ་ངན་གྱི་སྨྲེ་ངག་བཏོན་ཏེ་རེ་ཞིག་ལུས་སོ།",
    "དེ་ནས་མོས་མྱ་ངན་གྱི་འོ་དོད་འབོད་བཞིན་ཕྱིན་ཕྱིན་པ་ན་མི་ཞིག་ལ་ཐུག་སྟེ་སྨྲས་པ།",
    "འོ་ན་ཁྱོད་ཀྱིས་མཉན་ཡོད་ཀྱི་འདི་དང་འདི་ཞེས་བྱ་བའི་ལམ་ཆེན་དེར་མིང་ལ་འདི་དང་འདི་ཞེས་བྱ་བའི་ཁྱིམ་ཚང་ཞིག་ངོ་ཤེས་ཀྱི་ཡོད་དམ།",
    "ཞེས་རང་ཉིད་ཀྱི་ཁྱིམ་ཚང་སྐོར་དྲིས་པར་ཁོང་གིས།",
    "འོན་ཀྱང་ཁྱེད་ཀྱིས་ང་ལ་ཁྱིམ་ཚང་དེའི་སྐོར་བཀའ་འདྲི་མི་གནང་བར་ཁྱོད་ཀྱིས་ངོ་ཤེས་པའི་ཁྱིམ་ཚང་གཞན་པ་རེའི་སྐོར་ལ་སྐད་ཆ་དྲིས་དང་།",
    "དེས་ན་ཐུགས་རྗེས་གཟིགས།",
