    "རྟེན་གྱི་གང་ཟག་ཚེ་འདི་ལ་བློ་ལོག་པ་གཅིག་གིས།",
    "སྡུག་བསྔལ་རང་རྒྱུད་དུ་མ་སོང་ཙམ་ན།",
    "ཉོན་མོངས་པ་རྣམ་རྟོག་སྟོང་པར་ཤེས་ནས་སྡུག་བསྔལ་སྐྱེ་བའི་ཡུལ་སྟོང་པ་ཉིད་དུ་ཤེས་ནས་མི་སྐྱེ་བར་འདུག་ན།",
    "སྐྱེན་མེད་སྐྱོན་བྲལ་བྱ་བ་ནི་སྣང་བ་སྟོང་པར་རེས་འཇོག་ཏུ་མ་སོང་བ་གཅིག་ལ་ཟེར་ཏེ།",
    "དེ་རང་ཡང་གཉིས་སྣང་གི་ཤེས་པ་དང་བྲལ་བ་གཅིག་ལ་བྱའོ།",
    "སྐྱེ་མེད་སྐྱོན་དང་བྲལ་བ་ན་གཉིས་སྣང་གི་མཐར་ཞེན་པ་དང་བྲལ་བ་ལ་ཟེར་བ་ཡིན་པས།",
    "ཚེ་ལ་ལོང་མེད་རྒྱུད་ལ་དྲན་པའི་ལྕག་གིས་བཀུལ་ཞིང་།",
    "ཨ་རོ་ཡེ་ཤེས་འབྱུང་གནས་ཀྱི་ལུགས་ཀྱིས།",
    "ང་ཉིད་རང་ལ་བལྟས་པས་རང་གི་སེམས་ཉིད་སྣ་ཚོགས་སུ་སྣང་།",
    "སྣང་ཤར་གཉིས་ཀ་རང་གི་སེམས་ཀྱིས་རྟོགས་པ་ཡིན།",
    "རྟོགས་པ་དེ་ཉིད་རང་གི་སེམས་ཉིད་ཡིན།",
    "སྣང་བ་སྣ་ཚོགས་སུ་ཤར་བ་དེ་ཉིད་རང་གི་སེམས་ཉིད་སྐྱེ་མེད་འདི་རང་ཡིན།",
    "སྤྱང་པོ་ཀུན་བསམ་མནོ་བག་རེ་ཐོང་དང་།",
    "རང་གི་ཞེ་འདོད་དུ་མ་སོང་བར་ཉམས་སུ་བླང་འཚལ་ཏེ།",
    "གཞུང་གི་ཚིག་གཉིས་སུ་དྲིལ་ནས་ཉམས་སུ་ལེན་པ་ཡིན་པས།",
    "མཐོ་རིས་ངན་སོང་ཕྱི་སྣོད་ནང་བཅུད་རང་གི་སེམས།",
    "ལོ་རེ་ཙམ་གྱིས་མི་འོང་བས།",
    "སྣང་བ་རང་རྒྱུད་པར་སོང་གིས་དོགས་པ་ལ་རང་བཞིན་སྐྱེ་མེད་དུ་བསྟན་ལ།",
    "སྟོང་པའི་མཐར་སོང་གིས་དོགས་པ་ལ་རོལ་པ་འགག་མེད་དུ་བསྟན།",
    "གཉིས་སྣང་གི་མཐར་ཤོར་གྱིས་དོགས་པ་ལ།",
    "ལྷ་ལ་ཉོན་མོངས་པ་སྐྱེར་ག་ལ་རུང་།",
    "དུག་ལྔ་རང་ཆས་སུ་ཡོད་པས་ཉོན་མོངས་པ་ལམ་དུ་མ་སློངས་བར་དུ།",
    "དུག་ལྔ་རང་ཆས་སུ་ཡོད་པས་ཉོན་མོངས་པ་ལམ་དུ་མ་སློངས་བར་དུ།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་པ་ལྔ་ཀ་ལ་ཤེས་པར་བྱའོ།",
    "ཇི་ལྟར་འཛིན་པ་དེ་ལྟར་ཀུན་ནས་ཉོན་མོངས་སྟན།",
    "བདག་དང་བདག་གིས་མི་དམིགས་རྣམ་པར་བྱང་བར་གསུངས།",
    "ཇི་ལྟར་འཛིན་པ་ཡོད་རིང་ལ་ཀུན་ནས་ཉོན་མོངས་པ་ཡོད།",
    "དེ་ལས་ལོག་པ་ལས་བདག་དང་བདག་གིར་མི་དམིགས་པར་བྱ་བར་གསུངས།",
    "དེ་བཞིན་དུ་བལྟས་པས་བདག་མི་རྟག་པར་མཐོང་བས་བདག་གི་ཆགས་པ་དང་བྲལ།",
    "དེ་སྔ་ཕན་ཆད་དུ་བདག་ཏུ་བཟུང་བས་བདག་གི་བ་བྱུང་།",
    "བདག་གི་བུ་དགྲ་ནོར་དེ་ལ་སོགས་པ་བདག་བྱུང་བས་བདག་གི་བ་མང་པོ་བྱུང་བ་ཡིན།",
    "བདག་མི་དམིགས་པས་བདག་གི་བ་ཐམས་ཅད་མི་དམིགས་པ་ཡིན་པས།",
    "བདག་དང་བདག་གིར་མི་དམིགས་པ་རྣམ་པར་བྱང་བར་གསུངས།",
    "དེ་བཞིན་དུ་མེ་དང་ཆུ་ནས་རང་གི་ལུས་སྦྱིན་པའི་བར་ལ་བསླབ་ཅིང་ཞེན་པ་ཐམས་ཅད་སྤངས།",
    "ད་ལྟའི་སྐབས་སུ་བསམ་མནོ་བག་རེ་བཏང་འཚལ་ཏེ།",
    "དད་པ་དང་འདུན་པ་མོས་པ་དང་གུས་པས་གསོལ་བ་དྲག་ཏུ་གདབ།",
    "བདག་གིས་སྦྱིན་པ་བཏང་།",
    "དེས་ན་ཀུན་རྫོབ་ཏུ་གཞན་དང་བདག་གི་རྣམ་རྟོག་ལས་གྱུར་བ་འདུག་གི་རིང་ལ།",
    "རང་གི་བདེན་འཛིན་རང་སར་གྲོལ་བ་ཅིག་མ་བྱུང་བར་དུ་ཀུན་རྫོབ་བདེན་པ་ཡིན།",
    "བརྗོད་པའི་ཚིག་གི་ཐ་སྙད་དང་བྲལ་ནས།",
    "རང་གིས་དོན་དམ་རྟོགས་སམ་ཀུན་རྫོབ་སྣང་བས་འདུག།",
    "བདག་གི་ཞེ་འདོད་མེད་པར་རྨི་ལམ་སྒྱུ་མ་ལྟ་བུས་གཞན་དོན་གཙོ་བོར་སྒྲུབས་ན།",
    "སྣང་བ་རང་བཞིན་མེད་པར་རྟོགས་པས་ཟས་བཟང་ངན་གྱི་རྣམ་རྟོག་བྲལ་བས་ངང་གིས་འཇུ་བ་ཡིན་ཏེ།",
    "དཔེ་ཚེས་ཅིག་གི་ཟླ་བ་དང་འདྲ་སྟེ།",
    "རྗེས་ཐོབ་བདེན་འཛིན་ཤས་ཆུང་ངུ་སོང་བ་ཅིག་གིས་འཇུ་བ་ཡིན་ཏེ།",
    "དེའི་འོག་ཏུ་རྣལ་འབྱོར་པ་ལུས་ངག་གི་དགེ་སྦྱོར་རེམ་པ་ཅིག་གིས་འཇུ་སྟེ།",
    "ངན་སོང་དུ་འགྲོ་བའི་གྲོགས་བྱེད།",
    "རང་གིས་བསགས་པའི་ནོར་གྱིས་ཀྱང་མི་སྟོངས་པར་འདུག།",
    "འོ་ན་རང་གི་ལུས་འདི་སྲོག་འཛིན་པ་ཡིན་པས་འཆི་བ་ལ་སྟོངས་སམ་སྙམ་ན།",
    "རང་གི་ལུས་ལ་སོགས་པ་ཅིས་ཀྱང་མི་སྟོངས་པར་འདུག་པས་ཁམ་ཆེས་ཏེ་མ་གོ།",
    "དམིགས་མེད་དུ་སོང་རྩ་ན་སྤྲོས་བྲལ་ཡིན།",
    "བསྐྱེད་རྫོགས་ལ་སོགས་པ་འཕྲིན་ལས་གང་གི་སྒོར་ཞུགས་པའི་རྣལ་འབྱོར་པ་ཡིན་ཏེ།",
    "བསྐྱེད་པའི་རིམ་པ་རྐྱང་པ་ལྟར་བསྒོམས་ཀྱང་ངན་སོང་གི་སྒོ་ཁེགས་པ་ཡིན།",
    "སྔགས་བསྐྱེད་རྫོགས་གཉིས་ཀྱི་ཕྲིན་ལས་ལ་མོས་ན།",
    "ངག་གི་བཞི།",
    "ངག་གི་རྫུན།",
    "དེ་ཡང་ཡ་མ་བྲལ་བ་ཡིན་ཏེ་རེ་རེ་ལ་དྲུག་ཀ་ཚང་བ་ཡིན།",
    "རང་གི་སེམས་ལ་བལྟ་བ་རྟག་ཏུ་གོམས་པར་གྱིས།",
    "སེམས་ལ་རྟག་ཏུ་བསམ་མནོ་དུམ་རེ་བཏང་དགོས་ཏེ།",
    "ཉིན་པར་བྱ་བའི་ལས་ལ་སོང་བས་བྲེལ་བའི་ངང་།",
    "དུང་དུང་བྱས་པས་སྡུག་བསྔལ་འབའ་ཞིག་ཏུ་སོང་།",
    "ཚེ་འདིར་ཡང་སྡུག་བསྔལ་ལ་ཕྱི་མར་ཡང་ངན་སོང་དུ་སྐྱེ་བས་སྡུག་བསྔལ་ཏེ།",
    "ཞེ་སྡང་གིས་ཚེ་འདིར་ཀམ་ཀམ་རྩིག་རྩིག་བྱེད་ཅིང་ཤི་བ་ལ་མ་བལྟ་བས་རང་རྒྱུད་བསྲེགས་པས་ཚེ་འདིར་སྡུག།",
