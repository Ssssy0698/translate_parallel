    "དེ་དང་དུས་མཉམ་པར་གྱུར་པས་ཀྱང་མ་ཡིན་ཏེ།",
    "གསལ་བའམ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ལ་རང་རིག་མེད་པའི་ཕྱིར་དུས་ཕྱིས་དྲན་པར་མི་འགྱུར་ལ།",
    "ཉམས་སུ་མ་མྱོང་བ་ནི་དྲན་པར་མི་ནུས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཉམས་སུ་མྱོང་བའི་འབྲས་བུ་དྲན་པ་དུས་ཕྱིས་དམིགས་པའི་ཕྱིར་རང་རིག་པའི་ཤེས་པ་ཡོད་དོ་ཞེས་དཔག་པར་བྱའོ།",
    "འདི་ཡང་སྒྲུབ་པར་བྱེད་པ་ཡིན་པས་འདིས་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "མེ་དང་དུ་བ་བཞིན་དུ་དྲན་པས་རང་རིག་པ་སྒྲུབ་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "མིག་ལ་སོགས་པ་ལ་རྣམ་པར་ཤེས་པ་བཞིན་དུ་མ་མཐོང་ཡང་དྲན་པ་དེའི་འབྲས་བུར་ནི་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "མིག་མེད་པར་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་མེད་པས་ལྡོག་པའི་སྒོ་ནས་དེའི་འབྲས་བུར་རྗེས་སུ་དཔོག་གོ།",
    "དྲན་པ་ནི་རང་རིག་པའི་ཤེས་པ་མེད་ཀྱང་འབྱུང་ངོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དྲན་པ་ཡང་རྣམ་པར་ཤེས་པ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་གྲུབ་པར་འགྱུར་ཞེས་བརྗོད་པར་བྱའོ།",
    "རང་ལ་རྟགས་མ་གྲུབ་པར་ནི་གཞན་གྱི་ཤེས་པར་བྱེད་པ་མ་ཡིན་ལ།",
    "ཤེས་པ་ནི་ཤེས་པ་གཞན་གྱི་ཡུལ་མ་ཡིན་ཏེ་ཕྱི་རོལ་གྱི་དོན་བཞིན་དུ་འབྲེལ་པ་མ་གྲུབ་པ་ལ་སོགས་པའི་ཉེས་པར་འགྱུར་བས་སོ།",
    "གཞན་ཉིད་དུ་ཁྱད་པར་མེད་པས་རྒྱུ་གཞན་གྱི་དངོས་པོ་དེ་ཡང་དྲན་པས་འཛིན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་དེས་སྔར་ཉམས་སུ་མ་མྱོང་བས་ན་དྲན་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "དོན་དམ་པར་རྒྱུ་དང་འབྲས་བུ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "དེ་འཛིན་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "བརྟགས་པ་ཉིད་ཡིན་པ་ན་ཡང་ཐ་སྙད་ཐམས་ཅད་རྟོགས་པས་སྤྲུལ་པ་ཡིན་པའི་ཕྱིར་ཀུན་རྫོབ་བསྒྲུབ་བྱ་ཡིན་པས་དོན་དམ་པ་མ་བསྒྲུབས་པར་འགྱུར་རོ།",
    "གཞན་མྱོང་བ་ན་འབྲེལ་པ་ལས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འབྲེལ་པ་ལས་ཞེས་གསུངས་ཏེ།",
    "ཡུལ་དྲན་པ་ན་འབྲེལ་པ་ལས་ཤེས་པ་དྲན་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་དེའི་འཛིན་པ་ཉིད་ཡིན་པས་དེ་དང་འབྲེལ་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་དྲན་པ་ཡིན་ཏེ་གཞན་དུ་མ་ཡིན་ནོ།",
    "འབྲེལ་པ་བདེན་ཡང་འདི་མ་མྱོང་ན་གཞན་དྲན་པ་ནི་བསླད་པའི་དྲན་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྔར་ཉམས་སུ་མྱོང་བའི་ཡུལ་ཕྱིས་རྗེས་སུ་དྲན་པ་ན་མྱོང་བ་ཁྱད་པར་ཅན་དེ་ཉིད་དྲན་པ་ཡིན་ཏེ།",
    "དེས་ཁྱད་པར་དུ་བྱས་པ་དེ་འཛིན་པའི་ཕྱིར་རོ།",
    "ཤེས་པ་ཉིད་ཡུལ་ཉམས་སུ་མྱོང་བ་ཡིན་ལ་གཞན་མ་ཡིན་པའི་ཕྱིར་ཡུལ་ཉམས་སུ་མྱོང་བ་དྲན་པ་ལས་དེ་དང་འབྲེལ་པས་ཤེས་པ་དྲན་པར་བརྗོད་པར་བྱའོ།",
    "ཅི་སྟེ་མྱོང་བའི་ཤེས་པས་གཞག་པའི་དྲན་པས་བག་ཆགས་ཀྱི་ས་བོན་མེད་པར་ཕྱིས་དྲན་པ་སྐྱེད་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "བྱི་བའི་དུག་ཅེས་གསུངས་ཏེ།",
    "བྱི་བའི་དུག་ནི་ཇི་ལྟར་འབྲེལ་པར་ཕྱིས་སྐྱེ་བར་འགྱུར་བ་དེ་བཞིན་དུ་དྲན་པ་ཡང་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "སླར་ཡང་རྣམ་པར་ཤེས་པ་ཙམ་དུ་སྨྲ་བས་རང་རིག་པ་གྲུབ་པར་བྱ་བའི་ཆེད་དུ་རྣམ་པ་གཞན་བསྟན་པའི་ཕྱིར་རྐྱེན་གཞན་དག་དང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྣང་བའི་ཕྱིར་རྣམ་པར་ཤེས་པ་རང་ཉིད་གསལ་ཏེ་རང་བཞིན་གསལ་ཞིང་རིག་པ་ཡོད་དོ་ཞེས་པའི་དོན་ཏོ།",
    "གལ་ཏེ་ཡང་དེ་ཐམས་ཅད་དུ་ལྐོག་ཏུ་གྱུར་པའི་རང་བཞིན་ཡིན་ན་ཇི་ལྟར་ཚོགས་པའི་ཁྱད་པར་ལས་བརྒྱ་ལ་ཡང་དམིགས་པ་མ་ཡིན་ཏེ།",
    "དེའི་སྦྱོར་བ་ནི་རྣམ་པར་སྦྱོར་བའམ་རབ་ཏུ་སྦྱོར་བའོ།",
    "དེ་ལྟ་བས་ན་འདི་ནི་བསྒྲུབ་བྱ་ལ་མཁོ་བའི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཤེས་པ་རིག་པའི་ངོ་བོར་མ་གྱུར་ན་དོན་ཡང་རྟོགས་པར་མི་འགྱུར་བ་མ་ཡིན་ན་མ་ཤེས་པ་ནི་མི་གསལ་བ་གསལ་བར་བྱེད་པའི་ཕྱིར་ཏེ་དོན་ནི་གསལ་བ་མ་ཡིན་ལ།",
    "དེ་མ་རྟོགས་པ་ལ་དོན་ཅི་ལྟར་རྟོགས་པར་འགྱུར་ཏེ།",
    "དོན་ཉམས་སུ་མྱོང་བ་མེད་པའི་ཕྱིར་འཇིག་རྟེན་ན་མཐོང་བའི་ཐ་སྙད་འདི་ཐམས་ཅད་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཇི་ལྟར་མཐོང་ཐོས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་མཐོང་བ་ལ་སོགས་པའི་ཐ་སྙད་མེད་པར་འགྱུར་རོ་ཞེས་པ་དེ་དོན་དམ་པའམ།",
    "ཀུན་རྫོབ་ཏུ་མེད་པར་འགྱུར།",
    "དེ་ལ་གལ་ཏེ་དོན་དམ་པར་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་ན་དེའི་ཚེ་འདི་ནི་བདག་འདོད་པ་མ་ཡིན་ཏེ།",
    "ཤེས་པ་ཞེས་པ་ནི་ཚུལ་གསུམ་པའི་རྟགས་ལས་སྐྱེས་པའི་རྗེས་སུ་དཔག་པར་ངེས་པའོ།",
    "དེ་ཉིད་འདིར་ཐ་སྙད་ཐམས་ཅད་ལ་བརྟེན་ཏེ་དགག་པར་བྱ་མིན་ཞེས་པ་མི་བཟློག་པའོ།",
    "འདིར་ནི་སྡུག་བསྔལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དགག་པར་བྱ་བ་ཡིན་ནོ།",
    "ཅེས་པའི་ཚིག་ལས་དེ་ལྟར་བདེན་པར་རྟོགས་པ་ནི་སྡུག་བསྔལ་གྱི་རྒྱུ་ཡིན་ནོ།",
    "ཞེས་གསུངས་སོ།",
