    "མངག་གཞུག་པའི་སྦྱོར་བ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "དེ་ཉིད་གསུངས་པ་ནི།",
    "དེ་ཡོངས་སུ་གྱུར་པའི་མངག་གཞུག་པ་རིགས་དང་རྗེས་སུ་མཐུན་པར་བགེགས་མཐར་བྱེད་ལ་སོགས་པ་གསུམ་ལས་གང་ཡང་རུང་བར་བསམ་པར་བྱའོ།",
    "དེ་ཉིད་གསུངས་པ་ནི་ཕྱག་ན་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ཞེས་བྱ་བ་ནི་བགེགས་མཐར་བྱེད་དོ།",
    "རྣམ་པར་སྣང་མཛད་ཟླ་བ་ལ་གནས་པ།",
    "མི་བསྐྱོད་པ་ལ་སོགས་པའི་རིགས་དང་མཐུན་པའི་རྣལ་འབྱོར་པ་གང་ཡང་རུང་བས་མངག་གཞུག་པ་འདི་བསྒྲུབ་པར་བྱའོ་ཞེས་གསུངས་པ་ནི་དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ནོ།",
    "དམ་ཚིག་སྨྲ་བ་ནི་སྤྲོས་པའི་དེ་བཞིན་གཤེགས་པ་དེ་རྣམས་ཉིད་ཀྱི་ཡང་དག་པར་གསུངས་པའོ།",
    "དམ་ཚིག་འཆིང་བ་ནི་འོད་ཟེར་རྣམས་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཡང་དག་པར་བསྡུས་ཏེ་ས་བོན་དེར་གཞུག་པའོ།",
    "ད་ནི་མངག་གཞུག་པ་དེའི་མཐུ་གསུངས་པ་ནི་ནམ་མཁའི་དབྱིངས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "འཇམ་པའི་རྡོ་རྗེའི་རྣལ་འབྱོར་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "ལྟེ་བ་རྣམས་བསྒྲུབ་པར་བྱ་བ་བསྐུལ་བར་བྱའོ།",
    "དེ་ནས་དེ་བརྒྱལ་བར་གྱུར་པ་བཞིན་དུ་རྐང་པ་གཉིས་ཀྱི་དྲུང་དུ་འགྱེལ་བར་བསམ་པར་བྱའོ།",
    "དེ་ལྟ་བུ་འདི་ནི་མཚན་མ་ཐོབ་པར་ཟླ་བ་ཕྱེད་ཅིག་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བྱས་ནས།",
    "བཀྲེས་པ་ལ་སོགས་པ་སེལ་བའི་སྦྱོར་བ་གསུངས་པ་ནི་བཀྲེས་སྐོམ་ལ་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་པས།",
    "བཟའ་བས་གང་བའི་ཡི་གེ་བ་ཁ་ཐུར་དུ་བལྟས་པའི་ནང་དུ་ཆུད་པ་ལས་བདུད་རྩིའི་རྒྱུན་གྱིས་ཚིམ་པར་བྱེད་ཅིང་།",
    "དེ་དང་པོར་རྡོ་རྗེ་འཛིན་པར་གྱུར་པས།",
    "ཡི་གེ་དྷཱི་ལས་བྱུང་བའི་རྡོ་རྗེ་སེར་པོའི་རིམ་གྱིས་དཔའ་བོ་རྡོ་རྗེ་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པ་ཟླ་བའི་གདན་ལ་བཞུགས་པ།",
    "སྐུལ་བྱེད་མ་བསྐྱེད་པའི་ཆོ་ག་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དང་པོ་རྒྱུ་རྡོ་རྗེ་འཛིན་པར་གྱུར་པས་ཡི་གེ་ཧཱུཾ་ཙུཾ་ལས་བྱུང་ཞིང་པདྨ་དཀར་པོ་ལས་སྐྱེས་པ།",
    "སྤྲོ་བ་ལ་སོགས་པ་དང་ཡང་དག་པར་ལྡན་པ།",
    "ལས་ཀྱི་ཁྱད་པར་གྱི་ཕྱིར་སྔགས་ཀྱི་ཚིག་དགོད་པར་བྱའོ།",
    "གནོད་མཛེས་བསྐྱེད་པའི་ཆོ་ག་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དང་པོ་རྡོ་རྗེ་འཛིན་པར་གྱུར་པས་ཛཾ་ལས་བྱུང་བའི་བི་ཛ་པཱུ་ར་ལས་བྱུང་བ།",
    "ཟླ་བའི་གདན་ལ་བཞུགས་པ།",
    "མི་བསྐྱོད་པའི་ཅོད་པན་ཅན་བསམ་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་དང་།",
    "སྦྱིན་པའི་ལས་ཀྱི་དབྱེ་བ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ལྟ་ན་ཡང་གྲུབ་པར་མ་གྱུར་ན།",
    "ཚར་གཅད་པར་བྱའོ།",
    "དེ་ཡང་འཁྱུད་ནས་རྡོ་རྗེའི་སྦྱོར་བ་དྲག་ཤུལ་ཅན་གྱི་བརྩམ་པར་བྱ་ཞིང་།",
    "དེ་ཉིད་གསུངས་པ་ནི་མི་སྣང་བའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "ཕན་ཡོན་གསུངས་པ་ནི་དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "རང་སྣང་བའི་རིག་པ་དང་ལྷན་ཅིག་བརྟུལ་ཞུགས་ཀྱི་སྤྱོད་པའི་ཆོ་ག་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་ལ་ཉེ་བར་མཚོན་པའི་དོན་དུ་རྣམ་པར་སྣང་མཛད་གསུངས་པ་ནི་དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ལ་སོགས་པའི་ཚུལ་གྱི་རྣལ་འབྱོར་ཏེ།",
    "རྣལ་འབྱོར་དེ་བྱས་ལ་ཆོ་ག་གང་ཡིན་པ་དེ་གསུངས་པ་ནི་ལོ་གྲངས་བཅུ་དྲུག་ཅེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ནོ།",
    "བསྲུང་བར་བྱ་བའི་དམ་ཚིག་གསུངས་པ་ནི་རྟག་ཏུ་གཞན་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་པའི་ཆོ་ག་གསུངས་ནས།",
    "རྣམ་པར་དག་པའི་འདོད་ཆགས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཤེས་རབ་བརྙེས་པས་ན།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "སྐུ་རྡོ་རྗེའི་དམ་ཚིག་གསུངས་ནས།",
    "དམ་ཚིག་འདི་དག་བསྲུང་བ་ནི་དེ་ཉིད་འགྲུབ་པར་འགྱུར་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ཐོབ་པའི་རྒྱུའི་ཚོགས་པ་དག་ཀྱང་རིག་པ་འཛིན་པ་ལ་སོགས་པའི་དངོས་གྲུབ་ཀྱི་ཚོགས་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཉན་ཐོས་ལ་སོགས་པ་རྣམས་ལ་འཇིགས་པ་སྐྱེད་པར་བྱེད་པ་ཡིན་པས་ན་འཇིགས་ཤིང་མི་སྡུག་པ་སྟེ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་ཡི་གེ་ཨཾ་ལས་བྱུང་བའི་ཚངས་པ་དེའི་ལུང་དང་རྗེས་སུ་མཐུན་པར་གདོང་བཞི་ལ་སོགས་པ་དང་ལྡན་པ།",
    "འདི་རྣམས་ཉེ་བར་བསྡུ་བའི་རིགས་ཀྱི་དབྱེ་བ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཆོ་ག་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ་ཞེས་དགོངས་སོ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་བསྒྲུབ་པར་འདོད་པས་ཀྱང་དམ་ཚིག་འདི་དག་ཐམས་ཅད་ཆོ་ག་བཞིན་དུ་སྤྱད་པར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཐམས་ཅད་བསྙེན་པའི་རྣལ་འབྱོར་པ་ཉིད་འགྲུབ་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཕྱོགས་མེད་པར་འཇུག་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་ཆེན་པོའི་ཡན་ལག་བཞི་བྱས་ནས།",
    "བདུད་རྩི་མྱང་བར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣལ་འབྱོར་པས་དུས་བཞིར་བྱ་བ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་ཐམས་ཅད་ནི་རྣམ་པར་འཁྲུལ་པ་སྟེ།",
    "དེ་རྣམས་ཀྱི་མི་སྣང་བ་ནི་རྣམ་པར་འཇིག་པ་རྣམ་པར་དག་པའི་ངོ་བོ་སྟེ།",
    "རིག་པ་འཛིན་པའི་དམ་ཚིག་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་རིན་ཆེན་འབྱུང་ལྡན་རིག་པ་འཛིན་པ་གྲུབ་པ་མགོ་ལ་བསམ་པར་བྱའོ།",
    "འདི་དག་ཐམས་ཅད་ནི་ལྷ་རྣམས་ཀྱི་འཁོར་ལོ་ལ་སོགས་པ་ར་བསམ་པར་བྱའོ།",
    "ཀུན་དུ་མཉམ་ཞིང་རྣམ་པར་དག་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ནོ།",
    "ད་ནི་བཅོམ་ལྡན་འདས་ཡིད་ཀྱིས་མཛད་པ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ཀྱི་རྡོ་རྗེ་འཛིན་པའི་ཉིད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ཉིད་ནི་མི་ཕྱེད་པས་ན་རྡོ་རྗེ་སྟེ།",
    "དེའི་ངོ་བོ་ཉིད་ཀྱིས་རྡོ་རྗེ་མཉམ་པ་ཉིད་ལ་རྣམ་པར་དགོངས་ནས་ཅང་མི་གསུང་བར་གྱུར་ཏོ།",
    "ཚིག་ལ་སོགས་པའི་ཚུལ་དང་བྲལ་བར་རྣམ་པར་བརྟགས་ནས་ཅང་མི་གསུང་བར་བཞུགས་སོ།",
    "གསུང་དང་ཐུགས་ཀྱང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "སྐུ་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་གྱུར་པས་ཡང་དག་པར་ཤེས་པས།",
    "ཡང་དག་པར་བསྡུས་ཤིང་བསྡམས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་སྟོན་པར་མཛད་པར་རིགས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གསུངས་པ་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེས་ན་ཚངས་པ་ལ་སོགས་པས་ཀྱང་རྣམ་པར་དཔྱོད་ན་ཤེས་པར་འགྱུར་རོ།",
    "དེར་གཟུགས་སུ་རྣམ་པར་བསྒོམ་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་སྣང་མཛད་ཡོངས་སུ་གྱུར་པའི་རྡོ་རྗེའོ།",
    "དེའི་རྟེན་སྐུའི་རྡོ་རྗེ་འཁོར་ལོ་འཛིན་པ་བསམ་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མཆོག་འགྱུར་ཞེས་བྱ་བ་ནི་དེ་ལྟ་བུས་འགྲུབ་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བསྒྲུབ་པར་བྱ་བ་འགྲུབ་པ་ན་བསྲུང་བར་བྱ་ཞིང་ཏིང་ངེ་འཛིན་གྱིས་ཀྱང་ཚིམ་པར་བྱས་ལ་སྤྱན་བསམ་པར་བྱའོ་ཞེས་བྱ་བ་གསལ་བར་བྱ་བའི་ཕྱིར།",
    "གསང་བའི་དབྱིངས་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ནི་སྤྱན་དང་མཱ་མ་ཀཱི་དག་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་དེ་ཡང་རྣམ་པར་གཡེང་བའི་ཚུལ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཆོ་ག་བཞིན་ཞེས་བྱ་བ་ནི་འབར་བ་ལ་སོགས་པ་བྱས་ནས་སོ།",
    "བདུད་རྩི་ལྔ་ལ་སོགས་པའི་སྦྱོར་བ་རྣམས་ངེས་པར་བྱ་བ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཡང་ཉེ་བར་དགོད་པར་སྨོས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "རྡོ་རྗེ་གསུམ་ལ་སོགས་པས་བྱིན་གྱིས་བརླབས་པའི་རྡོ་རྗེ་མཁའ་འགྲོར་བསམས་ལ་བསྒྲུབ་པར་བྱ་བའི་ཤ་ལ་སོགས་པས་ནམ་མཁའི་ཁམས་གང་བར་བསམས་ཏེ།",
    "སྦྱོར་བ་འདི་ཉིད་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ཕུར་བུས་གདབ་པར་ཡང་བྱའོ་ཞེས་གསུངས་པ་ནི་རྩེ་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེས་ན་བསྒྲུབ་པར་བྱ་བའི་ཁྲག་ལ་སོགས་པ་དྲངས་པར་འགྱུར་རོ།",
    "ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་རྣམ་པར་གྱུར་པར་བསམས་ལ།",
    "དཀྱིལ་འཁོར་པ་རྣམས་ཚིམ་པར་བྱའོ།",
    "ཅེས་བྱ་བ་ནི་སྐུ་ལ་སོགས་པ་བྱིན་གྱིས་བརླབས་པའི་རྗེས་ཐོགས་ལ་ཆོ་ག་བཞིན་དུ་སྤྱད་པར་བྱའོ།",
    "སྤྱི་བོའི་སྟེང་དུ་མཐོ་གང་ཙམ་གྱིས་སྤགས་པར་བདུད་རྩི་ལྔའི་དཀྱིལ་འཁོར་མཐོ་གང་ཙམ་པ་ཉིད་གདུགས་དཀར་པོ་ལྟ་བུ་ཡོངས་སུ་བརྟགས་ལ།",
    "དེའི་དབུས་ན་གནས་པའི་ཁ་དོག་ལྔ་པའི་ཨོཾ་གྱི་འོད་ཀྱིས་ཞུ་བར་གྱུར་ནས་ཟླ་བ་ལྟ་བུའི་བདུད་རྩིའི་རྒྱུན་ཉིད་རྐན་གྱི་ཕྱོགས་སུ་བབས་པས་སྐུ་རྡོ་རྗེ་ལ་སོགས་པ་རྩ་སྦུབས་མ་ལུས་པའི་རྒྱུ་བ་ནས་ཆོ་ག་བཞིན་དུ་ཚིམ་པར་བྱའོ།",
    "དུག་བསལ་བའི་ཆོ་ག་གསལ་བར་བྱ་བའི་ཕྱིར་གསུངས་པ་ནི་བྷྲཱུྃ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་བྱས་ལ་ལག་པ་གཡས་པར་ཡི་གེ་བྷྲཱུྃ་ཉིད་ལ་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་དཀར་པོ་ལ་དེའི་ལྟེ་བར་ཡི་གེ་བྷྲཱུྃ་འོད་ཟེར་དཀར་པོ་དང་ལྡན་པ་རྣམ་པར་བསམས་ལ།",
    "དོན་འདི་ཉིད་ནི་ལྷག་པར་བཅུག་ལ།",
    "སྔ་མ་བཞིན་དུ་ལས་རྣམས་ཅི་རིགས་པར་བྱའོ།",
    "འདི་དག་ལ་དམིགས་ནས་ཆོ་ག་བཞིན་དུ་བཟླས་བརྗོད་འབུམ་བྱས་ཏེ།",
    "ལན་གསུངས་པ་ནི་དེ་ནས་ཕྱག་ན་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟོན་ཏོ།",
    "ངས་མ་གསུངས་སོ་ཞེས་བྱ་བ་ནི་མར་མེ་མཛད་ལ་སོགས་པའི་བདག་ཉིད་དུ་མཛད་ནས་མ་གསུངས་པ་སྟེ།",
    "སྤྲོས་པའི་ཚུལ་གྱིས་ནི་ཁྱད་པར་ཡོད་དོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དེ་ནས་དེ་རྣམས་བཟློག་པར་བྱ་བའི་ཕྱིར།",
    "ཁྱེད་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་གསང་བའི་ཡི་གེ་དེ་རྣམས་མཁྱེན་པར་མ་གྱུར་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་བཀའ་སྩལ་པ།",
    "གསང་བའི་ཡི་གེ་གསུམ་རྣམ་པར་དག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "ཡི་གེ་དེ་རྣམས་ནི་སྐུ་ལ་སོགས་པ་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་ཡིན་ཞིང་དེ་ཁོ་ན་ཉིད་དུ་གྱུར་པ་ཐམས་ཅད་མཁྱེན་པའི་རྒྱུ་ཡིན་ལ།",
    "འདོད་པའི་ཁམས་ནམ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྟོགས་པར་བྱ་བའི་ངོ་བོ་ཉིད་ལས་ཐ་དད་པར་གྱུར་པའི་གཟུགས་ཀྱི་ཕུང་པོ་ལ་སོགས་པ་དགག་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "འདི་ནི་བྱེད་པ་པོའི་ཁྱད་པར་རོ།",
    "འདི་ནི་ལས་ཀྱི་ཁྱད་པར་རོ།",
    "དུས་ཇི་བཞིན་པར་ཞེས་བྱ་བ་ནི་གླེང་གཞིའི་ལེའུ་ལ་སོགས་པ་ལས་གསུངས་པའི་རིམ་གྱིས་ཏེ།",
    "འདི་ནི་བྱ་བའི་ཁྱད་པར་རོ།",
    "སྐུ་རྡོ་རྗེ་ལ་སོགས་ལ་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་དུ་བཞུགས་པ་འདི་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་ངེས་པ་སྟེ།",
    "དེ་བས་ན་འདིས་ནི་དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཁམས་གསུམ་པ་ཐམས་ཅད་ཀྱི་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་འདི་ཉིད་ཀྱི་ལེའུ་བཅུ་བདུན་པ་ལས་གསུངས་པའི་འདས་མ་ཐག་པའི་དོན་སྟོན་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་ཡང་དག་པར་རྟོགས་པའི་བདག་ཉིད་ཅན་གྱི་རྡོ་རྗེ་ཅན་སྐུ་ལ་སོགས་པའི་ལྷའི་བདག་ཉིད་ཅན་དུ་ཡང་དག་པར་བཟུང་ཞིང་ཡང་དག་པར་རྟོགས་པ་ལ་རྩེ་གཅིག་ཏུ་བྱས་ནས་ཉོན་ཅིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་ལྔ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་ལྔ་པ་ལས་ནི་སྒྲུབ་པོ་གསུངས་ལ།",
    "དགུ་པ་ལས་ནི་དམ་ཚིག་བཞི་གསུངས་སོ།",
    "བཅུ་གསུམ་པ་ལས་ནི་གསང་སྔགས་ཀྱི་བཟླས་བརྗོད་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བས་ན་འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གང་བསྟན་པར་མཛད་པ་དེ་ཉིད་ནི་སྒྲུབ་པ་ཆེན་པོའོ།",
    "བཞི་པར་ནི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་གསུངས་ལ།",
    "སློབ་དཔོན་གྱི་ལས་དེ་ཡང་བཅུ་དྲུག་པ་ལས་བརྟུལ་ཞུགས་དང་དཀྱིལ་འཁོར་གསུངས་སོ།",
    "དེ་ལ་དྲུག་པ་ལས་ནི་རྗེས་སུ་མཉེས་པ་དང་ཉེ་བར་སྒྲུབ་པ་གསུངས་སོ།",
    "བཅུ་པ་དང་བཅུ་བཞི་པ་ལས་ནི་དྲག་པོའི་སྦྱོར་བ་གསུངས་སོ།",
    "བདུན་པ་ལས་ནི་སྒྲུབ་པའི་སྡོམ་པ་རྗེས་སུ་དྲན་པའི་ངོ་བོ་ཉིད་གསུངས་སོ།",
    "དེར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཕྲིན་ལས་ལྷ་རྣམས་འབྱིན་པ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་དག་ཐམས་ཅད་ནི་ལེའུ་དེ་དང་དེ་དག་ལ་ཅི་རིགས་པར་གསུངས་སོ་ཞེས་བྱ་བ་ནི་རྒྱུད་ཀྱི་འབྲེལ་བ་ཡིན་ནོ།",
    "ཞེས་བགྱི་བའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་ཤེས་རབ་ཐབས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལྟར་དང་པོ་རྒྱུད་ཀྱི་འབྲེལ་བ་གསུངས་ནས།",
    "ད་ནི་རྒྱུད་ཅེས་བྱ་བའི་སྒྲ་ཉིད་ཀྱི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྱད་པར་གྱི་རྒྱུ་ལ་རང་བཞིན་ཞེས་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་རྣམས་ཉིད་རྣམ་པར་ཕྱེ་བའི་དབྱེ་བ་ལས་ནི་རིགས་བརྒྱར་འགྱུར་བ་འདི་ནི་ཉེ་བར་མཚོན་པ་ཙམ་སྟེ།",
    "གསུམ་དུ་ཇི་ལྟར་རིགས་པར་འདིའི་ཁོངས་སུ་གཏོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་དྲིས་པ་བཞི་ལ་ལན་བཞི་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཆེ་བའི་ལྷ་ནི་བདག་པོར་གྱུར་པའི་ལྷ་སྟེ་ཐུགས་རྣམ་པར་དག་པའི་རང་བཞིན་དོན་དམ་པར་རིགས་གཅིག་པའི་ངོ་བོ་ཉིད་དོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་ཡེ་ཤེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱེ་བའི་དངོས་ཞེས་བྱ་བ་ནི་དེ་དག་ཉིད་རྣམ་པར་དབྱེ་བའི་དབྱེ་བས་ཕྱེ་བས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་དྲིས་པ་ལྔ་ལ་ལན་ལྔའི་ཚིགས་སུ་བཅད་པ་བསྟན་པ་ནི་རྒྱུ་ལྔ་དང་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པའོ།",
    "ཛི་ན་ཞེས་བྱ་བའི་སྒྲ་ཉིད་ཀྱི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྐྱེ་ལས་རྒྱལ་བ་ཞེས་བྱ་བར་གསུངས་ཏེ།",
    "ཚོར་བ་རྣམ་པར་དག་པའི་ཡིད་ལ་རིན་ཆེན་འཛིན་ཞེས་བྱ་བའོ།",
    "དངོས་པོ་ནི་རྣམ་པར་རྟོག་པའི་ངོ་བོ་དྲུག་པ་ཡིན་ཏེ།",
    "དེ་ནི་དེ་བཞིན་རིགས་ནི་འདིར་གང་ལགས་ཞེས་བྱ་བའི་ལན་འདིར་བསྟན་པའི་ཕྱིར།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་འཇིག་ཅེས་བྱ་བ་ནི་དེ་བཞིན་གཤིགས་པ་ལྔའི་བདག་ཉིད་ཅན་གཉིས་སུ་མེད་པའི་ངོ་བོ་ཉིད་ལ་ནི་རྣམ་པར་འཇིག་པ་མེད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་རྣམ་པར་དག་པ་ཉིད་ཀྱིས་སྐྱེ་བ་མེད་པའི་ཕྱིར་རོ།",
    "ད་ནི་རྒྱུ་དང་འབྲས་བུ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཕུང་པོའི་སྒོ་ནས་རྣམ་པར་དག་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཞུང་ལུགས་གསུངས་པའོ།",
    "དེ་རྣམ་པར་དག་པའི་སོ་སོ་རང་རིག་པའི་ངོ་བོ་ཉིད་ཀྱི་འདོད་ཆགས་ཀྱི་བདག་ཉིད་ཅན་ནི་འོད་དཔག་ཏུ་མེད་པའོ།",
    "དེ་རྣམ་པར་དག་པ་འདའ་བའི་ངོ་བོ་ཉིད་ནི་དོན་ཡོད་གྲུབ་པའོ།",
    "སྲིད་པ་ཀུན་འབྱུང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཞེས་གསུངས་པའི་འདོད་པའི་སྒྲའི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར་འདོད་ཆགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་དམ་ཚིག་ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་སེམས་དཔའི་བདག་ཉིད་ཅན་ནོ།",
    "གཏི་མུག་ལ་སོགས་པ་གསུམ་ལ་རྡོ་རྗེ་དགའ་བ་ཁོངས་སུ་གཏོགས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཏི་མུག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཁྲོ་བོའི་སྔགས་བཞིའི་དོན་ཞུས་པའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་མི་འཇིགས་པ་དག་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུས་ལ་སོགས་པར་གཏོགས་པའི་གཅིག་དང་དུ་མ་ལ་སོགས་པ་དང་བྲལ་བའི་ཡུལ་ལ་དང་པོ་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་ནི་གཤིན་རྗེ་མཐར་བྱེད་ཅེས་བྱ་སྟེ།",
    "སྐྱེས་པ་རྣམས་གནས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དད་པ་དང་ལྡན་པའི་བརྩོན་འགྲུས་རྣམ་པ་བཞི་པོ་དེ་རྣམ་པར་དག་པའི་རང་བཞིན་རྒྱལ་བ་ཉིད་ནི་ཤེས་རབ་མཐར་བྱེད་ཅེས་བྱ་སྟེ།",
    "གཟུགས་ལ་སོགས་པར་སོ་སོར་སྣང་བའི་བློ་དངོས་པོ་མེད་པ་སྟེ།",
    "མེད་པར་གྱུར་པའི་དངོས་པོ་ལ་ནི་ཡུལ་མེད་དོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "བརྩོན་འགྲུས་རྩོམ་པར་གྱུར་པ་སྟེ།",
    "དེ་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་ནི་ཁྱབ་བདག་བགེགས་མཐར་བྱེད་པ་ཡིན་ཏེ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་བྱ་བ་གསལ་བར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཏི་མུག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡང་གཏི་མུག་ལ་ཉེ་བར་ལོངས་སྤྱོད་པར་འགྱུར་ཏེ།",
    "གཏི་མུག་ཆེན་པོའི་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣམ་པར་དག་པའི་གཏི་མུག་ལ་བསླབས་པ་ལས་སྐྱེ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་འཇིག་པར་མཛད་པ་དང་།",
    "ཉེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་དང་གཞན་དུ་རྣམ་པར་འབྱེད་པ་དང་བྲལ་བའོ།",
    "ཉེས་པ་དེ་ཉིད་ལ་ཉེ་བར་སྤྱོད་པར་གྱུར་པ་ནི་ཞེ་སྡང་ཆེན་པོའི་བདག་ཉིད་མི་བསྐྱོད་པ་ཡོངས་སུ་དག་པའི་བདག་ཉིད་ལ་བསླབས་པ་ལས་སྐྱེ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་པདྨ་མཐར་བྱེད་ཀྱི་དགོས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་འདོད་ཆགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡང་རྣམ་པར་དག་པའི་ཆགས་པ་ལ་བསླབས་པ་ལས་སྐྱེ་བར་གྱུར་པ་སྟེ།",
    "དེ་ཉིད་ཀྱིས་ན་སྙོམས་པར་འཇུག་པ་མཐར་བྱེད་པར་གྱུར་པ་ནི་རྟ་མགྲིན་ཏེ།",
    "སྨྲ་བ་པོ་དང་བརྗོད་པར་བྱ་བ་གང་ཡིན་པའི་སྙོམས་པར་འཇུག་པ་ནི་ཡུལ་དང་ཡུལ་ཅན་གྱི་མཚན་ཉིད་དུ་འདུས་པ་སྟེ།",
    "དེ་རབ་ཏུ་འཇིག་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནས་ལས་ལས་སྐྱེས་པའི་ཡང་འབྲས་བུ་རྣམ་པར་དག་པར་འགྱུར་ཏེ།",
    "གཟུང་བ་ནི་དེའི་རྣམ་པར་སོ་སོར་ཤེས་པའོ།",
    "མི་གཡོ་བ་ནི་དྲན་པའི་ཚུལ་མི་གཡོ་བ་དེ་ཉིད་དུ་བསྟན་པར་གྱུར་པའོ།",
    "རྒྱུ་ཉིད་ནི་དེ་ཉིད་ཀྱི་གཉིས་སུ་མེད་པའི་རང་བཞིན་གྱིས་འབྲས་བུ་དང་མི་ཕྱེད་པར་སློབ་པའོ།",
    "འདོད་པའི་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འབྱིན་པའི་སྔགས་ཀྱི་སྐབས་ན་མེད་པས་འདི་དག་དཀྱིལ་འཁོར་པ་མ་ཡིན་པར་དགོངས་སོ།",
    "མིང་ལ་སོགས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དམ་ཚིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་སོགས་པ་དྲུག་ནི་མིག་ལ་སོགས་པ་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་དེ།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ཡང་མིང་ལ་སོགས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་དྲུག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་དུ་སྤྱོད་པ་གང་ཞིག་ལགས།",
    "ཞེས་བྱ་བ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཐབས་དང་ཤེས་རབ་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བས་ན་འདི་ཉིད་ནི་མཉམ་པར་མ་གཞག་པ་སྟེ།",
    "བྱ་བ་མ་ལུས་པ་ནི་རྫོགས་པར་བྱ།",
    "དེ་བཞིན་དུ་སྔགས་ཀྱི་སྤྱོད་པ་ཅི་ཞེས་བྱ་བ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྐྱེན་ལས་བྱུང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་འཇིག་རྟེན་གྱི་སྤྱོད་པ་ལས་རྣམ་པར་གྲོལ་བའི་དམ་ཚིག་དང་།",
    "འདིར་ནི་བཟླས་པ་གང་ཞིག་ལགས།",
    "རྣམ་པར་བརྟགས་པའི་དབྱེ་བས་སྔགས་བརྗོད་ལ།",
    "ཇི་ལྟར་ཐུགས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བསྟན་པའི་ཕྱིར་བདག་བྱིན་བརླབ་ལ་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྙེན་པ་ལ་སོགས་པ་ཡན་ལག་བཞི་གསུངས་པ་ཡིན་ནོ།",
    "ཐམས་ཅད་ལ་ཡང་དཀྱིལ་འཁོར་གྱི་བདག་པོ་གཙོ་བོ་རྣམས་ཀྱི་བཞིན་དུ་བསྟན་པར་བྱའོ།",
    "ཕྱག་རྒྱ་གང་ལ་བགྱི་ཞེས་བྱ་བ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་པ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་དད་པ་ལ་སོགས་པ་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་དོ།",
    "མི་གཡོ་བ་དང་མཚུངས་པར་འཁོར།",
    "ཞེས་བྱ་བ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་རྡོ་རྗེ་ཅན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་དག་ཐམས་ཅད་ནི་རྩ་བའི་རྒྱུད་དུ་རྒྱ་ཆེར་གསུངས་སོ།",
    "དབྱེ་བའི་ཁྱད་པར་གྱིས་གསུངས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་གཟུགས་ལ་སོགས་པའི་གཉིས་སུ་མེད་པར་གྱུར་པ་དེ་ཉིད་བསྟེན་པ་ནི་སྡོམ་པ་ཞེས་བྱ་བ་ཡིན་པར་དགོངས་སོ།",
    "རྣམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཞེ་སྡང་གཏི་མུག་ཅེས་བྱ་བ་ལ་སོགས་པའི་ལན་གསུངས་པ་ནི་རྣམ་པ་དང་ནི་ཞེས་བྱ་བ་ནི་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་ནོ།",
    "ཀུན་དུ་འགྲོ་བའི་ཡི་གེ་གསུམ་གྱི་བདག་ཉིད་ཅན་དུ་རྣམ་པར་བསམས་ནས།",
    "གསང་བ་རྣམ་པར་དག་པའི་ཆོ་ག་བཞིན་དུ་ཕྱག་རྒྱས་བཏབ་ན།",
    "འདི་ལྟའི་སྦྱོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གཏི་མུག་སྦྱོར་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདོད་ཆགས་ཅན་གྱི་རྣལ་འབྱོར་པའི་ཡང་ལས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཟླས་པ་དང་སྤྲོ་བའི་ལས་ལ་སོགས་པ་བྱས་ནས།",
    "ཞེ་སྡང་ལ་སོགས་པའི་རྣལ་འབྱོར་པའི་ལས་ཀྱང་རིམ་པ་འདི་ནི་ལེའུ་དགུ་པ་ལས་རྒྱ་ཆེར་གསུངས་པས་དེ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "ཡང་འདི་ལ་ནུས་པ་འདི་ལྟ་བུ་ཡོད་པར་ཇི་ལྟར་ཤེས་ཤེ་ན།",
    "དེའི་ཕྱིར་དཀྱིལ་འཁོར་དང་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་བྷ་ག་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གསུམ་པོ་དཀྱིལ་འཁོར་ཡིན་པར་གསུངས།",
    "ཕྱག་རྒྱ་དགོད་པ་ཇི་ལྟར་ལགས།",
    "དཀྱིལ་འཁོར་གྱི་དོན་འདི་གསལ་བར་བྱ་བའི་ཕྱིར་ཕུང་པོ་སྐྱེ་མཆེད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྲོ་བོ་རྣམས་ཀྱི་ཕྱག་རྒྱ་དགོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལྕགས་ཀྱུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་གཡོ་མགོན་པོའི་ཕྱག་མཚན་ལྕགས་ཀྱུ་ལ་སོགས་པ་རྣམ་པ་བཞི་རིམ་བཞིན་དགོད་པར་བྱའོ།",
    "འོག་ཏུ་བལྟས་པའི་རྩིབས་ལ་གནོད་མཛེས་ཀྱི་རྡོ་རྗེ་དགོད་པར་བལྟ་བར་བྱའོ།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ཕྱག་མཚན་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་བདག་ནི་དེ་ཉིད་དུ་གསལ་བར་བྱས་པ་ཡིན་ནོ།",
    "ཡི་གེ་གསུམ་གྱིས་འབྱིན་པ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "སྐུ་གསུང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་མཆོད་རྟེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
