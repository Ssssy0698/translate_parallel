    "སོར་མོ་ཐམས་ཅད་མཉམ་པར་གཞག་པའི་རྡོ་རྗེ་བསྡམས་པས་སྦྱིདགྲོལ་བར་བྱའོ།",
    "ཡང་གང་གི་ཚེ་བསྒྲུབ་པར་བྱ་བ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ལྷ་མོ་ཡིན་པར་གྱུར་ན།",
    "རང་གི་རིགས་ཀྱི་ལྷའི་ཕྱག་རྒྱ་བཞིའི་ཡེ་ཤེས་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རང་གི་ཡང་ཡིན་ལ་རིགས་ཀྱི་ཡང་ཡིན་པས་ན་རང་གི་རིགས་ཏེ།",
    "གང་གི་མེ་ཏོག་རིགས་གང་དུ་བབ་པ་དེ།",
    "འདིས་ནི་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་ཆོ་ག་སྟོན་ཏོ།",
    "དེ་ལ་རང་གི་རིགས་ཀྱི་ལྷ་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་ཕྱག་རྒྱ་བཞི་ནི།",
    "སྒྲུབ་པ་ཐམས་ཅད་ལ་རང་གི་ལྷའི་སྐུ་ལ་མདུན་དུ་ཕྱག་རྒྱ་བཞིས་རྒྱས་གདབ་པར་བྱའོ།",
    "ཁྱོད་ཉིད་ཀྱང་ངན་སོང་དུ་འགྲོ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ནས་རྡོ་རྗེ་དབབ་པ་བསྐྱེད་ལ་བརྟན་པར་བྱས་ནས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་བཅས་པར་རྡོ་རྗེ་བསྡམས་པ་བཀན་ཏེ་སྐྱིལ་མོ་ཀྲུང་ལ་བཞག་ལ།",
    "དེ་ལྟར་བསྒྱིངས་པ་དང་བཅས་པས་རྡོ་རྗེ་གསོར་བར་མཛད་ཅིང་རྡོ་རྗེ་དེ་རང་གི་ཐུགས་ཀར་བསྟོད་པའི་ཚུལ་གྱེས་འཇོག་པར་མཛད་པ་ནི།",
    "ཅི་འདི་རྟེ་སྐུའི་ཕྱག་རྒྱ་འབའ་ཞིག་གིས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་བསྙེམས་པའི་ཕྱག་རྒྱ་ཆེན་པོ་བསྐྱེད་པར་བྱའམ་ཞེ་ན།",
    "སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་དབྱིབས་པྱཀྱིས་གནས་པ་འདི་ནི་སྐུའི་རྡོ་རྗེའོ།",
    "བཛྲ་སཏྭ་ཞེས་ཟློས་པ་འདི་ནི་གསུང་གི་རྡོ་རྗེའོ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་འདི་དག་གིས་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་རང་ཉིད་འགྱུར་རོ།",
    "དེ་དག་ཉིད་ཀྱིས་བསྐྱེད་ལ་དེ་ཉིད་ཀྱི་བདག་ཉིད་དེའི་ཚུལ་དུ་བསྒོམ་མོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "ས་མ་ཡོལྷ་ཧཾ་ཞེས་བྱ་བས་དམ་ཚིག་གི་སེམས་དཔར་བསྒོམས་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དང་།",
    "དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོ་གྲུབ་པ་འདིས་ཀུན་དུ་འགྲོ་བ་དང་ཞེས་བྱ་བ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་སྐད་ཅིག་མ་གཅིག་གིས་འགྲོ་ཞིང་ཕྱིན་པར་གྱུར་པ་དང་།",
    "རེག་བྱ་རྣམས་ཀྱི་བདག་པོ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་རྫུ་འཕྲུལ་དང་།",
    "ཇི་ལྟར་རི་མོའི་རྗེས་མཐུན་ཞིང་།",
    "རྔོ་ཞེས་བྱ་བ་ནི་བྲི་བར་བྱ་བ་ཡིན་པས་ན་རི་མོ་སྟེ་རྡོ་རྗེ་རྒྱལ་པོ་ལ་སོགས་པ་ཅེནས་རྡོ་རྗེ་འབེབས་པའི་བར་རོ།",
    "ཇི་ལྟར་རི་མོ་བྲིས་པ་བཞིན་དུ་ཤེས་པར་བྱ་༧།",
    "ཇི་ལྟར་རི་མོ་བྲིས་པའི་ཆོ་གར་འདི་རྣམས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་བྲི་བར་གསུངས་པ་དེ་དང་རྗེས་སུ་མཐུན་པར་རྡོ་རྗེ་རྒྱལ་པོ་ལ་སོགས་པ་འདི་རྣམས་ཀྱི་མཚན་མ།",
    "བསྒྲུབ་པ་དང་ཞེས་བྱ་བ་ནི་རང་གི་ལུས་ལ་ཡེ་ཤེས་སེམས་དཔའ་ཇི་ལྟ་བ་བཞིན་དུ་བཅུག་སྟེ།",
    "གཅིག་ཏུ་གྱུར་པ་ལྷག་པར་མོས་པ་སྟེ་སྒྲུབ་ཤཱ་པ་དེས་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་འགྲུབ་པ་ཡིན་ནོ།",
    "ཉིན་རེ་ཞིང་ཞེས་བྱ་བ་ནི་ཉི་མ་རེ་རེ་ཞིང་ངོ།",
    "འདི་ནི་འདིར་བདག་ལ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པ་བྱས་ལ་དེ་ནས་དེའི་རྗེས་ལ་རང་གི་ལུས་ལ་ལྷ་ཐམས་ཅད་བཅུག་སྟེ།",
    "རང་གི་གནས་སུ་བཀོད་ལ།",
    "རང་རང་གི་གནས་སུ་གཞག་པར་བྱའོ།་།",
    "བཛྲ་ཨཱ་བེ་ཤ་ཞེས་བྱ་བའི་ཚིག་ཙམ་ཉིད་ཀྱིས་༡་ཐམས་ཅད་རང་རང་གི་གནས་སུ་བཀོད་ལ།",
    "ཨོཾ་བཛྲ་ཨཱཏྨ་ཀོལྷཧཾ་ཞེས་བརྗོད་ཅིང་བདག་ཉིད་མི་ཕྱེད་པར་བསྒོམ་མོ།་།",
    "ཨོཾ་སརྦ་ས་མོལྷཧཾ་ཞེས་ཟློས་ཤིང་བདག་མེད་པའི་མཉམ་པ་ཉིད་ཀྱིས་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་ལྷ་ཐམས་ཅད་དང་བདག་ཉིད་མཉམ་པར་བསམ་པར་བྱའོ།",
    "རང་གི་ལྷ་མདུན་དུ་བཞུགས་སུ་གསོལ་ཏེ།",
    "རྡོ་རྗེ་ཐལ་མོ་དང་རྡོ་རྗེ་བསྡམས་པ་བསྦུངས་ཏེ།",
    "རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་བོ་ཇི་ལྟ་བ་བཞིན་དུ་བཅིང་བར་བྱའོ།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བརྗོད་དེ་ཡིད་ཀྱིས་ལེགས་པའི་སྤྱོར་བས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་རབ་ཏུ་བསྒྲུབས་ནས།",
    "རིགས་ཀྱི་དམ་ཚིག་གིས་༨་བདག་ཉིད་བྱིན་གྱིས་བརླབས་ཏེ།",
    "རང་གི་ཕྱག་རྒྱ་ཆེན་པོ་ལེགས་པར་བསྒོམས་ལ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་རྣམས་ཀྱི་བསྒྲུབ་པ་ནི་ཡེ་ཤེས་སེམས་དཔའ་དང་ལྷན་ཅིག་ཏུ་གྱུར་པར་ལྷག་པར་མོས་པའོ།",
    "རྡོ་རྗེ་ཐལ་མོ་ནས་བརྩམས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་བཛྲ་ཨཱ་བེེ་ཤ་ཞེས་བྱ་བས་རྡོ་རྗེ་འབེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཆོ་ག་བཞིན་དུ་མདུན་དུ་སེམས་དཔའ་ཆེན་པོ་དེ་བསྒོམ་མོ།",
    "དེ་ཡང་གང་གི་ཕྱིར་དང་པོ་ཁོ་ནར་རྡོ་རྗེ་དབབ་པ་བསྐྱེད་པར་འདོད་པས།",
    "རྡོ་རྗེ་ཐལ་མོ་དང་།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གང་གི་ཕྱིར་ཡེ་ཤེས་སེམས་དཔའ་དེ་མཐོང་ནས་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཡེ་ཤེས་དང་ལྡན་པའི་སེམས་དཔའ་ནི་ཡེ་ཤེས་སེམས་དཔའ་ཡིན་གྱི་ཡེ་ཤེས་ཀྱིས་གཞག་པའི་སེམས་དཔའ་ནི་ཤིན་ཏུ་ཐལ་ཆེས་པས་ཡེ་ཤེས་སེམས་དཔའ་མ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་གི་ལུས་ལ་ཡང་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱས།",
    "རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཡེ་ཤེས་སེམས་དཔའ་རང་གི་ལུས་ལ་བཅུག་ལ།",
    "ད་ནི་རྡོ་རྗེ་རྒྱལ་པོ་ལ་སོགས་པའི་སྒྲུབ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་སེམས་དཔའ་གང་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "འདི་དག་གི་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "ས་མ་ཡོལྷ་༢ཧཾ་ཞེས་བྱ་བས་རྡོ་རྗེ་རྒྱལ་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དང་༡ས་མ་ཡ་སཏྭ་ཨ་བྱེ་ཏིཥྛ་སྭ་རྨཱ་རྩྭཞེས་བྱ་བས།",
    "ཕྱག་རྒྱ་དེ་ཉིད་དང་ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་ཟློས་ཤིང་རང་གི་ལུས་ལ་གཞུག་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རང་གི་ལུས་ལ་གཞུག་པའི་རྣམ་པར་ལེགས་པར་མཉམ་པར་གཞག་པའི་སྤྱོར་བས་ཡིད་ཀྱིས་ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཅུག་ལ་རྡོ་རྗེ་དབྱིངས་ལ་སོགས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཡང་བཅིངས་ཏེ།",
    "རེ་རེ་ཞིང་འདི་སྐད་ཅེས་བརྗོད་དོ།",
    "རང་རང་གི་༩བྱིན་གྱིས་བརླབ་༧པའི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབས་ལ།",
    "རང་གི་ལྷ་བསྒྲུབ་པའི་རྣལ་འབྱོར་ཆེན་པོའི་ཆོ་ག་བརྗོད་པར་བྱ་སྟེ།",
    "རང་གི་ལུས་ལ་ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ།",
    "རང་གི་ལུས་ལས་ཕྱི་རོལ་དུ་བཛྲ་སཏྭ་ཨ་༤ཞེས་བྱ་བས་མདུན་དུ་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རྡོ་རྗེ་སྤྲུལ་ལ།",
    "དེ་བཞིན་དུ་རང་གི་གནས་ན་གནས་པའི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ།",
    "རང་གི་ལུས་ལས་ཕྱི་རོལ་དུ་༩བཛྲ་ཨཱ་བེ་ཤ་ཨ་ཞེས་བྱ་བས་མདུན་དུ་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རྡོ་རྗེ་དྲིལ་བུ་སྤྲུལ་ལ་བཛྲ་གྷཟློཕོ་༡ཧཾ་ཞེས་བྱ་བས་རྡོ་རྗེ་དྲིལ་བུའི་ང་རྒྱལ་བསྒོམ་སྟེ་བཛྲ་ཨཱ་བེ་ཤོལྷ་༡རཱིཧཾ་ཞེས་བྱ་བས་རྡོ་རྗེ་འབེབས་པར་བདག་ཉིད་བསྐྱེད་༧པའོ།",
    "དེ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་དང་པོར་བལྟ་བ་བྱས་ནས།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བརྗོད་དེ་རང་གི་གནས་ན་གནས་པའི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་ན་བཞུགས་པའི་སྐུ་ལ་བཅུག་ལལ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་གཡོན་ལོགས་སུ་སྒེག་མོ་ལ་སོགས་པའོ།",
    "རང་གི་འཁོར་ལོས་སྒྱུར་བའི་སྤྱོར་བ་བྱས་ལ།",
    "གང་གི་ཚེ་དེའི་གཟུགས་སུ་འུགྲུབ་པ་འགྲུབ་པར་འགྱུར་བ་དེའི་ཚེ།",
    "དེ་རྣམ་པར་བསྒོམས་སྣནས་གང་གི་ཚེ་འགྲུབ་པར་གྱུར་ན་ཡང་དེ་བཅིངས་ནས་བསྒོམས་པ་དེའི་ཚེ།་",
    "རེ་བ་རྣམས་ནི་ཡོངས་སུ་སྐོང་།་",
    "ཡང་དེ་ཉིད་བསྟེན་ན་རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཤེས་རབ་ཀྱིས་༢ཉོན་མོངས་པ་དང་།",
    "རྡོ་རྗེ་གསུང་གི་ཆོ་ག་ཡིས།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ལས་མཆོག་གི་ཕྱག་རྒྱ་ཆེན་པོ་ཡང་དག་པར་བསྒྲུབས་པས་སོ།",
    "གང་གིས་ཤེ་ན།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་སྒེག་མོའི་ཕྱག་རྒྱ་ཕྱཆེན་པོ་གང་ཡིན་པ་དེ་བསྒྲུབས་སོ།",
    "དེ་བཅིངས་པ་ནི་གང་གིས་བཅིངས་ཤིང་བསྡམས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ལྕགས་སྒྲོག་གི་ཕྱག་རྒྱ་ཆེན་པོ་ཡང་དག་པར་བསྒོམས་༡་པས་སོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་འདི་དག་གི་རང་གི་ངོ་བོ་ནི་དཀྱིལ་འཁོར་ཆེན་པོ་བྲི་བའི་ཆོ་ག་བསྟན་པ་ཡིན་ནོ།",
    "ཐལ་མོ་དམ་དུ་སྦྱར་བ་ལས།",
    "ཞེས་བྱ་བ་ནི་ཐལ་མོ་ཁོང་སྟོང་དུ་དམ་དུ་བྱས་པའོ།",
    "སོར་མོ་ཐམས་ཅད་བསྣོལ་བ་ནི།",
    "ཞེས་བྱ་བ་ནི་སོར་མོ་ཐམས་ཅད་ཚིགས་ཧཱུཾགསུམ་པ་ཕན་ཚུན་བསྣོལ་བ་ནི་རྡོ་རྗེ་ཐལ་མོའིའོ།",
    "རྡོ་རྗེ་ཐལ་མོ་དེ་ཉིད་ཀྱི་སོར་མོ་ཐམས་ཅད་གཅིག་ལ་གཅིག་གི་ལག་པའི་རྒྱབ་ཏུ་བཅར་བར་རོ།",
    "ཨ་བྱོ་ཏྱཱ་ཧཱུཾནུ་ག་ཏ་སཏྠ་དྷནྡྲ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཐལ་མོ་སྦྱར་བའི་སྔགས་སོ།",
    "པ་རསྤ་ཐུར་ཨ་ནུ་པྲ་བིཥྚ་སརྦ་དྷཛྲེ་བཛྲ་ཨཉྫ་སྙེལི་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཐལ་མོའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ཐམས་ཅད་ཅེས་བྱ་བ་ནི།",
    "གུང་མོ་མྱུ་གུ་ལྟར་མཉམ་བསྒྲེང་།",
    "འདི་སྐད་སྟོན་ཏེ་རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་བརྐྱང་སྟེ་སྦྱར་ལ་རྩེ་མོར་བྱས་པ་ནི་སེམས་མ་རྡོ་རྗེ་མའི་རིགས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "གུང་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སེམས་མ་རྡོ་རྗེ་མའི་སོར་མོ་༥གུང་མོ་གཉིས་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཀུག་པ་གང་ཡིན་པ་དེ་ནི།",
    "གུང་མོ་ནང་དུ་གཤིབས་པ་ནི།",
    "ཅེས་བྱ་བ་ནི་སེམས་མ་རྡོ་རྗེ་མ་དེ་ཉིད་ཀྱི་གུང་མོ་ལྟོ་བ་ཕན་ཚུན་པདྨ་ལྟ་བུར་བཀུག་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "དེ་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སེམས་མ་རྡོ་རྗེ་མ་དེ་ཉིད་དེ་བཞིན་དུ་གནས་པ་ལ་མཛུབ་མོ་གཉིས་བཀུག་སྟེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནི་སྤྱིར་ཚིག་གི་ཕྲད་ཡིན་པ་ལས་དེ་མ་ཐག་པ་ལ་འཇུག་སྟེ།",
    "ལྷ་མོ་སེམས་མ་རྡོ་རྗེ་མ་ནས་རྡོ་རྗེ་འབེབས་པའི་བར་གྱིའོ།",
    "གང་གི་ཕྱིར་དེ་རྣམས་ཀྱི་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་ཡེ་ཤེས་སེམས་དཔའ་རྣམས་དཀྱིལ་འཁོར་དང་སྔོན་དུ་བསྙེན་པ་ལ་སོགས་པའི་དུས་སུ་སྒྲུབ་པ་པོས་སྤྱན་དྲངས་ནས།",
    "གུང་མོའི་སོར་མོ་བཏང་༦གྱུར་པའི།",
    "གུང་མོ་ཡང་ཡིན་ལ་སོར་མོ་ཡང་ཡིན་པས་གུང་མོའི་སོར་མོ་སྟེ།",
    "དེ་བཏང་བར་གྱུར་པ་ནི་རྡོ་རྗེ་བསྡམས་པ་བྱས་པའི་ལག་པ་གཉིས་ཀྱིས་ཟླ་བའི་གུང་མོ་གཉིས་བཏང་བར་གྱུར་པའོ།",
    "གང་གི་ཕྱིར་མཐེ་བོ་དང་མཐེའུ་ཆུང་སོ་སོར་བསྒྲེང་སྟེ་གཞུག་ཆོཔ་སྟེ་མ་འབྱར་པའོ།",
    "དེ་དག་ནི་ཐུསོར་མོ་ཡང་ཡིན་ལ་ཐ་མ་ཡང་ཡིན་པས་ན་སོར་མོ་ཐ་མ་སྟེ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་རྩེ་མོར་བྱས་པའི་མཚན་ཉིད་ཀྱིས་སོ།",
    "གུང་མོ་གཉིས་གཤིབས་ལ་བགྲེང་སྟེ།",
    "མཛུབ་མོ་གཉིས་དང་སྲིན་ལག་གཉིས་རྡོ་རྗེ་བསྡམས་པར་གཞག་པ་དང་བཅས་པ་ཉིད་དུ་བྱ་བ་༦ཡིན་པས་ན།",
    "མཛུབ་མོ་ལྕགས་ཀྱུ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བསྡམས་པ་ལས་མཛུབ་མོ་གཉིས་ལྕགས་ཀྱུ་ལྟ་བུར་བྱས་པ་གང་ཡིན་པ་དེ་ནི་མཛུབ་མོ་ལྕགས་ཀྱུ་སྟེ།",
    "མཛུབ་མོ་སྦྱར་བ་ནི་རྡོ་རྗེ་བསྡམས་པ་ལས་མཛུབ་མོ་གཤིབས་ཏེ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཛུབ་མོ་གཉིས་བསྒྲེང་ཞིང་མཇེ་བོ་གཉིས་ཀྱང་བསྒྲེང་བ་བྱས་ནས།",
    "གཞན་དག་ཏུ་དམ་ཚིག་གི་ཕྱག་རྒྱས་རང་གི་ལྷ་བསྒྲུབ་པར་བྱའོ།",
    "མཐེ་བོ་གཤིབས་ལ་མཛུབ་མོ་གཉིས་བཅག་ལ་རྩེ་སྤྲད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོ་གཉིས་གཤིབས་ཏེ་བསྒྲེང་ལ་མཛུབ་མོ་གཉིས་བཀུག་སྟེ་ང་།",
    "དེ་ལས་གུང་མོ་དང་སྲིན་ལག་དང་མཐེའུ་ཆུང་ཤིན་ཏུ་སྟེ།",
    "གུང་མོ་བསྒྲེང་བའི་སྟིརྩེ་མོ་བཀུག།",
    "གུང་མོ་གཉིས་གཤིབས་ཏེ་བསྒྲེང་ལ་ཚིགས་གསུམ་པར་བཅག་ལྡུ།",
    "ནས་རྩེ་མོ་ཕན་ཚུན་བཀུག་ལ་ཕན་ཚུན་ལྟོ་སྦྱར་ཏེ།",
    "རྡོ་རྗེ་བསྡམས་པའི་མཛུབ་མོ་གཉིས་ལེགས་པར་བརྐྱང་བ་ལས།",
    "མཐེའུ་༡ཆུང་གཉིས་གཤིབས་ཏེ་བརྐྱང་ལ་རྩེ་མོར་བྱས་པ་གང་ཡིན་པ་འདི་ནི་རྡོ་རྗེ་གནོད་སྦྱིན་གྱིའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་ལག་པ་གཉིས་ཀའི་སྲིན་ལག་མཐེའུ་ཆུང་གི་ཚིགས་ཀྱི་རྩ་གཤིབས་པའི་ནང་དུ་མཐེ་བོའི་རྩེ་མོ་གཉིས་བཞག་ལ།",
    "མཛུབ་མོ་གཉིས་བཀུག་སྟེ་རང་རང་གི་མཐེ་བོའི་རྒྱབ་རང་རང་གི་མཛུབ་མོའི་སྟོ་བཙིར་བ་འདི་ནི་རྡོ་རྗེ་ཁུ་ཚུར་ཀྱིའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་བྱུང་བའི་རྡོ་རྗེ་ཐལ་མོ་ནི་རྡོ་རྗེ་ཐལ་མོའི་མཆོག་སྟེ་དམ་པའོ།",
    "ཐལ་མོའི་མཆོག་ནི་ཁ་ནས་འབྱུང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་བྱུང་བའི་གར་བྱས་ལ་ཐལ་མོ་སྦྱར་བ་སྤྱི་བོར་གཞག་པ་ནི་གར་མའིའོ།་།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བསྡམས་པ་བདུག་སྤོས་འབུལ་བའི་ཚུལ་དུ་ཐུར་དུ་དྲུགས་༤པ་ནི་བདུག་པ་མའིའོརང་གི་ཐལ་མོ་སྦྱར་ཏེ་གྱེན་དུ་གཏོར།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བསྡམས་པ་ལས་བྱུང་བའི་མེ་ཏོག་གི་ཐལ་མོ་བྱས་པའི་ཐལ་མོ་དེ་མེ་ཏོག་འབུལ་བའི་ཚུལ་དུ་གྱེན་དུ་འཐོར་བ་ནི་མེ་ཏོག་མའིའོ།",
    "མཛུབ་མོ་གཅིག་ཏུ་བཀུག་པ་དང་།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བསྡམས་པ་ལས་གཡས་པའི་མཛུབ་མོ་བསྒྲེང་ལ་ལྕགས་ཀྱུ་ལྟ་བུར་བཀུག་པ་འདི་ནི་རྡོ་རྗེ་ལྕགས་ཀྱུའིའོ་༥།",
    "མཐེ་བོང་མཛུབ་མོ་གདུ་༧བུར་བཅིངས།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བསྡམས་པའི་མཇེ་བོང་དང་མཛུབ་མོ་གཉིས་ལྕགས་སྒྲོག་བཅིངས་པ་༡ལྟར་བྱ་བ་ནི་རྡོ་རྗེ་ལྕགས་སྒྲོག་གིའོ།",
    "རྡོ་རྗེ་བཅིང་བ་༢མཛུབ་མོ་བསྡམས།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་རྡོ་རྗེ་མཚམས་སྦྱོར་དུ་བྱས་པ་ནི་རྡོ་རྗེ་འབེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དེ་ནས་འདི་རྣམས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དབྱིངས་ལ་སོགས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་འདིས་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་ན་བསྒྲུབ་པ་སྟེ།",
    "དེ་ཉིད་བསྟན་པ་ནི་རང་གི་ཕྱག་རྒྱ་ཞེས་བྱ་བ་སྟེ།",
    "རྡོ་རྗེ་འཆང་བར་གྱུར་པ་ནི་རིན་ཆེན་དབལ་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "རེ་བ་ཀུན་ཡང་རྫོགས་པར་བྱེད།",
    "དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་༧བཅིངས་པས་སོ།",
    "དེའི་དམ་ཚིག་གི་སྤྱོཕྱག་རྒྱ་ཡང་རྡོ་རྗེ་རལ་གྲིའོ།",
    "དེ་ཐོགས་པ་ནི་ཡང་དག་པར་བཅིངས་པས་ཉོན་མོངས་པ་ཐམས་ཅད་དེས་གཅོད་དོ་ཞེས་པའོ།",
    "དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དམ་པོར་བབྱུངས་ནས་བསྒོམས་པས་བརྟན་པོར་བསྐྱེད་པའོ།",
    "རྡོ་རྗེ་སྨྲ་བའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་དེའི་ངོ་བོར་བསྒོམས་པ་ནི་རྡོ་རྗེ་སྨྲ་བའི་སྤྱོར་བའོ།་",
    "རྡོ་རྗེ་ལས་ཀྱི་དམ་ཚིག་གི་༧ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་ལས་སོ།",
    "རྡོ་རྗེ་གོ་ཆའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་གོ་ཆ་སྟེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་མཆེ་བ་མཆོག་གི་ཕྱག་རྒྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྟརྒྱ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་རོ།",
    "འདི་སྐད་སྟོན་ཏེ་རྡོ་རྗེ་འབེེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་བདག་ཉིད་ལ་དབབ་པ་བྱས་ལ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ལ་སོགས་པའི་ཕྱག་རྒྱ་ཐམས་ཅད་བཅིང་བར་༡་བྱའོ།",
    "དེ་ཡང་བཛྲ་ཨཱ་བེ་ཤ་ཞེས་བྱ་བས་༧་རྡོ་རྗེ་འབེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་ཨ་སཞེས་བྱ་བས་བདག་ཉིད་ལ་དབབ་པར་བྱའོ།",
    "དེ་ནས་བཛྲ་མུཥྚི་ཞེས་བྱ་བས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིང་བར་སྣབྱ་སྟེ།",
    "འཛུམ་པས་སྣཞེས་བྱ་བ་ནི་སྒེག་མོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་རང་བཞིན་གང་ཡིན་པ་དེས་ནི་ལྷའི་དགའ་བ་རྣམས་ཏེ།",
    "གླུ་མས་༥ཞེས་བྱ་བ་གླུ་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་ནི་རྟག་ཏུ་སྐད་གསལ་བར་འགྱུར་རོ།",
    "བདུག་པས་ཞེས་བྱ་བ་ནི་བདུག་པ་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་ནི་འཇིག་རྟེན་ཚིམ་༨པར་བྱེད་པར་འགྱུར་རོ།",
    "མེ་ཏོག་གིས་ནི་ཞེས་བྱ་བ་མེ་ཏོག་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་ནི་མཛེས་པའི་གཟུགས་ཐོབ་པར་འགྱུར་རོ།",
    "དྲི་ཡིས་ཞེས་བྱ་བ་ནི་བྱུག་པ་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་ནི་ལྷ་རྗས་ཀྱི་དྲི་རྙེད་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ལྕགས་ཀྱུ་ནི་རྡོ་རྗེ་ལྕགས་ཀྱུའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་ཞགས་པས་ནི་རྡོ་རྗེ་ཞགས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་ནི་རྡོ་རྗེ་བེེགས་སྒོག་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ་དེས་ནི་འཆིང་བར་བྱེད་དོ།",
    "རྡོ་རྗེ་དྲིལ་བུ་ནི་རྡོ་རྗེ་འབེེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་ཟློས་པ་པོས་རང་བཞིན་གྱིས་དག་པར་མོས་པས་ལྕེ་ལ་རྡོ་རྗེ་དཀར་པོར་༤བསམ་པར་གང་གི་ཚེ་བཛྲ་ཛྙཱ་ན་ཞེས་བྱ་བ་དགོད་པར་བྱས་པ་དེའི་ཚེ།",
    "ཆོ་ག་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ལྷ་རྣམས་དམ་ཚིག་གི་ཕྱག་རྒྱས་བསྒྲུབས་ནས།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་སྤྱོད་པའི་ངོ་བོ་སྟེ་རྡོ་རྗེ་ལེགས་པའིའོ།",
    "བུདྡྷཱ་བོ་བྱེ་ཞེས་བྱ་བ་ནི་རྫུ་འཕྲུལ་ཀྱི་རྐང་པ་ཐུགས་སུ་ཆུད་པས་རྡོ་རྗེ་དབྱིངས་ལ་སོགས་པའི་དཀྱིལ་འཁོར་ཆེན་པོ་རྫོགས་པར་མཛད་དེ།",
    "དེ་ལྟ་བུ་གང་ཡིན་པ་དེ་ནི་ཁྱོད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཤ་ཧཱུཾ་བྷཀྵ་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་པའི་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་དང་།",
    "སུ་གནྟ་གི་ཞེས་བྱ་བ་བྱུག་པ་༤མའི་གང་ཡིན་པ་དེས་ནི་དྲིའི་མཆོག་ཉིད་སྦྱིན་པར་བྱེད་དོ།",
    "ཏེ་སྒོ་ཊ་བཾ་ལྕགས་སྒྲོག་གིའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་ཞེས་བྱ་བ་ནི་དམ་ཚིག་གི་རྡོ་རྗེ་ཁུ་ཚུར་རོ།",
    "མཉམ་པར་གཞག་པས་ཞེས་བྱ་བ་ནི་རང་གི་ལྷ་ལ་དམིགས་པའི་སེམས་ཀྱིས་སོ།",
    "གང་གིས་གཟུང་ཞེ་ན།",
    "མི་གཡོ་བ་ཡི་ས་རེག་པ།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སོར་མོ་ཐམས་ཅད་བརྐྱངས་པས་ས་ལ་རེག་པའི་ཚུལ་དུ་བྱ་བ་ནི་ས་ལ་རེག་པའོ།",
    "སོར་མོ་ཐམས་ཅད་བརྐྱང་ལ་མཆོག་སྤྱིན་པའི་ཚུལ་དུ་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་༦སོར་མོ་ཐམས་ཅད་བརྐྱང་ལ་ལྕུང་བཟེད་འཛིན་པའི་ཚུལ་དུ་ཕན་ཚུན་མཇེ་བོའི་རྩེ་ལ་ཕྲད་པར་གཞག་པའོ།",
    "གཡས་པའི་སོར་མོ་ཐམས་ཅད་བརྐྱང་ལ་མི་འཇིགས་པ་སྦྱིན་པའི་ཚུལ་དུ་བྱའོ།",
    "རྣ་བ་ལ་ཐུག་གི་བར་དུ་གཞུ་འདྲེན་པའི་ཚུལ་དུ་བྱས་ནས།",
    "གཡོན་པ་ལ་ནི་གྲུ་མོ་གཟུགས།",
    "ཞེས་བྱ་བ་ནི་གཡོན་པའི་རྡོ་རྗེ་ཁུ་རྫོ་ཚུར་ལ་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་༡གྲུ་མོ་གཟུགས་པ་ནི་རྡོ་རྗེ་དབལ་གྱིའོ།",
    "དེས་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བསྐོར་བ་དེ་ལས་བྱུང་བའི་ཐལ་མོ་སྦྱར་བ་སྤྱི་བོར་ཡང་དག་པར་བཞག་ན།",
    "མཐར་ཐལ་མོའི་རྟིང་བ་བརྡབས་པས་མཉེས་པར་བྱས་ལ།",
    "བསམ་པ་༧གཡོས་པས་ཞེས་བྱ་བ་སྨོས་པའི་ཁྱད་པར་ཀྱིས་མདུད་པར་བྱ་བ་ནི་སྒེག་མོའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་ལྕགས་ཀྱུ་བཅིང་བ་ནི།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་ལྕགས་ཀྱུར་བྱའོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་མཐེའུ་ཆུང་ལྕགས་ཀྱུར་བྱས་པའི་ལྕགས་ཀྱུ་གཡས་པའི་མཛུབ་མོའི་ལྕགས་ཀྱུའི་རྩ་བ་དགུག་པར་བཅིང་སྟེ།",
    "མཁྲིག་མ་མདུད་པ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ལ་གཅིག་ལ་གཅིག་གི་མཁྲིག་མའི་གནས་ཀྱི་རྒྱབ་ཀྱི་ཆ་སྦྱར་བ་དེ་ལྟ་བུ་ནི་མཁྲིག་མ་མདུད་པར་གྱུར་ཏེ།",
    "ཕན་ཚུན་ལྕགས་སྒྲོག་བཅིང་བའི་ཚུལ་དུ་བྱ་བ་འདི་ནི་མཛུབ་མོ་གཉིས་གདུ་བུར་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་གིའོ།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་དེ་ཉིད་དེ་དག་གི་ཕྱག་རྒྱ་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "ཞེས་བྱ་བ་རྡོ་རྗེ་འབེབས་པའི་དམ་ཚིག་གི་ཁུ་ཚུར་ནི།",
    "སྤྱི་ཞེས་བྱ་བ་ཐུན་མོང་དུ་གྱུར་པའི་བཅིང་བའི་ཆོ་ག་རྒྱས་པ་ཡིན་པས་ཕྱག་རྒྱ་བཅིང་བའི་ཆོ་ག་རྒྱས་པ་ཞེས་བྱ་སྟེ།",
    "རྡོ་རྗེ་དབབ་པའི་དམ་ཚིག་གི་ཁུ་ཚུར་གྱི་ཕྱག་རྒྱ་བཅིངས་པ་ཉིད་ཀྱིས།",
    "༥ཐལ་མོ་སྦྱར་བ་དང་།",
    "རྡོ་རྗེ་ཐལ་མོ་དང་།",
    "ཁམས་གསུམ་པའི་འདོད་ཆགས་ལ་སོགས་པ་བག་ཆགས་ཀྱིས་འཆིང་བ་གཞིག་པར་༧དཀ་རེ་བ་སྟེ།",
    "རང་རང་གི་ལུས་དང་ངག་དང་སེམས་རྡོ་རྗེ་ནི་རྣལ་འབྱོར་པའིའོ།",
    "རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་རང་གི་རིགས་ཀྱི་མཚན་མའི་ཉེ་བར་མཚོན་པ་ཙམ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ནས་བབས་ནས་གྲོགས་པོ་ཉིད་དུ་ཉེ་བར་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་རང་གི་རིགས་ཀྱི་མཚན་མའི་ཁྱད་པར་གྱི་གཟུགས་ཀྱིས་བབས་ཤིང་ཡང་དག་པར་ཀུན་དུ་ཞུགས་ནས་གྲོགས་པོ་ཉིད་དུ་ཉེ་བར་གནས་པར་འགྱུར་ཏེ།",
    "བཛྲ་མུཥྚི་ཞེས་བྱ་བས་རྡོ་རྗེ་ཁུ་ཚུར་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་༦ནས།",
    "གང་གི་ཕྱིར་རྒྱུད་འདི་ཉིད་ལས།",
    "དེ་ནས་ཕྱག་རྒྱའི་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོ་རྗེས་སུ་དྲན་པར་བྱ་སྟེ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་བསྐྱེད་པའི་རྒྱུ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཕྱག་རྒྱའི་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོ་སྟེ།",
    "བཛྲ་སཏྭ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཟློས་པས་ཀྱང་རིགས་ཀྱི་སྒོམ་༧པ་པོས་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱ་བ་ཡིན་ཏེ།",
    "རང་གི་ཕྱག་རྒྱ་བཅིངས་ནས་ཞེས་བྱ་བ་ནི་རང་གི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་རང་གི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་བཅིང་བ་ནི་རང་གི་ཕྱག་རྒྱ་བཅིང་བའོ།",
    "རང་གི་ཕྱག་རྒྱའི་སེམས་དཔའ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེའི་ངོ་བོ་སྟེ།",
    "དེ་ལྟར་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་རང་གི་ལྷའི་ངོ་བོར་བདག་རྣམ་པར་བསྒོམས་ནས་རང་གི་ལྷའི་རྣལ་འབྱོར་བརྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་གི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ཀྱིས།",
    "ས་མ་ཡ་སཏྭ་ཨ་བྱེ་ཏིཥྛ་སྭ་མོ་ཞེས་བྱ་བ་ཡིན་ཏེ།",
    "ས་མ་ཡ་སཏྭ་ཞེས་བྱ་བ་ནི་དམ་ཚིག་གི་སེམས་དཔའ་ཞེས་བོད་པའོ།",
    "བཛྲ་དྷཱ་ཏུ་ཞེས་ཟློས་ཤིང་རང་གི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིང་བར་བྱའོ།",
    "དེ་བས་ན་འདིས་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།་",
    "རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "དེ་ཉིད་རང་གི་ལུས་ལ་དགུག་པ་དང་།",
    "སེམས་དཔའ་ཆེན་པོ་དེ་བསྒོམ་མོ།",
    "ནོར་བསྒྲུབ་པར་འདོད་པས་རང་གི་ལྷའི་སྤྱོར་བ་རྗེས་སུ་སྤྱད་ནས་ཇི་སྐད་གསུངས་པའི་ཚུལ་གྱིས་རྡོ་རྗེའི་དངོས་གྲུབ་ལ་སོགས་པ་བསམ་པ་ཉིད་དང་།",
    "དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་སྔོན་དུ་འགྲོ་བ་དང་།",
    "རིགས་ཐམས་ཅད་ཀྱི་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཐུན་མོང་དུ་གྱུར་པའོ།",
    "རང་གི་ལུས་དང་ངག་དང་།",
    "གང་གི་ཚེ་བརྟན་པར་བྱ་ཞེ་ན།",
    "དེའི་ཚེའམ་བདག་གཏོང་བར་འདོད་ན་ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་བསྒོམས་པས་ཡོངས་སུ་དུབ་པར་གྱུར་ན་ཕྱག་རྒྱ་འདི་དགྲོལ་བར་འདོད་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའི་དངོས་གྲུབ་ཅེས་བྱ་བ་ནི་སེམས་དཔའ་བཅུ་དྲུག་གི་དངོས་གྲུབ་ལ་རྡོ་རྗེ་སེམས་དཔའི་དངོས་གྲུབ་ཅེས་བྱའོ།",
    "བར་དུ་ཞེས་བྱ་བའི་སྒྲ་ནི་སྒེག་མོ་ལ་སོགས་པའི་དངོས་གྲུབ་ནས།",
    "དམ་ཚིག་བཅིང་བས་བཅིངས་པ་རྣམས་དམ་ཚིག་གི་འཆིང་བ་དང་བྲལ་བ་ནི་དགྲོལ་བའོ།",
    "སྤྱི་གཙུག་གི་གནས་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་སུ་བཛྲ་དྷྭ་ཏུ་ཞེས་ཟློས་ཤིང་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་བཛྲ་མུ་ཞེས་བྱ་བས་རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་སུ་དགྲོལ་༤ལ།་",
    "མཛུབ་མོ་གཉིས་ཀྱིས་༡ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེ་བཞིན་དུ་མཛུབ་མོ་གཉིས་ཀྱིས་དེ་རྣམས་ལ་གོ་ཆ་བཅིང་བར་བྱ་ཞིང་།",
    "མཉམ་པའི་ཐལ་མོས་མཐར་མཉེས་པར་བྱའོ།",
    "གང་གི་ཕྱིར་རྡོ་རྗེ་སེམས་དཔའ་ལྷན་ཅིག་ཅེས་བྱ་བ་གསུངས་ཏེ།་",
    "དེ་ལྟར་རང་གི་རྒྱུད་ཀྱི་ཆོ་ག་གསུངས་ནས།",
    "རང་གི་ལྷས་རང་གི་བསྒྲུབ་པ་གསུངས་པ་གང་ཡིན་པ་དེ་ནི་རང་བྱས་པ་ཞེས་བྱ་སྟེ།",
    "རང་གིས་བྱས་པ་དེས་ཀྱང་ངོ།",
    "རྡོ་རྗེ་གླུ་ལེན་ཅིང་རེ་རེ་ཞིང་རྡོ་རྗེ་༤ཁུ་ཚུར་གཉིས་ལས་བྱུང་བའི་གར་བྱས་ལ།་",
    "སྒེག་མོ་ལ་སོགས་པའི་ཚུལ་དུ་རྣལ་འབྱོར་པས་བསྒོམས་པ་གང་ཡིན་པ་དེ།",
    "སྒེག་མོ་ལ་སོགས་པའི་གནས་སུ་ཡིད་ཀྱིས་གཞག་པ་ལ་གཞན་གྱིས་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "ཇི་ལྟར་ཞུགས་པའི་རྣམ་པ་ཞེས་བྱ་བ་བསམ་པ་གང་ཞིག་གིས་ཞུགས་པ་སྟེ།",
    "འདི་ཞེས་བྱ་བ་ནི་རང་གི་ལག་ན་གནས་པར་གསུངས་པའོ།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
    "དེ་བས་ན་དེའི་གོ་འཕང་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཁྱོད་ཀྱིས་ཀྱང་རྟག་ཏུ་བཅང་བར་བྱའོ།",
    "འདི་གང་གི་བརྟུལ་ཞུགས་ཡིན་ཞེ་ན།",
    "གང་གི་ཕྱིར་སྐལ་བ་ཇི་ལྟ་བ་བཞིན་དུ་བག་ཆགས་བསྒོ་བ་ལ་སོགས་པ་དང་།",
    "ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་༦བདག་སྤྱན་འདྲེན་པར་བགྱིད་པ་དེའི་ཚེ།",
    "དམ་ཚིག་མཆོག་གི་ཕྱག་རྒྱ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་རྒྱ་རྣམས་སོ།",
    "སྦྱིན་སྲེག་༤གི་དེ་ཁོ་ན་ཉིད་བསྟན་པ་ལས།",
    "གང་གི་ཕྱིར་དཀྱིལ་འཁོར་གཟུགས་ཅན་དང་གཟུགས་ཅན་མ་ཡིན་པ་༥་འདིར་བསྟན་ལ།",
    "དེ་དག་གི་དེ་ཁོ་ན་ཉིད་དོ།",
    "སྦྱིན་སྲེག་གི་དེ་ཁོ་ན་ཉིད་ཡིན་པར་བསྟན་ཏོ།",
    "ཞེས་བྱ་བའི་གཞུང་གིས་ནི།",
    "བཛྲ་སཏྭ་མུ་ཞེས་བྱ་བའི་བར་ཀྱི་༥གཞུང་གིས་ནི།",
    "གཞན་དག་ནི་དེ་ཁོ་ན་ཉིད་དགུ་པོ་འདི་དག་གི་ཡུལ་དང་བྲལ་བའི་གཞུང་གིས་ཆོ་གའི་དེ་ཁོ་ན་ཉིད་སྟོན་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་འདི་དག་ཀྱང་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པའི་ཚུལ་གྱིས་ན།",
    "ད་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཆེན་པོ་གཙོ་བོར་གྱུར་པ་གཟུགས་ཀྱི་དཀྱིལ་འཁོར་སྟོན་པར་བཞེད་པས།",
    "དེའི་དམ་ཚིག་ནི་རྡོ་རྗེའི་གཟུགས་ཀྱི་ལྷ་མོ་ལ་སོགས་པའི་སྐུའོ།",
    "གཟུགས་ཀྱི་ལྷ་མོ་སྤྲུལ་པའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།་།",
    "རྡོ་རྗེ་གཟུགས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་༨ལྷ་མོ་རྣམས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྡོ་རྗེ་རྩེ་ལྔ་པ་ལ་སོགས་པ་ནས་རྡོ་རྗེ་དྲིལ་བུའི་བར་གྱི་གཟུགས་ཏེ།",
    "དེས་ཉེ་བར་མཚོན་པའི་ལྷ་མོ་རྣམས་ནི།",
    "ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་ལྷ་མོ་རྣམས་སོ།",
    "དེ་རྣམས་སུ་གྱུར་པ་ནི་ཀུན་དུ་བཟང་པོ་ལ་སོགས་པ་ནས་རྡོ་རྗེ་འབེེབས་པའི་བར་གྱི་གཟུགས་རིག་ཁུ་པའི་ལྷ་མོ་རྣམས་སུ་གྱུར་ཏོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟ་བུའི་རྡོ་རྗེའི་གཟུགས་ཁྲུ་ཀྱི་ལྷ་མོ་དམ་ཚིག་གི་ཕྱག་རྒྱའི་ལྷ་མོ་རྣམས་སུ་གྱུར་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ལས་བྱུང་སྟེཔྱ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཚིག་གི་ཕྱག་རྒྱའི་གཟུགས་སུ་གྱུར་ནས་ཞེས་བྱ་བ་ནི།",
    "ཀུན་དུ་བཟང་མོ་ལ་སོགས་པའི་ལྷ་མོའི་གཟུགས་མི་སྣང་བར་བྱས་ནས་རྡོ་རྗེ་ལ་སོགས་པའི་གཟུགས་སུ་སྤྱོསྤྲུལ་ཏེ།",
    "ཉོན་མོངས་པ་བག་ཆགས་དང་བཅས་པ་སྤངས་པ་ཉིད་ཀྱི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་༡ཀྱིས་མི་བསྐྱོད་པ་ཡིན་ན།",
    "བུད་མེད་གཟུགས་སུ་མཛད་པར་འགྱུར།",
    "ཞེས་བྱ་བ་དེ་དོན་ཡོད་པ་མ་ཡིན་ཞིང་ཉོན་མོངས་པ་སྤངས་སུ་ཟིན་ཀྱང་།",
    "དེའི་ཏིང་ངེ་འཛིན་གང་གིས་བྱིན་གྱིས་རློབ་ཅིང་བརྟན་པར་བྱེད་པ་དེ་ནི་བྱིན་ཀྱིས་བརླབ་པ་ཞེས་བྱ་བའི་༥ཏིང་ངེ་འཛིན་ཏེ་༦དེ་ལ་སྙོམས་པར་ཞུགས་པ་ནི།",
    "དེ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཡེ་ཤེས་ནི་མི་བསྐྱོད་པའི་རིགས་ཀྱི་ཕྱག་རྒྱ་བསྐྱེད་པའི་༩རང་བཞིན་ཏེ།",
    "དེ་གང་གི་བྱེན་གྱིས་བརླབ་པ་ནི་དེ་བྱིན་གྱིས་བརླབ་པའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཡེ་ཤེས་ནི་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "གཤེགས་པ་ཐམས་ཅད་ཀྱི་ལས་ཀྱི་དམ་ཚིག་གི་ཧཱུཾཡེ་ཤེས་སོ།",
    "དེ་རྣམས་ལས་བྱུང་བའི་སྣ་ཚོགས་རྡོ་རྗེ་ལ་སོགས་པའི་ཕྱག་རྒྱ་རྣམས་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ལས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཏིང་ངེ་འཛིན་གང་གིས་བྱེན་གྱིས་བརླབ་པ་དེ་ནི་དེ་བྱིན་གྱིས་བརླབ་པ་ཞེས་བྱ་ལྒེ་སྟེ།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་སྙོམས་པར་ཞུགས་ནས་རང་གི་རིག་པའི་མཆོག་འདི་སྨྲས་སོ་ཞེས་རེ་རེ་ཞིང་ཀུན་ལ་ཡང་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཟུངས་ཆེན་པོ་ནི་ཀུན་དུ་བཟང་མོ་ལ་སོགས་པ་སྟེ།་",
    "ཀུན་དུ་བཟང་མོ་ཞེས་བྱ་བ་ནི་ཀུན་ནས་བཟང་བ་སྟེ།",
    "བྱམས་པའི་སྦྱིན་པ་སྟོན་པར་བྱེད་པའི་རྒྱལ་མཚན་གྱི་ཕྱག་རྒྱ་ནི་རྒྱལ་མཚན་གྱི་རྩེ་མོའོ།",
    "དེའི་དཔུང་རྒྱན་ཀྱིས་ཉེ་བར་མཚོན་པ་གང་ཡིན་པ་དེ་ནི་རྒྱལ་མཚན་གྱི་རྩེ་མོའི་དཔུང་རྒྱན་མའོ།",
    "ཀུན་ནས་འཛིན་ཅིང་དེ་བཞིན་དུ་ཉོན་མོངས་པ་དང་།",
    "དངོས་གྲུབ་ཀྱི་གཙོ་མོའོ།",
    "བགེགས་དང་ལོག་འདྲེན་ཐམས་ཅད་ལ་རེ་རེ་ཞིང་དྲག་པོའི་གཟུགས་བསྟན་ནས་མདངས་དང་གཟི་བརྗིད་འཕྲོག་པར་༧མཛད་པས་ན་མདངས་སླར་འཕྲོག་མའོ།",
    "གང་གི་ཕྱིར་རྗེས་ཐོགས་ཉིད་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་དག་ཉིད་ལས་ཞེས་གསུངས་ལ།",
    "དེ་དག་ཏུ་གཟུངས་སྙུད་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཏེ།",
    "གང་གི་ཕྱིར་དེ་རྣམས་རེ་རེའི་ཕྱག་རྒྱས་གཟུངས་ཐམས་ཅད་ཡང་དག་པར་བསྡུས་པའོ་༥།",
