    "ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་རྒྱལ་པོའི་བཙུན་མོ་འང་བསྒོམས་པ་འདིས་འགུགས་པར་བྱེད་དོ།",
    "ཨོཾ་བཛྲ་གུ་ཧྲ་བཛྲ་སཾ་༩གུ་ཤ་ཧཱུཾ་ཞེས་བྱ་བས་རྡོ་རྗེ་རྒྱལ་པོ་བཙུན་མོ་རྡོ་རྗེ་ལྕགས་ཀྱུ་མ་སྤྲུལ་ལ།",
    "ཟླ་བ་དྲུག་གི་མཐར་མངོན་དུ་བྱས་ནས་དེ་བཞིན་དུ་མཚན་ཐོག་ཐག་དཔུང་པ་བསྐུམ་པའི་ལྕགས་ཀྱུ་དང་།",
    "ཨོཾ་བཛྲ་གུ་ཁྱ་རཱ་ག་ཡ་ཧཱུཾ་སྒོ་ཞེས་བྱ་བས་རྡོ་རྗེ་ཆགས་པའི་བཙུན་མོ་རྡོ་རྗེ་དགའ་མ་ཟླ་བའི་དཀྱིལ་འཁོར་གཅིག་ཉིད་ཀྱི་མདུན་དུ་སྤྲུལ་ལ།",
    "དེ་ནས་ཟླ་བ་གཅིག་གམ་ཟླ་བ་དྲུག་གམ་ལོ་གསྦུག་གིས་དེ་མངོན་དུ་བྱས་ནས་རྡོ་རྗེ་ཆགས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "དེ་ནས་ཟླ་བ་གཅིག་གམ་ཟླ་བ་དྲུག་གམ་ལོ་གཅིག་གི་མཐར་ཉི་མ་ནུབ་པའི་དུས་སུ་རང་གི་ལུས་ཀྱི་དཔུང་པ་བསྣོལ་བས་བཟུང་ལ་ཞུགས་ཏེ་༥གཅིག་ཏུ་གྱུར་པར་བསྒོམས་ཏེ།",
    "འདིས་མིག་གི་རྫི་མ་དགུག་ཅིང་༡འདྲེན་པར་བྱེད་པ་ཡིན་པས་༢ན།",
    "མིག་གི་རྫི་མ་འགུགས་སབྱེད་པའི།",
    "གང་གིས་ཁྲོ་གཉེར་གྱི་གཉེར་མ་བསྡུས་ཤིང་།",
    "རང་གི་ལྷའི་སྤྱོར་བས་ལྟ་བའི་ཕྱག་རྒྱ་འདི་དག་ཟླ་བ་གཅིག་ཙམ་གྱི་བར་དུ་གོམས་པར་བྱའོ།",
    "དེ་ལ་རེ་ཞིག་ཡི་གེ་མ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་ཊ་ཨ་མེད་པ་ལས་མིག་གཡོན་པ་ཟླ་བའི་དཀྱིལ་འཁོར།",
    "ཡི་གེ་ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པ་དཀར་པོ་མིག་གཉིས་ཀྱི་༢མིག་གི་འབྲས་བུར་བསམས་ལ་བཛྲ་དྲྀཥྚི་མ་ཊ་ཞེས་བྱ་བས་བྱིན་གྱིས་བརླབས་ལ།",
    "དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ་ཡི་གེ་ཛ་ལས་མིག་གཡས་དང་གཡོན་དུ་ཉི་མ་དང་ཟླ་བ་བསྐྱེད་ལ།",
    "དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "རང་གི་མིག་ལས་བྱུང་བའི་ཁྲོ་བོའི་རྡོ་རྗེ་རྣམས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ཐལ་བར་བྱའོ།",
    "དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེ་ནས་དེ་བཞིན་དུ་ཟླ་བ་གཅིག་གི་མཐར་བསྒྲུབ་པར་བྱའོ།",
    "ཚིག་གི་ཕྱག་རྒྱའི་ཡེ་ཤེས་བབེེབ་བོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ལས་ཇི་སྐད་གསུངས་པའི་བྱེར་བས་ལྷའི་རྣལ་འབྱོར་ནི་ཐམས་ཅད་དུ་བྱ་བར་ཤེས་པར་བྱའོ།",
    "དེ་ནས་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "ཕྱིས་གཟུངས་྾ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རང་གི་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "དེ་ནས་ཟླ་བའི་མཐར་མཚན་ཐོག་ཐག་བསྒོམ་མོ།",
    "གང་གི་ཕྱིར་སྒྲ་དང་བྲལ་བས་ཞེས་གསུངས་པས་སྒོག་མའི་ཕྱོགས་སུ་ཅུང་ཟད་ཙམ་གདོན་ཞྭཔས་འདིར་བཟླས་པར་བྱའོ།",
    "ཛྫ་༧ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེ་ནས་དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།་",
    "རང་གི་གདན་གྱི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་བསྒྲུབ་པར་བྱ་བ་ལྕགས་ཀྱུ་ལ་སོགས་པས་དགུག་པ་དང་།",
    "དེ་ནས་ཛྫ་ཛྫ་༡་ཞེས་བྱ་བས་རང་གི་ལག་པར་ལྕགས་ཀྱུ་བསྐྱེད་ལ།",
    "སྔ་མ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "ཡང་ལས་ཀྱི་དུས་སུ་དེ་བཞིན་དུ་ཡང་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "སྔ་མ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་བསྦུངས་ཏེ།",
    "ཡང་ལས་ཀྱི་དུས་སུ་དེ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།་",
    "ཧཾ་ཧཾ་ཧཾ་ཧཾ་ཞེས་ཡོངས་སུ་ཟློས་ཤིང་ལྷ་མོར་གྱུར་པར་བསམས་༧ལ་བཛྲ་ཧཾ་༨ཞེས་བཟླས་ན་འཇིག་རྟེན་གསུམ་ཡང་སྲུང་བར་བྱེད་དོ།",
    "དེ་ནས་མཚན་ཐོག་ཐག་རང་བཞིན་ཀྱིས་རྣམ་པར་དག་པར་༤མོས་པར་བྱེད་ཅིང་བསྒོམས་༥ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པ་ཐོབ་པས།",
    "ཏིང་ངེ་འཛིན་འདི་ཉིད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་རྣམས་དེར་ཡང་གཞོམ་མོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེ་ནས་མཚན་ཐོག་ཐག་བསྒོམ་མོ།",
    "དེའི་འོད་ཟེར་གྱི་ནང་དུ་བསྒྲུབ་པར་བྱ་བ་ཆུད་པར་བསམ་མོ།",
    "གང་གི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་དངོས་གྲུབ་རྣམས་ནི་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་བེེ་རྡོ་རྗེ་གསང་བའི་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ་འདིར་ལག་པའི་ཕྱག་རྒྱ་ཉིད་ཀྱི་ཁྱད་པར་ནི་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན་ཏེ་གང་གི་ཕྱིར་ཛིས་པའི་རྗེས་སུ་མཐུན་པར་བཅིངས་པ་ཡིན་ལ།",
    "རྡོ་རྗེ་ཐལ་མོ་ལས་བྱུང་བ།",
    "འདིས་ནི་གང་དུ་ཁྱད་པར་གྱི་དགག་པ་མེད་པ་དེར་རྡོ་རྗེ་ཐལ་མོ་ནི་ཕྱག་རྒྱ་ཆེན་པོ་ཐམས་ཅད་བསྐྱེད་པའི་རྒྱུ་ཡིན་པར་སྟོན་ཏོ།",
    "ཞེས་བྱ་བ་ནི་མཇེ་བོང་གཉིས་སྐྱིལ་ཀྲུང་གི་ཚུལ་དུ་བྱས་པ་གང་ཡིན་པ་དེ་ནི་མཇེ་བོང་གཉིས་བསྣོལ་བ་ཞེས་བྱའོ།",
    "མཛུབ་མོའི་རྩེ་མོ་བཀུག་པས་ནི།",
    "ཞེས་བྱ་བ་ནི་མཛུབ་མོ་ཡང་ཡིན་ལ་རྩེ་མོ་བཀུག་པ་༤ཡང་ཡིན་པས་ན་༥དེ་སྐད་ཅེས་བྱའོ།",
    "མཛུབ་མོ་བཀུག་པ་དེ་ཡང་གུང་མོ་གཉིས་བསྙམས་པའི་ཚིགས་བར་མར་སྦྱར་༦བར་བྱ་བ་ཡིན་པས་ན།་",
    "གུང་མོ་བསྙམས་པའི་ཚིགས་སུ་སྦྱར།",
    "རྡོ་རྗེ་ཐལ་མོའི་མཐེ་བོ་གཡོན་པས་གཡས་པ་མནན་ལ།",
    "མཛུབ་མོ་གཡས་པའི་རྩ་བ་གཡོན་པས་༨མནན་ཏེ།",
    "མཛུབ་མོ་གཉིས་ལྕགས་ཀྱུ་ལྟ་བུར་བྱས་ལ་གུང་མོའི་ཚིགས་༩བར་མའི་སྟེང་དུ་གཞག་གོ།",
    "གུང་མོ་རལ་གྲི་ལྟ་བུར་ཚིགས་གསུམ་པར་དགུག་པར་བྱའོ།་།",
    "དེ་ཉིད་གུང་མོ་རྡོ་རྗེར་བྱ།",
    "རྡོ་རྗེ་ཐལ་མོ་ནི་མ་ཡིན་ནོ།",
    "རྡོ་རྗེ་ཐལ་མོར་ཁས་བླངས་པར་གྱུར་ན་དེ།",
    "གུང་མོ་གཉིས་ནི་ནོར་བུར་༡བྱ།"
  ]
}