    "ཕོ་ཉ་ཕོ་ཉ་མོ་ཁྲོ་བོ།",
    "དེ་བསྡུ་བའི་ནི་རྡོ་རྗེ་གུར་ལ་སོགས་པའི་རིམ་པས་ཟླ་བ་དང་ཉི་མ་དག་གམ་ཕ་མ་དག་གི་རྡོ་རྗེ་དང་ཆུ་སྐྱེས་དག་གི་བར་ན་གནས་པའོ།",
    "རེ་ཕས་ཞེས་པ་ལ་སོགས་པའོ།",
    "གནས་ནས་ཞེས་པ་བདག་ཉིད་གནས་པར་མོས་ནས་སོ།",
    "དེ་འདི་ནི་ཇི་ལྟར་རིགས་པར་རྣལ་འབྱོར་གཞན་དང་ཐུན་མོང་བའི་ཆོ་གའོ།",
    "ལྷ་མོ་བརྒྱད་པོ་རྣམས་ཀྱིས་མཆོད།",
    "དེ་ལྟར་ཟླ་བ་དང་ནི་ཉི་མ་ད་ང་རྡོ་རྗེ་དང་ས་བོན་ཡོངས་སུ་གྱུར་པ་ས་ཞེ་སྡང་བདག་ཉིད་ཀྱེའི་རྡོ་རྗེ་མཆོག་ཏུ་དགའ་བའི་རང་བཞིན་རང་རང་གི་ས་བོན་ལས་སྐྱེས་པའི་འཁོར་དང་བཅས་པ་ཁོ་ན་ཉེ་བར་སྐྱེའོ།",
    "གཡོན་པའི་བརླ་ལ་ཞབས་གཡསཀཔའི་རྩེ་མོ་ཡང་དག་པར་བཞག་ནས་སྐྱིལ་ཀྲུང་ཕྱེད་པ་ཅན་ནོ།",
    "ཡི་གེ་བསྒྱུར་བའི་ངེས་ཚིག་གིས་སོ།",
    "གསལ་ཤིང་གིས་ཕུག་པ་ལ་སོགས་པ་རྣམས་ཀྱི་རིམ་པ་ཇི་ལྟ་བ་བཞིན་ན་ནོ།",
    "ལྷ་མོ་ནི་རྡོ་རྗེ་དྲག་མོ་ལ་སོགས་པ་རྣམས་ས་སོ།",
    "བརྒྱད་༢ནི་གླིང་བུ་མ་ལ་སོགས་པའི་ལྷ་མོ་བརྒྱད་རྣམས་ཉེ་བར་མཚོན་པ་སྟེ།",
    "དེའི་ཕྱིར་ལྷ་མོ་བཅུ་དྲུག་གིས་ཡོངས་སུ་བསྐོར་བའོ།",
    "ལྷ་རྣམས་དང་ནི་གླིང་བུ་མ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་དང་ང་ངོ།",
    "འདབ་མ་དག་གིས་ཞེས་པ་འདབ་མ་བརྒྱད་རྣམས་ལ་ལྷ་མོ་བརྒྱད་བྲི་ཞེས་པ་བྲི་བྱའི་དཀྱིལ་འཁོར་ལ་ཡང་དེ་ལྟར་ཞེས་པ་དགོངས་པའོ།",
    "ཤར་གྱི་འདབ་མར་རྡོ་རྗེ་དྲག་མོ་ད་ཀར་མོ་གཡོན་དག་ན་གཞུ་དང་ཐོད་པ་དག་སྟེ།",
    "ལྷོར་རྡོ་རྗེ་གཟུགས་ཅན་མ་སེར་མོ་གཡས་པ་དག་ན་མདུང་དང་རྡོ་རྗེ་ད་ག།",
    "ནུབ་ཏུ་རྡོ་རྗེ་ཆགས་མ་དམར་མོ་གཡས་པ་དག་ན་རལ་གྲི་དང་རྡོ་རྗེ་དག།",
    "བྱང་དུ་རྡོ་རྗེ་ཞི་བ་མ་ལྗང་གུ་མུ་སུཎྜཱི་ནི་ཐལ་སྦྱར་རམ་ཕུབ་ཅེས་གཞན་རྣམས་ཏེ།",
    "བདེན་བྲལ་དུ་སྒྲ་རྡོ་རྗེ་མ་དམར་ཞིང་སྔོན་མོའོ།",
    "བུམ་པ་དང་རྡོ་རྗེ་དང་དྲིལ་བུ་དང་ཐོད་པ་ཞེས་པ་བཞིའི་འདི་དག་གི་གཡས་པ་གཉིས་སུ་དང་གཡོན་པ་གཉིས་སུ་རིམ་པ་ཇི་ལྟ་བར་ཕྱག་མཚན་རྣམས་སོ།",
    "ཞལ་གཅིག་མ་ཕྱག་དག་གིས་རང་རང་གི་རོལ་ཆ་སྒྲོགས་པ་རལ་པའི་ཅོད་པན་ཅན་སྐྱིལ་ཀྲུང་ཕྱེད་བའི་གར་སྟབས་ཅན་རིམ་པ་ཇི་ལྟ་བར་དམར་བ་ད་ང་སེར་བ་ད་ང་དཀར་བ་དང་དུ་བའི་ཁ་དོག་ཅན་མའོ།",
    "ནུབ་ཏུ་རྡོ་རྗེ་ལྕགས་སྒྲོག་མ་དམར་མོ།",
    "ལྷ་མོ་བཅུ་དྲུག་པོ་འདི་རྣམས་ནི།",
    "གཙོ་བོ་ལ་གཟིགས་པ།",
    "མགོ་བོར་གནས་པའི་ཐོད་པ་ལྔ་ད་ང་འཁོར་ཁོ་ཅན་ལ་སོགས་པ་དང་རྐང་གདུབ་ལ་སོགས་པས་བརྒྱན་མ་སྟག་གི་པགི་པགས་",
    "ིཔའི་ཤམ་ཐབས་ཅན་གར་གྱི་ཉམས་དགུས་གར་ཐབས་ཅན་མ་ཁྲག་གིས་གང་བའི་ཐོད་པ་ལ་གནས་པའི་ཉི་མའི་སྟེང་དུ་སྟེ།",
    "གླིང་བུ་མ་ལ་སོགས་པའི་ལྷ་མོ་བཞི་རྣམས་ལས་གཞན་རྣམས་དབུ་སྐྲ་དམར་སེར་གྱེན་དུ་འབར་བའོ།",
    "དེ་ལ་སྒོ་སྐྱོང་མ་རྣམས་གཡས་བརྐྱང་གི་ཟླ་འོས་བཞུགས་པ་རྣམས་ཏེ།་",
    "ལྷ་མོ་བཅུ་དྲུག་པོ་རྣམས་ཀྱི་ཡང་ངོ།",
    "དེ་གང་གི་དང་པོ་ཡིན་པ་ཨཱ་ཡིག་ཡིན་ཞིང་དེས་ཁྱད་པར་དུ་བྱས་པའི་སྔགས་ཨོཾ་ཨཱ་བཛྲ་ཨཾ་ཀུ་ཤ་ཛ་ཧཾ་སྭཱ་ཧཱ་ཞེས་པ་ལ་སོགས་པ་རྒྱས་པར་སྟོན་པར་འགྱུར་བའོ།",
    "རྡོ་རྗེ་ནི་ཧཱུྃ་ལས་སྐྱེས་ཤིང་ཧཱུྃ་ཡིག་གིས་བྱིན་གྱིས་བརླབས་པ་རྩེ་མོ་ཨོཾ་ཡིག་གིས་བྱིན་གྱིས་བརླབས་པའོ།",
    "པདྨ་ནི་ཧྲཱི་ཡོངས་སུ་གྱུར་པ་དེས་བྱིན་གྱིས་བརླབས་པ་རྩེ་མོ་ཨཱ་ཡིག་གིས་བྱིན་གྱིས་བརླབས་པའོ།",
    "དེ་ལ་ཤིན་ཏུ་ཆགས་པའི་བུད་མེད་དང་སྐྱེས་པ་དག་གིས་༡ཤིན་ཏུ་དགའ་བའི་དགའ་སྟོན་གྱི་དུས་སུ་འཛིན་མ་ནུས་པ་ལས་ཁུ་བ་ཤོར་བ་ནི་ཁ་ཁོ་ནར་༢བཟུང་ནས་བཟའ་བར་བྱ་སྟེ།",
    "ལག་པ་དེ་བཞིན་སོར་མོ་ཡིས།",
    "རེ་ཕ་ལས་སྐྱེས་པའི་ཉི་མ་ལ་ཧཱུྃ་ལས་སྐྱེས་པའི་སྣ་ཚོགས་རྡོ་རྗེ་དང་།",
    "དེ་ནས་མིག་དང་རྣ་བ་དང་སྣ་དང་ལྕེ་དང་རེག་བྱ་དང་ཡིད་རྣམས་ལ་གཏི་མུག་རྡོ་རྗེ་མ་དང་༐",
    "འདི་རྣམས་ཀྱང་ནག་མོ་གྲི་གུག་ད་ང་ཐོད་པའི་ཕྱག་ཅན་ཟླ་བ་ལ་གནས་པ་རྣམས་སོ།",
    "རྡོ་རྗེ་དྲག་མོ་ལ་སོགས་པ་རྣམས་ནི་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་དུ་འཆད་པར་འགྱུར་བའི་མི་བསྐྱོད་པ་ལ་སོགས་པ་རྣམས་ཀྱིས་སོ་ཞེས་བྱ་བ་སྦྱོར་བ་དང་པོའོ།",
    "རྟག་ཏུ་གོམས་པའི་རྣལ་འབྱོར་ལས་། ཞེས་པ་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་ཏོ།",
    "རང་གིས་འཁྱུད་པའི་ལྷ་མོ་ལ་ནི་དེ་ལས་གཞན་པའི་རྣལ་འབྱོར་མ་རྣམས་ཏེ།",
    "གཏུམ་མོ་དང་ལྷན་ཅིག་གཅིག་ཏུ་གྱུར་པ་ནི་ལྷན་ཅིག་སྐྱེས་པའི་བདེ་བ་ཉམས་སུ་མྱོང་ཞིང་རིམ་གྱིས་ལྟེ་བའི་དཀྱིལ་འཁོར་དུ་ལྷུང་བཞིན་པ་ནི་དམིགས་པ་མེད་པར་འགྱུར་ཏེ།",
    "བསྒོམས་པས་སྐྱོན་ཇི་ལྟ་བའི་རང་གི་སྔགས་འཆད་པར་འགྱུར་བ་བཟླས་པར་བྱའོ།",
    "མན་ངག་གི་༢སྙེ་མར་སྙེ་མ་བདུན་པའོ།་",
    "རེ་མིག་དགུ་སོགས་འཁོར་ལོ་ཡི།",
    "ཞེས་པ་རྩིབས་བརྒྱད་རྣམས་ལྟེ་བ་དང་ལྷན་ཅིག་རེ་༤མིག་ད་གུ་གང་གི་ཡིན་པ་དེ་ཡང་ཡིན་ལ་དང་པོ་ཡང་སྟེ་འཆད་པར་འགྱུར་བའི་འཁོར་ལོ་ལ་ལྟོས་པ་སྟེ།",
    "དབུས་སུ་མིང་ཞེས་པ་ལྟེ་བ་ལ་ཨོཾ་དང་ཧཱ་ཡིག་དག་གི་དབུས་སུ་བསྒྲུབ་བྱའི་མིང་སྲུངས་ཀྱི་ངག་དང་བཅས་པའོ་། མཉམ་ཉིད་ཡེ་ཤེས་ནི་སྟོང་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ས་སོ།",
    "མགོ་ལ་སོགས་པ་རྣམས་ཀྱི་ནང་གི་བུ་ག་པ་ལ་གནས་པའི་ཡི་གེ་རྣམས་སོ།",
    "པདྨ་དཀར་པོ་དང་ཟླ་བ་ལ་ཏཱཾ་ཡོངས་སུ་གྱུར་པ་ལྟེ་བ་ལ་ཏཱཾ་གིས་བྱིན་གྱིས་བརླབས་པའི་ཨུཏྤ་ལ་སྟེ།",
    "རང་གི་ལུས་དང་འཁོར་ལོ་དང་ཡི་གེའི་འོད་ཟེར་མང་པོ་རྣམས་ཀྱིས་བསྒྲུབ་བྱ་ཁྱབ་པར་བསམ་ཞིང་སྔགས་བཟླས་པར་བྱ་སྟེ།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།་",
    "གྲོ་ག་དང་བཅས་པ་རྣམས་སྟེང་གི་བུ་ག་ནས་ནང་དུ་བཅུག་སྟེ།",
    "གཡས་པ་དག་གིས་ཨུཏྤ་ལ་དམར་པོ་ཁ་འབུས་པའི་མདའ་དང་མེ་ཏོག་དམར་པོ་ལས་བྱས་པའི་ལྕགས་ཀྱུ་དང་གཡོན་པ་དག་གིས་མེ་ཏོག་དམར་པོའི་གཞུ་དང་ཨུཏྤ་ལ་དམར་པོ་འཛིན་མ།",
    "རིམས་དང་ཀློ་བུར་དུ་འཆི་བ་དང་དུག་ཞི་བར་བྱེད་པ་ལ་འདི་དཀར་མོའོ།",
    "པུ་སྟིས་༢མཚན་པའི་པདྨ་གཉིས་གཡོན་པ་དང་གཡས་པའི་ལོགས་དག་ཏུ་ནང་དུ་བསྒྲེང་བ་གྲུ་མོ་གཉིས་ཀྱིས་བཟུང་ནས།",
    "གཏི་མུག་ལ་སོགས་པའི་ཉོན་མོངས་པ་༢འཇིག་པའི་ཆེད་དུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རྣལ་འབྱོར་གསུངས་པ།",
    "གོས་དཀར་མོའི་མཚན་མ་པདྨ་དང་རྡོ་རྗེ་དང་རལ་གྲི་དང་མདའ་རྣམས་ཏེ།",
    "མཁའ་འགྲོ་མ་ནི་ལྷ་མོ་རྣམས་སོ།",
    "ལྷ་མོ་རྣམས་ཀྱི་ས་བོན་དང་མཚན་མ་ལ་སོགས་པ་ནི་འབྲས་བུའི་དཀྱིལ་འཁོར་དང་མཚུངས་པར་རྟོགས་པར་བྱའོ།",
    "དེ་ལྟར་ལྷ་མོ་རྣམས་ཕྱུང་ནས་འདོད་ཆགས་ཆེན་པོ་ལས་མན་ངག་ཇི་ལྟ་བར་ལྷ་མོ་དང་ལྷན་ཅིག་ཞུ་བའི་ངོ་བོ་ཉིད་དུ་གྱུར་ཏེ།",
    "དེ་ནས་རི་ཁྲོད་མས་ཁྱོད་མེད་ན་སྟེ་བྲལ་ན་བདག་འགུམས་༢པ་སྟེ།",
    "ཀྱེའི་རྡོ་རྗེ་ཁྱོད་བཞེངས་ཤིག།",
    "དེ་ནས་གཏུམ་མོས།",
    "དང་སྡུད་༡པའོ་ཞེས་པ་དམ་ཚིག་གི་བཟླས་པའོ།",
    "འདི་ཁོ་ནར་བཅོམ་ལྡན་འད་ས་མའི་ཞལ་དུ་འཇུག་ཅིང་རང་གི་ཞལ་ནས་ཕྱུང་བ་ཙམ་གྱི་ཁྱད་པར་གྱིས་སྟུག་ཅིང་རྩུབ་པའི་ཡི་གེ་ཅན་ནི་ཁྲོས་པའི་བཟླས་པའོ།",
    "ཨོཾ་ན་མོ་བྷ་ག་ཝ་ཏེ་བཱི་རེ་ཤཱ་ཡ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ་སྭཱ་ཧཱ།",
    "ཧཱུྃ་ཨ་ཞེས་པའོ་། འབར་འཁྲུགས་སྔོན་པོ་དག་ཅེས་པ་པདྨ་འི་ནང་དུ་སོན་པའི་སེམས་ཀྱི་༢ཞུ་བའི་རང་བཞིན་དག་གིས་ཏེ།",
    "དེ་ལ་ལྷ་མོ་ཕྱུང་བ་རྣམས་ཀྱིས་འགྲོ་བའི་དོན་བྱས་ནས་འཆད་པར་འགྱུར་བའི་གནས་སུ་དགོད་པར་བལྟ་བར་བྱ་ཞིང་།",
    "མ་མོའི་འཁོར་ལོ་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཉོན་མོངས་པའི་བདུད་ནི་སྟོང་པ་ཉིད་དུ་ངེས་པར་འཛིན་པས་བཅོམ་པའོ།",
    "འཆི་བདག་གི་བདུད་ནི་མ་སྐྱེས་ཤིང་མི་སྐྱེ་བས་བཅོམ་པའོ།",
    "ཉོན་མོངས་པའི་བདུད་ཁྱབ་འཇུག་ནག་པོ་ད་ང་།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པའི་ཕུང་པོ་ཞི་བ་ཉིད་ཀྱི་ཕྱིར་ཞི་བའོ།",
    "ཚིག་སྙན་པ་རྣམ་པར་འགོད་པ་ནི་ངག་གི་ཚུལ་ལོ།",
    "སྤུ་ལྡང་ཐིམ་དང་རེངས་པ་ད་ང་།",
    "གདུང་བ་དང་སྨྱོ་བ་དང་འཆི་བ་དང་སྐྲག་པ་དང་རྟོག་པ་ཞེས་པ་སུམ་ཅུ་རྩ་གསུམ་མོ།",
    "ཅུང་ཟད་གྱེན་ཟློག་མིག་གིས་གང་།",
    "སྟེང་གི་མིག་ལྤགས་མཛེས་བརྗེས་པ།",
    "མིག་རྒྱན་མུ་ཀུ་ལ་དེ་འགྱུར་། རེག་པ་འཛིན་ལ་རྟག་ཏུའོ།",
    "རྫི་མའི་རྩེ་མོ་གཡོ་བཞིན་པ།",
    "སྟེང་གི་མིག་ལྤགས་སྣུམ་མཛེས་པ།",
    "བུད་མེད་རྣམས་ཀྱིས་ཕྱེད་ལྟ་བའོ་། ཞེས་པ་ལ་སོགས་པ།",
    "དེ་ལས་ཅུང་ཟད་བདག་གིས་འདིར།",
    "སྤྲོས་པ་ཐམས་ཅད་ཀྱི་གཉེན་པོ་ཉིད་ཀྱི་ཕྱིར་དབའ་རླབས་མེད་པ་གང་རང་གི་ངོ་བོ་ཡིན་པ་ཀྱེའི་རྡོ་རྗེའི་ངོ་བོ་སྟེ།",
    "དཀར་པོ་ལ་ཞི་བ་དང་ནག་པོ་ལ་དྲག་པོ་ད་ང་ལྷག་མ་རྣམས་ལ་ཇི་ལྟར་རིགས་པར་རོ་། གཤོར་ནི་ཐོད་པ་ཆང་གིས་བཀང་བའོ།",
    "ཐོད་པ་ནི་༡ཁྲག་གིས་གང་བའོ།",
    "གོ་རི་གཡོན་པ་དག་ན་གཞུ་དང་རོ་ཧི་ཏའི་ཉ་དང་བཅས་པའི་ཁྲག་གིས་གང་བའི་ཐོད་པའོ།",
    "ཆོམ་རྐུན་མའི་གཡོན་པ་དག་ན་ལྕགས་ཀྱུ་དང་༢བཅས་པའི་ཁྲག་གིས་གང་བའི་ཐོད་པའོ།",
    "རབ་རྨོངས་མ་ནི་གཡུང་མོ་སྟེ།",
    "གཏུམ་མོའི་གཡས་པ་ན་ཁྲག་གིས་གང་བའི་ཐོད་པ་ལ་སྟག་གོ།",
    "གྷསྨ་རཱི་དང་པུཀྐ་སཱི་དང་རི་ཁྲོད་མ་དང་གཏུམ་མོ་དང་རབ་རྨོངས་མ་རྣམས་རིམ་པ་ཇི་ལྟ་བར་ཞི་བ་དང་དྲག་པོ་དང་དགའ་བ་དང་།",
    "རྟ་གཟུགས་ལ་སོགས་པ་རྣམས་ཀྱི་གཙོ་བོ་དང་གཡས་པ་དང་ཅིག་ཤོས་ད་ང་སྟེང་གི་རིམ་པས་ཞལ་གྱི་ཁ་དོག་གསུངས་པ།",
    "གཡས་བརྐྱང་གི་ཟླ་བོའི་ཞབས་ནི་སྒོ་སྐྱོང་རྣམས་ཁོ་ནའོ།",
    "ཁྱད་པར་ནི་གཞལ་ཡས་ཁང་གི་ནང་དུ་ཆོ་ག་བཞིན་དུ་ཨཱ་ལི་དང་ཀཱ་ལི་ལས་སྐྱེས་པའི་ཟླ་བ་དང་ཉི་མའི་དབུས་སུ་ཧཱུྃ་དང་ཨ་ལས་སྐྱེས་པའི་ཐོད་པ་དང་གྲི་གུག་༡གནས་པའི་ས་བོན་གཉིས་སོ་ཞེས་པ།་",
    "ཞུ་བ་ལས་༢ལྷ་མོ་ཞུགས་མ་ཐག་ཏུ་ཞུ་བ་དེ་ལས་སྐྱེས་པའི་ཧཱུྃ་ཞེས་པ་ལ་སོགས་ཡོངས་སུ་གྱུར་ཏེ།",
    "སྔོན་བཞིན་དུ་གོ་རཱི་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་དབྱུང་བར་བྱའོ།",
    "ལྷ་མོ་དང་བཅོམ་ལྡན་འདས་ཀྱང་རང་གི་ས་བོན་ལས་སྐྱེས་པ་ན་དེ་ད་ག་སྤྲོས་ནས་བདག་ཉིད་ཀྱི་ནང་དུ་གཞུག་པར་བྱའོ།",
    "རྒྱུད་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ་༢མན་ངག་གི་སྙེ་མར་སྙེ་མ་དགུ་པའོ།",
    "ལྷུན་པོའི་ཞེས་པ་ལ་སོགས་པའོ་། ལྷུན་པོ་གང་གི་ཁ་དོག་བཞི་རྣམས་ཡིན་པ་སྟེ།",
    "ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་གི་ཕྱོགས་རྣམས་སུ་དང་།",
    "འདིའི་རྗེས་སུ་བླ་རེ་ཞེས་པ་ལ་སོགས་པ་ཕྱེད་དང་བཅས་པའི་ཚིགས་བཅད་ད་དོ།",
    "དྲིའི་དཀྱིལ་འཁོར་ནི་དྲི་ཀུན་ནས་བསྡུས་པ་སྟེ་གཞལ་ཡས་ཁང་གི་ནང་དུའོ།",
    "རང་གི་གདན་གྱི་སྟེང་དུ་སྐྱིལ་ཀྲུང་གི་རྣམ་པར་ཞབས་གཡོན་པ་བཀོད་ནས་གཡས་པ་ཅུང་ཟད་བརྐྱང་བར་བྱའོ་ཞེས་པ་འདིར་སེམས་དཔའི་སྐྱིལ་ཀྲུང་སྟེ།",
    "ལྷ་མོ་བཅུ་གསུམ་པོ་རྣམས་ཀྱང་སེམས་དཔའི་སྐྱིལ་ཀྲུང་ཅན་རྣམས་སོ།",
    "དྲག་ཏུ་གསངས་མཐོན་པོར་འཇིགས་སུ་རུང་བར་དགོད་པ་གང་གི་ཡིན་པ་དེ་ནི་དེ་སྐད་དོ།",
    "སྣོད་ཅེས་པ་ཁྲག་གིས་གང་བའི་ཐོད་པའོ།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་སོགས་པ་རྣམས་སྤྱན་གསུམ་པ་གཙོ་མོ་ལ་གཟིགས་པ་རྣམས་ས་སོ།",
    "སྟག་མོ་ལ་སོགས་པ་གསུམ་ནི་སྟག་དང་ཅེ་སྤྱང་དང་འུག་པའི་གདོང་པ་ཅན་ན་ནོ།",
    "ཕྱག་རྣམས་ཞེས་པ་ཕྱག་གཉིས་ཐལ་མོ་སྦྱར་པའི་ཚུལ་ལོ།",
    "ཕྱག་གཉིས་ཐལ་མོ་སྦྱར་བའི་ཞེས་པ་ཕྱག་གཉིས་ཐལ་མོ་༐",
    "ཁྲག་གི་རྒྱུན་ཞེས་པ་ལ་སོགས་པ་ནི་ལག་པ་གཉིས་ཀྱི་སྙིམ་པ་སྟེང་དུ་བྱས་པས་ཁྲག་སྲད་བུ་དམར་པོ་བཞིན་དུ་རྒྱུན་གྱིས་འཐུང་བའོ།",
    "སྡིགས་མཛུབ་མདུང་གི་ཕྱག་ཅན་ཞེས་པ་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་ཐལ་མོ་བྱས་༢ཏེ།",
    "མཐེ་བོའི་རྩེ་མོ་གཉིས་ཕན་ཚུན་སྦྱར་ནས།",
    "སྡིགས་མཛུབ་གཉིས་༢ཀྱི་རྩེ་མོར་བྱས་པ་ནི་མདུང་ལྟ་བུའོ་ཞེས་པས་དེ་སྐད་བརྗོད་དོ།",
    "དེ་ཡང་རང་གི་བྷ་གར་འཛིན་པའོ། ༐",
    "ཐམས་ཅད་དུ་ཡང་རང་རང་གི་ས་བོན་ཡོངས་སུ་གྱུར་པའི་ལྷ་མོ་རྣམས་སོ།",
    "ལྷ་མོ་འདི་རྣམས་ཀྱི་མདུན་དུ་དམ་ཚིག་གི་ཕྱག་རྒྱ་རང་ཉིད་ཇི་ལྟ་བར་བསྟན་པར་བྱའོ།",
    "ཁྱད་པར་བྱས་ཤིང་མེ་ལས་ཏེ་རེ་ཕ་ལས་བདུན་པ་ཧ་ཡིག་རྡོ་རྗེ་མའི་ས་བོན་ཨུ་ཡིག་འོག་ཏུ་ལྡན་པའོ།",
    "ཟླ་བ་ཕྱེད་པའི་སྟེང་དུ་ཐིག་ལེ་དང་ནཱ་ད་དག་གིས་མནན་པ་སྟེ།",
    "ཞེས་པ་ནང་གི་བརྗོད་པས་ཀློག་ཅིང་།",
    "དེ་ལས་སྤྲོས་པའི་དེ་བཞིན་གཤེགས་པ་དང་ལྷ་མོ་རྣམས་ཀྱིས་འགྲོ་བའི་དོན་བྱས་ཏེ།",
    "དེར་བསྡུས་པ་ན་ཟླ་བ་ལ་སོགས་པ་རྣམས་ལས་རྫོགས་པའི་ཡེ་ཤེས་མཁའ་འགྲོ་མ་དང་དེ་སྐྱེ་བ་དང་དུས་མཉམ་དུ་དཀྱིལ་འཁོར་པ་རྣམས་ཀྱང་རང་རང་གི་ས་བོན་རྣམས་ལས་སྐྱེས་པར་སྟོབསྒོམས་ལ།",
    "དེ་ལ་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་སོགས་པ་རྣམས་ཀྱི་རང་རང་གི་གད་ན་དང་སྣ་ཚོགས་ཆུ་སྐྱེས་དང་ཉི་མ་རྣམས་ལ།",
    "རྣ་བ་དང་སྣའི་ནང་རྣམས་སུ་ཡུཾ་མོ།",
    "འཇིགས་བྱེད་མ་དང་གཏུམ་མོ་དང་རོ་ལངས་མ་དང་རྡོ་རྗེ་མཁའ་འགྲོ་ཡུམ་ད་ང་།",
    "སེང་གེ་མ་དང་སྟག་མོ་དང་ཅེ་སྤྱང་མོ་དང་འུག་མོ་རྣམས་ཀྱི་རིམ་པ་ཇི་ལྟ་བར་གོ་ཆའི་ཡི་གེ་རྣམས་བཀོད་པ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གིས་ལུས་དང་ངག་དང་ཡིད་རྣམས་བྱིན་གྱིས་བརླབ་པར་བྱས་ནས།",
    "དེ་ལ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ནས་སོར་མོ་གུང་མོ་གཉིས་བརྐྱང་སྟེ་རྩེ་མོ་སྦྱར་བ་ནི་ཡེ་ཤེས་མཁའ་འགྲོ་མ་ལ་སྟེ།",
    "རྡོ་རྗེ་ཐལ་མོ་བྱས་ནས་མཛེ་བོང་རྒན་པོ་དག་གིས་གུང་མོ་གཉིས་ལ་ཡང་དང་ཡང་དུ་རེག་ཅིང་བསྐྱོད་པའི་ཕྱག་རྒྱ་དང་ཨོཾ་བཛྲ་ཌཱ་ཀི་ནཱི་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ་ཞེས་པ་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལའོ།",
    "ཕྱག་རྒྱ་འདི་གཉིས་བཅིངས་ཏེ་སོར་མོ་གུང་མོ་གཉིས་བརྐྱང་ཞིང་།",
    "ཨོཾ་ཙཎྜ་ལཱི་ཧཱུྃ་སྭཱ་ཧཱ་ཞེས་པ་གཏུམ་མོ་ལའོ།",
    "རྩེ་མོ་དག་སྦྱར་ཞིང་ཨོཾ་ཨཱཾ་སྭཱ་ཧཱ།",
    "ལག་པ་གཉིས་ཐལ་མོའི་ཚུལ་དུ་བ་རྐྱང་སྟེ་ཁར་བཅུག་པ་དང་།",
    "ཐལ་མོ་སྦྱར་བ་སྤྱི་བོར་འཛིན་ཅིང་ཨོཾ་ཨེཾ་སྭཱ་ཧཱ་ཞེས་པས་མར་མེ་མ་ལའོ།",
    "ཐལ་མོ་གྱེན་དུ་བྱས་ནས་ཁ་དང་ཉེ་བར་བཞག་ཅིང་།",
    "ལག་པ་གཉིས་ཀྱིས་པདྨ་འི་བསྐོར་བ་བྱས་ནས་རྡོ་རྗེ་ཐལ་མོ་བྱས་ཏེ་སྔ་མ་བཞིན་གསང་གནས་སུ་བཞག་ཅིང་།",
    "དེའི་རྗེས་སུ་པདྨའི་བསྐོར་བ་སྔོན་དུ་འགྲོ་བས་ཡེ་ཤེས་ཀྱི་འཁོར་ལ་༢དམ་ཚིག་གི་འཁོར་ལོ་༤ཇི་ལྟར་རིགས་པར་གཞུག་པར་བྱའོ།",
    "བདུད་རྩིའི་རྒྱུན་འཛག་པ་ཉིད་ཀྱིས་ཆར་རྒྱུན་འབབ་པར་བསམ་པར་བྱའོ་ཞེས་པ་ཐིག་ལེའི་རྣལ་འབྱོར་ནང་དུ་འདུས་པའི་ཕྲ་མོའི་རྣལ་འབྱོར་གྱི་བར་མ་ཆད་དུ་སྐྱོན་ཨོཾ་ཧྲཱི་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་འབུམ་ཕྲག་གསུ་མ་བཟླས་ཤིང་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་འཆད་པར་འགྱུར་བའི་སྔགས་རྣམས་ཏེ།",
    "དཔལ་ཡང་དག་པར་སྦྱོར་བའི་རྒྱུད་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ་མན་ངག་གི་༡སྙེ་མར་སྙེ་མ་བཅུ་པའོ།",
    "ནམ་མཁའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཉི་མའི་དཀྱིལ་འཁོར་ཞེས་པ་འདིས་རེ་ཕས་སྔོན་དུ་ཉི་མ་ཞེས་པ་ལ་སོགས་པ་གསལ་བར་བྱས་སོ།",
    "ཞེས་པ་ཟེ་འབྲུས་ཉེ་བར་མཚོན་པ་པདྨ་འད་བ་མ་བརྒྱད་པ་ནི་ནང་གི་འཕར་མའོ།",
    "མཉམ་ཉིད་ཡེ་ཤེས་ནི་གང་གིས་དེ་ལྟར་གཟུགས་བརྙན་དུ་འགྱུར་༢བའི་འགྲོ་བ་མཉམ་པ་ཉིད་དུ་རྟོགས་པ་སྟེ།",
    "སོ་སོར་རྟོག་པར་བརྗོད་པར་བྱ་། ས་བོན་ལས་སྐྱེས་པ་ཉིད་ཀྱིས་དང་ས་བོན་གྱི་བྱིན་གྱིས་བརླབས་པ་ཉིད་ཀྱིས་ས་བོན་རྣམས་ཀྱིས་མཚན་པའི་རང་གི་ལྷའི་ཕྱག་མཚན་ནི་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "ས་བོན་རྣམས་ཀྱིས་ཞེས་པ་མང་པོའི་ཚིག་ནི་ལྷ་མོ་རྣམས་ཀྱི་ས་བོན་སྣ་ཚོགས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཕྱག་མཚན་ཞེས་གཅིག་གི་ཚིག་ནི་བཅོ་ལྔ་རྣམས་ཀྱི་ཕྱག་མཚན་རྡོ་རྗེ་སྔོན་པོ་གཅིག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "བྱ་བ་སྒྲུབ་པ་ནི་གང་གིས་དེ་ལྟར་སོ་སོར་བརྟགས་པའི་འགྲོ་བའི་བྱ་བ་སྤྲུལ་བ་དཔ་ག་ཏུ་མེད་པ་རྣམས་ཀྱིས་རྗེས་སུ་སྒྲུབ་པ་སྟེ།",
    "ལས་དང་པོ་པས་དེ་ལྷག་པར་མོས་པས་དང་།",
    "འདིར་རྒྱུའི་ཡེ་ཤེས་བཞིའི་རང་བཞིན་ཉིད་ལ་ཡང་བདེ་བ་ཆེན་པོ་མོས་པ་པ་ཡོད་པ་ཁོ་ན་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ནི་ཞལ་དང་ཕྱག་མཚན་དང་རྒྱན་ལ་སོགས་པ་མ་རྟོགས་པར་མཛད་མོད།",
    "ཟླ་བ་ཆུ་ཤེལ་ནོར་བུ་ནི་མཚན་མ་མེད་པའི་ཟླ་བ་གང་བ་ལྟ་བུ་སྟེ་དེའི་འོད་ལྟ་བུ་གང་གི་འོད་ཡིན་པ་སྟེ།",
    "དྲག་མོ་ཉིད་ན་༢ཡང་ལྷ་མོ་ཟླ་བའི་གད་ན་དང་ཟླ་བའི་འོད་ཅན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "ཁྲག་གིས་གང་བའི་ཐོད་པའོ།",
    "བཞད་ཅིང་ཁྲོ་ལ་སྒེག་པ་སྟེ་། ཞེས་པ་ནི་ལྷ་མོ་ཉི་ཤུ་རྩ་གསུམ་པོ་རྣམས་ཀྱིའང་ཁྱད་པར་ར་རོ།",
    "དེ་ཉིད་གསུམ་གྱི་ངོ་བོ་རྣམས་ནི་ཨོཾ་ཨཱ་ཧཱུྃ་གི་ཡི་གེ་རྣམས་ཏེ།",
    "དཔལ་ཡང་དག་པར་སྦྱོར་བའི་རྒྱུད་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ་༢མན་ངག་གི་སྙེ་མར་སྙེ་མ་བཅུ་གཅིག་པའོ།་",
    "དེའི་ཕྱིར་ཞེས་པ་གང་གི་ཕྱིར་འདི་མེད་པར་དངོས་གྲུབ་རྣམས་མེད་པའི་འོ།",
    "དཀྱིལ་འཁོར་དེ་ནི་རིགས་དྲུག་གི་བད་ག་ཉིད་ཁོ་ན་སྟེ།",
    "ཤེས་རབ་ཅན་ནི་ད་ཀྱིལ་འཁོར་གྱི་ཆོ་ག་ཤེས་པ་དང་རི་མོ་ལ་སོགས་པའི་ལས་ལ་མཁས་པའོ།",
    "ཇི་སྲིད་ཁྲུ་ནི་སྟོང་གི་བར།",
    "ཕྱོགས་བཞིའི་ཟིག་རྣམས་དང་ཟུར་ཐིག་རྣམས་ཀྱིས་མཉམ་པར་བྱས་པའོ་། ཐམས་ཅད་དུ་སྟེ་བཞི་རྣམས་སུ།",
    "དེ་དག་གིས་ཡོངས་སུ་བཅད་པ་ནི།",
    "ནང་གི་རེ་མིག་དང་ལྷན་ཅིག་དཀྱིལ་འཁོར་ལྔ་རྣམས་ཀྱི་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་རེ་མིག་རྣམས་ཀྱིས་བརྒྱན་ཅིང་སྤྱན་མ་ལ་སོགས་པའི་རེ་མིག་རྣམས་དང་ལྷན་ཅིག་དགུ་༢རྣམས་ཀྱིས་སོ།",
    "ནང་གི་རེ་མིག་སྤངས་ནས་བརྒྱད་རྣམས་ཀྱིས་བརྒྱན་པ་སྟེ།",
    "དེ་ཡི་ནང་གི་འཁོར་ལོ་ནི།",
    "དེའི་ས་བོན་གྱི་འོད་ཟེར་གྱིས་ལྷ་མོ་བཅུ་དྲུག་སྤྲོས་པས་སོ།",
    "བརྗོད་ཅེས་པ་སྒྲུབ་པ་པོས་བརྗོད་པའོ་། དགོངས་སུ་གསོལ་ཏེ་ངེས་པར་འཛིན་པ་དང་བཅས་པས་རྣམ་པར་གཟིགས་ཤིག་པའོ།",
    "ཆེ་གེ་མོ་ཞེས་བགྱི་བ་ཞེས་པ་ངེས་པར་བྱས་ནས་ཁས་བླངས་པ་ཡོངས་སུ་མི་གཏོང་བར་དགོངས་པས་རང་གི་མིང་བཟུང་བའོ།",
    "བ་དག་གིས་ཞེས་པ་འགྲོ་བ་སྒྲོལ་བར་ཁས་བླངས་པ་ཉིད་ཀྱི་ཕྱིར་ང་རྒྱལ་བྱེད་པའོ།",
    "ཤིན་ཏུ་བའི་ཡན་ལག་གི་མགོ་བོ་དང་ཚིལ་དང་རྐང་ལ་སོགས་པའོ།",
    "ཉིན་མོ་གསུམ་རྣམས་དང་མཚན་མོ་གསུམ་རྣམས་ཞེས་པ་ལན་དྲུག་རྣམས་སུ་བྱས་ནས་ས་སོ།",
    "འདི་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པའི་ངག་གི་རང་བཞིན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ནང་གི་བད་ག་ཉིད་ནི་མིག་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་སེམས་ལས་གཞན་ལོགས་པ་གཟུང་བར་བྱ་བ་བེམས་པོ་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "བརྗོད་ནས་ཞེས་པ་རྣམ་པར་རྟོག་པ་ནང་གི་བརྗོད་པའི་རྣམ་པ་ཅན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་མ་སྐྱེས་པས་སོ།",
    "དེའི་རྗེས་སུ་ལས་གང་ལ་ཞེས་པ་ལ་སོགས་པའི་རིགས་པས་༢ཡི་གེ་གསུམ་གྱི་ངོ་བོ་རང་གི་ལུས་དང་ངག་དང་སེམས་གཟུགས་བརྙ་ན་ལྟ་བུ་སྟོང་པ་ཉིད་དང་རོ་གཅིག་པར་བརྟག་པར་བྱ་སྟེ།",
    "དེ་བཞིན་ཉིད་ཀྱི་ལུས་ཀྱི་༤རང་བཞིན་གྱིས་ཡོངས་སུ་དག་པའི་སེམས་སྒྲིབ་པ་ཀློ་བུར་བ་དང་བྲལ་བ་ལས་རང་གི་ངོ་བོ་ལའུགནས་པའོ་ཞེས་པའི་དོན་ཏོ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ཉིད་ཀྱི་ཕྱིར་དེ་གང་གི་བདག་ཉིད་དེ་རང་གི་ངོ་བོ་ཡིན་པ་དེ་ང་སྟེ།",
    "བདག་ཉིད་དང་ངའི་སྒྲ་དག་གིས་དེའི་བདག་ཉིད་ལ་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ཉིད་དུའོ།",
    "ཨོཾ་ཡིག་གིས་ཀྱང་ཨ་ད་ང་ཨུ་དང་མ་ཡིག་རོ་གཅིག་པས་ལུས་ད་ང་ངག་དང་སེམས་ཀྱི་ངོ་བོར་བདག་ཉིད་རྣམ་པར་འཇོག་གོ།",
    "དེའི་གཎྜཱིའི་སྒྲ་འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པ་མེད་ཅིང་འབྲེལ་བ་མེད་མོད།",
    "པ་དང་༡ཐུན་མོང་པའི་ཏིང་ངེ་འཛིན་དེ་རྣམས་སྙོམས་པར་འཇུག་ལ།",
    "དེའི་བར་མ་ཆད་ཁོ་ནར་གཅིག་གི་ཨཾ་ཀ་རིགས་ཏེ་དབུས་སུ་ནི་སུས་ཀྱང་དགོད་པར་དཀའ་སྟེ།",
    "ཅི་དགར་ཟློས་པས་ཞེས་པ་ནང་གི་བརྗོད་པ་སྟེ།",
    "རང་གི་སེམས་ཁོ་ན་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་བལྟ་སྟེ་སྔགས་ནང་དུ་བཟླས་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "དེའི་ཡོན་ཏན་ཁྱད་པར་དུ་འཕགས་པ་ཉིད་ཀྱིས་ལྷག་པར་མོས་པར་བྱའོ།",
    "སྐྱེས་པ་འདོད་པའི་བུད་མེད་ཀྱི་བཞིན་ན་ནོ།",
    "བསྐྱེད་པར་བྱ་ཞེས་པ་བསྐྱེད་བཞིན་པས་ནང་གི་བརྗོད་པས་སྔགས་བཀླག་ཅེས་པའི་དོན་ཏོ།",
    "དེ་ལ་འཆད་པར་འགྱུར་བའི་དགའ་བ་བཅུ་དྲུག་གི་དབྱེ་བ་ལས་ཟླ་བ་ཆ་བཅུ་དྲུག་པ་སྟེ་ཚེས་གཅིག་ལ་སོགས་པ་རྣམས་སུ་འཕེལ་བ་ལ་སོགས་པའི་དབྱེ་བ་ལས་ཀྱང་ངོ།",
    "བུད་མེད་ལ་འདི་རྡོ་རྗེ་སེམས་། སྐྱེས་པ་རྣམས་ལའང་དུས་ཀུན་དུའོ།",
    "བཅོམ་ལྔ་པའི་ཉིན་མོ་ལ་ཡེ་ཤེས་ཀྱི་ཁམས་རྗེས་སུ་ང་རོ་བརྗོད་པར་བྱའོ་། མཚན་མོ་ལ་དེ་ཁོ་ན་ཉིས་འགྱུར་མགྲིན་པ་ལས་བྱུང་བ་རྣམ་པར་བཅད་པར་བརྗོད་པར་བྱའོ།",
    "ཟླ་བ་གཉིས་པ་ནི་བུད་མེད་རྣམས་ཀྱི་ཟླ་མཚན་མང་བ་ལས་བྱུང་བའི་ཉི་མའི་དཀྱིལ་འཁོར་པཞིན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འགའ་ཞིག་ཏུ་ཡེ་ཤེས་ཀྱི་མེས་སྒྲིབ་པའི་བུད་ཤིང་ཐམས་ཅད་སྲེག་པར་དགོངས་པས།",
    "འོག་གི་ཆ་ལ་ལྷག་པར་གནས།",
    "འདི་ཐམས་ཅད་ནང་གི་ཚུལ་དུ་གསུངས་པ།",
    "ངོས་གཉིས་པར་གནས་པའི་རྩེ་མོ་ལྔ་ཉིད་དུ་འབུར་པོ་སོ་སོ་ལ་སླར་ཡང་འབུར་པོ་ལྔ་རྣམས་ཀྱི་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་རྣམས་ནི་བཞི་རྣམས་ལ་སོར་མོ་རྣམས་དང་།་",
    "གང་གི་ཕྱིར་ཟག་པ་མེད་ཅེས་པ།",
    "སྲིད་པའི་རྩེ་མོ་ནས་མནར་མེད་པ་ཇི་སྲིད་པར་སྐྱེ་མཆེད་ཀྱི་རྨ་དྲུག་རྣམས་ཀྱིས་ཟག་གོ་ཞེས་པའམ།",
    "དེ་ནས་ཡང་དག་པ་དང་ལོག་པའི་ཕྱོགས་གཉིས་ཐོས་ནས་འདི་བདེན་ནམ་འདི་མི་བདེན་ཞེས་ཐེ་ཚོམ་མ་མོ།",
    "དེ་ནི་འཇིག་པའི་བདག་ཉིད་ཅན་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་རང་བཞིན་མེད་པ་རྣམས་ལ་ཕྱིན་ཅི་ལོག་ལས་རང་བཞིན་དང་བཅས་པ་ཉིད་དུ་གཟུང་བ་རྣམས་ལ་བདག་ཏུ་བྱེད་པ་དང་བད་ག་གིར་༡བྱེད་པར་རབ་ཏུ་ཞུགས་པའི་བདག་ཉིད་ཅན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་གིས་དག་པར་ཡིད་ཆེས་པ་དེ་༡མཆོག་ཏུ་འཛིན་པའི་ཕྱིར་རོ།་།",
    "གང་གི་ཕྱིར་མ་སྐྱེས་པ་སྟེ་དོན་དམ་པར་སྐྱེ་བ་མི་རུང་བའི་ཕྱིར་རོ།",
    "དབྱེར་མེད་པ་སྟེ་གཟུགས་སུ་རུང་བ་ལ་སོགས་པའི་རང་གི་མཚན་ཉིད་ཐ་དད་མེད་པ་ཉིད་ཀྱི་ཕྱིར་ར་རོ།",
    "སེམས་འདི་ཁོ་ན་ལུས་དང་ངག་གི་རྣམ་པར་སྣང་བའི་ལུས་ལ་གོགས་པ་ཞེས་བྱ་བ་གཟུང་བར་བྱ་བ་ནི་ཡོད་པ་མ་ཡིན་པས་སོ།",
    "རྡོ་རྗེའི་བདག་ཉིད་ཡང་དག་པར་བྱུང་བ་ནི་ལུས་ད་ང་ངག་དང་སེམས་རྡོ་རྗེའི་རང་གི་ངོ་བོར་སྐྱེས་པ་སྟེ།",
    "དེ་ཡང་གནས་སྐབས་འདི་ལ་ལྷག་པར་མོས་པ་ཁོ་ན་ཡིན་གྱི་མངོན་དུ་བྱས་པ་ནི་མ་ཡིན་ནོ།",
    "གང་གི་རྡོ་རྗེ་གསུམ་གྱི་བདག་ཉིད་རྡོ་རྗེ་གསུངས་པ་དེ་ཉིད་སླར་ཡང་ཁྱད་པར་དུ་འཆད་པར་འགྱུར་བའི་ཕྱག་དང་ཞལ་ལ་སོགས་པས།",
    "ཡེ་ཤེས་དང་མཐུ་དག་ག་གིས་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་དེ་དང་དེར་ལྷག་པར་མོས་༐",
    "ས་བོན་ལས་སྐྱེས་པའི་རང་གི་རྟེན་ལ་གནས་པའི་ས་བོན་དང་བཅས་པའི་ཕྱག་མཚན་གྱི་གནས་སྐབས་སོ།",
    "རྣམ་པར་གཞག་༢པ་འདི་ཡང་གང་གི་ཚེ་ལྷ་ཞུ་བར་གྱུར་པ་མ་ཡིན་པ་ནའོ།",
    "དེའི་རྗེས་སུ་བཙས་པའི་གནས་སྐབས་ལྟ་བུ་ནི་གཟུགས་དང་ལང་ཚོ་ལ་སོགས་པས་བརྒྱན་པའི་བུ་མོ་དང་སྙོམས་པར་འཇུག་པ་ལ་སོགས་པའི་གནས་སྐབས་སོ་ཞེས་པའོ་། དེའི་༐",
    "གང་གི་ཚེ་གཞན་གྱི་དོན་བྱ་བ་ལ་སྐད་ཅིག་ཀྱང་ངལ་བསོ་བ་མེད་པ་དེའི་ཚེ།",
    "ཅིས་གང་ཇི་སྲིད་པ་བདག་གིས་བརྗོད་པར་བྱ་ཞེས་པ་རེ་ཞིག་གཞག་ཁྱགོ།",
    "ལྷ་མོ་ཆེན་མོ་ནི་རྡོ་རྗེ་སྙེམས་མ་མིང་གཞན་རྡོ་རྗེ་དབྱིངས་ཕྱུག་མའོ།",
    "རེ་ཕ་ལས་སྐྱེས་པའི་ཉི་མ་ལ་གནས་པའི་ཧཱུྃ་ལས་སྐྱེས་པའི་སྣ་ཚོགས་རྡོ་རྗེ་དང་ཧཱུྃ་ལས་སྐྱེས་ཤིང་འབར་བའི་རྡོ་རྗེ་རྣམས་ཀྱིས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "རང་གི་ཞེས་པ་ལ་སོགས་པའོ།",
    "རང་གི་རིག་མ་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "དེ་རོལ་མོར་བྱེད་པའི་ཕྱིར་མུ་ཀུནྡ་མའོ།",
    "འདིར་བཞད་མ་དང་སྒེག་མོ་དང་།",
    "ལྷ་མོ་བརྒྱད་རྣམས་ཀྱང་རྒྱུད་གཞན་དུ་གསུངས་པའི་ཕྱིར་རིག་པར་བྱའོ་ཞེས་མང་དུ་མཁྱེན་པ་རྣམས་གདམས་པར་བྱེད་དོ།",
    "ཐིག་ལེའི་རྣལ་འབྱོར་དང་ཕྲ་མོའི་རྣལ་འབྱོར་དང་བཟླས་པ་དང་བརྟས་༢པར་བྱ་བ་དང་བསྡུ་བ་ལ་སོགས་པའོ་ཞེས་པའི་རིམ་པ་ནི།",
    "འཆི་བདག་གི་བདུད་ལས་རྒྱལ་བའི་ཕྱིར་རོ།",
    "པདྨ་མཐར་བྱེད་ནི་ཕུང་པོ་སྟོང་པ་ཉིད་ལ་དྲན་པའི་ངོ་བོ་ཉིད་ཀྱིས་ན་མ་དག་པའི་འདོད་ཆགས་ལས་སྐྱེས་པའི་ཐུན་མོང་བའི་ངག་ཕྱག་རྒྱ་དང་སྙོམས་པར་འཇུག་པ་ལས་ཀྱང་མཐར་བྱེད་པའི་ཕྱིར་ར་རོ།",
    "གཡོ་མེད་བརྟན་པར་གྱུར་པའི་རེག་པ་དང་།་",
    "འདི་རྣམས་རྣམ་པར་ད་ག་པས་ན་རྣམ་པར་དག་པ་རྣམ་པ་དྲུག་གི་སེམས་སྐྱེ་བའི་ངོ་བོ་རྣམས་ནི་འདོད་པའི་རྒྱལ་པོ་ལ་སོགས་པ་དྲུག་རྣམས་ཏེ།",
    "དེ་ནི་འདིར་ཐ་མལ་པའི་ང་རྒྱལ་བསལ་བར་རང་གི་སེམས་སྣང་བའི་ངོ་བོ་ཕྱག་ལ་སོགས་པས་རྣམ་པར་མཛེས་པའི་ལྷའི་སྐུའོ།",
    "གལ་ཏེ་རང་དང་གཞན་གྱི་རྒྱུད་དག་གཅིག་པ་ཉིད་དངོས་པོ་པ་བརྫོད་པར་འདོད་ན་འགལ་བར་འགྱུར་མོ་ད།",
    "ལྷག་པར་མོས་པ་པ་པའོ།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་རྣམས་ཐམས་ཅད་དང་ལྷན་ཅིག་བདག་ཉིད་བརྟན་པར་གཅིག་པ་ཉིད་དུ་ལྷག་པར་མོས་པ་ནི་མཉམ་པ་ཉིད་དུ་ཡིད་ཆེས་པའི་དོན་ཁོ་ནའོ།",
    "དེ་བཞིན་དུ་འགྲོ་བ་ཡང་ལྷན་ཅིག་གཅིག་པ་ཉིད་དུ་ལྷག་པར་མོས་པ་ནི་རང་བཞིན་རྣམ་པར་དག་པའི་དེ་བཞིན་ཉིད་མཚུངས་པ་ཉིད་དུ་རྟོགས་པའི་ཆེད་དུའོ།",
    "ཉོན་མོངས་པས་ཡོངས་སུ་གོས་པའི་སེམསཅན་གྱི་༐",
    "འདིར་ནི་བདག་གི་གསང་བ་ཡི།",
    "རྡོ་རྗེ་ལྷ་མོ་ཀུན་འདུས་དང་།",
    "ལུས་ཀྱི་ཡན་ལག་ཐམས་ཅད་ལ་རྣམ་པར་རྒྱུ་བ་ཉིད་ཀྱི་ཕྱིར་རེག་བྱེད་ལ་དོན་ཡོད་ཀྱིས་ས་སོ།",
    "གཏི་མུག་གི་གཞི་ཅན་ཉིད་ཀྱི་ཕྱིར་གཟུགས་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིས་རྒྱས་གདབ་པའོ།",
    "རིགས་ཀྱི་བདག་པོའི་ཁ་དོག་གི་རིམ་བ་ལས་འདས་པ་ལ་རྒྱུ་དང་ཡང་།་",
    "རང་གི་རྒྱུ་ནི་ཇི་ལྟར་རིགས་པར་ཞེ་སྡང་ལ་སོགས་པ་རྣམས་ཏེ།",
    "དེ་ལྟར་ཁ་དོག་གི་དབྱེ་བ་ལ་སོགས་པ་ལ་ཡང་རྟོགས་པར་བྱའོ།",
    "བསམ་པའི་འགྱུར་བ་ལ་སོགས་པའི་དབྱེ་བ་མེད་ན་ཡང་ཁྲོ་བོ་རྣམས་ཁ་ཅིག་ཞེ་སྡང་གི་རིགས་ཉིད་ཡིན་གྱི་ཞེ་སྡང་གི་ངོ་བོ་ཉིད་མ་ཡིན་ཏེ།",
    "དེ་ལ་གླིང་བུ་མ་དང་པི་ཝང་མ་དང་ཇ་ཟླུམ་མ་ད་ང་རྫ་རྔ་མ་དང་བཞད་མ་དང་སྒེག་མོ་དང་གླུ་མ་དང་གར་མ་དང་མེ་ཏོག་མ་དང་བདུག་པ་མ་དང་མར་མར་མེ་མ་དང་དྲི་ཆབ་མ་ད་ང་།",
    "རེག་བྱ་མས་སྣ་ཚོགས་པའི་གོས་འབུལ་བའོ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གི་ངོ་བོར་བདག་ཉིད་ཀྱི་ལུས་དང་ངག་དང་ཡིད་སྟེང་དང་༐",
    "ཧཱུྃ་ཞེས་བརྗོད་ལ་མི་བསྐྱོད་པ་སྤྲོས་ནས་རང་གི་ལུས་དང་རོ་མཉམ་པར་བྱས་ཏེ།་",
    "ཞལ་སོ་སོ་ལ་སྨིན་མ་འཁྱོག་ཅིང་གཡོ་བ་ད་ང་བཅས་པའི་སྤྱན་གསུམ་དམར་ཞིང་ཟླུམ་པ་ཡང་ཡང་དུ་ཧཱུྃ་ཡིག་སྒྲོགས་པས་ང་རོ་འདོན་ཅིང་ཕྱོགས་སུ་ལྟ་བ།",
    "སྟག་གི་པགས་པའི་གོས་བཤུས་༡པ་མི་རུས་ལས་བྱུང་བའི་ཐལ་བའི་རྡུལ་གྱིས་བྱུགས་པ།",
    "རྡོ་རྗེ་དང་རྡོ་རྗེ་དྲིལ་བུ་དང་ལྡན་པའི་ཕྱག་དག་གིས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱས་རང་འདྲའི་ཤེས་རབ་མ་ལ་སྙོམས་པར་ཞུགས་པ་སྟེ།",
    "གཡོན་པ་དག་ན་ཐོད་པ་དང་ཁ་ཊྭཱཾ་ག་དག་སྟེ་གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་༢ིཞབས་གཉིས་ཀྱིས་འཇིགས་བྱེད་དང་དུས་མཚན་མནན་པའོ།",
    "མེ་མཚམས་སུ་འདོད་པའི་རྒྱལ་པོ་རང་འདྲའི་སྣ་ཚོགས་རིན་ཆེན་མ་ལ་འཁྱུད་པ་རིན་འབྱུང་གི་ཅོད་པན་ཅན།",
    "སེར་པོ་ད་ང་དཀར་བ་དང་དམར་བའི་ཞལ་ཅན་ཕྱག་དག་གིས་གཙུག་ཏོར་སྤྱི་བོར་འཛིན་ཅིང་།",
    "འདི་རྣམས་ཐམས་ཅད་ཀྱང་རང་རང་གི་རྩིབས་ཀྱི་རྩེ་མོའི་སྟེང་དུ་ཅུང་ཟད་མ་རེག་པའི་སྣ་ཚོགས་པདྨ་དང་ཉི་མ་རྣམས་ལ་གཡས་བརྐྱང་གི་ཟླ་བའི་སྟབས་ཀྱིས་གནས་པ།",
    "དེ་ནས་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱིས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱའི་གཡོན་པའི་སྡིགས་མཛུབ་ད་ང་མཛེ་བོང་གིས་སེ་གོལ་བྱས་པ་ལས་གཤིན་རྗེ་མཐར་བྱེད་དང་ཤེས་རབ་མཐར་བྱེད་དང་པདྨ་མཐར་བྱེད་དང་བགེགས་མཐར་བྱེད་རྣམས་རང་རང་གི་གནས་སུ་རང་གི་སྐུ་གཉིས་པ་སྤྲུལ་ཏེ་འོངས་ནས་མདུན་དུ་བཞུགས་པ་ཅི་བགྱི་ཞེས་བཀའ་ནོད་པ་རྣམས་ལ་གྲངས་ཇི་ལྟ་བར།",
    "དེ་རྣམས་ནི་ཕྱོགས་བཅུ་རྣམས་སུ་སོང་ནས་བགེགས་ཀྱི་བདག་པོ་རྣམས་ལྕགས་ཀྱུས་བཀུག་ཅིང་ཞགས་པས་མགྲིན་པར་བཅིངས་ལ་ཡང་དག་པར་བསྡིགས་ཏེ།",
    "ཁྲོ་བོ་རྣམས་ཀྱིས་ཀྱང་ཕྱག་གཡོན་པས་ལྟེ་བ་ལས་འོག་ཏུ་རྡོ་རྗེ་རྩེ་གཅིག་པའི་རྣམ་པས་སྟེང་དུ་བདག་ཉིད་ཀྱི་གཟུགས་ཅན་གྱི་ཕུར་བ་བཟུང་ནས་སྒྲ་རིང་པོར་བརྗོད་པའི་ཧཱུྃ་ཡིག་ལས་གྲུབ་པའི་རང་རང་གི་ཕྱོགས་ཀྱི་རྩིབས་ཀྱི་རྩེ་མོ་དང་ཉེ་བའི་ཁྲོན་པར་བགེགས་རྣམས་བཅུག་སྟེ།",
    "སྟོབརྡུང་བ་དང་ཕུར་པ་འདེབས་པ་དག་གིས་བགེགས་ཀྱི་ཚོགས་བདེ་བ་ཆེན་པོ་དེ་བཞིན་ཉིད་གཅིག་པའི་ངོ་བོར་བསམ་པར་བྱ་ཞིང་བགེགས་ལྷག་མ་རྣམས་རིང་དུ་འབྲོས་བཞིན་པ་སྟེ།",
    "འོག་ཟུར་ནས་བྱུང་བའི་སྣ་ཚོགས་པའི་འདབ་མ་ཅན་གྱི་པདྨའི་སྟེང་དུ་སྣ་ཚོགས་རྡོ་རྗེས་བརྒྱན་པ་བསམ་མོ།",
    "སྣ་ཚོགས་འདབ་མ་ཅན་གྱི་པདྨ་ལ་གནས་པའི་ཟླ་བ་དང་ཉི་མའི་གདན་སུམ་ཅུ་རྩ་བདུན་རྣམས་དང་ལྡན་པའི་ཁང་པ་བརྩེགས་པ་བསྒོམ་མོ།",
    "ཡ་ར་ལ་ཝ་ཌ་ཌྷ་ལྷག་པའི་གསལ་བྱེད་ཉིས་འགྱུར་གྱི་གཟུགས་རྣམས་སུ་མོས་ཏེ།",
    "ཨོཾ་ཙིཏྟ་པྲ་ཏི་བེ་དྷཾ་ཀ་རོ་མི་ཞེས་པའི་སྔགས་ནང་གི་བརྗོད་པས་བྱིན་གྱིས་བརླབ་བ་བོ།",
    "འོད་ཟེར་གྱིས་བསྐུལ་བའི་ནམ་མཁར་གནས་པའི་དེ་བཞིན་གཤེགས་པ་རྡོ་རྗེ་འཛིན་པའི་གཟུགས་སུ་གྱུར་པ་རྣམས་ཧཱུྃ་ཡིག་གི་ནང་དུ་ཆུད་པ་ན།",
    "ཞེས་པའི་སྔགས་ནང་གི་བཟླས་པས་བསྐུལ་བའི་རྗེས་ཐོགས་སུ་རོ་མཉམ་པར་གྱུར་པ་༢ཐམས་ཅད་ཡོངས་སུ་གྱུར་པས་རྡོ་རྗེ་འཆང་སེམས་དཔའ་གསུམ་གྱི་བདག་ཉིད་བསྒོམ་ཞིང་།",
    "ཕྱག་གདུབ་དང་སྐེ་རགས་དང་ཐལ་བས་བརྒྱན་པ།",
    "ཕྱག་དྲུག་པ་རྡོ་རྗེ་དང་རྡོ་རྗེ་དྲིལ་བུས་རྣམ་པར་མཛེས་པའི་ཕྱག་ཟུང་གིས་རང་འདྲའི་ཤེས་རབ་མ་ལ་འཁྱུད་ཅིང་མཚོ་སྐྱེས་ལ་གཉིས་སྦྱར་བའི་དགའ་བའི་ཚོགས་དང་ལྡན་པ།",
    "ཕྱག་གཡས་པ་དག་གིས་རལ་གྲི་དང་ལྕགས་ཀྱུ་འཛིན་པ།",
    "ཤེས་རབ་མ་དགྱེས་ཏེ་རང་རང་གི་རིགས་དང་འབྲེལ་བའི་སྤྱན་མ་ལ་སོགས་པ་ལྷ་མོའི་གཟུགས་སུ་༡ཕྱུང་བ་དེ་རྣམས་ཤེས་རབ་མའི་ནང་དུ་ཆུད་པ་ན།",
    "བློས་རང་རང་གི་འཇིག་རྟེན་གྱི་ཁམས་སུ་བཏང་སྟེ།",
    "དཀྱིལ་འཁོར་ཡང་མི་བསམ་མོ།",
    "མིག་དག་ཏུ་ཆུ་སྐྱེས་དང་ཟླ་བ་ལ་འཁོར་ལོ་ད་ང་ཨོཾ་ཡིག་ལས་སྐྱེས་པའི་གཏི་མུག་རྡོ་རྗེ་དཀར་པོ་གཟུགས་རྡོ་རྗེ་མ་ལ་འཁྱུད་པ་བསྒོམ་མོ།",
    "ལྕེའི་རྩ་བར་ཆུ་སྐྱེས་དང་ཉི་མ་ལ་ཨཱ་ཡོངས་སུ་གྱུར་པ་འདོད་ཆགས་རྡོ་རྗེ་དམར་པོ་རོ་རྡོ་རྗེ་མ་དང་སྙོམས་པར་ཞུགས་པའ་། དཔྲལ་བར་ཆུ་སྐྱེས་དང་ཉི་མ་ལ་རལ་གྲི་དང་ཧཾ་ཡོངས་སུ་གྱུར་པ་ཕྲག་དོག་རྡོ་རྗེ་ལྗང་གུ་རེག་བྱ་རྡོ་རྗེ་མ་༡དང་སྙོམས་པར་ཞུགས་པའོ།",
    "གཡས་བརྐྱང་གི་རྐང་སྟབས་ཅན་རྣམས་སོ།",
    "འོན་ཀྱང་གཡས་བརྐྱང་གི་ཟླ་བོའི་ཞབས་སྟབས་ཅན།",
    "ཕྱག་གཡས་པ་གསུམ་ལྕགས་ཀྱུ་དང་ཚངས་པའི་མགོ་བོ་དང་གྲི་གུག་གིས་མཛེས་པ།་",
    "ཕྱག་གཡོན་པ་གསུམ་ན་ཐོད་པ་ད་ང་ཁ་ཊྭཱཾ་ག་དང་ཞགས་པ་འཛིན་པ་སྤྱན་གསུམ་པ་ཕྱག་རྒྱ་ལྔ་ཅན་སྐྲ་གྲོལ་བ་གཅེར་བུ་གཡས་བརྐྱང་གི་ཞབས་སྟབས་ཅན་ནོ།་།",
    "དྲུག་པོ་འདི་རྣམས་ནི་རིམ་པ་ཇི་ལྟ་བར་རྡོ་རྗེ་ཕག་མོ་དང་གཤིན་རྗེ་མ་དང་རྨོངས་བྱེད་མ་དང་སྐྱོད་བྱེད་མ་དང་སྐྲག་བྱེད་མ་དང་གཏུམ་མོས་འཁྱུད་པར་བྱས་པའོ།",
    "དེ་ལ་རྡོ་རྗེ་ཕག་མོ་ནི་དམར་མོ་ཞལ་གཡས་པ་དང་ཅིག་ཤོས་སྔོན་པོ་དང་ལྗང་གུ་ཕྱག་གཡོན་པ་གསུམ་ཐོད་པ་དང་ཁ་ཊྭཱཾ་ག་དང་ཞགས་པ་འཛིན་པ།",
    "གཡོན་པ་དག་གིས་ཐོད་པ་དང་བཅས་པའི་ཁ་ཊྭཱཾ་ག་ད་ང་དྲིལ་བུ།",
    "གཡས་པ་དག་གིས་ཅང་ཏེའུ་དང་གྲི་གུག་དག་འཛིན་པ།་",
    "གཡས་བརྐྱང་གི་ཞབས་སྟབས་ཅན་རྣམས་སོ།་།",
    "དེ་ལྟར་བདག་ཉིད་ལ་བསམས་ནས་རང་གི་ཤེས་རབ་མ་ལ་ཡང་མིག་ལ་སོགས་པ་རྣམ་པར་དག་པའི་རང་བཞིན་འདི་ཐམས་ཅད་ཡུད་ཀྱིས་བསམ་པར་བྱའོ།",
    "དེ་ལ་༡ལྟེ་བར་ཨོཾ་བཾ་ལས་སྐྱེས་པའི་རྡོ་རྗེ་ཕག་མོའོ།",
    "མགྲིན་པར་ཧོཾ་མོཾ་ལས་སྐྱེས་པའི་རྨོངས་",
    "ཡན་ལག་ཐམས་ཅད་ལ་ཧཱ་ཕཊ་ལས་སྐྱེས་པའི་གཏུམ་མོ་སྟེ།",
    "ཧཱུྃ་ཡིག་གིས་རང་གི་རྡོ་རྗེ་ནོར་བུ་ཨོཾ་ལས་སྐྱེས་ཤིང་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "དེ་ལ་རྗེས་སུ་ཆགས་པའི་དུས་སུ་མཉམ་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་མངོན་དུ་གྱུར་པ་ལས་བསྒྲུབས་པའི་རིག་མ་དང་རང་གི་བདག་ཉིད་ལ་ཐ་དད་པ་བསལ་བ་ཁོ་ནས་སྙོམས་པར་འཇུག་ཅིང་།",
    "པདྨ་འི་ནང་དུ་ལྷུང་བ་རྣམས་ཀྱིས་ཡེ་ཤེས་ལྔའི་བདུད་རྩི་དེ་ལྕེའི་རྩེ་མོའི་རོལ་བས་འཛིན་བཞིན་པར་བསམ་མོ་ཞེས་པ་སྦྱོར་བ་དང་པོ་ཞེས་པའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "གཡས་པ་དག་གིས་འཁོར་ལོ་དང་དྲིལ་བུ་དག་དང་གཡོན་པ་དག་གིས་ཐོད་པ་དང་ཞགས་པ་འཛིན་པའོ།",
    "གཡས་པ་དག་གིས་མདའ་དང་།",
    "གཡོན་པ་དག་གིས་གཞུ་དང་ཞགས་པ་འཛིན་པའོ།",
    "ཁཾ་ཞེས་པས་བྱང་དུ་དོན་ཡོད་གྲུབ་པ་ལྗང་གུ་ཕྱག་གཡས་པ་དག་གིས་རྡོ་རྗེ་དང་ལྕགས་ཀྱུ་དག་དང་།",
    "གཡོན་པ་དག་གིས་དྲིལ་བུ་དང་ཐོད་པ་དག་འཛིན་པའོ།",
    "ཧཱུྃ་ཞེས་པས་མེ་མཚམས་སུ་མཱ་མ་ཀཱི་སྔོན་མོ་ཕྱག་བཅུ་གཉིས་པ།",
    "ཧྲཱི་ཞེས་པས་བདེན་བྲལ་མཚམས་སུ་གོས་དཀར་མོ་༢དམར་མོ་ཕྱག་བརྒྱད་མ་གཡས་པ་རྣམས་ཀྱིས་མདའ་དང་པདྨ་དང་རལ་གྲི་དང་རྡོ་རྗེ་འཛིན་པ།",
    "དེ་བཞིན་དུ་ལྷ་གཞན་རྣམས་ཀྱང་རང་རང་གི་བསྐྱེད་པའི་ས་བོན་རྣམས་ཁོ་ནས་དབྱུང་བར་བྱའོ།",
    "དེ་ལ་རིམ་པ་གཉིས་པར་ཤར་ཕྱོགས་སུ་རྡོ་རྗེ་དྲག་མོ་དཀར་མོ་ཕྱག་བཞི་མ་ལ་གཡས་པ་དག་ན་མདའ་དང་ལྕགས་ཀྱུ་དག་དང་།",
    "ལྷོར་རྡོ་རྗེ་གཟུགས་མ་སེར་མོ་ཕྱག་བཞི་མ།",
    "གཡས་པས་རྡོ་རྗེ་དང་མདུང་འཛིན་ཅིང་གཡོན་པས་ཞགས་པ་དང་ཁྲག་གིས་གང་བའི་ཐོད་པས་བརྒྱན་པའོ།",
    "མིང་གཞན་རྡོ་རྗེ་འདོད་ཆགས་མ་༡དམར་མོ་ཕྱག་བཞི་མ་གཡས་པར་རལ་གྲི་དང་རྡོ་རྗེ་འཛིན་ཅིང་།",
    "གཡས་པས་ཐལ་སྦྱར་དང་བ་དན་གསུམ་པ་ལྡན་པ།",
    "གཡོན་པས་འཁོར་ལོ་དང་ཁྲག་གིས་གང་བའི་ཐོད་པ་འཛིན་པའོ།",
    "རིམ་པ་གསུམ་པ་ལ་ཤར་ཕྱོགས་སུ་བཞད་མ་དམར་མོ་ཕྱག་གཉིས་རྡོ་རྗེ་དང་དྲིལ་བུ་དང་བ་ཅས་པས་བཞད་པའི་ཚུལ་ཅན་ནོ།་།",
    "ལྷོར་སྒེག་མོ་སྔོན་མོ་ཕྱག་གཉིས་རྡོ་རྗེ་དང་རྡོ་རྗེ་དྲིལ་བུ་འཛིན་པས་འགྱིང་བ་དང་བཅས་པའི་སྒེག་པའི་ཚུལ་ཅན་ན་ནོ།",
    "ཧཱུཾ་གི་གླུ་ལེན་ཅིང་གར་སྔོན་མ་ཅན།",
    "རྐེད་པའི་ཕྱོགས་སུ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིང་༡བས་གཡས་རོལ་དུ་བཞག་ནས་རོལ་བ་དང་བ་ཅས་པར་མགོ་བོ་ཅུང་ཟད་གཡོན་གྱི་ཆར་དུད་པ་ནི་རྡོ་རྗེ་སྒེག་མོའོ་ཞེས་སོ།",
    "ནུབ་ཏུ་གླུ་མ་སེར་མོ་སྒེག་པས་ལུས་ཅུང་ཟད་གཡོ་ཞིང་ཕྱག་གཉིས་འཁར་བའི་སིལ་ཁྲོལ་འཛིན་པའོ།",
    "མེར་པི་ཝང་མ་སེར་མོ་སྒེག་པའི་ཉམས་ཀྱིས་ལུས་ཅུང་ཟད་གཡོ་བའོ།",
    "བདེན་བྲལ་དུ་རྔ་མུ་ཀུནྡ་དཀར་མོའོ།",
    "བཞི་པོ་འདི་རྣམས་ནི་ཕྱག་གཉིས་རང་རང་གི་རོལ་ཆ་སྒྲོགས་པ་ལྷུར་ལེན་པའོ།",
    "ལྷོར་རོ་མ་དམར་མོ་ཕྱག་གཉིས་རོའི་སྣོད་འཛིན་པའོ།",
    "ནུབ་ཏུ་རེག་བྱ་མ་ལྗང་གུ་ཕྱག་གཉིས་ཀྱིས་གོས་སྣ་ཚོགས་འཛིན་པའོ།",
    "ནུབ་ཏུ་རྡོ་རྗེ་ལྕགས་སྒྲོག་མ་དམར་མོ་གཡས་ད་ང་ཅིག་ཤོས་ཀྱི་ཞལ་ནག་པོ་དང་དཀར་བ།",
    "བཞི་པོ་འདི་རྣམས་ཞལ་སོ་སོ་ལ་སྤྱན་གསུམ་པ་སྐྲ་དམར་སེར་གྱེན་དུ་འབར་བ་ཐོད་པ་ལྔ་ད་ང་འཁོར་ལོ་ཅན་ལ་སོགས་པས་བརྒྱན་པ་སྟག་གི་པགས་པའི་གོས་ཅན།་",
    "གཡས་བརྐྱང་གི་ཟླ་བོས་གར་བྱེད་པ་སྟེ་སྣ་ཚོགས་པདྨ་དང་ཐོད་པ་དང་ཉི་མ་ལའོ།",
    "ཨོཾ་ཀུ་རུ་ཀུ་རུ་ས་མ་ཡ་ཨ་ངྷི་པ་ཏི་ཧཱུྃ་ཛ་སྭཱ་ཧཱ་ཞེས་བརྗོད་ཅིང་སྤྱན་དྲངས་ནས་པད་ཀོར་སྔོན་མ་ཅན་གྱིས་རང་གི་འཁོར་ལོ་ལ་གཞུག་༢ག་གོ།",
    "དེ་ལྟ་ཁོ་ནར་རྡོ་རྗེ་དྲིལ་བུ་མ་ཧོ་ཡིག་བརྗོད་པ་མོས་འོད་ཟེར་དམར་པོ་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་འགེགས་པའི་ཕྱིར་མཉེས་པར་བྱའོ།",
    "ཡེ་ཤེས་སེམས་དཔའ་ནི་ལྷག་པར་མོས་པས་བསྐྱེད་པར་བྱའོ།",
    "དེ་ལ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་མཱ་མ་ཀཱི་ད་ང་སྒྲ་རྡོ་རྗེ་མ་ད་ང་གླུ་མ་དང་རེག་བྱ་རྡོ་རྗེ་མ་༐",
    "སྤྱན་མ་དང་རྡོ་རྗེ་དྲག་མོ་དང་ས་རྡོ་རྗེ་མ་ད་ང་མེ་ཏོག་མ་དང་བཞད་མ་དང་གླིང་བུ་མ་དང་རྡོ་རྗེ་ལྕགས་ཀྱུ་མ་རྣམས་ཀྱི་རྣམ་པར་སྣང་མཛད་དོ།",
    "གོས་དཀར་མོ་དང་རྡོ་རྗེ་ཆགས་པ་མ་དང་མར་མེ་མ་དང་༐",
    "སྒྲོལ་མ་དང་རྡོ་རྗེ་ཞི་བ་མ་དང་རྡོ་རྗེ་གནོད་སྦྱིན་མོ་༡དང་གར་མ་དང་རོ་མ་དང་རྫ་ཇ་མ་དང་རྡོ་རྗེ་དྲིལ་བུ་མ་རྣམས་ཀྱི་དོན་ཡོད་གྲུབ་པའོ།",
    "དེ་ནས་སུམ་ཅུ་རྩ་གཉིས་པར་འཆད་པར་འགྱུར་བ་རྐང་པ་བརྒྱད་པའི་སྔགས་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་ལྷ་མོ་རྣམས་ཀྱིས་ཞལ་རྣམས་ཀྱིས་བསྟོད་པར་བྱའོ།",
    "ཧཱུྃ་དཀར་པོ་ལས་སྐྱེས་པ་ནས་ཀྱི་འབྲས་བུའི་ཚད་ཙམ་པ་ཧཱུྃ་ཡིག་གིས་བྱིན་གྱིས་བརླབས་པའི་རྡོ་རྗེ་རྩེ་གཅིག་པའི་ལྕེའི་འོད་ཟེར་གྱི་སྦུ་གུ་རྣམས་ཀྱིས་སམ་ཡིད་ཀྱིས་དྲངས་པ་རྣམས་མ་ཞེན་པར་མྱང་བར་བྱའོ།",
    "དེའི་རྗེས་སུ་རྡོ་རྗེ་འཛིན་པས་བསྐུལ་བའི་དཀྱིལ་འཁོར་པའི་ལྷ་མ་ལུས་པ་རྣམས་དང་བཅོམ་ལྡན་འདས་ཀྱིས་སྐུའི་བཀོད་པ་སྤྲོས་ྤྲོས་པ་ཡུད་ཀྱིས་ནམ་མཁའི་ཁོངས་ཁྱབ་པ་རྣམས་ཀྱིས་གཞན་རྣམས་ཀྱི་དོན་དང་རྡོ་རྗེ་འཆང་ཆེན་པོའི་གོ་འཕང་འཐོབ་པར་ནུས་པ་ཉིད་དུ་བསྐྱེད་ནས་རང་གི་ལུས་ཀྱི་བཀོད་པ་རྣམས་རྩ་བའི་ལུས་ལ་བསྡུའོ་ཞེས་པ་ལས་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གསུམ་པའོ།",
    "དེ་ཉིད་ལས་འོད་ཟེར་གྱི་རེ་ཁཱ་ཕྲ་མོ་མེ་ལྕེ་གཅིག་ཏུ་འབར་བ་ལྟར་གནས་པར་བལྟའོ།",
    "འོད་ཟེར་གྱི་རེ་ཁཱ་དེ་ཡང་བསིལ་བར་གྱུར་ཏེ།",
    "བརྟན་པ་ཉེ་བར་མཚོན་པ་ན་འོད་ཟེར་གྱི་རེ་ཁཱ་དེའི་སྣང་བ་གསལ་བས་སྣ་ཚོགས་༐",
    "དེའི་རྗེས་སུ་ཕྲ་མོའི་རྣལ་འབྱོར་སྒོམ་༡པ་ནི་སེམས་བརྟན་པར་བྱེད་པའི་ཐབས་དམ་པའོ་ཞེས་པས།",
