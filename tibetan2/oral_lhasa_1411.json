    "འཚམས་ཐུང་ཙམ་བྱས་པས་ལྟས་ཀྱང་བཟང་བར་བྱུང་།",
    "བལ་པོ་བཟོ་བོ་རྣམས་སླར་ངམ་རིང་ལ་འགྲོ་སྐབས་བརྒྱན་བུ་གཉེར་པ་བཤེས་གཉེན་པས་ཅི་ལོད་ལོད་བྱས་ཤིང་།",
    "དིང་རི་ཕྱོགས་སུ་ནས་སྟེར་མཁན་བྱུང་བ་འདྲ་ལ་ཆ་རྐྱེན་བྱས།",
    "ཐ་ན་གནས་སྐོར་རྟེན་མཇལ་སོགས་ཀྱང་བྱེད་ས་མེད་པའི་ནག་ཡིག་འགྲེམས་ཤིང་སྒྲོག་པར་བྱེད་དོ།",
    "ཉིན་གཅིག་འཁར་ལུང་ཡོང་གསུངས་ནའང་།",
    "འདི་སྐབས་ངམ་རིང་དུ་ཡོང་དགོས་ཚུལ་ནན་ཆགས་ཕེབས་ནའང་དུས་ཁྲིད་ཆག་དོགས་ནས་མ་ཕྱིན་ཞིང་།",
    "སྔ་སོར་དབུས་དམག་རྟིང་མ་མཛད་པས་སྐུ་ཚེ་ལ་གནོད་ཅིང་སྔ་ཕྱིར་ལྟས་ཀྱང་ཤིན་ཏུ་ངན་པས་སྐུ་ཁམས་མཐར་ཐོན་མི་ཡོང་ངེས་སྙམ།",
    "ཁྲིད་འཕྲོ་མགྱོགས་པོ་བྱས།",
    "ལེགས་པ་ཞིག་གནང་བྱུང་བ་འགྲིག་པ་སོགས་ལྟས་བཟང་པོ་ཡང་རིམ་པས་བྱུང་།",
    "མཐར་སྤུང་བཞུ་སོགས་ཐམས་ཅད་རྗེས་གཙང་བར་བསྒྲུབས།",
    "དོན་གཉེར་འགའ་ལ་གཅོད་ཁྲིད་སོགས་ཉེར་མཁོ་འགའ་ཡང་བྱས།",
    "ཉུག་རྒྱལ་ཁང་དུ་ཕྱིན་ཞག་གསུམ་བསྡད།",
    "དུས་འཁོར་གྱི་ཆོ་གའི་སྟེང་ནས་རབ་གནས་ཀྱང་བྱས།",
    "རྒྱལ་རྩེར་ཡང་ཕྱིན་ཅིང་སྡོད་ས་ཟིལ་གནོན་གྱི་གཟིམས་ཁང་གསར་པ་དེར་བྱས།",
    "ཡང་མར་ལམ་རྩེ་ཆེན་ཀླུ་སྡིངས་སུ་ཞག་གཅིག་བསྡད།",
    "སྔ་སོར་རྩེ་ཆེན་དུ་སླེབས་དུས་ནས་འབྱོར་རྒྱས་པ་འབོད་མི་ལ་གནང་བ་ལྟར་རིམ་པས་བསམ་འགྲུབ་རྩེར་སླེབས།",
    "བྱང་ཆེན་དུ་ཞག་ཉི་ཤུ་སྐོར་བསྡད་ཅིང་མཚམས་ཞག་བདུན་མ་ཞིག་གྲོལ་ནས།",
    "འདི་སྐབས་གནས་སྲིན་པོ་རི་ནས་དྲུང་ཡིག་བལ་དུ་བ་གནང་བའི་ཡར་ལམ་གནས་དང་ཁྲོ་ཕུར་ཡང་རབ་གནས་དགོས་ཚུལ་སོགས་ཕེབས་སྒོ་བྱུང་བ་ལ།",
    "ཁྲོ་ཕུར་འབྲུག་པའི་གྲྭ་ཚང་གསར་འདེབས་གནང་བ་ལ།",
    "ངེད་ཀྱི་རབ་གནས་དེ་རང་མཚལ་རང་ལ་བྱས་བཙག་མིའི་དཔེར་ཡང་འགྲོ་ལས་ཆེ་ཞིང་།",
    "ཞག་ཉི་ཤུ་སྐོར་ཞིག་བསྡད་པ་བབས་ནས་དོན་མེད་སོས་དལ་དུ་ལས་སེ་བ་ཅིག་བྱུང་ནའང་།",
    "སྟོན་དུས་བཟང་ཞིག་རིག་པ་དྭངས་ལ་སྐྱིད་པར་བྱུང་།",
    "སློབ་དཔོན་པདྨ་དང་མཇལ་ས་ཡིན་པར་སྣང་ཞིང་།",
    "གཙང་ལ་འགྲོ་དགོས་སྟབས་ནས་མ་ཐུབ་པས།",
    "བསམ་སྡིངས་སུ་ཡོད་དུས་ནས་བཟུང་འཇད་ནས་ཁང་པ་འབོད་མི་ཅར་སྡོད་གནང་བ་ལྟར།",
    "ཆགས་སྡང་སྣ་ཚོགས་ལ་བརྟེན་པའི་རྩུབ་ཟིང་ངེ་བ་ཟུར་རོང་ངེ་བ་ཡང་དགོས་པར་བྱུང་།",
    "འཇགས་ཀྱི་རྩིས་སྤྲོད་གནང་།",
    "གྲོང་པ་ཁ་ཤས་སྨོན་འགྲོ་ནས་ཁ་སྔ་བང་མགྱོགས་ཀྱིས་ཞུས་གྲུབ་ནས་གནང་མ་ཐུབ།",
    "ཁོང་འདས་རྗེས་ལོ་ལྔ་ཁུར་བཞེངས་མཛད་པ་ལ་རྩེ་བ་རྣམས་རྦུད་པའི་དམ་འགལ་མངོན་གྱུར་དང་བྱས།",
    "རིམ་པས་དཔོན་དྲུང་ལ་ཡང་ལེན་རྩིས་ཡིན་ཀྱང་བཤགས་པ་བྱེད་ཟེར་བ་ཁ་ཙམ་ཚིག་ཙམ་ཁོ་ན་ཡིན་པའི་རྟགས་ལོ་གཅིག་ཙམ་ཡང་ངང་སྲིང་མི་ཐུབ་པར་ཁ་དང་དོན་ཐམས་ཅད་ནས་མི་རིགས་པ་ཁོ་ན་བྱུང་བ་དང་།",
    "དེ་ནས་རིམ་གྱིས་ཆས་དེ་ལམ་འགོར་གང་ཡང་མ་བྱས་པར་གཏིང་སྐྱེས་སུ་འབྱོར།",
    "སླར་ཡང་གཏིང་སྐྱེས་ལ་རྒྱང་ཙམ་བསྡད།",
    "ཞག་གསུམ་བསྡད་སྐབས་དུས་འཁོར་ཐུགས་དཀྱིལ་རས་བྲིས་ལ་བརྟེན་ནས་ཁང་བ་རབ་གནས་དང་།",
    "དཔལ་ལྡན་རྩེར་བཅགས་མལ་ཞིག་བསྡད།",
    "བྱང་ནས་ལྷུན་གྲུབ་སྤེལ་བ་ཀུན་དགའ་གནང་ནས་གཙང་པ་འདི་ལ་བྱུས་ཅི་འདྲ་ཡོང་།",
    "བླ་བྲང་གོང་དུ་ཕྱི་མཚམས་མེ་བྱས་ནས་དེ་ཁོག་ནས་སྐྱིད་ཕུག་ཏུ་ཕྱིན་མཚམས་དམ་པར་བསྡམས།",
    "དགེ་སྦྱོར་འཕེལ་ཞིང་སྐྱིད་པར་བྱུང་།",
    "ཐོས་བསམ་སྒོམ་གསུམ་ལ་ཞེན་བྱས་པས་ཆོག་པའི་དོད་བསམ་ངན་དང་སྦྱོར་རྩུབ་དང་ཁ་ངན་རྣམས་ལ་མཛད།",
    "གླེགས་བམ་གསེར་མ་བཞུ་ནས་གསེར་བྱས།",
    "གསེར་སྐུ་རྫོགས་ནས་ཟངས་སུ་བྱས།",
    "དེ་ཙམ་སྟོང་ཤོབ་ལ་ལགས་ཏ།",
    "ཐུགས་ལ་མི་འཐད་ན་བཟོད་པ་བཞེས་པར་ཞུ།",
    "ངེད་ལ་ནི་བཟོད་པ་བྱས་མ་བྱས་ལ་ཁྱད་མེད་དོ།",
    "དེ་ནས་འགྱུར་ཟློག་ཆེན་པོ་ཚོ་མུ་ལ་བྱུང་བ་དེ་ལགས།",
    "དེ་སྐབས་བཅུ་པ་བ་རྣམས་བར་སྐབས་འདི་ལ་ཇོ་ནང་པས་དར་འཛུགས་བྱས་པའི་ཚེས་གཞིས་སུ་རྩིས་ལེན་པར་ཤོག་ཟེར་བ་ལན་མང་དུ་བྱུང་ནའང་།",
    "སང་སྔ་བར་བྱང་ཆེན་དུ་ཕྱིན་ཞག་གསུམ་བསྡད།",
    "སླེབས་པའི་གནངས་ཉིན་ནས་གཟུངས་བཞུགས་སོགས་ཀྱི་འགོ་བརྩམས།",
    "ཧོར་ཟླ་བཅུ་པའི་ཚེས་ལྔ་གཟའ་སྐར་བཟང་བ་ལ་རབ་གནས་ཀྱི་སྟ་གོན་བྱས།",
    "རབ་གནས་རྒྱས་པ་ཚར་དྲུག་དེ་སྐབས་བྱས་ཤིང་།",
    "ས་རྒྱན་གནམ་རྒྱན་མཆོད་རྫས་སོགས་ཀྱང་རྒྱས་པར་གྲ་འགྲིག།",
    "སྔ་གྲོའི་ཆ་ལ་ཤིས་བརྗོད་ཡན་ཆད་ཚང་བར་བྱས།",
    "ཇོ་ནང་གཞིར་བཞུགས་དང་དགོན་ལག་སོ་སོ་རྣམས་ཀྱི་ཆོག་གྲྭ་ཡང་ཆེ་རབ་མཛད་ཅིང་།",
    "སྐུ་འབུམ་ཐང་དུ་བཟོ་བོ་སོགས་གཞི་བྱེས་ཀུན་འདུས་ཀྱི་བཞུགས་གྲལ་ཐོག་ཏུ་བཟོ་བོ་རྣམས་ལ་ཡོན་རྫོངས།",
    "ལུང་ཞིག་ཀྱང་བྱས།",
    "བྱམས་པའི་སྐུ་གཟུགས་ལྷ་ཁང་དང་བཅས་པ་ལ་སྔ་སོར་རབ་གནས་ལན་དྲུག།",
    "ཧོར་ཟླ་བཅུ་གཅིག་པའི་ཡར་ཚེས་བཟང་བ་ཞིག་ལ་སླར་ཡང་རབ་གནས་གཅིག་སྟེ་ཀུན་དྲིལ་རབ་གནས་ལན་བདུན་བྱས་པ་ལ།",
    "དུས་འཁོར་ལུགས་གཅིག་རྣམས་བྱས།",
