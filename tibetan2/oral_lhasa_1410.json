    "དེ་ཉིན་ཚེས་ལྔ་ཡིན་ཞིང་ཚེས་བཅུ་བཞི་ལ་དུས་ཁྲིད་ཚུགས་པར་བྱས།",
    "ཧོར་ཟླ་དང་པོའི་ཚེས་བཅུ་དགུ་ལ་ཁྲིད་གཏོར་བྱས།",
    "ཁ་རོག་བསྡད་པས་ཟར་ཟིར་མེད་ཙམ་བྱུང་།",
    "གསེར་འབུམ་ཡང་གཟུངས་བཞུགས་སོགས་མེད་པའི་སྟོང་པར་བཞག།",
    "དེ་ནས་ཧོར་ཟླ་གཉིས་པའི་འགོལ་ལུང་ནག་ཤེལ་དཀར་བརྒྱུད་ལྷུན་རྩེར་ཕྱིན་ཟླ་ཕྱེད་སྐོར་ཞིག་བསྡད།",
    "སྐུ་འབྲིང་བས་ཞག་བཅུ་སྐོར་སྡོད་གསུང་བ་ལྟར་བསྡད།",
    "བསྙེན་རྫོགས་བྱས་པ་ནས་འདི་ཡན་ཆད་དུ་གསང་འདུས་འཕགས་ཞབས་ལུགས་གཉིས་ཀྱི་གཞུང་བཟང་ལ་མང་བ་རྣམས་དང་།",
    "དེ་འཕྲལ་བསམ་གཏན་སྡིངས་སུ་ཕེབས།",
    "སླེབ་འཕྲལ་ནས་མཚམས་དམ་པར་བཅད།",
    "བཟླས་བརྗོད་ལ་ཤིན་ཏུ་འགྲུས་པར་བྱས།",
    "དཔྱིད་ཐིག་བསྒོམས་པས་འདའ་བར་བྱས།",
    "མཚན་བྱང་བཞུ་བ་ལ་འགྲོ་དགོས་ཀྱིས་མཚམས་སེང་པ་དང་འགྲོ་བ་མཉམ་དུ་བྱས་ཤིང་དབུ་རྩེར་ཞག་གཅིག་སྡོད་དགོས་བྱུང་།",
    "དེས་ན་མན་ངག་ཁུངས་མའི་གེགས་སེལ་ཐམས་ཅད་དེས་མཚོན་པར་གོ་དགོས།",
    "ཟླ་བ་དེ་ཉིད་ཀྱི་ཉེར་གཅིག་ལ་རྒྱ་གར་ཤར་ཕྱོགས་སུ་འཁྲུངས་པའི་སློབ་དཔོན་ནི་རྦཱ་ཎ་ཤྲཱི་ཡང་ཕེབས་བྱུང་ཟླ་བ་ཕྱེད་གཉིས་ཙམ་བཞུགས་ཤིང་།",
    "བརྒྱད་པའི་ཚེས་བཅོ་ལྔ་མན་ནས་འཚམས་མ་གྲོལ་གྱི་བར་དུ་རྗེ་བཙུན་མ་ཞལ་གཉིས་མ་ལ་བསྙེན་པ་བྱས་ཤིང་བྱིན་གྱིས་བརླབས་པའི་རྟགས་མཚན་ཡང་ཅི་རིགས་པ་བྱུང་།",
    "སྔར་སོར་ནས་སོ་སོས་འབོད་མི་ནན་ཆགས་ཡོད་པ་ལྟར་ཧོར་ཟླ་བཅུ་གཅིག་པའི་ནང་དུ་བསམ་སྡིངས་ནས་བཏེགས་ཁྱུང་རྩེར་ཞག་གཅིག་བསྡད།",
    "དགོངས་བཞེད་ལྟར་རྣམ་སྲས་མདུང་དམར་ཅན་གྱི་རྗེས་གནང་ཡང་ཕུལ།",
    "མར་ལམ་རྩེ་ཆེན་དུ་ཞག་གསུམ་བསྡད།",
    "སྲེག་ཞག་བཅུ་གསུམ་ཙམ་བྱས་ཤིང་གྲངས་ཀྱང་ཐིམ།",
    "རྗེ་ཞྭ་དམར་བ་མཇལ་བར་ཕྱིན་དུས་དཔེ་མེད་ཀྱི་བསྟི་སྟངས་གནང་།",
    "དེ་ནུབ་བསམ་སྡིངས་སུ་སླེབས་ཙམ་བྱས།",
    "དགོངས་རྫོགས་དངོས་གཞི་གྲོལ་མཚམས་ཉི་ཕྱེད་ཙམ་ལ་ཐོན་པར་བྱས་ཏེ།",
    "སང་ཉིན་བསམ་སྡིངས་སུ་སླེབས་པར་བྱས།",
    "དེ་ནུབ་རང་གནས་སུ་སླེབས་ཞག་ཉི་ཤུ་སྐོར་ཕྱི་མཚམས་སེ་བྱས་ཤིང་།",
    "གནས་སྲིན་པོ་རིར་ཤོག་གསུང་བ་ལྟར་ཞག་གསུམ་ཙམ་བསྡད་ཅིང་།",
    "དེ་ནས་ཇོ་ནང་དུ་སླེབས་གཙང་བདེ་མཆོག་རྩེ་ལ་འབོད་མི་ནན་ཅན་བྱུང་བ་བཞིན་ཕྱིན།",
    "ཟླ་བ་གཉིས་ཙམ་གྱི་ཁོངས་སུ་ཡོང་གང་ཐུབ་བྱེད་བྱས་ཐག་བཅད་ནས་ཕྱིན།",
    "ཡར་ལམ་མར་ལམ་གཉིས་ཅར་ཏལ་སྙོགས་བྱས།",
    "ཅོག་པོ་རྩེར་ཕེབས་གསུང་བ་སོགས་བྱུང་ཡང་།",
    "ནག་པོ་པའི་བསྐྱེད་རྫོགས་ཀྱི་ཁྲིད་རྣམས་ཞིབ་པར་བཤད།",
    "ཕྱིན་ཞག་གཉིས་ཙམ་བསྡད།",
    "ཀོ་བྲག་པའི་སྐུ་འདྲ་ཕྱག་གནས་མ་སོགས་རྟེན་མཇལ་ཐམས་ཅད་ཞིབ་པར་བགྱིས།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་དབྱིངས་ལ་མཉམ་པར་བཞག་པ་ན།",
    "དམིགས་པའི་སྒྱུར་ཀ་བསྩལ་གདམས་པ་གནང་བ་ལྟར་བསྒོམས་པས་དེ་ཉིད་ཡོན་ཏན་དུ་གྱུར་ཏོ།",
    "དེ་ནས་སྟོན་དུས་ངམ་རིངས་ནས་འབོད་མི་གཟི་འབར་བ་གནང་བྱུང་ཞིང་།",
    "གདན་བཞུགས་ཕུལ་བའི་ཐོག་ཏུ་ཚོགས་ཀྱི་འཁོར་ལོ་བཀའ་དྲིན་རྗེས་དྲན་གྱི་ཡོན་དབུལ་བ་མཚོན་བྱེད་དང་བཅས་ཞབས་པད་བརྟན་པར་གསོལ་བ་བཏབ།",
    "འདི་སྐབས་ཞག་ཉི་ཤུ་རྩ་གསུམ་ཙམ་བསྡད་ཅིང་།",
    "ཞལ་ངོ་རྣམས་སུ་སྒྲོལ་དཀར་གྱི་རྗེས་གནང་།",
    "རྟ་མགྲིན་གྱི་རྗེས་གནང་དང་།",
    "དུར་ཁྲོད་བདག་པོའི་རྗེས་གནང་རྣམས་བྱས།",
    "ངས་མགྱོགས་པར་རྒྱུགས་པས་ཞབས་རྗེས་ཟིན་ཆིབས་བཤོལ་ནས་བཞུགས་གདན་ལ་བཞུགས་སུ་བཅུག་པས།",
    "དེ་ལ་བརྟེན་ཏེ་ཡིད་ཆེས་ཀྱིས་དྲངས་པའི་དགའ་བདེ་ཞག་བདུན་ཙམ་རྒྱུན་མི་འཆད་པར་བྱུང་ཞིང་།",
    "ཁྱད་པར་རང་ཉིད་ཀྱི་བློའི་འཆར་ཚུལ་ལས་བརྩམས་ཏེ།",
    "རྒྱུད་འབུམ་གྱི་འཕྲོས་ཕལ་ཆེ་བའི་ལུང་ཡང་ལེགས་པར་ཐོབ་པོ།",
    "གཞན་ཚེ་བཀའ་རྗེས་གནང་སོགས་དགོངས་བཞེད་ལྟར་ཕུལ།",
    "འདོལ་བྱུང་དུ་ཞག་ཤས་བསྡད།",
    "ཤས་བསྡད།",
    "དེ་ཀའི་བཀའ་བགྲོས་ཞུ་འོས་ཐམས་ཅད་ཐག་ཆོད་པར་ཞུས།",
    "ཕྱོགས་ཁོ་ན་ལ་གནང་ཟིན་ཅིང་།",
    "པར་ཅན་ཐམས་ཅད་མཇལ།",
    "སླར་ཡང་རྒྱལ་རྩེར་དགེ་ཚའི་སྒང་དེར་ཕྱི་མཚམ་མེ་བ་བྱས།",
    "དངོས་ལའང་ཞལ་ངོ་རྣམས་ཀྱིས་བཀའ་ཕེབས་ལྟར་རབ་གནས་རྒྱས་པ་རང་བགྱིས།",
    "ཞག་གསུམ་པའི་ནམ་ཕྱེད་ཙམ་ལ་སྤུར་འོད་བཞུ་བྱས་ཉི་ཤར་ལ་མཚན་བྱང་བཞུག་སྟེ།",
    "ཚེ་དཔག་མེད་ཀྱི་ལྷ་ཁང་གསར་བ་དེར་སྡོད་ས་བྱས།",
    "ངེད་ཀྱིས་གནས་དེ་ཉིད་དུ་ཞག་བཅུ་སྐོར་ཙམ་མཚམས་བྱས།",
    "སྡོད་ཡུལ་རྩེའི་གཞལ་ཡས་ཁང་དུ་བྱས་ཤིང་།",
    "ཁྲིད་དམིགས་སྐྱོར་དགོས་པ་སོགས་ནན་ཏན་ཡང་དག་བྱས།",
    "ལྕམ་སྲིང་གཉིས་སུ་སྒྲུབ་ཐབས་བརྒྱ་རྩའི་རྗེས་གནང་ལུང་དང་བཅས་པ།",
    "ཁོང་དཔོན་སློབ་ཚོས་ངེད་ལ་བརྟན་བཞུགས་ཀྱང་མཛད།",
    "ཞེས་པ་ལ་ངེས་པ་རྙེད་པར་བྱུང་།",
    "དེ་སྐབས་སྣ་དཀར་རྩེའི་བདེ་ཡངས་སུ་ཝ་བརྒྱལ་བ་སོགས་ལྟས་འཚུབ་པ་བྱུང་བས་ཇི་ལྟར་བྱ་གསུང་བའི་ལོན་གནང་བྱུང་བ་དེ་སྐུ་ལ་གནོད་པ་ཅང་མེད་ཡུལ་ཆགས་ཆེན་པོ་ཞིག་ཡོད་པ་འདྲ་ཞུས།",
    "སྐབས་སྔར་སྲོལ་དང་བསྟུན་གཉན་ཕུལ་བྱུང་བའི་ཊཱིཀྐ་ལ་གཞི་བྱས་ཏེ།",
    "ལྭ་བ་པའི་འགྲེལ་བ་ནས་ཅི་རིགས་པར་ཁ་བསྐངས་སྟེ།",
    "དེ་ནས་ལྷུན་རབ་ཏུ་ཞག་བདུན་ཙམ་བསྡད།",
    "དེ་ནུབ་རང་བྱོན་མགོན་པོ་ཉིད་ཀྱི་དྲུང་དུ་མཆོད་གཏོར་བསྐང་གསོ་གཟབ་མར་བྱས།",
    "མགོན་པོའི་སྐུ་དྲུང་དེ་ཉིན་དུ་ཉལ་ནས་བསྡད་པས།",
    "གང་ལྟར་དེ་སྐབས་སྡོད་ཡུལ་མགོན་པོ་མེ་ཐུབ་མ་བཞུགས་པའི་སྟེང་དེར་བྱུང་།",
    "ཁྱད་པར་བདེ་མཆོག་ལྷ་ལྔའི་སྨིན་བྱེད་ཀྱིས་སྒོ་ཕྱེ་སྟེ།",
    "ཧོར་ཟླ་བཅུ་གཉིས་པའི་ཚེས་བཅོ་ལྔ་ལ་དྲང་སྲོང་སྲིན་པ་རིར་སླེབས་ཙམ་བྱས།",
    "ཡར་ལམ་ཡེར་བར་ཞག་གསུམ་བསྡད།",
    "དཔོན་ས་ཡུམ་དྲུང་ནས་ངེད་ཀྱིས་རྟ་ལོ་ཡོང་བའི་དུས་ནས་བཟུང་ཡེར་པར་རབ་ལོ་གསུམ་ཙམ།",
    "དེ་མིན་ཡང་ལོ་མཚམས་ཙམ་ཞིག་བྱེད་དགོས་རྟག་ཏུ་ཕེབས་པ་ཞིག་ཡོད་ན་ཡང་།",
    "དེ་རྗེས་དམ་ཚིག་ལ་ཡེ་མི་རྩི་བ་ཞིག་ཡོང་བར་གནང་།",
    "དམ་ཚིག་གཙང་བ་རྣམས་བསྔོར་འཇུག་པ་ལན་མང་དུ་བསྟུད་ནས་བྱས་པས་སེལ་དག་ཅིང་མཁའ་འགྲོ་དགྱེས་པའི་ཕྱི་ནང་གསང་གསུམ་གྱི་རྟགས་རྣམས་ཚང་བར་བྱུང་ངོ།",
    "དེ་ནས་བྱེ་རི་སྟག་རྩེར་ཞག་སྦྲེལ་ཞིག་བསྡད།",
    "ལྷན་ཅིག་སྐྱེས་པར་དེ་བརྗོད་བྱ།",
    "དེ་ཡི་དོན་འདི་ཡིན་ཞེས་རྒྱས་པར་གསུང་བ་དང་།",
    "དུར་ཁྲོད་བདག་པོའི་རྗེས་གནང་།",
    "སྒྲོ་རོང་དུ་གནས་བཅུའི་གསེར་ཐང་གསར་བཞེངས་ལ་རབ་གནས་བསྡུས་པ་ཞིག་བྱས།",
    "རྣམ་རྒྱལ་རབ་བརྟན་དུ་སླེབས་པའི་གནངས་ཉིན་ཡང་དགོན་དུ་སྤྲུལ་པའི་སྐུ་ཡང་མཇལ།",
    "ཐོག་མ་དཀའ་འགྲེལ་ཙམ་བྱེད་པར་བསམས་ཏེ།",
    "ཞེས་ལན་གསུམ་གསུངས།",
    "དེར་མི་དམངས་རྣམས་ལ་མ་ཎིའི་ལུང་དང་སེམས་བསྐྱེད་ཅིག་བྱས་པ།",
    "བར་སྐོར་ལ་བརྟེན་པའི་གནས་མཇལ་ཡང་ཤིན་ཏུ་ཞིབ་པར་བྱས།",
    "རྒྱ་དཔེ་མེ་ཐུབ་མ་རྣམས་ཀྱི་རྟེན་མཇལ་བྱས་པས།",
    "སྒྲུབ་གནས་སེར་ལེ་རུ་ཞག་གསུམ་ཙམ་བསྡད།",
    "ཚིག་དོན་གཉིས་ཀ་མར་ལུགས་གཙང་སང་ངེ་བ་མི་སྣང་བས་བརྡའ་དོན་གཉིས་ཀ་མར་ལུགས་ཁོ་ན་ཡིན་པ་གསལ་ལ་ཆ་ཚང་བ་ཞིག་རྩོམས་ཤིག་ཅེས།",
    "བཀའ་གནང་ཕེབས་པ་ལ་བརྟེན་ཏེ།",
    "རིམ་ལྔ་སྨར་ཁྲིད་གདན་རྫོགས་ཀྱི་ཁྲིད་ཡིག་རྙིང་རྣམས་ལ་འཐོར་ཐབས་སུ་གནས་ཤིང་འགའ་ཞིག་གབ་པ་དང་མི་གསལ་བའི་ཚུལ་དུ་ཡོད་པ་དེ་གསལ་ཞིང་མ་འཁྲུགས་པར་བསྒྲིགས་པ་འདི་བརྩམས་པ།",
    "ཁོ་བོའི་འདི་ཙམ་ཡང་བསྟན་པ་ལ་ཅུང་ཟད་བྱ་བ་བྱས་པ་ཡིན་པར་སེམས།",
    "ངེད་ལ་ཡང་ཛམྦྷ་ལ་སེར་པོའི་རྗེས་གནང་ཞིག་དགོས་ཟེར་བ་བཞིན་བྱས།",
    "ཧོར་ཟླ་དགུ་པའི་ཉི་ཤུ་གསུམ་ལ་རྗེ་བཙུན་དཔལ་སྟག་ལུང་པ་ཆེན་པོ་བརྟན་བཞུགས་དང་བཀའ་དྲིན་རྗེས་སུ་དྲན་པའི་ཡོན་རྣམས་ཕུལ།",
    "ལོ་ཤས་དེ་ཀ་བྱེད་དགོས་གསུང་ཞལ་གྱིས་བཞེས།",
    "ནང་པར་ཉི་ཤུ་བཞི་ལ་དར་ལ་བརྒྱུད་ནས་ཀུ་རུར་སླེབས།",
    "ཁྱད་པར་ཉན་པོའི་གཙུག་ལག་ཁང་དུ་མ་ཎིའི་ལུང་བྱས་པ་དང་།",
    "མ་ཎི་སྐུལ་མཁན་བཞི་བྱེད་དགོས་པར་བྱུང་།",
    "ཁྱད་པར་རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མ་ལ་ཁ་ཡིག་འབྱར་བའི་སྙན་དར་ཤིན་ཏུ་མང་བ་ཕུལ།",
    "འདི་གཤིན་རྗེ་གཤེད་རྣམ་པར་རྒྱལ་བའི་སྐུ་འདྲ་ཡིན།",
    "དགོན་ལག་དང་བཅས་པར་མང་ཇ་འགྱེད་བཅས་ཀྱི་སྐུ་སྐལ་ཕུད་རྣམས་ཕུལ།",
    "ངོར་སྣར་ཐང་གངས་ཅན་བཀྲ་ཤིས་ལྷུན་པོ་ཞ་ལུ་གནས་དགོན་རྣམས་སུ་བྱང་ཆེན་དང་སྣར་ཐང་ན་ཡོད་པ་རྣམས་ཀྱི་སྟེང་ནས་ལྷག་མ་མ་ལུས་པར་བཏང་།",
    "དགེ་སྦྱོར་ཐམས་ཅད་ཀྱང་ཐུགས་ཡིད་དབྱེར་མེད་དུ་བསྲེ་བའི་ངང་ནས་བགྱིས་པའི་ཁུངས་བྱས།",
    "དེ་བར་ཞག་བཅུ་སྐོར་ཞིག་ཤིན་ཏུ་འགོལ་ཞིང་ཁ་འདོན་འཕེལ་བ་སྐྱིད་པར་བྱུང་།",
    "བཀའ་གདམས་ལྷ་བཞིའི་རྗེས་གནང་།",
    "ལྷོ་ནུབ་མགོན་པོའི་རྗེས་གནང་སོགས་ཕུལ།",
    "འདི་སྐབས་སྐྱིད་རུ་ནས་བགྲེས་པ་འབོད་མིར་གནང་བ་ལྟར།",
    "ཧོར་ཟླ་བཞི་པའི་ཚེས་བདུན་ལ་སྐྱིད་ཤོངས་སུ་སླེབས་ཙམ་བྱས།",
    "མགོན་པོ་བར་ཆད་ཀུན་སེལ་གྱི་རྗེས་གནང་།",
    "རས་ཆུང་ལུགས་ཀྱི་ཚེ་ཁྲིད་མགྱོགས་ཁྲིད་རྣམས་བྱས།",
    "སྡོད་ས་ཕུན་ཚོགས་བཀོད་ཀྱི་སྟེང་དེར་བྱས།",
    "པུ་ཊ་སོགས་རྗེས་གནང་ཟུར་བཀའ་མང་པོ་དང་།",
    "སྒྲུབ་ཐབས་རྒྱ་མཚོ་ལ་སྒྲུབ་ཐབས་ཉིས་བརྒྱ་བཞི་ཅུ་ཞེ་དྲུག་སྟེ་སོ་སོའི་རྗེས་གནང་དུ་རྒྱ་གཞུང་ཡོངས་རྫོགས་ཀྱི་ལུང་།",
    "ཕྲན་བུ་བསྒྱུར་བཀོད་དགོས་པ་རྣམས་ཀྱི་ཁ་ཏའང་ཞིབ་པར་བགྱིས།",
    "ལམ་འབྲས་གྲོལ་ནས་མི་རིང་བར་གཟུངས་བཞུགས་ཀྱི་གཟུངས་སྒྲིལ་བ་སོགས་ཀྱི་བཀོད་པ་བྱས་ཤིང་ཟླ་ཕྱེད་ཙམ་ལ་གྲུབ།",
    "ངེད་རང་ལའང་གཞན་གྱིས་བྱད་ལྟས་ཆེ་བ་ཞིག་བྱུང་བ་ནས་དེ་ལ་དམིགས་ཏེ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་དྲག་པོའི་སྦྱིན་སྲེག་ཅིག་བྱས།",
    "ཞག་པོ་བཅུ་བཞི་ལ་གཟུངས་བཞུགས་ཀྱང་ལེགས་པར་གྲུབ།",
    "བགེགས་སྐྲོད་དཀྱུས་མ་ཞིག་བྱས་པས་ཡེ་རང་འགྲོ་མ་ཉན་དེར་ཚིག་པ་ཟོས་མི་ཐམས་ཅད་ཕྱི་ལ་བཏོན།",
    "སླར་བསྲུང་བ་དང་རབ་གནས་བྱས།",
    "ཆོག་ཚེས་གཉིས་དང་སྟ་གོན་གྱི་ཆོ་ག་ཚེས་གསུམ་ལ་བྱས།",
    "བཞིའི་ནུབ་བདག་མདུན་ཙམ་གྱི་སྒྲུབ་མཆོད་བྱས་ཤིང་།",
    "དེ་མཚམས་དཀྱིལ་འཁོར་ཉེར་བསྡུའི་ཆོ་ག་ཡང་བྱས།",
    "ལྷ་ས་མཇལ་དུ་འགྲོ་རྒྱུའི་དྭགས་པོ་སྐོར་མི་ཤིན་ཏུ་མང་བ་རང་ཞིག་རྟེན་གསར་བཞེངས་རྣམས་ཀྱང་མཇལ་བར་བྱུང་ཞིང་།",
    "བདེ་ཡངས་སུ་ཁོང་རྣམས་ལ་མ་ཎིའི་ལུང་སོགས་བྱས།",
    "རྒྱལ་རྩེའི་འབོད་མི་སོགས་དང་སྟབས་བསྟུན་པའི་གཙང་ཕྱོགས་ལ་འཕྲལ་དུ་འགྲོ་བའི་རྩིས་བྱས་པ་ཡིན་ནའང་།",
    "ཚེས་བཅུ་བཞི་ལ་ཡོན་མཆོད་ལྷན་དུ་རྣམ་རྒྱལ་དུ་ཕེབས་ཞག་གསུམ་ཙམ་བསྡད་ཅིང་།",
    "འོབས་གསར་འདྲུ་གནང་བ་ལ་རབ་གནས་ཤིག་ཀྱང་བྱས།",
    "ཕྱག་ལེན་འབྲིང་པོའི་སྟེང་ནས་བྱས།",
    "ཚེ་ཆུ་འབུམ་པར་གནས་གསར་ནས་རྗེ་དྲུང་ཡང་ཕེབས།",
    "རྗེས་གནང་མང་པོ་དང་།",
    "རྗེ་ལྕགས་ནང་པ་དཔོན་སློབ་ཚོའང་ངེད་འཕྲད་པར་ཕེབས་པ།",
    "ཁོང་དང་ཐུགས་ཡིད་འདྲེ་ཞིང་སྐྱིད་པར་བྱུང་བས་ཞག་བཞི་བསྡད།",
    "ཧོར་ཟླ་བཅུ་གཉིས་པའི་ཚེས་གསུམ་ལ་མཁར་ཐོག་ཏུ་ཕེབས་སྒོ་ལྟར་ཕྱིན།",
    "དགོངས་བཞེད་ཀྱི་རྗེས་གནང་མང་དག་དང་།",
    "པོའི་སྨར་ཁྲིད་ཅིག་ཀྱང་བྱས།",
    "དེ་དག་གྲོལ་མཚམས་ནས་གཟིམས་ཁང་པོ་ཏ་ལ་ཟེར་བའི་ཚོམས་དེར་ཞལ་ངོ་རྣམས་གཙོ་བོར་ཕེབས་ཤིང་།",
    "ནེ་གུའི་ཁྲིད་སྒྲུབ་ཐབས་བརྒྱ་རྩའི་རྗེས་གནང་ཡོངས་རྫོགས།",
    "དེ་སྐབས་ལོ་གསར་གྱི་སྐབས་དང་འཛོམས་པས་གྲལ་དབུར་ཡང་ཤོག་ཕེབས་པ་ལྟར་ཕྱིན།",
    "སང་ཉིན་སྟག་ལུང་ཐང་དུ་སླེབས་པའི་གཟིམས་སྤྱིལ་དུ་བསྡད་ཅིང་།",
    "དེའི་གནངས་ཉིན་སྐྱབས་མཆོག་དམ་པ་རྗེ་བཙུན་དཔལ་སྟག་ལུང་པ་ཆེན་པོ་དོན་གྱི་སླད་དུ་མཚན་ནས་སྨོས་ཏེ་ཀུན་དགའ་བཀྲ་ཤིས་རྒྱལ་མཚན་དཔལ་བཟང་པོའི་ཞབས་དྲུང་དུ་མཇལ་བར་ཕྱིན།",
    "དངོས་ཀྱིས་ས་ཁྲི་དམར་པོའི་སྟེང་དུ་བསྡད།",
    "འདི་སྐབས་མཚམས་བཅད་མ་ཐུབ་ནའང་ཞག་ཤས་བསྙེན་པ་ཁ་གསོའི་ཚུལ་དུ་བྱས།",
    "སྣེ་གདོང་རྩེར་སྡོད་དུས་ངམ་རིང་ནས་འབོད་མིར་གསེར་ཁང་པ་ཚེ་རིང་འབྱོར་པ་འདི་སྐབས་ཀྱང་རྐང་བཙུགས་སུ་བསྡད་ཡོད་པས།",
    "དེ་ནས་དེ་ཉིན་དོག་སར་འཕོས་གླང་ཐང་དུ་ཞག་གསུམ་པ་ཞིག་བསྡད།",
    "ནང་པར་ར་ས་འཕྲུལ་སྣང་དུ་སླེབས།",
    "རིམ་པས་གཞིས་ཀ་གོང་དཀར་དུ་འབྱོར་བའི་འདི་སྐབས་ཞག་ཉི་ཤུ་རྩ་གསུམ་བསྡད་ཅིང་།",
    "ལྷག་མ་རྣམས་འབྲོག་སྟག་ལུང་དུ་བྱས་པ་ཡིན།",
    "འདི་སྐབས་ཟླ་བ་ཕྱེད་གཉིས་ཙམ་བསྡད་ཅིང་།",
    "སྔ་ཕྱིར་ཐུགས་སུ་བྱོན་པའི་བཀའ་ལུང་བག་ཕེབས་པར་གནང་།",
    "དེ་མཚམས་ཚོང་འདུས་སུ་ཕྱིན་པའི་ཞག་བདུན་བསྡད་ཅིང་།",
    "རྗེས་གནང་འགའ་ཞིག་རྣམས་བགྱིས།",
    "འདི་སྐབས་རྩེ་ཆེན་ནས་དཔོན་སའི་དྲུང་ཤིན་ཏུ་བསྙུང་བའི་འཕྲལ་སླེབས་དགོས་ཚུལ་ཕེབས་བྱུང་ནའང་།",
    "དེ་གཉིས་ཀྱི་ཆོ་ག་འཛུགས་པའི་བཀོད་པའང་དེ་དུས་བྱས་པས་མྱུར་སྟབས་ཚུགས།",
    "སྔོན་འགྲོའི་རིང་ལ་སྒྲུབ་ཐབས་བརྒྱ་རྩའི་རྗེས་གནང་བྱས།",
    "དེ་ལ་གུས་པས་བསྟོད་པ་ཞིག་ཀྱང་བྱས་པ་སད་ནས་མ་བརྗེད་པར་ཡི་གེར་བྲིས།",
    "ཁྲིད་གྲོལ་ནས་ཟླ་ཕྱེད་ཙམ་མཚམས་དམ་པར་བཅད།"
  ]
}