    "དེ་ནས་སྣར་ཐང་དུ་ཞག་གསུམ་ཙམ་བསྡད།",
    "དེ་ནས་བོ་དོང་དུ་བྱང་བའི་བདག་པོ་སྐུ་གཞོན་པའི་དྲུང་བཞུགས་སར་འབྱོར་ཞིང་གཞི་ལེན་དཔེ་བྲལ་མཛད།",
    "ཐུག་སྣ་ལྔ་ལ་སོགས་པ་རྩད་གཅོད་བྱས་པས།",
    "དེ་ནས་སྨོན་འགྲོར་ཕྱིན་དུས་ག་ད་ལ་ནས་ཞབས་དྲུང་བཀྲ་ཤིས་སྟོབས་རྒྱས་པ་དཔོན་གཡོག་རྣམས་ཀྱིས་བསུ་བ་གནང་ཞིང་།",
    "རྣལ་འབྱོར་མའི་བྲིས་སྐུ་རྣམས་མཐོང་པས་རྐྱེན་བྱས་ཏེ།",
    "ཨོཾ་གསུམ་མ་མ་བསླབས་པར་བློ་ལ་ཤར།",
    "དུས་འཇིགས་བྱེད་ཀྱི་ཞལ་འབག་སོགས་རྩད་གཅོད་བྱས་ཤིང་།",
    "ཉིན་བྱེད་ཤར་ན་ལྷག་པར་རྒྱས།",
    "ཀྱེ་རྡོར་གཉིས་ཀ་ལ་མེ་ཏོག་གཙོ་བོས་བཞེས་དེ་དང་མཐུན་པའི་མིང་བསྩལ།",
    "གསང་མཚན་ཡང་གྲོགས་ཀྱིས་འཛིན་པ་ལ་མ་བལྟས་པར་རང་བློས་མ་བརྗེད་པར་བཟུང་ཐུབ།",
    "སྒྲོལ་དཀར་གྱི་རྗེས་གནང་དང་།",
    "པུ་ཊའི་ཟུར་བཀའ་སོགས་རྗེས་གནང་འགའ་ཞིག་ཞུས།",
    "དེ་རྗེས་སུའང་སྐུ་མདུན་ཞིང་གཤག་པ་ལོ་ཤས་བཞུགས་ནའང་འཕྲལ་ཕུན་སུམ་ཚོགས་པ་ཡོང་བ་ཡོད་ནའང་དེའང་དེ་ལྟའོ།",
    "སྨོན་འགྲོ་བ་དང་ཡོན་མཆོད་གཅིག་བྱེད་པའི་ཁུངས་བྱས།",
    "ཁོང་དཔོན་སློབ་ཀྱིས་ཞབས་དྲུང་སྟོབས་ཀྱི་ཕྱོགས་ཞེན་བྱས།",
    "ཁྱད་པར་དུ་འཕགས་པའི་མངོན་རྟོགས་ཀྱི་ཚིགས་བཅད་དང་།",
    "སྨོན་འགྲོར་ཡང་ཕྱིན་ནས་ཟླ་གཅིག་ཙམ་བསྡད།",
    "ཀ་མད་སུམ་ཅུ་ལ་དེ་ཉིད་ཚར་གསུམ་བཞི་ཞིག་ངོས་སྦྱོར་བྱས།",
    "བརྩོན་འགྲུས་ཆེར་མ་བྱས་པས་ཀློག་བྱང་རབ་ཏུ་འགྲོ་བ་ལ་ལོ་ལྷག་ཙམ་ཐོགས།",
    "ཙེག་གེ་ལ་རྡོ་བརྡུང་བཏང་བས་ཆོག་བྱས།",
    "དེ་སྐབས་དཔོན་ས་དཔོན་སྒྲེལ་པོ་དང་རྣམ་རྒྱལ་ལགས་གཉིས་ཡོད།",
    "རྗེ་བཙུན་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཕེབས།",
    "ནེ་གུའི་ཁྲིད་གནང་སྐབས་ཉིན་མཚན་ཐམས་ཅད་ཡིད་དགའ་བས་ཁྱབ་པའི་གཉིད་ཀྱང་འདི་བྱུང་མི་ཤེས་པ་ཡུལ་ཡུལ་པ་ཟླ་བ་ལྷག་ཙམ་གྱི་བར་དུ་བྱུང་ཞིང་།",
    "ཁྲིད་གནང་བའི་ཚིག་དོན་གསལ་བར་གོ་ཅི་རིགས་བློ་ལ་ཡང་ཆགས།",
    "པས་གྲོགས་བྱས་ཏེ་ཞག་བདུན་བསྙེན་པ་བསྐྱལ།",
    "དེ་སྐབས་ཡར་འབྲོག་ནས་མྱུར་ཤད་ཡོང་དགོས་ཚུལ་ཕེབས་པ་བཞིན་ཤར་ཕྱོགས་ལ་བསྐྱོད་དེ།",
    "ཆོ་འཕྲུལ་གྱི་སྒང་ལ་ཚེ་དཔག་མེད་ཀྱི་བཟླས་མཚམས་ཞག་བདུན་མ་ཞིག་དང་སྒྲོལ་དཀར་གྱི་བཟླས་པ་མཚམས་ཞག་བདུན་མ་ཞིག་བྱས།",
    "དཔྱིད་ཕྱོགས་རྗེ་བཙུན་དཔལ་སྟག་ལུང་པ་ཆེན་པོ་ལྷ་སའི་ཞིག་གསོས་དང་གསེར་ཕིབས་འབུལ་བར་ཕེབས་སྐབས།",
    "སྔ་ཕྱིར་རྗེས་གནང་ཟུར་བཀའ་བཞི་བཅུ་ལྷག་ཙམ་དང་།",
    "དེ་ཀའི་ངང་ལ་གཉིད་སད་དེ་རྡོ་རྗེ་རྣལ་འབྱོར་མས་རྗེས་སུ་འཛིན་པར་འགྱུར་པའི་མཚན་མར་གོ།",
    "མཐར་ཁྲིགས་ཀྱང་ལེགས་པར་ཐོབ།",
    "རིམ་པས་རྒྱལ་རྩེར་ཕེབས།",
    "ལུ་གུ་རིར་ཞག་གསུམ་བསྡད།",
    "སང་སྔ་དྲོ་ཁོང་ཐམས་ཅད་ལ་མ་ཎིའི་ལུང་ཞིག་བྱས།",
    "ཞེས་ཕེབས་པ་ལྟར།",
    "ཟླ་འཕྲོ་དེ་ནི་ཅི་བདེར་བཞུགས།",
    "གཞུང་དཔེ་འཛིན་ཤིན་ཏུ་ཁ་དོག་པར་བྱུང་སྟེ།",
    "ཡང་ཡང་གསུངས་པ།",
    "མཚན་བརྗོད་པར་དཀའ་བ་འཇམ་དབྱངས་ཀུན་དགའ་རྒྱལ་མཚན་དཔལ་བཟང་པོའི་ཞབས་ཀྱི་སློབ་དཔོན་དང་།",
    "ལེགས་ཇ་གཟབ་མར་གནང་ཞིང་སྒྲ་མི་སྙན་གྱི་ཚེ་དཔག་མེད་ཀྱི་སྒོམ་ལུང་ཞུས།",
    "སྐབས་འདིར་རྒྱ་གར་གསང་སྤྱོད་ཡོངས་སུ་རྫོགས་པར་ཐོབ།",
    "དེ་མཚམས་འཚེད་ནས་སྤྱན་འདྲེན་གནང་བ་ལྟར་དགོངས་བཞེད་བཞིན་འཚེད་དུ་ཕེབས།",
    "ཀཱ་རི་ཀཱ་ལྔ་བཅུ་པ་དང་བཤེས་སྤྲིངས་སོགས་བློ་འཛིན་བྱས་ཤིང་།",
    "དེ་འཕྲལ་རང་ནས་རྟགས་རིམ་པར་བསྟན་པ་ཡིན།",
    "ཁྱད་པར་དེ་སྐབས་སུ་དམིགས་ལྟས་རྩུབ་ཅིང་མི་བསྲུན་པ་བརྒྱུད་མར་བྱུང་།",
    "ཞག་གསུམ་ཙམ་སྐྱེད་ཚུལ་དུ་བསྡད།",
    "ཕ་ཇོ་ཡང་འབྲང་ནས་ཕེབས་བྱུང་།",
    "དེ་ནས་ཟླ་བ་གཅིག་མཚམས་དམ་པར་བཅད་དེ་གཉན་སྒྲོལ་ཡན་ལག་དྲུག་པའི་མངོན་རྟོགས་ཀྱི་སྟེང་ནས་སྒྲོལ་མའི་བསྙེན་པ་བསྐྱལ།",
    "སྣང་བ་དེ་ལ་ཡུན་རིང་དུ་ལྟ་རྟོག་བྱས།",
    "དཔེ་མཚམས་ཀྱི་ཚུལ་དུ་ཟླ་གཅིག་བསྡད།",
    "དངོས་ཀྱིས་རྩེ་རྒྱལ་དུ་ཟླ་གཅིག་ཞག་ཉི་ཤུ་ཙམ་བསྡད།",
    "རྗེས་གནང་ཟུར་བཀའ་ཤིན་ཏུ་རྣམ་གྲངས་མང་བ།",
    "ཟླ་བ་གཉིས་ཙམ་ཞབས་འབྲིང་དུ་བསྡད།",
    "བུ་ལུགས་ལ་མགྱོགས་ཁྲིད་དུ་གནང་བ་ཞག་པོ་བཅུ་སྐོར་ལ་ཚར།",
    "ངེས་དོན་རྒྱ་མཚོ་སོགས་ཀུན་མཁྱེན་ཆེན་པོའི་གསུང་མང་པོའི་ལུང་།",
    "ཚེ་འདིར་ཉམས་ཁྲིད་ཐོབ་པའི་ཐོག་མ་སྦྱོར་དྲུག་ལགས་ཤིང་།",
    "དེ་དག་ངེས་པར་འཆི་མེད་གནས་སུ་འཇུག།",
    "སྔར་གྱི་ཚོ་ལ་བརྗེད་གསོས་ཀྱིས་གསུངས།",
    "ལན་གཅིག་པོ་དེ་ཁ་ལ་རབ་གནས་ཀྱི་ཕྱག་ལེན་ངེས་པར་བྱུང་།",
    "སྔ་སོར་སྤྱན་འདྲེན་བཏང་བ་ལྟར་དེའི་སང་ཉིན་བྲག་སྟོད་ནས་རྗེ་བཙུན་རྡོ་རྗེ་འཆང་ཆེན་པོའི་ཞལ་སྔ་ནས་ཀྱང་ཕེབས།",
    "ཁྱད་པར་ཇ་བསྐོལ་རྒྱུ་འབད་མེད་དུ་བྱུང་།",
    "དེ་ནས་ཚེས་བཅུ་ལ་འབྲོང་རྩེར་སླེབས་ཙམ་བྱས།",
    "ཆེན་པོ་བསམ་སྡིངས་སུ་ཕྱག་ཕེབས།",
    "བསྲེ་འཕོའི་ཁྲིད་ཚུལ་ཟབ་རྒྱས་སུ་གནང་།",
    "སྐབས་སྐུ་གཤེགས་པས་ཕྱིས་འགྱོད་པར་བྱུང་།",
    "སེར་ཁ་དེ་རྗེ་བཙུན་རྡོ་རྗེ་འཆང་ཆེན་པོ་སླར་ཡང་བསམ་སྡིངས་སུ་ཕེབས་ཤིང་།",
    "རྗེ་ཀླུ་སྒྲུབ་པས་འབོད་མི་གནང་པ་ལྟར་བྱ་རྒོད་གཤོངས་སུ་ཁོར་ཙམ་ཕྱིན་རིམ་པས་ཇོ་ནང་དུ་སླེབས་རྗེ་དྲུང་དང་མཇལ་ཙམ་བྱས་ཤིང་།",
