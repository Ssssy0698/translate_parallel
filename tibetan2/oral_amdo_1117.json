    "ཕོ་སྦལ་མོ་སྦལ་གཉིས་ནི་བཤོས་པ་ཡིས",
    "རྩིས་ཀྱི་སྒོ་མོ་བརྒྱད་ཁྲི་བཞི་སྟོང་གསུངས",
    "གཙུག་ལག་སྒོ་མོ་བརྒྱད་ཁྲི་བཞི་སྟོང་རྣམས་ཟངས་ཆེན་གའུ་ཁ་སྦྱར་ནང་དུ་བཅུགརི་བོ་རྩེ་ལྔའི་བྱང་ཤར་གཏེར་དུ་སྦས",
    "ཁྱོད་ཀྱིས་ཚངས་པར་སྤྲུལ་ལ་གཏེར་འདི་ཐོན",
    "དུས་དེར་ལྷ་མོ་རྣམ་རྒྱལ་མ་ཡང་བྱུང་",
    "བག་མ་གི་གོང་རྒྱ་མོ་དར་ཚགས་དང་",
    "བཅུ་གསུམ་༧༦ན་པ་དང་བལ་མོ་ལྡེམ་སྐོར་དང་",
    "བསམ་ལས་བྱུང་ཚོད་རྒྱ་རྒྱུད་རིང་ཐུང་བརྩེགས་གསེར་གྱི་མེ་ཏོག་དཔལ་འབར་མིའི་འཁྲུངས་དཔེ",
    "ནང་གི་སྤར་ཁ་སྨེ་བའི་རྒྱུད་ལ་ནི",
    "སྤར་ཁ་ས་རིས་ཆེན་མོའི་རྒྱུད་རྣམས་སོ",
    "མོ་དྲུག་སར་འགྲོ་དབུས་ནས་ལྷོ་ནུབ་ལུག",
    "རང་ཐོབ་ཕོ་དྲུག་གཡས་ལ་མོ་དྲུག་གཡོན",
    "སྲིད་པའི་ལྷོ་རྒྱུད་ཆེ་འབྲིང་ཆུང་གསུམ་མོ",
    "ཁྲོམ་རྩིས་ཆེན་མོ་ལེའུ་བརྒྱད་ཅུ་པ",
    "སྤྱན་རས་གཟིགས་ཀྱིས་ལུང་བསྟན་ནས་རྒྱ་ནག་ཡུལ་དུ་བཞུགས་པའི་ལེའུ་སྟེ་སོ་ལྔ་པའོ",
    "ཁྱོད་དང་ང་ནི་ལས་ཀ་མཐུན་ནོ་ཟེར",
