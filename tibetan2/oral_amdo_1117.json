    "མི་འཆད་གྱུར་ན་ཁྱོད་ཉིད་གསོད་དོ་ཟེར་བཙུན་མོ་བྱེད་ཅིང་སྔངས་ནས་མ་བཟོད་དེ",
    "བཙུན་མོས་ལྷ་ལྕམ་ཁྲིད་ནས་ཡོངས་པ་ཡིས",
    "ང་ལ་ཨ་མས་མཱ་ས་ཉོར་སོང་ཟེར",
    "མ་༨༢མོ་མཁའ་འགྲོ་རྣམས་ལ་གཉེར་བྱང་གཏད",
    "སེམས་ཤོང་མ་ཁྱོད་འདི་ཁྱེར་ཕར་ལོག་གསུངས",
    "བདག་གིས་ཁྱེད་བཞག་ལོག་པ་ག་ནས་ཕོད",
    "ནི་གུ་ས་ལས་བཞེངས་ཏེ་ཐལ་མོ་སྦྱར",
    "རང་གི་སྐྲ་ལོ་གཡས་འབྱེད་གཡོན་འབྱིད་བྱས",
    "མི་ཡི་རྒྱལ་མོ་ཡུལ་སྲིད་འཛིན་པ་ཐོས",
    "སེམས་ཤོང་རབ་ཏུ་ངུ་ཞིང་ཁྱིམ་དུ་སོང་",
    "ཁོལ་པོ་ཁོལ་མོ་སུ་འཁོར་མ་ལྟར་བྱམས",
    "རྒྱལ་པོ་བཙུན་མོ་ལྷ་ལྕམ་འཚོལ་ཞིང་འདྲི",
    "བུ་མོ་ཀུན་གྱི་ཁྱུ་མཆོག་ལྷ་མོ་དེ",
    "ཕོ་ཚོས་ཚལ་དུ་རང་གི་ལུས་སྨྲ་ཕབ",
    "བུ་མོ་འདོད་ལ་ཁ་ཟས་ནོར་ཚིམ་བྱིན",
    "མཐིང་ཁར་འདུག་པ་སྤང་གི་ངོས་ལོགས་ལ",
    "མནྡཱ་ར་བ་དཔོན་གཡོག་གདུལ་བྱར་གཟིགས",
    "སྤྲེའུ་ལོ་ཕག་གི་ཟླ་བའི་ཚེས་བཅུའི་ཉིན",
    "སྐྱེད་མོས་ཚལ་གྱི་བར་སྣང་སྐྱིལ་ཀྲུང་བཅས",
    "ཁོལ་མོ་ལ་ལ་གདན་ཁྲི་བཤོམ་དུ་བཅུག",
    "ཁོལ་མོ་ལ་ལ་བྱ་ར་བ་ལ་བསྐོས",
    "ཁོལ་མོ་ལ་ལ་སྲང་ཀ་མྱུལ་དུ་བཅུག",
    "རི་བོ་ཏ་ལར་མགོན་པོ་སྤྱན་རས་གཟིགས",
    "བ་ལང་ཚོལ་ཕྱིན་མ་རྙེད་ལོག་པ་དང་",
    "ཕོ་མོ་༨༥བ་ཐམས་ཅད་ཡིད་སྨོན་བྱེད་པ་ལ་རྫི་བོས་ཁྱིམ་པོ་ཆེ་ཡི་གོ་རུ་གླེངས",
    "གཅིག་གླེངས་གཉིས་གླེངས་ཡུལ་གྱི་གཙོ་བོས་གླེངས་ཕྱི་བློན་ནང་བློན་བཙུན་མོས་རིམ་པར་གླེངས",
    "བཙུན་མོ་གཞོན་པས་རྒྱལ་པོའི་སྙན་དུ་སྨྲས",
    "རྒྱལ་པོས་འདི་ནི་ཅི་ཟེར་སྨྱོའམ་གསུང་",
    "བུད་མེད་ཁ་ནི་མི་དགེའི་བང་མཛོད་ཡིན",
    "ཤབ་ཤུབ་མང་པོ་བུད་མེད་འདྲེ་དང་མཚུངས",
    "བཙུན་མོས་ནང་བློན་རྒྱལ་པོའི་དྲུང་དུ་ཁྲིད",
    "མོ་ཡིས་མཐོང་ན་བཙུན་མོའི་དྲག་ཤོས་འཆོལ",
    "གཏམ་འདི་ཁམ་ཆེས་བུ་མོ་འདོད་མཁན་མང་",
    "ཏ་ཟིག་རྒྱལ་པོའི་རོལ་མཁན་གྲ་ཞིག་བྱུང་",
    "དེ་ནས་གཙོ་བོ་ཞིག་གི་ཆུང་མ་ཡིས་བ་ལང་རྫི་བོ་དེ་ཡི་མགོ་བསྐོར་ནས",
    "ཁྱོད་ཀྱི་བ་ལང་འཚོ་བའི་ཚབ་མ་གཏོང་",
    "ཚོགས་པའི་གསེབ་ཏུ་ཁྱོད་ཀྱི་མཐོང་ཟེར་དགོས་གཙོ་བོ་ཆུང་མ་ཐམས་ཅད་ལྷན་ཅིག་འདུས",
    "རྒྱལ་པོས་བློན་པོ་སོང་ལ་ལྟོས་ཤོག་གསུངས",
    "བཙུན་མོ་ངས་ལྟའི་ཟེར་ནས་སྔོན་ལ་སོང་",
    "གཡོག་མོས་སྒོ་བསྡམས་ནང་དུ་མ་བཏང་ནས་བཙུན་མོ་བདེན་ངེས་བསམས་ནས་བརྒྱལ་བར་གྱུར་བློན་པོས་རྒྱལ་པོའི་སྙན་དུ་དེ་སྐད་སྨྲས",
    "རྒྱལ་པོའི་ཞལ་ནས་བཙུན་མོར་ཆུ་རྒྱོབ་ལས",
    "ལྷ་ལྕམ་དཔོན་གཡོག་ཐལ་སྦྱར་མཆི་མ་ཕྱུང་",
    "མཐའ་མིས་ང་ཡི་བུ་མོའི་སྨྲ་འབེབས་པ",
    "ཁོལ་མོ་ལྔ་བརྒྱ་ཐེམ་པའི་ཕྱིར་མ་བཏང་",
    "དགེ་སྦྱོང་ཁྱོད་ཀྱིས་ལྷ་ལྕམ་ལུས་བསླད་པས",
    "དེ་སྐད་སྨྲས་པས་ལྷ་ལྕམ་ཞལ་ན་རེ",
    "ཤིང་གི་ནང་ནས་རབ་ཏུ་ཚ་བའི་ཤིང་",
    "ཙནྡན་ཁུར་རེ་ཏིལ་མར་བྲེ་རེ་བསྡུས",
    "གཡབ་མོ་བརྡུལ་བས་ལུང་པར་དུད་སྤྲིན་འཚུབས",
    "ད་རེས་ཞག་བདུན་དུད་པ་མ་ཆད་སྙམ",
    "མ་རིག་རྩ་བ་ཉོན་མོངས་དུག་ལྔ་ལ",
    "བྱ་བའི་འཕྲོ་བསྐྱུར་ཕོ་མོ་ཐམས་ཅད་རྒྱུག",
    "བདེ་བ་པདྨའི་འབྱུང་གནས་ཁྱོད་ལ་བསྟོད",
    "བདག་གི་བློ་ངན་སྐུ་ལ་བརྙས་བགྱིས་པ",
    "ཁྱོད་ཀྱི་རྗེས་སུ་འཇུག་པའི་རྒྱལ་པོར་གྱུར",
    "ཐམས་ཅད་ལྷུན་གྲུབ་བུདྡྷ་ཐོད་འཕྲེང་རྩལ",
    "རྩེ་མོར་རྒོད་ཀྱི་རྩེ་རྒྱས་མཛེས་པ་དང་",
    "བློན་པོས་མྱུར་ཕྱིན་དོང་གིས་ཁ་བཤུས་ནས",
    "བུ་མོ་བདེན་གྱིས་ཨ་མ་སོང་ཤོག་གསུངས",
    "བཙུན་མོས་གོས་ཁྱེར་ལྷ་ལྕམ་མདུན་དུ་ཕྱིན",
    "དེ་སྐད་སྨྲས་པས་ལྷ་ལྕམ་ཞལ་ན་རེ",
    "ཨ་མ་བུ་མོ་ཡབ་ཀྱི་བཀའ་མི་གཅོག་མི་ལོ་ཉི་ཤུ་རྩ་ལྔ་མ་སོང་བར"
  ]
