    "བདེ་བའི་སྒྲ་ནི་མཛེས་པ་ལ་སོགས་པ་དོན་གསུམ་ལ་འཇུག་པས་ཁྱད་པར་འཕགས་པའི་བདེ་བར་གཤེགས་པ་ཉིད་གསུངས་སོ།",
    "འདི་ཉིད་ཀྱིས་ནི་མུ་སྟེགས་ཅན་གྱི་སྟོན་པ་རྣམས་ལས་ཁྱད་པར་དུ་འཕགས་པའང་བསྟན་པ་ཡིན་ནོ།",
    "སླར་མི་ལྡོག་པར་གཤེགས་པ་ནི་ཡང་སྐྱེ་བ་དང་འདོད་ཆགས་ལ་སོགས་པའི་ཉེས་པ་རྣམས་ཀྱི་རྒྱུ་ངར་འཛིན་པའི་ས་བོན་མ་རིག་པ་རྣམ་པ་ཐམས་ཅད་དུ་སྤངས་པས་བདེ་བར་གཤེགས་པའོ།",
    "དེ་རྣམས་ནི་བསྔགས་པར་གཤེགས་ཀྱང་རྒྱུ་རྣམ་པ་ཐམས་ཅད་དུ་མ་སྤངས་པའི་ཕྱིར་སླར་ལྡོག་པ་སྲིད་པའི་ཕྱིར་རོ།",
    "མ་ལུས་པར་ཡང་ཇི་སྲིད་དུ་བགྲོད་པར་བྱ་བར་གཤེགས་པ་སྟེ།",
    "བདེན་ཏེ་འདིར་ཚིགས་སུ་བཅད་པ་སྦྱར་བའི་ངོར་བྱས་པའི་ཕྱིར་གོ་རིམས་འཆོལ་བར་བསྟན་པར་རིག་པར་བྱའོ།",
    "ཕྱག་འོས་ཀུན་ལའང་ཞེས་གསུངས་ཏེ།",
    "ཕྱེད་ཕྱི་མས་བརྗོད་པར་བྱ་བ་ལ་སོགས་པ་བསྟན་པའི་ཕྱིར།",
    "བདེ་གཤེགས་སྲས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱི་སྡོམ་ལ་འཇུག་པ་ནི་བསྡམ་པར་བྱ་བའམ།",
    "འདིས་སྡོམ་པར་བྱེད་པས་ན་སྡོམ་པ་སྟེ།",
    "དེ་ཡང་སྐབས་ཇི་ལྟ་བ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་འཇུག་པར་བྱ་བའམ།",
    "འདིས་དེ་ལ་འཇུག་པར་བྱེད་པའི་ཕྱིར་འཇུག་པ་ནི་ལམ་སྟེ།",
    "དེ་ལྟར་ན་འདིས་སྟོན་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་སྡོམ་ལ་འཇུག་པ་ནི་འདིའི་བརྗོད་པར་བྱ་བ་ཡིན་ལ།",
    "འདིས་ནི་སྡོམ་ལ་འཇུག་པའི་རྗོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་རྗོད་པར་བྱེད་པ་དང་བརྗོད་པར་བྱ་བའི་མཚན་ཉིད་ཀྱི་འབྲེལ་པ་ཡང་དོན་གྱིས་བསྟན་པ་ཡིན་ལ།",
    "བསྟན་པ་ནི་རྗོད་པར་བྱེད་པའི་དགོས་པ་སྟེ།",
    "དེ་ཡང་གང་ཞིག་ཕན་ཡོན་བསྟན་པས་ཟུར་གྱིས་སྟོན་པར་འགྱུར་ཏེ།",
    "མི་གཙང་ལུས་འདི་བླངས་ནས་རྒྱལ་བའི་སྐུ།",
    "རིན་ཆེན་རིན་ཐང་མེད་པར་བསྒྱུར་བས་ན།",
    "བརྗོད་པར་བྱ་བ་དང་།",
    "གཞན་དུ་ན་བརྗོད་པར་བྱ་བ་ལ་སོགས་པ་མེད་པར་དོགས་པས་འདིར་རྟོག་པ་དང་ལྡན་པ་རྣམས་འཇུག་པར་མི་འགྱུར་རོ།",
    "ལུང་བཞིན་ཞེས་གསུངས་ཏེ།",
    "གལ་ཏེ་ལུང་བཞིན་དུ་བསྟན་པར་བྱ་བ་མ་ཡིན་ནམ།",
    "དེ་ལྟ་ན་ལུང་ཉིད་ལ་དེ་འདོད་པ་རྣམས་འཇུག་པར་འགྱུར་ན།",
    "དེའི་ཕྱིར་འཇུག་པའི་ཡན་ལག་ཡིན་པས་ན་བརྗོད་པར་བྱ་བ་ལ་སོགས་པ་བསྟན་པ་ནི་མི་རིགས་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་ལེགས་པ་ཐོབ་པ་ལ་སོགས་པའི་དོན་དུ་རྗོད་པར་བྱེད་པ་ཡིན་ན་ཇི་ལྟར་ན་དོན་མེད་པ་ཉིད་ཡིན།",
    "སྐྱེ་བོ་དམ་པ་མཐའ་དག་སོན་པའི་ལམ་དུ་བདག་ཉིད་རྗེས་སུ་འགྲོ་བར་ཡང་བསྟན་པར་འགྱུར་བ་དང་།",
    "འདོད་པའི་ལྷ་ལ་སོགས་པ་ལ་ཕྱག་བྱས་པ་ཐོས་པ་ལས་ཡོད་པ་ཉིད་སྲིད་པ་ཡིན་ནོ།",
    "འདིར་ཡང་བདེ་བར་གཤེགས་པའི་སྒྲས་བརྗོད་པའི་བཅོམ་ལྡན་འདས་ཀྱི་ཆེ་བའི་བདག་ཉིད་ཐོས་པ་ལས་དེ་འདོད་པས་དེ་བསྐྱེད་པ་ལ་གཞོལ་བའི་ཡིད་ཀྱི་བདེ་བར་གཤེགས་པའི་སྲས་ཀྱི་སྡོམ་པ་ལ་འཇུག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་འབད་པ་དང་ལྡན་པ་དག་འདིར་འཇུག་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་འདི་ཡང་སྡོམ་པ་ལ་འཇུག་པ་སྟོན་པར་མཛད་པ་དགོངས་པ་ཡིན་ན།",
    "གང་ཞིག་དེ་མ་ཐག་ཏུ་མཁོ་བ་དེ་ནི་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་འདིར་ལུང་ལས་ལྷག་པ་ཅུང་ཟད་ཀྱང་བརྗོད་པར་བྱ་བ་ཡིན་ནོ་ཞེས་དོགས་ནས།",
    "སྔོན་ཆད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཡང་ཁྱད་པར་དུ་འཇུག་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ཕྱིར་གསུངས་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ཡང་བདག་ལ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འོ་ན་ཅིའི་ཕྱིར་འདི་བྱེད་པའི་དོན་དུ་འབད་པར་བྱེད་ཅེ་ན།",
    "དངོས་པོ་ལ་འདུས་བྱས་པའི་ཁྱད་པར་ཡང་བདག་ཉིད་ལ་སྔར་ཉིད་ནས་ཡོད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "བསྒོམ་ཕྱིར་ནི་བསྐྲུན་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གཞན་གྱི་དོན་ཅུང་ཟད་བྱེད་པ་ཡང་སྲིད་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་བདག་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དལ་འབྱོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིན་ཏུ་དཀའ་བས་རྙེད་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་སྒྲུབ་པ་ནི་རྫོགས་པར་བྱེད་པ་སྟེ།"
  ]
}