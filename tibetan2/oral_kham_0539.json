    "ད་ལྟ་ཡང་བསམ་ཡས་ན་རྒྱ་གར་གྱི་པཎྜི་ཏ་ནགས་ཀྱི་རིན་ཆེན་ཟེར་བའི་མཁས་པ་ལས་ཀྱང་གྲུབ་པ་གཙོ་ཆེ་བ་ཞིག་བཞུགས་ཡོད་པར་འདུག་ཅིང་།",
    "དེར་ལོ་ཙཱ་བ་མངའ་རིས་པ་ཡིན་ཟེར་བའི་མཉྫུ་བ་ཟེར་བ་ཞིག་འདུག་པ་ལ་ཞུ་བ་བསྐུར་བས།",
    "བརྒྱུད་པ་གསུངས་པའི་ཀླུ་སྒྲུབ་ཡན་ཡོངས་གྲགས་འདི་ཀར་འདུག་དེར་སཾ་སྐྲྀ་ཏའི་སྐད་དུ་ལུང་སྩལ།",
    "དགུན་གྲང་བའི་སྒང་རང་ཡིན་ནའང་བློས་ལོངས་པ་བྱས།",
    "ཁྱེད་རང་མཁན་ཆེན་གཡག་པ་དངོས་སུ་གདའ་བས་ཕྱག་དཔེ་གང་དགོས་སྣོམས་མཛོད།",
    "ཕྱག་དཔེ་པོ་ཏི་གཅིག་ལ་ཕྱག་མཛུབ་གཏད་ནས་དེ་ལོང་གསུང་བའི་དབུ་རང་ནས་སྔར་གྱི་རྟགས་རིགས་ཀྱི་ཕྱེད་ཁ་དེ་འདུག་པས།",
    "རྡོ་ཟ་བའི་མན་ངག་ཞུ་ཡིན་འདུག་པ་ཡང་ལྷན་དུ་ཞུས།",
    "ཕྱིས་སྔགས་ལ་འགྱུར་ཕྱིན་ས་སྐྱ་པའི་ལུགས་གཙོ་ཆེ་བར་དར་འདུག་པ་ལ།",
    "ས་སྐྱའི་ཤཱཀ་བཟང་བླ་བྲང་ནས་བཟད་པ་ཀུན་དགའ་བཟང་པོ་བ་བཞུགས་འདུག་པའི་རྩར་ཇ་མགྲོན་ལ་ཕྱིན།",
    "རྗེ་མུས་པ་ཐུགས་ནང་རང་ལ་གཞོལ་བས་འཆད་ཉན་སོགས་འཁོབས་ཆུང་ཞིང་།",
    "ཁོང་དེ་ཡབ་སྲས་གཉིས་ཀའི་ཞལ་སློབ་དུ་འདུག་པ་དང་།",
    "ཁྱད་པར་དུས་ཀྱི་འཁོར་ལོ་ལ་དུས་དིང་སང་འགྲན་ཟླ་ཀུན་བྲལ་དུ་འདུག་པས་དེ་ཀུན་ཀྱང་སྤྱན་དྲངས་ན་འོས་ཞུས་པས།",
    "ངེད་ན་ནིང་ཁྱེད་དང་མཇལ་བ་དེ་ཕྱིན་ནི་ཁྱེད་རང་སེམས་པ་ཞིག་བྱུང་གསུང་ཞིང་།",
    "དཀའ་ཚེགས་ཆེ་བ་རང་འདུག་པས།",
    "ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "ང་རང་མིང་འཇིག་རྟེན་འགྲོ་བའི་མཆོག་ཟེར།",
    "གསང་ཕུ་ན་སྒྲ་ཤེས་པའི་སློབ་དཔོན་ཞིག་འདུག་གསུང་བ་སོགས་བྲིས་པ་ནི་ཐུགས་མཉམ་པར་མ་གཞག་པ་ཡིན་ཏེ།",
    "དེ་མཚམས་ཁོང་རྣམ་པ་ལ་སྤྲོས་མེད་ཀྱི་ཁྲིད་གནང་རྒྱུར་འདུག་ཀྱང་།",
    "མེ་ཏོག་ཧ་ལའི་སྡོང་པོ་སྐམ་པོ་དབྱར་དུས་ཕུལ་བ་ཞིག་འདུག་པ་ལ་ཡང་མེ་ཏོག་གསར་དུ་ཁ་བྱེ་བ་སོགས་ངོ་མཚར་དཔག་ཏུ་མེད་པའི་ཆོ་འཕྲུལ་བྱུང་བ་ནི།",
    "གཞི་བསྙེན་མཛད་གསུང་བ་ཅིག་བཞུགས་འདུག་ཀྱང་མ་དག་པ་ཡིན་ཏེ།",
    "ད་དེ་རང་བྱེད་པའི་དུས་ལ་བབ་འདུག་པས་དེ་ལྟར་བགྱིའོ་གསུང་།",
    "ཤེས་རབ་སེང་གེར་མིང་བཏགས་པ་དོན་མཐུན་དུ་འདུག་གོ།",
    "དེར་ད་གཙང་རང་དུ་བཞུགས་ལ་ས་སྐྱ་པའི་བསྟན་པའི་རྒྱུན་ལ་ཕན་པའི་འཆད་ཉན་རང་གནང་དགོས།",
    "འདུག་འདུག་ངོ་མཚར་ཆེའོ་ཟེར་བ་ཡང་བྱུང་ཞེས་གཏམ་ཡོད་དོ།",
    "སྔར་མངའ་རིས་སུ་དགུང་ལོ་ཞེ་གཅིག་དུས།",
    "ཞེས་ཨ་ཐུང་ཡིན་པ་ལ་འབྲུ་གསུམ་གྱི་ཟླས་ཕྱེ་བའི་ཨཱ་ཡིག་ཏུ་བྲིས་པ་སོགས་དཔྱད་རྒྱུ་ཅུང་ཟད་ཅིག་འདུག་ཀྱང་།",
    "ཡི་གེའི་སྤོར་རྩོམ་གྱིས་དུས་འདའ་བར་འདུག་སྟེ།",
    "ས་སྐྱ་པ་གོང་མ་ལྔའི་བཀའ་འབུམ་བློར་ཆུད་ཟེར་བར་འདུག་དེང་སང་ས་སྐྱའི་བཀའ་འབུམ་བློ་ལ་ཡོད་པ་ཁོང་ཙམ་ཀ་ཡིན།",
    "བྱ་བ་སྔོན་གྱི་ལས་ཀྱི་རང་ཡིན་པར་འདུག་གོ།",
    "ད་འདྲི་བའི་གནས་ཤིན་ཏུ་བརླིང་བ་གནང་འདུག་པས་ལེན་འདེབས་དཀའ་བ་ཡོད་པར་སྣང་གསུང་བའི་ཚུལ།",
    "ངེད་ད་དུང་ཞག་འགའ་མཚམས་མི་གྲོལ་བ་འདུག་པས།",
    "ད་ལྟ་རང་ཕེབས་དགོས་པ་འདུག་ཞུ་ཡིན་འདུག་པས།",
    "བསྙུང་བའི་ཚུལ་ཙམ་མེད་པའི་ཞིང་བརྗེས་པ་འདི་ཡ་རང་ཆ་འདུག་གོ་གསུང་ནས་ཕེབས་ཤིང་།",
    "ད་གཟིམས་མལ་སྐུ་འདྲའི་ན་བཟའ་དེ་སྐྱེལ་མི་མི་འབྱོར་སྣང་བས་སྐུ་ཚབ་ཅིག་འདིར་བཞེངས་དགོས་པ་འདུག་གསུང་ནས།",
    "སྐུ་རྒྱབ་ཕྱོགས་ཀྱི་ས་བང་དེའི་ནང་ན་ཅི་འདུག་ལྟོས་ཤོག་གསུང་ནས།",
    "འདི་ན་ནི་ཡ་ཆ་འདུག་གོ་ཟེར་ཐུགས་མཐོང་སྐྱེས་པའི་གསུང་སྒྲིབ་མེད་དུ་བྱོན་ཞེས།",
    "མདུན་གྲོང་ནང་སོ་སོགས་འགའ་ལ་ནེ་གུ་གཅིག་གནང་བའི་དབུ་གཙུག་ཙམ་འདུག་པ།",
    "ད་གྲྭ་སྐོར་དུས་ཐུག་འདུག་པས་གཟུང་ཀྱང་མི་ཟིན།",
    "བོ་དོང་པ་ཡིན་པའི་མཁས་མཆོག་ཡོན་ཏན་རྒྱ་མཚོ་ཟེར་བ་དེ་ཀུན་གྱིས་ཕྱག་གཡོག་བྱས་འདུག་ཅིང་།",
    "ང་རང་ལུས་རྩ་ཡི་འཁོར་ལོ།",
    "སྤྲིན་ཡེ་མི་སྣང་ཆར་འབབ་པའི་གཤིས་སུ་མི་འདུག་ཞུས་པས།",
    "ཁོས་ལགས་ལགས་དང་ཁྱེད་རང་རྣམ་པ་དང་མཇལ་མྱོང་འདུག་གོ་ཟེར་བས་ཞེད་དེ་སང་སྔ་བར་ལངས་ཕྱིན་པས།",
    "ད་ལྟ་བརྟགས་དུས་ཤཱཀྱ་ཐུབ་པའི་ལྟོ་སྣོད་ཕྱག་ཏུ་ཡོད་པ་དེ་ཆད་འདུག་པས།",
    "རང་རང་སྐལ་བའི་པད་ཚལ་འབྱེད་པར་མཛད།",
    "གསེར་གྱི་མཎྜལ་དགོས་ཟེར་བ་ནི་འདུག་གསུངས་པས།",
    "དུར་ཁྲོད་བདག་པོ་གཉིས་ངེད་ལ་སྡོད་རྟེན་ཅིག་མ་བཞེངས་འདུག་པས་ལོག་ཡོང་ཟེར་བྱུང་བས།",
    "དུར་ཁྲོད་བདག་པོ་ཞིག་ཀྱང་འབྲི་དགོས་པ་འདུག་ཞུས་པས།",
    "ཡང་ཡང་མི་ཡོང་ཁྱེད་རང་ཡང་ཉོན་གསུང་བ་ལ།",
    "སྤྱན་རབ་རིབ་དང་ཆབ་ཀློག་ཀྱང་ལྷག་པར་ངན་པར་འདུག་ནའང་།",
    "འབུལ་བར་ཞལ་གྱིས་བཞེས་ཀྱང་ཕྱག་ཐོག་ཏུ་མ་ཁེལ་འདུག་གོ།",
    "མི་ཉག་གྲགས་རྡོར་བའི་སྒྲའི་བུ་ཆེན་དེས་ཁས་བླངས་ནས་བྱོན་པས་ཕྱོགས་ཀྱང་མ་མཚོན་པར་འདུག་པའི་སྐབས་དེར་འདུག་པས།",
    "བ་ལྷའི་རང་འགྲེལ་སྔོན་གྱི་པཎྜི་ཏ་ལོ་ཀོཏྟ་རའི་ཕྱག་ན་ཡང་འདུག་པ་རྒྱ་དཔེའི་སྟེང་ནས་ངེད་ཀྱིས་ཀྱང་མཐོང་།",
    "ད་ལྟའི་དེ་ཡང་དེ་ཀ་ཡིན་ཚོད་དུ་འདུག་ནའང་།",
    "ད་ལྟའི་ཨ་ཞང་བསོད་ལྷུན་པ་སོགས་དབུས་ནས་ཕེབས་པས།",
    "ཕྱག་དཔེ་སྩལ་ནས་གང་གཞན་ལུགས་འདྲེས་པའམ་ཁྱད་ཐོན་གྱི་ཟུར་ཆ་གང་འདུག་ལ་ཤོག་གཟེར་ཐོབ་ཤོག་ཅེས་བཀའ་གནང་བ་ལྟར་མཛད་ནས་ཕུལ་བས།",
    "གཞན་རྣམ་པས་ས་སྐྱ་པ་མིན་ཞེས་ལབ་ཀྱི་ཡོད་འདུག་གོ།",
    "དགའ་ལྡན་ན་མེ་ཏོག་ཡིད་འོང་ཕུབ་ཙམ་འདུག་ཅེས་གསུང་བ་ཡང་བྱུང་བས།",
    "བསམ་ཆུང་རང་འདུག་གོ།",
    "དོན་དུ་གཏུགས་ཙ་ན་དེ་ཙམ་བཞག་ནས།",
    "གཞན་གདན་ས་དང་བཀོད་པའི་སྤྲོས་སྤྲོས་མ་མཛད་འདུག་གོ།",
    "ངེད་རང་བསེར་མའི་རྣམ་པ་ཞིག་ཀྱང་འདུག་ཨ།",
    "ཆེར་མི་རྟོགས་པ་འདུག་ལགས་ཟེར།",
    "ནམ་ཡང་རང་ཉམས་མཁས་པའི་ཁེངས་པ་བྲལ།",
    "རང་ཡུལ་དེ་ཉིད་ལ་རང་དང་རང་མ་ཡིན་གྱི་སྤུ་རིས་འབྱེད་པའི་ལས་ཅན་དེའམ།",
    "འོན་ཀྱང་འདི་ནི་རིགས་པ་ཕྲ་བ་ཞིག་ལ་གཏུགས་ནགོ་རྒྱུ་ཆེན་པོ་འདུག་ཀྱང་།",
    "རིག་པར་བྱ་བ་ལ་བསམ་འདུག་ཀྱང་།",
    "སྣང་ལ་མ་ངེས་དང་གསུམ་ཡོད་པར་གསུངས་འདུག་ཀྱང་།",
    "འོ་ན་ཁོ་རང་ལ།",
    "རང་མྱོང་རང་རིག་མངོན་སུམ་ལ་བརྟེན་པ་གང་ཞིག།",
    "སྤྱིར་རྟགས་ཡང་དག་ཡིན་ཡང་རང་ལ་ཚུལ་གསུམ་གང་རུང་མ་གྲུབ་པའི་ངང་ནས་བསྒྲུབ་བྱ་ལ་དཔྱོད་པའི་ཡིད་དཔྱོད་ལྟ་བུ་གཉིས་པ་དང་།",
    "ཞེས་གསུངས་པ་ལྟར་མཁས་པ་ཕལ་ཆེར་བཞེད་པ་མཐུན་འདུག་པའི་ཕྱིར་དང་།",
    "ལས་བཟང་ངན་གང་ཡིན་ཀྱང་རང་རང་རི་གས་མཐུན་གྱི་འབྲས་བུ་ལ་མི་བསླུ་བ་ཡིན་པས་ཐབས་དང་ཐབས་བྱུང་གོ་ལོག་ཏུ་སྤྱད་པའི་འབྲས་རྟགས་གསལ་བ་ཡིན་ཏེ།",
    "འཇུག་པར་བྱ་བའི་ཡུལ་ཡང་རང་རྒྱུདལྡན་གྱི་གང་ཟག་འཇུག་པར་བྱ་བའི་ཕྱིར།",
    "རང་མྱོང་རང་རིག་མངོན་སུམ་གྱིས་རང་སྟོབས་ཀྱིས་ངེས་པ་འདྲེན་ཞུས་པས་ཁྱབ་པའི་ཕྱིར་ཏེ།",
    "དོན་རིག་གཉིས་དང་རང་རིག་གཉིས།",
    "ལུགས་གཉྩི་ཀར་ཐ་མལ་པའི་ཉམས་མྱོང་ལ་གཞིགས་པའི་རིགས་པ་ཕྲ་ལ་མཛངས་པ་དུ་མས་ཆེས་གསལ་བར་མཛད་འདུག་པས།",
    "གཞན་ཡང་རང་ཡུལ་ལ་སེལ་བའི་རྣམ་པས་འཇུག་པ་དང་།",
    "བྱིད་བོད་ཀྱི་གཉེན་པོར་བརྟེན་པའི་བསྒྲིམ་མི་དགོས་པར་གནས་པ་སྟེ་སེམས་རྣལ་དུ་འདུག་པ་བཏང་སྙོམས།",
    "དཔེར་ན་ཤིང་སྡོང་གཅིག་ལ་ཡལ་ག་དང་ལོ་མ་མཐའ་ཡས་ཀྱང་དེ་དག་ཀུན་གྱི་རྩ་བ་སྡོང་པོ་ཉིད་ཡིན་པས་དེ་ཉིད་སྐམ་དུ་བཅུག་ན་ཡལ་ག་ལོ་འདབ་ཐམས་ཅད་ཀྱང་རང་སྐམ་དུ་འགྲོ་བ་བཞིན་ནོ།",
    "སྒྲུབ་རྒྱུད་འདྲེན་པའི་ཤིང་རྟ་བརྒྱད་རྗེས་འབྲང་དང་བཅས་པ་རང་རང་སོ་སོའི་ལྟ་གྲུབ་ཀྱི་ཁས་ལེན།",
    "ཡཱ་ན་སརྦ་མུ་ཁེ་བྷྱ་ས་མུ་ཙྪ་ཡ་པྲ་བ་ཙ་ནཾ་རཏྣ་ཀོ་ཥ་ཏྲི་ཤིཀྵ་སུ་དེ་ཤི་ཀཱ་ཤཱ་སརྦ་ཛྙ་ཡ་སྤ་ར་ཎ་ནཱ་མ།",
    "དེ་དག་ཆགས་འཇིག་དུས་མཉམ་བྱེད་པར་གསུངས།",
    "འཇིག་དུས་དམྱལ་ནས་འགོ་བརྩམས་ངན་འགྲོ་སྟོངས།",
    "འཇིག་རྟེན་སྟོང་འཇུག་དུས་བཞིའི་ཚུལ་ཡང་འཆད།",
    "ཡང་དག་དོན་དང་རང་སྣང་སྟུག་པོ་བཀོད།",
    "ཁ་ཆེར་དབུས་དང་ནུབ་རྙིང་རང་སྲོལ་གསུམ།",
    "མཉམ་འགྲོ་གྲུར་འཇུག་འདུག་འགྲེང་སྦྱོར་བཅུག་རྩ་༢ ༢ན་དང་།",
    "ཡང་ཡང་འདུག་ཟ་ལྷག་ལེན་སྤངས་པ་སྟོབ།",
    "ཆུར་སྤྱོད་ཉལ་སར་འདུག་འགྲེང་གཅེར་བུར་སྦྱིན།",
    "སྤྱོད་ཡུལ་ཉི་ཤུ་སྟན་ལ་འདུག་པའི་དགུ།",
    "ཉན་ཐོས་ནང་འདུག་མི་ཤེས་སྔགས་པར་རློམས།"
  ]
}