    "རྗེ་འདིས་སྐྱེད་བཅུག་བྱས་ན།",
    "བསྒྲིབ་པར་བྱ།",
    "དབྱས་ཏེ།",
    "འབྲོག་བན་གྱི་བག་ཆགས་རྣམ་པར་སྤྱོད།",
    "དེ་ཡིས་མཆོད་བྱས་པ་ན།",
    "ཧཱབ་ཞེས་པས་གསོད་པར་བྱེད།",
    "པར་བྱེད།",
    "ཚིག་ཉིད་ལ་འཐོབ་པར་འགྱུར།",
    "དོན་དང་དོན་མིན་རྣམ་པར་དཔོད་མཛད་ཕྱོགས་ཀི་གླང་པོ་གང་དེ་རྒྱལ་གྱུར་ཅིག།",
    "ལེགས་པར་རོགས་ནས་འགོ་ལ་སོན་མཛད་པ།",
    "མཁས་པའི་གཞུང་ལུགས་རིགས་པས་སྒྲུབ་ལ་ངེས་པར་དབུལ་བའི་དོན་ག་཈ེར་དག་ལ་མཁས་པའི་གཞུང་དོན་རིགས་པས་སྒྲུབ་པའི་རྒྱན་འདི་སྦྱར།",
    "འདི་ནི་ཅུང་ཟད་ཅིག་དཔད་པར་བྱ་སེ།",
    "སི་མཚན་གཞལ་བྱ་མ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "པར་འགྱུར་རོ།",
    "འོ་ན་ཤེས་པ་དང་སི་མཚན་ག་཈ིས་སུ་མ་འདུས་པ་གཞན་མེད་པར་འགྱུར་ཏེ།",
    "ཞེས་པའི་འགེལ་པར་ཡུལ་གཟུགས་ལ་སོགས་པ་མ་ཡིན་ནོ།",
    "སོ་ལྔའི་རྣམ་པར་ཤེས་པ་ལ་ཡུལ་ཤེས་ཅེས་པའི་ཐ་སྙད་སྦྱར་བར་བྱ་བ་མ་ཡིན་ཏེ།",
    "བོ་གོས་དང་ལྡན་པ་རྣམས་ཀིས་དཔད་པར་མཛོད་ཅིག་ཡང་ཡིད་ཀང་དོན་དང་ཆགས་ལ་སོགས།",
    "འདི་ནི་ཤིན་ཏུ་མི་འཐད་པར་མཐོང་སེ།",
    "འོ་ན་མི་རག་པ་བྱས་པའི་ངོ་བོ་མ་ཡིན་པར་དམ་བཅས་ན་སྐྱོན་ཅི་ཡོད།",
    "བྱས་པ་རག་པར་འགྱུར་ཏེ།",
    "མི་རག་པ་བྱས་པའི་ངོ་བོ་མ་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "ཅེས་གསུངས་པའི་ཕྱིར་རོ།",
    "རྒྱས་པར་ནི་དགག་སྒྲུབ་སྐབས་སྐབས་སུ་བྱེད་དོ།",
    "འགེལ་པར།",
    "འགེལ་པར་མེད་པ་཈ིད་ལ་མེད་པ་ཞེས་པ་ནི་སླར་ཡང་དེ་཈ིད་ངེས་པར་བྱ་བའི་དོན་དུ་སེ།",
    "གལ་ཏེ་ཀུན་ལས་བཏུས་པ་བསན་པར་འདོད་ན།",
    "ཅི་ལྟར་དེ་཈ིད་ལ་ལར་སྤོང་སེ་དཔེར་ན་འདི་ནི་ངེས་པར་བྱ་བའི་དོན་ཡིན་ཏེ།",
    "རྣམ་པར་ཀུན་བཏུས་རབ་བྱེད་རྒྱན།",
    "རང་཈ིད་ཀི་སྒྲས་ནི་ཁས་བངས་པ་སོན་པར་བྱེད་པའོ་ཞེས་པར་འབྲེལ་ཏེ།",
    "བཅད་ཤེས་ཀི་ཡུལ་མེད་པར་འགྱུར་རོ།",
    "ཕལ་པ་རོགས་པའི་ཤེས་པའི་ཡུལ་མེད་པར་འགྱུར་རོ་ཞེས་བརོད་ན་ལན་ཅི་ཡོད་ལེགས་པར་སོམས་ཤིག་དེས་ན་ཡུལ་དམ་པ་ལ་རིགས་པ་མི་ཤེས་པའི་བླུན་པོས་སྐྱེ་བ་ཕྱི་མ་བོས་བཏང་བའི་ལས་བསགས་པར་མི་བྱའོ།",
    "དགོས་པ་ཁད་པར་ཅན་ཡོད་དེ།",
    "ཁད་པར་གསུམ་དང་ལྡན་པ་གཟུགས་ལེགས་པ་བཞིན་དུ་མཛེས་པར་གཤེགས་པ་དང་།",
    "བུམ་པ་ལེགས་པར་གང་བ་བཞིན་དུ་མ་ལུས་པར་གཤེགས་པ་དང་ལྡན་པའི་ཕྱིར།",
    "དམན་པའི་དག་བཅོམ་ལས་ཁད་པར་དུ་བྱས་པའོ།",
    "ཁ་ལག་ཁྲུས་བྱས་ནས་ཟས་ཟའོ་ཞེས་པ་ལྟར་འོག་མ་འདྲེན་པའི་ཚིག་སེ།",
    "འོ་ན་རིགས་པའི་སོ་ལ་སོགས་པ་ལས་བསན་པ་དང་ཁད་པར་ཡོད་དམ་མེད།",
    "དེས་ན་འདིར་བསན་པ་ནི་རིགས་པའི་སོར་བསན་པ་དང་ཁད་པར་མེད་པ་མ་ཡིན་སེ།",
    "འདིར་མ་བསན་པར་གཞན་ལ་ཁ་འཕངས་པ་ཙམ་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཙ་ར་ཀ་བསྡུས་པར།",
    "འབྲས་བུ་ལ་ལོག་པར་རོག་པ་བསལ་བའོ།",
    "ཞེས་བརོད་ན་ལན་ཅི་ཡོད་ལེགས་པར་སོམས་ཤིག་གལ་ཏེ།",
    "ཡོད་ལེགས་པར་སོམས་ཤིག་དགག་སྒྲུབ་རྒྱས་པར་ནི་གཞན་དུ་བྱས་ཡོད་པས་དེར་བལྟ་བར་བྱའོ།",
    "གངས་གཞན་འགོག་པར་བྱེད་པ་ལ་རགས་རྣམ་པ་ག་཈ིས་སེ།",
    "རྣམ་པར་ངེས་པར་ཡང་།",
    "རྣམ་པར་འགེལ་པ་ལས་ཀང་།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་ངེས་པ་ལས་ཀང་།",
    "ཞེས་གསུངས་སོ།",
    "འདིའི་དོན་རྒྱས་པར་རྣམ་པར་འགེལ་པ་ལས་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་ངེས་པ་ལས།",
    "མ་འཁྲུལ་བ་ཞེས་བསན་པའི་ཕྱིར་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "མ་འཁྲུལ་བ་ཞེས་བསན་པའི་ཕྱིར་ཞེས་གསུངས་པའི་ཕྱིར།",
