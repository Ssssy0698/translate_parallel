    "དོན་དམ་པར་སུ་ཞིག་སུ་ལ་གནོད་པ་བྱེད།",
    "དེ་ཉིད་གསུངས་པ།",
    "འོ་ན་དེ་ལྟར་ཡིན་ན་གཅིག་བསྒྲུབ་པ་ན་གཉིས་པ་ཉམས་པར་འགྱུར་རོ་སྙམ་དུ་དོགས་པ།",
    "ལ་ལར་ནི་ལྡོག་པར་མི་རིགས་སོ།",
    "གཅིག་ཏུ་ལྡོག་པ་ན་ཐམས་ཅད་དུ་ལྡོག་པར་རིགས་ཀྱི་ལ་ལར་ནི་མ་ཡིན་ཏེ།",
    "འདིར་ལན་གསུངས་པ།",
    "བཟློག་པར་རིགས་སོ།",
    "འདི་སྐད་དུ་བསྟན་པར་འགྱུར་ཏེ།",
    "དེ་དག་ཀྱང་ཕྱི་ནས་རྒྱས་པར་སྟོན་པར་འགྱུར་རོ།",
    "ངེས་པར་ལེགས་པའི་རང་བཞིན་གྱི་འབྲས་བུ་སྐྱེའོ།",
    "དེ་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་སྡུག་བསྔལ་དང་ཉེ་བས་སེམས་འཁྲུགས་ན་ཡང་སྡུག་བསྔལ་ལྡོག་པར་མི་འདོད་དོ་ཞེས་བསྟན་པ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བག་མེད་པས་ནི་ཞེས་བྱ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མ་བརྟགས་པར་བྱེད་པ་ནི་བག་མེད་པའོ།",
    "རང་ལ་ནི་བདག་ཉིད་ཀྱི་ལུས་ལ་གཞན་གྱི་གནོད་པས་གནོད་པ་བྱེད་པ་ཡོད་དེ་གསོད་པར་བྱེད་པའོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དཔེར་ན་མེ་སྲེག་པར་བྱེད་པའི་ཕྱིར་མེ་སྲེག་པར་བྱེད་པ་རང་བཞིན་ཡིན་པ་ལྟ་བུའོ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ལ།",
    "དེ་བས་ན་ཉེས་པ་དེ་ནི་དུ་བ་ཉིད་ཀྱི་ཉེས་པར་རིགས་ཏེ།",
    "གཞན་ཡང་སྡུག་བསྔལ་གྱི་རྒྱུ་གཙོ་བོ་གང་ཡིན་པ་དེ་ལ་ཁྲོ་བ་རིགས་པར་འགྱུར་གྱི་གཙོ་བོ་མ་ཡིན་པ་ལ་ནི་མ་ཡིན་ནོ་ཞེས།",
    "དབྱུག་པ་ལ་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་འཕེན་པར་བྱེད་པ་ཉིད་ཉེས་པ་ཅན་དུ་འགྱུར་རོ།",
    "འོ་ན་དེ་ལྟར་ན་དེ་ཡང་དབྱུག་པ་བཞིན་དུ་ཞེ་སྡང་སྦོད་པར་བྱེད་པས་སྦད་པས་ཞེ་སྡང་ལ་བདག་ཁྲོ་བར་རིགས་ཀྱི།",
    "སྡུག་བསྔལ་ལ་མ་གཏད་པ་ནི་འགའ་ཡང་ལོངས་སྤྱོད་པར་མི་བྱེད་དོ་ཞེས་རྣམ་པར་བསམས་ལ།",
    "གཞན་ལས་ནི་མ་ཡིན་ནོ་ཞེས་བརྟག་ཅིང་གཞན་གནོད་པ་བྱེད་པ་ཇི་མི་སྙམ་པར་ཞེས་བསྟན་པ།",
    "དེའི་མཚོན་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བུ་ནུས་པ་ཅན་གྱི་རྒྱུ་ཡོད་པར་གྱུར་པ་ནའང་ཇི་ལྟར་ན་འབྲས་བུ་མི་སྐྱེ།",
    "ཤུ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "འཇོམས་པ་ཐམས་ཅད་མི་བཟོད་པ་ནི་བརྡུང་བ་དང་བརྡེག་པ་ལ་སོགས་པས་ཀྱང་ཉམས་པར་བྱ་བ་ཡང་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ཐོབ་པར་བྱ་བའི་སྲེད་པའི་སྟེ་འདོད་པ་གང་ཡིན་པའོ།",
    "བདག་ནི་བློ་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་ཡིན་ནོ་ཞེས་དཔྱད་པ་ལ་བྱིས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟར་ཡང་འདི་ནི་ཕྱིན་ཅི་ལོག་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་དག་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "གཞན་ལ་གནོད་པ་བྱས་པ་ལས་བྱུང་བའོ།",
    "མང་བ་ནི་རྣམ་གྲངས་དུ་མས་བྱས་པའོ།",
    "འབྱུང་སྟེ་སྡུག་བསྔལ་དེ་ཉམས་སུ་མྱོང་བ་རྣམ་པར་སྨིན་པས་ཟད་པར་འགྱུར་རོ།",
    "ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་བྱིས་པ་ལ་སོགས་པ་རྡེག་པར་བྱེད་པ་ལ་ལེན་དུ་གནོད་པ་བྱས་ན་དེ་ལྟར་ནའང་དེ་དག་མ་བསྲུངས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་གཞན་གྱིས་གནོད་པ་བྱས་པ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པ་བསྟན་ནས།",
    "ཡིད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ན་དེ་ལས་བྱུང་བའི་སྡུག་བསྔལ་དོན་དམ་པར་མེད་དོ།",
    "རྟོག་པ་ལས་བྱས་པའི་ཡིད་མི་བདེ་བ་ཡོད་དེ།",
    "བརྙས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "བརྙས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྙེད་པའི་བར་ཆད་བྱེད་པར་མི་འགྱུར་བ་ཡིན་ནོ་ཞེས།",
    "རྙེད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡིས་རྙེད་པ་འབུལ་བ་ལས་ཕྱིར་ཕྱོགས་པར་འགྱུར་ཏེ།",
    "བརྟེན་པར་ཞེས་བྱ་བ་ནི་དེའི་འབྲས་བུ་དེ་ལོངས་མ་སྤྱད་པར་འཇིག་པར་མི་འགྱུར་བའོ།",
    "རང་ཉིད་ཀྱིས་འདིར་འདི་དག་དཔྱད་པར་བྱའོ་ཞེས།",
    "བདག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་ཡུན་རིང་པོར་འཚོ་ཡང་ཁྱད་པར་ནི་མེད་དོ།",
    "རྨི་ལམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དེ་ཙམ་ཞིག་ཏུ་བདག་ཉིད་བདེ་བར་གྱུར་པར་རློམ་སྟེ།",
    "འདི་དག་གཉི་ག་ལ་ཡང་རྨི་ལམ་དུ་བདེ་བ་མྱོང་བར་རྨིས་པ་སད་པར་གྱུར་པ་ན་རྨིས་པའི་བདེ་བ་ཞིག་པ་དེ་ནི་ཕྱིར་འོང་བ་མེད་དོ།",
