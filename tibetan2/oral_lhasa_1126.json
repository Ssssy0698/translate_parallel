    "བདུད་ཀྱི་སྟོབས་ཀྱི་དྲེགས་པ་ཟློག་པར་བྱེད།",
    "རྙེད་པར་སླ་ཞིང་ཡོ་བྱད་ཉུང་བ་དང་།",
    "དེ་ཡང་དག་པར་བླངས་པའི་ཡོན་ཏན་ན་ནི།",
    "ཕྱོགས་རྣམས་ཀུན་དུ་དགག་པ་མེད་པར་ནི།",
    "དགོས་པ་བྱེད་པའི་མཆོག་ཡིན་པས་འདི་དག་ཡང་ད་ག་པར་བླང་བར་བྱའོ།",
    "སེམས་རྣམ་པར་གཡེང་བ་དང་།",
    "མཐར་ཐུག་པར་བྱ་བ་ཉིད་ཡིན་ན་ནོ།",
    "མཆོག་ཏུ་བད་ག་ལ་ཕན་པས་གནས་པར་བྱའོ།",
    "ལོག་པར་བརྩོན་པས་ནགས་ལ་མངོན་དགའ་དང་།",
    "ཁྱད་པར་ཆུང་ངུས་ཤིན་ཏུ་དག་པས་གཡེང་ས།",
    "རྗེས་སུ་མཐུན་པར་རབ་ཏུ་ཞི་བར་བྱའོ།",
    "ད་ད་པ་མེད་པའམ་དད་པ་ཆུང་བ་རྣམས་ཀྱིས་འདི་སྨཱད་པར་འགྱུར་ན་ཡང་།",
    "མཆིལ་ལྷམ་བགོས་༧ན་ས་དུས་ལ་བབ་པར་གྲོང་དུ་འཇུག་པ་ན་ཡང་ཉི་མ་དང་དུས་ཤེས་པར་བྱས་ལ་འཇུག་པར་བྱའོ།",
    "ལྐུགས་པ་མ་ཡིན་བཞིན་དུ་ལྐུག་༢ིཔ་ལྟ་བུར་བྱེད་ཅིང་བསྡམས་པ་༤ལུས་ཤིན་ཏུ་བསྡམས་པར་༥འཇུག་པར་བྱའོ།",
    "ཁ་ཆུ་འཛགས་པས་ཉལ་བ་དང་མཚུང་ས་པར་མི་བྱ་ཞིང་།",
    "བ་ཅའ་བ་༤ལས་ཉམས་པར་མི་འགྱུར་རོ།",
    "ཟས་ཕྱིས་མི་ལེན་པས་ཀྱང་བསྟབས་པ་ལས་ལྷག་པར་ལོངས་སྤྱད་༥པར་མི་བྱ་ཞིང་།",
    "མ་༦བསྟབས་པ་ཡང་ཟོས་ཟིན་ནས་ལོངས་སྤྱད་༧པར་མི་བྱ་སྟེ།",
    "ཆོག་ཤེས་པའི་རྗེས་སུ་མཐུན་པར་བྱའོ།",
    "བ་ཅའ་བ་༨དང་མི་འགལ་བར་འཇུག་པར་བྱའོ།",
    "གཞི་ཇི་བཞིན་པས་ཀྱང་རྐྱེན་དེ་ལྟ་བུ་བྱུང་ན་གཞན་ལས་རྗེས་སུ་གནང་༐",
    "འདི་ལྟ་བུས་དེའི་དམ་བཅས་པ་ཉམས་པར་མི་འགྱུར་ར་རོ།",
    "ཁྱིམ་དུ་ཞུགས་པར་མི་བྱ།",
    "དབྱར་གྱི་གནས་མེད་ན་སྟེང་གཡོགས་ཡོད་པར་འགྲོ་བར་བྱའོ།",
    "བཅའ་བ་༡མི་གཏོང་བ་ཡིན་པའི་ཕྱིར་ཉམས་པར་མི་འགྱུར་རོ།",
    "ཡོངས་སུ་དག་པར་བྱ་བའི་ཕྱིར་དང་།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བ་དང་།",
    "བཀྲ་ཤིས་པར་བྱ་བའི་ཕྱིར་ལམ་དུ་འདོར་༢བ་དང་།",
    "ཚངས་པ་མཚུངས་༧པར་སྤྱོད་པ་རྣམས་ལ་གུས་པས་འཕྲལ་དུ་ལངས་ནས་ཟས་ལ་སྤྱོད་ཀྱང་སྟན་གཅིག་པ་༨ཉིད་ལས་ཉམས་པར་མི་འགྱུར་རོ།",
    "འཕགས་པའི་རིགས་ད་ང་རྗེས་སུ་མཐུན་པར་བྱ་བའི་ཕྱིར་ཡང་དག་པར་བླང་བར་བྱ་སྟེ།",
    "འདི་དག་ཐམས་ཅད་ཀྱང་ད་ད་པ་རྣམ་པར་ད་ག་པ་ཉིད་ཡིན་པའི་ཕྱིར་དང་།",
    "ཡིད་ཀྱི་ལས་ཐམས་ཅད་ཤེས་བཞིན་ཉིད་ཀྱིས་སོ་སོར་ལེགས་པར་བརྟགས་༢ནས་བྱ་སྟེ།",
    "འདི་ནི་འདིའི་རྒྱུར་བསྒྲུབ་པར་བྱའོ།",
    "ཤའི་རིས་བརྒྱ་ཕྲག་དུ་མས་ཞལ་ཞལ་བྱས་པ།",
    "པགས་༤པས་གཡོགས་པར་བལྟ་བར་བྱའོ།",
    "དེ་ལྟར་ཡང་དག་པའི་ཤེས་བཞིན་ཉིད་ལ་སོགས་ལུས་ད་ང་ངག་དང་ཡིད་ཀྱི་ལས་ཤིན་ཏུ་རྣམ་པར་དག་པ་ནི་ཏིང་ངེ་འཛིན་གྱི་སྦྱོར་བ་ཙམ་བསྒྲུབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "བཏང་སྙོམས་ཞི་དང་འཛིན་པར་གྱུར་༥ཉིད་ད་དུ།",
    "སེམས་དེ་ལ་ནི་མངོན་བརྩོན་མཉམ་པར་གཞག་༦།",
    "རྣལ་འབྱོར་སྤྱོད་པའི་རྣམ་གཡེངས་༡༧འདིས་མཉམ་པར་གཞག་༡༡པའི་ཕན་ཡོན་ལ་བསམ་པར་བྱའོ།",
    "གཞན་གྱི་ཁ་ན་མ་ལས་པའི་ཏིང་ངེ་འཛིན་ལས་བྱུང་བའི་དགའ་བ་དང་བདེ་བའི་རོ་སྟེན་པར་བྱེད་པ་ན་མི་ལས་འདས་པའི་དགའ་བ་ཡིད་དུ་འོང་བ་ཉམས་སུ་མྱོང་བར་འགྱུར་ཏེ།",
    "ཇི་སྐད་དུ་དགེ་སློང་ཁྱིམ་སྟོང་པར་ཞུགས་པ་ནི་མིའི་ལས་འདས་པའི་དགའ་བ་ཐོབ་པོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཏིང་ངེ་འཛིན་ཡོང་ས་སུ་སྦྱང་བ་བྱས་པའི་སེམས་འཇམ་ཞིང་ལས་སུ་རུང་བ་སྒྲིབ་པའི་རྙོག་པ་དང་བྲལ་བ་ནི་ཕུང་པོ་ད་ང་ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་རང་བཞིན་གྱི་༡བདེ་བླག་ཏུ་མཐོང་བར་འགྱུར་རོ།",
    "ནང་དུ་ཡང་དག་པར་འཇོག་པས་རྣལ་འབྱོར་ལ་མཉམ་པར་གཞག་༢པར་བྱ་ཞིང་སེམས་ནང་དུ་ཞི་བར་བྱའོ།",
    "ཁྱད་པར་དེ་དང་དེ་ཐོབ་པར་འགྱུར་ཏེ།",
    "ཏིང་ངེ་འཛིན་ཐོབ་པ་མི་སློབ་པའི་ས་མ་ཐོབ་པར་མ་ཉམས་པར་དུས་བྱས་ནས་༥ཏིང་ངེ་འཛིན་ཇི་ལྟ་བ་བཞིན་དུ་གཟུགས་དང་།",
    "གཟུགས་མེད་པའི་ཏིང་ངེ་འཛིན་ཕུན་སུམ་ཚོགས་པ་ཐོབ་པར་འགྱུར་ར་རོ།",
    "ཇི་སྐད་དུ་སྐྱེ་བ་རྣམ་པར་འབྱེད་པ་ལས་ཏིང་ངེ་འཛིན་གྱི་ཉེ་བར་སྤྱོད་པས་ཉེ་བར་བསགས་པའི་ལས་ཀྱི་ལྷའི་བདག་པོ་དང་།",
    "འཁོར་ལོས་སྒྱུར་༦བ་ལ་སོགས་པའི་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་དང་།",
    "སེམས་དང་སེམས་ལས་བྱུང་བ་དམིགས་པ་གཅིག་ཡང་དག་པར་སྡུད་༢པས་ན་ཏིང་ངེ་འཛིན་ཡིན་པའམ།",
    "ཕྱིན་ཅི་མ་ལོག་པ་ཡིན་པས་ཏིང་ངེ་འཛིན་འདི་ལ་གཏོད་ཅིང་འཇོག་པ་ན་ཕུན་སུམ་ཚོགས་པའི་ཁྱད་པར་ཡེ་ཤེས་དང་མཐོང་བ་དེ་དང་དེ་སྐྱེད་༤པའི་ཕྱིར་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ཡང་གང་རྣམ་པར་དག་པའི་སེམས་དམིགས་པ་གཅིག་ལ་ཉེ་བར་ཞི་བའི་ཡོན་ཏན་གྱིས་ཡང་དག་པར་༥བརྩོན་འགྲུས་འཇུག་ཅིང་མི་གཡེང་བར་གནས་པའམ།",
    "སེམས་གནས་པ་ད་ང་ཡང་དག་པར་གནས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཇི་སྐད་གསུང་ས་པ་ལྟ་བུའོ།",
    "དམིགས་པ་གཅིག་པ་ལ་སེམས་ཡང་དག་པར་འཇོག་པའཇོ།",
    "དེའི་མཐུས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ས་སོ།",
    "དེ་ལ་རྟོག་པ་དང་དཔྱོད་པ་དང་བཅས་པ་ནི་བསམ་གཏན་དང་པོ་དང་དེའི་མཐུས་སྙོམས་པར་འཇུག་པའོ།",
