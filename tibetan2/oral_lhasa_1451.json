    "ན་ཚོད་བཞིན་དུ་རྣམ་པར་སྨྲས།",
    "མྱུར་དུ་འབྲས་བུ་བཅས་པར་འགྱུར།",
    "དབུ་ལས་དཔལ་ནི་རྣམ་པར་རྒྱང་རིང་བྱས་ནས་ནི།",
    "དེ་ནས་ལྷ་ནི་གནས་པར་རི་དྭགས་སྔོན་པོའི་ལུས།་།",
    "བརྒྱ་བྱིན་མཚུངས་པ་གང་དེ་འདིས་ནི་དོན་འགྱུར་ན་། ཨེ་མ་རབ་ཏུ་བཞེས་ལ་དཀར་པོ་དེ་གསོལ་མཛོད།",
    "དཀར་པོ་དེ་ཉིད་བླངས་ནས་ལྷ་ནི་གཤེགས་པར་གྱུར།",
    "དེ་ནས་དེ་ལྟར་ཇོ་བོ་རྒྱལ་སྲིད་མི་བཞེད་པར།",
    "མགྱོགས་འགྲོ་འཆང་དེ་ཕྱག་རྒྱས་གྱེན་དུ་བསྐྱོད་བྱས་ནས།",
    "ཤིན་ཏུ་རྣམ་པར་དུ་ཞིང་ས་ལ་འགྱེལ་གྱུར་ཏོ།",
    "རྣམ་པར་བལྟས་ནས་སླར་ཡང་སྒྲ་བཅས་པར་ངུ་ཞིང་།",
    "ལ་ལར་རབ་ཏུ་སེམས་ཞིང་ལ་ལར་རྣམ་པར་དུ།",
    "དཀའ་ཐུབ་གནས་ལྡན་ཀུན་གྱི་མིག་དག་ཕྲོགས་པར་གྱུར།",
    "ལག་ན་གཉའ་ཤིང་བཅས་པར་འགྲོ་གྱུར་ཡ་མཚན་ལི།",
    "མེ་ཏོག་ལོ་འདབ་རྒྱས་པའི་ལག་པ་གཙང་མ་རྣམས།",
    "དཀའ་ཐུབ་གཙོ་བོ་རྣམས་ནི་བློ་རྣམས་བྱས་ན་ཡང་།",
    "ཐུབ་པ་རྣམས་ཀྱི་ཚིག་དེར་མཐོན་པོར་སྒྲོགས་པར་གྱུར།",
    "དེ་ནས་རྣམ་པར་ཐར་བཞེད་བརྟན་པ་དེ་ཡིས་ནི།",
    "ཁྱབ་པའི་དཀའ་ཐུབ་གནས་དེར་རྗེས་སུ་དཔྱད་པར་གྱུར།",
    "དཀའ་ཐུབ་རྣམ་པར་འགྱུར་བ་རྣམས་ནི་ངེས་གནས་ིནས།",
    "ཞི་བས་དེ་ཉིད་རྣམ་པར་ཤེས་བཞེད་འདི་གསུངས་སོ།",
    "དེ་ནས་དཀའ་ཐུབ་རྣམ་པར་རྒྱུ་བའི་གཉིས་སྐྱེས་དེས།",
    "ཤཱཀྱའི་ཁྱུ་མཆོག་ཁྱུ་མཆོག་རྣམ་པར་གནོན་པ་པོ།",
    "དེ་ལ་རིམ་གྱིས་དཀའ་ཐུབ་ཁྱད་པར་རྣམས་དང་ནི།",
    "དཀའ་ཐུབ་འབྲས་བུ་དང་བཅས་གཏམ་དག་བྱས་པའོ།",
    "དེ་བཞིན་གཞན་ནི་གཞན་གྱི་མི་དོན་དུ་བཅོས་བྱས་ནས།",
    "ཁ་ཅིག་ཉ་དང་མཉམ་པར་ཆུ་ལ་རྣམས་ཞུགས་ནས།",
    "གང་ཞིག་མཐོ་རིས་ཕྱིར་ནི་རྣམ་པར་སྤྱོད་བྱེད་ལ།",
    "དེ་རྣམས་རྣམ་པར་བྲལ་ཏེ་ངེས་པར་འགྲོ་འདོད་ལ།",
    "འདོད་པའི་རྒྱུ་ལས་རབ་ཏུ་འཇུག་པར་འདོད་པའོ།",
    "པར་་། སྡུག་བསྔལ་གྱིས་དེ་སྡུག་བསྔལ་ཁོ་ན་རྗེས་སུ་ཚོལ།",
    "འཆི་བས་སྐྱེ་དགུ་རྣམས་ཀྱིས་རྟག་པར་འཇིགས་པ་སྟེ།",
    "འབད་པ་ཡིས་ནི་སླར་ཡང་རབ་ཏུ་འཇུག་པར་འདོད།",
    "རབ་ཏུ་ཞུགས་པར་གྱུར་ན་ངེས་པར་འཆི་བ་སྟེ།",
    "བདེ་བའི་དོན་དུ་སྲེད་པའི་བཀྲེན་པ་དོན་མ་བྱས།",
    "གསོན་པའི་འཇིག་རྟེན་ངེས་པར་དོན་མེད་ཉིད་དུ་ལྷུང་།",
    "གང་ཞིག་དམན་པ་དོར་ནས་ཁྱད་འཕགས་འགྲོ་བ་ཅན་། འབད་པ་འདི་ནི་ངེས་པར་སྨད་པ་མ་ཡིན་ལ།",
    "དེ་ལྟར་གང་དག་ལས་ནི་རྣམ་པར་དག་པའི་ཕྱིར།",
    "༡༨༧པར་བྱེད་པ་མ་ཡིན་ཕྱིར།",
    "ཆུ་ཡང་ཐེ་ཚོམ་མེད་པར་ཆུ་ཉིད་ཁོ་ན་སྟེ།",
    "སྨྲས་ཏེ་རྣམ་པར་མཛེས་པའི་ཉི་མ་ནུབ་པར་གྱུར།",
    "དཀའ་ཐུབ་རབ་ཏུ་ཞི་བའི་ཁྲུས་སར་རྣམ་པར་ཞུགས།",
    "དཀའ་ཐུབ་ཐམས་ཅད་ཡོངས་སུ་བརྟགས་ཤིང་མཁྱེན་གྱུར་ན།",
    "དཀའ་ཐུབ་གཏེར་དང་རབ་ཏུ་མཚུངས་པར་གྱུར་པ་ལ།",
    "སྲིད་པ་རབ་ཏུ་ཉམས་ཕྱིར་དམ་བཅའ་བྱས་པ་ཡིས།",
    "༡༨༧དང་བཀུར་སྟི་སྐྱེས་པར་གྱུར།",
    "དེ་རིང་སླར་ཡང་ཅུང་ཞིག་གཡོས་པར་གྱུར་པ་ཉིད།",
    "དྲང་སྲོང་ཆེན་པོ་ཐམས་ཅད་རྣམས་དང་མཚུངས་པར་གྱུར།",
    "སྐྱེན་པར་ཁྱེད་ཉིད་འབིགས་བྱེད་ཕུག་པར་གཤེགས་མཛོད་ཅིག།",
    "གང་ཞིག་མཐར་ཐུག་ངེས་པར་ལེགས་པ་ཐོབ་པའི་མིག།",
    "ཆོ་ག་བཞིན་རྗེས་བྱས་ནས་དཀའ་ཐུབ་ནགས་དེར་གཤེགས།"
  ]
}