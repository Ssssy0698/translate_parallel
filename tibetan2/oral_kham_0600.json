    "སེམས་རྣམ་པར་དབེན་པའི་མཐར་ཐུག་པ་ཡང་རང་བཞིན་གྱི་སྣང་བ་ཙམ་ཡོངས་སུ་ཤེས་པ་ཙམ་དུ་ཟད་པས།",
    "ལུས་ཀྱི་བྱ་བ་བྱེད་ནུས་པའི་ལྷ་སྐུ་མི་འདུག་སྟེ།",
    "རྨི་ལམ་གྱི་དུས་ན་ལུས་ཅིག་འདུག་པ་དེ་རགས་ལུས་འདི་མིན་པར་འདུག་སྟེ།",
    "རགས་པའི་ལུས་ནི་མི་མཐོང་བར་འདུག་པ་དང་།",
    "འདུག་པ་སོགས་སྤྱོད་ལམ་སྣ་ཚོགས་བྱེད་པ་ལས།",
    "རགས་པའི་ལུས་ནི་མལ་དུ་མི་རོ་བོར་བ་ལྟར་འགྱེལ་ནས་འདུག་ནའང་།",
    "འདི་ངོ་བོ་སྣང་གསུམ་ཡིན་ཡང་རང་བཞིན་བརྒྱད་ཅུའི་རྣམ་རྟོག་དང་འབྲེལ་བ་ཁོ་ན་ཡིན་ཞིང་།",
    "སྒྲིབ་པ་ཡིན་ཡང་རང་བཞིན་གྱི་རྣམ་རྟོག་དང་བྲལ་བ་ཡིན་པས།",
    "ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་མཐའ་ཡས་པ་དེའི་རྟེན་དང་གཞི་དང་གནས་དང་རྩ་བ་དང་རང་བཞིན་དང་།",
    "དེ་ནི་གནས་ལུགས་དང་རང་གཟུགས་ཡིན་པའི་ཕྱིར་ནང་ཞེས་སྨོས་སོ།",
    "དེའི་སྣང་ཆ་མ་འགགས་ཀྱང་རང་བཞིན་སྤྲོས་བྲལ་དུ་རྟོགས་པས།",
    "ཁུར་འཁུར་ཞིང་རྒྱུ་བ་ལ་སོགས་པས་རགས་པའི་ལུས་དེ་སྟན་ལ་གནས་པ་མེད་པར་གྱུར་ཞིང་བྲེལ་བྲེལ་འཕོངས་འཕོངས་ལྟར་འདུག་ཀྱང་དེའི་ཡེ་ཤེས་ཀྱི་ལུས་ནི་བདེ་བ་ཆེན་པོའི་སྟན་ལ་རབ་ཏུ་གནས་པ་ཕུན་སུམ་ཚོགས་པའི་འབྱོར་པ་ཅན་ཡིན་ནོ།",
    "ཞིང་ལས་ལ་སོགས་པའི་བྱ་བས་གཡེངས་ཏེ་མཉམ་པར་མ་གཞག་པ་ལྟར་འདུག་ཀྱང་ལྷ་སྐུ་དང་བདེ་ཆེན་གྱི་ཡེ་ཤེས་ལ་རྟག་ཏུ་མཉམ་པར་གཞག་པ་ཡིན་ཞིང་།",
    "གང་ལྟར་ཡང་རང་ལུས་ལྷ་སྐུ་ཁོ་ན་སྟོང་པར་བསྡུ་བ་ནི་རིལ་འཛིན་དང་།",
    "ཞུ་བདེ་དང་རང་བཞིན་གྱི་བདེ་བ་ཆེན་པོས་བྱིན་གྱིས་བརླབས་ཚུལ་ཤིན་ཏུ་ཤུགས་ཆེ་ཞིང་ཁྱབ་པའི་ཚུལ་གྱིས་བྱུང་བ་ཡིན་ཞིང་།",
    "སྐབས་དེར་རང་སྣང་ལ་གཟུང་འཛིན་གྱི་སྣང་བ་མངོན་འགྱུར་བ་འགགས་ཀྱང་རང་རྒྱུད་ཀྱི་ཕུང་ཁམས་དངོས་སུ་དག་པ་མིན་པ་བཞིན་དུ།",
    "དེ་ལས་ལྡང་བའི་ཚེ་ཡང་རང་ཉིད་ཁོ་ན་དཀྱིལ་འཁོར་དུ་ལྡང་ལ།",
    "གང་རང་བཞིན་དང་བཅས་པའི་སྣང་བ་གསུམ་གྱི་སེམས་པ་དང་བྲལ་བ་ན།",
    "འགྲོ་དང་འདུག་དང་ཉལ་དང་ཟ།",
    "འདུག་པ་དང་།",
    "ཉམས་མྱོང་ཇི་ལྟར་བཟང་ཡང་རང་གཞན་བདེ་སྡུག་མཐོ་དམན་འབྱོར་རྒུད་ཀྱི་སྣང་བ་ཉམས་སུ་མྱོང་བར་འགྱུར་རོ།",
    "ཡེ་ཤེས་གསུམ་གྱི་ཆ་ཞེས་པ་ཡང་རང་བཞིན་དང་བྲལ་བའི་སྣང་བ་ཡིན་ཏེ།",
    "འཕགས་པ་ཁོ་ན་ལ་མངའ་བའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་དེ་སོ་སོ་སྐྱེ་བོ་ལ་སྦྱོར་བ་སོགས་མི་འགྲིག་པ་དུ་མ་འདུག་པ་འདི་ནི་མངོན་སུམ་གྱིས་གནོད་པའོ།",
    "དངོས་སུ་རྟོག་པས་བརྟགས་པ་ལ་མ་བལྟོས་པར་ལྷར་སྣང་རང་ཤར་དུ་བྱུང་ཞིང་།",
    "གྲུབ་པའི་ཁྱད་པར་འགའ་དང་བརྩོན་ལྡན་མིན་ཡང་རང་བཞིན་ལྷན་ཅིག་སྐྱེས་པས་ལུས་གཞན་ངེས་པར་བསྒྱུར།",
    "གསང་སྔགས་ཀྱི་ཟབ་དོན་དཔྱིས་ཕྱིན་པ་ཤེས་པ་ལ་གཞུང་འདི་མི་ཤེས་ཁ་མེད་དུ་འདུག་ཅིང་།",
    "ཐབས་དང་བཅས་པར་མི་རུང་ཞིང་བཅས་ཀྱང་རང་བཞིན་འོད་གསལ་གྲིབ་མའི་ཚུལ་གྱིས་ཉམས་སུ་མྱོང་བ་ཡང་མ་ཡིན་ནོ།",
    "རྩ་ཨ་ཝ་དྷཱུ་ཏཱིར་འཇུག་འདུག་པ་དང་།",
    "དོན་འོག་ཏུ་འཆད་འགྱུར་དང་གཅིག་དེས་ན་ཚིག་འདི་རྣམས་དཔེ་ཕལ་ཆེར་ལ་འདུག་ཀྱང་།",
    "སྒྲོན་གསལ་གྱི་ཡིག་སྣ་མར་ལུགས་འདུག་པའི་ཕྱིར་རོ།",
    "གནས་པའི་ཚེ་ལྟེ་བར་གོང་བུ་གཅིག་ཏུ་གྱུར་པ་བདེ་རིལ་ལེ་འདུག་པར་བསམས།",
    "ད་ལྟ་རྨི་ལམ་རྨི་བར་འདུག་སྙམ་པ་དང་སྤེལ་གྱིན་བསྒོམས་པས་རྨི་ལམ་ཟིན་པར་འགྱུར་རོ།",
    "ཨ་ཤད་ལ་སྐོར་བ་ཕྱེད་དང་བཞིས་བསྐོར་བ་སྦྲུལ་འཁྱིལ་བ་ལྟར་འདུག་པར་བསམ།",
    "གནས་པའི་ཚེ་ཨ་ཤད་ཨའི་གདངས་ཅན་དུ་འདུག་པར་བསམ་ལ།",
    "དེ་ནས་བརྩམས་ལྟེ་འོག་སོར་བཞིའི་བར་དུ་གསུམ་གཞིབས་སུ་འདུག་པ་དང་།",
    "རང་སེམས་ལ་འདུག་ན།",
    "ཁྱད་པར་འགྲོ་འཆག་ཉལ་འདུག་སྤྱོད་ལམ་ཅི་བྱེད་ཀྱང་ང་རྨི་ལམ་རྨི་བ་ཡིན་པ་འདུག་འགྲོ་འཆག་སོགས་འདི་ཀ་རྨི་ལམ་ཡིན་པ་འདུག་སྙམ་པ་ལ་སོགས་པའི་དྲན་འདུན་ཐུར་ཐུར་རྒྱུན་དུ་བསྟེན།",
    "དེས་ཀྱང་མ་ཟིན་ན་སྔ་དྲོའི་དུས་ད་ལྟའི་སྣང་བ་འདི་ཐམས་ཅད་རྨི་ལམ་ལྟ་བུར་འདུག་པ་ལ།",
    "སྔར་དེ་ལྟར་མ་ཤེས་པར་བདེན་པར་གཟུང་འདུག་ད་བདེན་མེད་དུ་ངོ་ཤེས་པར་བྱ་སྙམ་པའི་འདུན་པ་དྲག་ཏུ་སྦྱངས་ཤིང་།",
    "ཉི་མ་ཕྱི་ཕྲེད་ནས་ད་ལྟའི་སྣང་བ་ཐམས་ཅད་ལ་རྨི་ལམ་རྨི་བ་ཡིན་པ་འདུག་སྙམ་བྱ།",
    "ཧཱུཾ་ལས་ཨཱ་ཆད་དེ་སྔར་ལྟར་འདུག་པ་ལ་སེམས་གཏད།",
    "མངའ་བདག་དུས་མི་རིང་བར་འགྲུབ།",
    "དམ་ཚིག་དུས་ནི་མ་གཏོགས་ཤིང་།",
    "དུམ་ཚན་གཏན་ནས་མེད་པ་སོགས་ཀྱིས་བཀླག་མི་བདེ་བར་བྱུང་འདུག་པ་ནི།",
    "བཞུགས་གནས་༤ན་སོགས་གང་ཅི་བླ་བྲང་རང་ནས་ཁུར་ལེན་མཛད།",
    "ཀུན་གྱིས་མཁན་ཆེན་གྲགས་པ་རྒྱལ་མཚན་དངོས་སུ་ཕེབས་འདུག་ཅེས་དད་པས་མཆི་མ་འཁྲིགས་པ་བྱུང་ཞིང་།",
    "ཡང་དྭགས་པོ་ནམ་མཁའ་གྲགས་ཀྱི་མཛོད་ན་རི་རབ་ཀྱི་ནུབ་ཕྱོགས་བ་། རྒྱལ་མཁན་ཆེན་གྲགས་པ་རྒྱ་མཚོའི་དཔལ་ཤེལ་དམར་བོ་ལས་གྲུབ་ཅེས་འདུག་པར་གསུང་འཕྲོས་བྱུང་བར་དཔེ་མཚམས་དེ་བཙལ་ཏེ་ཕུལ་བ་སོགས་ཀྱིས་ཐུགས་མཉེས།",
    "ཁོང་སོ་གློད་གསུངས་པར་གདའ་སྙམས་སྙམ་པ་བྱུང་།",
    "དེ་ཡང་རང་སྟོབས་ཀྱིས་མ་ཡིན་པར།",
    "ཀླུ་ཀླུ་སྒྲུབ་རྒྱལ་བས་ལུང་བསྟན་པར་གསུངས་འདུག་པས།",
    "ཕྱོགས་སླ་དང་རང་ལུགས་གཉིས་ཀས་གཞི་གཉེན་རྣམ་གསུམ་བསྡུས་པར་འདོད་པ་འདྲ་ཡང་ཞེས་གསུངས་པའི་ཕྱིར་དང་།",
    "ཕྱོགས་སྔ་དང་རང་ལུགས་གཉིས་ཀྱི་འདོད་པའི་རྣམ་པ་གཉིས་མིང་མཚུངས་ཀྱང་དོན་གཏན་ནས་མི་འདྲ་སྟེ།",
    "དང་བོ་ལྟར་ན་གཞི་ཤེས་ཀྱིས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ལམ་ཐམས་ཅད་བསྡུས་པར་འགྱུར་ལ་དེ་ལྟ་ན་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་མངོན་རྟོགས་ལ་གཞི་ཤེས་ཀྱིས་ཁྱབ་པར་འགྱུར་རོ་ཞེ་ན་སྐྱོན་མེད་དེ།",
    "སྡུག་ཀུན་རགས་པ་ཉེ་བར་ཞི་བའི་ཉེར་ཞི་ནི་སྐབས་འདིའི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱིས།",
    "སྔོན་གྱི་ཁ་ཅིག་ཕྱི་མ་དེས་ཀྱང་བྱང་སེམས་ཀྱི་རྒྱུད་ཀྱི་གཞི་ཤེས་ཡོད་ཀྱང་དེ་ཉན་ཐོས་དང་རང་༢༢བ་རྒྱལ་གྱི་གཞི་ཤེས་སུ་འདོད་པར་མངོན་ལ།",
    "༦བ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་ཐ་སྙད་ཙམ་དུ་ཡང་ཁེགས་པ་གཉིས་འགལ་མེད་གྲོགས་སུ་འཆར་བ་གཅིག་དགོས་པར་འདོད་ལ།་",
    "གཞན་ཡང་རང་རྒྱལ་གྱི་ཡང་དེའི་གཉེན་པོ་མཐོང་བསྒོམ་སྒོམ་གཟུང་ངོ།",
    "སྒོམ་སྤང་རང་བཞིན་གྱི་གནས་ངན་ལེན་གྱི་ས་བོན་དང་ལྡན་པ་དང་།་",
    "ཞེས་པ་ཙམ་ལས་མི་འདུག།",
    "ལོ་གསུམ་མཛད་པར་ཡང་འདོད་དེ་དོན་འགལ་བ་མེད་པར་འདུག།",
    "ཞེས་པའི་ཐད་འདི་ལ་བརྟེན་པ་ཡིན་ཀྱང་འདིར་ཧ་ཅང་མི་གསལ་ལ་སློབ་དཔོན་དཔའ་བོ་དེའི་སྔོན་ནས་བྱོན་པ་ཞིག་ཡིན་འདྲ་ཞེས་དཔྱད་བྱར་མཛད་དོ། ཇོ་བོ་བོད་དུ་བཞུགས་པའི་ལོ་གྲངས་འཆད་སྐབས་ནག་མཆན་དུ་ལུགས་གཉིས་གསུངས་ནས་ཕྱི་མའི་སྐབས་སུ་ལྕགས་རྟ་ལ་འཁྲུངས་ནས་དོན་གསུམ་པ་ཤིང་རྟ་ལ་གཤེགས་པར་གསུངས་འདུག་ན།",
    "ཟླ་བཟང་རང་ཉིད་ཀྱི་འགྲེལ་པ་ཤོ་ལོ་ཀ་སྟོང་ཕྲག་དྲུག་ཅུ་བ་མཛད་ཅིང་།",
    "རྗེས་སུ་ཡི་རང་རང་བསྒོམ་ཤིག།",
    "ཀུན་མཁྱེན་གོང་མས་ཀྱང་འདི་ལྟ་བུ་ལ་དགོངས་ཏེ་གཤེད་དམར་དང་འབྲེལ་བའི་སྟ་གོན་མཛད་པ་ཡིན་འདུག།",
    "ཞི་ལྷག་ཟུང་འབྲེལ་མ་ཐོབ་པའི་རྣལ་འབྱོར་བ་ཞིག་འཇོག་ཚུལ་ཕལ་ཆེར་མེད་པ་ལྟ་བུར་གསུངས་འདུག།",
    "དེ་ལྟ་བུའི་སྲིད་པ་དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པའམ་དེས་དག་པ་ནི་ཚིག་རྐང་དང་བོས་བསྟན།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནེ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "ཕྱི་མ་ལ་ཉན་ཐོས་བཅུ་དྲུག་དང་རང་རྒྱལ་བཅུ་གཉིས་སྤེལ་མའི་ཚུལ་དུ་ཡོད་ཅིང་།",
    "གཞན་ཡང་འདྲ་མིན་ཅི་རིགས་ཡོད་པས་མཐའ་གཅིག་ཏུ་འདི་ཡིན་ཞེས་ཁ་ཚོན་གཅོད་དཀའ་བ་ལྟ་བུར་འདུག།",
    "འདི་དོན་འགྲུབ་གྲུབ་ཡིན་པས་འོད་དཔག་མེད་ལྟ་བུ་ཞིག་ཏུ་འདུག་པས་དོན་འགྲུབ་ཀྱི་འོད་དཔག་མེད་ཡིན་འདྲ་གསུངས། ༡༣",
    "སྲིད་པ་ཐ་མའི་ཚེ་སྔགས་ལམ་ལ་འཇུག་དུས་འོད་གསལ་གྱི་རིམ་པ་ནས་འཇུག་ཀྱང་རིམ་པ་བཞི་བའི་དོན་འོད་གསལ་ནས་འཇུག་པ་མིན་གསུངས་སོ།",
    "དེའི་འདུག་པ་ཟེར་བ་ཞི་གནས་ཀྱི་གསོ་སྦྱོང་།",
    "འདུག་པ་སོགས་མི་རུང་།",
    "ན་བ་དང་སྡོམ་པའི་བར་ཆད་དུ་འགྱུར་པ་སོགས་ཀྱི་རྐྱེན་ཡོད་ན་འདུན་པ་ཡོངས་དག་སོགས་མ་ཕུལ་ཀྱང་མ་འདུས་པའི་མི་མཐུན་པ་མི་བསྐྱེད་ཅིང་རང་ལ་གསོ་སྦྱོང་མ་བྱས་པའི་ཉེས་པ་སོགས་མི་བསྐྱེད།",
    "མཚམས་ནང་དུ་ཡོང་བ་ཞིག་གསོ་སྦྱོང་ལ་འོང་མ་ཐུབ་ན་ལས་ལ་མི་མཐུན་པ་མི་བསྐྱེད་པའི་ཕྱིར་འདུན་པ་དང་རང་ཉིད་ཀྱིས་གསོ་སྦྱོང་མ་བྱས་པའི་ཉེས་པ་ཁེགས་ཕྱིར་ཡོངས་དག་སྟེ་གཉིས་ཚོགས་འབུལ་དགོས།་",
    "དགེ་སློང་དག་དབྱར་གྱི་ནང་དུ་ལྗོངས་རྒྱུ་ཞིང་འགྲོ་བ་མཐོང་ནས་མུ་སྟེགས་པ་རྣམས་ཀྱིས་བྱིའུ་ཁུག་རྟ་ཡང་དབྱར་ཚང་ནང་ན་ཞུམ་ཞུམ་པོར་བྱས་ནས་འདུག་ན།",
    "རྩ་ཤེས་ཊཱིཀ་ཆེན་ལས་བུམ་པའི་ནམ་མཁས་བུམ་པ་ལ་གོ་འགོག་པར་གསུངས་ཡོད་ཀྱང་རང་ངོས་ནས་གྲུབ་པ་འགོག་ཆེད་ཙམ་ལས་སྤྱིར་མིན་ནམ་གསུངས།",
    "རང་ཚིག་འགལ་ཚུལ་ལ་གཉིས་ཡོད་པར་གསུངས་པ་ནི་རང་ཚིག་སྔ་ཕྱི་འགལ་བ་དང་རང་ཚིག་དངོས་ཤུགས་འགལ་བ་གཉིས་ཡིན་ལ།",
    "མཁས་པར་གྲགས་ཀྱང་རང་བཞིན་སྨྲ་བ་དང་།",
    "དེས་ན་དྲི་མེད་པའི་ལུགས་ལ་ཤེལ་གོང་རས་སྔོན་པོའི་སྟེང་དུ་བཞག་པ་ན་ཤེལ་དེ་སྔོན་པོར་སྣང་ཡང་སྔོན་པོར་གྱུར་པ་མིན་པ་བཞིན་དྲི་མས་སྒྲིབ་ཀྱང་རང་བཞིན་ལ་བསླད་པ་མེད་པར་འདོད།",
    "མཛོད་ལ་སྤྱིར་ཁ་ཆེ་བྱེ་བྲག་སྨྲ་བ་དང་རང་ལུགས་སློབ་དཔོན་དབྱིག་གཉེན་གྱི་ལུགས་སུ་བྱེད་དགོས།",
    "ཡང་ཚིག་ཐོས་པ་ཙམ་གྱིས་ནི་ཆོག་པར་མངོན་རྟོགས་རྒྱན་ལྟ་བུ་ལ་མཚོན་ན་སྐབས་དང་བོས་རྣམ་མཁྱེན་དང་གཉིས་པས་ལམ་ཤེས་སྟོན་པར་འདུག་སྙམ་པ་ལྟ་བུ་བརྗོད་བྱའི་སྤྱི་བམ་ཡིད་ལ་འཆར་དགོས་གསུངས་པ་ཡང་ཡོད།",
    "དེ་ཡིན་ཀྱང་ལོས་ཡིན་ཏེ།",
    "འདི་ལྟར་བྱ་བ་བྱས་སོ་སོགས་གསུངས་པ་ལྟར་དོན་ལྡན་ལོས་ཡིན་ཀྱང་།",
    "རྒྱལ་ཚབ་ངས་ངའི་མགོ་ལ་ལྟོས་དང་ཉན་ཁོམ་ཨེ་འདུག་གསུངས་པ་ལྟར།",
    "ཞི་གནས་ཀྱི་གནས་ཆ་ཁོ་རང་གསལ་ཆ་ལྷག་མཐོང་དུ་སྔ་རབས་ལྟར་མིན་པར་གསུངས།",
    "སྡིག་ལྟུང་རང་བཞིན་མེད་པ་ལ་ངེས་ཤེས་བསྐྱེད་ན་འདག་སླ།",
    "རྟོགས་ལྡན་པ་ལ་འགྲོ་འདུག་སོགས་འཕྲལ་གྱི་སྤྱོད་ལམ་ཚུན་ཆད་ལུང་སྟོན་ཅིང་།",
    "བ་ཉལ་ལུགས་ལ་བེའུ་ཤི་ཐག་ཆོད་འདུག་ཅེས་དང་ལེན་མ་གནང་གསུངས།",
    "པདྨའི་འདུག་སྟངས་སོགས་དང་བོར་ངེས་ཅན་དུ་དགོས།",
    "ཀེ་རིའི་བྲག་ལ་ཡིག་དྲུག་དང་རང་བྱོན་ལྔ་ལྡན་སོགས་ཐོག་མར་བྱོན།",
    "ཚིག་འགྲེལ་སྐབས་རང་ལུགས་དང་མཐའ་དཔྱོད་སྐབས་གཞན་ལུགས་བཞག་པའང་ཡོད་པས་གསེར་འཕྲེང་རང་ལུགས་ངོས་ཟིན་དཀའ།",
    "དག་དང་རང་ལས་དེ་ལས་གཉིས།",
    "བུམ་པའང་ཁོ་རང་འདྲེས་མེད་དང་།",
    "དེ་ལྟར་ཁྱེད་རང་ཁྲོ་བོ་ཆེན་པོར་གསལ་བའི་མདུན་དུ་བེ་ཌཱུརྻའི་བྲག་རིའི་ཁྲོད་དུ་ཞེས་སོགས་ནས།",
    "ན་མ་སྟུ་ཏེ་མ་ཧཱ་རུ་དྲ་པ་ཙ་ནཱ་ཡ་སྭཱ་ཧཱ།",
    "རྡོ་རྗེ་འཆང་རང་ཉིད་ནས་ཀྱང་ཟ་བྱེད་མཁའ་འགྲོའི་སྦྱིན་སྲེག་དང་དམ་ཚིག་རྡོ་རྗེའི་བཟླས་པ།",
    "རྗེ་གཅིག་ཆོག་ཁྱེད་རང་མཁྱེན་ལགས་པས།",
    "ཁོང་པ་སྐུ་ན་བགྲེས་ཤིང་བསྙུན་ཧ་ཅང་ལྕི་བས་སྐུ་ཚེའི་མཐར་གཏུགས་པ་ནའང་ཐུགས་དམ་དགེ་སྦྱོར་སོགས་མ་ཆག་པ་མཛད་བཞིན་པའི་ངང་ནས་གཤེགས་འདུག།",
    "ཐོ་ཡོན་དར་རྒྱས་ནས་བསྐུལ་མ་ཞུས་ངོར་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཀུན་གསལ་ཤེས་རབ་མཆོག་སྦྱིན་ཞེས་པ་དང་།",
    "བྱང་ལྷ་རྩེ་བ་བཅས་བྱུང་འདུག།",
    "སྐུ་མཚམས་གྲོལ་རྗེས་གོང་མ་ཆེན་པོའི་བཀས་མངགས་པའི་མི་དྲག་ཡུ་ཨ་ས་ཧན་ཨམ་པ་སོགས་དཔོན་ཁག་གསར་འབྱོར་རྣམས་ཀྱི་གདོང་གསེར་ཡིག་གནང་རྟེན་དང་བཅས་འདུག་པ་བཞེས་ཤིང་མི་དྲག་རྣམས་ལ་དཀར་སྤྲོ་སོགས་རྒྱས་པ་སྩལ།",
    "འཕྲལ་གྱི་འདོད་ཡོན་ཟ་ཟིར་ཐམས་ཅད་ལ་བདག་དེ་རིང་རང་ཡང་མི་འཆི་བའི་ཆ་མེད་པ་ལ་འདི་དག་བྱུང་བས་ཅི་རང་བྱེད་སྙམ་དུ་ཞེ་ནས་ཆགས་ཞེན་གྱི་འཆིང་བ་ལྷོད་གང་ཐུབ་དང་།",
    "བྱང་སེམས་དང་གསང་སྔགས་ཀྱི་སྡོམ་པ་ལ་དེང་སང་གཏམ་ཙམ་ཞིག་ལས་ལག་ལེན་བྱེད་མི་སྲིད་མཐའ་རུ་འདུག་པས་ན།",
    "དེང་སྔོན་ཆད་གྲུབ་པ་ཅང་གདའ་འམ།",
    "ཁྱེད་རང་ལུས་འདི་ལ་ཁུར་དུ་ལྟོས།",
    "ཚུལ་ཇི་ལྟར་འདུག་སྙམ་རྟོག་དཔྱོད་ངོས།",
    "གོང་མ་ཆེན་པོར་འཚམས་ཞུར་འགྲོ་མི་མཁན་ནང་ཚུར་འབྱོར་གྱི་གདོང་གསེར་ཡིག་རྟེན་བཅས་འདུག་པ་རྣམས་བཞེས།",
    "འདི་ལོ་ཆིབས་སྒྱུར་གནང་ཐུབ་པ་བྱུང་ན་བསྟན་འགྲོར་བཀའ་དྲིན་ཆེན་པོ་ཡོང་བ་འདུག་ཚུལ་གྱི་བཀའ་ལན་ཡང་འཕྲལ་མར་གནང་།",
    "གཉིས་སུ་ཝང་ཁོ་རང་ཡང་རིང་པོར་མི་ཐོགས་པར་རྐྱེན་ངན་གྱི་ལམ་དུ་འགྱུར་བའི་ལྟས་སུ་མངོན་ནོ།",
    "འཆི་བདག་དུས་ཀྱི་ཕོ་ཉས་མདུན་བསུས་པའི།",
    "སེམས་དཔའ་སྤྲུལ་པའི་སྐུ་ནས་གསོལ་བ་བཏབ་པ་བཞིན་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་།",
    "རང་གཞན་མང་པོ་འཕུང་བའི་ཐབས་ཚུལ་ལ་རིངས་པ་ལྟ་བུ་ཞིག་བྱེད་ཡོད་འདུག་པ།",
    "ལས་ཀྱི་རིག་སྔགས་ཀྱིས་རྨོངས་པ་ལྟ་བུས་བཀའ་ལ་བརྩི་བ་ཞིག་མ་བྱུང་འདུག་ཀྱང་།"
  ]
}