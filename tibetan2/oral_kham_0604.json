    "རྩེ་ཕྱག་ཇོ་ལགས་དང་འགྲན་ཡ་མི་འདུག་འདི་འདྲའི་ཆ་འགྲིག་པོ་ཞེས་རྩེ་ཕྱག་ཇོ་ལགས་ཚོའི་སྐེད་རག་མདུན་ཕྱོགས།",
    "ཡ་རབས་པ་སོགས་གླེང་བ་མ་གཏོགས་ཚིག་ངན་ཙམ་ཡང་ཤོད་མཁན་མི་འདུག་ཉེ་སྔོན་ལྷ་ས་ནས་རྡོག་ཐོན་གྱིས་དགོངས་ཇར་འབྲོམ་ཐོད་དུ་འབྱོར་ཏེ་ཞག་སྡོད་བྱ་རྩིས་ཀྱང་ཞབས་པད་བོན་ཤོད་པ་ནས་ཕེབས་བྱམས་པ་འགོ་བྱིངས་དང་།",
    "གུས་ཚོའི་ཕ་གཞིས་རྒྱལ་སྟག་པའི་མིང་ཐོག་ཛ་སག་ངག་རྒྱལ་མི་མུས་རྒྱུད་བཅས་ལ་ཤོད་སྐོར་ཞབས་སྡོད་ཞུས་འཐུས་འཁོད་འདུག་པ།",
    "སྔར་འབྲས་ཁང་གཞུང་འཛིན་སྐབས་མི་འགྲོ་སོ་སོའི་སྒེར་ཤག་ཏུ་ལྷན་འཛོམས་ལས་ཀ་བྱེད་སྲོལ་འདུག་ཀྱང་།",
    "དེ་སྔོན་ང་རང་འབྲས་སྒྲུབ་གསར་པའི་སྐབས་འབྲས་ཁང་རྙིང་པས་ལོ་གཉིས་ཀྱི་རིང་འབྲས་འཚོང་རྒྱག་སྲོལ་སྐོར་ཡིག་ལམ་ཡོད་པ་ལྟར་བྱས་འཐུས་ཆོག་ཀྱང་།",
    "གཞན་ཡང་མི་མི་དམངས་དེ་ཚོ་ནི་སོ་དམངས་གང་འཚམས་བཅས་བསྡུ་བསྐོང་བྱས་འདུག་ཉུལ་དོགས་གཞི་ཡོད་རིགས་ཀྱི་གནས་ཚང་དང་།",
    "ལྷག་པར་མི་སེར་ཐེམ་དུད་སུམ་ཅུ་སོ་དྲུག་ལ་རྟ་ཁལ་འཕར་བསྐུལ་ཟ་བེད་བརྡབས་བསིགས་བྱུང་ལུགས་འཁོད་པའི་མི་སེར་རྣམས་ཀྱི་ཐེལ་འབྱར་ཞུ་ཤོག་གཅིག་དང་ཆབས་ཅིག་ཞུ་ལན་ཕུལ་འདུག་པས།",
    "ཤུད་ཁུད་གཞིས་སྡོད་པར་གཞུང་སའི་བཀའ་དྲིན་གྱིས་འཚོ་བའི་སྒེར་པ་ཞིག་ནས་གཞུང་བསམ་བོར་བའི་བྱ་ངན་ཚབས་ཆེར་བརྟེན་དོ་བདག་ངོ་མའི་ལུས་སྟེང་དུ་རྩེ་ར་གཅོད་དགོས་པ་འདུག་རུང་ད་ལམ་ཐེངས་གཅིག་རིང་ཡངས་བཟོས་གང་ཆེའི་ཉེས་པ་གསེར་སྲང་བཅོ་ལྔ་བསྒྲུབ་འབུལ་ཐོག་ས་གནས་སུ་ཡོད་པའི་ཚྭ་འབབ་རྣམས་གཞིས་རྩེར་འཕྲལ་དུ་བསྐྱེལ་འདྲེན་ཞུ་དགོས་པ་དང་།",
    "ལྷ་སར་ལས་བྲེལ་ཆེ་བས་རྩིས་ཁྲ་འདི་གར་བཀོད་ན་ལེགས་ལུགས་ཞུས་ཏེ་ཁོང་རང་བཞུགས་ཡུལ་དུ་ཟླ་བ་ཁ་ཤས་རིང་ལྷན་ཚོགས་ཀྱིས་གཏིང་སྐྱེས་འབྲས་ཁང་གཞུང་འཛིན་ལོ་གསུམ་གྱི་རྩིས་ཁྲ་ཁ་གསལ་ཁམས་དྭངས་ཞིབ་འགོད་བྱས་ཏེ་ལྷ་སར་འབྱོར་འཕྲལ་རྩིས་ཞུ་བྱས་ཆོག་ཆོག་བཟོས།",
    "བླ་བྲང་དུ་ཕེབས་སྒྲིག་གྲ་རྒྱས་ཕུན་སུམ་ཚོགས་པ་ཞུས་འདུག་ཀྱང་།",
    "བྲོ་གཞས་སོགས་ཕེབས་བསུ་ཕེབས་སྒྲིག་ཨང་སར་ཞུས་འདུག་ཀྱང་།",
    "ཇ་འཁོལ་ཏེ་དཀར་ཡོལ་ནང་བླུགས་ཙམ་ལ་ཁང་པའི་ཐོག་ཀར་སྡིག་སྒྲ་མང་པོ་བྱེད་འདུག་པ་གཡོག་པོས་བལྟ་བསྐྱོད་སྐབས་བཅིངས་འགྲོལ་དམག་མི་མང་པོ་ཐོག་ཀ་དང་།",
    "ཁང་པའི་མཐའ་བསྐོར་འདུག་ཟེར།",
    "གདོང་ཚྭ་སྒྲུབ་པ་འཕྱོད་ལ་བསྡད་ཡོད་ཚོད་འདུག་པས་དོ་དགོང་བང་མི་བཏང་སྟེ་སང་ཉིན་ཁོང་འབྱོར་འཕྲལ་མཉམ་འཁྲིད་ཀྱིས་བཅར་ཡོང་ཞེས་བཤད།",
    "ཉ་མགོ་གྲུ་གཉིས་ཀ་ཀླུ་ཁང་གྲུ་ཁར་འཁྲིད་འདུག་པ་ཚྭ་འབྲུ་དབོར་འདྲེན་བྱེད་ཆེད་ཀོ་བ་རོགས་རམ་ཡོང་བ་ཞེས་བརྗོད་པས།",
    "ལས་ཤོག་དོ་ལྔ་བཅས་ལྷུན་རྩེ་ཕོགས་ཁང་དུ་གནངས་ཉིན་འབྱོར་པ་དགོས་རྒྱུ་ཞེས་འཁོད་འདུག་པ་ཤོག་ཡུག་བཅུ་ལྟེབས་ཁ་ཤས་དང་།",
    "ཀུན་གླིང་ཛ་སག་ནས་ཁྱེད་རང་འབྲུག་ཡུལ་དུ་བསྐྱོད་དེ་ངའི་རྟ་སྔོན་པོ་དེ་འབྲུག་རྒྱལ་པོར་ཕུལ་ནས་བོད་མིར་རོགས་རམ་ཡོད་པ་ཞུ་དགོས་ཟེར་བས་འགྲོ་རྒྱུའི་ཁས་ལེན་བྱས་ཀྱང་།",
    "ཞབས་གྲས་སྤྱིར་ཐབ་ཆེན་ཚོ་གཅིག་བཅས་ཁག་གཉིས་ལས་མི་འདུག་གསོལ་ཐབ་སྐོར་མགྲོན་ཆེ་ཕ་ལྷས་བཀོད་སྒྲིག་བྱེད་ཀྱི་འདུག་པས།",
    "ང་རང་དེ་སྔོན་ཕེབས་བྱམས་འདེགས་འདྲེན་བྱེད་མྱོང་ཡོད་སྟབས་ཆུ་ཕྲག་སྟེང་དུ་སྐྱོན་མེད་བདེ་བགྲོད་ངང་ཁྱེར་ཏེ་བླངས།",
    "ད་ལྟ་དོན་གཅོད་ཁང་ནས་བཀའ་ཕེབས་དགོངས་དོན་འདི་དང་འདི་ཞེས་གསུངས་འདུག་ན་ཚང་མས་དགོངས་འཇགས་གནང་རོགས་གནང་ཞེས་གང་མཁས་མཁས་ཤོད་ཀྱི་ཡོད།",
    "ཕྲན་ངོ་གཡོག་གཉིས་ཕྱིར་ལོག་སྐབས་ལམ་བཟོ་ཚུགས་ཏེ་འཁོར་ལོའི་འགྲུལ་བཞུད་འགག་འདུག་པར།",
    "མེ་ས་མ་རིར་ཕྱིར་འབྱོར་སྐབས་ཀུན་གླིང་ཛ་སག་མ་སུ་རིར་བསྐྱོད་དགོས་བྱུང་འདུག་པས།",
    "བཟོད་བསྲན་ངག་འཇམ་གྱིས་ངས་ད་བར་དངུལ་གཉེར་ཞུས་པའི་རྩེས་ཁྲ་འཕྲལ་འབུལ་གྱིས་ཞིབ་རྩིས་ཞུ་བར་མ་བཅར་ཐབས་མེད་ཡིན་ཞེས་བརྗོད་ནས་ཁོ་རང་ཕྱིར་ལོག་འགྲོ་ཉིན་དེར་ཕྲན་རང་མེ་འཁོར་ནང་མ་སུ་རིར་བསྐྱོད།",
    "བྱས་ཙང་འགྲུབ་ཐབས་འདུག་གམ།",
    "ཟློས་གར་གསར་ཞུགས་མི་གྲངས་འཕར་སྟབས་ཕོགས་ཡོད་རྣམས་ཀྱིས་ད་ནི་བསྡུ་ཆ་རྒྱབ་ཐུབ་ཡག་མི་འདུག་ཇ་དང་བག་ལེབ་མཚམས་འཇོག་བྱེད་རོགས་ཟེར་ཡང་།",
    "ཏྲི་ཀ་སི་བཙོངས་རིན་ཧིན་སྒོར་ཉིས་སྟོང་བདུན་བརྒྱ་སྐོར་བྱུང་འདུག་པ་ནས།",
    "གཞན་ཡང་རྒྱ་གར་གྱི་དཔོན་རིགས་མང་པོ་སླེབས་འདུག་ཐོག་མར་འཁྲབ་སྟེགས་སྡིངས་ཆའི་ཡོལ་བ་མ་ཕྱེ་གོང་རྔ་ཆེན་དང་གླིང་བུའི་རོལ་དབྱངས་སྙན་འཇེབས་དང་ལྡན་པ་བཏང་།",
    "ཁྱེད་རང་སྔོན་ལ་ཕེབས་རོགས།",
    "ང་རང་ངོ་གཡོག་གཉིས་ཀ་སྦུག་ནས་རྡ་རམ་ས་ལར་ཐོན་བསྐྱོད་བྱས།",
    "གཡང་འཛོམས་གཉིས་དགོངས་པ་ཞུས་པ་མ་གཏོགས་དེ་བྱིངས་ཚང་མ་འགྲོ་རྒྱུ་ཡིན་ཟེར་འདུག་པར།",
    "འོ་ཙམ་དོ་གཉིས།",
    "ཌི་སིའི་ཧོམ་སེར་སླེབས་འདུག་ཟེར་དོན་ས་འདུ་རིན་ཆེན་དང་།",
    "དེའི་སང་ཉིན་མདའ་དཔོན་གྱིས་བཀའ་འཁྲོལ་བྱུང་ཞེས་པའི་ཡི་གེ་ཞིག་སྐྱེལ་བར་བཏང་འདུག་གྲྭ་ཆས་བཟོ་ཚེམ་བྱེད་རྩིས་ཀྱིས་རྡ་ཤོད་ཀྱི་ཚོང་ཁང་ཁག་ཚང་མར་ཕྱིན་ཀྱང་གྲྭ་ཆས་ཀྱི་ཚོས་གཞི་མཐུན་པའི་རས་ཞིག་རྩ་བ་ནས་རྙེད་མ་བྱུང་།",
    "ཁྱེད་རང་སྔོན་ལ་དགོངས་པ་འཁྲོལ་ན་མ་གཏོགས་ལམ་སེང་སྒྲུབ་རྒྱུ་འགྲིགས་མིན་གསུངས་བྱུང་བར་བཀའ་འཁྲོལ་བྱུང་ལུགས་ཞུས་པས།",
    "ཡར་ངོ་མར་ངོའི་ཚེས་བཅུ་བཅས་གང་ལེགས་ཡོད་འདུག་ཀྱང་།",
    "ང་རང་ནས་ལྷག་བསམ་ཟོལ་མེད་ཀྱིས་ལས་དོན་གང་ཅི་ཉིན་མཚན་ལྷོད་མེད་ཧུར་བརྩོན་ཆེ་བསྐྱོད་བྱས་ཡོད་ཀྱང་།",
    "དངུལ་བུན་སྤྲོད་འཇལ་བྱ་རྒྱུར་བསྡད་པ་འདི་ཐད་ཕྲན་ལའང་སེམས་འཚབ་འདུག་ཅིང་།",
    "གང་འདྲ་འདུག་གམ་ཞེས་བརྗོད་པར།",
    "རྒྱུན་ལས་ཁང་ནས་གཞུང་འབབ་སྲི་ཚགས་དགོས་གལ་ཆེ་ལུགས་གསུངས་ཏེ་དགོངས་བཞེས་མ་གནང་བ་དེར་ང་རང་ཡང་བློ་ཕམ་བྱུང་།",
    "གང་བྱས་ཀྱང་ཐ་ཞན་ཉམ་ཐག་ཆགས་རྒྱུར་ངེས་འདུག་སྙམ་ནས་ཡིད་མུག་སྐྱོ་སྣང་ཞིག་འཆར་བྱུང་།",
    "མ་འཁོད་པ་གང་འདུག་ཅེས་དྲིས་པར།",
    "ང་རང་གཟུགས་ཁམས་རྒྱུན་གཅོང་ཡིན་རུང་དཀའ་ངལ་ལ་མ་འཛེམས་པར་བསླབ་ཆོག་ཅེས་བཤད།",
    "ཕེབས་བསུའི་ཞུ་སྒོ་སེར་སྦྲེང་བྲོ་གཞས་སོགས་གང་ཅི་གཟབ་གཟེངས་ཨང་བསར་དགོས་རྒྱུ་ཞེས་གསལ་འདུག་པས།",
    "བརྒྱ་དཔོན་དང་བཅུ་དཔོན་སོགས་ནས་ཡག་པོ་ཞེ་དྲག་འདུག་ཐུགས་རྗེ་ཆེ།",
    "ཕེབས་བར་བསྐྱོད་དེ་ཚེས་ཆ་གཏན་འཁེལ་གྱིས་ཕྱིར་ལོག་སླེབས་འདུག་ཅིང་བསུ་ཞུ་ཕྱོགས་གྲོས་བསྡུར་གྱིས་གཞིས་ཆགས་འགོ་འཛིན་སོགས་འབྲེལ་ཡོད་མི་སྣ་ཁག་དང་།",
    "དབུ་ཞྭ་འདི་འདྲ་ལམ་དུ་བསྐྱུར་འདུག་ལ།",
    "སྐྱོན་བྱུང་མི་འདུག་གསུངས་བྱུང་ཡང་།",
    "ན་བཟའ་ཟན་ཤམ་རྙིང་ཧུལ་འདི་འདྲས་རྩ་བ་ནས་ཡོང་བ་མི་འདུག་ངས་ཁྲོམ་ལ་ཕྱིན་ནས་གསར་པ་ཞིག་ལམ་སེང་བཟོ་མངགས་བྱས་ཆོག་བརྗོད་བྱུང་ཡང་།",
    "འཚོ་བའི་བལྟ་སྐྱོང་སོགས་གང་ཅིར་ཕུན་སུམ་ཚོགས་པོ་བྱུང་ཡོད་སྟབས་གཙོ་ཆེར་མི་སྨོན་རང་སྐྱིད་ཀྱི་དུས་སྐབས་བཟང་པོ་ཞིག་བྱུང་འདུག་པས།",
    "བརྟག་དཔྱད་སྐབས་གཞི་རྐང་སྤྱོད་པ་གྱོང་ཙམ་འདུག་རུང་།",
    "སྒྲིག་འཆལ་ལང་ཤོར་དུ་གྱུར་འདུག་པ་དེ་དག་ཕག་པ་དབྱར་ལམ་དུ་འཇུག་རྒྱུ་ཤིན་ཏུ་དཀའ་བའི་གནས་སུ་གྱུར་འདུག་པ་དཔེར་ན།",
    "གལ་ཏེ་ཟློས་གར་ནས་ཁ་བྲལ་དགོས་བྱུང་ན་སྤྲང་པོ་བྱ་རྒྱུ་ལས་མེད་ཅེས་འུ་ཐུག་སྨྲེ་ངག་འདོན་གྱི་འདུག་པ་དེ་ཚོ་དངོས་གནས་ཁག་མི་འདུག་སྙམ་པ་བྱུང་།",
    "གཅིག་ནི་ང་རང་མགོན་ཁང་པ་འཆམ་པའི་གྲས་ཤིག་ཡིན་ནའང་བར་སྐབས་ལོ་མང་རིང་འཆམ་མ་འཁྲབ་པའི་ཁར།",
    "བསམ་བློ་ཞིབ་གཏོང་སྐབས་སྡོད་གནས་རིམ་པ་མཐོ་དམའ་ཙམ་ལ་ཁྱད་པར་མི་འདུག་སྙམ་སྟེ་མུ་མཐུད་བསྡད།",
    "ན་ཟུག་ཀྱང་ཆུང་དུ་ཕྱིན་འདུགའོན་ཀྱང་ཨེམ་རྗེས་བཤགས་བཅོས་མ་བྱས་པར་ན་ཚ་དྲག་སྐྱེས་ཡོང་ཐབས་མི་འདུག་ཟེར་ཡང་།",
    "དངུལ་འབབ་དེ་ཡང་འཕྲེང་རིང་ལྕམ་ཆུང་ཁོ་རང་ནས་གནང་སྟེ་སྐྱིན་ཚབ་མི་དགོས་གསུངས།",
    "བུ་ཕྲུག་རྣམས་ཡིད་སྐྱོའི་ངང་གནས་འདུག་པ་ང་རང་ཡང་བློ་ཕམ་དང་།",
    "སྤྱི་ཟླ་ཚེས་ཉིན་བལ་བོད་ས་མཚམས་འགྲམ་དུ་འབྱོར་པ་ཡོང་རྒྱུ་ཞེས་འཁོད་འདུག་པ་བཞིན་སྤྱི་ལོ་ལོའི་ཟླ་ཚེས་ཉིན་ཤག་ལྷོའི་བུ་བཀྲ་ཤིས་ནོར་བུ་ངེད་གཉིས་བུ་གཉིས་བསུ་བར་བསྐྱོད་ཅིང་།",
    "ད་ལྟ་རྒྱ་གར་གཞུང་ལ་འབུལ་རྒྱུ་བྱུང་མི་འདུག་དེ་རིང་རང་ཕུལ་ཆོག་པ་དགོངས་འགལ་མེད་པ་ཞེས་ཟེར་བར།",
    "བུ་གཉིས་ནས་ངོས་གཉིས་རྒྱ་གར་དུ་འགྲོ་བར་དགོངས་ཞག་དུས་ཚོད་མང་པོ་མེད་པ་དང་།",
    "ང་རང་སྒེར་གྱི་བསམ་འཆར་བྱས་ན་རྒྱ་གར་ལ་མ་ཕེབས་ན་ལེགས་ལུགས་གསུངས་འདུག་པ་དེ་ལྟར་བརྗོད་བབས་དང་།",
    "ང་རང་དངོས་རིགས་རྣམས་སྲུང་ཞིང་བསྡད།",
    "དེ་ནི་གཞུང་བཞེས་གནང་འདུག་སྤུན་མཆེད་གཅིག་བར་སྐོར་ནང་ཡོད་པ་དེའི་སར་འགྲོ་རྩིས་ཡིན་ཡང་།",
    "དེར་ཡང་སྒོ་ཐེལ་ཕོག་འདུག་བྱས་ཙང་ངའི་བུ་གནས་ཚང་འཚོལ་བར་བཏང་བས་ད་ལྟ་འབྱོར་མ་བྱུང་སྒུག་བསྡད་ཡོད་ཅེས་བརྗོད་པར།",
    "ཕྲན་སླེབས་པ་དང་ཁོང་རང་བཞུགས་སའི་སྐུ་རྒྱབ་ནས་ཤིང་ཤོག་སྦར་གང་ལྕགས་ཐབས་དེར་བླུག་སྟེ་མེ་སྤར་ནས་ཇ་ཐང་ཚ་པོ་བཟོས།",
    "ཁྱེད་རང་དགུང་ལོ་མཐོ་ཡང་རྩ་བའི་སྐྱོན་ཡིན་པས་ངེས་པར་དུ་བཞེས་དགོས།",
    "ཡག་པོ་འདུག་གསུངས་བྱུང་བར།",
    "གུས་པའི་ཁྱིམ་ནི་གཞུང་བཞེས་ཁོངས་ཚུད་འདུག་པ་སྤུན་མཆེད་གཅིག་ཡོད་པ་དེར་འགྲོ་རྩིས་བྱས་པ་དང་།",
    "བློ་ཕམ་ཆེ་ཤོས་ཤིག་ལ་གདན་ས་རི་བོ་དགའ་ལྡན་རྟེན་དང་བརྟེན་པ་བཅས་པ་རྩ་བརླག་གྱང་རོ་ཟིང་ངེར་གྱུར་འདུག་པ་ཤིན་ཏུ་བློ་ཕམ་ཆེན་པོ་བྱུང་ཡང་།",
    "བར་སྐབས་ཆང་རག་བཏུང་ཆེས་པའི་རྐྱེན་གྱིས་ཁམས་རིགས་ཁ་ཤས་ནས་ཆང་འཐུང་ར་རོས་ཀྱིས་འཁྲུགས་འཛིང་གྲི་འཛུགས་བྱས་ལུགས་གོ་ཐོས་ཙམ་ལས་དེང་སང་ནི་ཁུ་སིམ་ཞོད་འཇགས་བློ་བག་ཕེབས་པ་འདུག་ལྷག་པར་ལྷ་ལྡན་གཙུག་ལག་ཁང་དུ་ཟླ་བ་ཡར་ངོ་མར་ངོ་གསོ་སྦྱོང་དང་།",
    "མི་དམངས་ཀྱི་འཚོ་བ་བར་སྐབས་ལོ་མང་རིང་དཀའ་ངལ་ཅི་ཆེ་བྱུང་འདུག་ཀྱང་།",
    "ལྷག་པར་རྒྱལ་ཁབ་ཀྱི་དཔྱ་ཁྲལ་དམིགས་བསལ་གྱི་ཆག་ཡང་གནང་བའི་ཐུགས་རྗེས་སྐྱེ་བོ་ཐམས་ཅད་བདེ་སྐྱིད་ཀྱི་འགོ་ཚུགས་པ་ལྟ་བུ་བྱུང་འདུག་པ་བདེ་སྐྱིད་ཡུན་དུ་གནས་པའི་སྨོན་འདུན་ཞུ་རྒྱུ་ཡིན།",
    "ཁྱེད་རང་ལ་འགྲོ་གྲོན་གཏོང་དམིགས་ཡོད་དམ་ཞེས་དྲིས་བྱུང་བས།",
    "ང་རང་ལ་འགྲོ་གྲོན་གཏོང་དམིགས་མེད་ཀྱང་ཕྲུ་གུ་ཚོ་དང་།",
    "དེའི་སང་ཉིན་ནས་སེར་དགོན་གྲྭ་ཤག་ཉམས་གསོ་ཞུ་བྱ་མང་བས་འུལ་མི་རྣམས་ཁོམ་ལྕོགས་མ་བྱུང་སྟབས་ང་རང་བློ་བསྟན་དང་།",
    "འོན་ཀྱང་ང་རང་དང་།",
    "དེ་འདྲ་མ་ཟེར་ཁྱེད་རང་རྒྱལ་གཅེས་མི་སྣ་ཡིན་གཤིས་བསམ་ཤེས་རྒྱབ་སྐྱོར་ཞུ་རོགས་བྱས་ཆོག་གསུངས་པ་བཞིན་བསྐྱར་སྙན་ཕུལ་བ་གཤམ་གསལ།",
    "ལོ་ལྟར་ལོ་གསར་ལ་དགོས་མཁོ་རང་རང་འཇོན་ཐང་ལ་གཞིགས་པའི་ལས་ཟུར་གསོས་དང་།",
    "ཟིང་ཆ་ཚབས་ཆེན་བྱུང་བ་གོ་ཐོས་ལ་ང་རང་ཡང་ཧ་ཅང་བློ་ཕམ་ཆེན་པོ་བྱུང་།",
    "སྐབས་ག་དུས་ལོ་སྐབས་ནས་སྲིད་གྲོས་གཉིས་པའི་གྲོས་ཨུ་ཡོན་བྱས་པ།",
    "འདུག་པ་ལོ་ན་རྒས་པའི་རྟགས་འདྲ།",
    "ད་ལམ་ལོའི་ཟླ་ཚེས་ཉིན་ལྷ་སར་ཟིང་ཆ་བྱུང་བ་དེར་ཁྱེད་རང་ལ་བསམ་ཚུལ་དང་མཐོང་ཚུལ་ཇི་ཡོད་དྲི་བརྩད་གནང་བྱུང་བར།",
    "ཁྱེད་ཀྱི་བུ་ཕྲུག་ཚང་མ་བོད་དུ་ཡོད་པར་བརྟེན་ཁྱེད་རང་རང་ཡུལ་ལྷ་སར་གཏན་སྡོད་གཞིས་ཆགས་སུ་བསྡད་ན་གང་ལེགས་ཡོང་རྒྱུ་དང་།",
    "ལྕགས་རི་གཞིག་རལ་སོགས་ཉམས་ཆགས་གྱུར་ཡོད་ཚོད་འདུག་པས་ཐུགས་འཁུར་ཆེ་བཞེས་ཀྱིས་ཉམས་གསོ་གསར་རྒྱག་འཕྲལ་དུ་གནང་སྐྱོང་ཞུ་རྒྱུ་དང་།",
    "འོ་ན་བོགས་མར་བཏང་ན་ཡར་རྒྱས་ཆ་ཚང་གཏོང་རྒྱུར་ཁས་ལེན་བྱེད་མི་འདུག་གཤིས།",
    "རང་རང་ལུས་གཟུགས་འཁྲུས་ལ་དག་པར་བསྟེན།",
    "ཆུ་ཚན་ལ་ཕེབས་མཁན་ཚོ་བཞུགས་ཡུལ་ཁང་མིག་ཆེ་ཆུང་ལྔ་འདུག་པའི་ནང་ས་ཁྲི་དང་།",
    "ཆུ་གཏེར་སོགས་ཁྱད་དུ་འཕགས་པའི་ནོར་གཏེར་དུ་མཛད་པ་རྣམས་གོང་མའི་བཀའ་བརྒྱུད་གདན་རབས་རིམ་བྱོན་གྱིས་ཁག་གཅིག་གཏེར་ནས་བཞེས་པའི་གཏེར་ཁུང་དང་རང་བྱོན་གཏེར་དངོས་རྣམས་གནས་རིར་ཕེབས་སྐབས་རིམ་བཞིན་མཇལ་རྒྱུ་ཡོད།",
    "ཆུའི་གཏིང་དུ་འདག་རྙོག་སྔོ་ནག་ཧ་ཅང་མང་པོ་ཞིག་འདུག།",
    "འབྲུ་ལ་སྲང་བརྒྱད་བྱེད་ཀྱི་མི་འདུག་གམ་ཞེས་སྐད་ཆེན་པོས་ལན་སློག་ལུགས་གོ་ཐོས་བྱུང་།",
    "འབྲུ་ལ་སྲང་བརྒྱུད་བྱེད་ཀྱི་འདུག་རྒྱལ་པོ་ལགས།",
    "ཇ་ལ་སྲང་དོ་བྱེད་ཀྱི་འདུག་སྲིད་བློན་ལགས།",
    "སེར་སྐྱ་མི་དམངས་ཀྱི་འཛིན་དགོས་པ་སོགས་ཧ་ཅང་དཀའ་རྙོག་ཆེ་ཞིང་གྱོན་གོས་ཞྭ་ལྷམ་སོགས་ཐབས་སྐྱོ་ཙམ་གནས་འདུག་རུང་།",
    "པ་གོར་བེེ་རོ་ཙ་ན།",
    "བླ་སྤྲུལ་གྱི་ཕྱིའི་ཀུན་སྤྱོད་ཅི་འདྲ་ཡིན་ཡང་དེ་ལ་དོ་སྣང་བྱེད་དགོས་མི་འདུག་སྟེ།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "ནམ་རྒྱུན་ཡལ་དུ་མེད་པའི་འཛུམ་དཀར་གྱིས་ཁེངས་འདུག།",
    "ནམ་ཡང་ཡལ་དུ་མེད་པའི་འཛུམ་དཀར་གྱིས་ཁེངས་འདུག།",
    "མེད་པར་གང་དགར་བཀྲམ་ཏེ་འདུག་གོཁོའི་འཚོ་བའི་ཆ་རྐྱེན་ནི་ལ་འདི་ཀའི་རིང་ལ་ཟས་གོས་གཉིས་ཐད་ནས་དཀའ་ངལ་མེད་པ་ཙམ་དང་།",
    "དུས་དེ་ནས་བཟུང་ཁོ་རང་ལོ་མ་དམར་པོ།་",
    "དུས་དེ་ཙ་ན།",
    "དམིགས་ཡུལ་གྱི་སྟེང་ནས་ཚེ་ཕྱི་མའི་མངོན་མཐོ་ངེས་ལེགས་ཀྱི་དོན་དུ་དམིགས་པ་ཞིག་ཡིན་དགོས་འདུག་དེ་མིན།",
    "བདེ་ཆེན་འོད་ཕུང་དང་འདྲེས་འདུག།",
    "གཞན་མགོ་གཡོག་ཅིང་རང་མགོ་གཅོག་བྱ་བ་ཀུན་ལ་གཏད་སོ་མེད།",
    "ཁྱུར་མིད་གཏོང་ཤུལ་ན་ལུས་འདུག་པ་ནི།",
    "ད་ནས་བཟུང་དེ་བས་ཇེ་ངན་དུ་འགྲོ་རྒྱུ་ལས་ཡར་རྒྱས་སུ་འགྲོ་བ་དཔེ་མི་སྲིད་པ་ལྟ་བུ་ཡིན་པས།",
    "མི་རིགས་ཀྱི་སེམས་ཁམས་དང་རང་གཤིས་སྲུང་འཛིན་བྱེད་རྒྱུར་ཕན་པའང་ཡོད།",
    "ཁྱེད་རངརྣམས་ཀྱི་ལུས་ལ་ལེག་པས་རྣམ་སྨིན་ཤ་ཁྲག་རྡོས་བཅས་ཀྱིས་མཚོན་པའི་མ་དག་པའི་སྣང་བ་ཐམས་ཅད་མི་དམིགས་པའི་སྟོངཔར་སྦྱར།་",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་གཏོར་བས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཁ་སྒོ་ནས་ཞུགས།",
    "སྒྲོལ་དཀར་ཡིད་བཞིན་འཁོར་ལོཞུ་བ་ལས་བྱུང་བའི་བུམ་པའི་ཆུས་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་རྐང་མཐིལ་གྱི་བར་ཕྱི་ནའབར་གསུམ་ཐམས་ཅད་ཁྱར་པརའཀྱུས་པས།",
