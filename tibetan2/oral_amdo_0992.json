    "བུད་མེད་ཀྱི་ཡུལ་ཞེས་བྱ་བ་ནི།",
    "མིའི་བུད་མེད་ལེགས་པར་སྨྲས་པ་དང་ཉེས་པར་སྨྲས་པའི་དོན་ཀུན་ཤེས་པར་ནུས་པ་ལ་ཉེས་པ་དང་།",
    "སྤྱིའི་མཚན་ཉིད་དང་རང་གི་མཚན་ཉིད་དང་དཔེའི་ཚིག་ཡོངས་སུ་བརྗོད་པའོ།",
    "ཀུན་ནས་སློང་བ་ལས་ཉོན་མོངས་པའི་ཕྱིར་གནས་ངན་ལེན་ཏོ།",
    "རང་གི་མཚན་ཉིད་ནི་འཁྲིག་པ་དང་ལྡན་པ་ཞེས་གསུངས་སོ།",
    "དགེ་སློང་ཆགས་པའི་སེམས་ཀྱིས་མིའི་བུད་མེད་དོན་ཀུན་ཤེས་པར་ནུས་པ་ལ།",
    "གཞི་དགུ་པོ་འདི་དག་ལས་གཞི་རེ་རེ་དང་།",
    "ཆེན་མོ་ཡིན་ཡང་དོན་ཀུན་ཤེས་པར་མི་ནུས་པ་དང་།",
    "དེ་བཞིན་དུ་བུད་མེད་ཀྱིས་དགེ་སློང་ལ་གཞི་དགུ་པོ་འདི་དག་གིས་ལྷག་པར་སྤྱད་ལ།",
    "དེ་ལ་བསྔགས་པ་ཞེས་བྱ་བ་ནི་ཁྱོད་ཀྱིས་རྨའི་སྒོ་གསུམ་པོ་ནི་ལེགས་པར་དོད་པའོ་ཞེས་ཟེར་བའོ།",
    "བསྔགས་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ནི་ཁྱོད་ཀྱི་རྨའི་སྒོ་གསུམ་པོ་ནི་ལེགས་པར་དོད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བའོ།",
    "བདག་གི་དགའ་བ་དང་ཡིད་དུ་འོང་ངམ་ཞེས་དགའ་བ་སྟོན་པ་སྟེ།",
    "འདྲི་བ་ནི་བུད་མེད་ལ་གང་འདི་བྱེད་པ་དེ་ལ་དེ་དགའ་སྟེ།",
    "ཡོངས་སུ་འདྲི་བ་ཞེས་བྱ་བ་ནི་བུད་མེད་ལ་གང་འདི་བྱེད་པ་དེ་དགའ་བར་འགྱུར་ཏེ།",
    "བདག་གིས་ཀྱང་བྱས་ན་དགའ་བར་འགྱུར་རམ་མི་འགྱུར་ཞིག་གུ།",
    "འདི་ལ་ཁྱོད་ཅི་སྙམ་དུ་སེམས་ཞེས་ཟེར་བའོ།",
    "བརྗོད་པ་ནི་ག་གེ་མོ་ཞེས་བྱ་བ་ཞིག་བདག་དང་འདི་ལྟ་བུ་བྱས་སོ།",
    "དེར་གལ་ཏེ་ཁྱོད་ཀྱང་འོང་བ་ལྟ་ན་ཁྱོད་དང་ཡང་བྱའོ་ཞེས་ཟེར་བའོ།",
    "སྨོན་པ་ནི་སྲིང་མོ་དང་ལྷན་ཅིག་གལ་ཏེ་འདི་བྱས་ན་བདེ་བར་འགྱུར་ཞིང་མཐོ་རིས་ཐོབ་པར་འགྱུར་ཞེས་ཟེར་བའོ།",
    "གཤེ་བ་ཞེས་བྱ་བ་ནི་མགལ་དུམ་དང་བོང་བུ་དང་རྟོལ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཤེ་བའོ།",
    "སྤྲིང་ཡིག་གིས་དང་།",
    "ལག་ཡིག་གིས་དང་།",
    "ཁྱོད་ཀྱི་རྨའི་སྒོ་བཅད་པ་ཞེའམ།",
    "དེ་བཞིན་དུ་སྲིང་མོ་ནས་བྱིན་ཅིག་ཅེས་བྱས་ལ་དེས་ཀྱང་བརྡ་ཕྲད་པ་དང་།",
    "དགེ་སློང་མ་ལ་འདོད་པ་དང་རྗེས་སུ་མཐུན་པའི་ཆ་བྱད་ཅན་ཞིག་མཐོང་ནས་སྲིང་མོ་སྐྱེས་པ་རྣམས་ལ་བརྟེན་པའི་ཚུལ་དུ་སྤྱད་པ་སྤྱོད་དུ་སོང་ཞེས་ཟེར་བ་དང་།",
    "བུ་མོ་ལོག་པར་སྤྱོད་པ་གལ་ཏེ་སྲུང་མི་ནུས་ན་མགལ་དུམ་གྱིས་བསྣུན་ན་ཅི་ཉེས་ཞེས་ཟེར་བ་དང་།",
    "གསོལ་བ་འདེབས་པ་ན་ཁྱོད་བོང་བུ་དང་།",
    "སྲིང་མོ་ཁྱོད་ཀྱི་མདུན་ན་མོ་གང་ཡིན་པ་དེ་བྱིན་ཅིག་ཅེས་ཟེར་བ་དང་།"
  ]
}