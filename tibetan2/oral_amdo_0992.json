    "ངན་སོང་བའི་ཁ་ན་མ་ཐོ་བ་བསྐྱེད་པའི་ཕྱིར་ཕམ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ངན་སོང་རྣམས་སུ་སྲེག་པ་དང་།",
    "དེ་བཞིན་དུ་དེ་ལས་གཞན་པའི་ཕམ་པར་འགྱུར་བདག་གིས་ཉེས་པ་སྦོམ་པོ་ཡང་བརྗོད་པར་བྱའོ།",
    "རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་ཡིན་པས་ཉོན་མོངས་པ་ཅན་ཉིད་དོ།",
    "དེ་ལས་གཞན་པའི་བསླབ་པའི་གཞི་རེ་རེ་ལ་ཡང་དང་པོའི་རྣམ་པ་བརྒྱད་བརྗོད་པར་བྱའོ།",
    "གཞི་དང་ཉོན་མོངས་དོན་ཉིད་དང་།",
    "ཉོན་མོངས་འགྱུར་དང་ཉོན་མོངས་མིན།",
    "གཞན་དག་གི་ཞེས་བྱ་བ་ནི།",
    "བླངས་ན་ཞེས་བྱ་བ་ནི་བདག་གམ་གཞན་གྱིས་བདག་གིར་བྱས་པའོ།",
    "ཀྱེ་མི་ཁྱོད་ཅེས་བྱ་བ་ནི་བརྙས་པའི་ཚིག་གོ།",
    "རྐུབ་ནི་ལས་དེ་གང་གི་ཕྱིར་རྐུ་བའོ་ཞེས་ཟེར་ཞིང་ཞེས་བྱ་བའོ།",
    "དེ་ཡང་ཞེས་བྱ་བ་ལ་ཡང་གི་སྒྲ་ནི་བསྡུ་བའི་དོན་ཏོ།",
    "སོང་ནས་མ་རེག་གི་བར་དུ་ནི་བཤགས་པར་བྱས་པའི་ཉེས་བྱས་སོ།",
    "རེག་ལ་གནས་ནས་མ་སྤགས་ན་ཉེས་པ་སྦོམ་པོའོ།",
    "གནས་གང་ནས་བླངས་པའི་ས་དེའི་རིན་ཐང་གིས་སོ།",
    "གལ་ཏེ་སྦྱོར་བ་གཅིག་གིས་ཚང་ནའོ།",
    "ཅི་སྟེ་མང་པོ་ཞིག་གིས་ཚང་བ་ནི་སྦྱོར་བའི་གྲངས་སྙེད་ཀྱི་སྦོམ་པོའོ།",
    "སྲང་གི་ཁར་བཟངས་ཀྱང་དེ་བཞིན་ནོ།",
    "རྐང་གིས་འགྲོ་བ་དང་།",
    "ཟུང་ཁྱོགས་དང་།",
    "ཁྱོགས་སྤྱིལ་དང་།",
    "ཞེ་སྡང་གི་ཕྱིར་ན་ཉེས་བ་སྡོམ་པོའོ།",
    "དེ་དག་གིས་བསྲུངས་པ་མ་ཡིན་པ་ཞིག་ལ་ལྷའམ་གནོད་སྦྱིན་ལ་སོགས་པ་མེད་དོ་སྙམ་པའི་འདུ་ཤེས་ཀྱིས་ན་ཉེས་པ་མེད་དོ།",
    "བརྟོད་པ་ལས་རྐུ་བ་སྟེ་ད་ལྟར་སྣང་གི་བར་དུ་ཉེན་ཀོར་རོ།",
    "རྒྱ་མཚོར་འཇུག་པའི་ཚོང་པ་དག་གིས་ཡོངས་སུ་གཟུང་བ་རྣམས་སོ།",
    "ཆར་མི་འབབ་པའི་ཚེ་བདག་གི་ཞིང་དུ་ཆུ་བཏང་སྟེ།",
    "གང་ན་ཆུ་བསྔོས་ཏེ་སྦྱིན་པ་དེར་གལ་ཏེ་མིའི་སྐལ་བ་བརྐུས་ན་དེ་ཉིད་ཀྱི་རིན་ཐང་གིས་དངོས་གཞིར་འགྱུར་རོ།",
    "གཞན་གྱི་ཞིང་གཅིག་གཙུག་ལག་ཁང་དང་བདག་གི་ཕྱིར་བརྐོས་པ་འདུ་བའི་སར་ཤགས་བཀྱེ་སྟེ།",
    "གལ་ཏེ་འགྱོད་དེ་ཁྱིམ་དེར་སོང་ནས་བག་ཡོད་པར་སྒྲུབས་ཤིག་ཅེས་བསྒོའམ།",
    "བསྒོ་སྐལ་བདག་གིར་མ་བྱས་ན་ཡང་དེ་བཞིན་ནོ།",
    "དགེ་སློང་རྣམས་ཀྱིས་བདག་གིས་གཞན་ལ་བཅོལ་ཏམ།",
    "གང་གིས་བྱས་པ་དེ་ནི་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "གང་དག་གིས་ཤོ་གམ་གཞལ་དགོས་པ་ཤོ་གམ་གྱི་སར།",
    "མ་ཕྱིན་པར་དེ་དག་གི་ཤོ་གམ་དེ་ལས་བྱོལ་བར་བྱ་བའི་ཕྱིར་ལམ་གཞན་བསྟན་ན་སྦོམ་པོའོ།",
    "དེ་དག་གི་བདག་གིས་སྐལ་བ་མ་བླངས་པར་བཟླས་ན་སྦོམ་པོའོ།",
    "བདག་གི་སྣོད་ཤོ་གམ་གཞལ་དགོས་པ་ཁྱེར་རམ་ཁྱེར་དུ་བཅུག་ན་དངོས་པོ་ཇི་ལྟ་བ་བཞིན་ནོ།",
    "བདག་གི་འདི་ནི་མ་ལ་སོགས་པའི་ཡིན་ནོ་སྙམ་དུ་བསྔོས་ལམ་སྨྲས་པར་ནམ་མཁའ་འམ།",
    "ཁྱེར་རང་གི་ནོར་ཤེས་པར་གྱིས་ཤིག་ཅེས་བྱའོ།",
    "རས་སར་པ་ཞིག་ན་ནི་ཐ་ན་ཁ་ཚར་དང་ཕུན་ཚར་བཅད་དེ་བ་ལང་གི་ལྕི་བ་བཙིར་བས་ཁ་བསྒྱུར་ལ་བསྐུར་བར་བྱའོ།",
    "ཁྱིམ་པས་མ་བསྒོ་བར་དེའི་ཚིག་གིས་དེའི་ཆུང་མ་ལ་བསླངས་ན།",
    "གང་གི་ཚེ་ཟུང་དང་བྲལ་བར་གྱུར་པ་དེའི་ཚེ་དངོས་གཞིའོ།",
    "བྱང་གི་སྒྲ་མི་སྙན་ན་ནི་ཡོངས་སུ་འཛིན་པ་མེད་པས་མ་བྱིན་པར་ལེན་པ་མེད་དོ།",
    "སྐྱེ་བོ་མང་པོའི་ནོར་རྐུ་ན་གཅིག་གི་སྐལ་བ་གང་ཡིན་པ་དེའི་ཚད་ཀྱིས་སོ།",
    "རྐུ་སེམས་ཀྱིས་གཟུང་ལ་བདག་གི་འདུ་ཤེས་ཀྱིས་སྤྱད་ན་སྦོམ་པོའོ།",
    "དེ་ལ་སྦྱིན་བདག་གི་སེམས་ཉེ་བར་གཞག་པར་བྱའོ།",
    "ཀཱཪྵཱ་པ་ཎའི་ཐ་སྙད་དུ་མི་བྱེད་པ་ཞིག་བརྐུས་ན་རང་གི་དངོས་པོའི་རིན་ཐང་བཞིན་དུ་བྱའོ།",
    "དེ་བཞིན་དུ་ཀཱཪྵ་པ་ཎ་བཟང་པོ་དང་མཐུན་པ་ཞིག་རྐུ་བར་སྦྱོར་བ་བྱེད་པ་ན་གལ་ཏེ་བདག་པོས་འདི་ནི་ངས་ཁྱོད་ལ་སྦྱིན་ནོ་ཞེས་སྨྲས་ལ།",
    "གཏམས་པ་བརྣོགས་ཏེ་ངེས་པར་བྱས་པའི་དུས་སུ་གལ་ཏེ་དངོས་པོ་ཡོད་པ་གཞན་དག་གི་མཉམ་པ་མེད་ན་དེས་པ་སྟེ་དངོས་གཞིའོ།",
    "བྱི་བས་ཁྱེར་བ་བདག་གི་གང་ཡིན་པ་དེ་བླང་གི་དེའི་མ་ཡིན་ནོ།",
    "དགེ་སློང་གི་རྫས་དགེ་སློང་ཡོད་ན་དགེ་སློང་མ་དང་མི་བགོའོ།",
    "གཞན་གྱིས་ཡོངས་སུ་བཏང་ན་གང་གིས་ཡོངས་སུ་མ་བཏང་བ་དེའི་ཡིན་པར་བྱིན་གྱིས་བརླབ་བོ།",
    "གཉི་ག་དག་གིས་ཡོངས་སུ་བཏང་ན་སྦྱིན་བདག་གི་ཡིན་ནོ།",
    "དེ་གང་གིས་ཕྲོགས་པ་དེའི་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འཕྲལ་དུ་ནན་ཁུགས་ཀྱིས་དགུག་པར་མི་བྱ་མོད་ཀྱི།",
    "འོན་ཀྱང་ཚིག་གིས་བསྡིགས་པར་བྱའོ།",
    "རྨ་མ་ཕྱུང་བར་བདག་གིས་རྨ་ཕྱུང་ངམ།",
    "གཞན་རྨ་འབྱིན་དུ་བཅུག་སྟེ་ཕྱག་དར་ཁྲོད་བླང་བར་མི་བྱ་མོད་ཀྱི་འོན་ཀྱང་གང་ཐ་ན་གྲོག་མས་རྨ་ཕྱུང་བ་ཡིན་ནོ།",
    "ཕྱག་དར་ཁྲོད་ཀྱི་གོས་མི་གཙང་བས་རེག་པ་མི་བསྲེལ་གྱི་ལེགས་པར་བཀྲུ་བ་དང་།",
    "གཉུག་མར་གནས་པ་དག་གིས་འགའ་ཞིག་འོངས་ན་སྦྱིན་པར་བྱའམ་ཞེས་དྲི་བར་བྱའོ།",
    "གཙུག་ལག་ཁང་སྐྱོང་གིས་སྒོ་གཏན་མ་བཅུག་སྟེ།",
