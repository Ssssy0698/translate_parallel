    "ཨོཾ་ཨ་མྲྀ་ཏ་སྭཱ་ད་ན་སྭ་བྷ་ཝ་ཨཱཏྨ་ཀོཉ་ཧཾ།",
    "ཨོཾ་སམྦྷ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ་བཛྲ་ཝ་ན་ནི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱཧཱ།",
    "ༀགྲི་ཧྥ་གྲི་ཧྥ་སཔྟ་པཱ་ཏཱ་ལ་ག་ཏ་བྷུ་ཛཾ་གི་སརྦ་བཱ་ཏ་རྫ་ཡ་ཏ་རྫ་ཡ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་སུ་བྷི་རེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ན་མོ་བྷ་ག་བ་ཏེ་ཝཱི་རེ་ཤཱ་ཡ་ཧུ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ས་ཧ་སྲ་བྷུ་ཛ་བྷཱ་སུ་རེ་ཡ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ན་མོ་བྷ་ག་ཝ་ཏི་བཛྲ་ཝཱ་རཱ་ཧཱི་བཾ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ན་མོ་ཨཱརྱ་ཨ་བ་རཱ་ཛི་ཏ་ཏྲེ་ལོ་ཀྱ་མཱ་ཏེ་བཱི་ཏྱ་ཤྭ་རཱི་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ན་མོ་སརྦ་བྷཱུ་ཏ་བྷ་ཡེ་བ་ཧེ་མ་ཧཱ་བཛེ་ཧུ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ན་མོ་བཛཱ་ས་ན་ཨ་བ་ར་ཛི་ཏ་བ་ཧཱུྃ་ཀ་རི་ནེ་ཏྲ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ན་མོ་བྷ་མ་ཎི་ཤོ་ཥ་ཎི་རོ་ཥ་ཎི་ཀྲོ་དྷི་ཀར་ལེ་ནི་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་ན་མོ་ཏཱ་ས་ནི་མཱ་ར་ཎི་པྲ་བྷེ་ད་ནི་བ་རཱ་ཛ་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་ན་མོ་བི་ཛ་ཡེ་ཛམྦྷ་ནི་སྟམྦྷ་ནི་མོ་ཧ་ནི་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་ན་མོ་བཛྲ་ཝཱ་རཱ་ཧཱི་མ་ཧཱ་ཡོ་གི་ནི་ཀཱ་མེ་ཤྭ་རི་ཁ་གེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "སོ་དང་སེན་མོ་བསྐྱེད་པ་སོགས་ལུས་ཀྱི་ཁམས་ཉེར་བཞི་དཔའ་བོ་ཉེར་བཞིའི་རང་བཞིན་དུ་གྱུར།",
    "གྲ་མ་ཧི་ཥཱི་ས་ཧ་སྲ་ཤཱི་རེ།",
    "ས་ཧ་སྲ་། ལུ་ཧི་བའི་ལུགས་ཀྱི་འཁོར་ལོ་བདེ་མཆོག་གི་མངོན་རྟོགས་ཐར་འདོད་འཇུག་ངོགས་བདེ་བའི་ལམ་བཟང་།",
    "བཛྲ་ཤྭ་རཱི་རེ་བཛྲ་ས་ནི།",
    "མ་ཧཱ་ཡོ་གི་ནི།",
    "ཧ་ཧ་བྷི་མོ་ཧ་ས་ཧ་ས་བཱི་རེ།",
    "ཏཐཱ་ག་ཏ་བ་རི་ཝ་རེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཏྲི་ལོ་ཀྱ་ཨུདྷ་རེ་ས་མུ་ཏྲ་མེ་ཁ་ལེ།",
    "ཧ་ཧ་མ་ཧཱ་པ་ཤུ་མེ་ཧཱ་ནི་ཡོ་གི་ཤྭ་རི་ཧཱུཾ།",
    "ཌཱ་ཀི་ནི་སཏྤ་ལོ་ཀཱ་ནཱཾ་བནྡྷ་ནི་ས་བྱ་པྲ་ཏྱཱ་ཡ་ཀ་རེ་ཎི་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "བྷུ་ཏ་ཏྲ་ས་ནི་མ་ཧཱ་བཱི་ར་བ་ར་མ་སིདྡྷཱ་ཡོ་གི་ཤྭ་རི་ཕཊ།",
    "ཌ་ཀི་ནཱ་ཛཱ་ལ་ཤཱི་ཝ་རེ་སྭཱཧཱ།",
    "ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ་བཛྲ་ཝརྣ་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ༀཁརྦ་རེ་ཡཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་སུ་བཱི་རེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཉིན་མོ་བཅོམ་ལྡན་དཔའ་བོ་སྟེ།",
    "རྣལ་འབྱོར་མ་ནི་མཚན་མོར་བརྗོད།",
    "ཕག་མོའི་གཟུགས་སུ་བསྟན་པ་ཡིན།",
    "དེའི་དབུས་སུ་སྐད་ཅིག་གིས་ཧཱུྃ་ཡིག་དཀར་དམར་དེ་དང་ཟླ་བ་གཉིས་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཧེ་རུ་ཀ་དཀར་པོ་གཡས་བརྐྱང་གིས་བཞུགས་པ།་",
    "ཡུམ་རྡོ་རྗེ་ཕག་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་དང་ཐོདཔ་འཛིན་པས་འཁྱུད་པས།",
    "གཡོན་སྐོར་གྱིས་ལྷ་མོ་བཞི་ལ་ཐིམ།",
    "མེ་ནས་བརྩམ་ཏེ་མཚམས་ན་གནས་པ་བཞི་ནི་གཟུགས་ཅན་མ་ནས་བཟུང་སྟེ་གཡས་སྐོར་གྱིས་ལྷ་མོ་བཞི་ལ་ཐིམ།",
    "ལྷ་མོ་བཞི་ཡང་རང་ངོས་ཀྱི་གཙོ་བོའི་ཞལ་བཞི་ལ་ཐིམ་པར་གྱུར།",
    "ཧཱུྃ་གི་ཞབས་ཀྱུ་ཨུ་ནི་ཧ་ལ།",
    "ནཱ་ད་ཡང་སྐྲའི་རྩེ་མོ་བརྒྱ་སྟོང་གི་ཆའི་ཚད་ཙམ་དུ་གནས་པར་གྱུར།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་སརྦ་པཱི་ར་ཡོ་གི་ནི་ཀཱ་ཡ་ཝཱཀྐིཏྟ་བཛྲ་སྭ་བྷ་ཝ་ཨཱཏྨ་ཀོཉ་ཧཾ།",
    "སྟོང་པའི་ངང་ལས་རྟེན་དང་བརྟེན་པའི་དཀྱིལ་འཁོར་ཐམས་ཅད་སྐད་ཅིག་གིས་གསལ་ལ་ཡོངས་སུ་རྫོགས་པར་གྱུར།",
    "ལྷ་གཞན་རང་རང་གི་ཐུགས་གར་ཉི་གདན་ལ་གནས་པའི་ཏིང་ངེ་འཛིན་སེམས་དཔའ་ཧཱུྃ་ཡིག་ལ་བཟླས་བྱའི་སྔགས་ཀྱིས་བསྐོར་བའི་དབུས་ཀྱི་ཡི་གེ་ལས།",
    "ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་ཅིང་།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་ཅན།",
    "གཡས་བརྐྱང་གིས་བཞུགས་པ།",
    "གང་བྱས་ཀྱང་མི་འགལ་ཡང་རེ་ཞིག་དང་པོ་ལྟར་དང་།",
    "རང་གི་ཐུགས་ཀར་ཉི་གདན་ལ་གནས་པའི་ཧཱུྃ་ཡིག་ལས་འཕྲོས་པའི་འོད་ཟེར་གྱིས།",
    "རྡོ་རྗེའི་ཐལ་མོར་གྱུར།",
    "བདེན་པ་འདི་དག་གིས་ནི་ལྷ་མོ་རྣམས།",
    "ལན་གཅིག་གིས་འཁོར་ལོ་གསུམ་གྱི་ལྷ་རྣམས་དང་།",
    "རིགས་བཅུ་དྲུག་གིས་མཆོད།",
    "ཁྱོད་ནི་དངོས་པོ་མཐའ་དག་མཁའ་ལྟར་གཟིགས་པ་དང་ལྡན་པ།",
    "མཛོད་ཅིག་ལྷ་མོ་རྣམས་ཀྱིས་བདག་ལ་ཤིན་ཏུ་རྗེས་བརྩེར་མཛོད།",
    "དུར་ཁྲོད་བརྒྱད་ན་གནས་པའི་ཕྱོགས་སྐྱོང་དང་ཞིང་སྐྱོང་ལ་སོགས་པ་ཐམས་ཅད་སྐད་ཅིག་གིས་འོད་གསལ་དུ་བཅུག་པ་ལས།",
    "བདེ་མཆོག་གི་ལྷ་ཡབ་ཡུམ་གྱི་སྐུར་བཞེངས་པའི་མགྲོན་རྣམས་ཀྱི་ལྗགས་ལ་ཧཱུྃ་དཀར་པོ་ལས་བྱུང་བའི་རྡོ་རྗེ་གསུམ་པ་དཀར་པོ་ནས་འབྲུ་ཙམ་འཁོད་པའི་རྡོ་རྗེའི་འོད་ཟེར་གྱི་ཕྲུ་གུས་དྲངས་ནས་གསོལ་བར་གྱུར།",
    "རིག་མ་བཅུ་དྲུག་གིས་མཆོད།",
    "ལྷ་མོ་བཞི་ཡང་རང་ངོས་ཀྱི་གཙོ་བོའི་ཞལ་བཞི་ལ་ཐིམ་པར་གྱུར།",
    "དེ་བརྒྱུད་ཀྱང་ནང་གི་ཧེ་རུ་ཀ་ཡབ་ཡུམ་ལ་ཐིམ།",
    "སྟོང་བའི་ངང་ལས་སྐད་ཅིག་གིས་རང་ཉིད་ཧེ་རུ་ཀ་སྔོན་པོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་དྲིལ་བུ་འཛིན་པ་གཡས་བརྐྱང་གི་བཞུགས་པ་ལ།",
