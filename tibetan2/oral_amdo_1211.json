    "རྡོ་རྗེ་ཕག་མོས་རབ་འཁྱུད་ཙམྦྷ་ནས།",
    "མཁའ་ལ་སྤྱོད་པའི་དཔའ་བོ་དཔའ་མོར་བཅས།",
    "དངོས་གྲུབ་མཆོག་གི་དཔལ་ལ་ལོངས་སྤྱོད་ཤོག།",
    "གང་གི་དྲིན་གྱིས་སྐུ་གསུང་གོ་འཕང་མཆོག།",
    "མཛེས་སྡུག་ལང་ཚོ་རྒྱས་པའི་འཇོ་སྒེག་ཅན།",
    "རྒྱལ་ཀུན་ཡུམ་གྱུར་སྤྱན་སོགས་ལྷ་མོ་བཞི།",
    "གདུག་པ་འདུལ་ཕྱིར་དྲག་མོའི་སྐུར་བསྟན་ནས།",
    "བདག་གི་ལུས་དང་ངག་དང་ཡིད་ཀྱིས་ཀྱང་།",
    "ཅེས་པའི་བར་གྱིས་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་སྡོམ་གཟུང་བྱ།",
    "འབུལ་ཡུལ་མངོན་རྟོགས་ཀྱི་སྐབས་ལྟར་སྤྱན་དྲུངས་ནས་འབུལ་བའང་རུང་མོད།",
    "མི་འདྲེན་ན་ཕྱོགས་སྐྱོང་དང་ཞིང་སྐྱོང་སོགས་སྐུད་ཅིག་གིས་འོད་གསལ་དུ་བཅུག་པ་ལས་ཞེས་སོགས་ལྟར་བྱ་ཞིང་།",
    "རང་གི་ཐུགས་ཀར་ཉི་གདན་ལ་གནས་པའི་ཧཱུྃ་ཡིག་ལས་འོད་ཕྲོས་པའི་འོད་ཟེར་གྱིས་དུར་ཁྲོད་བརྒྱུད་ན་གནས་པའི་ཕྱོགས་སྐྱོང་དང་ཞིང་སྐྱོང་དང་ཀླུ་ལ་སོགས་པ་ཐམས་ཅད་སྤྱན་དྲངས།",
    "དཀྱིལ་འཁོར་གྱི་ཕྱོགས་མཚམས་བརྒྱད་དུ་འཁོད་པ་སྐད་ཅིག་གིས་འོད་གསལ་དུ་ནས་འདོད་པ་ཀུན་འགྲུབ་ཤོག།",
    "བརྩེ་བས་གཟིགས་ལ་ལས་ཀུན་མཛོད།",
    "རབ་དགྱེས་མགོན་པོ་ཁྱོད་དང་མཁའ་འགྲོའི་ཚོགས།",
    "བདག་གི་མདུན་དུ་བཞུགས་ཏེ་བྱིན་རློབས་ལ།",
    "བདེ་ཆེན་ཐར་བའི་མཚན་ཉིད་ལྡན་པ་ཁྱོད།",
    "ཆུ་སྐྱེས་མཆོག་གི་དབུས་ན་གནས་པ་ཡིན།",
    "ཅེས་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་བྱའོ།",
    "དེ་ཡང་འོག་མ་རྣམས་ཀྱི་ཤོ་ལོ་ཀ་རེའི་ཐོག་མར།",
    "ཨ་ལ་ལ་ནས་བརྩེ་བས་གཟིགས་ལ་ལས་ཀུན་མཛོད།",
    "ཡིག་བརྒྱ་ཅི་འགྲུབ་བཟླས་ནས་ཐལ་མོ་སྦྱར་ཏེ།",
    "གུར་གྱི་འོག་ར་བའི་སྟེང་དུ་རྡོ་རྗེའི་བླ་རེ་སྟེ།",
    "དེ་ནས་གཡོན་པའི་སོར་མོ་ལྔ་ལ་མེ་ཏོག་བཞག་པའམ།",
    "ཡང་ན་ནང་མཆོད་ཀྱི་ཐིག་ལེ་རེ་བྱས་ལ།",
    "གཡོན་པའི་སོར་མོ་རྣམས་བསྡུས་པའི་མཐེ་བོང་ལ་ཟླ་གདན།",
    "གཞན་བཞི་དང་སོར་མོ་ལྔ་བསྡུས་པའི་སེན་མོ་རྣམས་ལ་ཉི་མའི་གདན་རེ་རེ།",
    "མཛུབ་མོ་ལ་རྣམ་སྣང་གི་ངོ་བོ་ན་མ་ཧི་སེར་པོ།",
    "སེན་མོ་རྣམས་ལ་རྟ་མཆོག་གི་ངོ་བོ་ཕཊ་ཧཱུྃ་ལྗང་ཀུ་རྣམས་བསགས་ལ།",
    "ཉི་མ་ལ་རྡོ་རྗེ་ཕག་མོའི་ངོ་བོ་ཨོཾ་བཾ་དམར་བོ།",
    "ཡུམ་རྣམས་ལ་རང་རང་གི་ཡབ་ཀྱིས་འཁྱུད་པའམ།",
    "ཡང་ན་འཁོར་ལོ་གསུམ་གྱི་ལྷ་ཚོགས་བསམ་མོ།",
    "དེ་བཞིན་དུ་ཆང་གིས་ཀྱང་བྱུག་སྟེ།",
    "ཡང་ན་འཁོར་ལོ་ལྔའི་ལྷ་ཚོགས་སུ་མོས་པར་བྱའོ།",
    "ཉེ་བའི་གནས་ལ་སོགས་པས་དང་པོ་ལ་སོགས་པའི་རང་བཞིན་དུ་གྱུར་པར་མོས་ལ།",
    "དྲི་བཟང་བོས་ཐིག་ལེ་གྲུ་བཞི་བ་རེ་དང་ལྷ་གཞན་རྣམས་ཀྱི་གནས་སུ་ཟླུམ་བོ་རེ་བྱ་སྟེ།",
    "མེ་ཏོག་གི་ཚོམ་བུ་རེ་དགོད་དོ།",
    "ཉེར་སྤྱོད་རོལ་མོ་དང་བཅས་པ་ལ་སོགས་པའི་མཆོད་རྫས་རྣམས།",
    "རང་གིས་མདུན་དུ་རྡོར་དྲིལ།",
    "གཡོན་དུ་ཐོད་པ་ཆང་གིས་བཀང་བ་རྣམས་བཤམ་མོ།",
    "མ་འབྱོར་ན་ཇི་ལྟར་རྙེད་པ་བཤམ་མོ།",
    "ཞེས་ས་བོན་མེད་པར་སྐད་ཅིག་གིས་བསྐྱེད།",
    "ཧཱུྃ་ཡིག་ལས་འོད་ཟེར་འཕྲོས་པས་དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་ཡེ་ཤེས་པའི་དཀྱིལ་འཁོར་རྟེན་དང་བརྟེན་པར་བཅས་པ་སྤྱན་དྲངས།",
    "ཨོཾ་སརྦ་པཱི་ར་ཡོ་གི་ནཱི།",
    "ཆུ་བཞི་ཉེར་སྤྱོད་རོལ་མོ་རིག་མ་བཅུ་དྲུག་གདུགས་རྒྱལ་མཚན་བླ་རེ་རྒྱལ་སྲིད་སྣ་བདུན་དང་།",
    "གཤིན་རྗེ་འཇོམས་མའི་བར་ལ་ཕྱོགས་གཡོན་སྐོར་དང་མཚམས་གཡས་སྐོར་གྱིས་ལ་རང་གི་གནས་སུ།",
    "ཅེས་པའི་བར་ལྷ་རང་རང་གི་སྔགས་ཀྱིས་མེ་ཏོག་དབུལ་ལོ།",
    "ཨོཾ་ཧ་ཞེས་སོགས་བརྗོད་ཅིང་ལྷ་རང་རང་གི་གནས་སུ་ལག་པ་གཡས་པས་མེ་ཏོག་དབུལ་ལོ།",
    "མགོ་བོར་ཐལ་མོ་སྦྱར་ནས་བདུད་པའི་ཚུལ་བྱས་པས།",
    "རྒྱུན་བཤགས་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་སྡོམ་བཟུང་།",
    "དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས།",
    "སྲིན་ལག་གིས་མཎྜལ་གྱི་ཚོམ་བུ་གང་རེག་ལ།",
    "རང་གི་སྣ་བུག་གཡོན་ནས་ཞུགས།",
    "དེ་ནས་ཤིས་བརྗོད་རྒྱས་བསྡུས་ཅི་རིགས་བྱས་ཏེ་མེ་ཏོག་གི་ཆར་དབབ་པར་བྱའོ།",
    "ཡང་ན་འཁོར་ལོ་ལྔའི་ལྷ་ཚོགས་སུ་མོས་པར་བྱའོ།",
    "ཞེས་སོགས་གོ་ཆའི་སྔགས་ལ་འབྲུ་གསུམ་བཏགས་པ་བརྗོད་ལ་ཆང་གིས་ཀྱང་མཆོད་དོ།",
    "ཉེར་སྤྱོད་དང་རིག་མ་བཅུ་དྲུག་གིས་ཀྱང་མཆོད་ལ།",
    "ལག་མཆོད་དང་སྤྲེལ་ན་གོང་གི་ལག་པའི་འཁོར་ལོ་བདག་ཉིད་ལ་གཞུག་པར་བྱའོ།",
    "གོང་གི་ལྷ་གནས་མི་འཆོལ་བའི་ཕྱིར་དུ་ཐིག་བཏབ་སྟེ་ཐིག་ལེ་དང་།",
    "སྤྱིར་བདེ་མཆོག་གི་སྒྲུབ་ཐབས་ལ་ལྷ་རེ་གཉིས་མ།",
    "རང་གི་སྤྱི་བོར་པདྨ་ཟླ་བའི་སྟེང་དུ་ཧཱུྃ་ལས་རྡོར་སེམས་ཧེ་རུ་ཀ་དཀར་པོ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པ།",
    "ཡུམ་རྡོ་རྗེ་སྙེ་མ་དཀར་མོ་གྲི་གུག་དང་ཐོད་པ་འཛིན་པས་འཁྱུད་པ།",
    "དེའི་ཐུགས་ཀའི་གྲུ་གདན་ལ་ཧཱུྃ་ཡིག་གི་མཐར་ཡི་གེ་བརྒྱ་བའི་སྔགས་ཀྱིས་བསྐོར་བ།",
    "དེ་ལས་བདུད་རྩི་ཞི་རྒྱུན་བབ་པར་གི་སྤྱི་བོ་ནས་ཞུགས་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་དག་པར་བསམས་ལ།",
    "པའི་གང་ཟག་གི་བདག་མེད་པ་དང་།",
