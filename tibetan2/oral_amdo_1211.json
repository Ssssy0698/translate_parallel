    "བཀྲ་ཤིས་གདངས་སྙན་བདག་གིས་བསྒྲིག་པར་བྱ།",
    "ནམ་མཁའི་ཁྱོན་ལྟར་ཞེས་སོགས་བྱའོ།",
    "། ལྟ་ཧི་བའི་ལུགས་ཀྱི་འཁོར་ལོ་བདེ་མཆོག་གི་མངོན་རྟོགས་ཐར་འདོད་འཇུག་ངོགས་བདེ་བའི་ལམ་བཟང་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དེ་ཡང་སྐད་ཅིག་གིས་རང་ཉིད་ཧེ་རུ་ཀ་སྔོན་པོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པ།",
    "གཡས་བརྐྱང་གིས་བཞུགས་པ་ལ།",
    "ཡུམ་རྡོ་རྗེ་ཕག་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་དང་ཐོད་པ་འཛིན་པས་འཁྱུད་པར་གྱུར།",
    "ཨོཾ་བཛྲ་དྷརྨཱ་ར་ཎི་ཏ་པྲ་ར་ཎི་ཏ་སཾ་པྲ་ར་ཎི་ཏ་སརྦ་བུདྡྷ་ཀྵེ་ཏྲ་པྲ་ཙ་ལི་ནེ་པྲཛྙཱ་པཱ་ར་མི་ཏ་ནཱ་ད་སྭ་བྷཱ་ཝེ་བཛྲ་སཏྭཱ་ཧྲི་ད་ཡ་སནྟོ་ཥ་ཎི་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཧོ་ཧོ་ཧོ་སྭཱཧཱ།",
    "དེའི་སྟེང་དུ་རི་ལས་བྱུང་བའི་མེའི་དཀྱིལ་འཁོར་དམར་པོ་གྲུ་གསུམ་པ་གྲྭ་གསུམ་དུ་མེ་འབར་བས་མཚན་པའི་སྟེང་དུ་ཨོཾ་ཨཱ་ཧཱུྃ་གསུམ་ལས་བྱུང་བའི་མི་མགོ་རློན་པའི་སྒྱེད་པུ་གསུམ་ལ་གནས་པའི་ཨ་དཀར་པོ་ལས་བྱུང་བའི་ཐོད་པ་དུམ་བུ་གཅིག་པ་ཕྱི་དཀར་ལ་ནང་དམར་བ་དེའི་ནང་གི་ཤར་དུ་ཨོཾ་དཀར་པོ་ལས་བྱུང་བའི་དྲི་ཆེན་ཨོཾ་གྱིས་མཚན་པ།",
    "བྱང་དུ་ཁཾ་ལྗང་ཀུ་ལས་བྱུང་བའི་ཀླད་པ་ཁཾ་གིས་མཚན་པ།",
    "ནུབ་ཏུ་ཨོཾ་དམར་པོ་ལས་བྱུང་བའི་བྱང་སེམས་དཀར་པོ་མཾ་གིས་མཚན་པ།",
    "ལྷོར་ཏཾ་སེར་པོ་ལས་བྱུང་བའི་རཀྟ་ཧཱུྃ་གིས་མཚན་པ།",
    "དབུས་སུ་ཧཱུྃ་མཐིང་ག་ལས་བྱུང་བའི་དྲི་ཆུ་ཧཱུྃ་གིས་མཚན་པ།",
    "མེར་ལོ་དཀར་པོ་ལས་བྱུང་བའི་བ་ལང་གི་ཤ་ལཾ་གྱིས་མཚན་པ།",
    "སྔོན་པོ་ལས་བྱུང་བའི་ཁྱིའི་ཤ་མོ་གྱིས་མཚན་པ།",
    "ཡེ་གེ་དེ་ཉིད་ཁ་དོག་སྣ་ཚོགས་པ་བདུད་རྩིའི་སྟེང་དུ་གནས་པ་ཡོངས་སུ་གྱུར་པ་ལས་མོ་དཀར་པོ།",
    "དཔའ་བོ་དང་དཔའ་མོ་བཀུག་པ་རྣམས་ཀྱང་།",
    "རོལ་མོ་རྣམས་རང་བཞིན་སྟོང་བ།",
    "རང་གི་ཐུགས་ཀར་ཉི་གདན་ལ་གནས་པའི་ཧཱུྃ་ཡིག་ལས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་དུར་ཁྲོད་བརྒྱད་ན་གནས་པའི་ཕྱོགས་སྐྱོང་དང་ཞིང་སྐྱོང་ཀླུ་ལ་སོགས་པ་ཐམས་ཅད་སྤྱན་དྲངས་ཏེ།",
    "ཕྱོགས་མཚམས་བརྒྱད་དུ་འཁོད་པ་སྐད་ཅིག་གིས་འོད་གསལ་དུ་བཅུག་པ་ལས།",
    "བདེ་མཆོག་གི་ལྷ་ཡབ་ཡུམ་གྱི་སྐུར་བཞེངས་པའི་མགྲོན་རྣམས་ཀྱི་ལྗགས་ལ་ཧཱུྃ་དཀར་པོ་ལས་བྱུང་བའི་རྡོ་རྗེ་གསུམ་པ་དཀར་པོ་ནས་འབྲུ་ཙམ་འཁོད་པའི་རྡོ་རྗེའི་འོད་ཟེར་གྱི་སྦུ་གུས་དྲངས་ནས་གསོལ་བར་གྱུར།",
    "མ་མོའི་ཚོགས་རྣམས་མ་ལུས་དང་།",
    "རང་གི་སྤྱི་བོར་པཾ་ལས་པདྨ།",
    "ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཧཱུྃ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་བ་དཀར་པོ་ལྟེ་བ་ལ་ཧཱུྃ་གིས་མཚན་པ།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཡུམ་རྡོ་རྗེ་བསྙེམས་མ་དཀར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་བས་འཁྱུད་པ།",
    "ཐུགས་ཀར་ཟླ་བའི་སྟེང་དུ་ཧཱུྃ་གི་མཐར།",
    "རང་གི་ཚངས་བུག་ནས་ཞུགས་ཏེ།",
    "རང་གི་སྒོ་གསུམ་དང་།",
    "སྐད་ཅིག་གིས་རང་ཉིད་ཧེ་རུ་ཀ་སྔོན་པོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པ།",
    "གཡས་བརྐྱང་གིས་བཞུགས་པ་ལ།",
