    "ཞེས་ནས་འགྲོ་དགོས་པ་གདའ་སྟེ།",
    "དུར་པོ་ཆེས་རྩེར་གཏུག་ཙ་ན།",
    "ཕྱོགས་ཐ་དད་ཀྱི་མི་བརྒྱ་སྟོང་ཁྲི་འབུམ་འཚོགས་པ་ཐམས་ཅད་ཀྱང་མཐར་རང་རང་སོ་སོའི་ཡུལ་དུ་གྱེས།",
    "འདུག་ན་གནས་མི་རྟག་པས་དག་པའི་ཞིང་དུ་ལྟ།",
    "སྔས་སུ་སླེབ་ཙ་ན་བཙན་པོའི་མཁར།",
    "ཚེ་འདིའི་ཕྱིས་ཆུས་འབའ་ཞིག་བསྒྲུབ་གཞན་འཆི་བ་མཐོང་ཡང་རང་འཆི་བ་མི་ཤེས།",
    "ཡང་འདུག་པའི་དུས་སུ་མི་རྟག་པ་བསྒོམ་ན་དག་པའི་ཞིང་ཁམས་མཐོང་བར་བྱེད།",
    "ད་ལྟ་རང་ལ་རང་ཁྲེལ་བ་དང་རང་ཉིད་ཀྱང་རང་ལ་ངོ་ཚ་བའི་གནས་སུ་གྱུར་པ་སྟེ།",
    "རྣམ་སྨིན་འབྲས་བུ་སྨིན་པར་འདུག་གསུངས།",
    "ཙན་དན་གྱི་གྲིབ་མ་འདུག་སྙམ་ནས་ཕྱིན་པའི་ཚེ།",
    "སྔ་ཕྱི་ཙམ་མ་གཏོགས་གནས་དེར་སྐྱེ་ངེས་པར་འདུག།",
    "རྐང་གཉིས་པ་གཅོད་སྦྱང་བྱེད་པ་མང་བར་གདའ།",
    "མཐོང་བ་རྣམས་ནི་དེ་ལྟ་བུ་འདུག།",
    "ལུས་ལ་གྲོག་སྦུར་སོགས་སྲོག་ཆགས་གྲངས་མེད་པ་འབྱར་ཏེ་ཤུན་པ་མ་ལུས་པར་ཤ་ལ་ཟ་ཀྱིན་འདུག།",
    "སྦལ་པ་ཤིན་ཏུ་ཆེ་བ་གཅིག་ལ་སྡམ་སྦྲུལ་སོགས་སྲོག་ཆགས་སྟོང་བས་མི་ཉུང་བས་ཟ་ཀྱིན་འདུག་སྦལ་པ་དང་སྲོག་ཆགས་ཀུན་བསྒྲལ་ནས་ཕྱིར་མི་ལྡོག་པར་མཛད།",
    "གནས་ན་འདུག་པ།",
    "དང་པོ་གནས་ན་འདུག་པ་ལ་ཕྱིའི་སྒྲིབ་པ་ཅན་ནི།",
    "བོང་བུ་གཉིས་གཏོད་པ་ལ་བཏག་ནས་འདུག།",
    "ད་ལྟར་མི་ཡུལ་འདིར་བཟའ་བཏུང་མེད་པར་ཞག་གཅིག་འདུག་ན་ཇི་ཙམ་གྱི་སྡུག་བསྔལ་འདུག།",
    "དེ་སྤོང་བར་འདོད་ནས་གཞན་གྱི་རྩར་ཕྱིན་པས་དེ་ལ་གནོད་ཅིང་རང་ལ་མི་ཕན་པ་ལ་སོགས་ཇི་ལྟར་བྱས་ཀྱང་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས།",
    "དེ་རྣམས་ཀྱི་སྡུག་བསྔལ་ཡང་རང་ཐོག་ཏུ་བླངས་ལ་བསྒོམ།",
    "རྒས་པའི་དུས་ལ་བབ་ཙ་ན་ལུས་ཀྱི་ཤ་ཞུ།",
    "འདུག་ན་ས་དོ་ལུང་ཆད་པ་བཞིན་དུ་འདུག།",
    "འདུག་ན་རང་ལུས་ཉམ་ཆུང་ས་དོ་ཆད་པ་འདྲ།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།",
    "ནོར་མེད་ཙ་ན་དགྲ་དང་བྲལ་ཞེས་པ་ལྟར།",
    "རང་རྒུད་པའི་དུས་ལ་བབ་ཙ་ན་ཟས་ནོར་གྱིས་ཕན་གདགས་པ་ཕར་ཞོག།",
    "དེ་ལ་བསམ་ན་འབུ་སྦྲང་ཁོ་ནའི་ཕྱེ་བྱས་པ་འགམ་པ་དང་ཁྱད་མི་འདུག།",
    "ལྷའི་སྟན་ལ་ཅི་ཙམ་འདུག་ཀྱང་མི་དགའ་བ་མེད་པ་ལ།",
    "ཀུ་སུ་ལུ་པ་ཁ་ཅིག་འདུག་ས་དབེན་པ་ལྔ་ལྡན་དུ་བྱས་ཀྱང་།",
    "སྣང་བས་བསྒྱུར་བ་གདའ་གསུངས།",
    "འཁྲི་བ་ཆོད་པ་གང་དཀའ་བ་གདའ་ཞུས་པས།",
    "འདུག་ས་ནི་གཡའ་རི་གངས་བྲག་ཡིན།",
    "ང་རང་གར་འདོད་སླེབ་པ་ཡིན་གསུངས།",
    "རང་ནོར་ལ་སེར་སྣ་བྱེད་ཅིང་འདོད་སེམས་ལ་ཁེངས་དུས་དང་ཆོག་དུས་མེད་པ་རྣམས་ཀྱང་།",
    "ཡོད་ཀྱང་ཅུང་ཟད་ཡང་སྙམ་པ་འདུག་སྟེ་གསོད་དུ་འཇུག་པ་པོ་ལྟ་ཅི།",
    "ཚོང་སོགས་གཡོ་དང་ཐབས་ཀྱི་སྒོ་ནས་ལེན་པ་ཐམས་ཅད་ཉེས་པ་མེད་ང་རང་ཕོ་རྒོད་པས་ཡིན་སྙམ་པ་འདུག་ཀྱང་།",
    "གཞན་གྱིས་མི་སྦྱིན་པ་ལ་སྦྱིན་འདུག་ཟེར་བ་སོགས་རྫུན།",
    "ནོར་ཕྱིར་སྐུ་ཚེ་དཀོར་ནག་ལ་སྐྱལ་ནུས་པ་ཡང་ཡོད་པ་འདུག་སྟེ།",
    "ན་བཟའ་ཉི་ཟེར་ལ་བཀལ་ཀྱང་སྲང་ངེར་འདུག་པ་སོགས་བྱུང་།",
    "དེ་ལ་ཚེ་སྙན་དང་བདེ་སྐྱིད་ལ་སོགས་ཡོད་པ་འདུག་ན་འདི་ཙམ་དུ་མ་བདེ་ན་མ་སྐྱིད་ན།",
    "མིན་ཀྱང་རང་བཞིན་དུ་རྒྱལ་བའི་བཀའ།",
    "གཞན་གནོད་པ་དང་འཚེ་བར་བྱེད་པ་རྣམས་ཀྱང་རང་བཞིན་གྱི་ཞི་ནས་འགྲོ་བ་ཡིན་ཏེ།",
    "སྒོམ་སྒོམ་འགྲོ་འདུག་བྱེད་པ་ལ་ཡང་འཚེ་བ་མེད་ན་དགའ་བ་ཡིན།",
    "ད་འོ་ཅག་ལ་མི་ངན་ཟན་སློང་བ་ཙམ་ཡང་མི་འོངས་པར་འདུག་གསུངས་པ་ལྟ་བུའོ།",
    "སི་ལ་དང་ཚིལ་ཆེན་གྱི་དྲི་ཅི་ལི་ལི་འདུག་པས།",
    "ཁྱད་པར་སྐྱེ་དམན་འདི་མཁའ་འགྲོ་མ་ཡིན་པར་འདུག་པས་མ་སྨད།",
    "ངག་འཁྱལ་ལམ་གཏམ་སྣ་ཚོགས་པ་སྨྲ་བ་དེ་ཡང་རང་བཞིན་དུ་གང་བབ་བྱུང་རྒྱལ་དུ་སྨྲ་བ་ལྟར་སྣང་ཡང་།",
    "དེར་སྐྱེས་ན་སྡུག་བསྔལ་མ་གཏོགས་བདེ་བ་སྐད་ཅིག་ཙམ་ཡང་མི་འདུག་པས།",
    "ཕྱི་ནས་འདི་ལྟ་བུའི་འདུག་ན་སྡུག་བསྔལ་འདི་ལྟ་བུ་མྱོང་བ་འདི།",
    "ལུས་ལ་ཚེར་མ་ཙམ་ཟུག་པའམ་སྐྲ་ཉག་མ་གཅིག་ཙམ་འཐོན་ནས་བཏོག་ན་དེ་ལ་ཇི་ཙམ་གྱི་ཟུག་རྔུ་འདུག།",
    "བྱམས་པ་སོགས་གཞན་གསུམ་པོ་ཀྱང་རང་ཤུགས་ཀྱི་སྐྱེ་ཞིང་།",
    "བཙུན་ཆུང་ངུ་དགའ་བ་ཞིག་འདུག།",
    "བཙུན་ཆུང་ལྟོག་སླ་བ་ཞིག་འདུག།",
    "རང་རང་སོ་སོའི་འདོད་པ་ལྟར་བདེ་བ་དང་སྐྱིད་པ་ཁོ་ན་བྱུང་ན་ཅི་མ་རུང་སྙམ་དུ་ཡང་དང་ཡང་དུ་བསྒོམ།",
    "གཞན་གྱི་ཡོན་ཏན་ལ་མཐོང་དུས་མེད་ཅིང་རང་ཉིད་སྡུག་བསྔལ་གྱི་གནས་སུ་འཕེན་པའི་སྡིག་ཚབས་པོ་ཆེ་གསོག་པ་ཡིན་ཏེ།",
    "དེ་ལ་སྨད་པ་དང་བསྐུར་འདེབས་སོགས་བྱེད་ཅིང་རང་རྒྱུད་ཆུད་ཟོས་སུ་འགྱུར་བ་ཞིག་འོང་བས་ན།",
    "ངེད་གཉིས་ཀས་དྲངས་ཀྱང་མི་འདྲོང་བར་སྡུག་བསྔལ་བར་མཚུངས་པར་འདུག་པས་བདག་གཅིག་བུའི་སྡུག་བསྔལ་གྱིས་དྲངས་ལ་འདི་བདེ་བར་གཞུག་དགོས་དགོངས་ནས།",
    "དངོས་སུ་ཡང་རང་ཉིད་ཀྱི་ན་ཚ་དང་དཀའ་ཚེགས་ལ་སོགས་པའི་སྡུག་བསྔལ་ཐམས་ཅད་ཁྱད་དུ་གསོད་ནས།",
    "འོན་ཀྱང་རང་འདོད་རྩ་བ་ནས་མ་ཟད་ཀྱི་བར་གཞན་དོན་སྒྲུབ་ལོ་བྱས་ཀྱང་གཞན་ལ་ཕན་མི་ཐོག་ཅིང་རང་དོན་སྟོར་བ་ལས་མེད་པས།",
