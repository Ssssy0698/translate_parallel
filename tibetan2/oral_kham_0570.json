    "ལུས་མི་འགུལ་འདུག་སྟངས་གོང་དུ་བསྟན་པ་ལས་མ་ཞིག་པར་གནས་པའོ",
    "འདུས་བྱས་ཐམས་ཅད་རྟག་ཏུ་མི་རྟག་འཆི་པར་འདུག་ཨང་སྙམ་པ་རྒྱུད་ལ་སྐྱེས་པ་ངེདང་བྱས་འཇིག་རྟེན་གྱི་པ་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྒྱུར་འདུག་ཨང་དོན་མེད་རྟག་ཏུ་སྡུག་བསྔལ་སྙམ་པ་རྒྱུད་ལ་སྐྱེས་པ་དང་",
    "འགྲུ་བྱེད་དང་བྲལ་བའི་རིག་པ་བསམ་པ་འདུག་པར་གཞུག་པ་འདི་ཉིད་ནི",
    "རིག་པ་རང་སྣང་དབྱིངས་ཀྱི་ཡུལ་དུ་ཐ་དད་ཟེར་བའང་འདུག་གཟུགས་ཐམས་ཅད་རང་གཞན་མ་གྲུབ་པ་གནས་གང་དུ་གཏན་ལ་དབབ་པ་དང་",
    "རྒྱས་གདབ་པ་དང་རང་གྲོལ་བ་ལ་སོགས་དབྱིངས་ཁྱ",
    "དེ་ནས་ལུས་ངག་ཡིད་ཀྱིས་བྱ་བ་ཅི་ཡང་མི་བྱ་བར་ལྷ་དང་སྔགས་ལ་སོགས་པ་ལྟ་སྒོམ་གྱི་བྱ་བ་ཡང་མེད་པར་ཐ་མལ་པ་ལྟར་ཤིན་ཏུ་དལ་བར་ཞག་དགུ་ནས་བཅུ་ཙམ་དུ་ཤེས་པ་གང་ཡང་འཕྲོས་པར་འདུག་ན་དེ་ལ་ཡུན་རིང་བར་རྣལ་དུ་མ་བཅོས་པའི་རིག་པ་འདི་ཡིནངེནོ་བྱ་བའི་བརྡའོ",
    "ཡན་ལག་མགོ་སྒྲིལ་བ་ལུས་བསྒུལ་བ་དྲག་ཏུ་བསྐུམ་པ་ཙོག་པུར་འདུག་པ་ཉལ་བ་དང་",
    "ལངས་པ་དང་འདུག་པ་ལ་སུག་མབཞི་སར་བཙུགས་ཏེ་འགྲོ་བ་གན་རྐྱལ་ཉལ་བ་རྐང་ལག་བཞི་གནམ་ལ་བསྟན་ཐང་བཅད་དེ་བརྒྱང་བ་གཡབ་པསོགས་པ་སྣ་ཚོགས་བྱེད་པ་ནི",
    "ལུས་ཀྱི་འདུག་སྟངས་འདི་ལྟར་གྱིས",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ནརིག་པ་འདི་ཉིད་མངོན་སུམ་མིག་ལ་དུ་མ་མཐོང་འོད་གསལ་བའི་ངོ་བོ་ཞིང་བལྟར་མེད་པས་ཡིད་འདི་ཁོ་ན་ཡིན་པར་འདུག་སྙམ་པ་ནི་ཡིད་དཔྱོད་དོ",
    "སེམས་གནས་མི་རྟོགས་པ་བག་ཙམ་པ་གཅིག་ལ་ཆགས་ནས་བདེ་བར་འདུག་སྙམ་པ་ཡིན་ཏེ",
    "དེ་ལྟར་སྣ་ཚོགས་སུ་འདུག་པའི་སྣང་བ་ཐམས་ཅད་དེའི་རིག་པའི་ངོ་བོ་ལས་མ་འདས་པའོ",
    "དེ་ཡང་རིང་བ་རྒྱུད་ཀྱི་ངོས་ནས་བལྟས་ན་ཕྲ་བར་འདུག་སྟེ",
    "ཐམས་ཅད་རང་ལ་ཤར་བས་མཆོད་ཅིང་བཤགས་པའི་བདག་པོ་འདུག་གམ",
    "མིང་ཐམས་ཅད་དང་བྲལ་བས་སྡོམ་པར་བྱ་བའི་དམ་ཚིག་འདུག་གམ",
    "ལུས་ངག་སྡིག་དང་རྣམ་སྨིན་གྲུབ་ནས་འདུག་གམ",
    "མཇིང་པ་ཡིད་ཙམ་དགྱེ་བར་བྱ་བ་ནི་ལུས་ཀྱི་འདུག་སྟངས་སོ",
    "ཁྱིམ་མུན་ནང་དུ་འདུག་པའོ",
    "དེའི་བར་དུ་དེ་ལྟ་བུའི་ཉམས་སྐྱེས་ནས་འདུག་ན་ལུས་རྣལ་དུ་འབེབས་པ་ཞེས་བྱ་སྟེ་སོར་ཆུད་པའི་དོན་དུ་ཡང་དུར་ཁྲོད་དེར་གཏང་སྟེ",
    "ལུས་དལ་བར་ནཞག་བཅུ་ནས་ཟླ་བ་ཕྱེད་དུ་འདུག་ཏུ་གཞུག་གོ",
    "ཉམས་བདེ་བ་འབྱུང་སྟེདེ་ལྟར་བྱུང་ཙ་ན་ཡང་ཡིད་སོར་ཆུད་པར་བྱ་ཞིང་རྣལ་དུ་ཕབས་པའི་ཐབས་ཞག་བཅུ་ནས་ཟླ་བ་ཕྱེད་དུ་ཡིད་དལ་བར་གནས་པར་བྱའོ",
    "དེ་ཡང་གླང་པོ་ཆེ་འདུག་སྟངས་ཀྱིས་གཞི་བཅའ་བ་གཅེས",
    "དེ་ཀུན་ལ་སྐྱོ་ན་འདུག་སྟངས་དེ་མ་ཡིན་པ་རྣམས་ལ་ཡང་ལུས་སྦྱང་བར་བྱའོདེ་ཀུན་གྱིས་ལུས་མ་སྦྱངས་ན་ཡེ་ཤེས་མངོན་དུ་སྣང་བར་མི་ནུས་ཏེ",
    "འདུག་སྟངས་རྣམས་ལ་རང་ལུས་སྦྱ",
    "རབ་ཏུ་དབེན་པའི་ས་ཕྱོགས་སུརི་དྭགས་དམན་པའི་ཚུལ་གྱིས་འདུག་འདུ་འཛི་སྤངས་པའི་ས་ཕྱོགས་སུ",
    "ཐ་མལ་པ་ནི་ཚུལ་གྱིས་འདུག་དགྲ་གཉེན་མེད་པའི་ས་ཕྱོགས་སུ",
    "སྤྲང་པོ་ལྟ་བུའི་ཚུལ་གྱིས་འདུག་ཡུལ་དམིགས་མེད་པའི་ས་ཕྱོགས་སུ",
    "འདིའི་དུས་ན་མཐོང་སྣང་རང་གྲོལ་ནས་སྣང་བ་འོད་གསལ་དུ་མཐོང་བའི་འགྱུར་སྔ་ཉམས་མྱོང་མི་སྐྱེ་མི་སྲིད་དོ",
    "དེ་ཉིད་ལ་རིག་པ་ཅོག་བཞག་ཏུ་བཞག་ནས་ཉམས་སུ་བླངས་པས་དུས་ཚོད་གཅིག་ཙ་ན་ཐིག་ལེ་སྟོང་པའི་སྒྲོན་མ་རྩོལ་བ་མེད་པར་ཤར་ནས་འོང་ངོ",
    "པ་མེད་པ་རང་སྣང་རང་གསལ་འཛིན་མེད་ཅེས་བྱའོ",
    "འཛིན་པ་མི་འདུག་སེམས་ལ་སེམས་ཀྱིས་བལྟས་པའི་ཚེ",
    "རྒྱ་ཆེ་བར་འདུག་ཡངས་པར་འདུག་ཕྱོགས་རིས་དང་བྲལ་བར་འདུག་ཁ་དོག་དང་དབྱིབས་སུ་མ་གྲུབ་པར་འདུག་འཁོར་འདས་གཉིས་སུ་མ་གྲུབ་པར་སེམས་དེ་རང་གསལ་རྟོག་པ་མེད་པའོ",
    "འདི་ལྟར་སྣང་བའི་འཁྲུལ་པའི་སེམས་དང་རྩ་བའི་སྐོརསེམས་ལས་བྱུང་བའིམངོན་ཞེན་ཐམས་ཅད་ནམ་ཆོད་ཙ་ན་ཡང་དག་པའི་ཤེས་རབ་ཡིན་ནོ",
    "བསམ་པའི་ཤེས་རབ་ཀྱི་ས་མཚམས་ནིཚིག་དང་དོན་དུ་འདྲེས་ཏེ་ཉམས་སུ་ལེན་ཤེས་ཙ་ན",
    "ཁྲོལ་ཙ་ན",
    "རིག་པའི་འདུག་ཚུལ་གསུམ་དུ་གཏན་ལ་དབབ་པ་དང་བརྒྱད་དོ",
    "དེ་ཧྲིག་གེ་སང་ངེ་སལ་ལེ་འདུག་ཀྱང་ཡུལ།",
    "སྐུ་གསུམ་ཐོབ་པར་བྱ་བའི་འབྲས་བུ་འདུག་གམབསྐུར་བར་ཐབས་རང་ལ་ཤར་བས།",
    "སྣང་བ་ཉིད་དང་མི་སྣང་བ་ཉིད་གྲུབ་ནས་འདུག་གམ",
    "རང་རིག་པ་འདུག་ཚུལ་གསུམ་གྱི་བདག་ཉིད་མ་ཞེས་བྱ་སྟེ",
    "དེ་ཡང་རང་བཞིན་འཁྲུལ་མ་མྱོང་བས་གོ་བས་ལུས་ངག་ཅི་བྱེད་ཀྱང་༣ འཁྲུལ་པ་མི་གནསའཁྲུལ་མི་སྲིད་པས་གོ་བས་ལུས་ངག་ཁམས་གསུམ་དུ་མི་བཟློག་པའོ།",
    "ལུས་འདུག་སྟངས་དང་བསྟུན་པ་དང་",
