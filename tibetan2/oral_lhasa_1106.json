    "སྔགས་ནི་སྙན་གསན་འབེབས་པར་བྱེད།",
    "ཞེས་གསུངས་པའི་དགོངས་དོན་དང་ཉེ་བར་མཚུངས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངག་བློས་རྣམས་ཀྱིས་ཆེད་གཉེར་མཛད་དེ་ལྷ་རྫ་ས་དར་བཟང་སོགས་བཀྲ་ཤིས་པའི་དངོས་རྫ་ས་མཁོ་འོས་སྔ་ཕྱི་ཀུན་ཏུ་ཡང་ཡང་སྤྱི་སྒོས་ཐམས་ཅད་ཀྱིས་གནང་སྦྱིན་དང་བཅས་བསྐུལ་ངོར།",
    "རྒྱུ་རྐྱེན་གང་དགོས་ལེགས་པར་སྦྱར།",
    "ལེགས་བྱས་སྤར་རྐོས་འདུ་བྱེད་གང་།",
    "མཁའ་མཉམ་འགྲོ་ལ་རིས་སུ་ཆད་མེད་པར།",
    "བསམ་པའི་དོན་ཀུན་ཡིད་བཞིན་འགྲུབ་པར་སྨོན།",
    "ཡེ་ནས་གཞི་འབྲས་དབྱེར་མེད་ཚུལ་དུ་བཞུགས།",
    "ཁྱད་པར་ཀུན་ནས་མཛད་པ་རྨད་བྱུང་བ།",
    "སློབ་དཔོན་མེད་པར་གྱུར་ནས་ནི།",
    "དངོས་གྲུབ་ཐོབ་པར་མི་འགྱུར་བས།",
    "ཞེས་གསུངས་པ་ལས་དང་པོ་པ་དངོས་གྲུབ་འདོད་པ་ཐམས་ཅད་ཀྱིས་ནི་སློབ་༢དཔོན་ཉིད་མཉེས་པར་བྱ་བ་ལམ་ཐམས་ཅད་ཀྱི་རྩ་བ་ཡིན་ཏེ།",
    "དངོས་གྲུབ་རབ་འབྲིང་ཐ་གསུམ་གང་ཡིན་ཀྱང་སློབ་དཔོན་རྡོ་རྗེ་འཛིན་པ་ཉིད་ལ་རག་ལས་ཤིང་སློབ་དཔོན་དེ་འདྲ་མེད་པར་ནམ་ཡང་དངོས་གྲུབ་ཐོབ་མི་སྲིད་པ་ལྟ་བུ་ཡིན་པའི་ཕྱིར།",
    "དེ་ནས་ཐེག་ཆེན་ལམ་གྱི་གཞི་རྩ་སྨོན་པ་དང་འཇུག་པའི་ཁྱད་པར་ཅན་གྱི་སེམས་བསྐྱེད་ཀྱིས་རྒྱལ་སྲས་ལམ་གྱི་འཇུག་སྒོར་ཞུགས།",
    "དེ་ནས་རྣམ་པར་དཀར་བའི་དགེ་རྩ་རྒྱ་ཆེར་བསྐྲུན་ཆེད་མཎྜལ་གྱིས་ཚོགས་བསགས།",
    "སློབ་བུ་འདིའི་སྒོམ་ཐག་ཕྱག་ཏུ་བཞེས་ནས།",
    "དེ་འདྲའི་ཉམས་ལེན་གྱི་རྩལ་ཁ་ལྷག་པར་ཇོ་ནང་དཔེ་ཚོགས།",
    "གདམས་པའི་བཅུད་ཀྱིས་ཐུགས་བཟང་ག་དར་བྱས།",
    "དེ་ལྟར་ན་དགུང་ལོ་བཅུ་དྲུག་པའི་སྐབས་དག་ཏུ་རྡོ་རྗེའི་རྣལ་འབྱོར་སོར་བསམ་གྱི་ཉམས་མྱོང་མཚན་ཉིད་པ་ཐུགས་ལ་བཞུགས་ཆོག་པར་གསལ་ཞིང་གསང་སྔགས་འཛིན་པ་ཆེན་པོ་ཉིད་དུ་ངེས་པའོ།",
    "གྲུབ་ཆེན་བརྒྱད་ཅུ་དང་རྗེས་གནང་བརྒྱ་རྩ།",
    "སྨེ་བརྩེགས་རྗེས་གནང་།",
    "ཕུར་བའི་བསྙེན་མཚམས་སོགས་ལ་བཞུགས་ཤིང་།",
    "རང་ལུས་ཉིད་དུས་ཀྱི་འཁོར་ལོའི་སྐུ་རྣམ་ཀུན་མཆོག་ལྡན་དུ་སྣང་སྟེ་དེའི་སྐུའི་བ་སྤུའི་བུ་ག་ཐམས་ཅད་ནས་ལྷ་སྐུ་དང་ཐིག་ལེ་སྣ་ཚོགས་པ་རབ་འབྱམས་མཁའ་དབྱིངས་ཀུན་ཏུ་རྣམ་པར་སྤྲོ་ཞིང་།",
