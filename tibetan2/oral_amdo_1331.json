    "ངས་ཀྱང་ལག་པའི་ནང་གི་ལས་ཀ་བསྐྱུར་ཏེ་སེམས་ཁྱོགས་ལ་འཆང་བཞིན་སློབ་གཙོའི་གཞུང་ལས་ཁང་དུ་ཕྱིན་པ་ཡིན།",
    "ང་རང་འགྲོ་དུས་གཞུང་ལས་ཁང་གི་ནང་དུ་སློབ་གཙོ་ཀུན་བཟང་གཅིག་པུ་མ་གཏོགས་མི་གཞན་མི་འདུག་ལ།",
    "ཅུང་ཙམ་འགོར་རྗེས་ཁོ་རང་དྲང་ཐད་དུ་བསྡད་ཅིང་ཐ་མག་གི་མེ་བསད་རྗེས་ཧ་ཅང་ནན་ཏན་ངང་ན་རེ།",
    "ངར་ཁྱོད་ལ་འདྲི་རྒྱུ་ཞིག་ཡོད།",
    "ཁྱོད་ཀྱིས་དྲང་མོར་ཤོད་ཟེར།",
    "འདི་ནི་དོན་དག་གལ་ཆེན་ཞིག་རེད་ཟེར།",
    "མདང་དགོང་ཁྱོད་གང་ལ་སོང་བ་ཡིན།",
    "མདང་དགོང་ང་རང་སྔ་མོ་ནས་ཉལ་བ་ཡིན།",
    "གང་དུ་ཡང་མ་སོང་།",
    "ཞེས་བདེན་ཅོག་ཅོག་གིས་ལན་བཏབ།",
    "མིག་རིག་རིག་གིས་ངའི་རྣམ་འགྱུར་ལ་རྟོག་པར་བྱེད།",
    "ང་རང་ཅུང་ཚིག་པ་ཟ་བར་གྱུར་སོང་ལ།",
    "སློབ་གཙོ་ཀུན་བཟང་གིས་ཀྱང་དེ་མ་ཐག་མིག་ཟུང་ཆེ་རུ་ཅེར་ཞིང་ཁྱོད་རང་གང་དུའང་མ་སོང་ན།",
    "ང་རང་ཡང་ཁོའི་ཡིད་ཆེས་ཀྱིན་མེད་པའི་རྣམ་འགྱུར་དང་གཏན་ཚིགས་ལྟར་སྣང་གི་སྐད་ཆ་དེ་དག་ལ་ཡི་མ་རངས་པས།",
    "སློབ་གཙོ་ཀུན་བཟང་དེ་མ་ཐག་ཏུ་ཡ་མཚར་བར་གྱུར་སོང་།",
    "ད་དུང་ཡང་ཡིད་ཆེས་ཀྱིན་མེད་པ་ལྟར་དེ་དེ་ཁོ་ཚོས་ཇི་ལྟར་ཤེས་པ་རེད་དམ་ཟེར།",
    "ཡང་བསྐྱར་གློ་ཁུག་ལས་དུ་བ་རྐང་གཅིག་བླངས་ནས་མེ་སྒྲོན་ཏེ་རྔུབ་འཐེན་འགའ་བྱས་ཤིང་བསམ་བློ་གཏོང་གིན་བསྡད་བྱུང་བས།",
    "རེ་ཞིག་ལ་ཁོས་ང་རང་འབོད་དོན་ཅི་ཞིག་ཡིན་པའང་བརྗེད་སོང་བ་ལྟར་སྣང་།",
    "མཇུག་མཐར་ངས་མུ་མཐུད་དུ་ངང་སྒུག་བྱེད་མ་འདོད་པར་ཡར་ལངས་བཞིན་དུ་དོན་དག་གཞན་མེད་ན་ང་རང་སོང་སྟེ་མི་གྱ་སྐ།",
    "ཁོས་ལག་ནང་གི་དུ་བ་འཐེན་འཕྲོ་དེ་ཞེ་སྡང་དང་བཅས་གཅིར་ནས་མེ་བསད་རྗེས།",
    "ཁྱོད་ཀྱིས་འདང་རྒྱོབས་དང་ཤེས་ངེས་རེད་ཟེར།",
    "ཁོ་མོས་ནམ་རྒྱུན་གོན་ཡོད་པའི་སློག་པ་མཐུག་པོ་དེའི་སྟེང་དུ་ལས་ལྭ་དཀར་བོ་རིང་བོ་དེ་གོན་འདུག་པས།",
    "དེང་ཐོག་ཆུ་ཁོལ་ལེན་དུ་རང་ཉིད་དངོས་སུ་མ་སོང་བར་བྱིས་པ་དག་མངགས་པ་ཡིན་མོད།",
    "དེའི་ནང་དོན་ནི་ད་ལྟ་ཁྱོད་རང་ཆུ་ཁོལ་ལེན་དུ་ཡང་ཡོང་མི་ཕོད་པས་ང་ལ་དེ་ཙམ་སྐྲག་གིན་འདུག་གམ་ཞེས་འདྲི་བ་དང་འདྲ།",
    "འདང་རེ་བརྒྱབ་ན་ངས་ཀྱང་རྐུ་བྱས་པ་མ་ཡིན་པས་དེ་འདྲ་སྐྲག་དོན་ཅི་མི་རྒྱ་སྐ།",
    "ཉིན་གུང་དེར་ངས་ཇ་དེམ་ཁྱེར་ནས་རང་ཉིད་དངོས་སུ་ཆུ་ཁོལ་ལེན་དུ་སོང་བ་ཡིན།",
    "ངས་མགོ་ལྡེམ་ཙམ་གྱིས་ཨིན་ཞེས་ཡིན་པའི་བརྡ་བྱིན་རྗེས་མྱུར་མོར་ཇ་དེམ་ནང་དུ་ཆུ་ཁོལ་བཅུས་པ་ཡིན།",
    "ང་རང་ཧད་སེར་བཏང་སྟེ་ཨེན་ཙམ་གྱིས་ལག་པའི་ནང་གི་ཇ་དེམ་ཡང་ས་རུ་ལྷུང་ལ་ཁད་དུ་གྱུར།",
    "ཁོ་མོ་ནི་ངོ་མ་བུ་མོ་ཡ་རབས་ཤིག་ཡིན།",
    "དེ་ངོ་མ་བདེན་ཚེ་ཁོ་ཚོས་ཁྱོད་རང་ཁྱི་རྒན་གསོད་མཁན་རེད་ཟེར་མི་སྲིད་ཨང་ཟེར།",
    "ངས་ཀྱང་དེ་མུར་ཁོང་ཚང་གི་ཁྱི་རྒན་བསད་པའི་དོན་དག་འདྲི་བསམ་པ་ཡིན་འདུག་སྙམ་ནས་དེ་གར་ལངས་ནས་བསྡད་པ་ཡིན།",
    "ཉེ་སར་མ་ཐོན་པའི་དུས་ནས་ཁྲོས་ཏེ་ངོ་མདངས་དམར་པོར་གྱུར་འདུག་པར་མ་ཟད་ཁ་ནས་ལྡབ་ལྡིབ་མང་པོ་ཞིག་ཟློ་བཞིན་འདུག་ཁོ་རང་ངའི་གམ་དུ་ཐོན་མ་ཐག་ཏུ་སྐད་ཆ་གཞན་ཅི་ཡང་མེད་པར་ཐད་ཀར་ཁྱོད་ཀྱིས་ངེད་ཚང་གི་ཁྱི་རྒན་གསོད་དོན་ཅི་ཡིན་ཞེས་དྲིས་བྱུང་།",
    "ངས་ཁྱོད་ལ་འདྲི་བཞིན་པའང་དེ་ཟེར་བ་ཡིན།",
    "ཧར་རེར་ངའི་གདོང་ལ་ཅེར་ནས་ཁྱོད་ཀྱི་སྐད་ཆ་དེའི་ནང་དོན་ཅི་ཡིན་ཟེར།",
    "ང་ཁྱོད་ཀྱི་ལག་ནས་ཤི་ཐབས་བྱེད་རྒྱུ།",
    "ཁོ་མོས་སྐད་མཐོན་པོས་ཁྱོད་གཉིས་ཀས་དེ་ལྟར་མིག་སྟོན་མ་བྱེད།",
    "བྱིས་པ་འདི་འདྲ་མང་པོ་ཞིག་གིས་བལྟས་འདུག་པ་མི་མཐོང་ངམ།",
    "ངེད་ཚང་གི་ཁྱི་རྒན་གསོད་མཁན་ཁོ་རེད།",
    "ད་ནི་ཁྱི་ལ་རྡོ་བས་བརྒྱབ་པ་དོན་དག་ཆུང་ཆུང་རེད།",
    "ཕྱིར་སོང་ལ་འདང་ཞིབ་མོ་ཞིག་རྒྱོབས་ཤིག་ཟེར།",
    "ད་སོང་སོང་།",
    "ཁོ་རང་ཁྲིད་དེ་སློབ་གཙོའི་གཞུང་ལས་ཁང་གི་ཕྱོགས་སུ་བུད་སོང་ལ།",
    "ངས་ཆང་འཐུང་བཞིན་དུ་ད་སྔོན་གྱི་དོན་དག་ལ་ཡང་དང་བསྐྱར་དུ་འདང་རྒྱག་གིན་དུ་སློབ་གཙོ་ཀུན་བཟང་གི་སྟེང་ལ་བླ་ལྷག་ཏུ་འཁོན་སེམས་སྐྱེས་བྱུང་།",
    "དེ་རྗེས་སྒྲོལ་མ་སྐྱིད་ངའི་ཁང་བའི་ནང་དུ་ཡོང་བ་རྐྱལ་སྟོང་དག་གིས་མཐོང་ནས་ངས་སྒྲོལ་མ་སྐྱིད་ལ་བརྙས་བཅོས་བྱས་སོང་ཞེས་པའི་གཏམ་ཡམས་སྤེལ་བ་དག་ལ་དཔག་པ་ན།",
    "ཕལ་ཆེར་ཕྱི་དྲོ་ཧྲིལ་བོར་ངས་དེ་ལྟར་ཡར་དྲན་མར་དྲན་བྱེད་ཀྱིན་ཆང་འཐུང་སྟེ་ནུབ་ཇ་འཐུང་ཡོད་མེད་ཀྱང་མི་རྟོགས་པར་འདུག་མཇུག་མཐར་མཐའ་འཁོར་ཧྲིལ་བོ་མུན་པའི་ཡོལ་བས་བསྒྲིབས་ཏེ་ཕྱི་རོལ་གྱི་བྱིས་པ་ཚོའི་འུར་ཟིང་གི་སྒྲ་ཡང་འཇགས་པར་གྱུར་སོང་།",
    "ཁོ་ཚོས་ནམ་རྒྱུན་ང་རང་ནམ་ཚོད་ཕྱིར་ལོག་ཡོང་བར་ཉིན་ཞག་སོར་མོས་བརྩིས་ཏེ་རེ་སྒུག་བྱེད་པའི་ངང་ཚུལ་དག་དྲན་བྱུང་།",
    "ང་རང་བཟི་ཡོད་པས་ཡིན་ཡང་སྲིད་མོད་ངས་མིག་འཁྲུལ་བྱུང་བ་ཨེ་ཡིན་སྙམ་སྟེ་རེ་ཞིག་ཡིད་མི་ཆེས་པའི་ངང་ཞིབ་ལྟ་བྱས་ཏེ་སྡོད་དགོས་བྱུང་།",
    "ངས་ཀྱང་དངོས་གནས་ཁོ་མོ་ཡིན་པའི་གདེང་ཚོད་རྙེད་པར་གྱུར།",
    "རྫོགས་དྲོད་ལམ་ལམ་དུ་གྱུར་སོང་བར་མ་ཟད།",
    "སེམས་ནང་གི་སུན་སྣང་དང་སྐྱོ་གདུང་ཡོད་ཚད་ཀྱང་དེ་མ་ཐག་གཏན་བརྗེད་དུ་གྱུར་སོང་།",
    "ཡིན་ན་ཡང་ནམ་རྒྱུན་ཁོ་མོ་སླེབས་མ་ཐག་པའི་དུས་ནས་བཟུང་དགོད་བཞིན་དུ་ངའི་མིང་ལ་ཤིང་ཏོ་འབོད་བཞིན་དགའ་དགའ་སྤྲོ་སྤྲོས་ཀུ་རེ་སྣ་ཚོགས་རྩེ་བ་ཡིན་མོད།",
    "མཇུག་མཐར་ཁོ་མོ་ངའི་ཁ་གཏད་ཀྱི་མལ་ཁྲིའི་མཐའ་འགྲམ་དུ་བསྡད་ནས།",
    "ཅུང་ཙམ་མ་འགོར་བར་ཁོ་མོ་ཆང་གིས་བཟི་བ་ལྟར་མིག་ཆུ་ཤུར་ཤུར་དུ་གཏོང་བཞིན་ངུས་བྱུང་།",
    "ངས་དོན་དག་ཅི་ཞིག་བྱུང་སོང་བ་མ་ཤེས་པར་ཅིའི་ཕྱིར་ཞེས་དྲིས།",
    "ཁྱོད་རང་དགོངས་པ་མ་ཚོམ།",
    "སྐབས་འདིར་ང་རང་ཆང་གིས་བཟི་ཡོད་ནའང་ཅུང་རྟབ་རྟབ་པོར་གྱུར་ཏེ་ཡར་ལངས་དགོས་བྱུང་།",
    "གོམ་པ་འཁྱལ་མ་བདལ་གྱིས་ཕར་སོང་སྟེ་ནང་སྒོ་དམ་པོར་བརྒྱབ་ཅིང་དྲ་ཡོལ་འཐེན་རྗེས།",
    "ཕྱིར་སྔར་མལ་དུ་ཡོང་ནས་ཁྱོད་རང་མ་ངུ་ཨང་།",
    "ཁོ་མོས་ལག་ཕྱིས་མི་ལེན་པར་དེ་མ་ཐག་ཧར་གྱིས་ལངས་ཡོང་སྟེ་ངའི་སྐེ་ལ་འཁྱུད་བྱུང་།",
    "སྔར་བཞིན་ངུ་ཞོར་དུ་ཁྱོད་རང་སེམས་འཚབ་མི་དགོས།",
    "ངས་ཁྱོད་ལ་མི་འོས་པའི་རེ་བ་ཅི་ཡང་འདོན་མི་སྲིད།",
    "ཡིན་ཡང་ང་རང་ཁྱོད་ལ་དགའ་བ་ངོ་མ་ཡིན།",
    "དེ་སྔོན་ངེད་གཉིས་ངོ་འཕྲད་པའི་ཉིན་ནས་བཟུང་ང་རང་ཁྱོད་ལ་དགའ་བྱུང་།",
    "ཁྱོད་ཀྱིས་ཤེས་ཨེ་ཡོད།",
    "ཡིན་ན་ཡང་དགོང་མོ་དེར་ཁྱོད་ཀྱིས་ཨ་ཕར་དེ་ལྟར་དག་སེལ་བྱེད་དུས།",
    "ཁྱོད་ཀྱིས་ང་ལ་དེ་འདྲའི་བསམ་ཚུལ་བཟུང་མི་འདུག་པ་ངས་རྟོགས་བྱུང་།",
    "ཁོ་མོས་སྐད་ཆ་དེ་དག་གིས་ང་ལ་སེམས་འགུལ་ཐེབས་ཏེ་མགྲིན་པ་བརྣངས་པར་བྱས་སོང་།",
    "ཁོ་མོས་མགོ་བོ་འཕྲེད་དུ་གཡུགས་ཙམ་བྱས་ཏེ་མི་ངུ་བའི་བརྡ་སྟོན་གྱིན་ཡོད་ཀྱང་མིག་ཟུང་བཙུམས་པའི་བར་ནས་མིག་ཆུ་རང་བཞིན་གྱིས་བཞུར་ཡོང་གིན་འདུག་པར་མ་ཟད།",
    "ངས་ཁོ་མོའི་མིག་ཆུ་འབྱིད་པར་གཡོལ་ཙམ་ཡང་མི་བྱེད་པར་སྡོད་པར་བལྟས་ན་སྐབས་འདིའི་ངའི་ལུས་ཀྱི་འགུལ་སྐྱོད་རེ་རེ་ཡང་ཁོ་མོར་སེམས་གསོ་ཐེབས་བྱེད་ཅིག་ཏུ་གྱུར་ཡོད་པ་ལྟར་སྣང་།",
    "ངས་ཁོ་མོའི་ངོ་གདོང་ལག་པས་བསྐྱོར་བ་ན་ཁོ་མོའི་མིག་ཟུང་སྔོན་ལྟར་ཟུམ་ནས་མི་འབྱེད་པར་འདུག་ལ།",
    "ལྷད་མེད་རྣམ་དག་གི་ངོ་གདོང་དང་མེ་ཏོག་ལྟ་བུའི་མཆུ་སྒྲོས་ཆུང་ངུ་དེ་ང་དང་བར་ཐག་དེ་འདྲའི་ཉེ་བར་མ་ཟད།",
    "བརླན་ཆིལ་ཆིལ་གྱི་ཁོ་མོའི་མིག་ཆུ་ཡོངས་རྫོགས་རང་ཉིད་ཀྱི་མིག་ཆུ་དང་འདྲེས་ཏེ་ངའི་ངོ་གདོང་ཧྲིལ་བོར་ཁྱབ་ཅིང་ཚ་ལམ་ལམ་བྱེད།",
    "དེ་དང་ལྷན་དུ་ཁོ་མོ་པང་དུ་བཟུང་ནས་མལ་ཁྲིའི་སྟེང་དུ་བསྙལ་ཏེ་ཧུར་བརྩོན་གྱི་ལས་ལ་ཞུགས་པ་ན།",
    "ང་ནི་མི་བཟང་བོ་ཞིག་མ་རེད་ཅེས་བཤད།",
    "ངས་ཁྱོད་ལ་འདི་ལྟར་བྱ་མི་འོས།",
    "ངས་ཁྱོད་ལ་གཅེས་སྤྲས་བྱ་འོས་ཞེས་བཤད།",
    "ཁྱོད་ཀྱིས་འཛེམ་དོགས་བྱེད་མི་དགོས་ཟེར།",
    "ངས་ངུ་བཞིན་དུ་ངས་ཁྱོད་ལ་འདི་ལྟར་བྱེད་མི་འོས།",
    "ཁྱོད་ད་དུང་གསར་མོ་ཆུང་ཆུང་རེད།",
    "ང་ལ་ནི་ཆུང་མ་དང་བུ་ཕྲུག་ཡོད་པ་རེད་ཅེས་བཤད།",
    "ཁོ་མོ་ངུ་བཞིན་དུ་ཁྱོད་ལའང་ཁག་ཅི་ཡོད།",
    "ཆུང་མ་ཡོད་ཀྱང་ཐག་རིང་དུ་ཡོད་པ་རེད།",
    "ང་རང་ཡང་ཁྱོད་ཀྱི་ཚིགས་མལ་ཞིག་བྱས་ན་ཅི་ལ་མི་ཆོག་ང་ལ་འགྱོད་པ་མེད་ཟེར།",
    "མཇུག་མཐར་ངས་མུ་མཐུད་དུ་བསྲན་མི་ནུས་པར་གྱུར་བས་རང་ནུས་གང་ཡོད་ཕྱུངས་ཏེ་ཁོ་མོ་ཁྲིད་ནས་མདུན་དུ་བརྒྱུགས་དགོས་བྱུང་།",
    "དེ་མ་ཐག་ཡོད་ཚད་ལྷིང་འཇགས་སུ་གྱུར་སོང་།",
    "ང་རང་དེ་ལྟར་སྒྲོལ་མ་སྐྱིད་ཀྱི་ཉམ་ཞན་པའི་གཉོམ་སྐྱུང་གི་འཁུན་སྒྲ་དང་ངུ་སྐད་ཁྲོད་ལྡབ་ལྡིབ་ངང་གཉིད་སོང་བ་འདྲ།",
    "ཁོ་མོ་བདེ་བླག་ངང་ཡུལ་དུ་ཕྱིན་ཡོད་མེད་ལ་རྩད་གཅོད་བྱེད་དུ་འགྲོ་དགོས་སྙམ་ནས་མལ་ཁྲིའི་སྟེང་ནས་ཧར་གྱིས་ཡར་ལ་ལངས་པ་ཡིན།",
    "ང་ཚོ་ངོ་ཤེས་པའི་དུས་ཚོད་ཧ་ཅང་ཐུང་ན་ཡང་།",
    "དེང་ཐོག་ངའི་སེམས་ཀྱི་འཁྲུལ་སྣང་ཞིག་ལ་ཁྱོད་ནི་ངའི་མི་ཚེ་འདིའི་འཚོ་བའི་འདུན་མ་གཏོད་སའི་སེང་ཆེན་ནོར་བུ་དགྲ་འདུལ་དེ་ཡིན་པ་དང་།",
    "འོན་ཀྱང་ལས་ཀྱི་བཀོད་སྒྲིག་ཡོད་ཚད་དོན་དངོས་ཀྱི་འཚོ་བ་དང་ཅི་འདྲའི་མཐུན་ཐབས་བྲལ་བ་ཞིག་རེད་ཨང་།",
    "སྤྱིར་ན་ང་ཚོ་འཕྲད་པའི་དུས་ཚོད་ཧ་ཅང་འཕྱི་དྲགས་པས་ཀྱང་རེད།",
    "ངེད་གཉིས་ངོ་ཤེས་པའི་དུས་སུ་ཁྱོད་ནི་སྔ་མོ་ཞིག་ནས་ཆུང་མ་དང་བུ་ཕྲུག་གི་བདག་པོར་གྱུར་འདུག་པས་ང་ཚོ་སུས་ཀྱང་འཁང་ར་བྱེད་ཐབས་བྲལ་བ་རེད།",
    "འོན་ཀྱང་ད་ལྟ་བསམ་ན་ང་རང་འཆུགས་འདུག་གཞན་གྱི་ཁྱིམ་ཚང་དང་བཟའ་མིའི་བར་དུ་གཏོར་བཤིག་གཏོང་བ་དེ་ནི་མ་གཞི་ནས་ནོར་འཁྲུལ་ཞིག་རེད།",
    "ངས་མུ་མཐུད་དུ་རང་ཉིད་ཀྱིས་བརྒྱུད་མྱོང་བའི་སྐྱོ་སྡུག་གི་ཟློས་གར་དེ་མི་གཞན་ལ་མྱོང་དུ་འཇུག་མི་འདོད།",
    "གང་ལྟར་ད་ལྟ་ང་ཚོ་བཟའ་མི་གང་བོ་ཡང་བསྐྱར་ལྷན་འཛོམས་བྱུང་སྟེ་དགའ་དགའ་སྐྱིད་སྐྱིད་ངང་ཡོད་པ་མིན་ནམ།",
    "ངས་བསམས་ན་ངའི་གདམ་ག་འདིར་ཁྱེད་ཀྱིས་རྗེས་སུ་ཡི་རང་བྱེད་ངེས་པར་མ་ཟད་ཁྱེད་བཟའ་མི་གང་བོའི་འཚོ་བ་ཇི་སྲིད་བར་བདེ་སྐྱིད་ལྡན་པའི་རྒྱུ་རུའང་འགྲོ་ངེས་རེད།",
    "ངས་འཕྲིན་ཡིག་ཧྲིལ་བོ་བཀླགས་ཚར་བ་ན་གཞི་ནས་མི་ཚེའི་གནས་ལུགས་ཆེན་པོ་ཞིག་རྟོགས་སོང་བའི་སྣང་བ་སྐྱེས་པར་མ་ཟད་སེམས་ཁོང་ཡང་སྔར་ལས་དཀྱེལ་ཡངས་ཏྠི་གྱྱི་རྒྱ་བྷ་པར་གྱུར་བ་དང་རྣམ་རིག་ཀྱང་སྔར་ལས་ཇེ་གསལ་དུ་ལྡབ་འགའ་ཕྱིན་པ་ལྟར་གྱུར་སོང་།",
    "དུས་རབས་ཀྱི་འབག་བཙོག་སྟུག་པོའི་ཀློང་དུ་བྱིང་ནས་ཡུན་རིང་འགོར་སོང་བར་འདུག་ལ།",
    "ཐ་ན་རང་ཉིད་ཀྱི་ལོ་ན་རྒས་པའི་ཨ་མ་དང་ཚེ་གཅིག་འདུན་མ་བཅོལ་བའི་ཆུང་མ།",
    "ད་དུང་ཤ་ལས་ཆད་པའི་བུ་ཕྲུག་བཅས་ལ་འགན་འཁུར་བའི་འདུ་ཤེས་ཙམ་ཡང་མ་བྱུང་བར་འདི་ལྟར་རྨོངས་འཐོམས་ངང་གཉིད་སོང་བར་འདུག་རེད་ཡ།",
    "ད་ལྟ་ང་རང་ཡང་ཁྱིམ་ཚང་གི་འགན་ཁུར་ཕྲག་ཏུ་བབས་པའི་སྟག་ཤར་བ་ཞིག་ཡིན་པར་མ་ཟད།",
    "བུ་ཕྲུག་གི་ད་ལྟའི་འཚར་ལོངས་དང་མ་འོངས་པར་སྐྱེད་སྲིང་བྱེད་པའི་ཐད་ཀྱི་འགན་ཁུར་ཡོད་ཚད་ཀྱང་དང་དུ་ལེན་དགོས་པ་ཡིན་པས།",
    "མནོག་ཆུང་བའི་ཕོ་མོའི་འདོད་བརྩེ་ཡི་བསླུ་བྲིད་ཁོ་ན་ཙམ་ལ་མགོ་འཁོར་ནས་བསྡད་ན་ག་ལ་ཆོགསྒྲོལ་མ་སྐྱིད།",
    "ངའི་ཚེ་སྲོག་གི་བརྒྱུད་རིམ་ཁྲོད་གོ་གནས་གལ་ཆེན་བཟུང་བའི་བུ་མོ་ཨང་།",
    "ཨ་མས་ཡང་བསྐྱར་ཕ་ཡུལ་ནས་ཁ་པར་འབྱོར་བྱུང་།",
    "ངས་མགོ་ལྡེམ་ཙམ་བྱས་ཏེ་འདི་ནི་ངའི་ཨ་མའི་རེ་བ་རེད།",
    "དེ་མ་ཐག་གྲིམ་རིལ་ཞིག་བརྒྱབ་ནས་དེས་ན་དོན་དག་བསྒྲུབ་རྒྱུ་ལས་སླ་མོ་རེད།",
    "ང་རང་སོང་ནས་སྒྲུབ་ཆོག་ངས་ཁྱོད་ལའང་འདི་ཙམ་གྱི་རོགས་རམ་བྱེད་ལོས་ཐུབ་ཅེས་ཟེར་བ་དང་།",
    "སློབ་གཙོ་ཀུན་བཟང་ལ་དངོས་གནས་ནུས་པ་ཡོད་པར་འདུག་གཟའ་འཁོར་གཅིག་གི་ནང་དུ་ངའི་ལས་སྤོ་བྱེད་པའི་དོན་དག་ཡོངས་རྫོགས་བསྒྲུབས་ཚར་སོང་བར་མ་ཟད།",
    "འདིར་ངས་ཆེད་དུ་ཁྱོད་ལ་དགོངས་དག་ཞུ་རྒྱུ་ཡིན།",
    "ངའི་སེམས་ནས་ཀྱང་ཧ་ཅང་ཕངས་སེམས་ཆེ་བ་ཞིག་འདུག་ཟེར་བས་མི་ཚང་མ་གད་མོ་ཐག་གེར་བགད་བྱུང་།",
    "ང་ལ་ད་དུང་ནམ་རྒྱུན་སྒོ་སམ་སྟེང་དུ་ཡི་གེ་འབྲི་བའི་དུས་སུ་ཤེས་མེད་ཚོར་མེད་ངང་རང་ཉིད་ཀྱི་འཕོངས་ཚོས་སྟེང་དུ་ལག་པས་རེག་ཙམ་རེག་ཙམ་བྱེད་པའི་གོམས་སྲོལ་ཞིག་ཀྱང་ཆགས་པར་གྱུར།",
    "སུ་ཚང་གི་བྱིས་པ་རྩེ་རུ་སོང་ནས་ཕྱིར་མ་ཐོན་པའམ་སུ་ཚང་གི་ཕྱུགས་ཟོག་གང་ཞིག་དགོང་མོ་ཕྱིར་ལྷས་ལ་མ་འཁོར་ནའང་ཚང་མས་སྐྱ་བྷོ་ལ་དྲིས་དང་མཐོང་ཡོད་ངེས་རེད་ཟེར་ལ།",
    "ཕྱི་རོལ་ནས་མི་ཞིག་གིས་འབོད་ཀྱིན་པ་ཐོས་འཕྲལ་ཚེ་སྐྱིད་མྱུར་མོར་ཇ་ཁང་གི་སྒོར་བུད།",
    "རེ་ཞིག་ནས་རང་ཉིད་ཀྱི་ཡོང་དོན་གཞི་ནས་དྲན་པ་ལྟར་ཡང་བསྐྱར་སྐྱ་བྷོ་ཡུལ་ན་ཨེ་ཡོད་ཟེར།",
    "ཁྱོད་ཚང་གི་བོང་རྒན་ཤི་འདུག་ཅེས་པ་དེ་རེད།",
    "ཁ་འཁྱགས་འདིས་ཅི་ཟེར།",
    "ཁྱོད་མྱུར་མོར་སྒོར་ཤོག་དང་ཟེར།",
    "ད་སོ་མར་གཉིད་ལས་སད་པ་ལོས་ཡིན་སྙམ་པའི་ཉམས་ཤིག་མངོན་བཞིན་ཕྱི་ལག་གིས་མིག་འབྱིད་ཙམ་བྱས་ཤིང་།",
    "ཁྱོད་ཀྱིས་ངེད་ཚང་གི་བོང་བུ་མཐོང་བྱུང་ངམ་ཞེས་དྲིས།",
    "སྐྱ་བྷོས་སྔོན་ལྟར་ལྡབ་ལྡིབ་ངང་ཁྱོད་ཚང་གི་བོང་བུ་ཤི་འདུག་ཟེར།",
    "ཚེ་སྐྱིད་ཀྱིས་ད་སྔོན་སྐྱ་བྷོར་སྡིགས་པའི་སྐད་ཆར་ལད་མོ་བྱེད་པ་ལྟར།",
    "ཁ་འཁྱགས་འདིས་ཅི་ཟེར།",
    "ཁྱོད་ཀྱིས་བྱིས་པར་སྐྲག་བསླངས་ནས་ཅི་བྱེད།",
    "སྐད་ཆ་ཡོད་ན་དྲང་མོར་དྲིས་ན་མི་ཆོག་གམ་ཟེར།",
    "ངས་ངས་ཁོས་དོན་ངོ་མར་ངེད་ཚང་གི་བོང་བུ་མཐོང་ཡོད་མེད་དྲིས་པ་ཡིན།",
    "ཁྱོད་ཀྱིས་ཤི་རུ་བཅུག་པ་ག་ལ་ཡིན།",
    "རེད་ཡ།",
    "ཁྱོད་ཀྱིས་ཤི་རུ་བཅུག་པ་ག་ལ་ཡིན།",
    "ཁྱོད་ཀྱིས་ཤོད་དང་།",
    "གྲོག་མོ་གང་གི་ནང་དུ་ཤི་འདུག་ཅེས་ནན་ཏན་དུ་དྲིས།",
    "ད་ལྟ་ཁོ་མོས་གཞི་ནས་ད་སྔོན་ཆབ་མ་བླངས་པ་དྲན་ནས་བློ་འགྱོད་ཅིང་ཨོབཛྲསཱཏཱ་ཞེས་འགྱོད་བཤགས་ལན་འགའ་བྱས་རྗེས།",
    "བུ་མོ་ཚེ་སྐྱིད་ནི་རིམ་བཞིན་ནར་སོན་པ་དང་བསྟུན་ནས་ཁ་སྒོ་སྐྱེ་འབྲས་གཞན་ལས་མཚར་བས་མི་ཐམས་ཅད་ཀྱིས་གླེང་གཞིར་གྱུར་ཅིང་།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱིས་བློར་འབབ་པའི་མག་པ་བཟང་བོ་ཞིག་ལག་ཏུ་ཡོང་མིན་མི་ཤེས་པ་དང་བུ་མོར་གནས་བདག་མང་དུས་སུ་གནས་ལ་མ་བྱིན་ན་རྗེས་ནས་འགྱོད་ངེས་པའི་ཁ་དཔེ་ཡང་ཡོད་པས་རང་ཉིད་ཀྱི་སྐྱིད་སྡུག་ལ་བལྟས་ཏེ་བུ་མོ་གཅིག་པུ་སྡུག་ཏུ་འཇུག་མི་རུང་སྙམ་ནས་གནས་ལ་སྟེར་རྩིས་ལན་འགར་བྱས་ཀྱང་བུ་མོ་ཚེ་སྐྱིད་གཏན་ནས་ཡིད་འཐད་མ་བྱུང་།",
    "སྟག་གི་རི་མོ་ཕྱི་དང་མི་ཡི་རི་མོ་ནང་ཞེས་ཟེར་བ་ཅིས་མ་བདེན།",
    "ཚེ་སྐྱིད་མོ་ལོ་བཅོ་བརྒྱད་ལ་སོན་པའི་ལོ་དེར།",
    "མཚན་མོ་ཞིག་ལ་ཁོང་གསུམ་གས་ཡུལ་ནས་སྒོར་མོ་ཉུང་ཙམ་རེ་བརྐུས་ཏེ་ལུང་གོག་འདི་དང་གཉེན་ཚན་དག་ལ་ཁ་གྱེས་པ་རེད།",
    "ཚེ་སྐྱིད་ལ་མངོན་སུམ་གྱི་གཏམ་རྒྱུད་དེ་འདྲ་ཞིག་བྱུང་བ་ནས་བཟུང་སྔོན་ཆད་ལྟར་ཁོ་མོ་གཉེན་སློང་དུ་ཡོང་མཁན་མེད་པར་མ་ཟད།",
    "ལན་རེར་མི་གཞན་ལ་ཚེ་སྐྱིད་ཀྱི་སྐོར་ཁ་བརྡ་བྱེད་དུས་ཀྱང་མིང་ངོ་མ་ནས་མི་འབོད་པར་ངེད་ཚང་གི་བླུན་རྒན་མ་ཞེས་ཟེར་གྱིན་ཡོད་པས།",
    "ཞོགས་པར་ཁོ་མོ་གཅིག་པུ་རི་སྒང་དུ་ཕྱིན་ནས་གྲ་མའི་རྩད་པའི་བུད་ཤིང་འཐུ་བའི་དུས་དག་དང་།",
    "དགོང་དྲོ་རང་ཉིད་གཅིག་པུ་གྲམ་གཞུང་དུ་སོང་སྟེ་ཆུ་ཟོ་ནང་དུ་ཆུ་འཆུ་བའི་དུས་དག་ཏུ།",
    "ཧ་ཅང་ཁེར་རྐྱང་དང་དབེན་ཐིང་ངང་མདངས་ཡལ་ཏེ་ཡོད་པའི་ལུང་གོག་སྐམ་པོ་འདི་དང་གྲོང་ཚོ་ཐར་ཐོར་འདི་དག་ལ་ལྟ་བཞིན།",
    "དང་ཐོག་རང་ཉིད་ཀྱི་སེམས་སུ་རུ་མ་ལྟར་བསྙལ་བའི་མཛེས་སྡུག་གི་རེ་སྨོན་དང་།",
    "བར་དུ་མཛེས་པའི་རེ་སྨོན་མཐའ་དག་ཆར་རྗེས་ཀྱི་འཇའ་ཚོན་བཞིན་ཡལ་ནས་སྡུག་བསྔལ་གྱི་ས་བོན་དུ་གྱུར་ཚུལ།",
    "ད་ལྟ་རང་ཁྱིམ་དུ་གོ་རྒས་སུ་གྱུར་བའི་ཁར་ནམ་རྒྱུན་གྱི་རྣ་བར་གཟན་པའི་ཨ་མའི་ངན་སྨྲས་དང་ཁག་འགེལ་དག་ཡིད་ལ་འཁོར་གྱིན་སེམས་ཧ་ཅང་སྐྱོ་སྟེ་རང་ཉིད་གཅིག་པུས་སུས་ཀྱང་མི་ཚོར་བའི་ངང་མིག་ཆུ་བཏོན་པའང་ཉུང་ཉུང་ཞིག་ག་ལ་ཡིན།",
    "གདོང་གི་གཏིང་རུམ་དུ་འཛུམ་མདངས་ཤིག་མངོན་བཞིན་དུ་ཧ་ཅང་གཅེས་པའི་ངང་།",
    "ད་སྔོན་ཁྱོད་ངུ་དོན་ཅི་ཡིན་ཞེས་དྲིས།",
    "སྐྱ་བྷོས་ཉམས་ཅི་ཡང་འཇོག་གིན་མེད་པ་ལྟར་སྔར་བཞིན་ཅི་ཞིག་ལ་བསམ་བློ་གཏོང་གིན་ཡོད།",
    "ཁྱོད་ཀྱིས་རྫུན་གཏམ་པ་མིན་ནམ།",
    "ཨ་ཕྱིས།",
    "སྐྱ་བྷོས་སྔར་བཞིན་ཁོ་མོའི་སྐད་ཆ་མ་གོ་བ་ལྟར།",
    "སྤྱིར་ན་ཉིན་འདིར་ཁོ་རང་ཡུལ་ཚོའི་ཡིད་རྟོན་ཁང་དུ་བུ་ལོན་འཇལ་དུ་ཡོང་བ་ཡིན་པས་བུ་དོན་གྲུབ་ལ་ཁ་པར་གཏོང་དོན་གཞན་ཅི་ཡང་མེད་ལ་གཏོང་རྩིས་ཀྱང་མེད་མོད།",
    "འོན་ཀྱང་ཡིད་རྟོན་ཁང་གི་མགོ་གཙོ་བསྡད་མི་འདུག་པས་ཅུང་ཙམ་ལ་སྒུག་དགོས་ཟེར།",
    "དེ་གར་བསྒུགས་ནས་འདུག་རྒྱུ་ནི་ཧ་ཅང་དཀའ་མོ་ཞིག་ཡིན་པས་ཡུལ་ཚོའི་གཞུང་ལས་ཁང་དུ་སོང་ནས་དྲུང་ཡིག་བཀྲ་ཤིས་དང་ཁ་བརྡ་ཞིག་བྱེད་སྙམ།",
    "ཁོ་ཚོའི་ཁྲོད་ཀྱི་གསར་བུ་ཞིག་གིས་ཅུང་མ་རངས་པའི་རྣམ་འགྱུར་དང་བཅས་ཁྱོད་ལ་བྱ་བ་ཅི་ཞིག་ཡོད་དམ་ཅེས་དྲིས་བྱུང་།",
    "གསར་བུ་ཁ་ཡག་ཞིག་གིས་ཧ་ཅང་སེམས་ཁུར་བྱེད་པའི་རྣམ་འགྱུར་གྱིས།",
    "ད་དུང་དྲུང་ཡིག་མི་འདུག་པས་ཁྱོད་ཅུང་ཙམ་བསྡད་དེ་ཤོག་ཟེར།",
    "ཁོ་ཚོའི་མདུན་དུ་ཁོ་ལ་ཁ་པར་ཞིག་བཏང་སྟེ་རང་ཉིད་ཀྱི་ཆེ་བ་ངོམ་འདོད་ཀྱི་འདུན་པ་དེ་སྐྱེས་པ་རེད།",
    "ཅུང་མ་འགོར་བར་ཁོའི་འདོད་མོས་མངོན་འགྱུར་བྱུང་སོང་བ་སྟེ་དྲུང་ཡིག་བཀྲ་ཤིས་ནི་ཕ་རོལ་ཞིག་ནས་གཞུང་ལས་ཁང་གི་ཕྱོགས་སུ་འགྲོ་བ་མཐོང་།",
    "ཁོ་རང་ཡང་བསྐྱར་ཡུལ་ཚོའི་གཞུང་ལས་ཁང་གི་ནང་དུ་འཛུལ་བ་ན།",
    "ང་ནི་ངེད་ཚང་གི་དོན་གྲུབ་ལ་ཁ་པར་ཞིག་གཏོང་དུ་ཡོང་བ་ཡིན།",
    "ཕ་རོལ་བོས་ཁྱོད་ལ་དོན་དག་ཅི་ཡོད་ཅེས་ལྡོག་འདྲི་བྱས་སོང་།",
    "ཕ་རོལ་བོས་ཁྱོད་ཀྱིས་ཅུང་ཙམ་སྒུགས་རོགས།",
    "ཁ་པར་ཁོང་གི་ལག་ཏུ་འཇུག་ཟེར།",
    "ང་ནི་ཨ་ཕ་ཡིན་ཞེས་བཤད།",
    "ཨ་ཕ་ཡིན་ནམ།",
    "ཡུལ་ནས་ཚང་མ་བདེ་མོ་ཡིན་ནམ་ཞེས་འཚམས་འདྲི་བྱས།",
    "འོན་ཀྱང་ཁེ་ཉིན་ཞིག་ལ་འུ་ཚང་གི་བོང་རྒན་ཤི་སོང་ཞེས་བཤད།",
    "ཕ་རོལ་བོ་ནས་དགོད་ཙམ་བྱས་ཏེ་ཇི་ལྟར་ཤི་བ་རེད་ཟེར།",
    "བོང་རྒན་སྔ་དགོང་མོ་ཡུལ་དུ་མ་ཡོང་ཐལ།",
    "ང་ཚོས་ནི་སུ་ཚང་ཞིག་གི་གཡུལ་ཁའི་ནང་དུ་ལྡིང་བ་ཨེ་ཡིན་ནམ་སྙམ་སྟེ་བཙལ་དུ་མ་སོང་།",
    "ཁྱོད་ཀྱི་ཨ་མས་ཀྱང་བཙལ་དུ་འགྲོ་ག་ལ་དགོས་ཟེར།",
    "བོང་རྒན་ནི་ནམ་རྒྱུན་དགོང་མོར་ཡུལ་དུ་ཡོང་གིན་ཡོད་པས་ང་ཚོས་ཀྱང་ཁ་ཡ་མ་བྱས་པ་ཡིན།",
    "འོན་ཀྱང་ཕྱི་ཉིན་དགོང་མོ་ཡང་ཡུལ་དུ་ཐོན་མ་བྱུང་།",
    "ངོ་མ་སྐྱ་བྷོ་ལ་མཁྱེན་པ་ཡོད་པ་དང་གཅིག་མཚུངས་རེད།",
    "འོན་ཀྱང་ཚོད་ལྟ་ཞིག་བྱེད་དགོས་སྙམ་ནས་སོང་བ་ན།",
    "ལུང་བའི་ནང་དུ་གྲོག་ཤུར་ཟབ་མོ་ཞིག་ཡོད་ཨང་།",
    "མིག་གིས་ཕྱི་སྒོར་བུད་ཟིན་པའི་མི་དག་གི་རྗེས་སུ་ལྟ་བཞིན་ཁ་པར་རྣ་བར་གཏད་དེ་སྐད་མགོ་ཇེ་དམར་བཏང་ནས།",
    "ད་དུང་ཁྱོད་ལ་གྲོས་བྱེད་རྒྱུ་ཞིག་འདུག་ཅེས་བཤད།",
    "ཁྱོད་དང་ཆུང་མ་གཉིས་དངོས་གནས་འགྲིག་ཐབས་མི་འདུག་གམ།",
    "རེ་ཞིག་ནས་ཚིག་ཐག་ཆོད་པའི་ངང་ཁོ་མོ་དང་ལྷན་དུ་སྡོད་ཐབས་མི་འདུག་ད་ནི་ཅི་བྱེད་དགོས་པའང་མི་ཤེས།",
    "དེ་ལས་ལས་ཀ་མེད་པའི་བུད་མེད་ཅིག་ཁྱིམ་ཐབ་ཏུ་བླངས་ནས་བག་ལྷོད་པོས་རང་ཁྱིམ་ལ་བདག་བྱེད་དུ་བཅུག་ན་བཟང་བ་འདྲ་ཟེར།",
    "ཁོ་མོ་ནི་ང་དང་བསྡུར་ན་ལོ་ཧ་ཅང་ཆུང་བ་མ་ཡིན་ནམ་ཟེར།",
    "ད་ནི་ལོ་ཉེར་ལྔ་ཉེར་དྲུག་ལ་བུད་ཟིན་པ་རེད།",
    "བུ་མོ་ཚོར་མཚོན་ན་ལོ་སུམ་ཅུར་སོན་ཚེ་རྒས་སོང་བ་རེད་ཟེར།",
    "ཁོ་མོར་ད་དུང་བྱིས་པ་ཞིག་ཀྱང་ཡོད་པ་མ་རེད་དམ།",
    "ཁྱོད་གཉིས་ལ་བདག་བྱེད་དུ་འཇུག་མི་སྲིད་ཟེར།",
    "ཁོ་རང་ཡིད་རྟོན་ཁང་གི་སྒོ་ནང་དུ་འཛུལ་བ་ན་ཡིད་རྟོན་ཁང་གི་འགོ་གཙོ་ནི་བུན་ལེན་དུས་སུ་བཙན་པོ་གཞི་བདག་ལྟར་ཡོད་ཀྱང་དངུལ་བུན་འཇལ་དུས་ནི་ཁ་ངོ་འཛུམ་གྱིས་ཁེངས་ཡོད་པ་རེད།",
    "ཨ་ཁུ་ནི་ངོ་མ་མི་སྔོན་ཐོན་ཅན་ཞིག་རེད།",
    "འདི་ལྟར་བུ་ལོན་དུས་ལྟར་འཇལ་ན་རྗེས་ཕྱོགས་ཀྱང་བུན་ལེན་སླ་བ་རེད་ཟེར།",
    "སྒོར་མོ་ཕར་སྤྲད་དེ་འགྲོ་ལུགས་ཀྱི་རྩིས་ཐོ་བརྒྱབ་ཚར་མཚམས་ཁ་ཕྱིར་འཁོར་ནས་འགྲོ་རྩིས་བྱས།",
    "ཡིད་རྟོན་ཁང་གི་མགོ་གཙོས་ཁྱོད་ལ་དོན་དག་མེད་མོད།",
    "ངས་ཁྱོད་ལ་སྐད་ཅིག་བསྐུར་དགོས་པས་ང་ཚོར་རོགས་རམ་ཞིག་བྱོས་ཟེར་བཞིན་མྱུར་མོར་འབྲི་དེབ་ཅིག་ཕར་སློག་འགའ་བྱས་རྗེས་དེ་མ་ཐག་ཏུ་རང་ཉིད་ཀྱི་དམིགས་བྱ་རྙེད།",
    "ཁོང་ཚང་གིས་མྱུར་མོར་མི་འཇལ་ན་ཆད་པ་ལྕི་མོ་སགཅོད་དགོས།",
    "རེད་ཏེ་ཁོང་ཚང་ལ་དཀའ་ངལ་ཡོད་པ་རེད་ཡ།",
    "མགོ་གཙོ་དེས་ཅི་མི་སྙམ་པའི་ངང་ཁུག་མ་ལས་དུ་བ་རྐང་གཅིག་བླངས་ཏེ་མེ་སྒོ་བཞིན་དུ་ན་རེ།",
    "དཀའ་ངལ་ཡོད་ཀྱང་ཐབས་བཀོད་འཐེན་ཏེ་བུ་ལོན་བཅལ་རྗེས་སླར་ཡང་བུན་བླངས་ཆོག་པ་མ་རེད་དམ་ཅེས་ཟེར།",
    "ཚེ་སྐྱིད་ཀྱིས་གྲམ་གཞུང་ནས་ཆུ་ཁུར་ཏེ་ཁྱིམ་དུ་ཐོན་དུས་ཉི་མའང་ནུབ་ལ་ཉེ་ཡོད་པ་རེད།",
    "ཁོ་མོས་ཆུ་ཟོ་ཇ་ཁང་དུ་ཕོག་རྗེས་སླར་ཡང་ལྷས་དཀྱིལ་དུ་ཡོང་ནས་སླེ་བོ་ཁུར་ཏེ་གཡུལ་ཁའི་ནང་དུ་ཀེ་རྩྭ་ལེན་དུ་སོང་།",
    "ཁོ་མོ་དེ་གར་ཅུང་ཙམ་ལ་འགྲེང་ནས་ཕལ་ཆེར་རང་ཉིད་ལ་འཁྲུལ་སྣང་འདྲ་སྐྱེས་བ་ཨེ་ཡིན་སྙམ་ནས་ཕྱིར་སྔར་མལ་དུ་ཡོང་སྟེ་ཀེ་རྩྭ་ལེན་བཞིན་པའི་སྐབས།",
    "ཁྱོད་སྐྲག་སོང་ཨང་།",
    "ད་ལྟ་ལོ་ན་སུམ་ཅུར་བུད་ཟིན་ཡང་ཆུང་མ་མ་རྙེད་པར་ད་དུང་མི་ཧྲེང་དུ་བསྡད་ཡོད་པ་རེད།",
    "བླུན་རྒན་འདིས་ཅི་ཞིག་བྱེད་ཀྱིན་འདུག་ཚེ་སྐྱིད་དེ་མུར་ཚིག་པ་ཟོས་ཏེ་ཁོ་ལ་སྡང་མིག་གིས་བལྟས་ཤིང་ཁྱོད་ཀྱིས་འདི་གར་ཅི་ཞིག་བྱེད་ཀྱིན་ཡོད་ཅེས་སྨྲས།",
    "སྒུ་རུས་ཁོ་མོའི་རྣམ་འགྱུར་ལ་དོ་སྣང་མི་བྱེད་པར་འཛུམ་ཤིག་ཤིག་ངང་།",
    "ཁྱོད་ལ་བསྒུགས་ནས་བསྡད་ཡོད་ཟེར་ནས་ཉེ་སར་བཅར།",
    "སྒུག་དོན་ཅི་ཞིག་ཡོད་དམ་ཞེས་ཟེར་ནས་མུ་མཐུད་དུ་སླེ་བོའི་ནང་དུ་ཀེ་རྩྭ་འཇུག་རྩིས་བྱས་ཀྱང་ཁོ་དེ་མ་ཐག་ཏུ་ཁོ་མོར་འཐམས་ནས་སར་བསྒྱེལ་བྱུང་ལ།",
    "ངས་ཁྱོད་ཆུང་མར་ལེན་རྒྱུ་ཡིན་ཟེར་ནས་འོ་བྱེད་རྩིས་བྱས།",
    "ཚེ་སྐྱིད་ཀྱིས་ཁོའི་ལུས་འོག་ནས་འཕག་འཚག་རྒྱག་བཞིན་དུ་མྱུར་དུ་ང་གློད་ཅིག་སུ་ཞིག་ཁྱོད་ཀྱི་ཆུང་མ་བྱེད་དམ་ཟེར།",
    "ཁོ་མོའི་ཁ་རླངས་ཀྱི་དྲི་ཞིམ་མནམས་པ་དང་ལྷན་དུ་སྒུ་རུ་ནི་སྔར་བས་ཀྱང་སྨྱོས་པ་ལྟར་གྱུར་ཏེ་ཁོ་མོའི་མཇིང་བ་དང་འགྲམ་པ།",
    "ངེད་གཉིས་འདྲ་མཚུངས་ཡིན་པ་མིན་ནམ་ཟེར་ནས་ལག་གཡོན་པས་ཁོ་མོའི་རྐང་སྣམ་གྱི་ཁ་ཐག་ལ་རེགཚེ་སྐྱིད་ཀྱིས་སྲོག་དང་བསྡོས་ནས་འཕག་འཚག་ཇི་ལྟར་བྱས་ཀྱང་ཁོའི་ལུས་འོག་ནས་ཐར་མ་ཐུབ་ལ།",
    "ཨག་སྐད་འདོན་བཞིན་དུ་ངའི་ཨ་མར་གཅར་རྡུང་བྱས་མི་ཆོགངའི་ཨ་མར་གཙར་རྡུང་བྱས་མི་ཆོག་ཟེར་བཞིན་སྒུ་རུའི་ལུས་སྟེང་དུ་འཐམས་བྱུང་བས།",
    "སྒུ་རུ་ནི་རེ་ཞིག་ཅི་བྱ་གཏོལ་བྲལ་དུ་གྱུར་ནས་ཚེ་སྐྱིད་གློད་ཅིང་གཡུལ་ཁའི་གྱང་སྟེང་ནས་ཕྱིར་མཆོངས་ཏེ་བྲོས་སོང་བ་རེད།",
    "ཁྱིམ་ནང་ཡོངས་རྫོགས་ཧ་ཅང་ལྕི་བའི་མཁའ་དབུགས་རིམ་པ་ཞིག་གིས་ཁེངས་ཏེ་དབུགས་ཀྱི་འབྱིན་རྔུབ་ཀྱང་བྱེད་དཀའ་བའི་ཚད་དུ་འདུག་ལ།",
    "ཨ་ཡེ།",
    "ཨ་ཁུ་སྒུ་རུས་ཨ་མ་ལ་དེ་ལྟར་གཅར་རྡུང་བྱེད་དོན་ཅི་རེད་ཅེས་དྲིས།",
    "ཁོ་མོས་སྔོན་ཆད་ཀྱི་དོན་དག་ཡོད་ཚད་རང་ཉིད་བྱིས་པར་གྱུར་བས་ལན་པ་ཡིན་པ་ཤེས་ན་ཡང་།",
    "མཇུག་མཐར་ཨ་མ་དང་སྐྱ་བྷོ་གཉིས་ཀ་ཉལ་བྱུང་བས་མོ་རང་གཅིག་པུ་མིག་མཐའ་མཆི་མས་བརླན་ནས་གོ་ཁ་ནས་ཡུན་རིང་བོར་བསྡད་རྗེས་ཉལ་བ་རེད།",
    "ཁོ་མོའི་ལུས་ལ་དར་ཟབ་དཀར་བོའི་ལྭ་རིང་གོན་ཞིང་མགོ་རུ་མེ་ཏོག་གི་ཕྲ་རྒྱན་སྤྲས་པ་དང་།",
    "ལན་རེར་ཁོ་མོས་འདི་ནི་མངོན་སུམ་ཡིན་ནམ་རྨི་ལམ་ཡིན་ནམ་སྙམ་སྟེ་རང་ཉིད་ཀྱི་ལུས་སྟེང་ལ་ཤ་བཙིར་བྱས་པ་ན་དངོས་གནས་ཚ་ཡི་འདུག་པས་རྨི་ལམ་མ་ཡིན་པ་ར་སྤྲོད་བྱུང་སྟེ་ཡིད་ཚིམ་པར་གྱུར་ཞིང་།",
    "ཁོ་མོས་ནམ་རྒྱུན་ལྟར་ཁྱིམ་དང་ཕྱི་ལྷས་ལ་གད་བདར་གཙང་མ་བྱས་ཤིང་།",
    "ལན་རེར་སྐྱ་བྷོ་ནི་ཤུལ་དུ་ཉལ་ནས་ཉིན་གུང་ཙམ་ལ་མ་གཏོགས་མི་ལངས་པས་ཁོ་རང་གི་རང་མོས་ལྟར་བྱེད་དུ་འཇུག་པ་ལས་དེར་ཇུས་གཏོགས་བྱེད་མཁན་གཅིག་ཀྱང་མེད།",
    "མི་ཞིག་ཡོང་གིན་འདུག་ཟེར།",
    "སྔ་རྒྱུ་ཡང་མི་འདུག་མོད།",
    "ཨ་མ་མལ་ལས་ལངས་ཟིན་ནམ་ཟེར་ཞོར་དུ་ཁྱིམ་ནང་དུ་འཛུལ་བྱུང་།",
    "ཁྱོད་གོ་ཁར་སྡོད་དང་ང་ཚོས་ལྷན་དུ་ནངས་ཇ་འཐུང་ཟེར།",
    "བུད་མེད་ལ་རྒྱ་ཅན་ཞིག་ཡིན་པས་དེ་མུར་རང་ཉིད་ཀྱི་ལ་རྒྱ་ཤོར་དུ་མ་བཅུག་པར།",
    "སྒོར་མོ་སྔོན་ནས་གྲ་སྒྲིག་བྱས་ཏེ་ཡོད་མོད་སྤྲོད་དུ་འགྲོ་མ་ཐུབ་པར་ད་བར་དུ་ལུས་སོང་བ་རེད།",
    "ཁྱིམ་ནང་དུ་མི་གོ་ཆོད་ཅིག་མེད་ན་འདི་འདྲ་རེད་ཟེར།",
    "འོ་ན་ཚེ་སྐྱིད་སྤྲོད་དུ་སོང་ན་མི་ཆོག་གམ།",
    "སྤྱིར་ན་ལག་ལ་མག་པ་ཞིག་ཨེ་ཡོང་སྙམ་པ་ཡིན་མོད།",
    "ཕ་རོལ་ན་ཇ་ལྡུག་གིན་པའི་ཚེ་སྐྱིད་ཀྱི་ངོ་མདངས་དམར་པོར་གྱུར་ཏེ་མགོ་འདེགས་མི་ཕོད་པར་གྱུར།",
    "ཤ་གཙང་རུས་གཙང་ཡིན་པས་མག་པ་ནི་ལག་ཏུ་ལོས་ཡོང་མོད།",
    "ངོ་མ་ད་ལྟའི་བྱིས་པ་དག་གི་དོན་དག་ཧ་ཅང་དཀའ་མོ་རེད།",
    "ང་རང་དེ་རིང་སྔ་སེ་ཡོང་དོན་ནི་ཁྱོད་ལ་བསམ་འཆར་ཞིག་འདྲི་རུ་ཡོང་བ་ཡིན།",
    "ཁོང་གཉིས་ཀ་ཡང་འགྲིག་གིན་མེད་པ་རེད་དམ།",
    "དེང་ཐོག་ངས་ཀྱང་དེ་ལྟར་བསམ་པ་ཡིན་མོད།",
    "ད་ལྟ་ཁོའི་བསམ་ཐོག་ཏུ་མི་འཇོག་ཐབས་མེད་དུ་གྱུར་སོང་ཟེར།",
    "འོ་ན་འོ་ན་ཁྱོད་ཚང་གི་དོན་གྲུབ་ལ་ངེད་ཚང་གི་ཚེ་སྐྱིད་རེད་ཡ།",
    "གཙོ་བོ་ཁོང་གཉིས་ཀ་འཐད་དགོས་པ་རེད།",
    "ངས་ཀྱང་ཁོ་མོའི་བསམ་འཆར་བླངས་ཆོག་ཁྱོད་ཀྱིས་ཇ་འཐུང་དང་ཟེར།",
    "མིང་ནས་འབོད་དུས་ཀྱང་བླུན་མོའམ་ཡང་ན་མིང་ནས་མི་འཛིན་པ་སོགས་གཏན་ནས་མི་བྱེད་པར་ཚེ་བྷོ་ཞེས་འབོད་པ་དང་།",
    "མི་གཞན་ལ་ཁ་བརྡ་བྱེད་པའི་དུས་སུ་ཡང་ངེད་ཚང་གི་ཚེ་བྷོ་ཞེས་ཟེར་ཞིང་།",
    "ཁོང་ཚང་གི་བུ་མོ་ཚེ་སྐྱིད་ཀྱི་བཟང་ཆ་མང་པོ་ཞིག་བརྗོད་པ་སྟེ།",
    "བྱིས་པས་སྐྱོན་ལས་པ་ནི་མི་སྲིད་པ་ཞིག་མ་རེད།",
    "ཁྱོད་ཀྱིས་ཁོ་མོར་ལེ་ལན་དེ་འདྲ་མ་བཤད།",
    "བུ་མོ་འདི་འདྲའི་ཡག་པ།",
    "འདི་འདྲའི་བཟང་མོ་ཞིག་ལ་གནས་བདག་མེད་པ་ག་ལ་སྲིད།",
    "གལ་ཏེ་དོན་གྲུབ་ལྟ་བུ་ཞིག་གི་ཆུང་མར་གྱུར་བ་ཡིན་ཚེ་མི་ཚེ་གང་བོར་ལུང་གྲོག་སྐམ་པོ་འདི་ནས་ས་འབད་རྡོ་འབད་བྱས་ཏེ་སྡོད་ག་ལ་དགོས།",
    "མཁར་གྲོང་དུ་སོང་ནས་ཁང་བ་ཡག་པོའི་ནང་དུ་གྱོན་གོས་གྲལ་དག་གོན་ནས་བསྡད་ཆོག་པ་རེད་ཟེར་ཞིང་།",
    "འགའ་རེས་ད་དུང་ཚེ་སྐྱིད་ལ་ཀུ་རེའི་ཚུལ་དུ།",
    "ཁ་ལོ་བ་ཞིག་གི་ཆུང་མར་འགྱུར་ངེས་རེད།",
    "དེ་དུས་སུ་ང་ཚོ་རླངས་འཁོར་ནང་དུ་འཁྱེར་རྒྱུ་བརྗེད་མི་ཉན་ཡ་ཟེར་ནས་གད་མོ་དགོད་པར་བྱེད།",
    "ད་ལྟ་བུ་མོ་དེ་དག་གི་རེ་སྨོན་དེ་རང་ཉིད་ཀྱི་ཐོག་ནས་མངོན་འགྱུར་བྱས་སོང་བས་ཁོ་མོའི་རེ་ཐག་ཆད་པའི་མིག་ཟུང་ལ་རེ་བ་དང་ཡིད་ཆེས་ཀྱི་འོད་མདངས་བསྐྱར་དུ་འཚེར་ཞིང་མཛེས་པའི་ལང་ཚོ་ལ་གསོན་ཤུགས་བསྐྱར་དུ་རྒྱས་ངེས་པ་སྨོས་ཅི་དགོས།",
    "སང་ཉིན་མི་ཁོམ་མོད།",
    "ཉིན་འགའ་ཡི་རྗེས་ནས་ཁྱོད་ཡུལ་ཚོའི་ཡིད་རྟོན་ཁང་དུ་སོང་ལ་བུ་ལོན་དེ་སྤྲོད་རྒྱུ་བྱོས།",
    "ངའི་བུ་མོས་ད་བར་དུ་གྱོན་གོས་ཡག་པོ་ཞིག་ཀྱང་གོན་ཐུབ་མེད་པས་ད་དུང་རང་ཉིད་ཀྱི་བློར་འབབ་པའི་ལྭ་བ་ཞིག་ཀྱང་ཉོས་ཤིག་ཟེར།",
    "ཨ་མའི་སྐད་ཆ་དེ་ཐོས་འཕྲལ་ཚེ་སྐྱིད་ཀྱི་མིག་ཟུང་ལས་དགའ་བ་དང་སྐྱོ་བ་གང་ཡིན་མི་ཤེས་པའི་མིག་ཆུའི་རྒྱུན་ཤུར་ཤུར་དུ་བཞུར།",
    "མཚོ་བོད་མཐོ་སྒང་གི་ནམ་ཟླ་ནི་དངོས་གནས་འདི་འདྲ་ཞིག་རེད།",
    "གྲང་ངར་ཆེ་བའི་དགུན་ཁའི་དུས་ཡུན་ཧ་ཅང་རིང་ཞིང་མཛེས་སྡུག་གི་དཔྱིད་དཔལ་ཤར་དུས་དབྱར་ཟླ་འབྲིང་བོ་ཚེས་ཟིན་པ་དང་དབྱར་ཟླ་ཐ་མ་ཕར་ཡོལ་མ་ཐག་སླར་ཡང་ཡུན་ཐུང་བའི་སྟོན་ཁའི་དུས་ཀྱི་མགོ་བརྩམས་ཟིན་པ་རེད།",
    "ཞིབ་ཏུ་བལྟས་ན་སྦྱར་སྡོང་རེ་རེའི་ཡལ་གའི་སྟེང་དུ་མྱུ་གུའི་མཆེ་བ་ཕྲ་མོ་དག་འཇབ་བུའི་ཚུལ་གྱིས་འབུས་ཀྱིན་འདུག་ཅིང་།",
    "ཉིན་འགའི་སྔོན་ལ་འདི་གར་ཁ་ཆར་འདྲེས་མ་ཞིག་བབས་པས་ས་ངོས་ཀུན་ཏུ་སོས་བུད་ཟིན་པ་ལྟ་བུའི་དྲོད་གཤེར་གྱི་མཁའ་དབུགས་མཐུག་པོ་ཞིག་གིས་ཁྱབ་འདུག་པ་དང་།",
    "ཁོ་མོ་ལམ་དུ་འགྲོ་བཞིན་དུ་སེམས་ལ་འཆར་སྣང་སྣ་ཚོགས་སྐྱེས།",
    "ལན་རེར་རང་ཉིད་དོན་གྲུབ་ཀྱི་ཆུང་མར་གྱུར་ན་ཡང་ནམ་ཞིག་རང་ཉིད་ཀྱང་ཁོའི་ད་ལྟའི་ཆུང་མ་ལྟར་དོར་ཨེ་འགྲོ་ལ་སེམས་ཁྲལ་བྱེད་པ་དང་།",
    "ལན་རེར་ཁོ་རང་རང་ཉིད་ལས་ལོ་ན་ཆེ་བས་ཁ་ཡ་ན་ཟླ་དག་གིས་འཕྱ་སྨོད་བྱས་ཨེ་ཡོང་ལ་ཡང་སྐྲག་འོན་ཀྱང་དོན་དག་དེ་དག་ཙམ་གྱིས་ཁོ་མོའི་བསམ་གཞིགས་ལ་རྡུང་རྡེག་ཅི་ཡང་བྱེད་མ་ཐུབ།",
    "རྒད་པོ་ཁྱོད་ཀྱིས་ང་རང་དོར་འདོད་ཀྱང་ང་རང་ཁྱོད་ཀྱི་ད་ལྟའི་ཆུང་མ་ལྟ་བུ་ཞིག་ཨེ་རེད་ལྟོས་ཞེས་སྙམ་པ་དང་།",
    "ཁྱོ་ག་རྒན་པའི་ལོགས་ནས་ཆུང་མ་སྐྱིད་ཟེར་སྲོལ་ཡོད་པ་ལྟར་ངས་ནི་རང་ཉིད་ཀྱི་བདེ་སྐྱིད་འཚོལ་བ་ཡིན་པས།",
    "ཡང་སྐབས་རེར་ཁོ་མོའི་སེམས་སུ་ད་སྔོན་གྱི་དེ་དག་ལས་ཀྱང་ཧ་ཅང་འཇིགས་སུ་རུང་བའི་དོན་ཞིག་དྲན་བྱུང་བ་སྟེ།",
    "ཁྱོད་ཀྱང་མི་བཟང་བོ་ཞིག་མ་རེད།",
    "ཁོ་མོའི་སེམས་ལ་གལ་ཏེ་ཁོས་ད་བར་དུ་རང་ཉིད་ལ་དོ་སྣང་ཅི་ཡང་བྱས་མེད་ཚེ།",
    "ཁོ་མོས་མུ་མཐུད་དུ་ཆིག་ལབ་རྒྱག་པའི་ཚུལ་དུ་ཧིན།",
    "ཁྱོད་ཀྱང་ལོ་ཆུང་ཞིག་མ་རེད།",
    "གལ་ཏེ་ཁོ་ཚོའི་ལག་ཏུ་སྒོར་མོ་མེད་པ་ཡིན་ན་བརྙས་བཅོས་ཀྱིས་གཅར་རྡུང་བྱེད་ཀྱིན་ཡོད་པས།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཡིད་རྟོན་ཁང་གི་མགོ་གཙོ་ཡང་ད་སོ་མར་གཞུང་ལས་ཁང་དུ་ཐོན་པའི་སྐབས་ལ་ཁེལ་ཡོད་པ་རེད།",
    "ཁོས་ཧུར་རེར་ཚེ་སྐྱིད་ལ་བལྟས་ཏེ།"
  ]
}