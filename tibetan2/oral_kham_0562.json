    "རྩ་ཙ་ན་ན་༥ཝཱདེ་དང་ངོ་བོ་དབྱེར་མི་ཕྱེད་པའི་བདེ་བ་ཆེན་པོ་གཉུག་མའི་ཡིད་ནི་ཏིང་ངེ་འཛིན་སེམས་དཔའ་ངེས་པ་དོན་གྱི་ཡི་གེ་ཡིན་ཏེ།",
    "དེས་སྣང་བའི་ཕྱིར་འབྲས་བུ་ཞེགོདེ་ཡང་རང་བཞིན་གྱིས་བྱིན་གྱིས་བརླབས་ཀྱིས་འབྲེལ་པ་དང་།",
    "ཞེས་བྱ་བའི་གནས་ཀྱི་རྒྱུ་ཡང་རང་རིག་པཉིད་ཁ་དོག་དང་།",
    "སྐྱེས་བུ་དང་རང་བཞིན་གཉིས་སུམེད་པའི་འཁོར་ཏེ།",
    "དཨོ་པོ་ཐམས་ཅད་ཀྱི་དེ་ཁོ་ན་ཉིད་ཤེས་པའི་ཤེས་རབ་ཀྱི་དགོངས་པ་ཡང་འདི་ཡིན་ལ་ལམ་དང་རང་བཞིན་གཉིས་ཀཡང་འདི་ལསམི་འདའ་བའི་ཕྱིར།",
    "དེ་ལས་རྒྱུ་ཏིང་རང་རིག་ཨ་དཀར་པོར་བསྒོམས་ནས་ཡི་གེའི་འཕྲོ་འདུ་ལ་སེམས་སྦྱང་བ་ཕྲ་བ་ཡིག་འབྲུ་དང་།",
    "སྐད་ཅིག་དུས་ཀྱིས་བསླབ་རྫོགས་ནས།",
    "འགྲོ་དང་འདུག་དང་ཉལ་བ་ན།",
    "དེ་བཞིན་ཉིད་དང་རང་བཞིན་དང་།",
    "འདི་ཙམ་ཞེས་བརྗོད་ཀྱིས་མི་ལང་བའི་ཕྱིར་རོ་ དེ་རྣམས་དང་རང་བཞིན་གཉིས་སུ་མེད་པར་བཞུགས་པ་ཡིན་ནོ། ། གཉིས་པ་གདུལ་བྱར་དགོས་ཆེད་དུ་བསྟན་པ་ཁྲོ་བོའི་གླེང་གཞི་ལའང་ཕུན་སུམ་ཚོགས་པ་ལྔ་ལས།",
    "ངོ་བོ་དབྱེར་མེད་དེ་ཡང་རང་རིག་མངོན་སུམ་དུ་ཡུལ་མེད་རང་གསལ་བསམ་བརྗོད་དང་བྲལ་བར་རྟོགས་པའི་ཕྱིར་མཚན་ཉིད་བློ་བྲལ་དུ་གཏན་ལ་ཕབ།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "དོན་དེ་དག་ཀྱང་རང་སྣང་རིས་མེད་ཅེས་པའི་དོན་མཐར་ཐུག་ཡིན་ལ།",
    "བདུན་པ་ཟག་མེད་རིག་འཛིན་ཐོབ་ནས་རྫུ་འཕྲུལ་གྱི་སྤྱོད་པ་ཞེས་ནུས་མཐུ་ཐོགས་པ་མེད་པའི་ཕྲིན་ལས་ཀྱིས་གཞན་དོན་རླབས་པོ་ཆེ་སྤྱོད་ཅིང་རང་རྒྱུད་ཀྱི་རྟོགས་པ་གོང་དུ་སྤོར་བའོ།",
    "དེ་ནས་ལས་དང་མཐུན་པའི་འདུག་སྟངས་དང་སྔགས་ཀྱི་རིང་ཐུང་དྲག་ཞན།",
    "དེ་ཉིད་མར་མེ་དང་རང་འོད་ཀྱི་ཚུལ་དུ་ཤེས་རབ་ཀྱི་སྣང་བ་རྣོན་པོ་དང་མི་འབྲལ་ལ།",
    "དེནས་ལྷའི་བུ་དེད་དཔོན་འདུས་པར་གྱུར་ཏེ་འདུག་གོ།",
    "ཉན་ཐོས་དང་རང་སངསརྒྱས་ཐམསཅད་ཀྱིཐེགཔདངརྗེསསུའཐུནས་ཤེས་པ་དང་།",
    "གནས་ཁང་ན་འདུགཀྱང་རུང་།",
    "འདུག་པས་བཅོམ་ལྡན་འདས་འདིཀྐདཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ལ་ལན་བྱས་ནས་ཕྱོགས་གཅིགཏུ་འདུགགོ།",
    "འདུག་གམ།",
    "ལྷག་པར་ཞེན་ཅིང་འདུག་པར་གྱུར་ནས།",
    "གང་རང་བཞིན་གྱིས་སྟོང་བ་དེ་གཉིས་སུ་མེད་དོ།",
    "བྱ་ཆུབ་སེམས་དཔའ་ཡི་ཤེས་སྒྲོནམའཛིན་ཅེས་བྱ་བ་དེར་འདུས་ཏེ་འདུག་པ།",
    "དེནས་འཇམ་དཔལ་གཞོན་ནུར་མྱུར་བགནས་དེ་ཉིད་ན་འདུག་པ་འདི་སྙམདུ་སེམས་ཏེ།",
    "དེ་ལ་ནམ་ཡང་བརྩོན་པར་མ་བྱེད་ཅིག་འདོད་ཆགས་ཞེ་སྡང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "སྣ་དང་ལྕེ་ཡང་རང་བཞིན་གྱིས།",
    "ཁྱེད་རང་ཅིའི་ཕྱིར་མི་བྱེད།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ལྷ་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ང་ལ་ལྷ་དེ་འདི་སྐད་ཅེས་བཙུན་པ་སྔོན་ཤིང་མཁན་རྒན་ཞུགས་བྱིས་པ།",
    "ཤིང་ཀན་ཙ་ན་དང་།",
    "བརྒྱ་བྱིན་འོངས་ནས་འདོད་པས་ཀུན་ནས་རྨོངས་ཏེ་བཤོལ་མེད་མ་དང་བག་ཕེབས་པར་རྩེ་ཞིང་འདུག་པར་གོ་ཏ་མས་བརྒྱ་བྱིན་ཡོད་པ་མ་ཤེས་པ་དེར་འོང་བས་བཤོལ་མེད་མས་ཤིན་ཏུ་འཇིགས་ཤིང་རྟབ་པས་བརྒྱ་བྱིན་གྱུར་མིད་དུ་བྱས།",
    "ནམ་ཞིག་དུས་ལ་བབས་ཏེ་འཆི་བའི་ཚེ་ལུས་དང་བྲལ་ཏེ་ནེ་ཙོས་འདོད་པ་ལས་རྒྱུ་གཞན་གྱིས་མྱ་ངན་ལས་འདས་པ་སྐྱེད་པ་དང་།",
    "སི་ཏཱ་ས་གཞི་དང་བཅས་སྲིན་པོའི་བཟའ་ཤིང་ར་བར་བཙོན་དུ་བཟུངས་ནས་འདུགཔར་མཐོང་།",
    "དེའི་ཚེ་དྲང་སྲོང་ཛ་ན་ཧུ་ཛ་ཧུ་ནུ་ཞེས་ཀྱང་འདུག་མཆན་ཞེས་དཀའ་ཐུབ་ཀྱིས་རི་ཁ་བ་ཅན་གྱི་སུལ་ན་རྣལ་འབྱོར་ལ་གནས་ཚེ།",
    "གྲོག་མཁར་པས་རཱ་མ་ཎའི་གཏམ་ལ་སོགས་པའི་ཚིག་དེ་དག་རྣམས་ལ་ནི་དངོས་དང་བརྒྱུད་པའི་སྒོ་ནས་གཞན་ལ་གནོད་ཅིང་རང་ཉིད་རྒྱལ་བར་བྱེད་པའི་ལས་ཡིན་པར་མ་ཟད་རྗོད་བྱེད་ཀྱི་ཚིག་རྣམས་ནི།",
    "ཆེན་པོ་ཤིན་ཏུ་མཛེས་ཤིང་ཉམས་དགའ་བའི་གནས་དེར་བསྡད་ནས་ཅི་དགར་བདེ་བ་ལ་སྤྱད་པར་བྱས་སོ་ཞེས་བཀའ་མཆིད་ཅེས་གཏམ་དུ་གྲགས་པ་གདའ་འོ་ཞེས་ཐོས་སོ།",
    "ཁྱབ་འཇུག་ཡུལ་བཅོམ་བརླག་ན་འདུག་པར་ཤེས་ཏེ་ཡུལ་ཐག་རིང་པོ་ཞིག་ནས་དང་པོ་དབྱུག་པ་ཆེན་པོ་ཞིག་སྔོན་དུ་འཕངས་ཏེ་རྗེས་རང་ཉིད་ཆས་སོ།",
    "དེང་སང་རང་བསྟོད་སྒྲ་སྙན་བརྒྱ་ལས་ཀྱང་།",
    "དེ་ཡང་རང་ལྡོག་ནས་མིན་གྱི་ འདི་ལ་དངོས་པོ་མེད་པའི་ཕྱིར།",
    "དེ་ཡང་རང་ལྡོག་ནས་མིན་གྱི།",
    "དངོས་སྟོབས་མེད་ན་ལུང་དུ་འདོད་ཀྱང་རང་ཚིག་ལས་སྟོབས་མི་ཆེ་བས།",
    "དེའང་རྩོད་པ་དང་དོན་དམ་ཡུལ་དུ་བྱེད་པའི་ཚེ་སྣང་བ་གང་ཡང་རང་བཞིན་མེད་པས་གཤིས་ལ་ཡོད་པར་ཁས་ལེན་མེད་པའི་ཕྱིར་ཁས་བླང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "དེ་ཡང་རང་ཕྱོགས་སྒྲུབ།",
    "དྲན་བསམ་ཐམས་ཅད་རང་བྱུང་རང་ཞི་ན།",
    "དགོས་ནའང་རང་གྲུབ་རྒྱུ་ཅི་དགོས།",
    "དེ་གསུམ་པོའང་རང་མཚན་གྱི་ཆ་ནས་མིན་ཏེ་གཞན་སེལ་བས་ཕྱེས་པའོ།",
    "ནམ་ཞིག་རང་འཆི་དུས་དུར་ས་ལ་བླ་དེ་གནས་ནས་ཕུང་པོ་དེ་ལ་བདག་ཏུ་འཛིན་ནས་འདུག་ཡོད།",
    "རྒྱལ་བ་རང་རང་རྣམས་ཀྱི་ཡུམ་རྣམས་དང་མཚན་པས།",
    "༡༡ རྐྱེན་སྣང་རང་གྲོལ་གྱི་གླུ་ཞེས་བྱ་བ་འབྱུང་རོ་སྙོམ་གྱི་གདམས་ངག་ལ་ལྡེབ།",
