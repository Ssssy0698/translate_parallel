    "དཔའ་བོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པའི་པང་ན།",
    "ཐུན་འཇོག་དུས།",
    "འགབ་འདྲེ་མེད་ཅིང་རང་གར་འགྲོ་བཀྲ་ཤིས་པ་ཡིན་ནོ།",
    "གཟུང་དོན་གཉིས་ཀ་དང་རང་དུས་སུ་སྔོན་པོར་༧ སྣང་བ་དེ་དེའི་སྣང་ཡུལ་ཡིན་ནོ།",
    "དངོས་མེད་དང་རང་ལྡོག་ནས་ནི་རྟོགས་པ་ཉིད་ལ་ཐོབ་པ་ཞེས་བརྗོད་ཀྱི།",
    "སྣང་བ་ཡང་རང་མཚན་ཁོ་ནའི་སྟེང་ནས་བཞག་པ་དང་།",
    "ཞེན་ཡུལ་གྱི་གཙོ་བོ་ཡང་རང་མཚན་ཁོ་ནའི་སྟེང་ནས་བཞག་པ་འདིས་ནི།",
    "འཇིག་རྟེན་གྱི་གྲགས་པ་དང་རང་ལུགས་ལ་ཁས་བླངས་ན།",
    "ཁྱེད་རང་འདོད་པའི་སྒྲུབ་བྱེད་གསུམ་པོ་དེ་ཞུགས་པའི་ཕྱིར།",
    "རྣམ་འགྱུར་རྣམས་ཀྱང་གནས་སྐབས་ཐ་དད་ཅིང་རང་བཞིན་གཅིག་པ་ཁོ་ན་སྟེ།",
    "ཤེས་བྱ་ལྟ་བུ་ལ་རྟོག་པ་གཞན་གྱིས་ལྡོག་པ་དུ་མར་ཕྱེ་ཡང་རང་འཛིན་རྟོག་པ་ལ་ལྡོག་པ་གཅིག་ཁོ་ནར་སྣང་བའི་ཕྱིར།",
    "རློམ་ཚོད་དམ་འཇུག་དུས་ཀྱི་བུམ་པ་དངོས་པོ་ཡིན་པའི་ཁྱད་པར་འདི་ངེས་པར་འབྱེད་དགོས་ཏེ།",
    "གལ་ཏེ་ཁས་ལེན་ན་དོན་རང་མཚན་དགག་སྒྲུབ་ཀྱི་དངོས་རྟེན་དུ་རུང་བའི་ཉེས་པ་སོ་ན་འདུག་གོ།",
    "རྫས་དང་རང་དངོས་པོ་དང་རང་མཚན་གཉིས་ཀ་ཡིན་ནོ།",
    "འདི་ལ་འཇུག་དུས་ཀྱི་མཚན་གཞི་ངོས་བཟུང་བ་དང་།",
    "རྫས་དང་རང་མཚན་ཡིན་པས་ཁྱབ་པ་ནི་མིན་ཏེ།",
    "སྒྲ་གང་རང་ལ་དོན་མེད་ཅིང་།",
    "ཐ་སྙད་ཐུག་མེད་ཁས་མི་ལེན་པ་ལྟར་མཚན་ཉིད་ཀྱི་མཚན་ཉིད་ཀྱང་རང་ལུགས་ལ་ཞལ་གྱིས་མི་བཞེད་པ་འདྲ་སྟེ།",
    "མཚོན་བྱ་གཞན་གྱི་མཚན་ཉིད་མིན་པ་ཞེས་འཆད་ཀྱི་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་མཚན་དང་རྟག་པ་གང་རུང་མིན་དགོས་པ་ཡིན་ཏེ།",
    "གཉིས་པ་མཚོན་བྱའི་རྣམ་བཞག་ལ་གཞན་ལུགས་དགག་པ་དང་རང་ལུགས་བཞག་པའོ།",
    "གྲགས་པ་དེ་ཡང་རང་རྒྱུད་ལ་ཡོད་དགོས་པས།",
    "ཁོ་བོ་ཅག་ལྟར་ན་ནི་དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "འདི་ལའང་རང་ངེས་དང་གཞན་ངེས་གཉིས་ལས།",
    "ཀརཎ་ཝཾཨ་ཙིཏྟཾ",
    "གང་གསར་དུ་རྟོགས་པ་དེ་དང་མཐུན་པའི་འཇུག་ཡུལ་རང་མཚན་ལ་མི་བསླུ་བའི་ནུས་པ་ཡང་ཁོ་རང་ཉིད་ལ་ཡོད་པ་ཡིན་གྱི།",
    "འོ་ན་མི་བསླུ་བར་ངེས་བྱེད་ཡང་རང་ཁོ་ན་ལས་སམ་ཞེ་ན།",
    "འཇུག་ཡུལ་གྱི་གཙོ་བོ་ཤེས་རྣམ་དེ་ཉིད་ཡིན་པའམ་བ་ལང་རང་མཚན་ལ་སོགས་པ་རྣམས་སོ།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "རང་རིག་མངོན་སུམ་ཐམས་ཅད་དེ་ཡིན་ན་དེའི་རྒྱུད་ཀྱི་དེ་མྱོང་རང་རིག་མངོན་སུམ་གྱིས་མ་ངེས་སོ་ཞེས་ཟེར་བ་དང་།",
    "དེ་ལྟར་རྟོགས་ཚུལ་གཉིས་ཀས་ཀྱང་རང་ཉིད་མི་བསླུ་བར་ཤུགས་ལ་རྟོགས་པས་རང་ལས་ངེས་སོ།",
    "རྗེས་དཔག་དེ་ལ་རང་ཉིད་མི་བསླུ་བ་ཡིན་པའི་དོན་སྤྱི་མ་ཤར་ཡང་རང་ཉིད་མི་བསླུ་བ་ཡིན་པ་ལ་སྒྲོ་འདོགས་བཅད་པ་ལྟ་བུའོ།",
    "གལ་ཏེ་མེ་དང་རང་མཚན་གྱི་དོན་སྤྱི་དེ་ཉིད་མེ་རང་མཚན་གྱི་རྣམ་པ་ཡིན་པས།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་མངོན་སུམ་ཡང་རང་རིག་མངོན་སུམ་ཁོ་ནར་འདུས་པ་ཡིན་ཏེ།",
    "ཡུལ་གྱི་སྒོ་ནས་དབྱེ་ན་ཡུལ་གཞན་མཐོང་བ་གཞན་རིག་མངོན་སུམ་གཉིས་དང་རང་མཐོང་བ་རང་རིག་མངོན་སུམ་དང་།",
    "གཉིད་འཇུག་པ་ཁོ་རང་ཉིད་ཡིད་ཤེས་འཁོར་དུ་བྱུང་བའི་སེམས་བྱུང་ཡིན་པའི་ཕྱིར།",
    "རྣལ་འབྱོར་མངོན་སུམ་དང་རང་རིག་མངོན་སུམ་དང་།",
    "ཕྱོགས་གླང་ཡབ་སྲས་ཀྱི་གཞུང་འགྲེལ་གང་ལས་ཀྱང་རང་རིག་ཡིད་མངོན་གྱི་དོན་དང་ཐ་སྙད་གཉིས་ཀ་མི་ཐོན་པའི་ཕྱིར།",
    "རང་རིག་པ་དང་རང་རིག་པའི་མངོན་སུམ་ལ་ནི་ཁྱད་པར་ཡོད་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་ཡིན་མི་དགོས་ཏེ།",
    "འཛིན་རྣམ་དང་རང་རིག་ཏུ་ཁས་བླང་བར་བྱ་བ་མིན་ཏེ།",
    "ཚུ་རོལ་མཐོང་བའི་རྒྱུད་ཀྱི་དོན་རིག་པའི་མངོན་སུམ་དང་རང་རིག་པའི་མངོན་སུམ་གཉིས་ལ་གཞི་མཐུན་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ལུགས་འདི་ལ་རང་རིག་དང་རང་རིག་པའི་མངོན་སུམ་ཡིན་ན་འཛིན་རྣམ་ཡིན་པས་ཁྱབ་པ་དང་།",
    "རྟོག་པ་ཡིན་ན་ཡང་རང་རིག་པ་ཡིན་དགོས་ཏེ།",
    "འོ་ན་རང་རིག་པ་དང་རང་རིག་ཙམ་ལ་ཁྱད་པར་དབྱེ་བ་དང་།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "གལ་ཏེ་དེ་ཉམས་སུ་མྱོང་བའི་ཤེས་པ་ཡིན་ན་དེ་མྱོང་རང་རིག་ཡིན་དགོས་སོ་ཞེ་ན།",
    "དེའི་རྒྱུད་ཀྱི་རང་རིག་པའི་མངོན་སུམ་སྒོམས་པ་ལས་བྱུང་བའི་རྗེས་ཐོབ་ཀྱི་ཤེས་པ་རྣམས་ཀྱང་རང་རིག་པའི་མངོན་སུམ་ཁོ་ནར་ཁས་ལེན་གྱི་རྣལ་འབྱོར་མངོན་སུམ་དུ་ཁས་མི་ལེན་པའི་ཕྱིར།",
    "དེ་ལྟར་ན་ཡང་རང་རྒྱལ་སློབ་པའི་སྣང་མེད་ཀྱི་རྣལ་འབྱོར་མངོན་སུམ་མི་འཆད་པ་ཅི་ཞེ་ན།",
    "གཞན་ལས་ངེས་དང་རང་ལས་ངེས་ཀྱི་ཁྱད་པར་ལས་སོ།",
    "འཛིན་རྣམ་དང་རང་རིག་ནི་བྱ་བྱེད་དང་རྣམ་པར་བཞག་འཇོག་གཉིས་ཀ་མཚན་ཉིད་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པའི་ཐ་སྙད་ཀྱི་སྒྲུབ་བྱེད་ཡིན་གྱི།",
    "གཟུང་རྣམ་དང་རང་རིག་ནི་རྣམ་པར་བཞག་འཇོག་བཏགས་པ་བ་དང་།",
    "ཕྱི་རོལ་གྱི་དོན་རྟོགས་པ་དང་རང་རིག་པའོ།",
    "ཁྱབ་པའང་ཁྱེད་རང་ལྟ་ན་ཁས་བླངས་སོ།",
    "མཤཱཀ་མཆོག་རྟོག་གེའི་འཁྲུལ་འཇོམས་སྨད་ཆ་ཅེས་པ་ཡང་རང་ལུགས་ལ་ཕྱི་རོལ་གྱི་དོན་གཞལ་བྱར་བསྒྲུབ་བཞེད་པ་མ་ཡིན་ཏེ།",
    "གཉིས་པ་ནི་ཁྱེད་ཀྱི་ཚད་འབྲས་དེ་ལ་ཁྱེད་རང་ལྟར་ན།",
    "ཡང་རང་རིག་ཡིན་ཡང་དོན་རིགས་འདོད།",
    "ལུས་ཀྱི་འགྲོ་འདུག་བྱ་བྱེད།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "སྤྱོད་ལམ་དེས་འདུག་པ་མཐོང་ན་ཤིན་ཏུ་དང་བ་སྐྱེ་བ་དང་།",
    "སེམས་ཀྱི་རང་བཞིན་ནམ་འདུག་ཚུལ་ཇི་ལྟར་ཡོད་པ་དེ་ག་ལྟར་མ་བཅོས་པར་འཇོག་པ་སྟེ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "ལུས་འགྲེང་བ་དང་འདུག་པ་སོགས་ཀྱི་གནས་སྐབས་ཐམས་ཅད་ལ་རྣམ་པར་དཔྱོད་པ་ནི་ལུས་སུ་གཏོགས་པའི་དྲན་པ་སྟེ།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "འགྲོ་དང་འཆག་དང་ཉལ་དང་འདུག་པ་ན།",
    "འཕྲལ་ཇི་ལྟར་འདུག་དང་། འདི་ལྟར་སྣང་སོགས་ད་ལྟའི་རྟོག་དཔྱོད་ཀྱང་ཡིད་ལ་མི་བྱེད་པར་སེམས་རང་གར་ལྷོད་དེ་ཤིག་གེ་བར་འཇོག་པ་ཡིན་ལ།",
    "བཀག་པས་ཁེགས་པར་མི་འདུག་དིང་རི་བ།",
    "རྣམ་རྟོག་ཁོ་རང་གང་བྱེད་དུ་བཞག་ཅེས་སོགས་ཁྲིད་ཡིག་ཏུ་གསུངས་པའི་ཕྱིར་འདི་ནི་ཞི་གནས་རང་ལ་དཔགས་པའི་ཁ་ཡན་དུ་སྐྱོང་བ་སྟེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "གཞན་དེ་ལྟར་འགྱུར་བ་མཐོང་བ་དང་རང་ཉིད་བདེ་འགྲོ་གསུམ་གྱི་ལོངས་སྤྱོད་མྱོང་བ་དང་།",
    "ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བ་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་ལ་སོགས་པའི་ཉམས་ཀྱི་སྣང་བ་འཆར་བའོ།",
    "དེ་དུས་ཀྱི་གནས་པ་དང་འགྱུ་བ་ངོ་ཤེས་མཁན་དེ་ལ་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའམ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་དང་རང་རིག་པ་ཞེས་ཀྱང་བྱ།",
    "དེས་གནས་འགྱུ་རང་བཞིན་མེད་པར་སྦྱངས་མཐར་ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་སུ་མེད་དེ་དཔེར་བཀོད་པའི་གཙུབ་ཤིང་དང་གཙུབ་གཏན་བསྲུབས་པ་ལས་སྐྱེས་པའི་མེས་ཤིང་གཉིས་བསྲེག་མཐར།",
    "ཕྱོགས་སྔ་མ་ལ་སུན་འབྱིན་ཅིང་ཡོད་པ་ཁྱེད་རང་ལ་བཟློག་པའི་ཕྱིར་དང་།",
    "གསལ་བའི་ངོས་བཟུང་དང་དེའི་རྣམ་པ་ཅན་དུ་འདུག་བརྟག་སྟོང་པར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་དང་བར་སྣང་ལྟ་བུའི་སྟོང་པ་ཇི་ལྟར་འདུག་བརྟག།",
    "གསལ་ན་ཉི་ཟླ་ལྟ་བུའམ་མར་མེ་ལས་འོད་འཕྲོ་བ་ལྟ་བུར་གསལ་བ་དང་འོད་དང་ཁ་དོག་མེད་པའི་རང་གསལ་དུ་འདུག་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟག་ཅིང་དཔྱད།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ་ནི།",
    "དེ་ལས་ཁོལ་ཕྱུང་སོགས་མིན་པར་ཁོ་རང་། རྐང་ཚུགས་པ་ཞིག་པས་བཀའ་གདམས་སུ་བརྗོད་དོན་མེད་ལ།",
    "ཁྱེད་ལྟར་ན་སེམས་རྟོགས་བྱེད་ཀྱི་རྐྱེན་རྩ་མདུད་གྲོལ་བ་དགོས་ཞེས་ཁས་ལེན་པ་ཁོ་ནར་འདུག་པ་ལ།",
    "ལུང་པ་གང་བའི་མི་ལ་ཡང་གྲངས་དེ་ཙམ་འདུག་དམ་སོམས་དང་།",
    "རང་ཡང་དེ་ལྟའི་ལས་བསགས་ཨེ་འདུག་སོམ་ལ་ཡིད་བདེ་བར་འདུག་ཕོད་དམ།",
    "སྡུག་བསྔལ་ཆེ་བ་ཚེ་རིང་བ་རིང་སྡུག་ཐུང་སྡུག་ཁོ་ན་ཡིན་པར་འདུག།",
    "ཞེས་སོགས་གསུངས་འདུག་པ་སོམ་དང་།",
    "ཞེས་གསུངས་པར་གདའ།",
    "གནས་འགྱུ་རོ་མཉམ་དུ་འདྲེས་ཤིང་རང་ངོ་ཤེས་པའི་དྲན་རིག་ཡོད་པ་གཅིག་དགོས་ཏེ་རྩེ་གཅིག་དུས་སུ་ངོ་བོ་རྟོགས་ཞེས་དང་།",
    "རང་ཞལ་མཇལ་བས་རང་དང་འདྲེས་། རང་མིན་པའི་དྲན་རྟོག་གཅིག་འདུག་གམ་ལྟོས་དང་།",
    "སེམས་བདེ་གསལ་མི་རྟོག་པའི་ངང་དུ་ས་ལེ་སེམས་གནས་པ་ཙམ་འདུག་ཀྱང་།",
    "མ་ཡེངས་རྩེ་གཅིག་ལྷོད་ཆ་ཡང་ཡོད་པ་བཟང་ན་ཇི་ལྟར་གྱི་ཉམས་ཤར་ཡང་རང་ངོ་གཉིས་འཛིན་དགག་སྒྲུབ་མེད་པའི་ངང་ནས་རང་ངོ་ཤེས་བཞིན་དུ་སྐྱོང་།",
    "སེམས་ཁོ་རང་ཕྱག་རྒྱ་ཆེན་པོའི་ངོ་བོར་ཤེས་པ་འོང་བ་ཡིན་ཏེ།",
    "ད་ལྟར་གྱི་ཤེས་པ་ཁོ་རང་ཡུལ་མེད་ཁྱུ་། དུ་རང་ངོ་ཤེས་པའོ།",
    "དེ་ཙ་ན་ངོ་བོ་རྙེད་པ་ཡིན།",
    "དེ་ཡང་དག་མ་དག་ལ་མ་ལྟོས་པར་སྐད་གཅིག་མར་སྐྱེས་ལ་མ་འགགས་པར་རང་ངོ་ཤེས་པ་དེ་ཡིན་པར་གསུངས་འདུག་གོ།",
    "དགག་སྒྲུབ་ཀྱི་དྲི་མ་ཅུང་ཟད་དང་མ་བྲལ་འདུག་ན་རྩལ་མ་རྫོགས།",
    "མཚན་རྟགས་ལ་སོགས་པ་བྱུང་ན་དེ་ལ་རློམ་སེམས་དང་དགའ་མི་དགའ་འདུག་ན་བདུད་ཞུགས་པ་ཡིན་པས།",
    "ད་དུང་རྟོགས་པ་དེ་གོམས་པར་བྱ་རྒྱུའམ་གསལ་དུ་འགྲོ་རྒྱུ་ཅུང་ཟད་ཙམ་ཞིག་འདུག་ན་ངོ་བོ་མ་མཐོང་།",
    "མི་རྟོག་ངོ་མ་ཤེས་ཀྱི་ཆ་ཅུང་ཟད་འདུག་ཀྱང་རྩལ་མ་རྫོགས།",
    "ད་དུང་ལུས་སེམས་སྣོད་བཅུད་ལ་མ་དག་པའི་སྣང་བ་དང་འཛིན་པ་ཅུང་ཟད་ཙམ་འདུག་ཀྱང་ཡོན་ཏན་མ་སྐྱེས།",
    "རིག་ཐོག་ན་གཉིས་སུ་འདུག་གམ་ལྟོས་དང་།",
    "འཁྲུལ་པ་བདོ་ཙ་ན་དེའི་རང་བཞིན་ཤེས་པས་འཁྲུལ་མེད་དུ་གཏན་ལ་ཕེབས་པས་ཡེ་ཤེས་སུ་ཤར་བ་སྟེ།",
    "རང་རང་བསམ་པ་ཇི་ལྟ་བར།",
    "རབ་ཏུ་དམའ་བའི་ས་ལ་འདུག།",
    "དེ་ཡང་རང་འབྱོར་ལྔ་ནི།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱི་ལྷ་ཡི།",
    "རང་ཉིད་སེང་གེའི་ཁྲིར་འདུག་པ་དང་།",
    "ཚེ་ཕྱི་མའི་འགྲོས་ས་ཚགས་སུ་ཚུད་པ་ནི་འདུག་གམ་མི་འདུག།",
    "དེ་ལྟར་མི་འདུག་ན་ཕུགས་སུ་བསྟོངས་ལ།",
    "བདག་ཚེ་འདིའི་ཆེ་ཐབས་དང་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡིད་ཁོངས་སུ་བཅུག་ནས་དེ་ལ་སྨོན་ཅིང་འདུག་སྟེ།",
    "གང་ཅི་མང་ཡང་སྡུག་བསྔལ་གྱི་སྣོན་པ་མིན་པ་བདེ་བའི་གོ་སྐབས་སྐད་ཅིག་ཀྱང་མི་འདུག་ན།",
    "འབྲས་བུ་ལ་ལོངས་སྤྱོད་ཀྱིན་འདུག་ན།",
    "ཐ་ན་འཇག་མའི་སྲིན་བུ་ཡན་ཆད་ཀུན་ལ་ཡོངས་བར་འདུག།",
    "ཚེ་ཕ་རོལ་བསམ་ན་རན་ནས་གདའ།",
    "འགྱུ་བ་ཁོ་རང་བལྟས་པས་མཐོང་རྒྱུ་ཅི་ཡང་མེད་པར་ཅུང་ཟད་དེ་ཁའི་ངང་ལ་གནས་པའི་ཚེ་རྣམ་རྟོག་ཐོལ་ཐོལ་འཕྲོ་བ།",
    "ད་ནས་རྣམ་རྟོག་ཁོ་རང་ལ་བསྒོམ་གྱི་ངོ་ཏི་གྱིས།",
    "ངོས་བཟུང་མཁན་ཁོ་རང་ལ་གཅེར་གྱིས་བལྟས་པས།",
    "གནས་པ་དང་འགྱུ་བ་གཉིས་སུ་མེད་པར་གཅིག་པུའི་ངང་དུ་འདྲེས་ནས་བསམ་བརྗོད་བྲལ་བར་གསལ་སེང་ངེ་བ་ཅིག་འདུག་ལགས།",
    "ལར་བསྒོམས་པའི་ཡོན་ཏན་ཉམས་ཀྱི་དྲོད་རྟགས་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོང་བར་འདུག་པས་ཁྱེད་ལ་ལེགས་པ་གཅིག་འོང་བའི་སྔ་ལྟས་ཡིན།",
    "བརྗོད་དུ་མ་གཏུབ་པ་ཅིག་འདུག་ལགས།",
    "དྲན་རིག་དུ་ལམ་གྱི་འགྲོ་བ་དཔེར་ན་མཚོ་ལ་ཁ་བ་བབས་པ་ལྟ་བུ་རང་གྲོལ་དུ་འགྲོ་བ་། ཅིག་འདུག་ལགས།",
    "ད་ཁྱེད་ཀྱི་གནས་ལུགས་ཇི་ལྟར་འདུག།",
    "སྤྲིན་ཐག་ཆད་པའི་ནམ་མཁའ་ལྟ་བུ་མཐའ་བྲལ་གྱི་ངང་དུ་ལྡེན་ལྷང་ངེར་གནས་པ་ཞིག་འདུག་ལགས།",
    "སྟོང་ཉམས་ཤིན་ཏུ་ཆེ་བས་རང་ལུས་ཀྱང་སྟོང་སྙམས་ནས་རང་བཞིན་བྲལ་བ་སེམས་དང་ལུས་སོགས་གཉིས་འཛིན་དང་སྟོང་འཛིན་ཞེན་འཛིན་མེད་པ་ཅིག་འདུག་ལགས།",
    "རྗེས་ཤེས་ཨ་འཐས་རྩེ་གཅིག་དུས།",
    "མི་རྟོགས་ཡེ་ཤེས་ཤར་ཙ་ན།",
    "མཁའ་ལ་ཉི་མ་ཤར་ཙ་ན།",
    "ཡང་ལྟ་བ་བདེ་ཆེན་ཟིན་ཙ་ན།",
    "ཤེས་བྱ་གཤིས་ལ་ཕེབས་ཙ་ན། ། གནས་ལུགས་རིག་པའི་ཡེ་ཤེས་དེ།",
    "རྣལ་འབྱོར་བྱ་བ་ཚར་ནས་གདའ་ཞེས་གསུངས་པ་ལྟར་དུ་ཡིན།",
    "དགུང་ལོ་བརྒྱད་ཅུ་གྱ་བརྒྱད་བཞུགས་ཟེར་བ་རྨིས་ཅི་ཡིན་སྙམ་ཙ་ན།",
    "ད་ལྟ་གྲགས་པ་ཆེན་པོ་མི་ཡོང་ངན་སྐུར་འདེབས་མཁན་མང་པོ་ཡོང་སྟེ་ཁོ་རང་བྱད་མ་རང་གཤེད་དུ་འགྲོ།"
