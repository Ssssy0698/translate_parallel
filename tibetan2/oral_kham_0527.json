    "ཁྱིམ་གཞན་ན་འདུག་པ་དང་ཟས་ཀྱི་གྲལ་ན་འདུག་པ་མ་གཏོགས་སོ།",
    "འགའ་དག་མཁྱེན་པའི་སྤྱན་ཟུང་ཡངས་ཀྱང་རང་བཟོའི་གོམ་སྟབས་དུ་མས་འབྱོར་ཁ་ཅིག་གོ་བདེའི་ངག་ཚིག་འཇམ་ཡང་གཞན་གྱི་ཟེར་སྒྲོས་དབྱངས་སུ་ལེན།",
    "མཚོ་དཀྱིལ་དུ་ཆུ་ཁོལ་ཞིང་འདུག་པ་དེའི་ནང་དུ་མི་སྣང་བར་གྱུར་ནས་ཅུང་ཟད་ན་གཏེར་སྒྲོམ་སྐུ་གཟན་གྱི་ནང་བསྒྲིལ་ནས་སྔར་ལྟར་འཇའ་ལམ་ནས་ཚུར་ཕེབས་པ་དང་།",
    "དུས་རབས་༢ ནང་ཚན་རིག་དང་འཕྲུལ་ཆས་ཡར་རྒྱས་ཧ་ལས་པ་ཕྱིན་པ་དང་ཆབས་ཅིག་དུས་རབས་དེ་མི་གསོད་ཁྲག་སྦྱོར་གྱི་དུས་རབས་ཤིག་ཀྱང་ཆགས་ཡོད།",
    "ལྷག་དུས་འགྱུར་མ་བྱུང་གོང་བོད་དུ་ཆབ་སྲིད་སྐྱོང་རིམ།",
    "སྤྲུལ་པའི་སྐུ་ཁྱེད་རང་སྤྱི་སྒོས་བསྟན་འགྲོའི་དོན་ཆེན་སྐྱོང་ཕྱིར་སྐུ་ཚེ་ཡུན་བརྟན་དགོས་པ་དང་།",
    "དན་བག་གཟིམ་ཁང་ནས་སྟབས་བདེའི་མཛད་སྒོ་གསོལ་ཇ་བཞེས་འབྲས་སོགས་གྲ་སྒྲིག་གང་ཟབ་གནང་འདུག་པར་གུས་ཀྱང་བཞུགས་གྲལ་མཉམ་འཁོད་ལ་མཇལ་དར་ཨ་ཤེ་ཞིག་གཡོག་གནང་ཐུགས་རྗེ་ཆེ་ཞེས་གསུངས།",
    "དེ་རང་ཡིན་སྐུ་ངོ་རྣམ་པ་ཚོ་ག་པར་བཞུགས་འདུག་ལབ་པར།",
    "བསམ་བློ་ཞིབ་ནན་གཏོང་སྐབས་ཐུགས་ཁག་མི་འདུག་སྙམ།",
    "ངས་ཛ་སག་ཁྱེད་རང་ལ་ལྟ་སྐྱོང་བྱ་འོས་བཞིན་ད་ལམ་འདི་གར་ཆེད་འབོད་བྱ་དོན་དེ་རང་ཡིན་ནའང་དུས་ཚོད་གནས་བབས་འདི་ལྟ་བུར་སྔར་འདྲིས་དཔོན་འབངས་ཀྱི་ལར་རྒྱ་བརྟན་བཟུང་བྱེད་མཁན་ཇེ་དཀོན་དུ་འགྲོ་བཞིན་ཡང་།",
    "རང་ལོ་བཅུ་དགུར་ཁུ་བོ་སྲེག་དུས་འགྱུར་མ་བྱུང་གོང་བོད་དུ་ཆབ་སྲིད་སྐྱོང་རིམ།",
    "ཁྱེད་རང་དེར་བཅར་དགོས་གསུངས་དོན་འབུལ་རྟེན་དངུལ་སྲང་བཅུ་དང་མཇལ་དར་བཅས་མཉམ་འཁྱེར་ངོ་བཅར་ཞུས་པར།",
    "ད་ལམ་གཟིམ་འགག་ཞུ་ཚང་གང་ཆེ་འདུག་ཀྱང་ཁུར་བསམ་མེད་རིགས་ནས་༧ཞབས་པད་སྐུ་ཀྱང་ཕེབས་བཞུད་གནང་དགོས་གནས་བབས་ཤེས་གསལ།",
    "ད་ཆ་ཁྱེད་རང་གཟིམ་འགག་ངོ་མར་ཐུགས་གཏན་འཁེལ་དུས་འགྱུར་མ་བྱུང་གོང་བོད་དུ་ཆབ་སྲིད་སྐྱོང་རིམ།",
    "ཤར་ཕྱོགས་ན་རྒྱ་ནག་འདུག་པ།",
    "ཚེ་བརྟན་སྐྱབས་ཟེར་བ་སོགས་བོད་སྐད་ཀྱི་མིང་རང་དུ་འདུག་པ་སོགས་ནས་མཚོན་ནུས།",
    "དེའི་ནང་སྐབས་དེ་དུས་བོད་ལ་དྲག་པོའི་སྟོབས་ཤུགས་ཧ་ཅང་ཆེན་པོ་ཡོད་པ་གསལ་འདུག་དེ་དུས་བོད་དམག་རྣམས་རྟ་ལ་བཞོན་ནས་གྲི་དང་།",
    "སྔགས་སོགས་ཡི་གེར་བྲིས་པའི་དར་ཆ་ཞིག་ངེས་པར་འཁྱེར་གྱི་ཡོད་འདུག་བོད་དུ་དམག་དུས་ཡོ་ལངས་སྐབས་སྐྱེས་པ་ཚང་མ་དམག་ལ་འགྲོ་ཡི་ཡོད་པ་དེའི་རྐྱེན་གྱིས་རུ་དར་སྒྲེང་བའི་ལུགས་སྲོལ་དེ་བོད་ལ་དར་ཁྱབ་ཆེན་པོ་བྱུང་ཡོད།",
    "དེ་དུས་རྒྱ་ནག་ལ་དམག་དོན་ཐོག་ཕམ་ཉེས་ཀྱང་ཆེན་པོ་བྱུང་འདུག།",
    "རྣམས་བོད་དུ་༡༨༧ ཙམ་ལ་ཐོན་ཡོད་རུང་མང་པོ་དེ་ཙམ་མི་འདུག་༡༩ ལོ་ཙམ་ནས་ཇེ་མང་ཇེ་མང་དུ་ཕྱིན་ཀྱང་བོད་དམག་ཡོངས་རྫོགས་ལ་ཁྱབ་པའི་འཕྲུལ་མདའ་མེད།",
    "རི་བོ་ཆེར་ས་སྲུང་ཇ་དང་དམག་སྒར་གྱི་མདའ་དཔོན་ཕུ་ལུང་གྲགས་པ་ཚེ་བརྟན་བསྐོ་འཇོག་གནང་འདུག་པ་ཁོང་པ་དེ་ཙམ་དགོངས་ཇུས་མཁྱེན་ཚད་ལྡན་པ་ཞིག་མིན་ཀྱང་།",
    "དེ་འདྲ་ཡིན་ཙང་ཁྱེད་རང་བློ་གཡེང་བྱེད་མི་དགོས།",
    "ཁྱེད་རང་སླེབས་པ་ཡག་པོ་བྱུང་།",
    "ཕེབས་འབྱོར་ཁྱེད་རང་རི་ཁྱུང་སྤྱི་འདོམས་སྐུ་ཚབ་ཏུ་ཐོན་མི་དགོས།",
    "འདི་ནས་མདའ་ཡིག་བཏང་ཚར་བ་ཡིན་ཞེས་ལྷ་ཀླུའི་ཕྱག་མཛོད་ཀྱིས་ལམ་སང་ཕྲན་སར་བང་མི་བཏང་གནང་འདུག་ཀྱང་ད་དུང་བརྟན་ཁྱད་བྱས་ཏེ་ལྷ་ཀླུའི་སར་ཆེད་བཅར་ཞུས་པར།",
    "ལྷ་ཀླུ་དཔལ་འབར་ལ་བཞུགས་མུར་རྒྱ་མིས་ཛ་དྲག་ཆེན་པོས་དབུས་ཕྱོགས་སུ་རྔམ་མཆོང་བྱེད་པའི་དུས་སྐབས་སུ་དཔལ་འབར་ནས་ཕྱིར་ལོག་དུས་འགྱུར་མ་བྱུང་གོང་བོད་དུ་ཆབ་སྲིད་སྐྱོང་རིམ།",
    "རྗེས་སོར་གྲྭ་བཞི་རུ་བཞི་པས་དཔལ་འབར་ནས་ལྡིང་ཡོན་གྱིས་གྲྭ་བཞིའི་དམག་དུས་འགྱུར་མ་བྱུང་གོང་བོད་དུ་ཆབ་སྲིད་སྐྱོང་རིམ།",
    "ཁྱེད་རང་ཡར་ཕྱིན་ཏེ་ལྕང་གསེབ་ཤར་ནས་འགོ་བྱེད་གདན་འདྲེན་ཞུས་ཤོག་གསུངས་དོན་ལྷ་ཀླུའི་དུས་འགྱུར་མ་བྱུང་གོང་བོད་དུ་ཆབ་སྲིད་སྐྱོང་རིམ།",
    "དུས་ཚོད་ཛ་དྲག་ནང་དྲུང་ཡིག་ལ་སོགས་པའི་གཤམ་འོག་ལས་ཀ་བྱེད་མཁན་ཆ་རྐྱེན་ཚང་དཀའ་བ་མ་ཟད་དགོས་དངུལ་ཡང་ལྡེང་ངེས་མེད་ཀྱང་ཁྱེད་རང་གཞུང་ཞབས་པ་ཚོས་དམག་ཕོགས་རྒྱག་ཐབས་ལས་བྱུས་ཐད་འགན་ཁུར་གོ་སྒྲིག་བྱ་གལ།",
    "རང་རང་སོ་སོའི་དབུ་གནས་ལ་གཞིགས་པའི་བཞུགས་གདན་སྟེང་ནས་བཞེངས་ཏེ་ཞབས་པུས་བཙུགས་ནས་ཞུ་བ་ལེན་དགོས་པ་ཞིག་གནང་ངམ།",
    "ང་ཕོད་ལ་ཐུགས་ཁག་རྩ་བ་ནས་བྱུང་མི་འདུག་སྙམ།",
    "འདུག་ཅེས་ཤོད་འགག་ལ་ཞུས།",
    "བྱས་ན་ཁྱེད་རང་ས་ཁྲ་བཀོད་པར་འཐད་རོགས།",
    "བྱས་ཙང་ཕྲན་རྒས་པོས་ཡོང་བ་མི་འདུག་ཅེས་དགོངས་ཞུ་ཨུ་ཚུགས་མཐའ་སྐྱེལ་གནང་སྟེ་ཛ་སག་གསར་བསྐོ་གནང་སྟངས་ལ་གཞིགས་ཚེ་གཞན་གྱིས་དོགས་འཆར་ཙམ་ལས་དངོས་དོན་རྭ་སྒྲེང་ཛ་སག་རྒན་གཞོན་དབར་འཁོན་འཛིན་རིགས་བྱུང་མེད་ཚོད།",
