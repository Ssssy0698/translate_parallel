    "དེའང་ལན་གྲངས་བསམ་གྱིས་མི་ཁྱབ་པ་ལམ་ཤ་སྟག་ཏུ་བྱས་ནས་ལུས་ལོངས་སྤྱོད་ཐམས་ཅད་ལ་ལྟོས་པ་མེད་པར་བསྐྱངས་ས་པ་དང་།",
    "མེད་པ་ལ་ཡོད་པར་བཟུང་།",
    "མི་རྟག་པ་ལ་རྟག་པར་བཟུང་།",
    "བདེན་པར་གྲུབ་པ་མེད་པའི་དོན་རྙེད་དེ་འོངས་ནས་ཆགས་ཡུལ་མེད་པས་ན་ཞེན་པ་མེད་པའི་བློ་བྲལ་ཆེན་པོ་ཤར་བ་ཡིན།",
    "བློ་འཇུག་ནས་མཐར་བློ་འབྱོང་བར་བྱེད་དགོས་པ་ཡིན་པ་ཤེས་པར་བྱེད་དོ།",
    "མགྲིན་པར་ཨཐུགས་ཀར་ཧཱུྃ།",
    "དམ་ཚིག་པ་དང་འདྲེས་པར་བསམ་ལ།",
    "ལུས་ཀྱང་སྟོང་པའི་གཟུགས་བརྙན་ནམ་བདེན་པར་གྲུབ་པ་མེད་པར་གོ་ཞིང་བདེན་མེད་དུ་རྟོགས་ནསསེམས་ལུས་ལ་༨༥ན་མི་ཆགས།",
    "མ་ཆགས་མི་ཆགས་ཆགས་པ་མེད་པར་མི་འགྱུར་རོ།",
    "སྒྲོལ་མའི་སྤྲུལ་པ་ཡིན་པར་ཡང་སྨྲ་བར་བྱེད་དོ།",
    "བདུག་བའི་པ་བྱས་ན་གདོན་སྟོང་ཕྲག་བརྒྱད་ཅུས་མི་ཚུགསན་ལུས་ལ་བྱུག་པ་བྱས་ན་ཤུ་འབྲུམ་གྱི་རིགས་ཐམས་ཅད་སེལ་བར་བྱེད་དོ།",
    "འདི་ཉིད་བྱས་ཀྱང་རུང་ལ་གང་ཡིན་ཀྱང་སེམས་ནམ་མཁའ་ལ་འཕོས་ནས་བསྲེ་བ་དང་།",
    "མར་སྣེས་པད་འདབ་ནོན་པའི་སྟེང་དུ་ནང་པདྨའི་ལྟེ་བའི་སྟེང་དུ་རྣམ་པར་ཤེས་པ་ཡོད་ས་པར་བསམ་ནསན།",
    "ཕཊབྱས་པས་ཁྲག་སྤོས་ཆུའི་རྒྱ་མཚོ་ཆེན་པོར་གྱུར་པས།",
    "ས་གཞི་ལ་ཆག་ཆག་གདབ་པར་བསམ།",
    "ཕཊབྱས་པས་སེན་མཛུབ་མཐའི་ལྕགས་རིར་བསམ།",
    "རི་རབ་༩ བ་ཀྱི་སྟེང་དུ་མགོ་དེ་རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་པཎྜི་༣༧༣ལྔ་པ།",
    "གཡོན་པ་ཉི་མ་ཡིན་པར་སས་བསམ།",
    "ཕཊ་སོ་རྣམས་རྒྱུ་སྐར་རྣམས་ཡིན་པར་བསམ།",
    "བཞེས་ནས་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "མ་ངེས་པར་ཐུགས་རྗེས་བཟུང་དུ་གསོལ་། དོན་ངེས་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "སྤྱི་གཙུག་རྒྱན་འདིར་བཞུགས་སུ་གསོལ།",
    "བཞུགས་ནས་ས་གསང་ས་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཐམས་ཅད་ལ་སེམས་དུང་ངེ་བ་སྐྱེས་པར་བསམས་ལ།",
    "ས་བྱས་པའི་ཐུགས་ཀ་ནས་འོད་ཟེར་དམར་པོ་སྤྲོས།",
    "ནོར་འཁྲུལ་ལ་སོགས་པའི་ལམ་ལ་སྐྱོབ་པར་བྱེད་པ་དང་།",
    "མ་ནོར་བའི་ལམ་མཆོག་དམ་པ་སྟོན་པའི་སྟོན་པ་མཛད་པར་གསོལ་བ་གདབ་ནས།",
    "ཕཊ་བརྗོད་པར་བྱའོ།",
    "འགྲོ་བདུད་ཀྱིས་བར་ཆད་མི་བྱེད་པར་བྱིན་གྱིས་བརླབས་པ་དང་ན་ན་བའི་དོན་བྱེད་པ།",
    "པགས་པ་ལ་སོགས་པའི་ལུས་ཀྱི་ཁྱད་པར་བྱེ་བྲག་མ་ཚང་བ་མེད་པ་ཤ་ཁྲག་ལ་སོགས་པ་ལས་རང་བཞིན་དུ་གྲུབ་བའི་འདོད་ཡོན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "དྲོད་དང་རླངས་པ་ལས་འདོད་ཡོན་གྱི་ན་བུན་དང་སྤྲིན་ཆེན་པོ་འཁྲིགས་པའི་༩༥ན་བགེགས་རིགས་ལན་ཆགས་རྣམས་ཀྱི་འདོད་པའི་ཡོན་ཏན་ལྔ་མ་ཚང་བ་མེད་པར་།",
    "དེ་རྣམས་ཀྱི་ཟླ་པགས་པ་ལས་བྱས་པའི་ཐུལ་བ་དང་།",
    "དེ་རྣམས་ནི་བཞོན་པའི་ཁྱད་པར་ཡིན་ནོ་༨ ཝཱ་གསེར།",
    "དེ་རྣམས་ལས་བྱས་པའི་སྒྲ་རྣམས་དང་།",
    "སྟག་ཤར་དང་། དར་སྣ་ཚོགས་ཀྱི་ཅོད་པན་གྱིས་བརྒྱན་པ་ནི་སྒ་སྟན་གྱི་ཁྱད་པར་ཡིན་ནོ།",
    "ངས་ན་ས་ཡངས་པ་ཅན་དུ་ན་བུན་འཁྲིགས་པ་ལྟར་དལ་བུ་ཅི་ལི་ལི་འོང་བར་རིག་པར་བྱའོ།",
    "སབ་ལྷག་མ་མེད་པར་བཞེས་ནས་ཀྱང་།",
    "དེ་ཡི་སེམས་རྒྱུད་དང་པ་བཅས་པ་ཡིད་ལ་མི་བྱེད་པའི་ངང་ལ་མཉམ་པར་བཞག་པར་བྱའོ་ལ་ཡང་ལས་ལ་བསྐུལ་བར་འདོད་ན།",
    "བཞོན་པའི་ཆན་ཆོན་ཐམས་ཅད་སྦྲུལ་ལ་བྱས་པ་ཀུན་ལ་འདྲ་ཞིང་།",
    "སྔར་བས་ཀྱང་ཞེ་སྡང་དང་ཁྲོ་ལ་གཏུམ་པར་ལ་ཤ་ཁྲག་གཏེར་བས།",
    "ནེའུ་སིང་ལ་སོགས་པའི་ཆུའི་དབྱིབས་དུ་མར་གྱུར་པར་བསམ།",
    "ལཡལ་ག་ལ་དཔག་ཚད་ལྔ་བཅུ་རྩ་གཅིག་ཁྱབ་པ་གཅིག་ཏུ་ས་གྱུར་པར་བསམ།",
    "ཁྲུང་ཁྲུང་ལ་སོགས་པའི་བྱ་རིགས་སྐད་སྙན་པ་སྒྲོགས་ཤིང་ཆུ་ལ་གནས་པ་ཐམས་ཅད་ཡོད་པར་བསམ།",
    "སྐྲ་བ་བཐ་དང་བ་སྤུ་ཐམས་ཅད་ཀླུ་ཤིང་ལྗོན་པ་ཡི་ཚལ་ཆེན་པོ་རབ་ཏུ་རྒྱས་པར་བསམ།",
    "ཆུ་དར་སྔོན་པོའི་སྨད་ཤམ་བྱས་པ།",
    "རྒྱུན་རྣམས་ཀྱང་འོད་ཁྱད་པར་ཅན་འབར་བ་དང་།",
    "༡ ༣ ནསབ་འཛུམ་པའི་མདངས་དང་ལྡན་ཞིང་༧རྟ་བྱམས་པའི་སེམས་དང་དད་པས་རང་ལ་འདུད་པར་བསམས་ལ་མས་འདོད་ཡོན་བྱིན་པའི་ཚིག་འདི་བརྗོད།",
    "གཏོར་མ་མགྲོན་དང་བཅས་པ་དམིགས་མེད་གྱི་ངང་ལ་བཞག་པར་བྱའོ།",
    "མབསྐུལ་ཞིང་ཕ་རོལ་ལ་རྦད་པར་འདོད་ན།",
    "རྐྱེན་གང་ལ་རྦད་ཀྱང་སོ་སོར་དམིགས་པས་འབྱེད་པར་བྱས་ལ།",
    "རྦད་པའི་དུས་སུ་སན་ས་གདོལ་པ་ཁོ་ན་ཡིན་པར་དམིགས་དགོས་སོ།",
    "ཐབས་མཁས་པར་གྱིས་ལ།",
    "མནརཐབས་མཁས་པའི་སྒོ་ནས་འགྲོ་བའི་དོན་ལ་བརྩོན་པར་གྱིས་དང་ངའི་རྗེས་སུ་འཇུག་པ་ཡིན་ནོ་བུ།",
    "ཞབས་གཉིས་བརྐྱངས་བསྐུམས་གྱིས་གར་ཁྱུག་ཁྱུག་བྱེད་ཅིང་མི་ལྤགས་ལྷ་འདྲེ་གདུག་པ་ཅན་རྣམས་འདར་ཤུན་ཤུན་བྱེད་པར་བརྡབ་པས།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཁྱབ་པར་གྱུར་པ་གཅིག་ཏུ་བསམ།",
    "༧༧ཏུ་བཟང་པོས་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དམརང་ཉིད་ཀྱི་གནས་སྐོར་གྱི་ས་གཞི་བར་སྣང་ཐམས་ཅད་ཁྱབ་པར་བསམས་ལ།",
    "ཁྱད་པར་དུ་དམར་འགྱེད་ལ་དོན་རྣམ་པ་བཞི་སྟེ།",
    "དགོས་ཁྱད་པར་དུ་ཡང་བདག་ལ་གནོད་པར་བྱེད་པའི་ལྷ་འདྲེ་གང་ཡིན་པ་དེ་ཚིམ་པར་གྱུར་ཅིག།",
