    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་འདུག་ལ།",
    "དེ་བཞིན་དུ་གཤིན་རྗེ་གཤེད་ལ་སོགས་པ་གང་ཡང་རུང་བའི་སྦྱོར་བས་འདུག་ལ།",
    "དེ་ལྟར་ཡང་རང་བྱིན་གྱིས་བརླབས་པ་ལས།",
    "དེ་ལྟར་ཡང་རང་བྱིན་བརླབས་ལས།",
    "དེའི་ཚེ་ཞི་གནས་དང་ལྷག་མཐོང་གཉིས་ཕན་ཚུན་གྱི་གགས་སེལ་བྱས་ནས་བསྒོམས་པས་ཅི་ནས་ཀྱང་རང་ཉིད་ལྷ་སྐུ་སྒྱུ་མ་ལྟ་བུ་དྭངས་ཤིང་ཐོགས་པ་མེད་པ།",
    "དུས་ཡང་ནས་ཡང་དུ་འཇུ་ཡིན་གདའ།",
    "ད་ཅི་ཡི་བསམ་མནོ་འཁྲུལ་ནས་འདུག།",
    "སྒྱུ་མའི་ངང་ལ་བདེ་བར་འདུག།",
    "མི་བདག་ཀྱང་དེ་གའི་ངང་ལ་གདའ།",
    "མདུན་ན་འདུག་པའི་འཁོར་རྣམས་ཇི་སྙེད་པ།",
    "བདེ་བ་ཅན་དུ་པད་མ་འདབ་མ་རྒྱས་པར་འདུག་པ་ཡི།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་དུས་མ་ཡིན་པར་བཅའ་བ་དང་།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་ནག་པོའི་གཙུག་ལག་ཁང་ན་འབྲས་ཆན་སྐམ་པོ་རབ་ཏུ་མང་པོ་དག་བཏིང་ཞིང་འདུག་གོ།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་དང་།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་མ་ཡིན་པ་ན་འདུག་པས་དང་།",
    "དུར་ཀྲོད་ཆེན་པོ་དེ་ན་གནོད་སྦྱིན་གདུག་པ་ཞིག་འདུག་པ་དེ་དེ་ན་མི་རོ་མྱགས་པ་ཟའོ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "མཉན་ཡོད་ན་སྦོས་འཚོང་ཁྱེའུ་ཆུང་མ་བླངས་ནས་རིང་པོ་མ་ལོན་པ་ཞིག་འདུག་པ་དེས་ཟོང་བཀྲམ་པ་ན།",
    "འདུག་ཏུ་བཅུག་སྟེ།",
    "ཁ་ཟེར་བར་བྱེད་ནས་དགེ་སློང་དོན་ཉུང་དུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "འདུག་ན་ཞེས་བྱ་བ་ནི་འདོམ་གང་ཡི་ནང་དུ་རྐུབ་ཚོས་བཞག་ནའོ།",
    "ཤེས་པ་ཅན་དགེ་སློང་རྣམས་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་ཤིག་དང་།",
    "ཤེས་པ་ཅན་དེ་དགེ་སློང་རྣམས་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་པ་དང་།",
    "གསེར་གྱི་སྣོད་ན་འདུག་པའི་མར་མེ་ལྟ་བུ།",
    "འདུག་ཤིག་དང་སྦྱིན་ནོ།",
    "དེ་གཉིས་འདུག་གོ།",
    "ཡུལ་སྲོལ་གོམས་གཤིས་ཐད་ཀྱི་ཤེས་བྱ་མཁྱེན་འདོད་ཡོད་མཁན་རྣམས་ལ་ཕན་ཐོགས་ཆེ་ཙམ་ཐོབ་ཐུབ་ངེས་འདུག་སྙམ་པ་བཅས་ཕྱོགས་སྒྲིག་གནང་མཁན་གྱི་ཐུགས་འདུན་ལྟར་གླེང་གཞིའི་ཚུལ་དུ།",
    "ཆེས་ཐོག་མའི་བོད་ཀྱི་ཁ་བཏགས་ནི་རྒྱུ་བལ་དཀར་ལས་གྲུབ་པའི་དངོས་པོ་ཞིག་ཡོད་སྐད་འདུག་ཕྱེ་མར།",
    "ཕྲན་བུ་སྟབས་བདེ་ཞིག་ཡིན་ཚོད་འདུག་གྲོ་སོ་ཕྱེ་མར་བེད་སྤྱོད་གཏོང་སྲོལ་དེ་ཆགས་པའི་གཙོ་བོའི་འབྱུང་རྩ་གཉིས་ཙམ་ཡོད་པ་སྟེ་གཅིག་ནི་སྲོལ་དེ་དར་བའི་བསམ་པའི་རྨང་གཞི་དེ་གང་ཡིན་དང་།",
    "རྗེས་སུ་དེ་སྟབས་བདེ་ཡོང་བའི་ཆེད་དུ་ལུག་མགོ་ཁོ་ན་བསྒྲིགས་པའི་སྲོལ་དར་སྐད་འདུག་བསང་།",
    "དོན་གང་ཞིག་འགྲིག་འདུག་ཅེས་བསྔགས་བརྗོད་བྱ་དགོས་ན།",
    "དེ་ཡང་རང་ཁྱིམ་གྱི་གཡང་གཞན་པར་མི་ཤོར་བའི་ཆེད་དུ་ཡིན།",
    "སྨྱུང་གནས་སྲུང་བ་སོགས་རང་རང་འཁོས་དཔག་ལ་གཞིགས་ཏེ་རྣམ་དཀར་གྱི་ལས་ལ་བརྩོན་པ་དང་།",
    "རྟརྒྱུགརྟ་རྒྱུག་དུས་ཆེན་ནི་བོད་མིས་ཧ་ཅང་དགའ་པོ་བྱེད་པའི་དུས་ཆེན་ཞིག་ཡིན།",
    "རང་རང་སོ་སོའི་འཁོས་འབྱོར་ལ་གཞིགས་ནས་མཆོད་འབུལ་བསྙེན་བཀུར་དང་།",
    "མི་ཚང་གཞན་གྱི་ཁྱིམ་ནང་གདན་ཐོག་ལ་བཞུགས་སྐབས་དཀྱིལ་ཀྲུང་མ་བཅས་པར་རྐང་བརྐྱངས་ལག་བརྐྱངས་སུ་འདུག་པ།",
    "བྱ་དེས་དེ་བཞིན་བྱེད་པས་རྒྱལ་པོ་ཐེ་ཚོམ་སྐྱེས་ཏེ་ཤིང་བུ་དེ་ལ་བལྟས་ནས་བརྟག་དཔྱདབྱས་པས་སྔར་མེད་ཀྱི་ཤིང་དུ་འདུག་ཅིང་།",
    "ཆུ་ཆེན་པོ་ཞིག་འདུག་པས་ཆུ་ལ་ནི་འགྲོ་མ་ནུས།",
    "ཆུ་ཁ་ཞེང་ཆེ་བ་མ་གཏོགས་གཏིང་ལ་མི་ནུབ་པར་འདུག་པས་སེམས་དགའ་སྟེ།",
    "ས་ཐག་རིང་བར་འདུག་པས་ད་ལན་འཁུར་བའི་གྲོགས་སམ་ཁལ་མ་གཅིག་ཡོད་ན་བསམ།",
    "ལོ་གསར་པའི་ཆུ་ཕུད་ཀྱི་གཡང་ཕྱི་ལ་ཤོར་གྱི་ཡོད་སྐད་འདུག་དེ་ནས་ནང་དུ་འབྱོར་བའི་རྗེས་སྔོན་ལ་ཆུ་དེ་ནས་ཡོན་ཆབ་འབུལ་བ་དང་།",
    "ཁྱེད་རང་རྣམས་འདུན་པ་འདི་བཞིན་དུ་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཧེ་རུ་ཀར་གསལ་བའི་ཐུགས་ཀ་ནས་སྔགས་འཕྲེང་སྒྲ་དང་བཅས་པ་འཕྲོས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཐུགས་ཀར་ཕོག་ཁྱེད་རང་རྣམས་ལྷན་སྐྱེས་ཀྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་ལྕགས་ཀྱུའི་རྣམ་པ་ཅན་ཕྲེང་མ་ཆད་པར་འཕྲོས་ཏེ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དང་རང་བཞིན་དབེན་པས་ན་ཞེས་བྱ་བ་ནི།",
    "གོ་རིམ་བཞིན་དུ་ངོ་བོ་ཉིད་མེད་པ་དང་མ་སྐྱེས་པ་དང་མ་འགགས་པ་དང་གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པའི་མཚན་ཉིད་ནི་སྤྱིར་ཤེས་བྱའི་སྒྲིབ་པའི་གཉེན་པོར་གྱུར་པ་དག་ཡིན་ཏེ།",
    "དེ་ནས་རིམ་པ་བཞིན་དུ་བྱས་ལ་འདུག་སྟེ་ཉན་པར་བྱེད་དེ་དེ་ལྟར་ལྟ་བ་ལ་སོགས་པའི་དོན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་ཐོབ་པར་གྱུར་པ་ཡིན་ནོ།",
