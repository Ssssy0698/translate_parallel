    "དེ་དག་༢ིགི་སྐྱོན་དང་ཡོན་ཏན་དཔྱད་པས་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་ཐབས་བསྟན་༐",
    "ཆུང་མ་ཁྱོའི་རྗེས་སུ་མཐུན་པ་༡༧གང་ཡིན་པ་དེ་ནི་བཀུར་བ་ཡིན་ནོ་ཞེས་བྱ་བར་སྦྱར་ར་རོ།",
    "ཇི་ལྟར་མ་བུ་ལ་ལུས་དང་སེམས་ཀྱི་སྡུག་བསྔལ་དང་བྲལ་བར་འདོད་པས་ཕན་པར་འདོད་ཅིང་ཕན་པར་འདོད་པའི་ངང་ཚུལ་ཅན་ཡིན་པ་དེ་བཞིན་དུ་ཁྱོ་ལ་ཕན་པར་འདོད་པའི་ཆུང་མ་གང་ཡིན་པ་དེ་ཡང་བཀུར་པ་ཁོ་ན་ཡིན་ནོ།",
    "བསྙེམས་༥པའི་འབྲས་བུ་དེ་ནི་གཞན་ལ་གནོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཞེ་སྡང་གིས་༦ཟ་བ་ཡིན་ན་ནོ།",
    "དེ་དག་མེད་པར་ལུས་གནས་པ་འབའ་ཞིག་གི་ཕྱིར་ཏེ།",
    "མཚན་མོའི་ཐུན་གྱི་སྟོད་སྨཱད་ཅེས་བྱ་བ་ནི་རིགས་པའི་བདག་ཉིད་ཀྱིས་ཉིན་མོ་ཁོ་ན་འདའ་བ་འབའ་ཞིག་ཏུ་མ་ཟད་དོ།",
    "རིགས་པའི་བདག་ཉིད་ཀྱིས་༡༧མཚན་མོ་ཡང་ཆ་སྟོད་དང་ཆ་སྨད་འདས་ནས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་སྐད་དུ་མཚན་མོའི་ཐུན་དང་པོ་ལ་འཆག་༡༧པ་དང་།",
    "འདུག་པ་དག་གིས་སྒྲིབ་པར་༐",
    "ཡོངས་སུ་སྦྱངས་ནས་ཐུན་བར་མ་༡༧ལ་གཙུག་ལག་ཁང་གི་ཕྱི་རོལ་དུ་རྐང་པ་བཀྲུས་ཏེ།",
    "དེ་དག་བར་དུ་མནོལ་ཞེས་བྱ་བ་ནི་ཐུན་དང་པོ་དང་ཐུན་༢ིཐ་མ་དག་གི་བར་གྱི་ཐུན་གང་ཡིན་པ་དེར་ཉོལ་ཅིག་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ཕྱིན་ཆད་ནི་ཕྱོགས་ཁྱབ་པར་བྱེད་པའི་ད་བང་གིས་ཡིད་ལ་བྱེད་པར་རིག་པར་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་༡ཇི་སྐད་དུ་དེ་བྱམས་པ་དང་ལྡན་པའི་སེམས་ཁོ་ན་མེད་པ་འགྲན་ཟླཱ་མེད་པས་ཕྱོགས་གཅིག་ཏུ་མོས་ནས་ཁྱབ་པར་བྱ་སྟེ།",
    "བྱ་བ་༡༧རེ་རེ་དང་སྦྱར་ཏེ།",
    "དེ་ལ་སྦྱོར་བའི་ཁྱད་པར་ནི་ལས་ཆུང་ངུ་ལ་ཡང་དུས་རིང་མོ་ཞིག་ཏུ་སྦྱར་བའི་ཕྱིར་རོ།",
    "ལས་དུས་ཡུན་ཐུང་ངུ་ཡང་ཉོན་མོངས་པ་དང་།",
    "བདག་གི་མཛའ་བོ་ཡིད་དུ་འོང་བ་ཕན་པར་འདོད་པ་གང་ཡིན་པ་དེ་ལ་གནོད་པར་བྱས་ས་སོ།",
    "བདག་མེད་པ་ནི་ནང་གི་བྱེད་པའི་སྐྱེས་བུ་དང་བྲལ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕུང་ཀྲོལ་བ་སྟེ་དེ་ལྟ་བས་ན་ཁྱོད་ཀྱིས་མི་ནི་སྡུག་བསྔལ་བ་ལ་སོགས་པ་ཉིད་དུ་རིག་པར་བྱའོ་། གལ་ཏེ་མི་སྡུག་པ་༢༦དང་།",
    "མི་རྟག་པ་དང་མི་གཙང་བ་ནི་ཡིན་གྲང་ན།",
    "རེ་ཞིག་གཟུགས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "རེ་ཞིག་འདི་ནི་ལུང་གི་བདག་གཟུགས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཡིན་པ་བཀག་པ་ཡིན་ན་ནོ།",
    "དཔེར་ན་ལྷས་བྱིན་རེ་ལྡེ་ལ་འདུག་པ་བཞིན་དུ་གཟུགས་ལ་སོགབ་པ་ལ་གནས་པ་ཞིག་ཡིན་པའམ།",
    "རེ་ཞིག་འདི་ནི་ལུང་ཡིན་ན་ནོ།",
    "དངོས་པོ་རྣམས་ཀྱི་སྐྱེ་བ་དང་འཇིག་པ་ཅིག་༢ིཅར་དུ་ཡང་ཐལ་བར་འགྱུར་ཏེ།",
    "འོན་ཏེ་ཕྱོགས་གཅིག་གིས་གལ་ཏེ་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་ན་ནི་རང་བཞིན་ཆད་པར་འགྱུར་ར་རོ།",
    "འོན་ཏེ་ཕྱོགས་གཅིག་གིས་ན་ནི་མི་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ར་རོ།",
    "མཐའ་ཐལ་བ་ཞེས་བྱ་བ་ནི་མེས་བསྲེགས་༡ཞེས་བྱ་བའི་༢དོན་ཡིན་ན་ནོ།",
    "དཔེར་ན་མར་སར་རམ་འབྲུ་མར་བསྲེགས་ན་ཐལ་བ་ཡང་མི་ལུས་པ་བཞིན་དུ་འགྱུར་ར་རོ།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་འདི་དེ་ལྟར་སྐྱབས་མེད་པ་ཡིན་པ་དེའི་ཕྱིར་ཀྱེ་མི་མཆོག་ཁྱོད་ཀྱིས་ཏྲ་སྣོད་ཅེས་བྱ་བ་ལ་སོགས་པས་༡ནི་དེ་ལྟར་རྙེད་༢དཀའ་བའི་མི་ཉིད་ཐོབ་ནས་༢།",
    "དེ་ལ་མཐུན་པའི་ཡུལ་ནི་གང་ཞིག་གང་གིས་༡༧སེམས་མཉམ་པར་གཞག་༡༧པ་དང་མཐུན་པ་ཡིན་ཏེ།",
    "ཡོན་ཏན་དག་གིས་མཉམ་པའམ།",
    "ཁས་པ་ཚིག་བཟོད་པ་དོན་ཟབ་མོ་སྨྲ་བ་གནས་པ་༡༨ཡིན་པར་སྦྱོར་བར་མི་བྱེད་པ་གང་ཡང་རུང་སྟེ།",
    "མཐོ་རིས་བུ་རྨོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་མཐོ་རིས་བུ་མོ་ནི་ལྷའི་བུ་མོ་དག་གོ།",
    "རེག་པ་དེས་བདེ་བ་མྱོང་ནས་ཉམས་སུ་མྱོང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ནི་རེག་པ་ཏེ་༧པོར་མི་བཟད་པ་བསྟན་དགོས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "འཁྲུལ་འཁོར་ཞེས་བྱ་བའི་སྒྲ་ནི་རེ་རེ་དང་སྦྱར་ར་རོ།",
    "ཞེས་བྱ་བ་ནི་རྐང་པའི་རེག་པས་ནེམ་༡༧ཞེས་བྱེད་པ་དང་།",
    "དེ་ལ་མེ་མ་མུར་ནི་པུས་མོ་ནུབ་ཙམ་སྟེ།",
    "ཁྱོད་ཀྱིས་ཅི་ནས་ཀྱང་ས་བོན་དེ་རྡུལ་ཙམ་ཡང་མེད་པ་དེ་ལྟར་འབད་པར་གྱིས་ཤིག་ཅེས་བྱ་བ་ནི་འདི་ལ་གདམས་པ་ཡིན་ནོ།",
    "ཁ་ཅིག་ནི་མུ་ཏིག་གི་ཕྱིར་འཆི་བར་འགྱུར་ར་རོ།",
    "དེ་དག་གིས་བལྟས་པ་ཙམ་༤ཁོ་ནས་ཆུ་ཞིམ་པོ་བསིལ་བ་འབབ་པའི་ཀླུང་ཡང་མིག་གདུག་པའི་དུག་གིས་བསྲེགས་པ་བཞིན་དུ་སྐམ་པར་འགྱུར་རོ།",
    "ཁ་ཅིག་ལ་༦ནི་རྣག་གི་ཀླུང་༧སྲིན་བུ་སྣ་ཚོགས་ཀྱིས་གང་བ་འབབ་པར་འགྱུར་ར་རོ།",
    "ཡང་ཇི་ལྟར་དེ་དག་གི་ལུས་༡༧སྡུག་བསྔལ་བ་༡༧དེ་ལྟ་བུས་ཀྱང་འཇིག་པར་མི་འགྱུར་ཏེ་༡༧།",
    "གང་དག་གིས་༢༢ཉེས་པར་སྤྱད་པའི་ལས་ཀྱི་༡༧ཞགས་པ་སྲ་བས་བཅིངས་པ་ཞེས་བྱ་བར་ཚིག་སྦྱར་སྟེ་༢།",
    "དེ་སྐད་གསུངས་མོད།",
    "འདི་དག་ནི་འཕགས་པ་༢ིརྒྱུན་དུ་ཞུགས་པ་ལ་སོགས་པས་བདེན་པ་ཉིད་དུ་གཟིགས་པའི་ཕྱིར་རོ།",
