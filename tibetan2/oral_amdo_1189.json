    "དེ་ཉིད་ཀྱི་ཕྱིར་དཔལ་ཕྲེང་གི་ཞུས་པར་ཡང་།",
    "དེ་སྲིད་ཡེ་ཤེས་ལུས་གཅིག་གིས།",
    "གཉིས་པ་སླར་ཡང་གཞུང་གི་རྒོལ་ལན་ནི།",
    "སྐལ་བ་དང་མི་ལྡན་པ་རྣམས་ཀྱིས་མ་རྟོགས་ཤིང་མི་མོས་པ་ཉིད་ཀྱི་ཕྱིར་བཀའི་མཐར་ཐུག་པར་གྲུབ་སྟེ།",
    "དམན་པར་མོས་ཤིང་ཁམས་ཀྱང་ཤིན་ཏུ་དམན།",
    "གྲོགས་པོ་དམན་པ་དག་གིས་ཡོངས་སུ་བསྐོར།",
    "འདི་ལ་གལ་ཏེ་མོས་མེད་གྲུབ་པ་ཡིན།",
    "ངག་གང་ཞེས་པ་ལ་སོགས་པའི་ཚིགས་བཅད་གསུམ་པོ་འདི་དག་ཤེས་རབ་འབྱུང་གནས་དང་བི་བྷཱུ་ཏི་ཙནྡྲ་ལ་སོགས་པ་ནི་ཟློས་ཤིང་མ་འབྲེལ་བས་གཞན་དག་གིས་རང་བཟོར་བསྣན་པར་བཞེད་མོད།",
    "དེ་ལྟར་ཟབ་མོ་སྟོང་པ་ཉིད་ཀྱི་ཕྱོགས་ལ༵་གཞུང་བཀའ་མ་ཡིན་ཞིང་དོན་ལམ་མ་ཡིན་ནོ།",
    "གང་ཟག་གི་བདག་མེད་ལ་འཇུག་ཚུལ་དང་།",
    "དེ་ཡང་ནང་གི་ལུས་ལ་རྣམ་པར་ཕྱེ་ན།",
    "སོ་དང་སྐྲ་དང་སེན་མོ་རྣམས་ནི་བདག་མ་ཡི༵ན་ཏེ།",
    "བདག་གི་མཚན་ཉིད་དང་མི་ལྡན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་བདག་ནི་རུས་པ་དང་ཁྲག་གི་ངོ་བོར་ཡོད་པ་མ་ཡི༵ན་ཞིང་།",
    "དེ་དག་གི་སོ་དང་རུས་པ་ལ་སོགས་པ་སྲ་བར་སྣང་བ་རྣམས་ནི་སའི་ཁམས་ཡིན་ཞིང་།",
    "མིག་གི་བུ་ག་ལ་སོགས་པའི་བུ་ག་རྣམས་ཀྱང་ནམ་མཁའི་ཁམས་ཡིན་ཞིང་།",
    "དོན་དམ་པར་རང་རང་གི་ངོ་བོ་སྟོང་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲ་ཡོད་པ་དང་མེད་པའི་དུས་ཐམས་ཅད་ཀྱི་ཚེ་ན་སྒྲ་འཛིན་པའི་ཤེས་པ་ཡོད་པར་ཐལ་བར་འགྱུ༵ར་ཏེ།",
    "གལ་ཏེ་ཡུལ་སྒྲ་མེད་པ་ན་དེ་ཤེས་པ་མེད་ཀྱང་སྒྲ་འཛིན་གྱི་ཤེས་པ་རྟག་པ་ཡིན་ན༵་ནི་ཤིང་བེམ་པོ་ཡང་སྒྲ་འཛིན་གྱི་ཤེས་པ་རྟག་པ་ཡིན་པར་ཧ་ཅང་ཐལ་བར་འགྱུ༵ར་ཏེ་རིགས་པ་མཚུངས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་གཟུགས་ཤེས་པ་དེ་ཉིད་ཀྱི་ཚེ་སྒྲ་ཐོས་པའང་ཅི་སྟེ་མི༵ན་ཏེ་གཟུགས་འཛིན་ཤེས་པ་དེ་ཉིད་ཀྱིས་སྒྲ་ཡང་ཐོས་པ་ཐལ་བར་འགྱུར་རོ།",
    "ཁོ་ན་རེ་ཤེས་པ་གཅིག་ཉིད་ཀྱི་རེས་འགའ་སྒྲ་འཛིན་ཅིང་རེས་འགའ་གཟུགས་སོགས་འཛིན་པ་མི་འགལ་ཏེ།",
    "དཔེར་ན་སྐྱེས་བུ་གཅིག་ཉིད་རང་གི་བུ་ལ་ལྟོས་ནས་ཕ་དང་ཕ་ལ་ལྟོས་ནས་བུ་ཉིད་དུ་འཇོག་པ་མི་འགལ་བ་བཞིན་ནོ་ཞེ་ན།",
    "ཀུན་རྫོབ་ཙམ་དུ་རང་གི་ཡུལ་གཟུགས་ཁོ་ན་ལ་འཇུག་པར་ངེས་པའི་ཕྱིར་རོ།",
    "སྒྲ་འཛིན་གྱི་ངོ་བོ་གཅིག་ཏུ་རྟག་པ་ཡང་ཡིན་ལ་གཟུགས་འཛིན་ལ་སོགས་པའི་ཚུལ་གཞན་དུ་མར་ཡང་སྟོན་པའི་གཅིག་པུ་ཉིད་དེ་ནི་གཞན་ལ་སྔོན་མེད་པ་གཅི༵ག་ཁྱོད་ཀྱིས་རྙེད་པ་ངོ་མཚར་རོ་ཞེས་པ་སྟེ།",
    "འོ་ན་སྒྲ་འཛིན་དང་གཟུགས་འཛིན་ལ་སོགས་པ་དེ་ཡི་རང་གི་རང་བཞིན་གཅིག་ཏུ་བདེན་པར་འཇོག་པའི་སྒྲུབ་བྱེད་གང་ཡིན་པ་དེ་སྨྲོ༵ས་ཤིག་ཅེས་དྲིས་པ་ལ།",
    "ཁོ་ན་རེ་སྔ་ཕྱི་ཐམས་ཅད་ཀྱང་ཤེས་པ་ཙམ་ཉིད་དུ་མཚུངས་བའི་ཕྱིར་དེ་དག་རང་བཞིན་གཅིག་ཏུ་འཇོག་གོ་ཅེ་ན་དེ་ལྟ་ན༵་སྐྱེས་བུ་ཐ་དད་པ་ཀུན་གྱི་ཤེས་རྒྱུད་ཀྱང་གཅིག་ཉིད་དུ་བདེན་པར་ཐལ་བར་འགྱུ༵ར་ཏེ།",
    "གང་གི་ཕྱིར་ན་དངོས་པོར་ཡོད་པ་ཙམ་ཉིད་དུ་མཚུ༵ངས་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་དུ་ཁྱབ་པར་སོང་བ༵་ཞིག་བདག་ཡིན་པར་འདོད་ན་ནི་འདུས་མ་བྱས་ནམ་མཁའ་ཡང་བདག་ཏུ་བྱས་པ་ཧ་ཅང་ཐལ་བར་འགྱུ༵ར་ཏེ།",
    "དང་པོ་ཐུན་མོང་པའི་ལས་འབྲས་མི་འཐད་པ་སྤང་པ་ནི།",
    "དེ་ལྟ་ན་བདག་གི་སྡུག་བསྔལ་ཞི་བའི་དོན་དུ་བདག་ཏུ་རྨོངས་པའང་བཟློག་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཀུན་རྫོབ་ཙམ་དུ་བདག་བཏགས་པ་བ་འདོད་ན་ནི་བཟློག་པར་བྱ་བ་མ་ཡིན་མོད།",
    "ཤིང་གི་རྩ་བ་བཅད་པས་ཡལ་ག་དང་ལོ་འདབ་ཐམས་ཅད་སྐམ་པར་འགྱུར་རོ།",
    "ཞི་བའི་བློ་གྲོས་དེ་བཞིན་དུ་འཇིགས་ཚོགས་ལ་ལྟ་བ་ཉེ་བར་ཞི་བས་ཉོན་མོངས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟར་ཡིན་ནོ།",
    "ཐུན་མོང་དུ་བསྟན་པ་དང་།",
    "བྱིས་པ་རྣམས་ལུས་ལ་བདག་གི་རྟེན་གྱི་དངོས་པོ་དང་།",
    "ཚོར་བ་ལ་བདག་གི་ལོངས་སྤྱོད་ཀྱི་དངོས་པོ་དང་།",
    "སེམས་ལ་བདག་གི་རང་བཞིན་གྱི་དངོས་པོ་དང་།",
    "དམིགས་ཡུལ་དེ་དག་གི་གནས་ལུགས་ཇི་ལྟ་བར་རྟོགས་པའི་ཤེས་རབ་དང་།",
    "ཅེས་པ་ལྟར་རྣམ་པར་ཤེས་པའི་སེམས་ནི་སྐད་ཅིག་གིས་སྐྱེ་འགག་བྱེད་པས་རང་གཞན་གྱི་སེམས་ཐམས་ཅད་མི་རྟག་པར་མཉམ་པ་ཉིད་དུ་རྗེས་སུ་ལྟ་ཞིང་དྲན་པ་ལ་འཇོག་པ་དང་།",
    "ལུས་ཡང་དག་པ་མ་ཡིན་པའི་ངོ་བོར་སྣང་བ་སྒྱུ་མ་ལྟ་བུ་དང་ཚོར་བ་ལོག་པར་ཉམས་སུ་མྱོང་བ་རྨི་ལམ་ལྟ་བུ་དང་།",
    "བསམས་བཞིན་དུ་སྲིད་པར་སྐྱེ་བ་ན་འཁོར་ལོས་སྒྱུར་བ་ལ་སོགས་པའི་ལུས་དང་ཚོར་བ་ལ་སོགས་པ་ཕུན་སུམ་ཚོགས་པ་ཐོབ་ཅིང་དེ་ལ་ཡང་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་སྐྱེ་བ་ཐོབ་པའི་ཕྱིར་དང་།",
    "ཡན་ལག་སོ་སོ་བར་སྣང་བ་འདི་དག་ལས་གཞན་པའི་ལུས་ནི་མ་དམིགས་ཤིང་འདི་དག་ཀྱང་རེ་རེ་ནས་རྣམ་པར་དཔྱད་ན་ལུས་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་འདི་ལྟར་ལུས་ནི་རྐང་པ་དང་བྱིན་པ་ལྟ་བུ་རེ་རེའང་མི༵ན་ཞིང་།",
    "བརླ་དང་རྐེད་པ་ལྟ་བུ་རེ་རེའང་ལུས་མིན་ལ༵།",
    "དེ་བཞིན་དུ་རྩིབ་ལོགས་སོ་སོ་དང་ལག་པ་རེ་རེའང་ལུས་མིན་པ་ཉིད་དེ༵།",
    "མཆན་ཁུང་དག་དང་ཕྲག་པ་རེ་རེའང་ལུས་མ་ཡི༵ན་ཞིང་།",
    "མགོ་བོ་དང་མགྲིན་པ་ལྟ་བུ་རེ་རེའང་ལུས་ཀྱི་ངོ་བོ་མིན་པ་ཉིད་དེ།",
    "དེ་དག་གང་རུང་གཅིག་ཉམས་ནའང་ལུས་ཤི་འཕོས་བར་ཐལ་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡན་ལག་ཅན་གྱི་ལུས་འདི་རྐང་པ་ལ་སོགས་པའི་ཡན་ལག་ཐམས་ཅད་ལ༵་གནས་ན་ལུས་ཀྱི་ཆ་ཤས་ཕྱོགས་རེར་གནས་སམ་ལུས་ཀྱི་བདག་ཉིད་རིལ་པོར་གནས་ཞེས་བརྟག་པར་བྱའོ།",
    "དེ་ལ་ལུས་ཀྱི་ཆ་ཤས་ཕྱོགས་རེ་ཡིས་ནི་གནས་པར་གྱུར་པར་འདོད་ན༵།",
    "ལག་པ་ལ་སོགས་པའི་ཆ་ཤས་རྣམས་རང་རང་གི་ཆ་གང་ཡིན་པ་དེ་ལ་གནས་པར་འགྱུར་མོ༵ད་ཀྱི།",
    "གལ་ཏེ་བདག་ཉིད་ཀུན་གྱི་ལུ༵ས་རིལ་པོ་རེ་རེ་ལག་པ་ལ་སོགས་པའི་ཡན་ལག་སོ་སོ་བ་རྣམས་ལ་གནས་པར་འདོད་ན་ནི༵།",
    "ལག་པ་དང་རྐང་པ་ལ་སོགས་པའི་ཡན་ལག་དེ་དག་ཇི་སྙེད་པ༵་དེ་སྙེད་ཀྱི་ནི་གྲངས་དང་མཉམ་པའི་ལུས་རིལ་པོ་དུ་མ་རྣམས་སུ་ཡོད་པར་ཧ་ཅང་ཐལ་པར་འགྱུ༵ར་ཏེ།",
    "ཡན་ལག་ཅན་གྱི་ལུས་མ་གྲུབ་པ་དེ་བཞིན་དུ་རྣམ་པར་དཔྱད་ན་སོར་མོ་དུ་མ་འདུས་པའི་ཚོགས་པ་ཙམ་ཡིན་པའི་ཕྱི༵ར་ལག་པའང་རྫས་གཅིག་ཏུ་བདེན་པ་གང་ཞིག་ཡིན་པར་འགྱུ༵ར་ཏེ་བདེན་པར་མ་གྲུབ་ཅིང་།",
    "སོར་མོ་དེ་ཡང་ཚིགས་སོ་སོ་བ་འདུས་པ་རྣམས་ཀྱི་ཚོགས་པ་ཙམ་ཡིན་པའི་ཕྱི༵ར་གཅིག་ཏུ་བདེན་པ་མ་ཡིན་ལ།",
    "ཚིགས་རྣམས་ཀྱང་རང་རང་གི་སྟོད་སྨད་ལ་སོགས་པའི་ཆ་ཤས་སུ་ཕྱེ་བ༵ས་བཙལ་ན་བདེན་པའི་དངོས་པོར་མེད་དེ།",
    "ཕྱོགས་ཀྱིས་དབྱེ་བས་ཆ་དྲུག་ལ་སོགས་པར་ཕྱེ་བའི་ཆ་རེ་རེའང་དྲུག་དྲུག་ལ་སོགས་པར་ཕྱེ་ན་ཆ་ཤས་དང་བྲལ་བར་འགྱུར་བའི་ཕྱི༵ར་ཞིབ་མོར་བརྟགས་ན་ནམ་མཁའ་བཞིན་དུ་ཅིར་ཡང་མ་གྲུབ་པ་དེས་ན་རྩོམ་བྱེད་རྡུལ་ཕྲ་རབ་ལ་ཡང་རང་བཞིན་མེ༵ད་པས།",
    "དེ་ཡར་གང་གི་ཚེ་གོང་དུ་བསྟན་པ་དེ་ལྟར་ཐུན་མོང་དུ་ལུས་བདེན་པར་གྲུབ་པ་མེད་པ༵་དེའི་ཚེ་ཁྱད་པར་དུ་ཆགས་བྱའི་ཡུལ་སྐྱེས་པ་ནི་གང་ཞིག་ཡོད་ལ་བུད་མེད་ནི་ག༵ང་ཞིག་ཡོད་དེ་གང་ཡང་གྲུབ་པ་མེད་པས།",
    "འཇམ་དཔལ་གང་གི་ལུས་ནམ་མཁའ་དང་མཉམ་པར་མཐོང་བ་དེ་ནི་ལུས་ལ་ལུས་ཀྱི་རྗེས་སུ་ལྟ་བའི་དྲན་པ་ཉེ་བར་གཞག་པའོ་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དེ་ལྟ་ན་ཅི་སྟེ་རབ་ཏུ་དགའ་བདེ་ལྡན་པའི་གནས་སྐབས་ལ་ཡང་མི་གནོ༵ད་དེ་གནོད་པར་ཐལ་བ་ལས།",
    "བདེ་བའི་གནས་སྐབས་ན་སྡུག་བསྔལ་དེ་ཉམས་སུ་མ་མྱོང་ཡང་ཕྲ་མོ་ཉིད་དུ་གནས་པར་ཡོ༵ད་དོ་ཞེ་ན།",
    "བདེན་མོད་འོན་ཀྱང་སྡུག་བསྔལ་ཕྲ་མོ་དེ་ནི་དགའ་བདེ་སྟོབས་ལྡན་དེ་ལས་གཞན་དགའ་བདེ་ཆུང་ངུ་ཙ༵མ་གྱི་ངོ་བོར་ཡོད་དོ་ཞེ་ན།",
    "དེ་ལྟ་ན་སྡུག་བསྔལ་ཕྲ་མོ་ཉིད་དེ་ཡང་སྡུག་བསྔལ་དུ་བདེན་པར་ཡོད་པ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "ལྷོ་བྱང་གི་རི་བཞིན་དུ་བར་དང་བཅས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དེ་དག་ལ་བར་གཏན་ནས་མེད་ན་ཡང་རྫས་གཅིག་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "ཕྲད་པ་མེད་ན་ནི་རེག་པ་མེད་ལ།",
    "དེའི་ཕྱིར་ཡང་ཚོར་བ་མེད་པར་གྲུབ་པོ།",
    "རྡུལ་ཕྲན་རྣམས་ཆ་མེད་དུ་འདོད་པའི་ལུགས་ལའང་ཕྱོགས་གང་རུང་གཅིག་གིས་ཕྲད་པ་ཞེ༵ས་བྱ་བ་ཇི་ལྟར་འཐད་པར་འགྱུ༵ར་ཞེས་བརྟགས་ན་མི་འཐད་དེ།",
    "དེ་བས་ན་ཕྱོགས་གཅིག་གིས་ཕྲད་པའང་ཡིན་པ་དང་ནི་ཆ་མེད་ཀྱང་ཡིན་པ༵་ནི་ཤིན་ཏུ་འགལ་བའི་ཕྱིར་མི་སྲིད་དེ།",
    "ཕན་ཚུན་ཕྲད་པ་ལ་གཟུགས་ཅན་དུ་གྲུབ་དགོས་མོད།",
    "ཐམས་ཅད་ཚོགས་པ་ཞེས་བྱ་བ་དེའང་དཔྱད་ན་དངོས་པོར་བདེན་པ་མེད་པའི་ཕྱིར་ཕན་ཚུན་ཕྲད་པ་དང་རེག་པར་མི་འཐད་དེ༵།",
    "དེ་བཞིན་སོར་མོའི་ཚོགས་ཡིན་ཕྱིར།",
    "རྒྱུད་དང་ཚོགས་ཞེས་བྱ་བ་ནི།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བ་གང་གིས་མྱོང་བ་པོ་གང་ལ་གནོད་པར་འགྱུ༵ར་ཏེ་དཔྱད་ན་སྡུག་བསྔལ་བདེན་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་གང་གི་ཚེ་ཚོར་བ་པོའི་བདག་འགའ་ཡང་བདེན་པར་གྲུབ་པ་མེད་ཅི༵ང་ཉམས་སུ་མྱོང་བར་བྱ་བའི་ཚོར་བའང་དོན་ལ་ཡོད་པ་མ་ཡིན་ན༵་དེའི་ཚེ་དོན་དམ་པའི་རིགས་པས་དཔྱད་ན་མྱང་བྱ་མྱོང་བྱེད་ཐམས་ཅད་བདེན་མེད་དུ་གྲུབ་པའི་གནས་སྐབས་འདི་མཐོང་ན༵ས་བདེ་སྡུག་ལ་བླང་དོར་གི་སྲེད་པ་ཅིས་ཕྱིར་ལྡོག་པར་མི་འགྱུ༵ར་ཏེ་ཅིས་ཀྱང་ལྡོག་པར་འགྱུར་དགོས་སོ།",
    "མིག་ཤེས་ཀྱི་མཐོང་བའམ་ནི་ལུས་ཤེས་ཀྱིས་རེག་པའི་བར་ཡ༵ང་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་གྱི།",
    "ཡང་ཚོར་བ་ཡོད་པར་སེམས་ཀྱིས་མཐོང་ངོ་ཞེ་ན།",
    "རྫས་ཐ་དད་དུས་མཉམ་པ་ལ་བདག་གཅིག་དེ་བྱུང་གི་འབྲེལ་བ་མེད་ཅིང་།",
    "སྣང་ཙམ་དུ་དེ་ལྟར་ཡིན་མོད།",
    "བརྟགས་ན་རང་རིག་བཀག་ཟིན་པས་ཚོར་བ་རང་གིས་བདག་ཉིད་ཉམས་སུ་མྱོང་བ་མ་ཡིན་ལ༵།",
    "འཇམ་དཔལ་གང་གིས་ཚོར་བ་མི་དམིགས་ན་དེ་ནི་ཚོར་བ་ལ་ཚོར་བའི་རྗེས་སུ་ལྟ་བའི་དྲན་པ་ཉེ་བར་གཞག་པའོ་ཞེས་པ་ལྟར་རོ།",
    "འཇམ་དཔལ་གང་གིས་སེམས་མིང་ཙམ་དུ་ཤེས་ན་དེ་ནི་སེམས་ལ་སེམས་ཀྱིས་རྗེས་སུ་ལྟ་བའི་དྲན་པ་ཉེ་བར་གཞག་པའོ་ཞེས་པ་ལྟར་རོ།",
    "དང་པོ་བདེན་གཉིས་མི་འཐད་པར་ཐལ་བ་སྤང་བ་ནི།",
    "གཉིས་པ་དཔྱོད་ཚུལ་མི་འཐད་པར་ཐལ་བར་སྤང་བ་ནི།",
    "རེ་ཞིག་ཇི་ལྟར་འཇིག་རྟེན་ན་སྣང་བ་དང་གྲགས་པ་ཙམ་ལ་བརྟེན་ན༵ས་དགག་སྒྲུབ་ཀྱི་རྣམ་པར་དཔྱད་པ་ཐམས་ཅད་བརྗོ༵ད་པ་ཡིན་པས་སྐྱོན་མེད་དོ།",
    "འོན་ཏེ་གང་གི་ཚེ་དང་པོར་རྣམ་པར་དཔྱད་པ་ཡི༵ས་བཙལ་ནས་རྣམ་དཔྱོད་བདེན་པར་གྲུབ་པ་ཉིད་ཀྱིས་ནི་ཡུལ་ལ་དཔྱོད་པར་བྱེད་དགོས་པ་ཡིན་ན༵།",
    "དེའི་ཚེ་རྣམ་པར་དཔྱོད་བྱེད་ཀྱི་ཤེས་པ་དེ་ཡང་ནི༵་རྣམ་དཔྱོད་གཞན་ཞིག་གིས་རྣམ་པར་དཔྱོད་དགོས་པར་རིགས་པ་མཚུངས་པའི་ཕྱིར་ན་རྣམ་པར་དཔྱོད་བྱེད་ཐུག་པ་མེ༵ད་པར་ཐལ་བའི་སྐྱོན་དུ་འགྱུར་རོ།",
    "དངོས་སྨྲ་པ་གང་གི་ལུགས་ལྟར་ན་ཡུལ་དང་ཡུལ་ཅན་འདི་གཉིས་རྟེན་དང་བརྟེན་པའི་ཚུལ་གྱིས་དོན་དམ་དུ་བདེ༵ན་པར་འདོད་པ་དེ་ཉིད་བསྐྱང་བ་ཤིན་ཏུ་དཀའ་བར་གན༵ས་ཏེ།",
    "རང་གིས་རང་མི་རིག་ཅིང་གཞན་གྱིས་རྟོགས་དགོས་ན་སྒྲུབ་བྱེད་ཐུག་མེད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སུས་ཀྱང་མ་བྱས་རང་གི་ངོ་བོས་བྱུང་།",
    "རེ་ཞིག་ཀུན་རྫོབ་ཙམ་དུ་འཇིག་རྟེན་པའི་མངོན་སུམ་དང་རྗེས་དཔག་ལ་སོགས་པ་ཉིད་ཀྱི༵ས་འབྲས་བུ་སྣ་ཚོགས་སུ་སྣང་བ་རྣམས་རང་རང་གི་རྒྱུ་རྣམས་ཐམས་ཅད་ཡོད་མེད་ཀྱི་རྗེས་སུ་འགྲོ་ལྡོག་བྱེད་པར་མཐོང་བ་ཡི༵ན་པའི་ཕྱིར་རོ།",
    "འོ་ན་དེ་དག་གི་རྒྱུའི་དབྱེ་བ་དེ་ཡང་གང་གིས་བྱས་ཏེ།",
    "སེམས་མེད་པར་ནི་རང་གི་འབྲས།",
    "དེ་ལྟ་ན་ནི་འབྲས་བུ་གསར་བྱུང་མི་སྲིད་པར་ཡང་ཐལ་བར་འགྱུར་རོ་ཞེས་པའམ།",
    "འབྲས་བུ་སྣོད་བཅུད་ཆགས་འཇིག་གི་ཡང་ཐོག་མ་ངེས་པ་ག་ལ་ཡོད་དེ་མེད་པས་ཐོག་མེད་ནས་བརྒྱུད་པ་ལས་བྱུང་པ་ཉིད་དོ།",
    "རྐྱེན་གཞན་རེས་འགའ་བ་ལ་ལྟོས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "རང་གི་འབྲས་བུ་ལ་ལྟོས་པ་ནི་མི་རིགས་པའི་ཕྱིར་དང་།",
    "རང་གི་འབྲས་བུ་མ་ཡིན་པའི་དངོས་པོ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "དྲུག་གིས་གཅིག་ཅར་སྦྱར་བ་ན།",
    "རྡུལ་ལ་སོགས་པ་རེ་རེའི་ངོ་བོར་གྲུབ་པའི་བེམ་པོ་ཐམས་ཅད་ཀྱང་ཡོན་ཏན་གསུམ་གསུམ་གྱི་བདག་ཉིད་དུ་འདོད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཡང་ཁྱོད་ཀྱི་ལུགས་ལ་རྣམ་འགྱུར་འབྲས་བུའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡང་བདེ་བ་ལ་སོགས་པ་ཚོར་བ་གསུམ་གྱི་ངོ་བོ་ཡོན་ཏན་གསུམ་པོ་ཉི༵ད་ཡིན་པར་འདོད་ན།",
    "དེ་ལྟར་མ་ཡིན་ཅིང་རེས་འགའ་བར་དམིགས་པའི་ཕྱིར་ཡང་མི་རྟག་པར་གྲུབ་བོ།",
    "རྟག་ཏུ་ཡོད་ཀྱང་དེ་ཉིད་རེས་འགའ་ཕྲ་མོར་གྱུར་པས་མྱོང་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བདེ་སོགས་དེ༵་དག་རེས་འགའ་རགས་པ་དང་རེས་འགའ་ཕྲ་བར་འགྱུར་བའང་ཇི་ལྟར་ཡི༵ན་ཏེ་རྟག་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྔར་གྱི་རགས་པའི་ངོ་བོ་དོར་ནས་ཕྱིས་ཕྲ་མོའི་ངོ་བོར་གྱུར་བ༵ས་སྣ་ཚོགས་སུ་འགྱུར་བ་ཡིན་ན།",
    "རྒྱུའི་དུས་ན་གནས་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་གྲངས་ཅན་པ་འདོད་ན༵་རྒྱུའི་གནས་སྐབས་ན་གསལ་བ་མེད་པར་འབྲས་བུ་སྐྱེ་བ་ནི༵་ཁྱོད་ཀྱི་ལུགས་ལའང་དངོས་སུ་མི་འདོད་ཀྱང་དོན་ལ་གནས་པ་ཉི༵ད་དེ།",
    "ཡང་གལ་ཏེ་རྒྱུ་ལ་འབྲས་བུའི་ངོ་བོ་གཅིག་ཏུ་གནས་ན༵་ཟན་བཟང་པོ་ཟ་བ་རྣམས་ཀྱང་མི་གཙང་བ་ངན་པ་ཟ་བར་ཧ་ཅང་ཐལ་འགྱུ༵ར་ཏེ།",
    "ཡང་ཁྱོད་ཀྱི་ལུགས་ལ་འབྲས་བུ་དེ་ཉིད་ཤེས་པ་དེ་རྒྱུ་འཇིག་རྟེན་པ་ལ་ཡང་ནི༵་ཡོད་དགོས་པས་ས་བོན་ལ་རས་ཡུག་ཡོད་པ་ལ་སོགས་པའང་དེས་ཅི་སྟེ་མཐོང་མ་ཡི༵ན་ཏེ་མཐོང་བར་རིགས་སོ།",
    "དཔྱད་ན་བརྫུན་པ་ཡིན་ཡང་རེ་ཞིག་གཉེན་པོར་འགྱུར་བ་ནི་མི་འགལ་ཏེ་དགག་བྱ་བུམ་པ་ལ་སོགས་པ་བརྟགས་པའི་དངོས་པོ་ལ་མ་རེག་ཅིང་མ་དཔྱད་པ༵ར།",
    "དགག་བྱ་བདེན་པའི་དངོས་པོ་མ་གྲུབ་པ་དེའི་ཕྱིར་བརྫུན་པའི་དངོས་པོ་གང་ཡི༵ན་པ་དེ་བཀག་པ་ཡིད་དངོས་མེད་སྟོང་བ་ཉིད་ཀྱང་གསལ་བར་བརྫུ༵ན་པ་ཉིད་ཡིན་མོད།",
    "ལས་དང་ཉོན་མོངས་པ་ལ་སོགས་པ་རང་རང་གི་རྒྱུ་རྣམས་ཀྱིས་ནི་གང་སྤྲུལ་པ༵འི་ཀུན་རྫོབ་ཀྱི་དངོས་པོ་དེ་ནི་དོན་དམ་པའི་རིགས་པས་དང་པོར་སྐྱེ་བ་ན་གང་ནས་འོངས་པར་གྱུར་ཅི༵ང་།",
    "དེ་དག་གི་བར་གང་ན་གནས་པའི་ཚུལ་ལའང་ལེགས་པར་བརྟག་པར་གྱི༵ས་ཤིག་དང་།",
    "གལ་ཏེ་འགྱུར་ན་དངོས་པོ་གཅིག་ཉིད་སྔར་དངོས་པོར་ཡོད་པ་དང་ཕྱིས་དངོས་པོ་མེད་པའི་རང་བཞིན་གཉིས་སུ་བདེན་པར་ཧ་ཅང་ཐལ་བར་འགྱུར་བ་ལས།",
    "དེ་ལྟར་དངོས་པོ་ཡོད་མེད་ཀྱི་མཐའ་ལ་བརྟགས་ནའང་དོན་དམ་པར་སྐྱེ་བ་མེད་ཅིང་འགག་པ་མེད་པར་གྲུབ་པས་ཟབ་མོ་སྟོང་བ་ཉིད་ཀྱི་ཚུལ་ལ་མོས་པར་བྱའོ།",
    "དེས་ན་མཉམ་པར་ཁྱོད་བཞེད་ལགས།",
    "གང་གིས་ཡོན་ཏན་བསྒྲགས་ནས་བསྟོད་དེ་བཀུར་སྟི་དང་རིམ་གྲོ་བྱས་པའ༵མ་སྐྱོན་བསྒྲགས་ནས་སྨད་ཀྱི་གནོད་པ་དང་ཡོངས་སུ་བརྙས་པ་བྱས་པའང་ཅི་ཞིག་ཡོ༵ད་དེ་ཅིའང་མེད་ཅིང་།",
    "བདག་གི་ཡིད་ཡུལ་མིན་པར་མགོ་སྙོམས་མཛོད།",
    "དཔེར་ན་ལྟ་བ་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་འགའ་ཞིག་ཆུ་བསིལ་བས་ཡང་ཡང་ཁྲུ༵ས་བྱས་ཏེ་གྲང་བས་ཉེན་པ་ན་ཡང་ཡང་མེར་འཇུག་པ༵་དེ་ལྟར་ཚ་གྲང་རེ་མོས་ཀྱི་སྒོ་ནས་ཤིན་ཏུ་སྡུག་བསྔལ་བ༵ར་གནས་ཀྱང་བདག་ཉིད་བདེ་བ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་རློམ་པ་བཞི༵ན་ནོ།",
    "དེ་བས་ཀྱང་སྒྲིབ་པ་གཉིས་ཀྱི་གཉེན་པོ་མཐར་ཐུག་པ་ཟབ་མོ་སྟོང་པ་ཉིད་རྟོགས་པའི་ཤེས་རབ་ནི་མཆོག་ཡིན་པས།",
    "ཤེས་རབ་ཀྱིས་ཉོན་མོངས་པ་དང་ཤེས་བྱ་འི་སྒྲིབ་པ་ཀུན་སྤོང་དེ་ཡི་ཕྱིར།",
    "ཀུན་ནས་ཀུན་ཏུ་བཟང་པོར་རེད་གྱུར་ཅིག།",
    "བཅོམ་ལྡན་ཁྱོད་ཀྱི་གང་གསུངས་པ།",
    "ཀུན་ཏུ་ཐོགས་མེད་གཟིགས་པར་ལྡན།",
    "སྐྱེ་བོའི་ཚོགས་རྣམས་བདག་གིས་སྒྲོལ་གྱུར་ཅིག།",
    "རང་གི་དོན་དང་།",
    "མཆོག་གི་དོན་དུ་བསྔོ་བའོ།",
    "མནར་མེད་པ་འོ་དེ་ཙམ་མོ།",
    "ཐམས་ཅད་ཕན་ཚུན་དགྲའི་འདུ་ཤེས་སུ་གྱུར་ནས་བསྣུན་རེས་བྱས་པས་ཤིན་ཏུ་སྡུག་བསྔལ་ནས་བརྒྱལ་ཞིང་ས་ལ་འགྱེལ་བ་ན།",
    "སྟེའུ་དང་སྟ་རེ་ལ་སོགས་པས་འཇོག་པའི་སྡུག་བསྔལ་དང་།",
    "ལུག་དང་རྟ་དང་གླང་པོ་ཆེ་དང་སེང་གེ་དང་སྟག་གི་གདོང་པ་ལྟ་བུའི་བར་དུ་འཇུག་ཅིང་།",
    "དེ་མ་ཐག་རི་དེ་དག་གིས་བཙིར་བས་བུ་ག་ཐམས་ཅད་ནས་ཁྲག་གི་རྒྱུན་འབབ་པ་དང་ཡང་འདུས་པ་ན་ལྕགས་ཀྱི་འཁྲུལ་འཁོར་ཆེན་པོས་བུར་ཤིང་ལྟར་འཚིར་བ་དང་།",
    "ཡང་འདུས་པ་ན་ལྕགས་བསྲེགས་ཀྱི་གཞི་ལ་ལྕགས་ཀྱི་ཕ་བོང་གི་ཆར་འབབ་པས་རྡུང་ཞིང་འཇོམས་པའི་སྡུག་བསྔལ་དང་།",
    "མནར་མེད་པ་རྣམས་ཀྱི་ལུས་ལ་ལྕགས་ཀྱི་ས་གཞི་ལས་ཕྱོགས་ཐམས་ཅད་ནས་མེ་རབ་ཏུ་འབར་བ་འོངས་ཏེ་དེའི་པགས་པ་དང་ཤ་དང་རྒྱུས་པ་དང་རུས་པ་དང་རྐང་གི་བར་དུ་སྲེག་ཅིང་།",
    "དེ་དག་གི་ནི་ངོས་བཞི་ན།",
    "མེ་མ་མུར་གྱི་ཐང་ཆེན་པོ་པུས་མོ་ནུབ་ཙམ་ལ་ཕྱིན་པ་ན།",
    "རོ་མྱགས་ཕྱི་སའི་འདམ་རྫབ་ཤིན་ཏུ་དྲི་ང་བར་ལུས་བྱིང་བ་ན་སྲིན་བུ་མཆུ་རྣོན་པོ་ཅན་རྣམས་ཀྱིས་པགས་པ་ནས་རྐང་གི་བར་དུ་ཕུག་སྟེ་ཟ་བ་དང་།",
    "ཆུ་བོ་རབ་མེད་ཅེས་བྱ་བ་ཐལ་ཚན་ནམ།",
    "བདག་ཅག་གིས་ནི་ཅིའང་མི་ཤེས་མི་མཐོང་མོད།",
    "འོན་ཀྱང་བཀྲེས་སོ་སྒོམ་མོ་ཞེས་པ་ལ།",
    "མནར་མེད་པས་བར་བསྐལ་གཅིག་གི་བར་ལ་སྡུག་བསྔལ་དྲག་པོ་རྒྱུན་མི་འཆད་པར་མྱོང་བར་གསུངས་སོ།",
    "ལུས་ཀྱི་ཁྱད་པར་ཤིན་ཏུ་གཞོན་ཤ་ཅན་རེག་ཏུ་མི་བཟོད་པ་གྲུབ་ནས།",
    "སྔོ་བ་ལས་ཀྱང་ཐལ་ནས་དམར་བོར་གྱུར་ཅིང་ཁ་བཅུའམ་ཏེ་བས་ཀྱང་ལྷག་པར་གྱེས་པ་པདྨ་ལྟར་གས་པ་དང་།",
    "ཉི་ཚེ་བ་ནི་གནས་ངེས་པ་མེད་པར་གཤེད་མ་འགའ་ཞིག་ཐལ་གོང་དང་ཁ་སྣ་ལ་བྱ་གཅན་གྱིས་འཐོག་པར་སྐྱེས་པ་དང་།",
    "ལོ་བརྒྱ་བརྒྱ་ན་ཏིལ་རེ་རེ་ཕྱུང་བས་ཟད་པར་གྱུར་པ་ནི་ཆུ་བུར་ཅན་གྱི་ཚེ་ཚད་ཡིན་ལ།",
    "ཐམས་ཅད་རང་རང་གི་སྡུག་བསྔལ་གང་ཡིན་པ་ལས་རྣམ་པར་གྲོལ་ནས་མྱུར་དུ་མཐོ་རིས་དང་ཐར་བའི་བདེ་བ་བླ་ན་མེད་པ་ཐོབ་པར་གྱུར་ཅིག་ཅེས་པའི་དོན་ཏོ།",
    "གཉིས་པ་སྤྱན་རས་གཟིགས་ཀྱི་མཐུས་ཞི་བར་བསྔོ་བ་ནི།",
    "དེ་ཡང་འུ་བུ་ཅག་མང་པོའི་ཐད་དུ་ནི༵་འཕགས་པ་གང་གི་མཐུ་ཡིས་གཅོད་འདྲལ་ལ་སོགས་པའི་སྡུག་བསྔལ་ཀུན་དང་བྲལ་ཞིང་རབ་ཏུ་དགའ་བའི་ཤུགས་ཕྱིན་པར་མཛད་ལ༵།",
    "དང་པོ་དེ་དག་གི་རྩ་བའི་གནས་ནི་རྒྱ་མཚོ་ཆེན་པོ་དང་འཕྲོས་པའི་གནས་ནི།",
    "ལུས་ཆུང་བ་ལ་སྐྲའི་རྩེ་མོ་ལ་བཅུ་ཆ་ཙམ་དང་།",
    "ཉི་ཟེར་ཀྱི་རྡུལ་ཙམ་དང་རྒྱ་ཤུག་གི་ཚི་གུ་ཙམ་དང་།",
    "སྲིན་བུ་ལ་སོགས་པ་ཆུང་བ་རྣམས་ཀྱིས་ཆེ་བ་མང་པོའི་ལུས་ཕུག་སྟེ་ཟ་བ་དང་ཕན་ཚུན་གཅིག་གིས་གཅིག་གསོད་ཅིང་འཚེད་པ་དང་།",
    "ཁྱད་པར་ཀླུ་རྣམས་ཉིན་རེ་ཞིང་བྱེ་ཚན་གྱི་ཆར་པས་ཤ་ཐམས་ཅད་རུས་པ་ལ་ཐུག་པར་སྲེག་པ་དང་།",
    "དེ་རྣམས་རང་རང་གི་སྡུག་བསྔལ་མཐའ་དག་ལས་རྣམ་པར་གྲོལ་བའི་བདེ་བ་ཐོབ་པར་གྱུར་ཅིག་ཅེས་པའི་དོན་ཏེ།",
    "དང་པོ་དེ་དག་གི་རྩ་བའི་གནས་ནི་གླིང་འདིའི་དཔག་ཚད་ལྔ་བརྒྱའི་འོག་ལ་སོགས་པ་དང་འཕྲོས་པའི་གནས་མིའི་ཡུལ་དང་རྒྱ་མཚོའི་འགྲམ་དང་མཁའ་ལ་རྒྱུ་བ་རྣམས་ནམ་མཁའི་སྤྱོད་ཡུལ་ལ་སོགས་པ་རྣམས་སུ།",
    "ཟླ་བ་ཉིན་ཞག་གིས་ལྔ་བརྒྱ།",
    "དཔེར་ན་བྱང་སྒྲ་མི་སྙན་པའི་མི་རྣམས་སུས་ཀྱང་བདག་གིར་མ་བཟུང་ཞིང་།",
    "མིའི་ནང་དུའང་ལོང་བ་རྣམས་ཀྱིས་མིག་གསལ་བོ་ཐོབ་སྟེ་གཟུགས་མཛེས་པ་རྣམས་མཐོང་བར་ཤོ༵ག་ཅིག་འོན་པ་རྣམས་ཀྱིས་ཀྱང་རྣ་བ་གསོང་པོ་ཐོབ་སྟེ་རྟག་ཏུ་སྒྲ་ཡིད་དུ་འོང་བ་རྣམས་ཐོས་པར་ཤོ༵ག་ཅིག་ཡུམ་ལྷ་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ལས་སྲས་གཞོན་ནུ་དོན་གྲུབ་བཙས་པ་ཇི་ལྟ་བ་བཞིན་དུ༵་ནི་སྦྲུམ་མ་རྣམས་ལའང་ན་བའི་གནོད་པ་མེད་པར་སྲས་ཡིད་དུ་འོང་བ་རྣམས་བདེ་བའི་སྒོ་ནས་བཙའ་བར་ཤོ༵ག་ཅིག་གཅེར་བུར་གྱུར་པ་རྣམས་ཀྱི་གོས་སྲབ་འཇམ་ཡང་བ་རེག་ན་བདེ་བ་དག་ད༵ང་།",
    "ཁྱད་པར་ལམ་དུ་ཞུགས་པའི་འགྲོན་པོ་དག་ནི་ཐམས་ཅད་ལ༵་ཡང་གང་དུ་འགྲོ་བའི་ཕྱོགས་རྣམས་ཐམས་ཅད་དུ་ཆོམ་རྐུན་ལ་སོགས་པའི་འགལ་རྐྱེན་མེད་པས་ལམ་བདེ་ཞིང་བཀྲ་ཤིས་པའི་མཐུན་རྐྱེན་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་ཤོ༵ག་ཅིག་དགོས་པ་གང་གི་དོན་དུ་འགྲོ་བར་བྱེད་པ༵འི་བྱ་བ་དེ་དག་ཐམས་ཅད་ཀྱང་འབད་པ་དང་རྩོལ་བ་གང་ཡང་མི་དགོས་པར་ཐབས་ལ་མཁས་པའི་སྒོ་ནས་ལྷུན་གྱིས་གྲུབ་པར་གྱུར་ཅི༵ག་ཆུ་བོ་ཆེན་པོ་རྣམས་ལ་བགྲོད་པའི་གྲུ་དང་རྒྱ་མཚོ་ཆེན་པོ་ལ་བགྲོད་པའི་གྲུ་ཆེན་དང་གཟིངས་སུ་ཞུགས་པ་རྣ༵མས་ནོར་བུ་ལེན་པ་ལ་སོགས་པ་གང་ཡིད་ལ་བསམས་པའི་དོན་ཐམས་ཅད་གྲུབ་པར་གྱུར་ཏེ༵།",
    "དེ་དག་གི་དྲེགས་པ་དང་ང་རྒྱལ་དག་ཀྱང་བཅོམ་ནས་ཞི་ཞིང་དུལ་བ་དང་ལྡན་པར་ཤོ༵ག་ཅིག་ཅེས་པའོ།",
    "ལུས་ཅན་མ་ལུས་པ་ཀུན་གྱིས་བྱ་ཡིད་དུ་འོང་བ་རྣམས་དང་ནི༵་ཤིང་གི་ཁྱད་པར་སྣ་ཚོགས་པ་དང་།",
    "གཉིས་པ་མཆོག་གི་དོན་དུ་བསྔོ་བ་ལ་བདུན་ལས།",
    "གཉིས་པ་རང་གི་དོན་དུ་བསྔོ་བ་ལ་གསུམ་ལས།",
    "ཞེས་པ་ལ་སོགས་པ་ནི་རྗེས་འཇུག་གི་སྐྱེ་བོ་རྣམས་ལམ་ལ་བསླབ་པའི་དོན་ཏོ།",
    "མཆོག་སྦྱིན་རྡོ་རྗེ་མཆོག་ཁྱོད་འདུད།",
    "ཡང་དག་མཐར་གྱུར་ཁྱོད་ལ་འདུད།",
    "གང་གི་བཀའ་དྲིན་འོད་ཀྱིས་གསལ་བྱས་བདག་ཉིད་ཀྱི།",
    "བར་སྐབས་སུ་ཅུང་ཟད་མ་དག་པར་སོང་བ་རྣམས་བདག་གིས་ཀྱང་རྒྱ་དཔེ་དང་འགྲེལ་བ་ལ་གཏུགས་ཏེ་དག་པར་བགྱིས་པའོ།",
    "རྣམ་མང་དོན་མཆོག་རྣམ་གསལ་ཚིག་གིས་བདེ་བླག་ཉིད་དུ་རྟོགས་བྱའི་ཕྱིར།",
    "ཟབ་མོའི་ལུང་དང་རིགས་པ་ལ་བརྟེན་ནས།",
    "ཟབ་མོའི་དོན་ལ་ཉེས་པའི་ཆ་མཆིས་ན།",
    "ཟབ་མོའི་ཐུགས་མངའ་རྣམས་ལ་བཟོད་པར་གསོལ།",
    "གང་གི་དྲིན་ལས་བདག་འདྲའི་བློས་ཀྱང་ཟབ་མོའི་གནས་ལུགས་རྟོགས་གྱུར་པ།",
    "ཉོན་མོངས་ཤེས་བྱའི་གཡུལ་རྣམས་སྤ་གོང་མཁན།"
  ]
}