    "དབྱིག་པ་ལ་སོགས་པས་རྡེག་པར་བྱེད་པའམ།",
    "དེ་ཉིད་ནི་བདག་ལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིའམ་ཕ་རོལ་དུ་སྲོག་ཆགས་འགའ་ལ་ཡང་མི་འདོད་པར་མ་གྱུར་ཅིག་ཅེས་པའོ།",
    "ངེས་པར་ལེགས་པར་རྫོགས་པའི་ཆེད་དུའོ།",
    "སྐུར་འདེབས་པ་ཞེས་བྱ་བ་ནི་ལོག་པར་བརྟགས་པའི་ཉེས་པས་སུན་འབྱིན་པར་འགྱུར་བ་དང་།",
    "གཞན་དུ་ཡང་གང་དག་ལུས་སམ་ཡིད་ཀྱིས་གནོད་པ་བྱེད་པར་འགྱུར་བའོ།",
    "མགོན་མེད་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་མགོན་དང་བཅས་པར་འདོད་པ་རྣམས་ཀྱིའོ།",
    "བུམ་པ་བཟང་ཞེས་བྱ་བ་ནི་དངོས་པོ་གང་དང་གང་འདོད་པའི་བསམ་པས་དེར་ལག་པ་བཅུག་ན་དེ་དང་དེ་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་བྱེད་པའོ།",
    "ཐམས་ཅད་མྱ་ངན་འདས་པར་དུ།",
    "དེ་བཞིན་དུ་སྲེད་མེད་ཀྱི་བུས་ཞུས་པ་ལས་ཀྱང་གསུངས་ཏེ།",
    "དད་པའི་རྩ་བ་བརྟན་བྱས་ཏེ།",
    "ཡང་ན་ཇི་ལྟར་གཟུང་བ་དེ་ཉིད་བཅོམ་ལྡན་འདས་ཀྱིས་མཁྱེན་པའོ།",
    "དེར་ཐུགས་ནི་ལྷག་པའི་བསམ་པས་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡིད་ལ་བྱེད་པ་སྟེ།",
    "གནས་སྐབས་བར་མ་ལ་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "ཞེས་གང་འཆད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེས་གསུངས་པ་དང་མཐུན་པར་སྨྲས་པས་ཤིན་ཏུ་མཉམ་པར་གཞག་པས་བརྗོད་པར་བྱའོ།",
    "སྤྱོད་པ་དཔག་ཡས་སྤྱད་པར་བགྱི།",
    "ཚངས་པར་སྤྱོད་པ་སྤྱད་པར་བགྱི།",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་རྣམས་བསླུས་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཉན་ཐོས་ཀྱིས་བསྐུལ་ཞིང་སྐྱོ་བར་བྱས།",
    "མཇུག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "མཇུག་གསུམ་དང་འབྲེལ་པར་གཟུང་བ་སྟེ།",
    "ལས་ཡོངས་སུ་རྫོགས་པ་ནི་འབྲས་བུ་ཡང་ངེས་པར་འགྱུར་རོ།",
    "བཟུང་ནས་ནི་ཡང་དག་པར་བླངས་ནས་ཏེ་བསྐྱེད་ནས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱས་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གཞན་དུ་གལ་ཏེ་བཟུང་ནས་གུས་པ་ཞན་པའམ།",
    "ཡིད་ལ་གཅགས་པར་གྱུར་ན་དེའི་ཚེ་མི་འཕེལ་བ་ཉིད་དམ།",
    "ཡོངས་སུ་ཟད་པར་འགྱུར་རོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་རིམ་པས་གཟེངས་བསྟོད་དོ་ཞེས་པ་ནི་སྤྲོ་བར་བྱ་བའོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ནི་ང་རྒྱལ་ཁྱད་པར་དུ་འཕགས་པ་ཡིད་ལ་བྱེད་པས་སེམས་དམན་པ་ཉིད་ཡོངས་སུ་དོར་བའོ།",
    "ལོང་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "འདི་དག་ཐམས་ཅད་ནི་ཤིན་ཏུ་ཡང་འཕྲད་པར་དཀའ་བའོ་སྙམ་དུ་དགོངས་པའོ།",
    "འདིར་ཡང་དེ་ཉིད་དཔེ་ཉིད་དུ་དེ་བཞིན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡང་འདི་ལྟར་ཡང་དག་པར་རབ་ཏུ་དགའ་བར་བྱ་སྟེ།",
    "དཔྱིས་འབྱིན་ནི་ངེས་པར་འབྱིན་པའོ།",
    "རྣམ་པ་གཞན་ཡང་བདེ་བའི་ལོངས་སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "སྤྱད་པར་འདོད་པ་ལ་ཞེས་བྱ་བ་ནི་ལོངས་སྤྱད་པར་འདོད་པའོ།",
    "ཚིམ་པར་བྱེད་པ་ཡིན་ཞེས་བྱ་བ་ནི་བདེ་བ་ཐམས་ཅད་ཀྱིས་ངོམས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་འབྱུང་གནས་བློ་གྲོས་ཀྱིས་བྱས་པ་ལས་ལེའུ་གསུམ་པའོ།",
    "དེ་ལྟར་མཇུག་རྒྱས་པར་བརྗོད་ནས།",
    "དེ་ལས་བཟློག་པ་ལ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱལ་བའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྩམས་པ་གང་ཡིན་པ་ནི་ལེགས་པར་བརྟགས་པའང་མ་ཡིན་པ་སྟེ།",
    "དེ་བས་ན་ཇི་ལྟར་དམ་བཅས་པ་བཞིན་དུ་ལེགས་པར་བརྩམས་པ་ཉིད་རིགས་པ་ཡིན་ནོ།",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་བསླུས་པར་ཡང་འགྱུར་རོ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་མ་འདས་པ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་བྱ་བའི་ཕྱིར་དབུགས་དབྱུང་ནས་ལས་ཀྱིས་བསྒྲུབ་པར་མ་བྱས་ན་སྟེ།",
    "གང་དག་མཆོད་སྦྱིན་ཆེན་པོ་བྱ་བར་དམ་བཅས་པ་ཉམས་འོག་ཏུ་ཆུད་པར་བྱེད་པའི་མཆོད་སྦྱིན་གྱི་བདག་པོ་དེ་དག་ནི་དཀོན་ནོ།",
    "དངོས་པོ་ཕལ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཟན་ལ་སོགས་པའི་ངོ་བོའི་དངོས་པོ་ཅུང་ཟད་ཙམ་སྟེ་ཉུང་ཟད་ཙམ་ལ་ཡང་འདི་སྦྱིན་པར་བྱའོ་སྙམ་དུ་སེམས་ཀྱིས་རྣམ་པར་བསམས་ཏེ།",
    "སླར་ཡང་དེ་སྦྱིན་པ་ལ་སོགས་པ་ལས་ལྡོག་པར་བྱེད་པ་དེ་ཡང་འཇིག་རྟེན་ཕ་རོལ་དུ་ཡི་དགས་འགྱུར་གསུངས་ན་ཞེས་བྱ་བ་ནི་ལུང་ནས་བརྗོད་པའོ།",
    "འགྲོ་བ་མ་ལུས་པའི་དོན་བླ་ན་མེད་པ་དམ་བཅས་ནས་སྒྲུབ་པར་མི་བྱེད་པ་ལྟ་ཅི་སྨོས།",
    "གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གཞན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདེ་འགྲོ་ཉམས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་རྫོགས་པར་བྱ་བའོ།",
    "ད་དུང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་འདི་འདྲའི་འདུ་འཕྲོད་ནི་ཤིན་ཏུ་དཀོན་ཞེས་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར་དེང་ནས་བརྩོན་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དད་པ་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་དོན་དད་པས་སྡུད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གང་ནམ་ཞིག་ཐོབ་པར་འགྱུར་ཏེ།",
    "ལུས་དང་སྲོག་ལ་ཡིད་ཆེས་པ་མེད་པ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "མི་ལུས་འཐོབ་པའི་ངེས་པ་ཡང་མེད་པ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་མེད་པར་བདེ་འགྲོ་ག་ལས་འབྱུང་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ཕྱིར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་ཉིད་ཅེས་བྱ་བ་ནི་མི་ཁོམ་པ་བརྒྱད་རྣམ་པར་སྤངས་པའི་མིའི་ལུས་སོ།",
    "སྐད་ཅིག་གཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་དངོས་པོ་གཞི་མཚམས་མེད་པ་ནི་སྐད་ཅིག་མ་གཅིག་ཉིད་ལ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དཔེར་ན་མིག་བཙུམས་པ་དུ་མའི་བྱ་བ་ལ་ཡང་མྱུར་བར་བསྟན་པར་བྱ་བའི་དོན་དུ་མིག་བཙུམས་པ་ཙམ་གྱིས་བྱེད་དོ་ཞེས་བརྗོད་པ་ལྟ་བུའོ།",
    "བསྐལ་པར་གནས་གྱུར་ན་ཞེས་བྱ་བ་ནི་བར་གྱི་བསྐལ་པ་གཅིག་སྟེ།",
    "མནར་མེད་པ་བར་གྱི་བསྐལ་པར་བརྗོད་དོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "འབྲས་བུ་ཉམས་སུ་མྱོང་བཞིན་པ་ཡང་རྣམ་པར་སྨིན་པ་ཡོངས་སུ་འཛད་ན།",
    "དེ་ཙམ་ཁོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལས་དེས་བསྐྱེད་པའི་སྡུག་བསྔལ་ལས་རྣམ་པར་གྲོལ་བར་མི་འགྱུར་བའོ།",
    "གཏི་མུག་ནི་ཤིན་ཏུ་ནུས་པ་དང་ལྡན་པར་རིག་ནས་ཇི་སྐད་དུ་བསྟན་པའི་བསླབ་པ་སྒྲུབ་པའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་བརྟེན་པར་སྤྱད་པར་བྱའོ།",
