    "ཁྱམས་དེ་དག་གི་གཉེན་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "དམིག་པ་དང་མཚུངས་པར་ལྡན་པའི་སྒོ་ནས་ཟག་པ་རྣམས་རྒྱས་པར་འགྱུར་བ་དེ་ཡང་བདག་གིར་བྱས་པས་ཡིན་ཏེ།",
    "གྲོང་དང་འོག་དང་རང་གི་ས་པ་མཉམ་པ་དྲང་ཁྱད་པར་ཅན་གཉིསཾཕན་ཚུན་དུ་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་གྱི་ཆུང་ངུའི་རྒྱུ་ནི་མ་ཡིན་ནོ།",
    "འདི་ལྟར་དད་པས་རྗེས་སུ་འབྲང་བ་དང་དད་པས་མོས་པ་དང་དུས་ཀྱི་རྣམ་པར་གྲོལ་བའི་ལམ་རྣམས་ནི་དྲུག་དང་བཞི་དང་གཉིས་དག་གི་ཡིན་ནོ།",
    "དད་པས་མོས་པ་དང་།",
    "དདྲ་པས་མོས་པའི་ལམ་ནི་དད་པས་མོས་པའི་ལམ་གཞན་དང་།",
    "དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བའི་ལམ་ནི་དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བའི་ལམ་གཞན་ཁེ་ནའི་ཡིན་པས་གཅིག་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཀྱིས་པའི་དད་པས་མོས་པའི་ལམ་ས་འོག་མ་པའི་དད་པས་མོས་པའི་ལམ་དང་མཉམ་པ་ཡིནཏེ།",
    "སྐལབ་མཉམ་པའི་རྒྱུ་ལྷག་པ་གཅིག་གིས་རྒྱས་པར་བྱས་པའི་ཕྱིར་རོ།",
    "མཐོང་བའི་ལམ་ནི་མཐོང་བའི་ལམ་པོ་ནའི་རྒྱ་གཅིག་གིས་རྒྱས་པར་བྱས་པ་ཡིན་ལ།",
    "སམ་གཏན་དང་པོའི་ས་པའི་དད་པས་རྗེས་སུའབྲང་བའི་ལམ་པས་ས་འོག་མ་པའི་དད་པས་མོས་པ་དང་དུས་ཀྱི་རྣམ་པར་གྲོལ་བའི་ལམ་དྭག་ལྟ་བུ་ཡིན་ནོ།",
    "ཁྱད་པར་ཅན་ནི་རྒྱུའི་རྣམ་པ་ལྷག་པ་རེ་རེས་རྒྱས་པར་བྱས་པ་ཡིན་ནོ།",
    "གཞན་ཡང་འཕགས་པའི་ལམ་ཁོ་ན་མཉམ་པ་དང་ཁྱད་པར་ཅན་དག་གི་སྐལ་བ་མཉམ།",
    "ཇིག་རྟེན་པ་དག་གི་སྦྱོར་བ་ལས་བྱུང་བ་དག་ཀྱང་མཉམ་པ་དང་ཁྱད་པར་ཅན་དེ་གཉིས་ཁོ་ནའི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་གྱི་དམན་པའི་ཉཱེ་མ་ཡིན་ནོ།",
    "དེ་ཡང་འདི་ར་ན་ཐོས་པ་དང་བསོམས་པ་དང་བསྒོམས་པ་ལས་བྱུང་བ་སྦྱོར་བ་ལས་བྱུང་བའི་ཡོན་ཏན་དེ་དག་ཀྱང་མཉམ་པ་དང་ཁྱོད་པར་ཅན་དག་འོ་ནུའི་རྒྱུ་ཡིན་གྱི་དམན་པ་རྣམས་ཀྱྀ་ནི་མ་ཡིན་ཏེ།",
    "པའི་ཁམས་ནི་མཉམོ་པར་གཞག་པ་མ་ཡིན་པའི་ཕྱིར་བསྒོམས་པ་ལས་བྱུང་བ་ནི་མེད་པའི་ཕྱིར།",
    "ཉོན་མོངས་པ་ཅན་རྣམས་ཀྱང་དེ་དང་འདྲ་སྟེ།",
    "དེ་བཞིན་དུ་སྤྲུལ་པའི་སེམས་བསམ་གཏན་བཞིའི་འཐས་བུའདོད་པ་ན་སྤྱོད་པ་ཡང་གྀ་རིམས་བཞིན་དུ་བཞི་དང་གསུམ་དང་གཉིས་དང་གཅིག་དག་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ཏེ།",
    "སྤྲུལ་པའི་སེམས་འདོད་པ་ན་སྤྱོད་པ་བསམ་གཏན་བཞི་པའི་འབྲས་བུ་ནི་སྤྲུལ་པའི་སེམས་འདོད་པ་ན་སྤྱོད་པ་བསོན་ཇ་གཏན་བཞི་པའི་འབྲས་བུ་གཞན་ཁོནའི་སྐོ་ལ་ང་མཉམ་པའི་རྒྱུ་ཡིན་པས་གཅིག་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "དཔེར་ན་སཱ་ལུ་དང་ནས་ལ་སོགས་པའི་སབོན་གཅིག་ལསའབྲས་བུ་གཅིག་གིམ་དུ་མ་འབྱུང་གི་དམན་པ་ནི་མ་ཡིན་པ་ལྟ་བུ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་ཟལ་བའི་ཐོབ་པ་དང་ལྷན་ཅིག་སྐྱེས་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟར་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ནི་སེམས་དང་སེམས་ལས་བྱུང་བ་དག་། ཁོན་ཡིན་ནོ་ཞེས་དེ་ཙམ་ཞིག་བརྗོད་པ་དེ་ལྟ་ན་ནི་དུས་ཐ་དྲད་པ་ལས་སྐྱེས་པ་རྣམས་ཀྱང་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་དང་།",
    "ཐངལས་སྐྱེས་པ་རྣམས་ཀྱང་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡོང་དུས་དང་རྒྱུད་ཐ་དོད་པ་ལས་སྐྱེས་པ་རྣམས་ཀྱང་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཉིད་དུ་ཐལ་བར་བ་བཟློག་པར་མི་ནུས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་ཟླ་བ་ཟླ་བ་ཚེས་པ་ལ་སོགས་པ་ལ་ལྟ་བའི་ལྟ་བུར་རྒྱུད་ཐ་དད་པ་ལས་སྐྱེས་ཤིང་དུས་ཐ་མི་དངཔ་རྣམས་ལ་ཡང་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "མཚན་ཉིད་ཀྱི་ཁྱད་པར་དེ་དག་གིས་ནི་དོན་གཞན་ལ་ཡང་ཐལ་ཞིང་འཁྲུལ་བར་འགྱུར་བ་དེ་ལྟ་བས་ན་རྟེན་མཚུངས་པ་ཅན་རྣམས་སོ་ཞེས་བྱ་བར་སྨོས་པ་ཡིན་ཏེ།",
    "འགྲོན་པ་རྣམས་ཕན་ཚུན་གྱི་སྟོབས་ཀྱིས་ལྷན་ཅིག་ལམོ་དུ་འགྲོ་བ་བཞིན་ནོ།",
    "རྟེན་དང་དྭམིགས་པ་དང་རྣམ་པ་དང་དུས་དང་རྫས་མཚུངས་པ་དྭག་གི་མཚུངས་པ་ལྔས་མཚུངསཔར་ལྡན་པའི་དོན་གྱིས་ན་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན་ཏེ།",
    "སྱེམས་དང་སེམས་ལས་བྱུང་བ་དེ་དག་མ་འོངས་པའི་དུས་ནས་ད་ལྟར་བའི་དུས་སུ་འོང་བ་ན་གཅིག་མེད་ན་ཡང་ཐམས་ཅད་མཚུངས་པར་མི་ལྡན་པས་ནའདི་ནི་དེ་དག་གི་རྒྱུའི་དངོས་པོ་ཡིན་ཏེ།",
    "ཀུན་འགྲོ་ཞེས་བྱ་ཉོན་མོངས་ཅན།",
    "ཉོན་མོངས་པ་ཅན་ཞེས་སྨོས་པ་ནི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་ཏེ།",
    "ན་མོངས་པ་ཅན་རྣམས་དང་ཉོན་མོངས་པ་ཅནམ་ཡིན་པ་རྣམས་ཀྱི་ཡང་ཡིན་ལ་འདི་ནི་ཉོན་མོངས་པ་ཅན་རྣམས་ཁེནའི་ཡིནནོ་ཞེས་བྱོ་བའི་ཕྱིར་རོ།",
    "གཞན་གྱི་ས་པ་ཡང་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུར་ཐལ་བར་འགྱུར་བས་རང་གི་ས་པའི་ཞེས་སྨོས་སོ།",
    "མ་འོངས་པ་དང་ད་ལྟར་ལྷན་ཅིག་སྐྱེས་པ་རྣམས་ཀྱང་ཀུན་ཏུ་། འགྲོ་བའི་རྒྱུར་ཐལ་བར་འགྱུར་བས་སྔར་སྐྱེས་པ་རྣམས་ཞེས་སྨྱོས་ཏེ།",
    "སྐལ་བ་མཉམ་པའི་རྒྱུ་བཞིན་དུ་རང་གི་རིས་ནི་མ་སྨོས་ཏེ།",
    "ཀུན་ཏུ་འགྲོ་བ་དེ་དག་གི་མཐུས་ནི་རིས་གཞན་པའི་ཉོན་མོངས་པ་འདོད་ཆགས་ལ་སོགས་པ་དག་ཀྱང་སྐྱེ་བའི་འགྱུར་རོ།",
    "ཉོན་མོངས་པའི་རིས་ཐམས་ཅད་དུ་འགྲོ་ཞིང་དྭམིགས་པའམ་ཉོན་མོངས་པའི་རིས་ཐམས་ཅད་ཀྱི་རྒྱུའི་དངོས་པོར་འགྱུར་བས་ན་ཀུན་ཏུ་འགྲོ་བ་དག་ཡིན་ནོ།",
    "འཕགས་པའི་གང་ཟག་རྣམས་ནི་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་སྤངས་པའི་ཕྱིར་ལ་སྤངས་པ་ཡང་རྒྱུའི་དངོས་པོར་མི་སྲིད་མོད།",
    "ཕྱིར་མི་འོང་བའི་སློབ་པ་རྣམས་འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པ་ཀུན་ཏུ་སྤྱོད་པ་སྲིད་དེ།",
    "། དྲག་ལས་གཞན་པ་སྡུག་བསྔལ་གྱི་བདེན་པ་ཉོན་མོངས་པ་ཅན་གང་ཡིན་པའོ་ཞེས་བྱ་བ་ནི་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་བ་ཞིན་དུ་འཕགས་པ་རྣམས་ཀྱི་ཡང་འཇིགཚོགས་ལ་ལྟ་བའི་རྒྱུ་ལས་བྱུང་བ་ཡིན་གྱི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རྒྱུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་གཟུང་བར་བྱ་བའི་ཁུངས་ཀྱི་རྣམ་གྲངས་གསུམ་པ་ཡིན་ཏེ།",
    "འཕགས་པའི་གང་ཟག་འདོད་པའི་འདོད་ཆགས་དང་བྲལ་བ་ལས་ཡོངས་སུ་ཉམས་པ་དེ་ལས་དང་པོར་ཉོན་མོངས་པ་ཅན་གྱི་སམས་པ་གང་ཡིན་པའོ་ཞེས་གསུངས་པ་འདྲི་ཇི་ལྟར་དྲང་།",
    "དེ་ལ་བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ།",
    "ཇི་ལྟར་ས་བོན་གྲུང་པོ་ཆུ་དག་གིསངོན་པར་མྲ་བརླན་པའི་སྐམ་པོ་དག་མྱུ་གུ་འགྲུབ་པར་མི་བྱེད་པ་དེ་བཞིན་དུ།",
    "དེ་ཡང་ཐོབ་པ་རྣམསདང་དེ་དག་གི་སྐྱེ་བ་ལ་སོགས་པ་རྣམས་ནི་འདུ་བྱེད་ཀྱི་ཕུང་པོས་བསྡུས་པའི་ཕྱིར་ན་ཕུང་པོ་གཅིག་པ་ཡིན་ནོ།",
    "ཐོབ་པ་དག་གིའོབྲས་བུ་གང་ཡིན་པ་དེཉིད་དེ་དགྲ་གི་སྐྱེ་བ་ལ་སོགས་པའི་ཡང་ཡིན་པས་འབྲས་བུ་གཅིག་པ་ཡིན་ནོ།",
    "ཐོབ་པ་དག་ནི་ཤིང་ལྗོན་པའི་ཕྱི་ཤུན་བཞིན་དུ་སམས་པ་ལ་སོགས་པ་ལས་ཐ་དད་པར་གནས་པས་དེ་དག་གི་རྒྱུ་དང་འབྲས་བུ་དག་ཀྱང་ལོགས་ཤིག་ཏུ་བརྗོད་པ་ཡིན་ནོ།",
    "ཅན་ནི་ལུས་དང་ངག་གི་ལས་དང་དེ་དག་གི་སྐྱེ་བ་ལ་སོགས་པའོ།",
    "དེ་དག་གི་སྐྱེ་བ་ལ་སོགས་པ་ནི་འདུ་བྱེད་ཀྱི་ཕུང་པར་བསྡུས་པའི་ཕྱིར་ན་ཕུང་པོ་གཉིས་པ་ཅན་ཡིན་ནོ།",
    "དེ་དག་གི་འབྲས་བུ་ཐ་མི་དད་པའི་ཕྱིར་འབས་བུ་གཅིག་པ་ཅན་ཡང་ཡིན་ནོ།",
    "མཉམ་པར་གཞག་པའི་སེམས་མེད་པས་རྗེས་སུ་འཇུག་པའི་གཟུགས་མི་སྲིད་པའི་གཟུགས་ཀྱི་ཕུང་པོས་བེསྡུས་པའི་ལུས་དང་ངག་གི་ལས་ནི་སེམས་དང་སམས་ལས་བྱུང་བ་དག་དང་འབྲས་བུ་གཅིག་པར་མི་འགྱུར་ཏེ།",
    "ཚོགས་པ་ཐ་དད་པའི་ཕྱིར་གཟུགས་ཀྱི་ཁམས་ནྲ་རྣམ་པའྀ་སྨིན་པའི་རྒྱུ་ཕུང་པོ་ཅིག་ལ་རྣམ་པར་སྨིན་པ་གཅིག་པ་ཅན་ནི་ཐོབ་པ་དང་དེ་དག་གི་སྐྱེ་བ་ལ་སོགས་པ་དང་བཅས་པ་སྟེ།",
    "ཐོབ་པ་དང་སྐྱེ་བལ་སོགས་པ་ནི་འདུ་བྱེད་ཀྱི་ཕུང་པོས་བསྡུས་པའི་ཕྱིར་པ་གཅིག་པཅན་ཡིན་ལ་འབྲས་བུ་ཐུན་མོང་བའི་ཕྱིར་འབྲས་བུགཅིག་པ་ཅན་ཡང་ཡིན་ནོ།",
    "འབྲས་བུ་ཐུན་མོང་བའི་ཕྱིར་འབྲས་བུ་གཅིག་པ་ཅན་ནོ།",
    "གང་གི་རྣམ་པར་སྨིན་པ་ཡིད་ཀྱི་སྐྱེ་མཆེད་ཡིན་པ་དེའི་རྣམ་པར་སྨིན་པ་ནི་ཡིད་དང་ཆོ་ད་གཉིས་ཏེ།",
    "གང་གི་རྣམ་པར་སྨིན་པ་རེག་བྱའི་མཆེད་ཡིན་པ་ཡང་དེ་དང་འདྲ་སྟེ།",
    "རེག་བྱའི་སྐྱེ་མཆེད་དེ་ལ་གདོན་མི་ཟ་བར་སྐྱོ་བ་ལ་སོགས་པ་ཡང་ཡོད་སྐྱེ་མཆེད་ཀྱང་རྣམ་པར་སྨིན་པར་འགྱུར་གྱི་རེག་བྱའི་སྐྱེ་མཆེད་འབའ་ཞིག་ནི་མ་ཡིན་པས་གང་གི་རྣམ་པར་སྨིན་པ་རེག་བྱའི་སྐྱེ་མཆེད་ཡིན་པ་ཡང་སྐྱེ་མཆེད་གཉིས་རྣམ་པར་སྨིན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "གང་གི་རྣམ་པར་སྨིན་པ་ལུས་ཀྱི་སྐྱེ་མཆེད་ཡིན་པ་དེའི་རྣམ་པར་སྨིན་པ་ནི་གསུམ་སྟེ།",
    "སྶཾགང་གི་རྣམ་པར་སྨིན་པ་གཟུགས་དང་དྲི་དང་རེའི་སྐྱེ་མཆེད་དག་ཡིན་པ་ཡང་དེ་དང་འདྲ་སྟེ།",
    "གང་གི་རྣམ་པར་སྨིན་པ་རྣ་བ་དང་སྣ་དང་ལྕེའི་སྐྱེ་མཆེད་དག་ཡིན་པ་ཡརྩབ་ལ་སོགས་པ་གང་ཡང་།་",
    "ཤིང་ནྱ་གྲོ་དྷ་ལ་སོགས་པ་དག་། གི་ས་བོན་ལྟ་བུའོ།",
    "ནས་དང་གྲོ་ལ་སོགས་པ་དྭག་གི་ས་བོན་ལྟ་བུའོ།",
    "ཀུན་འགྲོ་ཞེས་བྱ་ཉོན་མོངས་ཅན།",
    "འཕགས་པ་རྣམས་ཁྲོ་ནས་སོ་སོརང་གིས་རིག་པར་བྱ་བའོ།",
    "དེ་ཡང་སོ་སོར་བརྟགས་པའི་སྟོབས་ཀྱིས་ཉོན་མོངས་པ་འདོད་ཆགས་ལྭ་སོགས་པ་མ་འོངས་པ་མི་སྐྱེ་བ་དེ་ནི་ཕྲ་རྒྱས་འགོག་པ་ཞེས་བྱ་ལ།",
    "ང་ཡིན་པ་དེ་ཉིད་རང་གི་ངང་གིས་འགག་པའི་ཕྱིར་སོ་སོར་བརྟགས་པ་མ་ཡིན་པས་འགྲོག་པ་ཡིན་ནོ་ཞེས་རྟོག་པ་གང་ཡིན་པ་དེ་ལ་ནི།",
    "སོ་སར་བརྟགས་པསའགོག་པ་ཡང་སེ་སོར་བརྟགས་པ་སྔོན་དུ་འགྲོ་བ་ཡིན་པའི་ཕྱིར་ཉེས་པ་དར་ཐལ་ཏེ།",
    "ཉོན་མོངས་པ་དང་སྐྱོ་བ་མི་སྐྱེབ་དེ་ནི་སོ་སོར་བརྟགས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་དག་གི་མི་སྐྱེ་བ་གང་ཡིན་པ་དེ་ནི་སྔ་ནས་ཡོད་པ་འོ་ན་ཡིན་ནོ།",
    "མི་རྟག་པར་ཐལ་བའི་ཉེས་པ་ཅུང་ཟད་ཀྱང་མེད་པ་ཡིན་ནོ།",
    "ཀྱི་དགོངས་པ་ཡང་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་ང་བའི་སྡུག་བསྔལ་ལ་དམིགས་པའི་ཉོན་མོངས་པ་སྤངས་པོས་སྡུག་བསྔལ་སྤོང་བར་གསུངས་པ་ཡིན་ཏེ།",
    "གཟུགས་ལ་འདུན་པ་ང་འདོད་ཆགས་གང་ཡིན་པ་དེ་སྤོངས་ཤིགའདུན་པ་དང་འདོད་ཆགས་སྤུངས་ན་ཁྱེད་ཀྱིས་གཟུགོས་ད་ལྟ་བུདེ་ཡང་སྤངས་པ་དང་ཡོངས་སུ་ཤེས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་བ་ནས་རྒྱས་པར་རྣམ་པར་ཤེས་པའི་བར་དུ་གསུངས་ཏེ།",
    "འདས་པ་དང་མ་འོངས་པ་དངདང་ད་ལྟར་བྱུང་བའི་སྡུག་བསྔལ་ལ་དམིགས་པའི་ཉོན་མོངས་པ་སྤུངས་པས་སུམ་པོའི་ཉོན་མོངས་པ་ཡང་སྤངས་པར་རུང་ཀྱི་ཕྱི།",
    "ཡང་ན་འདས་པའི་ཉོན་མོངས་པ་ནི་ཚེརབས་སྔ་མ་པ་རྣམས་ཡིན་ལ།",
    "ད་ལྟར་བྱུང་བའི་ཉོན་མོངས་པ་རྣམས་ཡི་ན་ཏེ།",
    "ཚེ་རབས་སྔ་མ་པ་དྨང་ཚེ་འདི་པའི་ཉོན་མོངས་པ་གཉིས་པོ་འདིས་ཀྱང་ད་ལྟར་བྱུང་བའི་རྒྱུད་འདི་ལ་མ་འོངས་དུ་པར་བྱིད་པའི་ས་བོན་གྱི་པོབཞག་པ་དེ་སྤངས་པས་ཉོན་མོངས་པ་གཉིས་པོ་དེ་ཡང་སྤངས་པ་ཡིན་ཏེ།",
    "ཇི་སྲིད་དུ་དེས་བཞག་པོའི་ས་བོན་གནས་པ་དེ་སྲིད་དུ་ཉོན་མོངས་པ་འགགས་ཀྱང་སྤངས་པ་མ་ཡིན་ལ།",
    "དེས་བཞག་པའི་ས་བོན་གྱི་དངོས་པོ་དེ་སྤངས་པ་ཡིན་ན་ནི་ཉོན་མོངས་པ་དེ་ཡང་སྤངས་པ་ཡིན་པར་རྣམ་པར་གཞག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "མ་འོངས་པ་ནི་མི་སྐྱེ་བ་ཡིན་པས་མ་འོངས་པ་དེས་ས་ན་གྱི་དངོས་པོ་བཞག་པ་ནི་མེད་མོད།",
    "འོན་ཀྱང་མ་འོངས་པའི་སྡུག་བསྔལ་ལམཉོན་མོངས་པ་དེ་དག་སྤངས་པ་མེད་པར་ནི་མི་འགྱུར་ཏྱེ།",
    "དེ་ལྟར་དུས་གསུམ་གྱི་སྡུབསྔལ་ལ་དམིགས་པའི་ཉོན་མོངས་པ་སྤངས་པས་སྤོང་བ་མ་ཡིན་ན་ནི་འདས་པ་དང་ད་ལྟར་ལ་ཅི་ཞིག་སྤང་དུ་ཡོད་དེ།",
    "སོ་སོར་བརྟགས་པས་འགོག་པའི་འདུས་མ་བྱས་བྲས་བུ་ཡིན་པསྲ་ན་འདུས་མ་བྱས་དུ་གང་གི་འབྲས་བུ་ཡིན་པའི་རྒྱུ་གཞན་ཞིག་ཀྱང་ཡོད་པར་འགྱུར་ལ།",
    "འདུས་མ་བྱས་དག་བྱེད་རྒྱུ་ཡིན་པའི་ཕྱིར་ན་འདུས་མ་བྱས་ང་གི་རྒྱུ་ཡིན་པའི་འབྲས་བུ་གཞན་ཞིག་ཀྱང་ཡོད་པར་འགྱུར་རོ་ཞོ་ན།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དྲག་ལ་མིག་དང་གཟུགས་ཀྱི་སྐྱེ་མཆེད་ནས་ལུས་དང་རེག་བྱའི་ཕྱེ་མཆེད་བར་གྱི་བཅུ་ལྟ་བུ་ཡིན་ཏེ།",
    "མིག་དང་གཟུགས་རྣམས་ལ་བརྟེན་ཏེ་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ནས་ལུས་དང་རེག་བྱ་ལ་བརྟེན་ཏེ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ཡོད་པའི་ཕྱིར་རོ།",
    "རྣམས་ལ་ཡང་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ཡོད་དེ།",
    "ཀུན་ཏུ་འགྲོ་བའི་རྒྱུནི་ཉོན་མོངས་པ་ཅན་གྱི་རྒྱུ་ཉིད་སྐལ་བ་མཉམ་པའི་རྒྱུ་ལས་གས་ཤིག་ཏུ་རྣམ་པར་བཞག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཚིགས་སུ་བཅད་པ་ལས་སྐྱེས་བུ་པ་ཞེས་བྱུང་བ་ནི་སྐྱེས་འི་ལས་ལ་སྐྱེས་བུའི་མིང་གིས་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་གཉིས་ནི་མ་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པ་དང་སམས་ཅན་དུ་བརྗོད་པ་ཡང་ཡིན་མོད་ཀྱི།",
    "ཉོན་མོངས་པའི་རིས་ཐམས་ཅད་དུ་། འགྲེ་ཞིང་དམིགས་པའམ་ཉོན་མོངས་པའི་རིས་ཐམས་ཅུད་ཀྱི་རྒྱུའི་དངོས་པོར་འགྱུར་བས་ན་ཀུན་ཏུ་འགྲོ་བ་དག་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་གང་ཞིག་གོང་གིལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་པ་དེ་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་ཡང་ཡིན་པ་ཡོད་དུམ་ཞེ་ན་ཡོད་དེ།",
    "དེ་ནི་རང་གི་རིས་ཀྱི་ཉོན་མོངས་པ་ཅན་གྱི་སྐུལ་བ་མཉམོ་པའི་རྒྱུ་ཁོ་ན་ཡིན་གྱི།",
    "རིས་གཞན་གྱི་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་དེ་ཉིད་རིས་གཞན་གྱི་ཉོན་མོངས་པ་ཅན་གྱི་སྐལ་བ་མཉམོ་པའི་རྒྱུ་ཡིན་པ་ནི་མེད་པཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་གི་སྟོབས་། ཀྱིས་གང་སྐྱེས་པའི།",
    "གང་གི་སྟོབས་ཀྱིས་གང་སྐྱེས་པའི་འབྲས་བུ་དེ་ནི་སྐྱེས་བུ་བྱེད་པ་ལསསྐྱེས་པ་ཡིན་པས་སྐྱེས་བུ་བྱེད་པའི་འབྲས་བུ་ཞེས་བྱའོ།",
    "སྐལ་བ་མཉམ་པ་དོང་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་དག་གི་འབྲས་བུ་བར་དུ་ཆོད་པ་རྣམས་ལྟ་བུདང་།",
    "སོ་སོར་བརྟགས་པས་འགོག་པ་ཡང་སྐྱེས་བུ་བྱེད་པའི་འབྲས་བུ་ཡི་ན་མོད།",
    "གང་གི་སྟོབས་ཀྱིས་གང་ཐོབ་པ།",
    "ཞེས་སྦྱར་ཞིང་སོ་སོར་བརྟགས་པས་འགོག་པ་ནི་གང་གི་སྟོབས་ཀྱིས་ཐོབ་པ་ཞེས་བརྗོད་པར་བྱའོ།",
    "རྒྱུ་དོན་མད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདག་པོའི་འབྲས་བུ་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་རྒྱུ་དག་གི་འབྲས་བུ་ཡང་ཡིན་ནོ།",
    "ད་ལྟར་གྱི་དུས་དང་འདས་པ་དགོོ་གིས་འབྲས་བུ་འབྱིན་པར་བྱེད་པ་ནི་སྐལ་བ་མཉམ་པ་དང་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་དག་གོ།",
    "བྱེད་པ་ནི་ཡིན་ཀྱང་འབྲས་བུ་འབྱིན་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཐོབ་པ་དང་ལྡན་པས་ཐམས་ཅད་ཀྱི་ཐ་མར་འདོར་བ་ལ་ཕྱོགས་པའི་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པའི་སྐལ་བ་མཉམ་པའི་རྒྱུའི་ཐོབ་པ་གང་དག་ཡིན་པ་སྟེ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་སྐད་ཅིག་མ་གཞན་མེད་པའི་ཕྱིར་འབྲས་བུ་འབྱིན་པར་བྱེད་པན་མ་ཡིན་ནོ།",
    "སྲིད་པའི་རྩེ་མོ་ལས་འདོད་ཆགས་དང་བྲལ་བའི་གནས་སྐབས་ལྷག་མ་དག་ཏུ་ཡིན་ནོ།",
    "དག་ལ་སོགས་པ་བྱེ་བྲག་གི་སྤུརིས་ཐ་དད་པ་རྣམས་ནི་གྲུབ་པའི་མཐའ་ལས་ཁོང་དུ་ཆུད་པར་བགྱིའོ།",
    "མིག་ལ་སོགས་པ་དྭག་གི་འབྲས་བུ་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དག་ལྟ་བུནི་ཚེགས་པའི་འབྲས་བུ་དང་།",
    "དེ་ལྟར་འབྲས་བུ་རྣམ་པ་བཞིར་འཆད་པ་རྣམས་ཀྱང་སྐྱེས་བུ་བྱེད་པ་དང་བདག་བོའི་༧འབྲས་བུ་དག་གི་ཁོངས་སུ་འདུ་སྟེ།",
    "ཉོན་མོངས་ཅན་དང་རྣམ་སྨིན་སྐྱེས།",
    "དེ་དག་གི་ལྷག་མརྣམས་སོ།",
    "ཉོནོམོངས་པ་ཅན་གྱི་ངོ་བོ་ཉིད་མ་ཡིན་པའི་ཕྱིར་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་ལས་སྐྱེ་བ་ཡང་མེད་དོ།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཕྱིར་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་ཡང་མེད་དོ།",
    "རང་ལྡོག་གི་རྣམ་གྲངས་བསྟན་པ།",
    "འདི་ལྟར་འདོད་པ་ན་སྤྱོད་པའི་གཟུགས་ཀྱི་མཇུག་ཐོགས་སུ་རེས་འགའ་ནི་འདོད་པ་ན་སྤྱོད་པའི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་འབྱུང་སྟེ།",
    "འདོད་པ་ན་སྤྱོད་པའི་གཟུགས་ཀྱི་མཇུག་ཐོགས་སུ་རེས་འགའ་ནི་གཟུགས་ན་སྤྱོད་པའི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་འབྱུང་སྟེ།",
    "གང་གི་ཚེ་ཟག་པ་དང་བཅས་པའི་བསམ་གཏན་མངོན་དུ་གྱུར་པ་ནའོ།",
    "འདོད་པ་ན་སྤྱོད་པའི་གཟུགས་ཀྱི་མཇུག་ཐོགས་སུ་རེས་འགའ་ནི་ཟག་པ་མེད་པའི་སྡོམ་པ་དྲག་གི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་འབྱུང་སྟེ།",
    "གང་གི་ཚེ་ཟག་པ་མེད་པའི་བསམ་གཏན་མངོན་དུ་གྱུར་པ་ནའོ།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ནི་དེ་ལྟར་འཆོལ་བ་མ་ཡིན་ཏེ་ འདོད་པ་ན་སྤྱོད་པའི་སམས་དང་སེམས་ལས་བྱུང་བ་དག་གི་མཇུག་ཐོགས་སུ་འདོད་པ་ན་སྤྱོད་པ་དང་གཟུགས་ན་སྤྱོད་པ་དང་ཟག་པ་མེད་པའི་སམས་དང་སཱམས་ལས་བྱུང་བ་དག་ཅིག་ཅར་ནི་ནམ་ཡང་མི་འབྱུང་ངོ།",
    "དེ་བཞིན་དུ་གང་གི་ཚེ་ཟས་ཟོས་ནས་ཉལ་བའམ་བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་དེའི་ཚེ་རྣམ་པར་སྨིན་པ་ལས་།",
    "པའི་ཉོན་མོངས་པ་དང་ལྡན་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཡིད་ནི་རྟེན་གྱི་དྭངོས་པོས་རབ་ཏུ་ཕྱེ་བ་ཡིན་གྱི་སྐྱེད་པར་བྱེད་པས་རབ་ཏུ་ཕྱེ་བ་ད་པ་ཉིད་ཡིན་ཡང་རྒྱུ་གཞན་མ་ཚང་བས་རྣམ་པར་ཤས་པ་གཞན་མི་སྐྱེ་བ་ཁོ་ནར་ཟད་དོ། ། དཔེར་ན་མིག་དེ་ཉིད་མིག་གི་རྣམ་པར་ཤེས་པའི་རྟེན་གྱི་དངོས་པོར་གནས་པ་ལགཞན་མ་ཚང་བས་མིག་གི་རྣམ་པར་ཤེས་པ་མི་སྐྱེ་ཡང་དེ་ལ་མིག་གིས་མ་ལན་པ་དེ་བཞིན་དུ།",
    "རྒྱ་གཞན་མ་ཚང་བ་ནི་དགྲ་བཅོམ་པ་ལ་ཡང་སྲིད་པའི་ལས་དང་ཉོན་མོངས་པ་མེད་པའོ།",
    "འདི་པའི་ལྟར་མིག་གི་རྣམ་པར་ཤེས་པ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པའི་དམིགས་པ་ནི་གཟུགས་སོ།",
    "དམིགས་པ་ས་ཀྱི་རྣམ་པར་ཤེས་པ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པའི་དམིགས་པ་ནི་རེག་བྱའོ།",
    "དཔེར་ན་མིག་གི་རྣམ་པར་ཤེས་པ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་ནི་རང་གི་དམིགས་པ་གཟུགས་ཀྱི་སྐྱེ་མཆེད་ལ་ངེས་ཀྱི་སྒྲའི་སྐྱེ་མཆེད་ལ་སོགས་པ་ལ་ནི་ཡིན་སྟེ།",
    "གཟུགས་ཀྱི་སྐྱེ་མཆེད་དེ་ཡང་སྔོན་པོ་ཡིན་ན་མིག་གི་རྣམ་པར་ཤེས་པ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་སྔོན་པོ་འཛིན་ང་བྱེད་པ་ཉིད་དུ་ངས་ཀྱི་སེར་པོ་ལ་སོགས་པ་གཞན་ལ་ནི་མ་ཡིན་ཏེ།",
    "གཟུགས་སྔོན་པོ་དེ་ཡང་སྐད་ཅིག་མ་གང་ཞིག་གང་གི་དམིགས་པ་ཡིན་པ་དེ་ཁོ་ན་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེ་ས་པ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་སྐྱེས་པ་རྣམས་ནི་རྟེན་ད་ལྷན་ཅིག་པ་དག་ཡིན་ནོ།",
    "གཞན་དག་ན་རེ་འོདས་པ་རྣམས་ཀྱང་རྟེན་དང་ལྷན་ཅིག་པ་དག་ཡིན་ཏེ།",
    "རྐྱེན་གྱི་མཚན་ཉིད་མི་སྲིད་པའི་ཕྱིར་རང་གི་ངོ་བོའི་རྐྱེན་རང་གི་ངོ་བོ་མ་ཡིན་པ་ལྟ་བུ་དང་།",
    "འདུས་མ་བྱས་ཀྱི་རྐྱེན་འདུས་མ་བྱུས་མ་ཡིན་པ་ལྟ་བུའོ་། གཉིས་པ་རྐྱེན་གང་གིས་བྱ་བ་བྱེད་པའི་ངེས་པ་ལ།",
    "དུས་གང་གི་འབྲས་བུ་ལ་བྱ་བ་བྱེད་པ་དང་།",
    "རྒྱུའི་རྐྱེན་དེ་ལས་གཞན་པ་ཡི་རྐྱེན་དྲག་ནི་རྒྱུའི་རྐྱེན་དག་གི་བྱེད་འི་དུས་ངེས་པ་བསྟན་པ་དེ་ལས་བཟློག་སྟེ་བྱ་བ་བྱེད་པ་ཡིན་ནོ།",
    "རྒྱུའི་བྱེ་བྲག་དེ་དག་ཀྱང་རིམ་གྱིས་སྐྱེ་བ་ལ་རྒྱུ་གཞན་གྱི་བྱེ་བྲག་ལ་ལྟོས་པས་ཐུག་པ་མེད་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
