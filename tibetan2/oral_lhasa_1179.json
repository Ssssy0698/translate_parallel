    "གནས་པར་མཛད་དོ་ཞེས་མ་བརྗོད་པ་ནི་དེ་ཁོ་ན་ཉིད་དུ་ན་བཅོམ་ལྡན་འདས་གང་དུ་ཡང་མི་གནས་པའི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་དེ་དེར་བཞུགས་ཏེ་དེའི་བདག་ཉིད་དུ་གྱུར་ནས་རོ་གཅིག་པའི་རང་བཞིན་གྱིས་ཏེ།",
    "གང་ཡང་འདིར་ཨེ་ཝཾ་གྱི་ཡི་གེ་ལ་སོགས་པའི་དོན་གཞན་ཡང་འདིར་དང་རྒྱུད་གཞན་རྣམས་སུ་གསུངས་པ་ནི་བསྟན་པ་གཞན་ཁོ་ན་ཡིན་ཅིང་གདུལ་བའི་སྐྱེ་བོ་རྣམས་ཀྱིས་གཟུངས་ཐོབ་པའི་དོན་དུ་སྟེ།",
    "དེ་བཞིན་དུ་དེ་རྣམས་དོན་ཆེན་པོ་ཉིད་ཀྱིས་མཆོག་ཏུ་བཀྲ་ཤིས་པ་ཉིད་ཀྱིས་ན་རྒྱུད་ཀྱི་དང་པོར་ཉེ་བར་བསྟན་ཏོ་ཞེས་ཀྱང་གསལ་བར་བྱས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དུས་དང་ཡུལ་དང་སྟོན་པ་པོ་ཕུན་སུམ་ཚོགས་པ་གསུངས་སོ།",
    "འཁོར་ཕུན་སུམ་ཚོགས་པ་གསུངས་པ།",
    "རྣམ་འབྱོར་ནི་ཐབས་དང་ཤེས་རབ་སྙོམས་པར་འཇུག་པའོ།",
    "བཅོམ་ལྡན་འདས་གཞན་གྱི་སེམས་མཁྱེན་པ་ཉིད་ཀྱིས་ཡང་དག་པར་སྦྱོར་བ་ཉན་པའི་སྐལ་བ་དང་ལྡན་པར་འཁོར་རྣམས་རྟོགས་ཤིང་།",
    "མཛད་མ་ཐག་ཏུ་ནི་བར་མ་ཆད་པར་རོ།",
    "གསོལ་བ་འདེབས་པ་གསུངས་པ།",
    "ཨེ་མ་ཞེས་ངོ་མཚར་བར་བྱས་ནས་བོད་པའོ།",
    "དེ་རྣམས་ལ་ཡོད་པ་འི་གསང་ཆེན་ཡང་འདིར་དོགས་པ་མེད་པ་ཉིད་དུ་བརྗོད་པར་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "རབ་ཏུ་དགའ་བ་ཁོ་ན་ལས་དྲེགས་པ་མེད་པ་ཉིད་དུ་བསྒྲུབ་པའི་ཆེད་དུ་ཡང་ཡང་དུ་ཕྱག་བྱས་པའོ།",
    "ཅི་ཞེས་པ་ནི་བརྗོད་པར་བྱ་བའོ།",
    "དེ་ལ་སྟེ་ཡང་དག་པར་སྦྱོར་བ་ལས་བྱུང་བ་ལས་༡སྒྲུབ་པར་བྱེད་པའི་མཚན་ཉིད་དུ་འགྱུར་བ་ཅི་ལྟར་དང་ཅི་ཞིག་པའོ།",
    "དེ་སྐད་དུ་ཡང་འདུས་པ་ཕྱི་མར་གསུངས་པ།",
    "སོལ་བ་བཞིན་དུ་བཀྲུས་ཀྱང་དྲི་མ་མེད་པར་མི་འགྱུར་ར་རོ།",
    "དེ་འཕགས་པ་བྱམས་པས་གསུངས་པ།",
    "རྒྱུ་དེ་ལས་ལོ་བུར་བའི་དྲི་མ་དང་བྲལ་བ་ལས་གང་དྲི་མ་ད་ང་བྲལ་བ་ཉིད་ཐོབ་པའི་མཚན་ཉིད་ཅན་གྱི་འབྲས་བུ་འབྲས་བུའི་རྡོ་རྗེ་འཛིན་པ་དེ་ནི་མི་འཕྲོགས་༡པ་ར་བརྗོད་པར་བྱ་སྟེ།་",
    "འཕྲོགས་པ་ནི་ཡང་དག་པར་འཕྲོགས་པ་སྟེ་འགྲིབ་པའམ་སྡུད་པའོ།་།",
    "དྲི་མ་མེད་པ་ཉིད་ཐོབ་པའི་ཐབས་ཏེ་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་བསྐྱེད་པ་དང་རྫོགས་པའི་རིམ་པའི་ངོ་བོ་ནི་གཞི་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "ཕྱག་རྒྱའི་རྣལ་འབྱོར་ལས་འཆད་པར་འགྱུར་བའི་རྗེས་སུ་བསྒྲུབ་པ་སྟེ།",
    "དེ་ལྟར་རྒྱུའི་རྒྱུད་དང་འབྲས་བུའི་རྒྱུད་ད་ང་ཐབས་ཀྱི་རྒྱུད་ཅེས་པ་རྒྱུད་གསུམ་རྣམས་ཀྱིས་རྒྱུད་ཀྱི་དོན་ཁྱད་པར་དུ་རྟོགས་པར་བྱ་བ་བསྡུས་སོ།",
    "འདུས་པ་ལ་སོགས་པ་རྣམས་ཞེས་པ་ལ་འདུས་པ་ནི་བརྗོད་པར་བྱ་བའི་དོན་ཏེ།",
    "གསང་བ་ཞེས་པར་བརྗོད་པར་བྱ།",
    "འདུས་པ་ཚོགས་པར་རབ་བརྗོད་དེ།",
    "བཛྲའང་ཤེས་ར་བ་བརྗོད་པར་བྱ།་།",
    "དེ་ཡང་སྟོང་པ་ཉིད་དང་རོ་གཅིག་པའི་ཕྱིར་སྟོང་པ་ཉིད་བཞིན་ཁོ་ནར་རྡོ་རྗེར་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་ཁོ་ན་འབྲས་བུའི་བདག་ཉིད་ནི་འདུས་པ་དང་བདེ་མཆོག་དང་ཀྱེའི་རྡོ་རྗེ་ལ་སོགས་པའི་རང་བཞིན་ཉིད་ཀྱིས་ཐམས་ཅད་དུ་བརྗོད་པར་བྱ་བ་སྟེ།",
    "དེ་རྣམས་ཀྱི་གླེང་གཞི་ནི་ཐོག་མའི་རྒྱུ་ཡང་དག་པར་སྦྱོར་བ་རྒྱུའི་རྒྱུད་ད་དེ།་",
    "དེ་སྐད་དུ་ཡང་འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་གསུངས་པ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ནི་མངོན་སུམ་གྱི་མཚན་ཉིད་ཅན་ཏེ།",
    "འདི་གླེང་གཞིའི་སྒྲའི་ཤུགས་ཀྱིས་རྟོགས་པར་བྱ་བའི་དོན་ཏེ།",
    "ཅིག་ཤཾོས་ལྟར་ན་གནོད་པར་བྱས་པ་ཉིད་ཀྱིས་ན་ཡང་དག་པ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་དང་སྒྲུབ་པར་བྱེད་པ་མེད་པས་ན་མ་ངེས་པ་ཉིད་ཀྱི་ཕྱིར་ཅི་ལྟར་གླེང་གཞི་ཉིད་ཡིན།",
    "ཡང་ད་ག་པར་སྦྱོར་བ་འཆད་པ་ནི་ཤེས་རབ་དང་ཐབས་ཀྱི་བདག་ཉིད་ཅེས་པ་སྟེ།",
    "དེ་ཁོ་ནའི་ཕྱིར་གསུངས་པ།",
    "ཡང་དག་པར་སྦྱོར་བའི་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཡོན་ཏན་རྣམས་འདིས་ཡང་དག་པར་ཀུན་ནས་འཛིན་པར་བྱེད།",
    "ཡོངས་སུ་རྒྱས་པར་བྱེད་ཅེས་པས་ཏིང་ངེ་འཛིན་ཏེ་རྣམ་པར་མི་རྟོག་པའོ།",
    "སེམས་མཉམ་པར་གཞག་པ་ནི་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ཤེས་པར་བྱེད་ཅིང་།",
    "པར་བྱེད་པ་ཁོ་ན་ལས་མཚོན་པར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གསུངས་པཞེས་པའི་དོན་ཏོ་ཞེས་པ་སྟེ།",
    "བརྟན་པ་ལ་སོགས་པ་རྣམས་ནི་བྱིས་པ་རྣམས་ཀྱིས་ཀྱང་རྟོགས་པར་བྱ་བ་ཉིད་ན་ཡང་དེའི་རང་བཞིན་འདི་རྟོགས་བྱ་མ་ཡིན་པ་ཉིད་ནི་དེ་ཁོ་ན་ཉིད་ཀྱི་ཆ་ལ་མ་གོམས་པ་ལས་སོ་ཞེས་གསུངས་པ།",
    "དེ་ལྟར་རྒྱུ་ལས་འབྲས་བུ་འབྱུང་ངོ་ཞེས་འབྲས་བུའི་རྒྱུད་གསུངས་པ་ཡང་ན་ཐམས་ཅད་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "ཞེས་མཁའ་འགྲོ་མ་རྡོ་རྗེ་གུར་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "དེའི་ཡང་སྔགས་ལ་སོགས་པ་རྣམས་ཐབས་ཉིད་དུ་དོན་གྱི་ཤུགས་ཀྱིས་ཐོབ་པ་ཉིད་ཀྱི་ཕྱིར་འདིར་བྱུང་བའི་སྒྲས་གསུངས་སོ།",
    "དེ་ཡང་ཡིན་ལ་མཚན་ཉིད་ཀྱང་ངོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་ལྟར་གྱུར་ན་རྒྱུད་ཐམས་ཅད་ཀྱི་གླེང་གཞི་ཡང་དག་པར་སྦྱོར་བ་ཡང་ཡིན་ལ།",
    "ཐམས་ཅད་ཅེས་པ་ལ་སོགས་པའི་ངག་ལན་གཉིས་བཟླས་པས་གསུངས་ཏེ།",
    "དེ་ཁོ་ན་རྒྱུད་དོ་ཞེས་པས་གཙོ་བོར་བླ་ན་མེད་པའི་ཐབས་ཀྱི་ཆ་གསལ་བར་བྱེད་པའི་ཕྱིར་རྒྱུད་ཀྱི་དོན་ནི་ཕུལ་དུ་བྱུང་བ་དང་བཅས་པར་གསུངས་ཏེ།",
    "ཡེ་ཤེས་ཀྱི་སྐུ་ནི་རྣལ་འབྱོར་གྱི་རྒྱུད་ཀྱི་ཁྱད་པར་དང་ང་ངོ།",
    "དགོངས་པ་འདི་ཁོ་ན་མན་ངག་ལས་བྱུང་བའི་སྒྲ་ཡིས་རྟོགས་ཀྱང་སླར་ཡང་འདིར་རྟོགས་པར་བྱས་པ་ནི།",
    "ཅི་ལྟར་ཡང་ཡིད་ཆེས་པར་དཀའ་བའི་འཇིག་རྟེན་ཡིད་ཆེས་པར་འགྱུར་ཞེས་པའོ།",
