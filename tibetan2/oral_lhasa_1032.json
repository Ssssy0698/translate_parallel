    "སི་དང་ཁད་པར་ག་཈ིས་ཐེ་ཚོམ་ཅན་ཡིན་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "མཐུན་ཕྱོགས་མི་མཐུན་ཕྱོགས་གང་རུང་གཅིག་ལ་ངེས་པར་ཞུགས་པ་དང་།",
    "རག་པ་དང་མི་རག་པ་ག་཈ིས་ནི་ཕན་ཚུན་སྤངས་པའི་དངོས་འགལ་ཡིན་མིན་ནི་དཔད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་མིན་པ་རྣམ་པར་བཅད་པའི་སོ་ནས་བསྒྲུབ་བྱ་གོ་བྱེད་ཡིན་པ་དང་།",
    "གལ་ཏེ་གཞལ་བྱ་གཞན་ངོར་རག་པ་དང་དེ་མིན་ག་཈ིས་ཀ་ལ་ཁབ་བྱེད་དུ་འཇུག་ཞེས་པས་སྒྲ་རག་པའམ་རག་པ་མ་ཡིན་པ་སྒྲུབ་པ་ལ་ཐེ་ཚོམ་ཅན་ཡིན་ན་སྒྲ་མི་རག་པར་སྒྲུབ་པ་ལ་བྱས་པ་བཀོད་པ་ཡང་སྒྲ་མི་རག་པར་སྒྲུབ་པ་ལ་ཐེ་ཚོམ་ཅན་དུ་འགྱུར་ཏེ།",
    "དུང་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ལ་ཆ་ག་཈ིས་སུ་གྲུབ་པ་དེ་གཞན་ཏེ་རོལ་བྱུང་ལྟ་བུ་ཡང་བུམ་པ་དང་བུམ་ཡིན་ག་཈ིས་ལ་ཞུགས་ཀང་རུང་།",
    "གཅིག་བྱས་པ་དེ་ཡང་དེ་སྒྲུབ་ཀི་མཐུན་ཕྱོགས་ལ་ཁབ་བྱེད་དུ་འཇུག་ཀང་མི་རག་པ་སྤངས་པའི་རོལ་བྱུང་མིན་པ་ལ་འཇུག་པ་མི་སིད་པའི་ཕྱིར་རོ།",
    "བྱས་པ་ལྟ་བུ་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལས་ལྡོག་པའི་སོ་ནས་དེ་སྒྲུབ་ཀི་མཐུན་ཕྱོགས་ལ་ཇི་ལྟར་ཞུགས་པ་བཞིན་གྲུབ་པ་ན་སྒྲ་ལ་རག་པ་རྣམ་པར་བཅད་པའི་སོ་ནས་དེ་སྒྲུབ་ཀི་རགས་ཡང་དག་ཏུ་འགྱུར་བའི་ཕྱིར།",
    "གཟུགས་ཀི་རགས་ལས་དཀར་པོ་གཅིག་པུ་རོགས་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དཔད་ན་ཤིན་ཏུ་འཇིག་པར་སྣང་བའི་ཕྱིར་རོ།",
    "མེས་ཁབ་པར་ནོན་པའི་ཕྱིར་ཞེས་པའི་རགས་འདི་ཁོད་ཀིས་ཡང་དག་ཏུ་ཁས་བངས་པས།",
    "མེས་ཁབ་པར་ནོན་པའི་ཕྱིར་ཞེས་པ་འགལ་རགས་སུ་འགྱུར་ན།",
    "གལ་ཏེ་བྱས་པ་རོལ་བ་ལས་བྱུང་བ་དང་མ་བྱུང་བ་ག་཈ིས་པོ་གང་དུ་ཞུགས་པ་བསྒྲུབ་བྱར་བཟུང་ན་ནི་རགས་གང་དུ་འགྱུར་ཞེ་ན།",
    "ཁོད་དེ་རོལ་བྱུང་དུ་སྒྲུབ་པའམ་རོལ་བྱུང་མིན་པར་སྒྲུབ་པ་གང་ཡིན་ཀང་རུང་དེ་ཡི་བྱེ་བྲག་ལ་ཐེ་ཚོམ་ཟ་བའི་སོ་ནས་རོངས་པའོ་ཞེས་པ་སེ་བྱེ་བྲག་གྲུབ་ཀང་དེ་སྒྲུབ་ཀི་མ་ངེས་པའི་གཏན་ཚིགས་ཡིན་པའི་ཕྱིར།",
    "གལ་ཏེ་དེ་ལྟར་ཡིན་ན་བྱས་པའི་ཕྱིར་མི་རག་གོ།",
    "བྱས་པ་སྒྲ་རོལ་བྱུང་དུ་སྒྲུབ་པ་དང་རོལ་བྱུང་མ་ཡིན་ཀུན་བཏུས་རབ་བྱེད་རྒྱན།",
    "བྱས་པས་སྒྲ་མི་རག་པ་དང་སྒྲ་བདག་མེད་གང་སྒྲུབ་པ་ལའང་གཏན་ཚིགས་ཡང་དག་ཡིན་པའི་ཕྱིར་རོ།",
    "བྱས་པས་སྒྲ་བདག་མེད་དང་མི་རག་པ་གང་སྒྲུབ་པ་ལ་ཐེ་ཚོམ་ཅན་དུ་འགྱུར་བ་མི་སིདདེ།",
    "དེ་མི་རག་པ་དང་བྲལ་བའི་བདག་མེད་པ་ལ་བྱས་པ་ཡོད་པར་འགྱུར་ན་དེ་ལྟ་བུ་཈ིད་དུ་འགྱུར་ཡང་དེ་ལ་མེད་པའི་ཕྱིར་ཞེས་གསུངས་སོ།",
    "དེ་ནི་རང་ལའང་མཚུངས་པར་མཐོང་སེ།",
    "རོལ་བྱུང་མ་ཡིན་པ་དང་བྲལ་བའི་རོལ་བྱུང་ལ་བྱས་པ་ཡོད་པར་འགྱུར་ན་དེ་ལྟ་བུ་཈ིད་དུ་འགྱུར་ཡང་དེ་ལ་མེད་པའི་ཕྱིར་ཞེས་པ་མཚུངས་པར་འགྱུར་རོ།",
    "མི་རག་པ་མེད་པའི་བདག་མེད་ལ་བྱས་པ་ཡོད་པ་མི་སིད་པའི་ཕྱིར་ཞེ་ན།",
    "རོལ་བྱུང་མ་ཡིན་པ་མེད་པའི་རོལ་བྱུང་ལ་བྱས་པ་ཡོད་པ་མི་སིད་པའི་ཕྱིར་ཞེས་བརོད་ན་མཚུངས་སོ།",
    "སྒྲ་དང་རག་པའི་ཚོགས་དོན་དང་མཐུན་པ་མེད་པ་མི་མཐུན་ཕྱོགས་མི་རག་པ་ལ་སྒྲུབ་ཚུལ་དང་མཐུན་པར་མེད་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར།",
    "དེའི་མི་མཐུན་ཕྱོགས་བུམ་པ་ལ་སྒྲུབ་ཚུལ་དང་མཐུན་པར་མེད་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར།",
    "བསྒྲུབ་བྱ་མེད་པ་཈ིད་ལ་སེ་དེ་སྒྲུབ་ཀི་ཚུལ་དང་མཐུན་པར་མི་མཐུན་པའི་ཕྱོགས་ཁོ་ན་ལ་མེད་པའོ་ཞེས་ངེས་བཟུང་སྦྱོར་བའི་ཕྱིར་཈ེས་པ་མེད་ཅེ་ན།",
    "དེ་སྒྲུབ་ཀི་སྒྲུབ་ཚུལ་དང་མཐུན་པར་དེ་སྒྲུབ་ཀི་མི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་མེད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "དེ་སྒྲུབ་ཀི་སྒྲུབ་ཚུལ་དང་མཐུན་པར་དེ་སྒྲུབ་ཀི་མཐུན་ཕྱོགས་གློག་ལའང་མེད་པའི་ཕྱིར།",
    "སྒྲ་མི་རག་པར་བསྒྲུབ་པའི་རགས་ཡང་དག་མ་ཡིན་པར་ཀུན་བཏུས་རབ་བྱེད་རྒྱན།",
    "སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་ཁས་ལེན་ནུས་ན་མི་རག་པའི་ལྡོག་པ་ཁོ་ན་ལ་ཡོད་པའང་ཁས་ལེན་ནུས་པའི་ཕྱིར་རོ།",
    "སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པ་གྲུབ་པའི་ཕྱིར།",
    "འོ་ན་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པ་དེའི་མཚན་གཞི་གང་ཡིན་སྨྲོས་ཤིག་བྱས་པ་དེ་ཡིན་ཞེ་ན།",
    "འོ་ན་གཞལ་བྱ་ཡང་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་མ་ཡིན་པ་ལ་མེད་པར་དམ་བཅས་ན་཈ེས་པ་ཅི་ཡོད།",
    "མི་རག་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདོད་ན་མེད་དགག་ཏུ་འགྱུར་རོ་ཞེས་བརོད་ན་མི་མཚུངས་སམ་ལེགས་པར་སོམས་ཤིག་གཞན་ཡང་བྱས་པ་ནཱ་ལནྡྲའི་མཁན་རབས་གསུམ་པ་དགྱེ་བ་རྒྱལ་མཚན།",
    "སྒྲ་མི་རག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་མ་ཡིན་པ་ལ་མེད་ན་མི་རག་པ་དེ་མི་རག་པ་མ་ཡིན་པ་ལ་ཡོད་པར་ཚངས་པ་དང་བརྒྱ་བྱིན་མ་གཏོགས་རིགས་པ་སྨྲ་བ་སུས་ཀང་མ་གྲུབ་སེ།",
    "བསྒྲུབ་བྱ་རིགས་མི་མཐུན་འདི་ལ་བསྒྲུབ་ཚུལ་དང་མཐུན་པར་མེད་དོ་ཞེས་བརོད་དགོས་པར་ཁས་བངས་པ་ལས་དེ་ལྟར་མ་བརོད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་འཐད་ན་ཤེས་པར་བྱེད་ལས་འདས་པ་བཞིན་ཏེ།",
    "དེ་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་གཏན་ཚིགས་མིན་ནོ་ཞེས་བརོད་ན།",
