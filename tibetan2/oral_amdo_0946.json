    "ལྷ་མི་དེ་དག་གིས་ཀྱང་ནི་སྲུང་བར་འགྱུར་བ་དང་གཉིས།",
    "རང་ངོས་ནས་བསམ་པ་རྣམ་དག་གིས་ཕར་བགད་མོ་ཞིག་བགད་ནའང་གཤིས་ཀ་ངན་པ་ཅན་འགའ་ཞིག་གིས་ཚུར་མིག་ལོག་བལྟ་བ་དེ་འདྲ་ཡོང་སྲིད་པ་ལས་མང་པོ་མེད།",
    "རང་གིས་གཞན་ལ་འཁོན་འཛིན་བརྣབ་སེམས་གནོད་སེམས་མ་བཅང་ན་རང་ཡང་དུས་རྟག་ཏུ་བག་ཕེབས་པོ་ཞིག་དང་སྣང་བ་སྐྱིད་པོ་ཞིག་ཡོང་བ་ཡིན།",
    "རང་མི་སྐྱིད་པའི་ཞར་ལ་གཞན་ཡང་མི་སྐྱིད་པའི་གནས་ཚུལ་དེ་འདྲ་ཡོང་གི་འདུག།",
    "འབད་པ་ཆེར་མི་དགོས་པར་རང་གི་འདོད་པའི་དོན་བདེ་བླག་ཏུ་འཐོབ་པ་དང་།",
    "བྱམས་པ་ཡོད་ན་ལྷ་མི་བྱམས་ཤིང་ངང་གིས་འདུ་བ་དང་།",
    "ངན་སོང་སྡུག་བསྔལ་གཤིན་རྗེའི་སྡུག་བསྔལ་དང་།",
    "དེ་གོམས་བ་ན་བདེ་བ་དང་འཕྲད་འདོད་ངང་གིས་འབྱུང་ལ།",
    "བསམ་བློ་བཏང་ན་གང་ཡིན་ཀྱང་ཕོངས་པའི་སྡུག་བསྔལ་ཛ་དྲག་གིས་གང་དང་གང་ཡོད་པ་དེ་དང་དེ་བདེ་བ་དང་ལྡན་ན་བསམ་པ་ལྟ་བུའི་སྒོ་ནས་བྱམས་པ་བསྒོམ་དགོས་སོ།",
    "ད་ལྟ་མི་ཆེན་དཔོན་ཆེན་འབྱོར་ལྡན་ཞིག་ཡིན་ཀྱང་དེ་དག་མགོ་སྐོར་ཆེན་པོ་ཞིག་ཐེབས་འདུག་བསམ་པ་དྲན་ཡོང་གི་འདུག།",
    "དེ་ནས་ཉོན་མོངས་ལ་ཞེ་ཐག་པ་ནས་མི་དགའ་བ་ཤུགས་ཆེན་པོ་བྱུང་ན་ཉོན་མོངས་པས་བཞག་པའི་བག་ཆགས་ཤེས་བྱའི་སྒྲིབ་པ་ཡང་ཉོན་མོངས་དེའི་ཤུལ་ལྷག་ལྟ་བུའི་ངན་པ་ཞིག་ཡིན་བསམ་པ་རང་བཞིན་གྱིས་འོང་ཐུབ།",
    "རང་སྟེང་དུ་བསམ་ན་ཉོན་མོངས་ཀྱི་ཉེས་དམིགས།",
    "ཉོན་མོངས་དེས་བཞག་པའི་བག་ཆགས་ཀྱི་ཉེས་དམིགས།",
    "སྡུག་བསྔལ་དང་བྲལ་ཡང་ད་དུང་ཉོན་མོངས་པས་བཞག་པའི་བག་ཆགས་ཀྱིས་ཉམས་དམད་ནས་ཡོད་པ་རྣམས་བློ་ལ་འཆར་ཐུབ་པ་ཞིག་འོང་བ་ཡོད།",
    "ལྷག་པར་དུ་སྤྱོད་འཇུག་གི་སྐབས་ནས་དགྲ་ལ་ཕན་པ་བསྒྲུབ་དགོས་པ་སོགས་བཟོད་པའི་ཉམས་ལེན་གྱི་ཐད་རིགས་པ་བཏང་ནས་ཞེ་སྡང་ལ་ཁ་གྲག་ས་མེད་པ་ལྟ་བུ་ཞིག་གསུངས་ཡོད།",
    "སོ་སོར་མ་ཕྱེ་བར་དང་བོ་ནས་སྤྱི་ལ་དམིགས་ནས་སྦྱངས་པ་ལ་སྐྱེ་བ་ལྟར་སྣང་ཡང་རེ་རེ་ནས་བསམས་ན་གང་ལའང་མི་སྐྱེ་བར་སྣང་ལ།",
    "ངོ་ཤེས་པ་དེ་དག་ལ་རྒྱག་རེས་བྱས།",
    "དེ་ནས་ཨ་ཙི་མི་འདིས་ཚེ་འདིར་ང་ལ་གནོད་པ་བྱེད་ཀྱིན་ཡོད་མོད།",
    "སྒོམ་སྒྲུབ་བྱེད་པ་དང་སེམས་ལ་བཟོ་བཅོས་བྱེད་ཐབས་ལ་ནང་པའི་རྒྱ་གར་གྱི་སློབ་དཔོན་དང་བོད་ཀྱི་སློབ་དཔོན་རྣམས་ཧ་ཅང་མཁས་པ་རེད།",
    "རིགས་གཅིག་རྐང་འཛིན་ཁོ་ན་རེད།",
    "དེ་ཡང་སྔར་སྐྱེས་བུ་འབྲིང་གི་ལམ་སྦྱངས་བས།",
    "རང་གི་སྟེང་དུ་དེ་དག་བསམས་ན་ངེས་འབྱུང་གི་བསམ་བ་སྐྱེ་བའི་རྒྱུར་འགྱུར་ལ།",
    "གོ་བས་ལེགས་བར་དམིགས་མ་ཕྱེད་བར་ཕུར་ཚུགས་རེ་ལ་འབད་བའི་མྱོང་བ་ཐམ་ཐོམ་གྱིས་གར་ཡང་མི་ཕྱིན་ཏེ།",
    "སྐབས་ཤིག་ནས་ཤུལ་ལྷག་མེད་པར་གར་སོང་འདིར་སོང་མི་ཤེས་པ་ཞིག་ཏུ་འགྱུར་འགྲོ།",
    "སྡུག་བསྔལ་འདི་ནས་ཐར་ན་བསམ་པའི་བློ་ཞིག་ཟ་ཉལ་འགྲོ་གསུམ་སོགས་སྤྱོད་ལམ་གང་གི་སྐབས་སུའང་རང་གི་ངང་གིས་དྲན་ཡོང་བ་ཞིག་དང་།",
    "ཐོབ་ན་ཅི་མ་རུང་སྙམ་པ་ཞིག་དམིགས་རྣམ་སྦྱང་བའི་རྩོལ་བ་བྱེད་པ་ལ་མི་ལྟོས་པར་རང་གི་ངང་གིས་ཡོང་གི་འདུག་ན་སེམས་བསྐྱེད་ལ་མྱོང་བ་ཐོན་པ་ཡིན་གསུངས།",
    "འདི་ཡང་ལམ་མཐོན་བོར་སོང་བའི་སེམས་བསྐྱེད་མིན་གྱི།",
    "ཁ་ཏོན་མང་ཆེ་བ་ལྷའི་རྣལ་འབྱོར་རེད།",
    "སྔོན་གྱི་སྐྱེས་བུ་དམ་པ་མང་པོ་ཞིག་གིས་པོ་ཏི་ལྔའི་རྩ་བ་རེས་མོས་བྱས་ནས་གསུངས་པ་དང་།",
    "དེ་དག་ངོ་མཚར་ཆེན་པོ་རེད།",
    "འོན་ཀྱང་དེ་དག་གི་སྣོད་རུང་དུ་སྒྲུབ་བ་ལའང་སྔོན་དུ་བློ་མང་བོ་ཞིག་སྦྱང་དགོས་བར་སྣང་སྟེ།",
    "སྡུག་བསྔལ་ལས་བྲལ་ན་བསམ་པ་དང་བདེ་བ་དང་ཕྲད་ན་བསམ་པ་དང་བདེ་བ་དང་ལྡན་པ་དེ་བདག་གིས་བྱ།",
    "དུས་དང་རྣམ་པ་ཐམས་ཅད་དུ་སྒོམ་ཐུབ་པ་དེ་འདྲ་རེད།",
    "ཉོན་མོངས་ཁ་བའི་ཁུ་བས་བརླན་བསྒོས་བ།",
    "ཞེས་རོ་ཤིན་ཏུ་ཁ་བའི་ཏིག་ཏའི་སྡོང་བོ་ཆེན་བོ་ལྟ་བུ་ཞིག་ལ་བུར་ཁུ་ལྟ་བུའི་ཐིགས་པ་རེ་རེ་ཙམ་བླུགས་བས་མངར་བོར་བྱ་མི་ནུས་པ་ལྟར།",
    "ཇི་སྲིད་ནམ་མཁའ་མ་ཟད་ཀྱི་བར་དུ་གཞན་དོན་བདག་གིས་སྒྲུབ་བསམ་པ་ལྟ་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "ཕན་པ་དང་གཞན་དོན་བསྒྲུབ་རྒྱུ་བྱུང་ན་དོན་གོ་ཆོད་པ་རེད།",
    "གཞན་ལ་ཕན་བདེ་སྒྲུབ་མཁན་ཞིག་བྱུང་ན་རང་འཚོ་བའི་འཚོ་གོ་ཆོད་པ་རེད།",
    "དེས་ན་འདི་ཧ་ཅང་གལ་ཆེན་པོ་རེད་འདུག།",
    "རང་གི་ཉམས་མྱོང་གི་ཐོག་ནས་ཤེས་པ་ཞིག་མ་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "སྡོམ་པ་བཟུང་ཟིན་ནས་སྤྱོད་པ་ལ་སློབ་པ་རང་གིས་དམ་བཅས་པ་ཡིན་པས།",
    "ཞེས་གསུངས་པ་བཞིན་རང་གི་བློའི་འཕེན་པའི་ཁྱད་པར་གྱིས་མི་འདྲའོ།",
    "དུ་སྤྱོད་པ་ལ་སློབ་ཀྱང་རུང་མ་སློབ་ཀྱང་རུང་སེམས་དེ་སྨོན་སེམས་རེད།",
    "རང་རང་གི་དགོངས་པ་བཞེས་སྟངས་ཀྱི་ཁྱད་པར་རེད།",
    "རྗེས་སུ་བཅོས་མ་མ་ཡིན་པའི་སེམས་བསྐྱེད་དེ་མྱོང་བ་ཐོན་པའི་སྐབས་སུ་འཇུག་སེམས་སུ་འགྱུར་འགྲོ་བཞིན་ཡོད་སྙམ་མོ།",
    "རང་གཞན་སུ་ཡིན་ནའང་གནས་སྐབས་དང་མཐར་ཐུག་གི་ཕན་བདེ་ཟད་མི་ཤེས་པ་འདོད་པ་དང་།",
    "འཕྲལ་ཕུགས་ཀྱི་སྡུག་བསྔལ་ཆ་ཕྲ་མོ་ནས་ཉེ་བར་ཞི་བར་འདོད་མཁན་ཞིག་ཡིན་ན།",
    "དངོས་གནས་འཕྲལ་ཕུགས་ཀུན་ཏུ་སྐྱིད་པའི་སྐྱིད་མགོ་ཚུགས་པ་རེད།",
    "དེ་འདྲའི་བློ་དེ་ངོ་མཚར་རྨད་དུ་བྱུང་བ་རེད་བསམ་པ་ཞིག་དང་།",
    "དུས་ད་རེས་འཕྲལ་དང་ཕུགས་ཀྱི་དགེ་སྐྱོན་གང་ལ་གང་འཚམ་ཞིག་ཤེས་པའི་སྐབས་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་ལག་ལེན་དུ་བཀལ་ནས་གཞན་ལ་ཕན་པའི་བསམ་པ་བཟང་པོ་དེ་ཐོག་མར་མ་བསྐྱེད་པ་གསར་དུ་བསྐྱེད།",
    "ཞེས་བཅོམ་ལྡན་འདས་ཁོང་རང་གི་ཡོན་ཏན་ཐམས་ཅད་འབྱུང་སའི་འབྱུང་ཁུངས་ལྟ་བུ།",
    "གཅིག་ཏུ་འགྲོ་ལ་ཕན་པར་བྱེད་པའི་ཐུགས་སེམས་བཟང་པོ་དེའི་སྒོ་ནས་མཐའ་ཡས་པའི་ཡོན་ཏན་དེ་བྱུང་བ་རེད།",
    "དེ་རྨད་དུ་བྱུང་བའི་ཡོན་ཏན་རེད།",
    "མིག་གིས་མཐོང་བའི་ཐད་ཀ་ཐད་ཀའི་བདེ་སྡུག་ཉམས་མྱོང་གི་སྒོ་ནས་སེམས་བཟང་པོ་བྱེད་དགོས་པ་ཞིག་སྒྲུབ་པ་དང་།",
    "མིག་གིས་མཐོང་བ་མེད་པའི་ལྟ་བའི་རྣམ་གཞག་གི་སྒོ་ནས་སེམས་བཟང་པོ་བྱེད་དགོས་པའང་སྒྲུབ་ཀྱི་ཡོད།",
    "མི་བློ་གྲོས་ཅན་དང་རྣམ་དཔྱོད་ཅན་ཞིག་གིས་རྟགས་གསལ་བཏང་ན་ཧ་ཅང་བསམ་བློ་གཏོང་ས་ཡོད་པ།",
    "རང་ཅག་ཐམས་ཅད་འཛམ་བུའི་གླིང་འདིར་དུས་རབས་ཉི་ཤུ་པའི་ནང་སྐྱེས་པ་རེད།",
    "ཤེས་བྱ་ཡོན་ཏན་སྦྱང་བའི་བློ་གྲོས་ནི་གང་ཡང་མེད་མོད།",
    "མི་རྣམས་དོན་གྱི་གནས་སྟངས་གཅིག་གིས་གཅིག་ལ་བརྟེན་ནས་གནས་དགོས་ཀྱང་།",
    "ཟ་མ་གསོག་པ་ལྟ་བུ་གཅིག་གིས་གཅིག་ལ་རོགས་བྱས།",
    "བག་ལེབ་འདྲ་པོ་གཅིག་གིས་འཁྱེར་མ་ཐུབ་ན་དེ་ལ་ཐམས་ཅད་ཀྱིས་རོགས་བྱེད་ཀྱི་མི་འདུག་གམ།",
    "ནུས་པ་ཅི་ཡོད་ཀྱིས་སེམས་ཐག་བཅད་ན་སེམས་ལའང་སྐྱིད་པོ་ཡོང་གི་རེད་ལ་རང་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "སྡུག་པོ་བྱུང་ཡང་ཚོགས་རྫོགས་པ་ལ་ཕན།",
    "རང་གི་ངོས་ནས་སེམས་ཐག་གཙང་བཅད་དང་ཡིད་བསྒྲིལ་ས་འདི་ཡིན་བསམ་པ་ཞིག་ཡོད་ན།",
    "ཁྱེད་རང་ཚོའི་ངོས་ནས་ཡིན་ནའང་དེ་དེ་བཞིན་རེད།",
    "རང་གི་མོས་པ་མང་བའི་རྒྱུས།",
    "གཅིག་གིས་གཅིག་ཟ་བ་སོགས་དེ་འདྲའི་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་ཞིག་ཡོད་དང་ཡོད་བཞིན་པའི་སྟེང་འགྲོ་བ་མིའི་རིགས་ཀྱིས་ཧ་ལས་པའི་མནར་གཅོད་གཏོང་གི་ཡོད།",
    "རི་བོང་དང་སྤྲེའུ་ཁྱི་དང་ཞི་མི་སོགས་ལ་ལག་སྦྱོང་གི་བེད་སྤྱོད་བྱེད་ས།",
    "མིའི་ལུས་སྐྱོབ་པའི་དོན་དུ་གནོད་མེད་དུ་གནས་པའི་འབུ་སྲིན་དང་དུད་འགྲོ་སོགས་གསོད་པ་འདི་ཐབས་སྐྱོ་པོ་རེད།",
    "ན་ཟུག་དང་ཚ་ཟུག་བཟོད་གླགས་མེད་པའི་སྡུག་བསྔལ་མྱོང་ནས་ཤི་རྒྱུ་རེད།",
    "ལྷག་པར་དབྱིན་ལན་ནང་ལ་ཤུགས་ཆེན་པོ་ཡོད་པའི་སྐད་ཆ་འཆད་ཀྱིན་འདུག་དེ་དག་ཧ་ཅང་ཡག་པོ་རེད།",
    "འཛམ་བུའི་གླིང་འདིར་དངངས་སྐྲག་དང་བརྡབ་གསིག་མང་དུ་སོང་ཡང་།",
    "ཞབས་འདྲེན་ངེད་ཅག་གིས་ཧུར་བརྩོན་བྱས་ནས་ཞུ་ཟེར་མཁན་ལྟ་བུར་འགྱུར་བའི་ཉེན་ཁ་ཅུང་ཙམ་འདུག།",
    "སྡུག་བསྔལ་ཕྲ་མོ་ཙམ་ཡང་མི་འདོད་ཅིང་།",
    "སྤྲང་པོ་བཅུ་ཡོད་ན་ཐམས་ཅད་ལྟོ་གོས་ཀྱིས་ཕོངས་ནས་དཀའ་ངལ་འཕྲད་དེ་སློང་མོ་བྱེད་པ་གཅིག་མཚུངས་ཡིན་ལ།",
    "ཐུབ་པས་ཉོན་མོངས་དག་གཟིགས་ཀྱི།",
    "ཉོན་མོངས་དང་འབྲེལ་གང་ཟག་མིན།",
    "རྟག་པ་བརྟན་པ་ཐེར་ཟུག་གི་དགྲ་དང་གཉེན་ཞེས་པ་ཞིག་གཏན་ནས་མེད་བསམ་པ་དེ་ལྟ་བུའི་སྟེང་ནས་བློ་སྦྱང་།",
    "དེས་ན་དགྲ་གཉེན་དུ་ཞེན་པའི་ཆགས་སྡང་གི་བློའི་གཞི་བྱེད་པའི་དགྲ་གཉེན་བདེན་གྲུབ་ཏུ་འཛིན་པའི་བློ་དེ་ལ།",
    "རང་བཞིན་དུ་གྲུབ་པའི་དགྲ་ཡོད་ན་དེ་བཞིན་གཤེགས་པས་གཟིགས་དགོས་པ་ལ་དེ་མ་གཟིགས་པའི་ཕྱིར།",
    "དེ་བཞིན་གཤེགས་པས་རང་བཞིན་གྱི་དགྲ་ཞིག་རྩ་བ་ནས་མ་གཟིགས་པས།",
    "ཕུགས་ཀྱི་ཁེ་ཕན་ཆེན་པོའི་དོན་དུ་འཕྲལ་གྱི་སྡུག་བསྔལ་དང་དུ་ལེན་ན་མཁས་པ་རེད།",
    "འདི་དགོས་འདོད་ཀུན་འབྱུང་གི་ནོར་བུ་ཡིན་པ་ཤེས་པར་བྱས་ནས་མ་སྐྱེས་པ་བསྐྱེད་པ་དང་སྐྱེས་པ་གོང་ནས་གོང་དུ་འཕེལ་བ།",
    "བྱིས་པ་རང་གི་དོན་བྱེད་དང་།",
    "བརྩི་བའི་བདག་ཅག་གི་སྟོན་པ་འདི་གང་ལ་བརྟེན་ནས་བྱུང་བ་ནི།",
    "རང་ཅག་གི་ཁ་སྟབས་གཉིས་པོ་བསྡུར་ན་ཤེས་ཐུབ་པར་གསུངས།",
    "གཞན་གཅེས་པར་འཛིན་པ་ཕུན་སུམ་ཚོགས་བ་ཐམས་ཅད་ཀྱི་གནས་སུ་བསམ་མོ།"
  ]
}