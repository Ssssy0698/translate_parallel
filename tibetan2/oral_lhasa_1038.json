    "སྐྱོད་རབ་ཏུ་བསྐྱོད་པས་གནོད་བྱེད་བྱད་མ་ལྷ་སྲུང་གདོན་བགེགས་འབྱུང་པོ་ཐམས་ཅད་དམར་ཉི་ལི་ལི་གཏུབས།",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་བཅས་པ་ཐམས་ཅད་ནྲི་ཏྲི་མཱ་ར་ཡ་བྷྱོ་བྷྱོ་ཟློག་ཟློག",
    "གནོད་པར་བྱེད་པའི་བགེགས།",
    "བསམ་ངན་སྦྱོར་རྩུབ་འཆང་བའི་བྱད་མ་ལྷ་སྲུང་།",
    "དགྲ་བགེགས་བྱད་མ་ལྷ་སྲུང་དང་།",
    "ཞལ་གདངས་ཤིང་ལྗགས་འདྲིལ་བ་ཞབས་གཉིས་བརྐྱང་བསྐུམ་གྱི་གར་སྟབས་སུ་འགྱིང་ཞིང་དུར་ཁྲོད་ཀྱི་ཆས་དང་དཔལ་གྱི་ཆས་བཅུས་སྤྲས་ཤིང་ཁ་ཊྲཱཾ་ག་ལ་བདེ་བར་འཁྱུད་ཅིང་མེ་དཔུང་དམར་ནག་འཁྲུག་པའི་ཀློང་དཀྱིལ་དུ་བཞུགས་པ་ལ།",
    "བརྒྱ་སྟོང་ཁྲི་འབུམ་སྐབས་དང་སྦྱར་ཏེ་བཟླས་པའི་མཇུག་ཏུ་མཆོད་ཅིང་བསྟོད་པར་བྱའོ།",
    "འདིར་བདུད་འདུལ་སེང་གདོང་མཁའ་འགྲོ་སྒྲུབ་པའི་ཟིན་བྲིས་འགོད་པར་བྱ་སྟེ།",
    "མ་རྙེད་ན་སྐུད་པ་ཡང་རུང་དཀྱིལ་འཁོར་སྒྲུབ་གཞུང་ལྟར་དང་གཏོར་མ་དཔེའུ་རིས་ལྟར་བཅའ་། སྒྲུབ་རྟེན་ནི་བདུད་འདུལ་མའི་སྐུ་དར་རས་མཐིང་ཀ་ལ་ལེགས་པར་བྲིས་པའི་སྐུ་རྒྱབ་ལ།",
    "གཞན་ཡང་སྒྲུབ་རྫས་ཕྱི་ནང་གསང་གསུམ་གྱི་མཆོད་རྫས་རྣམས་ལེགས་པར་བཤམས།",
    "ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་གནམ་ལྕགས་ཀྱི་གྲི་གུག་འཁོར་ལོའི་ཡུ་བ་བྱས་པའི་ལྟེ་བར་ཉི་མའི་གདན་གྱི་སྟེང་དུ་ཧཱུྃམཐིང་ནག་ཅིག་བསྒོམ",
    "བསྐྱེད་པའི་རིམ་པ་ཐམས་ཅད་ཨ་འཐས་ཐེར་གཟུགས་མ་ཡིན་པར་ཆུ་ཟླ་འཇའ་ཚོན་ལྟར་སྣང་ལ་རང་བཞིན་མ་གྲུབ་པ་གསལ་སྟོང་དུ་བསྒོམ",
    "སྔོན་འགྲོ་དཀར་བགེགས་ཆད་བསྟན་ཚོགས་ལྷག་རྣམས་དང་པོའི་ཉིན་པར་ཕྱི་རོལ་དུ་འཕངས།",
    "ཕག་ཞལ་ངུར་ཞིང་མེ་། ཀླུང་བཞུགས།",
    "ཁ་ཊྲཱཾ་གར་འཁྱུད་བརྐྱང་བསྐུམ་བཞུགས།",
    "ཆར་སྤྲིན་གཏིབས་ལྟར་བྱོན་པར་གྱུར།",
    "གཉིས་མེད་བརྟན་པ་ཆེན་པོར་བཞུགས།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པ་ཀུན།",
    "སྤྱི་བོར་འཁོར་ལོ་རྩིབས་བཞིར་ཨོཾ། ། མགྲིན་པར་པདྨའི་ལྟེ་བར་ཨཱ།",
    "ལེགས་ཚོགས་དཔལ་ལ་སྤྱོད་པར་བསམ།",
    "དེ་ནས་བསྲུང་བའི་སྒོམ་བཟླས་ལ་འཇུག་པར་འདོད་ན།",
    "ཚ་ཞིག་བསྲེགས་པར་གནས་གྱུར་ཏེ།",
    "རབ་ཏུ་བསྐྱོད་པས་གནོད་བྱེད་བྱད་མ་ལྷ་སྲུང་གདོན་བགེགས་འབྱུང་པོ་ཐམས་ཅད་དམར་ཉལ་ཉལ་གཏུབས།",
    "ཚེ་བསོད་རྣམས་ནི་ཡིག་དང་འོད་ཀྱི་རྣམ་པར་བྱས་ཏེ་རང་དང་བསྲུང་བྱར་བསྟིམས་པས་བཀྲག་མདངས་གཟི་བརྗིད་རྒྱས་པར་གྱུར་པར་བསམ་ལ།",
    "རང་གཤེད་ལ་ཕབ་རྡུལ་དུ་བཤིགས་བྱས་ནས།",
    "ཡིག་བརྒྱས་བཟོད་པར་གསོལ།",
    "སྲུང་འཁོར་རྟེན་དང་བརྟེན་པར་བཅས་པ་ཀུན།",
    "ངོས་མ་ཟིན་པར་གང་བྱུང་ཆོ་རོལ་གྱིས།",
    "བཀོད་པར་དགོས་ཆེད་དབེན་ཀྱང་ཤར་མར་དུ།",
    "སྤེལ་བའི་ཞར་འཕྲོས་ཙམ་ལགས་ངག་ཁྲིགས་འདི།",
    "བདུད་འདུལ་མཁའ་འགྲོའི་བསྒྲལ་ལས་གནམ་ལྕགས་རལ་གྲི་བཞུགས། ། བདེ་གཤེགས་ཀུན་གྱི་ཡེ་ཤེས་ཐུགས་རྗེའི་དབྱིངས།",
    "དེ་ཡི་ལྷ་སྔགས་ཡེ་ཤེས་རོལ་པའི་ཤུགས།",
    "དགྲ་བགེགས་གདུག་པ་ཅན་བསྒྲལ་བའི་ལས་ལ་འཇུག་པར་འདོད་པས།",
    "རྨད་བྱུང་བདུད་རྩིའི་གསེར་སྐྱེམས་འདི་བཞེས་ལ།",
    "ཁྱད་པར་ཡེ་ཤེས་མཁའ་འགྲོ་སེང་གདོང་མ།",
    "རྨད་བྱུང་བདུད་རྩིའི་གསེར་སྐྱེམས་འདི་བཞེས་ལ།",
    "དམན་པར་འཛིན་པའི་། དགྲ་བོས་བར་དུ་བཅད།",
    "ལོག་པར་རྟོག་པའི་བློ་ངན་ཆམ་ལ་ཕོབ།",
    "ཀུན་མཁྱེན་རྒྱལ་བའི་བསྟན་པའི་སྒོར་ཞུགས་ནས།",
    "བསྟན་དགྲ་གནོད་བྱེད་མིང་ཡང་མེད་པར་མཛོད།",
    "ཚེ་གཅིག་རྣམ་མཁྱེན་གོ་འཕང་བསྒྲུབ་པ་ལ།",
    "ནག་ཕྱོགས་བདུད་དང་དགྲ་བོས་རྣམ་པར་གཙེས།",
    "གནོད་བྱེད་ལོག་འདྲེན་ཐམས་ཅད་གཅིག་ཏུ་འདུས་པའི་རང་བཞིན་ཅན་དུ་གྱུར་པར་བསམས་ཤིང་།",
    "ད་དགྲ་དངོས་སུ་གཏོད་པར་བྱེད་པའི་གཟུགས་ཅན་མི་ཡི་དགྲ་ཚེ་ལ་བརྐུ་བ།",
    "གནོད་པར་བྱེད་པའི་དགྲ་དང་བགེགས།",
    "རྣམ་པར་འཚེ་བའི་བདུད་དང་སྤྲོད།",
    "དགྲ་བོ་འདི་ཡི་ལྷ་སྲུང་རྣམས།",
    "རྗེས་སུ་ཆགས་པའི་སྦྱོར་བས་སྙོམས་པར་ཞུགས་པའི་མཁའ་ལས་སྲས་མཆོག་ཀཱི་ལཱ་ཡ་སྐུ་སྟོད་སྲིན་པོ་ཁྲོས་པའི་ཉམས་ཅན་མཐིང་ནག་ཕུར་། བུ་སྒྲིལ་བ་ལྟེ་བ་མན་ཆད་གནམ་ལྕགས་ཀྱི་ཕུར་པ་ཟུར་གསུམ་པ་རྣོ་བའི་དབལ་དང་ལྡན་པ།",
    "ཅེས་བརྗོད་པས་སྲས་མཆོག་ལས་འོད་ཟེར་ཕྱོགས་བཅུར་འཕྲོས་པས་རྒྱལ་བ་སྲས་བཅས་ཀྱི་ཐུགས་རྗེ་དང་ནུས་མཐུ་ཐམས་ཅད་འོད་ཟེར་གྱི་རྣམ་པར་སྤྱན་དྲངས།",
    "ཕུར་པ་ལ་ཐིམ་པས་ཁམས་གསུམ་དུས་གཅིག་ལ་སྒྲོལ་བར་ནུས་པའི་མཐུ་དང་ལྡན་པར་གྱུར་པར་བསམས་ལ།",
    "རྣམ་པར་གདེངས་པ་ཙམ་གྱིས་ཀྱང་།",
    "དྭངས་མ་ཧཱུཾ་སྔོན་པོར་གྱུར་པ་རྒྱ་མདུད་ཀྱི་རྩེ་ལས་འཐོན་ཏེ་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོའི་ཐུགས་ཀར་ཐིམ་པར་བསམས་ཤིང་།",
    "ཅེས་བརྗོད་ཅིང་སྤར་ལ་དམིགས་མེད་དུ་དར་གཅིག་མཉམ་པར་བཞག་གོ།",
