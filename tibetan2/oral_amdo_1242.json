    "མ་ནིང་གཉིས་པོ་རན་དང་མོ་ཉིད་ཞན།",
    "ཤིན་ཏུ་མོ་ནི་མཉམ་ཞིང་ལྷོད་པས་སོ།",
    "མོ་འ་ནི་སྒྲ་རྩོལ་ཞན་པས་དང་།",
    "ཤིན་ཏུ་མོ་མ་ནི་སྒྲ་རྩོལ་མཉམ་པ་སྟེ་ཤིན་ཏུ་ལྷོད་པའི་ཚུལ་གྱིས་འཇུག་པར་བྱེད་དེ།",
    "མོ་ནི་ཞན་པའི་ཚུལ་གྱིས་ཏེཤིན་ཏུ་མོ་ནི་མཉམ་པས་སོ།",
    "བྱེད་པ་པོ་བདག་གི་དངོས་པོའི་སྒྲ།",
    "འདི་དག་གིས་མཚོན་ནས་ཀུན་ལ་བསྒྲེ་བར་བྱའོ།་",
    "དེ་ལས་སྔ་མའི་དོན་ནི་རྟོགས་སླ་ལ་ཕྱི་མ་ནི་དཔེར་ན་སྐྱེས་བུ་ཞིག་གི་མདུན་དུ་ལྕགས་གོང་རང་བཞིན་གྱིས་གསེར་དུ་གྱུར་པའི་ཚེ།",
    "སྔོན་འཇུག་གི་ཕོ་ཡིག་བ་ནི་དགོས་པ་དུས་གསུམ་ལས།",
    "གད་མོ་བགད།",
    "སོགས་ཏེ་དེ་དག་ལ་སླར་བསྡུའི་སྒྲ་སྦྱར་བ་རྣམས་ད་ཡིག་གི་ཡང་འཇུག་ཡོད་པར་ཤེས་དགོས་སོ།",
    "ཐུགས་དམ་བསྐངས་ལྟ་བུ་སྔོན་འཇུག་ཕོ་ཡིག་འབྲེལ་བ་ཙམ་ལས་གཙོ་བོར་རྗེས་འཇུག་གི་བྱེད་པས་འདས་ཚིག་ཏུ་གྲུབ་པ་སོགས་བྱེ་བྲག་ཕྱེས་ནས་ཤེས་པར་བྱའོ།",
    "བགད་བྱའི་གད་མོ།",
    "བགམ་མོ་སོགས་སྔར་སྨོས་པ་གཞན་ལ་སྦྱར་བས་མཚོན་ལ།",
    "དེ་བཞིན་སྔོན་འཇུག་མ་ནིང་དགོས་པ་གང་གི་ཕྱིར་འཇུག་པ་ནི།",
    "སྔོན་འཇུག་གི་མ་ནིང་ག་ད་གཉིས་ནི་དངོས་པོ་བདག་དང་གཞན་གཉིས་ཀ་ལ་འཇུག་པ་དང་།",
    "གཡབ་བྱའི་གཡབ་མོ།",
