    "དེ་ཕྱིར་སེམས་འདི་ཇི་ལྟར་རྣམ་པར་མི་གཡོ་བ།",
    "འཐུང་སྟེ་མེ་ཏོག་རྣམས་ནི་ཉམས་པར་བྱེད་མ་ཡིན།",
    "ཕ་རོལ་དད་པ་རྣམས་ནི་ཉམས་པར་བྱེད་མ་ཡིན།",
    "དྲང་པོས་རྟག་པར་ཁུར་བར་བྱེད་ཅེས་ཁུར་བྱ་དང་།",
    "གཉིད་ལོག་པར་འོས་འདི་ལས་གཞན་དུ་ངོ་ཚའོ།",
    "ངོ་ཚས་རྣམ་པར་སྤངས་པའི་ཡོན་ཏན་རྣམས་ཀྱིས་སྤངས།",
    "ངོ་ཚས་རྣམ་པར་དམན་པ་ཕྱུགས་དང་མཉམ་པའོ།",
    "ཞི་བ་མ་ཡིན་དག་ནི་བརྗོད་པར་མི་བྱ་སྟེ།",
    "རྣམ་པར་འགྱུར་བའི་གོས་དང་ལྷུང་བཟེད་མཐོང་ནས་དང་།",
    "གཞན་ལས་མཐར་གྱུར་སྤྱོད་པ་རྣམ་པར་བསམས་ནས་སུ།",
    "ང་རྒྱལ་རྣམ་པར་འཕེལ་བ་འཇོམས་པའི་ཕྱིར་ཡིན་ན།",
    "ཚིམ་མེད་རྣམས་ནི་མཐོ་རིས་ན་ཡང་རྣམ་པར་སྲེག།",
    "ཞི་བའི་བདེ་བ་དམ་པ་ཐོབ་པར་འདོད་རྣམས་ཀྱིས།",
    "གཉིས་འཐུང་འཁོགས་པ་འདམ་ལ་བཞིན་དུ་ཆགས་པར་འགྱུར།",
    "རྟག་པར་རབ་ཞུགས་ཆུ་ཡི་རྒྱུན་ནི་མཉེན་ན་ཡང་།",
    "རྡོ་ཡི་ལོགས་ལ་དུས་སུ་རྣམ་པར་འབིགས་པ་སྟེ།",
    "བརྩོན་འགྲུས་ཀྱིས་ནི་རྙེད་པར་དཀའ་བ་ཅི་ཡང་མེད།",
    "དེ་ཡི་ཤིང་ལ་མེ་ནི་རྙེད་པར་སླ་མིན་ཞིང་།",
    "བརྩོན་འགྲུས་བརྩམས་པས་རྙེད་པར་སླ་བར་འགྱུར་བ་སྟེ།",
    "དྲན་པ་ཉམས་ལས་ངེས་པར་ཐམས་ཅད་ཉམས་པ་སྟེ།",
    "མཉམ་པར་གཞག་པའི་བློ་དང་སེམས་ནི་ཡོངས་བསྡམས་ིཤིང་།",
    "དེ་ལྟར་དོང་དང་འོབས་དང་མཚུངས་པར་རབ་ཏུ་བསྟན།",
    "ཤེས་རབ་རྣམ་པར་འཕེལ་ལ་རབ་ཏུ་འཇུག་པར་བྱ།",
    "མཆོག་ཏུ་ཞི་བ་ཐོབ་པར་འདོད་པ་རྣམས་ཀྱིས་འདི།",
    "བག་མེད་དགྲ་བོ་བཞིན་དུ་རྣམ་པར་སྤོངས་མཛོད་དང་།",
    "བག་མེད་པ་ལས་ལྷ་མིན་ཁེངས་རྣམས་རྣམ་པར་ཉམས་། ཕན་པ་དང་ལྡན་རྗེས་སུ་བརྩེ་བ་མངའ་བ་ཡི།",
    "ཁྱེད་ཅག་རྣམས་ཀྱི་སེམས་ནི་ཞི་བས་བྱས་པའོ།",
    "གདུང་བ་ལྡན་པར་མ་གྱུར་ཅིག།",
    "དེ་ཡི་དུས་ཀྱིས་སྦྱར་བར་ངེས་པར་བསྟེན་པ་ལ།",
    "ལམ་ནི་ལམ་མཁན་གྱིས་ནི་རྣམ་པར་བསྟན་པ་ན།",
    "དེ་ནི་མྱུར་ཞིང་སྤོབས་པར་བདག་ལ་སྨྲོས་ཤིག་དང་།",
    "ཐེ་ཚོམ་ཤིན་ཏུ་རྣམ་པར་དཔྱད་བྱ་བཅད་པར་བགྱི།",
    "དེ་ལྟར་མཐོན་པོར་གསུངས་པའི་དྲང་སྲོང་ཆེན་པོ་ལ།",
    "བདེན་པ་མིན་པར་བྱེད་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "སྟོན་པ་མྱ་ངན་འདའ་བ་རྙེད་པར་འགྱུར་ཞེས་ཏེ།",
    "མགོན་པོ་ཤིན་ཏུ་སྐྱེན་པར་ངེས་པར་གཤེགས་ཐོས་ཏེ།",
    "དོན་ནི་རྣམ་པར་ཤེས་ཀྱང་ཤེས་ནས་སླར་ཡང་ནི།",
    "ཕན་ཚུན་དུ་ནི་འདུ་བ་ངེས་པར་ཡོད་མ་ཡིན།",
    "བདག་ཉིད་ཀྱི་དང་གཞན་གྱི་དོན་ནི་བྱས་ནས་ནི་། ཁོ་བོ་གནས་པ་ལ་ནི་དགོས་པ་ཡོད་མ་ཡིན།",
    "དེ་ཕྱིར་འགྲོ་བའི་རང་བཞིན་རྣམ་པར་ཤེས་བྱས་ནས།",
    "བསམ་མནོ་མ་བྱེད་ངེས་པར་རྣམ་པར་འབྲལ་བ་སྟེ།",
    "ཡེ་ཤེས་སྒྲོན་མས་མུན་པ་རྣམ་པར་བསལ་བྱས་ནས།",
    "སྲིད་པའི་མཚོ་ཡི་རྒྱུན་ནི་རྣམ་པར་འགགས་པ་ན།",
    "དོན་མེད་བྱེད་པའི་དགྲ་བོའི་རྣམ་པར་ཉམས་ལས་བཞིན།",
    "རྒྱུ་དང་མི་རྒྱུ་ཐམས་ཅད་རྣམ་པར་འགོད་པ་སྟེ།",
    "དེ་ཕྱིར་ཁྱེད་ཅག་རྣམས་ནི་ལེགས་པར་བག་ཡོད་གྱིས།",
    "དེ་ལས་རྣམ་པར་བཞེངས་ནས་གཉིས་པར་གཤེགས་པ་སྟེ།",
    "རིམ་གྱིས་མ་ཚང་མེད་པར་ཐམས་ཅད་ལ་གཤེགས་སོ།",
    "སྙོམས་པར་འཇུག་པའི་ཚོགས་ནི་མཐའ་དག་བསམ་གཏན་མཛད།",
    "དེ་ལས་རྣམ་པར་བཞེངས་ནས་ཀྱང་ནི་རིམ་གྱིས་ནི།",
    "ཕྱོགས་ནི་སྲེག་པར་བྱེད་པ་བྱུང་བར་གྱུར་པ་ཉིད།",
    "ལྷ་མིན་འཇོམས་པར་འདོད་པ་གཡུལ་དུ་འཇུག་པ་ན།",
    "ཁྲོ་བ་བརྒྱ་བས་ཁྲོ་བ་རྣམ་པར་གཏོང་བ་བཞིན།",
    "རྣམ་པར་བཏུད་ནས་དྲང་སྲོང་ཆེན་པོའི་སྐུ་ལུས་ནི།",
    "ཐུབ་པ་ལ་ནི་གུས་པས་ལྟ་བཞིན་གནས་པར་གྱུར།",
    "མྱ་ངན་འོངས་པ་མིན་རྣམས་མྱ་ངན་སྨད་པར་གྱུར།",
    "གཙང་མར་ལྷག་པར་གནས་པའི་བྱེད་ལྡན་ལྷ་རྣམས་ཀྱང་།",
    "འཇིག་རྟེན་དག་ནི་རང་བཞིན་རྣམ་པར་སྨད་པའོ།",
    "འཕྱོ་ཞིང་གླུ་དབྱངས་གར་བྱས་དགའ་བར་གྱུར་པ་རྣམས།",
    "ཡུད་ཙམ་ཐམས་ཅད་མཁྱེན་པ་ིལ་ནི་བལྟས་ནས་སུ།",
    "སྐྱེ་བ་རྣམས་ནི་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པ་སྟེ།",
    "འཇིག་རྟེན་དག་ན་འགའ་ཞིག་ཉམས་པར་མི་འགྲོ་མེད།",
    "རྨོངས་པ་ངེས་པར་མིག་ལོང་གསོན་པའི་འཇིག་རྟེན་ནི།",
    "འདུ་ཤེས་ཉམས་ཤིང་ལམ་ངན་ལ་ནི་གནས་པར་འགྱུར།",
    "རྗེས་སུ་ཆགས་པ་ཉམས་ཤིང་སྐྱེ་བ་འགགས་བྱས་པས།",
    "དུས་འདིར་ངེས་པར་བློ་གཏད་བྱ་བ་མ་ཡིན་ཞིང་།",
    "མི་རྟག་ཉིད་ཀྱི་རྡོ་རྗེ་ངེས་པར་བཏུང་བ་ཡིས།",
    "གང་དུ་ཐུབ་པ་རི་བོ་ཆེན་པོ་བཅོམ་པར་འགྱུར།",
    "འཇིག་རྟེན་གསོན་པའི་འཇིག་རྟེན་ཀྱེ་མ་སྨོད་པར་ཤོག།",
    "ཉེས་པའི་གཉིས་འཐུང་རྣམས་ནི་ཉམས་པར་མཛད་ནས་ཉམས།",
    "ད་ནི་འཇིགས་པ་ཆེན་པོ་མ་ཡིན་སུ་ཡི་ལགས།",
    "གསེར་གྱི་ཀ་བ་ལྟ་བུ་ཀུན་ནས་ཆག་པར་གྱུར།",
    "ལམ་ལ་བཅུག་ནས་མི་ཡི་ཉི་མ་ནུབ་པར་གྱུར།",
    "རྫུ་འཕྲུལ་གྱིས་ནི་སྐུ་ལུས་འདྲེན་པར་ནུས་ན་ཡང་།",
    "ཁྱད་པར་འཕགས་པའི་བློ་ཡིས་རྣམ་པར་གསལ་བར་གྱུར།",
    "བརྟན་པར་གཤེགས་ཤིང་སེམས་ནི་བསྲུང་དུ་བཅུག་གྱུར་ལ།",
    "དེ་ནི་འཕགས་མིན་མི་རྟག་ཉིད་ཀྱིས་ནུབ་པར་གྱུར།",
    "དགའ་བས་མཆོག་ཏུ་ངེས་པ་རྣམ་པར་བཟུང་བ་སྟེ།",
    "རྟོགས་པར་དཀའ་བའི་དོན་ནི་རྣམ་པར་ཤེས་པར་མཛད།",
    "ཐམས་ཅད་མི་རྟག་པ་དང་བདག་མེད་པར་གསུངས་ཤིང་།",
    "སྙན་པའི་བ་དན་གྱེན་དུ་རྣམ་པར་བསྒྲེངས་པ་སྟེ།",
    "ང་རྒྱལ་ཀ་བ་མཐོན་པོ་རྣམ་པར་བསྒྱེལ་བ་མཛད།",
    "རྟོགས་ཤིང་ཕ་རོལ་རྨོངས་པས་རྟོགས་པར་མཛད་པའོ།",
    "ཐུབ་པ་ཐུབ་པས་ཚུལ་དང་ཚུལ་མིན་མཁྱེན་འདི་དེས།",
    "འཇོམས་པར་འདོད་ཅིང་སྟོབས་ནི་རབ་ཞུགས་བདུད་ཀྱང་ནི།",
    "འཇོམས་པར་འདོད་ཅིང་སྟོབས་ཞུགས་བདུད་ཀྱིས་དེ་རིང་ནི།",
    "དེ་ནི་དུས་ཀྱི་སྦྱོར་ལས་འཇོམས་པར་ནུས་པར་གྱུར།",
    "ལྷ་ཡི་རྣ་བས་སྒྲ་ནི་རྣམ་པར་ཐོས་པའོ།",
    "བར་སྣང་དག་ལ་སྐར་མའི་ཁང་པར་འཛེགས་པ་སྟེ།",
    "ཆུ་ལ་རབ་ཏུ་གཤེགས་ཀྱང་ནུབ་པ་མ་ཡིན་ལ་། སྐུ་ཡིས་རྣམ་པར་འགྱུར་བ་མང་པོ་རྣམས་མཛད་དོ།",
    "ཐམས་ཅད་མཉམ་པར་རབ་ཞུགས་ཐམས་ཅད་མཁྱེན་པ་དེས།",
    "ཡེ་ཤེས་དེ་ཉིད་ཀུན་ནས་བརྙེས་ནས་གཟིམས་པར་གྱུར།",
    "རྣོ་བ་མ་ཡིན་བློ་རྣམས་རིམ་གྱིས་དྲག་པར་མཛད།",
    "ས་བདག་རྒྱལ་སྲིད་དང་ནི་རྣམ་པར་བྲལ་བ་འམ།",
    "དེ་ཕྱིར་འཇིག་རྟེན་འཇིག་རྟེན་མཁྱེན་པས་རྣམ་པར་དམན།",
    "ནུབ་པར་གྱུར་ཚེ་མི་ཤེས་མུན་པ་རྣམས་བཅོམ་ནས།",
    "འདྲེན་མཛད་ཟམ་པ་འདི་ནི་ངེས་པར་དེ་ནི་རྒུད།",
    "དེ་ནས་དུས་དང་མཐུན་པའི་ཆོ་ག་བྱས་ནས་སུ།",
    "རྔ་ཡབ་དཀར་པོ་རྣམས་ནི་རྣམ་པར་གཡབས་པའོ།",
    "ཙནྡན་དམར་པོའི་རོ་ནི་རྣམ་པར་དུལ་བ་དང་།",
    "དེ་ཡི་རྣམ་པར་ཉམས་ལས་ཀུན་ནས་ངུ་བ་སྟེ།",
    "གྲགས་པས་བསགས་ཕྱིར་བསགས་ཀྱི་པ་དེ་རྣམས་ཀྱིས་བྱས་སོ།",
    "བག་མེད་ལྡན་པ་གཞུ་ནི་རྣམ་པར་འཁྲུགས་པ་ཡིས།",
    "ལམ་དག་ཏུ་ནི་རྣམ་པར་འོང་བའི་འོད་སྲུངས་ནི།",
    "རྣམ་པར་དག་པའི་སེམས་ཀྱིས་སེམས་ནི་གྱུར་པ་སྟེ།",
    "མེ་ཡིས་རུས་པ་ཚིག་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "ཁམས་ནི་མེ་ཡིས་ལོག་པར་སྦྱོར་བ་མ་ཡིན་ཉིད།",
    "བྱམས་པས་ཡོངས་སུ་རྣམ་པར་བསྒོམས་པ་འདི་རྣམས་ནི།",
    "འདོད་ཆགས་མེ་ཡིས་ཚིག་པས་རྣམ་པར་སྤངས་པ་སྟེ།",
    "དེ་ཡི་སྐུ་ཡི་ཆ་ཤས་འདི་ནི་བུམ་པར་གནས།",
    "དེ་ཡི་ས་ནི་སྣང་བས་རྣམ་པར་ོམཛད་པ་སྟེ།",
    "མེ་རྣམས་ཀྱིས་ནི་རུས་པ་ལྷག་མར་བྱས་པའོ།",
    "སྡུག་བསྔལ་མཐའ་དག་རྣམས་ནི་བཀག་པར་གྱུར་པ་སྟེ།",
