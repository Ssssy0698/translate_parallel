    "དེ་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་རང་གི་དཀྱིལ་འཁོར་དུ་གསུངས་པ་རྣམས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཞི་བ་མདུང་གིས་མཚན་པ་ལ་སོགས་པའི་དཀྱིལ་འཁོར་གྱི་དེ་ཁོ་ན་ཉིད་སྟོན་པར་བྱེད་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་གསུངས་པ་ནི།",
    "དེ་རྣམས་བྱིན་གྱིས་རློབ་པ་ནི་དེ་བཞིན་གཤེགས་པའི་བདག་ཉིད་དུ་མོས་པ་བསྐྱེད་པས་བདག་ཏུ་འཛིན་པ་ལ་སོགས་པ་དང་བྲལ་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་ལ་ལྷག་པར་མོས་པ་བསྐྱེད་པ་སྟེ།",
    "གང་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དེ་ཉིད་ནི་ཤིན་ཏུ་ཡང་སྐྱེ་བ་མེད་པ་ཡིན་ཏེ།",
    "གཞུང་འདི་དག་གིས་ནི་ཕྱི་རོལ་གྱི་རྡོ་རྗེའི་རིགས་བཞིའི་ཐུན་མོང་གི་དང་པོའི་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་གཞུང་འདི་དག་གིས་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ནོ།",
    "སྒོ་བཞི་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རིམ་པ་རེ་རེ་ཞིང་སོ་སོར་བསྒོ་བཞི་བྲི་ཞིང་།",
    "དེའི་མཚམས་རྣམས་སུ་ནི་མ་མོའི་ཚོགས་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་རིམ་པ་དབུས་མར་རོ།",
    "སློབ་དཔོན་ཐལ་བ་གཙང་མས་ལུས་བསྐུས་ཤིང་གོས་གཙང་མ་བགོས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་དག་གི་བདག་པོ་ཉིད་དང་།",
    "བར་སྣང་གི་གནས་སུ་དཀྱིལ་འཁོར་སྔ་མ་བཞིན་དུ་གཞག་ལ།",
    "གཡུང་དྲུང་གིས་མཚན་པ་འཛིན་པར་བྱའོ།",
    "རིམ་པ་གཉིས་པའི་ཤར་ཕྱོགས་སུ་དྲག་མོ་ལག་ན་མདུང་རྩེ་གསུམ་པ་ཐོགས་པའོ།",
    "ལྷོར་ཚངས་པ་མོ་ལག་ན་བགྲང་ཕྲེང་ཐོགས་པའོ།",
    "ནུབ་ཏུ་ཁྱབ་འཇུག་མོ་ལག་ན་འཁོར་ལོ་ཐོགས་པའོ།",
    "ཤར་ལྷོ་མཚམས་སུ་ནག་མོ་ལག་ན་ཐོད་པ་ཁྲག་དང་བཅས་པ་དང་འཁར་གསིལ་ཐོགས་པའོ།",
    "ལྷོ་ནུབ་མཚམས་སུ་ནག་མོ་ཆེན་མོ་ལག་ན་ཆུ་གྲི་ཐོགས་པའོ།",
    "ནུབ་བྱང་མཚམས་སུ་ཟབ་མོ་ལག་ན་མཆེ་བ་ཐོགས་པའོ།",
    "བྱང་ཤར་མཚམས་སུ་སྲིན་མོ་ལག་ན་ཁ་ཊྭཱཾ་ག་ཐོགས་པ་བྲི་བར་བྱའོ།",
    "ནུབ་ཏུ་གཏུམ་མོ་ལག་ན་བྱ་རྒོད་ཐོགས་པའོ།",
    "མེ་ཏོག་གི་ཡལ་ག་ལས་བུམ་པ་ཐམས་ཅད་དང་བུམ་པ་གང་བ་རྣམས་ཏྲི་ཞེས་བྱ་བ་རེ་རེ་ཞིང་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་ལ།",
    "གོས་དང་བླ་རེ་ལ་སོགས་པ་བསྟབས་ཏེ།",
    "དེ་དག་ལས་གཅིག་གིས་སྨད་གཡོགས་བྱ།",
    "གསུམ་པས་རང་གི་གདོང་གཡོགས་ལ།",
    "ཏྲི་ཞེས་བྱ་བ་ཡོངས་སུ་བཟླས་པའི་ཐལ་བ་གཙང་མས་ལུས་ལ་བྱུགས་ཏེ།",
    "དེ་ནས་དེ་བླངས་ལ་དེ་ཉིད་ཀྱིས་རང་གི་མགོ་ལ་བཅིང་བར་བྱའོ།",
    "དེ་ནས་རྩེ་མོ་གསུམ་གྱིས་མཚན་པ་བཅིངས་ལ།",
    "རང་གི་དངོས་གྲུབ་རྣམས་སྟེར་བར་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་ཏྲི་ཞེས་བྱ་བ་བཟླས་བརྗོད་བྱའོ།",
    "རྡོ་རྗེ་ཐལ་མོ་བསྐོར་བས་ཕྱག་བྱས་ཏེ།",
    "དེ་ལ་དང་པོ་ཁོ་ནར་ཞི་བ་མདུང་གིས་མཚན་པས་ཡོངས་སུ་བཟུང་བའི་མདུང་རྩེ་གསུམ་པ་དང་།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཆེན་པོར་བྱིན་གྱིས་བརླབ་བོ།",
    "དེ་ནི་ཁྱོད་ཀྱིས་བརྙས་མི་བྱ།",
    "རང་གི་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་ཀྱང་མཆོད་ལ།",
    "རང་གི་མིང་བརྗོད་ཅིང་།",
    "ལག་པ་གཡོན་པ་སོར་མོ་དབུས་མ་གསུམ་བསྒྲེང་ལ།",
    "གཡས་པས་ལག་མཐིལ་དུ་སོར་མོ་གསུམ་བསྡུས་ལ་མཐེ་བོ་དང་མཐེ་ཆུང་བརྐྱང་ནས།",
    "མདུད་རྩེ་གསུམ་པའི་མིག་གིས་ཏྲི་དྲཾ་ཤྱ་ཞེས་བྱ་བས་འཁོར་དང་བཅས་པ་བལྟ་བར་བྱས་ལ།",
    "མཐེ་ཆུང་ལྕགས་སྒྲོག་ལྟར་མདུད་རྩེ་གསུམ་པས་མཚན་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དེའི་མཚན་པ་ནི་དེས་དཀྱིལ་འཁོར་གང་ལ་མཚན་པར་བྱས་པ་དེ་ནི་ཞི་བའི་མདུང་གིས་མཚན་པའི་དཀྱིལ་འཁོར་རོ་ཞེས་བྱའོ།",
    "ཕྱི་རོལ་གྱི་རྡོ་རྗེའི་རིགས་ལ་ཕྱག་བྱ་བ་ན་དེ་ལ་དད་པ་ཉིད་ཀྱིས་བྱའི་འཇིག་རྟེན་ལས་འདས་པའི་ལྷ་རྣམས་ལ་ལྷག་པར་མོས་པ་རྣམས་ཀྱིས་ནི་མ་ཡིན་ཏེ།",
    "མ་མོའི་དཀྱིལ་འཁོར་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་དང་པོ་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་ནི་ཞི་བ་མདུང་གིས་མཚན་པའི་དཀྱིལ་འཁོར་ཆེན་པོར་གསུངས་པ་ཉིད་དོ།",
    "རེག་བྱ་རྣམས་ལ་ཉེ་བར་སྤྱོད་པའོ།",
    "ཐམས་ཅད་སྤྱད་པ་ལ་ཡང་སྨད་པ་མེད་དེ་ཞེས་བྱ་བ་ནི་མ་མོ་རྣམས་བསྒྲུབ་པའོ།",
    "ཅེ་སྤྱང་གི་སྒྲ་འདོན་པར་བྱའོ།",
    "ཞུགས་ལ་ཞེས་བྱ་བ་ནི་ཞི་བའི་ཕོ་ཉའི་ཕྱག་རྒྱ་འདིས་མ་མོ་ཐམས་ཅད་དང་།",
    "གདུག་པའི་དམ་ཚིག་ནི་མ་གཏོགས་སོ་ཞེས་བྱ་བ་ནི་གང་གདོན་གྱིས་ཟིན་པ་དེ་ནི་གདུག་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གཞུག་སྟེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་དེ་ལྟར་སློབ་དཔོན་གྱི་རང་གི་ཆོ་ག་རྣམས་རྗེས་སུ་སྤྱད་ལ།",
    "སྲིན་ལག་གི་ཐོད་བ་འཛིན་པ་ལྟ་བུ་ཆུ་འཐུང་བའི་ཕྱག་རྒྱ་སྟེ།",
    "ནག་པོ་ཆེན་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཡིན་ལ།",
    "གང་དཀྱིལ་འཁོར་ལ་སྨོད་པར་བྱེད་པ་དེ་ཡང་ཁྱོད་ཀྱིས་བཟའ་བར་བྱ་བ་དང་།",
    "ཁྱོད་ཀྱིས་རང་གི་སྔགས་རྣམས་བསྟན་པར་མི་བྱ་བ་སྟེ།",
    "མ་མོ་རྣམས་ཀྱིས་རྒྱས་འདེབས་པ།",
    "ཞེས་བྱ་བ་ནི་གང་མ་མོའི་ཚོགས་རྣམས་ཀྱིས་རྒྱས་འདེབས་བའི་ལས་དང་།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་ཁྱོད་འདས་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
