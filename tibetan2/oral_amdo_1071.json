    "མགོ་བོའི་སྟེང་དུ་མཛུབ་༡་མོ་ལྕགས་ཀྱུའི་ཚུལ་དུ་གཞག་པ་ནི་རྡོ་རྗེ་འཇིགས་བྱེད་སྤྱན་གྱི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་མཐེའུ་ཆུང་གཉིས་ལུ་གུ་རྒྱུད་དུ་ཛྲེལ་ལ་མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་སྦྱར་ཏེ་བཟློག་ནས་སྤྱི་གཙུག་ཏུ་གཞག་པ་འདི་ནི་རྡོ་རྗེ་གཙུག་ཏོར་གྱི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོ་གཉིས་སེམས་དཔའི་སྐྱིལ་ཀྲུང་དུ་བྱས་ལ་མཛུབ་མོ་གཉིས་མཉམ་པར་གཞིབས་ཏེ་ཕྱེ་ལ་མཐེའུ་ཆུང་གཉིས་བརྐྱང་ནས་བ་དན་ལྟར་བྱ་བ་ནི་རྡོ་རྗེ་བ་དན་གྱི་ཕྱག་རྒྱའོ།",
    "བྱང་ཕྱོགས་སུ་རྡོ་རྗེ་ནག་མོས་བཅིང་བར་བྱ་སྟེ།",
    "རྡོ་རྗེ་རྩེ་མོས་ལྟོ་བཅིང་བར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རི་བོ་འདེགས་པའི་ཚུལ་དུ་བྱ་བ་ནི་རྡོ་རྗེ་རྩེ་མོའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་ཀྱིས་བསྡིགས་༦སྣཔ་ནི།",
    "དེ་ཉིད་ལས་གུང་མོ་གཉིས་བརྐྱང་བ་ནི་རྡོ་རྗེ་ལས་ཀྱི་ཕྱག་རྒྱའོ།",
    "བཛྲ་བནྟ་བཾ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བླ་རེ་བྱའོ།",
    "རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་བའི་མཚན་ཉིད་ཅན་དེའི་ཕྱག་རྒྱ་ལན་གསུམ་བཟླས་ལ་གཞག་པར་བྱའོ།",
    "སྡོམ་པ་གཟུང་བ་བྱས་ནས་མཉམ་པའི་ཐལ་མོ་དང་།",
    "ཡང་རྡོ་རྗེ་ཐལ་མོ་དང་རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ།",
    "དེ་ནས་རྡོ་རྗེ་འབེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཨོཾ་བུདྷ་རཏྣ་ཧཱུཾ་ཞེས་ལན་གསུམ་བརྗོད་ཅིང་།",
    "དེ་ལྟར་ནོར་བུ་འབེེབས་པའི་བར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "སྐྱིལ་མོ་ཀྲུང་བཅས་ལ་ཏིང་ངེ་འཛིན་མཆོག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "སཾ་ཨ་ཞེས་བྱ་བ་དབྱངས་ཡིག་བཅུ་དྲུག་དང་བཅས་པས་རང་གི་སེམས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་བསམ་པར་བྱའོ།",
    "ཡི་གེ་ཀ་ལ་སོགས་པ་དང་བཅས་པ་ལ་ཟླ་བའི་དཀྱིལ་འཁོར་གཉིས་པར་བསམ་མོ།",
    "དམ་ཚིག་གི་དངོས་གྲུབ་ཀྱི་ཚུལ་ཀྱིས་སྣེའབྲས་བུ་བསྒྲུབ་པ་ཡིན་ནོ་ཞེས་ངེས་པ་བསྐྱེད་ལ་སེམས་བསྐྱེད་པའི་སྦྱོར་བས།",
    "དེ་ནས་དོན་ཐམས་ཅད་གྲུབ་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་ས་མ་ཡ་ཧཾ་ཞེས་བརྗོད་པར་ངབྱའོ།",
    "བདག་ཉིད་དེར་ཇི་ལྟ་བ་བཞིན་དུ་ཞུགས་ལ་མེ་ཏོག་དོར་བའི་༡སྔགས་ཀྱིས་རང་གི་སྤྱི་བོར་མེ་ཏོག་དོར་བར་བྱའོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་དེ་ནམ་མཁའི་དང་མཚུངས་པར་བསམ་མོ།",
    "གཞིའི་ལུས་ཀྱི་རང་གི་གནས་སུ་གནས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱས་བཅོམ་ལྡན་འདས་དེ་བལྟས་ལ།",
    "རང་གི་ལུས་ལས་༩ལུས་ཀྱི་གནས་སུ་གནས་པ་དེ་ཉིད་ལ་བཅུག་ལ་ས་མ་ཡ་སྟེ་ཞེས་བརྗོད་པས་འོད་ཀྱི་དཀྱིལ་འཁོར་ཕབ་སྟེ།",
    "རང་གི་ལུས་ཀྱི་གནས་སུ་ཡིད་ཀྱིས་འདུག་སྟེ།",
    "རང་གི་ལུས་ལས་ཕྱི་རོལ་གྱི་མདུན་དུ་ས་མ་ཡ་ཨ་ཞེས་བྱ་༡བའི་དཀྱིལ་འཁོར་སྤྲུལ་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱས་དེ་ཉིད་དུ་ཛ་ཧཱུཾ་བཾ་ཧོ་ས་རང་གི་ལུས་ལ་གཞུག་པར་བྱའོ།",
    "དམ་ཚིག་གིས་ནི་ཕྱག་རྒྱ་ཆེར།",
    "ནོར་བུའི་མཚན་མའི་གཡོན་ཕྱོགས་སུ་ནོར་བུ་སྒེག་མོ།",
    "ཉིན་རེ་བཞིན་དུ་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ལ་བསྒྲུབ་པར་བྱའོ།",
    "ཨ་མེད་ཊ་དང་མ་ལས་ཉི་ཟླ་དགོད།",
    "དེ་ནས་རྡོ་རྗེ་བསྡམས་པ་ས་ལ་རེག་པར་བྱས་ཏེ།",
    "སཾ་༦ག་ཨ་ཞེས་བྱ་བས་དོན་ཡོད་གྲུབ་པའི་གནས་སུ་ནམ་མཁའ་ལྡིང་གི་གདན་ཏེ།",
    "སླར་ལོག་སྟེ་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་གྱིས་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་ཏེ།",
    "རི་ཨོཾ་བུདྷེ་རཏྣ་ཧཱུཾ་ཞེས་བྱ་བ་ནས།",
    "ལས་ཆེན་མཆོག་གི་ཕྱག་རྒྱ་ཡིས།",
    "དམ་ཚིག་མཆོག་གི་ཕྱག་རྒྱ་དང་།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཨོཾ་བུདྷ་རཏྣ་ཧཱུཾ་དྲྀ་ཤྱ་ཛ་ཧཱུཾ་བཾ་ཧོ།",
    "ཨོཾ་བུདྷེ་རཏྣ་ཞེས་ལན་གསུམ་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རིན་ཆེན་འབེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "དཀྱིལ་འཁོར་ཀྱི་སའི་དབུས་སུ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་འདུག་སྟེ།",
    "བདག་གི་གསོན་པའང་འབྲས་བུར་བཅས།",
    "ལྷ་དང་དམ་ཚིག་གིས་མཉམ་པས།",
    "བདག་གི་མཆོད་སྦྱིན་བླ་ན་མེད།",
    "རེ་བ་ཐམས་ཅད་གྲུབ་པའི་དངོས་གྲུབ་ཀྱི་ཕྱིར་ང་རྒྱལ་བརྟན་པར་བྱས་ཏེ།",
    "དེ་ནས་དོན་ཐམས་ཅད་གྲུབ་པའི་དམ་ཚིག་གི་༥ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཛུབ་མོ་དང་མཐེའུ་ཆུང་རྡོ་རྗེར་མདུད་ནས།",
    "དེ་ནས་ལག་པ་གཡས་པའི་མཐེ་བོས་མཐེའུ་ཆུང་གི་རྩེ་མོ་མནན་ལ།",
    "སོར་མོ་ལྷག་མ་རྣམས་བརྐྱང་ལ།",
    "རང་རང་གི་སྔགས་ཀྱིས་གཞག་པར་བྱའོ།",
    "ཨོཾ་སཛེེ་སཾ་སྠཱ་ར་པ་རི་ཤུདྷེ་དྷཛྲེ་༨ཏེ་ག་ག་ན་ས་མུངྒ་ཏེ་སྭ་བྷཱ་ཚོབ་བི་ཤུདྷེ་མ་ཧཱ་ནཱ་ཡ་པ་རི་བཱ་རེ་སྭཱ་ཧཱ།",
    "དོན་ཐམས་ཅད་གྲུབ་པའི་སྔགས་རེ་རེ་ཞིང་ཡང་བརྒྱ་རྩ་བརྒྱད་བཟླས་ལ།",
    "ཉི་མ་ཤར་བའི་དུས་སུ་དེ་ནས་དཀྱིལ་འཁོར་དེ་དོན་ཐམས་ཅད་གྲུབ་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་ཀྱིས་ནམ་མཁའི་ཕྱོགས་སུ་བཞག་ལ་ཐིག་གདབ་པར་བྱའོ།",
    "དེ་ལ་དང་པོར་རེ་ཞིག་སྔོན་པོ་དང་།",
    "ཧཱུཾ་ཊྭཱཾ་ཏཱི་སྙི་ཨ་ཞེས་བྱ་བ་རང་གི་ས་བོན་ལས་མི་བསྐྱོད་པ་ལ་སོགས་པ་དེ་རྣམས་སྲད་བུ་རྣམས་ལ་བཀོད་དེ།",
    "མིག་གི་རྫི་ཛེེམ་འདྲེན་པ་ནི།",
    "དེ་ནས་རང་གི་ས་བོན་ལས་བྱུང་བའི་འོད་ཟེར་གྱིས་མི་བསྐྱོད་པ་ལ་སོགས་པས་བཏང་བའི་སྲད་བུ་འབར་བའི་ལྕགས་ཀྱུས་བཀུག་སྟེ།་",
    "རང་གི་ལག་ན་གནས་པའི་སྲད་བུ་དེས་གང་བར་བྱས་ལ།",
    "ཕྱི་རོལ་ཀུན་རྔེ་ཏོག་གིས་མཛེས་པར་བྱས་ལ་བར་སྣང་ལ་བཞུགས་པའི་རིགས་ཐམས་ཅད་ལ་མཆོད་ཡོན་ཕུལ་ཏེ།",
    "མེ་ཏོག་ལ་སོགས་པ་དང་སྒེག་མོ་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ལ།",
    "ཛ་ཞེས་བྱ་བས་བསྒྲུབ་པའི་གྲོགས་མཆོག་གི་ལག་ཏུ་སྲད་བུ་དེ་གཏད་བྱེལ།",
    "བསྒྲུབ་པའི་གྲོགས་མཆོག་གིས་སྙེཐིག་སྐུད་དྲང་བར་བྱའོ།",
    "ནང་གི་དཀྱིལ་འཁོར་གྱི་ཐིག་གདབ་པར་བྱ་སྟེ།",
    "སྒོ་སྦངས་པའི་རི་མོ་གཉིས་ཟླུམ་པོར་བྱས་པ།",
    "རི་མོ་གཉིས་ཀྱི་བར་དུ་ལྕུག་མས་མཛེས་པར་བྱས་པ་ཟླུམ་པོ་བྲི་བར་བྱའོ།",
    "ནུབ་ཏུ་འདུག་ལ་བྱང་གི་གདུང་དང་ཀ་བ་གཉིས་ཀྱི་ཐིག་གདབ་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཙི་ཏྲ་ས་མ་ཡ་ཧཱུཾ་ཞེས་བྱ་བ་འདིས་ཕྱག་རྒྱ་དང་ལྡན་པས་རེ་རེ་ཞིང་ཡང་ལན་བདུན་ཀྱི་བར་དུ་བཟླ་བར་བྱའོ།",
    "མཛུབ་མོའི་རྩེ་མོ་མཉམ་སྦྱར་བ།",
    "དེ་ནས་ནང་གི་དཀྱིལ་འཁོར་རི་མོ་ཟླུམ་པོ་གཉིས་བསྐོར་བའི་ནང་དུ་རིན་ངོ་ཆེའི་ལྕུག་མ་བྲི་བར་བྱའོ།",
    "ལྷོ་ཕྱོགས་ཀྱི་ནོར་བུའི་རེའུ་མིག་གི་དབུས་སུ།",
    "ནུབ་ཕྱོགས་ཀྱི་ནོར་བུའི་རེའུ་མིག་གི་དཀྱིལ་འཁོར་གྱེ་དབུས་སུ་བཅོམ་ལྡན་འདས་རིན་ཆེན་པདྨ་འཁོར་དང་བཅས་པ།",
    "བྱང་ཕྱོགས་ཀྱི་ནོར་བུའི་རེའུ་མིག་གི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རིན་ཆེན་ཆར་འབེེབས་འཁོར་དང་བཅས་པ།",
    "རྡོ་རྗེ་སྒེག་མོ་ལ་སོགས་པའི་གནས་རྣམས་སུ་རིན་ཆེན་སྒེག་མོ་ལ་སོགས་པ་རྣམས་ནི།",
    "ཨོཾ་སཏྠ་སཾ་སྭཱ་ཟིར་པ་རི་ཤུསྣེ་དྷཛྲེ་ཏེ་ག་ག་ན་ས་མུངྒ་ཏེ་སྭ་བྷཱ་བ་བི་ཤུརྙེ་མ་ཧཱ་ནཱ་ཡ་པ་རི་བཱ་རེ་སསྭཱ་ཧཱ།",
    "རིན་ཆེན་པདྨའི་ཏིང་ངེ་འཛིན་མཆོག་གི་ཕྱག་རྒྱས་པདྨ་འདབ་མ་བཅུ་དྲུག་པ་ཡིད་བཞིན་གྱི་ནོར་བུས་མཚན་པ་བསྣམས་པའོ།",
    "གཡས་པའི་ཕྱག་གིས་རང་གི་ཐུགས་ཀར་འབྱེད་པའོ།",
    "ནོར་བུའི་འཁོར་ལོ་ནི་ནོར་བུས་མཚན་པའི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་ཕྱག་གཡས་པའི་གུང་མོ་ལ་བསྐོར་བ་དང་།",
    "ཕྱག་གཡས་པ་ནོར་བུས་མཚན་པའི་སྣ་ཚོགས་རྡོ་རྗེ་རང་གི་ཐུགས་ཀར་བསྟོད་པའི་ཚུལ་ཀྱིས་བསྣམས་པའོ།",
    "ནོར་བུའི་ཁུ་ཚུར་ནི་དམ་ཚིག་གི་ནོར་བུའི་ཁུ་ཚུར་གཉིས་ཀྱི་ནང་དུ་ནོར་བུས་མཚན་པའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་བབྱུར་ལྐུཞིང་བཞུགས་པའོ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "རྡོ་རྗེ་ནོར་བུ་ཆེན་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་ལག་པ་གཡས་པའི་རྡོ་རྗེ་ནོར་བུ་ཆེན་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལ།",
    "གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱི་མཛུབ་མོས་ཡང་དང་ཡང་ཆོདྲལ་བར་བྱ་ཞིང་།",
    "རང་གི་སྤྱི་བོར་བཅིང་བ་དང་།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཆེན་པོར་བྱེན་གྱིས་བརླབས་ཏེ།",
    "ཨོཾ་བུདྷེ་རཏྣ་ཧཱུཾ་ཨ་ཞེས་བྱ་བས།",
    "ནོར་བུའི་ཁུ་ཚུར་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱས་སྒོ་རྣམས་བཅད་ལ་ནོར་བུའི་སྲུང་བས་བསྲུང་བ་ཐམས་ཅད་ཡང་དག་པར་བསྲུངས་ཏེ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
