    "ངག་གི་རྣམ་པ་བཞི་རྣམས་དང་།",
    "ཁྱོད་ཀྱིས་བརྙས་པར་མི་བྱ་ཞིང་།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "བདག་གིས་བརྟན་པོར་གཟུང་བར་བགྱི།་།",
    "ཉིན་རེ་ཞིང་ཡང་དུས་དྲུག་ཏུ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་བགྱི་ཞིང་།",
    "བདག་གིས་བྱེསྡོམ་པ་མ་ལུས་གཟུང་།",
    "གང་ཞིག་སྡོམ་པ་འཛིན་པར་མི་བྱེད་པ་དེ་ལ་ནི་འཇུག་པ་ཙམ་ཞིག་བྱེད་དུ་གཞུག་གི།",
    "དམ་པ་བདག་གིས་བསྐྱེད་ནས་སུ།",
    "དེ་ནས་དོན་ཐམས་ཅད་གྲུབ་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "དེ་ལ་དང་པོར་རེ་ཞིག་སློབ་དཔོན་རྡོ་རྗེ་ནོར་བུའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "རིན་ཆེན་ལྕགས་སྒྲོག་གིས་བཅིང་བ་དང་།",
    "ཁྱོད་དམ་ཚིག་ཉམས་པར་གྱུར་ཏ་རེ།",
    "དེ་ནས་རིན་ཆེན་སློབ་དཔོན་རང་ཉིད་ཀྱིས་རིན་ཆེན་ཆོ་ནོར་བུ་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "འདི་རྒོ་ཁྱོད་ཀྱི་རྡོ་རྗེའི་དམ་ཚིག་ཡིན་གྱི་ཞུགལ་ཏེ་འགའ་ཞིག་ལ་སྨྲས་ན་ཀླད་པ་འགས་པར་འགྱུར་རོ།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱིཀྱེ།",
    "དེང་ནས་བརྩམས་ཏེ་ཁྱོད་ཀྱིས་ཕྱག་ན་རྡོ་རྗེ་ང་ཡིན་གྱིས།",
    "ཁྱོད་ཀྱིས་ང་ལ་བརྙས་པར་མ་བྱེད་ཅིག།",
    "འདི་ཁྱོད་ཀྱིས་སུ་ལ་ཡང་མ་བརྗོད་ཅིག།",
    "ཁྱོད་ཚེ་རབས་ཐམས་ཅད་དུ་དབུལ་པོར་གྱུར་ཏ་རེ།",
    "སྡུག་བསྔལ་ལས་མི་འདའ་བར་གྱུར་ཏ་རེ།",
    "དེ་ནས་རིན་ཆེན་སློབ་དཔོན་ཀྱིས་མྱུར་དུ་རྡོ་རྗེ་ནོར་བུ་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་འདི་སྐད་ཅེས་བརྗོད་དུ་གཞུག་གོ་ཏྲེ།",
    "དེ་ལྟར་བབས་པར་གྱུར་ནས་གང་གི་ཚེ་ནོར་བུས་མཚན་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "སློབ་དཔོན་གྱིས་ནོར་བུ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "གང་གི་ཚེ་ནོར་བུ་རྒྱལ་པོའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་ནོར་བུ་གྱེཆགས་པའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་ནོར་བུ་ལེགས་པའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་ནོར་བུ་ཉི་མའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་ནོར་བུ་དབལ་གྱི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་རིན་ཆེན་བཞད་པའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱིས།",
    "དེའི་གཟུགས་སུ་བསྐྱེད་ནས་རྡོ་རྗེ་ནོར་བུའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་གནས་བཞིན་༧བྱིན་གྱིས་བརླབས་ལ།",
    "སྤྱི་གཙུག་ཏུ་རིན་ཆེན་ཆར་འབེེབས་མས་བྱིན་གྱིས་བརླབས་པར་བྱས་ལདེ་ནས་རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིང་ངོ།",
    "དེ་རིང་ཁྱོད་ལ་སྦྱིན་པར་བྱ།",
    "རྡོ་རྗེ་འདི་ནི་ཁྱོད་ཀྱིས་ལོང་།",
    "དེའི་གདན་གྱི་སྟེང་དུ་བླ་རེ་བྱེ་བ་དང་།",
    "རིན་ཆེན་སྒེག་མོ་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ལ།",
    "རིན་ཆེན་སྒེག་མོ་ལ་སོགས་པ་བརྒྱད་ཀྱིས་ཡང་དག་པར་མཆོད་ལ།",
    "བུ་ཁྱོད་ཀྱིས་ནི་མི་ཤེས་པའི།",
    "ཞེས་བྱ་བས་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་རྐང་པ་གཉིས་ཀྱི་བར་དུ་བཞག་ལ་ཤེབཛྲ་བྷཱ་ཥ་རེ་ཞེས་བྱ་བས་ལག་པ་གཡས་སུ་དུང་བྱིན་ནས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཀུན་གཟིགས་དེ་བཞིན་གཤེགས་པ་ཡིན།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཆེན་པོར་བྱིན་གྱིས་བརླབས་ཏེ།",
    "དམ་ཚིག་གི་ནི་ཕྱག་རྒྱ་ཆེར།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
    "བཅོམ་ལྡན་འདས་དང་བཅོམ་ལྡན་འདས་མ་འདི་ལ་བདག་གིས་སྩལ་ཤེལགས་སོ།",
    "དེ་ནས་མེ་ཏོག་དེ་རང་གི་སྤྱི་བོར་གཞག་སྟེ།",
    "བུ་མོ་ཤིན་ཏུ་བརྒྱན་པའམ།",
    "རྟ་མཆོག་གི་ནི་ཡོན་དུ་འགྱུརཌ།",
    "ཨོཾ་འདིར་ནི་ངས་ཁྱོད་ལུང་བསྟན་བྱཉུཉེ།",
    "ཀྱེ་རྡོ་རྗེ་ཆེ་གེ་མོ་ཞེས་བྱ་བ་དེ་བཞིན་གཤེགས་པ་སིརྙི་ས་མ་ཡ་ཊྭཱཾ་བྷུར་བྷུ་སྙབ་སྭཱ་ཧཱ།",
    "ཕྱོགས་གང་དང་གང་ན་གཏེར་ཡོད་པར་རེ་བའི་ཕྱོགས་དེར་བརྐོས་ན་སྣ།",
    "ཞེས་བདེན་པའི་བྱིན་གྱི་རླབས་་བདར་བས་གང་གི་ཚེ།",
    "དམ་ཚིག་གི་ནི་མཆོག་བཅིངས་ལ།",
    "དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "དེར་དམ་ཚིག་གི་ཕྱག་རྒྱ་བབྱུར་ན་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེའི་བྱིན་གྱི་ལྡུ་རླབས་ཀྱིས་ཨ་མྲ་ལ་སོགས་པ་ཡོངས་སུ་སྨིན་པའི་འབྲས་བུ་ཁ་ཕྱེ་བ་བཞིན་དུ་གཏེར་གྱི་ཆར་འབབ་པ་ཐམས་ཅད་བླང་བར་ཐུབསམས་ན།",
    "དེ་ནས་གཏེར་གྱི་གནས་སུ་སོང་ལ་སྔ་མ་བཞིན་དུ་ཆོ་ག་རྗེས་སུ་སྤྱད་དེ་བསྒོམས་ན།",
    "གང་གི་ཚེ་བྱིན་གྱིས་བརླབས་པའི་བར་དུ་བྱས་ན་རང་གི་ལྕེས་ཐམས་ཅད་སྨྲ་བར་འགྱུར་རོ།",
    "དེ་ནས་གཏེར་གྱི་གནས་སུ་སོང་ལ་སྔ་མ་བཞིན་དུ་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་དེ།",
    "དམ་ཚིག་གིས་ནི་ཤེས་པར་འགྱུར།",
    "དེའི་རིགས་ཀྱི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ་ཕྱིས་དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གཏེར་གྱི་གནས་སུ་སོང་ལ་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་ལ།",
    "གཏེར་གྱི་གནས་སུ་སོང་སྟེ་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་ལ།",
    "དེ་ནས་རང་གི་ལྕེས་གང་ན་གཏེར་ཡོད་ཅེས་སྨྲ་བར་འགྱུར་རོ།",
    "གཏེར་གྱི་གནས་སུ་སོང་ནས་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་ལ།",
    "ཇི་སྲིད་དུ་བསྒོམས་པ་དེ་སྲིད་དུ་ལག་པ་གཉིས་ལས་ཡེ་ཤེས་བབས་ནས་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་པ་བཀྲོལ་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ནས།",
    "དེའི་དམ་ཚིག་གི་་ཕྱག་རྒྱ་དང་དེའི་རིགས་ཀྱི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "ཞེས་བྱ་བ་ཡིད་ཀྱིས་བྲིས་ཏེ་སྔ་མ་བཞིན་དུ་བསྒྲུབས་ལ་གཏེར་གྱི་གནས་སུ་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཇི་སྲིད་དུ་བསྒོམས་པ་དེ་སྲིད་དུ་དམ་ཚིག་གི་ཕྱག་རྒྱ་རང་གྲོལ་བར་འགྱུར་རོ།",
    "གཏེར་ཡོད་པའི་གནས་སུ་སོང་ནས།",
    "གང་དང་གང་ན་རེ་བ་ཡོད།",
    "གང་དུ་འཇིག་རྟེན་པ་ཕལ་ཆེ་བས་ཐམས་ཅད་གཏེར་རེ་བར་གྱུར་པ་དེར་ཡོད་པར་འགྱུར་རོ།",
    "གང་ལ་རེ་བར་གྱུར་པ་དེ་ན་གཏེར་ཡོད་པར་འགྱུར་རོ།",
    "དེ་དང་དེའི་རིགས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "འཇིག་རྟེན་ཕལ་ཆེར་རེ་བར་འགྱུར་བ་དེར།",
    "གཏེར་གྱི་གནས་སུ་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་ལ་གཏེར་གྱི་ལྷ་དང་ལྷ་མོའི་གཟུགས་སུ་རྣམ་པར་བསམས་ཏེ།",
    "དེའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ་རིན་ཆེན་ལྟ་བ་དང་དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གཏེར་ཡོད་པའི་གནས་སུ་སོང་ནས་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་ལ།",
    "ཕྱིས་གཏེར་གྱི་གནས་སུ་སོང་ལ་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་ནས།",
    "མདུན་དུ་ལྷ་སྤྱན་དྲངས་ནས་རང་གི་ཕྱག་རྒྱ་བཞི་པོ་རྣམས་ཀྱིས་རྒྱས་བཏབ་ལ་བསྒྲུབ་པ་ན།",
    "འདྲི་ཌམཁན་ཀྱིས་ཧཱུཾཇི་ལྟ་བའི་རི་མོའི་རྗེས་སུ་འབྲངས་ནས་ཇི་ལྟ་བ་བཞིན་ཛྲེ་བའོ།",
    "དེ་གང་གི་ཡིན་ཞེ་ན།",
    "དངོས་གྲུབ་ཟབ་མོ་ཧཱུཾའདི་ལ་མངའ་བས་ན་རབ་གྲུབ་བོ།",
    "གང་གི་ཕྱག་རྒྱ་ཡིན་ཞེ་ན།",
    "ནོར་བུའི་མཚན་མ་དག་གི་ཕྱག་རྒྱ་ཆེན་བོ་དེ་རྣམས་རབ་ཏུ་འགྲུབ་པར་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་ཆེན་པོ་འདི་ཞེས་བྱ་བ་ནི་དོན་ཐམས་ཅད་གྲུབ་པའི་དཀྱིལ་འཁོར་ཆེན་པོའི་དམ་ཚིག་འཛིན་པའི་ཕྱག་རྒྱ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གང་ཡིན་པ་དེ་ནི་ཡེ་ཤེས་སུ་འགྱུར་བའོ།",
    "དེའི་མཚན་ཉིད་ནི་རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་ཧཱུཾགཉིས་བསྙམས་ལ་མཛུབ་༦མོ་གཉིས་བཀུག་པའི་རྩེ་མོ་སྤྲད་པ་ནི་རྡོ་རྗེ་རིན་ཆེན་ཏེ།",
    "མཛུབ་མོ་རྒྱབ་ཏུ་བསྐུམས་ནས།",
    "བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པ་སྤངས་པས་ནམ་མཁའ་དང་མཉམ་པའི་ཡེ་ཤེས་ཐོབ་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཛུབ་མོ་གཉིས་ནོར་བུར་བྱའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་གང་ཡིན་པ་འདི་བཅིངས་ཏེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་གཉིས་བསྒྲེང་ཧཱུཾནས་ཕན་ཚུན་ལྟོ་སྦྱར་ཏེ།",
    "ཨོཾ་བི་ཤྭ་ཟུརཏྣ་ཧཱུཾ་ཞེས་ཟློས་ཤིང་གང་གི་མཚན་མ་ཐོབ་པར་གྱུར་ནས་འགྲུབ་པར་འགྱུར་བ་དེའི་ཚེ་༧སྣ་ཚོགས་སུ་འགྱུར་རོ།",
    "རྡོ་རྗེ་དབྱིངས་མཛུབ་ནོར་མཆོག་གིས།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་དེའི་ནོར་ཀྱི་མཆོག་ནི་རྡོ་རྗེ་རིན་ཆེན་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་བསྙམས་ཏེ་རྒྱབ་བཀུག་ལ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་བསྡམས་པའི་མཛུབ་མོ་གཉིས་མྱུ་གུ་ལྟར་བྱས་ནས་རྒྱབ་བསྐུམས་ཏེ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་བྱུང་བའི་རྡོ་རྗེ་ནོར་བུ་ཆེན་པོ་དམ་ཚིག་གི་ཕྱག་རྒྱ་འདི་ནི་སེམས་མ་རྡོ་རྗེ་མའི་གནས་རྡོ་རྗེ་ནོར་བུའི་ཕྱག་རྒྱའི་ནོར་བུའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཡིན་ནོ།",
    "གུང་མོ་མྱུ་གུ་བསྒྲེང་བས་ནི།",
    "ཞེས་བྱ་བ་ནི་གུང་མོ་མྱུ་གུ་ལྟར་བསྒྲེང་བ་འདི་ནི།",
    "རྡོ་རྗེ་རིན་ཆེན་མྱུ་གུ་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་ནས་གུང་མོ་སྲིན་ལག་དང་།",
    "སྲིན་ལག་དང་མཐེའུ་ཆུང་རྣམས་སོར་མོ་ཕན་ཚུན་གདོང་སྦྱར་ཏེ།",
    "པདྨ་ཁ་བྱེ་བ་བཞིན་དུ་བྱས་པ་འདི་ནི་རྡོ་རྗེ་རིན་ཆེན་པདྨའི་དམ་ཚིག་གི་ཛེེཕྱག་རྒྱའོ།་",
    "མཛུབ་མོ་མཐེ་བོ་མཐེའུ་ཆུང་རྣམས།",
    "ཞེས་བྱ་བ་ནི་ཐལ་མོ་སྦྱར་ལ།",
    "གུང་མོ་དང་མཐེའུ་ཆུང་གཉིས་ནང་དུ་བཅུག་ནས།་",
    "སེན་མོ་གཉིས་ཕན་ཚུན་སྦྱར་བ་འདི་ནི་རྡོ་རྗེ་རིན་ཆེན་ཆར་འབེེབས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དོན་ཐམས་ཅད་གྲུབ་པ་ཞེས་བྱ་བའི་དོན་ཐམས་ཅད་གྲུབ་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གུང་མོ་གཉིས་མྱུ་གུ་ལྟར་བྱས་ཏེ།",
    "རིན་ཆེན་རྒྱལ་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "མཛུབ་མོས་མཛུབ་མོ་བཟུང་༢་ནས་ནི།",
    "ཞེས་བྱ་བ་ནི་གཡས་པའི་མཛུབ་མོས་གཡོན་པའི་མཛུབ་མོ་བཟུང་པྱསྟེ།",
    "གཡས་པའི་མཛུབ་མོས་པྱགཡོན་ལོགས་ནས་འདྲེན་པའི་ཚུལ་དུ་བྱེད་པ་ནི་ནོར་བུ་ཆགས་པའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་དང་མཐེ་བོ་གཉིས་སེ་གོལ་བརྡབས་༨་པའི་ཚུལ་དུ་བྱེད་པ་ནི་ནོར་བུ་ལེགས་པའིའོ།",
    "མཛུབ་གཉིས་རྩེ་མོར་བཀབ་དེ་བཞིན།",
    "མཛུབ་མོ་གཉིས་བསྐུམས་ནས་ཚིགས་གསུམ་པ་ཕན་ཚུན་སྦྱར་ལ།",
    "མཐེ་བོང་གི་གདོང་ལྟ་བའི་ཉུ་སྣཚུལ་དུ་འཛིན་པར་བྱེད་པ་འདི་ནི་ནོར་བུའི་ལྟ་བ་སྟེ།",
    "གཟི་བརྗིད་ཆེན་པོ་རབ་ཏུ་སྦྱིན་པ་འདི་ནི་ནོར་བུ་ཉི་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "རེ་བ་ཐམས་ཅད་རྫོགས་བྱེད་པ།",
    "ཞེས་བྱ་བ་ནི་ནོར་བུའི་དཔལ་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་འགྱིང་བར་བྱེད་ཅིང་དགོད་པའི་ཚུལ་དུ་བསྐོར་ནས་ཁར་འཇོག་པ་འདི་ནི་རིན་ཆེན་བཞད་པའིའོ།",
    "ཞེས་བྱ་བ་ནི་སོར་མོའི་རྩེ་མོ་ཐམས་ཅད་བསྙེམས་སྤྱོལ་ཚིགས་གསུམ་པ་ཅུང་ཟད་ཅིག་བཀུག་པ་ནི་ནོར་བུའི་པདྨ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ནོར་ཏིང་ངེ་འཛིན་གྱེ་སྤྱོར་བས་འགུགས་པར་བྱེད་པ་འདི་ནི་རིན་ཆེན་པདྨའིའོ།",
    "སོར་མོའི་རྩེ་མོ་ཐམས་ཅད་ནོར་བུའི་པདྨ་ལྟ་བུར་བྱས་ནས།",
    "རིན་ཆེན་པདྨའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ལས་མཐེའུ་ཆུང་ནས་བརྩམས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་རིན་ཆེན་པདྨའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ལས།་",
    "མཐེ་བོང་ཚོནང་དུ་བཅུག་ལ་མཛུབ་མོ་གཉིས་ནོར་བུ་ལྟ་བུར་བྱས་ནས་རལ་གྲི་འཛིན་པའི་ཚུལ་དུ་བྱེད་པ་འདི་ནི་ནོར་བུ་རལ་གྲི་ཞེས་བྱ་བ་རིན་ཆེན་སྙེརྣོན་པོའི་འོ།",
    "སུ་དག་གི་ཞེ་ན།",
    "དེ་ཉིད་ཐལ་མོའི་ཚུལ་དུ་བྱས།",
    "ནོར་བུ་འཁོར་ལོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ལས།",
    "ནོར་བུའི་ཐལ་མོ་སྦྱར་ཏེ།",
    "རང་གི་བཀས་ནི་རང་གི་ཚིག་དེ་ནོར་བུ་གསུང་བའི་ཀྱེ་བཀའོ།་།",
    "རང་གི་རིག་པས་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "མཛུབ་མོ་བསྙམས་ཏེ་རྒྱབ་བཀུག་པ།",
    "དེ་བཅིངས་ལ་སོར་མོ་ལྷག་མ་རྣམས་གྱེན་དུ་བརྐྱང་ནས།",
    "ནོར་བུ་ལྟ་བུའི་ཚུལ་གྱིས་བསྐྱོད་པ་དེ་བཞིན་དུ་སོར་མོ་ཐམས་ཅད་ཀྱང་བསྐྱོད་པར་བྱའོ།",
    "སོར་མོ་ཐམས་ཅད་བསྒྲེང་ནས་ནི།",
    "ཞེས་བྱ་བ་འདི་ནི་རིན་ཆེན་ཆར་འབེེབས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཞེས་བྱ་བ་ནི་མཛུབ་མོ་གཉིས་རྡོ་རྗེ་ནོར་བུ་ཆེན་པོར་བྱས་ལ།",
    "སོར་མོ་ལྷག་མ་བརྐྱང་བྱེགདོང་སྦྱར་ནས།་",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཛུབ་མོ་གཉིས་ནོར་བུར་བྱས་ནས།",
    "རང་གི་མགྲིན་པའི་ཕྱོགས་སུ་འཁྱུད་པ་ལྟར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་མཛུབ་མོ་གཉིས་དང་རངགི་མཐེ་བོང་གཉིས་གདོང་སྦྱར་ནས་ལེགས་པར་མནན་ཏེ་བཙིར་བ་ནི་ནོར་བུའི་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྒེག་མོ་ལ་སོགས་པའོ།",
    "དེ་དག་གི་ཡང་།",
    "གུང་མོ་ནོར་བུའི་ཚུལ་བྱ་བར།",
    "ནོར་བུའི་མཚན་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "ཐལ་མོ་སྦྱར་བ་ཁ་ནས་དབྱུང་།",
    "གར་ལ་ཐལ་སྦྱར་སྤྱི་བོར་གཞག།",
    "རང་གི་ཐལ་སྦྱར་གྱེན་དུ་གཏོར།",
    "ཞེས་བྱ་བ་ནི་ནོར་བུ་སྒེག་མོ་ལ་སོགས་པ་ནས།",
    "ནོར་བུའི་དྲི་ཆབ་མ་ལ་མཐར་ཐུག་པའི་བར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།་།",
    "མཛུབ་མོ་གཅིག་ཏུ་བཀུག་པ་དང་།",
    "མཐེ་བོང་མཛུབ་མོ་གདུ་བུར་བཅིང་།",
    "རྡོ་རྗེ་བཅིང་བ་མཛུབ་མོར་བསྡམས།",
    "ཞེས་བྱ་བ་ནི་སྒོ་སྲུང་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "རིན་ཆེན་སྒེག་མོ་ལ་སོགས་པ་རྣམས་ཀྱི་ནི།",
    "གཡོན་པའི་རྡོ་རྗེ་མཛུབ་མོ་ནི།",
    "གཡོན་པ་ལ་ནི་གྲུ་མོ་གཟུགས་པ་ནི་རིན་ཆེན་དཔལ་གྱིའོ།",
    "ཐལ་མོ་འགྲམ་པ་སྤྱི་བོར་ཧཱུཾ་གཞག།",
    "རིན་ཆེན་སྒེག་མོའིའོ།",
    "གར་ལ་ཐལ་སྦྱར་སྤྱི་བོར་གཞག་པ་རུ་ནི།",
    "ཐལ་མོ་སྦྱར་བ་གྱེན་དུ་གཏོར།",
    "མཛུབ་མོ་ལྕགས་ཀྱུ་བཅིང་བ་ནི།",
    "མཛུབ་གཉིས་མདུད་པ་ནི་རིན་ཆེན་ལྕགས་སྒྲོག་གིའོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་ཚིག་གི་ཚོགས་ལ་ཡང་རྟོག་པ་ཆེན་པོ་ཞེས་བྱ་སྟེ།",
    "ཡང་གི་སྒྲ་ནི་ཟློས་པའི་དོན་ཏེ་དོན་ཐམས་ཅད་གྲུབ་པའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལ་ལྟོས་པའོ།",
    "དེ་དག་གི་དམ་ཚིག་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ནོར་བུའི་རིགས་ཆེན་པོའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་རོ།",
    "རྡོ་རྗེ་སྣ་ཚོགས་རྣམས་ཀྱིས་རང་གི་ཕྱག་རྒྱ་གསུངས་པ་ཡིན་ཏེཞུ།",
    "གང་གི་ཕྱིར་ནོར་བུའི་རིགས་ཀྱི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དུ་འཇུག་པ་མེད་ན།"
