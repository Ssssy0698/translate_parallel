    "འོན་ཏེ་སད་ནས་ཡོངས་སུ་ཤེས་པ་ཕྱི་མས་རྣམ་པར་རྟོག་པར་བྱེད་ཀྱི་རྣམ་པར་རྟོག་པར་མི་བྱེད་པ་ནི་མ་ཡིན་ན་ཞེས་བྱ་བས་ལས་དང་འབྲས་བུ་འབྲེལ་བ་བརྡ་ལས་བྱུང་བ་ཉིད་དུ་ཉེ་བར་བཀོད་པས་གང་གསུངས་པ་ཡིན་ནོ།",
    "ཉིན་པར་སྲོག་བཅད་པར་བྱས་པ་གང་ཡིན་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་མཚན་མར་བྱས་ནས་ཞེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "ཡང་དག་པའམ་ཡང་དག་པ་མ་ཡིན་པར་བསྔོས་པ་ཡིན་ཞེས་དྲིས་པ་ནི་བརྩད་པ་ཡིན་ནོ།",
    "ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་ཡིན་ནམ།",
    "དེ་ལྟ་ན་ཡང་འདི་དག་རང་ཉིད་ཀྱིས་མངོན་སུམ་དུ་མ་བྱས་པར་གནས་པ་ཡིན་ནོ།",
    "དེ་མངོན་སུམ་དུ་མ་བྱས་པར་དམ་བཅས་པ་ནི་མངོན་སུམ་དུ་བྱས་པའི་དོན་ལ་དྲི་བ་དེའི་ལན་བཏབ་པ་ཡོངས་སུ་རྫོགས་པའི་ཉེས་པ་སྤང་བའི་དོན་དུ་ཡིན་ཏེ།",
    "ཤཱ་རིའི་བུ་དེ་སྟེ་སྐྱེས་བུ་དེ་སད་ནས་རྣམ་པར་རྟོག་ཅིང་བསད་པར་འདུ་ཤེས་བསྐྱེད་དེ།",
    "ལེགས་པར་བསད་དོ།",
    "ངས་བསད་དོ་སྙམ་དུ་དེ་ལྟར་རྟོགས་ཅིང་གསོད་པར་འདུ་ཤེས་བསྐྱེད་ན་ནི།",
    "ཤཱ་རིའི་བུ་ལས་དེ་སོག་པའམ་ཉེ་བར་སོག་པར་འགྱུར་རོ་ཞེས་པ་ནི་ཀུན་རྫོབ་ལ་བརྟེན་པའི་ལན།",
    "རབ་འབྱོར་གལ་ཏེ་རྨི་ལམ་ན་སྲོག་གཅོད་པ་བྱས་ལ་སད་ནས་ཀྱང་འདི་ལྟར་རྣམ་པར་རྟོག་ཅིང་ཨ་ལ་ལ་བསད་དོ།",
    "ལེགས་པར་བསད་དོ།",
    "ངས་བསད་དོ་སྙམ་དུ་རྣམ་པར་རྟོག་ཅིང་གསོད་པར་འདུ་ཤེས་བསྐྱེད་ན་དེ་བཞིན་དུ་ལས་དེ་སོག་པའམ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་དེ་བཞིན་གཤེགས་པ་ནི་རྟོག་པ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བ་ཡིན་ཏེ།",
    "ཤཱ་རིའི་བུ་དམིགས་པ་མེད་པར་ལས་དང་སེམས་པ་མི་འབྱུང་སྟེ།",
    "ཤཱ་རིའི་བུ་དེ་ལྟ་བས་ན་ལས་དང་སེམས་པ་ནི་དམིགས་པ་དང་བཅས་པར་སྐྱེའི།",
    "བློ་ལ་ལ་ནི་རྣམ་པར་བྱང་བ་ཡོངས་སུ་འཛིན་ཏེ།",
    "དམིགས་པ་མེད་པར་མ་ཡིན་ནོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་ཅིའི་ཕྱིར་སེམས་དམིགས་པ་དང་བཅས་པར་སྐྱེའི།",
    "དམིགས་པ་མེད་པར་མི་སྐྱེ་ཞེས་པ་ནི་ལུང་དང་འགལ་བའི་ཀླན་ཀ།",
    "ཤཱ་རིའི་བུ་མཚན་མར་བྱས་ནས་དམིགས་པ་རྣམས་མེད་བཞིན་དུ་དམིགས་པར་བྱས་ནས།",
    "དམིགས་པ་མེད་པར་ནི་མ་ཡིན་ནོ།",
    "འདུ་བྱེད་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པའང་དབེན་པའོ་ཞེས་བྱ་བ་ནས།",
    "འདིས་དོན་འདིའི་ལན་ལྡོན་པར་འགྱུར་རོ།",
    "རབ་འབྱོར་གང་འདི་སྐད་ཟེར་བ་བྱང་སེམས་ཆེན་པོ་བྱམས་པ་འདི་དོན་འདིའི་ལན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ལྡོན་ནོ་ཞེས་ཟེར།",
    "རྣམ་པར་ཤེས་པའི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ལན་ལྡོན།",
    "ཚེ་དང་ལྡན་པར་རབ་འབྱོར་གང་ཡང་སྐྱེས་པའམ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དོན་དམ་པར་སོག་པའང་ཉེ་བར་སོག་པ་མེད་པ་ཉིད་དོ་ ཞེས་སྨྲས་པ་ནི་ཅི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཀུན་རྫོ་བ་ཏུ་ནི་ལས་དང་འབྲས་བུ་འབྲེལ་པར་འདོད་པའི་ཕྱིར།",
    "ཞེས་བྱ་བས་དཔེ་མ་གྲུབ་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་དེ་སྟེ་སྐྱེས་བུ་དེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེ་ལ་སྦྱོར་བ་ལ་སོགས་པས་རྫོགས་པར་བྱས་པའམ་ལུས་དང་ངག་དང་སེམས་ཉེ་བར་བཅོམ་པས་ཨ་ལ་ལ་བསད་དོ།",
    "ལེགས་པར་བསད་དོ།",
    "ཐམས་ཅད་དུ་བདག་ཉིད་ཀྱི་བྱ་བ་ལ་དམིགས་པས་ངས་བསད་དོ་ཞེས་དོན་གྱི་དབྱེ་བས་བརྗོད་པར་བྱའོ།",
    "རྨི་ལམ་ལ་སོགས་པའི་གནས་སྐབས་སུ་ཡང་ལས་དང་འབྲས་བུ་ཡོད་པར་འདོད་པ་ཡིན་པའི་ཕྱིར།",
    "དགེ་སློང་མ་ཡིན་པ་ལ་སོགས་པའི་ལས་དང་ཉེས་པ་ཡིན་པར་མི་བརྗོད་དེ།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པའི་སྟོབས་ཀྱིས་ལས་རྣམས་གསོས་བཏབ་པ་ཡིན་ན་དེའི་ཚེ་གཉེན་པོའི་ཕྱོགས་སད་པ་ཡིན་ཡང་།",
    "རྣམ་པར་རྟོག་པ་རྗེས་སུ་འཇུག་པས་ན་དེ་བཞིན་གཤེགས་པ་ལ་ཡང་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཉིད་ཀྱིས་ནི་ཉེ་བར་སོག་པར་འགྱུར་ལ།",
    "དེ་ལས་ཀྱང་ལས་ཉེ་བར་སོག་པ་ལ་འབྲས་བུའི་ཁྱད་པར་ཡོད་པས་དེ་བཞིན་གཤེགས་པ་ནི་མ་རྫོགས་པ་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བར་བསམས་པའོ།",
    "གདུལ་བྱའི་སྐྱེ་བོའི་ངོར་དེ་བཞིན་གཤེགས་པ་ལ་ངའི་སྐྱེ་བ་ཟད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་བཞག་པ་ཡིན་གྱི།",
    "ཡང་དག་པར་ན་མ་ཡིན་ནོ་ཞེས་སྨྲས་པ་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་རྟོག་པ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་སོ།",
    "རྟོག་པ་ནི་གཟུགས་ལ་སོགས་པ་རང་དང་སྤྱིའི་མཚན་ཉིད་ཀྱི་བདག་ཉིད་ཅན་རྣམ་པར་རྟོག་པ་མེད་པ་དང་།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་དམིགས་པའི་གནས་སུ་གྱུར་པ་ཡིན་ལ།",
    "དེ་རྣམས་ལ་རྣམ་པར་རྟོག་པ་ནི་དེ་ལ་དམིགས་པའོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་དེ་བཞིན་དུ་དམིགས་པ་མེད་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་སོ།",
    "བློ་ལ་ལ་ནི་རྣམ་པར་བྱང་བ་ལ་ཡོངས་སུ་འཛིན་ཏོ།",
    "དབེན་པར་ཞེས་བྱ་བ་ནི་དམིགས་པའི་དངོས་པོ་དང་བྲལ་བ་ཉིད་ཀྱིས་ན་སྟོང་པ་ཉིད་དུའོ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་དག་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པ་ལ་དམིགས་ནས་སྐྱེ་བ་ཡིན་ནོ་ཞེས་སྨྲས་པ་ནི་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་མཚན་མར་བྱས་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཅི་ལྟར་མཐོང་བ་བཞིན་མཚན་མར་བྱས་ཤིང་སྒྲོ་བཏགས་ནས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བར་དུ་ཡང་ཞེས་བྱ་བ་འདིས་ནི་རྣམ་པར་ཤེས་པའི་རྐྱེན་གྱིས་མིང་དང་གཟུགས་ཞེས་བྱ་བ་ལ་སོགས་པ་བསྡུའོ།",
    "ལན་བཏབ་ཟིན་པའི་དོན་ལ་ཡང་དོགས་པར་བྱེད་ན་མཐའ་ཡས་པས་སེམས་རྣལ་དུ་གནས་པ་སུ་ཞིག་ལན་འདེབས་པར་བྱེད་ཅེས་བྱ་བའི་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཅི་སྦྱིན་པ་དེ་ཡོངས་སུ་བསྔོས་པ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་དྲིས་པའོ།",
    "དེ་ནི་ལན་ལྡོན་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་ཡོད་བཞིན་པ་མ་ཡིན་པའི་ཕྱིར་མཐུ་༢༧གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས།",
    "དོན་དམ་པར་སུས་ཀྱང་སུ་ཡང་བསད་པ་ཡང་མེད།",
    "མ་བླངས་པ་ཡང་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཕྱོགས་ལ་རྒྱུན་འཇུག་པ་དང་འགལ་བའི་དངོས་པོ་སྐྱེ་བ་ལ་གསོད་པ་པོ་ལ་སོགས་པར་རྟོགས་པའི་སྒོ་ནས།",
    "ཇི་ལྟར་ན་བྱང་སེམས་ཆེན་པོ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཡོངས་སུ་རྫོགས་པར་བགྱིད་ཅིང་རྣམ་མཁྱེན་ཉིད་དང་ཉེ་བར་གྱུར་པ་ལགས།",
    "རབ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས།",
    "འདོད་པས་ལོག་པར་གཡེམ་པ་དང་།",
    "ལོག་པར་ལྟ་བ་ཅན་དག་མཐོང་ངམ།",
    "མཚོན་གྱིས་འདེབས་ཤིང་རྡེག་པ་དང་གསོད་པ་དག་མཐོང་ན་འདི་ལྟར་ཡོངས་སུ་བརྟག་པར་བྱ་སྟེ།",
    "ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པ་དང་།",
    "འདུ་ཤེས་མེད་མིན་གྱི་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པ་དང་མི་ལྡན་པ་དག་མཐོང་ན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧འདི་ལྟར་ཡོངས་སུ་བརྟག་པར་བྱ་སྟེ།",
    "རབ་འབྱོར་དེ་ལྟར་སྤྱོད་པའི་བྱང་སེམས་ཆེན་པོ་ནི་ཡུམ་ཡོངས་སུ་རྫོགས་པར་བྱེད།",
    "དེ་དག་དག་པར་སྒྲུབ་པ་ཡིས།",
    "ས་ཆེན་པོ་འདི་གཞི་བེཌཱུརྱ་སྔོན་པོའི་རྒྱུ་ལས་གྲུབ་པ་གསེར་གྱི་བྱེ་མ་བདལ་བར་གྱུར་པ་དེ་ལྟ་དེ་ལྟར་ཕྱིན་དྲུག་ལ་སྤྱད་པར་བྱའོ།",
    "རབ་འབྱོར་དེ་ལྟར་སྤྱོད་པའི་བྱང་སེམས་ཆེན་པོ་ནི་ཕྱིན་དྲུག་ཀྱང་ཡོངས་སུ་རྫོགས་པར་བྱེད།",
    "རྣམ་མཁྱེན་ཉིད་དང་ཡང་ཉེ་བར་གྱུར་པ་ཡིན་ནོ་ཞེས་པའི་དོན།",
    "དེ་དག་དག་པར་སྒྲུབ་པ་ཡིས།",
    "ཡུམ་ལ་སྤྱོད་པའི་བྱང་སེམས་ཆེན་པོས་ཇི་ལྟར་སྟོང་པ་ཉིད་དང་མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པ་ལ་ཡོངས་སུ་འདྲིས་པར་བགྱི།",
    "སྟོང་པ་ཉིད་དང་མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་པར་བགྱི།",
    "ཡོངས་སུ་འདྲིས་པར་བྱའོ་སྙམ་དུ་སོ་སོར་རྟོག་སྟེ་འདི་ནི་མངོན་དུ་བྱ་བའི་དུས་མ་ཡིན་གྱི་ཡོངས་སུ་འདྲིས་པར་བྱ་བའི་དུས་ཡིན་ནོ་སྙམ་དུ་སོ་སོར་རྟོག་གོ།",
    "བྱང་སེམས་ཆེན་པོ་ནི་མཉམ་པར་མ་གཞག་པ་ཉིད་སེམས་དམིགས་པ་ལ་འདོགས་ཏེ།",
    "འདི་ནི་རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་ཐོབ་པར་བྱ་བ་ཡོངས་སུ་མི་གཏོང་བའི་དུས་སོ་ཞེས་བྱ་བར་བརྟག་པར་བྱ་སྟེ།",
    "སྨོན་པ་མེད་པ་ལ་ཡོངས་སུ་འདྲིས་པར་བྱེད་ཅིང་སྨོན་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "བཏང་སྙོམས་སུ་དམིགས་པའི་སེམས་ཀྱིས་ཁྱབ་པར་བྱས་ནས་གནས་ཏེ།",
    "སྨོན་པ་མེད་པ་ལ་གནས་ཤིང་རྣམ་མཁྱེན་ཉིད་ལ་ཡོངས་སུ་འདྲིས་པར་བྱེད་དོ།",
    "དེའི་སྐབས་སུ་བྱང་སེམས་ཆེན་པོ་མཚན་མས་ཀྱང་རྣམ་པར་མི་སྤྱོད།",
    "ནམ་མཁའ་བར་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧སྣང་ལ་གནས་ཀྱང་དེ་ལ་གནས་པ་མེད་དོ།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་བྱང་སེམས་ཆེན་པོ་ཡང་སྟོང་པ་ཉིད་དང་མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པ་ཡོངས་སུ་འདྲིས་པར་བྱེད་སྟོང་པ་ཉིད་དང་མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པ་ལ་ཡང་གནས་ཤིང་རྣམ་པར་སྤྱོད་དེ།",
    "ཇི་སྲིད་དུ་རྣམ་མཁྱེན་ཉིད་མ་ཐོབ་ཀྱི་བར་དུ་བར་མ་དོར་ཡང་དག་པའི་མཐའ་མངོན་དུ་མི་བྱེད་པར་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "ནང་སྟོང་པ་ཉིད་ནས་དངོས་པོ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་དང་།",
    "རབ་འབྱོར་གཞན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧་རིང་པོ་ཡང་བྱང་སེམས་ཆེན་པོ་ཡུམ་ལ་སྤྱོད་པའི་ཚེ་འདི་སྙམ་དུ།",
    "ད་དེ་ཡོངས་སུ་འདྲིས་པར་བྱས་ནས།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧དེ་ནི་འདི་ལྟར་ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོའི་ཡོངས་སུ་འདྲིས་པར་བྱ་བ་དེ་བརྗོད་དོ།",
    "ཡོངས་སུ་སྦྱང་བ་མ་ལགས་པའི་ས་ལ་གནས་པ་བཞིན་དུ་ལན་འདེབས་པ་ནི་ཉུང་ངོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་ནི་རྣམ་པ་སོ་སོར་ངེས་པའི་ཡུལ་ཅན་ཡིན་ཏེ།",
    "བྱ་བ་འདི་ནི་ཁྱད་པར་ཡིན་ནོ།",
    "ཡང་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་དུ་རྣམ་པར་བཞག་པ་ནི་མཚན་ཉིད་པ་ཡིན་ལ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་དེ་ལྟར་མ་ཡིན་ཏེ།",
    "རང་བཞིན་གྱིས་ཞི་བའི་རྣམ་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་ནི་ཁྱད་པར་གཞན་ཡིན་ནོ།",
    "རབ་འབྱོར་འདི་ནི་ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོའི་ཕྱིར་མི་ལྡོག་པའི་མཚན་ཉིད་དུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་འདི་ནི་ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོའི་ཕྱིར་མི་ལྡོག་པའི་རྟགས་སུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "ཕ་ཤི་བ་ལ་སོགས་པ་མཐོང་ན་མྱ་ངན་དང་འཇིགས་པ་དང་བྲེད་པ་དང་ཀུན་ཏུ་སྐྲག་པར་མི་འགྱུར་ཏེ།",
    "མི་དངངས་ཀུན་ཏུ་སྐྲག་པར་མི་འགྱུར་ཀུན་ཏུ་སྐྲག་པས་ཟིན་པར་མི་འགྱུར་ཏེ།",
    "རབ་འབྱོར་འདི་ཡང་ཕྱིར་མི་ལྡོག་པའི་མཚན་ཉིད་དུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་འདི་ཡང་ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོའི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཕྱིར་མི་ལྡོག་པའི་མཚན་ཉིད་དུ་རིག་པར་བྱའོ་ཞེས་ཤིན་ཏུ་གོམས་པའི་ཕྱིར་རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡང་།",
    "རབ་འབྱོར་རྣམ་པ་དང་རྟགས་དང་མཚན་མ་དེ་དག་དང་ལྡན་པའི་བྱང་སེམས་ཆེན་པོའི་ཕྱིར་མི་ལྡོག་པར་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "ཤིན་ཏུ་གོམས་པའི་ཕྱིར་རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡང་གནོད་བྱེད་ལ་སོགས་པ་མི་མ་ཡིན་པ་རྙེད་པར་བྱེད་པའི་བདེན་པའི་ཚིག་གྲུབ་པ་དང་།",
    "དགའ་བ་དང་བཏང་སྙོམས་བསྐྱེད་པར་བྱའོ།",
    "དེས་སེམས་འདི་ལྟར་བསྐྱེད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་སྐྱེས་ན་ཡང་མྱུར་དུ་སྤང་བར་བྱའོ་ཞེས་བསླབ་པར་བྱ་སྟེ།",
    "རབ་འབྱོར་དེ་བས་ན་བྱང་སེམས་ཆེན་པོ་གཞན་གྱི་དྲིང་མི་འཇོག་པར་བྱ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཡུམ་གྱི་མཚན་ཉིད་ཇི་ལྟ་བུ་ལགས།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་ལ་མི་སྤྱོད་དོ།",
    "དེ་ལྟར་རྟགས་ཀྱིས་མཚོན་པའི་རྣམ་པར་འཕེལ་བ་རྣམ་པ་དུ་ཞིག་ཡོད་ཅེ་ན།",
    "རྣམ་པར་འཇོག་པ་དང་རབ་ཏུ་འཇོག་པ་དང་།",
    "གསལ་བར་བྱེད་པ་དང་ཡང་དག་པར་སྟོན་པ་དང་།",
    "དེའི་རྒྱུས་སྡུག་བསྔལ་དང་ཡིད་མི་བདེ་བ་ཆེན་པོ་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ན་རྟག་ཏུ་བདེ་བ་དང་ཡིད་བདེ་བ་མང་པོ་དང་ལྡན་པར་འགྱུར་རོ་ཞེས་སོགས་ཀྱི་དོན།",
    "ཁྱད་པར་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིད་ལ་བྱེད་པ་དང་།",
    "གལ་ཏེ་ཡུམ་རང་བཞིན་གྱིས་དབེན་ཞིང་སྟོང་པ་ལགས་ན།",
    "རབ་འབྱོར་བྱང་སེམས་ཆེན་པོའི་ཡུམ་ལ་ཡང་དག་པར་བསྒྲུབས་ཀྱང་རྣམ་པར་འཕེལ་བའམ་ཡོངས་སུ་འགྲིབ་པ་མེད་དེ།",
    "རབ་འབྱོར་འདི་ལྟར་བྱང་སེམས་ཆེན་པོ་ཡུམ་ལ་སྤྱོད་པ་ལ་རྣམ་པར་རྟོག་པ་དེ་ཐམས་ཅད་མེད་པའི་ཕྱིར་ཏེ།",
    "རབ་འབྱོར་ཡུམ་ནི་རྣམ་པར་མི་རྟོག་པའོ་ཞེས་པའི་དོན།",
    "སྐྱེན་པར་སློབས་ཤིག།",
    "དེ་བཞིན་དུ་གནས་གཙང་མའི་རིས་ཀྱི་བར་གྱི་ལྷ་རྣམས་ཀྱང་ཉེ་བར་འདོང་པར་སེམས་སོ།",
    "ཅི་བྱང་སེམས་ཆེན་པོ་འདི་ཡང་དག་པའི་མཐའ་མངོན་དུ་བྱས་ཏེ་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ནས།",
    "དཔེར་ན་སྟོན་པ་དང་ཇི་ལྟར་གནས་པ་དེ་བཞིན་དུ་གནས་པར་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཅི་ལགས།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དུ་བསམ་པར་བགྱི་བ་དང་།",
    "མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན་རྣམ་མཁྱེན་ཉིད་དུ་སློབ་པ་ལགས་སམ།",
    "གནས་བརྟན་རབ་འབྱོར་གྱིས་གང་འདི་སྐད་དུ་གཟུགས་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན་རྣམ་མཁྱེན་ཉིད་དུ་སློབ་པ་ཡིན་ནམ་ཞེས་པ་ནས།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དུ་ཟད་པར་བྱ་བ་དང་།",
    "འགག་པར་བྱ་བ་དང་།",
    "མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན་རྣམ་མཁྱེན་ཉིད་དུ་སློབ་པ་ཡིན་ནམ་ཞེས་སྨྲས་པ་དེ་ནི་མ་ཡིན་ནོ།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་གྱི་དེ་བཞིན་ཉིད་གང་ཡིན་པ་དེ་ཟད་པའམ་སྤང་པའམ་སྐྱེ་བའམ་འགག་པར་འགྱུར་བ་མེད་དེ།",
    "རབ་འབྱོར་དེ་ལྟར་སློབ་པའི་བྱང་སེམས་ཆེན་པོ་དེ་ནི་དེ་བཞིན་ཉིད་ལ་སློབ་པ་སྟེ་རྣམ་མཁྱེན་ཉིད་ལ་སློབ་པ་ཡིན།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་ལ་སློབ་པ་ཡིན།",
    "དེ་ལྟར་སློབ་པའི་བྱང་སེམས་ཆེན་པོ་ནི་བསླབ་པ་ཐམས་ཅད་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོབ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་སོགས་ཀྱི་དོན།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོར་འགྱུར་བའི་ལས་ཡང་དག་པར་བླངས་ཏེ་གནས་པ་དེ་ལྟ་བུ་ནི་ཉུང་སྟེ།",
    "རབ་འབྱོར་དེ་བས་ན་བྱང་སེམས་ཆེན་པོ་ཕྱིར་མི་ལྡོག་པའི་ས་ཐོབ་པར་འདོད་པ་དང་།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དང་ལྡན་པའི་སེམས་མི་སྐྱེའོ།",
