    "དེས་ན་རྣམ་པར་རྟོག་པ་བསྲུང་བས་ན་བསྲུང་བའི་དམ་ཚིག་གོ།",
    "ལྟེ་བའི་ནང་དུ་ངལ་བསོ་བ་ནི་སྣ་ཚོགས་མདུད་པར་འཁྱིལ་པའོ།",
    "རྐྱང་མ་མི་བསྐྱོད་འབབ་ཅེས་གསུངས་པ་དང་མི་འགལ་ལམ་ཞེ་ན།",
    "མགྲིན་པར་ངལ་བསོ་བ་ནི་སུམ་སྐོར་དུ་གྱུར་པའོ།",
    "ཀ་ལ་སོགས་པས་བསྐོར་ཏེ་མ་ལུ་ནིང་མ་གཏོགས་ཏེ་མ་ནི་ལུ་ནིང་དེ་རྣམས་ལ་ཐིག་ལེ་བྱས་ཏེ་གནས་སོ་ཞེས་གསུང་ངོ།",
    "ཞུ་བདེ་ལ་བརྟེན་པའི་སྐུ་གསུམ་བསྟན་པའི་ཕྱིར་གང་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུ་པ་དེ་ནུབ་པར་འགྱུར་བའི་ཚེ་སྟེ་བྷ་གའི་ནང་དུ་ཐིག་ལེ་ལྷུང་བ་ན་བདེ་བ་བྲལ་བའོ།",
    "རྙོག་པ་མེད་པ་ནི་དེའི་རྣམ་པར་ཤེས་པ་ཟླ་བ་ལྔའི་བར་དུ་བརྒྱལ་ཏེ།",
    "ལོངས་སྐུ་ནུབ་པར་གྱུར་པ་ནི་མཆོག་དགའ་དགའ་བྲལ་དུ་ནི་འཕོས་པའོ།",
    "དེ་ནས་གང་ཚེ་ལོངས་སྤྱོད་རྫོགས་པ་ནུབ་སྟེ་བྷ་ག་ཞེས་ལྟེ་བའི་སྣ་ཚོགས་མདུད་པར་སླེབ་པ་དེའི་ཚེ་ལུས་ཐམས་ཅད་ལ་ཁྱབ་ཅིང་སྤྲུལ་པས་སྤྲུལ་པའི་སྐུའོ།",
    "ཞེས་གསུང་ངོ་ འདིའང་ལུས་གཏན་ལ་དབབ་པའི་སྐབས་ཡིན་གྱི་ལམ་ལ་མ་ཡིན་ཡང་ལམ་དུ་བྱས་པ་ན་འདི་ལྟར་འགྱུར་ཞེས་བྱ་བ་ལ་འགལ་བ་མེད་དོ།",
    "མཁའ་འགྲོ་ལེའུ་བཅོ་ལྔ་པ་ལས་གསུངས་པ་དང་ཆ་མཐུན་ནོ།",
    "དེ་དག་བཅོམ་ལྡན་འདས་ཀྱི་སྔར་གསུངས་པ་ནི་ཕྱི་རོལ་དུ་ལམ་སྣ་ཚོགས་གསུངས་པ་ཡིན་ལ།",
    "དེ་རྣམས་ཀྱང་ནང་དུ་ལུས་སུ་ཐམས་ཅད་བསྡུ་བའང་གསུངས་ན་ཞེས་བྱའོ།",
    "བསྐྱེད་པའི་རིམ་པའི་སྡོམ་པའང་གསུངས་ན།",
    "མཚན་མ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་སྡོམ་པའོ།",
    "དེ་ལ་དང་པོ་ནི་བོལླའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དེ་ལ་བསླབ་པར་བྱ་བའི་ཐབས་མང་པོ་འདིར་འདུས་ན་ཐབས་དང་ཤེས་རབ་ཀྱི་སྙོམས་པར་འཇུག་པ་དེ་འདིར་ཇི་ལྟར་འདུས་སྙམ་པ་ལ་བོལླ་ནི་རྩ་ཨ་ཝ་དྷཱུ་ཏཱིའོ།",
    "དེ་བས་ན་བདེ་སྟོང་ཟུང་དུ་ཆུད་པ་ནི་སྙོམས་པར་འཇུག་པ་ཡིན་གྱི།",
    "ཕྱི་རོལ་གྱི་གཉིས་གཉིས་ལ་མི་ལྟོས་སོ་ ཡང་ན་རྩ་དང་དེའི་བདེ་བ་སྙོམས་པར་འཇུག་པའོ།",
    "ཨེ་ཝྃ་རྣམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཤློ་ཀ་གཉིས་གསུངས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁུ་བ་ཞེས་བྱ་རྣམ་པར་གནས་ཏེ།",
    "ཇི་ལྟ་བ་དང་ཇི་སྙེད་པ་མཁྱེན་པའི་ཡེ་ཤེས་དང་ལྡན་པའི་སྐུའོ།",
    "དེ་ཐམས་ཅད་རང་ཉིད་ལ་ལྡན་པར་བསྟན་པའི་ཕྱིར་ཁུ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དབྱིངས་དང་ཡེ་ཤེས་དབྱེར་མེད་པ་དང་མཚུངས་པ་འདི་ཉིད་ཀྱང་མཚུངས་པར་བསྟན་པ་ནི།",
    "མཆོག་ཏུ་ངོ་མཚར་བར་གྱུར་ཅིང་བརྒྱལ་བ་དང་སྐྲག་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་རོ།",
    "གལ་ཏེ་རྣལ་འབྱོར་མ་རྣམས་ཐེ་ཚོམ་སྐྱེས་ན་རྣལ་འབྱོར་མ་རྣམས་ཐ་མལ་པར་མི་འགྱུར་རམ་ཞེ་ན།",
    "ལམ་ལ་ཐེ་ཚོམ་སྐྱེས་པར་ཡང་མི་རིགས་སྙམ་ན།",
    "དང་པོ་ནི་དེ་ནས་བཅོམ་ལྡན་འདས་ཐམས་ཅད་མཁྱེན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའང་སྤང་བྱ་དང་དངོས་སུ་འགལ་བ་ནི་ཡེ་ཤེས་མ་སྐྱེས་པས་བསྟེན་པར་མི་ནུས་ལ།",
    "ཡིད་ནི་རྡོ་རྗེ་སེམས་དཔར་འགྱུར།",
    "དེ་རྣམས་དེ་བཞིན་གཤེགས་པ་ཡིན་པས་གཉེན་པོར་རིགས་པར་བསྟན་པ་དང་།",
    "དེ་ལ་རིགས་བསམ་གྱིས་མི་ཁྱབ་པར་དབྱེ་བས་སྤང་བྱ་བསམ་གྱིས་མི་ཁྱབ་པའི་གཉེན་པོར་བསྟན་པའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་གསང་སྔགས་ཀྱི་ལམ་སྤྱིའི་རྣམ་པར་བཞག་པ་ལྟར།",
    "དྲིས་པའི་དོན་ནི་རིགས་བསམ་གྱི་མི་ཁྱབ་པས་སྤང་བྱ་ཡང་བསམ་གྱི་མི་ཁྱབ་པའི་གཉེན་པོར་འགྱུར་བ་ལྟ་ལགས་ན།",
    "སྟོབས་བཅུ་མངའ་བའི་ལྷ་ནི་ལྷ་སྟེ་ལུས་ལས་བྱུང་བའོ།",
    "དེ་བཞེངས་ཤིག་པ་ནི་ཐིག་ལེ་དེ་བསྐྱེད་པར་གྱིས་ཤིག་པའོ།",
    "རིགས་བསམ་གྱིས་མི་ཁྱབ་པར་ཤེས་པས་སྤང་བྱ་བསམ་གྱིས་མི་ཁྱབ་པ་སྤོང་ལ་དེས་ཡེ་ཤེས་བསམ་གྱི་མི་ཁྱབ་པ་བསྐྱེད་པ་ནི་རྫུ་འཕྲུལ་གྱི་སྟོབས་སོ།",
    "དེ་བས་ན་རིགས་ཀྱི་བུ་ཁྱེད་ལྟར་ཤེས་པར་གྱིས་ཤིག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "མཉན་པར་གདམས་པ་དང་།",
    "ཞེས་ཏེ་ཞུ་བདེ་གཉི་ག་ཕྱག་རྒྱའི་འབད་རྩོལ་ལ་མ་ལྟོས་པར་བྱུང་བས་སོ།",
    "དེ་ལྟར་གྲུབ་པ་དེ་གཅིག་པ་དེའི་ཕྱིར་ལྷན་སྐྱེས་ཀྱི་རང་བཞིན་ཨྃ་དུ་གནས་པས་གཟུགས་ཅན་མའོ་ ཡང་ན་དེའི་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་པ་དེའི་ཤེས་རབ་ནི་བསྟེན་པར་བྱ་བས་ལྟེ་བའོ།",
    "དེའང་འདི་ལྟར་ཤེས་པར་བྱ་སྟེ་སྔར་བསྟན་པའི་ཚུལ་གྱིས་ཐམས་ཅད་ལུས་ལ་གཏན་ལ་ཕབ་པ་ཞེས་པར་བྱས་ལ།",
    "གོང་རབ་ཏུ་བྱེད་པ་གཉིས་པར།",
    "དགའ་བ་དེ་ནས་བསྐྱེད་པར་བྱ་སྟེ།",
    "སྔ་མ་བཞིན་དུ་སྟེ་དེའི་ཤེས་རབ་ལྷན་ཅིག་སྐྱེས་ཞེས་པས་དེ་ཉིད་དུ་བདེ་དྲོད་གསལ་སྟོང་དུ་སྐྱེ་པ་ནི་གནས་པར་གྱུར་པ་སྟེ།",
    "དེ་ལ་བརྟེན་ཏེ་སྐྱེས་པའི་ཡེ་ཤེས་ཀྱི་མཚན་ཉིད་རྒྱས་པར་བསྟན་པ་སྟེ་མཐའ་དག་ཀྱང་དཔྱིད་དེ་བདེ་བ་ཁ་འབུ་བའམ།",
    "དེ་ལའང་ལས་ཀྱི་ཚོགས་གཙོར་སྟོན་པར་བྱེད་པ་ནི་བརྟག་པ་བདུན་པ་ཡིན་ལ།",
    "དེ་ལ་དང་པོ་ངག་དང་ཡི་གེའི་བརྡ་ནས་བཅུད་ཀྱི་ཡེ་ཤེས་ཀྱི་བར་ཡེ་ཤེས་དགུ་པོ་སྟོན་པ་རབ་ཏུ་བྱེད་པ་དང་པོས་བརྗོད་པར་བྱ་བའི་དོན་ནི་གང་།",
    "སྤྱོད་པའི་ཡན་ལག་ཏུ་བྱས་ན་སྤྱོད་པ་དང་ཡང་འབྲེལ་ལོ།"
  ]
