    "ཆུ་བོ་ཆེན་པོའི་རྒྱུན་བཟློག་འགྱུར་གསུམ་པའི་ཏིང་ངེ་འཛིན་ནི་རྗེས་སུ་མཐུན་པར་སྦྱར་ཏོ།",
    "དེས་ན་ཏིང་འཛིན་ཁྱད་པར་ཡང་།",
    "དོན་གཙོ་བོ་ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་ཡང་།",
    "ཏིང་ངེ་འཛིན་གྱི་རྩལ་འཕང་ཁྱད་པར་ཅན་བསམ་པའི་ཡུལ་སྣ་ཚོགས་ཏེ་མི་གཅིག་པར་བསྒོམས་པའི་དོན་ཏོ།",
    "འོད་ཟེར་འབར་འཕྲོ་གསལ་བ་ལས་ཡབ་ཡུམ་ཡི་གེ་ཟུང་སྒྲིལ་དུ་ཆེན་གསལ་བར་བྱས་ནས་འཕྲོ་འདུ་གནས་སུ་སླར་འདུ་ནས་ནང་དུ་ཙིཏྟའི་དཀྱིལ་དུ་རྩ་བའི་ཡི་གེ་ལ་བསྟིམས་ནས་བྱིན་གསལ་བར་བསྐྱེད་པའོ།",
    "བསླབ་པར་སྦྱོར་བའི་རྣལ་འབྱོར་དང་ངེས་པའི་རྣལ་འབྱོར་བཞི་ནི།",
    "འཕྲོ་མཉིས་འདུ་དྲི་མནམ་སྣའི་ཡུལ་ཚུན་ཆད་དུ་གསལ་ཏེབྱ་བའི་ཐབས་ཀུན་རྗེས་སུ་མཐུན་པར་འགྲེལ་ཏོ།",
    "དེ་བཞིན་རྣལ་འབྱོར་རིམ་པ་བཅོསཔ་བཞིན་། ལྷ་ཡི་ཁྱད་པར་གང་ཡིན་པ།",
    "ཡི་གེའི་རིམ་པ་བཞིན་བྱས་ནས།",
    "ས་དྲུག་པ་རྟེན་པས་ཁྱད་པར་འགྲོ་བའི་ས་ལཆེན་དབུགས་ཆེན་འབྱིན་པའི་རྣལ་འབྱོར་པ་དང་།",
    "རིག་པར་སྦྱོར་བའི་རྣལ་འབྱོར་པ་དང་བདུན་ནི།",
    "དེ་ལྟར་རིམ་པར་རིག་པའི་སེམས་ཉིད་རྩལ་སྦྱངས་པས་སྒྲིབ་པའི་དྲི་མ་རགས་པ་ནས་རིམ་པར་དག་འགྱུར་སྔ་བདུན་པས་དེ་ཉིད་ཏིང་ངེ་འཛིན་གསལ་ཞིང་གོམས་པ་འཕྲོ་འདུ་ལས།",
    "དུས་གསུམ་རྒྱུན་མེད་མི་འཆད་པར་མཇལ་བ་ཉིད་དོ།",
    "དེ་ཉིད་ཡེ་ནས་ཡིན་པར་ཐག་ཆོད་པཔས་གཞན་དུ་མི་ཚོལ་བས་ཤེས་རབ་རང་རིག་མུ་མཐའ་བྲལ་བ་ལསཐབས་དེ་ཉིད་ཡེ་ཤེས་སུ་འགྱུར་བརྒྱད་སྔ་མ་འགགས་པར་རང་གསལ་བ་དུས་གསུམ་དུ་གཉིས་སུ་མེད་པར་སྦྱོར་བས་མཇལ་བ་ཉིད་དོ།",
    "རྒྱལ་བ་བཞུགས་པ་འདི་ལྟར་རིགས།",
    "རྣ་བ་ལ་བརྟེན་ནས་སྒྲ་ངེས་པར་ཆོད་པ་ཐོས།",
    "ནམ་མཁའ་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "རྒྱ་མཚོ་རྡོ་རྗེས་གཏམས་བྱས་ཏེ།",
    "དེ་མ་ཐག་པར་མ་གྱུར་ཀྱང་།",
    "ཐམས་ཅད་འདི་ཡིས་བྱེད་པར་འགྱུར།",
    "རིག་འཛིན་འགྲོ་བའི་ལུས་ཅན་ཀུན་དེ་ཁོ་ན་ཉིད་ཀྱི་ཉམས་དྲོད་དྲུག་རྙེད་པར་མ་ཉིས་བརྒྱགྱུར་པའོ།",
    "ཅེས་པ་དག་གཏན་ཚིགས་ཀྱིས་ཡིད་ཆེས་པར་བྱ་བ་ནི།",
    "ཞེས་པ་ལ་སོགས་པ་དོན་གྱི་མན་ངག་དང་ལྡན་པའི་དམིགས་མེད་ནརྣམ་པར་དཀར་བ་རིལ་ཤབ་ཟབ་ཧུའགྲེལ་། ལ་འབད་ཀྱང་ལྷ་མི་ཙམ་ཐོབ་ཀྱང་རྒྱལ་བའི་གོ་འཕང་ཐོབ་པར་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "གང་དེ་ཟིན་པར་མ་ཤེས་ན།",
    "གཞན་ནས་ཚོལ་བའི་སེམས་བྲལ་བས་སྤྱོད་ཡུལ་རྒྱལ་བའི་ཞིང་ཁམས་ཡང་དག་པའི་ས་མ་བགྲོད་པར་ནོན་པས་དོན་ཆེན་པོའོ།",
    "འདིར་རྟོགས་ན་འབད་པའང་བྱར་མེད་པའི་ཐབས་ཁྱད་པར་ཅན་ལ་ངོ་བོ་ངེས་པར་བཟུང་བས་ཐག་ལྟ་བས་བཅད་པ་འདྲེ་བར་མི་འདུས་འགྱུར་ཏྲེ་བཅུ་ཉིད་དོ།",
    "དེ་བས་ན་རིམ་སློབ་ཚད་དུ་ཕྱིན་པ་དང་ཅིག་ཅར་བའི་ཡུལ་བས་གང་ཟག་གཉིས་ཀའི་བསླབ་པར་བརྒྱུད་པ་དང་མངོན་སུམ་པའི་སྒོ་ནས་འགྱུར་རོ།",
    "གྲོས་ཀྱིས་ཆོད་པར་བྱ་བ་དང་།",
    "འོ་ན་སྐྱོན་དུ་དགག་གོ་ཞེ་ནགལ་ཏེ་བྱས་ནའང་དགག་པ་མེད།",
    "བཀའ་བརྒྱ་ཞེས་པ་དག་བྱས་ནའང་དགག་བྱའང་མེད་པའི་ཕྱིར་རོ།",
    "ངོ་བོ་ལྷན་པ་མེད་པའི་དོན་ཏེ་རིག་ཅིང་རྟོགས་པར་མི་འགྱུར་བའོ།",
    "དེ་ལྟར་རང་རིག་པས་གཏིང་མཇལ་བས་དོན་ཆེན་མ་བསྒྲུབ་པར་གྲུབ་མ་བཙལ་བར་མ་ཆེན་ཡེངས་རྣལ་འབྱོར་མ་འབད་པར་ཉལ་ཐོབ་པའི་ཐབས་ཆེན་པོ་ནི་ཐབས་བཙུན་དམ་པར་གྱུར་པའོ།",
    "དེས་གང་འདོད་པའི་དོན་མཆོག་འབྲས་བུ་དཱཀའ་བ་ཚེགས་མེད་པར་འགྲུབ་པའོ།",
    "དོན་ངེས་པར་བསྒྲུབ་པའི་ལེའུ་ཞེས་པ་མཚན་བསྟན་པའོ།",
    "དམ་པ་རྣམས་ཀྱིས་གསུངས་པའི་ཚིག།",
    "འདིའི་དོན་འཕྲད་ཅིང་རྟོགས་ཆེན་པར་རྙེད་དཀའ་བར་གསུངས་པའོ།",
    "ཞེས་པ་དག་ཐ་སྙད་རིལ་དེ་ཁོ་ན་ཉིད་དུ་གཅིག་པ་ལ་སོ་སོའི་རིས་སུ་འབྱེད་པ་དང་བྲལ་བས་མཚན་ཉིད་སོ་སོར་མི་ཕྱེད་པར་རང་འགྱུར་སྔ་བརྒྱད་གསལ་བའི་ཡེ་ཤེས་ནི་གཏི་མུག་ཆེན་པོའོ།",
    "ངོ་བོ་སྣ་ཚོགས་ཐ་དད་མི་མཐུན་པ་མང་པོ་མཐའ་ཡས་རིལ་གྱི་རང་བཞིན་འཕྲལ་དུ་མ་བཅོས་མ་བྱས་པར་དེ་བཞིན་ཁོ་ན་ཉིད་དུ་ཡེ་དག་པས་མ་བསྒྲིབས་འོད་གསལརྒྱལ་བའི་ཆེན་ཁམས་རྣམ་པར་དག་པའང་དེ་བཞིན་ཉིད་ཞིང་ཡིན་པའོ།",
    "ཞེས་པ་དག་དངོས་པོ་ཀུན་ཏུ་རིལ་མ་འགགས་ཧུ་། པར་རང་ཤར་བ་སྣང་བའི་ཡེ་ཤེས་འདི་ནི་སུས་ཀྱང་མ་བྱས་རང་བྱུང་གེ་ཡེ་ཤེས་ཏེ་རིལ་དེ་འདི་ཉིད་དོ།",
    "ཞེས་པ་དག་དེ་བཞིན་ཉིད་མུ་མཐའ་དང་བྲལ་བའི་དབྱིངས་ཉིད་ངང་དུ་རིལ་གསལ་བ་ལ་སྔ་ཕྱིའི་རྒྱུད་གསུམ་དང་བཞི་མ་ཧུ་། འགགས་ལ་མ་དམིགས་མ་གྲུབ་པའི་དོན་ཡེ་ཤེས་ཇི་ལྟ་བར་རིག་པའི་ངོ་བོར་རང་གསལ་ཁྱད་པར་བ་ལསདུས་སྐད་ཅིག་དང་བསྐལ་པའི་ཡུན་དང་།",
    "དེས་དེ་བཞིན་ཉིད་མུ་མཐའ་མེད་པ་གང་གནས་ཉིད་རྒྱལ་བའི་ཞིང་ཁམས་རྣམ་པར་དག་པ་ཡོན་ཏན་ལྷུན་གྱིས་གྲུབ་པ་ཉིད་རིན་ཆེན་སྤྲིན་ཡིན་པས་དེ་ཉིད་མ་འདུས་བགྲོད་པར་ཕྱིན་པ་ཁོ་ནའོ།",
    "ཞེས་པ་དག་རྒྱལ་བ་རིལ་དེ་བཞིན་ཉིད་ཀྱི་ངང་ལ་མ་འདྲེས་ལ་ཡོངས་སུ་བཅོསཔ་རྫོགས་པར་བཞུགས་པས།",
    "ངོ་བོ་དེ་བཞིན་གཅིག་དུ་མ་ལས་གྲོལ་བའི་ཚུལ་དུ་བཞུགས་པས་དེ་བཞིན་ཉིད་དང་ཐ་དད་མེད་པས་གཞལ་ཡས་ཁང་དམ་ཉིད་དོ།",
    "ཞེས་པ་དག་སེམས་ཆེན་ཀྱི་དེ་བཞིན་ཉིད་དུ་དཔག་ཅིང་མཐའི་ཚད་བྲལ་བས་གནས་ཀྱི་མིང་གྲུབ་པས་བཞུགས་གནས་དམ་པ་སྟེརྒྱལ་བ་དཔག་མེད་རིལ་ཆེད་དུ་མ་བཀོད་པར་ལྷུན་གྱིས་བཞུགས་པའི་གནས་ལྕི་། སོ་ སྤྲིན་གྱི་དཔལ་གྱི་དགོངས་པ་ནི།",
    "དྲྭ་བ་ཤེས་བྱ་དང་ལྟ་བའི་སྒྲིབ་པ་མ་ཤེས་མ་རིག་པའི་ཆར་གཏོགས་པ་དེ་གཅོད་འཇོམས་པར་བྱེད་དོ།",
    "ཡང་དག་པའི་ས་ལ་ངེས་པར་འབྱུང་ལ་མ་རག་པའོ།",
    "སྤོས་ཀྱི་རྒྱལ་པོས་གསུངས་པ།",
    "དེ་གཉིས་མ་འགགས་ལ་དབྱེར་མེད་པར་རྟོགས་ཤེས་པ་ཉིད།",
    "མིན་པ་ལས་ཡིན་པར་བསྒྱུར་བ་མེད་པའོ།",
    "རིན་ཆེན་རྒྱལ་པོས་གསུངས་པ།",
    "འོད་ཟེར་དཔལ་གྱི་གསུངས་པ།",
    "དཀའ་ཐུབ་རྒྱལ་པོས་གསུངས་པ།",
    "བསྒོམ་བྱ་སྒོམ་བྱེད་མེད་པར་དེ་བཞིན་དེ་ཉིད་རང་གསལ་བ་ཅིར་ཡང་མི་རྟོག་པ་འདུས་ཉིད་འབྲས་བུ་ཡིན་པས་དེ་ལས་བསྒྲུབ་བྱའི་འབྲས་བུ་དང་དོན་དུ་གཉེར་བ་བསྒྲུབ་པ་ག་ལ་ཡོད་གཞན་མེད་དོ།",
    "དེ་ལྟ་འགྲོ་འོང་མེད་སྤྲོས་པ་ཉིད་ལྷུན་གྲུབ་ཀྱི་གསུང་ཡིན་པས་བྲག་ཅ་ལྟར་འགྲོ་འོང་མེད་པར་སྤྲོས་མེད་ཀུན་ལ་དོན་སོ་སོར་གསལ་ཞིང་ཁྱབ་ལངོ་བོ་ཉིད་བརྗོད་པ་ཆེན་དང་བྲལ་བས་གསུང་མེད་པར་གདུལ་བྱའི་དོན་ཀུན་གྲུབ་པས་རྒྱ་ཆེན་པོའི་གསུང་བཤད།",
    "བདེ་བ་ཆེན་པོའི་ངོ་བོ་ཉིད་ཀྱིས་གསུངས་པཐམས་ཅད་ཡུལ་ལ་འཇུག་པ་ཡི། ། ཐོགས་མེད་མ་ཆགས་དེ་བཞིན་བློ།",
    "ཞེས་པ་དག་རྒྱལ་བ་རིལ་ཇི་བཞིན་པའི་ངང་དུ་བཞུགས་པས།",
    "འདུས་བཅོསཔ་སྒྲ་དབྱངས་མི་ཟད་པས་གསུངས་པ།",
    "གསེར་འོད་འཕྲོ་བས་གསུངས་པརྡུལ་ཕྲན་གཅིག་ཙམ་གང་ཟག་ལ།",
    "བཀོད་པའི་རྒྱལ་པོས་གསུངས་པ།",
    "གསུང་གཅིག་མི་ཟད་བསམ་ཡས་གསུངས།",
    "དེ་ཉིད་མཐའ་གསུམ་དང་དབུས་མ་སྤུངས་བྲལ་བཞིན་བདལ་བ་ཀུན་ཏུ་ཁྱབ་ལ་ཆེད་དུ་བྱས་པ་ཁྱབ་དང་ཁྱབ་མེད་དེ་སྤྲོས་དང་བྲལ་བ་རྡོ་རྗེའི་གསུང་ངོ།",
    "དཔལ་གྱི་རྒྱལ་པོས་གསུངས་པ།",
