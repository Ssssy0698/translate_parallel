    "སྲིད་དང་སྲིད་མིན་རྣམས་སུ་སྨོན་པ་མེད་པར་གྱིས།",
    "སྒྱུ་མ་དང་མཚངས་༢འཇིག་རྟེན་འདི་ནི་ཤེས་བྱས་ནས།",
    "རྟོག་པ་མེད་ཅིང་ཞི་ལ་བདེན་ཞིང་ཆགས་མེད་པར་། སེམས་ནི་སྙོམས་ཤིང་༥མཚན་མ་མེད་པ་བསྙེན་༦པར་གྱིས།",
    "ཆགས་པ་རྣམ་པར་བསལ་ནས་ཁྱད་པར་འཕགས་པར་གཤེགས།",
    "འབྱུང་པོ་རྣམས་ནི་འཇིག་རྟེན་ན་དེས་བྱས་པ་ཉིད།",
    "ལས་འབྲས་མེད་པར་འགྱུར་ཞིང་ལུང་༡༧ནི་བྱས་མིན་ལ་། ལས་ཀྱི་སྦྱོར་བ་རྣམས་ནི་དེ་ཡི་རྟེན་༡༧ཡིན་ན།",
    "རྣམ་པར་འགལ་བ་རྣམ་པ་དུ་མ་མཐོང་བ་སྟེ།",
    "སླར་ཡང་རབ་ཏུ་ཆགས་པར་འགྱུར་བ་ཉིད་ཡིན་ན་ནོ།",
    "འབྲས་མི་རྫོགས་པར་བྱེད་པ་པོ་ནི་གཅིག་པ་ཉིད།",
    "ཐམས་ཅད་ལས་ནི་ཐམས་ཅད་རྒྱུན་མི་འཆད་༤པར་འགྱུར།",
    "རྟག་པའི་རྒྱུ་ལས་ཁྱད་པར་འགྱུར་བ་མ་ཡིན་ཕྱིར་༦།",
    "དེ་ཕྱིར་རྟོགས་པར་བྱ་བ་རྒྱུ་ནི་གཞན་ཉིད་ད་དོ།",
    "ནུས་པར་གྱུར་པའི་སྦྱོར་ལ་ཤིན་ཏུ་མཐར་ཐུག་པའི།",
    "དེ་ཕྱིར་རང་བཞིན་གྱིས་ནི་སྐྱེད་པར་རིགས་མ་ཡིན།",
    "སེམས་དང་རྣམ་པར་བྲལ་བའི་རྒྱུ་རྣམས་དག་ལས་ནི།",
    "གང་ཕྱིར་སྐྱེ་དགུ་རྣམས་ཀྱི་མཐའ་ནི་བྱས་མིན་ཏེ།",
    "དེ་ཕྱིར་འཇིག་རྟེན་རྒྱུན་ཆད་མེད་པར་སྐྱེ་བར་འགྱུར།",
    "གང་ཞིག་ཡོན་ཏན་རྣམས་ཀྱི་གཅིག་དང་དུ་མས་བྱས།",
    "གལ་ཏེ་རྒྱུ་གཅིག་ཉིད་དུ་གནས་པར་གྱུར་པ་ན།",
    "དེ་ཡང་ཐ་དད་ཁྱད་པར་གྱུར་པ་༐",
    "གང་ཕྱིར་རྒྱུ་ནི་ཁྱད་པར་མིན་པ་འདོད་པ་སྟེ།",
    "སྟོང་པའི་རྫས་རྣམས་སུ་ཡང་ངེས་པར་གྱུར་པ་ཉིད།",
    "དེ་ཡི་རྗེས་སུ་དཔག་པ་ངེས་པར་གྲུབ་མ་ཡིན།",
    "དེ་ལྟར་རང་བཞིན་གྱི་ནི་རྣམ་འགྱུར་ཁྱད་པར་འཕགས།",
    "འབྲས་བུ་ཁྱད་པར་ཡིན་ཞིང་རྒྱུ་ཡི་མ་ཡིན་ཏེ།",
    "སྡུག་བསྔལ་མི་འདོད་སུ་ཡིས་སྡུག་བསྔལ་བྱེད་པར་འགྱུར།",
    "གལ་ཏེ་འཇིག་རྟེན་དག་ན་སྐྱེས་བུ་བྱེད་པར་གྱུར།",
    "འདོད་པ་བྱེད་པར་འདོད་ཀྱང་མི་འདོད་བྱེད་པ་སྟེ།",
    "མི་ཡི་བྱེད་པ་ཡིས་ནི་མེད་པར་འགྱུར་བ་སྟེ།",
    "ཐམས་ཅད་ཀྱིས་ནི་ཐམས་ཅད་ངེས་པར་འཐོབ་བྱེད་ཅི་ང་།",
    "གཡོ་བ་མེད་པའི་བློ་གྲོས་ངེས་པར་རབ་དང་བས།",
    "དགྲ་བཅོམ་རབ་ཏུ་གཞེས་པར་མཛད་པར་འོས་པ་ལགས།",
    "རྣམ་པར་གྲོལ་བའི་སེམས་ནི་རྣམ་པར་མཁྱེན་ནས་ནི།",
    "ཆགས་པ་མེད་པའི་བློ་མངའ་བློ་གྲོས་མཁྱེན་པ་ཡིས།",
    "དེ་ཡི་དོན་དེ་འཚིག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཡུལ་རྣམས་ཡང་དག་ལོངས་སྤྱོད་པར་ནི་ཤེས་པ་ཉིད།",
    "དུས་སུ་སྨོད་ལ་དོན་ནི་རྣམ་པར་གཏོང་བ་ད་ང་།",
    "དཔལ་དང་ང་རྒྱལ་ལས་ནི་དེ་བཞིན་གཡུལ་འགྱེད་པར།",
    "སྙན་པ་ད་ང་ནི་དམ་པར་གྲགས་པ་རབ་ཏུ་འཐོབ།",
    "མི་ཡི་འཇིག་རྟེན་ན་དང་ལྷ་ན་སྐྱེས་པ་རྣམས་། གཏོང་བ་ལས་དང་མཉམ་པ་རྣམས་ལས་ལྷག་པར་འགྱུར་༡།",
    "འབྲས་བུ་དེ་ནི་གཙོ་བོ་ཐོབ་པར་འགྱུར་བའོ།",
    "སྡོམ་པར་གྱུར་པ་རབ་ཏུ་སྦྱིན་པ་ཡིན་པ་ཉིད།",
    "ཡིད་ནི་རབ་ཏུ་དགའ་ལས་ངེས་པར་ཏིང་འཛིན་ཡིན།",
    "མཉམ་པར་གཞག་ན་ཡང་དག་མཐོ་བ་འདི་རུ་ནི།",
    "སྐྱེ་དང་འགོད་པ་ཤེས་པར་རིམ་གྱིས་འགྱུར་བ་སྟེ།",
    "དེ་ཕྱིར་ཞེ་སྡང་དང་ནི་ང་རྒྱལ་སྤངས་པར་གྱུར་། རབ་ཏུ་ལེན་པ་པོ་ནི་བདེ་ལྡན་རྣམས་མཐོང་ནས།",
    "དེ་ཕྱིར་ཁྱད་པར་དུ་ནི་ཁྱིམ་ན་གནས་རྣམས་ཀྱིས།",
    "བཟའ་བ་རབ་ཏུ་སྦྱིན་པར་སྟོབས་ནི་རབ་སྟེར་ཞིང་།",
    "གང་ཞིག་ཡང་དག་བསྒྲུབས་མཛོད་འདོད་པ་ཚིམ་པར་ཤོག།",
    "དགའ་བ་བྱས་པ་དང་ཡང་གཞུག་པ་བྱས་པ་ནི།",
    "ཚལ་དེ་ལ་ནི་རིན་བྱས་ཤེས་ནི་མངོན་འདོད་ད་དོ།",
    "དྲག་ཏུ་མུན་པར་གྱུར་ཅིང་རྣམ་པར་ཟློས་པ་ཉིད།",
    "རང་གནས་རྣམ་པ་དང་བྲལ་ཉེ་བར་ཉེར་བཞུགས་པ།",
    "རྒྱལ་པོའི་བསམ་པ་འདི་ནི་རྣམ་པར་མཁྱེན་ནས་དང་།",
    "མཁའ་ལ་གང་ཞིག་འབར་དང་འབར་བས་མཛེས་པར་གྱུར།",
    "ཉི་མ་གཉིས་པ་བཞིན་དུ་མཁའ་ལ་བཞུགས་ནས་ས་སུ།",
    "ཡིད་ཀྱིས་༧རབ་ཏུ་ཞི་ལ་འབད་པར་བྱ་བ་སྟེ།",
    "མཆོག་ཏུ་བདེ་བའི་དོན་དུ་གང་གྱུར་བསྙེན་པར་བྱ་། རྒྱུ་སྐར་འཁོར་ལོ་མཁའ་ལ་བཞིན་དུ་རྟག་པར་ནི།",
    "དེ་ལས་རྒྱལ་ན་རྣམ་པར་རྒྱལ་བ་གཞལ་དུ་མེད།",
    "ཞིང་དུ་བྱས་པའི་སེམས་ལ་དགའ་བ་སྐྱེས་པ་སྟེ།",
    "ངེས་པར་ལེགས་པ་འདི་དང་ཁྱེད་ཀྱིས་ལྷག་པར་ཐོབ།",
    "སྲས་ལ་དེ་ཉིད་ཁོང་དུ་ཆུད་ཕྱིར་ཕྱག་བྱས་ས་སོ།",
    "ཐུབ་པའི་མཐུ་ནི་ལྷག་པར་ཐོབ་པ་མཐོང་ནས་དང་།",
    "ཆགས་པ་མེད་པར་རྒྱལ་སྲིད་སྤུན་ཟླ་ལ་བྱིན་ཞིང་།",
    "སྒོ་རྣམས་ད་ང་ནི་སྐར་ཁུང་རྣམས་ལ་མཉམ་པར་བརྟེན།",
    "ལེགས་སྐྱེས་དབུ་ནི་བཞར་བར་རྣམ་པར་མཛད་ནས་ད་ང་།",
    "སྲས་པོ་རྣམ་པར་དུལ་བ་བལྟ་བའི་ཕྱིཕྱིར་༐",
    "འགྲམ་པར་ཏ་མ་ལ་ཡི་ལོ་མ་རྣམ་༢བཀོད་པའི།",
    "ས་སྐྱོང་བདག་སྐྱེས་རྣམས་ཀྱི་དགྲ་རྣམས་ཟད་པར་༤དང་།",
    "རྒྱལ་པོའི་མནའ་མ་ངེས་པར་མྱ་ངན་འཛིན་མ་འོ།",
    "ཐོས་ནས་ཀྱང་ནི་གནས་ཤིང་ཉམས་པར་འགྲོ་བ་མེད།",
    "འདི་ཡི་གཟུགས་ནི་ངེས་པར་རྗེས་སུ་མཐུན་པ་དང་།",
    "ཞི་བས་ལྡན་ཞིང་ཡུལ་རྣམས་ཀྱིས་ནི་རྣམ་པར་བྲལ།",
    "སྣ་ཚོགས་སྟོན་ནི་རང་༡མཚུངས་བསམ་པ་ཡང་དག་ཡོངས་བཟུང་ནས་། དེ་སྐད་ཅེས་སོགས་རབ་མྱོས་མ་རྣམས་མང་པོ་རྣམ་པར་ལ་བས།",
    "སྤྱོད་པ་འདི་ཡིས་ཡང་དག་ཚིམ་པ་མ་ཡིན་དགེ་སྦྱོང་སྐྱེ་བོ་བསམ་པ་མ་ཐུལ་བ་ལ་བརྟེན་པར་༢མཛད་བཞེད་ལ།",
    "འཇིག་རྟེན་དག་ན་སྐྱིད་དེ་བ་ཞེས་རྒོལ་བ་ནུབ་པར་མཛད་བཞེད་དེ་བཞིན་ཡོངས་སུ་བྲིས་ཉིད་སྟོན་པར་མཛད་བཞེད་པ། ༐",
    "རྒྱགས་པར་མ་འགྲོ་དགའ་མིན་མི་༩བཟོད་མ་ཉན་ཅིག།",
    "ཆེ་བའི་བདག་ཉིད་ཐོབ་ནས་ཞི་ལམ་ཐོབ་པར་གྱིས།",
    "ལས་དེ་ཉིད་ནི་སླར་ཡང་བྱེད་པར་༢འོས་པ་སྟེ།",
    "ཡིད་གཞུངས་ལྡན་པ་འདི་དང་བྱེད་པ་བྱས་པ་ཉིད།",
    "འབྲས་བུ་གང་ཞིག་མཐོང་བས་ས་བོན་བསྐྲུན་༤པར་བྱེད།",
    "དེ་ཕྱིར་ཕུང་པོ་བཞི་པོ་དེ་རྣམས་ཤེས་བྱས་ནས།",
    "མ་བྱས་པ་ཡི་འོང་བ་འགྲུབ་པ་ཡོད་མ་ཡིན།",
    "མ་བྱས་པ་ཡང་བརྒྱ་ལ་བྱེད་པ་མ་ཡིན་ཞིང་།",
    "མ་བྱས་པ་ནི་གཞན་དུ་དགེ་ལེགས་འགྱུར་མ་ཡིན།",
    "རབ་ཏུ་རྒྱས་པ་རྣམས་དང་ངེས་པར་ཟུམ་པ་རྣམས།",
    "འབྱུང་པོ་འཛིན་པའི་ས་ཡང་ཟད་པར་འགྲོ་བ་སྟེ།",
    "འཇིག་པའི་མེས་ནི་ལྷུན་པོ་དེ་བཞིན་སྲེག་པར་བྱེད།",
    "རྒྱ་མཚོ་ཆེན་པོ་ཡོངས་སུ་བསྐམས་པར་འགྲོ་བ་སྟེ།",
    "འཇིག་རྟེན་གདུངས་ནས་ཀྱང་ནི་ཉི་མ་ནུབ་པར་འགྲོ།",
    "དེ་ཡིས་འདིར་ནི་ཉིན་ཞག་འགའ་ཞིག་བཞུགས་ནས་ས་སུ།",
    "མེ་ཏོག་རབ་རྒྱས་མྱ་ངན་མེད་པས་གསལ་བྱས་ཤིང་།",
    "རབ་ཏུ་བཏུད་ཅིང་གདན་བྱས་ཚིག་འདི་གསོལ་བའོ།",
    "ཉེ་བར་འཚེ་བྱས་ཡུལ་ནི་སྐལ་བ་མེད་པའ་མ།",
    "རང་བཞིན་རྣམ་པར་སྤངས་ནས་གསེར་དུ་འགྱུར་བའོ།",
    "ཕུར་བུ་གསུམ་པའི་ཁྱིམ་ལྟར་ལྟ་ན་མཛེས་པར་གྱུར།",
    "དེ་ཡི་བསམ་པ་ཡང་དག་བསྐུལ་བ་ཐུབ་པས་གསུངས།",
    "འཕགས་མིན་གྱིས་བསྙེན་ཁྲོ་བ་འཛིན་པར་མ་བྱེད་ཅིག།",
    "ངེས་པར་ལྟུང་ན་ས་གཞི་བག་མེད་འགྱུར་བའོ།",
    "སྡུག་བསྔལ་རྣམ་པར་འཇོམས་མིན་གང་དེ་ཡེ་ཤེས་མིན།",
    "སྲིད་པར་གྱུར་ན་ལུས་མེད་ཉིད་ལ་ཡིན་པ་སྟེ།",
