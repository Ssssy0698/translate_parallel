    "དེ་ཡང་ཐོག་མར་ཐང་ཆེན་པོ་དམར་ལམ་མེ་བ་གཅིག་འདུག་སྙམ་ཕྱིན་པས་མེ་མ་མུར་གྱི་འོབས་ལ་རྐང་པའི་ལོང་བུ་མན་ནུབ་པ་དང་།",
    "ཞེས་སོགས་གསུངས་འདུག་པ་སོམས་དང་།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "ཅེས་གསུངས་པར་གདའ།",
    "སྐྱབས་སུ་མཆིའོ་ཟེར་ཙ་ན་ཕྱག་ཡུལ་གྱི་ཐུགས་རྗེ་བསྐྱལ་བར་བསམ་ལ།",
    "ངེས་པར་བདག་ལ་བར་ཆད་བྱེད་པའི་གདུག་པ་ཅན་ཞིག་འདུག་གོ་སྙམ་སྟེ།",
    "ད་རྩོད་པ་བྱས་པས་ནི་ཕན་ཐོགས་པར་མི་འདུག་སྒྲུབ་པ་ཁོ་ན་བྱ་ཡིས་དགོངས་ཏེ།",
    "སླར་ཡང་རྨི་ལམ་བཟུང་སྟེ་སློབ་དཔོན་པདྨའི་དྲུང་དུ་བྱོན་པས་སློབ་དཔོན་གྱིས་ད་རུང་འཁོར་ལོ་བྱིན་མི་འདུག་གསུངས་པས།",
    "རྒྱ་གར་ལྷོ་ཕྱོགས་ཀྱི་གྲུབ་ཐོབ་དངུལ་ཆུ་བེ་རོ་ཙ་ན་ལ་གདམས་པ་དངོས་སུ་གནང་།",
    "ཁོང་བོད་དུ་བྱོན་ནས་གཏེར་དུ་སྦས་པ་ཞྭ་ནག་ཅོད་པཎ་འཛིན་པའི་ཐོག་མ་མི་མཆོག་དུས་གསུམ་མཁྱེན་པས་གཏེར་ནས་བཏོན་ཏེ།",
    "བགྲངས་པས་ཤི་འདུག་པ་མ་ལེགས།",
    "ཞེས་གསུང་འབྱོན་དགོས་འབྱུང་འདུག་པས་སོ།",
    "རྣམ་རིགས་པའི་ལུགས་སྒྲ་ཇི་བཞིན་པར་བཀྲལ་བ་དང་མཐུན་འདུག་པས་བསྙོན་པར་ག་ལ་ནུས།",
    "མེད་པར་ལྟ་བའི་ཆད་ལྟ་གཉིས་ཆར་ལ་གནས་པར་མི་བྱ་ཞེས་པ་ཙམ་ཞིག་བསྟན་འདུག་པའི་ཕྱིར་རོ།",
    "ལུང་དེས་དེ་ལྟར་བསྟན་འདུག་པའི་ཕྱིར་རོ།",
    "ཕུང་པོ་ཀྶྱེ་འཇིག་དང་བཅས་པར་མཐོང་འདུག་པའི་ཕྱིར་རོ།",
    "གནས་ལུགས་མཐོང་ཚུལ་གྱི་བྱེ་བྲག་དབྱེ་བའམ་རིམ་པ་མང་དུ་ཕྱེ་འདུག་པའི་ཕྱིར་དང་།",
    "རྟག་འཛིན་དང་འཛིན་སྟངས་འགལ་བའི་གཉེན་པོ་མི་རྟག་གོ་སྙམ་པའི་འཛིན་སྟངས་མ་བྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "ཡང་རང་ཕྱོགས་ཀྱི་མཁས་པ་འགའ་ཞིག་རྒྱུད་བླའི།",
    "འཁུན་ཡང་རང་ཉིད་འཇོམས་པའི་ལྟས་སུ་ལོག།",
    "ཡང་རང་གཞན་གྱི་ཆེན་པོ་འགའ་ཞིག་གཟུང་འཛིན་གཉིས་བྲལ་གྱི་ཡེ་ཤེས།",
    "ཅལ་དེ་ཅི་འདྲ་ཞིག་འདུག་དེ་སྐད་སུ་ཟེར་ཞེས་རིམ་བཞིན་དེད་པས།",
    "ཅིར་ཡང་སྟོན་པའི་གཟུགས་ཀྱིས་ཁ་དོག་བཞི་དང་ལྡན་ཏེ་འདུག་པའི་ཆ་ལུགས་ཀྱིས་ཅོད་པན་ལྔ་དང་ལྡན་ཏེ།",
    "བཛྲ་ལོ་ཙ་ན་མཧཱ་ཌཱ་ཀི་ནི་དྷཀ་དྷཀ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "རཏྣ་ལོ་ཙ་ན་ཌཱ་ཀི་ནི་པ་ཙ་པ་ཙ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཀརྨ་ལོ་ཙ་ན་མཧཱ་ཌཱ་ཀི་ནི་ཚིན་ྡྷཚིན་ྡྷ།",
    "ཕྱི་ཡི་དཀྱིལ་འཁོར་ས་ལ་འདུག།",
    "གདན་སར་ངོས་ཕེབས་ནན་ཆགས་ཀྱི་བསླབ་དོན་འདུག་ཀྱང་།",
    "འགག་གྲོང་གཞིས་ཀར་སྤྱན་འདྲེན་ཕེབས་བསུ་སོགས་འདུག་པ་ལྟར་ཕེབས།",
    "དེ་དུས་དགུང་ལོ་བཅུ་བཞི་པར་འདུག་ཀྱང་སྐུ་ཚད་ལ་གཞན་གྱི་དོ་ཟླ་བྲལ་བ།",
    "ཇུན་གར་བ་ཡང་རང་ཡུལ་དུ་བྱོལ།",
    "བླ་བྲང་ཆེན་པོ་བཅུ་བདུན་ཙམ་འདུག་པའི་ནང་ནས།",
    "ཞུ་བདེ་ལྷན་སྐྱེས་ཀྱི་རྫོགས་རིམ་རྣམས་ལ་ཉམས་རྟོགས་ཀྱི་རྩལ་ཁ་རྫོགས་པར་འདུག་པས།",
    "ཕེབས་བསུ་སེར་སྦྲེངས་གཞིས་ལེན་དཔག་ཏུ་མེད་པ་འདུག།",
    "འོན་ཀྱང་རང་དང་སྐལ་མཉམ་གདུལ་ཡང་བརྗོད་པར་ནུས་པ་ལྟ་ག་ལ་ཞིག།",
    "ཁོང་རང་སྐུ་རྐྱང་ལ་གཟིམ་ཆུང་སྦུག་མཇལ་བསྩལ།",
    "རི་དེའི་རྩེ་ན་ཕ་བོང་སེར་ཐིང་ངེ་བ་ཤིན་ཏུ་ཆེ་བ་ཞིག་འདུག།",
    "བཀའ་ལས་རྟག་བརྟན་གྱི་ཕྱོགས་འདིར་བག་ཆགས་ཤིན་ཏུ་ཆེ་བ་འདུག་ཅེས་ཡང་ཡང་ཕེབས།",
    "དེ་སྐབས་སྐུ་འཁོར་ཚོར་ཡང་ལྟས་ཡ་མཚན་པ་བྱུང་ཡོད་འདུག།",
    "རིག་འཛིན་ཆེན་པོ་གཙུག་ལག་ཁང་དུ་ཞབས་བསྐྱོད་གནས་དེར་ཀླུ་གན་རྐྱལ་ཞེས་པ་ཀླུའི་གཟུགས་བརྙན་རྡོ་ལ་བརྐོས་པ་འདོམ་བཞི་ཙམ་ཡོད་པའི་མཐར་མཚོ་དང་བཅས་པ་འདུག།",
    "བལ་བོད་ཀྱི་མི་ཚོགས་ནི་ནམ་མཁའི་སྐར་ཚོགས་ས་ལ་འཕོས་པ་ལྟ་བུར་གདའ།",
    "གྲུབ་ཐོབ་ཆེན་པོ་རྣམས་ཀྱི་སྒྲུབ་ཁང་ཡིན་ཞེས་གླེང་བའི་ཕ་བོང་ཆེ་བ་དག་ལ་བཅོས་པའི་ཁང་པ་འདོམ་གང་གྲུ་བཞི་སོགས་ཆེ་ཆུང་ཅི་རིགས་གྲངས་མང་བ་ནི་རང་བཞིན་ཡ་མཚན་པ་ཙམ་དུ་འདུག།",
    "རོང་ཞལ་དཀྱིལ་མཇལ་བའི་ཐུགས་འདུན་ཤིན་ཏུ་ཆེ་བ་ཡོད་འདུག་རུང་ལམ་བགྲོད་ཁག་པར་བརྟེན་ཆིབས་བསྐྱོད་མ་ཐུབ་རུང་འབུལ་བ་དང་གང་ཅིའི་གནས་ཚུལ་ཞིབ་ལྷོངས་སུ་འདུག།",
    "ཁམས་སྤྲུལ་ནས་ངོས་འཛིན་གནང་འདུག་པ་ལྟར་དེ་ཁ་ཡིན་འགྲོ་ཞེས་ལན་གསལ་བསྩལ།",
    "རབ་སྟོན་རྒྱ་ཆེར་གནང་བའི་ལེགས་བྱས་ཕུན་སུམ་ཚོགས་པ་བྱུང་འདུག།",
    "གཟིམ་སྤྱིལ་གྱི་བར་ཁྱམས་སུ་བཞུགས་རྒྱུ་བྱུང་ན་ཞེས་ཡང་ཡང་བཀའ་ཕེབས་འདུག་ཀྱང་འཕྲལ་དུ་བསྒྲིག་ཚོམ་ནི་མ་གནང་།",
    "འཇའ་སྤྲིན་མང་ཞིང་བཀྲ་ཤིས་རྟགས་བརྒྱད་ཀྱི་དབྱིབས་སོགས་གཟུགས་བརྙན་ཤིན་ཏུ་ཡ་མཚན་པ་འདུག་ཅེས་ཀུན་གྱིས་གླེང་།",
    "༢ལྷ་སྣང་རང་རྒྱུད་པས་རུ་དྲར་གོལ་བའི་སྐྱོན་ལས་གྲོལ་ཏེ།",
    "རང་འདུག་པའི་ཚེ་སྔས་སུ་བཏབ་ཅིང་།",
    "ཅེས་ལས་བཞིའི་ཕུར་པར་ཁ་ཞི་བ་ལ་ཤར་སོགས་ལས་མཐུན་ཏུ་ཕྱོགས་ཤིང་རང་སྔགས་སོ་སོ་བཟླ་ཞིང་།",
    "མགོ་བོ་རྒྱ་མདུད་འདུག་པ་ལ།",
    "རོ་སྟོད་ཟུར་བརྒྱད་འདུག་པ་ལ།",
    "རོ་སྨད་ཟུར་གསུམ་འདུག་པ་བཙལ།",
    "རྒྱ་མཚོའི་གཏིང་ན་བཞུགས་ཙ་ན།",
    "བྷ་གའི་ཀློང་ན་བཞུགས་ཙ་ན།",
    "དེའང་རང་དོན་ལྟ་བུར་གཏོར་ཟློག་གཞུང་གསལ་སྔགས་དམིགས་ཁོ་ནར་ནན་ཏན་བྱ་བ་ལས་ཁ་སྐོང་འདི་རིགས་པ་ལ་ཆེར་མི་དགོས་ཤིང་།",
    "གཞུང་ལའང་བཅོས་བསླད་ཀྱི་སྐྱོན་དུ་འགྱུར་བ་ཆེར་མི་འདུག་པས་འདོར་ལེན་གྱི་མཚམས་ཕྱེད་པར་བྱའོ།",
    "སློབ་དཔོན་གོས་རྒྱན་སེར་པོ་རྒྱས་པའི་བསམ་པས་རྒྱལ་པོ་རོལ་པའི་འདུག་སྟངས་ཀྱིས་སྟན་སེར་པོ་ལ་ཁ་བྱང་དུ་བལྟས་ལ།",
    "སླར་ཡང་རང་ཕུར་བ་རྣམ་འཇོམས་ཐུགས་ཆེན་སོགས་ཀྱི་ཆོ་ག་སྣ་ཚོགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་བ་ལ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་བག་ཆགས་དང་བཅས་པ་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "གཏོར་མ་བདུད་རྒྱལ་དུ་གསལ་བ་ཁྱེད་རང་རྣམས་ལ་བཀའ་སྡོད་ཀྱི་ཚུལ་དུ་གཏད་ཅིང་།",
    "དགྲ་སྲི་ལྟ་བུར་དམིགས་བྱའི་ལོ་ཟླ་ཞག་དུས་ཀྱི་བཞི་གཤེད་བདུན་ཟུར་སོགས་ཀེག་དང་བསྟུན་དགོས་ལ།",
    "ལྷ་དབྱེའི་རྫས་རྣམས་ཀྱིས་ལིངྒ་བདུག་ཅིང་རང་ལ་མ་ཕོག་པར་བྱ།",
    "རང་རང་དམ་བཅས་བཞིན་དུ་སྒྲུབས་པར་མཛོད",
    "བྱད་མ་ལྷ་སྲུང་རང་གཤེད་རང་ལ་ཕོབ",
    "དགྲ་བགེགས་ཀྱི་མཱཾ་ས་ཙིཏྟ་རཀྟ་གོ་རོ་ཙ་ན་ཀི་ནི་རི་ཏི་གྲྀ་ཧ་ན་ཁཱ་ཧིས་བསྔོས་ལ།",
    "དག་བྱེད་ཁྲུས་ཀྱིས་བཀྲུ་བའི་སླད་དུ་དམིགས་པ་འདི་བཞིན་ཏུ་མཛོད་ཅིག་ཁྱེད་རང་རྣམས་ཀྱི་མདུན་གྱི་ནམ་མཁའ་པདྨ་དང་ཉི་མའི་གདན་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་བླུགས་པས།",
    "མདུན་མཁར་བཞུགས་པའི་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པས་ཕྱག་གཡས་བྱབས་པའི་རྫས་ཀྱིས་ཁྱེད་རང་རྣམས་ལ་བྱབས་པས།",
    "ཡང་ལྷ་ཚོགས་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་གནས་གསུམ་ནས་ཡེ་ཤེས་ཀྱི་མེ་ཕུང་རབ་ཏུ་འབར་བ་བྱུང་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་ལ་གནོད་ཅིང་འཚེ་བར་བྱེད་པའི་རྐྱེན་བགེགས་བེ་ཐེལ་རྒྱལ་ཀོང་སྤྲུལ་ཡོན་ཏན་རྒྱ་མཚོས་མཛད།",
    "མདུན་བསྐྱེད་སྐུའི་འོད་ཟེར་ལས་བྱུང་བའི་ཕྱག་རྒྱ་བཞིའི་གོ་ཆས་ཁྱེད་རང་རྣམས་ལ་ཞུ་ལུབས་སུ་གཡོགས་པས་ཕྱིན་ཆད་ཕུར་བ་རྣམ་འཇོམས་ཐུགས་ཆེན་སོགས་ཀྱི་ཆོ་ག་སྣ་ཚོགས།",
    "ལག་པ་རྡོ་རྗེ་རྩེ་ལྔ་པ་བུམ་པ་གདུ་བུ་ལྟར་འདུག་པའོ།",
    "ཡང་ལྷ་ཚོགས་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་གནས་གསུམ་ནས་ཡེ་ཤེས་ཀྱི་མེ་ཕུང་རབ་ཏུ་འབར་བ་བྱུང་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་ལ་གནོད་ཅིང་འཚེ་བར་བྱེད་པའི་རྐྱེན་བགེགས་བེ་ཐེལ་རྒྱལ་ཕུར་བ་རྣམ་འཇོམས་ཐུགས་ཆེན་སོགས་ཀྱི་ཆོ་ག་སྣ་ཚོགས།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་མིག་རས་ཀྱི་འོག་ནས་དཀྱིལ་འཁོར་གྱི་བར་སྣང་དུ་ལྟོས་ལ་ཁ་དོག་ཇི་ལྟར་མཐོང་བ་དེད་ལ་སྨྲོས་ཤིག་ཅེས་དྲིས་ནས།",
    "ཁྱེད་རང་རྣམས་ལྷ་སྐུ་ཕྱག་རྒྱ་ཆེན་པོ་སྣང་ལ་རང་བཞིན་མེད་པའི་ངོ་བོར་མཉམ་པར་ཞོག་ཅིག།",
    "དེ་ལྟར་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་བདག་པོའི་གསང་བ་གསུམ་དང་དབྱེར་མེད་དུ་བྱིན་གྱིས་བརླབས་ནས།",
    "འདིར་འདུག་འཇུག་པའི་གནས་མིན་ཀྱི",
    "དེ་བས་མ་འདུག་གཞན་དུ་དེངས",
    "ཁྱེད་རང་རྣམས་ལ་སྔར་བྱིན་པའི་མེ་ཏོག་དེ་ཉིད་རང་རང་ཀོང་སྤྲུལ་ཡོན་ཏན་རྒྱ་མཚོས་མཛད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་བཞིར་ཐིམ་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཀོང་སྤྲུལ་ཡོན་ཏན་རྒྱ་མཚོས་མཛད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྒོ་གསུམ་སྐུ་གསུང་།",
    "དེ་ལས་བབ་པའི་བདུད་རྩིའི་རྒྱུན་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "སེམས་དཔའི་དགོངས་པ་གཞུང་རང་ནས་གསུངས་པའི་སྤྲོས་པ་འདི་རྣམས་ལག་ལེན་དུ་ཁེལ་བ་གལ་ཆེ་ལ།",
    "སླར་ཡང་རང་སྔགས་དང་བཅས་དཀྱིལ་འཁོར་ལ་ཕྱོགས་མ་འཁྲུལ་བར་གཙོ་བུམ་ཤར་དང་།",
    "གཟུངས་མའམ་ལས་རྡོར་ནུབ་དང་བྱང་དུ་འདུག་སྟེ་ཐིག་ཆེན་བརྒྱད་ལག་ལེན་ལྟར་བཏབ།",
    "དེའང་རང་གཞུང་འདིར་ཡོད་དོ།",
    "ཀརྨ་དྷཱ་ཀི་ནཱི་ས་པཱ་རི་ཝཱ་ར་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་བ་ལིཾ་ཏ་ཁཱ་ཧི།",
    "ཙིཏྟ་ཧྲིང་ཧྲིང་ཛ་ཛ་བར་གྱིས་དམིགས་པ་ཕོག་དཀྱིལ་འཁོར་གྱི་བཀའ་སྲུང་གཙོ་བོ་རྟ་མགྲིན་ནག་པོ་ལས་རྟ་མགྲིན་གཉིས་པ་འཕྲོས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཐིམ་པར་སྒོམས་ཤིགཅེས་པས་གཞན་ལའང་རིགས་འགྲེ་ཞིང་ཚིགས་བཅད་བཅས་སོ་སོའི་གཟུགས་གཏད།",
    "ཕྱག་དང་རང་གཞུང་ལྟར་གསོལ་བ་གདབ།",
    "ལྷ་མཆོག་ཐུགས་རྗེའི་བདག་ཉིད་ཁྱེད་རང་མཁྱེན",
    "དེས་ན་སྐབས་འདིར་ཡང་རང་གཞུང་ནས་གསུངས་པའི་བསྐྱེད་རིམ་ལ་ནན་ཏན་བྱེད་པ་གལ་ཆེ།",
    "ལྷར་སྣང་དང་རང་སེམས་དབྱེར་མེད་དུ་བསྲེས་ཏེ་བསྒོམ་བྱའི་ལྷ་དང་སྒོམ་བྱེད་ཀྱི་ཕུར་བ་རྣམ་འཇོམས་ཐུགས་ཆེན་སོགས་ཀྱི་ཆོ་ག་སྣ་ཚོགས།",
    "བསྐྱེད་རིམ་གོ་དོན་ཤེས་པ་ཉུང་བར་གདའ།",
    "ཁྱིམ་ཚང་ཕྱུག་པོ་མིན་ལ་ཧ་ཅང་དབུལ་བོ་ཡང་མིན་འདུག་དཔལ་མགོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས།",
    "འཆད་ཉན་སྒོམ་སྒྲུབ་བྱེད་པ་ཤ་སྟག་བརྩེས་པ་དྲན་འདུག་ཅུང་ཟད་ནར་སོན་ནས་ཕྱུགས་འཚོ་བ་དང་།",
    "ཁོ་རང་ས་གཞན་གྱི་གྲྭ་བ་ཡིན་གཤིས་ང་གྲྭ་སར་ཞུགས་ཡོད་པ་ཁོས་མ་ཤེས་འདུག་ངས་ཀྱང་མ་བཤད།",
    "བ་ཡིག་ཤིག་དང་ར་ཡིག་ཤིག་འབབ་འདུག་ཟེར།",
    "ཕྱིས་སུ་བརྟགས་ཚེ་དེ་འབར་ཁམས་ཡིན་འདུག་དེའི་ཤར་བྱང་མཚམས་ལ་བེ་རོ་ཙ་ནའི་སྒྲུབ་ཕུག་ཡོད།",
    "འཚོ་བ་སྐྱོ་བོ་འདུག་པས།",
    "འདུག་རིང་ལ་ཁོང་ལ་བསྙེན་བཀུར་གང་ནུས་ཞུས།",
    "གཞན་གྱིས་རྩོམ་ཡག་པོ་འདུག་ཟེར།",
    "ཟམ་པ་སྐེད་ཆད་ཅིག་བབ་འདུག་མི་བཟང་ཟེར།",
