    "དུག་སྦྲུལ་རྐེ་༤བཅད་ནུས་པ་མེད་པ་རྣལ་འབྱོར་པ་ཡིས་གཟིགཟེགས།",
    "མ་གི་ཏ་ཡོད་ས་ལ་བྲང་འགྲོས་ལྟ་བར་མི་ནུས་སོ།",
    "རྒྱལ་པོའི་བཙུན་མོ་ལྷ་སྲས་ལ་ནི་སྐྱོ་བར་འགྱུར།",
    "སྟག་ནི་རི་མོ་ཡོད་པས་ལན་ཏེ་རྟག་ཏུ་དགྲ་དང་འགྲོགས།",
    "བུ་ཤིའི་མ་བུ་མཐོང་བའི་འགྲོ་བ་བཟང་མོ་མྱ་ངན་རམ།",
    "དཔལ་འབྲས་ཕུང་ཤྭཀརང་བྱུང་གི་རྩར་འཇམ་དཔལ་གྱིས་གསུངས་པའོ།",
    "གླང་པོའི་མགོ་ལ་རྭ་མེད་ཆག་གིས་དོགས་པའི་སྡུག་བསྔལ་སྐྱེ་མི་འགྱུར།",
    "དང་ལ་སྤུ་གྲིས་ལྕེ་ཆོད་དེ་དུས་ཁྱོད་ཀྱི་ཁ་ནས་རིག་བྱེད་ཐོན།",
    "ཆུ་ནང་རྡོ་བོར་ཚེ་ན་དེ་དུས་ཟླ་བ་གུད་དུ་སོང་བ་མེད།",
    "རྐང་ལ་ཁོང་དྲིལ་བུད་པའི་མི་དེ་བློ་སེམས་བདེ།",
    "རྒྱུད་ཟི་༥༣གཙུག་གི་ནོར་བུའི་ཐོག་མ་ག་ནས་འོང་།",
    "རི་བོ་བྱ་རྐང་དུ་སྤྱན་རས་གཟིགས་ཀྱིས་གསུངས་པའོ།",
    "སྲིན་མོའི་པང་དུ་བུ་ཤོར་ཉེ་ཞོ་མེད་པར་ལོག་པའི་མི་དེ་གང་།",
    "པེ་ཏ་མིང་གིས་བསླུས་ཏེ་བསྒོ་བ་ཉན་དུས་དེ་དུས་དེ་ཚེ་གཅེས་པར་དོར།",
    "འཛམ་བུ་ཆུ་བོའི་གསེར་ལ་མུ་ཏིག་གིས་སྤྲས་བཙུན་མོས་བཙོངས་ན་རིན་ཐང་ཆེ།",
    "འགྲོ་བར་མ་ནུས་ཁར་གཞོང་ནང་གི་རུས་སྦལ་ཚི་ཆད་འགྱུར།",
    "མཁས་པ་ཡིས་ནི་སྟག་གི་ཚང་མཐོང་དེ་ནས་འབྱོལ།",
    "བུས་པ་གཡང་ཁར་སོང་བ་མ་ཡི་སྤྱོད་འགྲོས་ལྟོས།",
    "ཏིལ་མར་རྩེ་ལ་དངུལ་ཆུའི་རྒྱུན་འཛག་འདི་ལ་སེང་གེ་བལྟས་ཀྱིས་དགའ་། གིང་པ་སྲོག་ལ་མཁས་པའི་སྒྱུ་མའི་སྐྱེས་བུ་སྡིག་མི་སོག།",
    "རྡོ་ཡི་མི་ལ་སུ་ཉེ་ཁོ་ཡི་དགྲ་བོ་གང་ཡིན་ཁྱོད་ཀྱིས་སྨྲོས།",
    "དུས་མཐའི་ནམ་མཁའ་འདི་ལ་ཤར་ལྷོ་ཕྱོགས་མཚམས་གང་ང་གིས་ཤེས་པར་འགྱུར།",
    "ཡིན་པར་ཤེས་པའི་བློ་ཡིས་མོན་མོའི་དུག་གི་ནུས་པ་མེད་པར་བྱེད།",
    "ཟླ་བ་བཅོ་ལྔ་མ་རྒྱས་བར་དུ་རུས་སྦལ་ལས་སྐྱེས་སྒོ་ང་སྨིན་མི་འགྱུར་། རྐུན་པོ་མཛོད་ཁང་ནང་དུ་རྒྱལ་པོའི་ཉུལ་མོས་བཟུང་བ་དེ་ཅི་སེམས།",
    "སེང་གེའི་མིག་གི་དབུས་ན་ཡི་གེ་ཨ་ཡོད་པ་དེ་ལྟོས་དང་ཀྱེ།",
    "ཁབ་ཏུ་བྱོན་པའི་བཙུན་མོས་སྔར་གྱི་སྤྱོད་པ་དོར་བར་བྱ།",
    "པར་ཏི་ཀ་ན་གསེར་འགྱུར་རྩེ་ཡི་ལོ་མ་མེ་རུ་འབུད།",
    "བྱིས་པ་ཨ་མ་མཐོང་ཚེ་པང་དུ་རྒྱུག་པས་ཨ་ལུ་བོར།",
    "སྲིན་མོའི་རལ་གྲི་གྱད་ཀྱིས་ཐོགས་པ་དེ་ལ་ཕ་རོལ་འཇིགས།",
    "རྟ་མཆོག་ཐུར་དུ་རྒྱུག་པ་སྐྱེས་བུ་འདི་ཡིས་གདམས་ངག་བསྟན་ནས་སོང་།",
    "གྱད་ཀྱིས་མ་བརྒྱུགས་ཕྲ་མོའི་པང་ལ་རྒྱལ་པོ་བལྟས་ཀྱིས་དགའ།",
    "ཉི་མ་མུན་པར་མཐོང་བའི་མི་དེའི་མིག་དེ་ཅིས་ལན་དེའོ་ཁྱོད་ཀྱིས་སྨྲོས།",
    "སྐད་གསང་མཐོན་པོའི་སྒྲ་ཡིས་ཡེ་ཤེས་འཆར་དུས་ཁྱོད་ཀྱིས་བྲིས།",
    "ཕབས་ཀྱིས་གང་ལ་རེག་པའི་ཆེན་ནི་གླུམ་དུ་འགྱུར་བར་ཐེ་ཚོམ་མེད།",
    "སྤྲིན་མེད་མཁའ་ལ་ཤར་བའི་གཟའ་སྐར་ཕྱོགས་དེར་རྒྱལ་མོ་ཀ་ར་ཁྱོད་ཀྱིས་ཕྱོར།",
    "མི་སྐོམ་པས་མཆུ་དང་མགུལ་པ་སྐམས་པའི་གླང་པོ་ཆུ་དང་ཕྲད་པས་གཞནསེམས་། ཏིལ་མར་གྱིས་བསྐུས་སྐྲ་ལ་མེ་ཤོར་དེ་དུས་སྒེག་མོ་བྱ་གཞན་དོར།",
    "སྒེག་མོ་ཡིད་འཕྲོག་རྨི་ལམ་བུད་མེད་གང་ནས་འོངས་ནས་གང་དུ་སོང་།",
    "རིན་ཆེན་བེ་ཌཱུརྱ་དང་མཆིང་བུ་ཁྱོད་ཀྱིས་བརྗེ་བར་མ་བྱེད་ཅིག།",
    "རྨ་བྱ་བཙན་དུག་ཟ་བ་བྱ་གཞན་རྣམས་ཀྱིས་ཐུན་མོང་མ་ཡིན་ནོ།",
    "རྒུན་འབྲུམ་ཆང་གིས་བཟི་ཚེ་བཙུན་མོ་དྲུང་མི་འགྲོ།",
    "ལང་ཚོ་བཅུ་དྲུག་ལོན་པའི་བུ་མོ་དེ་ཡིས་བདེ་བ་སྨྲ་མ་ཤེས།",
    "དུག་སྦྲུལ་ཕག་དང་གླང་པོའི་སྤྱོད་འགྲོས་ཁྱོད་ཀྱིས་ད་ལྟོས་ཤིག།",
    "དཔལ་གྱི་རི་ལ་ཡི་གེ་བསུབས་ནས་ཐབས་དེས་བདེན་པ་མཐོང་བར་འགྱུར། ཨུ་རྒྱན་ཚནྡོ་ལའི་གླིང་དུ་དཔལ་རང་བྱུང་གི་རྒྱལ་མོས་གསུངས་པའོ།",
    "ཕ་ཝང་དྲེད་དང་ཤ་དག་བྱེད་པའི་དགོས་པ་གང་ཡིན་ཁྱོད་ཀྱིས་སྨྲོས།",
    "གཏེར་མཛོད་དབྱིག་གིས་ཁེངས་ཚེ་དེ་དུས་དེད་དཔོན་བློ་སེམས་བདེ་བར་སྣང་།",
    "ཆུ་ལ་ཆུ་བཞག་གཉིས་སུ་མི་སྣང་གང་གིས་འབྱེད་པར་ནུས་པ་མཁས།",
    "གྲུ་གཉིས་སྣ་ལ་རྡོག་པ་བཞག་པའི་མི་དེ་འགྱེལ་བར་འགྱུར་། ལྷོ་ཕྱོགས་ཀཱ་མ་རཱུ་རུ་ལྷ་མོ་མཱ་རི་ཙེས་གསུངས་པའོ།",
    "གསེར་གླིང་ཡིད་ལ་བཅངས་པའི་དེད་དཔོན་བོང་རྡོའི་ཁྲོད་དུ་སྡོད་༧་མི་འགྱུར་། རྡོ་ཡི་ཤུལ་དུ་འབྲང་བའི་ཁྱི་ཡི་སྤྱོད་འགྲོས་འདི་ལ་ཁྱོད་ཀྱིས་ཡང་ཡང་ལྟོས་། ཚོང་ཁང་དུ་ཚོགས་འགྲོན་པོ་ཐད་ཀར་མི་འགྲོགས་རང་རང་གུད་དུ་འགྲོ།",
    "ནང་གི་འདུ་བ་གང་ཡིན་དྲང་སྲོང་གིས་ནི་ཕྱི་ནས་ཤེས།",
    "སྦྲང་རྩིའི་རོ་མཆོག་མྱོང་བའི་རྔ་མོ་རྩྭ་ཡི་ཞེན་པ་བྲལ།",
    "རྒྱལ་སྲས་འཁྲུངས་པའི་བཙུན་མོ་ལ་ནི་དེ་དུས་ལྷ་རྣམས་རེ་བ་ཆེ།",
    "ཅི་ཡང་མི་དགོས་ཤིང་སྐོགས་བར་གྱི་སྡོམ་གྱི་སྤྱོད་འགྲོས་ཁྱོད་ཀྱིས་ལྟོས།",
    "རུས་སྦལ་སྤུ་ཡི་ཁ་དོག་ཅི་འདྲ་ད་རེས་ཁྱོད་ཀྱིས་མོ་གཤམ་བུ་ལ་དྲིས།",
    "འདབ་བཟངས་རྒྱལ་པོའི་མཆུ་ལ་རྩི་ཡོད་ཆུ་བོའི་ནང་གི་འོ་མ་འདུ།",
    "སེན་མོའི་བར་དུ་སེང་ལྡེང་ཚེར་མ་ཟུག་པའི་མི་དེ་ཏིང་འཛིན་བཟང་།",
    "གླང་པོའི་མགུལ་གྱི་དྲིལ་བུ་འདི་ཡིས་མན་ངག་ཐམས་ཅད་བསྟན་ནས་སོང་།",
    "མཐོང་དུས་དེ་ཚེ་ཁྱོད་ཀྱིས་ཁོང་དུ་གཞུ་ཡི་སྲད་བུ་ད་ཕུད་ཅིག།",
    "རང་གིས་བཅག་པའི་གསེར་ལ་ཀ་འཇིའི་དགོས་པ་མི་བདོག་གོ།",
    "མཐོང་སྣང་དགྲ་རུ་རེད་པ་གཏེར་སྲུང་",
    "རྒྱལ་པོས་མ་ཚོར་བ་ལ་དུར་བ་གསེབ་ཏུ་བདུད་རྩིའི་བུམ་པ་རང་གིས་བཏུང་།",
    "གཟན་ལ་བཅུམ་པ་རྒྱ་ཁྲ་འདི་ཡིས་མན་ངག་ཐམས་ཅད་བསྟན་ནས་སོང་།",
    "ཉ་བཏང་བ་ཡི་སྐྱར་མོ་དེ་དུས་མཁའ་ལ་དགྲ་ཡི་འཇིགས་པ་བྲལ།",
    "ཁབ་ལེན་རྡོ་འདི་ནམ་ཞིག་བཙུན་མོའི་དགྲ་རུ་ལྡང་བས་ས་ཡི་འོག་ཏུ་སྦོས།",
    "གསེར་འགྱུར་རྩི་ངོ་སྟོན་པའི་དྲིན་ཅན་གང་གིས་མཉེས་པར་བྱེད་པར་ནུས།",
    "སྲིན་མོའི་སོག་པ་མགུལ་དུ་ཐོགས་ན་མཁའ་ལ་འཕུར་བར་འགྱུར།",
    "བདེ་བར་གཤེགས་པ་ལུང་གི་བརྒྱུད་པ་ཡི་དམ་གྱི་ལྷས་བསྟན་པ་འཛམ་བུའི་གླིང་དུ་སྔོན་ཆད་མ་གྲགས་པའོ།",
    "པེ་སྣར་རེམ།",
    "སྣར་གི་བཟའ།",
    "པེ་སྣར་ཅོ་ཕྱག་རྒྱ་ཆེན་པོ་བརྡའི་བརྒྱུད་པ་༢༨༩ཀྱིཧཱུཾཔེ་སྣར་མོངས་༦པེ་སྣར་ལ།",
    "པེ་྾སྣར་྾འབྲས་རེའུ་མིགབསྡུར་རྒྱུད།",
    "གསེར་འགྱུར་རྩི་ཡི་རིག་བྱེད་འཆང་གིས་རྟོགས།",
    "ཁྲི་སྙན་མིག་གིས་ནོར་བུའི་ནུས་པ་ལྟ།",
    "མངའ་བདག་ཚིག་ལ་བཙུན་མོ་ཟུར་མི་གཡོ།",
    "སྦྲང་རྒོད་འཐུངས་པའི་ནུས་པས་ཡུན་མི་ཕྱག་རྒྱ་ཆེན་པོའི་མན་ངག་རྡོ་རྗེ་གསང་བའི་གླུ་༢༩༡ཐོགས་། ཀ་འཇི་མི་༡དགོས་རང་གིས་བསགས་པའི་གསེར།",
    "ལྟོ་འགྲོས་དྲི་ཚོར་མ་གི་ཏ་ལ་འབྲོས་། ཕྱུགས་བདག་མཐོང་བས་ཨུ་མ་ཅོད་པན་བཀྲོལ།",
    "ཁྲི་མོན་ནང་དུ་གསེར་སྒྲོག་ཅི་ཞིག་བྱ།",
    "རྒྱུདཁྲི་༥༣ཁྱུ་མཆོག་ཐོང་མཁན་ཞིང་གི་མཐའ་མི་མཐོང་།",
    "རིགས་ངན་བུ་མོས་འཇོ་སྒེག་སྤངས་ནས་འདུག།",
    "རྒྱན་གྱིས་སྤྲས་པའི་བཙུན་མོས་གཞན་ཡིད་འཕྲོག་འདོད་དགུའི་འབྱུང་གནས་རིན་ཆེན་གཏེར་གྱི་སྒྲོམ།",
    "རང་གི་མཐེབ་མཛུབ་གཞན་གྱི་ལག་པ་མིན།",
    "གར་ཡང་བདེ་བ་ལང་ཚོ་རྒྱས་པའི་ལུས།",
    "ཁྱིམ་ལ་མི་དགའ་བུ་མོའི་བློ་མི་འཕྲོགས།",
    "ཨུ་རྒྱན་དུར་ཁྲོད་སྲིན་མོ་ཁྲོས་པའི་ས།",
    "སྨྲ་བར་༡༢སེང་ཕོད་བཙུན་མོ་བསྣོལ་གྱི་མཚང་།",
    "གཏེར་གྱི་བདག་པོ་མི་རེ་རིགས་ངན་བུ།",
    "མཐོང་སྣང་དགྲ་རུ་རེད་པ་དུག་སྦྲུལ་མིག།",
    "ཁྱོད་ལ་ཤིང་ལོས་གནོད་པ་སྐྱལ་བ་མེད།",
