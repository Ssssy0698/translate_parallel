    "མིག་གི་རིན་ལ་ཅི་བཏུབ་སོམས་དང་ཀྱེ།",
    "བཟོ་༧ཡི་རིག་བྱེད་ཚོང་ལ་གཞུག་པ་མིན་། སྟག་གི་རི་མོ་བཀྲ་བས་གྱོད་ལ་གཏུགས།",
    "དངུལ་ཆུ་སྣོད་དུ་ཟགས་པར་གྱུར་ཏ་རེ།",
    "སྦྲང་རྩི་མྱོས་པས་རྔ་མོ་༡གྱོད་ལ་གཏུགས།",
    "བག་མས་ལྟད་མོ་མ་མཐོང་ཚོང་དུས་དབུས།",
    "འབག་གི་རིག་བྱེད་གསོ་ཡི་བཟོ་ལ་གནོད།",
    "མ་ཧེའི་སྒྱིད་འཁྱོལ་འགྲོ་ལམ་ཐུར་གཞོལ་བདེ།",
    "དགེ་སློང་འདུག་ས་བཙུན་མོའི་ཁྲོད་མ་ཡིན།",
    "གསེར་མགར་མགུལ་དུ་རང་གི་རྒྱན་མ་ཐོགས།",
    "བྲན་མོས་རྙེད་ཀྱང་ནོར་བུ་རྗེ་བོས་འཁྱེར།",
    "བྱི་མོས་མིག་འབྲངས་ཕ་ཡི་ཡུལ་མི་ཟིན་།",
    "ཁྲི་མོན་ཁ་རུ་ལྷ་ཡི་སྲས་མོ་བྱུར།",
    "དུག་སྦྲུལ་གཙུག་གི་ནོར་བུ་བླང་མི་བྱ་། གྱད་ཕྲུག་རྩལ་སྦྱོང་སེམས་དེ་དོར་ཅིག་དང་།",
    "བཙུན་མོའི་བསྲུང་མཚོན་མ་ལ་བཅོལ་བ་མིན།",
    "བུད་མེད་ཁྱིམ་གྱིས་སུན་པ་དེ་ལ་ལྟོས།",
    "མོ་གཤམ་བུ་ཡི་བསྒྱུར་བག་མ་ངས་མ་མཐོང་།",
    "ཀཱཪྵཱ་པ་ཎིས་དུང་གི་ཁ་དོག་མཚོན།",
    "ནམ་མཁའ་གང་ནས་བླངས་པ་ཁྱོད་ཀྱིས་སྨྲོས།",
    "ཡོད་མེད་གཉིས་སུ་སྨྲ་བ་གང་གིས་ནུས།",
    "ལྕགས་ཀྱི་ཐོ་བ་གང་གིས་ཕིག་པ་ཡིན།",
    "བྲག་ཅའི་སྒྲ་འདི་གང་གི་ཁ་ནས་བརྗོད།",
    "ནམ་མཁའ་འཕེལ་དུ་མ་སོང་ལྟོས་དང་ཀྱེ།",
    "རྡོ་ཡི་མི་ཡི་རིག་བྱེད་གང་དུ་སོང་།",
    "འགྲོ་མགོན་གྱིས་ཀྱང་ནམ་མཁའི་མུ་མ་གཟིགས།",
    "གསོ་རས་ཐལ་ཁུར་འཇུག་པ་དྲི་མ་མེད།",
    "ཉ་ཡིས་བརྣངས་པའི་དྷྱསྐྱར་མོ་དགྲ་ལ་འབྱོལ་། གཅིག་ཏུ་མི་གནས་སྟག་མོ་གྲུས་མའི་ཚང་།",
    "བུག་པ་ཡོད་བཞིན་ཟང་ཐལ་ཡུལ་མི་འགག།",
    "སྒྱུ་རྩལ་འབྱོངས་པའི་གྱད་ནི་ཕྱི་ཕྱིར་རེམ།",
    "རེག་བྱ་གཟུགས་ཀྱིས་སྟོང་པ་ཁོལ་མའི་ནང་།",
