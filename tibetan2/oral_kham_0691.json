    "ཁོང་རང་ལ་ཤར་བའི་འོད་གསལ་གང་ཡིན་པ་དེ་ངོ་སྤྱད་དོ།",
    "སོར་རྟོག་བྱ་གྲུབ་གཉིས་ཀར་རྨི་ལམ་ལ་སྦྱོར་གསུང་བའང་འདུག་སྟེ་མན་ངག་གསུང་རྒྱུན་ལས།",
    "ཨ་དཀར་པོ་དེ་འཕར་ཙམ་བྱུང་ནས་ཡང་སྔར་ཤུལ་དུ་བསྡད།",
    "འདི་རང་བཞིན་མ་རྟོགས་པ་རྣམས་ལ་མའི་མངལ་དུ་འདུག།",
    "གཟུགས་སུ་སྣང་ཚད་འཁོར་ལོ་སྡོམ་པའི་སྐུར་བསྒྱུར་དགོས་སྙམ་པ་བྱས་ཙ་ན།",
    "སྒྲ་གྲགས་ཚད་སྔགས་ཡི་གེ་བདུན་པ་ལྟ་བུ་གཅིག་ཏུ་བསྒྱུར་སྙམ་པ་བྱས་ཙ་ན།",
    "འདི་སྣོན་པར་མཛད་པ་འབའ་ཞིག་འདུག་སྟེ།",
    "འོན་ཀྱང་ཕྱིས་ཀྱི་ཕྱག་ལེན་ལ་དམིགས་པ་ཁ་སྐོང་དེ་རྣམས་མི་བྱེད་པར་གདའ།",
    "དམ་བསྒྲགས་ཀྱང་ཆེར་མཛད་པར་གདའ།",
    "དེ་ཡང་དེང་སང་ཕལ་ཆེར་རྗེས་སུ་བྱེད་ཀྱིན་འདུག་ནའང་།",
    "བསགས་སྦྱངས་ཀུན་གྱི་མཐར་ཐུག་གོ། གཉིས་པ་སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་ནི།",
    "མགོ་ནང་བསྟན་ཏུ་ལོག་ཤུགས་དྲག་པོས་ཕྱི་ལ་འགྲོ་ཚད་པ་ལ་བུ་ག་དོགས་པོར་མ་ཤོང་བས་ལྷན་ལྷན་འདུག་པ་ལ་སེམས་ཡུད་ཅིག་དྲག་ཏུ་གཏད།",
    "ཌཱ་ཀི་མ་ནི་གུ་མ་ཡིན་པར་འདུག་སྙམ་སྟེ་ཕྱག་བཙལ་སྐོར་བ་དུ་མ་བྱས་ནས།",
    "འདི་ངེས་པར་ཤ་ཟའི་མཁའ་འགྲོ་མ་ཡིན་ནམ་གསེར་ལ་ཕངས་པ་མི་འདུག་སྙམ་པ་དང་།",
    "རི་དེའི་ཕྱོགས་བཞི་ན་མར་གསེར་གྱི་ཆུ་རྒྱུན་བཞི་འབབ་ཀྱིན་འདུག་ནས།",
    "རང་བཞིན་མེད་པར་རྟོགས་ཙ་ན།",
    "༢ སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "གཉིས་པ་སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་ནི།",
    "ཆགས་སྡང་རང་གྲོལ་བཅུ་བཞིའི་ས་ཐོབ་འགྱུར།",
    "སྒྱུ་ལུས་བདེན་མེད་ཅེས་པ་ནི་སྒྱུ་མ་ལྟར་སྣང་ཡང་རང་བཞིན་མེད་པའི་ལྷའི་སྐུ་ཞིག་ལ་སྒྱུ་ལུས་སུ་འཇོག་པའི་དོན་དང་།",
    "ཆགས་སྡང་རང་གྲོལ་བཅུ་བཞིའི་ས་ཐོབ་འགྱུར།",
    "གཉིས་པ་སྐུ་ལུས་ཆགས་སྡང་རང་གྲོལ་ལ་གསུམ།",
    "འདི་ལའང་རང་ལུས་ལྷ་སྐུའི་ལམ་འཁྱེར་ནི་གུ་མའི་ཞལ་ནས།",
    "འགྲོ་འདུག་དང་།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "གཉིས་པ་སེམས་རྣལ་དུ་འདུག་པ་ཉིད་ནི།",
    "དོན་ལ་འཆི་བ་མེད་ཀྱང་འཁྲུལ་སྣང་དུ་ཡོད་པསང་ལ་ཡང་འཆི་བའི་སྣང་བ་འཆར་བར་འདུག་སྙམ་དུ་བསམས་ནས།",
    "རྟོག་པ་ནམ་སྐྱེས་ཙ་ན་ངོ་ཟིན་པར་བྱ།",
    "དེའི་ངོ་བོ་ལ་བལྟས་པས་འདི་འདྲ་འདུག་བྱ་བ་ངག་ཏུ་སྨྲ་རྒྱུའམ།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "ཁྱེད་རང་རབ་ཏུ་མ་བྱུང་ན་ལེགས་ཤིང་སྐྱེ་བོ་བྱས་ན་རིགས་རྒྱུད་ལ་སྤྲུལ་པའི་སྐུ་ཁྱད་པར་ཅན་འབྱུང་ཞིང་དེས་བསྟན་འགྲོ་ལ་ཕན་པ་རླབས་པོ་ཆེར་འགྱུར་བའི་ཚུལ་ནན་ཏན་དུ་ལུང་བསྟན་པའི་ཚུལ་ད་ལྟའང་ཡོད་པར་སྣང་།",
    "ཕྱིས་དཔྱད་དུས་བྲག་དེར་སྐུ་ཚབ་ཁྱད་པར་ཅན་ཞིག་གཏེར་དུ་བཞུགས་ཡོད་པ་ཡིན་འདུག་གསུངས།",
    "གོང་སྨྲོས་ལྟར་གཞི་བཀོད་ཡོད་པ་ལ་མ་ཚོར་བར་ཁོ་རང་བྱུང་ནས་གཞི་རྡོག་པས་འཕྱགས།",
    "མནལ་ལམ་ཟུར་ཙམ་གསུངས་པ་ལའང་དང་ལེན་མེད་པའི་ཁར་ཁྱད་གསོད་ཁོ་ན་ཞུས་ཡོད་འདུག།",
    "ཚིག་དེ་ལྡེབ་མ་དེའི་མདུན་རྒྱབ་ཀྱི་ཕྲེང་གར་ཡོད་ཀྱང་མི་ནོར་བར་མཁྱེན་པའི་ཤེས་རབ་ཀྱི་རླབས་བསམ་ལས་འདས་པ་ཞིག་ཏུ་བྱུང་འདུག།",
    "ཐོག་མར་གཞན་ཅིའང་མི་མཁྱེན་མ་ཡུམ་ཁོ་ན་ངོ་མཁྱེན་འདུག་གསུངས།",
    "སེམས་དོན་གྱི་ངོ་སྤྲོད་ཕུལ་བས་ཕྱིས་ཀྱང་སེམས་ཀྱི་ངོ་བོ་ལ་དེ་ལས་བོགས་དབྱུང་དུ་མི་འདུག་གསུངས།",
    "བྱམས་པའི་སྐུ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་ཐིགས་པས་འཇིགས་ལ་ཁད་དུ་འདུག།",
    "མ་ཧཱ་སནྡྷི་པ་ཨནྱ་ཧི་ཏའང་བཞུགས་འདུག།",
    "སྟོད་ཆ་དེར་ཚིག་འགའ་ཞིག་འདུག་ཀྱང་བརྗེད།",
    "གཤམ་དེར་སྙན་བརྒྱུད་འཆི་མེད་བཅུད་ལེན་ཟུར་དུ་བྲིས་པ་འདི་ཇི་ལྟ་བ་བཞིན་གདའ།",
    "འདི་ལྟར་འདུག་ཅེས་ཞུས་པས།",
    "དམ་ཚིག་གཙང་བ་ཡིན་འདུག།",
    "ལུང་ཡོད་ཀྱང་བརྒྱུད་པ་ངེས་འདྲོངས་མི་འདུག་གསུངས།",
    "ཁ་ཕྱེ་བས་གནམ་ལྕགས་རྡོ་རྗེ་དངོས་གཙང་ཁྱད་མཚར་ཞིག་འདུག།",
    "སྐལ་བཟང་དང་དམ་ཉམས་གཉིས་ཀ་མང་དུ་བསགས་འདུག་ཕེབས།",
    "རྡོར་སེམས་སྐུ་དངོས་ལྟ་བུ་ཞིག་ལ་སྐུ་སྨད་དུ་རིང་བསྲེལ་གྲངས་མེད་པ་འབྱར་ནས་འདུག་པ་མཇལ་བར།",
    "ནངས་ནུབ་ཟས་ནོར་ཏེ་འདུ་བ་རྣམ་པ་གསུམ་རྣམས་ནི་ཐམས་ཅད་ཀྱི་མཐུན་སྣང་དུ་གྲུབ་པ་དེར་གདའ།",
    "ངེད་ལ་སློབ་དཔོན་པདྨས་བོད་ཡུལ་གྱི་གཙུག་ལག་ཁང་ཅི་ཡོད་གཉེར་གཏད་པ་ཡིན་ཀྱང་ཁྱེད་རང་རྣམས་ཀྱིས་གསོལ་མཆོད་ཙམ་མི་བྱེད་པའི་ཐོག།",
    "ལར་ཁྱེད་རང་རྣམས་ནས་བྱ་དགོས་ངེས་དེ་ཅིའང་མི་བྱེད།",
    "འདི་དེ་ཙམ་གྱི་རྙིང་ཉམས་བཅའ་ཁ་སོགས་མི་འདུག་པས་ནམ་ཅི་ཆེ་གསུངས་པས།",
    "རྗེ་ཉིད་ཁྱམས་ཡངས་པ་ཞིག་ན་ཁྲི་མཐོན་པོར་བཞུགས་འདུག་པ་ལ།",
    "ཤོག་སེར་ཆུང་ངུ་ཞིག་འདུག་སྟེ་ངེད་ནས་ཀློག་མི་ཤེས་གསུངས།",
    "ལར་ཁྱེད་རང་ལ་བྱང་གཏེར་འདིའི་བག་ཆགས་ཆེན་པོ་ཡོད་པ་གསུངས།",
    "དེས་རྩ་མདུད་གྲོལ་བས་དེ་ཕྱིན་ཆད་ཤོག་སེར་འབེབ་པ་ལ་ཐོགས་པ་མེད་པ་དང་ཚིག་དོན་ཐམས་ཅད་རིམ་བཞིན་ཇེ་ལེགས་ཇེ་ཟབ་ཏུ་གྱུར་པ་བྱུང་འདུག།",
    "དེར་སུ་འདུག་བལྟ་དགོས་དགོངས་ནས་ཕེབས་པས།",
    "དེར་མངའ་རིས་རིག་འཛིན་ལེགས་ལྡན་རྡོ་རྗེ་ཉིད་སྔགས་པའི་ཆ་ལུགས་ཅན་དུ་བཞུགས་འདུག་པ་ལ་གུས་འདུད་མཛད་ནས་འདིར་ཕེབས་དོན་ཅི་ཡིན་ཞུས་པར།",
    "ཁྱེད་རང་གསུམ་ཙམ་མ་གཏོགས་སྐས་ཆེན་འདི་ཚུགས་ཐུབ་པ་ནི་སུའང་མི་འདུག་ཟེར་བ་ཞིག་བྱུང་བས་འདི་ལའང་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གསུངས།",
    "སྤང་ལྗོངས་ནེའུ་གསེང་ཆུ་མཚོ་རྣམས་ལ་མེ་ཏོག་དཀར་དམར་སྣ་ཚོགས་ཀྱིས་སྤྲས་ཤིང་ཤིན་ཏུ་ཉམས་དགའ་ལ་ཡིད་དུ་འོང་བ་ཞིག་ཏུ་ཕེབས་འདུག་པར།",
    "འཇིག་རྟེན་གྱི་ངོས་ནས་ཀྱང་རྗེ་ཉིད་ཀྱི་ཡབ་དེ་ཤིན་ཏུ་བློ་དྲང་ཞིང་ངོ་ལྐོག་ཐུབ་པ་ཞིག་ཡོད་འདུག་སྟབས།",
    "ཐ་ཆད་འགའ་ཞིག་རྣ་བ་སུན་སྣང་ཡང་སྐྱེ་སྲིད་པར་འདུག།",
    "མཐར་འཆི་དུས་ཀྱང་གཅིག་པུར་འཆི་བས་གལ་ཆེ་ཤོས་དེ་གཉིས་ལ་བློ་སྟོན་གྲོས་བྱེད་མཁན་སུ་མི་འདུག་པ།",
    "རྗེ་ཉིད་སྐུ་ན་གཞོན་ནུའི་དུས་སྐུ་གཟུགས་ཐང་པོ་ཞིག་ཡིན་འདུག་རུང་།",
    "ཐ་ན་སོ་སོའི་ལམ་མཐུན་མན་ངག་ཚད་ལྡན་ཤོག་ལྡེབ་གཅིག་འདུག་ཀྱང་གསར་བྲིས་ཀྱིས་བཞེངས་པར་མཛད་པའི་པུསྟི་ཉིས་བརྒྱ་ཡར་བརྒལ་དང་།",
    "གཡོན་ཕྱོགས་ནས་གླེགས་བམ་ཞིག་བླངས་ཏེ་བསྟན་པ་ཤེར་ཕྱིན་སྡུད་པའི་རྒྱ་དཔེར་འདུག།",
    "ད་ནས་དུས་ཡོལ་ཟིན་པས་ཅི་བྱ་མེད་ནའང་ཁྱེད་རང་ལ་ཐེངས་པ་ཡིན།",
    "ཡང་མེ་ཡོས་ལོར་རྗེ་ཉིད་དང་མཆོག་གླིང་ལྷན་རྒྱས་ཕེབས་བཞུད་མཛད་སྐབས་ཡབ་གཞིས་རི་བོ་ཁྱུང་ལྡིང་ངམ་ཁྱུང་ཚང་བྲག་ནས་རྡོ་སྒྲོམ་རིམ་པ་གསུམ་པ་ཞིག་སྤྱན་དྲངས་པ་ལ་རྩ་གསུམ་བཀའ་འདུས་ཀྱི་ཆ་ལག་རྗེས་འབངས་ཉེར་ལྔ་སོ་སོའི་སྒྲུབ་ཐབས་དམ་རྫས་བཅས་བཞུགས་པ་ཡིན་འདུག་ཀྱང་།",
    "པདྨ་ཤེལ་རིར་གཏེར་ཁ་ཞིག་ཡོད་པ་སོགས་རྗེ་ཉིད་སྔར་ཕེབས་སྐབས་གྲ་འགྲིགས་པོ་མ་བྱུང་བ་དང་ད་ཕན་དངོས་ཀྱིས་ཕེབས་པ་མི་འོང་བར་འདུག་པས་དེ་རིགས་ལོན་རྒྱུ་བྱུང་ན་གལ་ཆེ་བ་ཡོད་ཚུལ་བཀས་གནང་བ་ལྟར།",
    "གཞན་ཐམས་ཅད་རྗེ་ཉིད་ནས་འབེབ་པར་གནང་འདུག་པ་དང་།",
    "འདི་སྐོར་དག་སྣང་མང་དུ་འདུག་ཀྱང་འདིར་མ་བཀོད།",
    "ཕྱིས་སུའང་དགོངས་པ་ཆེད་དུ་གཏད་ན་ཞིབ་ཆ་མཁྱེན་པར་འདུག་གསུངས།",
    "ནག་ཕྱོགས་དར་ན་ཕུང་ཁྲོལ་ཚབ་ཇེ་ཆེར་འགྱུར་བས་དམ་སྲི་འདི་རྣམས་བསྒྲལ་དགོས་ཞེས་ནན་གྱིས་བཏུད་ནས་ཟེར་འདུག་པ་ལ།",
    "དངོས་སུའང་ཁྲག་དྲི་སྣོམ་པ་སོགས་བྱུང་འདུག།",
    "དེ་རྗེས་ངོས་གཟུང་མེད་པའི་བསྙུན་ཁམས་ཀྱིས་གསུང་འགག་པ་སོགས་ཀྱང་བྱུང་འདུག་པས།",
    "དེ་སྐབས་བསྟན་པའི་རིམ་གྲོ་འདོན་བྱ་སོགས་སྒྲུབ་མཁན་མང་འདུག་ཀྱང་དོན་དུ་རྗེ་འདི་ཉིད་ཀྱི་ཐུགས་རྗེས་ནག་ཕྱོགས་གདུག་པའི་ཚ་ངར་ཕྱེད་ཙམ་ཞི་ནས་རྒྱལ་ཁམས་སུ་བདེ་སྐྱིད་སྤྲིན་བར་གྱི་ཉི་མ་ཙམ་བརྡོལ་བར་མངོན་ནོ།",
    "རང་རང་ཉམས་ལེན་མཐར་དབྱུང་ལ",
    "བར་སྣང་དུ་སླེབས་པ་ལྟ་བུ་མཐོ་བའི་ནང་དུ་ཁྲི་སྟན་ཞིག་འདུག་པ་ཉིད་ཀྱི་ཡིན་སྙམ་གྱིས་དེར་བཞུགས།",
    "བར་དན་དུ་ཆང་བུམ་ལྟ་བུའི་ལྗང་གུ་ཆེ་ལེགས་ཤིག་འདུག་པ་ན་ཉིད་སྔར་མལ་བཞུགས།",
    "ཁྱེད་རང་རྣམས་སློབ་དཔོན་པདྨ་དང་།",
    "དེ་སྔ་གཏེར་སྟོན་གྱི་མིང་ཐོགས་མི་འདུག།",
    "ཞེས་གསུངས་པའང་ཇི་བཞིན་བྱུང་བར་འདུག་གོ།",
    "ཁྱེད་སྔ་འགྱུར་ལོ་ཙཱ་བ་ཡིན་ན་རྗེ་འབངས་ཉེར་ལྔའི་གྲལ་དུ་མི་འདུག་ན་གསུངས་པས།",
    "བེ་རོ་ཙ་ན་བཞིའི་གདམས་ངག་ཐམས་ཅད་ཡོད་པ་ཡིན་གསུངས།",
    "ད་རུང་གཏེར་རྙིང་སྐོར་ཉི་ཤུ་རྩ་ལྔ་ཁ་ལོངས་པ་ཞིག་ཕབ་རྒྱུ་དང་འཇོག་རྒྱུ་ཐོན་ན་ཁྱེད་རང་གཉིས་ཀ་ད་རུང་ལོ་ཉི་ཤུ་རྩ་ལྔ་སྡོད།",
    "ནོར་བུའི་ཁང་པ་དང་རྒྱན་སོགས་ལ་ལོངས་སྤྱོད་པའི་ཡ་མཚན་ཅན་ཞིག་འདུག་སྙམ་བྱེད་པའི་ངང་དེ་ལས་སད་གསུངས།",
    "གསོལ་ཚིགས་ཤིག་ཞུ་དགོས་ཟེར་འདུག་པས་རྟ་འདི་འཆིབ་ནས་གསོལ་ཚིགས་ལ་འབྱོན་པར་ཞུ་ཟེར།",
    "འདི་ནང་བྲམ་ཟེ་སྐྱེ་བདུན་ཤ་རིལ་སྟོང་ཕྲག་གསུམ་ཡོད་པ་སྔར་ལས་འཕྲོ་གླིང་པ་ལ་ཕུལ་བ་ཁོང་འགྲོ་དོན་ཆེ་བས་ད་གཅིག་ལས་ལྷག་མི་འདུག།",
    "ཟབ་བུ་ལུང་གཏེར་ལུང་མཇལ་དུ་འགྲོ་བ་ཡིན་ཁོ་ན་གསུངས་ཀྱིན་འདུག།",
    "ཕྱི་དྲོ་ལུང་པའི་རྐེད་ཙམ་སླེབ་པ་ཆུ་ཕར་ཀ་དེར་འབྲོག་དུད་ཕྱུག་པོ་ཞིག་འདུག་པ།",
    "ཉིད་དཔོན་སློབ་ནས་ཕོ་གཏོར་སོགས་འབག་འབོག་མི་མཛད་པར་ཞུ་འདུག།",
    "ཞལ་རྒྱན་ཅུང་ཟད་ཡོད་པ་ཞིག་ཆར་ཡིབས་ལྟ་བུས་བཞུགས་འདུག་པ་བཞེངས་ནས།",
    "སེང་ཁྲིའི་ཕྱོགས་བཞིར་སྒོ་འདུག་པས་ཕྱོགས་བཞི་ཀར་ཕེབས་ཀྱང་སྒོ་རྣམས་བཅད་པས་ནང་དུ་མ་བརྟོལ།",
    "འདི་ལ་རྫོགས་རིམ་ལས་ཚོགས་སོགས་ཟབ་རྒྱས་བཞུགས་ཡོད་འདུག་ཀྱང་རྩ་བའི་ཕྲིན་ལས།",
    "རྣམ་རྒྱལ་མའི་སྒྲུབ་ཐབས་ཙམ་འབེབ་པར་མཛད་འདུག་གོ།",
    "དེར་ཤིང་ལོ་སྔོན་པོའི་སྤྱིལ་བུ་ཞིག་འདུག་པ་སྒོར་ཕེབས་པས།",
    "ཁྱེད་རང་ཐམས་ཅད་ཀྱི་བརྒྱུད་པ་ལ་ཡོད་ཅིང་གསོལ་བ་འདེབས་ཡུལ་ས་ར་ཧ་ཞེས་པ་དེ་ཡིན་གསུངས།",
    "ཁྱེད་ནས་ད་སྔ་བསྙེན་རྫོགས་སུ་ལ་མ་བསྒྲུབ་འདུག་པས་ད་སྟེ་མི་ལྔ་བཅུ་ལ་བསྙེན་རྫོགས་བསྒྲུབ་དགོས་པས།",
    "དེར་ལས་གྲྭ་མི་སུའང་མི་འདུག་པས་ཅི་འདྲ་མཛད་རྒྱུ་ཡིན་དགོངས་པས།",
    "གཏེར་རྒྱ་མང་དུ་འདུག་པ་རིམ་པར་བཤིགས་པའི་བར་བར་དུ་གསེར་ཞུན་མའི་འདམ་བག་དང་།",
    "དབུས་ཕེབས་སྐབས་ཀྱི་ལོ་རྟ་ཞལ་འཆམས་མིན་ཅུང་འདུག་པ།",
    "རང་ཚང་ལ་དོ་ནུབ་དགྲ་ཞིག་ངེས་པར་ཡོད་འདུག་པས།",
    "གང་ཡང་མི་འདུག་ཞུས་པ།",
    "དམ་པ་གོང་མའི་ཐུགས་གཏད་ཆེ་བབས་ཅིར་གྱུར་མི་བྱོན་ལས་ཐབས་མི་འདུག་གསུངས་ནས་གསང་གཞུང་དུ་བཞུགས་ནུབ་སྨག་ལམ་ཤིན་ཏུ་འཚུབས་ཤིང་བསྙུང་བབ་ཀྱི་ཚུལ་ལྗི་བར་ཤར་བས།",
    "གྲྭ་ངོ་རྣམས་ནས་ཡར་འབྱོན་ཐབས་གཏན་ནས་མི་འདུག་པས་ས་ཐག་ཉེ་བསྟུན་རང་དགོན་དུ་ཕེབས་པར་ཞུས་བཞིན་གནས་བརྟན་དགོན་དུ་ཕྱིར་ཆིབས་སྒྱུར་ཕེབས་གྲུབ།",
    "གཞན་རིས་མེད་ཀྱི་བླ་སྤྲུལ་རྣམས་ཞལ་འཆམས་པར་འཕྲལ་འཚུབ་ངོ་ཙམ་ལས་ནམ་ཕུགས་མི་སྐྱོན་པའི་ཚུལ་རང་གསུངས་འདུག།",
    "བསྒོམས་ནས་ཉམ་ཆུང་རི་ལ་རྒས་པ་ཡིན་ཟེར་མཁན་ནི་སྲིད་མཐའ་མ་བཀག་ཙམ་ལས་མི་འདུག།",
    "གྲུབ་ནས་བརྟུལ་ཞུགས་སྤྱོད་པ་ཡིན་གསུངས་མཁན་ནི་མང་བར་འདུག་པས།",
    "ཡུལ་མིས་མཐོང་བས་རི་རྩེར་ཁྱུང་ཕོ་ཞིག་བབས་འདུག་ཅེས་གླེང་།",
    "དེ་ནས་བརྩམ་ལོ་བཅུ་གཉིས་བར་དུ་ལོ་ལེགས་སྐྱ་རྒྱལ་བྱུང་བར་འདུག།",
    "ལོ་དྲུག་པ་བདུན་པ་གཉིས་ལ་ཀློག་སློབ་འདུག་པས་འབྲུ་དེད་ཅུང་ཟད་དང་།",
    "ཕྱིས་བསམ་དུས་ད་ལྟ་མི་གྲལ་ཚུད་ཙམ་འདི་ཕ་རྒན་དེའི་དྲིན་ཡིན་པར་འདུག་པས་དྲིན་ཤིན་ཏུ་ཆེ་ཞིང་།",
    "དེ་འདྲའི་མི་དྲང་པོ་དང་ཤེས་པ་ཅན་ད་ལྟ་ནི་ཡོད་དཀའ་འདུག་སྙམ།",
    "ཕྱིས་ཀྱི་མི་རབས་གསུམ་ཙམ་ལ་རྟེན་བཞེངས་འཚོགས་སྒོ་སོགས་གང་རྒྱས་བྱུང་བར་འདུག་ཀྱང་།",
    "བེ་རོ་ཙ་ན་རྣམས་ཀྱི་སྐུ་བྲིས།",
    "དེ་ལས་སད་ཙ་ན།",
    "ཁ་མཁས་འདུག་གསུངས།",
    "འདི་ཉིན་ཁ་བ་ཆེ་བ་ཞིག་བབ་པ་ལམ་བཀྲ་ལེགས་པའི་མཚན་མར་འདུག།",
    "དེ་ལྟ་ན་སེམས་ངོ་ཟེར་བ་སེམས་འཛིན་དང་རྟོག་མེད་བཞག་པ་སོགས་དོན་མེད་སྟོང་སྐོར་རང་བབས་ཀྱི་ཤེས་པ་ཐད་ཀར་སྐྱོང་བས་ཆོག་པར་འདུག་སྙམ་པ་བྱུང་།",
    "ཕྱིས་ཀྱང་ངོ་བོ་ལ་ནི་དེ་ཀ་ལས་འཕོ་འགྱུར་མི་འདུག།",
    "ཕར་བལྟས་པས་ཟིལ་ཁྲོམ་རི་ལོགས་ཐམས་ཅད་ཁེབས་པའི་འཇའ་གུར་ཞིག་ཀྱི་ལེར་འཁོར་འདུག།",
    "དེ་གའི་ཚེས་དྲུག་ལ་བསྙེན་རྫོགས་ཞུ་མཁན་ཁ་ཤས་འདུག་པས།",
    "མཆོད་རྟེན་རི་ཆེན་པོ་ཙམ་གསུམ་འདུག།",
    "དེ་ནས་རི་ངོས་ཤིག་ཏུ་ཕྱིན་པས་སྦྲ་ནག་ལྟ་བུ་ཆེ་ཆུང་མང་པོ་འདུག་པ་ལ།",
    "ང་རང་ཞེ་གཏིང་ནས་ཡོན་དགེ་གཏེར་སྨྱོན་ཡིན་པར་དྲན་འདུག་པས་དེ་རྣམས་ཀྱི་སྟེང་དུ་འཁྲབ་ཅིང་མཆོངས་པས་གྲོ་ལོད་དངོས་སུ་གྱུར་པ་འདྲ་ཞིག་འདུག།",
    "ཁོ་རང་ལམ་འོག་ཏུ་བསྒྲིལ།",
    "དབྱིབས་བྱིས་པ་ལ་ཆེ་ཆུང་དང་ཆ་བྱད་སྣ་ཚོགས་པ་བཞུགས་འདུག།",
    "གསོལ་བ་བཏབ་བཞིན་འགྲོ་སྙམ་ཙ་ན།",
    "ཚུར་ནང་དེ་ནས་ཆུ་ཆེན་པོ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་བབས་འདུག་པ་ད་ཅིའི་རྨི་ལམ་བཟུང་བ་དེ་བརྗེད་ནས་སྐྲག་སྔངས་སྐྱེས་པ་དང་སད།",
    "ཡར་བལྟས་པས་ལྷ་ཁང་གསེར་འཕྲུ་ཅན་ཞིག་འདུག།",
    "འདི་སྐོར་ནུབ་ཅིག་རང་འཆི་འདུག་པས།",
    "འདུག་དུས་དྲན་ཤེས་བསྟེན།",
    "མདུན་ཅོག་ཁར་རྡོ་རྗེ་སེར་པོ་ཁྲུ་གང་ཙམ་གོས་ཆེན་དམར་པོས་དྲིལ་བའི་ཡིག་པོད་ཅིག་བཞག་འདུག།",
    "དེར་ཐུགས་ཤིན་ཏུ་མད་སྙམ་པ་དང་རང་སྔོན་དུ་ཕྱིན་འདུག་པས་པདྨ་ཉིན་བྱེད་དུ་བསྒོམས་ཤིང་གསོལ་བ་འདེབས་པའི་འཕྲོར་སད།",
    "རིག་འཛིན་རྟ་མགྲིན་མགོན་པོ་འཛུམ་ཞིང་བརྗིད་ཆགས་པ་ཞིག་བྱོན་འདུག་པ་དང་ལྷན་ཅིག་སྣང་སྲིད་ལྷ་འདྲེ་བྲན་དུ་ཁོལ་བ་ཡིན་སྙམ་པ་དང་།",
    "གུས་འདུད་ཆེན་པོ་གནང་འདུག།",
    "སྒྲུབ་ཟིན་ཞིག་བྲི་དགོས་འདུག་པ་ཚེས་བཅུའི་ཉིན་ཚོགས་གཏོར་ཕུལ་ནས་གསོལ་བ་བཏབ་པའི་ནུབ།",
    "གཡོན་ཐོད་པ་བསྣམས་པ་ཞིག་ཏུ་གྱུར་འདུག་པས་ཁམས་གསུམ་ཐམས་ཅད་ཞིང་ལྤགས་ཀྱིས་བརྡབས་ནས་ཟིལ་གྱིས་མནན་པ་དང་།",
    "བྱད་ལྟས་དང་རྒྱལ་ལྟས་སོགས་འཚུབས་སེ་བ་ཞིག་འདུག།",
    "ཐོ་རངས་སྐབས་ཤིག་ཉི་མ་སྐྱིད་པོ་ཞིག་འཆར་འདུག་པ་ལ་རྨི་ལམ་བཟུང་ནས་སྐྱབས་རྗེ་པདྨའི་ཞབས་ཀྱི་བཞུགས་གནས་ལ་བསྐོར་བ་ཞིག་བྱས་ནས་འོངས་པའི་ལམ་དུ།",
    "འདི་སྐོར་སྐྱབས་མགོན་རྗེ་ནས་ཅུང་ཟད་འཚུབས་གསུང་རྗེ་ཉིད་དབུར་བཞུགས་ཀྱིས་བླ་བླུ་ཞིག་ཀྱང་བཀའ་དྲིན་བསྩལ་འདུག།",
    "ལག་ཏུ་འབད་མེད་ཐེབས་འདུག་པས།",
    "རང་ཡུལ་དུ་ས་གཡོས་སྐྱོན་གྱིས་ཁང་ནོར་ཐམས་ཅད་ཤུལ་མེད་བཏང་འདུག་པས་མ་རྒན་ཀྱང་ཕྱིར་སླེབས་བྱུང་བས་ཡིག་དྲུག་བཏོན་ནས་མཉམ་དུ་བསྡད།",
    "དེ་རྒྱབ་སྐུ་གཤེགས་པས་མཇལ་མ་ཐུབ་པ་ལ་དགོངས་འདུག།",
    "ལན་གཅིག་ཀ་ཐོག་པ་བྱམས་པ་འབུམ་པ་སྐུ་བོངས་ཐུང་ལ་སྐུ་ཤ་རྒྱས་པ་ཞིག་ཕེབས་བྱུང་བ་རང་ལ་ཐུབ་སྐུ་ལོངས་སྤྱོད་རྫོགས་པ་ཞིག་འདུག་པ་དང་སྲུང་བ་སོགས་ལ་རབ་གནས་ཞུས་པ་དང་།",
    "སྤྲིན་དཀར་གྱི་དབུས་ན་རྭ་ལོ་ཙཱ་བ་རྡོ་རྗེ་གྲགས་གསལ་བར་བཞུགས་འདུག་པ་དང་།",
    "ཕུག་ལོགས་སུ་འོད་དཔག་མེད་དམ་བྱམས་མགོན་གང་ཡིན་མི་འབྱེད་པའི་དེ་བཞིན་གཤེགས་པ་འཁོར་དུ་མ་དང་བཅས་ཏེ་བཞུགས་འདུག།",
    "དེ་རྗེས་ནུབ་ཅིག་སྤང་ལྗོངས་མེ་ཏོག་བཀྲ་བའི་རིའི་སྒང་ཞིག་ལ་ས་ལམ་གྱི་རྣམ་གཞག་ཐམས་ཅད་གྱེན་དུ་བརྩི་ཆོག་པ་ཞིག་འདུག་པ།",
    "བི་མ་ལ་བཅས་གསུམ་གཟི་བརྗིད་དང་ལྡན་པར་བཞུགས་འདུག་པ་མཐོང་ནས་ས་ལ་བབས་ཏེ་བསྐོར་བ་དང་།",
    "ཁྱེད་རང་རྗེས་ལ་བྱོན་དང་།",
    "ཕྱིར་ཉིན་རྡོ་སྟོད་ཀྱི་ཡུལ་མགོར་སླེབས་པ་དང་ཐང་ཡག་མགར་བ་ཟེར་བའི་དམ་ཅན་གྱི་བླ་རི་དེ་མཐོང་འདུག།",
    "ལྷ་བསང་བཏང་ནས་ཟླ་བ་བཞི་པའི་ནང་རང་ཡུལ་ལོག་པའི་སྒར་བཏེགས།",
    "དེ་སྐབས་ནམ་ཟླ་དབྱར་ཀར་པོ་ཚོ་ལོར་བགྲོད་བདེ་བར་སྣང་བས་ཞག་གཅིག་སྒར་ནུབ་ཁང་པ་ཞིག་ཏུ་ཕྱིན་པར་བན་ཧོར་ན་ཁྲེབ་སྤུན་གཉིས་བསྡད་འདུག།",
    "དེར་རཏྣའི་རྟ་མགྲིན་ནག་པོར་བསྐྱེད་ནས་ཕྱག་གཡས་རལ་གྲི་མགོ་ལ་བཞག་པས་གུས་པ་ཆེན་པོས་བཏུད་འདུག།",
    "སྒར་པ་ལེན་རྩིས་ཀྱི་གྲ་བསྒྲིགས་ཡོད་པར་འདུག་པས་བགྲོད་ལམ་མ་བདེ་བར་རིང་ཞིག་དེར་ལུས།",
    "དེ་ཕྱོགས་གཞི་བདག་དྲག་རྩལ་ཅན་འགའ་ཞིག་ཡོད་འདུག་པས་ཡིན་ནམ་ལན་གཅིག་ཉིན་རིལ་པོར་ཕྱོགས་ཀུན་ནས་སེར་བ་བབས།",
    "དཔལ་སྤུངས་སྒར་པ་འཕྲོག་པའི་ལྐོག་གྲོས་དཔོན་རིགས་བསམ་གནས་རྣམས་ཀྱི་དམག་ཕལ་ཆེར་ཤོལ་འདུག།",
    "དེར་ཀུན་སྤྲུལ་རང་གཙོས་སྒུག་མི་ཁ་ཤས་ཡོད་འདུག་པ་རྣམས་ནས་ཀྱང་ཅི་བྱེད་མ་བྱུང་ནས་ལོག།",
    "གྱི་ལིང་བཀྲ་ཤིས་རྒྱ་མཚོ་མིག་མཐོང་མཁན་ཡིན་པས་འབྲི་གཉན་ལྡོང་ཤར་གྱི་སྒོ་སྲུང་དཔོན་གཡོག་མང་པོ་ངེད་ལ་བསུ་མར་འགྲོ་འདུག་པ་ལ་རིམ་གྲོ་ཅི་དགའ་དྲིས་པར།",
    "ཉམས་རྟོགས་ཀྱི་རྩལ་ལའང་དེ་ཙམ་གནོད་པ་ཞིག་འདུག་པས་དཀོར་ནག་ལ་བག་མེད་དུ་སྤྱོད་དགོས་པ་འདི་ཡ་ང་ལ་ཡི་མུག་པ་ཞིག་སྣང་ངོ།",
    "ཁྱེད་རང་མ་བུ་རྣམས་ཀྱང་སྡོད་ལོ་བ་མི་འདུག་པས་ཤར་ཁ་ཕྱོགས་ལ་བསོད་སྙོམས་ཕྱིན་པས་དྲགས་ཟེར་བ་ལྟར་རྟ་ཁལ་སོགས་ཇ་སྦྲ་ནས་གཡར།",
    "དེ་ནས་ང་རང་དངོས་དང་འཕྲད་འོང་གསུངས་པ་རྨིས།",
    "འདི་ནི་ཕྱིས་སུ་མཆོག་གྱུར་གླིང་པས་ཐུགས་སྒྲུབ་བར་ཆད་ཀུན་སེལ་གནང་བ་ལ་བལྟས་འདུག།",
    "ཁྲོམ་ཚོགས་ཤིན་ཏུ་མང་བ་བཅས་འདུག།",
    "ཉིད་ནས་བསྐུལ་མ་མཛད་སྣང་ལྟ་བུའི་ཤོག་དྲིལ་ཆེན་པོ་ཞིག་ནམ་མཁར་ཡང་ཡང་བལྟ་ཞིང་བྲི་འདུག་པ།",
    "མཆོད་ཁྲིར་གླེགས་བམ་དམར་པོ་འདུག་པ།",
    "ཟབ་བུ་ལུང་གཏེར་ལུང་མཇལ་དུ་འགྲོ་བ་ཡིན་ཁོ་ན་ལབ་ཀྱིན་འདུག།",
    "ཕྱི་དྲོ་ལུང་པའི་རྐེད་ཙམ་སླེབ་པ་ཆུ་ཕར་ཀ་དེར་འབྲོག་དུད་ཕྱུག་པོ་ཞིག་འདུག་པ།",
    "དེ་བ་གཙང་སྦྲ་ཤིན་ཏུ་ཆེ་བ་ཡིན་པས་ཉིད་དཔོན་སློབ་ནས་ཕོ་གཏོར་སོགས་འབག་འབོག་མི་མཛད་པར་ཞུ་འདུག།",
    "སྐུ་ཤ་རན་པ་ཞལ་རྒྱན་ཅུང་ཟད་ཡོད་པ་ཞིག་ཆར་ཡིབས་ལྟ་བུས་བཞུགས་འདུག་པ་བཞེངས་ནས་ཁོང་འཕྲེང་མགོ་གཏེར་སྟོན་ཤེས་རབ་འོད་ཟེར་ཡིན།",
    "དེ་རྗེས་ཁོང་གཏེར་ལྷུང་ཕྱོགས་སུ་གསོལ་ལྡོམ་བྱོན་འདུག་ཀྱང་ཕྱག་རྫས་ཅིའང་མེད་སྐབས་ཡིན་པས་རང་ནས་གོས་སྣེ་གཉིས་ཙམ་དང་།",
    "ལྷ་ཁང་མང་པོའི་ངོས་སུ་ནཱ་རོ་པའི་ལུང་བསྟན་རིམ་པར་བྲིས་འདུག་པ་དང་།",
    "གནམ་དཀྱིལ་ཉི་མ་ཕྱེད་ཙམ་འཛིན་པ་ཞིག་རིམ་པར་ལ་རྒྱབ་འགྲོ་བ་འདུག།",
    "གནས་ར་ཚང་ནས་བཀའ་བརྒྱད་ཁྲོ་རོལ་བཅའ་སྒྲུབ་དགོས་པས་འོང་རོགས་བྱས་འདུག་ཀྱང་ཁོམས་ལྕོགས་མེད་པས་ཚབ་ཏུ་སྐྱ་གཏེར་བཏང་།",
    "འདི་པ་ཀུན་གཞི་བཟང་བ་སོགས་གང་ལ་བརྟགས་ཀྱང་གཞན་དང་མི་འདྲ་ཙམ་ཞིག་འདུག་པས་ཁོང་རང་གསུང་ལྟར་གཏེར་སྟོན་ཞིག་ཡིན་ནམ་སྙམ།",
    "དེ་སྐབས་དཔེ་བཀའ་རྒྱའི་སྐབས་ཡིན་འདུག།",
    "སེང་ཁྲིའི་ཕྱོགས་བཞིར་སྒོ་འདུག་པས་ཕྱོགས་བཞི་གར་ཕེབས་ཀྱང་སྒོ་རྣམས་བཅད་པས་ནང་དུ་མ་བརྟོལ།",
    "རྨི་ལམ་དུ་ལོ་བརྒྱད་ཅུ་ལོན་ཉེར་འདུག་པ་དང་།",
    "ས་དམིགས་བཙལ་བར་ཕེབས་པས་སེང་ཕུ་ནས་རྙེད་འདུག།",
    "ཀརྨར་འོང་དགོས་གསུང་འདུག་ཀྱང་ལམ་ཀྱོག་ཆེ།",
    "འདི་ཉིན་རྒྱང་བལྟས་མཁན་རྣམས་ཀྱིས་ངེད་རང་རྣམས་ཀྱི་མཐའ་སྐོར་དུ་འཇའ་དཀར་པོ་ཨ་ལོང་ལྟ་བུས་བསྐོར་བ་མཐོང་འདུག།",
    "ཡང་རྒྱལ་པོ་པེ་ཧར་ནས་ངེད་ལ་གུ་རུ་པདྨས་བོད་ཡུལ་ལྷ་ཁང་བྲེ་ཞབས་ཙམ་ཡན་གྱི་གཉེར་དུ་བརྐོས་པ་ཡིན་ཀྱང་ཁྱེད་རང་རྣམས་ཀྱིས་གསོལ་མཆོད་སྣེ་གཅིག་ཙམ་ཡང་མི་བྱེད།",
    "མཁའ་འགྲོས་རྩ་སྒོ་ཕྱེས་པའི་སྟོབས་ལས་བྱུང་བ་ཡིན་འདུག་པས་འདི་ཉིད་མཛོད་ཆེན་ལྔའི་ཐོག་མ་ཤེས་བྱ་མཛོད་དུ་གཞག།",
    "ཐམ་ཀ་དམར་པོ་ཆེན་པོ་ཞིག་བྱུང་བ་སོགས་རྨིས་པ་ནི་རྗེས་སུ་བོད་དམག་སླེབས་པའི་ལྟས་སུ་འདུག།",
    "ཕུར་པའི་སྒྲུབ་ཆེན་ལན་གཅིག་ཙམ་མཛད་འདུག།",
    "ཕྱིའི་བསྐོར་ལམ་ཞིག་འདུག་པ་ནས་བསྐོར་བ་བྱས་ཏེ་ཤེལ་རྡོ་མང་པོ་བཏུས་ནས་རུམ་དུ་བཙུད་པ་ཞིག་རྨིས།",
    "དབོན་སྤྲུལ་ཉག་ཁོག་ཕེབས་དགོས་བྱུང་སྟབས་འདི་ལོ་དབྱར་གནས་འཛུག་མཁན་མི་འདུག་པས་དགེ་སློང་བཅུ་གསུམ་སྐོར་སྒྲུབ་ཁང་འདིར་དབྱར་གནས་མཛད་རྒྱུའི་མཐུན་རྐྱེན་སྦྱར།",
    "ཚེས་གཅིག་ལ་ཡར་ཕྱིན་པ་དང་འབྲུམ་པ་ཤུལ་ཡང་མེད་པར་དྲགས་འདུག་པས་ཡོན་བདག་ལ་རྐྱེན་ཆེ་བའི་ལྟས་ཡིན་པར་འདུག།",
    "གཤིན་རྗེ་གཤེད་པོའི་ཞལ་འབག་ཟིལ་ཅན་ཤིན་ཏུ་གཉན་པ་ཞིག་འདུག་པ་གྱོན་ནས་ཚམ་རྔམ་བྱས་པ་དང་།",
    "ཀིང་ནག་བཅས་སྐབས་ཀྱང་གཞན་གྱི་རྨི་ལམ་དུ་དགྲ་དཔུང་ཆོམ་ངེས་པའི་རྟགས་བྱུང་འདུག།",
    "ཟླ་བ་བཞི་པར་སྒྲུབ་ཁང་མདུན་གྱི་སྤང་ཐང་དུ་སྒར་པ་མཛད་འདུག་པར་ཕྱིན་ནས་ཚེས་བཅུ་བཞི་ལ་དཀོན་བརྩེགས།",
    "འདིར་ལེགས་འདུག་པས་དེ་རིང་རང་གྲ་བསྒྲིག་དགོས་གསུངས།",
    "དེ་ཀས་ཆོག་འདུག་གསུངས་ནས་གྲལ་ལ་བཞག།",
    "འདིར་མཁའ་འགྲོ་འཁྲུགས་པས་གནོད་པར་འགྱུར་བ་ཡིན་འདུག་ཅེས་ཕྱིར་ནངས་གསུང་འཕྲོས་དང་།",
    "ནོར་བུའི་ཁང་པ་དང་རྒྱན་སོགས་ལ་ལོངས་སྤྱོད་པའི་ཡ་མཚན་ཅན་ཞིག་འདུག་སྙམ་བྱེད་པའི་ངང་དེ་ལས་སད།",
    "རྡོ་རྗེ་འཚོ་འདི་དུས་རྒྱུན་དྲན་ལམ་གསལ་བར་འདུག་གསུངས་པས་སར་གནས་རྣམས་ཀྱི་སྤྲུལ་པ་ལ་ཚད་གཟུང་མེད་པས་འདི་འང་སྐུའི་བཀོད་པ་གཅིག་ཡིན་པར་མངོན།",
    "དགོན་ཆེན་ལ་ཚེས་བཅུ་དགུར་ཕྱིན་པའི་སྔ་ཉིན་ཐང་རྒྱལ་ལྷ་ཁང་ནས་ཚེ་འབར་བལྟམས་མ་ཐག་ཕྱུར་པའི་ཆོ་འཕྲུལ་ཡང་བྱུང་འདུག།",
    "ལོ་བསྟར་གྱི་འདོན་བྱ་རྣམས་ཆག་མེད་དང་ལོ་མཇུག་གཏོར་སྒྲུབ་སྐབས་རྟེན་ཐོད་ཀྱི་བདུད་རྩི་འཕེལ་ཞིང་ཁོལ་ཏེ་ཕྱུར་ལ་ཁད་པར་བྱུང་འདུག།",
    "གཏེར་སྟོན་ཀྱང་ལ་ཐོག་བར་བསུ་མར་ཕེབས་འདུག།",
    "དུར་ངོ་ཞིག་ཀྱང་རྨིས་པ་ཕྱིས་འབྱུང་འཚུབས་ལྟས་ཡིན་ཡོད་པར་འདུག།",
    "སྒོ་ཡིག་སྦྱར་བ་བཅས་དམ་སེལ་ཆེན་པོའི་ཐོག་མ་ཚུགས་པས་དེའི་ལྟས་ཡིན་པར་འདུག།",
    "འདི་སྐབས་དགོངས་རྫོགས་བསྒྲུབ་འཕྲོས་དངོས་ཇ་སྟོང་རྩ་ཕྱེད་གསུམ་ཙམ་གྱི་བབ་འདུག་པ་སྤར་ཡོན་པད་ལེགས་རྩར་ཕུལ་རྒྱུ་བྱས།",
    "ཐར་རྩེ་ཞབས་དྲུང་དང་རང་བཅས་ཀྱིས་གཟུངས་སྒྲུབ་དང་།",
    "སྔ་ལོ་སྐུ་གཤེགས་སྐབས་ཀྱང་འཇའ་ཚོན་སྔ་ཕྱི་མང་དུ་ཤར་བ་ཐམས་ཅད་ཀྱིས་མཐོང་བ་བྱུང་འདུག།",
    "ཉིད་ཀོ་རྡི་སེར་ཁུག་ཅིག་ལ་དབུ་གཏད་ནས་གཟིམས་འདུག་པར།",
    "ཡང་གཏེར་རྡོ་རྗེ་བདུད་རྩི་སྐོར་ཕབ་གྲུབ་འདུག་པས་དཔེ་གནང་ནས་སྡོམ་གཏད་བསྩལ།",
    "ཁོང་དང་རྨོག་སྤྲུལ་གཉིས་ལ་བསྟན་པའི་གཉེར་གཏད་ནས་ཤིས་བརྗོད་རྒྱས་པར་སྤེལ་བ་རྨིས་པ་ལྟར་རྒྱ་སྤྲུལ་ནས་ཕྱིས་གཏེར་མཛོད་ཚར་གསུམ་ཙམ་གནང་རྒྱུ་བྱུང་ཡོད་འདུག།",
    "ཕྱི་རོལ་ཏུའང་འཇའ་ཚོན་དང་མེ་ཏོག་ཆར་པ་འདུག་ཟེར།",
    "གྲོལ་ནངས་རཀྟ་ཕྱུར་ནས་ས་ལ་འཁྱིལ་བ་བྱུང་འདུག།",
    "སྐུ་སྨད་མེད་པ་གཅིག་རྣམས་ངེད་ལ་གནང་ནས་གཅིག་འདི་གསོ་དགོས་གསུངས་པས་འདི་ངོས་ནས་ཐོན་དཀའ་ཞེས་འཚེར་བག་བྱེད་པའི་མནལ་ལམ་བྱུང་གསུངས་པ་འདི་ཕྱིས་འབྱུང་ལྟས་སུ་འདུག།",
    "སྐུ་གཤེགས་རྗེས་གཅིག་ཀྱང་མི་འདུག།",
    "གཉན་ལྡང་དུ་འདུ་བའི་ལྟས་འདུག་པས་གནས་འབྲེལ་ཕྱིན།",
    "རྫོགས་པ་ཆེན་པོ་རང་སྣང་རིས་མེད་ཀྱི་དགོངས་པའི་རྩལ་རྫོགས་པ་ཡིན་འདུག་པས་ཨོ་རྒྱན་ཆེན་པོ་དང་བི་མ་ལ་ཉིད་ལས་གཞན་དུ་མ་མཆིས་པའི་ངེས་ཤེས་སྐྱེས།",
    "བཀའ་ལུང་མང་དུ་སྩོལ་འདུག་པ་ཡུན་ཅིག་མཇལ་བ་རྨིས།",
    "ཅེས་གསུངས་པ་ལྟར་བྲག་དཀར་ཤོག་གསུམ་པ་ཞིག་བཞུགས་པའི་དབུས་མར་སུའང་བགྲོད་དཀའ་བས་སྒྲུབ་ཕུག་ཡོད་འདུག་པའི་ཐོས་མཐོང་གཏན་ནས་མེད་འདུག་ཀྱང་ཤིང་དང་ཐག་སྐས་སོགས་ལ་བརྟེན་ནས་བཙལ་བཅོལ་བ།",
    "ངེད་རང་རང་གནས་སུ་འཁོར།",
    "ལོ་མཇུག་མགོན་པོའི་གཏོར་སྒྲུབ་བྱས་སྐབས་གཏོར་ཆེན་མདུན་ངོས་ཉིལ་འདུག།",
    "རི་ཆེན་དང་གནས་ཆེན་བཞིར་ཚོགས་འཁོར་ཟློག་པ་བབས་འདུག་པས་ཉེ་ཕྱོགས་རྣམས་སུ་གཏེར་སྟོན་དང་ཆབས་ཅིག་བགྲོད་ནས་དེ་དག་ཚང་བ་བསྒྲུབས།",
    "འདི་ཡན་གཏེར་མཛོད་སྤར་པོད་བཞི་བཅུ་ཙམ་བརྐོ་གྲུབ་འདུག་པས་ཞུ་དག་པ་ལྷག་བསམ་དང་ལྷན་ཅིག་གོ་རིམ་བསྒྲིགས།",
    "ཚེས་བཅུར་རྩ་གསུམ་སྤྱི་འདུས་གསར་ཕབ་མཛད་འདུག་པའི་ཚོགས་བཏང་།",
    "སྒོ་གཡས་སཱཙྪའི་ཕུང་པོ་ཆེན་པོ་འདུག།",
    "ཁྱེད་རང་དང་།",
    "ཤེལ་རྡོ་ལེགས་པ་སོར་ལྔ་ཙམ་འདུག་པ་སོགས་རྨིས།",
    "དགོངས་རྫོགས་སྒྲུབ་ལུགས་རྒྱུས་ཡོད་སོགས་ལ་ངེད་རང་འཕྲལ་དུ་འོང་དགོས་པའི་གསུང་བྲིས་བང་མི་བཅས་དབོན་རྒན་སྤྲུལ་མདུན་ནས་མཛད་འདུག་པ་ལྟར་ཕྱིན།",
    "ལོ་མཇུག་གཏོར་སྒྲུབ་སྐབས་གཏོར་ཆེན་ལ་སྐྱོན་བྱུང་ཡོད་འདུག།",
    "ཞབས་བརྟན་རྒྱབ་ཆོག་སྐོར་མང་ཙམ་བསྒྲུབས་འདུག་ཀྱང་།",
    "བལ་པོ་ཨ་ཧཱུྃ་ཨ་ཇོ་དཔལ་པོ་བ།",
    "སེམས་ཉིད་ངལ་གསོ་དང་རང་གྲོལ་སྐོར་གསུམ་གྱི་ཁྲིད།",
    "བེ་རོ་ཙ་ན།",
    "སྨིན་གླིང་གཏེར་ཆེན་གྱི་སྐྱེས་རབས་ཡོངས་གྲགས་བཅུ་བཞི་མ་ནི་གཙོ་བོ་རགས་བསྡུས་ཡིན་པར་འདུག་ཅིང་།",
    "གཏེར་གཞུང་དང་རང་ཉིད་ཀྱི་མཁྱེན་ངོར་གསལ་བ་ནི་རྒྱལ་སྲས་པདྨ་འགྱུར་མེད་རྒྱ་མཚོས་མཛད་པ་ལས་འདི་ལྟར་འབྱུང་སྟེ།",
    "སྤྲུལ་པའི་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན་ནི།",
    "མཚན་ཡང་བེ་རོ་ཙ་ན་རཀྵི་ཏ་ཞེས་གསོལ།",
    "གཏེར་ལུང་རྣམས་ཀྱང་གོང་དུ་སྨྲོས་པ་ལྟར་དགོངས་པ་ཅན་གྱི་གསུང་ལོས་ཡིན་སྙམ་པ་ལས་ངེས་དོན་ཡིན་པའི་ཐག་ཆོད་དང་རློམས་སེམས་གཏན་ནས་མེད་ངེས་ཅན་ཡང་།",
    "རྒྱལ་བའི་གསུང་རྣམ་པ་ཐམས་ཅད་པ་ཞེས་སྒྲ་ཤིན་ཏུ་ཡངས་པས་འབྲེལ་གང་དུ་ཆགས་པ་དེར་ཁྱེར་ཆོག་པས་འདི་ལ་མི་འོས་སྙམ་པ་དང་གཞན་ཞིག་ལ་འཐད་ཀྱང་འདིར་འཐེན་ཁྱེར་བྱས་འདུག་སྙམ་པའི་ཁོང་ཁྲོ་དང་གུ་དོག་གཏན་ནས་མི་དགོས་སོ།",
    "ཞེ་དྲུག་དུས་སུ་ཤིན་ཏུ་འཕྲང་དམ་པས",
    "རྡོ་རྗེ་བེ་ཅོན་སྙིགས་དུས་ཀྱི་དམ་གྲིབ་སེལ་བ་ལ་ཟབ་པར་འདུག་ཅེས་ཀྱང་གསུངས།",
    "ལྷ་ཁང་དུ་ཕེབས་པས་དེར་རྡོ་ཁྲི་བརྟན་ཅིང་ལེགས་པའི་སྟེང་རྩྭའི་སྟན་དང་དེ་སྟེང་ཀྲྀཥྞ་སཱ་རའི་པགས་པའི་སྟེང་དུ་བདག་གུ་ཎ་ས་མུ་དྲ་འདུག།",
    "དེ་ཕྱིར་འདི་ཡང་རང་ལ་ཟོལ་བསྟོད་དང་།",
    "དེ་དང་རྗེ་བཙུན་ཐུགས་རྒྱུད་གཅིག་པ་ཡིན་འདུག།",
    "མདུན་དུ་གཉུག་མར་གནས་པའི་བྱི་ལ་ཐུགས་བརྩེ་བ་ཞིག་ཚེའི་དུས་བྱས་པས་སྐྱབས་མགོན་པདྨ་ཉིན་བྱེད་མདུན་ཡང་བསྔོ་རྟེན་ཕུལ་བས་དེ་ཉིན་པདྨ་བཛྲའི་གནས་འདྲེན་མཛད་པ་དང་ཁེལ་ཡོད་འདུག་པས་དེ་ཡི་ཐུགས་རྗེ་ལོས་ཡིན།",
    "ལུས་ཟུངས་ངན་པས་རང་གཞན་ལ་ཟག་པ་སོག་པའི་སྒྱུ་ལུས་གོག་པོ་འདི་དོར་ན་རུང་སྟེ་ད་དུང་དབུགས་རྔ་ནི་ཆད་ཐུབ་པ་མི་འདུག།",
    "ཐུགས་དམ་ངོ་མའི་མཐིལ་ནི་གང་ཡིན་ཤེས་དཀའ་རུང་ཀར་ལུགས་རྒྱལ་རྒྱམ་ལྷ་དགུ་ལྷ་ལྔ་གཉིས་མ་རྩ་མཛད་པའི་ཉམས་འདུག།",
    "ལོ་ཆེན་འཇིག་རྟེན་མིག་གཅིག་བེ་རོ་ཙ་ན་མཆོད་ཡོན་ནས་བཟུང་ད་ལྟའི་བར་དག་པའི་སྐུའི་སྐྱེ་བ་བརྒྱུད་མར་འབྲལ་བ་མེད་པར།",
    "སླད་ནས་ཉེ་གནས་དམ་པ་ཚེ་རིང་དོན་ཀུན་གྲུབ་པས་ཀྱང་འདི་བགྱིས་གྲུབ་པ་ཅིས་ཀྱང་ལེགས་འདུག་པས་ད་དུང་འཕྲི་བསྣན་འོས་རིགས་ཀྱང་གྱིས་ཞེས་དང་སྤར་དུ་བཀོད་པའི་མགོ་ལུང་མཛད་པ་བཅས་ཀྱི།",
    "ཆགས་ཀྱི་འདུག་ཀྱང་།",
    "བོད་ལྗོངས་སྒྱུ་རྩལ་ཞིབ་འཇུག་ལོའི་རྒྱ་ཡིག་དུས་ས་བདམས་ཏེ་བསྒྱུར་ལ།",
    "དེ་ནས་ཀྱང་རི་སུལ་ཐམས་ཅད་དུ་དར་བས་ཚོགས་པ་ཞག་དུས་བྱས།",
    "ངས་མཚན་ཉིད་པ་ཞིག་བྱས་ན་འགྲོ་ཕན་ཆེན་པོ་འོང་བ་མི་འདུག་སྟེ།",
    "དེ་རྣམས་གང་ལས་ཀྱང་ཕྱི་ཉན་ཐོས་ལ་ནང་གསང་སྔགས་སུ་བྱས་པ་འདིས་འགྲོ་བ་ལ་ཕན་ཐོགས་པ་འདུག་ན་འདི་བྱས་པ་ཡིན་གསུངས་ཏེ།",
    "དེ་ནས་རིམ་བཞིན་བསམ་ཡས་སོགས་ལ་བསྐྱོད་སྲོལ་ཡང་འདུག་བོད་ཟླ་༡༡ཚེས་༣ཉིན་གཙང་ཞ་ལུར་འབྱོར་ཞིང་།",
    "མི་རིགས་ཀྱི་མཚོན་རྟགས་ཤིག་ཏུ་གྱུར་འདུག་དེ་ཡང་བོད་མིའི་འཚོ་བའི་གནས་སྟངས་དང་།",
    "ཞེས་གསལ་པོར་བཀོད་འདུག་པ་དེའི་ཐོག་ནས་གནའ་རབས་ཀྱི་མིའི་བསམ་པར་གནམ་ས་བར་སྣང་དང་བཅས་པ་ཐམས་ཅད་ལྷས་གང་ཞིང་ཡོད་ཚད་ལྷ་ལ་བརྟེན་ནས་བྱུང་བར་ངོས་འཛིན་བྱེད་པ་མཚོན་གྱི་ཡོད།",
    "གེ་སར་སྒྲུང་ནང་དུ་དགྲ་དང་རང་ཕྱོགས་གང་ཡིན་ཡང་དགྲ་ལྷ་བསངས་ཚུལ་འདི་དག་ལ་བརྟེན་ནས།",
    "ཐེའུ་རང་དཀར་ནག་ཁྲ་གསུམ་གྱིས་གཉའ་མནན་ནས་འཕུར་མི་ཐུབ་པར་གདའོ།",
    "ལྷ་རྣམས་གཏམ་གཏོང་ཞིང་རང་བཤོས་གསོལ་བ་མཐོང་།",
    "སྟོན་པར་བལྟས་པས་གཅིག་ཀྱང་མི་འདུག་མར་མེ་ཐམས་ཅད་རང་འབར།",
    "ཐ་ན་སྒྲུང་དཔེ་གྲུབ་བྱེད་ཀྱི་ཆ་རྐྱེན་འགངས་ཆེན་ཞིག་ཏུའང་གྱུར་འདུག་གོ།",
    "གཞན་ཡང་ཉི་ཤུ་དགུའི་ཉིན་དེར་བོན་པོའི་སློབ་དཔོན་གྱིས་གཏོར་རྒྱུག་ཀྱང་རྒྱག་སྲོལ་འདུག་གནམ་གང་དང་ཚེས་གཅིག་ལ་གཙོ་བོ་ཞིམ་ཟས་དང་ཆང་རིགས་ཀྱི་ལོངས་སྤྱོད་ལ་འཇུག་པ་དང་།",
    "མདའ་འཕེན་སྐབས་མདའ་འཕེན་པར་ཡོང་བའི་མདའ་པ་དག་འབེན་གྱི་གཡས་སུ་འདུག་པར་མ་ཟད།",
    "ཞེས་བྲིས་པའི་སྙན་ངག་ཤོ་ལོ་ཀ་རྐང་པ་མི་ཚང་བ་ཞིག་འདུག་པ་མཐོང་ནས།",
    "ཟློས་གར་གྱི་ཁྲོད་ཆེས་རྨད་དུ་བྱུང་བ་བྱ་ལེན་མའི་ཟློས་གར་ལགས་ཞེས་གསུངས་འདུགཟློས་གར་འདི་འཁྲབ་ཚན་བདུན་དུ་ཕྱེ་ཡོད་དེ།",
    "འདུག་པ་ལ་སོགས་པའོ།",
    "ཚིག་འདི་སྐད་ཅེས་དགེ་སློང་ཆུར་ཤོག་བྱེད་འདུག་ཤིག།",
    "སྲོག་གཅོད་པའི་ཁྱིམ་པ་དེ་འདུག་ནས་ཅི་ནས་ཀྱང་རྟག་པར་རྒྱུན་དུ་སྲོག་གཅོད་ཅིང་འཚེ་བར་བྱེད་དམ།",
    "དགེ་སློང་སྡིགཅན་སྤྱོད་པ་འཆབ་པ་འདི་སྙན་འདི་ལཅིའི་ཕྱིང་འདུག་ཅེས་འཕྱ་བར་བྱེད་དོ།",
    "འཆག་ས་རང་འདུག་ས་མ་བྱིན་པ་ལ་ལོངས་སྤྱོད་པར་བྱེད་དོ། ཁབ་རལ་མ་བྱིན་པ་ལ་ལོངས་སྤྱོད་པར་བྱེད་རོ།",
    "ཤཱ་རིའི་དུ་ལདདྭ་པས་བྱིན་པའི་སྟན་ལ་འདུག་པའི་དགེ་སློང་གང་ཡིན་པ་དེ།",
    "ཤཱ་རི་འི་བུ་འདི་ལྟང་དད་བས་བྱིན་པའི་འཕགས་པའི་སྟན་ལ་འདུག་ནས།",
    "ཞེས་ལུངམ་བསྟན་གྱི་ཇི་སྲིད་དུ་ང་རང་མི་ལྡན་པར་གྱུར་པ་ལ་ལྟོས།",
    "ཏད་གདག་ཎ་ཛྙཱ་ན་ཨ་ཙི་ཏཱ་བཱ་ཤ་ཡ།",
    "འཇགརྟེན་སྐྱོང་བརྣམས་ཀྱི་གཟི་བརྗིད་ཟིལ་གྱིས་མནན་ཏེ་འདུག་གེ།",
    "སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་འབྱིན་པ་དང་།",
    "སྡོད་སར་འདུག་ལུགས་ཚུགས་ཐུབ་ཅིང་།",
