    "ཀུན་དུ་བཟང་པོ་མོས་པར་བྱ་བའི་ལེའུ་དང་།",
    "དཔེས་དོན་ཟབ་མོ་མཐོང་ཞིང་དད་པ་བསྐྱེད་པའི་ཕྱིར་དེའི་འོག་ཏུ་དད་པའི་ལེའུ་བསྟན་ཏོ།",
    "ཉན་ཐོས་ཆེན་པོ་བཞི་དོན་ཟབ་མོ་མཐོང་བས་དེའི་འབྲས་བུ་བསྟན་པའི་ཕྱིར་དེའི་འོག་ཏུ་ལུང་བསྟན་པའི་ལེའུ་བསྟན་ཏོ།",
    "དེའི་གཞུང་དགྲོལ་བ་དང་རྣམ་པ་གསུམ་མོ།",
    "གཞུང་ལས་ཀྱང་འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་སྨོས་པས་དད་པ་སྐྱེ་བར་གྱུར་ཏོ།",
    "ཡེ་ཤེས་ནི་ཟབ་མོ་རྟོགས་པར་འགྱུར་བའི་མཐའོ།",
    "ཉིད་ནས་ཉིད་དུ་བརྒྱུད་དེ་ཐོས་པ་མ་ཡིན་པའི་ཕྱིར་བདག་གིས་ཐོས་པ་ཞེས་སྨོས་སོ།",
    "ཡང་འདིར་སུས་ཐོས་པ་མིང་མི་སྨོས་པར་སྤྱིར་བདག་གིས་ཐོས་ཞེས་པ་ཅིའི་ཕྱིར་ཞེས་དྲིས་པ་ལ།་",
    "ཐོས་པ་ཉི་ཚེ་སྨོས་ཀྱི་མཐོང་བ་ལ་སོགས་པ་མ་སྨོས་པ་ནི་དོན་ཟབ་མོ་རྟོགས་པ་ལ་ཐོས་པའི་ཤེས་རབ་སྔོན་དུ་འགྲོ་བ་དང་།",
    "བསྐྱེད་པ་དང་སྐུར་པའི་མཐའ་བསལ་བའི་ཕྱིར་འདི་སྐད་བདག་གིས་ཐོས་ཞེས་སྨོས་སོ།",
    "བཅོམ་ལྡན་འདས་རིན་ཆེན་མང་གི་འཁོར་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་བྱིན་གྱི་རླབས་ཀྱིས་གཟུངས་ཀྱི་སྒོ་འཆད་པའི་ཚེ་ངན་སོང་ཞི་བར་མཛད་པའི་ཕྱིར་དེ་དག་ཏུ་སྨོས་པ་ཡང་ཡོད་དོ།",
    "འཁོར་དེ་དག་གི་རིམ་པ་ནི་སྤྱིར་རྣམ་པ་བཞི་སྟེ།",
    "ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་ནི་ཉན་ཐོས་པ་གྱོརྣམས་ཚིག་གི་དོན་རྣམ་པ་བཅུ་དྲུག་ཏུ་བསྟན་པ་དང་།",
    "སྤྱོད་ལམ་ཕུན་སུམ་ཚོགས་པ་ནི་བཅོམ་ལྡན་འདས་འཁོར་རྣམས་ཀྱིས་བསྐོར་ཏེ་གུས་པ་རི་མོ་བྱེད་པའི་ཚུལ་གྱིས་མཛེས་པར་གནས་པ་རྣམས་སོ།",
    "ཟག་པ་ཟད་པ་ཞེས་པ་ནི་ཉོན་མོངས་པ་མངོན་དུ་རྒྱུ་བས་སྲིད་པ་རྣམས་སུ་ཟག་པར་བྱེད་པའི་ཕྱིར་ཟག་པ་ཞེས་བྱའོ།",
    "མ་རིག་པའི་ཟག་པ་དང་གསུམ་མོ།",
    "གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་ན་ཁྲོ་བ་བཏོན་པའི་ཉོན་མོངས་པ་ལྷག་མ་ནི་སྲེད་པའི་ཟག་པའོ།",
    "དེ་ལ་འདོད་པའི་ཁམས་ཀྱི་ཉོན་མོངས་པ་ཡང་འདོད་པས་གཞི་བྱས་པའི་ཕྱིར་འདོད་པའི་ཟག་པའོ།",
    "གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་ན་ཉོན་མོངས་པ་གཞན་གྱིས་མི་སྐྱེད་ཀྱི་སྲིད་པར་སྤྱོར་བ་ཉིད་ཉོན་མོངས་པ་ཡིན་པས་སྲིད་པའི་ཟག་པའོ།",
    "དེ་དག་གི་འཆིང་བ་མངོན་དུ་རྒྱུ་དང་བག་ཆགས་ཀྱི་ཚུལ་དུ་གནས་པ་ཡང་སྤངས་པའི་ཕྱིར་བྲོན་མོངས་པ་མེད་པ་ཞེས་བྱའོ།",
    "གླང་པོ་ཆེན་པོ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་མི་བདེ་བའི་གནས་ཐམས་ཅད་དུ་སོང་ཡང་ལམ་བདེ་བ།",
    "སྲིད་པར་སྦྱོར་བའི་ཁུར་ལྕི་བ་བོར་བས་རང་གི་དོན་ཐོབ་པ་ཡིན་ཏེ་མྱ་ངན་ལས་འདས་པའི་བདེ་བ་ཐོབ་ཅེས་པའི་དོན་ཏོ།",
    "རང་གི་དོན་བདེ་བ་ཐོབ་པ་ཡང་ཉོན་མོངས་པའི་རྒྱུ་སྤངས་པས་སྲིད་པར་སྦྱོར་བ་ཐམས་ཅད་ཡང་མི་ལེན་ཏེ།",
    "ཚིག་གི་དོན་བཅོ་ལྔ་པོ་གཞན་ནི་དབྱེ་བའི་མཚན་ཉིད་དོ།",
    "རྟག་ཏུ་སྟོང་པ་ཉིད་ཀྱི་སྤྱོད་པའི་ཕྱིར་བྱེད་པ་བྱས་པས་བདག་དང་བདག་གིར་འཛིན་པ་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "ཡོན་ཏན་རྣམ་པ་བཅུ་ལ་ཟག་པ་ཟད་པ་དང་ཉོན་མོངས་པ་མེད་པ་ནི་འཆིང་བ་དང་བག་ལ་ཉལ་བ་གཉིས་སྤངས་པའི་ཕྱིར་རོ།",
    "ཤིན་ཏུ་འདས་པར་གྱུར་པའི་ཡོན་ཏན་ནི་ཁུར་བོར་བ་རང་གི་དོན་ཐོབ་པ་སྲིད་པའི་སྦྱོར་བ་ཡོངས་སུ་ཟད་པ་སྟེ།",
    "ཉན་ཐོས་དེ་དག་གི་རིམ་པ་ནི་ལ་ལ་རབ་ཏུ་བྱུང་བ་སྔ་ཕྱི་ལས་བཀོད་པ་དང་།",
    "ལྟེང་རྒྱས་འོད་སྲུངས་དང་གཞན་ནི་ཆུ་དང་རི་དང་ཤིང་གི་འབྲས་བུ་ལས་བཏགས་ཏེ་མིང་ཙམ་དུ་ཟད་དོ།",
    "མོད་གལ་ཆེན་པོ་ནི་སྔོན་དྲང་སྲོང་ཉིད་རི་ལ་གནས་ཤིང་སྲན་མ་རྨེད་པ་ལས་རུས་སུ་ཆགས་ཏེ།",
    "མོད་གལ་གྱི་མ་དེའི་རྒྱུད་ཡིན་པས་ན་མོད་གལ་ཞེས་བཏགས་སོ།",
    "རྫུ་འཕྲུལ་ཆེ་བའི་ཕྱིར་མོད་གལ་ཞེས་བཏགས་སོ།་",
    "དེ་དག་གི་མཚན་སོ་སོར་དབྱེ་བའོ།",
    "ཡེ་ཤེས་ཆེན་པོ་གཙོར་བྱས་པས་བདག་གི་ཞུདོན་བསྟན་པ་དང་ཐུགས་རྗེ་ཆེན་པོ་གཙོར་བྱས་པས་གཞན་གྱི་དོན་བསྟན་པའོ།",
    "བླ་འོག་གི་ཡན་ལག་ཏུ་དབྱེ་བ་དང་བསྡུས་པའི་དོན་བསྟན་པའོ།",
    "ཕྱིར་མི་ལྡོག་པའང་མོས་པ་ཕྱིར་མི་ལྡོག་པ་དང་།",
    "ཚིག་དང་པོ་དགུས་ནི་རང་གི་དོན་བསྟན།",
    "འོག་མ་གཅིག་གིས་ནི་གཞན་གྱི་དོན་བསྟན།",
    "འོག་མ་གཅིག་གིས་ནི་རྗོའདུས་མ་བྱས་ཀྱི་ཡོན་ཏན་བསྟན།",
    "དང་པོ་གསུམ་གྱིས་ནི་ནང་གི་སྤྱོད་པ་བསྟན།",
    "བདག་གི་དོན་བསྒྲུབ་པ་དང་།",
    "དེ་ཡང་རྣམ་པ་གསུམ་མོ།",
    "ཐོས་པ་ལ་སོགས་པ་ནི་བདག་གི་དོན་ཏོ།",
    "ཇི་ལྟར་འཁོར་ལོའི་འཁྲུལ་བས་གཅོག་ཅིང་གནོན་པ་བཞིན་འཕགས་པའི་ལམ་ལ་གནས་པའི་སེམས་ཀྱི་ཉོན་མོངས་པ་འཇོམས་པ་ཞེས་བྱ་བའི་ཀྱེདོན་དང་གསུམ་མོ།",
    "ནང་གི་འཁོར་ལྔ་ནི་གོང་དུ་བསྟན་པ་ཡིན།",
    "ཉི་མ་ལྷའི་སྲས་པོ་ནི་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ནང་གི་ཆེན་པོ་ལ་རྒྱང་གྲགས་བཅོ་བརྒྱད་ཀྱིས་སྟི།",
    "ནང་གི་ཆུང་ངུ་ནི་རྒྱང་གྲགས་བཞིས་འཁོར་ཞེས་འཆད་དེ།",
    "གཞན་ལས་ནི་ཡི་དྭགས་དང་བྱོལ་སོང་གི་ཁམས་སུ་གཏོགས་པར་ཡང་འཆད་དོ།",
    "དེའི་འོག་ཏུ་བདག་གི་དོན་དུ་སྤྱོད་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་མན་ངག་གི་གནས།",
    "འགྲེལ་པ་ལས་མཐའ་ཡས་གདོན་མི་ཟ་བར་བསྟན་པ་ཞེས་པ་ནི་ཚིག་དང་དོན་རྫོགས་པ་མིང་གི་རྣམ་གྲངས་བཅུ་བདུན་ཏེ།",
    "སྙོམས་པར་ཞུགས་རྗོཞེས་པ་ནི་མཐའ་ཡས་པའི་དོན་ཟབ་མོ་ལ་སེམས་མཉམ་པར་གཞག་ཅེས་པའི་དོན་ཏོ།",
    "སྔོན་བསྐལ་པ་གྲངས་མེད་པ་འདས་པའི་དོན་རྣམས་ཞེས་པའང་ཏིང་ངེ་འཛིན་དུ་ཞུགས་པ་ལས་འབྱུང་གི་གཞན་གྱིས་མ་ཡིན་ནོ།",
    "མེ་ཏོག་དེ་དག་གི་ཡོན་ཏན་ཡང་རྣམ་པ་ལྔ་སྟེ།",
    "དེ་ཡང་ཚོགས་བཞིར་བསྡུའོ།",
    "སྣང་བ་དེས་མཚོན་པས་འཇིག་རྟེན་ནས་འདྲེན་པ་དང་ནང་གི་ཁྲུ་བསྟན་པ་ཡེ་ཤེས་ཀྱི་དུ་འོད་ཡིན་པར་མཚོན་པ་དང་།",
    "འོད་ཀྱིས་སྙུརེག་པ་རྣམས་སྡུག་བསྔལ་ཞི་བར་བྱེད་པ་དང་།",
    "འགྲོ་བ་ཞེས་པ་ནི་ཉོན་མོངས་པ་དང་།",
    "རང་གིས་ཐུབྱས་པའི་ལས་ལ་སྤྱོད་པའི་ཕྱིར་ལྷའོ།",
    "དད་པ་ནི་མོས་པས་ཉཉུསྤྱོད་ཅིང་འཕགས་པའི་འབྲས་བུ་མ་ཐོབ་པའི་སའོ།",
    "འགྲེལ་པ་ལས་ཀྱང་དོན་ཟབ་མོ་གཅིག་ལ་དྲིས་དང་མང་པོ་ཐོས་པར་འགྱུར་བས་ཀུན་གྱི་ཐེ་ཚོམ་གཅོད་པ་ནི་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པའོ་ཞེས་འབྱུང་།",
    "རང་གི་སེམས་ཀྱིས་རྟོགས་པ་ཉིད་ཡིན་གྱི།",
    "ཚིགས་བཅད་དང་པོ་གཅིག་གིས་ནི་འོད་ཀྱིས་ཏྲེསྣང་བར་མཛད་པའི་གླེང་གཞི་སྟོན་ཏོ།",
    "དེའི་འོག་གི་རྩ་བ་ལྔ་བཅུས་ནི་ཡུལ་རྣམས་སྣང་བར་མཛད་པའི་གླེང་གཞི་བསྟན་ཏེ་འདི་ནི་དང་པོའོ།",
    "ཞེས་པ་ནས་གང་གིས་དེ་ནི་ཀུན་དུ་མཛེས་པ་ཞེས་པའི་བར་དུ་དེ་ལ་རྩ་བ་གསུམ་གྱིས་ནི་སྤྱོད་ལམ་གསུམ་ཀྱི་ཥྤེདོན་བསྟན།་",
    "རྩ་བ་ཕྱེད་ཀྱེ་དང་གཉིས་ཀྱིས་ནི་མེ་ཏོག་གི་ཆར་བབ་པ་བསྟན།",
    "འདི་ནི་མེ་ཏོག་གི་ཆར་འབབ་པ་བསྟན་ཏོ།",
    "འཁོར་དེ་དག་གིས་ལམ་བསྒྲུབས་པ་དང་འབྲས་བུ་ཐོབ་པའང་སྣང་ཞེས་པའི་དོན་ཏེ།",
    "ཡང་རྩ་བ་ཕྱེད་དང་བཅུ་བཞིས་ནི་མོས་པས་སྤྱོད་པ་སྣ་ཚོགས་བསྟན་ཏོ།",
    "ཚིགས་སུ་བཅད་ཀྱེཔ་དྲུག་གིས་ནི་སྦྱིན་པ་བསྟན།",
    "དེའི་འོག་མ་གཅིག་གིས་ནི་ནང་གི་ཕན་གདགས་པ།",
    "དེའི་འོག་མ་གཅིག་གིས་ནི་ཕྱི་ནང་གཉིས་གའི་ཕན་གདགས་པའོ།",
    "དབྱིག་བརྒྱད་ནི་བྲན་ཕོ་མོ་དང་།",
    "འཇམ་དཔལ་བདག་གིས་མཐོང་བ་ལ་ལ་ན།",
    "ཁ་ཅིག་གིས་ནི་འདོད་པ་མ་ལུས་སྤངས།",
    "ཚིགས་བཅད་སྟོང་གིས་རྒྱལ་བ་རྒྱལ་པོ་ལའོ།",
    "ཞེས་པའི་བར་དུ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྤྱོད་པ་ཟབ་མོ་དང་ལྡན་ཞིང་ཐོས་པ་འཛིན་པར་གྱུར་པའོ།",
    "རྣམ་པར་རྟོག་པ་དང་རྩེད་མོའི་དགའ་བ་དང་།",
    "ར་བ་དང་༩སྐྱེད་མོས་ཚལ་བྱིན་པས་ནི་གཟུངས་ཀྱི་སྐྱེད་མོས་ཚལ་དང་ལྡན་པར་འགྱུར།",
    "མཚན་མ་ཡོད་པ་དང་མཚན་མ་མེད་པ་ནི་གཞན་གྱི་དོན་དེ་དང་བདག་གི་དོན་ལ་གེསྤྱོད་པའི་ཡེ་ཤེས་སོ།",
    "གང་གིས་གཞན་ཡང་མཐོང་བ་འཇམ་པའི་དབྱངས།",
    "གང་གིས་ཕྱོགས་བཅུའི་དེ་དག་བརྒྱན་པ་ནི།",
    "ཞེས་པའི་བར་དུ་ནི་བདག་དང་གཞན་བྱི་རེ་བ་སྐོང་བར་བསྟན་པའོ།",
    "བདེ་གཤེགས་སྲས་བོ་ཁྱོད་ཀྱིས་ལུང་སྟོན་ཅིག་ཅེས་པ་ནས།",
    "བདེ་གཤེགསེ་སྲས་པོ་ཁྱོད་ཀྱིས་ལུང་སྟོན་ལ།",
    "འཇམ་དཔལ་སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པའི་ཡེ་ཤེས་ཀྱིས་འདས་པ་རྒྱུ་དང་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ་མངོན་དུ་གཟིགས་པའི་ཕྱིར་ལན་གློན་ནུས་པ་སྟེ།",
    "འོག་མ་ཉན་པ་རྣམས་ལ་གདམས་པ་དང་གསུམ་མོརྐ།",
    "ཡང་དེ་བཞིན་གཤེགས་པ་ནང་གི་ཐ་མ་ཁྱེམ་ནས་མ་བྱུང་བ་ནས་ལོངས་སྤྱོད་པའི་རྒྱུ་ཆེན་པོ་མཐོང་བ་དང་།",
    "བྱམས་པ་ཁྱོད་ཀྱིས་ཤེས་པར་ཀྱིས་ཤིག།",
    "རྒྱུ་གཅིག་གིས་སྔོན་གྱི་ལུགས་ལས་དྲས་ཏེ་ལན་བཏབ།",
    "དགྲ་བཅོམ་པ་ཞེས་པ་ནི་ཉོན་མོངས་པའི་དགྲ་ཐམས་ཅད་བཅོམ་པའི་ཕྱིར་དགྲ་བཅོམ་པའོ།་།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་ཡང་དག་པའི་ངག་ལ་སོགས་པས་ཚིག་སྦྱར་ལེགས་ཤིང་དོན་ཟབ་མོ་དང་ལྡན་པས་མང་པོ་ལ་ཕན་པར་འགྱུར་བ།",
    "དེ་ལ་བྷུཚིགས་བཅད་གཅིག་གིས་ནི་བསམ་གཏན་ལ་འཇུག་པ་བསྟན།",
    "དེ་ལ་ཡང་སྙོམས་པར་འཇུག་པ་དང་མེ་ཏོག་གི་ཆར་འབབ་པ་དང་།",
    "དང་པོ་ཚིགས་བཅད་ཕྱེད་དང་དྲུག་གིས་ནི་འགྲོ་བ་དྲུག་བསྟན།",
    "ཞེས་པའི་བར་དུ་ཚིགས་བཅད་དྲུག་གིས་ནི་དྲན་པའི་རྒྱུ་བསྟན་ཏེ།",
    "ཚིགས་བཅད་དང་པོ་གཅིག་གིས་ནི་རྒྱལ་བུ་བརྒྱད་ལ་དགོངས་པ་བསྟན།",
    "ཚིགས་བཅད་ཕྱེད་དང་གསུམ་གྱིས་ཉོན་མོངས་པའི་རྒྱུ་བསྟན།",
    "ངག་གི་ཐབས་མཁས་པའོ།",
    "བཅོམ་ལྡན་འདས་དགོངས་པ་དང་མཁྱེན་བཞིན་དུ་ལྡན་ཞེས་པ་ནི་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱིས་གཟིགས་ཤིང་ཏིང་ངེ་འཛིན་ལས་བཞེངས་པའོ།",
    "རང་གི་རིག་པ་ཟབ་པ་སྟེ།",
    "དོན་ཤིན་ཏུ་ཤེས་པར་དཀའ་བའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་རང་གིས་རིག་པ་སྟེ།",
    "དེ་གཉི་ག་དེ་བཞིན་གཤེགས་པ་ཉག་གཅིག་གིས་སྤྱོད་ཅེས་པའོ།",
    "ཕྱི་ནང་གི་སྤྱོད་པ་ཐུན་མོང་མ་ཡིན་པ་བསྟན་པའོ།",
    "ཏིང་ངེ་འཛིན་ནི་གསུམ་མོ།",
    "མིང་དང་མཚན་ཉིད་ཕུན་སུམ་ཚོགས་པ་ནི་དེ་ཙམ་གྱིས་ཆོག་གིས་ཞེས་པ་སྟེ།",
    "ཀུན་འབྱུང་གི་ངོ་བོ་ཉིད་དམ་ལམ་གྱི་བདེན་པས་གཟུང་ཕྱེབའོ།",
    "མཚན་ཉིད་ཇི་ལྟ་བུ་ཡིན་པ་ནི་ཚིག་གི་སྒྲ་ལ་བརྟེན་ནས་ཆུད་པར་བྱེད་པ་སྟེ།",
    "ཚིག་གི་སྒྲ་ལ་འཇུག་པའི་མཚན་ཉིད་དོ།",
    "ཚིགས་བཅད་ཕྱེད་དང་བཅོ་བརྒྱད་ཀྱིས་ནི་གོང་གི་དམ་པ་གཉིས་བསྟན།",
    "དེའི་འོག་མ་ཚིགས་བཅད་ཕྱེད་དང་བཅུ་དྲུག་གིས་ནི་དམ་པ་གཉིས་ཀྱི་དབྱེ་བ་བསྟན་ཕྱེཏེ་འདི་དང་པོའོ།",
    "ཚིགས་བཅད་དང་པོ་གཅིག་གིས་ནི་ཀློག་ཅིང་འདོན་པ་དང་གྲུབ་ཅིང་སྤྱོད་པའི་ཤིན་ཏུ་ཟབ་པ་གཉིས་བསྟན།",
    "དེའི་འོག་མ་ཚིགས་བཅད་གཅིག་གིས་ནི་འབྲས་བུ་སྤྱོད་ཅིང་ཡོན་ཏན་རྣམ་པར་འཕེལ་བས་སེམས་བདེ་བའི་དམ་པ་ཐོབ་སྟེ་ཤིན་ཏུ་ཟབ་པ་གསུམ་བསྟན།",
    "ཡང་ཚིགས་བཅད་གཅིག་གིས་ནི་བླ་ན་མེད་པའི་ཟབ་པ་བསྟན།",
    "ཅི་ཡང་མཁྱེན་ཅིང་གཟིགས་པའི་དམ་པ་ཐོབ་པའོ།",
    "ཡང་ན་དེ་བཞིན་གཤེགས་པ་ཉིད་ཟབ་མོ་འདི་ལ་གནས་ཤིང་ཞུགས་པའི་ཕྱིར་མུ་སྟེགས་ཅན་ལས་ཁྱད་པར་དུ་བསྟན་ཏེ།",
    "དང་པོ་ཚིགས་བཅད་བཞིས་ནི་ཉན་ཐོས་དང་ཐུན་མོང་མ་ཡིན་པ་བསྟན།",
    "འཁོར་གཞན་དང་ཡང་ཐུན་མོང་མ་ཡིན་པ་བསྟན་པ་ལས་འདི་ནི་དང་པོ་དང་སྦྱར་རོ།",
    "གལ་ཏེ་ཁྱོད་འདྲར་མཁས་པ་རྣམས་ཀྱིས་སུ།",
    "རྣམ་པར་གྲོལ་བའི་ཆ་མ་སྐྱེས་པ་དང་རྣམ་པར་གྲོལ་བའི་ཆ་སྐྱེས་པའི་བྱེ་བྲག་གིས་དབྱེའོ།",
    "འདི་ལ་དེ་དག་གི་ཡང་ཡུལ་མེད་དོ།",
    "འདི་ལ་དེ་དག་གི་ཡང་ཡུལ་མེད་དོ།",
    "དེ་ཡང་ཚིགས་བཅད་ཕྱེད་དང་གཉིས་ཀྱིས་ནི་ཤཱ་རིའི་བུ་ལ་མཆོག་གི་དོན་བསྟན་ཏེ་བསྐུལ།",
    "འཕགས་པ་ཉན་ཐོས་པ་རྣམས་ལྟ་བ་ཟབ་མོ་ལ་གཟུད་པ་དང་།",
    "ཡེ་ཤེས་ཟབ་མོའི་སྤྱོད་ཡུལ་དུ་བསྟན་པའོ།",
    "ལྡེམ་པོ་ངག་གི་དོན་ངེས་པར་སྟོན་པའོ།",
    "ཉོན་མོངས་པ་སྟུག་པོ་དང་ལྡན་པའོ།",
    "ཉོན་མོངས་པ་སྟུག་པ་ནི་ཕྱིན་ཅི་ལོག་གིས་དངངཀེ་ངོ།",
    "འཁོར་མང་པོ་དོན་ཟབ་མོ་ཚོལ་དུ་གཞུག་པ་དང་།",
    "དེའི་འོག་གི་ཚིགས་བཅད་ཕྱེད་དང་གཉིས་ཀྱིས་ནི་སྔོན་དེ་བཞིན་གཤེགས་པས་བྱིན་གྱིས་བརླབས་པ་ཤ་སྟག་གོ་ཞེས་གཞན་ལ་གླེངས་ཏེ་གསོལ་བ་དང་།",
    "དེའི་འོག་གི་ཚིགས་བཅད་ཕྱེད་དང་གཉིས་ཀྱིས་ནི་བདག་དང་གཞན་གཉི་ག་ལས་གླེངས་ཏེ་གསོལ་བ་ལས་འདི་ནི་དང་པོའོ།",
    "གང་དུ་ཁྱོད་ཀྱིས་རྟག་པར་སྔོན་འཁོར་ན།",
    "དེ་ཉིད་རང་གི་སྐྱོན་དུ་གྱུར་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་མཁྱེན་པ་གཟིགས་པ་སྟེ་དེ་ཡང་དབྱེ་བ་དང་བསྟན་པ་དང་།",
    "རྣམ་པ་འདི་བཞིས་དེ་བཞིན་གཤེགས་པའི་མཁྱེན་པ་གཟིགས་པ་རྟོགས་རྗོཔར་བྱེད་དོ།",
    "རང་བཞིན་གཉིས་ཀ་ལ་མཁྱེན་པ་གཟིགས་པ་ཞེས་བྱ་སྟེ།",
    "ལས་ཀྱང་མཁྱེན་ལ་མི་གཟིགས་པ་དང་།",
    "གཟིགས་ལ་མི་མཁྱེན་པ་དང་།",
    "མཁྱེན་ཀྱང་མཁྱེན་ལ་གཟིགས་ཀྱང་གཟིགས་པ་སྟེ་རྣམ་པ་གསུམ་མོ།",
    "མཁྱེན་ལ་མི་གཟིགས་པ་ནི་ཟད་པའི་ཡེ་ཤེས་དང་།",
    "གཟིགས་ལ་མི་མཁྱེན་པ་ནི་བཟོད་པ་བརྒྱད་དང་འཇིག་རྟེན་པའི་ཡང་དག་པར་ལྟ་བའོ།",
    "མཁྱེན་ཀྱང་མཁྱེན་ལ་གཟིགས་ཀྱང་གཟིགས་པ་ནི་ཡེ་ཤེས་ལྷག་མ་གཞན་དག་གོ།",
    "མིག་གིས་མངོན་དུ་མཐོང་བ་ནི་གཟིགས་པ་དང་སྦྱར་རོ།",
    "འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་དང་གསུམ་མོ།",
    "དམིགས་པ་དང་ངེས་པའི་ཚིག་གིས་ཐབས་ལ་མཁས་པ་བསྟན་པའོ།",
    "མཚན་ཉིད་བསྟན་པ་དང་གཉེན་པོ་དང་བཞག་པ་དང་གཟུགས་དང་གཅིག་གིས་གཅིག་བསྡུ་བ་དང་ལྔའོ།",
    "ཉོན་མོངས་པ་ནི་ཁད་ཀྱིས་བསྲབས་ཏེ།",
    "ཉོན་མོངས་པ་ཡང་ཕྱི་ཕྱིར་སྐྱེ།",
    "ལྟ་བ་ལྔ་མ་གཏོགས་པ་ཉོན་མོངས་པ་ཐམས་ཅད་དང་ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ནི་ཉོན་མོངས་པའི་རྙོག་པའི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "ཉོན་མོངས་པའི་རྙོག་པ་དང་།",
    "ཁྱེམ་པ་ཤིས་ཛེེཔ་མེད་པ་ཉོན་མོངས་པ་བསྐྱེད་པ་ནི་ཉོན་མོངས་པའི་རྙོག་པ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པའི་རྙོག་པ་བསྟན་པ་དང་།",
    "ཡོངས་སུ་མ་དག་པའི་ཞིང་གི་རྙོག་པ་བསྟན་པ་དང་།",
    "ཉོན་མོངས་པ་སྣ་ཚོགས་བསྟན་པའི་རྙོག་པ་བསྟན་པ་དང་།",
    "གཏི་མུག་གི་རྙོག་པ་དང་དྲུག་གོ།",
    "གསེར་གྱི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་ནི་བསྐལ་པ་ཡར་སྐྱེ་བའི་ཚེ་འཇིག་རྟེན་དུ་ངེས་པར་འབྱུང་གི།",
    "འདི་གསུམ་ནི་ཞེ་སྡང་གི་རང་བཞིན་ནོ།",
    "བཀུར་སྟེའི་ཧུཕྱིར་ཡོན་ཏན་སྒྱུས་སྟོན་པ་ནི་བརྫུན་ཞེས་བྱ་སྟེ་འདི་གཉིས་ནི་འདོད་ཆགས་དང་གཏི་མུག་གི་རང་བཞིན་ནོ།",
    "ཕྲག་དོག་ནི་ཉོན་མོངས་པའི་རྙོག་པ་སྟེ།",
    "མ་ཐོབ་པའི་ཟང་ཟིང་ལ་ཐོབ་པར་བྱེད་པའི་ཐབས་སྦྱོར་ཏེ་ཆགས་ཤིང་རེ་བ་ནི་བརྐམ་པ་ཞེས་བྱའོ།",
    "ངན་སོང་ནི་འཕེལ་ཞིང་སྐྱེ་སྟེ།",
    "མ་རབས་བསམ་གཏན་བཞི་པ་ཇོབ་པ་འབྲས་བུ་གསུམ་གྱི་ཉོན་མོངས་པ་མ་ཟད་པ་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཕུང་པོ་ནང་གི་ཐ་མ་མྱ་ངན་ལས་འདའ་བ་ཐོབ་སྙམ་སྟེ།",
    "སྔར་བསྟན་པ་དང་ཕྱིས་གསུངས་པ་མི་མཐུན་ཡང་བརྫུན་དུ་མི་འགྱུར་བ་ནི་ང་འབའ་ཞིག་གིས་མཁྱེན་གྱི་ཁྱེད་མི་ཤེས་པས་དད་པར་གྱིས་ཤིག།",
    "ཚིག་བརྒྱད་ཅུ་རྩ་སྤྱོགཅིག་གིས་ནི་ལུང་བསྟན་པ་བསྟན་ཏོ།",
