    "ཐོག་མའི་ཚིག་གཅིག་གིས་ནི་ཐེ་ཙོམ་མེད་པས་རབ་ཏུ་དགའ་བ་པྱ་བསྟན་ཏོ།",
    "ཀྱེ་མ་སྡིག་གི་སེམས་ཀྱིས་བདག་བསླུས་པས།",
    "ཐོག་མའི་ཚིགས་བཅད་གཉིས་ཀྱིས་ནི་ཕྱི་ནང་གི་མཚན་གྱིས་བརྒྱན་པའི་ཡོན་ཏན་བསྟན་ཏོ།",
    "ཚིགས་བཅད་གཅིག་གིས་ནི་མཚན་རྫོགས་པས་བདུད་བཏུལ་བའི་ཡོན་ཏན་བསྟན་ཏོ།",
    "ཚིགས་བཅད་གཅིག་གིས་ནི་དཔེ་བྱད་རྫོགས་པས་མ་འདྲེས་པའི་ཡོན་ཏན་བསྟན་པ་སྟེ།",
    "འཇིག་རྟེན་ཕན་པ་ཐུགས་བརྩེ་ཁྱོད་མཐོང་ནས།",
    "སྔ་མ་ལ་ཡང་གཉིས་ཏེ་ཚིག་གཅིག་གིས་ནི་ཅིའི་ཕྱིར་ཐེ་ཚོམ་བསལ་བ་བསྟན་ཏོ།",
    "སྔར་ཚིགས་བཅད་གཅིག་གིས་ཐེ་ཚོམ་གྱི་གཞི་གླེང་བ་བསྟན།",
    "འོག་མ་ཕྱེད་དང་དྲུག་གིས་ནི་ཐེ་ཙོམ་དངོས་སུ་བསལ་བ་བསྟན་ཏོ།",
    "གང་ཚེ་འཇམ་ཞིང་ཟབ་མོ་སྙན་པ་ཡི།",
    "ཞེས་པའི་བར་དུ་ནི་འདིས་ཉོན་མོངས་པ་ཟད་པས་དགའ་བ་སྐྱེ་བ་བསྟན་ཏེ།",
    "ནང་གི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "ལྔ་ནི་བཅོམ་ལྡན་འདས་ཉག་གཅིག་གིས་མཁྱེན་ཅིང་ལུང་སྟོན།",
    "ལུང་སྟོན་པའི་ལས་ནི་ཚིག་གིས་སྤྱོད་པ་སྟེ།",
    "དགེ་སློང་མ་དང་ལྷའི་བུ་མོ་ལ་སོགས་པ་ལུང་བསྟན་པ་དང་།",
    "དེ་ལ་ཡང་དགའ་བ་འབའ་ཞིག་གིས་བསྐྱེད་པའི་ཕྱིར་རྡུལ་མེད་པའི་ཕྱིར་ཙཞིང་ཞེས་བྱ་སྟེ།",
    "གཟུངས་གཞི་ལ་གནས་པའི་ཕྱིར་སྐྱེད་མོས་ཚལ་དང་ལྡན་པ།",
    "སེམས་སྤྱོད་པ་ཕྱིར་མ་ནུར་པ་ཉོན་མོངས་པ་མི་བསྐྱོད་པའི་ཕྱིར་དྲན་པ་དང་ལྡན་པ་དག་གིས་ཞིང་དེ་ཡོངས་སུ་གང་ཞེས་སྦྱར་རོ།",
    "བུད་མེད་རབ་ཏུ་བྱུང་བ་ལས་ཡང་དག་པའི་བསྟན་པ་ལོ་ལྔ་བརྒྱས་ཐུང་བར་འགྱུར་རོ།",
    "ཞིང་གི་རྒྱན་བསྟན་པ་དང་།",
    "ཕྱིའི་ཞིང་གི་རྒྱན་བསྟན་པ་ཡང་མིང་དང་དག་པའི་མཚན་ཉིད་དང་།",
    "ཚིགས་བཅད་གཅིག་གིས་ནི་བསྔོ་བ་སྟོན་ཏེ་འདི་ནི་དང་པོའོ།",
    "ལྟ་བ་དེ་དག་གི་མུ་སྟེགས་ཅན་ཀྱི་ལྟ་བ་དྲུག་ཅུ་རྩ་གཉིས་དེར་འདུས་ཏེ་དེ་ལས་འཕེལ་བའོ།",
    "ལྟ་བ་དེ་དག་གི་སྐྱོན་དང་བྲལ་བའི་ཕྱིར་འདི་ལྟར་བསྟན་ཏོ།",
    "ཡང་ན་ལྟ་བ་དེ་གསུམ་གྱི་ཉོན་མོངས་པ་ཐམས་ཅད་བསྐྱེད་པའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་ལྟ་བ་དེ་དག་དང་བྲལ་བའི་ཕྱིར་ཉོན་མོངས་པའི་རྒྱུ་བཀག་ན་འབྲས་བུ་ཡང་མི་སྐྱེ་བར་འགྱུར་རོ།",
    "དཔེ་དང་དོན་དུ་སྦྱར་བ་དང་གསུམ་མོ།",
    "ཆེན་པོ་ལ་རེག་པ་བསྐྱེད་ཁྲུདེ་གཟུད་པ་ལ་འདི་ནི་དང་པོའོ།",
    "འདུས་མ་བྱས་ལ་དབྱེ་བ་མེད་མོད་ཀྱི་འདུས་བྱས་ཀྱི་སྒོ་ནས་ཆེ་ཆུང་རིམ་པར་དབྱེ་བའི་ཕྱིར་གླང་དང་ར་དང་རི་དྭགས་ཀྱི་ཤིང་རྟ་ཞེས་སྨོས་སོ།",
    "དེ་ཡང་བུས་པ་རྣམས་ཉོན་མོངས་པ་ལས་ཐར་བ་དང་།",
    "གཅིག་གིས་གཅིག་བདས་ཤིང་བརྒྱུགས་ཏེ་ཞེས་པ་ནི་བརྩོན་འགྲུས་ཆེན་པོ་རྩོལ་བ་བསྟན་ཏོ།",
    "འཕགས་པ་ཉན་ཐོས་པ་རྣམས་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པ་ཐོབ་པས་ཉོན་མོངས་པ་ལས་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཕྱོགས་ཐམས་ཅད་དུ་གཟིགས་ཤིང་འཕགས་པར་གྱུར་ཅེས་པའི་དོན་ཏོ།",
    "ནང་གི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པའོ།",
    "ཉོན་མོངས་པ་ལས་སྟོན་པ་དང་ངན་འགྲོ་གསུམ་ལས་ཐར་བར་བྱས་པ་ནི་སྲོག་དང་ལྡན་པར་བྱས་པའོ།",
    "ངན་སོང་གིས་འཇིགས་པ་དང་།",
    "མ་རིག་པ་ལ་སོགས་པ་ནི་ཉོན་མོངས་པའི་རྩ་བ་གཏི་མྱུག་སྟེ་སྡུག་བསྔལ་གྱི་རྒྱུ་ཡིན་པས་དུག་ཧུསྤེགསུམ་དང་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཟབ་མོ་དེ་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་རེ་བ་མེད་ཅེས་པའི་དོན་ཏོ།",
    "གདུང་བ་ཞེས་པ་ནི་ནང་གི་དམིགས་པ་སྟེ།",
    "སྔར་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་ཞུགས་པ་ལ་ཕྱིས་འབྲས་བུ་ཐོབ་པས་ན་རང་གིས་རིག་ཞེས་པའོ།",
    "ཇེག་པ་རྣམ་གསུམ་ཀུན་ལ་ཡང་ཡེ་ཤེས་མངའ་མོད་ཀྱི་དངོས་པོ་ལ་གཟིགས་པའི་ཡེ་ཤེས་ནི་བཅོམ་ལྡན་འདས་ཉག་གཅིག་ལ་མངའ་བ་དང་རང་རིག་པའི་ཡེ་ཤེས་ཉིད་ནི་རང་བྱུང་གི་ཡེ་ཤེས་སོ།",
    "ཡང་ན་དེ་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ནི་རང་བྱུང་གི་ཡེ་ཤེས་སོ།",
    "ཡེ་ཤེས་དེ་གཉིས་ཀྱི་འཁོར་ནི་སྟོབས་དང་མི་འཇིགས་པ་ལ་སོགས་པ་ནང་གི་ཡོན་ཏན་དག་གོ།",
    "སྲེདེ་ཡང་བུ་རྣམས་ཀྱི་རེ་བ་ལས་འགལ་བ་བསྟན་པ་དང་།",
    "ན་གཤེགས་པ་ཞེས་པ་ནས་མྱ་ངན་ལས་འདས་པའི་བདེ་བ་ཐོབ་པར་གཟིགས་ན་ཞེས་པའི་བར་དུ་ནི་ཕའི་བསམ་པ་བསྟན་ཏེ་ཁམས་གསུམ་གཡང་ཟ་བ་མེ་འབར་བའི་ཁང་པ་ལྟ་བུ་ལས་འགྲོ་བ་མང་པོ་བཏོན་ནས་དེ་བཞིན་གཤེགས་པའི་བསྟན་པ་ཡང་དག་པའི་སྒོར་གཟུད་པ་དང་།",
    "རྒྱུ་དང་འབྲས་བུ་ཐམས་ཅད་ཉོན་མོངས་པ་དང་མ་འདྲེས་པ་ནི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་གཞིར་གྱུར་པའོ།",
    "ཤཱ་རིའི་བུ་ཁྱོད་ལ་སོགས་པ་ཐམས་ཅད་ངའི་སྲས་ཡིན་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེའི་འོག་གི་ཚིགས་སུ་བཅད་པ་བརྒྱད་ཀྱིས་ནི་དཔེ་དང་དོན་དུ་སྦྱར།",
    "དེའི་འོག་མ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་བསྡུས་པའི་དོན་བསྟན་པའོ་རྐེ།",
    "དེའི་འོག་གི་ཚིགས་བཅད་ཕྱེད་ཀྱིས་ནི་དེ་ན་གནས་པ་མང་བར་བསྟན།",
    "དེའི་འོག་གི་ཚིགས་བཅད་ལྔས་ནི་གཟུགས་ཀྱི་ཕུང་པོ་མི་རྟག་པ་དང་།",
    "ཀ་བའི་རྩ་བ་རུལ་པ་ཞེས་པ་ནི་འདུ་བྱེད་ཀྱི་ཕུང་པོ་སྐད་ཅིག་མ་གཅིག་ལ་སྐྱེ་ཞིང་འཇིག་པ་བྱ་བ་བཏང་བས་མེད་པ་ལ་གནས་པ་ནི་ཆུ་ཤིང་གི་སྡོང་པོ་དང་འདྲའོ།",
    "ཁང་ཐོག་དང་ནི་སྐར་ཁུང་སྐབས་རེར་བྲལ།",
    "ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི་བདག་མེད་པ་བསྟན།",
    "ཡང་གཅིག་གིས་ནི་མི་གཙང་བ་བསྟན་ཏེ།",
    "རེ་ལྡེ་ནི་པགས་པ་དང་བྲལ་བའི་དོན།",
    "དེ་ན་དེ་དག་གི་ཡང་གནས་གྱུར་ལ་ཞེས་པ་ནི་མང་དུ་གནས་པའི་དོན་བསྟན་ཏོ།",
    "ཚིགས་བཅད་གཅིག་གིས་ནི་བསྡུས་པའི་དོན་བསྟན་ཏེ།",
    "དེ་དག་ཀྱང་ཉོན་མོངས་པ་བཅུའི་མཚན་ཉིད་ལྟས་ངན་གྱེ་དོན་དུ་བསྟན་ཏེ།",
    "དེའི་འོག་གི་ཚིགས་བཅད་ཕྱེད་དང་གཉིས་ཀྱིས་༤་ནི་ཉེས་པའི་སྐྱོན་བསྡུ་བ་བསྟན།",
    "དེའི་འོག་མ་ཚིགས་བཅད་ཕྱེད་དང་གཉིས་ཀྱིས་ནི་ཞེ་སྡང་གི་དཔེ་བསྟན།",
    "དེའི་འོག་མ་ཚིགས་བཅད་གཅིག་གིས་ནི་གཏི་མུག་གི་དཔེ་བསྟན།",
    "དེའི་འོག་མ་གཅིག་གིས་ནི་ཐེ་ཚོམ་གྱི་དཔེ་བསྟན།",
    "གཅིག་གིས་ནི་ང་རྒྱལ་གྱི་དཔེ་བསྟན་ཏོ།",
    "གཞན་གྱི་ཉོན་མོངས་པ་མཐོང་བས་ཞེ་སྡང་བའོ།",
    "ཞེས་པ་དག་ནི་རྫས་སུམ་ཅུ་རྩ་དྲུག་གིས་གླགས་པ་གཏི་མུག་གི་ཕུང་པོ་ཡིན་པ་སྟེ།",
    "འཐབ་མོ་བྱེད་དེ་རབ་ཏུ་སྒྲ་ཡང་འབྱིན།",
    "ཞེས་པ་ནི་ཚིག་འདི་དག་གིས་ནམ་མཁའ་ལ་གནས་པའི་འདྲེ་གདོན་ཐུགྱི་དཔེ་ལྟ་བ་རྣམ་ལྔ་བསྟན་ཏེ།",
    "མ་རིག་པ་དང་བཅས་པས་སྒྲིབ་པ་ནི་གནས་པ་ཡང་དག་པའི་གཞུང་གི་ཤས་ཆུང་བའི་ཕྱིར་རིད་པའོ།",
    "ཡང་དག་པའི་ལུང་གི་ཟས་དང་བྲལ་བ་ཡང་དག་པའི་གཞུང་གི་ཆུ་མ་རྙེད་པ་བཀྲེས་པ་དང་སྐོམ་པས་ནང་གི་སེམས་གདུངས་པའི་ཕྱིར་ཕྱོགས་བཞིར་ལྟ་ཞིང་སྒྲ་འབྱིན་པའོ།",
    "མུ་སྟེགས་ཀྱི་སྤྱོད་པས་ཡང་དག་པའི་ལམ་ལ་ལྟ་བ་ནི་སྐར་ཁུང་ནས་ནམ་མཁར་ལ་ལྟ་བ་ཙམ་མོ།",
    "མེ་ལྕེ་འབར་ཞེས་པ་ཡང་ཉོན་མོངས་པ་སྣ་ཚོགས་མཆེད་རྨྱེ་པས་སྐྱེ་རྒ་ན་འཆིའི་བར་དུ་བཞི་མཆེད་ཅེས་པའི་དོན་ཏོ།",
    "འདོད་པའི་ཁམས་ན་མུ་སྟེགས་ཅན་ཁྱིམ་ནས་བྱུང་བ་དང་ཁྱིམ་ནས་མ་བྱུང་བ་གཉི་ག་ཡང་སྲེད་པའི་ཉོན་མོངས་པས་ལས་དང་འཇིག་རྟེན་གྱི་ཟང་ཟིང་ལ་རྩོད་ཅིང་སྒྲ་འབྱེན་པ་དང་།",
    "ལོག་པར་ལྟ་བའི་ཉོན་མོངས་པས་ལུས་ཚིག་ཅིང་གདུག་པ་སྣ་ཚོགས་ཀྱིས་གཙེས་ཞེས་པའི་དོན་ཏོ།",
    "ཚིག་པར་གྱུར་པ་དག་ལ་ཁྲག་གིས་འཐོར།",
    "ཉོན་མོངས་པ་འདོད་ཆགས་དང་གཏི་མུག་དང་།",
    "འཇིག་ཚོགས་སུ་ལྟ་བ་ལ་སོགས་པའི་ཉོན་མོངས་པས་བསྲེགས་པའི་ཕྱིར་ཉོན་མོངས་པ་མ་སྤངས་པས་གཟུགས་མེད་པའི་ཁམས་ནའང་གནོད་པ་ཡོད་པའི་ཕྱིར་ཕན་ཚུན་སོས་འདེབས་ཞེས་རྗུཔ་དང་།",
    "རང་གི་ལྟ་བ་དམ་པོར་འཛིན་པ་ནི་ཁྲག་གིས་འཐོར་བ་ལྟ་བུའོ།",
    "ཞེས་པའི་བར་དུ་ནི་ཉོན་མོངས་པ་ལས་ཐར་བར་ཚོལ་ཡང་ལྟ་བ་དམ་པོར་འཛིན་པའི་ཕྱིར་མི་འཐོར་བའི་དོན་དུ་བསྟན་པའི་དཔེ་སྟེ།",
    "སྤྱང་ཀི་དག་ཅེས་པ་ནི་འདོད་པའི་ཁམས་ཀྱི་ཉོན་མོངས་པ་གཞན་དག་ཀྱང་བསྦུ་བ་སྟེ།",
    "གཟུགས་ཀྱི་ཁམས་ན་འདོད་པ་ལ་སོགས་པའི་ཉོན་མོངས་པ་ནི།",
    "ཉོན་མོངས་པའི་དྲི་ང་བ་ཕྱོགས་བཞིར་འཐུལ་བ་ནི་བསམ་གཏན་བཞི་པ་རྣམས་ཀྱི་ཉོན་མོངས་པའི་དཔེ་བསྟན་ཏོ།",
    "ཞེས་པའི་བར་དུ་ནི་འདིས་ཀྱང་གཟུགས་མེད་པའི་ཁམས་ཀྱི་ཉོན་མོངས་པ་བསྟན་པ་སྟེ།",
    "ལྟ་བ་ངན་པའི་ཟན་ཟོས་པས་ཉོན་མོངས་པ་ཕྱིར་ཞིང་འཕེལ་ཞེས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ནི་སྲིད་པའི་རྩེ་མོ་ལ་གནས་པའི་མུ་སྟེགས་ཅན་ཡང་དག་པའི་བསྟན་པའི་ཟས་དང་སྐོམ་གྱིས་གདུངས་པས་ཉོན་མོངས་པའི་མེས་ཚིག་ཅེས་པའི་དོན་ཏོ།",
    "ཁྱོན་མོངས་པའི་གནས་ནས་བསླངས་ཏེ།",
    "དེས་ཐོས་དེ་ན་དེ་ཡིས་བདག་གི་ཁྱེབུ།",
    "ཁྲེལ་བ་མེད་པས་ཉོན་མོངས་པ་སྣ་ཚོགས་ལ་བག་མེད་པར་སྤྱོད་པ་དེ་ཉིད་བྱེས་པ་མི་ཤེས་པའོ།",
    "དེས་ཐོས་དེ་ནས་མྱུར་དུ་དེར་སོང་སྟེ།",
    "གཅིག་ཕྱིར་གཅིག་ཅེས་པ་ནི་ཐོག་མ་མེད་པའི་དུས་ནས་གཅིག་གིས་གཅིག་སྡུད་ཅིང་ཉོན་མོངས་པའི་གནས་ན་སྐྱེ་བ་དང་རྒ་བ་དང་ན་བ་དང་ཤི་བ་རྒྱུན་མི་འཆད་ཅེས་པའི་དོན་ཏོ།",
    "དེ་ལྟ་བུའི་ཉོན་མོངས་པ་སྣ་ཚོགས་ཀྱིས་གཟིར་ཞེས་པའི་དོན་ཏོ།",
    "ཁྱེད་ཅག་གི་ཕྱིར་ངས་བྱས་ཞེས་པ་ནི་བཞོན་པའི་དགོས་པ་བསྟན་ཏེ།",
    "དེ་ལ་དང་པོ་ཚིགས་བཅད་བཅུ་གཅིག་གིས་ནི་དྲང་བའི་དོན་བསྟན།",
    "དེའི་འོག་མ་གཅིག་གིས་ནི་འཕགས་པ་རྣམས་ཀྱི་བསྔགས་པ་བསྟན།",
    "དེའི་འོག་མ་གཅིག་གིས་ནི་ལོངས་སྤྱོད་དམ་པ་དང་ལྡན་པ་བསྟན།",
    "ཡངས་པའི་དངོས་པོ་ཕྱག་གི་གནས།",
    "ཁྱོད་ཀྱི་ཕ་ང་ཡི་བུ་ཁྱོད།",
    "ཞེས་པའི་བར་དུ་ནི་འདི་མན་ཆད་མོས་བསྐྱེད་ཅིག་པར་བསྟན་པ་སྟེ།",
    "དེའི་འོག་མ་ཚིགས་བཅད་དྲུག་ཅུ་རྩ་དྲུག་གིས་ནི་བསླབ་པར་བྱ་བའི་གནས་བསྟན་ཏོ།",
    "དེའི་འོག་མ་ཕྱེད་དང་གཉིས་ཀྱིས་ནི་ཀུན་འབྱུང་གི་བདེན་པ་བསྟན།",
    "དེའི་འོག་མ་གཅིག་གིས་ནི་ལམ་གྱི་བདེན་པ་བསྟན་ཏེ།",
    "འདོད་ངན་དེ་ལ་ཆགས་པར་གྱུར་པ་ནི་ཕྱི་ནང་གི་ཡུལ་ལ་དགའ་བར་བྱ་བ་དེ་ཐམས་ཅད་སྡུག་བསྔལ་ཉིད་ཡིན་པར་བསྟན་པས་འཇིག་རྟེན་བྱུ་བདེན་པ་མ་སྤངས་པར་ཡང་དག་པའི་བདེན་པ་ཉིད་ལ་གཟུད་པའོ།",
    "ཞེས་པ་ལ་སོགས་པ་ནི་ཀུན་འབྱུང་གི་བདེན་པ་བསྟན་ཏེ།",
    "གང་གིས་ཁྱ་ཐར་ཞེས་པ་ལ་སོགས་པ་ནི་ལམ་གྱི་བདེན་པ་བསྟན་ཏེ།",
    "ཁྱོད་ཀྱི་མི་དེ་མི་ལྡོག་གཟུད།",
    "རྗེས་སུ་ཡི་རང་ཞེས་པ་ནི་མོས་པ་ཆེ་བའི་ཕྱིར་མི་ལྡོག་ཅེས་པ་སྟེ།"
  ]
}