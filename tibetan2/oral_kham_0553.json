    "ཉན་ཐོས་པ་དང་རང་རྒྱལ་རྣམས་ལས་ཤིན་དུ་འཕགས།",
    "སྐྱེས་བུ་ཆེན་པོ་དག་དཔེར་ན་གླེན་པ་གཏི་མུག་ཅན་གྱིས་སེང་གེའི་རྒྱལ་པོ་བཀྲེས་པ་ཉལ་ཞིང་འདུག་པ་ལས་བསླང་༡༡བའམ་སྦྲུལ་གདུག་པའི་ཁར་ལག་པ་བཅུག་༡༢པའམ།",
    "རིགས་ཀྱི་བུ་དཔེར་ན་ཤིང་ཚེར་མ་ཅན་ཡང་རང་བཞིན་གྱིས་འཛུག་༡༡པ་ཡིན་གྱི།",
    "འགྲོ་བ་ལྟ་བུ་ཡང་མ་ཡིན་འགྲོ་བ་ལྟ་བུ་མ་ཡིན་པ་ཡང་མ་ཡིན་པར་མ་གསུངས་སོ།",
    "གཏི་མུག་སྐྱེས་ཏེ་མངལ་ན་འདུག་པ་དང་།",
    "དེའི་ཚེ་བཅོམ་ལྡན་འདས་མཁྱེན་བཞིན་དུ་ཚེ་དང་ལྡན་པ་ཀོཎྜི་ནྱ་ལ་དགེ་སློང་དགའ་བོ་ད་༨ལྟར་གང་ན་འདུག་ཅེས་བཀའ་སྩལ་ཏོ།",
    "བདག་དུས་མ་མཆིས་པར་ཅགང་ཡང་མཆི་བར་གནང་ན།",
    "ཁ་ཅིག་ནི་མ་བསྒྲུབས་ཀྱང་རང་ཐོབ་བོ།",
    "པའི་དྲུང་དུ་ཕྱིན་མ་ཐག་ཏུ་མེ་དེ་ཡང་རང་ཤིའོ།",
    "སྤོས་ཀྱི་ཤིང་བརྩིགས་རི་ནོཔ་ལ་བསྲེགས་ན་མེ་དེ་ཡང་རང་ཤིའོ།",
    "བདེ་བར་འདུག་ལ་བསོད་སྙོམས་སྡོད་ཅིག་ཅེས་སྨྲས་སོ།",
    "འདིར་བདེ་བར་འདུག་ཅིང་བསོད་སྙོམས་བསྡད་དུ་རུང་ངམ།",
    "པུར་༡་སྒྲོམ་གྱི་དྲུང་དུ་བཞག་ན་མེ་དེ་ཡང་རང་ཤིའོ།་།",
    "སྤོས་ཀྱི་ཤིང་བསྲེགས་ན་མེ་དེ་ཡང་རང་ཤིའོ།",
    "ཞུགས་ལ་བཞེན་པའི་གནས་སུ་ལྷགས་མ་ཐག་ཏུ་མེ་ཡང་རང་ཤི་བར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔར་རིང་བསྲེལ་ཚེམས་མཆེ་བ་གཅིག་གནང་བས་ན་བདག་མཆིས་མ་ཐག་ཏུ་མེ་ཡང་རང་ཤི་བར་གྱུར་ཏོ་ཞེས་སྨྲས་ནས།",
    "གཡུང་པེ་འདུག་གཡུང་པེ་མིག་༨སྣར་ཞོལ་བུབ།",
    "གཡུང་ལི་པེ་ཅོ་འདུག་སྣར་ཞོལ་བདག་དང་།",
    "རང་རང་ཡིད་བཞིན་མངོན་སུམ་ཉིད་དུ་ཐོབ་པར་འགྱུར་བ་དེ་ཕྱིར་འདིར།",
    "ཕྱི་བསྭེའི་ཁང་པ་ལྟར་དམར་ལྷག་གེ་བར་འདུག་པ།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "གནོད་བྱེད་གང་ན་འདུག་ཀྱང་འགུགས་པའི་རྟགས།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "ཡང་རང་གཞན་གྱི་ལམ་སེལ་དང་།",
    "བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "དྲག་ཤུལ་གྱི་བྷྱོར་བ་རྩུབ་པར་སྟོན་པ་ཐམས་ཅད་ཁོ་རང་ལ་སྒྱུར་ཅིག་ཟློག་ཅིགབརླག་པར་གྱུར་ཅིག།",
    "དྲག་ཤུལ་གྱི་བྷྱོར་བ་རྩུབ་པར་སྟོན་པ་ཐམས་ཅད་ཁོ་རང་ལ་སྒྱུར་ཅིག་ཟློག་ཅིང་།",
    "དེ་བཞིན་དུད་སོལ་མའི་ཉིན་ལྟར་གཤེགས་རྒྱུ་དེ་མིན་པའི་གཏོར་མ་འཛུགས་། གཏོར་དེ་ཡང་གསང་སྒྲུབ་ནང་རྟེན་གཏོར་གསུངས་འདུག་པ་དེ་དང་གཅིག་ཡོང་ངམ།",
    "ཐོག་མར་ལྷ་སྔགས་འདུག་རུང་རྗེས་ནས་ཨ་ཀརྵ་ཡ་འདུག་པ་སོགས་དང་།",
    "ཐུན་རྡེག་དུས་སྔགས་པི་ཙ་ཅན་བཏགས་ཞེས་རྦད་བསད་དུས་སྔགས་གོང་མའི་བྷྱོ་སྟེང་དུ་བཏག་གསུང་།"
  ]
}