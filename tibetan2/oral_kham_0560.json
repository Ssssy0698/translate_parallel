    "དེའི་དུས་སུ་བོད་ཀྱི་ཁྱིམ་མཚེས་ཡུལ་ཁག་གཞན་གྱི་ཐོག་ལའང་བོད་པས་དམག་ཤུགས་ཀྱི་འཇིགས་སྣང་སྟོན་གྱི་ཡོད་འདུག།",
    "རྒྱ་གར་གྱི་བྱང་ལ་ངོ་ལོག་པ་ཁག་ཅིག་གནོན་པའི་ཕྱིར་ཕེབས་སྐབས་བཀྲོངས་ཚུལ་༤༤ ༤༤ སྤེ་ལོ་ཊ་ཤོག་གྲངས་༡༢ བྲིས་ཡོད་ཡོད་འདུག་ཀྱང་།",
    "སྨེ་ཝའི་ནང་གཤེགས་པ་གསལ་པོར་སྟོན་འདུག་དུས་སྲོང་མང་རྗེའི་སྲས་ཁྲི་ལྡེ་གཙུག་བཙན་ནམ།",
    "ཕྱིས་རྒྱ་རྒྱལ་གྱི་འདོད་པ་ཇི་བཞིན་བྱུང་མི་འདུག་ཅིན་དྲེང་ཀོང་ཇོ་ལམ་དུ་ཡོད་པའི་རིང་དེར་རྒྱལ་སྲས་འཇང་ཚ་ལྷ་དབོན་གྱིས་འཇང་ཐང་དགེ་རྭར་མཚན་དགུང་ལ་རྟ་བཅགས་པར་སྔགས་པའི་ཟོར་མདའ་ཕོག་སྟེ་གཤེགས་ཟེར།",
    "བློན་ཆེན་ཡུའུ་ཤི་ལིས་དེ་འདྲ་ཕུལ་ན་མི་འགྲིགས་ཞེས་དགག་ཆ་བྱས་འདུག་ཀྱང་།",
    "སྤ་གོར་བེ་རོ་ཙ་ན་དང་།",
    "༦༩ ༦༩ རྡོ་རིང་རང་ལས་བཤུས་སོ།",
    "ཡུལ་མིང་ཁ་ཤས་ཀྱི་སྒྲ་ཕྲན་བུ་མཐུན་མིན་འདུག་པ་དཔེར་ན།",
    "ཞེས་སེང་གེ་འདབ་གཤོག་ཅན་གྱི་ཐམ་ཁ་གྲུ་བཞི་པ་བཅས་འདུག་དེའི་དོན་གསལ་བར་བསྒྱུར་ན་ནི། མདུན་ས་ལོང་ཅུ་ནས།",
    "ས་བཀྲ་རྙིང་པ་ཚོའི་ནང་ལའང་གསལ་འདུག་དེ་ནས་ལོ་ཤས་ཀྱི་རྗེས་སུ་ཨ་རབ་ཀྱི་ཀ་ལིབ་ཧ་ཧོན།",
    "བོད་དམག་འགོག་ཐབས་སུ་རྒྱ་ནག་དང་མཉམ་དུ་དྲག་པོའི་མཐུན་ཕྱོགས་ཤིག་བཟོས་འདུག་༨༢ ༨༢ གྟྣཔྱཐྲྟསྒྱ་ངྣྟཔྱདྲཏྲདཅཔྱཎདྲརྡཔྲྤྣ་༡་ དེ་རྗེས་ཨ་རབ་དང་།",
    "འཛམ་བུ་གླིང་ཐམས་ཅད་བོད་ཀྱི་རྒྱལ་པོས་མངའ་འོག་ཏུ་བསྡུས་ནས་གེ་སར་གྱི་ཡུལ་འཇོམས་སུ་འོང་བ་འདུག་ཅེས་ཐོས་ནས།",
    "༣༧༡ ན་༣ ཞེས་གསལ་འདུག་པ།",
    "ཀ་༢༥ ན་༢ ཡིན་པའང་གསུངས་འདུག་གང་ལྟར་ཡང་།",
    "སྐབས་དེ་དུས་ཡོ་རོབ་ནང་སྐད་གྲགས་ཡོད་པའི་རྒྱལ་པོ་ཤ་ལ་མིལ་སྐྲདཎཔྱརྡྟནཎཐྲརྣྟཟེར་བས་རྒྱལ་ས་ཨེ་སེ་ལ་ཤ་པལ་རྐྱདྲཕྱ་རྒཎསྐྲདཎསྣྲྟརྡརྡྟནས་བྷག་ཌ་སེར་གཞུང་ཚབ་ཅིག་བཏང་འདུག་བྷག་ཌ་སེའི་ཀ་ལིབ་ཧ་ཧུན་ཨལ་ར་ཤིད་རྒྱལ་པོས་ནུབ་ཕྱོགས་ནས་གཞུང་ཚབ་བླངས་པ་སོགས་བྱས་པའི་རྐྱེན་གྱིས་ཤར་ཕྱོགས་ཁ་ཆེ་ཁོ་ར་སན་གྱི་རྒྱལ་པོས་ཧ་ཧུན་ཨལ་ར་ཤིད་ལ་ངོ་ལོག་བྱས་ཤིང་།",
    "ཞེས་བྲིས་འདུག་༡ ༡ རྒྟདྲཐྟཔྱཇཎརྡྤྟཔྱགྱདྲནཎརྡཎཕྲཎརྒྱྣསྤྱརྣྤཎདྲརྣཔྲྣཐཁྟཔྲྤདྲརྣཕྲང་༢༩ ངསྤྱཏརྡདྲཔྲདྟརྟཏཕྲ་༡༩༦༢ ཨཱལ་ཡ་ཀུ་བིས་བརྗོད་གསལ།",
    "བོད་ཀྱི་ལྷ་བཙན་པོའི་གདུང་རབས་ལ་རལ་པ་ཅན་དར་མའི་གཅེན་པོ་ཡིན་པར་བཞེད་འདུག་མཁས་པའི་དགའ་སྟོན་གྱི་རྩ་བར་རལ་པ་ཅན་གཅེན་དུ་བཞེད་ཀྱང་།",
    "ཝང་པི་ཟེར་བ་གཉིས་ནས་བོད་ཀྱི་སྐུ་ཚབ་ལ་ཡི་གེ་ཁག་བཞི་བཏང་འདུག་ཡི་གེ་དེ་ཚོ་ཚང་མར་བསྔགས་བརྗོད་དང་།",
    "ལུའུ་པཡེ་གསོན་པོར་ཡོད་འདུག་པ་ཤི་བའི་རུས་པ་དང་།",
    "དེ་བྱིངས་འཚོ་བསྡད་རྣམས་འབྱོར་ཞེས་འཁོད་འདུག་ཡི་གེ་གསུམ་པ་ནི།",
    "ཁྱེད་ང་གཉིས་ཕྱོགས་སོ་སོ་ནས་ཤུགས་ནུས་སྟོན་ཐུབ་པར་ཤོག་ཅེས་བྲིས་འདུག་དེ་དུས་བོད་ཕྱོགས་ནས་རྒྱ་མིའི་མི་སེར་ངོ་ལོག་པ་མཐར་སྐྲོད་གཏོང་རྒྱུར་བོད་ནས་རོགས་རམ་དགོས་མིན་དྲི་བ་ཞིག་བྱས་མེད་དམ་སྙམ་པ་འདུག་ཡི་གེ་བཞི་པ་ནི།",
    "བྱེད་ཀྱི་མེད་དམ་སྙམ་པ་འདུག་གནས་ཚུལ་གསལ་པོ་འགའ་ཤས་འདུག་ཀྱང་།",
    "ཅེས་འཁོད་འདུག་ཏང་ཁུད་པ་ཟེར་བ་འདི་རྣམས་མཚོ་སྔོན་པོའི་བྱང་ཕྱོགས་དང་།",
    "ཤར་ཕྱོགས་ན་རྒྱ་འདུག་པ།",
    "རྒདྲཁྲཎརྣཐྲ་ྒསྤྱྟདྲང་ནང་ལའང་གསལའདུག་གོ།",
    "དབོན་ཞང་རང་བཞིན་ཐུགས་ལ་མི་འཇུག་པ་ལས།",
    "ཞེས་རྡོ་རིང་ནས་ངོ་བཤུས་བྱས་པའི་ལོ་ཚིགས་ཀྱང་འཁོད་འདུག་པར་བརྩིས་པའི་ཚེ།",
    "ཡི་གེ་དེ་རབ་བྱུང་བདུན་པའི་ཆུ་སྟག་སྤྱི་ལོ་༡༤༢༢ ལོར་བྲིས་འདུག་པ།",
    "མཐའ་སྐོར་རྩྭ་མང་པོ་སྐྱེས་འདུག་དེའི་འགྲམ་ན་གྱང་རོ་འགའ་ཤས་དང་།",
    "བལྟ་སྐོར་བ་ཁ་ཤས་ཀྱིས་རྡོ་རིང་དེའི་ཡི་གེ་བཤུ་བཞིན་འདུག་ཟེར།",
    "རྗེས་སུ་དེ་ཕྱོགས་ཕེབས་དུས་རྡོ་རིང་དེ་ཡང་མི་འདུག་ཡུལ་མི་ཚོས་བརྗོད་གསལ་ལྟར་ན་ཕ་རན་སིའི་ཡུལ་དུ་འཁྱེར་བ་མིན་ནམ་ཟེར་ཞེས་གསུངས་བྱུང་།",
    "དེ་ལ་གུ་གུ་རྨེ་རུར་ངོས་འཛིན་བྱེད་མི་ཡང་མང་པོ་འདུག་པས།",
    "རྒྱ་བོད་ས་མཚམས་རྡོ་རིང་འཛུགས་སའི་ས་ཡུལ་དངོས་གནས་འདི་ཞེས་ད་བར་ངེས་གཏན་འཁེལ་བ་ཞིག་མ་བྱུང་བས་འདི་ཐོག་ཞིབ་འཇུག་ཞིག་ཀྱང་ངེས་པར་གནང་དགོས་འདུག་གོ།",
    "མི་ནག་ཅན་ཡེར་པའི་ཕུག་ཏུའདུག་སྤྱིའི་ཐ་བར་སྒེར་གྱི་གཤོལ་མི་གཅོག་ཅེས་སྨྲས་པར་གྲགས།",
    "རྒྱལ་རབས་གོག་པོས་ལྡན་རྩ་འཆག་ཅེས་དགག་པ་མཛད་འདུག་",
    "ཀློང་ཐང་དུ་ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་འདུག་པར་ཞུས་པས།",
    "༨ མི་ཆུང་བ་འདུག་ཅེས་གསུངས་ཏེ་མཉེས་མཉེས་མཛད།",
    "ཁུ་བོ་ཡང་བཙོན་ནས་འདོན་མི་ཐུབ་པ་འདུག་དེ་བས་ཁོ་ལ་ཐབས་ཀྱིས་བསྟུན་ན་ལེགས་པར་དགོངས་ནས་ལབ་སྣ་འབྲེལ་བ་དང་།",
    "ཤིན་ཏུ་ཉམ་ཐག་པར་འདུག་ཀྱང་།",
    "ཇོ་བོ་ཅིས་ཀྱང་གདན་འདྲོངས་པ་ཁྱེད་རང་མཁྱེན་ཞེས་སྤྱན་ཆབ་འབྱིན་བཞིན་པར།",
    "དེབ་སྔོན་སོགས་སུ་ལྕགས་ཕོ་འབྲུག་༡༤ ཅེས་ལོ་གཉིས་ཀྱི་ལོ་ཁྱད་ཐོན་གྱི་འདུག་ཅིང་།",
    "རག་དུང་ཡང་སྔར་མེད་པ་ལ་ཇོ་བོ་སྤྱན་འདྲེན་པའི་ཕྱིར་བཅོས་ཏེ་ལོ་པཎ་སྤྱན་འདྲེན་གྱི་དྲུང་ཞེས་གྲགས་གསུངས་འདུག་དེར་མཆོད་ཡོན་ཞལ་མཇལ་བར།",
    "ཁུ་སྟོན་གྱིས་ངའི་མིང་ཡི་གེའི་ནང་མི་འདུག་གསུངས་པར།",
    "སོགས་ཁོངས་ན་འདུག་ཞུས་པས།",
    "མི་མ་ཡིན་འདུག་ཅེས་པ་དང་།",
    "སྙེ་ཐང་རང་ལ་གདན་སའིཐེལ་དུ་མཛད།",
    "མཁས་པའི་དགའ་སྟོན་དུ་དགུང་ལོ་༧༣ རྟ་ལོ་དབྱུག་གུའི་བཅོ་བརྒྱད་ཅེས་ཟླ་༩ ཚེས་༡༨ ལ་གཤེགས་པ་གསུངས་འདུག་",
    "དམག་དཔོན་རང་ཉིད་ཀྱང་དམག་ཐོག་དེ་རང་ལ་གྲོངས་སོ་ཞེས་བཀོད་འདུག་པར་གཞིགས་ན།",
    "འཁྲུངས་ཡུལ་ནི་དེབ་ཐེར་རྒྱ་མཚོ་དང་ཤིན་ཏུ་མཐུན་པར་འདུག་པས་གེ་སར་བྱུང་བའི་ཡུལ་ནི་འགུ་ལོག་དང་།",
    "དྲག་ལས་ཀྱི་སེམས་བསྒུལ་ཆེན་པོ་ཐེབས་ཐུབ་པ་ཞིག་ནི་གཏན་གཏན་ཡོད་འདུག།",
    "ཁཱང་ཞེས་པ་ནི་རྒྱལ་པོའི་གོ་ས་ཡིན་འདུག་ཆིང་གེ་སེ་ཁཱང་ཞེས་པ་དེ་བིད་ཀྱི་རྒྱལ་པོ་གྲི་གུམ་བཙན་པོའི་སྲས་ཉ་ཁྲིའི་སྐུ་རྒྱུད་ཡིན་ཟེར་བ་དང་།",
    "ནུབ་ཕྱོགས་པ་ཚོས་ཕྲུག་གུ་རྣམས་ལའང་སོག་པོ་སླེབས་ཡོང་ཞེས་འཇིགས་བསྐུལ་བྱེད་པ་ཞིག་ཆགས་འདུག་བྱང་ཕྱོགས་ནི།",
    "བོད་ཀྱི་བན་དེ་འཕྲད་པ་ལ་འདི་སྔ་ཟེར་བ་འདུག་བོག་ཏ་ཆིང་གེ་སེ་ཁཱང་དགུང་ལོ་དྲུག་ཅུ་ཐམ་པ།",
    "ཁྱེད་ངའི་མཆོད་གནས་ལ་བོས་པས་མཁས་པར་འདུག་ཅིང་།",
    "དེ་དང་སྦྱར་ན་གཞན་ཚོ་ཆུང་བར་གདའ།",
    "བྱས་པ་དེ་ཚོ་སྔོན་ལ་འདྲི་བར་འདུག་གསེར་ཡིག་པ་མ་མགུ་ན་གནོད་པའི་གཏམ་གཏོང་བར་ངེས།",
    "མགུ་ན་ཐོགས་ནུས་པ་གཅིག་གདའ།",
    "འདིར་མི་དྲག་པ་དག་འདབ་ནོར་འཁྱེར་ནས་འོངས་པ་ཚོ་བཟང་པོར་གཏོང་བར་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཀྱང་བསམ་པ་བྱས་ནས།",
    "འདི་ན་དེ་ཚོ་ལ་དགའ་བ་འདུག་སྤྱིར་ནོར་ལ་འདིར་རྩིས་ཆུང་ཡང་།",
    "གསེར་ཡོན་གང་འདོད་འོང་བར་འདུག་པས་དགོངས་མཛོད།",
    "འདབ་ནོར་དེ་ཡང་རང་རང་སོ་སོས་བློས་དཔྱད་མ་གཏོགས།",
    "རྒྱའི་མི་ཡུལ་གཅིག་ཕུལ་ཞེས་རྒྱའི་ཡུལ་ཁམས་གཅིག་ཕུལ་བའི་དགོངས་པ་བཞེས་འདུག་འདི་ནི་ཅུང་ཟད་མ་དག་པར་མཐོང་ཞིང་།",
    "ཞེས་པའི་བསྔོ་བ་ཡང་བ་མཛད་འདུག་ཕུལ་ཞིང་།",
    "གཞུང་དོན་སྐབས་བཞུགས་ས་ཁྲི་མཐོ་དམའ་འདྲ་མཉམ་གནང་༣༤ ༣༤ཧ་ཝར་ཐ་གྱྣཕྣཔྱྤདང་༥༧རྒྱུ་བྱས་ཞེས་བྲིས་འདུག་དེའི་དུས་སུ་སྐྱེས་མཆོག་ཀརྨ་པཀྵི་ཆེན་པོ་ཡང་ཧོར་ཡུལ་དུ་བྱོན་ཞིང་།",
    "རབ་བྱུང་བཞི་པའི་ཤིང་སྟག་ཟླ་༥ཚེས་༩སྤྱི་ལོ་༡༢༥༤ ཞེས་མཆོད་ཡོན་གྱི་ཁུངས་སྐྱེལ་གསལ་པོ་བཀོད་འདུག་ཅིང་།",
    "གདུང་རབས་ནང་ཡོད་པའི་འཇའ་སའི་ཞལ་བཤུས་དང་ཡང་ཕལ་ཆེར་ཞུས་དག་དུ་འགྲོ་འདུག་པས་ཡིད་སྟོན་འཕེར་ངེས་ཡོད།",
    "ཕྱི་རྒྱལ་དཔེ་མཛོད་ཁང་ཁག་ལ་འཛམ་གླིང་ཡིག་སྣ་ཕྱོགས་བསྡུས་ཀྱི་དེབ་ནང་འཕགས་པའི་ཧོར་ཡིག་ཅེས་གྲུ་བཞི་བརྩེགས་མ་དེ་རང་བྲིས་འདུག་ལྕགས་རྟ་༡༢༧ ལོར་སླར་ཡང་རྒྱལ་པོ།",
    "མི་དཀར་པོ་ལ་ཞྭ་ནག་པོ་གཡོགས་བྱུང་ཞེས་ཉེས་མེད་ལ་ཉེས་འགལ་བྱུང་བའི་བརྡར་བརྗོད་བཞིན་པ་འདི་ཡང་སྐབས་དེ་དུས་ནས་བྱུང་བའི་ཤོད་སྲོལ་ཞིག་ཡིན་འདུག་གདུང་རབས་ནང་།",
    "སྒྲ་གཅིག་པ་རང་འདུག་ཧོར་དམག་རྣམས་འོད་ཡུག་ནས།",
    "ཞྭ་ནག་པོ་གཅིག་གྱོན་འདུག་པའི་གཏམ་ཕྱིས་རྒྱལ་པོས་གསན་པ་ན་ཉེས་པ་མེད་པའི་བརྡར་དགོངས་ནས་དམག་དཔོན་རྣམས་ལ་བཀའ་བཀྱོན་ཕེབས་པ་ཡིན་འདུག་༥༥ ༥༥ རྒྱལ་རབས་འཕྲུལ་གྱི་ལྡེ་མིག་༢༨ ན་༥ ཅེས་དང་།",
    "དཔོན་ཆེན་ནག་མེད་བསད་པ་སོགས་གནའ་བོའི་ངག་རྒྱུན་དང་མཐུན་འདུག་ཀྱང་།",
    "ཞེས་གསུངས་འདུག་དགོན་ཡུལ་ཚང་མེ་ལ་བསྲེགས།",
    "གཏོར་མ་བཏོན་དུས་མ་བསྐམས་པར་རློན་པར་འདུག་ཅེས་གྲགས།",
    "བཞི་པ་བར་འདུག་པ་དེ་དག་ལ་ཞིབ་འཇུག་ཅིག་བྱེད་སྐབས།",
    "བཅོམ་འཕྲོག་བྱས་པའི་དངོས་པོ་ཚང་མ་ཕྱིར་འཕྲོག་བྱས་འདུག་ལྡི་ལིར་དམག་དཔོན་མ་ལིག་ནེག་པའི་དང་།",
    "ཀ་ར་ཇལ་ཞེས་པ་ས་སྐྱ་ཟེར་བའི་སྒྲ་མ་དག་པ་ཞིག་མིན་ནམ་སྙམ་པ་བཅས་འབྲི་གུང་པའི་རོགས་སུ་ཡོང་པའི་ཀླ་ཀློའི་དམག་ཅེས་པ་འདི་རང་ཡིན་པ་ཡིད་ཆེས་བྱས་ཆོག་པ་འདུག་ད་དུང་འབྲི་གུང་པའི་མི་སྣ་སུ་ཕྱིན།",
    "༧ ན་༡ ཞེས་གསུངས་འདུག་ཀྱང་།",
    "སི་ཏུ་རྟ་རྭར་འཁྲིད་དེ་རྟེ་བྲེས་ཀྱི་ཁ་ཤིང་གོག་ལ་ཁད་ཅིག་འདུག་པ་དེ་བསྟན་ནས།",
    "སོག་དུས་སུ་རྟ་དཔོན་ནམ།",
    "གསུམ་ནས་ཁྲི་དཔོན་ཁྱེད་རང་ལ་རང་འཇགས་སྤྲོད་རྒྱུའི་ཁས་ལེན་བྱེད་ཀྱི་ཡིན་ལབ་པར།",
    "ཁྱེད་རང་ལ་འདི་ལྟ་བུའི་མཛད་དཀའ་ཡོད་ན།",
    "གཞིས་ཀ་རྣམས་བླངས་འདུག་གཡའ་ཕག་གཉིས་ཀྱི་གྱོད་གཞི་འདི་ཚབས་ཆེ་རུ་གང་འགྲོ་ལས་ཞི་བའི་འགྲིགས་ཐབས་མེད་པ་ལྟ་བུ་ཞིག་ཡོད་ཀྱང་།",
    "ཡར་འབྲོག་ཁྲི་དཔོན་ལའང་དགོས་པ་བྱུང་ཚེ་ཨང་སར་སྦེ་ལན་དགོས་པའི་གནས་ཚུལ་ཡང་བཏང་འདུག་དཔོན་ཆེན་རྒྱལ་བ་བཟང་པོས།",
    "དེ་དུས་རྒྱལ་བ་བཟང་པོའི་ཞབས་གྲས་ཚོས་བྱང་རྒྱལ་ལ་དུས་རྒྱུན་ལས་ལྷག་པའི་གུས་འདུད་བྱེད་འདུག་པར་དེ་ངན་གཡོའི་རྣམ་པ་ཞིག་ཡིན་པའི་དོགས་པ་བཟོས་པ་དང་།",
    "དཔོན་ཆེན་སྣེ་གདོང་ལ་འབྱོར་པའི་དགོང་དྲོ་བྱང་རྒྱལ་ནས་གུས་འདུད་ཀྱི་མཇལ་ཕྱག་ལ་བཅར་དུས་ས་སྐྱའི་དཔོན་རིགས་ཚོའི་ལས་ཀའི་བྱེད་ཚུལ་ལ་བལྟས་ན་བོད་ལ་ཞི་བདེ་ཡོང་བ་མི་འདུག་དགོངས་པ་དང་།",
    "ཅིག་བྱས་བྱུང་ཞེས་གསུངས་འདུག་ཉིན་རྗེས་མ་ལ་གཡའ་བཟང་ཁྲི་དཔོན་དཔོན་འཁོར་མང་པོ་བཅས་འབྱོར་ཏེ་ཞིབ་གཅོད་པའི་བཞུགས་སྒར་དང་ཉེ་སར་སྒར་ཕབ།",
    "ངས་ཁྱེད་རང་སྣེ་གདོང་རྩེར་གཏོང་ཐབས་བྱེད་རྒྱུར་དེ་སྐབས་ཧོར་གཞོན་ནུ་བཟང་པོར།",
    "ཁྱེད་རང་བསམ་བློར་འགྱུར་བ་བྱུང་བ་དངོས་གནས་ཡིན་ན་ཞིབ་གཅོད་པའི་མདུན་སར་གཡོག་པོར་ལན་བསྐུར་དགོས་ལབ་པ་ལྟར་ཞིབ་གཅོད་པའི་མདུན་སར་བྱང་རྒྱལ་ནས།",
    "རྒྱལ་བ་བཟང་པོ་ས་སྐྱར་ཕེབས་རན་པས་དམག་དཔུང་གང་འཚམས་ཤིག་གཤམ་ཆུའི་ཕ་རིར་བྱ་སའི་འགྲམ་དེར་བཞག་སྟེ་ཕྱིར་ལོག་བྱས་འདུག་སྐབས་ཁྱད་མཚར་པོ་ཞིག་ལ།",
    "དེ་དུས་ངས་དཔོན་ཆེན་ལ་གུས་འདུད་ར་མ་ལུག་ཅིག་བྱས་པ་ཡིན་ཞེས་གསུངས་འདུག་དེ་ལ་བལྟས་ན་གུས་ཞབས་ཀྱང་ཇི་བཞིན་མ་མཛད་ཅིང་།",
    "འཕྲུལ་གྱི་ལྡེ་མིག་ནང་ཁུ་བོ་ཞེས་གསུངས་འདུག་དེ་ཁའི་མུ་འཐུད་དེ་ཞིབ་སྐབས་ཡབ་སྲས་རང་ཡིན་པ་ཐེ་ཚོམ་ཆོད།",
    "བཀའ་དྲུང་ནོར་ནང་པའི་ཁྲི་ལོ་ཐམ་དེབ་ནང་དགུང་གྲངས་༨༢ ཞེས་གསལ་འདུག་བཞིར་ཕེབས་པ་ཤིང་རྟ་༡༤༧༤ ལོར་བླ་བྲང་རྒྱལ་མཚན་མཐོན་པོར་མྱ་ངན་ལས་འདས།",
    "མཇལ་འཕྲད་ཀྱང་ཕེབས་གདོང་རང་ལ་བྱས།",
    "མཚོ་སྔོན་གྱི་ལྷོ་ནུབ་ཐད་ཆབ་ཚ་ཞེས་པའི་ས་གནས་དེ་ཡིན་ཚུལ་གསུངས་འདུག་ཞེས་བཏགས།",
    "རྒྱ་སེང་ཞེས་པ་ཕྱག་མཛོད་གཞན་ཞིག་མེད་དམ་སྙམ་ང་ལ་དྲི་བ་གནང་མཁན་ཡོང་འདུག་པས།",
    "སྐྱིད་ཤོད་པ་སོགས་ཡིན་ཚོད་འདུག་གཙང་ཕྱོགས་སྦྱིན་བདག་རྣམས་ཀྱི་ཞུས་ངོར་དང་།",
    "ཞེས་བཀའ་བཀྱོན་ཡང་གནང་འདུག་པ་ཤིན་ཏུ་ནས་ཐུགས་བདེན་པར་སྣང་ངོ།",
    "དེ་མི་འབྱུང་ཇོ་བོ་ཁྱེད་རང་ཤེས།",
    "སོར་ཕྱེད་ཀྱིས་འཇལ་རིན་མི་གདའ་ཡང་།",
    "འདུག་པ་མངོན་སྤྱོད་ཀྱི་ལས་སྦྱོར་ལ་ནུས་ལྡན་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཚུར་ལམ་ཞལ་ངོ་བཀྲ་ཤིས་ཀྱིས་གཙོས་པ་ཀུན་འཛུམ་ཞལ་མུལ་བ་དང་བཅས་འབྲས་སྤུངས་སུ་འབྱོར་པ་ཤེས་པ་སྐད་ཅིག་མའི་སྔ་ཕྱིའི་ལའང་འགྱུར་ལྡོག་འདི་གཤིས་ལུགས་སུ་འདུག་༡༤ ༡༤དུ་ཀཱུ་ལ་ཀ་པ་༦༨ ན་༦ ཅེས་གསུངས།",
    "ཞེས་གསུངས་འདུག་ལོ་འདིའི་ཟླ་བ་ལྔ་པའི་ནང་།",
    "ཕྱོགས་བཞི་ག་ནས་བསྐོར་བས་ས་མ་བརྟན་པར་བེ་རི་དཔོན་དོན་ཡོད་ནང་མི་ཉུང་ཤས་དང་བཅས་གསང་བྲོས་བྱས་འདུག་ཀྱང་།",
    "ཁྱེད་རང་ཡང་ཕྱིན་པ་འགབ་ཅེས་རྫུན་ཞིག་གཏོང་དགོས་བྱུང་།",
    "རྒྱུས་ཡོང་སྙམ་པ་ཕལ་ཆེར་ལ་ཡོད་འདུག་ཀྱང་།",
    "ཞེས་གསལ་འདུག་པ་སྐུ་འཕྲེང་གསུམ་པའི་སྐུ་ཚེའི་སྨད་དང་།",
    "དམག་ཐོག་བཟུངས་པའི་མི་གཏེ་རྣམས་ལམ་སང་ཕྱིར་སློག་བྱེད་རྒྱུ་བཅས་ལ་མཐུན་གྲོས་བཞག་འདུག་རུང་།",
    "ཞེས་ལས་ཞིབ་པ་གང་ཡང་མི་གསལ་འདུག་མར་ཅུང་ཟད་ལས།",
    "དེའི་ལོ་རྗེས་མ་ནས་བཟུངས་བལ་ཡུལ་རྒྱལ་ཁབ་གསུམ་གྱི་མི་སྣ་ཡང་ལོ་གསར་དགྱེས་སྟོན་ལ་བཅར་འདུག་པ་མཐུན་ལམ་ཡག་པོ་བྱུང་ཞིག་བྱུང་ཡོད་པར་སེམས།",
    "ས་སྟག་ལོ་ཟླ་བ་གཉིས་པའི་ཚེས་བཅུ་གསུམ་ཞེས་ལོ་ཁྱད་གཉིས་དང་ཉིན་གཅིག་ཐོན་འདུག་གོ།",
    "སོག་པོ་ཚོས་རྒྱ་མིའི་ས་མཚམས་ནང་བརྒལ་བསྐྱོད་ཀྱིས་ས་མཚམས་ཀྱི་རྒྱ་གྲོང་རྣམས་ལ་རྟག་ཏུ་བསུན་གཙེར་བྱེད་འདུག་ན།",
    "བྱུང་འདུག་གོ།",
    "བར་སྐབས་སུ་གཞན་རྐྱེན་ངན་པས་དབྱེན་བཅོས་པར་བརྟེན་འབྲུག་ལུགས་སུ་འགྱུར་བ་མངའ་རིས་ནས་བོད་པར་བསྡོ་ཐུབ་པ་ཡོང་དོན་མི་འདུག་སྙམ་བཏང་སྙོམས་སུ་བཞག་ནའང་།",
    "ཁོ་རང་ཕྱི་དགེ་ལུགས་པའི་ཁ་འཛིན་མཛད།",
    "ཞེས་གསལ་འདུག་པས་གསང་རྒྱ་མི་འཆོལ་བའི་ཐབས་ཤེས་ཀྱང་དེ་དང་།",
    "མཐུན་ལམ་ཡང་གང་ཡག་ཅིག་བྱུང་འདུག་རུང་།",
    "ཆིབས་བསྐྱིལ་ཞུ་མ་ཐུབ་པར་ཆིབས་བསྒྱུར་ཐག་ཆོད་འདུག་ཚུལ་བྱུང་བ།",
    "གོང་པ་ཅན་ལ་ལ་པ་ཤག་ཟེར་སྲོལ་འདུག་པས་ཞིབ་ཆ་མཛོད།",
    "སྐུ་ཞབས་ཀྱི་མཛད་པར་མི་དམངས་ཀྱི་ལོག་བལྟ་བྱེད་ཀྱིན་འདུག་པས།",
    "ཕེབས་བསྐྱིལ་ནན་ཆེར་ཞུས་འདུག་ཀྱང་།",
    "ད་ཆ་སྐུ་མི་ངལ་བའི་སྟབས་ཆིབས་བསྒྱུར་གནང་མི་དགོས་པ་འདུག་བཅས་ཕེབས་པས་རྟ་ཁ་བསྒྱུར་ཞིང་།",
    "ཕེབས་ལམ་དུ་སྐུ་བསྐྱིལ་ཙམ་གནང་བའི་ཉེར་ལེན་ཞུ་མི་གཏོང་དགོས་འདུག་པ་ལྟར་འོད་ཡུག་བྲག་དཀར་བའི་ཐད་དུ་བསྡད་ཅིང་།",
    "དེ་མཚམས་ནས་ངེད་རང་ངོས་ཀྱི་སྙན་འབུལ་ཞུས་ཆོག་པ་དགོས་ཚུལ་སོགས་ནན་ཆེའི་ཞུ་ཡིག་བཅས་ནས་ཉིན་མ་ལྟོས་པར་ཕྱིན་འདུག་ཀྱང་།",
    "འདུག་པ།",
    "འདུག་ཅེས་གསལ་བའི་ཁོངས་ནས་འདིར་ཅུང་ཟད་བྲིས་པ།",
    "ལོན་དང་ཁྱད་པར་མི་འདུག།",
    "ཡང་རང་རྣམ་དེ་གའི་ནང་།",
    "གོང་ས་ཚངས་དབྱངས་རྒྱ་མཚོ་དེ་ཉམས་མཚར་པོ་ཞིག་འདུག་སྟེ།",
    "འགྲོ་དོན་རྒྱ་ཆེ་བ་བསྐྱངས་མཐར་སོག་ཡུལ་ཨ་ལག་ཤག་ཏུ་ས་ལུག་༡༧༣༩ ལོར་སྐུ་གཤེགས་ཞེས་དགུང་གྲངས་ལྔ་བཅུ་ང་དྲུག་ཙམ་བཞུགས་པ་ལྟ་བུ་ཞིག་འདུག་པས།",
    "ཁྱེད་རང་ཇི་མཛད་ཐུགས་འདོད་ལྟར་གནང་འཚལ།",
    "རབ་ཏུ་ཁྲོས་ནས་ལྷ་བཟང་ཁཱང་རང་ཉིད་དཔུང་དང་བཅས་སྤ་གྲོ་ཕྱོགས་དང་།",
    "སོགས་ཀྱང་ཕེབས་འདུག་ཚེས་༩ ཉིན་འདམ་དུ་རྒྱལ་པོའི་བཞུགས་སྒར་དང་ཐག་ཧ་ཅང་མ་རིང་པར་སྒར་བབས།",
    "མགུལ་བཅད་དུས་ཞལ་དབུགས་ཆད་གྲུབ་འདུག་ཅེས་གྲགས།",
    "ཅེས་འདུག་པར་གཞིགས་ཚེ་ཕལ་ཆེར་འཇུན་སྒར་ལ་འཁྲིད་དེ་སྐུ་སྲོག་བཀྲོངས་མེད་དམ་སྙམ།",
    "ཞེས་པའི་ཞུ་ཡིག་ཕུལ་འདུག་ཕྱག་བྲིས་དེ་ཁཱང་ཆེན་ནས་ཀྱིས་ཕྱག་ཏུ་ཐེབས་པ་དང་།",
    "དུས་དེ་ནས་ཁོང་གཉིས་མཐུན་པའི་གྲོགས་མཆེད་དུ་གྱུར་འདུག་དེ་མཚམས་མངའ་རིས་སྐོར་གསུམ་ནས་ཁཱང་ཆེན་ནས་ཀྱིས་ཡུལ་དམག་བསྡུ་བསྐོངས་ཀྱིས་རིམ་པས་ས་དགའ།",
    "ཕྱི་ཉིན་མཇལ་ཁ་གནང་བར་གཟིམ་གུར་ཕྱི་རོལ་དུ་དམག་སྒར་གྱི་རྭ་བ་གསུམ་རིམ་འདུག་པའི་ཕྱི་མའི་སྒོར་འགག་པ་རབ་བརྟན་དང་།",
    "ཆིབས་རགས་ཕེབས་ཕྱོགས་སྐོར་ཅུང་ཟད་ཞལ་གསལ་བ་འདུག་པས་འདིར་བཀོད་པ་ཡིན།",
    "འདུག་ལྷ་སྡོད་རྒྱའི་དཔོན་དམག་རྣམས་ནས་མི་སེར་ཐོག་ཟན་གོད་ཆེ་ལ།",
    "ཚུལ་དེ་ལས་ལྡོག་སྟེ་བཀའ་བློན་རྣམས་ནང་མ་དན་པས་ཆབ་སྲིད་ལ་ཕུགས་ཀྱི་སྐྱོན་ཤོར་ཆེན་པོ་བྱུང་འདུག་པའི་རྩ་རྐྱེན་ནི།",
    "བཅས་ཉེ་འགྲམ་གྱི་ས་འགོལ་ཞིག་ཏུ་སྦས་ཏེ་བཞག་ཁོ་རང་སྲས་བགྲེས་གཞོན་གཉིས་༨ ༨སྲས་བགྲེས་པ་འགྱུར་མེད་ཚེ་བརྟན་རྗེས་མངའ་རིས་སྤྱི་ཁྱབ་དང་།",
    "དེ་ནས་སྤོ་རོང་དུ་དབོན་རིགས་ཨ་ཇོས་དང་བླངས་ཀྱི་རྟ་དམག་བརྒྱ་སྐོར་དང་།",
    "ཁོ་རང་ན་ཚོད་སྨིན་ཡང་ཞབས་རྗེས་སུ་བཅར།",
    "རུ་ལྡིང་བཅས་ཀྱང་རང་རང་ཁོངས་ཀྱི་ལྡིང་དམག་རྣམས་བསྡུས་ཏེ་ཕོ་ལྷའི་ཕྱོགས་སུ་ཡོང་།",
    "ནག་ཚང་ཕྱོགས་སུ་ཨ་ཇོ་དཔལ་བཟང་ཟེར་བས་སློང་རྐྱེན་བྱས་སམ་ཡང་ཟེར།",
    "ངའི་མེས་པོ་རྩིས་ཟུར་བཀའ་དྲིན་ཅན་ཞྭ་སྒབ་གཞིས་སུ་ལྷ་གསོལ་ལ་ཕེབས་སྐབས་ང་རང་ཡང་ཞབས་ཕྱིར་ཡོད་པ།",
    "ས་བྱ་༡༧༢༩ ཟླ་༡༢ ཚེས་༡ ལ་གནང་བའི་སྲིད་ཐམ་བཀའ་ཤོག་བཅས་རིམ་བཞིན་བཙན་སྨིན་གནང་འདུག་པ་དང་།",
    "ཨེམ་ཆི་ཁྱེད་རང་གཉིས་མ་གཏོགས་པའི་མི་ཕྱོགས་འདིར་ཡོང་མི་སུ་ལ་ཡང་རྩིས་སྤྲད་མ་ཆོག་པ་བྱེད།",
    "འབྲུག་འདི་སྔ་སོར་གཞུང་དང་ཞེ་འཁོན་ཆེ་ཙམ་བྱུང་འདུག་ནའང་།",
    "སྐྱིད་ཆུར་ཡང་ལྕགས་ཟམ་ཞིག་བཙུགས་ཆོག་པའི་དགོངས་འཁྲོལ་ཞུས་པ་ལྟར་བཀའ་འཁྲོལ་གནང་འདུག་ཀྱང་།",
    "དབུས་གཙང་གནས་རྟེན་ཁག་ལ་མཆོད་འབུལ་ཞུ་བར་འབྱོར་འདུག་པ་དེའི་སྐབས་ཀྱང་རྒྱ་མིས་འཇུན་སྒར་བ་མཐར་སྐྲོད་གཏོང་ཐུབ་པ་བྱུང་ཡོད་ཚོད་མི་འདུག་ཅིང་།",
    "ལག་འདོན་གྱི་ཁྲལ་ཆད་གང་ན་ཅི་ཡོད་རྩ་ཆག་སྩལ་བ་སོགས་མི་སེར་གྱི་བདེ་ཚོ་བླ་ན་མེད་པ་ཞིག་བྱུང་འདུག་ཀྱང་།",
    "ཡང་རང་བབས་སུ་འཇོག་པ་གང་འདོད་བྱེད་རྒྱུ་ཡིན།",
    "དོན་དུ་སྙད་སྙོད་བྱེད་རྒྱུ་འདི་ཚོ་ཐམས་ཅད་ང་མ་འདོད་པར་བྱས་པ་ལོས་ཡིན།",
    "དཔའ་མཛངས་བརྟུལ་ཕོད་པ་སོགས་ལུགས་གཉིས་ཆར་ནས་བསྔགས་འོས་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཞེས་ཐུགས་ཕྱུང་པའི་རྣམ་པ་མཛད་འདུག་པ་བཅས་ལ་གཞིགས་ན།",
    "ཞེས་གསུངས་འདུག་པ་ནས་ར་འཕྲོད་གསལ་པོ་འདུག་པ་ད།",
    "འདུག་ལོ་འདིར་སྲིད་སྐྱོང་དཱ་ལའི་བཱ་ཐར།",
    "སྦྱིན་ཚར་བས་ངོ་གཏུགས་མི་ཡོང་བ་འདུག་དེ་རིགས་མ་བྱས་ངེས་ཅན་ཁུངས་བརྡོལ་མེད་ན་དེ་གས་འཐུས་ཚུལ་བྱུང་བ།",
    "བོད་མི་ནང་ཚགས་ལ་དབྱེན་སྦྱོར་དཀྲུག་ཤིང་བཟོ་འདུག་པས་དེ་དག་གཅིག་ཀྱང་མེད་པ་འཕྲལ་དུ་ཕྱིར་འཐེན་ཡོང་བ་དང་།",
    "མི་དམངས་མང་པོ་ཡོང་སྟེ་སྐྱབས་བཅོལ་དུ་ཡོད་པའི་རྒྱ་རིགས་རྣམས་རྩིས་སྤྲོད་དགོས་ཚུལ་ཤུགས་ཆེ་ཙམ་བྱས་འདུག་ཀྱང་།",
    "རྩ་ཚིག་དབྲལ་བ་སོགས་བྱས་འདུག་སྲིད་སྐྱོང་དཱ་ལའི་བཱ་ཐུར་འགྱུར་མེད་རྣམ་རྒྱལ་ཏཱ་ཞིན་གཉིས་ནས་གཡོ་ཐབས་ཀྱིས་བཀྲོངས་པའི་གནས་ཚུལ་གསན་མ་ཐག་གོང་ས་མཆོག་ནས་གནས་སྐབས་ཛ་དྲག་རིང་ཆབ་སྲིད་ཀྱི་དབུ་འཛིན་དུ་དགའ་བཞི་རྡོ་རིངགུང་པཎ་ཌི་ཏ་མགོན་པོ་དངོས་གྲུབ་རབ་བརྟན་ལ་བསྐོ་གཞག་སྩལ་བ་དང་།",
    "ལྕམ་བགྲེས་གཞོན་སོགས་ཕྱིར་མི་ལྡོག་པའི་རྒྱང་ཕུད་ལ་བཏང་འདུག་སྲིད་སྐྱོང་ཝང་དཱ་ལའི་བཱ་ཐུར་དེ་ཉིད་ཀྱི་སྐོར་ལ།",
    "འདུག་དེ་ནས་བཟུང་བཀའ་ཤག་༤ ༤ བཀའ་བློན་གྱི་ལྷན་ཚོགས་དེར་བཀའ་ཤག་དང་།",
    "དོ་དམ་བཅས་དམིགས་བསལ་འཛུགས་གནང་མཛད་འདུག་པ་ནི་མཛད་རྗས་བཀའ་དྲིན་ཆིན་པོ་ཞིག་བྱུང་འདུག་ཤིང་ཕག་༡༧༥༥ ལོར།",
    "ཆབ་འབངས་རྣམས་ལའང་མ་ཡིས་བུ་ལ་བརྩེ་བ་ལྟར་བསྐྱངས་པས་སྐྱེ་རྒུ་སེར་སྐྱ་མཆོག་དམན་ཚང་མས་གངས་ཅན་ལྷ་གཅིག་ཕྱག་ན་པདྨོ་ཞེས་མགྲོན་གཅིག་དབྱངས་གཅིག་ཏུ་བསྟོད་བསྔགས་ཞུ་བའི་ཡུལ་ཁྱད་པར་ཅན་ཞིག་བྱུང་འདུག་གོ།",
    "དགྱེས་སྟོན་སོགས་ལ་བཅར་འདུག་ཤིང་ལུག་༡༧༧༥ ཁོ་ཚོ་བོད་ནས་རྒྱ་གར་ལ་ཕྱིར་ལོག་སྐབས།",
    "ཧིན་འདུའི་སྐུ་བརྙན་ཡང་ཁ་ཤས་འདུག་སྐུ་གཉེར་རྒྱ་གར་བ་རྒད་པོ་ཞིག་འདུག་པ་དེས་བརྗོད་གསལ།",
    "གོང་མའི་བཀའ་འབྲེལ་ལྟར་ཕེབས་བྱམས་ནང་རང་ནས་བཞེས།",
    "ངང་ཙམ་ནས་ལྷ་སྲས་དྲུག་པས་གོང་མ་ཆེན་པོ་པཎ་ཆེན་ཨེར་ཏི་ནི་མཇལ་བར་རིངས་པའི་ཚུལ་གྱིས་ཕེབས་བསྒུགས་གནང་འདུག་པས་མྱུར་དུ་ཕེབས་དགོས་ཀྱི་བརྡ་བྱུང་མ་ཐག་བཀྲས་ལྷུན་ཞབས་གྲས་ཐོག་ཕེབས་བསུའི་རིགས་དང་།",
    "ཟླ་༨ ཚེས་༢༡ ཉིན་གདན་ས་བཀྲ་ཤིས་ལྷུན་པོར་ཕེབས་འབྱོར་གནང་འདུག་༡༤ ༡༤ཉི་མའི་འོད་ཟེར་སྨད་ཆ་༢༡༡ ན་༢ ནས་༢༢༦ ན་བར།",
    "ལྷག་པར་རྒྱ་ནག་མན་ཇུ་གོང་མས་ཀྱང་བཀུར་གཟོས་བདག་རྐྱེན་བླ་ན་མ་མཆིས་པ་ཞུས་ཏེ་དབུའི་མཆོད་གནས་སུ་ཁ་ཙམ་མ་ཡིན་པར་དོན་གྱི་བཀུར་བས་མཆོག་དམན་ཀུན་གྱིས་བསྔགས་པའི་ཡུལ་བླ་ན་མེད་པ་ཞིག་འདུག་ཀྱང་།",
    "ཆོ་ལོ་བཅས་ཅུང་ཟད་མི་མཐུན་ཙམ་གསལ་འདུག་པས་ཞིབ་མཛོད།",
    "གནང་འདུག་ད་ནི་བོད་དང་།",
    "ཊམ་དཀར་གསར་རྙིང་ཐད་ལ་མཛའ་ཐང་བབས་མཚུངས་ཤིག་བྱས་པས་འགྲིགས་ཚོད་འདུག་ན་བོད་གོར་དཀར་ཚོ་ལེགས་ལམ་ཟིང་ཤིག་ཏུ་མི་འགྲོ་བའི་འགྲིགས་འཇགས་མི་བྱེད་དཀའ་མེད་ལས།",
    "འདུག་ཅེས་གསལ་བ་ལས་གོར་ཥ་རྒྱལ་པོར་བཀའ་ལན་ཇི་འདྲ་ཞིག་གནང་ཡོད་ཞལ་གསལ་མི་འདུག་མེ་ལུག་༡༧༨༧ ཟླ་༦ པའི་ནང་།",
    "བོད་མི་དགྲ་འཐབ་ལ་སྦྱང་པ་མེད་གཤིས་ཕུགས་མཐའ་མཐོང་དཀའ་བས་ཞི་དྲག་ཇི་མཛད་ལྷུས་ཏིང་མཛད་དགོས་ཞེས་གསུངས་འདུག་ཀྱང་།",
    "དགོངས་གཞིར་ཇི་ཡོད་མ་ཤེས་ཚུལ་ཞིག་བཏང་འབྱོར་འདུག་པ།",
    "མཐའ་མ་ཇི་ཡོང་སྙམ་པའི་དོགས་པ་ཆེན་པོ་བྱུང་འདུག་དེ་དུས་རྒྱ་དཔོན་རྣམས་ནས་ཆིངས་འདུན་རང་ལ་འགྲོ་ཐབས་འབད་བརྩོན་བྱས་པར་བརྟེན་དམག་སར་ཡོད་པའི་ཞབས་པད་དང་།",
    "དོན་ལ་ཕ་རོལ་པོར་ཞུ་བ་འཐེན་པར་འགྲོ་བ་ལྟ་བུ་ལས་དགེ་མཚན་མ་མཐོང་ཚུལ་ཉིན་ནས་ཉིན་བཏུད་བརྗོད་འདུག་ཀྱང་།",
    "མངའ་འབངས་མི་སེར་རྣམས་གཏན་བརླགས་འགྲོ་འདུག་པས།",
    "གཞུང་ཕྱག་མཛོད་ལ་རྒྱ་དངུལ་རྡོ་ཚད་ལྔ་བརྒྱ་ཐམ་པའང་གནང་ཆོག་མེད་པ་ལྟ་བུ་ཞིག་འདུག་པ།",
    "བཀའ་ཤག་བཅས་པར་ཁོ་རརང་ཆབ་སྲིད་ཀྱི་ཕྱག་ལས་ལོ་བཅུ་གནང་རིན་རྣམ་གན་ལ་བཀར་འཇུག་མང་པོ་གནང་ཡོད་ཚུལ་གསལ་འདུག་པ།",
    "རྩིས་དཔོན་བདེ་སྦུག་པ་ཁམས་མ་འཚོ་བའི་གནས་ཚུལ་འབྱོར་ཟིན་འདུག་ཞབས་པད་ངོ་ལས་རྣམས་མགྱོགས་ཤད་ཀྱིས་ཕེབས་པ་ལྷ་རྩེར་འབྱོར་སྐབས།",
    "ཀ་ཇི་རྡམ་རྡར་པཱ་ཌས་བཅས་ལི་ཁྲི་སྤ་སྒོར་འབྱོར་འདུག་པ་མ་ཟད།",
    "མིག་ཆུ་འཛར་འཛར་བྱེད་འདུག་ཅེས་གསལ།",
    "ཁག་གཅིག་རོང་ཤར་བརྒྱུད་དེ་བཙན་འཛུལ་བྱས་འདུག་༣ ༣སྐྱྣཐྲརྡྟསྣྲ་རྒཕྱཕྱསྤྲདྲ་ནང་དེ་དུས་གོར་དམག་སྟོང་ཕྲག་བཅོ་བརྒྱད་བཏང་ཡོད་ཚུལ་བྲིས་ཤག་ཟླ་བ་བདུན་པའི་ཟླ་དཀྱིལ་ཙམ་ལ་ལྷ་སར་གོར་ཥས་ངན་གཡོ་བྱས་ཏེ་ཞབས་པད་གཉིས་འཇུས་ཏེ་བལ་ཡུལ་དུ་འཁྲིད་ཚུལ་དང་།",
    "ཞེས་བཀའ་ཕེབས་འདུག་ཀྱང་།",
    "ཞེས་གསལ་འདུག་དབུས་གཙང་།",
    "འདུག་གོང་དུ་ཇི་ལྟར་བརྗོད་པ་ལྟར།",
    "ལའི་ཀུང་རྒདྲཎརྣཐྲྒསྤྱཎརྣཐྲཞེས་པའི་ཡུལ་གྱི་རྒྱལ་ཚབ་ཀྱང་ཡིན་འདུག་ཁྲསྤྱྒབྱཎརྣཐྲ་ཎརྣདང་།",
    "༤ ནང་རིམ་བཞིན་འབྱོར་ཏེ་གོང་ས་མཆོད་ཡོན་ལ་མཇལ་ཕྱག་ཞུས་ཏེ་རིམ་བཞིན་སྒང་རོང་གཉིས་ནས་གཞིས་རྩེ་བརྒྱུད་ཤེལ་དཀར་དུ་བོད་དམག་དང་ཟླ་བསྒྲིལ་གྱིས་གཉའ་སྐྱིད་རོང་གསུམ་ལ་གོར་དམག་དང་འཐབ་འཛིངས་ཕྲན་བུ་བྱས་པར་གོར་དམག་ལ་ཕམ་ཉེས་ཆེན་པོ་གཏོང་ཐུབ་སྟེ་ཕྱིར་བྲོས་བྱས་པའི་རྗེས་དེད་ཀྱིས་རྒྱ་བོད་ཀྱི་དམག་སྣེ་བལ་པོའི་ས་ཐོག་ཏུ་སླེབས་འདུག་དེར་བལ་ཡུལ་ནང་རྒྱ་བོད་ཀྱི་དམག་ས་གཞིར་མ་གཤོང་པ་འབྱོར་ཏེ་བལ་ཡུལ་རྒྱལ་ཁབ་གསུམ་རྩ་མེད་གཏོང་རྒྱུའི་འུར་ཤོག་ཆེན་པོ་བྱུང་བར་བརྟེན་བལ་ཡུལ་དུ་བཙོན་དུ་ཡོད་པའི་ཞབས་པད་དགའ་གཡུ་གཉིས་སོགས་ལ་གནས་མལ་དང་།",
    "ད་ཆ་ཁོ་རང་ཡང་དུག་འགམས་ཏེ་ཤི་དགོས་པ་དང་།",
    "ཆིངས་ཡིག་འདྲ་གཉིས་བཞག་ཚོད་མི་འདུག་པ།",
    "གོར་བོད་ཚོང་དང་བལ་ཊམ་འཛའ་ཐང་སྐོར་གསལ་ཁ་མི་འདུག་ཅེས་བྲིས་ཡོད་ཀྱང་།",
    "རྒྱ་བོད་ཀྱི་དམག་བལ་ཡུལ་དུ་འབྱོར་སྐོར་ཚིག་རྩོམ་ཞིག་གནང་འདུག་པ་འདི་ལྟར།",
    "ཇེ་མཐོར་བསྐྱེད་ཀྱང་རང་སྡུག་རང་ཉིད་ཀྱིས།",
    "ཚང་མ་བྱེད་ཐུབ་མཁན་གྱི་ལུང་པའི་བདག་པས་བྱས་བྲིས་འདུག་ལུའུ།",
    "འདི་ཚོ་དྲན་རྟེན་གྱི་རྡོ་ལེབ་འདིའི་སྒང་ལ་བརྐོས་ན་ལུགས་སྲོལ་དང་མཐུན་གྱི་འདུག་བྱས་བཅུ་གཤམ་གསལ།",
    "ཕུ་ཀང་༤༨ ༤༨ཕུ་ཟི་ཀྲུང་ཐང་རང་ལ་ཟེར།",
