    "རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་བཅས་ལ་ལྕེ་རྐན་ལ་སྦྱར་བར་བྱས་ནས།",
    "སྣའི་རྩེ་མོར་༤བལྟ་བ་འདི་དང་།",
    "སྤྲོ་བ་དང་བསྦུ་བའི་སྤྱོར་བ་ནི་རྡོ་རྗེ་ཕྲ་མོའི་ཚུལ་ཏེ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་ཚུལ་ནི་སྔ་མ་དང་འདྲ་སྟེ།",
    "རང་རང་གི་དངོས་གྲུབ་སྒྲུབ་པ་པོ་ལ་སྩོལ་བར་འགྱུར་བའོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་༦དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཚན་ཉིད་གསུངས་པ་ཡིན་ཏེ།",
    "དམ་ཚིག་མཆོག་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "སྐྱིལ་མོ་ཀྲུང་ལ་གནས་པའོ།",
    "སྐྱིལ་མོ་ཀྲུང་ལ་ཇི་ལྟར་འདུག་ཅེ་ན།",
    "ང་ངེ་འཛིན་གྱི་ཚུལ་ཀྱིས་རྡོ་རྗེ་བཅིང་བར་སྐྱིལ་མོ་ཀྲུང་གི་སྟེང་དུ་བཀན་ཏེ་གཞག་པ་འདི་ནི་རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "མཐེ་བོང་དང་མཛུབ་མོ་གཉིས་བཀུག་པ་དང་བཅས་པས་ཁར་གཞག་པ་ནི་རྡོ་རྗེ་གནོད་སྦྱིན་ཀྱིའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་ཡེ་ཤེས་ཁུ་ཚུར་དམ་ཚིག་སྟེ།",
    "དེ་ལ་༥གཉིས་སུ་བྱས་ནས་གཡོན་པའི་རྡོ་རྗེ་སོར་མོ་བཟུང་༥ལ།",
    "རེ་རེ་ཞིང་ཡང་སྣ་ཚོགས་པའི་ཚུལ་ཉིད་དོ།",
    "བྱེན་གྱིས་བརླབ་པ་ནི་ཏིང་ངེ་འཛིན་གང་གིས་བརྟེན་༥པར་བྱེད་པ་སྟེ།",
    "དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དེ་ལ་སྟོམས་པར་ཞུགས་ནས་རང་གི་རིག་པའི་མཆོག་འདི་སྨྲས་པ་ནི་བཀའ་སྩལ་པ་སྟེ།",
    "དེ་ཏིང་ངེ་འཛིན་གང་གིས་བྱེད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "དེ་ལ་སྙོམས་པར་ཞུགས་རྟེ་ནས་རང་གི་རིག་པ་མཆོག་སྨྲས་སོ།",
    "དེའི་ཆོ་ག་རྒྱས་པ་ནི་ཡེ་ཤེས་ཆེན་མོའི་གླུ་ལ་སོགས་པའི་དབྱེ་བས་ཕྱེ་བའི་རྣམ་པར་རྒྱས་པའོ།་།",
    "དེའི་ཆོ་ག་རྒྱས་པ་ནི་སེམས་མ་ཆེན་མོ་ལ་སོགས་པའི་དབྱེ་བས་སོ།",
    "དེ་ཏིང་ངེ་འཛིན་གང་གིས་བྱེད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "རང་གི་རིག་པའི་མཆོག་ཅེས་པ་རང་གི་རིགས་བྱེན་གྱིས་རློབ་༤པར་བྱེད་པ་སྟེ།",
    "རང་གི་རིག་པ་ཐམས་ཅད་ཀྱི་ནང་ནས་དམ་པ་ཡིན་པས་རང་གི་རིག་པའི་མཆོག་སྟེ།",
    "དེའི་རྒྱ་མཚོ་ནི་དེ་རྣམས་ཀྱི་ཡང་ཚོགས་ཏེ།",
    "དེ་ལྟ་བུའི་ཚད་ཀྱི་ལྷ་མོ་རྣམས་སུ་གྱུར་ཏེ་བྱུང་བ་ནི་མཐོན་པོའོ།",
    "ཁྱབ་པར་ཇི་ལྟ་བུ་ཞེ་ན་རང་གི་ཕྱག་རྒྱ་ལག་པ་གཉིས་ཀྱིས་འཛིན་ཅིང་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "རྡོ་རྗེ་ལ་སོགས་པ་རང་གི་ཕྱག་རྒྱ་ལག་པ་གཉིས་ཀྱིས་བསྣམས་པ་ནི་རང་གི་ཕྱག་རྒྱ་ལག་པ་གཉིས་ཀྱིས་འཛིན་པའོ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་དུ་ཞེས་བྱ་བ་ནི་དེའི་དབྱིབས་ཀྱིས་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་ཆ་ལུགས་འཛིན་པའི་ལྷ་མོ་རྣམས་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་ནས་ཆེད་དུ་བརྗོད་པ་འདི་ཆེད་དུ་བརྗོད་དོ།",
    "དེ་ལྟ་བུའི་ཆེན་པོར་གྱུར་པ་ཉིད་བདག་གིས་ཐ་མི་དད་པར་གྱུར་པ་ཉིད་ཀྱིས་མཆོད་ནས།",
    "ལྷ་མོ་རྣམས་སུ་སྤྲུལ་པའི་རྗེས་ཐོགས་ཁྱེཉིད་ལ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དཀྱིལ་འཁོར་གྱི་ལྷ་མོ་རྣམས་སྐྱེད་༤པར་བྱེད་པར་༥རིག་པ་རྣམས་༦གསུངས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པའི་ལྷ་མོ་དེ་རྣམས་གསུངས་པ་ཡིན་ཏེ་ཤིན་ཏུ་དགའ་བས་ན་རབ་ཏུ་དགའ་ཞིང་སྟེ།",
    "དེ་གང་གིས་མཛད་པ་དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་སྤྱན་འདྲེན་མ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དགྱེས་པར་བྱེད་པ་མོ་སྟེ་ལེགས་པའི་རང་བཞིན་ནོ།",
    "སྣང་བ་ཆེན་མོ་ཞེས་བྱ་བ་ནི་ནམ་མཁའ་ཁྱབ་པའི་སྣང་བ་མངའ་བ་རྡོ་རྗེ་ཉི་མའི་མཚན་མའི་ཕྱག་རྒྱ་མངའ་བས་ན་སྣང་བ་ཆེན་མོ་སྟེ།",
    "རྡོ་རྗེ་ཉི་མ་དེའི་༥ཚུལ་འཛིན་པའི་ལྷ་མོའོ།",
    "དེའི་གཟུགས་འཛིན་པའི་རིག་པའི་ལྷ་མོའོ།",
    "རྡོ་རྗེ་བཞད་པའི་གཟུགས་འཛིན་གྱི་རིག་པའི་ལྷ་མོ་ཆེན་མོའོ།",
    "ཡེ་ཤེས་ཆེན་མོའི་གླུ་ཞེས་བྱ་བ་ནི།",
    "དེའི་རྗེས་སུ་འགྲོ་བ་གང་ཡིན་པ་དེ་ནི་དབྱངས་ཆེན་མོའི་རྗེས་སུ་འབྲང་མའོ།",
    "དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པ་ནི་ལྷ་མོ་འདི་ཡོད་ན་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པར་འགྱུར་བས་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པ་མ་སྟེ།",
    "རྡོ་རྗེ་སེམས་མ་སྣལ་སོགས་པ་སྒེག་མོ་ལ་སོགས་པ་ནས་རྡོ་རྗེ་འབེབས་པའི་བར་གྱི་རིག་པ་ནི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "རྡོ་རྗེ་འབེབས་པའི་བར་དུ་རང་རང་གི་རིག་པ་འདི་རྣམས་ཀྱིས་༢སྤྲུལ་པའི་རྗེས་ཐོགས་ཉིད་ལ་རང་རང་གི་གནས་སུ་བཀོད་པ་ནི་ལས་ཀྱི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་ཡིན་ཏེ།",
    "རིག་པ་ཐམས་ཅད་རེ་རེ་ཞིང་བཟླས་བརྗོད་ཁྲི་བྱ་བ་ནི་འདིར་སྔོན་དུ་བསྙེན་པ་ཡིན་ནོ།",
    "གཞན་དག་གིས་ནི་མ་ཡིན་ཏེ།",
    "ལྷ་མོ་ཕྱག་རྒྱ་བཅས་པ་ཛྲེ།་།",
    "རྡོ་རྗེ་འབེབས་པའི་བར་གྱི་ལྷ་མོ་དེ་རྣམས་ཕྱག་རྒྱ་དང་བཅས་པ་བྲི་བར་བྱའོ།",
    "བདག་ནི་དོན་ཡོད་པར་གྲུབ་པ་ཉིད་དོ་ཞེས་བྱ་བའི་བར་དུ་བསམ་ཞིང་བསྒོམས་ལ་དགའ་བས་ཞེས་པ་༡སྒེག་མོས་སོ།",
    "རིག་པའི་ལྷ་མོར་རབ་སྤྱོར་བས།",
    "རང་གི་ལྐོག་མའི་ཕྱོགས་སུ་རྡོ་རྗེ་གླུ་མའི་པི་ཝང་བརྡུང་བ་ལ་སོགས་པ་སྤྲུལ་ལ།",
    "རང་གི་སྤྱི་བོའི་ཕྱོགས་སུ་ལྷ་མོ་གར་མ་སྤྲུལ་ལ།",
    "གང་གི་ཕྱིར་གཟོད་ནས་དག་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱི་གདོད་༢མ་ནས་དག་པ་དེ་ཡང་གང་གིས་ཀྱང་བྱས་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་གི་རྡུལ་ནི་ཕྲ་མོ་རྣམས།",
