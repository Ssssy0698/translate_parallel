    "ཞེས་བྱ་བ་ནི་གང་གི་རྡོ་རྗེ་ཇེག་པ་སྟོན་པར་མཛད་པ་ནི།",
    "རྡོ་རྗེ་འབེབས་པའི་བར་རེ་རེ་ཞིང་འདིར་སྐྱེས་པས་ན།",
    "ད་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བཀའི་རྗེས་སུ་འཇུག་པའི་རང་བཞིན་གྱི་༦དམ་ཚིག་གི་ཕྱག་རྒྱའི་ངོ་བོ།",
    "ཡང་གཅིག་ཏུ་འདུས་པར་གྱུར་ཏེ་ཞེས་བྱ་བ་ཡང་ཞེས་བྱ་བའི་སྒྲ་ནི་སྙེལེགས་སོ་ཞེས་བྱ་བའི་སྦྱིན་པ་འདུས་པར་མཛད་པ་ལ་ལྟོས་ནས་ཡང་ཚོགས་པར་མཛད་པས་ན།",
    "བྲི་བ་དག་གིས་བསྐོར་ཞིང་རབ་ཏུ་འཇུག་པའི་ངང་ཚུལ་འདི་ལ་མངའ་༥བས་ན།",
    "རབ་བསྒྲུབ་མཛད་ཅེས་བྱ་སྟེ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་སྤྱོད་པའི་ངོ་བོ་རྡོ་རྗེ་ལེགས་པའོ།",
    "སྤྲོས་མེད་ཅེས་བྱ་བ་ནི་ངག་གི་རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་མེད་པའི་ཕྱིར་རྡོ་རྗེ་བསྲུང་བའོ་༤།",
    "གདོན་ཆེན་པོ་ཞེས་བྱ་བ་ནི་ཆེན་པོ་ཉིད་ནི་དེ་བཞིན་ཉིད་ཀྱིས་ཐམས་ཅད་དུ་སོང་བའི་ཕྱིར།",
    "ཆེན་པོ་ནི་དེ་བཞིན་ཉིད་ཐམས་ཅད་དུ་སོང་བ་ལས་སྐྱེས་པ་ནི་ངོ་བོ་གང་ཡིན་པ་འདི་ལ་མངའ་བས་ན་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ་རྡོ་རྗེ་ཁུ་ཚུར་དེ་མཚན་བཅུ་དང་ཕྱག་རྒྱ་ཀུན་ལ་ཞེས་བྱ་བ་ལ།",
    "ཞེས་བྱ་བ་ནི་བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པའི་མུན་པ་སེལ་བར་བྱེད་པའི་ཉི་མར་གྱུར་པའི་ཡེ་ཤེས་ཏེ་ངུདོན་ཐམས་ཅད་ཀྱི་དེ་ཁོ་ན་ཉིད་ལ་དམིགས་པ་ནི་ཀུན་གྱི་དེ་ཁོ་ན་ཉིད་རྡོ་རྗེ་གཟི་བརྗིད་དེ་མཚན་བཅུའོ།",
    "ཀུན་གཟིགས་ཞེས་བྱ་བ་ནི།",
    "བདེ་ཆེན་ཁྱོད་ཅེས་བྱ་བ་ནི་དེ་མ་ཐག་པའི་རྡོ་རྗེ་ཁུ་ཚུར་༤དེ་ཉིད་དེ་ནི་དམ་ཚིག་ཆེན་པོའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་བདེ་ཆེན་ཉིད་དོ།",
    "དེ་ལྟར་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་སེམས་དཔའ་བཅུ་དྲུག་གི་སྐུའི་གསང་བའི་དོན་གྱི་སྒོ་ནས་རྡོ་རྗེ་འཆང་བ་༥ཆེན་པོ་ལ་བསྟོད་ནས་༦།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་སྤྱོད་པ་ལས་བྱུང་བའི་ཟག་པ་མེད་པའི་མགུ་བ་ནི་དགའ་བ་ཞེས་བྱ་ཤེསྣབའི་དོན་ཏོ།",
    "རྡོ་རྗེ་ཐལ་མོ་ལས་བྱུང་བ།",
    "རྡོ་རྗེ་ཕྲ་མོ་ཞེས་སུ་གྲགས།",
    "ཕྲ་མོའི་རྡོ་རྗེའི་བསམ་གཏན་གྱིས་༢དངོས་གྲུབ་ཐམས་ཅད་རབ་ཏུ་སྒྲུབ་པ་ལ།",
    "དེ་སྐད་དུ་ཡང་ཧཱུཾདེ་ཡི་རང་བཞིན་ཁྱོད་ཡིན་ནོ།",
    "དེ་ཡི་རང་བཞིན་ཁྱོད་ཡིན་ནོ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་ཚུལ་གྱིས་ནི།",
    "སེམས་དཔའ་བཅུ་དྲུག་གི་ཏིང་ངེ་འཛིན་ཏོ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་ཚུལ་སྦྱར་ལ།",
    "གང་གི་དངོས་གྲུབ་སྦྱིན་པར་བྱེད།",
    "ཅེས་གསུངས་པ་འདིས་ཀྱང་སེམས་དཔའ་བཅུ་དྲུག་གི་ཏིང་ངེ་འཛིན་གྱི་ངོ་བོ་ཁྱོད་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དངོས་པོ་ཐམས་ཅད་ནས་ཐམས་ཅད་དུ་སོང་བར་བཞེད་པ་དེའི་ཕྱིར་ན་ཁྱབ་བདག་གོ།",
    "གང་གིས་འདིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འགུགས་པའི་ཏིང་ངེ་འཛིན་ལ་སྤྱོར་བ་ཡིན་ཏེ་མཚན་དགུ་བཅུའོ།",
    "དེ་བཞིན་ཉིད་དང་ཡང་དག་པའི་མཐའ་དེ་སྟོན་པར་བྱེད་པས་ན་ཡང་དག་པའི་མཐའ་ནི་ཁྲོ་བོ་རྡོ་རྗེ་ཉི་མའི་ཡེ་ཤེས་ཀྱིས་བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པའི་མུན་པ་སེལ་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "ངག་གི་རྣམ་པར་རྟོག་པའི་བདུད་བྱེད་པས་ན་བདུད་ཅེས་གསུངས་སོ།",
    "ཐམས་ཅད་དུ་སོང་བས་ན་ཐམས་ཅད་དུ་འགྲོ་བ་ནི་ཁྲོ་བོ་རྡོ་རྗེ་ཁུ་ཚུར་ཏེ།",
    "གང་གི་ཕྱིར་དེ་བཞིན་དུ་རོ་གཅིག་པའི་སེམས་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་བཅོམ་ལྡན་འདས་ཀྱི་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བརྗོད་ཅེས་བྱ་བ་དེའི་ཕྱིར་ཕྱག་བྱ་བ་དང་ཅི་སྟེད་པའི་རིམ་གྲོ་བྱ་བ་ཡིན་ནོ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་དེ་བཞིན་གཤེགས་པ་ཁྱོད་ཀྱིས་བསྒྲུབས་ཤིང་བསྟེན་པའོ།",
    "རབ་ཏུ་མོས་པས་ཞེས་བྱ་བ་ནི།",
    "རབ་ཏུ་མོས་པ་འབའ་ཞིག་གིས་མ་ཡིན་གྱི་ཀླུ་ཉུབདུན་དང་ལྷན་ཅིག་པའི་བསྟོད་པ་བྱས་ཤིང་བསྟོད་པའོ།",
    "རང་གི་རིགས་ནི་བསྐྱེད་པར་མཛོད།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རང་རང་གི་ངོ་བོས་བཞུགས་པ་ལ།",
    "རང་གི་རིགས་ནི་བསྐྱེད་པར་མཛོད།་།",
    "དེ་ལྟར་མཚན་བརྒྱ་རྩ་བརྒྱད་པའི་བསྟོད་པ་སྔོན་དུ་འགྲོ་བའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་པའི་མཚན་ཉིད་ཀྱི་ཕྱིར་གསོལ་བ་བཏབ་ནས།",
    "ད་ནི་དད་པའི་མཚན་ཉིད་ཀྱི་རྗེས་སུ་འབྲངས་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱའི་དབྱེ་བའི་མཚན་ཉིད་ནི།",
    "དེ་དག་ལ་བདག་གིས་ཇི་ལྟར་བསྒྲུབ་པར་བགྱི་ཞེས་བྱ་བའི་རྗེས་ཐོགས་ལའོ།",
    "དེ་ནས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཀྱི་རྡུལ་ཤིན་ཏུ་ཕྲ་མོ་དང་མཉམ་པས་སྤྲོས་པ་ཉིད་ཀྱི་ཕྱརྒྱུ་སྔོན་དུ་སོང་བ་དེས་སོ།",
    "རི་རབ་ཀྱི་རྩེ་མོ་ན་རྩེ་མོ་རྡོ་རྗེ་དང་།",
    "ཐམས་ཅད་རྡོ་རྗེ་ནི་ཁྲོ་བོ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་དེ་དག་གིའོ།",
    "ཕྱག་ན་རྡོ་རྗེའི་ཐུགས་ཀའི་རྡོ་རྗེ་ལས་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེ་རང་གི་ཐུགས་ཀར་བསྟོད་པའི་སྤྱོར་བས་བསྣམས་པ་གང་ཡིན་པ་དེ་ལས་སོ།",
    "གང་གི་གཟུགས་ཀྱིས་ཤེ་ན།",
    "སྨིན་མ་བཅུམ་ཞིང་དཔྲལ་བ་བསྙེར་བ་ནི་གང་དག་གིས་དཔྲལ་བར་བཅུམ་པ་དེ་བཞིན་དུ་དེ་ཡང་ཡིན་ནོ།",
    "ཞལ་འགྱུར་བ་སོ་གཅིགས་པ་མཆེ་བ་ལྷག་གེར་བྱུང་བའི་མཆེ་བ་དག་གིས་མ་༩་མཆུ་མནན་ནས་ལྷག་གེ་གང་ཡིན་པ་དེ་ནི་མཆེ་བ་ལྷག་གེར་བྱུང་བའོ།",
    "དེ་ནས་རྔུགཞན་ཡང་དེ་དག་གི་གཟུགས་ནི།",
    "གཞན་ཡང་དེ་དག་གི་ཁྱད་པར་ནི་རྣམ་པ་དུ་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པ་སྤངས་པའི་དེ་བཞིན་གཤེགས་པ་ལ་ངོ་མཚར་བའོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་རི་རབ་ཀྱི་རྩེ་མོ་ན་རྡོ་རྗེ་དང་།",
    "རང་རང་གི་ངོ་བོར་མཛད་ནས་དེ་རྣམས་ཀྱིས་འཇིག་རྟེན་གྱི་ཁམས་རབ་འབྱམ་རྒྱ་མཚོའི་སྤྲིན་ཐམས་ཅད་ནས་སྤྱན་དྲངས་ཏེ།",
    "ཀུན་དུ་ཉོན་མོངས་པས་མ་གོས་པས་བཟང་ཞིང་ངོ།",
    "དེ་ནས་རང་གི་ངོ་བོར་བྱས་ནས་སྤྱན་དྲངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ནས་བསྐལ་པ་བཟང་པོའི་མཐར་ཐུག་གི་བར་དུ་གནས་པ་རྣམས་ལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས།",
    "སྐལ་བ་བཟང་པོ་རྣམས་ནི་རང་གི་རིག་པས་གཞག་པར་བྱའོ།",
    "རང་རང་གི་གནས་ལ་གནས་ཏེ།་",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དམ་ཚིག་གིས་འགུགས་པའི་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྟོམས་པར་ཞུགས་ཤིང་མངོན་སུམ་དུ་མཛད་དེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་བེེགས་ཀྱུ་ནི་ཁྲོ་བོ་ཊཀྐིའོ།་།",
    "དེ་ཞེས་བྱ་བ་ནི་ཡང་གི་སྒྲ་གསལ་བར་བྱེད་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ལྕགས་ཀྱུ་ཞེས་བྱ་བ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་དང་།",
    "རང་གི་ཐུགས་ཀྱི་སེམས་དཔའི་རྡོ་རྗེ་ཡེ་ཤེས་ལས་ཁྲོ་བོ་འདོད་པའི་རྒྱལ་པོ་ངེས་པར་སྐྱེད་པར་མཛད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ས་སྟེང་གི་འཇིག་རྟེན་གསུམ་ཡིན་པས་འཇིག་རྟེན་གསུམ་མོ།",
    "ཚོགས་ནི་དེ་དག་གི་བདག་པོ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཞེས་བྱ་བ་ནི།",
    "ཕྱོགས་བཅུ་ན་གནས་པའི་འཇིག་རྟེན་པའི་འཁོར་ལོ་རི་རབ་རིའི་རྩེ་མོ་གང་ན་བ་དེར་བཀུག་པ་དེར་གཟིགས་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་༧བསྟན་པ་དང་།",
