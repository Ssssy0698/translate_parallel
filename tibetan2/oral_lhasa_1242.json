    "བདག་ནི་རྫས་སུ་འགྱུར་ཞིང་དེར་ལྟ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཕྱོགས་གཉིས་ཀ་ལ་ཡོད་པ་ཡིན་པས་གཉིས་ཀ་ལ་བརྗོད་པར་བྱའོ་ཞེས་པའོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཆད་པར་འགྱུར་བའི་ཉེས་པ་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི།",
    "འདི་ལ་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་བདག་ཏུ་སྨྲ་བ་དག་ལའོ།",
    "ཕྱོགས་གཉིས་ཀ་ལ་ཡང་ཞེས་བྱ་བ་ནི་ཕུང་པོ་བདག་ཏུ་སྨྲ་བ་དང་རྣམ་པར་ཤེས་པ་བདག་ཏུ་སྨྲ་བའི་ཕྱོགས་དག་ལའོ།",
    "འཇིག་རྟེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གཟུགས་ལ་སོགས་པ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ནི་གང་ཟག་མིང་ཙམ་ཡིན་ནོ་ཞེས་གསུངས་པས་གང་ཟག་རྫས་སུ་ཡོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་ཡན་ལག་ཚོགས་རྣམས་ལ་ཞེས་བྱ་བ་ནི་འཁོར་ལོ་ལ་སོགས་པ་རྣམས་ལའོ།",
    "རྫ་ས་སུ་ཡོད་པ་ལ་ཡང་སྐྱོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་རྫས་ཀྱི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་བདག་ཕུང་པོ་དང་རྣམ་པར་ཤེས་པ་ལས་ཐ་མི་དད་པར་ཁས་ལེན་ན་དེའི་ཚེ་བདག་རྫས་སུ་ཡོད་པའི་ཕྱིར་ན་དེ་ཡུལ་ཅན་འཇིག་ཚོགས་ལ་ལྟ་བ་ཕྱིན་ཅི་ལོག་ཉིད་དུ་མི་འགྱུར་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "པའི་འདུན་པའི་འདོད་ཆགས་སྤོང་བས་རྣམ་པར་ཤེས་པ་དེ་རྣམས་སྤང་བ་ཡིན་ནོ་ཞེས་བརྗོད་པ་དེ་བཞིན་དུ་འདིར་ཡང་གལ་ཏེ་འཇིག་ཚོགས་ལ་ལྟ་བ་རྫས་སུ་ཡོད་པའི་བདག་ལ་དམིགས་པ་ཡིན་ན་དེའི་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་ཤེས་པ་བཞིན་དུ་དེ་ཕྱིན་ཅི་ལོག་ཉིད་མ་ཡིན་པའི་ཕྱིར་དེ་ལ་དམིགས་པའི་འདུན་པའི་འདོད་ཆགས་ཁོ་ན་སྤོང་བར་འགྱུར་བ་ལས་དེ་ལྟར་ཡང་མ་ཡིན་ཏེ་ངོ་བོར་སྤོང་བར་འདོད་པས་སོ།",
    "ཡང་ཕུང་པོ་དང་རྣམ་པར་ཤེས་པ་བདག་ཏུ་སྨྲ་བའི་ཕྱོགས་ལ་སྐྱོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མྱ་ངན་འདས་ཚེ་ངེས་པར་བདག་ཆད་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་དུས་སུ་ཕུང་པོ་ལྔ་ཆད་པས་བདག་ཀྱང་ཆད་པར་འགྱུར་རོ།",
    "སྐྱེ་འཇིག་ཅེས་བྱ་བ་ནི་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་སྔོན་རོལ་དུ་ཕུང་པོ་རྣམས་སྐད་ཅིག་སོ་སོ་ལ་སྐྱེ་བ་དང་འཇིག་པ་ཡོད་པས་བདག་ལ་སྐྱེ་བ་དང་འཇིག་པ་ཡོད་པར་འགྱུར་རོ།",
    "བདག་ཞིག་པ་ཡིན་པའི་ཕྱིར་སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅེས་གསུངས་ཏེ།",
    "གལ་ཏེ་བདག་ཕུང་པོ་ལས་ཐ་མི་དད་པའི་ཕྱིར་སྐད་ཅིག་མ་ཡིན་ན་དེའི་ཚེ་ལས་ཀྱི་བྱེད་པ་པོ་ཞིག་པ་ལས་ཀྱང་རྟེན་མེད་པས་ཞིག་པའི་ཕྱིར་འབྲས་བུ་མེད་པར་འགྱུར་བའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མྱ་ངན་ལས་འདས་པའི་ཚེ་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྷག་མ་མེད་པར་མྱ་ངན་ལས་འདས་པའི་ཚེའོ།",
    "གལ་ཏེ་བདག་རྒྱུན་མ་ཆད་པར་ཁས་བླངས་ན་སྐྱོན་ཅི་ཡོད་སྙམ་ན་མ་ཡིན་ཏེ།",
    "ཕུང་པོ་རྣམས་ཀྱང་རྒྱུན་མི་འཆད་པར་འགྱུར་བས་སོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་བདག་ནི་ཕུང་པོའི་བདག་ཉིད་ཀྱིས་མ་ཡིན་ནོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "མྱ་ངན་ལས་འདས་པར་ཞུགས་པའི་སྔོན་རོལ་གྱི་གནས་སྐབས་ན་ཕུང་པོའི་རང་བཞིན་ཅན་གྱི་བདག་ལ་སྐྱོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མྱ་ངན་ལས་འདས་པར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེའི་ཕྱིར་ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཚེ་བདག་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བདག་རྟག་པ་ཡིན་ན་རྟག་པར་སྨྲ་བར་འགྱུར་ལ།",
    "དེ་ལ་ངེས་པར་ཉེ་བར་ལེན་པ་པོ་སྟེ།",
    "གལ་ཏེ་ཉེ་བར་ལེན་པ་བདག་ཉིད་དུ་འདོད་ན་དེའི་ཚེ་ཉེ་བར་ལེན་པ་ཁོ་ན་བདག་ཡིན་པར་འགྱུར་བས་དེས་ན་བྱེད་པ་པོ་དང་ལས་དག་གཅིག་ཏུ་འགྱུར་བས་གཅོད་པ་པོ་དང་།",
    "གཅད་པར་བྱ་བ་དང་།",
    "ཕུང་པོ་རྣམས་བདག་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ལས་བསྟན་བཅོས་ཀྱི་ཁུངས་གཉིས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཕུང་པོ་རྣམས་ལས་བདག་ཡིན་པར་འགྱུར་ན་ཕུང་པོ་རྣམས་ལ་སྐྱེ་བ་དང་འཇིག་པ་ཡོད་པས་བདག་ལ་ཡང་སྐྱེ་བ་དང་འཇིག་པ་ཡོད་པར་འགྱུར་རོ།",
    "སྐྱེ་བ་དང་འཇིག་པ་ཉིད་ཡོད་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་གྱིས་འབྲེལ་པ་སྒྲུབ་པར་བྱེད་པ་ནི།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྣམ་པར་སྨིན་པ་གཞན་གྱིས་ལོངས་སྤྱོད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མཆོད་སྦྱིན་གྱིས་རྣམ་པར་སྨིན་པ་ལོངས་སྤྱོད་པས་སོ།",
    "བྱས་པ་ཆུད་ཟོས་པ་དང་ཞེས་བྱ་བ་ནི་ལྷས་བྱིན་བྱས་པའི་ལས་ཀྱི་འབྲས་བུ་ཉམས་སུ་མི་མྱོང་བས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གལ་ཏེ་ད་ལྟར་བའི་བདག་འདི་སྔོན་གྱི་བདག་ལས་གཞན་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་སྔོན་གྱི་བདག་དེ་མེད་པར་ཡང་སྟེ་ཡོངས་སུ་དོར་ཞིང་དེ་ལ་མ་ལྟོས་པར་དེའི་རྒྱུ་ཅན་མ་ཡིན་པ་ཉིད་དུ་འགྱུར་རོ།",
    "སྔར་གྱི་དེ་ཉིད་མ་ཤི་བར་འདིར་སྐྱེ་བར་འགྱུར་བ་ལས་མིར་སྐྱེས་པའི་དུས་སུ་སྔོན་ལྷའི་བདག་ཉིད་དེ་བཞིན་དུ་གནས་པར་འགྱུར་བ་ནི་མི་སྲིད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་སྔོན་གྱི་བདག་སྤངས་པ་ཡིན་པར་གྱུར་ན་དེ་ལྟར་ན་སྔོན་གྱི་བདག་དེ་དེར་ཞིག་པས་འདིར་གཞན་སྐྱེ་བའི་ཕྱིར་སྔར་གྱི་བདག་ཆད་པར་འགྱུར་ལ།",
    "བདག་དེ་ཆད་པར་གྱུར་ན་ལས་ཀྱི་རྟེན་ཆད་པས་ལས་ཆད་པའི་ཕྱིར་དང་བྱེད་པ་པོ་ཡང་མེད་པས་ཆུད་ཟ་བ་ཁོ་ནར་འགྱུར་རོ།",
    "གཞན་གྲོལ་བ་ལ་སོགས་པར་འགྱུར་བ་བསྡུ་བར་བྱའོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་དུ་རྒྱུད་ཡོད་ན་སྐྱོན་མེད་ན་ཞེས་བྱ་བ་ནི་གང་དུ་དེ་ཁོ་ན་ཉིད་དོན་དམ་པར་རྒྱུད་ཡོད་པར་གྱུར་ན་བསྟན་མ་ཐག་པའི་ཉེས་པ་མེད་པར་འགྱུར་རོ།",
    "བྱམས་པས་ཉེར་སྦས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ལྷ་ལས་མི་གཞན་ཡིན་པར་འགྱུར་ན་དེའི་ཚེ་ཇི་ལྟར་ཤིང་ནིམ་པའི་རྒྱུད་ནི་ཤིང་ནིམ་པ་ཡིན་གྱི།",
    "གལ་ཏེ་ལྷ་མི་ལས་གཞན་ཡིན་ན་དེའི་ཚེ་རྒྱུད་གཅིག་ཏུ་འཇུག་པ་འཐད་པར་མི་འགྱུར་བ་ལས་ལྷ་དང་མི་རྒྱུད་གཅིག་ཏུ་རྟོགས་པ་ཡིན་ནོ་ཞེས་རྒྱུད་གཅིག་ཏུ་འཇུག་པ་ཡང་ཡོད་པ་ཡིན་ནོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕུང་པོ་དང་སེམས་དག་ལ་བདག་ཉིད་མེད་པའི་མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཕུང་པོ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཕུང་པོ་དང་སེམས་ལ་བདག་ཁས་ལེན་པ་ལ་སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལས་ཀྱང་སྟེ་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་སྐྱོན་ལས་ཀྱང་ངོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇིག་རྟེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཕུང་པོ་དང་སེམས་བདག་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་དེ་རྣམས་ཕུང་པོ་ལྷག་མ་མེད་པར་མྱ་ངན་ལས་འདས་པའི་དུས་སུ་ཆད་པར་འགྱུར་བས་བདག་ཀྱང་ཆད་པའི་ཕྱིར་མཐའ་དང་ལྡན་པ་ཉིད་དུ་འགྱུར་བ་ལས་ལུང་དང་འགལ་བའི་ཕྱིར་མཐའ་དང་ལྡན་པར་འདོད་པ་ཡང་མ་ཡིན་ནོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་རྣམས་ལུང་བསྟན་པར་བྱ་བ་མ་ཡིན་པས་ན་ལུང་དུ་མ་བསྟན་པའི་དངོས་པོ་ཞེས་བྱའོ།",
    "ལུང་དུ་མ་བསྟན་པའི་དངོས་པོ་བསྟན་པ་དེ་ལུང་གཞན་གྱི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དགེ་སློང་ཞིག་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་དེ་ལྟར་ལུང་དུ་མ་བསྟན་པའི་དངོས་པོ་བཅུ་བཞི་པར་ཡང་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་མཐའ་དང་ལྡན་ནོ་ཞེས་བྱ་བ་ནས་བཟུང་ནས་སྲོག་ཀྱང་གཞན་ལ་ལུས་ཀྱང་གཞན་ནོ་ཞེས་བྱ་བའི་བར་གྱི་ལྟ་བ་ཅན་ལ་ཡང་བསྐྲད་པའི་ལས་བྱའོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "འཇིག་རྟེན་གྱི་སྒྲས་ཕུང་པོ་རྣམས་འཛིན་ན་ཞེས་བྱ་བ་ནི་བདག་དང་ཕུང་པོ་དག་ཐ་མི་དད་པའི་ཕྱིར་ཕུང་པོ་ཁོ་ན་འཇིག་རྟེན་གྱི་སྒྲ་བརྗོད་ན་དེའི་ཚེ་འཇིག་རྟེན་མི་རྟག་གོ་ཞེས་བྱ་བ་ཡང་ལུང་དུ་བསྟན་པར་འགྱུར་ཏེ།",
    "ཕུང་པོ་རྣམས་སྐད་ཅིག་སོ་སོ་ལ་འཇིག་པས་བདག་ཀྱང་འཇིག་པར་འགྱུར་བས་ཇི་ལྟར་མི་རྟག་པ་ཉིད་དུ་ལུང་དུ་མ་བསྟན་པ་ཉིད་དུ་འགྱུར་ཞེས་པའོ།",
    "མྱ་ངན་ལས་འདས་པའི་འོག་རོལ་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཕུང་པོ་ལྷག་མ་མེད་པར་མྱ་ངན་ལས་འདས་པའི་ཕྱིས་ཀྱི་དུས་སུ་ཕུང་པོ་རྣམས་ལྷག་མ་མ་ལུས་པར་ལོག་པས་བདག་ཀྱང་ལོག་པའི་ཕྱིར་འཇིག་རྟེན་མཐའ་དང་ལྡན་པ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་ལུང་དུ་མ་བསྟན་པར་འགྱུར་ཞེས་པའོ།",
    "དེ་ལ་མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕུང་པོ་བདག་ཉིད་དུ་ཁས་ལེན་ན་ནི་འཇིག་རྟེན་མཐའ་དང་ལྡན་པར་འགྱུར་རོ་ཞེས་པ་ལ་སོགས་པའོ།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕུང་པོ་དང་བདག་ཐ་མི་དད་པས་བདག་མེད་པར་མཐོང་བའི་དུས་སུ་ཕུང་པོ་མེད་པར་འགྱུར་བས་སོ་ དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕུང་པོ་མེད་པར་མཐོང་བ་བདག་མེད་པར་མཐོང་བ་མ་ཡིན་གྱི།",
    "དེས་ན་བདག་མེད་པར་མཐོང་བའི་དུས་སུ་ཕུང་པོ་མེད་པར་མཐོང་བར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱོགས་ཉམས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཕུང་པོའམ་སེམས་བདག་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་གང་ཡིན་པ་དེ་ཉམས་པར་འགྱུར་བའོ།",
    "ཅི་སྟེ་རྣམ་པ་དེ་ལྟ་བུའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་སྐྱོན་མེད་དོ་ཞེས་བྱ་བ་ནི་ཕྱོགས་ཉམས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་སྐྱོན་གང་བརྗོད་པ་དེ་སྐྱོན་དུ་མི་འགྱུར་བའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་ཞེས་བྱ་བ་ནི་བདག་མེད་པར་མཐོང་བའི་གནས་སྐབས་སོ།",
    "མི་སྲིད་པའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིར་གལ་ཏེ་བདག་མེད་པར་མཐོང་བའི་གནས་སྐབས་སུ་བདག་མེད་པའི་སྒྲ་ཕུང་པོ་ལ་འཇུག་པ་ཡིན་ན་དེའི་ཚེ་བདག་མེད་པར་མཐོང་བའི་དུས་སུ་ཕུང་པོ་མེད་པར་མཐོང་བར་འགྱུར་བ་ལས།",
    "ཕུང་པོ་མེད་པར་མཐོང་བ་མ་ཡིན་ནོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཕུང་པོ་རྣམས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་དུ་ཡང་མི་འདོད་པར་བྱ་དགོས་སོ་ཞེས་བྱ་བ་ནི་ལས་དང་འབྲས་བུའི་འབྲེལ་པའི་དུས་སུའོ།",
    "དེ་འདིར་ཡང་འདོད་པར་བྱ་དགོས་སོ་ཞེས་བྱ་བ་ནི།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "པར་མི་འགྱུར་ལ།",
    "དེ་དཔེའི་སྒོ་ནས་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཟེ་འབྲུ་ལ་སོགས་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལྟར་དཔེར་བསྟན་ནས་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་འདིར་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱི་རོལ་པ་བཞིན་ཞེས་བྱ་བ་ནི་གསུངས་ཏེ།",
    "ཅི་སྟེ་ཁོ་བོ་ཅག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཕྱིར་སྟོན་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕུང་པོ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕུང་པོ་རྣམས་བདག་ཉིད་དུ་བསྟན་པ་མ་ཡིན་ནོ་ཞེས་པ་དེ་གང་ལས་རྟོགས་པར་འགྱུར་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཡིད་ཆེས་པར་འགྱུར་བ་ཞེས་བྱ་བ་ནི་ངེས་པར་འགྱུར་བའོ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་ལ་ལྟོས་ནས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཕྱིན་ཅི་མ་ལོག་པར་གསལ་བར་བྱ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཀུན་རྫོབ་ཏུ་ཡང་ཡོད་པ་མ་ཡིན་པའི་བདག་ལ་སོགས་པ་ཡོངས་སུ་མ་བཏགས་པས་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་ཕྱིན་ཅི་མ་ལོག་པར་གསལ་བར་འགྱུར་བའོ།",
    "ཕུང་པོ་རྣམས་ལ་བདག་ཉིད་དུ་སྟོན་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གང་ལས་ངེས་ཤེ་ནའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་དགོངས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ལས་གཟུགས་ལ་སོགས་པ་རྣམས་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཀུན་རྫོབ་ཏུ་ཐ་སྙད་དུ་གདགས་པར་བྱ་བ་བདག་ཡོད་པ་ཡིན་པས་ཅི་ལྟར་འགེགས་པར་བྱེད་ཅེ་ན།",
    "ལན་ནི་དེ་ཁོ་ན་ཉིད་སེམས་པའི་སྐབས་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དོན་དམ་པ་ལ་སྤྱོད་པའི་གནས་སྐབས་ཡིན་པས་བརྟེན་ནས་གདགས་པར་བྱ་བའི་བདག་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱའོ།",
    "བདག་བཀག་པའི་དགོས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཉེ་བར་ལེན་པ་པོ་མི་དམིགས་ན་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ཉེ་བར་ལེན་པར་བྱེད་པའི་བདག་མ་དམིགས་པས་སོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྒྲུབ་པའི་ཚུལ་དུ་ངེས་ཀྱང་ཞེས་བྱ་བ་ནི་ཕུང་པོ་རྣམས་བདག་ཉིད་དུ་བསྟན་པས་སྒྲུབ་པའི་ཚུལ་དུ་ངེས་ཀྱང་ངོ་ ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་ནི་སྟོན་པར་མི་ནུས་པ་ཅིའི་ཕྱིར་ཞེ་ནའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།"
  ]
}