    "ཁོ་བོའི་སེམས་ཀྱིས་ལྷང་ལྷང་གོ་བར་འདུག།",
    "འདུ་ཁང་ཁ་རུ་དཔེ་ཉོབ་མང་པོ་འདུག།",
    "གཉོམ་ཆུང་རང་སེམས་མི་འཚོ་བར།",
    "ལ་བཙས་འཇིགས་པར་འདུག་པ་དེ།",
    "ཆགས་སྡང་མཐོ་གནོན་བྱེད་འདུག་པས།",
    "ཐ་མལ་ཀུན་ལས་སྡུག་པར་འདུག་ཁྱད་པར་དུག་ལྔ་ཧྲག་པ་དང་།",
    "མི་མིན་འདྲེ་མིན་ཙམ་དུ་འདུག།",
    "མཐུ་དང་བྱད་ཅིག་ཡིན་འདུག་པས།",
    "ཅིས་ཀྱང་མི་འདུག་ཐག་ཆོད་ཡིན་ནམ་ཅི།",
    "གནུབས་ལོ་ཙཱ་ས་མཐར་འཁྱམས་འདུག་གྱིས།",
    "དུས་དེང་སང་མི་ལ་རྒྱག་འདུག་གྱིས།",
    "ལས་བག་ཆགས་འཐིབ་རྨོངས་སྒྲིབ་འདུག་གྱིས།",
    "དུས་དོ་ནུབ་ས་མཚམས་ཡིན་འདུག་གྱིས།",
    "སེམས་དུང་དུང་སྐྱོ་བ་ཆེ་འདུག་གྱིས།",
    "ཁས་ཉམས་དབྱངས་འོ་དོད་འབོད་འདུག་གྱིས།",
    "ཟླ་མེད་འཁྱམས་འདོད་བྱེད་འདུག་གྱིས།",
    "ད་ནི་རང་རང་འགྲོ་དོན་དུས་ལ་བབ།",
    "ལར་ཕུགས་སྡོད་ཉན་མ་འདོད་ཡིན་འདུག་པས།",
    "རང་རང་སྡིག་ལ་འབག་པ་མ་གཏོགས་པར།",
    "ང་ནི་སྲིན་པོའི་ཡུལ་ཡིན་འགྲོ་བར་ནུས།",
    "ང་ལ་འགྲོ་ཆས་སྒྲིགས་དང་ང་རང་འགྲོ།",
    "གཞན་སུ་འགྲོའོ་ཟེར་མཁན་མི་འདུག་པས།",
    "དེ་སྐབས་བརྡ་མེད་བྱིས་པའི་རྣམ་པར་འདུག།",
    "དེ་ནས་ལམ་དུ་ཆང་མ་ཞིག་འདུག་པས།",
    "བདག་ནི་སྔར་གྱི་གོས་ལག་དེ་རང་འདུག།",
    "ཚོགས་ཀྱི་འཁོར་ལོ་རྒྱ་ཆེར་བསྐོར་བར་འདུག།",
    "པོ་ཏི་གླེགས་བམ་དགུ་ཙམ་འདུག་པ་དེ།",
    "བསམ་ལས་འདས་པ་གྲངས་མེད་སྤུངས་ནས་འདུག།",
    "ཉི་མར་བལྟས་པས་མ་ཟད་ཙམ་ཞིག་འདུག།",
    "སྒྲོམ་བུ་ཁུར་ནས་འདུག་པ་མ་ལགས་པས།",
    "བྲོས་ནས་འགྲོ་མའི་ཡིན་ཡིན་འདྲ་འདུག་ཟེར།",
    "ཁ་བ་མི་ཡི་སྐེད་པར་སྙོབ་ཙམ་འདུག།",
    "གདོང་ལ་ལྟ་ཞིང་མཆོང་གྲབས་བྱེད་འདུག་པས།",
    "སྐྱེལ་བུ་བཟང་པོ་ཉམས་དགའ་འདུག་པ་དང་།",
    "ཉི་མ་འབུམ་གྱི་གཟི་བརྗིད་ལྡན་པར་འདུག།",
    "བདེ་བའི་ཆ་ཤས་ཚུལ་དུ་བཞུགས་ནས་འདུག།",
    "བརྡ་སྐད་ཉམས་དབྱངས་དིར་དིར་ལེན་པར་འདུག།",
    "ཕྱག་མཚན་གྲངས་མེད་བཀྲམ་ཏེ་བསྒྲིགས་ནས་འདུག།",
    "གྲིབ་ཀྱིས་རླན་པའི་གོས་ལོག་གྱོན་འདུག་ཟེར།",
    "སྔར་གྱི་མཚན་ཉིད་ཐམས་ཅད་མི་འདུག་པས།",
    "མཚོ་རྒྱལ་ཕྱག་ཏུ་དཀར་ཆས་གོས་འདུག་པས།",
    "དར་དམར་ཡུག་གོས་གསོལ་བ་ཞིག་འདུག་པར།",
    "ཁ་དོག་མ་ངེས་ཚུལ་དུ་འདུག་པ་ལས།",
    "ལྡེ་མིག་སྔོན་པོར་འདུག་པ་དེ་དག་བླངས།",
    "དྷེ་ཝ་དྷ་ར་སྔར་གྱི་ལུས་ལྟར་འདུག།",
    "ཤེལ་གྱི་ཕུག་པ་ཞིག་ཏུ་སླེབས་ནས་འདུག།",
    "བྲག་དཀར་སེངྒེ་གནམ་དུ་མཆོངས་འདྲ་འདུག།",
    "རིམ་པ་བདུན་གྱི་ཚུལ་དུ་དོད་ནས་འདུག།",
    "ཆང་འདི་ཁྱེད་རང་གསུམ་ལ་འདྲེན་ཡིན་པས།",
    "སྔར་གྱི་རྨི་ལམ་ལྟ་བུའི་ལུང་པ་འདུག།",
    "ཁ་བརྡ་གསལ་པོར་གང་དྲིས་ཟེར་མཁན་འདུག་ཁྱེད་ཀྱི་ལོ་ནི་ཅི་ཙམ་འགྲོ་དྲིས་པས།",
    "སྤྱང་ཀི་མང་པོས་ངུ་སྒྲ་འབྱིན་ནས་འདུག།",
    "དེ་ཚེ་ཟླ་སྐར་གསལ་པོ་འདུག་པའི་ངོགས།",
    "མི་རོ་རིང་པོ་ཁ་ལ་ཟ་བཞིན་འདུག།",
    "རྔམ་ཞིང་ངར་སྒྲ་འུར་འུར་འབྱིན་པ་འདུག།",
    "བྲག་རི་ཡོད་པའི་ལ་རྩེར་སླེབས་ནས་འདུག།",
    "དཀོར་མཛོད་ཁ་ཕྱེས་ཇི་བཞིན་ལྟ་བུར་འདུག།",
    "ཁ་ཆོད་རྣམས་ཀྱང་ལེགས་པར་བསྒྲིགས་ནས་འདུག།",
    "བྲག་རི་ཟ་ཟི་སྐྱི་ཡང་གཡའ་བར་འདུག།",
    "བྲག་རི་རྫུབ་པོའི་རོང་དུ་སླེབས་ཏེ་འདུག།",
    "ལམ་ཕྲན་གཉིས་འདུག་འགྲོ་ཚོད་མ་ཐིག་པས།",
    "སྔར་གྱི་ཞིང་སྐྱོང་མཇལ་སར་སླེབས་ནས་འདུག།",
    "ཉལ་སར་ཕྱིན་ནས་གོས་ལོག་འདུག་གམ་བལྟས།",
    "མི་ཡིས་མ་ཁུར་ཁྲིག་གེར་བསྡད་ནས་འདུག།",
    "ཅུང་ཟད་ཉལ་བས་གཉིད་ཀྱང་མི་འཁོར་འདུག།",
    "གཏེར་རྫས་བསྡད་ནས་ཨེ་འདུག་བལྟས་པའི་ཚེ།"
  ]
}