    "འདི་ལྟ་བུའི་གྲ་སྒྲིག་ཏང་ཡོན་ལ་མུ་མཐུད་དུ་གྲ་སྒྲིག་དུས་སྐབས་ཇེ་རིང་དུ་གཏོང་དགོས་དོན་མེད་པར།",
    "གྲ་སྒྲིག་ཏང་ཡོན་ལ་གྲ་སྒྲིག་དུས་སྐབས་སུ་སྲིད་འཛིན་སྒྲིག་ལམ་གྱི་ཆད་པ་བཅད་ཡོད་ན།",
    "ཏང་རྩ་འཛུགས་ཀྱིས་དེའི་གྲ་སྒྲིག་དུས་ཡུན་ལོངས་ནས་དངོས་གཞིར་བསྒྱུར་བར་གྲོས་བསྡུར་བྱེད་སྐབས།",
    "གལ་ཏེ་སྤྱིར་བཏང་རང་བཞིན་གྱི་ནོར་འཁྲུལ་བཟོས་ནས་སྲིད་འཛིན་སྒྲིག་ལམ་གྱི་ཆད་པ་ཅུང་ཡང་བ་དང་།",
    "གནས་ཚུལ་ལ་གཞིགས་ནས་གྲ་སྒྲིག་དུས་ཡུན་ཇེ་རིང་དུ་གཏོང་ཆོག་གལ་ཏེ་ནོར་འཁྲུལ་བཟོས་ཚུལ་ཅུང་ཆུང་བ་དང་།",
    "གྲ་སྒྲིག་ཏང་ཡོན་གྱི་གྲྭ་སྒྲིག་དུས་ཡུན་ལོངས་རྗེས།",
    "གྲ་སྒྲིག་ཏང་ཡོན་གྱི་གྲ་སྒྲིག་དུས་ཡུན་ལོངས་རྗེས།",
    "གྲ་སྒྲིག་ཏང་ཡོན་གྱི་གྲ་སྒྲིག་དུས་ཡུན་ལོངས་ན།",
    "གལ་ཏེ་གྲ་སྒྲིག་དུས་ཡུན་ལོངས་ཡོད་ན།",
    "གྲ་སྒྲིག་ཏང་ཡོན་གྱི་གྲ་སྒྲིག་དུས་ཚོད་དེ་གོང་རིམ་ཏང་ཨུས་ཁོ་ཏང་ནང་དུ་ཞུགས་པར་ཆོག་མཆན་བཀོད་པའི་ཉིན་ནས་རྩི་དགོས་པ་སྟེ།",
    "དེ་མིན་སྔར་ལས་ཁོ་རང་ཉིད་ཀྱི་བསམ་འཆར་ལ་མཉན་པར་སྟབས་བདེ་བ་དང་།",
    "ཞིང་གསུམ་བྱ་བ་ལེགས་པོར་སྒྲུབ་པའི་རང་རྟོགས་རང་བཞིན་དང་རང་འགུལ་རང་བཞིན་དངོས་གནས་ཇེ་དྲག་ཏུ་གཏོང་དགོས།",
    "མི་དང་རང་བྱུང་ཁམས་འཆམ་མཐུན་ངང་འཕེལ་རྒྱས་གཏོང་བ།",
    "མི་དམངས་ཀྱི་ཚོགས་པ་བཅས་ཀྱི་ཧུར་བརྩོན་ཆེ་ཞིང་རང་འགུལ་དང་།",
    "གུང་ཁྲན་རིང་ལུགས་ཀྱི་ཀུན་སྤྱོད་དར་སྤེལ་བཅས་བྱས་ནས་རྒྱལ་ཁབ་དང་མི་དམངས་ཀྱི་ཁེ་ཕན་སྲུང་སྐྱོང་བྱེད་ཆེད་དཀའ་ངལ་དང་ཉེན་ཁ་གང་ཞིག་འཕྲད་རུང་དཔའ་ངར་ཆེར་བསྐྱེད་ཀྱིས་ཕྱིར་ཐོན་ཏེ་དཔའ་མཛངས་རྟུལ་ཕོད་ཀྱིས་འཐབ་རྩོད་བྱེད་ཅིང་རང་སྲོག་བློས་གཏོང་བར་མི་སྐྲག་པ་བྱ་དགོས།",
    "གོང་རིམ་ཏང་རྩ་འཛུགས་ཀྱིས་དགོས་གལ་འདུག་བསམ་དུས།",
    "འགོ་ཁྲིད་པ་སུ་ཞིག་ཡིན་ནའང་རང་གཅིག་པུས་བརྒྱ་ཁ་གཅིག་གཅོད་དང་རང་ཉིད་རྩ་འཛུགས་ལས་བརྒལ་བ་བྱས་མི་ཆོག།",
    "སྐྱོན་བརྗོད་དང་རང་སྐྱོན་རང་བརྗོད་སྤེལ་བ།",
    "སྤྱོད་གཙང་རང་གཅུན་གྱི་ཆོད་དོན་དང་འགལ་བའི་བྱ་སྤྱོད།",
    "སྤྱོད་གཙང་རང་གཅུན་གྱི་ཆོད་དོན་དང་རྒྱབ་འགལ་བྱེད་པའི་བྱ་སྤྱོད་གཞན་དག་ཡོད་ཅིང་།",
    "ཏང་རྩ་འཛུགས་ཀྱི་སྔོན་ཐོན་རང་བཞིན་དང་དག་གཙང་རང་བཞིན་རྒྱུན་སྲུང་བྱས་ཏེ།",
    "གྲ་སྒྲིག་ཏང་ཡོན་གྱི་གྲ་སྒྲིག་དུས་ཡུན་ལོངས་རྗེས།",
    "ཐེངས་སྔོན་མའི་གྲ་སྒྲིག་དུས་ཡུན་ཇེ་འགྱང་དུ་གཏོང་ཆོག་པ་དང་།",
    "དུས་ལྟར་དངོས་གཞིར་བསྒྱུར་བ་དང་གྲ་སྒྲིག་དུས་ཡུན་ཇེ་འགྱང་དུ་གཏོང་བ།",
    "དེ་བཙལ་ན་མཚན་ཉིད་དང་རང་བཞིན་མེད་པའོ་།",
    "འདོད་ཆགས་སོགས་བསྔོའོ་ཕྱག་གཅིག་བྱས་ནས་གྲལ་ལ་འདུག་ཏིང་ཤག་དཀྲོལ་ལ།",
    "བདག་ཅག་དུས་ངན་པའི་གང་ཟག་བསམ་པ་དང་།",
    "ཤམ་ཐབས་ཅིནས་ཀྱར་ཟླུམ་པོར་འདུག་པར་འགྱུར་བདེ་ལྟར་བགོ་བར་བྱའོ་ཞེས་བྱབ་ལ།",
    "དེར་མ་བསྒོ་བར་སྟན་ལ་འདུག་པརམི་བྱའོ་ཞེས་བྱ་བ་ནི་ཁྱིམ་གྱི་ནང་རུའོ།",
    "ཐད་ཀརགདརས་ཏེ་འདུག་པརམི་བྱ་བ་བསྟན་ཏོ།",
    "འདིར་རྒན་རིམས་སུ་བྱ་བ་ནི་མ་ཡིན་གྱི་དེ་བས་ན་ཇི་ལྟར་རྒན་རིམས་གྱིས་འདུག་པ་ལབྷས་པའདི་མི་བསྐྱེདཔའོ།",
    "དེར་སྟན་ལ་འདུག་པ་དད་ཟས་བླད་བ་དང་།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་༣ དྲིས་པར་དེའི་ཁྱིམ་དུ་མི་དབོའོ་ཞེས་བྱབ་ལད་ཞེས་བྱབ་ནི་ཟས་དང་འབགས་པའི་ཆུའོ།",
    "གནས་ཁང་ན་འདུག་པ་འགྲོ་བ་དང་།",
    "གཞན་གྱིས་གསོལ་བར་མི་བྱའོ་ཞེས་བྱ་བན་མི་སྡུག་པཔོ་འདུགཉིས་མ་ལོད་པས་གནང་བ་འདི་དག་གསོལ་བར་མི་བྱ་འོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "དེའི་ཕྱིར་ཁྱིམ་གཞན་དུམ་བསྒོ་བར་སྟན་ལ་འདུག་པ་ལའོ་ཞེས་བྱབ་སྨོས་ཏེ།",
    "འདུག་པ་ལ་ནི་ཤིན་ཏུ་རིང་བོར་རྗེས་སུའགྲོ་བའི་ཕྱིར་གནོན་དུ་གྱུར་པཉིད་དུ་རིག་པར་བྱའོ།",
    "འདུག་པས་དེ་འགྲེལ་བས་ཧ་ཅང་ཡུན་རིང་དུའདའ་བར་བྱེངན་སྟན་ལ་འདུག་ཏུ་གཞུག་གོ་ཞེས་བྱ་བ་ལ།",
    "འདུག་པས་ཞེས་བྱ་བ་ནི་སྟན་ལ་འདུག་རྔུ་གཞུག་གོ་ཞེས་བྱ་བ་དང་འབྲེལ་ལོ།",
    "གནས་སྐབས་ཇིལྟ་བུས་དེ་སྟན་ལ་འདུག་ཏུ་གཞུག་ཅེ་ན།",
    "དེའི་ཕྱིར་འདུག་པས་ཞེས་བྱ་བ་སྨོས་སོ།",
    "མི་བྱེད་ན་འདུག་པའི་ཕྱིར་ཞུས་ཏེ་དེ་ལ་འདུག་པར་བྱའོ།",
    "མི་བྱེད་ནཞེས་བྱ་བ་ནི་དགེ་སློང་མ་སྟན་ལ་འདུག་པར་མ་བའི་བྱས་པ་ལ།",
    "འདིལ་དེས་འདུག་པ་ལ་ངེས་པར་སྦྱར་བཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་གནས་པར་འདུག་པ་ལ་སོགས་པས་སྦྱོར་བར་མི་བྱེད་པའོ།",
    "མ་གནང་བར་སྟན་ལའདུག་པ་དང་།",
    "ཕྱིས་གནོན་བྱས་ནས་འདུག་པ་དང་།",
    "དེ་དག་ལས་བཟའ་བ་དང་བཅའ་བཉིད་དང་འདུག་པ་དང་།",
    "དགེ་སློང་མ་དང་དབེན་པ་ནའདུག་པ་དང་།",
    "གཉིས་པཉལ་བོ་བྱེདཔར་ཤོམ་པའི་ཁྱིམ་ནའདུག་པ་དང་།",
    "དེ་རྣམས་དང་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ནའདུག་པ་དང་འགྲེང་བལ་ཡངཉེས་བྱས་སོ།",
    "དབེན་པན་འདུག་པ་དང་འགྲེང་བ་དང་།",
    "འདུག་པའི་ཆེདདུ་སའི་སྟེགས་བུ་དག་དང་ཁྲིའུ་ཡང་ཞེས་བྱ་བ་ནི་བྱའོ་ཞེས་བྱ་བ་འདི་གཉིས་ཀལ་སྦྱར་རོ།",
    "ནམཁའ་ལ་འདུག་པར་མི་བྱའོཞེས་བྱབ་ནི།",
    "ནམཁའ་ལ་འདུག་བའམ།",
