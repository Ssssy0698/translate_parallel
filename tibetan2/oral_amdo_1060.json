    "འདིར་བཅུག་སུམ་པ་ཐུགས་ཀྱི་དབྱེ་བ་དང་མུན་པའི་ཡོནཏན་གྱི་དབྱེ་བ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་བཅུ་བཞི་པ་སྟེ་ཉིན་ཞག་གཉིས་པལག་སུང་གི་དབྱེ་བ་དང་རྡུལ་གྱི་ཡོན་ཏན་གྱི་དབྱེ་བས་སོ།",
    "ཞལ་བཞི་པོ་དེ་རྣམས་ཀྱི་རང་བཞིན་གྱིས་བྱང་དངདང་ཤར་དང་ནུབ་ཀྱི་འོང་འའི་རྩིགཱ་རྣམས་སུ་གནས་པའི་རྣལ་འབྱོར་མསུམ་ཅུ་རྩ་དྲུག་པོ་དེ་རྣམས་ཀྱི་རང་རང་གི་གནས་ཀྱི་མིང་གི་ཡི་གེ་དང་པོ་ཡོངས་སུགྱུར་པལས་རོའི་གདནརྣམས་སུ་འགྱུར་རོ།",
    "ཕྱི་རོལ་དུ་གསུང་གི་འཁོད་པའི་ཤར་གྱི་རྩིབས་ལ་ཡིག་ཡོངས་གྱུར་པ་ལ་ས་ས་སྲུངས་མའི་རོའི་གདན་ནེ།",
    "ཞེས་པ་ཞིང་དང་ཉེ་བའི་ཞིང་གི་ལྷ་མོ་རྣམས་ཀྱི་གདནགྱི་ངེས་པའོ།",
    "ཤིན་ཏུ་བཟང་མོའི་རོའི་གདནནོ།",
    "ཁེ་དང་དུ་བ་གསུང་གི་འཁོར་ལེའདུན་པ་དང་ཉེ་བའི་འདུན་པའི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་གདན་གྱི་ངེས་པའི།",
    "ཕྱི་རོལ་ཏུལྕོའི་རྩིབས་ལགི་ཡིག་ཡོངས་སུ་གྱུར་པ་ལས་དུམ་སྐྱེསམའི་རོའི་གདན་ནོ།",
    "ཕྱི་རོལ་དུ་བྱང་གི་རྩིབས་སུ་ཡིག་གས།་",
    "འགུས་ཆེན་མོའི་རོའི་གདན་ནོ།",
    "ཞེས་པ་སྐུའི་འཁེལ་ལེའི་དུར་ཁྲོད་དང་ཉེབའི་དུར་ཁྲོད་ཀྱི་ལྷ་མོརྣམས་གདན་གྱི་དས་པའོ།",
    "ལྷ་དང་ལྷ་མོའི་ཚོགས་ཀྱིས་མཉེས་པར་བྱེད་པ་དང་།",
    "མཆོག་གི་རྡོ་རྗེ་སེམས་དཔའ་དག་ནི་གཤེགས་སུགསོལ།",
    "གི་ཀྱི་བཛྲ་ཧེ་ཧེ་རུ་རུ་ཀཾ་ཧུའུ་པཎྜི་ཀི་ནི་ཛཱལས་བརིསཱཏཱ།",
    "ས་བརྐོས་པ་དེར་གཞག་པར་བྱ་ཞིངདུར་ཁྲོད་ཀྱི་ཐལ་བས་བཀང་ནས་སྟེང་དུ་རལ་གྲི་ཆེན་པོ་བཞག་པརབྱའོ།",
    "ཨོཾ་བཛྲ་རེ་ཙ་ནཱི་ཡེ་ཧཱ།",
    "དེ་ནས་བཏུང་བའི་དོན་དུ་རང་གི་རིགས།",
    "བྱངཆུབཀྱི་སེམས་མྱུད་བསངས་པའི་བཟའ་བ་དང་བཏུང་བས་དཔའ་བོའི་སྟོན་མོར་བརྗོད་པང་༢བྱའོ།",
    "དེ་བཞིན་དུ་དགེ་ཚུལ་དག་གི་ནང་ཏུའོ།",
    "དུར་མིག་གི་རྟག་པ་སུན་འབྱིན་བའི་ཕྱིར་རོ།",
    "གང་ཞིག་ཁྱིམཔ་བསྟི་གནས་ཁྱོད།",
    "དབའ་བོའི་སྟོན་མོ།",
    "ཚོགས་ཀྱི་བདག་མོའི་གཡོན་དུ་སྦྱིན་པའི་བདག་པོས་ཐབས་བཞག་པར་བྱའོ།",
    "དྲེསན་དཔའ་ཀློའི་སྟོན་མོ་ལ་གདོན་མི་ཟ་བར་སྦྱིན་པའི་བདག་པོས་ཐབས་དང་དབུལ་བརབྱའོ།",
    "དེ་ནས་ཚོགས་ཀྱི་གཙོ་བོ་ལ་སོགས་པའི་གཡོན་སྐོར་གྱིས་བཟའ་བསྟེན་མོ་དབུལ་ཞིང་།",
    "ཡིགགིས་སྦྱང་བར་བྱའོ།",
    "གཡོན་པའི་མིང་མེད་ཀྱི་རྩེ་མོས།",
    "འདི་ལ་རེ་བའི་གཏེར་གྱི་དངོས་གྲུབ་བསྒྲུབ་པར་བྱའོ།",
    "མིའི་སོའི་བགྲང་འཕྲེང་གི་རྩ་བའི་སྔགཟླ་བ་དེ་ལ་འབུམ་ཕྲག་གསུམ་ཟླས་པརབྱ་ཞིར།",
    "དེ་ལྟ་ལོག་ཅིག་གིས་འབུམབྲག་སུམ་ཅུ་རྩ་དྲུག་བཟླས་པར་བྱ་ཞིང་།",
    "གསུངས་པའི་བགྲང་ཕྲེང་གིས་ས་འབུམཕྲག་དག་བཟླས་པར་བྱ་ཞིང་སྦྱིན་སྲེག་ཁྲི་ཕྲག་དགུ་བྱས་ཏེ་ཟླ་བ་དང་པོ་མིའི་རུས་པའི་བགྲད་བྱེད་དང་།",
    "གསུམ་པ་ལ་བོང་བུའི་རུས་པའི་བགྲང་ཕྲེང་གིས་བཟླས་པ་བྱ་ཞིང་།",
    "འོ་ན་ཡ་ཧོབྷག་ཝཱན་བཛྲ་རཱུ་པི་ཎི་ཡི་ཧུཏྟཾཕཊ་ཙེད་པ་བྱདགི་ཞལ་གྱི་སྔགས།",
    "མིའི་ལོའི་བགྲང་ཕྲེང་གི་པ་བཟླས།",
    "ཡོད་མོ་བྷ་ག་ཝ་ཏེ་ཝཱི་རེ་ཤཱ་ས་བཛྲ།",
    "དུམ་སྐྱེས་མལ་བརྗོད་པའི་བགྲང་ཕྲེང་གིས་ཕྱེད་དང་བཅས་པའི་འབུམ་ཕྲག་བཞིས་སྔགས་བཟླས་ཤིང་པར་དུ་འདས་པ་སྦྱིན་སྲེག་བྱ་སྟེ།",
    "ཅན་མ་ལ་བརྗོད་པའི་བགྲང་ཕྲེང་གི་ཚོགས།",
    "གཤིན་རྗེ་ཕོ་ཉ་མོ་ལ་མཆོད་ཡོན་དུལནས།",
    "རྡོ་རྗེ་མཁའ་འགྲོམལ་བརྗོད་པའི་བགྲང་ཕྲེང་དང་ཚོགས་ཕྱོགས་ལ་གསུམ་ལ་ཕྱེད་དང་བཅས་པའི་འབུམ་ཕྲག་བཞི་ལྔགས།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་བརྗེད་པའི་བགྲང་ཕྲེང་གིས་སོ་སོར་སྔགས་ཁྲི་ཁྲག་ལྔ་བ་པ་ནི།",
    "ལཱམལ་བརྗོད་པའི་བགྲང་ཕྲེང་གིས་སྔར་བཞིན་ཕྱོགས་གཅིག་གིས་། འབུམ་ཕྲག་ཕྱེད་དང་བཅས་པ་བཟླས་ཤིང་སྦྱིན་སྲེག་ཁྲི་ཕྲག་བྱེད་དང་།",
    "མལབརྗོད་པའི་བགྲང་ཕྲེང་གིས་ཚེས་བཅོ་ལྔ་རྣམས་ཀྱིས་བྱེད་དང་བཅས་པའི་འབུམ་ཕྲག་བཟླསཤིང་ཕྱེད་དང་བཅས་པའི་ཁྲིཕྲག་སྦྱིན་སྲེག་བྱའོ།",
    "གཟུགས་ཅནམལ་བརྗོད་པའི་བགྲང་ཕྲེང་གིས་ཉིན་ཞག་བཅོལ་རྣམས་ཀྱིས་འབུམ་ཕྲག་བྱེདདང་བཅས་པ་བཟླས་ཤིང་ཁྲི་ཕྲག་ཕྱེད་དང་བཅས་པ་བྱའོ།",
    "དཔའ་བོའི་གླབན་མལམཆོད་ཡོན་ཡུལ་ནས་གཟུགས་ཅན་མལ་བརྗོད་པའི་བགྲང་ཕྲེང་གི་ས་ཕྱོགས་གཅིག་ལ་ཕྱེད་དང་བཅས་པའི་འབུམཕྲག་བཟླས་ཤིང་ཁྲི་ཕྲག་ཕྱེད་དང་བཅས་པའི་སྦྱིན་སྲེག་བྱ་སྟེ།",
    "སྦྱིན་སྲེག་གི་སྔགས་ཐམས་ཅད་དུ།",
    "འཆད་པར་འགྱུར་པའི་སྦྱིན་སྲེག་གི་རྫས་རྣམསཀྱི་ནུག།",
    "དམན་པ་དང་འབྲིང་དང་མཆོག་གི་དངོས་གྲུབ་སྟེར་བ་བརྗོད་པར་བྱ་སྟེ།",
    "ཕོ་ཉ་ཞེས་པ་ལ་སོགས་པསལྷན་ཅིག་སྐྱེ་བ་ལ་གྲུབ་པ་བརྩོན་འགྲུས་ཆེན་མོལ་སོགས་པ་ཉི་ཤུ་རྩ་བཞི་དང་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་གྲུབ་པ་དཔའ་བོ་རྣམས་སོ།",
    "ས་འོག་གི་དངོས་གྲུབ་སྩོལ་བའི་ཕྱིར་རོ།",
