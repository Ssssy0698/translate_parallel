    "འདིར་ནི་ཁྱོད་ལ་རྗེས་ཞི་བགྱི།",
    "གལ་ཏེ་བུད་མེད་རྣམས་ཀྱི་ལུས།",
    "བདེན་མིན་གྱིས་ཀྱང་བུད་མེད་ཀྱི།",
    "དེ་ལ་བདག་གིས་༢སྲེད་པ་མེད།",
    "བུད་མེད་སྐྱེས་པ་ཕན་ཚུན་དུ།",
    "ཨེ་མ་ཤིན་ཏུ་བརྟན་ལ་སྟོབས་ལྡན་ཁྱོད་ཀྱི་སེམས།",
    "སྐྱེ་བོ་རྣམས་ཀྱི་མིག་གི་འགྲོ་བྱ་གསལ་བྱེད་ཀྱི།",
    "རང་གི་སེམས་ལ་ཡིད་དཀྲུགས་༢འདོད་པ་རྣམས་སྨད་ན་ས།",
    "ཡིད་ལ་རེ་ཉམས་བུད་མེད་རྣམས་ནི་གྲོང་དུ་ཐལ།",
    "དེ་ནས་སྔགས་མང་རྣམ་པ་སྣ་ཚོགས་ལམ་རྣམས་དག་གིས་༥ཐང་ཆད་བློན་པོར་བཅས།",
    "དེས་ནི་འདོད་པ་ལས་གཞན་སྲས་ཀྱི་བློ་ཡི་ངེས་པ་གཟིགས་མ་གྱུར།",
    "བུད་མེད་ཀྱིས་གེགས་བྱས་པའི་ལེའུ་སྟེ་བཞི་པའོ།",
    "དེ་ནས་རེས་འགའ་ཞིག་ན་བླན་པོའི་བུ་མཁས་ཤིང་།",
    "ནོར་འཛིན་ས་ལ་ཞིང་དག་རྨོ་བ་གཟིགས་པར་གྱུར།",
    "ཤི་གྱུར་འབུ་སྲིན་སྲོག་ཆགས་ཕྲ་མོས་ཁྱབ་པ་སྟེ།",
    "རྣམ་པ་༤དེ་འདྲའི་ས་དེ་ཡང་དག་མངོན་གཟིགས་ནས།",
    "ཞིང་དག་རྨོ་བའི་སྐྱེས་བུ་རྣམས་ནི་རྣམ་གཟིགས་པ།",
    "སྐྱེ་བོ་དག་གི་སྐྱེ་དང་འགོད་པ་ནམ་སེམས་ཞིང་༧།",
    "འདིར་ནི་གལ་ཏེ་བདག་གིས་རང་དང་མཚུངས་གྱུར་པ།",
    "སྟོབས་དང་ལང་ཚོ་དང་ནི་སྲོག་ལ་རབ་ཞུགས་པའི།",
    "བདག་ཏུ་གྱུར་པའི་རྒྱགས་པ་སྐད་ཅིག་གིས་མེད་གྱུར།",
    "རང་གི་སྐྱེ་བོ་དང་ནི་སྐྱེ་བོར་མཉམ་པའི་བློ།",
    "ཤིང་གི་རྩ་བ་འགའ་ཞིག་ཏུ་ནི་གནས་པ་ཡི།",
    "དོན་དམ་ཕྱིར་ནི་ཇི་ལྟར་ཉེར་ལྡན་སློང་མོ་པ།",
    "དེ་ནི་ཡང་དག་མཐོང་ནས་ཤཱཀྱའི་བུ་མོ་ཞིག།",
    "མོ་དེ་བདེ་མ་མྱ་ངན་འདས་མ་ཞེས་སྨྲས་ས་སོ།",
    "དེ་ནས་གསེར་གྱི་རི་བོའི་རྩེ་མོའི་སྐུ་མང་འ་ཞིང་།",
    "གླང་ཆེན་ཕྱག་ད་ང་འབྲུག་གི་སྒྲ་དབྱངས་ཁྱུ་མཆོག་སྤྱན།",
    "རབ་ཏུ་བཏུ་ད་ནས་ཐལ་མོ་དང་བཅས་སྨྲས་གྱུར་པ།",
    "ཀ་མ་ལ་དང་རབ་མཚུང་ས་ཐལ་མོ་དག་བཟུང་ནས།",
    "མཚོན་གྱུར་ཁྱོད་ལ་ཕུན་སུམ་ཚོགས་པ་གཏད་ནས་ནི།",
    "དེ་ཕྱིར་ཁྱོད་ཀྱིས་ནན་ཏན་ངེས་པ་འདི་དོར་ལ།",
    "རྒྱལ་པོ་གལ་ཏེ་བདག་གི་ཁས་ལེན་བཞི་རྣམས་ས་སུ།",
    "བདག་གི་སྲོག་ནི་འཆི་བ་ཉིད་དུ་མི་འགྱུར་ཞིང་།",
    "ཤིན་ཏུ་ཡིད་ལ་རེ་བ་འཕྱ་ཞིང་ཤ་ཐང་འཆད།",
    "གང་གི་ཚེ་ན་འགྲོ་བ་ངེས་པར་འབྲལ་བ་སྟེ།",
    "རང་གི་དོན་མ་བྱས་ཤིང་ཚིམ་པ་མ་ཡིན་ཉིད།",
    "བསྟན་པ་མིན་པའི་མིག་ལྡན་བུད་མེད་རྣམས་ཀྱིས་ནི།",
    "ངག་དང་རེག་བྱ་དང་ནི་ལུས་དང་ཡོན་ཏན་གྱིས།",
    "ཐོས་བྱེད་ལུས་དང་ལྟ་བྱེད་བདག་གི་དངོས་རྣམས་ཕྲོགས་༢།",
    "ཉིན་མོ་རྣམ་པར་ཐལ་ཚེ་དེ་ནས་ཁང་བཟངས་ལ།",
    "ཟླ་བ་ལྟར་དཀར་གངས་ད་ང་ལྡན་པའི་རྩེ་མོ་ན།",
    "དེ་ལ་མཚན་མོར་སིལ་སྙན་རྣམས་ཀྱིས་༥ཉེ་བར་གནས།",
    "འདུས་པའི་ལག་པ་དག་གིས་ད་གའ་བ་བཞིན་དུ་ནི།",
    "ཉལ་བར་གྱུར་པའི་ལུས་ཀྱི་མཆོད་སྡོང་རྣམས་༧འཁྱོག་པ།",
    "འགྲམ་པའི་ལོགས་ལ་ནོར་བུའི་རྣ་ལུང་གིས་དམུགས་པ།",
    "འདབ་༩མ་བརྒྱ་པའི་སྡོང་བུའི་ཕྱེད་ནི་འཁྱོག་༡པ་ལ།",
    "རྣ་བའི་ཤོག་དྲིལ་ཀུན་ནས་འཁྲུགས་པའི་གདོང་གིས་ནི།",
    "བུད་མེད་ཁ་ཅིག་གྲོགས་མོ་བཞིན་དུ་གཉིད་ལོག་ག་གོ།",
    "ལང་ཚོ་མ་གཞན་ལག་པའི་དཔུང་པའི་ཡུལ་ལས་ནི།",
    "གཞན་མ་དག་ནི་ཆང་གིས་འཁྲུལ་པར་གྱུར་པ་ཉིད།",
    "དེ་ལྟར་ཉལ་བའི་ལང་ཚོ་ལྡན་མ་དེ་མཐོང་ན་ས་། ལུས་ཀྱི་༡ཡོན་ཏན་ལྡན་ཞིང་སྨྲ་བའི་༢ཡིད་འོང་ཡང་།",
    "བུད་མེད་རྣམས་ཀྱི་༤ཡུལ་ལ་སྐྱེས་པ་ཆགས་པར་འགྲོ།",
    "གལ་ཏེ་སྐྱེས་པས་བུད་མེད་རྣམས་ཀྱི་རང་བཞིན་ན་ནི།",
    "མཚན་མོར་ཕྱི་རུ་འགྲོ་འདོད་ཡང་དག་སྐྱེས་པར་གྱུར།",
    "ལྷ་རྣམས་དག་གིས་ཁང་པའི་སྒོ་ནི་ཕྱེ་བར་གྱུར།",
    "དེ་ནས་ལང་ཚོ་ལྡན་མ་ཉལ་བ་དེ་རྣམས་ནི།",
    "བདུད་རྩི་ཐོབ་ཕྱིར་འདི་ལས་དི་རིང་བདག་སྐོམ་༧མ་མོ།",
    "ལང་ཚོ་མ་རྣམས་བདག་གི་༩གདོང་དུ་ཇི་བཞིན་ཉལ།",
    "དེ་ནས་གདོང་གི་གསེར་གྱི་སྲབ་ཀྱིས་གང་བ་སྟེ།",
    "རྒྱབ་ན་ཡང་བའི་སྟན་གཡོགས་དག་གིས་ཉེ་བར་གཡོགས།",
    "ཞི་ཞིང་ཀ་མ་ལ་དང་མཚུངས་པའི་ཕྱག་གིས་ཀྱང་།",
    "ཇི་ལྟར་བདག་གི་ནང་གི་བདག་ཉིད་ཀྱིས་རྟོགས་པ།",
    "མཚན་མོར་གཏུམ་པ་དམ་པའི་རྟ་དེས་ཡོངས་བཀག་ཅིང་།",
    "ཚིམ་གྱུར་ལག་པའི་རྩེ་མོས་རྨིག་པ་རྣམས་༢བཟུང་ང་ངོ།",
    "ལྕི་མོའི་སྒོ་གཏན་སྒོ་གླེགས་ཡང་དག་བཅད་༤པ་གང་།",
    "བདེ་བར་གཉིས་འཐུང་༥གིས་ཀྱང་ཕྱེད་པ་མ་ཡིན་པ།",
    "ནན་ཏན་ཕ་རོལ་སོང་བ་དེ་ལ་བསྔགས་པ་བྱས།",
    "མཚན་མོའི་མུན་པའི་ལམ་ནི་རབ་ཏུ་གསལ་༢བར་བྱས།",
    "མི་མཆོག་དེས་ནི་གཟིགས་པར་གྱུར།",
    "དགའ་ཞིང་མིག་གིས་འཁྲུ་བ་བ་བཞིན།",
    "ཁྱོད་འདྲ་ས་སྟེངས་རྙེད་པར་ད་ཀའ།",
    "ཁྱོད་ཀྱི་འདིས་ནི་བདག་ད་གའོ།",
    "མཐུན་ཕྱོགས་སྐྱེ་བོ་གང་གིས་མིན།",
    "ཟློག་ལ་རང་གི་སྐྱེ་བོ་ཡང་།",
    "བདག་གི་དགའ་ཆེན་ལེགས་བྱས་ཏེ།",
    "དེ་ཕྱིར་ཐར་ཕྱིར་བདག་གི་བློ།",
    "སླར་ཡང་རང་གི་སྐྱེ་བོ་ལས།",
    "ནགས་སུ་སོང་བ་ཡིན་ཞེ་ན།",
    "ཞི་བ་ཁྱོད་ཀྱིས་དེ་ལ་སོགས།",
    "ཐལ་མོ་སྦྱར་ཏེ་ལན་གསོལ་བ།",
    "གཞལ་མེད་ཁང་གི་མལ་༦འོས་པའི།",
