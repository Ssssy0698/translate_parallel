    "ངན་ན་ཞག་འགའ་རེ་ཟླ་བ་ཕྱེད་ཞག་ཉི་ཤུ་ཙམ་ཞིག་ཡང་ཆེན་པོ་ཡིན་ན་ལྗིད་པས་མི་ཆེ་ཆུང་འདྲ་སྟེ་ཟླ་བ་གསུམ་ཚུན་ཆད་ན་ཁོ་བཏང་བས།",
    "ཞིང་དེའི་ཆེད་དུ་བདག་གིས་འདི་བསྒྲུབ་པར་བྱ་སྙམ་དུ་བསམས་ལ་དགེ་སྦྱོར་བྱ།",
    "ཕལ་ཆེར་དེའི་ལོང་མེད་པར་རྐང་མཐིལ་སྐྱ་ལྷག་གིས་འགྲོ་འདུག་ལ་འཐུག་པར་འདུག་སྟེ།",
    "དེས་མ་ཚུགས་པར་སྒྲུབ་པ་བྱས་ན་ཟླ་བ་དྲུག་ནས་ས་ནོན་པ་བྱ་བ་ཡིན་པས་ཁོང་རང་གི་སྟོངས་གྲོགས་བྱེད།",
    "ཐ་མ་ལ་བསེན་མོ་གསུངས།",
    "དཔའ་བོ་དང་མཁའ་འགྲོ་མ་དང་ལཱ་མ་དང་དུམ་སྐྱེས་མ་སོགས་རིགས་ཀྱི་ཡུམ་ལྔས་ཕག་མོའི་མཐར་ཐུག་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་དངོས་གྲུབ་འདི་ལྟ་བུ་འདོད་དམ་ཞེས་དད་དད་བྱེད་པ་ཡིན་གསུངས།",
    "དེ་ནས་ཡང་ཕྱོགས་གཅིག་ཏུ་སོང་བ་དང་ཐལ་མོ་སྦྱར་ནས་མོས་གུས་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ཡང་དགོད་རེ་བྲོ་འོང་གིས་མཚན་མ་ཅན་གྱི་རྫོགས་པ་བཅུད་ལེན་དང་།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཡང་རྗེ་ཕག་མོ་གྲུ་པ་སྤང་ཆུང་ན་བཞུགས་པ་ལ་སྔགས་པ་ཞིག་གིས་རྒྱས་པ་ཕུལ་བ་ལ།",
    "རྔ་མོ་རྔེའུ་གཏོར་བ་བཞིན་དུ་དབུགས་རྔམ་པ་སྟོད་དུ་འཚངས་པ།",
    "ཡང་འདི་རྣམས་གསུང་བའི་གོང་དུ་རྗེ་བཙུན་ཐུགས་རྗེ་ཆེན་པོ་གཅིག་གི་ཐུགས་ཀར་རང་དང་དཔོན་གཡོག་ཐམས་ཅད་བསྒོམ།",
    "བདུད་དང་མི་མ་ཡིན་གྱིས་མི་མཐོང་བ་ཡིན་ཁོང་གིས་མཐོང་ན་བར་ཆོད་བྱེད་གསུངས།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དམ་ཚིག་ཉམས་ཆགས་དང་ལས་ཉོན་མོངས་པ་ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་འདག་པ་ཡིན་པས།",
    "༥༧༥ ། དགེ་སྦྱོར་གང་བྱས་ལ་ཉོན་མོངས་པ་གསུམ་དང་འདྲེར་མི་རུང་བར་གདམས་པ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་ཡང་རང་གིས་ཅང་མ་བྱས་སྙམ་པ་མི་དགོས་འདས་པའི་དུས་ན་བྱས་པས།",
    "ཞེས་པས་ཉེ་འབྲེལ་གྱིས་ཅི་བྱས་ཀྱི་རྗེས་སུ་འབྲང་ཞིང་ལད་མོ་བྱེད་ཡིད་རང་སྟེ།",
    "ཁོང་རང་གི་ནོར་ཅི་ཡོད་གསེར་དངུལ་དུ་བྱས་ནས་བསྐྱེད་མོས་ཚལ་ཞིག་ཏུ་བྱས་ནས་ཤི་བ་དང་།",
    "འདུ་བྱས་མི་རྟག་སྲིད་པར་སོང་བ་སྡུག་བསྔལ་བ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པས་དུས་གཅིག་ན།",
    "སྒྲོལ་མའི་ཡི་གེ་བཅུ་པ་ཨོཾ་ཏཱ་རེ་ཏུ་ཏ་ཏཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "ཁ་སྣ་གཉིས་ཀ་ནས་འཐུངས་པས་ཉིན་ཞག་ཕྲུགས་གཅིག་གི་དུག་དང་རིམས་དང་།",
    "ཡང་གུ་གུལ་ལ་ཡི་དམ་མ་མོ་ཁྲོ་བའི་སྔགས་སམ་ཡི་གེ་བདུན་པ་བདུན་ནམ་ཉི་ཤུ་རྩ་གཅིག་བཟླས་པའི་སྤོས་ཀྱི་རྟེན་འདྲ་ཅན་ལེན་པའི་དུས་སུ་ཕུལ་བས་བགེགས་དཔག་ཚད་བྱེ་བར་འབྲོས་གསུངས།",
    "ཡང་ཏིང་ངེ་འཛིན་གྱི་བསྲུང་བ་རྗེ་ཕག་མོ་གྲུ་པ་རང་ཡི་དམ་དུ་གསལ་བའི་བུ་ག་དགུར་ཧཱུྃ་དགུ་བསམས་ནས་དེ་ལས་མེ་འབར་བར་བསམ་ཞིང་ཚོགས་པ་ཚོ་ཧཱུྃ་བགྲང་དུ་གཞུག་སྟེ་ཚོགས་པ་ཚོ་བསྲུང་བ་ཡིན་གསུངས།",
    "དེ་ཡང་དང་པོ་གསལ་ངེས་དེ་ནས་ཀྱང་མི་རྟོག་པར་ཕྲིལ་གྱིས་མ་སོང་བར་བསྒོམས་ཏེ།",
    "དེས་ལས་དང་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་མ་ལུས་པ་ཡང་བསྲེག་པ་ཡིན་གྱིས་སྣང་གྲགས་ཐམས་ཅད་དང་དངོས་པོ་དངོས་མེད་ཐམས་ཅད་སྲེག་པ་ཡིན་ཏེ་མདའ་ཡང་དེ་དང་འདྲ་མེའི་ཕུང་པོ་ཆེན་པོ་རང་དུ་བསྒོམས་པས་ཆོག་པ་ཡིན་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ས་སྟེང་གི་གནོད་སྦྱིན།",
    "འོག་གི་ཀླུས་གཙོ་བྱས་པའི་དྲག་པོ་གསུམ་བརྟུལ་བ་ནི་བྱམས་པའི་ཏིང་ངེ་འཛིན་ཏེ།",
    "ཁྱི་རྒོད་ཆེན་པོ་མང་པོ་བྱུང་བས་ལུས་ལ་འདགས་ནས་སོང་།",
    "ཁོང་གི་ཚོགས་གསོག་པའི་ཆེད་དུ་གསོལ་དུ་རུང་བ་ཀུན་གསོལ་ཟེར་ཏེ།",
    "འབུལ་བ་འོང་དུ་རེ་ནས།",
    "ནམ་ཟླ་ཡར་དྲོས་གཏུམ་མོའི་མེ་དང་།",
    "ཉིན་རེ་གཤིན་བསྔོའི་མང་ལུགས་སམ།",
    "ཞེས་པས་རབ་ཏུ་བྱུང་བ་རེ་རེ་ལ་དགའ་བ་དཔག་ཏུ་མེད་པ་འོང་བར་འདུག་སྟེ།",
    "མི་སྐྱ་དང་ཁྱིམ་པ་ལ་ཤ་ཆང་དུ་བྱས་ནས་བྱིན་ཀྱང་ཁོང་རྒྱགས་ནས་ཉོན་མོངས་པ་འདོད་ཆགས་དྲན།",
    "སྐྱེས་བུ་སྤྲང་པོ་ཡང་ཁོང་རང་གི་ཕ་མ་ཆུང་མ་ཤ་ཆང་འདོད་ཆགས་སྤོང་བ་ངོ་མཚར་མོད།",
    "༥༨ ། དེད་དཔོན་མཛའ་བོའི་བུ་མོའི་གཏམ་རྒྱུད་ལས་འཕྲོས་པའི་ལས་འབྲས་ཀྱི་ཚུལ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ངེད་རང་ཡང་ཡིན་པས་གཤིན་བསྔོ་འདི་ཀུན་ཀྱང་གཙོ་བོ་རེ་རེ་སྨོས་པའི་ཁོངས་སུ་ཤི་ཚད་དང་མ་ཤི་བ་ཀུན་ཀྱང་གསོན་རེ་ཡིན་གྱི་ཐམས་ཅད་ཀྱིས་བསྔོ་བ་གྱིས་གསུངས།",
    "ཞེ་སྡང་ཆེ་སྟེ་བྱ་བ་ཉེས་པ་བག་ཙམ་ལ་ཆེར་ང་འགྲོ་འབྲིང་དུ་ཁྱོད་སོང་ཟེར།",
    "མོ་སྐྱེས་མཁའ་འགྲོ་ཡོད་ཟེར་བས་བལྟར་འགྲོ་ཟེར་ནས་ཕྱིན་པ་ལ།",
    "རྣལ་འབྱོར་པ་ཞིག་ན་རེ་ཁྱོད་རང་སྣང་བ་མ་དག་པ་ཡིན།",
    "དེ་མིན་པར་ཁྱོད་ཀྱིས་མི་ཤེས་རྣལ་འབྱོར་པ་ནང་གིས་ནང་མཐོང་བ་ཡིན་ཟེར།",
    "རང་ལ་ཡང་རང་གིས་ཕྱེ་གཏོར་ཏེ་ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོ་ང་རང་ཡིན་སྙམ་ནས་དེ་ལྟར་ཡང་ཡང་མོས་པས་དེ་ལྟར་འགྱུར་བ་ལ་ཚེགས་མེད་དེ།",
    "སྐྱོ་སྤང་བྱས་པས་ལྷོ་མོན་ཁ།",
    "འོད་ཟེར་གཅིག་གིས་ཧོག་ཙེར་བསྐུལ་བ་ནི་མ་ཡིན་གསུངས་ཏེ།",
    "འབུམ་གྱི་གླེང་གཞི་ལེའུར་གཟིགས་དང་།",
    "འཇམ་དབྱངས་དང་མ་ཕམ་ལ་སོགས་པ་ཡིན་པས་དེ་རྣམས་ཕ་གིར་ལུས་པས་ད་ངེད་ཅུག་བྱ་སྙམ་པ་ལ།",
    "ད་རེས་ལུང་མི་དྲང་གསུངས།",
    "ང་བརྩོན་འགྲུས་ཆེ་བས་ཐུན་བཅད་ནས་སྦྱོར་བ་རེ་དང་རྗེས་ལྡང་བའི་དུས་སུ་བསྔོ་བ་རེ་བྱས་གསུངས།",
    "ལོ་གཅིག་ལ་ལན་བཅུ་གཉིས་ཡིན་མོད་གསུངས།",
    "ཞི་གནས་རབ་ཏུ་ལྡན་པ་ལྷག་མཐོང་གིས།",
    "ཉོན་མོངས་རྣམ་པར་འཇོམས་པ་ཞེས་པས།",
    "ཡང་སྒོམ་ཆེན་ཞིག་ན་རེ་ཁྱེད་རེས་མི་རྟོག་པ་ལ་བསྟོད་ར་བྱེད།",
    "རེས་སྨད་ར་བྱེད་པ་འདི་ཅི་ཙུག་ཡིན་ཟེར་བ་ལ།",
    "ལྷག་མཐོང་གི་བདེ་གསལ་མི་རྟོག་པ་གསུམ་ཡོད་པས།",
    "དེའི་ལས་ཟད་པ་མངོན་ཤེས་ཀྱིས་བལྟས་པས་ངན་སོང་དུ་འགྲོ་བར་འདུག་པ་མཐོང་བས།",
    "རབ་བྱུང་ཀུན་ཙཎྜ་ལི་ལ་བརྟེན་པའི་བདེ་བ་དེ་ལ་ཞེན་ཆེ་ན་ངན་སོང་དུ་འགྲོ།",
    "འདི་བཟང་ཤོས་ཤིག་ཡིན་ཏེ་རྩེ་གཅིག་གི་ཆ་མཐུན་ནམ་ཉེ་བའི་རྒྱུ་ཡིན་ཏེ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཡང་ཚོགས་ཀྱི་འཁོར་ལོ་གཅིག་ན།",
    "བག་ཙམ་ཞིག་གིས་ཆགས་པ་ཡལ་བར་བྱས་ལ།",
    "རང་གི་ལུས་ལ་དཔའ་བོ་དཔའ་མོ་ཐམས་ཅད་དང་གནས་ཉི་ཤུ་རྩ་བཞི་ཡང་ཡོད་ལ།",
    "དེ་མ་ཡིན་པའི་བུད་མེད་དང་ཤ་ཆང་གཉིས་ཁོ་ན་དགོས་པ་ཡང་མིན་ཏེ།",
    "དཔའ་བོ་དང་དཔའ་མོར་བསྒོམ་དགོས་པར་གདའ་གསུངས།",
    "ཡང་ཚོགས་ཀྱི་འཁོར་ལོ་དབེན་པའི་གནས་སུ་བསྐོར་ཞེས་པས།",
    "ཇོ་མོ་རྗེ་ཚོགས་ཀྱི་འཁོར་ལོའི་དུས་སུ་རྣལ་འབྱོར་པ་ལ་རུས་པའི་རྒྱན་དྲུག་ལ་སོགས་པ་གསོལ་ནས།",
    "གདུང་ལུག་གིས་བྱེའུ་ཀུན་བཀྲོད་དེ་འདི་ཀུན་གྱིས་ཐལ་མོ་ལན་གསུམ་ཀྱང་བརྡབས།",
    "རྗེ་བཙུན་མ་རའི་བྱོན་སར་ལུག་ཁྱུ་ལྔ་འདུག་པ་ལ་ཕྱིས་རེ་རེ་གཉིས་ལས་མེད་པར་སོང་བ་ངས་འདི་མཐོང་གསུངས།",
    "དེ་ནས་ཨོཾ་བཛྲ་ཨུ་ཙི་ཧ་རེ་ཏེ་སྭཱ་ཧཱ།",
    "༥༨༣ ། སྨོན་འཇུག་གཉིས་ཀྱི་ཕན་ཡོན་གཙང་པ་འཇམ་སེང་གིས་སེམས་བསྐྱེད་ཞུས་དུས་གནང་བ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ནོར་བཟང་ཁྱོད་ལྟོས་ཤིག་ཅེས་སྟོང་གསུམ་གྱི་ལྷ་དང་གནོད་སྦྱིན་ཐམས་ཅད་ལ་བྱིན་པ་མ་ཟད།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཞེས་གཙང་པ་འཇམ་སེང་གི་སེམས་བསྐྱེད་ཀྱི་དུས་སུ་གསུངས་པའོ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་གི་ཚེ་ན།",
    "དེ་ཡང་སྒོམ་ཆེན་པ་ཀུན་ལ་སྦྱར་ན་རང་གི་ལུས་ལ་ཆགས་པས་ཤིང་འཐུ་བ་ལ་མ་བཞེངས།",
    "དེ་སྦྱངས་པས་རྟོག་པ་ནུབ་ནས་དཔྱོད་པར་སོང་བས།",
    "ཉོན་མོངས་པ་ཆགས་པ་ང་བདག་དེ་མ་རིག་པ་ཡིན་ཏེ།",
    "ལུགས་ལས་ལྡོག་པ་ཤེས་ཏེ་ལྷག་མཐོང་གི་ཏིང་ངེ་འཛིན་དེ།",
    "ང་ལ་ཆགས་པ་ཡོད་སྙམ་མམ་མེད་ཀྱིས་གོས་ཀྱང་བཟང་མ་སྙམ་ཞིག་ཟས་ཀྱང་ཚོགས་བསྐྱངས་ནས་ཟན་སྤུན་ནེ་བ་ཞིག་འགྲངས་པར་ཟོས།",
    "ལ་ལ་ཐུགས་རྗེ་ཆེན་པོའི་མི་དཀར་པོ་ཞིག་གིས་འགུགས་སྙམ།",
    "འགོས་ལ་དྲིས་པས་དེའི་བྱང་བུའི་མིག་གི་གྲངས་གྱིས་ལ་ཡི་གེར་བྲིས་པ་དུད་པ་ལ་བདུགས་ཏེ།",
    "ཁྲབ་ཐོབ་པ་དང་ཁོ་ལ་ཆད་པ་ཕོག་པ་གཉིས་ཀ་འོང་གི་ཟེར་ལོ་གསུང་།",
    "དེས་ན་རབ་ཏུ་བྱུང་བ་ཀུན་ལ་ཡང་དང་པོ་བར་ཆད་བསེན་མོ་འོང་བ་ཡིན་ཏེ།",
    "༥༨༥ ། འཆི་ཁའི་མཚམས་སྦྱོར་ངན་ན་དགེ་སྦྱོར་གང་གིས་སྐྱོབ་མི་ནུས་པར་གདམས་པ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཞེས་པས་འཆི་ཁའི་མཚམས་སྦྱོར་ཉོན་མོངས་པས་སྦྱར་ན་སྦྱིན་པ་དང་།",
    "ལྷག་མཐོང་གི་ཏིང་ངེ་འཛིན་གྱིས་ཀྱང་མི་སྐྱོབ་གསུངས།",
    "གཡོག་མོས་བསིལ་ཡབ་གཡབས་པའི་ཡུ་བ་ཐུག་པས་ཞེ་སྡང་སྐྱེས་ཏེ་མཚམས་སྦྱར་བས།",
    "ཡང་ཆགས་པ་སྐྱེས་པ་ལྷུང་བཟེད་ནག་ལ་ཟླུམ་པ་བྱ་རོག་གི་མིག་ལྟ་བུ་ལ་ཆགས་པའི་དགེ་སློང་ངའི་ལྷུང་བཟེད་ནོད་ཅིག་ཟེར་བ་ལ།",
    "སྦྲུལ་ནགས་ཀྱི་གསེབ་དུ་སོང་བས་ཁའི་མེས་ནགས་ཚིག་པ་དང་སེམས་མནར་མེད་ཀྱི་མེས་བསྲེགས་ཏེ་དུས་གཅིག་ཏུ་མེ་གསུམ་འབར་བ་དང་།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "མཚོན་ཆ་རབ་ཏུ་འབར་བར་སོང་ནས་ཕར་རྒྱུགས་ཚུར་རྒྱུགས་ཀྱི་སྡུག་བསྔལ་ཆེན་པོར་གྱུར་ནས།",
    "སྔོན་རྒྱལ་བ་འོད་སྲུང་ཀྱི་ཉན་ཐོས་ཡིན་ཏེ་ཡོན་བདག་གིས་ཁ་ཟས་བསོད་པ་ཞིམ་པོ་ཕུན་སུམ་ཚོགས་པ་བྲིམས་པ་དང་།",
    "འཐབ་མོ་ཆེན་པོ་བྱས་ནས་ཁ་ཟས་ཕན་ཚུན་བརྒྱབ་པ་ལས་གྱུར་པའི་རྣམ་སྨིན་ཡིན་ཏེ།",
    "ཁྱེད་འཛམ་བུའི་གླིང་དུ་འགྲོ་ན་འོད་སྲུང་གི་དགེ་སློང་ནི་འདི་ལྟར་གྱུར་ཏོ་ཞེས་གཞན་ལ་ཤོད་ཟེར་སྐད་པས་ཕྱོགས་རིས་མ་བྱེད་གསུངས།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "རེ་རེ་སུན་སྟོན་ནས་རེ་རེ་བསྒྲུབས་པས་མི་འོང་སྟེ།",
    "དགྲ་གཅིག་གསོད་པ་ལ་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་རུས་སུ་འདོན་དགོས།",
    "རང་གི་སེམས་འདི་ཡོངས་སུ་འདུལ་དང་ཞེས་མང་དུ་གསུང་།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་གང་ཡིན་ན་རང་གི་རྒྱུད་ཀྱི་ཉོན་མོངས་པ་དང་རྣམ་པར་རྟོག་པ་འདི་ཡིན།",
    "ཡོན་བདག་སྤང་པོ་རྣམས་ཀྱང་རང་གི་ཤེས་པ་ལ་གཅེར་གྱིས་བལྟ་བ་དེ་སྐྱེ་བ་མེད་པར་ཤེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "རང་གིས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་སྦྱང་པ་མ་ཆགས་པ་གལ་ཆེ་སྟེ།",
    "སྦྱིན་པ་ཡང་དཀའ་བར་འདུག་ངས་སྔོན་ཕག་མོ་གྲུར་མི་ཞིག་ཟ་འཐུང་གིས་བསྐྱངས་པ་ལས།",
    "ཁོང་ངན་སོང་ཙམ་དུ་ཡང་མི་གཏོང་བ་ཁོ་བོ་ལ་འབབ་པ་ཡིན་གསུངས།",
    "ངའི་སྐུ་འདི་ཡང་ཐལ་བར་ཕངས་གསུངས་སོ།",
    "ཤཱ་རིའི་བུ་དང་མོ་འགལ་བུ་ལྟ་བུ་འཛམ་བུའི་གླིང་གང་བས་ཀྱང་མེ་འདི་བསད་པར་མི་ནུས་ཏེ།",
    "དིའུ་པི་ལིང་ཏ་བྱ་བ་ན་རྫ་མཁན་དགའ་སྐྱོང་བྱ་བ་གད་པ་ཆད་པ་དང་ཆུས་ཟོས་པ་དང་བྱི་ཁུང་གི་ས་ལ་བཟོས་པའི་རྫའི་རིན་གྱིས་ཕ་མ་གསོས་པ་ན།",
    "དེ་ལ་རྒྱལ་པོ་དགའ་ནས་འབྲས་དྲུས་མ་སྤུ་བཅད་པ་རྔ་མོང་ཁལ་སྟོང་ཁོ་ལ་བྱིན་པ་དང་།",
    "རྒད་པོ་ཨ་ཆུང་གི་ཆུང་མ་བྱ་རིལ་མ་འདིས་ཕྱེ་བྲེ་གསུམ་དང་གྲོ་མ་ཕུལ་ཏེ་ལན་གཉིས་སུ་བསྔོ་བ་ཞུས་ཏེ་བདག་པོ་ལ་ཡང་བཟང་ངན་མི་འདུག་གསུངས།",
    "ཡང་འདི་སྐད་བདག་གི་ཐོས་པ་དུས་གཅིག་ན།",
    "སྔོན་འཕགས་པ་གྲོ་ཞུན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་བྱ་བ་ཕ་ཕྱུག་པས་བང་བ་བྱེད་པ་ཉི་ཤུ་ཡོད་པ་ཞིག་ལ་བུད་མེད་ནས་གླུ་ལོངས་བྱས་པས་བུད་མེད་ཞིག་ལ་བུ་ཞིག་སྐར་མ་གྲོ་ཞུན་ལ་སྐྱེས་པ་དང་།",
    "ཁྱོད་རང་རྒྱལ་པོའི་ཁབ་ན་ཡོད་པ་ལ་བང་ཆེན་བཏང་ནས་བུ་ཡོད་ཞེས་པས་ལན་བཞིའི་བར་དུ་བུ་ཡོད་དམ་ཟེར།",
    "དེ་མ་རིགས་ནས་ཁ་རོག་བསྡད་པ་ལ་ཁྱོད་ཀྱི་བུ་ཡོད་བྱ་བ་ལན་དུ་བྱས་པས་ཁ་གསེར་ཕྱེས་འགེངས་པ་ཡིན་པ་ལ།",
    "ཁོ་ཁེ་གྲགས་སྐྱེས་ནས་ཀུན་དགའ་བོ་ལ་གདམས་པ་ཞུས་ནས་དུར་ཁྲོད་དུ་ཕྱིན་ནས་འཆགས་བྱས་ཏེ་སའི་སྟེང་དུ་རྡོ་གཅལ་བྱས་ནས་དེའི་སྟེང་དུ་འགྲོ་བ་འཆག་པ་འབའ་ཞིག་གིས་འབད་པ་བྱས་པས་ཏིང་ངེ་འཛིན་གཅིག་ཀྱང་མ་སྐྱེས་པས་ཡིད་མུག་ཏེ་བབས་སྙམ་པ་དང་།",
    "ངལ་ཞིང་དུབ་པས་ཀླུང་ན་ར་ཛའི་ནའི་འགྲམ་དུ་འབྲས་ཉག་མ་རེ་ལས་ཀྱང་མ་གསོལ།",
    "གོས་གྲོང་པའི་བུ་མོ་གྲུ་པ་མོའི་རོ་ཤུན་ཀྱང་གསོལ་ཏེ་དེ་གང་ཡིན་གསུངས།",
    "ཉོན་མོངས་པ་མ་སྤངས་པར་འདུག་པ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་ལ་བདག་ཉིད་ཆེན་མོའི་གསང་གནས་སུ།",
    "གོས་ཧྲུལ་རེ་ཁོང་རང་གི་རྙེད་རེ་རེ་ངས་བྱེད་ནས་ཁལ་ཕྱེད་བྱིན་པས་སང་ཕོད་བསྒོམ་ཆེན་རྙིང་པ་རེ་འོང་བར་འདུག་པས་འདི་ལ་རྙོགས་པ་ཡིན།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཁྱེད་རྣམས་ལ་དད་པ་དང་གུས་པ་བསྙེན་བཀུར་བསམ་གྱིས་མི་ཁྱབ་པ་བྱེད་པ་འདི་སྔོན་ནས་རང་གིས་སློབ་སྦྱིན་པའི་ཕན་ཡོན་བརྗོད་ནས་གདམས་ངག་བསྟན་པ་དང་།",
    "དེ་སྔོན་ང་རང་གི་གདུལ་བྱ་ཡིན།",
    "ལྷག་པར་མོས་པས་ལྷག་པར་མོས་པ་ལ།",
    "མོ་བོན་ལ་སོགས་པ་གནམ་གྱི་ཡ་ཆ་དང་སའི་སྲི་བཞི་མིའི་སྐྱབས་བྱེད་པ་ཡིན་བྱས་ན་སྐྱབས་སུ་མ་སོང་བ་ཡིན་གསུངས།",
    "བྱང་དུ་བྱི་བོ་གཅིག་ལ་ངས་གདམས་ངག་བསྟན་པས་ཁོ་བྱི་བོ་གཞན་ཞིག་གིས་ཆུར་བསྐྱུར་བ་ལ།",
    "སྔོན་རྒྱལ་བུ་ཐམས་ཅད་སྒྲོལ་རི་བྲག་ན་བུ་མིང་སྲིང་གཉིས་ཡོད་པ་ལ་བྲམ་ཟེ་གཡོག་མེད་པ་ཞིག་གིས་བླངས་པ་ལ་བྱིན་ནས།",
    "ངའི་བ་སྤུའི་བུ་ག་ལ་ལྟོས་ཞེས་ཐམས་ཅད་ཁྲག་ཏུ་སོང་ནས་འདུག་སྐད་དེ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་བསམས་པ་ཡིན་མོད།",
    "ཁྱེད་ཀྱང་རྟེན་ས་ཁང་པ་གཅིག་ཡོད་པ་དེ་ང་ལ་ཕུལ་བས་སྤྲང་པོར་སོང་བ་དེ་ཡིན་ང་ལ་བྱ་ཐབས་དེ་ལས་མེད་དེ།",
    "ང་སྤྲང་པོར་སོང་དེ་མིན་བསྒྲེས་པོ་གཉིས་རབ་ཏུ་བྱུང་ན་ལེགས་ཏེ་ཁྱིམ་བདག་དཔལ་སྐྱེས་ལོ་བརྒྱ་ཉི་ཤུ་བ་ཞིག་རབ་ཏུ་བྱུང་བ་ལ་ཁ་ཐོན་རེམ།",
    "ཁྱོད་ཀྱིས་མཁན་བུ་དཔལ་སྐྱེས་ལ་ལྟོས་ཤིག་ཞེས་དེས་ལག་ནས་བཟུང་ནས་ཁྲིད་དེ་གདམས་པ་བསྟན་པས་དགྲ་བཅོམ་པ་ཐོབ་པ་དང་།",
    "རང་གི་སེམས་ལ་དུས་ཐམས་ཅད་དུ་ཡེངས་པ་མེད་པར་སྐྱབས་སུ་འགྲོ་བ་ཡིན་ཏེ།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་འདུལ་ཞེས་པ་དང་།",
    "རེས་འུར་འདེད་དུ་བཤད།",
    "རེས་ནོར་བསྒྲུབ་ཏུ་བཤད།",
    "འོ་ན་མུ་སྟེགས་པ་ལ་མེད་དམ་ཞེ་ན་མེད་དེ་ཕྱི་རོལ་པ་ཞེས་པ་ལུས་ངག་གི་བརྟུལ་ཞུགས་ཡིན་གསུངས།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་ཡང་ལོ་གསུམ་ན་སྐམས་པས་ལྟོགས་དྲིར་ཤི་ལ་ཁད་པས་འཚོ་བ་དྲང་གིས་དགེ་སྦྱོར་མཛོད་ཅེས་པ་དང་།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "རང་གིས་རང་གི་ཡེ་ཤེས་ནི།",
    "དུས་རིང་མོ་ན་བལྟས་པས་གཅེས་པ་ལ་ཡི་གེ་མི་འདུག་པས་འོ་ན་ཡི་གེ་མེད་པ་འདི་ཟབ་པར་བྱུང་སྙམ་ནས་སྨྲ་བསམ་བརྗོད་མེད་ཀྱང་རྟོགས་གསུང་།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "སྤང་བྱ་དང་གཉེན་པོ་གཉིས་མེད་པས་ཁྱོད་ཀྱིས་གསང་སྔགས་ཀྱི་སྒོ་མང་པོ་ཞིག་འབྱེད་སྙམ་པ་ཡིན།",
    "དེས་ན་བག་ཆགས་ཀྱི་ཉོན་མོངས་ཀྱང་སྐྱེ་བཞིན་པ་འདི་རང་ཡིན་ཏེ་མ་སྐྱེས་པའི་དུས་སུ་གཉེན་པོ་བསྟེན་མི་དགོས།",
    "འོ་ན་ས་དང་པོ་བདེན་པ་མཐོང་བའི་དུས་སུ་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་ཞེས་པས་ཉོན་མོངས་པའི་རང་བཞིན་རྟོགས་པ་ཡིན་ཏེ་མངོན་རྒྱུ་རགས་པ་སྤངས།",
    "དག་པའི་ས་གསུམ་ནས་རྡོ་རྗེ་ལྟ་བུའི་བར་གྱིས་ཤེས་སྒྲིབ་སྤངས་པར་རྗེ་ཕག་མོ་གྲུ་པས་བཞེད་གསུང་།",
    "དེས་ན་ཉི་ཚེ་བའི་སྟོང་པ་འདི་ཁོ་ན་ཟབ་སྟེ་ས་བཅུ་ལས་ཀྱང་རྣམ་པ་མཆོག་ལྡན་མ་གཏོགས་པས་ཉི་ཚེ་བར་སོང་གསུང་།",
    "ཁྱེད་རང་གིས་མ་གོ་བ་ཡིན་སྒོམ་གྱི་མྱོང་བ་ཆུང་བ་ཡིན་ཏེ།",
    "ཉོན་མོངས་པ་སྐྱེས་ཙམ་ན་ཁྱེད་ཇི་ལྟར་བྱེད།",
    "མདང་ཞག་གི་གསེར་འབུམ་འབུལ་བ་དེའང་བྱུང་ནས་དེ་ལ་ཆགས་པ་སྐྱེས་ན་ཇི་ལྟར་སྤོང་།",
    "བོར་ནས་བྲོས་ནས་འགྲོ་དགོས་ཏེ་དེས་མི་ཕན་བསམ་པ་དེ་ལ་བཏགས་ནས་ཡོད་པས་རེས་ངས་ལེན་མ་ནུས་རེས་ང་ལ་མ་ཕུལ།",
    "རེས་མ་བླངས་པ་ཡག་སྙམངས་པའི་ཚིག་བཅད་གཅིག་གསུང་།",
    "དེ་ནས་མོ་རྦབ་ཏུ་ལྷུང་ནས་དེས་དགྲ་བཅོམ་ཐོབ་གསུང་།",
    "རྣམ་གྲོལ་གྱི་སྤོབས་པ་དད་ལྡན་པའི་ས་དྲུག་པ་དེ་ཡང་ཉོན་མོངས་པས་ཀུན་ནས་བླང་ནས།",
    "དེ་བཞིན་དུ་གསེར་འབུམ་ཡང་འགུགས་པའི་སྦྱོར་བ་སྣ་ཚོགས་བྱས་པའི་ཇ་སུན་ལ་སོགས་ཀྱང་རིན་དུ་སོང་སྟེ་ཕུལ་ནས་སྦྱིན་བདག་ཀྱང་མི་དགའ།",
    "སྟན་དེ་རང་གི་འོག་ནས་ཟས་ནོར་འོང་གིས་དེ་མ་ཡིན་ན་ཟན་བྲུལ་འཐོར་བའི་ས་ཉོན་མོངས་དེས་འཆིང་བ་ཡིན་གསུང་།",
    "འབྲི་གུང་གི་མཁར་ལན་འདི་ཤིན་ཏུ་ལེགས་པ་ཞིག་བྱུང་བས་དེ་ལ་རྒྱུ་གཉིས་ཡིན།",
    "དེ་ནས་ཕྱག་རྒྱ་ཆེན་པོར་མ་སོང་བར་དུ་བསྒོམ་སྟེ་རང་སར་དག་ཏུ་ཆུག་དེ་བཞིན་དུ་ཙ་ལི་དང་མཚན་བཅས་མཚན་མེད་གང་ཡང་འདྲ་སྟེ་དེ་ལྟར་བསྒོམ་གསུང་།",
    "སྐྱེས་ནས་མྱོང་འགྱུར་དང་ལན་གྲངས་གཞན་ལ་འགྱུར་བ་ཀུན་ཀྱང་བསམ་པ་དེ་ལྟ་བུ་ལན་རེ་གཉིས་མེད་སྐྱེས་ཀྱང་སྦྱོར་བ་རྒྱུན་ཆད་མེད་པས།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་མ་ལུས་པར་སྤངས་ཏེ་བྲལ་བའི་ཡོན་ཏན་སྟོབས་བཅུ་མི་འཇིགས་པ་བཞི།",
    "བག་ཆགས་ཀྱི་མཚམས་སྦྱོར་བའི་ཉོན་མོངས་པ་ལ་ཤེས་བྱའི་སྒྲིབ་པ་མཛད་པ་སྟེ་མ་སྤངས།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་གང་ཡིན་ན་རང་གི་སེམས་རྒྱུད་འདི་ལ་མི་རྟོག་པ་སེ་གོལ་རེ་ཙམ་ཡོད་དམ།",
    "དེ་ཡོད་ན་ཡང་ཕྱི་ནང་གི་ཆགས་སྡང་ཐམས་ཅད་སྤངས་ནས་དབེན་པར་གཅིག་པུར་བསྐྱངས་ཏེ།",
    "སེ་གོལ་གཉིས་གསུམ་བཞི་ཙམ་ཟན་ཁམ་ལྡད་ཡུན་ཙམ་མམ་ཇ་སུན་ཞིག་གི་བར་ཙམ་མམ།",
    "ཐུགས་རྗེ་ཆེན་པོ་འབའ་ཞིག་ཏུ་བསྒོམས་པས་ཆགས་སྡང་ལྡོག་སྟེ་སྐད་ཅིག་མ་དང་པོ་ལ་ཆགས་སྡང་དུ་སོང་སྟེ་གཉིས་པ་གསུམ་པ་ལ་རྒོད་རེ་བྲོར་འོང་གསུང་།",
    "ནང་གི་ལུས་ལ་ལུས་ཀྱི་རྗེས་སུ་བལྟ་ཞིང་བརྩོན་འགྲུས་ཅན་ཤེས་བཞིན་དང་ལྡན་པ་དྲན་པ་དང་ལྡན་པས་དེ་མི་དམིགས་པའི་ཚུལ་གྱིས་ཞེས་པའི་བར་རམ།",
    "སྣའི་ཡུལ་ཡང་བླ་དབྱེ་ཐང་གཞུག་གི་རྣམ་སྣང་ལ་འགེབས།",
    "ལྕེའི་ཡུལ་དུ་རོ་ཡང་མིད་པ་སོར་བཞི་འདས་ནས་འགྲངས་པ་ཞིག་གིས་ཆོག་པ་ཡིན་ཏེ།",
    "རེག་བྱ་ཡང་ཚོར་བ་འཇམ་རྩུབ་ཚོར་བ་བདེ་སྡུག་བཏང་སྙོམས་གསུམ་ཡིན་ཏེ།",
    "ན་མོ་གུ་རུ།",
    "དེ་ནས་ཞག་འགའ་ནས་ཀྱང་མ་གི་ན་ངོས་ཡ་ཅིག་པགས་པ་བུད་ནས་ང་འདི་ལྟར་སོང་ཟེར་ཡིན་ཡར་འགྲོ་ཕྱིར་འགྲོ་བྱེད་ཅིང་འདུག་ལོ།",
    "དེ་ནས་ཁམས་བདེ་ནས་ཕྱིས་འདམ་དུ་ང་ལ་བསྙེན་བཀུར་ཀྱང་བྱས་ཏེ་ཁྱེད་རང་གི་དྲག་སྔགས་རྒྱབ་ཀྱང་བྱས་ཏེ།",
    "དེ་བཞིན་དུ་རྫོགས་རིམ་ལ་ཡང་གཏུམ་མོ་བཏབ་ཀྱང་དྲོད་མ་བྱུང་ཡང་གཅིག་ཤོས་བུད་ནས་འགྲོ་བར་འདུག་གསུང་།",
    "ལྷོ་ཞིག་ཉི་མ་རེ་ལ་དམིགས་པ་བཅོ་བརྒྱད་བྱུང་ན་ཡང་དེ་ལ་དགའ་གསུང་།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ལས་དང་ཉོན་མོངས་ཤེས་བྱའི་སྒྲིབ་པའི་རྟོག་པ་ཅི་བྱུང་ཐམས་ཅད།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་ཡང་དང་པོ་སྤང་བྱ་ཉོན་མོངས་པ་དུག་གསུམ་ཟེར་ཡང་ཕྱི་ནང་གི་འདོད་ཆགས་སྤང་སྟེ།",
    "རབ་ཏུ་བྱུང་བས་རང་གི་རྒྱུད་ལ་བདེ་གསལ་མི་རྟོག་པ་གསུམ་གྱི་ཉམས་ཅིག་སྐྱེ་སྟེ།",
    "ཡང་གཉིས་པ་ཤི་བའི་འོག་ཏུ་ཡང་ངན་སོང་ངན་འགྲོའི་སྡུག་བསྔལ་ཐམས་ཅད་ཀྱང་བཅོམས་ནས།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་ལ་མོས་པ་དང་གུས་པ་ཕྱོགས་གཅིག་ཏུ་བྱེད་ཅིང་བསྲུང་བ་མང་ཤོས་ཡིན།",
    "ས་དང་ལམ་གྱི་བྱེ་བྲག་གི་ཡོན་ཏན་དེ་རྣམས་ལྷག་མཐོང་ཡིན་ཏེ།",
    "དེ་རང་བཞིན་གྱིས་སྟོང་པ་དངོས་པོ་སྐྲའི་རྩེ་མོ་ཙམ་མ་གྲུབ་པར་བསྟན་པ་ཡིན་གསུང་།",
    "འཇིག་རྟེན་པ་མངོན་འགྱུར་རགས་པ་མི་སྐྱེ་བའི་ཞིང་ཁམས་སུ་སོང་བས།",
    "ཉོན་མོངས་པ་ལྔ་དར་བ་ས་གཞི་ཡང་རི་དང་བྲག་དང་བྱ་སྐྱིབས་དང་གཅོང་རོང་དུ་ཡོད་པ།",
    "མི་གཙང་རྫས་དང་རྣམ་རྟོག་གིས།",
    "དབྱིབས་སུ་ཡོད་ན་རྟ་རྔ་སྟོང་དུ་བཤགས་པའི་ཆ་ཙམ་ཞིག་ཡོད་ཟེར་ཏེ་དོན་ལ་མེད་པ་ཡིན་མོད།",
    "དེ་ལུས་ངག་གི་རྟོག་པ་དང་གཉིས་སུ་མེད་དེ་གནས་པའི་གཤིས་དེ་རང་ཡིན།",
    "སོར་མོ་ལྔ་ཆུ་ནང་དུ་བཅུག་པས་ཕུན་སུམ་ཚོགས་པ་འོང་སྟེ་ལྷག་མ་དེར་འཇུག་པ་དེ་བཞིན་དུ།",
    "བཙུན་མོ་མིའི་བུ་མོ་བས་ལྷག་པ་ལྷའི་བུ་མོ་བས་ཅུང་མ་ཆོག་པ་མི་ཆེ་མི་ཆུང་བ་ཡིན་ཏེ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དང་པོ་ཉོན་མོངས་ཆགས་པ་བརྟེན་པ་འདི་མེད་པ་ལ།",
    "དེ་ནས་ཕྱོགས་གཅིག་སྐྱོར་བས་ཁྱིམ་དུ་སོང་ལ།",
    "དེ་ནས་ས་ཞག་ཀྱང་ཁྱིམ་དུ་བླངས་པས་དེ་ལ་རྐུ་བ་བྱུང་བས་མི་གཅིག་གིས་བགོ་གཤའ་བྱས་པས་དེའི་རྣམ་སྨིན་གྱིས་མང་པོས་བསྐུར་བར་ཕྱིས་སྐྱེས་པ་ཡིན་ཏེ་རྒྱལ་རིགས།",
    "ཁང་པ་ལ་མཆོངས་པ་ནམ་མཁས་བཟུང་ནས་འདིས་སྔོན་ཡང་དྲང་སྲོང་གི་དུས་སུ་ཡང་འདི་ལྟར་བྱས་གསུང་བ་བཞིན་ནོ།",
    "༦༩ ། གྲུུབ་ཐོབ་ཀུན་སྤྲོས་པ་གཅོད་པའི་ལུགས་རེ་རེ་འོང་ཚུལ་གྱི་གླེང་གཞི།",
    "ཡེ་ཤེས་རང་སྣང་གནོད་སྦྱིན་རི་མོ་ཅན།",
    "ཅེས་པས་རང་གི་བསམ་པ་གང་ལྟར་ཡོད་པ་དེ་འགྲོ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་གང་རུང་གི་བསམ་པ་དགེ་མི་དགེ་གཅིག་ཏུ་ཐག་གཅོད་པ་ལ་སེམས་ཟེར།",
    "དེས་ན་མི་ཞིག་གི་ཞེ་སྡང་གིས་རྒྱལ་ཁམས་ཁྲག་སྐྱོར་འགྲོ་སྟེ།",
    "ཞེ་སྡང་གིས་རང་བསྲེགས་འོད་ཀྱིས་གཞན་བསྲེགས་པ་ཡང་དེ་ཡིན་གསུང་།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གིས་དུས་བསྐལ་པ་དཔག་ཏུ་མེད་པར།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཉོན་མོངས་པ་སྤོང་དུས་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་ན་བཅུ་གཅིག་ཀུན་ཏུ་འོད་ཀྱི་ས་ལ་སངས་རྒྱ་བར་འདོད་པས་མི་ཟབ་གསུང་།",
    "དུས་ཚེ་གཅིག་ལུས་གཅིག་གིས་བཅུ་གསུམ་རྡོ་རྗེ་འཛིན་པའི་སར་སངས་རྒྱ་བར་འདོད་དེ།",
    "རྗེ་ནཱ་རོ་པཎ་ཆེན་ཡི་གེ་བདུན་པ་འབུམ་ཕྲག་གཅིག་གིས་ལུང་བསྟན་ཐོབ་པ་ཡིན་ཏེ།",
    "རང་རིག་སྤྲོས་དང་བྲལ་བར་ཁྱེད་ཀྱིས་ཤེས་མོད་ཀྱང་།",
    "དེ་ནས་དེ་གར་སོང་ཆ་མེད་པར་སོང་སྟེ་དེ་ཕྱིས་ངས་རྗེ་བཙུན་ལ་གསོལ་བཏབ་པས་བར་ཆད་ཀྱང་མ་བྱུང་སྟེ།",
    "དུས་ཐམས་ཅད་དུ་དཀར་གཏོར་རེ་ཡང་དབུལ་གསུང་།",
    "དེ་མ་ཡིན་ངེད་རང་གི་བལ་བསྐུར་ནས་ཡང་དམིགས་པ་བསྐོར་གསུམ་ཞིག་འདུག་གིས་ཞེས་པས་མི་འོང་སྟེ་ཁྱེད་རང་ཐམས་ཅད་འདི་སྙམ་དུ་སོམས་ཤིག་བདག་ཅག་རྣམས་ལ་སྡང་བར་བྱེད་པའི་དགྲགནོད་པར་བྱེད་པའི་བགེགས།",
    "སྤུ་ཏ་ིག་གྱེན་དུ་གཟིགས་པས་བར་སྣང་གི་གནོད་སྦྱིན་འདུལ།",
    "སྐུ་ཕྱི་ནང་ཐམས་ཅད་མེ་དཔུང་གིས་རབ་ཏུ་བརྒྱན་པ།",
    "སྐུ་གསུང་ཐུགས་ལ་འོད་དཀར་དམར་མཐིང་ནག་བྱུང་ནས་རང་གི་ལུས་ངག་ཡིད་གསུམ་ལ་ཐིམ་པར་བསམ་ཞིང་།",
    "ཨོཾ་ཙཎྜ་མ་ཧཱ་རོ་ཥ་ན་ཧཱུ་ཕཊ་ཞེས་ལན་གསུམ་བརྗོད་ནས་ཁྲོ་རྒྱལ་རང་ལ་ཐིམ་པས་རང་ཁྲོ་རྒྱལ་ཏུ་གྱུར་པར་བསམ་མོ།",
    "མི་གསལ་ན་སྔགས་བཟླས་ཀྱང་དྲུང་དུ་ལད་མོ་བཟློས་པར་འདུག་གསུང་།",
    "ལར་གནོད་བྱེད་དེ་ལ་ཞེ་སྡང་གིས་ཨ་ཏི་ཐུམ་ཐུམ་ཞེས་དྲག་སྔགས་རྒྱབ་པས་མི་ཐུབ་སྟེ།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དད་པ་ཅན་གང་ཟག་གི་རྗེས་སུ་འབྲང་བ་ཀུ་སཱ་ལི་གཉིས་ལས།",
    "ཚེ་འདི་ལ་ལྟོས་པ་སྐྲའི་རྩེ་མོ་ཙམ་ཞིག་ཀྱང་མེད་པ་ཞིག་པ།",
    "ཁ་གཡོ་མཁན་གྱི་རྗེས་སུ་འབྲངས་ན་འཕན་ཡུལ་གྱི་གྲོགས་པོ་ཤོ་རེ་ར་ཡང་མི་ཐོན་གསུང་།",
    "ཤཱཀྱའི་རྒྱལ་པོས་སྔོན་རབ་ཏུ་བྱུང་བ་ལ་བཙུན་མོ་ལྷ་མཚོ་མ་དང་ས་མཚོ་མ་དང་།",
    "གོས་ཕྱག་དར་ཁྲོད་གྲོང་པའི་བུ་མོ་བྲན་མོ་གྲུབ་པ་མོའི་རོ་ཤུན་ཤ་རྟོག་ཀྱང་ཡོད་མི་རྟོག་པ་ཡང་ཡོད་པ།",
    "ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས།",
    "ཚངས་པས་ཞུས་པ་ལས་རང་གི་སེམས་ཉིད་ཀྱི་གཤིས་མཐོང་བ་ཟེར་བར་འདུག་སྟེ།",
    "གཟུགས་མཛེས་པ་དད་པ་དང་ཤེས་རབ་ཆེ་བ་ཞིག་གིས་སློབ་དཔོན་བྲམ་ཟེ་ནོར་བུ་བཟང་པོ་བྱ་བ་ལ་རིགས་བྱེད་སློབ་ཏུ་ཕྱིན་པ་ལ།",
    "སློབ་དཔོན་གྱི་བྱས་པས་ཁྱོད་ཀྱིས་འདི་ངན་པར་གཏོང་དགོས་ཟེར།",
    "ཞབས་ཏོག་གྱིས་ཟེར་ཚོང་གི་མིང་བསྒྱུར་བ་ཡིན་མོད།",
    "ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་གཉིས་སུ་མེད་པའི་དོན་དེར་བཟང་ངན་སྤང་བླང་རེ་དོགས་ཐམས་ཅད་ཞི་ཞིང་ཐིམ་པ་དེ་ལ་ཟེར་བ་ཡིན་ཏེ།",
    "དུར་ཁྲོད་བསིལ་བ་ཚལ་དུ་འཆག་ས་བྱས་ཏེ་སྐོར་བ་འབའ་ཞིག་གིས་རྐང་པའི་ལྤགས་པ་ཟད་དེ།",
    "༦༡༤ ། མཉམ་གཞག་རྗེས་ཐོབ་གང་གིས་འགྲོ་དོན་བྱེད་པ་སྒོམ་ཆེན་རྣམས་ལ་དྲིས་པ།",
    "དེ་བཞིན་དུ་རྒྱལ་པོ་དཔེ་ཀར་ཀླུ་བསེན་མོར་གཏོགས་པ་ཐམས་ཅད་ཀྱང་གཅིག་ཤོས་སུ་འོང་བ་ཡིན་པས།",
    "པག་ཤི་དང་གསུས་པ་ལོགས་ལོགས་སུ་སོང་ནས་རྐྱེན་མི་ཐུབ་པ་ཡིན་ཏེ།",
