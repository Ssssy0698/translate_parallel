    "རྣམ་པར་རྟོག་པ་དེའི་བག་ཆགས་ཀྱི་རང་བཞིན་ན་དེ་དག་ལས་སྐྱེ་བ་ཅན་འདི་དེ་ལྟ་བུར་སྣང་བ་གང་ཡིན་པ་དེ་ཡིན་ནོ།",
    "དེ་བས་ན་རྗེས་སུ་བྱེད་པ་རྣམས་ཀྱི་བློའི་སྣང་བ་ལ་བློ་ལ་སྣང་བའི་དངོས་པོ་ལ་རྣམ་པའི་ཁྱད་པར་ཡོངས་སུ་འཛིན་པས་ཕྱི་རོལ་ལྟ་བུར་ཀུན་ཏུ་འཕྲོ་བ་དེ་དག་ཁོ་ནའི་སྤྱི་ཡིན་བར་བྲྗོད་དོ།་།",
    "དེ་ན་དེ་ཁོ་ན་འཛིན་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ནི་རང་བཞིན་གྱིས་འཁྲུལ་པའི་ཕྱིར་དངོས་པོ་འཛིན་པ་ལྟ་བུར་སྣང་ངོ།",
    "ཕྱི་རོལ་པ་རྣམས་ཐ་དད་པ་ཡིན་ན་དེ་དག་ལ་ནི་རྣམ་པར་རྟོག་པ་མི་འཇུག་པ་ཡིན་ནམ།",
    "འཆད་པར་བྱེད་པ་རྣམས་དེ་ལྟར་རྣམ་པར་འབྱེད་པར་བྱེད་ཀྱི།",
    "ཐ་སྙད་འདོགས་པར་བྱེད་པ་རྣམས་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པར་བརྟག་པར་བྱ་བའི་དོན་དག་གཅིག་ཏུ་བྱས་ནས་འཇུག་གོ།",
    "དེ་བཞིན་དུ་སྒྲས་དེ་བྱེད་པ་ཉིད་ཀྱིས་དེ་བྱེད་པ་མ་ཡིན་པ་དག་ལས་ལོག་པ་རྣམས་སྟོན་པར་བྱེད་དོ་ཞེས་བྲྗོད་དོ།",
    "དེ་ཁོ་ན་ཉིད་སེམས་པར་བྱེད་པ་རྣམས་ནི།",
    "སྣང་བ་ཐ་དད་པ་ལ་སོགས་པའི་སྒོ་ནས་ཐ་དད་པ་མེད་པར་མི་སེམས་སོ།་།",
    "གལ་ཏེ་རྟོགས་པ་པའི་བསམ་པའི་རྗེས་སུ་བྱེད་ན་གཞན་སེལ་བ་ཡང་སྤྱི་ཡིན་པར་འགྱུར་ཏེ།",
    "མི་སྣང་ན་ཇི་ལྟར་བདག་ཉིད་དུ་གཞན་འཛིན་པའམ་ཐ་སྙད་འདོགས་པར་བྱེད་དེ།",
    "དེ་དག་དང་འབྲེལ་པ་གཅིག་ཡོད་པའི་ཕྱིར་ཡང་སྤྱི་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "རྟེན་མེད་པར་སྐྱེ་ན་ནི་ཐམས་ཅད་ལ་འགྱུར་རོ་རྣམ་པ་གཅིག་ཏུ་ན་ཤེས་པ་གཅིག་དང་།",
    "དེའི་ཕྱིར་ཤེས་པ་གཞན་དང་བསལ་བ་གཞན་ལ་ཁྱད་པར་བྱེད་པ་མ་ཡིན་པ་ཇི་ལྟར་སྤྱི་ཡིན་པར་འགྱུར།",
    "བསྒྲུབ་པར་བྱ་བ་ཐ་མི་དད་པ་ཅན་གྱི་དངོས་པོ་རྣམས་དེའི་བསྒྲུབ་པར་བྱ་བ་ཅན་མ་ཡིན་བདག་ལས་ཤེས་བྱ་སྟེ།",
    "གཟུགས་ཀྱི་རྣམ་པར་ཤེས་པ་གཅིག་བསྐྱེད་པ་དེ་བཞིན་དུ།",
    "ཐ་དད་པ་ཁྱད་པར་མེད་ཀྱང་ཆུ་ལ་སོགས་པ་ནི་མ་ཡིན་ཏེ།་",
    "གཟུགས་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ལ་རྣ་བ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "དེར་ཁྱད་པར་མེད་ཀྱང་ཞོ་དང་ག་གོན་ལ་སོགས་པ་ལས་ནི་མ་ཡིན་ནོ།",
    "སྤྱི་ཁྱད་པར་མེད་ཕྱིར་སྤྱིས་འབྲས་བུ་དེ་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར།་།",
    "བུམ་པ་ལ་སོགས་པའི་ཁྱད་པར་དང་།",
    "སྤྱི་བརྟན་པས་ཕན་འདོགས་མེད་ཕྱིར་ཡང་གལ་ཏེ་འདིས་ཕན་འདོགས་པར་བྱེད་ན་ནི།",
    "དོན་ཐ་མི་དད་པ་འཛིན་པ་ལྟ་བུ་དོན་དམ་པར་ན་དེ་ལས་གཞན་པ་ལས་ཐ་དད་པ་དང་།",
    "དེ་ལ་དོན་གྱི་རྣམ་པ་ཡོད་པ་ནི་ཐ་སྙད་འདོགས་པ་རྣམས་དེ་ལྟར་ལྷག་པར་ཞེན་ནས་འཇུག་པའི་ཕྱིར།",
    "འགའ་ཞིག་ལས་ལོག་པར་སྣང་བའི་ཕྱིར་རོ།",
    "ཐ་མི་དད་པར་ཡང་སྣང་ངོ།",
    "དེའི་ཕྱིར་རྣམ་པར་རྟོག་པའི་ཡུལ་གྱི་དོན་རྣམས་ལ་དོན་བྱ་བ་བྱེད་པ་ཉིད་མེད་དོ།",
    "དེའི་ཁྱད་པར་མཐོང་བ་ལ་བརྟེན་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ལ་དུ་མ་དང་གཅིག་པ་དང་ཐ་དད་པར་འཛིན་པ་ནི་འཁྲུལ་པར་འགྱུར་ཏེ།",
    "དོན་གཅིག་དང་དུ་མ་བྱེད་པ་དེ་ལ་དེ་ལྟར་ཤེས་པར་འདོད་ན་དེ་ལྟ་བུའི་ངོ་བོ་བསྟན་པའི་ཆེད་དུ་དེ་ལྟར་གཞག་པར་བྱས་པའི་ཕྱིར་རོ།",
    "དངོས་པོའི་ཁྱད་པར་གྱི་སྒོ་ནས་ནི་མ་ཡིན་ཏེ།་",
    "སྒྲའི་དོན་དངོས་པོ་ཇི་ལྟ་བ་བཞིན་ཡིན་པར་ཁས་ལེན་ན་གཞི་མཐུན་པ་ཉིད་མི་རུང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱད་པར་དེ་དག་དང་ལྡན་པ་གཅིག་བྲྗོད་པའི་ཕྱིར།",
    "འཛིན་པ་ལ་དེ་ལྟ་བུའི་ཁྱད་པར་ཐ་དད་པ་དང་ལྡན་པ་གཅིག་པུ་མི་སྣང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱད་པར་དེ་དང་ལྡན་པ་ཕན་པར་བྱ་བ་དང་།",
    "ཕན་པར་བྱེད་པ་དག་ཀྱང་ལྷན་ཅིག་གནས་པའི་ཕྱིར་ཉེས་པ་མེད་དོ་ཞེ་ན།",
    "དེ་ལས་གཞན་པ་དོན་མེད་པར་ཡང་མི་འགྱུར་ཏེ།་",
    "སྒྲའི་དོན་ཐ་དད་པ་བསྒྲུབ་པ་དག་ཀྱང་ཐ་མི་དད་པར་བློ་ལ་སྣང་བས་སྤྱི་དང་ཁྱད་པར་དང་ཁྱད་པར་གྱི་གཞིའི་དངོས་པོ་དང་།་",
    "ཅན་གྱི་ཁྱད་པར་དག་ཀྱང་དོན་དུ་མ་ལས་ཐ་དད་པ་ལ།",
    "ཐ་དད་པ་དེ་ལྟ་བུ་མང་པོ་བྲྗོད་པས་ཚིག་ཐ་དད་པ་དང་བསྒྲུབ་པར་བྱ་བ་དང་།་",
    "དེ་ཉིད་གཞན་ལས་ལོག་པར་ཡང་།",
    "འཁྲུལ་པར་འདྲ་ཡང་གཞན་ལ་མིན།",
    "ཐ་དད་རབ་ཏུ་འཇུག་པར་བྱེད།",
    "མཁས་པ་རྣམས་ཀྱིས་བྱས་པ་ཡིན།",
    "དེ་སྤྱི་ཁྱད་པར་ཞེས་བྱ་བའི།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པར་རྟོགས་པ་ལ།",
    "ཁྱད་པར་སྤྱི་དང་འདྲེས་པ་འདིར།",
    "དེ་ནི་སྤྱི་དང་ཁྱད་པར་གྱི།",
    "བྱེ་བྲག་ཁྱད་པར་མང་པོ་རྣམས།",
    "དེ་ནི་ཐ་སྙད་ཆེད་དུ་བྱས།",
    "སྒྲ་རྣམས་ཀྱིས་ནི་བརྡར་བཏགས་པའི་དོན་རབ་ཏུ་སྟོན་པར་བྱེད་ལ།",
    "བརྡ་ཡང་ཅི་ནས་ཀྱང་དུས་ཕྱིས་བརྡར་བྱས་པའི་སྒྲ་འདི་ལས་དོན་འདི་རྟོགས་པར་འགྱུར་སྙམ་ནས་ཐ་སྙད་ཀྱི་དོན་དུ་འདོགས་ན།",
    "འོ་ན་ཅི་ཐ་དད་པའམ་ཐ་མི་དད་པ་ཁྱད་པར་ཞིག་སྒྲ་རྣམས་ཀྱིས་བྲྗོད་དེ།",
    "ཅི་ལྟར་སྐྱེས་བུ་དོན་བྱེད་པར།",
    "འཇུག་པར་འགྱུར་ཞེས་དོན་རྣམས་ལ།",
    "རྗོད་པར་བྱེད་པ་སྦྱོར་བར་བྱེད།",
    "བྱེད་དུ་གཞུག་སྦྱོར་བ་ལ་གུས་པར་འགྱུར་བའི་སྒྲ་རྣམས་སྦྱར་བར་བྱའོ།་།",
    "དེ་ལྟ་བུའི་སྐབས་མེད་པར་འཇིག་རྟེན་ན་ཐ་སྙད་དག་ལ་སྒྲ་སྦྱོར་བ་ཡང་མེད་དོ།",
    "གལ་ཏེ་གསལ་བར་བསྟན་པར་མི་ནུས་པའི་ཕྱིར།",
    "མཚོན་ཟིན་པས་མཚོན་པར་བྱ་བའི་རིགས་བྲྗོད་དོ་ཞེ་ན།",
    "འབྲེལ་པ་ཡིན་དུ་ཟིན་ཀྱང་སྒྲས་མ་བྲྗོད་པ་ལ་ཇི་ལྟར་འཇུག་པར་འགྱུར་ཏེ།",
    "སྤུན་དྲུང་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲ་རྣམས་ནི་འབྲེལ་པ་ཅན་གྱི་སྒྲ་ཡིན་པའི་ཕྱིར་གཞན་འཕེན་པར་འགྱུར་གྱི།",
    "བ་ལང་ཉིད་ལ་སོགས་པའི་སྒྲ་ནི་དེ་ལྟར་འབྲེལ་པ་ཅན་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "འོ་ན་ནི་དུས་ཐམས་ཅད་དུ་བ་ལང་ཞེས་བྱ་བའི་སྒྲ་ལས་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "ལྷན་ཅིག་པ་དང་ལྷན་ཅིག་པ་མ་ཡིན་པའི་གནས་སྐབས་དག་ཏུ་ཁྱད་པར་དུ་མ་འཕངས་པའི་ཕྱིར་རོ།",
    "འོ་ན་ནི་དེ་ཡང་དེའི་ཁྱད་པར་ཉིད་དུ་གནས་པས་བསལ་བ་འཕངས་པ་ཁོ་ནའི་ཕྱིར་དེ་དང་ལྡན་པ་བྲྗོད་པར་བྱ་བ་ཡིན་པར་འགྱུར་རོ།",
    "ཕན་ཚུན་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་ཕན་འདོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་མཚོན་པར་ཡང་རིགས་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འདི་སྙམ་དུ་བསལ་བ་རྣམས་ནི་མཐའ་ཡས་པའི་ཕྱིར་སྒྲས་བྲྗོད་པར་མི་ནུས་སོ་སྙམ་དུ་སེམས་ན།",
    "རིགས་ཀྱི་ཁྱད་པར་དུ་བྱས་པའི་བསལ་བ་དག་ཀྱང་བྲྗོད་པར་བྱ་བ་ཁོ་ན་ཡིན་པས་འབྲེལ་པ་མ་བྱས་པ་ཅན་ནི་བྲྗོད་དུ་མི་རུང་བའི་ཕྱིར་གདོན་མི་ཟ་བར་དེ་ལ་འབྲེལ་པ་བྱ་དགོས་ན་དེ།",
    "གལ་ཏེ་དེ་དང་འབྲེལ་པ་ཅན་ལ་བྱས་པའི་ཕྱིར།",
    "དེ་ལ་ཡང་བྱས་པ་ཁོ་ན་ཡིན་ནོ་ཞེ་ན།",
    "འབྲེལ་པ་ཡོད་དུ་ཟིན་ཀྱང་གཅིག་ལ་བྱས་པས་གཞན་ལ་རྟོགས་པ་ནི་མེད་ལ།",
    "ལོག་པར་མཚུངས་པ་ཅིས་མ་བྱས།",
    "གལ་ཏེ་འདི་སྙམ་དུ་སྒྲའི་དོན་དེ་ལས་གཞན་པ་ལས་ལྡོག་པ་ལ་ཡང་ལྡོག་པས་ཁྱད་པར་དུ་བྱས་ཤིང་དེ་དང་ལྡན་པ་བྲྗོད་པའི་ཕྱིར་དེའི་ཕྱོགས་ལས་ཁྱད་པར་མེད་དེ།་",
    "རིགས་དང་ལྡན་པ་ཞེས་བྱ་བ་འདི་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་སྙམ་དུ་སེམས་ན།",
    "གཅིག་ལས་ཐ་དད་པ་དེ་ལས་གཞན་པ་རྣམས་ཀྱི་ཐ་མི་དད་པ་དེ་ཉིད་དེས་ཁྱད་པར་དུ་བྱས་པའི་དོན་རྣམས་ལ་རྟོགས་པར་འགྱུར་ཏེ།",
    "འདི་དོན་རྣམས་ལ་སྒྲ་སྦྱོར་བ་ན་མི་འདོད་པ་ཡོངས་སུ་སྤངས་ནས་འཇུག་པར་འགྱུར་སྙམ་ནས་སྦྱོར་ཏེ།",
    "བྲྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་གདོན་མི་ཟ་བར་རྣམ་པར་བཅད་པ་བྲྗོད་དགོས་སོ།",
    "དེ་ངེས་པར་ཁས་བླང་བ་ཅན་དང་།",
    "རྣམ་པར་གཅོད་པར་མི་བྱེད་པ་ནི་མ་ཡིན་གྱི་འཇུག་པའི་ཡུལ་བྲྗོད་པས་རིགས་སྨྲས་སོ་ཞེ་ན།",
    "དེ་སྐད་ནི་སྨྲས་ན་རིགས་པར་ནི་མ་སྨྲས་ཏེ།",
    "འདི་ལྟར་དེ་ནི་འཇུག་པར་རུང་བ་ཉིད་མ་ཡིན་ནོ་ཞེས་དེ་སྐད་དུ་བསྟན་ཟིན་ཏོ།",
    "དེ་དང་ལྡན་པ་དག་ཡིན་པར་ཅི་སྟེ་མི་འདོད།",
    "དེ་ནི་ལྡོག་པ་དང་ལྡན་པར་ཡང་མཚུངས་སོ།",
    "གལ་ཏེ་དངོས་པོ་ལས་སྐྱེ་བའི་ཕྱིར་མི་འཁྲུལ་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་མི་སྣང་བ་དེར་ལྷག་པར་ཞེན་པའི་ཕྱིར་དང་།",
    "འཁྲུལ་པའི་མཚན་ཉིད་ནི་ལོག་པར་སྣང་བ་ཡིན་ལ།",
    "དངོས་པོ་ལ་ངོ་བོ་ཇི་ལྟ་བ་བཞིན་སེམས་གཏད་པས་འཇུག་ན་ནི་གཟུང་བར་བྱ་བ་སྤྱི་དོན་བྱེད་པར་རུང་བ་མ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལ་ནི་འཇུག་པར་མི་འགྱུར་རོ།",
    "འདྲེས་པར་སྣང་བའི་བློས་འཇུག་པར་བྱེད་དོ་ཞེ་ན།",
    "རིགས་ཀྱང་མ་ཡིན་ལ་དེ་དང་ལྡན་པ་ཡང་མ་ཡིན་པས་གཞན་གྱི་སྨྲ་བ་ཁོ་ན་ལ་བརྟེན་པར་འགྱུར་རོ།",
    "ཞེས་ངོ་ཤེས་པར་ཡང་མི་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་བློ་ཁྱད་པར་ཅན་བསྲེ་བ་ཅན་དུ་མི་འགྱུར་ཏེ།",
    "དེ་བས་ན་གཅིག་ཅིག་ཏུ་མ་མཐོང་བ་ལ་ཡང་ཁྱད་པར་བསྲེ་བ་དང་ལྡན་པར་རིགས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་གང་དེ་ལྟར་ཤེས་པར་འགྱུར་བ་གཞན་སྤྱི་ནི་ཅུང་ཟད་ཀྱང་མེད་པ་ཁོ་ནའོ།",
    "འོན་ཏེ་ཡོད་ན་ནི་དོན་ཡོད་པ་འཛིན་པའི་བློ་འཁྲུལ་པར་མི་འགྱུར་རོ།",
    "དེས་རྣམ་པ་གང་ཁོ་ན་སྒྲོ་འདོགས་པར་བྱེད་པ་དེ་ཉིད་འདིའི་ཡུལ་ཡིན་ནོ།",
    "ཡུལ་དུ་མ་བྱས་པ་ལ་ནི་སྒྲོ་གདགས་པར་མི་ནུས་པའི་ཕྱིར་ཏེ།",
    "སྤྱི་འདོད་པས་ཀྱང་གདོན་མི་ཟ་བར་བསལ་བ་རྣམས་ཀྱི་དོན་གཅིག་བསྐྱེད་པའི་ནུས་པ་ནི་འདོད་པར་བྱ་དགོས་སོ།",
    "གལ་ཏེ་དངོས་པོ་ཇི་ལྟ་བ་བཞིན་ཁྱད་པར་མ་འདྲེས་པ་ཅན་ཁོ་ན་ཅི་སྟེ་མི་རྟོགས་ཤེན།",
    "མ་རིག་པའི་མཐུས་རྣམ་པར་རྟོག་པ་རྣམས་ལ་ནུས་པ་འདི་མེད་དོ།"
  ]
}