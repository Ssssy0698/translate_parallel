    "དགའ་བྱེད་རྒྱལ་བའི་སྐུ་གཟུགས་བསྟན་བྱས་ཤིང་།",
    "འདུས་བྱས་རྟག་ཏུ་བདེ་བ་མེད་པ་སྟེ།",
    "ཁྱད་པར་ལྡན་པའི་འོད་ཟེར་རབ་གཏོང་ཞིང་།",
    "ཏིང་འཛིན་ཁྱད་པར་ཤེས་རབ་ཁྱད་པར་ཐོས།",
    "དེས་ན་ཁྱད་པར་ལྡན་པའི་འོད་གྲུབ་བོ།",
    "རིན་ཆེན་བཀོད་པའི་འོད་ཟེར་གྲུབ་པར་འགྱུར།",
    "བྱས་པས་སྤོས་རབ་སྣང་བ་དེ་གྲུབ་བོ།",
    "དེས་ན་སྣ་ཚོགས་བཀོད་པ་གྲུབ་པར་གྱུར།",
    "ས་རྣམས་ལག་འཐིལ་བཞིན་དུ་གནས་པར་བྱེད།",
    "མཆོད་རྟེན་དྲང་སྲོང་གནས་རྣམས་སྦྱངས་བྱས་པས།",
    "གཅེར་བུ་གོས་ཡོང་རྒྱན་དང་ལྡན་པར་འགྱུར།",
    "སྦྱིན་པ་བྱས་པས་ལྷབ་ལྷུབ་བཀོད་པ་གྲུབ།",
    "བཀྲེས་པ་ཁ་ཟས་རོ་མཆོག་ཐོབ་པར་འགྱུར།",
    "དབུལ་བ་བྱས་པས་ནོར་སྟོན་འོད་ཐོབ་བོ།",
    "རྣ་བ་ཉམས་པས་སྒྲ་མང་ཐོས་པར་འགྱུར།",
    "འཇམ་པར་སྨྲས་པས་ལྕེ་སྦྱོང་འོད་ཟེར་གྲུབ།",
    "སྨྱོས་པ་ཐམས་ཅད་སེམས་དང་ལྡན་པར་འགྱུར།",
    "མཆོད་རྟེན་བརྒྱན་བྱས་གཟུགས་སྦྱོང་འོད་གྲུབ་བོ།",
    "སྒྲ་ནི་སྒྲ་མི་སྟོང་པར་རབ་ཏུ་ཤེས།",
    "ཕོངས་པར་གྱུར་པ་རྣམས་ལ་དེ་དག་མེད།",
    "སྟོང་གསུམ་ཚད་ཙམ་བྱིན་གྱིས་བརླབས་བྱས་ནས།",
    "ཏིང་འཛིན་རྣམ་པར་འཕྲུལ་པ་འདི་འདྲའོ།",
    "འཁོར་དང་བཅས་པ་བྱིན་གྱིས་བརླབས་བྱས་ཤིང་།",
    "དེ་དག་ཏིང་འཛིན་ཏིང་འཛིན་མེད་པར་གནས།",
    "གང་དག་ཏིང་འཛིན་གནས་པར་རབ་ཞུགས་པ།",
    "ཏིང་འཛིན་རྣམ་པར་འཕྲུལ་པ་འདི་འདྲའོ།",
    "ནུབ་ཀྱི་ཕྱོགས་ནས་དཔའ་བོ་རྣམ་པར་ལྡང་།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་མཉམ་པར་བཞག་གྱུར་ཅིང་།",
    "གཞན་གྱི་ཕྱོགས་སུ་མཉམ་པར་བཞག་གྱུར་ལ།",
    "ཞི་བའི་ཏིང་ངེ་འཛིན་ལ་གནས་པར་སྣང་།",
    "ཕྱོགས་དེར་མཉམ་པར་བཞག་པར་བསྟན་བྱས་ནས།",
    "དཔའ་བོ་ནུབ་ཀྱི་ཞིང་རྣམས་མ་ལུས་པར།",
    "རྣམ་པར་ལྡང་ཞིང་མངོན་སུམ་རྒྱལ་ཀུན་ལ།",
    "ཞི་བའི་ཏིང་ངེ་འཛིན་ལ་གནས་པར་སྣང་།",
    "ཕྱོགས་དེར་མཉམ་པར་བཞག་པར་བསྟན་བྱས་ནས།",
    "དཔའ་བོ་ཤར་གྱི་ཞིང་རྣམས་མ་ལུས་པར།",
    "རྣམ་པར་ལྡང་ཞིང་མངོན་སུམ་རྒྱལ་ཀུན་ལ།",
    "དེ་ལ་ལྷར་བཅས་འཇིག་རྟེན་རྨོངས་པར་འགྱུར།",
    "གཟུགས་ཀྱི་ལམ་ལ་མཉམ་པར་བཞག་གྱུར་ལ།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་རབ་སྟོན་ཅིང་།",
    "སྒྲ་ཡི་ལམ་ལ་མཉམ་པར་བཞག་གྱུར་ཅིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་རབ་སྟོན་ཅིང་།",
    "རྣ་བའི་ལམ་ནས་དྲན་ལྡན་རྣམ་པར་ལྡང་།",
    "དྲི་མཆོག་དམ་པ་འཇུག་པར་རབ་ཏུ་ཞུགས།",
    "དྲི་ཡི་ལམ་ལ་མཉམ་པར་བཞག་གྱུར་ཅིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་རབ་སྟོན་ཅིང་།",
    "སྣ་ཡི་ལམ་ནས་དྲན་ལྡན་རྣམ་པར་ལྡང་།",
    "རོ་མཆོག་ཀུན་གྱི་ལམ་ནས་རྣམ་པར་ལྡང་།",
    "རོ་མཆོག་རྣམས་ལ་མཉམ་པར་བཞག་གྱུར་ཅིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་རབ་སྟོན་ཅིང་།",
    "ལྕེ་ཡི་ལམ་ནས་དྲན་ལྡན་རྣམ་པར་ལྡང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་རབ་སྟོན་ཅིང་།",
    "ལུས་ཀྱི་ལམ་ནས་དྲན་ལྡན་རྣམས་པར་ལྡང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་རབ་སྟོན་ཅིང་།",
    "སེམས་ཀྱི་ལམ་ནས་དྲན་ལྡན་རྣམ་པར་ལྡང་།",
    "རྒས་ཤིང་འཁོགས་པའི་ལུས་ལས་རྣམ་པར་ལྡང་།",
    "དགེ་སློང་མ་ཡི་ལུས་ལས་རྣམ་པར་ལྡང་།",
    "སློབ་དང་མི་སློབ་ལུས་ལས་རྣམ་པར་ལྡང་།",
    "ལྷ་ཡི་ལུས་གཟུགས་ལས་ནི་རྣམ་པར་ལྡང་།",
    "འཕྲུལ་ཆེན་གནོད་སྦྱིན་ལུས་ལས་རྣམ་པར་ལྡང་།",
    "འབྱུང་པོ་ཀུན་གྱི་ལུས་ལས་རྣམ་པར་ལྡང་།",
    "སྤུ་ཡི་སྒོ་གཅིག་ནས་ནི་རྣམ་པར་ལྡང་།",
    "སྤུ་སྒོ་གཅིག་ལ་མཉམ་པར་བཞག་གྱུར་ཅིང་།",
