    "དོན་གོལ་སར་གདའ་ན་བཟོད་པར་བཞེས།",
    "ཁོ་བོ་མྱུར་དུ་རྒྱ་གར་ལ་འགྲོ་དགོས་པར་འདུག་གསུངས་པས།",
    "དྭ་ད་སྟེ་ང་རྒྱ་གར་དུ་འགྲོ་བ་ལ་རིངས་པས་འདིར་འདུག་ཏུ་མི་ཁོམ།",
    "ད་དུང་ལན་ཅིག་སྐུ་དྲུང་དུ་འོང་བའི་དམ་བཅའ་ཕུལ་བ་ཡིན་པས་ད་ལན་རྒྱ་བལ་དུ་འགྲོ་བ་གཤོལ་དུའང་བཏུབ་པ་མེད་ལམ་བར་གྱི་དཀའ་ལས་དང་འཇིགས་པ་དེ་རྣམས་ཀྱིས་མི་བརྫི་བའི་གདེང་ང་རང་ལ་ཡོད་ཅེས་རྒྱ་གར་ཕར་འབྱོན་གྱི་མགུར་གསུངས་པ།",
    "ད་ལྟ་མར་པ་ལོ་ཙཱ་བྱ་བར་བཏགས་ནས་འདུག་པ།",
    "དགེ་ཚུལ་བའི་གསུང་ནས་བུ་འོངས་ཙ་ན་ཕ་སྤྱོད་པ་ལ་གཤེགས་ནས་མི་བཞུགས་གསུང་བ་ལ་རྗེ་མར་པས།",
    "ཟེར་བའི་ཚིགས་སུ་བཅད་པ་ཞིག་བྲིས་ནས་འདུག།",
    "རྗེ་ལོ་ཙཱ་བ་ཆེན་པོ་ཉིད་གཅིག་པུར་དུར་ཁྲོད་དང་ནགས་ཚལ་ཐམས་ཅད་དུ་རྒྱུ་ཞིང་བཙལ་བས་ཟླ་བ་ལྔ་པ་ལ་ནགས་གསེབ་གཅིག་ཏུ་ཕེབས་ཙ་ན།",
    "དེར་གད་པའི་ངོས་ལ་ཀླད་ཁྲག་སྤྲུགས་པའི་ཟེར་མ་ཅིག་ཞིག་འཐོར་ནས་འདུག་པ་གསོལ་བས་དྲི་རོ་བཟང་པོ་དཔེ་མེད་པ་ཞིག་འདུག་སྟེ།",
    "སླར་ཏིང་ངེ་འཛིན་དེ་ལས་བཞེངས་ཏེ་བརྩོན་པ་ཆེན་པོས་རྗེ་བཙུན་ཚོལ་འཚོལ་དུ་གཤེགས་པས་ཟླ་བ་བདུན་པ་ལ་ནགས་གསེབ་ཞིག་ཅིག་ན་བྱེ་མའི་ངོས་ལ་ཞབས་ཀྱི་རྗེས་ལམ་མེར་བརྒྱབ་པའི་དཀྱིལ་ནས་པདྨ་དམར་པོ་ཁྲུ་གང་བ་ཅིག་ཞིག་སྐྱེས་ནས་འདུག་པ་དང་།",
    "གསེར་ཅུང་ཟད་ཀྱང་མ་གོད་པར་འདུག།",
    "ཁམས་གསུམ་གྱི་འདོད་ཡོན་ལ་འདིར་མ་ཚང་བ་མེད་དམ་སྙམ་པའི་འདོད་ཡོན་གྱི་ལོངས་སྤྱོད་ཟག་པ་དང་བྲལ་བ་མཛད་དུ་མེད་པས་བཀུར་སྟི་འབུལ་ཞིང་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་བསམ་གྱིས་མི་ཁྱབ་པས་མཆོད་ཅིང་བསྟོད་དེ་ཕྱག་དང་སྐོར་བ་བྱེད་ཅིང་འདུག་པ་དང་མཇལ་ཏེ་ཕྱག་མཛད་པའི་ཚེ།",
    "ནགས་ལྗོངས་ཞིག་ན་རྒྱ་གྲོ་དྷའི་སྡོང་པོ་གཅིག་པུ་ཞིག་འདུག་པའི་བསིལ་གྲིབ་ལ་གསོལ་བ་འདེབས་ཀྱིན་བཞུགས་པས།",
    "ཆུ་མིག་ཅིག་འདུག་པའི་སར་སྒུགས་ཀྱིན་བཞུགས་པས།",
    "ཇོ་བོ་ནཱ་རོ་པ་ཆེན་པོ་དེ་སྤྱོད་པ་ལ་གཤེགས་ནས་འདུག་པས་གདུང་བའི་སེམས་ལ་བཟོད་ཐབས་མེད་པ་བྱུང་སྟེ།",
    "དེ་ན་སྲིན་པོ་གདོང་ལ་ཁྲུ་གསུམ་ཙམ་ཡོད་པ་ཞིག་ཤི་ནས་འདུག་པའི་རོའི་དྲུང་ན་མི་མང་པོ་ཚོགས་ནས་ལྟ་ཞིང་།",
    "ཁྱེད་རང་རྣམས་ཕ་ཚད་དུ་རོ་འདི་ཤོང་བའི་དུར་བྲུས་ཤིག་གསུངས་ནས།",
    "ནངས་པར་མནལ་སད་ཙ་ན།",
    "མི་ང་རང་གང་ཡིན་ཟེར་ཙ་ན།",
    "དོན་འཁྲུལ་པར་གདའ་ན་བཟོད་པར་གསོལ།",
    "མི་ང་རང་མར་པ་ལོ་ཙཱ་འདི།",
    "ནང་རིག་པ་སེམས་ཀྱི་འདུག་ཚུལ་དེ།",
    "དེར་མུན་རུབ་མཚམས་ན་དུར་ཁྲོད་ཀྱི་མཐའ་ནས་ཅེ་སྤྱང་མང་པོ་འདུས་ཏེ་སྐད་དྲག་པོ་འབྱིན་ཅིང་འདུག་པས།",
    "ནངས་པར་མནལ་སད་ཙ་ན་སླར་རྒྱ་གར་དུ་ཟློག་དགོས་ད་དགོངས་པའི་ཐུགས་འདུན་ཀྱང་སངས་ནས་འདུག་པས།",
    "སྔར་མ་ཤར་བའི་ཉམས་ཤར་ནས་མནལ་སད་ཙ་ན་ནམ་ཀྱང་ཡང་ལངས་ནས་འདུག་སྟེ།",
    "ཁོང་དེར་ཚོགས་ཀྱི་རྣལ་འབྱོར་མཐོང་ཙ་ན།",
    "ནམ་ད་ནངས་གཉིད་དེ་སད་ཙ་ན།",
    "མི་བཅིང་རང་སོ་སོར་ལྷུག་པར་བཞག།",
    "མི་ང་རང་ལྟ་རྟོག་བྱེད་པའི་ཚེ།",
    "བཞི་གཞེས་ནིང་རྒྱ་གར་དུ་འགྲོ་ཙ་ན།",
    "ད་ལྟ་ལྷོ་བྲག་དྲོ་གྲོ་བོ་ལུང་བྱ་བ་ན་མར་པ་ལོ་ཙཱ་བྱ་བ་རྒྱ་དཀར་པོ་ལ་དཀའ་བ་དཔག་ཏུ་མེད་པ་སྤྱད་དེ་གསང་སྔགས་གསར་མའི་གདམས་ངག་ཕྱིན་ཅི་མ་ལོག་པ་བསྣམས་ནས་བྱོན་པ་ཞིག་ཡོད་པར་འདུག་པས།",
    "རྗེ་བཙུན་མར་པ་ཡང་རྩང་རོང་དུ་འབྱོན་པའི་དགོངས་པ་འདུག་པ་ན།",
    "བདག་བལ་ཡུལ་གྱི་ལམ་ལ་ཞུགས་ཙ་ན།",
    "ལམ་དེ་ཀུན་གྱི་བདེ་དོག་མཐོང་ཙ་ན།",
    "དུས་བསྐལ་པ་བཟང་པོར་འདུག་གོ་སྙམ།",
    "ཁོ་བོ་དེ་ནས་རྒྱ་གར་དུ་འགྲོ་ཙ་ན།",
    "གཅན་གཟན་གྱི་ངར་སྐད་ཐོས་ཙ་ན།",
    "དུས་དེ་ཡི་སྐྱིད་སྡུག་མཐོང་ཙ་ན།",
    "མི་ཁོ་བོའི་སྤྲོས་པ་དེ་ནས་ཆོད་། སླར་བོད་ཡུལ་དབུས་སུ་ལོག་ཙ་ན།",
    "གདམས་ངག་ཀྱང་ང་རང་ཆེའམ་སྙམ།",
    "ལམ་བལ་པོའི་མཐིལ་དུ་ཕྱིན་ཙ་ན།",
    "ཡར་བལ་བོད་མཚམས་སུ་ཐོན་ཙ་ན།",
    "ཡུལ་ལ་སྟོད་ཚོ་བཞིར་ཕྱིན་ཙ་ན།",
    "ང་ནི་ལས་འཕྲོ་མེད་པ་ཞིག་ཡིན་ནམ་འགྲོ་མི་ཐོན་པར་འདུག།",
    "མི་རྒན་ཕྲུ་སློག་པ་ཞིག་ལ་མི་ཀུན་ཕྱག་བྱེད་ཀྱིན་འདུག་པ་ལའང་རྟོག་པ་མ་ཞུགས་ནས།",
    "ཁོང་རང་ཡང་ཕྲུ་བྱེད་ཅིང་ཆང་འཐུང་ཞིང་འདུག།",
    "ཏོག་ཙེ་གཏད་དེ་ཁོང་རང་ནང་དུ་བཞུད།",
    "ད་ལོ་ཙཱ་བས་མཁར་མི་གཤིག་པར་འདུག་པས་ངེད་རང་རྣམས་དམག་བྱས་པ་དྲག་ཟེར་ནས་རྗེ་བཙུན་ལོ་ཙཱ་བ་ཆེན་པོའི་སྟེང་དུ་དམག་དྲངས་པས།",
    "རྗེ་མི་ལས་ཀྱང་ཚུར་ལམ་སེར་བས་བྱ་དང་བྱེའུ་མང་དུ་བསད་འདུག་པའི་རོ་རྣམས་འཐུ་ཞིང་བྱོན་པས།",
    "འོ་ན་ནམ་འགྲོ་རན་ཙ་ན་ལན་བྱེད་པས་དེའི་བར་ལ་དགེ་སྦྱོར་མཛོད་ཅིག་གསུངས་ནས་གཟིམས་ཁང་དུ་བཞུད།",
    "མཐུ་ཆེན་དེ་སྔར་ཆོ་ལོ་རྩེ་བ་ལ་དགའ་བ་ཞིག་ཡིན་པས་དིང་སང་མ་ཟུག་ནས་ཡོད་ཀྱང་སྲིད་པས་ཁོ་ལ་འདི་གཏོད་གསུང་ཡིན་གདའ་ཟེར་ནས་འཇིམ་པའི་ཆོ་ལོ་གཅིག་བུག་སྒོ་ན་ཚུར་གཏད་བྱུང་བས།",
    "ང་དྲོ་གྲོ་བོ་ལུང་གཅིག་པུ་ན་འདུག་པ་ཡང་མ་ཡིན།",
    "མཐུ་ཆེན་རང་ཡང་ཟོ་ཞིང་འཐུང་དང་འདི་དག་མིའི་ཁ་ཟས་སུ་མི་གདའ་ཡེ་ཤེས་ཀྱི་ཌཱ་ཀིའི་དངོས་གྲུབ་ཏུ་འདུག་གསུང་ནས་ཕྱེད་བསྒོས་མཛད་དེ་གནང་བྱུང་བ་གསོལ་བས།",
    "མིའི་བཟའ་བཏུང་ལས་འདས་པའི་དྲི་རོ་བཟང་པོ་དཔེ་མེད་པ་ཞིག་བྲོ་ཞིང་འདུག།",
    "གཞན་ལུས་ལམ་དུ་སློང་ཙ་ན།",
    "ནམ་ཞིག་ཙ་ན་རྒྱུད་ལས་སུ་རུང་བའི་དུས་ཤིག་འོང་བ་ཡང་སྲིད།",
    "དེ་བས་ཁྱེད་རང་རྣམས་ངའི་གླུ་འདི་ལ་ཉོན་དང་གསུངས་ནས་སྐུ་འཁོར་རྣམས་ལ་མགུར་གསུངས་པ།",
    "ང་རང་མར་པ་ལོ་ཙཱ་ལ།",
    "གཞན་ནས་ཚོལ་འཚོལ་བ་ལ་ཡང་ཉི་མ་ཕྱིས་ནས་འདུག་པས་སང་ནུབ་མཛད་ན་ཇི་ལྟར་ལགས་ཞུས་པས།",
    "རིགས་རྒྱུད་ནམ་མཁའི་མེ་ཏོག་ཡལ་། ཞེས་ལུང་བསྟན་པར་མཛད་པས་བུ་ཀུན་བརྒྱུད་པ་འཛིན་པ་ལ་ཕན་རིགས་སུ་མི་གདའ།",
