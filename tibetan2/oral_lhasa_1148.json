    "རྣམ་པར་ཆགས་པས་ནོར་ཀུན་ཉམས་པར་འགྱུར་ཞིང་།",
    "སྐུལ་བ་བ་དེའི་ཡོན་ཏན་གྱི་ཁྱད་པར་ནི།",
    "འོ་ན་རྒྱཆེ་བའགྲེལ་འདིའི་བརྗོད་པར་བྱ་བ་དུས་ཀྱི་འཁོར་ལོད་ཇི་ལྟ་བུ་ཞེན།",
    "དེབང་ང་ཡང་དག་པ་པར་བསྟན་ཏོ་ཞེས་དྲང་ངོ།",
    "ཁམས་གསུམ་གྱི་འཁོར་ལོས་སྒྱུར་བཞེས་པས་མཛདཔ་དང་།",
    "ལྡོད་བྱད་ཀྱི་ཚིག་ཚན་པར་ཡོངས་སུ་བཅད་པ་གཉིས་ཀ་ལའང་ལེལུའི་སྒྲ་འཇུག་གོ།",
    "དེ་བསྟན་འདིར་ཡང་རྩ་རྒྱུད་ཀྱི་བརྗོད་བྱ་རྭགས་པར་བསྡུས་ན་ལེའུའམ་བརྟག་པ་ལྔ་དང་།",
    "གལ་ཏེ་དེ་ལ་མ་གྲུབ་པར་རྡོ་རྗེའི་རྩལ་འབྱོར་གྱི་ལམ་བསྒྲུབ་པའི་ངང་ནས་ཚོའི་དུས་བྱས་ན།",
    "སྔ་སྔམའི་ལམ་ལ་གོམས་པར་བྱས་པ་དེའི་བག་ཆགས་ཀྱི་སྟོབས་ཀྱིས་ལམ་གོམས་པ་ར་བྱས་པས་མཆོག་འགྲུབ་པར་འགྱུར་བ་གཉིས་ཡོདཔ་གསུངས་པའི་ཕྱི་མའང་བསྡུ་བའི་ཆེད་དོ།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་དངོས་པོ་ལའང་གྲུབ་པ་ཞིག་དགོས་སོ།",
    "དེ་ལྟར་ལེའུ་ལྔ་པོ་དེ་ཉིད་ཞིབ་པར་ཕྱེ་ན།",
    "བསམ་པ་ལས་འདས་པ་སོགས་སུ་ཡང་ཡང་གསུངས་པ་དག་མི་འགལ་བའི་ཚུལ་ཇི་ལྟར་ཞེ་ན།",
    "དེ་དག་སྒྲའི་བརྗོད་བྱ་ཡིན་པ་དོན་དམ་པར་མགུས་པ་ལ་དགོངས་ནས།",
    "དེའི་ཕྱིར་སྒྲ་རྟོག་དང་བརྗོད་པརྣམ་པར་སྤངས་པ་སོགས་སུ་གསུངས་པ་ཡིན་ནོ།",
    "རྩ་བའི་རྒྱུད་ཡང་དག་པར་བསྟན་ཏོ་ཞེས་སྦྱར་རོ།",
    "དེ་དག་ལས་ཀྱི་ས་པ་མིན་པར་སྐྱེས་པའི་ཕྱིར་རོ།",
    "དེའང་ཉན་ཐོས་པར་དོར་འདའ་བ་ལྟ་བུ་ལ་དགོང་ཞེས་ཟེར་བ་ནི།",
    "ཞེས་ཁས་བླང་དགོས་པར་འགྱུར་རོ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་ལམ་བསྒོས་ན་མཆོག་འགྲུབ་པར་གསུངས་པ་ཡིན་གྱི།",
    "ཚོང་ལས་དང་པོ་ཐེས་མི་སྲིད་པར་བྱང་ས་ལས་གསུངས་པ་བཞིན་ནོ།",
    "དོན་ནི་དེ་བཟའ་བར་གསུངས་ཀྱང་།",
    "དེའི་ཤ་ལྡ་ནི་ཕྱུགས་ཀྱི་མཆོང་སྦྱིན་སོགས་ཀྱི་དོན་དུ་གསད་པར་བྱ་བའི་མཚན་མ་བཏབ་པ་དང་།",
    "ཟ་བ་པོ་དེ་ལས་རིན་ཐོབ་པའི་ཆེད་དུ་བསད་པ་ཁན་མཐོ་བ་དང་བཅས་པའི་ཤ་མིན་གྱིཟས་ཀྱི་དོན་དུ་ཉོ་བཙོང་མེད་པར་ཁྱིའི་ཤ་ལ་སོགས་པ་དར།",
    "ཕྱི་རོལ་བའི་འདོད་པར་བཀོད་ཅིང་།",
    "ད་ནིཤུན་སུམ་ཚོགས་པ་ལྔ་ལྡན་རྒྱས་པར་འཆད་པ་ལ།",
    "ཨེ་ཝཾ་གྱི་ངེས་དོན་བདེ་སྟོང་གཉིས་མེད་ཀྱི་ཡེ་ཤེས་ཉིད་ལ་བཞུགས་པའོ།",
    "ཕྱག་བྱས་པ་དེ་ཡིས་སོ་ཞེས་པའི་བར་ཏེ།",
    "རྗོད་བྱེད་ཀྱི་མཚན་གྱི་ཁྱད་པར་ནི།",
    "རྗོད་པར་བྱེད་པའི་ཕྱིརརོ།",
    "དེས་ན་དོན་དམ་པར་ཞེས་པ་ནི་གཉིས།",
    "མེད་དོན་དམ་པར་གྲུབ་ཅེས་པའམ།",
    "དོན་དམ་པར་གཉིས་མེད་ཀྱི་རྒྱུད་ཡིན་ཞེས་པ་མིན་ཞིང་།",
    "ཡང་བརྒྱུདམརྒྱུད་གཉིས་མེད་ཀྱི་རྒྱུད་གསུམ་ལ་དོན་ཐོག་འགལ་བ་ཐ་དདཔ་སོསོར་འཇོག་པའང་ཁས་བླངས་འགལ་ལ་ངེས་དོན་དང་དྲང་དོན་ཡང་སྒྲ་ཇ་བཞིན་པ་ཡིན་མན་ལ་བྱེད་པར་སྣང་བས།",
    "དེའི་ཕྱིར་མཚན་ཡང་དག་པར་བརྗོད་པས་འཁྱུང་བ་ཞེས་བྱའོ་ཞེས་པའོ།",
    "དེ་བཞིན་ནོ་ཞེས་པས་གསུམ་པ་དང་ཁྱད་མེད་པར་ཡང་བསྟན་པས་སྦས་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "བསྡུས་རྒྱུད་གཞན་ཐམས་ཅད་ཀྱི་དོན་རྒྱུད་འདིས་བར་དཔར་བྱ་ཞེས་པ་མིན་ནོ།",
    "སྟོང་པར་ཞེས་པས་སོ།",
    "ཅེས་དེ་ལྟར་བསྒོམས་ན་ཉིན་གཅིག་ལ་དུ་སོགས་ཀྱི་མཚན་མ་འཆར་བར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་ཕྱིར་རོ།",
    "སྟོང་གཟུགས་ཕྱག་རྒྱ་དང་མཉམ་པར་སྦྱར་བའི་གསང་བའི་རྡོ་རྗེ་བདྨ་ལ་བྱའོ།",
    "ལམ་དེ་གཉིས་བསྒོམས་པས་ཐོབ་པར་བྱ་བའི་འབྲས་བུ་དངོས་གྲུབ་གཉིས་རྣམས་སུ་བ་སྡུས་ནས་འཆད་དོ།",
    "གཞི་དུས་ཀྱི་ཕུང་སོགས་རྣམས་བསྐྱེད་རིམ་དང་རྫོགས་རིམ་པའི་རིམ་པས་བྱངཆབ་ལྔ་བོ་འདི་རྣམས་ཀྱི་སྒོནས་སྒྲིབ་བྲལ་དུ་ཡོངས་སུ་དག་པར་བྱེད་དོ།",
    "ཞེས་གསུངས་པས་སོ།",
    "དེ་འདྲ་ཡོད་ན་ཟླ་བ་གཅིག་ལ་ཚེས་ཞག་སོ་གཉིས་ཡོད་པར་འགྱུར་རོ།",
    "ཕྱིའི་ཚེས་ཀྱི་ཆ་བཅུ་དྲུག་པ་གཉིས་སུ་ཐ་སྙད་བྱས་པ་དག་དང་སྦྱར་བའོ།",
    "དེ་འཆད་པ་པོ་ལ་སོགས་མ་ལུང་བསྟན་པའི་ཚུལ་རྒྱས་པར་འཆད་པ་ནི།",
    "ཕྱག་ན་རྡོ་རྗེའི་སྤྲུལ་པའི་སྐུ་ཞེས་པ་མན་ཆད་ཀྱིས་རྩ་རྒྱུད་ཇི་ལྟར་གསུངས་པའི་ཚུལ་དང་།",
    "ལུང་བསྟན་པ་ལྟར་མཛད་ཚུལ་རྣམས་འཆད་པར་བྱེད་དོ།",
    "ཟླ་བཟང་དེས་སྤྲུལ་པ་ཡིན་པར་མ་ངས་པར་རྩོད་པ་ཡིན་གྱི།",
    "རྒྱུད་ཀྱི་གསོལ་བ་འདེབས་པ་པོར་འགྱུར་པར་ལུང་བསྟན་པའང་མེད་པས་དེའི་ཕྱིར་ཡང་ཞུ་བ་བོར་མི་རིགས་སོ།",
    "ཞེས་གསུངས་ངཔ་ལྟར་སྤང་བྱ་སེམས་ཀྱི་དྲི་མ་གང་འགག་པ་ལ་མངོན་དུ་ཕྱོགས་པ་དང་།",
    "དེའི་གཉེན་པོར་བར་ཆད་མེད་ལམ་སྐྱེས་པ་དུས་མཉམ་པར་གསུངས་པ་ལྟར།",
    "ཚུལ་འདི་ནང་ལ་རུང་ཡང་ཕྱིའི་བདུད་ཁོ་ན་ལ་བྱས་ན་མི་རུང་སྟེ།",
