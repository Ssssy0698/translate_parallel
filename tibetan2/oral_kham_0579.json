    "བེ་རོ་ཙ་ན་ལ་སོགས་པ་རྒྱལ་བློན་སྔ་དར་གྱི་དུས་སུ་བསྒྱུར་བ་ནས་བཟུང་སྟེ་པཎྜི་ཏ་སྨྲྀ་ཏིའི་བར་དུ་བསྒྱུར་བའི་རྒྱུད་ལ་རྙིང་མ་ཞེས་འདོད་ལ།",
    "དབྱིངས་འཇལ་བ་རླབས་ཆེ་ཆུང་ལྟར་འདུག་པ་ནི།",
    "འདུག་སྟངས་ཀྱི་ཁྱད་པར་སྐྱིལ་ཀྲུང་དང་།",
    "ཀུ་ཤའི་ཁྲི་ལ་འདུག་ནས་བཟླས་བརྗོད་བརྩམ།",
    "འབྲིང་རང་རྒྱལ།",
    "བེ་རོ་ཙ་ན་དང་།",
    "སྣང་ངོ་ཐ་དད་ལ་སྣང་ཡང་རང་བཞིན་རྣམ་དག་འཁོར་འདས་དོང་སྤྲུགས།",
    "དངོས་སྣང་རང་ཤར་བས་བློ་རྟོག་རང་གྲོལ་ཏེ།",
    "འགྱུ་བ་སྟོང་ཡལ་གྱི་གཏན་ཚིགས་ཀྱིས་མེད་སྣང་རང་དག་ཏུ་བསྒྲུབ་པའོ།",
    "མ་སྦྱངས་ཡེ་དག་མ་བསྒྲུབས་ཡེ་གྲུབ་ཏུ་འདུག་པས།",
    "ཁར་ཕོག་དུས་མེད་པའི་ཁ་གཏམ་ནི་དབྱིངས་རྒྱ་ཆེ་བའི་ངོས་ནས་གང་ཡང་མ་ཤོང་བ་མེད་པས་འཁོར་འདས་ཀྱི་ཁྱབ་བརྩི་བ་དང་།",
    "དབྱེ་ན་དངོས་པོ་འདུག་ཚུལ་གྱི་གེགས་བསལ་བ་དང་།",
    "དེ་དག་བེ་རོ་ཙ་ནས་བསྒྱུར་བའོ།",
    "འབྱུང་དང་འཇུག་དང་རང་ཤར་དང་།",
    "དེའང་རང་བྱུང་ཡེ་ཤེས་སྒྲིབ་པ་དང་བྲལ་བའི་མཐར་ཐུག་པའི་ཚེ་ཐོག་མའི་གྲོལ་ས་ཞེས་བརྗོད་པར་ཟད་ཀྱིས་ཐོག་མའི་གྲོལ་ས་སྒྲིབ་པ་དང་བཅས་པ་ཁམས་ཞེས་བྱ་བ་དྲི་མ་དང་བཅས་པས་དེ་བཞིན་ཉིད་ཡིན་ལ།",
    "དེའང་རང་རིག་འོད་གསལ་ཀུན་ཁྱབ་ཆེན་པོ་ནི་མཚོན་བྱའི་རྒྱུད་དེ།",
    "ཐབས་དང་རང་བཞིན་རྒྱུད་ཅེས་ནི།",
    "གཞན་ལས་མ་བྱུང་རང་ཤར་ཉིད།",
    "ང་རང་ཕེའོ་ལན་བྷིའི་ཞིང་གྲོང་ལ་རྒྱུས་མངའ་ཅུང་ཟད་ཡོད་པས་དེ་ལ་ཧ་ཅང་དགའ་བོ་ཡོད།",
    "སྐབས་དེར་ང་རང་ལོ་ན་དགུ་མ་གཏོགས་སོན་མེད་ལ་ཕུ་བོ་ཡང་ལོ་བཅུ་གསུམ་ཡིན།",
    "ང་རང་ཉིད་ཀྱང་ཆུང་དུས་ནས་སྙན་ངག་ལ་ཤིན་ཏུ་དགའ་བོ་ཡོད།",
    "སྙན་ངག་པ་འདི་དག་ལས་ང་རང་ཆེས་དགའ་ས་ནི་མེ་ཚི་ཁ་ཝེ་ཆི་དང་ཁི་རཱ་སིན་སི་ཁ།",
    "ང་རང་མུ་མཐའ་མེད་པའི་བདེ་ཐང་ལ་ནམ་ཡིན་ཡང་དུངས་པ་ཡལ་མ་མྱོང་།",
    "ཞིང་ར་ཆེན་པོ་འདིའི་སྔོན་ཐོན་གྱི་རྨོ་འདེབས་ལག་རྩལ་ནི་ས་ཆ་འདིའི་དཔེ་མཚོན་ཞིག་ཏུ་གྱུར་ཡོད་པ་དང་ང་ལ་མཚོན་ན་དེ་ལ་སྤྲོ་སྣང་ཆེན་པོ་འདུག་ཡུན་རིང་མ་འགོར་བར་ངས་རྨོ་འདེབས་ཀྱི་ལག་རྩལ་ཀྱང་ཤེས་ལ་རྒྱུན་པར་མྱུ་གུ་འབུས་རྗེས་ཀྱི་གནས་ཚུལ་ལ་དོ་སྣང་བྱས་ནས་བསྡད།",
    "ཚོད་ལྟ་ཕལ་ཆེར་ང་རང་གཅིག་པུས་བྱེད་བཞིན་ཡོད།",
    "༡༨༩༡ལོའི་ཟླ་༡༡པ་སྟེ་ང་རང་ལོ་ཉེར་བཞི་ལ་སོན་སྐབས་ལོ་མང་བོར་བཅངས་པའི་ཕུགས་བསམ་མངོན་དུ་གྱུར།",
    "ང་རང་གཅིག་པུས་ཁྱིམ་ལས་ཚང་མ་ལས་པ་ཡིན་ལ་མི་གཞན་པའི་རོགས་རམ་ཅུང་ཙམ་ཡང་བྱས་མ་མྱོང་།",
    "ཐ་ན་རྡོ་སོལ་ལེན་དགོས་ནའང་ང་རང་གཅིག་པུ་ཁང་བརྩེགས་དྲུག་པའི་བར་དུ་ཡར་རྒྱུག་མར་རྒྱུག་བྱས་ནས་བླངས་པ་ཡིན།",
    "ང་ལ་ས་ཆ་དེར་ཉེ་དུ་མེད་ལ་གྲོགས་པོ་ཡང་མེད་ནའང་ང་རང་སེམས་ཤུགས་ཆག་འགྲོ་བའི་གནས་སུ་ལྷུང་མ་མྱོང་།",
    "ང་རང་ཕོའོ་ལན་བྷིའི་ཕྱི་སྡོད་རིགས་གཅིག་སྤུན་ཟླའི་རྩ་འཛུགས་ཤིག་དང་འབྲེལ་བ་ཤིན་ཏུ་ཟབ་པས།",
    "སྦྱངས་འབྲས་འདི་ཚོ་ལ་ང་རང་ཤིན་ཏུ་ཡིད་ཚིམ་ཡོད།",
    "དུས་དེར་ང་རང་གཅིག་པུ་གཉིད་ཆག་ཟས་བརྗེད་ཀྱིས་ཚོད་ལྟ་ལ་ཞུགས་པ་དང་།",
    "ཁོ་རང་ལོ་སོ་དྲུག་ལ་ཐོན་དུས་རྒྱལ་ཁབ་ཕྱི་ནང་ཀུན་ཏུ་སྐད་གྲགས་ཆེ་བའི་དངོས་ལུགས་རིག་པ་བ་ཞིག་ཏུ་གྱུར།",
    "ཁོ་རང་རྒན་ལ་གུས་ཞེན་ཆེ་བའི་མི་ཞིག་ཡིན་ལ།",
    "ཁོའི་ཕ་ལགས་ནི་ཉམས་མྱོང་ཕུན་སུམ་ཚོགས་པའི་དངོས་ལུགས་རིག་པ་བ་ཞིག་ཡིན་པ་དང་ཁོག་རྒྱ་ཆེ་ཞིང་རང་ཚུགས་ཡོད་པའི་མི་ཞིག་ཡིན།",
    "སྙིགས་རོ་དེ་དག་ངའི་སྒོ་འགྲམ་དུ་སྐྱེལ་ཡོང་དུས་ང་རང་ཧ་ཅང་དགའ་ནས་གནམ་ལྡིང་ས་ལྡིང་བྱས།",
    "ཁང་བ་དེའི་ཐོག་ན་ཤེལ་གྱི་སྒེའུ་ཁུང་ཆེན་པོ་ཞིག་ཡོད་ལ་དེ་ལ་གས་སྲུབས་མང་བོ་ཤོར་འདུག་ཤིང་ཁང་དེའི་ནང་དུ་དབྱར་ཁ་ཚ་བ་ཆེ་ལ་དགུན་ཁ་འཁྱགས་ནས་མི་བཟོད་པས།",
    "དུས་རྒྱུན་དུ་ཚོད་ལྟ་བྱེད་སྐབས་ཤིང་ཁང་ནང་དུ་དུག་རྫས་ཀྱི་དྲི་མ་སྣ་ཚོགས་འཐུལ་བཞིན་འདུག་ཆ་རྐྱེན་འདི་འདྲའི་ཐབས་སྡུག་ཡིན་ན་ཡང་ངེད་གཉིས་ཀྱི་གོམ་ཁ་མ་ལྷོད་པར་ཚོད་ལྟའི་བྱ་བའི་ཐོག་ལ་ཤུགས་བརྒྱབ་ནས་འབྲས་བུ་ཐོབ་རག་བར་དུ་འབད་བརྩོན་བྱས་པ་ཡིན།",
    "ལ་མཇུག་ཏུ་ཕེ་ཁེ་ལིར་དང་ཝཱིར་ངེད་གསུམ་པོ་ལ་དངོས་རྫས་ཀྱི་འཕྲོ་གཏོང་རང་བཞིན་དང་འཕྲོ་གཏོང་ཅན་གྱི་གཞི་རྒྱུ་གསར་བ་དེ་གསར་རྙེད་བྱུང་བའི་ནོའོ་བྷེལ་དངོས་ལུགས་རིག་པའི་བྱ་དགའ་ཐོབ།",
    "གོད་ཆགས་དང་རྐྱེན་ངན་འདིས་ང་རང་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོར་ལྷུང་དུ་བཅུག་ནས་འཚོ་བ་ལ་གདོང་གཏད་བྱེད་ཐབས་བྲལ།",
    "ངས་ད་དུང་རང་ཉིད་ལ་འགན་འདི་འདྲ་ཞིག་དང་དུ་ལེན་པའི་འཇོན་ཐང་ཡོད་མེད་མི་ཤེས་རུང་།",
    "ཡིན་ནའང་ང་རང་ཉིན་དཀར་ལས་ཚོགས་སུ་ཞུགས་དགོས་ཕྱིར།",
    "ངས་ནམ་རྒྱུན་ཉལ་ཁྲིའི་འགྲམ་ནས་ཁོར་འདུག་རོགས་བྱས་པ་དང་ཁོའི་འདས་དོན་གླེང་བ་ལ་ཉན་ནས་བསྡད།",
    "ང་རང་ཉིད་ཀྱི་ལྟ་བ་ཡིན་ན།",
    "ཝེར་ལགས་གཟེངས་རྟགས་དང་མཚན་སྙན་སོགས་ལ་སྤྲོ་སྐོར་ལ་དོ་སྣང་ཆེན་པོ་བྱེད་ཀྱིན་འདུག་མི་རྣམས་ཀྱིས་ཚན་རིག་གླིང་སྣང་ཅི་ཡང་མེད་པས་དང་ལེན་མ་བྱས་པ་ཡིན།",
    "དེ་བས་ང་རང་དེ་མ་ཐག་རྨས་མ་མྱུར་སྐྱོབ་ཀྱི་ལས་ཀ་འདི་ལ་ཡིན་པ་ཤེས་ཐུབ།",
    "ཉིན་འགའི་རྗེས་ཀྱི་ཟུར་ཁྲིད་མཇུག་རྫོགས་རྗེས་ཁོ་ཚོས་སྒྲིག་ཆས་འདི་དག་བེད་སྤྱོད་གཏོང་ཤེས་འདུག་ལ་ལག་ལེན་བྱེད་ཐུབ།",
    "དེ་བས་ང་རང་དམག་འཁྲུག་ལ་ཧ་ཅང་སྡང་།",
    "ལས་རོགས་པའི་ལུས་ཕུང་མི་བདེ་བས་རྒྱུན་དུ་ན་རྒྱུ་འདུག་ཁང་ཁྱིམ་གསར་བར་སྤར་རྗེས།",
    "ང་རང་ལ་མཚོན་ན།",
    "ཀུན་ནས་འབྲལ་མི་ཕོད་པ་འདུག་ལ།",
    "ཁོ་ཚོས་ང་རང་ཕེབས་པར་དགའ་བའི་རྣམ་འགྱུར་དེ་དག་དང་།",
    "གཟེངས་རྟགས་དང་མཚན་སྙན་འདི་དག་ལ་བརྩེ་སེམས་མི་དམན་པ་འཁོར་འདུག་པས་ངས་དེ་ལ་བརྩི་འཇོག་དང་བརྩི་མཐོང་ཆེན་པོ་བྱེད་ཀྱིན་ཡོད།",
    "ཐེངས་འདིར་ཨ་རི་ལ་བསྐྱོད་པའི་ཁྲོད་ང་རང་ཆེས་ཡིད་ཕངས་པ་ཞིག་ནི་ཚན་རིག་ཚོད་ལྟ་ཁང་དང་ཞིབ་འཇུག་གླིང་སོ་སོར་ལྟ་སྐོར་དུ་འགྲོ་རྒྱུའི་དུས་ཚོད་མ་བྱུང་བ་དེ་ཡིན།",
    "ཚོད་ལྟ་ཁང་ཁ་ཤས་ལ་ལྟ་སྐོར་བྱེད་དུས་སྙན་གྲགས་ཕྱོགས་སུ་ཁྱབ་ཅིང་ཞིབ་འཇུག་བྱ་བའི་ཐད་ལ་གྲུབ་འབྲས་མི་དམན་པ་བཞག་ཡོད་པའི་ཨ་རིའི་ཚན་རིག་པ་འགའ་ལ་ངོ་ཐུག་དེ་བས་ང་རང་སེམས་རབ་ཏུ་སྤྲོ།",
    "ཐེངས་འདིའི་ཨ་རི་ནས་གང་སར་ལྟ་སྐོར་ལ་ཕྱིན་པའི་སྐབས་སུ་ང་རང་གཏེར་ཁ་ལེན་སའི་བཟོ་གྲྭའི་ནང་ལྟ་སྐོར་དུ་ཕྱིན་པ་ཡིན།",
    "ང་རང་གཞི་རྒྱུ་ལེན་སའི་བཟོ་གྲྭ་འདི་དག་དང་བཟོ་གྲྭ་དེའི་ཟུར་བཀོད་ཀྱི་ཚོད་ལྟ་ཁང་དུ་ལྟ་སྐོར་ལ་འགྲོ་སྐབས་ཁོ་ཚོས་ང་ལ་དགའ་བསུ་ཆེན་པོ་བྱས་པ་དང་སྣེ་ལེན་གང་ལེགས་བྱས།",
    "ཁོ་རང་དེ་ལ་སྤྲོ་བ་མ་བྱུང་།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱིས་དངོས་སུ་ལེ་ནཱ་དང་ཨེར་ཧྥུ་གཉིས་ཀ་གཉིད་སྐྱིད་པོ་ལོག་ཡོད་པ་དང་།",
    "༡༩༦ལོའི་འདས་ལོག་དུས་ཆེན་ལ།",
    "ཁོ་རང་འདི་འདྲའི་ལྷིང་འཇགས་ཀྱི་འདུ་འཛོམས་ལ་སྤྲོ་སྣང་ཡོད་དེ་ཁོ་ཚོས་དེ་ན་སོར་པུན་གྱི་ཞིབ་འཇུག་དང་ཆེད་ལས་སོགས་གླེང་བཞིན་ཡོད།",
    "སྒོ་ལ་བཞག་འདུག་པས་ཆར་བས་ཤིང་རྟའི་འཁོར་ལོ་སྟེང་དུ་ཆགས་ཡོད་པའི་ཁྲག་ཚང་མ་ག་ལེ་ག་ལེར་བཀྲུས་ཚར།",
    "ཁྱིམ་ན་དུས་རྒྱུན་དུ་གློག་སྒྲོན་གསལ་འདུག་དགུན་ཁར།",
    "དེ་དག་ལ་ན་གཞོན་གྱི་གཟི་མདངས་ཤིག་ཤར་འདུག་དེ་བས།",
    "ཡང་ན་ཕ་རི་སི་ནས་འདུག་གམ།",
