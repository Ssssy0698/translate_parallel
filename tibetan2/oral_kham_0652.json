    "རྒྱུ་གདམས་པ་མང་ཡང་རང་རྒྱུད་ཐུལ་པ་གཅིག་དགོས།",
    "ཆ་བཟུང་དང་སླེབ་པར་གདའ་གསུངས།",
    "གཞན་གྱི་སྐྱོན་མཐོང་ན་ཁ་ནང་དུ་ལོག་ནས་དེ་ལྟ་བུའི་སྐྱོན་དེ་རང་ལ་འདུག་གམ་མི་འདུག་བརྟག།",
    "འདུག་ན་སྐྱོན་དེ་རང་ལ་མེད་པ་ཞིག་བྱེད་དགོས།",
    "སྐྱོན་མི་ལ་བགྲངས་པས་མི་ཚུད་པར་འདུག་ཅེས་དང་།",
    "རྔན་གཞན་ལ་མ་བགྲང་རང་ལ་གྲོངས་ཤིག་ཨང་།",
    "དེས་ན་དེ་ལྟ་བུ་གྱུར་པ་དེ་ལ་བོན་ཉིད་དོན་གྱི་མཎྜལ་ཡང་རང་བཞིན་གྱིས་རྒྱུད་ལ་སྐྱེ་ཞིང་འབྲས་བུ་ཡེ་ཤེས་ཀྱི་ཚོགས་ཀྱང་ཤུགས་ཀྱི་རྫོགས་པར་འགྱུར།",
    "གཞན་གྱི་ཁྱིམ་ནས་ཚོཌ་བསཌ་སྒྲིབ་སྦྱང་བྱེད་པ་གཉིས་ལ་ཁྱད་པར་ཅུང་ཟད་ཙམ་མེད་ཅིང་གང་ལྟར་ཡང་རང་དོན་སྤང་ནས་གཞན་དོན་ལ་དམིགས་དགོས་པ་ནི་འདྲ་འདྲ་ཡིན་པས།",
    "ཁྱད་པར་ད་ལྟ་འདུག་ས་འདི་རུ་ཉམས་རྟོགས་ཀྵ་ཁྱད་པར་ཅན་རྒྱུད་ལ་སྐྱེ་བར་མཛད་དུ་གསོལ་ལོ།",
    "ཁྱད་པར་རྗེ་མཉམ་མེད་འགྲོ་བའི་མགོན་པོ་སློབ་དཔོན་སྤྱན་གཅིག་པ་རྗེས་འཛིན་དང་བཅས་པའི་མཛད་སྲོལ་དང་ཕྱག་ལེན་མ་ནོར་བ་ཡིན་འདུག་པས་དེ་ལྟ་བུ་ཅི་ནས་ཀྱང་འབད་པ་བྱའོ།",
    "ཁྱད་པར་ད་ལྟ་འདུག་ས་འདི་རུ་ཉམས་རྟོགས་གླུ་ཁྱད་པར་ཅན་རྒྱུད་ལ་སྐྱེ་བར་མཛད་དུ་གསོལ་ལོ།",
    "ཁྱད་པར་རྗེ་མཉམ་མེད་འགྲོ་བའི་མགོན་པོ་སློབ་དཔོན་སྤྱན་གཅིག་པ་རྗེས་འཛིན་དང་བཅས་པའི་མཛད་སྲོལ་དང་ཕྱག་ལེན་མ་ནོར་བ་ཡིན་འདུག་པས་དེ་ལྟ་བུ་ཅི་ནས་ཀྱང་འབད་པ་བྱའོ།",
    "ཀུན་གྱིས་བལྟས་པས་མི་བྱུང་བ་ལ་མ་ཤི་བར་འདུག་པས་ངོ་མཚར་ནས་གསོས།",
    "རང་རང་ཡུལ་དུ་སྐད་རིགས་སོ་སོར་བསྒྱུར།",
    "ཁོ་རང་ཞལ་བུ་ཀཱ་པཱ་ལི་ཁ་སྦུབས་པའི་འོག་ཏུ་དགོངས་པས་གཟིར་ནས་བཞུཌ་པས།",
    "དེ་ནས་ཐུན་འཇོག་དུས་སུ་ཨཱ་རིང་གསུམ་གྱིས་ཐུགས་ཁར་ཕབ་སྟེ།",
    "ང་འཁྲུལ་པ་ཡིན་སྙམ་ནས་གནས་ལུགས་ཀྱི་སྟེང་དུ་བཞག་པས་མེ་ཆུ་ལ་སོགས་དམྱལ་སྣང་དེ་དག་གང་ཡང་མེད་པར་དར་ཅིག་ནས་ལ་ཁ་མཐོན་པོ་གཅིག་ཏུ་སླེབ་ནས་འདུག་གསུངས་པ་ལྟ་བུ་ཡིན།",
    "ཁོ་རང་ནི་གྲོངས་བུམ་པའི་བྱ་བ་ཚར་འདུག་བསམ་ནས་མ་གཏད་པས།",
    "དེ་ནས་ཁོ་རང་ལ་ལུས།",
    "ཤི་ནས་ཀྱང་བུམ་པར་འདུག་ཏུ་མེད་བསམ་སྟེ།",
    "ཆགས་ཞེན་སྐྱེ་བའི་རྒྱུ་ཅི་འདུག་བརྟག་སྟེ།",
    "སྒོམ་མི་དགོས་པར་འཆི་ཁར་དག་པའི་ཞིང་དུ་མ་པང་དུ་བུ་རྒྱུག་པ་བཞིན་ཐོགསུ་ཆགས་མེད་པར་འགྲོ་ཆོག་པར་འདུག་པས།",
    "ཡོད་པ་འདུག་ན་སྐྱོན་དེ་ངོས་བཟུང་ལ་སྤང་དགོས།",
    "རྣམ་སྣང་བེ་རོ་ཙ་ནའི་རྣམ་འཕྲུལ་དུ།",
    "རང་རང་སྐྱེ་སའི་གཅེས་པའི་ཕ་ཡུལ་ལགས།",
    "སྲོག་ལྡན་གྱི་ཡོ་ལང་འཁྲུག་དུས།",
    "ཕྱག་དང་བསྟོད་པའི་ཡུལ་དུ་ཁྱེད་རང་བཀུར།",
    "བྲོ་བ་མི་འདུགཡང་ན་ཐམས་ཅད་ས་ཟ་རྡོ་འཆའ་བ་བཞིན་དུ་བྲོ་བས་དབེན།",
    "ཏིང་ལིང་ལིང་ཕ་ཡུལ་ནས་ཚྭ་ཁུག་མ་གང་བསྐུར་འདུག་ཡ་ཡ་ཡ་ཡ་ཡ་ཡ་མེས་པོའི་ཨ་ལན་ལ་སྐྱར་ཟློས་གལ།"
  ]
}