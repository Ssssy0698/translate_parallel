    "ང་རང་ངོ་ཚ་གནོང་བག་ཆེ་བའི་མཐར་སོན་པ་སྟེ།",
    "ང་རང་སྔར་ལས་སྔངས་འཚབ་ཆེ་ཞིང་སྤྲོ་ཁ་ཚ་བར་གྱུར་པས་གྲོགས་པོ་སུ་དང་ཡང་ཐུག་འཕྲད་བྱེད་མི་འདོད་ཅིང་།",
    "དོན་དག་ཅི་ཞིག་བྱུང་ཡང་རུང་ནམ་ཡང་རང་ཉིད་ཀྱི་རང་གཤིས་རྣལ་མ་རྒྱུན་འཆང་བྱེད་དགོས་ཞེས་ངེས་པར་བསླབ་ངེས་ཡིན།",
    "ང་རང་ཧ་ཅང་བླུན་དྲགས་པ་འདྲ་སྟེ།",
    "གཞན་གླུ་བ་དང་སྒྲ་གཏོང་པ་དུ་མས་ཀྱང་རང་གཤིས་ལེགས་པར་རྙེད་པས་སྙན་པའི་བ་དན་གཡོ་བའི་གྲགས་སྐར་དུ་གྱུར་ཏེ།",
    "ཨེ་མེར་ཟིན་གྱི་རྩོམ་ཐུང་རང་ཡིད་རང་ལ་ཆེས་པ་ཞེས་པའི་ཁྲོད་དུ་འདི་འདྲ་ཞིག་མི་གཤིས་ཀྱི་གཉོམ་སོ།",
    "བདག་ཉིད་རྙེད་པར་བྱེད་ཅིང་རང་གཤིས་རྣལ་མ་རྒྱུན་འཆང་བར་བྱེད་པའོ།",
    "ཕྲག་པ་འཇུམ་བཞིན་ང་རང་ཨ་རི་པ་ཞིག་ཡིན།",
    "དུས་དེར་ང་རང་ཁོང་དང་མཉམ་དུ་ཡོད།",
    "སེམས་ཁམས་གནས་བབ་ཀྱིས་ལུས་ཁམས་ལ་ཤུགས་རྐྱེན་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་ཐེབས་པར་འདུག་སྟེ།",
    "ཁོ་རང་འབྲེལ་མེད་ཀྱི་དོན་བྱ་མང་པོར་སེམས་ཁྲལ་བྱེད་པ་ཞིག་ཡིན།",
    "ང་རང་འདི་ལ་ཡིད་ཆེས་ལེའུ་གཉིས་པ།",
    "ཨེ་མ་ཅི་འདྲའི་རྔམ་བརྗིད་ཆེ་བའི་རྒྱལ་ཁབ་ཅིག་འདུག་གམ།",
    "ལོ་འགའི་སྔོན་དུ་བསམ་བློའི་སྟོབས་ཤུགས་ཞེས་པ་བཀླགས་པར་འདི་ལྟར་བྲིས་འདུག་སྟེ།",
    "ང་རང་དགའ་ཡུལ་གྱི་མི་དེ་ང་ལའང་དེ་བཞིན་དགའ་བའི་བློ་དཔང་བདག་ལ་ཡོད་དོ།",
    "མི་སུ་ལའང་འཁོན་སྡང་དང་འཁང་སྨོད་བྱེད་མི་འོས་པར་འདུག་ཅེས་སྨྲས།",
    "ང་རང་ལ་རྩོད་ཤགས་འགྱེད་པའི་ཁོམ་ལོང་མེད་ལ།",
    "དེའི་ཁྲོད་ནས་ལོ་ཤས་གྲོན་པར་བྱེད་པ་ཁེ་ཚོང་ཤིན་ཏུ་ཕམ་ཁ་ཆེ་བ་ཞིག་ཏུ་འདུག་ཁོས་རང་ལ་ཅིའི་ཕྱིར་མི་འདྲི།",
    "མིག་བར་ནས་བོར་འདུག་པ་སོགས་ལ་བསམ་ནས་གཞན་ལ་འཁང་ར་དང་ཚིག་པ་ཟ་བའི་ངང་ནས་ཚེ་མཇུག་སྐྱེལ་བར་བྱེད་ཅིང་།",
    "སེམས་གསོ་དང་སྙོར་སྐྱོང་ལེགས་པོ་བྱེད་པ་དེ་རང་བཞིན་གྱིས་བྱ་བ་ཞིག་ཏུ་བརྩི་བཞིན་འདུགདེ་ཕྱིར་དྲིན་ལ་དྲིན་ལན་འཇལ་བའི་བུ་རྒྱུད་ཅིག་ཡོད་པར་འདོད་ན།",
    "ཁོས་ང་རང་མཐོང་ཕྲལ་ཞོགས་པ་བདེ་ལེགས།",
    "ཁོ་རང་དམག་ཁོངས་ནས་ལོག་རྗེས་ཚོང་ལས་ཕྲན་ཚེགས་གཉེར།",
    "སོགས་ཀྱི་དོན་ཅན་བྲིས་འདུགསོམས་དང་།",
    "ཀུ་ཤུ་རྡོག་གཅིག་ལས་མ་ཐོབ་ཚེ་ཁོ་བོའི་ལས་འདི་ཅི་འདྲའི་སྡུག་པོ་འདུག་གམ་སོགས་ཟེར་ནས་མྱ་ངན་བསྐང་ཡུས་ཁོ་ན་འདོན་ཅིང་།",
    "ཕྱིར་མི་ལོག་ཐབས་མེད་འདུག་ཆུ་ཚོད་སྐར་མ་གང་ལའང་སྡོད་ཐབས་མི་འདུག་སོགས་བྲིས་ནས་ཡོད་ཚད་ལ་མགོ་བོ་སྒུར་རྩིས་བྱས།",
    "ཁོ་རང་ཆུང་ངུའི་དུས་སུ་ཁྱིམ་ཚང་དབུལ་ཞིང་བཀྲེན་པའི་ཚད་དུ་ཡོད་དེ།",
    "ཐོར་སི་ཐོ་ཝེ་སོགས་ཀྱང་རང་ཉིད་ཀྱི་མི་ཚེ་སྐྱོ་ཤས་ཆེ་བས་བསྐལ་པར་ཉམས་པ་མེད་པའི་སྒྲུང་རྩོམ་རླབས་པོ་དག་འབྲི་བར་ནུས་པ་བྱུང་སྙམ།",
    "དེ་ལ་མཆོག་དམན་གྱི་ཚད་ཤན་འབྱེད་མི་བཏུབ་པར་འདུག་པས་གཉིས་ཀ་མཉམ་པར་བདམས།",
    "ང་རང་ལོ་ན་བསླེབས་ཚེ་པ་ལགས་རླངས་འཁོར་དོན་རྐྱེན་ཞིག་ལས་ཚེ་སྲོག་ཤོར།",
    "སྐད་ཆ་འདི་ཐོས་པ་ཙམ་ན་བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ཏུ་འདུག་པས།",
    "གཞན་ལ་སྐྱོན་འདེད་བྱེད་པར་དགའ་ནའང་ཚང་མས་ཁོ་ལ་བསྟུན་པ་ཡིན་ན་ཁོ་རང་ལ་བསྙད་འདོགས་སའི་ཡུལ་མེད་པས་ཅི་བྱར་མེད།",
    "འགའ་ཞིག་འོ་ན་ང་རང་ཉིན་ཧྲིལ་པོར་མལ་ཁྲིའི་སྟེང་དུ་ཉལ་ཏེ་སྡོད་དགོས་ཟེར།",
    "སླར་སད་པ་ན་གནས་གང་དུ་འདུག་པ་ངོས་མ་ཟིན་པས་འཇིགས་སྣང་ཞིག་ཀྱང་འོང་།",
    "ཁྱེད་རང་གཉིས་གང་ནས་འོང་བ་ཡིན།",
    "སྤྲོ་སྐྱིད་ཀྱི་སེམས་ལ་ཕན་ཚུན་བསྒོ་མཆེད་ཀྱི་རང་བཞིན་ཞིག་ཡོད་འདུག་ཅིང་།",
    "གཞན་ལ་ཕན་པ་དེས་རང་ལའང་ཕན་ནུས་པར་འདུག་པ་གཞི་ནས་ཤེས།",
    "ངེད་ཅག་དེ་ལྟ་མ་ཡིན་ཏེ་ཉིན་བཞིན་ལས་ཀ་དཀྱུས་མ་དག་ལས་གང་ལའང་མི་ཕྲད་པས་གོང་ལྟར་བྱེད་པའི་གོ་སྐབས་མི་འདུག་སོགས་ཟེར་སྲིད།",
    "དེས་ཁོ་རང་ལ་ཡིད་ཚིམ་གྱི་ཚོར་བ་ཞིག་སྦྱིན་ནུས་པས་སོ།",
    "དེ་དུས་ཁོ་རང་ན་ཚོད་ཤིན་ཏུ་གཞོན་པ་རང་ལོ་ཙམ་ཡིན།",
    "དེའི་རྐྱེན་གྱིས་ཁོ་རང་ཉམས་མྱོང་མེད་པར་བསྙད་དེ་ཀུན་གྱིས་ཚིག་མཚོན་འདེབས་ཡུལ་དུ་གྱུར་ཞིང་།",
    "དངོས་གནས་ཚབས་ཆེ་བར་འདུག་འོན་ཀྱང་ཁྱི་ཤི་བོ་ཞིག་ལ་རྡོག་པ་གཞུ་མཁན་མེད་པར་དཔག་ན་རྒྱུ་རྐྱེན་ཞིག་ཀྱང་ཡོད་སྲིད་ཅེས་བཤད།",
    "དེས་ཁོ་རང་ལ་ཡིད་ཚིམ་གྱི་ཚོར་བ་ཞིག་སྦྱིན་ནུས་པས་སོ།",
    "གླེན་ནག་གཏི་ཐུག་བཅས་སུ་འདུག་ཅེས་བྲིས་འདུག་ཕྱི་ཉིན་ཕྱི་དྲོའི་རྒྱང་སྒྲོག་སྐབས་རང་ལ་སྐྱོན་བརྗོད་པའི་འཕྲིན་དེ་ཇི་བཞིན་རྒྱང་སྒྲོག་ཏུ་སྒྲོག་འདོན་བྱས་པས་ཀུན་ཀྱང་ཧ་ལས་པ་བྱུང་།",
    "ལན་དུ་ལས་གྲོགས་ཤིག་དང་ཁ་རྩོད་བྱས་པས་ཁོ་ཁྲོས་ཏེ་ང་རང་ཆུ་ལ་བསྐྱུར་བ་ཡིན་ཟེར།",
    "ཨ་རིའི་ནང་འཁྲུག་སྐབས་སྲིད་སྤྱི་ལིན་ཁེན་ལགས་ལ་སྙད་རྒོལ་གྱི་ཇུས་ལན་ལེགས་པོ་ཞིག་མེད་ན་ཁོ་རང་སེམས་ཁ་འཁྲུགས་པོར་འགྱུར་སྲིད།",
    "མཐའ་མའི་འབྲས་བུར་ང་རང་ཡང་དག་པ་ཡིན་ན་སྐྱོན་འཚོལ་དང་སྙད་ཀ་དེ་ཚོ་ཚང་མ་དོན་མེད་འབའ་ཞིག་ཏུ་འགྲོ་ལ།",
    "མཇུག་འབྲས་སུ་ང་རང་འཆུགས་པ་ཡིན་ན་ལྷའི་ཕོ་ཉ་བཅུ་ཙམ་ཡོང་ནས་དག་སེལ་བྱས་ཀྱང་ཕན་པ་མི་གཤིས་ཀྱི་གཉོམ་སོ།",
    "དུས་དེར་ཤེས་རབ་ལའང་ནུས་པ་མེད་པ་འདྲ་ཞེས་བྲིས་འདུགམི་ཕལ་བ་དག་གཞན་གྱིས་སྐྱོན་བརྗོད་པ་རང་སྟེང་དུ་ཁེལ་བས་ཁོང་ཁྲོ་སྐྱེ་བར་བྱེད་ལ།",
    "ཁོས་ང་རང་ཁྱིམ་དུ་ལོག་འོང་བ་རྒྱང་རིང་ནས་ཚོར་ཐུབ་ལ།",
    "དགོད་བྲོ་བ་ཞིག་འདུག་གམ།",
    "ཉན་པས་སྲིད་སྤྱི་ལགས་ཡིན་འདུག་ལ།",
    "ད་ལྟ་ཁྱེད་ཚོས་ཁང་བའི་དྲ་མིག་ལས་ལྟོས་དང་ཐད་ཀ་དེ་ན་དེ་སྔོན་སྨྲས་པའི་བྱ་དེ་འདྲ་ཞིག་འདུག་ཅེས་སྨྲས་བྱུང་།",
    "ཁོ་རང་སྟོབས་འཚར་སྤྱི་གཉེར་གྱི་ཚོང་མི་གཤིས་ཀྱི་གཉོམ་སོ།",
    "དེ་ནས་བཟུང་ཁོས་དེ་ཉིད་མི་ཚེ་གང་པོར་བརྗེད་ཐབས་བྲལ་བའི་བདེ་སྐྱིད་ཅིག་ཏུ་བརྩིས་ནས་སེམས་ཀྱི་གྲུ་གར་གཅེས་པར་ཉར་འདུགགལ་ཏེ་གཞན་རྣམས་རང་ལ་དགའ་བ་འཆང་བར་འདོད་ན།",
    "འདི་འདྲའི་གཤིས་ཡག་པོ་ཅན་ཞིག་ཡིན་འདུག་ཅེས་སྨྲ་བར་བྱེད།",
    "འཛུམ་མདངས་སྟོན་ཤེས་པའི་མི་དེར་རྟག་ཏུ་དགའ་བསུ་ཐོབ་ཀྱིན་འདུག་དེ་ཕྱིར་ཁོ་བོ་གཞུང་ལས་ཁང་ཞིག་ཏུ་འཛུལ་བར་རྩོམ་ཚེ།",
    "ཐབས་རྩལ་སྟབས་བདེ་དེ་ཉིད་དང་རང་ཉིད་ཀྱི་ཁག་ལེན་སྤྱི་གཉེར་ལ་ལེགས་འགྲུབ་དེ་འདྲའི་ཆེན་པོ་བྱུང་བ་གཉིས་ཀྱི་བར་འབྲེལ་བ་ཆེན་པོ་ཡོད་པར་ཁོ་རང་ཡང་དངོས་གནས་ཡིད་ཆེས་བཞིན་འདུགགཤམ་དུ་ཧོ་པ་ཏི་ལགས་ཀྱི་ཤེས་རབ་ཀྱི་འོད་སྣང་འཚེར་བའི་གདམས་པ་འགའ་ཞིག་འགོད་པར་བྱ།",
    "ཁོས་དེ་འཕྲལ་ཚིག་ཕྱིར་བཟློག་མ་བྱས་ཀྱང་ཡིད་མ་ཆེས་པའི་ངང་དུ་ཡོད་ཙ་ན།",
    "འོན་ཀྱང་ཕྲད་པའི་མི་ཐམས་ཅད་ཀྱི་མིང་ནི་ཡིད་ལ་ངེས་པར་འདུག་ཅེས་བཤད།",
    "དེར་ཁོ་བོས་ཁྱེད་རང་ཨ་ཧྥེ་རི་ཁར་བསླེབས་མྱོང་བ་ལེའུ་གསུམ་པ།",
    "དེ་ཙམ་གྱིས་མཇུག་འབྲས་ལ་ཁྱད་པར་ཆེན་པོ་ཕྱེས་འདུག་པ་གསལ་པོར་ངེས་ཐུབ།",
    "ཁོ་རང་གལ་ཆེན་དུ་བྱས་ཡོད་པ་ཚོར་དུ་འཇུག་པར་བྱ།",
    "འོན་ཀྱང་སྔོན་ཆད་ལ་མི་འགྲན་པར་འདུག་ཅེས་ལན་བྱུང་།",
    "མི་ལ་རོགས་རམ་བྱས་པ་ལས་བྱུང་བའི་དགའ་བདེའི་ཚོར་བ་ནི་དོན་དག་དེ་འདས་པའི་རྗེས་སུའང་སེམས་ལས་ནམ་ཡང་བོར་བ་མེད་པར་འདུགམིའི་རིགས་ཀྱི་སྤྱོད་ལམ་ལ་གཏན་སྲོལ་ཤིན་ཏུ་གལ་ཆེན་ཞིག་ཡོད་དེ།",
    "དེ་ནི་དུས་དང་རྣམ་པ་ཀུན་ཏུ་མི་གཞན་ལ་ཁོ་རང་གལ་ཆེ་བ་ཤེས་སུ་འཇུག་རྒྱུ་དེ་ཡིན།",
    "གཞན་ལ་ཁོ་རང་གལ་ཆེན་དུ་བྱས་ཡོད་པ་ཚོར་ཐུབ་པར་བྱེད་ཅིང་།",
    "ཚོད་འཛིན་བྱེད་མི་ནུས་པའི་རང་ཉིད་ཀྱི་སྤྲོ་ཁ་དང་རང་གཅུན་ནུས་སྟོབས་ཉམས་པ་སོགས་ཀྱི་མཇུག་འབྲས་དང་ལེན་བྱེད་པའི་ཆེད་དུ་ཆུ་ཚོད་གཟན་མི་རུང་།",
    "ང་རང་ཁོང་ལ་དགའ་བསུ་བྱེད་པའི་གསོལ་སྟོན་ཞིག་ཏུ་ཞུགས།",
    "གཞན་དེ་འགྲིག་འདུག་ཅེས་སྨྲས།",
    "ཚོད་འཛིན་བྱེད་མི་ནུས་པའི་རང་ཉིད་ཀྱི་སྤྲོ་ཁ་དང་རང་གཅུན་ནུས་སྟོབས་ཉམས་པ་སོགས་ཀྱི་མཇུག་འབྲས་དང་ལེན་བྱེད་པའི་ཆེད་དུ་ཆུ་ཚོད་གཟན་མི་རུང་།",
    "ང་རང་ད་ལྟ་འདི་འདྲ་ཞིག་ལ་ཡིད་ཆེས་ཀྱིན་ཡོད་དེ།",
    "གལ་ཏེ་ཁ་གཏད་ཀྱི་གནས་སུ་གྱུར་ནའང་རང་ཉིད་ཐབས་རྩལ་གྱིས་མ་ཕོངས་པར་བྱའོ།",
    "གཞན་ལ་གུ་ཡངས་བྱས་པས་ཁོ་རང་མི་བྱམས་བརྩེ་ལྡན་པ་ཞིག་ཡིན་པ་མཚོན་ནུས་པ་སོགས་ཀྱིས་ཀྱང་ཡིན་སྙམ།",
    "ང་རང་ཐེངས་དང་པོར་འདི་འདྲའི་སྤྱི་གཉེར་གྱི་ལས་བཟོ་པའི་འཐུས་ཚབ་དང་ངོ་ཐུག་པ་བྱུང་།",
    "འོན་ཀྱང་དོན་བྱ་འདིའི་ཕྱིར་དུ་ང་རང་ཉེ་འཁོར་གྱི་ལས་གནས་དག་ལ་ཕྱིན་ཅིང་།",
    "པས་ང་རང་ད་དུང་འདི་ཀར་འདུག་རྩིས་ཡོད།",
    "ཐ་མ་ཕ་རོལ་པོས་ཅུང་ཟད་མཁྲིགས་སུ་ཚུད་པའི་ཚེ་ན་སྡོམ་ཚིག་ལ་ཐུག་འདུག་པས་ཁོ་རང་ཅི་བྱ་མེད་པའི་ཨར་ལ་གཏད་ཟིན་པར་འདུག་གོ།",
    "གཞན་རྣམས་དཀའ་ཁག་དང་ཕྲད་པ་ལས་ཐོབ་པའི་སྤྲོ་སྐྱིད་དེ་ཡིན་འདུག་ཞེས་པའོ།",
    "དེ་ལྟར་སྙམ་འདུག་བསམ་པའི་ཚོར་བ་གཞན་ལ་སྐྱེད་པར་མི་བྱའོ།",
    "ད་དུང་དེ་ལ་ཅི་མི་སྙམ་པའི་ངང་དུ་འདུག་གནས་བབ་དེ་འདྲའི་འོག་ཁོ་ལ་ལེ་འདེད་དང་སྐྱོན་བརྗོད་བྱེད་པ་ནི་བླུན་པོའི་རང་རྟགས་ཙམ་དུ་ཟད།",
    "དེ་ཡང་གལ་ཏེ་ང་རང་སྐབས་དེའི་གནས་བབ་དང་ཕྲད་པ་ཡིན་ན་ཇི་ལྟར་བྱེད་སྲིད་དམ་སྙམ་ནས་བསམ་གཞིགས་བྱེད་དགོས།",
    "བར་ཡུན་གྱིས་འཁོན་སེམས་ཆགས་པར་འགྱུར་བའི་ཉེན་ཁར་བཅས་པ་སོགས་མི་ལེགས་པའི་ཆ་མང་དུ་འདུག་པ་ཚོར་བྱུང་།",
    "ཁོ་རང་ལུས་སེམས་ཀྱི་ཁམས་མི་བདེ་ལ་སྐད་ལའང་ཉེ་ཞོ་བྱུང་འདུག་པས་གླུ་ལེན་མི་ནུས་པར་འདུག་ཟེར།",
    "དེ་ལས་ཐོབ་པའི་དངུལ་རྣམས་ཉེ་འཁོར་གྱི་ཞིང་པ་དབུལ་ཕོངས་པ་དག་ལ་བྱིན་ཏེ་བུ་ལོན་གསོད་དུ་འཇུག་འདི་ལྟ་བུ་ད་དུང་འགའ་ཞིག་ཡོད་པ་དེ་ཚོས་ཀྱང་རང་ཉིད་འབྱོར་ལྡན་གྱི་ལྟག་བདུད་དང་ཉམ་ཆུང་དབུལ་ཕོངས་ལས་སྒྲོལ་མི་གཤིས་ཀྱི་གཉོམ་སོ།",
    "ཁྱེད་ཚོས་དེ་ལྟར་བྱས་པས་ང་རང་མི་དགའ་བར་བཟོས་སོགས་བྲིས་ན་འབྲས་བུ་ལེགས་པོ་མི་སྐྱེད་པར་ཤེས་ནས།",
    "སྟོབས་འགྲན་རྣམ་གནོན་གྱི་གོ་སྐབས་ཤིག་ཏུའང་འདུག་གོ།",
    "སྟོབས་འགྲན་རྣམ་གནོན་གྱི་གོ་སྐབས་ཤིག་ཏུའང་འདུག་གོ།",
    "དེ་ནི་ང་རང་དགའ་བའི་གནས་ཀྱང་ཡིན་པ་ལྟ་ཅི།",
    "དུས་བཅད་དུ་བསླེབ་ཉེ་ཚེ་གཞན་རྣམས་ལེགས་པར་འགྲུབ་ཀྱང་ཕྱིས་སུ་རྒྱན་སྤྲོ་བྱེད་པའི་རྒྱུ་ཆས་འདོན་སྤྲོད་དུས་ལྟར་བྱེད་མི་ནུས་པར་འདུག་པས།",
    "དེ་འདྲ་འདུག་གམ་སྨྲས་པས་ལན་དུ་འདུག་སྟེ།",
    "ད་སྔོན་ཏག་ཏག་ཏུ་ཁོ་བོ་ས་འདིར་བསླེབས་མ་ཐག་པ་ན་ཁ་པར་མིང་དེབ་ཏུ་ཁྱེད་ཀྱི་རུས་མིང་ཞིབ་ཏུ་བཙལ་བས་གཅིག་ཁོ་ན་ལས་མི་འདུག་པ་ཡ་མཚར།",
    "ཕྱི་ཉིན་ལས་བདག་དེ་ལ་ཁ་སང་ཁྱེད་ཚོས་གད་སྙིགས་གཙང་མར་བྱས་འདུག་པ་ཤིན་ཏུ་བཟང་སྟེ།",
    "བྱིས་པ་ཞིག་རང་ལོ་ཙམ་ནས་ཐ་མག་འཐེན་བཞིན་འདུག་པ་ལ་ཁོའི་ཕ་ལགས་ཀྱིས་འདི་ལྟར་སྨྲས།",
    "ཁོ་རང་ཉིད་ལ་བསྒྲུབ་ཏུ་འཇུག་ཅིང་།",
    "ཡང་ན་འདི་ལྟར་བྱས་ན་ཅི་འདྲ་འདུག་ཅེས་པ་འབའ་ཞིག་སྤྱོད་ཀྱིན་འདུག་པས་དེ་ཡག་པོ་ཞིག་ཏུ་སྙམ་སོགས་སྨྲས།",
    "ཁོ་རང་ཉིད་ལ་བསྒྲུབ་ཏུ་འཇུག་ཅིང་།",
    "གཞན་ལ་སྤྱོད་བྱའི་དུས་ཚོད་སྙོམ་སྒྲིག་བྱེད་པའམ་སྒེར་གྱི་ལས་ཀ་བགོ་གསེས་བྱེད་པ་སོགས་ཀྱི་ཐབས་གང་རུང་འདུག་གམ་སོགས་སྨྲས་ཤིང་གྲོས་བསྡུར་ལེགས་པར་བྱས་པས།",
    "འོན་ཀྱང་ཕྱི་མ་དེ་ནི་མི་བདེན་པར་འདུག་སྟེ།",
    "ནུས་པ་ཐོན་སྲིད་པའི་ཐབས་ཤེས་ཉག་གཅིག་ཡོད་པ་ནི་ཁོ་རང་ཕོ་རབ་ཅིག་དང་།",
    "ཡང་ན་མི་གཞན་པ་གང་རུང་ལ་ཁོ་རང་དོན་དག་གང་ཞིག་ཐད་གླེན་ཚབས་ཤིན་ཏུ་ཆེ་ཞེས་པ་དང་།",
    "ཡང་ན་ཁོས་བྱས་པ་ཐམས་ཅད་རྩ་བ་ཉིད་ནས་ནོར་འདུག་ཙེས་པ་སོགས་སྨྲས་པ་ཡིན་ན།",
    "དོན་བྱ་དེའི་ཐད་ཁོ་རང་ལ་ད་དུང་སྡོག་འདོན་བྱ་བའི་ནུས་རྩལ་ཡོད་པ་སོགས་ཕ་རོལ་པོ་ལ་ཤེས་སུ་བཅུག་ན།",
    "འདུག་རྡོག་འགྲོས་ཀྱང་ཡོངས་སུ་ནོར་འདུག་སོགས་སྨྲས་པས་ཁོ་རང་ཞབས་བྲོ་ལ་ཡི་ཆད་དེ་མཚམས་འཇོག་དགོས་བྱུང་།",
    "ཡང་ན་མི་གཞན་པ་གང་རུང་ལ་ཁོ་རང་དོན་དག་གང་ཞིག་ཐད་གླེན་ཚབས་ཤིན་ཏུ་ཆེ་ཞེས་པ་དང་།",
    "ཡང་ན་ཁོས་བྱས་པ་ཐམས་ཅད་རྩ་བ་ཉིད་ནས་ནོར་འདུག་ཅེས་པ་སོགས་སྨྲས་པ་ཡིན་ན།",
    "དོན་བྱ་དེའི་ཐད་ཁོ་རང་ལ་ད་དུང་སྔོག་འདོན་བྱ་བའི་ནུས་རྩལ་ཡོད་པ་སོགས་ཕ་རོལ་པོ་ལ་ཤེས་སུ་བཅུག་ན།",
    "དེ་བས་སྲིད་སྤྱི་ལགས་ནས་ང་རང་བཏང་བ་ཡིན་པར་འདུག་སོགས་སྨྲས་པས་སྲིད་སྤྱི་མི་དགྱེས་པར་མ་བྱས་ལ།",
    "ལྷ་མི་བདེ་བའི་དོན་དང་རང་ཉིད་ཀྱི།",
    "འཇིག་རྟེན་ཚེ་འདིའི་སྙན་གྲཌ་དང་བསྟོད་བཀུར་སོཌ་ཀྱིས་ཕན་པ་མི་འདུག་ཅིང་།",
    "ཐོག་ཏུ་ཁེལ་དུས་ཐམེད་ཅིང་རང་རྒྱུད་གཡེངས་བའི་རྒྱུ་ཡིན་པས།",
    "གདམས་ངག་དེ་ཡང་གལ་ཆེ་ཆེ་དོན་ཟབ་ཟབ་ལྟར་འདུག་ཀྱང་མཐར་འཇིག་རྟེན་ཚེ་འདིའི་ཆེད་དུ་འཆོར།",
    "སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་བསྒྲུབས།",
    "ཟེར་གྱིན་འདུག་པ་ལ།",
    "ཉེར་སྤྱོད་སོཌ་འདི་དགོས་པ་འདུག་སྙམ་པ་རྣམས་ཐུགས་དང་འཐད་པ་འབུལ།",
    "པར་འདུག་སྙམ་ན།",
    "ཨུ་རྒྱན་གྱི་ཡུལ་དུ་ཕྱིན་ནས་འདུག་དེ་ཁོས་ཀྱང་སྤྲུལ་པ་ཡིན་པར་ཤེས་ནས་ཕྱིས་འགྱོད་པ་སྐྱེས་ཏེ།",
    "སྤྱོད་ལམ་བཟང་ངན་སོགས་ཅི་ལྟར་འདུག་ཀྱང་ཐམས་ཅད་ཡོན་ཏན་འབའ་ཞིག་ཏུ་སྟེ།",
    "བོན་རྒན་རིད་པམང་པོ་ཉེལ་ཉེལ་འགྱེལ་ནས་འདུག་དེར་ཁོའི་བསམ་པ་ལ།",
    "ཅི་འདྲའི་གྲུབ་ཐོབ་ཀྱང་འདུག་བོན་རྒན་ཚེ་མ་ཕྱིད་པ་ཤས་གཅིག་སྣང་སྙམ་ནས།",
    "ད་ལྟ་གང་ན་ཡོད་གླའོ་ཟེར་གྱིན་འདུག་པ་ལ།",
    "དེ་ཁོས་གྲུབ་ཐོབ་ཡོད་ཟེར་བ་རྫུན་དུ་འདུག་བྱས་པས།",
    "འོ་ན་ངའི་ལུས་དང་ཁུར་ན་ཅི་འདུག་བྱས་པས།",
    "གཡུ་དང་ཐོད་པ་དངུལ་གྱི་སྐྱོག་འདུག་ཟེར།",
    "བོན་རྒན་ཚེ་མ་ཕྱིད་པ་ལས་མི་འདུག་གྲུབ་ཐོབ་བྱ་བ་རྫུན་དུ་སྐསྣང་བྱས་པས།",
    "དེ་བུའི་སྤྱོད་པ་དེ་ཡང་རང་བཞིན་ཕལ་པའི་སྤྱོད་ཚུལ་ལྟ་བུར་མ་ཡིན་ཅིང་།",
    "གསེར་གྱི་མེ་ཏོག་པདྨ་འདབ་མ་སྟོང་དང་ལྡན་པ་ལ་གཡུའི་གཡུང་དྲུང་བཀྲ་བ་སྐྱེས་ནས་འདུག་པ་ལ།",
    "བཟླས་པ་ལ་བསྒྲིམས་དགོས་པར་འདུག་ཟེར།",
    "མཛེ་ཁོ་རང་ནམ་འོང་ཤོག་གསུངས་ནས།",
    "ཚང་བར་འདུག་ན་དེ་ལ་དགའ་བ་བསྒོམ།",
    "མི་ཚང་བར་འདུག་ན་གང་མི་ཚང་བ་དེ་ངོས་བཟུང་།",
    "གཟུགས་ཡོད་ཁ་འཐོར་མཐོང་ཙ་ན།",
    "དལ་འབྱོར་ལྡན་པ་མཐོང་ཙ་ན།",
    "དེས་ན་འདི་ལྟ་བུ་ཐོབ་འདུག་སྙམ་པ་གཡང་ལ་རྒྱུག་པ་ལྟ་བུ་ཡིན་པར།",
    "ཅོ་བོན་གྱིམ་བུས་རྩི་ཤིང་རང་སྡུད་བྱེད་པ།",
    "སེར་སྣའི་ཡོ་བྱད་ལ་ཁ་ཆེམས་ཀྱི་འཕྲིན་པ་བཞག་ནས་འགྲོ་དགོས་པ་གདའ་སྟེ།",
    "དགེ་རྒྱུགས་གཅིག་མེད་ན་ནི་འགྱོད་པ་འོང་བ་གདའ་གསུངས་སོ།",
    "ཕྱོཌ་ཐ་དད་ཀྱི་མི་བརྒྱ་སྟོང་ཁྲི་འབུམ་འཚོཌ་པ་ཐམས་ཅད་ཀྱང་མཐར་རང་རང་སོ་སོའིཡུལ་དུ་གྱེས།",
    "འདུག་ན་གནས་མི་རྟག་པས་དག་པའི་ཞིང་དུ་ལྟ།",
    "སྡུས་སུ་སླེབ་ཙ་ན་བཙན་པོའི་མཁར།",
    "གཞན་འཆི་བ་མཐོང་ཡང་རང་འཆི་བ་མི་ཤེས།",
    "ཡང་འདུག་པའི་དུས་སུ་མི་རྟག་པ་བསྒོམ་ན་དག་པའི་ཞིང་ཁམས་མཐོང་བར་བྱེད།",
    "ད་ལྟ་རང་ལ་རང་ཁྲེལ་བ་དང་རང་ཉིད་ཀྱང་རང་ལ་ངོ་ཚ་བའི་གནས་སུ་གྱུར་པ་སྟེ།",
    "འདི་མིའི་ཡུལ་དུ་འདུག་ཙམ་ན།",
    "རྣམ་སྨིན་འབྲས་བུ་སྨིན་པར་འདུག་གསུངས།",
    "ཙན་དན་གྱི་གྲིབ་མ་འདུག་སྙམ་ནས་ཕྱིན་པའི་ཚེ།",
    "སྔ་ཕྱི་ཙམ་མ་གཏོགས་གནས་དེར་སྐྱེ་ངེས་པར་འདུག་སྐྱེས་པའི་ཚེ་སྡུག་བསྔལ་དེ་དངོས་སུ་མྱོང་དགོས་པར་ཡིན་པས་ཅི་ལྟར་བྱེད་སྙམ་པའི་འཇིགས་སྐྲག་མི་བཟོད་པ་ཞིག་རྒྱུད་ལ་མི་སྐྱེ་བའི་ཐབས་མེད།",
    "རྐང་གཉིས་པ་གཅོད་སྦྱང་བྱེད་པ་མང་པར་གདའ།",
    "མཐོང་བ་རྣམས་ནི་དེ་ལྟ་བུ་། འདུག།",
    "སྦལ་པ་ཤིན་ཏུ་ཆེ་བ་གཅིག་ལ་སྡོམ་སྦྲུལ་སོག་སྲོག་ཆགས་སྟོང་བས་མི་ཉུང་བས་ཟ་ཀྱིན་འདུག།",
    "གནས་ན་འདུག་པ།",
    "དང་པོ་གནས་ན་འདུག་པ་ལ་ཕྱིའི་སྒྲིབ་པ་ཅན་ནི།",
    "བོང་བུ་གཉིས་གཏོད་པ་ལ་བཏག་ནས་འདུག་བོང་བུ་དྲན་པ་གསལ་བས་སྣས་རྣམ་ཡིན་ཕྱིན་པས།",
    "དེར་ཡི་དྭཌ་ཀྱི་ཡུལ་དུ་ལོ་གྲངས་མང་པོར་བཟའ་བཏུང་མིང་ཙམ་ཡང་མི་གྲཌ་པར་བཀྲེས་སྐོམ་གྱིསྡུག་བསྔལ་མྱོང་དགོས་པར་བྱུང་ན་ཅི་བྱེདམེད་པར་ཞུག་གཅིག་འདུག་ན་ཇི་ཙམ་གྱི་སྡུག་བསྔལ་འདུག་སྐྱེ་བའི་རྒྱུའི་གཙོ་བོ་འདོད་ཆཌ་དང་སེར་སྣ་ཡིན་པས།",
    "དེ་སྤོ་བར་འདོད་ནས་གཞན་གྱི་རྩར་ཕྱིན་པས་དེ་ལ་གནོད་ཅིང་རང་ལ་མི་ཕན་པ་ལ་སོཌ་ཇི་ལྟར་བྱས་ཀྱང་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས།",
    "དེ་རྣམས་ཀྱི་སྡུག་བསྔལ་ཡང་རང་ཐོག་ཏུ་བླངས་ལ་བསྒོམ།",
    "རྒས་པའི་དུས་ལ་བབ་ཙ་ན་ལུས་ཀྱི་ཤ་ཞུ།",
    "འདུག་ན་ས་དོ་ལུང་ཆད་པ་བཞིན་དུ་འདུག་ལྡང་ན་སྤང་ལ་ཕེཞུ་ཕུར་འདོན་པ་བཞིན་དུ་ལྡང་།",
    "འདུག་ན་རང་ལུས་ཉམ་ཆུང་ས་དོ་ཆད་པ་འདྲ།",
    "དེ་ཙ་ན་རྒས་པའི་སྡུག་བསྔལ་མི་བཟོད་པས་འཆི་བར་སྨོན་ཡང་།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།",
    "ནོར་མེད་ཙ་ན་དགྲ་དང་བྲལ་ཞེས་པ་ལྟར།",
    "གཞན་གཡོག་ཏུ་བཀོལ་ནས་རང་སྐྱིད་པོར་བྱེད་ཀྱིན་འདུག་སྟེ་ཟས་ཟ་རྒྱུ།",
    "དེ་ལ་བསམ་ན་འབུ་སྦྲང་ཁོ་ནའི་ཕྱེ་བྱས་པ་འགམ་པ་དང་ཁྱད་མི་འདུག་དེ་བཞིན་དུ་རྨོས་གླང་རྨོས་ཁལ་རྣམས་ཀྱི་སྣ་ནས་ཐའུ་དྲངས།",
    "ལྷའི་སྟན་ལ་ཅི་ཙམ་འདུག་ཀྱང་མི་དགའ་བ་མེད་པ་ལ།",
    "ཀུ་སུ་ལུ་པ་ཁ་ཅིག་འདུག་ས་དཔེན་པ་ལྔ་ལྡན་བྱས་ཀྱང་།",
    "སྣང་བས་བསྒྱུར་བ་གདའ་གསུངས།",
    "འཁྲི་བ་ཆོད་པ་གང་དཀའ་བ་གདའ་ཞུས་པས།",
    "འདུག་ས་ནི་གཡའ་རི་གངས་བྲག་ཡིན།",
    "རང་ནོར་ལ་སེར་སྣ་བྱེད་ཅིང་འདོད་སེམས་ལ་ཁེངས་དུས་དང་ཆོག་དུས་མེད་པ་རྣམས་ཀྱང་།",
    "ཡོད་ཀྱང་ཅུང་ཟད་ཡང་སྙམ་པ་འདུག་སྟེ་གསོད་དུ་འཇུག་པ་པོ་ལྟ་ཅི།",
    "ཚོང་སོཌ་གཡོ་དང་ཐབས་ཀྱི་སྒོ་ནས་ལེན་པ་ཐམས་ཅད་ཉེས་པ་མེད་ང་རང་ཕོ་རྒོད་པས་ཡིན་སྙམ་པ་འདུག་ཀྱང་།",
    "གཞན་གྱིས་མི་སྦྱིན་པ་ལ་སྦྱིན་འདུག་ཟེར་བ་སོཌ་རྫུན།",
    "རྫུན་དུ་སྨྲ་བའི་རྩ་བ་ཉམས་ན་གཞན་རྩ་བ་གསུམ་པོ་ཡང་རང་ཤུགས་ཀྱིས་ཉམས་པར་འགྱུར།",
    "ནོར་ཕྱིར་སྐུ་ཚེ་དཀོར་ནག་ལ་སྐྱལ་ནུས་པ་ཡང་ཡོད་པར་འདུག་སྟེ།",
    "བཀལ་ཀྱང་སྲང་ངེར་འདུག་པ་སོགས་བྱུང་།",
    "དེ་ལ་ཚེ་སྙན་དང་བདེ་སྐྱིད་ལ་སོགས་ཡོད་པ་འདུག་ན་འདི་ཙམ་དུ་མ་བདེ་ན་མ་སྐྱིད་ན།",
    "གཞན་གནོད་པ་དང་འཚེ་བར་བྱེད་པ་རྣམས་ཀྱང་རང་བཞིན་གྱི་ཞི་ནས་འགྲོ་བ་ཡིན་ཏེ།",
    "སྒོམ་སྒོམ་འགྲོ་འདུག་བྱེད་པ་ལ་ཡང་འཚེ་བ་མེད་ན་དགའ་བ་ཡིན།",
    "ད་འོ་ཅག་ལ་མི་ངན་ཟན་སློང་བ་ཙམ་ཡང་མི་འོངས་བར་འདུག།",
    "སི་ལ་དང་ཚིལ་ཆེན་གྱི་དྲི་ཅི་ལི་ལི་འདུག་པས།",
    "ཁྱད་པར་སྐྱེ་དམན་འདི་མཁའ་འགྲོ་མ་ཡིན་པར་འདུག་པས་མ་སྨད།",
    "ངག་འཁྱལ་ལམ་གཏམ་སྣ་ཚོགས་པ་སྨྲ་བ་དེ་ཡང་རང་བཞིན་དུ་གང་བབ་བྱུང་རྒྱལ་དུ་སྨྲ་བ་ལྟར་སྣང་ཡང་།",
    "ཕ་མར་བྱས་པའི་ཚེ་ད་ལྟའི་ཕ་མ་བཞིན་དྲིན་ཆེན་པོས་སྐྱོང་བ་ཤ་སྟག་ཡིན་པས་ད་ལྟའི་ཕ་མ་དང་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མི་འདུག།",
    "བཙུན་ཆུང་དུ་དགའ་བ་ཞིག་འདུག།",
    "བཙུན་ཆུང་ལྟོག་སླ་བ་ཞིག་འདུག།",
    "རང་རང་སོ་སོའི་འདོད་པ་ལྟར་བདེ་བ་དང་སྐྱིད་པ་ཁོ་ན་བྱུང་ན་ཅི་མ་རུང་སྙམ་དུ་ཡང་དང་ཡང་དུ་བསྒོམ།",
    "གཞན་གྱི་ཡོན་ཏན་ལ་མཐོང་དུས་མེད་ཅིང་རང་ཉིད་སྡུག་བསྔལ་གྱི་གནས་སུ་འཕེན་པའི་སྡིག་ཚབ་པོ་ཆེ་གསོག་པ་ཡིན་ཏེ།",
