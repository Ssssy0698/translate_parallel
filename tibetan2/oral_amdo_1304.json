    "ཕྱི་དར་ནང་དུ་དེ་ལྟ་བུར་གྱུར་པའི་དུས་ཀྱི་ཚད་གང་ཡིན་པ་དེ་རང་ར་གི་ཚད་ཀྱིས་སྲིན་བུ་ལ་སོགས་པ་རྣམས་ལ་རིག་པར་བྱའོ།",
    "དེ་གང་གིས་ཤིན་རྣལ་འབྱོར་ལྡན་པར་ཤེས་པར་བྱའོ།",
    "དུས་ནི་འཐབ་མོའི་ས་ཡད་རུང་རྒྱལ་པོ་རྣམས་ཀྱི་གཡས་དང་གཡོན་དུ་འ་གུལ་གལ་ཏེ་མུན་པ་ཅན་གྱུར་ན།",
    "ནོན་མོངས་པ་ལ་སོགས་པ་དང་བྲལ་བ་དང་།",
    "དེ་དབུསཅུད་ཟད་ཡུལ་འདིར་གསལ་བར་བདག་གིས་ད་ལྟར་བསྟན་པའོ།",
    "དོན་དེ་འད་ནི་ནི་མའི་ཤིངརྟ་ཁྱོད་ཀྱིས་ཨེ་སྒང་ལ་སོགས་དོརནས་སེམསཅན་རྣམས་ལ་ཕན་གདགས་པའི་ཕྱིར་བྱེད་པར་གནང་བར་འགྱུར་གྱིས་ཞེ་སྡད་ལ་སོགས་པའི་སེམས་དང་རང་གི་དོན་འགྲུབ་པའི་ཕྱིར་མ་ཡིན་ནོ།",
    "དུམ་བུ་རེ་རེའི་ཚད་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "ཞེས་བྱ་བ་ནི་དཔག་ཚད་འབུམ་ཕྲག་གསུམ་ལས་ཆབཅུ་གཉིས་ཀྱིས་ད་བརྒྱད་ཐོབ་པའི་དཔག་ཚད་སྟོང་ཕྲག་ཉི་ཤུ་རྩ་ལྔ་ནི་དུམ་བུ་རེ་རེའི་ཕྱོགས་བརྒྱད་ཀྱི་ཚད་ཤེས་པར་བྱའོ།",
    "སེམསཅན་གྱིས་བསམ་པའི་དབར་གིས་གཅིག་ལ་སོགས་པའི་དབྱེ་བ་ཐ་དད་པར་གྱུར་པས་ན།",
    "འཆད་པ་བོལ་སྦྱར་བའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་ནང་གི་ལེའུ་བསྟན་པར་མཛ་ད་དེ།",
    "སླར་ཡང་ཉོན་མོངས་པའི་རང་བཞིན་དུ་གྱུར་པའི་སྲིད་པ་འཛིན་པར་མཛད་དེ།",
    "དེ་ལ་ནང་གི་ལེའུ་བསྟན་པར་བྱ་བའི་ཕྱིར་བཅོབ་ལྡན་འདས་ཕྱ་གན་རྡོརྡོའི་སྤྲུལ་པའི་སྐུ་ཟླ་བ་བཟང་པོས་གསོལ་བ་བཏབ་པ་ནི།",
    "དེ་རྒྱ་གང་གི་ཕྱིར་ཞེ་ན།",
    "ཕྱི་ནས་ལོ་བཅུ་གཉས་དང་ལོ་བཅུ་དྲུག་གི་བར་དུ་རིམ་པ་ཇི་ལྟ་བར་ཤེས་རབ་དད་ཟབས་ལ་ཡེགས་ཀྱི་འ་ཕེལ་བ་ནི་རྡུལ་དང་ས་བོན་གྱི་དབྱེ་བས་སོ།",
    "ཉིན་མཚན་རེ་རེ་ལ་རྩ་གཉིས་གཉིས་འཆད་པར་འགྱུར་ལ།",
    "ལོ་བརྒྱ་ཐམ་པ་ཡིས་ཉིན་མཚན་ཁྲི་ཕྲག་གསུམ་དང་སྟོད་ཕྲག་དྲུག་གིས་རྩ་སྟོད་ཕྲག་བདུན་ཅུ་རྩ་གཉིས་འཆད་པར་འགྱུར་ཏེ།",
    "ཕྱི་རོལ་ཏུ་འཐོ་བ་རེ་རེ་ལ་དབྱེ་བ་ལྔ་ལྔ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ནང་དུ་ཡང་རྩ་རེ་རེ་ལས་ཚུལ་སོགས་པའི་དབྱེ་བཞི་པདྨའི་འདབ་མ་རེརེས་སོ།",
    "རྩ་དེ་རྣམས་སྲོག་གི་ངོ་བོ་ཇི་ལྟ་བུར་འབབཅེ་ན།",
    "གཡོན་པ་ནས་ནམ་མཁའི་དཀྱིལ་འཁོར་འབབ་པར་གྱུརཔ་དེ་ལྟ་ན་ནི་ཕྱི་རོལ་དུ་སེར་བཅུ་དྲུག་འབྱུར་བའོ་། རྒྱག་ང་གི་ཕྱིར་ཞེ་ན།",
    "གཡོན་པ་ལ་ཆ་དྲུག་གི་བདག་ཉིད་ཟླ་བ་བདག་པོར་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སྒྱུ་འཕྲུལ་དྲབ་ཕྱོགས་གཅིག་གི་ལྷ་རྣམས་བཞི་བཅུ་རྩ་དགུའོ།",
    "ནངགི་ཕྱག་རྒྱ་རྣམས་གང་ཡིན་པ་དེ་རྣམས་ཐབས་དང་ཤེས་རབ་ཀྱི་རང་བཞིན་དུ་གྱུརཔའི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཤེས་པར་བྱ་བའི་ཕྱིར།",
    "དནི་དུས་ཀྱི་འཁོར་ལོའི་ལྷ་དང་ལྷ་མོ་རྣམས་ཀྱི་གྲངས་བརྗོདཔརམཛདདེ།",
    "དུར་ཁྲོད་ཀྱི་ལྷ་མོ་ཁྱིག་དོངས་མལ་སོགས་པ་བརྒྱད་པོ་གང་ཡིན་པ་དེ་རྣམས་རང་གིས་འཁོར་དང་བྲལ་བའི་དཀྱིལ་འཁོརགྱི་བདག་པོ་དང་ལྷན་ཅིག་ཏུབརྒྱལྔ་བཅུ་རྩ་དྲུག་ཏུ་ཤེས་པར་བྱའོ།",
    "གང་གིསཞེས་བྱ་བ་ལ་སོགས་པས་ཕན་ཡོན་དུགསུངས་སོ།",
    "རྩ་བའིརྒྱུདལས་བསྡུས་པའི་རྒྱུད་ཀྱི་ལྷ་དང་ལྷ་མོ་རྣམས་ཇི་ལྟར་བསྡུས་ཤེ།",
    "དེ་རྣམས་ཀྱི་ནང་གི་རྣམ་པར་དག་པ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "གཙུག་ཏོར་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འཁོར་ལོ་དྲུག་གིས་རྩ་རྣམས་ཀྱི་རང་བཞིན་དུ་གྱུར་པའོ།",
    "དེ་རྣམས་ཀྱིས་སྦྱོརབའི་ཡན་ལག་དྲུག་གིས་འགྲུབ་པར་འགྱུར་ན།",
    "ཞན་མཚན་གཅིག་གིས་འཆི་བར་འགྱུར་རོ།",
    "དེ་ནསཞག་གཅིག་གིས་འཆི་བར་འགྱུར་རོ།",
    "དེ་ནས་ཟླ་བ་གཅིག་དང་ཉིན་མཚན་དྲུག་པོ་དེས་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤྀན་མཚན་བཅུ་དང་ལྔ་དང་གསུམ་དང་གཞིས་དང་གཅིག་གིས་རྩ་བརྒྱད་པ་དང་དགུ་པ་དང་བནུཔ་དང་།",
    "དེ་བཞིན་དུ་ལས་ཀྱི་འཁོར་ལོ་དང་བྱ་བའི་འཁོར་ལོའི་རྩ་སུམ་བརྒྱ་དྲུག་ནུགད་ཡིན་པ་དེ་རྣམས་ལས་རྩ་རེ་རེ་ནི་མཚན་གསུམ་གསུམ་གྱིས་དོར་ཏེ།",
    "གཞན་ཡང་ཉིན་མཚན་དྲུག་གིས་འཆི་བར་གྱུར་པའི་མི་རྣམས་ཀྱིརྩཇི་ལྟར་འཆད་པར་འཐུ་ཞེ་ན།",
    "དོར་བར་བྱེད་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ནང་དུརྩ་རྣམས་ལ་སྲོག་གི་ཀུན་ཏུ་སྤྱོད་པཤེས་པར་བྱ་བའི་ཕྱིར།",
    "འ་དིར་ཟླ་བ་རེ་རེ་ཆུ་ཚོད་ཉི་ཤུརྩ་དགུ་དང་ཆུ་སྲད་བདུན་དང་དབུགས་གསུམ་ནི་ཟླ་བམི་རྒྱུའོ།",
    "དེ་བས་ན་དབུས་མའི་ད་བང་གིས་ལོ་བརྒྱའི་མཐར་མི་རྣམས་འཆི་བ་ཡིན་གྱི།",
    "སྐྱེ་བཞེསབྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་ཞི་ཤུ་རྩ་གཅིག་གིས་དོན་གསལ་བོར་གསུངས་ཤེས་བྱ་བའོ།",
    "ནང་གི་ཐབས་ཀ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཡི་དམ་གྱི་ལྷ་དང་ཕུང་པེ་རྣམས་ཚིམ་པའི་ཕྱིར་གསུང་གི་རྡོ་རྗེ་བཏུང་བ་ཡིན་གྱི་སྨྱོན་པར་བྱ་བའི་ཕྱིར་ནི་མ་ཡིན་ནོ།",
    "ལྟ་བའི་ཁྱད་པར་ནི་སད་ས་རྒྱས་དངམུ་སྟེགས་རྣམས་ལ་ཡོད་པ་ཡིན་གྱི་འཇིག་རྟེན་པ་ལ་མོ་ཡིན་ནོ།",
    "ཆ་དྲུག་གིསརྣམ་པརདབྱེ་བའི་ཕྱིར་རྡུལ་ཕྲ་རབཅེས་བྱ་བ་ནི་མེད་དེ།",
