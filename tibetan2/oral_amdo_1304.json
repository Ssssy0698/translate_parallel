    "དེ་ཡི་མཐུ་ཡིས་སླར་ཡང་དཔའ་མོར་གྱུརཔ་བདག་བོས་ཕྱིར་དོན་མ་ཐོབ་། བམ་ཞེས་བྱ་བ་ནི།",
    "ཀི་ནས་ཁྱོ་ནི་གང་དང་ཁྱོད་ཀྱི་ཁྱིམ་ཐབས་གང་ཡིན་ཀྱེ་མ་མི་དགེའི་ལས་ཀྱིས་བཅིངས།",
    "ཆུང་མ་སྡུག་དང་སྲིང་མོ་སྐལ་བཟངས་བུ་མོ་གསང་བ་སྟེར་ཕྱིར་སྦྱིན་པར་བྱ།",
    "དེ་བཞིན་དུ་གསང་བར་གྱུར་པའི་བུད་མེད་ནི་གསང་བའི་ཕྱག་རྒྱ་ཡིན་ཏེ།",
    "དཔེར་ན་འདིར་གལཏེ་ཟངས་ཀྱིས་གསེར་དེ་ཙམ་དུ་རྙེད་པ་དང་ལྷའི་ཅོད་པན་གྱི་ནོར་བུ་ནི་མཆི་ད་བུ་དུམ་བུསཛཛཾ་དང་གསལ་བར་སྐད་འཆོད་བྱིན་པསམཐོ་རིས་ཀྱི་ལྷ་མོ་དང་པགས་པའི་བུས་གླ་རྩི་ལྟེ་བ་དང་བོར་བུས་རྟ་དང་།",
    "དེ་ལྟར་བརྗོད་པའི་རིམ་པས་འདོད་པའི་རིམ་ནི་རང་གི་རིགས་བསྲུང་བའི་ཕྱིར།",
    "དེ་བས་ན་རིག་པ་འཛིན་པ་ཕྲག་དོག་གི་བསམ་པ་དོར་ནས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་བསྒྲུབ་པའི་དམ་ཚིག་དང་སྡོམ་པ་ལ་གནས་པའི་གང་བྲག་རྣམས་༢ ལ་འདོད་པའི་སྦྱིན་པ་སྦྱིན་པར་བྱ་ཞེས་པ་ནི་ངེས་པའོ།",
    "ཉན་ཐོས་རྣམས་ལ་མཆོད་སྟེན་ལ་སོགས་མཆོག་གི་བདེ་བྱེད་འདོད་འགྱུར་སྦྱིན་པ་རྣལ་འབྱོར་པ་རྣམས་ལ་སྦྱིན་པ་པོ་རྣམས་གང་ཞིག་རབ་ཏུ་དགའ་སེམས་ཀུན་ནས་རྗེས་ཆགས་སེམས་ཀྱིས་སྦྱིན།",
    "རྒྱུ་དེའི་ཕྱིར་དེ་ལ་མི་གང་གིས་སྣོད་པར་བྱེད་པ་དེ་མནར་མེད་པའི་སར་འགྲོ་བར་འགྱུར་བ་བསྟན་པར་མཛད་དོ།",
    "མཆོག་གིས་བདེ་འདོད་དགེ་སློང་དག་གམ་ཀུན་ཏུ་རྒྱུ་རྣམས་ཐམས་ཅད་དགའ་བར་བྱེད།",
    "གཅེར་བུ་མགོ་རེག་དང་ནི་རལ་པ་ཅན་དང་གློག་ཞན་དག་ལ་མཁས་པ་ལམ་ཉན་ནས་ནི་ཞེས་བྱ་བའོ།",
    "དེ་བས་ན་ལུས་དང་ངག་དང་སེམས་སྡུག་བསྔལ་དུ་གྱུར་བས་ན་བདེ་བ་གང་གིས་ཐོབ་པར་འགྱུར་ཏེ།",
    "རད་གི་ལུས་དང་གཞན་གྱི་བསྲུང་བར་བྱའོ།",
    "གང་ལ་ཕྲག་དོག་ཡོད་པ་དེ་ལ་ཆགས་པ་ལ་སོགསཔ་ཉོན་མོངས་པ་ཐམ་ཅད་སྐྱ་བང་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་གཞན་ཡང་ལས་དང་བོ་པ་རྣམས་ཀྱིརང་གི་སྐྱོན་རྔོད་པར་མཛད་དེ།",
    "ས་ཞེས་བྱ་བ་ལ་སོགས་པ་འདི་ལས་དང་པོ་པས་གནས་ཀྱི་ངོས་པ་རང་གནས་ཀྱི་ངེས་པ་མ་ཤེས་པར་གལ་ཏེ་སྔགས་ལ་སོགས་པའི་སྒྲུབ་པར་བྱེད་པ་རེ་ལྟར་ན་ཞི་ཆོ་གས་དམན་པར་གྱུར་པའྀ་ཕྱིའི་དེ་རྣམས་དོན་གྲུབ་བར་མི་འགྱུར་ཏེ།",
    "མི་གང་ཞིག་ལ་རང་གི་ལག་པ་ནས་རལ་གྲི་ལྟུར་བར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་སྔོན་དུ་བརྗོད་པ་ལ་སོགས་པའི་འཇིག་རྟེན་བའི་དངོས་གྲུབ་བསྒྲུབ་པའི་གནས་ཀྱི་རེས་པ་བསྟན་པར་མཛད་དེ།",
    "སྐྱེད་མོས་ཚལ་ཞེས་བྱབ་ལ་སོགས་པའོ།",
    "ཁྱིམ་པ་ཞེས་བྱབ་ལ་སོགས་པ་ལ་འདིར་གདན་ལ་སོགས་པ་དོརན་ས་གནས་དང་མི་མཐུན་པའི་ཁྱིམ་ལ་སོགས་པར་༡གངགིས་ཇི་ལྟ་བ་བཞིན་དུ་བཟླས་པ་ལ་སོགས་པ་བྱེད་པ་དེ་ལ་ཉོན་མོངས་པ་འབའ་ཞིག་སྐྱེད་པར་བྱེད་དེ།",
    "དེབས་ན་མཆོག་ཏུམི་འགྱུར་བའི་བདེ་བའི་རང་བཞིན་དུ་གྱུར་པའི་རང་གི་སེམས་ལས་མ་གཏོགས་པར་གཞ་ན་མ་གང་གི་ས་ཀྱང་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་བསྒྲུབ་པར་མི་འགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོརྗེས་གསེལ་བམཛད་བ་རུད་ཟད་ཅེས་བྱ་བ་ལ་སོག་སོ་པ་ལ་འདིར་བཅོམ་ལྡན་འདས་དེས་ཀྱི་འཁོར་ལོ་ལྷ་དང་ལྷ་མོལྷན་ཅིག་བསྒྲུབ་པ་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དེ་དག་གིས་ཅུང་ཟད་ཤེས་པར་བྱའོ།",
    "རྒྱ་གང་གི་ཕྱིར་ཞེ་ན།",
    "དུས་ཁ་ཅིག་གི་བར་དུ་ནི་མ་ཡིནནོ།",
    "དུས་ཁ་ཅིག་གི་བར་དུ་ནིམ་ཡིན་ནོ།",
    "དངོས་པ་དེ་ལྟ་བུ་གང་ཡིན་པ་དེ་བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལོ་ཡིན་གྱི་བུམ་པ་དང་རི་བོད་གི་དྲལ་སོགས་པ་མ་ཡིན་ནོ།",
    "ཡི་གེ་ཀཱལ་སོགས་པ་རྣམ་ས་ཀྱི་བརྡའི་ཚིག་གིས་ཤེས་པར་བྱའོ།",
    "དེ་གང་གིས་གསུངས་ཤེ་ན།",
    "དེ་རྣམས་ལས་ལྷ་དང་ལྷ་མོ་རྣམས་སུ་སྐྱེ་བར་གྱུར་པའོ།",
    "རིགས་དྲུག་པོ་དེ་ལས་བྱད་རྐུབ་སེམས་དཔའ་༣ལ་སོགས་པ་དང་ལྷ་མོ་རྣམས་སྐྱེས་པའོ།",
    "ཡི་གེ་སུམ་ནུརྩ་དྲུག་པོ་ག་དེ་ལ་ས་ལྷ་དང་ལྷ་མ་རྣམས་གང་སྐྱེད་པ་དེ་རྣམས་ཀྱི་ནང་གི་དག་པ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "དེབས་ན་ཕུང་ལ་བོ་དྲུག་ལ་སོགས་པའི་རྣམ་པར་དག་པས་ལྷ་དང་ལྷ་མོ་སུམ་ནུརྩ་དྲུག་ཏུ་ཤེས་པར་བྱའོ།",
    "འོན་ལྷ་དང་ལྷ་མོ་དོན་མས་ཀྱི་ཡན་ལག་རྣམ་པར་དག་པ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "དེ་དག་ལས་ཕུང་པོ་ལསེགས་པ་རྣམས་རིམ་པས་སྐྱེ་བ་ཇི་ལྟ་བ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་དང་ལྷ་མེ་རྣམས་ཕྱི་རོལཏ་ཤེས་པར་བྱའོ་། ལྷ་དང་ལྷ་མེ་རྣམས་ནང་གི་གནས་གང་ནས་སྐྱེ་བར་འགྱུར་ཞེ་ན།",
    "དག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་འདིར་ལེ་བཅུ་དྲུག་གི་སྟེང་ནས་ཁམས་དྲུག་གི་རང་བཞིན་གྱི་མི་རྣམས་ཀྱི་སེམས་སྦྱོབ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཁམས་དྲུག་གི་རང་བཞིན་དུ་གྱུར་པའི་སྒྲིབ་པ་མེད་པའི་དཔྲལབ་ལ་སོགས་པའི་འཁོར་ལོ་དྲུག་ལས་ལྷ་མེ་རྣམས་སྐྱེ་བར་འགྱུར་བར་ཤེས་པརབྱའོ།",
    "འོན་ཐབས་རྣམས་ལས་ཤས་ཆེ་བར་གྱུར་པའི་ཐབས་ཀྱི་རྒྱ་རྣམས་ཀྱིས་ལྷ་དང་ལྷ་མོ་རྣམས་ཀྱི་མཚ་ན་ཉིད་ཇི་ལྟ་བུ་ཡིནཞེ་ན།",
    "འདིར་འཁོར་ལོ་སྡོམ་པའིརྩ་བའི་རྒྱུད་ཀྱི་གཞུང་གིས་ཐིག་དགུ་བཙུརྩ་དྲུག་བཏབ་ནས།",
    "མཁའ་འགྲོ་མ་རྣམས་ཤེས་བྱ་བ་ལ་སོགས་པ་ཡིས་དཔའ་བོ་དང་དཔའ་མོ་རྣམས་ཀྱི་མཚན་ཉིད་བསྟན་ཏོ།",
    "ལྷ་མོ་ཞེས་བྱ་བ་ལསོགས་པའོ།",
    "འདིར་ཕྱི་རོལ་ཐུནམཚམས་བཞིའི་དབྱེ་བས་ལྷག་པར་བྱེད་པ་ལ་སོགས་ནི་ལྷ་མོ་རྣམས་ལ་ཇི་ལྟར་གྱུར་པ་དེབཞིན་དུནང་དུ་སྲོག་པགིས་ཀུནཏུ་སྤྱོད་པས་། ས་ལ་སོགས་པའི་དཀྱིལ་འཁོར་རྣམས་ལས་ཤེས་པར་བྱའོ།",
    "འདིར་ཕྱི་རོལ་ཏུ་དཔའ་བོ་དང་དཔའ་མ་རྣམས་གར་ཡིན་པ་དེ་རྣམས་ཀྱི་ནང་གི་སྐྱེད་པར་བྱེད་བའི་རྒྱུགར་ཡིན་ཞེ་ན།",
    "དེ་ལྟ་བུའི་ལྷ་དང་ལྷ་མོ་རྣམས་གང་ཡིན།",
    "གཡས་པའི་གསུང་གི་ཞལ་དང་།",
    "དེ་བཞིན་དུ་སྐལ་པ་དང་ལྡན་པར་གྱུད་པའི་སེམསཅན་རྣམས་ལ་རང་གི་སེམས་དག་པར་གྱུར་ན།",
    "རང་རད་གིས་ཡོན་ཏན་བཟུང་བའི་ཕྱིར་རོ།",
    "དེ་རྣམས་མཆོ་ག་ཏུ་མི་འགྱུར་བའི་རར་བཞིན་དུ་གྱུར་ན་རང་གི་དོན་དང་གཞན་གྱི་དོན་འགྲུབ་པར་གྱུར་ལ་བསྟན་པར་མཛད་དེ།",
    "རྒྱུ་དེའི་གང་གི་ཚེ་ཕུར་པོ་རྣམས་སྒྲིབ་པ་མེད་པའི་དུས་དེ་ནས་བཟུང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་མི་སྐྱེབ་དར་མི་འཇིག་པ་སྟེ།",
    "རང་གི་དོན་འགྲུབ་པར་མི་འདོད་པའི་སེམས་ནི་བདུན་ཀྱི་སེམས་ཡིན་གྱི།",
    "དེ་བས་ན་རང་གི་དོན་དང་གཞན་གྱི་དོན་ཉམས་པར་བྱེད་པ་ཀྑཱུཟླ་པོ་ནི་བདུད་ཡིན་ཏེ།",
    "རྒྱུགང་གི་ཕྱིར་ཞེ་ན།",
    "དབྱུགས་པ་གློག་གི་རྗེས་མཐུན་འཕོམེད་བདེ་བ་སྐྱེད་བྱེད་མཚན་དང་ཡན་ལག་རྫོ་གས་པའོ།",
    "ཏེ་དེ་རྣམས་ལྟེ་བར་ཕྲད་པར་གྱུར་ན་ལྟེ་བར་གནས་པའི་ཡེ་ཤེས་ཀྱི་མེའི་རང་བཞིན་དུ་གྱུར་པའི་གཏུམ་མོ་སྦར་བའོ།",
    "དེ་རྡོརྗེ་བཙུན་མོའི་བྷ་གར་བཞུགས་ཤེས་བྱ་བའོ་ དེ་བཞིན་དུ་སྒྲ་ལསོགས་པའི་ཡུལ་རྣམས་ལསེམས་འཇུག་པཞི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ལ་ཞུགས་པའོ།",
    "དེ་བཞིན་དུ་རྒྱུད་ཀྱི་རྒྱལ་པོ་རྣམས་ལས་འདི་སྐདབདག་གིས་སྤོས་པ་ཞེས་བྱ་བ་གང་ཡིན་པ་དེ།",
    "རང་རིག་པའི་ཕདེ་བའི་ངོ་བོས་དཔྲལ་བ་ལསོགས་པའི་འཁོར་ལོ་རྣམས་ལས་མར་བྱོན་ལ་ལུས་དང་ང་ག་དང་སེམས་ཀྱི་ཐིག་ལེ་གསུམ་གྱི་མཐའ་མར་ཡེ་ཤེས་ཀྱི་ཐིག་ལེའི་ངོ་བོས་ལྷན་ཅིག་སྐྱེས་པའི་བདེ་སྟེར་ནས་བུད་མེད་ཀྱི་བྷ་གར་འཕེ་བར་གྱུར་པ་དེ་དྲང་བའི་དོན་གྱིས་བཅོམ་ལྡན་འདས་རྡོ་རྗེཅན་ཡིན་ཏེ།",
    "དེ་ལྟར་མཆོག་ཏུ་མི་འགྱུར་པའི་རང་བཞིན་བཅོམ་ལྡན་འདས་གང་ཡིན་པ་དེ་སེམསཅན་རྣམས་ཀྱི་རང་རང་གི་བག་ཆག་༦་ཀྱི་དབྱེ་བ་དུ་མས་ཐ་དད་པར་མཐོང་བར་མཛད་དེ།",
    "འདིར་བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལདང་སྣ་ཚོགས་ཡུམ་ནི་ཐབས་དང་ཤེས་རབ་ལ་སྙོམས་པར་ཞུགས་པ་དེ་ོ་བོ་གང་ཞིག་ཡིན་གྱི་སྐྱེས་བུ་དང་བུད་མེད་ཀྱི་སྦྱོར་བ་ཞི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུདཀར་མེ་འབརབ་ལ་སོགས་པ་ལྷ་མོ་རྣམས་གང་ཡིན་པ་དེ་སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་བ་རྣམས་སམ་ཡད་ན་དུ་བ་ལ་སོགས་པའི་རྟགས་རྣམས་ཤེས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལོའི་ཞབས་གཞིས་ཀྱིས་གདན་དུ་གྱུར་པའི་འདོད་པའི་ལྷ་དང་དྲག་པོ་ནི་ག་ཡས་པ་དང་གཡོན་པའི་དཀྱིལ་འཁོར་ལྔ་ལྔའི་རང་བཞིན་དུ་གྱུར་པའི་བདུད་དང་ཉོན་མོངས་པ་ཟད་པའོ།",
    "བཅོམ་ལྡན་འདས་དོན་ཡོད་གྲུབ་པའི་མཚནམ་རལ་གྲི་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་གཅོད་པར་བྱེད་པའོ།",
    "རིགས་དྲུག་ནི་དེརྣམས་ལས་ལྷ་དང་ལྷ་མོ་དང་ལྷ་རྣམས་གང་སྐྱེས་པར་གྱུར་པ་དེརྣམས་ཀྱད་དེ་བཞིན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ལྟར་བརྗོད་པའི་རིམ་པས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣད་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་དྲུག་གི་སྒྲིབ་པ་མེད་པའི་དངོས་བོ་ཐམསཅད་སྐྱེད་པར་མཛད་པའི་ཕྱིར་རིགས་དྲུག་ཏུ་གྱུར་པའོ།",
    "ཞེས་བྱ་བཞི། ། བླང་བྱ་དང་དོད་བྱ་ལ་སོགས་པ་མི་ཤེས་པའི་བློ་གདདུ་ཉམས་པར་གྱུར་པའི་སྒྲིབ་པ་མེད་པའི་སའི་ཁམས་ནི་ལྷ་མོ་སྤྱན་མ་སྟེ།",
    "གང་དུ་བུད་མེད་དང་བྱིས་པ་ལ་སོགས་ཕྲག་དོག་ཉམས་པར་གྱུར་པའི་སྒྲིབ་པ་མེད་པའི་རླུད་གི་ཁམས་ནི་ལྷ་མོ་སྒྲོལ་མ་ཡིནཏེ།",
    "ཉོན་མོངས་པ་རྣམས་ལཞེ་སྡང་མཛད་ཅེས་བྱ་བའོ།"
  ]
}