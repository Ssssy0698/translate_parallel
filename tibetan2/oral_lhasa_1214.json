    "དེ་དག་ནི་གཅོད་པར་བྱ་བ་ཡིན་ནོ།",
    "དབུག་པར་བྱ་བའི་རྩ་ཞེས་གྲགས་སོ།",
    "དེའི་དབྱེ་བ་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་ཁྲག་གོཟག་པར་མི་བྱའོ།",
    "ཚད་ལས་འདས་པར་མི་བྱའོ།",
    "དེ་ནས་ལེགས་པར་དྲལ་ཞིང་གཏོར་རོ།",
    "ཁྲག་དག་པར་འགྱུར་ན་ནི་གཅད་པར་བྱའོ།",
    "དེ་ལྟར་གཏར་ག་བྱས་ཟིན་པ་དང་།",
    "དེ་ནས་ཞག་གསུམ་གཞན་དང་མ་འདྲེས་པའི་ཆུ་ཉི་ཚེ་སྦྱིན་པར་བྱའོ",
    "ལོ་གསུམ་ཕན་ཆད་ནི་གཏར་ག་རྣམས་ཀྱིས་སྦྱངས་བར་བྱས་ལ་དེ་ཚུན་ཆོད་ནི་མཚོན་གྱིས་ཞལ་ཞལ་བྱ་བ་དང་།",
    "དེ་མ་ཐག་གཏར་ག་བྱས་ན་བསྔགས་སོ།",
    "རྟའི་ཚེའི་རིག་བྱེད་ལས་སེང་གེས་བྱིན་པས་བྱས་པའི་ལས་གཏར་དཔྱད་ཀྱི་ལེའུ་སྟེ་དགུ་བའོ།",
    "གནས་ངན་པར་སྒྲོག་ཏུ་བཅུག་གམ་བཅིངས་པ་དང་འདུ་གནས་ངན་པར་བཞག་པ་དང་།",
    "ཧ་ཅང་སྣུམ་ཆེས་པའི་སྦྱོར་བ་བྱས་པ་དང་།",
    "བུ་གུར་གར་འགྲོ་བའི་ལམ་ཡང་དག་པར་བཀག་ནས།",
    "ཉམས་ན་རྟག་པ་འགགས་ཤིང་ཤིན་ཏུ་མི་བཟོད་པར་སྤོ་སྟེ།",
    "སྣེ་ཧ་པར་རྩ་ཞེས་བྱ་བ་དང་།",
    "སྣུམ་གྱི་བཏུང་བ་སྦྱོར་བ་ལོག་པར་བླུད་པས་ཉེས་པ་སོགས་ཏེ།",
    "རྒྱམ་ཚྭ་དང་བཅས་པ་དྲོ་འཇམ་ཙམ་སྲང་དྲུག་ཅུ་རྩ་བཞི་མས་བཏང་བར་བྱས་ན་ཕན་ནོ།",
    "དེ་བས་ན་མས་བཏང་བས་དག་པར་འགྱུར་བ་དང་།",
    "དེའི་མཚན་མ་ནི་རབ་ཏུ་རྨོངས་པར་འགྱུར་བ་དང་།",
    "འདར་བར་གྱུར་པའི་རྟ་དེ་ནི་གཅིན་འགགས་པ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།་",
    "སྦྲང་རྩི་དང་ལྡན་པའི་ཆུ་བླུད་པར་བྱའོ།",
    "ཕྱེ་མ་བུ་རམ་དང་བཅས་པ་བླུད་པར་བྱའོ།",
    "ཤུ་དག་དང་འདི་རྣམས་ཀྱི་ཕྱེ་མ་སྦྱོར་བ་དང་ལྡན་པར་བུར་མར་བསྲེགས་ཏེ།",
    "ནུས་པའི་རྟ་དེ་ནི་ངེས་པར་འཆི་བ་ཡིན་ནོ།",
    "ཉམ་ཐག་པར་འགྱུར་བའི་རྟ་དེ་ནི།",
    "དེས་རྟའི་གཅིན་རབ་ཏུ་ཚ་བ་མང་བོའམ་ཉུང་དུ་འཛག་པར་འགྱུར་ཏེ།",
    "བཏུང་བར་ནི་ག་ཀོན་གྱི་ས་བོན་རྩ་བ་ཤ་དུར་དང་ཆ་མཉམ་པར་འབྲས་བཀྲུས་པའི་དང་།",
    "བུ་བོར་བའི་ཁུ་བ་ལེགས་པར་དྲངས་པའི་ནང་དུ་ཀ་ར་དང་རམ་དང་ལྡན་པ་རྟ་ལ་བླུད་དོ།",
    "སྟོན་འདི་རྣམས་ཀྱི་ཕྱེ་མ་ཆང་ལ་བཏབ་སྟེ་བྱུག་པར་སྦྱར་རོ།",
    "སྦྲང་རྩི་དང་སྦྱར་བའི་ལྡེ་གུ་སྦྱིན་པར་བྱའོ།",
    "ལོ་མ་བཏགས་བའི་ཕྱེ་མས་བཏབ་སྟེ་སྦྲང་རྩི་དང་ལྡན་པར་བྱིན་ན་ཀོ་ར་དུ་ཤ་ཞེས་བྱ་བའི་རྟུག་པ་འགགས་པ་ཞི་བར་བྱེད་དོ།",
    "སྣུམ་ཚད་དང་མི་ལྡན་པར་བྱིན་པ་དང་།",
    "འཇམ་རྩི་མས་བཏང་བ་ལོག་པར་སྦྱོར་བའི་རྒྱུས་མེའི་དྲོས་ཉམས་པར་གྱུར་ཏེ།",
    "ཚིགས་ཀུན་སྐྲངས་མགོ་ན་བ་དམིགས་སུ་ཤེས་པར་བྱས་ནས།",
    "སྣུམ་དེ་གསུམ་བསྐོལ་བའི་ཁུ་བ་གཞི་བྱས་པ་དང་།",
    "མར་འདུས་པ་ལས་བསྐུ་བྱུག་བྱས་ལ།",
    "དེ་ལྟར་མས་བཏང་བ་འདི་བྱས་པའི་འོག་ཏུ་རྟ་ལ་དུར་བྱིད་དང་བཅས་པའི་ཨ་ནུ་བ་ས་ན་མས་གཏང་བར་བྱའོ།",
    "ཆུ་དང་ལྷན་ཅིག་རིམས་ཀྱིས་ཉམ་ཐག་པའི་རྟ་ལ་གཏོར་ཞིང་བླུད་པར་བྱའོ།",
    "རྟའི་སྤྱི་བོ་ལ་བྱུག་པར་བྱའོ།",
    "འདུས་པ་ལས་གྱུར་པའི་རིམས་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "རྒོད་མ་དང་མང་དུ་སྦྱར་བའི་རྒྱུས་རྟའི་ཡིད་མི་བདེ་བར་གྱུར་པའི་རིམས་ཀྱིས་འདེབས་པར་འགྱུར་རོ།",
    "ལུས་ཐམས་ཅད་སྙོམ་པར་བྱུག་པ་བྱས་ན།",
    "སྦྲང་རྩི་དང་ལྡན་པར་བླུད་དོ།",
    "ལེགས་པར་དྲོངས་ལ་ནུབ་ཅིག་གམ་ཞག་ཡང་བསྐོལ་ཏེ།",
    "ལོན་པར་བྱས་པའི་འོ་ཐུག་དེའི་ནང་དུ་སྦྲང་རྩི་དང་ལྡན་པར་རྟ་ལ་བླུད་ལ་ཆུ་བཏུང་བ་ནི་སྤང་བར་བྱའོབྱས་ཏེ།",
    "རྩ་བ་རྣམས་ཀྱི་ཕྱེ་མ་སྦྲང་རྩི་དང་སྦྱར་བ་སྦྱིན་པར་བྱའོལྔ་བསྐོལ་བའི་ཆུ་ནང་དུ་འབྲས་དྲུག་ཅུ་བ་བསྐོལ་བའི་ཆན་ལ་ཞོ་བཅུག་པ་སྦྱིན་པར་བྱའོ།",
    "ཀུ་ནན་ན་ཏ་འདི་རྣམས་བསྐོལ་ཏེ་དྲངས་པའི་ནང་དུ་སྦྲང་རྩི་དང་ལྡན་པས་བླུད་པར་བྱའོ།",
    "པི་པི་མིང་འདི་རྣམས་བཏགས་པའི་ཕྱེ་མ་ཆང་ཟན་ལྟ་བུར་བྱས་ཏེ་སྦྱིན་པར་བྱའོ།",
    "ཡང་ན་འབྲས་དྲུག་ཅུ་བའི་ཆན་ལེགས་པར་ཚོས་པའི་ནང་དུ།",
    "རྩྭ་བཟའ་བ་ལ་སོགས་པ་འཁྲུ་བའི་མཚན་ཉིད་ཕྱིན་ཅི་ལོག་ཏུ་སྣང་ན་ནི་རྟ་དེའི་འཚོ་བ་ཟད་ཟིན་པ་ཡིན་པར་ཤེས་པར་ལ་བྱའོ་ སེང་གེས་བྱིན་པས་བྱས་པའི་རྟ་དཔྱད་ལས།",
    "ཆུ་འཐུང་ན་ཁྱད་པར་དུ་ཡང་ནས་ཡང་དུ་ལུ་བ་ཡིན་ཏེ།",
    "རྩ་དུར་བའི་རྩ་བ་འདི་རྣམས་བསྲེགས་པའི་དུད་པས་རྟ་ལ་བདུག་པར་བྱའོ།",
    "བཏུང་བར་ནི་བར་ད་ཀ་བསྐོལ་བའི་ཁུ་བ་སྦྱིན་པར་བྱའོ།",
    "དབུགས་མི་བདེ་བ་དང་བཅས་པར་ལུ་བ་དང་།",
    "མར་དང་སྦྲང་རྩི་དང་ལྡན་པའི་ལྡེ་གུ་བྱས་ཏེ།",
    "ཤུག་པ་འདི་རྣམས་མར་དང་སྦྱར་བས་སྣར་བདུག་པ་བྱས་ལ།",
    "པི་པི་ལིང་དང་ལྡན་པར་བླུད་པའམ།",
    "མར་དང་སྦྲང་རྩི་དང་ལྡན་པར་སྦྱིན་པར་བྱའོ།",
    "ལུད་པ་ཁྲག་དང་བཅས་པར་འབྱུང་ལ།",
    "དེ་ལ་རའི་འོ་མ་ཏའི་ལུས་རབ་ཏུ་སྐེམ་པར་འགྱུར་རོསྲི་ག་ཏོ་ག་དང་།",
    "དང་ལྷན་ཅིག་སྦྱིན་པར་བྱའོ།",
