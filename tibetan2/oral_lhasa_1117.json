    "ཕྱག་དྲུག་པ་ནི་རྣམ་པར་བསྒོམ།",
    "དགྲ་སྟ་ཞགས་པ་སྡིགས་པར་བཅས།",
    "ཐ་མ་ལ་ཞགས་པ་སྡིགས་མཛུབ་ལ་དཀྲིས་ཤིང་བསྡིགས་པར་བྱེད་པའོ།",
    "སླར་བྱོན་ཅིང་ཤར་ཕྱོགས་ཀྱི་སྒོ་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་གདན་ལ་གཤིན་རྗེའི་སྟེང་དུ་བརྐྱང་བསྐུམ་གྱི་ཚུལ་དུ་གཟུངས་དང་བཅས་པར་གནས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ནི་སྐུལ་རྒྱན་གྱི་ཚུལ་དུ་ཐོད་ཆིངས་དང་རྐེད་ཆིངས་ལ་སོགས་པ་སྦྲུལ་ལས་བྱས་ཤིང་འོད་ཟེར་བསྐལ་པའི་མེ་ལྟར་འབར་བ་ཕྱོགས་བཅུར་འཕྲོ་བའི་དོན་ཏོ།",
    "འབར་བའི་དབུ་ནི་བརྟན་པར་བཅིངས།",
    "ཞལ་གསུམ་དག་ནི་རྣམ་པར་གདངས།",
    "དེ་ཡང་འཇིགས་པར་བྱེད་པའི་ཕྱིར་ཁྲོ་གཉེར་རིམ་པ་མང་བ་དང་སྤྱན་ཤིན་ཏུ་དམར་བར་བསྟན་ཏོ།",
    "ཁྲོ་བོའི་རྒྱན་གྱི་ཁྱད་པར་ཐོད་པ་ལ་སོགས་པ་རྣམས་སོ།",
    "ཕྱག་དྲུག་པ་ནི་རྣམ་པར་བསྒོམ།",
    "ཞེས་པ་ལ་སོགས་པས་ཕྱག་དྲུག་ལ་ཕྱག་མཚན་རིམ་པ་བཞིན་དུ་ཤེས་པར་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་གཉིས་མེད་བསྐྱེད་པར་བྱ།",
    "ཞེས་པ་ནི་སྔགས་འདིས་བསྐུལ་ཞིང་ཡི་གེ་ཧྲི་འམ་ཧཱུཾ་ལས་གོང་མ་བཞིན་དུ་ཁྲོ་བོ་ཧྱ་གྲྀ་བ་བསྐྱེད་པར་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ལ་རྡོ་རྗེ་གཉིས་མེད་ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་དང་པདྨོ་སྦྱོར་བའི་ཕྲིན་ལས་ལ་པདྨའི་རིགས་ཁྱད་པར་དུ་བསྟན་པའི་ཕྱིར་རོ།",
    "ཞལ་ནི་ཁྲོ་གཉེར་མཛད་པ་ནི་ཤིན་ཏུ་ཡང་ཁྲོ་བའི་ཆ་ལུགས་འཇིགས་པར་མཛད་པའོ།",
    "བདུད་རྩི་འཁྱིལ་པ་བསྐྱེད་པར་བྱ།",
    "ཁམས་གསུམ་བྲེད་པར་བྱེད་པའི་གད་རྒྱངས་ཆེན་པོའི་གསུང་འབྱིན་པའི་དོན་ཏོ།",
    "དེ་ལ་ཞལ་གསུམ་ལ་དབུས་མ་སྐུ་དང་མཐུན་པར་གཡས་དཀར་ཞིང་གཡོན་དམར་བའོ།",
    "ཕྱག་ན་གཏུན་ཤིང་གསོད་པར་གནས།",
    "གསོད་པར་གནས་པ་བགེགས་རྣམས་ལ་རྡེག་པའི་ཚུལ་དུ་འཛིན་པའོ།",
    "གཡོན་པའི་ཕྱག་ཏུ་རྣམ་པར་བརྟག།",
    "ཅེས་པ་ཡང་རིམ་པ་བཞིན་དུ་འཛིན་པར་ཤེས་པར་བྱ་བའི་དོན་ཏོ།",
    "འདི་རྣམས་ཀྱི་རྒྱན་དང་ཆ་ལུགས་ལ་སོགས་པ་ནི་སོ་སོའི་བདག་པོ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་བཞི་དང་གོང་དུ་བསྟན་པ་བཞི་ཚུལ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "གཟུགས་ཀྱི་ངོ་བོར་རྣམ་པར་བསྒོམ།",
    "སེམས་དེ་བཀུག་ནས་པད་བཞུགས་ལས།",
    "བསྒྲུབས་ནས་སེམས་དཔའ་བསྒྲུབ་པར་བྱ།",
    "རྡོ་རྗེ་སེམས་དཔར་དེ་འགྱུར་རོ།",
    "ཞེས་པའི་བར་དུ་ནི་སྒྲུབ་པ་ཆེན་པོའི་ཡང་ཆེན་པོར་ཤེས་པར་བྱའོ།",
    "གསལ་བར་གྱུར་པ་དང་གོང་མ་བཞིན་དུ་གཅིག་ནས་དཔག་ཏུ་མེད་པའི་བར་དུ་སྤྲོ་ཞིང་བསྡུ་བས་སེམས་སྦྱངས་ལ་སྒྲུབ་པ་ལ་འཇུག་པར་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "བརྟན་པར་གྱུར་ནས་རིན་ཆེན་སྤྲོ།",
    "བརྟན་པར་མ་གྱུར་ཡོང་མི་སྤྲོ།",
    "ཞེས་པ་ནི་གོང་མ་ལྟར་མངོན་སུམ་དུ་མ་གྱུར་པར་སྤྲོ་བར་མི་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ལྟར་བསྒོམས་པར་བརྟག་པ་སྟེ།",
    "འཁོར་ལོ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "སྤྲོ་བའི་བདག་ཉིད་ནི་ཡུངས་ཀར་ལ་སེམས་སྦྱངས་ཤིང་ལས་སུ་རུང་བར་བྱས་པའི་རྣལ་འབྱོར་པ་ཉིད་དོ།",
    "དཀྱིལ་འཁོར་གྱི་ལྷ་ཐམས་ཅད་དུས་གཅིག་ཏུ་གྲངས་མེད་པར་སྤྲོ་བའོ།",
    "རྡོ་རྗེ་བཟླས་པ་བརྩམ་པར་བྱ།",
    "རྡོ་རྗེ་མི་ཕྱེད་གསུམ་རྫོགས་པར།",
    "སྐུ་གསུང་ཐུགས་ནི་བདག་མེད་པར།",
    "འཕགས་པའི་སྐུ་གསུང་ཐུགས་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱིས་སོ་སོའི་བྱེ་བྲག་ཏུ་དོན་དམ་པའི་རང་བཞིན་སྟོང་པ་ཉིད་དུ་དམིགས་ལ་དེའི་དོན་ལ་གནས་པར་བྱ་སྟེ།",
    "ཞེས་པ་ནི་ལྷ་གང་ཡང་རུང་བའི་ས་བོན་གྱི་ཡི་གེ་ལས་བསྐྱེད་ཅིང་གཟུངས་དང་བཅས་པར་གནས་ལ།",
    "བཟླས་པར་གསུངས་པ་དོན་དམ་པ།",
    "ཧཱུཾ་ལ་སོགས་པ་བཟླས་པར་འདོད་ན་ཡང་རྡོ་རྗེ་ཚིག་ཏུ་བྱའོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་བསྒྲུབ་པར་བྱ།",
    "དེ་ཡང་ཡན་ལག་བཞིའི་སྒོ་ནས་བསྒྲུབས་ནས་གོང་དུ་བསྟན་པའི་ཚུལ་དུ་ཞག་བདུན་གྱི་བར་དུ་སྒྲུབ་པ་ཆེན་པོའི་ཚུལ་བཞིན་དུ་བྱས་ནས་འབྲས་བུ་འཐོབ་པར་འགྱུར་བའི་དོན་ཏོ།",
    "དྲག་ཤུལ་སྦྱོར་བས་བསྒྲུབ་པར་བྱ།",
    "གནང་བ་བྱིན་པ་ཡིན་པས་དེ་ལ་དངོས་གྲུབ་སྩོལ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "རྡོ་རྗེ་སེམས་དཔར་དེ་འགྱུར་རོ།",
    "བསྐུལ་བ་དག་ཏུ་རྣམ་པར་བསམ།",
    "ཞེས་པར་འབྲེལ་ཏོ།",
    "བདེ་བ་མཆོག་ལ་བཞེས་པ་ཡིས།",
    "འདོད་པ་བདེ་བཞི་དོན་གྱིས་ཞེས་བྱ་སྟེ་རྡོ་རྗེ་དང་པདྨར་ཡང་དག་པར་ལྡན་པའི་འདོད་ཆགས་ཀྱི་བདེ་བ་ཆེན་པོའི་སྒོ་ནས་ཞི་བའི་དོན་མྱ་ངན་ལས་འདས་པའི་རང་བཞིན་དུ་གནས་པར་འདོད་པའི་ཕྱིར་རོ།",
    "བསྐུལ་བའི་ངག་ཏུ་རྣམ་པར་བསམ།",
    "དེ་མི་སྤོང་ཞིང་དང་དུ་ལེན་པར་བཞེད་པའོ།",
    "ཀུན་དུ་བཟང་པོའི་ཚུལ་ཐོབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྣམ་པར་སྣང་མཛད་དགའ་ཆེན་པོ།",
    "དེ་ལ་རྣམ་པར་སྣང་མཛད་ནི་སྐུ་ལས་འོད་སྣ་ཚོགས་འཕྲོས་ཤིང་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་མུན་པ་སེལ་ཤིང་སྣང་བར་མཛད་པ་དང་།",
    "དེ་ཉིད་གཞན་ལ་བསྟན་ཞིང་ཐོབ་པར་མཛད་པས་རྡོ་རྗེ་སྟོན་པའོ།",
    "དེ་ལྟ་བུ་ཡིན་ཡང་དོན་དམ་པར་དམིགས་པ་མེད་པའི་ཚུལ་ཡིན་པས་ནམ་མཁའ་རྡོ་རྗེའོ།",
    "རྣམ་པར་མི་རྟོག་རྡོ་རྗེ་མཁའ།",
    "བསམ་པ་ཐམས་ཅད་རྫོགས་པར་མཛད།",
    "སྣ་ཚོགས་རྗེས་སུ་ཆགས་པར་མཛད།",
    "གཟུགས་བརྙན་དུ་བཀོད་པ་རྣམས་དེ་ལྟར་ཉིད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་རང་བཞིན་དུ་བསྡུ་བར་བྱས་ནས་ཞེས་པའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣལ་འབྱོར་པས་དུས་ཡུན་རིང་པོར་སྒོམ་ཞིང་སྒྲུབ་པའི་ཚེ་ལུས་ཉམ་ཆུང་བར་གྱུར་ན་ཐབས་འདིས་གཟི་བྱིན་བསྐྱེད་ཅིང་བརྟན་པར་བྱ་བ་བསྟན་ཏོ།",
    "ཐེ་ཚོམ་མེད་པར་གྱུར་པ་ཡིན།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟར་བསྒོམས་པའི་ཕན་ཡོན་བསྟན་ཏེ་ཡེ་ཤེས་ཀྱི་སྦྱོར་བ་དེ་བསྟན་པ་བཞིན་དུ་མ་ནོར་བར་བསྒོམས་ན་གཟི་བྱིན་སྐྱེ་ཞིང་བསྟན་པར་ངེས་པའོ།",
    "སྦྱོར་བ་འདི་ནི་རྣམ་པར་བསམ།",
    "དེ་བྱས་ན་བཀྲེས་བ་ལ་སོགས་པའི་སྡུག་བསལ་ཐམས་ཅད་མེད་པར་འགྱུར་བར་ངེས་པའི་ཕྱིར།",
    "མི་གཙང་རྡོ་རྗེ་ཚིག་བཞིན་ཏེ།",
    "མི་གཙང་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་ཆེན་པོའོ།",
    "བདག་ལྷ་གང་བསྒོམ་ཡང་རུང་སྟེ་བཀྲེས་པ་ལ་སོགས་པ་བྱུང་ན་དེ་མ་ཐག་ཏུ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱར་བསྒོམས་ལ།",
    "སྐུ་སོགས་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "ཞེས་པ་ལ་སོགས་པ་ནི་ཕྱི་རབས་ཀྱི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཡིད་མི་ཆེས་ཤིང་སྐུར་བ་འདེབས་པར་དགོངས་ནས་རྒྱུད་ཀྱི་ཁུངས་ལ་སོགས་པ་བསྟན་ཏོ།",
    "ཉིད་ལ་ཉིད་སློབ་དཔོན་ཞེས་གསུངས་པ་ནི་ཡུལ་ཐམས་ཅད་དུ་སློབ་དཔོན་དུ་གྲགས་པ་དང་མཁས་པར་ཞལ་གྱིས་འཆེས་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཚེ་འདི་ཉིད་ལ་མ་གྲུབ་ན་ཡང་འདི་ཤེས་ཤིང་ཐོས་པར་གྱུར་ན་རྒྱུད་གསང་བ་འདུས་པ་ཤེས་བར་འགྱུར་ལ།",
    "དེ་ཤེས་པས་གསང་སྔགས་རྣམས་ལ་མཁས་པར་འགྱུར་བ་དང་ཐ་སྙད་ཐམས་ཅད་ལ་མཁས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དོན་ནི་རྣམ་པར་རྟོགས་པར་ཤོག།",
    "སྐྱིལ་ཀྲུང་རྣམ་པར་རོལ་པས་བཞུགས།",
    "མི་འགྱུར་ཐིག་ལེར་རྣམ་པར་ཞུ།",
