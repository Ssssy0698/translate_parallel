    "དེ་ཡང་གང་ཞེ་ན་ཐབས་དང་ཤེས་རབ་གཉིས་སུ་མེད་པའི་ཚུལ་བསྒོམས་ཤིང་བསྒྲུབས་པས་བདེ་བ་ཆེན་པོའི་ངང་དུ་གྱུར་པ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའོ།",
    "དེའི་འོད་ཟེར་གྱིས་མ་རྟོགས་པ་དང་ལོག་པར་རྟོགས་པའི་དྲི་མ་ཐམས་ཅད་བསྲེགས་པར་བསམ།",
    "དེ་ལྟར་རྣམ་པར་དག་པར་བྱས་ལ།",
    "དེ་ལྟར་བྱས་ཤིང་སྤྱད་ན་སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ་འཐོབ་པས་དམ་ཚིག་དམ་པའོ།",
    "རང་བཞིན་གྱིས་མཐུ་ཡོད་པས་སྤྱད་པར་བྱ་བ་བསྟན།",
    "སྐུ་གསུང་ཐུགས་སྒྲུབ་པར་འདོད་པའི་རྣལ་འབྱོར་པས་འཇིག་རྟེན་གྱི་ཟས་སྤངས་ལ་རྟག་ཏུ་སྒྲུབ་པའི་དམ་རྫས་སྤྱད་པའི་དོན་ཏོ།",
    "རྣལ་འབྱོར་པས་དེ་དག་བདེ་བླག་ཏུ་མ་རྙེད་ན་ཟས་སྐོམ་ཐམས་ཅད་ཤ་རྣམས་ཡིན་པར་བསམ་ཞིང་སྤྱད་པར་བྱ་བར་བསྟན།",
    "ཨོཾ་ལས་ནི་རྣམ་པར་སྣང་མཛད།",
    "དེ་ལྟར་བདག་ལྷར་བསྒོམ་ཞིང་དམ་རྫས་དང་བཟའ་བཏུང་ཐམས་ཅད་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་འབྲས་བུ་འཐོབ་པར་འགྱུར་པའི་དོན་ཏོ།",
    "མཆོག་ནི་བླ་ན་མེད་པའི་འབྲས་བུ་ཐོབ་པར་བྱེད་པའི་ཐབས་ཀྱི་རབ་ཡིན་པས་སོ།",
    "གཞན་ཡང་རྣལ་འབྱོར་པས་དམ་ཚིག་དང་དུས་ཐམས་ཅད་དུ་ལྡན་པར་བྱ་དགོས་པར་བསྟན་པ།",
    "སྤྱིར་འཕགས་པ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་བསྒོམ་ཞིང་ཐོབ་པར་བྱ་བ་ལའང་བྱའོ།",
    "བསྡམས་པའོ་ཞེས་པ་བསྲུང་བའི་ནང་ན་ཁྱད་པར་དུ་བསྟན་པའོ།",
    "བསྟན་པ་ཞེས་པ་དུས་ཐམས་ཅད་དུ་རྒྱུན་མི་འཆད་པར་སྤྱད་པའོ།",
    "འཐོབ་པར་འགྱུར་བ་དེ་ནི་དོན་འཐོབ་པའོ།",
    "དེ་ལྟ་བས་ན་ད་ལྟར་གྱི་རྣལ་འབྱོར་པས་ཀྱང་འདོད་པའི་ཡོན་ཏན་ལྔ་སྤྱོད་ཅིང་བསྒྲུབ་པར་བྱ་བ་བསྟན་ཏོ།",
    "གཉིས་སུ་མེད་པའི་ལྟ་བ་ལ་གོམས་པར་བྱེད་པས་རྣལ་འབྱོར་པས་འདི་དག་ལ་སྨད་པར་མི་བྱ་བ་བསྟན་ཏོ།",
    "དེ་བཞིན་དུ་སྒྲ་ལ་སོགས་པ་ལ་ཡང་སྨད་པར་མི་བྱ་སྟེ་དེ་ཅིའི་ཕྱིར་ཞེ་ན་ལྷའི་རང་བཞིན་ཡིན་པས་སོ།",
    "དེ་ཉིད་ཐམས་ཅད་དུ་ཡང་དག་པར་གནས་ཞེས་པ་ནི་གཟུགས་ལ་སོགས་པའི་རང་བཞིན་དོན་དམ་པར་དེ་དང་གཉིས་སུ་མེད་པ་དང་།",
    "དམ་ཚིག་སྡོམ་པ་བསྲུང་ཞེས་པ་ནི་དེ་ཉིད་ལས་མི་འདའ་བར་བྱས་ན་བྱ་བའི་དོན་ཏོ།",
    "བྱིན་གྱིས་བརླབ་པར་མཛད་པ་ནི་ཐུགས་རྗེ་ཆེ་བ་དེ་རྣམས་ཀྱིས་མི་བཟློག་པའི་དོན་ཏོ།",
    "འབྲས་བུ་མི་ཐོབ་ཅེས་པ་ནི་བྱས་པ་ཐམས་ཅད་འབྲས་བུ་མེད་པའི་དོན་ཏོ།",
    "དེ་ལྟར་དམ་ཚིག་དང་སྤྱོད་པ་རྣམས་ལ་རྣལ་འབྱོར་པ་གནས་པར་བསྟན་ནས།",
    "རྟག་པར་ནི་དུས་ཐམས་ཅད་དུའོ།",
    "སྒྲུབ་པ་བརྩམ་པར་བྱ་བ་ནི་དེར་བསྒྱུར་བའི་སྤྱོད་པ་དང་ཏིང་ངེ་འཛིན་ལ་འཇུག་པར་བྱ་བའི་དོན་ཏོ།",
    "ཕྱི་ནི་སྲིན་བལ་ལ་སོགས་པ་ལ་བྱས་ལ་འཇམ་ཞིང་ཡིད་དུ་འོང་བ་རྣམས་སོ།",
    "གསང་བ་ནི་ཡུམ་དང་གཉིས་སུ་མེད་པར་རྡོ་རྗེ་དང་པདྨར་ལྡན་པའི་ཚུལ་ལོ།",
    "སྲུང་བ་ནི་བགེགས་ཐམས་ཅད་ཀྱིས་གླགས་མི་རྙེད་པར་བྱེད་པའོ།",
    "རོ་སྟོད་ཁྲོ་བོ་ལྟ་བུ་ཞེས་པ་ནི་རྐེད་པ་ཡན་ཆོད་ཁྲོ་བོའི་ཆ་ལུགས་ཞལ་གསུམ་ཕྱག་དྲུག་པ་ལ་སོགས་པ་དང་ལྡན་པར་བསྒོམ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བཤིག་པ་ནི་མེད་པར་བྱས་པ་འམ།",
    "གནོད་མཛེས་བཀའ་སྩལ་ཞེས་པ་ལ་སོགས་པ་ནི་ཁྲོ་བོ་གནོད་མཛེས་བསྐྱེད་ཅིང་བགེགས་རྣམས་ཁུག་ཅིག་པར་བཀའ་སྩལ་པ་དང་ཕུར་བུས་ཐོབ་ཅིག་པའི་དོན་ཏོ།",
    "མཆེ་བ་གཙིགས་པ་ནི་ཤིན་ཏུ་ཡང་འཇིགས་པར་བྱེད་པའི་དོན་ཏོ།",
    "རྣམ་པར་བསྒྱུར་བ་ནི་ལྗགས་སོ།",
    "འདི་འདྲ་གཟུགས་ཞེས་པ་ནི་གོང་དུ་བསྟན་པའི་ཆ་ལུགས་ཁྲོ་བོ་མདུན་དུ་གནས་པར་བསྒོམས་ནས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་པ་ནི་ཐུགས་ཀ་ནས་བྱུང་བའི་ཁྲོ་བོ་ཧཱུཾ་ཀ་ར་ལ་ཞེ་སྡང་རྡོ་རྗེ་བགེགས་ཐམས་ཅད་ཁུག་ཤིག་པར་སྔགས་ཀྱི་སྒོ་ནས་བསྐུལ་བའི་དོན་ནོ།",
    "སྦྱོར་བ་ཡིས་ཞེས་པ་ནི་འོག་ཏུ་མནན་པའི་བགེགས་རྣམས་མི་ལྟ་བར་བྱ་བའི་ཕྱིར་ཕུར་བུ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ཆོ་ག་བྱས་ནས་ཐོབ་ཤིག་པའི་དོན་ཏོ།",
    "ངེས་པ་ནི་ཐེ་ཚོམ་མེད་པར་བཏབ་ན་བགེགས་ཐམས་ཅད་གནོན་པར་འགྱུར་བའི་དོན་ཏོ།",
    "མིག་ཀྱང་སྡང་མིག་ཏུ་མེ་སྟག་འཕྲོ་བའི་ཚུལ་དུ་བལྟ་ཞིང་བགེགས་རྣམས་ཕུར་བུས་བཏབ་པར་བྱ་བའི་དོན་ཏོ།",
    "ཕྱོགས་བཅུ་ཀུན་དུ་འབྲོས་པར་འགྱུར།",
    "ཞེས་པ་ནི་བགེགས་ཐམས་ཅད་སྒྲུབ་པའི་གནས་ཀྱི་མཚམས་ནས་སོ་སོའི་ཕྱོགས་སུ་འབྲོས་པར་འགྱུར་བའི་དོན་ཏོ།",
    "ཕྱོགས་མཚམས་ཕུར་བུས་བཏབ་ནས་ནི་གོང་མ་ལྟར་བྱས་ནས་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ཡང་དོན་དམ་པའི་ཏིང་ངེ་འཛིན་གྱིས་སྦྱང་དགོས་པས་ན་སྲིད་པ་གསུམ་མ་སྐྱེས་པ་རང་བཞིན་མེད་པར་སྒོམས་ཤིག་པའི་དོན་ཏོ།",
    "ནས་ནི་སྟོང་པར་བསམས་ནས་བསྒྲུབ་བྱའི་ས་བྱིན་གྱིས་བརླབ་ཅེས་པའི་དོན་ཏོ།",
    "ཡེ་ཤེས་ས་ནི་རིགས་ལྔ་ལ་སོགས་པའི་ལྷ་རྣམས་ཀྱི་བཞུགས་པའི་གནས་ཡིན་པའམ་ཡུམ་ལྔའི་རང་བཞིན་ཡིན་པས་སོ།",
    "དེ་དབུས་བྷཱུཾ་ནི་གནས་ཞེས་པ་ནི་གོང་དུ་བསྟན་པའི་ས་གཞིའི་དཀྱིལ་དུ་གཞལ་ཡས་ཁང་བསྐྱེད་པར་བསྟན།",
    "འོད་ཟེར་འཕྲོ་བས་རྣམ་པར་བརྒྱན།",
    "གནས་སུ་དེ་ནི་རྣམ་པར་བསམ།",
    "ཐམས་ཅད་ནི་ལྷ་རྣམས་ཀྱི་བཞུགས་པའི་ས་རྣམས་སོ།",
    "ཤར་དུ་རྣམ་པར་སྣང་མཛད་དོ།",
    "འཁོར་ལོའི་གྲྭར་ནི་རྣམ་པར་བསྒོམ།",
    "ཡི་གེ་རྣམ་པར་བསྒོམ་ཞེས་པ་ནི་དེ་ལྟར་དེ་བཞིན་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་སྟོང་པ་ཉིད་ལ་ཅི་ནུས་སུ་གནས་ནས།",
    "ཧཱུཾ་ནི་ཐུགས་ཀྱི་རང་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཞུ་བར་བརྟག་ཅེས་པ་ནི་ལྷའི་བུ་ཟླ་བ་བདུད་རྩི་འདོད་པའི་དུས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་ལས་བདུད་རྩི་ཞུ་ཞིང་ཐིགས་པར་འབབ་པ་བཞིན་དུ་ཡི་གེ་གོང་མ་འོད་ཀྱི་ཚུལ་དུ་ཞུ་ཞིང་བར་མ་ལ་ཐིམ།",
    "གཞུག་པར་བྱ་བ་ནི་དེར་བསྡུ་བའི་དོན་ཏོ།",
    "སྐྱེ་མཆེད་ལ་སོགས་རྣམ་པར་བརྒྱན།",
    "རྣམ་པར་སྣང་མཛད་རབ་ཏུ་གནས།",
    "རྣམ་པར་ཤེས་སུ་མི་བསྐྱོད་གནས།",
    "ཞེས་པ་ནི་རྣམ་པར་ཤེས་པའི་ཕུང་པོའི་རང་བཞིན་ལ་ཡི་གེ་ཧཱུཾ་ལས་བཅོམ་ལྡན་འདས་མི་བསྐྱོད་པ་བསྐྱེད་པའོ།",
    "གང་བ་ཉིད་བརྟག་ཅེས་པ་ནི་ཁྱབ་པ་ལ་ཡང་བྱ་གོང་མ་ལྟར་བསྒོམས་པས་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པར་འགྱུར་བ་ལ་བྱའོ།",
    "དེ་ཉིད་ཀུན་དུ་ཚིམ་པར་འགྱུར།",
    "ལྷ་ཐམས་ཅད་དགྱེས་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་འགྱུར་བའི་ཐབས་ཀྱི་མཆོག་ཡིན་པའི་དོན་ཏོ།",
    "ཧ་ལས་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའོ།",
    "རྡོ་རྗེ་ཅན་གྱི་རྒྱུད་ལས་གསུངས།",
    "འདི་དག་སྔགས་ནི་མ་གསུངས་ཕྱིར།",
    "དོན་དམ་པར་རང་བཞིན་གཅིག་པར་ཤེས་པའོ།",
    "དེ་བཞིན་དུ་སྒྲ་ལ་སོགས་པ་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "གཞན་གྱིས་མི་ཐུབ་གཡོན་པ་ཞེས་པ་ནི་ཁྲོ་བོ་གཞན་གྱིས་མི་ཐུབ་པ་སྲུང་བའི་ལས་ཁྱད་པར་དུ་བྱེད་པ་དང་།",
    "པྲཛྙཱ་ནི་བྱེ་བྲག་ཏུ་ལྟ་བའི་རྣམ་པར་རྟོག་པའོ།",
    "དེ་ལྟར་དོན་ཀུན་རབ་བཞུགས་པ།",
    "བདག་པོར་རབ་ཏུ་སྦྱར་ཞེས་པ་ནི་བདག་པོ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "སྤྱན་ནི་རྣམ་པར་བསམ་བྱ་བ།",
    "རྣམ་པར་བསམ་པ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་སྤྲོ་བ་རྣམས་སོ།",
    "ཞེས་པ་ནི་གོང་དུ་བསྟན་པ་བཞིན་དུ་ནམ་མཁའ་ཐམས་ཅད་ཁྱབ་པར་གནས་པ་རྣམས་མངོན་སུམ་དུ་བསམ་པའི་དོན་ཏོ།",
    "གཞན་ཡང་སྐུའི་རྒྱན་ཐམས་ཅད་དང་ལྡན་པར་བསམ་ཞེས་པའི་དོན་ཏོ།",
    "ཕུང་པོ་ལྔ་ལ་ཁྱབ་པར་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "སྔགས་འདི་ལན་གསུམ་དུ་བརྗོད་པར་བྱའོ།",
    "ལྕེ་དབུས་པདྨ་ལ་ཞེས་པ་ནི་བདག་ཕྱག་རྒྱ་ཆེན་པོར་གནས་པའི་ལྕེའི་དཀྱིལ་དུ་ཡི་གེ་བཾ་ལས་པདྨ་འདབ་མ་བརྒྱད་པ་བསྐྱེད་ལ་ཨོཾ་ལས་རྡོ་རྗེ་འདོད་ཆགས་ཤེས་བྱས་ཏེ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་ཨ་བསྐྱེད་ལ་གོང་མ་བཞིན་དུ་སྤྲོ་བསྡུ་བྱས་ལ་བཅོམ་ལྡན་འདས་སྣང་བ་མཐའ་ཡས་དང་།",
    "དེ་ལྟར་སྐུ་གསུང་བྱིན་གྱིས་བརླབ་པར་བསྟན་ནས།",
    "ཐུགས་བྱིན་གྱིས་བརླབ་པར་བསྟན་ཏོ།",
    "དེ་ནི་ཞུགས་པར་བསྒོམ་བྱས་ཏེ།",
    "སེམས་ནི་བྱིན་གྱིས་བརླབ་པར་བྱ།",
    "ལ་སོགས་པ་ནི་ཐུགས་སུ་ངེས་པའི་རིགས་ལ་གསོལ་བ་འདེབས་པར་བསྟན་ཏོ།",
    "ཞེས་པ་ནི་དེ་ལྟར་འོད་ཟེར་འཕྲོ་ཞིང་གནས་པ་དེ་མངོན་སུམ་གསལ་བར་བསྐྱེད་ནས་ཐུགས་དང་སེམས་གཉིས་སུ་མེད་པར་སྦྱོར་བར་བྱའོ།",
    "དེ་ཡི་ཕྱག་དྲུག་རྣམ་པར་བསྒོམ།",
    "འབར་བ་ལྔས་རྣམ་པར་བརྒྱན་པ་ནི་ཡེ་ཤེས་ལྔའི་རང་བཞིན་འོད་ཟེར་ཁ་དོག་དཀར་པོ་ལ་སོགས་པ་ལྔ་རྡོ་རྗེ་དེ་ཉིད་ལས་འཕྲོ་ཞིང་དཀྲིས་པའི་དོན་ཏོ།",
    "གནོད་པར་བྱེད་པའི་གནོད་སྦྱིན་དང་།",
    "སྲིན་པོ་རྣམས་ཚར་གཅོད་པའི་མཐུ་དང་ལྡན་པར་བསྒོམ་ཞེས་པའི་དོན་ཏོ།",
    "རྡོ་རྗེ་འབར་བས་རྣམ་པར་བརྒྱན།",
    "ཕྱག་མཚན་དེ་རྣམས་ཀྱང་ཡེ་ཤེས་ལྔ་དང་རིགས་ལྔའི་རང་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཡེ་ཤེས་སེམས་དཔའ་རྣམ་པར་བསྒོམ།",
    "བསྙེན་པ་སྔར་ནི་བྱས་ནས་སུ།",
    "ཞེས་པ་ནི་དེ་ལྟར་བསྙེན་པ་དང་ཉེ་བའི་བསྙེན་པ་རྫོགས་པར་བྱས་ནས་སྒྲུབ་པ་ལས་འཇུག་པར་བསྟན་ཏོ།",
    "སྔར་བསྙེན་པ་བྱས་པ་ནི་བསྙེན་པ་རྣམ་གཉིས་རིམ་པ་བཞིན་དུ་བྱས་ནས།",
    "སེམས་ལས་སུ་རུང་བའི་སྒྲུབ་པ་ལ་འཇུག་པར་བྱའི་གཞན་དུ་མ་ཡིན་ཞེས་པའི་དོན་ཏོ།",
    "སྒྲུབ་པ་དག་ནི་བརྩམ་པ་ནི་བདག་སྐུ་གསུང་ཐུགས་ཐོབ་པར་བྱེད་པའི་ཐབས་ཀྱི་རིམ་པ་ལ་འཇུག་པར་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་བསྟན་ཀྱང་སྤྱིར་བཅུ་གཉིས་དང་ཉི་ཤུ་རྩ་ལྔའི་བར་དུ་ཤེས་པར་བྱའོ།",
    "བཟུང་ནས་བསྒྲུབ་པ་བརྩམ་པར་བྱ།",
    "དེ་ལྟ་བུའི་ཡོན་ཏན་དང་ལྡན་པ་ཁ་ན་མ་ཐོ་བ་མེད་པའི་སྒོ་ནས་བཙལ་ནས་བསྒྲུབ་པ་ལ་འཇུག་པར་བྱ་བའི་དོན་ཏོ།",
    "སྔར་གསུངས་པ་ཡི་གནས་དེར་གཞག།",
    "ཅེས་པ་ནི་དཀྱིལ་འཁོར་དེ་ལྟ་བུ་བྱས་ནས་སྔར་གསུངས་པའི་གཟུངས་མ་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་དེའི་དབུས་སུ་གཞག་ཅེས་པའི་དོན་ཏོ།",
    "ཡུམ་དེའི་གནས་ལྔར་ཡིག་འབྲུ་ལས་བསྐྱེད་ཅིང་གནས་པར་དམིགས་པའོ།",
    "ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་གནས།",
    "ཡང་ན་ཕྱག་རྒྱ་བཞི་དང་གཉིས་སུ་མེད་པར་གནས་པ་ནི་རིགས་ཕྱི་མ་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་གནས།",
    "ཞེས་པ་ནི་དེའི་སྟེང་དུ་བཅོམ་ལྡན་འདས་རཏྣ་སམྦྷཱ་བ་ཡབ་ཡུམ་ཡི་གེ་ས་ལས་བསྐྱེད་པར་བྱའོ།",
    "ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་གནས་པ་གོང་མ་དང་འདྲའོ།",
    "ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་གནས།",
    "དེ་ལ་རོ་ལངས་མ་ལག་པ་གཡས་ལ་གཤིན་རྗེ་གཤེད་ཀྱི་ཡུམ་དུ་ཤེས་པར་བྱའོ།",
    "དངོས་གྲུབ་མྱུར་དུ་ཐོབ་པར་འགྱུར།",
    "རྡོ་རྗེ་དང་པདྨ་གཉིས་སྦྱར་བའི་མཚམས་ཡེ་ཤེས་ལྔའི་རང་བཞིན་འོད་ཟེར་ཁ་དོག་ལྔ་སྤྲོ་ཞིང་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་དེ་བཞིན་གཤེགས་པའི་ཐུགས་དམ་གྱི་རྒྱུད་བསྐུལ་ཞིང་དགྱེས་པར་བྱ་བ་དང་།",
    "དེ་ནས་བསྒྲུབ་པ་བརྩམ་པར་བྱ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏཱ་ནུ་རཱ་ག་ན་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཧཾ་ཞེས་བྱ་བ་ནི་བདག་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་རྗེས་སུ་ཆགས་ཤིང་དགྱེས་པར་བྱེད་པའི་རྡོ་རྗེ་རང་བཞིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "སྔགས་འདིའི་དོན་གཉི་གར་ཡང་སོ་སོར་ཡིད་ལ་བྱེད་ཅིང་ལན་གྲངས་ཀྱིས་བརྗོད་པར་བྱའོ།",
    "སྒྲུབ་པ་ཆེན་པོ་བརྩམ་པར་བྱ།",
    "དེའི་ཉིན་པར་གཟུངས་མ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་ཡང་ནས་ཡང་དུ་གསལ་བར་བྱས།",
    "ནུབ་ཀྱི་རི་བོའི་རྒྱབ་ཏུ་ཉི་མ་ཕྱིན་མ་ཐག་ཏུ་རྡོ་རྗེ་པདྨར་སྦྱར་ཞིང་སྒྲུབ་པ་ཆེན་པོ་བརྩམ་པར་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "ཅོད་པན་བདག་པོར་བསྒོམ་བྱས་ན།",
    "གཡོན་པའི་ཡན་ལག་རྐེད་པར་ཕབ།",
    "སོས་ནི་མ་མཆུ་བསྡམ་པར་བྱ།",
    "རྡོ་རྗེ་འཛིན་པར་ང་རྒྱལ་བསྐྱེད།",
    "ཐམས་ཅད་བདུད་ནི་རྣམ་པར་འཇོམས།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་བགེགས་དང་སྲིན་པོ་ལ་སོགས་པའི་བདུད་རྣམས་འཇོམས་པར་བསམ་པའི་དོན་ཏོ།",
    "སྔགས་འདིའི་དོན་བསྒོམ་ཞིང་ལན་གསུམ་དུ་བརྗོད་པར་བྱའོ།",
    "སེམས་དེ་བཀུག་ནས་པད་བཞུགས་ལས།",
    "ཞེས་པ་ནི་སྤྲོ་བའི་ལྷ་རྣམས་ཀྱང་ས་བོན་ཡི་གེ་ལས་བསྐྱེད་པར་བྱའོ།",
    "རྫོགས་པ་ནི་དེ་རྣམས་ཀྱིས་སྐུ་རྒྱས་པར་བརྒྱན་པའོ།",
    "ཅེས་པ་ནི་གཡས་ཀྱི་གསུམ་ལ་ཕྱག་མཚན་དེ་གསུམ་རིམ་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "གཡོན་པའི་ཕྱག་ཏུ་བསམ་པར་བྱ།",
    "རིགས་ཀྱི་ཕྲིན་ལས་ཞེ་སྡང་ཅན་སྤྱད་བའི་ཐབས་ཁྱད་པར་དུ་མཛད་པ་ཡིན་པས་དེ་སྐད་གསུངས་སོ།",
    "རྡོ་རྗེ་སེམས་ལ་རྣམ་པར་ཞུགས།",
    "དེ་ལ་ཞུགས་པར་དང་བྱས་ནས།",
    "རྡོ་རྗེ་སེམས་ནི་རྣམ་པར་བསམ།",
    "འཇིག་རྟེན་ཁམས་ཀུན་འཁྲུགས་པར་མཛད།",
    "ཅེས་པ་ནི་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་གདན་ལ་བཞུགས་ཤིང་།",
    "ཞལ་གསུམ་དག་ནི་རྣམ་པར་འཆང་།",
    "ཞེས་པ་ནི་ཡུམ་དང་གཉིས་སུ་མེད་པར་བཞུགས་པའོ།",
    "སྔར་གསུངས་པ་ཡི་རིམ་བཞིན་དུ།",
    "ཕྱག་རྒྱ་ཕྱི་མ་རྣམ་པར་བསྒོམ།",
    "དཀྱིལ་འཁོར་ཐམས་ཅད་རྣམ་པར་སྤྲོ།",
    "ཡང་ན་ཛི་ན་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཉིད་ལ་བྱ།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་མུན་པར་སྣང་བ་ཐམས་ཅད་སྐུའི་འོད་ཀྱིས་གསལ་བར་མཛད་པའི་དོན་ཏོ།",
    "དེ་ཡང་ཞལ་དབུས་མ་སྐུ་དང་མཐུན་པར་དཀར་ལ་གཡས་གནག་ཅིང་གཡོན་དམར་བའོ།",
    "ཞེས་པ་ནི་ཕྱག་དྲུག་དང་ལྡན་པར་བསྒོམ་ཞེས་པའོ།",
    "གཡོན་པའི་ཕྱག་ཏུ་རྣམ་པར་བསྒོམ།",
    "ཞེས་བྱ་བ་ནི་དེ་བཞིན་དུ་འདི་གསུམ་གཡོན་ཕྱོགས་སུ་ཤེས་པར་བྱའོ།",
    "ཟླ་བའི་དབུས་སུ་རྣམ་པར་གནས།",
    "ཡང་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་ཁྱད་པར་ལས།",
    "འཕྲོ་འདུ་ལ་སོགས་པ་ཚུལ་བཞིན་དུ་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་རིན་ཆེན་འབྱུང་ལྡན་གྱི་ཕྱག་རྒྱ་བསྐྱེད་པར་བྱ་ཞེས་པའི་དོན་ནོ།",
    "ཕྱག་དྲུག་པ་ནི་རྣམ་པར་བསྒོམ།",
    "གཡོན་པའི་ཕྱག་ཏུ་རྣམ་པར་བསྒོམ།",
    "ཨཱ་རོ་ལྀཀ་ཅེས་པའི་སྔགས་འདིས་པདྨའི་རིགས་ཀྱི་བཅོམ་ལྡན་འདས་བསྐུལ་ཞིང་བསྐྱེད་པར་བསྟན་ཏོ།",
    "ཡང་ན་ཡུལ་དང་དུས་ཐམས་ཅད་དུ་གཉིས་སུ་མེད་པར་བརྩོན་པའི་རང་བཞིན་ལ་གནས་ཞེས་པའོ།",
    "དམར་དང་གནག་དང་དཀར་བའི་ཞལ་ནི་ཞལ་དབུས་མ་སྐུ་དང་མཐུན་པར་དམར་ལ་གཡས་གནག་ཅིང་གཡོན་དཀར་བའོ།",
    "ཐམས་ཅད་རྒྱན་གྱིས་རྣམ་པར་བརྒྱན།",
    "ཞེས་པ་ནི་པདྨའི་རིགས་ཀྱི་ཕྲིན་ལས་འདོད་ཆགས་ཅན་གྱི་དོན་ཁྱད་པར་དུ་མཛད་པ་ཡིན་པས།",
    "བཅོམ་ལྡན་འདས་སྣང་བ་མཐའ་ཡས་ཀྱང་འགྲོ་བ་དྲུག་དང་མཐུན་པར་འདོད་ཆགས་སྤྱོད་ཀྱང་ཉེས་པས་མི་གོས་པ་ནི་དཔེར་ན་མེ་ཏོག་པདྨ་འདམ་དུ་སྐྱེས་ཀྱང་འདམ་གྱི་དྲི་མས་མི་གོས་པ་བཞིན་ནོ།",
    "རྒྱབ་ཀྱི་ཕྱོགས་སུ་ངེས་པར་བཞུགས།",
    "པྲཛྙཱ་དྷྲྀཀ་ཅེས་པའི་སྔགས་འདིས་ལས་ཀྱི་རིགས་ཀྱི་བཅོམ་ལྡན་འདས་དོན་ཡོད་གྲུབ་པ་བསྐུལ་ཞིང་བསྐྱེད་པར་བྱ་བ་བསྟན་ཏོ།",
    "དེ་ལ་གདོན་མི་བ་ནི་འཇིག་རྟེན་པས་ལས་བྱས་པ་ཐམས་ཅད་ལ་ལ་ལ་འབྲས་བུ་ཡོད་ཅིང་ལ་ལ་འབྲས་བུ་མེད་པ་བཞིན་དུ་མ་ཡིན་ཞིང་ཕུན་སུམ་ཚོགས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ནི་ལས་ཀྱི་རིགས་ཀྱི་ཕྲིན་ལས་བརྫུན་དང་ཕྲག་དོག་ཆེ་བ་རྣམས་ཀྱི་དོན་ཁྱད་པར་མཛད་དོ།",
    "དཀྱིལ་འཁོར་དུ་བཀོད་པ་བསྟན་ནས་དྭེ་ཥ་ར་ཏི་ཞེས་པ་ལ་སོགས་པས་ཡུམ་བཞི་བསྐྱེད་ཅིང་བཀོད་པར་བསྟན་ཏོ།",
    "ཞལ་གསུམ་གྱིས་ནི་རྣམ་པར་བརྒྱན།",
    "དེ་ལ་དབུས་སྐུ་དང་མཐུན་པར་གནག་ཅིང་གཡས་དམར་ལ་གཡོན་དཀར་བའོ།",
    "མི་འཁྲུགས་ཅོད་པན་གནས་བྱས་པའི།",
    "རལ་གྲི་གསུམ་གཡོན་ཕྱོགས་སུ་རིམ་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ལྷོ་ཡི་གྲྭར་ནི་བཞུགས་ནས་ཀྱང་།",
    "དབུ་ལ་ཐོད་དུ་རྣམ་པར་བཅིངས།",
    "ཞེས་པ་ནི་ཞལ་གསུམ་གྱི་ཁ་དོག་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དང་མཐུན་ནོ།",
    "ཕྱག་དྲུག་པ་ནི་རྣམ་པར་བསམ།",
    "ཞེས་པ་ནི་དེ་ལྟ་བུའི་རྒྱན་དང་ལྡན་པ་དེ་ཕྱག་དྲུག་དང་ལྡན་པར་བསྐྱེད་པའི་དོན་ཏོ།",
    "དྲིལ་བུ་རལ་གྲི་གཡོན་པར་མཚོན།",
    "ཞེས་བྱ་བ་ནི་ཕྱག་དྲུག་ལ་ཕྱག་མཚན་དེ་དྲུག་རིམ་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཤར་གྱི་གྲྭར་ནི་བཞུགས་ནས་ཀྱང་།",
    "ཞེས་པ་ནི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཡིན་པས་ལྷ་དང་མི་ལས་འཕགས་པར་མཛེས་ཤིང་ཡིད་དུ་འོང་བའོ།",
    "ཐམས་ཅད་རྒྱན་གྱིས་རྣམ་པར་བརྒྱན།",
    "ཕྱག་དྲུག་དང་ལྡན་པར་བརྗོད་པའི་དོན་ཏོ།",
    "ཞེས་པ་ནི་ཕྱག་གཡོན་གྱི་དང་པོ་དྲིལ་བུ་དང་ཨུཏྤལ་ཡུ་བ་བཅས་པར་འགྱིང་བག་ཏུ་འཛིན་པའོ།",
    "ཚེ་དང་ལོངས་སྤྱོད་རྒྱས་པར་མཛད།",
    "ནོར་རྫས་ལ་སོགས་པའི་ལོངས་སྤྱོད་རྒྱས་པར་མཛད་པའོ།",
