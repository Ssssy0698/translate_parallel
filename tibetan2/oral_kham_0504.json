    "དང་པོ་ལུས་རྡོ་རྗེའི་འདུག་སྟངས་ལ་སློབ་པ་ནི།",
    "འགའ་ཞིག་ཏུ་ཅུང་ཟད་འདུག་པར་བསམ་ལ་གསལ་སྣང་འདོན་བསྐྱར་བྱ།",
    "གནས་མཁན་གྱི་ཤེས་པ་དེ་ཉིད་དངོས་པོ་དངོས་མེད་དབྱིབས་ཁ་དོག་ལ་སོགས་པ་ཇི་ལྟར་འདུག་བརྟགས་པས་ཅིར་ཡང་མ་གྲུབ་པར་གསལ་སྟོང་ནམ་མཁའ་ལྟ་བུའི་དགོངས་པ་ཤར་བ་ནི་བར་དུ་གནས་པ་མེད་པར་ངོ་འཕྲོད་པ་སྟེ་མཐར་ཐུག་ལོངས་སྐུ་འགྲུབ་པའི་དགོས་པ་ཡོད་དོ།",
    "དེའི་ཚང་ཨེ་འདུག་མེད་པ་ལས་བྱུང་ངམ།",
    "དེ་ལྟར་ངང་དྭངས་སྤྲོས་པ་དང་བྲལ་བ་རྒྱ་མཚོ་དྭངས་པ་ལྟ་བུའི་ངང་ལ་བཞག་དུས།",
    "ཐ་མལ་གྱི་ཤེས་པ་ཡུལ་ཐོག་ཏུ་འཕྲོ་ཡང་རང་ཤར་རང་གྲོལ་དུ་བསྟན་པ་རྦ་རླབས་ཆུར་ཐིམ་པ་ལྟ་བུ་སྟེ།",
    "རང་གྲོལ་དུ་འདུག་པས་གཉེན་པོ་གཞན་ལ་རག་མ་ལུས་པར་ཐག་ཆོད།",
    "གསང་བ་རྣམ་གཡེང་བསྒུལ་བསྐྱོད་ཐམས་ཅད་སྤངས་ཏེ་གཅིག་པུར་འདུག་པའོ།",
    "ལུས་རུས་སྦལ་འཁར་གཞོང་དུ་བཅུག་པ་ལྟར་འདུག་སྟངས་ལས་འབྲལ་མི་ཕོད་པ་དང་།",
    "ལོངས་སྐུའི་འདུག་སྟངས་སམ་གཞོག་གཡས་ཕབ་པར་གསུངས་ཀྱང་།",
    "སེང་གེའི་འདུག་སྟངས་བཅས་ལ།",
    "གཞུ་གང་ཙམ་གྱི་ནམ་མཁའ་ལ་ལིང་ངེ་འདུག་པ་ལ་སེམས་གཏད་ལ་ཅུང་ཞིག་ཕྱིར་འཛིན་པ་ལ་བསླབས་པས།",
    "དམ་ཚིག་དང་སྡོམ་པ་བསྲུང་ཞིང་གཅིག་པུ་དབེན་པར་འདུག་རྣམ་གཡེང་དང་འདུ་འཛི་སྤངས་ཤིང་དགོས་མེད་རྒྱུད་ལ་བརྟེན།",
    "འཁོར་འདས་རུ་ཤན་དབྱེ་བ་ནས་བཟུང་ཐོད་རྒལ་གྱི་མན་ངག་སྐུ་གསུམ་གྱི་འདུག་སྟངས་ལ་སློབ་ཚུལ།",
    "དེ་ལྟར་ན་སོར་སྡུད་ཀྱི་ཉམས་མྱོང་རང་ཤུགས་སུ་འཆར་བར་འགྱུར།",
    "ཅེས་པའང་རང་གཞན་འཇུག་བདེའི་ཕྱིར་དང་།",
    "བསགས་སྦྱངས་ཀུན་གྱི་མཐར་ཐུག་གོ། གཉིས་པ་སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་ནི།",
    "འདུག་ས་འདི་ཉིད་དུ་ཐོབ་པར་མཛད་དུ་གསོལ།",
    "སྐུ་ལས་འོད་ཟེར་བྱུང་རང་ལུས་ཁྱབ།",
    "བརྗིད་དང་ལྡན་པར་འདུག་པས་ལས་བདེ་ཧྲིལ་གྱིས་བྱུང་བར་བསམ།",
    "མགོ་ནང་བསྟན་དུ་ལོག་ཤུགས་དྲག་པོས་ཕྱི་ལ་འགྲོ་ཚད་པ་ལ་བུག་དོགས་པོར་མ་ཤོང་བས་ལྷན་ལྷན་འདུག་པ་ལ་སེམས་ཡུད་ཅིག་དྲག་ཏུ་གཏད།",
    "ཆང་མཆོད་དེ་ཉིད་ཚོགས་གཏོར་སོགས་ལ་འཐོར་ཞིང་རང་ལ་ཁྲུས་ཀྱང་བྱ།",
    "དེས་ཀྱང་རང་རིག་མ་ལ་འཁྱུད།",
    "མདུན་བསྐྱེད་རང་ལ་བསྟིམ་ཞིང་རང་ཡན་ལག་བཞི་རྫོགས་ཀྱི་ལྷར་གསལ་བས་རྣལ་འབྱོར།",
    "ཉལ་ལྡང་ཁ་ཟས་འགྲོ་འདུག་ལ་སོགས་པ་ལམ་དུ་འགྱུར་བའི་ཐབས་ཀྱི་རྣལ་འབྱོར་བསྐྱེད་རིམ་སྤྱིའི་རིགས་པས་འཕྲུལ་ཤེས་པར་བྱའོ། གཉིས་པ་རྫོགས་པའི་རིམ་པ་ལ་གསུམ།",
    "དེའང་རང་ལུས་ལྷ་སྐུ་སྣང་སྟོང་སྒྱུ་མ་དང་།",
    "གཉིས་སྣང་རང་གྲོལ་གྱི་ཉམས་མྱོང་ལ་བརྟེན་པ་ཐོབ་པའི་རྟོགས་པ་དང་འབྲེལ་བའི་ལྟ་བས་བསྐྱེད་རྫོགས་ཀྱི་རྣལ་འབྱོར་ཐམས་ཅད་ལ་རྒྱས་ཐེབ་པར་བྱ་བ་ནི།",
    "དེའང་ཉན་ཐོས་དང་རང་རྒྱལ་ལ་སོགས་པས་ནི་བདེ་བ་ལ་སྡུག་བསྔལ།",
    "དུད་འགྲོ་ལ་སོགས་པ་འགྲོ་བ་གཞན་ལ་ལྟོས་ན་མི་ལུས་ཐོབ་པ་སྲིད་ཙམ་དུ་འདུག་པས།",
    "དེ་རིང་ཙམ་ཡང་མི་འཆི་བར་འདུག་པའི་གདེངས་ཀྱང་མེད་པས།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "བདེ་སྐྱིད་ཀྱི་རྒྱུ་ཚོགས་སོགས་ཤིག་པའི་བརྡར་འདུག་པས་དེ་ལྟར་བྱའོ་སྙམ་པས།",
    "འགྲོ་འདུག་ལ་སོགས་པ་ཐམས་ཅད་གཞན་ལ་ཕན་གདག་པའི་བསམ་པ་དང་མི་འབྲལ་བའི་རྣལ་འབྱོར་གཅིག་པུས་ལམ་དུ་ཁྱེར།",
    "ཞེ་འགྲས་མེད་ཀྱང་རང་བཞིན་གྱིས་གནོད་པ།",
    "ཡང་བདག་གཅེས་འཛིན་ཅི་འདྲ་འདུག་བལྟ།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་གདའ་སྟེ།",
    "ཉམས་པའི་རྒྱུ་ཡང་སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་འཕྱིན་པ།",
    "རྟོག་ཚོགས་ཐམས་ཅད་ཤར་ཡང་རང་སར་གྲོལ་བ་ཆུའི་ཆུ་བུར་ལྟ་བུ།",
    "དེ་དག་དུས་བཞིར་སྤྱོད་བྱེད་ཅིང་།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "བེམ་པོའི་པགས་པ་བཤུས་ནས་བཏིང་བའི་སྟེང་དུ་རྐང་ལག་གསུམ་བཅད་དེ་བཙུག་པ་མི་མགོའི་སྒྱེད་བུ་གསུམ་དུ་གྱུར་པའི་ཁར་ཐོད་པ་བཙུག་པའི་ནང་རང་ལུས་གཏུབ།",
    "འཁོར་གསུམ་མི་དམིགས་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོ་དེ་ཁོ་ན་ཉིད་ཀྱི་ཚོགས་སུ་ཕུལ་བས་ཤིན་ཏུ་དགྱེས་པའི་ཕུལ་དུ་གྱུར་ནས་རང་རང་དང་མཐུན་པའི་དངོས་གྲུབ་སྩོལ་བར་བསྒོམ།",
    "ལ་ལ་ནི་གང་ཟག་ལ་ལ་ནི་འཆི་རྟགས་བྱུང་ཡང་མི་འཆི་བར་འདུག་གོ་ཞེ་ན།",
    "འོ་ན་འོ་སྐོལ་ཁ་ཅིག་ལ་འཆི་བ་ལ་འཆི་ལྟས་མི་འོང་པ་འདུག་གོ།",
    "དབྱར་ཟླ་འབྲིང་པོ་ལ་གྲིབ་མ་རྐང་ཚད་གཉིས་ཡང་རང་གྲིབ་རང་ལ་ཞའོ།",
    "ངང་པ་བྱ་རོག་རྨ་བྱ་ཅིག་ཏུ་འདྲེས་པ་ནི་འདི་ཚོ་དགྲ་ཡིན་པ་ལ་ལྷན་ཅིག་ཏུ་འདུག་པ་མཐོང་བ།",
    "ཕུ་ནི་ཕུ་བྱ་བ་འདི་གྲང་བར་བྱུང་བ་འདི་དྲོ་བར་འདུག་བཅུ་ན།",
    "དེ་ནས་ནི་སུ་རུ་ཛྲ་ལ་ཏི་ཏ་སིད་དྷ་ལོ་ཙ་ན་ཞེས་པ་ནི།",
    "སི་དྷ་སི་དྷ་ལོ་ཙ་ན་ལོ་ཙ་ན།",
    "ཨོཾ་རུ་རུ་སུ་རུ་ཛྭ་ལ་ཏི་སྟ་སི་དྷ་ལོ་ཙ་ན་སརྦ་སྭཱ་ཧཱ་ནི་སྭཱ་ཧཱ་ཞེས་པའོ་གསུང་ངོ།",
    "ཡིད་འོང་རང་ཉམས་དགའ་བ་ཡིད་དུ་འོང་བ་གྲུབ་པ་ཐོབ་པའི་གནས་སུ་བསྡད་དོ།",
    "སྨྲ་ཉུང་པ་ནི་སྨྲ་བ་ཤིན་ཏུ་ཉུང་བར་འདུག་པ།",
    "ཤིན་ཏུ་ཆགས་པ་ནི་འགྲོ་འདུག་ལ་དགའ་བ།",
