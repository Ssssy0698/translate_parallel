    "དེ་འདབ་ཆགས་ཡིན་ན་གཤོག་པ་གང་ན་འདུག།",
    "འདི་ན་མེ་མ་ཡིན་པ་འདུག་གོ།",
    "འདིར་བོད་དངུལ་མིན་པའང་འདུག་གོ།",
    "ཕྱི་མས་སྔ་མ་ཟིལ་གྱིས་གནོན་ཚུལ་གྱི་ཐ་སྙད་མཛད་འདུག་ཀྱང་།",
    "དེ་འདྲ་རང་ཡིན་མིན་ཐེ་ཚོམ་གྱི་གནས་སུ་འདུག།",
    "རྒ་བའི་གནས་སུ་སླེབས་ཀྱང་རང་ཉིད་འཚེངས།",
    "གསུང་ལས་སྤྲུལ་པའི་དྲང་སྲོང་ཡིད་ལས་སྐྱེས་ཞེས་བྱ་བ་ཞིག་བྱུང་སྟེ་སྟོན་པ་ལ་ཕྱག་དང་སྐོར་བ་བྱས་ནས་སེང་གེའི་ལྟ་སྟངས་ཀྱིས་སྟོན་པའི་མདུན་དུ་འདུག་སྟེ་འཁོར་གྱི་དྲང་སྲོང་རྣམས་ཀྱི་དོན་དུ་ཞུ་བའི་ཚིག་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འཛམ་གླིང་རང་ལུས་འདོམ་གང་གྲུ་བཞི་སྟེ།",
    "དྭངས་མ་ལུས་ཟུངས་རང་རང་མེ་དྲོད་ཀྱིས།",
    "ཞེ་སྡང་འདམ་རིང་རང་བཞིན་ངང་རྒྱུད་བཟང་།",
    "གཅེར་བུར་འདུག་དང་སྐྲ་དང་ཁ་སྤུ་བྲེགས།",
    "ཚད་དགུང་གཉིད་ལོག་འདུག་རྗེས་དྲག་ཤུལ་བྱས།",
    "འགྲངས་རྗེས་དལ་བར་འདུག་དང་ཉིན་གཉིད་ལོག།",
    "རང་རང་གནས་སུ་འཕེལ་ཞིང་གསོག་པར་བྱེད།",
    "གཉིས་པ་ལུས་ཀྱི་མེ་དྲོད་རང་གནས་འདུག།",
    "རྒྱུ་ནི་རང་རང་སྐྱེད་པའི་རྐྱེན་ཡིན་ཏེ།",
    "གོས་བགོ་ཁང་པ་ཆག་ཆག་བཏབ་བར་འདུག།",
    "རྔུལ་ཞིང་འདར་ལ་སྐྲག་ཅིང་འདུག་མི་ཚུགས།",
    "གསོག་དུས་ཞི་ལ་ལངས་ནས་སྦྱང་བས་བཅོས།",
    "དེ་རྟགས་བཅོས་ཐབས་རང་རང་ལེའུར་བལྟ།",
    "ཡིད་འོང་སྙན་ཚིག་བསིལ་གནས་དལ་བར་འདུག།",
    "ཀ་ར་སྦྱར་བཏང་རང་རང་རྩ་ལ་གཏར།",
    "ཚིགས་ཁ་གཡོ་ཞིང་བརྐྱང་བསྐུམ་འགྲོ་འདུག་གྱོང་།",
    "འོན་ཀྱང་རང་བཞིན་རྒྱུ་ཡིས་འདུས་པ་དང་།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག།",
    "མེ་ཏོག་དང་པོ་ཆུ་སྐྱུར་སྐྱུག་དུས་སུ།",
    "རྒྱ་བཤལ་ཙ་དམར་སྐྱུག་དུས་གུར་གུམ་དང་།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "དོན་ལྔ་རང་རང་རྩ་ལ་གཏར་བ་སྟེ།",
    "དལ་བར་འདུག་དང་མྱ་ངན་སེམས་ལས་དུབ།",
    "ལྕེ་མཆུ་རྙིལ་དཀར་འགྲོ་འདུག་བསུས་པ་ལྡིག།",
    "དྲོ་བའི་གནས་འདུག་མི་རྔུལ་བག་ཙམ་བཅག།",
    "འཇིག་ཟས་རྟ་ཞོན་ཉལ་པོ་འགྲོ་འདུག་དང་།",
    "སྤྱོད་ལམ་འདུག་རྗེས་དྲག་པོའི་ལས་བྱས་ཤིང་།",
    "རླན་སྟེང་ཁ་ཡེང་མ་ཡིན་དབེན་པར་འདུག།",
    "དེ་རྣམས་རིགས་ལ་ཚད་གཉའ་ཆག་དུས་སུ།",
    "ཉལ་དང་སྙེས་དང་ཙོག་པུར་འདུག་ལ་སོགས།",
    "པང་ལེབ་ཐོག་ཏུ་གཅེར་བུ་ཙོག་པུར་འདུག།",
    "ནེའུ་བསིང་ས་གཙང་ཟླ་འོད་བསིལ་གནས་འདུག།",
    "འགྲོ་འདུག་ལྡང་ཉལ་ལུས་ངག་རྩོལ་བ་སྤང་།",
    "ཆང་འཐུངས་འགྲོ་འདུག་རྗེས་ལ་རྐང་པ་ལྕི།",
    "རྩ་རྒྱུད་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "སྤྱོད་ལམ་བསིལ་གནས་དལ་འདུག་གཉིད་མི་ལོག།",
    "དེ་རྟགས་སྤྱི་དང་བྱེ་བྲག་ཀག་དུས་གསུམ།",
    "གང་ལ་བབས་པའི་རང་རང་སྒོས་རྩ་གཏར།",
    "ལྔ་བརྒྱ་དུས་ཀྱི་ཐ་མར་གྱུར་ཙ་ན།",
    "དེ་ནས་ཞག་གསུམ་ཁྲག་དུས་ཁྲག་ལ་བབས།",
    "ཉིན་གཅིག་མི་གཏར་བཞི་པོ་རང་རང་རྒྱུན་རིམས་རྩ་གང་བབ་པར་གཏང་།",
    "ཆམ་རིམས་སྨྱུང་བར་འདུག་ལ་ཆུ་སྐོལ་བཏུང་།",
    "བརྩོན་པས་རང་རང་གཞུང་བཞིན་བཅོས་པར་བྱ།",
    "ཙོག་པུར་འདུག་ན་ཐུར་ལ་འཐེན་པ་འདྲ།",
    "རླན་ལ་འདུག་དང་ཆུ་ཡི་ལས་བྱས་འབྱུང་།",
    "མཁལ་ཚད་ཆང་འཐུངས་འགྲོ་འདུག་བྱས་ཚེ་ན།",
    "ཕྲན་ཚེགས་འགྲངས་ངོམས་འདུག་རྗེས་དྲག་ཤུལ་འབྱུང་།",
    "ཉིན་པར་གཉིད་ལོག་སྐྱིད་པར་འདུག་པ་དང་།",
    "ཚིགས་དམིགས་ན་ཞིང་བརྐྱང་བསྐུམ་འགྲོ་འདུག་དཀའ།",
    "རྒྱུ་ནི་སྟན་སྲབ་ཙོག་པུར་འདུག་པ་དང་།",
    "བཞོན་སྟེན་རླན་སྟེང་ཡུན་རིང་འདུག་ལས་འབྱུང་།",
    "འཕོངས་སྟོད་ཉལ་ཏེ་འགྲོ་འདུག་ལངས་པ་སྤང་།",
    "བྱད་སྟེམས་ཤིང་འཛིན་གཅེར་རྒྱུག་གནས་སྟོང་འདུག།",
    "རང་རང་སྤྱོད་ལམ་ཁ་ཟས་དེ་དང་མཐུན།",
    "ཁྱད་པར་རང་རང་འཛིན་པའི་དུས་སུ་བསྟེན།",
    "ལུས་ལ་འབྱར་དང་གསེབ་ན་འདུག་པ་དང་།",
    "རྐྱེན་ནི་སྣུམ་དྲགས་ཟས་དམན་སྨྱུང་བར་འདུག།",
    "དེ་ཡིས་ཟུག་ཆུང་རང་འབྱོར་བྱེད་པ་ཡིན།",
    "མཚོན་ཕོག་དུས་ན་འགྱེལ་བུབ་ཟ་ཟི་མེད།",
    "ནང་པར་བསལ་ལ་རུས་སྐྱོན་གང་འདུག་བརྟག།",
    "གླད་བཟང་རང་སར་འཁྲིགས་ནས་ཆུ་མི་འབྱུང་།",
    "ཁད་སྙམ་སྟན་ལ་ལུས་བསྲང་སྐྱིལ་ཀྲུང་འདུག།",
    "དོན་ཟིན་ཕོག་དུས་ཤེས་པ་ཟི་ཞིང་འཚུབ།",
    "འདུག་སར་མི་ཚུགས་དགུ་ཡི་དུས་ན་འཆི།",
    "སྨྲ་འདོད་ཞེ་ས་མཁས་ལ་འགྲོ་འདུག་བྱེད།",
    "ཚབས་ཆེ་ཁྲག་ཏུ་འཁྲུ་སྐྱུག་ཕོག་དུས་འཆི།",
    "རྩ་རྣམས་རང་རང་རྟགས་དང་ཁྱད་པར་མེད།",
    "དང་པོ་ཁྲག་དུས་ཟུག་གཟེར་བཅག་པ་དང་།",
    "རྣག་དུས་ཟུངས་ཟད་མདའ་ཟད་དགྲ་བྱུང་འདྲ།",
    "ཁད་མཉམ་སྟན་ལ་ལུས་བསྲང་སྐྱིལ་ཀྲུང་འདུག།",
    "སོ་ཆ་སྤྱང་ཚེར་དུས་གསུམ་རྟས་ཁྲག་དུས་ཆུ།",
    "གཞུག་དུས་དབྲལ་དུས་དམ་དང་ལྷོད་པའི་སྐྱོན།",
    "ཤ་ཡི་སྟེང་འཕྱང་རང་སར་སྡོམ་པའི་ཁྲ།",
    "གཞུག་དུས་རྨ་ཡི་སྐྲངས་དང་ཚ་བ་ཆོགས།",
    "ཁྲག་དུས་ཚ་བ་སྟོད་ཤོར་ཡེན་ལ་གཏད།",
    "ཁྲག་དུས་ཨ་བོ་ཧོང་ལེན་ཨ་བྱག་དང་།",
    "རྣག་དུས་བསེ་རུ་བྲག་སྤོས་ཅོང་ཞི་དང་།",
    "གར་འདུག་དེ་ཡི་སྟེང་དུ་ལུམས་བྱ་ཞིང་།",
