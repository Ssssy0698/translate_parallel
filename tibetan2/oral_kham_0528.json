    "སྟོད་ལུང་པས་ཁྱེད་རང་ཇི་ལྟར་མཛད་གསུངས་པས།",
    "ང་རང་སྣང་བ་མ་དག་པ་ཡིན་གྱིས།",
    "བཞག་ནས་གནོད་པའི་ལན་འཇལ་བའི་དུས་བྱུང་ཙ་ན་འཇལ་བ་དེ་སྤང་བར་བྱའོ།",
    "དགེ་སློང་ཞིག་མེ་གཏོང་ཞིང་འདུག།",
    "ཚོས་ཕྲུ་ཁ་ཕྱེ་ནས་བལྟས་པས་ཤ་རུ་འདུག་པ་ཟེར།",
    "དགེ་སློང་དེས་བེའུ་རྐུས་པར་མི་གདའ་བས་གཏོང་བར་ཞུ་ཞུས་ནའང་།",
    "དངོས་བས་ཀྱང་ཞེ་སྡང་ཆེ་བའི་རིགས་ཡོང་བར་འདུག་གསུང་།",
    "དེ་ལྟར་དགྲ་རྣམས་ཀྱང་དགའ་བ་བསྐྱེད་ཅིང་རང་གཞན་གྱི་ཞེ་སྡང་ཞི་བར་བྱས་པ་དེ་གཅིག་ལགས་ཏེ།",
    "གསུམ་པ་ཆགས་སྡང་སྤངས་ཤིང་དབེན་པ་བསྟེན་ནས་དལ་བར་སྡད་དུ་ཕངས་པ་གདའ་བས་སྒོ་གསུམ་སྐད་ཅིག་ཀྱང་མ་དལ་བར་དགེ་སྦྱོར་བགྱིས།",
    "གསུང་ཟེར་ཏེ་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བར་གདའ་གསུང་།",
    "རྒྱལ་སྲས་ཐོགས་མེད་ཀྱི་གསུང་འབུམ། གབྱ་བའི་དོན་ནི་ནང་དུ་འདུག།",
    "ཁོང་རང་ཡང་ངེས་ཤེས་སྐྱེས་ནས།",
    "ཤིན་ཏུ་མད་པར་འདུག།",
    "ཁྱད་པར་ལངས་ནས་རྟ་རྒྱུག་པ་ལ་ཆགས་ཀྱིན་གདའ་ཞུས་པས།",
    "ཕངས་པར་འདུག་གསུང་ནས་མ་གནང་།",
    "ལུས་ལ་སྤུ་ཆེན་པོ་སྐྱེས་འདུག་པ་མཐོང་བས།",
    "གཉེན་ལ་ཡང་ཕན་པ་ཞིག་འདུག་སྟེ།",
    "མང་མཁར་བ་སོགས་ལ་གནང་ང་ཡིན་འདུག།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ཤིན་ཏུ་མད་པར་གདའ་ཞིང་།",
    "ཁོང་པས་ཕྱག་མཐིལ་བསྟན་པས་མཐིལ་ན་སྤྱན་ཧྲིག་གེ་འདུག་པ་ཀུན་གྱིས་མཐོང་བར་གདའོ།",
    "དཔེ་འདིའི་མཚམས་ན་ཚིག་ཇི་སྐད་བྱ་བ་གདའ་བྱས་ནས།",
    "འདི་སྐད་བྱ་བ་འདུག་གསུངས་ནས་གང་དྲིས་ཤ་ར་ར་གསུངས།",
    "ཡང་ཁྱིམ་མཚེས་ཀྱི་དགེ་སློང་གཅིག་ཅི་བྱེད་ཀྱིན་གདའ་ཞུས་པས།",
    "ནངས་པར་བལྟས་པས་ཤིག་ཤི་འདུག་པས་ཡུན་རིང་ཤུམས་ཟེར།",
    "དེའི་བྱིན་བརླབས་ཡིན་པ་འདྲ་སྟེ་ཕྱིན་ཆད་བསོད་སྙོམས་ལ་ཕྱིན་དུས་ཁྱི་བྱུང་ཙ་ན།",
    "སྤྱི་བོར་ཁྱེད་ཐུགས་རྗེ་ཆེན་པོར་བསྒོམས་ཙ་ན།",
    "ཁྱི་ཐམས་ཅད་རང་བཞིན་གྱིས་ལོག་འགྲོ་ཡིན་གདའ་ཞུས་པས།",
    "ཁོང་ཀུན་གྱི་འོ་སྐོལ་ཐུགས་རྗེ་ཆེན་པོར་དངོས་སུ་མཐོང་ཟེར་ནས་དག་སྣང་ཆེན་པོ་གདའ་གསུང་ངོ།",
    "གཉིད་སད་ནས་ཅི་ཡིན་སྙམ་ཙ་ན།",
    "སྐྱེ་སྒང་པ་གཉིས་ཐུགས་རྗེ་ཆེན་པོའི་སྤྲུལ་པ་ཡིན་པར་འདུག།",
    "དངོས་པོ་གང་འདུག་ཡབ་ཀྱི་དགེ་རྩ་ལ་བཏང་།",
    "བྱིས་པ་གཞན་མིས་བརྡུངས་ཙ་ན་བཤུམ་པ་ཞིག་ཡོད་ཅེས་གྲགས་སོ།",
    "ཉིད་ཐོགས་མེད་དངོས་སུ་འདུག།",
    "དེ་དུས་ཕར་ཚད་གཉིས་ལའང་ཊཱིཀྐ་བྱས་ན་ལེགས་རབ་ཡོང་བར་གདའ་སྟེ།",
    "ལེགས་རབ་གཅིག་བྱུང་ནས་འདུག་གསུང་།",
    "དེ་ནས་ཡང་བློ་ལ་གསལ་ལེ་འདུག་པས་ལྡབས་ནས་བྲིས།",
    "འོ་སྐོལ་གྱིས་ལོ་སུམ་ཅུ་རྩ་གྲངས་ཤིག་ཏུ་བེད་སྤྱད་འདུག།",
    "དེ་དུས་མ་འོངས་པའི་མངོན་ཤེས་གསུངས་པར་གདའ་གསུང་།",
    "མི་འདི་དང་འདི་ཞེས་བྱ་བ་ཤི་ཟེར་བ་ཐོས་ཙ་ན་འོ་སྐོལ་གྱི་ལུས་འདི་ལ་ཡང་ཆུའི་ལྦུ་བའམ།",
    "སྐད་ཅིག་གནས་པའི་གདེང་ཡང་མི་འདུག་ན།",
    "སྒྲོལ་མ་སྒྲོལ་མ་འཕགས་མ་འཕགས་མ་གསུང་ནས་སྤྱན་ཆབ་ཉིལ་ཉིལ་འདུག་པ་དང་།",
    "སྲང་བར་ཞིག་ཏུ་ཕྲད་པས་ཉིད་ཀྱིས་དོན་གལ་ཅན་གྱི་བཏབ་བཅོག་པ་འདུག་ཟེར་ནས་འཐབ་ཏུ་བྱུང་བས།",
    "ཐབས་མཁས་ལ་ཐུགས་རྗེ་ཆེ་བའི་ཕྱག་ལེན་དུ་གདའོ།",
    "བཙུན་པ་ཐམས་ཅད་འབྱོན་པར་འདུག་དེ་ནས་ང་ལ་ལྟོ་སྟེར་མི་མི་ཡོང་ཟེར།",
    "དེ་ཁོང་པ་མད་པར་གདའ་གསུང་ནས་སྤྱན་ཆབ་ཉིལ་ཉིལ་མཛད་ཅིང་འདི་ལྟར་གསུང་ངོ།",
    "བཤུམས་པའི་མཐར་བརྒྱལ་གྱི་བར་དུ་བཤུམས་འདུག་ཅེས་གྲག་གོ།",
    "ཇ་གསོལ་ཟིན་པའི་རྗེས་ལ་ཡང་ཆུ་འདུག།",
    "ཡར་ལམ་ཕྱེད་ཀྱིས་ལྟས་པས་ཆུའི་རྗེས་ཡང་མི་འདུག་ཟེར་རོ།",
    "དྲུང་དུ་ཞིག་ཐོབ་ན་བསམས་པས་སྐུ་ཁམས་ཀྱིས་ལྕོགས་ཙམ་དུ་གདའ་ན་ཐུགས་ལ་འདོགས་པར་ཞུ་ཞུས་པས་དེ་དུས་སྙུང་རབ་འདུག་ཏེ།",
    "དུས་ཕྱིས་ཀྱང་འདི་འབོགས་པ་ཉུང་བར་གདའ།",
    "ཉིད་ཀྱི་ཤིག་བླངས་པ་མ་ཡིན་ང་རང་ལ་ཡོད་པ་ཡིན་གསུང་ནས་མ་གནང་།",
    "གཞན་གྱི་ན་ཚ་ལ་སོགས་ལ་གཏོང་ལེན་གྱི་དམིགས་པ་བྱས་ཙ་ན་ཁམས་ཉོག་པོ་འགྲོ་ཡིན་འདུག་གསུངས།",
    "སེམས་དཔའ་ཆེན་པོ་རང་ལ་ཡང་གོང་དུ་གདན་འདྲེན་པའི་འཇའ་ས་ཡོད་ཟེར་བ་ཡང་འདུག།",
    "རང་ཁྲི་དང་རང་ཐག་འོང་བཅུག་པས་དབེན་ཤྲིས་མཐོང་ནས་རྩ་ར་ཆེན་པོ་བྱེད་པ་ལ་བྱུང་བ་ལ་ཡང་གསུང་བྱོན་པ་ཙམ་གྱིས་གྲོལ་བར་བྱས་ཏེ།",
    "དེ་དུས་མཁན་ཆེན་བུ་སྟོན་པ་བསྙུང་ནས་གྲོངས་ལ་ཁད་པ་འདུག་པ་མཇལ་ཏེ།",
    "རྨི་ལམ་བཟང་པོ་ཡིན་ང་ཡང་མདང་ཁམས་བདེ་ཞིང་རིག་པ་དྭངས་པ་ཞིག་བྱུང་གསུངས་ནས་མཉེས་འདུག་ཟེར།",
    "ཇག་པའི་རལ་གྲི་ཞིག་བཞག་འདུག་པ་ཁྱེར་ནས་བྲོས་ན་བསམ་ཡིན་ཡོད་ཙ་ན།",
    "ཕོངས་ནས་ཐབས་རྡུགས་པས་ཉིད་ལྟ་བུ་ཞིག་དང་ཐུག་ཟེར་ཡིན་འདུག་ཟེར།",
    "ཁོང་རྣམས་པས་འཇམ་པའི་དབྱངས་དོན་ཡོད་པའི་དྲུང་དུ་ཕྱིན་ཏེ་འདི་བཞིན་མཛད་ཡིན་གདའ།",
    "ངེད་ཚོས་ཞུ་བ་བྱས་ཀྱང་འདི་སྐད་གསུང་ནས་མི་གསན་པར་འདུག་དྲུང་ནས་གསུང་འབྱོན་དགོས་པར་གདའ་ཞུས་པས།",
    "སེམས་དཔའ་ཆེན་པོའི་སྐུ་ལུས་ལ་འཕུངས་ནས་ཞག་གཅིག་ལ་ཤི་འདུག་ཟེར།",
    "ཡར་ལོང་ལ་ཤོག་གསུང་ཡིན་འདུག་དྲུང་ནས་སྐུ་ནས་བགྲེས་པ་དང་ཤིག་ཚན་ཆེས་དྲགས་པས་ཅི་འགྱུར་མི་ཤེས་ཞུས་ཀྱང་མི་གནས་པར་ལོངས་ཤོག་གསུང་།",
    "ཅེས་སོགས་ཀྱིས་བསྟོད་པ་མང་པོ་ཡང་འདུག་གོ།",
    "སུམ་ཚོགས་པ་ཡོང་བ་གདའ་སྟེ།",
    "ངས་ལན་ཅིག་དངུལ་ཆུར་ཕྱིན་པས་ཀྱང་ཁོང་མཚམས་དམ་པོ་ལ་བཞུགས་འདུག་པས་མ་མཇལ།",
    "ཁོང་མཚམས་དམ་པོ་ཞིག་ཡོད་པར་འདུག་པས།",
    "ཁོས་མ་ཤེས་པར་འདུག་མད་ལགས་ཟེར་རྒྱུ་ཡིན་ཏེ།",
    "ཧ་ཅང་མི་རིགས་པ་བྱས་ཙ་ན་དེ་ཀ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "དངོས་སུ་མི་ཆེན་གྱི་རིགས་འདུག་པ་ལ་ཡང་།",
    "འདོད་ཡོན་གྱི་སྲེད་པ་སྤངས་ཙ་ན་ ཡུལ་མཐུན་རྐྱེན་ལམ་གྱི་གྲོགས་སུ་འཆར།",
    "ཞེན་ཆགས་མི་མངའ་ཆགས་སྡང་རང་སར་གྲོལ།",
    "ལན་ཅིག་ས་སྐྱ་ན་སྤྲང་པོ་འཆི་ལ་ཁད་ཅིག་འདུག་པ་ལ།",
    "མ་ཤི་བར་ནམ་ལ་ཁྱིས་ཟ་བར་འདུག་ཟེར་ནས་སེམས་ལས་འདུག་པས།",
    "དངུལ་ཆུར་ཉེ་གནས་མེད་པའི་ཤུལ་དུ་གསེར་སློང་ལ་བྱང་དང་ར་ནས་ཡོང་བའི་མི་གསུམ་ཙམ་གཅིག་སློང་དུ་བྱུང་བ་ལ་ནམ་བཟའ་བེར་ཐུལ་གཅིག་དང་རྩམ་པ་གང་ཡོད་གནང་འདུག་ཟེར།",
    "གསུང་པ་ལ་སློབ་དཔོན་ཡོན་ཏན་འོད་ཀྱིས་ཅི་གདའ་ལགས་ཞུས་པས།",
    "དེ་མ་ཡིན་པའི་འདར་ཞིང་འདེབས་ཕུར་འབྲོག་འཛིན་ལས་སུ་ཚོང་ཁེ་སྐྱེད་པ་འདི་རྣམས་ལ་ཁྲལ་མི་འགེལ་ན་དེ་ནས་སུ་ལ་འགེལ་དུ་འདུག་ཟེར་ནས་བྱུང་བས་འོ་སྐོལ་གྱིས་ཀྱང་ཟེར་ས་མ་རྙེད་གསུང་།",
    "མི་གནོད་གདའ་ཞིང་ཐབས་ཤེས་ཟུང་འབྲེལ་ཕྱིར།",
    "དེ་ཉིན་ཐུགས་ཁྲལ་ཆེན་པོ་མཛད་ཡིན་འདུག་ཟེར།",
    "རྒྱལ་སྲས་ཐོགས་མེད་ཀྱི་གསུང་འབུམ། གའདུག་ཏེ།",
    "གཟིམ་མལ་ན་གཡི་དཀར་གྱི་གདན་ཞིག་འདུག་པ་མཐོང་བ་དང་།",
    "ཐོ་རངས་ཁ་གསང་ནས་དངུལ་ཆུར་བཞུད་འདུག་ཅེས་གྲག་གོ།"
  ]
}