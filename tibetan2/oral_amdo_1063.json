    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་ལེགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དང་གཏུམ་མཆིས།",
    "གལ་ཏེ་གོམ་པ་དོར་བ་རེ་རེ་ལ་ཐམས་ཅད་མཁྱེན་པའི་སེམས་དང་བྲལ་བར་གྱུར་ན་དེ་དག་བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་མཆིས།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་མཆིས།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་མཆིས།",
    "བུད་མེད་དང་ལྡན་པ་ལས།",
    "གཞན་ལ་གནོད་ཅིང་སྔ་དགོང་བ་དང་ལྡན་པའི་སེམས་བསྐྱེད་པ་བྱུང་ན་བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དང་གཏུམ་མཆིས།",
    "གོལ་ཏེ་བུད་མེད་ལ་འདི་ལྟར་མི་རྟག་པའི་རྣམ་པ་འམ།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུམ་མམསནས།",
    "དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་གྱི་འདུ་ཤེས་མ་བསྐྱེད་ན་བདག་གིས་ཕྱོགས་བཅུ་ཀུན་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མཆིས།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔགཏུམམས།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་མཆིས།",
    "བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་མཆིས།",
    "ཞེས་དེ་ལྟ་བུའི་འདུ་ཤེས་བསྐྱེད་པར་གྱུར་ན་བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དབག་ཏུ་མ་མཆིས།",
    "བདག་གི་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་པས།",
    "གལ་ཏེ་ཐ་ན་གཡརལརཙམ་དུ་ཁུ་བ་ཕྱུང་བར་གྱུར་ན་བདག་གིས་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔགཏུམསམས།",
    "བདག་གིས་བརྩལ་ཞིང་བསྒྲུབ་པར་བགྱིའོ།",
    "བདག་གིས་ཕྱོགས་བསྩཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མ་མཆིས།",
    "སེའོས་ཅན་གང་དག་ལེར་བར་གྱུར་པ་དེ་དག་ཀྱང་མིག་གིས་གཟུགས་མཐོང་བར་གྱུར་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེཤེས་བརྙེས་པ་ན་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་ན་བུད་མེད་སྦྲུམ་པར་གྱུར་པ་དེ་དག་ཐམས་ཅད་ཀྱང་དེའི་ཚེ་བདེ་ཞིང་བཀྲ་ཤོས་རྨ་བས་ཀ་།་ན་འཔར་བཅས་པར་གྱུར།",
    "ལྟོ་འཕྱེ་ཆེན་པོ་གང་དག་འབོད་པ་དེ་དག་ཐམས་ཅད་ཀྱིས་ང་ལ་མ་མོད་པ་བྱ་བའི་ཕྱིའི་ལྷའི་མེ་ཏོག་དང་།",
    "ལྷ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱསུ་ཕྲག་དུ་མ་དག་སྟེང་གི་བར་སྣང་ལ་འཁོད་ནས།",
    "མྱང་བ་རྣམ་པ་སྣ་ཚོགས་དག་གི་ནི་པ་ཏོང་བར་བྱེད་དོ།",
    "མོདང་ལྡན་པཤཱ་ར་དྭ་ཏིའི་བུ་ལ་འདི་སྐད་ཅེས་སྨྲསཀོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཕྱརེར་སྙན་པར་འགྱུའོ།",
    "བདག་གིས་དམ་བཅས་པ་ནི་གཞན་དུ་མ་འགྱུར་བར་བྱའོ།",
    "གང་གིས་ལག་པ་རྐང་པ་འམ།",
    "འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་དག་གིས་རྩེ་ཞོརེདགའ་ལ་དགའམགུར་སྤྱད་པ་ཚེ་ཟད་པར་འགྱུར་རོ།",
    "སེམོས་ཀྱི་ཉམས་བདེ་བ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "ཤཱ་རཱ་ཏིའི་བུ་དེ་ཡང་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡ་དདག་པར་རྫོགས་པའི་མོའཁྲུགས་པ་དེ།",
    "ཡུད་ཙམ་དེ་ལ་སྟོང་གསུམ་གི་སྡོང་ཆེན་པཚོའིཇིག་རྟེན་གྱི་ཁམས་དེ་ན།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡ་ང་དག་པ་བརྫ་གོས་པའི་ས་རྒྱས་པ་འཁྲུགས་པ་དེའི་འབོད་དག་གིས།",
    "བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཤཱ་ར་དྭགི་བུས་འདི་སྐད་ཅེས་གསལཏོ།",
    "ཀ་ཙ་ལིན་དི་ཀལྟར་རེགན་བདེ་ཞིང་།",
    "ཤཱར་དྲ་འོ་བུ་དེ་དག་གི་གོས་ཀྱི་དྲི་ཡང་དེ་འདྲ་ལ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་གལ་ཏེ་འདིའི་རིགས་ཀྱི་བུ་འམ་གས་ཀྱི་བུ་མོ་གཔལལཞིག་གིས་འདི་སྔོན་དུ་གང་དེ་བཞིན་གཤེགས་པ་ཁྱིམ་འདིར་གཤེགས་པའི་ཞབས་འོག་ནས་བྱུང་བའི་པདྨོ་དེ་དག་ཐམས་ཅད་གནས་གཅིག་ཏུ་འདུས་པར་གྱུར་ཅིག་སྙམདུ་བསམསན་ཡང་།",
    "ཤ་ར་ད་ཏིའི་བུ་གང་གི་ཚེའཛམ་གླིང་པའི་མི་དེ་དག་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་སུ་འཛེགས་པར་གྱུར་པའི་རིན་དེ་དགསུམ་ཅུ་རྩ་གསུམ་པའི་ལྷརྣམཱ་དེདགའདིསཱིམ་དུ་ལྷ་འདི་དག་གི་ལྷའི་ཕུནསུམ་ཚོགས་པ་དག་ལས་བདག་ཅག་གི་ཕུནསུམ་ཚོགས་པ་དག་ཀྱང་མི་དམནཔའི་སྟེང་དུ་ལསྨིན་པར་བྱེད་དོ།",
    "རྩིས་འདི་དག་གིས་བགྲང་བའམ།",
    "འདི་ལྟ་སྟེ་ལན་ཅིག་ཕྱིར་འོང་བ་ཞེས་འབྲས་བུ་རྣམ་གཞག་པ་དེ་ནི་མོང་ཙམ་དུ་ཟད་དོ།",
    "འདི་ལྟར་ཕྱིའི་མ་འོང་བ་ཞེས་འབྲས་བུ་རྣམ་པར་གཞག་པ་དེ་ནི་མོང་ཙམ་དུ་ཟད་དོ།",
    "ཤར་དྭ་ཏིའི་བུ་ཡང་དེ་ན་རིགས་ཀྱི་བུ་མ་རིགས་ཀྱི་བུམོ།",
    "བདག་གི་དོན་རྗེས་སུ་ཐོབ་པ།",
    "དགེ་སྦྱོང་གི་དཀོར་དུ་བྱ་བ་དང་།",
    "དགེ་སྤྱོང་གི་གྱ་གྱུར་བྱ་བ་དང་།",
    "དགེ་སྦྱོང་གི་གཡོར་བྱ་བ་དང་།",
    "དེ་ན་ཉན་ཐོས་གཅིག་དང་ཉན་ཐོས་གཉིས་ལྡན་ཅིག་ཅིག་ཏུ་མི་གནས་པར་དེ་དག་རང་རང་གི་རྣལ་འབྱོར་གྱི་དོན་ལ་རྗེས་སུ་བརྩོན་པར་གནས་སོ།",
