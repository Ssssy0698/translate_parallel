    "ཞེས་པ་གཞི་གསལ་སྟོང་ཟུང་འཇུག་གི་གནས་ལུགས་དང་མ་བྲལ་བའི་ངང་ནས་སྣང་བ་རྣམས་ཆུ་ལས་ཟླ་གཟུགས་ཤར་བ་ལྟར་སྣང་ལ།",
    "ཆུ་ཟླ་སྤྲིན་དང་ཁུ་རླངས་དང་ཐལ་ཚུབས་གཡོ་འགུལ་སོགས་དང་འོད་སྣང་གསལ་འགྲིབ་འགགས་པ་མེད་པར་བྱེད་པ་བཞིན་དུ་སྣང་བ་རྣམས་རང་རང་གི་རྒྱུ་རྐྱེན་ལ་བརྟེན་ནས་བྱ་བྱེད་རྒྱུ་འབྲས་སུ་འབྱུང་ངོ།",
    "རང་རང་གི་རྒྱུ་རྐྱེན་ལ་བརྟེན་ནས་བྱུང་བ་མི་འདོད་དོ།",
    "ཁས་ལེན་ཕྱོགས་གཅིག་ནས་ཡོད་ན་བེམ་ཤེས་གང་རུང་དུ་ཁས་ལེན་པས་དེ་ལྟར་ན་ཁྱོད་ཀྱི་ཅི་ཡང་མེད་པ་དེ་ཡང་བེམ་པོར་ཐལ།",
    "ཁྱོད་ཀྱིས་འདོད་པའི་བེམ་པོ་དང་རྟག་ཆད་ཀྱི་ལྟ་བ་སོགས་ཀྱི་ཕྱོགས་ན་མེད་པ་དང་།",
    "ཚིག་ཙམ་ཞིག་གི་བརྡ་ལ་བརྟེན་པའི་དགག་སྒྲུབ་ཀྱིས་མ་རིག་པ་དྲུང་ནས་འབྱིན་ག་ལ་ནུས།",
    "ཅི་ལྟར་དཀའ་བའི་ཚིག་གི་རྒྱ།",
    "གང་གི་མཚན་ཙམ་རྣ་བར་སོན་པ་ན།",
    "ཁྱད་པར་དུ་གང་ཟག་རེ་རེའི་རྒྱུད་ལ་སེམས་ཡོད།",
    "རང་གི་རྟོག་བསྒྲིབ་དེ་མ་མཐོང་།",
    "དྲི་མེད་མདངས་གསལ་ཞེས་གཞི་གསལ་སྟོང་ཟུང་འཇུག་གི་གནས་ལུགས་ཀ་དག་ཡིན་པས་དྲི་མེད་ཅེས་དང་།",
    "དེ་ལ་སྟོན་པས་སྤྱན་གྱིས་གཟིགས།",
    "རྩལ་གྱི་སྣང་ཆ་དེ་ལ་རང་གི་འཆར་གཞིའི་རྩལ་དུ་ཤར་བའི་སྣང་ཆ་དང་།",
    "ཕྱི་མ་ནི་རྣམ་མཁྱེན་གྱི་གཟིགས་ངོར་ཤར་བའི་ངན་འགྲོའི་སྡུག་བསྔལ་རྣམས་སོ།",
    "གོང་གི་ཐུགས་རྗེ་དེའི་ངོས་ནས་གདུལ་བྱ་སྐབས་སུ་བབ་པ་རྣམས་ལ་ཕན་བདེའི་ལམ་བཟང་སྟོན་པ་ཡིན་ཏེ།",
    "སྟེང་དུ་དགག་བྱའི་ངོ་བོ་ཡོད་མེད་དོན་དམ་དཔྱོད་པའི་རིག་ཤེས་ཀྱིས་བརྟག་ནས་དགག་བྱའི་ངོ་བོ་དེ་གཞི་དེ་ཡི་སྟེང་དུ་མ་རྙེད་པས་གཞི་དེ་ཡི་རང་བཞིན་སྟོང་པ་ཡིན་པར་ངེས་དགོས་ཤིང་ངེས་བྱེད་དེ་ཡི་ངོར་དགག་བྱ་བཅད་པའི་མེད་དགག་གི་རྣམ་པ་ཤར་བ་ཞིག་གོ།",
    "ཁྱད་པར་དུ་གང་ཟག་རེ་རེའི་འཆི་དུས་ཀྱི་སྐབས་དེར།",
    "རྐྱེན་གང་གིས་བྱས་ན་སྒྲ་འོད་ཟེར་གསུམ་དེས་བྱས།",
    "ཤེས་པ་དེའི་རྐྱེན་གྱིས་ཡུལ་ལ་འཛིན་པ་རགས་སུ་སོང་བ་དང་།",
    "ཡུལ་གྱི་བྱེ་བྲག་མང་དུ་ཕྱེས་ནས་ཤེས་པ་དེ་རགས་སུ་སོང་བའི་སྟོབས་ཀྱིས་སྣང་བའི་ཡུལ་རྣམས་དཀྲུགས།",
    "བདག་དང་གཞན་དུ་བཟུང་བས་ཉོན་མོངས་དུག་ལྔ་བྱུང་།",
    "ཞེས་གསུངས་པ་དགོངས་པ་ཅན་ལས་རང་གཞུང་གི་དོན་མ་ཡིན་ཏེ།",
    "ཡོན་ཏན་ཞེས་པའི་འཛིན་རྟོག་གང་གིས་ཀྱང་མ་བཅོས་མ་བསྒྱུར་བས་སྣང་བ་ཐམས་ཅད་སྟོང་གཟུགས་སུ་ཤར་བས་སྐྱོན་དང་ཡོན་ཏན་གྱི་དྲི་མ་གང་ཡང་གཞི་ཐོག་ཏུ་མ་བསགས་པས་ན་རབ་ཏུ་གསལ་བའོ།",
    "སྐབས་འདིར་དགག་བཞག་གི་ཐ་སྙད་སྤྲོ་བ་མང་དུ་འབྱུང་སྲིད་ཀྱང་།",
    "འཛིན་རྟོག་གི་བློ་དང་བྲལ་བར་བྱའོ།",
    "སྐུ་དེ་ས་ཐོབ་འཕགས་པའི་གང་ཟག་ཁོ་ན་ལས་གཞན་གྱིས་གཟིགས་ཡུལ་དུ་མ་གྱུར།",
    "གཟིགས་ཚད་བཞི་དང་དགོངས་ཚད་དྲུག་གཉིས་ཀྱི།",
    "གང་གིས་གསོལ་བ་འདེབས་པ་པོ་ནི་སྔོན་རབས་གྱེར་སྤུངས་སྣང་བཞེར་ལོད་པོ་དང་།",
    "རྐྱེན་གྱིས་མ་བསྒྱུར་བར་ཡེ་ནས་སྟོང་གསལ་ཟུང་འཇུག་གི་དོན་ལས་གཡོ་བ་བྱུང་མ་མྱོང་པས་རྩ་བ་བྲལ་བ་དང་།",
    "འགྲོ་དྲུག་ཐུགས་རྗེས་ཟུངས་ཞེས་རྗེ་དེ་ཡི་ཐུགས་རྗེས་འགྲོ་དྲུག་ལ་བརྩེ་བ་འདོར་མི་སྲིད་མོད་ཀྱང་རང་གིས་དེ་ལྟར་བསྐུལ་བའི་རྐྱེན་ལ་བརྟེན་ནས་ཐུགས་རྗེའི་འཇུག་པ་དང་འཕྲད་པའི་རྒྱུ་རུ་འགྱུར་ཏེ།",
    "རྗེས་བྱ་མཇུག་གི་དོན་བསྟན་པ།",
    "བྱང་སེམས་གབ་པའི་གཞུང་གི་སྤྱི་ཆིངས་རིགས་པའི་ལམ་བཟང་ཞེས་བྱ་བ།",
    "གང་གི་ཐུགས་རྗེའི་ཉི་འོད་གསལ།",
    "དེ་ནི་རྗེ་ཡི་གབ་འགྲེལ་ཀུན་བཟང་གི་དགོངས་པ་གསལ་བྱེད་ཉི་མའི་དཀྱིལ་འཁོར་ལས།",
