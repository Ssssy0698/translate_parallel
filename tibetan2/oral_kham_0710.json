    "ལོ་ངོ་དུང་ཕྱུར་ཡི་ཡར་སྔོན་གྱི་ཉི་མ་གཅིག་དུས་ཚོད་ཡིན།",
    "ལོ་ངོ་དུང་ཕྱུར་ཀྱི་སྔོན་དུ་ཉི་མ་གཅིག་དུས་ཚོད་ཡིན།",
    "ཐོག་མར་མཁའ་སྐྱོད་འཕུར་གྲུར་བསྡད་དེ་སྟོང་ཁམས་སུ་ཆས་པའི་སྔར་གྱི་སུའུ་ལེན་གྱི་མཁའ་སྐྱོད་པ་ཅ་ཅ་ལིན་གྱིས་ང་ས་སའི་གོ་ལར་མིང་བཏགས་པ་ནོར་འདུག་དེར་ཆུའི་གོ་ལ་ཞེས་བོས་ན་འགྲིག་འདུག་ཟེར།",
    "བགྲང་དཀའ་བའི་སྐར་མ་མང་བོ་མགྱོགས་མྱུར་སྒོས་འགུལ་སྐྱོད་བྱེད་ཀྱིན་འདུག་མིའི་རིགས་ཀྱི་རྟེན་གཞི་སྟེ་སའི་ལྐོག་གྱུར་གྱི་འཇིག་རྟེན།",
    "བྱང་གླིང་དུམ་བུ་གསུམ་བཅས་ཁྱིམ་བཅུ་གཉིས་བགོས་འདུག་ཁྱིམ་དུམ་བུ་བཅུ་གཉིས་ཡོད་པའི་ནམ་མཁའི་གོ་ལ་གཡས་སུ་འཁོར་ཞིང་།",
    "སྤྱི་འཁོར་རྒྱག་དུས་སྐར་མ་དུ་བ་མཇུག་རིང་ལ་ཕལ་ཆེར་སྐར་མགོ་དང་སྐར་རྔ་མེད།",
    "དེ་ནི་ཚངས་ཐིག་ལ་སྤྱི་ལེ་ཁྲི་ཡོད་པའི་ཉི་མ་ལས་ཀྱང་ཆེ་འདུགསྐར་མ་དུ་བ་མཇུག་རིང་དེའི་སྐར་རྔའི་རིང་ཚད་ལ་སྤྱི་ལེ་དུང་ཕྱུར་དང་ཞེང་ཚད་ལ་སྤྱི་ལེ་ཁྲི་ཡོད་པས།",
    "མི་རྣམས་ཀྱི་སྣང་ངོར་ཉི་མ་ཤར་ཕྱོགས་ནས་ནུབ་ཕྱོགས་སུ་སའི་གོ་ལར་སྐོར་བ་གཅིག་རྒྱག་བཞིན་འདུག་སྙམ་སྲིད།",
    "འོད་སྣང་དེའི་འཚེར་ཡུན་ནི་དུས་ཚོད་སྐར་མ་ཉི་ཤུ་ཡས་མས་ཡིན་འདུག་མི་རྣམས་ཀྱིས་འོད་སྣང་འཚེར་བ་དེ་ནི་ཕལ་ཆེར་དབུགས་གཟུགས་འགུལ་སྐྱོད་བྱས་ལྐོག་གྱུར་གྱི་འཇིག་རྟེན།",
    "བརྟན་སྐར་མང་བོ་ཞིག་དུས་ཚོད་སྐར་ཆ་འགའ་ཤས་ལའང་སྨིས་ཁྲི་ཕྲག་འགའ་དང་ཡང་ན་སྨིས་ཁྲི་བཅུ་ཕྲག་འགའ་ཤས་ལ་མྱུར་སྐྱོད་བྱེད་བཞིན་ཡོད།",
    "རྩའི་གནས་དང་རང་བཞིན་བསྟན་པར་ཡང་བྱས་ནས།",
    "དེ་ཡང་རང་བཞིན་གྱི་ཚེས་གཅིག་ལ་སོགས་པ་ལ།",
    "འགྲོ་འདུག་འཇམ་པའི་གཏེར་ཁ་འཛོམས།",
    "ང་རང་གླིང་རྗེ་གེ་སར་གྱིས།",
    "རྒས་ར་རྩ་ཐུག་དུས་བཤས་རྭར་ཕབ།",
    "སྐྱེ་འགྲོ་རྒྱུན་དུ་མི་ཆད་འདུག།",
    "དེ་ནས་གླིང་རྒྱལ་ཁག་ལྔའི་དཔོན་བློན་དཔའ་བརྟུལ་རྣམས་ལྷ་གུར་ནང་ཕྱག་ཕེབས་ཤིང་རང་རང་གདན་ལ་བཞུགས་སྐབས་སུ།",
    "ང་རང་སྟག་ལྷ་ཅི་ལ་བསྐོས།",
    "ཐམས་ཅད་དགའ་སྐྱིད་ངང་ལ་གཞིས་བྱེས་འཛོམས་པར་གདའོ།",
    "འདི་མན་ཆད་ཀྱི་འདུག་པའི་འཁྲུལ་འཁོར་ཐམས་ཅད་ཀྱི་མཐར་རྡོར་འབེབས་འདིའི་སྒོ་ནས་མཐར་དབྱུང་བ་ཡིན་ནོ།",
    "འདུག་པ་དེ་ལས་ཡར་མ་ལྡང་བར་བཅའ་བའི་འཁྲུལ་འཁོར་ཐམས་ཅད་འདུག་པའི་འཁྲུལ་འཁོར་དང་།",
    "རྐང་ལག་བཞི་འདུག་སྟངས་རང་སར་གནས་པ་ལས་འཆུན་ལྷོད་ཀྱིས་གློད་ནས་མགོ་འདར་བར་བྱས་པའི་སྒོ་ནས་ལན་གསུམ་སྤྲུགས་ལ་རྡོར་འབེབས་བྱའོ།",
    "རོ་སྟོད་ཡར་འཐེན་པ་སྟེ་རོ་སྟོད་གཅུད་པས་རོ་སྟོད་འཆུན་པར་བྱེད་པའི་འདུག་སྟངས་སོ།",
    "སོར་འཐེན་རྐང་འཕྲས་ལངས་འདུག་གཉིས།",
    "ཡང་རྐང་པ་གཡོན་པས་ཀྱང་དེ་བཞིན་དུ་འཕྲ་ཚུལ་བྱེད་པ་ནི་ལངས་འདུག་གཉིས་ཀ་སྟེ།",
    "སླར་ཡང་སྔར་གྱི་འདུག་སྟངས་ལྟར་བསྐུམས།",
    "དེ་ནས་འདུག་སྟངས་རང་སར་གནས་ཏེ་རྒལ་བ་གྱེན་དུ་བཏེགས་ནས་མར་ས་ལ་བརྡབ་པའི་རྒྱབ་འཕུར་ལན་གསུམ་བྱས་ཏེ།",
    "ཡང་བརླ་གཡས་པའི་སྟེང་རང་སར་ཁུ་ཚུར་གཡས་པ་གྱེན་བསྟན་གྱི་སྟེང་དུ་གཡོན་པ་རྦུབ་སྟེ་བཞག་ལ་གཡས་སུ་ལན་གསུམ་དང་།",
    "འདི་ལ་ཉེར་བཞི་ཡོད་པ་ལས་དང་པོ་ནས་བཅུ་དྲུག་པའི་བར་དང་ཉེར་བཞི་པ་རྣམས་ནི་འདུག་པའི་འཁྲུལ་འཁོར་ཤ་སྟག་ཡིན་པར་ཤེས་པར་བྱས་ལ།",
    "དེ་ཡན་ཆད་འདུག་པའི་འཁྲུལ་འཁོར་ཁོ་ནའོ།",
    "ཉེར་གཉིས་པ་དང་ཉེར་གསུམ་པ་གཉིས་དེ་ལངས་འདུག་གཉིས་ཀ་ཅན་གྱི་འཁྲུལ་འཁོར་རོ། དེ་ལ་ཉེར་གཉིས་པ་ནི།",
    "ལངས་འདུག་བྱས་ནས་རྒྱ་མཚོ་བསྐྱོད།",
    "ལངས་འདུག་བྱས་ནས་རྒྱ་མཚོའི་བསྐྱོད།",
    "སེམས་དཔའི་སྐྱིལ་དྲུང་རང་སའི་སྟེང་ནས།",
    "རྐང་པ་གཉིས་མར་ཤད་ཀྱིས་བརྐྱང་པ་དག་དུས་མཉམ་དུ་བྱས་པའི་སྒོ་ནས་རྐང་པའི་མཐིལ་གཉིས་ལོགས་ངོས་ཞིག་ལ་དྲག་ཏུ་བརྡབ།",
    "ཡང་རང་སར་ལངས་ནས་ལྟག་བསྣོལ་གཤིབ་ལ་རྡོར་འབེབ་བྱའོ།",
    "ཡན་ལག་བཞི་ག་དུས་གཅིག་ཏུ་ནམ་མཁར་འཕངས་ལ་ངག་ནས་ཧ་ཞེས་དྲག་ཏུ་འདོན།",
    "སྒྱིད་ཁུང་གཉིས་ཅུང་ཟད་བཀུག་པ་ཟླུམ་པོའི་འདུག་སྟངས་བྱས་ཏེ།",
    "དེ་ནས་རྒྱབ་ས་ལ་གཏད་ནས་ཀན་རྐྱལ་དུ་ཉྭ་བཞི་བཀུམ་ནས་འདུག་ལ།",
    "ཕྱག་ལེན་ལ་འདུག་པའི་འཁྲུལ་འཁོར་རྣམས་ཀྱི་མཇུག་ཏུ་འབེབ་ཆུང་བསྡུས་པ་རྡོར་འབེབ་དང་།",
    "རྐང་ལག་བཞིའི་མགོར་འདུག་ཚུལ་དུད་འགྲོའི་ལུས་དབྱིབས་ལྟར་བྱས་ནས།",
    "དེ་ནས་ཀྱང་འདུག་སྟངས་དེ་གའི་སྟེང་ནས་གཡས་སུ་བསྒྱེད་ནས་ལུས་གཡས་སུ་གཅུད།",
    "བཅའ་གཞིའི་སྐྱིལ་ཀྲུང་རང་སའི་སྟེང་ནས།",
    "དེ་ནས་རྐང་པ་གཉིས་ཟླུམ་པོའི་འདུག་སྟངས་བྱས་ཏེ་ལག་གཉིས་ཁུ་ཚུར་འདོམས་འཇལ་བསྐོར་བ་ཚུར་བསྡུས་ནས།",
    "རྐང་པ་གཉིས་ཟླུམ་པོའི་འདུག་སྟངས་དང་ལག་པ་གཉིས་རྒྱབ་དུ་བརྐྱང་སྟེ་ཁུ་ཚུར་གཉིས་ཁ་སྦུབ་སུ་གཤིབས་ཏེ་རྒྱབ་ཕྱོགས་ཀྱི་ས་ལ་རིམ་པས་ཕབ་སྟེ།",
    "རྒྱབ་ཕྱོགས་ཀྱི་ས་ལ་བཙུག་རྐང་པ་གཉིས་ཟླུམ་པོའི་འདུག་སྟངས་ཀྱིས་འཕོང་དང་རྐང་ངར་སོགས་བཏེགས་ཏེ་གནས་པའི་སྒོ་ནས།",
    "བཅའ་གཞི་སྔོན་དུ་བཏང་ནས་རྐང་པ་སྐྱིལ་ཀྲུང་རང་ས་ལ།",
    "རྐང་ལག་བཞི་ག་དུས་མཉམ་དུ་ཕར་བསྐྱངས།",
    "ལངས་དང་འདུག་ནས་དགང་གཏོང་འདྲེན་པ་སྦགས་འདྲེན་ཏེ།",
    "དེ་ནས་ལངས་པའི་འདུག་སྟངས་རང་སའི་སྟེང་ནས།",
    "ཙོག་པུས་འདུག་ལ།",
    "དེ་ནས་ལག་པ་བགྲད་ཅིང་ཙོག་པུས་གསང་རྩ་བསྡམས་པའི་འདུག་སྟེངས་རང་སའི་སྟེང་ནས་འབེབ་ཆུང་ལན་གསུམ་ལས་མི་ཉུང་བ་བྱའོ།",
    "མི་འོང་ན་ཆེད་དུ་འདོན་པར་བྱ་དགོས་སོ། ཡང་འདུག་སྟངས་སྔ་མ་སྒྱིད་པ་གཏེགས་པ་དེ་གའི་སྒོ་ནས་སམ་ཡང་ན་འཕོང་སྟན་ལ་བཙུག་སྒྱིད་ཁུང་གཡས་གཡོན་གཉིས་བར་ལྷུ་སྟེ་དཔུང་ལྷུ་གཉིས་ཀྱི་སྟེང་དུ་བཀལ་ཏེ།",
    "ལག་མགོ་གཉིས་གྱེན་དུ་ཕྱོགས་ཏེ་གནས་པའི་ལག་ངར་གྱི་ཤུགས་ཀྱིས་བྱིན་པ་གཉིས་གྱེན་ལ་བཏེགས་པའི་འདུག་སྟངས་ཀྱི་སྒོ་ནས།",
    "མཐར་འདུག་སྟངས་དེ་གའི་སྟེང་ནས་ལུས་ཐམས་ཅད་གཡས་གཅུ་དངགཡོན་གཅུ་བྱས་ཏེ་དྲག་ཏུ་སྤྲུགས།",
    "དེ་ནས་འདུག་སྟངས་རྐང་པ་ཙོག་བུ་དང་།",
    "ཡང་ཕྱིས་རྙིང་མ་དང་རིག་འདྲེས་ནས་བྱེད་པར་ཡང་འདུག་པས་སྤྲོ་ན་མདའ་དར་གཡབ་ཅིང་།",
    "ཀྭ་བློ་གཏད་ཅིག་འདུག་གམ་མི་འདུག་སོམས།",
    "རྡོ་རྗེའི་རྭ་གུར་འཇིག་དུས་ཀྱི་མེ་ལྟར་འབར་བའི་མེ་རི་དང་བཅས་པ་སྔར་ལྟར་གསལ་བའི་ལྟེ་བར་བྷྲུཾ་ལས་མཚན་ཉིད་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པའི་གཞལ་ཡས་ཁང་ནག་ལྗང་དམར་སེར་དཀར་བའི་རྩིག་པ་རིམ་པ་ལྔ་དང་ལྡན་ཞིང་གྲུ་བཞི་སྒོ་བཞི་པ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་༴",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུ་ཕཊ།",
    "སླར་ཡང་རང་ཉིད་ཧེ་རུ་ཀ་ཞལ་གཅིག་ཕྱག་གཉིས་པའི་རྣམ་པར་གྱུར་པའི་སྤྱི་བོར་ཨོཾ་དཀར་པོ་མགྲིན་པར་ཨཱ་དམར་པོ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཨོཾ་ཨཱ་ཧཱུ།་།་",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུ་ཕཊ།",
