    "པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པའི་བཀའ་འབུམ་ཡོངས་རྫོགས་གྱི་པར་རྙིང་པ་དེ་ལེགས་རྒྱུ་རང་མི་འདུག་བརྒྱང་པའི་སྟབས་ཀྱིས་བར་གསར་པ་བརྐོ་བའིམཐུན་རྐྱེན་དུ་དངུལ་མང་པོ་ཕུལ།",
    "ལགས་གསུམ་བཞད་ཀྱི་ལྗགས་རྩོམ་ཡང་བེཌྰུར་དཀར་སེར་སྔོན་པ་སོགས་པོ་ཏི་བཅོ་ལྔ་བཅུ་དྲུག་ཙམ་ཡོད་པ་འདུག།",
    "མངའབདག་ཁྲི་རལ་གྱི་དུས་གཏན་ལ་ཕབ་པ་ལས་རྙེད་པར་གྲགས་པའི་དཔེ་གསུམརྒྱན་ཅིག་ཀྱང་འདུགཅིང་།",
    "ཅེས་ཚིས་རྗེ་རིན་ཆེན་རྒྱ་མཚོའི་གསན་ཡིག་ན་གསུངས་འདུག་ཀྱང་བསྡུརན་ཕྱོགས་མི་མཐུན་པ་འདུག་པས་དེའི་ལུང་མེད་པར་ཐག་བཅད།",
    "དེའི་ཕྱིམའི་ཕྱི་མ་ལེའུ་བརྒྱད་པ་རྣམས་འདུག་ཀྱང་ལུང་མ་ཐོབ།",
    "༡ ཤས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་བསྒོ་ཉི་ཤུ་རྩ་ལྔ་པ་ཤེར་ཕྱོགས་ཁྲོད་དུའང་འདུག།",
    "འ་དིའིའོག་ཏུ་ཕྱག་རྡོར་གོས་སྔོན་ཅན་གྱི་རྒྱུད་ལེའུ་བཅུ་གསུམ་པ་ཅིག་འདུག་ཀྱང་ལུང་མ་ཐོབ།",
    "༡ ནོར་རྒྱུནམའི་རྟོགཔ་འདིའི་འོག་ཏུ་ནོར་རྒྱུན་མའི་རྟོག་ཆུང་ཞིག་འདུག་པམ་ཐོབ།",
    "དྲིཆུ་སྦྱིན་པར་གཏོང་བའི་གཟུངས་འདུག་ཀྱང་ལུང་མ་ཐོབ།",
    "དུས་ཀྱི་གསར་ཐོག་ཅེས་བྱ་བ་ནི་འབྲས་བུ་གང་དག་དུས་དང་དུས་སུ་ངེས་པར་གྱུར་པ་དག་ནི་ངེས་པར་གྱུར་པ་དག་སྟེ།",
    "ལྷན་ཅིག་ནི་རྟག་ཏུ་ལྷན་ཅིག་འདུག་པ་ཉིད་དོ།",
    "གང་ལ་དགེ་སློང་དག་ཉལ་ཞིང་འདུག་པའོ།",
    "གང་དག་བཟོད་པ་ཞེས་བྱ་བ་ནི་གང་དག་ལིཙྪ་བཱི་ཆེན་པོ་ལ་ལྷུང་བཟེད་ཁ་སྦུབ་པར་རིགས་པས་སྤོབས་པ་དེ་དག་ནི་ཅང་མི་སྨྲ་བར་འདུག་པར་བྱ་བ་ཡིན་ལ།",
    "གནས་ནི་འདུག་པར་བྱ་བའི་དོན་གྱི་གཞིའོ།",
    "འདི་ལ་འདུག་པའི་ཕྱིར་སྟན་ཡིན་ནོ།",
    "འདུག་ཅིང་ཞེས་བྱ་བ་ནི་བྱེད་བཞིན་དུ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཁམས་དང་རང་བཞིན་མ་འཁྲུལ་པའི་སྒོ་ནས་སོ།",
    "ཚིག་ཐམས་ཅད་ལ་ཡིད་ཆེས་པ་དྲང་པོ་དང་རང་བཞིན་ཅན་ཞེས་བྱ་སྟེ།",
    "གལ་ཏེ་ཡང་གནས་གཞན་ན་གནས་པའི་ཉེ་གནས་ཀྱི་ཕྱིར་ཡང་སྔོན་སློབ་དཔོན་འདུག་པའི་གནས་སུ་ཕྱིན་པར་གྱུར་པས་ཡང་གནས་གཟུང་མི་དགོས་སོ་སྙམ་པ་དེ་ནི་གནས་དེ་ཉིད་དམ་འོན་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གཡས་ཕྱོགས་སུ་ཤཱ་རིའི་བུ་འདུག་པར་གྱུར་ལ།",
    "འདུག་པ་དང་།",
    "འདུག་པ་ཞེས་བྱ་བ་ནི་དགོས་པ་མེད་པར་གྱུར་པར་རོ།",
    "ནང་ན་གནས་པ་ཞེས་བྱ་བ་ལ་གནས་ནི་ཕྱི་རོལ་གྱི་སྐྱེ་བོ་ཆེན་པོ་འདུག་པའི་གནས་ཡིན།",
    "ཁམས་སྣ་ཚོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཁམས་ནི་བསམ་པ་དང་རང་བཞིན་ཞེས་བྱ་བའི་དོན་ཡིན་ལ།",
    "འདུ་ཞིང་འདུག་པའི་ཁྱིམ་གང་ཡིན་པ་དེ་ནི་འདུ་ཁང་ཡིན་ཏེ།",
    "འདུག་པ་ཞེས་བྱ་བ་ནི་འཁོད་པར་གྱུར་པའོ།",
    "དེའི་ཚེ་དེའི་ཆུང་མ་དེ་རྒྱལ་པོ་དང་ལྷན་ཅིག་ཨུག་ཤུད་རྩེ་བ་དེ་ལ་གཞོལ་ནས་འདུག་པའོ།",
    "བྱ་བརྟ་ཀ་ནི་སྲན་མ་ཤ་ལ་སོགས་པའི་ཞིང་ན་ཕལ་ཆེར་འདུག་པ་ལུས་ཤིན་ཏུ་ཆུང་བ་མ་ཡིན་པའི་བྱ་ཡིན་ནོ།",
    "ཡི་རངས་ཤིང་སེམས་མགུ་བ་ལས་རངས་པར་གྱུར་པས་ན་ཡིད་དགའ་ཞིང་རངས་པར་གྱུར་པ་ཡིན་ནོ།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
    "གྲོང་ན་འདུག་པ་ནི་ར་བ་ནི་ནང་ན་འདུག་པ་ཡིན་ནོ།",
    "རྟག་ཏུ་ཡང་ལྷན་ཅིག་གནས་པར་བྱེད་དོ་ཞེས་བྱ་བ་ནི་ལྷ་ལ་སོགས་པ་དང་རྟག་ཏུ་ལྷན་ཅིག་འདུག་པར་བྱེད་ཅེས་བྱ་བའི་བར་དུ་སྟེ།",
    "ཚིག་སྨྲ་བའི་ནུས་པ་མེད་པ་ནི་ཅང་མི་སྨྲ་བར་འདུག་པའོ།",
    "སྟན་ཞེས་བྱ་བ་ནི་ཉེ་བར་འདུག་པའི་དུས་ཀྱིའོ།",
    "འདི་ལ་འདུག་པར་བྱེད་པའི་ཕྱིར་སྟན་ཡིན་ནོ།",
    "མངོན་སུམ་དུ་ཕྱོགས་པས་འདུག་ཤིག་ཅེས་བྱ་བ་ནི་བསྟན་པའི་གནས་ལ་མངོན་སུམ་དུ་ཕྱོགས་པས་འདུག་པར་བྱ་བ་ཡིན་ནོ།",
    "དོ་ཀེར་ནི་སྤྱི་བོའི་དབུས་ན་འདུག་པའི་སྤྱི་བཅིངས་ཏེ།",
    "སུམ་ཅུ་རྩ་གསུམ་ལྷའི་རིས་སུ་གནས་པ་སྟེ་འདུག་པར་འགྱུར་རོ།",
    "འདུག་གོ་ཞེས་བྱ་བ་ནི་རྒྱུན་གྱིས་གནས་པའོ།",
    "སྤྱན་སྔ་ན་འདུག་པར་གྱུར་པ་ཞེས་བྱ་བ་ནི་ཉེ་བ་ན་སྤྱོད་པའོ།",
    "ཁྱིམ་ནི་འདུག་གནས་སོ།",
    "ཁ་ཅིག་ལེན་པ་པོ་མཚམས་ཀྱིས་ན་འདུག་པ་ལ་སྦོམ་པོ་ཁོ་ནར་འགྱུར་བར་བརྗོད་དེ།",
    "འདི་ལྟར་ཁྱེར་བ་པོ་མཚམས་ཀྱི་ནང་དུ་གཏོགས་པའི་ས་ལ་འདུག་པ་ལ་ནི་སྦོམ་པོ་ཁོ་ནའོ་ཞེས་ཟེར་བ་མ་ཡིན་ནམ་དེ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "འདིར་ལྟར་བྲི་བར་བྱ་བའི་གཟུགས་བརྙན་སོ་ན་འདུག་པའི་ཕྱིར་རོ།",
    "ཕོ་ཉ་ཕྱི་རོལ་ན་འདུག་པ་ལ་སྦྱོར་བ་བྱེད་པ་སྟེ།",
    "སྦུབས་སུ་ཕྱིན་པ་ནི་སྔར་འཕགས་པ་བར་སྐབས་སུ་ཁུ་བའི་རྒྱུ་ནས་ཞེས་བྱ་བའི་སྦུབས་ན་འདུག་པ་ཡིན་ནོ།",
    "འདུག་ན་ཞེས་བྱ་བ་ནི་རྩོལ་བའི་ངོ་བོར་འདུག་པར་བྱེད་ནའོ།",
    "ནམ་མཁའ་ལ་མཆིས་པ་ནི་ནམ་མཁའ་ལ་འདུག་པའོ།",
    "གནས་པར་ཞེས་བྱ་བ་ནི་འདུག་པའོ།",
    "འདུག་པར་ནི་འཁོད་པར་རོ།",
    "དེས་ན་མཚམས་གཅད་པ་བྱས་ནས་དཔག་ཚད་ཕྱེད་དང་གསུམ་པའི་མཐར་ཐུག་པའི་མཚམས་ན་དགེ་སློང་དེ་ཡང་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ཡིན་ལ།",
