    "དོན་ལ་ཉེ་བར་བཀོད་པ་ནི་དོན་དང་འབྲེལ་པར་སྣང་བར་བྱས་པ་ལས་གཞན་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དོན་དང་འབྲེལ་པར་མི་སྣང་ན་ནི།",
    "མ་འབྲེལ་པར་སྣང་བའི་ཕྱིར་དང་།",
    "གཟུང་བའི་རྣམ་པར་སྣང་བའི་ཕྱིར་རོ།",
    "མ་འབྲེལ་པར་སྣང་བའི་གཟུང་བའི་རྣམ་པས་མ་འབྲེལ་པའི་དོན་གཞན་རྟོགས་པ་ན།",
    "འཛིན་པའི་རྣམ་པ་ནི་མ་འབྲེལ་པར་སྣང་ཡང་དོན་གཞན་རྟོགས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེས་ན་དོན་གཞན་གྱིས་བསྐྱེད་པར་བྱ་བའི་སྣང་བ་འཇོག་ཀྱང་གཟུང་ཡུལ་མ་ཡིན་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲར་སྣང་བ་ནི་དོན་དུ་སྣང་བ་དང་འབྲེལ་པར་སྣང་བས་སྒྲས་དབེན་པའི་དོན་དེ་ནི་སྒྲ་དང་འབྲེལ་པའི་སྣང་བའི་ཡང་གཟུང་ཡུལ་དུ་འགལ་ཏེ།",
    "དེའི་སྟོབས་ཀྱིས་ཞེས་བྱ་བ་གཟུང་བའི་དོན་དེ་ལས་སྐྱེས་པ་ཡང་དོན་གཞན་གྱི་རྣམ་པ་དང་འབྲེལ་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "ལྔ་པ་རྣམ་པར་རྟོག་པ་སྲིད་པའི་ཡུལ་སྟོན་པ་ནི་རྣམ་པར་རྟོག་པ་ཅན་ནི་ཞེས་བྱ་བའོ།",
    "ངེས་པར་བྱེད་པ་དང་།",
    "ངེས་པར་བྱེད་པའི་རྒྱུ་གསུམ་དང་།",
    "ངོ་བོ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟེ་ཞེས་བྱ་བའོ།",
    "མཚན་ཉིད་ནི་རྣམ་པར་རྟོག་པ་ཅན་ཞེས་བྱ་བ་སྟེ།",
    "དེ་དག་འདྲེས་པར་སྣང་དུ་རུང་བ་ཅན་ནོ།",
    "པར་ཞེས་བྱ་བ་སྟེ།",
    "འདི་ནི་ངེས་བྱེད་ཀྱི་རྒྱུ་གསུམ་གྱིས་དང་པོར་མ་ངེས་པར་འཛིན་པའི་ཤེས་བྱེད་ཀྱི་རྒྱུའོ།",
    "རྣམ་པར་རྟོག་པའི་བག་ཆགས་ཀྱིས་ཀུན་ནས་བསླངས་པ་ལས་ཞེས་བྱ་བ་སྟེ།",
    "མ་ངེས་པར་འཛིན་པ་སྐྱེ་བའི་རྒྱུའོ།",
    "རྒྱུ་གཉིས་ལས་སྣང་བ་མ་ངེས་པར་འགྱུར་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "འགའ་ཞིག་དང་འབྲེལ་པ་ལས་ལྷན་ཅིག་གམ་སོ་སོར་འཛིན་པར་བྱེད་དོ་ཞེས་བྱ་བའོ།",
    "འདིས་ནི་སྣང་བའི་ནུས་པ་ངེས་པ་མེད་ཀྱང་སྣང་བ་ཉིད་ནི་མྱོང་བའི་ཁྱད་པར་ལས་ངེས་པ་ཡིན་ནོ།",
    "ཡང་དག་སྐྱེ་བ་ཡིན་ཕྱིར་རོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱི་དོན་ཁོ་ན་ཞེས་བྱ་བའི་ངེས་པར་གཟུང་བ་ཁོ་ན་ཡོད་པར་འཕངས་པ་སྒྲས་མ་བསྐྱེད་པའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་སྒྲའི་སྣང་བ་སྤྱིར་སྒྲས་བསྐྱེད་པར་བྱ་བ་མ་ཡིན་ན།",
    "གལ་ཏེ་སྒྲའི་སྣང་བ་ཡང་དེས་བྱེད་ན་ནི་སྒྲ་བསྐྱེད་པར་བྱ་བ་ལས་ཐ་དད་བྱེད་པ་མ་ཡིན་པས་འགལ་བས་ཁྱབ་པ་དམིགས་པའོ།",
    "འདི་དོན་དམ་པར་ན་དགག་པར་བྱ་བ་སྒྲའི་སྣང་བ་གཏོད་པ་ལ་ནི་ཐ་དད་པར་བྱེད་པ་མ་ཡིན་པས་ཁྱབ་ལ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྐྱེད་བྱེད་མ་ཡིན་པའི་སྣང་བ་དང་ལྡན་པ་མ་ཡིན་ཏེ།",
    "སྐྱེད་བྱེད་གཞན་གྱིས་འབྲས་བུ་ལས་ཐ་དད་པར་མི་འགྱུར་ལ།",
    "དེ་ལྟར་ན་ཡང་བསྐྱེད་བྱ་སྐྱེད་བྱེད་འཇིག་པར་འགྱུར་རོ།",
    "དེ་དང་འགལ་བ་ནི་དེས་མ་བྱས་པ་དང་།",
    "མདུན་གྱི་བུམ་པ་ལ་མི་སླུ་བའི་ཤེས་པ་ལ་ནམ་ཀའི་རབ་རིབ་ཀྱིས་རྣམ་པར་སྣང་བས་སོ།",
    "མི་ཐ་དད་པར་ཡོད་པས་བསྐྱེད་པ་ཅིས་འགོག།",
    "དེ་མ་བཀག་པར་ནི་མིང་ལས་མ་སྐྱེས་པ་མི་འགྲུབ་བོ།",
    "དམ་བཅས་པ་དང་རྟགས་ཕན་ཚུན་བརྟེན་པར་འགྱུར་རོ།",
    "མ་འཁྲུལ་པའི་སྣང་བ་ཞེས་ཁྱད་པར་དུ་བྱས་ན་དངོས་ཀྱི་འབྲས་བུ་ལ་མི་འཁྲུལ་ལོ་ཞེ་ན།",
    "དོན་གྱི་འབྲས་བུར་མ་གྲུབ་ན་མ་འཁྲུལ་པར་མི་འགྲུབ་བོ།",
    "ད་ནི་མི་མཐུན་ཕྱོགས་མིང་དང་འབྲེལ་པར་སྣང་བ་ལ་གཟུང་ཡུལ་གྱི་དོན་གྱི་ནུས་པ་ལྟོས་པ་མེད་པས་ཁྱབ་པར་སྟོན་པ་ནི།",
    "དང་པོ་ནི་རྣམ་པ་བཞིས་ཤེས་པར་བྱ་སྟེ།",
    "བརྡ་དྲན་པ་དོན་གྱི་ཕན་འདོགས་པས་བྱས་པ་དང་།",
    "དེ་ཡང་དོན་དེ་ཉིད་ཀྱི་ཕན་འདོགས་པས་བྱས་པ་དང་།",
    "དེ་ཉིད་ཀྱི་ཕན་པས་བྱས་པའི་དྲན་པ་དེ་བར་ཆད་དུ་གྲུབ་པའོ།",
    "འདིས་ནི་དྲན་པ་ལ་ལྟོས་ཀྱང་དྲན་པ་དང་དོན་ལྷན་ཅིག་ཏུ་བྱེད་པར་རྟོགས་པ་སྤངས་སོ།",
    "གསུམ་པ་ནི་དེ་དེས་མ་བྱས་ན་ཞེས་བྱ་བ་ནས་ཕྱིར་རོའི་བར་རོ།",
    "ཉེར་སྦྱོར་ཏེ་འབྲས་བུ་སྐྱེད་པ་ལ་ནུས་པ་འཇུག་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་ཏེ།",
    "ནུས་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་བཞིན་གྱི་ཁྱད་པར་མ་དམིགས་པའི་མངོན་སུམ་མམ།",
    "དོན་འདི་ཉིད་འགྲེལ་པར་གསལ་བར་བྱེད་པ་ནི།",
    "དོན་འདི་ཏི་ཀ་ནས་རྣམ་པར་བཞིས་སྟོན་ཏེ།",
    "དང་པོ་ནི་རྗེས་སུ་འགྲོ་བ་དང་ཞེས་བྱ་བ་ནས་ཁྱད་པར་མེད་པ་ཡིན་ནོའི་བར་རོ།",
    "འདིར་རྣམ་པར་རྟོག་པ་གཉིས་ཏེ།",
    "འབྲས་བུ་ལ་ཉེ་བར་སྦྱོར་བར་མཐོང་བའི་ཁྱད་པར་དང་ལྡན་པ་ཁོ་ན་ལ་ནུས་པ་གནས་སམ།",
    "རང་བཞིན་གྱི་ཁྱད་པར་ལ་གནས་པའི་ནུས་པ་དེ་དང་རྒྱུ་གཅིག་པར་སྒྲུབ་བོ།",
    "རང་བཞིན་གྱི་ཁྱད་པར་གྱི་རྒྱུ་བརྒྱུད་པ་གཞན་ནུས་པའི་ཡང་རྒྱུར་སྒྲུབ་པའོ།",
    "ནུས་པའི་རྒྱུ་ལ་རང་བཞིན་གྱི་ཁྱད་པར་མེད་པ་དང་།",
    "འཇུག་བསྡུ་བ་ནི་དེ་ཕྱིར་ནས་ཐ་དད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་རོའི་བར་རོ།",
    "རང་བཞིན་གྱི་ཁྱད་པར་གྱི་རྒྱུ་བརྒྱུད་པ་གཞན་ནུས་པའི་ཡང་རྒྱུར་སྒྲུབ་པ་ནི་རྣམ་པ་ལྔས་སྟོན་ཏེ།",
    "མ་མཐོང་བ་རྒྱུར་བརྟག་པར་མི་ནུས་པ་དང་།",
    "གལ་ཏེ་སྔ་མ་དང་ཕྱི་མའི་སྐད་ཅིག་རྣམས་སུ་རང་བཞིན་གྱི་ཁྱད་པར་འདྲའང་ནུས་པ་མི་འདྲ་ན།",
    "རྒྱུ་གཅིག་པར་ཡང་འགྲུབ་སྟེ།",
    "རྒྱུ་གཅིག་པར་ཇི་ལྟར་གྲུབ་ཅེ་ན།",
    "རང་བཞིན་གྱི་ཁྱད་པར་ཅན་ཉིད་ལ་གནས་ན་ཡང་དེའི་རྒྱུ་གང་ཡིན།",
    "སྐད་ཅིག་ཐ་དད་པས་ནུས་པའི་རྣམ་པར་དབྱེ་བར་འགྱུར་བས་ལྡོག་པ་ལ་ཐེ་ཚོམ་ཟ་བའི་མ་ངེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཁྱད་པར་ལས་ཡིན་ཏེ།",
    "ཚོགས་པ་ལས་བྱུང་བའི་ནུས་པ་ཐ་དད་པར་གྲུབ་ལ།",
    "འབྲས་བུ་ཉེ་བ་དང་མི་ཉེ་བའི་དུས་ཙམ་གྱིས་ཐ་དད་པར་ཟད་དེ།",
    "མ་ཆོད་པ་ལ་བལྟོས་ནས་རབ་འབྲིང་ཐ་སྙད་དུ་བྱེད་པར་ཟད་དོ།",
    "ཉེ་བར་མི་གནས་པའི་དོན་འཛིན་པའི་མཚན་ཉིད་ཀྱིས་དཔྱོད་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྒྲ་དོན་ཡང་གལ་ཏེ་དོན་དམ་པར་འབྲེལ་པ་ཡོད་ན།",
    "དོན་དམ་པར་སྒྲ་དང་མ་འབྲེལ་པ་ཉིད་ག་ལས་ཞེ་ན།",
    "རྣམ་པར་འཇོག་པའི་རྒྱུའོ།",
    "དེ་གཉི་ག་མེད་པ་ཡིན་ཡང་མི་རྟག་པ་མེད་པ་ནི་བྱས་པ་མེད་པ་ལ་རྟགས་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་འབྲེལ་པ་མེད་པ་ཉིད་བསྒྲུབ་པ་ལ་བརྡ་མ་མཐོང་བ་ལ་མེད་པ་ཡང་མ་ངེས་པར་འགྱུར་ཏེ།",
    "དོན་དམ་པར་སྒྲ་དང་བརྗོད་བྱ་རྗོད་བྱེད་ཀྱི་འབྲེལ་པ་མེད་ཀྱང་དྲན་པའི་བག་ཆགས་སད་པའི་རྒྱུ་ཡིན་པ་ཅི་འགལ་ཏེ།",
    "འདིར་ནི་མ་མཐོང་བཞིན་དུ་ཞེས་བྱ་བས་མཐོང་བ་ལ་མ་ལྟོས་པར་དྲན་པའི་ས་བོན་སད་པའི་རྒྱུ་ཡིན་པ་འགོག་པས་མ་ངེས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བརྡ་གོམས་པར་བྱས་པ་ཁོ་ན་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "བརྡའི་རྒྱུ་ལས་དོན་ཉིད་སད་བྱེད་ཀྱི་ནུས་པ་དང་ལྡན་པར་བསྐྱེད་པས་ན་འབྲེལ་པ་ནི་གོམས་ལས་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "འོ་ན་རྣམ་པར་རྟོག་པའི་གསལ་བར་ཚོར་བ་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "ཡང་རྣམ་པར་རྟོག་པ་ཇི་ལྟ་བ་བཞིན་ཡིན་ལ།",
    "འདོད་པ་ཙམ་ལས་ངོ་བོ་མི་འགྲུབ་པས་གཏན་ཚིགས་མ་གྲུབ་པར་འགྱུར་རོ།",
    "བག་ཆགས་ནི་ཁྱད་པར་གྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་ལ།",
    "རྣམ་པར་རྟོག་པའི་ཁྱད་པར་ནི་འདོད་པ་ལས་བཟློག་པར་མི་ནུས་ཏེ།",
    "བླུན་པོ་ཉིད་ལྡོག་ཅིང་མཁས་པ་འཇུག་པར་འདོད་ཀྱང་དེ་ལྟར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དང་པོ་ལྟར་ན་རྣམ་པར་རྟོག་པ་བཞི་སྟེ།",
    "ཡོད་པར་རྟོགས་པ་ཙམ་མམ།",
    "རང་ལ་ཡོད་པར་རྟོགས་པ་ཞིག་དངོས་སུ་ཚིམ་པའི་རྒྱུ་ཡིན།",
    "བཞི་པ་ལྟར་ན་བདེ་སྡུག་རིག་པར་བྱེད་པ་དང་།",
    "དེ་འབྲེལ་པར་འཛིན་པ་ན་རང་ཡང་བཟུང་བས་རང་རིག་པར་གྲུབ་བོ།",
    "དམིགས་པ་མ་རྟོགས་པར་ཡུལ་མི་རྟོགས་པའི་ཕྱིར་ན་གཞན་གྱིས་མྱོང་བའི་བདེ་བ་བཞིན་ནོ་ཞེས་བྱ་བ་སྟེ་སླའོ།",
    "སྒྲས་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པ་ནི་དང་པོ་བཀག་པས་འདི་ལྟར་གྲུབ་བོ།",
    "འདིའང་འགྲེལ་པར་སྟོན་པར་འགྱུར་རོ།",
    "འདི་ཉིད་འགྲེལ་པར་དོན་གསུམ་གྱིས་སྟོན་རྩ་བའི་དོན་ཙམ་གཞག་པས་གཏན་ཚིགས་དགོད་པ་དང་།",
    "སྔ་མ་ལྟར་མངོན་སུམ་གྱི་ཡུལ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པར་དམ་བཅའ་བའི་དོན་དུ་བྱེད་པའོ།",
    "མ་གྲུབ་པ་སྤོང་བའི་ཁྱད་པར་འགོད་པ་ནི།",
    "ཕྱི་རོལ་གྱི་བུམ་པ་དེའི་བདག་ཉིད་འཛིན་པ་མ་ཡིན་ཏེ་བསྒྲུབ་པར་བྱ་བ་ཕྱི་རོལ་གྱི་བུམ་པ་ཡོད་པ་དང་མེད་པའི་རྗེས་སུ་མི་བྱེད་པའི་ཕྱིར།",
    "མེད་པའི་དོན་སྣང་བ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྒྲ་ཙམ་ལ་རག་ལས་པར་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྩ་བའི་གཏན་ཚིགས་དེའི་ཁྱབ་པ་བསྒྲུབ་པ་ནི་རྣམ་པར་གཏོད་པར་ནུས་པའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "ཁྱབ་པ་འདི་ཉིད་བསྒྲུབ་པའི་དོན་དུ་ཡུལ་གྱི་མཚན་ཉིད་ནི་རྒྱུའི་ཁྱད་པར་ཉིད་ཡིན་པར་སྟོན་པ་ནི།",
    "རྣམ་པར་གཏོད་པའི་ནུས་པའི་ཕྱིར་ཤེས་པའི་ཡུལ་ནི་རྒྱུ་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "ཐ་སྙད་ཀྱི་སྒྲས་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ་བསྒྲུབ་པར་བྱ་བ།",
    "གང་ལ་བརྡ་བྱས་ན་དགོས་པ་ཡོད་པ་དེ་ནི་དུས་གཞན་དུ་རྗེས་སུ་འགྲོ་བས་ཁྱབ་སྟེ།",
    "ཐ་སྙད་ཀྱི་སྒྲས་བརྗོད་པར་བྱ་བ་ལ་དེའི་འབྲས་བུ་རྟོགས་པའི་ཡུལ་གྱིས་ཁྱབ་ལ་སྒྲ་ལས་བྱུང་བའི་རྟོགས་པས་ཡུལ་དུ་བྱས་པ་ལ་དུས་གཞན་དུ་སྒྲ་དང་འབྲེལ་པར་གྲུབ་པ་ཡང་དུས་གཞན་དུ་རྗེས་སུ་འགྲོ་བ་ཡིན་ཏེ།",
    "དེས་ན་སྒྲས་བརྗོད་པར་བྱ་བ་ལ་དུས་གཞན་དུ་རྗེས་སུ་འགྲོ་བས་ཁྱབ་པ་གྲུབ་བོ་ཞེས་སྟོན་པ་ནི་སྒྲས་སྦྱར་བ་ཡང་ཞེས་བྱ་བ་སྟེ་ཐ་སྙད་ཀྱི་སྒྲས་སྦྱར་བའོ།",
    "པར་ཡོད་པ་མ་ཡིན་པས་སོ།",
    "དེའི་ཁྱབ་བྱེད་ངེས་པ་གདོན་མི་ཟ་བར་བཟློག་པར་བྱ་བའི་བློའི་ཡུལ་དང་ནི་དེ་བརྒྱུད་ནས་འགལ་བ་ཡིན་ནོ།",
    "འགལ་བའི་དོན་ངེས་པར་བྱེད་པ་དང་།",
    "ཐ་སྙད་ངེས་པར་བྱེད་པའོ།",
    "དངོས་པོ་མེད་པ་དང་དངོས་པོ་གཞན་ཡིན་པར་སྒྲོ་འདོགས་འགོག་པའི་ཕྱིར་དེ་གཉིས་ཀྱིས་དོན་མེད་པའི་ཕྱིར་རོ།",
    "དེ་མཐོང་བ་ན་དེ་ཡོད་པར་ངེས་པ་ཁོ་ནས་དེ་མེད་པར་དོགས་པ་བཀག་པ་ནི་དེ་མེད་པར་ངེས་པའི་འབྲས་བུ་བྱེད་པས་དོན་གྱིས་དངོས་པོ་མེད་པ་མེད་པར་རྟོགས་པ་ཡིན་ནོ།",
    "གཞན་མི་དམིགས་པར་ངེས་པ་ཉིད་ཀྱིས་ཀྱང་གཞན་ཡོད་པར་དོགས་པ་བཀག་པས་མེད་པར་ངེས་པའི་འབྲས་བུ་བྱེད་པས་དོན་གྱིས་དངོས་པོ་གཞན་མེད་པར་ངེས་པ་ཡིན་ནོ།",
    "དངོས་མེད་དང་དངོས་པོ་གཞན་རྣམ་པར་གཅོད་པ་དང་།",
    "ཡུལ་དང་དུས་ཐ་དད་པ་དང་འབྲེལ་པའི་ཁྱད་པར་དག་ནི་ཕན་ཚུན་རྗེས་སུ་མི་འགྲོ་སྟེ།",
    "ནུས་པ་ཐ་དད་པ་གཏན་ཚིགས་སུ་བྱེད་པ་ཅི་ལྟར་འཐད་དེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ནུས་པ་ལ་མ་ལྟོས་པར་དམིགས་པར་བྱ་བ་ཡིན་པ་དང་མ་ཡིན་པ་འགལ་བས་སོ།",
    "གཞན་དུ་ནུས་པ་ཐ་དད་པ་འབྲས་བུ་ཐ་དད་པས་ངེས་ན་འབྲས་བུ་ཡང་ནུས་པ་ཐ་དད་པར་གཞན་ལས་ཡིན་པས་ན་ཐུག་པ་མེད་དོ།",
    "ཐ་དད་པར་དམིགས་པས་སོ་ཞེ་ན།",
    "དཔག་གཞན་གྱི་ཡུལ་ལས་རང་བཞིན་ཁྱད་པར་ཅན་དུ་མ་གྲུབ་པ་ནི་ཐ་དད་པར་མི་འགྲུབ་བོ།",
    "གཅིག་དང་དུ་མའི་ཐ་སྙད་འཇིག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལན་དུ་ཐ་དད་པར་མ་རྟོགས་པས་ཞེས་བྱའོ།",
    "ཐ་དད་པར་རྟོགས་པར་ཁས་བླངས་ཀྱང་དེའི་ཁྱབ་བྱེད་བཀག་པས་འགྱུར་བས་སོ།",
    "ཐམས་ཅད་ལ་ཐམས་ཅད་ཀྱི་ཐ་སྙད་དུ་བྱས་ན་བདེན་པར་མི་འགྱུར་བས་སོ།",
    "འདིར་ནི་གལ་ཏེ་གཅིག་ཏུ་སྣང་བ་ལ་དུ་མར་དོགས་ན་གང་དུ་ཡང་གཅིག་མི་ངེས་པར་དེ་ལས་བཟློག་པའི་དུ་མ་ཡང་ངེས་པར་མི་འགྱུར་རོ།",
    "འདི་ནི་མི་འཐད་དེ་ཐ་དད་པར་རྟོགས་པ་ལ་གཅིག་རྟོགས་པས་ཁྱབ་ན།",
    "དང་པོ་ནི་བུམ་པ་གཅིག་རྟོགས་པར་བྱ་བ་ན་དེའི་བཟློག་ཕྱོགས་བུམ་པ་མ་ཡིན་པ་གསལ་བ་མཐའ་ཡས་པས་དེ་སྙེད་རྟོགས་པ་ག་ལ་ནུས།",
