    "བཙུན་མོའི་འཁོར་དགྱེས་རོལ་པ་༥དང་།",
    "བཙའ་བའི་དུས་ལ་བབ་པ་ན་ལྷ་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ལུམྦི་ནིའི་ཚལ་ལེགས་པར་བརྒྱན་པའི་ནང་དུ་གཤེགས་པ་ལ།",
    "ཕྱོགས་དྲུག་ཏུ་གོམ་པ་བདུན་བདུན་བོར་བ་ལས་པད་མ་འདབ་མ་སྟོང་དང་ལྡན་པ་ཤིང་རྟའི་འཕང་ལོ་ཙམ་རེ་རེ་ཡང་བྱུང་ཞིང་ང་ནི་འཇིག་རྟེན་ན་མཆོག་གོ་ཞེས་པ་ལ་སོགས་པས་སེང་གེའི་སྒྲ་བསྒྲགས་པར་ཡང་མཛད་དེ་མངོན་ཤེས་དང་ལྡན་པའི་བྲམ་ཟེས་མཚན་བཟང་པོར་ཡང་ལུང་བསྟན་པ་ལྟ་བུ་ལྷུམས་ནས་བལྟམས་པའི་མཛད་པ་༣དང་།",
    "དེ་ནས་དགུང་ལོ་བཅོ་ལྔ་ལོན་པ་ན་རྒྱལ་པོའི་གདུང་རྒྱུན་མི་གཅད་པའི་དོན་དུ་ཡོན་ཏན་ཁྱད་པར་ཅན་དང་ལྡན་པའི་བཙུན་མོ་རྣམས་བཞེས་པར་གསོལ་བ་བཏབ་པ་དང་།",
    "དེ་དག་གི་ཕ་ཤཱཀྱ་ལག་ན་བེ་ཅོན་ལ་སོགས་པས་ཀྱང་སྒྱུ་རྩལ་མཁས་པ་དེ་ལ་སྦྱིན་པར་བྱའོ་ཞེས་སྨྲས་པ་ལྷས་སྦྱིན་ལ་སོགས་པའི་སྐྱེ་བོ་མང་པོས་ཐོས་ནས།",
    "ས་འཚོ་མ་དང་གྲགས་འཛིན་མ་དང་ལེགས་སྐྱེས་མ་དང་རི་དྭགས་འཛིན་མ་རྣམས་འཁོར་ཉི་ཁྲི་ཉི་ཁྲི་དང་བཅས་པ་ཁབ་ཏུ་བཞེས་པའི་ཚུལ་བསྟན་པ་ལྟ་བུ་བཙུན་མོའི་འཁོར་དང་དགྱེས་པར་རོལ་པའི་མཛད་༥པ་དང་།",
    "ཏིང་ངེ་འཛིན་ལས་བཞེངས་པ་དང་ལྷ་རྣམས་ཀྱིས་བསྐུལ་ནས་ཞིང་བའི་བུ་མོ་ལེགས་སྐྱེས་མ་ལ་སོགས་པས་འབྲས་ཆན་དང་འོ་ཐུག་དྲངས་པ་གསོལ་བས་སྐུ་གསེར་གྱི་གཏན་པ་ཕྱིས་པ་ལྟར་གྱུར་པ་ལྟ་བུ་དཀའ་བ་སྤྱད་པའི་མཛད་པ་༧དང་།",
    "འོད་ཀྱི་རྩེ་མོ་ལས་བདུད་ཟིལ་གྱིས་གནོན་པའི་སྒྲ་ཆེན་པོ་བྱུང་བས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་སྣང་བ་ཆེན་པོ་དང་བཅས་པས་ཁྱབ་པར་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "དེ་ཡི་བྱམས་པའི་མཐུ་ལས་གནོད་པ་མེད་ཅིང་མེ་ཏོག་གི་ཆར་འབབ་ཞིག་ཏུ་གྱུར་ནས་ལྡིང་ཞིང་འབབ་པར་གྱུར་བས་ཞེ་སྡང་གི་རྣམ་འགྱུར་གྱིས་ཀྱང་བརྫི་བར་མ་ནུས་ལ།",
    "ས་གཡོ་བ་ལ་སོགས་པའི་ཆོ་འཕྲུལ་བསམ་གྱིས་མི་ཁྱབ་པ་དང་བཅས་པས་བུད་ཤིང་ཟད་པའི་མེ་བཞིན་དུ་གཟུགས་ཀྱི་སྐུ་མྱ་ངན་ལས་འདའ་བའི་ཚུལ་བསྟན་པ་དང་།",
    "གསུམ་པ་དེ་དག་གི་འཇོག་ཚུལ་ནི།",
    "སྐུ་གསུམ་དག་གིས་རང་བཞིན་གྱི།",
    "གཉིས་པ་ཡེ་ཤེས་ལའང་གསུམ་ལས་དང་པོ་ཐུན་མོང་གི་དབྱེ་བ་ནི།",
    "རང་གི་འོད་ནི་སྟོན་པ་ལྟར།",
    "གཅིག་ནི་སྲུང་བས་ཉོན་མོངས་ལ།",
    "དེ་ཡི་སྡུག་བསྔལ་རྟག་ཏུ་མེ་མཚོན་རྒྱ་ཚྭ་ལ་སོགས་རེག་སྐྱེས་བཞིན།",
    "ཕྱི་རོལ་པ་དང་ཐུན་མོང་མ་ཡིན་པ་སྟོན་པས་མ་འདྲེས་བ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤོངས་བར་བྱེད་པས་ཡོངས་སུ་རྫོགས་པ།",
    "གཞན་དང་ཐུན་མོང་མ་ཡིན་སྟོན་པ་དང་།",
    "ཁམས་གསུམ་ཉོན་མོངས་རྣམ་སྤོང་རྫོགས་བྱེད་དང་།",
    "གང་གིས་འཆད་ཉན་བྱེད་པའི་གང་ཟག་ཇི་ལྟར་འཆད་ཉན་བྱེད་ཚུལ་བསྟན་པ།",
    "བྱེད་ལས་ཁམས་གསུམ་པའི་ཉོན་མོངས་པ་སྤོང་པར་བྱེད་པ་དང་།",
    "ཁམས་གསུམ་ཀུན་ནས་ཉོན་མོངས་སྤོང་བྱེད་གསུང་།",
    "གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའ་ཞིག་གི།",
    "ཅེས་གསུངས་པའི་ཕྱི་མ་རེ་རེ་བླང་བྱ་ཡིན་པ་ལྟ་བུ་དང་།",
    "བྱེད་ལས་ཀྱིས་ཕྱེ་ན་རྒྱ་ཆེན་པོ་སྡུད་པར་བྱེད་པ་དང་ཟབ་མོ་རྣམ་པར་འབྱེད་པར་བྱེད་པའི་བསྟན་བཅོས་ལ་སོགས་པ་དང་།",
    "ཡོན་ཏན་ལྷག་པ་བརྩོན་བཅས་ལུང་གིས་ཕྱུག།",
    "སེམས་དཔའ་མཆོག་གི་སྟོན་པ་ནི།",
    "དྲུག་ཚན་དྲུག་གིས་ཇི་བཞིན་བཤད།",
    "སྟོང་ཆེན་འཇིག་རྟེན་ཁམས་འདི་གསེར་དག་གིས།",
    "སྐྱེ་བོ་རྨོངས་པར་རང་གི་བདེ་དོན་བརྩོན།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་གདུལ།",
    "རབ་བྱུང་༥བདེན་གཟིགས་༦རྫུ་འཕྲུལ་བསྟན་༧།",
    "ཁྱོད་དང་ང་གཉིས་སྟན་གཅིག་ལ་འདུག་པ།",
    "རང་གི་ཡུམ་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྤྲུལ་པས་ཆུ་དྲོན་མོའི་ཁྲུས་བྱེད་དུ་བཅུག་པ་ན་དེའི་དྲོད་མི་བཟོད་པ་གཟིགས་ནས།",
    "ཕྱི་མ་ངན་སོང་དུ་འདི་བས་ཆེས་དྲག་པའི་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་རོ།",
    "བྷང་གའི་ནགས་མཐར་སླེབས་པ་དང་སྤྲུལ་བའི་བུ་མོ་ཞིག་དང་ཕྲད་པ་རྟ་འཛིན་དུ་བཅུག་སྟེ་ངལ་བས་ཆུ་འཐུང་བར་བརྩམས་པ་ན།",
    "དེ་ནི་དུག་གི་ཆུ་ཡིན་པས་མ་འཐུང་ཞིག་ཟེར་ནས་བདུད་རྩིའི་ཆུས་ཚིམ་པར་བྱས་པ་ལ་ཁྱེད་གང་ནས་འོངས་ཞེས་དྲིས་པས།",
    "དེས་ཀྱང་སྐལ་བ་དང་འཚམ་པར་གདམས་ངག་གནང་ཞིང་ལོ་བཅུ་གཉིས་ཀྱི་བར་དུ་ཏིང་ངེ་འཛིན་ཟབ་མོ་རྩེ་གཅིག་ཏུ་བསྒྲུབས་པས་འཇམ་པའི་དབྱངས་ཀྱང་མངོན་སུམ་དུ་གཟིགས་ཏེ་གྲུབ་པ་བརྙེས་པར་༢གྱུར་ཏོ།",
    "ཕྲག་དོག་ཅན་གཞན་དག་གིས་མ་བཟོད་པར་འདི་ལ་ནི་མཚོན་ཆ་ཡང་ཤིང་གི་རལ་གྲི་ལས་མེད་པའི་ཕྱིར་རྒྱལ་པོའི་སྐུ་སྲུང་མི་ནུས་པས་བརྟག་པར་འཚལ་ལོ་ཞེས་ཞུས་པ་དང་།",
    "ཐམས་ཅད་ཀྱི་མཚོན་ཆ་རིམ་གྱིས་བལྟས་པ་ན་བདག་གི་རལ་གྲི་བལྟ་བར་མི་བཟོད་ཅེས་གསུངས་ཀྱང་ཡང་ཡང་ནན་གྱིས་གསོལ་བ་བཏབ་པས།",
