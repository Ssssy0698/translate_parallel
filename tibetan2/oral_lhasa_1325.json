    "དེ་ཕྱིར་འདོད་པའི་སྦྱིན་པ་དེས་པར་ཁྱད་པར་འཕགས།",
    "ཆད་རྣམས་ངེས་པར་ཤེས་རབ་རང་བཞིན་ཡིན་པས་ན།",
    "ཤེས་རབ་རྣམ་པར་དམན་པས་འདིར་ནིབཏུང་མི་བྱ།",
    "རྟག་པར་སླེབ་མ་རྣམས་ཀྱིས་སྤྱི་བོས་དེ་ལ་འདུད།",
    "ཕྱག་རྒྱ་དེ་རྣམས་ཀུན་ནི་མང་དུ་བསྟེན་པར་བྱ།",
    "ལྷག་པར་མཆོ་ད་ཅིང་སྤྱི་བོ་ཡིས་ནི་ཕྱག་བྱ་ཞིང་།",
    "བླ་ན་མེད་པའི་རྒྱུད་ལས་དེར་བར་མ་གསུངས་སོ།",
    "འོན་ཏེ་མ་ཟོས་ན་༢ནི་གྲགས་པརམི་འགྱུར་རོ།",
    "གཉིད་ལོག་པ་དང་སངས་པ་དུག་ནི་མི་ཤེས་པར།",
    "མེ་དང་དངུལ་ཆུ་དག་ནི་རྟག་པར་དགྲ་ཞིད་དོ།",
    "ནོར་གྱིས་རྣམ་པར་དམན་པས་ཡུལ་གྱི་ལོངས་སྤྱོད་མེད་ ལོངས་སྤྱོད་མ་གཏེགས་སྡུག་བསྔལ་རྒྱུན་མི་འཆད་པ་རུ།",
    "བདེ་བམ་གཏོགས་འགྲོ་དྲུག་སྡུག་བསྔལ་མི་བཟད་པར།",
    "འདོད་ཆགས་རབ་ཏུ་སྤངས་པས་དེ་ནས་ངེས་པར་ནི།",
    "དཔལ་ལྡན་ཚངས་པར་སྤྱོད་དང་ཏིང་ངེ་འཛིན་དང་ཞི།",
    "རང་རྒྱལ་འདི་ལྟར་རྒྱལ་བའི་ས་ནི་མིན་པར་གསུངས།",
    "བདེ་བ་བཟད་པོ་བཏང་ནས་སྡུག་བསྔལ་ལེན་པར་བྱེད།",
    "བདུད་རྣམས་བཅོམ་ཞིང་རྣམ་པར་རྒྱལ་བའི་ཐུབ་པ་ནི།",
    "ཤེས་རབལ་སོགས་རྒྱུད་ལས་རྒྱལ་བརྣམས་ཀྱིས་གསུངས།",
    "ཁྱད་པར་འཕགས་པའི་ལམ་ལ་རབ་ཏུ་འཇུག་པར་འགྱུར།",
    "གཙོ་བོ་བསྒྲུབ་པར་བྱ་ཕྱིར་དེ་ནི་བཙལ་བར་བྱ།",
    "གཙང་ལ་རྣམ་པར་དབེན་པའི་ས་ཡི་ཕྱོགས་དག་དང་ རྒྱལ་བ་འམ་ནི་ཞི་བའི་བདེ་འབྱུད་གནས་དག་ཏུ།",
    "ཆུ་ལ་སོགས་པ་རྣམས་ཀྱིས་བྱུག་པ་བྱས་ནས་ནི།",
    "ཇི་སྲིད་དེ་མ་བཞེངས་པར་བདེ་བ་སྟེར་བ་མེན།",
    "ཕྱག་རྒྱའི་སེམས་ནི་ཤིན་ཏུ་རྣམ་དག་ཤེས་བྱས་ནས།",
    "དཔལ་ལྡན་སྔགས་པ་རྣམས་ལ་འཆིབ་ཉམས་པར་བྱེད།",
    "མཐའ་ཡས་གཟུགས་ལས་ཤིན་ཏུ་རྣམ་པར་དག་པའྀ་སྐུ།",
    "མི་འགྱུར་ཐིག་ལེ་སྦྱོར་བས་ཡང་དག་ཐོབ་པར་འགྱུར།",
    "རྣམ་པ་ཀུན་ལྡན་ཀུན་ནས་རྣམ་པར་དག་པ་དང་།",
    "ཡོངས་སུ་བརྟགས་ན་རྣམ་པར་མཐུན་པར་མི་འགྱུར་རོ།",
    "ཕ་གཅིག་དག་ལ་ངེས་པར་བུ་ནི་བཞིར་གྱུར་ན།",
    "བུ་དེ་རྣམས་ལ་ངེས་པར་རིགས་ནི་གཅིག་ཡིནནོ།",
    "གལ་ཏི་ཡིན་ན་ཀླ་ཀློའི་སྐྱེ་བོ་འཇུག་པར་འགྱུར།",
    "ཀླ་ཀློ་འཇུག་པར་། གྱུར་ན་རིགས་ནི་ཞྭམས་པས་ཏེ།",
    "གང་ཕྱིར་དྲང་སྲོད་རིགས་ནི་བརྟག་པར་བྱེད་པར་འགྱུར།",
    "བདུ་རྣམ་པར་དག་པའི་ལམ་ནི་སྟེར་བར་མི་འགྱུར་རོ།",
    "དེ་ཕྱིར་དེ་རྣམས་དེ་ལས་སྐྱེས་པར་གྱུརཔའོ་ རྐང་པའི་བར་བརྟེན་པར་བྱེད་པར་གྲགས་པ་ཡིས།",
    "དཀའ་ཐུབ་བྱས་ནས་སླར་ཡང་བྲམ་བྲོ་དེ་ཉིད་དུ།",
    "འགྱུར་དེ་དེ་ཕྱིར་དཀའ་ཐུབ་ཁྱད་པར་ཅན་ཡིན་ནོ།",
    "རངདོན་འདོད་པའི་བྲམ་ཟེས་ནོར་གྱི་དོན་དུ་བྱས།",
    "ཕ་ཡི་ཕ་གང་དེ་ནི་མེས་པོའི་ཡིན་པར་འགྱུར།",
    "ཕ་དེཞིད་ཀྱི་སྔོན་དུ་བསགས་པ་ཉམས་པར་འགྱུར།",
    "འཇིག་རྟེན་བསད་བྱ་ལྟ་རུ་ངེས་པར་འགྲོ་མེད་དེ།",
    "ཥགལ་ཏེ་ཚི་ག་འདི་བདེན་ཡིན་དེ་རྣམས་སྲེག་པར་བྱེད།",
    "མཁའ་འགྲོ་ཡིས་ནི་ཨ་ཤྭཏ་ཟྭ་ལ་བརྟན་པར་བྱེད།",
    "ཡོན་ཏནའཕེལ་བ་ཡུལ་གྱིས་རྒྱས་པར་འགྱུར་བ་ཡིས།",
    "གང་ལ་སྟེང་དང་འོག་རྒྱད་ཏུ་ལྐུག་མ་རྒྱས་པར་འགྱུར།",
    "ཨ་ཤྭད་ཐ་ཤིང་དེ་ལ་ངེས་པར་བརྟེན་པ་ནི།",
    "རྒྱལ་བའི་གསུང་ནི་འདི་ཉིད་རྣམ་པར་དག་པའོ།",
    "གོ་ཏ་མ་ལ་སོགས་ཡུལ་དུ་མ་ཧེའི་ཤ་གཙང་བར།",
    "གལ་ཏེ་རག་བྱེད་འདི་ནི་མཁའ་བཞིན་མ་བྱས་པ།",
    "ཇི་ལྟར་འདི་ནི་ཁ་ལས་འདོན་པར་བྱེད་པ་ཡིན།",
    "གལ་ཏེ་ཐམས་ཅད་ཁྱབ་ན་ཀུན་གྱིས་འདོན་པར་འགྱུར།",
    "བདེ་བའི་དོན་དུ་འབར་བའི་ཐབ་དུ་སྲེག་པར་བྱེད།",
    "དཀའ་ཐུབ་བྱས་ནས་ཚངས་པའི་གནས་སུ་ཞུགས་པར་གྱུར།",
    "སྡུག་བསྔལ་འཕྲོག་བྱེད་ཐན་པའི་གོ་འཕང་ཞུགས་པར་འགྱུར།",
    "གཞས་སྐྱེས་རྣམས་ལ་ཀུན་ནས་ལམ་ནི་ཉམས་པར་འགྱུར།",
    "གལ་ཏེ་དྲག་པ་སྡིག་མེད་འཇིག་རྟེན་གྲགས་པས་ན་ ཅི་ཕྱིར་ཐོད་པ་བོར་ནས་དེ་ནི་དག་པར་འགྱུར།",
    "དྲག་པོ་ཕྱག་དར་འདི་ནི་གཙང་མ་མ་ཡིནལ།",
    "རཱ་མས་ཅི་ཕྱིར་དེ་རུ་སྡུག་བསྔལ་ཐོབ་པར་འགྱུར།",
    "ཀུན་མཁྱེན་ཁྱབ་འཇུག་གལ་ཏེ་འཇག་རྟེན་གྲགས་པ་ན།",
    "རྣམ་པར་ད་དཔྱད་ན་དོན་ཀུན་མེད་པར་གྱུར་པའོ།",
    "མངལ་ནས་སྐྱེས་པས་བྱས་པ་དང་ནི་ལྷན་ཅིག་ཏུ།",
    "ཆོ་ག་བྱས་པའྀ་࿐་སྐུད་པས་གཞན་མར་གྱུར་པ་ནི།",
    "ཁྱབ་འཇུག་དེ་ཞིད་བློ་ཡིས་རབ་ཏུ་འཇུག་པ་། གཞན་ ཤིང་ལས་སྐྱེས་པའི་དབྱུག་པ་འཛིན་པར་བྱེད་བ་ཡི།",
    "ཏིང་ངེ་འཛིན་གྱིས་དམན་པ་ནོར་ན་སོགས་པར་འདོད།",
    "ཏ་ལ་སྟེང་ནས་བཅད་བཞིན་ཟད་པར་འགྱུར་བ་འོ།",
    "སྐྱོ་བ་བདུན་པའི་མི་ནི་ངེས་པར་ཕྱུགས་ཡིན་ཏེ།",
    "རིགས་ཀྱི་ལུང་ལས་ཕུལ་པའི་དྲི་ནི་གཙང་བ་སྟེ།",
    "འཇིགསའར་བྱེད་པ་རྣམས་ལ་བསྟན་པརམི་བྱའོ་ གཞན་ཡང་ཞི་བའི་རྒྱ་རུ་རྣམ་པ་སྣ་ཚོགས་པས།",
    "དགོད་པ་དང་བཅས་རྣལ་འབྱོརའཛིན་པར་བྱེད་པ་སྟེ།",
    "ས་ལུའི་ས་བོན་ཁྱད་པརཅན་དུ་མི་འགྱུར་རོ།",
    "དུག་ལས་བཅུད་ལེན་ཁྱད་པར་ཅན་དུ་འགྱུར་བམེད།",
    "དོཕྱིར་རྣམ་དག་རྣམས་ཀྱིས་རྣམ་པར་དཔྱད་ནས་ནི།",
    "རིགས་ཅན་གཞན་རྣམས་ཞམས་པར་གྱུར་པས་སྟོན་བྱེད་ཅིང་།",
    "འཆི་བར་གྱུར་པ་རྣམས་ཀྱིས་ཞི་གནས་འཇུག་པར་བྱེད།",
    "སྲོག་བཅད་རབ་ཏུ་བྱས་ནས་དེ་ཤིད་ཟ་བྱེད་དེ།",
    "ཨོཾ་ཡིག་ས་བོན་ཞེས་ནི་ངེས་པར་སྐུ་རྡོ་རྗེ།",
    "ཡོ་ན་ཞེས་ནི་རྒྱལ་བརྣམས་ཀྱི་སྒྲོལ་མར་གསུངས།",
    "པྲཙོ་ད་ཡ་ཞེས་ནི་ཕ་རོལ་ཕྱིན་པར་གྲགས།",
    "དེ་དག་སྙོམས་པར་ཞུགས་པ་ཐུན་མཚམས་ཐ་དད་མིན།",
    "རྣམ་པར་ཤེས་པ་སྔོན་དུ་ངེས་པར་རིག་པར་བྱ།",
    "སྔོན་དུ་རབ་ཏུ་དབྱེ་བ་ཡིས་ཀྱང་རིག་པར་བྱ།",
    "བསེད་ནམས་རྒྱ་རུ་ཡང་ནི་ཡང་དག་སྟོན་པར་བྱེད།",
    "ཤེསརབ་ལས་བྱུང་ས་རྣམས་རྣམ་པར་རོལ་པར་བྱེད་པ་ཡི།",
    "དེ་ཡིས་བཀོད་པའི་ཆ་ལ་ཡང་དག་འབད་བྱས་ཏེ།",
    "དེ་གསུངས་པ།",
    "ཐམས་ཅད་ཁྱབ་པར་བྱས་ཏེ་གནས་ཤེས་སོ།"
  ]
