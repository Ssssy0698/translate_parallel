    "དང་པོ་ནི་རང་གི་ངོ་བོ་ཉིད་དེ།",
    "རྣ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་རང་གི་ངོ་བོ་ཉིད་རྗོད་པ་ལྟ་བུ་སྟེ།",
    "མིང་དེ་དག་ཉིད་ཀྱི་ཚོགས་པ་ལ་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "རྣམ་པར་བྱང་བའི་བྱེ་བྲག་གི་དོན་རྗོད་པར་བྱེད་པ་སྟེ།",
    "འདི་ལྟར་ཡི་གེ་དེ་རྗོད་པར་བྱེད་མི་ནུས་ཀྱང་དེ་དག་གི་གནས་བྱེད་དོ།",
    "མིང་ཞེས་བྱ་བའི་དོན་གང་ཞེ་ན་སྣ་ཚོགས་སུ་ཐུན་མོང་དུ་ལེགས་པར་ཤེས་པར་བྱེད་པའི་ཕྱིར་མིང་ཞེས་བྱའོ།",
    "ཡང་དག་གིས་མིང་དུ་འབོད་པའི་ཕྱིར་ཡང་མིང་ཞེས་བྱའོ་ཞེས་འབྱུང་སྟེ།",
    "བསྟན་བཅོས་ཕུང་པོ་ལྔ་པོའི་རབ་ཏུ་བྱེད་པ་ལས་ནི་ཚིག་གི་ཚོགས་གང་ཞེ་ན་འདི་ལྟ་སྟེ།",
    "འདི་ནི་གཙུག་ལག་གི་ཚིག་གོ།",
