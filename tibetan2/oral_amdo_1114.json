    "སྲས་མོ་དེས་སྒེའུ་ཁུང་ནས་ཕྱི་ལ་བལྟས་པའི་སྐབས་དང་ཁེལ་བས།",
    "ལང་ཚོ་དར་ལ་བབ་ཅིང་མིག་གི་བདུད་རྩིར་གྱུར་པའི་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་སྲས་མོ་ཁོང་གི་ཡིད་ཀྱི་བརྟན་པ་ཅིག་ཅར་དུ་འཕྲོགས་པ་ན་མོས་སྐད་གསང་མཐོན་པོའི་སྒོ་ནས་སྨྲས་པ།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་སྲས་མོ་ཁོང་གི་སྐད་ཆ་དེ་ཐོས་པས་འདི་ལྟར།",
    "ཡབ་རྒྱལ་པོ་ཟས་གཙང་མས་དེ་ལྟའི་གོ་སྒྲིག་གནང་དགོས་པའི་དམིགས་ཡུལ་ནི་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ལ་སྲས་ཤིག་འཁྲུངས་ནའང་ད་དུང་ཁོང་གིས་ཐུགས་སེམས་མ་སྐྱིད་པ་གནང་སྟེ།",
    "དེར་བརྟེན་ཡབ་རྒྱལ་པོ་ཟས་གཙང་མས་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་འགོག་ཐབས་ཀྱི་ཆེས་མཐའ་མཇུག་གི་ཐབས་ལམ་སྟེ་སྤྲོ་ཚོགས་འདི་འདྲ་ཞིག་གྲ་སྒྲིག་ཞུས་པ་རེད།",
    "རྒྱལ་སྲས་ནི་རང་གི་ཡབ་ཆེན་གྱི་ཐུགས་བློ་བདེ་ཕྱིར་མཚན་ཚོགས་དེར་ཞུགས་པ་མ་གཏོགས།",
    "དོན་དངོས་སུ་ཁོང་གིས་ན་རྒ་འཆི་བའི་སྡུག་བསྔལ་གྱི་སྐོར་ལ་བསམ་གཞིག་བྱེད་བཞིན་ཡི་མུག་སྟེ་བཞུགས་པའི་མུར་སྐུ་ཐང་ཆད་ནས་གཉིད་དུ་ཤོར།",
    "དེ་ལྟར་རྒྱལ་སྲས་གཉིད་དུ་ཤོར་བ་གཞས་མ་དང་གླུ་མ་དག་གིས་མཐོང་ནས་ཁོང་ཚོས་ཀྱང་ངལ་བསོས་པ་ན་དཀའ་ལས་ཁག་སྟེ་གཉིད་དུ་ཤོར་རོ།",
    "དེའི་མཚན་མོ་སྟེ་དུས་ཡུན་ཅུང་ཙམ་ཕྱིན་རྗེས།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་མནལ་ལས་སད་པ་ན་ཁོང་གིས་གཉིད་དུ་ཡུར་བའི་གཞས་མ་དག་མཐོང་བས།",
    "ཨོ་ངའི་མིག་ལམ་དུ་ཤར་བ་དག་ཅི་ཞིག་རེད།",
    "རྐུབ་སྟེགས་དང་མལ་ཁྲི་སོགས་ཀྱི་སྟེང་ཁྲེལ་དང་ངོ་ཚ་ཡེ་ནས་བྲལ་ཏེ་སྐྱུགས་བྲོ་བའི་གནས་སུ་གྱུར་པ་ནི་ཅི་འདྲའི་མཐོང་མི་འདོད་པ་ཞིག་རེད་ཨང་སྙམ།",
    "ད་དུང་བུ་མོ་ཁ་ཤས་ཀྱིས་ཁ་ཆེན་པོར་གདངས་ཏེ་ཕག་པ་ཇི་བཞིན་རྔུར་བ་འཐེན་པ།",
    "དེ་ནས་ཁོང་གིས་གཞས་མ་དང་གླུ་མ་རྣམས་ཀྱི་གཉིད་མ་དཀྲོག་པར་ག་ལེར་བཞུགས་ཁྲི་ལས་ཡར་བཞེངས་ཏེ།",
    "ཁྱོད་ཀྱིས་ཆིབས་རྟ་བསྔགས་ལྡན་ལ་ས་རྒྱོབས་ཤིག་དང་།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་རང་གི་སྲས་སྒྲ་གཅན་འཛིན་ལ་ཆེས་ཐོག་མའི་གཟིགས་སྐོར་དུ་ཕེབས།",
    "སྐབས་དེར་བཙུན་མོ་གྲགས་འཛིན་མགཉིད་དུ་ཡུར་ཞིང་མོའི་ཕུག་གིས་སྲས་ཀྱི་ཞལ་རས་བཀབ་འདུག་སྟབས།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་ཐ་ན་རང་གི་སྲས་ཀྱི་ཞལ་རས་ཡང་མཐོང་མ་ཐུབ།",
    "གལ་སྲིད་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་རང་གི་སྲས་ཀྱི་ཞལ་རས་མཐོང་ཕྱིར་བཙུན་མོ་གྲགས་འཛིན་མའི་ཕུག་ཚུར་བླངས་ན་བཙུན་མོ་གཉིད་ལས་སད་པར་ངེས་ཤིང་།",
    "ད་ལྟ་ངས་སྐུ་སྲས་ཀྱི་ཞལ་རས་མཐོང་ཆེད་བཙུན་མོའི་ཕུག་ཚུར་བླངས་ན་མོ་རང་གཉིད་ལས་སད་པར་ངེས།",
    "དེས་ན་ད་ལན་ངས་རང་གི་སྲས་ཀྱི་ཞལ་རས་མཐོང་མ་ཐུབ་ཀྱང་ངེས་པར་དུ་འགྲོ་ཐུབ་དགོས།",
    "མཚན་དཀྱིལ་ཙམ་ལ་ཁོང་གིས་རྐང་འཇབ་ལག་འཇབ་ཀྱིས་རྟ་མཆོག་དཀར་པོ་བསྔགས་ལྡན་ལ་ཆིབས་ཤིང་།",
    "སྐྱེ་བོ་ཚང་མ་གཉིད་དུ་ཡུར་ཏེ་ཆེས་ཁུ་སིམ་པའི་བཅོལྔའི་མཚན་དཀྱིལ་དེ་ནས་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་སེར་སྐྱའི་གཞི་ལ་ཆེས་མཐའ་མཇུག་གི་སྤྱན་རས་ཀྱིས་ལན་ཅིག་གཟིགས་ཏེ།",
    "ཁོང་གིས་རྟ་མཆོག་བསྔགས་ལྡན་ལ་ཆིབས་ཏེ་བྱོན་མཐར་ཆུ་ཀླུང་ཡིད་འོང་ལྡན་གྱི་འགྲམ་དུ་སླེབས་པ་ན་ཆིབས་ལས་བབ་སྟེ།",
    "ཁྱེད་ཀྱིས་ཅ་དངོས་འདི་དག་ཡབ་རྒྱལ་པོ་ལ་ཕུལ་ཅིག་གསུངས་ཏེ་རལ་གྲི་བཏོན་ནས་རང་ཉིད་ཀྱི་དབུ་སྐྲ་རང་གིས་བཅད་ཅིང་ངུར་སྨྲིག་གི་ན་བཟའ་བཞེས་ཏེ་ཕྱག་ཏུ་ལྷུང་བཟེད་ཐོགས་ནས་སླར་ཡང་འདུན་པ་ལ་སྨྲས་པ།",
    "ཁྱེད་ཡབ་ཡུམ་བཙུན་མོ་དང་བཅས་པས་ང་ལ་ཐུགས་ཁྲལ་གནང་མི་དགོས།",
    "དེ་བཞིན་སྲས་སྒྲ་གཅན་འཛིན་དང་བཅས་འཛམ་གླིང་འདིའི་སྐྱེ་དགུ་ཡོངས་ལ་གསུང་གི་བདུད་རྩི་འབུམ་རྒྱུ་ལགས་ན།",
    "རྒྱལ་སྲས་ཀྱིས་རྟ་མཆོག་ལ་ཕུག་གིས་བྱིལ་བྱིལ་བྱེད་བཞིན་ཐུགས་བརྩེ་བའི་སྒོ་ནས་སྨྲས་པ།",
    "ཐ་མ་དེར་འདུན་པ་དང་རྟ་མཆོག་བསྔགས་ལྡན་གཉིས་ཕྱིར་ལོག་སྟེ་རྒྱལ་སྲས་དང་བར་ཐག་རིང་ཙམ་སླེབས་སྐབས་རྟ་མཆོག་གིས་ཁ་ཕྱི་ལ་འཁོར་ནས་རྒྱལ་སྲས་ལ་ཆེས་ཐ་མའི་རྒྱང་ལྟ་ཞིག་ཀྱང་བྱས།",
    "འུ་ཅག་གི་སྦྱིན་བདག་ནི་རང་རེའི་བདེ་སྐྱིད་ཀྱི་ཆེད་ཕྱོགས་ཐོན་གནང་བ་ཡིན་པས་སེམས་པ་སྐྱོ་སྐྱོ་མ་གནང་།",
    "ཕར་བལྟས་ཚོད་ལ་རྟ་མཆོག་བསྔགས་ལྡན་ནི་ཧ་ཅང་གི་སེམས་པ་སྡུག་ཅིང་མིག་ཀོང་ནས་མཆི་མ་བཞུར་བཞིན།",
    "ཡུད་ཙམ་རིང་རྒྱལ་སྲས་ཀྱི་ཕྱོགས་སུ་མིག་གིས་འབུར་ཚུགས་སུ་བལྟས།",
    "དེ་དུས་ཁོང་ལ་བཞུགས་སའི་གཟིམས་ཁང་མེད་ཅིང་གླེང་མོལ་བྱེད་མཁན་གྱི་གྲོགས་པོའང་མེད་པ་མ་ཟད་ཞལ་དུ་གསོལ་རྒྱུའི་ཟས་ཀྱང་མེད།",
    "དེར་བརྟེན་ཁོང་གིས་སྐྱེ་བོ་གཞན་གྱིས་གང་ཕུལ་བའི་ཟས་ལ་ལོངས་སུ་སྤྱད་ནས་བཞུགས།",
    "གཞན་ཡང་འགའ་ཞིག་གིས་དགེ་སྦྱོང་གོ་ཏ་མ་ཞེས་སོགས་འབོད་པ་ལས།",
    "གང་ལྟར་རྒྱལ་སྲས་ཁོང་ནི་ཧ་ཅང་གི་སྐུ་ཉམས་དོད་ལ་གཞོན་ཤ་ཆགས་པ།",
    "གཙང་སྦྲ་ལྡན་ཞིང་ལང་ཚོ་རྒྱས་པ།",
    "རྒྱལ་སྲས་ཁོང་གིས་དུས་ནམ་ཡིན་ཡང་མི་གཞན་པར་ང་ལ་གསོལ་རས་ཤིག་གནང་རོགས་ཞེས་བསོད་སྙོམས་སློང་གིན་མེད་ན་ཡང་།",
    "ཡུལ་མི་རྣམས་ཀྱིས་ཁོང་གི་ལྷུང་བཟེད་དུ་བསོད་སྙོམས་འབུལ་རྒྱུར་དགའ་སྣང་དང་སྤྲོ་བ་བྱེད་ཀྱི་ཡོད།",
    "ཞི་ཞིང་དུལ་ལ་གུས་བརྩི་དང་ལྡན་པ་ཞིག་ཞེས་པའི་ཚིག་དེ་ཐོས་པ་ཙམ་གྱིས་བསོད་སྙོམས་པ་དེ་ནི་རང་གི་མཆེད་གྲོགས་རྒྱལ་པོ་ཟས་གཙང་མའི་སྲས་ཡིན་པ་ཤེས་སོ།",
    "ཁྱེད་ཀྱིས་དགོས་པ་ཅི་ཞིག་གི་ཕྱིར་འདི་ལྟར་གནང་བ་ཡིན།",
    "ཁྱེད་ཉིད་རང་གི་ཡབ་ཟས་གཙང་མ་དང་ཁ་རྩོད་ཤོར་བ་མ་ལགས་སམ།",
    "དཁྱོད་ཀྱིས་འདི་ལྟར་བྱས་ཏེ་གནས་གང་ཞིགཏུ་ཕེབས་རྩིས་ཡིན།",
    "གང་ལྟར་ཁྱོད་ཀྱིས་དེ་ལྟར་མི་གནང་བར་རྒྱལ་ཕྲན་འདི་རུ་བཞུགས་ཤིག་དང་ངས་ཁྱེད་ལ་རྒྱལ་སྲིད་ཀྱི་ཕྱེད་ཀ་འབུལ་རྒྱུ་ཡིན་གསུངས་པར།",
    "ཁྱོད་ཀྱིས་ང་ལ་དེ་ལྟའི་མཐོང་ཆེན་གནང་བར་ཐུགས་རྗེ་ཆེ་ཞུ།",
    "ཁོ་བོ་ནི་རང་གི་ཡབ་ཡུམ་དང་བུ་ཕྲུག་ཆུང་མ་དང་བཅས་པར་ཧ་ཅང་གི་དགའ་པོ་ཡོད་ལ།",
    "ཁོང་གི་མཆེད་གྲོགཎ་༦ས་ཐོས་པས་ཁོང་རྣམས་ཀྱིས་ཀྱང་རྒྱལ་སྲས་དང་གཅིག་མཚུངས་ཀྱིས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་།",
    "མཆེད་གྲོགས་ལྔའི་ནང་ནས་གཅིག་གི་མིང་ལ་ཀོཎྜི་ནྱ་ཟེར་ཞིང་།",
    "ཁོང་རྣམས་ཀྱིས་ཀྱང་དུར་སྨྲིག་གི་ན་བཟའ་བཞེས་ཏེ་ལག་ཏུ་ལྷུང་བཟེད་ཐོགས་ནས་ཡུལ་ལུང་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་བསོད་སྙོམས་ལ་ཕེབས་སོ།",
    "ཁོང་གིས་གང་གསུངས་ལ་བཀའ་གསུང་ཇི་བཞིན་དང་དམ་ཚིག་མཐུན་པའི་སྒོ་ནས་སྦྱང་བརྩོན་ལྷོད་མེད་གནང་།",
    "སློབ་དཔོན་གྱིས་ཀྱང་ཁོང་ལ་ཧ་ཅང་གི་དགའ་མོས་དང་བྱམས་སྐྱོང་གནང་གི་ཡོད།",
    "ད་ལྟའི་སྐབས་ཁྱོད་ཀྱིརྟོགས་པ་ང་དང་མཉམ་པར་སོན་པས་ངེད་གཉིས་ཀྱི་བར་ལ་ཁྱད་པར་ཏིལ་འབྲུ་ཙམ་ཡང་མེད།",
    "ངས་དེ་འདྲའི་ཐབས་ལམ་ཞིག་གཏན་ནས་ཤེས་ཀྱི་མེད་ན་ངས་ཁྱོད་ལ་ཇི་ལྟར་སྟོན།",
    "མཐའ་གཞུག་ཁོང་རྣམས་ཀྱིས་ལྷག་སྤྱོད་ཟེར་བའི་མཁྱེན་དཔྱོད་ཀྱི་གྲགས་སྙན་རབ་ཏུ་རྒྱས་པའི་རྨད་བྱུང་གི་སློབ་དཔོན་ཞིག་འཚོ་ཞིང་གཞེས་པ་གསན་པས།",
    "གང་ལྟར་དགེ་སྦྱོང་གོ་ཏ་མས་སྔར་བཞིནསློབ་དཔོན་ཁོང་གི་བཀའ་གསུང་ཇི་བཞིན་སྒྲུབ་སྟེ་སྦྱང་བརྩོན་མཐིལ་ཕྱིན་གནང་བས་ཁོང་སློབ་ཚོགས་ཡོངས་ནས་རྩེ་ཕུད་དུ་གྱུར།",
    "གང་ལྟར་སྒྲུང་འབྲས་དེ་ཙམ་ཞིག་གིས་དགེ་སྦྱོང་གོ་ཏ་མའི་ཐུགས་ཡིད་མ་ཚིམས་པར།",
    "ཁོང་མཆེད་གྲོགས་དང་བཅས་པས་སློབ་དཔོན་ལ་གྱེས་མཇལ་ཞུས་ཏེ་ཕྱོགས་ཕེབས་གནང་ཞིང་ཁོང་གི་དགོངས་པར།",
    "གང་འཚམ་སོང་རྗེས་གོ་ཏ་མའི་དགོངས་པར།",
    "ཟས་གཅོད་ཀྱི་དཀའ་ཐུབ་དེ་ནི་བདེན་པ་མཐོང་བའི་ཐབས་ལམ་རྨད་དུ་བྱུང་བ་དེ་རེད་སྙམ་དུ་དགོངས་ནས།",
    "དང་ཐོག་ཁོང་གིས་ཁ་ཟས་ཉུང་ངུ་རེ་བསྟེན་ཅིང་།",
    "དེ་ནས་རིམ་བཞིན་ཟླ་ངོ་མང་པོའི་རིང་ཉིན་རེར་ཟས་ཐུན་གཅིག་རེ་ལས་མ་བཞེས་པར་བཞུགས་ཤིང་།",
    "རིམ་གྱིས་ཉིན་གཉིས་ཀྱི་ནང་ཟས་ཐུན་གཅིག་རེ་དང་།",
    "མཐར་ཉིན་གསུམ་གྱི་ནང་དུ་ཟས་ཐུན་གཅིག་རེ་ལས་མ་བཞེས་བར་སྨྱུང་གནས་ཀྱི་ཉམས་ལེན་གདམས་པའི་མཐིལ་དུ་བཟུང་།",
    "དེ་ཡང་ཁོང་ལ་བཞེས་རྒྱུ་ནི་རྩི་ཤིང་གི་རྩ་བ་དང་ཤིང་གི་ལོ་མ་ལས་མེད་ཅིང་།",
    "བཏུང་བ་ཡང་ཤིང་གི་ལོ་མ་དང་ཤིང་ཏོག་སྣ་ཚོགས་ཀྱི་ཁུ་བ་ལས་གཞན་ན་གཉིས་སུ་མེད་པས།",
    "ཁོང་གི་སྐུ་གཟུགས་ལ་ཟས་བཅུད་ཀྱིས་མ་འདང་བས་ཞབས་གཉིས་ནི་སྡུག་མའི་སྡོང་པོ་ཞིག་དང་མཚུངས་པར་སྐམ་ཞིང་རིད་ལ་སྒལ་ཚིགས་རྣམས་གཞན་ཡང་བྲང་ཁོག་གི་རྩིབ་མ་རྣམས་ནི་ཐོག་ཁེབས་མ་ཀྱང་ཐག་པ་ལྟར་གྱུར།",
    "དེ་དུས་ད་དུང་ཁོང་གི་དགོངས་པར།",
    "ལུས་ཀྱིདཀའ་བ་སྤྱད་པ་ནི་མཐར་ཐུག་ཅིང་བླ་ན་མེད་པའི་བདེ་སྐྱིད་སྐྲུན་བྱེད་ཀྱི་ལམ་བུ་གཅིག་པུ་དེ་རེད་དགོངས་ནས།",
    "ད་དུང་ཁོང་གི་ཐུགས་རྒྱུད་ལ་ཉམས་རྟོགས་ཀྱི་རིགས་གསར་པ་གང་ཡང་འཁྲུངས་མེད།",
    "དུས་ཡུན་རིང་པོའི་བར་དབུགས་ནང་དུ་བསྒོམས་ཏེ་དབུ་དང་སྙན་གྱིས་གཙོས་པའི་སྐུ་གཟུགས་ཡོངས་ལ་ན་ཟུག་གི་དཀའ་ངལ་མ་བྱུང་བར་དབུགས་གཏོང་ལེན་གྱི་ཉམས་ལེན་ལ་གཞོལ་བར་མཛད།",
    "དེ་ལྟར་ཁོང་གིས་གྲོགས་མེད་ཁེར་རྐྱང་དུ་ཉམས་ལེན་གནང་ཞིང་།",
    "ཚེས་ཆེན་བཅོ་ལྔ་དང་གནམ་གང་སོགས་དུས་ཆེན་ཁག་གི་མཚན་མོར་ནགས་ཀླུང་ཁྲོད་དང་།",
    "ཡང་ན་དུར་ཁྲོད་སོགས་མི་མེད་ལུང་སྟོང་གི་དབེན་གནས་སུ་ཕེབས་ཏེ་སྒོམ་གྱི་ཉམས་ལེན་ལ་གཞོལ་བར་མཛད།",
    "སྐབས་དེ་དུས་ཁོང་གིས་དུར་ཁྲོད་དང་ཡང་ན་གད་སྙིགས་སྤུངས་པའི་ཁྲོད་ནས་ནིང་རལ་དང་ཙབ་རལ་དུ་ཕྱིན་པའི་གྱོན་གོས་རྣམས་བསྒྲུགས་ཏེ་མནབས་ཤིང་།",
    "ཚད་པ་ཆེ་བའི་དབྱར་གཞུང་གི་མཚན་དུས་སུ་ཁོང་ཁང་པའི་ནང་ལ་བཞུགས་ཤིང་ཉིན་མོར་འབར་ལ་ཁད་པའི་ཚད་པའི་ཁྲོད་ཁང་པའི་ཕྱི་ལ་བཞུགས།",
    "ད་དུང་གྲང་ངར་ཆེ་བའི་དགུན་ཁའི་མཚན་དུས་སུ་འཁྱགས་པས་བསྡམ་པའི་ཆུ་མོ་ཡི་དཀྱིལ་དུ་རྒྱུན་རིང་བཞུགས་ཏེ་ལུས་ཀྱི་དཀའ་བ་སྤྱད་པས།",
    "ཁོང་གི་ལུས་སེམས་གང་ཐད་ལ་དཀའ་སྡུག་ཇེ་ཆེ་ནས་ཇེ་ཆེར་ཕྱིན།",
    "སྤྱིར་དགེ་སྦྱོང་གོ་ཏ་མ་ཁོང་གིས་དཀའ་སྤྱད་ཀྱི་བརྒྱུད་རིམ་ཁྲོད་དཀའ་སྡུག་དང་ན་ཟུག་སོགས་གང་འདྲ་ཞིག་བྱུང་མིན་ལ་མ་ལྟོས་པར་ལོ་ངོ་ཧྲིལ་པོ་དྲུག་གི་རིང་།",
    "ཁོང་གི་དགོངས་པར།",
    "འདི་ལྟ་བུའི་དཀའ་སྤྱད་སྡུག་རུས་ཁོ་ནའི་ཉམས་ལེན་བྱེད་པ་ནི་ཤེས་རབ་འཚོལ་བའི་ཐམས་ལམ་ཞིག་མ་རེད་དགོངས་སོ།",
    "ར་རྫི་ཞིག་གིས་མཐོང་ནས་ཁོང་ལ་འོ་མ་ཕུལ་བས་སྔར་ལས་ཅུང་དྭངས་བསྐྱེད་དུ་ཕྱིན།",
    "དུས་དེ་ནས་བཟུང་ཁོང་གི་སྐུ་གཟུགས་ཀྱིགནས་བབ་རང་སོར་ཆུད་ཕྱིར་འོ་མ་དང་ཟས་རིགས་སོགས་ཅུང་མང་ཙམ་བཞེས།",
    "སྐབས་དེར་ཁོང་གི་མཆེད་གྲོགས་ལྔ་པོས་དགེ་སྦྱོང་གོ་ཏ་མས་ཟས་བཅད་སྨྱུང་གནས་ཀྱི་ཉམས་ལེན་དོར་བ་མཐོང་བས།",
    "ཁོང་ཚོའི་འདོད་བློ་ཡེ་ནས་མ་ཚིམས་པར་དགེ་སྦྱོང་གོཏ་མ་གཅིག་པུར་བཞག་སྟེ་ཁོང་རྣམས་ཡུལ་ཕྱོགས་གཞན་ཞིག་ཏུ་ཕྱིན་ཏོ།",
    "མོ་རང་གི་བསམ་པར།",
    "རིང་པོར་མ་ཐོགས་པར་མོས་ཕོ་གཞོན་ཞིག་དང་ལྷན་གཉེན་སྒྲིག་བྱས་ཏེ་ཁོང་ཁྱོ་ཤུག་གཉིས་ལ་ཡིད་དུ་འོང་བའི་ཕྲུ་གུ་ཞིག་ཀྱང་སྐྱེས།",
    "དེར་བརྟེན་མོ་རང་ལ་རྨད་དུ་བྱུང་བའི་དགའ་ཚོར་སྐྱེས་ཏེ།",
    "རང་གི་གཡོག་མོ་ཞིག་ཤིང་ནེ་གྲོ་ཏའི་ཉེ་འཁོར་གཙང་སྦྲ་བྱེད་པར་མངགས།",
    "མཛེས་སྡུག་ལང་ཚོའི་མྱུ་གུ་རྒྱས་པའི་གཞོན་ནུ་མ་དེའི་མིང་ལ་ལེགས་སྐྱེས་མ་ཟེར།",
    "དེ་ལྟར་བུ་མོ་ལེགས་སྐྱེས་མས་འོ་ཐུག་བསྐོལ་བཞིན་པའི་སྐབས།",
    "རང་གི་ལས་གཡོག་དགའ་སྤྲོའི་ངང་འཚབ་འཚུབ་ཀྱིས་ཚུར་བརྒྱུགས་ཡོང་བ་མཐོང་བས་མོ་རང་ཡང་ཧང་སངས་པར་གྱུར།",
    "དེ་ནས་ལས་གཡོག་དེས་བུ་མོ་ལེགས་སྐྱེས་མ་ལ་སྨྲས་པ།",
    "བཙུན་མོ་ལགས།",
    "ཉིད་ཀྱིས་ཤིང་ལྷ་ལ་ཞལ་ཟས་ཕུལ་རྒྱུར་ཁོང་གིས་ཞལ་བཞེས་གནང་སྟེ།",
    "ད་ལྟ་ཁོང་མངོན་སུམ་དུ་བྱོན་ནས་བཙུན་མོ་ཉིད་ཀྱི་ཞལ་ཟས་ལ་བསྒུག་སྟེ་ཤིང་ནེ་གྲོ་ཏའི་འོག་སྒོམ་རྒྱག་བཞིན་བཞུགས་འདུག།",
    "བུ་མོ་ལེགས་སྐྱེས་མ་དགའ་མགུ་ཡི་རང་སྟེ་ཁོང་གཉིས་ཀྱིས་དགའ་བའི་བྲོ་གར་འཁྲབ།",
    "བུ་མོ་ལེགས་སྐྱེས་མས་ཉམས་འགྱུར་ལྡན་ཞིང་དང་བ་འདྲེན་པའི་ཤིང་ལྷ་ཁོང་ཤིང་སྣེ་གྲོཏའི་གྲིབ་བསིལ་འོག་བཞུགས་ཏེ།",
    "ངེས་པ་དོན་དུ་ཤིང་ལྷ་ཁོང་དགེ་སྦྱོང་གོ་ཏ་མ་ཡིན་པ་མོ་རང་གིས་གོ་ལ་ཤེས།",
    "གང་ལྟར་ཀྱང་མོས་ཞིམ་མངར་རོ་བཅུད་ལྡན་པའིའོའབྲས་ཐུག་པ་ཁོང་གི་ལྷུང་བཟེད་དུ་བླུག་བཞིན་སྨྲས་པ།",
    "ཁོ་མོའི་རེ་འབྲས་ཇི་ལྟར་གྲུབ་པ་བཞིན་ཤིང་ལྷ་ཁྱེད་ལ་ཡང་ཐུགས་ཀྱི་སྨོན་པ་གང་ཡོད་བདེ་ལེགས་ངང་འགྲུབ་པར་ཤོག་ཅིག།",
    "རུམ་ཀོག་རྣམས་ཀྱང་འཐོར་བརླག་ཏུ་སོང་སྟེ་ཕན་མེད་དུ་གྱུར་ན་ཡང་།",
    "ས་ག་ཟླ་བའི་ཡར་ཚེས་བཅོ་ལྔའི་སྔཉིནཏེ་ཚེས་བཅུ་བཞིའི་དགོང་མོར་དབུགས་འབྱུང་རྔུབ་ཀྱི་སྒོ་ནས་རྩེ་གཅིག་པའིཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "འོན་ཀྱང་ཁོང་གིས་དབུགས་འབྱུང་རྔུབ་ཀྱིཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་བཞུགས་པའི་རིང་ཐུགས་རྒྱུད་ལ་བསམ་བློ་མ་རུངས་པ་སྟེ་ཉོན་མོངས་པའི་བསམ་པ་དག་གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་སྐྱེ་འགོ་ཚུགས་པ་དཔེར་ན།",
    "རང་གི་སྙན་གྲགས་ཀྱི་ཕྱིར་བསྟོད་ན་དགའ་ཞིང་གུས་ཞབས་ལ་གཉེར་བ།",
    "གཞན་ལ་དམའ་འབེབ་ཅིང་རང་ཉིད་ཀུན་ནས་མཐོ་བར་འདོད་པ་སོགས་ཉོན་མོངས་པ་རྣམས་ཀྱིས་ཁོང་གི་རྩེ་གཅིག་པའིཏིང་འཛིན་ལ་བར་དུ་གཅོད་པར་བརྩམས་ནའང་།",
    "དེ་ལྟར་མཉམ་པར་བཞག་འབྲས་སུ་མཚན་མོ་ཆ་གསུམ་དུ་ཕྱེ་བའི་ནམ་གྱི་ཆ་སྟོད་ཙམ་ལ།"
  ]
}