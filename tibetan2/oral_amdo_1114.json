    "རང་ཅག་གི་སྟོན་པའི་སྐུ་གསུང་ཐུགས་ཀྱི་མཛད་འཕྲིན་ནི་ལྷ་སྒྲུང་དང་གཏམ་རྒྱུད་ལྟ་བུ་ཞིག་ཡེ་ནས་མ་ཡིན་པར།",
    "དེའི་ཐད་ཀྱི་བསམ་ཚུལ་བརྗེ་རེས་བྱེད་པར་ཕྱི་རོལ་པ་ཞིག་དང་ཐུག་འཕྲད་བྱུང་ན་ཅི་འདྲའི་དགའ་བ་ལ་ཨང་ཞེས་ཀྱང་དྲན་མྱོང་།",
    "མོ།",
    "བོད་བརྒྱུད་ནང་བསྟན་དུ་གསལ་བའི་སྟོན་པའི་མཛད་རྣམ་དང་རྒྱ་གར་བ་རང་གིས་མཛད་པའི་སྟོན་པའི་མཛད་རྣམ་གཉིས་ནི་གཅིག་པ་གཅིག་རྐྱང་རེད་ཨང་བསམས་ཏེ་སེམས་ལ་སྤྲོ་བ་འཕར་མ་ཞིག་བྱིན།",
    "སྤྱིར་ན་གོ་ལ་འདིའི་ཐོག་གི་ནང་པ་ཡོངས་རྫོགས་སྟོན་པ་གཅིག་གི་རྗེས་འབྲང་ཡིན་པས་ལྟ་སྤྱོད་གཅིག་པ་ཡིན་དགོས་པ་ནི་སྨྲོས་མེད་ཡིན་ནའང་།",
    "དེ་དག་གིས་གཅིག་མཚུངས་སུ་ས་ག་ཟླ་བའི་ཡར་ཚེས་བཅོ་ལྔའི་ཉིན་མོ་དེ་ནི།",
    "འཛམ་གླིང་ཐོག་གི་ཆེས་གསར་གཏོད་ཀྱི་ཐོག་མ་དེ་ཡིན་པར་གསུངས་པས།",
    "ཁོང་གི་ཉིན་ཞག་ཕྲུགས་གཅིག་གི་མཛད་རིམ།",
    "ཁ་ཤས་ཤིག་བོད་མིང་དུ་བསྒྱུར་རྒྱུ་ར་པ་ལི་ལ་རྒྱུས་མངའ་ཅན་རེར་མངགས་བཅོལ་བུས་ཀྱང་དེ་ཙམ་གྱིས་དོན་ཕན་མ་སོན་པས་འོལ་ཚོད་དུ་མ་བསྒྱུར་བར་རང་སོར་འཇོག་དགོས་བྱུང་།",
    "དེ་བཞིན་པ་ལིའི་ནང་དུ་གསལ་བྱེད་ཀྱི་ཤ་ཡིག་མེད་པས་ཤཱ་རིའི་བུའི་ཚབ་ཏུ་སཱ་རིའི་བུ་ཞེས་བྲིས་པ་སོགས་འགའ་རེ་ཡོད་པའང་པ་ལིའི་སྐད་ལ་བག་སྣ་ཆགས་འཇོག་ཕྱིར་རང་སོར་བཞག་པ་ཡིན།",
    "གུས་པར་མཚོན་ན་དབྱིན་བོད་གཉིས་ཐད་ནས་རྨང་གཞི་ཧ་ཅང་ཞན་སྟབས་ཚིག་དོན་གང་གི་ཆ་ལའང་ནོར་འཁྲུལ་དང་འགལ་འཛོལ་ཡོད་པ་གོར་མ་ཆག་པས།",
    "ནང་དགོང་དང་ཉིན་གོང་གི་བར་གསེང་དུས་ཚོད་དམ་འཛིན་བྱས་ཏེ།",
    "སྐུ་མྱ་ངན་ལས་འདས་པ་བཅས་ཀྱི་དུས་ཆེན་གསུམ་འཛོམས་ཀྱི་ཉིན་མོར་མཇུག་རྫོགས་པར་བྲིས།",
    "ཡབ་རྒྱལ་པོ་ཟས་གཙང་མ་དང་ཡུམ་སྒྱུ་འཕྲུལ་ཆེན་མོ།",
    "༩ཁེ་། གནའ་སྔ་མོ་ཞིག་ལ།",
    "རྒྱལ་པོ་ཟས་གཙང་མ་ནི་ཧ་ཅང་གི་ཡ་རབས་བཟང་སྤྱོད་དང་ལྡན་པ་ཞིག་ཡིན་ལ།",
    "ཁོང་གི་བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཡང་དེ་དང་གཅིག་མཚུངས་ཀྱི་ཀུན་སྤྱོད་ལ་ལྷད་མེད་པ་ཞིག་གོ།",
    "འོན་ཀྱང་ཁོང་ཁྱོ་ཤུག་གཉིས་ཀྱིས་དུས་ཡུན་རིང་མོ་ཞིག་གི་སྔོན་ནས་སྲས་ཤིག་འཁྲུངས་རྒྱུར་ངང་སྒུག་གི་རེ་བ་བྱས་ནའང་སྲས་གཅིག་ཀྱང་མ་འཁྲུངས།",
    "གང་ལྟར་དེ་ལྟའི་ལོ་ཟླ་རིམ་བཞིན་བཞུད་འགྲོ་བའི་མུར་ཚེས་ཆེན་བཅོ་ལྔ་ཞིག་གི་མཚན་མོར།",
    "བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ལ་མཚན་ལམ་ཡ་མཚར་བ་ཞིག་བྱུང་།",
    "མཚན་ལམ་དེའི་ནང་ལྷ་དང་ལྷ་མོ་བཞི་ཡིས་བཙུན་མོ་ཁོང་ཧི་མཱ་ལ་ཡའི་རི་རྒྱུད་ཀྱི་མཚོ་མ་དྲོས་ཞེས་པ་དེར་ཁྲིད་ནས།",
    "ལྷ་དང་ལྷ་མོའི་ཚོགས་ཀྱིས་མཚོ་མོ་དེ་ལས་ཁོང་ལ་སྐུ་གཟུགས་འཁྱུད་ཅིང་ཁྲུས་གསོལ་བར་བྱས་ཏེ།",
    "དུང་ལྟར་དཀར་བའི་གླང་ཆེན་ཞིག་གི་མཆེ་བའི་དཀྱིལ་པད་དཀར་གྱི་མེ་ཏོག་འགའ་ཁྱེར་ནས།",
    "བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་རྒྱལ་པོ་ཟས་གཙང་མའི་མདུན་དུ་བཅར་ནས་མདང་དགོང་རྨིས་པའི་མཚན་ལམ་གྱི་སྐོར་ཇི་བཞིན་ཞུས་པ་ན།",
    "མཁྱེན་རྒྱུ་ཆེ་བའི་དྲང་སྲོང་དག་གིས་མགྲིན་གཅིག་ཏུ་ཞུ་དོན།",
    "བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོས་རང་ཉིད་སྲས་བཙའ་བ་ལ་མངོན་དུ་ཕྱོགས་པར་ཤེས་ནས་རྒྱལ་པོ་ཟས་གཙང་མའི་མདུན་དུ་བཅར་ཏེ་ཞུས་པ།",
    "ད་ངེད་གཉིས་ཀྱི་སྲས་འཁྲུངས་ལ་ཉེ་བས་ཁོ་མོ་རང་གི་ཡབ་ཀྱི་གཞིས་ཀར་བསྐྱོད་དགོས་སོ།",
    "རང་ཉིད་ལ་ཕྲུ་གུ་སྐྱེ་སྐབས་རང་གི་ཕ་ཁྱིམ་ནས་སྐྱེ་དགོས་པ་ནི་སྐབས་དེ་དུས་ཀྱི་རྒྱ་གར་བའི་ཡུལ་སྲོལ་གོམས་གཤིས་ཤིག་ཏུ་ཆགས་ཡོད།",
    "རྒྱལ་པོ་ཆེན་པོས་དེ་ལ་མོས་མཐུན་གནང་སྟེ་ན་རེ།",
    "དེ་ནི་བཀྲ་ཤིས་པའི་གཏམ་བཟང་རེད།",
    "དང་ཐོག་རྒྱལ་པོ་ཆེན་པོས་བཙུན་མོའི་ཕེབས་ལམ་ལ་གཙང་སྦྲ་བྱེད་མཁན་གྱི་དམག་མི་བཏང་ཞིང་།",
    "དེ་ནས་བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་སེར་སྐྱའི་གཞི་ནས་ཕེབས་ཐོན་གནང་སྟེ།",
    "སེར་སྐྱའི་གཞི་ནས་ཀོ་ལི་ཡའི་རྒྱལ་ཕྲན་དུ་ཕེབས་ན་ལུམ་བི་ནིའི་ཚལ་ཞེས་པའི་སྐྱེད་ཚལ་དེ་བརྒྱུད་ནས་ཕེབས་དགོས་པས་ཁོང་ཚོ་དེར་འབྱོར།",
    "སྐྱེད་མོས་ཚལ་དེ་ནི་ཧི་མཱ་ལ་ཡའི་རི་གཤམ་དུ་ནེ་པཱལ་ཞེས་པའི་རྒྱལ་ཕྲན་གྱི་ཉེ་འདབས་སུ་ཡོད་ཅིང་།",
    "སྦྲང་བུ་དང་ཕྱེ་མ་ལེབ་སོགས་འབུ་སྲིན་རྣམས་ཀྱིས་ཀྱང་སྐད་སྙན་སྒྲོག་བཞིན་སྐྱེད་མོས་ཚལ་དེར་ཁེངས་འདུག་གོ།",
    "བྲེལ་ཟིང་ཆེ་བའི་བྱ་བྱེའུ་སྦྲང་བུ་དག་གིས་སྐད་སྙན་གྱི་གྲེ་འགྱུར་གླུ་རུ་བླངས་པ་སོགས་ཀྱིས།",
    "བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ན་རེ།",
    "ང་ཚོས་འགྲོ་མཚམས་བཞག་སྟེ་སྐྱེད་ཚལ་འདི་ནས་ཡུད་ཙམ་རིང་ངལ་གསོ་གྱིས་ཤིག།",
    "སྲས་འཁྲུངས་དུས་ཀྱི་ལོ་ཚིགས་དེ་ནི་སྤྱི་ལོ་མ་ཚུགས་གོང་གི་དུལོ་ངོ་༦༣༣ གྱི་ས་ག་ཟླ་བའི་ཡར་ཚེས་བཅོ་ལྔའི་ཉིན་ཡིན་ཞིང་།",
    "ཉིན་མོ་དེ་ནི་ཆེས་བཀྲ་ཤིས་པའི་ཉིན་མོ།",
    "དོན་འགྲུབ་པའི་ཉིན་མོ།",
    "ཕུན་སུམ་ཚོགས་པའིཉིན་མོ་ཞིག་རེད་ཨང་།",
    "སྐྱེས་རབས་གཞན་རེ་ནས་ཁོང་སྐུ་བལྟམས་མ་ཐག་ས་གཞི་ཆེན་པོའི་སྟེང་གོམ་པ་བདུན་སྤོས་ཏེགང་དུ་གོམ་པ་སྤོས་པའི་གཞི་དེར་མེ་ཏོག་པདྨ་རེ་འཁྲུངས་པར་བཞེད།",
    "ཡུམ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ལ་སྲས་འཁྲུངས་མ་ཐག་ཁོང་མགྱོགས་མྱུར་ངང་སེར་སྐྱའི་གཞི་ལ་ཕྱིར་ཕེབས་གནང་བས།",
    "ཁོང་ནི་ཧ་ཅང་གི་མཁྱེན་དཔྱོད་དང་ལྡན་པ་ཞིག་ཡིན་སྟབས་ཡུལ་མི་ཀུན་གྱིས་ཁོང་ལ་དྲང་སྲོང་ཆེན་པོ་ཞེས་ཞུ་བཞིན་ཡོད།",
    "ཁོང་གི་མཚན་དངོས་གནས་སུ་ཀ་ལ་དེ་ཝལ་ཞེས་ཞུ་གི་ཡོད་ན་ཡང་།",
    "དུས་རྒྱུན་ཡུལ་མི་ཚང་མས་ཁོང་ལ་དྲང་སོང་ཆེན་པོ་ཉོན་མོངས་མེད་ཅེས་འབོད་ཀྱི་ཡོད།",
    "དྲང་སྲོང་ཉོན་མོངས་མེད་ནི་དབེན་པའི་ནགས་ཀློང་ཁྲོད་དུ་བཞུགས་ཀྱིན་ཡོད་ན་ཡང་།",
    "ཁོང་གིས་ཡབ་རྒྱལ་པོ་ཟས་གཙང་མ་ལ་སྲས་ཤིག་འཁྲུངས་པའི་གཏམ་བཟང་དེ་ཐོས་པས་ཧ་ཅང་གི་དགའ་སྤྲོ་སྐྱེས།",
    "དེའི་ཕྱི་ཉིན་དྲང་སྲོང་ཉོན་མོངས་མེད་ཡབ་རྒྱལ་པོ་ཟས་གཙང་མའི་སྲས་ལ་གཟིགས་པར་ཕེབས་པས།",
    "དྲང་སོང་ཆེན་པོ་བཞུགས་ཁྲིར་འཁོད་རྗེས།",
    "ཡབ་ཟས་གཙང་མས་རང་གི་སྲས་དྲང་སྲོང་ཆེན་པོའི་མདུན་དུ་ཁྱེར་ནས་ཁོང་ལ་སྤྱན་འབུལ་དང་བསྒྲགས་ཞུ་དོན།",
    "ཁ་སང་སྐྱེས་པའི་ངའི་བུ་འདི་རེད།",
    "ཡབ་རྒྱལ་པོས་ཁོང་གི་སྲས་མ་འབུར་དེ་ལ་བརྟག་ཞིབ་མཐིལ་ཕྱིན་ཡོང་ཆེད།",
    "རྒྱལ་སྲས་ཀྱིས་རང་གི་ཞབས་གཉིས་དྲང་སྲོང་ཉོན་མོངས་མེད་ཀྱི་དབུ་ཐོག་ཏུ་བཞག་པ་དེའོ།",
    "ཁོང་གིས་རྒྱལ་སྲས་ཀྱི་ཞབས་མཐིལ་དུ་གསལ་བའི་རྟགས་དང་མཚན་མ་རྣམས་གཟིགས་པས།",
    "མགྱོགས་མྱུར་ངང་བཞུགས་ཁྲི་ལས་ཡར་བཞེངས་ཏེ་ན་རེ།",
    "ཡབ་རྒྱལ་པོས་གནས་ཚུལ་དེ་མཐོང་བས་ཁོང་གིས་ཀྱང་དྲང་སྲོང་དང་གཅིག་མཚུངས་ཀྱིས་རང་གི་སྲས་ལ་གུས་ཕྱག་ཞུས།",
    "དེ་ནི་ཡབ་རྒྱལ་པོས་རང་གི་སྲས་ལ་ཕུལ་བའི་ཐོག་མའི་གུས་ཕུག་དེ་རེད།",
    "གང་ལྟར་དྲང་སྲོང་ཆེན་པོའི་མ་འོངས་སྔོན་གཟིགས་ཀྱི་ལུང་བསྟན་དེ་ཡིས་རྒྱལ་ཕྲན་དེའི་མི་ཚོགས་ཐམས་ཅད་དགའ་བདེའི་དཔལ་གྱིས་ཁེང་བར་བྱས་སོ།",
    "ཡབ་རྒྱལ་པོ་ཟས་གཙང་མས་རང་གི་སྲས་ལ་མིང་དོན་མཚུངས་པའི་མཚན་ཞིག་ཐོག་ཆེད་མཚན་གསོལ་མཛད་སྒོ་ཞིག་གྲ་སྒྲིག་གནང་སྟེ།",
    "གལ་སྲིད་རྒྱལ་སྲས་འདིས་ཆབ་སྲིད་ཀྱི་ཐུགས་འགན་བདག་གིར་བཞེས་ན་རྒྱལ་པོ་ལས་ཀྱང་རྒྱལ་པོར་འགྱུར་བར་ངེས་ལ།",
    "། རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་སྐུ་འཁྲུངས་ནས་ཉིན་བདུན་པ་དེ་ལ་ཁོང་གི་མ་ཡུམ་སྒྱུ་འཕྲུལ་ཆེན་མོ་དགོངས་པ་རྫོགས་ཤིང་།",
    "དེའི་ཉིན་མོ་དེར་ཡབ་རྒྱལ་པོ་ཟས་གཙང་མའི་བཙུན་མོ་གཞན་པ་སྐྱེ་དགུའི་བདག་མོ་ལ་སྲས་ཤིག་ཀྱང་འཁྲུངས།",
    "སྐྱེ་དགུའི་བདག་མོ་ནི་ཡུམ་སྒྱུ་འཕྲུལ་ཆེན་མོའི་གཅུང་མོ་ཆུང་ཤོས་དེ་ཡིན་སྟབས།",
    "ཁོང་གིས་རང་ཉིད་ཀྱི་སྲས་མ་མ་གཞན་ཞིག་ཏུ་གཏད་ནས།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་རང་གི་ཤ་ནས་བཅད་པའི་བུ་ཕྲུག་ཇི་བཞིན་བྱམས་བརྩེའི་སྒོ་ནས་སྐྱེད་སྲིང་ཞུས།",
    "འོན་ཀྱང་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་རང་གི་མ་ཡུམ་ངོ་མ་དེ་སུ་ཞིག་ཡིན་མིན་མཁྱེན་གྱི་མེད།",
    "ཁོང་གི་སློབ་དཔོན་གྱི་མཚན་ལ་ཐམས་ཅད་བཤེས་གཉེན་༩དུ་འབོད་དོ།",
    "ཨབ་ཐང་རྩོད་རྒྱུ་སོགས་རྩེད་མོའི་རིགས་ཀྱང་མང་པོ་སྦྱངས།",
    "ཁོང་གིས་རང་ཉིད་ཀྱི་སློབ་ཚན་དེ་དག་སློབ་ཕྲུག་གཞན་པར་ལྟོས་ཏེ་ཆེས་མགྱོགས་མྱུར་ངང་མཁྱེན་ཐུབ་ཀྱི་ཡོད་ལ།",
    "རང་གི་སློབ་དཔོན་དང་རྒན་རབས་པ་དག་ལ་དོགས་གནས་ཀྱི་བཀའ་འདྲི་ཞུ་མཁན་གཅིག་པུ་དེ་ཡིན།",
    "ཁོང་གིས་དུས་ནམ་གྱི་ཚེ་ཡང་ལེ་ལོ་ལས་རྒྱང་བསྲིངས་ཤིང་སྤྱོད་ངན་གྱི་བུ་བ་དག་རྒྱབ་ཏུ་དོརཏེ།",
    "སྤྱི་ཡོངས་ཀྱི་ཆ་ནས་རྒྱལ་སྲས་ལ་ཕྱི་ནང་གི་མཐུན་རྐྱེན་ཕུན་སུམ་ཚོགས་པ་འཛོམས་པས་དཀའ་སྡུག་དང་ཕམ་ཉེས་སོགས་གང་ཡང་མ་བྱུང་ཞིང་།",
    "རྟ་རྒྱུག་འགྲན་སྡུར་སྐབས་སུའང་ཁོང་གིས་རྒྱལ་ཕྲན་དེ་ནས་གཟེངས་རྟོགས་མི་ཉུང་བ་ཐོབ།",
    "འོན་ཀྱང་ཁོང་གིས་དུས་ནམ་ཡིན་ཡང་རྒྱལ་སྲས་རང་ཉིད་ཀྱི་བདེ་སྐྱིད་ཆེད།",
    "ཤུགས་ལས་ངལ་རྩོལ་བྱེད་པའི་མི་མང་ཉམ་ཐོག་དང་སྐྱེ་འགྲོ་ཡོད་དོ་ཅོག་གི་དོན་དུ་ཐུགས་དགོངས་ཟབ་བཞེས་གནང་བཞིན་ཡོད་སྟབས།",
    "ཁོང་གིས་ཉམ་ཐག་པའི་སྐྱེ་འགྲོ་དེ་དག་ལ་རྒྱལ་སྲས་རང་ཉིད་ལ་ཡོད་པའི་བདེ་སྐྱིད་ནང་བཞིན་ཞིག་བསྐྲུན་འདོད་དང་།",
    "དེ་རྣམས་ཀྱིས་རྒྱལ་སྲས་རང་ཉིད་ཀྱི་སྐུ་དོན་དུ་དཀའ་ཚེགས་སྡུག་བསྔལ་མྱོང་བཞིན་པ་ལ་གནོང་འགྱོད་ཀྱང་གནང་བཞིན་པ་རེད།",
    "ཉིན་གཅིག་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་དང་ཁོང་གི་གཅུང་པོ་ལྷས་བྱིན་གྱིས་མདའ་གཞུ་ཡང་མཉམ་འཁྱེར་བྱས་ཡོད་སྟབས།",
    "ཁོས་གློ་ཀུར་དུ་ནམ་མཁར་ངང་པ་ཞིག་འཕུར་བཞིན་པ་མཐོང་བས་གཞུ་མོ་མདའ་ཡིས་བཀང་སྟེ་འཕངས་པར་དེ་མ་ཐག་ངང་པ་དེ་ས་ལ་གཡུག།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ནི་ལྷས་བྱིན་ལ་ལྟོས་ཏེ་ཆེས་མྱུར་སྟབས་ཀྱིས་བརྒྱུགས་པས་ངང་པ་དེ་ཁོང་གི་ཕུག་ཏུ་ཐོབ།",
    "ཁོང་གིས་འཇམ་ཞིང་མཉེན་པའི་ཕྱག་ཟུང་གིས་གཤོག་བར་དུ་ཐེབས་པའི་མདའ་མོ་དེ་ག་ལེ་ག་ལེར་ཚུར་བླངས་ཤིང་།",
    "བཞུར་བཞིན་པའི་ཟུངས་ཁྲག་དམར་མོ་འགོག་ཕྱིར་གྲང་ཞིང་བསིལ་བའི་ཤིང་གི་ལོ་འདབ་ཞིག་ལས་ཁུ་ཐིགས་འགའ་བླངས་ཏེ་མདའ་མོ་ཕོག་སའི་རྨ་ཁ་དེར་བཅུགརྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་ངང་པ་དེ་ལ་ཕྱག་གིས་རེག་པ་ན་ངང་པས་ཧ་ཅང་གི་ཞེད་སྣང་དང་དངངས་ཚབ་བྱས།",
    "ད་དུང་ཁོང་གིས་ངང་པ་ལ་བདག་སྐྱོང་དང་གཅེས་ཉར་བྱས་པས་ལྷས་བྱིན་ལ་ནོན་པར་དཀའ་བའི་ཁོང་ཁྲོ་སྐྱེས་ཏེ་ན་རེ།",
    "ངས་ངང་པ་འདི་ལ་མདའ་བརྒྱབ་ནས་ས་ལ་གཡུག་པ་ཡིན་པས་འདིའི་བདག་པོ་ང་མིན་ན་སུ་རེད།",
    "ངང་པ་འདི་ངས་ཁྱོད་ལ་གཏན་ནས་སྤྲོད་ཀྱི་མིན།",
    "འོན་ཀྱང་ངང་པ་འདི་ལ་ཁྱོད་ཀྱིས་མདའ་ཕོག་སྟེ་རྨས་སྐྱོན་བྱུང་བ་ཙམ་ལས།",
    "རྩེད་མོ་རྩེད་རོགས་ཀྱི་མཆེད་གྲོགས་ཀྱང་ལེགས་པོ་ཡོད།",
    "གོན་རྒྱུའི་གོས་སོགས་གང་ལྟར་ཟས་གོས་གནས་མལ་གང་ཐད་ནས་ཇི་འདྲའི་ཕུན་སུམ་ཚོགས་པ་ཞིག་རེདམང་།",
    "སྐྱེད་མོས་ཚལ་དེའི་དཀྱིལ་དུ་མེ་ཏོག་ཀུ་མུད་ལྡན་ཞིང་འཁྲུགས་རྩལ་ངོམས་པའི་ཉ་མོ་དང་ངང་པ་སོགས་རྩེན་པའི་མཚེའུ་དག་གིས་ཀྱང་ལེགས་པར་བརྒྱན་པར་བྱས་སོ།",
    "ཐ་ན་རྒྱལ་སྲས་ཀྱི་སྐུ་མདུན་ནས་ན་རྒ་འཆི་བའི་སྡུག་བསྔལ་དང་རབ་ཏུ་བྱུང་བ་སོགས་ཀྱི་སྐོར་ལ་གླེང་མོལ་ཙམ་ཡང་བྱེད་དུ་མ་བཅུག།",
    "ཁོང་གིས་དུས་ནམ་ཡིན་ཡང་ཐུགས་བསམ་བཞེས་བཞིན་སྐྱེ་བོ་གཞན་ལ་བཀའ་འདྲི་ལྷུག་པོར་གནང་གི་ཡོད།",
    "ཞེས་བཀའ་འདྲི་ཞུས་པར་ཁོང་ཚོས་གསུང་དོན།",
    "མཛེས་ཤིང་ཡིད་དུ་འོང་བའི་སྲས་མོ་མཛངས་མ་ཞིག་དང་ལྷན་གཉེན་སྒྲིག་བྱེད་དུ་བཅུག་ན་ཐབས་ཇུས་དེ་ནི་མཆོག་ཏུ་གྱུར་པ་ལགས་ཞེས་ཞུས་པར།",
    "ད་སྲས་མོ་འདི་དག་གི་ཁྲོད་ནས་ཁྱེད་ལ་འོས་པའི་བཙུན་མོ་ཞིག་འདེམ་རོགས་གྱིས།",
    "ཞེས་གསུངས་པར་རྒྱལ་སྲས་ཀྱིས་སྨྲས་མོ་དེ་ཚོའི་ཁྲོད་ནས་སྐུ་ལུས་ཀྱི་རྣམ་པ་མཛེས་ཤིང་ཡིད་སེམས་བྱམས་བརྩེ་ཡིས་གཏམས་པ་ཞིག་སྟེ།",
    "མིང་ལ་གྲགས་འཛིན་མ་ཞུ་བ་ཞིག་ཡོད་པ་དེར་སྲས་མོ་གཞན་རྣམས་ལ་གནང་བའི་ཕྱག་རྟགས་ལས་ཆེས་རིན་ཐང་ཆེ་བ་ཞིག་གནང་བ་ཡབ་རྒྱལ་པོ་ཟས་གཙང་མས་མཐོང་སྟེ་བསམ་པར།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་སྲས་མོ་གྲགས་འཛིན་མ་ཁོང་གི་གཏན་གྲོགས་སུ་བདམས་སོང་དགོངས་ཏེ།",
    "དགའ་སྤྲོ་དང་བཅས་གཉེན་རྟགས་དེ་ལ་མོས་མཐུན་གནང་ནས་སྲས་མོ་གྲགས་འཛིན་མ་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱི་བཙུན་མོར་ཁབ་ཏུ་བསུས་སོ།",
    "རྒས་ཤིང་འཁོག་པའི་སློང་མོ་བ་ཞིག་། ཡབ་རྒྱལ་པོ་ཟས་གཙང་མས་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱི་ཐུགས་ཡིད་ཡོངས་སུ་མགུ་བའི་ཕྱིར།",
    "ཁོང་གི་ངོས་ནས་བསྒྲུབ་དགོས་ཀྱི་མཐུན་རྐྱེན་གང་ཡོད་རྒྱལ་སྲས་ལ་གནང་སྟེ།",
    "ད་ནི་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་རིང་པོར་མི་ཐོགས་པར་གསེར་ཁྲིར་མངའ་གསོལ་ཞུས་ནས་ཁོང་གིས་ངའི་བརྒྱུད་འཛིན་གྱི་རྒྱལ་པོ་གནང་གི་རེད་དགོངས་སོ།",
    "ཁྱེད་ཀྱི་གཟིགས་སྐོར་དེ་ཕྱོགས་གང་ཐད་ནས་ལེགས་པོ་ཡོང་ཆེད།",
    "བདག་གིས་ཅིས་ཀྱང་སྟ་གོན་གྱི་གྲ་སྒྲིག་ཅིག་བྱེད་དགོས་གསུངས།",
    "ཁ་ནས་སོ་འཐོར་ཞིང་གོམ་པ་ཡང་འགྱུར་འཁྱོར་ངང་འདར་སིག་རྒྱག་བཞིན།",
    "ཉམ་ཐག་པའི་སྐད་གདངས་ཤིག་དང་བཅས་རང་གི་གཡས་གཡོན་གྱི་མི་ཚོགས་ལ་སློང་མོ་བྱེད་ཀྱིན་འདུག།",
    "ཕར་བལྟས་ཚོད་ལ་རྒས་འཁོག་དེས་ཟས་ཅུང་ཙམ་མ་རག་ན་ཉི་མ་དེ་ག་རང་དུ་ཤི་མི་ཡོང་ངམ་སྙམ་པ་ཞིག་རེད་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་རང་གི་མི་ཚེའི་ནང་འདི་ལྟ་བུའི་རྒས་འཁོག་ཅིག་མཐོང་བ་ཐོག་མ་དེ་ཡིན་སྟབས།",
    "རང་གི་ཤིང་རྟའི་ཁ་ལོ་སྒྱུར་བ་ཆདམ་སྨྲས་པ།",
    "ཕ་གི་དེ་སུ་ཞིག་རེད།",
    "ཁོང་གི་སྐྲ་ལོ་དེ་ཡང་ང་ཚོའི་སྐྲ་ལྟར་གནག་སྣུམ་མེད་ཅིང་དུང་ལྟར་དཀར་བ་ཅི་ཡིས་ལན།",
    "ཁྱོད་ཀྱིས་ང་ལ་ཤོད་དང་།",
    "ཅེས་བཀའ་འདྲི་གནང་བར་ཁ་ལོ་སྒྱུར་བ་ན་རེ།",
    "ཕ་གི་མི་དེ་ནི་རྒས་འཁོག་ཅིག་རེད།",
    "གལ་ཏེ་འཛམ་གླིང་འདིའི་སྐྱེ་བོ་ཚང་མ་རེ་རེ་བཞིན་ཚེ་རིང་པོར་འཚོ་ཞིང་བསྡད་ན་ཁོང་དང་གཅིག་མཚུངས་སུ་འགྱུར་རྒྱུ་ལས།",
    "དེའིདགོང་མོ་ཡབ་རྒྱུལ་པོ་ཟས་གཙང་མས་རྒྱལ་སྲས་ཀྱི་ཆེད་དུ་གསོལ་སྟོན་མཚན་ཚོགས་ཤིག་གོ་སྒྲིག་ཞུས་ཡོད་ནའང་།",
    "ཉིན་ཞིག་སྐྱེ་བོ་ཚང་མ་རེ་རེ་བཞིན་རྒ་བའི་སྡུག་བསྔལ་གྱིས་ནོན་པར་ངེས་ཤིང་།",
    "ཐ་ན་ཆེས་མཛེས་སྡུག་ཡིད་དུ་འོང་བ་ཞིག་ཡིན་ཡང་རྒ་བའི་སྡུག་བསྔལ་གྱིས་ཟིན་རྒྱུ་ནི་སྨོས་མེད་རེད་དགོངས་ཏེ།",
    "གང་ལྟར་དུས་དེ་ནས་བཟུང་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ནི་མཚན་མོའི་གཉིད་ཀྱང་མ་ཁུག་པར་ལུས་སོ།",
    "ད་དུང་ཁོང་གི་དགོངས་པར།",
    "རྒས་ཤིང་འཁོག་པའི་སྤྲང་པོ་དེ་ནང་བཞིན་སྐྱེ་བོ་ཚང་མ་རེ་རེ་ནས་རྒས་ཤིང་འཁོག་པར་གྱུར་ཏེ་གདུང་ལ་གཉེར་མས་ཁེངས་ཤིང་སྐྲ་ལོ་དཀར་པོར་འགྱུར་བ།",
    "ཁོང་ཡང་ཧ་ཅང་གི་ཐུགས་སེམས་སྐྱོ་སྟེ།",
    "དེར་བརྟེན་ཡབ་རྒྱལ་པོས་ཁོང་གི་གཉེན་ཚན་དང་ཞབས་ཕྱི་བ་དག་ལ།",
    "བདག་གིས་ཡང་བསྐུར་སེར་སྐྱའི་གཞི་ལ་སྐོར་ཞིབ་ཅིག་བྱེད་དགོས་ཤིང་།",
    "དེ་ནི་དམིགས་བསལ་མིན་པ་རྒྱུན་ལྡན་གྱི་ཉིན་མོ་ཞིག་སྟེ",
    "ཐེངས་འདིའི་རྒྱལ་སྲས་ཀྱི་གཟིགས་སྐོར་དེ་ལ་བཀག་འགོག་བྱེད་རྒྱུའི་ཐབས་ལམ་ཅི་འདྲ་ཞིག་བཙལ་ཡང་།",
    "ད་ལྟའི་གནས་སྟངས་འདི་ལ་གཞིགས་ན་རྒྱལ་སྲས་ཀྱི་ཐུགས་སེམས་མི་སྐྱིད་པའི་རྐྱེན་དུ་འགྱུར་བ་ལས་གཞན་ཕན་ཐོགས་མེད་པར་གཟིགས་ནས།",
    "ཐེངས་འདིའི་གཟིགས་སྐོར་སྐབས་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས།",
    "ཉམས་དགའ་ཞིང་སྤྲོ་སྣང་གིས་ཁེང་བའི་ཡུལ་མི་རྣམས་ཕེབས་བསུར་ཡོང་མེད་ལ།",
    "དེ་ལས་ལྡོག་སྟེ་མི་དམངས་དཀྱུས་མ་རྣམས་ཀྱིས་རང་རང་སོ་སོའི་ཉིན་རེའི་འཚོ་བའི་བྱེད་སྒོ་ཁག་སྒྲུབ་སྟེ་འཚོ་བ་སྐྱེལ་བཞིན་མཆིས།",
    "མགར་བ་ཞིག་གིས་རང་ཉིད་ཀྱི་སྟོད་རྒྱབ་ནས་རྔུལ་ཆུ་འཛར་བཞིན་རལ་གྲི་རྡུང་གིན་འདུག་ལ་ནོར་བུ་མཁན་དང་གསེར་བཟོ་བ་དག་གིས་ཀྱང་རྡོ་རྗེ་ཕ་ལམ་དང་།",
    "དེ་བཞིན་བག་ལེབ་བཟོ་མཁན་རྣམས་ཀྱིས་ཀྱང་བྲེལ་ཟིང་གི་ཁྲོད་ན་ཞིམ་མངར་ལྡན་པའི་བག་ལེབ་དང་ཁ་ཟས་བཟོ་ཞིང་ཚོང་ཤག་རྣམས་ལ་འགྲེམ་ཚོང་བྱེད།",
    "དེ་ལྟར་ཡུལ་མི་དཀྱུས་མ་རྣམས་ཀྱིས་དགའ་སྐྱིད་དང་བྲེལ་འཚུབ་ཀྱི་ཀློང་ན་ཁོམ་པ་མེད་པའི་རང་རང་སོ་སོའི་ཉིན་རེའི་འཚོ་བ་སྐྱེལ་སྟངས་དེ་རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་གསལ་ལེར་མཐོང་།",
