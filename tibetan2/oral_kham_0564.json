    "ལམ་གྱི་གཡས་གཡོན་གཉིས་སུ་མ་གལ་གྱི་སྡོང་བོ་མང་བོ་གྲལ་དུ་བསྒྲིགས་འདུག་རྒྱུ་ལམ་དང་མཉམ་གཤིབ་ཀྱིས་མདུན་ལ་བསྲིངས་ཡོད་པའི་ཆུ་རྐ་ལས།",
    "དེའི་རྗེས་ཀྱི་མཐོང་ཐོས་སུ་གྱུར་བ་རྣམས་ད་ལྟ་ཡིད་ན་གསལ་བོར་མི་འདུག་པས་ངས་དྲན་ཚོད་དུ་འབྲི་བར་མ་སྤོབས།",
    "བལྟས་ཚོད་དུ་སྣང་ཚུལ་དེ་དག་ནི་ཆེད་དུ་ཁོང་རང་ཉིད་ཀྱི་དགའ་སྤྲོའི་སྣང་བ་མཚོན་བྱེད་ལ་གྲ་སྒྲིག་བྱས་པ་དང་འདྲ།",
    "ཉལ་ཁང་མདུན་ཐད་ཀྱི་ལྒང་ལི་རྩེད་ས་ན་སློབ་གྲོགས་འགས་སྒང་ལི་རྩེད་བཞིན་འདུག་ཁོ་ཚོར་མཚོན་ན་འཇིག་རྟེན་འདི་ནི་ཆེས་ཡིད་གར་འོང་བའི་གླིང་ཕྲན་ཆུང་ཆུང་ཞིག་ཡིན་འདུག་ནམ་ཞིག་གླིང་ཕྲན་འདིར་འོངས་པ་དང་།",
    "ཉེ་འགྲམ་གྱི་བྱ་དངོས་རྣམས་ང་དང་རྒྱང་བཀྱེད་བཞིན་འདུག་འོན་ཀྱང་སློབ་གྲོགས་ཚོའི་འུར་སྒྲ་ནི་ཇི་འདྲའི་རྣ་ལ་གཟན་པ་ལ་ཨང་།",
    "སློབ་གྲོགས་གཞན་རྣམས་ཀྱི་འདུག་སྟེགས་སྟོང་བར་ལུས་འདུག་ང་འདུག་སྟེགས་སུ་བསྡད་རྗེས་སློབ་ཁང་ནང་ཧྲིལ་བོར་ལྟ་ཡག་ཅིག་བྱས་ན་ཡང་།",
    "སློབ་གྲོགས་ཚོས་རང་རང་སར་ཅི་ཞིག་ལ་མ་ཁོམ་པར་འདུག་པས།",
    "ང་ལ་ལན་གདབ་རྒྱུ་ཅི་ཡང་མི་འདུག་པས་ཁ་རོག་གེར་མི་འདུག་ཀ་མེད་བྱུང་།",
    "རང་ཉིད་གང་ན་ཡོད་པ་ཡང་ཤེས་བཞིན་མི་འདུག་ཅེས་ང་ལ་གཤེ་གཤེ་བཏང་བྱུང་།",
    "འདུག་མི་བདེ་བའི་སེམས་ཁམས་དེ་ལ་ནུས་ཚོད་ཀྱིས་འཐབ་རྩོད་བྱས་པ་ཡིན།",
    "ང་ལ་མཚོན་ན་ཕྱིར་ལན་ཅི་ཡང་མ་སློག་པར་ཁ་རོག་གེར་འདུག་རྒྱུ་ལས་ཐབས་གཞན་ཅི་ཞིག་ཡོད།",
    "ཐ་ན་ཤུལ་རྗེས་ཙམ་ཡང་ལྷག་མི་འདུག་སྙམ་བྱུང་།",
    "ཡོད་ཚད་དེ་འདྲའི་ལྐོག་གྱུར་ཞེ་མུག་པ་ཁོ་ནར་འདུག།",
    "ཐོག་ལ་ས་རྡུལ་ཆགས་ཡོད་པ་གཡས་འཐེན་གཡོན་འཐེན་བྱས་འདུག་པས།",
    "གང་ལྟར་ང་རང་མྱུར་དུ་ནར་སོན་པར་ཤོག་ནར་སོན་ཚེ་འཇིག་རྟེན་གྱི་གནས་ལུགས་མང་བོ་ཅིག་ཅར་ཏུ་རྟོགས་ཐུབ་པ་འདྲ།",
    "སློབ་ཁང་ནང་ལ་ཐོན་པ་ནས་ལྟོགས་སྐོམ་ལས་བྱུང་བའི་ཕྱོགས་དུ་མའི་མཉམ་སྒྲོག་རོལ་དབྱངས་ཤིག་ཁོག་པའི་གཏིང་ན་ཡང་ཡང་དཀྲོལ་བཞིན་འདུག་ངས་ངེས་པར་དུ་རྟོགས་བསྲན་བྱེད་དགོས།",
    "འདི་ནི་ང་རང་བསམ་བློ་བར་འགྱུར་རྒྱུའི་ཐོག་མའི་ཆ་རྐྱེན་མ་ཡིན་ནམ།",
    "མི་ལ་འགྲོ་འདུག་མང་ན་མི་བཟང་།",
    "ད་ཅིའི་ལྟོགས་ནས་སྔོན་མི་ཐུབ་པའི་ཚོར་བ་དེ་དག་ཇི་ལྟར་ཡལ་བའང་མ་ཤེས་པར་མེད་པར་གྱུར་འདུག་ལུས་ཀྱི་ཟུངས་ཟད་པ་ཡིན་ནམ།",
    "འདི་ལྟར་བསྡད་ན་ང་རང་འཆི་རྒྱུ་ལས་མེད་པས།",
    "དེ་ལྟར་བྱེད་པའི་དགོས་པ་ཡང་མི་འདུག་དེ་བས་ང་ཡང་བསྐྱར་ད་ཅིའི་ཁ་མལ་དེ་ནས་ཕྱིར་ཁ་སྦུག་ཏུ་ཉལ་བ་ཡིན།",
    "ང་རང་འདི་ལྟར་འཆི་རུང་ངམ།",
    "མཐའ་མེད་པའི་རྩྭ་ཐང་འདི་ན་ངེད་གཉིས་མ་གཏོགས་མི་གཞན་པ་མི་འདུག་པས།",
    "རིན་ཆེན་ཞེས་ངའི་མིང་ནས་འབོད་ཞོར་ལུས་སྟོད་སྤྲུགས་སྤྲུགས་བྱེད་བཞིན་འདུག་ང་གཉིད་ལས་སད་རྗེས་ཉེ་འགྲམ་གྱི་མི་རྣམས་རིམ་གྱིས་ལྷོད་ལ་བབས་པས་བྲེལ་ཚུབ་ཀྱི་རྣམ་པ་དེ་ཞི་འཇགས་སུ་གྱུར།",
    "རྒྱུས་མེད་ཅིང་འདྲིས་ཆེ་བའི་དྲི་མ་ཞིམ་པོ་ཞིག་ཁང་མིག་ཧྲིལ་བོར་ཁྱབ་འདུག་ཅིང་།",
    "ཉེ་འགྲམ་ཀྱི་དངོས་པོ་རྣམས་ང་དང་རྒྱང་ཐག་ཇེ་རིང་ལ་འགྲོ་བཞིན་འདུག་ཐེངས་འདིའི་འཁྲུལ་སྣང་ལྟ་བུའི་ཚོར་བ་འདི་ནི་ཕུང་བོ་ཁམས་དྭངས་པའམ།",
    "སྔོན་ཆད་ང་རང་བྱ་བ་ཙག་ཙིག་འགའི་ཆེད་དུ་གནས་འདིར་ཐེངས་འགར་ཡོང་མྱོང་ན་ཡང་།",
    "ང་རང་སྟག་ཤ་ར་ཞིག་ཡིན་ནམ།",
    "ང་རང་ངུ་ཤུམས་བྱ་འདོད་པ་འདིས་ཅི་ཞིག་མཚོན་ཐུབ་བམ།",
    "ང་རང་གསོན་དགོས།",
    "ངའི་མིག་མདུན་ན་ནར་མར་ཕར་ལ་བསྲིངས་འདུག་པའི་རྒྱ་ལམ་འདི།",
    "ངའི་རྐང་བ་ན་ནས་འགྲོ་མི་ཐུབ་པར་འདུག་པས།",
    "ད་སྔོན་ང་རང་སྲང་གོང་མར་ཡོང་སའི་རྒྱ་ལམ་གྱི་འགྲམ་ནས་ཆུ་ཚོད་ཕྱེད་ཙམ་ལ་ལངས་ནས་བསྡད་པས་ཡིན་ནམ།",
    "ངས་ཁོ་ལ་ང་རང་སྤྲང་བོ་ཞིག་མིན་ཚུལ་དང་།",
    "ཁོ་རང་ཧ་ལས་སུ་བཅུག་ཆོག་ན་ཡང་ངས་དེ་ལྟར་མ་བྱས།",
    "ཁོས་ང་རང་འགུལ་ཙམ་ཡང་མ་བྱས་པ་དེ་མཐོང་ནས།",
    "སྤྱིར་ནི་ང་རང་བདེ་སྲུང་བའི་ལྭ་བ་གྱོན་མཁན་གྱི་མི་འདིའི་རིགས་ལ་དེ་འདྲའི་དགའ་བོ་མེད་ན་ཡང་།",
    "ང་རང་ངོ་མ་སྤྲང་བོ་ཞིག་ལ་རིག་གམ།",
    "དེ་འདྲའི་གལ་ཆེན་དུ་བཟུང་དགོས་དོན་མི་འདུག་སྙམ།",
    "འདི་ནི་ང་རང་མཚན་ཉིད་པར་འགྱུར་རྒྱུའི་ཆ་རྐྱེན་མ་ཡིན་ནམ།",
    "འདུག་སྟེགས་སུ་བསྡད་རྗེས་སེམས་ཀྱི་གཏིང་ནས་ཅི་ཞིག་ང་དང་རྒྱང་བཀྱེད་བཞིན་འདུག་ལ།",
    "གང་ལྟར་མ་འོངས་པ་ན་ང་རང་མཚན་ཉིད་སྨྲ་བའི་མཁས་པ་ཆེན་པོ་ཞིག་ཏུ་མ་གྱུར་བའི་ཡར་སྔོན་དུ།",
    "འདི་དག་ནི་ང་རང་མཚན་ཉིད་པར་འགྱུར་རྒྱུའི་ཐད་ནས་གོ་ཅི་ཡང་མི་ཆོད་ན་ཡང་སྐབས་དེར་ངས་རྒྱུན་དུ་དེ་ལྟར་འདོད་མྱོང་།",
    "ང་ཁང་མིག་དེར་འབྱོར་ནས་དུས་ཚོད་ཕྱེད་ཙམ་གྱི་རིང་ལ་ཁོས་ང་ལ་ཡང་ཡང་ལྟ་བར་བྱེད་ཅིང་ལག་ནས་ཅི་ཞིག་འབྲི་བཞིན་འདུག་མི་གཞན་པ་ནང་དུ་ཡོང་ན་དགེ་སློབ་སུ་ཡིན་རུང་གདོང་ནས་འཛུམ་མདངས་ཡ་མཚན་པ་ཞིག་སྟོན་སྲིད་ན་ཡང་།",
    "མུ་མཐུད་ནས་ཨར་འདམ་གྱི་འདུག་སྟེགས་སྟེང་ནས་ཉལ་ནས་བསྡད་པ་ཡིན།",
    "ངས་མིག་ཟུང་བཙུམས་ནས་ཡུན་རིང་ཞིག་ལ་ཨར་འདམ་གྱི་འདུག་སྟེགས་སྟེང་ཉལ་བསྡད་པས།",
    "ཀན་དང་ཀན་ཞེས་ཚུགས་ཐུབ་ཀྱི་གནས་ལུགས་ཤིག་གང་ན་ཡང་མི་འདུག་པའི་བདེན་པ་ར་སྤྲོད་ཀྱི་གླུ་ཞིག་ཡིན་པ་འདྲ།",
    "གལ་ཏེ་འབྲེལ་བ་ངེས་ཅན་ཞིག་ཡོད་ཚེ་ང་རང་མཚན་ཉིད་པར་གྱུར་རྗེས་མཁས་པ་ཆེན་པོ་ཞིག་ཏུ་ཡང་ཆགས་འདུག་པ་མ་ཡིན་ནམ།",
    "སྐྱོ་བའི་ཉམས་འགྱུར་ཞིག་བསྐྲུན་འདུག་མགོ་ན་སྐྲ་ཐུང་ཐུང་ཞིག་ལས་བཞག་མི་འདུག་པས།",
    "ཁ་ཟས་འཚོལ་བཞིན་པའི་གླག་རྒོད་འགས་ནམ་མཁའི་མཐོངས་སུ་དལ་ལྷོད་རན་པའི་ལྡིང་སྐོར་རྒྱག་བཞིན་འདུག་འདི་ནི་སེམས་ཀྱི་འཇིག་རྟེན་གང་འདྲ་ཞིག་ཡིན་ནམ།",
    "རི་འདབས་དེ་ནས་བཟུང་ང་རང་སྡོད་སའི་གནས་འདི་དང་།",
    "སྔོན་ཆད་ལས་ལྡབ་འགྱུར་གྱི་ནར་སོན་འདུག་པ་ཚོར།",
    "གལ་ཏེ་མི་དང་རང་བྱུང་ཁམས།",
    "ཁོ་ལ་ལན་ཅི་ཡང་མ་བཏབ་པར་འདུག་སྟེགས་སུ་བསྡད་དེ།",
    "ང་རང་ནང་དུ་བསླེབས་པ་ན་ཧྲུའུ་ཅིས་ང་ལ་ལྟ་ཡག་ཅིག་བྱས་རྗེས།",
    "ཁོས་ང་རང་མ་འོངས་པར་རླབས་ཆེ་བའི་མཚན་ཉིད་པ་ཞིག་ལ་འགྱུར་རྒྱུ་ཡིན་པ་ཤེས་ཡོད་པ་འདྲ།",
    "འདིའི་ཡན་གྱི་ནུས་པ་ཞིག་ང་ལ་ཡང་མི་འདུག་ཅེས་པའི་ཚིག་དེ་ནི།",
    "ང་ལ་དྲི་བ་དེར་ལན་སློག་འདོད་གཏན་ནས་མི་འདུག་ལ།",
    "དཔེ་ཀློག་ནི་ང་ལ་མཚོན་ན་འཚོ་བའི་ཆ་ཤས་སུ་གྱུར་འདུག།",
    "ཟིལ་ཤུགས་ཁོ་ནས་ཀྱང་ཕ་རོལ་བོ་སྤ་སྐོང་བར་བྱེད་ཁོ་ཐག་ཏུ་འདུག་པས།",
    "མེ་ཏོག་ཨ་གར་གྱི་སྡོང་བུ་དེའི་ལོ་མ་ཁ་ཅིག་སྔོ་ལྗང་དུ་གནས་འདུག་པ་མཐོང་།",
    "ལྗང་སེར་འདྲེས་མའི་ཁ་དོག་ཏུ་གྱུར་འདུག་ང་ནམ་རྒྱུན་མེ་ཏོག་ལྡུམ་ར་དེའི་ཉེ་འགྲམ་བརྒྱུད་དེ་ཡར་འགྲོ་མར་འགྲོ་ཐེངས་མང་བོར་བྱས་མྱོང་ན་ཡང་།",
    "དོ་མི་མཉམ་པའི་ཆ་ཞིག་མངོན་གསལ་དུ་བྱུང་འདུག་པ་རྟོགས།",
    "སྐབས་དེའི་དྲན་ཚུལ་ལྷག་མ་ཞིག་ད་ལྟའང་ལུས་འདུག་སྟེ།",
    "ང་ལ་དངོས་གནས་འགྱུར་ལྡོག་བྱུང་འདུག།",
    "མི་ཞིག་འདི་ལྟར་རྒས་གྱིན་འདུག་སེམས་པ་ཞིག་འདི་ལྟར་རལ་བཞིན་འདུག་ཚེ་སྲོག་ལ་གཅེས་སྐྱོང་བྱེད་མི་ཤེས་པའི་བྱིས་པ་ཞིག་ལ།",
    "གང་ལྟར་སྐབས་དེ་དག་ཏུ་བདག་ལ་ལས་ཀ་བ་དེ་དང་འབྲེལ་འདྲིས་བྱེད་པའི་ཁོམ་པ་མི་འདུག་དེ་བས་མི་དེ་ལ་དངོས་སུ་འབྲེལ་འདྲིས་བྱུང་དུས་ནི།",
    "ང་རང་བྲེལ་བྲེལ་འཚབ་འཚུབ་ཀྱི་མི་ཞིག་ཡིན་པའི་རྣམ་འགྱུར་མང་དུ་བསྟན་མྱོང་།",
    "མི་དེ་ངའི་གམ་ལ་བསླེབས་འདུག་ཁོའི་ངོ་ལ་ལྷད་མ་འདྲེས་པའི་འཛུམ་མདངས་ཤིག་མངོན་བཞིན་ང་རང་ཕྱི་ལ་ཡོང་དགོས་པའི་བརྡ་བསྟན་བྱུང་།",
    "ཁོ་རང་སྙན་ངག་པ་ཞིག་ཡིན་པ་ལ་ང་རང་དོགས་པ་མི་ཟ་ཐུ་མེད་དུ་གྱུར།",
    "དེ་བས་སྙན་ངག་འདིའི་རྩོམ་པ་བོ་ཁོ་རང་ཡིན་པའི་དོགས་པ་དེ་རིམ་གྱིས་མེད་པར་གྱུར།",
    "ང་རང་སྤྱོད་ཁང་ནས་ཕྱིར་དཔེ་མཛོད་ཁང་དུ་ལོག་སྐབས།",
    "རང་རང་སར་ཁ་རོག་གེར་མི་འདུག་ཐབས་མེད་བྱུང་།",
    "ང་རང་སྔོན་ཆད་ནས་སྙན་ངག་ལ་དགའ་མ་མྱོང་།",
    "ད་ལྟ་ཁང་མིག་འདིའི་མཁའ་དབུགས་སྔར་ལས་ཀྱང་ཇེ་སྡུག་ཇེ་བཙོག་ལ་འགྲོ་བཞིན་འདུག།",
    "དུས་ཚོད་ཀྱི་བཞུར་རྒྱུན་ལ་སྔ་ན་མེད་པའི་ཕྱིར་དྲན་གྱི་བག་ཆགས་སྣ་ཚོགས་བགོ་བཞིན་འདུག།",
    "ང་རང་གཞན་ལས་ཁྱད་དུ་འཕགས་པ་ཞིག་ཏུ་འགྱུར་མི་སྲིད་ཅིང་།",
    "སྐབས་ལ་ལར་བོད་མི་འདི་ཚོ་ལས་གླེན་པ་ཞིག་མི་འདུག་སྙམ།",
    "ང་རང་ཆུང་དུས་ནས་དགུན་གྱི་དུས་ཚིགས་འདི་ལ་ཡང་དགའ་བོ་མེད།",
    "ཟླ་ནས་ལོ་བྱས་ཏེ་སྨོན་འདུན་ཤོར་ཤོར་ལ་འདུག་མཁན་རྐྱང་ཡིན་པ་རྟོགས།",
    "ཟིན་བྲིས་སུ་བཏབ་པའི་འབྲི་དེབ་གཉིས་ལྷག་ལོན་འདུག་པས།",
    "ཉི་མ་དེར་ང་ལ་མཚོན་ན་མི་སུ་ལ་ཡང་ཁ་བརྡ་བྱེད་འདོད་མི་འདུག་པས།",
    "ངའི་སྣང་བ་ཞིག་ལ་ང་ཁོ་ན་མི་རྣམས་ཀྱིས་བས་མཐར་དེད་འདུག་ཅིང་།",
    "ང་རང་མཚན་ཉིད་སྨྲ་བའི་མཁས་པར་འགྱུར་རྒྱུར་ད་རུང་དུས་ཚོད་མང་བོ་ཞིག་བརྒྱུད་དགོས་པ་འདྲ།",
    "ད་ལྟ་ང་རང་ཡང་བསྐྱར་སྔར་ལས་ཀྱང་འགྲིག་ལམ་བརྩི་ཤེས་པའི་མི་ཞིག་བྱ་རྒྱུའི་དམ་བཅའ་བཞག་ཟིན་པ་འདྲ།",
    "སྤྱོད་ཁང་ནང་ནས་ང་ལ་གཅིན་སྐྱག་གཉིས་ཀ་མི་འདུག་ང་སྤྱོད་ཁང་འདིའི་ནང་ལ་འོངས་དོན་ཅི་ཞིག་ལ་གཡོལ་འདོད་པའི་ཕྱིར་མ་ཡིན་ནམ།",
    "ནམ་རྒྱུན་ལུས་དང་གྲིབ་མ་ལྟར་འགྲོགས་བཞིན་པ་དེ་ཡང་ང་ཡིན་པར་འདུག་ང་སྔོན་ཆད་ནས་དཔལ་ཆེན་རྡོ་རྗེ་ལ་སུན་སྣང་སྐྱེ་བཞིན་ཡོད་པའི་སེམས་ཁམས་དེས་ང་ལ་རྫུན་མགོ་སྐོར་བཞིན་པ་འདྲ།",
    "ཏག་ཏག་ང་རང་ལངས་སྡོད་ས་ནི་ཉིས་ཐོག་ནས་སུམ་ཐོག་ལ་འགྲོ་སའི་ཐེམ་སྐས་ཀྱི་ཁ་གཏད་ན་ཡོད་ཕྱིར།",
    "ཕལ་ཆེར་ངའི་འཚོ་གནས་དང་བཅས་པ་ཡོངས་སུ་བརྗེད་འདུག་པ་འདྲ།",
    "ང་རང་ཕྱི་ལ་ཡོང་དགོས་པའི་བརྡ་བརྒྱབ་བྱུང་།",
    "འདང་ཕྱི་མཐོང་མ་མྱོང་བའི་རྒྱབ་བསྙེས་ཡོད་པའི་འདུག་སྟེགས་སོ་མ་དེས་ཁང་བ་འདིའི་ནང་ལ་དེང་རབས་ཀྱི་མཁའ་དབུགས་ཤིག་བསྣན་འདུག་དྲ་མའི་ཐེམ་ཐོག་ན་གཟེངས་ཐོན་ལ་བྱིན་པའི་ཟངས་ཀྱི་སྒྲོམ་བུ་གཉིས་གཅིག་ལ་གཅིག་བསྙེས་ཏེ་བསླངས་ནས་བཞག་ཡོད་ཅིང་།",
    "པར་ངོས་དེའི་འདབས་སུ་ཡིག་འབྲུ་ཆེན་པོ་འགའ་གཟི་བརྗིད་དང་བཅས་ཏེ་བཀོད་འདུག་ངས་ཡིག་འབྲུ་དེ་དག་ལ་བལྟ་འདོད་ཤིན་ཏུ་ཆེ་ན་ཡང་།",
