    "གདུང་མེད་ཀྱིས་ཐོབ་མཆོག་གི་རྗེས་སུ་མཐུན་པ་ཉིད།",
    "དེ་ལས་བཟློག་པ་མ་རུངས་པ་ཉིད་མ་ཡིན་པས་བླ་ན་མེད་པའི་རྗེས་སུ་མི་མཐུན་པར་འགྲོ་བ་མ་ཡིན་ཞིང་བྱ་དཀའ་བའི་གདུང་བ་མེད་པ་ཉིད་ཀྱིས་དོན་ཆེན་ཐོབ་པ་སྐྱེས་བུ་མཆོག་གི་རྗེས་སུ་མཐུན་པ་ཉིད་དེ།",
    "སྙན་སྒྲོག་དག་གི་སྒྲོག་བྱེད་བུང་ཚོགས་སྤྲིན་ནག་དུས་ལྟར་གནག།",
    "སྙན་སྒྲོག་དག་གི་སྐད་སྒྲོག་བྱེད་བུང་བའི་ཚོགས་སམ།",
    "འཆི་བའི་དུས་ཀྱིས་མི་བཟུང་བ་དུས་ཆའི་གཙོ་བོ་ཁྱོད་ནི་ཆུ་འཛིན་གྱིས་མཛེས་པའི་གངས་རིའི་བསྟི་གནས་སུ།",
    "བརྗོད་པའི་ཁོངས་སུ་འདུ་མོད་ཀྱང་།",
    "ཚིགས་བཅད་རེ་ལ་རྐང་པ་བཞི་བཞི་ཡོད་པའི་དང་པོའི་མཐའ་དང་གཉིས་པའི་མགོ་ལྟ་བུ་རྐང་པ་གཉིས་གཉིས་ཀྱི་མཐའ་ཐོག་རབ་ཏུ་སྦྱར་བའི་ཟུང་ལྡན་གྱི་གནས་སྐབས་འདི་ནི་སྔར་བརྗོད་པའི་ཟུང་ལྡན་དེ་དག་གི་ཁོངས་སུ་འདུ་བ་ཡིན་མོད་ཀྱང་།",
    "མྱོས་པས་ཆགས་པ་ཉེར་བར་གནས་ཀྱང་བུད་མེད་དེས།",
    "རོ་དང་སྦྱར་ཏེ་ལུས་མེད་དག་གིས་གདུང་གྱུར་ཀྱང་།",
    "རྐང་པ་རེ་རེ་བཟླས་པའང་དུ་མའི་བདག་ཉིད་དེ།",
    "རྐང་པ་རེ་རེ་བཟླས་པའོ།",
    "ཁྱོད་ཀྱི་མཆོག་ཏུ་འབད་པ་ཡི།",
    "དེའི་ཕྱིར་ཁེངས་ལྡན་འབད་མེད་མ་ཁྱོད་ཀྱིས་ཀྱང་མཆོག་ཏུ་འབད་པས་སྤོང་བའི་ཡིད་བརྟན་བྱའོ་ཞེས་པའི་རྒྱ་དཔེར་རྐང་པ་དང་པོ་དང་གཉིས་པ་ལ་ཇི་ལྟར་ཡོད་པ་དེ་ཉིད་གསུམ་པ་དང་བཞི་པར་ཡང་བཟླས་ཏེ་ཡོད་པས་མཚོན་དཔེར་བརྗོད་འོག་མ་རྣམས་ལའང་རིགས་འགྲེ་བར་བྱའོ།",
    "ཁྱོད་ཀྱི་བགྲོད་པ་ཁྱབ་བདག་གཟི་བྱིན་གྱིས།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་གཡུལ་ལ་བགྲོད་པ་ཁྱབ་བདག་སྟེ་ཁྱབ་འཇུག་ལྟ་བུའི་གཟི་བྱིན་གྱིས་གདུང་བའི་གནོད་པ་ཡང་ཡང་རབ་ཏུ་སྦྱར་བས་མཛེས་པ་མེད་པས་མི་རྣམས་དཔའ་བོའི་ཚུལ་དང་ང་རྒྱལ་ཉམས་པར་བྱས་ནས་འཆི་བའི་སྡུག་བསྔལ་གྱིས་གདུངས་ཤིང་རོ་རྣམས་ནི་ཀྱེ་མ་བྱས་ཟོས་ཏེ་རྣམ་པར་བཅོམ་མོ།",
    "འབྲུག་གི་སྒྲའི་སྤྲིན་གྱི་བགྲོད་པ་གཡོ་བ་དབྱར་སྐྱེས་རྨ་བྱའི་ཚོགས་རྣམས་དགའ་བས་མཛེས་པ་ཉིད་དུ་ཉེ་བར་གྱུར་ཅིང་།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་པད་རྩ་དྲི་མ་མེད་པས་འཛེགས།",
    "བརྒྱན་པའི་བུད་མེད་དག་དང་རྣམ་པར་བརྩེ་ཞིང་སྤྱོད།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་ཡོན་ཏན་གྱི་གྲགས་པ་པད་རྩ་དྲི་མ་ལྟར་དཀར་བས་སྟེང་དུ་འཛེགས་ཏེ་ཕྱིན་ལ།",
    "ཁྱོད་ལས་གཞན་པ་སུ་ཞིག་མ་བཅོམ་དེ་ཡི་ཕྱིར།",
    "འབྱུང་པོ་ལུས་ལྡན་སྐྱོན་ལས་གྲོལ་བ་ཁྱོད་ལ་སོགས།",
    "ཁྱོད་ལས་གཞན་པའི་སྐྱེས་བུ་སུ་ཞིག་མ་བཅོམ་པ་མིན་པ་སྟེ་བཅོམ་ནས་མྱོས་པར་བྱས་པ་དེའི་ཕྱིར་འབྱུང་པོ་སྟེ་སྐྱེས་བུའི་ལུས་དང་ལྡན་པའི་ནང་དུ་སྐྱོན་ལས་གྲོལ་བ་ཁྱོད་ལ་སོགས་པ་བགྲང་བ་ལ་ནི་མིང་མེད་ཅིང་།",
    "ཁྱོད་ཀྱི་དམག་དཔུང་ཁྱབ་འཇུག་ལྟ་བུ་གོ་དགོས་པ།",
    "མཚོན་རྣོན་ལྡན་པ་དཔའ་བོ་དག་གིས་ཕྱོགས་རྣམས་སུ།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་དམག་དཔུང་ཁྱབ་འཇུག་ལྟ་བུ།",
    "མཚོན་རྣོན་པོ་དང་ལྡན་པ་དཔའ་བོའི་དཔུང་ཚོགས་དག་གིས་ཕྱོགས་རྣམས་སུ་རྣམ་པར་རྒྱལ་བའི་གྲགས་པ་དང་།",
    "ཁྱོད་ཀྱི་ལག་པ་དཔལ་དང་ལྷན་ཅིག་ལག་འགྲོ་ཡིས།",
    "ཁྱོད་ཀྱི་ལག་པ་དཔལ་དང་ལྡན་པ་དང་ལྷན་ཅིག་ལག་འགྲོས་ས་གཞིའི་དཀྱིལ་འཁོར་འདི་ཉིད་རྣམ་པར་འཛིན་ལ།",
    "རོ་མེད་ཁྱོད་ཀྱི་བདེ་བ་དེ་དག་ནི།",
    "འདོད་པའི་མེ་གང་མཛའ་བོར་མི་འདོད་པའི་ཁེངས་པས་རབ་ཏུ་བསྒྲུབས་པ་ཉིད་སྐད་ཅིག་རེ་དང་མཉམ་དུ་ཆེས་ཆེར་རྒྱས་ཏེ་པདྨའི་མིག་ཅན་མ་རོ་འདོད་མེད་པ་ཁྱོད་ཀྱི་བདེ་བ་དེ་དག་ནི་ཀུན་ནས་ཉམས་པ་ཉིད་དུ་ཅིས་མི་བྱེད་དོ།",
    "མ་དུད་ཁྱོད་ནི་འཇིག་རྟེན་དག་གྱུར་ཚེ།",
    "མཐུ་ཡིས་མཐུ་ལྡན་རིན་ཆེན་མང་གིས་བཏུད།",
    "སུ་ལ་ཡང་མ་དུད་པ་ཁྱོད་ནི།",
    "དཔུང་གི་གླང་པོ་རྣམས་ནི་གཞན་དང་གཞན།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་དཔུང་གི་གླང་པོ་རྣམས་ནི་གཞན་དང་གཞན་མང་པོའི་སྟོབས་དང་ལྡན་ཞིང་འཇིགས་པའི་སྒྲ་སྒྲོག་པར་བྱེད་ལ།",
    "ཁྱོད་ལྟ་མཉམ་པར་མ་གཞག་སྲིད་པར་ནི།",
    "ཀྱེ་ངོ་ཚ་མེད་པ་ཁྱོད་ལྟ་བུ་མཉམ་པར་མ་གཞིག་པའི་སེམས་ལྡན།",
    "སྒྲུབ་བྱེད་མི་ཉམས་པ་ངག་དང་རྣམ་པ་གཞན་དུ་བྱེད་པ་སྦྲུལ་གྱི་བགྲོད་པ་དང་མཚུངས་པ་ཁྱོད་ལ་བདག་མི་དད་དོ།",
    "རྣམ་འདྲེན་ཁྱོད་ཀྱིས་བསྟེན་པ་ཡི།",
    "འདི་ནི་རྐང་པ་རེ་རེ་ལའང་བར་མ་ཆོད་ཀྱི་ཟུང་ལྡན་གཉིས་ལ་སོགས་པ་ཡོད་པས་ཟུང་ལྡན་གྱི་བྱ་བ་གཞན་ཡིན་ནོ།",
    "མཛེས་པ་མཉམ་པ་མེད་པའི་དཔལ་ལྡན་མཚུངས་པ་མེད་པའི་ལང་ཚོ་ཅན་མ་ཁེངས་ལྡན་ཁྱོད་འདོད་གདུངས་ཀྱིས་ངལ་བ་དག་དང་ཁེངས་པ་མཉམ་དུ་ལྡན་ཏེ།",
    "ཁྱོད་ཚུལ་མིན་དག་དོར་བའི་སྤྱོད་པ་ཚད་ལྡན་འདིས་མཛའ་བོ་གྲོགས་སུ་ཆུག་ཅིག་ཅེས་པའི་རྒྱ་དཔེར།",
    "ས་མཱ་ན་ཡཱ་ཞེས་པ་ཉིད་རྐང་པ་རེར་ལན་གཉིས་གཉིས་བཟླས་ཏེ་ཡོད་དོ།",
    "གང་ལ་འབད་བྱས་ཕྲ་མོ་ཉིད།",
