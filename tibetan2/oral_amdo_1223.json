    "སྐྱེས་བུ་སྟོང་གི་སྲོག་ལ་གཞར་བྱེད་པའི།",
    "ཚིག་གིས་གཞན་དག་མགོ་བོ་རྨོངས་བྱས་ནས།",
    "མི་འཇིགས་ནང་ནའང་སྲོག་གི་སྦྱིན་པ་ལས།",
    "འགྲོ་ལྡོག་ཤིན་ཏུ་གཡོ་བའི་དཔུང་ཚོགས་བཞིས།",
    "རང་གི་ངང་ཚུལ་ཉམས་ལ་སྤྲོ་མ་ཡིན།",
    "རིགས་དང་ཡོན་ཏན་བདག་གིར་བཟུང་ནུས་མིན།",
    "སྐྱེས་བུ་མཆོག་གི་ངོ་ཚའི་ཡ་ལད་ལ།",
    "རྒྱུ་འབྲས་ངན་པ་དམོད་པས་འདེབས་ལ་དཔའ།",
    "མྱོས་བྱེད་མ་ཡི་ལང་ཚོའི་ཁྱད་པར་གྱིས།",
    "གང་ཕྱིར་འཇིག་རྟེན་དག་གི་བདེ་སྡུག་ནི།",
    "བདེན་ཚིག་གཅིག་གི་མཐུ་ཡིས་དབུགས་འབྱིན་བྱས།",
    "ཉིན་མོའི་དཔལ་ཡང་སྐོམ་པས་གདུངས་བ་བཞིན།",
    "དགྲ་ཡིས་བཟའ་བར་མཐོང་ལ་རང་གི་མིག།",
    "འཚོ་བ་ཉོན་མོངས་མ་ཡིན་དགེ་སྡིག་དང་།",
    "ངོ་ཚ་ཤེས་པ་ལང་ཚོའི་དགྲར་གྱུར་ནས།",
    "ཐལ་མོ་སྦྱར་ནས་འབྲོས་པའི་གོ་སྐབས་བཙལ།",
    "བརླག་པར་བྱེད་ལ་ཆང་གིས་དོ་ཟླར་མིན།",
    "གྲགས་པ་ངན་པའི་ཆང་གིས་མྱོས་མཐོང་ནས།",
    "བརྒྱ་བྱིན་བུམ་པའི་རེབས་བཞིན་གཞན་ཕན་ཤོག་༡༧།",
    "སྲོག་གི་ཕྱིར་ཡང་དེ་ལ་ཡོད་མིན་ན།",
    "སྒྱུག་མོ་དོགས་པས་བསླུས་པའི་གཏམ་གྱི་འཛུམ།",
    "གང་གིས་བཞིན་རས་མཛེས་པའང་ཉམས་འགྱུར་ལ།",
    "ཁྱོ་ཤུག་ཆགས་བྲལ་བརྟུལ་ཞུགས་ལ་གནས་པའི།",
    "བཟང་མོའི་ཉེས་སྤྱོད་སྡོམ་པའི་བག་མ་ནི།",
    "སྐྱེད་མོས་ཚལ་དུ་རྒྱལ་པོས་བསྙེན་པ་གང་།",
    "དངོས་སམ་རྫུ་འཕྲུལ་འཕྱང་མོ་ཉུག་ལ་བྲེལ།",
    "བྱམས་པའི་གོམ་པ་གཅིག་གིས་བདེ་བླག་བགྲོད།",
    "རེ་ཞིག་འཁྱམས་པའང་འདོད་པས་དབྱེན་བཅོས་ཏེ།",
    "ཉ་གྲོ་དྷ་ཡི་འབྲས་བུ་གཅིག་ཅིག་གིས།",
    "རྒྱལ་པོའི་དཔུང་ཚོགས་བོས་པའི་སྤྲེའུའི་ཚོགས།",
    "མཆོངས་པ་གཅིག་གིས་གཞལ་བྱ་མ་ཡིན་པར།",
    "གྲགས་པ་མཆོག་གི་ཡན་ལག་དང་འགྲོགས་ཤིང་།",
    "དགེ་དང་ཞི་བའི་སྲོག་གིས་བསྟེན་བྱས་པས།",
    "སྤྱི་བརྟོལ་ལྟ་བ་ངན་པའི་ཚིག་གི་ཚོགས།",
    "གངས་རིའི་རྩེ་མོས་གོམ་པ་དོར་བར་རྫུ།",
    "མཐོ་རིས་བུ་མོས་སྤྲུལ་པའི་སྐྱེད་ཚལ་དུ།",
    "བཟང་མོ་སྟོང་གིས་བསྙེན་བཀུར་སྟོབ་པ་ཡང་།",
    "དཔུང་ཚོགས་ཡན་ལག་བཞི་ཡང་ཕམ་ནུས་ལ།",
    "འདི་ན་ལང་ཚོ་ཡོལ་བའི་བྱིས་པ་རྣམས།",
    "དེ་ཡི་གྲེ་བར་འཇུག་པའི་ཤིང་རྟ་མོ།",
    "འདབ་ཆགས་ཤིང་རྟ་མོ་བཞིན་བདག་འགྱུར་ཤོག་༣༤།",
    "ལྕགས་ཀྱིས་འཁྱུད་མོས་བསྡམས་པའི་གྲུ་གཟིངས་ལ།",
    "སྤུ་གྲི་རྣོན་པོས་རང་གི་སྲོག་བྱིན་ནས།",
    "འཛམ་བུའི་གླིང་གི་བཟའ་བའི་དངོས་པོ་ཀུན།",
    "བསོད་སྙོམས་གཅིག་གི་འབྲས་བུས་དབུགས་འབྱིན་བྱས།",
    "ལྷ་མིག་དག་པའི་རང་རྒྱལ་གྱིས་གཟིགས་ནས།",
    "དེ་ལ་མེ་ལྕེས་རེག་པའི་རྣོ་དབལ་ཟུར།",
    "ཉོན་མོངས་ཚེར་མ་རྣོན་པོའི་ཟུག་རྔུའི་དབལ།",
    "བསམ་གཏན་མེ་ཆེན་གཅིག་གིས་བསྲེགས་པ་ནི།",
    "འཛམ་བུའི་གླིང་གི་ལོངས་སྤྱོད་གང་ཡིན་པ།",
    "དཀའ་ཐུབ་ནགས་ཚལ་མཛེས་པར་རབ་ཏུ་སོང་།",
    "རེག་པ་ཤིན་ཏུ་མི་བཟད་མེ་དཔུང་ཡང་།",
    "འདོད་པའི་ཁམས་ན་རེག་བྱ་རྡོ་རྗེ་མ།",
    "ཨུཏྤལ་མིག་ཅན་བཙུན་མོའི་དོ་ཟླར་མིན།",
    "རེག་པའི་བདེ་བས་མྱོས་པའི་ཡིད་སྲུབས་མདའ།",
    "བསམ་གཏན་ཆོ་ག་གཅིག་གིས་དོན་ལྡན་བྱས།",
    "སྡིག་སེམས་རྩུབ་མོས་འདའ་བར་མ་ནུས་པས།",
    "བྱེ་བ་བརྒྱ་ཕྲག་བདུན་ཅུ་ལས་ཐལ་བའི།",
    "བགྲང་གིས་མི་ལང་སྐྱེད་མོས་ཚལ་གྱི་མཆོག།",
    "རི་མོར་བགྱིད་པའི་རྒྱལ་པོ་དཔལ་དབྱངས་མཐུ།",
    "པདྨའི་རྣལ་མ་མཆོག་གི་ལག་པ་ནི།",
    "དད་ནས་རང་གི་སྣང་བའི་དཔལ་སྟེར་ཞིང་།",
    "རྒྱལ་པོའི་ཁྱིམ་ཡང་དབེན་པ་ལྟ་བུར་གཟིགས།",
    "རིགས་གཟུགས་ལང་ཚོའི་བ་དན་གཡོ་བ་ཅན།",
    "གུས་པ་མི་ལྷོད་ཤེས་རབ་མཆོག་གིས་མཉན།",
    "སྡིག་ལས་ལྡོག་པའི་ཚིགས་བཅད་གཅིག་གི་སླད།",
    "རྒྱལ་པོའི་བུ་མོ་ཡེ་ཤེས་ལྡན་ལ་སྨོན།",
    "བདེ་གཤེགས་མཚན་གྱིས་ཁྱོད་ལ་དོན་ཡོད་བྱས།",
    "བླུན་པོ་རྣམས་ལ་མིག་གི་མདུན་སར་ཡང་།",
    "རྒ་བས་ལང་ཚོའི་མཛེས་པ་འཕྲོག་བྱེད་ཅིང་།",
    "རལ་གྲིའི་བདེ་བླག་གཅིག་གིས་མཐར་བྱས་པའི།",
    "འཁྲུལ་བའི་བུ་མོ་ཀུནྡར་བརྫུ་བས་བྲེལ།",
    "སྲོག་གི་ཚོང་ཟོང་ཁྱེར་བའི་ལང་ཚོས་ཀྱང་།",
    "ཉོན་མོངས་ཐབས་ཀྱིས་བཅོམ་པའི་ནུས་པ་ལ།",
    "རང་གིས་རང་ཉིད་རྨོངས་བྱེད་ཅིང་།",
    "མཚར་སྡུག་ལང་ཚོའི་གེ་སར་ཀྱིས་བོས་པའི།",
    "གཞོན་ནུ་མ་ཡི་སོར་མོའི་ལྕུག་ཕྲན་རྣམས།",
    "ནོར་བུའི་འཁྱུད་མོས་བསྡམས་པའི་ཟློས་གར་དང་།",
    "གར་མཁན་འགྲོ་བའི་དཔལ་མོ་ལྟར་འགྱུར་ཤོག་༦༦།",
    "དཔའ་ཞིང་རྟུལ་ཕོད་ལྡན་པའི་བུ་སྟོང་གི།",
    "དམོད་པས་དྲང་སྲོང་མཐུ་ཡང་ཉམས་སད་ལ།",
    "བསམ་ངན་གཅིག་གིས་ནུས་པས་བརླག་ལ་ལྟོས།",
    "གྱུར་པས་ས་འདི་དབྱིག་གིས་བཀང་།",
    "འཁྲི་ཤིང་ཐོབ་པའི་སྤྲེའུ་ཁྱོ་ཤུག་བུ་ཡང་སྐྱབས་སུ་དོང་བཅུག་ནས།",
    "གཞན་ཕྱིར་བདག་གི་སྲོག་བཏང་བ།",
    "ཆོ་ག་ཞིབ་མོས་བརྟུལ་བའི་གླང་ཆེན་ཡང་།",
    "གླང་མོའི་གདུང་བས་བཅིངས་པ་ལྕགས་ཀྱུས་མིན།",
    "གང་ཞིག་འདོད་པའི་གླང་པོ་གཉའ་རེངས་ནི།",
    "ཐུབ་པ་མཆོག་གི་སྡོམ་པས་མ་ཐུལ་ན།",
    "གསེར་གྱི་ཁང་བུ་བརྩེགས་པ་རང་གི་རིན།",
    "ཁྱོད་མཐུས་བདག་ཅག་བར་སྣང་དཔྱངས་སོ་ཞེས།",
    "སྣ་ཚོགས་རོལ་མོའི་སྒྲ་ཡིས་སྟངས་གཅོད་བཞིན།",
    "བདེན་པར་སྨྲ་བ་གཅིག་གིས་དབུགས་འབྱིན་བྱས།",
    "ཟབས་ཆེན་དབྱིག་གིས་གང་བའི་གྲགས་སྙན་ནི།",
    "མཆེ་བ་དྲུག་གི་རིན་ཐང་དེས།",
    "གླང་པོ་མཆོག་ལ་རེག་པའི་དུག།",
    "རྒྱ་མཚོའི་སྐ་རགས་ལྡན་པའི་གླིང་གི་ཁྱོན།",
    "འཇིག་རྟེན་དག་དང་ཐུན་མོང་ཡིན།",
    "ཤིན་ཏུ་གཏོང་བའི་མཚོན་གྱིས་རེག་པར་འཇིགས་པ་མ་ཡིན་ཁྲག་གི་རླབས་ཕྲེང་འཕྱུར་ལ་ལྟོས།",
    "བཙུན་མོ་བྱིན་པས་ས་འདི་འདར་བའི་རྒྱུས།",
    "གང་ལ་བོས་པར་ལྟར་སོང་མིག་སྟོང་པ།",
    "རེག་པ་ཤིན་ཏུ་རྩུབ་མོ་སོག་ལེའི་ལྕེས།",
    "གང་དུ་རྒྱལ་སྲིད་འབྱོར་པའི་སྐྱེད་མོས་ཚལ།",
    "དེ་ན་ཕྲུག་གུས་འབྲངས་པའི་སྟག་མོ་ནི།",
    "ཉམ་ཐག་མཐོང་བའི་མོད་ལ་ལུས་སྦྱིན་ཡང་།",
    "ཁྲག་གི་ཆུ་རྒྱུན་འབབ་པའི་གཞོན་ནུའི་ལུས།",
    "སྲོག་གི་སླད་དུ་བདག་ཉིད་མི་བསྲུངས་སྐྱེས་བུ་ཆེན་པོའི་བློ་སྟོབས་ཀྱིས།",
    "གྲགས་སྙན་མུ་ཏིག་གདུགས་དཀར་ཡུ་བ་ལ་རེག་བྲམ་ཟེ་དྲག་པོས་མིག།",
    "སྡིག་སེམས་རྩུབ་མོའི་སྒྲ་གཅན་གདོང་དེའི་སློང་བ་དོན་མཐུན་ལ་སེམས་པ།",
    "མི་བདག་རང་གི་ཅོན་པན་བཀྲོལ་བའི་མོད་ལ་སྐྱེ་དགུ་གཞན་གྱི་མགོའི།",
    "འཁར་བའི་རྩེ་མོར་འདར་ཞིང་རྡུལ་བའི་ཆུས།",
    "དྲི་བཅས་མ་ཡིན་སྐྱེས་བུའི་ཟུངས་ཁྲག་གིས།",
    "རྩ་ཆེན་གཏུབས་པའི་ཁྲག་གིས་དེ་ལ་གསོ།",
    "ང་རྒྱལ་སྤྲིན་གྱི་ལྕག་མའི་གད་མོ་དང་།",
    "གང་གིས་སྐ་རགས་བཅིངས་པ་ཙམ་གྱིས་ཀྱང་།",
    "གླང་པོའི་སྤྱི་བོས་བཏུད་པའི་ཐལ་མོའི་གཟི།",
    "གདེངས་ཀ་རྣོན་པོས་མ་བཟོད་ཕ་རོལ་སོང་།",
    "ལྟོ་འགྲོའི་དུག་གིས་སེང་གེའི་སྲོག་བཏང་ལ།",
    "ལྷུན་པོའི་དཔལ་ཡང་ཕྲག་དོག་གི།",
    "རེ་བ་ཆུ་གཏེར་དབུས་འཁྱམས་པའི།",
    "རང་གི་བརྩོན་འགྲུས་སྨྲ་བབས་ནས།",
    "རྣ་རྒྱན་རི་དྭགས་མིག་གིས་ཉོས་པའི་བཞིན།",
    "མི་འམ་ཅི་ཡི་བུ་མོ་ཡིད་འཕྲོག་མའི།",
    "ཕ་རོལ་གནོན་ལ་རྟུལ་ཕོད་ནོར་བཟང་གིས།",
    "སོར་མོའི་ལྕུག་ཕྲན་འདར་བའི་གདུ་བུའི་སྒྲ།",
    "ཁྱོ་ཤུག་མཛའ་བའི་བརྩོན་པ་བྱེད་པ་བཞིན།",
    "བགྲོད་དཀའ་ཉོན་མོངས་བརྒྱ་ཡིས་སྲུངས་བའི་ལམ།",
    "རྒྱལ་པོ་རང་གི་ཡུལ་ན་ཆེ་བའི་ཁབ།",
    "བསྡུ་དངོས་བཞི་པའི་དཔུང་གི་ཡན་ལག་ནི།",
    "གཡུལ་གྱི་བགྱི་བ་རྩུབ་མོས་མ་ཡིན་པར།",
    "སྣང་བས་ཉིན་མོར་རབ་བྱས་པས།",
    "ཡེ་ཤེས་མཆོག་གི་སྤོབས་པའི་གཏམ།",
    "དངོས་པོར་བལྟ་བའི་ལྕགས་སྒྲོག་གིས།",
    "རྟོག་གི་བློ་གྲོས་ལྟར་འགྱུར་ཤོག་༩༣།",
    "ཉོན་མོངས་རྙོག་པ་རབ་ཞིའི་རྟོག་དཔྱོད་ཀྱི།",
    "ཆོ་ག་ཤིན་ཏུ་ཞིབ་མོས་འདབ་མའི་གྲངས།",
    "ཉོན་མོངས་དབའ་ཀློང་འཁྲུགས་པའི་རྣམ་གཡེང་རླབས།",
    "དག་བྱེད་གཏེར་གྱིས་འཁྱུད་མོས་རབ་བསྡམས་པའི།",
    "བགྲང་དུ་མི་སྤྱོད་སྲས་དང་བཙུན་མོའི་འཁོར།",
    "ཞབས་སེན་རི་མོས་བཀོད་པའི་འོད་ཟེར་གྱིས།",
    "བདེ་གཤེགས་འོད་མཐའ་ཡས་པའི་ཞིང་ཁམས་ཁྱོན།",
    "བཅུ་གཉིས་བགྲོད་པའི་ལྟད་མོར་འོངས་པ་བཞིན།"
  ]
}