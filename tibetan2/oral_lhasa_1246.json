    "དུར་ཁྲོད་དངོས་མིན་ན་འདི་དུར་ཁྲོད་ཀྱི་གནས་དེ་རུ་ནི་བསམ་པར་བྱས་ནས།",
    "ཐོད་པས་སྤྱི་བོ་བརྒྱན་བྱས་ཤིང་།",
    "དུམ་བུ་གཅིག་པའི་ཐོད་པ་ལས་བྱས་པའི་འཁོར་ལོས་སྤྱི་བོར་བརྒྱན་པ་དང་།",
    "སླར་ཡང་མཁའ་སྤྱོད་དེ་སྟེང་དུ་རྡོ་རྗེའི་གུར་བྱས་པ་འདི་ནི་བདག་ཉིད་ལ་བགེགས་ཀྱིས་མི་ཚུགས་པའི་གོ་ཆར་འགྱུར་རོ།",
    "ཕྱག་རྒྱ་ལྔས་རྣམ་པར་བརྒྱན་ནས་དངོས་གྲུབ་ཐམས་ཅད་རབ་ཏུ་སྟེར་བའི་འཇིགས་པ་སྟེ་ཁྲོ་བོའི་དཀྱིལ་འཁོར་འབྲི་བར་བྱའོ།",
    "ས་ཆོག་བྱས་པ་དེ་ནས་ཐིག་གདབ་པ་ལ།",
    "མི་རོའི་རྒྱུས་པ་ལ་བྱས་པའི་ཐིག་སྐུད་ལ་འཆད་དོ།",
    "འདིའི་ཐིག་གདབ་ཚུལ་རྒྱས་པར་ནི་འདོད་འཇོ་ལས་ཤེས་པར་བྱ་ལ།",
    "དེ་ཡང་སྒོ་བཞི་པ་དང་ཕྱོགས་ཀུན་ནས་མཉམ་པ་ཟུར་བཞི་བ་རྟ་བབས་བཞི་ཡིས་རྣམ་པར་བརྒྱན་པར་བྱའོ།",
    "སྔགས་པས་ཐིག་སྐུད་ཀྱི་ཚད་དཀྱིལ་འཁོར་ཉེས་འགྱུར་དུ་རྣམ་པར་དཔྱད་ཅིང་།",
    "ཚོན་དེས་དཀྱིལ་འཁོར་དེ་ཡི་དབུས་སུ་སྣ་ཚོགས་པད་མ་ནི་ལྟེ་བ་འདབ་མ་བརྒྱད་པ་དང་བཅས་པ་འོད་ཟེར་འབར་བ་དང་བཅས་པ་གེ་སར་ཡང་དག་དང་ལྡན་པར་བཞག་པ་སྟེ་བྲི་བར་བྱའོ།",
    "དགོད་པར་བྱ་བའི་དཔའ་བོ་ཧེ་རུ་ཀ་ནི།",
    "གླང་པོ་ཆེའི་ལྤགས་པ་རློན་པ་རྣམ་པར་བགོས་པ།",
    "དཔལ་ཧེ་རུ་ཀ་ལ་མངོན་དུ་ཕྱོགས་པར་བྱས་ནས་བཞུགས་པ།",
    "ཕྱོགས་མཚམས་རྣམས་སུ་དགོད་པར་བྱ།",
    "དེ་རྣམས་བཅས་པའི་ཆུ་ཡིས་དེའི་ནང་ལེགས་པར་དགང་ངོ།",
    "བདུད་རྩི་དང་དྲི་ཆུས་བཀང་བའི་སྣོད་ཐོད་པ་ནི་བུམ་པའི་སྟེང་དུ་བཞག་པར་བྱའོ།",
    "ཁ་ནི་འདབ་མ་ཅན་གྱི་ཤིང་ལོས་བརྒྱན་པར་བྱ་བ་དང་།",
    "བསང་སྦྱང་བསྐྱེད་དེ་སྔགས་བཟླ་བ་སོགས་བྱས་ནས་བསྒྲུབ་པར་བྱའོ།",
    "བུམ་པ་བརྒྱད་ནི་སྒོ་བཞི་རུ་གཉིས་གཉིས་རྣམ་པར་དགོད་ཅིང་།",
    "སྟ་གོན་གྱི་སྐབས་ཡིན་ན་དབུས་སུ་གཞག་པར་བྱའོ།",
    "གསེར་རམ་དངུལ་ལམ་མུ་ཏིག་དང་རིན་ཆེན་གཞན་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་མཛེས་པར་བྱའོ།",
    "སློབ་དཔོན་བདག་ཉིད་ལ་དྲི་ཞིམ་པོའི་ཆུས་ལེགས་པར་གདབ་པར་བྱ་སྟེ།",
    "སྒྲུབ་པ་པོ་ཡིས་རྔ་སྟེ་ཅང་ཏེའུ་བརྡུང་ཞིང་ཧ་ཧ་ཞེས་པའི་སྒྲ་ནི་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་ཆོ་ག་བཞིན་དུ་དཀྱིལ་འཁོར་མཆོད་ནས་ཕྱིའི་དཀྱིལ་འཁོར་དུ་གཞུག་པར་བྱའོ།",
    "དེ་གཉིས་ལས་དང་པོ་ལྟར་ན་སྟ་གོན་གྱི་སྐབས་སུ་བུར་བྱས་པས་ན་བུ་སྟེ།",
    "མཛེས་པ་ཡིད་དུ་འོད་པ་ཡོལ་བའི་ཕྱི་རོལ་ཏུ་འཁོད་པ་དེ་རྣམས་ཀྱི་གདོང་ལ་ནི་དར་རམ་རས་ཀྱིས་ལེགས་པར་དགབ་པར་བྱའོ།",
    "ཡོལ་བའི་ནང་དུ་ཡང་དག་པར་ནི་ཞུགས་པ་དག་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཡིད་ཀྱི་བཞུགས་པར་བསམ་པའོ།",
    "ཡོད་པ་ལྟར་སློབ་དཔོན་བློ་གྲོས་བཟང་བོ་དང་ལྡན་པ་ཡིད་ནི་མཉམ་པར་བཞག་ཅེས་སྦྱར་རོ།",
    "ཤྲཱི་ཧེ་རུ་ཀའི་གནས་སོགས་ཀྱིས་ལྷ་གང་དེའི་གནས་གཞལ་ཡས་ཁང་རྣམས་བསྟན་པར་བྱའོ།",
    "སྔར་དཀྱིལ་འཁོར་ལ་བསྐོར་བ་བྱས་པ་ལས།",
    "གླང་པོ་ཆེ་དང་རྟ་དང་ཡུལ་འཁོར་དང་རྣ་རྒྱན་དང་གདུ་བུ་དང་མགུར་རྒྱན་དང་སོར་གདུབ་དམ་པ་དང་གསེར་ལས་བྱས་པའི་མཆོད་ཕྱིར་ཐོགས་ཏེ་སེར་རལ་ཁ་དང་།",
    "དེང་ནས་བརྩམས་ཏེ་ཁྱེད་ཀྱི་བྲན་དུ་བདག་ཁྱེད་ལ་བདག་ཉིད་ཀྱིས་འབུལ་བ་ལགས་སོ།",
    "དེ་ལྟར་ཆོ་ག་བྱས་ན་ནི།",
    "རྣལ་འབྱོར་མ་ཉེར་བཞི་རྣམས་མཉེས་པར་འགྱུར་རོ།",
    "གཟུགས་ཅན་མའི་རིགས་ཀྱི་མཁའ་འགྲོ་མ་དེ་རྣམས་དང་སྒྲུབ་པ་པོ་གཉིས་ལྷན་ཅིག་ཏུ་རྣམ་པར་སྤྱོད་ཅིང་ཀུན་ཏུ་འགྲོ་བར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་ཚེ་བསྐལ་བར་ཐུབ་པའི་བཅུད་ཀྱིས་ལེན་རྣམས་སྒྲུབ་པ་པོ་ནི་འདོད་པ་ཙམ་གྱིས་རྟག་པར་རྒྱུན་དུ་སྐྱེད་པར་འགྱུར་རོ།",
    "ཁྱད་པར་དུ་གདུག་པའི་མཁའ་འགྲོ་རྣམས་དང་།",
    "དེར་མ་ཟད་འགྲོ་བ་གཞན་རྣམས་ཀྱང་ལན་ཅིག་བལྟས་པས་ངེས་པར་ཟིལ་གྱིས་གནོན་པར་འགྱུར་རོ།",
    "ནམ་མཁའ་ལ་ཁུ་ཚུར་གྱིས་རྡོག་པར་སེམས་པ་དང་།",
    "གང་ཞིག་རྟག་ཏུ་སྟེགས་ཅུང་ཟད་ཅིག་རྒྱུན་ཏུ་ཡིད་ལ་འདོད་པར་གྱུར་པ་དེ་དང་དེར་ལྷ་དང་ལྷ་མིན་དང་མི་རྣམས་ཏེ་འདི་དག་ཟིལ་གྱིས་གནོན་ཅིང་འགྲོ་བར་འགྱུར་རོ།",
    "ཁྱད་པར་དུ་རྟེན་འཁོར་ལོ་གསུམ་ནི་རྣམ་པར་འགྱིང་པ་སྟེ་རོལ་པའོ་ཞེས་རྟེན་དཀྱིལ་འཁོར་གྱི་དེ་ཉིད་སྟོན་ཏེ།",
    "དེ་རྣམས་ནི་སྒྲུབ་པ་པོའི་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "ནང་ལུས་དཀྱིལ་གྱི་གནས་ཉེར་བཞིར་ཡང་དགོད་པར་བྱའོ་ཞེས་པའི་དོན་ནོ།",
    "སྔགས་ཐམས་ཅད་གསལ་བ་སྟེ་མཛེས་པར་བྱེད་པའི་ཨོ་ནི་ཐོག་མ་དང་།",
    "དཔའ་བོ་ཉིད་དུ་འགྱུར་བ་གྲུབ་པ་སྟེ་ལྷ་རྫོགས་པར་བྱའོ།",
    "དེ་ལྟར་བསྒོམས་ན་དངོས་གྲུབ་རྣམས་དེ་བཞིན་གཤེགས་པས་གསུངས་པ་བཞིན་དུ་འཐོབ་པོ།",
    "ཡེ་ཤེས་ཀྱི་དེ་ཉིད་ནི་རྡོར་བཟླས་དང་ཕྱིའི་ཕྱག་རྒྱ་ལ་བརྟེན་ནས་སྐྱེས་པའི་ལྷན་སྐྱེས་ཀྱི་བདེ་བ་དང་དེ་ཁོ་ན་ཉིད་དབྱེར་མི་ཕྱེད་པར་ཞུགས་པའི་འོད་གསལ་གྱི་ཡེ་ཤེས་སོ།",
    "དཔལ་ཧེ་རུ་ཀར་བརྗོད་པ་བསྡུས་པའི་རྒྱུད་ལས་ཕྱི་དང་ལུས་ཀྱི་དཀྱིལ་འཁོར་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་གཉིས་སུ་མེད་པར་དགོད་པའི་ལེའུ་སྟེ་བཞི་བའི་འགྲེལ་བའོ།",
    "ཤར་གྱི་འདབ་མ་ནས་རིམ་པར་གཡས་སྐོར་དུ་དབྱངས་ཡིག་རྣམས་དང་།",
    "དེ་ནི་འདོད་པའི་དོན་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པའོ།",
    "སྤང་ལེབ་སོགས་གཞི་གཙང་མར་བཏུ་རྒྱུའི་ཡི་གེ་རྣམས་བཀོད་ནས་ཀཱ་ལི་ལས་ཐུ་བ་ལ།",
    "ཀ་ནས་བགྲངས་པའི་སུམ་ཅུ་པ་ཤ་ནི་ཡང་དག་པར་བླང་ངོ།",
    "དེ་དག་ནི་ཀ་ནས་བགྲངས་པ་སྟེ་གཞན་ལའང་ཤེས་པར་བྱའོ།",
    "ཡི་གེ་བྱ་དང་བྱཱ་གཉིས་རྡོ་རྗེ་དང་པདྨ་བྱིན་གྱིས་རློབ་བྱེད་ཡིན་པས་འདིར་ཡན་ལག་དང་བཅས་པར་བཏུས་ཞེས་ཁ་ཅིག་བཞེད་ལ།",
    "ཉི་ཤུ་རྩ་ལྔ་བ་མ་ཡང་དག་པར་བླང་བ་དང་།",
    "དེ་བཞིན་དུ་ཉི་ཤུ་རྩ་བདུན་པར་དང་།",
    "དེ་གཉིས་སོ་སོ་ནས་ཀྱང་རྩ་སྔགས་སུ་གསུངས་པའི་ཚུལགཉིས་ཡོད་པས་ཕྱེད་པར་བྱའོ།",
    "དེའི་གསང་སྔགས་ནི་བཏུས་པའི་རྩ་སྔགས་ཏེ་བསྒྲུབ་པར་བྱ་བ་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པའོ།",
    "དེ་བཞིན་ཞེས་པ་ནི་བཅུ་གཉིས་པོ་ཧའི་སྲོག་ཏུ་ཞུགས་པ་ལས་ཧ་ཧཱ་ཧི་ཧཱི་ཧུ་ཧཱ་ཧེ་ཧི་ཧོ་ཧོ་ཧོ་ཧཞེས་པར་འགྱུར་བའི་ཡི་གེ་ཐུང་ངུ་གཉིས་ཀྱི་བར་མ་ཧཱུ་ཧཱི་སོགས་རིང་པོ་ལྔ་དང་ཐ་མ་དོར་བར་བྱའོ།",
    "ཕཊ་ཧཾ་ཞེས་དེ་རྣམས་དང་ཡང་དག་པར་ལྡན་པར་སྦྱོར་ཞིང་།",
    "གཉིས་པ་ན་མ་ཧི་སྤྱི་བོར་དགོད་པར་ཤེས་པར་བྱའོ།",
    "བཞི་བ་བོ་ཥཊ་ཧེ་ནི་གོ་ཆ་ཉིད་དུ་སྟེ་ཕྲག་པར་དགོད་ལ།",
    "དྲུག་པ་ཕཊ་ཧཾ་ནི་ལུས་ཀྱི་ཡན་ལག་ཐམས་ཅད་ལ་སྲུང་བ་སྟེ་དཔྲལ་བར་དགོད་པར་བྱའོ།",
    "སྤྱིར་གོ་ཆ་ལ་ལྷ་དང་སྔགས་འགོད་པའི་ཚུལ་གཉིས་ཡོད་ཀྱང་སྐབས་འདིར་ལྷ་དང་སྔགས་ངོ་བོ་དབྱེར་མེད་པའི་སྔགས་ཉིད་དགོད་པར་བསྟན་ཏོ།",
    "དབྱངས་ཡིག་བཅུ་གཅིག་པ་ཨེ་དང་ཡང་དག་ལྡན་པས་ཡི་གེ་དྲུག་པ་ཏ་ལ་བརྒྱན་པར་བྱའོ།",
    "དབྱངས་ཡིག་གཉིས་པ་ཨཱ་རིང་པོ་དང་ལྡན་པར་ཡི་གེ་དགུ་བ་ཤ་ལ་བརྒྱན་པར་བྱའོ།",
    "ཡི་གེ་ཉི་ཤུ་བ་ན་དང་དབྱངས་ཀྱི་གསུམ་པ་ཨི་ཐུང་ངུ་ཉིད་སྦྱར་བའི་ནི་དེ་ཡི་གེ་བཅོ་ལྔ་བ་ག་དང་སྦྱར་བ་སྟེ་གདགས་པར་བྱའོ།",
    "དབྱངས་ཡིག་བཅོ་ལྔ་བ་ཨཾ་དང་ཡང་དག་པར་ལྡན་པ་སྟེ་སྦྱར་བས་ཡི་གེ་བཅུ་དྲུག་པ་སས་མཛེས་པར་བྱའོ།",
    "དབྱངས་ཡིག་གཉིས་པ་ཨཱ་རིང་པོ་དང་ལྡན་པར་ཡི་གེ་ཉི་ཤུ་རྩ་དྲུག་པ་ཊར་འགྱུར་རོ།",
    "ཡི་གེ་སུམ་ཅུ་རྩ་གསུམ་པ་དག་ནི་ཉི་མའི་ས་བོན་རང་ཡང་དག་པར་ལྡན་པ་སྟར་སྟེ་བྱའོ།",
    "དབྱངས་ཡིག་བཞི་བ་ཨཱ་རིང་བོ་ཉིད་དང་ནི་ཡི་གེ་སུམ་ཅུ་རྩ་བཞི་བ་བྷ་ར་ལྡན་པར་བྱ་བ་ནི་འདོད་པའི་དོན་ཀུན་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "དབྱངས་ཀྱི་ལྔ་བ་ཐུང་ངུ་ཉིད་དག་ནི་ཡི་གེ་སུམ་ཅུ་རྩ་བདུན་པ་དང་ཡང་དག་པར་ལྡན་པ་ནི་མཁའ་འགྲོ་མ་རྣམས་བསྐུལ་ནས་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "སུམ་ཅུ་རྩ་བརྒྱད་པ་ཁ་འདི་དག་ནི་དབྱངས་ཡིག་གཉིས་པ་ཨཱ་རིང་པོ་དང་སྦྱར་བ་ནི་ལྷ་རྣམས་ཐམས་ཅད་སྒྲུབ་པའི་རྒྱུ་ནི་འདི་ཉིད་ཡིན་པར་ཐེ་ཚོམ་མེད་དོ།",
    "དབྱངས་ཡིག་ལྔ་བ་ཨུ་ཐུང་ནི་ཉིད་དག་ཀྱང་བཞི་བཅུ་རྩ་དྲུག་པ་ས་དང་ལྡན་པར་བྱ་སྟེ།",
    "ལྷ་སྔགས་ངོ་བོ་ཐ་མི་དད་པའི་ཕྱིར་རོ།",
    "ལྔ་བཅུ་རྩ་གཉིས་པ་བ་ཉིད་ནི་དབྱངས་ཡིག་གཉིས་པ་ཨ་རིང་པོ་དང་སྦྱར་བ་ནི་ལྷ་རྣམས་ཐམས་ཅད་སྒྲུབ་པ་ནི་འདི་ཉིད་ཡིན་པར་ཐེ་ཚོམ་མེད་དོ།",
    "ཡི་གེ་ལྔ་བཅུ་རྩ་དྲུག་པ་ཤ་དེ་དབྱངས་ཡིག་དྲུག་པ་སྐུ་རིང་པོ་དང་སྦྱར་བ་ནི་དགྲ་རྣམས་ངེས་པར་གཅོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་དབྱངས་ཡིག་བཅོ་ལྔ་བ་ཨ་དང་སྦྱར་བ་ནི་དངོས་གྲུབ་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ལ།",
    "ཡི་གེ་དྲུག་ཅུ་རྩ་གཉིས་པར་དབྱངས་ཡིག་གསུམ་པ་ཨི་ཐུང་ངུ་དང་སྦྱར་བ་ནི་མཁའ་འགྲོ་མ་ཡི་རིག་པ་མཆོག་ཏུ་འདོད་དོ།",
    "དེ་བཞིན་དུ་དྲུག་ཅུ་རྩ་ལྔ་བ་གྷ་རྡོ་རྗེ་སེམས་དཔའ་རས་ཕྱེ་བ་དག་སྟེ་ར་སྟར་བྱས་པའི་ས་བོན་འདི་ནི་ལྷ་རྫས་ཏེ་བདུད་རྩི་མཆོག་དང་།",
    "སྔགས་དེ་དག་ནི་བྱ་བ་ཀུན་ལ་གྲུབ་པ་སྦྱིན་པར་འགྱུར་ཏེ་དེ་ལྟར་དེ་བཞིན་གཤེགས་པས་གསུངས་སོ།",
    "ཡི་གེ་དྲུག་ཅུ་རྩ་བདུན་པ་ན་དབྱངས་ཡིག་གཉིས་པ་ཨཱ་རིང་པོ་དང་ཡང་དག་པར་ལྡན་པ་སྟེ་སྦྱར་བ་ནི་རྣལ་འབྱོར་མ་ཡི་དགོངས་པ་ཀུན་སྐོང་བ་འདི་ཉིད་ཡིན་པར་ཐེ་ཚོམ་མེད་དོ།",
    "ཡི་གེ་ཀུན་ལ་མཛེས་པ་ནི་འདི་ཉིད་ཡིན་པར་ཐེ་ཚོམ་མེད་དོ།",
    "བདུན་ཅུ་རྩ་བཞི་བ་ཧ་ཉིད་ནི་དབྱངས་ཡིག་གཉིས་ཨཱ་དང་སྦྱང་བ་དག་གདོད་ནས་དངོས་གྲུབ་གྲུབ་པར་བྱེད་པ་ཡིན་པར་ནི་དེ་བཞིན་གཤེགས་པའི་ཞལ་ནས་གསུངས་སོ།",
    "ས་བོན་གྱི་སྔགས་འདི་ནི་ལྷ་རྫས་ཀྱི་མཆོག་མཁའ་འགྲོ་མ་ཡིས་མཛེས་པར་འདོད་དོ།",
    "ཡི་གེ་བརྒྱད་ཅུ་རྩ་གཅིག་པ་ས་ནི་དབྱངས་ཀྱི་བཞི་པ་ཨཱི་དའི་མཐའ་ཨུ་ཡིས་ཁྱད་པར་དུ་བྱེད་པའི་མུའོ།",
    "འདི་ནི་གདོད་མ་ནས་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དངོས་གྲུབ་ཀུན་ལ་འཇུག་པར་བྱེད་པའོ།",
    "འདི་ནི་དངོས་གྲུབ་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "སྔགས་ཀྱི་རྗེས་གནང་བྱ་ཚུལ།",
    "དེ་རྣམས་གཅིག་ཏུ་སྡོམ་པར་བྱེད་པ་ནི་འཁོར་ལོ་བདེ་མཆོག་ཡིན་པར་འདོད་དོ།",
    "ཅེས་པར་འགྱུར་ཏེ།",
    "གསུམ་པ་ནི་རྗེའི་རྒྱུད་ཀྱི་ཊིཀྐ་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ལ་སྔགས་ཀྱི་དེ་ཉིད་ཤེས་དགོས་པར་བསྟན་པ།",
    "བཟླས་པའི་གྲངས་ལས་ཁྱད་པར་ཅན་འགྲུབ་པ་ལ་ནི།",
    "རྩོད་ལྡན་བཞིར་རིམ་པ་བཞི་ནི་སྔ་མ་ལས་ཕྱི་མའི་དུས་སུ་སྔགས་གྲངས་དེ་ཉིས་འགྱུར་དུ་བཟླ་དགོས་པར་གསུངས་པ་ལྟར་ཏེ།",
    "ལྷག་མ་གཞན་དུ་ཤེས་པར་བྱའོ།",
    "དྲི་ཟ་ཐམས་ཅད་གྱི་སྐྱེ་གནས་ཐམས་ཅད་ལན་གཅིག་དྲན་པ་ཙམ་གྱིས་གསོད་པར་བྱེད་དོ།",
    "ཆར་ཆེས་པའི་ཚེ་ཟློག་པར་བྱེད་པ་ནི་གུ་གུལ་སོགས་རྫས་གསུམ་གྱི་བདུག་པས་ཀླུའི་རས་རིས་ལ་བདུག་པ་དང་།",
    "རྒྱ་མཚོར་ཕྱིན་ན་རྩ་སྔགས་འབུམ་བཟླས་ན་རྒྱ་མཚོ་སྐེམ་པར་བྱེད་དོ།",
    "ཆུ་བོའི་རྒྱུན་ཕྱོགས་ལས་བཟློག་སྟེ་འབབ་པར་སྟོན་པ་ནི་ཁབ་ལེན་ལ་ཁ་ཊྭཱཾ་ག་བྱས་ནས་རྩ་སྔགས་ལན་བདུན་བཟླས་ཏེ།",
    "རྩ་བའི་གསང་སྔགས་འདི་ལ་བཟླས་བརྗོད་འབུམ་བྱས་ཏེ།",
    "ཕ་རོལ་གྱི་སྔགས་ཀྱི་ནུས་པ་ཐམས་ཅད་འཕྲོག་པར་བྱེད་པ་དང་།",
    "གཞན་གྱི་དངོས་གྲུབ་ཐམས་ཅད་འཕྲོག་པར་བྱེད་པའི་སྤེལ་ཚིག་དང་བཅས་ཏེ་རྩ་སྔགས་བཟླས་ན་དེ་བཞིན་དུ་འགྱུར་རོ།",
    "ཁྲོས་པས་རྩ་སྔགས་ལ་རཀྟ་ཨཱ་ཀཪྵ་ཡ་ཛ་ཞེས་བཏགས་ཏེ་བཟླས་ན་གནོད་བྱེད་དེའི་ཁྲག་འདྲེན་པར་བྱེད་དོ།",
    "ཁྲག་སླར་ཡང་གཏོང་བར་བྱེད་པར་འདོད་ན་སྔགས་སྤེལ་ཚིག་དང་བཅས་པས་བཟླས་ན་དེ་བཞིན་དུ་འགྱུར་རོ།",
    "སྔགས་རྫས་ཀྱིས་གཟུགས་སྣ་ཚོགས་པར་འདོད་ན་སྣང་བར་བྱེད་ཅིང་།",
    "ལག་པ་གཡོན་པར་ཟླ་བའི་འོད་ལྟར་དྲི་མ་མེད་པའི་འཁོར་ལོ་བཀོད་ནས།",
    "ལག་པའི་སྔགས་ན་ག་པོར་བྱས་ནས་བདུད་རྩིའི་བསྟན་པས་དེ་ཡང་དུག་ཏུ་བྱེད་དོ།",
    "ཟླ་བ་སྟེ་ཆད་ཟླ་བའི་འོད་ལྟར་དྲི་མ་ཆེད་པར་བསམས་ནས་ཆུ་སྟེ་འོ་མར་བྱེད་པ་དང་།",
    "ཀ་རཎྜའི་འབྲས་བུ་སོགས་ལག་པ་སོགས་ལ་བྱུག་ན་དྲི་ཐམས་ཅད་འཕྲོག་པར་བྱེད་ཅིང་།",
    "ཕྱག་རྒྱ་དང་འདུ་བ་ན་ལག་པ་གཉིས་བརྐྱང་ནས་སྙོམས་པར་ཞུགས་ཏེ།",
    "དྲན་པ་ཙམ་གྱིས་གསོད་པར་བྱེད་པ་དང་ཞེས་པ་ནི་དྲག་པོའི་རྫས་དང་འཁོར་ལོ་ལ་བརྟེན་ནས་བསྒྲུབ་བྱ་མྱུར་དུ་འཆི་བར་བྱེད་པའོ།",
    "ས་འོག་རྣམ་པར་གཤེགས་པ་དང་ནི་རྡོ་རྗེ་རྩེ་གཅིག་པ་གསོར་ཞིང་སྔགས་བཟླས་ཏེ་ས་ལ་བསྣུན་ནས་འགས་ཤིང་འདྲལ་བའོ།",
    "འདོད་ན་དེ་ཟློག་པར་ཡང་བྱེད་དོ།",
    "ལྷ་ཐམས་ཅད་ཀྱི་གཟུགས་བརྙན་གང་བྱེད་དུ་གཞུག་གཞི་དུར་ཁྲོད་ཀྱི་རས་ལ་བྲིས་པའི་འཁྲུལ་འཁོར་དང་རྫས་སྦྱོར་ལ་བརྟེན་ནས་ལྷའི་གཟུགས་བརྙན་གང་བྱེད་པར་འགྱུར་བའོ།",
    "དངོས་གྲུབ་སྒྲུབ་པ་ལ་ཆ་ལུགས་ཀྱི་ཁྱད་པར་གྱི་བཏུལ་ཞུགས་མི་དགོས།",
    "ཞི་བའི་བསམ་པས་སྔགས་འོད་ཟེར་དཀར་པོ་སྔ་མ་བཞིན་དུ་བསྒྲུབ་བྱ་ལ་ཕན་པར་བསམས་ཏེ་བཟླས་ན་སླར་འཚོ་བར་བྱེད་དོ།",
    "གསང་སྔགས་ཀྱི་དེ་ཉིད་ཤེས་པ་འདི་མེད་པ་རུ་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་དང་ནི་འཇིག་རྟེན་པའི་དངོས་གྲུབ་ཀྱི་བདེ་བ་དག་མི་སྟེ་སྒྲུབ་པ་པོ་ཡིས་ཐོབ་པར་མི་འགྱུར་རོ།",
    "འབྲས་བུ་ཁྱད་པར་ཅན་འཐོབ་པར་མི་འགྱུར་རོ།",
    "གསང་སྔགས་འདི་ནི་དངོས་གྲུབ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་པ་སྟེ་འདོད་པའི་ཡུལ་ལ་རང་བཞིན་ཤེས་པའི་སྒོ་ནས་སྤྱོད་པའི་ཐབས་ལ་བརྟེན་ནས་ཡིན་ནོ།",
    "སྒྲུབ་པ་པོས་སྐུ་གསུམ་འགྲུབ་པར་བསྟན་བའོ།",
    "དྲན་གསལ་ལས་ཧེ་རུ་ཀའི་སྐུ་གྲུབ་ཅིང་དེ་ནས་སྒྱུ་མའི་སྐུ་དེར་མཉམ་པར་བཞག་པ་ལ་གནས་པ་དེའི་ཚེ།",
    "རྣལ་འབྱོར་བ་བདག་ཉིད་འབྲས་བུའི་ཤྲཱི་ཧེ་རུ་ཀར་ནི་འགྲུབ་པར་འགྱུར་བ་འདི་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "རྟ་རྒའི་མར་དང་ཚིལ་ཆེན་ལ་སྔགས་ཁྲི་བཟླས་ནས་རྐང་མཐིལ་ལ་བྱུགས་ན་ནམ་མཁའ་ལ་འགྲོ་ཞིང་འོང་བ་ལས་གཞན་དུ་མི་འགྱུར་བ་སྟེ་ངེས་པར་འགྱུར་རོ།",
    "ཚིག་བདེན་པར་སྨྲ་བ་དང་།",
    "ཡིད་ཁྲོ་བ་མེད་པར་གྱུར་བ་དང་།",
    "དེས་དེ་རྗེས་སུ་དཔག་པར་བྱའོ།",
    "ཨོཾ་ཧཱི་ཧ་ཧ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཅེས་པར་འགྱུར་རོ།",
    "ལྷ་དང་ལྷ་མ་ཡིན་དང་གནོད་སྦྱིན་དང་སྲིན་པོ་དང་ཀླུ་དང་དྲི་ཟ་དང་མིའམ་ཅི་རྣམས་གང་འདོད་པ་དེ་འགུག་པར་བྱེད་དོ།",
    "གསེར་དངུལ་ཟངས་མའི་ལྕགས་གསུམ་གྱིས་དཀྲིས་པ་བྱས་ནས་ཡང་དེ་ལྷག་པར་གནས་པ་སྟེ་རབ་གནས་བྱའོ།",
    "སྐར་མ་རྒྱལ་གྱི་དུས་ལ་བབ་པ་ན་དེ་ལྟར་བྱས་པ་དེ་དཔལ་ཧེ་རུ་ཀའི་ཞལ་དུ་བཅུག་པ་སྟེ།",
    "ལུས་ཀྱི་གྲིབ་མ་མེད་པར་འགྱུར་ཏེ་ལྷ་རྣམས་ཀྱིས་ཀྱང་མི་མཐོང་ན།",
    "དམིགས་པ་དང་བཅས་པས་མཉེས་ནས་སྔགས་མང་བཟླས་ན་དེའི་ཁྲག་འགུག་ཅིང་འདྲེན་པར་བྱེད་དོ།"
  ]
}