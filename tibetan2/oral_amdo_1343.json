    "དེ་དེའི་ནུབ་མོ་འདས་ནས་སྔ་དྲོ་ལྔ་པ་ལ་བཙུན་མོའི་འཁོར་གྱི་ནང་དུ་སོང་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སེན་མོའི་མཆོད་རྟེན་གང་ན་ཡོད་པ་དེར་སོང་ནས་འགྲེང་བཞིན་དུ་ཉིན་མཚན་འདས་པར་བྱས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སེན་མོའི་མཆོད་རྟེན་གང་ན་ཡོད་པ་དེར་སོང་ནས་འགྲེང་བཞིན་དུ་ཉིན་མཚན་འདས་པར་བྱས་སོ།",
    "རྒྱལ་པོ་དཔའ་བས་བྱིན་སྐྱེད་མོས་ཚལ་དུ་འགྲོ་བ་མཐོང་སྟེ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "དགེ་སློང་དེ་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་ཏེ།",
    "སྐར་མ་དག་གིས་བསྐོར་བ་བཞིན།",
    "རྒྱལ་པོའི་བུ་མོས་མདུན་བདར་བས།",
    "ཇི་ལྟར་གསེར་གཟུགས་རི་མོ་དག།",
    "མཁས་པས་རི་མོ་བྲིས་པ་དང་།",
    "འདོད་ཁམས་འཐབ་བྲལ་མཆོག་གི་ལྷ་བཞིན་དུ།",
    "དགེ་སློང་ཁྱོད་ནི་མི་རྟག་ནམ་ཡང་མ་གྱུར་ཅིག།",
    "དེ་བཞིན་བདག་ཅག་བུད་མེད་དངོས་པོ་ཀུན་སྤངས་ཏེ།",
    "དེ་དག་ཐམས་ཅད་སོར་བཅུའི་ཐལ་མོ་སྦྱར་བྱས་ནས།",
    "ཁྱིམ་བདག་མཁར་གྱི་རྒྱལ་པོ་དག་གི་མི།",
    "མཚན་མོ་ཟླ་བ་སྐར་ཚོགས་དབུས་ན་ཡང་།",
    "དེ་དག་གི་ནི་བསྔགས་པ་བསྐལ་པ་བརྒྱས།",
    "འཇིག་རྟེན་རབ་མཆོག་གི་ནི་སྤུ་གཅིག་ཀྱང་།",
    "ཡེ་ཤེས་དག་གིས་གནས་ཀྱང་ཤིན་ཏུ་བསྟན།",
    "གང་གི་ཐུགས་སྲས་འདི་འདྲ་མངའ་བ་ཡི།",
    "རྒྱལ་པོའི་བུ་མོ་གཞོན་ནུ་ཐམས་ཅད་དགའ།",
    "གཙུག་གི་ནོར་བུ་དོ་ཤལ་མཛེས་པ་དང་།",
    "ཀྱེ་མ་བཙུན་མོའི་འཁོར་འདི་དག་ནི་ལོག་པར་ཞུགས་ཏེ།",
    "སྐྱེ་བོའི་ཚོགས་ཀྱང་ལོག་གོ་སྙམ་མོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "དགེ་སློང་དེ་རྒྱལ་པོའི་ལམ་ན་འདུག་པ་དེའི་མིག་ཏུ་རྡུལ་སོང་བ་དང་།",
    "དགེ་སློང་འདི་ཆགས་པའི་སེམས་ཀྱིས་བཙུན་མོའི་འཁོར་ལ་བལྟས་ཏེ།",
    "འདིས་མིག་གིས་ཀྱང་བརྡ་བྱས་སོ།",
    "དགེ་སློང་འདི་ལ་སྲོག་གཅོད་པར་བྱེད་པ་སུ་ཡོད་སྙམ་མོ།",
    "བདག་གི་བུ་དག་ཀྱང་བཀའ་མི་ཉན་ཏེ།",
    "ད་དགེ་སློང་འདི་སྲོག་དང་བྲལ་བར་བྱེད་པ་སུ་ཡོད་སྙམ་མོ།",
    "མོས་པ་དང་།",
    "དགའ་བྱེད་འདིས་དགེ་སློང་འདི་སྲོག་དང་བྲལ་བར་བྱེད་དོ་སྙམ་མོ།",
    "ཁྱོད་ལ་བྱ་དགའ་ཆེར་སྦྱིན་ན།",
    "དགའ་བྱེད་ཁྱོད་དགེ་སློང་འདི་སྲོག་དང་བྲལ་བར་བྱེད་ནུས་སམ།",
    "འདིས་ཆགས་པའི་སེམས་ཀྱིས་ངའི་བཙུན་མོའི་འཁོར་ལ་བལྟས་ཀྱིས།",
    "སྐྱེད་མོས་ཚལ་མཆོག་ན་འདུག་པ་མི་དགའ་མི་རྩེ་ཡོངས་སུ་མི་སྤྱོད་དེ།",
    "སྐྱེད་མོས་ཚལ་ནས་དེར་ལོག་ནས།",
    "སྟེང་གི་བར་སྣང་ལས་ལྷའི་བུ་བརྒྱ་ཁྲིས་སྒྲ་སྐད་དབྱངས་ཅིག་ཏུ་སྨྲས་པ།",
    "བར་སྣང་ལ་ལྷ་དག་གི་སྒྲ་ཐོས་ནས་ཤིན་ཏུ་འཇིགས་ཤིང་སྐྲག་ནས།",
    "རབ་ཏུ་དགའ་བར་བུད་མེད་ཚོགས་རྣམས་དང་།",
    "བུད་མེད་ཚོགས་རྣམས་རབ་ཏུ་དགའ་གྱུར་ཅིང་།",
    "ཐམས་ཅད་སོར་བཅུའི་ཐལ་མོ་སྦྱར་བྱས་ནས།",
    "བདག་གི་སེམས་ནི་རབ་ཏུ་ངན་གྱུར་ཏེ།",
    "བུད་མེད་ཚོགས་རྣམས་དགའ་ཞིང་སྒྲ་ཡང་འབྱིན།",
    "བདག་གིས་དེར་ནི་གཏུམ་པའི་ཚིག་སྨྲས་ཏེ།",
    "བུ་སྟོང་དག་ལ་ད་ཉིད་ཁྱོད་སོང་ལ།",
    "དེ་ནས་དགེ་སློང་ཚོགས་གཞན་རབ་མང་བ།",
    "རྒྱལ་པོའི་ཁབ་འདིར་ཁྱོད་བཞུགས་རིང་ལོན་ཡང་།",
    "རྒྱལ་བ་མཆོག་གི་བསྟན་པ་འཇིག་པའི་ཚེ།",
    "ཁྱོད་ཀྱི་སྲོག་གི་བར་ཆད་འགྱུར་དུ་དོགས།",
    "བདག་གིས་དངོས་སྡིག་ཤིན་དུ་མི་ཟད་བགྱིས།",
    "བདག་གིས་ཤིན་དུ་ལས་ངན་བགྱིས་པས་ན།",
    "དེད་དཔོན་སྟོབས་བཅུ་ཉོན་མོངས་མེད་པ་རྣམས།",
    "ཁྱུ་མཆོག་གྱུར་ཅིང་འཇིག་རྟེན་རི་མོར་བྱས།",
    "དག་ཅིང་རབ་རིབ་མེད་པའི་མིག་གིས་བལྟ།",
    "བསམ་གཏན་རྟེན་ཅིང་ཤེས་རབ་ཕ་རོལ་སོང་།",
    "ཁྱོགས་དང་སྔས་རྣམས་ཀྱང་ནི་དེ་བཞིན་ཏེ།",
    "དེ་བཞིན་གནས་དང་བུ་དང་བུ་མོ་དང་།",
    "རོལ་མོའི་ཆ་བྱད་སྣ་ཚོགས་ཐོགས་ནས་ནི།",
    "བུད་མེད་འདུ་ཤེས་སྐྱེས་པར་འདུ་ཤེས་མེད།",
    "དེ་ཡང་ཉོན་མོངས་པ་ནི་ཆེན་པོ་ཡིན།",
    "མཐའ་དག་གི་ནི་གཉིས་པོ་ཡོངས་སྤངས་ནས།",
    "རོལ་མོ་ཤིན་ཏུ་ཐབས་ལྡན་ཡིད་འོང་གྲགས།",
    "གྲུབ་པའི་བུ་མོ་རྟག་ཏུ་གར་ཡང་བྱེད།",
    "གཟུགས་བཟང་གཟུགས་འབར་བ་ཡི་ཤིང་གིས་དཀྲིས།",
    "དེ་དག་སྡིག་བགྱིད་བདག་གི་སྐྱབས་མཛོད་ཅིག།",
    "མི་མཁས་བདུད་ཀྱི་བཞོན་པས་སོང་།",
    "བསྐྱེད་མོས་ཚལ་གྱི་སར་ནི་བྱུང་བར་གྱུར།",
    "དཔལ་དང་གཟི་བརྗིད་དག་གིས་མཛེས་པ་ནི།",
    "འདི་ནི་བདག་གི་སྲིད་ལས་བསྐྱོད་སྙམ་སྟེ།",
    "དེ་ན་ང་ཡི་བུ་མོ་ལྔ་བརྒྱ་དག།",
    "ང་ཡི་བུད་མེད་ཅིག་ནི་བརྒྱད་ཁྲི་ཡང་།",
    "ང་ཡི་བཙུན་མོའི་མདུན་ན་འདུག་པ་ཡི།",
    "བསྐྱེད་མོས་ཚལ་དུ་དེའི་མོད་ལ་བྱུང་།",
    "དེ་ཡི་རྩེད་མོ་དགའ་བར་མ་གྱུར་ཏོ།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱིས་མི་དགེ་སྡིག་མངས་བགྱིས།",
    "བདག་གིས་མེ་ཏོག་ཟླ་བ་བཀྲོངས་པ་ནི།",
    "དེ་ནི་འདོད་པའི་དོན་ཕྱིར་བདག་གིས་བཀྲོངས།",
    "དེ་ནི་འདོད་པའི་དོན་ཕྱིར་བདག་གིས་བཀྲོངས།",
    "དགེ་སློང་བདག་གིས་འདོད་པའི་དོན་ཕྱིར་བཀྲོངས།",
    "དེ་ནི་འདོད་པའི་དོན་ཕྱིར་བདག་གིས་བཀྲོངས།",
    "དེ་ནི་ཅི་སླད་བདག་གིས་འདོད་ཕྱིར་བཀྲོངས།",
    "ཉོན་མོངས་མེད་ཅིང་རྣམ་དག་ཡེ་ཤེས་ཅན།",
    "དེ་དག་ཀུན་ལ་ཐལ་མོ་སྦྱར་ཏེ་སྐྱབས་སུ་མཆི།",
    "ཁྱོད་ལ་རྣམ་པ་མང་པོ་གོ་བ་གྱིས།",
    "ཁྱོད་ཀྱི་སྲོག་གི་བར་ཆད་བྱུང་ད་རེ།",
    "ཁྱོད་ནི་གང་གི་དོན་དུ་བྱོན་པ་ཡི།",
    "གྲུབ་པའི་རིགས་འཛིན་གནོད་སྦྱིན་མཆོག་གིས་བསྲུངས།",
    "བགྱི་བ་གང་བགྱི་ཁྱོད་ནི་འདིར་བྱོན་པ།",
    "ཁྱོད་ཀྱི་ཚིག་ཐོས་ནས་ནི་བཀའ་བཞིན་བགྱིད།",
    "བདག་ནི་མགོན་མེད་ཁྱོད་ཀྱི་སྐྱབས་སུ་མཆི།",
    "རང་གི་སྲོག་ཀྱང་བཏང་སྟེ་འདིར་བྱོན་ན།",
    "བདག་གིས་དཔའ་བོ་དུམ་དུ་དུམ་བུར་བཅད།",
    "བདག་ནི་འཇིགས་སྐྲགས་ཁྱོད་ལ་ཅི་གསོལ་བ།",
    "ཉོན་མོངས་བྱེད་པ་སྡིག་སེམས་ཅི་རུ་རུང་།",
    "མེ་ཏོག་ཟླ་མཛེས་བདག་གིས་ཅི་ཕྱིར་བཀྲོངས།",
    "ཀྱེ་མ་གཟུགས་དང་དེས་པ་བདག་གི་ཡོན་ཏན་ལྡན།",
    "བདག་ཅག་བོར་ནས་ཁྱོད་ནི་གང་དུ་བཞུད་པར་མཛད།",
    "ལྷ་ཁྱོད་བཞེངས་ཤིག་བདག་ལ་ཐུགས་བརྩེར་མཛད་དུ་གསོལ།",
    "ཁྱོད་ཀྱིས་ཡུན་རིངས་བཟོད་པ་བསྒོམས་པ་དང་།",
    "མཁས་པ་བཞེངས་ལ་བདག་གི་ཁྱིམ་དུ་བཞུད།",
    "ལྷ་ཁྱོད་ལུས་ནི་གཅད་པར་མི་ནུས་ཏེ།",
    "ཁྱོད་ཀྱི་ལྷ་ཡི་ལུས་འདི་མི་ཤིགས་ཀྱིས།",
    "མཁས་པ་ཁྱོད་དེང་སྒྱུ་དག་མ་མཛད་ཅིག།",
    "ལྷ་ཁྱོད་སྒྱུ་མཛད་བཞུགས་པ་ག་ལ་གདའ།",
    "བདག་གི་སེམས་དམྱལ་སྒོ་ནི་གཅད་དུ་གསོལ།",
    "ངན་སོང་སྐྱེས་པ་རྣམས་ཀྱི་རྟེན་དང་དཔུང་།",
    "བདག་གི་བདེ་འགྲོ་སྒོ་ཡང་དབྱེ་བར་གསོལ།",
    "མགོན་པོ་ཁྱོད་ནི་དགུང་བདུན་བཤོས་མ་གསོལ།",
    "རེ་ཤིག་དེང་བཞེངས་བདག་གི་བཤོས་གསོལ་བཤོས་གསོལ་རིན་ཆེན་ལྡན་པ་འདིར།",
    "ཀྱེ་མ་ཚུར་སྤྱོན་ཁྱོད་སྨོན་མྱུར་གྲུབ་ཤོག།",
    "དགེ་སློང་རྣམས་ལ་ཕན་ཕྱིར་ཁྱོད་སྟོན་ཅིག།",
    "ཚིག་གི་ལམ་དང་བྲལ་བའི་གཟུངས་དེ་ཡང་།",
    "ཀྱེ་ཀྱེ་ཁྱོད་ནི་བཞེངས་ལ་བདག་ལ་ཡང་།",
    "ཁྲག་ཁྲིག་རྣམས་ཀྱང་ཞི་བའི་གྲོང་དུ་ཁྱོད།",
    "རབ་སྦྱིན་དཀའ་ཐུབ་བཟང་པོ་ཁྱོད་བཞེངས་ཤིག།",
    "ཀྱེ་ཀྱེ་འཇིག་རྟེན་དག་ནི་ཐེ་ཚོམ་གི།",
    "མེ་ཏོག་ཟླ་བ་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "ཡེ་ཤེས་སྡོང་པོ་མཚུངས་མེད་ཁྱོད་བཞེངས་ཤིག།",
    "བཞེངས་ལ་ཤིང་གི་དྲུང་དུ་འཚང་རྒྱ་མཛོད།",
    "བཞེངས་ཏེ་བདག་ལ་གཟིགས་ཤིག་ཐུགས་རྗེ་ཅན།",
    "གྲགས་པ་མཐའ་ཡས་བདག་གིས་ཚིག་གསོན་ཀྱེ།",
    "བཞེངས་ལ་མྱུར་དུ་བདག་གི་རེ་རྫོགས་མཛོད།",
    "ཁྱོད་འདིར་དུམ་བུ་དུམ་བུར་མ་བཞུགས་ཤིག།",
    "གྲོང་འདི་སྐྱེས་པ་བུད་མེད་ཚོགས་རྣམས་ཀྱང་།",
    "ཁྱོད་མཐོང་ཐམས་ཅད་ཤི་བཞིན་ས་ལ་འགྱེལ།",
    "ཐུགས་རྗེ་མཆོག་གི་སྤྱན་གྱིས་དེ་ལ་གཟིགས།",
    "གང་གི་སླད་དུ་བྱམས་པ་བསྒོམས་པ་དང་།",
    "ཁྱོད་ཀྱི་ཐུགས་རྗེས་བཏང་སྙོམས་དགའ་བ་ཡང་།",
    "དགེ་སློང་བདག་གིས་བསད་པ་སྡིག་གི་ལས།",
    "ཤིན་ཏུ་མཛེས་པར་མཆོད་རྟེན་བདག་གིས་བྱས།",
    "བུ་དང་བུ་མོ་བུད་མེད་ཁྱིམ་བདག་དང་།",
    "སྤོས་མཆོག་དག་ཀྱང་ཐོགས་ནས་ཁྱོགས་བཅས་ཏེ།",
    "ཤིན་དུ་བཟང་དང་འབྲུ་མར་དག་གི་བསྲེགས།",
    "དགེ་སློང་དག་གིས་དེ་ཡང་དེར་བསྲེགས་ཏེ།",
    "དེ་ནི་དེ་ཚེ་བདག་གི་ལུས་ཞིག་ནས།",
    "དེ་ཚེ་བདག་གིས་དེ་དག་མ་མཉེས་བྱས།",
    "རྒྱལ་པོ་མཆོག་གིས་སྔོན་གྱི་ལས་བཤགས་ཀྱང་།",
    "བུ་དང་ཆུང་མ་མིག་དང་རང་གི་ཤ།",
    "དེ་དག་ནམ་ཡང་ངན་སོང་སར་མི་འགྲོ།",
    "བུད་མེད་ཚོགས་དང་རྒྱལ་རིགས་མང་པོ་དང་།",
    "ཐམས་ཅད་སྟོབས་བཅུ་ཉོན་མོངས་མེད་པར་གྱུར།",
    "རང་གི་ལུས་དང་སྲོག་ལ་ལྟོས་པ་མེད་པ་གཞན་གྱིས་དོན་ཡོངས་སུ་སྒྲུབས་ཤིང་།",
    "ཡུམ་ཤོ་མོ་ཟ་ཚེ་ལྕམ་ཞེས་བྱ་བ་ལ།",
    "སྲས་གསུམ་མཁྲུངས་པའི་ཆེ་བ་རྒྱ་པ་སེ་རེ།",
    "ས་མོ་ལུག་གི་ལོ་ལ་ངོ་མཚར་བའི་བལྟས་མང་པོ་དང་བཅས་ཏེ་སྐུ་མཁྲུངས།",
    "འཇིག་རྟེན་པ་དང་སྒོ་བཏུན་ནས་མཆིམས་ཇོ་སྲས་ཀྱི་བུ་མོ་ཁབ་ཏུ་བཞེས།",
    "རེ་ཤིག་ན་ཇོ་མོ་མི་རྟག་པར་གྱུར་པས་རྐྱེན་བྱས་ཏེ།",
    "དགས་པོ་དབྲོངས་ཁར་དགེ་ཤེས་མར་ཡུལ་བློ་ལྡན་ཤེས་རབ་ལ་སྤྲེའུ་ལོ་གུང་ལོ་ཉི་ཤུ་རྩ་དྲུག་གི་དུས་སུ་དགེ་ཤེས་རྨུ་ལོའི་ཁང་པར་ཆིག་རྫོགས་མཛད།",
    "སྣང་བ་ཐམས་ཅད་འཇའ་ཚོན་ལྟར་བན་བུན་དུ་སོང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་མགོ་ནོན་ནས་ངོས་མི་ཟིན་པ་དང་།",
    "སྦྲང་སྟོན་ན་རེ་ང་ལ་འདོད་ཡོན་འདི་ཁོ་ན་གནོད་པར་བྱུང་།",
    "ཁྱེད་ལ་ཇི་ལྟར་བྱུང་བྱས་པས་ང་ལ་ནི་བུད་མེད་ལ་བདེ་བ་ཡོད་སྙམ་པ་ལ་རྟེན་ནས།",
    "ཁོང་དེ་ལྟར་འདུག་སྙམ་པའི་འཕྲོ་ལ་ཡང་ཏིང་ངེ་འཛིན་དུ་ཆམ་ཆམ་སོང་གསུང་།",
    "ནེའུ་ཐང་བདེ་མོ་ལ་གོམ་པ་འདོར་བ་དང་།",
    "མགོན་པོ་གྲི་ཁུག་མ་ཞུས་པས་དེའི་ནུབ་མོ་རང་ནས་ཞལ་གཟིགས།",
    "དེ་ནས་དགེ་ཤེས་རྒྱ་ཡོན་བདག་གི་སྙན་པ་ཐོས་པས་ཤིན་ཏུ་སྤྲོ་བར་བྱུང་སྟེ་སྤྱན་སྔར་ཕྱིན།",
    "སྔར་གྱི་བདེ་གསལ་ཏེ་ཆུང་དུ་སོང་།",
    "ཁོང་གི་ཞལ་ནས་ང་ལ་ཇོ་བོའི་གདམ་ངག་དགེ་ཤེས་སྟོན་པས་ཀྱང་བར་དུ་མ་ཆོད་པ།",
    "ཁོང་རང་གིས་ཡབ་མེས་ཀྱིས་བརྩིགས་པའི་སེར་ཁ་བྱ་བའི་གཙུག་ལག་ཁང་ཅིག་ཡོད་པ་དེར་བྲང་ཁང་ཅིག་བརྩིགས།",
    "གཉིད་ཐུན་ཆུང་རེ་ལས་མི་འབྱུང་སྟེ།",
    "རོལ་མོའི་སྒྲ་རྣམས་ཐོས་པ་དང་།",
    "འབྲུག་གི་སྒྲ་ནི་སྒྲོག་པ་དང་།",
    "ལྷ་མོའི་ཀླུ་དབྱངས་སྒྲོག་པ་དང་།",
    "དེ་ནས་ནམ་ཟླ་དཔྱིད་གི་དུས་སུ།",
    "རྗེ་བཙུན་ཐུགས་རྒྱུད་ནི་ཏིང་ངེ་འཛིན་དུ་སོང་།",
    "ཕྱག་གིས་ཡི་དགས་ལ་ཆུ་སྦྱིན་བྱེད་ཅིང་ཡོད་ཙ་ན།",
    "ཚོལ་མ་དགོས་པར་ཟན་ཆེན་པོ་རེ་དང་།",
    "ལོ་མའི་ཚོད་མ་ཕོར་རེ་བཟའ་བཏུང་བྱ་རྒྱུ་ཡོད་ན་ཅི་ལྟོ་ཟེར།",
    "ཅིག་ན་རེ་ཡིད་སྨོན་དེ་འདྲ་ལ་བྱེད་དམ།",
    "དེ་བྱུང་ཙ་ན་གང་གིས་ཀྱང་ཕན་པ་མེད།"
  ]
}