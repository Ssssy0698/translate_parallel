    "དེ་སྟེང་དུ་དྲུག་དང་ཀླུ་ཡི་གྲསན་ཉི་མའི་གདུང་བྱེད་དག་ཀྱང་བྱང་དུ་བྱེད་པ་དག་གི་མཛད།",
    "ལུས་ལ་དབུགས་ལྷག་གང་དག་ཉིན་ཞག་སོ་སོའི་དུསསུ་འབྱུང་པ་རི་དང་རུས་རྣམས་དག་གི་གྲངས།",
    "ལྷ་མི་འབབ་འགྲོ་རྣམས་ནི་དེ་ནས་ལྟ་བ་ཉིད་འགྱུར་ཟླ་བ་ཕྱེད་བཅས་མཚན་མོ་དག་གིས་ཀྱང་།",
    "སྐྱོན་དང་ཚེས་དང་བརྒྱད་དེ་ལ་བདག་དང་ནམ་མཁའ་ཡོན་ཏན་དག་དང་གཅིག་གིས་དམན་པའི་བརྒྱ།",
    "སྒྲ་གཅན་ཟླ་བའི་ལོས་ཁྱོད་ཉི་མ་དང་བཅས་བླབཀང་བཆུ་ཚོད་ཕྱེད་ཀྱིས་རྣམ་པར་དམན།",
    "སྒྲ་གཅན་ཟླ་བའི་ལོངས་སྤྱོད་མིག་གིས་རྣམ་པར་བསྒྱུ་དེ་ཕྱོགས་ཀྱི་ལོངས་སྤྱོད་དགགས་པགས་པ་ལས།",
    "ལྷ་གསུམ་ལྡན་ལ་ནི་ནམ་མཁའ་མཁའ་སོང་རོ་དང་དགུ་དང་ཉིན་བྱེད་ལོ་ཡི་གྲས་སུ་རབ་ཏུ་གྲགས།",
    "ཞི་མ་དག་ལ་དགའ་བ་འཆར་བ་རྣམས་ཀྱི་རྨ་ཁ་ཡང་འགྱུར་ཏེ་གཟིར་བ་རྣམས་ནི་ཉོན་མོས་ཉིད།",
    "༡༦། ཕོ་ཉས་བརྗོད་བའི་དབྱངས་རྣམས་གང་དག་ངེས་པར་བཅུ་ཡིས་བསྒྱུར་ཏེ་ཁྱིམ་ཀྱི་འཁོར་ལོ་དག་གིས་བསྲེ།",
    "རལ་གྲི་ལསོགས་གདམས་འཁྲུལ་འཁོར་དག་དང་ས་གཞིའི་གནས་ལཟུང་དང་ཅོག་གི་དབྱེ་བ་ཡིས།",
    "ཐ་དད་རྣམས་ནིརྟང་བུ་ཆུགཏེར་དུས་དང་དུས་རྣམས་ཀྱིས་ཏེ་རྒྱབ་ཏུ་ཡང་ནི་གཅིག་གིས་སོ།",
    "ལྕགས་མདའི་འཛུམ་མོ་ལན་འང་འཐིལ་ཧྲག་བར་བཅས་པ་དག་ལས་ངེས་པར་ཁྲུ་གསུམ་དག་ཏུ་འགྱུར།",
    "རྒྱབ་ཀྱི་ཕྱོགས་ནས་མི་རྣམས་དག་གིས་དྲངས་ཤིང་ས་ལས་ཐོག་པ་དག་གིས་སྟེང་དུ་འགྲོ་བ་ནི།",
    "༡༤༡༩༧ ༣། མེ་དང་འོག་ཏུ་སྐྱོབས་ནི་འཁྱོག་པོར་འགྱུར་ཏེ་ཀུན་ནས་སྐབས་ཀྱི་རྣམ་བདག་གི་འཁྲུལ་འཁོར་རོ།",
    "གཅིག་ཏུ་མེ་ལ་བཙོས་པ་ནགས་ཀྱི་འབྲས་བུ་དག་དང་བཅས་པ་གང་དུ་མི་དམས་དག་གི་རྫས།",
    "དེ་ནས་སྐུ་ལསོགས་བ་སྐྱེས་ཏེ་རབ་ཏུ་བཙའ་བའི་དུས་ཀྱང་འདིར་ནི་སྤྲུལ་པ་དག་གི་སྐུ།",
    "བསགས་པ་དག་གིའོ།",
    "དེ་རྣམས་ཅུང་སེལ་གྱིས་འོག་ཏུ་འཛེམ་མཐའ་དག་གི་མཉམ་ལུས་ལ་མཉམ་གནས་དག་གིས་འཐོབ།",
    "དེ་ཡི་སྟེང་གི་མགྲིན་པའི་ཕྱོགས་སུ་གཟའ་ཡི་ཚོགས་དང་བཅས་བའི་རྒྱུན་ང་ལ་ཁོང་ཡང་གགནས།",
    "དེ་ཉིད་མུག་བྱ་གཞནས་དྲུག་གིས་རྣམ་དམན་དེ་དག་ཕྱེད་ཀྱི་དབྱེ་བས་རྣམ་པར་ཕྱེ་བ་མེད།",
    "རྣལ་འབྱོཊི་མ་དང་ཀླུ་དང་གཏུམ་མོ་བརྒྱད་ཅེས་བྱ་སྟེ་སྲིད་པ་བདེ་རྨིས་ཐམསཅད་ནས་འགྱུར་རེད།",
    "དེ་ལྟར་ད་ལོའི་སས་རྒྱས་རྒྱུད་ལ་མཁའ་ལག་མི་བདག་རྣམས་ཏེ་ལྷ་དང་ལྷ་མོ་རྣམས་ཀྱི་ནི།",
    "དུས་ནི་རྫོགས་ནའོ་ལོ་རྣམས་གསུམ་མགི་ཟླ་བ་དེ་དག་རྣམས་དང་དྲུག་གསུམ་ཟུང་དང་ཟླ་བ་གང་།",
    "ལོ་དང་ཟླ་བ་ཞག་གིས་ཀྱང་སེ་གསུམ་མ་རི་བོང་ཅན་དང་དྲུག་གསུམ་ཟུང་དང་ཟླབས་ཀྱང་།",
    "ཀཟླ་བ་ཞེས་པ་ནི་མའི་ལམ་ལ་མི་མཉམ་མཉམ་པའི་འཆེ་ཞག་རེ་རེ་འཕེལ་བས་རིམ་པས་སོ།",
    "ཉིན་མཚན་དུས་ལ་ཉི་མ་ཟླ་བས་ང་རང་རྒྱུང་དག་གིས་གང་གང་རྫོགས་པར་མི་ནུས་པ།",
    "ཆུ་ཚོད་དྲུག་བཅུ་ཉིན་ཞག་ཏུ་འགྱུར་གསུམ་གྱིས་བསྒྱུར་པ་བཅུ་ཡི་ཉིན་ཞག་དག་གིས་ཟླ་གཅིག།",
    "སྐྱེ་བ་ང་ནི་བཙའ་བའི་དུས་དང་བྱིས་བ་གཞོན་ནུ་དྲུག་གིགཙུགས་ནི་བྱེད་པ་གང་ཡིན་པ།",
    "ཟླ་ཛ་ཉི་མ་ལསོགས་ལྷ་རྣམས་འབྱུང་པ་དང་བཅས་མཚན་མོའི་ཆ་ལ་བཅོམ་ལྡན་དེ་ཡིས་འཛིན།",
    "ལྷ་སྟེང་བརྒྱད་ཀྱི་དབྱེ་བ་དག་གིས་ལྷ་ཡི་མཆོག་གི་གནས་སུ་མི་ཉིད་གཅིག་ནི་ཇི་ལྟ་ག།",
    "དངོས་བོ་སངསན་མི་ཟད་མཆོག་གི་གནས་སུ་རབ་ཏུ་འགྲོ་སྲིད་སླར་ཡང་གང་དུ་འང་སྤྱི་ལྡན་མིན།",
    "ཡེ་ཤེས་སྐྱེ་མེད་རྒྱལ་རྗེས་ཀྱི་ཉི་མ་ཉིན་མོའི་དུས་སུ་མཚན་མོའི་མཐའ།",
    "ལྷ་མིན་རིས་ཀྱི་ཟླ་བ་མཚརྣམོའི་སསུ་ཉི་མ་ཕྱེད་དང་ཉིན་མོ་དག་གི་མཇུག་ཏུའེ།",
    "༩༢། ང་མཚནམ་ཕྱེད་ནས་ཉརེ་ང་མཚན་མོའི་དུས་སུ་དེ་དག་གི་ནི་ཟ་བའི་ས།",
    "འཇིག་རྟེན་མིག་དམེ་མིག་གླས་ཏེ་ཉིན་མཚན་དུས་རྣམས་གཙོ་བོ་དག་གིས་དམན་པ་མཐའ་དག་སྟེ།",
    "སྲོག་རྩོལ་དག་ནི་པད་ཀན་ལ་འབྱུང་སླར་ཡང་དེ་དག་གཏོང་བ་མཁྲིས་བ་དག་གི་སྤྱན་ལའོ།",
    "༡༡ཎ་དག་ཁྱེད་ཀྱིསནི་སྔགས་པ་རྣམས་ཀྱི་མཆོག་གི་ལུས་ལ་དཀར་བའི་མཛེ་འཕྲོག་དེ་ལས་གཞན་ལྷ།",
    "སྒྲོན་མ་ལྔ་པོ་སྦྲང་བུའི་སྐྱགས་པ་དག་དང་བསྲེས་བ་ཟོས་ལས་མཐའ་དག་ནང་ནི་འཁྱོག་པ་སྟེ།",
    "བུད་མེད་མེ་ཏོག་ཁུ་བ་དག་དང་བསྲེས་པ་ལོ་གཅིག་ཟོསནས་རྒ་རྗེས་ཁར་སེལ་བ་ཁྱེད་ཀ་༩༢།",
    "དེ་རྣམས་ཞི་བའི་དོན་དུ་འདིར་ནི་རྣམམོང་དཀྱིལ་འཁེ་པོ་ཁྲུས་དང་སྦྱིན་སྲེག་རྣམས་སུ་རབ་ཏུ་འགྱུར་",
    "བཅོས་པའི་ཟས་ཁྲ་བ་དང་ཞོ་དང་བུ་རམ་དང་བཅས་པ་ལི་ཀ་དང་མོ་ད་ཀ་དག་དང་དྲི་དང་མེ་ཏོག་མར་མེ་བཀྲ་བ་དག་ཀྱང་འདབ་མ་རྣམས་ཀྱིས་མཚན་ལྔ་ནི་གདུ་བྱ།",
    "སྲོག་ནི་ལུས་ཀྱི་ཚད་ན་དཔག་ཏུ་མེད་བའི་སྲིད་པ་དག་གིས་རྟག་པའི་སྲོག་གིས་བླང་བའོ།",
    "དངོས་པོ་དངོས་མེད་དག་ཀྱང་ཡོད་དེ་སྐད་ཅིག་རྣམ་བྲལ་རང་བཞིན་མེད་པ་དག་གི་སྲིད་པ་ཡོད།",
    "གང་ཞིག་དེ་ཉིད་གང་ཐུག་ཅེས་བྱ་ལུས་ལ་གནས་བར་སྨྲ་བ་དེ་ནི་རང་བཞིན་དག་གིས་ཉམས།",
    "གལ་ཏེ་དེ་ལྟཡིན་ལས་ནིའཇིག་པར་གནམི་འགྱུར་མི་རྣམས་སྐྱེ་དང་སྐྱེ་བ་གཞན་དག་གིས།",
    "ཁྱོད་ནི་མགོན་པོ་ཁྱེད་ནི་བྱེད་པ་ཕན་དང་སྡིག་འཕྲོག་ཁྱེད་ནི་གོ་འཕང་ཕུམསུ་ཚེགས་པ་ཡང་།",
    "རྒྱལ་ཡས་ལྷ་ཡི་བདག་པོ་དང་བཅས་བདུད་ནི་པམ་བ་དག་ལ་ལྷ་མོ་ཁྱོད་ནི་དཔང་དུ་གྱུར།",
    "རཔ་ཛསནི་སུམ་འགྱུར་ཉེནམེར་བྱེད་པ་རི་བོང་ཅན་དང་ཆུ་སྐྱེས་རེ་ཁཱ་ཉིས་འགྱུར་རོ།",
    "མཚན་མ་རྣམས་ཀྱི་ཁ་དོག་མཐའ་དག་རྡོ་རྗེ་ཅན་གྱི་ཞལ་གྱི་པབྱབ་དག་གིས་འགྱུར།",
    "མཚེགསྣ་ལག་པ་དག་གི་མཐེ་བོའཡས་ཀྱཇམ་ཡི་ཞལ་དུ་སེན་སྲེག་དགནི་རབ་ཏུ་བྱ་གཙོ་བོའི་རྡོ་རྗེ་ཡན་ལག་གིས་ཀྱང་མདའ་བརྒྱའི་ཡམ་ཤིང་འབྲུ་དང་དུར་བམར་དང་འོ་མ་ཡིས།  དཀྱིལ་དཀྲུང་དུ་གནས་རབ་ཏུ་ཞི་ཞིང་གཡོ་བ་མེད་པའི་སེམས་ལྡན་གསང་སྔགས་རིག་པ་སྔགས་ཀྱི་སྐུ་སཔོ་དཔཚོ་ལས་ཀྱི་རྡོ་རྗེ་ཅན་གྱིས་སླར་ཡང་མེ་ལ་བསྲེག་བླུགས་དག་ག་ངེས་པར་འབུལ་བར་བྱ།",
    "དད་པ་བདུད་མི་ལྡནི་རྒྱལ་པོ་མཆོག་གི་རྡོ་རྗེས་བྱིན་གྱིས་བརླབས་པ་དག་པའི་སླད་དུའོ་། རང་གི་སྔགས་ཀྱིས་སྦྱིན་སྲེག་གྲུབ་ཅིང་རྡུལ་མ་བཏབ་སྟེ་སྔགས་ཀྱི་མཚན་མ་རབ་ཏུ་བཀོད་པན་ཟུང་དུ་ཤེལ་གྱི་བུམ་པ་དཀར་པོ་སྐུད་པ་ལྔ་ཡས་དཀྲིས་པ་རྣམས་ནི་ཡང་དག་གཞག་པར་བྱ།",
    "སློབ་དཔ་ངག་གི་ཞབས་ཀྱི་དྲུང་དུ་མཆོག་གི་བུ་ཡིས་ཡོན་ནི་དག་པའི་སླད་དུ་དབུལ་བྱ་སྟ།",
    "སྙན་དང་དྲི་དང་ལྡན་པའི་རྒྱལ་དང་རྣམ་རྒྱལ་བུམ་པ་དག་གིས་ལྷམ་མས་ཀྱིས་ཁྲུས་བྱའོད།",
    "དགནས་ནི་བུད་མེད་གསང་བའི་པདམར་རབ་གྱུར་དམ་ཚིག་དག་ལ་རྡོ་རྗེ་ཉིད་ནི་ཉེ་བའི་གནས།",
    "ཡན་ལག་ཀུན་ལ་རེག་པར་བྱེད་ཅིང་ཁརུ་ལག་པ་གནས་པ་བདག་ལ་འདུས་པ་མེད་པ་༢།",
    "ཟླ་བ་པར་པོའི་ཚིག་གསན་ནས་ནི་རྒྱལ་པའི་བདག་པོའི་རྡོ་རྗེ་ཅན་དག་གི་ཡང་སྒྲུབ་ཐབས་གསུས།",
    "གཉིས་པོ་དག་མཚནམ་གང་ཞིག་གང་གི་གཡས་ཀྱི་དང་པོའི་ཕྱག་མཐིལན་དེ་དེ་ཡི་ཕྱག་ཆུ་སྐྱེས་ན།",
    "གོ་རེ་གོགྲྭ་དང་རྟགག་ཤིན་ཏུམཆོག་ཏུ་མྱུར་མ་ཏོ་ཏ་ལ་དང་མཚོན་བྱེད་པ།",
    "རེག་དང་དགག་པ་དག་དང་འཚེ་དང་མི་ཡི་བདག་པོ་ཕུར་བུ་འདེབས་པ་དང་རྒྱག་བར་འདོད་པར་འགྱུར།",
    "ཅང་དུ་འདང་རོ་ཅུ་འགྱུར་ཏེ་ཆུ་ནི་དེ་བཞིན་ཉིད་དུ་ལུས་དང་རེག་བྱ་དག་ཏུ་འགྱུར།",
    "མཆོག་གི་རྒྱལ་བདག་དང་ནི་སྣ་ཚོགས་ཡུམ་དག་བདེ་བའི་དོན་དུ་ཕན་ཚུན་ལུས་དང་བསམ་པ་།",
    "ཡཱ་ཝཱར་ལུ་དེ་བཞིན་གླང་པོ་རྟ་དང་སང་གེ་དང་ནི་ཕག་གི་ཤིང་རྟ་དག་ལ་འགྱུར།",
    "༡༢༧དཀར་པོ་ཡིས་ནི་ཞི་དང་རྒྱས་པ་བྱེད་དེ་རང་གི་ཡིད་ལ་དམའ་པཡིས་ན་དམག་དང་པང་།",
    "བསྒོམ་དང་བཟླས་པ་དེ་བཞིན་ཉིད་དུ་རང་གི་ཡིད་ལ་བྱེད་ཏེ་སྐུ་གསུང་ཐུགས་དང་དེརྫུན།",
    "ནངས་དག་གིས་ནི་གདེངས་ཅན་བདག་པོ་ཟུང་དང་པད་མའི་འདབ་མར་གནས་པ་རྣམས་ཀྱི་མཇུག་མ་",
    "སྔགས་པས་ཐབ་ཀྱི་གཡས་སུ་ཁྲག་དང་བཅས་པ་བཛྫས་དག་གིས་སྦྱིན་སྲེག་ཉིདདཀ་བ་བྱེད་པ།",
    "སྤྱིན་སྲེག་ལྔགོས་ན་རེ་འཛིན་རལ་གྲི་འཁུར་འཁྱུག་ཅིང་འབར་ལ་མཆེ་བ་རྣོན་པ་མིག་གསུམ་ལ།",
    "པར་འགྱུར་ཏེ་མིའི་བདག་པོ་ལྷ་དང་ལྷ་མོ་མ་བུ་ཀྱི་འོད།",
    "དདལ་དྲུག་གིས་ཐུགས་ཀྱི་རྡོ་རྗེ་རྣམ་གསུམ་སྲིད་པར་གནས་པས་གཙོ་བོའི་རྣམ་པ་གཅིག་ཐུ་",
    "ཀུན་ནས་དགའ་བ་ཐམས་ཅད་རྡོ་རྗེ་ཅན་གྱི་བདེ་བ་མརྟ་པའི་གནས་ཏེ་རྡོ་རྗེཅནནི་ཐམསཅད་དག་གི་དུས།",
    "ཀློག་གི་དབྱུག་པའི་རྗེས་མཐུན་འཕོ་མེད་བདེ་བ་སྐྱེད་པར་བྱེད་མ་མཚན་ཉིད་",
    "གཉིད་ཡར་ཉིད་ནི་ས་ཀྱི་ཐུགས་ཏེ་གཉིད་ནི་འདི་ཡི་སྲིད་པའི་འཇིགས་འཇམོས་ཡི་ཤེས་ཁོནའོ།",
    "དང་པོར་ཐུགས་ཀྱི་རང་བཞིན་དེ་ནས་དབུས་མ་ལ་སན་ཉིས་འགྱུར་དག་ཀྱང་གསུང་གི་རང་བཞིནནོདོ་༡།",
    "ལྷུན་པོའི་ཕྱི་ལོ་ཚུན་འོག་གི་ས་གཞིའི་གནས་ལ་གྲུབ་པ་བརྒྱད་པོ་ཡང་དག་གནས་བད་",
    "གཙུག་ཏོར་དག་གི་མཐར་ཐུག་འདི་",
    "དེ་ཕྱིས་སྦྱིན་ལ་རྗེས་སུ་ཆགས་པ་བདེ་མཉམ་འབྲས་བུ་སར་པ་བསད་ནམས་དག་གི་ཚོགས་འདི་ནི།",
    "དེ་བཞིན་དུང་གི་ཕྱེ་མ་བརྒྱ་ཕྲག་སྦྱར་བར་གྱུར་པ་འཛིན་མུ་ཟི་དག་གིས་བསྲེས་པ་ཡང་",
    "གཟའ་རྣས་དག་གི་རྒྱུ་བ་གང་དེ་སླར་ཡང་ཅིག་ཤོས་རྣམས་ཀྱིས་རྣལ་འབྱོར་མ་ཡི་རྒྱུ་པར་བརྗོད་པ་འབྱར་མ་ཡུ་རྒྱུ་བར་བརྗོད།",
    "གང་ཞིག་ཀུན་གྱི་རྟེན་གཅིག་ཞྭ་ག་བཟང་མོ་མཆོག་གི་བྷ་ག་ཁྱོད་ལ་འདུད་ཏེ་ཁྱོད་ལ་འདུད་",
    "ཤེས་དང་ཤེས་བྱ་གཅིག་གྱུར་རྒྱལ་བ་མཆོག་གི་དམ་ཚིག་ཡན་ལག་རྣམ་པ་བདུ་གཉིས་ཀྱི།",
    "ཨཱ་ལི་ཀཱ་ལི་སྙམོས་འཇུག་ད།",
    "གང་དུ་དྲང་གི་ལུས་ལ་སྲིད་པ་མཐའ་དག་སྔགས་བཅས་པ།",
    "བདམ་དཀར་པ་བདག་གིས་ནི།",
    "ཤེས་བག་འགྲོགས་ལས་གང་གིས་དཀར་པོ་ཟག།",
    "མནར་ཏའི་འབྲས་བུ་གང་གིས་འབྱུང་།",
    "རྡོ་ཡི་ཕྱེ་མ་དག་གི་བ་ཟས་ཅན།",
    "གཞི་ཀ་ལ་ཡང་མཆོག་གི་བདེ་བ་མེད།",
    "སེམས་ནི་ཤེས་རབ་ཡེ་ཤེས་དག་གིས་སོ།",
    "རིགམའི་བརྟུལ་ཞུགས་དག་གིས་རྡོཛིནི།",
    "དེ་ཡི་ཚིག་གིས་ན་ཆེན་འདོར་བར་བྱེད།",
    "དེ་དག་རྣམས་ཀྱི་རྣམ་དག་ཚིག་གིས་ནི།",
    "དབུལ་དང་བུད་མེད་དང་བྲལ་མི་བག་འཁྲུགས་པའི་འཇིགས་དང་རྡོ་རྗེ་ཁྱུང་དང་དོན་ཉམས་རྣམས།",
    "གང་གིས་རྣལ་འབྱོར་མ་རྣམས་ཞབས་དག་འཇིག་འབྲེག་དྲན་པ་དེ་ཡང་དེ་ལས་གྲོལ་བར་འགྱུར།",
    "གང་གིས་རྣལ་འབྱོར་མ་རྣམསཞབས་བད་འཇིགས་འཕྲོག་དྲན་པ་དེ་ཡང་དེ་ལས་ཕ་རོལ་འགྲོ།",
    "བྱེད་ཅིང་མོལས་གདུག་པའི་སེམས་ལྡན་ཕྱོགས་བཅུའི་དཀྱིལ་འཁོར་རྣམས་ལ་ཡང་དག་གནས།",
    "གང་གིས་རྣལ་འབྱོར་མ་རྣམས་ཞབས་དག་འཇིགས་འཕྲོག་དྲོན་པ་དེ་ལ་སྲུང་བ་བྱེད་པར་འགྱུར།",
    "རྣལ་འབྱེ་བ་རྣམས་ཞབས་བཟང་སྒོམས་བྱེད་རྒྱུག་བསྔལ་དེ་དག་གིས་བཏང་འདོད་དང་ལྡན་པར་འགྱུར། ། དུ་མཆན་ལུང་མིག་དང་རྣ་བ་སྣ་དང་ཁ་ལུས་བརྗོད་པ་དག་ལས་མི་བཟད་དྲི་འབྱུང་ཞིང་།",
    "གང་དག་ཉིན་དང་མཚན་མོར་བུད་མེད་འགྲོགས་ལ་རྣམ་པར་ཆགས་པས་དོན་ཀུན་ཉམས་འགྱུར་ཞིང་།",
    "རྒྱལ་བ་མཆོག་གིས་མཆོད་ཅིང་བསྟོད་པ་བསྒོམས་པས་དེ་ནི་རྟེན་ཀུན་ཉམས་པར་མི་འགྱུརོ།",
    "དེ་ཡི་ལྷན་སྒེག་བདེ་བའི་གནས་དང་འགྱུར་མེད་གཅིག་འདི་དེ་དག་དེ་བཞིན་གང་གིས་དྲན།",
    "ཉོན་མོངས་མེད་ཅིང་བདུད་ཉམས་སྔོན་དུ་རྒྱལ་བས་གསུངས་པ་བསྟོད་པས་བདག་གིས་འདིར་བརྗོད་དོ།",
    "འཇིག་རྟེན་མགོན་པོ་བདག་གིས་ནི།",
    "ལྷ་དང་ཀླུ་དང་ལྷ་མོའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོང་པ།",
    "པ་དང་ཀ་ལསོགས་བ་སྔགས་ཀྱི་རིགས་དྲུག་གི་ངོ་བོ་ཉིད་ཀྱིས་གནས་པ་དང་།",
    "བསེརཚམས་དང་ཡེ་ཤེས་ཀྱི་ཚོགས་དག་ལས་ཁམས་དྲུག་གི་བདག་ཉིད་ཅན་སྐྱེས་བུ་ཆེན་པོའི་གང་ཟག་ལའོ་ཞེས་པ་དེ།",
    "སྟོང་ཕྲག་བཅུ་གཉིས་པ་ཞེས་པ་ནི་སོང་ཕྲག་བརྒྱད་ཅུ་རྩ་བཞི་ལྷག་པའི་འབུམ་ཕྲག་གསུམ་གྱི་ཡི་གེའི་ཚོགས་ཏེ་ཡི་གེ་སུམ་ཅུ་པ་གཉིས་པ་རྗེས་བསྔགས་པ་སོ་ཕྲག་བཅུ་ཙིགཉིས་ཡོད་པ་ནི་སྟོང་ཕྲག་བཅུ་གཉིས་པའོ།",
    "རྒྱུད་ནི་རྒྱུད་གཞན་དག་གིས་རྟོགས་པར་བྱ་ཞེས་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་ཕྱིར་རོ།",
    "གནམ་སོང་གི་མཐའ་དང་དཀར་པོའི་ཚེས་གཅིག་འཇུག་པའི་དང་པོའི་དབུས་སུ་བཅུ་དྲུག་པ་རྣམ་པ་ཐམས་ཅད་བའི་དོང་པ་ཉིད་དོ།",
    "ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་ནི་རང་གི་སེམས་ཀྱིས་ཡོས་སུ་བརྟགས་པའོ།",
    "ཇི་ལྟར་ཤམ་བྷ་ལའི་ཡུལ་གྱི་ཀ་ལཱ་པའི་གྲོང་གི་བདག།",
    "འདི་སྐད་བདག་གིས་ཐོས་བ་འདིས།",
    "རྣམ་བ་གང་དང་གང་དག་གིས།",
    "རྣམ་པ་དེ་དག་དེ་དག་གིས།",
    "ཕྱག་ན་རྡོ་རྗེ་དང་ཟློབཟང་ཁྱོད།",
    "དེ་ཉིད་དེ་ལ་མོས་པ་རྣས་༢ ཀྱིས་མཉན་ཞིང་ཀླགས་ཏེ་རང་གི་སེམས་ལ་བཟུང་ནས་གཞན་དག་ལ་ཡང་རྒྱ་ཆེ་རབ་ཏུ་བསན་ཏོ།",
    "ཀྱེ་རྒྱལ་པོ་ཆེན་པོ་མཆོག་གི་རྒྱལ་པོ།",
    "མང་པོའི་ཚིག་ལ་གཅིག་གི་ཚིག་དང་།",
    "ཁྱོད་ཀྱི་པགས་པ་དེ་བསན་རྒྱུད་ཀྱི་རྒྱལ་པོ་མཚེག་གི་དང་པོའི་ས་སཟླས་དམ་པའི་དངོས་པོ་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་པ་རྫུས་ཀྱི་འཁོར་ལོ་རྡོཚིག་རྣལ་འབྱའོ་ཁྱོད་ཀྱིས་དྲིས་པ་དེ་ཐམསཅད་བདག་གིས་བསྟན་པར་བྱའོ།",
    "དེ་བཞིན་དུ་དུམ་བུ་བཅུ་གཉིས་དངམཐོའི་རེས་དང་།",
    "རང་གི་བུ་ལ་བཟའ་བར་སེམས།",
    "གང་གིས་མཚན་ཡང་དག་པར་བརྗོད་བམིཤེས།",
    "ཞེས་པ་ལས་ཞེས་པ་ནི་ལུང་གི་ཚིག་གོ།",
    "དེ་དག་གི་ཕྱི་རོལ་གཡས་སུ་དམར་པོའི་བརྗེད་ཅེས་པ་ནི་གཞོམ་དུམེད་པ་དེའི་གཡས་སུ་རྣམ་པར་བཅད་པའི་མཚནམའིམངོན་དམར་པོ་འབར་བ་ཡེ་ཤེས་དམར་པོའི་འོད་ཟེར་རོན་དེ་ཡང་དཀར་པོ་ཉཔར་བཅས་པ་ཡེ་ཤེས་དཀར་པོའི་འོད་ཟེར་རོ།",
    "དེ་ནས་སྐར་མ་ཕྲ་མོ་དང་།",
    "སས་རྒྱས་ཀུན་གྱི་ཐུགས་ལ་གནས་ནི་གནམ་སྟོང་གིམཐའཆ་དང་པོ་འཆར་བའི་འཚམས་ཉིམ་མུན་པ་བཅུ་དྲུག་པའི་མཐར་ཐིག་ལེ་སྟོང་པ་འགྱུར་མེད་དྲུག་གོ།",
    "ཀྱང་ཡིག་གིས་གཞན་གསལ་བྱེད་དོ།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཡུལ་ལམཛོད་ཀྱི་འདོད་པ་དང་རིག་བྱེད་ཀྱི་གྲུབ་པའི་མཐའི་བསམལས་པ་སྣ་ཚོགས་པ་དེ།",
    "ལྷུན་པོའི་ཚད་ནི་འབུམ་ཕྲག་གི།",
    "གང་གིས་འདི་བརྗོད་པར་བྱ་བ་ལ་ལྷུན་པོ་གཞན་ཡང་ཡོད་དམཅི་ཞེན།",
    "ཆ་དྲུག་ལ་དེ་འབུམ་ཕྲག་གཉིས་གཉིས་ཞེས་པ་ནི་བདེར་བརྗོད་པའམ་བས་འོག་དང་སེར་དང་བར་དང་ནུབ་ད་ལྷོ་དང་བྱང་གི་ཆདྲུག་ལ་སའི་དཀྱིལ་འཁོར་གྱི་དབུས་ནས་འབུམ་ཕྲག་གཉིས་གཉིས་སོ།",
    "ཞེས་པ་ནི་སྔར་བརྗོད་པའི་རིམ་པས་ཕྱི་ལ་ཏུ་འཇིག་རྟེན་ཀྱི་ཁམཛད་ལ་དཔག་ཚད་འབུམ་ཕྲག་གཅིག་གང་ཡིན་པ་དེ་ཉིད་རང་གི་ལུས་ལ་རང་གི་ཁྱུ་ཡིས་ཁྲུ་གང་གི་ཚད་དུ་འགྱུར་རོ།",
    "དེ་རྣམས་ཀྱིས་ཤིག་གི་ཚད་དོ།",
    "ནུས་པའི་དབུགས་དདམ་རྫས་ཀྱི་ལོ་བརྒྱ་ཕྲག་བཅོ་བརྒྱད་པོ་བརྒྱད་ཀྱིས་རེ་རེ་བགྲོད་དེ།",
    "དབུགས་གཅིག་གིས་ཆུ་ཚོད་དུ་འགྱུར་རོ།",
    "བཞི་པ་ལ་བཞི་བའི་གནས་ན་གནས་པ་བཞི་དང་ལྷན་ཅིག་སྟེ་ཐུང་གཅིག་གིས་དམན་པའོ།",
    "བཅུ་གཉིས་གབ་རྐང་པ་གཉིས་པོ་དག་གི་བཅུའོ།",
    "རི་བོང་ཅན་ཞེས་པ་དེའི་འོག་ཏུ་གཅིག་གི་ཁྱིམ་གསུམ་ལ་ཕྱེད་ལྔམའོ་།",
    "ཁྱིམ་གཅིག་གི་ཆུ་ཚོད་ཀྱི་ཚོགས་པས་སུསུ་ལ་ལྔའོ།",
    "དཀར་པོའི་ཚེས་གཅིག་གི་བྱེད་ཕྱི་མ་ལ་སྐྱེད་པ་དཔེ་པ་ཐིམ།",
    "དགུ་པའི་ཕྱེད་སྔ་མ་དང་ཕྱི་མ་ལ་ཛྭ་ལ་ཕ་དང་ཀོལ་བ་མོ།",
    "གནམ་གང་གི་ཕྱེད་སྔ་མ་ལ་རྐང་པཞིའོ།",
    "གང་གིས་འཆི་བར་འགྱུང་པ་ཡིན།",
    "ཆུ་སྲུང་དབུགས་ནི་གང་དག་གིས།",
    "མིག་གིས་རྣམ་པསྦྱང་ཞེས་པ་ནི་ཕྱོགས་ཀྱི་ཕུང་པོའི་དོན་དུ་གཉིས་ཀྱིས་པསྦྱང་པའོ།",
    "འདིར་མཁའ་དུས་ཆུ་ཡིས་ཐོབ་པའི་སྐར་མ་ལསོགས་པ་གང་ཡིན་པ་དེ་དག་གིས་འཁོར་ལོ་སྐར་མ་ཉི་ཤུ་རྩ་བདུན་ན་ལཧཱང་ཀྱི་སྨྱུག་མ་གྱི་བདག་ཉིད་ལ་མན་པ་བྱས་པའི་འཁོར་ལམི་གདོ་རུ་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་གསལ་བའི་ཉིན་ཞག་གི་ཚོགས་སུ་འགྱུར་རོ།",
    "རང་གི་ཞིང་གི་ཁྱིམ་འབའ་ཞིག་ལ་འཐབཔ་མ་ཡིན་མི་སྐྱ་པའི་སྐར་མ་ལ་ཡང་བུ་དག་འཐབ་པར་འགྱུར་ཏེ་པ་སངས་སྐར་མནམས་ཀྱི་མག་མའི་མག་ལའོ།",
    "མ་ཀླུའི་མཐར་བྱེད་དང་བཅས་པའི་རྒྱུ་སྐར་བཅུ་གསུམ་མོ།",
    "དུམ་བུ་གསུམ་པ་པོམི་རྣམས་ཀྱི་ནི་བགྲོད་པ་དག་ལུག་གི་ཉི་མས་བཞུ་དང་ཏེ་ཆུབ་ཀྱི་སའི་དུམ་བུ་ནི་བཞི་པའོ།",
    "བཅུ་པ་ལ་ལུག་གི་ཉམས་སོ།",
    "བཅུ་གཅིག་པ་ལ་གླིང་གི་ཉི་མས་ས།"
  ]
}