    "འདི་ལྟ་བུའི་བདེ་སྟོང་ཡེ་ཤེས་མོས་པ་ཡིད་ཕྱེད་ཙམ་བསྐྱེད་ན་ཡང་འབྲས་བུ་སྟོབས་ཆེ་བར་མ་ཟད།",
    "སྤྱིར་བསམ་པ་བཟང་པོ་དུམ་རེ་སྐྱེས་ན་དེ་ཡི་འབྲས་བུ་ཆེ།",
    "དེ་གཉིས་མ་འདྲེས་པར་འདོད་ཆགས་ལྟ་བུ་དཔེར་ན་རང་གིས་ཡིད་དུ་འོང་བའི་དངོས་པོ་ཞིག་མཐོང་བ་དེ་བློ་སེམས་ནི་འདོད་པ་དང་།",
    "རྡོ་རྗེ་གསུམ་གྱི་རང་བཞིན་དུ་བྱིན་གྱིས་བརླབས་པའི་མོས་པ་དང་།",
    "ལས་སྔགས་ལས་བསྒོ་བའི་སྔགས་སོགས་མི་མཛད་པར་ཆོ་ག་ནང་བཞིན་དེ་རང་རེད་གསུངས། ཀྱེ་རྡོར་བཞི་བསྒྲགས་སྐབས།",
    "ཨ་ཁཾ་བཱི་ར་ཧཱུཾ་གིས་མཛད།",
    "དཀྱིལ་འཁོར་སོ་སོའི་མདུན་དུ་རེ་རེ་སྤྲུལ།",
    "ཡང་སྒོ་དབྱེ་སྐོར་བ་སོགས་དཀྱིལ་འཁོར་རེ་རེ་བཞིན་བྱེད་དགོས་ན།",
    "མེ་ཏོག་སོ་སོར་ཕུལ་ན་རེ་རེ་བཞིན་མིང་འདོགས་ཀྱང་སོ་སོར་དགོས་པས།",
    "ཐ་མལ་བདེན་གྲུབ་ཏུ་སྣང་པའི་སྣང་ཞེན་བཟློག་ནས་བདེ་སྟོང་གི་ཡེ་ཤེས་བསྐྱེད་ཕྱིར་ལྷ་ཡི་ཆས་སུ་འཇུག་པ་ཡིན་ཚུལ་གསུངས།",
    "དེ་ཡང་རང་གི་བློ་འཕྲུལ་པས་ཐམས་ཅད་བདེན་གྲུབ་ཏུ་སྣང་བ་ལས།",
    "རང་གི་དགྲ་ཞེས་ད་ལྟར་རང་རང་ཚོ་ལ་སེམས་དམ་སྦྲེང་ངེ་བ་འདི་ང་དང་གཉེན་འདི་ང་ཡི་དགྲ་འདི་ཟེར་བ་ཞིག་ཡོད་ཀྱང་།",
    "ཚེ་སྟོད་ཀྱི་གཉེན་ཚེ་སྨད་ཀྱི་དགྲར་སོང་བ་དང་།",
    "ཚེ་སྟོད་ཀྱི་དགྲ་ཚེ་སྨད་ཀྱི་གཉེན་དུ་སོང་བ་དེ་ཙམ་མ་ཟད།",
    "དེས་ན་ཐོབ་བྱ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱང་གཞན་ཞིག་ནས་གསར་དུ་ཐོབ་རྒྱུ་གང་ཡང་མེད་རང་གི་རྣམ་པར་ཤེས་པ་དེ་ཉིད་ལས་སྒྲིབ་དག་སྟེ།",
    "སོ་སྐྱེ་ལས་དག་པ་ཡན་གྱི་མངོན་སུམ་དུ་གྱུར་པ་ཡིན་པས་མཛད་པ་ཐུན་མོང་བ་རྣམས་ཀྱི་གདུལ་༣༩ན་བྱ་རྣམས་ལ་སྟོན་དུ་རུང་བ་ཡིན།",
    "གདུལ་བྱ་ཐུན་མོང་མ་ཡིན་པས་གསང་སྔགས་ཀྱི་སྣོད་ལྡན་ཡང་དག་པར་སྟོན་པ་ཡིན།",
    "མ་དད་པ་དང་གདུལ་བྱ་ཐུན་མོང་པར་ཐམས་ཅད་ལ་བསྟན་བྱ་མ་ཡིན།",
    "དེ་དག་གདུལ་བྱ་རང་རང་གི་སྣང་ངོར་སྲོག་ཆགས་དེ་དང་དེའི་རྣམ་པར་ཤར་བར་མཐོང་བ་ཡིན།",
    "ལྷ་རང་གི་ངོར་དེ་ལྟར་སྣང་བ་མེད་ཀྱང་།",
    "གདུལ་བྱའི་ངོར་སྣང་བ་དེ་ལྟར་རང་གི་ངོར་སྣང་བ་མེད།",
    "དེའི་དོན་ནི་ལྷ་རང་གི་ཐུགས་རྒྱུད་ཀྱི་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཡང་ཡིན།",
    "རྣམ་པ་དེ་དག་གི་ངོར་༣༩བ་བཏགས་པ་ཡིན།",
    "ཡི་དམ་རྒྱལ་བ་སྲས་བཅས་ཀྱི་ནམ་མཁའི་ཁམས་གང་བ་དེ་དག་སྐྱབས་གནས་མཐར་ཐུག་ཏུ་བསྒོམ་དགོས་དེ་ཡང་འགའ་ཞིག་གི།",
    "རྒྱས་པ་ཞག་ཞེ་ལྔ་ཉིན་རེར་དཀྱིལ་འཁོར་རེ་ཡིན།",
    "མོས་པའི་ངོར་ཞག་བཅོ་བརྒྱད།",
    "རང་གི་མོས་པ་གཙོ་ཆེ་བ།",
    "གསང་སྔགས་མོས་པས་འགྲུབ་གསུངས་པ་ལྟར་དུ།",
    "གདུལ་བྱ་རང་རང་གི་མོས་པ་གཙོ་ཆེ་རང་གི་མོས་པ་དང་།",
    "གཅིག་གིས་གཅིག་སྒྲིབ་པ་དང་།",
    "དེ་ཡང་དཀྱིལ་འཁོར་གཅིག་གི་གཙོ་འཁོར་དང་།",
    "ལམ་བགྲོད་ཚུལ་གྱི་ཁྱད་པར་ཡོད་མོད་ཀྱང་།",
    "ཐ་མ་མོས་པ་སོགས་ཀྱིས་ཀྱང་ངོ་བོར་སངས་༤༡ན་རྒྱས་པ་ཡིན།",
    "བྱད་དང་བྱུར་སོགས་དག་བྱེད་ཡིན་པས་དེ་ཡང་རང་གིས་གཡས་དང་གཡོན་སོགས་ནས་བསྐོར་བ་ནི་བགེགས་དང་།",
    "རང་རྒྱུད་ཀྱི་ཉོན་མོངས་པ་དུག་གསུམ་གྱི་རང་མདངས་ལས་སྣ་ཚོགས་པ་ཞིག་ཤར་བས།",
    "དེ་ལྟར་མ་སོང་བ་ཞིག་མཛད་དགོས་གསུངས།",
    "དེ་ནི་འཇིག་རྟེན་ན་ཡོངས་སུ་གྲགས་པ་རང་གི་ཚེ་སྒྲུབ་དང་།",
    "གཞན་ལ་ཡང་རང་གི་ཚེ་སྒྲུབ་དང་།",
    "དེ་བསྐྱེད་བྱེད་ཀྱི་གཙོ་བོ་ནི་རང་རྒྱུད་ཀྱི་ཉོན་མོངས་པ་ཡིན།",
    "སྡོམ་པ་དེ་དག་ཚུལ་བཞིན་དུ་བསྲུང་བ་ཞིག་བྱུང་ན་ཉེས་སྤྱོད་རྣམས་ངང་གིས་འགག།",
    "ཉེས་སྤྱོད་འགག་ན་མཐུན་ཕྱོགས་ཀྱི་ཡོན་ཏན་ངང་གིས་སྐྱེ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་སྟེ།",
    "དེའི་དོན་ཁོ་རང་གྲ་པ་བྱེད་འཕྲལ་དུ་སོང་པས།",
    "རང་གི་བརྩོན་འགྲུས་ཟུང་དུ་འབྲེལ་བ་ཞིག་གིས་མེ་དང་མེ་འཕྲད་པ་ལྟ་བུ་ཕན་ཚུན་གཅིག་གིས་གྲོགས་སུ་གཅིག་སོང་བ་ཞིག་དགོས་པས་དེ་ཐུགས་ལ་འདོགས།",
    "དམ་སྡོམ་སྲུང་ཚུལ་སོགས་བཀའ་སྤྱད་བརྗོད་ཀྱིས་མི་ལང་བ་མཛད་ནས་ཡི་དམ་ཡང་ཐུན་མོང་མ་ཡིན་པ།",
    "རིན་འབྱུང་གི་རིགས་སུ་དངོས་ཀྱི་གསལ་བ་མེད་པས་གཙོ་བོ་ལ་རིན་འབྱུང་གི་རིགས་ཀྱི་ཕྱག་བྱས་ན་རིགས་ལྔ་ལྡན་ཡིན་པས་འགལ་བ་མེད།",
    "དེའི་ཕྱིར་གཙོ་བོར་རིན་འབྱུང་གི་སྒོ་ཕྱག་དང་།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱིས་ཞེས་པའི་སྐབས།",
    "རིགས་སུ་ཞུགས་པ་དེ་གང་གི་སྐབས་སུ་ཞུགས་ན་ཐམས་ཅད་རྣལ་འབྱོར་དུ་སེམས་བསྐྱེད་སྐབས་ཞུགས་པ་ཡིན་ཚུལ་དང་།",
    "ཆས་འཇུག་གི་སྐབས་དཔེར་ན་དགེ་སློང་ཞིག་གིས་སྣམ་སྦྱར་གྱོན་ཚེ།",
    "བདེ་སྟོང་གི་རོལ་པ་ལས་ཤར་བའི་ཆས་འཇུག་འདི་དག་བཞེས་པ་ཙམ་གྱིས་བདེ་སྟོང་གི་ཡེ་ཤེས་བསྐྱེད་པའི་དགོས་པ་ཡོད་ཚུལ་ཡང་གསུངས།",
    "དེ་ལྟར་མ་ཡིན་པར་སེམས་དེ་ཉིད་དངོས་སུ་བསྐྱེད་པ་དང་མོས་བློ་ཙམ་གྱིས་ཀྱང་གཞན་ལ་ཕན་པ་བརླབས་པོ་ཆེར་འགྱུར་བ་ཡིན།",
    "དེ་ནས་ཀྱང་དམ་བཅའི་བློའི་སྟོབས་བསྐྱེད་དེ་ཉིན་དགུང་གི་བར་དང་།",
    "དེ་དེ་ནས་དགོང་མོའི་བར་བྱ་སྟེ་ཉིན་ལན་གསུམ་བྱ་ཞིང་།",
    "ཉིན་གང་རིང་ལ་བློ་ཡི་གོམས་སྟོབས་ཇེ་ཆེར་སོང་ན།",
    "འགའ་ཞིག་ནི་གཟུགས་མེད་ཅེས་བརྗོད་ན་རང་བཞིན་གྱིས་༤༦ན་གྲུབ་པ་ལ་སྐུར་འདེབས་ཀྱི་ཉེས་པ་འབྱུང་གིས་དོག་ནས་གཟུགས་ཨཱ་ཞེས་འདོན་པ་དང་།",
    "ནང་འཇུག་གི་སྐབས་ཁ་གདོང་མའི་སྔགས་ཀྱིས་སྒོ་བ་ལ་འབོད་པ་མཛད་དེ།",
    "བསྐོར་ཕྱག་གི་སྐོར་ལ་འདིར་མ་རྒྱུད་ལ་གཡོན་སྐོར་བྱ་བ་གཞུང་རང་ནས་གསལ་ཁ་མ་བྱུང་ཡང་།",
    "ཁྱེད་རང་རྣམས་གཞལ་ཡས་ཁང་གི་ནང་ལྷ་རྣམས་ཀྱི་རྒྱབ་ནས།",
    "གཡོན་སྐོར་ཀྱིས་བསྐོར་བ་ལན་གསུམ་མཛད་པ་ཡིན་པས་མོས་པ་མཛོད་གསུངས།",
    "ཁྱེད་རྣམས་ཀྱི་ལུས་ལ་ཞུགས་པས་བྱིན་གྱིས་བརླབ་པ་མཛད་བྱུང་སྙམ་པའི་མོས་པ་མཛོད་ཅེས་བརྡ་སྤྲོད་མཛད།",
    "སླར་ཡང་མཁའ་འགྲོ་མའི་སྐུར་གྱུར་ཏེ་རྣམ་སྣང་གི་ཕྱག་དང་།",
    "ལྷོར་གཟུགས་ཅན་༤༦བ་མས་རིན་འབྱུང་གི་ཕྱག་རྣམས་སྤྱི་ལྟར་མཛད།",
    "དེ་བཞིན་དུ་རྣམ་སྣང་གིས་སྐུ་འཁོར།",
    "ལྷ་ངོ་བསྟན་ན་སྐབས་བདེ་མཆོག་གི་གཞལ་ཡས་ཁང་འདི་ཉིད་སྔོན་འབྱུང་དང་མཐུན་པ་དང་།",
    "འོག་གསེར་གྱི་ས་གཞི་ལ་ཐུག་གི་བར་ཁྱབ་པར་སྒོམ་ཡང་ཆོག་༤༧ན་པས།",
    "རི་རབ་ཀྱི་སྟེང་གི་སྣ་ཚོགས་པདྨ་དེ་ནི་སྒོམ་དོན་ལ་འཆར་མི་བདེ་ཙམ་འདུག་རུང་།",
    "དཀྱིལ་འཁོར་གྱི་ནང་དུ་དམ་ཚིག་གི་གྱི་ས་གཞི་ལ་གནས་པས་སྐུ་འཁོར་དཀར་པོ་རྩིབས་བརྒྱད་པ།",
    "སྔོན་རྒྱལ་པོ་ཞིག་ལོ་དྲུག་གིས་རིང་།",
    "སོ་སོའི་སྐྱེ་བོ་ཐ་མལ་པ་རྣམས་ཉིན་གཅིག་བསགས་པའི་ལས་ཀྱི་འབྲས་བུ་བསྐལ་ཆེན་དུ་མར་ངན་སོང་དུ་སྐྱེ་དགོས་པར་འདི་ལྟར་ན་བསྐལ་པ་དཔག་མེད་དུ་བསགས་པའི་ལས་ཀྱི་འབྲས་བུ་ཡོང་རྒྱུ་ཡོད་པས།",
    "ཁྲོ་མོ་རྣམས་ཕྱོགས་མཚམས་སུ་འཁོད་ནས་བགེགས་ཐམས་ཅད་བསྐྲད་པར་གྱུར།",
    "དུག་གསུམ་དང་བདག་ཏུ་འཛིན་པ་མ་རིག་པ་སོགས་ཉོན་མོངས་པའི་ཁྲག་འཐུང་ཞེས་པ་དཔེར་ན་ཆུ་ཕོར་པ་གང་མི་ཞིག་གིས་འཐུང་།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པས་ཁྲག་དེ་དག་གཏན་མེད་དུ་བཅོམ་པའི་དོན་དང་།",
    "སྤྱིར་བདེ་མཆོག་གི་ཞབས་གནོན་དུ་འཇིགས་བྱེད་དང་དུས་མཚན་མནན་པ་དེ་ཉིད་ལས་ཉོན་གཉིས་ཚོགས་པ་ཡིན་ཞིང་།",
    "དེ་ལྟ་བུའི་སྡུག་པ་ཅན་ཐམས་ཅད་འཇིགས་པར་བྱེད་པ་ལ་མཆོག་ཏུ་གྱུར་པ་རྒྱལ་པོ་ལྟ་བུའི་བདེ་བ་ཆེན་པོའི་རང་གཟུགས་འཁོར་ལོ་བདེ་མཆོག་དང་ཤེས་རབ་སྟོང་པའི་རང་གཟུགས་རྡོ་རྗེ་ཕག་མོ་ཡིན།",
    "དེ་འདྲའི་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་མཐུ་ལས་བླ་ན་མེད་པའི་ཟུང་འཇུག་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ལ་འགོད་དེ།",
    "དེ་ལྟར་སྣང་བའི་སྣང་བ་དེ་ལ་བདེན་གྲུབ་ཀྱི་སྣང་བ་ཕྲ་མོ་ཞིག་ཀྱང་ཡོད་པས་བདེན་སྣང་མཐའ་དག་གི་ནང་ནས་ཕྲ་ཤོས་འདི་ཡིན་པས།",
    "གཙོ་བོ་གཏི་མུག་གི་དྲི་མ་མ་སྦྱངས་ན་གཟུགས་ཀྱི་ཕུང་པོ་དེ་ཉིད་གནས་འགྱུར་ཚུལ་མི་འབྱུང་།",
    "ཉོན་མོངས་པ་དེ་དག་གིས་གཉེན་པོར་གྱུར་པ་ཡིན་པས།",
    "བཛྲ་བེ་རོ་ཙ་ན་ཞེས་པའི་སྔགས་ཉེར་ལྔ་རེ་བཟླ་དགོས་པ།",
    "ཕག་མོ་རང་གི་དམ་ཚིག་ཏུ་སྔགས་ཉེར་ལྔ་རེ་བཟླ་བ་ངེས་པར་མཛོད་གསུངས།",
    "དེའི་རྗེས་གང་ཟག་གི་བདག་མེད་གཏན་ལ་འབེབ་པ་ཡིན་ཀྱང་།",
    "ཉིན་རེ་བཞིན་མཛད།",
    "རྡོ་རྗེའི་བརྟུལ་ཞུགས་འདི་ནི་ནང་གི་བརྟུལ་ཞུགས་ཡིན་གསུངས།",
    "ཕག་མོ་ལ་ཕག་མོ་དམར་མོ་བསྐྱེད་པར་མཛད།",
    "ཕག་མོའི་སྐབས་ཡབ་ཕྱག་རྒྱ་དྲུག་དང་ཡུམ་ཐལ་ཆེན་མ་གཏོགས་ཕྱག་རྒྱ་ལྔས་བརྒྱན་པ་གསུང་པ་ཡིན་གསུངས་ནས།",
    "ཐལ་ཆེན་དོར་བ་མཛད་ཅིང་།",
    "བདུད་རྩི་ལྔ་ལ་སོགས་པ་བག་མེད་དུ་བྱ་བ་མིན་མོད་ཀྱང་།",
    "འདི་ལྟ་བུའི་བདེ་སྟོང་གི་ཡེ་ཤེས་སྤེལ་བ་དང་།",
    "བུད་མེད་རྣམས་ལ་མ་གུས་པ་བྱ་བ་སྤང་བ་སོགས་ཀྱང་རྣམ་རྟོག་ཀྱིས་ཙོག་པའི་འདུ་ཤེས་དང་།",
    "དེ་ལྟར་ལན་འདེབས་པས་རིག་མ་དེ་ཡང་ཤིན་ཏུ་དགྱེས་ནས་གོས་ལ་སོགས་པ་མེད་པར་རང་གི་ཆུ་སྐྱེས་རབ་ཏུ་རྒྱས་པ་སྟོན་ཅིང་།",
    "ཨེ་མ་བདག་གི་པདྨ་འདི་ཞེས་སོགས་གསུང་བཞིན་པར།",
    "ཕག་མོ་གསུམ་པོ་འདི་ཁ་སང་གི་བདེ་མཆོག་གསུམ་གྱི་ཡུམ།",
    "དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ཐ་མི་དད་དུ་མོས་ཏེ།",
    "དེ་ལྟར་བདེ་སྟོང་གི་ཡེ་ཤེས་ལས་མི་འདའ་བར་ཉམས་སུ་ལེན་པ་ལ་ཐ་མལ་གྱི་སྣང་ཞེན་སྤོང་བ་སྔོན་དུ་འགྲོ་དགོས་གསུང་།",
    "ལྷར་བསྐྱེད་སྐབས་རྡོ་རྗེ་ཕག་མོའི་ཡེ་ཤེས་རང་སྣང་ལས་གྲུབ་པའི་དཀྱིལ་འཁོར་འདིར་འཇུག་པ་ལ།",
    "རང་རྒྱུད་ལ་བདེ་སྟོང་གི་ཡེ་ཤེས་བསྐྱེད་པ་ལ།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་ལུས་ངག་དང་འབྲེལ་ཞིང་ཡོད་པ་དེ་དག་སྤོང་དགོས་པ་ཡིན།",
    "སྐྱབས་སུ་སོང་ཞེས་པ་ཡང་ཁ་ནས་བརྗོད་པ་ཙམ་གྱིས།",
    "དེས་གསུང་ལ་མི་འདའ་ན་ངན་སོང་གི་འཇིགས་པ་ལས་ཐར་བ་དང་།",
    "ཕྱིན་ཆད་ཉེས་ལྟུང་གི་ཆ་ཕྲ་མོ་ཙམ་གྱིས་ཀྱང་མ་གོས་པར་བྱའོ་སྙམ་པ་ཞིག་མཛད་དགོས།",
    "འདི་ལྟ་བུའི་ཡེ་ཤེས་འདི་འབེབས་ནས་ཅི་བྱ་སྙམ་ན་འདི་ལྟར་འབེབས་པའི་ཡེ་ཤེས་རང་གི་སྒོ་གསུམ་ལ་འཇུག།",
    "ལས་དང་ཉོན་མོངས་པའི་བག་ཆགས་སོགས་སྔོན་བསགས་དང་བཅས་པ་དག་པར་འགྱུར་ཞིང་།",
    "འདི་ལྟ་བུའི་བདེ་སྟོང་གི་ཡེ་ཤེས་སུའི་ཡིན་ཞེ་ན།",
    "རྒྱལ་བ་རྡོ་རྗེ་འཆང་དེ་ཉིད་གདུལ་བྱ་རྣམས་ཀྱི་སྟེང་འོག་གི་གདོན།",
    "དེའི་སྔོན་དུ་ཆགས་སྡང་གི་བློ་རྣམས་ངེས་པར་དུ་སྤོང་དགོས་པ་ཡིན།",
    "རང་གིས་ཀྱང་ཚེ་སྒྲུབ་དང་གཞན་ལ་ཡང་ཚེ་སྒྲུབ་བྱེད་འཇུག་པ་སོགས་དུས་འདིར་མང་དུ་མཆིས་ཀྱང་།",
    "༥༤བ་དེ་ཡང་རང་གིས་སྤྱོད་ལམ་རྣམས་ཀྱང་ལེགས་པར་བསྡམས་ཞིང་།",
    "དགོང་མོ་ཉལ་ཁར་ཡང་།",
    "དེ་ལྟ་བུའི་བདེ་སྟོང་གི་ཡེ་ཤེས་དེ་རང་རྒྱུད་ལ་དྲན་པ་གསོ་ཕྱིར་མཚོན་བྱེད་རྟགས་ཀྱི་རྡོ་རྗེ་ཡང་འཛིན་དགོས་པ་ཡིན།"
  ]
}