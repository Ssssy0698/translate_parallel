    "མ་བདེ་བ་བྱུང་ན་ང་རང་ལ་དྲིས།",
    "སང་ཙ་ན་བཟླ་རྒྱུ་ཐེ་ཚོམ་ལས་མི་འོང་གསུངས་པའི་བཀའ་གནང་མཛད།",
    "ད་མཚོན་བྱ་དོན་གྱི་ཡེ་ཤེས་མྱུར་དུ་འཆར་བར་གདའ་གསུངས།",
    "རྗེ་ངོར་པ་དཔོན་སློབ་ལའང་སློབ་བུ་དེ་ཙམ་འཕེལ་བའི་རྟགས་ཡིན་པར་འདུག་གོ།",
    "བུ་སློབ་འགའ་ཞིག་ལ་ངེད་ལ་ཉམས་རྟོགས་ཆེན་པོ་མེད་ཀྱང་ཡེ་ཤེས་འཇུག་ལྡོག་དུམ་ཙམ་ཡོངས་ཀྱིན་འདུག་ཅེས་ཀྱང་གསུངས་འདུག་གོ།",
    "ད་དུང་ཁོག་པའི་ནང་ན་སྲིན་བུ་ཅུང་ཟད་ཡོད་ཚོད་དུ་འདུག་ཅེས་སྒྲིབ་གཡོགས་དང་བཅས་གསུངས་པ་དང་།",
    "གཞན་གྱིས་སྦྱངས་ནའང་འདི་ལྟར་འོང་ཞེས་རྗེའི་དབོན་པོ་འགའ་ཞིག་ལ་གསུངས་འདུག་པ་ལས་བརྒྱུད་ནས་ཐོས་སོ།",
    "ཉི་མ་ཤར་འཕྲལ་འཇམ་བསྐོལ་རན་འདུག་དགོངས་ཕྱིར་བྱོན་པས།",
    "དེ་མཚོན་བྱེད་དཔེའི་ཡེ་ཤེས་བཏགས་རུང་ཙམ་དུ་གདའ།",
    "ས་སྐྱའི་གདུང་བརྒྱུད་ལ་ལམ་འབྲས་འཆད་པ་ཁྱེད་ལས་སྔ་བ་མ་བྱུང་འདུག་པས་ངོ་མཚར་ཆེ་ཞེས་པའི་བསྟོད་ཚིག་གསུང་ཤོག་ཏུ་འཁོན་པ་དང་བཅས་གླིང་དཀར་ཕེབས་བྱུང་བ་ཡིན་ནོ།",
    "སྔོན་གྱི་ཡིག་རྙིང་ཆེ་ཆུང་གཉིས་འདུག་པ་ལས།",
    "འདི་འཕགས་པའི་ཡི་གེ་འདིའི་གསལ་བྱེད་དུ་སྦྱར་ནས་བྲིས་པའི་ངེས་པ་མི་འདུག་ནའང་སྐབས་དེར་སྦྱོར་བདེ་བས་སྦྱར་བ་ཡིན་ནོ།",
    "དེ་ཙ་ན་ཟློས་གསུངས་ཟེར་བ་ཤིན་ཏུ་འགལ་ཏེ།",
    "འདི་རྣམས་ཀྱི་གཤམ་ལ་འཁོར་འདས་དབྱེར་མེད་ཀྱི་ཟིན་བྲིས་སྦྲེལ་ཏེ་མཛད་བྱང་ཕྱོགས་གཅིག་ཏུ་སྦྱར་འདུག་གོ།",
    "འོན་ཀྱང་རང་ཉིད་སྐྱེས་སྟོབས་བློ་གསལ་ཞིང་།",
    "ཞེས་ཅུང་ཟད་ཁ་གསལ་དུ་ཇིང་གེར་རྒྱལ་བོའི་མེས་པོའི་རུས་ཁུངས་ནི་བོད་ཀྱི་གྲི་གུམ་མིའི་རུས་རྒྱུད་ཚོ་བ་ཁག་ལ་མ་གཏོགས་མི་རིགས་གཞན་གང་ལའང་ཡོད་བཙན་པོའི་སྲས་ཉ་ཁྲི་ལ་གཏུགས་ནས་ཞེས་གསུངས་ཡོད་པ་འདི་ལ་བདེན་ཚོད་མི་འདུག་པས་ན།",
    "རྒོད་ལ་སོགས་པའི་རང་རང་རུས་རྒྱུད་གཅིག་པའི་ཚོ་ཁག་ཆེ་པའི་ཆུ་འགྲམ་གྱི་རི་བོ་པོར་ཧན་གལ་ཏོ་ན་ཞེས་པར་འབྱོར་ཞིང་པེ་ཏེ་ཞེས་ཆུང་གང་དང་།",
    "ཤུགས་ཡོད་ཚོད་མི་འདུགཏཱ་ཡོན་རྒྱལ་རབས་ཡན་ཆད་ལ་ཕལ་ཆེར་ཡུ་གུར་རིགས་ལ་ཧོར་ཟེར་ཞིང་གསུམ་པ།",
    "རྒྱལ་སྲིད་འཕྲོག་པའི་མི་ཞིག་སྐྱེས་འདུག་བྱས་པས།",
    "བོད་མི་རྣམས་འཇིགས་སྐྲག་རབ་ཏུ་སྐྱེས་ནས་ཡུལ་ཕྱོགས་གཞན་དུ་མཁས་པར་འདུག་པས།",
    "འཕགས་པ་སྤུན་དང་མཐུན་པ་ཚོ་སྐྱིད་སྡུག་ཁོང་རང་དང་མཉམ་པར་བྱེད།",
    "འོན་ཀྱང་དེ་རྟིང་རྩི་ཁོ་རང་འུ་ལག་དང་དམག་ཁྲལ་ཆུང་།",
    "ཡང་ངོ་བལྟས་པ་ཅིག་གདའ།",
    "ངེད་ནི་མགུ་ན་ཕན་ཐོགས་ནུས་པ་ཅིག་གདའ།",
    "ཁྱེད་རང་ནས་འོང་བ་ཚོ་བཟང་བོར་གཏོང་བར་གདའ།",
    "ཡུལ་མི་གཅིག་པ་ཐམས་ཅད་ཀྱིས་ངོ་མཚར་གདའ་ཟེར་བའི་གྲོས་གྱིས།",
    "གུས་པ་ཆེ་བ་འདུག་ངེད་འདིར་འོང་བ་འོངས་ནས་རང་གཞན་ཐམས་ཅད་ལ་ཕན་པར་འོང་།",
    "ངེད་ཀྱི་ཕྱོགས་ནས་ཐམས་ཁྱེད་རང་རྣམས་ཀྱིས་ཀྱང་དེ་བཞིན་བྱེད་པའི་རིགས་སུ་མེད་པ་འདུག་ཅད་བློ་བདེ་བར་བཞུགས་པས་ཆོག་འདབ་ནོར་ལ་གསེར།",
    "གཅིག་པོ་ཞིག་ལམ་ཐག་རིང་ཞིང་དཀའ་སྡུག་ཧ་ཅང་ཆེ་བའི་སར་དཀའ་བ་ཁྱད་ས་སྐྱར་བཞག་གཞན་གཅིག་རང་རང་དཔོན་གྱིས་འཛིན་དགོས་པ་སྟེ།",
    "ཧོར་དམག་གདུག་རྩུབ་ཆེ་རུང་པའི་རྟགས་སུ་འདུག་པས།",
    "ངའི་མཆོད་གནས་མཁས་པ་ཡིན་པས་དབྱིངས་སུ་འདུག་འོན་ཀྱང་རང་རྒྱུའི་འཇིམ་པ་ལ་སྨེ་བརྩེགས་དང་རྣམ་འཇོམས་ཀྱི་བུམ་ཆུས་སྦུག་སྐབས།",
    "གོ་དན་རྒྱལ་བོའི་དྲུང་དུ་བོད་ཀྱི་བནྡེ་འགའ་ཞིག་འདུག་པ་དེ་དག་མཉམ་དུ་ཕེབས་པ།",
    "བོད་སོག་གཉིས་ཀའི་རང་རང་སོ་སོའི་སྲིད་འབྱོར་རིག་ངོ།",
    "སྤྱི་ལོ་ལོར་འགྲོ་མགོན་འཕགས་པར་དུག་དྲངས་ནས་བར་འདུག་ཅེས་པའི་ལབ་གླེང་བྱུང་མྱོང་།",
    "ད་གསུམ་མཁྱེན་པའི་ཡང་སྲིད་དུ་ངོས་འཛིན་གནང་ཞིང་རང་ངོ་སྤྲད་དེ།",
    "དེའི་ཚེ་རྒྱལ་བོ་ཧོ་པི་ལི་ཡང་དད་ཅིང་པས་བསྟན་པ་ཐམས་ཅད་འཇིག་པར་འདུག་པ་འདི་སུས་ཀྱང་མ་ཚོར་བར་འཇིགས་པར་གྱུར་ཏེ།",
    "ཞབས་ཀྱི་པདྨོ་ཅོད་པན་ལ་བླངས་ནས་དགྱེས་པའི་འདུག་པས་འཕྲིན་ལས་རྣམ་བཞིས་བཏུལ་ཏེ་བསྟན་པ་གཞིག་མི་ནུས་པར་ཚིག་བརྗོད་པ།",
    "མི་ཆེན་པོ་ཞིག་ལ་བརྟེན་པ་ལས་འོས་སུ་ལུགས་པ་དར་གྱིན་འདུག་པས་དེ་འཇོམས་ན་ལེགས་ཞེས་བྲིས་ནས་གྲོས་མ་མཆིས་པས།",
    "ནངས་པར་བལྟས་ཙ་ན་ཤར་ལྷོའི་ཕྱོགས་སུ་ཞལ་པས།",
    "ནོར་བ་འདུག་ན།",
    "པའི་ཁྲག་ལས་ལྗོན་ཤིང་ཁྱད་པར་ཅན་ཞིག་སྐྱེ་བར་འདུག་ཅིང་།",
    "ཡང་མི་གདའ།",
    "ནུབ་ཕྱོགས་གངས་ཅན་གྱི་ཁྲོད་ཡུལ་དབུས་ཀྱི་པ་ལ་དགོངས་པའི་ལུང་ཡིན་པར་འདུག་པ་མ་གོ་པ་དང་།",
    "ལྗང་ཁུ་ལེགས་པར་དར་བའི་ཐུགས་ཁུར་ཆེན་པོ་བསྣམས་འདུག་པའི་ལུང་བཞིན་དུཡུག་གཅིག་མེ་ཏོག་མེད་པའི་གོས་ཡུག་དམར་པོ།",
    "ཁྱེད་རང་ལམ་གྱི་ཡོན་ཏན་ཤིན་ཏུ་ཟབ་ཅིང་མཐོ་བ་རྣམ་དག་རྒྱས་པ།",
    "སྐབས་དེར་པེ་པ་ག་སིའི་བུ་ཆེ་བ་སེ་ཆེན་ཧན་ཨུར་ཆི་ཐུ་ནི་ཐེར་འདུག་ཕྱི་རོལ་གྱི་རྒྱབ་ཏུ་ཆབ་སྲིད་ཡུན་རིང་དུ་སྲུང་ཐུབ་པའི་རྟེན་དུ་ལྷ་པ་ཐེའི་རྒྱལ་བོར་བཞུགས་ཡོད་པ་སྟེ།",
