    "ལྷག་པར་སྲིད་བསྐྱངས་ལོའི་ཐད་དཔྱད་དཀའ་བ་ཞིག་འདུག།",
    "ཡང་ན་རྩོམ་པ་པོས་ལོ་ཚིགས་ཐད་ལ་ཞིབ་ཆ་མ་གནང་བ་གང་ཡིན་ཆ་མ་འཚལ་བ་གང་ལྟར་ལོ་ཚིགས་སྐོར་ད་དུང་ཞིབ་དཔྱད་ངེས་པར་དགོས་པ་ཞིག་འདུག་པ་དང་།",
    "ཞིབ་མ་ཤེས་ཏེ་ནས་སུ་མ་སྨིན་པར་སྲུབས་སུ་བཅར་དགོས་པ་ཞིག་དེ་ན་འདུག་ཅེས་པ་ཁ་ནས་ཤོར་སྐད།",
    "ལོ་པཎ་ཕལ་ཆེར་རང་རང་ཡུལ་དུ་བཞུད།",
    "དེར་གྲོས་བགྲོས་པས་འདི་རྫུ་འཕྲུལ་དང་ལྡན་པར་འདུག་པས་ཡེར་པའི་ལྷ་ལུང་དཔལ་རྡོར་ཡིན་ངེས་ཟེར་ནས་བལྟ་བར་བྱས།",
    "དེ་རང་ང་ལ་ཕྱག་འབུལ་མི་བྱེད་པའི་ཚ་བོ་འདི་གླང་ཤ་སྟག་ཏུ་འདུག་ཅེས་གསུངས་ཤིང་།",
    "ཁྱེད་རྣམས་ཀྱང་རབ་ཏུ་བྱུང་བའི་ཚུལ་ཅན་དུ་འདུག་ན་ད་ལམ་ཉེས་མེད་དུ་འཇོག་པས་ཕྱིན་ཆད་རྒྱལ་རྗེ་ཁབ་པའི་ཞབས་སྤྱི་བོར་ད་ལོངས།",
    "གཞན་ཡང་རང་བྱུང་འཕགས་པའི་ཞབས་ཏོག་དང་།",
    "ཁོང་སྤྱན་འདྲེན་ཐུབ་ན་ང་དགའ་བ་ཡིན་པས་ཕྱིས་ཁྱེད་རང་དགའ་བ་ལོས་བྱེད།",
    "ཁྱེད་ལྟ་བུ་བོད་ན་བཞུགས་འདུག་པས་ཁོ་བོ་བོད་དུ་འོང་མི་དགོས་པ་འདུག་གསུངས།",
    "ཚོམ་གྱིས་སྤྱན་དྲངས་ཀྱང་མ་བྱོན་པ་ཕུད་དབུས་གཙང་རང་དུ་ཕེབས་པ་ཉི་ཤུ་རྩ་གཉིས་ཡིན།",
    "དེ་ནས་ཇོ་བོ་འཇལ་དུ་བྱོན་པའི་ལམ་བར་སོག་ཆུ་ཁར་ཕེབས་པ་ན་ཁང་པ་གཅིག་ན་ཀུ་དི་རི་འདུག་པར་འདི་ན་ཅི་ཡོད་དྲིས་པར།",
    "ཡིན་པའང་སྲིད་གསུངས་པས་ཁོང་ཧ་ལས་ཏེ་ཁོང་རང་སྡོད་སའི་གདན་གྲུམ་རྩེ་དེ་ཕྱུང་སྟེ་འབྲོམ་ལ་བཏིང་།",
    "ཇོ་བོ་ཡང་བོད་ལ་མཉེས་ཤིང་འགྲོ་དོན་ཡང་ཆེན་པོ་འདུག་པས་བཞུགས་ཆོག་གམ་བྱ་བ་དང་།",
    "ཇོ་བོ་བོད་ལ་མཉེས་པ་ང་རང་ལ་རྒྱུས་ཡོད།",
    "ད་ལྟ་ང་བསུར་གཏོང་བ་གནང་བྱུང་ཞེས་གསན་པས་ང་ཡང་སྐལ་ལྡན་དུ་འདུག་སྙམ་པས་རྗེ་བཙུན་གྱིས་ཟླ་བ་ཕྱེད་མཇལ་དུ་མ་པའི་ཁེངས་པ་ཅུང་ཞིག་འཁྲུངས་དེ་ནས་ཉིན་ཞིག་ཤོག་གསུངས་པ་ལྟར་བྱོན་པས་རྗེ་བཙུན་ཕ་བོང་གནང་།",
    "ཆང་ཀ་པཱ་ལ་གང་འདུག་པ་གནང་བ་དགེ་སློང་ཡིན་པས་འཐུང་དུ་མི་རུང་སྙམ་བྱུང་བ་ན།",
    "ཆུང་ངུའི་དུས་སྔགས་ཆུང་ཞིག་རྩར་བྱུང་ནས་རྗེ་སྒམ་པོ་བའི་ཡོན་ཏན་མང་དུ་བརྗོད་དེ་ཁྱེད་རང་དེའི་དྲུང་དུ་ཕྱིན་པ་འཐད་ཟེར་བ་ལྟར་ཁོང་དང་འགྲོགས་ནས་སྒམ་པོར་ཕེབས་ཤིང་།",
    "སྒོམ་ཆེན་གཉིས་ཀྱིས་སྒོམ་གྱི་གནས་ལུགས་གླེང་བར་དེ་སྒོམ་ཡིན་ན་ངས་ཀྱང་སྒོམ་ཤེས་པར་འདུག་སྙམ་ཞིང་།",
    "ནན་ཏན་འདེབས་ཀྱིན་འདུག་ནའང་།",
    "ནམ་མཁའ་ནི་ཁྱབ་ཅིང་རང་བཞིན་མེད་ལ་གོ་འབྱེད་པ་ལྟར།",
    "ཙ་ན་ཀའི་རྒྱལ་པོ་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "རང་རང་ས་ནས་ཡི་གེར་ཕབ་པ་མཇུག་གྲུབ།",
    "དག་ཆ་ཡང་ཡག་པོ་ཐོན་འདུག་པ་བཅས་ལེགས་པོ་བྱུང་འདུག་གསུངས་པ་སོགས་ཐུགས་དགྱེས་ཚོར་ཆེན་པོ་གནང་བ་དང་།",
    "ཁོང་རང་ཉིད་ཀྱིས་ཀྱང་ཐུགས་ཁུར་ཆེ་བཞེས་ཀྱིས་ཕྱག་ལས་གནང་བཞིན་ཡོད།",
    "བསྟན་བཅོས་ཀྱི་མཚན་འདོགས་ཚུལ་ལ་མང་པོ་ཞིག་འདུག་པ་ལས་འདི་ནི་བརྗོད་བྱའི་དོན་དང་མཐུན་པའི་སྒོ་ནས་བཏགས་པ་ཞིག་གོ།",
    "ད་ལྟ་ནས་ཇེ་གསལ་ཇེ་གསལ་དུ་འགྲོ་བཞིན་འདུག་གོ།",
    "འོན་ཀྱང་རང་ཉིད་ལྟ་བུས་གཟུ་བོར་གནས་ཏེ་བལྟས་པ་ཡིན་ནའང་།",
    "ཇེ་དཀའ་རུ་འགྲོ་བཞིན་འདུག་གོ།",
    "ཨ་རི་སོགས་ན་ད་དུང་ཉམས་རྒུད་ཆེན་པོ་འབྱུང་ཐུབ་ཀྱིན་མི་འདུག་མ་གཏོགས།",
    "བཞིན་འདུག་གོ།",
    "དེ་དེང་སང་ཇེ་བས་ཇེ་གསལ་དུ་འགྲོ་བཞིན་འདུག་པ་སྔོན་ཆད་ཀྱང་ཐེངས་མང་པོར་ཞུས་ཡོད།",
    "མི་རྣམས་ཀྱིས་འདི་ལ་རིན་ཐང་ཅན་དུ་ཇེ་བས་ཇེ་མཐོང་དུ་འགྲོ་བཞིན་འདུག་པས་ཡག་ཕྱོགས་ནས་དང་པོ་བག་ཡོད་པ་བྱེད་པའི་རབ་ཏུ་བྱེད་པ།",
    "ཕལ་པ་རྣམས་ལ་དགོས་པ་མི་འདུག་གམ་སྙམ་ན།",
    "མང་པོ་ལ་ཤུགས་རྐྱེན་ངན་པ་ཐེབས་རྒྱུ་ཡང་འདུག་པས།",
    "གལ་ཏེ་དངོས་གནས་རྒྱལ་པོ་ཁོ་རང་རྒྱུ་ལ་མི་དགའ་བ་ཞིག་ཡིན་ན།",
    "དེ་འདྲའི་སྐབས་སུ་རང་ཉིད་ཀྱིས་རང་ཚུགས་བཟུང་ནས་འདུག་དགོས་པ་ལས།",
    "སྐྱོན་མི་འདུག་དཔེར་ན་རྒྱལ་པོ་གཏུམ་པོ་རབ་སྣང་ཞེས་པ་ཧ་ཅང་མི་ངན་པ།",
    "རྒྱལ་པོ་རྣམས་ལའང་ནོར་དགོས་དོན་མི་འདུག་ལ།",
    "འོན་ཀྱང་དེ་དག་འཇིག་རྟེན་པ་ཡིན་པས་ཁག་མི་འདུག་ལ།",
    "དགོན་ངསོགས་གང་ཡིན་ནའང་རང་ཉིད་ཀྱི་འཁོར་དུ་གཏོགས་པའི་སྐྱེ་བོ་འདི་དག་ཐམས་འཇིག་རྟེན་གསལ་བའི་རྒྱན།",
    "དེ་ལ་ནམ་ཡང་འགྱུར་བ་མི་འདུག་མ་གཏོགས།",
    "རྒྱལ་ཁབ་གཞན་རྣམས་ཀྱིས་སྣུམ་དེ་བླངས་ནས་གནམ་གྲུའི་སྣུམ་བྱེད་ཀྱིན་འདུག་ལ།",
    "རང་ཉིད་ཀྱི་གཟུགས་པོ་བདེ་ཐང་རྐྱང་པར་བསམ་ནའང་ཤ་ཟ་བ་དང་དུག་ཟ་བ་གཉིས་ལ་ཁྱད་པར་མི་འདུག་པ་ལྟ་བུར་གྱུར་ཡོད་ཅིང་།",
    "ཁྱེད་རྣམ་པས་རང་རང་ལ་ལྟ་རྒྱ་ཆུང་བ་ཧ་གོ་དགོས།",
    "ག་ལེར་ལྟ་རྒྱ་ཅུང་ཙམ་ཆེ་རུ་ཕྱིན་པ་ན་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་ཁྲེལ་འོང་རྒྱུ་དེ་འདྲ་ཞིག་ཐོན་རྒྱུ་འདུག་དེའི་ཕྱིར་ན་རྒྱལ་པོ་ལུགས་ཀྱི་བསྟན་བཅོས་ལ་སོགས་པ་སྔོན་གྱི་དམ་པ་གོང་མ་རྣམས་ཀྱི་བསྟན་བཅོས་རྣམས་ལ་བལྟ་རྒྱུ་ནི་ཧ་ཅང་གལ་ཆེའོ།",
