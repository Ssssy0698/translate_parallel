    "ཚོགས་པ་ཙམ་ནུས་པར་ཁས་ལེན་ན་དེ་ཙམ་ལ་རག་ལས་པའི་འབྲས་བུ་ཡང་ཚོགས་པ་ལ་རྟག་ཏུ་ངེས་པར་ཐལ་ལོ་ཞེས་བརྗོད་པ་ནི་དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ནུས་ཀྱང་འབྲས་བུ་རེས་འགའ་མི་སྐྱེད་ན་དེ་དང་ཁྱད་པར་མེད་པས་རྟག་ཏུ་མི་སྐྱེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "རེས་འགའ་ཁོ་ན་འབྲས་བུ་བྱེད་པའི་ཕྱིར་རོ་ ཁྱད་པར་ཅན་གྱི་སྐད་ཅིག་ཁོ་ན་ནུས་པ་གྲུབ་པ་ན་ཡང་དེ་ཚོགས་པ་སྔ་མའི་འབྲས་བུར་གྲུབ་པ་ཁོ་ན་ཡིན་ལ་ཚོགས་པ་སྔ་མའི་གནས་སྐབས་ནུས་པའི་རྒྱུའི་རང་བཞིན་ཡང་བར་ཆད་མེད་པ་ཉིད་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་དེ་དག་ཀྱང་ཞེས་བྱ་བའོ།",
    "སྒྲིབ་པའི་རྣམ་པར་འགྱུར་བའི་བྱེ་བྲག་གིས་ནུས་པའི་རྣམ་པར་འགྱུར་པ་ཡོད་པ་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "སྒྲིབ་པའི་བྱེ་བྲག་གིས་ཞེས་བྱ་བའོ།",
    "འབྲས་བུ་མི་བྱེད་པའི་ཕྱིར་རོ་ཞེས་ཁྱབ་བྱེད་མེད་པས་ནུས་པ་ཡོད་པ་བཀག་པའི་ཤུགས་ཀྱིས་སྒྲིབ་པ་ནུས་པ་གཏན་མེད་པར་བྱེད་པའི་རྒྱུར་གྲུབ་བོ་ཞེས་ཐལ་བའི་སྒོ་ནས་སྟོན་པ་ནི།",
    "དེའི་ཚེ་འབྲས་བུ་ཤེས་པ་ཡང་སྐྱེད་པར་ཐལ་ལོ།",
    "གལ་ཏེ་སྒྲིབ་པའི་བྱེ་བྲག་གིས་ཐོས་པ་ལ་སོགས་པ་ཐ་དད་པ་དང་།",
    "རྩོལ་བ་དང་རྩོལ་བས་བསྒྲུབས་པས་རྐྱེན་གཞན་གཉི་ག་ལ་རག་མ་ལས་པར་ཐལ་བ་ཁོ་ནའོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་གཉི་ག་ཡང་རུང་མོད་ཀྱི།",
    "རང་བཞིན་དང་འབྲས་བུ་གཉི་ག་རྩོལ་བྱུང་གི་དཔེར་བརྗོད་ཀྱིས་བསྟན་པའི་ཕྱིར།",
    "རྩོལ་བྱུང་གི་དཔེར་བརྗོད་པ་འདི་ཉིད་ཀྱིས་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་ཀྱི་ཡུལ་མཚན་གཞི་གཏན་ཚིགས་གཉི་ག་བསྟན་པ་ཡིན་ཡང་ངོ།",
    "གང་གི་ཕྱིར་རྩོལ་བྱུང་གཉི་གའི་དཔེར་བརྗོད་ཐུན་མོང་མ་ཡིན་པ་དེ་ཉིད་ཀྱི་ཕྱིར་སློབ་དཔོན་གྱིས་ཀྱང་གཉི་ག་ཁྱབ་པར་བྱེད་པའི་ཚིག་ཏུ་གསུངས་སོ་ཞེས།",
    "གཉི་གའི་དཔེར་བརྗོད་ཀྱི་ཤེས་བྱེད་ཀྱི་སློབ་དཔོན་གྱི་ངག་གི་ཚུལ་ལེན་པ་ནི།",
    "འོ་ན་འགལ་བ་དང་ཡང་དག་པ་བཞིས་རང་བཞིན་དང་འབྲས་བུ་གཉིས་བསྒྲུབས་མོད།",
    "རང་གི་བདག་ཉིད་དུ་གྱུར་པའི་གཏན་ཚིགས་གང་ཞིག་གོ།",
    "སྒྲུབ་བྱེད་སྔ་མ་དག་གིས་ནི་ མ་ཡིན་དགག་པ་སྒྲུབ་པར་བྱེད།",
    "ཅེས་གསུངས་པའི་ཕྱིར་རང་བཞིན་དང་འབྲས་བུར་མི་འདུ་མོད་ཀྱི།",
    "བ་ལང་གི་ཐ་སྙད་བཞིན་ནོ་ཡན་ཆད་ཀྱིས་ནི་ཐ་སྙད་ལ་མི་འཁྲུལ་བར་བསྟན་ཏོ།",
    "འོ་ན་རང་གི་ངོ་བོས་རྗེས་སུ་དཔག་པའི་རྒྱུར་འགྱུར་དགོས་ཏེ།",
    "རང་གི་ངོ་བོ་ཡང་དམིགས་པ་ལྡོག་པ་ཙམ་ཡིན་པས་རྒྱུར་མི་རུང་ངོ་ཞེས་སྟོན་པ་ནི་མེད་པ་དེ་ཞེས་བྱ་བའོ།",
    "བཟུང་བའི་རང་གི་ངོ་བོ་ལ་ངེས་པ་ཉིད་ཀྱིས་ཤེས་པ་གཞན་དགག་པ་ངེས་པའི་དོན་སྒྲུབ་སྟེ།",
    "འདི་མ་དམིགས་སོ་ཞེས་བྱ་བ་གང་ལས་མེད་པའི་ཐ་སྙད་དུ་འགྱུར་བ་དེ་དངོས་པོ་རྣམས་ཀྱི་རང་གི་ཡུལ་ཅན་གྱི་ཤེས་པ་མེད་པ་ཙམ་གྱིས་ནི་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "བདེན་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ནས་ཐམས་ཅད་མི་རྟོག་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་ཡན་ཆད་དོ།",
    "ཚིག་རྐང་སྔ་མ་གཉིས་འཆད་པ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "རང་རིག་པ་ཡང་མ་ཡིན་པས་གཞན་ལ་ལྟོས་ཤིང་དེའང་གཞན་ལ་ལྟོས་པས་ཐུག་པ་མེད་པར་ཐལ་ལོ།",
    "འོ་ན་དངོས་པོ་དང་འབྲེལ་པ་ལ་ལྟོས་པར་ཐལ་ལོ་ཞེ་ན།",
    "རང་གི་སྦྱོར་བ་དག་ལ་ཞེས་བྱ་བ་སྟེ།",
    "མི་དམིགས་པ་རབ་ཏུ་རྟོགས་པར་བྱེད་པའི་སྦྱོར་བ་ནི་རང་གི་སྦྱོར་བའོ།",
    "དང་པོ་ནི་རང་གི་ངོ་བོ་བརྗོད་པས་རང་གི་ངོ་བོའི་སྦྱོར་བ་ཞེས་བྱ་ལ།",
    "གཉིས་པ་ནི་མི་དམིགས་པའི་རང་གི་ངོ་བོ་འཕེན་པའི་དོན་གཞན་བརྗོད་པས་དོན་ལ་གནོད་བྱེད་ཀྱི་ངོ་བོ་སྦྱོར་བ་ཞེས་བྱའོ།",
    "དོན་མེད་པར་ཐལ་བས་ཀྱང་འགོག་པ་ནི་དེའམ་ཞེས་བྱ་བའོ།",
    "དེའི་རང་གི་ངོ་བོ་ཉིད་ཅེས་བྱ་བ་ནི་དངོས་པོའི་རྒྱུའི་ངོ་བོ་ཉིད་ནུས་པར་ཁས་བླངས་ཏེ།",
    "དེའི་རང་གི་ངོ་བོར་ཞེས་བྱ་བ་ནི་དངོས་པོ་ཉིད་མི་རྟག་པའི་ངོ་བོར་ཁས་བླངས་ཏེ་མི་རྟག་པ་གཞན་དང་ལྡན་པ་ནི་རྟག་པར་འགལ་བའི་ཕྱིར་རོ།",
    "ངེས་པ་ལས་བཟློག་པ་རེས་འགའ་བ་དང་ལྟོས་བཅས་ལས་བཟློག་པ་ལྟོས་མེད་དག་ཀྱང་དེ་ལྟར་གྲུབ་བོ་ཞེས་སྟོན་པ་ནི་འདིས་ནི་ཞེས་བྱ་བའོ།",
    "འདི་ལ་ལྟོས་བཅས་དང་རེས་འགའ་བ་ནི་ཕན་ཚུན་ཁྱབ་བྱ་ཁྱབ་བྱེད་ཡིན་ལ།",
    "དེས་ན་ལྟོས་བཅས་ཀྱི་ཁྱབ་བྱེད་རེས་འགའ་བ་ཡིན་ལ།",
    "རེས་འགའ་བའི་ཁྱབ་བྱེད་ཀྱང་ལྟོས་བཅས་ཡིན་ལ།",
    "རེས་འགའ་བ་ནི་ལྟོས་མེད་དགག་པ་ལ་འགལ་བས་ཁྱབ་པ་ཡིན་ཞིང་།",
    "ལྟོས་མེད་ནི་རེས་འགའ་བ་དགག་ལ་ཁྱབ་བྱེད་འགལ་བའོ།",
    "དེ་བཞིན་དུ་རེས་འགའ་བ་དང་འགལ་བ་ནི་ངེས་པ་ཡིན་ལ་དེས་ཀྱང་ལྟོས་མེད་ལ་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "ཁྱབ་པས་རེས་འགའ་བ་ནི་ཁྱབ་བྱེད་འགལ་བ་དང་ལྟོས་མེད་ནི་འགལ་བས་ཁྱབ་པའོ།",
    "འདི་ལ་སོ་སོ་རང་གིས་རིག་པའི་ཕྱིར་སྤང་བར་འོས་པ་མ་ཡིན་པའི་ཞེས་བྱ་བ་ནི་དེ་བཀག་ན་རང་རིག་པའི་མངོན་སུམ་གྱིས་གནོད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
