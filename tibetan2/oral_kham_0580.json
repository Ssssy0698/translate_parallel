    "ོད་རཡཉམ་ཉིད་ར་བ་སྤྱི་བོར་བཀོད་པས་ཁྱེད་རང་རྣམས་བཅོམ་ལྡན་འདས་རིན་ཆེན་འབྱུང་ལྡན་གྱི་རང་བཞིན་དུ་བྱིན་གྱིས་བརླབས་དམས་ཤིག།",
    "ཁྱེད་རང་རྣམས་འཕགས་མ་སྒྲོལ་ཡང་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "སླར་ཡང་རང་ཉིང་རྗེ་བཙུན་སྒྲོལ་མའི་སྐུར་གྱུར།",
    "སློབ་དཔོན་དང་ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་ནས་འོདཟེརཉི་མའི་ཟེར་ཐག་ལྟ་བུ་ནམམཁའི་དབྱིངསགང་བ་འཕྲོས།",
    "ཞལ་ནས་ཐོན་ཏེ་ཁྱེད་རང་རྣམས་ཀྱིཞལ་དུཞུགས།",
    "མདུན་བསྐྱེད་དང་ཁྱེད་རང་གཉིས་ཀྱི་གཡས་ཕྱོགས་སུ་བཞུགས་པའི་གུ་རུ་དྲག་པོའི་ཐུགསཀརཔདཏིའི་སྟེང་དུ་གནམ་ལྕགས་ཀྱི་རྡོ་རྗེའི་ལྟེ་བར་ཧཱུཾདམར་པོའི་མཐར་སྔགས་ཕྲེང་དང་བཅས་པ།",
    "པདྨབྷཉྫའི་སྣོདདུ་བསྐྱིལ་བཁྱེད་རང་རྣམས་ཀྱིསམགྲིན་པར་མྱང་བས་ལུས་ཐམས་ཅད་བདེ་བས་ཁྱབ།",
    "མི་དམིགས་སྟོང་པའི་ངང་དུཐིམཅེས་བརྗོད་ཅིང་བསམས་ལམཉམ་པར་བཞག་སླར་ཡང་རང་ཉིད་ལྷ་ཡི་སྐུ།",
    "ཁྱེད་རང་རྣམ་པའི་རྒྱུད་སྡོམ་ལྡན་དུ་བསྒྲུབ་དགོས་པས།",
    "པདྨའི་འདུག་སྟངས་ཡིན་པར་མཁས་བས་བཤད།",
    "མི་འགྲོ་གནས་འདིང་འདུག་ན་རྡུལ་དུ་བརླག།",
    "མེ་ཏོག་འདུག་སྤོས་མར་མེ་དྲི།",
    "སྐབས་འདིར་ཞི་བ་ལ་དཀར་པོ་སོགས་སྲུང་སྐུད་ལས་སོ་མེའི་ཁ་དོག་དང་མཐུན་པ་ལ་རྡོ་རྗེའི་མདུད་པ་བྱས་ནས་བསང་ཆུས་བྲན་ཞིང་མེ་ཐབ་ཀྱི་མེ་ལྕེདང་ངུ་བ་ལ་འདུག་ནས་ལུས་ལ་གདགས་བས་སྲུང་བའི་མཆོག་ངུ་འགྱུར་བར་གསུངས་སོ།",
    "འདུག་དང་ལྷ་དང་མཆོད་རྫས་དང་མེ་ལས་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་དཀར་པོ་འགྲོས་དམིགས་ཕུལ་ལཐིམ་པས་དེའི་སྡིག་སྒྲིབ་ཀྱི་ཉེས་པ་ཐམས་ཅད་སེལ་བར་བསམ་པ་ཡིན་ཏེཝེལ་ཚིག་སྐུ་ཚེ་དུས་ལས་འདུས་པའིས་ལམ་ལ་བར་དུ་གཅོད་པའི་སྡིག་སྒྲིབ་ཐམས་ཤིའུ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "གེལ་པའི་འདུག་སྟངས་ཚུལ་གྱིས་བཞུགས་པ་ཡི།",
    "པང་དུ་རང་རང་རིིགས་ཀྱི་ཡུམ་བྲ་གུག་ཐོད་པ་བསྣམས་པས་འཁྲིལ་བདེ་སྟོང་ཁ་སྦྱོར་ཡེ་ཤེས་ལསལོངས་སྐུའི་བླམསྤྱན་ལྟར་གཏབས་འོད་ཟེར་གཟི་བརྗིད་དཔལ་དུ་འབསྣང་སྟོང་ཟུང་འཇུག་ཆེན་པོརོགསལ་ཨོྃ་བཛྲ་གུ་རུསཾ་བྷོ་ག་ཀཱ་ཡ་མཎྜལ་ཨཱ་ཧཱུཾ་དེ་ཕྱིརརཏྣ་ཟུར་བརྒྱད་དབུས",
    "རྒྱན་དང་ཆ་ལུགས་ཕྱག་མཚནརྣམས་རང་རང་རིགས་ཀྱི་གཙོ་བོའི་ཚུལ་འོད་ཟེར་གཟི་བརྗིད་ལྷམ་མེ་བ་བདེ་གཤེགས་རིག་འཛིན་སྦྱིན་ཕུང་འཕྲོ",
    "ག་ཏོར་མ་བྱིན་ལ་ལན་ཆགས་སྦྱང་ཧྰུྃ་ཧྲཱི་འདོད་ཡོན་ཝ་ལྡན་གཏོར་མའི་ལོངས་སྤྱོད་འདི་ཚེ་འདས་ཞེ་སྡང་རང་གཟུགས་ལས་བྱུང་བའི",
    "ཡུམ་གྱི་མཁར་བབས་པ་དང་ཐོད་བའི་བདུད་རྩི་དང་རྔོག་ཅིག་ཏུ་སྦྱར་བ་ཁྱེད་རང་ལ་བྱིན་པས་རྩ་ཁམས་ཐམས་ཅད་ཁྱབ།",
    "མཐོང་བཞིན་དུ་ཟུར་ཙམ་ཡང་མ་སྨྲོས་པ་ནི་མཐོང་རྒྱ་དང་མཁྱེན་རྒྱ་གཉིས་ཀ་ཆེ་བ་ཁྱེད་རང་བློ་གཟུ་བོར་གནས་པའི་གཏན་ཚིགས་སོ།",
    "སྐྱེ་བ་དང་རང་བཞིན་གྱིས་སྐྱེ་བ་ལ་ཁྱད་མེད།",
    "མ་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་ལ་ཁྱད་མེད་ན།",
    "མ་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་གཉིས་ལ་ཁྱད་ཕྱེ་ནས་གསུང་དོན་ཅི་ལ་ཡོད།",
    "དེ་ལ་ཁྱེད་རང་ངོ་མཚར་བ་ནི་ཆེས་ངོ་མཚར་བའི་གནས་སོ།",
    "དེ་ལས་ཀུན་རྫོབ་བདེན་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་ལ་ཁྱད་ཡོད་པར་གསུངས་པའི་ཕྱིར།",
    "མ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "ཞེང་དུ་གཞུ་འདོམ་སུམ་ཅུ་ཙམ་དང་དྲུག་དུས་གཞུ་འདོམ་བཞི་བཅུའི་ཡན་ཆད་སླེབ་ཅིང་།",
    "ཟབས་སུ་ཁྲུ་གསུམ་བཞི་ཙམ་དང་བྲུག་དུས་འདོམ་གཉིས་ལྷག་སླེབ།",
    "བྲག་ཁུང་ནང་མའི་ཕུག་ན་ཁུང་བུ་མི་མགོ་ཆུད་ཙམ་ཞིག་ཡོད་ལ་དེའི་ནང་ཤིན་ཏུ་ཡངས་པའི་ཚོད་དུ་གདའ།",
    "ཕྱིར་གཙང་དུ་ཕེབས་པར་སྟ་གོན་བྱེད་བཞིན་པའི་དུས་ལ་འཁེལ་འདུག་པ་དང་།",
    "དེ་བཞིན་དུ་རྩོམ་པ་པོ་ཁོང་རང་ངོས་ནས་ཀྱང་བློ་དང་ལྡན་པའི་བོད་མི་སྤྱིའི་འདོད་བློ་དང་མཐུན་པར་རྒྱལ་བ་པཎ་ཆེན་རྣམ་གཉིས་ཀྱི་སྐུ་ཚེའི་རྒྱལ་མཚན་བརྟན་ཞིང་།",
    "ཁོ་རང་ཐོག་མ་ནས་ཁྱིམ་ལས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་བའི་སེམས་ཀྱི་རྩ་བ་མི་བརྟན་པ་དང་།",
    "ཚོར་འདུའི་ཆུ་གཏེར་ཇེ་རྒྱས་སུ་འགྲོ་ཙ་ན།",
    "ལུས་ཀྱི་འདུག་སྟངས་ལ་ཡིད་འཇོག་བྱེད་པ།",
    "ཁོ་ཚོའི་དོན་གཉེར་ལ་གནོད་པ་ཆེན་པོ་ཐེབས་འདུག་སྟེ།",
    "ན་ཡས་འ་ཁུ་འཇམ་དབྱངས་ཟེར་བ་ལ་ཐུགས་འུར་ཉམས་ལྟ་བུས་གསུངས་པ་ངག་རྒྱུན་ཁུངས་དག་ངེས་སུ་འདུག་ཅིང་།",
    "ཞུ་བར་གཞན་གསུམ་སོར་བཤགས་གསུངས། ། མ་བསྒོས་འདུག་དང་མི་གཙང་འདོར།",
    "རང་རང་ས་ན་བདེན་པའི་སྟོབས་རྫོགས་པས།",
    "རང་རང་ལུགས་ཀྱི་བརྟག་དཔྱད་བྱས་པར་ངེས།",
    "སྲེད་པ་སྐྱེད་ལ་ཁྱད་པར་མི་འདུག་པས།",
    "ས་རྩིས་བྱས་པའི་ཐོག་མར་འདུག།",
    "ས་ཕོ་འབྲུག་སྟེ་སྤྱི་ལོ་༡༢༦༨ལོ་ལ་འཁེལ་འདུག་པས།",
    "རྡོའི་ཕུ་མདའ་བདུན་ཅུར་འདུག།",
    "རྩ་བའི་དུད་ཆེན་བདུན་ཅུར་འདུག།",
    "དེ་ལྟར་ན་ཧ་ཅང་མང་དྲགས་པའི་སྐྱོན་ཨེ་འདུག་སྙམ།",
    "རྩ་བའི་དུད་ཆེན་བདུན་ཅུར་འདུག།",
    "དེ་ལས་ལྡོག་སྟེ་ཁོ་རང་སུ་ཞིག་ཡིན་པ་དང་།",
    "ཨ་ཇོ་མིག་ཆུ་དེ་བཞུར་དྲགས།",
    "ར་ལུག་འཚོ་སྐྱོང་བྱེད་ལ་བྲེལ་བཞིན་གདའ།",
    "ཟ་ཉལ་འགྲོ་འདུག་ཁོ་ནས་དུས་འདའ་ཟ་རྔམ་ཆེ་བ་སྤྱང་ཀིའི་གཤིས།",
    "འབྲེལ་ལས་མིག་དུས་འདས་པ་ཡིན།",
    "ཉི་ནུབ་ཏུ་ཁྱིམ་ལ་ལོག་ཁོ་རང་ནམ་ཞིག་ལ་ཡོང་རྒྱུ་ཆ་མ་འཚལ།",
    "ང་རང་རྣམས་འགྲོ་ན་འགྲོ།",
    "ང་ལ་དགོས་པའི་དངོས་པ་པོ་ཁོང་ལ་འདུག་སྟེ་གཡར་རོགས་ཟེར་མེད།",
    "ནང་ནས་ཞེས་མ་ཟེར་ཐབས་མེད་ཅིག་འོང་བ་འདུག་པས་དཔྱད་པར་འཚལ།",
    "འཁོར་དེ་ཆེ་ཆུང་ཡག་པོ་འདུག་དེ་ཁ་དོག་ཀྱང་མཛེས།",
    "འབར་རྫས་ཀྱིས་བྲག་འགད་ཀྱིན་འདུག་ལྟ་བུ་ལས་ཚིག་ད་ལྟ་བ་ཡིན།",
    "མ་ནིང་རང་ལ་རང་མི་འཇུག།",
    "སྔོན་འཇུག་རྣམས་རང་རང་འཇུག་ཡུལ་དུ་གྱུར་པའི་མིང་གཞིའི་ཡི་གེ་རྣམས་ལ་དགོས་པ་གང་བསྒྲུབ་པའི་ཕྱིར་དུ་འཇུག་པ་ཡིན་ཞེས་པའི་དོན་ནོ།",
    "ཤིང་གཅོད་ཀྱིན་འདུག་ས་ད་ལྟ་བ་སྟེ་དུས་གསུམ་དང་།",
    "ཤིང་ཆད་ན་འདུག་ལྟ་བུ་ཀུན་ལ་རིགས་འགྲེ་བྱའོ།",
    "བྱ་བའི་ལས་མ་འོངས་པ་གཉིས་སུ་དབྱེ་བ་དེ་དག་དུས་གསུམ་གྱི་བ་དག་ཏུ་འདུས།",
    "རང་ལ་མི་འདུག་དམིགས་པ་གཏོད།",
    "ས་མགོ་ཅན་གྱི་སྒུག་ནི་དམིགས་ཡུལ་ཞིག་འགྲུབ་དུ་ཡུན་རིང་འདུག་པ་ཞིག་ཡིན་ཏེ།",
    "ལྭ་བ་སོགས་གཏག་དུས་འཕྲེད་དུ་རྒྱུ་བའི་གཞུང་སྐུད་ལ་སྤུན་ཟེར་བ་ཡིན།",
    "བུ་ཡི་བཙུན་པ་རྒྱལ་བ་གཡུང་དྲུང་བདག་བཀྲ་ཤིས་ངོ་མཚར་མཁར་སྣ་དཔལ་གྱི་རི་བོ་ལ་འདུག་པའི་དུས་སུ།",
    "རང་ཐ་མལ་དུ་འདུག་པའི་སྤྱི་གཙུག་ཏུ་སེང་གེ་བཞི་བསྣོལ་གྱི་ཁྲི་ཉི་ཟླ་པད་མའི་གདན་གྱི་སྟེང་དུ།",
    "དེ་ཡང་བདག་དང་རང་གཅིག་པུར་མ་ཡིན་ཏེ།",
    "རྣམ་དག་ཡེ་སྲུང་ཀུན་བཟང་རང་ས་ཟིན།",
    "ངང་དང་རང་བཞིན་མཐའ་དང་དབུས་མེད་པ།",
    "མཉམ་བཞག་དུས་སུ་སྣང་མེད་མཁའ་ལྟར་དག།",
