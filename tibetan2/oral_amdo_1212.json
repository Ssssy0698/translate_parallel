    "གཡས་ཀྱིས་ཐལ་མོའི་རྣམ་པ་བྱས་ན་ལེགས་སྙམ་མོ།",
    "འཛུབ་མོ་བསྡིགས་འཛུབ་བྱས་པ་ཧཱུྃ་མཛད་ཀྱི་ཕྱག་རྒྱ་བྱའོ།",
    "དེའི་ཐུགས་ཀར་ཉི་མའི་སྟེང་དུ་ཧཱུྃ་ལ་ཕྱག་རྒྱ་མི་དགོས་ཀྱང་སརྦ་བིད་ཨོཾ་སོགས་ལ་ཐལ་མོ་དཔྲལ་བར་སྦྱར་བ་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་བྱས་པའི་གུང་མོ་རྩེ་སྤྲོད་པར་བྱེད་དོ།",
    "ཨོ་བུདྷ་ཨ་བྷི་ནས།",
    "ཨོཾ་ཧཱུཾ་ཞེས་ལན་རེ་བརྗོད་པ་དང་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་མདུད་པ་བཅིང་བའི་ཚུལ་གྱིས།",
    "གཡོན་པའི་མཛུབ་མོ་ནས་རིམ་གྱིས་དཀྲོལ་ཏེ་མཉམ་པའི་ཐལ་མོ་བརྡབ་ལ་སྔགས་བརྗོད།",
    "དེ་ལྟར་བྱས་པ་མི་འགལ་མོད།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་ཁ་སྟེང་དུ་བསྟན་ཏེ་སོར་མོ་རྣམས་འབར་བ་ལྟ་བུར་བྱས་པའི་མཐེ་བོང་རྩེ་སྦྱར་ཏེ་སྲིན་ལག་དང་གུང་མོའི་བར་བཟུང་བ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱུ་བྱས་ཏེ།",
    "བཛ་ཌི་ལྷོ་དང་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་མགལ་མེའི་འཁོར་ལོ་བཞིན་དུ་བསྐོར་ཏེ་མགོ་བོའི་སྟེང་དུ་འཛུབ་མོ་གཉིས་ལྕགས་ཀྱུའི་ཚུལ་དུ་བཞག་པ་རྡོ་རྗེ་འཇིགས་བྱེད་སྤྱན་གྱི་ཕྱག་རྒྱ་བྱས་ལ་ཧུ་ལུ་ཧུ་ལུ།",
    "རྡོ་རྗེ་ཐལ་མོའི་མཐེ་བོང་གཉིས་བརྐྱང་ལ་འཛུབ་མོ་མཆེ་བ་ལྟར་བྱས་པ་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་ཕྱག་རྒྱ་བྱས་ལ་ཡགླ།",
    "རྡོ་ཁུ་ཚུར་གཉིས་ཀྱི་མཐེའུ་ཆུང་གཉིས་ལུ་གུ་རྒྱུད་དུ་སྦྲེལ་འཛུབ་མོ་གཉིས་རྩེ་སྤྲད་ནས་བཟློག་སྟེ་སྤྱི་བོར་བཞག་པ་རྡོ་རྗེ་གཙུག་ཏོར་གྱི་ཕྱག་རྒྱ་བྱས་ལ་དྲི་བ་ནུ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་གཉིས་སེམས་དཔའི་སྐྱེལ་ཀྲུང་བྱས་ཏེ་འཛུབ་མོ་གཉིས་མཉམ་པོར་བཤིབས་ནས་ཕྱེ་ལ་མཐེ་ཆུང་གཉིས་བ་དན་ལྟར་བྱས་པ་རྡོ་རྗེ་བ་དན་གྱི་ཕྱག་རྒྱུ་དང་པ་ཏཱ་ཀེ།",
    "བཛྲ་ཀཱ་ལི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཁ་གྱེན་དུ་བསྟན་ནས་རི་བོ་འདེགས་པའི་ཚུལ་ཏུ་བྱས་པ་རྡོ་རྗེ་རྩེ་མོའི་ཕྱག་རྒྱ་དང་ཤི་ཁ་ར།",
    "རྡོ་རྗེ་ཧཱུྃ་མཛད་བྱི་ཕྱག་རྒྱ་ལས་འཛུབ་མོ་དང་གུང་མོ་གཉིས་རྡོ་རྗེ་ལྟར་བྱས་པ་རྡོ་རྗེ་ལས་ཀྱི་ཕྱག་རྒྱ་དང་ཧཱུྃ་བཛྲ་ཀ",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རྒྱབ་སྦྱར་སྟེ་མཐེའུ་ཆུང་གཉིས་སྦྲེལ་མཛུབ་མོ་བསྡིགས་མཛབ་བྱས་པ་ཧཱུྃ་མཛད་ཀྱི་ཕྱག་རྒྱ་སྟེ་ཁ་ཅིག་ཧཱུྃ་ལན་བརྒྱད་བརྗོད་པར་བཞེད་བྱང་།",
    "འདི་དག་གི་སྐབས་སུ་མི་ཤེས་བཞིན་དུ་རང་དགར་བྱེད་པ་གཞན་ལ་ངེས་པ་མེད་ཀྱང་།",
    "ཞགས་པའི་ཕྱག་རྒྱ་ལྟ་བུ་ལ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཁྲིག་མདུད་ནས་ཞགས་མིག་ལྟར་བྱེད་པ་ལས་འཛུབ་མོ་དང་མཐེའུ་བསྒྲེང་བར་གཞུང་གཉིས་སུ་མི་སྣང་ཡང་།",
    "ཐལ་མོ་བརྐྱང་བ་ལས་གུང་མོ་གཉིས་ནང་དུ་བཀུག་པའི་ཕྱག་རྒྱུ་བྱས་ལ།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཐེ་བོང་དང་འཛུབ་མོ་སྐམ་པས་སོར་མོ་རྣམས་བསྐོར་ཞིང་གཡོན་པའི་འཛུབ་མོ་ནས་རིམ་གྱིས་དགྲོལ་བའི་ཕྱག་རྒྱུ་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་རོལ་མོ་བཀྲོལ་བའི་ཚུལ་གྱི་ཕྱག་རྒྱ་དང་ཤཔྟའི་སྔགས་བརྗོད་ཅིང་མཆོད།",
    "འོན་ཀྱང་རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་ནས་བྱེད་པ་ཕྱག་ལེན་དུ་སྣང་བ་ལྟར་ཡང་རུང་བར་སེམས་ཏེ།",
    "དེ་ནས་ལག་པ་གཉིས་བཀན་ལ་སོར་མོ་རྣམས་ཕན་ཚུན་རྩེ་སྤྲད་དེ་མདུན་དུ་བཞག་ལ།",
    "ཐལ་མོ་གཉིས་ཕན་ཚུན་མ་རེག་ཙམ་བྱས་ལ་ཨོཾ་ཨཱརྒྱ་རྒྱ་སོགས་དང་།",
    "རྡོ་རྗེ་ཐལ་མོ་བྱས་ལ་པ་ར་སྤུ་ར་སོགས་དང་།",
    "ཁ་ཅིག་རྡོ་རྗེ་ཐལ་མོ་བརྡབ་པར་མཛད་ཀྱང་དོན་མ་ཡིན་ནོ།",
    "དེ་ནས་ལག་པ་གཡོན་ཐལ་མོ་གན་རྐྱལ་དུ་བྱས་ལ་དེའི་སྟེང་དུ་གཡས་པ་ཡང་དེ་བཞིན་དུ་བཞག་སྟེ།",
    "མཐེ་བོང་གཉིས་ལྟོ་སྤྲད་པའི་མཉམ་གཞག་གི་ཕྱག་རྒྱ་ནི།",
    "རྣམ་སྣང་གི་དམ་རྒྱ་སྟེ།",
    "འདིར་ཡེ་ཤེས་པ་ལ་བལྟ་བའི་དོན་དུ་གསུངས་ཀྱང་རང་ཉིད་ཡེ་ཤེས་པ་དང་གོ་ས་འམ་ངོ་བོ་དབྱེར་མེད་དུ་མོས་དགོས་པས་རང་ཉིད་ལྷར་གསལ་བར་བལྟའོ།",
    "དེ་ལ་སྔོན་གྱི་མཁས་པ་འགའ་ཞིག་སྔར་གྱི་སྒོ་བཞིའི་དགུག་གཞུག་གི་ཚེ་གོ་ས་ཐ་མི་དད་ལ་རྣམ་པ་ཐ་དད།",
    "ལག་པ་ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་ལ་འཛུབ་མོ་གཉིས་གདུ་བུར་བྱས་ཏེ་མཐེ་བོང་གི་རྩེ་མོར་མིག་གི་ཚུལ་བྱ་བ་སྤྱན་མའི་དམ་རྒྱ་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་བསྒྲེང་བའི་ཚེག་གསུམ་པར་འཛུབ་མོ་གཉིས་རྡོ་རྗེའི་ཚུལ་དུ་བཟུང་བ་ནི།",
    "ཐལ་མོ་གཉིས་ཁོང་སྟོང་དུ་བྱས་ཏེ་པདྨ་ཁ་ཕྱེ་བའི་ཚུལ་དུ་སྦྱར་བ་ནི་གོས་དཀར་མོའི་དང་།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བ་ལས་འཛུབ་མོ་གཉིས་བཀུབ་པར་གང་མོའི་སེན་མོ་མནན་ཏེ་མཐོ་བོང་གཉིས་དབུས་སུ་བཞག་ནས་ཅུང་ཟད་བཀུག་པ་ནི་སྒྲོལ་མའི་འོ།",
    "བསྡམ་པ་དེ་ཉིད་ལས་འཛུབ་མོ་གཡས་པ་བཀུག་པ་རྒྱལ་པོའི་དང་།",
    "དེ་ཉིད་ལས་སླར་བཀུག་སྟེ་མཐེ་བོང་ལ་འཛུབ་མོ་གཉིས་ཀྱི་རྩེ་སྤྲད་པ་ལེགས་པའི་དང་།",
    "དེ་ཉིད་ལས་རྩེ་མོ་ཡིད་ཙམ་བཀུག་པ་རྣོན་པོའི་དང་།",
    "དེ་ཉིད་ལས་རྩེ་མོ་ཡིད་ཙམ་བཀྱེད་པ་ལས་ཀྱི་དང་།",
    "དེ་ཉིད་ལས་རྩེ་མོ་སླར་བཀུག་པ་གནོད་སྦྱིན་གྱི་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་བྱུང་བའི་གང་བྱས་ལ་ཐལ་མོ་སྤྱི་བོར་བཞག་པ་གར་མའི་དང་།",
    "དེ་ཉིད་ལས་འཛུབ་མོ་གཉིས་བཀུག་པ་ལྕགས་ཀྱུའི་དང་།",
    "དེ་ཉིད་ལས་ཚེ་མོ་གཉིས་སྤྲད་པ་ཞགས་པའི་དང་།",
    "དེ་ཉིད་ལས་གཅིག་ལས་གཅིག་མདུན་པ་ལྕགས་སྒྲོག་གི་དང་།",
    "གཡོན་པ་དེ་བཞིན་གཤེགས་པའི་ཁུ་ཚུར་བཀན་ལ་གཡས་པའི་མཐེབ་འཛུབ་གཉིས་ཀྱིས་ཐེའུ་ཆུང་ནས་བརྩམས་ཏེ་ཕྱེ་ལ་ཐལ་མོ་ཁོང་སྟོང་དུ་བྱས་པ་ནི་བསྐལ་བཟང་རྣམས་ཀྱི་དང་།",
    "ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་བའི་སོར་མོ་ཀུན་གྱིས་གང་བའི་མཛད་པ་ལྟར་གནས་པ་ལས་ཕྱིར་བཀྱེད་ནས་མཐེ་བོང་དང་མཐེའུ་ཆུང་རྩེ་སྤྲད་དེ་སོར་མོ་གཞན་གསུམ་བརྐྱང་པ་ཉན་ཐོས་ཀྱི་དང་།",
    "ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་ནས་སོར་མོའི་རྩེ་མོ་རིམ་བཞིན་བསྡུས་ནས་ཁ་སྦྱོར་དུ་བྱས་ཏེ་མཐེ་བོང་གཉིས་བསྒྲེངས་ནས་བཀུམ་པ་རང་རྒྱལ་གྱི་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅངས་ཏེ་གུང་མོ་གཉིས་རྩེ་སྤྲད་ལ་བརྐྱང་ཐ་མ་བཞི་སོ་སོར་བསྒྲེང་པ་ཁྲོ་བོའི་དམ་རྒྱའོ།",
    "ཁ་ཅིག་ལག་པ་ཐལ་མོ་ཁ་ཕྱེ་བའི་པདྨ་དང་།",
    "ཆོ་ག་དང་འགྲེལ་བ་སོགས་ནས་ལས་རྒྱའི་སྐབས་སུ་ཡུམ་བཞི་ནི་ཕྱག་མཚན་མེད་པའི་ཕྱག་ཆེན་ལྟར་འཆིང་བར་གསུངས་པས་གཡས་ཕྱག་མཚན་བཟུང་བའི་རྣམ་པར་མི་བྱེད་པ་ལྟ་བུར་སྣང་ཡང་བཟུང་བ་ལྟར་བྱེད་མི་བྱེད་གང་ཡིད་ཀྱང་ཡིན་ཀྱིས་ཕྱག་མཚན་མེད་པའི་རྣམ་པར་བསམ་དགོས་སམ་སྙམ་མོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་ལ་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་གྲུ་མོ་བཙུགས་པ་ནི་རྒྱལ་མཚན་གྱི་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་སོར་མོ་རྣམས་རིམ་གྱིས་དགྲོལ་བ་ལས་བྱུང་བའི་ཐལ་མོ་སྦྱར་བ་འགྲམ་པ་གཉིས་དང་སྤྱི་བོར་བཞག་པ་ནི་ལས་ཀྱི་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཐེའུ་ཆུང་བརྐྱངས་ནས་བཀུགས་པ་མཆེ་བའི་རྩེ་མོ་ལྟར་བྱས་ཏེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་དཀུག་ཏིས་སུ་བཞག་ལ་བསམ་པ་གཡོས་པས་མགོ་བོ་གཡོན་དུ་འདུད་པ་ནི་སྒེག་མོའི་དང་།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་འཛུབ་མོ་ལྕགས་ཀྱུ་ལྟར་བྱས་པས་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཐེའུ་ཆུང་ལྕགས་ཀྱུ་ལྟར་བྱས་པ་ལ་བཅིངས་པ་ནི་ལྕགས་ཀྱུའི་དང་།",
    "འདིར་ཁ་ཅིག་ཀརྨའི་སྐབས་སུ་ཐལ་མོ་བརྡབ་པ་ནི་ཆོ་ག་རང་འགྲེལ་སོགས་དང་འགལ་བར་མ་ཟད།",
    "དེའི་བཀོལ་ཞེས་པ་ནི་སོར་མོ་རིམ་གྱིས་བཀྲོལ་ནས་འབྱེད་པའི་དོན་ཡིན་གྱི་བརྡབ་པའི་དོན་མིན་པའི་ཕྱིར།",
    "རིགས་ལྔ་ལ་རང་གི་ཕྱག་ཆེན་བཞིན་བྱེད་པ་ནི།",
    "སྔོན་ཀྱི་མཁས་པ་འགའ་ཞིག་གི་ལུགས་སུ་ཡང་སྣང་ཞིང་འདིར་མགྲོན་ཐབས་ཀྱི་ཉན་རང་ཁྲོ་བོ་ལ་དམ་རྒྱུ་བྱེད་པ་ནི་གཞུང་མ་མཐོང་བར་གསལ་ལོ།",
    "འོན་ཀྱང་འདི་ལ་ཕྱག་མཚན་མེད་པར་མོས་པ་ཙམ་མ་གཏོགས་ལག་པས་ཕྱག་མཚན་འཛིན་ཚུལ་ལྟར་གྱི་སོར་མོ་རྐོང་དགོས་པ་ལ་མ་བརྐྱངས་ན་མི་བདེ་བས་ཚུལ་དེ་ཤེས་དགོས་སོ།",
    "ངན་སོང་སྦྱོང་རྒྱལ་ལ་གཡས་ས་གནོན་བྱེད་མཁན་མང་ཡང་ཆོ་གའི་གཞུང་དུ་ཕྱག་གཉིས་མཉམ་གཞག་གི་ཕྱག་རྒྱས་རྡོ་རྗེ་འཛིན་པའི་གསུངས་པ་ལྟར་བྱ་བར་རིགས་ལ།",
    "ཕྱག་ཆེན་གྱི་གོ་ཆའི་སྐབས་སུ་འགའ་ཞིག་ཐལ་མོ་རྡེབ་ཀྱང་དེ་ནི་མིན་ཏེ།",
    "རྡོ་རྗེ་གོ་ཆའམ་སྲུང་བའི་ལས་ཀྱི་ཕྱག་རྒྱ་ལ་གོ་བཀོན་པའི་མཐར་ཐལ་མོ་བརྡབ་པར་རུང་ཙམ་སྣང་ཡང་དེ་ལྟར་མ་གསུངས་ཤིང་མི་ཐོབ་པས་མི་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་འཛུབ་མོ་ལྕགས་ཀྱུ་ལྟར་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་འཛུབ་མོ་དང་མཐེའུ་ཆུང་གཉིས་འཆིང་བའི་ཚུལ་བྱས་ན་མི་འགལ་ལོ།",
    "ཁྲོ་བོ་བཅུ་དྲུག་གི་ཕྱག་ཆེན་ལ་ཧཱུྃ་མཛད་ཀྱི་ཕྱག་རྒྱ་བྱེད་པར་མི་གསལ་ཡང་།",
    "རེ་རེ་ནས་བྱེད་པ་མི་བདེ་ཞིང་ཐུན་མོང་དུ་གཞན་བྱེད་པ་ཡང་མ་གསུངས་པས་དེ་ལྟར་བྱེད་རུང་ཙམ་འདྲའོ།",
    "དེ་ཡང་འཇིག་རྟེན་པ་སྤྱིའི་དམ་རྒྱུ་ནི་ཐལ་མོ་བརྐྱངས་པའམ་ཡང་ན་ཐལ་མོ་པདྨ་ལྟར་བྱའོ།",
    "མདུན་བསྐྱེད་དང་བུམ་བསྐྱེད་ལ་ཡང་རང་རང་གི་ཕྱག་རྒྱ་བཞིའི་རྒྱས་འདེབས་དགོས་ལ།",
    "ལས་རྒྱ་བྱེད་པའི་ཚེ་རྡོ་རྗེ་ཁུ་ཚུར་ལས་བྱུང་བའི་གར་སྔོན་དུ་འགྲོ་བས་རྣམ་སྣང་གི་ལས་རྒྱ་བཅིངས་ནས།",
    "འདིར་ལས་རྒྱ་དང་ཕྱག་ཆེན་གང་བྱེད་ཀྱང་ལྷ་དེ་དང་དེ་དྲན་པར་བྱས་ནས་འདོད་དོན་གང་ཡིན་ཀྱང་དེ་སྒྲུབ་པའི་འཕྲིན་ལས་མཛད་པར་མོས་དགོས་སོ།",
    "འཕྲིན་ལས་འདི་བུམ་བསྐྱེད་པའང་རུང་མོད།",
    "སྒེག་སོགས་བརྒྱད་ལ་ལུས་ཀྱི་རྡོ་རྗེ་ཁུ་ཚུར་ལས་བྱུང་བའི་གང་སྔོན་དུ་འགྲོ་བས་ལྷ་མོ་རང་རང་གི་ལས་རྒྱ་རིམ་པ་ལྟར་བཅིངས་ལ།",
    "དེ་ནས་རྡོ་རྗེ་ཐལ་མོ་སྦྱར་བའམ།",
    "བསྙེན་པའི་མཐར་བདག་བསྐྱེད་གཤེགས་གསོལ་བྱེད་ན་གསོལ་གདབ་ཀྱི་རྗེས་སུ་རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་བསྙམས་ཏེ་བཤིབས་ལ་བསྒྲེང་བ་སེམས་མ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་སྤྱི་བོ་ནས་གྱེན་དུ་བཀྲོལ་ཏེ།",
    "སོར་མོ་རྣམས་ལ་གདུ་བུ་སྟེ།",
    "གཡོན་པ་དེ་བཞིན་གཤེགས་པའི་ཁུ་ཚུར་བྱས་པའི་མཐེ་བོང་གི་སྟེང་དུ་ཀ་བས་ཁ་ཐུར་དུ་བསྟན་པ་བརྐྱང་ལ།",
    "ལག་པ་གཉིས་བརྐྱངས་ལ་སྲིན་ལག་གི་ཚིག་དབུས་མ་བཀུགས་ནས་བ་དན་གསུམ་པའི་ཚུལ་དུ་བསྒྲེངས་ནས་ལག་པ་གཉིས་བརྐྱངས་ནས་སྟེང་དུ་བཏེག་པ་ལྟར་བཞག་ལ།",
    "གཡོན་པར་བར་མཉམ་གཞག་བྱས་ལ་གཡས་ཁ་ཐུར་དུ་བསྟན་ཏེ་བླ་རེ་བཀྱེད་པའི་བསམ་པས་ནམ་མཁའ་ལ་ཡོངས་སུ་བསྐོར་ལ།",
    "ཨ་མ་ཡ་ཙ་ཏུ་ར་བྲ།",
    "འདིར་མེ་ཏོག་འཐོར་བ་སོགས་ཀྱི་ཚེ་ཁུ་ཚུར་གཏན་མ་བཤེགས་པར་བཟུང་ན་རྣམ་འགྱུར་མི་འོང་བས་ཐོག་མར་རྡོ་རྗེ་ཁུ་ཚུར་ལས་རྗེས་སུ་སོར་མོ་གང་སྐྱོང་དགོས་པ་དེ་བྱས་ན་དགོངས་པ་དང་མི་འགལ་བར་མངོན་ནོ།",
    "རྡོ་རྗེ་ཐལ་མོ་གཉིས་བརྐྱངས་ལ་ན་བཟའ་འབུལ་བའི་ཚུལ་བྱས་ལ་ཝ་སྒྲ་ཞེས་བརྗོད་དེ།",
    "དེ་ནས་ལག་པ་ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བ་སྤྱི་བོར་བཞག་ལ།",
    "ཨོཾ་ཨ་མྲྀ་ཏེ་བརྗོད་དེ་བདུད་རྩིའི་བསྒྱུར།",
    "གཡས་ཁུ་ཚུར་བཅངས་པའི་མཛུབ་མོ་བསྒྲེང་བ་ཁྲོ་བོའི་ཁུ་ཚུར་བྱས་པ་རྫས་ལ་གཏད་དེ་སེ་གོལ་གདབ་ཅིང་བཀྲོལ་ལ།",
    "ཨོཾ་དུ་དུ་སྤུ་རུ་སོགས་ཀྱིས་མཉམ་པོར་ཐོབ་པར་བསམ་མོ།",
    "སྤྱན་དྲང་བ་ནི་བུས་མོ་གཡས་བཙུགས་གཡོན་གྱེན་དུ་བསླང་།",
    "མོ་ཨེ་བྱེ་ཧི་ད་ཤ་སོགས་ཀྱི་མཐར་རྡོ་རྗེ་བསྡུ་བའི་ཕྱག་རྒྱ་བྱས་ལ།",
    "ཞེས་གསུངས་པས་ཐལ་མོ་ཁ་གྱེན་དུ་བསྟན་ནས་འབུལ་དགོས་སོ།",
    "མཇུག་ཏུ་གཙོག་ཕུར་འདུག་ཅིང་ངག་བཅད་ལ་ལག་པ་གཉིས་པུས་མོའི་ནང་དུ་འོང་བར་བྱའོ།",
    "གཡས་གན་རྐྱལ་དུ་གནས་པའི་གུང་མོ་དང་སྲིན་ལག་ཅུང་ཟད་བཀུག་ལ་ཁར་ཕྱོགས་པར་བཟུང་ཟེའུ་འབྲུའི་ཆུས་ཁ་ལ་ལན་མང་དུ་བྱས་ཅིང་ལན་གཉིས་གསུམ་དུ་རྣ་བུག་གཉིས་དང་།",
    "མགོ་ལ་རེག་ནས་ཆུ་ཧུབ་གསུམ་འཐུང་ནས་མཆུ་ལ་ལན་གཉིས་ཕྱི་བར་བྱའོ།",
    "ཡང་ན་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་པ་ཀན་ལ་མཛུབ་མོ་གཉིས་བསྒྲེངས་ཏེ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞེས་སོགས་ཀྱི་སྐབས་སུ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་བསྙམས་ཏེ་གཤིབས་ལ་བསྒྲེངས་པས་སེམས་མ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་བཅིངས་པའམ་ཡང་རྡོ་རྗེ་མགོར་བཟུང་ཕྱག་རྒྱ་དེ་ཉིད་ཁ་ཐུར་དུ་བསྟན་པ་དང་གྱེན་དུ་བསྟན་པ་བཅིངས་ལ་སྤྱི་བོར་བཞག་སྟེ།",
    "འདི་ནི་ཁྱོད་ཀྱི་རྡོ་རྗེའི་དམ་ཚིག་ཡིན་གྱིས་ཞེས་བརྗོད།",
    "དེ་ཡང་ལག་པ་གཉིས་མཁྲིག་མ་བསྣོལ་ཏེ་རྒྱབ་སྦྱར་ལ་སོར་མོ་རྣམས་གཅིག་ལ་གཅིག་འཁྱུད་དེ་མཐེ་བོང་གཉིས་ལག་མཐིལ་དུ་བཀུབ་ལ་ཙ་ཀྲ་རཉྫ་དང་།",
    "ཁུ་ཚུར་གཉིས་ཀྱིས་མཛུབ་མོ་གཉིས་ཚིགས་བཅག་སྟེ་མཐེ་བོང་གཉིས་རྩེ་སྤྲད་ལ་མ་ཎི་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་དང་ཐ་མ་བཞི་གཤིབས་ཏེ་པུ་རུ་ཥ་དང་།",
    "ལག་པ་གཡོན་པའི་མཐིལ་དུ་གཡས་པའི་གྲུ་མོ་བཞག་སྟེ་བསྒྲེང་ལ་གཡས་པའི་ཁུ་ཚུར་འོག་ཏུ་གླང་བོའི་རྣམ་པར་བྱས་པའི་གུང་མོའི་གླང་བོའི་སྣ་ལྟར་བྱས་ལ་ཧ་སྟི་དང་།",
    "ཁུ་ཚུར་གཉིས་བཅེར་བའི་གུང་མོ་གཉིས་དང་སྲིན་ལག་གཉིས་བརྐྱངས་ཏེ་མཐེ་བོང་གཉིས་རྣ་བ་ལྟར་བྱས་ལ་དུ་རིག་ཨ་ཤུ་དང་།",
    "དེ་བཞིན་དུ་བཙུན་མོ་ལ་ཡང་འདྲའོ།",
    "བློན་པོ་ལ་ཁ་ཅིག་གུང་མོ་སྲིན་ལག་མཐེའུ་ཆུང་གསུམ་སྦྱང་བར་མཛད་ཀྱང་།",
    "ཆོ་གར་ཡང་གུང་མོ་དང་ཐ་མ་བཞི་ཞེས་གུང་མོ་ལོགས་སུ་བཅད་པ་དང་འགལ་བར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་རོལ་མོ་དཀྲོལ་བའི་ཚུལ་དང་ཤརྟ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་བརྐྱངས་པའི་ཐལ་མོས་དྲི་བྱུག་པའི་ཕྱག་རྒྱ་དང་གནྟེ།",
    "རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་བའི་རོའི་ཕྱག་རྒྱ་དང་རས།",
    "ཐམས་ཅད་ཀྱིས་ལྷ་རང་རང་གི་ཕྱག་ཆེན་བྱེད་འདུག་པས་བྱས་ཀྱང་མི་འགལ་བར་མངོན་ནོ།",
    "ཐལ་མོ་གཉིས་བཀན་ལ་སྙིམ་པའི་ཚུལ་དུ་བྱས་ནས་དཔྲལ་བར་བཅིངས་བཞག་པའི་ནམ་མཁའ་མཛོད་ཀྱི་ཕྱག་རྒྱུ་དང་།",
    "ལག་པའི་སོར་མོ་བསྣོལ་བས་གུང་མོ་གཉིས་རྩེ་སྤྲད་ལ་བཅག་སྟེ་དཔྲལ་བར་བརྗོད་ཅིང་།",
    "མཛུབ་མོའི་རྩེ་མོ་བཀུག་ནས་ནི།",
    "གུང་མོ་མཉམ་པའི་ཚིགས་སུ་སྦྱར།",
    "རྡོ་རྗེ་ཐལ་མོ་ལས་མཐེ་བོང་སྐྱིལ་ཀྲུང་དུ་བསྣོལ་ཏེ་མཐེ་བོང་གཡོན་པས་གཡས་པ་མནན་ནས།",
    "ལག་མཐིལ་ཕན་ཚུན་སྤྲད་ལ་སོར་མོ་ཐམས་ཅད་བསྐྱངས་པ་རྣ་ལྟག་གཡོན་པར་བཞག་ལ།",
    "ལྷོ་སྒོའི་སྐབས་སུ་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་མཛུབ་མོ་གཉིས་བརྐྱང་བ་ཅུང་ཟད་བཀུག་ནས་ལྕགས་ཀྱུ་ལྟར་བྱས།",
    "མཐེའུ་ཆུང་གཉིས་ཁབ་ལྟར་བརྐྱང་བ་དེའི་མགོར་བཞག་པའམ་དེར་མོས་ལ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་བསྒྲེངས་ལ་མཐེ་བོང་དང་མཐེའུ་བསྲང་སྟེ།",
