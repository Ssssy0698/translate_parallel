    "འདིར་མང་པོས་ཁྱོད་ཀྱི་དེ་དང་མི་མཐུན་པས་མི་བྱའོ་ཞེ་ན།",
    "ཁོ་བོ་དང་མི་མཐུན་ན་སྐྱོན་མེད་མོད་མཁས་གྲུབ་ཚད་ལྡན་གང་གི་ཡང་གཞུང་དང་མི་མཐུན་པས་སྐྱོན་ཡོད་དམ་སྙམ་པ་དང་།",
    "མཁས་པ་རང་གིས་དཔྱོད་ཤེས་ཀྱི།",
    "ཞེས་པའི་དོན་ལྟར་མ་སོང་ན་ལེགས་སོ།",
    "དམ་རྒྱའི་སྐབས་འདིར་མ་ཟད་ལས་རྒྱའི་ཀརྨའི་སྐབས་སུ་ལག་པ་ཐལ་མོ་བརྡབ་པས་ཤེས།",
    "སྔགས་ནི་མགོར་མོ་དང་མཐར་ས་བོན་ཡོད་པའི་ཨོཾ་སརྦ་པིར་ཧཱུཾ་ཞེས་པ་ལྟ་བུའོ།",
    "ཡིད་ཀྱི་ལྷ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀར་སྣ་ཚོགས་རྡོ་རྗེ་བསམ་པ་ནི་ནང་གི་ལས་རྒྱའོ།",
    "ཡིད་ཀྱིས་ལྷ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀར་དང་པོའི་རྡོ་རྗེ་རྩེ་ལྔ་བས་མཚན་པར་བསམ་པ་ནི་ནང་གི་ཕྱག་ཆེན་ནོ།",
    "དང་པོའི་དོན་མང་ཡང་འདིར་རྡོར་སེམས་ནི་རྡོ་རྗེ་རྒྱལ་པོ་སོགས་ལྷ་གཞན་ཐམས་ཅད་ཀྱི་དང་པོར་བྱུང་བ་དང་རིགས་ཀྱི་བདག་པོའི་ངོ་བོར་འཇོག་པས་དེའི་ཐུགས་ཀྱི་མཚོན་བྱེད་རང་གི་ཕྱག་མཚན་རྡོ་རྗེ་ལ་དང་བོའི་རྡོ་རྗེ་ཞེས་བྱའོ།",
    "རྩེ་མོ་ལྔ་བ་ཁ་ཅུང་ཟད་གྱེས་པ་ཞིག་ལ་བྱེད་དོ།",
    "རང་རེས་ནི་ཆོ་ག་སོགས་ནས་མི་གསལ་ན་མ་གཏོགས།",
    "འདིར་ལུས་སེམས་རེ་རེ་རྐྱང་པས་འགྲོ་འོང་སོགས་ཀྱིས་བྱ་བ་མི་འགྲུབ་པ་ལྟར།",
    "ལུས་ཀྱི་ཕྱག་རྒྱུ་དང་ནང་གི་ཏིང་ངེ་འཛིན་གཉིས་ཀ་ཚོགས་ནས་ཐོབ་བྱའི་འབྲས་བུ་སྒྲུབ་དགོས་པའི་ཕྱིར་ཏེ།",
    "རང་གི་ཐོབ་བྱའི་ལྷ་དེ་དང་དེའི་སྐུ་གསུང་ཐུགས་མཛད་པ་དང་བཅས་པ་དང་།",
    "རང་གི་ལུས་ངག་ཡིད་གསུམ་བྱ་བ་དང་བཅས་པ་རྣམས་དབྱེར་མེད་དུ་མོས་ནས།",
    "སྔར་གྱི་དོན་དེར་བསྡུས་ཀྱང་རུང་མོད།",
    "ཨོཾ་བུད་དྷཱ་ཨ་བྷི་ཥིཉྩ་ཨོ།",
    "གསུམ་པ་ལས་རྒྱལ་མཆོག་གི་ཏིང་ངེ་འཛིན་ལ་གསུམ།",
    "རྩ་རིག་བཟླ་ཞིང་ལྷ་དེ་དང་དེར་མོས་ནས།",
    "ལྷ་རེ་རེ་ལ་འཕྲིན་ལས་རེ་རེ་དང་།",
    "དེའི་ཚེ་ལྷ་རང་རང་གི་ཐུགས་ཀར་ཟླ་བའི་སྟེང་དུ་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བར་རང་རང་གི་ས་བོན་གྱིས་མཚན་པ་ལས་འོད་འཕྲོས་པ་དང་།",
    "སྤྲུལ་པ་དཔག་ཏུ་མེད་པར་སྤྲུལ་ནས་སོང་སྟེ།",
    "མེ་ཏོག་གི་དྲི་བཟང་པོ་དང་།",
    "དྲི་བཟང་གི་སྤགས་པའི་ཆུའམ་དྲི་བཟང་འགའ་ཞིག་འདེབས་པར་གསུངས་པ་ལྟར་བྱས་ན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "ལྷ་ལ་མི་གཙང་བའི་ཆུ་སོགས་གང་བྱུང་གིས་ཆོག་ལ།",
    "སྟོང་བའི་ངང་ལས་མཆོད་རྫས་རྣམས་ཀྱི་གོ་སར་མི་གེ་ཨོཾ་རེ་རེ་བསམ།",
    "ཡང་དེའི་ནང་དུ་ཨོ་རེ་རེ་བྱུང་བ་འོད་དུ་མེར་གྱིས་ཞུ་བས།",
    "དེ་ཐམས་ཅད་དྭངས་ཤིང་ཐོགས་པ་མེད་པ་ཟག་མེད་ཀྱི་ཡེ་ཤེས་གྱི་བདག་ཉིད་དུ་མོས་པས་བསྐྱེད་དེ།",
    "རང་རང་གི་སྔགས་དང་ཕྱག་རྒྱས་བྱིན་གྱིས་བརླབས་ནས་བརྟན་པར་བྱའོ།",
    "ལྷ་མོ་སྤྲོ་བའི་ཚེ་སེ་གོལ་ཕར་བསྟན་པ་དང་།",
    "ལྷ་མོ་རང་རང་གི་ང་རྒྱལ་གྱིས་དེའི་ཕྱག་རྒྱུ་བྱ་ཞིང་ས་བོན་ལས་རང་འདྲའི་མཆོད་བའི་ལྷ་མོ་སྤྲོས་ཏེ་མཆོད་ནས་རང་ལ་བསྡུ་བར་བྱ་ཞིང་།",
    "དེ་ཡང་ཚིགས་བཅད་དང་པོ་འདིས་རྣམ་སྣང་གི་སྐུའི་དཀྱིལ་འཁོར་དང་།",
    "རྟག་ཏུ་དྲི་མ་མེད་པ་སོགས་གསུམ་པས་རིན་འབྱུང་གི་རིགས་དང་།",
    "འོད་དཔག་མེད་སོ་སོར་རྟོགས་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་གསུང་གི་ངོ་བོ།",
    "ལྷ་རང་རང་གི་སྔགས་དང་རྩྭ་སྔགས་རྣམས་ཡིན་ལ།",
    "བསྐལ་བཟང་གི་སེམས་དཔའ་ལ་སརྦ་སཾ་སཱ་རི་སོགས་ཡིན་ནོ།",
    "རྩ་རིག་བཅུ་པ་ནི་ཐུན་མོང་དུ་ཡིན་ལ།",
    "བསྐལ་བཟང་གི་སེམས་དཔའ་སོགས་ལ་རང་རང་གི་སྔགས་ཐུན་མོང་མིན་པ་གཞན་སྐབས་འདིར་བཟླ་བ་མ་ཡིན་ཡང་།",
    "ཐུན་མོང་དུ་སཾ་སྭཱ་རི་དང་།",
    "གཞན་ཉན་ཐོས་རང་རྒྱལ་ཁྲོ་བོ་རྣམས་ལ་རྩ་རིག་གང་འོས་བ་རེ་བཟླ་དགོས་པར་མངོན་ནོ།",
    "དེ་ཡང་ལྷ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀར་རང་རང་གི་ས་བོན་ལ་བཟླས་པའི་སྔགས་ཀྱིས་བསྐོར་པའི་དམིགས་པ་བྱ་སྟེ།",
    "ཐུགས་ཀར་ཟླ་བའི་གདན་གྱི་སྟེང་དུ་ཨོཾ་ཡིག་གི་མཐར་ཨོཾ་སརྦ་བིད་ཡ་ཨཱ་ཝ་ར་ཎ་ཞེས་སོགས་ཀྱི་སྔགས་དང་།",
    "གཙོ་འཁོར་ཐམས་ཅད་ཀྱི་ཞལ་ནས་སྔགས་འདོན་པར་བསམ་མོ།",
    "གྲངས་ངེས་ཅན་མེད་ཀྱང་ལྷ་འགྲུབ་པའི་རྟགས་མ་བྱུང་གི་བར་དུ་བཟླ་བ་དང་།",
    "སྔགས་རིམ་ཆེན་མོ་ལས།",
    "བསྙེན་པ་གང་མ་སོང་བ་དང་།",
    "ད་དུང་ཐོག་མར་རང་ཉིད་ངན་སོང་ལས་ཐར་བའི་ཐབས་བྱས་ནས་དེ་རྗེས་གཞན་གྱི་དོན་བྱས་ན་ལེགས་པར་སེམས་ཏེ།",
    "འདི་རྣམས་ཀྱི་མཚན་ནམ་ཐོས་ཤིང་དྲན་པས་ཀྱང་ངན་སོང་ལས་གྲོལ་ནུས་ན་ཆོ་ག་ཚད་ལྡན་དང་རྗེས་མཐུན་གང་བྱས་ཀྱང་ལྟ་ཅི་སྨོས།",
    "ཆུ་གཉིས་ཉེར་སྤྱོད་རོལ་མོ་དང་བཅས་པ་སྔགས་དང་ཕྱག་རྒྱ་ཙམ་གྱིས་མཆོད་ལ།",
    "ཁྲུས་དང་ཉེ་རེག་བྱས་ཏེ་ནང་དུ་ཞུགས་ལ།",
    "འདིར་རྡུལ་ཚོན་གྱིས་སྐབས་སུ་གཤེགས་གསོལ་བྱེད་པའི་ཚེ་ལྟར་ལྷ་རེ་རེ་ནས་དམ་རྒྱ་བགྲོལ་སྟེ་གཤེགས་པར་བྱས་མཆོག་མོད།",
    "ལྷ་རེ་རེ་ནས་དམ་རྒྱ་དཀྲོལ་ཏེ་གཤེགས་པར་གསུངས་པ་ལྟར་རོ།",
    "དེ་ནས་སྟེང་གི་ཕྱག་མཚན་ཕྲ་མོ་བསྒོམས་པའི་ཕྲ་མོའི་རྣལ་འབྱོར་བྱའོ།",
    "དེ་ལྟར་བསྙེན་སྒྲུབ་སྔོན་དུ་སོང་ནས།",
