    "བྱེའགལ་བ་དམིགས་པའི་ཐལ་བར་འགྱུར་བའོ།",
    "གང་གི་ཕྱིར་ཏིལ་ལ་སོགས་པས་ཏིལ་མར་ལ་སོགས་པའི་འབྲས་བུ་གང་ཞིག་བྱེད་དེ།",
    "དེ་བཞིན་དུ་བདག་སང་བྲམ་ཟེ་ལ་སྟོན་མོ་བྱའོ་སྙམ་ནས་ཞོ་དོན་དུ་གཉེར་བ་འོ་མ་ཉིད་ལན་སྐྱེགྱི་ཆུ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་ཁྱོད་ཀྱི་ལུགས་ཀྱིས་འབྲས་བུ་མེད་པ་སྐྱེའི་ཞེས་བྱ་བ་ཡིན་ན་དེའི་ཚེ།",
    "ཁྱོད་ཀྱི་ལུགས་ཀྱིས་བརྗོད་པར་འདོད་པའི་རྩྭ་ལ་སོགས་པའི་དངོས་པོའི་བདག་ཉིད་བྲལ་བར་སྐྱེ་བ་དང་ལྡན་པའི་དངོས་པོ་ཐམས་ཅད་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྔར་ནི་རྒྱུའི་སྒོ་ནས་ཐལ་བར་འགྱུར་བ་བརྗོད་ལ།",
    "འོན་ཏེ་གང་གིས་དེ་ཁྱེད་ཅག་འགེགས་པར་བྱེད་པ་མི་ནུས་པ་ཁོ་ན་བྱེད་དོ་ཞེས་བྱ་བ་འདི་སུ་ཞིག་གིས་སྨྲས།",
    "དེ་ཡང་དེ་དག་གིས་བྱ་བར་མི་ནུས་པ།",
    "གང་ངོ་བོ་མེད་པ་དེ་ནི་རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་དུ་ཁྱད་པར་བྱར་མེད་ཅིང་ཁྱད་པར་རྔུ་བསྒྲུབ་ཏུ་མེད་པ་ཡིན་ནོ།",
    "ཁྱད་པར་གྱི་རང་བཞིན་བསྒྲུབ་ཏུ་མེད་པ་ལྟ་བུ་དེ་ཇི་ལྟར་འགའ་ཞིག་གིས་བྱ་བར་ནུས།",
    "གང་གི་ཕྱིར་རྣམ་པར་འགྱུར་བར་འདོད་པ་གང་ཡིན་པ་དེ་ནི་བདག་ཉིད་ཀྱི་རང་བཞིན་ཀྱིས་ངོ་བོ་མེད་པ་ཞེས་བྱ་བར་བརྗོད་པ་ཡིན་ཏེ།",
    "ནམ་མཁའི་པད་མ་བཞིན་དུ་གང་གིས་ཀྱང་མི་ནུས་པ་བྱ་བ་ཡང་མ་ཡིན་པ་ཁོ་ནའོ།",
    "རེངས་པ་དང་།",
    "དེའི་ཕྱིར་གང་གིས་གསལ་བ་སྐྱེད་པར་བྱེད་པའི་གཙོ་བོའི་རྔུནུས་པ་ཡོད་དོ་ཞེས་བསྒྲུབ་པར་བྱའོ།",
    "རྒྱུ་དང་འབྲས་བུ་རྣམ་པར་དབྱེར་ཡོད་པའི་ཕྱིར་འཇིག་རྟེན་འདི་ནི་རྒྱུ་དང་འབྲས་བུ་དག་གི་རྣམ་པར་དབྱེ་བ་མཐོང་སྟེ།",
    "སོགས་པའི་སྒྲ་རེ་རེ་དང་སྦྱར་བར་བྱའོ།",
    "དེ་ལ་རེ་ཞིག་གཙོ་བོ་ཁོ་ན་ལས་འབྲས་བུའི་ཁྱད་པར་འདི་དག་དེའི་ངོ་བོར་རབ་ཏུ་འབྱུང་ངོ་ཞེས་གང་སྨྲས་པ་དེ་ལ་འདི་དཔྱད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་ཁྱེད་ཅག་གིས་རྩ་བའི་རང་བཞིན་ནི་རྒྱུ་ཁོ་ན་ཡིན་ལ།",
    "ཕན་ཚུན་ཐ་དད་པ་མ་ཡིན་པའི་ཕྱིར་ཐམས་ཅད་རྒྱུའམ་འབྲས་བུ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་འམ།",
    "དེའི་ཕྱིར་ལྷན་ཅིག་སྐྱེ་བ་དང་འཇིག་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ནི་རང་གི་ངོ་བོ་བཞིན་དུ་ངེས་པ་ཉིད་ཡིན་ཏེ།",
    "གཞན་དུ་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "གང་གིས་གཙོ་བོ་ལས་ཆེན་པོ་དང་།",
    "གང་གིས་གཙོ་བོ་ལས་འབྲས་བུའི་ཁྱད་པར་སྐྱེད་ཞུ་པ་ཉིད་དུ་འགྲུབ་པར་འགྱུར་བ་རྟག་པ་ལ་ནི་རྒྱུའི་དངོས་པོ་ཡོད་པ་ཡང་བྱེམ་ཡིན་ཏེ།",
    "རྟག་པ་ནི་རིམ་དང་རིམ་མ་ཁྱཡིན་པ་དག་གིས་དོན་བྱེད་པ་འགལ་བའི་ཧཱུཾཕྱིར་རོ།",
    "འདི་སྙམ་དུ་གང་གིས་ངོ་བོ་ཐ་དད་མེད་པ་ན་དེ་འགལ་བར་འགྱུར་བ་ཁོ་བོ་ཅག་ནི་སྔ་ཛེེན་མེད་པའི་རང་བཞིན་སྐྱེ་བས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མི་འདོད་དེ།",
    "གང་གི་ཕྱིར་གཙོ་བོ་སྦྲུལ་འཁྱིལ་རྐྱེཔ་ལ་སོགས་པ་བཞིན་དུ་ཆེན་པོ་ལ་སོགས་པའི་ངོ་བོར་ཡོངས་སུ་འགྱུར་བར་འགྲོ་བས་ཆེན་པོ་ལ་སོགས་པ་དེ་དག་གི་རྒྱུ་ཡིན་ནོ་ཞེས་པྱབསྟན་ལ།",
    "རྒན་པོ་ཉིད་ལ་སོགས་པའི་གནས་སྐབས་ན་ཡང་ལོང་ཚོ་ཉིད་ལ་སོགས་པའི་གནས་སྐབས་རྣམས་དམིགས་པར་ཐལ་བའི་རྔུ་ཕྱིར་རོ།",
    "འོན་ཏེ་ཡོངས་སུ་དོར་ནས་ཡིན་ན་དེའི་ཚེ་རང་གི་ངོ་བོ་ལས་ཉམས་པར་ཐལ་བར་འགྱུར་རོ།",
    "གཞན་དུ་འགྱུར་བ་དེ་ཡང་ཕྱོགས་གཅིག་གིས་སམ།",
    "རེ་ཞིག་ཕྱོགས་གཅིག་གིས་ནི་མ་ཡིན་ཏེ།",
    "དོན་གཞན་སྐྱེ་བ་ན་སྔ་མ་འཇིག་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དོན་གཞན་དུ་གྱུར་པའི་སྣམ་བུ་དང་རྟ་དག་སྐྱེ་བ་དང་འཇིག་པ་ན་གཡོ་བ་མེད་པའི་བདག་ཉིད་ཀྱི་རང་གི་ངོ་བོའི་བུམ་པ་ལ་སོགས་པ་ཡོངས་སུ་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རེ་ཞིག་ཡོད་པ་ལ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་རི་བོང་གི་རྭ་ལ་སོགསརཱ་རྣམས་ནི་འགའ་ལ་ཡང་བརྟེན་པར་མི་རིགས་སོ།",
    "གང་ལ་གནས་སྐབས་ཐ་དད་ཀྱང་བདག་ཉིད་དུ་༧གྱུར་པའི་རང་བཞིན་གཅིག་རྗེས་སུ་འཇུག་པ་ན་དེ་ལ་ཁྱེད་ཅག་གིས་ཡོངས་སུ་འགྱུར་བར་རྣམ་པར་གཞག་ལ།",
    "རང་བཞིན་གཅིག་གི་བདག་ཉིད་དུ་བྱེ་གྱུར་པ་རྗེས་སུ་འཇུག་པ་མ་ཡིན་ནོ།",
    "རེ་ཞིག་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ཉིད་སུན་འབྱིན་པར་བྱེད་པ་ནི།",
    "དེ་དག་གིས་སྨྲས་པའི་མེད་པ་མི་བྱེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པས་རྩོད་པ་ལྔ་བྱས་པ་གང་ཡིན་པ་དེ་ནི་ཡོད་པ་ལ་ཡང་སྟེ།",
    "འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ཁྱེད་ཅག་གི་རྩོད་པའི་ལེན་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་མེད་པར་སྨྲ་བ་བློ་བཟངས་ཏེ།",
    "རྣམ་པར་སྨིན་པ་ལ་སོགས་པ་བདག་ཉིད་ཐམས་ཅད་ཀྱི་ཁྱད་པར་གྱི་དབྱེ་བའི་ངོ་བོས་ཞོ་ལ་སོགས་པའི་གནས་སྐབས་བཞིན་དུ་ཡོད་པ་དེའི་ཚེ་དེ་དག་ཡོད་ན་གང་གིས་དེ་དག་པེའོ་མ་ལ་སོགས་པའི་རྒྱུས་བསྐྱེད་པར་བྱ་བར་འགྱུར་བ་དུབསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཅི་ཞིག་ཡོད།",
    "དེ་དག་གི་སྒྲ་ནི་ཞོ་ལ་སོགས་པའི་གནས་སྐབས་ཡང་བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པར་གྲུབ་པའི་ངོ་བོ་བཟུང་ངོ།",
    "སྦྱོར་བ་ནི་གང་ཞིག་རྣམ་པ་ཐམས་ཅད་ཀྱིས་ཡོད་པ་དེ་ནི་སུ་ཞིག་གིས་ཀྱང་བསྐྱེད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "གཞན་གྱི་འདོད་པས་འོ་མ་ལ་སོགས་པའི་གནས་སྐབས་སུ་ཡང་ཞོ་ལ་སོགས་པའི་འབྲས་བུ་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་ཡོད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པའི་ཐལ་བར་འགྱུར་བའོ།",
    "ཁྱད་པར་བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པ་ཡང་བསྐྱེད་པར་བྱ་བ་ཉིད་ཡིན་ན་ཐམས་ཅད་བསྐྱེད་པར་བྱ་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་དང་།",
    "བསྐྱེད་ཟིན་པ་ཡང་བསྐྱེད་པར་བྱ་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་གཉི་ག་ཡང་ཐལ་བ་སྒྲུབ་རྔུཔ་ཡིན་ཏེ་དེས་ན་གཉི་ག་ལ་གྲུབ་པའི་དཔེས་ཅི་ཞིག་བྱ།",
    "དེས་ཐམས་ཅད་འབྲས་བུ་མ་ཡིན་པར་ཐལ་བར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་ཡོད་པ་ཡིན་ན་དེའི་ཚེ་ཁྱེད་ཅག་གིས་གཏན་ཚིགས་གཉི་ག་ཡང་མ་གྲུབ་པ་ལ་སོགས་པ་ལ་ལན་བཏབ་པ་འགའ་ཡང་མེད་དོ།",
    "དེ་ལྟར་རེ་ཞིག་མེད་པ་མི་བྱེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་བསྒྲུབས་ནས།",
    "དེའི་ཕྱིར་འབྲས་བུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གཏན་ཚིགས་ཐམས་ཅད་ཐལ་བ་ལས་བཟློག་པར་སྦྱར་བར་བྱའོ།",
    "གང་གི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་ཐམས་ཅད་རང་གི་ཡུལ་ལ་འཇུག་པ་ན།",
    "འདི་ལྟར་ཁྱེད་ཅག་གི་ལུགས་ཀྱིས་ཐེ་ཚོམ་དང་ཕྱིན་ཅི་ལོག་དག་སེམས་པ་ཁྱེཅན་གྱི་བདག་ཉིད་ཡིན་ནམ།",
    "དེའི་ཕྱིར་འདི་ལ་ཁྱེད་ཅག་གིས་སྒྲུབ་པར་བྱེད་པ་གང་ཡིན་པ་ཏྲེའདི་སྨྲས་པ་དེ་ཀུན་ཏེ་ཐམས་ཅད་དོན་གྲེད་པ་ཡིན་ནོ།",
    "འདི་ཤྱིནི་རང་གི་ཚིག་དང་འགལ་བ་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་བཀག་པའི་ཕྱིར་རང་གི་ཚིག་དང་འགལ་ལོ།",
    "ཇི་ལྟར་འདི་མེད་ན་ཡང་ནུས་པའི་རྒྱུ་དག་གིས་བྱེད་པ་དང་།",
    "ཅི་སྟེ་སྒྲུབ་པར་བྱེད་པའི་སྤྱོར་བ་ལས་སྔར་ངེས་པ་ཡོད་པ་ཡིན་མོད་ཀྱི།",
    "དེ་ལ་རེ་ཞིག་རང་བཞིན་གྱི་ཁྱད་པར་བསྐྱེད་ཐུཔ་ནི་མ་ཡིན་ཏེ་འདི་ལྟར་རང་བཞིན་གྱི་ཁྱད་པར་འདི་ངེས་པའི་རང་གི་ངོ་བོ་ལས་ཐ་མི་དད་པའམ།",
    "ངེས་པའི་རང་གི་ངོ་བོ་བཞིན་དུ་ཐམས་ཅད་དུ་གནས་པས་སྐྱེ་བར་མི་རིགས་སོ།",
    "རེ་ཞིག་དང་པོ་ནི་མ་ཡིན་ཏེ།",
    "ཕན་པ་འུཡིན་ན་ཡང་ཕན་འདོགས་པར་བྱེད་པ་དེ་ཐ་དད་པ་ཉིད་ཡིན་ན་འབྲེལ་པ་མ་གྲུབ་ཅིང་ཐུག་པ་མེད་པ་ཀྱེསྣཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁྱད་པར་རྟག་ཏུ་སྐྱེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དེའི་ཡུལ་ཡང་དག་པར་རིག་པ་གང་ཡིན་པ་དེ་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ཁྱེད་ཅག་གི་ལུགས་ཀྱིས་རྟག་པ་ཉིད་ཡིན་པའི་ཕྱིར་དེ་ཅི་ཞིག་བསྐྱེད་པར་བྱ་བར་འགྱུར།",
    "ཡང་གི་སྒྲ་ནི་སྡུད་པ་དང་།",
    "སྤྲོ་བ་ནས་སྡུད་པའི་བར་དུ་བློ་ནི་གཅིག་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གྲུབ་པའི་མཐའ་ཡིན་པའི་ཕྱིར་ཁྱེད་ཅག་གི་ལུགས་ཀྱིས་རིག་པ་ནི་གཅིག་ཉིད་ཡིན་ང་ཧཱུཾལ་དེ་ཉིད་ངེས་པ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་གྱེ་ཐ་སྙད་ཐམས་ཅད་ཆད་པར་ཐལ་བ་ཡང་མི་ཟློགས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཐ་སྙད་ཐམས་ཅད་ཆད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་བསལ་ནས།",
    "དེ་ལ་རེ་ཞིག་དེ་ནི་བྱ་བར་མི་ནུས་ཏེ།",
    "གང་གིས་དེ་ཉིད་རང་བཞིན་མེད་པར་འགྲུབ་པར་འགྱུར་བ་སྐྱེ་བ་ལས་སྔར་བྱ་བའི་དངོས་པོ་དེ་ཡོད་པ་ཡང་མ་ཡིན་ནོ།",
    "གང་གིས་དེ་མི་བྱེད་པ་ཁྱེད་ཅག་གི་ལུགས་ཀྱིས་མེད་པ་ནི་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ།",
    "རྒྱུའི་ནུས་པ་ངེས་པའི་ཕྱིར་ཡོད་པ་ཡིན་ན་ཡང་རི་བོང་གི་རྭ་ལ་སོགས་པ་མི་བྱེད་དོ་ཞེ་ན།",
    "གང་གི་ཡང་དཔེར་ན་ཁྱེད་ཅག་གི་ཡོན་ཏན་གསུམ་དང་ལྡན་པ་ཐམས་ཅད་དུ་ཁྱད་པར་མེད་ན་ཡང་ནུས་པ་ངེས་པའི་ཕྱིར།",
    "དེ་ལྟ་བུར་གྱུར་པའི་རང་བཞིན་གྱེ་ཁྱད་པར་ངེས་པ་ནི་རང་གི་རྒྱུ་བརྒྱུད་པ་ལས་ཡང་དག་པར་ཇེའོངས་པའི་ཕྱིར་འགལ་བ་མེད་དོ།་།",
    "དཔེར་ན་རི་བོང་གི་རྭ་ལ་སོགས་པ་བཞིན་ནོ།",
    "རང་གི་ཕྱོགས་ལེགས་པར་གནས་པར་བསྟན་པའི་ཕྱིར།",
    "འདི་ལྟར་ངེས་པ་དེ་དག་མ་གྲུབ་པ་ན་གལ་ཏེ་ཞོ་སྐྱེད་པ་ལ་འོ་མ་ནུས་སོ་ཞེས་བྱ་བའི་ཐ་སྙད་འདི་མེད་དུ་ཟད་མོད།",
    "གང་ཡང་རྣམ་པ་དེ་ལྟ་བུའི་ཁྱད་པར་ཐམས་ཅད་ཀྱིས་སྟོང་པ་སྒོ་མ་བཏགས་པའི་དངོས་པོ་སྔར་མ་མཐོང་བ་གང་གི་དེ་མ་ཐག་ཏུ་རྙིདངོས་པོ་གཞན་སྐྱེ་བ་དེ་ལ་འགག་པ་རྔེད་དོ།",
    "ཁྱད་པར་བྱེད་པའི་རང་བཞིན་ཉིད་ལོག་ན་རང་གི་ཁྱད་པར་བྱ་བ་ལྡོག་པར་བྱེད་ལ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གིས་དེ་ལོག་པ་ན་རྣམ་པ་དེ་ལྟ་བུའི་དངོས་པོ་ལྡོག་པར་འགྱུར་བ་འོ་མ་ལ་ནི་ཞོའི་ངྐུནུས་པ་ཡོད་དོ་ཞེས་བྱ་བ་ནི་དེ་ལྟ་བུ་ལ་སོགས་པའི་མིང་སྟེ།",
    "ཐ་སྙད་དངོས་པོ་རྣམས་ཀྱི་རང་གི་ངོ་བོའི་རང་བཞིན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གིས་དེ་སྡོག་པ་ན་དེ་ལྟ་བུའི་རྣམ་པའི་དངོས་པོ་ལྡོག་པར་འགྱུར་རོ།",
    "འདི་ལྟར་ནི་གང་གི་ཕྱིར་ཏེ།",
    "དངོས་པོའི་རང་གི་ངོ་བོ་བཞིན་དུ་སྒྲ་དང་རྣམ་པར་རྟོག་པ་རྣམས།",
    "གཅིག་གི་ངོ་བོ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གིས་འགྱུར་བ་ཡིན་ན་དེའི་རང་བཞིན་ཉམས་པར་ཐལ་བར་འགྱུར་བ་ཁོ་བོ་ཅག་གིས་ནི་མེད་པ་བྱེད་དོ་ཞེས་མ་བརྗོད་དོ།",
    "བྱ་བ་དང་འབྱེལ་པས་འགའ་ཞིག་གིས་འགའ་ཞིག་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཁྱེད་ཅག་གི་ལུགས་ཀྱིས་མེད་པ་ཉིད་སྐྱེའོ་ཞེས་བྱ་བ་མ་ཡིན་ནམ།",
    "འང་གི་སྒྲ་ནི་ངེས་པར་བཟུང་བའི་དོན་ཏོ།",
    "རང་གི་རྒྱུ་འདུ་བ་ཡང་མ་ཡིན་ཏེ་དེ་དག་ཀྱང་འགེགས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བྱེད་པས་རྒྱུ་ནི་ཡིན་པར་གྲགས་ཅེ།",
    "གང་གི་མཕྱིར་མེད་པ་ནི་མེད་པར་ཡང་འགྱུར་བ་མ་ཡིན་ནོ།",
    "ཡང་གང་གིས་འདི་ལྟ་བུའི་ཐ་སྙད་འདི་འདོད་པས་བརྟགས་པའི་ས་བོན་གང་ཞིག་ཡིན་ཞེ་ན།",
    "གཅིག་གི་རྗེས་ལ་དངོས་པོ་ཡི།",
    "གཅིག་གི་སྟེ་སོ་སོར་ངེས་པའི་དངོས་པོ་གང་ཡིན་པ་འགའ་ཞིག་གི་དེ་མ་ཐག་ཏུ་སྔར་མ་མཐོང་བའི་དངོས་པོ་དམིགས་ཏེ།",
    "ཁྱེད་ཅག་གིས་རྒྱུ་ལ་འབྲས་བུ་ཡོད་དོ་ཞེས་གང་བརྗོད་པ་དེ་ནི་དོན་ཅི་ལ་བསམས།",
    "གལ་ཏེ་གསལ་བའི་ངོ་བོས་ཡིན་ན་དེའི་ཚེ་འོ་མ་ལ་སོགས་པའི་གནས་སྐབས་ན་ཡང་ཞོ་ལ་སོགས་པ་ཕྱིས་བཞིན་དུ་དམིགས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དེ་ཉིད་ཡིན་གལ་ཏེ་དེ་ཉིད་ཡིན་ན་དེའི་ཚེ་སྔ་མ་བཞིན་དུ་དམིགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་བདེ་བ་ལ་སོགས་པ་ནི་ནང་གི་ཡིན་པས་རིག་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་།",
    "གང་གི་ཕྱིར་དེ་ཉིད་མ་གྲུབ་སྟེ།",
    "ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་གྲངས་དག་གིས་བསྟན་ཏོ།",
    "སིམ་པ་དང་སིམ་པ་མ་ཡིན་པར་མྱོང་བ་གང་ཡིན་པ་འདི་ཉིད་ཁོ་བོ་ཅག་གི་བདེ་བ་དང་སྡུག་བསྔལ་ཡིན་ནོ།",
    "སྔོན་པོ་ལ་སོགས་པའི་ངོ་བོར་སྣང་བ་དེ་བཞིན་དུ་སེམ་པ་མ་ཡིན་པ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཡིན་ན་ཡང་ཕྱི་རོལ་གྱི་བདེ་བ་ལ་སོགས་པའི་ཉེ་བར་ལེན་པའི་སྟོབས་ཀྱིས་སེམ་པ་ལ་སོགས་པའི་ངོ་བོ་བཞིན་དུ་རློམ་མོ།",
    "རིགས་ནི་རང་གི་རང་བཞིན་ནོ།",
    "དེ་དག་གི་བྱེ་བྲག་ནི་ཁྱད་པར་རོ།",
    "འདི་ལྟར་གོམས་པའི་ཁྱད་པར་གྱིས་ཆང་དང་བུད་མེད་ལ་༥སོགས་པ་རྣམས་ལ་སྡུག་པ་དང་མི་སྦུག་པའི་མཚན་མར་གོམས་པའི་འདོད་པ་ལ་སོགས་པ་རྣམས་དང་རིགས་ཀྱི་ཁྱད་པར་ཡང་སྟེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་ཡུལ་ཅན་གྱི་རིག་པ་བཞིན་དུ་རིག་པ་རེ་རེ་ཡང་སྣ་ཚོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "འདི་སྙམ་དུ་དངོས་པོ་གསུམ་གྱེ་བདག་ཉིད་ཡིན་མོད་ཀྱི་འོན་ཀྱང་མ་མཐོང་བ་ལ་སོགས་པ་ལ་སྟེ།",
    "ཅེས་བྱ་བའི་སྐྱེས་བུ་དེ་དག་གི་རིག་པ་ནི་ཡང་དག་པར་རིག་པ་དག་སྟེ།",
    "རེ་རེ་ལ་ཡང་ཞེན་པ་ལ་སོགས་པ་ཙམ་ངོ་བོ་གཅིག་ངེས་པའི་ཕྱིར།",
    "སྦྱོར་བ་ནི་གང་ཞིག་གང་གི་རྣམ་པ་རིག་པ་མ་ཡིན་པ་དེ་ནི་དེའི་ཡུལ་ཅན་མ་ཡིན་ཏེ།",
    "དཔེར་ན་མིག་གི་རྣམ་པར་ཤེས་པ་སྒྲའི་ཡུལ་ཅན་མ་ཡིན་པ་ཧཱུཾབཞིན་ནོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བ་ནི།",
    "གཞན་དག་གིས་དགའ་བ་ལ་སོགས་པ་ནི་དོན་དམ་པར་དངོས་པོའི་ཡུལ་ཅན་ཉིད་ཡིན་པར་འདོད་དེ།",
    "རང་གི་དོན་རྟོགས་པ་གང་ཡིན་པ་དེ་འདི་ཉིད་ངེས་པ་རྣམས་ཀྱི་ངེས་པ་ཡིན་ནོ།",
    "གཞན་དག་གིས་སྐྱེས་བུ་དེ་ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་དེའི་ངོ་བོར་འདོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་གསལ་བ་ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་དུ་གྲུབ་པ་ལྐུཡིན་མོད་ཀྱི།",
    "འབྲས་བུ་གང་གི་བདག་ཉིད་དུ་གྱུར་པ་དམིགས་པ་རྒྱུ་ཐུརྣམས་ཀྱང་གདོན་མི་ཟ་བར་དེའི་བདག་ཉིད་དུ་འགྱུར་བར་བྱ་དགོས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་གསལ་བ་ཞེས་བྱ་བའི་འབྲས་བུ་དེ་གཅིག་པུ་ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་ཀྱི་རང་གི་ངོ་བོར་གྱུར་པའི་རིགས་དང་ལྡན་པར་གྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "རྟག་པ་ནི་རིམ་དང་རིམ་མ་ཡིན་པ་དག་གི་བྱེ་དོན་བྱེད་པར་འགལ་བའི་ཕྱིར་དང་།",
    "འོ་ན་ཅི་ཊྭཱལྟར་ཡོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གཅིག་གི་ངོ་བོ་དང་།",
    "དོན་རྣམས་ལ་གཅིག་གི་བདག་ཉིད་དུ་འཛིན་པ་འདི་ནི་ལོག་པའི་རྣམ་པར་རྟོག་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་རེ་ཞིག་རྗེས་སུ་འགྲོ་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་མ་གྲུབ་པ་དང་འགལ་བ་དང་མ་ངེས་པ་ཉིད་དུ་བསྟན་ནས།",
    "འོན་ཏེ་འཇི་བའི་གོང་བུ་དང་གསེར་ལ་སོགས་པ་གཅིག་དེ་དག་གི་རྒྱུར་གྲུབ་པ་ཉིད་ཡིན་ལ།",
    "དེ་བཞིན་དུ་འཇི་བ་དང་གསེར་ལ་སོགས་པའི་རིགས་དེ་དག་གི་རྗེས་སུ་འགྲོ་བར་མཐོང་བ་མ་ཡིན་ནམ།་",
    "ཕྱོགས་གཅིག་བསྒྲིབས་པ་ན་ཐམས་ཅད་བསྒྲིབས་༥་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ཁྱེད་ཅག་གིས་ནི་དེ་དག་རྣམ་པ་དེ་ལྟ་བུའི་རྒྱུ་གཅིག་སྔོན་དུ་འགྲོ་བ་ཅན་དུ་ཡང་མི་འདོད་དོ།",
    "གང་གི་ཕྱིར་སྐྱེས་བུ་ཐམས་ཅད་སེམས་པ་ཅན་ལ་སོགས་པ་ལས་ལྡོག་པ་དེས་ན།",
    "གལ་ཏེ་དེ་ལྟ་ན་བདེ་བ་ལ་སོགས་པ་དང་ལྡན་པ་ཉིད་དེ་ལྟ་བུར་གྱུར་པའི་རྒྱུ་གཅིག་སྔོན་དུ་སོང་བ་ཉིད་མེད་ན་ཡང་དངོས་མ་ཡིན་པའི་སྐྱེས་བུ་བཞིན་དུ་གསལ་བ་འདི་ལ་ཡང་ཅིའི་ཕྱིར་མཚུངས་པ་སྟེ།",
    "དེ་ལྟར་རེ་ཞིག་རྗེས་སུ་འགྲོ་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་བཀག་གོ།",
    "དེ་ལ་རེ་ཞིག་ཚད་ཡོད་པའི་ཕྱིར་དང་།",
    "འདི་ལྟར་གལ་ཏེ་རེ་ཞིག་རྒྱུ་ཙམ་ཡོད་པ་ཉིད་དུ་སྒྲུབ་པ་དེའི་ཚེ་གྲུབ་ཧཱུཾཔ་ལ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "རྟོག་པ་དང་ལྡན་པའི་བྱེད་པ་པོ་མེད་ན་ཡང་རང་གི་རྒྱུའི་ནུས་པ་ལས་ཚད་ངེས་པ་ལ་སོགས་པ་དང་ལྡན་པ་སྐྱེད་པ་ལ་འགལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "ནུས་པ་རྣམས་ནི་རང་གི་བདག་ཉིད་དུ་གྱུར་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཐིམ་པར་འགྱུར་བ་རང་གི་ངོ་བོ་ཐམས་ཅད་ཞིག་པ་ལའམ་བྱེ།",
    "གལ་ཏེ་རེ་ཞིག་ཞིག་པ་ལ་ཡིན་པ་དེའི་ཚེ་རྗེས་སུ་འགྲོ་བ་གྲེད་པར་འཇིག་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཀྱང་གི་སྒྲ་ནི་ངེས་པར་གཟུང་བའི་དོན་ཏོ།",
    "འདི་ལྟར་གང་གི་ཚེ་གསལ་བའི་རྒྱུ་གཙོ་བོ་ཡིན་ན།",
    "འོན་ཀྱང་དེ་ནི་སེམས་པ་མེད་པ་ཡིན་པའི་ཕྱིར་བྱེན་གྱིས་ཟློབ་པ་པོ་མེད་པར་རང་ཉིད་ཀྱིས་རང་གི་འབྲས་བུ་རྩོམ་པར་ནུས་པ་མ་ཡིན་ནོ།་།",
    "སྤྱོར་བ་ནི་གང་སེམས་པ་མེད་པ་དེ་ནི་བྱིན་གྱིས་རློབ་པ་པོ་མེད་པར་རང་གི་འབྲས་བུ་རྩོམ་པ་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ཆེན་པོ་ཉིད་དང་།་",
    "རྡུལ་ཕྲ་རབ་ལ་སོགས་པ་ལ་ཐལ་བར་འགྱུར་བ་མེད་དོ།",
    "ལུས་ལ་སོགས་པའི་ཉེ་བར་ལེན་པའི་རྒྱུར་རྡུལ་ཕྲ་རབ་ལ་སོགས་པ་སེམས་པ་ཅན་གྱི་རྒྱུས་བྱིན་གྱེས་བརླབས་པ་ཡོད་ན་རང་གི་འབྲས་བུ་བྱེད་ཅེས་འབྱེལ་ཏོ།",
    "གསལ་བྱེད་པ་ནི་གནས་པ་ལ་སོགས་པའི་རྒྱུ་གཙོ་བོ་རྡུལ་ཕྲ་རབ་དང་མ་མཐོང་བ་རྣམས་ནི་རང་གི་འབྲས་བུ་སྐྱེད་པ་ལ་ཁྱད་པར་དུ་འཕགས་པའི་བློ་དང་ལྡན་པའི་བྱིན་གྱིས་རློབ་པ་པོ་ལ་ལྟོས་པ་ཡིན་ཏེ།",
    "དཔེར་ན་ཚིག་གི་ཐ་སྙད་མ་གྲུབ་པའི་བྱིས་པ་རྣམས་ལ་བ་ལང་ལ་སོགས་པ་ལ་ཚིག་༡གི་ཐ་སྙད་དོན་སོ་སོར་ངེས་པ་ནི་མ་ལ་སོགས་པའི་ཉེ་བར་བསྟན་པ་སྔོན་དུ་འགྲོ་བ་ཅན་བཞིན་ནོ་ཞེས་ཟེར་རོ།",
    "འདི་གནས་པ་མཐའ་དག་གི་རྒྱུ་ཡིན་པའི་ཕྱིར་ཐམས་ཅད་ཤེས་པ་ཉིད་དུ་གྲུབ་སྟེ།",
    "འདི་ལ་གང་ཞིག་གང་གི་མུ་བྱེད་པ་པོ་ཡིན་པ་དེ་ནི་དེའི་ཉེ་བར་ལེན་པ་ཤེས་པ་ཡིན་ཏེ།",
    "དེ་དག་གི་ཤེས་པ་ཞེས་བྱ་བ་ནི་བསྡུ་བའོ།",
    "ལས་ལ་ཨཎ་གྱི་སྒྲའི་རྐྱེན་བསྒྲུབས་ནས་རང་གི་དོན་ཀའི་སྒྲུབ་པ་ཡིན་ནོ།",
    "རབ་ཏུ་གཡོ་བ་ནི་ལས་ཀྱི་ཚིག་གི་དོན་ཏོ།་།",
    "དེ་དག་གི་གཞི་ནི་འདུ་བའི་རྒྱུ་སྟེ་རྫས་སོ།",
    "དེ་དག་གིས་སྨྲས་པའི་གཏན་ཚིགས་གཞན་འདི་ཡང་ཡིན་ཏེ།",
    "ལས་རྣམས་ཀྱི་ཁྱད་པར་མེད་པ་ནི་དེ་དག་གིས་ནོན་པ་སྟེ།",
    "ལས་ཀྱི་བདག་ཉིད་ཀྱི་ཚིག་གི་དོན་གསུམ་མོ།",
    "དེ་ལ་གང་སེམས་པ་ཅན་མ་ཡིན་པ་དེ་ནི་བྱིན་གྱིས་རློབ་ཕྱེཔ་པོ་མེད་པར་རང་གི་འབྲས་བུ་རྩོམ་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྦྱོར་བ་ལ།་",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རྒྱས་པར་ནི་འདི་དག་གི་སྐྱོན་ཚིག་གི་དོན་དྲུག་བརྟག་པར་སྟོན་པར་འགྱུར་རོ།",
    "ལས་ནི་གཟུགས་ཅན་དང་འདུ་བའི་ཕྱིར་མིག་གིས་གཟུང་བར་བྱ་བ་ཡིན་ནོ་ཞེས་བརྗོད་པའི་ཕྱིར་རོ།",
    "རི་བོང་གི་རྭ་བཞིན་དུ་མེད་པའི་ཐ་སྙད་ཀྱི་ཡུལ་ཡིན་ནོ།",
    "དེ་ལྟར་རེ་ཞིག་ཁྱད་པར་དང་ཁྱད་པར་ཅན་མ་གྲུབ་པས་གཏན་ཚིགས་རང་གི་ངོ་བོ་མ་གྲུབ་པ་ཉིད་དུ་བསྟན་ནས།",
    "མིག་དང་རེག་པའི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འདི་ལྟར་མིག་དང་རེག་པའི་རྣམ་པར་ཤེས་པ་གཉིས་ཀ་གོ་རིམས་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པའི་གཟུགས་ཙམ་སྣང་བ་ཅན་ཡིན་པའི་ཕྱིར་དང་།",
    "རྩུབ་པ་ལ་སོགས་པའི་རེག་བྱའི་ཁྱད་པར་ཙམ་སྣང་བ་ཅན་ཡིན་པའི་ཕྱིར་ཐ་དད་པ་སྣང་བ་ཅན་དུ་ཉེ་བར་སྐྱེའོ།",
    "དེ་ལྟ་དུཡིན་དང་མིག་དང་རེག་པའི་རྣམ་པར་ཤེས་པ་དེ་དག་ཡུལ་གཅིག་པ་ཉིད་ཡོད་པ་མ་ཡིན་ཏེ།",
    "མིག་དང་རེག་པའི་རྣམ་པར་ཤེས་པ་གཉིས་ཀྱང་ཐ་དད་པར་སྣང་བ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པའོ།",
    "འོ་ན་གལ་ཏེ་དེ་དག་ཡུལ་གཅིག་པ་མ་ཡིན་ན་དེ་ཇི་ལྟར་ངས་སྣང་བ་ལ་མཐོང་བ་ཡིན་པའི་བུམ་པ་གང་ཡིན་པ་དེ་ཉིད་མུན་པར་རེག་གོ་ཞེས་བྱ་བའི་ཉིང་མཚམས་སྦྱོར་བའི་རྣམ་པར་ཤེས་པར་འདིར་འགྱུར།",
    "ཡུལ་དཔྱད་པར་གྱུར་པའི་མཐོང་བ་དང་རེག་པའི་ཤེས་པ་དག་ནི་ཡུལ་གཅིག་པ་ཡིན་ཏེ།",
    "དེ་དག་སྟེ་ཁ་དོག་དང་རེག་པ་ཙམ་དུ་སྣང་བའི་མིག་དང་རེག་པའི་རྣམ་པར་ཤེས་པ་དག་གི་མཐུ་ནི་ནུས་པ་སྟེ།",
    "ཇི་ཙམ་དུ་གཟུགས་ལ་སོགས་པ་དག་ལ་ཐུན་མོང་བའི་ནུས་པ་བསྟན་པའི་ཕྱིར་བུམ་པ་ལ་སོགས་པར་བརྡ་བྱས་ཏེ།",
    "བདག་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་མིག་དང་རེག་པ་དག་གིས་ཉམས་སུ་སྩོང་བ་དེ་དག་ལ་དུས་ཕྱིས་ཇི་ལྟར་མཐོང་བའི་ཡུལ་ཅན་རྗེས་སུ་མཐུན་པའི་བརྡ་བྱས་པའི་འདུ་བྱེད་ཀྱི་ཁྱད་པར་གཅིག་ཉིད་དུ་ཞེན་པ་འཁྲུལ་པའི་རང་བཞིན་གྱིས་རྔུ་དྲན་པའི་ཤེས་པ་འདི་སྐྱེའོ།",
    "འདི་ལྟར་དེ་ལྟར་ཞེན་པ་དེ་ལ་སྔོན་པོ་ལ་སོགས་པའི་ཁ་དོག་སྣང་གི།",
    "རེག་པའི་ཤེས་པ་ལ་ནི་ཁ་དོག་སྣང་བར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ནི་མིག་གི་རྣམ་པར་ཤེས་པའི་ཡུལ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཇི་སྲིད་དུ་སྤྱོད་ཅག་རྒྱགང་དག་གིས་འདི་ཉམས་སུ་སྩོང་བར་འགྱུར་བ་གཟུགས་ལ་སོགས་པ་ལས་ཐ་དད་པའི་སྤྱི་མི་འདོད་དེ།",
    "གང་གིས་དེར་འགྱུར་བ་གཟུགས་ལ་སོགས་པ་ལས་གཞན་སྤྱི་སྔར་པྱོང་བ་ཡིན་ནོ་ཞེས་ནི་མི་བརྗོད་ཀྱི།་",
    "གང་ཞིག་མཐོང་བས་བྱེད་པ་པོ་མ་མཐོང་བདག་ཀྱང་བློ་དང་ལྡན་པའི་རྒྱུ་རྟོགས་པར་འགྱུར་བ་ལྷ་ཁང་ལ་སོགས་པ་ལ་དབྱིབས་ཀྱི་ཁྱད་པར་གང་ཞིག་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་གིས་བློ་དང་ལྡན་པའི་སྐྱེས་བུའི་བྱེད་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཉིད་དུ་འཇིག་རྟེན་ན་གྲུབ་པ་ཡིན་ནོ།",
    "དེའི་ཚེ་ཁྱེད་ཅག་གི་འདོད་པའི་དུ་བསྒྲུབ་བྱ་འགྲུབ་པར་འགྱུར་རོ།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་གིས་ཤིན་ཏུ་རྣམ་པར་ཕྱེ་བའི་འབྲས་བུ་ནི་རྒྱུ་ལ་འཁྲུལ་པ་མེད་དེ།",
    "ཡན་ལག་གི་དོན་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་མེ་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་འབྲས་བུ་ཉིད་ཀྱི་སྤྱི་བཟུང་ཊུ་ནས་མི་རྟག་པ་ཉིད་རྗེས་སུ་དཔོག་པར་འདོད་ཀྱི།",
    "སྤྱིར་འབྲེལ་པ་ལ་གང་གི་ཚེ།",
    "དེའི་ཚེ་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཆུ་རྣམས་ཀྱང་གོའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཙམ་ཡིན་པའི་ཕྱིར་ཁུ་ཡུའི་བེེའུ་ལ་སོགས་པ་བཞིན་དུ་རྭ་ཅན་དུ་རྗེས་སུ་དཔོག་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཁྱེད་ཅག་གིས་བློ་དང་ལྡན་པ་སྔོན་དུ་འགྲོ་བ་ཉིད་ཙམ་བསྒྲུབ་པར་འདོད་པ་ནི་མ་ཡིན་ཏེ་ཕྱོ།",
    "དེ་ལྟ་བས་ན་ཁྱེད་ཅག་གིས་འདོད་པ་བློ་དང་ལྡན་པ་སྔོན་དུ་འགྲོ་བ་ཙམ་གྲུབ་པ་ཉིད་དུ་ཁས་བླངས་ནས།",
    "ཁྱེད་ཅག་གིས་འདོད་པའི་བསྒྲུབ་བྱའི་ཁྱད་པར་ལས་གཉིས་པ་མི་རྟག་པ་དུ་མའི་རྣམ་པར་ཤེས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་མཚན་ཉིད་འདོད་པ་ལས་བཟློག་པའི་བསྒྲུབ་པར་བྱ་བ་གཉིས་པ་གང་ཡིན་པ་དེ་ལ་ཁོ་བོ་ཅག་གིས་བསྒྲུབ་བྱའི་ཁྱད་པར་དང་།",
    "རྟག་པ་ནི་རིམ་དང་ཅིག་ཅར་དག་གིས་དོན་བྱེད་པར་༩སྣའགལ་བའི་ཕྱིར་རོ།",
    "འདི་ནི་ཐལ་བ་བསྒྲུབ་པ་ཡིན་ཏེ།",
    "ཁོ་བོ་ཅག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་དེ་དག་གི་བྱེད་པ་པོ་རྫ་མཁན་ལ་སོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཐུག་པ་མེད་པས་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཁོ་བོ་ཅག་གི་ལུགས་ཀྱིས་འཇིག་པའི་ཚེ་ན་སྐྱེས་བུ་རྣམས་ཤེས་པ་དང་།",
    "གང་གིས་མུཁྱབ་པ་ལ་གནོད་པར་འགྱུར་བའི་རྗེས་སུ་དཔག་པ་དེ་ཡང་གང་ཡིན་ཞེ་ན།",
    "འདི་ནི་ཐལ་བར་འགྱུར་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཐལ་བར་འགྱུར་བའི་སྒྲུབ་པར་བྱེད་པ་འདི་ལྟར་བྱ་སྟེ།",
    "གསལ་བྱེད་པ་ན་རེ།",
    "གང་གི་ཚེ་བློ་སྔོན་དུ་བཏང་སྟེ་བྱེད་པ་དེའི་ཚེ་སྐྱོན་མེད་དེ།",
    "དེ་ནི་རང་གི་འདོད་པས་འབྲས་བུ་རྣམས་ལ་འཇུག་པའི་ཕྱིར་རོ།",
    "གང་གིས་སྐྱེ་བའི་དུས་བཞིན་དུ་ཅིག་ཅར་སྐྱེ་བར་མི་འགྱུར་བ་༤དེའི་ཕན་པ་མི་བྱེད་པའི་འདོད་པ་དེ་ལ་ལྟོས།",
    "བཟློག་པར་བྱ་བ་མ་ཡིན་པའི་རང་བཞིན་ཉིད་ཀྱིས་སུ་ཞིག་གིས་ཀྱང་གསོས་གདབ་པར་བྱ་བ་མ་ཡིན་པས་དེ་འདིའི་ལྷན་ཅིག་བྱེད་པར་མི་རིགས་སོ།",
    "ཐམས་ཅད་ཀྱི་བྱེད་པ་པོ་ཉིད་ཡིན་པའི་སྟོབས་ཀྱིས་འདི་ཐམས་ཅད་ཤེས་པར་ཁྱེད་ཅག་གིས་འདོད་དེ།",
    "སྒྲུབ་པར་བྱེད་པ་དེ་དག་ལས་ལུས་དང་རི་ལ་སོགས་པ་རྣམས་ཀྱི་བྱེད་པ་པོ་བློ་དང་ལྡན་པ་ཡིན་པར་གྲུབ་པ་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་འདི་གཅིག་གི་རྒྱུ་གང་ཡིན་པ་དེ་ཁོ་ན་གཞན་གྱི་ཡང་ཡིན་པར་མ་ངེས་པ་ཐུཉིད་དེ།",
    "ཚངས་པ་ལ་སོགས་པ་ནས་ཤ་ཟའི་བར་ནི་གཅིག་གིས་བྱིན་གྱེས་བརླབས་པ་ཡིན་ཏེ།",
    "སྲིད་པ་བདུན་ནི་བློ་གཅིག་གིས་སྤྲུལ་པ་ཡིན་ཏེ།",
    "དངོས་པོ་གཅིག་གི་༦ཁོངས་སུ་འདུས་པའི་ཕྱིར།",
    "ཁང་པ་གཅིག་གི་ནང་དུ་གཏོགས་པའི་ཁང་མིག་བཞིན་ཏེ།",
    "ཇི་ལྟར་ཁང་པ་གཅིག་གི་ཁོངས་སུ་འདུས་པའི་ཁང་མིག་རྣམས་ཐིག་མཁན་གྱེ་བློ་གཅིག་གཅིག་ཛྭགིས་བྱས་པ་ཉིད་དུ་མཐོང་བ་དེ་ལྟར་སྲིད་པ་བདུན་ཡང་སྲིད་པ་གཅིག་གི་ཁོངས་སུ་འདུས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དེ་དག་ཀྱང་བློ་གཅིག་གིས་བྱས་པར་སྣངེས་སོ།",
    "གང་འདི་དག་བློ་གཅིག་གིས་སྒྲུབ་པར་བྱེད་པ་དེ་ནི་སྲིད་པ་མཐའ་དག་གི་ཐིག་མཁན་གཅིག་པུ་སྟེ།",
    "སེམས་པ་མེད་པ་ནི་བྱིན་གྱིས་རློབ་པ་བོ་མེད་པ་རང་གི་འབྲས་བུ་རྩོམ་པར་བྱེད་པ་མ་མཐོང་ལ།",
    "འོན་ཏེ་འདི་དག་སོ་སོར་བྱེད་པ་པོ་ཉིད་བཀག་མོད་ཀྱི།",
    "མིག་ལ་སོགས་པ་འབའ་ཞིག་པ་རྣམས་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་ལ་ནུས་པ་མེད་ལ།",
    "དེ་ལ་རེ་ཞིག་ཁྱད་པར་སྐྱེད་པར་བྱེད་པའི་མཚན་ཉིད་ཀྱི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཀྱིས་བརྟག་པ་དང་པོ་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "འབྲས་བུ་རྣམས་ཅིག་ཅར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྒྱུ་གཉིས་པོ་དེ་དག་རྟག་ཏུ་ཉེ་བ་ཡིན་མོད་ཀྱི།",
    "གང་གི་ཚེ་མུན་པ་ཤས་ཆེ་བའི་ནུས་པ་དང་ལྡན་པ་དེའི་ཚེ་འགྲོ་བ་ཐམས་ཅད་འཇིག་པ་དང་ཉམས་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "མུན་པ་ལ་རེག་སྐྱེ་དགུ་འཇིག།",
    "དེས་ན་དེའི་ཚེ་དེ་དག་ཏུ་ཐལ་བར་མི་འགྱུར་རོ་སྙམ་དུ་སེམས་ན།",
    "དེ་ནི་ངོ་བོ་གཞན་ཞིག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གཞན་ཞིག་གིས་ཞེས་བྱ་བ་ནི་ཕྱིས་ཀྱི་འབྲས་བུ་གཉིས་པའོ།",
    "གཞན་ཞིག་གི་ངོ་བོས་ནི་མ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་ཁོ་ནས་རྒྱུ་ཡིན་ནོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "འདི་སྙམ་དུ་གཞན་གྱི་ངོ་བོས་བྱེད་པ་མ་ཡིན་མོད་ཀྱི།",
    "འདི་སྙམ་དུ་གཙོ་བོ་ལས་༧ནུས་པ་ཐམས་ཅད་ཉེ་བ་ཡིན་མོད་ཀྱི།",
    "རེས་འགའ་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་དགའ་བ་ཡིན་ཞེས་རྣམ་པར་རྟོག་པ་གསུམ་མོ།",
    "རེས་འགའ་ཉིད་ནི་སྲིད་པའི་ཕྱིར།",
    "ཅི་སྟེ་རང་དགའ་བ་ཡིན་མོད།",
    "རེས་འགའ་བ་ཉིད་ནི་ཅི་འགལ་ཞེ་ན།",
    "རང་རང་གི་ངོ་བོ་ལ་བྱེད་པ་རྒྱུའི་ངོ་བོར་འགལ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ཡང་ཅིའི་ཕྱིར་རེས་འགའ་བར་མི་རིགས་སྣསྙམ་དུ་སེམས་ན།",
    "དངོས་པོ་རྣམས་རང་བཞིན་གཞན་ལ་རག་ལས་ནས་འཇུག་པ་ནི་རེས་འགའ་ཞིག་རྒྱ་རིགས་ཏེ།",
    "དེ་དག་གི་ཡོད་པ་དང་མེད་པ་དག་ནི་གཞན་ཡོད་པ་དང་མེད་པ་དང་འབྱེལ་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་གང་དག་གཞན་ལ་རག་མ་ལས་པར་འཇུག་པ་དེ་དག་ནི་ལྟོས་པར་བྱ་བ་འགའ་ཞིག་ཀྱང་མེད་པའི་ཕྱིར།",
    "ཅི་སྟེ་རེས་འགའ་བར་འགྱུར།",
    "རེ་ཞིག་གྲུབ་པ་ནི་མ་ཡིན་ཏེ།",
    "ཐ་མི་དད་པ་ཉིད་ཀྱིས་རང་གི་ངོ་བོ་བཞིན་དུ་རབ་ཏུ་གྲུབ་པའི་ཕྱིར་ཏེ་ཡོངས་སུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "བདག་གི་དེ་ཉིད་མ་གྲུབ་ན།",
    "རང་བཞིན་སྨྲ་བ་ནི་སོགས་པའི་སྒྲས་དངོས་སུ་མ་འཕངས་མོད་ཀྱི།",
    "རང་ཡང་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོའོ།",
    "ཡང་གི་སྒྲས་ནི་གཞན་གྱི་ངོ་བོ་ཡང་ངོ།",
    "དཔེར་ན་རི་བོང་གི་རྭ་བཞིན་ནོ།",
    "གང་གིས་བྱེད་ཅེས་བྱ་བ་ནི་སུས་ཀྱང་མ་ཡིན་ཏེ།",
    "སྡུག་བསྔལ་བ་ལ་སོགས་པ་ནང་གི་བདག་ཉིད་ཅི་སྤྱོལྟར་གྲུབ་སྙམ་དུ་སེམས་ན།",
    "སྡུག་བསྔལ་ལ་སོགས་པ་ཡང་རེས་འགའ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "མངོན་སུམ་དང་མི་དམིགས་པ་དག་གིས་ས་བོན་དང་།",
    "ཡོད་པ་དང་མེད་པ་དང་ལྡན་པར་མངོན་སུམ་དུ་མི་དམིགས་པ་དག་གིས་ངེས་པའི་ཕྱིར་གཏན་ཚིགས་མ་གྲུབ་པོ།",
    "ཁོ་བོ་ཅག་གིས་ནི་ལྡོག་པ་ཙམ་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ངེས་པའི་རྒྱུ་ཉིད་དུ་ཁས་མ་བླངས་སོ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་ལྡོག་པ་ལ་རེག་པས་འཁྲུལ་པ་མེད་དོ།",
    "རེག་པ་གཅིག་པུ་མེད་པའི་ཕྱིར་མིག་གི་རྣམ་པར་ཤེས་པ་མི་འབྱུང་ངོ་ཞེས་དེ་ལྟར་བསྟན་ན་དེའི་ཚེ་འཁྲུལ་པར་འགྱུར་ན།",
    "འདི་སྙམ་དུ་དེ་ལ་ལྟོས་ནས་འཇུག་པ་དེ་དེ་ལྟར་གྲུབ་མོད་ཀྱི།",
    "འདི་དག་གི་ལྟ་བ་གནས་པ་དེ་ཡང་ཇི་ལྟར་གྲུབ་ཅེ་ན།",
    "རེས་འགའ་བ་ལ་སོགས་པའི་སྒྲུབ་བྱེད་བརྗོད་པ་དེ་ནི་བསྒྲུབ་བྱ་ལས་བཟློག་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་འགལ་བ་ཡིན་ཏེ།",
    "དེ་ལྟར་རེ་ཞིག་དམ་བཅས་པའི་དོན་མངོན་སུམ་དང་འགལ་བ་དང་།",
    "ཁྱད་པར་བྱེད་པའི་རང་བཞིན་དང་རྒྱུ་ལྡོག་ན་རང་གི་ཁྱབ་པར་བྱ་བ་དང་འབྲས་བུ་ལྡོག་པར་བྱེད་དེ།",
    "དེ་ལ་དེའི་བདག་ཉིད་དང་དེ་ལས་བྱུང་བ་དག་གིས་ཁྱབ་པར་བྱ་བ་དང་འབྲས་བུ་དག་འབྱེལ་པའི་ཕྱིར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྒྱུ་ཉིད་དུ་ཁས་ལེན་ན་ཡང་རང་གི་ཕྱོགས་བཏང་བ་ཡིན་ནོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རང་གི་དམིགས་པ་ལོག་པའི་མཚན་ཉིད་ལེན་གྲང་།",
    "རེ་ཞིག་དང་པོ་ནི་མ་ཡིན་ཏེ།",
    "གང་ཡང་རུང་གིས་མ་མཐོང་བ་སྟེ།་",
    "དེ་ལ་གལ་ཏེ་མི་ལེན་པ་དེའི་ཚེ་ཁྱོད་ཀྱི་ཕྱོགས་མི་འགྲུབ་སྟེ།",
    "འདི་སྙམ་དུ་བདག་གིས་ཤེས་པར་བྱེད་པའི་རྒྱུར་སྦྱར་གྱི།",
    "དེས་ན་ཅིའི་ཕྱིར་བདག་གི་ཕྱོགས་སྒྲུབ་པར་མི་འགྱུར་སྙམ་དུ་སེམས་ན།",
    "ཤེས་བྱེད་གཏན་ཚིགས་ཞེས་བྱ་བ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་དུས་ན་ཚུལ་གསུམ་པའི་རྟགས་སོ།",
    "འདིས་ནི་རང་གི་ཚིག་དང་འགལ་བར་བསྟན་ཏོ།",
    "དེ་ལ་སྒྲའི་ཚངས་པར་སྨྲ་བ་རྣམས་ན་རེ།",
    "ཚངས་པའི་སྒྲའི་རང་བཞིན་ནི་སྒྲའི་རང་གི་ངོ་བོ་དེ་ཉིད་ཀྱི་ཕྱིར་འདི་ནི་སྒྲའི་དེ་ཁོ་ན་ཉིད་ཡིན་པས་དེ་ནི་སྒྲའི་དེ་ཁོ་ན་ཉིད་ཅེས་བྱའོ།",
    "འདི་ནི་ཡི་གེ་དང་ཚིག་གི་རིམ་པའི་ངོ་བོས་གནས་པའི་རིག་བྱེད་དེ་རྟོགས་པའི་ཐབས་ཡིན་ཏེ།",
    "གང་ཞིག་གང་གི་རྣམ་པ་དང་ལྡན་པ་དེ་དག་ནི་དེའི་རང་བཞིན་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་དོན་ཐམས་ཅད་སྒྲའི་རྗེས་སུ་བྱེད་པར་མངོན་སུམ་ཉིད་ཀྱིས་གྲུབ་སྟེ།",
    "དེ་ལ་བརྗོད་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པས་རེ་ཞིག་དམ་བཅས་པའི་དོན་སུན་འབྱིན་པར་བྱེད་དོ།",
    "རེས་འགའ་སྒྲ་ཡོངས་སུ་གྱུར་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རམ།",
    "རེས་འགའ་སྒྲ་ལས་སྐྱེས་པའི་ཕྱིར་ཡིན་ཏེ།",
    "དེ་ལ་རེ་ཞིག་ཕྱོགས་དང་པོ་ནི་མ་ཡིན་ཏེ།",
    "འདི་ཉིད་རྒྱས་པར་བསྟན་པའི་ཕྱིར་གང་གིས་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ལ།",
    "གང་གིས་ཏེ།",
    "གང་གི་ཕྱིར་ཁྱེད་ཅག་གིས་དངོས་ཁོ་ནར་འགྲོ་བ་སྒྲའི་རང་བཞིན་ནོ་ཞེས་རྗོད་པར་བྱེད་དོ།",
    "ཅི་སྟེ་འདི་རིག་པ་ཉིད་དུ་མི་འདོད་པ་དེའི་ཚེ་སྒྲའི་རང་བཞིན་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པ་ཡང་མི་རིགས་བུཔར་ཐལ་བར་འགྱུར་ཏེ།",
    "གཅིག་གི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པ་རྣམས་ནི་སྒྲ་དང་ལྷན་ཅིག་གི་རང་བཞིན་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཅིག་དུས་གཅིག་ཏུ་རྟོག་པ་པོ་གཅིག་ལ་ལྟོས་ནས་འཛིན་པ་དང་མི་འཛིན་པ་ནི་མི་རིགས་ཏེ་གཅིག་ཉམས་པར་ཐལ་བའི་ཕྱིར་ཇོ།",
    "ཡང་གི་སྒྲ་ནི་ཚངས་པའི་རང་གི་ངོ་བོ་ཐ་དད་པ་མེད་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཅེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་རང་གི་བདག་ཉིད་དུ་རྣམ་པར་གནས་པ་དེ་ལ་ཐ་དད་པ་མེད་དེ།",
    "མཆོག་གི་བདག་ཉིད་དུ་སྟེ།",
    "མ་ཐོས་ཀྱང་སྒྲ་གསལ་བར་རིག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐལ་བར་འགྱུར་བ་སྨྲས་པ་འདི་གང་ཡིན་པ་དེ་ཡང་གལ་ཏེ་ཚངས་པའི་ངོ་བོ་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པར་འདོད་པ་དེའི་ཚེ་བལྟ་བར་བྱའོ།",
    "འོན་ཀྱང་སྔོན་པོ་ལ་སོགས་པ་ཡང་དེའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་དེའི་རང་གི་ངོ་བོ་བཞིན་དུ་མི་འཛིན་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་སྐྱོན་འདི་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་ཁྱེད་ཅག་གི་ཕྱོགས་ལ་ནི་སྒྲ་བཟུང་བ་དང་མ་བཟུང་བར་རིགས་པ་མ་ཡིན་ཏེ།",
    "ཤེས་པ་གཅིག་གིས་ཀྱང་དེའི་བདག་ཉིད་ཐམས་ཅད་ངེས་པས་མ་བཟུང་བའི་རང་བཞིན་གཞན་མི་འཐད་པའི་ཕྱིར་རོ།",
    "གང་གིས་དེ་རྣམ་པར་འཇོག་པར་བྱེད་པ་དངོས་པོ་རྣམས་སྒྲའི་བདག་ཉིད་དུ་ག་ལས་གྲུབ།",
    "གཅིག་གི་རྣམ་པར་རིག་པར་ཡང་སྟེ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཐམས་ཅད་སྒྲ་གཅིག་གི་ངོ་བོར་ཐ་མི་དད་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་སྒྲའི་བདག་ཉིད་འདིར་རང་གི་མཚན་ཉིད་གསལ་བ་སོ་སོ་ཐ་དད་པ་ཉིད་དུ་ཁས་ལེན་པར་བྱེད་པ་དེའི་ཚེ།",
    "དེ་ལྟར་རེ་ཞིག་ཡོངས་སུ་འགྱུར་བས་བྱས་པའི་དངོས་པོ་རྣམས་སྒྲའི་རང་བཞིན་ཉིད་དུ་མི་རིགས་སོ།",
    "གང་གིས་ཅིག་ཅར་བར་མི་འགྱུར་བ་གལ་ཏེ་དེ་མ་ཚང་བ་མེད་ན་དེས་ན་ཅིའི་ཕྱིར་གཞན་ལ་ལྟོས།",
    "གཞན་ཡང་གལ་ཏེ་རང་བཞིན་གཅིག་པོ་དེ་ལས་སྒྲའི་རང་གི་ངོ་བོ་གཞན་ཐ་དད་པ་སྐྱེ་བར་ཁས་ལེན་པ་དེའི་ཚེ།",
    "ཐམས་ཅད་རང་རང་གི་ངོ་བོ་རྗོལ་གནས་པ་ཉིད་ཀྱིས་རིགས་མཐུན་པ་དང་མི་མཐུན་པ་ལས་ལྡོག་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སྔོན་པོ་ལ་སོགས་པ་འདི་དག་གིས་བརྟགས་པ་དེ་ཡང་སྒྲའི་རྣམ་པ་དང་ལྡན་པ་ཉིད་དུ་སྲིད་པ་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་མ་རིག་པའི་ལེང་ཏོག་གིས་བློའི་མིག་ཉམས་པ་རྣམས་སྔོན་པོ་ལ་སོགས་པའི་དབྱེ་བས་སྣ་ཚོགས་པ་བཞིན་དུ་རློམ་མོ།",
    "དེས་ན་ཐམས་ཅད་ཡུལ་གཅིག་པ་ཉིད་དུ་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "འདི་ལྟར་རེ་ཞིག་དེ་ནི་མངོན་སུམ་གྱིས་དེ་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "འདི་ནི་རང་རིག་པ་དང་འགལ་ཏེ་འདི་ལྟར་ཡིད་གཞན་ལ་ཡང་ཡེངས་ཀྱང་མིག་གིས་གཟུགས་ལྟ་བ་ན།",
    "དེ་ལ་རེ་ཞིག་འབྲས་བུའི་རྟགས་ནི་མ་ཡིན་ཏེ།",
    "རྟག་པ་ནི་རིམ་དང་ཅིག་ཅར་དག་གིས་དོན་བྱེད་པ་འགལ་བའི་ཕྱིར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་ཡང་མི་དམིགས་པ་ཞེས་བྱ་བའི་རྟགས་ཡོད་མོད་ཀྱི།",
    "འོན་ཀྱང་རྣལ་འབྱོར་གྱི་གནས་སྐབས་ན་རང་གི་བདག་ཉིད་གསལ་བའི་ངོ་བོ་དེ་གསལ་བ་ན་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་མཐོང་བར་བརྗོད་དོ་སྙམ་དུ་སེམས་ན།",
    "དེ་ལྟ་ཡིན་དང་ཐམས་ཅད་ལ་འབད་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཐར་བ་མེད་པར་ཐལ་བ་ཉིད་ཆེས་ཤིན་ཏུ་གསལ་བར་བྱས་པར་འགྱུར་རོ།",
    "གང་གིས་མ་རིག་པ་དང་བྲལ་བས་གྲོལ་བར་འགྱུར་བ་རྟག་པ་གཅིག་པུའི་ངོ་བོ་ཚངས་པ་མ་རིག་པའི་བདག་ཉིད་དུ་གནས་པ་ཡིན་ན།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཅིག་མ་གྲོལ་ན་ཐམས་ཅད་ཀྱང་མ་གྲོལ་བར་ཐལ་བར་འགྱུར་བ་མི་ཟློགས་སོ།",
    "འདི་དག་ལ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་སུན་འབྱིན་པ་རྩོམ་མོ།",
    "དེ་མ་མཐོང་བ་ན་ལྟོས་པ་ཡིན་མོད་ཀྱི།",
    "རྩེད་མོའི་དོན་དུའོ།",
    "འཇིག་པའི་བདག་ཉིད་ཀྱི་རྩེད་མོའི་རྣམ་པ་སྣ་ཚོགས་ཀྱི་ཐབས་ལ་ལྟོས་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་རྩེད་མོ་སྣ་ཚོགས་ཀྱི་ཐབས་གང་དག་ཡིན་པ་དེ་བྱེད་པ་ལ་གལ་ཏེ་འདི་ནུས་པ་ཡིན་ན།",
    "གྲང་བ་དང་དྲོ་བ་ཐ་དད་པ་གཉིས་བསྟན་པའི་དངོས་པོ་ཉིད་སྐད་ཅིག་རེ་རེ་ལ་འཇིག་པ་ནི་དུས་ཞེས་བྱ་བ་འདི་ནི་ཕྱིས་སྟོན་པར་འགྱུར་རོ།",
    "ལེགས་ལྡན་བྱེད་ནི་རྩེད་མོའི་དོན་དུ་འཇུག་པ་ནི་མ་ཡིན་གྱི།",
    "བློ་དང་ལྡན་པའི་ཁྱད་པར་ཡང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་ཁོ་བོ་ཅག་གིས་དང་པོ་ཉིད་དུ་བསྟན་ཟིན་ཏོ།",
    "དེ་དག་གི་ཞེས་བྱ་བ་ནི་མེ་ལ་སོགས་པའིའོ།",
    "ངེས་པ་འདི་ཞེས་བྱ་བ་ནི་རང་གི་རྒྱུའི་སྟོབས་ཀྱིས་བྱས་པའོ།",
    "འདི་སྙམ་དུ་བལ་གྱི་ལྟེ་བ་ཅན་ཅིའི་ཕྱིར་རང་གི་འབྲས་བུ་བརྒྱ་ལ་སོགས་པ་ལ་ངོ་བོ་ཉིད་ཀྱིས་འཇུག་པས་ཅིག་ཅར་མི་བྱེད་ན།",
    "རེས་འགའ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེ་ལ་ཡང་རང་གི་རྒྱུའི་སྟོབས་ལས་བྱུང་བའི་ནུས་པ་རེས་འགའ་བ་ཡིན་ནོ།",
    "རྩེད་མོས་ཀྱང་མ་ཡིན་ཏེ།",
    "སྐྱེས་བུ་སུན་འབྱིན་པ་འདི་ཉིད་ཀྱིས་གང་ཡང་དཔའ་བོའི་བུ་ལ་སོགས་པ་གཞན་དག་གིས་འགྲོ་བའི་བྱེད་པ་པོར་བརྟགས་པ་དེ་དག་ཀྱང་གསལ་བར་ཤེས་པར་བྱའོ་ཞེས་སྟོན་པ་ནི།",
    "བདག་གི་བྱ་བ་དང་བྲལ་བ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "བློ་དང་ཚོར་བ་དག་ནི་འདུ་བའི་མཚན་ཉིད་དོ།",
    "ཡུལ་མ་ཡིན་པའི་ཤེས་བྱའི་ཡུལ་ཅན་བདག་གི་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དང་།",
    "རྨི་ལམ་གྱི་མཐའི་ཤེས་རབ་ཀྱི་ཁྱད་པར་རྣམས་ནི་བདག་གི་ལུས་ལ་སོགས་པ་ལས་ཐ་དད་པའི་རིག་པར་བྱེད་པས་རིག་པར་བྱ་བ་ཡིན་ཏེ།",
    "རང་གི་རྒྱུ་ལ་རག་ལས་པ་དང་།",
    "ཤེས་པ་ཉིད་ཡིན་པ་དག་གི་ཕྱིར་སྐྱེས་བུ་གཞན་གྱི་ཤེས་པ་བཞིན་ནོ།",
    "ཡོད་པ་ལ་སོགས་པ་དྲུག་པོ་དེ་དག་གི་ཡུལ་ནི་རྫས་དང་།",
    "དཔེར་ན་སྔར་བདག་གི་སྲུན་ཟླའི་ངོ་ཤེས་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "བདག་གི་ཞེས་བྱ་བའི་ཤེས་པ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བདག་གིས་ཞེས་བྱ་བའི་ཤེས་པས་མཚམས་སྦྱོར་བར་བྱེད་པའི་ཕྱིར་དང་།",
    "བདག་གིས་མཐོང་ངོ་ཞེས་མཚམས་སྦྱོར་བར་བྱེད་དོ།",
    "རྣམ་གྲངས་ངེས་པ་ལས་ཐ་དད་པ་ཉིད་ཡིན་པ་ན་གཅིག་གི་ཚིག་ཡིན་པའི་ཕྱིར་བུམ་པ་ལ་སོགས་པའི་སྒྲ་བཞིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་གྲངས་ངེས་པ་ལས་ཐ་དད་པའི་གཅིག་གི་ཚིག་ཉིད་ཀྱིས་སོ།",
    "སྲོག་ལ་སོགས་པ་དང་མི་ལྡན་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་བུམ་པ་ལ་སོགས་པ་བཞིན་ནོ་ཞེས་བྱ་བའོ།",
    "མའི་ལྟོ་ནས་བྱུང་མ་ཐག་པའི་དུས་ཀྱི་བདག་གི་དང་པོའི་རིག་པར་བྱེད་པའི་རབ་ཏུ་ཤེས་པ་དག་གིས་རིག་པར་བྱ་བ་ཡིན་ཏེ།",
    "ངའི་རབ་ཏུ་ཤེས་པ་ཡིན་པའི་ཕྱིར་བདག་གི་དང་པོའི་རབ་ཏུ་ཤེས་པ་བཞིན་ནོ།",
    "དེའི་ཕྱིར་རེ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དོ།",
    "ཁྱེད་ཅག་གི་ཤེས་པ་རྣམས་ཁོ་བོ་ཅག་གིས་ཁྱེད་ཀྱི་ལུས་ལ་སོགས་པ་ལས་ཐ་དད་པ་ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "གང་གི་ཕྱིར་སྐྱེས་བུ་གཞན་དང་འབྲེལ་པའི་ཤེས་པ་ཡང་གསལ་བར་བྱེད་པ་གཞན་ལ་མི་ལྟོས་པར་རང་རིག་པའི་ངོ་བོ་ཉིད་དུ་སྐྱེ་སྟེ།",
    "ཅི་སྟེ་ཡང་གཞན་དག་གིས་དྷིསེམས་ཙམ་དཔེར་བརྗོད་པར་མི་འདོད་མོད་ཀྱི།",
    "འདི་ལྟར་ངའི་མངོན་སུམ་ལ་སོགས་པའི་ཤེས་པ་ནི་ངའི་ལུས་ལ་སོགས་པ་ལས་ཐ་དད་པའི་རིག་པར་བྱེད་པས་རིག་པར་བྱ་བ་ཡིན་ཏེ་ཞེས་བྱ་བ་འདི་ཙམ་ཞིག་གིས་ཅི་ཞིག་མ་རྟོགས།",
    "འདོད་པ་ལ་སོགས་པ་དེ་དག་གི་གཞི་ནི་དེའི་རྟེན་ཡིན་ནོ།",
    "ཇི་ཙམ་དུ་དེ་དངོས་པོ་མེད་པའི་ཕྱིར་རྒྱུ་དག་གིས་ཅུང་ཟད་ཀྱང་བྱ་བ་ཛེེམ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་རྒྱུ་དང་ལྡན་པར་འགྱུར།",
    "དཔེར་ན་རི་བོང་གི་རྭ་བཞིན་ནོ།",
    "འབྲས་བུ་ཡིན་ན་དངོས་པོ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "འདི་ལྟར་འབྲས་བུ་ཞེས་བྱ་བ་ནི་རང་གི་རྒྱུ་དང་འདུ་བས་སམ།",
    "ཡོད་པ་དང་འདུ་བས་བདག་ཐོབ་པ་ཞེས་བརྗོད་པ་ནི་ཁྱེད་ཅག་གི་ངེས་པ་ཡིན་ནོ།",
    "རྫས་ལ་སོགས་པའི་རང་བཞིན་དང་བྲལ་བའི་འཇིག་པ་ལ་ནི་རང་གི་རྒྱུ་ལ་འདུ་བའམ།",
    "དེ་ནི་འགའ་ཞིག་གིས་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཤེས་པ་གཅིག་གི་མཇུག་ཐོགས་སུ་སྟེ།",
    "མི་གསལ་བར་སྣང་བར་ཐལ་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཇི་ལྟར་དེ་སྒྲ་གཅིག་གི་ཡུལ་དུ་འགྱུར་ཞེ་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་གང་གི་ཕྱིར་སྨིན་མ་བསྐྱོད་པ་འདི་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་འབྲས་བུ་གཅིག་ལ་ཉེ་བར་སྦྱོར་ཏེ།",
    "དེ་ལྟ་བས་ན་ཐ་དད་ཀྱང་སྒྲ་གཅིག་གི་ཡུལ་དུ་འགྱུར་རོ།",
    "ཅི་སྟེ་ཡང་ཁོ་བོ་ཅག་གིས་རྣམ་པ་དེ་ལྟ་བུའི་རྟག་པ་གཅིག་བསྒྲུབ་པར་བྱ་བར་འདོད་དེ།",
    "ཚིག་གཅིག་ཡིན་པའི་ཕྱིར་ན་ཡང་ཁོ་བོ་ཅག་གི་ལུགས་ལ་དེ་ལས་ཐ་དད་པའི་དང་པོའི་དངོས་པོ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་བདག་གི་སྒྲ་འདི་ཡུལ་མེད་པ་ཡིན་པས།",
    "དཔེར་ན་ནམ་མཁའི་མེ་ཏོག་ལ་སོགས་པ་གཏན་མེད་པ་ལ་འགའ་ཞིག་གིས་སྣེབྱེད་པ་པོ་ལ་སོགས་པའི་ཚིག་སྦྱོར་བ་དེའི་ཚེ་གཉི་ག་ལ་གྲུབ་པའི་ལུས་ལ་སོགས་པའི་རྗོད་པར་བྱེད་པའི་སྒྲ་ཐ་དད་པ་ཡིན་ན་ཚིག་གཅིག་ཡོད་དེ།",
    "མ་བྱང་བ་ཡང་དེ་ལས་དོན་རྟོགས་པར་ཐལ་བའི་ཕྱིར་དང་།",
    "རང་གི་རྗོའདོད་པས་སྦྱོར་བ་མེད་པར་ཐལ་བའི་ཕྱིར་དང་།",
    "བརྡ་དོན་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེའི་ཚེ་བདག་ལོག་པ་ན་ལུས་ལ་སྲོག་ལ་སོགས་པ་ལྡོག་པར་ཐལ་བ་རིགས་པ་དང་ལྡན་པར་འགྱུར་གྱི།",
    "དེ་ལྟ་མ་ཡིན་ན་འབྱེལ་པ་མེད་པ་ལོག་ན་གཞན་ལྡོག་པར་ཐལ་བ་འབྱེལ་པ་མེད་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "མོ་གཤམ་གྱི་བུ་ལོག་པ་ན་དེ་དང་འབྲེལ་པ་མེད་པ་སྲོག་ལ་སོགས་པ་ལྡོག་པ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་མོ་གཤམ་གྱི་བུ་ལོག་པ་ན་དེ་དང་འབྲེལ་པ་མེད་པའི་སྲོག་ལ་སོགས་པ་རྣམས་ཀྱང་ལྡོག་པར་འགྱུར་ཏེ།",
    "བུམ་པ་ལ་སོགས་པ་བཞིན་ནོ་ཞེས་ཁ་ཅིག་གིས་ཐལ་བ་སྒྲུབ་པར་བྱེད་པས་ན་མ་ངེས་པར་འགྱུར་བ་དེ་བཞིན་དུ་ཁྱོད་ལ་ཡང་བདག་ལོག་པ་ན་སྲོག་ལ་སོགས་པ་ལྡོག་པར་ཐལ་བ་ནི་མ་ངེས་པ་ཉིད་ཡིན་ནོརྗོ།",
    "འདི་ལ་རེ་ཞིག་དེའི་བདག་མིན།",
    "ཤེས་པ་ལ་སོགས་པ་དག་གི་རྟགས་ཉིད་དུ་གཞན་དག་གིས་སྨྲས་པ་གང་ཡིན་པ་དེ་དག་བཀག་པར་བལྟ་བར་བྱ་སྟེ།",
    "ཐམས་ཅད་ཐམས་ཅད་ཀྱི་གོ་བར་བྱེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་ལ་རྒྱུའི་དངོས་པོར་མཚུངས་པའི་ཕྱིར་དང་བྱེད་པ་པོ་དང་བྱེད་པའི་ལས་ཀྱི་ཐ་སྙད་ནི་རང་གི་འདོད་པ་ཙམ་གྱིས་ཡོངས་སུ་བརྟགས་པའི་ཕྱིར་རོ།",
    "སྦྱོར་བ་ནི་གང་ཞིག་གང་གི་རྣམ་པས་སྟོང་པ་དེ་ནི་དེའི་ཡུལ་ཅན་མ་ཡིན་ཏེ།",
    "དཔེར་ན་མིག་གི་ཤེས་པ་སྒྲའི་ཡུལ་ཅན་མ་ཡིན་པ་བཞིན་ནོ།",
    "ངའོ་སྙམ་པའི་ཤེས་པ་ཡང་བདག་གི་རྣམ་པས་སྟོང་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པའོ།",
    "འོན་ཀྱང་ཐ་དད་པར་བདག་དཀར་ཤམ་མོ།་"
  ]
}