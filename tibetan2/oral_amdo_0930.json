{
  "type": "oral_amdo",
  "data": [
    "༡༨༢པེ་སྣར་གིཉམས་མྱོང་མིན།",
    "༡༨༤པེ་སྣར་གི།",
    "༡༨༨པེ་གི།",
    "པེ་སྣར་གི།",
    "པེ་སྣར་གིས།",
