    "བསྟན་པ་ཉིན་མོའི་ཉི་མ་ཉིད་བྱེད་ཅིང་།",
    "གང་གི་དྲིན་ལས་བློ་ཞན་བདག་འདྲའི་བློས།",
    "དཔང་ལོ་ཙཱ་བ་དགེ་སློང་དཔལ་ལྡན་བློ་གྲོས་བརྟན་པ་ཞེས་བྱ་བས་སྦྱར་བ་གང་ཟག་དམ་པ་དག་གི་གདན་ས་དཔལ་འཇིགས་པ་མེད་པ་སེང་གེའི་གླིང་དུ་ལེགས་པར་གྲུབ་པའོ།",
    "གྲུ་མཆོག་གི་ཡེ་ཤེས།",
    "ཀུན་སྤངས་དོན་ཡོད་རྒྱལ་མཚན་སོགས་ཐུགས་ཀྱི་སྲསྲས་བདུནལས་ཅན་གྱི་གང་ཟག་སུམ་སྟོང་གཙོ་བོར་གྱུར་པའི་སློབ་ཚོགས་མཐའ་ཡས་པ་བསྐྱངས་བར་མཛདམཐར་བོད་རབ་བྱུང་བདུན་པའི་ས་བྱི་སྤྱི་ལོ་༡༤༨ལོར་རེ་ཞིག་དགོངས་པ་མྱ་ངན་ལས་འདས་སོ།",
    "སྒྲུབ་ཆེན་བཀའ་བརྒྱད་ཀྱི་བདེན་བརྡར་ཆེན་མོར།",
    "༩ བཀའ་བརྒྱད་རལ་གྲི་ཕྱུང་བརྡེག་གི་བསྐུལ་ལ།",
    "༢ སྒྲུབ་ཆེན་བཀའ་བརྒྱད་ཀྱི་ཐུན་མོང་གི་ལས་རིམ་ལ།",
    "ངག་གི་ནུས་འདོན་ངར་བླུད་པདྨས་མཛད་པར།",
    "༣ བབཀའ་བརྒྱད་དྲག་པོའི་དམོད་པ་དྲག་སྔགས་ཀྱི་སྒྲུབ་པ་ཟབ་མོར།",
    "༤ རྒྱལ་སྲས་ཁྱུང་གི་སྒྲུབ་ཐབས་ཟབ་མོར།",
    "ར་སྒྲུབ་ཆེན་བཀའ་བརྒྱད་ཀྱི་རྫོགས་རིམ་ཁྲིད་གཞུང་ཡེ་ཤེས་ཟང་ཐལ་ཆེན་པོ་ཞེས་བྱ་བར།",
    "༧རལ་གྲི་ཕྱུང་བརྡེག་གི་བསྐུལ་པ་ལྡེབ་༡།",
    "༡༨ངག་གི་ནུས་འདོན་ལྡེབ་༡།",
    "༢༤ ཌཀྐི་མའི་དྲག་སྔགས་སེང་གདོང་དྲག་མོ་ལྡེབ་༤།",
    "༢༧དམོད་པ་དྲག་སྔགས་ཀྱི་སྒྲུབ་པ་ལྡེབ།",
    "༤༩ཁྱུང་གི་སྒྲུབ་ཐབས་ཟབ་མོ་ལྡེབ་༥།",
    "༥༣ཁྲིད་གཞུང་ཡེ་ཤེས་ཟང་ཐལ་ཆེན་དཀར་པོ་ལྡེབ་༩།",
    "བདེན་བརྡར་ཆེན་མོ་ལྡེབ་༡།",
    "ཐུན་མོང་གི་ལས་རིམ་ལྡེབ་༥།",
    "ངག་གི་ནུས་འདོན་ཤར།",
    "ཁྱུང་གི་སྒྲུབ་ཐབས་ལྡེབ་༥།",
    "ཁྲིད་གཞུང་ཡེ་ཤེས་ཟང་ཐལ་ལྡེབ་༩།",
    "དམོད་བྱང་བཀོལ་བ་ལྡེབ་༣།",
    "༩བསླུ་མེད་རྡོ་རྗེའི་གསུང་གིས་ཆེས་ཆེར་བསྔགས།",
    "རྒྱལ་ཀུན་དགོངས་པ་བབདག་གིས་རྫོགས་བྱེད་ཤོག།",
    "གཡས་ན་སེང་གེ་སྟག་གཟིག་གླང་པོ་ཆེ",
    "བྱོལ་རྩེསོང་གཙོ་བརྒྱད་བསྣོལ་བའི་ཁྲི་སྟེང་དུགསེར་གྱི་འཁོར་ལོ་རྩིབས་སྟོང་རབ་ཏུ་འབར",
    "ཀུན་ཀྱང་སྤྱན་གསུམ་སྡང་མིག་ཕྱོགས་བཅུར་གཟིགསསྤྱན་ལྡོག་ཁྲོ་གཉེར་དཔྲལ་བའི་དབྱིངས་སུ་བསྡུས",
    "གཡོན་ན་ཡུམ་ཆེན་ནམ་མཁའི་དབྱིངས་ཕྱུག་མསྔོན་མོ་ཕྱག་གཉིས་པདྨ་དྲིལ་བུ་བསྣམས",
    "སེར་མོ་ཕྱག་གཉིས་ཤར།",
    "གཏེར་དམར་མོ་ཕྱག་གཉིས་པདྨ་དྲིལ་བུ་བསྣམས",
    "གཡོན་ན་གིརྟི་དམར་མོ་པི་ཝཾ་སྒྲོག",
    "གཡོན་ན་དྷུ་པེ་དཀར་མོ་སྤོས་ཁང་བསྣམས",
    "གཡོན་ན་པུབྦེ་སེར་མོ་མེ་ཏོག་བསྣམས",
    "གཡོན་ན་སྒོ་མ་དཀར་མོ་ལྕགས་ཀྱུ་བསྣམས",
    "གཡོན་ན་སྒོ་མ་སེར་མོ་ཞགས་པ་བསྣམས",
    "གཡོན་ན་སྒོ་མ་དམར་མོ་ལྕགས་སྒྲོག་བསྣམས",
    "ཐལ་ཆེན་ཚོམ་བུ་རཀྟའི་ཐིག་ལེས་བརྒྱན",
    "ཞག་གི་ཟོ་རིས་རྔམས་པའི་ཆ་ལུགས་ཅན",
    "ཁྲོ་མོ་ཆེན་མོ་གནམ་ཞལ་དབྱིངས་ཕྱུག་མ",
    "མ་མོ་མཁའ་འགྲོ་ཀུན་གྱི་གཙོ་མཆོག་མམཀུན་ཏུ་བཟང་མོ་ཤེས་རབ་ཕ་རོལ་ཕྱིན",
    "བྱང་གི་རྩིབས་ལ་རཀཱ་ཧེ་རུ་ཀ་ལྗང་ནག་ཕྱག་གཉིས་རྒྱ་གྲམ་ཐོད་ཁྲག་བསྣམས",
    "པདྨ་ཉི་ཟླ་རཱུ་ཏྲ་ཕོ་མོའི་སྟེང་",
    "ཤར་གྱི་རྩིབས་བ་བུདྡྷ་ཧེ་རུ་ཀ",
    "བུདྡྷ་ཀྲོ་ཏི་ཤྭ་རི་དུང་དམར་སྟོབ",
    "བྱང་གི་རྩིབས་སྟེང་ཀརྨ་ཧེ་རུ་ཀ་ལྗང་ནག་ཕྱག་གཉིས་རྒྱ་གྲམ་རི་རབ་བསྣམས",
    "དེ་ཡི་ཕྱི་རིམ་བར་ཁྱམས་ཆེན་མོ་ལ",
    "ཤར་གྱི་ཕྱོགས་ནས་ཀོ་རི་དཀར་མོ་ནི",
    "ལྷོ་ཡི་ཕྱོགས་ནས་ཙོ་རི་སེར་མོ་ནི",
    "ནུབ་ཀྱི་ཕྱོགས་ནས་པྲ་མོ་དམར་མོ་ནི",
    "ཕྱག་གཉིས་ཆུ་སྲིན་རྒྱལ་མཚན་བྷནྡྷ་བསྣམས་བྱང་གི་ཕྱོགས་ནས་བེ་ཏ་ནག་མོ་ནི",
    "ལྷོཕྱོགས་བྱ་ཏྲི་དམར་མོ་སྟག་གདོང་མཕྱག་གཉིས་ཐུགས་ཀར་བསྣོལ་ནས་འབྲུ་ཚུགས་བར་ནུབ་བྱང་སྲི་ལ་ནག་མོ་ཝ་ཡི་གདོང་",
    "ནུབ་བྱང་ཁ་ཁ་ནག་མོ་བྱ་རོག་མགོ",
    "གདོང་སྔོན་མོ་ལྕགས་ཀྱུ་བསྣམསལྷོ་སྒོར་ཕག་གདོང་སེར་མོ་ཞགས་པ་བསྣམས",
    "ནུབ་སྒོར་སེང་གདོང་དམར་མོ་ལྕགས་སྒྲོག་འཛིན",
    "ནག་མོ་ཕྱག་གཉིས་འཁྲིལ་སྦྱོར་དུང་དམར་སྟོབ",
    "གཏུམ་མོ་དུག་ཧྲུལ་གྱོན་མ་ཐོད་ཁྲག་སྟོབ",
    "བྱང་གི་རྩིབས་ལ་རལ་པ་ཚར་དགུ་ནི",
    "སྟེང་གི་ཕྱོགས་ན་གཤིན་རྗེ་ནག་འཇོམས་ནི",
    "ཆིབས་སུ་ལྷུག་པ་ལུག་ལ་ཆིབས་ནས་རྒྱུགསསྟེང་གི་ཕྱོགས་ནས་གཤིན་རྗེ་ཕྱུ་སངས་ནི",
    "ཁམས་རྒྱ་སེར་མོ་རྭལ་གྲི་བྷནྡྷ་ཐོགས",
    "བྲག་སྲིན་དཀར་མོ་ལྕགས་ཀྱུ་བྷནྡྷ་ཐོགསདྲི་ཟ་བཀའ་སྒེག་པ་ཆིབས་ནས་ཕྱོགས་བཅུར་རྒྱུགཤར་ལྷོའི་མཚམས་ནས་ཨ་ཝ་གླང་མགོ་ནི",
    "བྱི་ལིང་དམར་མོ་གཏུན་ཤིང་བྷནྡྷ་བསྣམས",
    "བདུད་མོ་སྨུག་ནག་མདའ་དང་བྷནྡྷ་བསྣམས",
    "མ་ཧེ་སྔོན་པོ་ཆིབས་ནས་ཕྱོགས་བཅུར་རྒྱུག་བྱང་གི་ཕྱོགས་ནས་གཤིན་རྗེ་བདུད་འཇོམས་ནི",
    "སྐྱོད་བྱེད་རྔ་མོང་ཆིབས་ནས་ཕྱོགས་བཅུར་རྒྱུག",
    "འོག་གི་ཕྱོགས་ནས་གཤིན་རྗེ་འབར་བ་ནི",
    "ལྷ་མོ་དམར་མོ་ཁ་ཊཾ་བྷནྡྷ་བསྣམས",
    "ཆུ་གླང་མ་ཧེ་ཆིབསནས་ཕྱོགས་བཅུར་རྒྱུག་འོག་གི་ཕྱོགས་ནས་གཤིན་རྗེ་ཐོད་དབྱུག་ནི",
    "ས་བདག་ནག་མོ་ཞགས་པ་བྷནྡྷ་བསྣམས",
    "སེར་མོ་ཕྱག་གཉིས་རིན་ཆེན་ཐོད་ཁྲག་བསྣམས",
