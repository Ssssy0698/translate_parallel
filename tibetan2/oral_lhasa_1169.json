    "རྣམ་པར་གྲོལ་བའི་སྐུ་བསྟན་པ།་",
    "དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པ།་",
    "དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པ།་",
    "ཞིང་ཡོངས་སུ་དག་པ་ངང་ཇིང་ཡོངས་སུ་མ་ཇག་པ་ན་དངོས་པོ་གང་དག་རྙེད་པར་དཀའ་བ་ཇང་གང་དག་ཡོང་པའི་མཚན་ཉིད་བསྟན་པ།་",
    "གཉིས་སུ་མེད་པར་གསོལ་བ་བརྒྱ་བསྟན་པ།་",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་ཤེས་པ་བསྟན་པ།་",
    "སྟོང་པ་ཉིད་རྣམ་པར་གཞག་པ་བསྟན་པ།་",
    "ས་དང་ཏིང་ངེ་འཛིན་ཀྱི་ཁྱད་པར་གྱིས་གོང་ནས་གོང་དུ་ཡིད་ཀྱི་སྐུ་རྣམ་པར་ཕྱེ་བ་དཔྱད་པ།་",
    "གྲུབ་པའི་མཐའི་ཚུལ་རྣམ་པར་འབྱེད་པར་དཔྱད་པ།་",
    "ཡེ་ཤེས་ཀྱི་ཁྱད་པར་དཔྱད་པ།་",
    "འཕགས་པ་དགོངས་པ་ངེས་པར་འགྲེལ་པ།",
    "གནས་ངན་ལེན་མི་མཐུན་པའི་ཕྱོགས་ནི་དུ་མཆིས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གསུམ་པ་ཀུན་ཏུ་རྨོངས་པ་རྣམ་པ་ཉི་ཤུ་རྩ་གཅིག་ལས་བརྩམས་ནས་ས་རྣམས་རྣམ་པར་དབྱེ་བ་སྟོན་ཏོ།",
    "ལན་དུ་གསུངས་པ་སྟེ།",
    "གནས་ངན་ལེན་དུ་ཞིག་ནི་མི་མཐུན་པའི་ཕྱོགས་སུ་གྱུར་པ་ལགས་ཞེས་ཞུའོ།",
    "གནས་ངན་ལེན་མི་མཐུན་པའི་ཕྱོགས་ནི་བཅུ་གཅིག་ཡོད་དོ་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་ནི་དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པ་སྟོན་ཏོ།",
    "རིགས་ཀྱི་བུ་ཞེས་བྱ་བ་མན་ཆད་རྨོངས་པ་ལ་སོགས་པ་གསུངས་པའི་དགོངས་པ་བསྟན་པ་སྟེ།",
    "ཀུན་ཏུ་རྨོངས་པའི་ཕྱོགས་རྣམས་ཀྱང་ཀུན་ཏུ་རྨོངས་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "གཉིས་པ་ནི་ཡང་དག་པ་ཉིད་ཀྱི་མཐོང་བའི་ལམ་མངོན་དུ་གྱུར་པ་ན་སྒྲིབ་པ་དེ་གཉི་གའི་ས་བོན་གདོན་མི་ཟ་བར་གྲུབ་པར་མི་འགྱུར་ཏེ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་བསྐྱེད་ཅི་དགོས་ཤེ་ན།",
    "དེ་ཡོངས་སུ་སྤང་བའི་ཕྱིར་རྣམ་པར་གྲོལ་བའི་ལམ་བསྐྱེད་ནས།",
    "དེ་ལྟར་བསྟན་པ་རྣམས་ལས་ཚིག་ཐ་དད་པར་འབྱུང་ཡང་དོན་ནི་འགལ་བ་མེད་དོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་དང་སྦྱར་ན།",
    "གོང་དུ་བསྟན་པའི་རྨོངས་པ་དེ་གཉིས་ནི་སྒྲིབ་པ་རྣམ་པ་བཅུ་ལས་ལོག་པར་སྒྲུབ་པའི་སྒྲིབ་པ་ཉིད་དོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "ཏིང་ངེ་འཛིན་མཆོག་དང་བསྒོམས་པའི་ཤེས་རབ་ལ་སྒྲིབ་པར་བྱེད་པ་གང་ཡིན་པ་སྟེ།",
    "ཐོག་མ་མེད་པའི་དུས་ནས་དེའི་རྗེས་སུ་འཇུག་པ་དེ་རྣམ་པར་གནོན་པའི་ཕྱིར་རོ།",
    "འདིར་གཟུངས་དང་ཐོས་པ་དང་བསམ་སྲེཔའི་ཤེས་རབ་ལ་སྒྲིབ་པར་བྱེད་པ་གང་ཡིན་པའོ་ཞེས་འབྱུང་སྟེ།",
    "ཀུན་དུ་རྨོངས་པ་གཉིས་ལ་མི་གནས་པའི་སྒྲིབ་པར་བསྟན་ཏོ།",
    "སྙེམས་པར་འཇུག་པ་ལ་སྲེད་པའི་ཀུན་དུ་རྨོངས་པ་དང་།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་སྙོམས་པར་འཇུག་པ་ལ་སྲེད་པའི་ཀུན་དུ་རྨོངས་པ་ཞེས་བྱ་བ་ནི།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་ལཔ་དང་ལྷན་ཅིག་པ་འཇིག་ཚོགས་ལ་ལྟ་བ་ལ་སོགས་པ་བསྡུས་ཤིང་མཆོག་ཏུ་དམན་པའི་རྣམ་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཡིད་ལ་མ་བྱས་པར་ཡང་དམིགས་པའི་ཕྱིར་དང་།",
    "དོན་རྣམ་པ་གསུམ་ཀྱིས་ཤིན་ཏུ་ཕྲ་བའི་དོན་བསྟན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ས་བཞི་པར་ཞུགས་པ་ནི་གཏན་དུ་སྤང་བྱེབར་བྱེད་དོ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་གཉིས་པོ་དག་གཏན་དུ་བཅོམ་པར་བྱེད་དོ།",
    "འདི་ཉིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ནི་ཕྲ་བ་ཡིན་ཞིང་རྣམ་པར་གནོན་པ་ལ་སྔ་ཕྱི་ཡོད་པའི་ཕྱིར་དང་།",
    "འདི་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཁོ་ན་དང་མཚུངས་པར་ལྡན་པ་ཡིན་ལ།",
    "སྙོམས་པར་འཇུག་པ་ལ་སྲེད་པ་དང་།",
    "སྙོམས་པར་འཇུག་པ་ལ་སྲེད་པ་དང་།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "དེས་ས་ལྔ་པའི་ཐ་དད་པ་མེད་པའི་ལམ་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "རྣམ་པར་བྱང་བའི་རྒྱུ་དང་།",
    "འབྲས་བུ་ཐ་དད་པ་མེད་པའི་ལམ་ལ་འཇུག་པར་འགྱུར་བས།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "ཀུན་ཏུ་རྨོངས་པ་ཕྱི་མས་ནི་འགོག་པ་དང་ལམ་རྣམ་པར་བྱང་བའི་མཚན་ཉིད་ཀྱི་སྒོ་ཉིད་དུ་འཛིན་ཏོ།",
    "རྣམ་པར་བྱང་བའི་མཚན་མ་ཡོད་པ་ཉིད་དུ་འཛིན་པའོ།",
    "རྣམ་པར་བྱང་བ་མེད་པའི་ལམ་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "ས་དྲུག་པར་ཞུགས་པ་ན་གདོད་སྤོང་བར་བྱེད་དོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "དེས་ས་བདུན་པའི་མཚན་མ་མེད་པའི་ཁྱད་པར་དུ་འཔགས་པའི་ལམ་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "ས་བདུན་པར་ཞུགས་པ་ན་གཏན་དུ་སྤོང་བར་བྱེད་དོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་མཚན་མ་མེད་པ་ལ་རྩོལ་བ་ཀུན་དུ་རྨོངས་པ་དང་།",
    "ས་བརྒྱད་པར་ཞུགས་པ་ན་གཏན་སྤོང་བར་བྱེད་དེ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་སྟེ།",
    "དེས་ས་དགུ་པའི་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལ་སྒྲིབ་པར་བྱེད།",
