    "གཉིས་ཀ་དོན་དང་བཅས་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་བའོ།",
    "འགྲོ་བ་པོ་ལྷ་བྱིན་ལྟ་བུ་གཅིག་ཡུལ་གཞན་དུ་འགྲོ་བ་ན་འགྲོ་བའི་བྱ་བ་གཅིག་ལས་མེད་པས་བྱ་བ་གཅིག་པོ་དེ་བགོམ་པ་ཞེས་པའི་ལས་ཀྱི་ཚིག་དང་འབྲེལ་ན་བགོམ་པ་ལ་འགྲོ་ཞེས་པའི་ངག་བརྗོད་བྱའི་དོན་དང་ལྡན་པ་ཡིན་པར་ནི་ཅི་ལྟ་བུར་ན་འཐད་པར་འགྱུར་ཏེ་མི་འགྱུར་བར་ཐལ།",
    "འགྲོ་བའི་བྱ་བ་གཅིག་པོ་དེ་ནི་བགོམ་པ་ཞེས་པའི་ཚིག་གི་དོན་དུ་སོང་ཞིང་བྱ་བ་གཉིས་པ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཚེ་སྟེ་གང་གི་ཕྱིར་ན་འགྲོ་བའི་བྱ་བ་མེད་པའི་བགོམ་པ་ཞེས་པ་ལས་ཀྱི་ཚིག་ལ་བརྗོད་བྱའི་དོན་དང་ལྡན་པ་འཐད་པ་མེད་པའི་ཕྱིར་རོ།",
    "རྒོལ་བ་གང་གིས་འགྲོ་བའི་བྱ་བ་དང་མི་ལྡན་པས་བགོམ་པ་མིང་ཙམ་དུ་གྱུར་པ་ལ་འགྲོ་བ་ཞེས་པའི་བྱ་ཚིག་ལ་འགྲོ་བའི་བྱ་བ་ཡོད་པར་འདོད་པའི་ཕྱོགས་དེ་ལ་བགོམ་པ་ཞེས་པའི་ལས་ཀྱི་ཚིག་ལ་འགྲོ་ཞེས་པའི་ཚིག་གི་དོན་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་འགྲོ་བའི་བྱ་བ་ནི་གཅིག་ལས་མེད་ལ།",
    "འགྲོ་བ་པོ་གཅིག་ལ་འགྲོ་བའི་བྱ་བ་གཉིས་སུ་ཐལ་བར་འགྱུར་ཏེ།",
    "འགྲོ་བའི་བྱ་བ་གང་གིས་བགོམ་པའི་ཐ་སྙད་དུ་འཇོག་པ་དེ་དང་ནི་བགོམ་པར་གྱུར་པ་དེ་ལ་ཡུལ་གཞན་དུ་ཕྱིན་པའི་འགྲོ་བའི་བྱ་བ་གང་ཡིན་པ་གཉིས་སུ་འགྱུར་བའི་ཕྱིར།",
    "འགྲོ་བའི་བྱ་བ་གཉིས་པོ་འདིར་ཐལ་བར་འགྱུར་བར་འདོད་ན།",
    "དེ་ལྟར་ན་འགྲོ་བ་པོའང་གཉིས་སུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བྱེད་པ་པོ་གཉིས་ཀྱིས་བསྒྲུབ་པ་ཡིན་པས་གང་གི་ཕྱིར།",
    "གལ་ཏེ་འགྲོ་བ་པོ་གཅིག་ལ་དུས་གཅིག་གི་ཚེ་འགྲོ་བའི་བྱ་བ་གཉིས་ཡོད་པར་མི་འགལ་ཏེ།",
    "བྱེད་པ་པོ་ལྷ་བྱིན་ལྟ་བུ་གཅིག་ལ་དུས་གཅིག་གི་ཚེ་ལྟ་བ་དང་།",
    "གང་གི་ཕྱིར་ནུས་པ་བྱེད་པ་པོ་ཡིན་གྱི་རྫས་ནི་མ་ཡིན་ལ།",
    "སྔ་མ་ལྟར་ན་འགྲོ་བ་པོ་གང་ཟག་གི་རྫས་གཅིག་ལ་ཡང་འགྲོ་བའི་ནུས་པ་གཉིས་ཡོད་པས་འགྲོ་བའི་བྱ་བ་གཉིས་ཀྱང་མི་འགལ་བས་སྐབས་དོན་འགྲོ་བ་པོ་གང་ཟག་གི་རྫས་གཅིག་ལ་དུས་གཅིག་གི་ཚེ་འགྲོ་བའི་བྱ་བ་གཉིས་དགག་པར་མི་ནུས་པས་ལན་ཕྱི་མ་ཉིད་ལེགས་པར་སེམས་སོ་ཞེས་གསུངས་ཀྱང་།",
    "སྨྲ་བའི་ནུས་པས་སྨྲ་བའི་བྱ་བ་ཁོ་ན་བྱེད་ཞེས་པའི་དོན་ཡིན་གྱི་གང་ཟག་གི་རྫས་གཅིག་ལ་ཡང་འགྲོ་བའི་ནུས་པ་གཉིས་ཡོད་པས་འགྲོ་བའི་བྱ་བ་གཉིས་ཀྱང་མི་འགལ་བ་དོན་མ་ཡིན་པས།",
    "འགྲོ་བ་གཉིས་སུ་ཐལ་འགྱུར་ན།",
    "དང་པོ་ལྟར་ན་དེ་ལ་རེ་ཤིག་འགྲོ་བ་པོར་གྱུར་པ་ནི་མི་འགྲོ་སྟེ་དེ་ལྟར་ན་འགྲོ་བའི་བྱ་བ་གཉིས་དགོས་པ་ལས་འགྲོ་བའི་བྱ་བ་གཉིས་མེད་པའི་ཕྱིར་རོ།",
    "གཉིས་ཀ་དོན་དང་བཅས་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་བའོ།",
    "འགྲོ་བ་པོ་ཡིན་མ་ཡིན་གཉིས་ཀ་ལས་ཀྱང་གཞན་པ་མི་འགྲོ་བ་བདེན་མོད་ཀྱི་འགྲོ་བ་པོ་ཉིད་འགྲོའོ་སྙམ་ན།",
    "རེ་ཤིག་འགྲོ་བ་པོ་འགྲོ་ཞེས་པའི་ངག་དོན་ལྡན་ཡིན་པར་ནི་ཅི་ལྟར་འཐད་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་སྟེ་གང་གི་ཕྱིར་འགྲོ་བ་པོ་ལྷ་བྱིན་གཅིག་ལ་འགྲོ་བའི་བྱ་བ་གཅིག་ལས་མེད་ལ་དེ་འགྲོ་ཞེས་པའི་ཚིག་གི་དོན་དུ་སོང་བས་འགྲོ་བའི་བྱ་བ་མེད་པར་ནི་འགྲོ་བ་པོའི་ཚིག་དོན་ལྡན་དུ་འཐད་པར་མི་འགྱུར་བའི་ཕྱིར།",
    "འགྲོ་བའི་བྱ་བ་དེ་འགྲོ་བ་པོ་ཞེས་པའི་ཚིག་གི་དོན་དུ་སོང་བས་ཉེས་པ་དེར་མི་འགྱུར་རོ་སྙམ་ན།",
    "རྒོལ་བ་གང་གི་ཕྱོགས་ལ་འགྲོ་བ་པོ་འགྲོ་བའི་བྱ་བ་དང་འབྲེལ་བར་འདོད་པ་དེ་ལ་འགྲོ་བ་མེད་པའི་འགྲོ་བ་པོ་ཞེས་པའི་འགྲོ་བ་པོའི་སྒྲ་ནི་བྱ་བའི་དོན་ལ་འཇུག་པས་འགྲོ་ཞེས་པ་བྱ་བའི་སྒྲ་ལ་འགྲོ་བའི་བྱ་བ་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "འགྲོ་ཞེས་པའི་ཚིག་གཉིས་ཀ་དང་འབྲེལ་བར་འགྱུར་ན་འགྲོ་བའི་བྱ་བ་གཉིས་སུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ལ་སོང་བའི་ལམ་ལ་ནི་འགྲོ་བའི་རྩོམ་པ་མེད་དེ།",
    "མ་སོང་བའི་ལམ་ལ་ཡང་འགྲོ་བའི་རྩོམ་པ་མེད་དེ།",
    "འགྲོ་བ་རྩོམ་ན་མ་སོང་བར་འགལ་བའི་ཕྱིར་རོ།",
    "སོང་མ་སོང་ལས་མ་གཏོགས་པའི་བགོམ་བཞིན་པ་མ་དམིགས་པའི་ཕྱིར།",
    "དེས་ན་ལམ་གང་དུ་འགྲོ་བ་རྩོམ་པར་བྱེད་དེ་མི་འཐད་པར་ཐལ།",
    "འགྲོ་བ་རྩོམ་པ་ལ་མངོན་དུ་བརྩམ་བྱའི་ལས་གྲུབ་དགོས་པ་ལས་འགྲོ་བ་རྩོམ་པའི་སྔ་རོལ་ན་ལམ་གང་དུ་འགྲོ་བ་རྩོམ་པར་འགྱུར་བ་འགྲོ་བའི་བྱ་བ་འགག་པ་སོང་བའི་ལམ་མེད་ཅིང་།",
    "མ་སོང་བའི་ལམ་ཡང་འགྲོ་བ་རྩོམ་པ་ག་ལ་ཡོད་དེ།",
    "མ་སྐྱེས་པ་མ་སོང་བའི་ལམ་ཅི་ཞིག་རྣམ་པར་བརྟག་པར་བྱ་སྟེ།",
    "རེ་ཤིག་འགྲོ་བ་པོ་མི་སྡོད་དེ།",
    "རེ་ཤིག་འགྲོ་བ་པོ་སྡོད་དོ་ཞེས་ཅི་ལྟར་འཐད་པ་ཉིད་དུ་འགྱུར་ཏེ་མི་འཐད་པར་ཐལ།",
    "གང་གི་ཚེ་འགྲོ་བའི་བྱ་བ་མེད་པར་ནི་འགྲོ་བ་པོའི་ཚིག་དོན་ལྡན་དུ་འཐད་པར་མི་འགྱུར་བ་དེས་ན་སྡོད་ཚིག་དོན་དང་ལྡན་ཡང་འགྲོ་བ་པོའི་ཚིག་དོན་གྱིས་སྟོང་པའི་ཕྱིར་རོ།",
    "སོང་དང་མ་སོང་ལས་མ་གཏོགས་པའི་བགོམ་བཞིན་པའི་ལམ་ལ་འགྲོ་བ་ལས་ལྡོག་པར་མི་འགྱུར་ཏེ།",
    "སོང་བའི་ལམ་དང་མ་སོང་བའི་ལམ་ལ་འགྲོ་བ་ལས་ཀྱང་ལྡོག་པར་འགྱུར་བ་མིན་ཏེ།",
    "སོང་དང་མ་སོང་ལས་ཀྱང་མིན།",
    "སྤྱིར་བྱེད་པ་པོ་དང་ལས་ཉིད་ཀྱང་གཅིག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་གཉིས་རང་བཞིན་གྱིས་གྲུབ་པ་ཅི་ལྟར་ཡོད་དེ་དེ་མི་འཐད་པར་ཐལ།",
