    "མེས་བུད་ཤིང་མི་བསྲེག་པའི་ཕྱིར་ན།",
    "བུད་ཤིང་རྒྱུན་ཆད་པས་ཀྱང་འཆི་བར་མི་འགྱུར་ལ།",
    "མི་འཆི་བའི་ཕྱིར་ན་བུད་ཤིང་རྒྱུན་ཆད་པ་ན་རང་གི་རྟགས་ཏེ།",
    "དེ་འདོད་པར་ནི་མི་ནུས་སྟེ་བུད་ཤིང་རྒྱུན་ཆད་པའི་ཚེ་ཚ་ཞིང་བསྲེག་པ་མ་དམིགས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མེ་དང་བུད་ཤིང་གཞན་ཡིན་ཡང་ཕྲད་པ་མི་འགལ་ཏེ།",
    "སྐྱེས་པ་དང་བུད་མེད་བཞིན་ནོ་སྙམ་ན།",
    "ཅི་ལྟར་བུད་མེད་སྐྱེས་པ་དང་།",
    "སྐྱེས་པའང་ལྟོས་མེད་ཀྱི་གཞན་ཡིན་པས་བུད་མེད་དང་ཕྲད་པ་བཞིན།",
    "བུད་མེད་ཕྲད་པས་བུད་ཤིང་མེ་དང་ཕྲད་པར་བསྒྲུབ་མི་ནུས་ཏེ།",
    "སྐྱེས་པ་དང་བུད་མེད་ལྟར་གཅིག་གིས་གཅིག་བསལ་བ་སྟེ་ཕན་ཚུན་མི་ལྟོས་པར་གྱུར་ན་དུས་གཅིག་གི་ཚེ་ཕྲད་དུ་རུང་བས་ཤིང་ལས་མེ་གཞན་ཉིད་ཡིན་ན་ཡང་ཤིང་དང་མེ་ཕྲད་པར་འདོད་ལ་རེག་ན་དེ་གཉིས་སྐྱེས་པ་དང་བུད་མེད་ལྟར་ཕན་ཚུན་ལྟོས་མེད་ཀྱི་གཞན་དུ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མེ་དང་བུད་ཤིང་ཕན་ཚུན་ལྟོས་མེད་ཀྱི་གཞན་དུ་མ་གྲུབ་མོད།",
    "མོ་གཤམ་གྱི་བུ་ལྟར་མེད་པ་ནི་ལྟོས་པར་ཡང་མི་རུང་བས་སོ་སྙམ་ན།",
    "གལ་ཏེ་མེ་འདི་ནི་བུད་ཤིང་འདིའི་བསྲེག་པར་བྱེད་པ་པོ་ཡིན་ནོ་ཞེས་བུད་ཤིང་ལ་ལྟོས་ནས་མེར་འཇོག་པ་ཡིན་ལ།",
    "གལ་ཏེ་བུད་ཤིང་འདི་ནི་མེ་འདིའི་བསྲེག་བྱའི་ལས་ཡིན་ནོ་ཞེས་མེ་ལ་ལྟོས་ནས་བུད་ཤིང་དུ་རྣམ་པར་འཇོག་པ་ཡིན་པས།",
    "དེའི་ཚེ་དང་པོ་བུད་ཤིང་གང་ལ་ལྟོས་ནས་མེ་གྲུབ་པར་འགྱུར་བ་ལ་བུད་ཤིང་སྔར་གྲུབ་པས་ཁྱབ་པ་ལས།",
    "བུད་ཤིང་དང་པོར་གྲུབ་པ་གང་ཞིག་ཡིན་ཏེ་མ་ཡིན་པའི་ཕྱིར་ཏེ་མེས་བསྲེག་བཞིན་པ་མ་ཡིན་པ་བུད་ཤིང་ཉིད་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་མེ་གང་ལ་ལྟོས་ནས་བུད་ཤིང་གང་ཞིག་གྲུབ་པར་འགྱུར་བ་ལ་མེ་སྔར་གྲུབ་པས་ཁྱབ་པ་ལས་མེ་དང་པོར་གྲུབ་པ་གང་ཞིག་ཡིན་ཏེ།",
    "གལ་ཏེ་བུད་ཤིང་ལ་ལྟོས་ནས་མེ་གྲུབ་པ་ཡིན་ན།",
    "གཞན་ཡང་བུད་ཤིང་ལ་ལྟོས་ནས་མེ་གྲུབ་པ་ཡིན་ན།",
    "བུད་པར་བྱ་བའི་ཤིང་ལ་ཡང་།",
    "བུད་ཤིང་མ་གྲུབ་ན་ལྟོས་པར་འགལ་ཞིང་མེ་གྲུབ་ན་ལྟོས་མི་དགོས་པས་སོ།",
    "གལ་ཏེ་མེའི་དངོས་པོ་གང་ཞིག་བུད་ཤིང་ལ་ལྟོས་ནས་གྲུབ་ལ།",
    "མེའི་ལྟོས་བྱ་བུད་ཤིང་གང་ཡིན་པ་དེའང་མེ་དེ་ཉིད་ལ་ལྟོས་ནས་ནི་འགྲུབ་ན།",
    "བུད་ཤིང་གང་ལ་ལྟོས་ནས་མེ་གང་ཞིག་འགྲུབ་སྟེ།",
    "མེ་གྲུབ་ན་བུད་ཤིང་ལ་ལྟོས་མི་དགོས་ཤིང་།",
    "མ་གྲུབ་ན་ལྟོས་ས་བུད་ཤིང་ཡང་དེ་ཉིད་ལ་ལྟོས་པས་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་གལ་ཏེ་བུད་ཤིང་གི་དངོས་པོ་གང་མེ་ལ་ལྟོས་ནས་འགྲུབ་ལ།",
    "བུད་ཤིང་གི་ལྟོས་བྱ་མེ་གང་ཡིན་པ་དེ་ཡང་བུད་ཤིང་དེ་ཉིད་ལ་ལྟོས་ནས་ནི་འགྲུབ་ན།",
    "མེ་གང་ལ་ལྟོས་ནས་བུད་ཤིང་གང་ཞིག་འགྲུབ་སྟེ།",
    "བུད་ཤིང་གྲུབ་ན་མེ་ལ་ལྟོས་མི་དགོས་ལ།",
    "མ་གྲུབ་ན་ལྟོས་ས་མེ་དེ་ཡང་བུད་ཤིང་དེ་ཉིད་ལ་ལྟོས་པས་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་མེའི་དངོས་པོ་བུད་ཤིང་ལ་ལྟོས་ནས་གྲུབ་པ་གང་ཡིན་པ་དེ་མེ་མ་གྲུབ་པའམ་གྲུབ་པ་ཞིག་ལྟོས་དྲང་།",
    "དང་པོ་ལྟར་ན་མེ་དེ་བུད་ཤིང་ལ་ཅི་ལྟར་ལྟོས་ཏེ།",
    "ཅི་སྟེ་གཉིས་པ་ལྟར་མེ་གྲུབ་པ་ཞིག་བུད་ཤིང་ལ་ལྟོས་སོ་ཞེ་ན།",
    "མེ་དེ་ནི་བུད་ཤིང་ལ་ལྟོས་པར་མི་རིགས་ཏེ་གྲུབ་ཟིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མེ་དང་བུད་ཤིང་གཅིག་དང་ཐ་དད་དཔྱད་པས་ཅི་ཞིག་བྱ།",
    "མེས་བུད་ཤིང་བསྲེག་པ་མངོན་སུམ་གྱིས་མཐོང་བས་དེ་དག་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེ་ན།",
    "མེས་བུད་ཤིང་བསྲེག་པ་མི་འགྲུབ་ལ།",
    "རྣམ་པར་དཔྱད་པའི་ཚེ་བསྲེག་ན་གཞན་ནས་འོངས་པའི་མེའམ་སྔར་ནས་བུད་ཤིང་ལ་ཡོད་པའི་མེས་བུད་ཤིང་དེ་བསྲེག་དྲང་།",
    "དང་པོ་ལྟར་ན་མེ་ནི་བུད་ཤིང་ལས་མ་གཏོགས་པ་གཞན་ལས་མི་འོང་སྟེ།",
    "བུད་ཤིང་ལའང་མེ་ནི་སྔར་ནས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གཞན་ཡང་དེ་བཞིན་དུ་མེས་བུད་ཤིང་བསྲེག་པ་སུན་འབྱིན་པའི་ལྷག་མ་ནི་སྔར་སོང་བ་དང་།",
    "མ་སོང་བ་དང་།",
    "རེ་ཤིག་བསྲེག་ལ་མི་བསྲེག་སྟེ་ཞེས་སོགས་འདོན་པ་བསྒྱུར་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་སོགས་ཀྱི་ཚིགས་སུ་བཅད་པ་གཉིས་གསུངས་པ་ནི་ཚིགས་སུ་བཅད་པ་འདིའི་དོན་ལྟོས་བཅས་ཀྱི་དངོས་པོ་ཀུན་ལ་སྦྱར་ནས་རྣམ་པ་ལྔའམ་བདུན་དུ་བཙལ་ན་མི་རྙེད་ཀྱང་མ་དཔྱད་པར་ཕན་ཚུན་ལྟོས་ནས་གྲུབ་པའི་ཐུན་མོང་མ་ཡིན་པའི་བདེན་གཉིས་ཀྱི་འཇོག་ཚུལ་མཛད་པར་སྣང་བས་སྐལ་བ་དང་ལྡན་པ་དག་གིས་བླང་བར་བྱ་བ་ཡིན་ནོ།",
    "མཚན་ཉིད་ལ་སོགས་པ་ལྟོས་བཅས་ཀྱི་དངོས་པོ་རྣམས་རང་གི་ལྟོས་ས་ཉེ་བར་ལེན་པའི་ཕུང་པོ་དང་།",
    "སྨད་མེད་ཁྱོད་ཀྱིས་ཐུགས་སུ་ཆུད།",
    "གཏི་མུག་གི་མེ་དག་གིས་འཚིག་པ་མ་ཡིན་ནོ།",
    "སོང་ཞེས་མཁས་པ་གང་ཞིག་འཚོལ་བ་བྱེད།",
    "ཐམས་ཅད་བདག་གི་དབེན་ཞིང་གནས་མེད་ལ།",
    "མར་མེ་མཛད་པ་མཐོང་ནས་ཁྱོད་ཀྱིས་རྟོགས།",
