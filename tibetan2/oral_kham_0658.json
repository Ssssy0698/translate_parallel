    "མ་ཚོར་བ་དང་རང་བཞིན་ཉམས་པའི་གནས་སྐབས་དང་མི་འདོད་བཞིན་དུ་བཅུག་པ་ཉིད་ནའོ།",
    "རང་བཞིན་གྱིས་ལས་སུ་རུང་བ་ཉིད་ལེན་ན་སྨད་པར་བྱ་བ་མེད་དོ་ཞེས་བྱ་བ་ནི་གང་རང་བཞིན་གྱེས་ཏེ།",
    "བསམ་པ་ཙམ་ཉིད་ཀྱིས་གཞན་གྱི་ཕུང་བར་ཡོད་པར་གྱུར་པ་དང་རང་ལ་གྲུབ་པ་རྐུ་བ་ཆུ་བཏང་བ་འམ་འགགས་པ་ལས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཡོད་དེ་གནས་གང་ན་འདུག་པ་དེ་གནས་དང་བཅས་ཏེ་བརྐུས་ནའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དུག་དང་ཕྱེ་མ་དང་དོང་དང་ཤིང་དང་རང་བཞིན་ཉམས་པ་གཏོང་བ་དང་བྲང་དུ་འདེབས་པ་དང་།",
    "སྟེང་ནས་འཁྱུད་པ་ཞེས་བྱ་བ་ནི་སྟེང་ན་འདུག་པ་ལུས་ཀྱི་འོག་ཏུ་འཇོག་ཅིང་འཁྱུད་པར་བྱེད་པའོ།",
    "ཁྱེའུ་བཞིན་བསྲུང་བར་བྱའོ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་ཁྱིམ་པ་དག་ལ་བྱིན་པའི་ཁྱེའུ་རྣམས་ལ་ཁ་ཏོན་བྱེད་པའམ་ཡིད་ལ་བྱེད་པ་བསྐྱེད་ཅིང་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ་སྲུང་བར་བྱེད་པ་དེ་བཞིན་དུ་འདི་ལ་ཡང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་དུ་འདུག་པས་གནས་པར་ནུས་པ་དེ་ལ་མལ་དུ་སྣོད་མ་ཡིན་པ་ཉིད་དོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ལ་བརྟེན་པ་ཉིད་དང་།",
    "འདུག་སྟེགས་དང་།",
    "རྩིག་པས་བསྐོར་བའི་གྲོང་ལ་ནི་ཇི་ཙམ་དུ་བ་ལང་དྲུག་དང་ལྡན་པའི་ཤིང་རྟ་སྤྱིག་མ་ཅན་གྱིའམ་བྱ་གག་སྤར་ནས་འདུག་པའི་ལམ་གྱིས་ཁྱབ་པའོ་ཞེས་བྱ་བ།",
    "བྱ་གག་སྤར་ནས་འདུག་པའི་ཞེས་བྱ་བ་ནི་ལམ་ཇི་ཙམ་ན་འདུག་པ་དེ་ནི་འདིའམ་སྔ་མ་གང་ཡང་རུང་བ་ཉེན་ཀོར་ཡིན་ནོ།",
    "བུ་དེ་རྣམས་ཞུཇི་སྙེད་པ་དག་དང་འབྱེལ་པ་ཇི་སྙེད་པ་ཡོད་པ་རྣམས་དང་མནའ་མ་ཇི་སྙེད་པ་དེ་རྣམས་འཁོད་པ་ཐམས་ཅད་ལ་ཕྱིས་གནོན་བྱས་ཤིང་འདུག་པའམ།",
    "ཕྱིས་གནོན་མ་བྱས་ཤིང་འདུག་པར་གྱུར་པ་ཞེས་བྱ་བ་འདི་ལ་ཕྱིས་གནོན་མ་བྱས་ཤིང་འདུག་པར་ཡང་འགྱུར་ཏེ།",
    "ཐམས་ཅད་ལ་ཕྱིས་གནོན་མ་བྱས་ཤིང་འདུག་ལ་ཞེས་བྱ་བ་འདི་ལ་ཐམས་ཅད་ཕྱིས་གནོན་མ་བྱས་པར་འདུག་པར་ཡང་འགྱུར་ཏེ།",
    "སོ་སོར་ཉེ་བར་འདུག་པའི་མཚན་མ་འདི་གཉིས་ནི་གནས་ཀྱིས་ཞེས་བྱ་བའོ།",
    "གང་ཞིག་དུས་ཚིགས་གསུམ་པོ་དག་ལས་དུས་ཚིགས་གང་ཡང་རུང་བའི་དུས་ཚིགས་སུ་སྤྱད་པ་གང་ཡིན་པའོ་ཞེས་དུས་ཟད་པའི་ངོ་བོ་བརྗོད་པའོ།",
    "ལེགས་པར་སྦྱོར་བ་ནི་སྟན་འདི་ལ་འདུག་ཅེས་ཟེར་བ་ལ་དེའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་དང་།",
    "གང་ཞིག་དུས་མཉམ་པ་ལ་དེ་བས་ན་དུས་མཉམ་དུ་འདིས་བརྩམས་པ་ལ་ཉེས་བྱས་མ་བྱས་པ་ཉིད་མ་ཡིན་ཏེ།་",
    "སུ་ཞིག་དེ་ལ་རྗེས་སུ་འདོད་ཅིང་འདུག་པ་ཞེས་བྱ་བ་འམ།",
    "གནས་མལ་འདུག་པའི་ཕྱོགས་ནས་བརྩམས་ཏེ།",
    "འདུག་པའི་ཞེས་བྱ་བ་ནི་གནས་དེར་འདུག་པའི་སྟེ་མཐར་ཐུག་པ་ཡང་ཉེས་བྱས་འདི་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅི་འགྲེང་སྟེ་བལྟ་བར་བྱ་བའམ་ཞེ་ན་མ་ཡིན་ཏེ་དེའི་ཕྱིར་འདུག་སྟེའོ།",
    "དེའི་ཕྱིར་འདུག་པ་ལའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེའི་ཞེས་བྱ་བ་ནི་འདུག་པའོ།",
    "གང་ལ་དེ་དག་བྱེད་པ་པོ་དག་ཅེས་བྱ་བ་འདིར་འདུག་པའི་གནས་ལས་ཐོབ་པ་འཇུག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "བདག་པོ་ཁྱེམ་པ་དང་ལྷན་ཅིག་འཇུག་པ་གང་ཡིན་པ་དེ་ནི་བདག་པོ་ཁྱེམ་པ་དང་བཅས་པའི་འདུག་གནས་སོ།",
    "འདུག་གནས་སོ་ཞེས་བྱ་བ་ནི་འདི་ལས་འདིར་བྱེད་པ་བོ་རྣམས་ཞེས་བྱ་བ་འདི་ལས་ཡོངས་སུ་གྱུར་པ་ལ་སོ་སོར་ཉེ་བར་གནས་པའོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་དགེ་སློང་མི་ན་བས་བསོད་སྙོམས་གཅིག་བཟའ་བར་བྱའོ།",
    "དེ་ཉིད་དུ་འདུག་སྟེ་མ་བསྟབས་པར་ཟོས་ཀྱང་ཐོང་བ་མེད་ཅེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་འདུག་པའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཁ་ཟས་སྤངས་པ་དང་འདུག་པ་ཆོག་ཤེས་པའི་གནས་ལ་སྤངས་པ་གང་ཡིན་པ་དེ་ནི་སྤངས་པ་ཡིན་ཞེས་བྱ་བ་ནི་འདིར་བསྡུས་པའི་དོན་ཏོ།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་དང་མི་འཐོབ་པའི་ཕྱོགས་དང་མདུན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ལྷག་བོར་བྱ་བ་མི་འབྱུང་ངོ་ཞེས་བྱ་བ་ནི་མཚམས་ཀྱི་ཕྱི་རོལ་ན་གནས་པ་དང་།",
    "མདུན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ཞེས་བྱ་བའི་བསྡུ་བའོ།",
    "མ་དྲིས་པར་ཟ་ན་གཞིའི་འདུག་གནས་པ་དག་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "ཁང་ཁྱེམ་གྱི་འདུག་གནས་པ་དག་ལ་ནི་ཏྲིང་བྱེད་དུ་འགྱུར་རོ།",
    "མ་དྲིས་པར་ཟོས་ན་ཁང་ཁྱེམ་གྱི་འདུག་གནས་པ་དག་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "དེར་ཡང་རང་བཞིན་ཅན་ཡིན་གྱི་བཅོས་པ་མ་ཡིན་ནོ།",
    "གང་ཞིག་འདུག་པ་ལ་མ་ལོན་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ནང་དུ་ཞག་མ་ལོན་པ་ཉིད་དུ་མི་འགྱུར་ཞེས་བྱ་བ་དེ་ལ་འདི་བསྟན་པའོ།",
    "སྣོད་ཕྱོགས་ན་འདུག་པ་དེས་ཀྱང་ས་དེར་བཙོས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "སྣོད་རུང་བ་མ་ཡིན་པའི་ཕྱོགས་ན་འདུག་པ་ནི་དཔེར་ན་སར་གཞག་པའམ་རྒྱུད་ནས་སོ།",
    "འཚོད་རྟེཔར་བྱེད་པ་པོ་རྔུདེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "དེས་དེར་ཁུ་རྔུབ་བྱིན་ལེན་བྱས་པ་ན་སྣུམ་བག་འཐོན་ཅིང་སྟེང་དུ་ཞག་ཉ་མིག་ཆགས་ལྐུཤིང་འདུག་ནས་དགེ་སློང་དེ་འགྱོད་པ་སྐྱེས་པ་དང་།",
    "བཞིན་བཟངས་མིག་ལམ་ན་མ་འདུག་ཤིག།་",
    "དེ་སྐད་བརྗོད་ཀྱང་མིག་ལམ་ན་འདུག་ན་དེའི་ཚེ་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "དེའི་ཕྱིར་མི་འདུག་ན་དབྱུག་གུ་སྐམ་ཁས་དལ་བུ་དལ་བུས་རྫ་མའམ་བུམ་པར་བཅུག་སྟེ་ཁ་བཅད་ནས་བུ་ག་བཏོད་དེ་བསལ་བར་བྱའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཅི་དེ་གཉིས་གནས་གང་ན་འདུག་ཀྱང་རུང་ངམ་ཞེ་ན།",
    "དེའི་ཕྱིར་མངོན་སུམ་དུ་བརྣགས་པས་འདུག་ནའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ན་སྨད་པ་དེ་བས་ན་མཐར་ཐུག་པའི་རྩེ་གཅིག་པ་ཉིད་ནི་འདིར་གནས་ཀྱི་ཚིག་དང་སྔ་མ་ནི་འདུག་པའི་ཚིག་གོ།",
    "སྟན་ལ་གནས་ཤིང་འདུག་པའི་ཉེས་པ་འདི་ནི་གཞན་ཏེ་འདུག་པ་ལ་ཡང་སྔ་མའོ་ཞེས་རིག་པར་བྱའོ།",
    "དེའི་ཕྱིར་དེ་དག་མེད་པར་དེར་ཉིན་མཚན་གཉིས་ལས་ལྷག་པར་འདུག་ནའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།་",
    "དེ་ལས་གང་སྙེདུ་ལྷག་པར་འདུག་ནའོ་ཞེས་བྱ་བ་འདི་ནི་ཉིན་མཚན་དག་གོ།",
    "དགོས་པ་མེད་ན་སྔ་མ་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི་རིགས་པའི་ཚུལ་ཀྱིས་དགོས་པ་མེད་ན་སྔ་མ་ཡང་ཉིན་ཞག་གསུམ་པར་འདུག་པ་ལས་གནས་པ་གང་ཡིན་པ་དེ་ལ་ཡང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཟླ་བའི་རྣམ་པ་ལྟ་བུ་ཞེས་བྱ་བ་ནི་མདུན་དུ་ཡང་རུ་དངར་རྒྱབ་ཏུ་ཡང་རུ་༢དངར་གློར་ཡང་རུ་་དངར་ལ་དབུས་ན་རྒྱལ་བོ་འདུག་པའོ།",
    "ཤིང་རྟའི་དབྱིབས་ལྟ་བུ་ཞེས་བྱ་བ་ནི་མདུན་དུ་ཡང་རུ་ཇེདངར་གློར་ཡང་རུ་དངར་ལ་༥རྒྱབ་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "གཡུལ་ངོའི་རྣམ་པ་ལྟ་བུ་ཞེས་བྱ་བ་ནི་མདུན་དུ་ཡང་རུ་༦དངར་རྒྱབ་ཏུ་ཡང་རུ་༧དངར་ལ་དབུས་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "འདུག་པ་ལ་ནི་སྐྱོན་མེད་པའི་ཕྱིར་དང་ཉམས་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "དེ་བས་ན་འདུག་པ་ལ་བསྒྲུབ་པས་སོ།",
    "འདི་ལ་གཅིག་པ་ཉིད་ཀྱི་ཕྱིར་འདུག་པ་ཉིད་དག་ལ་འདིར་ཐོབ་པ་ལ་བསྡུས་པ་འདི་ཡིན་ནོ།",
    "གནས་སྐབས་འདི་ལ་འདུག་པ་འདིའི་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བ་ཉིད་དོ།",
    "འདུག་པའི་དབུས་སུ་གནས་པ་ལ་ནི་འཁོར་གྱི་དབུས་ཀྱི་དངོས་པོ་ཉིད་ལ་ཡོད་པ་མ་ཡིན་ཏེ།་",
    "དེ་གཉིས་གནས་གང་ལ་ཡང་རུང་བ་ན་འདུག་པ་བྱེད་པ་པོ་ཡིན་ནམ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "གཙུག་ལག་ཁང་དང་དེའི་ཉེ་འཁོར་ན་འདུག་པ་ནི་མ་གཏོགས་ཏེ་ཞེས་བྱ་བ་འདིའི་དོན་ཏོ།",
    "དེ་ཡལ་བར་མི་དོར་ཞེས་བྱ་བ་ནི་གཙུག་ལག་ཁང་ན་འདུག་པའམ།",
    "འདིར་གཞུང་ནི་ཞུ་བ་ཁ་ཅིག་ལས་དགེ་སློང་གསེར་གྱི་སྟེགས་བུ་ལ་འདུག་ན་ཉེས་བྱས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདུག་པའི་ཕྱིར་གནས་མལ་ཡང་ངོ་ཞེས་བྱ་བ་ལ།",
    "དེ་རྣམས་ལ་འདུག་པར་མི་བྱེད་ཅིང་།",
    "ཀྱང་ངོ་ཞེས་བྱ་བའི་སྒྲ་ནི་མི་རྟག་པས་ཉེན་པར་གྱུར་པ་༦ཡིད་ལ་བྱེད་པས་འདུག་པར་བྱའོ་ཞེས་བྱ་བའི་རྗེས་སྙེག་པའི་ཕྱིར་རོ་སྙམ་དུ་ཤེས་པར་བྱས་ནས་ཞེས་བྱ་བ་ནི་ཁྱིམ་པའི་ཡིན་ནོ་སྙམ་དུ་ཤེས་པར་བྱས་ནས་སོ།",
    "གཞན་གྱི་ཚེ་ཞེས་བྱ་བ་ནི་བསྣུན་པའི་དུས་ཀྱི་འོག་དུས་གཞན་གྱི་ཚེ་ཤི་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བས་ན་འདུག་པ་ལྟེ་བ་ཙམ་དུ་སོན་པ་ལ་དངོས་གཞིའི་བྱེ་བྱེད་པ་ཉིད་ནི་མ་ཡིན་ནོ།་།",
    "དེ་བྱེད་པ་ལ་ཉེ་བར་བསྐོར་ཏེ་འདུག་པར་མི་བྱའོ།",
    "འགལ་བར་བྱེད་པའོ་ཞེས་བྱ་བ་ནི་དེ་ལས་བཟློག་སྟེ་མི་འདུག་པ་དང་མི་འགྲོ་བ་དང་གནས་མལ་མི་ལེན་པ་དང་གཙུག་ལག་ཁང་མི་ལེན་པ་དང་མི་སྨྲ་བའོ།",
    "དེ་བས་གཞན་པའི་དགེ་སྦྱོང་དང་བྲམ་ཟེ་དང་ལྷན་ཅིག་འདུག་པས་དེ་རྣམས་ལ་མ་དྲིས་པར་འཇུག་པ་ལ་རྩང་བ་མེད་དོ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "མལ་སྟན་ཆེན་བོ་ལ་འདུག་པ་འམ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "འདུག་པ་བཀག་པར་གཏོགས་པའོ།",
    "ཁྲི་རྩེག་མའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "པེ་སྣར་འདུག་པེ་ཤིང་།",
    "༣༢༥པེ་སྣར་འདུག་པེ་སྣར་ནི།",
    "པེ་སྣར་སྐྱབས་ཡོད་པ་ན་འགྲེང་བ་ཐམས་ཅད་ལ་ཕྱིས་གནོན་དང་འདུག་པ་དང་།",
    "སྣར་འདུག་པེ་སྣར་འཕྲོག་པེ་སྣར་བགེགས།",
    "པེ་སྣར་འདུག་པེ་སྣར།",
    "༦༡༢པེ་སྣར་ཅིག་༦༡༣པེ་འདུག་པེ་སྣར་ཞེས་བྱ་བ་ནི་དེ་ཡང་ཕྱེད་ཉིད་དེ།",
    "པེ་སྣར་འདུག་པེ་སྣར་བཟོད།",
    "གོར་དུ་༢སྨོས་པ་རྣམས་ལྟར་བྱས་ཏེ་འདུག་པར་སྟོན་པའོ།",
    "ཙོག་ཙོག་པོར་འདུག་ཅེས་པ་ནི།",
    "སྟན་ལ་འདུག་པ་མ་ཡིན་གྱི་གོང་གོང་པོར་བྱ་བྱ་བའོ།",
    "གནས་སྦྱིན་པའི་མཐའ་ནི་ནུབ་གཅིག་གནས་ཏེ་འདུག་པས་སོ་ཞེས་པ་ཡིན་ཏེ།",
    "དེ་ལ་སེང་གེའི་སྐྲ་ཞེས་པ་ནི་ཡིད་ཀྱིས་སྔོ་བ་ལྟ་བུའང་ལྕང་ལོར་འདུག་པའོ།",
    "སེར་བ་དང་སྔོ་བ་དང་དཀར་བ་ནི་རང་བཞིན་གྱིས་དེ་ལྟར་འདུག་པ་ལ་བྱ།",
    "གླེབས་པ་ཞེས་པ་ནི་ནས་འབྲས་ཀྱི་ཆན་གཏུན་གྱིས་བརྡུངས་པ་ལྟ་བུར་ལུས་སམ་མགོ་ལེབ་༡ལེབ་པོར་འདུག་པ་ལ་བྱ།",
    "ཀོསྐོ་ག་ཅིག་ཅེས་པ་ནི་ཀོསྐོ་མདུང་རྩེ་ལྟ་བུར་འདུག་པའོ།",
    "མཉམ་པར་༥འདུག་པའམ་ཕྲག་པ་གཡས་གཡོན་ལ་མིག་ཡོད་པའོ།",
    "༡༧ཚུན་ཆད་ཅེས་པ་ནི་གྲོང་ངམ་གཙུག་ལག་ཁང་བཞི་༡༨ལ་འདུག་པ་རྣམས་ཀྱིས་སྐྲ་བྲེགས་པ་ནི་སོར་གཉིས་སྲིད་དུའང་མི་གཞག་པར་བྲེགས་༡༧པའོ།",
    "གཙུག་ལག་ཁང་དུ་ཁྲུས་བྱེད་ན་སྟོར་༡ཁུང་ག་ལ་འདུག་པར་ཁྲུས་བྱ་བྱ་བའོ།",
    "རྩུབ་པོར་རུས་སྦལ་གྱི་གཟུགས་ལྟ་བུའོ་ཞེས་པ་ནི་རྐང་པ་བཀྲུ་བའི་གཞི་ཉིད་རྡོ་ལས་རུས་སྦལ་གྱི་གཟུགས་ལྟ་བུ་རྒྱབ་རྩུབ་པོར་འདུག་པར་བྱོས་ཤིག་པའོ།",
    "ཚུལ་ཕྱི་མར་ཞུགས་པ་ལས་གནས་མེད་པར་གྱུར་ན་ཟླ་བ་གཉིས་ལས་ལྷག་པར་མ་འདུག་ཤིག་པའོ།",
    "གོང་དུ་གནས་མེད་པར་མ་འདུག་ཅིག་ཅེས་པ་དེའི་བྱེ་བྲག་བསྟན་པའི་ཕྱིར།",
    "མེད་པ་ཚོལ་བའི་ཚེ་གནས་པར་འོས་པ་མི་གནས་པར་འདུག་ཀྱང་ཉེས་མེད་ཅེས་པ་ཡིན་ཏེ།",
    "གནས་མེད་པར་འདུག་ཀྱང་ཉེས་པ་མེད་པར་སྟོན་པའོ།",
    "ཞག་ལྔའི་བར་དུ་གནས་མེད་པར་འདུག་པའི་ཚེ་རྙེད་པ་བླང་དུ་རུང་ངམ་མི་རུང་ཞེ་ན།",
    "སྒོ་༢བརྡུང་ཞིང་ནང་ན་འདུག་པ་ཤེས་པར་བྱ་ཞེས་པ་ནི་དགེ་སློང་གཞན་གྱི་གནས་ཁང་དུ་འགྲོ་ན་གནས་པ་ཉི་ཚེ་མ་ཡིན་གྱི་སུས་ཀྱང་རུང་སྟེ།",
    "མི་འདུག་ཅེས་པ་ནི་དེའི་མདུན་བཅད་ལ་འགྲེང་༡བ་འམ་འདུག་པ་མ་བྱེད་ཅིག་པའོ།",
    "འདི་ལྟ་བུར་བྱད་ལག་སྲེལ་ཞིང་འདུག་ཀྱང་སོ་སོའི་མཚན་ཡོད་པས་ན་མ་ནིང་ལ་སོགས་པ་མ་ཡིན་ཏེ་སྡོམ་པ་འཆགས་ས་སོ།",
    "དཀྲེ་སྤྱི་ཞེས་པ་ནི་སྤྱི་བོ་དཀྲེ་ལྟར་མྱུག་མྱུག་པོར་འདུག་པའོ།",
    "མིག་གཟེའུ་ལྟར་འདུག་པ་དང་།",
    "སེར་པོ་དཀར་པོ་དམར་པོ་ག་ཅེའུ་རྣ་ཞེས་པ་ནི་རྣ་བ་འདི་རྣམས་ལྟར་འདུག་པའོ།",
    "སྐྲ་སྔོན་པོ་ཞེས་པ་ནི་སྐྲ་རམས་ཁར་འདུག་པའོ།",
    "དེ་ལ་རིང་པོ་ཞེས་པ་ནི་སྤྱི་རིངས་སུ་འདུག་པའོ།",
    "ཏ་ལའི་མགུལ་པ་ཞེས་པ་ནི་མགུལ་པ་ཉེར་ཉེར་པོར་འདུག་པའོ།",
    "མ་ཚོར་བ་དང་རང་བཞིན་ཉམས་པའི་སྐབས་དང་།",
    "བདར་བ་ཕྱི་རོལ་དུ་བྱས་ལ་ནང་དུ་ལྡུགས་པ་དང་བདར་བ་ནང་དུ་བྱས་ལ་ཕྱི་རོལ་དུ་འབོ་བ་ལྟ་བུའང་རངས་པར་འགྱུར་བའོ།",
    "དབེན་པ་ནི་གསུམ་སྟེ་ཞེས་པ་ནི་བསྐོར་བའི་སྒོ་བཅད་དེ་འདུག་པ་དང་།",
    "མཚམས་སུ་འདུག་པ་སྤོས་ན་འདིས་མ་སྐོངས་པ་ཡིན་ཞེས་པ་ནི་འོབས་སམ་མུ་ཚིགས་ལ་སོགས་པའི་མཚམས་སྤོས་ཤིང་བསྒྱུར་ན་རྐུན་པོར་མི་འགྱུར་བ་མ་ཡིན་པའོ།",
    "དེར་མི་གནས་པས་དབྱར་གྱི་གོས་སྐལ་མི་མནོད་༢ཅེས་པ་༢དབྱར་གནས་དེ་ན་མ་འདུག་པས།",
    "གཞན་ཡང་དུག་ཕྱེ་མ་རླུགས་༨ཤིང་རང་བཞིན་ཉམས་ཏེ་གཏོང་བ་བྲང་དུ་བསྣུན་པ་འཁྲུལ་འཁོར་འཛོལ་༩རོ་སློང་བ།",
    "མ་བསམས་པར་ལྟོ་མཉེས་པའི་མ་དང་མངལ་ནི་སྦོམ་པོའོ་ཞེས་པ་ནི་མངལ་ན་འདུག་པ་བསད་པའི་ཕྱིར་མའི་ལྟོ་མཉེས་པ་ལས་མངལ་ན་འདུག་པ་ནི་མ་ཤིའི་མ་བསད་པར་མ་བསམས་པ་ལྟ་བུ་ཤི་བ་ལྟ་བུ་གསོད་པར་ཤོམ་པའི་སྦོམ་པོ་ཡོད་པར་ཟད་ཀྱི་མ་ཤི་བ་ཉེས་མེད་པར་མི་འགྱུར་བའོ།",
    "དེའི་ཚུལ་དུ་འདུག་པས་སོ་ཞེས་པ་ཡིན་ཏེ།",
    "༤དབེན་པ་ན་འདུག་པ་དང་འགྲེང་བའོ་ཞེས་པ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "དབེན་པ་ན་འདུག་པ་དང་།",
    "རྒྱུས་ཤེས་བཞིན་དུ་ཤིང་ངམ་རྩིག་དྲུང་འདི་ལྟ་བུ་ཞིང་༩ན་སྡོད་ཅིང་འདུག་གོ་ཞེས་བསྟན་ན་སྦོམ་པོར་འགྱུར་བའོ།",
    "དཔེར་ན་དངོས་སུ་མིག་༩ལམ་ག་ན་འདུག་ལ།",
    "གནས་གང་དུ་འདུག་པ་དེའི་ཉེ་༦སྤྱོད་ལ་ཡང་མ་གཏོགས་པའི་ལོགས་ཤིག་ན་འདུག་འདུག་པ་ལས་སྐྱ་༐",
    "དེ་ལ་གནས་ཤེས་པ་༨དེར་འདུག་པ་ཙམ་གྱིས་གནས་སུ་མི་འགྱུར་བས་ན་དེ་མཚན་ཉིད་སྟོན་པ་ནི།",
    "འགྲོ་བ་དང་འདུག་པ་དང་ཐུལ་ཡབས་ཀྱིས་ཇི་ཙམ་སླེབས་པའི་ཁོངས་གོ་ཞེས་པ་ཡིན་ཏེ།",
    "ཆོད་པས་ཁྱེར་ན་མི་བླང་ཞེས་པ་ནི་མི་ག་ཅིག་གཉིས་ཀྱིས་ཆོད་པའི་འོག་ན་འདུག་པས་ཁྱེར་ན་ང་འདོད་དོ་ཞེས་དེ་ལ་མ་སློང་ཤིག་པའོ།",
    "འབྲལ་བའི་ཞག་དུས་ངེས་པར་སྟོན་པ་ནི།",
    "གང་དུ་དཔང་འཛུགས་པར་འགྱུར་བ་དེར་མི་འདུག་པར་བྱ་ཞེས་པ་ནི་འཐབས་༢ཤིང་རྩོད་པ་ལ་སོགས་པའི་དཔང་དུ་འགྱུར་བ་ཙམ་གྱི་ཚོད་ན་དེ་ན་མ་འདུག་པར་བྱོལ་ཅིག་པའོ།",
    "འདུན་པ་ལ་༨སོགས་པ་ཉིད་ཀྱི་ལས་སུ་བྱ་བ་རྣམས་ཀྱང་ཟླ་ལ་གྱིས་ཤིག་པར་སྟོན་པའོ་། བྱ་ར་བྱ་ཞེས་པ་ནི་ཕ་ཟད་ན་འདུག་པའི་དགེ་སློང་དེས་ཁྱིམ་པ་དོང་ངམ་མ་དོང་བ་ལ་སོགས་པ་བགས་ཀྱིས་ལྟ་༩ཞིང་བྱ་ར་གྱིས་ཤིག་པའོ།",
    "འདུག་པའི་ཁྱིམ་པས་མ་བརྟུལ་ན་༐",
    "འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ་གནས་དེ་དག་ལྟ་བུ་ན་འདུག་ན་གདོད་ཉེས་པར་འགྱུར་བའོ།",
    "ཇི་ཙམ་གྱིས་འདུག་པར་འགྱུར་ཞེ་ན།",
    "རྐུབ་བཞག་པ་ཙམ་གྱིས་དེ་ཉིད་དོ་ཞེས་པ་ཡིན་ཏེ་རྐུབ་ས་ལ་བཞག་པ་ཙམ་གྱིས་འདུག་པར་ཆུད་པའོ།",
    "ཞག་གཉིས་སུ་འདུག་ན་ཉེས་བྱས་སུ་སྟོན་པའོ་། བདག་པོ་མེད་ན་ཡང་ངོ་ཞེས་པ་ནི་བདག་པོ་མེད་པའི་འོག་ཏུ་ལན་གཉིས་ཟོས་ན་ཉེས་བྱས་སུ་སྟོན་པའོ།",
    "འདུག་ནས་སོ་ཞེས་པ་ཡིན་ཏེ་འདུག་པའི་གནས་ནས་ལངས་ནས་གདོད་ཉེས་པར་འགྱུར་བའོ།",
    "འདུག་གོ་ཅོག་ལས་སམ་ཞེ་ན།",
    "གནས་སུ་གནའ་༢ནས་གྱེས་པ་ནི་མ་ལུས་པ་མ་ཡིན་ཞེས་པ་ནི་༤ཤིང་ལྟ་བུ་གནའ་༥ནས་གནས་ཀྱི་ནང་དུ་སྐྱེས་ཤིང་འདུག་པ་ཞིག་ན་ཡང་མཚམས་ཀྱི་ནང་དུ་ལུས་པ་ཡིན་ནོ་བར་སྟོན་པའོ།",
    "རྩ་བ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་ལ་ལོ་མ་ནང་དུ་བོ་བ་དང་རྩ་བ་ནང་དུ་ཟུག་ལ་ལོ་མ་ཕྱི་རོལ་དུ་བོ་བ་དང་།",
    "འཚེད་༢༡པ་དེར་གཏོགས་ཀྱང་མ་ཡིན་ཞེས་པ་ནི་བཙོ་བ་ཉིད་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འཚེད་པའི་བྱན་ཏྲཔོ་ནང་དུ་འདུག་པ་ལྟ་བུ་ནི་འཚེད་པ་མཚམས་ཀྱི་ནང་དུ་གཏོགས་ཀྱང་ཕྱི་རོལ་དུ་བཅོས་པར་སྟོན་པའོ།",
    "རྩེག་མའང་དེའོ་༧ཞེས་པ་ནི་ཁང་པ་བརྩེགས་པ་དུ་མར་འདུག་པ་ཞིག་ན་༨ཉེ་སྤྱོད་ཀྱི་ཁོངས་སུ་གཏོགས་པར་སྟོན་པའོ།",
    "གྲུའི་ངོར་ཡང་ངོ་ཞེས་པ་ནི་གྲུར་འཇུག་པའི་ཚེ་ན་ཡང་གྲུའི་ངོར་མ་འདུག་ཤིག་པའོ།",
    "མངོན་སུམ་མཚམས་ཀྱི་ནང་རྣལ་མའི་ཕྱོགས་ན་འདུག།",
    "རྣལ་མའི་ཕྱོགས་ན་འདུག་ཅེས་པ་ནི་སྟེང་དང་ཤོད་ལྟ་བུའམ་སྟེགས་བུ་ལ་སོགས་པ་ཁྲི་འཕང་མཐོན་ད་མན་མ་ཁྱེར་བར་ས་མཉམ་པའོ།",
    "བསོད་སྙོམས་༧ཁྱེར་ཏེ་འོངས་པ་ལས་ཁ་རོག་པར་འདུག་གམ་བཀྱིགས་པ་དང་འོ་ན་ཅི་སློང་ཞེས་པ་འདྲི་བ་ནི་ཅི་བདེར་བསྟབས་པའོ་ཞེས་པ་ཡིན་ཏེ།",
    "སེ་གོལ་གཏོགས་ལ་བཞིན་བཟངས་༢མི་སྣང་བའི་ལམ་དུ་འདུག་ཤིག་ཅེས་བྱ་ཞེས་པ་ཡིན་ཏེ་སྙད་༢འདི་སྐད་དུ་གྱིས་ལ་སྐྲོད་ཅིག་པའོ།",
    "ཇི་ལྟར་འདུག་པས་ཤེ་ན་མངོན་སུམ་གྱི་ཚུལ་གྱིས་འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ་གབ་ཅིང་བ་ཞབས་༢པས་ནི་མ་ཡིན་གྱི་མངོན་སུམ་དུ་འདུག་ཅིང་སྨྱེན་༢ངན་གྱི་བར་དུ་གཅོད་ན་གདོད་ཉེས་པར་འགྱུར་བའོ། ༐",
    "སྨྱེན་ངན་གྱི་༤གནས་ན་འདུག་པའོ།",
    "དེ་ལ་འགྲེང་བ་ཉི་ཚེ་མ་ཡིན་ཏེ་འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་གཞན་གྱིས་༩ན་ཡང་ཉེས་པར་འགྱུར་ར་རོ།",
    "མཛོད་ཀྱང་དེར་གཏོགས་སོ་ཞེས་པ་ནི་མཛོད་ཀྱི་སྒོ་ནས་༡ཁྱམས་སམ་ཁྱིམ་ཡོད་པར་དགེ་སློང་འདུག་ཅིང་མཛོད་ན་སྨྱེན་༢ངན་སྤྱོད་ན་ཡང་གནས་ག་ཅིག་པར་སྟོན་པའོ། ༐",
    "དེ་དག་མེད་པར་དེ་༡༡ཞག་གཉིས་ལོན་པ་ལས་ལྷག་པར་གནས་ནའོ་ཞེས་པ་ལ་སོགས་པ་ཡིན་ཏེ་རྒྱལ་པོ་ལ་སོགས་པས་བོས་པའམ་བར་ཆད་ཀྱི་རྐྱེན་མེད་ལ་དེར་ཞག་གཉིས་ལས་ལྷག་པར་འདུག་ན་ཉེས་པར་འགྱུར་བའོ།",
    "སྒྲོན་མ་༧སྦོར་བ་ནི་མེ་རངས་པར་འགྱུར་བས་ན་༨ཉེས་པའང་རངས་པར་སྟོན་པའོ།",
    "དེ་འདུག་གོ་ཅོག་ན་ཉེས་པར་འགྱུར་རམ་ཞེ་ན།",
    "གསེར་ཕོག་དང་དྲིལ་གྱིས་སྤྲས་པས་གོས་དེ་དག་ལྟར་བཤམས་ན་ཁྱིམ་པའི་འོ་ཞེས་བསམ་ཞིང་འདུག་པར་བྱ་ཞེས་པ་ནི་འདི་དག་ལྟ་བུ་༢༢བཤམས་ཤིང་སྤྲས་པའི་རྒྱན་ཅན་ཞིག་ཡིན་ན་ཡང་ཁྱིམ་པའི་ཡིན་ནོ་བར་སོམས་ལ་འདུག་ཤིག་པའོ།",
    "འདིར་ནོར་བུའི་ཁོལ་དང་གསེར་དངུལ་གྱིས་སྤྲས་པ་ཡང་ངོ་ཞེས་པ་ནི་འདི་དག་ལྟ་བུར་སྤྲས་པ་ལ་ཡང་འདུག་ཤིག་པའོ།",
    "གོ་རོ་ཙ་ནས་མི་བྱུག་ཅེས་པ་དང་སྤོས་ཀྱིས་༐",
    "འདི་བསྐོར་༡༧ལ་འདུག་པར་མི་བྱ་ཞེས་པ་ནི་འཐབ་པ་དེའི་མཐའ་བསྐོར་ལ་འཁོད་པ་ལྟ་བུ་མ་བྱེད་ཅིག་པའོ།",
    "མཚམས་ཐ་དད་པ་ན་འདུག་པ་དང་བཀར་བ་དང་།",
    "གཞན་གྱི་༢ཕྱོགས་རྣམས་ཀྱང་ངོ་ཞེས་པ་ནི་ནམ་མཁའ་ལ་འདུག་པ་ལྟ་བུ་ལ་བྱས་པ་འམ།",
    "སླས་འདུག་པའི་གནས་སུ་འདུག་ནའོ་ཞེས་པ་ནི་སླས་འདུག་པའི་ཁྱིམ་ཡིན་ན་༢།",
    "ཇི་ཙམ་ཡན་ཆད་སླས་འདུག་པའི་ཁང་པར་གཏོགས་ཤེ་ན།",
    "སྟན་མཐོན་པོ་དང་སྟན་ཆེན་པོ་ལ་མི་འདུག།",
    "ཁྱིམ་པའི་དེར་གཞན་མེད་ན་སྔ་མ་བྱ་ཞེས་པ་ནི་ཁྱིམ་པའི་དེ་ན་འདུག་ལ་རུང་བའི་ཁྲི་སྟན་གཞན་ཏྲ་མེད་ན་ཁྲི་སྟན་འདི་ལྟ་བུ་ལ་ཡང་འདུག་ནི་འདུག་ལ་མ་ཉལ་ཅིག་པའོ།",
    "ཁྲི་བརྩེགས་པ་ལ་མི་འདུག་ཅེས་པ་ནི་ཁྲི་བརྩེགས་པ་ལ་མ་འདུག་ཤིག་པའོ།",
    "ནམ་མཁའ་ནི་ཕྱེད་དོ་ཞེས་པ་ནི་དགེ་སློང་མ་ག་ཅིག་ནམ་མཁའ་ལ་འདུག་ཅིང་སྦྱིན་ནམ་ལེན་པར་བྱེད་པ་ཉེས་བྱས་སུ་འགྱུར་བའོ།",
    "གུད་ན་འདུག་པ་ལ་ངོས་མགྲོན་བྱས་ན་ཉེས་པར་འགྱུར་བའོ།",
    "དགེ་སློང་མས་ན་༧ཇི་ལྟ་བུ་ལ་འདུག་པས་བསྐོས་པའི་ཉེས་པར་འགྱུར་ཞེ་ན།",
    "དེའི་བྱིས་པ་དག་ཟས་སློང་ན་ཁུར་བ་དང་རངས་པ་མ་ཡིན་པ་ལ་སོགས་པ་བྱིན་ཅིག་པའོ།",
    "ལག་པ་མི་སྦྲེལ་འདིར་མ་བསྡམས་པས་སྟན་ལ་མི་འདུག།",
    "འདུག་པས་ཉལ་བ་ལ་མ་ཡིན་སྟན་དམའ་བ་ལ་འདུག་པས་སྟན་མཐོན་པོ་ལ་འདུག་པ་ལ་མ་ཡིན།",
    "དུས་སུ་གཏོགས་པ་ནི་ཐ་མའི་སྔ་རོལ་དུ་སྦྱོར་བའོ་ཞེས་པ་ཡིན་ཏེ་དུས་སུ་གཏོགས་སོ་ཅོག་དུས་ཐ་མ་ལ་ཐུག་པའི་སྔ་རོལ་ཀུན་ཉེས་བྱས་སུ་སྟོན་པའོ།",
    "དེ་དང་འགྲིལ་འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ།",
    "མ་བསྐོས་པ་ལ་སོགས་པ་བཅུ་དང་༡༧འབྱིན་པ་དང་ཡང་ཡང་དང་༡༧བསོད་པ་དང་འདུག་པ་དང་འགྲེང་བ་དང་སྟེར་བ་མ་ཡིན་པ་དང་མ་ཚང་བ་དང་རས་ཆེན་རྣམས་མ་གཏོགས་ཞེས་པ་ཡིན་ཏེ།",
    "དགེ་སློང་མཐོང་མ་ཐག་ཏུ་སྟན་ལས་འཕགས་ཅེས་པ་དང་འདུག་ནས་འདི་དག་འགྲེང་བ་ལ་འདུག་ཅེས་༢བསྒོ་ཞེས་པ་དང་འདུག་པའི་འོག་ཏུ་མ་བྱས་ན་ཞུ་བར་བྱ་ཞེས་པ་ནི་དགེ་སློང་པ་ལ་དགེ་སློང་མས་ཕུ་དུད་༢བྱ་བ་དང་༐",
    "འབྲི་བ་ནི་ཉིད་དོ་ཞེས་པ་ཡིན་ཏེ་མཚན་གཞན་གྱི་ཚེ་ཉེས་པ་ཆུང་ངུ་བྱས་པ་མཚན་གྱུར་ན་དེ་ལས་ལྷག་པར་མི་སྦྱར་གྱི་༡དེ་ཉིད་ཀྱི་སོ་ན་འདུག་པ་སྟེ།",
    "མ་བསྐོས་པ་ལ་སོགས་པར་སྟོན་པ་བཅུ་དང་སྨྱན་༢གནས་ན་འགྲེང་ཞིང་འདུག་པ་དང་གཅེར་བུ་མ་ལ་བྱིན་པ་དང་།",
    "སྟན་ལ་མ་གཉར་༥བར་འདུག་ཅེས་པ་ལ་སོགས་པ་འདི་དག་བསྡུ་བར་སྟོན་པའོ།",
    "མ་བྱིན་པར་ལེན་པའི་བག་ཏུ་གཏོགས་པ་ནི་མ་བསྟབས་པའི་སྟན་ལ་འདུག་པ་དང་།",
    "སྐྱབས་ཡོད་པ་ན་འདུག་པ་དང་།",
    "དབེན་པ་ན་འདུག་པ་དང་།",
    "དབེན་པ་ན་འདུག་པ་དང་སྦྱོར་དུ་བཅུག་པ་དང་།",
    "དེ་ལས་༡༧དགེ་སློང་ཕར་འདུ་ཤེས་བཞག་ནས་སོ་ཞེས་པ་ཡིན་ཏེ་དེ་ལ་དགེ་སློང་རངས་པ་ཡིན་པར་འདུ་ཤེས་བཞག་ནས་དད་པ་ལོང་ཤིག་པའོ།",
    "ནམ་མཁའ་༤ལ་མི་འདུག་ཅེས་པ་དང་།",
    "མེད་པ་ནི་མ་སྨྲ་བར་འདུག་ཤིག།",
    "ཟླ་ཡོད་ན་༥ཟླའི་མདུན་དུ་གོང་༦གོང་པོར་འདུག་ལ་བྱིན་གྱིས་རློབས་ཤིག་པའོ།",
    "དེ་ཡང་ཟླ་བ་གཉིས་ལས་ལྷག་པར་རོ་ཞེས་པ་ནི་ཚུལ་ཕྱི་མར་ཞུགས་ནའང་དེ་ལྟ་བུའི་ཚེ་ཟླ་བ་གཉིས་ཀ་ལས་གཞིར་མ་འདུག་ཤིག་པའོ།",
    "ཕལ་ཆེ་ན་གཉིས་གསུམ་གོ་བཞག་ནས་སོ་ཞེས་པ་ནི་རྒན་རབས་མང་པོ་༡༧ཞིག་འཁོད་ན་གོང་དུ་གཉིས་གསུམ་ཙམ་བཞག་པའི་འོག་ཏུ་འདུག་ལ་ཤོད་ཅིག་པའོ།",
    "འདི་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་མི་དབུལ་༢།",
    "དབུལ་དུའང་མི་གཞུག་ཅེས་པ་ནི་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པའི་དད་པ་བླང་ཡང་མི་བླང་།",
    "གྲིབ་ཤིང་དང་གཞན་ཡང་སྤྱོད་པའི་གནས་སུ་འདུག་པར་མི་བྱ་ཞེས་པ་དང་།",
    "ཁ་ཅིག་ཏུ་སྔ་དྲོའི་བཀླག་༦པ་དང་གདོན་པ་དང་འདུག་པ་དང་།",
    "འདུག་ཅིང་འཛུལ་༤དུ་འཇུག་པའི་ལས་བྱས་ན་ལས་སུ་མི་རུང་བའོ།",
    "གཞིར་བྱིན་ནས་དོན་ཆེད་བཞིན་དུ་དེ་ན་འདུག་ན་ཚུལ་འཇིག་པར་འགྱུར་བའོ།",
    "ཕྱི་རོལ་དུ་དེ་ལས་འདས་པར་མི་གནས་ཞེས་པ་ནི་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་ཞག་བཞི་བཅུ་ལས་ལྷག་པར་མ་འདུག་ཤིག་པའོ།",
    "བཀར་༩དུ་ཟིན་ཀྱང་དེ་དང་ལྷན་ཅིག་ཏུ་འདུག་ཤིག་པའོ།",
    "མགུ་བ་ལྟ་བུ་ཆད་པ་རྣམ་པ་བདུན་གྱིས་༧ཆོད་པའི་ས་ན་འདུག་པ་ལྟ་བུའོ།",
    "བླ་གབ་མེད་པར་མི་འདུག་ཅེས་པ་རྣམས་ཡིན་ཏེ།",
    "མ་གྱུར་ཀྱང་མི་འཆད་༡པ་མ་ཡིན་ཞེས་པ་ནི་གནས་ག་ཅིག་ན་དགེ་སློང་ག་ཅིག་པུ་ཞིག་འདུག་པའི་གཏན་པ་བཏིང་བའི་དོན་རོགས་དགེ་སློང་འགྲོན་༢པ་གཞན་གྱིས་བྱས་ཏེ།",
    "ཁྲི་ངན་པ་མ་ཡིན་ན་འདུག་པའི་བར་དུ་དེ་མ་ཡིན་པའི་གདིང་བ་མེད་པར་མི་བྱ་བ་དང་།",
    "མི་འདུག་ན་ཡང་ངོ་ཞེས་པ་ནི་ཤི་བའི་དྲུང་ན་དགེ་སློང་ཐ་མལ་པ་མེད་དུ་ཟིན་ཀྱང་བཀར་༡༧བས་ཡོ་བྱད་མི་འཐོབ་པའོ།",
    "གར་ཤི་བའི་གནས་མི་བརྩན་གྱི་ནོར་གང་ན་འདུག་པ་བརྩན་པའི་ཕྱིར་རོ།",
    "གུད་ནས་འདུག་པ་གཟུགས་བརྙ་ན་ལ་བྱིན་གྱིས་བརླབ་ཅེས་པ་ཡིན་ཏེ།",
    "བཅལ་བའི་ཕྱིར་ཚད་དེ་ཙམ་གྱི་ཤིང་བཅང་ཞེས་པ་ནི་ཕྱེད་དང་རངས་པར་བྱ་བ་བཅལ་བའི་ཆེག་༡ཤིང་གྱིས་ཤིག་པའོ། ༐",
    "འདི་ལ་མི་འདུག་མི་ཉལ་ཞེས་པ་དང་།",
    "ཡེ་བོར་བ་༡༧མ་ཡིན་པའི་སྟན་ལ་ཞུ་ཞིང་འདུག་པར་བྱ་བ་ལ་སོགས་པ་དུར་ཁྲོད་པའི་ཆོ་༡༧གར་སྟོན་པ་རྣམས་སོ།",
    "གྲོང་དང་ཁྱིམ་དུ་འཇུག་ཅིང་འདུག་པར་མི་བྱ་ཞེས་པ་དང་།",
    "ཡོད་ན་མི་འདུག་ཅེས་པ་ནི་མུ་སྟེགས་པའི་གནས་སུ་འོངས་པའི་ཚེ་མུ་སྟེགས་པ་ཡོད་ན་དེའི་ཐད་དུས་ལ་འདུག་ཤིག་པའོ།",
    "ཡུལ་གུད་ན་འདུག་ཀྱང་རུང་བ་མི་འཇིག་ཅེས་པ་དང་།",
    "གཞན་དུ་ཚུལ་དུ་མར་ཞུགས་ན་ཡུན་རིང་དུ་གནས་པ་བརྩན་ནོ་ཞེས་པ་ནི་གཙུག་ལག་ཁང་དུ་མའི་ཁ་བརྒྱུས་ཏེ་ཚུལ་དུ་ཞུགས་ན་གང་དུ་ཡུན་རིང་དུ་འདུག་པ་དེ་ཅི་ཆེ་ནས་རྙེད་པ་བྱིན་ཅིག་པའོ།",
    "ཁྱིམ་པ་དེར་གཞན་མེད་ན་པགས་པ་ལ་འདུག་པར་བྱ་ཞེས་པ་དང་།",
    "འདིར་དེ་ལྟ་བུའི་རྐེན་གྱིས་ནའང་མི་ཞལ་བ་ཡང་ངོ་ཞེས་པ་ནི་ཁྱིམ་པ་དེར་འོངས་ལ་སྟན་མེད་ན་ཁོལ་ལྤགས་ཀྱི་སྟན་ལ་ཡང་འདུག་ཤིག་པའོ།",
    "གཞག་པ་ཕྱི་རོལ་བཞིན་ཞེས་པ་ནི་རུང་བའི་ཁང་པ་བྱིན་གྱིས་བརླབས་༢ན་དགེ་སློང་ག་ལ་འདུག་པའི་གནས་ནས་འདོམ་གང་ཕན་ཆད་དུ་བཞག་ཅིང་བཙོས་པ་དང་འདྲེས་ཏེ་ཉེས་པ་མེད་པར་སྟོན་པའོ།",
    "དེ་ལེན་པར་ལྡང་ཞེས་པ་ནི་ཟ་བར་འདུག་པ་ལས་མི་ལྡང་ཞེས་པ་འབྲེལ་༢པའོ།",
    "རྩྭ་བམ་ལ་འདུག་པར་བྱ་ཞེས་པ་དང་།",
    "འདུག་པ་ཡང་དེ་བཞིན་ཞེས་པ་ནི་སྒྲ་བསྐྱུངས་ཤིང་སྤྱོད་ལམ་བསྡམས་༢པ་ལེགས་པར་བྱ་བ་དང་།",
    "དེ་ཐོས་པས་སོ་ཏྲཏྲ་ཞེས་པ་ནི་སྦྱིན་པ་འཆད་པའི་ཐོས་པ་ཉེན་ཀོར་ན་འདུག་པས་དེའི་ཚེ་ཟན་མ་ཟ་ཤིག་པའོ།",
    "ཚད་པ་འཛག་པས་མཇུག་༨ཚུན་ཆད་ཕྱི་བ་ཙམ་བྱ་སྟེ་སྟན་ལ་འདུག་པ་ཉེས་མེད་ཅེས་པ་དང་།",
    "དེ་མ་ཡིན་པ་གཞན་ནི་ཆུ་ཡོད་པ་ལ་བཀྲུས་ན་སྟན་ལ་མ་འདུག་ཤིག་པའོ།",
    "ས་གཞན་ལ་གནས་ཞེས་པ་ནི་དགེ་སློང་ཐ་མལ་པའི་ས་དེ་ཆད་པས་བཅད་པ་ལ་སོགས་པའི་ལས་ན་འདུག་པའོ།",
    "ལས་ནི་འདུག་ནས་སོ་ཞེས་པ་ནི་གསོལ་བ་དང་གཉིས་སམ་གསོལ་བ་དང་བཞིའི་༩ལས་འདི་རྣམས་ཏེ་བྱེད་པའི་ཚེ་ན་འདུག་ལ་གྱིས་ཤིག་པའོ།",
    "ག་ཅིག་ཏུ་རྐང་པ་ཡ་ག་ཅིག་ན་གཉིས་ཀ་འདུག་པའོ་ཞེས་པ་ནི་མཚམས་ཀྱིས་སོ་རྐང་པ་གཡས་གཡོན་གྱིས་༤མནན་ན་མཚམས་དེ་གཉིས་ཀར་གཏོགས་པའོ།",
    "གནས་ཀྱང་གར་དགའ་དགུར་འདུག་ཀྱང་རུང་བའོ།",
    "མཚམས་གུད་ན་འདུག་ཀྱང་ཞེས་པ་ནི་ནམ་མཁའ་ལྟ་བུ་མཚམས་ལོགས་ཤིག་ན་འདུག་པ་ལ་བསྒྲགས་ན་ཡང་བསྒྲགས་པར་འགྱུར་བའོ།",
    "དུས་ཤེས་པར་བྱ་སྟེ་འདུག་པ་དང་དེའི་༦སྣོད་སྟ་གོན་བྱ་ཞེས་པ་དང་།",
    "ཁོན་ཡོད་༤པ་དང་ལྷན་ཅིག་མི་བསྡད་ཅེས་པ་ནི་ཁོན་༢ཡོད་པ་དང་ཕྲད་ན་དེ་དང་ལྷན་ཅིག་ཡུན་རིང་དུ་མ་འདུག་ཤིག་པའོ།",
    "གུད་དུའང་གཉིས་སམ་གསུམ་གྱིས་གོ་བཙལ་ཏེའོ་ཞེས་པ་ནི་གྲལ་དུ་བཀད་པ་ལ་སོགས་པའི་སྐབས་གཞན་དུའང་ཅིག་ཅར་བསྡམས་ཏེ་མ་འཁོད་པར་གོ་གཉིས་སམ་གསུམ་གྱིས་བར་དུ་ཆོད་ལ་འདུག་ཤིག་པའོ།",
    "སྤྱོད་ལམ་ཤེས་པ་ནི་འགྲེང་༡༧ངམ་འདུག་པ་ལྟ་བུའོ།",
    "ངོས་གསུམ་པ་ཡང་ཞེས་པ་ནི་༧གཙུག་ལག་ཁང་གྲུ་བཞིར་འདུག་པ་ལ་ངོས་གསུམ་ནི་དྲི་ག་ཙང་ཁང་དང་གནས་ཁང་བྱས་ལ།",
    "༢མེད་པའི་ཕྱལ་པོར་འདུག་པ་ལྟ་བུར་བྱས་ཀྱང་བླ་བླ་བའོ།",
    "སྡོམ་པ་འབོགས་༡༧པའི་སྤྱོད་ལམ་ནི་འགྲོ་ཉལ་འདུག་འཕྲེས་ཅི་དགར་གྱིས་ཤིག་པའོ།",
    "འདུག་གམ་འཕྲེས་ན་འདུག་སྟེའོ་ཞེས་པ་དང་།",
    "ཉེན་ཀོར་ནས་སྤགས་ལ་མཐོང་བའི་ཉེན་ཀོར་༢འདུག་སྟེའོ་ཞེས་པ་དང་།"
  ]
}