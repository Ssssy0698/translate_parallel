    "བསྐ་བ་ནི་ལྔ་སྟེ་ཨ་མྲའི་བསྐ་བཞེས་བྱ་བ་ནས་གོང་མ་བཞིན་དུའོ།",
    "ཕྱེ་མ་བྱའོ་དགེ་སློང་དག་གིས་རློན་བ་ལ་བཏགས་པས་རི་ལུར་གྱུར་པ་དང་།",
    "དེ་དག་གིས་ཉི་མ་ལ་བསྐམས་པ་དང་།",
    "དེ་དག་གིས་གྲིབ་མ་ལ་བསྐམས་པ་དང་འོན་ཀྱང་རུལ་བར་གྱུར་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དགེ་སློང་གིས་བསྐ་བས་ལུས་བྱུགས་ནས་བཀྲུས་ཏེ་བསྐ་བའི་བྱ་བ་མི་བྱེད་དོ།",
    "ལག་པས་ཇི་ཙམ་ཆོག་གི་བར་དུཀ་དྲི་ལ་ནས་ཁྲུས་བྱའོ།",
    "བསྐ་བ་འཆང་བའི་དགེ་སློང་གིས་བསྐ་བ་སྦྱད་པའི་ལྷག་མ་དགེ་སློང་སུ་སློང་བདེ་ལ་སྦྱིན་བར་བྱའོ།",
    "འཕགས་པ་ཁྱོད་ཉིད་ཀྱི་སྟོན་པ་ཐམས་ཅད་མཁྱེན་པ་ཡིན་གྱིས་ཞེས་བྱ་བའི་སྐབས་དེ་བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་རྣམས་ཀྱིས་གསོལ་པ་དང་།",
    "ཇི་ཙམ་ན་བྲམ་ཟེ་དང་ཁྱིམ་བདག་དག་གིས་མཐོང་སྟེ་དེ་དག་གིས་སྨྲས་པ།",
    "གཞན་དག་གིས་སྨྲས་པ།",
    "ཁྱིམ་བདག་ཆེ་གེ་མོ་ཞིག་གིའོ།",
    "དེ་དག་གིས་སྨྲས་པ་ཤཱཀྱའི་སྲས་ཀྱི་དགེ་སྦྱོང་མགོན་མེད་བ་རྣམས་ཀྱི་ནང་དུ་རབ་ཏུ་མ་བྱུང་ན་འདི་གཉེན་རྣམས་ཀྱིས་གསོས་པར་འགྱུུར་བ་ཞིག་ཅེས་པའི་སྐབས་དེ་བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་རྣམས་ཀྱིས་གསོལ་པ་དང་།",
    "དགེ་སློང་དག་གིས་དེ་བཞི་དུ་བྱིན་པ་དང་།",
    "དེ་དག་གིས་བྱིན་ཏེ་བྱིན་མ་ཐག་ཏུ་རས་ཕྱེབ་དང་དེས་ལག་པ་ལ་རེག་པ་མཐོང་ནས་ཞེ་བ་ལོག་པས་སྐྱུགས་སོ།",
    "མོད་ལ་རས་དབྱེ་བར་མི་བྱ་སྟེ་དེ་ལྟ་མོད་ཀྱི་བཅའ་བ་དང་བཟའ་བ་གཙང་ཞིང་བསོད་པ་དག་མདུན་དུ་བཞག་ནས་གང་གི་ཚེ་དེའི་ལག་པ་བཀྲུས་པ་དེའི་ཚེ་དེ་དབྱེ་བར་བྱའོ།",
    "གང་གི་ཚེ་སོས་པར་གྱུར་པ་དེའི་ཚེ་བསླབ་པ་ཇི་ལྟར་བཅས་པ་བཞིན་ཡང་དག་པར་བླངས་ཏེ་འཇུག་པར་བྱའོ།",
    "ཚེ་དང་ལྡན་པ་པི་ལིན་དའི་བུ་གང་གི་ཚེ་རབ་ཏུ་བྱུང་བདེ་ཚུན་ཆད་རྟག་ཏུན་བ་དང་ཟུག་གཟེར་མང་པོར་གྱུར་བ་དང་།",
    "དེ་ལ་དགེ་སློང་དག་གིས་སྨྲས་པ།",
    "གནས་བརྟན་ཁྱོད་ཀྱི་སྙུན་གྱི་ཟོ་ཇི་ལྟ་དེས་སྨྲས་པ།",
    "གནས་བརྟན་ཁྱོད་སྔོན་ཅི་ཞིག་འཆང་བར་བྱེད།",
    "དགེ་སློང་དག་གིས་རྩབ་དང་།",
    "དེ་དག་གིས་ཉི་མ་ལ་བསྐམས་པ་དང་དེ་དག་མཐུ་ཆུང་བར་གྱུར་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དེ་དག་གིས་གྲིབ་མ་ལ་བསྐམས་པ་དང་འོན་ཀྱང་རུལ་བར་གྱུར་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དེ་དག་གིས་བཏིང་ནས་དོང་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བསྡུ་བར་བྱའོ་ཞེས་གསུངས་པ་དང་དེ་དག་གིས་སུས་བསྡུ་བ་མ་ཤེས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "ཁྱིམ་པ་མེད་ན་དགེ་སྦྱོང་གིས་སོ།",
    "དགེ་སློང་གིས་བསྡུས་པ་དང་འདྲེས་པར་གྱུར་ནས་འདྲེས་སོ་ཞེས་མ་ཟོས་པ་དང་།",
    "ཁོ་བོས་སྦྱིབ་གཞན་ཡང་མི་ཤེས་མོད་ཀྱི་བདག་ཅག་དུས་མ་ཡིན་པར་ལོངས་སྤྱོད་དགོས་སོ།",
    "བཞིན་བཟངས་ཟས་དང་འདྲེས་སོ་དེ་དག་གིས་ཀྱང་ལོངས་མ་སྤྱད་པ་དང་དེ་རྣམས་ལ་དགེ་སློང་གཞན་དག་གིས་སྨྲས་པ།",
    "རིམ་གྱིས་སྲང་ཞིག་ཏུ་ཕྱིན་པ་དང་དེས་སྤོས་འཚོང་ཞིག་ཕྱེ་ལ་རེ་གནས་བ་རམ་ལ་རེག་པར་བྱེད་པ་མཐོང་ནས་དེས་སྨྲས་པ།",
    "བཞིན་བཟངས་ཕྱེ་ལ་རེག་ནས་བུ་རམ་ལ་རེག་པར་མཁྱེད།",
    "དུས་མ་ཡིན་པར་ཡང་བདག་ཅག་གིས་ལོངས་སྤྱད་དགོས་སོ་དེས་སྨྲས་པ།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་ལོངས་མ་སྤྱད་པ་དང་དེ་རྣམས་ལ་དགེ་སློང་དག་གིས་སྨྲས་པ།",
    "དེ་དག་གིས་ཀྱང་ལོངས་མ་སྤྱད་དོ་།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ཁོ་བོ་ལ་ལན་ཚྭ་རྭ་གང་འཚོ་བའི་བར་དུ་བཅང་བར་བྱིན་གྱིས་བརླབས་པ་ཞིག་ཡོད་ཀྱིས་གལ་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ན་སྦྱིན་ནོ་ཞེས་སྨྲས་པ་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་ཐོས་ནས་དེས་སྨྲས་པ།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ཁོ་བོ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བཅོམ་ལྡན་འདས་བདག་གི་ཁྱིམ་དུ་ལན་མང་དུ་སྤྱན་དྲངས་ཏེ་ཞལ་ཟས་ནི་གསོལ་ན་ཡོ་བྱད་ཐམས་ཅད་ཀྱིས་མ་བསྟབས་ཀྱིས།",
    "མ་ལ་བདག་གིས་ད་བཅོམ་ལྡན་འདས་ལ་ཟླ་བ་གསུམ་དུ་ཡོ་བྱད་ཐམས་ཅད་ཀྱིས་བསྟབས་པར་བྱའོ་སྙམ་ནས་བཅོམ་ལྡན་འདས་གང་ན་བདེར་སོང་སྟེ་ཕྱིན་ནས།",
    "བཅོམ་ལྡན་འངས་གང་ན་བདེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྡད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་སྟན་ལས་ལངས་ཏེ་སོང་ངོ།",
    "དེ་ནས་ཁྱིམ་བདག་སྔེ་ཆེན་རང་གི་ཁྱིམ་དུ་སོང་སྟེ་ཆུང་མལ་སྨྲས་པ།",
    "དེས་བུ་མོ་ཞིག་ལ་རིན་བསྐུར་ནས་ཚོད་དུས་སུ་བཏང་བ་ལས།",
    "དེའི་ཉིན་མོ་རྒྱལ་པོའི་སྲས་བལྟམ་ནས།",
    "དེ་ནས་རིན་གྱིས་ཀྱང་ཚོང་དུས་སུ་ཤ་མ་རྙེད་ནས།",
    "གྲི་རྣོན་པོ་བླངས་ཏེ་ཁྱིམ་དུ་ཞུགས་ནས་བརླའི་ཤ་ལས་བཅད་དེ་བུ་མོ་ལ་བྱིན་ནས་བུ་ཤ་འདི་ཁུ་བར་བྱོས་ལ་འཕགས་པ་ཆེ་གེ་མོ་ཞེས་བྱ་བའི་དྲུང་དུ་ཁྱེར་ཅིག།",
