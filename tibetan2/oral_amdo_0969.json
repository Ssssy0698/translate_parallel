    "འཕགས་པ་དག་གིས་ཀྱང་གསོལ་བར་བརྩམས་སོ།",
    "འཕགས་པ་རྣམས་ཀྱང་གསོལ་ཏོ་ཞེས་དེ་དག་གིས་ཆེར་བཀུམ་ཞིང་འཚལ་བར་བརྩམས་ན།",
    "བདག་གི་སྡུམ་ཐབ་ཀྱིས་ཡུན་ཇི་སྲིད་ཅིག་སྡུག་བསྔལ་མནགས་འཚལ།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་ཐུགས་བརྩེ་བ་ཉེ་བར་བཟུང་སྟེ་གང་གི་ཕྱིར་འཕགས་པ་དག་ཀླུའི་ཤ་མི་གསོལ་བར་དགོངས་པའི་རྒྱུ་ཅུང་ཞིག་བཅའ་བར་གསོལ་ཞེས་ཟེར་ནས་ངས་ཙམ་པའི་ཀླུའི་ཆུང་མ་ལ་ཅང་མི་གསུང་བས་གནང་ངོ།",
    "དགེ་སློང་དག་དེ་ལྟབས་ན་དགེ་སློང་དག་གིས་ཀླུའི་ཤ་བཟའ་བར་མི་བྱའོ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ལན་མང་དུ་སྦྱན་དྲངས་ཏེ་ཞལ་ཟས་གསོལ་ནས་ལན་འགའ་ཡང་ཟླ་བ་གསུམ་དུ་ཡོ་བྱད་ཐམས་ཅད་ཀྱིས་མ་བསྟབས་ཀྱིས།",
    "དེ་ནས་རྒྱལ་པོའི་འབྱོར་པ་དང་རྒྱལ་པོའི་མཐུ་ཆེན་པོས་བཅོམ་ལྡན་འདས་གང་ན་བདེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་རབ་བཏུང་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "སྙན་ལས་ལངས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་སོང་ངོ།",
    "དགེ་སློང་གི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཅིང་།",
    "ཐོས་ནས་ཀྱང་མཉན་ཡོད་ནས་བྱུང་ནས་བཅོམ་ལྡན་འདས་གང་ན་བདེར་སོང་སྟེ་ཕྱིན་ནས།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་པུས་མོ་གཡས་པའི་ལྷ་ངས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་སོང་ངོ།",
    "འཕགས་པ་ཁྱོད་ཅིའི་ཕྱིར་སྐྱ་བོ་བསེང་བསེང་པོར་གྱུར་ཅིང་རིང་པ་དང་།",
    "འཕགས་པ་ཁྱོད་རྒྱུན་ཞེས་ཀྱི་བུས་དཔྱད་མ་བགྱིས་སམ་ལྷ་མ་བགྱིས་སོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་དགེ་སློང་འདིའི་དཔྱད་བྱས་ན་དེ་ལྟན་ལེགས།",
    "མི་གཟིགས་པའམ།",
    "གང་དག་འོག་ཏུ་སོང་བ་དེ་དག་ནི་ཡང་སོས་དང་།",
    "པད་མ་ལྟར་གས་པ་ཆེན་པོ་རྣམས་སུ་ཡང་སོང་སྟེ།",
    "གང་དག་སྟེང་དུ་སོང་བ་དེ་དག་ནི་རྒྱལ་ཆེན་བཞིའི་རིས་དང་།",
    "འོག་མིན་གྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་སོང་ནས་མི་རྟག་པ་དང་།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོ་འཇིག་རྟེན་གྱི་ཁམས་རྣམས་བྱུལ་ནས་བཅོམ་ལྡན་འདས་ཉིད་ཀྱི་རྗེས་བཞིན་རྗེས་བཞིན་དུ་འགྲོའོ།",
    "མིར་སྐྱེ་བར་ལུང་སྟོན་པར་བཞེད་ན་ནི་ཞབས་ཀྱི་བུས་མོར་ནུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ཀྱི་མཐིལ་དུ་ནུབ་བོ་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ནས་ཞུས་པ།",
    "ཁ་དོག་སྣ་ཚོགས་སྟོང་གིས་བཀྲ་བ་ཡི།",
    "དམ་བ་བཟང་པོ་དག་གིས་བསལ་དུ་གསོལ།",
    "དེས་དེ་བཞིན་གཤེགས་པ་མང་པོས་བཀུར་བའི་གདུང་རྒྱུང་ནས་བཟུང་སྟེ་སྦྱོང་པ་སྐྱོན་མི་མངའ་བ་ལ་བྲན་མོའི་བུ་ཞེས་སྨྲས་སོ།",
    "དགེ་སློང་གིས་གཞང་འབྲུམ་གཅོད་དམ།",
    "དེ་ནས་བློན་པོ་དག་གིས་རྒྱལ་པོ་གསལ་རྒྱལ་ལ་སྨྲས་པ།",
    "ལྷ་རྒྱུན་ཤེས་ཀྱི་བུས་ནི་བཅོམ་ལྡན་འདས་ལ་ཡང་བྲན་མོའི་བུ་ཞེས་ཚིག་ཏུ་སྨྲས་ལ།",
    "དེ་དག་གིས་དེ་སྤྱུགས་ནས་ཡུལ་གནས་བཅས་ཞེས་བྱ་བར་ཕྱིན་ནོ།",
    "ཡུལ་གནས་བཅས་ན་གནས་པའི་ལྷ་རྣམས་ཀྱིས་སྐྱེས་བུ་གཏི་མུག་གང་གི་ཕྱིར་ཁྱོད་ཁམས་གསུམ་གྱི་མགོན་པོ་ལ་དྲན་མོའི་བུའོ་ཞེས་ཚིག་ཏུ་སྨྲས་པ།",
    "ཁྱོད་འདིར་གནས་སུ་ག་ལ་རུང་ཞེས་མང་དུ་སྤྱོས་ནས་བསྐྲད་དོ།",
    "དེ་ནས་བཱ་རཱ་ཎ་སཱིར་སོང་ངོ།",
    "དེ་ནས་ཀྱང་བསྐྲད་ནས་ཡངས་པ་ཅན་དུ་སོང་ངོ།",
    "དེ་ནས་ཀྱང་བསྐྲད་ནས་ཡུལ་ཙམ་པར་སོང་ངོ།",
    "དེ་ནས་ཀྱང་བསྐྲད་ནས་རྒྱལ་པོའི་ཁབ་ཏུ་སོང་ངོ།",
    "མཚེའུ་དག་གི་འགྲམ་ཤིག་ཏུ་སོང་བ་དང་དེར་ཡང་སྐབས་མ་རྙེད་ནས་དེས་བསམ་པ་འཛམ་བུའི་གླིང་འདི་ན་རེ་ཞིག་ཝ་དག་གིས་ཀྱང་སྐབས་རྙེད་ན།",
    "བདག་གིས་སྐབས་ཤིང་དྲུང་དང་།",
    "དེལ་གང་གིས་ན་ཁྲག་དྲོན་པོ་སྐྱུགས་ནས་དུས་ལས་འདས་པ་དེ་ལྟ་བུའི་ཀུན་ནས་དཀྲིས་པ་སྐྱེས་སོ།",
    "ཁ་ནས་སྟ་རེའི་ཚིག་འབྱུང་སྟེ།",
    "དེ་ནི་ཁ་ཡི་ཉེས་པས་གང་གིས་ན།",
    "འདིར་ནི་བརྒྱན་པོས་རང་གི་ནོར་ཡལ་བ།",
    "འཕགས་ལ་གནོད་བྱེད་ལུས་དང་ངག་གིས་ལས།",
    "དེ་ནས་བདག་གིས་བགྱིས་ཏེ་བསྒྲལ་བ་ལགས་སོ།",
    "བཅག་གིས་མཚམས་ཀྱི་ནང་དུའོ།",
    "ཀུན་དགའ་བོ་མཚམས་ཀྱི་ནང་ཡང་རུང་མཚམས་ཀྱི་ཕྱི་རོལ་ཡང་རུང་སྟེ་དགེ་སློང་གིས་བཙོས་པ་ནི་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ལོངས་སྤྱད་པར་མི་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་བཙོས་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ལོངས་སྤྱད་པར་མི་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་ཡོད་པ་ད་བཅོམ་ལྡན་འདས་གང་ན་བདེར་སོང་སྟེ་ཕྱིན་ནས།",
    "དེ་ནས་ཁྱིམ་བདག་དེ་སྟན་ལས་ལངས་ཏེ་བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ།",
    "གནས་མལ་ལ་གཟིགས་པར་བཞེད་པ་དང་།",
    "ངས་རྗེས་སུ་མ་གནང་བ་གང་ཡིན་པ་ཡང་ཁྱོད་ཀྱིས་ཤེས་སོ།",
    "དགེ་སློང་གིས་མཚོས་པ་བགྱིན་ལེན་བྱོས་ལ་བཙོས་ཏེ་ལོངས་སྤྱད་པར་བྱའོ།",
    "འོ་མ་ལ་སོགས་པའི་རྫས་ཀྱི་ཁུ་བ་རྣམས་གང་གི་ཚེ་ལན་གཉིས་ལན་གསུམ་དུ་བསྐོལ་བར་གྱུར་པ་དེའི་ཚེ་བྱིན་ལེན་བྱས་ཏེ་བསྐོལ་ནས་སྤྱད་པར་བྱ་སྟེ།",
    "དེའི་མངག་གཞུག་བྱེད་པའི་བུ་མོ་ཞིག་ཡོད་པ་དེས་བསམས་པ།",
    "བདག་གི་ཇོ་བོས་ཐབས་བརྒྱ་སྟོང་དུ་མས་ལོངས་སྤྱོད་རྣམས་བསགས་ན།",
    "ཇོ་བོ་ཁྱོད་ཀྱིས་ཁྱིམ་བདག་འབྱོར་པ་མཁྱེན་ཏམ།",
    "ཆུང་མ་དང་བུ་དག་གིས་ཀྱང་ཡལ་བར་བོར་རོ་ཞེས་ཁྱོད་ཉིད་ཟེར་ན།",
    "དེ་ནས་དེས་བདག་རང་གི་རྒྱགས་ལས་ཀྱང་ཅུང་ཟད་སྦྱར།",
    "དེས་བསམས་པ་བདག་ནི་ཆུང་མ་དང་བུས་ཀྱང་ཡལ་བར་བོར་ཏེ་འདི་ལྟར་བདག་གསོན་པོར་གྱུར་པ་ནི་བུ་མོ་འདིའི་མཐུ་ཡིན་གྱིས།",
    "བུ་མོ་ཁོ་བོ་ནི་ཆུང་མ་དང་བུས་ཀྱང་ཡལ་བར་བོར་བ་ལས།",
    "ཁོ་བོ་ཅུང་ཟད་ཅིག་གསོན་པ་དེ་ཐམས་ཅད་ནི་ཁྱོད་ཀྱི་དྲིན་ཡིན་ན།",
    "ཁྱོད་མཆོག་ཅི་འདོད་པ་སྦྱིན་གྱིས་སྨྲོས་ཤིག།",
    "གལ་ཏེ་ངོ་བོ་བདག་ཁྱོད་ཀྱི་ཐུགས་སུ་འཐད་པར་གྱུར་ན་བདག་ཁྱོད་དང་ལྷན་ཅིག་འགྲོགས་པར་འཚལ་ལོ།",
    "ང་དང་ཁྱོད་ལྷན་ཅིག་འགྲོགས་པས་ཅི་བྱས་ཀཱར་ཥཱ་པ་ཎ་ལྔ་བརྒྱ་བྱིན་ལ་བྲན་ལས་དབྱུང་བར་བྱའོ།",
    "ཇོ་བོ་བདག་རྒྱངས་བཀུམ་པར་མཆིས་ཀྱང་བྲན་མོ་ཁོ་ན་ལགས་པར་བས་ཀྱིས།",
    "གལ་ཏེ་རྗེའི་སྲས་ཁྱོད་དང་ལྷན་ཅིག་འགྲོགས་ན་དེ་ལྟ་ན་དྲན་མོར་མི་འགྱུར་ལགས་སོ།",
    "བུ་མོ་གང་གི་ཚེ་རུང་ཞིང་ཟླ་མཚན་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚོ་ཁོ་བོ་ལ་སྦྲོན་ཅིག།",
    "ཡབ་ཁྱོད་ཅིའི་སླད་དུ་ཕྱག་ལ་ཞལ་གཏད་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་བཞུགས།",
    "གཅིག་གིས་ནི་རྒྱ་སྐེགས་ཀྱི་རྣ་རྒྱན་ནོ།",
    "གཅིག་གིས་ནི་ཞ་ཉེའི་རྣ་རྒྱན་ནོ།",
    "འབྱོར་དགའ་ཞེས་བྱ་བ་གང་ཡིན་པ་དེ་དག་ནུབ་པར་གྱུར་ནས་ཤིང་གི་རྣ་རྒྱན་ཅན།",
    "བུ་ཁྱོད་བུས་པ་ཡིན་གྱིས་འདི་ཉིད་དུ་འདུག་ལ་ཚོང་ཁང་གི་བྱ་བདག་བྱོས་ཤིག་ཅེས་དེ་ཉིད་དུ་འདུག་གོ།",
