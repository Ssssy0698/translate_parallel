    "ཞེས་མཛོད་ཀྱི་གནམ་དཔནས་སྟོན་པར་འགྱུར་རོ།",
    "ཅིའི་ཕྱིར་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་བར་འདི་གཟུགསཀྱི་ཕུང་པོ་ཞེས་བྱ་ཞེནས་གཟུགས་སུ་རུང་བའི་ཕྱིར་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་དག་གཟུགས་སུ་ཡོད་ཅིང་གཟུགས་སུ་རུང་བས་དེ་ཕྱིར་གཟུགས་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཞེས་བྱའོ།",
    "ཚོར་བ་འདུ་ཤེས་འདུ་བྱེད་དེ་གསུམ་རྣམ་པར་རིག་བྱེད་མིན་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་དྲུག་དང་ཡིད་ཀྱི་ཁམས་སོ།",
    "ཡིད་ཀྱི་ཁམས་དེ་གང་ཞེ་ན་རྣམ་པར་ཤེས་པ་དྲུག་པོ་གང་དང་གང་འདས་མ་ཐག་པ་ཡི།",
    "དེ་ལྟ་ན་རྫས་སུ་བཅུ་བདུན་ནམ་བཅུ་གཉིས་སུ་འགྱུར་ན་ཅིའི་ཕྱིར་ཁམས་བཅོ་བརྒྱད་རྣམ་པར་གཞག་ཅེ་ན་དེ་ལྟའང་ཡིནཡོད་ཀྱི་དྲུག་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རྟེན་ནི་རབ་ཏུ་བསྐྲུན་པའིཕྱིར་རྟེན་དང་བརྟེན་པ་དང་དོགས་པ་དུ་ཀཚན་སྙམ་པར་བཞག་པས་ཁམས་བཅོ་བརྒྱད་དག་ཏུ་འདོད་དོ།",
    "ཡིད་ཀྱི་སྐྱེ་མཆེད་ཀྱིས་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་ཡིད་ཀྱི་སྐྱེ་མཆེད་དེ་ཉིད་དང་རྣམ་པ་ང་དྲན་པའི་ཁམས་བ་ན་བསྡུས་སོ།",
    "གང་ཡད་ཡུང་པོའི་གོ་རིམས་ཀྱི་རྒྱུ་སྟོན་པར་འགྱུར་བའི་གོ་རིམ།",
    "༥༩༥ འོ་ན་ཅིའི་ཕྱིར་སྐྱེ་མཆེད་དང་ཁམས་དག་ཏུ་འདུས་མ་བྱས་བཤདལ་ཕུང་པོ་དག་ནི་མ་ཡིན་ཞེ་ན།",
    "དེ་དག་ལ་རྣམ་པར་ཤེས་པ་གནས་སོ།",
    "གང་རྣམས་ཐུབ་པས་གསུངས་པ་དེ་དག་ཀྱང་།",
    "དེ་བཞིན་དུ་གཞན་ཡང་ཅི་རིགས་པར།",
    "རྣམ་པར་ཤེས་པ་ཐམས་ཅད་རྣམ་པར་ཤེས་པའི་ཁམས་ཡིན་པར་མི།",
    "ལྕེ་ཡི་རྣམ་པར་ཤེས་པའི་ཁམས་རྣམས་མགཏོགོས་བའོ།",
    "གཟུགས་མེད་པར་གཏོགས་པ་ཡིད་ད་ནི།",
    "ཨོ་དང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་རྣམས་སོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ལྔ་སྟེ་ཁ་ཕྱི་རོལ་དུ་བལྟས་པའ་།",
    "དེལ་ཡིད་ཀྱི་ཁམས་དང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་དང་རྟོགས་པ་དང་དཔྱོད་པ་པག་ལས་གཞན་པས་ལ་ཁམས་མཆན་འགྲེལ།",
    "མཚུངས་པར་ལྡན་པ་ཤ་དང་འདོད་བའི་ཁམས་དང་།",
    "ས་པ་ཏན་ཁྱད་པར་ཚན་ནི་རྟོག་པམེད་ཅིང་དཔྱོད་པ་ཙམ་དག་ཡིན་ནོ།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་གྱི་དཔྱོདཔའི་རྟོག་པ་ཡང་མེད་ལ་དཔྱོད་པ་ཡང་མེད་བ་དག་ཡིན་ནོ།",
    "ཤོ་བ་དང་བཅས་དཔྱོད་བ་དད་བཅས་པ་དག་ནི་རྟོགས་པ་དང་དཔྱོད་པ་མ་གཏོགས་བ་མཚུངས་པར་ལྡན་པ་རྣམས་ས་ རྟོག་པ་མེད་ཅིང་དཔྱོད་པ་ཙམ་དག་ནི་རྟོག་པའོ།",
    "རྟོག་བ་ཡང་མེད་དཔྱོད་བ་ཡང་མེད་པ་དག་ནི་མཚུངས་པར་ལྡན་པ་མ་ཡིན་པ་རྣམས་སོ།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དེ་ལྟར་ཡིན་ན་ཇི་ལྟར་ན་རྟོག་བ་མེད་བ་ཞེས་བྱ་ཞེ་ན་དེ་དག་ལ་ངོ་བོ་ཉིད་ཀྱི་རྟོགས་བ་ལས་ངེད་པར་རྟོག་པ་དང་རྗེས་དྲ་པའི།",
    "རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པའི་ཁམས་རྣམས་ནི་དུ།",
    "རྣམ་པརསྨིན་པའི་རྒྱུས་བསྐྱེད་བ་རྣམས་ནི།",
    "རྣམ་པརསྨིནབ་ལས་སྐྱེས་པ་སྟེ།",
    "དེ་ཡང་སྡུག་བསྔལ་ལས་ཤེས་བའི་བརྗོད་པ་དང་མཚུངས་པར་ལྡན་པའི་སེམས་ནི་ཡིད་ཀྱི་ཁམས་དང་ཡིད་ཀྱི་རྣམ་བར་ཤེས་པའི་བརྒྱད་ཡིན་ནོ།",
    "འདོད་པའི་ཁམས་ཅི་ལུས་དང་མིག་དང་གཟུགས་དང་རྣམ་པར་ཤེས་པ་དེ་རྣམསས་གཅིག་བ་ཁོ་ན་ཞིག་ཡིན་ནམ་འོན་ཏེ་གཞན་གྱིས་བགང་ཡིན་ཞེ་ནརྣཔོ་ཆེའི་སྒྲ་དང་ནས་ཀྱི་མྱུ་གུ་བཞིནནོ།",
    "རྣམ་པར་ཤེས་པའང་དེ་ཡི་སྒྲ།",
    "ཞེས་རྒྱས་པར་གྱུར་རོ།",
    "ཡིད་ནི་ཚིག་ཏུ་མ་ངེས་ཏེ་རྒྱས་པར་ནི་གནས་བརྒྱད་བར་འཆད་དོ།",
    "རྣམ་པར་བྱང་བའི་ཚོགས་སོག་བར་བྱེད་པ་དང་ཀུན་ཤེས་གསུམ་གྱིས་རྣམ་པར་བྱུང་བ་རྣམས་ཇི་སྙེད་པ།",
    "སྲོག་ནི་རྣམསྨིན་ནོ་བཅུ་གཉིས་ནི་རྣམ་པར་སྨིན་པ་ཡིན་པ་དང་མ་ཡིན་པ་རྣམ་པ་གཉིས་ཤོ།",
    "ཁྱུག་པ་རྣམས་ནི་རྣམ་པར་སྨིན་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པ་ཡིན་ན་ཡང་ཉེས་བ་མེད་དོ།",
    "ལུང་དུ་མ་བསྟན་པ་ནི་རྣམ་པར་སྨིན་པ་མེད་པ་ནོ།",
    "ཟག་པ་མེད་པ་རྣམསནིརྣམ་པར་སྨིན་བ་མེད་པ་དག་ཡིན་ནོ།",
    "སེམས་རྣམ་པར་གཡེང་བ་དང་།",
    "ས་མར་བོ་བ་ཁོ་ནའི་ཤེས་རབ་ཀྱི་ཁྱད་པར་འགའ་ཞིགཔ་ལྟ་བ་ཞེས་བྱའོ།",
    "ང་སྤྲུལ་ནི་བ་རོལ་པོ་ལས་གད་ཡང་རུང་བའི་ཁྱད་པར་ཞིག་ཡོངས་སུ་བརྟགས་ནས་སེམས་ཁེངས་པ་དང་སྒྲུབས་པའི།་",
    "ཅེས་པ་ཡིན་པསསེམས་ཤར་ཡིན་པ་དེ་ནི་ཡིད་ཡིན་ལ་དེ་ཉིད་རྣམ་པར་ཤེས་པའང་ཡིན་ནོ།",
    "མཉམ་པར་ལྡན་པས་ན་མཚུངས་པར་ལྡན་པའང་དོན་གཅིག་སྟེ་རྣམ་གྲྭསསེ།",
    "འདུ་ཤེས་མེད་པ་པ་དང་དེའི་སྙོམས་པར་འཇུག་པ་དང་འགོག་པའི་སྙོམ་ལ་བཅུག་དང་།",
    "ཐོབ་པ་ནི་མཐོབ་པ་དང་རྣམ་པར་ཉམས་པ་ལས་རྙེད་པ་དད་ཐེབ་ནས་ལྡན་པའོ།",
    "བྱེ་སྤུ་དུས་གསུམ་རྫས་སུ་གྲུབ་པར་འདོད་པའིལུགས།",
