    "གསང་བདག་ལས་རི་བེང་འཛིན་པ་མྱང་བ་དང་ནི་བལྟ་བ་དག་གིས་གསང་བའི་དབད་དུ་འགྱུར།",
    "ཕྱི་ནས་རདགི་ཕྱག་རྒྱ་སྦྱིན་བྱ་དེ་ནས་སླར་ཡང་གཞན་པ་ནུབའི་ལམ་སོགས་ལྡན་པའོ།",
    "ཁྲོ་ཁེངས་ནོར་ལ་སྲེད་དང་མི་བདེན་རྫོ་དཔ་ལ་དགའ་རངགི་ཡན་ལག་སྙན་དང་རྣམ་དག་མིན།",
    "གང་གི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་མ་གི་པུ་རྣམ་པ་བནུར་འགྱུར་ཏེ་ལོ་སོ་སོར་སྦྱིན་པ་ལ་སོགས་པ་རྣམ་པར་དག་པས་སོ།",
    "ཤིནཏུ་སྟོབས་མདང་རྨུགས་བྱེད་མ་དང་ཁེངས་བྱེད་མདང་རེངས་བྱེད་མ་དང་།",
    "རྩད་གུནས་བརྒྱདནི་ལྷ་མིན་གྱི་ཆ་སྟེ་ཁྱི་གདོང་མ་དང་ཕག་གདོང་མ་དང་སྟག་གེདོང་མ་དང་སྤྱང་གདེངོ་མ་དང་མཁའ་ལྡིང་ག་དོང་མ་དང་འུག་གདོང་མ་དད་བྱ་རྒོད་གདོང་མ་དང་བྱ་རེག་གདོང་མ་སྟེ།",
    "དེ་བཞིན་ཞང་པོའི་བུད་མེད་དང་།",
    "རང་གི་མ་ཡི་སྤུན་བླུ་ཉིད།",
    "ཀོ་ལྔགས་བྱེད་མ་གཏུམ་མོ་ནི།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐམས་ཅད་ཐོབ་པ་བདག་གིས་དན་ཅི་ཞིག་བགྱི།",
    "བཅུའི་ནང་ནས་རང་གི་ཆུང་མ་འདི་བཟུང་ནས།",
    "དགེ་སློང་དང་དགེ་ཚུལ་རྣམས་ལ་ནིགཏུམ་མོ་རང་གི་ཆུད་མར་བྱའོ།",
    "དུས་ཀྱི་འཁོར་ལོ་ཁྱོདལ་འདུད།",
    "ཡེ་ཤེས་སྐུ་ཁྱོད་ལ་འདུད་དོ།",
    "བདག་ནི་དུས་ཀུན་ཁྱོད་ཀྱིས་འབང་ས།",
    "ལྷོར་གོས་དཀར་མོ།",
    "དུམ་པ་བརྒྱད་རྣམས་དང་རྒྱལ་བདང་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་དག་གིསདགེ་སློང་ལ་ཁྲུས་བྱའོ།",
    "དགེ་ཚུལ་ལ་དེ་རྣམས་ཀྱི་ནང་ནས་ཕྱག་རྒྱ་དྲུག་གིས་བུམ་པ་བཞི་རྒྱལ་བའི་བུམ་པ་དག་གིས་ཁྲུས་བྱའོ།",
    "ཁྱིམ་ན་གནས་པ་ལ་ངགུ་བ་དེ་རྣམས་ཀྱི་ནང་ནས་རང་གི་ཆུང་མ་གཅིག་པུ་ཡིས་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་གཅིག་པུས་སྔར་གསུངས་པའི་ཚེགས་དབད་བསྐུར་བརབྱའོ།",
    "ཕྱི་ནས་རང་གི་ཕྱག་རྒྱ་སྦྱིན་བྱན་སློབ་དབོན་གྱིས་གར་ལ་འཁྱུད་པའོ།",
    "ཀུན་རྫོབ་ཏུ་ཁྱད་པར་དག་འབའི་མཐར་ལྷན་ཅིག་སྐྱེས་བའི་སྐད་ཅིག་བདག་གིས་བརྗོད་པ་གང་ཡིན་པའདི་དང་ཐིག་ལེ་གསུམ་གྱི་མཐར་གང་ཡིན་པ་དེ་ནི་དོན་ད་མ་པརམི་འགྱུར་ཏེ།",
    "དེས་ན་བདེ་བ་ཆེན་པོ་འདི་ནི་ཁྱོད་ཀྱིས་བསྲུང་བར་བྱའོ།",
    "འདོད་པ་སྐྱེད་པར་ཀ་བྱེད་པ་འགྲོ་བའི་རང་གིས་ཡིད་ལའོ་གང་བ་དག་ནི་གང་བ་ཉིད་དུ་འགྱུར།",
    "བལྟ་དང་རེག་དང་འགྲོག་ལ་འཛག་པའི་བདེ་བ་འདི་དག་དགའ་བའི་དབྱེ་བ་ལ་སོགས་དག་གིས་སོ།",
    "གང་བ་དང་ནི་ནུས་དང་སྐྱེ་བ་དག་དང་མཆོག་གི་དགའ་བདེལྟར་གཞི།",
    "བསམ་གཏན་བཞི་པའི་རྩེ་མོའཆ་ང་།",
    "དགའ་བ་ཞེས་པ་གསུང་གི་དགའ་བའོ།",
    "འགྱུར་མེད་ཅེས་པའི་མིང་གིས་ཡེ་ཤེས་ཀྱི་དགའ་བའོ།",
    "ཁྱད་པར་དགའ་བཞེས་པ་གསུང་གི་ཁྱད་པར་དགའ་བའོ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་ཞེས་པ་གསུང་གི་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའོ།",
    "དེ་ལྟར་དགའ་བ་བནུ་དྲུག་གི་དབྱེ་བ་། རྣམ་ས་རྒྱ་ཆེ་ར་དཔལ་ལྡན་རྒྱུད་དུ་བལྟ་བར་བྱའོ།",
    "དགའ་བ་བཅུ་དྲུག་གི་མཐའ་ལྷན་ཅིག་སྐྱེས་པའོ་ཞེས་པ་ངེས་པའོ།",
    "ཤེས་རབ་ཆེན་པོ་ཞེས་པ་རྣམ་པར་རྟོགས་པ་ཀུན་ཏུ་མ་བརྟགས་པ་འཆད་པརའགྱུར་བའི་ཕྱག་རྒྱ་ཆེ་ན་མོའོ།",
    "ལྔ་པ་རང་གི་བདག་པོ་ཉིད།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ཞེས་པ་ནམ་མཁའ་ལས་བྱུང་བའི་གཟུགས་ཏེ་དེའི་རྗེས་ཆགས་ཕྱི་རོལ་རང་གི་ཉམས་སུ་སྒོམས་པ་ཞེས་བྱ་བ་ལས་སྐྱེས་པ་གཡོ་མེད་ཅེས་པ་རྡོ་རྗེ་ནོར་བུ་ལས་ཕྱི་། རོལ་དུ་གཡོ་བ་ལས་འཇག་པ་འགོག་སུ་པ།",
    "སྐུའི་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་དང་གསུང་གི་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་དང་ཐུགས་ཀྱི་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་དང་ཡེ་ཤེ་ས་ཀྱི་ལྷན་ཅིག་སྐྱེས་པའི་མཱ།",
    "ཐུན་མོང་པ་ཞེས་གྲགས་པ་སྟེ།",
    "ཐུན་མོངས་མཆོག་གི་དབྱེ་བ་ཡིས།",
    "ཐུན་མོངས་སྒྲུབ་ལ་བསྙེན་པ་སྟེ།",
    "ཡན་ལག་དྲུག་གི་རྣལ་འབྱོར་གྱིས།",
    "སྣ་ཡི་རྩ་མོར་བརྟག་པར་བྱ།",
    "སྲོག་གི་རྩོལ་བ་ཞེས་པར་དྲན།",
    "དུ་བ་ལ་སོགས་པ་གཟུགས་མཐར་ཐུག་པ་སོ་སོར་སྡུད་པའི་ཡནལག་དང་བསམ་གཏན་གྱི་ཡན་ལག་གོ་། དེ་དག་ནི་མཆོག་གི་བརྟེན་པ་སྟེ།",
    "ཡེ་ཤེས་བདུད་རྩི་ཁོན་ཡིས་ཡན་ལག་དྲུག་གི་རྣལ་འབྱོར་ཁོ་ནས་རྡོ་གས་པར་བྱའོ།",
    "དེ་རྣམས་ནི་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་ཞེས་བྱ་སྟེ་ཡན་ལག་དྲུག་གི་རྣལ་འབྱོར་རོ།",
    "སྣའི་རྩེ་མོར་ཞེས་པ་སྣའི་སྒྲས་ལྟེ་བ་དང་།",
    "དེ་ཞེས་པ་གཏུམ་མོ་སྟེ་སྤྲོ་བར་བྱ་བ་ཞི་ལྟེ་བའི་འཁོར་ལོ་ལས་པསླར་བར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཞེས་པའི་ཏིང་ངེ་འཛིན་གྱིས་ཡན་ལག་གི་མིར་ཅ་ན་ནོ་ཞེས་པའོ།",
    "ཡན་ལག་དྲུག་གི་རྣལ་འབྱོར་ནི་དུས་ཀྱི་འཁོར་ལོའི་རྒྱུན་ཕྱི་མར་འཇ་མ་དཔལ་ཞབས་ཀྱིས་གསལ་བར་གསུངས་པ་ཇི་ལྟ་བ་བཞིན་ཏེ།",
    "རྗེས་སུ་དྲན་པས་མཁའ་ལ་རི་བོང་ཅན་བཞིན་རང་གི་གཟུགས་ལས་འོད་ཟེར་ཆེན་པོ་ངེས་བར་རྒྱུ།",
    "སོ་སོར་སྡུད་བསྙོམས་འཇུག་པ་ཞེས་དུ་བ་ལསོགས་པའི་མཚན་མ་བཅུའི་རིམ་པས་ཁམས་གསུམ་བའི་གཟུགས་མཐོང་བའི་སོ་སོར་སྡུད་པའི་ཡན་ལག་གིས་བརྟན་པར་བྱས་པ་སྟེ།",
    "གང་གི་ཚེ་རྣལ་འབྱོར་པ་ཡང་གཟུག་༩ ༡༣ མཐོངཕ་སོ་སོར་སྡུད་པའི་ཡན་ལག་གིས་བརྟན་བར་བྱས་པར་གྱུར་པ་དེའི་ཚེ།",
    "སྔགས་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབས་ཏེ་ཚིག་གི་མཆོག་སྦྱིན་ལ་སོགས་པ་བྱིན་པར་འགྱུར་རོ།",
    "བསམ་གཏན་ཡེ་ཤེས་སྙོམས་འཇུག་པས་ཤེས་པ་གང་གི་ཚེ་བསམ་གཏན་གྱི་ཡན་ལག་གིས་གཟུགས་ལ་སེམས་བརྟན་པ་མིག་མི་འཛུམས་པར་གྱུར་པ་དེའི་ཚེ།",
    "བྱད་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་གཟིགས་ཏེ་བསྔགས་པར་ཡང་འགྱུར་རོ།",
    "འཛིན་པའི་སྟོབས་ཀྱིས་ཤེས་པ་ངེས་པར་སྟེང་པ་ཉིད་ཀྱི་གཟུགས་གཟུང་བ་དང་རྡོརྗེ་སེམས་དཔའ་འཛིན་པའི་སེམས་མཉམ་པར་ཞུགས་ཏེ་འཛིན་པའི་སྟོབས་ཀྱིས་སྲོག་གིས་འགྲོ་བ་དང་འོང་བའི་སྐད་ཅིག་གཅིག་ཏུ་འདྲེས་པར་འགྱུར་རོ།",
    "རེ་རེ་དབྱེ་བར་ལྡརྣམས་ཀྱིས་ཏེ་སླར་ཡང་གང་ལས་ཨ་སོགས་ཀ་སོགས་རྣམས་ཀྱིས་ཕྱེ་བའོ་ཞེས་སོ།",
    "རླུ་རྣམས་མི་འབབ་པ་གང་གི་ཕྱིར་ཞེས་པའི་དོན་ཏོ།",
    "གཏུམ་མོའི་སྣང་བར་གང་ཞིག་གྱུར་པ་ངེས་པར་ལུས་དང་ནམ་མཁའ་ལ་ཡང་རྗེས་སུ་དྲན་པར་འགྱུར།",
    "གཏུམ་མོའི་སྣང་བར་གང་ཞིག་སྲིད་པ་གསུམ་གྱི་རྣམ་མཁའ་ལས་གྱུར་བ་ནི་རྗེས་སུ་དྲན་པ་སྟེ་རྣམ་པ་བཅུང་སྔར་གསུངས་སོ།",
    "དེ་ལྟར་ཡན་ལག་དྲུག་གི་རྣལ་འབྱོར་སྒྲུབ་ཐབས་སོ།",
    "མི་ག་ཡོ་བའི་བགྲོད་པ་ནི་མཆོག་གི་གནས་སྐབས་སོ།",
    "ཀྱང་ཡིག་གིས་སྲོག་སྩོལ་དང་འཛིན་པ་བྱ་སྟེ་སྲེག་གི་གཟུགས་མཐོང་བར་གྱུར་པ་ན་ཞེ་བར་སྒྲུབ་པའོ།",
    "རང་གི་སེམས་འདིའི་སྣང་བ་ལ་རབ་ཏུ་གཞུག་པ་གསུངས་པ།",
    "ཞེས་པ་མཚན་མོའི་རྣལ་འབྱོར་གྱིས་མཐོང་ངོ།",
    "ག་ཟི་བརྗིད་ཆེན་པོ་འོང་གསལ་བ་ནི་གློག་སྟེ་མཆོག་གི་ཆའོ།",
    "མཚནཨང་དག་པར་བརྗོད་པ་ལ་སོགས་པར་ཞིན་མོའི་རྣལ་འབྱོར་གྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་དགོངས་པའི་སྐད་གཞན་གྱིས་གསུངས་སོ།",
    "ནམ་མཁའ་ཆུ་འཛིན་བྲལ་བ་དག་ནི་རྣལ་འབྱོར་བ་ཡིས་བགྲང་བའི་མིག་གིས་བལྟ་བརབྱ་བ་སྟེ།",
    "རེ་ཞྭ་ནག་པོ་དྲི་མེད་འོད་ཟོར་འཕྲོ་བ་དུས་ཀྱི་རུ་ལ་མཐོང་བར་གྱུར་གྱི་བར་དུའོ།",
    "མཁའ་ཆུ་འཛིན་བྲལ་བ་དག་ནི་རྣལ་འབྱོར་པ་ཡིས་བགྲད་པའི་མིག་གིས་བལྟ་བར་བྱ་བ་སྟེ།",
    "ཞིམ་སོ་སོར་བལྟ་བར་བྱ་སྟེ་ཐིག་ལེའི་དབུས་སུརེ་ཁཱ་ཞག་པོ་སྐྲའི་ཚད་ཙམ་དྲི་མེད་འོད་ཟེར་འཕྲོ་བ་དུས་ཀྱི་རྩ་ཨ་བ་དྷུ་ཏྲི་ལ་མ་ཐོང་བར་གྱུར་གྱི་བར་དུའོ།",
    "འདིར་དེ་བཞིན་གཤེགས་པའི་ཤའི་སྤྱན་གྱིས་དང་པོར་རང་གི་སེམས་ཀྱི་སྣང་བ་མཐོང་ཞིང་།",
    "དེའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པས་མ་གཟིགས་བཅུད་ཟད་ཀྱད་མེད་དོ།",
    "ཨ་བ་དྷཱ་ཏཱིར་དགང་བ་ནི་བུམ་བཙན་དང་དབྱུང་བའི་སྦྱོརབས་ཨོ་ཡིག་གིས་འཇུག་པ་དང་།",
    "བྲལ་བའི་སེམས་ནི་དེ་བཞིན་ག་ཤེགས་པ་རྣམས་ཀྱི་ཏིད་རེ་འཛིན་གྱི་ཡན་ལག་ཏུ་བརྗོད་དོ།",
    "འདིར་རྟགས་ནི་དུ་བ་ལསོགས་པའི་མཚན་མ་སྟེ་གཞན་སྔགས་ལ་སོགས་པ་ཞི་མ་གཅིག་གིས་བསྒྲུབ་པར་བྱ་བམ་ཡིན་ན་གང་གིས་སྔགས་པ་རྣམས་ལ་རྟགས་འབྱུར་བར་འགྱུར།",
    "དེའི་ཕྱིར་ཡན་ལག་དྲུག་གི་རྣལ་འབྱོར་ལས་དུ་བ་ལ་སོགས་པའི་མཚན་མར་འགྱུར་རོ།",
    "གཟི་བརྗིད་ཆེན་པོ་འོད་གསལ་བཞེས་པ་གློག་གི་རབ་ཏུ་སྣངབའོ།",
    "དེ་ནས་སྲོག་གི་རྩོལ་བ་བཅིང་བ་སྟེ་བྱེད་པ་བཅིང་བའི་སྦྱོར་བ་འདི་ཡིས་ས་གསུམ་པོ་འདོད་པ་དང་།",
    "སྣའི་རྩེ་མོར་རྣམ་བསྒོམ་བྱ།",
    "ཤེསརབ་འགྲོག་ས་ལ་འགྲོ་མེད་འགྱུར་བ་ཕྲ་མོའི་རྣལ་འབྱོལ་དག་ལས་ངེས་པར་སྒྲུབ་པ་ཆེན་པོའོ།",
    "དོ་ནས་རབ་མཆོག་རེ་ཡི་རིགས་རྣམས་དག་གིས་ཤེས་པ་ཕུང་པོ་དྲུག་པོ་རྣམས་ཀྱིས་མིག་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡི་གེ་དགོད་པ་སྟེ།",
    "སླར་ཡང་སོ་སྐྱེས་ནས་ལོ་བཅུ་དྲུག་གི་སྟེང་དུ་དར་ལ།",
    "སྟེ་བུ་དང་བུ་མོ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "འདིར་གང་གི་ཚེ་སོ་སོར་སྡུད་པ་གཟུགས་བརྟན་པར་གྱུར་པས་རྣལ་འབྱོད་པ་རྣམ་པར་དག་པར་གྱུར་པ་དེའི་ཚེ།",
    "སྔགས་རྣམས་ཀུན་གྱིས་བྱིན་གྱིས་རློབ་པར་འགྱུར་ཏེ་ཚིག་གིས་མཆོག་སྦྱིན་ལ་སོགས་པ་སྦྱིན་པར་འགྱུར་རོ།",
    "ཞེས་པ་འདིར་གང་གི་ཚེ་མིག་མི་འཛུམ་པར་གྱུར་པ་དེའི་ཚེ་ལྷའི་མིག་ཏུ་འགྱུརརེ།",
    "སྲོག་གི་སྩོལ་བས་དག་པཞེས་པ་འདིར་གང་ཞིག་གི་ཚེ་རྣལ་འབྱོར་པ་ཞིམ་རི་བོང་ཅན་གྱི་ལམ་དང་བྲལ་ཏེ་རྟག་ཏུ་དབུམ་འབབ་པར་གྱུར་པ་དེའི་ཚེ་སྲོག་གི་རྩོལ་བས་དག་པར་གྱུར་པ་ན།",
    "དེ་ཡིས་གང་གིས་ཚེ་དག་པརགྱུར་པ་དེའི་ཚེ་དྲི་མེད་འོད་ཀྱི་དཀྱིལ་འཁོར་དུ་འགྱུར་རོ།",
    "ཇི་སྲིད་གཙུག་ཏོར་བྱུག་པར་བཙན་ཐབས་ཉིད་ཀྱིས་ཕྱི་རོལགྱི་ནི་པགས་པ་དག་ལ་ཁབ་བཞིན་རེ་ག།",
    "དེ་ཡི་དུས་སུ་བུར་དུ་སེ་ལབ་མཆོག་གི་བཙ་ན་ཐབས་ཉིད་ཀྱིས་སྟེང་གི་ལམ་དུ་བསྐུལ་བར་བྱ།",
    "རྒོད་པ་དང་བལྟ་བ་དང་རེག་པ་དང་འཁྱུད་པ་དད་ལག་བརྩངས་དང་འཁྲིག་པ་དང་།",
    "ཕྱག་རྒྱ་རབཏུ་འགྲོགས་ལ་སེམས་དང་མཆོག་གི་བདེ་བ་ལ་གནས་རྡོ་རྗེ་ཡང་དག་བསླང་བ་ཡར།",
    "པདྨར་རྡོ་རྗེའི་སྒྲ་འམ་རང་གི་ལག་པའི་ཆུ་སྐྱེས་དགགིས་གསོར་བ་བདེ་བའི་སླད་དུ་སྟེ།",
    "མཆོག་གི་བདེ་བ་ལ་གནས་རྡོརྗེ་ཡད་དག་བསླང་བ་ཡང་གསུམ་པ་ཐུགས་རྡོ་རྗེའོ།",
    "ཅི་སྟེ་བུད་མེད་མ་རྙེད་ན་དེའི་ཚེ་རང་གི་ལག་པའི་བརྙས་གསོར་བར་བྱའོ།",
    "རྣམ་པ་ཐམསཅད་པ་རུ་འགྱུར་ཏེ་མི་ཟད་མཆོག་གིས་བདེབ་གཞོམ་དུ་མེད་པའི་ཡེ་ཤེས་སྐུ།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པའི་བུད་ཤིང་མ་ལུས་པ་སྲེག་པར་བྱེད་བ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་མེ་འདི་ཉིད་ཀྱི་སྒྲུབ་བ་སྟེ་ཚལ་བའི་དངོས་པོ་རྣལ་འབྱོར་པས་དུ་བ་ལ་སོགས་པ་རྣམས་ཀྱིས་བྱའོ།",
    "གཟུང་བ་དང་འཛིན་པ་དང་བྲལ་བ་རང་བཞིན་སྟོང་བ་ཉིད་ཀྱི་བློ་ནི་ཤེས་རབ་སྟེ་དེའི་གཟུགས་བརྙན་ཞིརྣལ་འབྱོར་པ་ལ་མངོན་སུམ་དུ་སྣང་བའོ་ ཕྱི་ནར་གི་དྲི་མ་རྗེས་སུ་ཆགས་པ་མེད་པའི་ཕྱིརནམ་མཁའ་མཉམ་བརྣམས་ཀྱིས་སོ།",
    "རྣལ་འབྱོར་པས་རང་རིག་བ་ཉིད་ཀྱི་ཕྱིར་རང་གི་སེམས་ཀྱི་རྐྱེན་གྱིས་དོན་ནོ།",
    "མཚན་མ་བཞིཔོ་འདི་རྣམས་ནི་བུག་པ་མེད་པའི་ཁང་པར་མུན་པ་ལས་འབྱུད་བའི་ཕྱིར་མཚན་མོའི་རྣལ་འབྱོར་དང་ནམ་མཁའི་རྣལ་འབྱོར་རོ།",
    "མུནཅཞ་ནི་སྒྲ་གཅན་ཏེ་རི་མོ་ནག་པོ་ལྟར་སྣད་བའོ།",
    "ཆ་དངཞེས་པ་གློག་གི་སྣང་བའོ།",
    "བཀབ་དང་མ་བཀབ་མིག་དག་གིས།",
    "རྣམ་པ་ཐམསཅད་གཟིགས་པཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཟབ་མོ་དམིགས་མེད་དེ་རྣམས་ཀྱིས།",
    "མིག་དག་རེངས་པར་བྱེད་པ་དང་།",
    "དེ་བཞིན་དུ་སྐྱ་རེངས་ཤར་རོ་བྷུ་སུ་ཀཱུ།",
    "ཀ་ཧྞས་སྨྲས་པ་བར་ལམ་མོ།",
    "གལ་ཏེ་ནམ་མཁའ་རྩེ་མོར་མ་རྟོག་བྱུང་།",
    "ཕྱག་རྒྱ་ཆེན་པོ་སྒམ་པ་ཡང་རྟོགས་པས་སྒྲ་བརྟགས་པའི་མཚན་མ་མཐའ་དག་གིས་མཚོན་དུ་མེད་པ་མ་ཡིན་ནམ།",
    "སྐར་མའི་ཆོགས་བམལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཤལ་སོགས་པའི་མིག་གིས་གཟུད་བར་བྱ་བ་སྲིད་པ་གསུམ་དད་དུས་གསུམ་སྒྱུ་མ་དང་རྨི་ལམ་དང་མཚུངས་པའོ།",
    "བཅོམ་ལྡན་སྲོག་གི་ལྷག་པའི་བདག་པོརྗེ་བོ་བདག་ཉིད་ལ་ནི་ཐིམ་འགྱུར་ཞིང་།",
    "ལག་པས་འཐོག་རེག་བྱར་མེདས་བ་རི།",
    "གྱུར་པ་དེ་ཚི་ལྷ་མོ་ཕྱག་འཆལ་བདེ་བ་དམ་པ་དཔལ་གྱི་མཐུ།",
    "གནས་འདིར་སྔོན་མ་མཐོང་བའི་རྐུན་པོ་ལ་སོགས་པ་པྲ་ཕབ་པའི་གཞོན་ནུམས་སྔགས་ཀྱི་བྱིན་གྱིས་རླབས་པའི་མིག་གིས་མཐོང་སྟེ།",
    "སྒྲུབ་པ་པོའི་སྐྱེས་བུ་ནི་གནས་དེར་སོང་ནས་གཞོན་ནུམས་སྨྲས་པ་ཐུན་མོང་པའི་མིག་དག་གིས་མཐོང་བར་འགྱུར་རོ།",
    "རྣལ་འབྱོར་པའི་དངོས་གྲུབ་འཛག་པ་མེད་པའི་བྱད་ཆུ་བ་ཀྱི་སེམས་ཟླ་བ་ཉེ་བར་བསྟན་པ་སོ་སོའི་སྐྱེ་བོས་རྟོག་པར་བྱ་བ་མ་ཡིན་པ་འཇིག་རྟེནལས་འདས་པའི་དེ་ཁོན་ཉེ་བར་བསྟན་པའི་སྔགས་ཀྱིས་བྱིན་གྱིས་རླབས་པའི་བློ་དད་མིག་གིས་གཞོན་ནུམའི་བཞིན་དུ་ནམ་མཁའ་ལ་མཐོང་བརའ་གྱུར་རོ།",
    "གཞན་གྱི་མིག་དཔྲལ་བ་ལ་སོགས་པརབསྒོམས་པ་དང་རང་གི་མིག་དག་གིས་གཞནམཐོད་བམེད་པའི་ཕྱིན་པྲ་ཕབ་པའི་དཔེ་འདི་ཡིས་རྣལ་འབྱོན་པའི་མངོན་སུམ་པ་རྣམས་ཐམས་ཅད་དུ་རང་གི་དངོས་པོ་དངོས་པོ་མད་པ་ལས་མ་སྐྱེས་པ་རྨི་ལམ་དུ་གཞོན་ནུ་མའི་དམིགས་པ་བཞིན་དུ་ཐ་མས་ཅདམཁྱེན་པའི་ཡེ་ཤེས་གྲུབ་བོ།",
    "དེ་ལས་ཉིན་ཞག་གིས་དབུགས་དྲུག་བརྒྱ་ལྷག་པའི་སྟེང་ཕྲག་ཉི་ཤུ་རྩ།",
    "དེ་ལ་ལྟེ་བའི་ཆུ་སྐྱེས་ལ་སའི་ཡོན་ཏན་ལྔ་སྟེ་དྲི་དང་གཟུགས་དང་རོ་དང་རེག་བྱ་དང་སྒྲའི་མཆན་ཉིད་རྣམས་སོ།",
    "མགྲིན་པའི་ཆུ་སྐྱེས་ལ་མེའི་ཡོན་ཏན་གསུམ་སྟེ་རོ་དངརེག་བྱ་དང་སྐྲའི་མཚན་ཉིད་རྣམས་སོ།",
    "གཙུག་གཏོར་གྱི་ཆུ་སྐྱེས་ལ་སྟོད་པའི་ཡོན་ཏན་གཅིག་སྟེ་སྒྲ་ཙམ་མོ།",
    "མེ་ནི་ཕྲ་མོའི་ཁམས་ལའོ།",
    "དེ་ལྟར་ཨ་བཛྙཱ་ཏིར་འགྲོ་བ་དང་འོད་བན་ལྟེ་བནས་ལྟེ་བའི་དབུས་སུ་ཡིན་གྱི་ཡོངས་སུ་ལྷག་པར་འགྱུར་བའི་ཕྱིར་ལ་ལ་ནཱ་དག་གི་པདྨའི་འདབ་མ་རྣམས་ལ་འགྲོ་བ་དང་འོང་བ་ནི་མ་ཡིན་ནོ།",
    "དུད་ཅནམ་འདི་ཉིད་བུད་མེད་བདེ་བ་ལས་ཏེ་ཤིན་ཏུ་དགའ་བ་ཆགས་པའི་བདེ་བ་ལས་ཁུབ་འབབ་པོ།",
    "བུད་མེད་རྣམས་ཀྱི་དུང་ཅནམ་ཉིད་རྡུལ་གྱི་དུས་སུ།",
    "དེ་ལྟར་སྣ་བུག་གཉིས་ཀ་ལ་དཀྱིལ་འཁོར་རེ་རེ་ཞིང་དབྱུ་གུ་ནས་དབྱུ་གུའི་བར་དུ་འབབ་སྟེ།",
    "གཡོན་པའི་སྣ་བུག་གི་ནི་འདབ་མའི་དབུས་དང་ཞེས་པ་ལ་སོགས་པས་འཆད་པར་འགྱུར་ཏེ་དེ་ལ་ལྟོས་ནས་སྣ་བུག་དག་ལའོ་ཞེས་གསུངས་སོ།",
    "འདི་ལྟ་རགཞན་གྱི་རིགས་ལ་འཁྱུད་པས་བྱ་བ་འགྲུབ་ཀྱི་རང་གི་རིགས་ལ་འཁྱུད་པས་མ་ཡིན་ཏེ།",
    "རང་གི་བདག་ཉིད་ལ་བྱ་བ་འགལ་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་འོད་དཔག་མེད་ཀྱི་ཤེས་རབ་གོས་དཀར་མོ་དང་རིན་ཆེ་ན་འབྱུང་ལྡན་གྱི་མཱ་མ་ཀཱིའོ།",
    "གང་གི་ཕྱིར་ལག་པ་གཡས་པའི་ཁུ་ཚུར་ལ་མཐེ་ཆུད་ཟླ་བ་ཕྱེད་པའི་རྣམ་པར་བྱས་པའི་མི་ཐབསྐྱེད་པའི་མཆེ་བའི་ཕྱག་རྒྱ་གང་ཡིན་པ་དེ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་མའི་གྲི་གུག་གི་ཕྱག་རྒྱ་ཡིན་པ་དེའི་ཕྱིར་སྟོད་པ་དང་།",
    "མཚན་མོ་གཅིག་ཅེས་པ་སྟེ།",
    "གང་གིས་ཚེ་མཚན་མོ་གཅིག་ཉིན་མཚན་དུ་འབབ་པ་དེའི་འཆི་ལྟསརྩོམ་པ་སྟེ་འཆི་ལྟས་དེ་ལས་ལོགསུམ་གྱིས་འཆི་བར་ཤེས་། པར་བྱའོ།",
    "གང་གི་ཕྱིར་འདིར་ཉི་མས་ཟླ་བའི་ཡོན་ཏན་སྒྲ་དང་རེག་བྱ་དང་རོ་དང་གཟུགས་དང་དྲི་རྣམས་གཟུང་ནས་འཆི་ལྟས་ོ་ཀྱི་ཉིན་ཞག་རྣམས་བསྟན་ཏེ།",
    "བཅུ་གཅིག་པ་ལ་གསུམམོ།",
    "གསུམ་གཉིཞིས་གཅིག་ལོ་ཞེས་པ་ལོ་རྣམས་ནི་སྔོན་གྱི་འདབ་མ་ལ་གསུམ་མོ།",
    "དེ་ནས་འདབམ་དེ་སྟོད་པར་བྱས་ཏེ་ལྷག་མའི་ཞིན་ཞག་གིས་ཚོ་གས་ལྷག་མ་བཟུང་ནས་སྲོག་གི་ནུས་པ་འདབ་མ་གཉིས་པ་ལ་རབ་ཏུ་འཇུག་སྟེ་དེ་ལ་ཉིན་ཞག་བཅུའབབ་པོ།",
    "བརྒྱད་པ་སྟོང་པར་བྱས་ནས་ལྷག་མ་ནིནཞག་གི་ཚོ་གས་ནི་ཧུ་རྩ་གཅིག་བཟུང་སྟེ་དགུ་པ་ལ་རབ་ཏུ་འཇུག་གོ།",
    "ཡང་ན་ཞན་ག་མཚནརྣམ་པར་མ་ཆད་པར་འབབ་པ་རྣམ་བརབཤག་སྟེ་འཆི་ལྟས་ཀྱི་ཉིན་ཞག་གསུམ་པོའདིས་ལོ་གསུམ་གྱི་ཉིནཞག་གསུམ་དང་ཟླ་བ་དྲུག་སོང་སྟེ་འདབ་མ་དེལ་སྲོག་གི་རླུད་ཡང་དག་པར་རྒྱུ་བ་མེད་དོ།",
    "འདིས་ཀྱང་ཟླ་བ་གསུམ་སོང་སྟེ་དེ་ལྟར་ཟླ་བ་གསུམ་གསུམ་གྱིས་ཉིན་ཞག་གསུམ་རྣམ་པར་འཕེལ་བ་ལས་འདབ་མ་བཅུ་གཅིག་པོ་འདིརྣམ་ ལོ་གསུམ་ལ་རིམ་པས་འདོད་དོ།",
    "བྱེད་དང་བཅས་པའི་ཟླ་བ་བཅུ་དང་ལྡན་པའི་ལོ་དགུ་བཅུ་རྩ་དྲུག་གིས་མཚ་མས་སུ་ཉི་མ་དང་ཟླ་བ་འབབ་པའི་དུས་སོ།",
    "སྟེང་གི་འཆི་ལྟས་སླུ་བ་བརྗོད་ནས་འོག་གི་འཆི་ལྟས་གསུངས་པ།",
    "རྡོརྗེའི་རྩེ་མོའི་མཐར་གནས་པར་འགྱུར་རོ།",
    "དེནིའདོད་ཆགས་ཉམས་པའི་ཕྱིར་ནག་པོའི་ཕྱོགས་ཏེ་རྡུལ་གྱི་གཟུགས་ཀྱིས་ཉི་མའི་ཆ་དང་པོ་རྒྱུད་༣འགྲེལ་ནོར་བུའི་རྩ་མོ་ལའོ།",
    "རྐད་པ་གཅིག་གི་མཐིལ་གནོན་པ།",
    "ཚདས་པའི་སྒོ་ངའི་རྩེ་མོ་གནོན།",
    "བདེ་ཆེན་ལས་ཤེས་པ་བདེ་བཆེན་པོའི་མིང་ཅན་དག་པའི་སྐུ་ལས་ཏེ་ཕྱིན་ཅི་ལོག་གིས་སྐུའི་ཐིག་ལེ་གང་ཡིན་པ་དེ་བཞི་པའི་གནས་སྐབས་ཟད་པའི་སྐུ་སྟེ།",
    "ལས་ནི་ནུམ་པ་ན་དང་འཁྱུད་པ་དང་གསང་བར་རག་པ་དང་རྡོ་རྗེ་སྐྱོད་པ་ལ་སོགས་པ་བྱ་བའི་བདག་ཉིད་ཅན་ཏེ་དེ་ཡིས་ཉེ་བར་མཚོན་པའི་ཕྱག་རྒྱནི་ཡིད་ཆེས་པར་བྱེད་པ་མོ་ཡིན་ལ་ཡིད་ཆེས་པ་ནི་འདིར་འགྱུར་བའི་བདེ་བ་མཚོན་པར་བྱེད་པ་སྟེ།",
    "ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱཞི་རང་གི་སེམས་ཀྱིས་ཡོངས་སུ་བརྟགས་པ་སྣ་ཚོགས་ཡུམ་ལ་སོགས་པ་ལྷ་མོའི་རང་བཞིན་རྗེས་སུ་ལོངས་སྤྱོད་པ་ཇི་སྲིད་པར་ཏེ་གཟུགས་ཀྱི་ཁམས་ཀྱི་བདེ་བའི་རྒྱུའོ།",
    "ལོངས་སྤྱོད་རྡོགས་པ་དང་རང་བཞིན་དག་ལས་ཐ་དད་པར་གྱུར་པ་རྣལ་འབྱོར་པས་སོ་སོར་རང་གི་རིག་པར་བྱ་བའོ།",
    "ཞིང་རྣམས་ཐམས་ཅད་གཟིགས་པར་གྱུར།",
    "དེ་ནི་མཆོག་གི་དེ་ཉིད་བརྗོད།",
    "དག་པཞེས་པ་ཞེསཔ་ཉོན་མོངས་པའི་དྲི་མ་རྣམས་དང་མ་འདྲེས་པའོ།",
    "རདགི་ངོབོ་བཟུང་བ་དང་འཛིན་པའི་ཁམས་བཅོ་བརྒྱད་ཀྱི་རྣམའགྱུར་དང་བྲལ་བ་དེས་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཕྱི་རོལ་གྱི་གཟུག་མེད་མཐོང་བ་མེད།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་མེད་དོ།",
    "དེ་བཞིན་དུ་རེག་བྱ་མེད་རེག་པར་བྱ་བ་འད་མེད།",
    "བདག་གི་བདེ་སྐུ་འགྱུར་མེད་མཆོག།",
    "དེ་བཞིན་དུ་སྣ་ཚོགས་ཡུམ་ལ་སོགས་པའི་ལྷ་མོ་ཡེ་ཤེས་ཕྱག་རྒྱའི་དམིགས་པ་ཡིས་རྣམ་པར་རྟོག་པ་ཆེན་པོ་ཟད་པ་ལས་འགྱུར་བའི་བདེ་བ་ཆུང་དུ་འཕེལ་ལོ།",
    "གང་གི་ཚེ་ལས་ཀྱི་ཕྱག་རྒྱ་ལ་སོགས་པ་རང་གི་ཤེས་རབ་ལ་འཁྱུདཔའི་ཁྱད་ཆུབ་ཀྱི་སེམས་རྡོ་རྗེ་ནོར་བུའི་པདྨར་སོན་པ་དེའི་ཚེ་རྡོརྗེ་ནོར་བུ་དེར་སེན་པའི་ཟླ་བ་ལས་ཀྱི་ཕྱག་རྒྱའི་བརེ་བ་ནི་འགྱུརབའི་གནས་སྐབས་སོ།",
    "ཤེས་རབཆ་གས་པས་ཞུ་བའི་ནི་གཏུམ་མོ་འབར་བས་ཞུ་བའི་ཐིག་ལེ་རྣམས་བརྗོད་པའི་རིམ་པས་མགོ་བོ་དཔྲལ་བའི་བདྨ་ལས་རྫོགས་པའི་གནས་ནོར་བུའི་པདྨ་སྟེ་དེར་ཞུགས་པ་ནོར་བུའི་པདྨད་སེན་པ་རྣམས་འཆིར་བ་དམ་པའི་དོན་གྱིས་སོ།",
    "བསམ་གཏན་བཞི་པའིརྩེ་མོ་འཆང་།",
    "གདགི་ཚེ་མི་འགྱུར་བ་དེ་འཆར་བ་དང་ཟད་པ་ཆགས་པ་དང་ཆགས་བྲལ་གྱི་ཕྱོགས་གཉིས་གནོན་པའི་ཕྱིར་ཕྱོགས་གཉི་ས་སྤངས་པ་དེའི་ཚེ་ས་རྣམས་ཀྱིས་ནི་ཡོངས་སུ་རྫོགས།",
    "གྲུབ་པའི་རྡོ་དང་ལྕགས་ཀྱི་དཔེས་གསུངས་པ་ཕྱོགས་གཅིག་རྡོ་རྗེ་ནོར་བུར་བརྟན་པར་བྱས་པའི་བདེ་བ་བྱེད་པ་པོ་ལས་ཀྱི་ཕྱག་རྒྱལ་སོགས་པའི་རྣལ་འབྱོར་གྱིས་སྦར་བའི་གཏུམ་མོའབར་བས་སེམས་ལག་དུངས་ནལུསཀུན་ནསའབུགས་པར་བྱེད་དེ་དེའི་རད་བཞིན་ཤིད་ཀྱིས་རྫོགས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ཤིག་སེམས་ལ་རྣམ་པར་ཐོ་འཚམས་པའི་ཉོན་མོངས་པ་ལ་སོགས་པ་དེ་རྣམས་བློ་བུར་བ་མ་ཡིན་ཏེ།",
    "རྣམ་པརཉམས་པརཐལ་བའི་ཕྱིར་རམ།",
    "གང་གི་ཚེ་དྲིམ་དུས་རིང་པོ་ཅོན་དང་ཕྱི་ནས་ཟངས་བྱད་པ་དེའི་ཚེ་དྲི་མ་དེ་ཅི་ལས་ཏེ་གང་ལ་ས་སྐྱེས་པར་འགྱུར་རོ།",
    "དེ་རྣམ་ས་ཀུན་གྱིསཉོན་མོངས་ལྡོག།",
    "ཡེཤས་མིག་གིས་མཐོང་བར་འགྱུར།",
    "དགའ་བའོ་བུད་མེད་མཆོག་དེ་བཞིན།",
    "དོན་བདག་གིས་བཏང་སྙོམས་བརྗོད། དེ་ལྟར་དངོས་པོའི་སྦྱོར་ལྡན་པ།",
    "མི་འགྱུར་བའི་བདེ་བ་ཚིག་གི་ལམ་ལས་འདས་པ་ཞི་དགསུངས་པ་གཞོནནུ་མའིཞེས་པ་ལ་སོགས་པའོ།",
    "རེག་པ་འགག་ས་པ་ཡིས་ཀྱང་ནི་ ཚོར་བ་ངེས་པར་འགག་པར་བྱེད།",
    "ཉོན་མོངས་སྐྱེ་བ་དེ་མི་འགྱུར།",
    "ཉོན་མོངས་སྐྱེ་བ་དེ་མེདན།",
    "གང་གི་ཚོ་རྫོགས་པ་ལ་སེམས་ཀྱི་འགྱུར་མེདཞི་ད་ཐོབ་ན་དེའི་ཚེ་རྟེན་དང་བརྟེན་པའི་མཚན་ཉིད་མེད་དོ།",
    "བ་ཀོད་གྱུན་པཞི་གཞག་པ་སྟེ་མ་རིག་པ་དགག་པའི་ཕྱིར་རྡོ་རྗེ་ནོར་བུར་ཞེས་པ་རབ་གནས་མྱ་ངན་ལས་འདས་པ་མིན་པའི་སར་རྡུལ་དང་ཞི་མ་ལ་ནས་ཡི་སྐེད་པོའི་མཐིལ་ཡེ་ཤེས་ཀྱི་ཁམས་གཅིག་ནི་གཡས་པ་གང་ཤ་པའོཞེས་པ་རྐད་པ་གཅིག་གི་མཐིལ་གནོན་པའོ།",
    "ལ་ནི་་ཆད་འཐེབ་སེན་མོ་སྔར་འདོད་པའི་ཆ་འཆར་བའི་བདག་ཉིད་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་གཞས་པཞི་གཡོན་གཡོན་པ་གད་ཡིན་པའོ་ཞེས་པ་ཚདས་པའི་སྒོ་དའི་རྩ་མོ་གནོན་ནོ།",
    "རྟག་ཏུ་སྟེ་དུས་༣ གསུམ་དུ་ཉོན་མངོས་པའི་སྒྲིབ་པ་ལས་ཤིན་ཏུ་འདས་པའི་ཕྱིར་མ་རིག་པ་མི་ཤེས་པའི་གྲི་གུག་གིས་མི་ཆོད་པའོ།",
    "དེ་བཞིན་དུ་གཟུགས་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་དང་།",
    "གཟུགས་རྣམ་པ་ཐམསཅད་པའི་རང་གི་སེམས་ཀྱི་སྣང་བ་ནི་དངོས་པོ་མེདཔ་ཚད་པ་ཡིན་ཏེ།",
    "མཆོག་ནི་ཕུལ་དུ་བྱུང་བ་སྟེ་འགྲོ་བ་མཐའ་དག་དང་ཐུན་མོངམ་ཡིན་པའི་ཕྱིརརོ།",
    "རང་གི་སེམས་ལས་གཞན་ནི་མ་ཡིན་ཏེ་དེའི་ཚེ་རྣལ་འབྱོར་པ་ལ་རང་དང་གཞན་གྱི་ཆའི་རྣམ་པངརྟོག་པ་མེད་པའི་ཕྱིར་ངོ།",
    "རང་གཞནཆ་ཡིས་རྣམ་རྟོག་གིས།",
    "སྐྱེ་བམེད་པའི་ཚེ་མ་འགའ་ཞིག་གི་ས་འབྲས་བུ་འགའཞིག་ཁོ་ན་འགལ་ཞག་གིས་ཀྱང་ཉམས་སུ་མྱོང་བར་མི་འགྱུར་རོ་ཞེས་ན།",
    "གསུངས་པ་མོ་གཤམཞེས་པ་ལ་སོགས་པའོ།",
    "འདིར་རྔུལ་ཕྲ་ར་བ་ཚོགས་པའི་བདག་ཉིད་ཀྱི་ལུས་ནི་རྨི་ལམ་གྱི་གནས་སྐབས་ན་རབ་ཏུ་ལྷུང་སྟེགནས་ཤིང་འདིའི་ཉེ་བར་འ་ཚེ་བཕྲན་ཚེགས་འགའ་ཡང་ཡོདཔ་མ་ཡིན་ན་གང་གིས་ལོ།",
    "གནས་སྐབས་དེ་ཉིད་ན་སེམས་ཀྱི་བག་ཆགས་ཀྱི་བདག་ཉིད་ཀྱིས་ལུས་གཞན་རྡུལ་ཕྲ་རབ་ཚོ་གས་པ་དང་བྲ་། བ་ཡུལ་གཞན་དུ་འགྲོབ་རབ་ཏུ་སྣང་སྟེ་ཡུལ་གཞན་དུ་སདབ་དེའི་ལུས་ལ་ཆོ་མ་རྐུན་ལ་སོགས་པ་རྣམས་ཀྱིས་ཤེ་བར་འཚེ་བར་བྱས་པར་གྱུར་པ་ན་ཉེ་བར་འཚོ་བ་དེས་སེམས་ལ་སྔག་བསྔལ་རབ་ཏུ་འཇུག་ཅིང་སྡུག་བསྔལ་དེས་དུ་བར་བྱེད་དེ་ལུས་མེད་ཅིང་ཚོ་མ་རྐུན་ལ་སོགས་པ་མེད་པར་སེམས་ཀྱི་སྡུག་བསྔལ་གྱི་ཤེས་པ་རང་རིག་པར་བྱ་བརབ་ཏུ་འཇུག་པ་འདི་དེ་རྨད་དུ་བྱ་ད་བ་ཆེན་པོའོ།",
    "ཤེས་རབ་མ་ཡིན་ཐབ་ཀྱང་མི་ན་ནི་ཐ་དད་དུ་གྱུར་པའི་ཕུང་པོ་ཡོད་ན་གང་གིས་དེདབྱེར་མེད་པ་བྱང་ཆུ་བ་ཀྱི་སེམས་སུ་འགྱུར་ཏེ།",
    "ཀུནནས་བདེ་བརྫོགས་པའི་གནས་སྐབས་ཐོབ་པ་ལས་སྒྲིབ་པ་ཐམསཅད་ནི་འདོད་ཆགས་ལ་སོགས་པ་ཉོནམོངས་པ་དང་ཤེས་བྱ་ལ་སོགས་པ་སྒྲིབ་པ་ཐམསཅད་དང་བྲལ་བའོ།",
    "གོས་པ་མེད་ནིལག་པ་ལ་སོགས་པས་རེག་ཏུ་མེད་པའི་ཕྱིར་རོ།",
    "རྩ་དྲུག་གི་རང་བཞིན་ངྷི་བས་དྲུག་པའི་འཁོར་ལོ་ལ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་འདི་རྣམས་སོ་སོར་རྣམ་པ་དྲུག་གོ།",
    "དེ་ལ་དུང་ཅན་མའི་རང་བཞིནའོག་གི་རྩིབས་ལ་མི་འགྱུརབའི་ཡེ་ཤེས་སོ།",
    "ཨ་བདྷཱ་ཏཱའི་རང་བཞིན་སྟེངགིབས་ལ་མི་འགྱུར་བའི་རྣམ་པར་ཤེས་པའོ།",
    "གོས་དཀར་མོ།",
    "འདོད་པ་ཆེ་ན་པོ་ལ་སོག་ས་པ་གདོང་དྲུག་པོའྀ་ཆི་བདག་གི་བདུད་ལ་སོགས་པ་རྣམས་འཇིགས་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་འཇིགས་བྱེད་ཅེས་པ་སྟེ།",
    "འཆད་པརའགྱུར་། བའི་ཚིགས་སུ་བཅད་པས་བསྟན་པའི་གཞུང་གི་དོན་ཐམསཅད་དོ།",
    "དང་ཡིག་གིས་ཆེན་པོའི་སྒྲ་ནི་རྒྱས་བཤདལ་ཡང་ངོ།",
    "གཟུགས་དང་འདུ་ཤེས་དང་ཚོ་ང་བ་ག་། དང་འདུ་བྱེད་དང་རྣམ་པར་ཤེས་པ་དང་ཡེ་ཤེས་ཏེ་ཕུང་བོདྲུག་དང་།",
    "གོ་ས་དཀར་མོ་དང་།",
    "རདས་བྱེད་མ་དང་རྒྱལ་མ་དང་རྨུགས་བྱེད་མ་དང་ཤིན་ཏུ་བརྩོན་འགྲུས་མ་དང་ཤིན་ཏུ་སྔོན་མོ་དང་དྲག་སྤྱན་མ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་མཐའ་དག་གི་རྙོག་པས་མཚོ་ན་དུ་མེད་པའི་གཟུགས་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤིན་ཏུ་མེད་པའི་མཚན་ཉིད་རི་བོང་གི་རྭལ་སོགས་པ་སྣང་བ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གཞན་གྱི་མིག་གིས་ཤེས་བྱ་བལ་སོགས་པ་གསུངས་ཏེ།",
    "རང་གི་མིག་གིས་ཀྱང་མཐོང་བ་མ་ཡིན་ཏེ།",
    "ཟླ་བ་དང་ཉི་མའི་ལམ་དུ་སྲོག་གི་རླུད་འཇུག་པ་བསྒྱེལ་ནས་དབུམ་སྒྲ་གཅན་ལ་རབ་ཏུ་འཇུག་པའོ།",
    "གང་གི་ཚེ་ཨ་བ་རྞྞཏཱི་ཁོནའི་སྲོག་ལྟེ་བ་ལ་སོགས་པའི་འཁོར་ལོ་རྣམས་སུ་རིམས་ཀྱིས་འགོག་པ་ནི།",
    "ཟླ་བ་ཐབས་ཀྱི་ཞེས་བྱ་བ་ལསོགས་པའི་ཚིགས་སུ་བཅད་པ་གསུམ་གྱིས་ཤེས་རབ་དངཐབས་དག་གི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་རིགས་ཀྱི་དབྱེ་བས་དེ་རྣམས་ཉིད་རིག་དྲུགཏུ་རྟོག་པར་བྱའོ།",
