    "ཚེ་སྔོན་བཟང་པོའི་དམ་ཚིག་གི།",
    "ཡིད་ལ་བྱེད་པ་མཆོག་གི་ཟེར།",
    "སྟོན་ལ་དཔའ་བ་ཁྱོད་འདྲ་དབེན།",
    "ཁྱོད་ཀྱིས་ལྷག་པར་ཐུགས་སུ་བཅིང་བར་འོས།",
    "འཛིན་མཁས་ཕྱོགས་དང་ཕྱོགས་ན་རེ་རེ་ཙམ།",
    "བློ་བཟང་བསྟན་པའི་ཉིན་བྱེད་གཅིག་པུ་ཁྱོད།",
    "བདེན་ཚིག་ཟབ་མོ་བསྟན་པའི་དཔལ་དུ་མཛོད།",
    "དེ་ལྟར་འདེགས་བྱེད་ལྷ་རེག་དམ་ཚིག་མདུད།",
    "ཁྱོད་སྐུ་ཡི་དཔག་བསམ་རབ་བརྟན་ཞིང་།",
    "འབྲས་རྟགས་སུ་མོས་གུས་ཀྱི་རང་གཟུགས་བཞིན།",
    "ལྷ་རེག་བཅས་ཕུལ་པ་ཨེ་མ་ཧོ།",
    "འདུ་ཕུང་ལ་ཉི་བུས་མ་རེག་ཅིང་།",
    "དལ་འབྱོར་མཆོག་ཐོབ་པ་ད་རེས་ཙམ།",
    "ཐེག་ཆེན་གྱི་བསྟན་དང་ད་རེས་མཇལ།",
    "འདི་འདྲ་རྣམས་རྙེད་པ་ད་རེས་ཙམ།",
    "འདི་སྣང་གི་བྱ་བར་མགོ་འཁོར་ནས།",
    "རང་ལག་གི་ནོར་བུ་སྟོང་ཟད་དུ།",
    "འདི་སྣང་གི་འདུ་འཛི་བཙན་ཐབས་ཆོད།",
    "བགྲང་བགྲང་གི་གྲངས་གསོག་རེམ་པ་རྣམས།",
    "ཉམས་མྱོང་གི་རྟོགས་པའི་སྣེ་ཟིན་འགྱུར།",
    "ཞི་ལྷག་དང་རིམ་གཉིས་ཟབ་མོའི་ལས།",
    "ཟུང་འཇུག་གི་ས་ཡང་ཐག་མི་རིང་།",
    "དེ་དག་གི་གེགས་སེལ་བོགས་འདོན་དུ།",
    "བརྩེ་ཆེན་འོ་མཚོ་དད་གུས་རླབས་ཕྲེང་གིས།",
    "ཕྲིན་ལས་སྣང་བ་ས་ཆེན་ཁྱོན་འགྲེམ་བཞིན།",
    "ལྷ་རྫས་གཤོག་ཡངས་སྐྱོད་བཞིན་ལྷགས་པའི་མོད།"
  ]
}