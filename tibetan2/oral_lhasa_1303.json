    "ཟོང་ལ་བཏབ་སྟེ་ཚོང་པ་རྣམས་ལ་བསྟན་ན་ཚོང་འགྲུབ་ཅིང་ཁེ་རྙེད་པར་བྱེད་དོ།",
    "རྩ་སྔགས་བཏབ་པའི་ཆུས་ཁྲུས་བྱས་པས།",
    "སྤྲུལ་གྱིས་རྨུགས་པའི་རྨ་ཡི་དུག་མེད་པར་བྱེད་དོ།",
    "གང་ཡང་ལས་ཕྲན་ཚེགས་རྣམས་བཟླས་པ་ཙམ་གྱིས་འགྲུབ་པར་འགྱུར་རོ།",
    "གང་དུ་རྐང་པ་བཞག་པ་གཡོ་བ་ན་དེར་གཏེར་ཡོད་པར་ཤེས་པར་བྱ་ལ།",
    "འབུམ་ཕྲག་ཉེར་གཅིག་བཟླས་པས་ནམ་མཁའ་ལ་འགྲོ་བ་སོགས་གྲུབ་པར་འགྱུར་རོ།",
    "གཞན་ཡང་དེ་ལྟ་བུའི་ཡོན་ཏན་གྱི་རྣམ་པ་སྣ་ཚོགས་ཡིད་བཞིན་དུ་བྱེད་པ་ཤེས་པར་བྱའོ།",
    "ཤིན་ཏུ་དག་ཅིང་གཙང་མ་ཡིས།",
    "དེའི་རྗེས་ལ་ཀླུ་ཡི་ཆུང་མ་འདར་ནས་བཅོམ་ལྡན་འདས་ཅི་ཞིག་བགྱི་ཞེས་བཀའ་ལུང་ནོད་པར་བྱེད་དོ།",
    "འབྱུང་པོའི་སྐྲས་བདུག་ཅིང་གོས་ངུར་སྨྲིག་བཀོན་ན་བདེ་བླག་ཏུ་སོས་པར་འགྱུར་རོ།",
    "རྒྱལ་བའི་མཚན་དང་ལྡན་པའི་བུ་ཐོབ་པར་འགྱུར་རོ།",
    "ཆང་དང་སྣོད་དུ་བཅས་པ་བརླག་པར་བྱེད་དོ།",
    "ལྡན་པའི་ཞ་ཉེ་བྱང་བུ་བསྐོ་བྱས་ནས།",
    "ཞེ་སྡང་པ་དག་ངེས་པར་འཇོམས་བྱེད་པར།",
    "རྒྱུད་ཆེན་འདིས་ནི་འགྲུབ་པར་འགྱུར་པ་ཡིན།",
    "ཆར་དབབ་པ་དང་དངུལ་ཆུའི་རྫས་གྲུབ་པར་བྱས་ཏེ་མཁའ་སྤྱོད་དུ་འགྲོ་བར་བྱེད་པ་ལ་སོགས་པ་རྟོག་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ནམ་མཁའི་མུ་ཁྱུད་ཡངས་པོར་ཁྱབ་བྱས་ནས།",
    "ཡིད་འོང་ཆུ་གཙང་སྤོས་ཀྱི་ངད་ལྡང་བ།",
    "གཙང་མའི་ཞབས་བསིལ་པདྨ་རྒྱས་པའི་མཚོ།",
    "ཕྱོགས་བཅུ་ཀུན་ནས་སྤྲིན་བཞིན་གཏིབས་བྱས་ཏེ།",
    "གང་ཡང་ཕྱོགས་བཅུའི་འཇིག་རྟེན་ཁམས་བཞུགས་པའི།",
    "ཕྱི་མའི་མུ་མཐར་ཐུག་པར་བདག་འབུལ་ན།",
    "ཐུགས་རྗེ་བརྩེ་བ་ཆེན་པོ་ལེགས་བཞེས་ནས།",
    "སྲིད་པར་སྲེད་པས་སྐོམ་བཞིན་རྒྱུ་བ་རྣམས།",
    "བདེ་གཤེགས་དཔལ་ཡོན་བདག་ལ་སྒྲུབ་པར་མཛོད།",
    "མཆོད་བསྟོད་རྒྱས་པར་བྱ་ན་འདིས་བྱའོ།",
    "མཆོད་བསྟོད་འདི་ཉིད་འདོན་པར་བྱའོ།",
    "འདི་ནི་ཐུན་མཚམས་ཀྱི་བྱ་བ་སྔགས་གྲུབ་པའི་ཐབས་ཀྱི་རྒྱལ་པོ་ཚོགས་རྫོགས་པར་བྱེད་པའི་མན་ངག་སྟེ།",
    "རིག་བྱེད་མའི་བསྟོད་པ། ། རིག་བྱེད་མའི་བསྟོད་པ་དཔལ་ལྡན་ས་གསུམ་དགའ་བའི་དགའ་སྟོན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ཐུགས་རྗེའི་སྤྲིན་ཆེན་རབ་ཏུ་དཀྲིགས་བྱས་ནས།",
    "ཕྲིན་ལས་ལྷག་པར་མྱུར་བའི་ཚུལ་ཉིད་ཀྱིས།",
    "སྲིད་པར་འཇིགས་མེད་སེང་གེ་བསྒྱིངས་པའི་ཚུལ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་བརྟུལ་ཞུགས་ཀྱིས།",
    "བསྒྱིང་བའི་ཚུལ་གྱིས་གནོད་པར་མཛད་ལ་འདུད།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་པད་ཟླའི་གདན་ལ་བཞུགས།",
    "ཉམས་ཐག་ཚོགས་ཀྱི་སྐྱབས་མགོན་གཅིག་པུ་ལགས།",
    "བསྐམ་ཆགས་གདུང་བ་ལྷག་པར་འཕེལ་བའི་ཚེ།",
    "སྐྱོབས་པའི་ཞལ་བཞེས་དམ་བཅའ་དགོངས་པར་མཛོད།",
    "ཡིད་བཞིན་འགྲུབ་པར་མཛད་པའི་ཐུགས་རྗེའི་ཤུགས།",
    "དངོས་གྲུབ་འདོད་རྒུའི་ཆར་རྒྱུན་འབེབ་པར་མཛོད།",
    "ཕྱོགས་ཀུན་རྣམ་པར་སྣང་མཛད་རྒྱལ་བ་དང་།",
    "རྒྱལ་བའི་སྲས་བཅས་ཕྱོགས་བཅུར་བཞུགས་རྣམས་ལ།",
    "ལེགས་པར་བཏུས་ཏེ་བརྩེ་བའི་བསམ་པས་འདིར།",
    "རྐང་གཉིས་གཙོ་བོས་བདེན་པའི་ཚིག་ཏུ་གསུངས།",
    "ཚུལ་འདིར་འབད་པ་ཀུན་གྱིས་འཇུག་པར་རིགས།",
    "སྔོན་འགྲོ་བྱས་ནས།",
    "ཤིན་ཏུ་ཞི་ཞིང་ཏིང་ངེ་འཛིན་ལ་སྙོམ་པར་ཞུགས་པའི་བདག་ཉིད་ཅན་དུ་གསལ་བའི་སྐུ་ལས་འོད་ཟེར་དཔག་ཏུ་མེད་པ་འཕྲོས་པས།",
    "གླེང་བཞི་དང་བཅས་པའི་སྔགས་བཟླས་ན་ནོར་དང་འབྲུ་དང་གཡོག་འཁོར་འཕེལ་བར་བྱེད་ལ་མཆོག་སྦྱིན་པར་བྱེད་དོ།",
    "ཕག་རྣམས་གདོང་ཕྱིར་བསྟན་པའི་བར་གྱུར་པར་བསམ་ལ།",
    "དེ་ལྟར་བཟླས་པ་འབུམ་ཙམ་གྱིས་ལེགས་པར་བསྙེན་པར་འགྱུར་རོ།",
    "བཟང་པོའི་རྟགས་རྣམས་ཀྱིས་ནི་སྔགས་གྲུབ་པར་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ལས་རྣམས་ཀུན་ཀྱང་ཐོགས་པ་མེད་པར་འགྲུབ་བོ་ རྟག་ཏུ་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་བློ་རྣོ་ཞིང་སྟོང་ཕྲག་ཙམ་གྱི་གཞུང་ཡང་དཀའ་བ་མེད་པར་འཛིན་ནུས་སོ།",
    "གལ་ཏེ་མཚམས་མེད་ལྔ་པོ་བྱས་པས་ཀྱང་བྱེ་བ་ཕྲག་གཅིག་བཟླས་ན་ནི་ངེས་པར་གྲུབ་པར་འགྱུར་རོ་ཞེས་དཔལ་རྣམ་པར་སྣང་མཛད་ཀྱིས་གསུངས་སོ།",
    "སྣ་ཚོགས་རྒྱན་རྣམས་ཀུན་གྱིས་ལེགས་པར་སྨྲས།",
    "ཞབས་གཉིས་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་ཚུལ་གྱིས་བཞུགས།",
    "མགྲིན་པར་ཨཱ་དམར་པོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་དམ་བསྐུལ་བས་ཀུན་ཀྱང་ཡེ་ཤེས་པའི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ",
    "སྤྱི་བོར་མགོན་པོ་རྣམ་པར་སྣང་མཛད་ཀྱིས་དབུ་བརྒྱནཔར་གྱུར།",
    "བཀྲ་ཤིས་སྐྱོན་རྣམས་མེད་པར་བྱེད།",
    "སྣང་སྲིད་རྣམ་པར་དག་པའི་རང་བཞིན་གྱི་ངང་ལས་འོད་ཟེར་རྣམས་ཚུར་འདུས་རང་ལ་ཐིམ་པར་བསམ།",
    "ཡིག་བརྒྱས་བཟོད་པར་གསོལ་ལ།",
    "འདི་ནི་རྒྱུན་གྱི་ཡི་དམ་དང་སྤྲོས་པ་བསྐྱུང་བ་རྣམས་ཀྱི་ཉམས་སུ་ལེན་པར་བྱའོ།",
    "ཇི་སྐད་བསྟན་པའི་རིམ་པ་དེ་ལྟ་བུའི་སྔགས་བཟླས་པ་གྲུབ་ནས་ལས་ཀྱི་ཚོགས་རབ་འབྱམས་ལ་ནུས་པ་མཆོག་དང་ལྡན་པར་འགྱུར་རོ།",
    "གཡོན་པ་ཕག་ཞལ་ནག་པོ་མཆེ་བ་གཙིགས་ཤིང་འཇིགས་པར་བྱེད་པ།",
    "བཅད་དེ་སྟོབས་དང་ནུས་པ་ཐམས་ཅད་ཕྲོག་ནས་རང་ལ་བསྡུས་པ་ཁམས་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་མཐུ་ཆེན་པོ་ཐོབ་པར་བསམ་ལ།",
    "དེ་ལྟར་སྒྲུབ་པ་བྱས་ནས་ལས་ཀྱི་ཚོགས་རབ་འབྱམས་བསྒྲུབ་པར་བྱ་སྟེ།",
    "འཁྲུལ་འཁོར་ལ་བརྟེན་ནས་ཀྱང་སྒྲུབ་པར་བྱ་ལ།",
    "དམིགས་པའི་ཁྱད་པར་ཡང་བདག་བསྐྱེད་རྒྱས་བསྡུས་གང་ཡང་རུང་བའི་ཏིང་ངེ་འཛིན་ལ་གནས་ནས་འོད་ཟེར་གྱི་སྤྲོ་བསྡུ་ལས་དང་མཐུན་པར་བྱ་བ་དང་།",
    "དངུལ་ཆུ་ཡང་དག་པར་གྲུབ་པས་ཁམས་ཐམས་ཅད་གསེར་དུ་འགྱུར་ཞིང་རྡོ་རྗེའི་ལུས་སུ་ཡང་འགྱུར་བར་བྱེད་དོ།",
    "གཞན་པཡང་རས་བྲིས་དང་ཤིང་ལས་བགྱིས་པའི་སྐུ་གཟུགས་སོགས་གྲུབ་པའི་མཐུས་འཆི་བ་མེད་པ་མཁའ་སྤྱོད་ཀྱི་བདག་པོ་ལྷ་རྫས་ཀྱི་ལུས་ཉེས་པ་ཐམས་ཅད་ལས་གྲོལ་བ་སྣ་ཚོགས་པའི་གཟུགས་འཛིན་ཞིང་འོད་ཟེར་གྱི་སྟོབས་དང་རྫུ་འཕྲུལ་གྱིས་སྲིད་པའི་འགྲོ་བ་གཞན་ཀུན་ནས་གནོན་པའི་གཟི་བརྗིད་མཚུངས་པ་མེད་པ་ཐོབ་པ་སོགས་གང་འདོད་པའི་དངོས་གྲུབ་སྣ་ཚོགས་ཡིད་ར་",
    "བཞིན་དུ་གྲུབ་པར་བྱེད་དོ།",
    "པདྨའི་མེ་ཏོག་ཞོ་དང་སྦྲང་རྩི་མར་ལ་སྨྱུག་པའི་སྲེག་བླུག་འབུམ་ཕུལ་ན་བཅོམ་ལྡན་འདས་མའི་ཞལ་མཐོང་ཞིང་སྐྱེ་བ་འདི་ལ་ཕུན་སུམ་ཚོགས་པའི་བདེ་བ་ཐམས་ཅད་སྐྱེད་པར་བྱེད་པའི་མཆོག་ཏུ་འགྱུར་རོ།",
    "ཞེས་བཟླས་པས་དཔག་ཚད་བརྒྱའམ་སྟོང་ནས་ཀྱང་འགུག་པར་བྱེད་དོ།",
    "ཡང་དྱེ་ཡིས་བསྐོར་བ་བྱས་ལ་སྐུ་གཟུགས་མདུན་དུ་གུ་གུལ་གྱིས་བདུག་ཤིང་སྔགས་བརྒྱ་རྩ་བཟླས་ལ།",
    "དེ་རྐང་པ་གཡོན་པས་མནན་ཞིང་མི་ཡི་བདག་པོའི་མིང་བཟུང་བའི་སྔགས་བཟླས་པས་ཞག་གསུམ་ན་ཐེ་ཚོམ་མེད་པར་འགུག་གོ།",
    "ཕན་ཚུན་སེམས་རོ་གཅིག་པར་དམིགས་པ་བྱའོ།",
    "རྣམ་པར་རྒྱལ་བ་དཀར་པོའི་འབྲས་བུ་དང་།",
    "གཡུལ་ངོར་བྱས་ན་རྒྱལ་བ་ཐོབ་བོ།",
    "རྨོངས་པར་བྱར་མེད།",
    "ཡང་ན་རྒྱུ་སྐར་རྒྱལ་གྱི་དུས་སུ་གཞོན་ནུ་མས་བཀལ་བའི་སྐུད་པ་དམར་པོ་སུམ་སྒྲིལ་བྱས་ལ་སྔགས་ལན་ཉེར་གཅིག་བཏབ།",
    "གནགས་ལྷས་སུ་ཐང་སྐུའི་མདུན་ཐས་ཁུང་ཚད་དང་ལྡན་པར།",
    "ཞེས་པའི་སྔགས་ལན་བདུན་གྱིས་འབྱུང་པོའི་ཚོགས་ལ་སྦྱིན་པར་བྱས་ལ་སླར་ལྷའི་ཁང་བར་ཞུགས་ཏེ་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའི་བུམ་པ་ཆུས་བཀང་བ་ཁྱུ་མཆོག་རྣམས་ལ་གཏོར།",
    "དེ་ལྟར་བྱས་ཏེ་དུས་གསུམ་དུ་ཞི་བའི་བཟླས་རྩ་སྔགས་དྲུག་པ་ཞི་བའི་ཤམ་ཅན་ནོ།",
    "པས་སྦྱིན་སྲེག་སྟོང་བྱས་ན་གནོད་པ་གང་ཡང་ཞི་བར་བྱེད་དོ།",
    "དྲི་ཡིས་བདུག་པ་བྱས།",
    "ལྷའི་ང་རྒྱལ་གྱིས་སྔགས་བཟླས་ཤིང་དྲིལ་བུ་དཀྲོལ་བ་དང་བཅས་ཏེ་གུ་གུལ་བདུག་པས་སྐད་ཅིག་དེ་ཉིད་ལ་འབེབས་པར་འགྱུར་རོ།",
    "ཞེས་དབབ་པའི་སྔགས་ཡང་དག་པའོ། པྲ་དབབ་པར་བྱེད་ན།",
    "དེ་ལ་ལྷ་སོགས་ཐམས་ཅད་སྔགས་ཀྱི་རྒྱལ་པོ་འདིས་བསྐུལ་བར་བྱ་སྟེ།",
    "ལྗགས་གློག་བཞིན་འཇིགས་པར་བྱེད་པ།",
    "མུ་མེན་ལྟ་བུའི་གོས་སྔོན་པོའི་སྨད་དཀྲིས་བྱས་ཤིང་།",
    "ཤ་འགག་དང་སྟོད་གཡོགས་སྣ་ཚོགས་པའི་གོས་ཀྱིས་བྱས་པ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་ལ་ཞབས་གཡས་བརྐྱང་བའི་སྟབས་ཀྱིས་རབ་ཏུ་ཁྲོས་པས་བསྒྲུབ་བྱ་མནན་པར་བསམས་ལ།",
    "ཡང་དགྲ་གསོད་པར་འདོད་ན།",
    "དུར་ཁྲོད་དུ་བྲིས་ན་ནི་ཞག་གསུམ་གྱིས་ཉམས་པར་བྱེད་དོ། ། དགྲ་བོ་རིམས་ཀྱིས་གཟུང་བར་འདོད་པས།",
    "སྟེང་ནས་མགུལ་བ་བཅིང་བའི་ཐོད་པ་དགྲ་བོའི་ཁང་བར་སྦས་ན་འཕྲལ་དུ་རིམས་ཀྱིས་འཛིན་པར་འགྱུར་རོ།",
    "སོ་སོའི་གཟུགས་བརྙན་བྱས་ལ་རྒྱབ་སྤྲད་དེ་མ་ཧེའི་ཤ་དང་རྟའི་མགོ་སྤུས་ལེགས་པར་བཅིངས།",
    "གཉིས་ཀ་འཐབ་བཞིན་པར་བསམ་ན་དབྱེ་བར་བྱེད་དེ།",
    "ཡང་ན་མ་ཧེའི་རྭ་དང་རྟའི་རུས་པ་ལ་གཟུགས་བརྙན་བྱས།",
    "ཡང་ན་གཟུགས་བརྙན་དགྲའི་ཁྱིམ་དུ་སྦས་ཀྱང་འབྱེད་པར་འགྱུར་རོ། ། དགྲ་བོ་སྐྲོད་པར་འདོད་ན།",
    "དེས་ནི་དེ་མ་ཐག་ཏུ་སྐྲོད་པར་བྱེད་དོ། ། ཕ་རོལ་རྨོངས་པར་བྱ་བའི་ལས་ནི།",
    "ཐོད་ལེ་ཀོར་གྱི་དབྱུག་པར་དུག་སྦྲུལ་མགོ་གསུམ་པ་བྲི།",
    "སྔགས་སྤེལ་ཚིག་ཅན་བཟླ་ཞིང་དབྱུག་བ་དེ་འཇིགས་པ་བྱུང་བའི་དུས་སོགས་གང་ཞིག་རྨོངས་པར་བྱ་དགོས་པའི་དུས་སུ་ལག་པ་གཡོན་པས་བཟུང་སྟེ་དགྲ་ལ་བསྡིགས་པའི་ཚུལ་བྱ་ཞིང་ཡིག་དྲུག་བཟླ།",
    "འོག་ཏུ་ཟླ་དཀྱིལ་དང་སྟེང་དུ་ཡང་ཨ་ལས་སྐྱེས་པའི་ཟླ་དཀྱིལ་གྱི་བར་དུ་བདག་ཉིད་ཡིབ་པར་བསམ་ལ་འོད་ཟེར་ཅན་བདག་ལ་སྐྱོབས་ཤིག་ཅེས་སོགས་སྔགས་བཟླ།",
    "དེས་ནི་འཇིགས་པ་ཐམས་ཅད་དང་རྐུན་མ་སོགས་ཀུན་ལས་ངེས་པར་སྲུང་བར་ར་",
    "དེ་ནས་གླང་པོ་ཆེའམ་ཤིང་རྟའི་མཆོག་ལ་སློབ་དཔོན་ཞོན་སྟེ་གཡུལ་ལ་ཕྱོགས་པར་བཅོམ་ལྡན་འདས་མའི་ཐང་སྐུ་བཀྲམ།",
    "གཙང་མའི་མཎྜལ་དུ་མེ་ཏོག་དང་དཀར་མངར་གྱི་གཏོར་མ་སྣ་ཚོགས་ཀླུ་མི་ཕམ་བཀའ་འབུམ།",
    "བདག་ཉིད་ཤིན་ཏུ་འཇིགས་ཤིང་བསྡིགས་པའི་ཚུལ་གྱིས་ཀླུ་རྣམས་བསྐུལ་བས་མི་བཟོད་པར་ཡུད་ཙམ་གྱི་མཁའ་ལ་སྤྲིན་གྱི་ནང་ནས་ཀླུའི་ཚོགས་ཀྱིས་ཆར་གྱི་རྒྱུན་འབེབ་ཅིང་།",
    "དེ་མ་ཐག་ཏུ་ནམ་མཁའི་དབྱིངས་དང་ས་གཞི་ཐམས་ཅད་ཆུས་བཀང་བར་དམིགས་པར་བྱའོ། ། ཡང་།",
    "འཛམ་བུའི་གླིང་ཀུན་དུ་བསྐྱབ་པའི་ཕྱིར་ཀླུ་ཀུན་གྱིས་ཆར་འབེབ་པར་བྱེད་དོ།",
    "དེ་ནས་སེ་འབྲུའི་ཡལ་གས་ཀྱང་བརྡེག་པས་ལངས་ནས་ལྕེ་གཉིས་སྟོན་པར་བྱེད་དོ།",
    "དེ་ནས་འོ་མ་ཡུངས་གར་དུ་བཅས་པ་དེ་སྔགས་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་ཏེ་ཇི་ལྟ་བའི་གཟུགས་ཀྱི་གནས་ཐམས་ཅད་དུ་གཞུག་པར་གཏོར་བར་བྱས་ནའང་།",
    "བཅོམ་ལྡན་འདས་མའི་མདུན་དུ་དཀྱིལ་འཁོར་གྲུ་བཞི་པར་མེ་ཏོག་བཀྲམ།",
    "སླར་ཡང་བརྒྱ་རྩ་བརྒྱད་ཀྱང་བཟླས་ལ་ཀླུའི་གཟུགས་རྫོགས་པར་ཁྱབ་པར་འང་།",
    "ཆད་པའི་རྒྱུན་འབེབ་པར་བྱེད་དོ།",
    "སྟོང་རྩ་བརྒྱད་ཚངས་པ་དང་དེའི་གཟུགས་མེད་མཆོག་རྣམས་ལ་ལོངས་སྤྱོད་པར་བྱེད་དོ།",
    "སྐམ་ནས་དེའི་རྒྱབ་དུ་གསེར་སོགས་ཀྱིས་རིམ་པར་གཡོགས་པར་བྱའོ།",
    "ས་གཞིའི་དཀྱིལ་འཁོར་དུ་གནོད་གཟུགས་སམ་སྦྱིན་ལྟར་འདོད་པའི་གཟུགས་འཛིན་པར་འགྱུར་རོ།",
    "གཞན་ཡང་ལས་ཐམས་ཅད་པ་ཡིད་བཞིན་ནོར་བུའི་འཁྲུལ་འཁོར་སོགས་ལས་ཀྱི་ཚོགས་སྒྲུབ་པའི་ཐབས་མང་པོ་དག་ཀྱང་རྟོག་པ་བཞིན་དུ་མན་ངག་ལྡན་པས་ཤེས་པར་བྱ་ལ།",
    "འདིར་ནི་འདི་ཙམ་གྱིས་ཀྱང་དོན་ཡོངས་སུ་འགྲུབ་པའི་ཕྱིར་ལེགས་པར་སྤེལ་བ་ཡིན་ནོ།",
    "འདི་ཡི་ལེགས་བྱས་ཉི་ཟླའི་འོད་ཟེར་འབུམ།",
    "ཚེ་རིང་ལྷ་སྒྲོན།",
    "༢༡༩ལོའི་ཟླ་༨པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "༢༢༡ལོའི་ཟླ་༡པོར་པར་ཐེངས་གསུམ་པ་དཔར།",
    "༡༨༥༢༦དཔར་ཤོག་༡༣༢༧༥ཡིག་འབྲུ་སྟོང་།",
    "པོད་༦༤༣ཇི་བིག་དེ་མུར་གྱིས་ཕལ་ཆེན་གསེར་འོད་སྟོང་ཕྲག་བརྒྱ་པ་རྣམས་བཞེངས་པའི་མཚོན་བྱེད། བ་ ། ཇི་བིག་དེ་མུར་གྱིས་ཕལ་ཆེན་གསེར་འོད་སྟོང་ཕྲག་བརྒྱ་པ་རྣམས་བཞེངས་པའི་མཚོན་བྱེད་བཞུགས། ། ཨོཾ་སྭ་སྟི་སིདྡྷཾ།",
    "མཁྱེན་པས་མཁྱེན་པར་བྱ་བ་ཀུན་མཁྱེན་པ།",
    "མཛད་པས་མཛད་པར་བགྱི་བ་ཀུན་བསྒྲུབས་པས།"
  ]
}