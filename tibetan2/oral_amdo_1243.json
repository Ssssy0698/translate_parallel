    "མགོ་བོ་ཐུར་དུ་བསྟན་པ་ཧཱུཾ་གིས་མཚན་པ།",
    "ཨོ་ཡོག་བུདྡྷསརྦདྷིམྨཡོ་ག་ཤུདྡྷོཉྩ།",
    "ལྷཐམས་ཅད་ཀྱི་ལྗགས་ལ་ཧཱུྃ་ལས་རྡོ་རྗེ་སྐུ་གུཙན་ཧཱུཾ་གིས་མཚན་པར་བསམ།",
    "ཞེས་ཕྱེདསྔགས་ཚར་གཅིག་བརྗོད་པས་ཀྱང་མཉེས་པརབསམ་མོ།",
    "དེ་གཉིས་ཀྱི་བར་དུ་ཧཱུཾ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས།",
    "ཞལ་རེ་རེ་ལ་སྤྱན་གསུམ་གསུམ་དང་ལྡན་ཞིང་མཆེ་བབཞི་བཞི་གཙིགས་པ།",
    "ལྔ་པ་ན་ཁྲག་གིས་གང་བའི་ཐོད་པ།",
    "ཞབས་གཡས་བརྐྱང་བས་སམཚམ་དམར་མོའི་ནུ་མའི་སྟེང་དང་།",
    "དབུ་རེ་རེ་ལ་མི་མགོ་སྐམཔོ་ལྔ་ལྔས་དབུ་བརྒྱན་ཅིང་།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོའགུསྒེག་པ་དཔལ།",
    "ཁྲག་གིས་གང་བ་འཛིན་པས་ཡབ་ལ་འཁྱུད་ཅིང་།",
    "གཏུམམོ།",
    "གསུད་གི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་དམར་པོ་ས་སྟེང་ནསྤྱོད་པ་ཚུལ་གྱིསབཞུགས་པའོ།",
    "བྱང་ཤར་ཀུ་ལུཏཱར་རྡོ་རྗེ་སེམས་དཔའ་དད་བརྩོན་འགྲུས་ཆེན་མོ་སྟེ།",
    "སྟག་གི་བགས་པའི་ཤམ་ཐབསགྲོལ།",
    "རོའི་གདན་ལ་ཞབས་གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "རབ་དགཏུམ་མོ་ལ་སོགས་བའི་དཔའ་རྣམས་ནི་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པས་ཡབ་ལའཁྱུདལ།",
    "ཡུམགྱི་ལྟེ་བར་ཨོ་ཐོ་དམར་མོ་རྡོ་རྗེ་ཕག་མོ།",
    "ནམོ་ཚོས་ཀྱི་དབྱིངས་ཀྱི་སོགས་ཀྱིས་ཡིད་མཆོད།",
    "ཨོསརྦ་བུདྡྷཌཱ་ཀི་ནཱི་ཡེ་བཛྲ་ཝརྞ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃཔ་སྭཱཧཱ།",
    "བདེན་པ་དེས་ཀྱང་ལྷ་མོ་དེ་དག་གིས།",
    "ཡེ་ཤེསཀྱི་ཐིགགིས་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར།",
    "རང་གི་མདུན་དུ་ཐིག་ཚོན་རྣམས་འདུས་བྱས་ལ།",
    "དག་ཏུ་ཨོཾ་སརྦ་བུདྡྷ་ཀི་ནཱི་ཡེ་བཛྲ་ཝཚནཱི་ཡེ་ཧཱུྃཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "ཨོསརྦ་ཏྟཾ་ཤཱ་ག་ཏ་ཤྲཱི་ཀུ་མྱུར་མཎྜ་ལ་ཙཀྲ་སརྦཝཱིར་ཡོ་གི་ནཱི་ཉཱ་ཀྱེ་བཛཱིཧཱུཾབཛྲ་ཛཾཏེ་ཧཱུཾ།",
    "སྒེག་མོ་སྔོན་མོ་རྡོ་རྗེ་དང་དྲིལ་བུ་དཀུ་གཉིས་སུ་འཛིནབསྤྱད་ལ།",
    "ཏ་ཤྲཱིཙཀྲ་པཱར་མཎྜལ་ཙཀྲསརྦ་ཝཱི་ར་ཡོ་གི་ནི་བཛྲནཱི་བཛྲ་པཱུ་ཛིཏཧཱུཾ།",
    "རྡོ་རྗེ་ཐལ་མོ་སྦྱར་ཞིང་བསྐོར",
    "སྣོསརྦ་ཏ་ཐཱ་ག་ཏ་བྷི་ཙཀྲ་སམྦ་ར་མཎྜལ་ཙཀྲ་པབ་ཝཱིར་ཡོ་གིནཱིཔུཊྚཾབཛིནཱི་བཛྲཔཱུ་ཛི་ཏེ་ཧཱུཾ།",
    "ཨོཾ་པ་ཏ་ཐཱ་ག་ཏ་བྷི་ཙཀྲསམྱུར་མཎྜལ་ཙཀྲ་སང་ཝཱིཉཡོགིནཱིཙྪཔཾབཛིནཱི་བཛྲ་པཱུ་ཛི་ཏེ་ཧཱུཾ།",
    "ཨོ་བློཏ་ཐཱ་ག་ཏ་ཤྲཱི་སམྦརམཎཱ་ལ་ཙཀྲུ་སརྦ་ཝཱིར་ཡོ་གི་ནི་རཱུ་པ་བཛྲནཱ་།",
    "མཛུབ་མོ་དང་།",
    "མཛུབ་མོའི་ཚིག་བཅག་པ་མཐེ་བོང་དག་དདསྦྱར།་",
    "དོཛེབསྡམས་བས་ཉུང་མོ་སྦྱར་བ་བརྐྱང་བའི་ཚིག་དང་པོར་མཛུབ་མོ་གཉིས་སྦྱོར།",
    "ཁུ་ཚུར་གཉིས་སྦྱར་ལ་མཉྩི་པོད་སོ་སོར་ས་ཀ་ན་སྦྱོེ་གུད་མོ་དང་སྲིན་ལག་གཤིབས་ཏེ་བཏུང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པ་ན་ཡོད་པའི་གཟུགས་སོགས་ལྔ་པོ་འབུལ་བར་མོས་ལ།",
    "ཡོགི་མི་ཏུ་པ་ཀཱ་མ་གུ་ཎ་བཛྲ་པཱུ་ཛི་ཏེ་ཧཱུཾ།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བས་དབུལ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་གི་ཙཀྲ་ས་ར་མ་ཙཱ་ལ་ཙཀྲ་སརྦ་ཝེ་ན་ཡོ་གི་ནི་སྭཱ་རེ་ཀཱ་མ་གུ་ཏ་བཛྲཔཱུ་ཛི་ཏེ།",
    "ལྷའི་དརྒྱལ་བརྟན་པོས་སུམྦྷ་ནི་ཟློས་ཤིང་རོལ་མོ་དྲག་ཏུ་བྱ།",
    "དེ་བཞིན་བདག་གིས་ཁྲུས་བྱའོ།",
    "པ་ལོ་ཀི་ལི་ཀི་ལི་སུ་ཝཱི་རེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨ་མ་པ་ཐ་ཝཱི་ཡེ་ཧུཾ་ཧཱུཾ་༦ ཅེས་བརྗོད།",
    "ཨོསརུ་བུདྡྷ་ཌཱ་ཀི་ནྟི་ཡེ་བཛྲ་ཝརྞནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཐའ་སཱཧཱ།",
    "དེ་བཞིན་བདག་གིས་ཁྲུས་བགྱིའོ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨབྷི་རེ་ཀ་ཎ་ས་མ་ཡ་ཤྲཱི་ཡེཧཱུཾ།",
    "དབད་རྫ་༤་འགྲིམ་པ་རྣམས་དེའིཐུགས་ཀ་ནས་བྱེ་བའི་ཧེ་རུ་ཀ་ཞིག་གིས་མཛད་པར་བསམས་ལ།",
    "བུ་ཁྱོད་སུ་ཡིན་ཅིལ་དགའ།",
    "༧ མ་དེབཞིན་གཤེགས་པ་ཁུམས་ཅད་ཀྱི་གསང་ཆེན་དམ་པ་འདི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པ་རྣམས་ཀྱི་མདུན་དུ་སྨྲ་བར་མི་བྱ་ཞིངདེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རློབ་པར་འགྱུར་གྱི།",
    "བུ་ཁྱོདཀྱིས་ནི་གཟུང་བྱ་སྟེ།",
    "ཚེན་བརྒྱདལ་ལྷོ་ཕཊཧི་ལྗད་དུ་རྟཡཚོག་ཡུམ་གྱི་ལྟེ་བར་ཨོ་ཨོ་བོ་དམར་མོ་རྡོ་རྗེ་ཕག་མོ།",
    "རང་གི་མཐེ་བོང་གཡས་གཙོ་བོའི་གཡོན་པས་བཟུང་བར་བསམས་ལ།",
    "རང་གི་སེམས་ཉིད་ལ་དཔའབོ་བསྐུལ་ལོ།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "ཉོན་མོདས་གཅོད་པའི་དོན་ལ་ཤིན་ཏུ་མཁས་གྱུར་བ།",
    "སྲིད་པའི་ཉེས་བརྒྱ་བསྐྱེདརྩ་ཉོན་མོངས་ཚོམ་མཛོད་ལ་ཚུལ་འབྱོར་དོན་དམ་རྒྱལ་པོ་དེ་ཉིད་བདག་ལ་གྲུབ་པར་མཛོད།",
    "ཞབས་གཡས་བརྐྱང་བས་དུས་མཚན་མ་དམར་མོ་ཞུ་མའི་སྟེང་དང་།",
    "རལ་པའི་ཐོར་ཅོག་སྤྱི་བོར་བཅིངས་པའི་རྩེརཡིད་བཞིན་གྱི་ནོར་བུས་སྤྲས་ཤིང་གཡོན་ཚོས་གཅིག་གི་ཟླ་བ་དང་།",
