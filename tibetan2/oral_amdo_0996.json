    "དེ་རྗེས་གོང་ས་མཆོག་དང་ལྷན་བསྟི་གནས་ཁང་དུ་བྱིས་པ་ཉམས་ཐག་རྣམས་ལ་གཟིགས་ཞིབ་མཛད་དེ་གོང་ས་མཆོག་གིས་བྱིས་པ་རྣམས་ལ་བྱམས་བརྩེའི་ཕྱག་གི་བྱུག་བྱུག་མཛད།",
    "གོངས་ས་མཆོག་གིས་བཀའ་སློབ་སྩལ་དོན།",
    "ཁྱེད་ཚོས་དཀའ་ལས་བརྒྱབ་ནས་རང་གི་མི་ཚེ་དོན་དང་ལྡན་པ་ཞིག་བཟོ་ཐུབ།",
    "དེར་བརྟེན་ཁྱེད་ཚོས་རེ་བ་དང་ཡིད་ཆེས་ནམ་ཡང་མ་དོར་བར་མུ་མཐུད་དཀའ་ལས་རྒྱག་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་ཆགས་ཡོད།",
    "༢༡ ཟླ་༨ ཚེས་༡༣ རེས་གཟའ་པ་སངས། །",
    "ཁྱིམ་གཞི་བསྐྱར་གསོའི་ལས་གཞིར་རོགས་དངུལ་ཞལ་འདེབས་འབུལ་རྒྱུ་དེ་རེད།",
    "ཡང་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་བཀའ་སྩལ་དོན།",
    "པ་ཀི་སི་ཐན་ནང་རང་བྱུང་གི་རྐྱེན་ངན་དང་ཨུ་རུ་སུར་ནགས་ཚལ་ལ་མེ་སྐྱོན་བྱུང་བའི་གནས་ཚུལ་དེ་དག་ལའང་དོ་སྣང་བྱེད་དགོས།",
    "སྣོད་བཅུད་དཔྱད་ཞིབ་པ་ཚོས་རྐྱེན་ངན་དེ་རིགས་ཚང་མ་གོ་ལའི་ཚ་དྲོད་རྒྱས་པའི་རྟགས་ཡིན་ཞེས་བརྗོད་འདུག་དེ་དག་ནི་ཧ་ཅང་བློ་ཕམ་གྱི་གནས་ཚུལ་གཅིག་རེད།",
    "འོན་ཀྱང་ཁོང་ཚོའང་འགྲོ་བ་མིའི་ཁྱིམ་ཚང་ཆེན་པོ་འདིའི་ཆ་ཤས་རེད།",
    "དེ་བཞིན་གོང་ས་མཆོག་གིས་བཀའ་སློབ་སྩལ་དོན།",
    "གང་ལྟར་འགྱུར་བ་ཡག་པོ་ཡོང་གི་ཡོད་པ་གང་འཚམ་གསལ་པོ་ཆགས་ཀྱི་ཡོད།",
    "མགོན་པོ་གང་ཉིད་མཆོག་སྐུ་ཚེ་ཡུན་རིང་བརྟན་པ་དང་བོད་ལ་མགྱོགས་མྱུར་ཆིབས་སྒྱུར་བསྐྱངས་ཏེ་བོད་པའི་མི་རྣམས་ལ་སླར་ཡང་གོང་ས་མཆོག་གིས་ཞལ་མཇལ་གསུང་ཐོས་ཡོང་རྒྱུའི་སྨོན་འདུན་ཡང་ཞུས་ཡོད་པ་བཅས།",
    "གསེར་དངུལ་རྒྱན་ཆ་གང་བྱུང་བཏགས་ན་ཡག་པོ་ཡོད་པ་མ་རེད།",
    "མ་འོངས་པར་གསེར་དངུལ་གཡུ་བྱུར་གྱི་རྒྱན་ཆ་རིགས་བཏགས་ན་ཡག་པོ་མེད་ཚུལ་གསུངས་སོང་།",
    "དེ་རིང་ཕྱི་ཚེས་༩ཉིན་གྱི་སྔ་དྲོའི་ཆུ་ཚོད་༡༡སྟེང་དང་ཕྱེད་ཀའི་སྟེང་༧གོང་ས་མཆོག་གིས་གནས་མཆོག་རྡོ་རྗེ་གདན་དུ།",
    "ཞེས་པ་དབུ་འབྱེད་གནང་སོང་།",
    "ཉི་མ་རེ་རེ་བཞིན་བསམ་བློ་གཏོང་དགོས་པ་ཞིག་དང་མ་ཤི་བར་བསམ་བློ་གཏོང་དགོས་པ་ཞིག་ཡིན།",
    "དེའི་ཐོག་ནས་ལུས་རྟེན་བཟང་པོ་ཞིག་ཡོང་རྒྱུ་བརྒྱ་ཆ་བརྒྱ་ཐག་ཆོད་པ་ཞིག་རེད།",
    "དེ་ཡོང་བའི་རྩ་བ་རྟེན་འབྱུང་གི་ལྟ་བར་བསམ་བློ་གཏོང་པ་རེད་ཅེས་གསུངས་སོང་།",
    "༧གོང་ས་མཆོག་གིས་མུ་མཐུད་དུ་གསུངས་དོན།",
    "ཕན་པའི་བསམ་པ་ནི་བདེ་སྐྱིད་ཀྱི་རྩ་བ་རེད།",
    "དུད་འགྲོ་ལ་ཆ་བཞག་ནའང་ཕན་སེམས་བཅངས་ན་དགའ་པོ་བྱེད་ཀྱི་རེད།",
    "མི་མཐོ་དམན་བར་གསུམ་གཉེན་དུ་འགྲོ་བ་ཞིག་དང་གྲོགས་པོ་ཆགས་ཐུབ་པ་ཞིག་ཡོང་གི་ཡོད།",
    "སེམས་སྐྱིད་ན་ལུས་བདེ་བ་ཡོང་གི་ཡོད།",
    "རྒྱན་ཆར་དོ་སྣང་ཆེན་པོ་བྱས་ཏེ་རྒྱས་སྤྲོས་བྱེད་བཞིན་པར་༧གོང་ས་མཆོག་གིས་བསྐྱར་དུ་ནན་བརྗོད་གནང་དོན།",
    "མཱ་ཅང་རྒྱག་པ་དང་རྒྱན་ཆེན་པོ་འཇོག་གི་ཡོད་ཚོད་རེད།",
    "དེ་ཚོ་ཁྱོན་ནས་བྱ་རྒྱུ་ཡོད་པ་མ་རེད།",
    "གསེར་དངུལ་རྒྱན་ཆ་གང་བྱུང་བཏགས་ན་ཡག་པོ་ཡོད་པ་མ་རེད།",
    "དེ་སྔོན་ངས་གཅན་གཟན་གྱི་པགས་རིགས་གྱོན་ན་ཡག་པོ་མི་འདུག་ལབ་པ་རེད།",
    "ངས་ལབ་པ་ལྟར་མང་པོ་ཞིག་གིས་ཚུལ་བཞིན་དུ་ཡག་པོ་བྱས་སོང་།",
    "འཆད་མཁས་པ་ལ་སོགས་འཕགས་པའི་ནོར་བདུན་ཡོད་པ་རེད།",
    "ནོར་ངོ་མ་དེ་ཚོ་ཆགས་ཡོད་པ་རེད།",
    "ནོར་དེ་ཚོ་ཚེ་འདི་ལ་ཕན་གྱི་རེད་ལ།",
    "༧གོང་ས་མཆོག་གིས་སྐུ་རྩེད་དང་སྦྲགས་གསུངས་དོན།",
    "སྟོན་པ་བཅོམ་ལྡན་བྱོན་ཏེ་ལོ་༢༥ལྷག་ཕྱིན་ཡོད་པ་རེད།",
    "དེ་ལྟར་བྱས་ན་ང་རྒྱལ་གྱི་རྐྱེན་ལ་འགྲོ་རྒྱུའི་ཉེན་ཁ་ཡོད་པ་རེད།",
    "ཁ་ཁུ་སིམ་པོ་བྱས་ཏེ་སྡོད་དགོས་པ་རེད་ཅེས་གསུངས་སོང་།",
    "ང་ཚོ་ཚང་མམམས་དཔེ་རྙིང་ཉམས་གསོ་དང་འཚོལ་སྡུད།",
    "ཤེས་ལྡན་གང་མང་ཞིག་གིས་ལོངས་སུ་སྤྱོད་ཐུབ་པ།་",
    "ཞུ་དག་གི་འགན་བཞེས་པའི་ཐབས་ལམ་བཙལ་བ་ཡིན།",
    "དཔེ་རྙིང་ཉར་ཚགས་བྱེད་མཁན་དང་དད་ལྡན་མང་ཚོགས་རྣམས་ལའང་ད་ས་གཞལ་དུ་མེད་པའི་རིན་ཐང་ལྡན་པ།",
    "བར་དུ་བསྡུ་སྒྲིག་ཐ་མར་པར་སྐྲུན་གྱི་བྱ་བ་འདི་དག་རུས་སྦལ་ནུར་འགྲོས་ཀྱི་དཔེ་ཇི་བཞིན་འབད་པ་ལྷོད་མེད་དང་དཀའ་སྡུག་བཟོད་སྲན་བགྱིས་མཐར་ད་གཟོད་གཞི་ནས་ལེགས་འགྲུབ་བྱུང་བ་ཞིག་རེད།",
    "གྲུབ་རིགས་ཁྱུ་མཆོག་རས་པན་མོ་གུ་རུ་མཉྫགྷོ་ཥ་ཡ།",
    "ཀུ་ཡ་ཀུ་ཡངས་པ་ཀུ་རེ།",
    "ཀེའུ་ཚང་ཀེ་རེ་ཀེ་ལ་ཤ།",
    "ཀེ་ཤ་ཀེག་དང་ཀེག་གིས་ལངས།",
    "ཀོ་བྱི་ཀོ་མོག་ཀོའུ་ཤི་ཀ།",
    "ཀོག་གིས་ཀོག་ཙེ་ཀོང་ཀོང་དང་།",
    "ཀོང་བུ་ཀོང་མོ་ཀོན་ཌི་ནེ།",
    "སྐྱ་མི་སྐྱ་རེངས་སྐྱ་བསེང་བ།",
    "སྐྱག་པ་སྐྱང་ནུལ་སྐྱབས་སྐྱར་མོ།",
    "སྐྱི་བུན་སྐྱི་མོ་སྐྱི་གཡའ་བ།",
    "སྐྱེད་ཆེ་སྐྱེད་ཐོན་སྐྱེད་མོས་ཚལ།",
    "དཀྱུས་མ་དཀྱུས་མོ་དང་དཀྱུས་ས།",
