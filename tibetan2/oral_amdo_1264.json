    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་རེག་པས་ཚེ་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་དང་ཁྱད་པར་དུ་རྣམ་སྨིན་གྱི་ཕུང་ཁམས་སྐྱེ་མཆེད།",
    "མདུན་བསྐྱེད་དང་བཅས་པའི་ཐུགས་ཀར་ཕོག་པས་དེ་རྣམས་ཀྱི་ཐུགས་ཀ་ནས་ཡེ་ཤེས་ཀྱི་མགོན་པོའི་སྐུ་ཆེ་བ་རི་རབ་ཙམ་ཆུང་བ་རྡུལ་ཕྲན་ཙམ་དཔག་ཏུ་མེད་པ་སྤྱན་དྲངས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་གཙུག་བ་སྤུའི་བུ་ག་ན་མར་ཐིམ་པར་མོས།",
    "ལས་མགོན་སོ་སོ་ལ་གཉིས་སུ་མེད་པར་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབས་པར་མོས།",
    "ཨོ་མཧཱ་ཀཱ་ལ་སོགས་བརྗོད་ཅིང་རོལ་མོ།",
    "ལུས་ཀྱི་བར་ཆད་ཐམས་ཅད་ཞི་བར་བྱས་ཁྱེད་རང་གི་ལུས་ཡེ་ཤེས་ཀྱི་མགོན་པོ་འཁོར་དང་བཅས་པའི་སྐུའི་ངོ་བོར་གྱུར་པ་ཡིན་སྙམ་དུ་མོས་པ་མཛོད།",
    "དེ་རྣམས་ཀྱི་ཐུགས་ཀ་ནས་གསུང་གི་ངོ་བོ་རྩ་སྔགས་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པར་ཐིམ་པར་མོས།",
    "དེས་གསུང་གི་རྗེས་སུ་། གནང་བ་ཐོབ།",
    "ངག་གི་བར་ཆད་ཐམས་ཅད་ཞི་བར་བྱས།",
    "ཁྱེད་རང་གི་ངག་ཡེ་ཤེས་ཀྱི་མགོན་པོ་འཁོར་དང་བཅས་པའི་གསུང་གི་ངོ་བོར་གྱུར་པ་ཡིན་སྙམ་དུ་མོས་པ་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཀྱི་ཡེ་ཤེས་ཀྱི་མགོན་པོ་འཁོར་དང་བཅས་པའི་ཐུགས་ཀྱི་ངོ་བོར་གྱུར་པ་ཡིན་སྙམ་དུ་མོས།",
    "དེ་ལྟར་སྐུ་གསུང་ཐུགས་སུ་བྱིན་གྱིས་བརླབས་པ་དེ་ཉིད་སྤྱི་བོར་རྡོ་རྗེ་བཞག་སྟེ་ཏིཥྛ་བཛྲཞེས་བརྟན་པར་མོས་པ་མཛོད།",
    "ཇི་ལྟར་བལྟམས་པ་སོགས་ནས་མི་བསྐྱོད་པ་རེ་རེས་དབུ་བརྒྱན་པར་མོས།",
    "དེ་རྗེས་གནང་གི་གཞི་དགོད་པ་ཡིན།",
    "གསུང་གི་རྗེས་སུ་གནང་བའི་སླད་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "ཞལ་ནས་འཐོན་ཁྱེད་རང་གི་ཞལ་དུ་ཞུགས།",
    "ཐུགས་ཀའི་ཧཱུྃ་ཡིག་གི་མཐར་གཡས་སྐོར་དུ་འཁོད་པར་མོས་ནས་མེ་ཏོག་དང་བཅས་སྔགས་འདི་རྣམས་ཀྱི་རྗེས་ཟློས་ལན་གསུམ་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཡེ་ཤེས་ཀྱི་མགོན་པོར་གསལ་བ་ལ་ཕུལ་བར་མོས་ནས་སྔགས་འདི་རྣམས་ཀྱིས་རྗེས་ཟློས་ལན་གསུམ་མཛོད།",
    "གསུམ་པས་བརྟན་པར་མོས་ནས།",
    "བཅོམ་ལྡན་བདག་གིས་གཟུང་ལགས་ཀྱི།",
    "སྤྱི་བོར་མེ་ཏོག་བཞག་སྟེ་བྱིན་གྱིས་བརླབས་པར་མོས་པ་མཛོད།",
    "ཐོག་མར་ཕན་བདེ་བསྒྲུབ་པའི་ཕྱིར་དུ་ཁྱེད་རྣམས་ཀྱི་ཕྱག་གཡས་སུ་བེ་ཏའི་འབྲས་བུ་གཏད་དེ་རྗེས་སུ་གནང་བ་བྱིན་པར་མོས།",
    "དཔལ་ལྡན་ཁྱོད་ཀྱིས་གདུལ་བྱ་ལ།",
    "ཀ་པཱ་ལི་ནི་ཨ་མྲྀ་ཏ།",
    "འཆི་བདག་གི་སོགས་ནས་ཕྱག་གཡོན་པར་རྩེ་གསུམ།",
    "ཉོན་མོངས་བདུད་རྣམས་འཇོམས་བྱེད་པ།",
    "གདུག་པ་ཅན་རྣམས་བསྒྲལ་བར་བྱ་བའི་ཕྱིར་དུ་ཕྱག་གཡས་གཡོན་དུ་གྲི་གུག་དང་ཐོད་པ་བྱིན་ཏེ་རྗེས་སུ་གནང་བ་བྱིན་པར་མོས།",
    "རྡོ་རྗེ་འཆང་གི་བཀའ་བཞིན་སྒྲུབས།",
    "ཁྱེད་རང་གི་མགོ་བོའི་ནང་གང་བས་ལུས་ཀྱི་སྒྲིབ་པ་དག་སྐུ་ཡེ་ཤེས་ཀྱི་མགོན་པོ་དཀར་པོའི་ངོ་བོར་གྱུར་པར་མོས།",
    "མགྲིན་པའི་ནང་གང་བས་ངག་གི་དྲི་མ་དག་གསུང་ཡེ་ཤེས་ཀྱི་མགོན་པོ་དམར་པོའི་ངོ་བོར་གྱུར་པར་མོས།",
    "ལྟེ་བའི་ནང་ཡན་ཆད་གང་བས་ལུས་ངག་ཡིད་གསུམ་ཀྱི་དྲི་མ་དག་ཡོན་ཏན་ཡེ་ཤེས་ཀྱི་མགོན་པོ་སེར་པོའི་ངོ་བོར་གྱུར་པར་མོས།",
    "རྐང་མཐིལ་ཡན་ཆད་གང་བས་བག་ཆགས་དང་བཅས་པའི་དྲི་མ་མཐའ་དག་དག་ཕྲིན་ལས་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ལྗང་གུའི་ངོ་བོར་གྱུར་པར་མོས་ཏེ།",
    "བདེ་གཤེགས་ཕག་མོ་གྲུབ།",
    "སྟེང་གདོན་གཟའ་དང་དྲང་སྲོང་གི་གནོད་པའོག་གདོན་ཀླུ་དང་ས་བདག་གི་གནོད་པ་༴",
    "ཐེའུ་རང་གི་གནོད་པ་ཐམས་ཅད་ཞི་བ་དང་།",
    "ནང་གི་རྟོགས་པའི་ཡོན་ཏན་ཐམས་ཅད་གོང་ནས་གོང་དུ་འཕེལ་ཞིང་རྒྱས་པའི་འཕྲིན་ལས་མཛོད་ཅིགལྷ་འདྲེ་མི་གསུམ་གྱི་འགྲོ་བ་མང་པོ་ཞ།",
    "དེ་ཙམ་མ་གྲུབ་ན་ཟླ་བ་བྱུང་ངོ་ཅོག་གི་ཡར་ངོ་མར་ངོའི་ཚེས་བརྒྱད་གཉིས་དང་ཡར་ངོའི་བཅུ་བཞི་དང་།",
    "རང་གིས་མི་ཤེས་ན་གཞན་འབུལ་དུ་འཇུག་པ་ལ་བརྩོན་པར་བྱ་དགོས་པ་ཡིན་ནོ།",
    "རྒྱ་མཚོའི་ནང་གི་རྡོ་བ་བཞིན།",
    "རང་གི་གནས་རྣམས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེའི་སྟེང་དུ་ཨོཾ་ཧ།",
    "བཀའ་ལུང་ནན་ཆེན་པོས་རྒྱང་རིང་མོ་ནས་བསྐུལ་བའི་ངོར།",
    "གདུལ་བྱའི་རེ་བ་སྐོང་མཛད་པ།",
    "མཆོག་དང་ཐུན་མོང་ལོའམ་ཟླ་བ་ཙམ་གྱིས་འགྲུབ་པ།",
    "ཞག་བདུན་གི་བར་དུ་བརྒྱལ་བར་གྱུར་ཏོ།",
    "བར་དུ་གཅོད་པའི་དགྲ་བགེགས་ཐམས་ཅད་སྐད་ཅིག་གིས་བརླག་པར་བྱེད་པ།",
    "ཐུགས་ཀ་ནས་ཧཱུྃ་མཐིང་ནག་འཐོན་པ་ལས་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ཕྱག་དྲུག་པའི་སྐྱེ་འགྲོའི་རེ་བ་ཚུལ་བཞིན་དུ་སྐོང་བའི་ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟ་བུར་གྱུར་པ་དང་ས་རྣམ་པ་དྲུག་ཏུ་གཡོས་སོ།",
