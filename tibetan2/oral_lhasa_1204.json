    "ལུས་དང་ངག་མཉམ་པར་གཞག་ཅི་དགོས་ཤེ་ན།",
    "དེའི་དོན་སྒོ་གསུམ་མཉམ་པ་ཉིད་དུ་བཞག་པས་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་དེ་ལྟར་ཡིན་ཡང་ཀུན་རྫོབ་ཏུ་ཤེས་རབ་དང་ཡེ་ཤེས་ལ་ཁྱད་པར་ཆེ་བས་རྟོགས་ཚ་བ་ཆེ་ཆུང་ལ་ཁྱད་པར་ཡོད་པར་བསྟན་པ་དང་།",
    "སོ་སོ་མ་ཡིན་ཐ་མི་དད་པར་རྟོག་པ་མངོན་དུ་གྱུར་ནས།",
    "ད་ལྟར་དང་མ་འོངས་པའི་གདུལ་བྱ་གཞན་ཡང་ཕན་ཐོགས་པར་འགྱུར་དུ་འོང་ངོ་སྙམ་པའི་ཐུགས་རྗེ་ཆེན་པོར་བསྐྱེད་པ་མངོན་དུ་གྲུབ་པར་མཛད་པ་ལ་ནི་བྱིན་གྱིས་བརླབས་ནས་ཞེས་བྱ་སྟེ།",
    "གསང་བ་ཞེས་བགྱི་ཇི་ལྟར་ལགས།",
    "གྲུབ་པར་བྱེད་པའི་ཐབས་སུ་གྱུར་པའོ།",
    "སེམས་ཀྱི་དྲན་རྟོག་ཐམས་ཅད་ཏིང་ངེ་འཛིན་དུ་མཁྱེན་པ་ནི་ཐུགས་ཀྱི་གསང་བའོ།",
    "དེ་བཞིན་གཤེགས་པའི་མཛད་སྤྱོད་ཐམས་ཅད་དེར་འདུས་པ་དེའི་དོན་རྒྱུད་འདིར་འདུས་པར་བསྟན་པའོ།",
    "ཐུགས་རྣམས་པར་མི་རྟོག་པའི་ངང་ལས་མི་གཡོ་ཡང་ཏིང་ངེ་འཛིན་གྱི་སྒོ་མང་པོ་ལ་སྙོམས་པར་འཇུག་ཅིང་།",
    "རྣམ་པར་འཕྲུལ་པ་ཐ་དད་པར་སྟོན་པ་དང་།",
    "འདོད་ཆགས་ཆེན་པོའི་ཚུལ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་ཅིང་རྒྱུད་འདིའི་ལྷ་དང་དཀྱིལ་འཁོར་འཐོན་པར་མཛད་པ་ནི་ཐུགས་ཀྱི་གསང་བའོ།",
    "སྐུའི་སྤྱོད་པ་ཐ་དད་པར་སྣང་བ་དེ་དག་ཐམས་ཅད་དེའི་ཁྱད་པར་ལས་བྱུང་བའི་ཕྱིར་འདུས་ཀྱང་དེ་ཉིད་དུ་འདུས་སོ།",
    "རྒྱུད་དབུ་ཞབས་ཀྱི་སྤྱིའི་དོན་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "འདུས་པ་ཞེས་བྱ་འདུ་བར་གསུངས།",
    "བསྒྲུབ་པར་བྱ་བའི་ཐབས་ཀྱི་རྣམ་པ་མང་པོ་དང་།",
    "གཞན་ལས་ནི་ཕྱོགས་འགའ་ཙམ་སྟོན་པར་ཟད་ཀྱི།",
    "སྔོན་ཡང་འདུས་ད་ལྟར་ཡང་འདུས་ཕྱིས་ཀྱང་འདུས་པར་འགྱུར།",
    "དུས་གསུམ་མམ་དུས་བཞི་མཉམ་པ་ཉིད་དུ་དེ་བཞིན་རིག་པར་བྱ་སྟེ།",
    "འདུས་པ་ཞེས་བྱ་འདུ་བར་གསུངས།",
    "འདུས་པ་ཞེས་བྱ་བའི་དོན་ཡང་འདུ་བའམ་འུབ་པར་གསུངས་སོ།",
    "སྔར་རྩ་བའི་རྒྱུད་དུ་རྒྱས་པར་བཀྲོལ་བ་དག་ལ་ཚིག་དོན་མི་གསལ་བ་དག་རྟོགས་སླ་བར་བྱ་བའི་ཕྱིར།",
    "སྐབས་འདིར་ཡང་ཅུང་ཟད་བཀྲོལ་ཞིང་དབྱེ་བ་བྱས་པ་ཡིན་ནོ།",
    "རྒྱུད་ཀྱི་འབྲེལ་བ་ཇི་ལྟར་ལགས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དག་སྟེ།",
    "དུག་གསུམ་དངོས་སུ་སྤྱད་ཅིང་མ་སྤངས་པར་གྲོལ་ཞིང་ཐར་བར་འགྱུར་གྱི།",
    "སེམས་དེའི་ངོ་བོར་གནས་པ་ལས་གཞན་དུ་མི་འདའ་བ་ནི་ལེའུ་དགུ་པ་ལས་དོན་དམ་པར་རྟོགས་པའི་དམ་ཚིག་ལ་གནས་པ་དེ་ཡིན་ལ།",
    "རིགས་ལྔ་ཡེ་ཤེས་ལྔའི་ངང་དུ་རྣམ་པར་དག་པས་དུག་གསུམ་མ་སྤངས་པར་དངོས་སུ་སྤྱད་པས་འགྲུབ་པར་འགྱུར་བས་ན་དེའི་ཕྱིར་ན་དེ་གཉིས་འབྲེལ་ཏོ།",
    "དེ་ལ་སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ་གནས་པར་བསྟན་པ་དང་།",
    "ལེའུ་ལྔ་པར་གསུངས་པའི་མཚན་ཉིད་དང་ལྡན་པའི་རྣལ་འབྱོར་པས།",
    "ལེའུ་དགུ་པ་ལས་གསུངས་པའི་རིགས་ལྔའི་དམ་ཚིག་བསྲུང་ཞིང་དེ་ཁོ་ན་ཉིད་ཀྱི་དམ་ཚིག་ལ་གནས་པ་རྟོག་པའི་ཐེ་ཚོམ་བཅད་ནས་དུག་གསུམ་མ་སྤངས་པར་སྤྱད་པས་འགྲུབ་པར་ལྟ་བ་དེའི་ནང་དུ།",
    "དེའི་ཕྱིར་དགུ་པ་དང་བཅུ་བདུན་པར་འབྲེལ་ཏོ།",
    "དགྲ་རྨོངས་པར་བྱ་བ་དང་།",
    "ལྷ་དང་དྲག་པོའི་ལས་ཀྱི་དམིགས་པ་ལ་སོགས་པ་ཤེས་པར་བྱ་བ་ལ་བརྟེན་ན་གང་འདོད་པ་སྒྲུབ་པའི་བྱེ་བྲག་ཐམས་ཅད་ཀྱང་འགྲུབ་ལ།",
    "དེ་ལྟར་ལེའུ་ལྔ་པ་དང་དགུ་པར་འབྲེལ།",
    "དགུ་པ་དང་བཅུ་བདུན་པར་འབྲེལ།",
    "དེ་ལ་སྒྲུབ་པ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་གང་དང་གང་སྒྲུབ་པ་དེའི་རྒྱུའི་དོན་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་སྨོས་ཏེ་དེ་ལ་ལེའུ་བཅུ་གསུམ་པ་དང་བཞི་པར་འབྲེལ་ཏེ།",
    "དབྱིབས་སུ་ལྡན་པར་ཐིག་བཏབ་ནས་ལྷ་དགོད་པ་དང་།",
    "གདོད་འདོད་པའི་དངོས་གྲུབ་བསྒྲུབ་པར་བྱ་དགོས་པས་ན་དེའི་ཕྱིར་ན་དེ་ལྟར་འབྲེལ་ཏོ།",
    "ལེའུ་བཞི་པ་དེ་དང་བཅུ་དྲུག་པར་འབྲེལ་ཏེ།",
    "དེ་ལྟར་བསྒྲུབ་པའི་དུས་སུ་བཀྲེས་སྐོམ་གྱི་གནོད་པས་མི་ཚུགས་པར་བྱས་ལ་བསྒྲུབས་ན་འགྲུབ་པས་དེ་དག་སྟོན་པས་ན།",
    "ལེའུ་བཅུ་དྲུག་པ་དེ་དང་བརྒྱད་པར་འབྲེལ་ཏེ།",
    "ལེའུ་བརྒྱད་པ་དེ་བཞིན་དུ་བཅུ་གཉིས་པར་འབྲེལ་ཏེ།",
    "ལྕགས་ཀྱུ་རྣམ་པ་ལྔ་ལས་སྒྲུབ་པའི་ཁྱད་པར་དང་།",
    "གང་འདོད་པ་དེ་བསྒྲུབས་ན་འགྲུབ་པར་འགྱུར་བས་ན་དེའི་ཕྱིར་དེ་ལྟར་འབྲེལ་ཏོ།",
    "དྲུག་པ་དང་གཉིས་པར་འབྲེལ་ཏེ།",
    "དེའི་ངང་ལས་ཕྱག་རྒྱ་ཆེན་པོར་བསྐྱེད་ནས་སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་རྣམ་པ་གསུམ་དབྱེར་མེད་པར་བསྒོམས་ན་འགྲུབ་པར་འགྱུར་བས་ན་དེའི་ཕྱིར་དེ་ལྟར་འབྲེལ་ཏོ།",
    "གཉིས་པ་དང་ལེའུ་བཅོ་ལྔ་པར་འབྲེལ་ཏེ།",
    "དེ་ལྟར་བྱ་བ་ཡང་བསྙེན་སྒྲུབ་ཡན་ལག་བཞིའི་སྔགས་ཀྱིས་ལྷ་མཉེས་པར་བྱས་ནས།",
    "དྲག་པོ་དང་བརླང་བར་སྣང་བའི་ལས་བྱས་ཀྱང་སྒྲིབ་པའི་བག་ཆགས་སུ་མི་འགྱུར་ཞིང་ཇི་ལྟར་བཤམས་པའི་ལས་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་ཚོགས་སུ་གྱུར་པས་ན་དེའི་ཕྱིར་དེ་ལྟར་འབྲེལ་ཏོ།",
    "བཅོ་ལྔ་པ་དང་ལེའུ་བཅུ་བཞི་པར་འབྲེལ་ཏེ།",
    "དགུག་པའི་ཁྱད་པར་གྱི་རྣམ་པ་བརྒྱད་དགུག་པའི་ཐབས་དང་།",
