    "རྗོད་པར་བྱེད་པ་དང་།",
    "རྡུལ་དང་ཁུ་བ་དང་ཀུན་གཞིརྣམ་པར་ཤེས་པ་ཡང་དག་པར་སྦྱོར་བའི་ངོ་བོ་ཉིད་ཀྱིས་གནས་པ་༧ དང་།",
    "རྣམ་པར་ཤེས་པ་དྲུག་དང་།",
    "ལས་ཀྱི་རྣམ་པར་སཱིན་པས་འགྲོ་བ་དྲུག་ཏུ་སྐྱེ་བའི་ངོ་བོ་ཉིད་ཀྱིས་གནས་བ་དང་།",
    "ནམ་མཁའི་ཁམས་ལ་རི་རབ་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་བྱར་ཆུབ་སེམས་དཔའསེམསདཔའ་ཆེན་པོ་རྣམས་དང་ཐབས་ཅིག་ཏུ་བཞུགས་པའི་ངོ་བོ་ཉིད་ཀྱིས་གནས་པ་དང་།",
    "འདིར་སྟོན་པར་བྱེད་པའི་ལེའུའི་ཚོགས་རྒྱུད་ཀྱི་རྒྱལ་བོ་ནི་རྗོད་པར་བྱེད་པའོ།",
    "བརྗོད་པར་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་བུས་ཀྱི་འཁོར་ལོ་ལེའུལྔའི་ངོ་བོཉིད་ཀྱིས་ཞུགས་པ་ཡིན་ལ།",
    "རྫོད་པར་བྱེད་པ་ནི་དུས་ནི་འཁོར་ལོ་རྗོད་པར་བྱེད་པ་ལེའུལྔའི་བདག་ཉིད་དོ།",
    "རྗོད་པ་ར་བྱེད་པ་ནི་དང་པོའི་སངས་རྒྱ་ས་རྗོད་པར་བྱེད་པའོ།",
    "ལས་ཀྱི་མ་ཡིན་པར་སྐྱེས་པའི་ཕྱིར་རོ།",
    "བ་འདི་ལ་སྔར་མཚམས་མེད་པ་ལྔ་ལ་སོགས་པ་མིག་ཟད་པའྀ་ལས་གང་བྱས་པ་དེ་དག་སྔགས་ཀྱི་ཐག་པ་འདིར་ཕྱག་རྒྱ་ཆེན་པོ་མི་འགྱུར་བའི་བདེ་བའི་ཏང་ངེ་འཛིན་གྱིས་བཅོམ་ནས།",
    "དེའི་ཕྱིར་ཟ་བ་བོ་དང་གསོད་པ་པོ་དག་སྲོག་གཅོད་པར་འགྱུར་རོ།",
    "རྒྱུ་དེའི་ཕྱིར་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་མཚན་མ་མེད་པ་དང་ཁ་ན་མ་ཐོ་བ་མེད་པ་གོཀུལ་སོགས་པ་བཟའ་བར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "ཅད་རྣལ་འབྱོར་པས་བཟའ་བར་དེ་བཞིན་གཤེགས་པས་གསུངས་སོ།",
    "མཚན་མ་དང་བཅས་པའི་ཤ་བཟ་འོ་ཞེས་ནི་དེ་བཞིན་གཤེགམ་པས་ན་གསུངས་སོ།",
    "རྩ་བའི་རྒྱུད་ལས་ཀྱང་བཅོ་མ་ལྡན་འདས་ཀྱིས་གསུངས་པ་འདི་ལྟ་སྟེ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དང་།",
    "སྟོབས་བཅུ་དང་མི་འཇིགས་པ་ལ་སོགས་པའི་ཡོན་ཏན་རྣམ་པར་འབྱོར་པ་སྟེ།",
    "རིགས་མེད་པ་ཤེས་པ་དང་ཤེས་བྱ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་ཅིང་།",
    "རྡོ་རྗེ་སེང་གེའི་ཁྲི་ལ་བཞུགས་པ་ནི།",
    "དེ་ལ་བཞུགས་རྒྱུད་། པ་ནི་རྡོ་རྗེ་སེང་གེའི་ཁྲི་ལ་བཞུགས་པསྐུ་དང་གསུང་དང་ཐུགས་དང་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཝཾ་ཡིག་སྟེ།",
    "ཁམས་གསུམ་པས་ཞབས་ཀྱི་པདྨ་ལ་ཕྱག་བྱས་པ་ཞེས་པ་ལ།",
    "ཟླ་བ་བཟང་པོསགསོལ་བ་བཏབ་པར་གྱུར་པ་ཡིས་ཞེས་པནི།",
    "དེའི་ཡང་དག་པར་སྡུད་པ་པོ་ཡིན་པས་ན་བདག་པོ་སྟེ།",
    "དེ་ནས་གནོད་སྦྱིན་ཆེན་པོ་སེམསཅན་རྣམས་ལ་རྣམ་པར་ཐོ་འཚམ་ཞིང་བགེགས་དུ་མ་བྱེད་འགྲེལཔཔོ་དག་ཡོད་ལ།",
    "དེ་དག་གསོད་པར་བྱེད་པ་པོ་ནི་རོ་ལྡནན་གནས་པ་སྟེ།",
    "དུས་ཀྱི་འཁོར་ཞི་བརྗོད་བྱ་དུས་ཀྱི་འཁོར་ལོ་རྗོད་པར་བྱེད་པའི་ཕྱིར་དུས་ཀྱི་འཁོར་ལོའི་རྗོད་པར་བྱེད་དོ།",
    "བརྗོད་བྱ་རིགས་མེད་པ་བརྗོད་པར་བྱེད་པའི་ཕྱིར་ངོ།",
    "བརྗོད་པར་བྱ་བ་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་གྱི་རྒྱུད་ཀྱི་རྒྱལ་བོ་འདི་ལ་ཐབ་ས་དང་ཤེས་རབ་ཀྱི་ཕྱོགས་ཐ་དད་ན།",
    "ཐབ་ས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་གྱི་བརྗོད་པའྀ་བྱ་བ་མེད་པར་འགྱུར་རོ།",
    "ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ནི་དཅན་གྱི་བརྗོད་པར་བྱ་བ་མེད་ན།",
    "གཉིས་སུ་མེད་པའི་ཡི་ཤེས་མེད་པར་འགྱུར་རོ།",
    "འདིར་རྗོད་བར་བྱེད་པ་དང་བརྗོད་པར་བྱ་བའི་འབྲེལ་པ་མེད་པར་ཐབས་ཀྱི་མིང་ཅན་རྣལ་འབྱོར་གྱི་རྒྱུད་ལ་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་གཉིས་སུ་མེད་པ་དང་རྣལ་འབྱོར་བརྗོད་བཅུ་བྱ་རྗོད་བྱེད་ཀྱི་མཚན་ཉིད་དུ་མི་འགྱུར་རོ།",
    "རྣལ་འབྱོར་གྱི་སྒྲ་ནི་ཐབས་ཀྱི་དོན་རྗོད་པར་བྱེད་པ་འམ།",
    "ཤེས་རབ་ཀྱི་དོན་རྗོད་པར་བྱེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "རྣལ་འབྱོར་གྱི་སྒྲ་ནི་ཐབམ་དང་ཤེས་རབ་ཀྱི་དོན་རྗོད་པར་བྱེད་པའོ།",
    "དེའི་ཕྱིར་རྒྱུད་གང་ལ་ཐབས་དད་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཀྱི་བརྗོད་པར་བྱ་བ་ཡོད་པའི་རྒྱུད་དེ་ནི་དོན་དམ་པར་ཤེས་རབ་ཀྱི་ཆད་ཀྱང་མ་ཡིན་ལ།",
    "ཡང་ཡང་གསུངས་པ་གང་ཡིན་དང་།",
    "ཞེས་གསུངས་སོ།",
    "རྣམ་པ་གཞན་དུན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་རྡོ་རྗེ་འཛིན་པའི་ཡེ་ཤེས་ཀྱི་སྐུ་མངོན་དུ་གྱུརཔའི་མཚན་ཡང་དག་པར་བརྗོད་པས་འཁྱུད་པའོ།",
    "ཞེས་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་ཕྱིར་རོ།",
    "བཞི་པ་ནི་གསུམ་པ་མ་ཡིན་ཏེ་བཞི་པ་ཞེས་གསུངས་པའི་ཕྱིར་རོད་ཡང་དེ་བཞིན་འགྲུབདུ་ན་འོག་ནོ་ཞེས་གསུངས་བའི་ཕྱིར་ཤེས་རབ་ཡེ་ཤེས་དེ་ཉིད་བཞི་པར་འགྱུར་རོ།",
    "ཉི་མ་གཅིག་ནི་ཡོངས་སུ་བརྟག་ཅེས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་ལས་འདས་པའིབ་དེན་པན་དུབ་ལསོགས་པའིམཚན་མདང་རྣམ་པར་མི་རྟོག་པའི་སེམས་རྫོགས་པའི་རིམ་པས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་པའོ།",
    "རྫོགས་པའི་རིམ་པ་ནི་ལྷན་ཅིག་སྐྱེས་པརྣམ་པར་མི་རྟོག་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "དེའི་རྗོད་པར་བྱེད་པའོ།",
    "གྲགས་པ་འདིའི་རིག་ས་ལ་འཇིག་རྟེན་ད་བང་ཕྱུག་བདག་རིགས་ལྡན་གཉིས་པར་ལུང་བསྟན་ཏོ།",
    "དེའི་ཕྱིར་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་པ་རང་བཞིན་གྱིས་འོད་གསལ་བར་གསུངས་ཏེ།",
    "ཐམསཅད་མཁྱེན་པ་དེ་དུམ་ནིམ་ཡིན་ནོ།",
    "རིགས་བཞི་རིགས་གཅིག་བྱས་གང་དེ།",
    "གཞན་ལསཐོསཕྱིར་ཀུན་མཁྱེན་མིན།",
    "སྡུད་པར་བྱེད་པ་སྣ་ཚོགས་ཀྱིས།",
    "དོ་ཤལ་དང་དོ་ཤལ་བྱེད་པ་དང་ཡང་དག་པར་ལྡན་པ།",
    "དྲིལ་བུས་རྣམ་པརམཛེས་པའོ།",
    "དེ་བསན་ཁྱེད་ཀྱིས་ཡུལ་སྣ་ཚོགས་པ་གཞན་གྱིས་རིགས་དང་ལྡན་པའི་བྲམ་ཟེ་གང་ཡིན་པ་དེ་དག་ཐ་དད་དུ་བྱས་ཏེ་བདག་ལ་བསྟན་པར་བྱའོ།",
    "སྲོག་གཅོད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཀལཱ་པའི་གྲོང་ནས་ངེས་པར་བྱུང་བའི་ཚངས་པའི་དྲང་སྲོང་དེདག་ཐམས་ཅདཨོྃམ་བཅུཔ་ལ་ནགསཚལ་གྱི་ནང་དུརབ་ཏུ་ཞུགས་སོ།",
    "དྲག་པོའི་རིགས་ཐམས་ཅད་རྨོངས་བར་བྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིནལ་སྙོམས་པར་ཞུགས་སོ།",
    "ཏིང་ངེ་འཛིན་དང་ལྷ་ཡི་བྱིན་གྱིས་པ་རླབས་ཀྱི་དྲང་སྲོང་དེ་དག་ཐམས་ཅ་ད་ནགས་ཚལ་དེ་ཞི་དུརྨོངས་པར་གྱུར་བ་དང་།",
    "གྲོང་བྱེབ་བྱེ་བའི་བདག་པོ་རྣམས་ཀྱིས་ཞབས་ཀྱི་པདྨ་ལ་ཕྱག་བྱས་པ།",
    "རྒྱད་ཀྱི་རྒྱལ་པོ་འདིར་སྐྱོན་པ་པོ་ལ་སོགས་པ་རྣམས་བསྔ་བའི་དོན་དུ་ཚིགས་སུ་བཅད་པ་དང་པོ་འདི་བཅོམ་ལྡན་འདས་ཀྱིས་ཡངདག་པར་གསུངས་སོ།",
    "རྒྱད་ཀྱི་རྒྱལ་བོ་འདིབངས་རྒྱས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་མ་ཡིན་ནོ་ཞེས་མིང་དང་ཚིགལ་སྟོན་པ་ལ་བརྟེན་པ་འགའ་ཞིག་གཚིག།་",
    "སྡུད་པར་བྱེད་པ་བོ་རྣམས་ཀྱང་ཡུལ་སྣ་ཚོགས་ཀྱི་སྐད་གཞན་གྱིས་ཡང་དག་པར་སྡུད་བར་བྱེད་བའི་ཕྱིར་རོ།",
    "ཉི་ཚེ་བ་ལེགས་པར་སྦྱར་བའི་ཚིག་གཅིག་པུ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྟོན་པ་པོ་ཐམས་ཅད་མཁྱེན་པ་གཅིག་མ་ཡིན་ན།",
    "བཞུགས་པའིག་ནས་ངེས་པར་བསྟན་པ་གཅིག་མ་ཡིན་ནོ།",
    "འདི་སྐད་བདག་གས་ཐོས་པ་ལ་སོགས་པ་ལེགས་པར་སྦྱར་བའི་སྐད་ཅིག་། པུས་མ་ཡིན་ནོ།",
    "འདིར་དཔལ་འདུས་པར་བཅོམ་ལྡན་འདས་ཀྱིས།",
    "ཞེས་གནས་ངེས་པར་བསྟན་པ་ས་གསུངས་སོ།",
    "ད་བཞིན་དུརྩ་བའི་རྒྱུད་དང་བསྡུས་པའི་རྒྱུད་ཀྱི་རྒྱལ་པོ་གཞན་རྣམས་ལ་ཡང་བཞུགས་པའི་གནས་ངེས་པར་བསྟན་ཏོ།",
    "མི་བདག་གསོལ་བ་འདེབས་པར་བྱེད།",
    "དེ་བཞིན་༣ དུ་རྒྱུད་ཀྱི་རྒྱལ་པོ་གཞན་རྣམས་ལ་ཡང་གསོལ་བའདེབས་པརྣལ་འབྱོར་པས་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་དག་པའི་སེམས་ཀྱི་མིང་རྣམས་ཀྱི་ནང་ནས་ཝཾ་ཡིག་གཅིག་པུ་གཙོ་བོའི་མིངམ་ཡིན་ཏེ།",
    "ཡི་གེ་གཉིས་པོ་འདི་བཅོམ་ལྡན་འདས་ཀྱིསརྐན་ལ་སོགས་པསམ་གསུངས་པ་ཡངམ་ཡིན་ལ།",
    "པའདིའི་ངེས་པའི་དོན་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་འོག་ཏུ་རྣམ་པར་གཅད་པ་ཉིམ་དར་རྡུལ་ལོ།",
    "དེའི་འོག་ཏུ་ཨ་ཡིག་སྒྲ་གཅན་དང་རྣམ་འགྲེལཔར་ཤེས་པབདེ་བས་བྱིན་གྱིས་བརླབས་པའོ།",
    "དེའི་ཕྱིར་རྣམ་པར་བཅད་པ་ཉི་མ་དང་རྡུལ་ཨུ་ཉིད་ཐོབ་བར་གྱུར་པན་དོན་དམ་པའི་བདེན་པ་ལས་ཡོན་ཏན་མེད་དོ།",
    "རྣམ་པར་ཤས་པ་དང་ལྷན་ཅིག་ཝ་ཉིད་དོ།",
    "རྗེས་སུ་ང་རོ་ཟླ་བ་དང་ཁུ་བ་དད་ཡང་དག་པར་སྦྱར་ཏེ།",
    "ཨ་ཡིག་ཕ་རོལ་གྱི་ཨི་ཡིག་དང་ལྷན་ཅིག་ཡོན་ཏན་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "ཨེ་ཡིག་ནམ་མཁའི་ཁམས་རྟེན་འདིའི་དབུས་སུ་ཝཾ་ཡིག་རྣམ་པར་བཅད་པ་དང་།",
    "ཉིམ་དང་སྒྲ་གཅན་དང་ཟླ་བ་དང་རྡུལ་དང་ཀུན་གཞི་རྣམ་བར་ཤེས་པ་དང་ཁུ་བའི་བདག་ཉིད་རྟེན་པ་ཡིན་པར་ཕྱི་དང་ལུས་དང་གཞན་ལ་ཡང་རྟོགས་པར་བྱའོ།",
    "འདིར་རྩ་བའི་རྒྱུད་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "དེ་ཡང་བླམའི་མན་ངག་ལས་རྒྱུད་དང་རྒྱུད་གཞན་དུ་དགོངས་པའི་སྐད་ཀྱིས་རྟོགས་པར་བྱའོ།",
    "འདིརརྩ་བའི་རྒྱུད་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "རྣམ་པར་རྟོག་པ་དང་བྲལ་བའི་སེམས་སུ་བྱས་ནས་ཉི་མ་གཅིག་མཚན་མ་ཡོངསད་། སུ་བརྟག་པར་བྱའོ།",
    "གལ་ཏེ་རྒྱུད་ནས་གསུངས་པའི་ཆོ་ག་དང་།",
    "འདིར་དུ་བ་ལ་སོགས་པའི་མཚན་མ་བོར་ནས་གཞན་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་བསྒྲུབ་པའི་མཚན་མ་ཉི་མ་གཅིག་ཡོངས་སུ་བརྟག་པར་བྱ་བམ་ཡིན་པར་བཅོམ་ལྡན་འདས་ཀྱིསགསུད་སོ་ འདིར་རིགས་གསུམ་གྱི་བདག་ཉིད་ཀྱིརྒྱུད་ཀྱི་རྒྱལ་པོ་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་བདག་ཉིདཅན་ཞལ་གསུམ་པ་བརྗོད་པར་བྱ་བའོ།",
    "རིགས་བཞིའི་བདག་ཉིད་ལ་སྐུ་དང་གསུང་དང་ཐུགས་དང་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཅན་ཞལ་བཞི་པ་བརྗོད་པར་བྱ་བའོ།",
    "བརྗོད་པར་བྱ་བར་འགྱུར་རོ།",
    "འདིར་རིགས་བཞིའི་བདག་ཉིད་ཀྱི་རྒྱུད་ལ་རིགས་བཞིའི་བདག་ཉིད་བརྗོད་པར་བྱ་བ་སྟེ།",
    "འདིར་མཚན་ཡང་དག་པར་བརྗོད་པའི་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ལ་བསྟོད་པ་ལས།",
    "ཚིགས་སུ་བཅད་པ་སུམ་ཅུ་རྩ་གསུམ་པ་ལ་སོགས་པ་གསུམ་གྱི་རྡོ་རྗེའི་རྣལ་འབྱོར་གསལ་བར་དེ་བཞིན་གཤེགས་པས་གསུངས་པ་འདི་ལྟ་སྟེ།",
    "འགྱུར་མེད་མཆོག་སྟེ་རྣམ་པར་དག་ཅེས་སོ།",
    "བཅོམ་ལྡན་འདསཀྱི་གསུང་འདིའི་ཕྱིར་རིགས་བཞིའི་བདག་ཉིད་བརྗོད་པར་བྱ་སྟེ།",
    "ཚངས་པར་སྤྱོད་པའི་བརྟུལ་ཞུགས་མཆོག་ཅེས་སོ།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་འཇིགས་པར་བྱེད།",
    "རྒྱུད་དང་རྒྱུད་གཞན་དག་ཏུ་བརྗོད་པར་བྱ་བ་ནི།",
    "ཞལ་བརྒྱ་པར་རྟོགས་པར་བྱའོ།",
    "ལ་སོགས་པར་གསང་བ་ལསོགས་པའི་སྒྲ་ཡིས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཞེས་པ་ལ་སོགས་པའི་ཡི་གཞི་ཤ་རྩ་གསུམ་གྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་བསན་པ་ནི།",
    "སེང་གེའི་ཁྲི་དེ་ལ་བཞུགས་བནི།",
    "སེང་གེའི་ཁྲི་ལ་བཞུགས་པའོ།",
    "རྣལ་འབྱོར་ཞེས་པ་ནི་དོན་ཆེན་པོ་མཆོག་ཏུ་མི་འགྱུར་ཆ་བའོ་ རྣལ་འབྱོར་འདི་མཚན་ཡང་དག་པར་བརྗོད་པའི་རྡོརྗེདབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོལ་བསྟོད་པ་ལས་ཚིགས་སུ་བཅད་པ་བཅུ་བཞིས་ཡང་དག་པར་བརྗོད་པ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཞེས་པ་ལ་སོགས་པས་བསྟན་པ་ནི་དེ་བཞིན་གཤེགས་པས་གསུངས་པ་མ་ཡིན་ནོ།",
