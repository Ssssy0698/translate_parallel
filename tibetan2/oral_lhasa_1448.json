    "ཡང་ན་ཞལ་གཅིག་ཕྱག་བཞིའི་གཡས་གཉིས་རལ་གྲི་དང་ཤག་ཏི།",
    "མགྲིན་པར་ཨཱ་ལས་པདྨ་དམར་པོ་ཨཱ་ས་མཚན་པ།",
    "བ་ལིང་གཏོར་མ་བཞེས་མཛད་ནས།",
    "བཞེས་ནས་ཞི་རྒྱས་ལ་སོགས་པའི།",
    "འདིར་གཤེགས་མཆོད་སྤྲིན་བཞེས་མཛད་ནས།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་ཨོཾ་མ་ཧཱ་ཀཱ་ལ་ཏིཥྛ་བཛྲ་ཡེ་ཤེས་པ་དང་དམ་ཚིག་པ་གཉིས་སུ་མེད་པར་གྱུར།",
    "སྐུ་མཚན་དཔེ་དང་གསུང་ཡན་ལག་དྲུག་བཅུ་དང་ཐུགས་མ་འདྲེས་པ་བཅོ་བརྒྱད་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པར་གྱུར།",
    "སྣ་ཚོགས་བཟའ་བཏུང་བལྡག་པར་བཅས།",
    "གཡོན་རོལ་སྟབས་ཀྱིས་བཞུགས་ལ་བསྟོད།",
    "གཡས་གཉིས་རལ་གྲི་ཤག་ཏི་དང་།",
    "ཀླུ་རྒྱལ་རྣམས་ཀྱི་རྒྱན་དུ་བྱས།",
    "ཁྱད་པར་དུ་སྒྲུབ་རྒྱུད་ཡོངས་ཀྱི་རྩ་ལག་དཔལ་སྒམ་པོ་པའི་བསྟན་པ་དང་བསྟན་འཛིན་དང་བདག་ཅག་དཔོན་སློབ་ལ་གནོད་ཅིང་འཚེ་བ་བྱེད་པའི་དགྲ་བགེགས་རྣམས་ཀྱི་བསམ་སྦྱོར་ངན་པ་ཐམས་ཅད་ཞི་བར་མཛད་དུ་གསོལ།",
    "བསྡིག་ཅིང་སྤ་སྐོང་བ་ལ་སོགས་པའི་བཀའི་ཆད་པས་ཚར་གཅོད་པར་མཛད་དུ་གསོལ།",
    "བསྟན་པ་བསྲུང་བར་ཞལ་བཞེས་པ།",
    "བར་གྱི་གདོན་ཚོགས་འཇིགས་པར་བྱེད།",
    "ཆུ་རྣམས་སྐེམས་པར་ནུས་མ་སྟེ།",
    "ལྷ་ཆེན་སྐུ་ཡི་ཆེད་དུ་བཞུགས།",
    "ལྷ་དང་ལྷ་མིན་ཕྱག་བྱས་མ།",
    "དེ་ལ་འཇིགས་པ་མེད་པར་གྱུར།",
    "མི་བསྐྱོད་རྒྱལ་པོས་རྣམ་པར་མཛེས།",
    "བཞེས་ནས་སྔོན་ཚེ་ཁས་བླངས་པའི།",
    "ཐུགས་རྗེས་བཏང་སྙོམས་མ་མཛད་པར།",
    "མཆོད་གཏོར་རྒྱ་མཚོ་འདི་བཞེས་ལ།",
    "མཆོད་གཏོར་རྒྱ་ཆེན་འདི་བཞེས་ལ།",
    "མ་བསྐུལ་པར་ཡང་སྒྲོལ་བའི་ལས་མཁན་ཆེ།",
    "འབྲལ་བ་མེད་པར་རྟག་ཏུ་གྲོགས་མཛད་ཅིང་།",
    "རྒྱུན་གྱི་གཏོར་མསའཉམས་ཆགས་མ་ལུས་བཤགས་པའི་ཕྱིར།",
    "བཅོལ་བའི་ཕྲིན་ལས་གྲུབ་པར་མཛོད།",
    "ཅེས་སྒྲུབ་གསོལ་བྱས་ཏེ་བསྐང་གཏོར་ཟུར་པ་ཡོད་ན་གཙང་སར་བསྐྱལ་ལོ།",
    "རྩ་བ་ཡན་ལག་དམ་ཚིག་ཉམས་པ་བཤགས།",
    "མི་ཚིག་གཡེང་བས་བར་དུ་ཆོད་པ་བཤགས།",
    "ཞེས་ནོངས་པ་བཤགས་ལ་བྲིས་སྐུ་དང་རྟེན་གཏོར་ཡོད་ན།",
    "ཨོཾ་སུ་པྲ་ཏིཥྛ་བཛྲ་ཡེ་སྭཱ་ཧཱ་ཞེས་བརྟན་བཞུགས་དང་།",
    "དམ་ཚིག་པ་རྣམས་རང་ལ་ཐིམ་པར་གྱུར་ཞེས་བསྡུ།",
    "སོགས་ཀྱིས་གཤེགས་བསྡུ་བྱས་ལ་ཡི་དམ་གྱི་བཀྲ་ཤིས་ཅི་རིགས་དང་།",
    "ཅེས་བརྗོད་ལ་ལས་ཀྱི་རྗེས་ཅི་རིགས་པར་བསྡུ་བར་བྱའོ།",
    "མི་ཟད་སྤེལ་བྱེད་པར་འདི་ཡི།",
    "ལེགས་བྱས་རྟ་བདུན་རྒྱལ་པོ་ཡི།",
    "ཤུབྷཾ། ། མགོན་པོ་གྲི་གུག་ཅན་གཙོ་འཁོར་གསུམ་པའི་གཏོར་ཆེན་གྱི་ཕྲིན་ལས་བཞུགས་སོ།",
    "མངའ་གསོལ་བྱས་ཏེ་ཐུགས་དམ་བསྐང་བ།",
    "ཚོགས་མཆོད་བྱས་ལ་ཚོགས་ཕུད་ཕུལ་ཏེ་སྤྱི་བསྐང་བྱ་བ་རྣམས་གཞུང་ལྟར་བྱའོ།",
    "བམ་ཆེན་སྟེང་དུ་བརྐྱང་བསྐུམ་བཞུགས།",
    "བཅོལ་བའི་ཕྲིན་ལས་གྲུབ་པར་མཛོད།",
    "ལུས་ལ་མི་གཙང་པའི་རྒྱུན་འཛག་ཅིང་མཚོན་ཆས་བཏབ་པ།",
    "ཁྱད་པར་དཔལ་ལྡན་སྒམ་པོ་པའི་བསྟན་པ་དང་བསྟན་འཛིན་ལ་སྡང་དགྲ་བྱས་པ་ཕྱི་དགྲ་སེམས་པ་ད་དགྲ་བྱེད་པ་རྣམས་དང་།",
    "དེ་ཉིད་ལ་སྐྱོབ་པའི་ལྷ་སྲུང་ཐམས་ཅད་ཕྱེ་སྟེ་མགོན་སྐྱབས་དང་བྲལ་བར་བསམས་ལ་རྫས་ངན་གྱི་བདུག་པའམ་དེར་བསམ།",
    "གཙང་རིས་དཔལ་མགོན་ཐམས་ཅད་དང་།",
    "བསད་པར་བྱ་བའི་མཆོག་ཡིན་པས།",
    "རྣམ་སྨིན་ལུས་ལ་མ་བརྟེན་པར།",
    "གནས་བཅུ་རྣམས་སུ་གདབ་པར་བྱ།",
    "བཞེས་ཤིག་རོལ་ཅིག་ཁ་རཾ་ཁའི།",
    "མཆོད་སྦྱིན་གྱི་གཏོར་མ་རྒྱ་ཆེན་པོ་འདི་གཙང་རིས་ཀྱི་མགོན་པོ་བདུན་བཅུ་རྩ་ལྔ།",
    "གཙང་རིས་དཔལ་མགོན་ཐམས་ཅད་དང་།",
    "མཆོད་གཏོར་རྒྱ་ཆེན་འདི་བཞེས་ནས།",
    "དགྲ་དཔུང་མ་ལུས་རྔམ་པར་གསོལ།",
    "ཤ་ཁྲག་ཚོགས་རྣམས་ཚིམ་པར་གསོལ།",
    "ཤ་རུས་ཁྲག་ལ་རྔམ་པར་རོལ།",
    "བཞེས་ཤིག་རོལ་ཅིག་ཁ་རཾ་ཁའི།",
    "ཕྱོགས་མཚམས་ཀུན་དང་ཁྱད་པར་དང་ཕྱོགས་སུ་གསེར་སྐྱེམས་གཏོར་ལ།",
    "རྒྱ་མཚོ་ཡིན་ཡང་སྐེམས་པར་བྱེད།",
    "མེ་དཔུང་ཡིན་ཡང་འཇོམས་པར་བྱེད།",
    "གཙང་རིས་དཔལ་མགོན་མ་ལུས་དང་།",
    "དགྲ་བགེགས་མིང་ཡང་མེད་པར་བྱས།",
    "གཞན་ཡང་ལས་ཀྱི་རྗེས་རྣམས་ཅི་རིགས་པར་བསྡུའོ། གཏོར་ཆེན་གྱི་ཕྲིན་ལས་བསྡུས་ཏེ་བྱ་བར་འདོད་ན།",
    "བཀོད་པ་བཤམ་ཚུལ་རྣམས་སྐབས་སུ་གང་བབ་བྱས་ལ།",
    "དམག་ཆས་དང་དྲག་བསྐུལ་བྱས་ཏེ་ཟོར་ལམ་དབྱེ་བ།",
    "མི་ཟད་པར་དུ་སྒྲུབ་པའི་རྒྱུ།",
    "ཐོབ་ནས་ཉེས་པའི་དགྲ་རྣམས་ཕམ་བྱས་ཏེ།",
    "དེབ་ཉིས་བརྒྱ་དང་གོ་གཅིག་པ། ། སྒམ་པོའི་གདན་རབས་རིམ་གསུང་འབུམ་བཞུགས།",
    "པེ་ཅིན་ཀོང་དབྱི་པར་འདེབས་ཚད་ཡོད་ཀུང་སིས་དཔར་བཏབ།",
    "༢ ༡ ༣ ལོའི་ཟླ་༡ ༢ པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "༢༡༣ལོའི་ཟླ་༡༢པར་པར་ཐེངས་དང་པོ་བཏབ།",
    "༨༨ ༡༢༣་༡༣༢དཔར་གྲངས།",
    "༨༣། སྒམ་པོའི་གདན་རབས་རིམ་བྱོན་གྱི་གསུང་འབུམ་བཞུགས་སོ།",
