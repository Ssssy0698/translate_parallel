    "ཕུའུ་ཐོ་ཡ་ལ་སོགས་པའི་ཡིག་རིགས་སུ་བསྒྱུར་ནས་འགྲེམ་སྤེལ་བྱས་པ་རེད།",
    "དེ་གཉིས་ལ་འདྲ་ས་མེད་ནའང་བཙན་ཤེད་ཀྱིས་མིང་གི་འདོགས་སྟངས་ཤིག་དང་།",
    "དོན་དངོས་ལས་རེ་བ་བཞིན་འགྲུབ་པར་དཀའ་ངལ་མི་ཉུང་བ་ཞིག་དང་འཕྲད་པས་འུ་ཐུག་ཐབས་ཟད་ཀྱི་གནས་སུ་ལྷུང་འདུག་ལ།",
    "རང་ཉིད་ཀྱི་ལྟ་བ་དེ་ནུབ་ལུགས་དང་མ་གཅིག་ཚེ་རྒྱུད་རང་ངོས་ནས་ཞིབ་འཇུག་རྩད་གཅོད་བྱེད་པར་རང་ཚུགས་དང་ཡིད་ཆེས་ཅུང་ཞན་པར་འདུག་མོད།",
    "ང་ཚོས་དེ་ལ་མཉམ་འཇོག་མི་བྱ་ཐབས་མེད་ཡིན་སྙམ་ལ།",
    "ང་ཚོས་རྗེས་ཕྱོགས་ཁ་ཕྱོགས་འདི་ལྟ་བུ་ཞིག་ལ་བསམ་བློ་གཏོང་རྒྱུ་ཁ་ཚ་དགོས་གཏུགས་ཤིག་རེད་སྙམ།",
    "གང་ཞིག་ཚད་གཞིར་བཟུང་ནས་གང་ཞིག་ཚད་ལྡན་མ་རེད་ཅེས་འདོར་རྒྱུ་ཡིན་ནམ།",
    "རྒྱ་ཆེ་བའི་མང་ཚོགས་ཀྱིས་ཀྱང་གདེང་འཇོག་དང་དགའ་བསུ་ཆེན་པོ་བྱེད་ཀྱིན་ཡོད་མོད།",
    "བོད་རང་ལུགས་ཀྱི་རྩ་ཆུ་སོགས་ཀྱི་བརྟག་དཔྱད་བྱེད་ཐབས་ལས་གཞན་ནུབ་ལུགས་ཀྱི་བརྟག་ཆས་སོགས་ལའང་རང་བཞིན་གྱིས་གོམས་ལོབས་སུ་སོང་ཡོད་པ་རེད།",
    "རྣོ་དབྱུག་ཅི་རིགས་ཤིག་འཇོག་གིན་ཡོད་ལ་རུས་པ་འབྱོར་ནས་ལོ་གཅིག་ལྷག་ཙམ་ན་སླར་ཡང་ཤ་གཏིང་གི་རྣོ་ཐུར་སོགས་གཤགས་བཅོས་བྱས་ནས་ལེན་དགོས་པ་སོགས་ལ་མཚོན་ནའང་།",
    "རོང་འབྲོག་མི་མང་གིས་ཀྱང་བོད་རང་ལུགས་ཀྱི་རུས་ཆག་སྦྱོར་ཚུལ་ལ་དགའ་བསུ་ཆེན་པོ་བྱེད་ཀྱིན་ཡོད།",
    "ཐོག་མར་ཕྱུགས་ཟོག་གི་རུས་ཆག་ཤིན་ཏུ་མང་པོ་སྦྱོར་གྱིན་ཡོད་ལ།",
    "རེ་གཉིས་མཆིས་ཀྱང་རྒྱལ་ཁབ་ཀྱི་རིམ་པ་དང་པོའི་སྲུང་སྐྱོབ་ཀྱི་ཁོངས་སུ་གཏོགས་པས་ན།",
    "སྤྱིར་ན་ལོ་ཙཱའི་ཡོན་ཚད་བཟང་བ་ཧ་ཅང་ལེགས་མོད།",
    "ཡང་ན་བསྟུན་ཆོག་པ་རེ་འདུག་ན་ཚུར་ཐབས་མཁས་ཀྱིས་བསྡུ་ལེན་བྱས་ནའང་མི་ཆོག་པ་མེད་པར་སྙམ་པས།",
    "དེ་ནི་རང་མགོ་རང་གིས་གཡོག་པའི་བླུན་རྟགས་ཁོ་ན་ཞིག་རེད།",
    "དེ་ནི་དད་པ་ལ་རག་ལས་པ་རེད།",
    "ཤོག་དྲིལ་དེར་སྔགས་ཡིག་གི་བྱིན་བརླབས་ཞུགས་ནས་རྫས་སྣ་གང་དེའི་འཐུས་ཚབ་ཉན་ཐག་ཆོད་ཡིན་ཞེས་ཨུ་ཚུགས་བྱེད་ན་ཐང་མོད།",
    "རྫས་ཀྱི་ནུས་པ་བསམ་གྱིས་མི་ཁྱབ་པ་བཅས་བསམ་གྱིས་མི་ཁྱབ་པ་གསུམ་ལས་སྔགས་ནུས་ཁས་མ་བླངས་པ་མིན་མོད།",
    "ཕཊ་བརྗོད་པའི་ཚེ་བགེགས་རིགས་སྟོང་ཕྲུག་བརྒྱད་ཅུ་བོ་ཟློག་པར་ཐེ་ཚོམ་མེད་མོད།",
    "འོན་ཀྱང་ཁྱོད་ལ་སྒོམ་རྟོགས་པ་ཡོད་པ་ཕར་ཞོག་ཐ་ན་ཁ་ཏོན་དགེ་སྦྱོར་ཙམ་ཡང་མེད་པར་སྔགས་ནུས་བཙན་ཤུགས་ཀྱིས་ཐོན་དུ་རེ་བ་ནི་ཧ་ཅང་དགོད་བྲོ་བ་ཞིག་མིན་ནམ།",
    "དེ་ལྟར་བྱས་པ་ན་རང་གི་རྒྱུ་ནོར་རང་གིས་བེད་སྤྱོད་ཐུབ་པ་དང་།",
    "འུ་ཅག་གིས་རང་སྐལ་རང་གིས་བཅད་པ་ལས་ཅི་ཞིག་ཡོད།",
    "ཁོ་ཚོས་དེ་ལྟ་བུ་ཞིག་མངོན་གྱུར་འབྱུང་རྒྱུ་ནི་ད་དུང་དཀའ་མོད།",
    "བཞིན་མཉམ་འཇོག་བྱེད་དགོས་པ་དག་སྔ་མོ་ནས་གསལ་བོར་ཤེས་དགོས་པར་སྙམ།",
    "དེང་སྐབས་གསོ་དཔྱད་པ་ཕལ་བ་རྣམས་ཀྱིས་རང་གི་འཚོ་བའི་དགོས་མཁོ་དང་བསྟུན་ནས་ཆ་རྐྱེན་ལེགས་པོ་རེ་འཛོམས་ཆེད་ཅི་བྱེད་འདི་བྱེད་མེད་པར་ཁག་ཅི་ཡོད།",
    "རྩ་མི་ཤིང་མི་ཞིག་གིས་ཇི་ལྟར་ཧུར་ཐག་བགྱིས་ཀྱང་རྔོ་ཐོགས་ཐུབ་བམ།",
    "དུས་ཚིགས་རེར་དེབ་རེ་པར་དུ་སྐྲུན་གྱིན་ཡོད་ལ་ལོ་རེར་དེབ་བཞི་རེ་ཡོད་པས།",
    "བསམ་བློ་བརྗེ་རེས་སོགས་ཀྱི་རིན་ཐང་ཁུར་དུ་ལྕི་བ་ཤ་སྟག་འདུག་པས་ཀུན་གྱི་གསོས་སུ་སྨིན་པ་གོར་མ་ཆག་གཉིས།",
    "སྦྲུལ་ཤ་དང་རེ་ལྕག་ཆུ་རྩ།",
    "ད་དུང་ད་ལྟའི་གནས་བབ་ཀྱི་མི་འདང་བའི་ཞན་ཆ་ཐེར་འདོན་དང་འབྱུང་འགྱུར་དེའི་ཐད་ལ་ཐབས་ཤེས་གང་མང་བརྒྱུད་ནས་གྲུབ་འབྲས་གང་ལེགས་ལེན་དགོས་པའི་རེ་བ་ཡང་ལྷུག་པོར་སྤྲས་ཡོད་པ་རེད།",
    "དེ་ལ་མ་འོངས་ཞིབ་འཇུག་ཐད་ཀྱི་བསམ་གཞིགས་བཅས་མཛད་ནས་ཕྱིས་སུ་འདིའི་ཕྱོགས་ལ་དོ་སྣང་བྱ་དགོས་པའི་བློ་སྒོ་ཕྱེས་ཡོད་པ་རེད།",
    "སྤྱི་དང་བྱེ་བྲག་གི་དབྱེ་བ་བཅས་ཕྱེས་པའང་ཤིན་ཏུ་ཕྲ་ཚགས་ཡིན་པ་རེད།",
    "ཅེས་པ་ལྟ་བུའི་ཐུན་མོང་མ་ཡིན་པ་ཤིན་ཏུ་མང་ལ།",
    "མི་འགོར་བར་ཚིག་མཛོད་དེ་ཉིད་པར་དུ་བསྐྲུན་རྒྱུ་ནི་ཀུན་གྱི་རེ་བ་ཡིན་པ་སྨོས་མ་དགོས་སོ།",
    "དོན་ལྔ་སྣོད་དྲུག་གིས་མཚོན་པའི་དགོས་ངེས་ཀྱི་གསོན་གཟུགས་རོ་བཀྲ་སོགས་འོས་འཚམས་ཀྱིས་ཁ་གསབ་བྱས་པ་དང་།",
    "ཉལ་འཆག་འགྲོ་འདུག་གི་སྤྱོད་ལམ་བཅས་ལ་མཉམ་འཇོག་བྱེད་ཚུལ་གོ་སླ་ཞིང་ཚིག་ཉུང་བའི་སྒོ་ནས་སྨྲས་ཡོད་པ་ནི།"
  ]
}