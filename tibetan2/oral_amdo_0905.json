    "ཆེར་དུས་རྒྱུན་དུ་ཁ་ཟས་ཀྱི་སྤོད་དུ་བསྟེན་གྱིན་ཡོད་པ་རེད།",
    "འདི་ལྟ་བུའི་ས་ཆ་ཞིག་ནས་དེང་དུས་ཀྱི་ཟས་སྐོམ་གསར་བ་མང་པོ་ཅི་དགར་ལོངས་སུ་སྤྱད་ན་དེས་ལུས་ཁམས་བདེ་ཐང་གི་ཆ་ལ་གནོད་པ་གང་ཞིག་འབྱུང་མིན་ལ་བསམ་བློ་མི་གཏོང་ཀ་མེད་ཡིན་པ་རེད།",
    "སྔོན་དུས་བོད་ཀྱི་ཕ་མེས་ཡང་མེས་ཚོས་ཀྱང་མཐོ་སྒང་དུ་གནས་པའི་འབྲི་གཡག་གི་ཤ་དང་ལུག་ཤ་ར་ཤ་ད་དུང་རི་དྭགས་འབྲོང་དང་གཙོད་གནའ་བ་དགོ་བ་གཉན་བཅས་ཀྱི་ཤ་ཟ་བ་དང་།",
    "གྲང་ལྷགས་བཟོད་བསྲན་ཆེ་བས་མཚོ་བོད་མཐོ་སྒང་གི་མཁའ་དབུགས་དང་རན་པའི་འབྲུ་རིགས་ཤིག་ཡིན།",
    "ཀྲུང་གོའི་ཟས་རིགས་སྐྱུར་བསྙལ་བཟོ་ལས་ཞིབ་འཇུག་གླིང་གི་ཆེད་མཁས་ཀྱིས་ལོ་ངོ་གསུམ་གྱི་ཧུར་ཐག་འབད་བརྩོན་ལ་བརྟེན་ནས།",
    "འདྲེ་ཚེར་མ་བཅས་ཀྱི་ཕྱོགས་བསྡུས་སྔོག་འདོན་ཞིབ་འཇུག་གི་བྱ་གཞི་ལེགས་འགྲུབ་བྱུང་བ་དང་།",
    "སྒོར་དུང་ཕྱུར་༡བཏང་སྟེ་ལོ་རེར་ནས་དུང་ཕྱུར་༣དང་འདྲེ་ཚེར་མ་དུང་ཕྱུར་དང་།",
    "མཚོ་བོད་མཐོ་སྒང་གི་ས་བབ་མཐོ་བའི་རྐྱེན་གྱིས་འཛམ་གླིང་གི་བུལ་བའི་གཉན་འབྲས་གསུམ་དུ་གྲགས་པ་ལས།",
    "དེས་ན་ང་ཚོ་ཚང་མས་ཤེས་གསལ་ལྟར་མཚོ་བོད་མཐོ་སྒང་ནི་རྒྱ་མཚོའི་ངོས་ལས་ས་བབ་ཤིན་ཏུ་མཐོ་བ་དང་།",
    "དེའི་སྟེང་དུ་གྲུབ་ཆ་གཙོ་བོ་ངར་ལངས་རྫས་དང་ཁ་ཧྥེ་རྒྱུ་ཅན་གྱི་གླང་དམར་རྟགས་ཅན་གྱི་སྐོམ་ཆུ་འཐུང་ན་མེ་ཕུང་གི་ཁྲོད་དུ་རྡོ་སྣུམ་བླུགས་པ་ལྟ་བུའི་ངར་ཤུགས་ཇེ་ཆེར་སོང་ནས།",
    "མཚན་མོ་བཟའ་བཏུང་རིག་པ།",
    "དེ་དག་ས་བབ་ཀྱི་སྒོ་ནས་ཡུལ་གྲུ་འདིའི་མི་མང་གི་ལུས་ཀྱི་བདེ་ཐང་ལ་འཕྲོད་མིན་དཔྱད་རྒྱུ་ནི་ཧ་ཅང་གལ་ཆེའོ།",
    "དོན་གྱིས་རྒྱས་བསྡུས་དང་ཚིག་གི་རྗོད་སྟངས།",
    "དཔར་སྐྱོན་ཡིན་མིན་མི་ཤེས་མོད།",
    "དེ་དག་གི་རྒྱུ་རེ་རེ་བཞིན་བརྗོད་རྒྱུ་ནི་ཤིན་ཏུ་ཁག་པའི་ལས་ཤིག་ཡིན་མོད།",
    "དེ་ལ་གྲངས་དང་མིང་གི་ངེས་བསྟན་དཀོན་པ་ནི་ཀུན་གྱིས་ཤེས་གསལ་ལྟར་རེད།",
    "རང་གི་གྲིབ་མ་དེ་དང་མི་འབྲལ་བཞིན།",
    "རགས་ཞིབ་ཀྱི་དབྱེ་བ་ཅུང་ཡོད་པ་མ་གཏོགས་དགོངས་གཞིའི་གོ་དོན་འགལ་མེད་རེད།",
    "ཞེས་གསུངས་པ་དང་ཚིག་དོན་གཉིས་ཀྱི་ཆ་ནས་ངོ་འཕྲོད་པ་ཞིག་རེད།",
    "སྒྲུང་ལས་ཁྲོ་ཐུང་ཁོང་གི་ལས་ཀྱི་འདུ་བ་རྣམས་འཁྲུགས་པས།",
    "ཞེས་གླིང་ཁྲོ་ཐུང་གི་ལུས་ཀྱི་འདུ་བ་སྟེ་ཉེས་པའི་ཁམས་མ་སྙོམས་པ་འཁྲུགས་པའི་རྟགས་སུ་ལུས་སྟོད་སྨད་དུ་ཕྱེས་པའི་སྟོད་ལ་ཚ་བ་འབར་ཞིང་སྨད་ལ་གྲང་བ་རྒྱས་པར་བསྟན་པའང་རྒྱུད་ཀྱི་དགོངས་པ་དང་མཐུན་པ་རེད།",
    "རབ་ཀྱི་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་དང་།",
    "ཨྱོན་ཡུལ་སོགས་རང་རང་གི་བཞེད་ཚུལ་སྣ་ཚོགས་ཤིག་ལབ་ཀྱིན་ཡོད་ལ།",
    "ལྷོ་འཛམ་བུ་གླིང་གི་ཡུལ་གྲུ་འདིར།",
    "རང་རེ་ཁ་བ་རི་བའི་གནས་ཙ་རི་ཌ་ལ་བྱིན་གྱིས་བརླབས་པ་རེད་ཅེས་པ་ནི།",
    "གསར་གཏོད་དང་ཡར་ཐོན་གྱི་རང་བཞིན་ཡང་ལྡན་པ་རེད།",
    "རྩེ་མོ་ན་ཨ་རུ་ར་རྣམ་ལྔ་སྨིན་པ།",
    "ཞེས་ལྷོ་ཕྱོགས་རི་བོ་འབིགས་བྱེད་ཀྱི་རང་བྱུང་གི་བཀོད་པ་དང་།",
    "ཅུ་གང་གུར་གུམ་ལི་ཤི་དྲུག་གི་ནགས་ཚལ་བསིལ་དྲོད་སྙོམས་པར་ཡོད་པ་སོགས་རྒྱུད་དང་སྒྲུང་གཉིས་ཀ་རྩ་འགྲེལ་གྱི་ཚུལ་དུ་འདུག་རྒྱུད་ལས་བཟང་བོ་དྲུག་ཅེས་པ་ལས་རེ་རེ་བཞིན་གྲངས་འདྲེན་བྱས་མེད་མོད།",
    "ལི་ཤི་ལ་སོགས་ཞེས་གོང་གི་རྣམ་གྲངས་ཁ་གསབ་བྱས་ཡོད།",
    "སྤྱིར་སྒྲུང་ནི་ངལ་རྩོལ་མི་མང་གི་ངག་ཐོག་ནས་འཚོལ་སྡུད་དང་ལེགས་སྒྲིག་བྱས་པ་ཡིན་སྟབས་དེ་འདྲའི་ཞིབ་ཚགས་མིན་ཡང་།",
    "འདི་ལྟར་ན་ཧ་ཅང་ཁ་གསལ་གོ་བདེ་རེད།",
    "ཆུ་ཚན་རིགས་ལྔ་སོགས་སྒྲུང་གི་སྐབས་སུ་བསྡུས་ཟིན་ན་ཡང་།",
    "ཞིང་ལྟ་ན་སྡུག་གི་བཀོད་པ་རྫོགས།",
    "མགོ་ལྕོག་ལྡེམ་ཞེས་པ་སོགས་ཀྱི་ཚིག་རྒྱན་རེ་གཉིས་བཀོད་ཡོད་པ་དང་།",
    "སྤྱན་ཟུང་ཨུཏྤལ་མཐིང་གི་དཔལ་འཕྲོག་པ་ལས་འདོད་པའི་ཟུར་མིག་གཡོ་བ།",
    "མགོན་དགྲ་བཅོམ་སྟོང་གི་རང་བསྲེལ་ཟེར།",
    "ཐིགས་པ་འོག་གི་ས་རྡོ་ལ་དྲེག་པ་འཁར་བ་ལྟར་གོང་བུར་ཆགས་པས་རྡོ་གཞན་དང་གཞན་དག་འབྱར་བ།",
    "དེ་ལས་རིང་བསྲེལ་དང་འཕེལ་གདུང་ཞེས་པ་གཉིས་ནི་མིང་གི་འདོགས་ཚུལ་ཙམ་ལས་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཡིན་པ་ཤེས་ནུས་ལ།",
    "སྒྲུང་ཚིག་འདི་ནི་རྒྱུད་དོན་དང་མཐུན་པའི་གཏམ་ཁུངས་བཙུན་ཡིན་པ་མངོན་གསལ་རེད།",
    "དེ་ལས་ཐུར་དཔྱད་ཀྱི་འདས་སོང་ལ་ཕྱིར་དྲན་དང་འབྱུང་འགྱུར་ལ་རྒྱང་ལྟ།",
    "གནའ་དུས་ནས་བཟུང་བོད་ཀྱི་མེས་པོ་ཚོས་མཚོ་བོད་མཐོ་སྒང་གི་རི་ཐང་ནགས་བྲག་སོགས་ལ་གནས་འཆའ་ཞིང་གཞི་བཟུང་བ་དང་འབྲུ་རིགས་ཀྱི་ཁ་ཟས་ཞོར་དུ་འབྲོང་དང་།",
    "འཇིགས་ཉེན་བཟོ་བའི་མཐའ་འཁོར་གྱི་གཅན་གཟན་སྟག་གཟིག་དོམ་དྲེད་སོགས་ལའང་མདའ་རྡོ་གྲི་མདུང་གི་མཚོན་ཆ་སྣ་ཚོགས་ཀྱི་སྦྱོར་བ་སྤྱད་ནས་ཆམ་ལ་ཕབ་པ་སོགས།",
    "ལུས་བྱང་ཁོག་སྟོད་སྨད་ཀྱི་ཆ་གང་རུང་དུ་འཁེལ་བ་དེ་སྤྱིར་ན་ཕ་རོལ་བའི་སྲོག་གཅོད་འདོད་ཀྱི་བསམ་སྦྱོར་ངན་པ་ཡིན་མོད།",
    "རྗེས་སུ་ཀུན་གྱིས་མཉམ་འཇོག་བྱས་ནས་མཐའ་མ་དམག་འཁྲུག་གི་མྱོང་ཤེས་དེ་སོས་དལ་བའི་འཚོ་བའི་བརྒྱུད་རིམ་དུ་བསྡུ་ལེན་བགྱིས་ཏེ།",
    "བདེ་ཐང་གི་དགོས་མཁོར་གཞིགས་ནས་ཕན་ཚུན་ལ་ལག་ལེན་གྱི་ཚོད་ལྟ་གང་མང་བྱས་མཐར་དེ་ལུགས་ཀྱི་གྲུབ་འབྲས་གཡུར་དུ་ཟ་བ་ཐོབ་ཅིང་།",
    "ཕྱིས་མདའ་མདུང་གི་དབྱིབས་དང་རྣམ་པའི་བཟོ་སྟངས་ལ་བརྟག་ནས།",
    "རུས་འབིགས་ནི་ཕྲ་ལ་རྩེ་མོ་ཕྲ་ཞིང་རྣོ་བ་དང་ལྡན།",
    "རུས་སྦུག་སྟེ་རུས་ཐུར་སྦུབས་ཅན་ཡོད་པ་གསལ་བོར་བསྟན་ཡོད་པ་རེད་སྙམ།",
    "གནའ་སྔ་མོ་ལོ་ངོ་ཁྲི་ཕྲག་བཞི་ནས་ལྔ་ཙམ་གྱི་དུས་ན།",
    "སྟ་རེ།",
    "གཏར་ཀ་གཉིས་ཀྱང་སྔ་མོའི་རྡོ་ཆས་གསར་མའི་དུས་རབས་སུ་བྱུང་ཟིན་པ་དང་།",
