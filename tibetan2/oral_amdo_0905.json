    "དུག་ཅན་གྱི་འབྲུ་རིགས་འདི་དག་བསྟེན་ན་མིའི་ལུས་ཕུང་གི་བདེ་ཐང་ལ་མངོན་ལྐོག་གང་རུང་ནས་གནོད་པ་ཡིན་ཏེ།",
    "ད་ལྟ་འཚོ་བའི་ཆུ་ཚད་ཡར་རྒྱས་སུ་སོང་བ་དང་བསྟུན་ནས།",
    "རྫས་འགྱུར་ལུད་རྫས་ཁྲོད་ཀྱི་ཟེ་ཚྭའི་སྐྱུར་ཅན་གྱི་རྫས་རྣམས་མིའི་ལུས་ཕུང་གི་ལྷན་སྐྱེས་འབུ་ཕྲས་སྔར་གྱི་ཟེ་སྐྱུར་ཚྭ་ཕལ་བའི་ངོ་བོར་བསྒྱུར་ངེས་ཡིན་ལ།",
    "ལ་ཟས་བཅུད་ཆེ་ཞིང་ལུས་ཕུང་གི་བདེ་ཐང་ལ་ཤིན་ཏུ་ཕན་པ་ཡིན་པས།",
    "དེ་སྔ་དྭངས་གཙང་གི་ཞིང་ཁམས་སུ་སྨྲ་བའི་སའི་གོ་ལའི་སྣེ་གཉིས་ཏེ་བྱང་འཁྱགས་རོམ་རྒྱ་མཚོའི་འཁྱག་པའི་ཁྲོད་དང་།",
    "རྒན་པ་རྣམས་ཀྱིས་སྔོན་དུས་ཞིང་ནང་དུ་སྦྲུལ་མང་པོ་ཡོད་པས་ཞིང་འབྲེག་པ་དང་ཡུར་མ་ཡུར་དུས་སྐྲག་སྣང་སྟེར་བས་དེ་ལ་འཛེམས་དགོས་མོད།",
    "སྦྲུལ་གྱིས་ཞིང་ནང་གི་འབུ་སྲིན་ཟ་བ་ཡིན་པས།",
    "འབྲུ་རིགས་དང་སྔོ་ཚོད་སོགས་ལའང་དུག་གིས་གནོད་ཀྱིན་པ་ཤུགས་ལས་རྟོགས་ནུས་སོ།",
    "དེའི་ནང་ནས་མི་ཁྲི་༡ལྷག་གི་ཚེ་སྲོག་ཤོར་ཡོད་པ་རེད།",
    "མིག་ཆུ་འཛག་པ་དང་མིག་ལམ་རབ་རིབ་ཏུ་སོང་ཞིང་།",
    "མིག་གི་རྒྱལ་མོ་འདལ་བའམ་ཡང་ན་ཇེ་ཆུང་དུ་འགྲོ་བར་བྱེད།",
    "སྐད་འཛེར་བ་དང་གློ་ལུ་ཞིང་བྲང་ཁ་ན་ཞིང་དབུགས་འབྱིན་རྔུབ་བྱེད་དཀའ་བར་འགྱུར་བ་རེད།",
    "གྲོ་ནས་སྲན་གསུམ་སོགས་ལས་སྔོ་ཚོད་མང་པོ་མེད་མོད།",
    "ཞིབ་ཏུ་རྩད་གཅོད་མ་བྱས་པ་མ་གཏོགས་ཟས་རིགས་ཤིག་གི་དུག་རྐྱེན་ཞིག་མིན་པ་མི་སྲིད་དོ།",
    "ཐ་ན་དབུགས་འགགས་ནས་ཤི་བའང་ཡོད་པ་རེད།",
    "ཞིབ་ཏུ་ན་ཁོ་བོས་ཐང་ནག་གི་ཞིང་པའི་སིལ་ཏོག་ལ་རྒྱུས་ལོན་བྱས་པ་ལྟར་ན།",
    "འོན་ཀྱང་ཟོས་ན་བྲོ་བ་ནི་ནང་འདྲེན་བྱས་པའི་སིལ་གཞན་ལས་ལྡབ་འགྱུར་གྱིས་ཆེ་བ་ཞིག་རེད།",
    "སྔོ་ཚོད་དང་སིལ་ཏོག་གི་ཁ་དོག་གང་མཛེས་ན་མི་མང་ཤས་ཀྱིས་དེ་བཟང་བར་བརྩིས་ནས་ཉོ་བཞིན་ཡོད་མོད།",
    "ཁུར་མོང་རྒྱ་མ་༥ཡི་ནང་དུ་ཆུ་བརྒྱ་ཆའི་བསྣན་པ་དང་།",
    "འདི་དག་ཕལ་ཆེར་བོད་ཁམས་ཡོངས་ཀྱིས་དུས་རྒྱུན་དུ་ཁ་ཟས་ཀྱི་སྤྱོད་དུ་བསྟེན་གྱིན་ཡོད་པ་རེད།",
    "བོད་རོང་འབྲོག་མི་མང་གི་ལུས་ཀྱི་བདེ་ཐང་ལ་གནོད་པའང་རབ་དང་རིམ་པ་ཞིག་ཐེབས་དང་ཐེབས་ཀྱིན་ཡོད་པས།",
    "ང་ཚོས་དེ་དག་ལས་བྲོ་རྩི་ལྟ་བུ་རིགས་གཅིག་ཙམ་ལ་དཔེ་བླངས་ཏེ་སྨྲས་པ་ཙམ་གྱིས་ཀྱང་ཤེས་ནུས་པ་ཡིན།",
    "དེ་ལྟར་བྲོ་རྩི་འདི་ད་ལྟ་འབྲོག་པའི་སྦྲ་ནག་གི་ནང་འཛིན་ཏེ་ཡིག་འབྲུ་གཅིག་ཀྱང་མི་ཤེས་པའི་ཨ་ཆེ་འབྲོག་མོ་རྣམས་ཀྱིས་ཀྱང་ཐུག་པ་སོགས་ཀྱི་ནང་དུ་ཚད་གཞི་མེད་པར་གང་འདོད་དུ་འདེབས་ཀྱིན་ཡོད་པ་ཧ་ཅང་ཚབས་ཆེན་ཡིན་པ་རེད།",
    "ད་དུང་ལོ་ན་རྒན་པ་དང་བྱིས་པ་ཆེ་བ་དག་གིས་ཀྱང་ཉུང་ཙམ་ལས་བསྟེན་མི་རུང་བ་ཡིན།",
    "སེམས་རྩེ་གཅིག་ཏུ་མི་གནས་པ་སོགས་ཀྱི་གནོད་པའང་ཡོད་པ་རེད།",
    "དེ་དག་གི་མང་ཆེ་ཤོས་ནི་ཆེད་ལས་ཤེས་བྱ་མེད་པའི་མི་སྒེར་རྣམས་ཀྱིས་རྫུན་བཟོ་བྱས་པ་ཡིན་པས་ཤིན་ཏུ་ཉེན་ཁ་ཆེ།",
    "ཡིན་ན་ཡང་མགྱོགས་ཐུག་གི་ནང་དུ་མིའི་ལུས་ཕུང་གི་བདེ་ཐང་ལ་གནོད་པའི་རྫས་ངན་ཤིན་ཏུ་མང་པ་ཆེད་ལས་ཞིབ་འཇུག་པས་གསལ་པོར་སྨྲས་ཡོད་དེ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "ད་ལྟ་རུལ་འགོག་རྫས་དེ་ཕལ་ཆེར་གྱིས་མི་བླུགས་མོད།",
    "གལ་ཏེ་བྱི་བ་ཞིག་ལ་ཉིན་ཉེར་གཅིག་གི་རིང་ལ་མགྱོགས་ཐུག་བཟར་བཅུག་ན་དུག་གིས་འཆི་བར་འགྱུར་བ་ཡིན་ནོ།",
    "མི་ཇི་འདྲའི་མང་པོ་ཞིག་གི་ཚེ་སྲོག་སྟབས་བདེ་ཐུག་པས་སྟབས་བདེ་མོར་འཕྲོག་འགྲོ་བ་སུ་ཞིག་གིས་སྔོན་དཔག་བྱེད་ནུས།",
    "སྐོམ་ཆུ་གསར་བ་རྣམས་ལ་མིང་གསར་དུ་བཏགས་པ་ནི་ཤིན་ཏུ་ལེགས་མོད།",
    "དེ་དག་གི་ལྡོག་ཕྱོགས་ཀྱི་གནོད་པ་གང་ཞིག་ཡིན་པ་རྩ་བ་ནས་མ་རྟོགས་པར།",
    "བདུད་རྩི་ལྟ་བུ་ཞིག་གི་འདུ་ཤེས་བཟུང་ནས་བག་མེད་དུ་འཐུང་གིན་ཡོད་པ་རེད།",
    "དེ་དག་བཏུང་དྲགས་པ་ལས་ལུས་ཕུང་གི་བདེ་ཐང་ལ་གནོད་པ་ཤིན་ཏུ་མང་སྟེ།",
    "ཁུ་ནག་ལ་སོགས་པའི་མངར་ཆུའི་བཏུང་བ་དེ་རྣམས་འཐུང་བ་ན་ལུས་ཀྱི་ནང་གི་ཤིན་ཏུ་གལ་ཆེ་བའི་བཅུད་གཉིས་ཕྱིར་འབུད་པར་བྱེད་དེ།",
    "དམར་སྐོམ་ཆུ་འཐུང་བ་ན་དེའི་དགོང་མོར་གཉིད་མི་ཡོང་བས་དེ་འཐུང་དུས་མཉམ་འཇོག་བྱེད་བཞིན་ཡོད།",
    "མཚན་མོར་གཉིད་མི་ཉན་པའི་མིས་སྐོམ་ཆུ་འདི་འཐུང་ན་གཉིད་སྔོན་འགོག་བྱེད་ཐུབ།",
    "སྤྱིར་གླང་དམར་སྐོམ་ཆུ་ནི་མི་དར་མས་མ་གཏོགས་བྱིས་པས་འཐུང་མི་ཉན་མོད།",
    "ཧྥ་རན་སིས་རྐྱེན་དེ་ལ་བརྟེན་ནས་སྐོམ་ཆུ་འདི་འགོག་དགོས་པའི་བཀའ་ཕབ་པ་རེད།",
    "དབྱིན་ཇི་དང་ཏེན་མག་རྒྱལ་ཁབ་སོགས་ཀྱི་ཚན་རིག་པས་ཀྱང་དེ་དང་ཕྱོགས་མཚུངས་ཀྱི་ལྟ་ཚུལ་བརྗོད་པ་རེད།",
    "བོད་ཀྱི་སྲོལ་རྒྱུན་ཟས་རིགས་ནི་རྫས་འགྱུར་དང་དངོས་ལུགས་སོགས་ཀྱིས་མ་བསླད་པའི་རང་བྱུང་གི་ཐོན་དངོས་ཤ་སྟག་ཡིན་པས།",
    "དེ་དག་གི་ངོ་བོའི་ནུས་པ་དང་གཡོས་སྦྱོར་བྱས་པ་ལས་ཐོན་པའི་ཕན་ནུས་ཁོང་དུ་ཆུད་པར་བྱེད་པ་གཞིར་བཟའ་བཏུང་རིག་པ།",
    "བཞོས་ཐོག་འོ་མ་དྲོན་མོ་བདུད་རྩིར་མཚུངས།",
