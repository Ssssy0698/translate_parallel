    "གང་ཆེར་བགོ་མི་དགོས་པ་ལ་དེ་ལ་ཁས་བླང་པར་བྱའོ།",
    "རྒྱལ་པོའི་ཁབ་དང་ཉེ་བ་གཅིག་ཏུ་བྱས་ཏེ་རྗེས་སུ་གནང་བའོ།",
    "ནམ་མ་ལངས་པ་ལ་ནམ་ལངས་པར་འདུ་ཤེས་པ་རྣམ་པ་དྲུག་ཏུའོ།",
    "ནམ་མཁའ་ལྡིང་རྣམས་ཀྱི་སྒོ་གཏན་ལས་འདས་ན་ཉེས་བྱས་སོ།",
    "མངལ་ན་ཡོད་པ་ལས་མི་ཚངས་པར་སྤྱོད་པར་དོགས་པ་དང་།",
    "གསང་གྲགས་པར་དོགས་པ་དང་།",
    "གཞན་གྱི་ཡུལ་འཁོར་མ་རུང་བར་བྱེད་པར་དོགས་པའོ།",
    "གུས་པར་མི་བྱེད་ཅེས་བྱ་བ་ནི་བསྟན་པའོ།",
    "དྲན་པ་ཉམས་པར་གྱུར་ཏམ།",
    "གཉིད་ཀྱིས་ཀུན་ནས་དཀྲིས་པར་གྱུར་ཏམ།",
    "མ་ཐོས་པར་འགྱུར་ཏམ།",
    "ཁབ་རལ་ཞེས་བྱ་བ་ནི་ཁབ་རལ་གཉིས་རྗེས་སུ་གནང་སྟེ།",
    "མ་ཟིན་པར་བཏང་ན་ཉེས་བྱས་སོ།",
    "གཞན་གྱི་ཕྱིར་བྱེད་ན་ཡང་ཉེས་བྱས་སོ།",
    "བྱས་ཟིན་པ་རྙེད་པ་དང་།",
    "རྣམ་པ་གཞན་དུ་ཉེས་བྱས་ཉིད་དོ།",
    "ཁབ་རྣམ་པ་བཞི་རྗེས་སུ་གནང་སྟེ།",
    "ཁབ་རལ་ལེགས་པར་སྦ་བར་བྱ་བ་དང་།",
    "བསྙེན་པར་མ་རྫོགས་པའི་ལག་ཏུ་མི་སྦྱིན་ནོ།",
    "ཁབ་དང་གྲིའུ་བཙས་མི་ཟོས་པར་བྱ་བའི་ཕྱིར་རས་མ་ལ་སྤྲ་ཚིལ་གྱིས་བསྐུས་ལ་དཀྲི་བ་ཉིད་ཀྱིས་དར་གཞག་པར་བྱའོ།",
    "ཇི་སྐད་ཁབ་རལ་གྱི་གཞི་ལས་ངེས་པར་བསྟན་པ་བཞིན་དུ་ཡོ་བྱད་གཞན་རྣམས་ལ་ཡང་གནས་ཇི་ལྟ་བ་བཞིན་དུ་བརྟག་པར་བྱའོ།",
    "གསེར་ལ་སོགས་པའི་རང་བཞིན་ལས་བྱས་པའི་སོར་གདུབ་རྒྱ་བཅང་བར་མི་བྱའོ།",
    "མགོའི་ཐོད་པ་བྲིའོ་ཞེས་གསུངས་སོ།",
    "ཁྲུ་བཅུ་གཉིས་པའི་ལྕུག་མ་རྣམས་ལས་ཁྲི་བྱས་ཏེ།",
    "ནོར་བུའམ་བ་སོའི་རང་བཞིན་ལས་ལྷག་པར་བྱས་ན་ཉེས་བྱས་སོ།",
    "ཁྲིའི་རྩ་བ་བྲེ་ཁ་བཞིན་དུ་ཐད་ཀར་གཅད་པར་བྱའི་གཞོ་བོར་མི་གཅད་དོ།",
    "དེ་ལས་ཀྱང་ས་རྐོན་རྐང་པའི་རྟེན་གཞག་པར་བྱའོ།",
    "ཤིང་བལ་རུང་བས་གཡོགས་པར་སྦྱོར་བ་ནི་ཉེས་བྱས་སོ།",
    "གོས་སམ་ཤིང་བལ་མི་རུང་བས་གཡོགས་ན་ཉེས་བྱས་སོ།",
    "གདིང་བ་དུམ་བུ་གཅིག་པ་ལ་ནི་བྱིན་གྱིས་བརླབ་པར་མི་བྱའོ།",
    "ཚུར་བཙུག་ལག་ཤེར་བར་བྱས་ཏེ་དབྱུང་བར་བྱའོ་ཞེས་བཀའ་སྩལ་ན།",
    "དགེ་སློང་རྣམས་ཚད་ལས་འདས་པར་བྱེད་པས་ན་བརྒྱད་པ་བཅས་སོ།",
    "ཆུང་བ་ལ་ནི་བྱིན་གྱིས་བརླབས་ན་ཉེས་བྱས་སོ།",
    "གཞན་གྱི་ཕྱིར་བྱས་ན་ཉེས་བྱས་སོ།",
    "དབྱར་གྱི་གོས་རས་ཆེན་གནང་ངོ།",
    "དགེ་སློང་རྣམས་ཚད་དེ་ལས་འདས་པར་བྱེད་པས་ན་དགུ་པའོ།",
    "དེ་ལས་ཆུང་བ་ལ་བྱིན་གྱིས་བརླབས་ན་ཉེས་བྱས་སོ།",
    "ཁྲུ་ལྔ་ལས་ལྷག་པར་བྱེད་ན་ཉེས་བྱས་སོ།",
    "ཉི་ཤུ་པ་འདི་རྣམས་ལས་རྣམ་པ་གཉིས་ཀྱི་གཞི་རིག་པར་བྱ་སྟེ།",
    "འཁོར་ཡོངས་སུ་འཛིན་པར་བྱེད་པའི་གཞི་དང་།",
    "འཕེལ་བའི་གཏམ་རྣམ་པར་གཏན་ལ་དབབ་པའི་གཞི་དང་།",
    "འཇིག་རྟེན་པ་སྨོད་པར་བྱེད་ནས།",
    "དགེ་སློང་མ་ཞེས་བྱ་བ་ནི་བསྙེན་པར་རྫོགས་པ་རང་བཞིན་དུ་གནས་པའོ།",
    "དེ་རྣམས་ལས་གཞན་པ་རྣམས་ལ་ཡང་སོ་སོར་བཤགས་པར་བྱ་བ་ཡིན་ན་ཅིའི་ཕྱིར་དེ་ཉིད་ཁོ་ན་ལ་སོ་སོར་བཤགས་པར་ཞེས་གསུངས་ཤེ་ན།",
    "ཁྱད་པར་དང་ལྡན་པ་བསལ་བར་བྱེད་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་མ་ཐག་ཏུ་འདི་རིག་ཅིང་བཤགས་པར་བྱའོ།",
    "བཅབ་བར་མི་བྱའོ་ཞེས་བྱ་བ་འདི་ཡང་ཁྱད་པར་གཞན་བརྗོད་པའོ།",
    "ཁ་ཅིག་ནི་མང་པོ་རྣམས་ལས་ཀྱང་མང་པོ་རྣམས་ཀྱི་མདུན་དུ་བཤགས་པར་བྱའོ་ཞེས་ཟེར་རོ།",
    "ཁ་ཅིག་ནི་ལན་གཉིས་སུ་བཤགས་པར་བྱའོ་ཞེས་ཀྱང་ཟེར་རོ།",
    "ཉེ་དུ་མ་ཡིན་པ་ལ་ཉེ་དུ་མ་ཡིན་པར་འདུ་ཤེས་སམ།",
    "ཡིད་གཉིས་ཟ་ན་ཡང་རུང་སྟེ་བླངས་ན་སོ་སོར་བཤགས་པའོ།",
    "ཉེ་དུ་ལ་ཉེ་དུ་མ་ཡིན་པར་འདུ་ཤེས་སམ།",
    "ཡིད་གཉིས་ཟ་ན་ཡང་རུང་སྟེ་བླངས་ན་ཉེས་བྱས་སོ།",
    "དེས་ཀྱང་དེ་བཞིན་དུ་བྱས་པས་ན།",
    "ཟན་ཆད་པར་གྱུར་པའི་ཕྱིར།",
    "ཁྱིམ་གཞན་རྣམས་སུ་ཞེས་བྱ་བ་ནི་གང་ན་སྲང་ལ་སོགས་པ་ཡོད་པར་ཤེས་པ་ཡིན་ཏེ།",
    "དགེ་སློང་མ་ཞེས་བྱ་བ་ནི་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པ་རང་བཞིན་དུ་གནས་པའོ།",
    "ཡུད་ཙམ་ཞེས་བྱ་བ་ནི་འདིར་ནི་ཟན་ཟ་བའི་དུས་ལ་བྱའི་ཚད་འཛིན་པའི་ཡུད་ཙམ་ལ་ནི་མ་ཡིན་ཏེ་དེ་ཉིད་ཀྱི་ཕྱིར་གསུངས་པ།",
    "རྣམ་པ་གཞན་དུ་ན་ཉེས་བྱས་སོ།",
    "རྣམ་པ་གཞན་དུ་ན་ཉེས་བྱས་སོ།",
    "དམག་དཔོན་སེང་གེ་ཞེས་བྱ་བས་བདེན་པ་མཐོང་བ་རྒྱུན་དུ་གཏོང་བས་ན་ལོངས་སྤྱོད་ཡོངས་སུ་ཟད་པར་གྱུར་བས་ན།",
    "དེ་ཡང་ཀུན་དུ་སྤྱད་པ་བཅས་པ་ནི་བསོད་སྙོམས་ཡོངས་སུ་ལོངས་སྤྱད་པར་མི་བྱ།",
    "སྟན་ལ་སོགས་པ་ལ་ཡོངས་སུ་ལོངས་སྤྱད་པར་ནི་བྱའོ།",
    "སྔར་མ་བསྟབས་པར་ཞེས་བྱ་བ་ནི་གང་སྡོམ་པ་བྱིན་པའི་སྔོན་ལོགས་སུ་མགྲོན་དུ་བོས་པ་ཡིན་ཏེ།",
    "གནོད་སྦྱིན་མ་རུངས་པ་མེད་པ་དེར་གནས་པར་བྱའོ།",
    "དེ་ཡང་ནང་པར་སྔར་ལངས་ལ་ནགས་བརྟག་པར་བྱའོ།",
    "འདབ་མའི་ཆང་བུ་དག་ལམ་ཁར་གཞག་པར་བྱའོ།",
    "གང་སྦྱིན་པ་པོ་རྣམས་བག་ཡོད་པར་འོང་ངམ་ཡང་ན་མི་འོང་ངོ།",
    "དེའི་གྲོགས་ཤིག་ཀྱང་སྦྱིན་པར་བྱའོ།",
