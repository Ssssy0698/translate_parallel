    "ཁོང་པ་རང་ཤིན་ཏུ་གསུང་བར་བཞེད་པ་འདུག་པ་ལ།",
    "བོད་ཀྱི་གྲུབ་ཐོབ་ཏུ་བྱེད་པའི་རྟོགས་པ་བཟང་ཤོས་མཐར་ཐུག་པ་དེ་ཐུགས་ལ་འཁྲུངས་འདུག་ནའང་།",
    "བདེ་བ་ཅན་ན་ཁ་མཆུ་དང་འཁྲུག་ལོང་མང་དུ་འདུག་པས་ཀྱང་ཐུགས་སྐྱོ་བར་གྱུར་ཏེ།",
    "རྗེ་བཙུན་པ་ཁོང་རང་ལམ་འབྲས་སོགས་གསན་པའི་ངང་ནས།",
    "ལུང་ལེན་པའི་ཡུལ་ཡང་དཀའ་བར་བྱུང་འདུག་གོ།",
    "དེ་དུས་ཀྱི་གྲྭ་ས་རྣམས་ན་པོ་ཏི་གཞན་རྣམས་ཀྱི་གྲྭ་སྐོར་བྱེད་པའི་ལུགས་མ་དར་འདུག་པས་མ་བྱས་གསུང་ངོ།",
    "ཤིན་ཏུ་དག་པར་ཐུགས་ལ་ཆུད་འདུག་ཅིང་།",
    "སྒྲ་ཆེན་པོ་དཔག་ཏུ་མེད་པ་གྲག་པ་ཞིག་རྨིས་འདུག་སྟེ།",
    "འཕྲིན་ལས་རྒྱ་ཆེན་པོ་བྱུང་འདུག་པ་དེའི་ལྟས་ཡིན་པ་འདྲ།",
    "འདབ་མ་མ་རྙིངས་པ་ཡུ་བ་དང་བཅས་པ་ཞིག་འདུག།",
    "འདི་རྗེ་བཙུན་མ་སྒྲོལ་མའི་ཕྱག་མཚན་དུ་འདུག་པས་དེས་རྗེས་སུ་འཛིན་པའི་ལྟས་ཡིན་ནམ་དགོངས་པ་ན།",
    "འདི་ནས་ཀྱང་དེ་ཙམ་ཞིག་དུས་གཅིག་ཏུ་གསུང་འཚལ་ཞུས་པས།",
    "ཐུགས་ཡིད་གཉིས་ཟ་དགོས་པར་མི་གདའ།",
    "དེ་དུས་ཀྱང་འགྲེལ་ཆེན་གསུང་བའི་ལེའུ་དང་པོ་རྫོགས་པའི་མཚམས་ལ་འདུག་པས།",
    "བསྐྱེད་རིམ་དང་མཐུན་པས་བསྐྱེད་རིམ་ཡོངས་སུ་རྫོགས་པར་འོང་བར་འདུག།",
    "དེའི་སྐུ་མདུན་ན་རྗེའི་དྲུང་ནས་ཀྱང་བཞུགས་འདུག་པ་ལ།",
    "ཕྱིས་མཇལ་བ་ན་སྐུའི་རྣམ་པ་མནལ་ལམ་དུ་བྱུང་བ་དེ་ཉིད་རང་དུ་འདུག་གསུང་ངོ།",
    "ཞེས་གསུངས་པ་དེ་ལ་དཔྱད་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གོ།",
    "ཁྱེད་ཀྱི་འདི་རྣམ་དག་ཅིག་ཡིན་པ་འདུག་ཅེས་གསུང་།",
    "དེ་དུས་འབར་འཇིག་གཉིས་གྲགས་པ་ཆེ་བར་འདུག་པས་སུའི་དྲུང་དུ་ཕྱིན་པ་འཐད་ཞུས་པས།",
    "ཁོང་སྐྱོ་ཤས་ཅན་ཞིག་འདུག་པས།",
    "དེ་ལ་དགོངས་པར་འདུག།",
    "བལྟས་པ་ཙམ་ནས་འདིའི་དོན་འདིར་འདུག་སྙམ་པ་འབད་མེད་དུ་ལམ་ལམ་འཆར་བ།",
    "༣༤བ་རྫིང་ཇིའི་རབ་གནས་ལ་སྤྱན་འདྲེན་གྱིན་འདུག།",
    "ཅེས་གསུངས་པའི་ཚེས་གྲངས་དང་རབ་གནས་མཛད་པའི་ཚེས་གྲངས་གཉིས་ཕྱིས་བརྩིས་པས་མཐུན་པར་འདུག་གོ།",
    "༣ ༥ ན་འཁོར་ཕལ་ཆེས་ལ་ཚད་པ་འོང་ཞིང་མང་པོ་ཞིག་ཚེའི་དུས་བྱེད་པར་འདུག་ཟེར་བ་དང་།",
    "སྟོང་པ་ཉིད་ཀྱི་རྒྱས་མ་ཐེབས་པའི་སྣང་བ་རང་དགའ་བ་ཆེར་མི་འཆར་བར་འདུག།",
    "ཅི་བྱེད་བྱས་པས་མེའི་གནོད་པ་བསྲུང་བ་ཡིན་ཟེར་བ་ཞིག་རྨིས་འདུག།",
    "ལུགས་དེ་ཉིད་གཞིར་བྱས་པ་ལའང་རང་ཚིག་འགལ་བའི་ཉེས་པ་ལན་ཅིག་མ་ཡིན་པར་འབབ་པ་དག་མཐོང་བ་ལས་ན།",
    "གྲུབ་ཆེན་ཕལ་ཆེ་བ་དག་མཐུན་པ་ཉིད་དུ་ཡིད་ལ་བརྣགས་ཏེ་འདུག་གོ།",
    "བདག་ཅག་བཏང་སྙོམས་འདུག་པར་མི་རིགས་ཞེས།",
    "བསུ་མི་རྣམས་ཀྱང་རང་ལ་ཐིམ་པར་མཐོང་བས།",
    "གཅེས་སྤྲས་དང་གཙང་སྦྲ་ལ་བརྩོན་པ་སོགས་རང་ཤགས་ཀྱིས་བྱུང་འདུག།",
    "ཁྱེད་ཀྱི་བུར་འདུག་པ་ཐིགས་པ་ཡིན་གསུང་བ་ལ་སོགས་པའི་གསང་བའི་གནས་དུ་མ་གསུངས་ནས།",
    "ཤེས་རབ་བསྐྱེད་པའི་ལྷ་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན།",
    "བློ་བསྐྱེད་ཆེ་བར་བྱུང་ཞེས་གླེང་བ་ཡང་མང་བར་འདུག་གོ།",
    "མྱུར་དུ་རྗེས་སུ་འཛིན་པར་འདུག་གསུངས་ནས།",
    "ཁོང་རང་ལ་མངའ་བའི་ལུང་མན་ངག་རྣམས་དང་།",
    "ཨ་ར་པ་ཙ་ན་བདུན་སྟོང་།",
    "ཨ་ར་པ་ཙ་ནའི་སྔགས་ཀྱི་སྒྲ་འུར་འུར་བ་འོང་ཞིང་།",
    "ཕྱིན་ཅི་ལོག་ཏུ་བཟུང་ན་གོལ་ས་དང་ཉེས་དམིགས་གཞན་ལས་ཀྱང་ཆེ་བར་འཕགས་པ་ཡབ་སྲས་ཀྱིས་གསུངས་འདུག་པས།",
    "གང་དུའང་བཟུང་མི་ཉན་པར་ལྟ་བ་དེ་ཐུགས་ལ་བདེ་བ་ཙམ་ཡོད་པར་འདུག་གོ།",
    "མི་གོ་བ་འདུག་ལགས་ཞུས་པས།",
    "ངས་ད་ལྟ་ས་བོན་བཏབ་པ་འདི་རྣམས་ཀྱིས་ཀྱང་རྐྱེན་བྱས་ནས་ལེགས་པར་གོ་བ་ཞིག་མྱུར་དུ་འོང་བར་འདུག་ཅེས་གསུང་ངོ།",
    "ཉམས་སྣང་རང་དགའ་བ་མིན་པས་གསོལ་བ་དྲག་པོ་ཐོབ།",
    "དེའི་དུས་ངོ་མཁྱེན་པ་དང་མི་མཁྱེན་པའི་འཁོར་དུ་མ་ཁ་གདངས་ནས་བཟེད་འདུག་པས།",
    "ཧཱུྃ་བཛྲ་ཞེས་པའི་སྔགས་དང་ཕྱག་རྒྱས་ལན་གསུམ་དུ་དབུའི་སྟེང་དུ་བཏེག་ཁ་སང་ནུབ་སྔ་མ་ལ་བུམ་པ་ཆུས་བཀང་བ་སྟེར་རྩིས་བྱེད་པའང་འདིའི་ལྟས་ཡིན་པར་འདུག་དགོངས་པ་བྱུང་ངོ།",
    "དེའི་འོག་ན་ཤིད་ཟན་གཏོང་བ་ཡིན་ཟེར་བའི་ཡི་གེ་ཞིག་བྲིས་འདུག།",
    "དེའི་སྟོབས་ཀྱིས་བར་ཆད་ཀྱི་མཚན་མ་དེ་ཡང་མྱུར་དུ་ཞི་འགྲོ་བ་ཞིག་འདུག།",
    "མཆོད་རྟེན་དེའི་དྲུང་ན་དེའི་སེང་ཁྲི་དང་མཉམ་པའི་མཆོད་རྟེན་དྲུག་འདུག་པ་ལ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡང་དག་མཐའ་མངོན་དུ་བྱེད་ཚུལ་དཔྱིས་ཕྱིན་པ་ཞིག་གོ་བ་སྔགས་ཀྱི་སྤྱོད་པའི་སྐབས་ཤིག་ལེགས་པར་གོ་བ་ལ་རག་ལས་འདུག།",
    "གཏོར་མ་སྟེར་དགོས་པ་འདུག།",
    "གཏོར་མ་བྱས་ན་དབྱངས་ཀྱི་ང་རོ་བྱས་པའི་ཚེ་དགའ་བའི་རྣམ་འགྱུར་སྣ་ཚོགས་བྱེད་པ་འདུག།",
    "རང་རང་སྐུ་ཡི་དབྱིབས་དང་ཕྱག་མཚན་སོགས།",
    "རང་རང་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཡི།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
