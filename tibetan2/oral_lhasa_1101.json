    "དེ་ནས་མཉམ་པར་མ་གཞག་པ་འདོད་སེམས་ལ།",
    "དེ་ནས་མཉམ་པར་མ་གཞག་པ་འདོད་སེམས་ལ་སྙོམས་པར་འཇུག་པའི་ཕྱིར།",
    "མཐོང་ལམ་ལ་ལྟོས་ཏེ་བྱུང་བ་འགགས་པ་ཉིད་ཀྱིས་སྦྱོར་བའི་ལམ་གྱི་ཡོན་ཏན་དོན་དམ་པར་མེད་ཅིང་ཐ་སྙད་དུ་ཡོད་པ་ལ་འཇུག་བྱར་ཞེས་སོགས་སྔ་མ་བཞིན་དང་།",
    "ཡང་དག་པར་མཐའ་བཞིར་སྐྱེ་བའི་རྒྱུ་དང་མི་ལྡན་པས་མཐོང་བའི་ལམ་གྱི་ཡོན་ཏན་དོན་དམ་པར་མེད་ཅིང་ཐ་སྙད་དུ་ཡོད་པ་ལ་འཇུག་བྱར་ཞེས་སོགས་སྔ་མ་བཞིན་དང་།",
    "གཙང་བདེ་རྟག་བདག་ཏུ་འཛིན་པའི་ཕྱིན་ཅི་ལོག་ཞི་བ་ཉིད་ལ་སོགས་པས་མྱ་ངན་ལས་འདས་པར་སྦྱོར་བའི་ལམ་ལ་འཇུག་བྱར་ཞེས་སོགས་སྔ་མ་བཞིན་དང་།",
    "དང་པོ་ནི་དེ་ལྟར་གཟུང་རྟོག་དང་པོ་བསྟན་ནས་གཟུང་བའི་རྣམ་པར་རྟོག་པ་གཉིས་པ་འཆད།",
    "འཛིན་པའི་རྣམ་པར་རྟོག་པ་དང་པོ་དེ་འཆད།",
    "སྤྱོད་པ་རྣམ་པར་འཁྲུགས་པ་ལ།",
    "འཛིན་པར་བྱེད་པ་དང་པོར་དེ།",
    "ཤེས་པར་བྱ་བ་བསྒྲགས་པ་ཡིན།",
    "དེ་ལྟར་འཛིན་རྟོག་དང་པོ་བསྟན་ནས་འཛིན་པའི་རྣམ་པར་རྟོག་པ་གཉིས་པ་འཆད།",
    "དེ་དགུ་སྒོམ་ལམ་རྩེ་སྦྱོར་གྱིས་ཡང་དག་པར་སྤང་བར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "བདག་ཉིད་ཇི་བཞིན་ཀུན་མཁྱེན་ནི།",
    "མཚུངས་པར་ལྡན་དང་མི་ལྡན་དང་།",
    "རྣམ་པར་རྟོག་པ་ཐ་མར་བཞེད།",
    "མཁྱེན་པ་གསུམ་ལ་རྨོངས་པའི་སྒྲིབ་པ་ལ་སྐྱེས་བུར་བཏགས་པར་འཛིན་པ་ལ་ལོངས་སྤྱོད་བྱེད་དུ་བདེན་པར་ཞེན་པའི་རྟོག་པ་སོགས་དགུ་ཡོད་པའི་ཕྱིར།",
    "དགུ་པོ་ལམ་དེས་དངོས་སུ་གཞོམ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "རྣམ་པ་ཐམས་ཅད་བདེན་སྟོང་དུ་ཡོངས་སུ་མ་ཤེས་པས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སྒྲིབ་པ་སྤོང་བ་ལ་ཀུན་ཏུ་རྨོངས་པ་ལ་སྐྱེས་བུར་བཏགས་པར་འཛིན་པ་ལ་དམིགས་ནས་ལོངས་སྤྱོད་བྱེད་དུ་བདེན་པར་ཞེན་པའི་བདེན་འཛིན་དང་།",
    "དེ་བཞིན་ཉིད་ལ་སོགས་པ་དང་གཟུགས་ལ་སོགས་པ་མཚུངས་པར་ལྡན་པ་སྟེ་དེ་གཉིས་ངོ་བོ་གཅིག་དང་།",
    "གཟུང་བ་དང་འཛིན་པའི་མཚན་ཉིད་རྫས་གཞན་གྱིས་སྟོང་པར་ཡོངས་སུ་མ་ཤེས་པས་གཟུང་འཛིན་གཉིས་སུ་མེད་པ་ལ་ཀུན་ཏུ་རྨོངས་པ་ལ་སྐྱེས་བུར་བཏགས་པར་འཛིན་པའི་འཛིན་པ་ལ་དམིགས་ནས་ལོངས་སྤྱོད་བྱེད་དུ་བདེན་པར་ཞེན་པའི་བདེན་འཛིན་རྟོག་པ་རྣམས་སུ་ཡོད་པའི་ཕྱིར།",
    "རྣམ་པར་རྟོག་པ་བཞིའི་གཉེན་པོ་རྣམ་པ་བཞི་ཡང་དེའི་དབྱེ་བས་ཐ་དད་དོ་ཞེས་བྱ་བར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "རྣམ་པ་ཀུན་ཏུ་རྟེན་པར་བྱེད།",
    "རྣམ་པ་ཀུན་ཏུ་འགྲོ་བ་ཡི་བདེ་བ་སྒྲུབ་པའི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་ཀུན་རྒྱ་མཚོ་ཆེ་ལ་ཆུ་བོ་བཞིན་དུ་རྣམ་པ་ཀུན་ཏུ་བསྟེན་པར་བྱེད་དེ།",
    "དེ་ནི་རྣམ་པ་ཀུན་མཁྱེན་ཉིད།",
    "བར་སྐབས་ཀྱི་ཚིགས་སུ་བཅད་པས་དམིགས་པ་ལ་སོགས་པ་གསུངས།",
    "དེའི་བདག་པོའི་རྐྱེན་ཡིན་པར་བཞེད་དེ།",
    "བདེན་གཉིས་རྣམ་པར་འབྱེད་པའི་བློའི་ནོར་ཅན་རྣམས་ཀྱིས་དང་པོར་ལོག་པར་རྟོག་པ་ཇི་ལྟ་བུ་ཞིག་བསལ་བས་ཏིང་ངེ་འཛིན་དེ་བསྐྱེད་པར་བྱ་སྙམ་དུ་དོགས་པ་བཅད་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "རྣམ་ཀུན་མཁྱེན་ཉིད་ཡེ་ཤེས་དང་།",
    "རྣམ་པ་ཀུན་མཁྱེན་ཉིད་རྟེན་ཅན།",
    "དེ་བསལ་ནས་བར་ཆད་མེད་པའི་རྩེ་སྦྱོར་བསྐྱེད་པར་གདམས་པའོ་ དང་པོ་ནི།",
    "ལེགས་པར་བརྟགས་ན་ཐེ་ཚོམ་གྱི་ངོ་བོ་ཉིད་ལས་མ་འདས་པའི་ཕྱིར་ཏེ།",
    "རྣམ་མཁྱེན་གྱི་དམིགས་པ་དང་བདེན་སྟོང་མི་འགལ་བ་བཞིན་དུ་ཕན་ཚུན་འགལ་བའི་དོན་བསྒྲུབས་པས།",
    "དེ་གཉིས་གཞི་མཐུན་དུ་འདུ་བ་མི་འཐད་པར་བསམ་པ་ཉིད་ཀྱིས་ཕྱིན་ཅི་ལོག་ཏུ་རྟོག་པའི་བློ་ཡིན་པའི་ཕྱིར།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་ཁམས་དག་བདེན་པའི་དངོས་པོར་མེད་པ་ཉིད་ཀྱིས་ཕྱིར།",
    "ཞེས་དམིགས་པ་ལ་ལོག་པར་རྟོག་པ།",
    "ཞེས་རྣམ་པ་ལ་ལོག་པར་རྟོག་པ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པ་དོན་དམ་པར་མི་དམིགས་པའི་ཕྱིར་ཞེས་འབྲས་བུ་ལ་ལོག་པར་རྟོག་པ།",
    "ཞེས་བདེན་གཉིས་ལ་ལོག་པར་རྟོག་པ་གཉིས།",
    "སྦྱིན་པ་ལ་སོགས་པ་དོན་དམ་པར་མི་དམིགས་པའི་ཕྱིར་ཞེས་སྤྱོད་པའི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ།",
    "ཤེས་བྱ་ལ་བློ་རྒྱས་པའི་རྟོགས་པར་བྱ་བ་དོན་དམ་པར་མེད་པའི་ཕྱིར།",
    "གདགས་གཞི་གཟུགས་ལ་སོགས་པ་དོན་དམ་པར་དམིགས་པ་བཀག་པའི་ཕྱིར།",
    "སྦྱིན་པ་ལ་སོགས་པ་དོན་དམ་པར་མི་དམིགས་པའི་ཕྱིར།",
    "ཞེས་སྤྱོད་པའི་ཁྱད་པར་ལ་ལོག་པར་རྟོག་པ།",
    "རྟོགས་བྱ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་གཉིས་ཀའི་ངོ་བོ་དོན་དམ་པར་རྟོགས་པ་བཀག་པའི་ཕྱིར།",
    "ཞེས་མངོན་རྟོགས་ལ་ལོག་པར་རྟོག་པ།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པ་ཉིད་ཀྱིས་སྤྲོས་པ་རྣམ་པར་བཞག་པ་དོན་དམ་པར་མེད་པའི་ཕྱིར།",
    "ཞེས་སྤང་བྱ་ལ་ལོག་པར་རྟོག་པ།",
    "ཞེས་ལམ་གྱི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ།",
    "དོར་བར་བྱ་བ་དང་བླང་བར་བྱ་བ་དོན་དམར་པར་མེད་པའི་ཕྱིར།",
    "ཞེས་སྤང་གཉེན་གྱི་རྣམ་དབྱེ་ལ་ལོག་པར་རྟོག་པ།",
    "བསྒོམ་བྱ་རང་དང་སྤྱིའི་མཚན་ཉིད་དོན་དམ་པར་མི་འཐད་པའི་ཕྱིར།",
    "གཉིས་པ་དེ་བསལ་ནས་བར་ཆད་མེད་པའི་རྩེ་སྦྱོར་བསྐྱེད་པར་གདམས་པ་ནི།",
