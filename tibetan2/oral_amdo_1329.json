    "ཁོས་ཀྱང་ད་ནི་ཚད་རེད་སྙམ་སྟེ་སྒོར་མོ་དག་འགྱིག་སྒམ་ཆེན་པོ་ཞིག་གི་ནང་དུ་བཅུག་ནས་འགྲོ་རྩིས་བྱེད་དུས།",
    "དེར་མཐུད་ནས་ཁོས་རང་ཁྱིམ་ནས་འོ་ཇ་མངར་མོ་འཐུང་བཞིན་ངལ་གསོས་ནས་ཡོད་པའི་སྐབས་སུ།",
    "ལམ་འོག་ཏུ་འཁྲིད་མཁན་སོགས་ཀྱི་སྡིགས་མོ་བྱེད་བཞིན་རྡེག་རྡུང་བྱས་བྱུང་བར་མ་ཟད།",
    "ཕ་རོལ་ཏུ་ཆུང་མས་སྨྲེ་སྔགས་འདོན་བཞིན་ཁོའི་རྗེས་སུ་སྨྱོ་བ་ལྟར་རྒྱུག་གིན་ཡོད་ཀྱང་།",
    "མི་འགའ་ཞིག་གིས་ཁོ་མོའང་དེ་གར་བཀག་སྟེ་གཅར་རྡུང་བྱེད་ཀྱིན་འདུག་པ་མཐོང་བས་ཁོ་རང་དངངས་འདར་དང་བཅས་གཉིད་ལས་སད་པར་གྱུར།",
    "ཡར་ལངས་པ་ན་ནམ་གསལ་ཏེ་ཉི་མའང་ཤར་ཡོད་པར་མ་ཟད་རྒད་མོས་ནངས་ཇ་བསྐོལ་ཏེ་ཁོ་རང་སད་པར་བསྒུགས་ནས་བསྡད་ཡོད་པ་རེད།",
    "ང་རང་སྔ་མོ་ནས་མི་སློང་དོན་ཅི་ཡིན་ཞེས་རྒད་མོར་ལེ་བདའ་བྱེད་རྩིས་བྱས།",
    "རྒད་མོ་དགོད་བཞིན་དུ།",
    "ཁྱོད་རང་ཁ་སང་ཧ་ཅང་ཐང་ཆད་འདུག་པས་ཅུང་ཙམ་ལ་གཉིད་ཝ་བ་མོད་པའི་དགུན་ཝ།",
    "ལུས་ཕུང་ཇེ་བདེར་སོང་ཨེ་འདུག་ཅེས་དྲིས་བྱུང་བ་རེད།",
    "སྤྱིར་ན་ཁོས་རྒད་མོར་ལེ་བདའ་བྱེད་རྩིས་ཡོད་མོད།",
    "དོན་དག་ཅི་ཞིག་གྲོས་བྱེད་རྒྱུ་རེད་ཅེས་དྲིས།",
    "འོ་ན་ཁ་སང་ང་ཚོ་དབུལ་བོ་དག་ལ་ཟླ་ཕོགས་སྟེར་ཝ་བ་མེད་པའི་དགུན་ཁ།",
    "ཨ་ཁུ་དཔལ་སྐྱབས།",
    "ཁྱོད་གོ་བ་ལོག་སོང་བ་མ་ཡིན་ནམ།",
    "རྒད་པོ་དཔལ་སྐྱབས་ནི་དེ་མ་ཐག་དབུགས་ཤུབ་པ་ལྟར་གྱུར་ཏེ་མདུན་ཐད་ཀྱི་ཐང་ངོས་ལ་ཅེར་ནས་འདང་རྒྱག་གི་ནང་དུ་ལྷུང་བ་ལྟར་སྨྲ་བ་མེད་པར་བསྡད།",
    "ཆེས་མཇུག་མཐར་ཡོང་མཁན་ནི་ཚོ་བ་དང་པོའི་ཚོ་དཔོན་ཀུན་དགའ་སྐྱབས་རེད།",
    "ཁོ་ནི་མི་སྐྱིད་པོ་གཏོང་ཤེས་པ་ཞིག་ཡིན་ཞིང་ལོ་འགའི་སྔོན་ལ་པེ་ཅིན་རྟགས་ཅན་གྱི་འཇེམ་འཁོར་རྙིང་བ་ཞིག་ཉོས་རྗེས་གང་སར་མི་སྐྱེལ་འདྲེན་བྱས་ཏེ་སྒོར་མོ་འཚོལ་བའི་ལས་ལ་བྲེལ་བཞིན་ཡོད་ཅིང་།",
    "ཕལ་ཆེར་རྩ་ཆེན་ཞིག་ཡིན་རྒྱུ་རེད་ཨང་ཟེར་བཞིན་སྣ་སྒོར་ཁྱེར་ནས་སྣོམ་ཙམ་བྱེད།",
    "བག་ཆ་རེར་སྒོར་བཅུ་རེ་རེད་ཟེར།",
    "ཀུན་དགའ་སྐྱབས་ཀྱིས་ཁོ་ལ་ལྟ་ཙམ་བྱས་ཏེ་ཁོས་ནམ་རྒྱུན་གར་འཕྲད་ས་ནས་ཐ་མག་སློང་བར་བྱེད་པས་ཅུང་ཡིད་སུན་པའི་ངང་གློ་ཁུག་གཡོན་མ་ནས་ཐ་མག་དཀྱུས་མ་ཞིག་བླངས་ཏེ་རྐང་གཅིག་ཕར་གཡུགས་སོང་།",
    "འདི་གཉིས་གཅིག་འདྲ་མ་རེད་ཨང་ཟེར་ཡང་ལན་འདེབས་མཁན་གཅིག་ཀྱང་མ་བྱུང་།",
    "ཁ་སང་ཡུལ་གཙོ་པད་ཐར་སྐུ་དངོས་སུ་ཕེབས་ནས་ང་ཚོར་བཀའ་བཀྱོན་གནང་བ་རེད།",
    "དེ་རིང་འདིའི་ཐད་ནས་ཚང་མས་སྐད་ཆ་རེ་ཤོད།",
    "གང་ལྟར་སང་གནངས་ཙམ་ལ་ང་རང་སོང་སྟེ་ཡུལ་གཙོར་ཡར་ཞུ་བྱེད་རྒྱུ་ཞིག་ངེས་པར་དུ་དགོས་པ་རེད།",
    "ད་ནི་མི་རེ་རེ་བཞིན་རང་རང་གི་བསམ་འཆར་རེ་བརྗོད་རྒྱུ་བྱོས་ཟེར།",
    "དེའི་གོ་དོན་ནི་དབུལ་ཕོངས་སུ་འགྱུར་དོན་ནི་རང་རང་གི་སེམས་སུ་གསལ་བ་མ་ཡིན་ནམ།",
    "གླེང་ཡང་ཕན་ཐོགས་ཅི་ཡོད་ཅེས་པ་དེ་རེད།",
    "དེ་མུར་གན་དུ་ཐ་མག་འཐེན་གྱིན་པའི་ཀུན་དགའ་སྐྱབས་ལ་མིག་བརྡ་ཞིག་བསྟན་ནས་ཁྱོད་ཀྱིས་ཐོག་མར་ཤོད་ཟེར།",
    "ཀུན་དགའ་སྐྱབས་ཀྱིས་ཀྱང་དེའི་ཧ་གོ་སྟེ་དེ་མུར་ཐ་མག་རྔུབ་འཐེན་འགའ་བྱས་ཤིང་བསམ་སམ་བློ་གཏོང་ཙམ་བྱས་རྗེས་ན་རེ།",
    "འོན་ཀྱང་འདི་ནི་གཞན་གང་གིས་ལན་པ་ཡང་མ་ཡིན་པར་མི་རང་རང་གི་བརྩོན་པས་མ་འདང་བ་རེད།",
