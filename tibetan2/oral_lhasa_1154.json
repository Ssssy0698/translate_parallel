    "འདི་ལྟར་མཚན་ཉིད་མྱེད་པར་མཚན་ཉིད་གཅིག་པའོ།་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གང་ཡིན་པ་དང་།",
    "འདི་ལྟར་མཚན་ཉིད་མྱེད་པར་མཚན་ཉིད་གཅིག་པའོ།",
    "རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་རྣ་བའི་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་སྣའི་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་ལྕེའི་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་འགྲིརྦ་པ་གང་ཡིན་པ་དེ་ཡང་རྣམ་པར་ཤེས་པའི་ཁམས་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པའི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་རྣམ་པར་ཤེས་པ་མ་ཡིན།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་འདུས་བྱས་སྟོང་པ་ཉིད་མ་ཡིན།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་འདུས་མ་བྱས་སྟོང་པ་ཉིད་མ་ཡིན།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་ཡང་དག་པར་སྤོང་བ་རྣམས་མ་ཡིན།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མ་ཡིན།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མ་ཡིན།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་མ་ཡིན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་འགྲིབ་པ་གང་ཡིན་པ་དེ་ཡང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མ་ཡིན་ནོ།",
    "གང་འདི་གཟུགས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཚོར་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུ་ཤེས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུ་བྱེད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱིག་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣ་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྣ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལྕེ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལུས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཡིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་གཟུགས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྒྲ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དྲི་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རོ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་ཉུཕྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཆུའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱེའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ནམ་མཁའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣམ་པར་ཤེས་པའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མ་རིག་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུ་བྱེད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱིང་དང་གཟུགས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྐྱེ་མཆེད་དྲུག་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཚོར་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྲེད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལེན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྲིད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྐྱེ་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྒ་ཤི་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།་།",
    "གང་འདི་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་ཕྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཡང་དག་པར་སྤོང་བ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྟོབས་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འཕགས་པའི་བདེན་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བསམ་གཏན་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "སྨོན་པ་མྱེད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཏིང་ངེ་འཛིན་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་གཟུངས་ཀྱི་སྒོ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་སྐྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱི་འཇིགས་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།་།",
    "གང་འདི་བྱམས་པ་ཆེན་པོ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཐམས་ཅད་ཤེས་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ་ཞེས་ཟེར།",
    "གང་འདི་གཟུགས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཚོར་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུ་ཤེས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུ་བྱེད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་རྣམ་པར་ཤེས་པ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱིག་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྣ་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྣ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལྕེ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལུས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཡིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།་།",
    "གང་འདི་གཟུགས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྒྲ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དྲི་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རོ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།་།",
    "འདི་ལྟར་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་རྣ་བའི་རྣམ་པར་ཤེས་པ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་སྣའི་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་སྣའི་རྣམ་པར་ཤེས་པ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་ལྕེའི་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་ལྕེའི་རྣམ་པར་ཤེས་པ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཆུའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མེའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ནམ་མཁའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་རྣམ་པར་ཤེས་པའི་ཁམས།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་རྣམ་པར་ཤེས་པའི་ཁམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མ་རིག་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འདུ་བྱེད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་ཡང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་རྣམ་པར་ཤེས་པ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱིང་དང་གཟུགས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྐྱེ་མཆེད་དྲུག་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཚོར་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྲེད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལེན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྲིད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྐྱེ་བ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྒ་ཤི་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་འདུས་བྱས་སྟོང་པ་ཉིད།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་འདུས་མ་བྱས་སྟོང་པ་ཉིད།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རང་བཞིན་༣༧སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་ཡང་དག་པར་སྤོང་བ་རྣམས།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་ཡང་དག་པར་སྤོང་བ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་སྟོབས་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་འཕགས་པའི་བདེན་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བསམ་གཏན་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "སྨོན་པ་མྱེད་པ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཏིང་ངེ་འཛིན་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་གཟུངས་ཀྱི་སྒོ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་མྱི་འཇིགས་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་བྱམས་པ་ཆེན་པོ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་དགྲ་བཅོམ་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "གང་འདི་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།",
    "འདི་ལྟར་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་གཞན་མ་ཡིན།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་མ་སྐྱེས་པ་སྟེ།",
    "གང་འདི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཅེས་བྱ་བ་དེ་ནི་གཉིས་སུ་མྱེད་པའི་གྲངས་སུ་བྱས་པའོ།་",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།",
    "རྣམ་པར་ཤེས་པའི་མ་སྐྱེས་པ་མཐོང་བར་འགྱུར།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ།"
