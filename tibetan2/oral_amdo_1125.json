    "ཐམས་ཀྱི་མིག་གིས་སྦྱིན་པ་བྱས་པར་མཐོང་ནས།",
    "བདག་གིས་བལྟས་ན་མིག་གཉིས་ནས་ཁྲག་ཟགས་ཅིང་།",
    "བདག་གིས་མིག་བྱིན་པ་འདི་ལ་འགྱོད་པ་ཡང་མེད་ལ།",
    "ཁྱོད་ཀྱང་མཐོང་བར་གྱུར་གྱིས།",
    "རིན་པོ་ཆཚེ་འདི་དག་ཀྱང་ཁྱེར་ལ་ཕྱིར་སོང་ཤིག་ཅེས་བསྒོའོ།",
    "འཁོར་མང་པོའི་རྣམས་ཁ་ཅིག་གིས་ནི་རྒྱུན་ཏུ་ཞུགས་པ་དང་།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཉོན་མོངས་པ་ལ་བྱམས་ཤིང་བརྩེ་བར་གྱུར་ཏོ།",
    "རིང་པོར་མ་ལོན་པར་ཐམས་ཅད་ཁྱོད་དུ་ཆུད་ཅིང་རྟོགས་པར་གྱུར་ཏོ།",
    "བྲམ་ཟེས་ཀྱང་ཁྱེའུ་མི་གདུང་བ་ཁྱོད་ཀྱིར་འདུག་ལ།",
    "ཚིག་དྲང་པོར་སྨྲས་ཏོ་ཁོ་མོ་ནི་ཁྱོད་ལ་ཆགས་ཀྱང་སྔན་ཆད་ནི་སྐབས་མེད་དོ།",
    "ཁོ་མོའི་ཡིད་དང་སྦྱོར་ཅེས་བསྒོའོ།",
    "ཁྱོད་ཀྱིས་རྟག་ཏུ་བསྟོད་པའི་མི་གདུང་བ་ནི།",
    "ཁྱོད་སོང་བའི་འོག་ཏུ་དུ་ལ་ཉལ་བར་བསྒྲུབས་ཏེ།",
    "ཁོ་མོ་མ་བཏུབ་པས་ཁོ་མོའི་གོས་ཀྱང་དལ།",
    "ཁྱོད་ཀྱི་དྲིན་རྟག་ཏུ་དན་པས།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་དེ་བཞིན་དུ་བྱས་ན།",
    "ཁྱེའུ་མི་གདུང་བ་པུས་མོ་ས་ལ་བརུགས་ཏེ་བསྟན་པར་གསོལ་པ་དང་།",
    "འདིར་མ་འདུག་པར་གར་དགར་བར་སོང་ཤིག་ཅེས་བསྒོ་ནས།",
    "སོར་མོ་བཅད་དེ།",
    "ཀུན་ཏུ་གསོད་ཅིང་ཞག་བདུན་དུ་ཕྱིན་པའི་ཉིན་པར་སོར་མོ་དགུ་བརྒྱ་དག་བཅུ་ཅྩ་དག་ནི་སྙེད་ཀྱི་སོར་མོ་གཅིག་གིས་བསྣུན་ན་གསད་པའི་གྲངས་ཀྱང་སྟོང་དུ་ཆུང་བ་ལས།",
    "དེ་ནས་ཁྱེའུའི་མ་ཉིད་ཁ་ཟས་ཐོགས་ཏེ་བུའི་དྲུང་དུ་སོང་བ་ལས།",
    "བདག་ནི་སློབ་དཔོན་གྱིས་བསྟན་པ་བཞིན་དུ་ཉིན་ཞག་བདུན་གྱིས་སོར་མོ་སྟོང་དུ་ཁ་བསྐུད་ན།",
    "ཁོ་མོ་མི་གསད་པར་སོར་མོ་གཅད་དུ་མི་རུང་དམ་ཞེས་བསྒོ་བའི་ཚེ།",
    "དགེ་སློང་གི་ཐོག་ཏུ་མཆོངས་ཏེ།",
    "རྒྱང་མ་། ནས་དགེ་སློང་ཁྱོད་ཅུང་ཟད་ཅིག་སྡོད་ཅིག་ཅེས་བོས་སོ།",
    "ཁྱོད་ཉིད་མི་སྟོད་དོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "དེའི་ཚེ་ན་བལ་གླང་མོ་ཞིག་བུ་མི་ཕྱིན་པས།",
    "ཁྱོད་སོང་ལ་འདི་སྐད་དུ་བདག་ཐོག་མ་སྐྱེས་པ་ནས།",
    "བ་ལ་གླད་མོའི་དྲུང་དུ་སོང་སྟེ།",
    "དེའི་ཚེ་རྒྱལ་པོ་གསལ་རྒྱལ་དཔུང་གི་ཚོགས་དང་གཅས་ཏེ།་",
    "དཔུང་གི་ཚོགས་འགྲོ་བའི་ལམ་མཛེ་ཏའི་ཚལ་གྱི་དྲུང་དུ་བྱུང་བས།",
    "གཙུག་ལག་ཁང་ན་དབྱངས་བྱེད་པ་དཔུང་གི་ཚོགས་ཀྱིས་ཐོས་ནས།",
    "བྱོལ་སོང་གི་གནས་སུ་སྐྱེས་པ་ཡང་འདི་ལྟར་ཉན་པར་དགའ་ནན།",
    "བདག་ཅག་གི་མིའི་ནང་དུ་སྐྱེས་པ་ལྟ་ཅི་སྨོས་ཏེ།",
    "སྐད་ཅིག་མཉན་པར་བྱའོ་ཞེས་མཛོ་ཏའི་ཚལ་དུ་སོང་ནས།",
    "བཅོམ་ལྡན་འདས་གང་ན་བཞུགས་པའི་སྤྱན་སྔར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "ངོས་གཅིག་གི་ལག་དཔོན་གྱིས་ལེ་ལོ་བྱས་ནས་ཟིན་དུ་མི་ཉེ་སྟེ།",
    "ལེ་ལོ་བྱས་པས་དེ་ལ་ཁྱོད་ཀྱི་ལེགས་པར་མ་བྱས་པས་མ་ཟིན་ཏེ།",
    "གསེར་གྱི་དྲིལ་བུ་གཅིག་མཆོད་རྟེན་རྩེ་མོ་ལ་བཏགས་ནས།",
    "དོས་གཅིག་གི་ལག་དཔོན་མཆོད་རྟེན་ཏུ་ཅང་ཆེས་སོ་ཞེས་ཁྲོས་པ་དེ་ནི་དགེ་སློང་འདི་ཡིན་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་གར་འགྲོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "སོར་འཕྲེང་ཅན་ནི་དེ་ལྟར་གནས་ཁང་གི་སྒོར་ཕྱིན་ནས།",
    "ལུས་ཀྱང་ཤིན་ཏུ་གདུག་པས་རེག་གིམ་ཉེར་ཡང་མི་བཟོད་དོ།",
    "དེའི་ཚེ་བྱ་གདུག་པ་དེ་ཚལ་ཞིག་གི་ནང་ན་ཕྱིན་ནས་ཤིང་ཁར་འདུག་སྟེ་སྐད་པྱུང་བ་ལས།",
    "བལ་གླང་གི་རྒྱལ་པོ་དེ་ནི་རྒྱལ་པོ་ཉིད་ཡིན་ནོ།",
    "འཛམ་བུའི་གླིང་འདིར་ཡུལ་འཁོར་མོར་འཇིག་བྱ་བ་ན།",
    "དེའི་ཚེ་རྒྱལ་པོ་དེའི་དཔུང་གི་ཚོགས་རྣམ་པ་བཞི་དང་བཅས་ཏེ།",
    "ཚུལ་གྱི་ནང་དུ་སོང་སོང་བ་ལས།",
    "སེང་གེ་མོ་ཞིག་གནས་པ།",
    "འདོད་ཆགས་ཀྱིས་ཉན་ནས་སོད་སོང་བ་ལས།",
    "བདག་གི་སྲོག་ལ་ཡང་དམའོ་སྙམ་ནས་སྐྲག་བཞིན་དུ།",
    "སེང་གེ་མོ་ལ་འདོད་ལ་ཡང་ཡོངས་སུ་སྤྱད་དོ།",
    "དེ་ནས་སོང་གེ་མོ་ཕྱིར་སོང་བའི་འོག་ཏུ།",
    "དེའི་ཚེ་སེང་གེ་མོ་དེ་སྦྲམ་མར་གྱུར་ཏེ།",
    "སེང་གེ་མོས་ཀྱང་རྒྱལ་པོའི་བུ་ཡིན་པར་དྲན་ནས།",
    "རྒྱལ་པོས་ཀྱང་བདག་གི་བུ་ཡིན་པར་དྲན་ནས་བུ་ཡིན་པར་ཤེས་ཏེ།",
    "དེ་ལ་བཙུན་མོ་གཅིག་ནི་རྒྱུལ་རིགས་སོ།",
    "ཕྱིས་རྐང་བཀྲུ་དེ་བསྐྱེད་མོས་ཚལ་དུ་འཆག་ཏུ་སོང་ནས།",
    "བཙུན་མོ་གཉིས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ལ་ནི་ཉི་མ་གཅིག་གཅིག་གི་བར་དུ་ལྷན་ཅིག་རྩེ་དགའ་ཞིང་ཡོངས་སུ་སྤྱད་དོ།",
    "ཕྱག་བྱས་ནས་མར་དུ་སོང་བ་ལས་འཕྱིས་པར་གྱུར་ཏོ།",
    "དེ་ནས་བཙུན་མོ་དེ་ནེ་སྡང་སྐྱེས་ནས།",
    "གལ་ཏེ་ལྷ་ཁྱོད་ལ་མཐུ་ཞིག་ཡོད་ཡང་དག་ན།",
    "བཙུན་མོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ལྷ་དྲང་སྲོང་གི་གདན་ལ་འདུག་ནས།",
    "ཤ་དང་ཉ་སྦྱོར་ཅིག་ཅེས་སྨྲས་ནས་སོང་ངོ།",
    "དེ་ནས་། རྒྱལ་པོས་ཀྱང་དྲང་སྲོང་གིས་སྨྲས་པ་བཞིན་དུ།",
    "དྲང་སྲོང་གིས་སྨྲས་པ།",
    "རྒྱལ་པོ་ལོ་བཅུ་གཉིས་ཀྱིས་བར་དུ་མི་ཤ་ཟ་བར་གྱུར་ཅིག་ཅེས་བྱས་ནས་སོང་ངོ།",
