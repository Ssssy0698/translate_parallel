    "གྲོགས་ཁྱོད་ཁྱིམ་གྱི་དཔལ་ལ་མངོན་དགའ་ན།",
    "རྩུབ་མོས་འགོག་པ།",
    "དམན་པའི་གྲོགས་ཁྱོད་རི་དྭགས་མིག་ཡངས་མ།",
    "ཆགས་པའི་མིག་གིས་བསྲུང་ཞེས་ཐོས་བདེན་ན།",
    "གྲོགས་ཁྱོད་རི་དྭགས་ཅན་དང་ལྷན་ཅིག་ཏུ།",
    "ལྷོད་པོ་ཁྱོད་འདོད་བཞིན་དུ་བག་ཡངས་ཀྱི།",
    "རང་གཞན་གཏན་དུ་རྣམ་སྨིན་རྩུབ་མོའི་མདས།",
    "དམན་ཁྱོད་ཆུང་མར་བཅས་པའི་ཁྱིམ་གྱི་དཔལ།",
    "དོན་གཉེར་ཚིག་གི་འཕྲིན་པ་སྔར་བྱུང་ཟིན།",
    "དམ་པའི་མགོན་དང་མཇལ་ཡང་མོས་འུ་གུས་ཆུང་།",
    "ལེགས་པར་བརྟགས་པས་ཉིན་བཞིན་རང་གི་རྒྱུད།",
    "བེམ་དངོས་འཇོག་པོའི་གཙུག་གི་རྒྱན་དེས་ཅི།",
    "བདེ་འབྱུང་གཙུག་གི་ནོར་དེས་སུ་ལ་ཅི།",
    "ཅུང་ཟད་རེ་ཡང་འབད་པས་སྒྲུབ་འདི་མཚར།",
    "འོན་ཀྱང་འབར་བའི་སྒྲ་ལ་བུད་ཤིང་ཚོགས།",
    "ཕྱག་རྗེས་ཆེ་ཞེས་མགོན་ཁྱོད་མི་བསྟོད་དེ།",
    "གསང་འཛིན་མགོན་པོ་རང་གི་བསྟན་པ་མཆོག།",
    "བསྒྲུང་བྱའི་དམག་གིས་བཟུར་མེད་འཆི་བདག་ཁར།",
    "ནོར་བུ་རིན་ཆེན་གང་གིས་ཐོབ་པའི་མི།",
    "རྡོ་རྗེ་རིན་ཆེན་ཆག་རྡུལ་ཕྲ་མོ་ཡང་།",
    "ཉིན་མོར་བྱེད་ལ་གཡོ་བའི་སེམས་བྲལ་ཡང་།",
    "དམན་ལམ་འཕྱན་རྣམས་ཐེག་མཆོག་འདིར་འཁུ་མོད།",
    "ངན་སྐྱུགས་མཐོང་མོད་མི་རྣམས་ཅི་ཡིས་འཛིན།",
    "གཅིག་གི་ལྡོག་པ།",
    "མཚུངས་མོད་སྔ་མ་ཆགས་བྲལ་འཕགས་པའི་འོ།",
    "འཁྱོག་པོའི་རང་བཞིན་གཡོན་ཅན་ཆང་མིག་མ།",
    "ཁྱོད་དང་ཐུར་བབས་ཆུ་བོ་མཚུངས་ཐ་དད།",
    "ཁྱོད་ཉིད་བསྟེན་པས་མི་ཁའི་བུན་ལོང་འཕེལ།",
    "ཤེས་རབ་མཆོག་དང་ཏོག་གི་བློ་གྲོས་དཔལ།",
    "འགྲོ་ལ་སིམ་པ་མཆོག་སྟེར་མཚུངས་མོད་ཀྱི།",
    "རྒྱ་མཚོའི་ལྷ་མོའི་ཕྱག་སོར་རྩེ་ནའོ།",
    "བརྒྱ་ཕྲག་ལྷ་ཡི་རོལ་མོའི་སྙན་དབྱངས་ལ།",
    "བཅོམ་ལྡན་ཁྱོད་གསུང་ཡོན་ཏན་དེ་ཡིས་མཛེས།",
    "བོས་པ་མིན་ཡང་གྲང་རེག་མགྲོན་དུ་ཁུག།",
    "དགུན་གྱི་གནས་སྐབས་འདི་ནི་ཡ་རེ་ང་།",
    "ནང་ལང་ཚོ་ལ་སྦྱར་བ།",
    "སྦྱང་རྒོད་ཆང་གིས་རབ་མྱོས་གླང་པོའི་སྣར།",
    "གྲང་རེག་གདུང་བ་འཕྲོག་པའི་ཚ་ཟེར་འཕྲོ།",
    "བཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱན་ལ་བཞི་ལས།",
    "ཉེས་བྲལ་འོད་ཟེར་སྟོང་གི་དྲྭ་བ་ཡིས།",
    "བདག་གི་ཡིད་ནི་ཐེ་ཚོམ་དྲྭ་བས་བཅིངས།",
    "བཅུ་གཉིས་པ་རབ་རྟོག་གི་རྒྱན་ལ་དྲུག་ལས།",
    "གངས་ཁྲོད་བསིལ་བུས་རེག་པའི་མཚོ་བྱུང་མ།",
    "ཡིབ་པར་གཟིགས་ནས་སྨྲ་བའི་རྒྱལ་པོ་ཡང་།",
    "ལང་ཚོས་ཡོངས་དུད་པད་དཀར་ཉ་རྒྱས་ཟླ།",
    "སྐྱེངས་ནས་ཁྱོད་ཞབས་བསྟེན་ཏེ་གནས་པ་ལ།",
    "རིན་ཆེན་རྒྱན་མང་དག་གིས་བཟུང་མཐོང་ནས།",
    "ཀུན་ཀྱང་ཁྱོད་སྐུར་འཁྱུད་ལ་རིངས་པ་བཞིན།",
    "ལྷ་དང་དྲི་ཟ་གྲུབ་པའི་བུ་མོའི་ཚོགས།",
    "ཀུན་གྱིས་མཆོད་མཐོང་ཁྱོད་སྐུའི་རྣམ་འགྱུར་འབུམ།",
    "བྱེད་པོ་རང་གིས་བསྡུས་ཏེ་ཁྱོད་ཉིད་ལ།",
    "ཁྱོད་ཐུགས་མཁྱེན་བརྩེའི་ཕ་མཐར་འགྲན་བཟོད་པའི།",
    "འཇམ་དབྱངས་ཕྱག་གི་རལ་གྲི་ཡང་ཡང་དུ།",
    "དཔྱད་ཀྱང་བརྫི་བར་མི་ནུས་ཟབ་མོའི་དོན།",
    "མིན་ཕྱིར་དབེན་པར་བདག་གི་ཡིད་དགའ་འོ།",
    "བཅུ་བཞི་པ་ཕྲ་མོའི་རྒྱན་ལ་གཉིས་ལས།",
    "ཟུར་གྱི་ཕྲ་མོ།",
    "རྣམ་པའི་ཕྲ་མོ།",
    "འགོལ་སར་བཀའ་མཆིད་མོལ་བའི་སྤྱན་གྱི་ཟུར།",
    "བཛྲ་གིརྟི་འདི་ཡིས་སུ་ལ་ཅི།་",
    "རེ་བ་དང་བཅས་པའི་དགའ་བ།",
    "རེ་བ་མེད་པའི་དགའ་བ།",
    "མགོན་ཁྱོད་གཟུགས་སྐུ་འདྲེན་བྱེད་ལས་བསྐལ་པའི།",
    "གན་རྐྱལ་སྒྲེན་མོར་འགྱེལ་གང་ཇི་ལྟར་བཟོད།",
    "བརླན་ལྡན་མིག་གིས་གཤེད་མའི་གདོང་ལ་བལྟ།",
    "རང་ཤ་རང་གིས་ཟ་བའི་ཉེས་ཅན་དག།",
    "རྒས་ཤིང་འཁོགས་པ་འཁྱོལ་བས་གར་བྱེད་དོ།",
    "འཐོར་ཚེ་མགོ་བོ་ཡོགས་པའི་རོལ་མོ་མཁན།",
    "འཇིགས་རུང་གི་ཉམས།",
    "དགུ་བརྒྱ་གོ་དགུ་བསད་པའི་མིའི་སོར་མོས།",
    "ལུས་བརྒྱན་ཁྲག་གིས་སྦགས་པའི་མི་གདུང་བ།",
    "དྲན་ན་བུད་མེད་མངལ་གནས་ལྷུང་བར་བྱེད།",
    "བརྟེན་སླད་ཁོ་བོ་རེ་ཞིག་རྒྱུ་ལགས་ནི།",
    "མཐོན་ཀ་རྒྱལ་མཚན་རྩེ་མོར་མཆོད་མཐོང་ནས།",
    "འཛུམ་ལྡན་རེག་ན་བདེ་སྟེར་རི་དྭགས་ཅན།",
    "དེ་ཀུན་སྙེམ་མའི་བདག་པོ་ཁྱོད་ལ་མངའ།",
    "སྙན་པའི་གསུང་གིས་རྣ་བར་བྲིད་མིན་ལ།",
    "ཤིང་རྟ་གླང་པོ་རྟ་དང་རྐང་ཐང་གི།",
    "གཅེར་བུ་ལག་སྟོང་བྲང་ལག་འཐབ་མོ་འཆའ།",
    "གཡོན་ཕྱོགས་སྣ་རེས་བཅད་ཀྱང་ཁྲོ་མིན་པར།",
    "རྣམ་འདྲེན་མཆོག་གིས་ཡོངས་བཟུང་གསང་བའི་མཛོད།",
    "རྡོ་རྗེ་འཆང་དང་ཐུན་མོང་ཉིད་གྱུར་ན།"
  ]
}