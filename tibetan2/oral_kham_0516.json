    "ཡུལ་དང་རང་རིག་ངོ་བོ་གདོད་ནས་མ་གྲུབ་པས་ཅི་ཡང་མ་མཐོང་བ་ཉིད།",
    "ཐམས་ཅད་ཀྱང་རང་རིག་པ་ཉིད་རང་སྣང་བའི་ཕྱིར།",
    "ལྡོང་ན་ཡང་ངོ་བོ་ཉིད་དུ་ཤེས་པ་ཐམས་ཅད་ཀྱང་རང་ཉིད་དུ་གསལ་བ་ནི་གསུམ་པའི་བདེ་བ་སྟེ།",
    "གང་ཡང་རང་བཞིན་ཉིད་ལས་མ་ཉམས་པའོ།",
    "ཡེ་ཤེས་ལྔ་དང་རང་བྱུང་ཡེ་ཤེས་ཀྱིས་ཀུན་ལ་རྒྱས་བཏབ་པས་མུ་མཐའ་མི་རྙེད་དེ་སྐུར་ཤར་བའོ་ ཇི་ལྟར་སྐར་ཚོགས་གཞན་དུ་མ་འཕྲོས་བཞིན།",
    "བདག་ཉིད་མཛད་སྤྱོད་ཅིར་ཡང་རང་སྣང་བར་རྟོགས་པའི་དགོངས་པས་བརྩལ་བ་མེད་པར་དོན་མཛད་པའོ།",
    "ངང་དང་རང་བཞིན་མི་འཐད་པ་སྒྲུབ་པའི་རིགས་པས་ལྟོས་པའི་ཕྱིར་ཕན་ཚུན་རྒྱུ་དང་འབྲས་བུར་གནས་སྐབས་ཀྱིས་གསུངས་ཏེ།",
    "དེ་ཉིད་ཅིར་ཡང་རང་སྣང་བས་དོན་བྱེད་པ་ནི་ཡབ་ཐབས་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "སུ་ཞིག་དུས་གསུམ་གང་ནས་ཚོལ།",
    "རང་བྱུང་ཡེ་ཤེས་གཏིང་ཕྱིན་པར་མཇལ་བས་འགྲོ་ཉལ་འདུག་སྡོད་ལོངས་སྤྱོད་དུ་སྤྱོད་པ་རིལ་ལ་སྤྱད་ཀྱང་གོལ་བ་མེད་དེ་ཡང་དག་པའི་མཛད་སྤྱོད་ཉིད་དུ་སྨིན་ཟིན་ཏོ།",
    "སྐྱེ་བ་མེད་ཅིང་འགག་མེད་གཡུང་དྲང་རང་བཞིན་གནས།",
    "འོན་ཏེ་ན་འདི་ནི་དལ་བ་སྟེན་ཅིང་རང་ཉམ་དུ་འདུག་གོ་ཞེ་ན།",
    "སེམས་ལ་གཟུགས་འདི་འདྲར་མེད་པས་སྒྲ་ཡིས་བསྟན་པ་ལས་འདས་པའི་ཕྱིར་སྒྲ་སྣ་ཚོགས་ཀྱང་རང་རིག་པའི་ཡེ་ཤེས་རང་སྣང་བའོ།",
    "གང་རང་བཞིན་དང་རྐྱེན་ཀྱིས་ནོར་བ་དང་མ་ནོར་བ་རིལ་ཡང་།",
    "ཡང་དག་པ་ཉིད་མ་ལོག་པ་ཞིག་དུ་ཡང་རང་རྒྱུད་དུ་མེད་དེ་གདོད་ནས་གཉིས་དང་བྲལ་བའོ།",
    "ངང་དང་རང་བཞིན་དང་བདག་ཉིད་ཆེན་པོའི་། གཏན་ཚིགས་དང་།",
    "བདེར་འདུག་རིགས་པ་མ་ཡིན་ཕྱིར།",
    "གང་ཐམས་ཅད་ཀྱི་གཞི་དང་རང་བཞིན་ནི།",
    "བློ་ཡང་རབ་ཏུ་གྱུར་པ་རྣམས་དོན་དང་མཐུན་པར་འདུག་པ་ནི་གནས་པ་ཞེས་བྱའོ།",
    "དེའང་རང་བཞིན་ལ་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཀློང་ནས་ཤར་བས།",
    "སྐྱེ་བ་མེད་ཅིང་འགག་མེད་གཡུང་དྲུང་རང་བཞིན་གནས།",
    "རང་རིག་ངོ་བོ་བསྟན་ཅིང་ཅིར་ཡང་རང་སྣང་བས།",
    "ཤེས་རབ་གྱི་བློ་ཤིན་ཏུ་མ་སྦྱངས་པ་གང་ཞིག་དུས་ཀྱིས་མནར་བའི་སྐྱེ་བོ་ལྔ་བརྒྱ་ཐ་མ་པ་ལ་སྐྱེས་པ་དག།",
    "གནས་ལ་མཐོ་དམན་འདུག་པར་ཁྱེད་ཀྱི་མཐོང་ངམ་ཅི།",
    "ཡོ་གས་གཞན་ལྟ་ཉམས་པར་བྱེད་ཅིང་རང་འདོད་མེད།",
    "རྣལ་དུ་ཕབ་པ་ཉིད་ལས་ང་རང་ཡིན།",
    "ལྔ་པ་རྫོགས་པ་ཆེན་པོ་ལ་འདོད་རྒྱལ་གྱིས་ངེས་པར་གྲོལ་ཞིང་རང་ལྟའི་ཚིག་ཙམ་དུ་གཏན་ལ་དབབ་པར་བསྟན་པའོ།",
    "ཀུ་ཤའི་གདན་ལ་འདུག་སྟེ།",
    "བཟང་པོའི་འདུག་སྟངས་ཞེས་བྱ་བ་རིམ་པ་ལྟར།",
    "ཡ་གཅིག་མདུན་དུ་བརྐྱང་པའི་སྟབས་ཀྱིས་འདུག་སྟེ།",
    "ལྷ་རྣམས་ཀྱི་བཞུགས་ཚུལ་དང་མཐུན་པར་རང་ཉིད་ཀྱང་འདུག་པ་དང་།",
    "མགྲིན་པ་བཟུར་བ་ལ་སོགས་པའི་འདུག་སྟངས་ཀྱིས་སྤྱན་དྲང་བར་བྱ་ལ།",
    "ཞེས་པས་པད་མའི་འདུག་སྟངས་ཀྱི་གདན་དང་།",
    "ཞེས་པས་དཔའ་བོའི་འདུག་སྟངས་ཀྱི་གདན་ཕུལ་ལ།",
    "ནུབ་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་པ་ལ།",
    "གདུགས་དང་བཅས་པ་ནུབ་ཕྱོགས་ཀྱི་སྒོར་འདུག་ནས།",
    "སྟན་མེད་པར་རྐང་པ་གཡས་པས་གཡོན་པ་མནན་པས་འདུག་པར་བྱའོ།",
    "དེ་ནས་ལས་སྔགས་བཟླས་པའི་སྤོས་ཆུས་འཐོར་འཐུང་ལན་གསུམ་བྱ་ཞིང་རང་ཉིད་ལ་དེས་བསང་གཏོར་ལན་གསུམ་བྱས་ནས།",
    "མདུན་ན་འདུག་ཅིང་མཆོག་སྒྲས་པ་དེ་སྦྱིན་པར་བྱེད་དོ།",
    "དེ་ནས་རིག་པ་འཛིན་པ་ཁ་ཤར་དུ་བལྟས་ཏེ་འདུག་ནས།",
    "ཨོཾ་རུ་རུ་སྥ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་ཨརྠ་སཱ་དྷ་ནི་སྭཱཧཱ།",
    "གནས་ཀྱི་ནང་དུ་རྒྱལ་པོ་ཆེན་པོ་བཞི་གོ་བགོས་པ་ཁྲོས་པའི་གཟུགས་སུ་འདུག་པ་བྲིའོ།",
    "ཨོཾ་རུ་རུ་སྥ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷཱ་ནི་སྭཱཧཱ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷེ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱཧཱ།",
    "དགའ་དགའ་ལྟར་འདུག་པ་ཤིན་ཏུ་མཛེས་པ་ལེགས་པར་རྣམ་པར་ཕྱེ་བ།",
    "རྒྱར་དཔག་ཚད་ལྔ་སྟོང་པ་བཟའ་བ་དགའ་དགའ་ལྟར་འདུག་པ་ཤིན་ཏུ་མཛེས་པ་ལེགས་པར་རྣམ་པར་ཕྱེ་བ།",
    "གཡོན་ཕྱོགས་སུ་ལག་ན་རྡོ་རྗེ་གདོང་སྒྱུར་བ་ཁྲོས་པའི་གཟུགས་སུ་འདུག་པ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ།",
    "ནང་དུ་རྒྱལ་པོ་ཆེན་པོ་བཞི་གོ་བགོས་པ་ཁྲོས་པའི་གཟུགས་སུ་འདུག་པ་བྲིའོ།",
    "བུའི་གཟུགས་སུ་མདུན་ན་འདུག་ཅིང་།",
    "བབཟླས་བརྗོད་བྱས་ན་མདུན་ན་འདུག་ཅིང་མངག་གཞུག་པར་འགྱུར་རོ།",
    "གང་སྒོ་བ་དེ་ཉན་ཅིང་ཇི་སྲིད་འཚོའི་བར་དུ་འདུག་པར་འགྱུར་རོ།",
    "གཡོན་ཕྱོགས་སུ་འཕགས་པ་ཕྱག་ན་རྡོ་རྗེ་གདོང་སྒྱུར་བ་ཁྲོས་པའི་གཟུགས་སུ་འདུག་པ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ་པད་མའི་སྟེང་དུ་པུས་བཙུགས་ཏེ།",
    "གནས་ཀྱི་ནང་དུ་རྒྱལ་པོ་ཆེན་པོ་བཞི་གོ་བགོས་པ་ཁྲོས་པའི་གཟུགས་སུ་འདུག་པ་བྲིའོ།",
    "སྔར་ལྟར་བསང་གཏོར་བྱས་ལ་རང་ཉིད་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས།",
    "ཁ་ཤར་དུ་བལྟས་ནས་ཀུ་ཤའི་གདན་ལ་འདུག་སྟེ།",
    "ཀུ་ཤའི་སྟན་གཙང་མ་ལ་འདུག་ནས་ཁ་ནུབ་ཏུ་བལྟས།",
    "སྟན་མེད་པར་རྐང་པ་གཡས་པས་གཡོན་པ་མནན་ལ་འདུག་པར་བྱའོ།",
