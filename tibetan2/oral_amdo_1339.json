    "སྐབས་རེར་སྤྲོ་བསྡུའི་དམིགས་པར།",
    "མ་དག་པའི་ཞིང་གི་སྣོད་བཅུད་ཀྱི་ཉེས་ཚོགས་སྡུག་བསྔལ་སྡིག་སྒྲིབ་བག་ཆགས་དངོས་པོར་འཛིན་པ་དང་བཅས་པ་རང་བཞིན་གྱི་དབྱིངས་སུ་སྦྱངས།",
    "བདག་གིས་བཟླས་པའི་སྔགས་ཀྱི་སྒྲ་དང་ལྷན་ཅིག་བྲག་ཅ་ལྟར་བདག་བསྐྱེད་གཙོ་བོ་རྟེན་བརྟེན་པར་བཅས་པ་ཐམས་ཅད་དང་བརྟན་གཡོ་སྣང་སྲིད་སྣོད་བཅུད་ཀུན།",
    "རང་སྣང་རྩ་གསུམ་ཞི་ཁྲོའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་ཐམས་ཅད་པར་ཤར་བ་ཡང་སྔགས་སྒྲ་དིར་གྱིས་རང་གི་བཟླ་གྲོགས་མཛད་ཅིང་།",
    "ཨོཾ་ཧཱུྃ་ཏྲཱཾ་ཧྲཱི་ཨཱ་སྦྲེལ་མར་ཅུང་ཟད་རེ་བཟླ།",
    "འདིའི་ཉམས་ལེན་ཟླ་བཞིར་བཅད་པའི་བསྐྱེད་རིམ་ཟླ་གཅིག་མར་གཙོ་བཟླས་ཁོ་ནས་ཀྱང་འཐུས་ཀྱི་འཁོར་སྔགས་དམིགས་བསལ་མི་དགོས་མོད།",
    "རྣམ་པར་སྣང་མཛད་བདག་ཉིད་གཙོ་བོ་ཡབ་ཡུམ་ལ་ཐིམ་པར་བསམས་ལ་དེ་འབའ་ཞིག་གི་ང་རྒྱལ་འཛིན་ནོ།",
    "གསུམ་པ་སོ་སོ་རང་རིག་གིས་དག་པ་ནི།",
    "ཕྲ་ཐིག་གི་རྣལ་འབྱོར་ཏེ་དེ་ལ་གཉིས་ལས།",
    "སྟག་ཤམ་ཅན་རལ་པའི་ཐོར་ཅོག་གི་རྩེར་ནོར་བུ།",
    "ཐལ་ཆེན་གྱི་ཚོམ་བུ་སྟེ་ཕྱག་རྒྱ་དྲུག་ཡུམ་ལ་ཐལ་ཆེན་སྤངས་པའི་ཕྱག་རྒྱ་ལྔ་དང་།",
    "ཡབ་ཀྱི་ཞབས་གཡས་བརྐྱང་ཞིང་གཡོན་འགྱིང་བ་དང་བཅས་ཅུང་ཟད་བསྐུམས་པས་བདུད་བཞི་བརྫིས་པའི་སྐུ་ལ་ཡུམ་གྲི་ཐོད་འཛིན་པའི་ཕྱག་གིས་འཁྱུད་ཅིང་ཞབས་ཀྱིས་འཁྲིལ་བ།",
    "ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་པ།",
    "མེ་དཀྱིལ་དམར་པོ་གྲུ་གསུམ་སེན་མོ་ཙམ་པ་བརྩེགས་པའི་སྟེང་དུ།",
    "ཞེས་མོས་ནས།",
    "སྐབས་འདིར་ཐུན་རེ་རེ་བཞིན་ནམ།",
    "ཉིན་རེ་གཏོར་མ་རེ་ངེས་པར་འབུལ་དགོས་པས།",
    "བསང་ཆུའི་སྟེང་དུ་ཧཱུྃ་བཞིའི་སྔགས་ཕྲེང་མཐིང་ཀ་གཡས་བསྐོར་དུ་འཁོད་པ་རང་སྒྲ་སྒྲོགས་ཤིང་འོད་ཟེར་སྔོན་པོ་འཕྲོ་བས་རྒྱལ་བ་ཀུན་གྱི་མཐུ་བྱིན་བསྡུས་ཏེ་དེ་ཉིད་ལ་ཐིམ་པར་མོས་ལ་ཧཱུྃ་བཞིའི་སྔགས་ཉེར་ཅིག་ཙམ་བཟླས་མཐར།",
    "ཧཱུྃ་གིས་སྦར་ཏེ་ཁ་དོག་དྲི་རོ་ནུས་པ་ཕུན་ཚོགས་སུ་བྱས།",
    "བར་གྱིས་རིག་མ་བཅུ་དྲུག་གིས་གསང་མཆོད་བཅས་སྔགས་ཙམ་མམ།",
    "བདག་ཉིད་གཙོ་བོའི་སོགས་དམིགས་པ་རྣམས་དང་བཅས་གཙོ་བསྙེན་བརྒྱ་རེ་ཙམ་བཟླས།",
    "སྣོད་བཅུད་ལྷའི་དཀྱིལ་འཁོར་སོགས་ནས་ཕྲ་ཐིག་རྣལ་འབྱོར་ཡང་ཤར་སྒོམ་རེ་བྱས་མཐར།",
    "བདག་གི་ལུས་འདི་ཀ་རང་བཞིན་གྱིས་རྟེན་དང་བརྟེན་པའི་ལྷའི་དཀྱིལ་འཁོར་ཆེན་པོ་ཉིད་དེ།",
    "དེ་ལ་འཁྱུད་པའི་རྩ་འདབ་སོ་གཉིས་ཐམས་ཅད་དཔའ་མོ།",
    "དེ་ལ་འཁྱུད་པའི་རྩ་འདབ་བརྒྱད་དཔའ་མོ།",
    "ཐབས་ཀྱི་འཁོར་ལོ་དེ་གཉིས་དཀར་པོ་ཡིག་འབྲུ་དང་བཅས་པ་ཆུ་ཤིང་གི་མེ་ཏོག་ལྟར་ཁ་འོག་ཏུ་ཕྱོགས་པ།",
    "དེ་ལ་འཁྱུད་པའི་རྩ་འདབ་མ་བཅུ་དྲུག་དཔའ་མོ།",
    "དེ་ལ་འཁྱུད་པའི་རྩ་འདབ་དྲུག་ཅུ་རྩ་བཞི་དཔའ་མོ།",
    "མིག་གི་ལྟ་སྟངས་ཐད་ཀར་གཏད་ལ།",
    "དབུས་ཀྱི་ཡི་གེ་ལ་གཡས་སུ་གསུམ་རེ་བསྐོར་ཏེ།",
    "འཁོར་ལོ་བཞི་ཀའི་དབུས་ཀྱི་ཡི་གེ་ལ་གཡོན་དུ་ལན་གསུམ་བསྐོར་ཏེ་གཡོན་གྱི་ཆ་འབའ་ཞིག་བརྒྱུད་ནས་ཨ་ཤད་ཀྱི་གནས་ཚུན་དུ་འོང་བར་མོས།",
    "ལུས་ནང་གི་རྩ་ཡིག་བཀོད་པ་ཐམས་ཅད་མིག་ལ་གཟུགས་སྣང་བ་བཞིན་མ་འདྲེས་གསལ་བར་སྣང་བར་མོས།",
    "ལག་གཡོན་མཛུབ་མོས་སྣ་གཤོགས་གཡོན་པ་མནན་ནས།",
    "ལག་གཡས་མཛུབ་མོས་སྣ་གཤོགས་གཡས་མནན་ཏེ།",
    "སྣ་བུག་གཉིས་ཀ་ནས་ཕྱིར་འབུད་ལན་གསུམ་བྱས་རྗེས།",
    "ཨ་ཤད་ལ་ཕོག་པས་རྡོ་རྗེ་སྙེམས་མ་སད་པར་བྱས་པས་དེ་དམར་ལམ་གྱི་སོང་།",
    "མེ་ལྕེ་ཕྲ་མོ་མདུང་ཚུགས་སུ་འབར་བར་མོས།",
    "བདེ་ཆེན་གྱི་འཁོར་ལོའི་རྩ་ཐམས་ཅད་དཔའ་མོའི་རང་བཞིན་དམ་ཚིག་གི་གཟུགས་སུ་གནས་པར།",
    "ཁམས་དམར་ཆའི་དྭངས་མའི་རང་བཞིན་འབར་བའི་རླབས་ཡེ་ཤེས་ཀྱི་རང་བཞིན་དུ་ཞུགས་པས་རྩ་གནས་ཐམས་ཅད་བདེ་བའི་ཡེ་ཤེས་འཕེལ་བར་མོས་ལ་འབད་པ་ནི་འབར་རྐྱང་སྟེ།",
    "དྲོད་ཅུང་ཟད་རེ་སྐྱེས་ཀྱང་དེ་བརྟན་པོར་མི་འོང་བས་རྩ་འཁོར་གྱི་གནས་རེ་རེ་བཞིན།",
    "སྔོན་ནས་གཏུམ་མོའི་ཉམས་ལེན་ལ་གོམས་མྱོང་ལྡན་ན།",
    "མགྲིན་པའི་འཁོར་ལོ་ལག་པའི་སོར་མོའི་རྩེ་ཚུན་ཆད།",
    "རོ་རྐྱང་བརྒྱུད་དེ་སོང་བ་དང་།",
    "སླར་ཡང་མེ་ལ་སྣུམ་གྱིས་རེག་པ་བཞིན་མེ་ཆེར་འབར་རིམ་བཞིན།",
    "གཏུམ་མོའི་ཨ་ཤད་རྡོ་རྗེ་སྙེམས་མས་རྩ་ཐམས་ཅད་རྣལ་འབྱོར་མ་རྣམས་བྱིན་གྱིས་བརླབས་པས་ལུས་ཀྱི་ནང་རྩ་ཐམས་ཅད་མགར་བའི་ཐབ་ཏུ་ལྕགས་གོང་བསྲེགས་པ་ལྟར་དམར་ལམ་གྱུར།",
    "མཐོང་སྣང་ཐམས་ཅད་གཏུམ་མོ་ཡེ་ཤེས་ཀྱི་མེར་སོང་བས།",
    "འབྲས་བུ་སྐུ་རྡོ་རྗེ་མངོན་སུམ་དུ་གྲུབ་པར་མོས།",
    "མིག་གི་ལྟ་སྟངས་གྱེན་དུ་གཏོད་པ་སོགས་སྦྱོར་བ་དྲུག་ལྡན་འཇམ་པོས།",
    "ཐུན་བར་དུའང་དེ་རྣམས་གསལ་འདེབས་ཤིང་བདེ་སྟོང་གི་ཉམས་དྲན་པར་བྱ་བ་ཐུན་བཞི་ཀར་རོ།",
    "རིམ་པ་རེ་རེ་བཞིན་ལོ་ཟླ་ཅི་རིགས་པར་མྱོང་བ་ཐོན་པར་བསྒོམས།",
    "དེས་གཏུམ་མོའི་བདེ་དྲོད་རྒྱས་པས་རྩ་ཁ་བྱེ།",
    "ནང་གི་བདེ་བས་ཡིད་འཕྲོག་ཕྱིའི་འདོད་པ་ལ་བློ་མི་འཇུག།",
    "སྙིགས་མའི་ཁམས་ཐམས་ཅད་དྭངས་མར་སོང་།",
    "བདག་གི་བཟང་པོ།",
