    "བདེན་པ་གཉིས་གཞིས་སུ་མེད་པར་གྱུར་པའི་སྐད་ཅིག་རྫོགས་པ་ནི་རྟོགས་པ་སྟེ།",
    "དེ་ལ་བསམ་གཏན་། གྱིས་སེམས་བརྟན་པར་ཡང་ནི་བྱེད་དེ་ཕྱི་རོལ་དངོས་པོ་རྣམས་ནི་རྣམ་པར་སྤོངས།",
    "ཞེས་པ་ལསོགས་པ་ཚིགས་སུ་བཅད་པ་གསུམ་གྱིས་སོ་སོར་སྡུད་པ་ལ་སོགས་པའི་འབྲས་བུ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་ལྷའི་རྣ་བ་ལ་སོགས་པར་འགྱུར་བའི་ཕྱིར་མངོན་ཤེས་ལྡནི་ཐོབ་པར་འགྱུར་ཞེས་སོ།",
    "རྗེས་དྲན་མཉམ་པར་སྦྱོར་བ་ཡིས་ཤེས་པ།",
    "རྗེས་སུ་དྲན་པ་མཉམ་པར་སྦྱོར་བ་གཟུགས་བརྙན་ལའཁྱུད་པའི་སེམས་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བ་དེའི་ཚེ།",
    "བ་སྤུའི་ཁུང་བུ་ནས་འོད་ཟེར་ལྔ་འཕྲོ་བ་དད་ངེས་པར་རྒྱ་བར་འགྱུར་རོ།",
    "དེ་ལས་ཕྱི་མའི་དུས་སུ་བདེན་པ་གཉིས་གཉིས་སུ་མེད་པར་གྱུར་པའི་མཚན་ཉིད་ཡང་དག་པའི་ཚུལ་གྱིས་བདག་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་རྟོགས་པ་ནི་འབྲས་བུ་ཡང་དག་པར་འགྱུར་རོ་ཞེས་པའི་རིམ་པའོ།",
    "གདོལ་པ་མེ་ལ་རྗེས་སུ་དྲན་པ་པདྨ་འཛིན་པར་འགྱུར་ཏེ་དཔལ་ལྡན་ཏིང་འཛི་ན་འཁོར་ལོ་ཅན།",
    "བསམ་གཏནམི་བསྐྱོད་པ་ཉིད་དོཞེས་པ་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་སྟེ་རྣམ་པ་བརྩ་སྟེ་བསྙུནི་ཡུལ་དང་ཡུལ་ཅན་བཅུ་པོ་རྣམས་གཅིག་ཉིད་དུ་སྣཚོ་གས་གཟུགས་ལ་བསམ་གཏན་པའོ།",
    "ད་ནི་སོ་སོར་སྡུད་པ་ལ་སོགས་པའི་མཚན་ཞིད་གསུངས་པ།",
    "འདིར་སེར་སོར་སྡུད་པ་ཞེས་བྱ་བཞི་ལུས་ལ་ཡུལ་དང་ཡུལ་ཅན་བཅུ་པོ་རྣམས་ཀྱི་འབྲེལ་པསརྣམ་པར་ཤེས་པ་རབ་ཏུ་འཇུག་པ་མེད་པ་སྟེ།",
    "འཁོར་ལོ་ཅན་གྱི་ཞེས་པ་གཙུ་ག་ཏོར་གྱིས་ཁྲོ་བོའི་ལྟ་བས་ཤེས་པ་མིག་མི་འཛུམས་པར་སྟེང་དུ་ལྟ་བས་མཚན་མར་འགྱུར་ཏེ།",
    "དེ་ལྟར་གཟུགས་ཀྱི་མཐར་ཐུག་པར་སོ་སོར་སྡུད་པ་དང་བསམ་གཏན་གྱིས་བསྟན་པའི་ཡན་ལག་ཏུ་འགྱུརརོ།",
    "བདེ་བ་མཉམས་གཅིག་པུ་ཞི་བཞེས་པ་འདིར་བདེ་བ་མ་ཉམས་པས་བྱང་ཆུ་བ་ཀྱི་སེམས་ཀྱི་སྐད་ཅིག་གཅིག་པུ་གང་ཡིན་པ་དེ་ནི་ཞི་། བ་ཞེས་གསུངས་ཏེ།",
    "ལྷའི་སྒྲུབ་ཐབས་ལ་བསྐྱེད་པའི་རིམ་པས་སྔར་གསུངས་པ་སྟེ་འཇིག་རྟེན་པའོ།",
    "གང་ཞིག་རྣམ་མཁའ་ལ་རྩལ་འབྱོར་གོམསཟླ་པར་བྱེད་པ་དེས་མཚན་མབུག་པ་མེད་པའི་ཁྱིམ་དུ་མུན་པ་ལ་ནམ་མཁའ་ཀུནནསཞན་པའི་སེམས་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་སྔངས་པ་ཡིས་སྟོང་པར་རྩེ་གཅིག་པའི་ཡིད་དུ་བྱས་ནས་ཞི་མ་གཅིག་ཡོངས་སུ་བརྟག་པར་བྱའོ།",
    "དེ་ལ་ཀུན་མཁྱེན་གཟུགས་ནི་ཆུ་ལཤི་མ་ལྟ་བུ་གོས་པ་མེད་བ་ཁ་དོག་སྣ་ཚོགས་ཏེ།",
    "ཞང་དུ་འདུས་པ་ཀུན་མཁྱེན་གཟུགས་ནི་ཁམས་གསུམ་པ་མ་ལུས་པ་ཚུལ་ཞིམ་ལྟ་བུ་གོས་པ་མེད་པ་ཁ་དོག་སྣ་ཚོགས་ཏེ།",
    "རྣམ་པ་ཀུན་ལྡནརང་སེམས་ཡུལ་དང་རྣམ་པར་བྲལ་བ་དག་གོ་སེམས་ནི་གཞན་པ་མིན་པ་ཞིད།",
    "དགའ་བཞེས་བྱ་བ་དངོས་བོ་ཐམས་ཅད་ལ་སེམས་གནས་པ་དང་།",
    "དེ་ནམ་རྗེས་སུ་དྲན་པཞེས་བྱ་བ་ནི་རང་འདོད་པའི་ལྷམ་ཐོང་བ་གཟུགས་བརྙན་གྱི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་སྟེ།",
    "དེ་ཞིད་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "དེའི་ཕྱིར་ཡོད་པ་དང་མེད་པའི་བློ་ཡོངས་སུ་སྤངས་ཏེ་རྟེན་མེད་པར་བྱས་ནས།",
    "ཨ་གསུམ་པོ་ནི་བསྒྲུབ་པར་བྱ།",
    "དེའི་ཕྱི་ནས་སྨིག་རྒྱུ་སྟེ་དུ་བ་ལ་སོགས་པ་དེ་ཞིད་རྣམ་པར་རྟོག་པ་བྲལ་བ་ཕྲ་ཕབ་པ་ལྟ་བུའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འདུས་པ་ཕྱི་མ་དང་མཁའ་འགྲོ་མ་རྡོ་རྗེ་གུར་ངུ་ཡང་གསུངས་སོ།",
    "མཁའ་འགྲོ་མ་རྡོརྗེ་གུར་དུ་དེའི་སྟེང་དུ་ཚུ་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "དེའི་ཐམས་ཅད་མཁྱེན་པའི་རྒྱུ།",
    "ཁཅིག་གྲུབ་པའི་དུས་སུཞེས་སུ་བར་འགྱུར་བ་དེ་ཐམསཅད་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་དམ་བཅའ་འཇོམས་པར་བྱེད་པ་སྟེ།",
    "ཅེས་པའི་བཅོམ་ལྡན་འདས་ཀྱིས་བ་ཀའ་ལ་རྣམ་པར་མཐོ་འཚམ་པའོ།",
    "དེ་བཞིན་དུ་མཁའ་འགྲོ་མརྡོ་རྗེ་གུར་དུ་བཅོམལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "འོད་ཆེན་རྣམ་པར་སྣང་བར་བྱེད།",
    "སྔར་བརྗོད་པའི་སྤྲིན་མེད་པའིནམ་མཁའ་ལས་བྱུང་བའིང་བཏུ་སྣང་བ་གང་ཡིན་པ་དེ་ནི་ནམ་མཁའ་ལས་བྱུང་ངང་བྱུང་བ་སྟེ་སེམས་རྣམ་པརརྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "པྲ་ཕབ་པ་དང་མཚུངས་པར་རྣལ་འབྱོར་པས་སོ་སོར་སྡུད་པས་མཐོང་བའོ།",
    "ག་ཡོ་བའི་རང་བཞིན་གྱི་བདག་ཉིད་ནི་བསྒྲུབ་པར་བྱཞེས་པའོ།",
    "དེ་བཞིན་དུ་མཁའ་འགྲོ་མ་རྡོརྗེ་གུང་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "མ་ལུས་ལུས་པ་མེད་པར་འགྲུབ།",
    "དེ་བཞིན་དུ་དཔལའདུམ་པར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "རྣམ་པར་མ་བརྟགས་པ་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བྱུང་བའི་དངོས་པོ་མེད་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "ཀོ་ཤི་ཀ་གང་བླ་ཁབ་མེད་པ་ལ་རྣལ་འབྱོར་དུ་བྱེད་པར་འདོད་པ་དེ་པེ།",
    "དེ་ལྟར་ཐིག་ལེའིགནས་སུ་གོང་བུའི་གཟུགས་ཀྱིས་སྲོག་འགགས་པ་སྟེ་དེ་ཉིད་ཀྱིས་ན་དེ་འཛིན་པར་བརྗོད་དོ།",
    "ཡས་། དེ་ནས་དེའི་ཡེ་ཤེས་ཀྱིས་འོདཟེར་གྱིས་ཕུང་པོ་དང་ཁམས་དར་སྐྱེ་མཆེ་ད་ལསོགས་པ་རྣམས་བསྲེགས་ཏེ་གཡོན་པ་དང་གཡས་བའིརྩར་བགྲོད་པ་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དང་ས་ལ་སོགས་རྒྱུད་ཁ་པའི་དཀྱིལ་འཁོར་གྱི་རང་བཞིན་རྣམས་དཔྲལ་བར་ཟླ་བའི་དཀྱིལ་འཁོར་ལརབ་ཏུ་ཞུགས་པ་གཅིག་ཏུ་འདྲེས་པར་འགྱུར་རོ།",
    "ཡང་ན་རྣམ་པ་སྣ་ཚོགས་པ་དང་རྣམ་པར་སྨིན་པ་དང་རྣམ་པར་ཞེད་པ་དང་མཚན་ཞིད་དང་བྲལ་བའི་རང་བཞིན་གྱིས་སོ།",
    "ཅན་མ་གང་ཡིན་པ་དེ་ནི་བྱིས་པའི་རྣལ་འབྱོར་པརྣམས་ཀྱི་གནས་སྐབས་ཀྱི་འབྲས་བུར་ཤེས་བར་བྱའོ།",
    "དེ་ཡི་ལྷ་མ་ཆོག་སྟེར་བར་འགྱུར་ཏེ་སྲོག་མ་བསྡམས་པར་རག་ཏུ་བརྗོད་པས་ནིམ་ཡིན་ནོ།",
    "དྲང་བའི་དོན་གྱིས་ནི་ཕྱི་རོལ་ཏུ་ལྷ་སྨྲོས་པས་སོ་ཞེས་པ་ཉེ་བར་སྒྲུབ་པའོ།",
    "ད་ནི་སྒྲུབ་པ་གསུངས་པ།",
    "དགའ་བཞེས་པ་ལ་སོགས་པའོ།",
