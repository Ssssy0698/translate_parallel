    "འོད་གསལ་བ་དང་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་སོགས་པས་རྗེ་གས་པར་གྲུན་པའི་སྐུ་ཐོབ་པར་འགྱུར་གྱི།",
    "ལུས་བེ་རྣམ་པ་ཐམས་ཅད་དུ་མེད་པར་གྱུར་པ་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་རྒྱུབ་དང་མི་རྒྱུ་བའི་དངོས་པོ་ཐམས་ཅད་གང་ཡིན་པ་དེ་རྣམས་ཀྱང་སྒྲིབ་པ་མེད་པར་སྒྱུ་མ་དང་རྨི་ལམ་བཞིན་དུ་མཐོང་བར་གྱུར་པའོ། གཞན་ཡང་གང་དངོས་གྲུབ་ཇི་ལྟ་བུར་འགྱུར་ཞེ་ན།",
    "དེ་ནས་ཕུང་བ་ལ་སོགས་པ་སྒྲིབ་པ་མེད་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་བསྒྲུབ་པའི་ཕྱིར་སོ་སེར་སྡད་པ་དང་བསམ་གཏན་གྱི་དབུས་མ་ཨ་བརྙ་དཱི་བསྒྲུབ་པར་བྱའོ།",
    "འཛིན་པའི་ཡན་ལག་གཞིས་བསྒྲུབ་པརབྱའོ།",
    "གཞན་ཡང་ལུས་ལ་སོགས་པའི་སྡུག་བསྔལ་གྱིས་ཕལ་པ་རྣམས་ཀྱི་དངོས་གྲུབ་གང་མི་ཐོབ་པ་དེ་ཉིད་རང་བཞིན་མེད་པའི་བསམ་གཏན་གྱི་སྟོབས་ཀྱིས་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཐོབ་པར་གྱུན་པའོ།",
    "བཅོམ་ལྡན་འདས་འཇམ་དཔལ་གྱིས་གསུངས་སོ།",
    "དེ་བཞིན་དུ་སྒྲ་གཅན་ལ་སོགས་པས་ལུས་ཀྱི་དབྱེ་བ་ལ་སོགས་པ་བསྟན་པར་མཛད་ནྲ།",
    "གཅིགཅེས་བྱ་བ་ལ་སོགས་པ་ལ་འདིར་ཟླ་བས་གཅིག་བརྗོད་པར་ཤེས་པར་བྱའོ།",
    "དནི་རྒྱུད་ཀྱི་ཡོན་ཏན་བརྗོད་པར་མཛད་དེ།",
    "ང་ནི་ལས་དང་བེ་པ་རྣམས་ཀྱི་སྐྱོན་དང་ཡོན་ཏན་རྗོད་པར་མཛད་དེ།",
    "སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱིས་བདག་ཉིད་ལ་ཕན་འདོགས་པའི་ཕྱིར་སྐྱོན་ཐམས་ཅད་དེར་ནས་ཁྱད་པར་དུ་ཡོན་ཏན་རྣམས་ཞེན་པར་བྱ་བའི་ངེས་པའོ།",
    "ད་ནི་རྩ་བའི་རྒྱུད་དད་སྡུས་པའི་རྒྱུད་ཐ་མི་དད་པའི་རང་བཞིན་བསྟན་པར་མཛད་དེ།",
    "བསྟན་པར་གྱིས་ཞེས་བྱ་བ་ནི།",
    "འཁོར་གྱི་ཡོན་ཏན་བརྗོད་པར་མཛད་དེ།",
    "གཞན་ཡང་གདུལ་དཀའ་བར་གྱུར་པའི་སེམསཅན་གདུལ་བའི་ཕྱིར་འཇིགས་པར་གྱུར་པའི་ཞལ་མང་བ་དང་།",
    "ཕྱག་རྣམས་མཚོན་ཆ་དུ་མ་དད་ལྡན་པར་གྱུར་པར་གཤིན་རྗེ་གཤེད་ལ་སེགས་པ་སྤྲུལ་པའི་སྐུ།",
    "མཇིག་པའི་མུན་པ་འཇོམས་པར་མཛད་ནས་ཁྱེད་ནི་ཉི་མ་བཞིན་དུ་གྱུར་པའོ།",
    "དེ་ལྟར་དའཁོར་དང་ལྷན་ཅིགཏུ་བཅོམ་ལྡན་འདས་འཇམ་དཔལ་ལ་ཉི་མའི་ཤིང་རྟས་བསྟོད་པ་བྱས་ནས།",
    "བསྟན་པར་མཛད་ནས།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེསམས་དཔའི་བརྗོད་པར་བྱེད་པར་གྱུར་པ་དང་།",
    "བསེདནམས་ཀྱིས་ཚོགས་གང་བསགས་པ་དེས་སེམསཅན་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བའི་གོ་འཕངས་ཐོབ་པར་གྱུར་ཅིག།",
    "དེ་རྣམས་གསོད་པར་བྱེད་པ་ནི་རོ་ལྡན་ན་གནས་པ་གནོད་སྦྱིན་གྱི་བདག་པོ་ཆེན་པོ་སྟེ།",
    "དེ་རྩ་བའི་རྒྱུད་དུ་གསུངས་པ།",
    "དེར་ནི་སྟོན་པ་ཤར་གྱི་ཞལ་ རིན་ཆེན་སེང་གེའི་ཁྲི་ལ་བཞུགས།",
    "ལྷ་ཡི་རྣམ་པར་བཀྲ་པའི་རྒྱན་ ལྷ་ཡིས་གོས་དང་རྔ་ཡབ་དང་།",
    "བསམ་པས་ཡིད་ཀྱིས་སེམས་དཔར་བྱེད།",
    "དང་པོར་གཡས་སུ་བསྐོར་བྱས་ནས།",
    "སྟོན་པ་སྡུང་པར་བྱེད་། པ་པོ་ ཞེས་བའོ།",
    "ཡང་དག་པར་སྟོན་པར་མཛད་པ་ཉིད་ཀྱིས་ཀྱེ་སྟོན་པཞེས་བོད་པའོ།",
    "དེ་རྩ་བའི་རྒྱུད་དུ་གསུངས་པ།",
    "འཁོར་སུ་ཡིས་ཡོངས་སུ་བསྐོར་ནས་བཅོམ་ལྡན་འདས་ཀྱས་བཀའ་སྩལ་ན་དཔལ་ལྡན་འབྲས་སྤུངས་སུ་ངེས་པར་སྔགས་ཀྱི་ཚུལ་བསྟན་པ་སྟེ།",
    "རྩ་བའི་རྒྱུད་དུ་གསུངས་པ་ཡང་།",
    "དེ་བཞིན་གསང་སྔགས་ཚུལ་རབ་གསུངས།",
    "འཁོར་ནི་སུ་ཡིས་རྒྱུ་ཅི་ཡིན་ བྱ་རྒོད་ཕུང་བོའི་རི་ཆེན་པརོ།",
    "གོ་སྐབས་མེད་པར་རབཏུ་གསལ།",
    "ཨེ་ཡིག་རྣམ་པར་ཡང་དག་གནས་ཞེས་པའོ།",
    "ཀུན་མཁྱེན་སྟོན་པ་རྡོ་རྗེ་འཛིན།",
    "མཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བའི་ཐབས་ཞིད་ཀྱི་ཕྱིར་གསོལ་བ་མ་བཏབ་པར་ཡང་ངོ།",
    "དེ་ཉིད་ལྷནཅིག་སྐྱེས་པའི་སྐུ་ཤེས་རབ་དང་ཐབས་ཀྱི་བདག་ཞད་རྣམ་པར་དག་པའི་རྣལ་འབྱོར་ཞེས་བརྗོད་དོ།",
    "དེ་ཉིད་ལྷན་ཅིག་སྐྱེས་པའི་སྐུ་སྟོང་པ་ཉིད་ཀྱིརྣམ་པར་ཐད་པས་རྣམ་པར་དག་པ་ཡེ་ཤེས་རྡོརྗེ་ཐམས་ཅད་མཁྱེན་པ་ཤེས་རབ་དང་ཐབས་ཀྱི་བདག་ཉིད་རྣམ་པར་དག་པའི་རྣལཉ།",
    "བསྐྱེད་པའི་རིམ་པས་ཕ་མ་གཉིས་ཀའི་ཐིག་ལེ་རོམཉམ་པར་གྱུར་པ་དང་ཀུན་གཞི་རྣམ་པར་ཤེས་པམའི་གསང་བའི་འཁོརལོརཞུགས་པ་ན།",
    "དེ་ནས་མངལ་ནས་འཐོན་ཏེ་སྒྱུ་མའི་དྲབ་ལྟརམཐའ་ཡས་། པའི་དངོས་པོ་ཡང་དག་པར་རི།",
    "རྫོགས་པའི་རིམ་པས་ཡྻནི་དུབ་ལསེགས་པ་མཚན་མ་བཅུ་པོ་རྣམས་ཀྱི་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་དང་ཤིན་ཏུ་ཆེན་པོའི་དབྱེ་བས་བཞི་པོ་རྟོག་པར་བྱའོ།",
    "མཚན་ཡང་དག་པར་བརྗོད་པར་ཡང་།",
    "ཞི་བ་ནི་སད་པའི་གནས་སྐབས་ཟད་པས་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་སྟེ།",
    "འདི་རྣམས་སྲིད་པ་གསུམ་པེ་རྣམས་ཀྱིས་ཕྱག་བྱས་རྒྱལ་བ་བདེ་འབྱུང་གཅིག་པུའི་འཁོར་ལོ་གཅིག་ཡིན་ནོ།",
    "དང་པར་ཞེས་པ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གཉིས་ནི་། གསལ་ལོ།",
    "རྒྱལ་བ་ལ་སོགས་གཉི་གའི་རིགས་སུ་གྱུར་པ་སྐུ་གསུང་ཐུགས་ཀྱིས་ཕྱི་བརྣམས་ཀྱི་བསྲུང་བྱས་ཤིང་།",
    "སེམསཅན་རྣམས་ཀྱི་ཐད་པའི་སླད་དུ་ཆེ་གེ་བདག་ཀྱང་གཙོ་བོའི་དཀྱིལ་འཁོར་དག་ནི་བཞེངས་པར་བགྱིད།",
    "ལྟེ་བར་ལཱ་ཡིག་དང་མགྲིན་པར་རཱྀ་ཡིག་དང་གསང་བར་ཨཱ་ཡིག་སྟེ།",
    "ཞེས་པ་ཨ་ཨི་རྀ་ཨུ་ལྀ་གོང་ཞེས་པའི་དབྱངས་ལྔ་བ་རྣམས་ཀྱིས་བསྲུད་བ་བྱས་ནས།",
    "ད་ནི་བུམ་པ་གསུངས་པ།",
    "དེ་ནས་ཞི་བ་དང་རྒྱས་པའི་མཚན་ཉིད་གསུངས་པ།",
    "སེར་བརྒྱད་ཆ་གསུམ་བྱས་ནས་ཆ་གཉིས་ཀྱིས་མགྲིན་པའི་བུག་པའོ།",
    "དེ་རྣམས་ཀྱད་རི་བོང་འཛིན་པ་ལྟར་དཀར་ཞིང་རྒྱས་དག་ལའོ་གཞན་ལ་མིན་བུམ་པར་མི་འགྱུར་རོ་ཞེས་པའོ།",
    "ཤེལ་། དང་དངུལ་གྱི་བུམ་པ་རྣམས་མེད་ན་སའི་རང་བཞིན་གྱི་བུམ་པ་ནག་པོ་དང་རྩ་བ་མེད་པརྣམས་ས་ལི་བཏགས་པ་འམ་ཙནྡན་གྱིས་བྱུགས་ཏེ་དཀར་པོར་བྱའོ།",
    "དེ་ནས་རྡོ་རྗེ་བུམ་པ་ལྷག་བར་གནས་པ་བརྗོད་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་དྲི་ལ་སོགས་པ་ཕུལ་ནས་རྣམ་པར་རྒྱལ་པའི་བུམ་པ་གཞག་པར་བྱའོ།",
    "ཞེས་པ་བུམ་པ་ལྷག་པར་གནས་པའོ།",
    "དང་པོའི་དཀྱིལ་འཁོར་ལ་གསོལ་བ་གདབ་པའི་དུས་དང་བར་དུ་ས་ལ་སོགས་པ་གཟུང་བ་དང་མཐར་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་དུས་ཐམྲཅདདུ་མཎྜལ་བྱས་ནས་སོ་ཤིང་བྱིན་ཏེ་དེ་ནས་བསྲུང་བ་བྱའོ།",
    "དེ་ལ་འདི་ནི་ཆོ་ག་སྟེ་ཁྲུས་བྱས་ཤིང་གོས་གཙང་མ་བགོས་ཏེ་ཞི་བ་ལ་སོགས་པའི་ལས་དང་རྗེས་མཐུན་པའི་ས་དེ་ཉིད་ལ་མཎྜལ་བྱས་ནས།",
    "འདིར་སྔར་བརྗོད་པའི་ཆོ་གས་ལྷ་རྣམས་དམིགས་པརབྱས་ཏེ།",
    "ལས་སོ་སོ་ལས་ནི་རྒྱས་པ་ལ་སོགྶ་པ་ལ་སྭཱཧཱ་མཐར་རིག་པར་བྱའོ།",
    "ཨོཾ་ཙུན་ཡེ་ནམ་ཨོཾབྷཾཀུའྱི་ན་མ་ཨོཾཤགྲ་། མཱ་རཱི་ཛྱེ་ན་མ་ཨོཾ་པྲ་ཏྱེ་ཀ་མཱུ་ས་བྷེ་དེ་ན་ཥཥྛིཨུཏྟར་ཏྲིཤཏབཛྲ་ཏིཟི་དེབིབྷྱོ་ན་མ་ཨོཾཥ་ཊ་ཏྲི་ཤཏྠརྰཙྪ་དྩོན་མ་ཨོ་བཛྲ་ཛ་ཡཱ་ཡ་ན་མ",
    "རྣམ་པ་བཅུ་ཡར་རྒྱུད་དུ་གསུངས་པ་རྣམས་སོ།",
    "དི་རིང་ཉིད་ནས་མི་བཟད་འཁོརབས་འཇིགས་པས་བདག་ཞི་རྒྱལ་བ་རྣམས་ལ་སྐྱབས་སུ་ལྷག་པར་མཆི།",
    "དེ་རིང་ཉིད་ནས་བད་ཉིད་རྒྱལ་བ་རྣམས་ལ་སྐྱབས་སུ་ལྷག་པར་འཆི་སྟེ།",
    "ཡིད་བཞིན་གྱི་ནོར་བུ་བསྒྲགས་ནས་སྦྱིན་པ་སྦྱིན་པར་བགྱིའོ།",
    "ཁྲུས་བྱས་དྲི་ཡིསརྗེས་སུ་བྱུགས་པས་བརྟུལ་ཞུགས་ངེས་པ་དང་ལྡན་ཤར་ཀྱིས་ས་ལ་བཞག་བྱས་ཏེ།",
    "དེ་ནས་འགྲུབ་པར་འགྱུར་ཏེ་དྲན་བ་ཙམ་གྱི་ཁྲོ་བོ་འབེབས་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་ཁྲོ་བའི་རྒྱལ་པོ་ཕེབས་པ་ནི་ངོ་ཚ་མེད་ཅིད་དོགས་པ་མེད་པར་འགྱུར་ཏེ།",
    "འདིར་ཡང་རྒྱ་ཆེར་གཞན་ཁྲོ་བོ་བཅུ་པེ་རྣམས་ཀྱི་རང་བཞིན་བཅུ་པོ་རྣམས་ནི་ཕྱག་རྒྱ་བཅིདགཅིག་གཅིག་བས་རིག་པར་བྱའོ།",
    "དེ་ནི་དེ་ཡི་ས་ཤེས་པར་བྱའོ།",
    "ཀུན་རྫོ་བ་དོན་དུ་བརྟུལ་བཞུགས་རབ་མཆོག་བགྲོད་པ་དག་ལ་བགྲོད་པ་དེ་རྣམ་གཉིས་ནི་སྦྱིན་པར་བྱ།",
    "དེ་ནས་ཨོཾ་ཨཱ་ཧཱུཾ་ཡི་གེ་གསུམ་གྱིས་མེ་ཏོག་མངོནཔར་སྔགས་ཏེ་མགོ་བོར་སྦྱིན་པར་བྱའོ།",
    "དེ་ནམ་སྲུང་བབྱས་ནས་ལུས་ལ་སེར་པོའི་གོས་དག་བྱིན་ཏེ།",
    "འདྲེན་བྱེད་བསྒྲིབས་པར་གྱུར་པའི་སློབམ་དཀྱིལ་འཁོར་འདིད་ནི་གཞུགས་པ་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ནས་གལ་ཏེ་འདོད་ན་དེའི་ཚེ་གཞན་རྣམས་སྦྱིན་པར་བྱའོ།",
    "ད་ནི་དཀྱིལ་འཁོར་དུ་འཇུག་པགསུངས་པ།",
    "ལག་པའི་པདྨ་སྦྱར་བར་མེ་ཏོག་གཅིག་ནི་སྦྱིན་པར་བྱ།",
    "རབ་ཏུ་གནས་པར་བྱས་པའི་རྡུལ་ཚོ་ན་གྱི་དཀྱིལ་འཁོར་སུབས་པ་ལས་མཆོད་རྟེན་འཇིག་པའོ།",
    "དེ་ཕྱིར་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ལ་མཚན་མ་ལྔ་བྱས་ནས་དེར་མེ་ཏོག་དོར་བར་བྱའོ།",
    "རྡུལ་ཚོ་ན་གྱི་དཀྱིལ་འཁོར་ནི་བཅོམ་ལྡན་འདས་ཀྱི་སྐུར་རག་པར་བྱའོ།",
    "ཡང་ན་སྔར་མེ་ཏོག་དོར་བར་བྱས་ལ་ཕྱི་ནས་དགྲེལ་བར་བྱ་སྟེ།",
    "འདིར་ཀླུཞེས་པ་བརྒྱད་དང་ཡང་ན་བཞིའི་རྒྱལ་དང་རྣམ་རྒྱལ་བུམ་པ་རྣམས་ཀྱིས་ཞེས་པ་བུམ་པ་བརྒྱ་དཀྱི་ཕྱོགས་ལ་རྒྱལ་བའི་བུམ་པ་ལྔ་དང་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ལྔ་རྣམས་ཀྱིས་སོ།",
    "བུམ་པ་བཞིའི་ཕྱོགས་ལ་རྒྱལ་བའི་བུམ་པ་གསུམ་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ཡ་།",
    "སློབ་དབོན་གྱི་རྩ་བའི་རྒྱུད་ལས་གསུངས་པའི་ཆོ་གས་ཉི་ཤུ་རྩ་ལྔ་བ་རྣམས་ཀྱི་ནང་ནས་ཇི་ལྟར་སྙེད་པ་ལྔ་བཟུང་བར་བྱའོ།",
    "དེ་བཞིན་དུ་སྙན་རྣམས་ཏེ་ཆ་གཅིག་པ་ནི་རྒྱལ་བ་དང་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ལའོ།",
    "དེ་ལྟར་ད་བང་བསྐུར་བ་གཉིས་ཀྱིས་ཁམས་དང་ཕུང་པོ་རྣམ་པར་དག་པས་ལུས་རྣམ་པར་འགྱུར་རོ།",
    "སྐུའི་ཞལ་གྱི་སར་ལུས་རྣམ་པར་དག་པར་བྱས་ཏེ།",
    "འདི་ལྟ་སྟེ་ངེས་པར་རྡོ་རྗེའི་རིགས་དག་ལ་ནི་སྲོག་གཅོད་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་བསྡུས་པའི་རྒྱུད་དུ་རྔུལ་སོགས་པ་རྣམ་པར་ངག་པ་མེད་དེ་ཆོག་གཞན་སྟོབས་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ལམ་མ་ཡིན་པར་ལྷུང་བ་རྣམ།",
    "རིགས་སུ་འཛིན་པ་རྣམ་པར་བཞིག་པའི་ཕྱིར་བདུད་རྩི་ལྔ་ལ་སོགས་པདམཚིག་རྣམས་ཀྱང་བསྟེན་པར་བྱའོ།",
    "དེ་དབྲོག་པ་ནི་རིན་ཆ་ན་རིགས་ལ་སྟེ་མགྲི་ན་པར་ས་བརྒྱད་པའི་གནས་སུའོ་ཞེས་ངེས་པའོ།",
    "འཁོར་ལོ་ལ་ནི་སྟེ་ལྟེ་བའི་པདྨར་སྟོན་པར་བྱ་ནི་བཟའ་བར་བྱ་སྟེ།",
    "གཞན་དུམཐའ་ཡས་བསྐལ་པས་མིན་པར་གང་རྒྱལ་བས་གསུངས་པའོ།",
