    "བ་དེག་པོའི་རྐྱེན་དང་བྱེ་བྲག་མེད་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་འདི་ཡད་བྱེ་དརྒྱུ་ཙམ་དུ་རྣམ་བརག་ཞགན་ནི་དེའི་ཚེ་དེ་དག་དང་བྱེ་བྲག་མེད་པར་འགྱུར་རོ།",
    "འདུས་པའི་རྫས་མེདཔ་དམིགསཔར་མི་རུང་དུ་ཟིན་ཡང་རྡུལ་ཕྲ་རབ་རྣམས་འདུས་པའི་རྣམ་པར་ཤེས་པ་དེའི་དམིགས་པར་འགྱུར་རོ་ཞེན་ཡོད་དེའི་ཕྱིར།",
    "རྡུལ་ཕྲ་རབ་འདུས་པ་དག་ཀྱད་རྣམ་པར་ཤེས་པ་དེའི་དམིགས་མ་ཡིན་ནོ།",
    "འདི་ལྟར་གང་འདི་ཤེས་པ་ལ་རགས་པའི་རྣམ་པར་སྣང་བ་རྣམ་པ་དེ་དག་རྡུལ་སྲ་དབ་སོ་སོ་ལ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་རྡུལ་ཕྲ་རབ་བསགས་པ་མ་ཡིན་པ་དག་དམིགས་བར་མིའགྱུར་བ་དེ་བཞིན་དུ་བསགས་པ་རྣམས་ཀྱང་དམིགས་པར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་དམིགས་པརམ་གྱུརཔ་དེ་བཞིན་དུའ་དུས་སུ་ཟིནཀྱང་རགས་པར་མི་འགྱུར་རོ།",
    "དེ་བས་ན་དམིགས་པར་ཇི་ལྟརའགྱུརཏེ།",
    "ཡང་ལ་ལ་རྡུལ་ཕྲརབ་རྣམས་དམིགས་པ་ཡིན་པར་རྣམ་པ་གཞན་དུ་འདོད་དེ་དེའི་ཕྱིར་དེའི་ལུགས་བསྟན་པར་གཞན་དག་རྡུལ་ཕྲ་པར་བར་རྡོ་ཞེས་བྱ་བལ་སོགས་པ་སྙས་ཏེ།",
    "ཡང་ན་ནི་ནམས་ཀྱང་དབད་པོས་མི་རྟོགས་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཕན་ཚུན་བལྟོས་པའི་རྡུལ་ཕྲ་རབ་དག་ཉིད་རྣམ་པར་ཤེས་པའི་ཡུལ་དུ་ཟིན་ན་ནི།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་ལ་སྣང་བ་ཡང་གཞན་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་སོ།",
    "དེ་ནི་དེ་དག་ཀྱང་ཡོད་པར་མི་འཐད་བར་བསྟན་པའི་ཕྱིར།",
    "དེ་མེད་པར་གྱུར་ན་ཤར་དང་བྱང་ལ་སོགས་པ་ཡང་རྡུལ་ཐ་རབ་ཀྱི་ཆརམི་འགྱུར་རོ།",
    "གལ་ཏེ་རྡུལ་ཕྲ་རབ་ཀྱི་ཕྱོགས་ཆ་ཐ་དད་པ་ཁས་མི་ལེན་ན་དེ་ཚོ་ཇི་ལྟར་རྣན་པར་ཞེས་པ་ལུས་མེད་པ་དང་།",
    "དཔེར་ན་རྨི་ལམ་༢ གྱིརྣམ་པར་ཤེས་བབཞིན་དུཁས་བླངབར་བྱའོ།",
    "ཇི་ལྟར་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་འགྱུར།",
    "སྐྱེ་བའི་ཚེན་ནི་ཚོར་བ་ལ་སོགས་པ་ཡོད་པ་མ་ཡིན་ན་ཏེ་དེའི་ཕྱིར་ཡོད་པ་མ་ཡིནཔས་སྐྱེད་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་བས་ན་ཡིད་ཀྱིས་རྣམ་པར་ཤེས་པའི་དམིགས་པ་ཡང་ཅི་ཡང་མེད་པརགྲུབ་པོ།",
    "དེ་ལྟར་ནགཟུང་བ་མེད་པས་རྣམ་པར་ཤེསཔ་འཛིན་པར་མི་འགྱུར་ཏེ།",
    "གལ་ཏེ་འདྲ་ཅི་ཡང་རུང་བ་ཞིག་ཡོད་ན་ནི་དེའི་ཆེ་ཉེ་བར་འདོགས་པར་བྱེད་དོ།",
    "ཡངར་རྣོ་བ་ཉིད་ཡོད་ན་འཇིག་རྟེན་ན་བྲམ་ཟེའི་ཁེའུལ་མེ་ཉེ་བར་འདོགས་པར་བྱེད་དོ།",
    "གཞན་དུ་ན་ནིཉེ་བར་འདོགས་པར་མི་འགྱུར་རོ་ཞེས་ཕྱོགས་སྔ་མའོ།",
    "སོགས་གཉིག་ཡང་ཉེ་བར་འདོགས་པར་མི་རུང་ངོ།",
    "འདི་ལྟར་ཡོན་ཏན་འདི་དག་ནི་རྫས་ཀྱི་ཡིན་གྱི་རིགས་ཀྱྀ་ནི་མ་ཡིན་པར་འདོད་དོ་ དེ་ལ་འདིར་འགྱུར་ཏེ།",
    "རིགས་མེད་པར་ཡང་རྣོ་བཉིད་དང་སེར་བ་ཉིད་བྲམ་ཟེའི་ཁྱེ་འུ་ལམཐོང་བའི་ཕྱིར་ཞེས་བྱ་བལ་སོགས་པསྨྲས་ཏེ།",
    "འདི་ལྟར་རྣོ་བ་ཉིད་དད་སེར་བ་ཉིད་ནི་རིགས་མ་ཉིད་མེད་པར་ཡང་བྲམ་ཟེའི་ཁྱེའུལ་སྣང་སྟེ།",
    "འདི་ལྟར་རིགས་མེཎིདནི་བྲམ་ཟེའི་ཁྱེའུལ་མེད་ལ་རྣོ་བ་ཉིད་དང་སེར་བ་ཉིད་ནི་དེ་ལ་ཡོད་ན་དེགཉིས་རིགས་མཉིད་མེདཔར་མིའགྱུར་བར་ཇི་ལྟར་འགྱུར།",
    "ཀློགརིགས་ཉེ་བར་འདོགས་པར་མིའགྱུར་དུཟིན་ཀྱང་རྫས་ཉེ་བར་འདོགས་པར་འགྱུར་དོ་ཞེན།",
    "འདི་ལྟར་མེའི་ཡོན་ཏན་རྣོབ་འམ་སེརབ་གང་ཡིན་པ་དེ་ཉིད་ནི་བྲམ་ཟེའི་ཁྱེའུའི་ཡིན་པར་མི་འདོད་དོ།",
    "དེ་དེ་ལས་གཞནཔར་ཇི་ལྟར་ཤེས་ཤེ་ན།",
    "འདི་ལྟར་མེ་ནི་ཤིང་བསྲེགས་པར་ནུས་པས་རྣོ་བའི་སྒྲར་བརྗོད་དོ།",
    "བྲམ་ཟེའི་ཁྱེའུ་ནི་བྱེད་པརྣམས་ལ་གཡེར་བས་རྣོ་བའི་སྒྲར་བརྗོད་དོ།",
    "དེ་བཞིན་དུ་ཡོན་ཏན་སེར་བ་ཡང་ཐ་དད་དུ་བརྗོད་པར་བྱའོ།",
    "མེའི་ཡོན་ཏན་མེད་པར་བྲམ་ཟོའི་ཁེའུ་ལ་མེ་ཉེ་བར་གདགས་པ་ནི་མ་རིགས་སོ་ཞེས་བྱ་བ་སྣས་སོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་གཞན་གྱི་ཡོན་ཏན་གྱིས་བྲམ་ཟེའི་ཁྱེའུ་ལ་མེར་ཉེ་བར་ག་དགས་པར་རུང་།",
    "གཞན་དུ་ན་ཡོན་ཏན་དོན་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "ཤེས་པ་དང་བརྗོདཔ་མ་གཏོགས་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྒྲས།",
    "ཤེས་པ་དང་བརྗོདཔ་མ་གཏོགས་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས།",
    "དེ་དངོས་སུ་ཇི་ལྟར་འགྱུར་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་དག་བདད་མི་ད་གེ་བ་ནི་རྣམ་པར་སྨིན་ལྟཔབའི་འབྲས་བུ་སྒྲུབ་པའི་ཕྱིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་རྣམ་པར་སྨིན་པའི་བག་ཆགས་སྐྱེད་དོ།",
    "ཚིག་ལེའུ་བྱས་པའི་གཞི་གདིང་བའི་ཕྱིར།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བལ་ཀུན་གཞི་ཞེས་བྱེའོ།",
    "དེ་སྐདཅེས་བྱ་བའི་རྣམཔརཤེསཔ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་སྨིན་པ་གྱར་པའོ།",
    "འོ་ན་ཅིའི་ཕྱིར་རྣམ་པར་ཤེས་པ་འདི་ལ་ཀུན་གཞི་ཞེས་བྱ་སྙམ་པལ།",
    "རྣམ་པརཤེས་པར་བྱེད་པས་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འདི་ལྟར་ཡུལ་ལརྣམ་པར་ཤེས་པར་བྱེད་པས་དེ་བས་ན་རྣམ་པར་ཤེས་པའོ།",
    "དེབས་རྣམཔར་སྨིནཔ་ཞེས་བྱའོ།",
    "གལ་ཏེ་འཇུག་པའི་རྣམཔར་ཤེས་བལས་གུདན་ཞེས་བྱབ་ལ་སོགས་པ་སྨྲས་ཏེ།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་མ་གཏོགས་པར།",
    "ཀུན་གཞིའི་རྣམ་པརཤེས་པ་དམིགས་བ་མེད་པ་དང་།",
    "རྣམ་པ་མེད་པར་ནི་ཁོ་བོ་ཡང་མི་འདོད་བོད་ཀྱི།",
    "པ་སྔོན་དུ་བཏད་ནས་དོན་ཁོང་དུ་ཆུད་པར་འགྱུར་བས།",
    "ལེ་ནབ་དེ་ནི་ལེན་པར་བྱེད་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ཉིད་བསྟན་པའི་ཕྱིར་དེ་ཡང་བདག་ལ་སོགས་པར་རྣམ་པར་རྟོག་པའིབག་ཆགས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྣམ་སོ།",
    "འདི་ལྟར་བག་ཆགས་རྣམ་པ་འདི་ལྟ་བུ་ཡོད་པས་ཀུན་གཞིརྣམ་པར་ཞེས་པ་ས་བདག་ལ་སོགས་པར་རྣམ་པར་རྟོག་པ་དད།",
    "དེ་ཡོད་ན་ཇི་སྐད་བརྗོད་པའི་འབྲས་བུ་ལེན་པར་བྱེད་དེ།",
    "ན་ནི་འདི་ལ་འདིའོ་ཞེས་ཚོར་བའི་རྣམ་པར་མི་རིག་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྣས་ཏེ།",
    "དེ་བས་ན་ཀུན་གཞི་རྣམ་པར་ཞེས་པ་དེ་ལེན་པ་མ་རིག་པ་ཞེས་བྱའོ།",
    "ལེན་པ་དེ་ལ་འདིའོ་ཞེས་རིག་པར་མི་ནུས་པས་ཞེས་བྱ་བ་ལསོགས་པ་སྣས་ཏེ།",
    "རྣམ་པ་ཡོངས་སུ་མ་ཆད་པར་འགྱུར་སྟེ།",
    "རྣམ་པ་ཡོངས་སུམི་གཅོད་པར་འགྱུར།",
    "གྲུབ་པའི་མཐའ་སྨྲབས་ཉེས་པ་མཚུངས་པར་སྒབ་བའི་ཕྱིར།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལ་སོགས་པའི་དུས་ན།",
    "བདུ་པར་ཡང་རྟོགས་པར་མི་ནུས་ཏེ།",
    "ཚིག་ལེའུར་བྱས་པའི་གཞི་ག་དང་བིན་ཕྱྀར།",
    "དེ་ལ་ཀུནགཞི་རྣམ་པར་ཤེས་པ་ནི་ཞེས་སྨོས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་ཏེ།",
    "རིག་ཅེས་བྱ་བའི་སྒྲ་རྣམ་པར་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "འཇུག་པར་བྱེདཔས་འཇུག་པསྟེ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "འཇུག་པར་བྱེད་པས་ནའཇུག་པ་སྟེ་ཞེས་བྱ་བ་འདིས་ནི་དེས་པའི་ཚིག་བསྟན་ཏོ།",
    "དེ་ཡང་ཡུལ་སིམ་པར་བྱེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལས་ཏེ།",
    "དེ་ལ་བདེ་བ་མྱོང་བ་ནི་ལས་ད་གེ་བ་རྣམས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྨིན་པའོ་ཞེས་བྱབལ་སོགས་པ་སྩས་སོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པའི་བཏང་སྙོམས་ཉིད།",
    "ཚོར་བ་གང་བྱུར་ན་བྲལ་བར་མངོན་དུ་འདོད་པར་མི་འགྱུར་ཏེ།",
    "གང་འགགསན་འཕྲད་པར་མངོན་དུ་འདོད་པ་སྐྱེ་སྟེ།",
    "དོ་ལས་བཟློག་པ་ནི་སྡུག་བསྔལ་ལ་མྱོང་བར་རིག་པར་བྱའོ།",
    "འབྲལ་བ་དང་འཕྲད་པར་མངོན་དུ་འདོད་པ་མི་སྐྱེ་བ་དོན་སྡུག་བསྔལ་ཡང་མ་ཡིན་བ་དེབ་ཡང་ཆ་ཡིན་པ་མྱོད་བ་ཞེས་བྱའོ།",
    "དེ་ལཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་བཞེས་བྱ་བ་ལ་སོགས་པ་སྐུས་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ལ་ཚོར་བ་བཏ་ད་སྙོམསའབའ་ཞིག་སྟེ།",
    "ཀུནགཞི་རྣམ་པརཤེས་པའི་ད་མིགས་པ་དང་།",
    "དིལྟརདེ་གཉིས་དང་མཚུངས་པར་ལྡན་པརའགྱུར།",
    "དེ་དག་ནི་འདོད་ཆགས་དང་ཞེསྡད་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ན།",
    "ཇི་ལྟར་ན་བདེ་བ་དང་སྡུག་བསྔལ་དད་ག་ཐམས་ཅག་འདོད་ཆགས་དང་ཞེ་སྡང་བག་ལ་ཉལ་བར་བྱེད་པར་འགྱུར་དཱ་ནི་ལུང་དུམ་བསྟན་པཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "ཀུནགཞི་རྣམ་པར་ཤེས་པ་དེ་ནིམབསྒྲིབས་ལ་ལུང་དུམ་བསྟནབ་ཡིནཔར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "བསྒྲིབས་པ་ལས་རྣམ་པར་འབྱེད་དོ།",
    "རྣམ་པར་སྨིན་པ་ཡིན་པས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རྣམ་པར་སྨིན་པ་ལས་རྣམ་པར་སྨིན་པ་གཞན་མིའ་བྱུང་ངོ།",
    "དོན་དེ་ནིབརྡ་ཕྲདཔར་ཟད་དོ།",
    "གཞན་དུ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "ལ་ལ་ཅི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ཞེས་བྱ་བ་ལ་སོགས་པའདྲི་སྟེ།",
    "དེ་གཅིག་པུ་ཐ་དད་པ་མེདཔར་ཉིན་ད་ས། འཇུག་པ་མ་ཡིན་ཏེ།",
    "དོ་སྐདབསྟན་པར་འགྱུར་རོ།",
    "དེ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ཆུ་བོའི་རྒྱུནབཞིན་འབབ་པའོ།",
    "རྒྱུན་མིའཆད་པར་རྒྱུན་དུ་འབྱུང་ངོ།",
    "། ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ཇི་ལྟར་ལྡོག་པར་འགྱུར་ཞེན།",
    "དེའི་ཚེཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ།",
    "དེའི་ཕྱིར་ཀུན་གཞི་རྣམ་པར་ཤེ་ས་པ་ལྡོག་པར་འགྱུར་ཏེ།",
    "འདི་ནི་སྐྱེས་འཆད་པར་འགྱུར་རོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་འདི་ར་ཀུནགཞི་རྣམ་པར་ཤེས་པ་དང་སྦྱར་རོཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བསམ་གཏན་དང་པོལ་སོགས་པ་ས་གང་དུ་ཀུན་གཞི་རྣམ་པརཤེས་པརྣམ་པར་སྨིན་པ་ཐོབ་པ་དེར།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ལ་ད་མིགས་པ་སྟེ།",
    "དེའི་ཕྱིར་ང་དང་བའི་ཞེས་བྱ་བའི་རྣམ་པ་འདིས་ཀུནགཞི་རྣམ་པར་ཤེས་པ་ཉིད་ལ་དམིགས་སོ།",
    "ཡོདཅེས་བྱ་བའི་རྣམ་པར་ཤེས་པར་བརྗོད་པ་གང་ཡིནཔ་དེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་འབྱུད་དོ།",
    "དམིགསཔ་ཡང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡིན་ནོ།",
    "ཡིད་ཅེས་བྱ་བའི་སྒྲའི་རྣམ་པར་བཅད་པ་བསྟན་པའི་ཕྱིར།",
    "ཡིད་སྨོས་པས་ནི་རྣམ་པ་ར་ཤེས་པའདི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་ལས་རྣམ་པར་འབྱེད་པར་བྱེད་དོ།",
    "དོན་དེ་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "ཅིའི་ཕྱིར་དེ་བསྒྲིབ་སལ་ལུང་དུ་མ་བསྟན་པ་རྣམས་དང་མཚུངས་པར་ལྡན་སྐུམ་པ་ལ།",
    "བསྒྲིབས་པའི་རྣམ་པར་ཤེས་པ་ནིཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་།",
    "ཚིག་ལེའུར་བྱས་པ་དང་སྦྱར་བའི་ཕྱིར།",
    "སྤྱིར་བསྟན་པའི་ཁྱད་པར་མི་ཤེས་ནས་ཁྱད་པར་སྟོན་ཏེ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འདི་དག་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཇི་ལྟར་དམིགས་སྙམ་པལ།",
    "དེའི་ཕྱིར་དེ་ཡོད་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེའི་ཕྱིར་ཀུནགཞི་རྣམ་པར་ཤེས་པ་བདག་མ་ཡིན་པ་ལ་བདག་གོ་སྙམ་དུ་བྱིནཅི་ལོག་པ་གང་ཡིན་པ་དེ་རྒྱུར་བསྟན་པ་ཡིན་ནོ།",
