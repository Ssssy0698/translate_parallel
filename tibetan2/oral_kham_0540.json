    "བཀའ་ཤག་ནང་བཀའ་ཚབ་ལྷན་རྒྱས་བཅས་ལ་མཇལ་ཕྱག་ཏུ་བཅར་བ་སོགས་སྔར་ལུགས་ལྟར་བྱས་འདུག་དེ་ནས་ཀོང་པོ་རྒྱ་མདའ་དང་།",
    "བཅིངས་འགྲོལ་གུང་དམག་ལྷ་སར་འབྱོར་ཉེའི་གྲ་སྒྲིག་དགོས་པ་བཅས་ཀྱི་འགན་ཁུར་བྱ་དགོས་པའི་ཆེད་དུ་བཀའ་བློན་ལྷ་ཀླུ་ལྷ་སར་ཛ་དྲག་ལྟ་བུས་ཕྱིར་བསྐོང་གནང་བ་ཡིན་འདུག་༧གོང་ས་མཆོག་རྒྱལ་རྩེ་ནས་ལྷ་ལྡན་རྒྱལ་ཁབ་ཏུ་༧ཞབས་སོར་བཀོད་གནང་བ།",
    "ཆ་རྒྱུས་མེད་པའི་རྒྱ་མིར་བོད་མིས་ནང་རུལ་གྱི་སློབ་སྟོན་དེ་འདྲ་ཡང་བྱས་འདུག་འོན་ཀྱང་བོད་ཀྱི་ཞི་དྲག་དཔོན་རིགས་སེར་སྐྱ་ཆེ་རྒུ་མཐོ་དམའ་མཐའ་དག་འདུ་འཛོམས་དང་འབྲེལ་ཕེབས་བསུ་རིང་ཐུང་ཚུལ་ལྡན་སྔར་ལུགས་བཞིན་རྒྱས་སྤྲོས་གང་ཆེ་ཞུས་ཤིང་།",
    "དེ་ཚོར་ཡང་ལམ་རྒྱག་ཆད་འདུག་དེ་དང་དེ་འདྲའི་སྐབས་སུ་ང་ཕོད་ཀྱིས་ཡུལ་མིའི་འགོ་པ་ཚོའི་བརྒྱུད་འབྲུ་རིགས་དང་།",
    "བོད་གཞུང་ནས་ཀྱང་དཔོན་རིགས་འགའ་ཤས་སྣེ་བསུའི་ཚུལ་དུ་བཏང་འདུག་དེ་ཚོ་དང་བཀའ་བསྡུར་གྱིས་དཔུང་དམག་ལྷ་སར་བསྐྱོད་འབྱོར་གྱི་དུས་ཚོད་གོ་བསྡུར་བྱས་ཏེ་བོད་གཞུང་ནས་ལྷ་སའི་གཙང་ཆུའི་འགྲམ་དུ་ཀོ་གྲུ་དང་།",
    "རང་ཁོངས་སོ་སོར་ཕྱིར་ལོག་ཆོག་པ་བྱས་འདུག་ཅིང་།",
    "རྩ་ཤིང་སོགས་ཚོང་ཉོའི་སྒྲིག་བཀོད་བྱ་དགོས་བྱས་ཏེ་རིན་འབབ་ད་ཡན་མང་པོ་སྤྲད་ཡོད་འདུག་ཀྱང་།",
    "བདལ་གླ་སྐྱེལ་འདྲེན་བྱ་སྒོ་སོགས་བཀོད་སྒྲིག་བྱེད་རིམ་བཞིན་མདུན་བསྐྱོད་ཀྱིས་ང་ཕོད་ཅན་ཟླ་༩ ཚེས་༡༡ཉིན་ལྷ་སར་ཕེབས་འབྱོར་བྱུང་འདུག་ཅིང་།",
    "ལས་ཚན་པ་སོགས་སྐུ་དྲག་ཧ་ཅང་མང་པོ་ཕེབས་འདུག་དེ་ནས་རིམ་ཕེབས་ཀྱིས་ལྷ་སའི་གཙང་ཆུ་ཁར་ཕེབས་སྒྲིག་ཡོད་པ་ནས་མུ་མཐུད་གཙང་ཆུ་བརྒལ་བགྲོད་བྱས།",
    "གལ་ཏེ་བོད་འབངས་ལ་གཉའ་གནོན་བཏང་ཚེ་ང་རང་ནི་སྨ་ར་དཀར་པོ་ཆགས་ཤིང་འཆི་ལ་ཁད་ཀྱི་མི་ཞིག་ཡིན།",
    "གལ་སྲིད་ཕན་ཐོགས་མེད་པ་དང་མི་འགྲིགས་པའི་གནས་ཚུལ་ཞིག་བྱུང་འདུག་ན།",
    "ཁ་ནས་ཚིག་ངན་བརྗོད་པ་སོགས་མི་དགའ་བའི་བསྙད་བསྐོ་ཡང་ཡང་བྱས་ཐོག་བར་བསྐོར་ལམ་གྱི་གྱང་ངོས་སུ་ཡིག་དཀྱུས་སྦྱར་བ་སོགས་བྱས་འདུག་པ་དང་།",
    "རྣམ་པ་བྱུང་འདུག་ཀྱང་།",
    "ཕོགས་ཐོབ་སོགས་སྔར་རྒྱུན་རང་འཇགས་ཐོག་སྲིད་ཚབ་ཀྱི་མཛད་འགན་བཞེས་མ་དགོས་པ་གནང་འདུག་ཅིང་།",
    "ཕྱི་ལོ་༡༩༥༢ ཟླ་༤ ཚེས་༡༢ ཉིན་ལྷ་སར་སྐུ་དཀྱིལ་གསལ་བའི་ངང་ཞབས་བཀོད་གྲུབ་འདུག་རྒྱ་ཕྱོགས་ནས་ཀྱང་གང་ཅིའི་ཐད་ལ།",
    "༧གོང་ས་མཆོག་ནས་གཞན་གྱིས་བཅོས་པ་མ་ཡིན་པའི་རང་བཞིན་གྱི་དགོངས་པ་བཞེས་ཚུལ་ལེགས་པོ་འདུག་པ་དང་།",
    "སང་སང་ཅན་མི་གསུམ་བཅས་བོད་མི་བཅུ་ཚོགས་ཞུགས་བྱས་འདུག་ཅིང་།",
    "སྐད་ཆ་ཤོད་སྟངས་ཚུན་མི་འགྲིགས་པའི་སྐྱོན་བརྗོད་འོག་རང་རང་སོ་སོས་བཟོ་ཚོང་སྒེར་གཉེར་ལ་སོགས་པའི་རིགས་སྐྱོན་གྱི་རང་བཞིན་ངོས་ལེན་ཞུ་རྒྱུ་ཁོ་ནའི་ལམ་ཕྱོགས་སུ་བསྐྱོད་རྒྱུ་ལས་མེད་པ་དང་།",
    "ཤིང་རྟ་ཟླ་༡༡ ཚེས་༡༧ ལ་ཞེས་བཀའ་ཤག་ནས་བཀོད་རྒྱ་གནང་འདུག་ཅིང་།",
    "ཕྱི་ལོ་༡༩༥༣ ཟླ་ཚེས་ལ་ཞེས་སྩལ་འདུག་ཅིང་།",
    "སེམས་གསོ་ཐེབས་པའི་ནུས་རྩལ་སྟོན་འདུག་པ་མ་ཟད།",
    "ལྔ་གཅིག་དུས་ཆེན་དུ་བསྐྱོད།",
    "འདུག་རྒྱལ་ས་པེ་ཅིང་དུ་གང་ཅིའི་ཐད་སྣེ་ལེན་ཟབ་རྒྱས་དང་།",
    "གྲོ་ཞིབ་འཐག་སའི་བཟོ་གྲྭ་ཞིག་འཛུགས་རོགས་ཞེས་ཞུས་འདུག་ཅིང་།",
    "ད་ལན་གོ་སྐབས་དང་བསྟུན་པེ་ཅིང་རང་དུ་ཕྱིན་ཏེ།",
    "བརྒྱ་དཔོན་ཡན་བཅས་མཉམ་དུ་ཚོགས་པ་དེ་ཡིན་འདུག་པ་དང་།",
    "ཉེན་ཁའི་རང་བཞིན་འོག་རང་གནས་སུ་འགལ་རྐྱེན་མེད་པར་བདེ་འབྱོར་བྱུང་ཡོད་འདུག་ཅིང་།",
    "བསྟན་པ་དར་རྒྱས་ཡུན་གནས་ཡོང་བའི་ཐུགས་ཁུར་བརྩེ་བཞེས་བཀའ་དྲིན་མི་ཆུང་བའི་ཞུ་༧སྙན་ཞིག་ཀྱང་ཕུལ་འདུག་པར།",
    "ལམ་ཁར་རྒྱ་མིའི་ཇ་ཁང་སོགས་མཐོང་བས་རྒྱ་ནག་ཏུ་འབྱོར་བའི་རྟགས་མཚན་གསལ་པོ་འདུག་ཅེས་འཁོད་ཅིང་།",
    "དེར་ཇོ་བོའི་བཞུགས་ཁྲི་སྟོང་པ་ཞིག་མཇལ་རྒྱུ་འདུག་པ་༧གོང་ས་མཆོག་དང་ལྷན་བཅར་གྱིས་མཇལ་ཞེས་གསལ་འདུག་ཅིང་།",
    "སྔར་རྒྱ་ནག་ཐང་རྒྱལ་རབས་ཀྱི་དུས་སུ་རྒྱལ་ས་ཁྲང་ཨན་ཞེས་རྒྱལ་རབས་མང་པོའི་ནང་བྲིས་ཡོད་པའི་ས་ཆ་འདི་རང་ཡིན་འདུག་པ་དང་།",
    "བླ་དཔོན་ཆེ་རྒུ་རྒྱ་བོད་དཔོན་རིགས་མི་གྲངས་༢ སྐོར་ཡོད་འདུག་པ་དང་།",
    "མའོ་ཙེ་ཏུང་མཉམ་དུ་དཔོན་རིགས་གཞན་དག་མང་པོ་འདུག་པའི་ཁོངས་དེང་སྐབས་ཀྱི་གཙོ་འཛིན་ལིའུ་ཧྲའོ་ཆི་ཡང་འདུག་ཕྲན་གྱི་མཉམ་དུ་བོད་ཀྱི་དཔོན་རིགས་བཞི་ལྔ་ཞིག་ཡོད།",
    "ཡར་རྒྱས་ཀྱི་འཆར་གཞི་རྣམས་ཧ་ལས་པའི་ཡག་པོ་འདུག་ཅེས་དྲང་པོར་བརྗོད་པ་ཡིན།",
    "ཁོང་མའོ་ཙེ་ཏུང་ལྟ་བུའི་དྲང་གསལ་ཐད་ཀ་ཞིག་མི་འདུག་ཞེ་ས་དང་།",
    "འཇམ་ཞིང་བཟང་ངན་གྱི་རྣམ་འགྱུར་མངོན་ཆུང་བ་ཞིག་འདུག་ཁོང་ཁྲོའི་རྣམ་འགྱུར་ནམ་ཡང་སྟོན་ཨེ་སྲིད་སྙམ་པ་ཞིག་སྟེ།",
    "དེ་བཞིན་རོ་མ་ནི་ཡའི་བློན་ཆེན་ལའང་དེ་ལྟར་ཆགས་ཡོད་འདུག་པ་དང་།",
    "ཁོང་འཛུམ་ཙམ་གནང་རྗེས་ཁྱེད་རང་མཇལ་ཏེ་དགའ་པོ་བྱུང་།",
    "བོད་དང་རྒྱ་གར་གཉིས་ཀར་ཕུགས་གནོད་ཆེན་པོ་གྱུར་པའི་ནོར་འཁྲུལ་ཤོར་འདུག་སྙམ་པའི་བློ་ཕམ་སྐྱེས་པའང་ཡིན་སྲིད།",
    "ཚོགས་འདེགས་པའི་ཚིག་བཅད་ཀྱང་བློ་ཐོག་ནས་ཤར་མར་འདོན་རྒྱུ་འདུག་ཡང་ཐོན་ཀོན་གྱིས་སྤོས་དང་།",
    "སྡུག་ན་མཆན་གྱི་བུ་བྲོས་ཟེར་བ་ལྟར་ལྷ་འདྲེ་མི་གསུམ་སྤྱོད་ཚུལ་གཅིག་ཏུ་སྣང་བ་དགོད་བྲོའི་རང་བཞིན་དུ་གྱུར་ཞེས་གསལ་འདུག་པ་དེ་ལྟར་ན།",
    "རྒན་བྱམས་པ་མཐའ་ཡས་ཀྱི་བཀའ་དྲིན་ལས་གྲ་རྒྱས་ཕུན་སུམ་ཚོགས་པ་འདུག་ཅེས་གསུང་འདུག་དེབ་བཞི་པ།",
    "ཧུར་བརྩོན་ཆེན་པོ་འདུག་སྤྱིར་བཏང་ལས་རྩོལ་བ་ཚོ་འདོད་པ་ཁེངས་པ་ལྟ་བུ་མཐོང་ཞིང་།",
    "བྱེད་སྟངས་འདྲ་མཚུངས་བཅས་འདུག་སྟེ།",
    "ཕྲན་གཉིས་ཀའི་དྲན་སོས་ཀྱི་འདུག་ལ་༧གོང་ས་མཆོག་བྲག་མགོ་དགོན་ནས་ཆིབས་ཐོན་གྱིས་བྲེ་འོ་བརྒྱུད་ཅོག་རོ་དགོན་དུ་སླར་ཡང་ཞབས་སོར་འཁོད།",
    "སྐབས་དེར་ཕེབས་སྒྲིག་དབུ་འདོམས་བཀའ་ཟུར་ཀུན་བདེ་གླིང་འོད་ཟེར་རྒྱལ་མཚན་ཅན་ཡིན་འདུག་པར།",
    "ད་ལྟའང་སེམས་ནང་འཆར་བཞིན་འདུག་དེ་ལྟ་བུའི་འཇིབ་འཁོར་གྲངས་༡༡ དང་།",
    "སྤྱི་ལས་ཁང་རང་འཇགས་སུ་གནས་པ་ཡིན།",
    "བོད་མི་རྒན་གཞོན་སུ་ཡིན་ཡང་རང་གཤིས་འགྱུར་མེད་བརྟན་པོ་ཡོད་སྟབས།",
    "ཟབ་རྡོ་རྣམས་ཕར་ཚུར་བསལ་ཐུབ་སྟེ་ཆིབས་ཀྲོར་ཐར་ཙམ་བྱུང་འདུག་ནའང་།",
    "གསུམ་གྱི་དཀའ་ངལ་དང་ལེན་འཁུར་བརྩོན་ཧ་ལས་པ་ལྟ་བུ་བྱེད་འདུག་ཅེས་བཀའ་ཟུར་ཀུན་གླིང་གང་ཉིད་ཀྱིས་གསུངས།་",
    "དངོས་ཆས་དང་ཆིབས་༧ཞབས་པ་ཁག་ཅིག་རྗེས་སུ་ལུས་ཏེ་མལ་གྲོ་དག་པ་དགོན་དུ་ཕེབས་རྗེས་ཟིན་ཙམ་བྱུང་བ་ཡིན་འདུག་ཕྱི་ཉིན་ལྷ་ས་ནས་ཀླུ་ནང་དུ་ཐབ་བསུར་བཅར་འབྱོར་གོང་གསལ་རྣམས་མཇལ་ཞུ་གྲུབ་ནས་ཀོང་པོ་གསེར་སྐྱེམས་ལ་བརྒལ།",
    "བོད་ཤིང་ལུག་ཟླ་༩ ཚེས་༢༩ བཟང་པོར་བྲིས་ཞེས་སྩལ་འདུག་ཀྱང་།",
    "ཤན་ཞེས་པ་དེ་རིམ་པ་བཞི་པ་དེ་ཡིན་འདུག་པ་དང་།",
    "རྒྱ་མི་བོད་དུ་མ་ཡོང་གོང་བོད་ཀྱི་སྣོད་བཅུད་ཡོངས་རྫོགས་ཅི་འགྱུར་གྱི་བློ་རྩེ་ཞིག་འདོན་ཐུབ་ན་སྐྱེས་ཕོ་རབས་ཤིག་ལོས་ཡིན་ཀྱང་དེ་ལྟར་མ་བྱུང་བ་དང་།",
    "དེ་སྐབས་འཛིང་འཛའ་བྱེ་ཐང་ནས་འདྲེ་རིག་ཚོས་ཉིན་མཚན་བར་མེད་དུ་ཤ་བའི་ཁྱུ་ཚོགས་བཤར་ནས་འགྲོ་ཡི་འདུག་ཟེར།",
    "བསྟན་རྩ་མཆོད་རྒྱུན་སོགས་སྣུམ་ཟད་ཀྱི་མར་མེ་ལྟར་འགྲོ་བའི་ཉེན་ཁ་འདུག་ཅེས་གླེང་ཡང་།",
    "ཡོངས་འཛིན་རྣམ་གཉིས་ཀྱང་མགྲོན་ཁང་དེ་རང་དུ་ཕེབས་སྒྲིག་ཞུས་འདུག་ཕྱི་ཉིན་སྔ་དྲོ་མ་ཧཱ་ཏི་མ་གྷན་དྷིའི་སྐུ་གདུང་བསྲེག་ས་དེར་རྒྱལ་པཎ་རྣམ་གཉིས་དང་།",
    "གཏན་འཁེལ་གཙང་མ་མ་ཐུབ་མུར་བཞུགས་ཐུབ་པའི་ཐབས་ཤེས་མང་པོ་གནང་ཡོད་འདུག་ཐབས་ཤེས་གཅིག་ལ་༧གོང་ས་མཆོག་རྒྱ་གར་ནང་ཡོད་རིང་བོད་ནང་ལྷ་སར་ཟིང་འཁྲུག་ཐུབ་པ་བྱ་ཐབས་བཟུང་།",
    "ལྷ་ས་ནས་ཟིང་འཁྲུག་ལང་ཐུབ་པའི་གོ་སྐབས་འདུག་བསམ་པ་ཡོད་ན།",
    "ཚོང་ལས་ཀྱི་བརྡ་ཚིག་ཏུ་སོ་བཟོ་བྱེད་ཀྱི་ལག་ཆ་འགྲོ་རྒྱུག་འདུག་ཟེར་བ་དང་།",
    "གོ་སྐབས་མི་འདུག་ན།",
    "སོ་བཟོ་བྱེད་ཀྱི་ལག་ཆ་འགྲོ་ཁུངས་མི་འདུག་ཟེར་བའི་བརྡ་ཚིག་ཏར་འཕྲིན་གཏོང་རྒྱུ་བྱས་འདུག་པར།",
    "ལྷ་ས་ནས་ཟིང་འཁྲུག་བསླངས་ཐུབ་ན་ཡག་པོ་ཡོང་ཐབས་མེད་པའི་གནས་ཚུལ་ཤུགས་ཆེ་ཡོད་སྟབས་སོ་བཟོ་བའི་ལག་ཆ་ཉོ་མཁན་ཡོང་བ་མི་འདུག་ཟེར་བའི་ཏར་འཕྲིན་འབྱོར་ཚུལ་ཟེར།་",
    "ཅེས་གསུངས་འདུག་པ་རང་ཉིད་ཀྱང་ཕམ་པའི་རང་བཞིན་དུ་གྱུར།",
    "ཁོ་བོ་ཡང་ལྷན་བཅར་གྱིས་བརྒྱུད་པའི་བསྟན་བདག་རྗེ་བདག་ཉིད་ཆེན་པོས་རྗེ་ཤེས་རབ་སེང་གེར་སྩལ་བའི་ཞལ་ཐང་བྱིན་ཅན་རྣམས་མཇལ་ཁ་ཐོབ་ཅིང་ཞེས་གསུང་འདུག་གོང་དུ་རྭ་སྒྲེང་རྒྱལ་ཟུར་ཇི་ལྟ་བ་བཞིན་དེ་སྔ་༡༩༣ ཡས་མས་སུ་སྟོད་རྒྱ་དང་།",
    "དེའང་རང་དགྲ་རང་གཤེད་ཡིན་ཞེས་དང་།",
    "ཨ་ཇོ་ག་ལུག་ཞབས་ཕྱི་དཔལ་ལྡན་ཕུན་ཚོགས།",
    "སྐུལ་སློང་བྱ་རྒྱུའི་ལས་འགུལ་བྱེད་ཐབས་ཙམ་དུ་གནས་འདུག་པ་དང་།",
    "དེ་མིན་བསྟན་འཛིན་ཕུན་ཚོགས་ཀྱི་རྐང་པར་མེ་མདའ་བརྒྱབ་སྟེ་རྩེ་དང་གྲོང་པའི་ཆུ་ལེན་ལམ་འགོ་ནས་ཆུ་ཁ་བར་རིལ་བ་ཡིན་སྟབས་ཤི་ཟིན་བྱས་འདུག་འཇམ་དབྱངས་དཔལ་ལྡན་དང་།",
    "ཡུལ་མི་རྣམས་ཀྱིས་ཟེར་སྐད་ལ་དེ་ཉིན་རྒྱ་དམག་སུམ་བརྒྱ་ལྷག་བསད་འདུག་ཟེར་བ་དང་།",
    "བསད་ཡོད་ཟེར་བ་བྱུང་འདུག་འོན་ཀྱང་གྲངས་ཚད་ངེས་གཏན་བརྗོད་མི་ཐུབ་ཅིང་འོལ་ཚོད་ཀྱི་སྐད་ཆ་ལོས་ཡིན་ཏེ།",
    "ཨ་ཇག་རིན་ཆེན་ནི་དཔའ་བོ་ཞིག་ཡིན་འདུག་པ་མ་ཟད།",
    "རྒྱ་མིའི་ལས་བྱེད་ཟེར་བ་གཅིག་ཀྱང་མེད་པ་བཟོས་འདུག་ཅེས་བང་མི་ཆེད་འབྱོར་བྱུང་།",
    "རྒྱ་མི་གྲངས་༡༡ ཡོད་འདུག་པ་དེ་ཚོའི་གྲས་སུ་དགོན་ཆེན་ཤན་དུ་བསྡད་མྱོང་མཁན་རྒྱ་མི་གཉིས་ཡོད་པ་དེས་ཕུན་ཚོགས་ཁའོ་ཀྲང་ཞེས་མིང་འབོད་ཀྱིས་སྲོག་སྐྱབས་ཞུས་པར་བརྟེན་རྒྱ་མི་ཁ་ཤས་བསད་པས་ཕན་གནོད་མེད་པ་བསམ་སྟེ་གང་ཡང་མ་བྱས་པར་བཏང་།",
    "ཚུར་ཡང་མེ་མདའ་མང་པོ་བརྒྱབ་འདུག་ཀྱང་སྲུང་བ་དང་།",
    "ཤན་དུ་ཕྱིན་འདུག་འཐབ་འཁྲུག་དེའི་སྐབས་སུ་བོད་མི་གཅིག་ལའང་སྐྱོན་མ་བྱུང་།",
    "ལག་འབོམ་ཡང་ཁ་ཤས་ཁོང་གཉིས་ལ་བརྒྱབ་འདུག་ཀྱང་མི་རྟ་གཉིས་ཀར་སྐྱོན་མ་བྱུང་།",
    "བཅོམ་པ་བཅས་བྱས་འདུག།",
    "སང་ཉིན་དེར་རྒྱ་རོ་རྣམས་རྨ་ཆུའི་ནང་གཡུག་དུས་རྒྱང་ནས་ལྟ་མཁན་རྣམས་ཀྱིས་རོབ་ཚོད་ཤེས་ཐུབ་པ་དང་།",
    "རྡོ་ཆེན་གྱི་རྩ་བ་དེ་འདྲར་རྒྱ་རོ་ཐོན་འདུག་ཀྱང་ཟེར།",
    "དགྲ་བོ་དང་འཐབ་རྒོལ་བྱེད་བཞིན་པའི་འོག་ནས་ཤི་ཐུབ་པ་བྱ་དགོས་ཞེས་ཐག་བཅད་དེ་བསྡད་ཀྱི་འདུག་ད་ནི་ས་ཞིང་སོ་ནམ་འདེབས་ལས་རན་པའི་མཚམས་སུ་སླེབས་ཤིང་།",
    "༣ སྐོར་ཚོ་ཁག་ཁ་ཤས་ཐོན་ཡོང་རྒྱུ་འདུག་ཟེར།",
    "དོན་བཀྲ་ཟེར་བ་སོགས་བོད་པ་མི་གྲངས་༡༢༣ ཤི་སྐྱོན་བྱུང་འདུག་ཡང་སྐབས་དེ་རང་དུ།",
    "མཁར་གསར་གྲོང་པའི་ནང་ནས་རྒྱ་དམག་གཉིས་ལྐོག་བརྡུང་སྤྲད་དེ་བསད་འདུག་དམག་སྒར་དེའི་ནང་རྒྱ་དམག་༥ ཡོད་པ་ཡིན་ན།",
    "ང་རང་ནས་དབུས་ལྷ་སའི་ཇོ་ཤཱཀ་རྣམ་གསུམ་མཇལ་བའི་སྐལ་བ་ཐོབ་ཚར་བ་ཡིན།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་བསམ་བློ་དེ་ནག་བུན་བུན་དུ་གནས་པ་ལས་གཞན་མི་འདུག་དེ་འདྲའི་མཚམས་ནས་རྒྱ་དམར་གྱིས་ཕྱོགས་གང་ས་ནས་སྔར་ལས་ལྡབ་འགྱུར་གྱི་དམག་གྲ་སྒྲིག་སྟེ་རྨེ་ཤོད་དུ་བསྐྱར་གཏོང་བྱ་ཡི་ཡོད་པའི་ལན་བརྡ་འབྱོར་བྱུང་།",
    "ཁྱེད་རང་འགྲོ་ས་གང་ཐོབ་ཀྱི་བསམ་བློ་ཐོངས།",
    "ནམ་ཞིག་དུས་བདེ་གནས་འཇགས་བཟང་པོ་ཞིག་མ་བྱུང་བར་ཕྱིར་དེབ་བཞི་པ།",
    "བདེ་བའི་སྟན་ལ་རབ་འདུག་སྟེ།",
    "མི་གཡོ་ལས་བྱུང་བདེ་བར་འདུག།",
    "བདེ་བའི་སྟན་ལ་རབ་འདུག་ནས།",
    "ཇི་སྐད་དུ་འཇམ་དཔལ་འདི་ལྟ་སྟེ་དཔེར་ན་ཀ་ལ་བིངྐའི་ཕྲུ་གུ་སྒོ་ངའི་སྦུབས་ཀྱི་ནང་ན་འདུག་པ་སྒོ་ང་མ་བརྟོལ་ཞིང་སྦུབས་ནས་མ་བྱུང་ཡང་ཀ་ལ་བིང་ཀའི་སྒྲ་ཉིད་དུ་འབྱིན་ཏོ།",
    "འགྲོ་ཡང་རུང་འགྲེང་ཡང་རུང་འདུག་ཀྱང་རུང་ཉལ་ཡང་རུང་སད་ཀྱང་རུང་ཟ་ཡང་རུང་འཐུང་ཡང་རུང་རྟག་པར་རྒྱུན་དུ་དྲན་པར་གྱིས་ལ་ཡིད་ལ་ཟུང་སྟེ་སྒོམས་ཤིག།",
    "ཉིན་ཞག་དུས་ནི་བསླབ་པ་གཅིག་བཟུང་བ།",
    "ཐ་ན་འདུག་པ་ཙམ་གྱིས་བདེ་བ་འདོད་པའི་སེམས་ཅིག་སྐྱེས་ན་ཡང་།",
    "འདིས་ནི་བདག་འཆི་བའི་དུས་ཀྱི་ཚེ་དགའ་བ་དང་མཆོག་ཏུ་དགའ་བ་དང་རངས་པ་དང་འགྱོད་པ་མེད་པ་སྐྱེ་བར་འགྱུར་སྙམ་དུ་སེམས་ངེས་པར་བསམ་པར་བྱའོ།",
    "རབ་ཏུ་དགའ་ཞིང་རངས་པ་དང་།",
    "དེ་ལ་འདུག་ཅིང་འཁོར་ལོ་ཐོགས་པ་མེད་པས་བསྐྱད་བ་དང་ཆིས་བྱ་བ་ལ་རྒྱལ་པོའི་བཀའ་ཐམས་ཅད་ཉམས་པ་མེད་པར་ཉན་པ་དེ་ལྟ་བུའི་སྟེན་གྱི་རྣམ་པ་སྦྱིན་པར་བྱེད་དོ།",
    "དགོད་ཅིང་འདུག་པར་མི་བྱའོ།",
    "དེ་གཞོང་པ་འཁྲུ་ཞིང་འདུག་པ་དང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཡུད་ཙམ་ཞིག་ཀྱང་གནས་ཤིང་འདུག་མི་བྱ།",
    "འདུག་ན་ཡང་བདག་འདུག་གོ་ཞེས་རབ་ཏུ་ཤེས་སོ།",
    "རྐང་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "དུག་འདི་མི་འདུག་པར་གྱུར་ཅིག།",
    "བཅོམ་ལྡན་འདས་གདུགས་དང་དགུང་ཟླ་འདི་ལྟར་རྫུ་འཕྲུལ་ཆེ་བ་འདི་གཉིས་ནི་དོག་ས་ལ་ལྟུང་ཡང་གདའ།",
    "དེ་དག་ལ་མི་ནུས་སུ་ཟིན་ཀྱང་རང་བཞིན་གྱིས་སྐྱོན་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེས་རྒྱལ་པོ་ཆེན་པོ་ཇི་ལྟར་སྟན་བཏིང་བ་ལ་བཞུགས་ཤིག་ཅེས་དེ་སྐད་བྱས་ནས་གལ་ཏེ་འདུག་ན་གཉི་ག་ཡང་འདུག་པར་བྱའོ།",
    "དེ་སྟེ་མི་འདུག་ན་ཡང་གཉི་ག་མི་འདུག་པར་བྱའོ།",
    "དེ་འགྲོའམ་འགྲེང་ངམ་འདུག་གམ་ཉལ་ལམ་སྨྲའམ་མི་སྨྲ་ཡང་རུང་སྟེ།",
    "བཅའ་བ་དང་མྱང་བ་དང་ངོམས་པར་འགྱུར་བ་བསོད་པ་དང་གཙང་མ་མང་པོས་ཚིམ་པར་བྱས་ཏེ་བསྐྱེད་བསྐྱེད་པ་ཡང་ཐ་མའི་མལ་ན་འདུག་པའི་ཚེ།",
    "དཔུང་པའི་རུས་པ་ཡང་གཞན་ན་འདུག་པ་མཐོང་ན།",
    "འདུག་པ་ལ་སོགས་པ་རྟེན་པའི་གནས་ལ་འཇུག་པའི་ལས་དང་།",
    "ལྷག་པར་ཞེན་ནས་འདུག་པ་དེ་ནི་ཚོར་བའི་རྐྱེན་གྱིས་སྲིད་པ་ཞེས་བྱའོ།",
    "གླིང་བཞི་པའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་སའི་རྡུལ་གྱི་ཉེས་པས་མི་འདུག་གོ།",
    "དུ་བའི་དཀྱིལ་འཁོར་གྱི་ཉེས་པས་མི་འདུག་གོ།",
    "གྲིབ་མ་ཐ་དད་པའི་ཉེས་པས་མི་འདུག་གོ།",
    "རི་མི་མཉམ་པའི་ཉེས་པས་མི་འདུག་གོ།",
    "རྟག་ཏུ་དེ་ཡི་མདུན་ན་འདུག།",
    "ཙོག་པུར་འདུག་དང་གཅིག་པུར་རྒྱུ་བ་དང་།",
    "ཀུན་ཀྱང་རང་རང་སོ་སོའི་ལས་ལ་འཇུག།",
    "མི་ནི་མ་སྐྱེས་མ་བྱུང་རང་བཞིན་ཏེ།",
    "རྣ་བ་མ་སྐྱེས་མ་བྱུང་རང་བཞིན་ཏེ།",
