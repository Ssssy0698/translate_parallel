    "ལྡན་པར་བྱེད་པ་ནི་རིགས་ན།",
    "སྔར་འདི་རུ་ཡོད་དོ་ཞེས་འབྲས་བུ་སྔ་མ་དང་ལྡན་པར་བྱེད་ན་ནི་ཡུལ་དེ་ཤེས་པ་ཡང་སྔ་མ་དང་ལྡན་པར་འགྱུར་ལ།",
    "རོ་མཚུངས་པར་འགྱུར་བའི་ངེས་པ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་རྒྱུ་ལྷག་མ་དང་ལྡན་པས་ལྷག་མ་དང་ལྡན་པ་ཡིན་ན་ནི་དེའི་ཤེས་པ་ཡང་ལྷག་མ་དང་ལྡན་པར་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་བྱས་པ་ལ་སོགས་པ་ལས་མི་རྟག་པ་ལ་སོགས་པ་རྗེས་སུ་དཔོག་པར་ཡང་འགྱུར་རོ།",
    "སྔར་ཇི་ལྟ་བར་བྲྗོད་པའི་རྗེས་དཔག་རྣམས་ལ་ཡང་འབྲེལ་པ་རྟོགས་པར་མི་འགྱུར་ཞིང་།",
    "ཞེས་བྲྗོད་པར་བྱ་སྟེ།",
    "རྣམ་པར་དབྱེ་བའང་འགྲུབ་མི་འགྱུར།",
    "གང་རྗེས་སུ་དཔག་པ་ནི་སྔ་མ་ལྡན་པ་དང་ལྷག་མ་དང་ལྡན་པའོ་ཞེས་རྟགས་ཅན་གྱི་དབྱེ་བས་དེ་དག་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "དུས་གསུམ་ལ་འཛིན་པའི་ཕྱིར་རོ་ཞེས་པའི་ངེས་པར་བཟུང་བ་དེ་ཡང་རིགས་པ་མ་ཡིན་ནོ།",
    "ཤེས་པའི་རྒྱུ་ཉིད་ལས་དེའི་ཤེས་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "མེའི་རྣོ་བ་དང་གསལ་བ་ལ་སོགས་པའི་བྱེ་བྲག་རྣམས་ཀྱང་ཐོབ་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་ཡང་དུ་བའི་རྫས་ལ་སོགས་པ་ཙམ་བཟུང་བའི་བདག་ཉིད་དེ་ནས་ཀྱང་མེ་རྟོགས་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་དོན་གཅིག་ལ་འདུ་བ་ལ་འདུ་བ་མི་འཐད་པར་བྲྗོད་དོ།",
    "ཇི་ལྟར་སྲིད་པ་ལྟར་བྲྗོད་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་མངོན་དུ་གྱུར་པ་ལ་ཡང་བྱེ་བྲག་དང་སྤྱིས་ཕན་ཚུན་རྟགས་དང་རྟགས་ཅན་དུ་བྲྗོད་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་འདུ་བ་ལ་སོགས་པ་ལ་ཡང་བྲྗོད་པར་བྱའོ།",
    "གང་ལ་དུད་པ་ཡོད་པའི་ས་ཕྱོགས་དེར་མེ་དང་ལྡན་ནོ་ཞེས་བསྒྲུབ་པར་བྱ་བ་སྟེ།",
    "དེ་ལྟ་མ་ཡིན་ན་འདིར་ཞེས་པ་དོན་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ལ་ཡང་དེ་ཉིད་བྲྗོད་པར་བྱའོ།",
    "པ་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་དོན་གཅིག་ལ་འདུ་བ་ནི་རྣམ་པ་གཉིས་ཉིད་དོ་ཞེས་ངེས་པར་བཟུང་བ་ནི་རིགས་པ་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་གཞན་ལ་ཡང་བྲྗོད་པར་བྱའོ།",
    "གལ་ཏེ་རྒྱུར་བྱས་ནས་རྟགས་སུ་བྲྗོད་པ་སྟེ།",
    "འདི་ལྟར་དེའི་རྒྱུའི་བྱེ་བྲག་ལ་རྟགས་ཀྱི་སྒྲ་མང་དུ་བྱས་ནས་དེ་ལྟར་བྲྗོད་པར་བས་སོ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་འདིར་བདག་དང་ཕྲད་པ་ལ་སོགས་པ་ཡང་བྲྗོད་པར་བྱ་བར་འགྱུར་རོ།",
    "རྣམ་པར་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་ཞེས་པ་དང་།",
    "འབྲེལ་པ་གཞན་གྱིས་ཀྱང་དོན་ཁོང་དུ་ཆུད་པར་བྱེད་དོ།",
    "པ་ནི་སྒྲུབ་པར་དཀའོ།",
    "རྟགས་ཀྱི་ཤེས་པ་ཅུང་ཟད་མ་ངེས་པར་འགྱུར་ཏེ།",
    "དོན་ཇི་ལྟ་པ་ནི་མ་ཡིན་ནོ་ཞེས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་ཕྱིས་ཀྱི་རྩོམ་པ་འཇུག་སྟེ།",
    "དེའི་ཕྱིར་དེ་ཉིད་བྱེ་བྲག་ཏུ་བྲྗོད་པར་བྱ་སྟེ།",
    "དེ་ལྟ་ན་ཡིད་ཀྱི་འཇུག་པ་ཡང་དེའི་ཡུལ་ཅན་ཉིད་ཀྱི་མངོན་སུམ་དུ་བྲྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་རྟགས་འཛིན་པར་མཚུངས་སོ་ཞེ་ན།",
    "དེ་མ་ཤེས་པར་དེ་རྟོགས་ཕྱིར།་།",
    "ཤེས་པ་སྔ་མ་ཉིད་དེའི་ཤེས་པར་བྱེད་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་དུ་ནོར་དང་ནོར་ཅན་ལ་ངེས་པར་ལྟོས་སོ་ཞེས་པའི་མི་འཁྲུལ་བ་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འབྲེལ་པ་རྗེས་སུ་དཔོག་པར་བྱེད་པའི་རྒྱུ་ཉིད་ཡིན་ན་ནི་དེ་ཙམ་གྱི་རྣམ་པས་རྗེས་སུ་དཔག་པར་བྱ་བ་ཤེས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་རྟགས་ལ་ཤེས་པར་བྱེད་པའི་ནུས་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་གཞན་ཡང་རིག་པར་བྱའོ།",
    "དཔྱད་པར་བྱ་སྟེ།",
    "ཅི་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པས་ཡིན་ནམ།",
    "རྒྱུ་ནི་གཙོ་བོ་ཡིན་པས་རྗེས་སུ་འགྲོ་བ་ཐ་དད་པ་ལས་སྟོན་པའི་གཏན་ཚིགས་ཉིད་ཀྱི་སོ་སོར་བྲྗོད་པར་མི་བྱའོ།",
    "གལ་ཏེ་རྗེས་སུ་འགྲོ་བ་གཞན་ཐ་དད་ཉིད་ལས་ལྟོས་པར་མི་བྲྗོད་ན།",
    "རྣམ་པ་ལྔ་རུ་ཐོབ་པར་མི་འགྱུར་ཏེ།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པའི་དངོས་པོའི་འབྲེལ་པ་ནི་གཙོ་བོ་ལ་སོགས་པ་ཉིད་ཀྱི་ཆ་ནས་མ་ཡིན་ནོ།",
    "ཐ་དད་ནི་ཡོད་པ་ཙམ་ལ་སོགས་པས་ཀྱང་རྟོགས་པར་འགྱུར་རོ་གཙོ་བོ་ལ་སོགས་ཀྱི་གཅིག་སོགས།",
    "དེའི་ཕྱིར་གཙོ་བོ་ཡོད་པ་ཉིད་ལ་སོགས་པ་རྟོགས་པར་བྱེད་པའི་གཏན་ཚིགས་ཡིན་གྱི།",
    "འདི་ལྟར་རྣམ་པ་ཐམས་ཅད་དུ་ཕན་ཚུན་གཟུང་བ་དང་འཛིན་པར་འགྱུར་བས་ནའོ།་།",
    "རྣམ་པ་ཀུན་ཏུ་འཛིན་པར་འགྱུར།",
    "ནོར་གྱི་ཆ་ནས་ནོར་ཅན་ཉིད་ཙམ་གསལ་བར་བྱེད་ཅིང་རྟགས་ཅན་གོ་བར་བྱེད་པ་ཡིན་ན་ནི་འབྲེལ་པའི་སྒོ་ནས་འཛིན་པ་བོར་ནས་རྟགས་གཞན་ལས་ནོར་གྱི་དོན་བྲྗོད་པར་ནུས་པ་མ་ཡིན་ནོ།་།",
    "རྒྱུ་དང་རྒྱུ་ཅན་གྱི་དངོས་པོ་ལས་ཐ་དད་པ་ཡིན་པའི་ཕྱིར་འབྲེལ་པ་གཞན་ཉེ་བར་དམིགས་པ་ཉིད་འདིར་འདིའི་གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔོག་པར་བྱེད་པའི་རྒྱུ་གཞན་ནི་དོན་མེད་དོ་ཞེས་སྔར་བྲྗོད་ཟིན་ཏོ།",
    "རྒྱུ་དང་རྒྱུ་ཅན་གྱི་དངོས་པོའི་ཞེས་ཀྱང་བྲྗོད་པར་མི་བྱ་སྟེ།",
    "དེ་དྲན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "དེས་པར་གཟུང་བ་རིགས་པ་མིན།",
    "འབྲས་བུ་དང་རྒྱུ་དག་ལས་ཡང་ནས་ཡང་དུ་རྗེས་སུ་དཔོག་པ་མེད་པར་འགྱུར་རོ།",
    "གནོད་བྱ་གནོད་བྱེད་ཀྱི་འབྲེལ་པ་ཅན་དེ་རྣམས་ཀྱི་དང་པོ་ནི་རྗེས་སུ་དཔག་པར་མི་འགྱུར་རོ།",
    "རྗེས་སུ་གཟུང་པར་བྱ་བ་དང་འཛིན་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེ་ནི་དེ་ནི་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་དུ་ཤེས་པར་བྱ་བ་དང་ཤེས་པར་བྱེད་པ་ཉིད་དུ་ཁས་ལེན་པར་བྱེད་པ་ཡིན་ན་ནི་ཕན་འདོགས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་དག་ནི་གཉིས་སོ་ཞེས་ངེས་པར་བཟུང་བ་དེ་དག་ངེས་པར་གཟུང་བར་མི་བྱ་སྟེ།",
    "གལ་ཏེ་རྒྱུ་ཉིད་རྗེས་སུ་དཔག་པར་བྱེད་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ཉེ་བར་བརྟགས་ནས་བྲྗོད་པར་བྱའོ་ཞེ་ན།",
    "འཁྲུལ་པར་བྲྗོད་དོ་ཞེ་ན།་",
    "གལ་ཏེ་ཡང་རྒྱུ་དང་འབྲས་བུའི་ཤེས་པ་དང་མི་ལྡན་པས་ཡང་འཁྲུལ་པར་བྱེད་པ་ཉིད་མ་ཡིན་ལ།",
    "གལ་ཏེ་རྣམ་པར་དཔྱོད་པ་ཅན་གྱི་ལྷག་མ་དང་ལྡན་པ་ཉིད་ནི་རྗེས་སུ་དཔག་པ་སྟེ་གཞན་དུ་གཏན་ཚིགས་ཉིད་ལ་རྗེས་སུ་དཔག་པར་ཉེ་བར་བརྟགས་ནས་བྲྗོད་དོ་ཞེ་ན།",
    "དཔྱོད་དང་བཅས་པར་བྲྗོད་པར་བྱ།་།",
    "དེ་ན་ལྷག་མ་དང་ལྡན་པ་ཁོ་ན་རྣམ་པར་དཔྱོད་པ་དང་བཅས་པ་ནི་མ་ཡིན་ཏེ།",
    "རྟགས་ཡོད་པར་གྲུབ་པ་འདི་ལ་ཅི་འདི་ལས་འགྱུར་ར་མ་འོན་ཏེ་མི་འགྱུར་ཞེས་རྣམ་པར་དཔྱོད་པའི་ཕྱིར་རོ།",
    "བསན་མི་འཁྲུལ་བ་ཉིད་ཡིན་ཞིང་རྣམ་པར་དཔྱོད་པ་དང་བཅས་པ་ཡིན་ཡང་བྱ་བ་དང་བྱེད་པ་ལས་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་དེའི་ཡང་ཐ་དད་པ་ལས་རྟོགས་པར་མི་རིགས་སོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ནི་རྣམ་པར་ལྡན་པ་རྣམ་ལྔ་བྲྗོད་པར་མི་བྱ་ཞིང་གཙུག་ཕུད་ཅན་གྱི་དོན་བཅུ་ཡང་མ་ཡིན་ནོ།",
    "འགྲེལ་པ་བྱེད་པས་ནི་ངག་བྱེད་མཁན་གྱི་བསམ་པ་རྗེས་སུ་བཟླས་ནས་རྣམ་པར་ཕྱེའོ་ཞེས་ཟེར་རོ།",
    "མངོན་སུམ་སྔོན་དུ་འགྲོ་བ་ཅན་ཉིད་ནི་འབྲེལ་བའམ་ལྡན་པ་ལ་སོས་པ་ལ་མངོན་སུམ་པ་ཉིད་དུ་བྲྗོད་པར་བྱ་ན་འབྲེལ་པ་ཅན་ནམ་གཉིས་ཀ་ལྟར་ན་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "འགྲེལ་པ་བྱེད་པས་ནི་ཕལ་ཆེར་བྱེ་བྲག་པའི་རྗེས་སུ་དཔག་པ་ཉིད་རྗོད་པར་བྱེད་པ་སྟེ།",
    "མཐོང་བའི་སྤྱི་དང་མ་མཐོང་བའི་ལ་སོགས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེས་ནི་ལྡན་པ་དང་བཅས་པའི་འབྲེལ་པ་ཅན་མངོན་སུམ་པར་གྱུར་པ་ཡིན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "གཉིས་ཀའི་རྒྱུར་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཁོང་དུ་ཆད་པར་བྱེད་མ་ཡིན།",
    "དང་རྗེས་སུ་བསྟན་པ་དང་ཉེ་བར་གཞལ་བ་རྣམས་ལ་ནི་འདིར་དགག་པ་བྲྗོད་པར་མི་བྱ་སྟེ།",
    "དེས་ན་དེ་བཀག་པ་བཞིན་དུ་འདི་ཡང་བཀག་པར་རིག་པར་བྱའོ།",
    "དོན་གྱི་གོ་བ་གཉིས་ཀ་ལ་འགག་པར་བྲྗོད་པར་བྱ་སྟེ།",
    "དེ་ནི་འཚོད་པའི་རྟགས་གཉིད་ལས་ཁོང་དུ་ཆུད་པར་བྱེད་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ལས་ཐ་དད་པ་མ་ཡིན་ནོ།",
    "ཕྱི་ན་ཡོད་པར་རབ་ཏུ་རྟོགས།",
    "ནག་པ་ཁྱི་མན་མེད་ཅེས་བྱ་བ་འདི་ལ་ཁྱིམ་གྱི་སྒྲའི་སྦྱོར་བ་ཉིད་ལས་ནག་པ་ཕྱི་རོལ་ན་ཡོད་པར་དོན་གྱིས་གོ་བ་ཡིན་གྱི།",
    "གལ་ཏེ་ཁྱིམ་དང་ཕྱི་རོལ་གཉིས་ཀ་ན་མེད་ན་ནི་མེད་དོ་ཞེས་བྱ་བཙམ་ཉིད་བྲྗོད་པར་འགྱུར་རོ།",
    "འདིར་ཡང་ཚུལ་གང་ཡང་རུང་བ་ཅིག་མ་སྨྲས་ན་ཡང་མ་ཚང་བ་བྲྗོད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པར་བྱ་བ་སྟོན་པ་ནི།",
    "དེ་ཉིད་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རྟགས་ཀྱི་དོན་དུ་ཡུལ་བསྟན་པའི་ཕྱིར་དེ་ནི་དེས་བསྒྲུབ་པར་བྱའོ།",
    "དཔེ་ལྟར་སྣང་བ་དག་ཀྱང་ཡོངས་སུ་སྤངས་པར་བྲྗོད་པ་སྟེ།",
    "དེ་དག་སྒྲུབ་པར་འོས་པའི་ངོ་བོར་བྲྗོད་པར་མི་བྱའོ།",
    "དེ་ལྟར་ན་བསྒྲུབ་པར་བྱ་བ་ཁ་ན་མ་ཐོ་བ་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "གྲུབ་པ་མེད་པར་དོན་གྱིས་བྱས།",
    "བསྒྲུབ་བྱ་སྨོས་པས་ནི་གྲུབ་པ་ལོག་པ་ཙམ་དུ་བསྟན་པའི་ཕྱིར་བསྒྲུབ་བྱའི་བྱེ་བྲག་ཉིད་ནི་མ་ཡིན་པར་གནས་སོ།",
    "དེ་སྟེ་གཉིས་ཀ་ཡིན་ཞེས་བྲྗོད་པར་བྱའོ།",
    "བསྒྲུབ་བྱ་བསྟན་པ་དམ་བཅའ་བ་ཉིད་དོ་ཞེས་ངས་པར་བཟུང་བར་འོག་ཏུ་སྦྱོར་གྲང་།",
    "གལ་ཏེ་བསྒྲུབ་བྱ་བསྟན་པ་ཉིད་དོ་ཞེས་ངེས་བཟུང་གོང་དུ་སྦྱོར་ན་ནི་སྒྲུབ་བྱེད་དུ་བསྟན་པའི་རྟགས་ལ་སོགས་པ་འཕངས་ཟིན་པའི་ཕྱིར་གོང་དུ་ངེས་བཟུང་བྱས་པ་ལས་དོན་མེད་དོ།",
    "རྟགས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "ཕྱོགས་དེ་ཅི་ཞིག་རྣམ་པར་དཔྱད་པའི་འདོད་པ་དོན་ཏེ།",
    "དེ་ཕྱོགས་ཡིན་པས་བསྒྲུབ་བྱ་ཙམ་དེ་རྟགས་མ་གྲུབ་པ་ལ་སོགས་པར་བྲྗོང་པ་ཡང་དམ་བཅའ་བར་འགྱུར་རོ་ཞེས་པའི་སྐྱོན་ནི་མེད་དོ་ཞེ་ན་སྐྱོན་ཇི་ལྟར་ན་མེད་དེ་དེ་ལ་ཡང་།",
    "རྣམ་པར་དཔྱད་པའི་འདོད་པ་འདི།",
    "དེ་ནི་མི་འདོད་པ་ལོག་པ་ཙམ་ཡིན་པར་བས་སོ།་།",
    "ལེགས་པར་མ་བསླབས་པ་རྣམས་ཀྱིས།",
    "དེར་ནི་འདི་ལྟར་སྦྱོར་བ་བྱས་ནས་མཛེས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ནི་ཐམས་ཅད་མ་ཡན་པ་མི་འདོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འདུས་བྱས་མི་རྟག་སྟེ་འདུས་བྱས་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་དེ་དག་ལ་ཡང་དམ་བཅའ་བའི་དོན་གྱི་ཕྱོགས་གཅིག་གཏན་ཚིགས་སུ་འགྱུར་བ་མཐོང་ངོ་ཞེ་ན།",
    "འདིར་འདུས་པ་དང་འདུས་བྱས་ཐམས་ཅད་ནི་དམ་བཅའ་བའི་དོན་མ་ཡིན་ཏེ།",
    "དཔེ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདུས་བྱས་ཀྱི་ཕྱོགས་གཅིག་ཡིན་ནོ།",
    "རྩོད་པ་སྒྲུབ་པར་ནི་འདི་འགལ་བའི་གཏན་ཚིགས་ལྟར་སྣང་བ་ཉིད་ཀྱི་ཁོངས་སུ་བསྡུས་ཏེ།",
    "དེ་གཉིས་ཀ་ཡང་འགལ་བ་ཉིད་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱའོ།",
    "ད་ནི་གཏན་ཚིགས་བསྟན་པར་བྱ་སྟེ།",
    "སྔོན་དུ་རྒྱས་པར་དེ་བསྟན་བྱ།",
    "དེ་ལ་མེའི་ཡོད་པ་རྟོགས་པ་ནི་མ་ཡིན་གྱི་འདི་ལའོ་ཞེས་རྗོད་པར་བྱེད་དོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་དུ་བ་ལ་མེ་མཐོང་བར་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "མེའི་བྱེ་བྲག་བསྒྲུབ་བྱ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ས་ཕྱོགས་ཀྱི་ཁྱད་པར་བྱས་པའི་དུ་བའི་བསྒྲུབ་བྱ་ཉིད་དུ་ཁས་བླང་བར་བྱའོ།",
    "དེར་ནི་ཐ་དད་པ་ཉིད་རྒྱུ་གཅིག་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "མེད་ལ་མེད་པར་བྲྗོད་པར་བྱ།",
    "བྱས་པ་མི་རྟག་པའི་ཕྱིར་ཞེས་པའམ།",
    "རྟག་སྟེ་མ་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "སྒྲ་བྱས་སོ་ཞེས་པའམ་མ་བྱས་པ་མ་ཡིན་ནོ་ཞེས་པ་བཞིན་ནོ།",
    "གཏན་ཚིགས་མེད་པར་འགྱུར་བ་ནི།",
    "འདི་ལ་ཁྱད་པར་ཅི་ཡོད།",
    "རྫས་མི་ཡིན་པ་ཡང་རྫས་བཞིན་དུ་རྫས་ཡོད་པར་འགྱུར་རོ་ཞེས་དམ་བཅའ་བའི་སྐྱོན་ཡིན་ཏེ།",
    "དེ་དག་རྣམ་པར་ཕྱེ་བ་ནི་མཐུན་ཕྱོགས་ལ་ཡོད་མེད་རྣམ་གཉིས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བྱས་ནས་གཞན་ལ་སྟོན་པར་བྱེད།",
    "རྣམ་པར་དཔྱད་པ་ལས་འགྱུར་ཡིན།",
    "མི་མཐུན་པའི་ཕྱོགས་ཡོད་པ་དེས་ན་གཏན་ཚིགས་མེད་པར་འགྱུར་རོ།",
    "འདི་ལྟར་གང་མཐུན་པའི་ཕྱོགས་ལ་ཡོད་པའི་བྱས་པ་ཉིད་ལ་སོགས་པ་དེ་ནི་མི་རྟག་པ་ལ་སོགས་པ་ལས་གཞན་དུ་སྡུག་བསྔལ་ལ་སོགས་པ་ལ་ཡང་ཡོད་པ་ཡིན་ནོ།",
    "དེ་གཏན་ཚིགས་ཡིན་པས་ན་བྱས་བ་ཉིད་ནི།",
    "བྱས་པ་ཉིད་སྤྱི་ཡིན་ཡང་རྟག་པ་དང་བདག་མེད་པ་ལ་སོགས་པ་རྣམས་ལ་བུམ་པ་ལ་སོགས་ཡྤ་བཞིན་དུ་ཐེ་ཚོམ་དུ་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "བུམ་པ་ནི་བྱས་པ་ཉིད་ཡིན་ལ་བུམ་པ་མ་ཡིན་པ་ལ་ཡང་མཐོང་བ་ཡིན་ནོ།",
    "བྱས་པ་ཉིད་མི་རྟག་པ་ལ་སོགས་པ་ལ་ཡང་མེད་པར་མཐོང་བ་ནི་མ་ཡིན་ཏེ།་",
    "ཐམས་ཅད་དུ་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་དང་ལྡན་པའི་ཕྱིར་རྣམ་པར་བཅད་པ་ལས་གཏན་ཚིགས་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེ་གཉིས་ཉིད་སླར་བཟླས་པར་འགྱུར་རོ།",
    "ཕྱོགས་བཞིས་རང་བཞིན་དང་འབྲས་བུ་ལ་སོགས་པར་ཤེས་པར་བྱའོ།",
    "མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་རོ།",
    "བྱས་པའི་ཕྱིར་རྟག་པའོ།",
    "གཞལ་བྱ་བྱས་དང་མི་རྟག་དང་།",
    "བྱས་དང་མཉན་བྱ་རྩོལ་ལས་བྱུང་།",
    "མ་ངེས་པ་ཉིད་དུ་བྲྗོད་པར་བྱ་སྟེ།",
    "གང་བསྒྲུབ་བྱ་ལ་གནོད་པ་སྒྲུབ་པར་བྱེད་པའོ།",
    "དཔེར་ན་ཐ་དད་རྣམས་ཀྱི་འདུས་པ་ཉིད་གཞན་གྱི་དོན་སྒྲུབ་པར་བྱེད་པ་ཉིད་ལ་འདུས་པ་ཡིན་པའི་ཕྱིར་གཞན་གྱི་དོན་སྒྲུབ་པོ་ཞེས་བྱ་བ་ལྟ་བུ་སྟེ།",
    "བྲྗོད་པར་འདོད་པའི་གྲངས་གཅིག་ཉིད།",
    "གང་ཡང་གྲངས་གཅིག་ཅེས་པ་ནི་འདིར་གང་རིགས་དང་མཐུན་པར་ཡོད་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དེ་བྲྗོད་པར་འདོད་པ་སྟེ།",
    "གལ་ཏེ་གང་ཕྱིར་འགལ་བ་མཚན་ཉིད་གཉིས་སུ་བྲྗོད་པ་དག་ལས་གྲངས་གཅིག་པར་ནི་མཐོང་བ་ཉིད་དེ།་",
    "དཔེར་ན་སྒྲ་ལ་བྱས་པ་ཉིད་དང་།",
    "གཅིག་ཏུ་ངེས་པར་མཐོང་མ་ཡིན།",
    "དེའི་ཕྱིར་བྲྗོད་པར་འདོད་པ་གཅིག་ཉིད་དོ།",
    "གལ་ཏེ་འདི་ལྟར་བྲྗོད་པར་འདོད་པ་གཅིག་ཉིད་ལས་ཐེ་ཚོམ་དང་ངེས་པ་གཉིས་དག་ཏུ་ནི་མི་འགྱུར་རོ་ཞེ་ན།",
    "འདིར་ནི་ཐེ་ཚོམ་དང་གཏན་ལ་དབབ་པ་དེ་གཉིས་ཀའི་མཚན་ཉིད་དང་ལྡན་པར་འཐད་ཀྱི་ཁ་ཡང་དུ་མ་ཡིན་ནོ།་།",
    "འདི་དཔེར་ན་བྱས་པའི་ཕྱིར་མི་རྟག་གོ།",
    "རྩོལ་བ་ལས་བྱུང་བའི་ཕྱིར་མི་རྟག་གོ་ཞེས་བྱ་བ་ལྟ་བུ་དུ་མ་ལས་ཇི་ལྟར་ངེས་པར་སྐྱེ་ཞེ་ན་དུ་མ་ཡིན་ཡང་མི་འགལ་ན།",
    "ཏེ་གང་དུ་འདི་ལྟར་གཉིས་ཀྱི་དོན་དུ་མ་བྱེད་པར་གྱུར་པ་ནི་དཔེར་ན་བྱས་པའི་ཕྱིར་མི་རྟག་གོ།",
    "གལ་ཏེ་གང་དུ་འདི་ལྟར་བསྒྲུབ་བྱ་དུ་མ་གཏན་ཚིགས་ཐ་དད་ཀྱིས་སྒྲུབ་པར་བྱེད་པ་ནི་དཔེར་ན་ཡན་ལག་ལས་ཡན་ལག་ཅན་གཞན་ཡིན་ཏེ།",
    "ཐེ་ཚོམ་དང་གཏན་ལ་ཕེབས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལྟ་བུའོ་ཞེ་ན།",
    "འོ་ན་མཉན་པར་བྱ་བ་ཉིད་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "གང་འདིར་གཉིས་ཀའི་ཆ་ལ་ངེས་པ་སྟེ་གཏན་ཚིགས་དེ་གཞན་ལས་ལོག་པའོ་ཞེས་པ་འདི་ཁྱད་པར་རོ།",
    "གལ་ཏེ་འདི་ལ་བྱས་པའི་ཕྱིར་ཞེས་པ་ལ་སོགས་པ་མི་རྟག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་སུ་ནམ་ཡང་མི་སྟོན་ནའོ།",
    "གལ་ཏེ་འདི་ལྟར་འདོད་པ་ལ་གནོད་པ་བྱེད་པའི་འགལ་བ་དེ་བཟློག་པའི་གཏན་ཚིགས་སོ་ཞེས་ཇི་ལྟར་བྲྗོད་པར་བྱ་ཞེ་ན།",
    "དེ་བཞིན་དུ་བྱས་པའི་ཕྱིར་མི་རྟག་གོ་ཞེས་པ་ལ་བྱས་པས་མི་རྟག་པ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "རྟགས་ཉིད་དུ་སྒྲུབ་པའི་གཏན་ཚིགས་མཉན་པར་བྱ་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "རྒལ་བ་འདི་ནི་མི་བཟད་པར་བཀོད་པ་སྟེ།",
    "དེ་ལ་ནི་རྟག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་དང་ལྡན་པ་གཅིག་གཟུང་བའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་འགྱུར་རོ།་།",
    "དེ་ལྟ་ན་ནི་འགལ་བ་མི་འཁྲུལ་བ་ཅན་ལས་ཐ་དད་པར་འགྱུར་རོ།",
    "འདི་ལ་ཐེ་ཚོམ་མ་མཐོང་ངོ་ཞེས་བརྟག་པར་མི་བྱའོ།",
    "འདི་ལྟར་གཞན་གྱི་དོན་བྱེད་པ་ཁྱད་པར་ཅན་ལས་བཟློག་པ་བསྒྲུབ་པའི་ཕྱིར་དེ་ནི་འགལ་བ་ཉིད་དོ།",
    "དེ་ལྟར་ན་འདུས་པ་གཞན་གྱི་དོན་བྱེད་པ་ལ་འདུས་པ་མ་ཡིན་པ་རྣམས་ཀྱི་དོན་བྱེད་པར་སྒྲུབ་འདོད་པ་འདི་ནི་གཞན་འདུས་པ་ཉིད་ཀྱི་རྟགས་ཡིན་ནོ།",
    "དེ་ཡོད་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "འདི་ནི་ཐེ་ཚོམ་མ་ཡིན་ཏེ་ཁྱད་པར་ཅན་བཟློག་པའི་གཏན་ཚིགས་འདི་ཉིད་ཀྱིས་གཞན་འགལ་བ་མི་འཁྲུལ་བ་ཅན་ཉིད་ལས་ཐ་དད་དུ་ཕྱེ་བ་ཡིན་ནོ།",
    "གཉིས་ཀའི་དཔེར་བྲྗོད་བསྟན་པར་བྱ་སྟེ།་",
    "མཚོན་བྱེད་ཡིན་པའི་ཕྱིར་རྨི་ལམ་གྱི་བྱ་བའི་རྣམ་པར་རིག་བྱེད་བཞིན་ནོ་ཞེས་བྱ་བ་ལ།",
    "ཁྱད་པར་དང་།",
    "རྣམ་པ་དགུ་ཉིད་དུ་ཕྱེ་བ་ཡང་གསུམ་པོ་དེ་དག་ཉིད་ལས་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "དཔེར་ན་སྒྲ་རྟག་པའམ་མི་རྟག་པར་གྲུབ་པ་ལ་གཞལ་བྱ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་དང་།",
    "ལོག་པར་རྟོགས་པ་དང་ཐེ་ཚོམ་གྱི་གཏན་ཚིགས་ཉིད་དུ་ཡིན་ནོ།",
    "ཕྱོགས་དུ་མ་དག་ལས་གཅིག་རྣམ་པར་བཅད་པ་ཡང་མ་ཡིན་ལ་ཅིག་ཤོས་སྒྲུབ་པར་གཏན་ལ་ཕབ་པ་ཡང་མ་ཡིན་པ་དེ་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ལས་ཡིན་ཏེ།",
    "དེ་དག་ནི་ཆ་ཤས་གཅིག་དང་ཡང་མ་བྲལ་བ་ཡིན་པར་རྟོགས་སོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ནི་གཅིག་ལ་ངེས་པར་ཞུགས་པ་དང་།",
    "འདི་ལྟར་གཉིས་ཀའི་ཆ་ལ་གཅིག་ཏུ་ངེས་པར་ཞུགས་པ་མ་ཡིན་ཞིང་རྗེས་སུ་ཞུགས་པ་དང་ལོག་པ་དག་ནི་གཉིས་ཀའི་གཏན་ཚིགས་སུ་འགྱུར་རོ་ཞེ་ན།",
    "གང་དོན་གཅིག་ལ་རྟག་པར་ཡང་འགྱུར་མི་རྟག་པར་འགྱུར་བ་ནི་མི་སྲིད་དོ།",
    "དོན་གཞན་རྣམ་པར་བཅད་པའི་སྒོ་ནས་ཡིན་གྱི་དེའི་ཁྱད་པར་བཟུང་ནས་ནི་མ་ཡིན་ཏེ།",
    "གྲུབ་དོན་དོན་བཞིན་སྒྲུབ་པར་བྱེད།",
    "གཉིས་ཀའི་ཆ་ལ་ནི་གང་ལ་མེད་པ་དེ་ལས་རྣམ་པར་གཅོད་དོ།",
    "དེའི་སྒོ་ནས་བསྒྲུབ་བྱའི་རིགས་མཐའ་དག་གམ་ཕྱོགས་གཅིག་ལ་ཞུགས་ནས་དོན་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པར་བྱེད་པའི་གཏན་ཚིགས་སུ་བྲྗོད་པ་ཡིན་ཏེ།་",
    "དཔེར་ན་སྒྲ་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བ་དང་།",
    "གསུམ་གཉིས་གཅིག་ཏུ་རྟོགས་པར་འགྱུར།",
    "འགལ་བ་རྣམས་གཅིག་ལ་བྲྗོད་པར་མི་འདོད་པས་སོ།་།",
    "དེ་རྣམ་པར་བཅད་སྟེ་བསྒྲུབ་པར་བྱ་བའི་དོན་དུ་གཞན་ལ་ཞུགས་པའི་ཕྱིར་བཟློག་པ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "དཔེར་ན་གཏན་ཚིགས་དེ་དག་ཉིད་ལས་རྟག་པ་ཡིན་ནོ་ཞེས་སྒྲུབ་པར་བྱེད་པ་ལྟ་བུའོ།",
    "འདི་ལ་ཡང་རྟག་པ་བཀག་པའི་སྒོ་ཉིད་ནས་བཟློག་པ་སྒྲུབ་པར་བྱེད་དོ།",
    "ཅི་སྟེ་བྱས་པ་ཉིད་ནི་རྩོལ་བ་ལས་བྱུང་བ་དང་མ་བྱུང་བ་གཉིས་ཀ་དང་ཐ་མི་དད་པ་ཡིན་ལ།",
    "ཐ་མི་དད་ཐམས་ཅད་ལས་མ་ལོག་པར་ཞུགས་པས་མི་རྟག་པ་ཉིད་རྗེས་སུ་ཞུགས་པའི་ཤེས་པས་ནི་རྟག་པ་བཀག་པ་ལ་མི་ལྟོས་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་གང་ཞིག་གང་ལ་ཞུགས་པ་དེ་ནི་རྗེས་སུ་ཞུགས་པའི་ཤེས་པའི་བྱེ་བྲག་དེ་རྣམ་པར་གཞིག་པའི་སྒོ་ནས་བྱེད་པར་ནུས་ན་ནི་དེ་ལྟར་འགྱུར་རོ།",
    "དཔེར་ན་བྱས་པ་ཉིད་རྩོལ་བ་ལས་བྱུང་བ་དང་།",
    "གལ་ཏེ་བྱས་པའི་ཕྱིར་རྩོལ་བ་ལས་བྱུང་བའོ་ཞེས་སྒྲུབ་པའམ།",
    "ཡང་ན་བྱས་པ་ཡིན་པའི་ཕྱིར་རྩོལ་བ་ལས་མ་བྱུང་ངོ་ཞེས་སྒྲུབ་ཀྱང་རུང་ངོ།",
    "དེ་བཞིན་དུ་རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ལས་ཡོན་ཏན་ནམ་ཡོན་ཏན་མ་ཡིན་པར་སྒྲུབ་པ་ཡང་ངོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ནི་བྱས་པའི་ཕྱིར་མི་རྟག་གོ།",
    "གལ་ཏེ་མི་རྟག་པ་དང་བྲལ་བའི་བདག་མེད་པ་ལ་བྱས་པ་ཡོད་བར་འགྱུར་ན་ནི་དེ་ལྟ་བུ་ཉིད་དུ་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཕན་ཚུན་ལོག་པ་ཉིད་ལས་འདིའི་ཁྱད་པར་དུ་འགྱུར་རོ།",
    "དེའི་ཕྱིར་སྒྲ་ལ་བྱས་པ་ཉིད་མི་རྟག་པ་དང་བདག་མེད་པ་ལ་སོགས་པ་མཐོང་བའི་ཕྱིར་དང་།",
    "གང་རིགས་མཐུན་མཐའ་དག་ལས་ལོག་པ་དེའི་སྒོ་ནས་བསྒྲུབ་བྱ་ལ་ཤེས་པ་འཇུག་པར་བྱེད་པ་དེ་དག་ནི་རིགས་ཀྱི།",
    "འདིར་གོར་མ་ཆགས་པར་མཐུན་ཕྱོགས་མཐའ་དག་ལ་ཡོད་པའོ་ཞེས་པ་ནི་མ་ཡིན་ཞིང་།",
    "ཐམས་ཅད་ལ་ཡོད་པར་འཛིན་པ་ཡང་མི་སྲིད་དོ།",
    "དེར་ནི་ཉིད་ཀྱིས་ངེས་པར་བསྐྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "གཉིས་ཀའི་ཆ་ནི་གཞན་ལས་རྣམ་པར་བཅད་ནས་གང་ན་ཐེ་ཚོམ་ཡོད་པ་དེ་ན་གཞན་དང་།",
    "འདི་ལྟར་འགྲེང་བ་དང་བྱ་བབས་པ་ལས་མཐོ་ཡོར་དུ་རྟོགས་པ་མཐོང་བ་ནི་ཁ་ཡར་བ་ལས་ངེས་པར་མི་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དང་།",
    "དེ་ནི་གང་ཞུགས་པ་ཉིད་ལ་ལྟོས་ནས་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དེ།",
    "དཔེར་ན་ཅི་སྒྲ་འདི་བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན་རྩོལ་བ་ལས་བྱུང་བ་ཡིན་ནམ།",
    "འདི་ལྟར་བྱས་པ་ཉིད་ནམ་མཁའ་ལ་སོགས་པ་རྟག་པ་ཉིད་ལས་རྣམ་པར་བཅད་ནས་མི་རྟག་པ་ལ་ཐེ་ཚོམ་གྱི་གཏན་ཚིགས་སུ་འགྱུར་རོ།",
    "དོན་གཞན་རྣམ་པར་བཅད་པའི་གཏན་ཚིགས་གཞན་གྱིས་ཡོངས་སུ་གྱུར་པའི་དེ་ལ་ཐེ་ཚོམ་དུ་གྱུར་པ་ནི་མ་ཡིན་ནོ།",
    "མ་ཡིན་པར་དགག་པ་ལ་ཡང་དེ་བཞིན་དུ་སྦྱར་བར་བྱའོ།",
    "འདི་ལ་ཡང་མེད་པར་དགག་པ་ལས་ཁྱད་པར་དུ་བསྒྲུབ་པར་བྱ་རྒྱུའི་བྱ་བ་རྟག་པ་རྣམ་པར་བཀག་པ་དང་སྦྱར་བ་ཡིན་ནོ་ཞེས་བྲྗོད་པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འདི་ལྟར་ལུས་ཅན་མ་ཡིན་པའི་ཕྱིར་རྟག་པའི་ཞེས་བྱ་བ་ལྟ་བུ་ཐམས་ཅད་དུ་བསྒྲུབ་པར་བྱ་བ་གཉིས་ཀའི་ཆ་ལ་ལྟོས་པ་རྣམ་པ་གསུམ་པ་འདི་ཅི་ལྟར་རྣམ་པར་གཅོད་པའི་གཏན་ཚིགས་ཡིན་ཞེ་ན།་",
    "འདི་ཡང་གང་ལ་ལྟོས་པའི་ཐེ་ཚོམ་གྱི་གཏན་ཚིགས་དེ་གཞན་ལས་རྣམ་པར་བཅད་པ་ཡིན་ཏེ།",
    "ད་ནི་གཞན་གྱི་འདོད་པ་ལ་དཔྱད་པར་བྱ་སྟེ།",
    "མེད་པ་ཉིད་ལས་ངེས་པར་གཟུང་།",
    "འོན་ཀྱང་མེད་པ་ཁོ་ན་ལ་མེད་པའོ་ཞེས་ངེས་པར་བཟུང་བ་དེའི་ཕྱིར་ཁྱབ་མཉམ་པོར་ཡོད་པ་ཁོ་ན་གཏན་ཚིགས་སུ་འགྱུར་ཏེ།",
    "དེ་ལ་བྱས་པ་ཁོ་ན་མི་རྟག་པ་གོ་བྱེད་དུ་འགྱུར་གྱི་རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ནི་མ་ཡིན་པར་འགྱུར་རོ།",
    "དཔེར་ན་བྱས་པ་ཉིད་ནི།",
    "དེའི་ཕྱིར་ངེས་པར་བཟུང་བ་གསུམ་ག་སྐྱོན་ཅན་ཡིན་ནོ།",
    "ཅི་སྟེ་འདི་ཡང་དག་པའི་དོན་ཇི་ལྟར་ཡོད་པ་ལྟར་མཚན་ཉིད་རྗོད་པར་བྱེད་དོ་ཞེ་ན།",
    "ཤེས་པར་བྱེད་ལས་འདས་པ་བཞིན།",
