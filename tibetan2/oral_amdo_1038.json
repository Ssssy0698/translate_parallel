    "དེ་ལྟར་ཡཱིད་ཀཱི་ཕྱག་རྒྱའཱི་སོར་བ་སྣ་ཚོགས་རོ་རེ་གཞག་པ་གསུངས་པ་ཡཱིན་ནོ།",
    "རྒྱས་གདབ་ཅེས་བྱ་བ་ནཱི་ལས་ཀཱི་རོ་རེ་དམཱིགས་པར་བྱའོ།",
    "ཕྱག་རྒྱ་རེ་རེས་ཀང་ལས་རྣམ་པ་བཞཱི་ཆར་བྱེད་ཅཱིང་།",
    "རང་གཱི་སོར་བ་ལེགས་པར་གོམས་པར་བྱས་ན་ཕྱག་རྒྱ་རེ་རེས་ཀང་ལས་ཐམས་ཅད་བྱེད་དོ་ཞེས་གསུངས་པ་ཡཱིན་ནོ།",
    "ཕྱག་རྒྱ་རེ་རེས་ཀང་ཕྱག་རྒྱའཱི་ལས་བཞཱི་རྣམས་ལ་ཕྱག་རྒྱའཱི་སཱིང་པོ་བཞཱིས་སར་རོ་ཞེས་གསུངས་ཏེ།",
    "ཡཱིད་ཀཱིས་དེར་རེས་སུ་ཞུགས་པ་ལ་ཡན་ལག་དང་཈ཱིང་ལག་ཐམས་ཅད་དུ་ཁབ་པར་བྱ་བའོ།",
    "འདཱི་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བར་མཛད་པས་ན་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་པའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའང་དེ་ཡཱིན་ལ་དཀཱིལ་འཁོར་ཆེན་པོ་ཡང་དེ་ཡཱིན་པས་ན་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་དཀཱིལ་འཁོར་ཆེན་པོ་སེ།",
    "རོ་རེ་དབྱཱིངས་ཀཱི་ཚུལ་གཱིས་ནཱི།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་དབྱཱིངས་ལས་བསན་པའཱི་ཚུལ་གཱིས་ཏེ།",
    "རོ་རེ་དབྱཱིངས་ལས་སོས་པའཱི་ཚུལ་དེ་ཡང་གང་ཡཱིན་ཞེ་ན།",
    "རོ་རེ་དབྱཱིངས་ཀཱི་ཚུལ་དེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནཱི་རོ་རེ་ཧཱུྃ་མཛད་ཀཱི་ཕྱག་རྒྱ་ཆེན་པོ་སོན་ཏེ།",
    "ཞེས་བྱ་བ་ནཱི་ཇཱི་ལྟར་བཅོམ་ལྡན་འདས་རོ་རེ་ཧཾཧཱུྃ་མཛད་ཀཱི་མནན་པ་སེ་དེ་ལྟར་མནན་པའོ།",
    "སེམས་དཔའཱི་ཕྱག་རྒྱ་ནཱི་རོ་རེ་ཧཾཧཱུྃ་མཛད་ཀཱི་ཕྱག་རྒྱ་སེ།",
    "ཞེས་བྱ་བ་ནཱི་འདཱི་ལྟར་བསེད་པ་ཙམ་གཱིས་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར་བའོ།",
    "དེ་ལྟར་ན་རོ་རེ་ཧཱུྃ་མཛད་དང་མཚུངས་པར་འགྱུར་རོ།",
    "ཇཱི་ལྟར་རཱི་མོ་བྲཱིས་པ་བཞཱིན།",
    "ཇཱི་ལྟར་རཱི་མོ་བྲཱིས་པ་བཞཱིན།",
    "སྐུ་གསུང་ཐུགས་ནཱི་རོ་རེ་ཡཱིས།",
    "དེ་ལྟར་ན་གསུམ་ཆར་ཡང་རོ་རེ་ལྟ་བུས་སེམས་དཔའཱི་ཕྱག་རྒྱ་ཆེན་པོ་བཅཱིང་བར་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྒྱལ་བཅཱིངས་ན།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་རྒྱལ་འགྱུར།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཧཱུྃ་མཛད་དང་མཚུངས་པར་འགྱུར་རོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "རོ་རེའཱི་ཚེ་ཡཱིན་པས་ན་རོ་རེ་ཚེ་སེ།",
    "རོ་རེ་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེ་ཧཾཧཱུྃ་མཛད་དོ།",
    "དེ་ལྟར་ན་རྣམ་པ་ཐམས་ཅད་ཀཱིས་རོ་རེ་ཧཾཧཱུྃ་མཛད་དང་མཚུངས་པར་འགྱུར་རོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "ལས་ཀཱི་ཁོ་བོ་རོ་རེ་ཆེ།",
    "རོ་རེ་ལས་ནཱི་བྱེད་པར་འགྱུར།",
    "སེམས་དཔའ་ཁོ་ནཱི་རོ་རེ་སེམས་དཔའཱི་ཁོ་བོ་སེ།",
    "རོ་རེ་རལ་གྲཱིས་གཅོད་པར་བྱེད།",
    "ཅེས་བྱ་བ་ནཱི་རོ་རེ་རལ་གྲཱིའཱི་ཕྱག་རྒྱ་བཅཱིངས་ན་དེས་སྡུག་བསྔལ་ཐམས་ཅད་གཅོད་པར་འགྱུར་རོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "རོ་རེ་ག་཈ཱིས་ལས་བྱུང་བ་ནཱི།",
    "རོ་རེ་ག་཈ཱིས་ནཱི་རོ་རེ་ཁུ་ཚུར་ག་཈ཱིས་སོ།",
    "ལག་ངར་རོ་རེར་བྱས་ནས་སུ།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཁུ་ཚུར་ག་཈ཱིས་བཅཱིངས་ནས་ག་཈ཱིས་སུ་ཕལ་ཏེ།",
    "རོ་རེའཱི་ཕྱག་རྒྱ་ག་཈ཱིས་སུ་བྱས་ལ།",
    "རོ་རེ་ཁུ་ཚུར་གཡོན་པ་སཱིང་གར་གཡས་ལོགས་སུ་བཏུད་ལ་མདུན་དུ་བཟུང་།",
    "རོ་རེ་ཁུ་ཚུར་གཡས་པ་ལག་ངར་གཡོན་པའཱི་སེང་དུ་ཕྱུང་སེ་ཁ་གཡོན་ལོགས་སུ་བསན་ལ་མདུན་དུ་བཟུང་བ་འདཱི་ནཱི་ལག་པར་རོ་རེར་བྱས་པའོ།",
    "མཐེའུ་ཆུང་ག་཈ཱིས་བཀུག་སེ་ཕན་ཚུན་ལུ་གུ་རྒྱུད་དུ་སེལ་ན་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "ཅཱི་དེ་ཙམ་དེ་ཁོ་ནས་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར་རམ་ཞེ་ན།",
    "མཛུབ་མོ་ག་཈ཱིས་ཀཱིས་སཱིགས་པ་ནཱི།",
    "གང་གཱི་ཚེ་མ་རུངས་པ་རྣམས་ལ་མཛུབ་མོ་ག་཈ཱིས་ཀཱིས་སཱིགས་མཛུབ་བྱས་པ་དེའཱི་ཚེ་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར་རོ།",
    "འདཱི་དག་ནཱི་རེ་ཞཱིག་གཙོ་བོ་ལྔའཱི་ཕྱག་རྒྱ་ཡཱིན་ནོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་མཛུབ་མོའི་ངོས་སར་ན་སེམས་དཔའ་རོ་རེ་མའཱི་གནས་ཀཱི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "ཅེས་བྱ་བ་ནཱི་རཱིན་ཆེན་རོ་རེ་མའཱི་གནས་ཀཱི་སེ།",
    "མཛུབ་མོ་དེ་཈ཱིད་གུང་མོ་དང་བཅས་པར་བསྒྲེང་ལ།",
    "ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་གཡོན་པའཱི་སོར་མོ་ག་཈ཱིས་གཡོན་ལོགས་སུ་དགུག་གཡས་པའཱི་སོར་མོ་ག་཈ཱིས་ཀང་གཡས་ལོགས་སུ་བཀུག་པ་ནཱི་ལས་ཀཱི་རོ་རེ་མའཱི་གནས་ཀཱི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "དེ་བཞཱིན་དུ་རོ་རེ་སེམས་དཔའ་ལ་སོགས་པའཱི་གནས་བཅུ་དྲུག་གཱི་ཡང་།",
    "མཛུབ་མོ་ག་཈ཱིས་ཀ་རོ་རེར་བྱ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ལས་གཡོན་པའཱི་སོར་མོ་ག་཈ཱིས་གཡས་པའཱི་ངོས་སར་ལ་གཤཱིབས་པའཱི་ཚུལ་དུ་བྱས་པ་ནཱི་རོ་རེ་སེམས་དཔའཱི་གནས་ཀཱི་ཕྱག་རྒྱའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཡས་པ་བཀུག་སེ་བཞག་པ་ནཱི་རོ་རེ་རྒྱལ་པོའི་གནས་ཀཱི་ཕྱག་རྒྱའོ།",
    "དེ་཈ཱིད་ཅེས་བྱ་བ་ནཱི་རོ་རེ་ལྕགས་ཀྱུ་མདུན་དུ་བཟུང་བ་སེ།",
    "གཡོན་པའཱི་ཧཾཧཱུྃ་ཞེས་བྱ་བའཱི་སོར་མོ་དང་གང་གཱི་ཚེ་ལྡན་པར་གྱུར་པ་ན་ཕྱག་རྒྱ་གཡོན་ལོགས་སུ་བཞག་ཅཱིང་ཅུང་ཟད་དངས་པ་ནཱི་རོ་རེ་ཆགས་པའཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཧཾཧཱུྃ་ཞེས་བྱ་བའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་ལེགས་སོ་ཞེས་བྱ་བ་སཱིན་པར་བྱས་པ་ནཱི་རོ་རེ་ལེགས་པའཱི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "ཧཱུྃ་ཞེས་བྱ་བའཱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་ག་཈ཱིས་བསྡུས་ཏེ་དཔྲལ་བའཱི་ཁོ་ག་཈ེར་ལ་གཏུགས་པ་ནཱི་རོ་རེ་རཱིན་ཆེན་གཱི་གནས་ཀཱི་ཕྱག་རྒྱའོ།",
    "རོ་རེ་ཧཾཧཱུྃ་མཛད་ཀཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་སཱིང་གར་གཡས་ལོགས་ནས་བསྐོར་བ་ནཱི་རོ་རེ་཈ཱི་མའཱི་ཕྱག་རྒྱའོ།",
    "དེ་཈ཱིད་རྒྱལ་མཚན་གཱི་ཚུལ་དུ་བཞག་པ་ནཱི་རོ་རེ་དབལདཔལ་གཱི་ཕྱག་རྒྱའོ།",
    "ཕྱག་རྒྱ་དེ་཈ཱིད་ཁའཱི་ཐད་ཀར་བཞག་ལ་མཛུབ་མོ་ག་཈ཱིས་གཡས་གཡོན་གཱི་ངོས་སུ་བཀུག་སེ་དགོད་པའཱི་ཚུལ་དུ་བྱས་པ་ནཱི་རོ་རེ་བཞད་པའཱི་གནས་ཀཱི་ཕྱག་རྒྱའོ།",
    "ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་མཛུབ་མོ་གཡོན་པ་བརྐྱང་ལ།",
    "གཡས་པ་རལ་གྲཱི་འཛིན་པའཱི་ཚུལ་དུ་ཁུ་ཚུར་བཅངས་ཏེ་བཞག་པ་ནཱི་རོ་རེ་རྣོན་པོའི་ཕྱག་རྒྱའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་ལག་པ་ག་཈ཱིས་ཀའཱི་གུང་མོ་མ་཈མ་པར་བརྐྱང་ལ།",
    "མཛུབ་མོ་དང་ལྷན་ཅཱིག་ཕན་ཚུན་སྤྲད་དེ།",
    "འཁོར་ལོའི་ཚུལ་དུ་བྱས་པ་ནཱི་ཁོ་བོ་རོ་རེ་རྒྱུའཱི་ཕྱག་རྒྱ་ཡཱིན་ནོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ཁའཱི་ཐད་ཀར་བཞག་ལ་གེན་དུ་བཏེག་པ་ནཱི་རོ་རེ་སྨྲ་བའཱི་ཕྱག་རྒྱ་ཡཱིན་ནོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ལས་གུང་མོ་ག་཈ཱིས་བསྒྲེང་བ་ནཱི་རོ་རེ་ལས་ཀཱི་ཕྱག་རྒྱའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ལས་མཛུབ་མོ་ག་཈ཱིས་མགུལ་པ་དཀྲཱིས་པ་ནཱི་རོ་རེ་བསྲུང་བའཱི་ཕྱག་རྒྱའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ཁར་བཞག་ལ་མཛུབ་མོ་དང་སྲཱིན་ལག་བརྐྱང་ན་མཆེ་བ་ཆེན་པོར་འགྱུར་ཏེ་རོ་རེ་གནོད་སཱིན་གཱི་ཕྱག་རྒྱའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་ག་཈ཱིས་བཀུག་སེ།",
    "མཐེ་བོའི་དྲུང་དུ་བཅར་བ་ནཱི་རོ་རེ་ཁུ་ཚུར་གཱི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "རོ་རེ་ལཱ་སེ་ལ་སོགས་པ་སེམས་མའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་ཧཾཧཱུྃ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ལས་སོས་པའཱི་ཕྱག་རྒྱ་དེ་཈ཱིད་འདཱིར་ཧཾཧཱུྃ་ཞེས་བྱ་བ་དང་སར་བར་ཤེས་པར་བྱའོ།",
    "རོ་རེ་ཅན་ནཱི་རོ་རེ་ཧཾཧཱུྃ་མཛད་གཟུང་ངོ།",
    "རོ་རེ་སཱིང་པོ་ནཱི་རཱིན་ཆེན་འབྱུང་ལྡན་གཱི་གནས་ཀཱིའོ།",
    "རོ་རེ་སེ་ནཱི་འོད་དཔག་ཏུ་མེད་པའཱི་གནས་ཀཱིའོ།",
    "རོ་རེ་ཐམས་ཅད་ནཱི་གདོན་མཱི་ཟ་བར་གྲུབ་པའཱི་གནས་ཀཱིའོ།",
    "ལྷག་མ་བཅུ་དྲུག་པོ་རྣམས་ཀཱི་ཕྱག་རྒྱའང་ཡཱི་གེ་རེ་རེ་བ་བཅུ་དྲུག་འབྱུང་སེ།",
    "རོ་རེའཱི་རཱིགས་ནཱི་ཆེན་པོ་ཡཱི།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེའཱི་རཱིགས་ཀང་ཡཱིན་ལ་ཆེན་པོ་ཡང་ཡཱིན་པས་ན་རོ་རེའཱི་རཱིགས་ནཱི་ཆེན་པོའོ།",
    "རོ་རེ་འགཱིང་ལ་སོགས་ཚུལ་གཱིས།",
    "རོ་རེ་འགཱིང་བའཱི་ཕྱག་རྒྱ་ནཱི་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་དུ་བསན་པ་སེ།",
    "དེ་ཐོག་མར་བྱས་པ་གང་ཡཱིན་པ་དེ་ནཱི་རོ་རེ་འགཱིང་བ་ལ་སོགས་པའོ།",
    "དེ་དག་གཱི་ཚུལ་ཡཱིན་པས་ན་རོ་རེ་འགཱིང་ལ་སོགས་ཚུལ་གཱིས་ཏེ།",
    "ཇཱི་ལྟར་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་དུ་བསན་པ་དེ་བཞཱིན་དུ་འདཱིར་ཡང་ཁོ་བོའི་ཁུ་ཚུར་དེ་དང་དེའཱི་ལོགས་ནས་གཅུ་ཞཱིང་།",
    "ད་ནཱི་ཐུན་མོང་གཱི་ཕྱག་རྒྱ་བཅཱིང་བ་སོན་ཏེ།",
    "རོ་རེ་ཧཾཧཱུྃ་མཛད་ལ་སོགས་པ་རཱིག་པའཱི་རྒྱལ་པོ་རྣམས་དང་།",
    "རོ་རེ་སེམས་དཔའ་ལ་སོགས་པ་སེམས་དཔའ་བཅུ་དྲུག་པོ་རྣམས་ལས་གང་རང་གཱི་ལྷ་ཟོས་པའཱི་ཕྱག་རྒྱ་དེ་དག་ཐམས་ཅད་ནཱི་ཐུན་མོང་མ་ཡཱིན་ཏེ།",
    "གང་ཞཱིག་ལྷ་གང་ཟོས་པ་དེ་དང་དེའཱི་ཕྱག་རྒྱ་ནཱི་ལྷ་དེ་཈ཱིད་ཀཱི་རང་གཱི་ཕྱག་རྒྱ་ཡཱིན་པས་ན་ཐུན་མོང་མ་ཡཱིན་པ་ཞེས་བྱའོ།",
    "དེ་ནཱི་དེ་དག་ཐམས་ཅད་ལས་གང་ཟོས་ཀང་ཕྱག་རྒྱ་གང་དང་གང་དགོས་པ་དེ་ནཱི་ཐམས་ཅད་ཀཱི་སཱིའཱི་ཡཱིན་པས་ན་ཐུན་མོང་ཞེས་བྱ་སེ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་སྔར་བསན་ཟཱིན་མོད་ཀཱི།",
    "འོན་ཀང་འདཱི་ལ་ཐུན་མོང་དུ་གྱུར་པ་ཡོད་པར་བསན་པའཱི་ཕྱཱིར།",
    "རོ་རེ་རྣམས་ཀཱི་དམ་ཚིག་གཱི་མཆོག་ཡཱིན་པས་ན་རོ་རེ་རྣམས་ཀཱི་དམ་ཚིག་མཆོག་སེ།",
    "རོ་རེ་དམ་ཚིག་མཆོག་དེའཱི་མཱིང་ཇཱི་སྐད་དུ་བྱ།",
    "རོ་རེ་ཧཾཧཱུྃ་ཞེས་སྔགས་ཀཱིས་ཏེ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ཧཾཧཱུྃ་ཞེས་བྱ་བ་བཞཱིའཱི་སྔགས་དང་སར་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་དང་པོར་བཀུག་ཅཱིང་དཀཱིལ་འཁོར་དུ་བཙུད་དེ་རྣམ་པར་སྣང་མཛད་ཀཱི་གདན་ལ་བཀོད་པས་ན།",
    "མཐེའུ་ཆུང་མཛུབ་མོ་ལྕགས་ཀྱུར་བཅཱིང་།",
    "ཞེས་བྱ་བ་ནཱི་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ལས་གཡས་པའཱི་མཛུབ་མོའི་ལྕགས་ཀྱུ་གཡོན་པའཱི་མཛུབ་མོའི་ལྕགས་ཀྱུས་བཟུང་སེ་བཅཱིངས་ན་རོ་རེ་ག་཈ཱིས་ཀ་བླ་འོག་ཏུ་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ནཱི་འཇཱིག་རེན་གསུམ་པོ་ཐམས་ཅད་སྐད་ཅཱིག་ཙམ་གཱིས་འགུགས་པའོ།",
    "འདས་མ་ཐག་པས་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་སཱིའཱི་ཕྱག་རྒྱ་བསན་ནས།",
    "རོ་རེ་ཧཾཧཱུྃ་མཛད་ལ་སོགས་པ་བཞཱིའོ།",
    "དེ་རྣམས་ཀཱི་ནང་ན་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཕྱག་རྒྱ་ནཱི་གཙོ་བོ་ཡཱིན་ལ།",
    "གཞན་རྣམས་ཀཱི་ནཱི་ཐུན་མོང་དུ་གྱུར་པ་ཡཱིན་པས་གཙོ་བོ་མ་ཡཱིན་ནོ།",
    "གཞན་རྣམས་ལས་གཙོ་བོར་གྱུར་པ་ནཱི་རོ་རེ་སེམས་དཔའཱི་ཕྱག་རྒྱ་འབའ་ཞཱིག་ཡཱིན་ནོ།",
    "རོ་རེ་མཛུབ་སོར་ག་཈ཱིས་ལེགས་པར།",
    "བཛྲ་ཱོད་ཏཱིཥྛ་ཞེས་བྱ་བའཱི་སྔགས་ཀཱིས་འཇཱིག་རེན་གསུམ་པོ་འགེལ་བ་ལས་སོང་བའཱི་ཕྱག་རྒྱ་སོན་ཏེ།",
    "རོ་རེ་ག་཈ཱིས་ནཱི་ཁོ་བོའི་ཁུ་ཚུར་ག་཈ཱིས་ཏེ།",
    "དེ་ག་཈ཱིས་ཀཱི་མཛུབ་མོའི་སོར་མོ་ག་཈ཱིས་ལེགས་པར་སར་བར་བྱ་བ་སེ།",
    "རོ་རེ་སོང་བ་ཞེས་བྱའོ་ཞེས་བྱ་བ་ནཱི་ཕྱག་རྒྱ་འདཱིའཱི་མཱིང་རོ་རེ་སོང་བ་ཞེས་བྱའོ།",
    "ད་ནཱི་རོ་རེ་མཛུབ་མོ་ག་཈ཱིས།",
    "དེ་ཡཱི་མཛུབ་མོའི་སོར་མོ་ག་཈ཱིས།",
    "རོ་རེ་བཅཱིང་བ་བཅཱིང་ནས་སུ།",
    "ཞེས་བྱ་བ་ནཱི་གཅཱིག་ལ་གཅཱིག་ལྕགས་ཀྱུ་ལྟ་བུས་བཟུང་བ་ནཱི་རོ་རེ་བཅཱིངས་པའོ།",
    "ད་ནཱི་བཅོམ་ལྡན་འདས་རོ་རེའཱི་རེས་སུ་སོད་པ་དང་།",
    "རོ་རེ་བཅཱིང་བ་དམ་བཅས་ཏེ།",
