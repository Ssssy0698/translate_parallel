    "ཇི་ལྟར་རིགས་པར་གཞན་རྣམས་ཀྱིས་རྒྱས་གདབ་པའོ།",
    "དེ་ལྟར་ནི་འདུ་བྱེད་ཀྱི་ཕུང་པོའི་རང་བཞིན་གཏི་མུག་ལ་སོགས་པ་རྣམས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ལྔའི་བདག་ཉིད་ཅན་དུ་བརྗོད་པར་བྱ་བས་སོ།",
    "ཤིན་ཏུ་ད་ང་བ་ཉིད་ཀྱི་ཕྱིར་མིག་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིས་རྒྱས་གདབ་པའོ།",
    "ལུས་ཀྱི་ཡན་ལག་ཐམས་ཅད་ཚིམ་པར་བྱེད་ཅིང་རྣམ་པར་རྒྱུ་བ་ཉིད་ཀྱི་ཕྱིར་རོ་ལ་དོན་ཡོད་པས་སོ།",
    "སྲ་ཞིང་མཁྲེགས་པ་ཉིད་ཀྱིས་གཏི་མུག་ཆེན་པོའི་གཞི་ཉིད་ཀྱི་ཕྱིར་ས་ལ་རྣམ་པར་སྣང་མཛད་ཀྱིས་ས་སོ།",
    "དེ་བཞིན་དུ་གཏི་མུག་ལ་ཉེ་བར་ལོངས་སྤྱོད་པ་ལས་དང་གཏི་མུག་ཟད་པའི་ངོ་བོ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་གཤིན་རྗེ་མཐར་ི་བྱེད་དང་མི་གཡོ་བ་རྣམ་པར་སྣང་མཛད་ཀྱིས་རྒྱས་གདབ་པར་བྱའོ།",
    "འཇམ་པའི་རྡོ་རྗེའི་སྒྲུབ་ཐབས་སུ་ནི་སེམས་ལས་སྐྱེ་བའི་ཁྱད་པར་གྱི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་དང་ཁྲོ་བོའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་ཁྲོ་བོ་བརྒྱད་རྣམས་མི་བསྐྱོད་པས་རྒྱས་གད་བ་པར་བྱའོ།",
    "སེམས་ལས་སྐྱེ་བའི་ཁྱད་པར་ཉིད་ཡོད་ན་ཡང་གཤིན་རྗེ་མཐར་བྱེད་པ་༡དང་པདྨ་མཐར་བྱེད་དག་སྔར་བཞིན་ཞེས་འདོད་དོ།",
    "བཅོམ་ལྡན་འདས་ཁོ་ནས་གསུངས་པ།",
    "རྒྱགས་པ་ནི་འདིར་སེམས་སྤྲོ་བའི་ཁྱད་པར་རོ།",
    "རྒྱུའི་དབྱེ་བ་ལས་རྒྱས་འདེབས་པའི་དབྱེ་བ་ལས་རྒྱས་འདེབས་པའི་དབྱེ་བའོ་ཞེས་པས་གང་དུ་རྒྱས་འདེབས་ཐ་དད་པ་དེར་རྒྱུ་ཡང་ཐ་དད་པ་ཁོ་ནའོ་ཞེས་རྟོགས་པར་བྱའོ།",
    "སེམས་ལས་སྐྱེ་བའི་ཁྱད་པར་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་དང་།་",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་པས་གནས་དང་བདག་དང་རྣལ་འབྱོར་སྲུང་བ་བྱས་ནས་དམ་ཚིག་བསྟེན་པ་སྔོན་མ་ཅན་གྱིས་གཏོར་མ་བྱིན་ཏེ།",
    "དེའི་འོད་ཟེར་གྱི་ཚོགས་རྣམས་༡ཀྱིས་ལུས་མཐའ་དག་སྣང་བར་བྱས་ནས་ཕྱིར་འཕྲོས་པ་རྣམས་ཀྱིས།་",
    "བཅོམ་ལྡན་འདས་ལ་འཁྱུད་དེ་བདེ་བ་ཆེན་པོའི་རྗེས་སུ་ཆགས་པར་བྱེད་པའི་ཕྱིར་ར་རོ།",
    "ཅེས་པའི་མཐའ་ཐུག་པ་དོན་མངོན་དུ་བྱེད་ཅིང་བཀླག་པར་བྱའོ།",
    "འོག་ད་ང་༡འོག་ཏུ་གནས་པ་གཟུགས་བརྙན་ལྟ་བུ་སྟོང་པ་ཉིད་དང་རོ་གཅིག་པར་རྟོག་ཅིང་།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་གྱུར་ནས།",
    "བགེགས་རྣམས་ཐམས་ཅད་བསྐྲད་པར་བྱ།",
    "ཞལ་གསུམ་ཕྱག་དྲུག་པར་བསྒོམས་ཏེ།",
    "འཇོག་པོ་དམར་པོས་རྣ་བའི་རྒྱན་དུ་བྱས་པ།་",
    "པདྨ་འི་རྩ་བ་ལྟར་དཀར་བའི་པདྨ་ཆེན་པོས་དོ་ཤལ་བྱས་པ།",
    "དྲུར་བ་ལྟར་ལྗང་བའི་སྟོབས་ཀྱི་རྒྱུས་སེ་རལ་ཁར་བྱས་པ།",
    "ནོར་རྒྱས་དཀར་པོས་སྐེ་རགས་བྱས་པ།",
    "ཀུན་ད་ལྟར་དཀར་བའི་པདྨས་རྐང་གདུབ་བྱས་པ།",
    "དུང་སྐྱོང་སེར་པོས་ལག་གདུབ་བྱས་པ།",
    "དུ་བ་ལྟ་བུ་ཁྲ་བོའི་རིགས་ལྡན་གྱིས་དཔུང་རྒྱན་བྱས་པ།",
    "ཞེས་དེ་ཁོ་ན་ཉིད་འདུས་པར་ཏེ།",
    "དེ་ལྟར་རྡོ་རྗེ་ཧཱུྃ་མཛད་དུ་བདག་ཉིད་རྣམ་པར་བསམས་ནས།",
    "ཁྲོ་བོ་རྣམས་འབྱིན་བཞིན་པར་བསམ་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱིས་རྒྱས་བཏབ་པ།",
    "སྟེང་དུ་ཧཱུྃ་ཞེས་པའམ་བྷྲཱུཾ་ཞེས་པ་ལས་གཙུག་ཏོར་འཁོར་ལོ་ཅན་རང་འདྲའི་ནམ་མཁའ་རྡོ་རྗེ་མ་ལ་ཡང་དག་པར་སྦྱོར་བ།་",
    "ཐམས་ཅད་ཀྱང་གདན་དང་བཅས་པར་མི་གཡོ་བའོ།",
    "ཀུན་ནས་བར་མི་འཆད་པར་འབར་བའི་ཚོགས་དུ་མ་འཕྲོ་བར་བལྟ་བར་བྱའོ།",
    "ཨོཾ་བཛྲ་མུངྒ་ར་ཨཱ་ཀོ་ཊ་ཡ་ཧཱུྃ་ཞེས་གསུངས་ཤིང་ཕྱག་གཡས་པས་བཟུང་༦བའི་རྡོ་རྗེ་ཐོ་བ་འབར་བས་བརྡུང་བར་བསམས་ཏེ།",
    "དེའི་སྟེང་དུ་པྃ་ལས་བྱུང་བ་བུམ་པས་མཚན་པ་ཟླུམ་ཞིང་དཀར་བའི་ཆུའི་དཀྱིལ་འཁོར་ལ་གནས་པའི་མྃ་ཡིག་ལས་སྐྱེས་པ་རྡོ་རྗེས་མཚན་པ་གྲུ་བཞི་པ་འདོད་པར་བྱ་བའི་གསེར་གྱི་སའི་དཀྱིལ་འཁོར་རོ།",
    "དེའི་སྟེང་དུ་ཧཱུྃ་སུཾ་ཧཱུྃ་ཡོངས་སུ་གྱུར་པའི་རི་རབ་རྣམ་པར་བསམས་ཏེ།",
    "ཕྱོགས་སོ་སོའི་རྭ་གསུམ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དང་མཚུངས་པའི་ཁ་དོག་ཅན་ནོ།",
    "དེའི་ད་བུས་སུ་བྷྲཱུཾ་ཡིག་ལས་སྐྱེས་ཤིང་དེས་བྱིན་གྱིས་བརླབས་པའི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་ལས་ཡང་དག་པར་བྱུང་བའི་རྣམ་པར་སྣང་མཛད་ཡོངས་སུ་གྱུར་པས།",
    "དེ་ཡོངས་སུ་གྱུར་པའི་ཟླ་བ་དམར་པོ་དེའི་རྣམ་པ་གཟུགས་བརྙ་ན་དུ་བྱས་པ་བལྟ་ཞིང་།",
    "ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "གཡོན་པར་ཐོད་པ་དང་ཞགས་པ་འཛིན་པ།",
    "ཐབས་ཡོངས་སུ་མཉེས་པར་བསྒོམས་ནས།",
    "ཅེས་པ་ལ་སོགས་པ་འཆད་པར་འགྱུར་བའི་རིམ་པས།་",
    "རྣམ་པར་སྣང་མཛད་དང་མི་བསྐྱོད་པ་དང་།",
    "འདི་རྣམས་ཀྱི་ཤེས་རབ་ནི་ཛ་ཧཱུྃ་བཾ་ཧོ་ཁྃ་རྃ་གྱི་ས་བོན་ལས་སྐྱེས་པ་ཕྱིའི་སྐྱེ་མཆེད་རྣམ་པར་དག་པའི་ངོ་བོ་རང་འདྲ་རྣམས་ཏེ།",
    "པདྨ་འབར་བ་མ་ནི་མ་མ་ཀཱི་༢བཞིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་མི་བསྐྱོད་པས་རྒྱས་བཏབ་པའོ།",
    "དེ་ནི་ཡེ་ཤེས་ཀྱི་ཁམས་རྣམ་པར་དག་པའི་ངོ་བོའོ།",
    "དེའི་རྗེས་སུ་ཧ་ཧི་ཧུ་ཧེ་ཧོ་ཧཾ་ཞེས་པ་འཆད་པར་འགྱུར་བའི་སྔགས་རྣམས་ཀྱིས་གོ་ཆ་བསམ་པར་བྱ་སྟེ།",
    "ཧོཾ་ཧྲཾ་ཧྲཱི་༤སྭཱ་ཧཱ་ཞེས་པ་འཆད་པར་འགྱུར་བའི་སྔགས་རྣམས་༐",
