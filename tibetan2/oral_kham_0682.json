    "རས་ལིང་རང་ཆུ་དལ་པོའི་སྟེང་དུ་གཏིང་ནས་ཆུ་བཅུ་པ་ཞིག་ལ་ཕལ་ཆེར་གྱིས་འདོད་ལ།",
    "ཉལ་པོ་བྱེད་པར་བཤོམས་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་གཉིས་སོ།",
    "ཆོ་ག་རྣམ་པར་དག་པའི་རྒྱུ་ལ་དེར་བསྒྲུབ་པ་གཅིག་དུས་ཁྱད་པར་ཅན་གྱི་ཆོ་ག་ལ་དེར་བསྒྲུབ་པ་གསུམ།",
    "གཉིས་པ་ནི། ། འགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པ་ཡིན་ལ།",
    "རབ་ཏུ་བྱུང་བ་མེད་ཅིང་རང་ཉིད་དགེ་སློང་དུ་རློམ་པ་མ་ཡིན་པའི་ཕྱིར།",
    "འདུག་གནས་ཕྱེ་དང་བཅའ་དང་དུས་མིན་དང་།",
    "ཉལ་བཤོམ་ཁྱིམ་ན་འདུག་དང་འགྲེང་བ་དང་།",
    "མ་བསྒོ་སྟན་འདུག་རྩྭ་སྔོན་མི་གཙང་འདོར།",
    "མཐུན་རྐྱེན་བརྟེན་ཚུལ་ནི་འདུག་པའི་སོགས་སོ།",
    "དང་པོ་ལྟར་ན་ཁྱེད་ཅག་དུས་དེར་འོད་དམར་བསྲུང་བ་ཡིན་ནོ།",
    "རྟགས་ལ་འགྲོ་མཚམས་མི་འདུག་པས་ལྡོག་ན་འཁོར་གསུམ་ལས་མ་འདས་པའི་ཕྱིར་དང་།",
    "གཉིས་པ་ནི་མི་འདུག་པར་འགྲེང་བར་སོགས་སོ།",
    "འགྲེང་བ་ཡང་མི་འཚལ་འདུག་པ་དང་ཉལ་བ་ཡང་མི་འཚལ་ན།",
    "ཁྱེད་རང་དགེ་སློང་དུ་ཁས་བླངས་ནས་པཎ་ཆེན་བརྒྱུད་ཀྱི་དགེ་སློང་མང་པོ་ལ་གཞི་མེད་པར།",
    "ལས་བརྒྱ་རྩ་ཐམས་ཅད་འདུག་པའི་སྤྱོད་ལམ་གྱིས་བྱ་དགོས་ཏེ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ་ཞེས་དང་།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ་ཞེས་དང་།",
    "ལས་རང་རང་ངོ་བོའི་གནས་སུ་བློ་མཐུན་པས་ལས་གཞན་གྱི་གནས་སུ་མི་འགྱུར་བའི་ཕྱིར་དང་།",
    "བདག་དུས་འདི་ནས་བཟུང་སྟེ་སང་ཉི་མ་ཤར་གྱི་བར་དུ་བསྙེན་གནས་པར་བཙུན་པས་བཟུང་དུ་གསོལ།",
    "བྱིན་གྱིས་བརླབས་པས་ཕྱིར་བཅོས་ཏེ་འདུག་པར་བྱའོ།",
    "བསྒྲུབ་བྱ་དེ་བསྙེན་པར་རྫོགས་པའི་ལས་གྲལ་དུ་འདུག་དགོས་པ་ཁྱབ་པ་ཡང་མེད་པའི་ཕྱིར་གཉིས་པ་ནི།",
    "སྔར་བསྟན་མ་ཟིན་པའི་ལྷུང་བཟེད་ཞིག་དུས་གཞན་གྱི་ཚེ་བྱིན་གྱིས་རློབ་པ་ན།",
    "ལས་གྲལ་དེར་འདུག་དགོས་པ་མ་ཡིན་ཏེ།",
    "མ་འདུག་ཀྱང་ལས་མི་འཆགས་པའི་ཉེས་པ་མི་མཐུན་པ་བསྐྱེད་པ་ཡང་མེད་ཅིང་།",
    "ལས་གྲལ་དེ་ཉིད་དུ་མི་འདུག་དགོས་པའི་ཁྱབ་པ་ཡང་མེད་དེ།",
    "འོན་ཀྱང་གང་ལ་བྱ་བ་དེ་མངོན་སུམ་དུ་མི་འདུག་པའི་ཚེ།",
    "རྒན་པའི་མཐའ་ལོགས་སུ་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "གཎྜི་བརྡུང་བ་ནས་ཙོག་པུར་འདུག་སྟེ།",
    "འདུག་ལ་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "མི་ཐོག་པའི་ཕྱོགས་ན་འདུག་པ་དང་མདུན་མ་ཡིན་པ་འདུག་པ་ལས་ལྷག་པོར་བྱ་བ་མི་འབྱུང་ངོ།",
    "ཐ་མལ་པའི་གཟུགས་སུ་འདུག་པ།",
    "གནས་མེད་ཀྱང་འདུག་ཏུ་རུང་བའི་དམིགས་བསལ་ནི་དབྱར་ཕྱི་མ་ཟླ་བ་གཉིས་ཀྱི་དུས་ལ་། བབ་པ་དང་།",
    "ཤེས་པ་ཕྱིར་བཅོས་ཏེ་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ།",
    "འདུག་པ་ན་དྲན་ནམ་། ཡིད་གཉིས་ཟ་ན།",
    "དེ་ལས་ཀྱང་སྔ་ཚེས་བྱེད་ན་ཉེས་པ་སྔ་མ་སོ་ན་འདུག་པའི་ཕྱིར།",
    "ཚུལ་དང་མཐུན་པས་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "རྟེན་དེས་ཕྱག་གསུམ་བྱས་ཏེ། ། རྒན་པའི་མཐར་ཙོག་པུར་འདུག་སྟེ།",
    "དགག་དབྱེ་བྱེད་པའི་མདུན་དུ་ཙོག་པུར་འདུག་ལ།",
    "གསོག་འཇོག་ཁེགས་པའི་ཆེད་ཡིན་ལ་དུས་རུང་ནི་བྱིན་གྱིས་མ་བརླབས་ཀྱང་རང་དུས་མ་འདས་ཀྱི་བར་དུ་གསོག་འཇོག་མི་འབྱུང་ལ།",
    "གསོ་སྦྱོང་ཡང་རང་གཅིག་བུས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཁས་ལེན་ན་རྩོད་པ་མི་འདུག་པའི་ཕྱིར།",
    "སྟེར་ན་དེས་དགྲ་བཅོམ་པ་མ་ཐོབ་པ་ཡང་རང་བཞིན་དུ་གནས་པར་ཐོབ་པར་འགྱུར་རོ།",
    "རང་རང་གཡོག་འཁོར་དཔུང་དང་བཅས",
    "སྐྱེ་མཆེད་ལྷག་མ་མེད་པར་ཞལ་དུ་བསྟབས་བཞེས་ཤིག་རོལ་ཅིག་ཁ་ར་ཁཱ་ཏྭེ་སརྦ་རུ་དྲ་མ་ཧཱ་མེ་ས་རཀྟ་ཙིཏྟ་བ་སུ་ཏ་ཀོ་རོ་ཙ་ན་ཀིང་ནི་རི་ཏི་ལ་ཁ་ཁ་ཁཧི་ཁཱ་ཧི་བརྒྱད་པ་ལྷག་མ་འབུལ་བའ་རམ་པ་ནི་ཧཱུཾ་བྷྱོ་སྔོན་ཚེ་དཔལ་ཆེན་སྤྲན་སྔར་ཁས་བླངས་པའི",
    "རང་རང་གཡོག་འཁོར་སྤྲུལ་བ་དཔུང་དང་བཅས",
    "རང་རང་རྟགས་འཆང་སྦྱོར་སྒྲོལ་ཐབས་ལ་མཁས",
    "སླར་ཡང་རང་བཞིན་དག་པའི་ཆོ་རོལ་ལས",
    "དམག་འཁྲུག་དུས་ཀྱི་རྒུད་པ་སོལ་འཇིག་རྟེན་བདེ་སྐྱིད་ལྡན་པར་མཛོད",
    "རང་རང་རིགས་ཀྱི་སྤྲུལ་པའིའདུ་འཕྲོ་འགྱེད་པ",
    "ཤིན་ཏུ་འཁྱག་དུས་གྲང་ཚད་ཡིན།",
    "གཤོག་པ་གཉི་ག་དལ་བུས་བརྡབས་ནས་བར་སྣང་དུ་དུས་ཚོད་སྐར་མ་བཅུ་ལ་འདུག་ཐུབ།",
    "མཱ་པུ་ཡོན་ང་རྒྱལ་སྐྱེས་ཤིང་རང་ཚུལ་བརྗེད་དེ།",
    "དགྲ་མང་རང་ཉུང་ཉེན་ཚབས་ཆེ་བའི་གནས་ལ་ཐུག་ཚེ།",
    "གཟན་རྩྭ་གཟན་ཆས་ཁ་ཤས་འཕྲུལ་ཆས་ཀྱིས་ལས་སྣོན་བྱེད་ཀྱིན་འདུག།",
    "རྩྭ་ས་ཡངས་པས་ཕྱུགས་ཟོག་སྤེལ་བའི་ཆ་རྐྱེན་འདུག་ན་མུ་མཐུད་སྤེལ་བར་རུང་ལ།",
    "ཞིང་བ་མི་ཉུང་བ་ཞིག་ད་དུང་རང་འགུལ་གྱིས་མཉམ་འབྲེལ་ཚོགས་པ་འདུས་གཤིས།",
    "རྨ་ཆུའི་ཆུ་ལག་མང་ཞིང་ཆུང་ནའང་ཐུར་དུ་གཞོལ་ཚད་ཆེ་བས་གློག་འདོན་ས་ཚིགས་ཆུང་ཆུང་སྤེལ་ན་ཆ་རྐྱེན་ངེས་ཅན་འདུག་ལོ་རབས་ལྔ་བཅུ་བའི་དུས་མཇུག་ལ་ཆབ་ཆ་དང་།",
