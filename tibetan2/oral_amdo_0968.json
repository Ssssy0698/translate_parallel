    "རགས་པ་འབྱེད་ཅིང་ཕྲ་མོ་འབྱིན་པ།",
    "རྒྱོབ་སོད་ཀྱི་དམོད་སྔགས་དང་འགྲོགས་པ།",
    "རང་དཔུང་གི་ཐོག་མ་ནས་འགྲོ་བ།",
    "ཁྲག་གི་དཔའ་སྐྱེམས་ལ་སྤྱོད་པ།",
    "ལྷ་སྲུང་གི་དཔལ་ཟླ།",
    "༡དཔལ་ལྡན་ཨ་ཏི་ཤ་ལ་ན་མོ།",
    "ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤ་ལ་ན་མོ།",
    "འཕགས་ས་པ་ཀླུ་སྒྲུབ་ནས་བརྒྱུད་པའི་ཟབ་མོ་ལྟ་རྒྱུད་ཀྱི་གདམས་པ་ཟབ་མོ་དང་།",
    "ལྷ་ས་སྙེ་ཐང་ན་མོ་ཆེར་སྐུ་མྱ་ངན་ལས་འདས་པའི་སྐོར།",
    "དགུང་ལོ་ཉི་ཤུ་ལྷག་ཙམ་ལ་ཕེབས་དུས་ཡབ་ཡུམ་གཉིས་ཀྱིས་རྒྱལ་སྲིད་འཛིན་པའི་རེ་བ་གནང་སྟེ་རྒྱལ་རིགས་ཀྱི་བུ་མོ་མཛེས་མ་ཧ་ཅང་མང་པོ་བདམས་ནས་གཉེན་སྒྲིག་གནང་བར་ཞུས་ཀྱང་གཏན་ནས་ཞལ་བཞེས་མ་གནང་པར་ཐུགས་ཡིད་འབྱུང་སྐྱོ་ཤས་ཀྱི་བསྐུལ་མར་གྱུར།",
    "ལྷག་པར་སྒྲོལ་མའི་སྤྲུལ་པ་བུ་མོ་སྔོ་སངས་མ་ཞིག་གིས།",
    "འདོད་པའི་འདམ་འདིར་དཔའ་བོ་ཁྱོད་བྱིང་ན།",
    "རྒྱལ་སྲིད་མཆིལ་མའི་ཐལ་བ་བཞིན་དུསྦཔསསྤྱི་ནུས་སམ།",
    "བཙུན་མོ་དང་བདུད་ཀྱི་བུ་མོ་ལ་ཁྱད་མེད།",
    "ཨ་ཝ་དྷུ་ཏི་པས་རི་ནག་པོའི་གཙུག་ལག་ཁང་དུ་དཔལ་ལྡན་རཱ་ཧུ་ལའི་དྲུང་དུ་སོང་།",
    "ཐོག་དེ་མུ་སྟེགས་ནག་པོའི་མཆོད་རྟེན་རི་ལ་སོང་།",
    "འཇིགས་པའི་གྲུབ་ཐོབ་ཕོ་མོ་གཅེར་བུ་བརྒྱད་ལ་རྒྱལ་བུ་འདིའི་ཕྱི་འབྲང་བྱས་ལ་བྷང་གྷ་ལར་སོང་།",
    "ཟླ་བ་གསུམ་དུ་སྨྱོ་སྤྱོད་བསྐྱངས་པས་རྣལ་འབྱོར་ཕོ་མོ་རྣམས་མཆོད་ཅིང་བརྒྱུགས།",
    "ཨེ་མ་བུ་ཁྱོད་ལེགས་པར་བཙས་པའི་ཚེ།",
    "ཅི་གསུང་བདག་གིས་རྒྱལ་སྲིད་བཟུང་གྱུར་ན།",
    "ཚེ་འདིར་ཡུད་ཙམ་ཡབ་དང་འགྲོགས་མོད་ཀྱང་།",
    "བདག་གིས་རྒྱལ་སྲིད་ཆེན་པོ་རབ་སྤངས་ནས།",
    "སྐྱེད་མོས་ཚལ་བདུན་བརྒྱ་ཉི་ཤུ།",
    "བར་གྱི་ཟམ་པ་སུམ་བརྒྱ་རེ་གསུམ།",
    "སྔགས་ཀྱི་བརྟུལ་ཞུགས་ཀྱི་སྤྱོད་པ་སྤྱད་དེ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པ་ཞིག་བྱ་སྙམ་དུ་དགོངས་པ་ན།",
    "བྲམ་ཟེ་ནོར་ལྷས་མཛད་པའི་ཚིག་གི་སྒྲོན་མ་ལ་སོགས་པ་སྦྱངས་བརྩོན་ཡོངས་སུ་མཛད།",
    "བུ་རམ་ཤིང་གི་ལས་ཀྱི་མཐའི་བསྟན་བཅོས།",
    "གསང་སྔགས་མཐའ་དག་གི་བརྒྱུད་པ་ནི་སློབ་དཔོན་ཀླུ་སྒྲུབ།",
    "ཇོ་བོའི་ཞལ་ནས་ཀྱང་ངན་སོང་ཐམས་ཅད་འཇིགས་པ་དང་།",
    "ཐུན་མོང་གི་དངོས་གྲུབ་མང་པོ་ཐོབ་པ་དང་།",
    "ལྡེར་བཟོ་གཅིག་གིས་གཅིག་ལ་དྲི་བ་དང་ལན་འདེབས་པའི་ཚུལ་དང་།",
    "ཅིག་ཤོས་ན་རེ།",
    "འཁོར་ལ་གཟིགས་ཤིང་མི་རྟག་གླུ་ད་བྱས་བླངས།",
    "མི་མཐུན་ཕྱོགས་རྣམས་བདེན་པའི་ཚིག་གིས་ཞི།",
    "ད་ནི་ལུས་དང་ངག་དང་ཡིད་དག་གིས།",
    "གུས་པས་ཁྱེད་ཀྱི་བྱ་བ་བདག་གིས་བྱ།་",
    "རྔ་ཡབ་དཀར་པོ་རེ་ཕྱག་ན་བསྣམས་པ་བརྒྱ་དང་ཉི་ཤུ་རྩ་ལྔ་ཇོ་བོ་རྗེའི་མཇུག་ཏུ་བར་དུ་མི་རེ་ཤོང་ཙམ་དུ་མ་འབྱར་བ།",
    "ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པ་ཤ་སྟག་ཏུ་གྱུར་པས་དཀར་ཕྱོགས་ཀྱི་ལྷ་རྣམས་དགའ་ཞིང་མགུ་ནས་མེ་ཏོག་གི་ཆར་ཕབ།",
    "དེ་ཟོས་པས་རོ་དཔེ་མེད་པ་ཞིག་བྱུང་སྟེ་སྔ་དྲོའི་གཎྜི་ལ་རྡུང་ཐུག་གི་བར་ཏིང་ངེ་འཛིན་བཟང་པོ་ཞིག་འཁྲུངས།",
    "བྱང་སྡོམ་ལ་ཉེས་བྱས་སྣ་རེ་ཙམ་འོང་།",
    "རྣལ་འབྱོར་པ་དེ་ཤིང་ནྱ་གྲོ་དྷའི་སྡོང་པོ་ཞིག་གི་རྩ་བར་དེ་ནུབ་ཉལ་བའི་ཤིང་ལོ་འཕྱག་ཅིང་འདུག་པར་བྱོན།",
    "ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོའི་ཞལ་མངོན་སུམ་དུ་གཟིགས།",
    "ཁྱེད་ཀྱི་གདུལ་བྱ་མང་པོ་ཡང་དེ་ན་ཡོད་པས་བྱང་ཕྱོགས་སུ་སོང་ཞིག་ཅེས་ལུང་བསྟན།",
    "བྲི་ཀ་མ་ལ་ཤི་ལའི་གཙུག་ལག་ཁང་གི་སྒོའི་གཡས་ན་ཀླུ་སྒྲུབ་དང་གཡོན་ལ་ཇོ་བོ་རྗེ་བྲིས་ཏེ་སློབ་དཔོན་ཀླུ་སྒྲུབ་དང་མཉམ་པ་ཡིན་སྐད།",
    "ཉིན་རེ་ལ་ས་ཙྪ་བདུན་རེ་བཏབ་ན་ལས་འབྱུང་གསུངས།",
    "ཕྱིས་དེ་སྔའི་བློན་པོ་གཉིས་ཀྱིས་ཀྱང་སྔར་ཁས་ལེན་ཞུས་དོན་བཞིན་རང་གི་བུ་མོ་རེ་བཙུན་མོར་ཕུལ།",
    "བློན་པོ་པ་ཚབ་ཀྱི་བུ་མོ་ལ་བུ་མ་བྱུང་།",
    "བློན་པོ་ཅོ་རོའི་བུ་མོ་ལ་སྲས་གསུམ་བྱུང་བས་བཀྲ་ཤིས་མགོན།",
    "ལྷ་བཀྲ་ཤིས་མགོན་ལ་སྲས་གཉིས་བྱུང་བས་མངའ་བདག་འཁོར་རེ་དང་སྲོང་ངེ་ཞེས་བརྗོད།",
    "མངའ་བདག་སྲོང་ངེས་གུ་གེ་དང་འཁོར་རེས་པུ་རངས་བཟུང་།",
    "འཁོར་རེ་སྲས་ལྷ་ལྡེ།",
    "ཁོང་ལ་བློན་པོ་མིག་གི་མངོན་ཤེས་དང་ལྡན་པས་ས་འོག་གི་གཏེར་ཐམས་ཅད་མཐོང་བ་ཞིག་ཡོད།",
    "ཡང་ན་གསེར་རྒྱལ་པོ་དང་མཉམ་པ་ཁྱེར་ལ་ཤོག་རྒྱལ་པོ་བཏང་གི་ཟེར་བ་ལ།",
    "དབུས་གཙང་གི་རབ་ཏུ་བྱུང་བ་རྣམས་ལ་ཡང་ཤམ་ཐབས་ཀྱི་ཁྲལ་བླངས།",
    "བོད་ཁམས་གླིང་དགུའི་འབངས་ལ་གསེར་གྱི་ཁྲལ་མོ་ཆེ་ཐེངས་གསུམ་བསྡུས།",
    "ངས་ཁོ་ལ་དམག་རྒྱབ་ནས་བཟློག་ན་ནི་སྐྱེ་བོ་ཚན་པོ་ཆེ་ཕུང་ལ་བཏང་ནས་ངན་སོང་དུ་འགྲོ་དགོས་པར་འདུག་པཎྜིཏ་གདན་མ་འདྲེན་པར་ཁྱེད་རང་ངེད་ཀྱི་འོག་ཏུ་ཞུགས་ཟེར་བ་ལ་ནི།",
    "དེ་ལ་ཡང་ཁོས་མ་ཉན་པས་ད་ངས་དབུ་ཙམ་ཞིག་རྙེད་པ་དང་བླུར་འོང་གིས།",
    "གསུང་གི་གདངས་ཆག་ཤིན་ཏུ་ཉམ་ཐག་པར་གྱུར་ནའང་།",
    "ད་རེས་འདི་ལ་མགོན་པོ་བོད་དུ་མ་བྱོན་ན་ཁྱེད་དམ་པ་རྣམས་ཀྱི་ཐུགས་རྗེ་ཡང་དེ་ལྟར་ཟད་པས།",
    "རང་རེ་སྐྱིད་ཆེ་བ་དང་།",
    "ལྷ་བཙུན་མི་ཆེན་གཅིག་གིས་བཤུམས་ཤིང་གསུང་བྱོན་པའི་སྟོབས་ཀྱིས་ལུས་འདར།",
    "སྟེ་ལྷ་བཙུན་པའི་ཞལ་ལ་ཡང་བལྟ་མ་ནུས་པར་ལུས་སྲོག་གི་དཀའ་ཚེགས་དང་།",
    "ལྷ་བཙུན་པས་ཀྱང་ཐག་རིང་པོར་སྐྱེལ་ཐུང་མཛད་དེ་དགེ་སློང་ཁྱོད་ཀྱིས་ངའི་ཕྱོགས་ཀྱི་བྱ་བ་བྱས།",
    "ད་རེས་དཀའ་བ་ཆེ་ནའང་ཕར་བྱོན་ལ་འབད་བརྩོན་ཆེན་པོས་ལུས་དང་སྲོག་ལ་བསྡོས།",
    "ཁྱོད་ཡུལ་ས་ཐག་རིང་པོར་དོན་ཆེན་པོར་འགྲོ་བ་སྣང་བས།",
    "ཁྱོད་སུ་ལགས་བྱས་པས།",
    "ཁ་འདོན་བྱས་པས་དེར་རྒྱ་བརྩོན་སེང་གིས་བོད་ཀྱི་སྐད་གོ་ནས་སྒོའི་སྟེང་གི་སྒེའུ་ཁུང་གཅིག་ནས་མར་བོད་ཀྱི་ཚེ་དང་ལྡན་པ་ཀུན་གང་ནས་བྱོན་ཟེར།",
    "དེ་ན་སྒོ་སྲུང་བྱིས་པ་གཅིག་ཡོད་པ་དེ་ལ་ཁྱོད་རང་ཚོའི་ཁུར་པོ་ཀུན་བཅོལ་ལ་སྐྱིབས་ཤིག་ཏུ་ངལ་གསོ་ནས་སྡོད།",
    "སྐྱ་རེངས་གཉིས་པའི་མཇུག་ཙམ་ལ་སྒོ་འབྱེད་པ་ཡོང་གསུངས།",
    "ཁྱོད་སུ་ཡིན།",
    "རྒྱ་བརྩོན་འགྲུས་སེང་གེ་བོད་ཀྱི་སྤྱི་ཁང་ན་བཞུགས་ཡོད་པས་དེར་རྩད་བཅད་ན་ཡོང་ཟེར་ནས་ཡུད་ཀྱིས་སོང་།",
    "དྲང་སྲོང་རྒད་པོ་ཆུ་ཤིང་གི་འཁར་བ་ཐོགས་ཞིག་དང་འཕྲད་དེ།",
    "རྒྱ་བརྩོན་སེང་གི་ཁང་པ་གང་ན་ཡོད་བྱས་པས།",
    "ཁོ་ག་ལེར་སོང་བའི་རྗེས་ལ་ནག་ཚོ་མགྱོགས་པོས་མ་སླེབས།",
    "ཁོ་བོད་ཀྱི་སྤྱི་ཁང་གི་སྒོ་ཕུག་སྒུགས་ནས་བསྡད་དེ་བྱ་བ་ཆེན་པོ་གྲུབ་པ་ལ་ག་ལེར་བྱེད་དགོས་པ་ཡིན།",
    "དེ་ནས་ནག་ཚོ་དང་རྒྱ་བརྩོན་སེང་གཉིས་ཀྱིས་གནས་བརྟན་རཏྣ་ཨ་ཀ་རའི་དྲུང་དུ་གསེར་སྲང་ཕྱེད་ཕུལ་ཏེ་ནག་ཚོ་ལོ་ཙཱ་བས་རྒྱ་བརྩོན་སེང་གིས་བསླབ་པ་ལྟར་གྱི་ཞུ་བ་བྱས་པས།",
    "རེ་ཞིག་ཇོ་བོའི་ཞལ་མཇལ་བ་ཤིན་ཏུ་དཀའ་བ་བྱུང་།",
    "ཉིན་གཅིག་རྒྱ་གར་གྱི་པཎྜི་ཏ་དང་རྒྱལ་པོ་གཞན་གྱིས་མ་ཚོར་བར་དབེན་པ་ཞིག་གི་བར་ན་དར་ནག་པ་དུས་རྒྱ་བརྩོན་སེང་གིས་ཀུན་ནག་ཚོ་ལོ་ཙཱ་བ་ལ་ཤོག་གསུངས་ནས་ཇོ་བོའི་གཟིམ་ཁང་དུ་ཁྲིད།",
    "ཁོང་གི་མི་ནོར་མང་པོ་ཆུད་ཟོས་ལ་སོང་།",
    "རེ་ཞིག་ཁྱེད་རང་གི་གསེར་ཚགས་གྱིས་གསུངས་ནས་ཕྱིར་ལ་གཏོད་པར་མཛད།",
    "དོན་ལ་ཉི་ཤུ་ཐམ་པས་ཐུང་དུ་སོང་བ་ཡིན་སྐད།"
  ]
