    "བཀའ་བཀྱོན་དྲག་པོ་མཛད་ཀྱིན་འདུག་པས་འཇིགས་པའི་སྣང་བ་འབའ་ཞིག་བྱུང་།",
    "ལྷུང་བ་ཅིག་ཀྱང་མི་འདུག་པས་ཐམས་ཅད་ཡར་ཐེངས་པ་རྨི་ལམ་དུ་རྨིས།",
    "བཞུགས་སའི་གནས་ཀྱང་འདི་ལྟ་བུ་ལ་མི་འོང་བར་གདའ།",
    "ཁྱེད་རྣམས་ཀྱང་རང་སེམས་དཔང་དུ་བཙུགས་པའི་དམ་ཚིག་སྲུང་སྡོམ་དང་དགེ་སྦྱོར་ལ་འབད་པ་བྱ་དགོས་པ་ཡིན།",
    "ཡང་ཡང་གླེང་སློང་བ་དཀའ་བར་འདུག་པས་སོ་སོ་ནས་གོ་བར་གྱིས་གསུང་ནས་གསུང་ཞལ་ཏའི་རིམ་པ་ཞིབ་པར་བྱོན་ནོ།",
    "ཁྱེད་རང་རྣམས་ཀྱང་འཚམས་གྱིས།",
    "ད་ཆ་རྐྱེན་གང་འདུག་སྤོང་དག་ལ་གཏོང་བའི་དུས་ལ་བབ་འདུག་སྐུ་ཁམས་བཟང་ན་གང་བྱས་ཀྱང་བླ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྦྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "༥༩། ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་དུ་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར། ཟླ་བ་ལ་ནི་ས་སྐྱེས་ལོངས་སྤྱོད་ཆུ་ཚོད་དགུ་བཅུ་རྣམས་ཏེ་ལྔ་དང་འཇིག་རྟེན་ཟླ་བའི་གྲངས།",
    "༧༦། གང་ཞིག་མ་སྤྱད་ཕྱེད་ཀྱི་ཆུ་ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "༡༡། དེ་ལ་ཡུད་ཙམ་སུམ་བཅུ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་བཅུ་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལ་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "༢༦། གསང་བ་གཙུག་ཏོར་ལྟེ་བ་ལ་ཡང་ལྷན་སྐྱེས་རྒྱལ་བའི་སྐུ་སྟེ་རང་བཞིན་མེད་དང་རང་བཞིན་ནོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཅི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཁའི་པད་མ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "༡༧། ཁུ་ཚུར་བརླ་ཡི་སྟེང་དུ་རྡོ་རྗེའི་འདུག་སྟངས་ལ་གནས་རྒྱལ་བའི་བདག་པོའི་རྡོ་རྗེའི་ཕྱག་རྒྱར་འགྱུར།",
    "ངེས་པར་འཇམ་པའི་མལ་ཆ་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོ་རང་རང་པད་མའི་གདན་ལ་འོ།",
    "ཐུགས་ཀྱི་དཀྱིལ་འཁོར་དུ་ཡང་ལྷག་མའི་ལྷ་རྒྱལ་བ་རྒྱལ་སྲས་རྣམས་རབ་གསལ་ངེས་པར་རྡོ་རྗེའི་འདུག་སྟངས་ཀྱིས་ནི་གནས་པ་སྟེ།",
    "གདེང་ཅན་ཀླུའི་རིགས་དང་བཅས་པ་རྣམས་དང་བདེན་བྲལ་ལ་སོགས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་བཅུ་གཉིས་པོ་རྣམས་རྡོ་རྗེའི་འདུག་སྟངས་ཀྱིས་གནས་པ་འོ།",
    "ཀཾ་ང་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཞེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སཾ་དང་འདིར་ནི་ྐ་ཉིད་དོ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "གདན་རུས་སྦལ་ལ་ནི་འདུག་སྟངས་ལྷ་མིན་འདུག་སྟངས་ཀྱིས་གནས་ཤིང་འགྲོས་ཤིན་ཏུ་དལ་བུས་འགྲོ་བའི་ཚུལ་གྱིས་བསྒྲུབ་བྱའི་ཁྱིམ་དུ་བསྐུལ་བར་བྱ།",
    "དེ་ལྟར་ཐུན་མཚམས་ཆུ་གཏེར་ཏེ་བཞིའི་བར་རམ་དབུས་སུ་སྟོང་པ་སྒྲ་གཅན་གྱི་ལོངས་སྤྱོད་དག་ལ་རིགས་ལྡན་གྱི་རང་བཞིན་འཆི་བདག་དུས་ཀྱི་སོས་ཟིན་ལ་ཆུ་ཚོད་གཅིག་རབ་རྒྱུ།",
    "འཆི་བདག་དུས་ཀྱི་ཆུ་ཚོད་འདི་དག་སྒྲ་གཅན་གདོང་པ་འི་ཆུ་ཚོད་རྣམས་སུ་ཉིན་ཞག་སོ་སོའི་དུས་སུ་འཆར་བས་དེའི་དབུས་སུ་སྔ་མ་བཞིན་དུ་ཡང་དག་པར་ནི་རིག་པར་བྱ་འོ།",
    "གཞན་གྱི་ཕོ་རྟ་འདི་ཡི་མཐུ་ལས་སླར་ཡང་རང་ལ་རྟ་བཟང་ལྡན་པའི་དཔལ་དུ་གྱུར་བ་དེ་རྒོད་མའི་བདག་པོ་ཡི་ནི་རྙེད་པ་དག་ཀྱང་ཅིས་མ་ཡིན།",
    "གྲོལ་བའི་དོན་དུ་ཤི་བ་དང་ཁྱིམ་དང་ནོར་གྱི་ཡུལ་དང་བྲམ་ཟེའི་བྱ་བ་དག་ལ་ཤི་བ་རྣམས་མཐོ་རིས་སུ་འགྲོ་བར་འདོད་ནས་བྱེད་ཀྱང་རང་གཞན་ཕུང་བར་བྱེད་པ་ཁོ་ནར་བས་སོ།",
    "ཞབས་གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་ཐོད་པ་རྣམས་ཀྱིས་ནི་ལྷ་མིན་གྱི་ཁྲག་འཐུང་ཞིང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་གཅེར་བུ་སྟེ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྒྱུ་བ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དང་།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "གཟུགས་ཀྱི་ཡོངས་སུ་གཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེའང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མ་ལགས་ཞེས་ཞེས་བྱ་བས་གཟུགས་ལ་སོགས་པ་ཡོངས་སུ་མ་བཟུང་བ་ལ་དེའི་ངོ་བོ་བཀག་པས་གང་གསུངས་པ་ཡིན་ནོ།",
    "མཚན་ཉིད་ཀྱི་རང་བཞིན་དང་རང་བཞིན་གྱི་མཚན་ཉིད་དག་ནི་ཕན་ཚུན་དེའི་བདག་ཉིད་དུ་གྱུར་པ་ཉིད་ཀྱིས་རྣམ་པའི་ཁྱད་པར་ནི།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་སླད་དུ་ཆགས་པ་མ་མཆིས་ཏེ།",
    "བསླབ་པ་ལས་འདའ་བའི་གཡེང་བའི་གཉེན་པོར་གནས་པ་དང་འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་རྣམས་དང་།",
    "འོང་བར་མ་ཡིན་འགྲོ་བར་མ་ཡིན་པ་དང་།",
    "དེ་གང་རང་བཞིན་མཚན་ཉིད་ཅན།",
    "ཉེ་ཀོར་དུ་འདུག་སྟེ།",
    "དེ་དང་ཉེ་བར་སྟན་བདེ་བ་ལ་འདུག་ནས་ཡིད་ལ་བྱེད་པ་འཇུག་པར་བྱ་སྟེ།",
    "སྣང་བའི་མཚན་མ་ནི་འདུག་པ་ལྟ་བུར་མི་གཡོ་བར་གྱུར་པ་ཡིན་ནོ།",
    "མཚན་མ་རྣམ་པ་འདི་དགུ་ཆར་ལ་ཡང་བདེ་བར་འདུག་ནས་ཁ་དོག་ལ་སོ་སོར་རྟོག་པ་དང་མཚན་ཉིད་ཡིད་ལ་བྱེད་པ་དག་སྤངས་ཏེ།",
    "འདུག་གནས་བྱེད་པ་ལ་སོགས་པ་ལ་ཐོག་མར་འགྲོ་ཞིང་གཞན་དག་ཀྱང་སྤྲོ་བ་བསྐྱེད་པའི་ཕྱིར་དང་།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དང་འབྲེལ་པའི་གཏམ་སྨྲས་པར་གྱུར་པ་ནི་ཁྱེད་རྙེད་པ་ཆེན་པོ་རྙེད་པ་ཡིན།",
    "རང་བཞིན་ཡང་རང་བཞིན་དང་བྲལ་བའོ།",
    "རང་བཞིན་གྱི་མཚན་ཉིད་ཀྱང་རང་བཞིན་དང་བྲལ་བ་ཡིན་ནོ།",
    "སྐྱེ་མཆེད་ལ་སོགས་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་སྐྱེ་བ་དང་འགག་པ་མི་དམིགས་ཏེ།",
    "འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་རྣམས་དང་།",
    "ཡང་རང་བཞིན་གང་ཡིན་པ་སྡུག་བསྔལ་གྱི་བདེན་པའི་རྟེན་ཅན་རྣམ་པར་གྱུར་པ་ནི་ལྔ་ཡིན་ནོ།",
    "དེ་དག་དེ་ལྟར་བྱས་ན་ཇི་ལྟར་སྟོབས་ལ་སོགས་པའི་རྣམ་པ་རྣམས་ཀྱི་རབ་ཏུ་དབྱེ་བ་དང་རང་བཞིན་གང་ཡིན་པ་དེ་རྣམས་ནི་དེ་བཞིན་ཉིད་དང་།",
    "གོས་གཙང་མ་ལས་འཛག་པའི་གཞོང་པ་ལ་སོགས་པའི་སྣོད་གང་ཡང་རུང་བ་ཆུས་བཀང་བ་གནས་ཤིན་ཏུ་བཟང་པོར་བཞག་ལ་བདེ་བར་འདུག་ནས་ཡིད་ལ་བྱེད་པ་བརྩམས་པར་བྱ་སྟེ།",
    "དེ་དང་ཉེ་བར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སོ་སོར་སྣང་བའི་མཚན་མ་ནི་ལེགས་པར་འདུག་པ་ལྟར་མི་གཡོ་བར་འགྱུར་རོ།",
    "མཚན་མ་དེ་དགུ་ཆར་ལ་ཡང་བདེ་བར་འདུག་ནས་ཁ་དོག་ལ་བརྟག་པའི་ཡིད་ལ་བྱེད་པ་སྤངས་ནས།",
    "པདྨའི་འདབ་མ་རྒྱས་པ་ལྟར་འདུག་པའི་སྤྱན་གྱིས་ལྷ་དང་།",
    "ཀུན་བརྟགས་པའི་བྱེད་པ་པོ་དགག་པ་ཡང་རང་བཞིན་སྟོང་པ་དང་།",
    "གང་ཕྱིར་དྲི་མ་མང་པོས་དུས་འདི་དེ་བཞིན་མ་ཡིན་འགྲོ་བ་འདི་ཡིན་ཞིང་།",
    "དཔེར་ན་ཉི་མ་སྒྲིབ་པ་མེད་པ་ནམ་མཁའི་དབྱིངས་ཡོངས་སུ་དག་པ་ལ་འདུག་པའམ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདིའི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་ནི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་ནི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདིའི་རྒྱུ་ཅི་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་རྒྱུ་ཅི་ལགས།",
    "འདུག་པ་དང་།",
    "ཡུན་ནི་འདི་སྲིད་ཅིག་ཏུ་འདུག་འདུག།",
    "འདི་ལྟར་དེས་ཡེ་ཤེས་དེ་ཉིད་ཀྱིས་ཀྱང་རང་བཞིན་སྟོང་པའི་ཕྱིར་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡོངས་སུ་མ་བཟུང་བའོ།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ།",
    "ཚེ་དང་ལྡན་པ་རབ་འབྱོར་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་སེམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་མ་གཏོགས་པ་ཡིན་ནམ།",
    "བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་ཐུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་མ་གཏོགས་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་མ་གཏོགས་པ་ཡིན་ནམ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་པ་ཡིན་ནམ།",
