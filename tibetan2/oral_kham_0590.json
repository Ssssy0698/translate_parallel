    "སྡུག་བསྔལ་མི་འདོད་ཅིང་རང་བཞིན་གྱིས་སྡུག་བསྔལ་བར་གྱུར་པའི་སྐྱེ་བོ་ལ་སྡུག་བསྔལ་གྱིས་རྣམ་པར་འགེད་པས་ཅི་ཞིག་བྱ་སྟེ།",
    "གལ་ཏེ་འཇིག་རྟེན་ན་ལྷ་སྦྱིན་བདེ་བར་ཉལ་འདུག་གོ་ཞེས་སོགས་ཀྱི་ཐ་སྙད་མཐོང་བས་བདེ་བ་ཡོད་དོ་ཞེ་ན།",
    "ཕན་པ་དང་མི་ཕན་པ་རྗེས་སུ་སྟོན་པ་པོ་མེད་ཅིང་རང་ཡན་དུ་གྱུར་པས་སོ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "ངེས་པར་ཏེ་མཐའ་གཅིག་ཏུ་མི་དགེ་ཞིང་རང་གཞན་གྱི་རྒྱུད་སྲེག་པ་དང་གཞན་ལ་གནོད་པ་སོགས་དོན་མ་ཡིན་པ་སྐྱེད་ཅིང་།",
    "གཞན་ལ་གཏོང་བ་པོ་དང་རང་ཟ་བ་པོ་དང་།",
    "དེ་ལྟར་ནའང་རང་བཞིན་ཡིན་པའི་ཕྱིར་མི་འཇིགས་སོ་ཞེ་ན།",
    "དངོས་པོ་དང་རང་བཞིན་དང་བདག་དང་རྟག་པ་རྣམས་ནི་རྣམ་གྲངས་ཡིན་ལ།",
    "སྣ་ཚོགས་རྟག་པར་མི་རིགས་ཞེས་པ་སོ་ན་འདུག་གོ།",
    "འགྲོ་བ་དང་འོང་བ་དང་འདུག་པ་ལ་སོགས་པ་བྱ་བ་ཅི་ཡང་མེད་དོ།",
    "ས་བོན་ལ་སོགས་པ་ཡོད་ཀྱང་འབྲས་བུ་མྱུ་གུ་དང་མེ་ཏོག་ལ་སོགས་པའི་སྐྱེ་བ་དང་འཇིག་པ་དག་དུས་རྟག་ཏུ་མེད་པའི་ཕྱིར་དང་།",
    "གཉིས་ཀའང་རང་བཞིན་མེད་པར་མཚུངས་པའི་ཕྱིར་གཅིག་མཐོང་ལ་གཅིག་མི་མཐོང་ཞེས་བྱ་བར་མི་རིགས་སོ།",
    "རྣམ་པར་ཤེས་པའང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དངོས་པོ་འགའ་ལའང་རང་བཞིན་བརྟག་པར་མི་ནུས་ཏེ།",
    "གསུམ་པོ་འདི་དག་དུས་ཐ་དད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཚིག་གསུམ་ལའང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་རང་ལུགས་སྒྲུབ་བྱེད་ཀྱི་གཏན་ཚིགས་རྙེད་པར་དཀའ་ལ།",
    "དེ་ཁོ་ན་ཉིད་ཀྱང་རང་བཞིན་དང་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "ཡུལ་དེ་དག་དུས་ཤིན་ཏུ་འགོར་བས་བསྟེན་ཀྱང་ལུས་ནི་བདེ་བའི་བདག་ཏུ་མི་འགྱུར་ཏེ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་པའི་ཕྱིར།",
    "གལ་ཏེ་ལྷས་བྱིན་བདེ་བར་ཉལ་འདུག་འགྲོའོ་ཞེས་པའི་ཐ་སྙད་ཡོད་པའི་ཕྱིར་བདེ་བ་ཡོད་དོ་ཞེ་ན།",
    "དེས་ན་རང་བཞིན་གྱིས་མ་སྐྱེས་དེའི་བར་མ་དཔེ་ཤོག་ལྷེ་ཞེ་དྲུག་པ་ཆད་འདུག་པས་བཙལ་དགོས་སོ།",
    "སྐྱེ་བོ་གཞན་ལ་དེ་རྟོགས་སུ་གཞུག་པ་ཡང་སྐྱེ་བོ་སྤྱི་ལ་གྲགས་པའི་ཐབས་གཞན་གྱིས་ནུས་པས་དེ་ལའང་རང་རྒྱུད་དོན་མེད་དོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པའི་རྟག་པ་ཞིག་སྟེ།",
    "ཁྱེད་རང་ལའང་སེམས་ལུས་ཀྱི་སྐུལ་བྱེད་དུ་འདོད་པས་མཚུངས་སོ་ཞེ་ན།",
    "འདུག་པ་སོགས་ལའང་སྦྱར་རོ།",
    "གལ་ཏེ་ཁྱེད་རང་ལའང་མིག་མེད་ན།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པར་འདོད་པས་མཚན་གཞི་དང་ངོ་བོས་གྲུབ་པའི་གཅིག་དང་ཐ་དད་པ་ཉིད་ལས་མ་འདས་ལ།",
    "འདིས་ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་ལ་ཁྱད་མེད་པས།",
    "དེ་ལྟར་འདུས་བྱས་སྒྱུ་མ་ལྟ་བུར་བརྗོད་ནས་དེའི་མཚན་ཉིད་རྣམས་ཀྱང་རང་བཞིན་གྱིས་མེད་པར་སྟོན་པ་ལ།",
    "ཚ་བ་མེའི་ཡང་རང་བཞིན་དུ་ཡོད་པ་མིན་ཞེས་དེ་དེའི་རང་བཞིན་དུ་ཡོད་པ་གོང་ཉིད་དུ་བཟློག་པར་བྱས་ཟིན་པའི་ཕྱིར་རོ།",
    "མངལ་ནི་མའི་ལྟོར་ཤ་མས་དཀྲིས་ནས་འདུག་པ་ཡིན་ལ་དེ་བརྟོལ་ནས་སྐྱེ་བ་དང་།",
    "མངལ་དུ་སྐྱེ་བ་བླངས་པ་དེའི་འོག་ཏུ་ལུས་རིམ་གྱིས་འཕེལ་ཏེ་དང་པོ་ནི་མེར་མེར་པོ་སྟེ་ཕྱི་སྤྲིས་མ་ལྟ་བུས་གཡོགས་ལ་ནང་ཤིན་ཏུ་སླ་བར་འདུག་པའོ།",
    "མེར་མེར་པོ་སྨིན་པ་ལས་ལྟར་ལྟར་པོ་སྟེ་ཕྱི་ནང་གཉིས་ཀ་སྤྲིས་མ་ལྟར་གྱུར་ཏེ་ཞོ་ལྟར་འདུག་ལ་ཤར་ནི་མ་གྱུར་པའོ།",
    "ཆོ་ག་བཞིན་དུ་འཐུང་བ་ཡང་རང་བཞིན་ལྔ་རིམ་གྱིས་འོད་གསལ་དུ་ཞུགས་པ་ལ་བྱའོ།",
    "སྣང་བའམ་སྟོང་པ་གསུམ་ནི་གཉིད་དང་བརྒྱལ་བ་དང་འཁྲིག་དུས་དང་འཆི་བའི་དུས་དང་ཏིང་ངེ་འཛིན་མཐུ་ལྡན་གྱིས་སྤྲོས་པ་ཐིམ་པར་བྱས་པའི་སྐབས་མ་གཏོགས་པ་རྣམས་སུ་མངོན་དུ་མི་འགྱུར་ལ།",
    "དེ་སྐད་སྨྲས་ནས་མདུན་འདུག་སྟེ།",
    "དེའང་རང་བཞིན་གྱིས་ཀུན་ལ་གནས་པ་དང་།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་ནས།",
    "བསྡུས་ནས་སླར་ཡང་རང་བཞིན་གྱིས།",
    "ཕྱིའི་དུས་དང་ཁ་ལྟ་ཕྱོགས་དང་འདུག་སྟངས་དང་།",
    "སྣང་བ་དང་རང་བཞིན་གཏན་ལ་དབབ་པ་དང་།",
    "སྣང་བ་གསུམ་དང་རང་བཞིན་གྱི་མཚན་ཉིད་བསྟན་པ་དང་།",
    "རབ་དབྱེ་ནི་སྣང་བ་གསུམ་དང་རང་བཞིན་བརྒྱད་ཅུའི་དབྱེ་བའོ།",
    "རྟོགས་པའི་ཕན་ཡོན་རྣམས་བསྟན་འདུག་ལ།",
    "ཐམས་ཅད་ནི་སྣང་བ་གསུམ་དང་རང་བཞིན་རྣམས་སོ།",
    "ཞེས་གསུངས་ཤིང་རང་ཉིད་ཀྱིས་ཀྱང་དེ་ལྟར་བསྒྱུར་བའི་ཕྱིར་རོ།",
    "བརྗོད་བྱ་དང་རང་བཟོའི་ཉེས་པ་སྤང་བ་དང་།",
    "འདོད་པ་དང་མྱ་ངན་ལ་སོགས་པར་གྲུབ་ཅིང་རང་བཞིན་གྱི་མི་མཐུན་ཕྱོགས་པ་ཐ་མལ་པའི་ང་རྒྱལ་དང་།",
    "ཅི་དེའང་རང་བཞིན་གྱིས་གྲུབ་པ་ཞིག་གམ་འོན་ཏེ་མ་ཡིན་ཞེ་ན།",
    "ཛཧཱུྃ་བཾ་ཧོརང་རང་སོ་སོའི་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར་ཅེས་བརྗོད་དོ།",
    "འདིར་ཧཱུྃ་སོགས་ས་བོན་ལྔ་ཁ་འདུག་ཨོ་ཞེས་པ་ནས་སྭཱཧཱ་རྣམས་གཡས་སྐོར་དུ་གནས་པར་གྱུར་ཅེས་དང་།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
