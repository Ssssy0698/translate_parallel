    "རྗེས་མར་དོགས་པ་མེད་ཀྱང་ཁོ་ནས་མི་ཆོག་གམ་དོགས་པ་ཡོད་ཀྱང་སྐྱབས་དང་གུང་ཐང་ལ་མ་ཞུས་འདུག་མཛོད་དགའ་དང་གུས་ཉིད་ངོ་ཚ་ཤེས།",
    "དལ་འབྱོར་དོན་ཆེ་སྟོང་ལོག་བྱེད་ཉེན་གདའོ།",
    "ལྔ་བས་རྒྱན་བཟང་འབྲེལ་ཆེ་ལྔ་བའི་གསུང་གཞན་ཞིག་ན་དེ་དུས་རྗེའི་སྒོམ་རྙིང་མའི་ལྟ་བ་གསུངས་ཞེས་འདུག་པ་འཐད་གསུངས་དོན་འདི་ཡིན།",
    "དེ་དུས་ནས་དེ་འདྲ་ཡིན་འདུག་མགོ་རིས་བྱས།",
    "དེ་ནས་ལུས་སེམས་ཤིན་པས་བརྒྱད་པ་ནས་ཏིང་འཛིན་འགྲོ་འཆག་ཉལ་འདུག་དང་བསྲེ་ཐུབ་ཀྱང་ཤིན་སྦྱངས་མེདསྦྱངས།",
    "མ་གོས་འདུག་ན་དགའ་བ་བསྒོམ།",
    "ཀུན་སློང་རང་དོན་དུ་སྤྱོད་འདོད་རྒྱུན་མཆད་བ་དགོས་སོ།",
    "མི་ཡིན་ཅིང་རང་ལས་ནོར་ཐ་དད་པ།",
    "འདོམ་སྣང་བར་འདུག་པ་རྣམས་སོ།",
    "མཁན་སློབ་ཀྱི་མདུན་དུ་དགོས་པ་མེད་པར་བཅག་པར་མི་བྱ་ཞིང་བླ་གོས་མ་བྱོན་པར་ཁྱེད་རངས་སུ་ལུས་མི་དབྱུང་།",
    "ཁྱིམ་པའི་པར་ཏང་ཁྲ་བོ་མ་ཉམས་པ་སོགས་ལ་གདིང་ངས་མ་གཡོགས་པར་མི་བྱསྟན་ཆེ་མཐོ་སོགས་ལ་མི་རྟག་པ་ཡིད་ལ་བྱས་ཏེ་འདུག་པར་བྱ།",
    "རང་ཉིད་གྲོང་ངམ་ལམ་པོ་ཆེར་འདུག་པས།",
    "གསུམ་པ་ཁྱིམ་དུ་འདུག་པ་ལ་བརྟེན་པ་ནི།",
    "ཁྱིམ་པས་འདིར་ཞུགས་ཤིག་ཅེས་མ་བསྒོས་བར་བསྟན་ལ་འདུག་པ་སོགས་དགུའོ།",
    "སླར་ཡང་གནས་ཁང་ལ་བྱི་དོར་དང་རང་ཉིད་ཁྲུས་བྱས།",
    "ཁྲེལ་ཞིང་རང་ཉིད་ངལ་བའི་རྒྱུ་རུ་བས།",
    "འདུགགནས་དང་མཛའ་གྲོགས་སོགས་ལ་སྐྱོ་ནས་གཞན་དུ་འགྲོ་འདོད་པའམ་ཡང་ན་དེ་དག་ལ་སྔར་ལས་ལྷག་པར་ཆགས་པ་དང་།",
    "ཞེས་གསུང་པ་འདིས་མིག་ཕྱེ་འདུག་པས་འདིའི་སྟེང་ནས་བསམ་དགོས།",
    "ལྷ་བདུད་དུ་བབས་ནས་ལྷག་པར་ལོག་རྟོག་སྐྱེ་བའི་རྒྱུར་འགྲོ་བ་ཡང་འདུག་པས།",
    "ཕར་བལྟས་ན་ཁྱི་ཇི་མ་ཇི་བཞིན་ལོས་ཡིན་ཞེས་གསུངས།",
    "ཁྱིམ་པ་ཚོ་ལ་བློ་རིག་རྩལ་གསུམ་འཛོམས་པ་ཅི་འདྲ་འདུག་ཀྱང་སྐལ་བ་འདི་ལྟ་བུ་མ་རྙེད།",
    "དེ་དུས་གཉེན་ཉེ་དུ་གྲོགས་མཛའ་བཤེས་ཅི་ཙམ་ཡོད་ན་ཡང་དུས་ནས་འདུག་པ་མ་གཏོགས་ཐབས་མེད་པས་ཞི་བ་ལྷས།",
    "དེ་ལ་མགོ་འཁོར་ནས་འདུག་ཁོམ་མེད།",
    "མྱུ་གུ་འདི་མི་སྐྱེ་བར་འདུག་ཅེས་ལག་པས་ཐེན་ན་ཆད་འགྲོ་བ་ལྟ་བུ་ཡིན།",
    "དེ་ཡང་རང་དང་རྒྱུའི་སྟོབས་ཀྱིས་སྐྱེས་ན་བརྟན་ལ་གཞན་མི་བརྟན་པར་གསུང་དེ་དག་ཀྱང་བསྡུ་ན།",
    "བ་ཙམ་ཡང་མི་འདུག་པར་སྣང་བས་བློ་གྲོས་དང་ལྡན་པ་རྣམས་ཀྱིས་རྒྱུ་གཉིས་པོ་དེ་ཤུགས་དྲག་ལ་བརྟན་པ་ཞིག་འོང་བའི་ཐབས་ཚུལ་ཁོ་ནར་འབད་པར་རིགས་སོ།",
    "དེས་བདག་ལ་འདི་འདྲ་སྨད་པ་ཨང་སྙམ་པའི་ཁོན་འཛིན་སོགས་ཀུན་སློང་དགེ་མི་དགེ་ལུང་མ་བསྟན་ཅི་འདུག་ངེས་པར་བྱ་དགོས།",
    "ཤེས་པའི་དུད་འགྲོ་རྣམས་ཀྱང་ཟག་བཅས་ཀྱི་བདེ་བ་ཇི་ལྟར་དོན་དུ་གཉེར་འདུག།",
    "སྐྱིད་སྡུག་ལེགས་ཉེས་ཅི་བྱུང་ཡང་སྐྱབས་ཡུལ་ཁྱེད་རང་མཁྱེན་ཅེས་བློ་ལིངས་ཀྱིས་བཀལ་ནས།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ཐོག་མར་རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "གླིང་ཐམས་ཅད་ཀྱི་མི་རྣམས་གཟུགས་བཟང་བ་བྱད་ལེགས་པ་སེམས་རྒྱུད་འཇམ་ཞིང་རང་བཞིན་དྲང་བ།",
    "དུས་མེའི་དཀྱིལ་འཁོར་སའི་རང་བཞིན་ཁ་དོག་ཁམ་སེར་གཉིས་ཀའང་རང་འོད་འཕྲོ་བར་བསམ་ལ་འབུལ་བ་ཡིན།",
    "ཁྱེད་རང་ལྟ་བུར་བདག་ཀྱང་བྱིན་གྱིས་རློབས།",
    "ཁྱེད་རང་ལྟ་བུར་བདག་ཀྱང་བྱིན་གྱིས་རློབས།",
    "དངོས་གཞིའི་དམིགས་སྐོར་དང་རང་ཐད་དུ་གསལ་བ་བཞིན་ལེགས་པར་སྐྱོང་བ་ལ་འབད་ཅིང་།",
    "འདོམས་སྣང་བར་འདུག་པ་སོགས་སོ།",
    "ཀུན་སློང་རང་ཉིད་ཀྱི་དོན་དུ་ཡིན་པ་མ་གཏོགས་སྔ་མ་དང་འདྲའོ།",
    "ཤིང་སོགས་ལས་བྱས་པའི་ཁྲི་དང་སྟན་ཁྲུ་གང་ལས་མཐོ་བ་ལ་རང་དགར་འདུག་པའམ་ཉལ་བ་གཉིས་ཏེ་བཞི་ཡོད་དོ།",
    "སོགས་སྟོན་མི་རུང་བ་ལ་འདུག་པ་སོགས་སོ།",
    "ཕྱིས་གནོན་འབྱུང་འདུག་དུད་འགྲོ་འདེབས།",
    "རིམ་ལྷག་འདུག་གནས་དོ་ལྷག་ལེན།",
    "ས་རྐོ་མགྲོན་གཉེར་རིང་འདུག་དང་།",
    "དུས་མིན་འགྲོ་དང་གྲོང་རྒྱུ་དང་།",
    "ཁྱིམ་དུ་མ་བསྒོས་སྟན་འདུག་དང་།",
    "མ་བསྒོས་སྟན་འདུག་རྩྭ་སྔོན་སྟེང་།",
    "མཁོ་བའི་ཡོ་བྱད་ལ་རིམ་བཞིན་གཞན་དང་རང་གཞན་གཉིས་ཀའི་བསམ་པ་དགོས་པས་དེ་དཀའ་ལ།",
    "དཀོན་ཞིང་རིན་ཆེ་བའི་སྲིན་བལ་རུང་བ་ཚད་ལྡན་གྱིས་སྟན་གླིངས་པ་དང་ནང་ཚངས་ཅན་གང་རུང་རང་ངམ་བསྐོས་པས་གསར་དུ་བྱས་པ་བཀྲམ་པ་རྫོགས་པན་སྲིན་བལ་གྱི་སྤང་བ།",
    "དགེ་སློང་མ་གྲོང་དང་ལམ་དང་དེ་གཉིས་ཀྱི་ཉེ་འཁོར་གང་རུང་ན་འདུག་པ་ན།",
    "སྐ་རགས་ཀྱི་བར་བར་ནས་འབྲུའི་ཕུར་མ་ལྟར་འདུག་པ།",
    "མ་བརྟགས་པར་སྟན་ལ་འདུག་པ།",
    "ལྕིད་ཕབ་སྟེ་འདུག་པ།",
    "འདོམས་སྣང་བར་བྱས་ཏེ་འདུག་པའོ།",
    "དེ་བཞིན་དུ་ཉལ་བ་ལ་འདུག་སྟེ།",
    "སྟན་དང་ས་མཐོན་པོ་ལ་འདུག་པ་ལ་སྟན་སོགས་དམའ་པར་འདུག་སྟེ།",
    "སྟན་བཟང་བོ་འདུག་པ་ལ་ངན་པར་འདུག་སྟེ།",
    "དེ་དག་ལས་གཞན་པའི་བཞོན་པའི་སྟེང་ན་འདུག་པ་ལ།",
