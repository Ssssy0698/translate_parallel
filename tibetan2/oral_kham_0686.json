    "ལང་ལང་ལིང་ལིང་དེ་ཡོད་སྐད་མི་འདུག།",
    "འཚོལ་དགོས་མི་འདུག་སྟེ་འཚོལ་མཁན་རང་ཡིན།",
    "ཞེས་སྟོང་བ་ཉིད་དེ་ཐག་རིང་བོ་ནས་འཚོལ་དགོས་མི་འདུག་སྟེ་འཚོལ་མཁན་རང་དང་ལྷན་ཅིག་ཏུ་གནས་པར་གསུངས།",
    "གཞན་ཡང་བདག་ཕུང་རང་ངོས་ནས་གྲུབ་པའི་གཅིག་ཡིན་ན་ཡུལ་དུས་དང་ཆ་ཐམས་ཅད་ནས་གཅིག་དགོས་ཤིང་།",
    "སྐྱེ་བ་སྔ་ཕྱིའི་ང་རང་བཞིན་གྱིས་ཐ་དད་ན།",
    "རང་བཞིན་གྱིས་གྲུབ་པའི་གང་ཟག་གཞན་གྱིས་མྱོང་བས་ལས་མ་བྱས་པ་དང་འཕྲད་པར་འགྱུར་བའི་སྐྱོན་སོགས་གནོད་བྱེད་དུ་མ་འབབ་པས་བདག་ཕུང་བོ་ལྔ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཏུ་གྲུབ་ལུགས་ཤིག་གཏན་ནས་མི་འདུག་སྙམ་དུ་ངེས་པ་རྙེད་པ་ནི་བདེན་པའི་གཅིག་བྲལ་ངེས་པ་ཡིན།",
    "དེ་ལྟར་གཅིག་བྲལ་ངེས་པ་ལ་བརྟེན་ནས་ད་ནི་བདག་དང་ཕུང་བོ་གཉིས་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དད་ལས་འོས་མི་འདུག་སྙམ་ན།",
    "གང་འདུག་བརྟགས་པ་ན་ངའི་མིང་ཙམ་ཞིག་ལྷག་པར་སྣང་ལ།",
    "བ་ལྟར་ང་རང་བཞིན་གྱིས་མེད་པ་མིང་རྐྱང་བཏགས་ཡོད་ཙམ་འདིས་མི་བདེན་བཞིན་དུ་ལས་གསོག།",
    "དེ་དང་རང་བཞིན་གྱིས་ཐ་དད་དུ་གྲུབ་ན།",
    "དེ་དག་དང་རང་མཚན་གྱིས་ཐ་དད་དུ་གྲུབ་ན་ཆ་དང་ཆ་ཅན་འབྲེལ་མེད་དོན་གཞན་དུ་འགྱུར་བས།",
    "ལན་གསུམ་པའི་མཐར་ངེད་ཀྱིས་མཆོད་རྫས་ནམ་མཁར་འཐོར་བ་དང་ཁྱེད་རང་རྣམས་ཀྱི་དགེ་རྩ་ནམས་བཀྲ་ཤིས་རྟགས་བརྒྱད།",
    "རང་ཉིད་རང་རྒྱུད་ཁས་ལེན་མི་ལེན་མི་མཐུན་སྙམ་པ་མི་འདུག་ཅེས་གསུངས་པའི་ཕྱིར།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ད་དུང་མི་འཆི་སྙམ་པ་འདི་ལ་ཐུག་འདུག་པས་ན་བློས་མི་འཆི་བར་འཛིན་པ་ནི་རྒུད་པ་ཀུན་གྱི་སྒོ་དང་།",
    "ཡང་བྲོས་པས་ལྕགས་ཀྱི་ཁང་བ་གཅིག་ཏུ་སླེབས་པ་ན་སྒོ་དབྱེར་མེད་དུ་འགྲིག་སྟེ་ཕྱོགས་ཀུན་ནས་མེ་ལྕེ་འབར་བས་བསྲེག་ཅིང་ང་འབྲོས་ས་ཡང་མི་འདུག་སྙམ་ནས་ངུ་འབོད་ལྷང་ལྷང་བ་བྱེད་པའི་སྡུག་བསྔལ་ཆེན་པོ་མྱོང་།",
    "ལྕགས་ཁང་ནང་མ་ནས་ཐོན་སྲིད་ཀྱང་ཕྱི་མ་ནས་མི་ཐོན་པར་འདུག་སྙམ་པའི་སྒོ་ནས་སྡུག་བསྔལ་དྲག་པོ་མྱོང་ཚ་བ་ནི།",
    "དེ་དང་འདབ་ཆགས་པ་ན་ཕྱི་སའི་འདམ་རོ་ལྟར་མནམ་པ་ལ་བརྒལ་བ་ན་མགོ་བོ་མན་ཆད་བྱིང་སྟེ་འདུག་པའི་ཚེ་ལྕགས་ཀྱི་འབུ་མཆུ་རྣོན་ཞེས་བྱ་བས་རྐང་ལ་ཐུག་པར་འབིགས་ཤིང་ཟ་བའི་སྡུག་བསྔལ།",
    "དགུན་ལྷགས་སྒང་ལ་ཞག་གཅིག་ཙམ་གཅེར་བུར་འདུག་པ།",
    "རབ་ཏུ་དོག་པ་མུན་གནག་ཐིབས་པོར་འདུག་པ་ཡི།",
    "འདུག་པ་དང་ལངས་པ་དང་འགྲོ་བ་དང་ངག་སྨྲ་བ་སོགས་ཀྱི་མཐུ་ཉམས་ནས་ཞན་པར་འགྱུར་བའོ།",
    "འགྲོ་འདུག་ཉལ་བ་དང་བཟུང་བཏུང་དང་ཉི་མ་དང་གྲིབ་མ་བསྟེན་པ་སོགས་ཀྱང་ཇི་ཙམ་དུ་བསྟེན་པ་དེ་ཙམ་དུ་བདེ་བ་ཇེ་འཕེལ་དུ་འགྲོ་དགོས་པ་ལ།",
    "དགའ་བོའི་འཆག་དང་བ་འདུག་པ་དང་འགྲེང་བ་དང་ཉལ་བའི་སྤྱོད་ལམ་དག་ཀྱང་སོ་སོ་སོ་སོར་སྡུག་བསྔལ་བར་རིག་པར་བྱ་སྟེ།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "ས་གསུམ་མི་རྟག་པ་ཉིད་ཀྱི་མེ་རབ་ཏུ་འབར་བ་ན་འདུག་པ་ནི།",
    "མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "ཡང་དག་པའི་བདེ་བ་གཏན་ནས་མི་འདུག་པའི་ཕྱིར།",
    "གཞན་ལ་རང་ལྟར་གཅེས་པར་འཛིན་ཅིང་རང་ལ་གཞན་ལྟར་ཡལ་བར་འདོར་བའི་བློ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "རང་རང་ལས་ཀྱི་བགོ་སྐལ་དམན་པའི་མཐུས།",
    "དེ་འདུག་མ་ཐག་ཏུ་སེམས་འཇོག་སྟེ།",
    "ཐུན་ཡང་རིང་ཐུང་རང་ཉམས་ལ་དཔགས་ཏེ་བློ་དང་འཚམས་པ་བྱ།",
    "ཡོད་མེད་ཀྱི་མཐའ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་དང་གཏན་ནས་མེད་པ་ལ་བྱེད་ཀྱི།",
    "ཞེས་སོགས་གསུངས་པ་ཡང་རང་བཞིན་གྱིས་སྟོང་བར་སྟོན་པ་ཡིན་གྱི།",
    "དེ་ཡང་རང་རྒྱུད་ལ་སླར་མི་སྐྱེ་བའི་ཚུལ་གྱིས་སྤོང་བ་ཡིན་གྱི།",
    "ཕུང་བོ་དང་རང་བཞིན་གཅིག་ཏུ་ཡང་མ་གྲུབ།",
    "དེ་དང་རང་བཞིན་ཐ་དད་དུ་མ་གྲུབ་སྟེ།",
    "དེ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཏུ་འགྱུར།",
    "དེ་ཕུང་བོ་ལྔའི་སྟེང་དུ་ཕུང་བོ་ལྔ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དད་ཡིན་པའི་ཕྱིར།",
    "དེ་དང་རང་བཞིན་གྱིས་ཐ་དད་དུ་ཡང་མེད།",
    "ཡན་ལག་རྣམས་དང་རང་བཞིན་གྱིས་ལྡན་པ་ཡང་མ་ཡིན།",
    "གང་ཟག་ཕུང་བོ་དང་རང་བཞིན་གྱིས་དེ་ཉིད་དང་གཞན་གང་རུང་དུ་མེད་པར་ངེས་པ་ལ་བརྟེན་ནས་གང་ཟག་རང་བཞིན་མེད་པར་རྟོགས་ནུས་པའི་ཕྱིར།",
    "དེ་ཡང་རང་རྒྱུད་ལ་བདག་མེད་གཏན་ལ་འབེབས་པའི་སྐབས་སུ་ལྷན་སྐྱེས་ཀྱི་བདག་འགོག་པའི་མཐའ་གཅོད་པའི་ཡན་ལག་ཏུ་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་ང་རང་བཞིན་མེད་པར་རྟོགས་པའི་བློ་དེ་ཉིད་ཀྱིས་ང་ཡི་བ་རང་བཞིན་མེད་པར་མི་འཛིན་ཀྱང་ང་ཡི་བ་ལ་རང་བཞིན་ཡོད་མེད་དཔྱོད་པའི་ཚུལ་གྱིས་བློ་ཁ་ཕྱོགས་པ་ན་བློ་སྔ་མའི་བྱེད་པ་ལ་བརྟེན་ནས་རང་བཞིན་མེད་པ་བདེ་བླག་ཏུ་རྟོགས་པར་འགྱུར་གྱི།",
    "དེ་ལྟར་བན་བུན་དུ་ཤར་བ་ཡང་རང་བཞིན་ཡོད་མེད་དང་།",
    "གང་ཟག་ལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་རྡུལ་ཙམ་ཡང་མེད་ཀྱང་།",
    "ཡེ་ཤེས་དེ་ཁོ་རང་རང་ལས་ཐ་དད་པའི་ཚུལ་གྱིས་རྟོག་པའི་ཕྱིར།",
    "འགྲན་སེམས་ཕྲག་དོག་དང་རང་རྒྱལ་གཞན་ཕམ།",
    "བོད་ཕྲུག་ང་རང་ལ་མཚོན་ན་བསམ་བློའི་གོ་རྟོགས་དང་ཡོན་ཏན།",
    "རང་རང་འདབ་༣༧ན་མར་གཡས་བརྐྱང་གནས་ཞེས་སོ།",
    "གཞན་ལ་སྟོན་ཅིང་རང་གཞན་གྱི་དོན་རྫོགས་པར་བྱེད་པས་དུར་ཁྲོད་དང་།",
    "ལུས་ལ་གནས་པའི་ས་བཅུ་པོ་འདི་དག་དུས་ཀུན་ཏུ་འགོག་པ་ལས་རྣལ་འབྱོར་པ་རྣམས་ལ་བདེ་མཉམ་འབྲས་བུ་སྟེར་བར་འགྱུར་ཏེ།",
    "འགྱུར་མེད་དྲུག་ནི་མིག་ལ་སོགས་པ་དྲུག་སྒྲིབ་པ་མེད་པ་རྣམས་ཏེ་སོ་སོར་རང་རང་ནི་ཡུལ་སོ་སོར་འཛིན་པ་སྤངས་པ་རྣམས་སོ།",
    "སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པ་དང་རང་གཞན་གྱི་སྔོན་གྱི་གནས་དངསྐྱེ།",
    "དེ་བཞིན་དུ་བཟའ་བྱ་ཡིན་མིན་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་བྱེད་ཅིང་རང་གཞན་གྱི་གཟུགས་རྣམ་པ་གཞན་དུ་ཡོངས་སུ་སྐྱུར་བར་བྱེད་དོ།",
    "གཟུགས་འཆར་བར་འགྲེལ་ཆེན་ལས་གསུངས་ཤིང་ཁྱེད་རང་ཡང་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་བྱ་བ་ནན་ཏན་༡༥༣ན་གྱི་ཡེ་ཤེས་ཀྱིས་བསྟོད་པ་ལས་ཚིགས་བཅད་བཅུ་གསུམ་པས་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་རང་རིག་ཅིང་རང་བཞིན་མཁྱེན་པར་གསུངས་པ།",
    "ཐམས་ཅད་དུས་སུའོ་ཞེས་པ་ནི་དངུལ་ཆུ་མཉེས་པའི་སྙིགས་མར་གྱུར་པ་དེ་མཐའ་དག་དུས་ཐམས་ཅད་དུ་དངུལ་ཆུ་བཟུང་བའི་སླད་དུ་དབྱེ་བར་བྱའོ།",
    "ལུས་མི་གཙང་བ་དང་རང་བཞིན་མེད་པར་ཤེས་རབ་ཀྱིས་ཡོངས་སུ་བརྟགས་ནས་དྲན་པ་ལ་ཉེ་བར་བཞག་པ་དང་།",
    "ཉལ་བ་དང་སྙེས་པ་སོགས་ལ་ཞེན་པའི་གཉེན་པོར་ཙོག་བུ་དང་འདུག་ས་ཡང་སྤོང་བ་ལ་ཞེན་པའི་གཉེན་པོར་གཞི་ཇི་བཞིན་པ་དང་།",
    "པོར་སྟན་གཅིག་ལ་འདུག་པས་དུས་གཅིག་ཏུ་བཟའ་ཡི།",
    "ཟླ་བཟང་རང་ཉིད་བཤེས་གཉེན་ཚུལ་གྱིས་བརྩེ་བས་སླར་ཡང་བྱོན་པ་གང་།",
    "རང་རང་ངོ་བོ་གཅིག་ཏུ་སྐྱེས་པའི་མཆོག་ཏུ་མི་འགྱུར་བའི་ཡེ་ཤེས་དེ་ཡོངས་སུ་བཟུང་བའི་ཕྱིར་རོ།",
    "དེས་ན་དངོས་པོའི་སྐད་དོད་དེ་དངོས་པོ་དང་རང་བཞིན་གཉིས་ལ་འཇུག་པ་ལས།",
    "དེས་ན་གཞུང་འདི་ཉིད་དུ་འཇིག་རྟེན་པའི་དཔེར་བྱ་བ་ལས་འདས་ཞེས་འཇིག་རྟེན་པ་ལ་དམིགས་ཀྱིས་བཀར་བས་ཀྱང་སྤྱིར་དཔེ་མི་སྲིད་པར་སྟོན་པ་མིན་པར་གྲུབ་བོ།",
    "ཐ་སྙད་དུ་དེ་གཉིས་གཞི་གཅིག་ལ་འདུར་རུང་བ་ཙམ་དུ་མ་ཟད་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མ་ཁེགས་ན་བྱ་བྱེད་བཞག་ས་མེད་པ་དང་།",
    "འཇིག་རྟེན་པ་ལ་བལྟོས་ནས་དཔེ་མི་སྲིད་པ་དང་།",
    "ཞེས་བྱ་བ་བྱེད་པའི་དངོས་པོ་དང་རང་བཞིན་གྱིས་དངོས་པོར་མེད་པའི་ངོ་བོ་གཅིག་པ་ཉིད།",
    "དེའི་ངོར་བྱ་བ་བྱེད་པ་དང་རང་བཞིན་གྱིས་སྟོང་པ་ཕན་ཚུན་འགལ་བའི་ཕྱིར་རོ།",
    "སླར་ཡང་རང་བྱིན་བརླབས་པ་དེ།",
    "སྐད་ཅིག་གང་རང་བཞིན་གྱིས་སྐྱེ་ན་དུས་ཐམས་ཅད་དུ་སྐྱེ་དགོས་པས་དེའི་རྗེས་སུ་གནས་པ་དང་།་",
    "ལེའུ་གཉིས་པར་མར་མེའི་དཔེ་ལ་སྦྱར་ནས་གསུངས་པ་ལྟར་ས་བོན་འགགས་པ་ལས་ཀྱང་རང་བཞིན་གྱིས་མྱུ་གུ་སྐྱེ་ན་མར་མེ་ཤི་བ་ལས་ཀྱང་མར་མེ་གཉིས་པ་སྐྱེ་བར་འགྱུར་ལ།",
    "ད་ནི་ཞེས་པ་ལ་སོགས་པ་སྟེ་དེ་ཡང་རང་བཞིན་དང་སྐྱེས་བུ་ལ་སོགས་པའི་ཐ་སྙད་ནི་གྲངས་ཅན་ལ་སོགས་པའི་མུ་སྟེགས་ཞུགས་པའི་དོན་ཡིན་ཏེ།",
    "དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་འདུག་སྟེ་སྐུ་གསུང་ཐུགས་ཡེ་ཤེས་སྦྱང་བ་ནས་བརྩམས་ཏེ།",
    "འདེབས་པའི་སྔགས་དང་འདུག་སྟངས།",
    "བེ་རོ་ཙ་ན།",
    "ཨོ་ལོ་ཙ་ནེ།",
    "སློབ་གཉི་གའི་ལག་པ་ས་ལ་མཉམ་དུ་ཕབ་ནས་འདུག་སྟངས་སོགས་སྔར་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ཏེ་ཤར་ནུབ་ཀྱི་ཚངས་ཐིག་གདབ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ན་སརྦ་ཨནྠ་སཱ་དྷ་ནེ་སྭཱཧཱ།",
    "རྟོགས་པ་ཁོང་གཉིས་མཐོ་བར་འདུག་གསུང་སྐད།",
    "བརྗོད་པར་བརྩམས་པ་ན་བརྣངས་ནས་ཐོན་གྱིན་མི་འདུག་གསུང་།",
    "ཅེས་བྱ་བ་སོགས་རྒྱ་ཆེར་གསུངས་འདུག་ཅིང་།",
    "དེའང་རང་ལ་མི་དགྱེས་པའི་ཚུལ་དུ་ཕ་མས་བུ་ལ་མི་དགའ་བའི་རྣམ་པ་བསྟན་པ་དང་འདྲ་མཛད་ན།",
    "གང་དོན་ལ་འདུག་པ་དེའི་ངོས་ནས་བསམས་ཏེ་གོམས་སུ་གཞུག་ན་ནམ་ཞིག་ཡོན་ཏན་འབའ་ཞིག་ཏུ་ཅིའི་ཕྱིར་འཆར་བར་མི་འགྱུར་ཏེ་ངེས་པར་འཆར་རིགས་པས།",
    "བོང་བུ་སོགས་སུའང་མཐོང་ཉེན་འདུག་པ་ལ་དེ་ལྟར་མ་མཐོང་བ་འདི་ཡང་སྟབས་ལེགས་སྙམ་པ་བྱེད་དགོས་གསུང་།",
    "ཐ་མལ་སྣང་ཞེན་མ་སྤངས་པས་ལན་པར་འདུག་སྙམ་དུ་བསྒོམ།",
    "དལ་བ་བརྒྱད་ཀ་རང་ཉིད་ལ་ཚང་ནས་འདུག་སྙམ་དུ་ངོས་ཟིན་པར་བྱའོ།",
    "གཞན་འབྱོར་ལྔ་ནི་དོད་ཐུབ་ཚང་ནས་འདུག་སྙམ་དུ་ངོས་ཟིན་པར་བྱའོ།",
    "ཕར་ཙམ་མི་འཆི་བས།",
    "སོས་དལ་བདེ་བར་འདུག་པ་ཇི་ལྟར་འོས།",
    "གཞན་ཡང་ན་ཚོད་གཞོན་པ་ལ་གདེངས་བཅོལ་ནས་ཕར་ཙམ་མི་འཆི་སྙམ་པ་འདུག་ན་ནི།་",
    "དེ་རིང་རང་ཡང་འཆི་ཉེན་གདའ་གསུང་།",
    "ལེགས་དམ་ཁཔར་བསམས་ན་འཇིགས་ཤིང་སྐྲག་པས་སྐད་ངན་འཆོར་དགོས་པའི་ཚོད་དུ་གདའ་གསུང་།",
    "དེ་བཞིན་དུ་ཞག་ཁ་ཡར་ལྟོ་མེད་པར་ཡང་འདུག་མི་ཚུགས་ན།",
    "བསྐྱེད་རྫོགས་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་བཟང་བོ་ཡང་སྐྱེ་བར་འདུག་སྟེ།",
    "བསྐྱེད་རྫོགས་ཀྱི་རྟོགས་པ་སྤྲུག་སྤྲིག་སྐྱེ་ཡིན་འདུག་སྟེ།",
    "གཞན་རྒྱུད་ལ་གྲུབ་ཟིན་དང་རང་རྒྱུད་ལ་འབྱུང་འགྱུར་གྱི་ཁྱད་པར་རོ།",
    "སྡིག་ཅན་འགའ་ཞིགཾ་བདེ་བས་ལྷག་པར་འཚོ་བ་མངོན་སུམ་ཚད་གྲུབ་ཏུ་འདུག་པ་འདི་ཅི་ཞིག་གུ་སྙམ་ན།",
    "གལ་ལ་འཐུག་དུས་གྲོགས་མེད་པའི་སྡུག་བསྔལ་ལོ།",
    "སྒྲ་ཚད་དང་ཐ་སྙད་ཁོ་རང་དག།",
    "ལྔ་པ་གལ་ལ་འཐུག་དུས་གྲོགས་མེད་པའི་སྡུག་བསྔལ་ནི།",
    "ཞེས་དང་པོར་སྐྱེས་དུས་ཀྱང་རང་གཅིག་པུར་སྐྱེས་ཐ་མར་འཆི་དུས་ཀྱང་རང་གཅིག་པུར་འཆི།",
    "བར་དུ་སྡུག་བསྔལ་མྱངས་དུས་ཀྱང་རང་གཅིག་པུས་མྱངས་དགོས་པས།",
    "གལ་ལ་འཐུག་དུས་གྲོགས་ཡོད་པ་མ་ཡིན་གསུང་ཏེ།",
    "བབ་ན་བཟོད་ཐབས་མི་འདུག་པས།",
    "འགྲོ་འདུག་སོགས་ལ་བརྟེན་པའི་བདེ་བ་སོགས་ཀྱང་དེ་དང་འདྲ་ལ།",
    "ཚེ་རབས་སྔོན་མ་རྣམས་སུའང་མ་བགྲང་ལས་འདས་པ་བྱས་པར་འདུག་སྙམ་དུ་ངེས་པ་མ་རྙེད་ཀྱི་བར་དུ་བསྒོམཾ།",
    "འདིས་བདག་ལ་ཐོག་མཐའ་བར་གསུམ་དུ་དྲིན་ཆེ་བར་འདུག་སྟེ།",
    "འདི་ལྟར་ཐོག་མར་མངལ་ན་འདུག་པའི་གནས་སྐབས་སུའང་བདག་ལ་གནོད་ཀྱིས་དོགས་ནས་སྤྱོད་ལམ་གཟོབ་ཅིང་།",
    "དོན་རང་ངོས་ནས་མི་འདུག་ཨང་སྙམ་པའི་ངེས་པ་ལྷང་པ་ཞིག་སྐྱེས་ན་དེའི་ཚེ་ལྟ་བ་ཐོག་མར་རྙེད་པ་ཡིན་གསུང་།",
    "དང་པོའི་ལས་ཅན་གྱིས་ཀྱང་རང་རྒྱུད་ལ།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ་དེ་ནི།",
    "ཚུལ་འདི་ཡང་རང་བཞིན་གྱི་རྟགས་ལས་ཏེ།",
    "ཕར་ཙམ་མི་འཆི་སྙམ་པའི་རྟག་འཛིན་འདིས།",
    "དེ་བཞིན་ཉིད་དང་རང་བྱུང་དང་།",
    "ཐ་ན་བསླབ་པ་སྣ་གཅིག་དུས་སྐད་ཅིག་མ་གཅིག་ཙམ་བསྲུངས་པ་ལའང་།",
    "ཡུལ་རང་རང་འདོད་པའི་དངོས་བསྒྱུར་ཏེ།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "ཕྱིས་ཉལ་བ་ན་སྔར་འཕེན་པ་བཏང་བ་ལྟར་བྱུང་འདུག་མི་འདུག་བརྟགས་ནས་འདུག་ན་དགའ་བ་དང་།",
    "སྡུག་ན་སྡུག་འཁྱག་པ་ཞིག་དགོས་གསུང་བར་གདའོ།",
    "ཡུལ་རང་རང་འདོད་པའི་དངོས་སྒྱུར་ཏེ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཞག་གཅིག་ལས་ལྷག་མི་སྡོད་ཅིང་།",
    "འཐས་པར་གནས་བ་ཁ་པའི་ས་མི་བརྐོ། གཞན་གྱིས་དུས་བཅད་ནས་མགྲོན་དུ་གཉེར་ན་དུས་དེ་ལས་ལྷག་མི་འདུག",
    "ཉེ་དུ་མིན་པའི་དགེ་སློང་མ་གྲོང་སོགས་སུ་འདུག་པ་ལས་ཟས་བླངས་ཏེ་མི་བཟའ།",
    "ཁྱིམ་པས་འདིར་འདུག་ཅེས་མ་བསྒོས་པར་མི་འདུག་དེར་འདུག་ཏུ་རུང་མི་རུང་མ་བརྟགས་པར་མི་འདུག་ལུས་ཀྱི་ལྗིད་ཕབ་ནས་མི་འདུགརྐང་པ་བསྣོལ་ནས་མི་འདུག་བརླ་བསྣོལ་ནས་མི་འདུག་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་ནས་མི་འདུག་རྐང་པ་ཁྲི་སོགས་ཀྱི་འོག་ཏུ་དགུག་ནས་མི་འདུག་རྐང་པ་སོ་སོར་བརྐྱངས་ཏེ་མི་འདུགའདོམ་སྣང་བར་བྱས་ནས་མི་འདུག་གོ།་",
    "འདུག་པ་ལ་འགྲེང་ནས་མི་བཤད།་",
    "ཉལ་བ་ལ་འདུག་སྟེ་མི་བཤད།",
    "སྟན་མཐོན་པོ་དང་བཟང་པོར་འདུག་པ་ལ་སྟན་དམའ་བ་དང་ངན་པར་འདུག་ནས་མི་བཤད།",
    "སྐྱེས་པ་དང་ནི་མཉམ་དུ་འདུག་པར་མི་བྱ་བ་དང་།",
    "དེའི་འོག་ཏུ་ལོ་རྫོགས་པ་ལ་ཟླ་བ་བཅུ་གཉིས་རྫོགས་དགོས་ཤིང་ལོ་མི་གནས་པས་རྒྱུན་ཐམས་ཅད་ཀྱང་རང་གྲུབ་པའི་དུས་ལས་དུས།",
    "སྤྱིར་སྐྱེ་འཇིག་དུས་གཅིག་པ་དང་དེའི་ནང་ནས་ཀྱང་ཡུལ་དུས་རང་བཞིན་དབྱེར་མི་ཕྱེད་པའི་ཚུལ་འདི་ཤིན་ཏུ་རྟོགས་དཀའ་བར་མངོན་ནོ།",
    "རི་བོ་ལས་སོགས་པའི་དངོས་པོ་འགའ་ཞིག་དུས་ནམ་ཡང་མི་འགྱུར་བར་ཧྲང་མངོན་སུམ་དུ་མཐོང་བཞིན་པ་འདི་ལྟར་རོ་སྙམ་ན།",
    "བསྟན་དར་ལྷ་རམས་པས་སྔར་ལྟར་གསུངས་པ་སོགས་ཀྱང་དོགས་པ་འདི་མ་ཆོད་པའི་རྣམ་འགྱུར་དུ་འདུག་པའི་ཕྱིར་རོ།",
    "གང་ལ་མི་རྟག་སོགས་སུ་གཏན་ལ་དབབ་པའི་གཞིའི་གཙོ་བོ་ཡང་རང་རྒྱུད་ཀྱིས་བསྡུས་པའི་ཟག་བཅས་ཉེར་ལེན་གྱི་ཕུང་པོ་ཉིད་ལ་བྱ་དགོས་ཤིང་།",
    "ད་དུང་ཡང་སྔར་ལས་ལྷག་ཙམ་ཞིག་མྱོང་མི་དགོས་པའི་ངེས་པ་ཅི་ཡང་མེད་པའི་སྐྱོན་ཆེན་པོ་འདི་ནི་མཐར་གཏུགས་ན་མི་རྟག་པ་མི་ཤེས་པའི་སྐྱོན་དུ་འདུག་པས།",
    "ཐ་ན་སྐད་ཅིག་སྔ་མའི་བདེ་བས་ཀྱང་ཕྱི་མར་ཕན་མི་ཐོགས་ན་གཞན་གྱིས་ལྟ་ཅི་སྨོས་པས་དེས་ན་སྐད་ཅིག་ཀྱང་མི་རྟག་ཅིང་མི་བརྟན་པའི་ཟག་བཅས་སྲིད་པའི་བདེ་བ་ལ་ཆགས་ཤིང་ཞེན་པ་ནི་བླུན་པ་བས་ཀྱང་ཆེས་བླུན་པར་འདུག་སྙམ་དུ་ནན་ཏན་གྱིས་བསྒོམ་དགོས་སོ།",
    "ཞེས་ཐག་བཅད་དེ་གསུངས་འདུག་པའི་ཕྱིར་རོ།"
  ]
}