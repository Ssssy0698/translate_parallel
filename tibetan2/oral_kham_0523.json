    "སྣང་ཆུང་ཅུང་ཟད་ཙམ་ཡང་བྱེད་ཕོད་ཀྱི་མི་འདུག་ཅེས་བཤད།",
    "རང་སྟོབས་རང་སྤེལ་ངང་ཐོན་སྐྱེད་བྱས་ཏེ་རང་ཕྱོགས་ཡོངས་ལ་རང་མཁོ་རང་སྤྲོད་བྱེད་ཐུབ་ཡོད།",
    "ཧུར་བརྩོན་ཆེ་ཤིང་རང་འགུལ་གྱིས་ཁྲིན་དབྱིས་དང་།",
    "གལ་སྲིད་ཁྱེད་ཚོས་ཁོ་ཚོར་བློ་འགུག་བྱེད་ཁག་པོ་བྱུང་ཚེ་ང་རང་ངོ་མ་འགྲོ་ཆོག་གང་ཐུབ་ཀྱིས་དྲག་པོ་ཐོག་ནས་ཐག་གཅོད་བྱེད་མི་དགོས་པ་བྱེད་རྒྱུ་དེ་གལ་ཆེན་པོ་ཡིན།",
    "ཁོང་རང་ནས་འབྲེལ་ཡོད་འགོ་ཁྲིད་རྣམས་ལ་སྙན་སེང་གནང་དོན།",
    "དེ་དག་ཕྱིར་འདོན་བྱས་ཡོད་འདུག་ཁོ་ཚོས་ནོར་འཁྲུལ་གྱི་ངང་ནས།",
    "ཅེས་བཏོན་འདུག་པ་དང་།",
    "༡༩༥༩ ལོའི་ཕྱི་ཟླ་༣ ནས་༡༩༦ ལོའི་ལོ་སྟོད་བར་དུ་མི་གྲངས་ཁྲི་བཅུ་ལྷག་ཙམ་ཕྱི་རྒྱལ་དུ་བྲོས་འདུག་ཅིང་།",
    "ཚབས་ཆེ་བའི་དཔོན་ཉམས་རིང་ལུགས་དང་རང་ཤེད་རིང་ལུགས་ཀྱི་རྐྱེན་པས།",
    "མཐར་༡༩༦༡ ལོར་ཞིང་ར་དེ་མེད་པ་བཟོས་ཏེ་ལྷག་ལུས་ཀྱི་གཞོན་ནུ་རྣམས་ཀྱང་རང་ཡུལ་དུ་ཕྱིར་ལོག་བྱས།",
    "དེ་བཞིན་ནག་མེད་ཉེས་འགེལ་གྱི་གྱོད་གཞི་མང་པོ་དེ་དག་དུས་ཡུན་རིང་པོར་ཡོ་བསྲང་མ་ཐུབ་པའི་རྒྱུ་རྐྱེན་ནི།",
    "ངས་ཁྱེད་ལ་ཐབས་ཤེས་ཤིག་ཞུས་ཆོག་གལ་སྲིད་ཁྱེད་རང་ལ་མི་འདོད་པ་དང་།",
    "རང་ཉིད་ཀྱིས་བཏོན་པའི་དགོངས་འཆར་ལ་ཧ་ཅང་མཐོང་ཆེན་བྱེད་ཀྱི་འདུག་དགོངས་ཡོད།",
    "ཁྱེད་རང་ནི་བློ་མཐུན་རྒན་གྲས་ཤིག་ཡིན་པ་དང་།",
    "མི་དམངས་ལ་ཕན་པའི་དངོས་ཡོད་ཀྱི་ལས་དོན་ཅི་ཡང་མི་སྒྲུབ་པའི་རིགས་ལ་གཡོན་ཕྱོགས་པ་ཟེར་གྱི་ཡོད་འདུག་ན།",
    "མི་གཞན་ལ་སྐྱོན་བརྗོད་བྱེད་དགོས་ཀྱི་ཡོད་པ་ལས་རང་སྐྱོན་རང་བརྗོད་བྱེད་ཀྱི་མི་འདུག་ཤེས་རབ་རྒྱ་མཚོ་མཆོག་ནས་མུ་མཐུད་གསུངས་དོན།",
    "ཡིན་ནའང་ཁྱེད་རང་རྒྱལ་གཅེས་པ་དང་།",
    "ད་ཆ་ལོ་ངོ་བཞི་ལྷག་ཙམ་ཕྱིན་འདུག་པ་དང་།",
    "གནས་བབ་ཡག་པོ་འདུག་ཅེས་པ་དང་།",
    "ཡིན་ནའང་ཁྱེད་རང་ནས་ཆབ་སྲིད་མཁྱེན་གྱི་མེད་པ་དང་།",
    "ཡིན་ནའང་ཁྱེད་རང་ནས་བསམ་བློ་གཏོང་དགོས་པ་ཞིག་ལ།",
    "དེ་ཡང་ཁོ་རང་ནས་འགོ་བྱས་ཏེ་བརྟག་དཔྱད་ཞིབ་འཇུག་བྱས།",
    "དེ་རིང་རང་ཉིད་ནས་ནོར་འཁྲུལ་གང་ཞིག་བྱུང་ཡོད་དམ།",
    "ཚིག་སྦྱོར་ཧ་ཅང་བདེ་བོ་ཆགས་འདུག་ཅེས་དགོངས་བཞིན་ཡོད།",
    "དགོངས་འཆར་གནང་དགོས་པ་ཡོངས་རྫོགས་ཁྱེད་རང་ནས་ཧ་ལམ་དབུ་ཁྲིད་ཚང་མར་དངོས་སུ་ཞུས་ཡོད་པ་དང་།",
    "ཁྱེད་རང་ནས་ཀྱང་མཁྱེན་གསལ་ལྟར།",
    "ཤར་ཕྱོགས་ཀྱི་ས་གཞིའི་མུ་མཐའ་བརྒལ་ཏེ་ཤར་ཡོད་འདུག་ཅེས་ལེགས་བརྗོད་བྱས་ཡོད་པ་དང་།",
    "མགོ་འདོགས་རིང་ལུགས་བྱེད་ཀྱི་འདུག་ཅེས་བཤད།",
    "དེར་བརྟེན་ཁྱེད་རང་གནས་སྐབས་རིང་རང་ཤག་ཏུ་ཕེབས་མི་ཆོག་པ་དང་།",
    "པཎ་ཆེན་གྱི་བློ་སྟོབས་ལ་བསྔགས་བརྗོད་ཞུས་ཤིང་བསམ་བློའི་ཆུ་ཚད་ཀྱང་མཐོ་བོ་འདུག་ཅེས་བཤད།",
    "ཁྱེད་རང་སྐྲག་མི་དགོས།",
    "གཞན་ཕན་བསྒྲུབ་རྒྱུ་དང་རང་སེམས་འདུལ་རྒྱུ་དེ་རང་ཡིན་པ་ལྟར།",
    "ག་དུས་ཡིན་ནའང་མེས་རྒྱལ་གཅིག་གྱུར་དང་།",
    "དེའང་ང་རང་ངོ་མས་བཟོ་བཅོས་བྱས་པ་ཡིན།",
    "༣ ཐོག་བཞེངས་ནས་ཡག་པོ་ཞེ་དྲག་འདུག་ཅེས་གསུངས་ཤིང་།",
    "གོ་རོ་ཙ་ན།",
    "ལོ་ཟླ་ཞག་དུས་མ་འགོར་བར་ ད་ལྟ་ཉིད་དུ་ཁུག་ལ་ཤོག།",
    "༧རྒྱལ་བ་གཉིས་པ་སྲས་ཀྱི་ཐུ་བོ་དང་བཅས་པའི་འཕྲིན་ལས་ཀྱི་ཞབས་འདེགས་སུ་འགྱུར་བ་བྱུང་འདུག་པས་བཀའ་དྲིན་རྨད་དུ་གྱུར།",
    "བདེན་པ་༢ ལྟ་བུ་གསལ་ལ་མི་གསལ་མང་པོ་བྲིས་འདུག་དེ་དག་ལ་ཞིབ་ཏུ་བལྟས་པས་སྔ་མ་ནི།",
    "ངོས་ཀྱང་སུམ་པ་ཞབས་དྲུང་རྒྱ་ནག་པ་བློ་བཟང་བསྟན་པའི་རྒྱལ་མཚན་པའི་སྐུ་སྐྱེས་ཀྱི་གོ་སར་འདུག་དགོས་བྱུང་བ་འདི་ལ་སྐྱེས་རི་དྭགས་རྒྱལ་པོར་འཁོད་པ་དང་མཚུངས་ལ།",
    "ཚུར་མཐོང་རང་མདངས་གཤིས་ངོམ་རྔ་གོག་ལ།",
    "༢ ༡༥ ང་རང་སྐྱེས་པའི་ཁྱིམ་དེ་ཡང་སྔོན་གྱི་ཉེ་རྒྱལ་གྱིས།",
    "མཚོ་སྔོན་དུ་ཐོན་ཚེ་དཔོན་རྣམས་ནང་འཁྲུགས་བྱུང་འདུག་པས་དེའི་གཏམ་དགོན་ལུང་ནས་ཐོས་ན་འགྲོར་མི་འཇུག་གོ།",
    "དེའི་ཁྲོད་དུ་བདག་ལས་ཐ་ཤལ་གཅིག་ཀྱང་མི་འདུག་སྙམ་ནས་བག་འཁུམ།",
    "ཞལ་འཛུམ་པ་དང་བཅས་བཞིན་དུ་ཨ་ཙ་མ་བདེན་པར་འདུག་ཡར་ལ་ཤོག་གསུངས་ནས་གྲལ་མགོར་བཞག་ནས་གསོལ་ཕོར་ཞོས་གང་བ་གནང་སྟེ་ངའི་ཕོར་བ་དེའི་ནང་ནས་འཐུང་གསུངས།",
    "ནམ་མཁའ་དང་ལག་མཐིལ་མཉམ་རློམ་ལས་མ་འདས་པས་གཞན་བློ་གསལ་བ་ཆུང་ངུ་ཡན་ཆད་རྣམས་ཀྱི་བཞད་གད་ཡུལ་དང་རང་ངོ་ཚ་བའི་གནས་སོ་སྙམ་སྟེ།",
    "དེའི་རྗེས་སུ་ཁོ་བོ་ལ་རྒྱུ་ཆས་དར་ཁ་གང་ཙམ་ཡང་མེད་པར་ཆས་ཀས་བཀྲེན་ནས་ཕོགས་ཙམ་ལ་བརྟེན་ནས་འདུག་དགོས་བྱུང་ཡང་།",
    "དེ་ལྟའི་བསླབ་སྦྱང་ཅུང་ཟད་བགྱིས་པ་ལ་བརྟེན་ནས་རང་སེམས་མཚོ་ཆུང་ཚིམ་པའི་རྦ་རླབས་ནམ་མཁའི་མཐོངས་སུ་འཕྱོ་བའི་ན་བུན་ལས་རངས་པ་ལས་ཀྱང་རངས་པའི་ཁ་དོག་ལྔ་ལྡན་གཞའ་ཚོན་རབ་མཛེས་བདག་རྒྱུད་བྱ་ལམ་ལྷག་པར་བརྒྱན་པར་གྱུར་པ་ལས་གཞན་དུ་ཅི།",
    "ཞེས་གསུངས་འདུག་པས་འདི་འདྲ་སྐལ་བ་བཟང་ངོ་སྙམ་ནས་ཁྲིད་བྱེད་པར་སེམས་ཀྱིས་ཐག་བཅད།",
    "དགྲ་གཉེན་བར་མ་རྒན་གཞོན་ཉིན་ཤི་མཚན་ཤི་མཐོང་ཐོས་རྒྱུན་མི་ཆད་ཀྱང་རང་ཉིད་འཆི་སྙམ་པ་རྨི་ལམ་དུའང་མེད་པ་དང་།",
    "དེར་འདུག་རིང་ལ།",
    "ཕྱི་ཉིན་བལྟས་པས་སྒོ་ལྕགས་ཤོག་གུ་སྔར་བཞིན་ཡོད་ཀྱང་ཁོ་རང་གནས་སུ་སླེབས་ཡོད་པ་གོ་ནས་དཔོན་པོས་དེ་ལ་དད་དེ་བཟའ་བཏུང་སོགས་བསྐྱལ་བཅུག་ཕྱིས་སུ་ང་ལ་འཕྲད་དུས་ཤིག་ལ་མིག་ནས་མཆི་མ་འདོན་ཞིང་དགའ་སྤྲོ་དཔག་མེད་བྱེད་པར་སྣང་ངོ།",
    "འདུག་ས་ཇ་སག་དང་མཉམ་པར་བྱས།",
    "དེ་ཡང་ལུས་ཀྱི་ཆ་ཤས་སོ་སོས་ལྷ་མི་དྲི་ཟ་ལྷ་མིན་མཁའ་ལྡིང་གནོད་སྦྱིན་མི་མིན་སོ་སོའི་སྒྲ་དང་སྐད་དང་རྣམ་འགྱུར་རང་རང་དང་མཐུན་པར་གླུ་གར་ཟློས་པས་ངོ་མཚར་བའི་སྒྲུང་འཆད་དེ།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཡུལ་དེར་གཏན་ཏུ་འདུག་པ་ལ་ས་ཆུ་ལེགས་པ་ཞིག་མེད་མི་རུང་དུ་གདའ་བསམ་ནས།",
    "ང་རང་དབུས་ན་ཡོད་དུས་སུ་ཐབ་གཡོག་པ་ན་རྐྱེན་གྱིས་དཔལ་ལྡན་རྒྱུད་སྨད་ལ་འགྲོ་མ་ཐུབ་ཀྱང་།",
    "གཞན་ཡང་ཡིད་གཞུང་བ་བག་མེད་པའི་སྤྱོད་པ་རིང་དུ་དོར་ལ་ཡ་རབས་ཀྱི་ངང་ཚུལ་ལྡན་པ་དང་བློ་འཛིན་དྲན་པ་དང་དཔྱོད་བྱེད་ཤེས་རབ་ཕུལ་དུ་བྱུང་བ་ཞིག་འདུག་དེ་རིམ་གྱིས་བསྐྱངས་པས་ལུས་དང་ཡོན་ཏན་ཆབས་ཅིག་ཏུ་རླན་ཅན་ནགས་ཀྱི་ཙན་དན་དང་དཔྱིད་ཀྱི་མྱུ་གུ་ཇི་བཞིན་དུ་ཡར་བསྐྱེད་བྱུང་།",
    "དེ་ནས་ཕྱིར་ལོག་ནས་དགོན་ལུང་དུ་ཐོན་པ་ན་ཡུལ་དེར་ཐན་པ་ཆེན་པོ་བྱུང་འདུག་པ་ལ་ཆར་འབེབས་བྱས་པས་ཉིན་གསུམ་ནས་འདོད་འཇོར་བབས་པས་ལོ་ཏོག་ཤིན་ཏུ་སྨིན་ནས་ཕལ་མང་མུ་གེའི་འཇིགས་པ་ལས་བསྐྱབས།",
    "མཐོང་ནས་དྲུང་དུ་སླེབས་ཙ་ན།",
    "དེ་ལྟར་ན་དྲག་པོའི་སྦྱིན་སྲེག་ཟོར་འཕེན་དྲག་གཅོད་སོགས་བགྱིད་པ་ལ་འདྲེ་གདོན་ལ་འཕྲལ་དུ་གནོད་ཀྱང་ཕུགས་སུ་ཕན་པ་སྒྲུབ་ནུས་ཤིང་རང་ལ་མི་གནོད་པ་དང་།",
    "དེར་ཐན་པ་ཆེན་པོ་བྱུང་འདུག་པ་ལ།",
    "དེས་ན་འདིར་དེའི་ཚིག་སྤྱི་ལའང་བག་ཆགས་ཅུང་ཟད་བཞག་པ་ཡང་རང་ལུས་དུ་མར་སྤྲུལ་ཏེ་རབ་འབྱམས་ཞིང་དུ་འབད་པས་བཙལ་ཡང་རྙེད་པ་སྲིད་མཐའ་རུ་ཟད་པར་སེམས།",
    "རང་རང་གནས་བྲོས་ཡིད་ནོར་རྒྱ་མཚོའི་གཏིང་།",
    "དེའི་ཚེ་ཨ་ལ་ཤ་ནས་ཕྱེད་འཛིན་དང་མཁར་སྔོན་ནས་རིལ་སྒྲིབ་བྱུང་ནས་སྐར་མ་ཐམས་ཅད་མཐོང་ཞིང་སྒྲོན་མེ་སྦར་དགོས་བྱུང་འདུག་པས།",
    "སྔར་གྱི་གཙོ་བོས་ཀྱང་སྔོན་འདས་བསྙེལ་ཚུལ་གྱིས་བསུ་མི་བཏང་སྟེ་ནང་དུ་གདན་ཁྲི་བཞག་ནས་ལུང་ཞུ་བྱས་རབ་སྟོན་བྱིན་པ་མཐོང་ཐོས་ཀྱིས་ཁོ་རང་ཕན་ཚུན་སྔར་རྟ་གཡག་འཐབ་འདྲ་ད་དུས་མཐུན་འདུག་སྙམ་ནས།",
    "དེར་འདུག་རིང་ལ་གཞི་ལེན་ཞབས་ཏོག་ཕུན་སུམ་ཚོགས་པ་མཛད།",
    "ཞལ་སློབ་ཚུལ་གྱིས་རང་རང་ཡོངས་འཛིན་བསླུས།",
    "ཙ་ན་ཀའི་རྒྱལ་པོས།",
    "དེའི་ཚེ་ན་གསུང་འཕྲོས་ཀྱི་ལྷོངས་ལ་ངེད་ཅག་ད་ལམ་འདིར་འདུག་ཡུན་ཐུང་བས་ལོ་ཕྱི་མ་ཞིག་ལ་རི་བོ་རྩེ་ལྔར་འོངས་ནས་ཟླ་ཤས་འདུག་དགོས་ཞེས་སྔ་ཕྱིར་ལན་གཉིས་གསུངས།",
    "དེ་ནས་ངེད་འདུག་པའི་ལྷ་ཁང་དུ་ཡོང་འཕྲལ་ལ།",
    "ཚེ་འདིར་ཡང་ཐོས་བསམ་སྒོམ་དང་འཆད་རྩོམ་རྩོམ་པས་བསྟན་རྒྱུན་ལ་ཕན་པ་བསྒྲུབ་པ་དང་རང་གཞན་གྱི་དོན་ངོ་མཚར་མ་ཅན་འདི་དང་འདི་བགྱིས་ཞེས་པ་ཉིན་སྐར་གྱི་མཆེད་ཟླ་ཡིན་ཞིང་།",
    "བ་ལང་ཡ་སོ་ཅན་གང་རང་མཚང་ངོམ།",
    "ཁྱེད་རང་དེར་དེང་སང་ཉམས་དམའ་དུས་མ་བྱོན་ན་དམ་པའི་ཚུལ་ལུགས་དང་མི་འགལ་ལམ།",
    "བསྟན་པའི་གཏད་རབས་བདུན་གྱི་ཕྱི་མ་རྣམས་ཀྱི་དུས་དང་ས་ར་ཧ་དང་ཤིང་རྟ་ཆེན་པོ་དག་མ་བྱོན་པའི་བར་དེར་དགྲ་བཅོམ་པའི་འབྲས་བུ་མངོན་དུ་བྱས་པ་གྲངས་མེད་བྱོན་འདུག་པས།",
    "རྒྱལ་པོ་ཙ་ན་ཀས།",
    "ཐེག་ཆེན་སངས་འཕགས་བྱང་སེམས་འབྲིང་རང་རྒྱལ།",
    "བདག་སོགས་འགྲོ་ཀུན་རང་རང་དུས་གསུམ་དགེ་ཚོགས་མཐུས།",
    "དེའི་རྗེས་སུ་ས་ག་ཟླ་བར་རང་དང་རང་ལ་ལྟོས་པའི་འཁོར་དང་བཅས་པའི་གནས་སྐབས་ཀྱི་ཚེ་འཕེལ་བ་དང་བསགས་སྦྱོང་མཆོག་ཏུ་འགྱུར་བ་དང་།",
    "དེནས་རི་ཁྲོད་དུ་འདུག་སྐབས་སུ་ཟླ་༡ཚེས་༢ ༣ ཐོ་རངས་རྨི་ལམ་དུ་ཤོག་གུ་དམར་པོ་གསུམ་ཡི་གེ་ཅན་གསུམ་གྱི་གཅིག་ན།",
    "ང་རང་ངོས་ནས་གྲུབ་པར་སྣང་བ་གཏན་ནས་མེད་པར་བློར་ཤར་བ་ན།",
    "ཁྱེད་རང་ཕྱོགས་དེར་བྱོན་ནས་ཆར་འབེབ་མཛད་དགོས་ལགས་ཞེས་ནན་ཏན་ཆེན་པོ་བྱེད་ཀྱང་།",
    "དགའ་ལྡན་ནས་དགེ་སློང་བགྲེས་པོ་གཉིས་བྱོན་འདུག་པས་བཞུགས་མལ་གྱི་གདན་བཤམ་པ་དང་བཞེས་སྤྲོ་བཟའ་བཅས་གང་ལེགས་ཞུ།",
    "༥ ༡ལྷག་དུས་༤ནོར་རྙེད་བསམ་འགྲུབ་བདེ་བ་ལྡན།",
    "༦ ༡ ལྷག་དུས་༤ཁེ་འཐོབ་མང་རྙེད་ཕྱུག་འཕེལ་རྒྱལ།",
    "ཞེས་གསུངས་གདའ་བས།",
    "ཆགས་སྡང་རང་ལོག་ངོ་མཚར་ཆེ།",
