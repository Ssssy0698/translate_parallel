    "ཟླ་བའི་ཁད་དང་ཤིན་ཏུ་ཉེ་བོ་འདུག།",
    "གཤིས་རྒྱུད་དར་ལས་འཇམ་པའི་ཨ་ཇོ་དེ།",
    "ཨ་ཇོའི་གདོང་བ་གཅིག་པུ་ཇི་ལྟར་རྙེད།",
    "ཐ་ན་ཨ་ཇོའི་མིང་ཡང་མི་ཤེས་ན།",
    "ལམ་ནས་ལས་ཀྱིས་འཕྲད་པའི་ཨ་ཇོ་དེས།",
    "ཕུར་ལོ་གྱོན་པའི་ཨ་ཇོ་འདི་དག་ནི།",
    "མྱུར་དུ་དེ་ཉིད་སྒྲུབ་ལ་ཆས་དགོས་འདུག།",
    "ཨ་ཇོ་དེ་ནི་བག་ཕེབས་ངང་ནས་ཙོག།",
    "ཨ་ཇོ་དེ་ཡི་མིག་ལ་མཚར་བ་བྱིན།",
    "ཨ་ཇོ་དེ་ཡིས་གནས་ཚང་ཐེངས་ཤིག་གཡར།",
    "ཨ་ཇོའི་མིང་ཙམ་མ་དྲིས་ཕངས་པ་ལ།",
    "འཁོར་ལོའི་འགྲོས་ལས་ཨ་ཇོ་ཕྱི་ལ་བསྐྱུར།",
    "ཨ་ཇོ་དེ་ལ་དྲིན་ལན་བསབས་པའི་ཕྱིར།",
    "རང་རང་གནས་སུ་ངལ་གསོར་བསྟེན་ན་ཡང་།",
    "སེམས་ཀྱི་འཇིག་རྟེན་རང་རང་སོ་སོ་ཉིད།",
    "ཨ་ཙི་གཟུགས་མེད་རྣམས་ཀྱི་ཆོ་འཕྲུལ་མིན།",
    "གར་ལྷགས་གར་འདུག་ད་ལྟ་མི་ཤེས་པས།",
    "རང་རང་གར་འགྲོའི་གནས་སུ་ངར་ཤུགས་ཀྱིས།",
    "རང་རང་གནས་སུ་བདེ་བར་བསྡད་དང་ལྷན།",
    "ད་གཟོད་ཨ་ཇོ་དེ་ཡི་འབོད་སྐད་ཐོས།",
    "ཐ་མར་གནས་ཚང་ཨ་ཇོའི་ཁྱིམ་དུ་བཅོས།",
    "ཨ་ཇོའི་ཁྱིམ་ནས་གནས་ཚང་གཡར་བ་ནས།",
    "འདི་ཉིད་བསམ་ན་ཁོ་ཚོ་འབྲལ་དགོས་འདུག།",
    "ཕྱི་ལ་སྒམ་ཚུགས་ཆེ་བའི་ཨ་ཇོ་འདི།",
    "བན་ཕྲུག་བློ་བཟང་རྒྱ་མཚོས་ཁོ་རང་ཟུང་ལ་ཅེར།",
    "ཁོ་རང་གཉིས་ནི་ཕུར་བ་བཙུགས་པ་བཞིན།",
    "བུ་ཆུང་རང་བུ་ཉིད་དང་ཁྱད་པར་མེད།",
    "བུ་ཆུང་རང་ལོ་ལྔ་ལ་སླེབས་པའི་དུས།",
    "གཞན་གྱི་བུ་དང་མི་འདྲ་ཆ་གཅིག་འདུག།",
    "རྒྱབ་རིའི་མགོ་ནས་ཙོག་པུས་འདུག་སྟངས་ལ་བལྟས་ན།",
    "རྒྱབ་རིའི་སྟེང་ལ་རྒོད་ལྟར་བབས་པའི་ཁོ་རང་ཟུང་།",
    "ག་དུས་ཡིན་ཡང་གོམ་མཚམས་མི་འཇོག་ངེས་པ་བྲལ།",
    "སྔོན་དུས་མ་མཐོང་ཁོ་རང་དག་ཚོ་ཡ་མཚན་འཛིན།",
    "རང་རང་ལུས་ལ་སྙོབ་ཙམ་བྱས་ཏེ་དེ་དག་ནི།",
    "བུ་ཆུང་གར་འདུག་ལུང་བསྟན་ཞུ་རུ་བསྐྱོད་ན་ཡང་།",
    "ཁོ་རང་གཉིས་ཀྱིས་སོ་སོས་མགོ་བོ་ཐད་དུ་གཡུགས།",
    "སྒོ་ཕྱིའི་བར་ན་ཅི་ཞིག་ལས་ལ་བྲེལ་བཞིན་གདའ།",
    "ཐོ་ཡོར་དང་མཚུངས་རང་རང་གནས་སུ་ཧད་དེ་འདུག།",
    "ཕ་དང་བུ་ངོ་ག་དུས་ཤིག་ལ་འཕྲོད་དམ་ཅི།",
    "ང་རང་རྒྱུན་དུ་བྱ་བཟང་བསྒྲུབ་རྒྱུར་དགའ་པོ་ཡོད།",
    "ཇ་ཕོར་པ་གང་འཐུང་འདོད་འདུག་ཅེས་བརྗོད།",
    "འོན་ཀྱང་ད་ལྟ་ལས་ཀ་མང་པོ་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད་པ་གསལ་པོར་དྲན་གྱི་ཡོད།",
    "ལོ་ལྔའི་རིང་རང་ཁྱིམ་དང་བར་ཐག་སྤྱི་ལེ་ལས་མེད་རུང་ཁྱིམ་དུ་ལོག་ཁོམ་མ་བྱུང་ཞིང་།",
    "ལྕགས་ལམ་མཉམ་སྲུང་ལས་ཀའི་འགན་འཁུར་བ་ཞིག་ཡིན་པའི་ངོས་ནས་ལས་གནས་དེའི་ཐོག་དུས་ཡུན་རིང་པོ་ལེགས་སྐྱེས་འབུལ་དགོས་ལ་དཀའ་ཚེགས་ཆེ་བའི་ལས་དོན་དེ་བས་མང་བ་སྒྲུབ་དགོས་པ་མཚོན་གྱི་ཡོད།",
    "ཐོག་འབབ་ཏུ་ལྷུང་བས་གཡོ་ཅན་སྡིག་ཏོ་ཅན་ཁོ་རང་དང་དེ་ཡི་ཕྱོགས་སུ་གཏོགས་པ་ཐམས་ཅད།",
    "དེ་ལྟར་རང་རང་རྗེས་ཕུལ་བས།",
    "ཀུན་གྱི་གསེབ་ན་འདུག་པ་རྨི།",
    "ཨོཾ་རུ་ལུ་མུ་ལུ་ཙ་ན་ཏི་སྭཱ་ཧཱ།",
    "སྔགས་ལ་འདྲ་མིན་འདུག་པས་བྲིས་བ་ལགས་སོ།",
    "དེ་ལྟར་ཁྱེད་རང་ཕྱག་ན་རྡོ་རྗེའི་ང་རྒྱལ་དུ་གནས་པའི་བདུན་དུ་བློ་ལས་ཞེས་སོགས་ནས།",
    "ཁྱེད་རང་རྣམས་བཅོམ་ལྡན་འདས་སུ་གསལ་བའི་ཕྱག་གཡས་ཀྱི་རྡོ་རྗེ་ལས་རྡོ་རྗེ་ཐོག་ལྟ་བུ་ཕྱོགས་བཅུར་སྤྲོས།",
    "ཇོ་བོའི་ཞལ་ནས་སྔགས་འདི་མ་ཆག་ན་སྐྱིད་དར་ཡོང་འདུག་གསུངས་སོ།",
    "པཎྜི་ཏ་ཆེན་པོ་དཱི་པཾ་ཀ་ར་ཤྲཱི་ཛྙཱ་ནས་པོ་ཏ་ལའི་འགྲམ་ནས་ཕར་བྱོན་པས་མི་ཞིག་འཆི་ཞིང་གདའ་སྐད།",
    "ཉམས་སུ་ལེན་པའི་མི་ཡོད་ན་ཚེ་འདིའི་དབུལ་བ་སེལ་བར་འདུག་གསུངས་སོ།",
    "འདིར་ཛམྦྷ་ལ་དཀར་པོ་བསྒྲུབ་པར་འདོད་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རང་རྟེན་ལ་ཁ་ཕྱོགས་པར་འདུག་ལ།",
    "ད་རྗེས་གནང་དངོས་ལ་སྔོན་དུ་སློབ་དཔོན་གྱི་བྱ་བ་རྣམས་གྲུབ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ།",
    "ཁྱེད་རང་མརྣམས་ཀྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་མི་དམིགས་ཏེ་སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་ཛམྦྷ་ལ་དཀར་པོ་ཞེས་སོགས་བསྐྱེད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཡང་ཁྱེད་རང་རྣམས་པདྨ་མཁའ་འགྲོ་མར་གསལ་བ་སོགས།",
    "ཁྱེད་རང་རྣམས་ལས་ཀྱི་ཊཱ་ཀི་མར་གསལ་བ་སོགས་དང་།",
    "སྦྲེལ་བའི་ཚེ་བྲི་བའི་སྐབས་ཇི་ལྟ་བ་བཞིན་དགོས་པ་ལྟ་བུར་འདུག་ཀྱང་།",
    "བསམ་གཏན་གནས་ལ་འདུག་ལ་དབུལ།",
    "མན་ངག་ཉིད་ཡིན་ཏེ་འདུག་ས་བཙན་པར་བྱས་ན་བདེ་གསུངས།",
    "དེ་ནས་རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཛ་དམར་དུ་གསལ་བའི་དཔྲལ་བའི་ཨོ་དཀར་པོ་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཨ་ལས་ཟླ་བ་ཞེས་པ་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་བཞུགས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་སློབ་དཔོན་ལ་མེ་ཏོག་འཐོར་ཞིང་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་ཛམ་དམར་དུ་གསལ་བའི་དཔྲལ་བའི་ཨོ་དཀར་པོ་ལ་ཐིམ་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པའི་ཨལ་ཐིམ་པས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱང་ཧཱུྃ་ལས་འཕགས་པ་ཛམྦྷ་ལ།",
