    "དེའི་ཐོག་སྒྲུང་བ་རང་རང་གེ་སར་སྒྲུང་ལ་དགའ་བའམ།",
    "གཞན་ལག་བྲིས་མ་དང་སྒྲུང་བ་སོ་སོས་ཉར་ཚགས་བྱེད་བཞིན་པ་ནི་འདི་ལས་ཀྱང་མང་ཙམ་དུ་གདའ་འོ།",
    "ཚུར་ལ་ཧུབ་ཅིང་འཐུང་ཙ་ན།",
    "ས་ལ་བུ་ཡུག་གཉིས་ཀྱིས་གཡོགས་ནས་འདུག་པས།",
    "ལ་ཆུང་ལ་གོམ་ཆུང་བརྒྱབ་ནས་ཕེབས་པར་གདའ་ཞེས་བྱ་བ་དང་།",
    "རང་རང་ཆུ་ཚོད་མན་ཆད་དུ།",
    "རང་ལ་ཡིད་རྟོན་ཡོད་ན་བྱ་བ་ཆེ་ཆུང་གང་ཡིན་ཡང་རུང་རང་ཉིད་ཀྱིས་སྒྲུབ་པར་འོས་འཚམས་ཡོད།",
    "བྱ་བ་ཆེ་ཆུང་གང་ཞིག་བསྒྲུབ་ཀྱང་རང་རྟོན་མེད་པར་སོམ་ཉི་དང་།",
    "མི་གཞན་གྱིས་རང་ལ་ཡིད་སྨོན་འཆོར་བར་ཡང་རང་རྟོན་དགོས།",
    "ཡང་དག་པ་གང་ཞིག་ཡིན་པའི་ཐག་གཅོད་ཀྱང་རང་ཉིད་ཁོ་ནས་བྱེད་དགོས་པ་ལས།",
    "བྱང་སེམས་ཁོ་ཁོ་རང་ལས་སྐྱེས་པར་འདོད་པའི་གང་ཟག་ཡིན་པའི་ཕྱིར།",
    "དེ་བས་ཀྱང་དཔྱད་གཞི་གཅིག་འདུག་སྟེ།",
    "གཞན་ཡང་རང་ཤ་བཅད་དེ་སྦྱིན་པ་བཏང་དགོས་པ་ལ་དེ་འདྲའི་མཉམ་བཞག་པ་ལ་དེའང་མེད་པའི་ཕྱིར།",
    "ང་སྐྱབབ་པསྐབས་འདིར་ཡང་རང་སྐྱ་ཐུབ་པའི་རྫས་ཡོད་ལྷན་སྐྱེས་གཅིག་འདོད་པའི་ཕྱིར་ན་མ་ཁྱབ།",
    "འདིའི་ཕྲ་རགས་གཉིས་ཀ་ལ་བདེན་བཞི་རང་རང་ཡིན་མིན་གཉིས་ཡོད་ཅེས་པས་སོ།",
    "སློབ་དཔོན་འདི་ས་བརྒྱད་པའི་བར་ཆད་མེད་ལམ་ལ་གནས་བཞིན་པའི་ཚེ་དེའི་ལུས་གཅིག་དགའ་ལྡན་དུ་འདུག་ལུས་གཅིག་མིའི་ལུས་སུ་གནས་པ་ཡིན་ནམ་སྟེ།",
    "ཡོད་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་ཁྱད་ཕྱེད་པའི་གང་ཟག་ཡིན་པའི་ཕྱིར།",
    "གནོད་མེད་ཀྱི་དོན་ཡང་རང་མཚན་སྣང་བ་ལ་གནོད་པ་མེད་ཅིང་།",
    "དེའང་འདོད་སྙམ་པར་འདུག་སྟེ།",
    "གཞན་ཡང་མཐའ་མེད་པའི་དཔྱད་ཚུལ་མང་ཞིང་རང་རྒྱུད་པའི་ལུགས་ལྟར་དུ་འཛིན་ཤེས་པ་ཞིག་བྱུང་ན་རང་རྒྱུད་པའི་ལུགས་སུ་ལེགས་པའི་ཚོགས་ཕྱོགས་གཅིག་ཏུ་བསྡུ་ངེས་པར་སེམས་སོ།",
    "ཁོ་ཁོ་རང་ལས་སྐྱེས་པའི་མྱུ་གུ་ཞིག་མི་སྲིད་པར་འདོད་དེ།",
    "དེས་ན་མྱུ་གུ་གསལ་བ་དེའང་རང་རྒྱུའི་དུས་སུ་ཡོད་པར་ཁས་བླངས་ཡོད་པས་མྱུ་གུའི་རྒྱུའི་རང་དུས་སུ་མྱུ་གུ་གསལ་བར་གྲུབ་པ་རང་ཉིད་ཀྱིས་ཁས་བླངས་པ་ཡིན་པའི་ཕྱིར། ་དེས་ན་མྱུ་གུ་སྐྱེ་བ་དོན་མེད་ཁོ་ནར་གནས་ཏེ།",
    "ཡང་ན་དེའི་ལུགས་ལ་གསལ་བའི་མྱུ་གུ་རདེ་རྒྱུ་དུས་ན་ཡོད་པའི་མྱུ་གུ་དེ་ལས་སྐྱེས་པ་ཡིན་ཀྱང་མྱུ་གུ་ཁོ་ཁོ་རང་ལས་སྐྱེས་པ་ཡིན་མི་དགོས་སྙམ་ན་དེའང་འཐད་པར་མི་འཛིན་ཏེ།",
    "མྱུ་གུ་དེ་རང་རྒྱུའི་དུས་སུ་ཡོད་ཀྱང་རང་རྒྱུ་ས་བོན་དེ་མིན་དེའི་རྒྱུ་སྤྱི་དེའང་མིན་པའི་ཕྱིར་ཟེར་བའང་མི་འཐད་པར་དེས་ནས",
    "ཁ་ཅིག་༣གཞན་སྐྱེའི་དོན་དེ་ལྟར་ཡིན་ན་དོགས་པ་ཆེ་བར་འདུག་ཀྱང་དེ་མིན་ནན་ནམ་སྙམ་ཟེར་བ་ཤིན་ཏུ་མི་འཐད་དེ།",
    "དེས་ན་དེའི་དམ་བཅའ་བཟློག་མི་དགོས་པར་འདྲའོ་ཞེ་ན་དཔྱད་གཞི་ཞིག་འདུག་ཀྱང་བརྟག་ན་དགོས་དོན་ཆེའོ།་",
    "མྱུ་གུ་དེ་རང་དང་བདག་ཉིད་གཅིག་པའི་རྒྱུ་ལས་སྐྱེ་བ་ལ་བྱེད་དམ་མྱུ་གུ་དེ་ཁོ་ཁོ་རང་ལས་སྐྱེ་བ་ལ་བྱེད།",
    "ཁོ་ཁོ་རང་ལས་སྐྱེས་པ་མི་འདོད་པའི་ཕྱིར་ན་དཔྱད་གཞི་ཞིག་སྣང་ངོ།",
    "ཞེས་པའང་རང་རྒྱུད་པ་སྤྱིའི་འདོད་པ་ཡིན་ནམ་དཔྱད་པར་བྱ་དགོས་སོ།་",
    "དེའི་སྔ་རྒོལ་ཡིན་ནའང་རང་རྒྱུད་པ་ཡིན་པས་ཁྱབ་པ་མེད་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་བར་ཆད་མེད་ལམ་ལའང་རང་འཇོག་བྱེད་ཀྱི་བློའི་གཙོ་བོ་གང་འཇོག་སོགས་ངོས་བཟུང་ནས་དཔྱད་པར་བྱའོ།",
    "ཤུགས་རྟོགས་ཀྱི་ཐ་སྙད་འཇོག་མི་དགོས་ཀྱང་རང་ཉིད་ལ་རང་ཉིད་མི་སྣང་བར་རརྟོགས་དགོས་པའོ།",
    "དེ་དག་གང་ཡིན་ཀྱང་རང་དུས་ལ་ལྟོས་ནས་ད་ལྟ་བ་མིན་པ་གཅིག་མེད་པའི་ཕྱིར།",
    "པསྔར་དམུག་པའི་ཚེ་དུག་ཞུགས་པར་འདུག་བ་གསལ་སྙམ་པའི་དྲན་ཤེས་སྐྱེས་པ་ལྟ་བུ་ཡིན་པའི་ཕྱིར།",
    "འོ་ན་ཐ་སྙད་ཕྲ་རགས་གཉིས་ཀྱི་གང་རང་ལུགས་ལ་ཁས་ལེན་ཞེ་ན།",
    "ང་ཡི་བ་རང་མཚན་གྱིས་གྲུབ་པར་འཛིན་པའི་བློ་ལྟ་བུ་དང་བོ་དང་གཞན་རྒྱུད་ཀྱི་ང་རང་མཚན་གྱིས་གྲུབ་པར་འཛིན་པའི་བློ་ལྟ་བུ་གཉིས་པ་དང་།",
    "མཐའ་རང་རྒྱུད་ཀྱི་ང་ལ་དམིགས་ནས་ང་དང་ང་ཡི་བ་གང་རུང་རང་དཔྱོད་ཐུང་ངུ་ལས།",
    "བོད་པར་སྐྱེས་པ་དེས་གྱོང་རག་འདུག་ཟེར་མཁན་ཡང་བྱུང་ཡོད།",
    "ཡུལ་སྐོར་སྤྲོ་འཆམ་པ་མང་པོ་ཡོད་པ་ལས་བོད་མི་ཉུང་ཉུང་ལས་མི་འདུག་ཅེས་བརྗོད་བྱུང་།",
    "ཁྱེད་རང་སོ་སོའི་འགྲོ་སྟངས་གང་ལ་གང་ཙམ་ཧྲ་ཏག་ཏག་ཆགས་ནས་ཏོག་ཙམ་ལས་ཀ་བྱེད་ཐུབ་རྒྱུའི་ཆ་རྐྱེན་ཡོད་པའི་སྐབས་དེར་སོ་སོའི་འགན་དེ་མ་བརྗེད་པ་བྱེད་དགོས།",
    "ཀྱི་འདུག་ཁ་ཆེ་དང་།",
    "ཕྱི་ལོ་༡༩༥༦ ཟླ་༡ པའི་ནང་ངོས་རང་བོད་ནང་ཡོད་སྐབས་ཧང་གྷརིའི་ཡུལ་མི་ཚོས་དམར་ཤོག་ལ་ངོ་རྒོལ་ཤུགས་ཆེ་བྱས་པ་དྲན་གྱི་འདུག་དེའི་སྐབས་གོང་ས་མཆོག་ལ་ཧང་གྷརི་མི་མང་དང་བོད་རིགས་དེ་བཞིན་སོག་རིགས་སོགས་ནས་ཕེབས་བསུ་གཟབ་རྒྱས་ཞུ་བཞིན་པ།",
    "དེ་ནས་ཨི་ཊ་ལིར་འབྱོར་སྐབས་མི་ཚང་མ་བློ་བདེ་བག་ཕེབས་ངང་གནས་འདུག་ད་ཆ་རིམ་པས་འགྱུར་བ་ཕྱིན་ཏེ་ཡུལ་གྲུ་ཆུང་ཆུང་འདིའི་ནང་མང་གཙོ་དར་འཕེལ་གྱིས་གང་ཅིའི་ཐད་ཡར་རྒྱས་ཀྱི་ཕྱོགས་སུ་འགྲོ་བཞིན་ཡོད་པའི་ཚོར་སྣང་བྱུང་བས་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "༢༩ ལོའི་མི་འབོར་གྲངས་བཤེར་གཉིས་པའི་སྐབས་སྐྱེ་འཕེལ་ཚད་གཞི་༡་༡༨ བར་ཆག་འདུག་གནས་ཚུལ་འདི་ལ་མགྱོགས་མྱུར་བཟང་ཕྱོགས་ཀྱི་འགྱུར་བ་མ་ཕྱིན་ན་འབྱུང་འགྱུར་ལོ་ལྔ་བཅུའི་ནང་བཙན་བྱོལ་བོད་མིའི་གྲངས་འབོར་བརྒྱ་ཆ་༤ ནས་༤༥ བར་ཙམ་ཉུང་དུ་འགྲོ་རྒྱུ།",
    "ད་དུང་ཡང་འདིའི་ཐོག་ཤུགས་བརྒྱབ་དགོས་ཀྱི་འདུག་རོགས་སྐྱོར་དགོས་ངེས་ཀྱི་ཉམ་ཐག་རྣམས་ལ་བོད་གཞུང་ནས་རོགས་སྐྱོར་གནང་མུས་ཡིན།",
    "ལོ་གཉིས་གསུམ་ཉམས་མྱོང་གསོག་ས་ལྟ་བུ་བྱས་ཏེ་དཔེར་ན་ཕྱི་ལོ་༢༥ ནས་༢༡ བར་ལས་བྱེད་གསར་པ་འཛུལ་མཁན་མི་གྲངས་༣༡༢ ནས་དགོངས་པ་ཞུ་མཁན་༡༤༤ བྱུང་འདུག་པ་དགོངས་པ་ཞུ་མཁན་སྤྱིའི་བརྒྱ་ཆ་༤༦་༡༥ ཆགས་ཀྱི་འདུག་གཞུང་ཞབས་ནང་འཛུལ་མཁན་ཚོ་ཐོག་མ་ནས་ལོ་གང་འཚམས་ཤིག་ཞབས་ཕྱི་ཞུ་ཐུབ་མཁན་རིགས་འཛུལ་ཞུགས་བྱས་ན་ལེགས།",
    "ང་རང་ཐོན་འགྲོ།",
    "ང་རང་ཞིང་གྲོང་ནས་འོངས།",
    "སྐྱོན་མི་འདུག་ཁོང་དེ་རིང་ཁྱིམ་དགོང་ཆར་པ་ཟིམ་ཟིམ་ཞིག་ཀྱང་བབས་པས་ད་དུ་ངལ་གསོས་ཡོད།",
    "ལ་ལས་སྟོད་གོས་ཀྱི་གོང་བ་ཕྱིར་སློག་ནས་ལྟས་ངན་ཆུང་ཆུང་དེ་དག་འཚོལ་བཞིན་འདུག་པོ་གསུམ།",
    "འཛུམ་ཞིག་རྒྱས་ཏེ་ཚ་ཐབ་ཡར་རྒྱུད་དུ་ཟུར་འདུག་ཨ་ཅེ་སྒྲོན་དཀར།",
    "ཉག་ཕྲ་བའི་སེམས་པ་དང་རང་ཉིད་ཀྱི་ལྷིང་འཇགས་སྲུང་ཡོད།",
    "ཆག་སྒོ་དང་ངོས་དངུལ་ཁུག་བསྔོགས་རྒྱུ་ལས་མི་འདུག་འཛིན།",
    "ལྷོ་ཞིང་ཐང་གསེར་གཞོང་ལོ་ཏོག་ཀུནཚེ་སྲོག་ཤོར་ཉེན་ཡང་འདུག་གོ།",
    "འོག་གུ་ཐུང་ཐབ་ཆི་གྲོལ་ནས་འདུགལས་དེ་འདྲ་མ་གནང་མ་གནང་ཞེས།",
    "ཁྱིམ་འཐོར་ཅིང་རྒྱུ་ནོར་བརླགས་ནས་འདུག།",
    "ཁོས་ཅི་ཡང་མི་སྙམ་ངས་ཁོ་རང་རླངས་འཁོར་འབབ་ཚུགས་སུ་སྐྱེལ་མ་པར་ངའི་ལག་མགོ་ནས་འཇུས་ཏེ་གྲོགས་པོ་བྱས་པ་ཡིན།",
    "དཔེ་མི་སྲིད།",
    "འདི་ནི་ངའི་ཆུང་མ་དང་ཕྲུ་གུ་མ་ཁོ་རང་འདི་ལྟར་འགྲོ་རུ་འཇུག་མི་འདོད་དེ།",
    "ཉམས་འགྱུར་ནས་འདུག་ཁོམ་མེད།",
    "བློ་ད་ལྟ་ང་རང་མག་པར་བསྡད་ཡོད་པའི་ཁྱིམ་སེམས་རྦད་ཆོད་ཀྱིས་གྲྭ་སར་ཞུགས་པ་ཡིན།",
    "ང་རང་ཕྱིར་ཁྱིམ་ལ་འབྱོར་དུས།"
  ]
}