    "མ་དཔེའི་འབྲུ་དག་པོ་མི་འདུག་སྒྲང་ལྡེའུ་བོན་གསུམ་གྱི་གཏམ་ཨེ་མ་ཧོ།",
    "ཞང་ཞུང་རུས་ཆེན་རུས་ཚན་གང་དུ་གཏོགས་མིན་ཤིན་ཏུ་གསལ་པོ་བྲིས་གནང་མཛད་འདུག་ན་ཡང་བསྐྱར་གླེང་དགོས་དོན་མི་གདའ་སྙམ།",
    "༡༢༨ དཔེ་བཤུ་བྱ་མཁན་གྱི་མ་དག་པ་མང་པོ་བཟོས་འདུག་འདི་རྗེས་བསྡུས་མིང་རྒྱ་བོད་ཡིག་ཚང་མཁས་པ་དགའ་བྱེད་ཅེས་འགོད་རྒྱུ།",
    "འདི་རྒྱས་ཤོས་ཡིན་ཟེར་བར་འདུག་པ་བཞིན་བཀོད་པའོ།",
    "ལྷག་པར་དུ་བཀའ་ཆེམས་ཀ་ཁོལ་མ་འདི་ལའང་ཕྲན་བུ་རྒྱས་བསྡུས་དང་ཚིག་སྣ་རིང་ཐུང་ཡོད་འདུག།",
    "གནའ་མིའི་ངག་རྒྱུན་ལ་སྣང་ཡང་འདི་རྣམས་མཐུན་པར་འདུག་གོ།",
    "དེ་རྣམས་ཀྱི་རིགས་མཆེད་པ་ཡིན་ཞེས་ཟེར་བ་སོགས་བཞེད་ཚུལ་མི་མཐུན་པ་མང་ཙམ་འདུག་པ་དང་།",
    "༡༩༩༢ ཤོག་གྲངས་༢༤ ཞུ་དག་རུ་ངར་བྱུང་མི་འདུག།",
    "གླུ་གཞས་རྙིང་བ་སོགས་དང་བཅས་གོང་བཞིན་བསྒྲིགས་ཏེ་བོད་ཀྱི་མི་ཡི་བྱུང་ཚུལ་མི་མཚུངས་པ་སྣ་ཚོགས་ཤིག་འདུག་ཀྱང་།",
    "ཞེས་འབྲས་ལྗོངས་སྒང་ཏོག་སྤར་མའི་མ་ཕྱི་ཞུ་དག་ཡག་པོ་བྱུང་མི་འདུག་ཤོག་ལྡེབ་༡༡ན་༣ ལས།",
    "གདའ་ཐུ་ཉག་རྒྱུ་འགུ་ཟི་གསུམ།",
    "སྲིད་པ་མི་རབས་མཆེད་དགུ་ནི་མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པ་ལྟ་བུ་ཞིག་ཡིན་པར་འདུག་སྟེ།",
    "ཟེར་བ་འདུག་ནའང་།",
    "མིའི་འགྲོ་བ་མ་བྱུང་འདུག་པ་དང་།",
    "རིགས་རྒྱུད་མི་རྒྱུད་འདི་ཡིན་གྱི་གསལ་ཆ་མི་འདུག་པས།",
    "༡༡༤ དཔེ་བཤྲ་བྱ་མཁན་གྱི་མ་དག་པ་མང་པོ་བཟོས་འདུག་རྒྱ་བོད་ཡིག་ཚང་མཁས་པ་དགའ་བྱེད།",
    "ཟེར་བའི་གནའ་སྒྲུང་མང་པོ་འདུག་སྟེ།",
    "༢༡ ལོར་མཛད་འདུག་ཀྱང་ད་བར་སྦར་སྐྲུན་གནང་མིན་ཆ་མ་འཚལ་ལོ།",
    "གོང་དུ་བརྗོད་པའི་རིགས་རུས་ཀྱི་བརྒྱུད་པ་ཁོ་ན་ཉིད་ཡིན་འདུག་ཀྱང་།",
    "གོང་གསལ་དཔེ་ཁུངས་གསུམ་པོའི་ནང་དོན་བརྗོད་བྱ་རྒྱས་བསྡུས་དང་ཚིག་སྣ་རིང་ཐུང་ཅི་རིགས་ཡོང་འདུག་ན་ཞིབ་བསྡུར་དགོས་གལ་ཤིན་ཏུ་ཆེའོ།",
    "ཕྱག་དེབ་ཀྱི་མཚན་བྱང་རྫིག་པོ་བོད་ཀྱི་གདུང་རུས་ཞིབ་འཇུག་ཅེས་པར་ཞིབ་སྐབས་རྩོམ་སྒྲིག་བྱེད་མཁན་རྣམས་གདོང་ལྤགས་ཤིན་ཏུ་མཐུག་ཅིང་དཔྱད་ཞིབ་ཅི་ཡང་མེད་པའི་ར་ཐོན་ལུག་ཐོན་བྱས་འདུག།",
    "ཞེས་སྐྱོན་སངས་རྣག་ཐོག་གཙག་འགེལ་གནང་འདུག་པར་ཐུགས་རྗེ་ཆེ་ཞུའོ།",
    "རྒྱ་ནག་དང་ས་རི་དང་གྲུ་གུ་དང་དི་མིར་དང་ཤི་རི་སོགས་ཧོར་གྱི་རུས་མིང་ཅན་མང་པོ་འདུག་པས་རིགས་དང་ཆད་ཁུངས་གཅིག་ཏུ་ངེས་ཚོད་མི་འདུག་ཅེས་གསལ་བ་འདི་ནི་ཤིན་ཏུ་བདེན་པའི་གཏམ་དུ་མཆིས་སོ་།",
    "སྔོན་དུས་ཀྱི་བོད་ཀྱི་རྒྱལ་བློན་དང་ལོ་ཙཱ་བ་སོགས་ལ་རྒྱ་ནག་དང་ཧོར་གྱི་རུས་མིང་ཅན་མང་པོ་འདུག་པས་རིགས་དང་ཆད་ཁོངས་གཅིག་ཏུ་ངེས་ཚོད་མི་འདུག་ཅེས་གསལ།",
    "ཞེས་གླེང་ན་འཇུག་པོ་དང་འོས་པོ་འདུག་གམ།",
    "ནང་གྲོས་མཁར་བཙན་བཟུང་འདྲ་མཛད་དགོས་འདུག་ལགས།",
    "ཚུར་རིའི་སླེ་པོ་མེད་ཅིང་ངང་པ་ཆུས་འཁྱེར་བ་རྐྱལ་དུ་རློམས་པའི་གནས་ཚུལ་བྱུང་འདུག་སྐྱུག་བྲོ་བོའི་ཆབ་སྲིད་ལ་ངོ་ལྐོག་གཡོ་ཁྲམ་དགོས་པ་ཆབ་སྲིད་ཀྱི་འགྲོ་སྟངས་དང་།",
    "གཉིས་པ་གལ་ཏེ་མ་འོངས་པར་རྒྱ་བོད་ཞི་མཐུན་འབྲེལ་ལམ་གྱི་འཇོག་སོ་གང་ཡང་མེད་པར་ད་དུང་ལོ་ཤས་འགོར་འགྱང་བྱུང་ན་ད་ལྟ་ལྟར་བཙན་བྱོལ་བོད་གཞུང་རང་འཇགས་གནས་དགོས་དང་མི་དགོས་བསམ་ཞིབ་བབ་ལྟ་ནན་ཏན་དགོས་འདུག།",
    "ཕྱི་མི་སུ་ལའང་ངོ་སྲུང་དགོས་མི་འདུག།",
    "སཱ་ལ་ནི་སྤོས་དཀར་གྱི་ཤིང་ཡིན་འདུག་པས།",
    "བྱུང་བ་བྱས་ན་ཡང་ལུང་དང་རིགས་པའི་གནོད་པ་མེད་ཅིང་རང་ལུགས་བཞག་ནས།",
    "ཞེས་ད་དུང་ལུང་དེར་སྣོན་མ་བཏབ་ནས་ཇེ་གསལ་དུ་བཏང་འདུག་པ་ལ་དཔགས་ན།",
    "དྲི་བའི་ནང་གསལ་ཁ་མི་འདུག།",
    "འགོས་ཁྲི་བཟང་ཡབ་ལྷག་པ་གོར་བེ་རོ་ཙ་ན།",
    "དེ་དག་ནང་འཁོད་འོས་ཀྱང་ཟུར་ཙམ་ཡོད་ཚོད་མི་འདུག་ལ།",
    "སྤོས་དཀར་གྱི་སྡོང་པོ་ལ་སོགས་པའི་ལྗོན་ཤིང་སྣ་ཚོགས་ཀྱིས་གང་བའི་ནགས་ལྗོངས་ཤིག་ཏུ་གྱུར་པ་ཡིན་འདུག་དེ་ཡིན་པའི་ར་འཕྲོད་འདི་འདྲ་ཞིག་བྱུང་།",
    "སྔོ་ནེ་ཡང་ཡོད་པ་ཞིག་རྙེད་འདུག་དེ་དག་ནས་ཆ་ཤས་ཤིག་ཕྱི་རྒྱལ་དུ་བཏང་ནས་བརྟག་དཔྱད་བྱས་པར།",
    "༥ཡོ་རོབ་ལ་ངོས་འཛིན་གནང་བའང་འདུག་པ་བཅས་ལ་དཔྱད་ཞིབ་ངེས་པར་བྱ་དགོས་པ་ཡིན།",
    "གོ་བ་ཡིན་ཞེས་གསུངས་འདུག་པ་ལྟར།",
    "ཅེས་འཁོད་འདུགགླེང་སློང་།",
    "སྔོན་གྱི་དགོན་ཤུལ་ཤིན་ཏུ་མང་བ་ཡོད་འདུག་ཡུལ་འདིའི་མི་རིགས་རྣམས་སོག་རྒྱུད་ཡིན་པས།",
    "ཞེས་བྲིས་འདུག།",
    "ལོ་༣ སྔོན་དུ་བྱུང་འདུག།",
    "ཅེས་བྲིས་འདུག་འདི་སྐོར་ཡང་ཇོའོན་གྱི་དེབ་ནང་གསལ་བ་ལྟར།",
    "དེ་ནས་ཤིང་ཏོག་དེ་འདྲའི་རྩ་བ་བཏབ་ན་སྐྱེ་རྒྱུ་ཨེ་འདུག་མི་འདུག་ཚོད་བལྟ་བྱས།",
    "དགུ་ཡོད་པའི་ངན་ཤོས་སུ་འདུག་ཅིང་།",
    "མུན་པ་ནག་ལྟ་བུར་འདུག་ཅེས་པ་ནས།",
    "བོད་ཀྱི་བཙན་པོ་ཐོག་མ་གཉའ་ཁྲི་བཙན་པོ་ནི་ཕྱི་ལོའི་སྔོན་གྱི་ལོ་ངོ་༣༦ སྐབས་སུ་བྱོན་ནས་ད་བར་ལོ་ཙམ་ཕྱིན་འདུག་ཅིང་།",
    "རང་རང་འཚོ་ཐབས་ཀྱི་འཚོ་བའི་བརྒྱུད་རིམ་ནང་ཕན་ཚུན་བརྡ་སྤྲོད་བྱེད་པའི་ཐོག་མའི་གདོད་རྒྱལ་བའི་སྐད་ཆ་བྱུང་བ་དང་།",
    "བེ་རོ་ཙ་ནའི་སྐྱེ་བ་གཅིག།",
    "ཕྱི་མགོ་ནང་བཙུགས་ཀྱི་ནག་ཉེས་འདི་ཤུགས་མ་ཐུབ་ཀྱིས་ལན་གཅིག་མིན་པ་ཡང་ཡང་ཤོར་འདུགདཔེར་མཚོན་ཙམ་ཞུ་ན།",
    "ཀྱིས་བོད་སོག་ཆིངས་མཐུན་མཛད་པའི་བཀའ་དྲིན་ལ་བརྟེན་ནས་བོད་མི་སྟོང་ཕྲག་མང་པོའི་ཚེ་སྲོག་སྲུང་སྐྱོབ་གནང་ཐུབ་པ་བྱུང་འདུག་པ་འདིའི་ཐོག་ནས།",
    "དོན་དངོས་ཐོག་གཙང་སྲིད་ཀྱི་འོག་ནས་དབུས་ཀྱི་གཞིས་ཀ་ཚུར་རག་པ་རྣམས་བགོ་བཤའ་རྒྱག་དུས།",
    "གལ་ཏེ་ཡི་གེ་དེ་དངོས་གནས་ཡིན་ན་རྒྱལ་བ་ལྔ་པ་ལ་སྤྱན་འབུལ་མི་ཞུ་བ་དཔེ་མི་སྲིད་ཀྱང་།",
    "ཅང་ཐུགས་བསམ་བཞེས་འདུག་ལ།",
    "ཞེས་གསུང་འདུག་ཅིང་།",
    "ཞང་ཞུང་དེ་བོད་ཀྱི་རུས་རྒྱུད་འཁྲུལ་མེད་ཡིན་འདུག་པར་སྙམ།",
    "རལྡོང་ལ་རུས་ཆེན་བཅོ་བརྒྱད་ཟེར་ཙ་ན།",
    "བོད་ཀྱི་ས་ཆ་གལ་ཆེན་ཡིན་འདུག་སྟེ།",
    "གཉའ་ཁྲིའི་ཡར་སྔོན་དུ་བྱུང་བའི་རྒྱལ་ཕྲན་སིལ་མ་བཅུ་གཉིས་ཀྱི་ཡ་གྱལ་ཡང་ཡིན་འདུག་སྟེ།",
    "ཞེས་བཀོད་གནང་འདུག་དེབ་ཐེར་སྔོན་པོ།",
    "ལུང་བསྟན་འདི་རིགས་ལ་དེ་ལས་ཀྱང་གོ་གང་ཡངས་ཡངས་སུ་འགྲེལ་ལུགས་དུ་མ་བྱས་ཆོག་འདུག་པས།",
    "ད་དུང་ཡང་རང་ཉིད་ཅི་དགར་ཕེབས་ཆོག་བཞིན་དུ་ངེད་ལ་ཁྲོ་དགོས་པའི་དོན་མེད་དོ།",
    "ཞེས་བཀོད་འདུག་འདིས་ཅི་སྟོན་ཅེ་ན།",
    "ང་ཡི་དུས་ནས་ལོ་བརྒྱ་ན་སོགས་ནི་མཇལ་དུ་མི་འདུག་དེའི་ནང་དེ་དང་ཆ་འདྲ་ཞིག་ཡོད་པ་ནི།",
    "གོང་ནས་ཞུས་མ་ཐག་པའི་རྒྱལ་པོ་བཅུ་ལུང་བསྟན་གྱི་ཚིག་གཞི་དེ་བོད་ཀྱི་རྒྱལ་པོ་བཅུ་ལུང་བསྟན་གྱི་ཚིག་ཏུ་གོ་བ་ལེན་ཕྱོགས་དེས་ཁ་བ་ཅན་ཞེས་པའི་ཐ་སྙད་དང་སཱ་ལའི་ནགས་ཀྱི་འབྱུང་ཡུལ་གཉིས་ཀ་བོད་ཡུལ་རང་དུ་ངོས་འཛིན་གནང་སྲོལ་བྱུང་འདུག་པར་སྙམ།",
    "ཡོངས་གྲགས་ཀྱི་རུས་མཛོད་རྣམས་སུ་ཞང་པོ་རྒོ་ཞེས་ཟེར་བའང་འདུག་པས།",
    "ལྷག་པར་རུས་རྒྱུད་ཆ་ནས་བཞག་ཡོད་པས་དེ་གཉིས་ག་དུས་ཡིན་ཡང་གཅིག་ཏུ་བསྲེས་མི་རུང་།",
