    "མི་མ་གསད་རོགས་ཞེས་ངུ་འབོད་བྱས།",
    "ས་ལ་འགྱེལ་བའི་མིའི་གཟུགས་བོར་བཀབ་སྟེ་མ་བསད་ཙམ་བྱེད་ཐུབ་པ་བྱུང་ཞེས་གསུངས།",
    "ས་མཚམས་ཤོ་ཁྲལ་འགོ་པ་ཡོད་པར།",
    "གདན་ཞུ་བྱས།",
    "དེ་དུས་ཚོགས་ཁྲོ་དེ་འབྲི་ཆུ་སེ་བོའི་ཆུ་ཡིས་བཀང་ནས་བཞག་ཤོག་ཅེས་བཀའ་སྩལ་བ་ལྟར་བྱས།",
    "སྣེ་ལེན་ཟབ་པས་ཉིན་ཤས་བསྡད།",
    "རིན་ཆེན་རིགས་ཀྱི་ཕྲ་རྒྱན་ཁྱད་འཕགས་ཅན་བཞུགས་པའི་ལྷ་ཁང་གསར་བཞེངས་དང་།",
    "ལྷག་མ་རྣམས་ཀྱིས་དེ་ནས་བཟུང་སྒར་པ་ཡོངས་ཀྱི་ཉོ་ཆ་དགོས་རིགས་ཚང་མའི་རིན་འབབ་སྤྲོད་རྐྱང་བྱས་པ་ཡིན།",
    "ཡུལ་དེར་དབྱར་དགུན་མེད་པར་སྦྲ་གུར་ཡིན་པ་དང་།",
    "བཟོད་ཐབས་མ་བྱུང་སྟེ་རོགས་སུ་ཉག་རོང་འགྱུར་མེད་ཁྲིད་ནས་མཛོ་ཆུང་ལྟ་བར་ཕྱིར་བསྐྱོད་བྱས།",
    "རྒལ་པ་བཅས་སུ་བྱུག་བྱུག་བྱས་པར་ངུར་བའི་སྒྲ་དང་བཅས་མིག་ཆུ་ཆད་མེད་བཏང་བར།",
    "སང་སྔ་པོར་ཕྱིན་པས་ཉིན་ཕྱེད་ཙམ་ལ་ཡུལ་གྱི་ནོར་ཕྱུགས་འགོ་རྒོད་རྣམས་དང་འཕྲད་པར་མཛོ་ཆུང་ཡོང་སྟེ་དགའ་སྣང་བྱེད་པར།",
    "རྩྭ་ཆུ་བཟང་བས་དེར་ཞག་སྡོད་བྱས།",
    "མགོ་འཕང་མཐོན་པོ་བྱས་ཏེ་ཕྱིན་པས་དེ་དགོང་སྒར་པའི་རྗེས་ཟིན།",
    "ལྷ་སར་ད་དུང་ཉིན་བརྒྱད་ཙམ་འགོར།",
    "འབྲི་གུང་སྐྱོབ་པ་འཇིག་རྟེན་མགོན་པོའི་གདན་ས་ཁྱད་པར་ཅན་དེ་ཡིན་པ་དང་།",
    "ཆུ་རྒྱུན་རྒྱུག་ཤུགས་མེད་པས་ཆུའི་ཁྱེར་དོགས་མ་བྱས་པར་ཆུ་ནང་དུ་འཛུལ།",
    "ཞེད་སྣང་ཆེན་པོ་ཤུགས་སྐྱེད་ཀྱིས་ཕྱིར་བསྐྱོད་བྱས་པས་ཐར་ཙམ་བྱུང་ཡང་།",
    "གང་འཚམས་ནས་ཨོད་ཅེས་པའི་སྒྲ་ཐོན་པར།",
    "འཚོ་བྱེད་ཚེ་རིང་ཕུན་ཚོགས་ནས་ད་མ་མནན་ཟེར་བ་ལྟར་བྱས་པས།",
    "དེ་ནས་ཕྱིན་པས་བྲག་ཡེར་པའི་གཤམ་ནས་འགྲོ་དུས་ལྷ་སའི་ནང་ཤ་ཚོང་བྱེད་མཁན་བཤས་པ་མང་པོ་མཉམ་འགྲོ་བྱེད་དེ་མཛོ་ཁལ་རྣམས་ཚོང་ཁ་ཤོར་ཡང་།",
    "མཛོ་གཡག་རྣམས་ཉོ་མཁན་འཚང་ཁ་བྱེད་པར་རིམ་བཞིན་བཙོངས།",
    "ལྷ་སའི་གླིང་བར་ནས་ཕྱིར་ལོག་མི་ཤེས་པ་ཡོང་ལུགས་ཤོད་སྲོལ་ཡོད།",
    "ལྷ་སའི་ཁམས་པ་ཚོང་རིགས་རྣམས་ཀྱིས་བར་མི་བྱས་ཚུལ་དང་།",
    "ནང་བློན་མགར་སྟོང་བཙན་ཡུལ་ཟུང་བཅས་བཞུགས་པའི་ལྷ་ཁང་།",
    "ཇོ་བོ་མ་གཅིག་དཔལ་ལྷ་སོགས་གཙུག་ལག་ཁང་ནང་སྐོར་སྟེང་ཤོད་ཀྱི་རྟེན་རྣམས་དང་།",
    "འབྱུང་ཁུངས་དང་སྐུ་ཚད་གོང་མཚུངས་ཀྱི་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེའི་སྐུ་བརྙན་གངས་ཅན་བོད་ཀྱི་ལྷ་སྐལ་དུ་གདན་དྲངས།",
    "དེའི་བུམ་སྒོའི་ཐད་སྟོན་པ་གླང་པོའི་སྐྱེ་བ་བཞེས་པའི་ཚེམས།",
    "ཐུབ་བསྟན་རྒྱ་མཚོ་བར་གྱི་གསེར་གདུང་བཞུགས་ཤིང་།",
    "གསང་འདུས་ཀྱི་བློས་བསླངས་ཁང་སོགས་ལྷ་ཁང་རབ་འབྱམས་མཐའ་ཡས་པ་བཞུགས།",
    "གཡུ་ཡི་སྒྲོལ་མ་སོགས་རྟེན་བྱིན་ཅན་མང་དུ་བཞུགས།",
    "ལྷ་སའི་ཕ་རིར་དཀའ་ཆེན་ཡེ་ཤེས་རྒྱལ་མཚན་གྱི་གདན་ས་གྲིབ་ཚེ་མཆོག་གླིང་བཅས་མཇལ།",
    "གྲྭ་ཚང་ཁག་གཙོ་བོར་ངོ་མཚར་ཆེ་བ་རྭ་ལོ་ཆེན་པོའི་སྐུ་གདུང་བཞུགས་པར་གྲགས་པའི་འཇིགས་བྱེད་ཀྱི་སྐུ།",
    "ལྷ་སའི་བྱང་ངོས་སུ་སེ་ར་ཐེག་ཆེན་གླིང་དགོན་གྱི་གྲྭ་ཚང་ཁག་གཉིས་ཀྱི་ལྷ་ཁང་དང་།",
    "རྟ་མགྲིན་ཡང་གསང་ཁྲོས་པའི་སྐུ་གསུང་བྱོན་མ་སོགས་བཞུགས་པ་མཇལ།",
    "འདི་ཡུལ་ཉེར་བཞིའི་ནང་ཚན་དེ་ཝཱི་ཀོ་ཊ་གཉིས་པ་ཡིན་པར་གྲགས།",
    "བོད་ཟླ་༩ ཚེས་༡ ཉིན་ལྷ་ལྡན་ནས་ཐོན་ཏེ་གཙང་པོ་བྱང་དུ་གྱེན་བརྒྱུད་དུ་ཉིན་ཞག་གཉིས་ཀྱིས་ལྷོ་གནས་ཀྱི་གོང་བ་བྲག་ཡེར་ཟླར་འབྱོར།",
    "འབྲོམ་སྟོད་ན་གཉན་ལོ་ཙྭ་བའི་གཟིམ་ཕུག་ཏུ་མགོན་པོ་ཞལ་གྱི་སྐུ་ཁྱད་པར་ཅན་ཡོད།",
    "དགའ་ལྡན་གྱི་ཕར་ཕྱོགསགཙང་པོ་བྱང་ཕར་ལོ་སེམས་དཔའ་ཆེན་པོའི་གདན་ས་སོགས་ཡོད་ཀྱང་མཇལ་མ་ཐུབ།",
    "དགའ་ལྡན་ནས་རྩེ་རི་ལ་བརྒྱབས་ཏེ་ཐུར་གཟར་ཆེན་པོ་བབས་པར་ཕྱིན་ནས་ལོ་ཆེན་བེ་རོ་ཙྭ་ནའི་སྒྲུབ་ཕུག་བསམ་ཡས་གཡའ་མ་ལུང་དུ་སླེབས།",
    "རྟེན་གསུམ་བྱིན་ཅན་དངོས་གཙང་བཞུགས།",
    "དབུ་རྩེར་ལྷ་གསང་ཁང་དུ་མཁན་ཆེན་བོ་དྷི་ས་ཏྭའི་སྐུ་གདུང་དངོས་བཞུགས་ཡོད་ཅིང་།",
    "ཀླུ་འདུས་ཁྱུང་ཆེན་ཕུག་ཀུན་མཁྱེན་ཀློང་ཆེན་པའི་གདུང་འབུམ།",
    "བཀའ་གདམས་མཆོད་རྟེན་གྱི་དབྱིབས་དང་མཚུངས་པར་རིན་ཆེན་རིགས་དུ་མ་ལས་གྲུབ་པའི་ཟི་ཁྱིམ་གྱི་མཆོད་རྟེན་ཐོག་སོ་གཉིས་ཙམ་བྱས་པ།",
    "གཙང་པོ་གྱེན་དེད་དུ་ཕྱིན་ན་ཟུར་མཁར་རྡོའི་མཆོད་རྟེན་རིགས་ལྔ་ངོ་མཚར་ཆེ་བ།",
    "དེའི་འོག་ནས་ཟངས་རི་མཁར་དམར་ཞེས་མ་གཅིག་ལབ་སྒྲོན་གྱི་གདན་ས་མ་གཅིག་ཡུམ་སྲས་ཀྱི་སྐུ་གསུང་བྱོན་མ་སོགས་བཞུགས།",
    "མངའ་རིས་གྲྭ་ཚང་གང་རུང་ནས་གཙང་པོ་ཕ་རིར་ཀོ་བ་ལས་ཐོན་ཏེ་རྩེད་ཐང་དུ་བསྐྱོད།",
    "སྣེ་གདོང་རྩེ་ཚོགས་པར་ཁ་ཆེ་པཎ་ཆེན་གྱི་རྫ་སྐུ་གསུང་བྱོན་མ།",
    "ལྷུང་བཟེད་སོགས་རྟེན་ཁྱད་པར་ཅན་ཡོད་སྐད།",
    "སྐུ་བརྙན་དེ་དག་ལྷ་ཁང་འདི་གསར་བཞེངས་གྲུབ་པ་དང་རྒྱ་གར་ཤར་ཕྱོགས་ནས་ནམ་མཁའི་དབྱིངས་ནས་ཕེབས་སྐབས་ཐོག་མར་སྒྲོལ་མ་དེ་སྔོན་དུ་བྱོན་ཏེ།",
    "རྟེན་གསུམ་ཁྱད་པར་ཅན་མང་བ་དང་།",
    "ས་སྐྱ་པཎྜི་ཏའི་གཏམ་སྙན་བཞུགས་ཁྲི་ཞེས་པ་དང་།",
    "ཐུགས་དམ་གཉན་པོ་གསང་བ་སོགས་བཞུགས།",
    "ཞིང་ལ་ལོ་ཏོག་ཐོག་མར་འདེབས་སའི་ཡུལ་ཡིན་པར་བཤད།",
    "དེ་ནས་རིམ་པར་ཙྭ་རི་སོགས་ཀོང་པོར་འབྲེལ་བའི་གནས་རྣམས་ཡོད་ཀྱང་མཇལ་མ་ཐུབ།",
    "རས་ཆུང་པའི་རྣམ་འཕྲུལ་གཙང་སྨྱོན་ཧེ་རུ་ཀའི་གདན་ས་རས་ཆུང་ཕུག་སོགས་རྟེན་གསུམ་མང་།",
    "ཕྱག་མཚལ་ལ་ཁར་དུར་ཁྲོད་ཁྱད་པར་ཅན་མཆོད་རྟེན་དང་བཅས་པ་བཞུགས།",
    "དེ་དང་ཉེ་བའི་དོན་མཁར་ལུང་པའི་ཕུར་ཀུན་མཁྱེན་འཇིགས་མེད་གླིང་པའི་གདན་ས་ཚེ་རིང་ལྗོངས་སུ་ཀུན་མཁྱེན་གྱི་གདུང་རིལ་པོར་བཞུགས་པའི་མཆོད་རྟེན་དང་རྟེན་གསུམ་ཁྱད་པར་ཅན་ཡོད་ཀྱང་མཇལ་མ་ཐུབ།",
    "གཙང་པོ་ལྷོ་རྒྱུད་སྐོར་ལ་དབུ་རུ་ལྷོ་རྒྱུད་ཅེས་གྲགས་ཤིང་།",
    "གཙང་པོ་གྱེན་དེད་དུ་ཕྱིན་ན།",
    "མཁས་གྲུབ་ཁྱུང་པོ་རྣལ་འབྱོར་གྱི་ཐུགས་རིང་བསྲེལ་གྱི་ཕུང་པོ་སོགས་ནང་རྟེན་ཁྱད་པར་ཅན།",
    "བླ་བྲང་གཉིས་སུ་ལྷ་ཁང་དང་རྟེན་གསུམ་དངོས་གཙང་བྱིན་ཅན་མང་པོ་དང་།",
    "གཏེར་ཆེན་གྱི་སྐུ་གདུང་སོགས་བཞུགས།",
    "འདི་དང་ཉེ་བར་ཀུན་མཁྱེན་ཀློང་ཆེན་པ་འཁྲུངས་ས་དང་།",
    "དེ་ནས་གཙང་པོ་གྱེན་དེད་དུ་ཕྱིན་ན་གནའ་རབས་ཀྱི་ཕུར་པ་ལུགས་དྭགས་པོ་གྲྭ་ཚང་།",
    "དེ་ནས་གཙང་པོ་གྱེན་འདེད་དུ་ཕྱིན་པ་ན་ཐུབ་བསྟན་ར་བ་སྨད།",
    "ལྷོ་བྲག་མཁར་ཆུའི་གཤམ་ལྷོ་བྲག་ལྷ་ཁང་ཞེས་མཐའ་འདུལ་གྱི་གཙུག་ལག་ཁང་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་རྟེན་བྱིན་ཅན་ཡོད།",
    "ཞལ་རས་ཀྱི་གསེར་རྣམས་སྐུ་གཟུགས་ལྟེང་ནས་ཆུ་ཐིག་རྒྱུག་པ་བཞིན་ནར་ནར་དུ་བབས་ཀྱི་ཡོད་པ་མཇལ།",
    "མཚོ་དེའི་ནང་ནས་འདོན་པར།",
    "གུ་རུའི་ཕྱག་རྗེས་ཀྱང་བཞུགས་སྐད།",
    "ཁྱད་པར་ནང་རྟེན་དུ་མཇལ་ཞུས་ཡོན་ཕུལ་ན་ཀུན་མཁྱེན་ཀློང་ཆེན་པའི་དབུ་ཀླད་རིང་བསྲེལ་གྱི་ཕུང་པོ་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བ།",
    "ཆུ་གྱེན་འདེད་ཀྱི་ཕུར་འགྲོ་མགོན་གཙང་པ་རྒྱ་རས་ཀྱི་གདན་ས་འབྲུག་ར་ལུང་ཞེས་པ་དེ་ཡོད།",
    "རྟེན་གྱི་གཙོ་བོ་འགྲོ་མགོན་གཙང་པ་རྒྱ་རས་ཀྱི་སྐུ་འབག་ཁམས་གསུམ་ཟིལ་གནོན་སོགས་རྟེན་གསུམ་མཐའ་ཀླས་པ་བཞུགས།",
    "པ་རྣམ་གཞུང་ནས་འབྲོང་རྩེ་དགོན་བརྒྱུད་རིམ་པར་གཞིས་རྩེར་སླེབས།",
    "དེ་ལ་བསྐོར་བ་བྱས་གསོལ་བ་བཏབ་ན་རྩོད་པ་ལ་མཁས་པ་འོང་ཟེར།",
    "ཁྱད་པར་དགའ་གདོང་བྱམས་པ་དང་།",
    "པར་མཇལ་མ་ཐུབ།",
    "ཁྱད་པར་དུ་ཆུ་མིག་སྒྲོལ་མར་གྲགས་པའི་སྐུ་བྱིན་ཅན།",
    "དཔལ་མགོན་ཞལ་གྱི་གནས་ཁྱད་པར་ཅན་ཡིན།",
    "གླིང་པ་ཁང་ཚན་ནང་མ་ཁེངས་ཚར་ནས་ཕྱི་མར་བསྡད།",
    "རྟེན་གསུམ་ཁྱད་པར་ཅན་མང་པོ་དང་།",
    "ཐར་རྩེ་བླ་བྲང་དུ་བི་ཝར་པའི་བཞེས་ཐོད་དང་།",
    "རྩེ་བརྒྱུད་ཆག་ལ་སོགས་ནས་ཉིན་ཞག་གསུམ་ཙམ་གྱིས་གཙང་ལ་རུ་ལག་གཉིས་ཡོད་པའི་རུ་ལག་གཅིག་ཏུ་གཏོགས་པ་དཔལ་ས་སྐྱ་པ་ཆེན་པོའི་གདན་སར་སླེབས།",
    "གདན་ས་ཆེན་པོ་དེའི་ལྷ་ཁང་དང་རྟེན་གསུམ་མཐའ་ཡས་པའི་དཀར་ཆག་མཁན་ཀུན་དགའ་ཟླ་འོད་ཀྱིས་མཛད་པར་ཡོད་པ་སོགས་ལས་གསལ་ཞིང་།",
    "ང་ཅི་ཡང་སྐྱོན་མེད་ཅེས་གསུངས་བྱོན་པ་དང་།",
    "རྗེ་བཙུན་མ་རྣམས་མཇལ་ཞུ་ཐོབ་པས་ཡིད་འགུ་བ་བྱས།",
    "སྐུ་འཁྲུངས་དུས་མངལ་གྱི་ཕྲུ་མ་སོགས་བཞུགས་པའི་མཆོད་རྟེན་ཡོད།",
    "དེ་ནས་རིམ་པར་ཚར་ཆེན་གྱི་གདན་ས་མང་མཁར་ཐུབ་བསྟན་ཀེ་འཕེལ།",
    "འབྲོག་མིའི་གཟིམ་ཕུག་འོད་གསལ་ཟླ་བ་ཕུག་རྒྱ་དཔེ་བསྐུར་ས་སྒྲ་བསྒྱུར་ལོ་ཙཱ་ཕུག་ལམ་འབྲས་གནང་ས་གསུང་ངག་ལམ་འབྲས་ཕུག་སོགས་ཕུག་ཆེན་བཅུ་གསུམ་དུ་གྲགས་པ་རྣམས་མཇལ་ཡོད།",
    "གཙང་པོ་ཕ་རིའི་བྱང་རྒྱུད་དུ་བྱང་ངམ་རིང་།",
    "ས་ཆེན་ཞིང་གཤེགས་སའི་གནས་བྱང་ཕྱོགས་སྐྱ་བོ་ཁ་གདོང་སོགས་མང་དུ་ཡོད་ཀྱང་ཐག་རིང་ལ་སྟོད་ཕྱོགས་ནས་རིམ་པར་ཡར་ཕྱིན་ན་ཕ་དམ་པའི་བཞུགས་གནས་དིང་རི།",
    "ཁྱད་པར་རྒོད་ཚང་པའི་སྒྲུབ་གནས་རྩིབས་རྒོད་ཚང་།",
    "དགོན་གནས་རྟེན་གསུམ་སོགས་ཀྱི་བཀོད་པ་ཤིན་ཏུ་དངོས་གཙང་ཞིང་ངོ་མཚར་བ་བཞུགས།",
    "རྣམ་སྲས་མདུང་དམར་ཅན་གྱི་སྐུ་བྱིན་ཅན་བཞུགས།",
    "གཙུག་ལག་ཁང་དུ་ཚོགས་བཞུགས་ཡོད་མེད་ལ་མ་ལྟོས་པར་སྐུ་སྐལ་འབུལ་དགོས་ཤིང་།",
    "ཞལ་འབག་ངོ་མཚར་ཅན་སྐུ་དངོས་བཞུགས་སུ་ཡོད་པ་རྩ་ཆེར་བརྩི་ཞིང་།",
    "ངོར་གྱིས་བཀའ་བསྐྱོན་དང་སྦྲགས་ཕྱིར་ཕུད་གནང་སྟབས།",
    "དོ་ནུབ་གནས་ཚང་གཡར་རོགས་བརྗོད་པར།",
    "ངོར་ལུགས་སུ་རྐང་གླིང་ཁུག་བཞི་བཏང་བ་དེ་ཞལ་གྱི་ཕྱག་བཞེས་དེ་ལྟར་ཡིན།",
    "གསེར་ཕྱེ་གཡག་རྭ་གང་ཁུར་བའི་ཨ་ཅོ་དེ་མཇལ་ཁར་བཀག་པར།",
    "སྤུངས་དགོན་ཕྱག་བཏབ་སྟེ་ཡོད་པར།",
    "གཙང་ས་ངོར་གཉིས་སུ་བཅར་བའི་མཚོན་རྟགས་སུ་ས་སྐྱའི་སིལ་མ་དང་།",
