    "རྡོག་ཐབས་གཅིག་གིས་བསྐྱོད་པ་ན།",
    "སྐྱེས་བུས་ཟོ་ཆུན་གྱི་རྒྱུད་ལ་རྡོག་ཐབས་གཅིག་གིས་བསྐྱོད་པ་ན།",
    "སྐད་ཅིག་མ་ནི་གཅིག་གིས་རྟོགས།",
    "དེ་ཉིད་སྐད་ཅིག་གཅིག་གིས་མཐོང་།",
    "དཔེར་ཡུལ་ན་རྨི་ལམ་དང་ནི་ཡུལ་ཅན་དེ་མཐོང་བ་དེ་དག་ཉིད་གཉིས་ཀྱི་ཚུལ་དུ་མི་མཐོང་བ་རྟོག་པ་གཅིག་གི་ངོ་བོ་ཡིན་པ་ལྟར།",
    "ཉན་ཐོས་ཀྱི་ཉོན་མོངས་པ་མེད་པ་ལས་ཁྱད་པར།",
    "ཉོན་མོངས་མེད་དང་སྨོན་མཁྱེན་དང་།",
    "ཉོན་མོངས་མེད་པའི་ཏིང་ངེ་འཛིན་དང་།",
    "གཉིས་པ་ཉན་ཐོས་ཀྱི་ཉོན་མོངས་པ་མེད་པ་ལས་ཁྱད་པར་འཆད་པ་ནི།",
    "ཉན་ཐོས་ཉོན་མོངས་མེད་པའི་ལྟ།",
    "མི་ཡི་ཉོན་མོངས་ཡོངས་སྤོང་ཉིད།",
    "གྲོང་སོགས་སུ་དེའི་ཉོན་མོངས་རྣམས།",
    "རྒྱུན་གཅོད་རྒྱལ་བའི་ཉོན་མོངས་མེད།",
    "ཉན་ཐོས་ཀྱི་ཉོན་མོངས་པ་མེད་པ་ནི།",
    "ཉན་ཐོས་དེའི་སྒོ་ནས་ཕ་རོལ་མིའི་ཉོན་མོངས་ཡོངས་སུ་སྤོང་བ་ཙམ་ཉིད་ཡིན་ནོ།",
    "གཞན་གྱི་ཉོན་མོངས་སྐྱེ་བའི་དམིགས་རྟེན་བྱེད་མི་བྱེད་ལ་བརྟག་མི་དགོས་པར་གདུལ་བྱ་དེའི་ཉོན་མོངས་མ་ལུས་པ་རྣམས་རྒྱུན་གཅོད་པར་མཛད་པས་རྒྱལ་བའི་ཉོན་མོངས་པ་མེད་པའི་ཏིང་ངེ་འཛིན་ནི།",
    "རང་གཞན་གཉིས་ཀའི་རྒྱུད་ཀྱི་ཉོན་མོངས་འཇོམས་པར་མཛད་པས་ཁྱད་པར་དུ་འཕགས་སོ།",
    "སྔོན་ལྡག་པ་ལ་སོགས་པ་ཤིན་ཏུ་གྱ་ནོམ་པ་བྱིན་པས་ཐུབ་པ་འདི་ཡི་སྐུའི་ནི་ཕྱག་གི་སྐྱོང་གཉིས་དང་ཞབས་ཀྱི་སྐྱོང་གཉིས་དང་ཐལ་གོང་གི་སྐྱོང་གཉིས་དང་ལྟག་པའི་སྐྱོང་ཕྱོགས་མཐོ་བའི་ཕྱིར་བདུན་པོ་དག་མཐོ་བ་ཉིད་དང་།",
    "སོར་མོ་རིང་དང་རྟིང་ཡངས་སྐུ་ཆེ་དྲང་།",
    "སྔོན་སྲོག་གི་འཚོ་བ་ལ་ཕན་བཏགས་པ་ཉིད་ཀྱིས་རྟིང་པ་ཡངས་པ་ཉིད་དང་།",
    "སྔོན་ནོར་བདོག་པ་ལ་སློང་བ་པོའི་སྐྱེ་བོའི་ཕྱིར་དངོས་པོའི་ཆེད་དུ་མ་སྤངས་པས་བཞེངས་ནས་མ་བཏུད་པར་པུས་མོར་སླེབ་པའི་ཕྱག་རིང་ཞིང་མཛེས་པ་ཉིད་དང་།",
    "སྤུ་ནི་རེ་རེ་ནས་གཡས་ལེགས་འཁྲུངས་དང་།",
    "འདི་ཡི་དཔུང་པའི་མགོ་ཟླུམ་ཐལ་གོང་རྒྱས།",
    "སྔོན་འདུ་འཛི་ལ་སོགས་པ་ཡོངས་སུ་སྤངས་པས་སྤུ་ནི་རེ་རེ་ནས་གཡས་ཕྱོགས་སུ་འཁྱིལ་བ་དང་།",
    "སྤྱན་ནི་མཐོན་མཐིང་སྤྱན་རྫི་བ་མཆོག་གི།",
    "སྔོན་ཁོང་ཁྲོ་བ་ལ་སོགས་པ་མེད་པར་བལྟས་པས་སྤྱན་གྱི་རྫི་མ་བ་མཆོག་གི་རྫི་མ་ལྟ་བུ་ཉིད་ཀྱིས་སོ།",
    "འདི་ལ་མཚན་ནི་གང་གང་གི།"
  ]
}