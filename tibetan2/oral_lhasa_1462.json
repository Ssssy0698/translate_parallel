    "ཕྱིན་ཅི་མ་ལོག་པར་ཁོང་དུ་ཆུད་དོ།",
    "འབྲོག་མི་ལོཙྪབས་མཁས་པ་སྒོ་དྲུག་ལ་གསན་པའི་གདམས་པ་ལ་སོགས་འབད་པས་བརྩད་བཅད་དེ་ཞུས་ཤིང་དོན་ཀྱང་ཁོང་དུ་ཆུད་པར་བྱས་སོ།",
    "ལོག་ལྟའི་མུན་ནག་ཚང་ཚིང་རྣམ་པར་བསལ།",
    "གདུལ་བྱ་བློའི་པདྨོ་རྒྱས་པར་བྱས་པའི་རྒྱན་གསུམ་བཀོད་པའོ།",
    "ད་དུང་བླུན་པོ་རྣམས་ཀྱིས་རྟོགས་པར་དཀའ།",
    "པདྨ་རྣམ་པར་ཕྱེ་བ་ལས་བྱུང་པའི།",
    "རྒྱུན་དུ་བདེ་བའི་དགའ་སྟོན་འགྱེད་པར་ཤོག།",
    "དྲིན་དུ་མི་གཟོ་བ་མེད་པར་མཛོད་ཅིག།",
    "བྱས་པ་མི་དྲན་པ་དག་ནི་ལྷ་མ་ཡིན་གྱི་གཡུལ་དུ་ཕལ་ཆེར་གཞན་གྱིས་བསད་ཅིང་འཆི་བར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་བྱས་པ་མི་གཟོ་གང་ཡིན་པ།",
    "བསྟན་བཅོས་ཀྱི་ཐོག་མཐར་ལེགས་པར་བཀོད་པ་ཡིན་ནོ།",
    "རིགས་པ་དང་མི་རིགས་པ་དཔྱོད་པར་ནུས་པའི་བློ་གྲོས་ཅན།",
    "མགོན་པོ་འཇམ་པའི་དབྱངས་ཀྱི་མཁྱེན་པའི་ཆུ་གཏེར་ལས།",
    "ལེགས་པར་འཁྲུངས་པའི་བསྟན་འཛིན་ཡིད་བཞིན་གྱི་ནོར་བུ།",
    "འོན་ཀྱང་ཐུབ་པའི་བཀའ་རབ་འབྱམས་ལ་མཁྱེན་པའི་སྤྱན་རྒྱས་ཤིང་།",
    "འགྲོ་བ་མཐའ་དག་ལ་བུ་གཅིག་པའི་མ་ལྟར་བརྩེ་བའི་ཐུགས་རྗེ་སྙོམས་པར་འཇུག་པས།",
    "ཀུན་མཁྱེན་གྱི་གསུང་དང་ལས་ཀྱི་རྣམ་སྨིན་ལ་རྐྱེན་གྱིས་མི་འཕྲོག་པའི་ཡིད་ཆེས་རྙེད་པ།",
    "བསྟན་བཅོས་འདི་ནི་ཆུ་གཏེར་ཇི་བཞིན་གཏིང་མཐའ་དཔག་པར་དཀའ་བ་དང་།",
    "ཁོ་བོའི་བློ་གྲོས་ཀུ་ཤའི་རྩེ་ལྟར་ཅུང་ཟད་བགྲོད་པར་མི་ནུས་པས།",
    "ཚིག་དོན་རྒྱ་ཆེ་ལེགས་པར་འབྱེད་པའི་གཞུང་ལུགས་རྩོམ་པར་མི་ནུས་ཀྱང་།",
    "བདེན་གཉིས་གནས་ལུགས་ལེགས་པར་རྟོགས་པའི་བློ་གྲོས་ཀུན་དའི་ཚལ་རྒྱས་ནས།",
    "གཟུར་གནས་བློ་ལྡན་མཁས་པ་རྣམས་ཀྱིས་བཟོད་པའི་ཆབ་ཀྱིས་དག་པར་མཛོད།",
    "དེ་ཕྱིར་བདེན་པར་སྨྲ་བའང་བརྒྱ་ལམ་ཙམ།",
    "མཁས་པའི་དགོངས་པ་འཁྲུལ་མེད་ལེགས་པར་བཤད།",
    "རྟོགས་པར་དཀའ་བའི་དོན་རྣམས་ཤིན་ཏུ་གསལ།",
    "གེགས་མེད་ཅི་དགར་ལོངས་ལ་དགྱེས་པར་རོལ།",
    "ཐུབ་པས་བཀའ་བསྒོ་ཞལ་གྱིས་བཞེས་པ་རྣམས།",
    "འཇམ་དཔལ་ཡོན་ཏན་ཡེ་ཤེས་བཟང་པོའི་བསྟོད་སྒྲུབ་བཞུགས།",
    "འཇམ་དབྱངས་སྨྲ་བའི་སེངྒེ་ལ་བསྟོད་པ་བཞུགས།",
    "མགོན་པོ་འཇམ་པའི་དབྱངས་ཀྱི་མཁྱེན་རབ་ལ་བསྟོད་པ་དབྱངས་ཅན་གྱི་ང་རོ་བཞུབ་པའི་དབུའོ།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མའི་བསྟོད་པ་བཞུགས་སོ།",
    "ཞལ་ཆེམས་ལགས་སོ།",
    "དཔལ་ལྡན་ས་སྐྱ་པའི་རྩ་ཚེའི་ཞུས་ལན་བཞུགས་པའི་དབུའོ།",
    "ཞུས་ལན་གསལ་བ་རིན་ཆེན་བཞུགས་པའི་དབུ་ཕྱོགས།",
    "༤༤ འཇམ་དཔལ་སྒྱུ་བའི་སེང་གེའི་སྒྲུབ་ཐབས་དང་ལས་སྦྱོར་ལ་སོཊ་ཆ་ཚང་བའི་ཐོ་ཡིག་ཕྱོགས་གཅིག་བསྒྲིཊ་བདོག་སེངྒེ་སྒྲའི་སྒྲུབ་ཐབས་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "དོན་ཡོད་ཞགས་པ་ལྷ་ལྔའི་མངོན་རྟོགས་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "འཕགས་པ་བཅུ་གཅིག་ཞལ་གྱི་གཟུངས་སྒྲུབ་ཀྱི་ཕྱག་ལེན་བཞུགས་པའི་དབུའོ།",
    "བཅོམ་ལྡན་འདམ་འོད་ཟེར་ཅན་མའི་སྒྲུབ་ཐབས་ཀྱི་རིམ་པ་དང་དཀྱིལ་འཁོར་གྱི་ཆོག་བཞུགས།",
    "པདྨ་རིགས་ཀྱི་ལྷ་གསུམ་དྲིལ་ནས་སྒྲུབ་པའི་ཐབས་བཞུགས་སོ།",
    "རྨེ་བརྩེགས་རྗེས་གནང་ངོ།",
    "ཁྲོ་བོ་སྟོབས་པོ་ཚེའི་སྒྲུབ་མཆོད་ཀྱི་ཆོ་ག་བཞུགས།",
    "འཕགས་མ་གདུགས་དཀར་གྱིདཀྱིལ་ཆོག་བཞུགས།",
    "འཕགས་མ་གདུགས་དཀར་གྱི་གཏོར་ཆོག་བཞུགས།",
    "འཕགས་མ་གདུགས་དཀར་གྱི་སྒྲུབ་ཐབས་བཞུགས་སོ།",
    "འཕགས་མ་གདུགས་དཀར་གྱི་བསྲུང་འཁོར་དང་རྒྱལ་མཚན་བྱ་ཐབས་བཞུགས།",
    "འཕགས་མ་རྨི་ལམ་སྒྲོལ་མའི་གདམས་པ་བཞུགས་སོ།",
    "འཕགས་མ་སྒྲོལ་མ་ལྷ་བཅུ་བདུན་གྱི་དཀྱིལ་འཁོར་ལ་བསྟོད་པ་བཞུགས་པའི་དབུའོ།",
    "སྒྲོལ་མ་ཉི་ཤུ་རྩ་གཅིག་པའི་འདོན་ཐབས་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "མི་གཡོ་བ་དཀར་པོའི་མངོན་རྟོགས་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "མི་གཡོ་བ་དཀར་པོའི་ཞལ་ཤེས་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "སུམ་དྲིལ་ནས་སྒྲུབ་པའི་ཐབས་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "འཕགས་པ་སྨུགས་འཛིན་རྣམ་གཉིས་ལ་ཆུ་འབུལ་བའི་ཚུལ་བཞུགས་པའི་དབུའོ།",
    "འཕགས་པ་ཛམྦྷ་ལའི་འཁོར་ལོ་འབྲི་བའི་མན་ངག་བཞུགས་པའི་དབུའོ།",
    "རྣམ་རྒྱལ་སྟོང་མཆོད་ཀྱི་ལག་ལེན་གསལ་བའི་སྒྲོན་མེ་བཞུགས།",
    "འཕགས་པ་རྟོགས་པ་ཆེན་པོའི་ཆོ་གའི་ཟུར་འདེབས་དང་ཐོ་ཡིག་ལགས་སོ།",
    "མགོན་པོ་མི་འཁྲུགས་པའི་སྒྲུབ་དཀྱིལ་བཞུགས།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་ཟིན་བྲིས་བཞུགས་པའི་དབུ་ཕྱོགས་ཡིན།",
    "གསང་འདུས་ཁྲིད་ཡིག་ལ་ཉེར་མཁོའི་ཟིན་བྲིས་བཞུགས་སོ།",
    "ཤིན་ཏུ་སྤྲོས་མེད་ཀྱི་ཁྲིད་ཡིག་བཞུགས་པའི་དབུའོ།",
    "སེམས་ཉིད་ངལ་བསོའི་ཁྲིད་ཡིག་བཞུགས་པའི་དབུ་ཕྱོགས་སོ།",
    "བདེ་མཆོག་ལྷན་སྐྱེས་ཀྱི་བྱིན་བརླབས་ལག་ལེན་བཞུགས་སོ།",
