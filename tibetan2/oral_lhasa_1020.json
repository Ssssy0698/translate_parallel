    "ཟླ་ཤེལ་བདུད་རྩི་མ་སོགས་སྐབས་ཐོབ་བསྟེན་པར་བྱའོ།",
    "ཞེས་གསུངས་པ་ལྟར་ཐོག་མར་རྨེན་བུ་ཞེས་པ་ནི།",
    "ཁྲག་དང་ཚིལ་ལ་བརྟེན་ནས་གནས་པའི་ལུས་ཀྱི་གྲུབ་ཆ་ཁྱད་པར་བ་ཞིག་ཡིན་ཞིང་།",
    "ཞེས་གསུངས་པ་ལྟར་རོ།",
    "རྨེན་བུ་ལ་བརྟེན་སྐྲངས་པར་འགྱུར།",
    "ཡང་ན་སྐྲངས་པ་གཡོ་བ་སྟེ་ཆེ་ཆུང་འཕེལ་འབྲི་བྱེད་པ་འམ་གནས་གཅིག་ཏུ་མ་ངེས་པར་གནས་གཞན་དུ་འཕོ་སྐྱེན་པའོ།",
    "དེ་དག་ལས་ཁྱད་པར་དུ་སྐྲངས་པ་སྲ་ལ་རྣག་ཏུ་སྨིན་དཀའ་བ།",
    "མ་ཞི་སྟེང་དུ་མེ་ཡིས་འཚོས་པར་བསྲེག།",
    "དེས་ཀྱང་མ་ཞི་ན་སྟེང་དུ་མེ་ཡིས་ཚོས་པར་བསྲེག་པས་ཞི་བར་འགྱུར་རོ།",
    "བྱ་བྲ་སྟེ་ཕུག་རོན་བྲུན་གྱིས་སྐྲངས་པ་རྣག་ཏུ་འགུག་པར་བྱའོ།",
    "བུལ་ཏོག་དྲི་ཆུ་སྦྱར་བ་བྱུག་པར་བྱ།",
    "རྣག་ཏུ་ཁུགས་ནས་འབྲས་ལྟར་བཅོས་པར་བྱ།",
    "བྲག་ཞུན་བུལ་ཏོག་རྣམས་དྲི་ཆུར་སྦྱར་བས་བྱུག་པར་བྱ་བ་དང་།",
    "ཞེས་བྱས་པའི་སྦྱོར་བ་ཞུན་ནན་གང་འཕྲོད་བྱས་པས་རྣག་ཏུ་ཁུགས་ནས་འབྲས་ལྟ་བུར་བཅོས་པ་བྱ།",
    "དེ་ལྟར་བཅོས་པས་རྨེན་བུ་ཟུག་ཆུང་ཞིང་སྐྲངས་པ་སྨིན་ནས་རྨེན་བུའི་སྐྲངས་རོ་རབ་ཏུ་འཕྱང་ན་རྩ་བ་ནས་བཅད་ལ་བསྲེག་པར་བྱའོ།",
    "འབྲུ་མར་བཅས་བཏབ་པའི་ཨ་ས་བ་ཡིས་བདུག་པར་བྱ་བའོ།",
    "ཧོང་ལེན་རྣམས་དྲི་ཆུར་སྦྱར་བ་བྱུག་པར་བྱ་བ་ཡིན་ནོ།",
    "ཡང་ན་ལྡེ་གུ་བྱས་ཏེ་བྱུག་པར་བྱ་དགོས་པ་ཡིན་ནོ།",
    "དེ་རྗེས་འབྲས་གར་ཡོད་སྟེང་མེ་བཙས་བསྲེག་པར་བྱ་དགོས་པ་ཡིན་ནོ།",
    "གཏར་བསྲེག་དུགས་ལུམས་བྱུག་པ་གང་འོས་རྒྱུད་དུ་གསུངས་པ་བཞིན་རིགས་པས་འཕྲུལ་པ་གལ་ཆེའོ།",
    "བཅོས་ཐབས་བཅས་ས་བཅད་བཞིའི་སྒོ་ནས་བསྟན་པར་བྱ་སྟེ།",
    "ལམ་ལོག་རླིག་པར་ཞུགས་ཏེ་སྐྲངས་པར་བྱེད།",
    "ཆུ་སོ་རླིག་པར་ཕྱིན་པ་དང་།",
    "རླིག་པར་རྒྱུ་བའི་རྩ་དག་ནི།",
    "རྒྱུ་རླུགས་བརླན་གཤེར་ས་རུ་བསྡད་པ་དང་།",
    "འོག་ཏུ་སྐྲངས་པར་བྱེད་པར་འགྱུར།",
    "དེའི་རྟགས་སུ་རྐྱལ་པ་ཆུས་གང་བ་ལྟར་གཡོ་ཞིང་འགུལ་བར་འཁྲུག་པར་འགྱུར་ལ།",
    "རླིག་པའི་འོག་ཏུ་གདུ་བུ་ལྟར་སྐྲངས་བར་བྱེད་པར་གྱུར་རོ།",
    "སྣེ་ས་རླིག་པར་འཕུལ་ལ་སྦོ་ཞིང་གཟེར།",
    "ཡན་ལག་ལོག་པར་གཅུས་པ་དང་།"
  ]
}