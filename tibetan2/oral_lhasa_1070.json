    "མཐུན་ཕྱོགས་ལ་ཁྱབ་པར་མཐོང་བ།",
    "སྒྲ་རྩོལ་བྱུང་མིན་པར་བསྒྲུབ་པ་ལ།",
    "སྒྲ་རྟག་པར་བསྒྲུབ་པ་ལ།",
    "ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་ཏེ།",
    "བྱས་པའི་ཕྱིར་ཞེས་བཀོད་པ་ལྟ་བུའོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཡིན་ཏེ།",
    "བྱས་པའི་ཕྱིར།",
    "སྒྲ་རྟག་སྟེ་བྱས་པའི་ཕྱིར་ལྟ་བུ།",
    "མི་དམིགས་པ་རང་བཞིན་གྱི་གཏན་ཚིགས་སུ་མ་བསྡུས་པར་སྦྱོར་བ་གསུམ་དུ་བྱེད་པ་ན་དེ་བཟློག་པའི་འགལ་བའངགསུམ་སྟེ།",
    "ངོ་བོ་དང་ཁྱད་པར་གཉིས་འགོག་པའི་འགལ་བ་བཞི་ཞེས་ཟེར་ཏེ།",
    "མ་བྱས་པའི་ཕྱིར།",
    "ནམ་མཁའ་མ་བྱས་ཤིང་ཡོད་པར་འདོད་མཁན་ལ།",
    "མ་བྱས་པའི་ཕྱིར།",
    "བྱས་པའི་ཕྱིར་ཞེས་པ་ལྟ་བུ།",
    "འདུས་པ་མ་ཡིན་པའི་ཡུལ་ཅན་གཞན་གྱི་དོན་བྱེད་པ་ཡིན་ནོ་ཞེས་དོན་ཉིད་ལ་དབྱེ་བ་བྱེད་པ་ནི་རིགས་པ་དང་གཞུང་མི་འཕྲོད་པས་ལེགས་པ་མ་ཡིན་ནོ་ཞེས་ས་པཎ་གསུངས།",
    "རྟག་པའི་སྒྲ་ལས་སྒྲ་ཁྱད་པར་དུ་བྱས་པའོ།",
    "སྒྲ་མིན་པའི་རྟག་པ་ལས་སྒྲ་ཁྱད་པར་དུ་བྱས་པའོ།",
    "དེ་གཉིས་ཀས་ཀྱང་སྒྲ་མི་རྟག་པར་རྟོགས་པར་འདོད་པས་དོན་ལ་ཁྱད་མེད་དོ།",
    "དེ་དག་བྱས་པའི་རྟགས་ཀྱི་རྟོགས་པར་ནུས་པས་ཡང་དག་ཡིན་ལ།",
    "འདུས་ཤིང་བསགས་པའི་ཕྱིར་ཞེས་པ་ལ་སོགས་པས་རྟོགས་པར་མི་ནུས་པའི་ཕྱིར་འགལ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་རྟགས་ལྟར་སྣང་ལ་དབྱེ་བ་དུ་མ་བྱས་པ་དེ་བཞིན་རྟགས་ཡང་དག་ལའང་དབྱེ་བ་རིགས་སོ་ཞེ་ན།",
    "མ་གྲུབ་པར་ཤེས་ཀྱང་རྟགས་དེ་ལྟར་བཀོད་ན་ཞེས་མཐའ་བཅད་པའོ།",
    "སྒྲུབ་བྱེད་བརྗོད་པ་ཁས་ལེན་པ་རྒོལ་བ་དེ་ལ་སུན་འབྱིན་བརྗོད་པར་ཁས་ལེན་པ་ཕྱིར་རྒོལ་བ།",
    "བྱས་པའི་ཕྱིར་ལྟ་བུ་ལ་འདོད་ལན་ཐེབས་པ་ལྟར་སྣང་བ་དང་།",
    "སྒྲ་རྟག་པར་ཁས་ལེན་པ་ལ།",
    "དེ་ལ་རྟག་པས་ཁྱབ་པར་སྨྲ་བ་ལ།",
    "བྱས་པ་ལ་རྟག་པས་ཁྱབ་པར་སྨྲ་བ་ལ།",
    "བྱས་པའི་ཕྱིར་ཞེས་བརྗོད་པ་ལྟ་བུ་སྟེ།",
    "སྒྲ་རྟག་པར་སྨྲ་བ་ལ།",
    "ཁྱབ་པ་མ་ངེས་པ་གཉིས་སུ་ཕྱེས་ནས་བཞིར་གདབ་གསུངས།",
    "འདོད་ཆགས་དང་བྲལ་བས་བྱས་པའི་ཕྱིར་ལྟ་བུའམ།",
    "བཞི་པ་ལ་མི་སྲིད་པར་དོགས་པ།",
    "མ་ཁྱབ་པར་དོགས་པ།",
    "བྱས་པའི་ཕྱིར་ལྟ་བུ།",
    "སྐྱེས་བུས་བྱས་པའི་ཕྱིར་ལྟ་བུ།",
    "དངོས་པོ་ཕལ་ཆེར་མི་རྟག་པར་འདོད་ཀྱང་།",
    "རྣམ་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "སྒྲ་རྟག་པར་འདོད་ངོར།",
    "བྱས་པའི་ཕྱིར་ལྟ་བུ།",
    "བྱས་པའི་ཕྱིར།",
    "ཕྱོགས་གཉིས་ཀར་འཇུག་པར་སྣང་བ།",
    "དང་པོར་ཕྱོགས་གཉིས་ཀར་ཁྱབ་པར་ཞུགས་པ་སྒྲ་མི་རྟག་སྟེ།",
    "བྱས་པའི་ཕྱིར་ལྟ་བུ།",
    "བྱས་པ་དང་།",
    "མི་མཐུན་ཕྱོགས་ལ་མེད་པར་མ་ངེས་ནས་ཐེ་ཚོམ་བསྐྱེད་པའོ།",
    "བྱས་པའི་ཕྱིར་ལྟ་བུ།",
    "རྟག་པ་དང་བྱས་པ་འགལ་བར་མི་ཤེས་པ་ལ་བཀོད་ན།",
    "ངག་སྨྲ་བའི་རྟགས་ལས་སྐྱེས་བུ་ཐམས་ཅད་མཁྱེན་པ་མིན་པའམ་ཡིན་པར་དཔག་ན་ལྷག་ལྡན་གཉིས་པོ་འདྲ་ཡང་དོན་གྱི་ཕྱོགས་གཉིས་ཀར་འཇུག་ཟུར་བྱང་།",
    "པར་འགྱུར་བས་ལོགས་སུ་མེད་དོ།",
    "རྟགས་དེས་བསྒྲུབ་བྱ་ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པར་ངེས་པ།",
    "སྒྲ་རྟག་པར་ཁས་ལེན་པའི་ངོར།",
    "དེས་རྟགས་ཡང་དག་མིན་པར་མི་འགྱུར་ལ།",
    "རྟགས་ཡང་དག་ཏུ་མི་རུང་བས་དོན་གྱི་རྟགས་ལྟར་སྣང་དང་ཡང་དག་དཔྱད་པར་བྱའོ།",
    "རྟགས་མི་མཐུན་པའི་དཔེ་ལས་ལྡོག་པར་ངེས་པའི་ཚུལ་གྱིས་རྟགས་དེ་བསྒྲུབ་བྱ་ལ་གྲུབ་པའི་རྟགས་སུ་ངེས་ནས།",
    "འབྲེལ་མེད་གཞན་གྱིས་དེ་གྲུབ་པར་མི་ནུས་པས་སོ།",
    "དེ་ལ་སྣང་མི་རུང་མི་དམིགས་པ་ཙམ་གྱིས་མེད་པར་མི་འགྲུབ་ཀྱང་།",
    "དེས་ཁྱད་པར་དུ་བྱས་པའི་བརྒྱུད་འགལ་དམིགས་པ་སྟེ།",
    "བསྒྲུབ་བྱར་མི་རུང་བས་སྐབས་སུ་བབ་པའི་དོན་དེ་ཉིད་རྒོལ་བས་སྒྲུབ་པར་དམ་བཅའ་ཞིང་།",
    "ཕྱིར་རྒོལ་གྱིས་སུན་འབྱིན་པར་ཁས་བླང་བ་ཞིག་རྩོད་གཞིར་འཛིན་ནོ།",
    "བྱས་པའི་ཕྱིར་རམ་སྐྱེས་པའི་ཕྱིར་ལྟ་བུ་ཁྱད་པར་ལྟོས་པའི་རང་བཞིན་གྱི་རྟགས་སྦྱོར།",
    "ལྟ་བུ་ཁྱད་པར་དག་པ་བའི་རང་བཞིན་གྱི་རྟགས་སྦྱོར་ཏེགཉིས་སོ།",
    "དུ་བ་དྲག་ཏུ་ཕྱུར་བས་ཁྱབ་པར་ནོན་པ་ཡིན་པའི་ཕྱིར།",
    "དུ་བ་དྲག་ཏུ་ཕྱུར་བས་ཁྱབ་པར་ནོན་པ་ཡིན་པའི་ཕྱིར་ཞེས་པ་རྒྱུ་དང་འགལ་བའི་འབྲས་བུ་དམིགས་པ།",
    "དུ་བ་དྲག་ཏུ་ཕྱུར་བས་ཁྱབ་པར་ནོན་པ་ཡིན་པའི་ཕྱིར་ཞེས་པ་འབྲས་བུ་དང་འགལ་བའི་འབྲས་བུ་དམིགས་པ།",
    "དུ་བ་དྲག་ཏུ་ཕྱུར་བས་ཁྱབ་པར་ནོན་པ་ཡིན་པའི་ཕྱིར་ཞེས་པ་ཁྱབ་བྱ་དང་འགལ་བའི་འབྲས་བུ་དམིགས་པ་བཞི་དང་།",
    "ཙན་དན་གྱི་མེས་ཁྱབ་པར་ནོན་པ་ཡིན་པའི་ཕྱིར།",
    "ཙནྡན་གྱི་མེས་ཁྱབ་པར་ནོན་པའི་ཕྱིར་ཞེས་པ་རྒྱུ་དང་འགལ་བའི་ཁྱབ་བྱ་དམིགས་པ།",
    "ཙན་དན་གྱི་མེས་ཁྱབ་པར་ནོན་པའི་ཕྱིར་ཞེས་པ།",
    "ཙན་དན་གྱི་མེས་ཁྱབ་པར་ནོན་པ་ཡིན་པའི་ཕྱིར་ཞེས་པ།",
    "བྱས་པའི་ཕྱིར་རམ།",
    "ཕུལ་བྱུང་མཁྱེན་རབ་རལ་གྲི་འབར་བའི་གཟིས།",
    "ལ་སྡུག་བསྔལ་ལས་བསྒྲལ་བར་བཞེད་པའི་ཕན་པར་བཞེད་པས།",
    "རྩིང་ཞིབ་ཀྱི་རྟོག་དཔྱོད་ལྟ་བུ་དེ་མིན་གྱི་སྒྲ་དོན་འདྲེས་པར་འཛིན་པའམ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "བྱའི་དོན་ལ་ལྟོས་ནས་རྟོག་མེད་མ་ཡིན་ཏེ་དོན་དེར་སྒྲ་དང་འདྲེས་པར་རྟོག་པའི་ཕྱིར།",
    "འདིས་རྗེས་སུ་དཔོག་པར་བྱེད་པའི་རྟགས་འཛིན་སྟོན་པ་རྗེས་སུ་དཔག་པར་རྟོགས་པ་དང་།",
    "ཡུལ་སྣང་དང་ཤེས་སྣང་སོ་སོར་དྲན་ཏེ་གཅིག་ཡིན་ན་ཡུལ་དྲན་པ་དང་ཤེས་པ་དྲན་པ་ལ་ཁྱད་མེད་པར་མི་འགྱུར་བར་དྲན་རྒྱུ་ཡོད་པས་སོ།",
    "དེ་ལ་གཉིས་མེད་ན་ཤེས་པ་དང་པོ་ཡུལ་དང་ཁྱད་མེད་དུ་སྣང་ལ་ཤེས་པ་ཕྱི་མ་རྣམས་ཡུལ་དང་བཅས་པར་མི་དྲན་ཏེ།",
    "དེ་ལྟར་དངོས་སུ་ཚུལ་གཉིས་གྲུབ་པ་དང་ནི་རང་རིག་ཀྱང་གྲུབ་པར་འགྱུར་ཏེ་ཚུལ་གཉིས་དང་ནི་རང་རིག་གྲུབ་པ་གཅིག་པས་སམ་ཁྱད་མེད་དེ།",
    "དོན་དེ་དང་མཐུན་པར་སྐྱེས་པ་ཞིག་ལ་ཟེར་རམ་མ་མཐུན་ཀྱང་རྒྱུ་བྱེད་པ་ཙམ་གྱིས་ཡིན།",
    "སྐད་ཅིག་མ་དང་རྡུལ་ཕྲན་ཚོགས་པ་ཡིན་པས་དོན་དངོས་དེ་ལ་ཐ་སྙད་དུ་མ་བྱས་ཏེ་མི་ནུས་པས་སོ།",
    "རྡུལ་ཕྲན་སོ་སོ་བ་ལ་དམིགས་ཀྱང་དེའི་སྒོ་ནས་ཐ་སྙད་དུ་མ་བྱས་ཞེས་ཀྱང་གསུངས།",
    "རྡུལ་སིལ་བུ་པ་མིན་པའི་ཚོགས་པའམ་སྤྱི་ཡི་ཚུལ་གྱིས་བསྟན་པར་བྱ་བ་ཡིན་པ།",
    "ཡུལ་ལ་འཛིན་པར་ནུས་མ་ཡིན་ཏེ་རྟེན་དང་བྲལ་བས་སོ།",
    "དེ་འཇལ་བ་རྟགས་ལ་ནི་མི་ལྟོས་པར་ཤེས་ལ།",
    "དོན་གཞན་ཁྱད་པར་ཅན་ཤེས་པ་འབྲས་བུར་སྨྲ་བར་འགྱུར་ན་ནི།",
    "ཁྱད་པར་གཟུང་བ་ཙམ་ཁྱད་པར་བྱེད་པ་བཟུང་བ་ཡིན་ལ།",
    "ཁྱད་པར་ཅན་ཀུན་བཏུས་མཚན་འགྲེལབཟུང་བ་ཁྱད་པར་དུ་བྱ་བའི་གཞི་ཡིན་པས་སོ་སྙམ་ན།",
    "ཁྱད་པར་ལ་དེར་ཤེས་པ་མིན་ཏེ་དེ་གཉིས་ཡུལ་ཐ་དད་པའི་ཕྱིར།",
    "ཁྱད་པར་བྱེད་ཤེས་དེ་ལ་ཁྱད་པར་དེ་རྟོགས་པ་ཡོད་པ་མིན་ནོ་གལ་ཏེ་བྱེད་ཤེས་དེ་ལ་ཚད་གཞལ་གཉིས་ཀར་འགྱུར་ཤེ་ན།",
    "མ་ཡིན་ཏེ་དེ་ལྟ་ན་ཁྱད་པར་བྱ་བའི་ཤེས་པ་ལའང་གཉིས་ཀར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ལྔ་པོ་དེ་རྣམས་དང་ཁྱད་པར་ཅན་སྦྱར་བར་མི་བྱ་བ་ཡིན་ནོ།",
    "དུ་མས་གཟུང་བྱ་ནི་གཅིག་མིན་ཏེ་ཡིན་ན་གཟུགས་དང་སྒྲ་ལ་སོགས་ཀྱང་གཅིག་པར་འགྱུར་རོ།",
    "གཟུགས་སོགས་སོ་སོ་ལའང་དབ༵ང་པོ་ཀུན་གྱིས་རང་ཡུལ་འཛིན་པར་འགྱུར་ཏེ་མི་ཕམ་བཀའ་འབུམ།",
    "ཡུལ་ཀུན་གཅིག་ཡིན་པས་ཐ་དད་མེད་པར་འགྱུར།",
    "རང་བཞིན་འཛིན་ན་དོན་གྱི་བྱེ་བྲག་འཛིན་པར་མི་འགྱུར།",
    "རྣམ་འགྱུར་རམ་འབྲུས་བུ་སྒྲ་ལ་སོགས་པའི་ངོ་བོར་མཚོན་ཅིང་འགྲུབ་པར་བྱེད་པ་ཡིན་དགོས་ནའང་།",
    "ལས་གང་དམིགས་སྐྱེ་བའམ་རྣམ་འགྱུར་ཁྱད་པར་ཅན་ཡིན་ནོ།",
    "ཡོད་པ་ཞེས་པའི་བསལ་བྱ་མེད་པ༵་སྟེ་ཡང་དག་པར་ཕྲད་ན་ཡོད་པས་ཁྱབ་པས་སོ་མེད་པ་ལ་ཕྲད་པ་མེད་ཀུན་བཏུས་མཆན་འགྲེལ།",
    "དོ་ ཡང་དག་པར་ཕྲད་ཅེས་པ༵་ལས་དེ་རིག་བྱ་ཡིན་པས་སོ།",
    "གང་དང་ཕྲད་པར་དོགས་པའི་ལན་དུ་ཡོད་པ་དང་ཕྲད་པ་ཞེས་བསྟན་ཏོ་ཞེས་ན།",
    "དཔེར་ན་འགྲོ་ཚད་ལ་འགྲོ་ལྡན་མ་གྲགས་པར་བ་ལང་ཁོ་ན་ལ་གྲགས་པ་ལྟར།",
    "མིག་སོགས་དམ་པར་གྲུབ་ཟིན་ལ་མི་བཟུང་བར་ཡུལ་ལམ་དོན་ཁོ་ན་ལ་སྐབས་འདིར་བཟུང་ངོ་ཞེ་ན།",
    "གལ་ཏེ་དོན་ཁོ་ནས་མཛེས་སོགས་སུ་གྲུབ་པར་གྲགས་ལས་དེ་ལྟར་བརྟག༵་གྲྭང་ན།",
    "དོན་ལས་ལྷག་པ་ཆེན་པོའང་འཛིན་པར་མཐོང་བས་ན།",
    "བར་དུ་མ་ཆོད་པར་འདོད་པ༵་ལ་གནོད་དོ།",
    "གལ་ཏེ་རྒྱུ་སྐྱེས་བུ་རྣམ་པར་འགྱུར་ནས་བློ།",
    "འབྲེལ་བ་ནི་བསྒྲུབ་བྱར་བརྗོད་པར་མི་བྱ་བ་སྟེ་ལ་ལ་མེ་ཡོད་ཅེས་བརྗོད་ཀྱི་ལ་དང་མེ་འབྲེལ་ཞེས་བརྗོད་བྱ་མིན་པས་སོ།",
    "ཡང་ན་དགག་སྒྲུབ་ཐམས་ཅད་ཅིག་ཆར་རྟོགས་པར་འགྱུར་རོ་ དེ་ཡང་དུ་བྱས་ཀྱིས་མེ་མི་རྟག་མི་རྟོགས་ཏེ།",
    "ཇི་ལྟར་མཐོང་བ་བཞིན་དུ་རྟོགས་ན་ནི་གསལ་རྣོ་སོགས་བྱེ་བྲག་ཀུན་ཀྱང་རྟོགས་པར་འགྱུར་རོ།",
    "རྟོགས་པ་ནི་མི་ངེས་པར་རབ་ཏུ་འཁྲུལ་པའི་ཕྱིར།",
    "ཡང་དཔེར་ན་བྱས་མི་རྟག་ཁྱབ་མཉམ་པས་བྱས་པ་རྟགས་སུ་འགྱུར་བ་བཞིན་རྟགས་ཅན་དུ་ཡང་འགྱུར་ཏེ།",
    "དཔེར་ན་གློག་ལྟ་བུ་བྱས་པ་ལྐོག་གྱུར་མི་རྟག་མངོན་གྱུར་ལམ་རྟག་པས་བྱས་པ་སྒྲུབ་པ་དང་།",
    "མ་བྱས་རྟག་སོགས་སོ་སོར་བཀག་པའི་ཆ་ལ་ཕན་ཚུན་མི་འཁྲུལ་བ་ཡོད་པ།",
    "བྱས་པས་མི་རྟག་པ་ལ་ཁྱབ་ཏུ་ཟིན་ཀྱང་རྟག་པ་ཉིད་བཀག་ནས་གོ་བ་དེ་བཞིན་མི་རྟག་པས་བྱས་པ་ལ་ཁྱབ་པ་ཉིད་ཀྱིས་ཀྱང་མ་བྱས་པ་བཀག་གོ།",
    "བྱས་པ་ཉིད་ཀྱིས་འཇིག་པ་ལ།",
    "ཁྱབ་པ་ནི་འབྲེལ་བ་ཉིད་ཀྱིས་སོ་མ་བྱས་པ་ཡིས་ཁྱབ་པ་མིན་པ་ནི་འགལ་བས་སོ།",
    "མ་བྱས་པ་ཡི་དོན་གྱིས་སྟོན།",
    "འདི་མཐོང་ཞེས་ཇི་ལྟར་བརྗོད་པར་བྱ་ཞེས་སོ།",
    "རྒྱུ་སྔ་མ་ཡིན་ལ་འབྲས་བུ་ལྷག་མ་ཡིན་པས་དེས་ཐ་སྙད་བྱས་པ།",
    "དེ་གཉིས་ཀྱི་འབྲེལ་དོན་གཞན་ལསཀྱང་དེ་གཉིས་མཚུངས་པར་རྟོགས་མི་འགྱུར།",
