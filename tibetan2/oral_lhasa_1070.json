    "ལར་བྱེ་བྲག་པས་སྒྲ་མི་རྟག་སྟེ་བྱས་ཕྱིར་བུམ་བཞིན།",
    "ཡང་སྒྲ་རྟག་སྟེ་བྱས་པའི་ཕྱིར་དང་།",
    "རློམ་ཡང་དེ་མིན་ཏེ་གང་ཐེ་ཚོམ་ལ་གཏན་ཕེབས་སམ་ངེས་པ་མེད་གང་ཀུན་བཏུས་མཆན་འགྲེལགཏན་ཕེབས་ལ་ཐེ་ཚོམ་མི་ཤེས་སོ།",
    "གང་མཚན་ཉིད་གཉིས་དང་ལྡན་པར་རློམ་པ་དེ་ནི་ཇི་སྲིད་གཉིས་གཉིས་སུ་འདོད་ལ།",
    "ཡང་མི་རྟག་ལྟ་བུ་གཅིག་བྱས་པ་རྩོལ་བྱུང་འདུས་བྱས་སོགས་རྟགས་མང་པོས་བསྒྲུབ་པ་འགལ་ཞེ་ན་མིན་ཏེ།",
    "གལ་ཏེ་ཕྱོགས་གཉིས་ཀ་ལ་ངེས་པར་རྗེས་ཞུགས་པ༵་དང་གཉིས་ཀ་ལ་མ་ཞུགས་པས་ཐེ་ཚོམ་གྱི་རྒྱུ་ཡིན་ན།",
    "ཕྱོགས་གཉིས་གང་རུང་གཅིག་ལ་ངེས་པར་ཞུགས་པ་མིན་ཞིང་གཉིས་ཀ་ལས་ངེས་པར་ལོག་པ༵འང་མིན་པ་གཉིས་ཀ་གྲུབ་པའི་རྟགས་སུ་འགྱུར་རོ་ཞེ་ན།",
    "གཞལ་བྱ་རྟག་མི་རྟག་གཉིས་ལ་ཁྱབ་བྱེད་དུ་ཞུགས་པས་མ་ངེས་ན་བྱས་པས་མི་རྟག་པ་སྒྲུབ་པ་ལའང་རྩོལ་བྱུང་མ་བྱུང་གཉིས་ཀ་ལ་ཚང་བས་ཐེ་ཚོམ་སུ་འགྱུར་ཞེ་ན།",
    "མིན་ཏེ་བྱས་པའི་སྒྲ་ཀུན་བཏུས་མཆན་འགྲེལ།",
    "གལ་ཏེ་མི་མཐུན་བཅད་པ་ལ་མི་ལྟོས་པར་ཞུགས་པ་བཞིན་དེའི་བྱེ་བྲག་ཀུན་གྲུབ༵་ན།",
    "གཟུགས་ལ་ཡོན་རྟེན་གཉིས་ཡོན་ཏན་ལ་རྟེན་པ་གཅིག་ཅེས་གསུངས།",
    "ལུགས་ལྡོག་རྟེན་པ་ལ་ཡོན་ཏན་གཟུགས་དཀར་པོ་གསུམ་སོགས་གཉིས་གཅིག་བར་དུ་གསུངས།",
    "གཉིས་དུས་གཅིག་ཏུ་རྟོགས་པར་འགྱུར།",
    "དེ་མཐུན་ཁོ་ན་ཞེས་ངེས་པར་བཟུང་ཟེར།",
    "དཔེར་ན་བྱས་པ་ཉིད་མི་རྟག་དང་བདག་མེད་སོགས་དུ་མ་དང་མེད་ན་མི་འབྱུང་ཡིན་པ་བཞིན་ནོ།",
    "ལས་ཞེས་པས་དཔེ་ལ་སྒྲུབ་བྱེད་ལོགས་སུ་མེད་པར་བསྟན་ཏེ་སྒྲུབ་བྱེད་ཀྱི་དཔེ་ཞེས་བསྟན་པའམ།",
    "ཤེས་འདོད་སོགས་སྒྲུབ་བྱེད་ཉིད་དུ་མི་རིགས་པས་གཏན་ཚིགས་མིན་ཞེ་ན་སྒྲུབ་བྱེད་ཅེས་དངོས་བརྒྱུད་གཉིས་ཀ་གང་ཡིན་ནའང་སྐྱོན་གཞན་དུ་འཐོབ་པར་འགྱུར་རོ།",
    "དེ་ཕྱིར་མཐུན་པའི་དཔེ་བསྟན་པ་ཞེས་དྲུག་པར་འགྱུར་ལ་དེ་ལ་ཡང་ལྔའི་ནང་ནས་དེ་གཅིག་གཏན་ཚིགས་བྱ་བའི་ཁྱད་པར་དོན་མེད་པར་འགྱུར་རོ།",
    "གང་འདོད་དེ་གཏན་ཚིགས་སོ་ཁྱད་པར་ཅན་དུ་གྱིས་ཤིག་སྟེ་ཐམས་ཅད་ཡིན་པའི་ཟོལ་འདིས་ཅི་བྱ་ཞེས་སོ་ ངག་གཞན་དག་སྒྲུབ་བྱེད་དུ་བཏགས་པའོ་ཟེར་ན།",
    "དུས་ལས་འདས་པ་རྣམས་གཏན་ཚིགས་ལྟར་སྣང་ངོ་ཞེས་པའི་གྲངས་ངེས་བྱས་པའི་ནང་དུ་འདུས་ལ།",
    "ཕྱིར་རྒོལ་བ་གཞན་ལ་བསྟན་པར་བྱ་བའི་དོན་དུ་གཞན་དོན་གྱི་རྗེས་སུ་དཔག་པ་རྣམ་པ་གཉིས་ཏེ།",
    "གཙོ་བོ་སྒྲུབ་པའི་གཏན་ཚིགས་ལྔ་ལྡན་ལྟ་བུ་རང་ཕྱོགས་སྒྲུབ་པ་འཛིན་པར་གྱུར་པ་རྣམ་པར་ལྡན་པ༵་དང་།",
    "གཞན་ཕྱོགས་བཀག་པའམ་བསལ་ཏེ་དེ་ཁོ་ན་འོངས་པ༵་གཞན་བཀག་ཙམ་གྱིས་རང་ཕྱོགས་གྲུབ་པར་འདོད་པའོ།",
    "རིགས་གཅིག་ཡོད་པར་ཁས་བླངས་ན་ཡང་རྟགས་དེ་གཅིག་སྒྲུབ་ལ་འགལ་བ༵་ཉིད་དོ།",
    "དེ་སྒྲུབ་ལ་རྟགས་དེ་མ་ངེས་པར་ཡང་འགྱུར་ཏེ་གཉིས་ཀར་ཡོད་པས་སོ།",
    "དེའི་དཔེ་ནི་བསྒྲུབ་བྱས་དབེན་པའམ་ཕོངས་པར་འགྱུར་ཏེ་གཙོ་བོ་དེ་ཡོད་མིན་པས་སོ།",
    "དེས་ན་གཞན་བཀག་པ་ཙམ་ལས་རང་ལུགས་འགྲུབ་པ་མིན་ཆུ་གང་བ་ནི་བཀག་པས་མིན་ཏེ་ཁྱད་པར་ལས་ཡིན་ནོ།",
    "གཞན་བཀག་པའི་རྗེས་ཐོགས་མ་ནི་བཟློག་པ༵་རང་རྒྱུད་དམ་རང་ལུགས་སྒྲུབ་པར་འདོད་པ་ལ་གཙོ་བོ་གཅིག་ཡོད་པ་ལས་སྐྱེ་བ་བསལ་བ་ལ་གནོད་བྱེད་དུ་བཀོད་པ་དེ་སྒྲུབ་བྱེད་དུ་མི་རིགས་སོ།",
    "དེ་ཡང་ཕྱོགས་ཁོ་ན་གནས་པ་མིན་པར་ཕྱོགས་ལས་གཞན་ལ་འཇུག་པའོ་ཟེར།",
    "གཏན་ཚིགས་སམ་༣ མ་ངེས་པར་འགྱུར་ཏེ་དཔེ་བསྟན་ཚད་དཔེ་ལ་འཁྲུལ་ན་དེར་འགྱུར་པས་སོ།",
    "ལྟ་བུ་སྟེ་རྟགས་དེ་ཕྱོགས་གཉིས་ཀར་ཡོད་པས་མ་ངེས་པར་འགྱུར་ལྟར་སྣང་ལོགས་སུ་བ་མིན་ནོ།",
    "བྱས་པའི་ཕྱིར་ཞེས་བརྗོད་པ་ལྟ་བུའོ་ཟེར།",
    "དོན་དེའི་ལྷག་མ་རྗེས་ལྡོག་ཚུལ་གཉིས་སུ་གྲགས་པ་དེ་ནི་དཔེ་ཡིས་སྒོ་ནས་རབ་ཏུ་སྟོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "འཇིག་པ༵་ལས་འདིར་འབྲས་བུའམ་བྱས་པ་ཉིད་དུ་ངེས་པ་ལྟ་བུའོ།",
    "དེ་ལྟ་ནའང་དཔེ་ནི་རྟགས་ལས་ལོགས་པ༵་རུ་སྒྲུབ་བྱེད་ཀྱི་ཡན་ལག་རང་རྐྱ་བ་ལྟ་བུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ་གཏན་ཚིགས་ཀྱི་ཕྱོགས་གཅིག་ཁྱབ་པའི་དོན་མཚོན་ཅིང་སྟོན་པ་ཙམ་ཡིན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་པ་རྣམས་ཆུ་ཀླུང་ན་མེ་དུ་མེད་ཅེས་པ་བཞིན་དེ་གཉིས་མེད་པར་འཇོག་པ་ཙམ་ཞིག་བརྗོད་ཀྱི་རྟགས་མིན་ནོ།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པའི་གཏན་ཚིགས་སམ་དེ་ཡི་ཁྱད་པར་དཔེ་ཙམ་བརྗོད་པ་ཡིན་ཡང་རུང་མེད་ན་མི་འབྱུང་མི་སྟོན་པར་མཚུངས་པ་ཙམ་གྱིས་བསྒྲུབ་བྱ་སྟོན་ན་ཐུག་པ༵་མེད་པར་འགྱུར།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པ་ལ་བུམ་པ་བྱས་ཕྱིར་མི་རྟག་པ་བཞིན་སྒྲ་ཡང་མི་རྟག།",
    "ཞེས་སྔ་མ་གཏན་ཚིགས་དང་བཅས་པས་སམ་ཕྱི་མ་དེའི་ཁྱད་པར་དཔེ་ཙམ་ཡིན་ཡང་རུང་།",
    "མི་མཐུན་ཕྱོགས་ལ་མེད་པའི་ལྡོག་ཁྱབ་བསྟན་པར་མ་བྱས་པ་ཡང་རྗེས་སུ་འགྲོ་ལྡོག་ཕྱིན་ཅི་ལོག་ཏུ་བསྟན་པའི་དཔེ་རྣམ་པ༵་གཉིས་དཔེ་རྟགས་ལྟར་སྣང་བ་གཞན་རྗེས་སུ་འགྲོ་ལྡོག་མེད་པའང་དཔེ་སྐྱོན་ཡིན་ནོ།",
    "ཞེས་པ་ལྟ་བུ་སྟེ་འདི་ལ་ཁྱབ་པ་དངོས་སུ་མ་བསྟན་ཀྱང་ངེས་པར་སྟོན་པས་བུམ་པ་ལྟ་བུ་དེས་ཡང་དག་ཏུ་འདོད་པའོ།",
    "སྒྲ་མི་རྟག་ལ་བྱས་པའི་བུམ་པ་དཔེར་བརྗོད་པ་ལ་ལྟོས་ནས་ནི་སྒྲ་ཡང་དེ་བཞིན་ནོ་ཞེས་ཉེར་སྦྱོར་བ་དང་།",
    "བུམ་པ་བྱས་པ་དེ་བཞིན་སྒྲ་ཡང་བྱས་སོ་ཞེས་པའི་ཚིག་སྦྱོར་བ་དང་།",
    "ཡང་བྱས་པ་གཏན་ཚིགས་སུ་བྱས་པ་ནི་བྱས་པའི་སྤྱི་ཡིན་ལ།",
    "བུམ་པའི་བྱས་པ་ནི་བྱས་པའི་བྱེ་བྲག་ཡིན་པས་གཅིག་དོན་མེད་མིན་ཞེ་ན།",
    "འདི་ལ་བྱས་པའི་ཕྱིར་མི་རྟག།",
    "སྒྲ་ཡང་བྱས་པའི་ཕྱིར་མི་རྟག་ཅེས་ཡན་ལག་ལྔ་ལྡན་ལ་ཟེར་འདྲ།",
    "བྱས་པའི་གཉེན་པོ།",
    "རྟག་པ་དགག་པའི་ཆེད་དེ་བྱས་རྟག་ལྷན་ཅིག་གནས་པ་གཅོད་པའི་ཕྱིར་ཡིན་ཟེར་རམ།",
    "བྱས་པ་སྨྲས་པས་དེ་ཆོད་ཀྱི་མི་དགོས་སོ།",
    "བྱས་པ་ནི་གཉེན་པོའི་ཕྱོགས་རྟག་པ་དང་ལྡན་པ་མིན་ན་དེའི་ཆེད་དུ་ཡན་ལག་གཞན་མི་སྦྱོར།",
    "དེ་འདྲའི་དཔེ་དེས་རྗེས་འགྲོ་ཡི་ཚུལ་བརྗོད་པར་མི་བྱེད་པ་དེ་ནི་དཔེ་ཡི་གཟུགས་བརྙན་ཡིན་གྱི་དཔེར་མི་རུང་ངོ།",
    "དེ་ལ་སྒྲ་གཞན་སེལ་བས་ཡིན་པར་སྟོན་པ་ལ།",
    "རིགས་དོན་གཞན་སོགས་བརྗོད་པར་བྱ་བ་ཉིད་མི་འཐད།",
    "གང་མཚུངས་པར་རྟོགས་པ་ལ་ནི་རིམ་གྱིས་རྗོད་པར་བྱེད་པ་ནི་ཡོད་དོ།",
    "དཀར་པོ་སྤྱི་ལས་ཁྱད་པར་ངེས་པ་དང་།",
    "གཞན་ཡང་ཡོན་ཏན་སོགས་ཀྱི་སྒོ་ནས་རྫས་ཁྱད་པར་དུ་འབྱེད་ན།",
    "དེ་ལའང་ཁྱད་པར་གྱིས་ཁྱད་པར་ཅན་ལ་ཕན་འདོགས་པ་ནི་འགལ་བར་འགྱུར་ཏེ་དེ་ཀུན་འདྲེས་པས་སོ།",
    "དྭེ་ཡང་སྔར་ཉིད་ཐ་དད་རྣམས་ཀྱི་རིགས་སྒྲ་མིན་ཞེས་པར་བསལ་ཟིན་ཏོ།",
    "སྤྱི་དེ་དེ་ལ་ཡོད་པ་ཡིན་ཞེས་རྣམ་པར་དཔྱད་པས་མི་འཐད་དེ།",
    "གལ་ཏེ་སྤྱི་ལས་ཁྱད་པར་གོ་བ་ཡོད་པ་ལྟ་བུའི་སྤྱི་ལས་སྤྱི་ཉི་ཚེ་བ་གོ།",
    "ཤིང་ལྟ་བུ་གཅིག་ལའང་ལྡོག་པ་ཐ་དད་སྒྲས་བརྗོད་པར་བྱ་བ་མང་པོ་ཡོད་ཀྱང་ཤིང་ཞེས་ལ་སོགས་པའི་སྒྲ་གཅིག་པུ་ཡིས་དེ་ཐམས་ཅད་ཀུན་ཏུ་རྟོགས་པ་མ་ཡིན།",
    "སོ་སོ་ཁོ་ན་ཡིན་ཕྱིར་ཨུཏྤལ་སྔོན་པོ་ཞེས་པའི་གཞི་མཐུན་དང་ཁྱད་པར་བྱ་བྱེད་དུ་མི་རུང་ལ་ཁོ་བོ་ཅག་ལྟར་ན་སྔོན་པོའི་སྒྲས་ཡོན་ཏན་དོན་གཞན་དང་ཨུཏྤལ་གྱི་སྒྲས་སྤྱི་དོན་གཞན་བརྗོད་ལ་དེ་གཉིས་རྫས་གཅིག་ལ་འཕྲོད་པ་འདུ་བས་གཞི་མཐུན་འཐད་ཅིང་།",
    "ཨུཏྤལ་སྔོན་པོ་ཞེས་ཁྱད་པར་བྱ་བྱེད་འཐད་ཅེ་ན།",
    "ཡན་ལག་ཅན་དང་ཡན་ལག་ཀྱང་ཐ་དདཱ་ན་ཡང་གཞི་མཐུན་དང་ཁྱད་པར་བྱ་བྱེད་གཉིས་ཀྭ་མེད།",
    "ཡོན་ཏན་དོན་གཞན་ཙམ་ཞིག་བརྗོད་པར་འགྱུར་གྱི་དོན་གཅིག་མི་བརྗོད་ལ།",
    "བ་རྟ་ནི་དབྱིབས་ཀྱིས་བྱེ་བྲག་ཏུ་བྱས་ལ་སྔོན་པོ་དང་ཨུཏྤལ་དེར་དབྱིབས་ཀྱིས་བྱེ་བྲག་ཏུ་མ་བྱས་ཤེ་ན་ཞེས་དབྱིབས་ཀྱི་ཁྱད་པར་གྱི་སྒོ་ནས་སོ་སོའི་སྤྱི་གསལ་བར་ཀུན་བཏུས་མཆན་འགྲེལབྱས་ཤེ་ན།",
    "འོ་ན་བུམ་པ་གཅིག་ལ་ཡང་དུ་མར་ཁྱབ་པའི་སྤྱི་མང་པོ་འདྲེས་ཤིང་འདུས་པར་འགྱུར་ཏེ།",
    "གཞི་མཐུན་གཅིག་ལ་དབྱིབས་དུ་མར་བྱས་པ་འདུས་པར་འགྱུར་ན་དེ་མ་དམིགས་པས་སོ།",
    "ཡོན་ཏན་རྫས་དགུ་ནི་དབྱིབས་མིན་པས་དེ་ལྡན་གྱིས་སྤྱིའི་གསལ་བྱེད་མིན་པར་འགྱུར་རོ།",
    "གསལ་བྱེད༵་དང་གསལ་བ་ཐ་དད་ལ་རྟོག་པ་ཕན་ཚུན་རྟེན་པ་འཐོབ་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་བྱ་བའི་སྤྱི་བྱེ་བྲག་དོན་གཞན་རྗོད་པར་བྱེད་དོ་ཡང་བརྗོད་པ།",
    "ཤ་བའི་ཁྱད་པར་བརྗོད་ན་དོགས་པ་དེ་ཆད།",
    "བྱས་ན་ཤིང་ཡོད་མེད་དོགས་པ་མི་སྐྱེ་བས་དེས་ཁྱད་པར་བྱ་མི་དགོས་པ་རྒྱལ་ཚབ་བོ།",
    "དེ་བཞིན་སྣུམ་པ་སོགས་ཁྱད་པར་གཞན་རྣམས་ནི་སྤྱི་སྒྲ་དེ་ཡིས་སེལ་བར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "ངོ་བོ་གཅིག་པ་རྣམས་ལ་དོན་ལ་ཐ་དད་པའི་ཁྱད་པར་མེད་ཀྱང་ལྡོག་ཆ་ཐ་དད་ཀྱང་རྫས་སུ་མེད་པའི་གཞི་གཅིག་ལ་མི་འདུ་བ་མེད་དེ།",
    "འོ་ན་སྤྱི་སྒྲ་བྱེ་བྲག་ལ་འཁྲུལ་པ་ཡོད་པ་ཇི་ལྟར་སྤྱི་ལས་ཁྱད་པར་ལ་ཐེ་ཚོམ་ཟ་བར་རིགས་ཤེ་ན།",
    "དོན་བཞིན་སྟོན་བྱེད་ཀྱང་སྒྲ་གཞན་རྣམ་པར་བཅད་ནས་ནི་སྒྲ་སྤྱི་ཙམ་དེ་རྗོད་པར་བྱེད་པ་པོ་ཡིན།",
    "དངོས་པོ་ཡོད་པ་དང་གཞལ་བྱ་ཞེས་པའི་སྒྲས་དོན་སོ་སོར་ངེས་པར་གཟུང་ལ།",
    "དེས་ན་སྒྲ་རྣམས་ཆ་ཤས་རྣམ་པར་གཅོད་པའི་དོན་ཅན་ནོ།",
    "གཞན་སེལ་ལ་བརྡ་བྱས་ཀྱང་དོན་ལ་རབ་ཏུ་སྦྱོར་བ་མི་སྲིད་དོ་ཞེ་ན།",
    "ཡང་གཞན་སེལ་བར་བརྡ་བྱས་ན་དེ་དངོས་པོ་མེད་པས་དངོས་པོ་ལ་འཁྲུལ་མེད་དུ་གོ་མ་ནུས་སོ་ཞེ་ན།",
    "དེ་ལྟ་ན་སྐྱོན་དེ་གཟུགས་ཉིད་དེ་སྤྱི་ལའང་མཚུངས་པར་འགྱུར་ཏེ།",
    "དཀར་མིན་སྔོན་པོ་དང་སེར་དམར་སོགས་ལ་ཁྱད་མེད་པར་གཟུགས་སྒྲ་ཙམ་གྱིས་གོ་བར་འགྱུར།",
    "ཐམས་ཅད་མེད་པ་ལས་གྱུར་པའི་ཐམས་ཅད་མེད་པར་འགྱུར་ཏེ་ངེད་ཀྱི་ཡོད་པའི་གཙོ་བོ་གཅིག་ནི་རང་བཞིན་དུ་འདོད་པ་དང་འདྲའོ་ཞེས།",
    "ཡོད་མེད་ཀྱི་ཤེས་པ་ཐ་དད་དུ་མི་འགྱུར་བར་གཉིས་ཀའི་ཡིན་པར་འདོད་པ་ན་རྟ་བ་ལང་གཉིས་རྣམ་འགྱུར་གྱི་ངོས་ནས་གཅིག་ལ་གཅིག་མེད་ལ་རང་བཞིན་གྱི་ངོས་ནས་གཅིག་པར་འདོད་པའོ།",
    "དེ་ལ་གཅིག་ཡིན་ན་ཐ་དད་བློ་འགལ་ཐ་དད་བློ་སྐྱེ་ན་གཅིག་ཡིན་པར་འགལ།",
    "དེ་གཉིས་གཅིག་མིན་ཏེ་སྣང་ལམ་དུ་གྱུར་མ་གྱུར་དང་ཀུན་རྫོབ་དོན་དམ་གྱི་ཁྱད་པར་ཡོད་པའི་ཕྱིར།",
    "ཡང་བརྗོད་པར་མི་བྱ་བ་ཁོ་ནའོ།",
    "སྒྲ་དོན་དང་དངོས་པོ་ཐ་དད་དུ་ཤན་མི་ཕྱེད་ན་བདག་སྟེ་དངོས་པོ་རང་ཉིད་གཞན་དུ་ཡོད་པར་ཁས་མི་ལེན་ན།",
    "དེ་ཡང་བུམ་པའི་རྡུལ་བརྒྱད་ཀྱི་ཆུ་སྐྱོར་བའི་བྱ་བྱེད་ལ་བུམ་པར་བཏགས་པ་བཞིན།",
    "རྡུལ་འདུས་པ་ལ་ཡང་བརྗོད་པར་བྱེད་པ་ཉིད་དེ་གཉིས་ཀའོ།",
    "དེ་ལ་ལྟག་ཆོད་ལ་ནི་རྗེས་མཐུན་ལན་གྱི་ཁྱད་བསྟན་པར་བྱ་སྟེ་ཕྱིར་རྒོལ་གྱིས་ལན་རྣལ་མར་བསམས་ཀྱང་།",
    "རྟགས་སྔ་ནའང་དམ་བཅའི་དོན་ཕུལ་དུས་གསུམ་པ་ཉིད་ལ་བརྟགས་ནས་རྟགས་སུ་བརྗོད་པར་འདོད་མིན་པར་སྒྲུབ་ནས་ངག་དང་རྟགས་དང་དུས་ཐམས་ཅད་ལ་ནི་མི་འདོད་བརྗོད།",
    "རྟག་པ་དང་མཚུངས་པར་བརྗོད་སྒྲ་གང་མི་རྟག་པའི་རྗེས་སུ་འགྲོ་བ་པ་དེ་དག་ནི་མི་རྟག་ཅེས་པའི་མི་རྟག་པར་སྒྲུབ་ནུས་མིན་ཞེས་པ་དེ་དམ་བཅའམ་ཕྱོགས་ཀྱི་སྐྱོན་དང་རྗེས་མཐུན་དུ་བརྗོད་དེ་རང་ཚིག་འགལ་བས་སོ།",
    "སྒྲ་མི་རྟག་པར་གཏན་ཚིགས་དེས་སྒྲུབ་པའི་ཕྱིར་ཞེས་སྒྲ་མི་རྟག་པར་རྟགས་ཀྱིས་གསར་དུ་སྒྲུབ་པའི་ཚུལ་དུ་བསམས་ནས་རྩོད་པ་སྟེ།",
    "གཏན་ཚིགས་བརྗོད་ན་སྒྲ་མི་རྟག་ཡིན་ནམ་བརྗོད་ན་རྟག་པར་འདྲའམ།",
    "དཔྱད་དེའི་སྔོན་དུ་སྒྲ་མི་རྟག་མིན་པར་རྩོད་པའོ།",
    "མ༵་གྲུབ་པར་བརྗོད་ཀྱང་གྲུབ་པ་མིན་པའི་ལྟར་སྣང་།",
    "འབྲས་བུ་གཞན་ཉིད་ཀྱི་ཆ་ནས་བསྒྲུབ་བྱ་མི་འགྲུབ་པར་སྟོན་པ་དེ་ཉིད་འབྲས་མཚུངས་ལྟག་ཆོད་དེ།",
    "འདི་ལྟར་སྒྲ་མི་རྟག་བསྒྲུབ་ལ་བྱས་པའམ།",
    "འབྲས་བུ་ཡིན་པར་འདོད་པ།",
    "བྱས་པའམ་འབྲས་བུ་སྒྲ་མི་རྟག་མི་འགྲུབ་པར་སྟོན་པའོ།",
    "འདིར་བྱས་ཙམ་སྒྲུབ་ཀྱི་གཞན་ལྡན་གཅོད་དུ་མི་སྦྱོར་རོ།",
    "རྟག་པ་ལ་ཡོད་པར་ཁས་ལེན་པ་མིན་ཀྱང་།",
    "དཔེར་ན་སྒྲ་མི་རྟག་སྟེ་བྱས་ཕྱིར་མི་མཐུན་དཔེ་ནམ་མཁའ་བཞིན་ཞེས་བཀོད་པ་ན།",
    "ནམ་མཁའ་དང་སྒྲ་བྱས་པར་མི་མཚུངས་པས་མི་རྟག་པར་གྲུབ་ན།",
    "པར་འགྲུབ་ཅེས་ཟེར་རོ།",
    "བུམ་པ་དང་བྱས་པར་མཐུན་པས་མི་རྟག་པ་གྲུབ་ན།",
    "ལུས་ཅན་མིན་པར་མཐུན་པས་རྟག་པར་ཡང་འགྱུར་ཏེ་ནམ་མཁའ་བཞིན་ནོ།",
    "དེ་ལྟར་མ་གྲུབ་པར་འདོད་པ་བཞིན་གྲུབ་པར་འདོད་པ༵་ལའང་རྟགས་དེ་མཚུངས་པའི་ཕྱིར་དཔེར་ན་འགལ་བ་ལ་མི་འཁྲུལ་པ༵་ཅན་བཞིན་དཔེ་ཙམ་བཀོད་པ་འདི་ལྟ་བུ་ལ་ཡང་དཔེ་ལ་རྗེས་འགྲོ་ཁྱད་པར་ཅན་བསྟན་པ་མེད་པའི་ཕྱིར།",
    "དེ་ལྟར་དཔེ་དང་བསྒྲུབ་བྱ་ལ་རྗེས་འགྲོ་ཁྱད་པར་ཅན་མ་བསྟན་པར་རྗེས་འགྲོ་ཕྱིན་ཅི་ལོག་ཉིད་ལས་དཔེ་དང་བསྒྲུབ་བྱ་ཕན་ཚུན་འཆོལ་ཏེ་གཅིག་ཏུ་འདྲེས་པ༵ར་འགྱུར།",
    "དེ་ལ་སྒྲ་བུམ་པ་ལྟ་བུ་ཅིས་ཡིན་ནམ་མཁའ་ལྟ་བུ་ཅིས་མིན་པ་མེད་པར།",
    "ཡང་ན་རྗེས་འགྲོ་མེད་པར་སྒྲ་བུམ་བཞིན་ཟེར་ན་བུམ་པ་སྒྲ་བཞིན་ཞེས་ཕན་ཚུན་འདྲེས་པར་འགྱུར་བས་དེ་ཙམ་གྱིས་མི་འགྲུབ་སྟེ།",
    "དེ་ཁོ་ན་མི་རྟག་པར་འགྱུར་གྱི།",
    "བཅུ་པ་བྱེ་བྲག་མེད་པར་མཚུངས་པ་ནི།",
    "སྤྱི་མིན་པ་སྟེ་ཁྱད་པར་མཉན་བྱ་ལྟ་བུ་ཉིད་ཀྱིས་སྒྲུབ་པའང་མ་ངེས་པའི་རྟགས་ཀྱང་རྟག་པར་མི་ནུས་ཞེས་སོ།",
    "མེད་ན་བྱེ་བྲག་མེད་པར་མཚུངས་པའི་རྩོད་དོ།",
    "དེས་ན་བསྒྲུབ་བྱ་དང་རྟགས་ལ་ཁྱད་པར་མེད་ཅེས་བརྗོད་པའི་ཕྱིར་ཡང་མ་གྲུབ་བརྗོད་པ་སྣང་ཡིན་པར་འདོད།",
    "འདི་མེད་ཀྱང་གློག་སོགས་མི་རྟག་པར་སྒྲུབ་པའི་གཏན་ཚིགས་ཀྱིས་སྒྲུབ་པར་བྱ་བ་ལས་གཞན་བསྒྲུབ་བྱ་མིན་པར་ཡང་བསྟན་པ་བསྒྲུབ་བྱར་གྱུར་པ་འདིའང་།",
    "དེའང་རྟག་སྒྲུབ་ཀྱིས་རྟགས་ནི་མེད་དེ་མི་རྟག་པར་གྲུབ་པས་སོ།",
    "གཏན་ཚིགས་ཀྱིས་ནི་བསྒྲུབ་བྱ་ལ་མ་ཁྱབ་ཀྱང་བསྒྲུབ་བྱའི་དངོས་པོ་རྟོགས་པའི་ཕྱིར་གློག་སོགས་བཞིན་དུ་རྩོལ་བྱུང་སྒྲ་ལ་མེད་པར་བསམ་ན་མ་གྲུབ་ལྟར་སྣང་ངོ།",
    "ལས་བསམས་ཏེ་གཏན་ཚིགས་ཐེ་ཚོམ་ཟ་ཞེས་རྩོད་པར་བྱེད་པའོ།",
    "འདི་ནི་འཁྲུལ་པ༵་སྟེ་མ་བྱས་པ་སོགས་གཞན་གྱི་བསྒྲུབ་བྱ་རྟག་པ་ལ་རྩོལ་མ་བྱུང་དེ་ཡིས་སྒྲུབ་པ་དེ་ལྟར་སྣང་བ་སྟེ་འཁྲུལ་པའམ་མ་ངེས་པའོ།",
    "བུམ་པ་མི་རྟག་པར་སྒྲུབ་བཞིན།",
    "འདིར་ཞེས་གྲུབ་ཅེས་པ་དཔེ་མེད་པར་བསྟན་པས་གང༵་ཡང༵་རྒོལ་བ་གཉིས་ཀཱ་ཀུན་བཏུས་མཆན་འགྲེལ།་",
