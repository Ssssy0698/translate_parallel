    "གང་གི་ཚེ་རྣལ་འབྱོར་གྱི་ཚུལ་གཞན་ལས་གསུངས་པའི་མཚན་ཉིད་ཅེས་པ།",
    "ནང་གི་བརྗོད་པ་ཉིད་དུ་རྣལ་འབྱོར་ལ་མཁས་པའི་སློབ་དཔོན་རྣམས་འཆད་དོ་ཞེའོ།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་ནི་རྡོ་རྗེ་ཚིག་གིས་བཟླས་པར་བྱ་སྟེ།",
    "ཚིག་གི་དོན་གང་ལ་དམིགས་པ་དེ་ཉིད་ཚིག་གི་ཡུལ་ཏེ།",
    "དེ་བས་ན་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཚིག་གི་ཡུལ་གྱི་བྱེ་བྲག་རྣམས་ཞེས་བྱ་སྟེ།",
    "ཡིད་ཀྱི་བྱེ་བྲག་ཀྱང་རེ་ཞིག་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་སུ་ཡང་རུང་བ་དག་གིས་ཀྱང་ཚུལ་དེ་བཞིན་དུ་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "འགྲོ་བ་གང་དག་གི་དོན་དུ་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་ན།",
    "གང་ཞིག་གིས་བསྒྲུབས་ནའང་དེ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་བའོ་ཞེས་བསྟན་ཏོ།",
    "དེའི་རིགས་ཀྱི་བདག་པོ་རྣམས་ཀྱི་ནི་ཕལ་ཆེར་བཟླས་བརྗོད་ཀྱི་ཚིག་གི་བྱེ་བྲག་ཇི་ལྟར་བསྟན་པ་བཞིན་དུ།",
    "རང་གི་དམ་ཚིག་སེམས་དཔའི་ལུས་དང་ངག་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་༤རིགས་བཞི་རང་གི་ལྷ་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཟླས་པ་རྣམ་པ་བཞི་ལས་གང་ཡང་རུང་བའི་ངག་གི་སྦྱོར་བ་དང་།",
    "རིགས་བཞི་སོ་སོའི་དངོས་གྲུབ་སྒྲུབ་པར་འདོད་པའི་རྣལ་འབྱོར་པས་ཇི་ལྟར་སྒྲུབ་པ་རང་གི་ལྷ་དང་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "རྒྱུད་༥༤དབབ་པ་ལ་སོགས་པའི་རིམ་གྱིས་ཕྱག་རྒྱ་ཆེན་པོ་བཞི་དང་ལྡན་པར་བྱ་བ་ཡང་ཡིན་མོད་ཀྱི།",
    "དེའི་ནང་ན་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཁོ་ན་ལག་ན་འཛིན་པར་བསྒོམ་མོ།",
    "བདག་ཕྱག་རྒྱ་ཆེན་པོར་བསྒོམས་པའི་ལག་ན་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཐོགས་པའོ།",
    "དྲན་པ་དང་སྲོག་གི་རྗེས་སུ་འབྲངས་པའི་ཡིད་ཅེས་པ་ནི་དྲན་པ་དང་དབུགས་སླར་རྒྱུ་བའི་དུས་ན།",
    "རིམ་པ་འདིས་ཀྱང་ཉིན་རེ་བཞིན་ལྷའི་རྣལ་འབྱོར་གཙོར་བྱས་ལ།",
    "བགྲང་ཕྲེང་གི་ཆོ་ག་ཡང་རྒྱུད་འདི་ལས་མ་གསུངས་པས་ཞེས་པ་ནི།",
    "དེ་ལྟར་བཟླས་བརྗོད་བྱེད་པ་ཡང་གྲངས་བགྲང་ཕྲེང་ལ་གཟུང་བ་ཡིན་མོད་ཀྱི།",
    "རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ལས་གསུངས་པས་དེས་བྱ་བར་བསྟན་ཏོ།",
    "ཞེས་པ་གསང་སྔགས་དང་རིག་སྔགས་བཟླས་བརྗོད་བྱེད་པར་འདོད་པའི་ཆོ་ག་ལ་ནི་ཁྱད་པར་དུ་སྤྲོས་པ་ནི་༧མེད་པའི་ཚིག་གྲུབ་པར་གྱུར་ཅིག་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་བདག་གིས་ཐོབ་པར་གྱུར་ཅིག་ཅེས་དང་པོར་སྨྲས་ནས་གདོད་བཟླས་པར་བྱའོ།",
    "རང་གི་བག་ཆགས་ཀྱིས་ལྷའི་གཟུགས་ལ་དམིགས་ནས་ཞེས་པ།",
    "རྣལ་འབྱོར་གྱི་རྒྱུད་ཐམས་ཅད་ཀྱི་ལྷག་མར་གྱུར་པ་རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ལས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡང་རང་གི་ལྷག་མ་ནི་རང་གི་རྒྱུད་ཀྱི་མཇུག་ནས་སྟོན་པ་ཡིན་ལ།",
    "སྤྱིའི་ལྷག་མ་ནི་རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་འདིའོ།",
    "དེ་ཡང་འདིར་དེ་ལ་མོས་པའི་སྐྱེ་བོ་རྣམས་ཞེས་པ་དེ་ལྟར་བསྟན་པ་ནི།",
    "དེ་ལྟར་རིགས་བཞིའི་བཟླས་པ་ལས་གཞན་པའི་བཟླས་བརྗོད་ལ་མོས་པའི་སྐྱེ་བོ་རྣམས་རྡོ་རྗེ་རྩེ་མོར་བསྟན་པའི་ཚུལ་འདིས་སམ།",
    "དེ་ལས་གཞན་པའི་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཀྱི་ནི་ཞེས་པ།",
    "གང་གི་ཕྱིར་དེ་ལས་ནི་ཞེས་པ།",
    "གང་གི་ཕྱིར་རྡོ་རྗེ།",
    "རྩེ་མོའི་རྒྱུད་ལས་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་ལ་བཟླས་བརྗོད་བྱེད་པའི་སྦྱོར་བ་ནི།",
    "བཀྲ་ཤིས་སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ།",
    "གཙུག་ཏོར་ལ་སོགས་རང་གི་མཚན།",
    "བདག་ཉིད་བཀྲ་ཤིས་ཀྱི་སྐྱིལ་མོ་ཀྲུང་དུ་འདུག་སྟེ།",
    "དེ་རྫོགས་པའི་རྟགས་ནི་རང་གི་སེམས་ཀྱི་ངོ་བོ།",
    "དེའི་སྟེང་དུ་རིགས་ལྔའམ་གཅིག་གང་རུང་སྟེགང་བསྒྲུབ་པར་འདོད་པ་དེའི་རིག་སྔགས་ཀྱི་ཡི་གེ་གཞག་པ་ཅི་ཙམ་༤མཚན་མ་བྱུང་གི་བར་དུ་བསྒོམ་མོ།",
    "བྱ་བ་གཞན་དག་གི་ཕྱིར་གཏོང་འདོད་ན་འདི་ཉིད་ཀྱི་ཕྱིར་ཇི་སྐད་དུ་གསུངས་པ་བཞིན་དུ་ཕྱག་རྒྱ་དགྲོལ་བར་བརྩམས་ལ།",
    "རྣལ་འབྱོར་རྒྱུད་ཀྱི་ལྷག་མར་གྱུར་པ་རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ལས་གསུངས་པའི་བཟླས་བརྗོད་ཀྱི་བྱེ་བྲག་མཚན་མར་བཅས་པ་ལས་གཞན་དུ་གྱུར་པ་མཚན་མ་མེད་བསྟན་པ་དེ་ཡང་།",
    "དང་པོ་རེ་ཞིག་རྣལ་འབྱོར་པས་སྔ་མ་བཞིན་དུ་བདག་དམ་ཚིག་སེམས་དཔར་བྱིན་གྱིས་བརླབ་པར་བྱས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་གསུངས་ཏེ།",
    "དེ་དག་གི་ཐུགས་ཀར་ཡང་ཟླ་བ་དང་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "རང་གི་སེམས་ཀྱི་གནས་སྲོག་དང་རྩོལ་བ་གཉིས་ཡན་པར་མི་གཏོང་ཞིང་ནང་དུ་བཀག་སྟེ་བདག་དང་ལྷ་དང་ཕྱི་ནང་གི་གཟུགས་ལ་སོགས་པའི་རྣམ་པར་སྣང་བ་དང་བྲལ་བའི་སེམས་ཀྱིས་བདག་དམ་ཚིག་སེམས་དཔའ་དང་།",
    "ཡང་ན་བདག་དང་ལྷ་དང་ཞེས་པ་གང་༢གི་རྣམ་པ་ལས་གཞན་དུ་བསྟན་པ་སྟེ།",
    "མདུན་དུ་ཡང་རང་གི་ལྷ་ཉིད་བསམས་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་ཡི་གེ་ལ་སོགས་པ་གསལ་བར་བསམས་ནས།",
    "དེ་རྣམས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ངོ་བོ་ལྟར་བདག་མེད་པར་མོས་པའི་རྣལ་འབྱོར་མངོནསུམ་དུ་བྱས་ལ།",
