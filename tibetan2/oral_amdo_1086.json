    "ཉོན་མོངས་རྟགས་དང་མཚན་མ་དང་།",
    "ཉོན་མོངས་རྟགས་དང་མཚན་མ་དང་།",
    "ཁྱོད་ཀྱིས་ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་བསྟན་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "ཁྱོད་ཀྱིས་དེ་བསྟན་པས་བྱེད་པའི་མཚན་ཉིད་ཀྱི་བྱེད་ལས་ཤེས་པར་བྱས་པའི་སྦྱོར་བ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་གང་ཡིན་སྙམ་པའི་དོགས་པ་སེལ་བའི་ཕྱིར།",
    "ཉོན་མོངས་པ་མངོན་གྱུར་པས་སྟོང་པ་ཉིད་ཀྱིས་དེས་དབེན་པའི་གཞི་ཤེས་ཀྱི་སྦྱོར་བའི་ངོ་བོ་ཉིད་ནི་མཁྱེན་པ་གསུམ་གྱི་སྦྱོར་བ་དེ་མཚོན་པར་བྱ་བར་མཚན་ཉིད་དང་ལྡན་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཚོན་པར་བྱེད་པའི་རྟོགས་པ་ཡིན་པས་མཚན་ཉིད་བཞི་པ་ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་ལ་སོགས་པའི་རྩ་ཉོན་དྲུག།",
    "ཉོན་མོངས་པ་དེའི་རྟགས་ཏེ་འབྲས་བུ་གནས་ངན་ལེན་མངོན་གྱུར་བས་སྟོང་པས་དེས་དབེན་པའི་གཞི་ཤེས་ཀྱི་སྦྱོར་བའི་ངོ་བོ་ཉིད་ནི་མན་འདྲ།",
    "ཉོན་མོངས་ཀྱི་འབྲས་བུ་གནས་ངན་ལེན་ནི།",
    "ངག་གི་རྫུན་སྨྲ་སོགས་བཞི།",
    "སེམས་ཀྱི་གནོད་སེམས་ལ་སོགས་པ་གསུམ་མོ།",
    "ཉོན་མོངས་ཀྱི་མཚན་མ་རྒྱུ་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་མངོན་གྱུར་པས་སྟོང་པས་དེས་དབེན་པའི་གཞི་ཤེས་ཀྱི་སྦྱོར་བའི་ངོ་བོ་ཉིད་ནི་མན་འདྲ།",
    "དེ་ལ་མི་མཐུན་ཕྱོགས་ནི་འདོད་ཆགས་ལ་སོགས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ཡུན་རིང་མོ་ནས་བསྒྲུབ་པར་བྱ་བའི་མཆོག་རྣམ་མཁྱེན་གྱི་ཡེ་ཤེས་དོན་དུ་གཉེར་བས་ཆེད་དུ་བྱ་བ་མ་འཁྲུལ་བའི་ལམ་ཤེས་མན་འདྲ།",
    "བསྐྱེད་པར་མཁས་པ་དེ་གང་ཡིན་སྙམ་པའི་དོགས་པ་བསལ་ནས་མཁས་པ་དེ་བསྟན་པའི་ཕྱིར་དུ་ཁྱོད་གསུངས་པ་ཡིན་པའི་ཕྱིར།",
    "ཡན་ལག་གི་དབྱེ་བ་དད་སོགས་ལྔ་པོ་རེ་རེ་ལ་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་གསུམ་གསུམ།",
    "ཁ་ཅིག་ན་རེ།",
    "བདག་གིས་ནི་ཚིག་མང་དུ་དོགས་ནས་མིང་ཅན་མ་སྦྱར་རོ།",
    "སྐྱེས་པ་དང་བུད་མེད་རང་བས་རྒན་པ་རྣམས་ལ་ཕ་དང་མའི་སེམས་དང་།",
    "མཉམ་རྣམས་ལ་སྤུན་དང་སྲིང་མོའི་སེམས་དང་།",
    "གཞོན་པ་རྣམས་ལ་བུ་དང་བུ་མོའི་སེམས་དང་།",
    "རྩེ་མོ་ལ་རང་གཞན་གྱི་རྟེན་གྱི་དབྱེ་བས་དམིགས་རྣམ་གྱི་དབྱེ་བ་བྱེད་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་བཟོད་པ་ལ་ཡང་རང་གཞན་གྱི་རྟེན་གྱི་སྒོ་ནས་སྟོན་པ་ལ།"
  ]
}