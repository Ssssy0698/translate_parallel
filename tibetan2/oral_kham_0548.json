    "འཚོ་བ་རང་འཚོའི་རྒྱ་མི་ཁག་གཅིག་ཡོད་པ་རྣམས་དུས་བཀག་བཟོས་ཏེ་དེའི་ནང་ཚུད་རང་རང་ས་གནས་སུ་ཕྱིར་ལོག་བྱས་ན་གླེང་མེད་དང་།",
    "དེ་མིན་དྲག་ཤུགས་ཀྱིས་གླེན་རྟགས་རྩེད་ན་རང་ཤི་བརྒྱབས་པ་དང་གཉིས་སུ་མ་མཆིས་པས་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོས་དབུས་མཛད་གཙོ་ཚོར་མཛད་དཀའི་སྐུ་ངལ་ཤིན་ཏུ་ཆེན་པོ་བྱུང་འདུག་རུང་།",
    "དེའི་རིང་རང་ཉིད་ཀྱང་གོང་བཞིན་སྤོས་འཛིན་གྱི་ཞུ་སྒོ་སྒྲུབ་མུས་ལ་བརྟེན་མཛད་སྒོ་ཆེ་ཕྲ་མཐའ་དག་ལ་སྐུའི་ཉེ་འཁྲིས་དེ་རང་དུ་སྡོད་རྒྱུའི་སྐལ་བཟང་ཐོབ་པ་བཅས་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོའི་གྲྭ་བསྐོར་ལྷ་རམས་དམ་བཞེས་མཛད་སྒོ་གལ་ཆེ་རྣམས་བགེགས་མེད་བདེ་བླག་ངང་གྲུབ་ཅིང་།",
    "ཁོང་རང་རྣམ་ཀུན་བློ་བག་ཕེབས་ལ།",
    "ང་རང་ལའང་ལག་པ་སྟོང་པ་མ་ཡིན་པར་ལུས་ལ་མཚོན་ཆ་གང་རུང་ཞིག་བཅངས་དགོས་བརྗོད་བྱུང་།",
    "ཁོང་པ་ནི་ཉིན་དེའི་ཞོགས་པ་འཆར་ཅན་དྲུང་ཇར་ཕེབས་པ་ང་རང་ནས་ཀྱང་དངོས་སུ་མཐོང་བྱུང་།",
    "ཡུད་ཙམ་ཞིག་ནས་ཁོང་རང་ཕྱིར་ལོག་གནང་བ་མིན་ནམ་གང་ལྟར་སྐྱ་ཆས་སྤྲས་ནས་ཁ་ལ་རྒྱ་ལུགས་ཀྱི་ཁ་རས་ཞིག་བརྒྱབ།",
    "གང་ལྟར་ཁོང་རང་མི་དམངས་ནས་འཇུ་བཟུང་སྐབས་ལུས་ལ་མེ་མདའ་ཐུང་མདའ་ཞིག་ཡོད་པ་དང་།",
    "རྐྱེན་ལམ་དུ་བཏང་བའི་ཕུང་པོ་དེ་ངས་མཐོང་སྐབས་མི་ངོ་རྩ་བ་ནས་མི་ཆོད་པ་ཞིག་ཏུ་གྱུར་འདུག་རུང་།",
    "ང་རང་ལ་ལས་འགན་གང་ཡང་མ་བྱུང་བ་དེ་ནུབ་རང་ཤག་ཏུ་ལོག་ཡོང་བ་ཡིན།",
    "ལས་འགན་གང་བྱུང་ཡང་དང་ལེན་བྱ་རྒྱུར་ཆོད་སེམས་དང་བཅས་ཕྱི་ཉིན་འཆར་ཅན་དྲུང་བཞེས་སུ་ནོར་གླིང་དུ་བསྐྱོད་སྐབས་བར་དེར་རྒྱ་མིས་ལམ་ཆེན་གྱི་འདུ་འགག་ཆེ་སར་འཛིངས་རགས་གསར་རྒྱག་བྱས་ཡོད་པ་དེ་ཚོའི་ནང་རྒྱ་མི་དྲག་ཆས་སྤྲས་ཏེ་ཚུར་རྒོལ་གྱི་གྲབས་གཤོམས་ཨང་བསར་བྱས་བསྡད་འདུག་ལ།",
    "ང་རང་ནས་ཀྱང་སེམས་ཐག་གཙང་བཅད་ཀྱིས་རྩམ་པ་ཟ་མཁན་གྱི་ས་ཡིག་བཀོད་པ་ཡིན།",
    "ང་རང་བཅས་ཡོད།",
    "དགོང་དྲོའི་ཆུ་ཚོད་༡༡ ཡས་མས་སུ་ང་རང་ངའི་ཨ་ཞང་མཁན་དྲུང་བཞུགས་གནས་དུ་སུ་ཡུད་ཙམ་བསྐྱོད་པར་ཨ་ཞང་དང་།",
    "གཅེན་པོ་རྩེ་མགྲོན་གཉིས་ད་དུང་ཕྱིར་ཕེབས་མི་འདུག་གང་འཚམས་ནས་ཕྱིར་ཕེབས་བྱུང་ཞིང་།",
    "དེ་བས་རྒྱུན་ལྡན་མ་ཡིན་པའི་དམིགས་བསལ་ཞིག་འདུག་སྙམ།",
    "བྱིས་བློ་ང་རང་ལའང་དེ་གའི་མུར་དམག་འཁྲུགས་ལང་ན་སྐུ་ཕྱིར་འཇིག་ཉེན་ཡོང་རྒྱུའི་སེམས་ངལ་ཆེན་པོ་ཡོད།",
    "འོན་ཀྱང་རང་ཉིད་ནས་གནས་ཚུལ་དེ་གོ་མ་ཐག་དགའ་སྐྱོ་འགྲན་བཞིན་དར་ཅིག་བརྗོད་མི་ཤེས་པའི་ཚོར་བ་བྱུང་ལ།",
    "ངའི་ཨ་ཞང་མཁན་དྲུང་དང་།",
    "དེ་ཉིན་ང་རང་སེམས་རྣལ་དུ་མི་ཕེབས་པར་ལྷ་སར་རང་ཤག་ཏུ་བསྐྱོད་འདོད་དང་།",
    "སྡོད་གནས་ཡོངས་ནས་ནོར་གླིང་ཕྱོགས་སུ་མེ་སྒྱོགས་ཁ་བསྒྲིགས་ཏེ་བརྒྱབ་བྱུང་བའི་སྒྲ་སྐད་དེ་ད་དུང་ཡང་སྣང་བར་སྐྱོ་ལྷང་ངེར་གནས་བསྡད་འདུག་དེ་དུས་ང་རང་ནོར་གླིང་ཁམས་གསུམ་ཟིལ་གནོན་གྱི་སྒོ་སྲུང་དུ་ཡོད་ཅིང་།",
    "མི་མང་ཆེ་བ་བྲོས་རྩིས་བྱེད་འདུག་གཅིག་གྱུར་གྱི་བཀའ་ཞིག་མེད་པར་རང་བཞིན་རང་མགོ་གང་ཐོན་བྱས་ན་གང་ནས་འགྲིགས་བསམས་ཏེ་མུ་མཐུད་སོ་སོའི་ས་ཁུངས་སུ་ཆུ་ཚོད་༡༢ བར་བཀའ་བསྒུགས་བསྡད་པ་ཡིན་ཡང་།",
    "མེ་སྐྱོགས་ཀྱིས་གཏོར་རྒོལ་ཚབས་ཆེ་བཏང་བ་ལས་རྒྱ་དམག་ནང་དུ་ཡོང་མཁན་ནི་མི་འདུག་དེ་མུར་སྡོད་པ་ལས་ཡང་ན་རྒྱ་དམག་མཐོང་སར་འཐབ་རྒོལ་བྱ་རྒྱུ་དང་།",
    "གལ་སྲིད་བྲོས་པ་ཡིན་ན་ང་རང་གཅིག་པུ་མ་ཡིན་པར་ངེས་པར་ཨ་ཞང་མཁན་དྲུང་དང་།",
    "དེ་མིན་ཀམ་པ་ལི་སོགས་གྱོན་ཆས་ཉེར་མཁོ་བསྡོགས་ཏེ་ཨ་ཞང་ཕེབས་འཕྲལ་འགྲོ་རྒྱུའི་གྲབས་གཤོམས་བྱས་ཏེ་སྡོད་སྐབས།",
    "ཕ་རོལ་པོར་འཛིང་རྒོལ་བྱེད་སའི་ཡུལ་ནི་མི་འདུག་དེ་བས་ཕྱི་ལ་འདོན་ཐབས་བྱས་ན་ལེགས།",
    "དེ་ཡང་ནུས་ཤུགས་གཅིག་ཏུ་བསྒྲིལ་ཏེ་ཕྱོགས་གང་འོས་ཤིག་ནས་ངེས་པར་ཕྱིར་ཐོན་ཐབས་བྱ་གལ་ཞེས་ཚིག་ཐག་ཆོད་པོས་བཀའ་གནང་རྗེས་ཁོང་རང་དང་རྩེ་དྲུང་རྒྱལ་མཚན་བཀྲིས་ལགས།",
    "རང་རང་གང་འགབ་བྱེད་བདེ་བྱུང་ཞིང་།",
    "ང་རང་ཡང་མ་ཞང་བཞུགས་སར་ཕྱིར་ལོག་སྐབས་ཨ་ཞང་མཁན་དྲུང་གཞི་ནས་ཕེབས་འདུག་པ།",
    "ཁྱེད་རང་འགྲོ་བསམ་ན་ཅི་དགར་གྱིས།",
    "དེའི་བར་ན་གཅེན་པོ་ཡིག་ཚང་ནས་མགོན་པོ་ཁང་དུ་ཟན་བརྟགས་ཞུ་བར་རྩེ་ཕྱག་མཁན་ཆུང་རྒྱལ་མཚན་ལགས་ཀྱི་ཕྱག་རོགས་སུ་བཏང་བ་སྒུག་སྡོད་ཞུས་ཏེ་ཕེབས་འཕྲལ་ང་རང་དང་།",
    "ངའི་ཨ་ཞང་མཁན་དྲུང་།",
    "རྟ་དྲེལ་མང་པོ་ཤི་རྨས་བཟོས་འདུག་སྐབས་དེར་ང་རང་ཁ་སྐོམ་ནས་མིད་པའང་སྐམ་རྐྱང་ཆགས་འདུག་པ་ཆུ་ངོམས་པ་ཞིག་འཐུང་རྒྱུ་རག་ན་ཅི་མ་རུང་ཁོ་ན་སྙམ་ཞིང་།",
    "སྒོའི་གཤམ་བུ་ཞིག་ལག་ཏུ་འདུག་པ་མེ་སྒྱོགས་ཀྱི་སྒྲ་སྐད་ཐོས་མ་ཐག་གཤམ་བུས་མགོ་བཏུམས་ཏེ་ལག་པ་དང་གཤམ་བུས་མི་ནང་བཞིན་མགོ་ཁོ་ན་སྲུང་སྐྱོབ་བྱེད་ཀྱི་འདུག་ཡུད་ཙམ་མེ་སྒྱོགས་རྒྱག་མཚམས་ཆད་སྐབས་གཡས་གཡོན་མི་དང་།",
    "འོན་ཀྱང་ང་རང་འགྲམ་ཐང་དེར་མང་ཆེ་བ་གོག་བགྲོད་ཀྱིས་བསྐྱོད་སྟབས་མེ་མདེལ་མ་ཕོག་ཙམ་བྱུང་།",
    "དེའང་བོད་ཕྱོགས་ནས་གྲོས་མཐུན་དང་འགལ་ལུགས་ལ་ཁ་གཡར་ཏེ་མཐར་དྲག་གནོན་བྱ་རྒྱུའི་ངན་ཇུས་སྔོན་ཚུད་ནས་བྱས་འདུག་བསམ་པ་ཡང་དྲན་བྱུང་།",
    "ཁོང་ལ་བརྒྱབ་པའི་རྐང་ལྕགས་དེ་དུས་ཀྱང་བཀྲོལ་མི་འདུག་ལ།",
    "ཚོགས་ཆུང་སོ་སོའི་ནང་རང་ཉེས་དོགས་འདྲི་བྱེད་སྐབས་ནང་ཚགས་ཉེས་བརྡུངས་དང་།",
    "དེ་ནས་རྒྱང་ཁད་གོམ་པ་གཉིས་གསུམ་ཡོད་པ་རྐུབ་སྟེགས་ཙོག་ཙོག་ཞིག་འདུག་པ་དེར་ང་བཞག་རྗེས་སྐེད་པ་ནས་མེ་མདའ་ཞིག་དམར་རྗེན་དུ་བཏོན་ཏེ་ཡིག་ཅོག་སྟེང་དུ་བཞག་སྟོད་གོས་ཀྱི་ཁུག་མའི་ནང་ནས་ཐ་མག་བཏོན་ཏེ་མེ་སྤར།",
    "ང་རང་ལ་ཡང་ཐ་མག་རྐང་གཅིག་ལ་མེ་སྤར་ཏེ་སྤྲད།",
    "སྐབས་དེ་དུས་ང་རང་ཨ་ཞང་དང་མཉམ་དུ་རྒྱ་གར་དུ་བསྐྱོད་པ་ཡིན་ཡང་།",
    "ང་རང་ཕྱིར་སློག་བྱུང་།",
    "ཡག་ཤོས་མ་ཞང་རང་ལ་གདོང་གཞི་ར་སྤྲོད་ཀྱིས་ཐེར་འདོན་བྱས་ན་བསམ་བློ་བཏང་བའི་ཁྱད་ཡོད།",
    "དེར་བརྟེན་ང་རང་ཨ་ཞང་མཁན་དྲུང་སྐོར་ཧ་ཅང་བློ་གཡེང་ངང་གནས་མུར།",
    "རྣ་མཆོག་ཧ་ལམ་ཆད་ལ་ཁད་བཟོས་འདུག་འཐབ་འཛིངས་གཏོང་ཡུལ་ནོར་གླིང་རྒྱུད་རྒྱ་མཚོ་སྟོད་སྨད་དང་།",
    "གྱོན་ཆས་བརྗེ་ལེན་སོགས་མང་པོ་འཁུར་རྒྱུ་འདུག་ལ།",
    "གྱོན་པ་བརྗེ་ལེན་སོགས་འཁྱེར་ཏེ་སླེབས་འདུག་ལ།",
    "མུ་མཐུད་ཐེངས་ཤས་བྱུང་ན་རུ་འབྲིང་ཐོག་འཐབ་རྩོད་བཟེད་དགོས་ཀྱི་འདུག་དེ་དུས་རང་ཉིད་ནི་རང་ལོ་༡༨ ཧྲིལ་པོ་ལོན་ཙམ་ཡིན་པ་དང་།",
    "བཙོན་པ་རྙིང་པ་མང་ཆེ་བ་ལས་ཚད་དེ་ལོན་ཐུབ་ཀྱི་འདུག་རང་ཉིད་ཀྱི་བསམ་ཚུལ་ལ་གཙོ་བོ་ནུས་ཤུགས་དང་།",
    "ད་དུང་སླེལ་པོའི་ནང་རྡོ་བླུགས་མཁན་ཁོ་ན་སྒུག་མ་བསྡད་པར་སོ་སོས་ཀྱང་འབད་བརྩོན་གྱིས་དུས་ཚོད་དམ་འཛིན་བྱེད་དགོས་ཟེར་འདུག་པ་ལྟར་རང་ཉིད་ནས་རྡོ་ཆེན་དབོར་བ་དང་།",
    "ང་རང་ལ་དེ་ཉིན་ཐེལ་རྩེ་སིལ་མ་མ་གཏོགས་རྩ་བ་ནས་མེད།",
    "ཕྱུ་པ་ཞིག་གྱོན་པའི་ཐོག་སྐེ་དཀྲིས་མཐུག་པོ་ཞིག་ཀྱང་བཅིངས་འདུག་ལྷམ་རྒྱ་ནག་ནས་ཐོན་པའི་ཆིང་པའི་ལྷམ་ཞིག་གྱོན་པ་དང་།",
    "ཁོང་རང་ལས་གྲྭ་ནས་འབྱོར་ནི་ཆབ་གསང་དུ་བསྐྱོད་ཀྱི་ཡོད་ན་ལས།",
    "ལས་ཀར་སྐུ་ངལ་ཆེན་པོ་འདུག་གམ་ཞེས་ཁམས་འདྲི་བྱུང་།",
    "དེར་བརྟེན་བློ་མཐུན་ནང་ཚགས་ཚོར་ཅུང་ཟད་ཕན་ཐོགས་པའི་གོ་སྐབས་འདུག་ཉིན་ཞིག་ལས་ཀ་དེ་རྫུན་རྐུབ་རྡོལ་རྒྱུར་ཐག་བཅད་དེ་བསྡད་ཡོད།",
    "རང་ཉིད་ཀྱི་ནང་མིས་བསྐྱལ་བའི་ཟ་ཆས་རྣམས་ཀྱང་རང་ཉིད་ཀྱིས་བེད་སྤྱོད་བྱ་རྒྱུ་བྱུང་།",
    "ཉིན་ཞིག་ཁོང་རང་སྒལ་པར་སླེལ་པོ་ཡོད་མུར་བྲག་ཤུར་གྱི་ས་རྡོ་དབོར་སའི་སྐས་འཛེགས་སེའུ་བརྒྱ་ལྷག་ཡོད་པའི་གཡང་གཟར་ཞིག་ཡོད་པ་དེ་ནས་མཆོངས་འདུག་རུང་།",
    "བྲག་རྡོ་དེས་ཕལ་ཆེར་མི་བཅུ་བདུན་ཙམ་ལ་རྨས་སྐྱོན་བཏང་འདུག་པ་དང་།",
    "ཕར་ཙམ་སླེབས་དུས་ཕྱིར་མིག་ཞིག་ལྟ་སྐབས་རི་དེའི་སྐེད་པ་ཙམ་ནས་ཉིལ་ཡོང་བ་ལྟ་བུའི་མཐོང་སྣང་བྱུང་བར་མ་ཟད།",
    "ང་རང་ཡང་རྐང་ཚིགས་གྲོལ་ཙམ་ཞིག་མནན་འདུག་དེ་འཕྲལ་མི་ཚང་མས་སོ་སོའི་ལྟོ་ཚང་དང་།",
    "ངས་ང་རང་ལ་སྐྱོན་ཆག་བྱུང་མེད་པར་གསོན་པོར་བསྡད་ཡོད་པ་མཐོང་དུ་བཅུག་པ་ཡིན།",
    "སྐད་ཚོ་ཡང་ཤོད་ཀྱི་མི་འདུག་ཟེར།",
    "དེར་བརྟེན་ང་རང་དངངས་སྐྲག་དང་།",
    "ཞི་ནས་གསོན་པོར་གནས་ཡོད་པ་ཤེས་ཚོར་བྱུང་འདུག་སྐབས་དེར་ས་རྡིབ་བྱུང་སྟེ་རང་རྒྱུཟ་༧༣་ཉིད་ལ་གྱོང་གུན་ཆེ་ཤོས་སྟོད་ཐུང་སྲིང་བལ་གྱི་བར་ལྡན་ཅན་ཞིག་ཡོད་པ་དེ་ས་རྡེབ་འོག་ཚུད་དེ་རྗེས་སུ་ཕུང་པོ་བཏོན་མཁན་ནས་སྟོད་ཐུང་དེ་ཕྱིར་སྤྲོད་བྱུང་ཡང་།",
    "མར་སོགས་ཐབས་འཚོལ་གྱིས་ང་རང་ལ་སྤྲད་བྱུང་ཡང་།",
    "ང་རང་མིང་ཐོ་ཐོན་འདུག་ཀྱང་མལ་སར་ལུས་བསྡད་ཡོད་པས་རྗེས་སུ་མ་གཏོགས་ཧ་མ་གོ་བར་སྔོན་དུ་མིང་ཐོ་ཐོན་པ་ཚོར་ཡིད་སྨོན་གྱི་ངང་གནས་བསྡད་ཡོད།",
    "ལྷག་པར་དོ་དམ་པོ་ཞིག་འདུག་པ་སྟེ།",
    "ལས་ཀ་ཡོད་དུས་གསུམ་འདུག་ཅིང་།",
    "རི་འདབས་དེར་ཨར་ཁུང་ཁ་ཤས་འདུག་པའི་ནང་ནས་ཨར་ཀ་སྤུས་དག་ཤོས་ནི་གྱེན་ཤིན་ཏུ་གཟར་པོ་ཞིག་ལ་འདུག་ཅིང་།",
    "ཁོང་རང་ནས་ཐེར་ཀའི་མཇུག་དེར་ཐག་པ་བརྒྱབས་ཏེ་གྱེན་དུ་འཐེན་ནས་ཐུར་དུ་ཤོར་མ་བཅུག་པའི་ཁྱད་བྱས།",
    "ང་རང་ནས་སྐེད་རག་དང་།",
    "དྲན་གསོས་དུས་ང་རང་ནི་ལམ་ཆེན་དེའི་ཟུར་དེར་གཡུགས་འདུག་པ་དང་།",
    "སྒལ་ཚིགས་ལྟེབས་བརྩེགས་ཐེབས་འདུག་ཟེར།",
    "སྐབས་དེར་ང་རང་ཐེར་ཀ་དེའི་མཇུག་ནས་ཐག་པ་འཐེན་མཁན་དུ་ཡོད་པས་ཐག་པ་འཐེན་དྲགས་པའི་རྐྱེན་ཡིན་ནམ།",
    "གལ་ཏེ་ང་རང་ལ་འདྲི་རྩད་བྱུང་ན།",
    "སྐབས་དེའི་བཙོན་པ་རྣམས་ལ་རིན་ཐང་ག་འདྲ་ཞིག་འདུག་གམ།",
    "དེའི་ཐོག་ལས་བྱེད་དང་དམག་མིའི་ཁ་ལག་བཅས་ང་རང་མི་གཅིག་ལ་བསྐུར་བྱུང་ཞིང་།",
    "ལས་ཡུལ་ལ་འབྱོར་དུས་ནམ་རྒྱུན་གྱི་ཉིན་དགུང་ལྟོ་དུས་ལས་ཆུ་ཚོད་༢ ཙམ་ཕྱི་འགྱངས་གྱུར་འདུག་པར་བརྟེན་ལས་བྱེད་དང་བཙོན་པ་བཅས་གྲོད་པ་ལྟོགས་ཏེ་ང་རང་ལ་འཁང་ར་བྱེད་བཞིན་གནས་འདུག་ཡིན་ནའང་སྒྲུབ་ཐབས་མེད་པའི་ལས་ཀ་ཞིག་ང་རང་ལ་བསྐུལ་བ་དང་།",
    "བཙོན་པ་བྱིངས་ནས་ཀྱང་ཕན་ཚུན་ལྟ་རྟོག་བྱས་ཏེ་གལ་སྲིད་གནས་ཚུལ་དེ་རིགས་འདུག་ན་འཕྲལ་དུ་སྙན་སེང་ཞུ་དགོས་ཟེར་ཏེ།",
    "ཁོང་རང་ལའང་ལྟ་རྟོག་ལེགས་པོ་མ་བྱས་པའི་འགན་གཡོགས་དོགས་ཀྱིས་ཡིན།",
    "ང་རང་ཉིན་ཤས་ངལ་གསོ་མི་རྒྱག་ཀ་མེད་བྱུང་།",
    "བྱིན་རྟེན་དེས་ཕུགས་སུ་གཟུགས་ཁམས་ལ་ཧ་ཅང་ཕན་ནུས་བྱུང་འདུག་སྙམ།",
    "ང་རང་ནི་ལོ་བཞི་ཙམ་རིང་བཙོན་དུ་སྡོད་སྐབས་ཚ་གྲང་དང་།",
    "ངས་ང་རང་ལ་སྤྲོད་མཁན་ཡིན་པ་མ་བསམས་པར་ངའི་རོགས་གཉིས་ཀྱི་ངོ་ཤེས་སམ།",
    "ངའི་ནང་མི་འདུག་གམ་ཞེས་སྐད་ཆ་དྲིས་པར།",
    "ཀུའུ་རྩི་ཞིག་ནང་སྤགས་གཡོས་ཐེབས་ལ་མ་ཐེབས་ཞིག་འདུག་པ་ང་རང་ལ་སྤྲད་བྱུང་།",
    "དེ་ཡང་ང་རང་ལ་སྤྲོད་མཁན་ཡིན་པ་དང་།",
    "ཅ་ལག་སྤྲོད་རྒྱུ་ཡོད་པ་རྣམས་སྤྲད་དེ་ཁྱེད་རང་ལོག་ན་དགའ།",
    "ང་རང་རྣམ་ཀུན་ཕྱིར་ལས་ཀར་བསྐྱོད་དུས།",
    "དེ་ཉིན་ནི་བླ་འཁྱེར་བ་བཞིན་ཅི་དྲན་འདི་དྲན་མེད་པ་ཞིག་ཆགས་ཡོད་འདུག་པས།",
    "སྤྱན་མིག་སྣ་རྩེར་ཕབ་པ་ཤིན་ཏུ་ཞི་དུལ་ཅན་ཞིག་འདུག་པ་དེས་རི་ཁྲོད་པའི་སྒོམ་ཞྭ་སེར་པོ་རྙིང་ཧྲུལ་ཞིག་བཞེས་འདུག་དེ་མིན་གྱི་གཉིས་པོ་དེའང་ཞི་དུལ་ཅན་འདུག་པར་མ་ཟད།",
    "གཞི་ནས་ཁྱེད་རང་གང་ནས་ཡིན།",
    "མཐོང་མྱོང་བ་ལྟ་བུ་འདུག་གསུངས།",
    "རྩམ་པ་རྩིང་ཧྲལ་ཉུང་ངུ་དེས་དེ་བས་ཁོང་ལ་བློ་ངལ་སྣོན་མ་ཆགས་ཏེ་ཁོང་རང་དྲི་མ་མེད་པའི་ཁང་པ་གཙང་མ་ཞིག་དང་།",
    "ཚད་ལས་བརྒལ་བའི་ལས་ཚད་བཟོས་ཏེ་ལས་ཚད་དེ་དག་ངེས་པར་ལོན་དགོས་པ་སོགས་ལུས་སེམས་གཉིས་ངལ་གྱི་ལས་ཀ་སྣ་ཚོགས་བྱེད་དགོས་འདུགང་རང་གྲྭ་བཞིར་འབྱོར་བའི་ལས་ཀ་དང་པོ་ནི་རི་ལ་མེ་ཤིང་འཐུ་བར་བསྐྱོད་དགོས་བྱུང་།",
    "དེར་བརྟེན་ང་རང་ཁུར་པོ་བཟོ་བཅོས་ཀྱི་དུས་ཚོད་ཕར་བཞག་དཔུགས་ངལ་ཙམ་གསོ་ཁོམ་མ་བྱུང་བར་མཉམ་ཐོན་བྱེད་དགོས་བྱུང་ཞིང་།",
    "དེ་ཡང་ཐོག་མར་ང་རང་འབྱོར་དུས་ཉེ་འཁོར་རི་ཁྲོད་ཁག་ཏུ་ཡོད་པའི་ཚེར་མའི་ཁ་ལོ་རྣམས་ཟོར་བས་བརྔ་རྒྱུ་འདུག་ཀྱང་།",
    "བྱེ་མ་ཆུ་མགོ་ཟེར་བའི་རྒྱབ་རིའི་རྩེར་འགྲོ་དགོས་འདུག་སྟབས།",
    "དེ་ཉིན་ངའི་རོགས་པར་དེ་སྔ་སྐུ་སྲུང་དམག་སྒར་གྱི་རླངས་འཁོར་ཁ་ལོ་པ་ཚེ་རིང་དོན་གྲུབ་ཟེར་བ་ཞིག་ཡོད་པ་ང་གཉིས་ལ་གཡང་གཟར་ཞིག་ནས་ཤིང་ཨའོ་ཙམ་བྱུང་བས་བློ་བདེའི་ངང་རྟག་བརྟན་རི་ཁྲོད་ནས་མར་འབབས་ཡོང་དུས།",
    "རྣམ་ཀུན་བཙོན་པ་ཤི་རྨས་ཡང་ཡང་ཡོང་འདུག་པར་དེ་འདྲའི་ཚོར་སྣང་ཡེ་ནས་བྱུང་མྱོང་མེད།",
    "དེའི་སྐབས་རི་ལ་ཤིང་འཐུ་བར་འགྲོ་ཉིན་རྩམ་པ་སྲང་དོ་༢ ཙམ་ཡོད་པ་རྣམ་ཀུན་ང་རང་ལ་མཚོན་ན།",
    "ཆུ་བཟང་རི་ཁྲོད་དུ་མ་སླེབས་མཚམས་ཕྲང་འགག་ཅིག་ཡོད་པ་དེའི་མཚམས་སུ་བང་ཤར་བསྤྱོད་མེད་པར་ཡང་ཡང་འགག་བསྡད་ཀྱིན་འདུག་པ་ཅི་ཡིན་སྙམ་མུར་འཁྲིས་སུ་སླེབས་དུས་དེ་ནི་བསམ་ཡུལ་ལས་འདས་པ་སྟེ།",
    "དེ་ནས་ང་རང་ཡར་ལངས་ཏེ་ཤིང་ཐབས་འཚོལ་བྱ་རྩིས་སྐབས།",
    "རང་རང་སོ་སོར་གསེར་དངུལ་དང་།",
    "དེ་ཉིན་ཁོ་པས་ཟླ་ཕོའི་སྡོར་ལ་རྩངས་པ་ཁ་རལ་ཤི་རོ་ཁ་ཤས་བརྒྱབས་ཡོད་འདུག་ཀྱང་།",
    "སྐབས་དེར་ང་རང་ཡང་དམིགས་བསལ་ཚོར་སྣང་མ་བྱུང་།",
    "ཁོང་རང་ཇ་སྐོལ་མཁན་གྱི་གནས་བབས་ནས་བཙོན་པ་བྱིངས་ཀྱི་བདེ་ཐང་སྲུང་སྐྱོབ་ཀྱི་ཀུན་སློང་ལ་རྗེས་སུ་ཡིད་རངས་ཡོད།",
    "ཕྱི་ཉིན་རང་རང་སོ་སོའི་མལ་གདན་རྒྱབ་ཏུ་འཁུར་ཐོག་ཟ་རྩམ་དང་།",
    "དེ་མིན་སྡོད་མཁན་མེད་པར་བརྟེན་ཁང་འཁྲོལ་མང་པོ་འདུག་གཤིས།",
    "བརྒྱུད་རིམ་དེའི་ནང་ང་རང་ལ་ཐོག་མ་ཉམས་མྱོང་དང་།",
    "ཙ་ན་ཀ་ཡི་རྩམ་ཐུག་སླ་པོ་གཙང་པོའི་ཆུ་ལྟར་དྭངས་གྲུང་གྲུང་།",
    "ཟེར་བའི་ལས་འགུལ་སྤེལ་བཞིན་པའི་སྐབས་ཡིན་པས་འཚོ་གོས་ཁག་ཤོས་ཀྱི་དུས་ཤིག་བྱུང་འདུག་ཀྱང་།",
    "རྩམ་པ་བསྲི་ཚགས་ཀྱིས་ཉར་བ་རྣམས་ཀྱང་འཕྲོགས་འཁྱེར་བྱེད་ཀྱི་འདུག་དེ་ནི་བྲོས་བྱོལ་འགྲོ་དོགས་ཀྱིས་ཡིན་ཞིང་།",
    "ཐེངས་གཅིག་བཙོན་པ་ཞིག་ལ་ནང་མིས་སྣུམ་གྱི་བག་ཚ་མར་ཁུ་ཞིག་བསྐྱལ་འདུག་པ།",
    "སྐྱུགས་པ་དེ་བཙོན་པ་ལྟོགས་པ་གཞན་ཚོས་སུ་ཐོབ་ཀྱིས་ཟས་འདུག་དེ་ནི་སྤྱི་ལོ་༡༩༦ ལོ་མཇུག་ནས་༦ནལོ་དཀྱིལ་བར་ཡིན་ཞིང་།",
    "ཕྱི་ནང་ཚང་མར་ཤིག་དང་སྲོ་མས་ཁེངས་འདུག་སྐབས་དེར་ང་རང་ལའང་བཙོན་གོས་ཤིག་སྤྲད་བྱུང་བ་དེའི་ཕྱི་ནང་དང་།",
    "ཞེས་བྲིས་འདུག་ཕུ་ལུ་ཞེས་པ་རྒྱ་སྐད་ཡིན་ཞིང་།",
    "བསམ་ཡས་སོགས་དང་བསྡུར་ན་ཅུང་དྲག་པ་ལོས་ཡིན་སྲིད།",
    "དམར་ཐོམས་ལངས་ཏེ་རིལ་གྲབས་ཡང་ཡང་བྱེད་ཀྱི་འདུག་པ་དེ་ཚོ་ནི་རིམ་པས་གོམས་རྒྱུ་འདུག་རུང་།",
    "དེ་སྐབས་ང་རང་ན་སོ་གཞོན་ལ་ནང་མིའི་འཚོ་སྣོན་དང་བཅས་ཟུངས་ཟད་འར་ཆད་ཐེབས་པ་སོགས་ཀྱི་དཀའ་ངལ་འཕྲད་མ་བྱུང་ཡང་།",
    "ངས་ཡོན་ཏན་ཕུན་ཚོགས་ལ་ང་རང་ཁྲིད་རོགས་ཞེས་ཨུ་ཚུགས་བརྒྱབ་པ་ཡིན།",
    "དེ་མིན་ཛ་ཛོར་གང་བྱུང་ཟས་པ་ལས་བྱུང་འདུག་ཚལ་ཞིང་ནང་བསྐྱོད་སྐབས་སྔོ་ཚལ་རྗེན་པ་ང་རང་ནས་ཀྱང་ཧ་ཅང་མང་པོ་ཟ་མྱོང་ཞིང་།",
    "ལན་ཧྭ་པད་ཚལ་ལྟ་བུ་ཡིན་ན་འཇུ་སླ་པོ་འདུག་རུང་།",
    "ཧུང་ལ་ཕུག་སོགས་ཟ་ཆེ་ན་ཉིན་གང་མི་བདེ་བ་ཞིག་ཡོང་འདུག་ལྷག་པར་མི་ཁག་གཅིག་ནི་རྒྱུན་དུ་ཕར་ཚུར་བསྐྱོད་སྐབས་ཁྱི་ཕག་ལྟ་བུ་མིག་ས་ཁོ་ནར་བལྟས་ཏེ་ཟ་རྒྱུ་ཞིག་ཨེ་རྙེད་ལྟ་བར་མ་ཟད།",
    "ནག་ཉེས་སྐོར་ཡང་ཡང་ཐོ་བཀོད་བྱེད་དགོས་འདུག་པ་དེ་སྐབས་ཤེས་ཚོར་བྱུང་བར།",
    "དེ་ནས་རིམ་པས་དབུགས་ཧལ་བཞིན་པར་ཁོང་རང་ཀོང་པོར་ལོ་གཅིག་ཙམ་སྡོད་རིང་དཀའ་ངལ་རྣམས་བརྗོད་བྱུང་།",
    "འོན་ཀྱང་ཁོང་རང་བཙོན་དུ་ཚུད་དགོས་དོན་ཁ་ཆེ་སྤྱི་པའི་དོན་དུ་ཡིན་སྟབས།",
    "སྐབས་དེ་འདྲ་ཞིག་ཏུ་ང་རང་གློད་བཀྲོལ་བྱུང་ན་ནི་རབ།",
    "ཁོང་རང་ཆུང་དུས་ནས་ཕ་མར་སྲི་ཞུ་འཇུག་ལ།",
    "དེ་ནི་ང་རང་བཙོན་དུ་ཚུད་པ་ནས་ཟ་ཆ་ཕོན་ཆེ་ཤོས་འབྱོར་བ་ཞིག་ཡིན་ལ།",
    "རྒྱ་མིའི་འཚོ་བ་དང་ཐད་ཀར་འབྲེལ་བ་མེད་དུས་ཐེབས་ཆགས་ཤིག་མ་གཏོགས་བཟོས་མི་འདུག་ལྷག་པར་མལ་གྲོ་ནས།",
    "དེ་དུས་ང་རང་ལ་ལུག་ལྤགས་ཀྱི་སྟོད་ཐུང་ཆེན་པོ་ཞིག་གྱོན་རྒྱུ་ཡོད་པ་དེ་མ་ཕུད་ན་འཁྱགས་པ་བཅག་དུས་དང་།",
    "ཀོ་བ་གཙང་ཆུའི་ཕ་རིར་ཡོད་འདུག་པས།",
    "དེ་ནས་སྐད་སྟོང་གཅིག་ཙམ་གྱི་ས་ནས་སྔར་མེད་གཙང་པོར་དར་ཞིག་ཆགས་འདུག་པ།",
    "གང་ཞིག་ཡིན་སྙམ་གཡས་གཡོན་དུ་ལྟ་སྐབས་འཁྲིས་དེ་ག་རང་ནས་འཁྱགས་པ་སེར་ཁ་ཤིན་ཏུ་ཆེ་བ་ཞིག་གས་འདུག་ཆུ་ཁར་ཡོད་པའི་མི་རྣམས་ཀྱིས་ང་ལ་འཕྲལ་དུ་ལངས་དགོས་པའི་བསྐུལ་བརྡ་བྱེད་འདུག་ཀྱང་།",
    "ས་ཆ་ས་རྒྱུ་གཤིན་པོ་མང་པོ་ཞིག་ཞིང་ཆུ་འདྲེན་མ་ཐུབ་པའི་གནས་ཚུལ་འོག་ས་རྒོད་དུ་ལུས་ཡོད་པ་ལྟར་འབྲི་གུང་ལུང་པའི་ནང་ས་རྒོད་ཧ་ཅང་རྒྱ་ཆེན་པོ་འདུག་པ་དེ་དག་གྲྭ་བཞི་བཙོན་པའི་ནུས་ཤུགས་བེད་སྤྱོད་ཀྱིས་གཞི་རྒྱ་ཆེ་བའི་ཞིང་རྭ་ཞིག་བཟོ་བསྐྲུན་བྱ་རྒྱུའི་འཆར་གཞི་ལྟར་སྔོན་དུ་གྲ་སྒྲིག་བྱེད་མིར་བཙོན་པ་བཅུ་ཤོག་གཅིག་དང་།",
    "ཆུ་ནང་ལྷམ་མེད་པར་འགྲོ་བདེ་པོ་ཞིག་ཡེ་ནས་མི་འདུག་ལ།",
    "ནམ་དུས་ཀྱང་དཔྱིད་འགོ་ཟིན་པས་ཆུ་ལ་དེ་ཙམ་གྱི་གྲང་ཟུག་མི་འདུག་ཡིན་ནའང་དེ་སྐབས་ང་རང་ལ་དམིགས་བསལ་གྱི་དཀའ་ངལ་ཞིག་འཕྲད་པ་སྟེ།",
    "ཡིན་ནའང་ང་རང་ལ་དེ་སྔ་གཡག་ལ་ཁལ་འགེལ་རྒྱུའི་ཉམས་མྱོང་ཕར་བཞག་གཡག་རྫི་ཙམ་ཡང་བྱེད་མྱོང་མེད་ཁར།",
    "གཡག་དེ་རྣམས་ཀྱང་དེ་སྔ་ཁལ་རྩ་བ་ནས་འཁྱེར་མྱོང་མི་འདུག་ལྷག་པར་གཡག་ལ་ཁལ་འགེལ་བྱེད་ཀྱི་སྒྲ་མེད་པར་སྒལ་པ་རྗེན་རང་དུ་ཁལ་འགེལ་དགོས་འདུག་སྟབས་ཐོག་མར་གཡག་བཟུང་མ་ཐུབ་པའི་དཀའ་ངལ་དང་།",
    "རྗེས་སུ་རང་རང་སོ་སོས་སིལ་སིལ་བཟོ་དགོས་བྱུང་བས་དཀའ་ངལ་སྣོན་མ་ཞིག་བྱུང་།",
    "ཡང་ན་འགུལ་ཙམ་བྱེད་མ་སྐྱིད་པའི་ཉོབ་ཏོ་ཞིག་རྟག་ཏུ་ཡོང་འདུག་ལ།",
    "གང་ལྟར་སྔ་ལོ་ཙམ་ནས་ལུང་པ་དེར་ཤ་བ་རྣམས་མེད་པར་གྱུར་འདུག་ཅེས་ཟེར།",
    "བོད་ཀྱི་རྩ་ཆེའི་རི་དྭགས་རྩ་མེད་དུ་འགྲོ་བའི་ཉེན་ཁ་ཆེ་ཤོས་དེ་དུས་བྱུང་འདུག་དཔེར་ན།",
    "དགོ་བ་སོགས་རྗེས་དེད་དང་སྦྲགས་སྦག་སྦག་བརྒྱབ་སྟེ་བསད་འདུག་རྐྱང་སོགས་རི་དྭགས་རྣམས་ཁྱུ་དང་ཁྱུ་མང་ཡོད་སྟབས་འཛད་མཐར་མ་ཐུག་ཀྱང་།",
    "ལུང་པ་དེའི་ཕུ་མང་ཆེ་བ་ཆེ་ཆུང་ལ་མ་ལྟོས་པའི་ཤིང་ནགས་ཀྱིས་ཁེངས་འདུག་ལྷག་པར་གཞོགས་གཅིག་ལ་དེ་སྔ་མི་རབས་མང་པོར་གཅོད་འབྲེག་མ་བྱས་པའི་ཤིང་གླང་མའི་ནགས་ཚལ་ཞིག་འདུག་པ་དེ་དག་ཡུལ་དེའི་གཞི་བདག་གནས་ཡུལ་ཡིན་སྐད།",
    "ཅོད་པན་སོགས་ལྷ་གསོལ་བའི་རྟགས་མང་པོ་འདུག་པ་ཡུལ་མི་ཚོས་གཅེས་ཉར་བྱེད་པའི་ནགས་ཚལ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "སྐབས་དེར་ལས་འགུལ་དེའི་ནང་ཁོང་རང་ཉིད་ཀྱིས་ངོས་འཛིན་དེ་འདྲ་ཞིག་བྱས་པ་སྟེ།",
    "ང་རང་འགྲོ་མྱོང་བ།",
    "འབྲི་གུང་ཉི་མ་ལྕང་ར་སོགས་ཀྱང་འབྲུ་མཛོད་བྱས་འདུག་ཅིང་།",
    "ང་རང་ཡང་གྲོང་ཉིང་བཙོན་དུ་འབྱོར་གདོང་ཁོ་པའི་རྩར་སྐད་ཆ་ཉན་པར་ཡང་ཡང་བསྐྱོད་པ་ཡིན།",
    "ང་རང་ནས་ངའི་བློ་མཐུན་ཉེ་ཤོས་དང་།",
    "ཁོང་ནས་ཕྱི་མིག་ལྟ་བཞིན་ང་རང་ཐུག་རྒྱུའི་སྦི་སང་བྱེད་བཞིན་འདུག་པ་ལྟར་ང་གཉིས་ངོ་ཐུག་བྱུང་།",
    "གང་ལྟར་ཁོ་རང་ཨ་ནན་གྱི་སྐོར་ནས་རྙོག་དྲ་ཞིག་བྱུང་སྟེ་འཐབ་རྩོད་ཐེངས་མང་བྱས་སྟབས་ཚབས་ཆེའི་ལས་འགུལ་དེ་ཚོ་ངོས་ལེན་བྱས་པ་དང་།",
    "ཉིན་ཤས་རྗེས་ང་རང་འབོད་དེ།",
    "ཁོང་རང་ནི་དེ་སྔ་ང་རང་རྔ་ཆེན་དུ་སྡོད་སྐབས་ལས་ཀའི་པ་སེ་འཐོལ་པ་སྤྲོད་མཁན་ཞོལ་ཁང་ཨེ་པ་ཡོན་བདག་བསྟན་འཛིན་རྡོ་རྗེ་ལགས་ཀྱི་བུ་ཡིན་པ་དང་།",
    "དེར་བརྟེན་ཁྱེད་རང་བློ་ཕམ་ལོས་ཡོང་།",
    "ངས་གློད་བཀྲོལ་བྱུང་མ་ཐག་ཨ་ཞང་མཁན་དྲུང་དང་།",
    "གཅེན་པོ་རྩེ་མགྲོན་གཉིས་ཐུག་འཕྲད་དུ་བསྐྱོད་རྒྱུ་དེ་ནི་ང་རང་གློད་བཀྲོལ་བྱུང་རྗེས་ཀྱི་བྱ་བ་དང་པོ་དེར་བརྩི་ཡི་ཡོད་ཀྱང་།",
    "ང་རང་ཡང་འཇིག་རྟེན་གསར་པ་ཞིག་ཏུ་འཚོ་བ་སྐྱེལ་འགོ་ཚུགས་ཤིང་།",
    "མདང་ནུབ་ཁྱེད་རང་དེ་རིང་ནང་དུ་སླེབས་རྒྱུ་ཡིན་པ་སྣང་བའི་ཡུལ་ལ་མེད།",
    "སྦྱིན་བདག་སོགས་ལ་སྐུར་འདེབས་འཐབ་རྩོད་ཞུ་དགོས་ཀྱི་བཙན་ཤེད་བསུན་གཙེར་ལ་གདོང་ལེན་བྱེད་རྒྱུ་དེ་བྱུང་འདུག་དེ་རྗེས་༡༩༦ ལོར་བསྐྱར་ཞིབ་ཟེར་བ།",
    "གྲོང་མི་དམིགས་བསལ་ཅན་ཉུང་ཤས་ལ་བག་ལེབ་ཚོང་རྒྱུའི་ལག་འཁྱེར་ཡོད་འདུག་པ་ལས།",
    "གྱོན་ཆས་ཤིག་ལ་མཚོན་ན་ཚོས་གཞི་དང་ཆེ་ཆུང་སོགས་འདེམས་ཀ་བྱེད་རྒྱུ་རྩ་བ་ནས་མི་འདུག་ལྷག་པར་འབྲུ་སྣུམ་ལ་དོ་དམ་ཤིན་ཏུ་ཆེ་བ་དང་།",
    "བག་ལེབ་ཚོང་མཁན་གྱི་སྒོ་འགྲམ་དུ་ག་དུས་ཡིན་ཡང་མི་ཚོགས་ཤིན་ཏུ་མང་པོ་མཐོང་རྒྱུ་ཡོད།",
    "ཡང་རྒྱ་གཞུང་རང་ནས་གསེར་དང་དངུལ།",
    "ལྐོག་ཏུ་ཅ་དངོས་ག་འདྲ་ཞིག་ཉོ་དགོས་བྱུང་ཡང་གོང་ཚད་བློས་མ་འཁྱུད་པ་སྤྲོད་དགོས་ཀྱི་འདུག་ངས་དྲན་པ་ཞིག་ལ་དེ་སྐབས་གྱོན་ཆས་ནང་ནས་གལ་ཆེ་ཤོས་ལྷམ་ཡིན་ཞིང་།",
    "མི་རིང་བར་ལས་གྲྭ་དེའི་ཁོངས་ཤིང་བཟོ་ལས་སྣོན་ཁང་ཞིག་འདུག་པ་དེར་ཁང་པའི་ཤིང་ཆ་གློག་འཕྲུལ་གྱི་སོག་གཤགས་རྒྱག་རྒྱུ་དང་།",
    "ང་རང་ནས་ཀྱང་ལས་ཀར་གཡོ་ཟོལ་ངོ་ལྐོག་མེད་པར་ཧུར་ཐག་བྱས་པར་རྟེན་ལས་ཀ་སྐུལ་མཁན་རྒྱ་མི་ཤིང་བཟོ་བ་ཚོས་སྡུག་པོ་རང་བྱས་མ་བྱུང་།",
    "ང་རང་ནི་གྲལ་རིམ་མངའ་བདག་ཡིན་ལ།",
    "ཁེ་སླེབས་ཚང་མ་རྒྱ་གཞུང་རང་ནས་འོལ་ཚོད་ཚད་འབེབས་བྱས་པ་ལས་ཁོ་བོར་དེའི་བཅུ་ཟུར་ཙམ་ཡང་མེད་ཅེས་ཟེར་འདུག།",
    "ང་རང་བཙོན་བཀྲོལ་བྱུང་སྐབས་ཀྱང་མཇུག་མ་བསྒྲིལ་བར་བསྡད་འདུག་དེ་སྐོར་ཡོང་རྐྱེན་དང་སྦྲགས་ཅུང་ཞིབ་ཙམ་ཞུས་ན།",
    "བརྡབས་བསིགས་བཏང་སྟེ་སྐབས་ཤིག་རིང་ཁ་ཆེ་དེ་རྣམས་ས་གཞིར་མི་ཤོངས་པའི་ཁེངས་དྲེགས་དང་བཅས་གནས་འདུག་ཅིང་།",
    "ང་རང་ཡང་ལྷ་སར་བསྡད་པ་ཞིག་དང་སྐབས་འཁེལ་ནས་ལྟ་སྐོར་དུ་ཁྲིད་བྱུང་ཞིང་།",
    "གོད་བྲོ་བ་ཞིག་ནི་ལྷ་ས་ཤ་ཁྲོམ་དབར་དུ་སྡོད་པ་ཚོང་ཆུང་ཁམས་པ་རྒྱག་པ་ཞིག་ཡོད་པ་ཁོང་རང་དངོས་འབྲེལ་བྱས་ན་ལྟ་སྐོར་ལ་མ་ཕྱིན་ཀྱང་འགྲིགས་པ་སྟེ།",
    "དེ་མིན་རྒྱུ་རྐྱེན་གང་ཞིག་ཡིན་མིན་སློབ་བསྡུ་ཚོགས་ཆུང་ནས་འགྲེལ་བརྗོད་གནང་རོགས་བརྗོད་འདུག་པར།",
    "རི་ལྡེབ་འགར་ཡང་མཆོད་རྟེན་གྱི་བང་རིམ་བརྩེགས་པ་ལྟ་བུའི་སྐས་ཞིང་མང་པོ་མཐོང་རྒྱུ་འདུག་ཕུ་རྣམས་ལ་འབྲོག་ཟླ་པ་སཔ་མང་པོ་གནས་བཅའ་བའི་སྤང་གཤོངས་ཧ་ཅང་ཡག་པོ་ཡོད་སྐད།",
    "མཚེའུ་དེའི་ལོགས་ཤིག་ན་རི་སུལ་ཆེན་པོ་ཞིག་འདུག་པ་དེ་ནས་ཐོན་པའི་ལྕགས་རྡོ་བཙོ་སྦྱང་བྱས་ནས་སྤོ་གྲི་ཞེས་པ་གྲགས་ཅན་དེ་བརྡུངས་བཟོ་བྱེད་ཀྱི་ཡོད་སྐད་ཡུལ་མིས་གྲགས།",
    "ལྷག་པར་མི་འབོར་ལ་དཔག་པའི་ལྐུགས་པ་ཡང་མང་ཙམ་འདུག་ཡུལ་མི་ཚོའི་སྡོད་སྟངས་ནི་ཕལ་ཆེ་བ་འདུས་སྡོད་མ་ཡིན་པར་ཁ་ཐོར་གྲོང་གཅིག་མ་ཡིན་ཞིང་།",
    "ཐག་པ་གསོ་ཉར་བྱེད་འདུག་སྐྱེས་པ་མང་ཆེ་བ་རྔོན་རྒྱག་པར་སྤྲོ་བས་ཇོན་ཁྱི་རིགས་འདྲ་མིན་ལ་དང་ཞེན་ཆེན་པོ་འདུག་ཡུལ་མི་ཚོའི་འཛད་སྤྱོད་ཉེར་མཁོ་གལ་ཆེ་ཤོས་ཚུ་ཡིན་ཞིང་།",
    "བར་བཅད་སོགས་མེད་པའི་ས་ཕག་རྒྱག་སའི་གཡབ་ཞིག་ནང་མི་གྲངས་བརྒྱ་སྐོར་མཉམ་རུབ་ཏུ་སྡོད་ས་ཞིག་གོ་སྒྲིག་བྱས་འདུག་པ་དེར་ཚོགས་ཆུང་སོ་སོ་ས་བགོས་བྱས་ཏེ་བསྡད།",
    "ང་རང་དེ་སྔ་བཙོན་ནང་འཁོར་ཆུང་དེ་གྲས་བཟོ་བཅོས་ཀྱི་ཉམས་མྱོང་ཕྲན་བུ་ཡོད་པས་འཁོར་ལོ་བཟོ་བཅོས་ཀྱི་ཚོགས་ཆུང་ཞིག་ཏུ་ལས་བགོས་བྱས་བྱུང་ཞིང་།",
    "དེ་མིན་གཞི་རྒྱ་ཆེ་བའི་རྒྱ་མིའི་སྡོད་སྒར་ཞིག་ཡོད་ཚོད་མི་འདུག་གང་ལྟར་དུས་ཡུན་ཐུང་ངུ་ཞིག་ནང་ལུང་པ་དེའི་ནགས་ཚལ་ལ་གནོད་སྐྱོན་དོ་ཕོག་ཧ་ཅང་ཆེན་པོ་བཟོས་པ་ནི་མངོན་གསལ་དོད་པོ་ཡོད།",
    "ཤིང་ཆའི་ལས་སྣོན་བཟོ་གྲྭ་ཞིག་ཀྱང་བཙུགས་ཟིན་འདུག་ལ།",
    "ཀྲུང་དབྱང་དཔོན་རིགས་ཤིག་ལ་ཇུས་ཉེས་ཡོང་བཟོ་འདུག་གང་ཡིན་ཟེར་ན།",
    "ཡིན་ནའང་ཁོང་རང་སྐབས་དེར་གཉེན་འཕྲད་དགོངས་ཞག་མ་ཐིམ་གོང་ཕྱིར་ལོག་བྱེད་དོན་ནི་བར་དེར་ལྷ་སར་ལས་འགུལ་གྱི་ཟིང་ཆ་བྱུང་བ་དང་སྐབས་འཁེལ་བས་ལྷ་སར་སྡོད་ཆགས་པ་ཞིག་ཡེ་ནས་མ་བྱུང་ཟེར་བ་དང་སྦྲགས་སྐབས་དེའི་གནས་ཚུལ་ཞིབ་ཆ་བརྗོད་བྱུང་།",
    "གའུ་བྲལ་དཔང་སོགས་ཡོད་རིགས་ནི་ལོས་ཡིན།",
    "དཔུང་རས་དམར་པོ་ཞིག་ལ་དམར་སྲུང་དམག་ཟེར་བའི་ཡིག་འབྲུ་སེར་པོ་འཁོད་པ་བཅས་བརྒྱབ་འདུག་དེ་བཞིན་མི་དམངས་བྱིངས་ཀྱི་གྱོན་ཆས་བོད་ཆས་གྱོན་མཁན་བྱེད་ཚོའང་རྒྱབ་སུལ་ཙམ་མ་གཏོགས་སྐྱེས་པ་ནང་བཞིན་ཡར་སྡོག་པང་གདན་ཁྲ་ཅན་མ་ཡིན་པར་རས་ནག་པོའི་པང་གདན་བཅིངས་པ་སོགས་སྐབས་དེའི་མི་རྣམས་ཀྱི་ཆ་ལུགས་དང་།",
    "དེ་ནས་སྒེར་སོ་སོའི་ཁང་པ་བསྔོག་བཤེར་བྱས་པའི་ཐོག་མ་དེ་སྔ་གཞུང་ཞབས་ཡིན་པ་བྱང་ངོས་རྡོ་རྗེ་དངོས་གྲུབ་ཀྱི་ཁང་པ་བསྔོག་འདུག་ཁོང་པ་བོད་སྒེར་ལངས་ཀྱི་བཙན་རྒོལ་ལས་འགུལ་ནང་ཞུགས་མེད་པས་མཁར་དངོས་རང་འཇགས་གནས་ཡོད་སྟབས་དེ་སྔའི་འཛིན་ཆས་དང་།",
    "རྗེས་སུ་གཞུང་གཉེར་དཔེ་དེབ་ཚོང་ཁང་ཞིག་ནང་ལས་བགོས་བྱས་ཏེ་སྐབས་དེ་དུས་ལས་གནས་དེ་རང་དུ་ཡོད་འདུག་ཀྱང་།",
    "སྐྱེ་ལ་དཔྱངས་ཐག་སྒྲོག་པ་སོགས་ཀྱི་བྱ་ཐབས་ལ་བརྟེན་ནས་རང་ཤི་རྒྱག་མཁན་ཇི་སྙེད་ཅིག་བྱུང་འདུག་པའི་ནང་ཡ་ང་ཤོས་གཅིག་ནི།",
    "ལྷ་ས་བར་བསྐོར་ལྷོ་བརྒྱུད་ལྕོག་རིལ་འོག་རྒྱ་ཟོག་ཚོང་ཁང་གཉེར་མཁན་ཕྲུ་གུ་རྒན་གཞོན་གསུམ་ཡོད་པ་ཚོང་པ་བཟའ་ཚོ་གཉིས་ལ་ལྷ་འདྲེ་གདོན་བགེགས་ཟེར་བའི་དོན་རྐྱེན་གྱི་དཀའ་རྙོག་འཕྲད་སྟབས་ལྷ་ས་སྐྱིད་ཆུའི་ཟམ་ཆེན་སྟེང་ནས་བཟའ་ཚོ་བུ་ཕྲུག་དང་བཅས་མི་ལྔ་དུས་གཅིག་ཏུ་ཆུར་ལྕེབས་འདུག་པར་ཟམ་སྲུང་རྒྱ་དམག་ནས་བཏོན་ཐབས་བྱས་འདུག་ཀྱང་།",
    "ང་རང་ནི་གྲལ་རིམ་ཡིན་ལ།",
    "ལོ་ན་གཞོན་པས་ག་དུས་ཡིན་ཡང་ལས་ཀ་ལྕི་ཤོས་དང་།",
    "ཐེངས་ཤིག་ལས་སར་ང་རང་ལའང་འཇོར་རྒྱག་སྐབས་ནུས་ཤུགས་བཏོན་གྱི་མི་འདུག་ཟེར་བ་དང་།",
    "གཏམ་བརྗོད་ཟློས་གར་གྱི་འཁྲབ་ཚན་ནང་དུའང་དེ་སྐོར་འཁྲབ་ཡོད་འདུག་ཅིང་།",
    "དེ་ཡང་དབོར་འདྲེན་བྱེད་མཁན་ལྷ་སའི་ནང་རྟ་དྲེལ་གྱི་ཐེར་ཀ་གཏོང་མཁན་ཚོ་གླས་འདུག་ཅིང་།",
    "གང་ལྟར་ས་ཕག་གཅིག་ཡོད་ཕྱིན་བྲིན་ཁ་རྒྱུགས་ལོས་ལ་ཐེ་ཚོམ་མི་འདུག་སྙམ་ཏེ།",
    "ཡིན་ནའང་ངའི་རོགས་པ་བློ་བཟང་འཇིགས་མེད་ལགས་ཉམས་ལེན་པ་ཞིག་ཡིན་པས་འགག་རྩར་ཐུག་དུས་བློ་རྒྱ་ཆེ་ལོས་ཁྱད་པར་ཧ་ཅང་ཆེ་བ་བཞིན།",
    "གནས་སྐབས་མཚམས་འཇོག་བྱ་རྒྱུར་ཐག་བཅད་དེ་ས་ཕག་རྣམས་ཕྱོགས་གཅིག་ཏུ་བརྩིགས་ཏེ་དབྱར་ཁ་ཆར་ཆུས་མི་འཇིགས་པའི་ཆེད་ཆུ་ཆས་བྱས་ཏེ་ལུང་སྟོང་དེའི་ནང་རང་དགར་མ་བཞག་མཐུ་མེད་བྱུང་།",
    "ཉུང་ཤས་ཡོད་པ་དེ་ཚོས་ནི་གྲལ་རིམ་པ་ཟེར་བར་ལས་ཀ་རྩ་བ་ནས་སྤྲོད་ཀྱི་མི་འདུག་ནམ་དུས་དབྱར་ཁ་ཡིན་ན།",
    "ལར་ནས་རང་ཉིད་བློ་རྒྱ་ཤིན་ཏུ་ཆུང་བའི་རྐྱེན་གྱིས་སྐབས་དེའི་སྣ་མང་འདྲེས་འཛིངས་ཀྱི་དཀའ་རྙོག་རྣམས་བསམ་བློས་བཅོས་མ་ཐུབ་པར་སྨྱོན་པ་མི་ཆགས་པའི་ངེས་པ་མི་འདུག་དེས་ན་བསམ་བློ་གུ་ཡངས་ཡངས་དང་།",
    "ཤར་འབྲོམ་སྟོད་བར་མཐོང་བས་རྒྱ་མི་བོད་དུ་འབྱོར་བ་ནས་སྐབས་དེ་ཤེད་བར་དུས་ཡུན་ལོ་ངོ་བཅུ་གྲངས་ནང་ལྷ་ས་གཅིག་པུར་རྒྱ་མིའི་སྡོད་སྒར་རྒྱ་བསྐྱེད་ཇི་ཙམ་བྱས་པ་གསལ་པོར་མཐོང་ཐུབ་ཀྱི་འདུག་ལ།",
    "ང་རང་ལས་ཀ་བྱེད་སའི་ཤིང་བཟོ་མཉམ་ལས་དེའི་མི་མང་ཆེ་བ་གསར་བརྗེའི་མཉམ་སྦྲེལ་ཆེན་པོའི་ཁོངས་མི་ཡིན་ཞིང་།",
    "ང་རང་གླ་མི་ཞིག་ཡིན་སྟབས་མཉམ་ལས་སྒོ་རྒྱག་སྐབས་གླ་མེད་པར་སྡོད་དགོས་ཡོད།",
    "ཡིན་ནའང་དུས་བབས་ཛ་དྲག་དེ་འདྲ་ཞིག་ནང་མང་ཉུང་ལ་མ་ལྟོས་པར་ཡོང་འབབ་ཅིག་ཡོད་པ་དེས་ཆོག་ཤེས་བྱེད་དགོས་པ་ལོས་ཡིན།",
    "ཐེངས་གཅིག་སྔ་དྲོ་ང་རང་སོག་གཤགས་ཀྱི་ལས་ཀར་བསྐྱོད་སྐབས་ངའི་ལས་ཀ་བྱེད་སའི་སོག་གཤགས་ཀྱི་སྒྲོམ་འོག་དེར་དཀར་ཐིག་སྒོར་སྒོར་ཞིག་འཐེན་འདུག་པ་ཅི་ཡིན་སྙམ་མུར།",
    "གཡས་གཡོན་དུད་ཚང་ཁག་ནས་མི་ཐོན་ཡོང་སྟེ་ང་ལ་དེར་འབར་རྫས་སྦས་འདུག་དེར་མ་འགྲོ་ཞེས་སྐད་བརྒྱབ་བྱུང་།",
    "དེའི་ཞོགས་པ་ང་རང་ལས་ཀར་བསྐྱོད་སྐབས་ངས་ཀྱང་རོ་དེར་ཁེབས་གཡོགས་བཞག་པ་དངོས་སུ་མཐོང་བྱུང་།",
    "རྐང་མཐིལ་ལ་ལྕགས་གཟེར་བརྒྱབ་འདུག་ཟེར།",
    "མཉམ་སྦྲེལ་གྱི་མིའི་བྱེད་སྟངས་ལ་བལྟས་ན་ང་རང་ཡང་ནང་དུ་མ་འབྱོར་བར་གསོན་པོ་ཡིན་བསམ་པ་ཞིག་དྲན་གྱི་མི་འདུག་དེ་རྗེས་ལྷིང་འཇགས་མཚམས་གཙུག་ལག་ཁང་དུ་ཡོད་པའི་མི་རྣམས་ཀྱི་ནང་མི་བཟའ་ཟླ་བུ་ཕྲུག་དང་།",
    "དེ་ཡང་གོང་དུ་ལྐོག་བསད་བཏང་བའི་མི་རོ་ལྷ་སའི་བར་བསྐོར་ནང་གཡུགས་དོན་གྱེན་ལོག་ཤོག་ཁར་ངར་སློང་བ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "མར་ཟན་དེ་སུས་བསྒྲིགས་པ་ཡིན་ཞེས་ངར་སྐད་དང་བཅས་ཡང་ཡང་བརྗོད་འདུག་ངོས་ནས་དེ་ངས་བསྒྲིགས་པ་ཡིན་ཞེས་ལབ་པར།",
    "ངའི་མར་ཟན་དེ་མཉམ་བཞག་ཏུ་བཅུག་སྟེ་ང་རང་ལ།",
    "ཞེས་པའི་སྦྱར་ཡིག་སྦྱར་འདུག་པ་ནས།",
    "ང་རང་རྣམ་ཀུན་མར་ཟན་ལ་དགའ་བ་དང་།",
    "གདོང་པ་ལུག་ལྷག་པར་དེ་སྐབས་ང་རང་ཡ་འཆམ་ལྟ་བུས་ཁ་ལུད་སྣ་ལུད་འཛར་མེད་ཐོན་པའི་སྐབས་ཡིན་པས་དེ་བས་དཀའ་ངལ་འཕྲད་བྱུང་།",
    "ཅེས་འཇིགས་གཏམ་ཡང་ཡང་བརྗོད་ཀྱི་འདུག་པ་དེ་དག་ཚོད་དཔག་ཡིན་ནམ།",
    "དེར་བརྟེན་ཁྱེད་རང་དེར་བལྟས་ན་ལས་ཁྱེད་ཀྱི་ནང་དུ་བསྐུར་གྱི་མིན།",
    "གཞི་རྐང་མི་དེ་དང་ང་རང་ཐད་ཀར་འབྲེལ་བ་མེད་ལ་དེབ་མེར་བསྲེག་བཏང་ཟིན་རུང་།",
    "དེ་བས་སེམས་འཕྲལ་ཆེ་བ་ནི་ང་རང་ནས་བཤུ་འདྲི་བྱས་པ་ཡིན་ཞེས་གཅིག་པུ་ངོས་ལེན་བྱས་པས་མི་འགྲིགས་པར་མ་དཔེ་གང་ནས་བྱུང་མིན་སོགས་གཞན་མང་པོ་ཞིག་ཐེར་འདོན་བྱེད་དགོས་ཀྱི་ཡོད།"
  ]
}