    "སོར་མོའི་རྩེ་མོ་ལ་བརྟེན་ནས་ཟླ་བ་ལ་ལྟ་བ་ལྟ་བུའམ།",
    "གཟུགས་བརྙན་ལ་བརྟེན་ནས་གཟུགས་དངོས་ལ་ལྟ་བ་ལྟ་བུ་དག་གིས་རྣམ་པར་རྟོག་པའི་གཟུགས་བརྙན་ལ་བརྟེན་ནས་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་སོ་སོ་རང་གིས་རིག་པའི་དོན་གྱི་ཡུལ་ལ་རྗེས་སུ་འཇུག་པར་བྱེད་དོ།",
    "ཇི་ལྟར་རབ་རིབ་ཅན་དག་གིས་སྐྲ་ཤད་ལ་སོགས་པའི་ངོ་བོ་ཕྱིན་ཅི་ལོག་མཐོང་བ་ན།",
    "རབ་རིབ་མེད་པ་ལྟར་སྐྲ་ཤད་ལ་སོགས་པའི་རང་གི་ངོ་བོ་མ་མཐོང་བའི་ཚུལ་གྱིས་རྟོགས་པར་བྱ་བ་ཇི་ལྟར་གནས་པ་བཞིན་རྟོགས་པར་མི་ནུས་ཀྱི།",
    "འཕགས་པ་རྣམས་སྒྲོ་བཏགས་པའི་སྒོ་ནས་དེ་ཁོ་ན་ཉིད་སྟོན་མོད་ཀྱི།",
    "དེ་ལྟ་ན་ཡང་དེ་ཙམ་གྱིས་འཕགས་པ་མ་ཡིན་པ་རྣམས་ཀྱིས་དེའི་རང་གི་ངོ་བོ་རྟོགས་པར་མི་འགྱུར་ལ།",
    "རང་གི་ལྟ་ལ་ཆགས་དང་དེ་བཞིན་དུ།",
    "རང་གི་ཕྱོགས་ལ་ཆགས་ཡོད་ཅིང་།",
    "གཞན་ཕྱོགས་ལ་ཁྱོད་མི་དགའ་ན།",
    "འདིར་ཁྱོད་ཀྱིས་རྒོལ་བ་ཇི་ལྟར་བརྟགས་པ་ཐམས་ཅད་བཀོད་ཅིང་བཀོད་ཅིང་བསྟན་བཅོས་ལས་བཀག་པ་མ་ཡིན་ནམ།",
    "རྣམ་པར་དཔྱད་པ་འདི་ནི་རྩོད་པའི་ཕྱིར་མཛད་པ་མ་ཡིན་མོད་ཀྱི།",
    "ངུར་སྨྲིག་གི་ནི་གོས་བགོས་ཤིང་།",
    "ཕུང་པོ་རྣམས་ལ་ཀུན་ནས་ཉོན་མོངས་པར་འགྱུར་བའི་དམིགས་པ་གང་ཡིན་པ་དེ་ནི་ཀུན་རྫོབ་པ་ཡིན་ཞིང་།",
    "འདི་ལྟ་སྟེ་བདུད་དང་ཉོན་མོངས་པ་ཐམས་ཅད་ཚར་གཅད་པ་དང་།",
    "ལས་བཞི་པོ་དེ་དག་ལས་གཅིག་གིས་ཡོངས་སུ་བསྡུས་སོ།",
    "གཉིས་པ་གང་ཟག་གི་རང་བཞིན་ལ་ཕྱིན་ཅི་ལོག་ཏུ་འཁྲུལ་པ་ཟློག་པ་ལ།",
    "ཉོན་མོངས་སྐྱོན་རྣམས་མ་ལུས་འཇིག་ཚོགས་ལ།",
    "དེ་ལ་འཇིག་ཚོགས་ལ་ལྟ་བ་ནི་ང་དང་ངའི་སྙམ་པ་དེ་ལྟ་བུའི་རྣམ་པར་རྟོག་པ་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ནོ།",
    "ཉོན་མོངས་པ་རྣམས་དང་སྐྱོན་རྣམས་སོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ནི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རྩ་བ་ཅན་དང་།",
    "ངར་འཛིན་པ་ནི་བདག་གི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཉོན་མོངས་པ་དང་སྐྱོན་མ་ལུས་པ་ཡོངས་སུ་སྤོང་བར་འདོད་པས་འཇིག་ཚོགས་ལ་ལྟ་བ་ཁོ་ན་སྤང་བར་བྱ་བ་ཡིན་ལ།",
    "དེ་ཡང་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པའི་བདག་མེད་པ་ཉིད་ཁོང་དུ་ཆུད་པ་ལས་སྤོང་བར་འགྱུར་བས་ཐོག་མར་རྣལ་འབྱོར་པས་བདག་ཁོ་ན་འགོག་པར་བྱེད་དོ།",
    "གང་གི་ཚེ་སྐྱེས་བུ་ལ་སྒྲ་ལ་སོགས་པའི་ཡུལ་ཉེ་བར་ལོངས་སྤྱོད་པའི་རྣམ་པ་ཅན་གྱི་འདོད་པ་སྐྱེས་པ་དེའི་ཚེ་སྐྱེས་བུའི་འདོད་ཡོངས་སུ་ཤེས་པའི་རང་བཞིན་དང་སྐྱེས་བུ་སྦྱོར་ཞིང་དེ་ནས་སྒྲ་ལ་སོགས་པ་འབྱིན་པར་བྱེད་དོ།",
    "རེག་བྱ་དག་གོ།",
    "གང་གི་ཕྱིར་རབ་ཏུ་བྱེད་པ་ཁོ་ན་ཡིན་གྱི་ཆེན་པོ་ལ་སོགས་པ་ལྟར་རྣམ་པར་འགྱུར་བ་ཡང་ནི་མ་ཡིན་ནོ།",
    "ཆེན་པོ་ལ་སོགས་པ་དག་ཀྱང་རང་གི་རྣམ་པར་འགྱུར་བ་ལ་ལྟོས་ནས་རང་བཞིན་ཡིན་ལ།",
    "དེ་ལྟར་སྐྱེས་བུ་སེམས་པ་ཡོད་པའི་རང་གི་ངོ་བོ་ཡིན་པའི་ཕྱིར་བདག་ཡུལ་དག་ཉེ་བར་ལོངས་སྤྱོད་དོ།",
    "དེ་ལྟར་འདོད་པས་ཡུལ་ཉེ་བར་ལོངས་སྤྱོད་ཅིང་གང་གི་ཚེ་ཆགས་པ་ཆུང་བ་ཉིད་ཀྱིས་སྐྱེས་བུ་ཡུལ་དག་ལ་ཆགས་པ་དང་བྲལ་བར་གྱུར་པ་དེའི་ཚེ་རིམ་གྱིས་བསམ་གཏན་བསྒོམས་ཤིང་ལྷའི་ཤེས་པ་ཡང་དག་པར་བླངས་པས་ལྷའི་མིག་གི་སྒོ་ནས་རང་བཞིན་ལ་ལྟ་བར་བྱེད་ལ།",
    "དེས་བལྟས་པ་དང་དེ་གཞན་གྱི་བུད་མེད་ལྟར་ངོ་ཚ་བར་གྱུར་པས་བདག་ལ་མི་ཁྲོ་ཞིང་བྲལ་བར་འགྱུར་རོ།",
    "ཁྱབ་པར་བྱེད་པ་ཉིད་མ་ཡིན་པའི་ཕྱིར་ན་བྱ་བ་མེད་པ་ཉིད་དེ་དེ་ལྟ་བུ་ནི་སྐྱེས་བུའི་ཁྱད་པར་དག་གོ་ཞེས་བྱ་བ་ནི་གྲངས་ཅན་པ་དག་གི་གཞུང་ལུགས་སོ།",
    "ཇི་ལྟར་གྲངས་ཅན་པ་དག་གིས་དེ་ལྟར་ཁས་བླངས་པ་དེ་བཞིན་དུ།",
    "བདག་གི་ཡོན་ཏན་དགུ་སྨྲ་བར་བྱེད་དོ།",
    "འདོད་པ་ནི་འདོད་པར་འགྱུར་བའི་དངོས་པོ་ལ་རེ་བ་འཆའ་བའོ།",
    "དེ་ལྟར་བདག་གི་ཁྱད་པར་ཅུང་ཟད་ཅུང་ཟད་ལ་བརྟེན་ནས་མུ་སྟེགས་ཅན་རྣམས་ཀྱི་ལུགས་ཕན་ཚུན་ཐ་དད་པར་འགྱུར་རོ།",
    "རང་ཚིག་གི་རྗེས་སུ་དཔག་པ་དང་འགལ་བའི་གནོད་བྱེད་བསྟན་པ།",
    "མོ་གཤམ་བུ་ལྟར་སྐྱེ་བ་དང་བྲལ་ཕྱིར།",
    "མ་སྐྱེས་པའི་ཕྱིར་མོ་གཤམ་གྱི་བུ་བཞིན་ནོ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "ཇི་ལྟར་ཁྱོད་ཀྱིས་མོ་གཤམ་གྱི་བུ་མ་སྐྱེས་པ་ཉིད་ཀྱི་ཕྱིར་ཡོད་པ་ཉིད་དང་ངར་འཛིན་པའི་ཡུལ་དུ་མི་འདོད་པ་དེ་བཞིན་དུ་བདག་དེ་ཡང་མ་སྐྱེས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ལ་གྲངས་ཅན་པའི་གཞུང་ལས་ནི་བདག་གི་ཁྱད་པར་རྟག་པ་དང་བྱེད་པ་པོ་མ་ཡིན་པ་དང་ཟ་བ་པོ་དང་ཡོན་ཏན་མེད་པ་དང་བྱ་བ་མེད་པར་འདོད་པ་དེ་ལ་བདག་རྟག་པ་མ་ཡིན་ཞིང་བྱ་བ་མེད་པའི་བར་དུ་ཡང་མ་ཡིན་ཏེ།",
    "མ་སྐྱེས་པའི་ཕྱིར་མོ་གཤམ་གྱི་བུ་བཞིན་ནོ།",
    "ཕྱོགས་འདིས་ནི་མུ་སྟེགས་ཅན་རྣམས་ཀྱི་གཞུང་ལུགས་དག་ལས་བདག་ཏུ་སྨྲ་བ་ཐམས་ཅད་དུ་མ་སྐྱེས་པ་ཉིད་ཀྱི་གཏན་ཚིགས་དང་མོ་གཤམ་གྱི་བུའི་དཔེས་བདག་དེའི་རང་གི་ངོ་བོ་དང་ཁྱད་པར་བསལ་བར་རིག་པར་བྱའོ།",
    "ཕུང་པོ་ལས་ཐ་དད་པར་ཡོད་ན་བདག་དེ་ལ་ཕུང་པོའི་མཚན་ཉིད་མེད་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "གང་དག་བདག་དེའི་རྣམ་པ་དེ་ལྟ་བུར་རིག་པ་མིན་པ་དེ་དག་ཀྱང་བདག་དང་བདག་གི་ཞེས་བདག་ཏུ་ལྟ་བ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཁ་ཅིག་དག་ཁོ་ན་ལ་དེ་དག་གི་བསྟན་བཅོས་ལ་གོམས་པར་བྱས་པ་ལས་རྣམ་པ་དེ་ལྟ་བུའི་བདག་ཏུ་ལྟ་བ་འཇུག་པ་དམིགས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "བདག་ཉིད་བདག་གི་མགོན་ཡིན་གྱི།",
    "བདག་ཉིད་ལེགས་པར་ཐུལ་བར་གསུངས་པ་དེ་སེམས་ཉིད་ལ་བདག་གི་སྒྲར་གསུངས་པ་འདི་གང་ལས་ཤེས་ཤེ་ན།",
    "ལོག་གི་བདག་ཉིད་དུ་གོ་བར་བྱེད་པ་ནི་འདི་ལྟ་སྟེ།",
    "གལ་ཏེ་ཕུང་པོ་བདག་ན་ཞེས་བརྗོད་པ་ནི་རང་གི་ཁས་བླངས་གཏན་ཚིགས་སུ་འགོད་པས་མི་འདོད་པ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་རྩོམ་པའོ།",
    "དེ་མང་བས་ཞེས་བྱ་བ་ནི་ཕུང་པོའི་མཚན་ཉིད་བསྟན་པས་བདག་ཀྱང་དེ་ཁོ་ན་ལྟར་ཐལ་བ་སྒྲུབ་པའོ།",
    "གང་དག་གི་ལྟར་ན་སེམས་བདག་ཡིན་པ་དེའི་ལྟར་ན་ཡང་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པའི་དབྱེ་བས་སམ་སྐད་ཅིག་རེ་རེ་ལ་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དང་འགག་པས་མང་བའི་ཕྱིར་བདག་ཀྱང་མང་པོར་འགྱུར་རོ།",
    "གཞན་ཡང་བདག་ནི་རྫས་སུ་ཡོད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཡང་ན་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པ་ཙམ་ལ་དམིགས་པའི་མིག་གི་ཤེས་པ་ལྟར་འཇིག་ཚོགས་ལ་ལྟ་བ་དེ་ལ་དམིགས་པའི་འདུན་པའི་འདོད་ཆགས་སྤངས་པ་ཁོ་ནས་སྤོང་བའི་རྣམ་པར་གཞག་པ་འཐད་པར་འགྱུར་རོ།",
    "མི་རྟག་པ་ལ་རྟག་པར་འཛིན་ལ་སོགས་པའི་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་བཞིན་ནོ།",
    "དེའི་ཕྱིར་ཆད་པའི་མཐར་འཛིན་པས་མཐར་ལྟ་བར་ཐལ་བར་ཡང་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ཁྱེད་ཅག་གི་ནི་བདག་དང་བདག་གི་བའི་རྣམ་པ་ཅན་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "མཐར་འཛིན་པར་ལྟ་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཞན་ཡང་མྱ་ངན་ལས་འདས་པར་ཞུགས་པའི་སྔ་རོལ་གྱི་སྐད་ཅིག་དག་ཏུ་ཇི་ལྟར་ཕུང་པོ་རྣམས་སྐད་ཅིག་རེ་རེ་ལ་སྐྱེ་ཞིང་འཇིག་པ་དེ་བཞིན་དུ་བདག་ཀྱང་སྐྱེ་ཞིང་འཇིག་པ་ཅན་དུ་འགྱུར་ཏེ།",
    "གལ་ཏེ་ལས་གང་གིས་བྱས་པ་དེ་མི་རྟག་པ་ཉིད་དུ་འགྱུར་ན།",
    "གལ་ཏེ་ཡང་སྐད་ཅིག་སྔ་ཕྱི་དག་གཞན་ཡིན་མོད་ཀྱི་དེ་ལྟ་ན་ཡང་རྒྱུད་འདི་གཅིག་ཁོ་ན་ཡིན་པས་ཁོ་བོ་ཅག་ལ་ཉེས་པ་འདི་མེད་དོ་ཞེ་ན།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཕན་ཚུན་མཚན་ཉིད་ཐ་དད་པ་རྣམས་ལ་རྒྱུ་གཅིག་ཏུ་གཏོགས་པ་ཉིད་མི་རིགས་པ་ཁོ་ན་ཡིན་པས་ཐལ་བར་འགྱུར་བ་ལྡོག་པ་མེད་དོ།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་མཐའ་དང་ལྡན་པ་ཉིད་ལ་སོགས་པ་མེད་པར་འདོན་པ་དེའི་ཕྱིར་ཕུང་པོ་རྣམས་དང་སེམས་བདག་ཡིན་ནོ་ཞེས་བྱ་བར་མི་རིགས་སོ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "ཁྱོད་ཀྱི་སེམས་སམ་ཕུང་པོ་བདག་མི་འགྱུར།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ཡིས།",
    "ཅི་སྟེ་གང་གི་ཚེ་ལས་དང་འབྲས་བུའི་འབྲེལ་པ་ལ་བསམ་པའི་དུས་སུ་བདག་གི་སྒྲ་སྦྱོར་བ་དེའི་ཚེ་བདག་གཞན་མི་སྲིད་པའི་ཕྱིར་ཕུང་པོ་རྣམས་ཁོ་ན་ལ་འཇུག་ལ།",
    "གང་གི་ཚེ་བདག་མེད་པར་མཐོང་བ་དེའི་ཚེ་ནི་གཞན་གྱིས་ཀུན་བརྟགས་པ་ནང་གི་བྱེད་པའི་སྐྱེས་བུ་ཉིད་ལ་འཇུག་སྟེ།",
    "དེའི་ཕྱིར་བདག་མེད་པར་མཐོང་བའི་དུས་སུ་ཡང་ནང་གི་བྱེད་པའི་སྐྱེསྐྱེས་བུ་དང་བྲལ་བ་འདུ་བྱེད་ཙམ་མཐོང་བ་ལ་དངོས་པོ་རྣམས་མེད་པར་མཐོང་བར་ཐལ་བར་མི་འགྱུར་རོ་སྙམ་ན།",
    "གལ་ཏེ་ཡང་དངོས་པོ་རྣམས་མེད་པར་མཐོང་བར་ཐལ་བར་འགྱུར་བས་འཇིགས་ནས།",
    "བདག་གི་སྒྲས་བདག་རྟག་པ་ཉིད་ཡོངས་སུ་འཛིན་ཞིང་ཕུང་པོ་རྣམས་སམ་སེམས་བདག་ཏུ་མི་འདོད་ན།",
    "ཁྱོད་ཀྱི་སེམས་སམ་ཕུང་པོ་བདག་ཏུ་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "ནང་གི་བྱེད་པའི་སྐྱེས་བུ་དང་བྲལ་བ་ཕུང་པོ་རྣམས་ཁོ་ན་ཙམ་མཐོང་བ་ཡིན་པར་འདོད་དོ།",
    "འདིར་ནི་ནང་གི་བྱེད་པའི་སྐྱེས་བུ་བདག་ཡིན་ལ་གཞན་དུ་ནི་ཕུང་པོ་རྣམས་བདག་ཡིན་ནོ་ཞེས་འདོད་དགུར་སྤྱོད་པ་རིགས་པ་མེད་པར་འདི་ཀོ་ག་ལས་རྙེད་པ་ཡིན།",
    "ཅི་སྟེ་གང་གི་ཚེ་ལས་དང་འབྲས་བུའི་འབྲེལ་པ་ལ་བསམ་པའི་དུས་གཞན་དུ་བདག་གི་སྒྲ་ཕུང་པོ་རྣམས་ལ་འཇུག་པར་འདོད་ན་ནི་བདག་གི་སྒྲ་དེ་བདག་མེད་པར་མཐོང་བའི་དུས་འདིར་ཡང་འདོད་པར་བྱ་དགོས་སོ།",
    "གཞན་ཡང་ཁྱོད་ཀྱི་རྣལ་འབྱོར་པས་བདག་མེད་པར་མཐོང་བ་དེ་ཡིས་གཟུགས་ལ་སོགས་པའི་དེ་ཁོ་ན་ཉིད་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "དངོས་པོ་རྣམས་མེད་པར་མཐོང་བར་ཐལ་བར་འགྱུར་བས་འཇིགས་ནས་བདག་གི་སྒྲས་བདག་རྟག་པ་ཉིད་ཡོངས་སུ་འཛིན་ཞིང་ཕུང་པོ་རྣམས་བདག་ཏུ་མི་འདོད་པ་དེ་ལ་ནི་གཟུགས་ལ་སོགས་པའི་རང་བཞིན་ཡོངས་སུ་ཤེས་པ་མེད་དོ།",
    "གང་གིས་ན་ཕུང་པོ་ལ་བདག་ཏུ་ལྟ་བ་དེ་མེད་པར་ཡོངས་སུ་ཤེས་པ་ལས་རྣལ་འབྱོར་པ་དེ་ཡུལ་དག་ལ་ཆགས་པ་ལ་སོགས་པ་རྣམས་སྤོང་བར་འགྱུར་བ་འགའ་ཡང་ནང་གི་བྱེད་པའི་སྐྱེས་བུ་བདེ་བར་གྱུར་ཅིག་ཅེས་བདེ་བ་མྱོང་བར་འགྱུར་བའི་ཡུལ་བསྟེན་པར་མི་བྱེད་ལ།",
    "འདོད་ཆགས་ལ་སོགས་པ་སྤོང་བའི་རྒྱུ་དེའི་རང་གི་ངོ་བོ་ཡོངས་སུ་ཤེས་པ་མེད་པའི་ཕྱིར་ཕྱི་རོལ་པ་བཞིན་ནོ་སྙམ་དུ་བསམས་པའོ།",
    "ལུང་གིས་ཀྱང་ཕུང་པོ་རྣམས་ཁོ་ན་བདག་ཉིད་དུ་སྟོན་པར་བྱེད་དེ།",
    "གང་གི་ཕྱིར་ཉེ་བར་ལེན་པ་པོ་མ་དམིགས་ན་དེའི་ཉེ་བར་ལེན་པ་ཕུང་པོ་དེ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གཟུགས་ལ་སོགས་པ་དག་ལ་ཡང་འདོད་ཆགས་དང་འབྲལ་བར་འགྱུར་བ་འཐད་པ་ཉིད་དོ།",
    "ཁྱོད་ལ་དེ་དག་ཉིད་བདག་ཅེས་འགྱུར་གྱི།",
    "ཁམས་དྲུག་དང་ནི་མིག་སོགས་རེག་པ་ཡི།",
    "གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་འདི་དག་བདག་ཅེས་བྱ་བར་བཞེད་པ་མ་ཡིན་ན་བཅོམ་ལྡན་འདས་ཀྱིས་ཕུང་པོ་ལས་ཐ་དད་པའི་བདག་འགོག་པར་མཛད་པ་དེ་ཅི་ཞིག་ཡིན།",
    "རིགས་མཐུན་པ་དང་རིགས་མི་མཐུན་པ་གཞན་ལས་ལོག་པ་དེ་དག་ནི་རང་གི་ངོ་བོ་ལ་གནས་པ་ཅན་ཁོ་ན་ཡིན་ཏེ།",
    "ཡིན་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེའི་ཕྱིར་དོན་གཞན་དུ་འདྲེ་བར་མི་བྱེད་པ་དེ་དག་ནི་རང་གི་བདག་ཉིད་ལ་རྣམ་པར་གནས་པ་ཅན་ཁོ་ན་ཡིན་ནོ་ཞེ་ན།",
    "ཕུང་པོའི་ངོ་བོ་གཟུགས་ལ་སོགས་པ་རེ་རེ་ནས་མིན་ནོ།",
    "དཔེར་ན་ཤིང་རྣམས་ནི་ནགས་ཚལ་ལོ་ཞེས་བརྗོད་པ་ན་ཤིང་གི་ཚོགས་པ་ནགས་ཚལ་ཡིན་གྱི།",
    "ཤིང་རེ་རེ་དག་ལ་ཡང་ནགས་སུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཤིང་གི་ངོ་བོ་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "བདག་ཉིད་བདག་གི་མགོན་ཡིན་ཏེ།",
    "བདག་ཉིད་བདག་གི་དགྲ་ཡང་ཡིན།",
    "གཞན་ཡང་ཚོགས་པ་ཅན་ལས་ཐ་དད་དུ་མེད་པར་ཁས་བླངས་པ་དེ་ཡི་ཚེ།",
    "ཤིང་རྟ་དེ་ཡི་ཡན་ལག་འཕང་ལོ་ལ་སོགས་པ་ཚོགས་པའི་གནས་རྣམས་ཤིང་རྟ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "ཁྱོད་ནི་ལྟ་བར་གྱུར་པ་ཡིན།",
    "གང་གི་ཚེ་འཕང་ལོ་ལ་སོགས་པ་རྣམས་དབྱིབས་ཁྱད་པར་ཅན་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་ཤིང་རྟའི་མིང་རྙེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དབྱིབས་ཁྱད་པར་ཅན་དང་ལྡན་པར་གྱུར་པ་དེ་བདག་ཡིན་དུ་འགྱུར་ན་ཁྱོད་ལ་གཟུགས་ཅན་དེ་དག་ཉིད་བདག་ཅེས་བྱ་བར་འགྱུར་གྱི།",
    "ཇི་ལྟར་མེ་དང་བུད་ཤིང་དག་གཅིག་ཉིད་དུ་མི་འདོད་པ་དེ་བཞིན་དུ་བདག་དང་ཉེ་བར་ལེན་པ་དག་ལ་ཡང་མི་འདོད་པར་བྱ་དགོས་སོ།",
    "རེག་པའི་སྐྱེ་མཆེད་དྲུག་པ།",
    "སྐྱེས་བུ་འདི་ནི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་པའོ་ཞེས་གང་སྨྲས་པ་དེ་ཅི་ལས་བརྟེན་ཏེ་སྨྲས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་རེག་པའི་སྐྱེ་མཆེད་དྲུག་ནི་འདི་དག་སྟེ།",
    "གཟུགས་རྣམས་ལ་ལྟ་བའི་ཕྱིར་མིག་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "སྒྲ་རྣམས་ལ་ཉན་པའི་ཕྱིར་རྣ་བ་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "དྲི་རྣམས་ལ་མནོམ་པའི་ཕྱིར་སྣ་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "རེག་བྱ་རྣམས་ལ་རེག་པའི་ཕྱིར་ལུས་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "རྒྱལ་པོ་ཆེན་པོ་དེ་དག་ནི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་སྟེ།",
    "སྐྱེས་བུ་འདི་ནི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་པའོ་ཞེས་གང་ངས་སྨྲས་པ་དེ་ནི་དེ་ལ་བརྟེན་ཏེ་སྨྲས་སོ།",
    "འདི་ལ་མིས་མིག་གིས་གཟུགས་མཐོང་ན་ཡིད་བདེ་བ་དང་།",
    "ལུས་ཀྱིས་རེག་བྱ་ལ་རེག་ན་ཡིད་བདེ་བ་དང་།",
    "བཏང་སྙོམས་སུ་འགྱུར་བར་རེག་བྱ་ལ་ཉེ་བར་སྤྱོད་དོ།",
    "གང་གི་ཕྱིར་ཁམས་ལ་སོགས་པ་དེ་རྣམས་ཀྱི་སྒོ་ནས་བདག་ཏུ་གདགས་སོ་ཞེས་བྱས་བར་གསུངས་པ་དེའི་ཕྱིར་བདག་དེ་ནི་ཕུང་པོ་དེ་རྣམས་དང་གཞན་མ་ཡིན་པ་ཉིད་མ་ཡིན་ཏེ།",
    "གང་གི་ཚེ་དེ་ལྟར་ཕུང་པོ་རྣམས་ངར་འཛིན་པའི་ཡུལ་ཡང་མ་ཡིན་ལ།",
    "ངར་འཛིན་པའི་ཡུལ་ནི་གཞན་ཡིན་ཞིང་གཞན་དངོས་པོ་མེད་པར་མཐོང་བ་ལས་ངར་འཛིན་པ་ལྡོག་གོ་ཞེས་བྱ་བ་ནི་ཀྱེ་མ་མ་ལ་ཁྱོད་ཀྱི་མཛེས་སོ།",
    "གང་ཞིག་འཇིགས་པའི་རྐྱེན་རང་གི་ཁྱིམ་གྱི་རྩིག་ཕུག་ན་སྦྲུལ་གནས་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "གང་གི་ཕྱིར་གླང་པོ་ཆེ་མེད་པས་ནི་སྐྱེས་བུ་དེའི་སྦྲུལ་གྱི་འཇིགས་པ་སེལ་བར་མི་ནུས་སོ།",
    "བདག་གི་ཡོད་པ་ཉིད་ནི་རྟེན་དང་བརྟེན་པ་ཉིད་དུ་ཡང་མེད་དོ།",
    "དེའི་ཕྱིར་ཕུང་པོ་དང་བདག་རྟེན་དང་བརྟེན་པའི་དངོས་པོར་ཤེས་པ་ནི་རང་གི་རྣམ་པར་རྟོག་པ་ཙམ་སྟེ།",
    "འདིས་རང་གི་ངོ་བོས་གཞན་གྱི་ངོ་བོ་སྒྲིབ་པའི་ཕྱིར་རོ།",
    "རྩེ་མོ་མཐོ་བར་གྱུར་པ་འདི་དག་གོ།",
    "ཕུང་པོ་རེ་རེ་ལ་རྣམ་པ་བཞིའི་སྒོ་ནས་བདག་ཉིད་དུ་བཟུང་བ་ནི་རྣམ་པ་ལོག་པ་ལ་འཇུག་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་འཇིག་ཚོགས་ལ་ལྟ་བ་དམིགས་པ་དང་རྣམ་པ་ལོག་པ་ལ་འཇུག་པ་རྣམ་པར་དཔྱད་པ་འདི་བདག་དང་ཕུང་པོ་ཐ་དད་པའི་ཕྱོགས་དང་བཅས་ཏེ་ཆ་ལྔ་པར་འགྱུར་བས་ཕུང་པོ་རེར་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "འདི་ཅི་ལྟར་ཕུང་པོ་རེར་ཐ་དད་པའི་ཕྱོགས་དོར་ནས་རྣམ་པ་བཞིར་བྱས་པས་ཆ་ཉི་ཤུར་བརྗོད་ཅེ་ན།",
    "ཉིན་རེ་བཞིན་ཉོན་མོངས་པའི་བྲག་རྡོ་འཕེལ་བ།",
    "རྩེ་མོ་ཆེས་མཐོ་བ་གང་དག་དང་ལྷན་ཅིག་འཇིག་པར་འགྱུར་བ་གཟུགས་བདག་ཡིན་ནོ།",
    "བདག་ལ་གཟུགས་ཡོད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པར་ཡོངས་སུ་རྟོག་པ་དེ་དག་ནི་རྩེ་མོ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "དེ་ལ་མང་པོས་བཀུར་བ་ཁ་ཅིག་དག་གིས་བརྟགས་པའི་གང་ན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "རེ་ཞིག་ཕུང་པོ་མ་གཏོགས་པ་དེ་འཛིན་མ་གྲུབ་པའི་ཕྱིར་ན་གང་ཟག་ཕུང་པོ་དག་ལས་གཞན་དུ་ནི་མི་འགྱུར་རོ།",
    "སྐྱེ་བ་དང་འཇིག་པ་དག་དང་ལྡན་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྣམ་པ་ཤེས་པ་དྲུག་གི་ཤེས་པར་བྱ་བ་ཡང་ཡིན་ནོ།",
    "འདོད་པ་རྟགས་སུ་བཀོད་ནས་མི་འདོད་པའི་ཐལ་བ་སྒྲུབ་པ་དང་།",
    "རྫས་སུ་ཡོད་པར་འདོད་པ་རྟགས་སུ་བཀོད་ནས་བརྗོད་དུ་མེད་པར་མི་འགྱུར་བའི་ཐལ་བ་སྒྲུབ་པ།",
    "བརྗོད་དུ་མེད་པར་འདོད་པ་རྟགས་སུ་བཀོད་ནས་བཏགས་ཡོད་དུ་འགྱུར་བའི་ཐལ་བ་སྒྲུབ་པ།",
    "ཉིད་དུ་འདོད་པ་རྟགས་སུ་བཀོད་ནས་བདག་ཡོད་པར་མི་འགྱུར་བའི་ཐལ་བ་སྒྲུབ་པའོ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་ཕྱིར་ཁྱོད་བུམ་དངོས་པོར་མ་གྲུབ་པའི།",
    "རང་གིས་ཡོད་པར་གྲུབ་པར་རྟོགས་མི་བྱ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "ཁྱོད་བུམ་པ་གཟུགས་ལ་སོགས་པ་དག་ལས་དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་དུ་མེད་ཅིང་བཏགས་པར་ཡོད་པར་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ལྟར་བདག་རྫས་སུ་ཡོད་པར་གྱུར་ན་ནི་དེ་གདོན་མི་ཟ་བར་རྣམ་པར་ཤེས་པ་ལྟར་རང་གི་བདག་ཉིད་ལས་གཞན་མ་ཡིན་པར་འགྱུར་ཞིང་གཟུགས་ལ་སོགས་པ་དག་ལས་ཐ་དད་པའི་ངོབོ་ཞིག་ཏུ་འགྱུར་ན།",
    "བདག་བཏགས་པའམ་མ་དམིགས་པར་འདོད་པས་ཀྱང་རུང་ཇི་སྐད་སྨྲས་པའི་རྣམ་པ་དག་གིས་བདག་ཁས་བླང་བར་མི་བྱ་སྟེ།",
    "ཁྱོད་དབྱིབས་ཡན་ལག་རེ་རེ་སྔར་ཡོད་གྱུར།",
    "གང་ཕྱིར་ཁྱོད་ཀྱི་ཚོགས་པ་ཅང་མེད་པས།",
    "ཁྱོད་ཀྱི་འདི་ནི་ཇི་ལྟར་འདོད་དེ་ལྟར།",
    "རྣམ་པ་བདུན་གྱིས་འགྲུབ་འགྱུར་མིན་མོད་ཀྱི།",
    "རང་གི་ཡན་ལག་བརྟེན་ནས་འདོགས་པ་ཡིན།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གལ་ཏེ་ཚོགས་པ་ཙམ་ཤིང་རྟར་འགྱུར་ན་ནི་སིལ་བུར་གནས་པ་ལ་ཤིང་རྟ་ཉིད་ཡོད་པར་ཐལ་བར་འགྱུར་བ་གང་གི་ཕྱིར་ཞེ་ན།",
    "དེའི་ཕྱིར་གང་དག་གི་ཚོགས་པ་ཞིག་ཤིང་ལྟར་འགྱུར།",
    "འང་གི་སྒྲ་ནི་བསྡུ་བའི་དོན་ཏེ།",
    "གཞན་ཡང་གལ་ཏེ་དབྱིབས་ཙམ་ཞིག་ཤིང་རྟར་འདོད་ན་དབྱིབས་དེ་ཡན་ལག་དག་གིའམ།",
    "པར་འདོད་ན་ཡང་སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་མ་བཏང་བ་དག་གིའམ།",
    "སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་བཏང་བ་དག་གི་ཡིན་པར་འགྱུར་གྲང་ན།",
    "དེ་ལ་གལ་ཏེ་སྔར་གྱི་དབྱིབས་ཀྱི་ཁྱད་པར་མ་བཏང་བ་དག་གི་ཡིན་པར་འདོད་ན་ནི་དེ་མི་རིགས་སོ།",
    "ཤིང་རྟ་དེའི་ཡན་ལག་འཕང་ལོ་ལ་སོགས་པ་དག་གི་དབྱིབ་སོ་སོར་གནས་པའི་སྐབས་དང་ཐ་མི་དད་པའི་ཕྱིར་ཏེ།",
    "གལ་ཏེ་འཕང་ལོ་དང་སྲོག་ཤིང་དང་གཟེར་བུ་ལ་སོགས་པ་ཤིང་རྟའི་ཡན་ལག་རྣམས་ཀྱི་དབྱིབས་ཀྱི་ཁྱད་པར་སོ་སོར་ལྷམ་པ་དང་རིང་བ་དང་ཟླུམ་པོ་ལ་སོགས་པ་གང་ཞིག་སྔར་ཡོད་པར་གྱུར་པ་དེ་ལས་དེ་དག་གི་དབྱིབས་ཀྱི་ཁྱད་པར་གཞན་ཞིག་ཁོ་ན་ཤིང་རྟ་ཉིད་ཀྱི་དུས་སུ་སྐྱེ་བར་འགྱུར་ན་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "ཇི་ལྟར་རྩིབས་དང་མུ་ཁྱུད་དང་ལྟེ་བ་ལ་སོགས་པའི་ཁྱད་པར་དུ་གྱུར་པའི་དབྱིབས་ཅན་འཕང་ལོ་ལ་ནི་ཤིང་རྟའི་གནས་སྐབས་ན་རང་གི་དབྱིབས་གཞན་དུ་གྱུར་པ་ཉིད་མ་མཐོང་ངོ།",
    "དེ་བཞིན་དུ་སྲོག་ཤིང་ལ་སོགས་པ་དེ་དག་གི་ལྷམ་པ་ཉིད་ལ་སོགས་པ་ཡང་གཞན་ཉིད་དུ་འགྱུར་བ་མ་ཡིན་ནོ།",
    "བཏགས་པ་ནི་རྫས་ཀྱི་རྟེན་ཅན་ཁོ་ནར་ཁྱོད་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་མི་བདེན་དུ་ཟིན་ཀྱང་ཚོགས་པ་ལ་བརྟེན་ནས་མི་བདེན་པའི་དབྱིབས་སུ་འགྱུར་རོ་ཞེས་བྱ་བར་འདོད་ན།",
    "དེ་ལྟ་ན་ཡང་འདི་ནི་རྣམ་པར་དཔྱད་པ་སྤངས་ཏེ་སྔོན་པོ་ལ་སོགས་པ་དང་ཚོར་བ་ལ་སོགས་པ་ལྟར་འཇིག་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "འདིའི་མིང་གི་ཁྱད་པར་གང་དག་ཡིན་པ་དེ་དག་ཀྱང་རྣམ་པར་དཔྱད་པ་མེད་པར་འཇིག་རྟེན་ལ་གྲགས་པའི་སྒོ་ནས་ཁས་བླང་བར་བྱ་སྟེ།",
    "དེ་ལ་ཤིང་རྟ་ནི་འཕང་ལོ་ལ་སོགས་པ་རང་གི་ཡན་ལོ་ལ་ལག་ལ་ལྟོས་ནས་ཡན་ལག་ཅན་ཉིད་དུ་འགྱུར་རོ།",
    "རང་གི་ཉེ་བར་ལེན་པ་ལ་ལྟོས་ནས་ནི་ཉེ་བར་ལེན་པ་པོ་ཉིད་དོ།",
    "སྨྲ་བ་དེའི་ལྟར་ན་གཏན་ཚིགས་དེ་ཉིད་ཀྱིས་ཡན་ལག་ལ་སོགས་པ་ཙམ་ཡང་མེད་པར་ཐལ་བར་འགྱུར་བས།",
    "དེའི་ཕྱིར་འཇིག་རྟེན་ལ་གྲགས་པའི་ཀུན་རྫོབ་བརླག་པར་འགྱུར་བའི་ཉེས་པ་འདི་ནི་ཁྱོད་ལའང་ཐལ་བར་འགྱུར་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "ཉེས་པ་འདི་ནི་ཁྱོད་ཁོ་ན་ལ་འགྱུར་ཏེ།",
    "ཁྱོད་ཀྱིས་ཀྱང་རྣམ་པར་དཔྱད་ནས་དངོས་པོ་གྲུབ་པར་རྣམ་པར་འཇོག་པར་བྱེད་ལ།",
    "གྲུབ་པའི་ཐབས་གཞན་ཡང་ཁས་མ་བླངས་པ་དེའི་ཕྱིར་ན་ཤིང་རྟ་འོན་ཅིག་ཅེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པའི་འཇིག་རྟེན་པའི་ཐ་སྙད་ཁྱོད་ལ་ཅི་ལྟར་འགྲུབ་པར་འགྱུར།",
    "གི་ཕྱོགས་ལ་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཆད་པར་ཐལ་བར་མི་འགྱུར་ལ།",
    "བདག་དང་བདག་གི་མ་དམིགས་པས་རྣམ་པར་གྲོལ་བའི་དོན་ལ་ཉེ་བར་སྦྱོར་བ།",
    "ཉེ་བར་རྟོག་པའི་རྣལ་འབྱོར་པ་ལ་གལ་ཏེ་ཤིང་རྟ་ཞེས་བྱ་བའི་དངོས་པོ་རང་བཞིན་གྱིས་གྲུབ་པ་འགའ་ཞིག་ཡོད་པར་འགྱུར་ན་ནི་ཐེ་ཚོམ་མེད་པར་དེ་རྣམ་པ་བདུན་ལས་རྣམ་པ་གང་ཡང་རུང་བ་ཞིག་གི་བདག་ཉིད་ཡོད་པ་རྙེད་པར་འགྱུར་བ་ཞིག་ན།",
    "དེའི་ཕྱིར་ཤིང་རྟ་ཞེས་བྱ་བ་ནི་མ་རིག་པའི་ལིང་ཐོག་གིས་ཉམས་པར་བྱས་པ་དག་ཁོ་ནས་བརྟགས་པ་ཡིན་གྱི།",
    "འང་གི་སྒྲས་ནི་ཀུན་རྫོབ་ཉམས་པར་ཡང་མི་འགྱུར་བ་སྟེ།",
    "མཁས་པ་དག་གིས་ཕྱོགས་འདི་ནི་སྐྱོན་མེད་ཅིང་ཕན་ཡོན་དང་བཅས་པའོ་སྙམ་དུ་བསམས་ཏེ་གདོན་མི་ཟ་བར་ཁས་བླང་བར་བྱའོ།",
    "རྣལ་འབྱོར་པས་ཤིང་རྟ་མི་དམིགས་ལ་རག་མོད།",
    "གང་ཞིག་རྣམ་བུ་ཚིག་ན་ཐལ་བ་ལ་སྣལ་མ་ཚོལ་བ་ཁྱོད་ནི་བཞད་གད་དུ་བྱ་བ་ཞིག་སྟེ།",
    "གང་གི་ཕྱིར་ཡན་ལག་ཅན་མ་དམིགས་པ་དེའི་ཚེ་གང་གི་ཡན་ལག་ཏུ་འགྱུར་ཏེ།",
    "འདི་ལྟར་ཤིང་རྟ་ཞིག་ནའང་དེའི་འཕང་ལོ་ལ་སོགས་པ་ཚོགས་པ་རྟོག་པ་པོ་གང་གིས་སྔར་འཕང་ལོ་ལ་སོགས་པ་དང་ཤིང་རྟ་འབྲེལ་པ་མཐོང་བ་དེ་ཁོ་ནས་འཕང་ལོ་ལ་སོགས་པ་འདི་དག་ནི་ཤིང་རྟ་ཡིན་ནོ་སྙམ་དུ་རྟོགས་པ་ཡིན་གྱི།",
    "ཇི་ལྟར་འཕང་ལོ་ལ་སོགས་པ་དག་ཤིང་རྟའི་ཉེ་བར་ལེན་པ་ཡིན་པ་དེ་བཞིན་དུ་ཕུང་པོ་ལ་སོགས་པ་རྣམས་ཀྱང་བདག་གི་ཉེ་བར་ལེན་པ་ཞེས་བྱའོ།",
    "བུད་མེད་དང་།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་གི་ཕྱིར་འདི་ཡོད་པ་མ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་གཏི་མུག་ལས་ཐ་སྙད་འདོགས་པ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "བར་རྟོག་པའི་རྣལ་འབྱོར་པ་དག་གིས་རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་ལ།",
    "བདག་དང་བདག་གི་མ་དམིགས་པས་རྣམ་པར་གྲོལ་བའི་དོན་ལ་ཉེ་བར་སྦྱོར་བ་ནི།",
    "དེ་ཕྱིར་བདག་གི་བདག་མེད་པར་ཡོད་མིན།",
    "དེ་ཕྱིར་བདག་དང་བདག་གི་སྟོང་ལྟ་ཞིང་།",
    "ཇི་ལྟར་རྫ་མཁན་མེད་པར་བུམ་པ་ཡང་མི་སྲིད་པ་དེ་བཞིན་དུ་བདག་མེད་པར་བདག་གི་བ་ཡང་མ་ཡིན་ནོ།",
    "ཡན་ལག་ཡོན་ཏན་འདོད་ཆགས་མཚན་ཉིད་དང་ནི་བུད་ཤིང་ལ་སོགས་དང་།",
    "ཇི་ལྟར་བདག་དང་དེའི་ཉེ་བར་ལེན་པ་དག་གི་གདགས་པ་ཤིང་རྟའི་རྣམ་པར་དཔྱད་པ་དང་མཚུངས་པ་དེ་བཞིན་དུ་དངོས་པོ་གཞན་རྣམས་ཀྱིའང་ཡིན་ནོ།",
    "འདི་ལྟར་ཤིང་རྟ་རྣམ་པར་དཔྱད་པའི་ཚུལ་འདིས་རྣམ་པ་བདུན་དུ་བཙལ་བ་ན་དོན་དམ་པ་དང་ཀུན་རྫོབ་ཏུ་ཤིང་རྟ་འགྲུབ་པར་མི་འགྱུར་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "མིང་གི་ཁྱད་པར་གཞན་ཡང་ཇི་ལྟར་བུམ་པ་ཡན་ལག་ཅན་ཡིན་ལ་གྱོ་མོ་ལ་སོགས་པ་དེ་དག་བུམ་པ་དེའི་ཡན་ལག་ཡིན་ཞིང་།",
    "བུད་ཤིང་ནི་བསྲེག་པར་བྱ་བའོ།",
    "གལ་ཏེཁྱོད་ཀྱི་རྒྱུ་ཡིས་ཕྲད་ནས་འབྲས་སྐྱེད་བྱེད་ན་དེ་ཡི་ཚེ།",
    "ཅི་སྟེ་ཁྱོད་ཀྱི་རྒྱུ་ཡིས་འབྲས་བུ་སྐྱེད་པར་མི་བྱེད་དེ་ཕྱིར་འབྲས།",
    "ཅི་སྟེ་ཁྱོད་དེ་གཉིས་རང་གི་ངོ་བོས་གྲུབ་པར་སེམས་ན།",
    "རྒྱུ་དང་འབྲས་བུ་དག་རང་གི་ངོ་བོས་ཡོད་པར་འགྱུར་བ་ཞིག་ཡིན་ན་སྐྱོན་གཞན་ཡང་གལ་ཏེ་རྒྱུས་འབྲས་བུ་རང་བཞིན་གྱིས་སྐྱེད་པར་བྱེད་ན་ཕྲད་ནས་སམ་མ་ཕྲད་པར་སྐྱེད་པར་བྱེད་གྲང་།",
    "མཚོའི་ཆུ་ཕྲད་པ་ཐ་དད་མེད་པ་ལྟར་གཅིག་ཡིན་པས་འདི་ནི་རྒྱུའོ་འདི་ནི་འབྲས་བུའོ་ཞེས་ཁྱད་པར་མེད་པའི་ཕྱིར་གང་ཞིག་གང་གིས་སྐྱེད་པར་འགྱུར།",
    "གང་གི་ལྟར་ན་རང་གི་མཚན་ཉིད་བསྐྱེད་པར་བྱ་བ་ཉིད་དང་སྐྱེད་པར་བྱེད་པ་ཉིད་ཡིན་པ་དེ་ལ་རྒྱུ་དང་འབྲས་བུ་ཕྲད་པ་དང་མ་ཕྲད་པའི་རྣམ་པར་དཔྱད་པ་འདིར་འགྱུར་གྱི།",
    "གང་གི་ལྟར་ན་དངོས་པོ་རྣམས་ལོག་པར་ཀུན་བརྟགས་པས་བསྐྱེད་པ་ཉིད་ཀྱིས་སྒྱུ་མ་ལྟར་མ་སྐྱེས་པའི་རང་བཞིན་ཡིན་ཞིང་རང་བཞིན་མེད་ཀྱང་རབ་རིབ་ཅན་གྱི་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "ཡིན་ཞེས་ཉེས་པ་འདིར་ནི་ཁྱོད་ལའང་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དེ་ཚེ་ཁྱོད་ཀྱིས་སུན་དབྱུང་སུན་ནི་འབྱིན་པར་ནུས་མ་ཡིན།",
    "གང་ཕྱིར་རང་གི་ཚིག་ལའང་ཐལ་བ་མཚུངས་པའི་ལྟག་ཆོད་ཀྱིས།",
    "ཁྱོད་ནི་སྐྱེ་བོ་དམ་པས་བཞེད་མི་འགྱུར་ཞིང་གང་གི་ཕྱིར།",
    "ཁྱོད་ལ་རང་ཕྱོགས་མེད་པས་སུན་ཅི་ཕྱིན་དུ་རྒོལ་བའང་ཡིན།",
    "ཅི་རྒྱུས་འབྲས་བུ་ཕྲད་ནས་སྐྱེད་པར་བྱེད་དམ་འོན་ཏེ་མ་ཕྲད་པར་ཡིན་ཞེས་གང་སྨྲས་པས་འདིར་ཁྱོད་ལ་ཡབརྒལ་ཞིང་བརྟག་པ་མཚུངས་སོ།",
    "གང་གི་ཚེ་དེ་ལྟར་ཁྱོད་ཀྱི་སུན་འབྱིན་པ་ལ་སུན་དབྱུང་བྱ་སུན་འབྱིན་པའི་ནུས་པ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་ཁྱོད་ཀྱི་སུན་འབྱིན་པ་ཉིད་སུན་ཕྱུང་བ་ཡིན་པས་ཤུགས་ཀྱིས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡང་གྲུབ་པ་ཉིད་དོ།",
    "དེ་བཞིན་དུ་མིག་གིས་མ་ཕྲད་པ་ཁོ་ནར་རུང་བའི་ཡུལ་ན་གནས་པའི་གཟུགས་མཐོང་གི་རིལ་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་རིགས་པ་མེད་པར་དངོས་པོ་འོ་ཅོག་ལ་སྐུར་པ་འདེབས་པ་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "དེའི་ཕྱིར་ཁྱོད་སྐྱེ་བོ་དམ་པས་བཞེད་པར་མི་འགྱུར་རོ།",
    "གཞན་ཡང་ཁྱོད་ནི་སུན་ཅི་ཕྱིན་དུ་རྒོལ་བ་པ་ཉིད་དུ་ཡང་འགྱུར་ཏེ།",
    "རང་གི་ཕྱོགས་བཞག་པ་དང་བྲལ་ཞིང་གཞན་གྱི་ཕྱོགས་སེལ་བ་ཙམ་ལ་ཞུགས་པའི་རྒོལ་བ་ནི་སུན་ཅི་ཕྱིན་དུ་རྒོལ་བ་པ་ཞེས་བྱ་བའོ།",
    "ཁྱོད་ལ་ནི་རང་གི་ཕྱོགས་འགའ་ཞིག་ཡོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཁྱོད་ཀྱི་རྣམ་པར་དཔྱད་པ་ནི་གཞན་གྱི་ཕྱོགས་སེལ་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་སྨྲས་སོ།",
    "ཡོད་པ་མིན་པས་ཐལ་བར་འགྱུར་བ་འདི་ནི་སྲིད་མ་ཡིན།",
    "ཇི་ལྟར་ཁྱོད་ཀྱིས་ཉི་མའི་དཀྱིལ་འཁོར་ལ་ཡོད་ཁྱད་པར་རྣམས།",
    "མི་རིགས་མོད་ཀྱི་བརྟེན་ནས་ཐ་སྙད་ཙམ་ཞིག་འབྱུང་འགྱུར་ཞིང་།",
    "མི་བདེན་བཞིན་དུའང་རང་གི་བྱད་བཞིན་མཛེས་པར་བསྒྲུབ་བྱའི་ཕྱིར།",
    "གལ་ཏེ་རང་གི་བསྒྲུབ་བྱ་གོ་བྱེད་གཏན་ཚིགས་དངོས་གྲུབ་དང་།",
    "དེ་ལ་རང་གི་ཚིག་ལའང་ཐལ་བ་མཚུངས་པའི་ལྟག་ཆོད་ཀྱིས་ཞེས་གང་སྨྲས་པ་ནི་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་མཚུངས་པར་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་ནི་སུན་འབྱིན་པས་སུན་དབྱུང་བར་བྱ་བ་ཕྲད་ནས་ཀྱང་སུན་འབྱིན་པར་མི་བྱེད་པ་ཉིད་ལ།",
    "རྟོགས་པ་ཡང་ཡོད་མོད་ཀྱི་གཉིས་ཀྱི་ཚུལ་གྱིས་ནི་མ་ཡིན་ནོ།",
    "སུན་དབྱུང་བར་བྱ་བ་དང་སུན་འབྱིན་པ་དག་ཀྱང་ཕྲད་པའམ་མ་ཕྲད་པར་མ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་ཐ་སྙད་དུ་སུན་འབྱིན་པས་སུན་དབྱུང་བ་སུན་འབྱིན་པར་བྱེད་དོ།",
    "གཞན་ཡང་ཇི་ལྟར་གཟུགས་བརྙན་ཞེས་བྱ་བ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ན་ཉི་མའི་དཀྱིལ་འཁོར་དང་ཕྲད་པའམ་མ་ཕྲད་པར་སྐྱེ་ཞེས་བྱ་བའི་རྟོག་པ་རྣམ་པ་ཐམས་ཅད་དུ་མི་སྲིད་མོད་ཀྱི།",
    "གཉིས་སུ་ཐལ་བར་ཡང་མི་འགྱུར་བས་རང་གི་ཚིག་ལའང་ཐལ་བར་མཚུངས་པར་མི་རིགས་སོ་ཞེས་ཤེས་པར་བྱ་སྟེ།",
    "ཕྲད་པ་དང་མ་ཕྲད་པའི་བརྒལ་བ་ཡང་གསལ་བར་བྱེད་པའི་རྒྱུ་ལ་ཡིན་གྱི་སྐྱེད་པར་བྱེད་པ་ལ་ནི་མ་ཡིན་པས་ཁོ་བོ་ཅག་གི་ཚིག་རྣམས་ལ་ལྟག་ཆོད་ཀྱི་སྐབས་མེད་པ་ཉིད་དོ་ཞེས་གང་སྨྲ་བར་བྱེད་པ་དེའི་འདི་ནི་ལན་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་གླགས་དང་བཅས་པའི་དངོས་པོ་བརྗོད་ན་ཕ་རོལ་པོ་མི་བཟོད་པ་ཉིད་ཡིན་ལ།",
    "སྒྲུབ་བྱེད་ཀྱི་སུན་འབྱིན་པ་རྣམས་ལ་ལྟག་ཆོད་འགོག་པར་བྱེད་པའི་ལན་སྨྲ་བར་བྱེད་པ་དེའི་ཕྱིར་འདི་ནི་གཞན་གྱིས་སུན་དབྱུང་བར་བྱ་བ་ཁོ་ན་ཡིན་པས་ཁོ་བོ་ཅག་གིས་བཏབ་པའི་ལན་ཁོ་ན་ཆེས་མཛེས་སོ།",
    "གཞན་ཡང་དངོས་པོར་སྨྲ་བ་ཁྱོད་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "རང་བཞིན་མེད་པའི་རྒྱུ་དང་འབྲས་བུ་རྣམ་པར་དཔྱོད་པ་ན་ཁྱོད་ཀྱིས་གཉིས་ཡོངས་སུ་བཟུང་ནས་སུན་འབྱིན་པ་བཀོད་པས་ཀྱང་མི་གནོད་དོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གང་དག་མིག་དང་ཁབ་ལེན་ལ་སོགས་པ་མ་ཕྲད་པར་རང་གི་བྱ་བ་བྱེད་པར་རྣམ་པར་གཞག་པ་དཔེ་དེ་དག་ཀྱང་བཀག་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་དག་ལ་ཡང་ཐལ་བར་འགྱུར་བ་མཚུངས་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་ཁྱོད་རང་བཞིན་མེད་པ་ཉིད་ཀྱི་ལམ་དྲང་པོ་བཏང་ནས་རྟོག་གེ་ངན་པའི་ལམ་ཤིན་ཏུ་འཁྱོག་པ།",
    "རང་གི་རྣམ་པར་རྟོག་པའི་བཟོ་བོ་ངན་པས་སྦྱར་བ།",
    "ཏེ་པོར་ཚེགས་ཆེ་བ་འདིས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "གཞན་ཡང་ཇི་ལྟར་རྨི་ལམ་དང་སྒྱུ་མ་ལ་སོགས་པ་རང་གི་ཕྱོགས་ལ་གྲུབ་པའི་དཔེ་རྣམས་ཁོ་ནས་འཇིག་རྟེན་གྱི་དངོས་པོ་རང་བཞིན་མེད་པ་ཉིད་དུ་རྟོགས་སུ་གཞུག་པར་ནུས་པ་དེ་ལྟར་འགའ་ཞིག་དངོས་པོ་རྣམས་རང་བཞིན་དང་བཅས་པར་འཛིན་དུ་གཞུག་པར་ནུས་པར་སླ་བ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་འཇིག་རྟེན་ལ་དོན་མ་ཡིན་པ་བྱ་བའི་ཕྱིར་སུ་ཞིག་གིས་རྦད་ཅིང་ཁྱོད་འཇིག་རྟེན་ཉོན་མོངས་དར་གྱི་སྲིན་བུ་ལྟར་རང་གི་རྟོག་པའི་སྦུབས་ཀྱིས་བཏུམས་པའི་སྟེང་དུ་རྟོག་གེ་ངན་པའི་སྲད་བུས་བྲེས་པའི་རྒྱ་ཤིན་ཏུ་སྲ་བ་ཀུན་ནའཛུགས་པར་ཅི་སྟེ་བྱེད།",
    "ཅི་རྒྱུས་འབྲས་བུ་ཕྲད་ནས་སྐྱེད་པར་བྱེད་དམ་འོན་ཏེ་མ་ཕྲད་པར་ཞེས་བྱ་བའི་སུན་འབྱིན་པའི་ལན་གྱི་དོན་དུ་གང་གིས་སྨྲས་པ་དེ་ལ་སུན་འབྱིན་གཏང་བར་བྱའོ།",
    "དེ་ཡང་ཁོ་བོ་ཅག་གིས་བསྟན་ཟིན་པའི་ཕྱིར་བསྟན་བཅོས་ལས་སུན་ཅི་ཕྱིན་དུ་རྒོལ་བ་ཉིད་ག་ལ་ཡོད།",
    "འདིར་བདག་གིས་གཞན་གྱི་ཕྱོགས་བསལ་བར་བྱས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གང་གིས་ན་སུན་ཅི་ཕྱིན་དུ་རྒོལ་བའི་མཚན་ཉིད་བྱས་པ་འདི་ཡང་དག་པའི་མཚན་ཉིད་དུ་འགྱུར་བ་ནི་སུས་རང་གི་ཕྱོགས་བཞག་པ་དང་བྲལ་ཞིང་གཞན་གྱི་ཕྱོགས་བཟློག་ཙམ་ལ་ཞུགས་པ་སྟེ།",
    "འདི་ལྟར་ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ལས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་སྟེ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་རྣམ་པ་གསུམ་པོ་དེ་དག་ཉིད་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་རོ།",
    "ཁམས་གསུམ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་སྤོང་བའི་ཐབས་ཙམ་ཞིག་ནི་ཡོད་དོ།",
    "དེའི་ཕྱིར་འདི་དག་ཐམས་ཅད་བརྗོད་པར་བྱ་བ་མ་ཡིན་མོད་ཀྱི།",
    "ཡིན་ཕྱིར་མིག་ནི་མིག་གིས་སྟོང་།",
    "སྒྲ་དང་དྲི་རོ་རེག་བྱ་དང་།",
    "ཁམས་བཅོ་བརྒྱད་དང་རེག་དྲུག་དང་།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "མིག་ནི་མིག་གིས་སྟོང་སྟེ།",
    "རེག་བྱ་དང་།",
    "འོག་གི་ཕྱོགས་ནི་འོག་གི་ཕྱོགས་ཀྱིས་སྟོང་ངོ།",
    "སྟེང་གི་ཕྱོགས་ནི་སྟེང་གི་ཕྱོགས་ཀྱིས་སྟོང་ངོ།",
    "འདི་ལྟར་བྱེ་བྲག་པ་དག་གིས་ཕྱོགས་རྣམས་རྫས་ཉིད་དུ་རྟོགས་སོ།",
    "དེ་ལ་འདུས་བྱས་ཞེས་བྱ་བ་ནི་ཁམས་གསུམ་མོ།",
    "རེག་པ་དྲུག་དང་།",
    "རེག་པའི་རྒྱུ་ཅན་གྱི་ཚོར་བ་དྲུག་དང་།",
    "དེ་དག་གི་རང་བཞིན་ནི་དེ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཚན་ཉིད་དེ་དག་རང་རང་ཁོ་ནས་སྟོང་པ་ནི་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱའོ།",
    "དག་གི་རང་བཞིན་ནོ།",
    "དེ་དག་གི་རང་བཞིན་ཡང་གང་ཞིག་ཅེ་ན།",
    "མ་རིག་པའི་རབ་རིབ་དང་བྲལ་བའི་ཤེས་པས་རྟོགས་པར་བྱ་བའི་རང་གི་ངོ་བོའོ།",
    "རིགས་ཀྱི་བུ་དོན་དམ་པ་ནི་བརྗོད་དུ་མེད་ཅིང་ཞི་བ་འཕགས་པ་རྣམས་ཀྱིས་སོ་སོ་རང་གིས་རིག་པར་བྱ་བའོ།",
    "ཁྱོད་ཀྱིས་བསྟན་བཅོས་ཀྱི་དགོངས་པ་མ་རིག་པ་ཞིག་སྟེ།",
    "གང་གི་ཕྱིར་འདི་ཉིད་རང་བཞིན་མ་ཡིན་པ་དེའི་ཕྱིར་དེ་ལྟ་བའི་དོན་དུ་ཚངས་པར་སྤྱོད་པ་དོན་དང་བཅས་པ་འགྱུར་རོ།",
    "རང་གི་ལག་ན་གནས་པའི་སྐྱུ་རུ་ར་བཞིན་དུ།",
    "རྟག་ཏུ་འགོག་པར་གཏོགས་པའི་བསམ་གཏན་ཡིན་མོད་ཀྱི།",
    "རང་གི་ལག་ན་གནས་པའི་སྐྱུ་རུ་ར་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ལྐོག་ཏུ་མ་གྱུར་པའི་དཔེ་སྟེ།",
    "འདུ་བྱེད་རྣམས་གདོད་ནས་སྐྱེ་བ་མེད་པར་རབ་ཏུ་རྟོགས་མོད་ཀྱི།",
    "འདི་ལྟར་འདུ་བྱེད་ཀྱི་རྒྱུན་རབ་ཏུ་འགོག་པ་ལ་གཏོགས་པའི་བསམ་གཏན་པ་ཡིན་མོད་ཀྱི།",
    "ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་ཡོན་ཏན་ཕུལ་དུ་བྱུང་བ་བརྗོད་པའི་སྒོ་ནས་ཤེས་རབ་ཀྱི་སྐབས་ཡོངས་སུ་རྫོགས་པར་མཛད་པ་ཡིན་ནོ།",
    "ས་བདུན་པ་རིང་དུ་སོང་བ་ལ་དངོས་དང་།",
    "རིང་དུ་སོང་འདིར་འདི་ནི་སྐད་ཅིག་དང་།",
    "ཉོན་མོངས་པ་འབར་བ་ཐམས་ཅད་ཤིན་ཏུ་ཞི་ཞིང་རབ་ཏུ་ཞི་སྟེ་ཉེ་བར་ཞི་བའང་ཡིན་ལ།",
    "ཞིང་གི་ཐ་གྲུ་ནམ་མཁའ་དང་མཉམ་པར་ཤིན་ཏུ་བསྒོམས་པའི་ཡིད་དང་ཡང་ལྡན་ལ།",
    "དེ་ནི་བསྐལ་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གིས་ཀྱང་བགྲང་བར་དཀའ་སྟེ།",
    "པའི་སྤྱོད་པས་ཀུན་ནས་ཉོན་མོངས་པ་ཉིད་དུ་ཡིད་ཆེས་པར་བྱ་བ་ཡིན་ནམ་ཞེ་ན།",
    "ས་དང་པོ་རབ་ཏུ་དགའ་བ་ཉིད་བཟུང་བ་ཡན་ཆད་དུ་གང་འོས་པའི་ཚུལ་གྱིས་ཉོན་མོངས་པའི་རྙོག་པ་དང་བྲལ་བ་ཉིད་དུ་ཡིད་ཆེས་པར་བྱ་བ་ཡིན་མོད་ཀྱི།",
    "དེ་ཙམ་གྱིས་ས་བདུན་པོ་རྣམས་སུ་ཉོན་མོངས་པའི་སྤྱོད་པ་ལས་ཡང་དག་པར་འདས་ཤེས་ནི་མི་བྱའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་ཉེས་པ་རྣམས་ཀྱང་རབ་ཏུ་ཤེས་ཏེ།",
    "འོན་ཀྱང་ཉེས་པ་དེ་དག་གིས་གོས་པར་མི་འགྱུར་རོ།",
    "ནམ་མིའི་ལུས་སྤངས་ཏེ་ཚངས་པའི་འཇིག་རྟེན་དུ་སྐྱེས་པར་གྱུར་པ་དེའི་ཚེ་ནི་ཚངས་པའི་གཞལ་མེད་ཁང་ན་གནས་ཤིང་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱང་མཐོང་།",
    "འོན་ཀྱང་དེ་ཙམ་གྱིས་ས་བདུན་པོ་རྣམས་ལ་ཉོན་མོངས་པའི་ཉེས་པ་རྣམས་ལས་ཡང་དག་པར་འདས་ཤེས་ནི་མི་བྱ་སྟེ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་ཉེས་པ་ཐམས་ཅད་ཀྱང་རབ་ཏུ་ཤེས་ཏེ་འཇིག་རྟེན་གྱི་བྱ་བ་ཀུན་ལས་འདས་པས་ཉེས་པ་དེ་དག་གིས་ཀུན་ནས་ཉོན་མོངས་པར་གྱུར་ཅེས་མི་བྱའོ།",
    "ལྷག་པའི་བསམ་པས་ཡོངས་སུ་དག་པའི་ངག་གི་ལས་དང་ལྡན་ཡིན།",
    "རང་གི་བློས་རྣམ་པར་དཔྱད་པས་ནི་མ་ཡིན་ནོ།",
    "ནམ་ནར་སོན་པར་གྱུར་པ་དེའི་ཚེ་རང་གི་བློའི་མཐུས་བློན་པོ་ཐམས་ཅད་ཀྱི་བྱེད་པའི་ཚུལ་ལསཤིན་ཏུ་འདས་པ་ཡིན་ཏེ།",
    "རང་གི་བློས་རྣམ་པར་བརྟགས་པས་ནི་མ་ཡིན་ནོ།",
    "ཕྱིན་ཅི་ལོག་བཞི་དང་ལྡན་པའི་ཉོན་མོངས་པའི་རླན་གྱི་རྣམ་པ་ཐམས་ཅད་ཀྱང་ཡོངས་སུ་སྐེམ་མོ།",
    "རྣམ་པར་དག་པའི་ས་དང་རྗེས་སུ་འབྲེལ་བ་ཉིད་ཀྱི་ཕྱིར་རིང་དུ་སོང་བ་ཞེས་བྱའོ།",
    "སྲིད་པའི་འགྲོ་བར་རང་གི་བདག་ཉིད་སྣ་ཚོགས་སྟོན་པར་བྱེད་པར་འགྱུར།",
