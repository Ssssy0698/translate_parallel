    "ཟངས་ཐལ་སུམ་གཉིས་ལྕཊ་ཐལ་སུམ་ཆ་ལ།",
    "ཤ་རུ་དུར་ཁྲོད་འགྲོན་བུའི་ཐལ་བ་དང་།",
    "ཨ་རུ་རྡོ་དྲེག་དབྱི་དཀར་ཚ་གྲང་གི།",
    "སྒྱུདངུལ་ཆུ་ཞོ་ཕྱེད་མུ་ཟི་ཁྱོར་བ་གང་།",
    "ཐར་ནུ་ཁྲོན་བུ་རེ་ལྕཊ་ལྕམ་ཚྭ་དང་།",
    "སྔོན་བུ་ཆུ་མ་རྩི་དང་པི་པི་ལིང་ རྒྱ་ཚྭ་བུ་རམ་རིལ་ལུ་ཆང་གིས་དབུལ།",
    "ཡུལ་དེ་ལྷ་ཀླུ་མ་མོ་འཁྲུགས་པ་ཡིས།",
    "ཉིན་རེ་ཉིན་ཞག་གཅིག་གཉིས་ཉིན་གསུམ་དང་།",
    "དེ་ལ་ཉིན་མོ་ནས་ནི་ཉིན་བདུན་བར།",
    "གསེར་གྱི་མེ་ཏོག་ཏིག་ཏ་དུག་མོ་ཉུང་།",
    "མ་མོ་ཀླུ་བདུད་སོགས་ཀྱིས་རྐྱེན་བྱས་ནས།",
    "ཕྱེ་མ་ཧི་ཧ་གུར་གུམ་དུག་མོ་ཉུང་།",
    "འགོར་འབབ་དོམ་མཁྲིས་གངས་ཐིག་གི་ཧཾ་དང་།",
    "ཚེ་ཐལ་སྟ་ལོ་སྲད་དཀར་ཀྱི་ལྕེ་བ།",
    "ཅོང་ཟིའི་ཕྱེ་བཏབ་ཁ་སྐོམ་བག་རེ་བཏང་།",
    "དེ་ཕྱིར་དཀར་མངར་དམར་གནོད་དུག་གིས་འཇོམས།",
    "དབྱི་མོང་དཀར་པོ་རི་ལུའམ་ཕྱེ་མར་སྦྱར།",
    "ཤ་རུ་ཕུར་ཡོབ་དྲེ་མའི་ཐལ་བ་དང་།",
    "ལྕི་བ་སེར་ཀའི་ཐལ་བ་བཏབ་པས་སྐེམས།",
    "བུད་མེད་འབྱུང་ཞེས་གསོ་སྤྱད་གཞུང་དུ་བཤད།",
    "ཕོ་ཡི་རྨོངས་དང་མོ་ཡི་སྤྱི་བོའི་སྐྲ།",
    "བསྲེག་པའི་ཐལ་བ་རྒྱ་རུ་གཙོད་རུ་དང་།",
    "ཕྱི་ནང་ལོག་ན་མཛུབ་མོས་སླེབ་ཚད་དབུལ།",
    "སྐད་སྙན་འཁུན་ཞིང་སེན་མོ་རྣོ་བའོ།",
    "མས་འདྲེན་ལོ་མ་ལོན་ལ་རེང་བུ་བྱ།",
    "འཇིང་པ་རེངས་ན་ལྟག་པ་བསྲེག་པར་བྱ།",
    "བྱ་གདོན་སྲུལ་མོ་གྲང་པའི་སྲུལ་མོ་དང་།",
    "སྲུལ་མོ་ལོང་མ་བཞིན་གྱི་རྒྱུན་ཅན་མ།",
    "ནམ་གྲུ་གནམ་གྲུ་སྐེམ་མོ་བུད་མེད་གཟུཊ།",
    "ཀླུ་བདུད་ཀླུ་བཙན་མ་མོ་ཤི་འདྲེ་སོགས།",
    "ཆབ་གཏོར་བཏང་ཞིང་གཟུངས་མོ་དྲལ་གྲྭ་ལྔ་གདོན།",
    "པེ་དཀར་སྲོག་བདག་སེན་མོ་ཀླུ་སེན་མོ།",
    "ཚ་བ་ཆེ་ཞིང་སེན་མོ་གཞོབ་རོཊ་འོང་།",
    "སྒོག་པའི་ཐལ་བ་མར་གསར་བྱུག་པར་བྱ།",
    "སྒོག་ཐལ་དོམ་མཁྲིས་དྲི་ཆུ་སྦྱར་ལ་བྱུག།",
    "དུང་འབུད་པ་དང་བསྒྱུར་བ་དུས་གཅིག་བྱ།",
    "རྒྱུ་དུས་བརྒྱད་ལ་གཟའ་ཆོག་ཐེབས་རེ་བྱ།",
    "སྲིན་བུ་ཕྲ་མོ་མི་ཟད་སྐྱེད་པར་འགྱུར།",
    "ཚད་པས་ཐལ་ལའང་ཙན་དྲ་གོ་མི་ཡི།",
    "བྱི་ཏང་ཀ་དང་ཨ་སྐྱུར་སྲང་རེ་དང་།",
    "སྐྱེར་དགུ་པའི་ཐང་གིས་ཁྲག་མཁྲིས་དང་།",
    "དངུལ་ཆུ་མུ་ཟི་བཙན་དུག་ཟངས་ཐལ་དང་།",
    "འདམ་བུ་རེ་རལ་སྲད་མ་དཀར་པོ་ཡི།",
    "ཐལ་བ་མར་དཀར་བྱུགས་པས་ལུས་སྦོས་འཇོམས།",
    "བསེ་ཞོ་སྣུམ་སོགས་སྦྱར་བ་ལུས་ལ་རེག།",
    "སྤང་རྒྱུན་ཀྱི་ལྕེ་དཀར་པོ་རེ་རལ་དང་།",
    "འོམ་བུ་ལྡོམ་བུ་རེ་རལ་ཚ་ལ་ཡི།",
    "རེག་དུག་མཛེ་འབྲས་ལྷོག་པ་འཇོམས་པར་བྱེད།",
    "གྷི་ཧཾ་ཨུད་པལ་བསིལ་གསུམ་དུག་མོ་ཉུངས།",
    "དེ་ལ་གསོན་ཁྲག་དྲོན་མོ་ཁྱོར་གང་བཏང་།",
    "སེ་ཤིང་རྟ་སྤུ་ཕྱི་ནང་གང་རེག་སྐྱང་།",
    "གི་ཧཾ་ཛཱ་ཏི་རྡོ་ཡི་ཆོ་ལོང་གསུམ།",
    "འཇོག་པོའི་དུག་གིས་ཟིན་པའང་བདེ་བར་འགྱུར།",
    "ནུས་པ་སྔོན་པོར་སོང་ལ་བཏབ་པ་ན།",
    "ཁྱོཊ་ལྷུང་ཀུན་ལ་འཇུག་པ་ཤིན་ཏུ་དཀའ།",
    "བསིལ་དྲོད་སྦྱར་བའི་རེང་བུ་བཏང་བ་ཡིས།",
    "ཆུ་འགག་ཟུག་གིས་འཆི་བ་སྲིད་པ་ཡིན།",
    "དྲི་ཆུས་གསུམ་ཕུལ་ཟླ་བ་རེ་རེ་ཐུབ།",
    "ལུང་ཏང་ཙམ་རེ་ལྟོ་སྟོང་ཟླ་རེ་ཐུབ།",
    "ཚེ་གང་དུག་གི་སྦྱོར་བས་འཇིགས་མི་འགྱུར།",
    "རྨ་བྱ་ཆེན་མོའི་གཟུངས་ནི་མང་བསྒྲག་ན།",
    "འཆི་ཚེ་སྡིག་འཛད་གཟུངས་སྔགས་ཟབ་མོ་དང་།",
    "ཤིང་ཀུན་གཉིས་བསྲེག་ཐལ་བ་དྲི་ཆུར་སྦྱར།",
    "གཏན་ནས་མ་ཆོད་པ་རེ་ཟུང་ལ་རྟགས་མེ་ཏོག་དབྱིབས་འདི་འདྲ་རེ་བཀོད་ཡོད་པ་མཁྱེན་དགོས་པས་རྒྱལ་བསྟན་དར་ཞིང་འགྲོ་ཀུན་རྣམ་མཁྱེན་ཐོབ་པའི་རྒྱུར་གྱུར་ཅིག།",
    "ཚེ་རིག་འཛིན་པ་གང་གི་རྣམ་པར་དཔྱོད་པའི་བློ་གྲོས་དང་།",
    "དེ་བས་ཁོ་བོས་ཀྱང་རང་གི་དགའ་ཕྱོགས་ལྟར་མེ་ཏོག་ཆུང་རུང་མཆོད་རྫས་དང་ཁ་བཏགས་ཆུང་རུང་ལྷ་རྫས་ཀྱི་དཔེ་བཞིན་དཔྱད་རྩོམ་དེབ་འདི་པར་དུ་བསྐྲུན་པ་ཡིན་ལ།",
    "དེ་བས་རོང་འབྲོག་མི་མང་གི་ངག་ཐོག་ན་རླབས་བཞིན་འཕྱོ་ཞིང་།",
    "ཀྱི་རྒྱུ་ཆ་གསར་བ་གང་མང་མང་ཞིག་སྟེར་ངེས་རེད་སྙམ།",
    "བཙན་པོ་སྟག་རི་གཉན་གཟིགས་ཀྱི་སྤྱན་འ་ཞ་རྗེས་གསེར་ཐུར་གྱིས་ཕྱེས་མིན་ལ་དཔྱད་པ།",
    "བོད་ཀྱི་སྲོལ་རྒྱུན་གྱོན་པ་དང་གདན་དང་ལྷམ་ལས་ཐོན་པའི་ལུས་ཕུང་བདེ་ཐང་གི་སྐོར་ལ་དཔྱད་པ།",
    "དཀར་ཆག་སྟག་རི་གཉན་གཟིགས་ཀྱི་སྤྱན་འ་ཞ་རྗེས་གསེར་ཐུར་གྱིས་ཕྱེས་མིན་ལ་དཔྱད་པ།",
    "རྐང་གཉིས་སྲོག་ལ་དུག་གི་ཆན་པས་འདེབས།",
    "དུག་གི་སྦྱོར་བ་སྣ་ཚོགས་དར་བས་ན་རྐང་གཉིས་མིའི་སྲོག་ལ་དུག་གི་ཆན་པས་འདེབས་ཞེས་སྤྱད་བྱའི་དངོས་པོ་ལ་ཆ་བྱད་ཆན་པས་འདེབས་པ་ལྟར་དུག་གིས་སྲོག་གཅོད་པར་བྱེད་པ་རེད།",
    "མོན་ན་རྩི་དང་བཞིར་སྦྱོར་བ་སོགས་རེ་རེ་ལའང་ཞིབ་ཏུ་དབྱེ་ན་རྣམ་གྲངས་སྟོང་དང་རྩ་བཞི་ཙམ་ཡོད།",
    "དེ་ལྟར་དམག་དཔུང་དང་དམག་དཔུང་གི་བར་དང་།",
    "རྒྱལ་པོ་དང་བློན་པོའི་བར་ཕན་ཚུན་གྱི་ཚེ་སྲོག་ལ་གནོད་པ་ཚབས་ཆེན་བཟོ་རེས་བྱས།",
    "སྣ་ནམ་བཟའ་མང་རྗེས་དུག་གིས་བཀྲོངས།",
