    "འཕགས་པས་མཁྱེན་ཕྱིར་བསམ་མེད་ཉིད།",
    "རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་དུ་རིག་པར་བྱ་ཞེ་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་སྐད་དུ་གསུངས་པ་བཞིན་ཏེ།",
    "འཇམ་དཔལ་སྐྱེ་བ་མེད་ཅིང་འགག་པ་མེད་པ་ནི་སེམས་དང་ཡིད་དང་རྣམ་པར་ཤེས་པ་མི་འཇུག་གོ།",
    "དེ་ནི་མེ་སྐྱེ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱས་པར་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་དབྱེར་མེད་པ།",
    "བག་ལ་ཉལ་ལས་ནི་ཡང་དག་པ་མ་ཡིན་པ་དེའི་རང་བཞིན་མ་ཡིན་པའི་དངོས་པོ་བྱིས་བ་རྣམས་ལ་འདོད་ཆགས་བསྐྱེད་པས་ན་སྡུག་པའི་རྣམ་པར་རམ།",
    "ཞེ་སྡང་བསྐྱེད་པས་ཁོང་ཁྲོ་བའི་རྣམ་པར་རམ།",
    "གཞན་ལ་ཕན་པར་བྱེད་པའི་བསམ་པ་རྣམ་པར་མ་དག་པའི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྐྱབས་གསུམ་རྣམ་པར་གཞག་པ་མཛད་ཅེ་ན།",
    "སྐྱབས་གསུམ་རྣམ་པར་གཞག་པ་ཡིན།",
    "རྐང་གཉིས་རྣམས་ཀྱི་མཆོག་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་ཞིང་རྣམ་པར་གཞག་གོ།",
    "འདོད་ཆགས་དང་བྲལ་བ་རྣམས་ཀྱི་མཆོག་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་ཞིང་རྣམ་པར་གཞག་གོ།",
    "ཚོགས་རྣམས་ཀྱི་མཆོག་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་། ཅིང་རྣམ་པར་གཞག་གོ།",
    "དེ་ལ་ལམ་ནི་འདུས་བྱས་ཀྱི་མཚན་ཉིད་དུ་རྟོགས་ལ།",
    "མེད་པ་ནི་སྐྱབས་སམ་སྐྱབས་མ་ཡིན་པར་འགྱུར་བར་འོས་པ་མ་ཡིན་ནོ།",
    "གང་ཞིག་དེ་ལྟར་འཇིགས་པ་དང་བཅས་པའི་ཕྱིར་སྐྱབས་སུ་འགྲོ་བ་དེ་ནི་གདོན་མི་ཟ་བར་འཇིགས་པ་ལས་ངེས་པར་འབྱུང་པ་ཚོལ་ལ།",
    "འདིས་ཅི་ཞིག་གསལ་བར་བྱས་ཤེ་ན།",
    "གནས་བཞི་པོ་འདི་དག་ཀྱང་གོ་རིམས་ཇི་ལྟ་བཞིན་དུ་རྒྱུ་བཞིས་བསམ་གྱིས་མི་ཁྱབ་པ་ཉིད་ཀྱི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ཡིན་ནོ་ཞེས་བརྗོད་དོ།",
    "ལྷུན་གྲུབ་རྣམ་པར་མི་རྟོག་ཕྱིར།",
    "དེ་ལ་དྲི་མ་དང་བཅས་པའི་དེ་བཞིན་རྟེན་ཉིད་ནི་ཅིག་བཅར་དུས་གཅིག་ཏུ་རྣམ་པར་དག་པ་ཡང་ཡིན་ལ།",
    "སེམས་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་རྟོགས་པར་དཀའ་བ་དང་།",
    "དཔེར་ན་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཚད་དང་མཉམ་པའི་དར་ཡུག་ཆེན་པོ་གཅིག་ཡོད་པར་གྱུར་ལ།",
    "དར་ཡུག་ཆེན་པོ་དེ་ལ་ཡང་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་རྫོགས་པར་བྲིས་པར་གྱུར་ཏེ།",
    "དར་ཡུག་ཆེན་པོ་དེ་ཡང་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་གཅིག་ཏུ་བཅུག་པར་གྱུར་ཏོ།",
    "ཇི་ལྟར་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་གཅིག་ཏུ་དར་ཡུག་ཆེན་པོ་དེ་བཅུག་པ་དེ་བཞིན་དུ་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་མ་ལུས་པ་རྣམས་སུ་དེའི་ཚད་ཀྱི་དར་ཡུག་ཆེན་པོ་དེ་ནང་དུ་བཅུག་པར་གྱུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་དང་མཉམ་པ་ཉིད་རྗེས་སུ་ཐོབ་པ་བཞིན་དུ་དེ་དག་ལ་དེ་བཞིན་གཤེགས་པའི་ལམ་བསྟན་པས་འདུ་ཤེས་ཀྱིས་བྱས་པའི་འཆིང་བ་ཐམས་ཅད་ལོག་པར་བྱེད་དོ།",
    "དེ་ལ་རྒྱལ་བའི་མཛད་པ་ནི་ཅིག་ཅར་ཐམས་ཅད་ལ་དུས་ཐམས་ཅད་དུ་ལྷུན་གྱིས་གྲུབ་ཅིང་རྣམ་པར་མི་རྟོག་པར་བསམ་བ་ཇི་ལྟ་བ་དང་།",
    "གཞན་གྱིས་སྒྲུབ་པར་དཀའ་བ།",
    "ནམ་མཁའ་དང་མཉམ་པ་ཉིད་ཀྱིས་རྣམ་པར་རྟོག་པ་མེད་པ།",
    "རྒྱས་པར་བསྟན་ཏེ།",
    "རིགས་ཀྱི་བུ་རྣམ་གྲངས་འདིས་འདི་ལྟར་རིགས་པར་བྱ་སྟེ།",
    "ཡན་ལག་རྟོགས་པར་བྱེད་ཕྱིར་ཏེ།",
    "དོན་གྱི་གནས་བཞིན་པོ་འདི་དག་ལས་ཀྱང་ཤེས་བྱ་ཐམས་ཅད་བསྡུས་པའི་ཕྱིར་དང་པོ་ནི་རྟོགས་པར་བྱ་བའི་གནས་སུ་བལྟ་བར་བྱའོ།",
    "བྱང་། ཆུབ་ཀྱི་ཡན་ལག་རྣམས་ཉིད་ཀྱིས་གཞན་དག་རྟོགས་པར་བྱེད་པའི་ཕྱིར་བཞི་པ་རྟོགས་པར་བྱེད་པའི་གནས་སོ།",
    "འདི་ཕན་ཆད་གཞུང་ལྷག་མས་གནས་བཞི་པོ་འདི་དག་ཉིད་ཀྱིས་མཐར་གྱིས་རྣམ་པར་དབྱེ་བ་རྒྱས་པར་སྟོན་པར་རིག་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་དེ་བཞིན་ཉིད་རྣམ་པར་དབྱེར་མེད་པའི་དོན་དང་།",
    "དེ་ཁོ་ནའི་ཡི་ཤེས་དམ་པའི་ཡུལ་དེ་བཞིན་གཤེགས་པའི་ཁམས་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "དོན་རྣམ་པར་བཅུ་གང་ཞེ་ན།",
    "ཆུ་རྣམ་པར་དག་པའི་ཡོན་ཏན་དང་།",
    "དེ་ལ་སྲིད་པ་འདོད་པ་ནི་རྣམ་པ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "ཤཱ་རིའི་བུ་དེ་དག་ནི་མུན་པ་བས་ཀྱང་ཆེས་མུན་པ་ཆེན་པོར་འགྲོ་བ་མུན་པ་ཆེན་པོ་དང་ལྡན་པའོ་ཞེས་པ་སྨྲའོ་ཞེས་གསུངས་པའོ།",
    "མངོན་སུམ་དུ་བྱེད་པར་མི་འགྱུར་བའི་སྒྲིབ་པ་འདི་བཞིན་ཡང་དག་པར་གནས་སོ།",
    "གཙང་བདག་བདེ་དང་རྟག་ཉིད་ཀྱི།",
    "སྡུག་བསྔལ་ཡིད་འབྱུང་ཞི་ཐོབ་པར།",
    "དེ་ལ་གང་ཞིག་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་མི་རྟག་པ་ལ་རྟག་གོ་སྙམ་པར་འདུ་ཤེས་པ་དང་།",
    "བདག་མེད་པ་ལ་བདག་གོ་སྙམ་པ་དང་མི་གཙང་བ་ལ་གཙང་ངོ་སྙམ་པར་འདུ་ཤེས་པ་འདི་ནི་ཕྱིན་ཅི་ལོག་རྣམ་པ་བཞི་ཞེས་བརྗོད་ལ།",
    "འདི་ལས་བཟློག་པ་ལ་ནི་ཕྱིན་ཅི་མ་ལོག་པ་རྣམ་པ་བཞི་ཉིད་དུ་རིག་པར་བྱའོ།",
    "མི་གཙང་བའི་འདུ་ཤེས་གང་ཡིན་པ་སྟེ།",
    "གཙང་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "དེ་དག་ནི་མི་རྟག་པ་ལ་རྟག་པར་འདུ་ཤེས་པ།",
