    "བདར་གཞོག་གཏན་ནས་མ་བྱས་པའི་ཤིང་འཛེར་ཡོད་བཞིན་པ་དེ་འདྲ་རེད་འདུག་ཟེར།",
    "ཕྱིས་སུ་ནང་བཟུང་འཁར་བསིལ་མེད་པ་མ་གཏོགས་སྐུ་བརྙན་དང་ལྷ་ཁང་གསར་བཞེངས་བྱས་ཡོད་པ་རེད།",
    "སྔར་སོག་མོའི་ཁང་པ་ཡོད་ས་དེ་བརྒྱུད་ཕ་རིར་བཀྲ་ཐང་ནས་ཕེབས་པའི་སྐབས་ལམ་བར་ནས་མི་ཞིག་དང་ཐུག་པར།",
    "དེ་སྔ་སོག་པོ་རལ་པ་ཐོད་ཐོ་ཟེར་བའི་དཔོན་དམག་གི་དམག་མཁར་ལྟེ་བ་ཆགས་ཡུལ་དེ་ཡིན་ཅིང་།",
    "གུས་རང་༡༩༧༩ ལོར་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་བཏང་སྐབས་ཁྲོ་ཆེན་མོ་དེ་ནི་མི་མང་གི་འབྲུ་རིགས་བླུགས་སྣོད་དུ་འདུག་ཅིང་།",
    "དེ་འོག་གི་མི་ཚན་ས་མི་དུད་བཤེར་སོགས་དང་།",
    "ལན་གྲུའུ་སྤྲུལ་པའི་གཙུག་ལག་ཁང་དུ་བཞུགས་པའི་སྐབས་སྨྱུག་མ་ཚིགས་༨ ཡོད་པ་ཞིག་ལ་ཚིགས་༤༦ གི་ཐོག་ཏུ་ཀྱོག་ཚིགས་གཅིག་ཡོད་པ་སྐུ་ཚ་འཕགས་པ་བློ་གྲོས་རྒྱལ་མཚན་ལ་གནང་སྟེ།",
    "རང་ལོ་༤༦ གི་ཐོག་བར་ཆད་དེ་ཟློག་ན་རང་ལོ་བརྒྱད་བཅུ་ཐམ་པ་བཞུགས་པའོ་ཞེས་བཀའ་སྩལ་བ་ལྟར།",
    "དེ་འདྲའི་དུས་སུ་ཕེབས་ཉེའི་ཡས་མས་ནས་ཉེ་གནས་ཆེན་མོ་ཟེར་བ་དེ་དང་།",
    "དཔོན་དམག་རྣམས་གཙང་དུ་འབྱོར་ཉེའི་སྐབས་ཉེ་གནས་ཆེན་མོ་རང་གི་རྫུན་རྐུབ་བརྡོལ་བར་སྐྲག་ནས།",
    "དཔོན་དམག་རྣམས་ཨ་གྲོ་ལ་ཁར་སླེབས་དུས་ཉེ་གནས་ཆེན་མོ་ཁོ་རང་ཡང་སྡུག་གནོང་མ་བཟོད་པར་དུག་ཟས་ཏེ་ཐོག་ཁ་ནས་ལྕེབས་པས་ཤི།",
    "ཉིན་གསུམ་གྱི་མཚམས་སུ་ཧོར་དམག་གི་རུ་སྒྲིག་པའི་དཀྱིལ་ནས་དཔོན་ཆེན་བཀྱིག་བཞིན་ཧོར་གྱི་དཔོན་ཆེན་གསུམ་གྱི་མདུན་དུ་ཁྲིད།",
    "གདུང་རུས་ཀྱི་ནང་དུ་བ་སོ་བརྡུང་ནས་བསྲེས་ཏེ་མཆོད་དཔོན་ཏིར་ཤྲཱི་གྲགས་པ་འོད་ཟེར་ནས་ན་རེ།",
    "ཁྱོད་རྣམས་ཀྱིས་དྲང་པོར་སྨྲ་བ་ནི་འགྲོ་བའི་དོན་དུ་འགྱུར་རོ་ཞེས།",
    "ཧོར་གྱི་རྒྱལ་སྲས་མོ་མེ་ཁ་བདུན་ཞེས་པ་ཞིག་ཇོ་མོར་གནང་།",
    "སྔ་རྗེས་ཇོ་མོ་གསུམ་བཞེས་པའི་སྔོན་མ་གཉིས་ལ་སྲས་རྒྱུད་མ་བྱུང་།",
    "ཕ་མིང་སྐུ་ཞང་རྔ་སྒྲ་ཞེས་པའི་སྲས་མོ་མཁའ་འགྲོ་འབུམ་ལ།",
    "ཇོ་མོ་གསུམ་པ་ཡུལ་ཞ་ལུ།",
    "ཕ་མིང་སྐུ་ཞང་རྔ་སྒྲ་ཞེས་པའི་སྲས་མོ་མཁའ་འགྲོ་འབུམ་ལ།",
    "ཕྱག་ན་གཤེགས་ནས་ཟླ་བ་༦ སོང་བའི།",
    "ཁོང་ཉིད་ལ་ཧོར་རྒྱལ་པོའི་གྲས་ཇི་བིག་ཐེ་མུར་ཟེར་བའི་སྲས་མོ་དཔལ་ལྡན་ཞེས་པར་སྲས་རྒྱུད་མ་བྱུང་བ་དང་།",
    "ཇོ་མོ་གཉིས་པ་སྟག་འབུམ་ལ་སྲས་གཅིག་འཁྲུངས་ཀྱང་ཆུང་ངུའི་དུས་སུ་སྐུ་གཤེགས།",
    "འགྲོ་མགོན་ཕྱག་ན་རྡོ་རྗེ་རྣམ་གཉིས་དང་ཡབ་གཅིག་པ་སློབ་དཔོན་ཡེ་ཤེས་འབྱུང་གནས་ཀྱི་སྲས་བདག་ཉིད་ཆེན་པོ་བཟང་པོ་དཔལ་ཕྱི་ལོ་༡༢༦༢ བོད་རབ་བྱུང་བཞི་པའི་ཆུ་ཁྱི་ལོར་ཡུམ་ཇོ་མོ་འབུམ་མེར་ཞུ་བར་སྐུ་འཁྲུངས།",
    "ད་བཟོད་ས་སྐྱ་པའི་བརྒྱུད་རེས་མོས་སྤུས་མོར་བབས་པའི་དུས་ཀྱང་ཡོང་སྲིད།",
    "དེ་ནས་རི་བོ་ཏཱ་ལ་ཟེར་བའི་གནས་སུ་ཡང་སྦས་པའི་རྣལ་འབྱོར་གྱི་ཚུལ་དུ་བཞུགས་བཞིན་རྒྱ་མོ་ཞིག་ལ་སྲས་ཤིག་འཁྲུངས་ཤིང་།",
    "དཔོན་ཆེན་ཀུན་དགའ་འོད་ཟེར་དུ་གྲགས་པ་དེ་བྱུང་ཞེས་དང་འགའ་རེས་དགུང་ལོ་བདུན་ལ་སྐུ་གཤེགས་ཞེས་ཀྱང་བརྗོད།",
    "དེའི་དུས་སུ་ཡང་ཧོར་རྒྱལ་པོའི་ལུང་ལྕི་མོ་བྱུང་དོགས་པས་སྒྲོལ་མ་ལ་གསོལ་བ་འདེབས་པར་འབད་པས།",
    "རྗེ་བཙུན་སྒྲོལ་མས་ཞལ་གཟིགས།",
    "དེ་འདྲའི་སྐབས་སུ་སློབ་དཔོན་དྷརྨ་པ་ལའི་གདུང་ཐལ་ཐམས་ཅད་རིང་སྲེལ་དུ་སོང་བ་རྒྱལ་པོ་ལ་ཕུལ་བས།",
    "རྒྱ་སྐད་དུ་ཤིན་ཏུ་ཧུ་ཞེས་པ་རྣམས་གཟིགས།",
    "སྔ་མོར་ཡུལ་ལྷ་ང་འདྲ་མཆེད་དེབ་དང་པོ།",
    "དེ་དག་ཡུལ་མིས་རེས་བསྐོར་གྱིས་འཚོ་བ་ཕུལ།",
    "རྡོ་མགོ་ཟམ་པ་ཟེར་བའི་སྲིབ་རིའི་རྩེ་མོ་ནམ་མཁའི་དབྱིངས་ནས་སྒྲབ་བླ་གཅིག་ཀ་ཡེ་སྒང་ཟེར་སར་ས་ལ་ཟགས།",
    "དེ་འདྲའི་མཛད་པ་ཕྱེད་མི་ལུས་དྲོ་གྲང་གི་ཚོར་བ་ལེན་པ་ལྟ་བུ་དང་།",
    "ཕྱིས་སུ་རྒྱ་གར་ནས་རང་ཡུལ་དུ་སྔ་རྗེས་གཉིས་སོང་སྐབས་སྔར་ལྟར་མཐོང་རྒྱུ་འདུག།",
    "ས་སློང་མཛད་དེ་ལྷ་ཁང་ཕྱི་ཁོག་གསར་བཞེངས་མཛད་སོང་ཡང་།",
    "གོང་གི་དགོན་ཆུང་འདི་རྣམས་སྔ་རབས་གཡུང་དྲུང་བོན་གྱི་དགོན་གནས་ཡིན་ཚོད་དང་།",
    "གཙུག་ལག་ཁང་གི་ལྟག་ནས་མཁར་ལྷག་མ་མན་གྱི་གླིང་གཅིག་རྩེ་སྐོར་ཕྱོགས་གླིང་གཅིག་བཅས་རིམ་བཞིན་ཆགས།",
    "སེང་གེ་སྒོ་མོ་ཟེར་བ་བྲག་སྣ་ཞིག་གི་མགོ་ལ་སྒོ་ཆེན་གྱི་ཁང་པ་ཡོད་པའི་འོག་ནས་གྱེན་དུ་འཛེགས་དགོས་པར།",
    "གྱེན་ལ་བརྒལ་ཏེ་རི་རྐེད་གཡས་གཡོན་སྐོར་ལམ་ནས་ལམ་ཕྲན་རེ་ཡོད་པ་གང་ནས་ཡོང་ན་སྒོ་རྩར་སླེབས་དུས་སྒོ་ནང་དུ་འཛུལ་བ་ལས་ཀ་སྐོར་བྱ་ཡུལ་མེད་པ་དེར་མ་ཡུམ་མའི་སྒོ་ཞེས་ཕྱིས་སུ་འབོད།",
    "དབྱར་གྱི་དུས་སུ་རྒྱ་རྒན་ནང་པའི་མར་ཙམ་ནས་བྱག་རེ་འགྱུའི་ཆུ་རི་རྐེད་ནས་ཡུར་བུའི་ལམ་ནས་མཁར་ལྟག་མའི་སྒང་བར་འཐུང་ཆུ་ཁྲིད་ཐུབ།",
    "པར་ཤོག་ཨ་ལོ་ནང་གི་ཤིང་ཤོག་རྒྱལ་པོའི་བཀའ་ཡིས་བསྒོ་བ་ལྟར་ཚད་ལྡན་ལ།",
    "ལམ་འབྲས་ལྷ་ཁང་དུ་གནས་རྟེན་བཅུ་དྲུག་གི་གཙོ་བོར་སྟོན་པ་བྱེའུ་དྲོད།",
