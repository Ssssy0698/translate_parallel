    "དངོས་འབྲེལ་བྱས་ན་ནོར་གྱི་ལོངས་སྤྱོད་རྩོལ་བའི་བཀའ་གཏད་ཀྱང་ཡོད་པ་རེད་ཅེས་གསུང་བྱུང་ཡང་འཇུ་ཆེན་གྱི་ནོར་ལོངས་སྤྱོད་ལ་ཉམས་གུད་ཆེན་པོར་གྱུར་པ་རེད།",
    "ལོངས་སྤྱོད་ཆེན་པོ་ཡོང་རྒྱུའི་རེ་བ་ནི།",
    "རྒྱ་དམར་གུང་ཁྲན་གྱིས་གཏོར་བཤིག་བྱས་པ་ནས་བཟུང་སེམས་ལ་འཁོར་མ་མྱོང་བ་ཡིན་པ་བཅས་ཞོར་འཕྲོས་སུ་ཐལ།",
    "དགྲ་དོགས་ལས་ཐོག་སོ་རེར་ཐོག་རྩེག་གཉིས་རེའི་མཐོ་ཚད་ཡོད་པའི་བར་ཐོག་ཏུ་བསྡད་དེ།",
    "རག་ཤག་སྲས་མོ་སྒྲོན་དཀར་ཚེ་བརྟན་བཙུན་མོར་བསུས།",
    "ཁོང་ཉིད་ཕྱི་ལོ་༡༨༦༡ ལོར་སྐྱེས་འདུག་སྟེ་དགུང་གྲངས་༨༣ བཞུགས་པ་རེད།",
    "ཁོང་གི་སྐུ་ཚེའི་རིང་དུ་འཇུ་ཆེན་གྱི་ལོངས་སྤྱོད་མངའ་ཐང་ཉམས་གུད་ཆེན་པོར་ཆགས་པ་ཡིན་ཀྱང་།",
    "སྔ་མོའི་ལམ་གྱི་མདའ་གཞུའི་རྩལ་ཆེན་པོ་ཡོད་པས་ཡིན།",
    "ཆ་ཕྲེང་པ་རྣམས་འཛོམས་མདའ་བརྒྱུད་ཕྱིར་ལོག་བྱ་དགོས་གྱུར་པ་རེད།",
    "ཕ་རི་ཨ་སློག་བྲག་སྒང་དུ་ཤིང་བྱང་བཙུགས་ཏེ་དེར་མདའ་མོ་ཕོག་ན་གཅེས་པ་བུ་ནས་འབྲི་མ་ལྔ་བཅུ་སྟེར་རྒྱ་དང་།",
    "དེ་ནས་འཇུ་ཆེན་ཕུན་ཚོགས་དོན་འགྲུབ་ཀྱིས་བླ་བྱེ་དཀྱིལ་གྱི་སྟེང་ནས་ཨ་སློག་བྲག་སྒང་དུ་བཙུགས་པའི་ཤིང་བྱང་ལ་མདའ་འཕངས་པས་ནག་ཐིག་གི་དཀྱིལ་དུ་བརྒྱབ་སྟེ་ཟུག་པར།",
    "མདའ་སྐྱེན་པོ་གླིང་གི་དཔའ་རྟུལ་དང་འདྲ་ཟེར་བའི་གཡེར་གྲགས་ཆོད།",
    "གཞེ་མོ་བཀྲ་ཤིས་ཚེ་མཚོ་ནས་གྲོ་ཆས་རྟ་དྲེལ་རྒྱབ་གྲངས་མང་པོ་རྟག་ཏུ་སྐྱེལ་དགོས་པ་བཟོས།",
    "རྒྱ་ཨན་བན་དུས་ཀྱི་དམག་འཁྲུག་ལ་སོགས་པའི་སྐབས་དང་ཡང་འཁེལ་བ་རེད།",
    "རྟ་ཡི་རྒྱུགས་རྩལ་ལྟར་སུ་ཞིག་ལ་མེད་པ་གཡེར་གྲགས་བྱུང་བ་རེད།",
    "ཇེ་དར་སོང་བ་དང་།",
    "རྒྱ་ནག་མན་ཇུའི་དམག་བོད་ནས་ཕྱིར་འབུད་བཏང་རྗེས།",
    "གོ་མིན་ཏང་གི་དམག་དང་།",
    "གྲུ་མོ་ཐུབ་བསྟན་ཅན་མདུན་བསྐྱོད་དམག་དཔོན་བྱས་ཏེ་བསྐྱོད་པ་དང་།",
    "རིང་ཤའི་ཕུ་སོགས་འཇུ་ཆེ་ཆུང་གི་ས་ཆ་དང་།",
    "དགེ་རབ་ཕུ་མ་ཚང་གི་ས་ཆ་ཡིན།",
    "རྒྱ་ཇག་གི་དགྲར་བྲོས་བྱེད་ལོ་ཞེས་ཡུལ་མིའི་ཁ་རྒྱུན་དུ་གནས།",
    "དེ་འདྲའི་མུ་ནས་བུ་མོ་དང་ཁང་སར་ཕྱག་མཛོད་གཉིས་བཟའ་འབྲེལ་ཡིན་པའི་དྭོགས་པ་ཆགས་ཏེ།",
    "ཕྱག་མཛོད་ནི་རྟ་དྲེལ་ལ་དགའ་པོ་ཡོད་སྟབས་ཉིན་ཞིག་ལ་བློན་པོ་ཁག་ཅིག་གིས་འོག་ཤོད་སྒྲོམ་སྐས་འོག་ཏུ་གབ།",
    "གཟིགས་ཞིབ་གནང་ན་ཞེས་ཞུས་ཏེ་གདན་དྲངས།",
    "ཇས་ཚང་ཟེར་བའི་བློན་པོ་མང་དག་རེར་ཐོན།",
    "མདུན་ཞིང་མོ་ཚང་གི་བུ་རབ་བརྟན་ཁོང་ཉིད་འཇུ་ཆུང་ཚེ་སྟོབས་དང་།",
    "མིང་སྲིན་གི་སྤུན་ཡིན་སྟབས་ཕན་གྲོགས་ལ་བསམ་སྟེ།",
    "ཞིང་མོར་མནའ་མ་སྤྲོད་དུས་འཇུ་ཆུང་གི་ནང་ནས་བཏང་བའི་མིང་སྲིང་གི་བུ་སྤུན་རེད།",
    "ཚང་གིས་ཀྲང་ཐོན་ཀྲང་ལ་འབྲེལ་བ་བྱས།",
    "འཇུ་ཆེན་དཔོན་འཁོར་རྣམས་ཕྱིར་ལོག་པ་རེད།",
    "ལོ་ཤས་སོང་རྗེས་ཏྲེ་ཧོར་ཁང་སར་ཚང་དང་།",
    "སྡོད་ཁང་རྒྱ་དམག་གིས་བསྐོར་ནས་ཕྱི་འགྲུལ་ནང་འགྲོ་ཡོངས་སུ་བཀག་དེ་འདྲའི་གནས་ཚུལ་རྨེ་ཤོད་དུ་ཐོས་པར།",
    "ཞིང་མོ་གཉིས་ནས་གོ་ཧྲག་མི་གྲངས་༨ སྐོར་ཏྲེ་ཧོར་བེ་རི་བར་བསྐྱོད།",
    "དེ་ནས་རྟ་མི་ཉུང་ཤས་ཤིག་མཚན་མོར་དཀར་མཛེས་བརྒྱུད་གཤོངས་གཉེར་གྱི་ཉེ་འཁྲིས་གྲོང་ནང་དུ་འཛུལ།",
    "ལོ་ངོ་གཉིས་ཙམ་གྱི་བུ་མོ་རྡོ་རྗེ་ལྷ་མོ་བཅས་ཕྱི་ལོ་༡༩༣༧ གླང་གི་ལོར་རྒྱུ་དངོས་གང་ཐོབ་ཀྱིས་མཚན་མོར་གསང་ཁྲིད་བྱས།",
    "ཞིང་མོ་ཉེ་ཁག་གཉིས་ཀྱི་དབར་ན་ངོས་རང་འགུལ་བསྐྱོད་བྱ་ཡུལ་མི་འདུག་པས་གནས་གཞན་ཞིག་ཏུ་སྤོ་ཐབས་བྱ་དགོས་ཞེས་ཡང་ཡང་བརྗོད་པ་ལྟར།",
    "དེའི་རྗེས་སུ་པཎ་ཆེན་ཚང་གི་དཔོན་དམག་དཀར་མཛེས་སུ་འབྱོར་སྡོད་བྱས།",
    "དེ་སྔ་ཕྱི་ལོ་༡༩༣༣ ལོར་བྲེ་བོ་ཚང་གི་བློན་པོ་དང་།",
    "རྒྱ་མི་ཀྲང་ཐོན་ཀྲང་གིས་རྒྱ་དམག་༡ སྐོར་ཞིག་དང་།",
    "ཁོང་ཚོས་སྲས་པོ་དཔོན་གཡོག་བཅུ་གཉིས་མཉམ་ཁྲིད་ཀྱིས་ཡོང་བར།",
    "ཨ་ཇ་ཛི་འགུལ་སྒང་གི་རྒྱབ་ཕྱོགས་ནས་ཡོང་སྐབས་སྲས་པོའི་ཉེ་འཁྲིས་ནས་སྐད་སྒྱུར་ནོར་བུས་ཕོ་རྒོད་པོ་ཡིན་པས་ཅི་ཕན་མེད།",
    "སྲས་པོས་བརྡ་དོན་རྟོགས་ཏེ་ཡར་ཙམ་ནས་ཟུར་འགྲོས་ཀྱི་རི་ངོས་དེ་ནས་ཕར་རྟ་རྒྱུགས་མ་མདུར་གྱིས་བྲོས་སོང་།",
    "རྒྱ་དམག་གིས་མེ་མདའ་བརྒྱབ་ཀྱང་སྐྱོན་མ་བྱུང་།",
    "དེ་ལ་བུ་མོ་ཞིག་ལས་བུ་མེད།",
    "བུ་མོ་དེ་བེ་རི་ལྕང་རྒན་ཚང་ཟེར་བའི་ཁྱིམ་ཚང་འབྱོར་ལྡན་ཅན་དེ་ལ་སྤྲད་དེ།",
    "རྒྱ་བོད་དམག་འཁྲུག་སྔ་མ་ནི་མན་ཇུའི་དམག་བོད་ནས་ཕྱིར་འབུད་ཀྱིས་ཕྱི་ལོ་༡༩༡༤ ནས་༡༩༡༨ བར་དང་།",
    "དར་རྒྱས་ནང་འཁྲུག་རྐྱེན་གྱིས་གོ་མིན་ཏང་གི་དམག་དང་འཐབ་འཁྲུག་སྐབས་ཕྱི་ལོ་༡༩༢༩ ནས་༡༩༣༢ བར་བོད་དམག་བྲེ་བོ་དང་།",
    "དགུ་མདའ་བུ་མགོན་གཅེས་བཅས་རྒྱ་དམག་གིས་བསད་པའི་ཕན་ཚུན་འཁོན་འཛིན་ཡོད་བཞིན་དུ།",
    "བྲེ་བོ་དཔོན་སྐལ་བཟང་རྣམ་རྒྱལ་ལ་སྲིང་མོ་གཉིས་ཡོད་པ་ནས་གཅིག་དགུ་མདའ་བུ་འཕྲིན་ལས་ཟླ་བར་མནའ་མར་སྤྲད་པ་དང་།",
    "སྲིང་མོ་གཅིག་ཧོར་ཨ་ཐུབ་ཚང་ལ་སྤྲད།",
    "ཁོང་ཁྱིམ་ཁག་གཉིས་པོ་བྲེ་བོ་དཔོན་གྱི་བློན་པོ་ཆེ་གྲས་གཉིས་ཡིན་པའི་མི་ངོ་རྣམས་བྲེ་བོ་ཚང་གི་ཚ་བོ་ཡིན་པས་སུ་ལའང་དཔོན་ས་མ་སྤྲད།",
    "བྲེ་བོ་དཔོན་ཚང་གི་དོན་དུ་དམག་འཁྲུག་སྔ་རྗེས་བྱས་ཏེ།",
    "ཉག་རོང་རྩོད་པ་ཐུག་ལོ་མང་དམག་འཁྲུག་སྟེ་མི་མང་པོ་བསད་རེས་བྱས།",
    "ཕན་ཚུན་གྱི་ས་མཚམས་ལུང་ཆེན་ཞིག་གི་རི་གདོང་ཕར་ཚུར་དམག་ཤོག་སོ་སོས་གྲབས་བྱས་པའི་སྐབས།",
    "ཉག་རོང་གཉིས་དམག་འདི་ཐོག་ནས་གྱོད་རྟ་སྒའི་གོང་གི་ཐག་གཅོད་བྱ་དགོས།",
    "དེར་བརྟེན་ཁྱོད་ཚོ་ཉག་རོང་དམག་གི་འགོ་པ་སུ་ཡོད་དེ་དང་།",
    "ང་ཚོ་བྲེ་བོ་དམག་གི་འགོ་པ་གཉིས་སུ་རྒྱལ་སུ་ཕམ་དེ་རིང་བལྟ།",
    "ཁྱོད་རང་རྒྱལ་ན་རྒྱལ་ངེས་ཡིན།",
    "དེ་ཨེ་བྱེད་ཁྱོད་ཀྱིས་ཐག་གཅོད་ཆོག་ཐག་ཆོད་ན་རང་རེ་གཉིས་པོ་བསྡུར།",
    "དམག་མང་གིས་ཕན་ཚུན་བར་དཔང་དང་ལྟད་མོ་ལྟོས།",
    "ཉག་རོང་གི་དམག་དཔོན་དང་།",
    "ཉེ་འཁྲིས་སུ་སླེབས་མཚམས་སུ་ཉག་རོང་གི་འགོ་པ་དེས་ལག་སྔ་བྱས་ནས་མེ་མདའ་བརྒྱབ་སྟེ་དགུ་མདའ་བསྟན་དགའ་རྟ་ཐོག་ནས་ལྷུང་།",
    "ཕན་ཚུན་གཏམ་བརྗོད་རེས་མི་ཐུབ་ཀྱང་མིག་ཧྲིལ་ཧྲིལ་དུ་བལྟ་རེས་ཙམ་རེ་བྱས་ཏེ་རང་སར་ཤི།",
    "རང་རང་གི་དམག་ཤོག་ནས་སྐུ་ཕུང་རང་བདག་བྱས།",
    "དེ་ནས་བཟུང་དགྲ་གྱོད་མི་བྱེད་པའི་ཐག་གཙང་མ་ཆོད་པ་རེད།",
    "བྲེ་བོ་ཚང་གི་ཇས་ཚང་ཡོད་ཚད་ལ་དཀའ་ངལ་ཚད་ལས་འདས་པ་བྱུང་།",
    "སོག་མོ་དབར་གྱི་རྩོད་རྙོག་སྐོར།",
    "ཨ་མཁར་ནང་པ་བཅས་པའི་དབར་མཚམས་འབྲོག་སའི་རྩྭ་བཟའ་ཆུ་འཐུང་འགྲིགས་མིན་གྱི་དོན་རྐྱེན་ལས་ཕྱི་ལོ་༡༩༤༢ ལོ་ཙམ་ནས་ས་རྩོད་དངོས་སུ་ཤོར།",
    "རྔ་མོང་སྣ་པ་ཨ་ཏི་བུ་དང་།",
    "སྤོམ་འགུལ་སྐལ་བཟང་ཅན་ཟླ་བ་གཅིག་རིང་ཚོགས་ཀྱང་འགྲིགས་ཐབས་མ་ཐུབ།",
    "སོག་མོའི་རྒྱབ་ཏུ་གཉེར་འཇུ་ཆུང་ཚེ་སྟོབས་ཀྱིས་བྱས་ཏེ་རྩོད་གཞི་ཇི་ཆེར་གྱུར་ཏེ།",
    "ཕྱི་ནང་གཉིས་འཐབ་བྱ་རྒྱུའི་འཆར་བཀོད་བྱས་སོང་ཟེར་བའི་སྔོན་བརྡ་བྱུང་།",
    "རྨེ་ཤོད་འབབ་ལམ་དགྲ་མནན་འགག་གི་ཆུ་ཕར་ཚུར་དུ་སྒུག་ར་བཟུང་།",
    "ཁོང་ནས་རང་རེ་བུ་སྤྱན་རྣམས་བློ་སེམས་སྐྱིད་སྡུག་མི་མཉམ་པ་མེད་ཀྱང་།",
    "དེ་རྩིས་ཁྱེད་དཔོན་འཁོར་ནས་གོ་བསྔར་ཡག་པོ་བྱ་རོགས་ཞེས་གསུངས་ཏེ་བཏང་སོང་།",
    "ཕྱི་ཉིན་ཕྱི་དྲོ་ཙམ་ལ་མེ་འདའ་འཕེན་རེས་ཀྱི་སྒྲ་ཐོས།",
    "དགྲ་གནན་འགག་གི་སྲི་མནན་མཆོད་རྟེན་རྣམས་ཡོད་ས་ནས་ལྷ་རྒྱལ་དཔོན་འཁོར་རྣམས་རྟ་བང་སྒྲིག་སྟེ་བཤར་བཞིན་སྒུག་ར་བས་མེ་མདའ་བརྒྱབ་སྟེ་ལྷ་རྒྱལ་རྟ་ཐོག་ནས་ས་ལ་ཕབ།",
    "སྐལ་བཟང་རྣམ་རྒྱལ་ཅན་ཁྱོན་བསྡོམས་འཛིན་པ་དཔོན་འཁོར་མི་གྲངས་བཅུ་གཅིག་སྲོག་སྐྱོན་བཏང་།",
    "སྒུག་རའི་ནང་ཡོད་སོག་མོ་བུ་ཆེ་བ་དབུ་རྟེན་སྒུག་ར་ནས་ལང་སྟེ་ཀི་ཤར་བརྒྱབ་པ།",
    "བརླ་ཤ་གཡས་པའི་སྟེང་དུ་མེ་མདའ་བརྒྱབ་པས་མཚན་མོར་འདས།",
    "མི་ཆེན་ཞེ་གཅིག་ཡོད་པས་དངོས་ར་འཕྲོད་ཀྱི་ཡོད་པ་རེད།",
    "འཁོར་གཡོག་མི་གྲངས་༨༢ ཙམ་དང་རྨེ་ཤོད་ནས་རྔ་མོང་སྣ་བརྒྱུད།",
    "མདུན་སོག་མོ་དང་།",
    "དགེ་རབ་སོག་མོ་ཚང་གི་མཁར་གཞིས་རྩ་མེད་བཏང་བ་དང་།",
    "གང་དེའི་ལྕམ་མོ་གར་ཕུ་ཉི་ཁྲི་ལས་སྲས་གཉིས་བྱོན་པའི་ཆེ་བ་ས་སྐྱ་པན་ཆེན་ཕྱི་ལོ་༡༡༨༢ དང་།",
    "བཙུན་མོ་གསུམ་པ་གུང་ཐང་ལྷ་གཅིག་མཛེས་མ་ལ་ལྕམ་སྲིང་བསོད་འབུམ་དང་།",
    "ཡང་བཙུན་མོ་བཞི་པ་གཡའ་ལུང་ལྕམ་ལ་སྲས་མོ་གཅིག་བྱུང་།",
    "ཡེ་ཤེས་འབྱུང་གནས་ཁོང་ཉིད་དགུང་ལོ་༢༥ ཐོག་གསང་བའི་སྒོ་ནས་བཙུན་མོ་ཕབ་སྨད་འབུམ་མེ་ལ་བདག་ཉིད་ཆེན་པོ་བཟང་པོ་དཔལ་སྐུ་འཁྲུངས།",
    "མགོ་ལོག་ཁག་གསུམ་ཁོངས་སོ་སོར་རང་སྡོད་རང་དཔོན་རང་མོས་སུ་གནས་པ་བཟོས་པ་དང་།",
    "གོང་གི་དཔོན་ཁག་༢༥ བེ་ཧུའུ་ཞེས་པ་བརྒྱ་དཔོན་དུ་གོ་བ་ཡིན་པ་བཅས་ཆེན་པོ་ཧོར་གྱི་གོ་མིང་དུས་ད་ལྟ་ཡང་གནས་ཡོད་པ་ཡིན།",
    "ཧོར་རྒྱལ་པོ་གོ་དན་ཁང་གིས་འཇིག་རྟེན་འདིའི་སྟོབས་དང་གཟི་བརྗིད་ནི་ཇིང་གིར་ཁང་ལས་ལྷག་པ་སུ་ཡང་མེད།",
    "ཁྱོད་མགྱོགས་པོར་ཤོག་ཉི་མ་ནུབ་ཕྱོགས་ཀྱི་བན་དེ་རྣམས་ལ་ཁྱོད་ཤེས་སུ་འཇུག་པ་ཡིན་ཞེས་འབུལ་རྟེན་མང་པོ་དང་འབྲེལ་གདན་འདྲེན་དུ་ཧོར་གྱི་དམག་དཔོན་རྡོར་སྲི་མགོན་དང་།",
    "འགའ་རེས་ཤར་ཆེན་ཤེས་རབ་འབྱུང་གནས།",
    "རྔ་མོང་གི་བགྲོད་ལམ་ཧོར་དམག་དང་བཅས་ཏེ་དགུང་གྲངས་༦༥ སོན་པར་ཕྱི་ལོ་༡༢༤༦ བོད་མེ་རྟ་ལོའི་ཟླ་༨ པར་བྱང་ཕྱོགས་ལིང་ཆུ་ཞེས་པར་ཞབས་སོར་འཁོད།",
    "ལྕོང་མོ་བཅས་མང་པོ་ཞིག་མདུན་དུ་བཅར།",
    "དེ་ཙམ་མ་ཟད་སྔར་རྒྱ་ནག་ཐང་གི་རྒྱལ་ས་ཤིང་ཨན་ནས་རི་བོ་རྩེ་ལྔ་དང་།",
    "དེ་ནས་གླང་ཆེན་འགྱིང་རི་སོགས་སུ་ཁུ་དབོན་གསུམ་ཀ་འབྲལ་མེད་དུ་གནས་གཟིགས་དང་།",
    "དེ་ནས་ཧོར་རྒྱལ་པོ་གོ་དན་ཁང་གིས་དམག་དཔོན་དོར་རྟ་ནག་པོ་སླར་ཡང་བོད་དུ་བཏང་སྟེ།",
