    "སྒྲ་དང་དོན་དག་ལ་ངོ་བོ་ཉིད་དམ་དེ་འབྱུང་གི་འབྲེལ་པ་འགའ་ཡང་མེད་པའི་ཕྱིར་དང་།",
    "བདག་གིས་མ་བྱས།",
    "མཁས་པ་རྣམས་ནི་ཐམས་ཅད་གཟིགས་པའི་གཟིགས་པ་ལོག་པས་ནི་ཐམས་ཅད་ན་མེད་པར་གོ་བར་བྱེད་དོ།",
    "དེ་ལྟ་བས་ན་གཞན་ཕྱི་རོལ་པ་དག་གི་ལུགས་རྣམ་པར་གཅད་པར་བྱ་བའི་ཕྱིར་བསམས་ཤིང་དོན་དམ་པ་ན་ཞེས་བྱ་བའི་ཁྱད་པར་ཉེ་བར་བཀོད་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "མཁས་པ་དང་བུད་མེད་བྱིས་པའི་བར་དག་ལ་ཡོངས་སུ་གྲགས་པ་ལས་འདས་ཏེ་རྣམ་པར་རྟོག་པ་དག་ཡིན་པའི་ཕྱིར་རོ།",
    "དོན་དུ་མོས་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་དོན་དུ་མོས་པ་དང་བྲལ་བ་དག་ལ་ནི་དོན་དམ་པའི་ཁྱད་པར་སྦྱར་ཏེ་དགག་པར་བྱ་བ་ཅུང་ཟད་མེད་དེ།",
    "ལུང་གིས་གནོད་པ་ནི་གཉི་ག་ལ་གྲུབ་པའི་ལུང་ཁོ་ན་ཡིན་མི་དགོས་ཀྱི།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ནི་ཐམས་ཅད་དུ་རང་ལ་གྲུབ་པ་ཉིད་བརླིང་བར་འགྱུར་ཏེ།",
    "དོན་དམ་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་མཚན་ཉིད་དུ་ན་དངོས་པོ་གང་དག་གི་སྐྱེ་བ་འདི་ཉིད་རང་བཞིན་མེད་པའི་མཚན་ཉིད་དུ་ཉེ་བར་བསྟན་ཏེ།",
    "ཅིའི་ཕྱིར་ན་ཀུན་རྫོབ་པ་དང་དོན་དམ་པ་དག་གི་མཚན་ཉིད་དག་ལ་དེ་ཁོ་ན་ཉིད་ཅེས་བྱ་བའི་བླ་དྭགས་སུ་གདགས་པ་ཉིད་ཀྱིས་བསྟན་པར་མཛད་ཅེ་ན།",
    "དཔེར་ན་ཆུའི་ཚ་བ་དང་ཀེ་ཀེ་རུ་ལ་སོགས་པ་མེ་དང་སྒྱུར་མཁན་དག་གིས་ཚ་བ་དང་པདྨ་རཱ་ག་ལ་སོགས་པའི་དངོས་པོར་བྱས་པ་དག་ནི་རང་བཞིན་ཞེས་བྱ་བར་མི་འདོད་ལ།",
    "རང་བཞིན་ཞེས་བྱ་བ་དེ་ནི་རང་གི་ངོ་བོ་ཉིད་དམ་རང་གི་མཚན་ཉིད་ལ་གྲགས་པས།",
    "འདུས་པ་རྣམས་ནི་ཕན་ཚུན་ལྟོས་པ་དང་བཅས་པས་རང་གི་ངོ་བོ་ཐ་དད་དུ་མེད་པའི་ཕྱིར་དང་།",
    "འདི་ནི་འབྲེལ་པ་ཙམ་མོ་ཞེས།",
    "འབྲེལ་པ་དག་ནི་ནང་གི་ཡིན།",
    "རང་ལ་ཇི་ལྟར་གྲགས་པའི་འཐད་པ་དག་གིས་དེ་ཁོ་ན་ཉིད་མི་ཤེས་པའི་སྐྱེ་བོ་རྣམས་ལ་ཕན་བཏགས་པ་དག་མཐོང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཕྱིར་ངོ་བོ་ཉིད་ཀྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ནི་ཚིག་དང་མཚན་མ་དག་གི་སྤྱོད་ཡུལ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་ལྷུང་བར་འགྱུར་བ་དག་སྟོན་པར་མི་མཛད་དོ།",
    "མིང་དང་གཟུགས་རྣམ་པར་འཕེལ་བ་ནི་དྲུག་གི་སྐྱེ་མཆེད་དོ།",
    "རེག་པའི་རྗེས་ལས་སྐྱེས་པ་ནི་ཚོར་བའོ།",
    "འཆི་ཞིང་འབྲལ་བའི་ཚེ་མོས་ཤིང་ཆགས་པར་གྱུར་པའི་སེས་ལ་ཡོངས་སུ་གདུང་བ་ནི་མྱ་ངན་ནོ།",
    "མིང་དང་གཟུགས་འགགས་པས་དྲུག་གི་སྐྱེ་མཆེད་འགག་སྟེ།",
    "དྲུག་གི་སྐྱེ་མཆེད་འགགས་པས་རེག་པ་འགག་སྟེ།",
    "དྲུག་གི་སྐྱེ་མཆེད་ཀྱི་རྐྱེན་མེད་པས་རེག་པ་ཉེ་བར་ཞི་ཞིང་རྒྱུན་མི་འཆད་པར་རྟོན་པ་མེད་པའོ།",
    "རེག་པ་འགགས་པས་ཚོར་བ་འགག་སྟེ།",
    "རེག་པའི་རྐྱེན་མེད་པས་ཚོར་བ་ཉེ་བར་ཞི་ཞིང་རྒྱུན་མི་འཆད་པར་རྟོན་པ་མེད་པའོ།",
    "རང་བཞིན་གྱིས་བྱེད་པ་པོ་དང་ཚོར་བ་པོ་མེད་པར་རབ་ཏུ་རྟོག་གོ།",
    "བྱེད་པ་པོ་དང་ཚོར་བ་པོའི་འདུ་ཤེས་དང་བྲལ་བ་དང་།",
    "དཔེར་ན་བྲམ་ཟེ་ནས་འབྲས་ཤིན་ཏུ་དཀོན་པ་ན་སྲོག་གི་ཕྱིར་ཁྱི་ཤ་ཟ་བར་བྱེད་དོ།",
    "རང་གིས་འདྲེ་དང་ཐ་དད་མེད།",
    "དེ་ལ་རྣམ་པར་རྟོག་པ་ཞེས་བྱ་བ་ནི་རང་གི་སེམས་སྣང་བ་ཙམ་གྱི་རྗེས་སུ་འབྲང་བ་ཡིན་གྱི་ཕྱི་རོལ་གྱི་དངོས་པོ་མེད་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "དེའི་ཕྱིར་དངོས་པོར་སྨྲ་བ་ཐམས་ཅད་རང་རང་གི་རྟོག་པ་ལ་སྣང་བས་དོན་དགོད་པའི་ཕྱིར་རྟོག་གེ་བ་ཞེས་བྱ་བར་ཡང་བརྗོད་དོ།",
    "འདི་ལྟར་དཔེར་ན་ནོར་བུའི་འོད་ལ་ནོར་བུར་བཟུང་བ་རྣམས་ནི་འཁྲུལ་པ་ཡིན་ཡང་ནོར་བུ་དང་རེག་ཏུ་རུང་བ་ཡོད་པ་བཞིན།",
    "དཔེར་ན་མར་མེའི་འོད་ལ་ནོར་བུར་བཟུང་བ་རྣམས་ནི་འཁྲུལ་པ་ཡང་ཡིན་ཞིང་ནོར་བུ་དངོས་དང་རེག་ཏུ་རུང་བ་དེ་ཡང་མེད་པ་བཞིན།",
    "སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱིས་ཕན་ཚུན་རིག་པར་བྱ་བ་རྟོག་གེའི་སྤྱོད་ཡུལ་དེ་ལྟ་བུ་ནི་གནག་རྫིའི་ཆུང་མ་རྣམས་ལ་ཡང་ཡོངས་སུ་གྲགས་པ་ཞིག་ཡིན་མོད་ཀྱི།",
    "དེ་ལྟར་མི་ཤེས་པའི་བྱིས་པ་རྣམས་ནི་རང་གི་བློ་ལ་སྣང་བའི་སྤྱི་མཚན་རྣམ་པར་རྟོག་པའི་གཟུགས་བརྙན་དེ་ཁོ་ན་ལ་ཕྱི་རོལ་གྱི་དོན་དུ་སེམས་ཤིང་།",
    "དེ་ལས་ཞེས་བྱ་བ་ནི་སྐྱེ་བཞིན་པ་དེ་ཉིད་ཀྱི་བདག་གི་ངོ་བོ་ལས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབྲེལ་པ་མེད་པ་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་གི་ངེས་པ་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ཉིད་ལ་དེ་འབྱུང་གི་འབྲེལ་པ་མ་དམིགས་པའི་ཕྱིར་རོ།",
    "སྦུབས་འཆའ་བ་ལ་སོགས་པ་རྣམས་ཀྱི་སྐྱེ་བ་སྐྱེས་ཟིན་སླར་ཡང་སྐྱེ་བར་ཡོངས་སུ་རྟོག་པའི་ལུགས་འདིར་གཏན་རྙེད་པར་མི་འགྱུར་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "གཞན་ཡང་ས་བོན་ཁོ་ན་སྲིད་པའི་མཐར་ཐུག་པར་རབ་ཏུ་སྐྱེ་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "ཁ་དོག་རོ་ནུས་སྨིན་པའི་ཐ་དད་ཁྱོད་ལ་མེད་པར་འགྱུར།",
    "གལ་ཏེ་སྔར་གྱི་བདག་གི་དངོས་པོ་བསལ་ནས་དེ་ལས་གཞན།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་བོན་མྱུ་གུ་འདིར་གཞན་མ་ཡིན་ན།",
    "ཅི་སྟེ་གྲངས་ཅན་པ་དག་ན་རེ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་ལྟར་གཞན་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་ན་མྱུ་གུས་ཀྱང་ས་བོན་འཇིག་པར་བྱེད་པ་ཉིད་མི་རིགས་ཏེ་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "རྣམ་པར་སྨིན་པའི་ཐ་དད་པ་དག་ཁྱོད་ཀྱི་ལུགས་ལ་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "བོན་རང་གི་བདག་ཉིད་ལ་དམིགས་པ་ལྟར་མྱུ་གུའི་དབྱིབས་ལ་སོགས་པ་རྣམས་ཀྱང་ཐ་མི་དད་པར་དམིགས་པར་འགྱུར་བ་ཞིག་ན་དེ་ལྟར་དམིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་སྔར་ས་བོན་གྱི་བདག་གི་དངོས་པོའི་གནས་སྐབས་དེ་བསལ་ནས་གནས་སྐབས་དེ་ལས་གཞན་ས་བོན་ཉིད་མྱུ་གུའི་ངོ་བོར་འགྱུར་བ་ཡིན་ནོ་སྙམ་ན།",
    "དབྱིབས་ལ་སོགས་པ་མ་བཟུང་བ་ན་དེ་དག་གི་རྫས་བཟུང་བ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ལུགས་ལ་ས་བོན་དང་མྱུ་གུ་དག་གི་ངོ་བོ་འདིར་གཞན་མ་ཡིན་པར་འདོད་ན།",
    "ཇི་ལྟར་མྱུ་གུའི་གནས་སྐབས་ས་བོན་རང་གི་ངོ་བོ་གཟུང་དུ་མེད་པ་དེ་བཞིན་དུ།",
    "མྱུ་གུ་རང་གི་ངོ་བོ་ཞེས་བྱ་བ་དེ་ཡང་གཟུང་དུ་མེད་པར་ཐལ་བར་འགྱུར་བའམ།",
    "ས་བོན་དེ་ཡང་གཟུང་དུ་ཡོད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ཡི་ཕྱིར་ཉེས་པར་ཐལ་བར་འགྱུར་བ་ཡོངས་སུ་སྤང་བར་འདོད་པ་དག་གིས་ནི་ས་བོན་དང་མྱུ་གུ་དག་གཞན་མ་ཡིན་ངའདི་ཉིད་ནི་ཁས་བླང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "ཐལ་བར་འགྱུར་བའི་སྐྱོན་བསྟན་པ་དང་།",
    "ཐམས་ཅད་ལས་ཀྱང་ཐམས་ཅད་སྐྱེ་བར་འགྱུར་ཏེ་གང་གི་ཕྱིར།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "ཇི་ལྟར་སྐྱེད་པར་བྱེད་པའི་སཱ་ལུའི་ས་བོན་རང་གི་འབྲས་བུ་སཱ་ལུའི་མྱུ་གུ་ལས་གཞན་ཉིད་ཡིན་པ་དེ་བཞིན་དུ།",
    "དང་པོ་ལ་རྒྱུད་གཅིག་ཏུ་གཏོགས་པ་དང་སྐྱེད་པར་བྱེད་ཡང་ཡིན་པ་ཡོད་པའི་གཏན་ཚིགས་ཀྱིས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་ཟློག་མི་ནུས་པར་བསྟན་པ།",
    "ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་ཟློག་མི་ནུས་པར་བསྟན་པ།",
    "གང་དུ་རྒྱུ་དང་འབྲས་བུ་ཅིག་ཅར་བ་ཡོད་པའི་གཏན་ཚིགས་ཀྱིས་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་ཟློག་མི་ནུས་པར་བསྟན་པ།",
    "གང་ཞིག་གང་གིས་རབ་ཏུ་བྱ་བར་ནུས་པ་དེ་ཡི་ཕྱིར་ན་བྱ་བ་དེ་ཉིད་གང་གིས་བྱ་བར་ནུས་པ་དེའི་འབྲས་བུར་ངེས་པར་བརྗོད་པ་ཡིན་ཅིང་།",
    "གཞན་ཉིད་ཐུན་མོང་བ་ཁྱད་པར་དུ་ཡོངས་སུ་མ་བཅད་པ་ལ་ཤིན་ཏུ་གྲགས་པ་འདི་ཁོ་ན་ལྟར་གཞན་ཉིད་ཐུན་མོང་མ་ཡིན་པ་ཁྱད་པར་དུ་ཡོངས་སུ་བཅད་པ་ཉིད་ལ་ཡང་མཐོང་བའི་ཕྱིར་རོ།",
    "དེ་ནི་རེ་ཞིག་རྒྱུ་དང་འབྲས་བུ་ཁྱད་པར་ཅན་གྱི་གཞན་ཉིད་དུ་འདོད་པ་དེ་ཉིད་རྟགས་སུ་བཀོད་ནས་མི་འདོད་པ་སྒྲུབ་པས་སུན་འབྱིན་བརྗོད་པའོ།",
    "ཁོ་ན་ཕན་ཚུན་ལྟོས་ནས་གཞན་ཞེས་བྱ་བ་ཉིད་དུ་མཐོང་གི་མྱུ་གུ་དེ་དག་ས་བོན་དང་ནི་དེ་ལྟར་ཅིག་ཅར་དུས་མཉམ་དུ་ཡོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "གང་གི་ཚེ་དེ་ལྟར་ས་བོན་དང་དུས་མཉམ་དུ་མྱུ་གུ་གཞན་པ་ཉིད་མེད་པར་ས་བོན་མྱུ་གུ་ལས་གཞན་པ་ཉིད་དུ་ཡོད་པ་ག་ལ་འགྱུར།",
    "གཞན་ལས་སྐྱེ་བ་ཡོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་འདི་ནི་གཏང་བར་བྱོས་ཤིག་གཉིས་པ་ས་བོན་འགག་པ་དང་མྱུ་གུ་སྐྱེ་བ་དུས་གཅིག་པ་ཡོད་པའི་གཏན་ཚིགས་ཀྱིས་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་ཟློག་མི་ནུས་པར་བསྟན་པ་ནི།",
    "ཇི་ལྟར་སྲང་གི་མདའ་གཉིས་མཐོ་བ་དང་ནི་དམའ་བ་དག།",
    "བསྐྱེད་པར་བྱ་དང་སྐྱེད་བྱེད་དག་གི་སྐྱེ་འགག་འགྱུར་ཞེ་ན།",
    "སྲང་གི་མདའ་གཡས་གཡོན་གཉིས་མཐོ་བ་དང་ནི་དམའ་བ་དག་དུས་གཅིག་པ་ཉིད་དུ་མཐོང་ཞིང་དུས་མཉམ་པ་མ་ཡིན་པར་ནི་མིན་པར་མཐོང་བ་དེ་བཞིན་དུ།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་བྱེད་དག་གི་སྐྱེ་བ་དང་འགག་པ་ཡང་དུས་མཉམ་པར་འགྱུར་ཏེ།",
    "སྲང་མདའི་དཔེ་ལ་མཐོན་དམན་དུས་གཅིག་པ་ཉིད་ཡིན་མོད་ཀྱི།",
    "འགག་བཞིན་པ་ཞེས་བྱ་བ་ནི་འགག་པ་ལ་མངོན་དུ་ཕྱོགས་པ་ད་ལྟར་བ་ཡིན་པས་ཡོད་པ་ཡིན་ཀྱང་འཇིག་པ་ལ་ཕྱོགས་པ་ཡིན་པར་ཁྱོད་ཀྱིས་ཀྱང་འདོད་པར་གྱུར་པ་དེ་ཡི་ཚེ།",
    "ཉེ་བར་བཀོད་པ་ནི་བདེན་མོད་ཀྱི།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་སྐྱེ་བ་ཡོད་པ་བསྟན་པའི་ཕྱིར་མ་ཡིན་ནོ།",
    "མསཁྱོད་ཀྱིས་སྐྱེ་བ་ཐམས་ཅད་ནི།",
    "གསུམ་པ་གང་དུ་རྒྱུ་དང་འབྲས་བུ་ཅིག་ཅར་བ་ཡོད་པའི་གཏན་ཚིགས་ཀྱིས་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་ཟློག་མི་ནུས་པར་བསྟན་པ་ནི།",
    "གལ་ཏེ་མིག་གི་བློ་ལ་རང་གི་སྐྱེད་བྱེད་དུས་གཅིག་པ།",
    "སོགས་པ་རྣམས་དུས་མཉམ་པ་ཁོ་ནར་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་སྐྱེད་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "དེའི་ཕྱིར་ཕན་ཚུན་ལྟོས་པའི་གཞན་ཉིད་དུ་ནི་འགྱུར་མོད་ཀྱི།",
    "གཞན་ཡང་ཡོད་པ་དང་མེད་པ་དག་ནི་ཕན་ཚུན་སྤངས་ཏེ་འགལ་བ་ཡིན་པས་དུས་གཅིག་གི་ཚེ་གཅིག་གི་ངོ་བོ་ཉིད་དུ་སྲིད་པ་ཡང་མ་ཡིན་པས་གཉི་ག་ཡིན་པའི་རང་བཞིན་ཅན་གྱི་དངོས་པོ་ནི་ཡོད་པ་མ་ཡིན་ལ།",
    "ཡོད་པ་མ་ཡིན་པ་དེ་ལ་སྐྱེད་པར་བྱེད་པ་དག་གིས་ཅི་ཞིག་བྱ་བ་ཡོད་དེ།",
    "གཞན་ཡང་གང་གི་ཚེ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "རྟོག་གེ་སྨྲ་བ་རྣམས་ཀྱི་སྐྱོན་སྤོང་གི་གལ་འཛུགས་པ་དང་།",
    "དེས་ན་གཞན་ལས་སྐྱེ་བ་ཡོད་པར་ལྟ་བའི་ལུགས་འདིར་ནི་རིགས་པས་ཅི་ཞིག་གི་ཕྱིར་དགོས་པ་ཡོད་པར་འགྱུར་ཞེ་ན།",
    "རང་གི་མཚན་ཉིད་སྐྱེ་བ་མེད་པ་ལ་བརྟགས་ཏེ་གཞན་ལས་སྐྱེ་བ་མི་རྙེད་པར་བསྟན་པ།",
    "དེ་ལྟར་ན་དངོས་པོ་འཛིན་པ་ལྟ་བུར་སྣང་བ་དོན་གྱི་རྣམ་པར་རྟོག་པ་ཙམ་ཡིན་གྱི་རང་གི་བདག་ཉིད་ཀྱིས་གྲུབ་པ་ནི་མ་ཡིན་པས་རང་བཞིན་གྱིས་འཁྲུལ་པའི་མཚན་ཉིད་ཅན་དུ་གནས་པའི་རྣམ་པར་རྟོག་པ་རྣམས་དང་བྱེ་བྲག་ཏུ་བྱ་བ་ཅི་ཞིག་ཡོད་ཅེ་ན།",
    "རྣམས་ཀྱིས་བདག་ཉིད་ཇི་བཞིན་ཨ་མ་བརྟགས་པ་དང་།",
    "ཇི་ལྟར་མཐོང་བ་བརྫུན་པ་འདི་དག་གི་ཤེས་པ་ཕྱིན་ཅི་ལོག་པ་དང་ཕྱིན་ཅི་མ་ལོག་པ་ཉིད་ཀྱི་སྒོ་ནས་རྣམ་པ་གཉིས་ཡིན་པ་དེ་བཞིན་དུ་དེ་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "དག་གིས་གཟུང་བར་བྱ་བའི་ཡུལ་ཡང་ཡིན་ཏེ།",
    "འཇིག་རྟེན་ཁོ་ནས་དོན་དུ་མོས་པ་མེད་པའི་ཕྱིར་རོ།",
    "མཐོང་བ་བརྫུན་པའི་ངོ་བོ་ཉིད་དུ་འདྲ་ཡང་འཇིག་རྟེན་པ་རྣམས་ཀྱིས་དོན་བྱེད་པ་ལ་སླུ་བ་རྣམས་ནི་ཡང་དག་པའི་དོན་དུ་མོས་པ་མེད་ཅིང་དོན་བྱེད་པ་ལ་མི་སླུ་བ་རྣམས་ནི་ཡང་དག་པའི་དོན་དུ་གྲགས་པ་ཡིན་ནོ།",
    "རྣམ་པར་མི་རྟོག་པའི་བྱེ་བྲག་གི་ཕྱིར་རོ།",
    "ཟག་པ་མེད་པའི་ཡེ་ཤེས་དང་བྲལ་བ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་ཤེས་པས་ཀྱང་གཟིགས་པ་ཟག་པ་མེད་ང་གནོད་པ་མ་ཡིན་ནོ།",
    "ཅིའི་ཕྱིར་ན་དངོས་པོ་རྣམས་ལ་ཡང་དག་པར་ཤེས་པ་གཏི་མུག་གི་རང་བཞིན་ཅན་གང་ཡིན་པ་དེ་ལ་ཀུན་རྫོབ་ཅེས་བྱ་བའི་ཐ་སྙད་ཀྱིས་བསྟན་པ་ཡིན་ཞེ་ན།",
    "རབ་རིབ་ཀྱི་མཐུ་ཡིས་རབ་རིབ་ཅན་རང་གི་ལག་ན་ཐོགས་པའི་བསེ་རུ་དང་དངུལ་ལ་སོགས་པའི་སྣོད་ཀྱི་ནང་ན་སྐྲ་ཤད་དང་སྦྲང་བུ་ལ་སོགས་པའི་ཚོགས་ཡོངས་སུ་འགྱུར་བཞིན་པར་མཐོང་བ་དེ་བསལ་བར་འདོད་ནས་སྣོད་དེ་ལ་ཡང་དང་ཡང་དུ་སྒྲེ་ཟློག་བྱེད་པའི་ཚེགས་ཐོབ་པར་གང་གི་ཚེ་མིག་དག་པས་རིག་སྟེ།",
    "ཡང་གང་གི་ཚེ་རབ་རིབ་ཅན་གྱིས་རབ་རིབ་མེད་པ་ལ་སྐྲ་ཤད་མཐོང་ངོ་ཞེས་ངོ་བོ་ལོག་པ་གང་ཞིག་རྣམ་པར་བརྟགས་ཤིང་རང་གི་བསམ་པ་སྟོན་པར་བྱེད་པ་དེའི་ཚེ།",
    "རབ་རིབ་ཅན་དེའི་རྣམ་པར་རྟོག་པ་བསལ་བར་འདོད་པས་རབ་རིབ་ཅན་གྱི་དམིགས་པའི་ངོར་བྱས་ནས་འདི་ན་སྐྲ་ཤད་དག་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་དགག་པ་ལྷུར་བྱེད་པའི་ཚིག་སྨྲ་མོད་ཀྱི།",
    "དེ་བཞིན་དུ་སྐྲ་ཤད་དག་གི་དེ་ཁོ་ན་ཉིད་ནི་བདག་ཉིད་གང་དུ་མིག་རབ་རིབ་དག་པས་མཐོང་བ་དེ་དེ་ཁོ་ན་ཉིད་ཡིན་གྱི་ཅིག་ཤོས་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་འདིར་ཤེས་པར་གྱིས་ཤིག་ཇི་ལྟར་སྐྲ་ཤད་དག་གི་དེ་ཁོ་ན་ཉིད་ནི་གང་ཞིག་རབ་རིབ་མེད་པས་མཐོང་བ་དེ་ཡིན་གྱི་ཅིག་ཤོས་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "མ་རིག་པའི་རབ་རིབ་ཀྱིས་གནོད་པ་བྱས་པས་དེ་ཁོ་ན་ཉིད་མ་མཐོང་བ་དག་གིས་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ལ་སོགས་པའི་རང་གི་ངོ་བོ་དམིགས་པ་གང་ཡིན་པ་དེ་ནི་དེ་དག་གི་ངོ་བོ་ཀུན་རྫོབ་པ་སྟེ་སླུ་བར་བྱེད་པ་བརྫུན་གྱི་རང་བཞིན་ཅན་ནོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་དེ་དག་གིས་གཟིགས་ཤེ་ན།",
    "བདེན་མོད་ཀྱི།",
    "འོན་ཀྱང་དེ་མ་གཟིགས་པའི་ཚུལ་གྱིས་གཟིགས་སོ་ཞེས་གསུངས་པ།",
    "གང་གིས་སྟོན་པ་དང་།",
    "རིགས་ཤེས་རྗེས་དཔག་གི་དོན་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "སྐྱེ་བ་བཀག་པའི་དོན་དམ་མོ།",
    "དེའི་ཕྱིར་དེ་ཁོ་ན་ཉིད་ལ་འཇིག་རྟེན་པ་དེའི་ཡུལ་ཅན་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་རང་གི་དངོས་པོ་དང་གཞན་གྱི་དངོས་པོ་ལ་སོགས་པའི་ཁྱད་པརདག་སྲིད་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་རང་གི་ངོ་བོ་མ་དམིགས་པའི་ཕྱིར་རོ།",
    "བདག་གིས་བུ་འདི་སྐྱེད་ཅེས་སྨྲ་བྱེད་ཅིང་།",
    "འཕགས་པའི་ལམ་དང་གང་ཟག་མ་ལུས་བཏང་སྙོམས་སུ་བྱ་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལ་འཇིག་རྟེན་པའི་གྲགས་པ་ཞེས་བྱ་བ་ནི་མཁས་པ་དང་གནག་རྫིའི་ཆུང་མ་དག་གི་བར་དུ་གྲགས་པ་རྣམས་སོ།",
    "ཅིའི་ཕྱིར་ན་འཕགས་པའི་གཟིགས་པ་ལ་གནས་པ་དེའི་ཚེ་ན་འཇིག་རྟེན་པའི་གྲགས་པ་ཉིད་ཀྱིས་གནོད་པར་མི་འགྱུར་ཞེ་ན།",
    "བུ་འདི་བདག་གིས་བསྐྱེད་དོ་ཞེས་སྨྲ་བར་བྱེད་དོ།",
    "འདི་རྣམ་པ་དེ་ལྟ་བུ་ཞིག་རང་གི་ལུས་ལས་བཏོན་ནས་དེའི་མའི་ཁོང་དུ་འཛུད་པ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་འདི་དེའི་རྒྱུ་བླུགས་ནས་རང་གི་བུ་སྟོན་པར་བྱེད་པ་དེའི་ཕྱིར་ས་བོན་དང་བུ་གཉིས་གཞན་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བར་འཇིག་རྟེན་དུ་གསལ་བར་ངེས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཨམྲ་ལ་སོགས་པའི་ས་བོན་ཙམ་བཙུགས་ནས་ཨམྲ་སྐྱེས་པ་ན་ཨམྲ་འདི་བདག་གིས་བཙུགས་སོ་སྙམ་དུ་རྟོག་པ་ཡིན་ནོ།",
    "གསུམ་པ་རང་གི་མཚན་ཉིད་སྐྱེ་བ་མེད་པ་ལ་བརྟགས་ཏེ་གཞན་ལས་སྐྱེ་བ་མི་རྙེད་པར་བསྟན་པ་ནི།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་བརྟེན་འགྱུར་ན།",
    "གང་གི་ཕྱིར་བ་མེན་ཡོད་པས་བ་ལང་ཤི་བར་གྱུར་ཀྱང་རྒྱུན་མ་ཆད་པ་ནི་མ་ཡིན་པ་བཞིན་དང་།",
    "ས་བོན་དང་མྱུ་གུ་དག་ཀྱང་གཞན་ཉིད་མ་ཡིན་པའི་ཕྱིར་ན་མྱུ་གུའི་རང་གི་བདག་ཉིད་ཡོད་བཞིན་དུ་ས་བོན་རྒྱུན་ཆད་པ་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་མྱུ་གུ་ས་བོན་ལས་གཞན་མིན་པ་དེ་ཡི་ཕྱིར་མྱུ་གུའི་ཚེ་ན་ས་བོན་ཞིག་པ་མེད་དོ།",
    "གང་གི་ཕྱིར་མྱུ་གུ་དང་ས་བོན་གཅིག་པ་ཉིད་ཡོད་པ་མིན་པ་དེ་ཡི་ཕྱིར་ཡང་མྱུ་གུའི་ཚེ་ན་ས་བོན་ཡོད་ཅེས་བརྗོད་པར་མི་བྱའོ།",
    "གལ་ཏེ་དེ་ལྟར་མ་ཡིན་ཏེ་གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་དངོས་པོ་རྣམས་རང་གི་མཚན་ཉིད་དམ་རང་གི་ངོ་བོའམ་རང་བཞིན་རྒྱུ་དང་རྐྱེན་དག་ལ་བརྟེན་ནས་བསྐྱེད་པར་གྱུར་ན་ནི།",
    "དེའི་ཕྱིར་དངོས་པོ་རྣམས་ཀྱི་རང་གི་མཚན་ཉིད་ནི་ཐམས་ཅད་ཀྱི་ཚེ་སྐྱེ་བར་ཁས་བླང་བར་མི་བྱའོ།",
    "དེ་ལྟ་བས་ན་འདུས་པ་ཐམས་ཅད་ནི་བདག་གི་རང་བཞིན་ཡང་མེད།",
    "རིགས་པ་གང་ཞིག་གིས།",
    "ཁྱོད་ཀྱི་སྐྱེ་བ་གང་གིས་ཡིན་པར་འགྱུར།",
    "དོན་དམ་པར་སྐྱེ་བ་མེད་པས་བདག་དང་གཞན་ལས་སྐྱེ་བ་མེད་ལ་རག་མོད།",
    "གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་གང་དག་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གིས་དམིགས་པ་དེ་དག་གི་རང་བཞིན་ནི་གདོན་མི་ཟ་བར་གཞན་ལས་སྐྱེ་བར་འགྱུར་རོ།",
    "འདི་བདེན་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གཟུགས་དང་ཚོར་བ་ལ་སོགས་པའི་དངོས་པོ་འདི་དག་ནི་ཅི་བདག་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་གསུང་འབུམ།",
    "དེའི་ཚེ་ཁྱོད་ཀྱི་དངོས་པོ་རྣམས་ཀྱི་སྐྱེ་བ་རིགས་པ་གང་གིས་འགྲུབ་པ་ཡིན་པར་འགྱུར།",
    "དེའི་ཕྱིར་རང་གི་མཚན་ཉིད་སྐྱེ་བ་དེ་ནི་བདེན་པ་གཉིས་ཆར་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་མི་འདོད་བཞིན་དུ་ཡང་གདོན་མི་ཟ་བར་ཁས་བླང་བར་བྱ་དགོས་པ་ཉིད་དུ་གྲུབ་པ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་རང་དང་སྤྱིའི་མཚན་ཉིད་དག་གི་རྣམ་པར་གཞག་པ་དེ་དག་ཇི་ལྟར་རིགས་ཤེ་ན།",
    "འོ་ན་ནི་གལ་ཏེ་བདེན་པ་གཉིས་ཆར་ཡང་རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་ཅི་ལྟར་ན་དེ་དག་གི་རང་གི་ངོ་བོ་འཇིག་རྟེན་དུ་དམིགས་པར་འགྱུར་ཞེ་ན།",
    "དངོས་པོ་སྟོང་པ་སྟེ་རང་བཞིན་མེད་པ་གཟུགས་བརྙན་ལ་སོགས་པ་རྒྱུ་དང་རྐྱེན་དག་གི་ཚོགས་པ་ལ་ལྟོས་པ་རྣམས་འཇིག་རྟེན་ན་མ་གྲགས་པ་ཡང་མིན་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དངོས་པོ་རྣམས་གཟུགས་བརྙན་གྱི་རྣམ་པ་ལྟར་རང་བཞིན་སྟོང་པ་དེ་ཉིད་ཀྱི་ཕྱིར་ན།",
    "ཚོན་མོ་སྟེངས་དང་།",
    "ནང་གི་རྒྱུ་དང་རྐྱེན་གྱིས་འདོད་ཆགས་སྐྱེ་བ་དང་རྣམ་པར་གྲོལ་བར་འགྱུར་བ་དང་།",
    "མོངས་པ་དང་ལས་དག་ཡོངས་སུ་ཆོད་པར་འགྱུར་བ་དེ་ཡང་མི་རུང་ངོ།",
    "དེ་ལས་ལྡོག་ན་འཕགས་པའི་མཉམ་གཞག་གི་ཡེ་ཤེས་དངོས་པོའི་འཇིག་རྒྱུར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "ཐ་སྙད་བདེན་པ་དཔྱད་བཟོད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དོན་དམ་པར་སྐྱེ་བ་མི་ཁེགས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་འཇིགས་པ་ལས་ན།",
    "མཐོང་གི་དངོས་གཞན་རྣམ་པར་མ་ཡིན་ལྟར།",
    "གང་དག་གི་ལྟར་ན་འགགས་ཟིན་པའི་ལས་ཀྱི་ནུས་པ་གཞག་པར་བྱ་བའི་ཕྱིར་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པའམ།",
    "གང་དག་གི་ལྟར་ན་ལས་རང་གི་བདག་ཉིད་ཀྱིས་མ་སྐྱེས་པ་དེའི་ཕྱིར་ན་ལས་དེ་འགག་པ་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "དཔེར་ན་མི་ཞིག་ཉལ་བའི་རྨི་ལམ་ན་ཡུལ་གྱི་བུད་མེད་བཟང་མོ་དང་ལྷན་ཅིག་སྤྱོད་པ་རྨིས་ལ།",
    "དེ་ཉལ་བ་ལས་སད་ནས་ཀྱང་ཐོས་པ་དང་མི་ལྡན་པ་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་བླུན་པོ་རྣམས་ལ་ཡུལ་གྱི་བུད་མེད་བཟང་མོ་དེ་དྲན་ནས་ཆགས་པ་སྐྱེ་བར་འགྱུར་བ་ཡང་ཡོད་པ་དེ་བཞིན་དུ།",
    "དེ་བཞིན་དངོས་རྣམས་རང་བཞིན་མེད་མོད་ཀྱི།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་མཐའ་དག་སྤངས་པས་ངར་འཛིན་པ་དང་ང་ཡིར་འཛིན་པ་མ་ལུས་སྤངས་སུ་ཟིན་ཀྱང་བཅོམ་ལྡན་འདས་ཀྱིས་ང་དང་ངའི་ཞེས་བྱ་བ་དག་གིས་བསྙད་པ་ནི་འཇིག་རྟེན་གྱིས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཐབས་ཡིན་པ་དེ་བཞིན་དུ།",
    "དེ་ཁོ་ན་ཉིད་རྟོགས་པ་ཞེས་བྱ་བ་ནི་གང་གིས་དེ་ཁོ་ན་ཉིད་ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བ་དང་།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་ནི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡོངས་སུ་གྲུབ་པའི་མཚན་ཉིད་གང་ཡིན་པ་དེ་ནི་ནམ་མཁའ་གཟུགས་ཀྱི་ངོ་བོ་ཉིད་མེད་པ་ཙམ་གྱིས་རབ་ཏུ་ཕྱེ་བ་དང་ཐམས་ཅད་དུ་སོང་བ་ཇི་ལྟ་བ།",
    "དཀར་པོའི་མཚན་མ་དག་སྣང་བར་གྱུར་པ་གང་དག་ཡིན་པ་དེ་དག་ཐམས་ཅད་གང་ཟག་རབ་རིབ་ཅན་གྱི་མིག་ལ་རབ་རིབ་ཀྱི་སྐྱོན་ཆགས་པ་དག་གི་རྗེས་སུ་འབྲང་གི་གཞན་ལ་རྗེས་སུ་སོང་བ་མེད་པ་དེ་བཞིན་དུ།",
    "ཁམས་གསུམ་པོ་འདི་དག་རང་རང་གི་སེམས་སྣང་བ་ཙམ་གྱི་རྗེས་སུ་འབྲང་བར་འགྱུར་གྱི།",
    "གཞན་གྱི་སྣང་བ་གཞན་ཐམས་ཅད་ལ་རྗེས་སུ་སོང་བ་མེད་པའི་ཕྱིར་དང་།",
    "དེ་ལྟར་དུས་གཅིག་ཏུ་ཡོད་མོད་ཀྱི།",
    "རང་གི་མཚན་ཉིད་ལ་བརྡར་བྱེད་པ་མི་འགྲུབ་པའི་ཕྱིར་དང་།",
    "ལུང་གིས་གནོད་པ་མི་སྲིད་པས་རྣམ་པར་ཤེས་པ་མི་འགྲུབ་པར་བསྟན་པ།",
    "རྣལ་འབྱོར་པ་གང་དག་གིས་ས་གཞི་ཀེང་རུས་ཀྱིས་ཡོངས་སུ་གང་བ་མཐོང་བའི་གཏན་ཚིགས་ཀྱིས་རྣམ་པར་ཤེས་པ་མི་འགྲུབ་པར་བསྟན་པ།",
    "ཡོད་མིན་དེ་ཚེ་ཁྱོད་ཀྱི་དཔེ་ཡོད་མིན།",
    "ཐི་ལྟར་ཁྱོད་ཀྱི་ངས་མཐོང་སྙམ་དྲན་པ།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་ཕྱི་ཡུལ་རྨི་ལམ་དུ།",
    "མིག་དང་མིག་གི་ཡུལ་དང་དེས་སྐྱེད་སེམས།",
    "གང་གི་ཚེ་ང་ལ་བན་གླང་མྱོས་པའི་ཁྱུའི་རྣམ་པ་ཅན་གྱི་རྨི་ལམ་རྨིས་པ་ན་ཡང་སེམས་དེ་ནི་ཡོད་པ་མིན་ཏེ།",
    "དེ་ལྟར་ཡུལ་ཡོད་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་ཡོད་པ་མ་ཡིན་པ་དེ་ཡི་ཚེ་ན་ཁྱོད་ཀྱི་གཉི་ག་ལ་གྲུབ་པའི་དཔེ་ཡོད་པ་མ་ཡིན་པས་ཕྱི་རོལ་མེད་པར་རྣམ་པར་ཤེས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མིག་གི་རྣམ་པར་ཤེས་པ་ཡོད་ན་དེས་གཟུང་བར་བྱ་བ་གླང་པོ་ཆེ་ལ་སོགས་པའི་གཟུགས་རྨི་ལམ་ན་ཡོད་པར་འགྱུར་བ་ཞིག་ཡིན་ན།",
    "གཉིད་ཀྱིས་དཀྲུགས་པའི་ནང་ན་རྣམ་པར་ཤེས་པ་ལྔའི་ཚོགས་མི་སྲིད་པའི་ཕྱིར་མིག་གི་བློ་རྣམ་པ་ཐམས་ཅད་དུ་མི་སྲིད་པས་གླང་པོ་ཆེ་ལ་སོགས་པའི་གཟུགས་མིག་གི་སྐྱེ་མཆེད་ཀྱིས་གཟུང་བར་བྱ་བ་དེ་ཡོད་པ་མིན་ལ།",
    "མིག་གི་ཡུལ་དང་།",
    "མིག་དང་མིག་གི་ཡུལ་དེས་བསྐྱེད་པའི་སེམས་དང་གསུམ་པོ་ཐམས་ཅད་ཀྱང་ནི་བརྫུན་པ་ཡིན་ནོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་བཞིན་འདུས་པ་རེ་རེར་ཡང་།",
    "རིབ་བཅས་པའི་བློ་གང་གིས་རབ་རིབ་ཀྱི་སྐྱོན་ཆགས་པ་དེའི་ལས་སྐྲ་ཤད་རྣམས་གང་ཞིག་མཐོང་བ་དེ་ཐམས་ཅད་རབ་རིབ་ཅན་དེ་ཉིད་ཀྱི་བློ་ལ་ལྟོས་ནས་སྐྲ་ཤད་ཀྱི་རྣམ་པ་ཡོད་པ་ཡིན་པས་ཡུལ་དང་རྣམ་པར་ཤེས་པ་གཉིས་ཆར་བདེན་པ་སྟེ།",
    "སྐྲ་ཤད་དེའི་ཡུལ་དང་མིག་ནི་རྗེས་སུ་འབྲེལ་བའི་རབ་རིབ་ཅན་གྱིས་མཐོང་བ་གང་ཡིན་པའི་ཡུལ་དེ་ལ་རབ་རིབ་མེད་པས་མིག་གཏད་པ་ལའང་སྐྲ་ཤད་དག་གི་བློ་སྐྱེ་བ་ཡོད་པར་འགྱུར་དུ་རུང་བ་ཞིག་ཡིན་ན།",
    "མོ་གཤམ་བུ་ལའང་དེ་ནི་ཡོད་པར་ཐལ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "རྣམ་པར་ཤེས་པའི་བག་ཆགས་སྔར་བཞག་པའི་ནུས་པ་སྨིན་པ་ཡོད་པ་དང་སྨིན་པ་ཡོད་པ་མ་ཡིན་པ་དག་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དང་མི་སྐྱེ་བ་དག་གི་རྒྱུ་ཡིན་ནོ།",
    "ཆགས་ཡོངས་སུ་སྨིན་པ་ཡོད་པ་དེ་ཁོ་ན་ལ་དེའི་རྣམ་པ་ཅན་གྱི་ཤེས་པ་འབྱུང་གི་གཞན་ལ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་རེ་ཞིག་ད་ལྟར་བ་ཞེས་བྱ་བ་ནི་སྐྱེས་པ་ཡོད་པའི་དངོས་པོ་ཡིན་པས་རྣམ་པར་ཤེས་པ་སྐྱེས་པ་ལ་ནུས་པ་སྲིད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ནུས་པའི་རྣམ་པར་ཤེས་པ་ཞེས་རྣམ་དབྱེ་དྲུག་པའི་དོན་དུ་གྱུར་པ་ཡིན་པ་དེའི་ཚེ་ན་ནི།",
    "གང་གི་ཚེ་ནུས་པ་ལས་རྣམ་པར་ཤེས་པ་ཞེས་རྣམ་དབྱེ་ལྔ་པའི་དོན་དུ་གྱུར་པ་ཡིན་པ་དེའི་ཚེ་ན་ནི།",
    "དེ་ལྟར་ན་རེ་ཞིག་སྐྱེས་པའི་རྣམ་པར་ཤེས་པ་ལ་ནུས་པ་སྲིད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་མ་སྐྱེས་པ་དེ་ནི་རྣམ་པར་ཤེས་པའམ་རྣམ་པར་ཤེས་པ་མ་ཡིན་ཞེས་བྱ་བར་དགག་པ་དང་སྒྲུབ་པ་དག་གི་ངོ་བོས་བསྟན་པར་མི་ནུས་སོ།",
    "གང་གི་ཚེ་དེ་ལྟར་དགག་པ་དང་སྒྲུབ་པའི་ངོ་བོ་དག་གིས་བསྟན་པར་མི་ནུས་པ་དེའི་ཚེ་ན་འདི་ནི་འདིའི་ནུས་པའོ་ཞེས་བྱ་བར་རྒྱུ་གང་གིས་ཁྱད་པར་དང་ཁྱད་པར་གྱི་གཞི་ཉིད་དུ་བྱེད་པར་འགྱུར་ཏེ།",
    "མོ་གཤམ་གྱི་བུ་ལའང་ནུས་པ་དེ་ནི་ཡོད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཚོས་ཟིན་པ་ལ་འབྲས་ཆན་གྱི་མིང་གིས་བསྙད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་ནི་ཁོ་བོ་ཅག་གི་སྨྲ་བའི་རྗེས་སུ་འབྲང་བ་ཉིད་དུ་འགྱུར་རོ།",
    "ཆུ་ཀླུང་གི་རྒྱུན་ལྟར་འདུ་བྱེད་ཀྱི་སྐད་ཅིག་མ་རྒྱུན་ལུགས་སུ་རྒྱུ་དང་འབྲས་བུ་འབྲེལ་བར་འཇུག་པ་དེ་ལ་བྱ་ཞིང་།",
    "གལ་ཏེ་རྫས་ཀྱི་སྐད་ཅིག་དེར་ནི་རྒྱུན་ཅན་ཡིན་པས་ཕན་ཚུན་ཐ་དད་ཡོད་མོད་ཀྱི།",
    "དེ་ལྟར་ཐམས་ཅད་ཐམས་ཅད་ལས་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་ཉེས་པ་འདི་མེད་ཅེ་ན།",
    "བདག་གི་དངོས་པོ་ཕན་ཚུན་ཐ་དད་པ་རྣམས་ནི་ཐ་མི་དད་པའི་རྒྱུན་གྱི་རྟེན་ཉིད་དུ་ཡོད་པའི་གོ་སྐབས་མི་རིགས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་ནུས་པ་སྨིན་པ་ཡོད་པ་དང་ཡོད་པ་མ་ཡིན་པ་དག་གིས་རྣམ་པར་ཤེས་པ་ཡོད་པ་དང་མེད་པ་དག་ཡིན་གྱི་ཤེས་བྱ་ཡོད་པ་དང་མེད་པས་ནི་མ་ཡིན་ནོ་ཞེས་གང་སྨྲས་པ་དེ་ནི་ཚུལ་འདིས་བསལ་བ་ཡིན་ཏེ།",
    "ཕྱི་གཟུང་མེད་པར་རང་གི་ས་བོན་ལས།",
    "གལ་ཏེ་ཁྱོད་ལྟར་རྨི་ལམ་དྲུག་པ་ཡི།",
    "སླར་ཡང་རྣམ་པར་ཤེས་པ་ཙམ་དུ་དེ་ཁོ་ན་ཉིད་ཁོང་དུ་ཆུད་པ་གང་གིས་སྨྲས་པ།",
    "མིག་གི་བློ་སྐྱེ་བ་དེ་ནི་མིག་གི་རྣམ་པར་ཤེས་པའི་བག་ཆགས་གང་ཞིག་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ལ་རྣམ་པར་ཤེས་པ་གཞན་གྱིས་བཞག་པ་དེ་ཉིད་ཀྱི་རང་གི་ནུས་པ་ཡོངས་སུ་སྨིན་པ་གང་ཞིག་ལས་དུས་ཕྱིས་དེའི་རྣམ་པའི་རྗེས་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "མྱུ་གུ་ལ་སོགས་པའི་རྒྱུན་རང་གི་ས་བོན་གྱིས་འཕངས་པའི་ནུས་པ་དང་རྗེས་སུ་འབྲེལ་བ་ལས་རྣམ་པ་ཁྱད་པར་ཅན་ཉིད་དུ་སྐྱེ་བར་དམིགས་པ་དེ་བཞིན་དུ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེ་ཡི་ཕྱིར་རྨི་ལམ་དུ་ཡང་རྣམ་པ་དེ་ལྟ་བུའི་ཡུལ་དེ་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རྟེན་དུ་གྱུར་པ་རྣམ་པ་དེ་ལྟ་བུའི་མིག་དང་གསུམ་ཆར་བརྫུན་པའི་ཡུལ་ཅན་དེ་ཉིད་རྟོགས་པའི་རྒྱུར་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "ཕ་རོལ་པོ་སེམས་ཙམ་དུ་སྨྲ་བ་གང་ཞིག་གིས་སད་པའི་རྣམ་པར་ཤེས་པ་ནི་དོན་གྱིས་སྟོང་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་རབ་རིབ་ཀྱི་དཔེ་དག་གིས་ཀྱང་བརྗོད་པར་བྱ་སྟེ།",
    "ལུང་གིས་གནོད་པ་མི་སྲིད་པས་རྣམ་པར་ཤེས་པ་མི་འགྲུབ་པར་བསྟན་པ་ནི།",
    "ཚོས་ཐམས་ཅད་ནི་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གིས་ངེས་པར་དཀའ་བའི་ཕྱིར་ན་ལུང་གིས་གནོད་པ་ལ་སོགས་པའི་ཉེས་པ་ཡང་སྲིད་པར་འགྱུར་རོ་སྙམ་ན།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "རང་གི་བདག་ཉིད་ཀྱིས་ཡོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་བརྗོད་པར་མི་ནུས་པ་ཡང་མ་ཡིན་ནོ།",
    "རང་ལ་རང་མེད་ན་གཞན་སུ་ལ་ཡང་མེད་པས་བུམ་པ་གཏན་མེད་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་ཤིང་བུམ་པ་བུམ་པས་མི་སྟོང་པར་བདེན་པས་སྟོང་པ་དེ་ནི་གཞན་སྟོང་ཡིན་པས་བུམ་པ་བུམ་པས་སྟོང་པ་ནི་རང་སྟོང་ཡིན་ནོ་ཞེས་སྨྲ་བ་དེ་ནི་གཏན་ནས་མི་རིགས་སོ་ཞེས་སྨྲ་བ་ཡོད་པ་རྣམས་ཀྱང་ལུང་འདི་དག་གིས་ཟློག་པར་བྱེད་དོ་།",
    "དགག་གཞི་དགག་བྱ་བཀག་པ་མ་ལུས་དངོས་པོ་མེད་པ་མ་ཡིན་པས་སྟོང་པ་ཉིད་ཀྱི་དོན་ལ་འགའ་ཙམ་ཡང་ཉེ་བར་མ་སོང་བའི་ཕྱིར་ཏེ།",
    "རྣལ་འབྱོར་པ་གང་དག་གིས་ས་གཞི་ཀེང་རུས་ཀྱིས་ཡོངས་སུ་གང་བ་མཐོང་བའི་གཏན་ཚིགས་ཀྱིས་རྣམ་པར་ཤེས་པ་མི་འགྲུབ་པར་བསྟན་པ་ནི།",
    "སྐྱོན་སྤོང་གི་ལན་ལ་སུན་འབྱིན་བསྟན་པའོ།",
    "འདི་ཡི་ཡོད་པ་གང་གིས་ཤེས་པར་འགྱུར།",
    "རང་གི་བདག་ཉིད་ལ་བྱེད་པ་འགལ་བའི་ཕྱིར་རོ།",
    "སོར་མོའི་རྩེ་མོ་དེ་ཉིད་ཀྱིས་དེ་ཉིད་ལ་མི་རེག་ཅིང་།",
    "ལེགས་པར་བསླབས་པའི་གཡེར་ཞིང་ཡང་ཟོར་ཅན་གྱིས་ཀྱང་རང་གི་ཕྲག་པ་ལ་ཞོན་པར་མི་ནུས་ཤིང་།",
    "མེས་རང་གི་བདག་ཉིད་མི་སྲེག་ལ།",
    "མིག་གིས་རང་གི་བདག་ཉིད་ལ་ལྟ་བ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "རང་གི་གྲུབ་པའི་མཐའ་དང་འགལ་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་སྐྱོན་སྤོང་གི་ལན་ལ་སུན་འབྱིན་བསྟན་པ་ལ།",
    "རང་རིག་པ་ནི་གྲུབ་ལ་རག་མོད་ཀྱི།",
    "གང་ཕྱིར་གང་གིས་ཡུལ་མྱོང་གྱུར་དེ་ལས།",
    "ཇི་ལྟར་མེ་ནི་སྐྱེས་པ་ཉིད་ན་རང་གི་བདག་ཉིད་དང་བུམ་པ་ལ་སོགས་པ་དག་གཉིས་སུ་མི་འཇུག་པར་ཅིག་ཅར་གསལ་བར་བྱེད་ལ།",
    "སྒྲས་ཀྱང་རང་གི་བདག་ཉིད་དང་དོན་དག་གཉིས་སུ་མི་འཇུག་པར་ཅིག་ཅར་སྟོན་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "རྣམ་པར་ཤེས་པ་ཡང་ཉེ་བར་སྐྱེ་བ་ཉིད་ན་གཉིས་སུ་མི་འཇུག་པར་རང་གི་བདག་ཉིད་དང་ཡུལ་སོ་སོར་ཡང་དག་པར་རིག་པར་བྱེད་པ་ཡིན་ནོ།",
    "རང་རིག་པ་ཁས་མི་ལེན་པ་རྣམས་ཀྱི་ལྟར་ན་རང་རིག་པ་མེད་པའི་ཕྱིར་ན་རེ་ཞིག་དེ་ཉིད་ཀྱིས་དེ་ཉམས་སུ་མྱོང་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཤེས་པ་གཞན་གྱིས་ཉམས་སུ་མྱོང་ན་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "སྔོན་པོ་ཤེས་པའི་ཤེས་པ་དེ་ལ་ཡང་མྱོང་བ་པོ་གཞན་ཡོད་པར་བྱ་དགོས་ཤིང་དེ་ལ་ཡང་གཞན་ཞིག་འགྱུར་དགོས་པས་ཐུག་པ་མེད་པའི་སྐྱོན་དུ་ཐལ་ལོ།",
    "རྣམ་པར་ཤེས་པའི་ན་ལུགས་མཐའ་དག་སྐད་ཅིག་མ་དང་པོར་སྔོན་པོ་ཡོངས་སུ་གཅོད་པར་བྱེད་པའི་ཤེས་པ་གཅིག་པོ་དེ་ཉིད་ཀྱི་སྐད་ཅིག་མ་སྔ་མ་སྔ་མ་རྣམས་སྐད་ཅིག་མ་ཕྱི་མ་ཕྱི་མ་དག་གིས་ཡོངས་སུ་གཅོད་པར་བྱེད་པའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་དང་།",
    "དེའི་ཕྱིར་ངས་མཐོང་ངོ་སྙམ་དུ་དུས་ཕྱིས་དྲན་པའི་ཤེས་པ་སྐྱེས་པ་ལས་གང་ལ་དུས་ཕྱིས་གཉི་གའི་ཡུལ་ཅན་གྱི་དྲན་པ་སྐྱེ་བ་ཉམས་སུ་མྱོང་བའི་ཤེས་པས་རང་གི་བདག་ཉིད་དང་ཡུལ་གྱི་བདག་ཉིད་ཉམས་སུ་མྱོང་ཞིང་སྐྱེས་པ་ཡིན་པར་དཔོག་པར་བྱེད་དོ།",
    "འདི་ཡི་ཡོད་པ་གང་གིས་ཤེས་པར་འགྱུར་ཞེས་གང་སྨྲས་པ་དེ་ལ་ལན་འདི་ཉེ་བར་བསྟན་པ་ཡིན་ནོ་ཞེས་སྐྱོན་སྤོང་བར་བྱེད་དོ།",
    "རང་གི་བདག་ཉིད་ལ་བྱེད་པ་འགལ་བའི་ཕྱིར་དེ་ཉིད་ཀྱིས་དེ་མྱོང་བར་འགྲུབ་པ་མ་ཡིན་ནོ།",
    "དེ་ནི་སྒྲ་མི་རྟག་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་ལ་གཏན་ཚིགས་མིག་གིས་གཟུང་བྱ་ཉིད་འགོད་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "སྒྲ་མི་རྟག་པ་ལ་མིག་གིས་གཟུང་བྱ་ཉིད་བཞིན་ནོ་སྙམ་དུ་བསམ་པ་ཡིན་ནོ།",
    "སྟེ་དེ་ལྟར་རྣམ་པར་དཔྱོད་པ་བཏང་ནས་ཀྱང་ཤེས་པས་རང་གི་བདག་ཉིད་དང་ཡུལ་རིག་པར་བྱེད་པ་ཁས་བླངས་ནས་རང་རིག་པ་དེ་ནི་གྲུབ་པ་ལ་རག་ལས་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་གིས་ཡུལ་ཉམས་སུ་མྱོང་བར་གྱུར་པའི་ཤེས་པ་དེ་ལས་དྲན་པ་ཡི་ཤེས་པ་འདི་ཉིད་གཞན་ཞིག་ང་ལ་ཡོད་པ་མིན་པ་དེ་ཡི་ཕྱིར་ང་ཡིས་མཐོང་ངོ་སྙམ་དུ་དྲན་པར་འགྱུར་ཏེ།",
    "དེའི་བྱ་བ་ཡང་ཐ་མི་དད་པ་ཉིད་ཡིན་པས་བྱེད་པ་པོ་དང་ལས་དང་བྱ་བ་གཅིག་ཏུ་ཐལ་བར་འགྱུར་ན།",
    "ཇི་ལྟར་རལ་གྲི་རང་གི་སོ།",
    "གཅོད་པར་མི་བྱེད་སོར་མོ་ནི།",
    "རང་ལ་རེག་པར་མི་བྱེད་ལྟར།",
    "གང་གིས་ན་འདི་ཡོད་པ་མི་རིགས་པ།",
    "ཁྱོད་ལ་མོ་གཤམ་བུས་གནོད་ཅི་ཞིག་བསྐྱལ།",
    "དེ་གཉིས་རྣམ་དབྱེ་གང་གིས་མི་ཤེས་པ།",
    "མོ་གཤམ་གྱི་བུ་ཡང་རྫས་སུ་ཡོད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ཁྱོད་ལ་མོ་གཤམ་གྱི་བུས་གནོད་པ་ཅི་ཞིག་བསྐྱལ་བར་བྱས།",
    "དེའི་ཕྱིར་མོ་གཤམ་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འབུམ།",
    "གང་ཡང་ཀུན་རྫོབ་པ་རྣམས་ལ་རྒྱུ་ཅུང་ཟད་ཀྱང་མེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པ་དེ་གཉིས་ཀྱི་རྣམ་དབྱེ་གང་དག་གིས་མི་ཤེས་པ་དེ་དག་ནི་རྣམ་པར་རྟོག་པ་ཕྱིན་ཅི་ལོག་ཏུ་ཉེ་བར་རྟོག་པས་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་ཤེས་རྡོ་རྗེའི་ལམ་ངན་གོལ་བར་ཞུགས་པ་ཁོ་ན་ཡིན་ནོ།",
    "ཕྱི་རོལ་གྱི་དངོས་པོ་མེད་ལ་རང་གི་སེམས་སྣང་བ་ཙམ་དུ་ཞལ་གྱིས་བཞེས་པའི་དགོས་པ་དང་དགོངས་གཞི་རྣམ་པར་ཕྱེ་བའོ།",
    "ཀུན་རྫོབ་ཀྱང་ནི་བདག་གིས་ཁས་མ་བླངས།",
    "གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་མི་གནོད་ན།",
    "ཁྱོད་དང་འཇིག་རྟེན་འདིར་ནི་རྩོད་གྱིས་དང་།",
    "ཕྱི་ནས་སྟོབས་ལྡན་བདག་གིས་བསྟེན་པར་བྱ།",
    "དེ་སྐད་དུ་ཟློག་པར་བྱེད་པ་དེ་ལ་ཡང་ལུང་དང་རིགས་པ་དག་གི་འཐད་པས་མི་རིགས་པ་མེད་པ་ནི་ཡིན་མོད་ཀྱི།",
    "ཉིད་ཙམ་གྱིས་རབ་ཏུ་ཕྱེ་བ་དང་ཐམས་ཅད་དུ་སོང་བ་ཇི་ལྟ་བ་དེ་ལྟ་བུར་ནི་དོན་དམ་པ་ངོ་བོ་ཉིད་མེད་པ་ཉིད་ལས་ཚོས་བདག་མེད་པས་རབ་ཏུ་ཕྱེ་བ་དང་ཐམས་ཅད་དུ་སོང་བ་གཅིག་བལྟ་བར་བྱ་སྟེ།",
    "བྱིས་པ་ཕྱིན་ཅི་ལོག་གི་བློ་ཅན་རྣམས་ནི་གཟུགས་བརྙན་དེ་དག་ལ་རྣམ་པར་རིག་པ་ཙམ་དེ་ཉིད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་མི་ཤེས་པས་ཕྱིན་ཅི་ལོག་ཏུ་སེམས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་དོན་དམ་པའི་དངོས་པོར་འདོད་པ་དེ་ལྟར་ཀུན་ཀྱང་ནི་བདག་གིས་ཁས་མ་བླངས་ཏེ།",
    "དངོས་པོ་རང་གི་མཚན་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་དོན་དམ་པར་མོས་པ་དེ་ཉིད་ལྡོག་པར་འགྱུར་བའི་འབྲས་བུ་ལ་ཉེ་བར་མཁོ་བའི་ཐབས་དམ་པ་ཡིན་པའི་ཕྱིར་ན་ཀུན་རྫོབ་འདི་དག་རང་གི་མཚན་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་མེད་པ་ཡིན་ཀྱང་རང་གི་མཚན་ཉིད་འདི་དག་ཡོད་དོ་ཞེས་འཇིག་རྟེན་གྱི་ངོར་བྱས་ཤིང་བདག་ནི་རྗེས་སུ་སྨྲ་བར་བྱེད་དོ།",
    "གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་གྱིས་མི་གནོད་པ་ཉིད་ཡིན་ན་འཇིག་རྟེན་ཉིད་ལ་ལྟོས་ནས་ཁྱོད་ཀྱིས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་འདི་ནི་དགག་པར་གྱིས་ཤིག་གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་གྱིས་གནོད་པར་མི་འགྱུར་ན་ངས་ཀྱང་ཁྱོད་ལ་སྟོངས་གདབ་པར་བྱའོ།",
    "གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་གྱིས་ནི་གནོད་པར་གྱུར་པ་ཡང་ཡིན་ཏེ།"
  ]
