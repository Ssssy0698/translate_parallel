    "ཕྱིས་འགྲས་པས་ལན་གླེན་དུ་བྱུང་བས་རྒྱལ་པོ་གཏན་མེད་པ་ཞིག་བྱེད་དགོས་དགོངས་ཙ་ན།",
    "བདེ་གྲོལ་གྱི་ཕྱག་དཔེའི་སྟེང་ནས་ཞུས་སྐབས་གསང་འགྲེལ་འཁྲིད་སྐོར་གྱི་དཔེ་རྣམས་མ་རྙེད་ཅིང་རྗེས་སུ་བཙལ་བས་ཀྱང་མི་འདུག་གསུངས་པ།",
    "ཕྱིས་ཀྱང་རང་བཞིན་གྱིས་བསམ་གཏན་ལ་གནས་པ་ཞིག་བྱུང་ཞིང་།",
    "གདུང་གཅིག་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་ངོ་མཚར་ཅན་ཞིག་བྱོན་འདུག་གསུངས་ཏེ་དེ་ལྟའང་ཀུན་བཟང་གླིང་ན་ཡོད་དོ།",
    "བཟང་པོ་ཞིག་འདུག་གོ་གསུངས་ནས་རྣལ་འབྱོར་པ་ལ་གཏད།",
    "ཞན་རྣམས་གདུང་རྟེན་ནང་དུ་བཞུགས་འདུག་གསུངས་ཏེ།",
    "དུས་ཕྱིས་སློབ་དཔོན་པདྨས་བསམ་ཡས་སུ་གཏེར་དུ་སྦས་པ་ཐོན་པ་ལ་དེ་བཞིན་དུ་བྱུང་བས་ཕྱི་རབས་ལ་དེ་ལྟར་བྱས་པས་ཕན་པར་མཁྱེན་པ་ཡིན་འདུག་ཅེས་གསུངས་བས་སོ།",
    "དེ་ནས་གཙང་དུ་བྱོན་ཙ་ན།",
    "བཏོན་པ་ཡིན་འདུག་གོ།",
    "དེས་གཙང་སྐྱེར་ཕུའི་ཀློག་སྐྱ་སྟོན་པ་ལ་གནང་བ་ཡིན་འདུག་གོ།",
    "དེ་ཡང་རང་གཏེར་ལས།",
    "འོ་སྡོང་མ་ལ་བརྟེན་ནས་ཚེ་ཡི་རིག་འཛིན་བརྙེས་པ་ཞིག་འོང་བར་འདུག་གཏེར་ཁ་འདིའི་ཚེ་སྒྲུབ་ལྕགས།",
    "ར་ཤག་ཅེས་འདྲེན་པར་འདུག་གོ།",
    "བགྲངས་པས་ཤི་འདུག་པ་མ་ལེགས།",
    "རྒྱ་གར་ལྷོ་ཕྱོགས་ཀྱི་གྲུབ་ཐོབ་དངུལ་ཆུ་བེ་རོ་ཙ་ན་ལ་གདམས་པ་དངོས་སུ་གནང་།",
    "ཚེམས་མཆེ་བའི་སྒྲོམ་གྱི་ནང་དུ་སྔར་མེད་པའི་ཏཱ་ལའི་ལོ་མ་ལ་ལི་ཁྲིས་སིངྒ་ལའི་ཡི་གེར་བྲིས་པའི་དཔེ་ཞིག་འདུག་པ་མཁའ་འགྲོ་གནང་བར་གོ་ནས།",
    "བྱུང་བར་འདུག་ཞལ་སློབ་ཀྱང་སྨོས་མ་ཐག་པའི་རྗེ་འབྲི་གུང་པ་རིན་ཆེན་ཕུན་ཚོགསམཛད་པ་ལ་སྐྱོ་བསུན་མེད་པས།",
    "འདི་ནི་ཡི་དམ་དུ་འདུག་སྔོན་རྟ་ཕག་ཡབ་ཡུམ་གྱི་རྣམ།",
    "ཞེས་གསུངས་ཤིང་སྐུ་ལུས་གར་གྱི་རྣམ་འགྱུར་ཤིག་ཤིག་འདུག།",
    "དགྱེས་དགྱེས་ལྟར་འདུག་ཁྱེད་སུ་ཡིན་དྲིས་པས།",
    "པཎ་ཆེན་ཤཱཀྱ་ཤིས་རྗེ་བཙུན་མི་ལ་དེས་རྟགས་དང་ཆོ་ག་བྱས་ན་རབ་ཏུ་བྱུང་བ་མཚན་ཉིད་པ་ཞིག་འོང་བ་འདུག་གསུངས་པ་དེས་ཐུགས་དྲངས།",
    "ཤ་འདི་ནལ་བྱིའི་དུར་ཁྲོད་ན་བྲམ་ཟེ་སྐྱེ་བ་བདུན་པའི་ཤ་འདུག་པས།",
    "བསྟན་སྐྱོང་མ་སོགས་བོད་ཀྱི་ལྷ་འདྲེ་ཆེ་དགུ་ངོས་འཕྲད་པ་ལ་བྱོན་གྱི་འདུག་རྣམས་ཕྱི་ཐག་རིང་བས་སྡུག་བསྔལ་ཆེན་པོ་འདུག་གསུངས།",
    "སྙན་ངག་སྒྲ་དོན་གྱི་རྒྱུན་གང་བརྩམས་ཀྱང་རྩོམ་རྟེན་ལ་མ་བལྟོས་པར་བྲིས་ཚད་སྙན་ངག་ཏུ་ཡོད་པའི་གུ་ཡངས་པོ་འདི་ཡང་རང་ཤེས་ཁོ་ན་ལགས།",
    "བསམ་སྦྱོར་མི་ནག་པ་གཞུང་མ་དང་ཁྱད་ཡེ་མི་འདུག་པ་ལ་བརྟེན།",
    "ཇོ་ཀི་འདིས་སློབ་བསྲུང་ཕྱིར་ཁ་མ་གཏོང་ཙམ་ལས་དཔོན་པདྨའི་སྐུ་རྒྱལ་པོ་ལུགས་ལྟ་བས་ཆོག་མི་ཤེས་པ་སློབ་དཔོན་ཉིད་ཀྱི་ཕྱག་ནས་མ་ཡིན་ཟེར་བ་ཞིག་གུ་རུ་རྒྱལ་པོ་ལུགས་དཔེ་དཀར་གྱིས་བོད་དུ་སྤྲུལ་པ་ཡིན་ཟེར་བའི་རྫུན་ཕུགས་དེ་རུ་ཁྱེར་གདའ་བས།",
    "རཏྣ་གླིང་པའི་གཏེར་མ་དང་དོན་ལ་ཁྱད་ཡེ་མི་འདུག་པས།",
    "ཕྱིར་ལོག་དུས་སུ་སུམ་ཅུར་ཉེ་བའི་གྲངས།",
    "ཐ་དོང་ནས་གཏེར་བཞེས་རྒྱུ་ཞིག་ཡོད་འདུག་ཀྱང་།",
    "སྔགས་པ་འདི་པས་གཏད་བཅུག་པར་འདུག་ཟེར་ཀོང་སྨད་པ་རྣམས་གྲོས་ངན་གླེང་སྐབས།",
    "གླིང་བཞི་འོད་ཀྱིས་འགེངས་པ་ལ་ཁྲི་གདུགས་ཉི་མ་དེ་ཡང་སླེབས་འདུག་སྨྲས་བྱུང་སྨྲོས་དང་།",
    "མ་རིག་མུན་པ་སེལ་བ་ལ་དཀར་གསལ་ཟླ་བ་དེ་ཡང་སླེབས་འདུག་སྨྲས་བྱུང་སྨྱོས་དང་།",
    "གསུངས་པ་ཡོད་འདུག་བཞིན།",
    "ཟེར་བ་འདི་ཁོ་བོ་ཡིན་པར་འདུག་ཁྱེད་ཀྱི་གཏེར་དངོས་གཞི་དེ་ཐོན་ལ་ངེད་ལ་ཡང་ཕན་པར་གདའ་ཞེས་གསུངས།",
    "ཞིང་དག་སྣང་སྐོར་ལུང་བསྟན་མང་པོ་དང་ཟབ་གཏེར་ཀྱང་གཉིས་ཙམ་ཞིག་བཞེས་པ་ཡིན་འདུག་གོ།",
    "གཏེར་སྟོན་དེ་གཉིས་ནི་གཏེར་ཆེན་འདིའི་གཏེར་གཡོག་ཡིན་པར་འདུག་གོ།",
    "ཡབ་གཏེར་སྟོན་བདེ་ཆེན་གླིང་པའི་གདུང་རུས་དང་ཡུམ་ཤར་ཕྱོགས་པཎ་ཆེན་གྱི་རིགས་ལས་སྐུ་བལྟམས་པ་ཡིན་འདུག་ཅིང་།",
    "རྐྱང་ཉག་མ་བརྒྱད་བཞུགས་པས་མཚོན་མཐའ་གཅིག་ཏུ་དེ་དང་དེ་དག་དུས་མཚུངས་ཁོ་ན་ཡིན་ཞེས་སྨྲ་ནུས་པ་མ་ཡིན་པས་ཐོག་སྔ་ཕྱི་ཤེས་སླ་བའི་ཆེད་དུ་ཕྱོགས་མཚོན་འོལ་སྤྱི་ཙམ་ཞིག་བསྒྲིགས་པ་ཡིན་པསགཞན་ཡང་བསྟན་ཞབས་གཏེར་གྱིས་སྐྱོང་བའི་ཕྱིར་སྙིགས་དུས་དེ་ལུགས་དཔྱད་ཤེས་པར་མཛོད་ཅིག།",
    "དེ་ནས་མཁན་ཆེན་ནམ་མཁའ་སེང་གེའི་དུས་ནས་བཀའ་གདམས་པར་འགྱུར་བ་ཡིན་འདུག་དེ་ཡང་གྲུབ་ཆེན་འདི་ཉིད་སྐུ་སྐྱེ་བ་འདིའི་གོང་དུ་སྲིན་ཡུལ་དུ་འཁྲུངས་ཚུལ་བསྟན་ཏེ།",
    "མི་རྣམས་ཀྱིས་འབུམ་པ་ལ་མིས་བསྐོར་བ་བྱེད་ཅིང་འདུག་ཟེར་བ་བྱུང་།་",
    "གང་ཤར་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་པས་གསུམ་ག་ཟུང་འཇུག་ཆེན་པོར་ཤེས་པ་གྱིས་དང་།",
    "ཞེས་སོགས་བྲིས་འདུག་ཀྱང་།",
    "ཅེས་སྔགས་བརྗོད་གནང་འདུག་སྟེ།",
    "གཞན་ཡང་བཀའ་འབུམ་གསུང་མགུར་ཞལ་གདམས་སོགས་པུ་སྟི་ལྔ་དྲུག་ཙམ་བཞུགས་པ་ཡིན་འདུག་གོ།",
    "འོན་ཀྱང་རང་ཕམ་པར་མི་ནུས།",
    "ལུང་བསྟན་འདི་དག་མཛད་པ་དང་མཐུན་པར་ངེས་ཤེས་འདྲོངས་པར་འདུག་པས་ཅུང་ཟད་བསྡུས་ཏེ་བྲིས་པ་ཡིན་ལ།",
    "ཀུན་བཟང་ཤེས་རབ་ཀྱང་འདི་དུས་ཙམ་ལ་ཞབས་ཕྱིར་འབྱོར་བ་ཡིན་འདུག་དེ་ནས་དགུང་ལོ་བཅུ་དགུ་བཞེས་པའི་དུས་སུ་སྨར་ཁམས་ཕྱོགས་ནས་གདན་འདྲེན་བྱེད་པ་འགའ་ཞིག་ཀྱང་བྱུང་བ་དང་།",
    "དགུང་ལོ་ལྔ་བཞེས་དུས་ནས་སེམས་ཀྱི་འགྲོ་འདུག་ངོ་མཁྱེན་ཞིང་བསྐྱེད་རིམ་ཡང་མཁྱེན།",
    "མ་གཅིག་དགེ་སློང་ནམ་མཁའ་རྒྱལ་མཚན་ལ་ཆེད་དུ་བསྩལ་ནས་རྗེ་འདིར་ཕུལ་འདུག་པ་བཞིནསོགས་དགོན་ཆུང་ཞིག་ཏུ།",
    "ངེད་སྔོན་དད་པ་མེད་ཀྱང་ཕྱིས་བཀའ་འབུམ་མཐོང་བས་སྙིགས་དུས་འདིར་དེ་བས་ལྷག་པའི་མཁས་གྲུབ་བྱོན་ཐབས་མི་འདུག་པས་བཤགས་པ་ཕུལ་ནས་དེང་སང་དྲག་ཤུལ་དང་ཉི་གཞོན་གཉིས་ཀར་གུས་ཤིང་ཉི་གཞོན་སྔགས་ཟླ་ཡི་ཡོད་གསུངས་འདུག་པའི་ཆབ་ཤོག་ཐམ་འབྱར་ཁོ་བོའི་སུག་པར་ད་ལྟའང་ཡོད་དོ།",
    "པདྨ་འོད་དང་རང་བཞིན་སྤྲུལ་པ་ནི།",
    "རབ་ཏུ་བྱུང་བ་ཞུས་པ་རྟེན་སྔགས་འཆང་རང་དོན་ཆེ་གསུངས་ནས་མ་གནང་།",
    "མར་གད་ལས་གྲུབ་པའི་རྟ་མགྲིན་གྱི་སྐུ་ཞིག་ཡོད་འདུག་པས།",
