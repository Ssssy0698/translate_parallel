    "དེའི་རུས་བུ་སྦས་པའི་སྟེང་ན་མྱ་ངན་གྱིས་ངུ་ཞིང་འདུག་པ་དང་འཕྲད་ནས།",
    "བདག་འདུག་སའི་གནས་འདིར་གསེར་བུམ་པ་གང་ཡོད་ཀྱིས་ཕྱིར་ལོག་པའི་ལམ་དུ་ཁྱེར་ཅིག་ཅེས་བསྒོའོ།",
    "ཀླུ་ཞིག་རིན་ཆེན་སྣ་བདུན་གྱི་གཞལ་མེད་ཁང་ན་འདུག་པ་མཐོང་ངོ།",
    "གསེར་གྱི་མཁར་ན་འདུག་པའི་ཀླུ་ནི་ཀུན་དགའ་བོ་དང་།",
    "སྟན་ལ་འདུག་ན་གཟི་བརྗིད་དང་མཐུ་དང་ལྡན་པ་དང་།",
    "ཤིང་དེའི་དྲང་དུ་ཆུ་མིག་བཟང་པོ་ཞིག་ཀྱང་འདུག་པས་དེ་ལ་འཐུང་ཞིང་ཁྲུས་བྱས་པ་ན།",
    "དགེ་དོན་སྐྲ་འཛེངས་ཤིང་གདོང་མཆི་མས་གང་བ་དང་གོས་ངན་པ་གྱོན་ཏེ་ཤིང་དྲུང་ན་འདུག་པ་དེ་མཐོང་ནས།",
    "དེར་རྒྱལ་པོ་བལྟར་ཕྱིན་པ་དང་རྒྱལ་བུ་དངོས་སུ་འདུག་པས།",
    "ད་ལྟ་གནས་ཁང་ན་འདུག་གོ།",
    "རྒྱལ་པོ་གཅིག་པུ་ནགས་ཚལ་འཐུག་པོར་ཕྱིན་ནས་རྟ་ལས་བབ་སྟེ་འདུག་པ་ན།",
    "སུ་ཏ་སོ་མ་ཕྱིར་ཁྱིམ་དུ་ཕྱིན་ཙ་ན།",
    "བྲམ་ཟེ་དེ་ཡང་འདུག་པས་རབ་ཏུ་དགའ་ནས་སྦྱིན་པ་བྱིན་ནོ་ བྲམ་ཟེ་དེས་ཀྱང་སུ་ཏ་སོ་མ་རིང་པོར་མི་ཐོགས་པར་སྲོག་དང་བྲལ་བར་འགྲོ་བས་ཕྱིར་ཡུལ་ལ་ཆགས་ན་མི་དགའ་བར་ཤེས་ནས།",
    "ང་སྔོན་རི་ལ་འདུག་སྟེ་འཇིག་རྟེན་ན་མི་དགའ་བ་ལས་ནན་གྱིས་རྒྱལ་པོར་བཅུག་སྟེ།",
    "བདག་ཤིང་གཞན་གྱི་སྟེང་ན་འདུག་ཚེ་སྐད་མི་སྙན་ལ།",
    "གྱོས་པོའི་ཁྱིམ་ན་འདུག་པའི་ཚེ་ཕ་མའི་ཁྱིམ་འདོད་ན་དེ་ཅིའི་ཕྱིར་ཞུས་ཤིག་ཅེས་སྨྲས་སོ།",
    "རྒྱལ་པོའི་ན་བཟའ་ལ་དུད་པའི་དྲི་མ་འདུག་པས་དེས་མཆི་མ་ཤོར་རོ་ཟེར།",
    "གསེར་གྱི་གླང་པོ་ཆེ་དེ་ཡང་རྟག་ཏུ་དྲུང་ན་འདུག་གོ།",
    "འདྲེན་མ་ནུས་པར་འདུག་པ་ན།",
    "དེ་དག་གཅིག་ལ་གཅིག་དགའ་བས་འགྲོ་ན་ཡང་ལྷན་ཅིག་ཏུ་འགྲོ་འདུག་ན་ཡང་ལྷན་ཅིག་ཏུ་འདུག་སྟེ་ཡུལ་མི་རྣམས་ཀྱང་དགའ་ནས་རྗེས་སུ་ཡི་རང་ངོ།",
    "སུ་ནི་ཕོངས་ཤིང་འདུག་སུ་ནི་ཉམ་ང་བར་གྱུར།",
    "དགེ་སློང་རང་ཉིད་ཀྱི་སྔོན་གྱི་གནས་རྗེས་སུ་རྟོགས་པར་བྱས་པས།",
    "དད་པས་ཁྲི་ལས་ལྡང་བར་བརྩམས་པ་དང་སྒུར་བ་དེ་ཡང་རང་སངས་ཏེ་ལུས་སྔ་མ་ཁོ་ན་བཞིན་དུ་གྱུར་ནས་སྟོན་པའི་སྤྱན་སྔར་འདུག་པ་དང་།",
    "ཆུང་མ་དེ་ཤིན་ཏུ་སྐྲག་ནས་ཚེམ་བུ་མཁན་དེ་གཟེབ་གཅིག་དུས་ལ་བབ་པར་དགོངས་ནས་ལྷའི་ཆ་ལུགས་སུ་སྤྲུལ་ཏེ་དེར་བཞུགས་པ་ན།",
    "དོམ་དེ་ཕུག་ན་འདུག་པ་བསྟན་པས་དེ་གཉིས་ཀྱིས་དུག་མདས་བསྣུན་ཏེ་བསད་ཅིང་དེའི་ཚེ་དོམ་གྱིས།",
    "དེ་ན་འདུག་ཀྱང་ཁ་ཅིག་ནི་འཐོབ་ལ་ཁ་ཅིག་ནི་མི་འཐོབ་བོ།",
    "བདག་ཐོངས་ཤིག་དང་ཕྱིན་ཆད་སུ་ལའང་སྦྱིན་པར་མི་བྱེད་ལ་ཕྱིན་ཆད་ཁྱིམ་འདིར་ཡང་མི་འདུག་གོ་ཞེས་སྨྲས་ཀྱང་མ་ཉན་པར།",
    "ཡི་དྭགས་ལུས་ཆེ་ལ་རོ་སྨད་ནི་ཐ་མལ་པར་འདུག་པ་ལ་རྐེད་པ་ཡན་ཆད་ནི་ལུས་གཉིས་སུ་གྱུར་ཏེ།",
    "དེའི་ཚེ་བུ་དེས་ཕའི་རུས་བུ་དེ་བྱ་རྒོད་ཕུང་པོའི་རི་ལས་ཐག་མི་རིང་བ་ཞིག་ཏུ་ཕྱུང་སྟེ་བསྲེགས་ནས་དུར་ཁྲོད་དེ་ཉིད་དུ་འདུག་ཅིང་མྱ་ངན་གྱིས་བྲང་རྡུང་ཞིང་ཆོ་ངེས་འདེབས་པར་བྱེད་དོ།",
    "དེ་ཐོས་པ་དང་རབ་ཏུ་དགའ་ནས་དེར་ཕྱིན་ཏེ་ཞབས་ལ་ཕྱག་བྱས་ནས་འདུག་པ་དང་།",
    "མཆོག་ཟུང་གང་ལས་གཤེགས་པའི་ལམ་དེར་ཞུགས་ནས་མཐར་གྱིས་དེར་ཕྱིན་པས་མཆོག་ཟུང་ལ་ཕྱག་བྱས་ཏེ་གཏམ་སྨྲ་ཞིང་འདུག་པ་ན།",
    "དེ་དག་སེར་སྣ་སྐྱེས་ནས་ཀྱང་ སེམས་ནི་ཀུན་ནས་དཀྲིས་ཤིང་འདུག།",
    "དེ་དག་སྐྲག་སྟེ་རང་རང་འདོད་པའི་ལྷ་ལ་གསོལ་བ་བཏབ་པ་ན།",
    "སེམས་དད་པར་བྱས་ཏེ་སྤྱན་སྔར་འདུག་གོ་དེར་བཅོམ་ལྡན་འདས་ཞལ་འཛུམ་པར་མཛད་པས།",
    "ནམ་ཞིག་བྲམ་ཟེ་དེ་ཁང་སྟེང་དུ་འདུག་པ་ན།",
    "དེ་ནས་གདོལ་པའི་ཁྱེའུ་དེས་འཕགས་པ་ལ་ཕྱག་བྱས་ནས་འདུག་པ་ན།",
    "དེས་ཡིད་བྱེད་ཀྱི་ལུང་ཕོག་པས་ནག་པོས་ཀྱང་བསམ་གཏན་བཞི་དང་མངོན་ཤེས་ལྔ་ཐོབ་སྟེ་དྲང་སྲོང་རྒན་པོ་ཤི་བའི་འོག་ཏུ་གནས་དེར་འདུག་པར་བྱེད་དོ།",
    "དེ་ནས་གནོད་སྦྱིན་དེ་རང་གནས་སུ་ཕྱིན་ཏེ་འདུག་པ་ན་དྲང་སྲོང་ནག་པོ་དེ་ཞག་བདུན་ན་འཆི་བར་མཐོང་ནས།",
    "ད་དུང་འདིར་འདྲ་ཁ་ཤས་སྣང་ཡང་རང་སར་བཞག་ཡོད།",
    "ནམ་ཞིག་ན་རྒྱལ་པོ་ཚངས་བྱིན་གཡུལ་ཕམ་ནས་གཅིག་པུར་བྲོས་པས་ཐར་ནས་ནགས་ཁྲོད་གཅིག་ཏུ་ཞུགས་ཏེ་རྟ་ལས་བབ་སྟེ་འདུག་པ་ན།",
    "སྟན་ཕྱེད་འདི་ལ་འདུག་ཅིག་ཅེས་སོགས་གསུངས་ཏེ་སྟན་གྱི་ཕྱེད་བསྟབས་པས་ཐམས་ཅད་འགྱོད་ཅིང་ངོ་མཚར་དུ་གྱུར་ཏོ།",
    "འབབ་ཆུ་དྲག་པོ་ཞིག་ཡོད་པའི་ནང་དུ་ཁྱུ་མཆོག་རང་ཉིད་འདུག་སྟེ་ཟམ་པ་བྱས་ནས་དེའི་སྟེང་དུ་ཐམས་ཅད་བྲོས་སུ་བཅུག་པས།",
    "ཤུལ་དུ་རི་དྭགས་གཅིག་ལུས་འདུག་པ་དེ་མཐོང་ནས་དེ་ཡང་འབད་པས་ཕ་རོལ་དུ་བསྒྲལ་ཏེ་དེའི་འོག་ཏུ་རང་ཉིད་ཚེའི་དུས་བྱས་སོ།",
    "མཉན་ཡོད་ན་གནས་པའི་སྐྱེ་བོ་མང་པོ་དག་དུས་དུས་སུ་དེ་ལ་བལྟར་འགྲོ་ཞིང་།",
    "ངས་ནི་འཕྱེ་བོ་ཁྲི་ལ་འདུག་པ་ཁྱེད་རྣམས་ལ་ཅི་རྙེད་པ་བསྒྲུབས་ཏེ་བྱིན་ན་ཁྱེད་ཀྱིས་བདག་གཅིག་པུ་ལ་མི་ཟེར་བར་མང་པོའི་ནང་དུ་དམའ་ཕབ་བོ་ཞེས་བྱས་སོ།",
    "བདག་ནི་གཅེར་བུར་འདུག་པས་དེ་དག་དང་མངོན་སུམ་དུ་ཕྲད་པར་འགྲོ་མི་ནུས་སོ་སྙམ་སྟེ།",
    "སྲོག་ཕངས་པ་སྤྲིན་པར་མཛད་དུ་གསོལ་ཞེས་ཟེར་ཞིང་འདུག་པ་ན་རྨི་ལམ་སད་པར་མཛད་པས།",
    "ཁྱེད་ཀྱང་དེའི་འདབས་སུ་འདུག་སྟེ།",
    "བདག་གཉིས་ནི་འདི་ན་འདུག་བཞིན་དུ།",
    "རང་རང་གང་ལ་དགའ་བ་དེའི་བསྔགས་པ་བརྗོད་པར་བྱེད་པ་ལས།",
    "གཙུག་ལག་ཁང་དུ་འདུག་བཞིན་དུ་དེས་རྒྱུན་ཞུགས་ཀྱི་འབྲས་བུ་ཐོབ་ཅིང་།",
    "ཕ་ཕ་ཞེས་བརྗོད་ཅིང་ཞབས་ལ་ཕྱག་བྱས་ཏེ་སྐུའི་དྲུང་ན་འདུག་གོ།",
    "དེས་ཀྱང་ཡུལ་དེ་ཆམ་ལ་ཕབ་སྟེ་འདུག་པ་ན།",
    "འདུག་པ་དང་།",
    "ས་ཆེན་པོ་འདི་ཆ་བདུན་དུ་བགོས་པའི་ཆ་དྲུག་པོ་རྒྱལ་རིགས་གཞོན་ནུ་དྲུག་པོ་དེ་ལ་བྱིན་ཅིང་རང་རྒྱལ་སྲིད་ལ་བཀོད་ནས་ཆ་གཅིག་པོ་དེ་རྒྱལ་པོ་རྡུལ་རང་ཉིད་ཀྱིས་བཟུང་ངོ།",
    "དེ་བློ་གསལ་བར་གྱུར་པ་ཁྱིམ་གྱི་ནང་ན་འདུག་བཞིན་དུ་བསྟན་བཅོས་རྣམས་བསླབས་སོ།",
    "དེ་གཉིས་རང་རང་འདོད་ཕྱོགས་ལྟར་གྱིས་ཆེ་བ་བརྗོད་ནས་བདོག་པ་ཐམས་ཅད་ཡལ་བའི་སྐུགས་ཀྱི་གཏའ་བཞག་གོ།",
    "བྱེ་སྟོངས་ཤིག་ཏུ་ཕྱིན་ཏེ་དེ་དག་རྒྱགས་ཟད་ཅིང་ངལ་ཞིང་དུབ་སྟེ་ཉི་ཚན་གྱིས་གདུང་ནས་ཉ་བྱེ་ཚན་དུ་བོར་བ་ལྟར་གྱུར་ཏེ་ཤིན་ཏུ་སྡུག་བསྔལ་ཞིང་ཉམ་ཐག་པས་གུ་ལང་ལ་སོགས་པ་རང་རང་འདོད་པའི་ལྷ་རྣམས་ལ་བོས་ཀྱང་ཅུང་ཟད་ཀྱང་སྐྱོབ་པར་བྱེད་པ་མ་བྱུང་བས།",
    "སྐྱེ་དགུ་ལ་བྱམས་པ་ཞིག་སྟེ་དེས་རྒྱལ་ས་ལ་འདུག་ན་ཉེས་པ་མང་བར་མཐོང་ནས་རྒྱལ་པོ་ལ་གསོལ་ཏེ།",
    "ངོ་ཚ་ཞིང་གདོང་སྨད་དེ་གནས་དེར་འདུག་པ་ན།",
    "དེ་ལྟ་བུའི་སྡུག་བསྔལ་མི་བཟད་པ་མྱོང་ཞིང་འདུག་གོ་གསུངས་སོ། ཡང་བཅོམ་ལྡན་འདས་འོད་མའི་ཚལ་ན་བཞུགས་པའི་ཚེ།",
    "བདག་ནི་གཅེར་བུར་འདུག་པས་ངོ་ཚ་སྟེ་མི་ནུས་སོ།",
    "རུས་པ་པགས་པ་སྐྱི་རྣམས་ད་དུང་འདུག།",
    "ཡི་དྭགས་དེས་དེ་ལྟར་གཤེགས་པ་མཐོང་ནས་བཅོམ་ལྡན་འདས་ལ་སེམས་དགའ་བ་སྐྱེས་ཤིང་རང་ཉིད་ངོ་ཚ་བར་ཡང་གྱུར་ཏོ།",
    "རང་རང་འདོད་པའི་ལྷ་ལ་འབོད་པར་བྱས་ཀྱང་སྐྱབས་བྱེད་པ་ནི་སུ་ཡང་མ་བྱུང་ངོ།",
    "གནས་གང་དང་གང་དུ་ཡང་བདེ་བར་འདུག་ཏུ་ཡོད་དོ་ཞེས་དགའ་བའི་ཚིག་ལན་གསུམ་དུ་བརྗོད་པར་བྱེད་དོ།",
    "གཅིག་པུར་འདུག་པ་ནི་དགའ་བར་བྱ་དཀའོ།",
    "སོ་སོའི་སྐྱེ་བོར་འདུག་བཞིན་དུ།",
    "དེའི་དུས་ཀྱི་དགེ་སློང་གཞོན་ནུར་གྱུར་པ་དེ་ནི་དགེ་སློང་རྒན་པོ་འདི་ཡིན་ཏེ་ལས་དེས་ལོ་དྲུག་ཅུའི་བར་དུ་མའི་ལྟོ་ན་འདུག་གོ།",
    "ཞེས་སྨྲས་ནས་ཅང་མི་ཟེར་བར་འདུག་གོ།",
    "གནས་གཞི་དང་ལྡན་པ་ཞིག་འདུག་པར་གྱུར་ཏོ།",
    "གང་ལའང་ལོག་པར་མི་འཇུག་འདུག་གོ།",
    "མེ་ཏོག་ཀུན་ད་ལྟར་འདུག་པ་དང་།",
    "ཚེ་འདི་ལ་མིག་ཡོན་པོར་འདུག་པ་ནི་སྔོན་ལོག་པའི་སེམས་ཀྱིས་གཞན་གྱི་ཆུང་མ་ལ་བལྟས་པ་ལས་འོངས་སོ།",
    "འདུག་ཀྱང་རུང་།",
    "འགྲོ་བ་དང་ནི་འདུག་པ་ན།",
    "བཟོ་དང་ཡི་གེའི་གཟུགས་སུ་འདུག།",
    "འཆག་དང་འདུག་དང་འགྲེང་དང་ཉལ་བ་དང་།",
    "ཏག་ཏག་རན་མིན་གྱི་ཐག་གཅོད་ནི་སེང་གེ་ཁོ་རང་ཉིད་ཀྱིས་བྱ་རྒྱུ་ཡིན་ཞེས་ཆ་རྐྱེན་ཞིག་ཀྱང་བཏོན།",
    "ཏག་ཏག་རན་མིན་གྱི་ཐག་གཅོད་ནི་སེང་གེ་ཁོ་རང་ཉིད་ཀྱིས་བྱ་རྒྱུ་ཡིན་ཞེས་ཆ་རྐྱེན་ཞིག་ཀྱང་བཏོན།",
    "ཅོད་པན་དེ་ངའི་མགོར་རན་པོ་གང་འདྲ་མི་འདུག་གམ།",
    "ཅོད་པན་དེ་ངའི་མགོར་རན་པོ་གང་འདྲ་མི་འདུག་གམ།",
    "ཚང་མ་རང་རང་སོ་སོའི་སྐྱེ་སའི་གོ་གནས་ཀྱི་བབས་དང་བསྟུན་ནས་འགྲོ་དགོས།",
    "མི་རིང་བར་གླང་ཆེན་ཁྱུ་ཞིག་ཕར་ཙམ་ནས་ཆུ་འཚོལ་དུ་འགྲོ་བཞིན་ཡོད།",
    "མི་རིང་བར་གླང་ཆེན་ཁྱུ་ཞིག་ཕར་ཙམ་ནས་ཆུ་འཚོལ་དུ་འགྲོ་བཞིན་ཡོད།",
    "ཡུད་ཙམ་རྗེས་མིས་ལྷགས་པ་ལ་ཡང་ཡག་པོ་མི་འདུག་ཅེས་སྐྱོན་བརྗོད་བྱེད་འགོ་ཚུགས།",
    "ཡུད་ཙམ་རྗེས་མིས་ལྷགས་པ་ལ་ཡང་ཡག་པོ་མི་འདུག་ཅེས་སྐྱོན་བརྗོད་བྱེད་འགོ་ཚུགས།",
    "དེར་ཁྱེད་རང་བྱུས་ཏོག་བྱེད་དགོས་དོན་མེད།",
    "དེར་ཁྱེད་རང་བྱུས་ཏོག་བྱེད་དགོས་དོན་མེད།",
    "ཇི་ལྟར་དུས་གསུམ་མགོན་པོ་ཞེས་པ་འདི་གཉིས་ཀྱང་རང་བཞིན་ཚིག་གཤར་འགྲོས་སུ་བཏོན་པ་ཙམ་མ་ཡིན་པའི་ཚིག་དོན་ལ་གོ་བ་ཆགས་པ་དང་།",
    "འདིར་ཡང་རང་ཉིད་ཙམ་མ་ཡིན་པས།",
    "གསོལ་ཇ་མཆོད་ཚར་ནས་རང་རང་ཁང་པའི་ཐོག་ཁར་དར་འཛུགས་དང་།",
    "ཁོང་ཡང་མེ་མདའ་རིང་ཐུང་གཉིས་འཁྱེར་ནས་འཕན་པོར་བྲོས་འདུག།",
    "ཤུལ་ལུས་ཀྱི་ཕྲུ་གུ་གཉིས་ཀྱང་མུ་གེས་ཤི་སྟེ་ནང་མི་གཅིག་ཀྱང་མ་ལྷག་པར་ཁྱིམ་ཚང་སྟོང་འདུག།",
    "ཕྱི་ལོ་༡ལོར་འདས་གྲོངས་སུ་གྱུར་འདུག།",
    "གཞན་ཡང་ཁོ་རང་གྲོགས་པོ་གྲོགས་མཆེད་ལ་ཡིད་ཆེས་ཆེན་པོའི་སྒོ་ནས་དགའ་པོ་བྱེད་མཁན་ཞིག་ཡིན་པས་མི་ཕལ་ཆེར་གྱིས་ཡིད་ཆེས་བློས་འགེལ་བྱེད་ས་ཞིག་ཡིན།",
    "བུ་ཆུང་དེ་ཡང་ཟས་མེད་གོས་མེད་གཅེར་བུ་མུ་གེས་ཤི་འདུག།",
    "གཞན་ཡང་བློ་རིག་བཀྲ་ཞིང་རང་འདོད་ཆེ་ཙམ་ཡོད།",
    "མ་ཚད་ཁོ་རང་ཁམས་ཞེན་ཤུགས་ཆེན་པོ་ལྷན་སྐྱེས་སུ་མངའ་བ་ཞིག་ཡོད།",
    "བརྒྱད་ཆང་བཅས་མེ་མདའ་རིང་ཐུང་གྲངས་མང་གནམ་ཐོག་ནས་རོགས་རམ་བྱུང་འདུག་པ་རྣམས་སྔ་ཕྱི་བསྡོམས་གནམ་གྲུ་བདུན་གཡུགས་འདུག་པ་རྣམས་བགོ་བཤའ་བྱས་ཏེ་དམག་འཁྲུག་ཤུགས་ཆེར་བརྒྱབ་པ་དང་།",
    "ཐེངས་གཅིག་ལ་རྒྱ་དམག་བསད་པས་མ་ཚད་རྟ་དམག་རྣམས་ཀྱི་དམག་རྟ་ཉིས་བརྒྱ་ལྷག་ཙམ་ཞིག་ཀྱང་ཉིན་གཅིག་ལ་ཕྲོགས་འདུག།",
    "རྫ་རི་དང་ཤིང་ནགས་སྟུག་པོའི་ཁྲོད་དུ་སྦས་སྐུང་བྱེད་ཀྱི་ཡོད་པ་དྲན་གྱི་འདུག།",
    "དེའི་རྗེས་ཤིག་ལ་མར་རྒྱ་ནག་ལ་ཕྱིར་ལོག་བྱས་འདུག།",
    "སྤྱིར་བཏང་རྒྱ་བོད་ས་མཚམས་ཧེ་ལུའུ་སྲང་ཟེར་བ་རི་མཐོན་པོ་དེའི་མགོ་དེ་ཡིན་འདུག།",
    "དེར་བརྟེན་སང་ཉིན་བཙོང་ཡུལ་ཚོང་པ་ཚང་མའི་སར་བསྐོར་བ་བརྒྱབ་སྟེ་རིན་གོང་སུས་ཆེ་བ་སྤྲོད་ཀྱི་ཡོད་པ་དེ་ལ་གནང་ཉིན་བཙོང་བ་ཐག་གཅོད་བྱེད་ཀྱི་ཡིན་ཟེར་འདུག།",
    "དེ་ཚོར་བཙོང་ན་ངས་འགན་ལེན་གཙང་མ་འཁྱེར་ཐུབ་ཀྱི་མི་འདུག།",
    "ཚོང་པ་མའོ་ཡི་ཟེར་བ་གཅིག་དང་གཡུ་རྒྱ་ཟེར་བ་གཉིས་ལ་བཙོང་ན་དངུལ་ལེན་རྒྱུ་ལ་སེམས་ཁྲལ་མི་འདུག་ཅེས་བཤད།",
    "དེ་ནས་རྩིས་ཀྱི་ཐོག་ལ་རྒྱ་མིས་རྩིས་བརྒྱབ་པ་དེའི་ཐོག་ནོར་འཁྲུལ་གཅིག་ཀྱང་མི་འདུག།",
    "སྒོག་པ་རྡུང་ས་ཞིག་དགོས་ཀྱི་འདུག་ཟེར་དུས་མི་དེའི་རྐང་པ་དང་ལག་པ་གང་རུང་གཅིག་གཅོད་དགོས་པའི་བརྡ་མཚོན་ཡིན།",
    "ལྷམ་འཚེམ་ས་རྒྱུད་པ་དགོས་ཀྱི་འདུག་གསུངས་སྐབས།",
    "ཕན་ཚུན་གཉིས་ལ་བར་དཔང་དེས་རྡོ་འབེན་ལ་ཐད་ཀར་ཕོག་འདུག་མིན་བལྟ་ཀྱི་ཡོད།",
    "བྱ་ནག་རྡོ་རྗེས་ཁྱི་དེ་སྐད་ཨའུ་ཨའུ་ཨའུ་ཟེར་གྱི་འདུག་ཅེས་ཞུས་པ་དང་།",
    "ཉག་སྐེད་ཁོ་རང་ཁྲིའི་མདུན་དང་གཡས་གཡོན་ལ་ལི་ཐང་བླ་གྲྭ་རྣམས་ལ་བཞུགས་ས་བརྒྱབ་ནས་དེར་བཞུགས་བཅུག་སྟེ།",
    "དཀར་མཛེས་བརྒྱུད་ནས་བོད་དབུས་ཕྱོགས་ཡར་བཤར་བཞིན་འདུག་པ་མཐོང་།",
    "ང་རང་གུང་ཁྲན་དམག་དང་མཉམ་དུ་བོད་ལ་འོང་པ་འདི་དགྲ་ལ་དགྲ་ལན་སྤྲད་ཆེད་དང་།",
    "མིང་ཀྲུའུ་རིན་ནི་རྒྱ་མི་ལོ་ཆུང་ཞིག་འདུག།",
    "ཁོང་ལི་ཐང་དགོན་གྱི་ལས་སྣེ་ལོ་གཅིག་ཙམ་ནས་ཚར་གྱི་འདུག།",
    "ཁྱེད་རང་རྣམས་ལི་ཐང་དུ་ཡར་ཕྱིན་ནས་འདི་གར་ཕེབས་མ་ཐུབ་པའི་སེར་སྐྱ་མི་མང་རྣམས་ལ་ང་འོང་མ་ཐུབ་པར་བློ་ཕམ་མ་བྱེད།",
    "གྱུང་པ་ནོར་ཁོ་དཔོན་ལ་གསེར་སྐུ་ལས་གྲུབ་པའི་ཕྱག་ན་རྡོ་རྗེའི་སྐུ་གཅིག་བཅས་གནང་འདུག།",
    "ཚོགས་ཞུགས་རྣམས་ནས་ལྷ་སར་འགྲོ་མཁན་ཡོད་ན་ཡག་པོ་འདུག།",
    "༡༩༩༩ ལོ་བོད་ཟླ་༧ ཚེས་༢ ཉིན་ལྷ་སར་འབྱོར་བས་ལམ་བར་ཉིན་གྲངས་༧ འགོར་འདུག།",
    "འབྲས་བོད་ས་མཚམས་བར་དུ་མཐའ་སྲུང་དམག་མི་ཙམ་ཡང་བཞག་སྲོལ་མི་འདུག།",
    "གཞན་པ་རྣམས་ཀྱང་གནས་ཁག་གཞན་དུ་གནས་ཚང་གཡར་ཏེ་བསྡད་པ་ལས་མགྲོན་ཁང་སོགས་སྐབས་དེར་ཡོད་མེད་མི་ཤེས་ཀྱང་མགྲོན་ཁང་དུ་བསྡད་པའི་ལུགས་སྲོལ་ཀྱང་མི་འདུག།",
    "ཟམ་པ་དེའི་སྟེང་ནས་བོད་པའི་ཚོང་པ་རྣམས་རྒྱུན་མ་ཆད་པ་བཤར་གྱིན་འདུག།",
    "ཁྱེད་རང་ང་དང་མཉམ་དུ་འདི་གར་ལྷ་སར་བསྡད་དགོས་ཀྱི་འདུག།",
    "གཞན་བཞི་པོ་ལི་ཐང་དམག་འཐབ་སྐབས་ཤོར་འདུག།",
    "དེར་བརྟེན་༧གོང་ས་སྐྱབས་མགོན་ཡིད་བཞིན་ནོར་བུ་མཆོག་སྐུ་ཚེ་ལ་བར་ཆད་མེད་པའི་བཞེད་དོན་ལྷུན་གྱིས་འགྲུབ་པའི་ཆེད་དུ་ལྷ་བླ་ཁག་དང་བཀའ་སྲུང་ཁག་མི་ཉུང་བ་ཞིག་ལ་བཀའ་བརྟག་ལུང་ཞུས་དུ་མ་བྱས་པས་རིམ་གྲོ་རྒྱ་གང་ཆེ་བསྒྲུབ་རྒྱུ་དང་བརྟན་བཞུགས་འབུལ་རྒྱུ་བབས་པ་ཕལ་ཆེར་གཅིག་མཚུངས་ལྟ་བུ་མ་གཏོགས་གཞན་མི་འདུག།",
    "དེ་སྔོན་བརྟན་བཞུགས་འབུལ་ཚན་སོགས་ཀྱི་སྐབས་སུ་ཕུལ་མྱོང་མེད་པ་ཞིག་འབུལ་རྒྱུ་གྲ་སྒྲིག་བྱེད་དགོས་ཀྱི་འདུག་ཅེས་གྲོས་བསྡུར་བྱས་ཏེ་ཚང་མས་བསམ་བློ་བཏང་ནས་༧གོང་ས་རྒྱལ་བ་ཡིད་བཞིན་ནོར་བུ་མཆོག་ལ་སྐྱབས་ཞུ་འབུལ་ཐོ་ཀློག་སྐབས་སྐྱབས་ཞུའི་མཚན་བརྗོད་ལ་ཞབས་པད་གསེར་ཁྲི་མངོན་མཐོའི་དྲུང་དུ་ཞེས་འགོད་བྲིས་གནང་བ་ཙམ་ལས་གསེར་ཁྲི་དངོས་སུ་མི་འདུག་པས།",
    "ཏ་རིགས་ཁག་ནས་ཞལ་འདེབས་ཕུལ་བའི་གསེར་གང་ཡོད་སྲང་གཞལ་ཞིབ་འཇུག་བྱས་པས་གསེར་ཏོ་ལ་གཅིག་སྟོང་དྲུག་བརྒྱ་ལྷག་ཙམ་བྱུང་འདུག།",
    "བློ་ཕམ་པ་གཅིག་ལ་སྟན་དཀར་རྡོ་རྗེའི་སྟོད་དུ་རིན་ཐང་བྲལ་བའི་གཟི་ཆུ་མིག་དགུ་པ་དེ་ཕྲ་ཕོར་དང་བཅས་པ་བཀོག་སྟེ་འཁྱེར་ཚར་འདུག།",
    "ཞེས་ཨུ་ཚུགས་མཐར་སྐྱེལ་བྱས་ནས་ཞུས་འདུག།",
    "དེར་སླེབས་པ་དང་སྦྱིན་པ་རྒྱ་མཚོ་ཡང་ཕེབས་འདུག་གསུངས།",
    "ཡིན་ན་ཡང་ཨ་འབྲུག་མགོན་པོ་བཀྲ་ཤིས་མཆོག་ལ་ཐད་ཀར་ཁས་ལེན་མེད་པའི་དགག་བྱ་མཐའ་གཅིག་ཏུ་བྱེད་ཕོད་མཁན་མི་འདུག།",
    "ཞལ་འདེབས་སོགས་ཚུར་འོང་གང་ཡོད་བཅས་ཀྱི་ཐོ་གསལ་པོ་བརྒྱབ་ཡོད་པས་རྩིས་རྒྱག་བདེ་པོ་ཆགས་འདུག།",
    "ཇག་པ་རྣམས་ཀྱིས་ཆ་འཕྲིན་ཡིག་དོན་མཐོང་བ་དང་འགྱོད་པ་དང་བཅས་ཏེ་ཡི་གེ་འབའ་ལི་རྒྱལ་གསུམ་ཕྱོགས་སུ་འཕྲོད་ཐབས་བྱས་འདུག་ཅེས་རྗེས་སུ་གོ་ཐོས་བྱུང་།",
    "བོད་གཞུང་ནས་གང་གསུངས་ཀྱི་འདུག་གམ།",
    "ཁམས་ཀྱི་བྱང་རྒྱུད་དུ་གནས་པ་རྣམས་སུ་འདི་ཕྱོགས་ཀྱི་དམིགས་ཡུལ་དང་འཆར་གཞི་རྣམས་ཆ་དང་བང་ཆེན་ཡང་མ་འཕྲོད་པས་ལྷག་ལུས་འདྲ་པོ་བྱུང་འདུག་ན།",
    "དེ་མ་ཡིན་པ་དེང་སང་དེབ་འགའ་ཤས་ནང་ཆུ་སྒང་གསར་བཙུགས་སྐབས་མནའ་གན་དམ་འབུལ་བྱས་པའི་གཙོ་བོའི་གྲས་ཡོད་སྐོར་འགའ་ཤས་ཀྱི་མཚན་བཀོད་བྱས་འདུག་པ་རྣམས་གུས་པས་མཐོང་ཐོས་མ་བྱུང་།",
    "ཕན་ཐོགས་མ་བྱུང་ནའང་གནོད་བསྐྱེལ་བ་ཞིག་མི་འདུག་ཅེས་པའི་བཀའ་ལུང་ཕེབས་པས།",
    "ཐུང་མདའ་ཅ་ན་ཏ་ཞིག་དང་དེའི་མདའ་བརྒྱ་བཅས་འདུག་པ་ཡོད་ཚད་རྩིས་འབུལ་བྱས་པ་ལེན་ཏེ།",
    "སི་ཡོང་ཤེས་རབ་བཅས་ངེད་བཞི་ལ་འགའ་ཤས་ནང་མི་བརྒྱད་འཁོད་འདུག་ཀྱང་སྐབས་དེར་ངེད་བཞི་མ་གཏོགས་སུ་ཡང་མེད་གྲ་སྒྲིག་བྱས་པའི་ཁམས་ཆས་ཆ་ཚང་བསྐུར་ཏེ།",
    "རྒྱ་མི་ཡང་ཕར་ཚུར་འགྲོ་སྐྱོད་བྱེད་བཞིན་འདུག།",
    "དེ་དག་ལས་དམག་ཆས་གྱོན་པ་དེར་ཐུང་མདའ་གཅིག་དང་མདའ་༤ སྐོར་འདུག་པ་ཚུར་སྤྲད་ནས་ཁོ་ཚོ་ཆུ་བཞི་སྒང་དྲུག་དང་མཉམ་དུ་འགྲོ་རྒྱུ་ཡིན་པས་མགོ་བཏགས་ལེན་རོགས་ཟེར་བས།",
    "མཉམ་དུ་ཡོད་པའི་མི་ཕལ་ཆེར་གྱིས་གསོད་རྒྱུ་འདོད་པ་འདུག་ཀྱང་།",
    "ད་དུང་ང་རང་ལ་ཆིབས་རྒྱུ་རྟ་སྤུས་མ་སྐད་གྲགས་ཡོད་པ་གཅིག་མཚུར་ཕུ་བླ་བྲང་ལས་ཉོས་ཏེ་དངུལ་རྐྱང་རྡོ་ཚད་བཞི་བརྒྱ་ཐམ་པ་ཧྲག་ཧྲག་སྤྲད།",
    "མཉམ་དུ་མདེའུ་༡ ལྷག་ཙམ་ཡང་འདུག།",
    "ཚང་མ་ཕྱོགས་སྡོད་ཆེད་གྲི་གུར་སྐད་བཏང་འདུག་པས་དར་དགོན་བསེ་བསེ་སོགས་རྟ་པ་བཅོ་ལྔ་ཡན་མན་ཁག་གཅིག་དང་།",
    "༢དམག་སྤྱི་ཁང་ནས་དགུ་ཐོག་ལ་དམག་རྒྱག་དགོས་པའི་བཀའ་ཕེབས་པ་ལྟར་དམག་རྒྱག་སར་དུས་ཐོག་སླེབས་མ་ཐུབ་པ་དམག་སྤྱི་བརྒྱ་དཔོན་སུ་ཡིན་རུང་རང་རང་གོ་གནས་ཕྱིར་ལེན་ཐོག།",
    "ཆུ་སྒང་སྤྱི་ཁྱབ་དམག་སྤྱི་ཨ་འབྲུག་མགོན་པོ་བཀྲ་ཤིས་གཙོས་པའི་མགོ་བྱེད་འགའ་ཤས་ཁོང་རྣམ་པའི་མདུན་དུ་འཕྲལ་དུ་ཤོག་གསུངས་པའི་ལན་འབྱོར་འདུག།",
    "དེ་བཞིན་རྟ་ཡི་རྨིག་ལྕགས་དོ་པོ་བཅས་སྤྱོད་གང་ཐུབ་བཏང་འདུག་པ་དག་རྗེས་མ་སྐུ་མདུན་སྐུ་འཁོར་ལྷོ་ཁར་ཕེབས་དུས་ལ་ཡང་ཕུལ་རྒྱུ་རིག་པས་ཕན་ཐོགས་ཆེན་པོ་བྱུང་ཡོད།",
    "ཟ་ཆས་དམག་ཕོགས་རྣམས་ལྷོ་ཁར་དང་པོ་སླེབས་དུས་མི་ཕལ་ཆེར་གྱིས་ཟླ་བ་གཉིས་གསུམ་ཙམ་འདང་བ་ལས་འཁྱེར་ཐུབ་མི་འདུག།",
    "དེ་ཙམ་ནི་སོ་སོའི་བན་དྲེལ་ལ་འགེལ་འདུག།",
    "དོན་ལ་ཁོ་གསུམ་རྒྱ་མིས་ཆེད་དུ་བཏང་བ་ཞིག་ཡིན་འདུག།",
    "ཆུ་ཚུ་རི་ཕྱོགས་སུ་སྒུག་ར་དང་གཉིས་གཉིས་ལ་ཕར་རྒྱག་མཁན་རྒྱ་དམག་བཅུ་གྲངས་ཤིག་བསྒྲུགས་འདུག་པ་རྣམས་ཀྱི་ཐོད་དུ་ཁོ་བོ་དང་མཉམ་དུ་སྒ་པ་དམག་སྤྱི་དགེ་ལེགས་ཕུན་ཚོགས།",
    "མེ་སྒྱོགས་མེ་མདའ་རིང་ཐུང་ཚང་མ་གྲངས་ལྔ་བརྒྱ་སྐོར་ལེན་ཐུབ་འདུག།",
    "རྨས་མ་མི་གྲངས་༤༧ ཙམ་བཟོས་འདུག།",
    "འཐབ་ར་གོང་འོག་གཉིས་ལ་རང་དམག་ཚུར་བསད་པ་བསྡོམས་མི་གྲངས་༤ རྐྱེན་ལམ་དུ་བྱུང་འདུག།",
    "འགའ་ཞིག་ཤ་ཕུག་པ་ལས་རུས་པ་རྩར་ཐུག་དུས་མ་སྐྱོན་པ་དང་།",
    "འགའ་ཞིག་གོས་ཕུག་པ་ལས་མ་སྐྱོན་པ་མང་བ་འདུག།",
    "འཛིང་ར་གསུམ་པའི་ནང་ཁོང་རྣམས་ཀྱིས་ཕར་རྒྱ་མི་བསད་པ་གྲངས་༧ གྱི་ཕུང་པོ་དེར་ཡོད་འབྲོག་པ་རྣམས་ལ་རུབ་རུབ་བཟོས་ཏེ་དབོར་ཏུ་བཅུག་འདུག།",
    "བལྟས་པས་སྒོ་ཕྱེ་མཁན་མི་རྒན་རབས་ལྔ་དང་ཕོ་སར་བཞི་འདུག།",
    "སྦྱིན་བདག་ནས་དོ་ནུབ་དུས་ཚོད་ཕྱི་པོར་སླེབས་ཟིན་འདུག་སྟབས་གོ་ལག་ལོན་ཐབས་མེད།",
    "མདེའུ་བཅས་ཕན་ཐོགས་ཤག་ཤག་ཞིག་འདུག།",
    "ནམ་མ་གསལ་ཙམ་ལ་རྒྱབ་སྒོ་གཏོར་ནས་བཙན་འཛུལ་བྱས་ན་མ་གཏོགས་ཐབས་ཤེས་མི་འདུག།",
    "དེ་མ་གཏོགས་ཕྲན་ལ་བྱེད་ཐབས་མི་འདུག།",
    "ངེད་གཉིས་ནང་དུ་འཛུལ་བས་མཆོད་གཤམ་རྒྱབ་ཏུ་ཕྲེད་དུ་རིང་པོ་ཡོད་པ་ཞེང་ཁ་འདོམ་ཕྱེད་དོ་ཙམ་ཡོད་པའི་ཁང་པ་ཞིག་གསང་བའི་གོ་མཛོད་བྱས་འདུག་གོ་ལག་དབྱིན་ཇི་ཁ་རྡུམ།",
    "དེར་མེ་སྒྱོགས་མི་འདུག་གང་དུ་ཡོད་དྲིས་པས་ཁང་པ་གཞན་ཞིག་ཏུ་ཡོད་ཟེར་ཏེ་མེ་སྒྲོགས་གནམ་བླུག་ཆེ་བ་གཉིས་དང་ཆུང་བ་དྲུག་དང་མདེལ་བཅས་ཁྱེར་ནས་བྱུང་།",
    "རང་དམག་ཁ་ཤས་ཀྱིས་གློག་བརྙན་སྤྱིན་ཤོག་ཡང་མང་པོ་ཁྱེར་འདུག།",
    "སྔར་རྒྱ་མིས་བཏང་བ་འབྲོག་པ་མི་གསུམ་སྡོད་སའི་འབྲོག་པ་དེ་ཚོའི་ནང་རྟ་དམག་ཉི་ཤུ་ཙམ་བཏང་ནས་དེ་སྔོན་རྒྱ་མིའི་སོ་པ་གསུམ་པོ་དེ་ཧ་གོ་ནས་བསད་འདུག།",
    "འཛིན་ར་གསུམ་པའི་ས་དེར་རྒྱ་མི་བསད་པའི་རོ་གྲངས་དགུ་བཅུ་གོ་བདུན་ཏག་ཏག་འདུག་ཟེར།",
    "མདའ་ཤུལ་བརྩི་མི་ཐུབ་པ་འདུག།",
    "བྱིན་རྟེན་ཟས་པའི་ཤོག་སྟོང་རྣམས་སྐྱ་ཆག་གེ་འཕང་ནས་ཐམས་ཅད་སེམས་སྡུག་དགོས་པ་བཟོས་འདུག།",
    "སྒྲུག་ར་གོང་འོག་ཚང་མ་བསྡོམས་ན་རྒྱ་རོ་དྲུག་བརྒྱ་ལྷག་ཙམ་ཡོད་འདུག་ཟེར།",
    "སྐོར་ཡོད་འདུག།",
    "དམག་མི་གསུམ་ཤི་འདུག།",
    "སྨར་ཁམས་དམག་མི་ལྔ་དྲུག་ཙམ་ཤི་རྨས་བྱས་འདུག།",
    "དམག་ས་ཁག་གསུམ་གྱིས་བསད་པའི་སྐོར་འབོར་བསྡོམས་བརྩིས་པས་རྒྱ་མི་སྟོང་གསུམ་ཙམ་བསད་ཡོད་པ་ཆགས་ཀྱི་འདུག།",
    "ཡིན་ན་ཡང་དེ་ནས་གོ་ལག་དེ་ཙམ་མང་པོ་ཐོབ་མེད་ཀྱང་དྲང་པོ་ཞིབ་རྩིས་རྒྱག་དུས་རྒྱ་དམག་བདུན་བརྒྱ་ཡས་མས་བསད་ཡོད་པར་ཚང་མའི་ཁ་འཆམས་པས་མ་ཚད།",
    "དམག་སྤྱི་གཉིས་ལ་ལབ་པས་ཁོང་གཉིས་ཀྱང་ཉལ་འདུག།",
    "ད་དུང་ཡང་ཨ་ཡོ་ཟེར་གྱི་འདུག།",
    "ཕྱེད་ཚུ་རི་བརྒྱུད་དེ་ཁག་གཉིས་སུ་བཟུང་བཞིན་འདུག།",
    "བལྟས་པས་གཞུང་ནས་རྒྱ་མིའི་རྐང་དམག་བདུན་བརྒྱ་བརྒྱད་བརྒྱ་ཙམ་རང་དམག་རྣམས་མ་མཐོང་བར་འོང་བཞིན་འདུག།",
    "རི་མཐོའི་ས་བཙན་ཕལ་ཆེར་སྔོན་འགྲོ་བ་རྣམས་ཀྱིས་བཟུང་པ་ལས་རྒྱ་དམག་འོང་ཕྱོགས་སུ་ས་མ་བཟུང་བར་བསྡད་འདུག།",
    "མགོ་ཡང་བཀྱག་ས་མི་གདའ་པས་ས་ལ་ཉལ་ནས།",
    "ཡུད་ཙམ་ཞིག་ནས་རྗེས་ཕྱོགས་རི་རྩེ་དེར་རྟ་པ་སུམ་ཅུ་སྐོར་རིམ་དོན་བྱུང་བས་དེའི་ནང་རྒྱ་བློ་བཟང་བཀྲ་ཤིས་ཡོད་འདུག་པས་མེ་སྒྱོགས་བཅུ་གྲངས་ཤིག་ངེད་གཉིས་ཁ་ཐད་ལ་བརྒྱབ་བྱུང་བས།",
    "ཕར་ཕྱོགས་ལ་མགོ་ནས་རྟ་པ་ཉིས་བརྒྱ་ལྷག་ནས་ས་བཟུང་ཡོད་པ་རྣམས་ཀྱིས་བརྒྱབ་ནས་རྒྱ་དམག་སུམ་ཅུ་བཞི་བཅུ་ཙམ་དེ་ག་རང་དུ་བསད་འདུག་པའི་རྒྱ་མིའི་རོ་དང་།",
    "མཚུར་ཕུ་ཕྱོགས་ཀྱི་རི་ངོས་སུ་ཡོད་པའི་རྒྱ་མི་ཕལ་ཆེར་བསད་ཚར་ནས་རྒྱ་རོ་ཁྲ་ཉི་ལེ་ལ་མེ་མདའ་བསྡུ་ཐུབ་ན་གང་འདོད་བསྡུ་རྒྱུ་འདུག་ཀྱང་།",
    "འོག་ལ་ཡོད་པ་རྣམས་ཀྱིས་ཡར་སྐད་བརྒྱབ་པས་སྐྱོན་མེད་ཅེས་ལབ་འདུག།",
    "གཡུག་ཤོག་ལབ་ཀྱང་མ་ཉན་པར་ཁོ་ཚོ་མི་ལྔ་དྲུག་ཕྱིན་ནས་མེ་མདའ་རིང་ཐུང་བཞི་ཁྱེར་འདུག།",
    "ཐོད་ནས་མེ་མདའ་༧ ཙམ་བསྡུ་ཐུབ་འདུག།",
    "གཅིག་ཤོས་ཀྱིས་རོའི་འོག་ཏུ་བཟུང་ནས་ཚུར་ཙམ་བར་འདྲུད་ཀྱང་རོ་ཆེ་སྟབས་འདྲུད་མ་ཐུབ་སྟབས་རོ་ལུང་ཤུར་ཞིག་ཏུ་སྦས།",
    "འབྲོག་པར་སྐད་ཆ་དྲིས་དུས་འདིར་ཕྱོགས་རྒྱ་མིས་ས་བཟུང་ནས་བསྒྲུགས་ར་སྤྲད་ཡོད་པས་འགྲོ་ས་མི་གདའ་ཟེར།",
    "མི་རིང་བར་རང་དམག་ཡོད་ས་དེར་སླེབས་པ་དང་རྟ་དམག་ཉི་ཤུ་སུམ་ཅུ་ཙམ་ཕར་ཙམ་དེར་རུབ་རུབ་བྱས།",
    "ཡུད་ཙམ་ཕྱིན་ཏེ་ཕྱིར་བལྟས་བྱས་པས་རྟ་དམག་ལྔ་བརྒྱ་དྲུག་བརྒྱ་གཅིག་མཇུག་གཉིས་མཐུད་ཀྱིས་འོང་བཞིན་འདུག།",
    "ད་དུང་ཡང་མེ་མདའི་སྐད་སྒྲ་གོ་བཞིན་འདུག།",
    "དངུལ་ཕོགས་ལེན་སའི་དེབ་བཅས་ཐོབ་འདུག་པ་ལ།",
    "རི་ཁུག་དེར་འབྲོག་པ་ཁྱིམ་ཚང་མང་པོ་ཞིག་བསྡད་གདའ།",
    "དེ་རྣམས་ཕྱིར་སློག་གནང་རོགས་བྱུང་ན་ཡག་པོ་འདུག་ཅེས་ཞུས་སྐབས།",
    "འདམ་ལྕོག་རྩེ་ལ་མགོར་པོ་ཐོའི་ཁང་པ་ཞིག་ཡོད་པ་དེར་ལམ་བཟོ་པ་དང་ས་སྲུང་རྒྱ་དམག་མང་པོ་ཞིག་བསྡད་ཡོད་འདུག།",
    "ཆ་ཕྲེང་དམག་ཤོག་བཅས་རྒྱུགས་ཏེ་མེ་མདའ་རྒྱག་བཞིན་འདུག་པས།",
    "དེ་བྱིངས་ཚང་མ་རྩ་མེད་བཟོས་འདུག།",
    "ཆ་ཕྲེང་གྲ་ལུ་ཅན་མི་གྲངས་ལྔ་དྲུག་ཙམ་རྨས་སྐྱོན་བྱུང་འདུག།",
    "འདམ་ལྕོག་རྩེ་ལ་ཁར་རྒྱ་མིའི་ལམ་བཟོ་དང་ས་སྲུང་བསྡོམས་པ་རྒྱ་མི་ཉིས་བརྒྱ་སྐོར་ཡོད་ཚོད་འདུག།",
    "ང་རང་ཡང་དེ་ཉིན་སྦྱིན་བདག་མཉམ་དུ་འགྲོ་བའི་སྐབས།",
    "སྟོད་ཐུང་བཅས་འཁྱེར་སླེབས་བྱུང་པ་ཚང་མ་རུབ་རུབ་བྱས་ནས་འབྲོག་པ་རྒན་པོ་རྣམས་ལ་རང་རང་ངོས་འཛིན་བྱས་ནས་ཕར་འཁྱེར་བཅུག།",
    "རི་མགོ་ནས་མར་རིམ་བཤར་བྱས་ཏེ་བལྟས་པས་ལུང་པ་ནང་འབྲོག་པ་མང་པོ་ཞིག་འདུག་པར།",
    "ཞི་སེར་བ་སོགས་འགའ་འདུག་པར་ཕྱིར་དོན་ནས་མེ་མདའ་བརྒྱབ་དགོས་རྐྱེན་ཅི་ཡིན་སོགས་ཟེར་ནས་ངར་གྱི་འདུག་སྔོན་མས་ཇ་འཐུང་ཆོག་པ་ལ།",
    "མ་ཟད་སྔོན་འགྲོ་བ་རྣམས་ཀྱིས་རྒྱ་མིའི་མེ་མདའ་རིང་ཐུང་བརྒྱ་སྐོར་ཙམ་ལེན་འདུག།",
    "རྒྱ་མི་དམག་རྟ་ཡང་དྲུག་ཅུ་བདུན་ཅུ་སྐོར་ཐོབ་འདུག།",
    "ཅུང་བསྒུགས་ཀྱང་འོང་མཁན་མི་འདུག་པར།",
    "ཁོ་པའི་ཚ་རུའི་ཕྱུ་པ་ཞིག་གྱོན་འདུག་པ་ཀྱང་བཤུས་ནས་ཁྱེར།",
    "སྐབས་དེར་སྦྱིན་བདག་གཙོས་དམག་མང་རྣམས་ནས་རང་དམག་སོ་པས་རྨམ་གཞུང་ལུང་མདར་རྒྱ་མིས་བསྒུགས་ཡོད་མེད་ཀྱི་ལན་མ་འབྱོར་བ་བསྒྲུགས་འདུག་པ་དང་།",
    "མེ་སྒྱོགས་བརྒྱབ་པ་ལ་ནི་གྲངས་ཀ་མི་འདུག།",
    "ཕྲན་ནས་རག་རག་ལ་ཁྱེད་རང་ཕར་ཙམ་ཕྱིན་ནས་རྟ་ཞིག་བཞོན་རྒྱུ་རག་པ་བྱས་ཏེ་ཡར་ཙམ་ལུང་ཁུག་ཏུ་སླེབས་ཐུབ་པ་བགྱིས་དང་།",
    "ག་འདྲ་འདུག་ཞུས་པས།",
    "ང་ལ་འཇུ་མ་འོང་ཟེར་ནས་མེ་མདའ་ཁ་རྡུམ་དེ་ཚུར་གཡུགས་ཏེ་མ་བཞག་པར་ཁྱེར་རོགས་ཟེར་གྱི་འདུག།",
    "བྲག་གཡབ་དྲུང་ཡིག་བློ་བསྟན་སོགས་འགའ་ཤས་ནས་རྟ་དྲེལ་བཟུང་ཐུབ་མིན་གྱིས་ཟང་ངེ་ཟིང་ངེ་ཆགས་བསྡད་འདུག།",
    "དེར་རྟ་པ་ཉིས་བརྒྱ་སྐོར་སླེབས་འདུག།",
    "ཁྱེད་རང་ངེས་པར་རྒྱུགས་ཤིག།",
    "ཕར་ཙམ་ལུང་ཤུར་གཅིག་ལ་མི་ཁ་ཤས་གབ་འདུག་པར་སུ་ཡིན་དྲིས་པས།",
    "དེའི་རི་ཁུག་ཞིག་ལ་རྒྱ་དམག་མང་པོ་འབྱོར་ཚར་འདུག་དེ་རྣམས་ཀྱིས་ཀྱང་ངེད་གཉིས་ཐོག་ཚུར་མེ་མདའ་བརྒྱབ་ཀྱི་འདུག།",
    "སྐབས་དེར་ཁོ་བོའི་བརླ་སྒང་གཡས་པ་ངོས་ལ་ཀྲིང་གྷན་མདའ་བཅུ་བཞི་བཅོ་ལྔ་ཕོག་ནས་གྱོན་ཆས་རྣམས་རྗེཕུག་པ་ལས་ལུས་ལ་སྐྱོན་ཆེར་བྱས་མི་འདུག།",
    "ཚེ་འཕེལ་ལ་ཡང་གྱོན་ཆས་ལ་མདའ་མང་པོ་ཕོག་པ་ལས་ལུས་ལ་གཅིག་ཀྱང་ཐེབས་མི་འདུག་དེར་ས་བཟུང་ནས་ཡུད་ཙམ་བསྡད་པས།",
    "དེར་རྒྱ་མིའི་རྟ་དམག་དྲུག་བདུན་ཞིག་མེ་མདའ་འཁྱེར་ནས་བསྡད་འདུག་པ་ལས་ལམ་སེང་མེ་མདའ་བརྒྱབ་ཀྱི་མི་འདུག།",
    "དེ་སྔོན་ཡར་འགྲོ་སའི་རི་ཁུག་ཏུ་སླེབས་པ་དང་རྟ་འགའ་ཤས་འདུག་དེར་ཕྱིན་པས་ལི་ཐང་རྟ་མགྲིན་རྡོ་རྗེ་དང་།",
    "སྐབས་དེར་མུན་རུབ་མ་རུབ་ཀྱི་དུས་ཚོད་ལ་སླེབས་འདུག།",
    "དེ་ནས་ས་རུབ་པ་དང་རྒྱ་མིས་གློག་བརྡའི་མེ་མདའ་ཡང་མང་པོ་བརྒྱབ་ཀྱི་འདུག།",
    "ཚེ་འཕེལ་གྱི་དྲེལ་ལ་ཕོག་ནས་རིལ་བས་རྐང་པ་དྲེལ་འོག་ནས་འཐེན་པ་གློག་འོད་དུ་མཐོང་བཞིན་འདུག།",
    "དེ་དང་མཉམ་དུ་གློག་གཅིག་འཕེན་བྱུང་བས་རྒྱ་གསུམ་བཞི་ཞིག་ཤི་འདུག་པ་མཐོང་།",
    "ཕྲན་ནས་ཀྱང་ཀྲིང་གྷན་གང་འཚམས་ཤིག་བརྒྱབ་པས་ཀྲིང་གྷན་གྱི་མདེའུ་རྒྱུགས་ཀྱི་མི་འདུག།",
    "ཁོ་བོ་སྒལ་པའི་སྟེང་དུ་རྒྱ་མིའི་བུ་ར་མདེའུ་གཅིག་ཕོག་སྟེ་གོས་ཆེན་གྱིས་གཡོགས་པའི་ཀྲང་མན་གྱོན་ཆས་ཕུག་ནས་ནང་དུ་འབུ་རས་སྟོད་ཐུང་མ་ཐུག་མཚམས་སུ་མདེལ་མགོ་བསྡད་འདུག།",
    "ངེད་གཉིས་ཀྱིས་མེ་མདའ་བརྒྱབ་ན་རྒྱ་དམག་ཁ་ཤས་བསད་ཐུབ་པ་འདུག་ཀྱང་རྒྱལ་ཁ་ཐོབ་པའི་གདེང་སྤོབས་མེད་པས་བྱ་ཐབས་བྲལ་ཏེ་དེ་ནུབ་ས་མ་རུབ་བར་དེར་ཡིབས་ནས་བསྡད།",
    "མདེའུ་བྱིངས་རྣམས་གཟུགས་པོར་གང་ཕོག་སར་ཆུ་སྦུར་ནང་བཞིན་སྦོས་པ་ཙམ་ལས་མདེའུ་ནང་ལ་ཕྱིན་མི་འདུག།",
    "ཕྲན་གྱི་རོགས་པ་ལི་ཐང་ཚེ་འཕེལ་ལ་ཡང་ཉིན་མཚན་གཉིས་ལ་མདའ་གྲངས་བདུན་ཐོག་འདུག།",
    "མདེའུ་གྲངས་བདུན་པོ་ཐོག་ས་དེར་ཕྱིར་ཕྲན་བུ་ཕྲན་བུ་སྤུར་ཉག་ཐོན་པ་ལས་ནང་ལ་སྐྱོན་ཆེན་གང་ཡང་བྱུང་མི་འདུག།",
    "གནམ་གྲུ་འོང་སྟངས་དེ་ཤིན་ཏུ་དམའ་པོ་འདུག་པས་ངེད་གཉིས་ནས་མེ་མདའ་བརྒྱབ་སྟེ་གཏོར་ཆོག་པ་འདུག་བསམ་པ་བྱུང་ཡང་གཤམ་དུ་རྒྱ་དམག་མང་པོ་ཡོད་རྐྱེན་མེ་མདའ་རྒྱག་མ་ཕོད།",
    "རྒྱ་དམག་དེ་དག་ལ་མེ་སྒྱོགས་དང་མདེལ་རྫས་འགེལ་དྲེལ་ཡང་བཅུ་གྲངས་ཤིག་འཁྲིད་རྒྱུ་འདུག།",
    "ཕྲན་གཉིས་ལ་ཟ་རྒྱུ་གྲོ་ཆས་ནི་གང་ཡང་མི་འདུག།",
    "ངེད་གཉིས་ཡོད་སའི་ཆུའི་ཕར་ཕྱོགས་སུ་ཐང་སྐྱིད་པོ་ཞིག་འདུག།",
    "རྟ་དེར་བལྟས་ན་རྒྱ་རྟ་འདྲ་པོ་ཞིག་འདུག་མེ་མདའ་མགོ་མཇུག་ལོག་ནས་ཁྱེར་འདུག།",
    "ངེད་གཉིས་འབྲོག་པའི་སྦྲ་གུར་ནས་འཐོན་ཏེ་ཕར་ཙམ་ཞིག་ཏུ་བྲག་རྡོ་ཡོད་སའི་ས་བཙན་ཞིག་འདུག་པར་དེ་ནང་སྒུག་ར་བརྒྱབ་ནས་བསྡད་པས།",
    "ཁོ་བོས་སྐད་འབོད་ཀྱིས་རྟ་པ་དེར་ཁྱེད་རང་སུ་ཡིན་ཞེས་དྲིས་པས་ཁོ་རང་ནས་ཀྱང་ཚུར་ཁྱེད་རང་སུ་ཡིན་ཟེར་བ་ལས་ལན་མ་སྟེར།",
    "ཚེ་འཕེལ་གྱིས་མེད་པར་བོད་དངུལ་བརྒྱ་ལོར་གསར་པ་གསར་རྐྱང་མང་པོ་ཁྱེར་འདུག་པས་དེའི་ནང་ནས་བརྒྱ་ལོར་བཅོ་ལྔ་རྒན་པོ་དེར་སྤྲད་པས།",
    "དེའི་ཞོགས་པ་ལ་ཁ་འོང་ལམ་ནས་རི་དྭགས་གནའ་བ་བསད་པ་དེའི་ཤ་བཙོས་ཏེ་འབྲོག་པ་ཞིག་འདུག་པ་དེར་ཞག་གཅིག་བསྡད།",
    "དེ་རྗེས་མདའ་གཞུ་བླངས་ནས་མདའ་བརྒྱབ་པས་སྒོ་ཐོད་དུ་ཕོག་སྟེ་མདེའུ་ཤིང་ལ་ཟུགས་ནས་མདའ་སྒྲོ་ལྡེམ་ལྡེམ་བྱེད་ཀྱི་འདུག།",
    "དགའ་གདོང་ལ་ལྷ་ཕེབས་ཞུས་པས་བཀའ་ལུང་དང་ཞགས་པ་བཅས་གནང་འདུག།",
    "ཨ་འབྲུག་སྦྱིན་བདག་ཡོད་ས་ལ་བང་མི་བཏང་ཚར་བ་ཡིན་གསུངས་ཀྱི་འདུག།",
    "རྒྱ་དམག་རྣམས་ཀྱིས་ཨ་འབྲུག་སྦྱིན་བདག་རྗེས་འདེད་མི་བྱེད་པའི་ཁྱད་པར་མེད་དམ་བསམ་གྱི་འདུག་པས།",
    "དེའི་ཕྱི་ཉིན་ཞོགས་པ་ཁོང་གཉིས་སླར་འོང་ནས་དེ་ལྟར་བྱས་ན་ཡག་པོ་འདུག་པས་དེ་བཞིན་བྱའོ་ཟེར།",
    "ཡིན་ན་ཡང་གོ་ལག་རྣམས་སྤྲོད་མ་རག་པ་མི་འདུག་པས་ཉིན་ཤས་བསྒུགས་དང་གོ་ལག་ཆེ་ཆུང་ཡོངས་རྫོགས་ལྷ་གཤིགས་ནས་གོ་མཛོད་ཁ་ཁ་བྱས་ཏེ་བཞག་ཡོད་པས་ལྷ་བསྒྲིགས་ཟིན་པ་དང་རྐུ་བའི་ས་གནས་བསྟན་ཆོག་ཟེར།",
    "མི་རྒན་གཅིག་དང་མཉམ་དུ་མི་ལྔ་འདུག།",
    "ངའི་ཕ་རྒན་ཡིན་པ་ལྟ་བུ་ཤོད་ཀྱི་འདུག་པར་བརྟེན།",
    "ཚེ་འཕེལ་གྱིས་ཡིན་མིན་ཐེ་ཚོམ་གདའ་ཟེར།",
    "ང་རང་ནི་ཉི་མ་ལྷ་སར་འབྱོར་བས་དོན་དེས་འགྲུབ་པ་ཡིན་ཞེས་གསུངས་ཀྱི་འདུག།",
    "དེ་དངོས་གནས་འདྲ་པོ་འདུག།",
    "པ་ཕ་རྒྱ་མིས་བཟུང་འདུག་ཟེར་བ་དེ་འདྲ་གོ་ན་ཆ་འཇོག་རྩ་བ་ནས་མ་བྱེད།",
    "དེ་མཉམ་དུ་སྒ་པ་ཉི་བཟང་སོགས་རྟ་པ་བཅུ་གསུམ་བཅས་འདུས་འདུག།",
    "མེ་མདའ་གསུམ་འདུག།",
    "མེ་མདའ་རིང་ཐུང་གཉིས་ཡོད་པ་འདུག་ཁྱེད་རྣམ་པའི་དངུལ་སྲང་ཆིག་སྟོང་སུམ་བརྒྱ་དེ་དང་།",
    "གང་ཡིན་ཞེ་ན་ལྷ་ས་ནས་འོང་སྐབས་རྔ་ཆེན་ཁྲང་ལ་རྒྱ་མི་ཡོད་སར་བསྡད་འདུག་ཟེར་བས།",
    "འཕན་པོའི་ནང་ལ་ཨ་འབྲུག་དམག་སྒར་འདུག་ཅེས་གོ་ཐོས་བྱུང་བས་དམག་སྒར་ནང་འཛུལ་ཞུགས་ཆེད་དུ་འོང་པ་ཡིན་ཞེས་ཟེར།",
    "ཁོ་རང་ནས་བརྗོད་གསལ་ལ།",
    "གློར་དམག་སྒར་གང་འཚམས་བསྡད་རྗེས་ཉིན་གཅིག་ཁོ་རང་བྲོས་བྱོལ་ལ་ཕྱིན་འདུག་ཁོའི་རྗེས་སུ་དམག་མི་འགའ་ཤས་ཀྱིས་རྗེས་དེད་བྱས་ཏེ་ཁོ་པ་བོད་པའི་འབྲོག་པ་ཞིག་ནང་ཡོད་པ་དང་འཇུ་བཟུང་བྱས་ཏེ་ཕྱིར་དམག་སྒར་ལ་ཁྲིད།",
    "སྐབས་དེར་བོད་ཟླ་༡༡ པའི་ཚེས་༤ དགོང་དྲོའི་དུས་ཚོད་ལ་ཏག་ཏག་ཁེལ་འདུག།",
    "དེའི་མཚམས་སུ་སྐུ་ཞབས་སད་སྲུང་དང་སྐྱ་ལུ་ཚེ་འཕེལ་སོགས་བྲག་གདོང་ཞིག་འདུག་པར་བཞག་ནས་དེ་རྗེས་བྱུང་བར་རྒྱག་རྒྱུ་བྱས།",
    "འཐབ་ར་ས་བཟང་བས་མི་ཐུབ་བསམ་པ་ཞེ་ལ་མི་འདུག།",
    "སྐབས་དེར་ཁོང་གཉིས་ལ་མདའ་བརྫང་ཁོམ་ཡོད་མེད་ཀྱི་དཀའ་ངལ་བཟོས་འདུག།",
    "ཕར་བརྒྱབ་པ་རྩིས་པས་མདེའུ་དྲུག་སྟོང་ཙམ་རྫོགས་འདུག།",
    "རྒྱང་ཤེལ་བཞི་ཙམ་ཐོབ་འདུག།",
    "དེར་ཡོད་མི་སེར་རྣམས་དང་རང་དམག་རྣམས་ཀྱིས་རྒྱ་མིའི་ཆུ་ཚོད་ཝ་སི་ཀྲན་དང་རོ་མ་བཅས་ལེན་གང་ཐུབ་བྱས།",
    "རང་དམག་རྣམས་ལ་ཐོབ་ཚད་ཡར་རུབ་སྟེ་འདྲ་མཉམ་བགོ་འགྲེམས་བྱས་པས་བསྡོམས་པས་ཆུ་ཚོད་དྲུག་ཅུ་ལྷག་ཐོབ་འདུག།",
    "ཨ་འཚོང་དངོས་གྲུབ་བཅས་ཁ་ཤས་ཀྱིས་བརྒྱབ་ཤེས་ཀྱི་འདུག་པར་ཁོ་ཚོར་ཅིས་རྐང་མདེའུ་སྤོམ་ཚོད་བྱས་ནས་སྤྲད་ཅིང་དེར་མེད་པ་རྣམས་ལ་ཅིས་རྐང་དང་མདེའུ་བསྐྱལ་དུ་བཏང་།",
    "ལོག་སྤྱོད་པ་ག་ཚོད་བསད་འདུག་ཅེས་དྲིས་པས།",
    "གཅིག་ཀྱང་བསད་འདུག་པ་མ་མཐོང་ཟེར་བས་རྒྱ་རྣམས་ཁྲོས་ནས་རྐང་པ་བརྡབ་བཞིན་སྨྲེ་ངག་འདོན་འདུག་ཟེར།",
    "དེར་གོང་དཀར་ཡུལ་དགོན་གཉིས་ཀྱི་སྐྱ་སེར་ཐམས་ཅད་ཁྲིད་ནས་རྒྱ་དམག་རྨས་མ་ཡོད་ཚད་དགོན་དུ་དབོར་བཅུག་འདུག་པས་དམག་མི་ཉིས་བརྒྱ་ཙམ་ལ་མེ་མདའ་མ་ཕོག་པ་གཅིག་ཀྱང་ལུས་མི་འདུག་ཟེར།",
    "རྒྱབ་རི་ཐོག་རང་དམག་བཅོ་ལྔ་སྐོར་ཡོད་འདུག་ཀྱང་ཅིས་རྐང་ཆད་མེད་བརྒྱབ་ནས་རྒྱ་མང་པོ་དུས་གཅིག་ཏུ་དེར་རྒྱུག་རྐྱེན་རི་མགོ་རྒྱ་མིར་ཤོར་གྲབས་བྱས་ཏེ་ཕལ་ཆེར་དེ་ཕྱོགས་སུ་རང་དམག་རྟ་པ་སུམ་བརྒྱ་ལྷག་ཙམ་ཡོད་པ་ཤོར་ཉེན་བྱུང་སྐབས།",
    "གཞན་དུ་ན་དེ་སྐབས་མུ་མཐུད་ནས་དེ་ལྟར་བྱུང་ཡོད་ན་དགྲ་ཕྱོགས་སེམས་ཐུགས་ཆག་དགོས་པ་དང་རང་ཕྱོགས་ང་རྒྱལ་དང་སེམས་ཤུགས་འཕར་དགོས་པའི་ཉམས་ཆེན་པོ་ཞིག་འོང་བ་ཡོད་སྙམ།",
    "སྐབས་དེར་ཉག་རོང་སྐལ་བཟང་རྡོ་རྗེ་ཅན་རྟ་དམག་བཅུ་གྲངས་ཤིག་བྱང་སྐྱོད་དམག་དཔུང་ནས་ཁ་འཐོར་ནས་དེར་འབྱོར་འདུག།",
    "བཀྲ་ཤིས་ཁ་རིང་མང་ཆེ་བ་ཁྱེར་ནས་དྭགས་པོ་བར་ཕྱིན་ནས་བསྡད་འདུག་པ་དང་།",
    "ཁོང་ལ་སྲུང་སྐྱོབ་ཆེད་དུ་ཡིན་ཞུས་ཏེ་མེ་མདའ་བཀྲ་ཤིས་ཁ་རིང་གསར་པ་གསར་རྐྱང་བརྒྱ་ཐམ་པ་དང་ཀྲིང་གྷན་བཞི་མེ་སྒྱོགས་གཉིས་བཅས་ཕུལ་འདུག་པ་ལས་སྐུ་འཁོར་རྣམས་ཀྱིས་མེ་མདའ་ལྔ་བཅུ་དང་མེ་སྒྱོགས་གཅིག་བཞེས་ཏེ་དེ་མིན་ཆུ་སྒང་ལ་ཕྱིར་གནང་མཛད་པ་གོ་ཐོས་བྱུང་བའི་གནས་ཚུལ་ཞིབ་པར་དེབ་སྨད་ཆར་གསལ།",
    "ཚང་མས་ཡང་བསྐྱར་ངེད་གཉིས་འོལ་ཁ་རྫིང་ཕྱིར་འགྲོ་དགོས་པར་བསམ་ཚུལ་གཅིག་གྱུར་འདུག་པར་ལྟར།",
    "ད་མ་འོངས་པའི་འཆར་གཞི་གང་ཡོད་སོགས་སྐད་ཆ་མང་པོ་དྲི་བཞིན་འདུག།",
    "ཁག་ནི་ཁག་མི་འདུག་གསུངས།",
    "མ་ཚད་ང་ལྷ་སར་ཕྱིན་པས་གནས་ཚུལ་ཚང་མ་ཛ་དྲག་ཆེན་པོར་ཐུག་ཚར་འདུག།",
    "དེ་འདྲ་ཡིན་སྟབས་དགོངས་པ་ཡག་པོ་བཞེས་དགོས་ཀྱི་འདུག་ཅེས་ཞུས་ཀྱང་ཁོང་རྣམས་ནས་སྦྱིན་བདག་བསུ་བར་འགྲོ་རྒྱུ་དེ་ཐག་ཆོད་གཙང་མ་བྱས་ཚར་བ་ཡིན་གསུངས་ནས་ཉན་གྱི་མི་འདུག།",
    "ལྷོ་ཁའི་གོ་ལག་ཡོད་ན་མེད་ན་ཚང་མ་འདིར་སླེབས་འདུག།",
    "ཆ་ཕྲེང་ཕེ་གྲུང་ཟླ་བ་སྐབས་དེར་གསར་དུ་བསྐོས་འདུག།",
    "ཡིན་ན་ཡང་རྒྱ་དམག་འགའ་ཤས་བསད་པ་ལས་དེ་མིན་ས་འོག་ཏུ་དགྲ་ཁང་བཙན་སྟབས་ལེན་མ་ཐུབ་པར་ལུས་འདུག།",
    "དེའི་སྐབས་སུ་བོད་མི་སོ་པ་མང་པོ་ཡོད་སྟབས་རང་དམག་ཚོས་དམག་བྱུས་བཀོད་འདོམས་སྐབས་འདུ་འཛོམས་བྱེད་སའི་ཁང་པ་ལྟེ་བ་བཅས་སུ་ས་ཐིག་ལེན་ནས་རྒྱ་མིས་མེ་སྒྱོགས་མང་པོ་བརྒྱབ་འདུག།",
    "སྔོན་ལ་ཕྱིན་ཚར་བ་རྣམས་མ་གཏོགས་དེ་མིན་རྣམས་འགྲོ་རྩིས་མི་འདུག།",
    "ཉ་ཀྲིང་སྟོང་པ་རྣམས་གཟེ་མ་ར་མགོའི་རྩེར་བཏགས་ནས་གཟེ་མ་ར་མགོར་ཐུག་པ་ཙམ་གྱིས་ལྕགས་ཀྲིང་སྐད་བརྒྱབ་ཐུབ་པ་བཟོས་འདུག།",
    "རྩེད་ཐང་རྡོ་རྗེ་ཟེར་བའི་ཁང་པའི་ནང་ལ་རྒྱས་དམག་སྒར་བཟུངས་ནས་བསྡད་དེ་ཁང་པའི་ནང་ནས་ཚུར་མེ་མདའ་མང་པོ་རྒྱག་བཞིན་འདུག།",
    "རྡོ་རྗེའི་ཁང་པའི་གཡས་གཡོན་བཅས་སུ་བཞག་ནས་ཞོགས་པ་སྔ་པོ་གསང་ཐག་འཐེན་པས་དེར་ཁང་པ་རྩ་གཏོར་བྱས་པས་སྐབས་དེར་རྒྱ་དམག་ཡང་བཅོ་ལྔ་ཉི་ཤུ་སྐོར་བསད་འདུག་རྒྱ་མིའི་ལག་ཆ་ཡང་བཅོ་ལྔ་ཉི་ཤུ་སྐོར་རག་བྱུང་བ་མ་ཚད་རྡོ་རྗེའི་ཁང་པ་ཐོབ།",
    "ཕ་རིར་མི་ཁ་ཤས་ལས་དོན་མ་ཐུབ་པས་ཐད་ཀར་མཆོངས་རྒྱུག་བྱེད་བཅུག་ཀྱང་རང་དམག་གྲོན་རྒྱུ་ལས་ལས་དོན་མི་འགྲུབ་པ་ཤེས་ཏེ་ཕྱིར་འཐེན་བྱས།",
    "ཁེ་གསུམ་ཁེ་སྨད་ཀྱི་གཞིས་ཁར་བཞག་ཡོད་པའི་རྨས་མ་རྣམས་མང་དུས་ལྔ་བཅུ་ལྷག་དང་ཉུང་དུས་༧བཞི་བཅུ་སྐོར་ཆགས་ཀྱི་འདུག།",
    "ད་འབོམ་བརྒྱབ་ནས་ཕར་གཏོར་ན་མ་གཏོགས་རྒྱ་མིས་ཚུར་གཏོར་བའི་ཉེན་ཁ་འདུག་ཅེས་བརྗོད་ནས་ཞེད་སྣང་བྱེད་བཞིན་འདུག་པར།",
    "ཟ་རྒྱུ་ནི་འབྲས་དང་ཕག་ཤ་ཟ་གང་ཐུབ་འདུག།",
    "དེ་ཚོ་དྲན་གྱི་མི་འདུག་གམ།",
    "མེ་མདའི་མདེའུ་ནི་ཁང་མིག་མང་པོ་བསྐངས་ནས་བཞག་འདུག།",
    "མདེའུ་གྲངས་བརྒྱ་ཐམ་པ་བསྐུར་གནང་འདུག་པ་ལག་སོན་བྱུང་།",
    "ད་དུང་ཤེས་རབ་ཁྱེད་རང་ཁྲི་བྱང་བླ་བྲང་ནང་འགྲོ་ཐུབ་ན་ཡག་པོ་འདུག།",
    "མགྲོན་ཆེས་ཕེབས་ལམ་དེ་ཡག་པོ་འདུག།",
    "ཚེ་འཕེལ་ཁྱེད་གཉིས་ཕྱིན་ཚར་བའི་རྗེས་སུ་ཉིན་བཅོ་ལྔ་ཉི་ཤུ་ཙམ་ནས་ལྷ་རི་མགོ་ནས་ཡར་ལྷ་སར་ཨ་དྲུང་ཞིག་འབྱོར་ནས་དེའི་གདོང་ལ་མགོན་པོ་བཀྲ་ཤིས་ཀྱིས་ང་ལ་ཕྱག་བྲིས་ཤིག་བསྐུར་འདུག་ཁོང་མེ་སྒྲོགས་ཀྱིས་རྨས་སྐྱོན་ཕྲན་བུ་བྱུང་བ་དེ་ཡག་པོ་དྲག་བསྐྱེད་བྱུང་ཡོད་ཚུལ་སོགས་དེ་ཕྱོགས་ཀྱི་གནས་ཚུལ་གང་ཡོད་ང་ལ་འབྱོར་བྱུང་།",
    "ཡང་༧གོང་ས་མཆོག་ནས་མེ་སྒྱོགས་དེ་བཟང་ངན་གང་འདྲ་ཞིག་འདུག།",
    "མེ་སྒྱོགས་རྣམས་ཤིན་ཏུ་ཡག་པོ་འདུག་ཅེས་ཞུས།",
    "ཨ་འབྲུག་མགོན་པོ་བཀྲ་ཤིས་ག་པར་ཡོད་མེད་ཤེས་ཀྱི་འདུག་གམ་ཞེས་བཀའ་རྩད་གནང་བར།",
    "གུས་ནས་ལྕགས་ར་དཔལ་འབར་ཕྱོགས་ནས་སྦྱིན་བདག་ཡར་ཕེབས་ཀྱི་ཡོད་པ་གོ་རྒྱུ་འདུག་ཞུས་པས།",
    "ཡང་༧གོང་ས་མཆོག་ནས་ལི་ཐང་ཤོག་དྲུག་༧སྐྱབས་མགོན་སྐོར་གང་ཡང་གོ་རྒྱུ་འདུག་གམ་ཞེས་བཀའ་ཕེབས་སྐབས།",
    "ད་ང་རང་ཤི་ནའང་འགྱོད་པ་གཏན་ནས་མེད་ཅེས་ཞུས་པས།",
    "རྟ་དྲེལ་ལ་རྨིག་ལྕགས་མེད་ན་རྟ་དྲེལ་རྣམས་འགྲོ་རྒྱུ་ཧ་ཅང་ཁག་པོ་འདུག་ཅེས་གསུངས་འདུག།",
    "དེ་མིན་ད་དུང་ར་མ་སྒང་གྲུ་ཁ་ནས་རྒྱ་དམག་སྟོང་དམག་འགའ་ཤས་ཤིག་ཤར་རྒྱག་རྩེད་ཐང་ལ་དམག་སྣོན་དུ་དམིགས་ཏེ་བཏང་འདུག།",
    "དེའི་དགོང་དྲོ་ཆུ་ཚོད་བདུན་པའི་ཐོག་རྩེད་ཐང་རང་ལ་ཡོད་པའི་འབའ་པ་དམག་སྤྱི་རྒན་ཨ་ལེགས་དང་།",
    "མེ་སྒྱོགས་བརྒྱ་དཔོན་ཆ་ཕྲེང་ཀོ་བ་བསྟན་པ་རྒྱལ་མཚན་ཤོག་ཁག་གཉིས་ཕྱིར་འཐེན་བྱས་ནས་ཕྱིན་ཚར་འདུག།",
    "དེ་འབྱོར་སྐབས་དེར་ཡོད་རྣམས་ལ་ལན་འཕྲོད་མི་འདུག་ཁོང་རྣམས་སྔར་བཞིན་འཛིང་ར་ནང་སོ་བསྲུང་ནས་བསྡད་འདུག།",
    "དར་དགོན་དམག་སྤྱི་དཔའ་ཆེན་ཁོང་རྣམས་ལ་མགོ་དམག་གྲངས་བརྒྱ་དང་བཞི་བཅུ་སྐོར་འདུག།",
    "རྟའུ་ནོར་བུ་བཅས་བསྡད་འདུག་པ་ལས།",
    "དམག་མི་དྲུག་ཅུ་ཙམ་མ་གཏོགས་མང་ཆེ་བ་ཁེ་གསུམ་གཞིས་ཁར་བཤར་ཟིན་འདུགསྐབས་དེར་ནམ་ལངས་ཙམ་གྱི་དུས་ཚོད་ལ་སླེབས་པས་ཕར་བལྟས་པས་མགོན་པོ་རི་བརྒྱུད་ནས་ཚུར་རྒྱ་མི་རྐང་དམག་གྲངས་གཅིག་སྟོང་ཙམ་དང་།",
    "བཤར་ཟིན་པའི་རང་དམག་རྣམས་གཅིག་ཀྱང་ཕྱིར་འོང་མཁན་མི་འདུག།",
    "གཙང་པ་སྤྲེལ་ཟུར་ཇོ་ལགས་ཁོང་རྣམས་ཞེད་སྣང་ཆེན་པོའི་ཐོག་དེ་འདྲ་མ་བྱེད་རོགས་ཟེར་ནས་ངའི་གཡས་གཡོན་ནས་བཟུང་སྟེ་ང་ལ་ཞུ་བ་མང་པོ་འཐེན་གྱི་འདུག།",
    "རྨས་མ་རྣམས་ལ་རོགས་ཕན་ཡག་པོ་གནང་འདུག་དེར་བརྟེན་ཁོ་རང་མཚོ་སྣ་བརྒྱུད་རྒྱ་གར་ལ་སླེབས་ཐུབ་པ་བྱུང་ཡོད།",
    "མེ་སྒྱོགས་རྒྱག་ས་ཐག་རིང་ཡིན་སྟབས་ཕར་མེ་མདའ་རྒྱག་ས་གང་ཡིན་ཤེས་ཀྱི་མི་འདུག།",
    "གོ་ལག་རྫས་མདེལ་ཡང་ཟད་མེད་ཇེ་མང་དུ་འབྱོར་བཞིན་འདུག།",
    "དེ་མིན་རང་དམག་ཤི་རྨས་གང་འཚམས་བྱུང་འདུག་པ་ལས་འཛིངས་ཚུལ་ཞིབ་པར་མ་ཤེས།",
    "སེར་སྐྱ་མི་མང་རྣམས་ཕེབས་ལམ་གཙང་མ་བཟོ་ཐུབ་ཡོད་པ་ལ་བརྟེན་ནས་ང་རང་དགའ་པོ་བྱུང་།",
    "སྐབས་དེར་གངས་ཡང་ཆེན་པོ་བབས་པར་བརྟེན་ལམ་བར་ལ་རྒན་ཡེ་ཤེས་མགོ་དམག་རྣམས་དེ་གའི་རི་ཁུག་ཞིག་ལ་ཚུགས་བབས་ནས་བསྡད་འདུག།",
    "ཕྲན་རང་དང་རྒྱ་བློ་བཟང་བཀྲ་ཤིས་གཉིས་ཀྱིས་འགན་ཁུར་བྱས་ཏེ་དང་བླང་བྱེད་མཁན་དམག་མི་ག་ཚད་འགྲོ་ཐུབ་མིན་གྱི་གྲངས་ཐོ་ལེན་སྐབས་དམག་མི་ལྔ་བརྒྱ་ཙམ་ལས་འོང་ཐུབ་ཀྱི་མི་འདུག།",
    "དེ་ཙམ་མ་ཚད་ཟ་ཆས་ཀྱང་གྲ་སྒྲིག་ཆ་ཚང་བྱས་འདུག་པས་དམག་ཕོགས་ལེན་པ་ཇི་བཞིན་བྱས་ཏེ་ལྟོ་ཤོག་གྲངས་ཀ་གང་ཡོད་ཐོག་ནས་བཟའ་བཅའ་ལེན་ཆོག་པ་བྱུང་།",
    "ཁམས་བར་གྱི་སྐྱེས་པ་ལོ་ངོ་༡༤ ཡན་ཆོད་དང་ མན་ཆོད་དམག་མི་ཁྲི་ཕྲག་གཉིས་བརྒལ་བ་བསྡུས་ཏེ་བྱང་ཨ་རི་གསང་ལས་པའི་གོ་ལག་མདེལ་རྫས་གནམ་གྲུ་གསུམ་སླེབས་པ་མ་ཚད་ཁམས་དཔའ་ཤོད་བོད་གཞུང་གོ་མཛོད་ཁང་ནས་གོ་ལག་བཏོན་ཏེ་རྒྱ་དམར་བཙན་འཛུལ་དམག་དཔུང་ལ་རྒོལ་ལན་དམག་འཁྲུག་ཚབས་ཆེན་བྱས་པས་དབུས་ཕྱོགས་སུ་ཡོད་པའི་རྒྱ་དམག་ཕལ་ཆེར་དེར་ཕྱོགས་དམག་སྣོན་མ་བཏང་ཐབས་མེད་བཟོས་ཏེ་རྩེད་ཐང་མ་གཏོགས་དབུས་ཕྱོགས་སུ་རྒྱ་དམག་ཕལ་ཆེར་མེད་པ་ས་ཆ་གཙང་མ་གཙང་རྐྱང་རང་བཞིན་གྱིས་ཆགས་དགོས་པ་བཟོས།",
    "སྐབས་དེར་བསད་རྨས་བྱུང་བ་ཁོ་བོས་ཤེས་ཚད་དྲན་ཚད་ཁག་ཅིག་བཀོད་པ་ལས་ཞིབ་འཇུག་དང་བསྡུ་ལེན་བྱས་ཏེ་བཀོད་པ་ཞིག་མིན་པས་ད་དུང་ཅི་མང་ལྷག་སྲིད་པས་མ་འཁོད་པ་འདུག་ན་དགོངས་འཚོམ་དང་འཁང་ར་གནང་མི་ཉན་ལགས།",
    "ཞེས་བཀོད་འདུག།",
    "མི་ལག་དུས་ཚོད་སོགས་དེ་ཙམ་འཛོམས་པོ་མེད་པའི་དཀའ་བ་ཁྱད་དུ་བསད་དེ།",
    "ལས་ཁང་དེའི་འགན་གཙོ་བོ་ནི་ཐེ་ཝན་གྱི་དམག་དོན་མི་སྣ་ལ་རྒོལ་ལན་སྤྲོད་རྒྱུ་ཡིན་ཚོད་འདུག་བརྒྱད་པ།",
    "དམིགས་ཡུལ་གཙོ་བོ་ནི་ཐེ་ཝན་དང་འབྲེལ་བ་ཡོད་པའི་རྒྱ་རིགས་ནང་འགུགས་བསྡུ་ལེན་གྱི་ལས་འགན་སྤེལ་གྱི་ཡོད་ཚོད་འདུག་བཅུ་གཅིག་པ།",
    "གཉིས་འབུམ་གཉིས་ཁྲི་ཆིག་སྟོང་༢༢༡ ལ་རྨས་སྐྱོན་ཕོག་ཡོད་པར་བརྗོད་འདུག་ཏིང་ཞའོ་ཕིན།",
    "རྒྱ་ནག་གཅིག་པོའི་ཤི་གྲངས་ཧ་ལམ་བཞི་འབུམ་ཟིན་ཡོད་པར་བརྗོད་འདུག་ཨ་ཏར་མན།",
    "གྱི་སྟ་གོན་བྱེད་ཀྱིན་འདུག་ཚུལ་བརྗོད་ཡོད།",
    "རྒྱལ་ཁབ་དེ་གཉིས་ཀྱི་དབར་འབྱེད་ཆུ་བོའང་ཡིན་འདུག་ཕྱོགས་གཉིས་ཀྱིས་དམག་མི་སྟོང་ཕྲག་ཁ་ཤས་འཐབ་ཞུགས་བྱས་མཐར།",
    "ལི་ཁྲ་ཏུ་ཝེ་ཆེས་ཕྱི་ལོ་༡༩༨ལོར་བརྩམས་པའི་དཔེ་དེབ་སོགས་ན་ཡོད་ཚོད་འདུག་རྗེས་སུ་དམར་ཤོག་རྒྱལ་ཁབ་དེ་གཉིས་དབར་གྱི་འབྲེལ་བ་རྒྱུན་ལྡན་ཞིག་ཏུ་གྱུར་རྗེས།",
    "རྒྱ་དམར་ཕྱོགས་ནས་དུས་ད་ལྟའང་རང་ཉིད་སྲུང་སྐྱོབ་ཆེད་སྤེལ་བའི་འཐབ་འཁྲུག་ཡིན་ཚུལ་དྲིལ་བསྒྲགས་ཀྱིས་མི་མང་ལ་མགོ་སྐོར་བཏང་ཡོད།",
    "དེ་མཚུངས་ཀྱི་དོན་རྐྱེན་མང་པོ་ཞིག་ས་གནས་དེར་བྱུང་འདུག་ཤིན་ཅང་དང་།",
    "ཅེས་སྨྲས་མ་ཐག་སློབ་གྲོགས་ལོག་ཐོས་ཚེ་རིང་ཡར་ལངས་ཏེ་རང་རྒྱལ་གཅིག་པུར་མི་རིགས་ང་དྲུག་ཙམ་འདུག་པས།",
