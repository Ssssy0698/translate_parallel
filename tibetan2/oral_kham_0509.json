    "མེ་དེ་འདྲེས་ནས་འདུག་པས་ཤིན་ཏུ་སྐམ་དྲག་པ་དང་རིང་བར་ཆུ་འགྲམ་དུ་རྒྱུག་སྟེ།",
    "འདུག་པར་ཁས་བླངས་ནས་ནི་དེར་བསྡད་དོ།",
    "ནོར་བུ་འདོད་པ་ཀུན་འབྱུང་ཕོག་འདུག་པས།",
    "བདག་ནི་ལོ་འཁོར་སུམ་ཅུ་སོ་དགུར་འདུག།",
    "ཞེས་གསུངས་ནས་ཁོང་རང་མཚམས་སུ་བསྡད་ནས་མཚམས་ཁང་ལ་ཆོད་བྱས་ཏེ་ཁོང་རང་ཅན་དུ་སྒེའུ་ཁུང་གཅིག་བཞག་ནས་འདི་སྐད་དུ།",
    "དེ་ནས་སློབ་དཔོན་དཔའ་བོའི་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ཏེ་འབོལ་བའི་སྟནལ་འདུག་ནས་བུམ་པ་ཆུས་བཀྲུས་ཤིང་ནིཨོ་ཏ་བྷེ་ཏ་སྟེ་མ་ཧཱ་ཏ་བྷེ་ཧཱུྃསྭཱཧཱ།",
    "མངལ་ནས་ཀུན་མཁྱེནབཀའདུག་སྐྱེས་ནས་ལུས་ངག་ཡིད་གསུམ་རྫོགས་པ་བཞིན་དུ་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་བརླབ།",
    "འཇུག་དུས་དེ་ཉིད་ཀྱིས་སྔར་གྱི་རང་མལ་དུ་སློབ་གནས་དུས་དེ་ཁར་བསྡད་པར་བསམས་པ་ཕྲོ་བའོ།",
    "ཙ་ན་གྲུབ་ཅི་འགྲུབ་པའི་བརྡ་སྤྲད།",
    "བདག་ཅག་དུས་འདི་ནས་གཟུང་ནསཔས།",
    "ནང་དེ་ནས་རྡོ་རྗེ་སློབ་དཔོན་ནུབ་ཏུ་འདུག་ནས།",
    "ཁྱེད་རང་རྣམས་འཇིགས་བྱེད་དུ་གསལ་བའི།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཚོགདོན་བགེགས་ཀྱིས་ཕྲོགས་ཤིང་ཉམས་པ་དད་༦ པ་སྦས་པ།",
    "ཚོགས་ཞིང་རངབཞིནགྱི་གནས་སུ་གཤེགས།",
    "རྡོ་རྗེསེམས་དཔའི་ཕྱག་ན་འདུག།",
    "གལ་ཏེ་ཚེ་འགྲོ་འདུག་གྱུར་ན།",
    "འདུག་སྟངས་དེ་ཉིད་ཀྱི་སྟེང་ནས་འཕོས་བརྡབ་པས་འབེབས་བ་སྟེ།",
    "ཨོཾ་བཛྲཔོ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་ཨཾ་ཨ་ཙིཨ།",
    "དེ་ཡང་བདེ་བའིསྟན་ལ་འདུག་ནས།",
    "ཁྲོ་བོ་གཏུམ་པོ་གདུག་པ་འདུག།",
    "ཚོགས་ཞིང་རང་ལ་བསྟིམ།",
    "དབུང་ཀུན་མཁྱེན་བཀའབུམཔ་གཉིས་ཕྱི་ཟུར་གཉིས་སུ་ཨེ་ཝཾ་མ་ཡཱ་ལས་མེ་ཏོག་འདུག་པ་མར་མེ་དྲི་ཆབ་ཀྱི་ཁྱུང་།",
    "ཞིབ་ལ་ཙོག་པུའི་འདུག་སྟངས།",
    "དྲག་པོ་ལ་ཁྲོ་བོའི་འདུག་སྟངས་ཀྱིས་བྱ་ཞིང་།",
    "བཅུ་གཅིག་བཟློག་དུས་ཀ་མ་ལ་མིག་འབྲས་གཉིས་གཡོན་དུ་ཕྱོགས་པས་བསྲེག།",
    "ཉེ་བ་ནི་ཡུལ་རུང་བ་ན་འདུག་པའོ།",
    "མི་ཉེ་བ་ནི་ཡུལ་རུང་བ་མ་ཡིན་པ་ན་འདུག་པ་དང་།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་རྣམས་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་དག་སྟེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པ་ཞེས་བྱ་བ་དེས་ནི་རང་བཞིན་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་མེད་པར་སྟོན་པར་བྱེད་དེ།",
    "གང་དག་འགའ་ཞིག་ཉེ་ན་ཡང་དེ་ཁོ་ན་བཞིན་དུ་འདུག་སྟེ།",
    "དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་དག་ལ་ནི་དེ་མི་སྲིད་ཅེས་བྱ་བ་སྨོས་ཏེ།",
    "དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་གང་དག་ཡིན་པ་དེ་དག་ནི་དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་རྣམས་ཏེ།",
    "འདུག་པ་ནི་རྣམ་པར་གནས་པའོ།",
    "དེ་དང་འབྲེལ་པ་ཅན་གྱི་རང་བཞིན་ཅན་ཙམ་གྱི་རྗེས་སུ་འཇུག་པའི་དང་ཅན་དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ཉིད་ཅེས་བྱ་བ་སྨོས་ཏེ།",
    "དེའི་ཡུལ་ན་འདུག་པ་ནི་དེའི་ཡུལ་ན་འདུག་པའོ།",
    "དེ་ནི་དེའི་ཡུལ་ན་འདུག་པ་ཡང་ཡིན་ལ་རང་བཞིན་ཡང་ཡིན་པས་དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ནོ།",
    "དེའི་དངོས་པོ་ནི་དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ཉིད་དེ།",
    "ཡང་བྱེ་བྲག་ནི་འབྲས་བུ་དང་རང་བཞིན་གཉིས་ན་སྐྱེ་བ་དང་།",
    "ལྟ་བར་མ་ཞུགས་པ་ན་རུང་བའི་ཡུལ་ན་འདུག་ཀྱང་བལྟ་བར་བྱ་མི་ནུས་པ་ནི་རྐྱེན་གཞན་དང་བྲལ་བ་ཅན་ཡིན་ལ།",
    "ཡུལ་དང་དུས་རིང་པོ་དང་འདུག་པེ་ནི་གཉི་ག་དང་བྲལ་བ་ཡིན་ནོ།",
    "རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ཀྱང་རང་བཞིན་དུ་ངེས་པ་ཡིན་ཏེ།",
    "དེ་ལས་བྱུང་བའི་རྟགས་ཀྱང་བསྒྲུབ་པར་བྱ་བའི་དོན་དང་རང་བཞིན་འབྲེལ་པ་ཡིན་ནོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གཉིས་ཁོ་ན་ཇི་ལྟར་གོ་བར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "འདིར་རྐྱེན་གཞན་ཚོགས་པ་དང་རང་བཞིན་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར་དམིགས་པའི་རིག་གྱུར་པའི་དོན་བསྟན་ལ།",
    "གཉིས་ལས་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པ་ཞེས་བྱ་བས་ནི་རང་བཞིན་གྱིས་བསྐལ་པ་བསྟན་ཏོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་དང་དེ་རྣམས་ཀྱིས་བསྐལ་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "ལྟ་བ་པོས་ཀྱང་དེ་ནས་འདུག་པའི་ཤིང་མཐོང་དུ་ཟིན་ཀྱང་ཤིང་ཤ་པ་ལ་སོགས་པ་བྱེ་བྲག་ནི་ཁོང་དུ་མ་ཆུད་པ་གང་ཡིན་པ་ལྟ་བ་པོ་དེ་ལ་ཤིང་ནི་མངོན་སུམ་དུ་གྱུར་པ།",
    "དེ་ལྟ་ན་མེད་པར་བསྒྲུབ་པ་འདི་ནི་རྟོགས་པར་བྱེད་པ་རྒྱང་རིང་པོ་ན་འདུག་ལ།",
    "དེ་བས་ན་དངོས་པོ་མེད་པར་སྒྲུབ་པ་འདི་ནི་རྟོགས་པར་བྱེད་པ་རྒྱང་རིང་པོ་ན་འདུག་ལ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གསུམ་གྱིས་བསྐལ་པའི་ཡུལ་གང་ཡིན་པ་བསྐལ་བའི་ཡུལ་ཡིན་པ་དེ་ནི་ཐེ་ཚོམ་གྱི་རྒྱུ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ལ་ཡང་དེ་ཁོང་དུ་ཆུད་པར་འགྱུར་བས་ཕྱོགས་མི་བསྟན་ཏོ།",
    "སྒྲུབ་པར་འདོད་པའི་དོན་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དང་གྲགས་པ་དང་རང་བཞིན་ཚིག་རྣམས་ཏེ།",
    "གྲུབ་པ་ལས་བཟློག་སྟེ་ཕྱིན་ཅི་ལོག་ཏུ་འདུག་པའི་རྒྱུས་བསྒྲུབ་པར་བྱ་བ་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "རི་སུལ་མང་པོ་ཕན་ཚུན་བསྣོལ་བར་འདུག་པ་ལ།",
    "ཡུལ་ཐམས་ཅད་ན་གནས་ཤིང་འདུག་པ་ནི་ཐམས་ཅད་ན་གནས་པ་སྟེ།",
    "དེས་ན་སྣང་བ་དང་ཉེ་བར་འདུག་པ་གང་ཡིན་པ་དེ་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "དེ་བས་ན་འདི་གཉིས་ཀྱི་ནང་ཁོ་ནར་འདུག་པ་ཡིན་ནོ།",
    "དཔེ་དགོད་དེ་བདག་དང་བཅས་པར་འདུག་པ་ནི་བདག་དང་བཅས་པར་འདུས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "བདག་དང་ལྷན་ཅིག་ཏུ་འདུག་པ་ནི་བདག་དང་བཅས་པའོ།",
    "བྱེ་བྲག་ཏུ་འདུག་པར་ངེས་པ་ནི་མེད་དོ་ཞེས་བྱ་བའི་དོན་འདི་ཡིན་ནོ།",
    "འབྲས་བུ་དང་རང་བཞིན་དེ་གཉིས་ཀྱི་མཚན་ཉིད་སྨོས་པ་ལ་ཞེས་བྱ་བ་ལ།",
    "དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་དག་ལ་ནི་མི་སྲིད་དེ་གནས་པ་ནི་དོན་དམ་པར་ཡོད་པའོ།",
    "དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་རྣམ་པར་གཞག་པ་གང་དག་ཡིན་པ་དེ་དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་དག་གོ།",
    "དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ཉིད་ཡིན་ནོ།",
    "དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་གང་ཡིན་པ་དེ་ནི་དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ཉིད་ཡིན་ཏེ།",
    "དེ་བས་ནི་སྤྱི་ནི་འབྲེལ་པ་ཅན་དེའི་རྗེས་སུ་འཇུག་པའི་ཡུལ་ཅན་དེའི་ཡུལ་ན་འདུག་པ་ཡིན་ནོ།",
    "དེ་ཇི་ལྟར་ན་འབྲེལ་པ་ཅན་ཡིན་པའི་ཕྱིར་དེའི་ཡུལ་ཉིད་ན་འདུག་པ་ཡིན་ཞེ་ན།",
    "ཁྱབ་པའི་མཚན་ཉིད་ཀྱི་འདུག་པའི་འགྲེལ་པར་ཡང་མི་འགྱུར་བ་ཞིག་ན།",
    "ཁྱབ་པ་ཡང་ཡོད་པ་དེ་བས་དེའི་ཡུལ་ན་འདུག་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེ་བས་ན་བྱེ་བྲག་ཏུ་ནི་འབྲས་བུ་དང་རང་བཞིན་གཉིས་སྐྱེ་བ་དང་།",
    "འོན་ཀྱང་རང་བཞིན་མི་དམིགས་པ་ཁོ་ནས་ཡིན་ནོ་ཞེས་བྱ་བ་བསྟན་པའི་ཕྱིར།",
    "རྟགས་དེ་ཡང་རང་བཞིན་དང་།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་།",
    "གདོང་རྙི་རྙི་བོར་འདུག་པ།",
    "འོན་ཏེ་འཇིག་པའི་རྒྱུས་བུམ་པ་ལ་མ་གཏོགས་པ་ངོ་བོ་ཉིད་གཞན་ཞིག་བྱེད་ན་དེ་ལྟ་ན་བུམ་པ་དེའི་སོ་ན་འདུག་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེའི་སོན་འདུག་ན་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་བཞིན་དུ་དེ་ནས་ཕྱུང་བའི་གནས་སྐབས་ནི་སྒྱེ་ན་འདུག་པའི་གནས་སྐབས་ཀྱི་རྒྱུ་ཅན་གྱི་བར་དུ་ཡིན་ནོ།",
    "སྒྱེ་ན་འདུག་པའི་གནས་སྐབས་མེད་པར་ཡང་དེ་ནས་ཕྱུང་བའི་གནས་སྐབས་མེད་ལ།",
    "འཇིམ་པའི་གོང་བུས་ནི་བུམ་པ་འཇིམ་པའི་ངོ་བོ་ཉིད་མ་ཡིན་པ་ཤིང་ལ་སོགས་པ་གང་དག་ཡིན་པ་དེ་དག་དང་མཚན་ཉིད་མི་མཐུན་པ་འཇིམ་པའི་ངོ་བོ་ཉིད་དུ་འདུག་པར་བྱེད་དོ།",
    "བཏང་སྙོམས་སུ་འཁོད་པ་ནི་གྱི་ན་འདུག་པ་བསྟེན་པའོ།",
    "འཇིག་པའི་རྒྱུ་རྣམས་དོན་མེད་པ་དེའི་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "འགལ་བའི་མཚན་ཉིད་ཀྱི་འབྲེལ་པའི་ཕྱོགས་འདི་ལ་ཡང་སྤྱི་བསྒྲུབ་པར་བྱ་བ་ཉིད་མ་ཡིན་པའི་ཉེས་པ་ནི་དེའི་སོ་ན་འདུག་པ་ཉིད་དོ།",
    "མེ་དོན་དུ་གཉེར་བ་འདུག་པར་ཡང་མི་བྱའོ།",
    "ཅི་འགྲོ་ན་རུང་ངམ་འོན་ཏེ་འདུག་ན་རུང་གཏོལ་མེད་དེ།",
    "རྟགས་ཉིད་དུ་བརྟག་པར་བྱ་བ་གཞན་ཡོད་པའི་ཡུལ་ཅན་གྱི་དམིགས་པ་དེར་ཡང་དངོས་པོ་མེད་པ་ལོགས་ཤིག་ཏུ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་པར་ཁས་ལེན་ན་འབྲེལ་པ་མེད་པ་དེའི་སོ་ན་འདུག་པ་ཉིད་དོ།",
    "གཏན་ཚིགས་ཀྱིས་ནི་མདུན་དུ་འདུག་ནས་ལག་པ་གཉིས་སྟོབས་ཡོད་མེད་ཀྱིས་དེ་ཁོ་ན་ལ་འཇུག་པར་བྱེད་པས་དེ་ཕན་ཚུན་དུ་ཕར་དྲངས་པས་ཏེ་པོར་ཉམ་ང་བར་གྱུར་ཏོ།",
    "འོ་ན་ནི་ཀྱེ་གཏན་ཚིགས་ནུས་པ་མེད་པ་དེའི་སོ་ན་འདུག་པ་ཡིན་ཏེ།",
    "དེ་ལ་འབྲས་བུ་དང་རང་བཞིན་དག་ནི་སྒྲུབ་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་དགག་པ་མི་བྱེད་ལ་མི་དམིགས་པ་ལས་ཀྱང་གཏན་ཚིགས་གཞན་མེད་པར་ངེས་པ་མ་ཡིན་ནོ།",
    "དེས་ན་རང་བཞིན་འགལ་བ་དམིགས་པ་དང་འབྲས་བུ་དང་རང་བཞིན་དང་མི་དམིགས་པ་ལས་ཐ་དད་པའི་དོན་རྣམས་ནི་གཏན་ཚིགས་མ་ཡིན་པར་ངེས་པའི་ཕྱིར་རོ།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "ཁོ་བོ་ཅག་མངོན་སུམ་གྱི་རྗེས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པས་ཀྱང་རང་བཞིན་གྱིས་འཁྲུལ་པས་སྤྱི་རྟོགས་ཏེ།",
    "འོན་ཏེ་རྗེས་སུ་འགྲོ་བ་ངེས་པ་གང་ཡིན་པ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ལ་བརྗོད་དོ་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "དེ་ཡང་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཉེ་བར་བསྟན་པ་ཉིད་ཀྱིས་ཐ་དད་པར་མ་བརྗོད་དོ།",
    "དེ་ལྟར་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་བྱེད་པ་དང་།",
    "ཡུལ་དང་དུས་དང་རང་བཞན་གྱིས་བསྐལ་པ་རྣམས་ལ་ཇི་ལྟར་དེ་བཞིན་དུ་ཡོད་པར་ངེས་པ་ཡིན།",
    "གལ་ཏེ་འགའ་ཞིག་སྟོན་པ་མེད་པ་དེ་ལྟ་ན་ཡང་རང་ཉིད་ཀྱིས་གཞལ་བྱ་རྣམ་པར་གཞག་པ་རྟོགས་པ་ན་རྟོགས་ཀྱི་རྗེས་སུ་འབྲང་བར་འདོད་དོ་ཞེ་ན།",
    "བཏང་སྙོམས་སུ་འདུག་པ་དང་།",
    "བསྟན་བཅོས་བྱེད་པ་ནི་ཡོད་པའི་སྤྱི་དང་བྱས་པའི་མཚན་ཉིད་ཀྱང་སྐད་ཅིག་མའི་རང་བཞིན་དུ་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་དུ་ཟིན་ཀྱང་དེའི་བདག་ཉིད་དུ་དངོས་པོ་ལ་གནས་པ་ཁོ་ན་སྟེ།",
    "རྒྱལ་དཔོག་པས་ཀྱང་ཅུང་ཟད་ཅིག་དུས་གཞན་དུ་གནས་པའི་མཚན་ཉིད་ཀྱང་ཐ་དད་པའོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་མི་དད་པར་ཁས་བླངས་པ་དེ་ཡང་མི་འཐད་པ་ཉིད་དེ།",
    "གང་དག་འབྲས་བུ་མི་སྐྱེད་པར་བཏང་སྙོམས་སུ་གྱིན་འདུག་པ་མ་ཡིན་པར་རྟོགས་པའི་ཕྱིར་ཁྱེད་ཀྱིས་རིགས་པ་བརྗོད་པ་འདི་ཡང་ཡོད་པར་བདེན་ནོ།",
    "ཞེས་བྱ་བའི་རིགས་པས་ཡུལ་རིང་པོ་ནི་འདུག་པ་ཡང་རྒྱུ་དང་འབྲས་བུར་འགྱུར་རོ་སྙམ་དུ་དོགས་པ་ན་ལྷན་ཅིག་བྱེད་པས་བྱས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "སྐད་ཅིག་མ་ཁོ་ན་འབའ་ཞིག་ཡོད་པ་དེ་ཡང་རང་ཉིད་ལྡོག་པས་ཐོ་བ་ལ་སོགས་པ་ལ་ལྟོས་པ་ནི་མ་ཡིན་ཏེ།",
    "བུམ་པ་སྤངས་པ་རྟོགས་པ་གང་ཡིན་པ་འདི་དག་དུས་ཕྱིས་གང་དང་གང་ཕྱོགས་འབའ་ཞིག་པ།",
    "དེ་ལྟ་ན་ཇི་ལྟར་མ་ལུས་པ་བསྡོམས་ནས་ཁྱབ་པར་བྱ་བ་དང་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་ལྡོག་པ་གྲུབ་པ་ཡིན།",
    "གནོད་པ་ཡོད་པ་མི་ལྡོག་པར་འདོད་པ་ནི་གཏན་ཚིགས་ནུས་པ་མེད་པ་གང་ཡིན་པ་དེའི་གནས་སྐབས་སུ་གནོད་པ་དམིགས་པ་གང་ཡིན་པ་སོ་ན་འདུག་པས་གཏན་ཚིགས་སྦྱོར་བ་མ་ཡིན་ནོ།",
    "ཡང་ན་འགྲན་ཟླའི་གཏན་ཚིགས་སུ་རིགས་ཀྱི་འབྲས་བུ་དང་རང་བཞིན་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་དུ་འགྱུར།",
    "ངོས་ཀྱི་དེ་བསམ་ཤེས་ཐུབ་ཀྱི་འདུག་འོན་ཀྱང་རྒྱ་ཆེ་ས་ནས་བལྟས་ན་འབོད་ཚིག་འདི་འོས་ཤིང་འཚམ་པ་ཞིག་ཏུ་མི་སྣང་།",
    "མང་གཙོ་ཚོགས་པ་དང་སྤྱི་མཐུན་ཚོགས་པའི་དབར་གྱི་འགལ་ཟླ་དབུལ་ཕྱུག་དབར་གྱི་འགལ་ཟླ་སོགས་བྱུང་འདུག་པ།",
    "སྐུ་ཉིད་ཀྱིས་གང་འགྲེལ་བརྗོད་གནང་བ་དེ་ནི་ཊམ་གྱིས་ལས་གཞི་དང་འགལ་འདུ་ལྟག་སྤྲོད་དུ་འདུག་པས་གང་ཉིད་སྐྱབས་བཅོལ་བ་བགྲེས་ཤོས་ཤིག་ཡིན་པའི་ཆ་ནས་འབྱོར་ལྡན་རྒྱལ་ཁབ་ཚོས་སྐྱབས་བཅོལ་བའི་དཀའ་ངལ་སེལ་ཆེད་གང་བྱེད་ཐུབ་བམ།",
    "ཅེས་གསུངས་འདུག་པ་དེའི་དགོངས་གཞི་གང་ལགས།",
    "གང་ཤེས་པ་དེ་མ་བསྒྲུབ་པར་ལུས་འགྲོ་བ་ཞིག་འདུག་དྲི་བ།",
    "ད་ལྟའི་ཆར་འདི་ལ་གདེང་འཇོག་བྱེད་མཁན་སྔར་བས་ཇེ་མང་དུ་ཕྱིན་འདུག།",
    "ངོས་ཀྱི་སེམས་ལ་རྒོད་པ་དང་ཞུམ་སེམས་ལྟ་བུ་ག་དུས་སྐྱེས་རུང་།",
    "ངོས་ཀྱི་མཐོང་ཚུལ་ཞིག་ལ་ད་ཆར་བདེ་སྐྱིད་ནི་བརྟག་དཔྱད་ཁང་དུ་འདུག་ཅིང་།",
    "རྩོམ་པ་པོ་སོགས་མང་པོ་འདུག་ཅིང་།",
    "ངོས་རང་གང་སར་འགྲུལ་བཞུད་བྱས་པའི་ཉམས་མྱོང་ལས་བཟོད་པ་དང་ཆོག་ཤེས་ཀྱི་ཡོན་ཏན་ནི་ཡར་ཐོན་ཅན་གྱི་རྒྱལ་ཁབ་དེ་ཚོ་ལས་དངོས་པོ་ཡར་ཐོན་དེ་ཙམ་མེད་པའི་རྒྱལ་ཁབ་ཚོའི་ནང་དར་ཁྱབ་ཆེ་བ་འདུག།",
    "འོན་ཀྱང་གཏན་འཁེལ་གང་ཡང་ཞུ་ཐུབ་ཀྱི་མི་འདུག།",
    "གདམ་ག་གཞན་ཞིག་ཡོད་པ་ངོས་ཀྱིས་གསལ་པོ་མཐོང་བཞིན་འདུག་ཅེས་བཀའ་སྩལ།",
    "གལ་ཏེ་གཉིས་ཀའང་རང་ལ་ལྟོས་ཏེ་རང་དོན་དུ་མཚུངས་ལ།",
    "བསྒྲུབ་པ་ཡང་རང་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པ་གཉིས་སུ་གནས་པས་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་གཉིས་སུ་ངེས་པ་ཡིན་ཏེ།",
    "རྒྱུ་དང་རང་བཞིན་མ་དམིགས་རྣམས་སུ་ཡོད་པའི་ཕྱིར།",
    "དོན་གྱི་ངོ་བོ་དང་རང་བཞིན་གྱི་ཁྱད་པར་ལ་སྐུར་བ་འདེབས་པའི་འཁྲུལ་པ་ཉིད་དཔེ་དང་བཅས་ཏེ་བརྗོད་པ་ནི།",
    "རིག་བྱེད་ཀྱི་སྒྲ་དེ་ནི་སྐྱེས་བུས་བྱས་པ་མིན་ཞིང་རང་རྒྱུ་བརྗོད་འདོད་ཀྱིས་དོན་ལ་བརྡ་སྦྱར་བ་མེད་པའི་ཕྱིར་རོ།",
    "དང་པོ་རང་བཞིན་གྱི་གཏན་ཚིགས་དང་རང་བཞིན་ངོས་གཟུང་བ་ནི།",
    "སྦྱོར་བ་དེ་མཐོང་བ་གོམས་པ་ལས་རང་ཉིད་ཀྱིས་བསྒྲུབ་བྱ་རྟོགས་པ་ན་ཡང་རང་དོན་དེ་ལྟར་དུ་འགྱུར་བར་བསྟན་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "རང་བཞིན་དང་འབྲས་བུ་གཉིས་ཀར་ཡང་རང་བཞིན་འབྲེལ་པ་ཁོ་ནས་ལྡོག་གོ།",
    "རྟེན་དང་རང་བཞིན་ཉིད་དང་ནི།",
    "གང་ཞིག་གང་ལ་གནས་ཤིང་རང་བཞིན་དུ་གྱུར་པ་ལ་ཡང་དེ་གདོན་མི་ཟ་བར་ངེས་པ་མ་ཡིན་ཏེ་ཇི་ལྟར་སྐད་ཅིག་འཇིག་པ་ལ་སོགས་པ་ལ་ཡང་ཇི་སྲིད་ངེས་པར་གྱུར་པ་དེ་སྲིད་མ་ངེས་པ་ཉིད་དུ་དཔྱོད་དོ།",
    "རང་བྱིན་བརླབ་དང་རང་འབྱུང་དང་།",
    "འདིས་ནི་སའི་མཚན་ཉིད་ལས་འཛིན་པ་དང་རང་བཞིན་སྲབ་ཡང་ངོ།",
    "ཁ་ཤར་དུ་ཕྱོགས་པས་ཉེ་བར་འདུག་ནས་དེའི་རྐང་པ་དང་ཉེ་བར་གཏོར་མ་དང་ཆུ་དང་མེས་གང་བའི་སྣོད་གསུམ་བཞག་སྟེ།",
    "ཞེས་པ་ལན་བདུན་བཟླས་པའི་གོས་དམར་པོའི་ཅོད་པན་ཅན་དབུས་སུ་འདུག་ནས་ཤར་དུ་ཁ་བལྟས་ཏེ།",
    "ཞལ་གཅིག་མའི་མདུན་དུ་འདུག་པ་ལ་མཆོད་ཡོན་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་དེ་གུས་པ་དང་བཅས་པར།",
    "དེ་ནས་ས་དེ་དྲི་ལ་སོགས་པས་བྱུག་ཅིང་མེ་ཏོག་རྣམས་གཏོར་བའི་ཤར་དུ་འདུག་ནས།",
    "ཉེ་བར་འདུག་པ་ཡང་སློབ་དཔོན་གཡོན་པ་སྐྱིལ་ཀྲུང་ཕྱེད་པ་བྱས་ནས་གཡས་པའི་ཞབས་ས་ལ་བཙུགས་ལ་ཉེ་བར་འདུག་སྟེ།",
    "དང་པོར་དཀྱིལ་འཁོར་གྱི་ནང་དུ་འདུག་སྟེ།",
