    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་འདུས་མ་བྱས་ལས་གདགས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་འདུས་མ་བྱས་ལས་གདགས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པ་ཉིད་འདུས་མ་བྱས་ལས་གདགས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པ་སྦྱིན་པའི་གནས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བ་སྦྱིན་པའི་གནས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ཕྱིར་མྱི་འོང་བ་སྦྱིན་པའི་གནས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པ་སྦྱིན་པའི་གནས་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་གཉིས་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་གསུམ་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་བཞི་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་ལྔ་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་དྲུག་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ས་བདུན་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་བརྒྱད་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ས་དགུ་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ས་བཅུ་པ་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "གནས་པ་ལས་ཕྱི་བརྟན་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྟོབས་རྣམས་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཕྱིར་མྱི་ལྡོག་པའི་ས་ལ་གནས་པར་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཐོས་ནས་ཀྱང་དེ་བཞིན་ཉིད་དུ་གཞན་ལ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་དེ་ལྟར་ཡང་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "མྱིག་ལྔ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "གཟུངས་ཀྱི་སྒོ་ཐམས་ཅད་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "མྱི་འཇིགས་པ་བཞི་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བྱམས་པ་ཆེན་པོ་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ལུས་ལ་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་དུརྩ་གཉིས་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དད་པའི་རྗེས་སུ་འབྲང་བའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བརྒྱད་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།་",
    "པོ་ཟོས་ན་ལན་བདུན་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "གང་ཟག་མགོ་མཉམ་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བ་སྟེ་འཇིག་རྟེན་འདིར་ལན་ཅིག་ནིའོངས་ནས་སྡུག་བསྔལ་མཐར་དབྱུང་ངོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་མངོན་དུ་བྱ་བའི་ཕྱིར་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཕྱིར་མྱི་འོང་བ་སྟེ་དེ་ཉིད་དུ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པའི་འབྲས་བུ་མངོན་དུ་བྱ་བའི་ཕྱིར་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པ་སྟེ་ཚེ་འདི་ཉིད་ལ་ཕུང་པོ་མ་ལུས་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སུ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ལ་གནས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཚོར་བའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "འདུ་ཤེས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "འདུ་བྱེད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "རྣམ་པར་ཤེས་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།་།",
    "ནང་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་ཞུམ་འགྱུར་ཅིག།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྟོབས་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "རྣམ་པར་ཐར་ཉུཔ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "སྨོན་པ་མྱེད་པའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "མྱི་འཇིགས་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བྱམས་པ་ཆེན་པོའི་སྒྲ་ཡོད་པར་མ་འགྱུར་ཅིག།",
