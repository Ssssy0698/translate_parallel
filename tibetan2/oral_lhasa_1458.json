    "ཀུན་ལ་སྙོམས་པར་ཟས་ཀྱིས་བསྟེན་པ་གཞན་ལ་བྱམས།",
    "བློ་གཏད་མི་ལ་བུ་བཞིན་བརྟན་པར་བྱེད་པའི་མི་ནི་བརླིང་པོ་ཡིན།",
    "ཤེས་རབ་ཅན་གྱི་མི་ལ་བསླབ་སྦྱང་བྱས་ན་མཁས་པར་འགྱུར།",
    "དགའ་བའི་མི་ལ་གཅམ་པར་ཕབ་ནས་སྨྲས་ན་ཁོང་བློ་གཏོད།",
    "སྔར་བྱས་འགྱོད་པ་མེད་པར་ཤེས་ན་མི་ཡི་བློན་པོ་ཡིན།",
    "ཁོང་རྗེ་འབངས་དང་བོད་བཙུན་རྣམས་ལ་སྤྲིང་ཡིག་བཞུགས་སོ།",
    "དཔའ་ལ་གཉིད་ཆུང་ལག་པ་གཙང་བས་ལམ་གྲོགས་བྱ།",
    "མནའ་མ་རྣམས་དང་འཁོན་པར་བྱེད་པའི་བཤལ་ཐག་ཡིན།",
    "སྔོན་དུ་དཔའ་བོ་ཐོད་རྒལ་བྱས་ན་སྐྱེས་བུར་འགྱུར་ཏེ་དགྲ་ཡང་རྩི།",
    "བྱས་པ་མེད་པར་རང་མཐོང་ཆེ་བ་གླེན་པ་ཡིན།",
    "འདུ་ལོང་ངན་པར་འཁོར་དུ་བསྟེན་མི་རུང་།",
    "ཅི་ལའང་ཆགས་ཐོགས་མི་མངའ་མཉམ་པར་འགྱུར།",
    "རྗེ་འབངས་དང་བོད་བཙུན་རྣམས་ལ་སྤྲིང་ཡིག་བཞུགས་སོ།",
    "༩ ༥ ༡ངོམས་པར་མི་བྱ་ཤེས་རབ་གསུམ་གྱིས་བསླབ།",
    "ངེས་པ་རང་ལ་མེད་པར་གཞན་མི་བསླབ།",
    "རྣམ་པར་མ་དག་འཁྲུ་བ་གཉིས་མི་འཕྲུགསི།",
    "ཞི་བར་མ་བྱས་ལྟ་བ་གཉིས་མི་འཕྲུགས།",
    "དུལ་བར་མ་བྱས་དགྲ་འཇོམས་གཉིས་མི་འཕྲུགས།",
    "ཡེ་ཤེས་རལ་གྲིས་སྐྱེ་རྒྱུད་གཅད་པར་རིགས།",
    "ཉིན་མཚན་མེད་པར་འགྲོ་དོན་བྱེད་འདོད་པས།",
    "དུས་གསུམ་འདུ་འབྲལ་མེད་པར་ཏིང་འཛིན་བྱ།",
    "དེ་དང་རྗེ་འབངས་དང་བོད་བཙུན་རྣམས་ལ་སྤྲིང་ཡིག་བཞུགས་སོ།",
    "པེ་ལ་བོད་ཀྱི་སྤུར་རྒྱལ་མགོ་ནག་ཡོངས་ཀྱི་རྗེའི་མཛད་པ་བཞུགས་སོ།",
    "༩༥༡༩༥༢༩༥༣རྗེ་འབངས་དང་བོད་བཙུན་རྣམས་ལ་སྤྲིང་ཡིག་བཞུགས་སོ།",
    "མི་ལུས་འདི་ནི་ཤིན་ཏུ་ཐོབ་པར་དཀའ།",
    "ཐོབ་པར་དཀའ་བའི་ཚེ་འདི་ཆུང་མ་གསན་། འཇིག་རྟེན་སྤྱོད་པ་དག་ལ་ཕར་བལྟས་པས།",
    "དམའ་ལ་ང་རྒྱལ་བསྟོད་ན་དྲེགས་པ་སྐྱེ་། མི་སྙན་བརྗོད་ན་ཁོང་ནས་འཁྲུག་པར་འགྱུར།",
    "ངན་སྐྱུགས་འཕྱུག་པར་བྱེད་པ་དེ་བས་ཀྱང་།",
    "བྱེད་པ་དེ་དག་རབ་ཏུ་བླུན་པ་ལགས།",
    "བདག་ཉིད་འཆི་བདག་བདུད་དད་སྐྱེད་སྒྲོན་མ་བཞུགས་སོ།",
    "ཤགས་ཀྱིས་མི་ལོ་དཔའ་བོས་འཐབ་ཏུ་མེད།",
    "བྱང་སེམས་མྱུ་གུས་རྩད་ནས་མ་བསྲེགས་པར།",
    "བདེན་པར་སྤྱད་ཀྱང་ཟད་པར་འགྱུར་བ་ཡིན།",
    "སེམས་བསྐྱེད་པ་ཡི་ཡོན་ཏན་རྟག་པར་ཡང་།",
    "མི་ལུས་ཐོབ་ཚེ་དལ་གྱིས་སྤྱད་པར་རིགས།",
    "བུ་ཚ་བདེན་པར་འཛིན་པའི་རྨོངས་པ་འགའ།",
    "ཤེས་རབ་བྱིང་དད་སྐྱེད་སྒྲོན་མ་བཞུགས་སོ།",
    "མཛངས་པ་ལགས་ཏེ་སྐྱེས་བུ་ཕྱི་མར་བདེ།",
    "མི་འཁྱག་ཙམ་དུ་དག་དུག་གོན་བྱས་ཤིང་།",
    "མི་ལྟོགས་ཙམ་དུ་ཟས་ངན་ཟོས་བྱས་ལ།",
    "རབ་མཆོག་ལགས་པར་ལྷ་མིའི་སྟོན་པས་གསུངས།",
    "ནོར་མི་བདོག་ཀྱང་ཡང་དག་འབྱོར་བ་ལགས།",
    "ཞིང་ཁམས་དག་པར་འགྲོ་ཞིང་སྡུག་བསྔལ་མེད།",
    "སྐྱིད་སྡུག་གཉིས་ཀྱི་བྱེ་བྲག་མཁྱེན་པར་མཛོད།",
    "བརྣབ་སེམས་གནོད་སེམས་ལོག་པར་ལྟ་བ་དང་།",
    "རང་དོན་ལགས་ཀྱིས་སྡིག་བཅུ་རྒྱབ་ཏུ་བོར།",
    "རང་ལ་བྱམས་ཤིང་བརྩེ་བས་འབད་པར་བྱ།",
    "ལེགས་པར་སྨྲས་ཀྱང་གཞན་གྱི་རྣར་མི་སྙན།",
    "དེ་ཡི་ཉེས་པའི་ཤས་ཀྱང་མཁྱེན་པར་མཛོད།",
    "དེ་ལྟར་ལགས་ཏེ་མ་རིག་བདེ་རུ་མེད།",
    "སྡིག་ལ་འགྱོད་པ་སྐྱེས་ཀྱང་བཤགས་ལོང་མེད།",
    "ན་བའི་སྡུག་བསྔལ་ལགས་ཏེ་ཀུན་ལ་འོང་།",
    "མི་གཙང་བདག་མེད་པ་རུ་རིག་པར་བགྱི།",
    "བ་དད་སྐྱེད་སྒྲོན་མ་བཞུགས་སོ།",
    "མགོ་ལུས་སྐོམ་པར་མི་མཐུན་རྒྱུ་ལས་བྱུང་།",
    "བཙོང་ཁུ་རྒྱལ་པོ་འཕྲང་དུ་བསྡད་ནས་ནི།",
    "དེ་ལྟར་བྱས་ཀྱང་རྣམས་ིསྨིན་འཆིར་མི་འདོད།",
    "འཆོངས་པ་ཅདེ་ལྟར་ལགས་ཏེ་ལྷ་མི་དང་།",
    "སྐྱེ་བ་བཟང་པོ་མ་ལགས་སྐྱེ་བ་ནི།",
    "གནོད་པ་དུ་མའི་སྣོད་གྱུར་ལགས་པས་མཁྱེན་པར་མཛོད།",
    "བདེ་བ་དད་སྐྱེད་སྒྲོན་མ་བཞུགས་སོ།་",
    "པེ་སྣར་པར།",
    "༧ པེ་སྣར་པར།",
    "༩༦༡ པེ་སྣར་པར།",
    "སྣར་རྣམ་པར།",
    "པེ་སྣར་མཁྱེན།",
    "ཐམས་ཅད་མཁྱེན་པའི་བསྟན་པ་བདུད་རྩིའི་སྣོད་གྱུར་པ།",
    "ཐམས་ཅད་ཡོད་སྨྲའི་ཁྱུ་མཆོག་དད་པས་མཆོད་བྱས་ཏེ།",
    "གཅིག་ཏུ་ཤས་ཆེར་བགད་དེ་གཏམ་ལ་རྗེས་སུ་ཆགས་ཤིང་དགའ་བས་ཀུན་དུ་འཁོད་པར་གྱུར་པ་དང་།",
    "གཞིག་པའི་ཕྱིར་ནི་འབད་པར་བྱེད།",
    "ཅི་ཁྱེད་རྣམས་ཕ་རོལ་ལ་གནོད་པ་བྱེད་པ་ཡོན་ཏན་ཡིན་པར་ཤེས་སམ།",
    "ལྷ་མ་ཡིན་གསོད་པ་ནི་ཡོན་ཏན་ཡིན་པར་རབ་ཏུ་ཤེས་པའོ།",
    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་ལས་ལེགས་པར་སྨྲས་པ་ཡིན་ནོ།",
    "སྐྱོན་དང་ལྡན་པ་དམ་པར་ཤེས་པས་མཆོད་། འབྲས་བུ་རྒྱ་ཆེན་ཐོབ་པར་མི་འགྱུར་གྱི།",
    "གང་ཡོན་ཏན་ཡང་དག་པ་དང་ལྡན་པར་འགྱུར་བ་སྟེ།",
    "འཚེ་སོགས་སྐྱོན་དུ་ཤེས་པར་བྱ།",
    "གན་དྷར་བ་ནི་ངེས་པར་ཡང་།",
    "ཀུན་མཁྱེན་ཉེས་པ་ཀུན་ལས་རྒྱལ།",
    "དེ་ཡང་དག་པར་འཚེ་བ་ཅན་དུ་འགྱུར་རོ།",
    "ངེས་པར་ཕན་འདོགས་པར་ཡང་མི་བྱེད་དོ།",
    "འོན་ཀྱང་ཕན་འདོགས་པར་ནི་སྤྱོད་པ་ཉིད་ཡིན་ཏེ།",
    "ཕན་པར་ཡང་ནི་མཛད་པ་ཡིན།",
    "ཆུ་ཡིས་འཇིག་རྟེན་ཚིམ་པར་མཛད།",
    "མང་དུ་སྨྲས་པས་ཅི་ཞིག་བྱ་སྟེ་་གན་དྷར་ཞེས་བྱ་བའི་ཡི་གེ་ནི་དོན་ཕྱིན་ཅི་མ་ལོག་པར་གྲགས་པ་ཡིན་ཏེ།",
    "ཡང་དག་པར་དགའ་བའི་བཞིན་གྱིས་གཟེངས་ིབསྟོད་དེ་སྨྲས་པ།"
