    "ཞི་ཁྲོའི་བསྐྱེད་རྫོགས་ཆ་ཚང་གི་ཟབ་ཁྲིད་བཅས་དང་།",
    "ཞི་བ་ལྷའི་སྤྱོད་འཇུག་བསྟན་འཛིན་མིང་གིས་མཛད་པའི་གཅོད་ཀྱི་ཚོགས་ལས།",
    "མོ་སྲི་བཀར་བ།",
    "སྒྲོལ་མ་དམར་མོ།",
    "སྒྲོལ་དཀར་རྣམས་ཀྱི་བསྙེན་ཚད་རེ་རེ་བཏང་ཞིང་།",
    "དགུང་ལོ་ང་བརྒྱད་ཤིང་འབྲུག་ལོར་རྒྱལ་རོང་ཐུགས་རྗེ་ཆེན་པོ་དང་ཀ་ཀོང་སོགས་གནས་ཆེན་དུ་མ་རྣམས་སུ་ཕྱག་མཆོད་གཟབ་ལྡན་སྒོས་གནས་རྟེན་ལེགས་འཇལ་དང་གཙང་ཆེན་སྐུ་ཕྲེང་གསུམ་པའི་གདན་ས་རི་ཁྲོད་འགྱུ་ནང་ཞེས་པར་ཟླ་བ་དྲུག་ཏུ་ཐུགས་དམ་མཛད་གཞན་འཛི་ཡུལ་ཕྱོགས་ཀྱི་གནས་ཁྲ་ཡུས་རྒེད་གསུམ་དང་དར་ལྔའི་རི་ཁྲོད་གཉིས་སུ་དབྱར་ངོ་དང་ཟླ་གསུམ་ཙམ་རེ་གནས་འབྲེལ་མཉམ་བཞག་ཟབ་མོའི་རྣལ་འབྱོར་ལ་གཞོལ་བར་བྱས་ཏེ་བཞུགས།",
    "དགུང་ལོ་ང་དགུ་ཤིང་སྦྲུལ་ལོར་རང་དགོན་དུ་འཛི་སྒར་དགོངས་གཏེར་སྒྲོལ་མ་དམར་མོའི་བསྙེན་སྒྲུབ་མཛད།",
    "རྗེའི་ལམ་རིམ་ཆེན་མོ།",
    "ཁོང་གིས་སྤྲུལ་པའི་སྐུ་ལའང་སྦྱོར་དྲུག་བསྡུས་ཁྲིད་དང་ཉམས་རྟོགས་ལེགས་འབུལ་གྱིས་ཕན་ཚུན་ཐུགས་ནང་གཅིག་འདྲེས་སུ་གྱུར།",
    "དེར་གནས་རྡོ་རྗེའི་སྤུན་སློབ་ཚོགས་རྣམས་ཀྱང་དཔའ་བོ་དཔའ་མོའི་རྣམ་བཀོད་འབའ་ཞིག་གིས་དག་ཆེན་སྒྱུ་མའི་རང་གཟུགས་ཅིར་ཡང་མངོན་དུ་བྱ་བའི་སྐལ་བཟང་ལ་རོལ་དུས་གནས་དེ་སྔགས་རིག་འཛིན་པའི་ཞིང་མཆོག་ཁྱད་པར་ཅན་ལ་སྒོ་ཀུན་ནས་འགྲན་བཟོད་དུ་གྱུར།",
    "བདག་གི་སྨོན་པའི་དོན་འདི་འགྲུབ་པར་མཛོད།",
    "མི་འཁྲུགས་པའི་ཆོ་ག་ཚར་རེ་དང་ལུས་སྦྱིན་རེ་དང་བཅས་དབྱར་ཁ་རྣམས་སུ་ཚ་ཚ་སྐུ་སྤར་གྲངས་མང་རྒྱུན་འདེབས་དང་སྐུ་ཚེ་གང་བོར་ལྗགས་ཐོག་ནས་བསྐྱེད་རིམ་སྣ་ཚོགས་པའི་མཚམས་བསྙེན་དུང་ཕྱུར།",
    "གྱིས་ལྐོག་གྱུར་ལེགས་ཉེས་འབྱུང་འགྱུར་ཇི་བཞིན་གཟིགས་པ་བཞིན་ཉེ་བར་བཀའ་བསྩལ་ཏེ་བསྟན་རྩ་མཆོག་ཉིད་ཡུན་རིང་བསྟན་འགྲོའི་དོན་དུ་བཞུགས་དགོས་ཚུལ་ལས་བརྩམས།",
    "ཁྱོད་ལྷ་མིན་ལྷ་བརྫུ་བྱེད་པ་སུ་ཡིན།",
    "རྗེ་གང་གི་སྐུ་དྲུང་དུ་ཉིན་ཞིག་ཨ་སྐྱོང་གོང་མའི་དཔོན་ཀརྨ་མཐུ་སྟོབས་འོང་ནས་དེ་ན་རེ།",
    "ཀུན་མཁྱེན་དང་རྗེ་བཙུན་ང་འདྲ་མར་གྲགས་པ་རེ་རེ།",
    "བྲིས་ཐང་གི་སྐུ་རྟེན་རྡོ་རྗེ་འཆང་།",
    "སྒྲོལ་མ་དམར་ལྗང་རེ་རེ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་ཞིང་བཀོད།",
    "ཡིག་དྲུག་དུང་འཁོར་དང་ཁྲི་ལྡན་འཁོར་ལོ་བཅུ་གསུམ་བླུས་བཞེངས་ཅི་རིགས་དང་དེ་དག་ལས་བྲིས་ཐང་དང་གླེགས་བམ་རྣམས་ལ་ཞལ་ཁེབས་ཐུམ་སོགས་ཞབས་འདེགས་མཆོད་བཀོད་ཆེས་ཁྱད་པར་བ་དང་བཅས་ནས་སོ་ ཐུགས་རྟེན་གྱི་རིམ་པ་ནི་ས་རྡོ་ལས་བཞེངས་པ་དང་ཞིག་གསོས་བཅས་ཀྱི་མཆོད་རྟེན་ཆེ་ཆུང་དགུ་ནང་གི་ལྷ་རིས་མང་པོ་བཅས་དང་དངུལ་ལས་བཞེངས་པའི་མཆོད་རྟེན་ཁྲུ་གང་བ་གསུམ།",
    "རག་གི་མཆོད་རྟེན་ཆ་བརྒྱད་སོར་ལྔའི་ཚད་བཀའ་གདམས་མཆོད་རྟེན་གཅིག་སོགས་བཞེངས་བླུས་ཅི་རིགས་མཛད།",
    "སྤྱིར་རྗེ་སྐྱབས་མགོན་གང་གིས་སྦྱོར་དྲུག་གི་ཟབ་ཁྲིད་ནམ་གནང་བའི་སྐབས་རྣམས་སུ་ཐོག་མ་སྔོན་འགྲོའི་རིམ་པ་ཉུང་བསྡུས་ཆ་ཚང་བཅས་ཀྱི་གང་སྐབས་སུ་བབ་པའི་ཟབ་ཁྲིད་གནང་སྲོལ་འདུག་པ་དེ་ལ་རྗེ་ཁོང་ཉིད་ཀྱིས།",
    "ཀྱེེ་རྡོ་རྗེ་སློབ་ཚོགས་གང་དག་གི་ཡིད་འཇགས་སུ་དགོས་གལ་ཆེ་བའི་ལམ་ཉམས་ལེན་གྱི་རིམ་པའི་ཚུལ་འདི་བཞིན་མཛད་དགོས་པ་ཡིན་ཏེ།",
    "ཅེས་བརྟགས་པ་མཐའ་བཟུང་གི་འཇིག་རྟེན་ན་སྲིད་དཀའ་བ་གང་ལས་ཀྱང་ལས་འབྲས་བསླུ་མི་སྲིད་པ་ནན་གསུང་གི་བཀའ་བྱུང་བ་ལྟ་བུ་རེད།",
    "ལོངས་སྤྱོད་མཛའ་བཤེས་གང་ཡང་མེད་པར་རང་ཉིད་གཅིག་པུར་འགྲོ་དགོས་ཤིང་དགེ་སྡིག་གི་ལས་བཟང་ངན་གང་བསགས་སྐྱེ་བ་ཚེ་རབས་རྣམས་སུ་ལས་དེ་མ་ཟད་བར་རྗེས་སུ་འབྲང་ངེས་སུ་གསུངས་ཤིང་།",
    "ལུས་ཅན་དག་གི་ལས་རྣམས་ནི།",
    "རང་ཅག་ཚོ་སྐོར་རེ་བདེ་བདེ་འདྲ་ཡང་ཕུགས་ཐུབ་མེད་པ་མ་ཟད།",
    "མཐོ་རིས་བུ་མོའི་ནུ་མ་སྐེད་པ་ལ།",
    "རེག་པའི་བདེ་བ་ཡུན་རིང་མྱོང་ནས་སླར།",
    "རེག་པ་ཤིན་ཏུ་མི་བཟད་བསྟེན་འཚལ་ལོ།",
    "རེ་རེ་རྒྱ་མཚོ་བཞི་བས་ལྷག་པ་ཡི།",
    "ཞེས་ད་ལྟ་རང་ཅག་གི་ཕ་མ་དགྲ་གཉེན་སོགས་ནི་འདི་སྣང་ཡུད་ཙམ་པ་ལས་ངེས་པ་མ་མཆིས་ཤིང་གནས་ཚུལ་གཞན་དང་གཞན་དུ་འགྱུར་ཚུལ་ཁོ་ན་ཡིན་ན་འདི་སྣང་དགྲ་གཉེན་ལ་ཤི་སྤར་འཐམ་པས་ཅི་ཞིག་བྱ།",
    "སྔོན་ཆད་རང་རེས་ལུས་བླངས་གྲངས།",
    "རེ་རེ་དག་གི་རུས་པའི་ཕུང་པོ་ནི།",
    "རྒྱ་མཚོའི་ནང་གི་ཆུ་ལ་ཡང་།",
    "གི་མཆི་མའི་ཐིགས་པ་ཡི།",
    "ཚངས་པའི་འཇིག་རྟེན་ལས་ཀྱང་ཐལ།",
    "ཞེས་མི་ལུས་བླངས་ཏེ་མཛའ་བཤེས་དང་བྲལ་བས་ངུས་པའི་མིག་ཆུ་ཟག་པ་རྒྱ་མཚོ་ཆེན་པོ་ལས་མང་ཞིང་ཕན་ཚུན་འཐབ་འཛིང་གིས་མགོ་བཅད་པ་ཁོ་ན་སྤུངས་པ་ཚངས་པའི་འཇིག་རྟེན་ལས་མཐོ་བར་གསུངས་པ་སོགས་ལ་ངེས་པ་དྲངས་དགོས་ལ་ཇི་སྐད་དུ།",
    "ཇི་ལྟར་སྣང་བ་འདི་དག་རང་གི་སེམས།",
    "གཞན་ཡང་ཁྱེད་སློབ་ཚོགས་ཀྱིས་ཡིད་འཛིན་བྱ་རྒྱུར་ཇོ་བོ་རྗེ་ལྷ་ཅིག་གི་ཞལ་སྔ་ནས།",
    "གདམས་ངག་གི་མཆོག་མཚང་ཐོག་ཏུ་འབེབས་པ་ཡིན།",
    "ཞེས་གསུངས་པ་ལྟར་བླ་རྒན་རང་གིས་ཁྱེད་རྣམས་ལ་གདམས་ངག་ཟབ་མོ་དག་ནི་བསྟན་ཟིན་གྱི་ཁྱེད་རང་ཚོས་ཉམས་ལེན་ལ་འབད་འབུང་བྱེད་ཐུབ་མི་ཐུབ་ལ་རག་ལས་པ་ཡིན་པས་དེ་ལུགས་སེམས་ལ་ཟུང་།",
    "ཁྱེད་ཅག་གི་རྒྱུན་སྤྱོད་སྐབས།",
    "རྒྱལ་སྲས་མཆོག་གིས།",
    "སྔོན་སྤྱད་བདེ་སྡུག་ཆུ་ཡི་རི་མོ་འདྲ།",
    "བློ་གསལ་གཉིས་ཡིན་ཞིང་གོང་འོག་གི་ལོ་རྣམས་སུ་སྦྱོར་དྲུག་གསར་འདུག་གང་ཡོད་དག་ལོ་དེ་དང་།",
    "གསུངས་ནས་བཞུགས་འདུག་དགོས་པ་བྱུང་ཞིང་འདི་སྐོར་ནས་བཀའ་ལས་ད་ནི་རང་གི་སྣང་བ་སྔར་ལོ་ཤས་ནས་ཐ་མལ་འདི་སྣང་འཆར་དཀའ་བ་ཞིག་ཏུ་རེད་སོང་།",
    "ཞེས་པའི་གསུང་གནང་ཡང་ཡང་བྱུང་ལོ་འདིའི་སྔ་ལོའི་དུས་སྐབས་ཤིག་ནས་བཟུང་ཁོང་གི་ཞལ་སྔ་ནས།",
    "ལོ་དེའི་ཟླ་བ་བརྒྱད་པའི་ཚེས་སྐོར་དུ་ཉིན་ཞིག་ཁོང་གི་སྐུ་མདུན་དུ།",
    "འོ་ད་ཁྱོད་ཀྱིས་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "མྱ་ངན་མ་མཛད་རང་གི་དྲིལ་བུ་འདི་རྒྱུ་སྤུས་བཟང་ལེགས་ཤིག་ཡིན་པས་འདི་ཁྱོད་ལ་སྦྱིན་ནོ་ གསུངས།",
    "སྐུ་མདུན་པ་ན་རེ།",
    "ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཁོ་བོས་ལོ་ཉི་ཤུ་ཙམ་ཞུས་ན་དེ་ཚེགས་རྔན་ཞིག་ལ་རེ་བས་གཏན་ནས་མིན་བདག་གི་རེ་བ་ནི་ཚེ་ཕྱི་མར་ཐུགས་རྗེ་འབྲལ་མེད་ལེགས་སྐྱོབ་ཁོ་ནའི་ཆེད་ལ་སྙམ་པ་ཡིན་ཚུལ་ཞིབ་མོར་ནན་ཞུས་ཀྱི་དུས་སུ།",
    "ད་འཆི་བའི་འཇིགས་པ་བོར་ཏེ་ཐལ།",
    "ཁྱོད་ཚོ་ལ་རང་གིས་གདམས་པ་གང་དགོས་ནི་བསྟན་ཟིན་ད་ཕན་རྒྱུན་དུ་བློ་ལྡོག་རྣམ་བཞི་ལ་ནན་ཏན་དང་དྲན་ཤེས་བཞིན་གྱིས་རང་སེམས་ལ་བལྟ་རྟོགས་ཀྱི་དོན་གཉེར་མ་ཞན་ན་ནམ་ཞིག་འཆི་ཁ་འགྱོད་མེད་ཅིག་འོང་རྒྱུ་རེད་སོགས་དེ་ལུགས་ཀྱི་ཞལ་ཏ་ཞིབ་པར་གནང་།",
    "སྐུ་མདུན་པ་གང་ཡོད་དག་གིས་བར་བར་ཞིང་གཞན་དུ་དགོངས་གཏད་མི་བྱེད་པའི་སྙན་གསན་རེ་ཡང་མཛོད།",
    "འདི་སྐོར་དུ་བར་བར་ཐུགས་མཉམ་པར་བཞག་ཚུལ་གྱིས་སྤྱན་ནམ་མཁར་གཟིགས་ཏེ་བཞུགས།",
    "ཕ་རྡོ་རྗེ་འཆང་གི་ཞབས་ལ་འདུད།",
    "མོས་གུས་ཚད་དུ་ཕྱིན་པའི་རྟགས།",
    "རྣམ་རྟོག་གི་སྐྱེ་ཐག་ཆོད་པ་འདི།",
    "བདེ་སྟོང་གི་ཉམས་མྱོང་རྒྱུན་ཆད་མེད།",
    "ཐོབ་འདོད་ཀྱི་རེ་དོགས་ཞིག་པ་འདི།",
    "བློ་མི་བདེ་མི་གདའ་བདེ་མོར་གདའ།",
    "ཅི་རིགས་མཛད་པས་རྒྱལ་ཚབ་ཉིད་ཀྱི་དེ་ལུགས་ཅི་གསུང་གི་བཀའ་དང་བླང་བགྱིས་པས་སྐྱབས་མགོན་དམ་པས་ཐུགས་མགུ་སྤྲོ་བར་རྒྱ་ཆེར་གནང་།",
    "བར་བར་དུ་བཀའ་གསུང་ལས་ད་ནི་རང་ཟུར་དུ་འོང་དགོས་ཚད་ཀྱི་རེ་བ་བསྐངས་ཟིན།",
    "ན་ཟུག་ཅི་ཡང་མེད་པར་ཤིན་ཏུ་བདེ་མོ་རང་ཞིག་གདའ།",
    "ཞེས་ཡང་ཡང་གསུང་གིན་འདུག་དེ་ནས་ཟླ་བ་དེའི་ཡར་ཚེས་བཅུའི་ཉིན་སྔ་དྲོའི་ཆར་ཆབ་བསང་ལ་བྱོན་ནས་གཟིམ་ཁྲིར་བཞུགས་དུས་རང་ཡུལ་གྱི་ཏིའི་ལ་དཔའ་ཀོ་ཟེར་བ་ཚེ་དུས་བྱས་པའི་བསྔོ་ཞུ་ཐོན།",
    "ཁོང་གི་ཞལ་ནས་འོ་དེ་རིང་ཏིའི་ལ་དཔའ་ཀོ་ངེད་གཉིས་ལྷན་ཅིག་ཏུ་འགྲོ་རན་པ་རེད།",
    "གསུངས་ནས་དར་ཅིག་སྤྱན་ནམ་མཁར་གཟིགས་བཞིན་བཞུགས།",
    "དགོངས་གཏད་འདིས་སྔོན་ཚེ་འདས་དཔའ་ཀོས་ཁོང་ལ་ཞབས་ཕྱི་ལེགས་བགྱིས་སོགས་ཀྱི་འབྲེལ་རེ་ཡོད་པས་ད་ལན་ཁོ་ཉིད་འདྲེན་པའི་ཐུགས་རྗེས་ཟིན་ངེས་སུ་སོང་།",
    "འོ་ཁྱེད་རྣམས་ཚོ་བདེ་མོར་མྱ་ངན་མི་མཛད་པར་སྡོད།",
    "བ་ཅུང་ཟད་མེད་པར་དག་སྣང་རབ་འབྱམས་ཀྱིས་དུས་འདའ་བ་བྱུང་ཞིང་ཡུད་ཙམ་ལས་འོད་གསལ་མ་བུ་འདྲེས་ལ་ཁད་དུ་ཡོད་པས་བྱིན་རྟེན་ལེགས་སྦྱངས་རང་གིས་ཀྱང་འཐུང་ན་སྙམ།",
    "རང་གི་རོ་ལའང་རོ་ལ་བྱ་བའི་ཆོ་ག་ཇི་བཞིན་བྱས་ན་བཟང་ཚུལ་སོགས་བཀའ་ཆེམས་ཇི་ལྟར་འོས་པ་དག་ལེགས་པར་བསྩལ་ནས་ཚེས་དེའི་དགོང་མོར་བབ་ཙམ་ལ་སྐུ་སེང་གེ་ཉལ་སྟབས་གློ་གཡས་པ་ས་ལ་ཕབས་ནས་བཞུགས་ཏེ་ཞལ་ནས།",
    "འགའ་ཞིག་ལ་དགེ་སློང་གི་ཆ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཁ་ཅིག་གི་ངོར་མཁའ་དབྱིངས་ཀུན་ཏུ་ལྷ་དང་ལྷ་མོའི་ཚོགས་མང་པོས་གང་བར་མཐོང་བ་དང་།",
    "ཕལ་ཆེ་བའི་རྣ་ལམ་དུ་རོལ་མོའི་སྒྲ་སྣ་ཚོགས་ཐོས་པ་དང་།",
    "མང་མང་བརྗོད་དཀའི་ཡུལ་དུ་གྱུར་མོད་ཀྱང་།",
    "ཉུང་ཉུང་ངག་གིས་རགས་བསྡུས་དབྱེ་ཙམ་བྱས།",
    "སློབ་ཚོགས་ཀྱིས་མཚོན་མ་ལུས་འགྲོ་ལ་བརྩེ་གཟིགས་ཆེ།",
    "ཡོངས་རྒྱས་འདྲེན་པ་མཆོག་གི་དགོངས་ཆེན་མངོན་གྱུར་ཅིག།",
    "ལྷུན་གྲུབ་མཛད་པ་མཆོག་གིས་དགེ་མཚན་ཕོབ།",
    "གང་ལས་ཡེ་ཤེས་གསར་བའི་ལང་ཚོའི་དཔལ།",
    "གང་གིས་འགྲོ་ལ་ལེགས་ཚོགས་སྤེལ་བའི་སླད།",
    "ལྷག་བསམ་རྣམ་ཀུན་ཀུན་ནས་རབ་རྒྱས་སྤྱོད་དགའ་དགའ་བའི་མཛད་བཟང་གིས།",
    "རིགས་ཀུན་འཁོར་ལོའི་མགོན་ཁྱོད་ཞབས་ཀྱི་རྡུལ།",
    "དེ་འདྲའི་རྣམ་པར་འཕྲུལ་བ་མཐའ་ཡས་པ་བདེ་ཆེན་ཞིང་གཙོ་འོད་དཔག་མེད་སོགས་མཆོག་སྤྲུལ་རབ་འབྱམས་རྒྱལ་སྲས་སྤྱན་རས་གཟིགས་སོགས་སེམས་དཔའ་གྲངས་མེད་རེ་རེའི་འཁོར་གྱི་ཚོགས་དང་བཅས།",
    "འོན་ཀྱང་འདིར་རེ་ཞིག་པའི་མཛད་ཚུལ་ཉི་ཚེ་བའི་ཆ་ཤས་ཤིན་ཏུ་ཕྲ་བ་ཙམ་དད་པའི་གསོས་སུ་བརྗོད་པ་ལ་བརྩོན་པ་ལྷུར་བླངས་པ་གང་ཇི་ལྟར་ཞེ་ན།",
    "ཁོང་ལྕམ་སྲིང་ལྔ་རིམ་གྱིས་བཙས་པའི་གཉིས་པ་ཡིན་ཞིང་སྐུ་ན་ཆུང་བྱིས་པའི་དུས་ནས་སྔོན་སྦྱངས་ཀྱི་ཤུགས་ཀྱིས་རྣམ་དཀར་གྱི་ལས་ལ་ཐུགས་མོས་ཆེ་ཞིང་ཞི་དུལ་གྱི་སྤྱོད་པ་རང་དང་ན་མཉམ་གྱི་བྱིས་པ་གཞན་རྣམས་ལས་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་ཡིན་པར་རིག་སྟེ།",
    "ཕྱིས་སུ་སྐུ་ཚེ་གང་པོའི་མཛད་བཟང་གིས་ཀྱང་ཅི་རིགས་དཔོགས་ནུས་སོ།",
    "སྐྱབས་སུ་འགྲོ་བ་འདིར་སོང་དོན་ཆེ་སྟེ།",
    "མཎྜལ་མེ་ཏོག་བཅས་ཐལ་མོས།",
    "ལྟར་འཛིན་མེད་པ་ནམ་མཁར་བཞག་ཅེས་པའི་གདམས་པ་བཞིན་དུས་གསུམ་དུ་གཏོགས་པ་གང་ཡང་ཡིད་ལ་མི་བྱེད་པར་ལྟ་བ་བྱར་མེད་ཀྱི་སྒོམ་མེད་རྣལ་འབྱོར་མཆོག་གིས་གཟུང་འཛིན་གྱི་སྤྲོས་པ་རང་དྭངས་སུ་བཏང་སྟེ།",
    "ཅེས་པའི་གདམས་ངག་ལྟར་གནས་ལུགས་རང་ས་ཟིན་པའི་ངང་ནས་རྩོལ་བྲལ་གྱི་རྣལ་འབྱོར་ལ་བསླབས་ཏེ་མི་རྟོག་ཐུགས་ཀྱི་རྡོ་རྗེ་ལ་འབྲེལ་བ་ཟབ་མོ་བཞག་གོ།",
    "རྗེས་དྲན་ཉམས་ལེན་ཀྱི་རྟགས་མཚན་སྔར་ལས་ཞུ་བདེ་ཆེས་ཆེར་འཕེལ་ཞིང་བར་སྐབས་རེར་རང་ལུས་ཀྱི་གོ་ས་སྟོང་གཟུགས་ཀྱི་སྐུར་སྣང་བ་དང་།",
    "ཏིང་ངེ་འཛིན་མོས་པ་ལམ་བྱེད་ཀྱིས་རང་ལུས་ལྷར་སྣང་ཞིང་བདེ་ཆེན་གྱིས་འཁོར་ལོ་དྲུག་རིམ་པས་གང་བའི་གསལ་སྣང་ཁྱད་པར་ཅན་གྱིས་གནས་སྣང་འགྱུར་བ་སོགས་རྣལ་འབྱོར་ཡན་ལག་དྲུག་གི་ལམ་ཉམས་ལེན་ཐོག་མ་ལོ་གསུམ་གྱི་རིང་དུ་བྱེད་སྐབས་ཀྱང་ཡན་ལག་རང་རང་གི་ལམ་རྟགས་ཁྱད་པར་བ་སྔགས་ལམ་ལ་བརྩོན་པར་ཁས་འཆེ་བའི་དེང་དུས་ཀྱི་རྣལ་འབྱོར་པ་སུ་དང་ཡང་མི་མཉམ་པའི་ཇོ་ནང་དཔེ་ཚོགས།",
    "གང་གི་གསུང་ཟུར་སྔ་ཕྱི་ཀུན་ཀྱི་ཉམས་ལ་དཔག་ན་ལས་དང་པོ་པའི་སྐབས་སུ་ཡང་གོང་སྨོས་ཀྱི་ལམ་རྟགས་རྣམས་མ་ཟད་དེ་ལས་ཆེས་ལྷག་རྒྱ་ཆེར་ཡོད་སྣང་ཡང་།",
    "རང་ལྟ་བུའི་བྱིས་བློས་ཧ་ཅང་རྒྱ་བསྐྱེད་ན་ཇི་བཞིན་ཐོན་པ་ལས་འོལ་ཚོད་དུ་འགྱུར་ཉེན་ཡོད་པས་རེ་ཞིག་བཞག་གོ།",
    "དེ་ནས་ལོ་གསུམ་དུ་ཐུགས་རྗེ་ཆེན་པོ་སྨྲར་ཁྲིད་ཚོམ་བུའི་ལུགས་ཀྱི་ཟབ་མོའི་རྣལ་འབྱོར་ལ་ཐུགས་དམ་མཛད་དེ་བཞུགས་རྗེས་སླར་ཡང་གཙང་བའི་སྒྲུབ་ཁང་གོང་མར་སྔར་གྱི་ཉམས་ལེན་ཟབ་ལམ་རྡོ་རྗེ་རྣལ་འབྱོར་ཁོ་ན་ལ་སྒྲུབ་པ་རྩེ་གཅིག་བྱས་ཏེ་ལོ་བརྒྱད་དུ་ཉིན་མཚན་ཀུན་ཏུ་གཡེང་བ་སྤངས་ཏེ་ཐུགས་དམ་གཙོ་བོར་མཛད།",
    "ངུར་སྨྲིག་རྒྱལ་མཚན་འཛིན་པ་ད་རེས་ཙམ།",
    "བདེ་སྟོང་ཉམས་ཀྱིས་ཐུགས་བཟང་དགྱེས་པ་ཁྱོད།",
    "ཨེ་མ་མཚར་སྡུག་ལྟད་མོ་མཆོག་གི་ཕུལ།",
    "དགུང་ལོ་སོ་བརྒྱད་ཀུན་ལྡན་ཞེས་པ་ལྕགས་བྱིའི་ལོར་ས་དམར་དགོན་དུ་རྗེ་བཙུན་རྭ་ལོའི་སྐྱེ་བར་གྲགས་པ་ཀུན་དགའ་ལུང་རྟོགས་ཞབས་པ་གང་གི་ཞལ་སྔ་ནས་འབྱུང་འདུལ་དམིགས་ཁྲིད་གཙང་བས་མཛད་པ་དང་།",
    "སྐུའི་སྤྱོད་པས་ཤིང་ལེབ་ལྔ་བུག་པའི་བར་དུ་བརྐྱང་ཕྱག་བཙལ་ཏེ་ཁྱོན་ཕྱག་དུང་ཕྱུར་དང་།",
    "ཀུན་གཟིགས་མཁྱེན་པ་རྒྱས་པའི་ལྷ་ལམ་ཡངས།",
    "དེ་ཡང་ཁོང་གི་སྐུ་ཚེ་སྨད་ལ་ཉེ་བའི་སྐབས་ཀྱི་གསུང་ཟུར་ལ།",
    "ཡང་བསྐྱེད་རིམ་རགས་པ་ཁམས་གསུམ་ཁྱབ་པའི་ལྷ་སྐུའི་སྣང་བ་ཕྲ་བ་རྡུལ་ཕྲན་ཙམ་གྱི་ཁྱོན་དུ་དྲུག་བརྒྱ་སོ་དྲུག་ཡོངས་རྫོགས་གསལ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "རྫོགས་རིམ་བསམ་གཏན་ཀྱི་མངོན་ཤེས་དང་རེ་ཁ་ནག་པོའི་ཐིག་ལེ་མཐོང་བ་དང་།",
    "རང་གི་ལག་ན་གནས་པའི་སྐྱུ་རུ་ར་བཞིན་དུ།",
    "མོས་སྒོམ་གྱིས་ཡས་བབས་དགའ་བ་བཞིའི་ཐིག་ལེ་རིམ་པར་བྱུང་བ་ལ་དམིགས་པའི་ཐིག་ལེ་རྫོགས་པ་སྒྲུབ་པའི་ཡན་ལག་གི་རྣལ་འབྱོར་དང་།",
    "རེ་ཁ་ནག་པོ་དྲི་མེད་འོད་ཟེར་འཕྲོ་བ།",
    "འཛིན་པའི་སྐབས་ཀྱི་བདེ་བ་གཟུགས་སེམས་དབྱེར་མེད་ཀྱི་སྣང་བ་གང་དག་ཕྱག་རྒྱ་གསུམ་པོ་ཅི་རིགས་ལ་བརྟེན་ནས་ཐིག་ལེ་དབབ་བཟློག་གི་དགའ་བཞིས་བཞུ་བརྟུལ་ཡང་ཡང་བྱས་པས་སྣང་བཞིའི་ཡེ་ཤེས་འཆི་བ་དང་ཤེད་མཚུངས་པའི་མཐར་སྟོང་གཟུགས་སྒྱུ་མའི་སྐུ་མཁའ་ལ་འཇའ་ཚོན་བཀྲ་བ་ལྟར་གྱི་འོད་ལུས་ཀྱིས་གདོས་བཅས་ཀྱི་སྣང་བ་ལྕགས་ཁམས་གསེར་རྩིས་ཟ་བ་བཞིན་དུ་གྱུར་ཏེ་ཡེ་ཤེས་སྟོང་གཟུགས་ཀྱི་སྐུ་རང་ལུས་ཀྱི་དོད་དུ་མཐོང་སྟེ་ལྷ་ཚོགས་རབ་འབྱམས་ཀྱི་སྣང་བ་འོད་ཟེར་དང་བཅས་པའི་སྤྲོ་བསྡུ་བྱེད་པ་པོ་ཉིད་དུ་རང་ཤུགས་ཀྱིས་སྣང་ལ་རང་བཞིན་མེད་པ་ཆུ་ཟླ་ལྟ་བའི་བདག་ཉིད་ཅིར་ཡང་སྣང་བ་འགོག་མེད་དུ་འཆར་ཇོ་ནང་དཔེ་ཚོགས།",
    "དེ་འདྲའི་ལམ་གྱི་རིམ་པ་གང་དག་དམ་པ་འདིའི་སྐུ་ཚེའི་མཐའ་ཚུན་ལ་ཇི་བཞིན་ཐུགས་ཉམས་སུ་མངོན་དུ་བྱས་པ་ཡིན་ཚུལ་ནི་ཉིད་ཀྱི་གོང་གསུང་དག་གི་གུང་བསྡུར་ན་ཤེས་ནུས་པས་ཤེས་ཚུལ་འདིར་མང་བས་མི་སྤྲོས་ལ།",
    "ལམ་ཉམས་ལེན་སྐབས་སྔ་མོ་གཙང་བའི་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཟབ་མོ་ལྟ་བའི་འབྲས་བཟང་གཡུར་ཟ་བས།",
    "མོས་བློས་དག་སྣང་སྒྱུ་མའི་འཁོར་ལོ་ལྔ།",
    "རིང་མོས་དུས་ནས་སྲིད་པར་འཕྱན་པ་དག།",
    "དེ་ལས་གདུལ་བྱའི་དག་སྣང་གི་རྒྱན་དུ་གྱུར་ཚུལ་དང་གཉིས་ལས།",
    "དང་པོ་ནི་དེ་ལྟར་དམ་པ་འདིས་གནས་སྐབས་དང་མཐར་ཐུག་གི་གང་དགོས་པའི་དོན་ཡང་དག་པ་ཐོག་མར་རང་ཉིད་ཀྱིས་ཇི་བཞིན་གྲུབ་ཟིན་པར་བྱས་རྗེས་སུ་གཞན་གདུལ་བྱ་རྣམས་རྗེས་སུ་བཟུང་བའི་ཚུལ་ཡང་།",
    "ཁྱོད་ལ་ད་ལན་འཆི་བ་མེད།",
    "རྡོ་རྗེ་འཆང་གསུམ་གྱི་བཟླས་ལུང་རྣམས་ལེགས་པར་གནང་བས་སློབ་བུ་སྐལ་བ་དང་ལྡན་པ་དག་ལ་རིམ་གཉིས་ཟབ་མོའི་ཡེ་ཤེས་སྐྱེ་རུང་གི་བག་ཆགས་ཁྱད་པར་བ་གསར་དུ་བསྐྲུན་པར་མཛད་དོ།",
    "དེ་རྗེས་ལོ་དེའི་ནང་རེ་ཞིག་ན་བྲག་དཀར་སྤྲུལ་པའི་སྐུ་རྒྱལ་སྲས་གྲུ་འཛིན་བདག་པོའི་རང་གཟུགས་བློ་བཟང་དཔལ་ལྡན་བསྟན་འཛིན་སྙན་གྲགས་འཛི་ཡུལ་དུ་ཕྱག་ཕེབས་མཛད་སྐབས་དེའི་མདུན་དྲུང་དུ་དམ་པ་ཉིད་བྱོན་ཏེ།",
    "འདི་སྐབས་གཙང་བའི་གྲྭ་ཚང་གི་སྤྱི་སྲུང་འཇིགས་བྱེད་དྲུག་ཅུ་པའི་གཏོར་སྒྲུབ་ཀྱི་དབུ་བླར་ཕེབས་ཏེ་སྨད་ལས་ཞིང་བཅུ་འགུགས་བསྒྲལ་གྱི་སྐབས་སུ་གཟི་བརྗིད་འཇིགས་རྔམ་འབར་ཞིང་ཕྱག་གི་ཕུར་རྩེ་ནས་མེ་སྟག་ཚ་ཚ་འཕྲོ་བ་དམིགས་བྱ་འགུགས་བསྒྲལ་གྱི་ཡུལ་དེ་རྟེན་ལིངྒ་ལ་དངོས་སུ་ཐིམ་པ།",
    "འདི་སྐབས་དམ་པ་གང་གི་ཐུགས་ཉམས་ཀྱི་འཆར་སྒོ་ཁོ་རང་གིས་སེར་སྤྲིན་འཇིགས་གཟུགས་ནག་ལང་ལོང་ནམ་མཁར་འཁྲིགས་པ་ལས་གློག་དམར་གྱི་ཞགས་པ་བར་སྣང་ལ་འཁྱུག་པ་འབྲུག་སྐད་དྲག་པོའི་སྒྲ་གདངས་དང་ལྡན་པ་ཆེས་མ་རུངས་པ་སྐད་ཅིག་ལ་བཟློག་པར་མཛད་པའི་ཉམས་སྣང་དང་།",
    "ཉམས་སྣང་དེ་དག་གི་དུས་ན་ཁོང་ཐོག་མར་མགོན་པོའི་བསྙེན་བསྒྲུབ་ལ་བཞུགས་ཤིང་བསྟན་འགྲོའི་དོན་དུ་སྲུང་རིམ་རྒྱ་ཆེར་མཛད་པ་ནི་ཕྱིའི་སྣང་ངོ་ཙམ་ནའོ།",
    "སྤྱན་རས་གཟིགས་གངས་རི་མ།",
    "བདེ་མཆོག་ལུ་ཡི་པའི་ལུགས་ལྷ་རེ་གཉིས་ཅན་དང་།",
    "ལོ་འདིར་འདུ་ཁང་མེས་ཚིག་པ་དགོངས་གཏད་བསྡབས་ཆོག་གིས་དེ་མ་ཐག་ཞི་བར་བྱས།",
    "ཡིན་ལུགས་སྔ་མོར་ཇི་བཞིན་མཁྱེན་པས་ཀུན་ལ་གཟབ་དགོས་ཚུལ་གསུངས།",
    "སྤྱིར་ཁོང་གིས་སློབ་བུ་གྲྭ་བཙུན་འགའ་ལ་ཞལ་གདམས་སུ་ཕྱི་སོ་ཐར་སྡོམ་པ་ཀོང་བུ་ལྟ་བུ།",
    "གང་གི་རྗེས་འཇུག་རྣམས་ལམ་སྣེ་རེ་མ་ཟིན་པ་མེད།",
    "ཇི་བཞིན་གཟིགས་པ་འདུ་འགོག་ཡོངས་བྲལ་བ།",
    "གང་ལ་རེ་བའི་མིག་ཡངས་གཏོད་བྱེད་ན།",
    "གཉིས་པ་དེ་ལས་གདུལ་བྱའི་དག་སྣང་གི་རྒྱན་དུ་གྱུར་ཚུལ་ཡང་།",
    "ཁོང་གིས་གཉུག་མ་དོན་གྱི་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "སྣ་ཚོགས་མོས་བློའི་མཚོན་གྱིས་ལེགས་བསྒྱུར་བས།",
    "སྲིད་གསུམ་ཡ་མཚན་གང་གིས་བསྐྲུན་པར་ནུས།",
    "དམ་པ་གང་གིས་རེ་ཞིག་ལྗོངས་འདི་ནས་མཛད་ཕྲིན་གྱི་སྒོ་ཐུན་མོང་དུ་སྣང་བ་གང་དག་རྫོགས་པ་ལ་ཉེ་བའི་སྐབས་ཇི་ལྟར་ན།",
    "སྤྱིར་སྔ་མོ་ནས་དམ་པ་ཉིད་ཀྱི་ཕྱག་རྫས་གང་ཡོད་རེས་ཧ་ཀྵ་མ་ཎི་ཚེ་བསྙེན་དུང་ཡོན་སོགས་ཀྱི་ཡོན་ཐང་བཅོས།",
    "གྱོང་དང་བུབ་ཁ་རང་གིས་ལེན་ཞེས་བཀའ་གདམས་པ་གོང་མ་རྣམས་ཀྱིས་གསུངས་པ་ལྟར་ཁྱེད་རང་ཚོས་ལག་ལེན་ཅི་ཐེབས་དགོས་ཏེ་རྒྱལ་སྲས་ཀྱི་ཞལ་ནས།",
    "གང་དག་བདག་གི་མགོ་བོ་གཅོད་བྱེད་ནའང་།",
    "དྲན་པ་མངོན་དུ་བཞག་ཤེས་པ་དྲག་ཏུ་གཏད་ནས་སེམས་ཁ་ཡེངས་མིག་ཡེངས་སུ་མ་བཏང་བར་བྱ་བ་རྟག་ཐུབ་ཀྱིས་ཚེ་མཐར་འཁྱོལ་བ་ཞིག་ཅི་ནས་ཀྱང་མ་འཆུགས་རེམ་རེམ།",
    "ཞེས་གསུངས་པ་ལྟར་ཡེ་ཤེས་ཀྱི་སྐུ་མྱུར་དུ་འགྲུབ་པའི་ནང་གི་འབྲས་བུའི་རྟགས་མཚན་དུ་མངོན་ནོ།",
    "རེ་རེ་ལ་དབུ་གཏུགས་མཛད་བཞིན་ཞལ་ཏ་གནང་བ།",
    "སྔོན་བདག་ཅག་གི་སྟོན་པ་ནས་བཟུང་བདག་ཉིད་ཆེན་པོ་གང་དག་བྱོན་ཚད་གདུལ་བྱ་རྫོགས་པ་ན་གཅིག་ཀྱང་མི་བཞུགས་པར་ད་ལྟ་བྱོན་ཚུལ་བསྟན།",
    "ད་སྐབས་རང་གི་ཚེ་ཚད་ལས་ལྷག་པ་ཞག་འགའ་ཁྱེད་བུ་སློབ་དག་གི་བསམ་པ་རྫོགས་ཇོ་ནང་དཔེ་ཚོགས།",
    "ཁོ་བོ་ཤི་སོང་རྗེས་རོ་གོག་འདི་ལ་བལྟ་བས་ཅི་ཞིག་བྱ་ཞེས་སོགས་ཞལ་ཏ་ཡང་ཡང་གསུངས།",
    "དེ་ནས་ཁོང་གིས་སྐུ་དབོན་ལ་དགོན་འདི་མ་འོངས་པ་ན་ལྷག་པར་དར་ཞིང་རྒྱས་ཚུལ་གྱིས་བཀའ་ལུང་ཡང་དག་མཛད།",
    "དེ་ལྟར་བགྱིས་རྗེས་ཞག་འགའ་སོང་ནས་ཚེས་ཉི་ཤུའི་ཉི་དྲོས་ཙམ་ན་སྔར་ཞག་རང་བོར་གསོལ་ཆས་ཉུང་ཤས་ལས་མི་གསོལ་ན་དེའི་ཉིན་གསོལ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "རང་ལ་གདུང་མཆོད་རྟེན་ཡང་ཆེ་རྒྱས་མི་དགོས་གདུང་ཆས་སོགས་དཔེ་སྲོལ་ལྟར་རེ་བྱས་ཀྱང་ཉེས་པ་མེད།",
    "རང་གི་གོས་སོགས་ངན་སློང་ལ་སྦྱིན་པ་ཐོང་།",
    "ཉེ་གནས་གཉིས་ན་རེ།",
    "ལུས་མཉམ་བཞག་གིས་འབྱོན་པར་ཞུ།",
    "བྱས་པར་རེ་ཞིག་ཙམ་ནས་སྐུ་བསྙུང་བ་མེད་པའི་ཚུལ་གྱིས་ཡར་བཞེངས་ནས་ཁོང་ལ་ན་ཟུག་གང་ཡང་མེད་པར་འོ་མ་དང་དམ་རྫས་གསོལ་ནས་རེ་ཞིག་དབུ་གཟན་གྱིས་བཏུམ་ནས་དར་ཅིག་ལ་མཉམ་པར་བཞག་ཏེ་ཕཊ་སྒྲ་ལན་གསུམ་མཛད།",
    "སློབ་བུ་རྣམ་ལའང་དག་སྣང་གི་ཉམས་ལ།",
    "དེ་ནས་ལོ་རེ་བཞིན་བུ་སློབ་དག་གིས་དམ་པ་མཆོག་གི་གདུང་མཆོད་དུ་དུས་འཁོར་ལྷ་དགུའི་སྒྲུབ་མཆོད་ཉིན་བཞི་མ་རྒྱུན་ཚུགས་སུ་ནམ་ཡང་ཆད་མེད་བྱས་ཤིང་།",
    "དགའ་ཆེན་བདེ་སྟོང་ཟུང་འཇུག་རང་གཟུགས་ཟག་བྲལ་སྒྱུ་མའི་ལང་ཚོས་དགའ།",
    "ཇི་བཞིན་འཕགས་མཆོག་གིས་ཀྱང་བརྗོད་དཀའ་ན།",
    "ངེས་པ་ལྔ་ལྡན་ཞིང་གི་གཙོར་གྱུར་པ།",
    "དཔག་ཡས་ཞིང་གི་སྤྲུལ་པར་གུས་པས་མཆོད།",
    "ཁྱད་པར་སྙིགས་དུས་འགྲོ་ལ་ངག་གི་དཔལ།",
    "གང་འདུལ་འགྲོ་ངོར་སློབ་པའི་བརྫུ་བག་གིས།",
    "རེ་ཞིག་ལྗོངས་འདིའི་གདུལ་བྱ་རྫོགས་པའི་སྐབས།",
    "འགྲོ་འདྲེན་མཆོག་གི་ཞབས་པད་གུས་པས་མཆོད།",
    "དམ་པའི་མཛད་བཟང་ཀུན་གསལ་སྒེག་མོ་ལས།",
    "མོས་གུས་རྒྱ་ཆེར་འཕེལ་བའི་སླད་དུའོ།",
    "གར་མཁན་རྔ་མཁན་གྱད་དང་རོལ་མོ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཞེས་གསུངས་པ་ལྟར་གྱི་སྤྲུལ་པའི་སྐུའི་རྣམ་པར་བཀོད་པས་གདུལ་བྱ་རང་རང་གི་ཇི་ལྟར་འདོད་ཅིང་མཁོ་བར་གྱུར་པ་གང་དག་གིས་རེ་བའི་འདོད་པ་མཐའ་དག་དེ་བཞིན་དུ་ཇི་ལྟར་བར་ལེགས་པར་སྐོང་བའི་སྒོ་ནས་འགྲོ་བའི་དོན་རླབས་པོ་ཆེ་མཛད་པའི་རྣམ་པར་འཕྲུལ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་མངའ་ཞིང་།",
    "ཞེས་གསུངས་པ་ལྟར་དེ་བཞིན་གཤེགས་པ་ཉག་གཅིག་གི་སྐུ་གསུམ་གྱི་ཕྲིན་ལས་འཇུག་པ་དེ་འདྲའི་སྒོ་ནས་ལུས་ཅན་སྐྱེ་འགྲོ་མཐའ་དག་གི་གནས་སྐབས་དང་མཐར་ཐུག་གི་ལེགས་ཚོགས་ཉེ་བར་བསྐྲུན་ཞིང་གསང་བ་གསུམ་གྱི་མཛད་པ་བཟང་པོ་དུས་རྟག་པར་ནམ་ཡང་ཕྱོགས་ལྷུང་དང་བྲལ་བར་ཐམས་ཅད་རིས་སུ་ཆད་པའི་གོ་སྐབས་མ་མཆིས་པ་ཁོ་ནའོ།",
    "རང་གི་ནུས་པ་ལྷོད་པར་མི་བྱེད་དེ།",
    "མོས་པ་དང་ནི་བཟོད་པ་དང་།",
    "ཀློག་སློབ་པའི་སྐབས་ཀུན་ཏུ་ཡུལ་མི་ཤེས་ལྡན་དག་གིས་མངོན་འདུག་རྒྱུ་ཡང་དག་གི་རིགས་ཁྱད་པར་བའི་ཀུན་སྤྱོད་འདྲ་རུང་ཙམ་ནི་ཆེས་མང་པོ་ཡོད་རིགས་སུ་འདུག་ཀྱང་ཆ་རྒྱུས་ཇི་བཞིན་ཡོད་མི་མེད་པས་དེ་ཙམ་ལས་སྤྲོས་པའི་ཁུངས་མ་རྙེད།",
    "རང་གི་རྫས་དང་ཡོ་བྱད་ཀྱིས།",
    "སྟོབས་བཞི་སོགས་ཀྱི་སྒོ་ནས་ཧེ་རུ་ཀའི་ཡིག་བརྒྱ་འབུམ་ཐེར་ལྷག་གིས་སྒྲིབ་པ་སྦྱངས་པའི་ཐབས་ལ་སྒོ་དུ་མ་ནས་འབད་པར་བྱས།",
    "མོས་སྒོམ་སྟོང་ཉམས་ཀྱི་རྣམ་པ་ཤེད་ཆེ་བ་དུ་མའི་དངོས་ཉམས་དང་།",
    "རྨི་ལམ་རྟགས་མཚན་གྱི་སྣང་བ་ལམ་སྔོན་འགྲོ་རང་རང་གི་སྐབས་དང་འཚམས་པ་ཆེས་མང་བ་བྱུང་ངོ།",
    "རྡོ་ལ་རི་མོ་བྲིས་པ་ཇི་བཞིན་དུ།",
    "འདི་སྐབས་རྣམས་སུ་དམ་པ་ཉིད་ལ་མུན་ཁང་གི་སྣང་བ་ལ་རྟགས་བཅུ་ཡོངས་རྫོགས་ཆེས་གསལ་བོ་གཞན་རྣམས་ལས་ཁྱད་པར་དུ་གྱུར་པ་ཡོད་རིགས་སུ་གདའ་བས་མཆེད་ཟླ་རྣམས་ལས་ཐུགས་སྲས་མཆོག་གི་སྙན་པ་ཐོབ་པ་ཞིག་ཡིན།",
    "ནམ་ཡང་མི་འབོར་བར་བྱས་ཏེ་ནང་ནུབ་ཀུན་ཏུ་མཉམ་བཞག་ཆག་མེད་ཀྱི་ངང་ནས་གསུམ་གྱི་ཀུན་སྤྱོད་གཞན་ཕལ་བ་རྣམས་དང་མི་མཐུན་པར་སྐུ་ན་གཞོན་ཡང་ཞི་དུལ་རྒན་པའི་བརྟུལ་ཞུགས་ཀྱིས་རྒྱུད་ངང་གིས་འདུལ་ཞིང་ཀུན་གྱི་ཡིད་སྨོན་པའི་གནས་སུ་གྱུར་བཞིན་དུ་ཕ་མ་ཡིད་འོང་བརྩི་བཀུར་གྱི་གཅེས་སྤྲས་དང་བཅས་ཏེ་དེ་གཉིས་ལ་འཕྲལ་གྱི་བྱ་བ་གང་དགོས་མཐའ་དག་བསྒྲུབས་ནས་ཇི་ལྟར་འཚམས་པའི་གཡོག་མཛད།",
    "དེ་ནས་དགུང་ལོ་བཅོ་བརྒྱད་པ་དགའ་བ་ཞེས་པ་ཆུ་འབྲུག་གི་ལོ་འདི་མཚམས་སྐོར་ནས་མཛད་ཚུལ་ཡང་།",
    "ཤཱ་རིའི་བུ་གང་གིས་བསྐལ་པ་གཅིག་གི་བར་དུ་ཉན་པ་བས།",
    "རྗེ་སྒྲོལ་མགོན་ཞབས་ཀྱིས་མཛད་པའི་སྦྱོར་དྲུག་དམིགས་ཁྲིད་ཆེན་མོ་མཐོང་བ་དོན་ལྡན་གྱི་བཀླག་ལུང་ཟབ་ཁྲིད་ཞིབ་རྒྱས་དང་།",
    "མ་མོའི་ལྷན་ཐབས།",
    "བདག་གི་བུའམ་བུ་མོའམ་བྲན་ཁོལ་ལས་གང་ཡང་རུང་རབ་ཏུ་བྱུང་བར་གནང་ངམ།",
    "ཀྱི་བར་དུ་ལོངས་སྤྱོད་མོད་པར་འགྱུར།",
    "གནམ་རིམ་པ་དྲུག་གི་ལྷར་ཡང་དང་ཡང་དུ་སྐྱེ་བ་ལས།",
    "གཉུག་མའི་ཡེ་ཤེས་སྔོ་བསང་སྒེག་མོའི་བཞིན།",
    "བླུན་པོ་ཆུ་ཡི་རི་མོ་འདྲ།",
    "མཁས་པ་རྡོ་ཡི་རི་མོ་འདྲ།",
    "ཞེས་གསུངས་པ་ལྟར་ལོ་འདི་སྐོར་ཞིག་ཏུ་དམ་པ་གང་ཉིད་རང་ཡུལ་གྱི་མི་ཁྱིམ་གསེར་བ་རྡོ་དཔལ་ཚང་བསྲུང་རིམ་ཞིག་གི་ཆེད་དེར་ཕེབས་ནས་གསུང་སྒྲོག་མཛད་སྐབས་ནུབ་གཅིག་རྨི་ལམ་དུ་བན་རྒན་གཡག་ཞོན་ཞིག་འོང་བ་རང་རྡོ་རྗེ་ཤུགས་ཁྲོ་བོའི་ང་རྒྱལ་ལ་གནས་ཏེ་ཕྱག་གིས་རྡོ་རྗེ་འཇིགས་རྔམ་པས་གནོད་བྱེད་བན་རྡེའི་གཟུགས་ལ་དབྱིངས་རིག་དབྱེར་མེད་ཀྱི་ངང་ལས་གདེང་ཆེ་བས་ཆེད་དུ་ཕཊ་ཀྱི་སྒྲ་དང་བཅས་ཏེ་དྲག་ཏུ་བསྣུན་པས་ཁོ་རང་གར་སོང་ཆ་མེད་དུ་ཡལ་སོང་།",
    "དེའི་ཚུལ་རྡོ་རྗེ་འཆང་གི་ཐུགས་ཀྱིས་ཇི་བཞིན་མཁྱེན་ཏེ་བཀའ་བསྩལ་པ།",
    "སུ་ལས་ཀྱི་སྒྲིབ་པ་མི་འདོད་པ་དེ་དག་གིས་གཞན་གྱི་སྤྱོད་པ་ལ་ཁོང་ཁྲོ་བར་མི་བྱའོ།",
    "འདི་སྙམ་དུ་ཕ་རོལ་ཀྱི་སེམས་ནི་བདག་གིས་མི་ཤེས་ཏེ།",
    "གང་ཟག་གིས་གང་ཟག་ལ་ཚོད་གཟུང་བར་མི་བྱའོ།",
    "ཕེབས་དུས་མགོན་པོ་མཆོག་གི་སྤྱན་གྱིས་ཧྲིག་གེར་གཟིགས་ནས་ཞལ་གསུང་ལས་རྡོ་རྗེ་འཆང་ཁྱེད་གང་ནས་བྱོན་ཞེས་གསུངས་པ་ན་དམ་པ་འདིས་རང་ཚུལ་དྲང་པོར་ལེགས་པར་ཞུས་ཏེ་གོ་བརྡ་གསལ་བརྗོད་བྱས་ཀྱང་ཁོང་ནས་ཁྱོད་རྡོ་རྗེ་འཆང་ངེས་པར་རེད་ཅེས།",
    "འདི་སྐབས་ཕ་ཅིག་རྡོ་རྗེ་འཆང་ཆེན་པོ་གང་ཉིད་ནི་རང་ཅག་ཚུར་མཐོང་གི་སྣང་ངོར་ཡང་།",
    "མ་དམིགས་ནའང་ཚུར་མཐོང་གི་ངོར་གཟུགས་སྐུའི་སྣང་བ་ཟུམ་པའི་མོད།",
    "དམ་པ་ཉིད་ཀྱི་ཐུགས་སྐྱོ་ཤས་གདུང་བ་དྲག་པོ་བཅས་ཀྱིས་ཀུན་ནས་བསླངས་ཏེ་མོས་གུས་དག་སྣང་ཁྱད་པར་བའི་སྐོར་དང་དེས་མཚོན་སྔ་ཕྱི་ཀུན་ཏུ་དམ་པ་ཉིད་ཀྱི་ཐུན་མིན་གྱི་གཟིགས་སྣང་ཐམས་ཅད་ནི་འོག་གསང་རྣམ་འཆད་པའི་སྐབས་སུ་ལེགས་པར་འབྱུང་ངོ།",
    "སྦྱོར་དྲུག་གི་ཉམས་ཁྲིད་གེགས་སེལ་བོགས་འདོན་སོགས་ཀྱི་ཁྲིད་ལུང་སྦྲགས་མ་དང་།",
    "ནེ་གུའི་དམིགས་ཁྲིད་ཐང་བརྡལ་མ་ཆ་ཚང་གི་ལུང་ཁྲིད་ལེགས་པར་གསན།",
    "དགུང་ལོ་ཉེར་དགུ་མཛེས་བྱེད་ཅེས་པ་ཆུ་ཡོས་ལོར་འཛམ་ཐང་གཙང་བའི་གྲྭ་ཚང་གི་འདུ་ཁང་ཆེན་མོར་འཇམ་དབྱངས་མིའི་རྣམ་རོལ་དུ་བྱོན་པ་ཐུབ་བསྟན་དགེ་ལེགས་རྒྱ་མཚོ་གང་གི་ཞལ་བཟང་རྣམ་པར་བཞད་པ་ལས།",
    "དགུང་ལོ་སུམ་ཅུ་ཁྲོ་མོ་ཞེས་པ་ཤིང་འབྲུག་ལོའི་དུས་ཙམ་ན་འཛམ་ཐང་གཙང་ཆེན་བླ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཀུན་གཟིགས་བདེ་ཆེན་ཞི་དབྱིངས་ཉག་གཅིག་ཏུ།",
    "རིང་མོའི་དུས་ནས་མཛད་དགོངས་མཉམ་གྱུར་ཀྱང་།",
    "ཐུགས་དགོངས་རྩོལ་པ་ཞི་ཡང་སྤྱོད་བཟང་གིས།",
    "སེམས་དཔའ་མཆོག་གི་བརྩེ་གཟིགས་ཟླ་བྲལ་བ།",
    "མཛད་པ་མཁའ་ལྟར་ཁྱབ་ཀྱང་ཕྱོགས་རེའི་ཚུལ།",
    "མ་སྨད་ངག་གིས་རྡོ་རྗེའི་བཟླས་སྒྲ་སྒྲོག།",
    "སྐྱེས་བུ་དམ་པ་འདི་ཉིད་དང་ཡང་ལྷན་དུ་གནས་པའི་མཆེད་གྲོགས་ཞལ་སློབ་གང་དག་ལ་ཡོན་ཏན་སྣ་རེ་མ་སྐྱེས་པ་མེད་པ་ལྟ་བུ་ཡིན་པས་རང་གིས་ཉམས་ལེན་ལ་ནན་ཏན་བྱེད་བཞིན་གཞན་རྣམས་ཀྱང་དེ་འདྲའི་ཚུལ་ལ་སྦྱོར་ཅི་ཐུབ་ཀྱི་ཕན་པའི་མཛད་བཟང་ལ་ཇི་ལྟར་གནས་པའི་ཚུལ་ཡང་།",
    "འདི་ལོར་ར་འོབ་ཏུ་ཁོང་གིས་དུས་འཁོར་སྒྲུབ་མཆོད་ཁྲི་འཛིན་མཛད།",
    "སློབ་འབངས་ངང་མོ་སྐྱོང་དང་ཆབ་གཅིག་ཏུ།",
    "ལེགས་མཛད་ངག་གིས་རང་གཞན་དོན་གཉིས་བསྒྲུབས།",
    "དོན་གཉིས་རབ་ཏུ་རྒྱས་བྱེད་ཁྱོད་མིན་སུ།",
    "འོན་ཀྱང་རྒྱ་མཚོའི་ཆུ་གཏེར་ལས་སྐྲ་རྩེའི་ཆུ་ཐིགས་ཙམ་བླངས་འོས་དུས་སུ་བབ་པ་ཡང་དམ་པ་གང་གིས་ནི།",
    "གཞན་མཁའ་ཁྱབ་ཀྱི་འགྲོ་བ་མཐའ་དག་ལ་བདེ་དགའ་རྒྱ་མཚོ་བདག་གིས་སྦྱིན་འདོད་ཀྱི་ལྷག་བསམ་གྱི་བྱམས་པ་དང་།",
    "མཐའ་ཀླས་པ་སྒྲོ་བ་ནས་འབྲུ་རིགས་ཕྱིར་འབོ་བ་བཞིན་རང་ཁྱིམ་གྱི་གཞི་ཀུན་ཡོངས་སུ་གང་ཏེ་བར་མཚམས་མེད་པའི་ངང་ལ་སྟོང་པ་སྤྲོས་བྲལ་གྱི་དབྱིངས་ཉག་གཅིག་ལས་བདེ་བ་ཆེན་པོའི་རང་གཟུགས་མུ་མཐར་ཐུག་པའི་ཉམས་བཟང་གཤིས་ནས་ཉེ་བར་རྡོལ་ཏེ་འོད་གསལ་བདེ་སྟོང་ཟུང་འཇུག་གི་མཉམ་བཞག་གཅིག་གིས་མཚན་མོ་ཁ་ཚང་གར་ཐལ་མ་གོ་བ་ལྟ་བུར་གྱུར་ཏེ་མཉམ་བཞག་གཅིག་གི་དབྱིངས་ལ་འབྱམས་པར་གྱུར་པ་སྟེ།",
    "ཞེས་པ་ལྟ་བུའི་ཚུལ་དུ་ཉམས་སྣང་གི་འཆར་སྒོ་ཀློང་རྡོལ་བའང་བྱུང་ཞིང་།",
    "ཡང་བར་སྐབས་ཤིག་ཏུ་ར་འོབ་གྲོང་ཡུལ་དུ་འདོན་རིམ་ལ་བཞུགས་དུས་སྐུ་ན་གཞོན་པས་ཕྱག་གྲངས་མང་དང་ཐུགས་ཉམས་ལེན་ཟུང་འབྲེལ་ལ་གཡེལ་བ་མེད་པའི་ནུབ་གཅིག་རྨི་ལམ་འོད་གསལ་གྱི་སྣང་བ་ལ་མི་དཀར་པོ་ལ་ཐོད་ཅན་གཉིས་སྐད་ཅིག་གིས་སླེབས་ནས་ཐོན།",
    "མི་གཅིག་གི་ལག་ན་རལ་གྲི་དང་གཅིག་ཤོས་ཀྱི་ལག་ན་མར་གྱི་གོང་བུ་ལྟ་བུ་འོད་དཀར་ལམ་པ་གཅིག་བསྣམས་ཏེ།",
    "རལ་གྲི་ཅན་དེའི་ལག་གི་རལ་གྲིས་ཁོང་གི་མགོ་བོ་ནས་ལུས་ཡོངས་རྫོགས་ཕྱེད་བཀས་བྱས།",
    "མར་གོང་ལྟ་བུ་ཅན་དེའི་ལག་གི་མར་གྱི་གོང་བུ་ལྟ་བུ་དེས་དེ་ལ་ལེགས་བྱུག་མཛད་པས་རང་སྣང་ལུས་ཀྱི་མི་གཙང་བའི་ཆ་མཐའ་དག་རྣམ་པར་སྦྱང་བའི་སྣང་བ་འཛིན་མེད་ཀྱི་ངང་དུ་དར་ཅིག་ལུས་པས་དེ་ཕན་རང་ལུས་གདོས་བཅས་ཀྱི་རྣམ་པ་མེད་པར་བདེ་ཡང་གསལ་བའི་རང་བཞིན་དུ་སྣང་སྟེ།",
    "གཞན་ཡང་ཀུན་དགའ་མཉམ་ཉིད་ཞབས་པ་འཇིགས་མཛད་ཀྱི་བསྙེན་མཚམས་མཛད་སྐབས་དམ་པ་འདིའི་ཐུགས་ཡེ་ཤེས་སྤྱན་གྱིས་མཉམ་ཉིད་ཞབས་པ་ཐ་མལ་བའི་ལུས་གནས་འགྱུར་ཏེ་དཔལ་རྡོ་རྗེ་འཇིགས་མཛད་ཁྲོ་བོའི་རྒྱལ་པོ་སྐུ་འཇིགས་རྔམ་བཟོད་དཀའ་བ་སྟོང་གསུམ་གང་བ་ཙམ་དུ་མཐོང་སྟེ་རང་འདྲའི་ཡེ་ཤེས་སེམས་དཔའ་སྤྱན་དྲངས་པ་སོགས་ཇི་བཞིན་སྒྲིབ་མེད་དུ་གཟིགས་ཤིང་སྔར་སྦྱོར་དྲུག་ཉམས་ལེན་སྐབས་ནས་ཀྱང་ནང་མཉམ་བཞག་གི་དུས་ཕྱིའི་ཡུལ་རི་མི་སྐྱ་ཕོ་མོ་སོགས་ཀྱི་གནས་ཚུལ་ཇི་བཞིན་གཟིགས་པའི་ཏིང་ངེ་འཛིན་གྱི་གསལ་ཉམས་ཆེས་བཟང་པོ་ཤིན་ཏུ་མང་ངོ།",
    "དེ་དག་གི་རྐྱེན་གྱིས་ཉམས་རྟོགས་ཀྱང་སྔར་ལས་རྒྱ་ཆེར་ན་འཕར་ཏེ་བོགས་བསྐྱེད་ཆེ་བར་གྱུར་ཏོ།",
    "ཉིད་འཛི་རོང་མཆོད་རྟེན་རབ་གནས་བྱེད་པར་ཕེབས་ཚེ་གནས་དེར་ངོ་མཚར་རབ་ཏུ་སྙན་པའི་མཆོད་ཆའི་སྒྲ་དབྱངས་ཆེས་མང་པོ་གསན་ཅིང་གཞན་ཡང་ཏིང་ངེ་འཛིན་བརྟན་པའི་གསལ་སྣང་ལ་དགོན་མདུན་གྱི་རི་ངོས་ན་གནས་པའི་སྲོག་ཆགས་ཆེ་ཕྲ་མཐའ་དག་གི་ལུས་སེམས་ཀྱི་རྣམ་པ་མ་ལུས་པ་གསལ་བར་མཁྱེན་པ་དང་ནམ་མཁར་གནས་པའི་རྒྱུ་སྐར་སོགས་ཀྱི་གཟུགས་སྣང་འགྱུར་ཏེ་སྣང་བ་དག་པ་སྒྱུ་མའི་འཕྲུལ་ལྟ་བུའི་གཟུགས་སྣང་རབ་འབྱམས་ཀྱིས་མ་དག་ལུས་སྣང་ཉེ་བར་འགོག་པའི་དགའ་ཆེན་ཡེ་ཤེས་མཆོག་ལ་རྟག་པར་རོལ་པའོ།",
    "དེང་སང་སྙིགས་དུས་སྒྲུབ་པའི་བསྟན་པའི་མཇུག་འདི་ལྟ་བུར་ནི་ཡན་ལག་དྲུག་པོ་རྒྱུད་ལས་བསྟན་པ་ལྟར་དངོས་གནས་སྐྱེ་ཐུབ་པ་དཀོན་པས་རྗེས་མཐུན་པ་ཙམ་གྱི་སྟེང་ནས་ལམ་ལ་ཡང་ཡང་སྒྲུབ་པ་ནན་ཏན་བྱས་ནས་ཆུའི་རྙོག་ལྟར་སེམས་རང་བཞིན་གྱིས་འོད་གསལ་བའི་དྲི་མ་རིམ་གྱིས་སྦྱངས་ཏེ་ཟུང་འཇུག་མཐར་ཐུག་གི་ཡེ་ཤེས་མངོན་དུ་བྱེད་དགོས་པ་དེ་བས་ན་འདིར་ཡང་དམ་པ་མཆོག་གིས་ལས་དང་པོ་པའི་ཚུལ་གྱིས་ཡན་ལག་དྲུག་ལ་ཉམས་ལེན་བྱེད་སྐབས་དེང་དུས་དང་བསྟུན་ནས་ལམ་རྣམས་ལ་གཙོ་བོར་རྗེས་མཐུན་པའི་མངོན་རྟོགས་བསྐྱེད་པའི་ཚུལ་གྱིས་རིམ་པར་སློབ་པ་སྟེ།",
    "དེ་ཡང་ཐོག་མར་དམ་པ་འདི་སྦྱོར་དྲུག་ལ་བཞུགས་སྐབས་ནས་བཟུང་མི་འགྱུར་བདེ་བའི་རང་གཟུགས་སྟོང་གཟུགས་ཕྱག་ཆེན་གྱི་ངོ་བོ་དེང་དུས་དང་མཐུན་པའི་བློ་དང་འཚམས་པར་རིམ་གྱིས་སྟོང་གཟུགས་སྣ་ཚོགས་ཀྱི་སྣང་བ་སྔོན་འགྲོའི་ཕྱག་གི་སྐབས་ནས་ཀྱང་བྱུང་བ་སོགས་སྦྱང་བ་སྔོན་སོང་གི་མྱོང་རྟོགས་དུས་སུ་སྨིན་པ་དེ་ལྟ་བས་ན་དམ་པ་མཆོག་གི་ཐུགས་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "འདི་སྐབས་ཀྱི་གནས་ལུགས་སྤྲོས་བྲལ་མི་རྟོག་པ་རྗེན་པར་ཤར་ཏེ་མངའ་བརྙེས་ཚུལ་ཡང་དམ་པ་ཉིད་ཀྱི་ཞལ་ནས་སློབ་བུ་འགའ་ལ་བར་སྐབས་རེ་གསུང་ཟུར་གནང་བ་བདག་གིས་ནི།",
    "ཅེས་གསུངས་པའི་དོན་དེ་རྟོགས་པ་རང་རེད།",
    "ཁྱོད་འཕགས་པའི་ས་ཞིག་བགྲོད་རྟགས་རེད།",
    "གང་གི་ཞལ་གྱི་གདམས་པ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཅེས་པ་ལྟ་བུའི་དགོངས་པ་རྙེད་ངེས་རེད་གསུངས་ནས་ཐུགས་མཉེས་ཆེན་པོ་རང་ཡང་མཛད་པ་སོགས་ལ་བསམ་ན་དམ་པ་འདིས།",
    "ཁོང་གི་ཉམས་སྣང་གི་སྟོང་གཟུགས་ལ་ཐིག་ལེ་རེ་ཁ་ནག་པོ་ཤིན་ཏུ་ཕྲ་ཞིང་དྭངས་པའི་ནང་དུ་སྟོང་གསུམ་གྱི་བཀོད་པའི་སྣང་བ་དང་།",
    "རེ་ཁ་ནག་པོ་དྲི་མེད་འོད་ཟེར་འཕྲོ་བ་དུས་ཀྱི་རྩ་ལ་མཐོང་བར་གྱུར་གྱི་བར་དུའོ།",
    "ཁམས་ལྔའི་དྭངས་མ་ལས་ཤར་བའི་ངེས་པ་ལྔ་ལྡན་གྱི་ཐིག་ལེ་ཆེས་ཤིན་ཏུ་གསལ་འཚེར་ཕྲ་ཞིང་འདར་བའི་ཉམས་ཅན་ཟིལ་བཟོད་དཀའ་བའི་གཟིགས་སྣང་དམ་པ་འདི་ལ་མངའ་བར་ཀུན་དགའ་ལུང་རྟོགས་ཞབས་པས་གསུངས་པ་སོགས་ཀྱིས་ཤེས་ནུས་ལ།",
    "དེ་དག་ཀྱང་འདིར་མ་ཟད་གོང་འོག་ཏུ་འཆར་ཚུལ་འདྲ་མིན་ཅི་རིགས་ཡོད་ཅིང་དེ་ཀུན་ཇི་བཞིན་མཐོང་ཚེ་མིག་གིས་གཟུགས་ལ་བལྟ་བ་ལྟ་བུ་མ་ཡིན་པར་མཚན་འཛིན་སྤྲོས་སྣང་གིས་མ་བསླད་པར་དབྱིངས་སྐྱེ་བ་མེད་པའི་ངང་ནས་ཇི་བཞིན་ཡིན་ལུགས་སྨྲ་མི་ཤེས་པའི་ཚུལ་གྱིས་མཐོང་བ་སྟེ།",
    "ཡང་དམ་པ་མཆོག་གི་ཐུགས་ཉམས་སུ་ཡན་ལག་གསུམ་པ་སྲོག་རྩོལ་གྱི་རྣལ་འབྱོར་ཡང་བཞེས་པ་སྟེ།",
    "རྩ་འཁོར་སྟེང་མ་གསུམ་ཐུར་བསྟན་གྱི་ཚུལ་དུ་ཡོད་པས་གཟིགས་ཚུལ་དེ་ལུགས་ལྟར་དང་སྲོག་རྩོལ་གྱི་ཉམས་ཆ་ཤས་སམ་རྗེས་མཐུན་པ་སྐྱེས་པའི་རྟགས་སུ་གསུངས་ཤིང་།",
    "ཀླས་པ་སྐད་ཅིག་རེ་ནས་ཁ་བ་བབས་པ་ལྟར་སླར་རང་ལུས་ལ་ཐིམ་སོང་བས་བདེ་སྟོང་ཞུ་བདེ་འདྲེས་མས་ལུས་སེམས་སིམ་པར་བྱེད་པ་དེ་དག་ཀུན་ཀྱང་སྐབས་འདིའི་རྟགས་སུ་མངོན་ནོ།",
    "དམ་པ་འདིའི་ལྟེ་བ་སྤྲུལ་པའི་འཁོར་ལོ་རྩ་འདབ་དྲུག་ཅུ་རྩ་བཞིའི་ནང་དུ་ཚེས་ཀྱི་ལྷ་སུམ་བརྒྱ་དྲུག་ཅུའི་གཟུགས་སྣང་བརྟན་པོ་རྣམ་པ་དུས་ཀུན་ཏུ་ཡོད་པར་ལྷ་བཟོ་རྡོ་རྗེ་འཆང་གི་ཞལ་ནས་གཙང་སྐུ་ཆེན་ཀརྨ་མཐུ་སྟོབས་རྣམ་རྒྱལ་ལ་ལེགས་གསུང་བསླུ་མེད་ཀྱི་གནང་བ་བཞིན་དང་།",
    "དེ་འདྲའི་སྒོ་ནས་ཞུ་བདེའི་ཉམས་བརྗོད་མི་ཤེས་པ་སྐྱེས་པའི་སྣང་བ་གང་དག་ནི་ཁོང་ལ་ཀུན་དགའ་མཉམ་ཉིད་ཞབས་པའི་ཉམས་མྱོང་གིས་འཛིན་པ་རྗེས་མཐུན་གྱི་ཉམས་སུ་ངོ་སྤྲོད་ལེགས་པར་མཛད་པས་ཀྱང་སྐབས་འདིའི་རྟགས་སུ་ངེས་ནུས།",
    "དམ་པ་གང་གིས་སློབ་བུ་སྐལ་ལྡན་འགའ་ལ་ཞལ་གསུང་གནང་བ།",
    "ད་ནི་བདག་གི་ལུས་གདོས་བཅས་ཀྱི་སྣང་བ་འདི་ཀ་ཉིད་ཡེ་ཤེས་ཀྱི་ཇོ་ནང་དཔེ་ཚོགས།",
    "རང་བཞིན་འོད་གསལ་སེམས་ཀྱི་གནས་ལུགས་ཉག་གཅིག་གི་དབྱིངས་ནས་ཡི་དམ་བྱེ་བ་རབ་འབྱམས་རྒྱལ་བ་རྒྱ་མཚོའི་དཀྱིལ་འཁོར་མ་ལུས་པའི་བཀོད་པ་ཅིར་ཡང་སྤོ་བར་མཛད་པ་ལ་སྐད་ཅིག་རེ་ནས་ཐམས་ཅད་འགྲུབ་ནུས་པས་ད་ནི་ལྷ་གང་གི་ངོ་བོ་ཡང་མོས་སྒོམ་གྱི་བློས་བྱས་མི་དགོས་འདུག་བདག་གི་རྒྱུད་ལ་རྗེས་དྲན་གྱི་རྟོགས་པ་རྗེས་མཐུན་པ་རེ་སྐྱེས་པ་རེད།",
    "མཉམ་བཞག་གཅིག་གིས་སྟོང་གཟུགས་རྒྱལ་བ་གཙོ་འཁོར་གསུམ་གྱི་གཟུགས་སྣང་ལས།",
    "དག་ཆེན་སྒྱུ་མ་སྐུ་ཡི་ལང་ཚོ་བདོ།",
    "རང་བྱུང་རྡོ་རྗེའི་གླུ་དབྱངས་འགོག་མེད་ཐལ།",
    "གངྒཱའི་བྱེ་སྙེད་འཇིག་རྟེན་གསེར་དག་གིས།",
    "དེ་ཡང་དགུང་ལོ་ང་དྲུག་པ་རབ་མྱོས་ཞེས་པ་ལྕགས་རྟའི་ལོར་སྐྱབས་མགོན་ཀུན་དགའ་མཚན་བཟང་པོ་གང་གི་ཞལ་ནས།",
    "འདི་ལོར་དམ་པ་མཆོག་གིས།",
    "འཛམ་ཐང་ཚོགས་པའི་ཁྲི་བ་དང་།",
    "དགུང་ལོ་རེ་གཅིག་ན་ཚོད་ལྡན་ཞེས་པ་ཤིང་ཕག་ལ་སྦྱོར་དྲུག་པ་བླ་རིག་སོགས་ལྔ།",
    "དགུང་ལོ་རེ་གཉིས་འཛིན་བྱེད་ཅེས་པ་མེ་བྱི་ལ་སྦྱོར་དྲུག་པ་དུས་ཟིང་ཆེ་བས་མེད་ཀྱང་ཁོང་གིས།",
    "དགུང་ལོ་རེ་བཞི་འབྲུ་མང་པོ་ཞེས་པ་ས་སྟག་ལ་སྦྱོར་དྲུག་པ་ཀུན་སྨོན་སོགས་བཞི།",
    "དགུང་ལོ་རེ་ལྔ་མྱོས་ལྡན་ཞེས་པ་ས་ཡོས་ལ་སྦྱོར་དྲུག་པ་ཀུན་དགའ་བཟང་སོགས་ལྔ།",
    "དགུང་ལོ་རེ་དྲུག་རྣམ་གནོན་ཞེས་པ་ལྕགས་འབྲུག་ལ།",
    "གཉིས་ལ་རབ་བྱུང་བསྙེན་པར་རྫོགས་པ་དགེ་ཚུལ་སློང་གི་སྡོམ་པ་ལེགས་གནང་མཛད་པ་སྟེ།",
    "དེ་ལྟ་བུའི་སྒོ་ནས་སྐལ་བ་དང་ལྡན་པ་གང་དག་ལ་གནས་སྐབས་དང་མཐར་ཐུག་གི་ཕན་བདེ་ཅིར་ཡང་བསྐྲུན་པར་མཛད་པ་ལགས།",
    "བར་སྐབས་སུ་དུས་ཀྱི་འཁོར་ལོ་ཡོངས་རྫོགས་ཕྱག་མང་གི་རྣམ་པ་དང་།",
    "སློབ་བུ་ཞིག་གི་ཉམས་སྣང་ལ་དཔལ་རྡོ་རྗེ་འཇིགས་མཛད་ཆེན་པོ་ཕྱག་མང་ཡོངས་རྫོགས་སྟོང་གསུམ་གང་བ་ཞིག་སྐད་ཅིག་གིས་གར་སྟབས་དང་བཅས་པས་བྱོན།",
    "སླར་དཔག་ཚད་ཙམ་བཀྱེད་སོང་བའི་སྣང་བ་ཤར།",
    "དེའི་ཐུགས་ཀ་ནས་དྲུག་བརྒྱ་སོ་དྲུག་གི་ལྷ་ཚོགས་ཕར་སྤྲོས་ཏེ་མདུན་བསྐྱེད་རྟེན་དང་བརྟེན་པ་ལ་ཐིམ་ཞིང་།",
    "སྐལ་བཟང་གང་རེག་ཡིད་ལ་བདེ་དགའ་སྦྱིན།",
    "ལེགས་སྦྱིན་ཉལ་འགྲོའི་ཀླུང་གི་རྗེས་འགྲོ་བས།",
    "འཕགས་མཆོག་བརྩེ་ཆེན་གཟིགས་པས་བཟོད་མིན་ཏེ།",
    "དེ་སླད་ཡིད་བདེའི་ངལ་བསོ་རེ་བ་གང་།",
    "སྐལ་བཟང་ཉེར་སྤྱོད་རབ་རྒྱས་ཁྱོད་ཀྱི་དྲིན།",
    "རྟ་མགྲིན་གཞུང་ཁྲིད་རྣམས་དམ་པ་མཆོག་གིས་བཀའ་དྲིན་དུ་མཛད་པ་སོགས་གདམས་ཟབ་ཀྱི་རྒྱུན་འགའ་རེ་ཡང་ལེགས་སྤེལ་མཛད་ངོས་ནས་དེ་ལོར་ཁོང་གི་ཞལ་ནས།",
    "ཁོང་གི་ཞལ་ནས་ད་ནི་བདག་གི་བསམས་པ་འགྲུབ་ནི་ཡིན།",
    "འདི་སྐོར་ཕན་དུ་སྐབས་སྐབས་སུ་ཁོང་གི་ཞལ་ནས་སློབ་བུ་རྣམས་ལ་ཞལ་གདམས་ཡང་འདི་ལྟར་མཛད་དེ།",
    "ཁྱེད་སློབ་བུ་དག་གི་ཡིད་ལ་འདི་བཞིན་ཞོག་ཕ་དམ་པའི་ཞལ་ནས།",
    "ཡང་ཁོང་གི་ཞལ་སྔ་ནས་གསུངས་པ།",
    "ཆད་རེས་འདི་ནས་རྡོག་སྣ་འདྲེད་གྱུར་ན།",
    "གཞོན་པའི་དུས་སུ་དཀའ་ཐུབ་རེམ་ལ་གྱིས།",
    "ཉོན་མོངས་སྐྱེས་ཚེ་གཉེན་པོས་སླེབས་པར་གྱིས།",
    "མཆོག་ཐུན་མོང་འགྲུབ་པའི་སྔ་ལྟས་ཡིན།",
    "ཡང་བར་སྐབས་རེར་ཁོང་གིས་སློབ་བུ་དག་ལ།",
    "ཡང་ཁྱེད་རང་སློབ་བུ་གང་དག་གི་སེམས་ལ་འཛིན་རྒྱུ་གཞན་ཡང་།",
    "ད་ཁྱེད་བྱོན་པ་བཟང་འདུག་རང་གི་རྒྱུ་རྫས་ཐང་སྣམ་ཁ་གང་།",
    "ཁོང་གིས་ད་རེབ་ཕན་ལ་བདག་མི་འདུག་སེམས་ཐག་ཆོད།",
    "ཁྱེད་ཀྱི་ཐུགས་ཇི་ལྟར་རེད།",
    "བདག་གི་སེམས་ནམ་མཁའ་སྔོ་སང་ངེ་བ་སྟོན་གནམ་གཡའ་དག་ལྟ་བུའི་སྤྲོས་པ་ཀུན་བྲལ་ཞིག་རེད།",
    "ཚེས་བཅུ་བདུན་གྱི་མཚན་མོར་ཉིད་ཀྱིས་ཧིག་སྒྲ་ལན་བདུན་ཙམ་མཛད།",
    "ཡང་སློབ་བུ་དག་གིས་བཞུགས་ཞུས་ཕུལ་ཚེ།",
    "དཀོར་ནག་པོ་སྲོག་གི་སྤུ་གྲི་ཡིན།",
    "ཡང་སྐབས་རེར་ཉིད་ཀྱི་ཞལ་ནས།",
    "ནོར་བུའི་རྩེ་མོ་ཉི་རྡུལ་བརྟན།",
    "སྤྱིར་དེ་བཞིན་གཤེགས་པ་སོགས་ཀྱི་མཆོད་རྟེན་དང་སྐུ་གཟུགས་ལེགས་བཞེངས་བགྱིས་ན་མཆོད་རྟེན་དང་སྐུ་གཟུགས་ལ་རྡུལ་ཕྲ་རབ་ཅི་སོང་བའི་གྲངས་སྙེད་ཀྱི་མངོན་མཐོ་ལྷ་མིའི་རྒྱལ་སྲིད་ཀྱི་བདེ་འབྱོར་རྟེན་བཞེངས་མཁན་རྣམས་ལ་ཐོབ་ཅིང་།",
    "ཡིད་འོང་གི་དངོས་པོ་དང་ལྡན་པ་དང་།",
    "འཇིག་རྟེན་ན་མིག་གིས་མཐོང་ཚེ་བལྟ་ན་སྡུག་པའི་ཡོན་ཏན་དང་ལྡན་པ་དང་།",
    "སྐུ་གཟུགས་རྣམས་ལ་རྡུལ་ཕྲན་ཅི་སོང་བ།",
    "མཁའ་འགྲོ་མ་དང་རང་བཙུན་མོ།",
    "གསང་ཆེན་ཉམས་བརྒྱའི་ལང་ཚོ་ཅིར་ཡང་བཀྲ།",
    "འདི་ན་གདུལ་བྱའི་མོས་ངོར་རོལ་པའི་འཕྲུལ།",
    "གང་གི་སློབ་འགའི་གསུང་སྒྲོས་ཁོ་ན་བསྐྱངས།",
    "གང་འདུལ་མོས་སྣང་དེར་འཆར་བ།",
    "དཔལ་ལྡན་འཁོར་འདས་སྲོག་གི་བཅུད།",
    "ཟབ་རྒྱས་གླིང་གི་ནོར་འཛིན་གཞིར།",
    "སོར་མོའི་འཕྲུལ་ཆེན་འཛིན་པ་ཉིད།",
    "གང་གི་གསང་གསུམ་ཆ་ཤས་ཕྲ་བའི་འཕྲུལ།",
    "རྐྱེན་གེགས་ཉམས་ཆག་གང་གིས་གོས་མེད་ཤོག།",
    "ཟབ་མོའི་ལྟ་བ་སྤྱི་དང་ཁྱད་པར་དུ།",
    "ཡེ་ཤེས་དཀྱིལ་འཁོར་མོས་བློས་བཏགས་པའི་རིགས།",
    "ཁྱབ་བདག་རྡོ་རྗེ་འཆང་གིས་དགེ་མཚན་ཕོབ།",
    "གང་འདུལ་མོས་ངོར་མཛད་བཟང་རབ་འབྱམས་ཅན།",
    "གདམས་ཟབ་ངག་གིས་འགྲོ་ཕན་སྤེལ་མཛད་མགོན།",
    "གང་གི་གསང་གསུམ་ཀུན་ཁྱབ་ཐམས་ཅད་པ།",
    "ཇི་བཞིན་ངག་གིས་བརྗོད་བྱའི་ཡུལ་ལས་འདས།",
    "རེ་ཞིག་དང་པོར་དངོས་གྲུབ་ནི།",
    "བདེ་མཆོག་གི་རྒྱུད་ལས།",
    "ཞེས་སོགས་ལྟར་མོས་གུས་ཀྱིས་ལེགས་པར་བསྒོམ་སྟེ།",
    "དེ་ལའང་གང་གི་རྣམ་པར་འཕྲུལ་པ་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "དེ་ནས་ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོ་དུས་ཀྱི་འཁོར་ལོའི་ལྷའི་རྣལ་འབྱོར་བསྐྱེད་རིམ་ལ་འཇུས་ཏེ་མ་དག་ཐ་མལ་གྱི་སྣང་བ་སྦྱངས་ནས་རྫོགས་རིམ་སྐྱེ་སླ་བར་བྱས།",
    "དེ་ནས་རྡོ་རྗེ་འཆང་རྗེ་ལུང་རྟོགས་མཆོག་གིས་དངོས་གཞི་རྫོགས་རིམ་གྱི་ཉེར་བསྡོགས་གནས་མུན་ཁང་བརྟེན་ཚུལ་ལུས་བྱེད་བཅིངས་སྡོམ་ལུགས་ཡིད་མི་རྟོག་པ་ལ་མཉམ་པར་འཇོག་ཚུལ་མན་ངག་ཞལ་ཤེས་ཀྱི་རྒྱུན་བཞིན་མུན་ཁྲིད་ཞིབ་རྒྱས་ལག་བླང་ཐེབས་ངེས་བཀའ་དྲིན་དུ་བྱས།",
    "དངོས་གཞི་སོར་སྡུད་མཚན་མོ་དང་ཉིན་མོའི་རྣལ་འབྱོར་གྱི་སྐབས་འོད་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "དེ་ནས་བསམ་གཏན་གྱི་མཚན་མོའི་རྣལ་འབྱོར་དང་རྡེའུ་གྲིབ་གཟུགས་སོགས་དང་།",
    "སེམས་ཀྱི་རང་གཤིས་སྟོང་གཟུགས་སུ་ཆེས་མངོན་ཞིང་སྟོང་གཟུགས་རགས་པའི་སྣང་བ་རྣམས་ཀྱང་ལྷ་སྐུ་དང་ཡིག་འབྲུའི་རྣམ་པ་རེ་རེས་སྲིད་གསུམ་ཁྱབ་སྣང་དང་སྟོང་གཟུགས་ཕྲ་བ་རྣམས་ཐིག་ལེ་སྤུ་རྩེ་ཙམ་གྱི་ནང་ལ་གཤིན་རྗེའི་གཤེད་ཀྱི་ལྷ་སྐུའི་སྣང་བརྙན་བྱེ་བ་རབ་འབྱམས་ཚད་བཟུང་དང་བྲལ་བའི་སྣང་བ་དང་།",
    "དེ་ཕན་འཁྲུལ་འཁོར་འཁྱེར་སྐབས་ཀུན་ཏུའང་སྔར་གྱི་སྤྲུལ་པའི་བཤེས་གཉེན་གྲུབ་ཐོབ་པའི་རྣམ་པ་ལ་སྤྱན་བཙུམ་ནས་གཟིགས་པ་ཁོ་ནས་འཁྲུལ་འཁོར་འཁྱེར་ཐུབ་པ་བྱུང་ཞིང་།",
    "གཟུགས་སྐུ་མྱུ་གུའི་ལང་ཚོ་ཅིར་ཡང་ངོམ།",
    "སྒྲིབ་པ་རྣམ་སེལ་ཡུམ་རེག་བྱ་རྡོ་རྗེ་མ་དང་།",
    "འདི་སྐོར་དུ་རྡོ་རྗེ་འཆང་རྗེ་ལུང་རྟོགས་ཞབས་པ་གང་གི་ཞལ་གྱི་བུམ་བཟང་ལས།",
    "སྦྱོར་དྲུག་གི་ཁྲིད་མཐོང་བ་དོན་ལྡན་ལྷན་ཐབས་བཅས་དང་།",
    "འདི་ལོར་རྡོ་རྗེ་འཆང་གི་ཞལ་སྔ་ནས།",
    "སྤྱིར་ན་ཡི་དམ་གྱི་ལྷ་གང་གི་རྣམ་པ་ཡིད་ལ་བྱས་ཚེ་མོས་སྒོམ་བློས་བྱས་ཆེར་དགོས་པའི་དཀའ་ངལ་མེད་པར་སྟོང་གཟུགས་རྣམས་དེ་དང་དེར་གནས་འགྱུར་འགྲོ་བ་ལྟ་བུའི་རྫོགས་རིམ་གཉུག་མའི་ལྷ་སྐུ་རང་གསལ་དུ་ཕལ་ཆེར་བར་མངོན་དུ་བྱེད་པའི་ཚུལ་གྱིས་གནས་ནུས་པ་དང་།",
    "ནག་པོ་ཞིག་གིས་ལེགས་ཉེས་གསལ་བར་ལུང་སྟོན་པ་ཡོད་པར་ཡང་གྲགས་སོ།",
    "ཁྱིམ་གྱི་རྩིག་ངོས་སུ་སྐྱ་མི་རྒྱུག་སྣང་སོགས་གནས་སྣང་གཞན་དུ་གྱུར་པའི་རྩུབ་ཉམས་ཆེས་མང་བ་དེ་ཐམས་ཅད་རང་གི་སེམས་སྣང་ཙམ་དུ་ཟད་པར་ཤེས་པའི་ངང་ནས་བཟང་ངན་ལ་རེ་དོགས་གང་ཡང་མེད་པར་ཞེན་བྲལ་རོ་སྙོམས་འབའ་ཞིག་ཏུ་བསྐྱངས་པར་བྱས།",
    "དགུང་ལོ་ཉེར་གཉིས་པ་ཕུར་བུ་ཞེས་པ་ས་སྤྲེལ་ལོར་སྐྱབས་རྗེ་རྡོ་རྗེ་འཆང་གི་བཀའ་འབུམ་ཆ་ཚང་གི་ལུས་དཀྱིལ་སྒྲུབ་ཐབས་ཉེར་མཁོ་བསྡུས་པ་མཐའ་དག་བསྙེན་མཚམས་ཡོངས་རྫོགས་དང་།",
    "དམ་པ་འདི་ལ་སོ་ཐར་ཚིགས་ཕྱི་མ་བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་བསླབ་སྡོམ་ཉེར་བར་བསྩལ་ཏེ་མཚན་ཤཱཀྱའི་དགེ་སློང་འོད་གསལ་འགྱུར་མེད་ཅེས་གསོལ་ཞིང་ནང་གསང་སྔགས་རྟོགས་པའི་ནོར་གྱིས་ཕྱུག་བཞིན་ཕྱི་ངུར་སྨྲིག་རྒྱལ་མཚན་འཆང་བའི་རྟེན་ཁྱད་པར་བ་ཉིད་དུ་ངེས་པར་མཛད་དོ།",
    "གང་འདི་ས་གསུམ་འགྲོ་བའི་ཕྱག་གི་ཡུལ།",
    "ཡང་དག་མཛད་བཟང་སྐྱོང་བའི་རིག་འཛིན་ཁྱོད།",
    "ཡང་རེ་ཞིག་ཏུ་རྡོ་རྗེ་འཆང་ཉིད་ཀྱི་ཞལ་སྔ་ནས།",
    "ཐུགས་སྲས་མཆོག་ཉིད་མེ་དཔུང་ལས་མེ་སྟག་མཆེད་པ་ལྟར་ཁོང་གི་ཐུགས་ལས་མཆེད་པའི་སྤྲུལ་པ་ཉིད་དུ་ངེས་ཤིང་།",
    "ཁྱོད་སྐྱེ་བ་སྔོན་སྟོད་ཕྱོགས་སུ་བྱ་བྲལ་བ་དུ་མར་སྐྱེས་པས་ཚེ་འདིར་བྱ་བྲལ་ཙམ་མ་འོངས་ཀྱང་དགོན་འདིར་འདུག་ན་ཚེ་མཐར་འཁྱོལ་ཞིང་དགོན་འདི་ལ་ཕན་པ་ངེས་པར་འབྱུང་ཚུལ་འགྱུར་མེད་རྡོ་རྗེའི་ཚིག་གིས་བཀའ་ལུང་གསལ་བོར་ལེགས་པར་བསྟན་པ་མ་ཟད་གཙང་བའི་བླ་ཚབ་ཏུ་དེའི་བར་འགྲོ་དགོས་ཚུལ་ད་ལྟ་བཅའ་ཀ་སྒྲིག་བྱེད་དགོན་ལ་ཡོན་བཅོས་ཀྱི་བགོས་སྐལ་ཕྲུག་དུམ་བཞག་ན་ནམ་ཞིག་དགོས་མཁོ་ཡོད་ཚུལ་ཚུན་གྱི་གསུང་གླེང་ཞིབ་རྒྱས་གནང་བ་སོགས་ལ་དཔགས་ན་དམ་པ་འདི་ཉིད་སྙིགས་དུས་སུ་བསྟན་པ་དང་གདུལ་བྱ་འགའ་ལ་ཕན་ཐོགས་ཆེ་ཞིང་འགྲོ་འདུལ་དུས་བབ་ཏུ་བྱུང་བའི་སྔགས་ཀྱི་སློབ་དཔོན་བཤེས་གཉེན་མཆོག་གཅིག་ཏུ་སྔོན་ནས་ལས་འཕྲོ་ཡོད་ངེས་སུ་ཆེས་ཤིན་ཏུ་རྟོགས་ནུས་སུ་ཡོད་པ་ཡིན་ལ།",
    "མ་དག་གནས་འགྱུར་ཡེ་ཤེས་སྒེག་མོའི་ལུས།",
    "ཚུལ་དེ་ཞུས་པས་ཁོང་གིས་ཀྱང་རྣམ་སྨིན་སྒྱུ་ལུས་དབྱིངས་སུ་དག་པ་ཡིས།",
    "རྣམ་གསུམ་སྲིད་པ་ལ་གནས་ཡེ་ཤེས་རྣམས་ཤེས་དབྱེ་བ་དག་གིས་རྣལ་འབྱོར་པ་ཡིས་རིག་པར་བྱ།",
    "དེ་ལྟ་བུའི་ཉམས་མྱོང་གི་རྟོགས་པའི་གདེང་ཚད་ཅིག་དགུང་ལོ་ཉི་ཤུའི་ནང་འདི་སྐོར་སྟོད་སྨད་ལ་ཡོད་པར་མངོན་ནོ།",
    "སྤྱིར་ན་ཡ་རབས་དམ་པའི་སྤྱོད་པ་ཆོ་གའི་ཕྱག་ལེན་ཐིག་རྩ་དབྱངས་འདོན་རྟ་གཏོར་བཟོ་རོལ་མོ་དཀྲོལ་བ།",
    "སྐུ་ན་ཚོད་གཞོན་པའི་དུས་སུའང་ཁོང་གི་ཐུགས་ཉམས་སུ།",
    "མཚན་མོ་དག་ནི་མཛེས་མ་ཡིན།",
    "དུས་རྒྱུན་དུ་དམ་པའི་སྤྱོད་པ་ཡ་རབས་ཀྱི་རིགས་གནས་ལ་རང་གིས་སློབ་པ་དང་གཞན་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ལོང་བ་རི་མོ་འོན་པ་པི་ཝང་དང་།",
    "དགུང་ལོ་ཉེར་ལྔ་པ་ལྕགས་ཕག་ལོ་འདི་ནས་སྐྱབས་རྗེ་རྡོ་རྗེ་འཆང་ལུང་རྟོགས་རྒྱ་མཚོ་སྐུ་ཞི་བར་གཟིམས་པ་ལ་ཉེ་བའི་སྐབས་སུ་ཁོང་གི་ཞལ་སྔ་ནས།",
    "མོའི་འཆམ་གཉིས་ཡོད་པ་ལས་ཁྱོད་ཀྱིས་མཐོང་བ་དེ་ཕོ་འཆམ་རེད།",
    "འཛི་སྟོད་ནས་དེ་འདྲ་འོང་ན་དེ་ཕྱོགས་ནས་ཕོ་ཞིག་གི་རོ་དུར་ཁྲོད་འདིར་ཐོན་པ་སོགས་ཀེང་འཆམ་ཕོ་མོའི་ཁྱད་པར་དང་ཕྱོགས་གང་ནས་འོང་བརྟག་པས་སྟོད་སྨད་ཀྱི་ཕོ་མོའི་རོ་དུར་ཁྲོད་འདིར་ཇི་ལྟར་ཐོན་གོ་ནུས་པ་ལྟ་བུ་ཡོད།",
    "ཅེས་གསུངས་པ་ལྟར་དེའི་སང་ཉིན་སྟོད་ཕྱོགས་ནས་ཕོ་ཞིག་གི་རོ་དུར་ཁྲོད་དུ་ཐོན་པ་དང་།",
    "དགུང་ལོ་སོ་ལྔ་པ་ལྕགས་བྱ་ལ་རང་དགོན་དུ་རྡོ་རྗེ་སློབ་དཔོན་མཆོག་གི་ཞལ་ལུང་ལས།",
    "དགུང་ལོ་ཞེ་གཅིག་པ་རབ་བྱུང་བཅུ་དྲུག་པའི་ཐོག་མ་རབ་བྱུང་ཞེས་པ་མེ་ཡོས་ཀྱི་ལོར་རང་དགོན་གྱི་རྡོ་རྗེ་སློབ་དཔོན་མཆོག་གི་ཞལ་ནས།",
    "རྣམས་ལོ་རེ་རེ་བཞིན་ཐོབ་པ་དང་།",
    "ཡང་བར་སྐབས་རེར།",
    "ཀུན་མཁྱེན་ཆེན་པོའི་བཀའ་པོད་དྲུག་གི་བཀླག་ལུང་།",
    "འདི་སྐོར་ཨ་བཟང་སྦ་གསར་ཚང་ལ་བསྐང་གསོལ་མཛད་ནུབ་མོ་མཁར་བདག་མི་མིན་རིགས་ཀྱིས་མཐོ་འཚམས་པ་རེ་འདོད་ཀྱང་ཁོང་གིས་ཟབ་མོ་གཅོད་དམིགས་མཆོག་གིས་བདུད་བཞི་དབྱིངས་སུ་རོ་སྙོམས་མཛད་པས་འཚེ་བ་ཅི་ཡང་མ་ནུས་སོ།",
    "ངེད་དང་ནམ་ཡང་གཡེལ་བ་མི་མངའ་བ་བཀའ་ཐ་ཚིག་གིས་ལུས་དང་གྲིབ་མ་བཞིན་འགྲོགས་པ་ཡིན།",
    "ནང་སྔ་མོ་ཉེ་འཁོར་ན་ཡོད་པ་དག་ལ་ཇི་བཞིན་བསྙད་དེ་མདང་གི་རྨི་ལམ་ལྟར་ན་རང་ལ་དར་ཞིག་འཐེན་པ་འོང་སྣང་ཡང་དར་དེ་ལ་ནམ་ཞིག་རང་ཕྱོགས་ལ་འཚུབ་པའི་དྲུད་ཅིག་ཡོད་པ་འདྲ་གསུངས་པ་ལྟར་ཕྱིས་སུ་གཙང་བའི་བླ་འཚབ་ཏུ་བྱོན་སྐབས་རང་ཁྱིམ་ལ་མི་བདེ་བ་དེ་ལུགས་ཀྱི་དྲུད་བྱུང་བས་ཇི་བཞིན་ཐོག་ཏུ་ཁེལ།",
    "ཁྱོད་ཅག་མ་འོངས་ཤིག་ཅེས་གསུངས་མ་ཐག་ཁྱི་རྣམས་རེངས་ཤིང་ཅི་ཡང་མི་ནུས་པ་ཅན་དུ་གྱུར་སྐད་དོ།",
    "འདི་དག་གི་སྐབས་སུ་ཤུལ་གྱི་རང་ཁྱིམ་ལ་ཁོང་ཉིད་ཀྱི་ཕ་སོགས་ཤི་ཆད་འགའ་རེ་འོང་ལ་གནས་ཚུལ་དེ་ཀུན་ཉིད་ནས་མངོན་གསུམ་བཞིན་མགོ་ལོག་ནས་ཇི་བཞིན་མཁྱེན་ཅིང་སྔར་གསུངས་པའི་དར་གྱི་དྲུད་ཡོད་ཅེས་པའང་འདིར་དུས་ཐོག་ཏུ་ཁེལ།",
    "ཁོང་གིས་རྗེས་སོར་ཡང་སྔར་གྱི་གཤིན་པོ་གང་དག་ལ་ཕན་མ་ཐོགས་བསམ་པ་མེད་ཚུལ་གྱིས་གསུངས་ཟུར་ཡང་ཡང་བྱུང་གིན་འདུག་པ་ལྟར་གྱི་འགྲོ་བ་གདུལ་ཞིང་ལ་ཕན་པ་རྒྱ་ཆེར་བྱུང་།",
    "རྗེས་ནས་ཀྱང་ས་ཐག་རིང་བ་ནས་འོང་བའི་མགྲོན་པོ་རྣམས་ཇི་ལྟར་འོང་གིན་ཡོད་སྒྲ་ལ་བརྟེན་ནས་མཁྱེན་ཚུལ་མང་དུ་གསུངས་པ་སོགས་ཐག་རིང་གི་སྒྲ་སྐད་མཁྱེན་པའི་རྣ་བའི་མངོན་ཤེས་བསྙོན་མེད་དུ་མངའ་བ་ཉེ་འཁོར་གྱི་སློབ་བུ་དག་གིས་མྱོང་བས་ཇོ་ནང་དཔེ་ཚོགས།",
    "སྔར་རྡོ་རྗེ་འཆང་ཉིད་ཀྱི་ཞལ་གསུང་གིས་བཀའ་ལུང་གསལ་བོ་གོང་སྨོས་བཞིན་དང་།",
    "ཁོང་གི་ཞལ་ནས་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཡིག་མཛོད་ལྡེ་མིག་འདི་རྣམས་ཁྱོད་ཀྱིས་ཉར་ཚགས་ཡག་པོ་མཛོད་ཅིག་ཅེས་དེ་ཐམས་ཅད་ཀྱང་ལེགས་པར་གཏད་པ་ན།",
    "དེ་ཡང་རེ་ཞིག་བསྔགས་འོས་ན།",
    "ཞེས་རྡོ་རྗེའི་མངོན་མཁྱེན་བསླུ་མེད་ཀྱིས་ཇི་བཞིན་གཟིགས་པ་ལྟར་ཡིན་ལུགས་གསལ་པར་བཀའ་གསུང་གིས་འགྱུར་བ་མེད་པར་ལུང་བསྟན་དང་བཅས་པས་གཟེངས་བསྟོད་གནང་།",
    "ནང་སྔ་མོར་ཤོག་ཅིག་གསུངས།",
    "དེ་ལྟར་བྱས་སྐབས་ཉིད་ནས་མདང་གི་རྨི་ལམ་ལྟར་ན་རང་ཡུལ་འདི་ནས་ཕྱག་འཁྱེར་མཁན་གསུམ་རིམ་པར་འོང་སྣང་ཡང་ད་ལན་ཐོག་མ་ཁྱོད་ཀྱིས་ཕྱག་འཁྱེར་བ་འདི་ཀ་ལེགས་པོ་འོང་ཞིང་ཚེགས་མེད་དུའང་ཐོན།",
    "བར་བ་ཅན་དེ་ཅུང་དཀའ་ངལ་ཆེ་རབ་རེ་འོང་སྲིད།",
    "འདིའི་དཔྱིད་དུ་སྤྱིའི་སྲུང་རིམ་རྡོ་རྗེ་འཇིགས་མཛད་ཀྱི་དྲུག་ཅུ་རྩ་བཞི་པའི་གཏོ་སྒྲུབ་ཀྱི་གོང་བཞུགས་མཛད་ནས་གསེར་སྐྱེམས་ཀྱི་དུས་སུ་ཁོང་གིས་ཆེ་བརྗིད་བསྐྱེད་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཕྱི་མ་གཉིས་ཀྱི་ཅིག་ཤོས་དེ་དམ་པ་འདི་ཉིད་ཡིན་པར་སྔོན་གནས་མཁྱེན་པའི་མངོན་ཤེས་ཀྱིས་གཟིགས་ཏེ་ཚུལ་དེ་ལུགས་ལྟར་དུ་གསུངས་པ་དང་།",
    "རིང་ཐུགས་ཉམས་སུ་འཇའ་ཟེར་དུ་མའི་དབུས་ན་འཕགས་པ་སྤྱན་རས་གཟིགས་ཞལ་གཅིག་ཕྱག་བཞི་པའི་སྐུའི་སྣང་བ་འབའ་ཞིག་གིས་ཐ་མལ་འདི་སྣང་འགོག་པ་ཁོ་ནར་བྱུང་ཞིང་དེ་སྐོར་ལ་སྲིབ་ལུང་དུ་གཉེར་སྐོར་གྱི་སྤྱི་སྲུང་གི་དབུ་བླར་བྱོན་དགོས་བྱུང་བའི་ནུབ་མོར་གནས་བདག་ཁྱུང་མགོན་གྱི་སྡོད་གནས་སུ་ཕེབས།",
    "ཁང་བཟང་ལེགས་པའི་ནང་དུ་ཁོང་དགེ་སློང་གི་གཟུགས་སུ་ཡོད་ལོངས་སྤྱོད་འབྱོར་བ་ཆུང་ངུར་འདུག་པས་ཁོས་བསང་མཆོད་བྱས་ན་རང་གིས་སྡོང་གྲོགས་བྱེད་ངེས་ཀྱི་གཡར་དམ་ཡང་མཛད་འདུག་དེ་ལ་བསམ་ནས་ཁོང་གིས་ད་རེབ་ཀྱི་བསང་རྣམས་ཀྱང་སྦྱིན་པས་ཁོ་ལ་ལོངས་སྤྱོད་ཀྱི་འབྱོར་བར་ཅུང་ཙམ་ཕན་པ་བྱུང་ཞིང་གནས་བདག་དེ་ནི་སྤྱིར་དཀར་ཕྱོགས་པ་ཞིག་ཀྱང་ཡིན་ལ།",
    "འདི་སྐོར་ལས་ཅུང་རྗེས་སུ་ཁོང་གི་རྨི་ཉམས་སུ་བན་ཆུང་ཞིག་གིས།",
    "མགོན་པོའི་ཞལ་གཟིགས་པ་རེད།",
    "དགུང་ལོ་ང་གཉིས་པ་ས་སྟག་གི་ལོ་ལ་སྦྱོར་དྲུག་པ་རིན་ཆེན་བཟང་པོ་སོགས་གསུམ།",
    "སྤྱིར་ལོ་རེ་རེ་ཇོ་ནང་དཔེ་ཚོགས།",
    "ལོ་འདིར་འཛི་རོང་གི་མཆོད་རྟེན་ཆེན་མོ་ལ་རབ་གནས་ཀྱི་དབུ་བླར་ཕེབས་སྐབས་དགེ་ལེགས་ཀྱི་མཚན་མ་མེ་ཏོག་འདབ་བརྒྱད་དབྱིབས་ཅན་གྱི་ཁ་བ་དང་གསེར་ཕྱེ་བབས་ཤིང་།",
    "དགུང་ལོ་ང་བདུན་པ་ཆུ་ལུག་གི་ལོར་སྦྱོར་དྲུག་པ་མཆོད་རྟེན།",
    "ཁྱོད་ལ་རྗེ་བཙུན་སྒྲོལ་མའི་ཐུགས་རྗེས་གཟིགས་རྟགས་རེད་ཅེས་གསུངས་ནས་སྒྲོལ་མའི་ལས་ཚོགས་ལེགས་གནང་མཛད་ལྟར་ཁོང་ལ་རྗེས་སོར་སྒྲོལ་མའི་ཞལ་གཟིགས་ཀྱང་ཡོད་པར་གྲགས་སོ།",
    "མཆོད་རྟེན་ནང་གི་འོད་དཔག་མེད་དང་སློབ་དཔོན་པདྨའི་འདྲ་སྐུ་ལུགས་མ་དག་སྔར་བས་གཟི་མདངས་ཆེར་རྒྱས་ཤིང་མེ་ཏོག་དང་གསེར་ཕྱེའི་ཆར་བསྙོན་མེད་དུ་བབ་པ་སོགས་དགེ་མཚན་ཆེ་བར་གྲགས་ལ།",
    "འདི་ལོར་སློབ་བུ་འགའ་ལ་ཁོང་གིས་ཞལ་གསུང་གནང་བ།",
    "ད་ནི་གཤིན་ཆོག་གི་སྐབས་བེམ་པོ་མིང་བྱང་ཁྱད་མེད་དུ་གནས་འདྲེན་འཕོ་དམིགས་སོགས་ལ་བཟང་ངན་མེད།",
    "ད་ནི་རང་གི་སྣང་བ་ཉིན་མཚན་ཐུན་ཐུན་བར་ཁྱད་མེད་དུ་འོད་གསལ་ཉག་གཅིག་གི་སྣང་བ་ལས་མེད།",
    "སྔར་སྐྱབས་རྗེ་རྡོ་རྗེ་འཆང་གི་ཞལ་སྔ་ནས།",
    "ཁོང་གི་ཡི་དམ་སྒྲོལ་མ་ཡིན།",
    "ཁོང་ཉིད་སྒྲུབ་ཁང་དུ་བྱོན་སྐབས་དགུང་མོ་ཞིག་ཏུ་ཐུགས་བརྟགས་པའི་རྣམ་པས་ཡུད་ཙམ་བཞུགས་རྗེས་སུ་གསུངས་ལས་སྔར་གྱི་རྒྱ་འདྲེ་ཇོ་ནང་དཔེ་ཚོགས།",
    "ངན་པ་ཞིག་ད་ལན་འགྲོ་གིན་ཡོད་པས་དེ་ལ་ལན་ཆགས་སྦྱིན་དགོས་གསུངས་ནས་མྱུར་སྟབས་སུ་དེ་ལུགས་ཀྱི་སྦྱིན་བསྔོ་མཛད།",
    "དགུང་ལོ་རེ་གཅིག་པ་མེ་ཕག་གི་ལོ་འདི་ལ་སྦྱོར་དྲུག་པ་ཐེག་མཆོག་སོགས་དང་།",
    "འདིའི་དཔྱིད་དུ་གྲྭ་ཚང་གི་སྲུང་རིམ་དུ་འཛམ་ཐང་འདུ་ཁང་ཆེན་མོར་ཕེབས།",
    "འདི་ལོར་ཁོང་གི་ཞབས་བརྟན་སཱཙཱ་བྱེ་བ་སྤར་དུ་བཏབ་བོ།"
  ]
}