    "ལམ་བསྐྱེད་རྫོགས་ཟབ་མོར་ལེགས་བསླབན།",
    "སྔར་སྙན་ངག་མེ་ལོངམའི་ལེའུ་གཉིས་པའི་དོན་གཞན་བཀོད་པའི་བར་བཀའ་འཁྲིད་ཞིབ་རྒྱསརྩོམ་རྒྱུགས་དང་བཅསཔ་ལན་གཉིས་སོང་ཞིང་།",
    "བརྩེ་མེད་འཆི་། བདག་གི་གཤིན་རྗེ།",
    "བསྙེན་པ་གྲུབ་མཚམས་ནུབ་གཅིག་རྨི་ལམདུ་བདག་ཉིད་གཟིམཁང་རྣམ་སྲས་ཕྱོགས་ལ་ཡར་ཡོང་གི་ཡོདཔསནམམཁརབལྟས་པས།",
    "སྐྱབས་མགོན་མཆོག་ལ་ཞུས་པས་ཤིན་ཏུ་མཉེས་ཤིང་གསློང་གི་རྨི་ལམ་འདི་རྣམས་གཞན་དཀའ་བའི་ཁྱདམཚར་བཤ་རྟག་འཇུག་ཅེས་ཕེབས།",
    "༣ རང་ལས་བརྒྱུད་དུ་སོན་པ་ཟིལ་གནོན་མེ་རྟ་ཟླ་བ་དང་མེད་གསུངས་པ་ལ་ངེས་ཤེས་དྲངས་ཏེ་འབྲུ་གཙང་སྤུས་ལེགས་དྲིབཟང་གིསས་པོ་བྱས་པ་འོང་དགོས་ལཕུལ་བསདེ་ནུབ་རྨི་ལམ་དུ་བདག་ཉིད་ཞྭ་གྱོན་ནས།",
    "འགའ་ཞིག་གིས་མི་མང་སེངནས་བྱ་འུག་པ་མཐོང་ཚད་བསད་ནས་དེའིཤ་དང་གླ་རྩིདང་།",
    "རྒྱལ་ཀུན་མཁྱེན་མཛོད་རང་གིར་བདགཔའི་ལས།",
    "གུང་ཐང་རིན་པཚོའི་གསུང་འཇིགས་བྱེད་དཔའ་གཅིག་གི་བསྐྱེད་རིམ།",
    "ཨེ་མ་ཆིག་སྐྱ་ཐུབ་པའི་ཡོན་ཏན་འདི་ངོམོས་དང་།",
    "བུདམེད་འཇིགས།",
    "དགེ་འཕེལ་རང་དང་དགོན་ལག་སྟེང་དགའི་བཙུན་ཆུང་བཅུ་བདུནཙོ་ལ་དགཡགྱི་སྡོམ་པ་དང་ཚོ་བ་བརྒྱད་ཉིན་རྫོགས་ལ་བཞུགས་ཁྲིའི་སྟེང་ནས་",
    "འཇིགས་བྱེད་དམར་པོའི་དུག་དབརསྐྱབས་མགོན་པན་ཆེན་དཔལ་ལྡན་ཡེ་ཤེས་ཀྱི་གསུང་གི་སྟེང་ནས་གནང་བ་བཅས་ལེགས་པར་ཞུས།",
    "ཨ་ར་པ་ཙའབུམ་ཕྲག་གཉིས་ལྷག་ཙམ་སོང་བ་འདི་གཏན་ཁེལཡིན་གོང་མ་རྣམས་ཅུང་ཟད་ནོརོ་འདུགཅེས་བརྗེད་ཐོར་གསལ།",
    "གདུ་གི་ཐུགས་བསྐྱེད་ཀུན་གསལ་མཁའ་དབྱིངས་ལས།",
    "ཐལ།",
    "རང་གི་རྒྱུད་ཐོག་ཏུ་ཕན་པ་ནི་ཅི་ལ་ཡོད།",
    "སྒྲིབ་བ་ཁྱིས་བྱང་ཞིང་ཚོགས་གཉིས་གསནསཟམས་ཅད་མཁྱེན་པའི་གོ་འཕང་མྱུར་དུ་ཐོབ་པར་ཤོག་ཅིག་ཅེས་སོགསཀྱི་ཐུགས་སྨོནཉིན་ལྟར་བཀའ་དྲིན་ཆེ་འཇུག།",
    "ཐུགསདམ་མ་གྲོལ་གྱི་བར་དུ་རྣམསྲས་གཟིམ་ཁང་དུ་ཞལ་སློབ་གྲས་ཞལ་གྲངས་བདུན་ཅུ་སྟེ་བཀངོས་ཏེ་ཉིན་ལྟར་ཇ་ཐུག་དྲུག་རེ།",
    "དདལྡན་མང་བནས་སྣང་བརྙན་གསར་བཞེངས་མང་དུ་མཛད་སོང་བའིནངགཞུགབྱིན་རྟེན་དུ་ཅུང་ཟད་བཀྱེ།",
    "ཟླ་བ་ལྔ་པའི་ཚེས་གཅིག་ལ་བདགཉིད་ནསརྡོ་རྗེ་སློབ་དཔོན་གྱི་ཁུར་བཟུང་ཏེ་རབ་ཏུ་གནས་པའི་མེ་ཏོག་གི་ཆར་ཕབས།",
    "པ་བ་མེ་ཏོག་གི་ཆར་ཡིན་འདུག་བྱས་པས།",
    "འབྲོམ་སྟོན་དག་གིས་ར་སྒྲེང་ལྷ་ཁང་བཞེངས།",
    "རྣམ་གླིང་པན་ཆེན་གྱིས་སྡུག་པ་ཉམས་སུ་མྱོང་བའི་ཚིག་གིས།",
    "ཞི་བའི་དབྱིངས་སུ་ཆུ་ལྷའི་ཕུང་པར་གཟིགས།",
    "ཐུགས་དགོངས་རྫོགས་ཆེད་མཆོག་གསུམ་ཉིན་མོའི་མགོན།",
    "ཉམས་ཐོག་ལག་སྐྱོང་ཚོགས་ཀྱིས་རེ་སྐོང་མཛད།",
    "ཟླ་བ་བཅུ་པའི་ཚེས་ཉེར་གཅིག་ལ་མི་གྲངས་བཞི་བཅུ་ཞེ་གསུམ་ལ་ཕོ་མོའི་གྱོན་པ་སོགས་མད་དོད་དུ་དངུལ་དང་།",
    "སྔར་བཞིན་མཛད་པའི་ཐོག་བརྒྱ་མཆོད་སྣ་ལ་བྱེད་གཉིས་སོང་།",
    "ཟླ་བ་དགུ་པའི་ཚེས་ཉེར་བདུན་ཉིན་གྲྭ་གྲངས་བཞི་བཅུ་ཞེ་བདུན་ལ་སྦྱོར་དབུལ་སྲང་བདུན་ཅུ་རེ་བའི་མང་དདདངོས་པོ་རྩ་ལ།",
    "དགའ་ལྡན་ལྔ་མཆོད་བཅས་ལ་རྒྱལ་སྲསཆེན་པོའི་སྤྱན་སྔར་བརྒྱ་མཆོད་སྣ་ལྔ་རེ།",
    "ཕུར་སོང་བསྡོམས་གསེར་ཞོ་བཅུ་གཅིག་དངུལ་སྲང་བརྒྱད་བརྒྱུདང་དགུ་བཅུ་གོ་གཎྜིག།",
    "རྩོད་དུས་གདུལབྱའི་མགཞི་དུ་དུར་སྨྲིག་གིས།",
    "གས་པའི་དོན་དུ་ཁྱོག་འབར་ཤིང་འཕེལ་དབུས།",
    "གང་གི་མཁྱེན་པའི་སྟོབསཀྱི་གངས་ལྗོངས་ཀྱིས།",
    "འབྲོང་བུ་བཅས་སུ་བརྒྱ་མཆོད་སྣ་ལྔརེབཅས་འབུལ་བར་མཛད།",
    "ཟླ་བབས་པའི་ཚེས་འགོ་ལ་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་བཅད་རྒྱ་ཞག་བཅུ་མཛད་ཟླ་བ་བཅུ་པའི་ཚེས་བཅུ་བཞི་ཉིན་དངུལརི་དགའ་ལྡན་རྩེར་ཕོ་མོའི་གྱོན་པ་མང་དོད་དུ་དངུལ་སྲང་བཅོབརྒྱད།",
    "འབྲུ་དང་གི་ཚ་གཏིང་མ་སྦྱོར་འབྲེལབཅས་ཁྱོན་ཇ་འཇམ་བདུན།",
    "ཟླ་བ་དགུ་པའི་ནང་སྐྱབས་མགོན་པན་ཆེན་མཆོག་གི་སྤྲུལ་པའི་སྐུ་བློ་བྲང་རྒྱལ་མཚན་མོཟིན་པའི་ཁྲི་ཕེབས་མཛད་པར་པར་རྗེ་བློམ་མཆོག་ཀྱང་བཀྲས་ལྷུན་དུ་ཆིབ་སྒྱུར་མཛད་དེ།",
    "ཡ་བབས་དུས་ཆེན་སོ་སོར་བརྒྱ་མཆོད་སྨཐརེདྲུགཔཚེས་བཞིའི་རྒྱལ་སྲས་ལྷ་ཁང་དུ་བརྒྱ་མཆོད་སྣ་ལྔ་གཅིག།",
    "དེ་ལྟར་གོང་ལ་གང་དགོས་པའི་ཡོ་བྱད་ཐམས་ཅད་བརྫུངས་པ་མེད་པ་ལེགས་པར་གཏོང་པའི་གནས་དུས་དགོས་པ་ལ་གཟིགས་པ་སྟེ་སློབ་དཔོན་ཟླ་གྲུགས་པས།",
    "རྒྱལ་ཀུན་མཁྱེན་པའི་ཡི་ཤེས་གཅིག་བསྡུས་ཁྱོད།",
    "ཀུན་བཟོད་སྒེག་མོའི་བཞིན་རསཆུ་སྐྱེས་ལ།",
    "དེ་ལྟའི་འཇུངསམིང་གཏོང་བའི་རླབས་འཕྲེང་གི་དུས་ལས་ཡོལ་མེད་གཡོ་བ་ཆུ་གཏོར་ནི།",
    "བློ་གསལ་གཉིས་སྐྱེས་དགའ་བའི་ཅ་ཅོ་སྒྲོག་མགོན་ཁྱོང་ཤུགས་བསྐྱེད་ཀུན་གསལ་མཁའ་དབྱིངས་ལས།",
    "རྣམ་མཁྱེན་སྐུ་བཞིའི་གོ་འཕང་ཐོབ་པའི་འཁོར་གསུམ་ཡོངས་དག་གི་ལྗགས་བསྡོརིརྒྱས་འདེབསབདེན་ཚིག་མན་ཏན་མཛད།",
    "ཡོན་དབུ་སྤྱགསུམ་ལ་དར་ཁ་བསོད་རེ་རབ་བྱུང་མཉི་ཤུ་རྩ་དྲུག་ལ་ཡོན་ཊམ་རེ་བཅས་ལ།",
    "བདག་ཅགགི་དྲིན་ཆེན་བློ་ཐ་། མ་མཆོག་འདི་ཉིད་ནི།",
    "གི་ཞབས་བརྟན།",
    "ཟླ་བ་དྲུག་པའི་ཚེས་ཉེར་གཉིས་ནས་སྤྱི་དང་བྱེ་བྲག་གི་སྡིག་ལྟ་སྐྱེད་བའི་ཕྱིར་དགོངས་བཞེས་ཀྱིས་སྐུ་ཕྱགར་དང་དེ་བཞིན་གཤེགས་པའི་ཡིག་བརྒྱ་རེ་བཅས་ཉིན་ལྟར་བརྒྱདང་གསུམ་རེ་མཛད་པར་ཟླ་བ་བདུན་པའི་ཚེས་ཉི་ཤུ་བཞིའི་ཉིན་སྐུ་ཕྱག་དང་ཡིག་བརྒྱ་གྲངས་སུམ་སྟོང་སུམ་བརྒྱ་ཉེར་ལ་གྲུབ།",
    "རྒྱལ་སྲས་ལྷ་ཁང་བཅས་སུ་མང་ཇ་དང་བརྒྱ་ན་ཚོད་རེ།",
    "གཟིམ་ཕུག་གི་ཉིན་བཞིའི་ཐོག་བརྒྱ་མཆོད་སྣ་ལྔ་གཉིས་འབུལཀ་བར་མཛཔཟླ་བདགུ་པའི་ཚེས་བཅུ་གཅིག་ནས་ཟློབཅུ་པའི་ཚེས་བཅུ་གཉིས་བར་བཅད་རྒྱ་མཛད་དེ་དཔལ་རྡོ་རྗེ་འཇིགསབྱེད།",
    "དེ་བྱིངས་ཚང་མར་བ་བྱེད་རེ་བཅས་སྩལ་བར་བསྡོམསདངུལ་ཊམ་སུམ་བརྒྱ་དང་དགུ་ཅུ་གབརྒྱད་སྐརལ་སོང་འདུག།",
    "ཞིང་སྐྱོང་གི་རྗེས་གནང་།",
    "དེ་རྗེས་རྗེ་ཉིདདང་རི་ཁྲོད་དགེ་སློང་ཚང་མར་མང་འགྱེད་ཟབ་རྒྱས་དང་ཚོགས་འཁོར་ན་བཅས་བཙན་པོ་ནོ་མོན་ཧན་ཧུ་ཐོག་ཐུ་ཆེན་པནས་གནང་།",
    "རྒྱལ་སྲས་ལྷ་ཁང་འབྲོདོཕུ་གསུམ་ལ་བརྒྱ་མཆོད་རེ་བཅས་འབུལ་བར་མཛད།",
    "ས་ག་ཟླ་བརཔད་མོས་པས་སྤྱད་གནས་དཀར་པོ་ཕྱོགས་བརྒྱད་བཏངས་པར་ཡོན་དང་གོས་ཆ་བསྡོམས་དངུལ་སྲང་ཉེར་གཅིགདང་ཞེལྔ་སྩལ་བར་སྨྱུང་གནས་གྲངསབརྒྱ་དང་དགུ་ཅུ་གོ་ལྔ་བྱུང་འདུག།",
    "འབྱེད་བུ་རྣམས་ལ་བརྒྱ་མཆོད་རེ་འབུལ་བར་མཛད།",
    "ཐུབབསདུསཆེནཉིན་དགའ་ལྷ་དང་རྒྱལ་སྲས་ལྷ་ཁང་གཉིས་ལ་བརྒྱ་མཆོད་སྣ་ལྔ་རེ།",
    "ཁྱདང་དགིས་ཆ་དོད་དངུལ་སྲང་ཉི་ཤུ་རྩ་གཅིག་ལ་ང་སྨྱུང་གནས་གྲངས་བརྒྱ་དང་དགུ་ཅུ་གོ་བཞི་བྱུང་འདུག།",
    "པདུ་ཚེས་བཅས་སུ་བརྒྱ་མཆོད་རེ་དང་མང་ཇ་རེ་བཅས་གནང་།",
    "དེ་ཐོག་བརྒྱ་མཆོད་བྱེད་གཉིས་སོང་།",
    "ལྷ་ལྡན་ནས་མི་རྗེ་སྐུ་ཞབས་སྐུ་བཅར་སྤྱི་ཁྱབ་ར་ཧན་མཁན་རིན་པོཆེ་ནསལལྟར་སྐུ་ཚེ་ཚེ་སྒྲུབ་ཞུ་གནང་གི་ལོ་ཚིས་མཚམས་ཚིགས་སྔ་འབུལ་གནང་མཛད་དགོསཀྱི་བཀའ་ལན་དང་ཆབས་ཅིག།",
    "ཚུལ་བཟུང་ཀུན་གཟིགས་འཇམདབྱངས་མཚོན་ཅན་ཏེ།",
    "ཕྱུགའགྱེད་ཊམ་གཉིས་རེ།",
    "གོང་གསལ་གཉིས་ལ་མི་གསུམ་རེར་དུ་སྦག་བཅས་སྩལ།",
    "ཕྱག་འགྱེདཊམ་རེབདྲངོ་མཆུ་དལལས་བྱས་པའི་རྣམ་རྒྱལ་དང་ལས་བུམ་གཉིས་ལྡན་དམར་ལས་གྲུབ་པ་བུམ་གོས་ཁ་རྒྱན་དང་བཅས་པ་སྦྱོར་འཇགས་སུ་སྣུལཾ།",
    "དེ་ནས་ཟླ་ཕྱེད་སྐོར་འཇིགས་བྱེད་དཔའ་གཅིག་གི་བཅད་རྒྱ་མཛད།",
    "གནས་བརྟན་སྒྲུབ་མཆོད་ཐོག་བརྒྱ་མཆོད་བྱེད་གཉིས་སོང་།",
    "ཚ་འཕྲུལ་ཐོག་རྒྱལ་སྲས་ལ་ཁད་གྲུ་འཛིན་འབྲོང་བུ་གསུམ་ལ་བརྒྱ་མཆོད་རེ་བཅས་འབུལ་བར་མཛད།",
    "ཟླ་བ་དེའི་ཚེས་གནམ་གང་ཉི་འཛིན་ཐོག་བརྒྱ་མཆོད་གཅིག་སོང་།",
    "མི་རེར་འགྱེད་ཊམ་ཕྱེད་རེ།",
    "ས་བོན་སོགས་ཡོད་པའི་སྙན་དར་སོག་དར་སྤུས་ལེགས་རེ་འབུལ་བར་མཛད།",
    "ཚེས་བཅུའི་ཉིན་རབ་བྱུང་མ་ཉེར་གསུམ་ལ་བཟང་ཇ་ཉག་ཕྱེད་རེ་ལ།",
    "རྣམ་གཞག་དང་བཅསཔའི་ཐོགི་འགྱེད་ཊམ་རེ་གནང་བར་ཊམབརྒྱ་དང་གསུམ་སོད་ཞི་གནས་སྤྱི་ཁང་དུ་རི་ཁྲོད་པ་གྲྭཉིས་བརྒྱལྔ་བཅུ།",
    "བཙུན་མ་སུམ་བརྒྱ་ཉི་ཤུབཅས་ལ་མང་ཇ་གཅིག་གི་ཐོག་གྲྭ་རེར་འགྱེད་ཊམེད་དེ།",
    "ཟླ་བ་བཅུའི་ཅིག་པའི་མར་ངོའི་ཚེས་བཅུའི་མཚན་ལམ་དུ་བུད་མེད་རྨོལ་ལྟ་བུ་ཞིག་སྐུ་གམ་དུ་བསུབས་སྒྱུར་བ་བཀའ་དྲི་མང་པོ་གནང་ཞིང་ལྷགདལ་པ་ཇི་ཡིན་ཕེབས་པར་བདུན་ཅུ་དོན་གཉིས་ཡིན་ཚུལ་ཞུས་བྱུང་ཞེས་བས་ཟླ་བ་བཅུ་གཅིག་པའི་ཚེས་བཅུ་གཅིགཉིས་པོད་རྩོམ་ཞབས་སོར་འཁོད།",
    "ཚེས་ཉེར་བཞི་ཉིན་ཕོ་མོའི་བ་ཞི་པ་སོགས་དངུལ་སྲང་བདུན།",
    "གྲུ་འཛིན་འབྲོང་ཕུ་བཅས་ལ་བརྩམཆོད་སྣ་ལྔ་རེ་བཅས་འབུལ་བར་མཛད།",
    "ཡིན་དར་ཁབསོད་རེ་དངུལ་ཊམ་བརྒྱད་ཅུ་གྱ་བཞིསད་འདུག།",
    "འབྱེད་བམ་ཕྱེད་རེ་བཅས་གནང་།",
    "འབྲོང་ཕུ་གསུམ་ལབ་མཆོད་སྣ་ལྔ་རེ་བཅས་འབུལ་བར་མཛད།",
    "དེ་རྣམས་ལ་མང་ཇ་རེ་བཅས་གནང་།",
    "དམརྗེ་པད་ཆུས་རྣམས་ནས་མཎྜལ་རྟེན་གསུམ་རེ་ཕུལ།",
    "རྒྱལ་བསྟན་འདབ་བརྒྱ་འབྱེད་མཁསཁྱོད་དུ་ངེས།",
    "དགེ་འཕེལ་སོགས་ལ་དངུལ་སྲང་བཅུ་དྲུག་རི་བའི་ཁོ་མོའི་གྱོན་པ་མང་དོང་དུ་སྦལ།",
    "མངཇ་གཅིག་འགྱེད་ཊམ་ཕྱེད་རེ་བཅས་ལ་ཟླ་བ་བཅུ་པའི་ཚེས་ཉེར་བརྒྱད་ཉིན་ཕོ་མོའི་གྱོན་པ་སོགས་མང་དོད་དུ་རྩ་བ་ལྟར་དང་།",
    "དེ་ཐོག་རྣམ་གཞག་རྒྱས་པ་དང་ས་འགྱེད་ཊམ་ཕྱེད་རེ་གནང་བར་ཉམ་བརྒྱད་ཅུ་གྱ་གསུམདང་ཕྱེད་བརྒྱད་སོང་།",
    "ཇ་ཐུག་དྲུག་རབ་བྱུང་མ་ཉེར་ལྔ་ལ་འགྱེདཊམརེ་ལ།་",
    "སྒྲོལ་ལྷ་བཅས་ལ་འགྱེད་ནོརེདབྱེདས་ལ་ཊམ་ཕྱེདའི་བཅས་སྩལ་བར་བསྡོམས་བམ་སུམ་བརྒྱ་དང་སུམ་ཅུ་སོ་བདུན་སོད་འདུགཟླ་བ་བདུན་པའི་མཇུག་གནས་བརྟན་སྒྲུབ་མཆོད་སྔར་བཞིན་མཛད།",
