    "སྔགས་ལ་རྫས་དེ་བྱུག་པས་ཕན་པར་འགྱུར་རོ།",
    "ཐང་ཕྲོམ་ཁཎྜའི་ཁུ་བར་འཛིན་པ་དང་གླ་རྩི་བཏབ་པ་ཉུང་ཙམ་ལ་སྔགས་ནས་ཁོང་བཏང་རྨ་ལ་བསྐུས་པས་མྱུར་དུ་ལྟོས་པར་འགྱུར་རོ།",
    "ཞེས་བཟླས་ཟུག་རྔུ་གར་ཡོད་སྟེང་དུ་བཏབ་ཅིང་སྔགས་ཆུ་ཁོང་དུ་བཏང་བས་སྡུག་བསྔལ་ཟུག་རྔུ་ཐམས་ཅད་འཇོམས་པར་འགྱུར་རོ།",
    "ཁྱད་པར་དུས་ཀྱི་རིམས་ཡམས་དང་།",
    "གཉན་རིམས་ཏྲེ་ཧོར་པརྦ་ཏ་ཞེས་པ།",
    "ལག་ཏུ་ལོངས་དང་ཡིད་ཆེས་རྙེད་པར་འགྱུར།",
    "རྩ་བ་འབྲས་བུ་བྱས་ཀྱང་རུང་།",
    "བསྐོལ་ཐང་བྱས་ནས་དྲོ་འཇམ་དུས་བཏུང་ན།",
    "ཁྱད་པར་རུས་ཚད་སེལ་ལ་མཆོག་ཏུ་བསྔགས།",
    "ཞིབ་པར་བཏགས་པའི་ཕྱེ་མ་ལོགས་སུ་ཚགས་བྱས་ཏེ།",
    "ས་ལ་དོང་བྲུས་ནང་དུ་སྣོད་གཙང་ཁ་ཡར་བཟེད།",
    "ལེགས་པར་སྐམ་ནས་གས་སྲུབས་ཡང་ཡང་བསྡམས་བྱས་ནས།",
    "བྱུག་པས་མི་སེལ་མི་སྲིད་ཁོ་བོས་ཉམས་མྱོང་ལགས།",
    "སྣོད་གཙང་ནང་བླུགས་དམ་ཚགས་བྱ།",
    "གཡག་གསར་བཀོལ་སྤྱོད་མ་བྱས་བྱ་མ་བཅད།",
    "ཁྱད་པར་གཉེན་པོ་ཁྱུང་སྔགས་ཡིན།",
    "བྲིས་པའི་ས་ལས་མ་ལངས་པར།",
    "གཉན་རིམས་ཀུན་སྲུང་ཁྱད་པར་འཕགས།",
    "སྔགས་འཁོར་འོད་འཕྲོས་དོན་གཉིས་བྱས།",
    "སྣང་བ་སྐུ་དང་སྒྲ་གྲགས་གསུངས།",
    "ལྔ་བདོའི་འགྲོ་རྣམས་རང་བྱས་ཀྱི།",
    "ལྷུན་གྱིས་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "བྲག་ཞུན་བསྐྱེད་པས་ངེས་པར་ཕན།",
    "འདི་དང་ལྟག་སྤྲོད་བྱས་ནས་གཏོང་།",
    "ཨེ་མ་གུ་རུའི་བཀའ་དྲིན་ལགས།",
    "བྲག་ཞུན་རྣམས་བསྐྱེད་བསྣན་བྱས་པས་སེལ།",
    "གཏར་གནས་རྩ་པྲ་ཉུང་ངུར་དྲིལ་བ་བཞུགས།",
    "མྱང་འདོད་རྒྱུ་དྲུག་ཚོགས་ལ་སྦྱིན་པར་བྱ།",
    "བསྙལ་སོགས་གཏར་གྱི་ལེའུར་ཤེས་པར་བྱ།",
    "མགོ་ལ་ཉེར་གཅིག་ལག་པར་སོ་བཞི་དང་།",
    "འདོམས་རྩ་གཉིས་བསྡོམས་ལག་པར་སོ་དྲུག་སྟེ།",
    "ནང་བར་གཏར་བས་ཁྲག་ཕེབས་འགྱུར་བ་ཡིན།",
    "བཅོ་ལྔ་གནམ་གང་ལུས་སྤྱིར་ཁྱབ་པར་གནས།",
    "གཏར་བསྲེག་གང་ཡང་མི་བྱ་ལྷག་པར་དུ།",
    "འདི་གསུམ་ས་ལེགས་པར་ཆ་མཉམ་ལ།",
    "ཞིབ་པར་བཏགས་ལ་གང་འདེབས་ཕྱེ་མ་བཏབ་ལ་དར་དམར་བཀབ།",
    "ཤིང་ལེབ་སོར་གང་བཞི་ཞེས་པའང་ཡོད་གཞག་པར་བྱ།",
    "ལྷག་པར་སྐྲངས་དང་ལྦ་བ་ལ།",
    "གཡོན་སྡིགས་མཛུབ་མཛད་པར་བསྒོམས་ལ།",
    "རྒྱ་བོད་དྲང་སྲོང་བརྒྱུད་པར་བཅས་རྣམས་ལ།",
    "ཚེ་ཡི་རིག་འཛིན་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "སྐུ་བཞི་ཡེ་ཤེས་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "ནུས་པ་ཆུ་བསིལ་གཞན་ལས་ཁྱད་པར་འཕགས།",
    "དེ་ནས་རྦ་ཀློང་འཁྲུགས་པར་ཞུགས།",
    "ལག་ལེན་ཁྱད་པར་འཕགས་པ་འདི།",
    "ལྷག་པར་ཁོང་འབྲས་སྐྲན་ཡོད་ན།",
    "མཁྱེན་བརྩེའི་ཡོན་ཏན་འོད་ཟེར་འབར་བའི་གཟིས།",
    "མགོ་ལུས་ཁྱབ་པར་སེར་ན་ཚ་འགྲམས་ཡིན།",
    "རང་རྒྱུད་ཅན་ལ་རིགས་དབྱེ་དྲུག་གསུངས་ཀྱང་།",
    "གསོ་དཀའ་ཕལ་ཆེར་འཆི་བ་མང་བར་གསུངས།",
    "རིམས་ཚད་རྩ་ནི་ཕྲ་ལ་མགྱོགས་པར་འཕར།",
    "ཐ་མར་དཔྱི་སྐེད་རུས་རྐང་ཁྱད་པར་ན།",
    "༢ཁྱད་པར་མགོ་བོ་ཁབ་ཀྱིས་གཙགས་པ་འདྲ།",
    "གྲེ་བར་བབས་ན་ཡ་མ་གག་པར་འཛིན་གག་པ་མིད་འཆར་ཟེར་བའང་སྣང་།",
    "རྒྱུངས་པར་བབས་ན་འཛུམ་བུ་ལྟག་དགྱེ་ཟེར།",
    "ཁྱད་པར་རྟགས་ལ་སྙིགས་མ་མ་ཞུ་ན།",
    "སྨིན་དང་མ་སྨིན་གཉིས་སུ་ཤེས་པར་བྱ།",
    "ཁྱད་པར་གདོང་བོལ་བྲང་གསུས་ཆུ་སོ་སྐྲངས།",
    "ལེགས་པར་བརྟགས་ན་འོག་བཞི་པ་འབུར་བ་འདྲ།",
    "ལེགས་པར་བརྟགས་ན་དྲོད་རྟགས་ཐམས་ཅད་ཚང་།",
    "ལེགས་པར་མ་བརྟགས་མ་ཞུ་བ་དང་ནོར།",
    "བར་ཆུ་པགས་འོག་ཤ་སྟེང་ཁྱབ་པར་གནས།",
    "ཁ་ལྐུགས་ཁ་སླེ་ངུ་དང་རྒོད་པར་བྱེད།",
    "ཁྱད་པར་ཁྱབ་འཇུག་དུག་ལྔ་འབྱུང་ལྔའི་བདག།",
    "དེ་དག་མེ་གཟའི་རྟགས་སུ་ཤེས་པར་བྱ།"
  ]
}