    "དེ་ལྟར་གནས་སྐབས་དེར་རྡོ་རྗེ་ཕྲ་མོའི་ཏིང་ངེ་འཛིན་གྱིས་སེམས་ལས་སུ་རུང་བར་བྱེད་པ་ནི་ཉེ་བའི་བསྙེན་པའི་སྒྲུབ་པ་ཆེན་པོའོ།",
    "དེ་ནས་རེག་པའམ་རེག་པའི་རྟགས་སམ་མཐོང་བའམ་མཐོང་བའི་རྟགས་མངོན་སུམ་དུ་གྱུར་པ་དང་སྤྲོ་ཞིང་བསྡུ་བར་བྱའོ།",
    "ཡུངས་ཀར་དེའི་ནང་དུ་རྒྱུ་བ་དང་མི་རྒྱུ་བའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་སོ་སོའི་བྱེ་བྲག་དང་བཅས་པ་མ་འདྲེས་པར་བསམ་མོ།",
    "ཞེས་པ་ནི་དེ་ལྟར་སེམས་ལས་སུ་རུང་བའི་རྣལ་འབྱོར་པས་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་གསུང་ཐུགས་ལ་སོགས་པའི་འཇིག་རྟེན་ལས་འདས་པའི་ཡོན་ཏན་དང་འཇིག་རྟེན་གྱི་ཡོན་ཏན་དཔག་ཏུ་མེད་པ་ཐོབ་པར་འདོད་ན་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "སྣ་ཡི་རྩེ་མོར་ནན་ཏན་དུ།",
    "ཐུགས་ཀ་ནས་སྣའི་རྩེ་མོར་རོ།",
    "རྩེ་མོ་ལྔ་པ་ཁྱད་པར་དུ།",
    "སྣ་ཡི་རྩེ་མོར་རྣམ་པར་བསམ།",
    "ཞེས་པ་ནི་རྡོ་རྗེའི་རིགས་ཀྱི་ཕྲ་མོའི་སྦྱོར་བ་བསྟན་ཏེ།",
    "བདག་དང་གཟུགས་ཀྱི་རྡོ་རྗེའི་རིགས་ཀྱི་ལྷ་དང་ལྷ་མོའི་ཚུལ་དུ་གོང་མ་བཞིན་དུ་གནས་ལ།",
    "ཡེ་ཤེས་ལྔའི་རང་བཞིན་འོད་འཕྲོ་བ་གོང་མ་བཞིན་དུ་སྣའི་རྩེ་མོར་བསམ་ཞིང་སྤྲོ་བསྡུ་ལ་སོགས་པ་བྱ་བའི་དོན་ཏོ།",
    "དེའི་རིགས་ཀྱི་ལྷ་དང་ལྷ་མོའི་སྐུ་ཕྲ་མོའི་སྤྲོ་བསྡུ་བྱས་པ་དེ་བཞིན་དུ།",
    "ལྷ་མོའི་སྐུ་ཕྲ་མོ་སྤྲིན་བཞིན་དུ་སྤྲོ་བར་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་ཁྲོ་བོ་དང་ཁྲོ་མོ་རྣམས་ཀྱང་ཤེས་པར་བྱའོ།",
    "ཅེས་པ་ནི་དེ་ལྟར་ཕྲ་མོའི་སྦྱོར་བ་བསྒོམས་པའི་ཡོན་ཏན་ཏེ།",
    "རབ་ཏུ་གནས་པ་ནི་བདག་གི་ལུས་ངག་ཡིད་གསུམ་དེའི་རང་བཞིན་དུ་གྱུར་པའི་དོན་ཏོ།",
    "དེ་གསུམ་གྱི་གོང་དུ་བསྐྱེད་པའི་ཕྲ་མོ་རྣམས་ལ་བྱིན་གྱིས་བརླབ་ཅེས་པའི་དོན་ཏོ།",
    "ཨོཾ་དད་ཨཱ་དང་ཧཱུཾ་གསུམ་མོ།",
    "ཞེས་པ་ནི་ཕྱག་རྒྱ་གང་སྒོམ་ཡང་གོང་གི་ཡི་གེ་གསུམ་ལས་བསྐྱེད་ལ་དེ་ཡང་ཡི་གེ་གསུམ་གྱི་བྱིན་གྱིས་བརླབས་པས་ལྷ་ཐམས་ཅད་སྐུ་གསུང་ཐུགས་གསུམ་དང་ལྡན་པས་རྡོ་རྗེ་གསུམ་ཞེས་བྱའོ།",
    "དེ་ལྟར་སྤྲོས་པའི་ཡོན་ཏན་ནི་མི་བསྐྱོད་པ་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པ་གསུམ་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "སོ་སོའམ་གསུམ་གྱི་བྱེ་བྲག་གིས།",
    "ཞེས་པ་ནི་དེ་ལྟར་ཕྱག་རྒྱ་ལ་སོགས་པ་སྤྲོ་བ་ལ་མ་མོས་པའམ་མ་ལྕོགས་པ་ཡོད་པ་ན་བདག་གི་ལུས་ངག་ཡིད་གསུམ་དང་།",
    "རང་གི་རྡོ་རྗེ་དཀྱིལ་འཁོར་ལས།",
    "དེ་ཉིད་ཀྱི་དཀྱིལ་འཁོར་ཕྲ་མོའི་ཚུལ་དུ་སྤྲོ་ཞིང་བསྡུ་བ་ཡང་བཟླས་པ་ཡིན་ནོ།",
    "རང་གི་རྡོ་རྗེ་དཀྱིལ་འཁོར་དུ།",
    "ཞེས་པ་ནི་ཁྲོ་བོ་གང་སྒོམ་ཡང་རུང་བ་བསྐུལ་ཞིང་ས་བོན་ལས་ཕྱག་རྒྱར་བསྐྱེད་ཅིང་ཁྲོ་བོ་དང་གཉིས་སུ་མེད་པར་གནས་ལ་གོང་དུ་བསྟན་པའི་ཚུལ་དུ་ཁྲོ་བོ་དང་ཁྲོ་མོའི་སྐུ་ཕྲ་མོ་རང་གི་སྔགས་ཧཱུཾ་ཕཊ་ལ་སོགས་པ་སྒྲོགས་ཤིང་སྤྲོས་པའི་ཁྲོ་བའི་བཟླས་པ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངག་གི་ཕྱག་རྒྱ་རྡོ་རྗེ་ནི།",
    "རྡོ་རྗེ་སེམས་དཔའ་གཙོར་བསྟེན་ཏེ་གང་ལ་མོས་པའི་ལྷ་བསྒྲུབ་པར་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "ཡང་ན་རང་གི་དམ་ཚིག་ཁྲོ།",
    "དེ་ཡང་རང་མོས་པའི་ཁྲོ་བོ་འམ་གང་སྒྲུབ་པའི་ལྷའི་རིགས་ཀྱི་ཁྲོ་བོ་གང་ཡང་རུང་བ་གཉིས་སུ་མེད་པའི་ཚུལ་གྱིས་ཧཱུཾ་ལས་བསྐྱེད་ལ།",
    "ཕྱི་མ་བཞི་ལ་རང་གི་ཕྱག་མཚན་འཛིན་པ།",
    "ཁྲོ་བོའི་ཚིག་གིས་བསྐུལ་བར་བྱ།",
    "ཁྲོ་བོ་དེ་རྡོ་རྗེ་སེམས་དཔའི་སྤྱན་སྔར་ཕྱིན་ནས་ལྕགས་ཀྱུས་བཟུང་ནས་རྡོ་རྗེས་བརྡེག་ཅིང་འོག་གི་ཚིག་རྣམས་ཀྱིས་བསྐུལ་བར་བྱ་བའི་དོན་ཏོ།",
    "ཁྱོད་ནི་བསྐུལ་བར་གནས་པ་སྟེ།",
    "ཞེས་པ་ནི་ཁྲོ་བོས་རྣལ་འབྱོར་པའི་མིང་ཕྱུང་ནས་འདིས་ཁྱོད་ཚུལ་བཞིན་དུ་སྒྲུབ་པར་གནས་ཞེས་པའི་དོན་ཏོ།",
    "མཆོག་སྦྱིན་མགོན་པོས་གཟིགས་མཛད་དེ།",
    "ཅེས་བྱ་བ་ནི་ཁྲོ་བོ་དེ་ལྟར་ཚིག་གིས་བསྐུལ་མ་ཐག་ཏུ་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་འཇིགས་ཤིང་སྐྲག་པའི་ཚུལ་དུ་སྒྲུབ་པོའི་མདུན་དུ་བྱོན་པ་འམ་དགོངས་པར་མཛད་ཅེས་པའོ།",
    "སྤྱན་ལ་སོགས་པའི་ལྷ་མོ་ཡིས།",
    "འཇིག་རྟེན་ལས་འདས་པའི་བདེ་བ་ཉན་ཐོས་ལ་སོགས་པ་ཉོན་མོངས་པ་སྤངས་ཤིང་ལུས་ངག་ཡིད་གསུམ་འགོག་པར་གནས་པའི་བདེ་བ་ཉམས་སུ་མྱོང་བའོ།",
    "ཕྲ་མོ་ཡི་ནི་དབྱངས་ལ་སོགས།",
    "རྡོ་རྗེ་སེམས་ཁྱོད་ས་བདག་སྟེ།",
    "ཕྲ་མོའི་དབྱངས་ནི་ཀ་ཀཱ་ལི་ལ་སོགས་པའོ།",
    "རྡོ་རྗེ་སེམས་ཁྱོད་ས་བདག་སྟེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཁྱོད་ས་བདག་རྒྱལ་པོ་དང་འདྲ་སྟེ།",
    "ཞེས་པ་ནི་དེ་ལྟ་བུའི་དོན་གྱིས་འདོད་པའི་དགའ་བ་ཐབས་དང་ཤེས་རབ་ཀྱི་རོལ་པའི་སྒོ་ནས་བདག་གི་དོན་ཆེན་པོར་འགྱུར་བ་དང་།",
    "དེ་རྣམས་ཀྱི་དོན་བསམ་གྱིས་མི་ཁྱབ་པ་ཐབས་ཀྱིས་བསྟན་ཞིང་དགའ་བར་བྱེད་པ་དང་དེ་ཉིད་རྟོགས་པར་མཛད་པ་ཁྱོད་བདག་ལ་སྤྱད་དུ་གསོལ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "ཁྱོད་ཀྱིས་འདོད་པ་བདག་ལ་སྤྱད་དུ་གསོལ།",
    "ཞེས་པ་ནི་དེ་ལྟ་བུའི་ཡོན་དང་ལྡན་པ་ཁྱོད་བདག་ལ་ཐབས་དང་ཤེས་རབ་ཀྱི་ཚུལ་དུ་རོལ་ཅིག་པའི་དོན་ཏོ།",
    "རྡོ་རྗེ་གསུང་ཁྱོད་ཐམས་ཅད་ཀུན་ལ་ནི།",
    "ཞེས་པ་ནི་ལྷ་མོ་པཎྜར་བ་སིས་བཅོམ་ལྡན་འདས་སྣང་བ་མཐའ་ཡས་ལ་བསྟོད་ཅིང་བསྐུལ་བའོ།",
    "དེ་ལ་ཀུན་དུ་བཟང་པོའི་སྤྱོད་པ་ནི་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་དང་དུ་ལེན་ཅིང་སྤྱོད་ཀྱང་དེའི་ཉེས་པས་མི་གོས་པའོ།",
    "རྡོ་རྗེ་དོན་ཁྱོད་དམ་ཚིག་མཆོག་ལགས་ཏེ།",
    "ཞེས་པ་ལ་སོགས་པ་ནི་ལྷ་མོ་སྒྲོལ་མས་བཅོམ་ལྡན་འདས་དོན་ཡོད་གྲུབ་པ་ལ་བསྟོད་ཅིང་བསྐུལ་བར་བསྟན་ཏོ།",
    "དེ་ལྟར་ལྷ་མོས་བསྐུལ་ནས་ནི།",
    "ཁྲོ་བོ་དང་ཁྲོ་མོ་རྣམས་ཡུམ་བཞི་ལ་ཐིམ་པའི་ཡུམ་བཞིས་དབུས་ཀྱི་གཙོ་བོ་ལ་སོ་སོའི་རིགས་ཀྱི་བདག་པོའི་སྒོ་ནས་བསྟོད་ཅིང་བསྐུལ་བས་དེ་བཞིན་གཤེགས་པ་ལ་བསྟོད་པ་བྱེད་ཅེས་པའོ།",
    "དགའ་ཆེན་པོ་ནི་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་ཉན་ཐོས་ལྟ་བུར་རིམ་གྱིས་སྤོང་བ་མ་ཡིན་ཏེ་ཡེ་ནས་མི་མངའ་བའི་དོན་ཏོ།",
    "ལྷ་མོ་བཞི་དང་གཉིས་སུ་མེད་པའི་ཐབས་དང་ཤེས་རབ་ཀྱི་རོལ་པ་རྟག་ཏུ་མཛད་ཅིང་བདེ་བ་ཆེན་པོ་ཉམས་སུ་མྱོང་བའི་རང་བཞིན་ལ་གནས་པའི་ཕྱིར་རོ།",
    "ཞེས་པ་ལ་སོགས་པས་ནི་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྒོ་ནས་ལྷ་མོ་པཎྜ་ར་བ་སིས་པདྨ་རིགས་ལ་བསྟོད་པའོ།",
    "ཞེས་པ་ལ་སོགས་པས་ནི་ལྷ་མོ་ཏ་རས་བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་ཀྱི་སྒོ་ནས་བསྟོད་པའོ།",
    "དེ་ཡང་འཁྲུལ་པ་དང་མུ་ཅོར་མེད་པ་ཡིན་ཞིང་མོས་པ་དང་མཐུན་པའི་སྒོ་ནས་དོན་མཛད་པས་ཡང་དག་གོ།",
    "ཞེས་པ་ནི་དེ་ལྟར་ལྷ་མོ་རྣམས་ཀྱིས་རིགས་ལྔའི་སྒོ་ནས་བཅོམ་ལྡན་འདས་ཞེ་སྡང་རྡོ་རྗེ་ལ་བསྟོད་ཅིང་བསྐུལ་བའི་ཚིགས་བཅད་རྣམས་ཀྱི་ཕན་ཡོན་བསྟན་ཏེ།",
    "ལྷ་མོས་དེ་བཞིན་གཤེགས་བསྟོད་པ།",
    "རྡོ་རྗེ་བློ་ཡིས་གཟིགས་ནས་ནི།",
    "ཅེས་བྱ་བ་ནི་དེ་ལྟར་ལྷ་མོ་རྣམས་ཀྱིས་བསྟོད་ཅིང་བསྐུལ་བས་ཞེ་སྡང་རྡོ་རྗེས་དགོངས་པའི་ཚུལ་དུ་འཛུམ་པ་མཛད་ནས་ཉིད་ཀྱི་སྐུ་གསུང་ཐུགས་དང་དེ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་གཉིས་སུ་མེད་པར་མཛད་དོ།",
    "དེ་ནས་ཡང་འོད་ཟེར་འཕྲོས་པས་བདག་ཕྱག་རྒྱར་གནས་པའི་སྐུ་ལ་ཕོག་པས་འོད་དུ་གྱུར་ནས་ཐུགས་ཀ་ན་གནས་པའི་ཡེ་ཤེས་སེམས་དཔའ་ལ་ཐིམ་མོ།",
    "དེ་ནས་ཡང་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཡེ་ཤེས་སེམས་དཔའ་ལ་ཕོག་པས་དེ་ཡང་འོད་ཀྱི་ཚུལ་དུ་ཧཱུཾ་ལ་ཐིམ་མོ།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་བཅུད་རྣམས་བཀུག་ནས་ཨོཾ་དེ་ཉིད་ལ་ཐིམ་པར་བསམ་མོ།",
    "དེ་ནས་ཡང་ཨོཾ་དེ་བདུད་རྩིའི་རང་བཞིན་དུ་གནས་པའི་བཅུད་རྣམས་འོད་ཀྱི་ཚུལ་དུ་ཟླ་བའི་སྟེང་དུ་འཐིགས་པར་བསམ་མོ།",
    "ཞེས་པ་ལ་སོགས་པ་ནི་རྣལ་འབྱོར་པ་བཀྲེས་སྐོམ་ལ་སོགས་པ་བྱུང་ཞིང་ཡོ་བྱད་ལ་སོགས་པ་མེད་ན་ཏིང་ངེ་འཛིན་སྤོང་ཞིང་ཚོལ་དུ་མི་འགྲོ་སྟེ།",
    "ཁའི་ཡར་རྐན་ལ་ཧེ་ལས་འདོད་འཇོའི་བ་ཁ་དོག་དཀར་མོ་གཅིག་བསམ།",
    "དེ་ཡང་རྒྱུད་ཀྱི་རྒྱལ་པོ་གསང་བ་འདུས་པ་བདག་གི་སློབ་དཔོན་གྱིས་བསྟན་པ་དང་།",
    "རང་གི་ཤེས་རབ་ཀྱིས་མ་ནོར་བར་ཤེས་པའི་དོན་ཏོ།",
    "ཧཱུཾ་གི་རྡོ་རྗེ་ལས་བྱུང་བ།",
    "ཁ་ཆེའི་རིགས་ཀྱི་པཎྜི་ཏ་ཆེན་པོ་བུདྡྷ་ཤྲཱི་ཛྙཱ་ན་དང་།",
    "ཐུན་མོང་དང་མཆོག་གི་དངོས་གྲུབ་ཀྱི་ཆོ་ག་དང་།",
    "ད་ནི་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་གླེང་གཞི་དག་བསྟན་པའི་ཕྱིར་འདི་སྐད་ཅེས་པ་ལ་སོགས་པ་སྨོས་ཏེ་དེ་ལ་འདི་སྐད་ཅེས་པ་ནི་སྒྲའི་རྣམ་པ་མཐའ་དག་བསྡུས་པ་སྟེ།",
    "དེ་ཁོ་ན་ཐུན་མོང་མ་ཡིན་པའི་གླེང་གཞིར་ཕྱི་མ་ལས་གསུངས་པ།",
    "བདག་གིས་ཐོས་པ་ཞེས་པ་ལ་སོགས་པས་ནི་ཐུན་མོང་གི་གླེང་གཞིའི་ངོ་བོ་གསུངས་ཏེ།",
    "དེ་ལ་བདག་གིས་ཞེས་པ་ནི་གཞན་ལས་མ་བརྒྱུད་པ་སྟེ་དེས་ནི་དམ་ཚིག་མ་འཆོལ་བར་བསྟན་ཏོ།",
    "དེའི་བཙུན་མོ་ནི་རིག་མའོ།",
    "འདིར་བཙུན་མོ་ལས་གྱུར་པའི་བྷ་ག་ལ་དེ་སྐད་དེ་འབྲུ་ལས་གྱུར་པའི་ཆང་ལ་འབྲུའི་ཆང་བཞིན་ནོ།",
    "གཞན་དག་གིས་ནི་གསང་བའི་བྷ་ག་ཡིན་ནོ་ཞེས་སྨྲས་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན་ཞེས་པ་དང་འགལ་ལོ།",
    "ཇི་ལྟར་ཞེ་ན་ལེའུ་བཅུ་བདུན་པ་ལས་བཙུན་མོ་ལས་འདས་ནས་ཞེས་གསུངས་པས་ན།",
    "གཞན་ཡང་དམ་ཚིག་གི་སྒྲ་ནི་དུས་ན་ཞེས་པའི་སྒྲར་བརྗོད་དོ།",
    "དེ་ཁོ་ན་རྡུལ་ཕྲ་མོ་ཞེས་པས་བསྟན་ཏོ།",
    "དེ་ཕྱི་ནང་གི་དཀྱིལ་འཁོར་གྱི་གཞི་བྱེད་པས་སོ།",
    "དེ་བས་ན་ནང་གི་ནམ་མཁའི་ཁོང་གཞི་ཡིན་པས་རྡོ་རྗེ་འཛིན་ཞེས་ཀྱང་འདོད་དོ།",
    "དེ་ནས་ཞེས་པ་ནི་ལོངས་སྤྱོད་བཞི་དང་ལྡན་པའི་རྡོ་རྗེ་སེམས་དཔའ་ཞལ་གསུམ་པ་ལྟ་བུར་གཟིགས་ཞེས་པའི་དོན་དེ་མ་ཐག་པའོ།",
    "ཡང་དེ་རྣམས་བུད་མེད་དུ་སྤྲོ་བ་གསུངས་པ།",
    "ཁ་ཅིག་ན་རེ་རེག་པའི་དགའ་བ་མེད་པས་མ་བྱུང་ཞེས་ཟེར་ཏེ།",
    "བུད་མེད་ཀྱི་གཟུགས་སུ་སྤྲུལ་ཞེས་པའི་ཚིག་གིས་ན་རེག་པ་ཡང་ཡོད་ལ།",
    "དེ་ལྟར་མ་ཡིན་ན་རོ་ལ་སོགས་པ་ཡང་རེག་པ་མེད་པར་འགྱུར་རོ།",
    "ལ་ལ་ན་རེ་ཉིད་ཀྱི་སྐུ་ལ་ཞུགས་པར་མཛད་དོ་ཞེས་པ་ལ་སྙག་ཅེས་ཟེར་ཏེ།",
    "གཞི་དག་གི་ནི་ཐབས་དག་སྟེ།",
    "དེ་ལ་དེ་ནས་ཞེས་པ་ནི་རྡོ་རྗེ་དཔལ་གྱིས་རེག་པའི་དེ་མ་ཐག་པའོ།",
    "དེ་ནས་ཞེས་པ་ནི་དམ་ཚིག་གི་འཁོར་ལོས་འདོད་པ་སྤྱོད་ཅིག་ཅེས་པའི་དེ་མ་ཐག་པའོ།",
    "གཞན་དག་ན་རེ་ཚིག་འདི་རྣམ་པར་བསྒྱུར་བའོ་ཞེས་ཟེར་རོ།",
    "དམ་ཚིག་ནི་ནང་གིའོ།",
    "ཁ་ཅིག་ན་རེ་འདུས་པ་གསང་བ་ཞེས་པ་ལ་སོགས་པའི་གསོལ་བ་བཏབ་པ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "དེ་ལ་ཞེ་སྡང་གི་རིགས་ཞེས་པ་ནི་རྣམ་པར་དག་པའི་ཞེ་སྡང་ལོངས་སྤྱོད་པ་ལས་སྐྱེས་པའི་ཐ་ཚིག་སྟེ།",
    "ཐབས་གང་གིས་ཚུལ་ཇི་ལྟར་ཞེ་ན་སྦྱོར་བའི་ཐབས་ཞེས་པ་ལ་སོགས་པ་སྟེ་རྡོ་རྗེ་འཆང་བ་ཡབ་ཡུམ་སྦྱོར་བ་ལས་བསྐྱེད་ཅེས་པ་སྟེ།",
    "ལྷག་མ་དང་ལེའུའི་མིང་གི་དོན་རྣམས་ཀྱང་རང་རང་གིས་རྗེས་སུ་དཔག་སྟེ།",
    "ད་ནི་བཙུན་མོ་བཞི་གསུངས་པ་དེ་ནས་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཡང་དག་པར་བཙུན་མོ་ཉིད་ནི་མ་ཡིན་ཏེ་རྣམ་པར་དག་པ་གཅིག་ཏུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བཙུན་མོའི་མཆོག་ཕུན་སུམ་ཚོགས་པ་ཞེས་བྱ་བ་ཡང་ཕྱི་མ་ཁོ་ན་ལས་ཆེར་ཤེས་པར་བྱའོ།",
    "རྣམས་ཞེས་པའི་ཚིག་གིས་འགུགས་པ་ལ་སོགས་པ་ཡང་སྦྱར་རོ།",
    "ཐུན་མོང་གི་ཡི་གེ་ལས་མ་གཏོགས་པ་སྤྱན་དྲང་བའི་སྔགས་མེད་པའི་ཕྱིར་སྡུད་པ་པོས་མ་སྨོས་པར་ཟད་དོ།",
    "ཁྱོད་ཀྱིས་དོན་རྣམས་ལྷུན་གྱིས་གྲུབ་ཕྱིར་བཞེད་པ་ཙམ་ལ་རག་ལས་ལགས་ཞེས་པའི་ཕྱིར་རོ།",
    "ཀུན་རྫོབ་ཀྱི་གཟུགས་ལ་སོགས་པ་ཡང་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་སེམས་ཡིན་པས་ཐམས་ཅད་སེམས་ཙམ་དུ་བསྒྲུབས་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་ཀུན་རྫོབ་པར་རང་བཞིན་མེད་པ་འདི་ཡང་བཅོ་ལྔ་པ་དེ་ཁོ་ནའི་རྗེས་ལས་དེ་ནས་ཞེས་པ་ལ་སོགས་པ་ནས།",
    "དག་པ་ཞེས་པ་ནི་ཉོན་མོངས་པ་ལ་སོགས་པའི་དྲི་མ་མེད་པ་སྟེ་དཔེ་ནམ་མཁའ་བཞིན་ནོ།",
    "ཞེས་པ་ནི་བླ་ན་མེད་པ་སྟེ་ནམ་མཁའ་ལྟར་དག་པས་ཕྱག་གི་འོས་ཡིན་ནོ།",
    "གཟུགས་ཀྱི་ལྷ་མོ་དག་ལ་སོགས།",
    "འཇིགས་ལྟར་ཞེས་པ་ནི་ཞེ་སྡང་གི་རང་བཞིན་པས་ཅུང་ཟད་ཁྲོ་བོའི་ཚུལ་ལོ།",
    "ད་ནི་ཕྲ་མོའི་སྦྱོར་བ་ལ་གང་བསྟན་ནས་སྤྲོ་བ་གསུངས་པ།",
    "པདྨོ་ཞེས་པ་ཡང་ཚེ་དཔག་མེད་དེ་འདྲ་ཞེས་པ་ནི་ཉི་མའི་དཀྱིལ་འཁོར་ལ་རེག་པའི་དོན་ཏོ།",
    "ད་ནི་རང་གི་དོན་རྫོགས་པ་ཐུགས་ལ་བཞག་ནས།",
    "གཞན་གྱི་དོན་དུ་སློབ་དཔོན་གྱི་ལས་ཞེས་གྲགས་པ་རི་མོའི་དཀྱིལ་འཁོར་ཞུ་བ་དང་པོར་བྱས་ཏེ་གསུངས་པ།",
    "དྲི་མ་མེད་པ་ནི་ཉོན་མོངས་པ་ལ་སོགས་པ་དང་བྲལ་བའོ།",
    "དེ་ལྟར་ཡོངས་སུ་དག་པའི་ཚིག་གིས་ཞུས་ནས་ལན་གསུངས་པ།",
    "དེ་བཞིན་དུ་སྐུ་དང་གསུང་གི་དཀྱིལ་འཁོར་ལ་ཡང་རང་གི་བདག་པོ་སྟེ།",
    "རབ་ཏུ་གཙང་ཞེས་པ་ནི་རང་གི་རིགས་ཀྱི་བུ་མོ་གཙང་མས་བཀལ་བའོ།",
    "པཉྩ་རེག་དག་ངོས་རེ་ལ་ཁྲུ་གསུམ་ཞེས་པའི་དོན་ཏོ།",
    "དེས་སྤྱན་མ་ཞེས་བྱ་སྟེ་ཕྱག་རྒྱ་དེའི་བདག་མོ་ཡིན་པའི་ཕྱིར་རོ།",
    "བྱང་གི་ཕྱོགས་སུ་རྡོ་རྗེ་བྲི།",
    "དེ་ལ་ཁ་ཅིག་ན་རེ།",
    "བྱིན་གྱིས་དེ་བརླབས་ཞེས་པ་ནི་རང་གི་རིག་མའི་སྦྱོར་བས་བྱིན་གྱིས་བརླབས་པའོ།",
    "དེ་ནས་ཤེས་རབ་ཅན་དག་གིས།",
    "དེ་བཞིན་དུ་སྐུ་དང་གསུང་གི་དཀྱིལ་འཁོར་ལ་ནི་སྤྱན་མ་དང་གོས་དཀར་མོ་ཡང་མཉེས་པར་བྱ་ཞེས་སྦྱར་ཏེ།",
    "ཞེས་པ་ནི་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་སྤངས་ཏེ་བྱ་བ་ཁོ་ནའི་ཕྱིར་ཏེ་སྤྱོད་པའོ།",
    "སྨེ་ཤ་ཅན་ལ་སོགས་ཞེས་པ་ནི་ཟ་བའི་དམ་ཚིག་གི་ངོ་བོར་ཏེ།",
    "ཡང་འདོད་པ་སྤྱོད་པའི་ཁྱད་པར་གསུངས་པ་མ་དང་སྲིང་མོ་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེ་ལ་མ་དང་བུ་མོ་སྲིང་མོ་རྣམས་ནི་ལོ་གྲངས་དང་དཀྱིལ་འཁོར་གྱི་རིམ་པ་ལས་སྨྲ་བ་དག་ལྟར་ན།",
    "ཡང་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་དང་སྐུ་དང་གསུང་གི་རིམ་པ་ལས་མ་ལ་སོགས་པའི་གོ་རིམས་བཞིན་ཏེ།",
    "དཀྱིལ་འཁོར་གྱི་རིམ་པ་ལས་བུ་མོ་འདོད་པ་དེ་ལ་གཟུངས་མ་ལོ་གྲངས་ཀྱི་ཚད་ལས་མའི་ངོ་བོ་བཞེད་པའི་ཕྱིར་དང་ཡང་དཀྱིལ་འཁོར་ལས་མར་འདོད་པ་ལ་ལོ་གྲངས་ལས་བུ་མོར་བཞེད་དེ།",
    "རང་གི་ཤེས་རབ་ཡེ་ཤེས་ཐོབ་པ་ནི་སྲིང་མོ་དང་།",
    "གཞན་དག་ནི་བུ་མོ་ཞེས་པ་ནི་ངེས་པ་ཡིན་ནོ།",
    "སློབ་དཔོན་གྱིས་གནང་བའི་ཁུ་འཕྲིག་གི་རྟོག་པ་མེད་པས་མི་ཆགས་ཞེས་པའི་དོན་ཏེ་མ་གནང་བ་ལ་མི་སྤྱོད་དོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་འདོད་པའི་ཡོན་ཏན་ལྔ་ཞེས་པ་ནི་གཙོར་གསུངས་ཀྱི་ལྷ་མོའི་ངོ་བོ་ཐམས་ཅད་བཟུང་སྟེ་ལེའུ་བརྒྱད་པ་ལས་དེ་ལྟར་སྣོད་དོ།",
    "དེ་ཡང་ཐོག་མར་རང་གི་ལུས་ལ་སོགས་པ་རང་བཞིན་མེད་པར་ཤེས་པ་ལས་བསྐྱེད་དོ་ཞེས་པ་གསུངས་པ།",
    "ད་ནི་ཕྲ་མོའི་སྦྱོར་བ་རྫོགས་པར་གསུངས་པ་དེ་ནས་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཡང་མཚན་མ་དེའི་ལྟེ་བ་ལ་གནས་པའི་ཡི་གེ་ཧཱུཾ་གིས་བསྐྱེད་པའི་ཕྲ་མོའི་ངོ་བོ་གསུངས་པ།",
    "སྣའི་རྩེ་མོར་ཞེས་པ་ལ་སོགས་པའོ།",
    "གནས་ཞེས་པ་ནི་རང་གི་ས་བོན་ཞེས་པ་སྟེ་དེ་ཡང་ཀུན་ལ་སྦྱར་རོ།",
    "རྡོ་རྗེ་པདྨོ་ཞེས་པ་ནི་ཕྲ་མོ་དེ་ལ་སྦྱོར་ཞེས་པ་སྟེ་དེ་ཡང་ཀུན་ལ་སྦྱོར་རོ།",
    "རང་གི་མཚན་མ་ཕྲ་མོའམ།",
    "འདི་དག་ཀུན་དུ་སྤྱོད་པ་དང་མཉམ་པར་གཞག་པའི་རང་གི་ལྷའི་སྦྱོར་བ་ཕྱག་རྒྱའི་དམ་ཚིག་ལ་ཡང་སྦྱར་ཏེ།",
    "ཇི་ལྟར་འདོད་པ་བསྟེན་ཞེས་པས་སློང་མོ་ལ་སོགས་པ་ཡང་བསྟེན་ནམ་སྙམ་པ་ལས།",
    "དེ་དང་ཀུན་དུ་སྤྱོད་པ་མཐའ་དག་གི་དོན་དེ་ཡང་བཟང་པོ་ཞབས་ཀྱིས།",
    "དེ་དག་ནི་གང་ཕྲ་མོའི་སྦྱོར་བ་ལས་ཉམས་ཤིང་གཟུང་བ་ལས་ཀྱང་ཉམས་པ་དག་ལ་ལས་ཀྱི་ཕྱག་རྒྱས་དངོས་སུ་སོ་སོར་དྲན་ནི་རྗེས་སུ་དྲན་པ་ཞེས་ཏེ་ཕྱི་མ་ལས་བསྒོམས་ནས་རྗེས་སུ་དྲན་པ་གང་ཞེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་རྣམས་ཀྱི་ཁྱད་པར་གསུངས་པ་བུད་མེད་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "ལོ་གྲངས་བཅུ་དྲུག་ཅེས་པ་ནི་སྲིང་མོ་སྟེ་གོང་མ་དང་འོག་མར་ཡང་སྦྱར་རོ།",
    "སྤྱན་ལ་སོགས་པ་ཞེས་པ་ནི་རང་གི་རིག་མའོ།",
    "ཧཱུཾ་གིས་གསང་བའི་རྡོ་རྗེ་དང་པདྨའི་འདབ་མ་བསྒོམ་མོ།",
    "དེ་ལ་རྗེས་སུ་དྲན་པ་རེ་རེ་ནས་གསུངས་པ་དེ་ལ་ཞེས་པ་ལ་སོགས་པའོ།",
    "བདག་གིས་ཀྱང་དེང་སང་ཡན་ཆད་དུ་དེ་བཞིན་བསྒོམས་སོ་ཞེས་དྲན་པ་ནི་སྐུའི་རང་བཞིན་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པ་མེད་པ་དང་།",
    "དེས་ནི་བསྒོམ་མོ་ཞེས་པ་ནི་འདི་ཡིན་ནོ།",
    "རིགས་ཀྱི་སྦྱོར་བ་ཞེས་པ་ནི་རང་གི་རིག་མའི་སྦྱོར་བའོ།",
    "ཕྲ་མོ་ཞེས་པ་ནི་མི་སྣང་བ་ལ་སོགས་པ་ཏེ་དེ་རྣམས་ཀྱི་རྒྱུད་ཀྱི་ཆོ་ག་སྦྱར་བ་ཙམ་གྱིས་འགྲུབ་ཅེས་པའི་དོན་ཏོ།",
    "སེམས་ཞེས་པ་ནི་ཐུགས་ཏེ་དེ་ནི་ཆེན་པོ་ལ་གཟིགས་པས་སྤྱན་ནོ།",
    "ཇི་ཙམ་རོ་རྩ་བའི་མཚན་མ་མིག་དང་སེན་མོ་ལ་སོགས་པ་བརྟག་གོ་ཞེས་པའམ།",
    "བདག་གི་བ་སྤུ་བུ་ག་ཞེས་པ་ནི་བདག་གི་རིག་མ་ཞེས་པའི་དོན་ཏོ།",
    "ཨུཏྤལ་ཞེས་པ་ནི་ཁ་དོག་བཞིའི་ལྷ་མོའོ།",
    "ཁ་ཅིག་ན་རེ་མེ་ཏོག་ཉིད་ཡིན་ནོ་ཞེས་ཟེར་ཏེ་དེ་ནི་མ་ཡིན་ཏེ།",
    "ནམ་མཁའི་ཁམས་ཀྱི་བུད་མེད་དོ།",
    "དེ་ལྟར་མའི་གསུངས་ནས་སྲིང་མོའི་གསུངས་པ་རིན་ཆེན་འབྱུང་གནས་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
