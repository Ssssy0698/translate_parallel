    "ཡར་ངོ་དང་མར་ངོའི་ཚེས་བཅུ་ལག་མཆོད་བྱེད་པར་གསུངས་པས་དེའི་ཚུལ་ནི།",
    "ཁྱད་པར་ཤ་ཆང་སོགས་ཀྱི་བཟའ་བཏུང་རྣམས་གཏོར་མ་ལྟར་བྱིན་གྱིས་བརླབས་ཏེ་མདུན་དུ་བཞག་ལ།",
    "གཡོན་པ་ལ་བསང་གཏོར་བྱས་ལ།",
    "ཞེས་པའི་བར་སྔར་ལག་པ་སྦྱར་བའི་སྐབས་ལྟར་བྱས་པའི་རྗེས་སུ།",
    "ཚོགས་དང་འབྲེལ་ན་དེ་བྱིན་གྱིས་བརླབ་བའི་དོན་དང་སྐབས་གཞན་ཡིན་སྐབས་དང་མཐུན་པར།",
    "ཕྱེད་ནི་སྣོད་གཞན་ཞིག་ཏུ་བཅུག་སྟེ་བཞག་པར་བྱའོ།",
    "མགོ་བོར་བྱུགས་ཏེ་བད་ཀོར་བྱས་ནས་མགོ་བོར་བཞག་ལ།",
    "བདག་ཉིད་ལ་གཞུག་པར་བྱའོ།",
    "ཞེས་པའི་སྐབས་དེར་ལྷ་གཞུག་ཏུ་མི་རུང་བས་ཁྱད་པར་ཤེས་པར་བྱའོ།",
    "ད་ལྟ་མདུན་བསྐྱེད་སྒྲུབ་ཚུལ་སྤྱི་ལྟར་བྱས་ནས།",
    "ཞེས་སོགས་བརྗོད་མི་དགོས་ཏེ་ཁྱད་པར་ཤེས་པར་བྱའོ།",
    "ཀྱི་གཏེར་ཆེན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྣ་ཚོགས་གཟུགས་སྐུའི་རྣམ་པར་རོལ་བ་ཅན།",
    "གནས་ཡིད་དང་མཐུན་པར་འདིའི་བྲིས་སྐུ་དང་མཆོད་གཏོར་སོགས་ཅི་འབྱོར་སྟ་གོན་བྱས་ཏེ།",
    "ཀ་ནི་དེ་ཁོ་ན་ཉིད་ཡུལ་ཡུལ་ཅན་གཉིས་མི་མཐུན་པར་སོ་སོར་མི་གནས་པ་དང་།",
    "སླར་བྱོན་སྣ་བུག་གཡོན་པ་ནས་ཞུགས་ཏེ་ལྟེ་བའི་སྔགས་འཕྲེང་ལ་ཐིམ་པར་གྱུར།",
    "ལུས་ཤེལ་གོང་ལྟར་དག་པར་གྱུར་ཏེ།",
    "ཨོཾ་ཙ་ཀྲ་སཾ་པར་ཨགྷཾ་པྲ་ཏཱི་ཙྪ་སྭཱཧཱ།",
    "ཞེས་སོགས་ཀྱི་རྒྱུན་བཤགས་ལན་གསུམ་དང་།",
    "ནཱ་ད་ཡང་མི་དམིགས་པར་གྱུར།",
    "སླར་ཡང་ནཱ་ད་ནས་སྤུའི་བར་རིམ་པ་བཞིན་དུ་ཧཱུྃ་ཡིག་དཀར་ལ་དམར་བའི་མདངས་ཆགས་པ་རྒྱུ་རྡོ་རྗེ་འཛིན་པའི་རང་བཞིན་དུ་རྫོགས་པར་གྱུར་བ་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས།",
    "སྙོམས་པར་འཇུག་པ་སྔོན་དུ་འགྲོ་བས་ཞུ་ནས་ཧཱུྃ་ཡིག་པས་ཞིམ་པས་ཧཱུྃ་ཡིག་ལྷན་སྐྱེས་ཀྱི་དགའ་བའི་རང་བཞིན་ཅན་དུ་གྱུར་པ་ནི་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས།",
    "དེའི་སྟེང་དུ་མདའ་ཡབ་པདྨ་འདབ་མ་ཕྱེད་པའི་དབྱིབས་ཅན་ལ་རྒྱལ་མཚན་དང་བ་དན་ལ་སོགས་པ་མཛེས་པར་བྱས་ཤིང་།",
    "གཡས་པས་གདུག་པ་ཅན་ཀུན་ལ་གྲི་གུག་དང་བཅས་པའི་བསྡིགས་མཛུབ་ཀྱིས་བསྡིགས་པར་མཛད་པ།",
    "བྱིན་པ་གཉིས་ཀྱིས་ཡབ་ཀྱི་བརླ་ཡི་སྟེང་ནས་ལེགས་པར་འཁྲིལ་བ།",
    "མགྲིན་པར་ཟླ་གདན་ལ་ཨོྃ",
    "ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པས་བྱང་སེམས་སྤྱི་བོ་ནས་ཞུ་བ་མགྲིན་པར་སླེབ་པ་ན་དགའ་བ།",
    "མགྲིན་པར་ཟླ་བ་ལ་རྨོངས་བྱེད་མའི་ངོ་བོ་ཧྲི་མི་དཀར་པོ།",
    "ཛཧཱུཾ་བཾ་ཧོདམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "མགྲོན་རྣམས་བདུད་རྩིས་མཉེས་ཤིང་ཚིམ་པར་གྱུར།",
    "འགྲོ་བའི་དོན་བྱས་ནས་སྔགས་འཕྲེང་ལ་ཐིམ་པར་གྱུར་པར་བསམས་ལ།",
    "དེ་རྣམས་འོད་ཀྱི་སྣང་བར་བྱས་དུར་ཁྲོད་སྲུང་འཁོར་དང་བཅས་པ་གཞལ་ཡས་ཁང་ལ་ཐིམ།",
    "ནཱ་ད་ཡང་མི་དམིགས་པར་གྱུར།",
    "ཕྱོགས་བཅུའི་ཞིང་ཁམས་ནས་བཞུགས་པའི་དཔའ་བོ་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་ཐུགས་ཀའི་ས་བོན་ལས་ཡེ་ཤེས་ཀྱི་བདུད་བརྩི་དང་།",
    "གསུམ་ཡང་ཞུ་ནས་བདུད་རྩིར་ཐིམ་པས་བྱིན་གྱིས་བརླབས་པར་གྱུར།",
    "མ་རྙེད་སོགས་ཀྱིས་བཟོད་གསོལ་བྱས་ལ།",
    "ཡེ་ཤེས་པ་བདག་ཉིད་ལ་ཐིམ་པར་གྱུར།",
    "ཤིས་བརྗོད་ཀྱིས་བརྒྱན་པར་བྱའོ།",
    "སྣ་ཚོགས་གཟུགས་སྐུའི་རྣམ་པར་རོལ་པ་ཅན།",
    "གནས་ཡིད་དང་མཐུན་པར་འདིའི་བྲིས་སྐུ་དང་མཆོག་གཏོར་སོགས་ཅི་འབྱོར་སྟ་གཱན་བྱས་ཏེ།",
    "འདིའི་གཞུང་འགའ་ཞིག་ཏུ་མི་སྣང་ཡང་བྱས་ན་ལེགས་པས་དེའི་ཚུལ་ནི།",
    "ཀ་ནི་དེ་ཁོ་ན་ཉིད་ཡུལ་ཡུལ་ཅན་གཉིས་མི་མཐུན་པར་སོ་སོར་མི་གནས་པ་དང་།",
    "སླར་བྱོན་སྣ་བུག་གཡོན་པ་ནས་ཞུགས་ཏེ་ལྟེ་བའི་སྔགས་འཕྲེང་ལ་ཐིམ་པར་གྱུར།",
    "ལུས་ཤེལ་གོང་ལྟར་དག་པར་གྱུར་ཏེ།",
    "ཞེས་སོགས་རྒྱུན་བཤགས་ལན་གསུམ་དང་།",
    "ནཱ་ད་ཡང་མི་དམིགས་པར་གྱུར།",
    "སྟོང་བའི་ངང་ལས་ནས་ནཱ་ད་དའི་གཟུགས་གྱེན་དུ་བསྒྲེང་ཞིང་ཕྲ་བ་དཀར་ལ་དམར་བའི་མདངས་ཆགས་པ་ནམ་མཁར་གནས་པར་གྱུར།",
    "ལྷོར་སྔགས་དེ་ཉིད་ཁ་དོག་སེར་པོ་རྣམས་སུ་འཁོད་པར་གྱུར།",
    "སླར་ཡང་ནཱ་ད་ནས་ཨུའི་བར་རིམ་པ་བཞིན་དུ་ཧཱུྃ་ཡིག་དཀར་ལ་དམར་པའི་མདངས་ཆགས་པ་རྒྱུ་རྡོ་རྗེ་འཛིན་པའི་རང་བཞིན་ཅན་དུ་རྫོགས་པར་གྱུར་པ་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས།",
    "ཐོག་མ་ནས་གྲུབ་པའི་དཔའ་བོ་ནལ་འབྱོར་མ་དང་ལྷན་ཅིག་སྤྱན་དྲངས་སྙོམས་པར་འཇུག་པ་སྔོན་དུ་འགྲོ་བས་ཞུ་བས་ཧཱུྃ་ཡིག་ལ་ཐིམ་པས་ཧཱུྃ་ཡིག་ལྷན་སྐྱེས་ཀྱི་དགའ་བའི་རང་བཞིན་ཅན་དུ་གྱུར་པ་ནི་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས།",
    "དེའི་སྟེང་དུ་མདའ་ཡབ་པདྨ་འདབ་མ་ཕྱེད་པའི་དབྱིབས་ཅན་ལ་རྒྱལ་མཚན་དང་བ་དན་ལ་སོགས་པ་མཛེས་པར་བྱས་ཤིང་།",
    "གཡས་པས་གདུག་པ་ཅན་ཀུན་ལ་གྲི་གུག་དང་བཅས་པའི་བསྡིགས་མཛུབ་ཀྱིས་བསྡིགས་པར་མཛད་པ།",
    "བྱིན་པ་གཉིས་ཀྱིས་ཡབ་གྱི་བརླ་ཡི་སྟེང་ན་ལེགས་པར་འཁྲིལ་བ།",
    "ཐམས་ཅད་ཀྱང་ཞལ་གཅིག་སྤྱན་གསུམ་མ་མཆེ་བ་རྣམ་པར་གཙིགས་པའི་ཞལ་ཅན།",
    "ཐམས་ཅད་ཀྱང་ཉི་གདན་ལ་གཡས་བརྐྱངས་ཀྱིས་བཞུགས་པའོ།",
