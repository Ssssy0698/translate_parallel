    "རྒྱན་གྱི་ཁྱད་པར་བརྒྱད་དང་ཡོ་བྱད་དྲུག།",
    "ཨོཾ་སརྦ་བིད་པཱུ་ར་སོགས་བརྗོད་དེ་འབུལ་བ་གསུམ་ལས་གང་བྱས་ཀྱང་རུང་ངོ།",
    "དེ་ནས་བདག་བསྐྱེད་ལྟར་བསྙེན་པ་ཅི་འགྲུབ་བྱས་ནས་ཡིག་བརྒྱ་བརྗོད་དེ།",
    "ཁྱད་པར་བགེགས་གཏོར་ལ་ཤ་ཆང་ལ་ཕུག་དང་བཅས་པའོ།",
    "བཞི་ཀ་ལ་ཟླུམ་པོ་པད་འདབ་ཅན་ནམ་དེ་མ་བྱས་ཀྱང་ཟླུམ་པོར་མཚུངས་པར་བྱར་རུང་ངོ།",
    "ཆབ་བྲན་བན་བསྐུལ་མི་ཉན་པར་འདོད་པ་ཡང་མི་འཐད་དེ།",
    "གཏོར་མ་ཕལ་ཆེར་ལག་པར་བླངས་སྟེ་བྱིན་པར་གསུངས་པ་དང་།",
    "ཧཱུྃ་མཛད་ཀྱི་ང་རྒྱལ་གྱིས་རྩིག་པའི་འོག་ནས་ཐོག་མ་མེད་པར་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཞུགས་ཏེ་བསྐོར་བ་བྱ།",
    "ཁ་ཅིག་རྡོ་རྗེའི་ཤུགས་ཀྱི་ང་རྒྱལ་བྱས།",
    "དཀྱིལ་འཁོར་དུ་ཞུགས་ཞུས་གསུང་བ་ནི་མི་འཐད་པར་མངོན་ནོ།",
    "དེའི་དམིགས་རྣམ་བརྡ་སྤྲད་དེ་བརྟན་པར་བྱའོ།"
  ]
}