    "ཨོཾ་བཛྲ་ས་ཏཱ་ཀོ་དྷ་ཨ་ན་ལཱ་རྐམ་ཧཱི་ཀྲོ་དྷ་ཞེས་སོགས་ཀྱི་སྔགས་གསུངས་པའི་རྗེས་སུ།",
    "རྡོ་རྗེ་སེམས་དཔའ་བཞག་པར་བྱ།",
    "ཞི་བའི་ཐབ་ཁུང་གསུམ་ནི་ལེགས་བྱས་ལ།",
    "རྒྱལ་པའི་ལས་སོ་ཞེས་པའི་བར་གྱིས་རྒྱས་པའི་ཐབ་ཀྱི་དབྱིབས་ཚད་རྫས་དང་ཆོ་གའི་ཁྱད་པར་སོགས་བསྟན་ཅིང་།",
    "དྲན་ནམ་ཉན་པར་བྱེད་ཀྱང་རུང་།",
    "འདིར་སྟོན་པ་ལ་བསྟོད་འོས་པར་ཕྱག་རྡོར་ལ་བསྟོད་པ་ཅི་ཡིན་ཞེ་ན།",
    "རྩ་རྒྱུད་ཉིད་སྟོན་པས་གསུངས་པ་གཙོ་ཆེ་ཡང་།",
    "རྗེས་སུ་གནང་བའི་བཀའ་ཡིན་པའི་ཕྱིར་སྟོན་པའི་བཀར་འགྱུར་ལ།",
    "ཆོ་ག་མཛད་པ་འདིས་ཀྱང་ཕན་པར་ངེས།",
    "རྒྱུད་དོན་ཤེས་པར་འདོད་པ་དག་ལ་ཕན་ཐོགས་པར་གྱུར་ཅིག་པར་གྱི་ཡི་གེ་བ་ནི་རི་ཁྲོད་པ་དགེ་སློང་ཤེས་རབ་བཀྲ་ཤིས་སོ།",
    "ཀུན་ནས་སྤྱོད་པར་བྱེད་པའི་ཐབས་ཀྱི་དཔལ།",
    "བསྟན་འགྲོའི་ས་ཆེན་མཛེས་པའི་རྒྱན་དུ་བྱས།",
    "གཞན་གྱིས་ཟེར་ཟློས་རྗེས་འབྲང་ཙམ་མིན་པར།",
    "དེ་ཡང་གྲགས་ཆེ་བ་འགའ་ཞིག་བཏང་སྙོམས་སུ་བྱས་ཏེ།",
    "ཕྱག་ན་རྡོ་རྗེ་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་རྣམས་གསུངས་ཏེ།",
    "མེ་ལྟར་འབར་བ་འཕྲིན་ལས་ཀྱི་དཀྱིལ་འཁོར་གཉིས་གསུངས་ཏེ།",
    "ལས་རུང་དུ་བྱས་ནས་དངོས་གྲུབ་སྒྲུབ་བའོ།",
    "འདིར་ཡང་ཐོག་མར་རང་ཉིད་རྡོ་རྗེ་སེམས་དཔར་བསྐྱེད་ནས་རྡོར་དྲིལ་མཚན་པ་སོགས་བྱིན་བརླབ་བྱ་དགོས་ཏེ།",
    "དེ་ལྟར་བྱེད་པ་རྒྱུད་དོན་གསལ་བ་འགྲེལ་བ་དང་བཅས་པ་ལས་གསུངས་ཤིང་།",
    "ནི་བསྟིམས་པའི་རྡོ་རྗེ་སེམས་དཔའ་དེ་རང་ལ་དགྱེས་བཞིན་དུ་བཞུགས་པའི་དོན་ཏེ།",
    "བཤགས་པ་དང་རྗེས་སུ་ཡི་རང་བ་སོགས་སོ།",
    "དཀྱིལ་འཁོར་སྒྲུབ་མཆོད་ཀྱི་ཚེ་ལས་ཀྱི་རྡོ་རྗེས་སློབ་དཔོན་སོགས་ལ་དཀྱིལ་འཁོར་སྒྲུབ་པའི་དོན་དུ་ལྷའི་རྣལ་འབྱོར་ལ་གནས་པར་ཞུ་བ་སོགས་སྤྲོས་པ་ལ་འཇུག་པའི་ཚེ་ཡིན་ལ།",
    "དེ་བཞིན་དུ་གཞན་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཨོཾ་བཛྲ་ཨ་ན་ལའི་སྔགས་དང་ཕྱག་རྒྱས་བ་སྲེག་པར་བྱ།",
    "རང་ལུགས་ནི་ཧཱུྃ་མཛད་ཀྱི་ང་རྒྱལ་ལ་གནས་བཞིན་པར་རྡོ་རྗེ་མང་པོ་སྤྲོས་ཏེ།",
    "བཛྲ་ཌི་ལྟོ་ཞེས་བརྗོད་པ་དང་དེའི་ཕྱག་རྒྱ་བྱས་ནས།",
    "འོན་ཀྱང་གང་ཟག་ཁྱད་པར་ཅན་འགའ་ཞིག་ལ།",
    "པཱ་ད་བརྡས་ཕྱག་བྱས་ནས།",
    "མྱ་ངན་མི་འདའ་བར་བཞུགས་པར་གསོལ་བ་དང་།",
    "དེ་གཉིས་སོ་སོའི་མཐའ་སྐོར་དུ་ཨཨཱ་སོགས་དབྱངས་ཡིག་བཅུ་དྲུག་པ་གྱེན་སྒྲེང་ཚར་གཉིས་འོད་ཟེར་འབར་བ་དང་བཅས་པར་བསྒོམ།",
    "ཐབས་ཤེས་ཁྱད་པར་ཅན་གཉིས་ཀྱི་ཆ་སོ་སོའི་གཟུང་རྣམ་ལྷའི་རྣམ་པར་ཤར་བ་མཚོན་ནོ།",
    "གཉིས་ཆད་ཀྱི་ཚུལ་དུ་རྣམ་པ་ཐ་དད་ཀྱང་གོ་ས་འདྲེས་པར་བསམ།",
    "གོ་ས་འདྲེས་པ་ཙམ་བྱས་པས་ནི།",
    "རྡོ་རྗེ་འབེབས་པར་བསམ་ལ་དེའི་དམ་རྒྱ་བཅིངས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀ་ནས་ཡེ་ཤེས་དེ་ཉིད་རྡོ་རྗེ་རྩེ་ལྔ་བ་ཁ་དོག་དམར་པོ་འོད་དམར་པོ་འབར་བའི་རྣམ་པར་དཔག་ཏུ་མེད་པ་བྱུང་ནས།",
    "ཏིརཱ་བཛྲ་ཌི་ལྷོ་ཞེས་སོགས་ཀྱིས་སྔར་ཕབ་པའི་ཡེ་ཤེས་པ་དེ་བརྟན་པར་བྱས་པར་བསམ།",
    "འགའ་ཞིག་གཞལ་ཡས་ཁང་མེད་པར་སེང་ཁྲི་གདན་བཅས་ཀྱི་སྟེང་དུ་རྣམ་སྣང་བསྐྱེད་ཟེར།",
    "རང་ཉིད་རྣམ་སྣང་དུ་བསྐྱེད་དེ་རྡོར་སེམས་སོགས་སྤྲུལ་ཏེ་འགོད་པར་གསུངས་པ་སོགས་ཡོད་པས།",
    "སྒོམ་ནའང་གཞལ་ཡས་ཁང་ཕྱི་ནང་གཉིས་ཀ་བསྐྱེད་མི་དགོས་པར་སེམས་ཏེ།",
    "ལྷ་གཅིག་ལ་གཞལ་ཡས་ཁང་ཕྱི་ནང་གཉིས་བསྐྱེད་པའི་དགོས་པ་ཁྱད་པར་ཅན་མི་སྣང་བའི་ཕྱིར་དང་།",
    "ཕྱག་རྒྱ་བཀྲོལ་བ་ཡིན་ཚད་རྒྱས་བསྡུས་ཅི་རིགས་པར་བྱས་ནས།",
    "བདག་བསྐྱེད་རྒྱས་བ་བྱས་ན་ལེགས་ཏེ།",
    "སྔགས་དོན་ནི་གཞན་ནས་ཤེས་པར་བྱའོ།",
    "ཊཱིཀ་ཆེན་གྱི་དགོངས་པར་བརྟགས་ན།",
    "ཐོག་འབུབས་ཚུལ་རྒྱས་པར་ནི།",
    "རྩིབས་ཀྱི་མཚམས་སུ་འཛུགས་དགོས་པར་སྣང་ལ།",
    "དར་གྱི་སྟོད་གཡོགས་སོགས་ཀྱིས་སྤྲས་ཤིང་བཞུགས་པའོ།",
    "འདིར་སྟོན་པ་ལོངས་སྐུའི་རྣམ་པར་བསྟན་པའི་དགོས་པ་དང་།",
    "སྒོ་དྲུག་དང་ཆོ་ག་གསུམ་བསྐྱེད་ཀྱིས་འཁོར་རྣམས་བསྐྱེད་པར་བྱ་ཞིང་།",
    "འདི་རྣམས་ཀྱི་སྐབས་སུ་ཕྱག་ཆེན་བྱེད་པར་གཞུང་རྣམས་སུ་མི་གསལ་བས་མ་བྱས་ཀྱང་ཆོག་ལ།",
    "རྒྱས་པར་ན་ཆོ་གའི་གཞུང་ལྟར་ཚིགས་བཅད་རྣམས་དང་།",
    "ད་ནས་ནམ་མཁར་བཞུགས་པའི་ལྷའི་འཁོར་ལོ་རྣམས།",
    "མ་ཕྱེ་ན་སྟེང་ནས་འཇུག་པར་གསལ་ལ།",
    "ལྷ་སོ་སོའི་ཕྱག་མཚན་འཛིན་ཚུལ་དང་མཐུན་པར་ཕྱག་རྒྱུ་བྱས་པའི་ལུས་དང་ལག་པའི་འདུ་བྱེད་ནི་ཕྱིའི་དམ་རྒྱུ་དང་།",
    "ཡང་ལྷ་སོ་སོའི་སྐུའི་རྣམ་པ་ཇི་ལྟ་བ་དང་མཐུན་པར་བཅས་པའི་ལུས་ཀྱི་བཀོད་པའི་འདུ་བྱེད་ནི་ཕྱིའི་ཕྱག་མཚན་དང་།",
    "ཕྱི་རོལ་དུ་ལྷའི་སྐུ་བྲིས་པ་དང་ལུས་ལྷའི་རྣམ་འགྱུར་བྱས་པ་ནི་ཕྱིའི་ཕྱག་མཚན།",
    "ལས་རྒྱ་ཕྱག་ཆེན་རྣམས་རིམ་བཞིན་དུ་རྒྱས་འདེབས་པར་བཞེད་པས།",
    "དེ་གཉིས་གང་བྱས་ཀྱང་རུང་ཞིང་།",
    "འཇིག་རྟེན་གསུམ་རྒྱལ་གྱི་རྟོགས་པ་ལས་ཀྱང་གསུངས་པས།",
    "དེ་བཞིན་གཤེགས་པ་ལྔ་ལ་ས་མ་ཡ་སཱུ་ཞེས་བརྗོད་དེ་ཕྱག་རྒྱ་གང་བཅིང་བའི་ལྷ་དེ་དང་དེའི་ཐུགས་དྲན་པར་བྱས་ནས་རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ཏེ་ལག་པ་བྱིན་གྱིས་རློབ།",
