    "རྒྱ་མཚོ་ལ་ནི་ཆུ་བོ་བཞིན་དུ་རང་གི་ལུས་ལ་ཐིམ་ཞིང་ནུབ་པ་ཉིད་དུ་འགྱུར།",
    "དེ་ལྟ་མོད་ཀྱི་བློ་མིག་རྣམ་དག་མཁས་པའི་པདྨོ་རྒྱས་བྱེད་ཡིན།",
    "ལྟ་བ་ཆུ་བོ་བཟློག་པར་དཀའ་མོད་ཀྱི།",
    "སྔོན་བྱགྱི་སྒྱུར་བྱེད་དམ་པ་དེ་དག་གི།",
    "གཙུག་གི་ནོར་བུར་སྐལ་ལྡན་ནི།",
    "གང་གི་ཐུགས་ནི་བརྩེ་བས་ལེགས་དྲངས་གཞན་ཕན་མཛད་པས་མི་སྐྱོ་ལ།",
    "མགོན་པོ་སྔོན་འབྱུང་གི་རྒྱུད་ལས་ཀྱང་།",
    "དེ་དག་ཀྱང་གསུམ་པ་ཚིག་གི།",
    "གཉིས་པ་འདོད་པའི་ལྷ་ལ་ཕྱག་བྱ་བ་ལ་ལྔ་ལས་གང་གིས་ན་ཡི་གེ་པའམ་ལོ་ཙཱ་བས་སོ།",
    "ཉོན་མོངས་པ་རྣམས་ཀྱིས་བྱིས་པར་གྱུར་པའི་གནས་སྐབས་ལས་འདས་ཏེ་དག་པའི་ས་གཞིར་གནས་ལ་སྐབས་པས་གཞོན་ནུར་གྱུར་པའོ།",
    "བརྩམ་བྱ་གཞུང་གི་ལུས་དངོས་བཤད།",
    "གསུམ་པ་ཚིག་གི་དོན་ལ་གཉིས་ཀྱི་དང་པོ་བསྟོད་པའི་ཚིག་དོན་ནི།",
    "ཁམས་གསུམ་གྱི་སེམས་དང་སེམས་བྱུང་བདག་དང་བདག་གི་ལ་སོགས་པའི་རྣམ་པར་ཞུགས་པ་དང་།",
    "བསྟན་བཅོས་རྣམ་འགྲེལ་འདི་ལེན་བྱེད་མཁས་པ་དག་ཁོ་ན་ཡོད་མོད་ཀྱི་འོན་ཀྱང་ཉན་པ་པོའི་སྐྱོན་མང་བས་ཕན་པ་མེད་པ་སྐད་དུ་མཛད་དེ།",
    "ད་ལ་སེམས་ཁོང་ནས་འཁྲུག་པའི་ཕྲག་དོག་དྲི་མ་དག་གིས་ཞེ་སྡང་བར་ཡོངས་སུ་གྱུར་པ་ཡིན་ནོ།",
    "རྒྱུ་གང་གིས་ཞེ་ན།",
    "ངག་གཞན་དང་ཐུན་མོང་བའི་བྱ་བ་སྟེ།",
    "རང་གི་བརྗོད་བྱ་གོ་བར་བྱེད་པའོ།",
    "ངག་གཞན་དང་ཐུན་མོང་མིན་པའི་བྱ་བ་སྟེ་འདི་ལས་ཀུན་བཏུས་ཀྱི་ཚིག་དོན་བདེ་བླག་ཏུ་རྟོགས་པ་ཡིན།",
    "དེ་ལས་སློབ་དཔོན་ལ་སྡང་བ་ལོག་ཅིང་སྐྱེས་བུའི་གནས་སྐབས་དང་མཐར་ཐུག་གི་དོན་གྲུབ་པ་ལ་སོགས་ཡིན་ནོ།",
    "སྐྱེས་བུའི་དོན་ལའང་དུལ་ལྷ་ན་རེ།",
    "བྱ་བའི་ངོ་བོ་ཡང་དགོས་པ་ཙམ་ཡིན་མོད་ཀྱི་འདིར་དཔྱད་བྱའི་དགོས་པའི་གཙོ་བོ་མིན་ཏེ།",
    "རབ་ཏུ་གྲགས་པའི་དོན་ནི་དཔག་བསམ་གྱི་ཤིང་གི་ལམ་སྟོན་པ་ལྟ་བུའོ།",
    "གསུམ་པ་ཚིག་གི་དོན་ནི་འདི་ནི་ཞེས་པས་བསྟན་བཅོས་ཀྱི་བརྗོད་བྱ་བསྟན་ཏེ།",
    "རང་གིས་བརྟགས་ཤིང་དཔྱད་པ་ལས་གོ་དགོས་པས་ན་རྟོགས་པར་དཀའོ།",
    "དེས་ན་རྟགས་ཡང་དག་གི་མཚན་ཉིད་ཚུལ་གསུམ་ངེས་པའི་རྟགས་སོ།",
    "ཤ་པའི་སྡོང་སྒྱུར་འདི་ཤིང་གི་ཐ་སྙད་དུ་བྱར་རུང་སྟེ་ཤ་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཤིང་གི་རྒྱུ་ལས་རྒྱུ་གཞན་ལ་མི་ལྟོས་པར་ཤིང་གི་རང་བཞིན་ཡོད་པ་ཙམ་དང་འབྲེལ་པ་ཅན་གྱི་ངོ་བོར་སྐྱེས་ཤིང་ཚུལ་གསུམ་པར་ངེས་པའི་ཕྱིར་རོ།",
    "མེད་དོན་ཅན་ཏེ་དགག་པའི་དོན་དང་ཐ་སྙད་ཀྱི་ཡུལ་ཅན་སྣང་རུང་མ་དམིགས་པའི་གཏན་ཚིགས་དེ་ལའང་དབྱེ་ན་སྦྱོར་བའི་བྱེ་བྲག་གིས་རྣམ་པ་བཞིར་འགྱུར་ཏེ།",
    "འདིས་ནི་ཁྱབ་བྱེད་དང་འགལ་བ་གྲུབ་པ་འདི་ན་བ་མོའི་རེག་པ་མེད་དེ།",
    "གྲང་རེག་དང་འགལ་བ་མེའི་འབྲས་བུ་དག་གྲུབ་པ་འདི་ན་གྲང་རེག་མེད་དེ།",
    "བ་རྨསཀྱང་གྲང་རེག་པར་ཅི་སྟེ་མི་འགྲུབ་ཅེ་ན།",
    "ཡང་གིས་འབྲས་རྟགས་ཀྱང་ཁྱད་པར་གསུམ་ལ་ལྟོས་པར་གཟུང་ངོ།",
    "གསུམ་པོ་ལ་ལྟོས་པ་ལས་གཞན་དུ་ན་དེས་གྲང་རེག་མེད་པར་སྒྲུབ་ན་འཁྲུལ་བར་འགྱུར་ཏེ།",
    "ཡུལ་སོགས་ལ་མ་ལྟོས་པར་མི་གྲང་བར་སྒྲུབ་པ་ལ་ཐལ་པ་རྟགས་སུ་བཀོད་པ་བཞིན་ནོ།",
    "རྒྱུ་ཚོགས་པ་དེ་ཁྱོད་ཀྱི་རྒྱུ་ལས་རྒྱུ་དོན་གཞན་ལ་མི་ལྟོས་པར་དེའི་བདག་ཉིད་དུ་བྱུང་བའི་ཕྱིར་རོ།",
    "དངོས་རྒྱུའམ་བརྒྱུད་རྒྱུའི་ཚོགས་པ་གང་གིས་དེ་ལྟར་དཔོག་དང་པོ་མི་འཐད་དེ།",
    "རང་གི་ནུས་པ་རྣམས་ཕྱི་མ་ཕྱི་མ་ཁྱད་པར་ཅན་དུ་འགྱུར་པ་དང་འབྲེལ་པ་ལ་ལྟོས་པའི་རང་གི་བརྒྱུད་པའི་འབྲས་བུ་དཔོག་ནི་མ་ངེས་པ་ནི་ཉིད་ཡིན་ཏེ།",
    "དེས་རང་གི་བརྒྱུད་འབྲས་བསྐྱེད་པ་ལ་རྒྱུན་འགྱུར་བའི་བར་འདིར་འགལ་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "སོགས་པས་ཙམ་པ་ཀའི་དྲི་དང་མེའི་རེག་པས་གཟུགས་དཔོག་པའང་བསྡུའོ།",
    "རང་ལ་ནུས་པ་འཇུག་པའི་རོ་སྔ་མ་དེ་མེད་པར་ནི་ཁྱོད་མེད་ཅིང་རང་གི་ཉེར་ལེན་རོ་སྔ་མ་དེ་ཉིད་གཞན།",
    "མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བ་ཙམ་གྱིས་ལྡོག་པ་འཁྲུལ་པ་མེད་པ་མིན་པར་ཐལ།",
    "ཕྲུ་བ་གཅིག་གི་ནང་དུ་ཆུད་པར་ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་པ་བཞིན་ནོ།",
    "དེས་ན་ལྡོག་པ་གྲུབ་པར་འདོད་པས་འབྲེལ་པ་ཁས་ལེན་དགོས་ཏེ་འབྲེལ་པ་མེད་ན་རྟགས་གོ་བྱེད་མ་ཡིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "འཁྲུལ་པ་ཅན་ཐུན་མོང་གི་མ་ངེས་པ་དང་།",
    "གཉིས་ཀ་ལ་ཐེ་ཚོམ་ཟ་བ་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པའི་གཉེན་པོར་ལྡོག་པ་ངེས་པ་བརྗོད་དོ།",
    "དང་པོ་ལ་གཉིས་ལུང་གི་གནོད་བྱེད་དང་།",
    "དང་པོ་ལ་དྲུག་གི་དང་པོ་མི་མཐུན་སྨོས་པ་དོན་མེད་འགྱུར་བ་ནི།",
    "རེ་ཤིག་འགལ་བ་དང་མ་ངེས་པའི་གཉེན་པོར་གཉིས་ཀ་བརྗོད་པར་བྱ་བ་གང་ཡིན་པ་འདི་ནི་རིགས་སོ་ཞེས་སོ།",
    "རྟགས་དེ་མི་མཐུན་ཕྱོགས་ལ་མེད་པ་ཁོ་ནར་ངེས་མི་ནུས་པར་ཐལ།",
