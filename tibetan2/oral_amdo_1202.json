    "དེའི་བརྗོད་བྱ་ལ་ཁྱད་པར་གཞན་སྤོང་མི་སྤོང་གི་བརྡ་ཐ་དད་བྱས་པ་དགོས་པ་མེད་པར་ཐལ།",
    "ཁྱད་པར་གཞན་སྤོང་མི་སྤྱོང་གི་བརྡ་ཐ་དད་བྱ་དགོས་ཏེ།",
    "རང་གི་བརྗོད་བྱ་ངེས་པའི་ཡུལ་དུ་དེ་དག་གི་བརྗོད་བྱ་ལ་དེ་མིན་བཅད་ཙམ་ལས་ཁྱད་པར་རྫས་ཐ་དད་པ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "རང་གི་བརྗོད་བྱ་ཁྱད་པར་གཞན་མ་སྤངས་པ་དང་སྤུངས་པ་བརྗོད་པ་འདི་ཉིད་ཙམ་ཡིན་པ་དེའི་ཕྱིར།",
    "དེས་ན་ཁྱད་པར་གཞན་སློང་མི་སྤོང་གི་སྒོ་ནས་སྐབས་ཀྱི་དོན་ཤེས་པར་བྱེད་འདོད་པས་དེ་ལ་ཕན་པའི་རྐྱེན་གྱི་མཐའ་ཅན་འཚེད་པ་ཉིད་ཀྱི་སྒྲའམ།",
    "གལ་ཏེ་དེ་གཉིས་ལས་གཞན་ཡིན་བྱེད་ཀྱི་མཐའ་ཅན་རས་ཡུག་གི་དཀར་པོ་ཞེས་དང་།",
    "རིགས་དེ་ལྡན་གསལ་བ་དངོས་སུ་གཞན་གྱིས་བར་མ་ཆོད་པར་བརྗོད་པ་མིན་པར་ཐལ།",
    "བུམ་པ་བརྗོད་པའི་སྒྲ་དང་དེ་གཉིས་ཀྱི་བརྗོད་བྱ་ལ་གཞི་མཐུན་མི་སྲིད་པར་ཐལ།",
    "དེས་ཡོད་པའི་ཁྱད་པར་བུམ་པ་རང་གི་བརྗོད་བྱར་མི་འཕེན་པའི་ཕྱིར་དང་།",
    "དྲུག་པ་དང་ཚིག་དབྱེ་བ་མང་ཚིག་དང་སོགས་པས་དེ་ཕན་གྱི་རྐྱེན་ཅན་གྱི་ཚིག་མི་འཇུག་པར་ཐལ།",
    "བཙུན་མོ་རྣམས་ཞེས་ཐ་དད་མང་པོའི་སྒྲ་མི་འཇུག་པར་ཐལ།",
    "སོགས་པས་བྱེ་མ་གཅིག་ལ་བྱེ་མ་རྣམས་ཞེས་པའི་མང་ཚིག་མི་འཇུག་པར་ཐལ་བ་སྡུད་དོ།",
    "ནམ་མཁའ་རང་བཞིན་ཞེས་དྲུག་པ་དང་ནམ་མཁའི་མཁའ་ཉིད་ཅེས་དེ་ཕན་གྱི་ཚིག་མི་འཇུག་པར་ཐལ།",
    "འདི་ལ་སྒྲ་རྟོག་དེ་དག་གི་རྒྱུ་དངོས་པོ་ཐ་དད་པ་ཅི་ཡང་མེད་པས་སོ།",
    "གང་གི་རང་གི་ངོ་བོ་རྣམ་པ་གཅིག་ཏུ་སྣང་བ་ཡིས་གཞན་རང་མཚན་གྱི་ངོ་བོ་ཇི་ལྟ་བ་བཞིན་སྣང་བ་སྒྲིབ་པར་བྱེད་པའི་ཕྱིར།",
    "དངོས་པོ་རང་མཚན་རྣམས་རིགས་མི་མཐུན་ལས་ལོག་ཙམ་གྱི་ངོ་བོ་གཅིག་ཏུ་བརྟགས་པ་འགའ་ཞིག་གིས་ཐ་དད་མིན་པ་རིགས་གཅིག་པ་ལྟ་བུར་སྣང་སྟེ།",
    "ཕན་ཚུན་ཐུན་མོང་དུ་མི་འདྲེ་ཞིང་རྗེས་སུ་མི་འགྲོ་བའི་ཕྱིར།",
    "ཇི་ལྟར་དོན་གཞན་ཕྱི་རོལ་གྱི་གསལ་བ་ལ་བདག་གཅིག་ཏུ་རྗེས་སུ་འབྲང་བའི་སྤྱིར་མི་འགྱུར་བར་ཐལ།",
    "བདག་ཉིད་གང་གིས་ཀྱང་མཚུངས་པ་མ་ཡིན་པའི་ཕྱིར་ཞེས་པས་མཇུག་བསྡུའོ།",
    "སྤྱི་འཛིན་དེ་ཁྱོད་མཐོང་བའི་བག་ཆགས་ཀྱིས་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "ཞིང་སོགས་ཐ་དད་ཀྱང་ནུས་པ་མྱུར་བུལ་གྱི་ཁྱད་པར་མེད་པར་ཐལ།",
    "རྟོག་པ་ལ་ཐ་དད་ཡིན་པ་རིགས་གཅིག་ལྟ་བུར་སྣང་གི་དོན་ལ་རིགས་གཅིག་མིན་ཏེ།",
    "འདི་ལྟར་རིགས་མི་མཐུན་ལས་ལྡོག་པའི་རིགས་གཅིག་གི་ངོ་བོ་ཅན་དུ་སྣང་བས་བརྫུན་པ་དེས་ནའོ།",
    "སྤྱི་དང་ནི་གཞི་མཐུན་སྤྱོད་ཡུལ་ཅན་དག་གི་ཤེས་པ་དང་ནི་བརྗོད་པའི་སྒྲ་ཡིས་སྤྱི་དང་གཞི་མཐུན་གྱི་ཐ་སྙད་ནོར་པ་སྟེ་བརྫུན་པའི་དོན་ཅན་རྒྱས་པར་བྱེད་དེ།",
    "དེས་རང་གི་འབྲས་བུ་དེ་ལྟ་བུ་བྱེད་པ་ཅན་མིན་པའི་གཞན་རིགས་མི་མཐུན་ལས་ལོག་པའི་ལྡོག་པ་བརྟེན་པ་ཅན་ཏེ་ཡོད་པའི་ཕྱིར།",
    "བློ་ལ་སྣང་བའི་དོན་སྤྱི་ལ་འཇུག་གི་རང་མཚན་ལ་མི་འཇུག་སྟེ།",
    "ལྔ་པ་རྗེས་དཔག་གི་རང་མཚན་འཛིན་པ་དགག་པ་ནི།",
    "མངོན་སུམ་ལྟར་རྗེས་དཔག་གིས་ཀྱང་རང་མཚན་སྒྲུབ་པས་འཛིན་ནོ་ཞེ་ན།",
    "སྤྱི་ཁྱད་པར་དུ་བྱས་པའི་རང་མཚན་མི་འཛིན་པར་ཐལ།",
    "དེ་རྟོག་པ་ལ་སྣང་ནས་བརྡ་བྱ་བ་མ་ཡིན་པར་ཐལ།",
    "ཁྱོད་བརྡ་དུས་སུ་མཐོང་བ་གང་ཡིན་པ་དེ་ཕྱིས་ཐ་སྙད་ཀྱི་ཚེ་ན་སྣང་བའི་རྗེས་འགྲོ་མེད་པ་དེས་ནའོ།",
    "རྨོ་བཞོ་ལ་སོགས་པ་དོན་གཉེར་དེ་དེ་ལ་འཇུག་པའི་དོན་དུ་བ་ལང་གི་བརྡ་སྦྱོར་བ་མི་རིགས་པར་ཐལ།",
    "གསུམ་པ་རིགས་ལྡན་སྒྲའི་ཡུལ་མ་ཡིན་པ་ལ་དྲུག་གི།",
    "སྒྲས་བརྗོད་མི་ནུས་པར་ཐལ།",
    "རིགས་སྒྲ་གཅིག་འཇུག་པའི་དོན་དུ་རིགས་རྫས་གཞན་དངོས་པོ་བ་མི་དགོས་པར་ཐལ།",
    "སེལ་པ་བརྗོད་པར་ཐལ།",
    "ཇི་ལྟར་འདོད་དོན་ལ་རྗོད་བྱེད་དུ་བརྡ་སྦྱར་བར་མི་འོས་པར་ཐལ།",
    "སྒྲ་སྦྱོར་བའི་དོན་དུ་སྤྱི་གཞན་བརྗོད་པར་བྱས་པས་ནི་ཅི་ཞིག་བྱ་སྟེ་བྱ་མི་དགོས་པར་ཐལ།",
    "བཞི་པ་ངོ་ཤེས་སྤྱི་ལས་སྐྱེ་ན་ཧ་ཅང་ཐལ་བ་ནི།",
    "གལ་ཏེ་སྤྱི་དངོས་པོ་བ་གཅིག་གིས་ལྷན་ཅིག་པའི་གྲོགས་བྱེད་པའི་གསལ་བ་རྣམས་སྤྱི་འཛིན་ཤེས་པའི་དམིགས་རྒྱུ་ཡིན་པས་སྤྱི་འཛིན་པའི་ཚེ་སྤྱི་གསལ་ལྷན་ཅིག་ཏུ་འཛིན་པས་སྔར་གྱི་སྐྱོན་མེད་ཞེ་ན།",
    "དེ་ལ་གསལ་བ་དེ་རྣམས་ལ་ཁྱོད་བསྐྱེད་པའི་ནུས་པ་མེད་པར་ཐལ།",
    "གསལ་བ་དེ་དག་སོ་སོ་རེ་རེ་མེད་ཀྱང་སྤྱི་ཡོད་ཙམ་གྱིས་གསལ་བ་གཅིག་གིས་ཀྱང་བསྐྱེད་བྱ་ཡིན་ལ།",
    "སྤྱི་བློ་སྐྱེད་པ་ཡིས་སྤྱི་བློས་དངོས་སུ་འཛིན་པ་མེད་པར་སྔ་མ་མ་ངེས་ཏེ་སྔོ་སོགས་རེ་རེ་མེད་ཀྱང་མིག་ཤེས་སྐྱེ་ཡང་ཁ་དོག་ཚོགས་པ་ནུས་མེད་མིན་པ་བཞིན་ཐལ་ལོ།",
    "ཚོགས་པ་དང་རེ་རེ་བ་ལ་ཡང་ནུས་པ་གྲུབ་སྟེ།",
    "ཚོགས་པ་དང་རྐྱང་པ་ཇི་ལྟར་ཡིན་ཡང་ནི་སྤྱི་འཛིན་བསྐྱེད་པ་མིན་པར་ཐལ།",
    "དྲུག་པ་གསལ་བ་ལྟོས་ནས་སྤྱིས་བསྐྱེད་པ་མི་འཐད་པ་ལ་བཞིའི་དང་པོ་སྤྱི་བློ་དང་རྒྱུ་འབྲས་སུ་ཐལ་བ་ནིགལ་ཏེ་ཐག་ཟངས་མེད་ན་མི་འཐག་ཀྱང་རེ་རེ་ཙམ་མེད་ཀྱང་རས་ཡུག་འཐག་པ་བཞིན་གསལ་བ་དེ་དག་གང་རུང་གཅིག་ལ་ལྟོས་ནས་སྤྱི་དེས་སྤྱི་བློ་བསྐྱེད་ནུས་ཀྱི་གསལ་བ་ཡེ་མེད་ཀྱི་སྤྱི་འབའ་ཞིག་གིས་མིན་ནོ་ཞེ་ནཕན་མི་འདོགས་པ་ལ་ལྟོས་པར་མི་རུང་བའི་ཕྱིར་ན།",
    "སྤྱི་བློའི་རྒྱུ་གཅིག་པོ་དེ་ལ་ཕན་འདོགས་པར་ཐལ་ལ།",
    "འདོད་ན་ཇི་ལྟར་སྤྱི་བློ་གཅིག་ལ་ཕན་པ་མིན་ཏེ་ཡིན་པར་ཐལ།",
    "དེ་ལྟར་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་ངོ་བོ་གཟུང་བྱའི་ཕྱིར་གསལ་བ་རྣམས་ལ་མཚུངས་པའོ་སྙམ་དུ་འཛིན་པར་འགྱུར་ཞེ་ན།",
    "སྤྱི་གཅིག་དང་གསལ་བ་ཐ་དད་པ་གཉིས་འཛིན་པའི་རྒྱུས་གསལ་བ་རྣམས་མཚུངས་པར་འཛིན་པ་མ་ཡིན་པར་ཐལ།",
    "གསལ་བ་དུ་མས་འབྲས་གཅིག་མི་བྱེད་པར་ཐལ།",
    "དེ་དག་གི་འབྲས་བུ་བློ་སོགས་དེ་ཡང་ཐ་དད་པའི་ཕྱིར་ཞེ་ན།"
  ]
}