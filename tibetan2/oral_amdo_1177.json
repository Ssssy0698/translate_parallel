    "ཁ་སང་གི་བྱེད་ནུས་གསར་པ་ཅན་གྱི་སྐར་དེ་ཁ་ཕྱོགས་འགྱུར་བ་ལས་བྱུང་བ་ཞིག་ཡིན།",
    "ལརིང་གི་རྣམ་འགྱུརཁ་སང་སྐད་ཟླ་བ།",
    "ཐ་དད་བྱ་གི་ཟླ་བ་འཕྱུང་གསར་ཟླ་བ།",
    "ཁྱོགས་འགྱུར།",
    "གི་ཟླ་པ།",
    "ང་ཚོ་ལ་མཇུག་བསྡོམས་འདི་ལྟ་བུ་ཞིག་བྱེད་པའི་གདེང་ཚོད་ཡོད་དེ།",
    "ཟླ་བའི་གོ་ལའི་གནས་སྟངས་དེ་གོང་གསལ་འདི་གཉིས་མ་གཏོགས་ཡོང་སྲིད་ཀྱི་མ་རེད་ལ།",
    "ད་ལྟའི་ཟླ་བ་འདི་ཉིད་འདི་གཉིས་གང་རུང་ཞིག་ཡིན་པ་གཏན་འཁེལ་བ་ཞིག་རེད།",
    "གཅིག་གྲོགས་གཅིག་གིས་བྱེད་ཚུལ་གྱི་སྐར་མའི་རིགས་པའི་གཞུང་ལུགས་ལ་དབྱེ་ཞིབ་བྱས་པ་དང་དོན་དངོས་ཀྱི་དཔྱད་གཞི་དང་།",
    "ཟླ་བའི་ཐོག་གི་ཕལ་པའི་སླ་གཟུགས་དེ་མར་འགྲིབ་ཅིང་ཉུང་དུ་འགྲོ་བའི་གནས་སྐབས་ཡིན་ན།",
    "དག་ད་ནི་ང་ཚོས་གཤམ་གསལ་ལྟར་ཕྱོགས་བསྡོམས་བྱེད་ཆོག་སྟེ།",
    "དེའི་འབྱུང་ཁུངས་ནི་ཁ་སང་གི་གཙོ་བོ་སླ་གཟུགས་དང་ཕལ་པ་མཁྲེགས་གཟུགས་ཅན་གྱི་སྐར་རྙིང་པ་དཔེར་ན་སའི་གོ་ལའི་རིགས་ཀྱི་སྐར་གཟུགས་དེ་རྣམ་པ་གྱུར་པ་ལས་བྱུང་བ་ཞིག་ཡིན།",
    "འདི་ཉིད་མ་འོངས་པ་ན་ངེས་པར་དུ་གཙོ་བོ་མཁྲེགས་གཟུགས་དང་ཕལ་པ་སླ་གཟུགས་ཅན་གྱི་སྐར་རྙིང་པ་ཉམས་རྒུད་ཅན་གྱི་ཟླ་བའི་གོ་ལ་ལ་འགྱུར་འགྲོ་གི་རེད།",
    "དེའི་འབྱུང་ཁུངས་ནི་ཁ་སང་གི་ཕལ་པ་སླ་གཟུགས་དང་གཙོ་བོ་མཁྲེགས་གཟུགས་ཅན་གྱི་སྐར་གསར་པ་གསར་དུ་སྐྱེས་པའི་ཟླ་བའི་གོ་ལ་དེ་ཁ་ཕྱོགས་གྱུར་པ་ལས་བྱུང་བ་ཞིག་ཡིན་ཞིང་།",
    "དེའི་མ་འོངས་པའི་འགྲོ་ཁུངས་ནི་རྣམ་པ་གྱུར་པ་ལས་བྱུང་བའི་སང་ཉིན་གྱི་ཕལ་པ་མཁྲེགས་གཟུགས་དང་གཙོ་བོ་སླ་གཟུགས་ཅན་གྱི་སྐར་སའི་གོ་ལའི་རིགས་ཀྱི་སྐར་གཟུགས་ལ་འགྱུར་འགྲོ་གི་ཡོད་པ་རེད།",
    "ད་ལྟའི་ཟླ་བའི་གོ་ལ་འདི་ཉིད་གསར་རྙིང་གང་གི་ཁོངས་སུ་གཏོགས་པ་ཞིག་ཡིན་ཡང་།",
    "ང་ཚོས་འདིར་མཐའ་གཉིས་གང་རུང་གི་ཐ་དད་བྱའི་རང་བཞིན་ཅན་གྱི་གྲང་འབྲས་མཁྲེགས་གཟུགས་དེ།",
    "སླ་གཟུགས་དང་མཁྲེགས་གཟུགས་གཉིས་ཀྱི་བར་ན་རང་བཞིན་ནང་གི་འབྲེལ་བ་གྲུབ་པ་མ་ཟད།",
    "མཐའི་རང་བཞིན་ཅན་གྱི་རླངས་གཟུགས་དེའང་དབུས་ཀྱི་རང་བཞིན་ཅན་གྱི་སླ་གཟུགས་ལའང་འགྱུར་ཆོག་པ་ལྟར་རེད།",
    "དེར་བརྟེན་ང་ཚོས་ཟླ་བའི་གོ་ལ་སྟེ་སྐར་འདི་ཉིད་ཀྱི་སྐོར་ལ་བགྲོ་གླེང་བྱེད་པའི་སྐབས་སུ།",
    "རང་རང་གི་གཙོ་གཟུགས་ནང་དུ་ཕྱོཔས་གཞན་གྱི་ཕལ་པའི་གཟུགས་འདྲེས་ཡོད་པ་ཞིག་རེད་ལ།",
    "དེ་དག་གཙོ་ཐལ་ཕན་ཚུན་འཕེལ་འགྲིབ་ཀྱི་ཁ་ཕྱོགས་འགྱུར་བ་དང་།",
    "དེ་ལ་སླ་གཟུགས་གྲང་མོ་གནས་ཡོད་པ་གཏན་འཁེལ་ཡིན་པ་ནི་ཐེ་ཚོམ་དང་བྲལ་བྲལ་བ་ཞིག་ཡིན་པ་ནི།",
    "དེ་ཡང་གཙོ་བོ་མཁྲེགས་གཟུགས་ཀྱི་ཕྱི་ཀོག་གི་གནས་གང་ཡང་རུང་བ་ཞིག་གི་གཏིང་ཟབ་ས་ཞིག་ས་འོག་གི་མཚོ་དང་གཙང་པོ་གམ།",
    "ཕལ་མང་གཙོ་ཉུང་གི་སྐབས་སུ་སླེབས་པ་ཞིག་ཡིན་ན།",
    "ཕལ་པའི་སླ་གཟུགས་དང་གཙོ་བོའི་མཁྲེགས་གཟུགས་གཉིས་ཕན་ཚུན་འདི་དང་དེ་མཚུངས་ཀྱི་མང་ཉུང་གི་ཁྱད་པར་ཧ་ཅང་ཕྲ་བའི་ནང་དུ་སླེབས་ཡོད་པས།",
    "དེའི་སྐབས་སུ་ཟླ་བའི་གོ་ལའི་ནང་གི་སླ་གཟུགས་དེ་ཅུང་ཟད་མཐོང་སླ་བ་ཡོད་པ་རེད།",
    "སླ་གཟུགས་དང་མཁྲེགས་གཟུགས་གཉིས་མང་ཆེ་བར་འདི་ཡིན་དེ་མིན་གྱི་ཧེ་བག་ཡོད་རྐྱང་གི་ཚད་གཞིའི་ནང་དུ་སླེབས་ཡོད་པས།",
    "དེའི་སྐབས་སུ་ཟླ་བའི་གོ་ལའི་ནང་གི་སླ་གཟུགས་དེ་ཅུང་ཟད་མཐོང་དཀའ་བ་ཞིག་རེད།",
    "གཙོ་མང་ཕལ་ཉུང་གི་སྐབས་སུ་སླེབས་ཡོད་པ་ཞིག་ཡིན་ན།",
    "སྐབས་འདིར་ཟླ་བའི་གོ་ལའི་ནང་གི་སླ་གཟུགས་དེ་ཧ་ཅང་མཐོང་དཀའ་བ་ཞིག་ཆགས་ཡོད།",
    "སྐབས་དེར་ཟླ་བའི་གོ་ལ་ཐོག་གི་སླ་གཟུགས་དེ་ཧ་ཅང་མཐོང་སླ་བ་ཞིག་ཆགས་ཡོད།",
    "ཟླ་བའི་གོ་ལའི་ཕལ་པའི་སླ་གཟུགས་དེ་ཧ་ཅང་མཐོང་དཀའ་བུ་ཞིག་ཆགས་ཡོད་པ་རེད།",
    "དེར་བརྟེན་ཟླ་བའི་གོ་ལའི་ཕལ་པའི་སླ་གཟུགས་དེ་ཧ་ཅང་མཐོང་སྐུ་བ་ཞིག་ཆགས་ཡོད་པ་རེད།",
    "ཟླ་བའི་གོ་ལའི་ཕལ་པའི་སླ་གཟུགས་དང་གཙོ་བོའི་མཁྲེགས་གཟུགས་གཉིས་ཀྱི་བར་ཕན་ཚུན་མང་ཉུང་གི་ཁྱད་པར་ཞིག་ཡིན་པ་ལས།",
    "ཟླ་བའི་གོ་ལའི་གནས་སྟངས་ལ་དབྱེ་ཞིབ་ཀྱི་སྐོར་རེ་ཞིག་རྫོགས་སོ།",
    "ང་ཚོས་ཟླ་བའི་གོ་ལ་སྟེ་སྐར་འདི་ནི།",
    "ང་ཚོས་ཉི་མ་དང་།",
    "ང་ཚོས་ཟླ་བའི་གོ་ལའི་གྲུབ་ཚུལ་གྱི་སྐོར་ལ་གོང་གསལ་ལྟར་རྩོད་སྒྲུབ་ཀྱི་གཏན་ཚིགས་རིགས་པའི་གཞུང་ལུགས་ཀྱི་སྒོ་ནས་དབྱེ་ཞིབ་བྱས་ཡོད་ཅིང་།",
    "འགྲོ་བ་མིའི་རིགས་སའི་གོ་ལ་འདས་གྱེས་ཏེ་ཟླ་བའི་ཐོག་ཏུ་འགྲོ་མཁན་དང་པོ་དེ་རང་གི་མི་རིགས་དེ་གཏོང་ཐུབ་པར་བྱུང་བ་རེད།",
    "སྤྱི་ལོ་ལོར་ཨ་མེ་རི་ཀའི་ཨང་རྟགས་པའི་ཨ་པོ་ལོ།",
    "ཟླ་བའི་གོ་ལའི་གྲུབ་ཚུལ་དང་སྐབས་སོ་སོའི་རྣམ་པ་འགྱུར་བའི་གོ་རིམ་བཅས་ལ་ཕྱོགས་འཐུས་ཀྱིས་ཞིབ་འཇུག་བྱས་ཡོད་པ་རེད།",
    "ཡིན་ནའང་ཟླ་བའི་གོ་ལའི་ནང་གི་བྲག་རྡོ་རྣམས་ཆ་སྙོམས་བྱས་ན་ལོ་ངོ་དུང་ཕྱུར་ནས་ཡི་བར་ཕྱིན་ཡོད་པ་ར་སྤྲོད་བྱེད་ཐུབ་ཀྱི་ཡོད་ལ།",
    "སའི་གོ་ལའི་ཐོག་ཏུ་རྙེད་པའི་ཆེས་གནའ་བོའི་དུས་ཀྱི་བྲག་རྡོ་རྣམས་ཀྱང་ལོ་ངོ་དུང་ཕྱུར་ལས་ཕྱིན་ཡོད་པ་མ་རེད།",
    "ཟླ་བའི་གོ་ལའི་གྲུབ་ཆའི་ཕྱོགས་ཧ་ཅང་ཆེན་པོ་ཞིག་གི་དངོས་པོ་དང་སའི་གོ་ལའི་གྲུབ་ཆའི་ས་རིམ་བར་མའི་དངོས་པོ་དེ་གཉིས་ཧ་ཅང་འདྲ་པོ་ཡོད་ཅིང་།",
    "དེའང་དངོས་པོ་འདི་དག་སའི་གོ་ལའི་ནང་དུ་གྲུབ་པའི་སྐབས་སུ་གནོན་ཤུགས་མཐར་སོན་པའི་རྗེས་སུ་གྲུབ་ཡོང་གི་ཡོད་པ་རེད།",
    "ཚན་རིག་ཞིབ་འཇུག་པ་རྣམས་ཀྱིས་ཚོད་ལྟ་དེས་སྔོན་གྱི་ཚན་རིག་ཞིབ་འཇུག་པ་འགའ་ཞིག་གིས་ཟླ་བའི་གོ་ལ་འདི་ཉིད་ཀྱི་ཡོང་ཁུངས་ནི།",
    "ང་ཚོས་རྩོད་སྒྲུབ་ཀྱི་གཏན་ཚིགས་རིགས་པའི་སྤྱི་འགྲོས་ཀྱི་སྒོ་ནས་དབྱེ་ཞིབ་བྱས་རྗེས།",
    "ཚན་རིག་པ་རྣམས་ཀྱིས་ཞིབ་འཇུག་བྱས་པའི་ཐོག་མའི་འབྲས་བུ་ལས་སྒྲུབ་བྱེད་འདི་ཉིད་ཡང་དག་ཡིན་པའི་བདེན་དཔང་ཡང་ཡང་བྱེད་ཡོང་གི་ཡོད་པ་རེད།",
    "ལྷག་པར་དུ་ཟླ་བའི་གོ་ལའི་གྲུབ་ཆའི་ཆེ་ཤོས་ཁག་གཅིག་གི་དངོས་པོ་དེ་དེ་བས་ཀྱང་ཁུངས་ལྡན་དུ་ཕྱིན་ཡོད་པ་དང་།",
    "ང་ཚོས་ཟླ་བའི་གོ་ལའི་གཟུགས་ཀྱི་གཙོ་བོ་སྟེ་རྒྱ་ཆེ་ཤོས་མཁྲེགས་གཟུགས་ཡིན་པའི་སྐོར་གྱི་སྒྲུབ་བྱེད་དེ་ཡང་དག་པ་ཞིག་ཏུ་གྱུར་ཡོད།",
    "ད་ནི་ང་ཚོས་ཧུར་ཧྲུས་བརྩམས་པའི་ང་ཚོ་ཟླ་བའི་གོ་ལའི་ནང་དུ་སླེབས་པ་ཞེས་པའི་ནང་གི་ལུང་དུམ་བུ་ཞིག་དྲངས་བར།",
    "༥ འགྲོ་བ་མིའི་རིགས་ཀྱིས་ནམ་ཞིག་ན་ཟླ་བའི་གོ་ལ་འདི་ཉིད་མ་ཐ་ཡང་ལྷིང་འཇགས་ཀྱི་རྒྱ་མཚོ་རྒྱུ་ཆ་གང་གིས་གྲུབ་ཡོད་པ་ཞིབ་འཇུག་བྱེད་ཐུབ་ཀྱི་རེད།",
    "སའི་གོ་ལ་དང་ཟླ་བའི་གོ་ལ་གཉིས་ལ་ཕལ་ཆེར་ཐུན་མོང་གི་བརྒྱུད་རྒྱུ་ཞིག་ཡོད་པ་རེད།",
    "སའི་གོ་ལ་དང་ཟླ་བའི་གོ་ལ་གཉིས་ཀྱི་འབྲེལ་བ་དེ་བུ་མོ་སྤུན་ནང་བཞིན་གྱི་འབྲེལ་བ་ཞིག་ཡིན་པ་ལས་མ་བུ་ལྟ་བུའི་འབྲེལ་བ་ཞིག་མིན་ཞེས་དང་།",
    "ཟླ་བའི་གོ་ལ་ནི་སའི་གོ་ལ་ནང་བཞིན་ཕྱི་ངོས་ན་སྲ་མཁྲེགས་ཅན་གྱི་ཀོག་པ་ཡོད་པ་དང་ཞུན་མའམ་ཆ་ཤས་ཞུན་མའི་ནང་ཆ་ཡོད་པ་ཞིག་རེད།",
    "ས་གཡོའི་རླབས་ཕྲེང་གི་འབྱུང་ཁུངས་གང་ཡིན་ཀྱང་འདྲ།",
    "ས་གཡོ་རླབས་ཕྲེང་དེས་ཟླ་བའི་གོ་ལའི་ཟིན་བྲིས་བརྒྱུད་ནས་ཕལ་ཆེར་ཟླ་བའི་གོ་ལ་དེ་ཉིད་སྔོན་ཚན་རིག་པ་རྣམས་ཀྱིས་བསམ་ཚུལ་ལས་ཀྱང་སའི་གོ་ལ་དང་འདྲ་ཆེ་བ་ཞིག་ཡིན་པ་བདེན་དཔང་བྱས་ཡོད་པ་རེད།",
    "ཨ་མེ་རི་ཀའི་ཟླ་བའི་གོ་ལའི་གསོབ་དཔེ་ཚོད་ལྟ་ཁང་གི་ཚན་རིག་པ་རྣམས་ཀྱིས་ཐེངས་དང་པོ་ཟླ་བའི་གོ་ལའི་ཐོག་ནས་ཁྱེར་ཡོང་བའི་རིན་ཐང་ལྡན་པའི་རྡོའི་དུམ་བུ་དེ་དག་ལས་གོང་གསལ་གྱི་ཐོག་མའི་མཇུག་བསྡོམས་འདི་ཐོབ་ཡོད་ཅིང་།",
    "རིན་ཐང་ཧ་ཅང་ཆེན་པོ་ལྡན་པའི་དཔྱད་གཞི་ཞིག་རེད།",
    "སའི་གོ་ལ་དང་ཟླ་བའི་གོ་ལ་གཉིས་ཀྱི་བར་ལ་ཅི་ཕྱིར་ཐུན་མོང་གི་བརྒྱུད་རྒྱུ་ཞིག་ཡོད་པ་དང་།",
    "འདི་གཉིས་པོ་བུ་མོ་སྤུན་ལྟ་བུའི་སྐར་མའི་གོ་ལ་གྲུབ་བྱེད་དངོས་རྫས་ཀྱི་རྩ་བའི་རྣམ་པ་དེ།",
    "འདི་ནི་མིག་དམར་དང་ཉི་མའི་དངོས་རྗེས་གྲུབ་ཚུལ་དང་རྦད་དེ་ཐ་དད་དུ་གྱུར་པ་ཞིག་རེད།",
    "གཞི་གཅིག་པའི་རང་བཞིན་ཅན་གྱི་སླ་གཟུགས་ཚ་མོ་གཉིས་ཀྱིས་གྲུབ་པ་རྣམས་ཏེ།",
    "གོང་གསལ་ཚན་རིག་པ་རྣམས་ཀྱིས་ཟླ་བའི་གོ་ལ་དང་སའི་གོ་ལ་གཉིས་ལ་ཐུན་མོང་གི་རང་བཞིན་ཡོད་པར་སྒྲུབ་བྱེད་བཀོད་པ་འདི་དག་དོན་དངོས་ལ་ང་ཚོས་འབྲེལ་ཡོད་ཀྱི་ཟླ་བའི་གོ་ལའི་གནས་སྟངས་གྱི་སྐོར་ཏེ།",
    "ང་ཚོས་སླར་ཡང་ང་ཚོ་ཟླ་བའི་གོ་ལའི་ནང་དུ་སླེབས་པ་ཞེས་པའི་དེབ་དེའི་ནང་གི་ལུང་ཞིག་དྲངས་པ་ལ།",
    "ཟླ་བའི་ཐོག་ལ་ཞེས་པའི་དུམ་བུ་ཞིག་བྲིས་འདུག་པ་འདི་ཡིས་ང་ཚོས་ཟླ་བའི་གོ་ལའི་གནས་སྟངས་ལ་རྩོད་སྒྲུབ་ཀྱི་གཏན་ཚིགས་རིགས་པས་དབྱེ་ཞིབ་བྱེད་པ་ལ་རིན་ཐང་ཧ་ཅང་ཆེན་པོ་ལྡན་པའི་དཔྱད་གཞི་ཨང་དང་པོ་ཞིག་མཁོ་འདོན་བྱས་ཡོད་པ་རེད།",
    "ག་ས་ག་ལ་ས་དོང་གིས་གང་བའི་ངོས་ན།",
    "བྱང་ཐང་སྐྱ་མོའི་ཐང་ཆེན་ཞིག་གི་ཐོག་ན་ས་དོང་རྒྱ་ཆེ་ཆུང་ཁྲི་ཙེ་ལྔ་ནས་ལྔ་བཅུའི་བར་གྱི་ཆེ་ཆུང་མ་ངེས་སྣ་ཚོགས་པ་མང་པོ་ཞིག་ག་ས་ག་ལ་ཁྱབ་འདུག་རི་གདོང་ཡང་མང་པོ་ཞིག་འདུག་པ་དེ་དག་ཧ་ཅང་དམའ་ཞིང་ཆུང་བར་འདུག་ཞིང་།",
    "དེའི་ཉེ་སྐོར་གྱི་ས་ཕྱོགས་དག་ན་རྒྱ་ཆེ་ཆུང་ཁྲི་ཙེ་གང་དོ་ཙམ་ཡོད་པའི་ས་དོང་སྟོང་ཕྲག་ཁ་ཤས་འདུག་ང་ཚོའི་མདུན་ཕྱོགས་ཀྱི་ཁྲི་ཙེ་དོ་ཙམ་འདུག་མཐའ་རྣམས་ལ་ཟུར་རིས་འདུག་རི་ཞིག་མཐོང་ཐུབ་ཞིང་འདུག་པ་དེ་ནི་ང་ཚོའི་མདུན་གྱི་བབས་ཡུལ་དང་ཉེ་ས་ཞིག་ན་འདུག་ཟླ་བའི་ས་གཞིའི་ངོས་ཀྱི་ཁ་དོག་ནི་ཕལ་ཆེར་ཁ་དོག་གང་ཡང་མི་འདུག་ཐིག་གནས་ཀྱི་སྐུད་པའི་ངོས་ནས་ལྟ་དཔྱད་བྱེད་དུས་ཁ་དོག་སྐྱ་བོ་དང་།",
    "འདི་དག་ཐམས་ཅད་ཧ་ཅང་འོད་ཆེན་པོ་ཆགས་འདུག་རྡོ་དུམ་བུ་མང་པོ་ཞིག་གི་ལུས་ཡོངས་ལ་ཁུང་བུས་གང་འདུག་དེའི་དུམ་བུ་ཁ་ཤས་ཤིག་ནི་ལྷང་ཚེར་ནག་པོ་དང་འདྲ་པོར་འདུག་ཕྱི་ངོས་ན་ཕྱེ་མ་ཞིབ་མོ་སྣང་།",
    "ཁོང་ཚོ་སའི་གོ་ལའི་ཐོག་གི་ཕྱོགས་གང་རུང་ཞིག་གི་ས་རྒོད་རི་སྟོང་གི་བྱེ་ཐང་ཞིག་གི་ཐོག་ཏུ་ཡོད་པ་འདྲ་པོ་ཞིག་ལས།",
    "ཟླ་བའི་གོ་ལའི་ཐོག་ཏུ་ཡོད་པ་འདྲ་པོ་ཞིག་མི་འདུག་དེ་ཡང་ང་ཚོས་མཚན་ཉིད་རིགས་པའི་གཞུང་ལུགས་ཀྱི་ངོས་ནས་ཟླ་བའི་གོ་ལའི་གནས་སྟངས་དེར་གོ་བ་བླངས་ན།",
    "མཐར་གཞུག་ང་ཚོས་ཟླ་བའི་གོ་ལ་འདི་ཉིད་ཕལ་ཆེར་གཙོ་བོ་མཁྲེགས་གཟུགས་དང་ཕལ་པ་སླ་གཟུགས་ཅན་གྱི་གཙོ་ཕལ་ཕན་ཚུན་འབྲེལ་བ་ཞིག་ཡིན་པ་ཁ་ཆོན་གཅོད་པའི་རྗེས་སུ།",
    "འདི་ནི་ཚན་རིག་པ་རྣམས་ཀྱིས་འདོད་པའི་སའི་གོ་ལ་དང་ཟླ་བའི་གོ་ལ་གཉིས་ལ་ཐུན་མོང་གི་བརྒྱུད་རྒྱུ་ཡོད་པ་དང་།",
    "ད་རུང་ཡང་ང་ཚོས་མུ་མཐུད་ནས་དེབ་དེའི་ལུང་དྲངས་ན།",
    "མི་རྣམས་ཧ་ཅང་ཡ་མཚན་དགོས་པའི་གནས་གསར་ཞིག་རེད།",
    "སའི་ཕྱི་ཀོག་དེ་སྔོག་པ་ལ་ཅུང་ཟད་དཀའ་མོ་ཡོད་ཚོད་འདུག་འདིར་ཧ་ཅང་ཡ་མཚན་པ་ཞིག་ལ།",
    "འདིའི་ཕྱི་ངོས་ཧ་ཅང་སྙི་མོ་ཞིག་ཡིན་ཀྱང་དཔེ་དངོས་འཕྲལ་སྒྲུབ་བསྡུ་ལེན་འཕྲུལ་ཆས་སྔོག་འདོན་བྱེད་པའི་སྐབས་སུ་ཧ་ཅང་སྲ་མཁྲེགས་ཅན་གྱི་ངོས་ཤིག་དང་ཐུག་སོང་།",
    "ངས་ཅུང་ཟད་གཏིང་ཟབ་ས་ཞིག་གི་དངོས་པོ་ཕྱིར་ལེན་བའི་ཆེད་དུ་ནང་སྟོང་པ་ཅན་གྱི་སྦུ་གུ་དེ་ཐོ་བས་བརྡུང་སྟེ་ནང་དུ་བཅུག་པས།",
    "ཕྲུ་གུ་དེ་དྲང་པོ་བྱ་སྟེ་འགྲོ་ཐུབ་མ་སོང་།",
    "དེ་མར་ཟུག་འགྲོ་ཞིང་འདུག་ཡིན་ནའང་དྲང་པོར་ཟུག་ཐུབ་ཀྱི་མི་འདུག་སྦུ་གུའི་ནང་གི་དངོས་པོ་དེའི་ཁ་དོག་གསལ་པོར་འདུག་དེ་སྦུ་གུའི་སྟོང་པའི་ངོས་སུ་འབྱར་འདུག་ངར་དེ་རློན་པ་ཡིན་པའི་སྣང་བ་གསལ་པོ་ཞིག་འཆར་བྱུང་ཞེས་སོགས་གསུངས་པ་ལྟར་རོ།",
    "འདིར་ང་ཚོར་དོ་སྣང་དགོས་པ་ཞིག་དང་ཤེས་འདོད་ཆེ་བ་ཞིག་ནི་ཟླ་བའི་གོ་ལའི་ཐོག་གི་སླ་གཟུགས་དེ་ཉིད་དོན་ངོ་མ་ཟླ་བའི་ཕྱོགས་གང་ཞིག་ལ་ཡོད་པ་དང་།",
    "དེ་ལྟ་བུའི་གཏིང་ཐུང་ས་ཞིག་གི་ས་འོག་ཏུ་འབྱར་བག་ཅན་གྱི་དངོས་པོ་ཡོད་པ་དང་།",
    "སྣང་ཚུལ་དེ་ནི་ཧ་ཅང་ཡག་པོ་ཞིག་རེད་ཅེས་ཟེར་ཆོག།",
    "དེ་བས་ཀྱང་མི་རྣམས་ཧ་ལས་དགོས་པའི་ཆུའི་སྐོར་གྱི་དཔྱད་གཞི་མཐོང་ཐུབ་པ་ཞིག་ཡོང་གི་མ་རེད་པས།",
    "ཟླ་བའི་གོ་ལའི་ཐོག་ཏུ་ཐེངས་དང་པོའི་ཆ་དོང་ཞིག་བརྐོ་རྒྱུའི་བསམ་བློ་འཁོར་གྱི་མ་རེད་པས།",
    "ཟླ་བའི་གོ་ལའི་གནམ་ཐིག་དམར་པོའི་འཕྲེད་ཐིག་གི་ཕྱོགས་ན་ཁོད་སྙོམས་པོའི་ས་ཕྱོགས་ཁག་ལྔ་བདམས་ནས།",
    "དེའི་ཕྱོགས་གཅིག་གི་མིང་ལ།",
    "དེ་ནི་འཇིག་རྟེན་བསྐོར་བསྐྱོད་པ་རྣམས་ཟླ་བའི་ཐོག་ཏུ་འཛེགས་ཏེ་མར་བབས་སར་བདམས་ཡོད་པ་རེད།",
    "སའི་འོག་རིམ་གྱི་མཐོ་ས་ཞིག་གི་གནས་བ་ན་བར་དུ་རྟག་པར་གནས་ཀྱི་རེད།",
    "ཚན་རིག་གིས་རྙེད་པ་རྣམས་ནི་དུས་རྒྱུན་ང་ཚོའི་རང་སྣང་གི་ཡུལ་ལས་འདས་པ་ཞིག་སྟེ།",
    "མེ་ལྟར་ཚ་བའི་ཧྲ་ཧ་ལའི་བྱེ་ཐང་ཆེན་མོ་ནང་དུ་ལོ་ཧྲིལ་པོར་མེ་ལྟར་ཚ་ཞིང་།",
    "དེའང་ཆར་པ་ཅུང་ཟད་ཙམ་བབས་ནའང་ལམ་སང་མེ་ལྟར་ཚ་བའི་དྲོད་ཚད་ཀྱིས་འཐག་ནས་སྐམ་འགྲོ་ཞིང་ཡོད་པ་རེད།",
    "དེར་བརྟེན་མི་རྣམས་ཀྱིས་དུས་རྟག་ཏུ་གནས་དེའི་སའི་འོག་ཏུ་ཆུའི་འབྱུང་ཁུངས་ཕུན་སུམ་ཚོགས་པོ་ཞིག་མེད་པར་བསམ་ཞིང་ཡོད་པ་རེད།",
    "སའི་འོག་གི་ཆུ་འདི་དག་དམིགས་གསལ་ཀྱི་གནས་ཡུལ་ནི།",
    "གནའ་གདོད་མའི་དུས་ནས་སྲིད་པའི་ས་འོག་གི་ཆུ་ཡིན་ཞིང་།",
    "དེའི་ཕྱོགས་བཞི་ན་ཕལ་ཆེར་ཆུ་ཁ་སྣོན་འཇུག་ས་ཡོད་པ་མ་རེད།",
    "ང་ཚོས་ཟླ་བའི་གོ་ལ་སྟེ་སྐར་འདི་ཉིད་ཀྱི་གནས་སྟངས་དང་འོང་ས་འགྲོ་ཁུངས་བཅས་ཀྱི་སྐོར་ལ་རྩོད་སྒྲུབ་རིགས་པའི་སྒོ་ནས་དབྱེ་ཞིང་བྱས་པ་དང་།",
    "ཐེངས་དང་པོ་དགོས་ངེས་ཀྱི་རིགས་པས་སྒྲུབ་པ་རྣམས་རེ་ཞིག་འདི་རུ་མཇུག་རྫོགས་སོ།",
    "ལྡོག་ཏུ་མེད་པའི་རང་ཉིད་འཕོ་འགྱུར་གྱི་ཁ་ཕྱོགས་བཅས་ལྐོག་གྱུར་གྱི་མཚན་ཉིད་རིག་པའི་ཚན་རིག་དེ་གསལ་བར་སྟོན་བྱེད་ཅིག་རེད།",
    "འཇིག་རྟེན་བསྒྱུར་བཀོད་བྱེད་པར་ནུས་པ་ཁྲི་དང་ལྡན་པའི་ལྡེའུ་མིག་ཅིག་ཡིན་ཞེས་ཁས་ལེན་ཞིང་ཡོད་པ་རེད།",
    "འདི་དང་རང་ཤུགས་ཀྱིས་འབྲེལ་བ་གྲུབ་བའི་མཐའ་གཞན་ཞིག་གི་ཉི་མ་སྟེ་སྐར་གཉིས་བར་གྱི་ཐ་དད་གཞི་གཅིག་པའི་འབྲེལ་བ་ཆགས་ཡོད་པ་དང་།",
    "དབུས་ཀྱི་ཕྱོགས་གཞན་ཞིག་གི་དེའང་ཡང་གཅིག་གི་རེའུ་མིག་སྐར་རིགས་ཀྱི་སའི་གོ་ལ་གཉིས་ཀྱི་བར་གཞི་གཅིག་ཐ་དད་པའི་འབྲེལ་བ་ཆགས་ཡོད་པ་རེད།",
    "ཟླ་བ་ནི་ཕལ་འགྲིབ་ཅིང་གཙོ་འཕེལ་བའི་སྐར་གསར་པ་ཞིག་རེད།",
    "ཕལ་འགྲིབ་ཅིང་གཙོ་འཕེལ་བའི་སྐར་གསར་པ་ཞིག་རེད།",
    "གཅིག་གྲོགས་གཅིག་གིས་བྱེད་པའི་འོག་ཏུ།",
    "ཕལ་འགྲིབ་གཙོ་འཕེལ་མཐར་སོན་པའི་སྐབས་སུ་ཕལ་གཙོ་ཕན་ཚུན་འཕེལ་འགྲིབ་ཀྱི་ཁ་ཕྱོགས་འགྱུར་འགྲོ་ཞིང་ཡོད་པ་རེད།",
    "ཕལ་པ་དང་གཙོ་བོ་གཉིས་འབྲེལ་ནས་གྲུབ་པའི་སྐར་གཟུགས་དེ་གཙོ་ཕལ་འབྲེལ་ནས་གྲུབ་པའི་སྐར་གཟུགས་ལ་འགྱུར་འགྲོ་ཞིང་ཡོད་པ་རེད།",
    "ཞིག་རེད།",
    "ཕལ་འགྲིབ་ཅིང་གཙོ་འཕེལ་བའི་སྐར་གསར་པ་ཞིག་རེད།",
    "ཕལ་པའི་ཐོག་ཏུ་གཞི་གཅིག་གི་རང་བཞིན་སླ་གཟུགས་ཚ་མོ་དང་ཡང་གཅིག་གི་རང་བཞིན་ཡོད་པའི་སླ་གཟུགས་གྲང་མོ་སྐབས་སུ།",
    "གཙོ་བོའི་ཐོག་ཏུ་གཞི་གཅིག་གི་རང་བཞིན་དང་སླ་གཟུགས་ཚ་མོ་ཡང་གཅིག་གི་རང་བཞིན་སླ་གཟུགས་གྲང་མོ་ཡོད་པ་རེད།",
    "མཐར་སོན་པའི་སྐབས་སུ་གཙོ་ཕལ་ཕན་ཚུན་རྣམ་པ་འགྱུར་ཡོང་གི་ཡོད་པ་སྟེ།",
    "གཙོ་ཕལ་སྦྲེལ་བའི་སྐར་གཟུགས་དེ་ཕལ་གཙོ་སྦྲེལ་བའི་སྐར་གཟུགས་ལ་འགྱུར་འགྲོ་ཞིང་ཡོད་པ་རེད།",
    "ཕལ་པའི་ཐོག་ཏུ་གཞི་གཅིག་པའི་རང་བཞིན་དང་ཡང་གཅིག་གི་རང་བཞིན་ཡོད་པ་མཐོང་ཐུབ།",
    "གཙོ་བོའི་ཐོག་ཏུ་གཞི་གཅིག་པའི་རང་བཞིན་དང་ཡང་གཅིག་གི་རང་བཞིན་ཡོད་པའི་སྐབས་སུ།",
    "དེ་དག་གི་གཙོ་བོ་ནི་བལྟོས་འཇོག་གི་སྒོ་ནས་བརྟན་པོར་གནས་ཡོད་པ་ཞིག་དང་།",
    "གོང་དུ་ང་ཚོས་མཐའ་གཉིས་ཀྱི་ཐ་དད་པའི་ནང་དུ་གཞི་གཅིག་པའི་སྐར་ཟླ་བ་དང་སྐར་ཉི་མ་གཉིས་དང་།",
    "དབུས་གཉིས་ཀྱི་གཞི་གཅིག་པའི་ནང་གི་ཐ་དད་པའི་སྐར་གོ་ལ་དང་སྐར་མིག་དམར་སྟེ།",
    "འོན་ཀྱང་མུ་མཐའ་མེད་པའི་མཁའ་དབྱིངས་ན་གྲངས་ལས་འདས་པའི་མཐའ་གཉིས་དང་དབུས་གཉིས་ཀྱི་རིགས་ལས་བྱུང་བའི་སྐར་མ་ཆེ་ཆུང་སྣ་ཚོགས་ཡོད་པ་དེ་དག་ནང་ཕན་ཚུན་གྱི་བར་ན་རྩོད་སྒྲུབ་རིག་པའི་འབྲེལ་བ་གྲུབ་ཡོད་པ་དེ་དག་ལྡོག་ཏུ་མེད་པའི་ཕན་ཚུན་འདྲ་མཚུངས་ཀྱི་ཐ་དད་པ་དང་གཞི་གཅིག་གི་འབྲེལ་བའི་ཆ་རྐྱེན་འོག་ཏུ།",
    "དེ་དག་ཕན་ཚུན་རང་བཞིན་གྱིས་མེད་ན་མི་འབྱུང་གི་འབྲེལ་བ་གྲུབ་ཡོད་པ་རེད།",
    "དེར་བརྟེན་ང་ཚོའི་གོང་གསལ་གྱི་དབྱེ་ཞིབ་བྱས་པ་དེ་ནི།",
    "ཕྱོགས་གཅིག་ནས་བལྟས་ན་མཚན་ཉིད་རིག་པའི་ཚན་རིག་གི་ཚོད་དཔག་ཁོ་ན་ཙམ་ཡིན་ཀྱང་།",
    "ཕྱི་མའི་ཚབ་བྱེད་ཐུབ་ཅིང་ཡོད་པ་མ་རེད།",
    "ཚན་རིག་གི་གོ་དོན་རང་མཚོན་པའི་སྒོ་ནས་སྤྱོད་ཅིང་མེད།",
    "དེར་བརྟེན་སྐར་མའི་གཟུགས་གང་འདྲ་ཞིག་གི་གནས་སྟངས་དེ་ཁོང་དུ་ཆུད་ན།",
    "ཁུངས་ལུང་ག་གེ་མོ་ཞིག་གིས་དེའི་ཡོང་ས་འགྲོ་ཁུངས་བརྟག་དཔྱད་བྱེད་ཆོག་པ་མ་ཟད",
    "ང་ཚོས་ངེས་པར་དུ་ད་ལྟའི་འཇིག་རྟེན་ཁམས་ཀྱི་གནས་ཚུལ་འདི་ཉིད་སྔོན་གྱི་གནས་ཚུལ་གྱི་འབྲས་བུ་དང་།",
    "དེའི་གདོས་བཅས་ཕུང་པོའི་གནས་སོ་སོའི་རང་རང་གི་གྲུབ་ཆ་རྣམས་ཤེས་ཐུབ་ཀྱི་རེད།",
    "ཆེ་བ་སྐར་མའི་གོ་ལ་ནས་ཆུང་བ་རྡུལ་ཕྲན་ཡན་གྱི་བར་ཐམས་ཅད་གཅིག་པར་བྱེད་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "འདས་པའི་དོན་ཇི་བཞིན་ཚང་མ་མཐོང་བ་ཙམ་གྱིས་ཤེས་ཐུབ་ཀྱི་རེད།",
    "སྙན་གྲགས་ཅན་གྱི་ཚན་རིག་པ་མང་པོས་རང་ཉིད་ཀྱི་ཚན་རིག་ཞིབ་འཇུག་གི་ཁོངས་སུ་གྲུབ་འབྲས་ཧ་ཅང་ཆེན་པོ་ཐོབ་ཡོད་པར་ད་ལྟའི་བར་དུ་ཚན་རིག་པ་ཞེས་པའི་སྙན་གྲགས་ཆགས་ཡོད་པ་རེད།",
    "ཡིན་ནའང་བློ་ཕམ་པ་ཞིག་ལ་མི་མང་པོ་ཞིག་གིས་ཚན་རིག་ཞིབ་འཇུག་གི་ཨ་མ་སྟེ།",
    "རང་གི་ཚན་རིག་ཞིབ་འཇུག་གི་ལས་ཀ་ལ་ནམ་ཡིན་ལས་མེད་ལས་ལྷག་བྱེད་པ་དང་།",
    "ཁ་སང་གི་ཡོང་ཁུངས་དང་མ་འོངས་པའི་འགྲོ་ཁུངས་བཅས་ལ་དབྱེ་ཞིབ་དང་བདེན་དཔང་བྱེད་ཐུབ་ཞིང་ཡོད་པ་རེད།",
    "བློཟླསླ་གཟུགས་ཚ་མོ།་",
    "ཟླ་སླ་གཟུགས་གྲང་མོ།",
    "གཅིག་གི་རང་བཞིན།",
    "ཎ་པ་ཐོན་པ་ཡང་གཅིག་གི་རང་བཞིན།",
    "འོད་ཐིག་ཋཏྟཾ་མུན་ནག་གི་རྒྱུ་སྐར།",
    "ཊྛིཊྛ་རྙོག་ནག་གི་རྒྱུ་སྐར།",
    "སི་ཚྭ་སྐྱུར་མོ།",
    "དེ་དག་གིས་སྐུ་ཉིད་ཀྱི་གཞུང་ལུགས་ར་སྤྲོད་བྱེད་པའི་བདེན་དཔང་དེ་བས་མང་བ་ཞིག་བྱེད་ཐུབ་སྙམ།",
    "གང་ཉིད་ཞིབ་འཇུག་གི་ཕྱག་ལས་དེ་སྐུ་གཟུགས་བདེ་ཐང་གི་གནས་ཚུལ་དང་བསྟུན་ནས་རྒྱུན་མཐུད་ཐུབ་པ་དང་།",
    "དེ་ལ་བརྩོན་པའི་ངལ་བས་མི་མནར་བའི་རེ་བ་ཞུ།",
    "མུ་མཐུད་ནས་གང་ཉིད་སྐུ་ངལ་མེད་པའི་སྒོ་ནས་འཚོལ་ཞིབ་གནང་རྒྱུའི་རེ་བ་ཞུ།",
    "ལྷ་ལྕམ་ཡེ་ཧྲུའུ་ཧྭ་ལགས་ནི་ཀྲུང་གོ་ཚན་རིག་ཁང་གི་ཁོངས་མི་དང་།",
    "རང་ཉིད་ཀྱི་བློ་གྲོས་ཀྱི་རྣམ་དཔྱོད་མཐའ་དག་སྟོང་གསུམ་འཇིག་རྟེན་གྱི་ཁམས་དང་དབྱེར་མེད་དུ་བསྲེས་ཏེ་ཟླ་བའི་གོ་ལ་གཙོས་པའི་རྒྱུ་སྐར་ཐམས་ཅད་ཀྱི་ནང་དུ་སླ་གཟུགས་ཡོད་པའི་ཐུན་མོང་མ་ཡིན་པའི་ཆོད་གཏམ་སྔ་ན་མེད་པ་ཞིག་གནང་འདུག་ཆོད་གཏམ་འདི་ནི་གནའ་མི་རྒན་པོས་མ་རྟོགས་ཤིང་།",
    "དེང་རབས་མི་ཡང་ཉམས་མཚར་སྐྱེ་འོས་ཤིག་རེད།",
    "གངས་རིའི་ར་བས་བསྐོར་བའི་ལྗོངས་སུ་སྐྱེས་པའི་བོད་མི་ཞིག་གི་ངོས་ནས་མཚོན་ན་གང་ཉིད་ཀྱི་གཟི་བརྗིད་ཅིག་ཡིན་པ་མ་ཟད།",
    "ཉིད་ཀྱི་གྲོགས་པོ་བློས་ཐུབ་ཅིག་ཡིན་པའི་ཆ་ནས་ངའི་གཟི་བརྗིད་ཅིག་ཀྱང་རེད་ལ།",
    "གངས་ཅན་བོད་མི་ཡོངས་ཀྱི་གཟི་བརྗིད་ཅིག་ཀྱང་རེད།",
    "ཁྱད་པར་དུ་བསྟན་བཅོས་འདིའི་ནང་དུ་བསྟན་པའི་རིག་ལམ་འདི་དག་དར་སྤེལ་དང་རྒྱུན་འཛིན་བྱེད་ཐུབ་པ་ཞིག་བྱུང་ན་ང་ཚོའི་མི་རིགས་འདིའི་རིན་ཐང་ཇེ་ཆེར་འགྲོ་བར་ངེས།",
    "བོད་རིགས་གསར་བརྗེ་པ་དང་མཚན་ཉིད་རིག་པ་བ་ཞིག་གི་ཚན་རིག་འཆར་སྒོ།",
    "མུ་མཐའ་མེད་པའི་བར་སྣང་གི་དབྱིངས་སུ་བསྐྱོད་ནས།",
    "བསམ་དུ་མེད་པའི་སླ་གཟུགས་དང་གངས་འཁྱགས་ཀྱི་ཕུང་པོ་ཡོད་པར་རྟོགས་པ་དེ་ནི་སོ་སྐྱེའི་བློ་ཡུལ་ལས་འདས་པ་ཞིག་རེད།",
    "རང་ཉིད་སྡུག་བསྔལ་སྣ་ཚོགས་ཀྱིས་གཙེས་བཞིན་པའི་མྱོང་ཚོར་དེ་དག་ཚིག་འབྲུ་གཅིག་ཀྱང་མི་ཐོན་པར་ངོ་ཚར།",
    "མིའི་རིགས་ཀྱིས་ཟླ་བའི་གོ་ལའི་ཐོག་གི་ཕུན་སུམ་ཚོགས་པའི་གཏེར་ཀ་སྔོག་འདོན་བཟོ་བའི་རེ་བ་དོན་དངོས་སུ་སྨིན་ཐུབ་བམ་མི་ཐུབ།",
    "སྔོག་འདོན་ཉིན་མོ་འཆར་བར་ངེས།",
    "ཡིན་ན་ཡང་མི་མང་ཆེ་བས་དེ་ནི་འགྲུབ་རེ་མེད་པའི་གླེན་གཏམ་ཡིན་པར་བསམས་པ་རེད།",
    "གང་ལགས་ཤེ་ན་ཟླ་བའི་གོ་ལའི་ཐོག་མིའི་ལུས་གཟུགས་རྒྱུན་ལྡན་བཞིན་འཚོ་སྲུང་བྱེད་པའི་ཆུ་ཡོད་མི་སྲིད་པ་ཞིག་རེད།",
    "ལོའི་ཟི་ཁྲོན་ཚན་རྩལ་པར་སྐྲུན་ཁང་གིས་ཟླ་བའི་གོ་ལའི་ཐོག་སླ་གཟུགས་ཡོད་པ་ཞེས་པའི་མཚན་ཉིད་རིག་པའི་ཆེད་རྩོམ་ཞིག་པར་སྐྲུན་བྱས་པ་རེད།",
    "མ་ཚད་ཟླ་བའི་གོ་ལའི་ས་འོག་གི་གདིང་ངེས་ཅན་དུ་སླ་གཟུགས་ས་འོག་གི་ཆུའམ་རྒྱ་མཚོ་ཡོད་སྲིད་པ་རེད་བསམ་གྱི་ཡོད་པ་རེད།",
    "ཟླ་བའི་གོ་ལར་འཚོལ་ཞིབ་ཚད་ལེན་འཕྲུལ་ཆས་ཁེ་ལི་མིས་ཐང་རྟགས་ཅན་གྱིས་ལོའི་ཟླ་པ་ནས་འགོ་ཚུགས་འཇིག་རྟེན་བསྐོར་ཏེ་འཕུར་བ་བརྒྱུད་ཟླ་བའི་གོ་ལའི་ལྷོ་མཐའ་རུ་འཁྱག་རིམ་ཡོད་པ་མཐོང་བ་རེད།",
    "ཟླ་བའི་གོ་ལའི་ཐོག་འཐེན་ཤུགས་ཆུང་བ་དང་ནང་དུ་གཏེར་ཁ་ཕུན་སུམ་ཚོགས་པ་དང་མ་ཚད་ཆུའི་འབྱུང་ཁུངས་འདང་ངེས་ཡོད་པར་བརྟེན་ལོ་བརྒྱ་ཕྲག་ཁ་ཤས་ཀྱི་རྗེས་སུ་ཟླ་བའི་གོ་ལ་ནི་ཉི་མའི་ཁྱིམ་རྒྱུད་ནང་གི་བཟོ་ལས་ལྟེ་བར་འགྱུར་ངེས་རེད་ཅེས་ཚན་རིག་པས་ལུང་བསྟན་གནང་གི་ཡོད་པ་རེད།",
    "དགེ་མཚན་དེ་དག་ལྡན་པར་བརྟེན་དེབ་འདིར་རྒྱལ་ཁབ་ཕྱི་ནང་གི་ཆེད་རམས་པ་དང་མཁས་པ་མང་པོས་མཐོང་ཆེན་གནང་སྟེ་རྒྱལ་ཁབ་ཁག་ཅིག་གིས་བསྒྱུར་ནས་པར་བསྐྲུན་བཟོ་གྲབས་ཡོད་ཅིང་ཁག་ཅིག་གིས་རྩོམ་པ་པོ་ཁོང་གདན་འདྲེན་ཞུ་བཞིན་ཡོད།",
    "གལ་སྲིད་ཚན་རིག་ཞིབ་འཇུག་གི་སྒོ་ནས་དེ་བས་གསལ་བ་ཞིག་བདེན་དཔང་བྱེད་ཐུབ་པ་བྱུང་ན།",
    "གཞིས་ཆགས་ཆོག་རྒྱུའི་རེ་བ་སྔར་ལས་ཆེ་བར་ཕྱིན་པ་རེད།",
    "ཨེ་ཐེ་ཁོང་གི་གཤོང་སའི་འོག་ཕྱོགས་སུ་ཡོད་པ་རེད་གསུངས་འདུག་ཨེ་ཐེ་ཁེང་གི་ཚངས་ཐིག་ལ་ཕལ་ཟེར་སྤྱི་ལེ་ཙམ་ཡོད་པ་དང་།",
    "དེ་ནི་ད་ཕན་ཉེ་མའི་ཁྱིམ་རྒྱུད་ནང་དུ་རྙེད་པའི་སྐར་རྡོའི་ཤུལ་དོང་གཏིང་ཟབ་ཤོས་ཤིག་རེད།",
    "སྐར་རྡོའི་འོག་གི་གྲང་གནས་དེར་གནས་པ་ལ།",
    "གོང་གསལ་གྱི་འཁྱགས་མཚོ་དེ་བྱུང་བ་རེད་ཅེས་བསམ་ཞིང་ཡོད་པ་རེད།",
    "གཞན་གྱི་གཟིགས་མོའི་ཚལ་དུ་འགྱུར་བར་ངེས།",
    "དེང་གི་དུས་སུ་ཚན་རིག་རིག་གཞུང་རྣམས།",
    "དཔོན་གྱིས་གཟིགས་སྐྱོང་འོག་གི་འབངས་ལ་བྱམས།",
    "རང་གི་རིགས་ལ་ཞེན་པའི་བློ་ཡིས་བསྒྱུར།",
    "ཙྪནྟུ་། དེབ་འདི་ནི་སི་ཁྲོན་ཚན་རིག་ལག་རྩལ་དཔེ་སྐྲུན་ཁང་གི་ལོའི་ཟླ་པའི་པར་གཞི་དང་པོ་ཁྲེང་ཏུའུ་པར་ཐེངས་དང་པོ་གཞིར་བཟུང་ནས་བསྒྱུར་ཏེ་བསྐྲུན་པ་ཡིན།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ཞིང་འགྲེམས་སྤེལ་བྱས།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་རྩིས་འཁོར་ནས་བསྒྲིགས།",
    "དེབ་རེར་སྒོར་",
    "ན་མོ་ཤྲཱི་ཀཱ་ལ་ཙ་ཀྲ་ཡ།",
    "རིན་ཆེན་ལས་གྲུབ་ཐུགས་གསུང་སྐུའི་དཀྱིལ་འཁོར་ རེ་རེའང་གྲུ་བཞི་སྒོ་བཞི་རྟ་བབས་བཅས།",
    "ཐུགས་འཁོར་ནང་གི་ཕྱེད་དུ་རྡོ་རྗེའི་འཕྲེང་།",
    "གྲངས་མཉམ་མཐེ་བོང་ལ་སོགས་སོར་མོ་ལྔ།",
    "ཤིན་ཏུ་འགྱིང་པའི་གཡས་རྐྱང་གིས་བཞུགས་པའི།",
    "གཡོན་བཞིས་དྲིལ་བུ་པད་མ་ལྷ་ཤིང་གི།",
    "ལྷོ་ཡི་འདབ་མར་དམར་མོ་འབར་མ་དམར།",
    "བྱང་གི་འདབ་མར་དཀར་མོ་འབར་མ་དཀར།",
    "ནུབ་ཀྱི་འདབ་མར་སེར་མོ་འབར་མ་སེར།",
    "མེ་མཚམས་ནག་མོ་འབར་འདྲའི་དུ་བ་མ།",
    "གཡོན་པའི་ཕྱག་གིས་པད་དཀར་འདབ་བརྒྱད་དང་།",
    "གཡས་གསུམ་ཕྱག་གིས་འཁོར་ལོ་དབྱུག་པ་དང་།",
    "རྣམ་སྣང་གིས་འཁྱུད་སྲིན་པོར་གོས་དཀར་མོ་ རིན་འབྱུང་ལྟ་བུ་འོད་དཔག་མེད་ཀྱིས་འཁྱུད།",
    "བྱང་སྒོའི་གཡས་སུ་སྤྱན་གཟིགས་སྣང་མཐའ་འདྲ།",
    "རིམ་བཞིན་དྲི་གཟུགས་རོ་རེག་རྡོ་རྗེས་འཁྱུད།",
    "རེག་བྱ་རོ་གཟུགས་དྲི་ཡི་རྡོ་རྗེ་མ།",
    "རིམ་བཞིན་ཀུན་བཟང་ཕྱག་རྡོར་དང་མཚུངས་ཏེ་ ཕྱག་རྡོར་ཀུན་བཟང་གིས་འཁྱུད་དེ་དྲུག་ཀྱང་།",
    "རེངས་བྱེད་རྣམས་ནི་རང་ཕྱོགས་གཤེགས་པ་འདྲ།",
    "རིམ་བཞིན་སྤྱན་མ་ལྟ་བུའི་རེངས་བྱེད་མ།",
    "གཡས་བརྐྱང་གིས་བཞུགས་གཡོན་བརྐྱང་ཁྲོ་མོས་འཁྱུད།",
    "ལྷ་ཤོས་མ་དང་འབྲས་མ་སྒེག་མོ་བཞད།",
    "རོལ་མོ་གར་མ་གླུ་མ་འདོད་མ་སྟེ།",
    "དགུ་ཅར་ནག་མོ་ཞལ་གཅིག་ཕྱག་བཞི་ཡིས་ གྲི་གུག་རྩེ་གསུམ་ཐོད་པ་ཁ་ཊཾ་འཛིན།",
    "འདབ་མར་གཡང་མོ་སྒྱུ་མ་གྲགས་མ་དང་།",
    "དཔལ་མོ་རྣམ་པར་རྒྱལ་མ་དཔལ་རྒྱལ་མ།",
    "དགུ་ཆར་ནག་མོ་ཞལ་གཅིག་ཕྱག་བཞི་ཡིས།",
    "ལྟེ་བར་དྲག་པོས་འཁྱུད་པའི་ཕག་མོ་དང་།",
