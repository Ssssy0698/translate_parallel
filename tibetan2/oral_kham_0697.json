    "དེ་སྔ་ཕན་ཀྱང་རྒྱ་བོད་ཚང་མས་གོར་ཁ་རྒྱལ་ངན་སྐྱག་ལམ་དུ་བཏང་བས་ལན་པ་ཡིན་འདུག་ཅིང་།",
    "ངེད་ལ་བསྩལ་བའི་ཕྱག་མདུད་དེའི་སྣེ་ཕུ་མཚན་གཉིས་ཀ་མདུད་པའི་ནང་དུ་བཅུག་པའི་ཉམས་མཚར་ཞིག་འདུག་པ་མ་ཟད།",
    "ངེད་ཀྱི་དགོན་གཤམ་འདིར་སྲོག་ཆགས་མི་གཅིག་པ་གསུམ་གྲལ་བསྒྲིགས་ཀྱིས་བསྡད་འདུག་པའི་ཤར་མ་དེ་བྱི་ལ་སྟག་རིས་བྱས་པ་ཞིག་དང་།",
    "ངེད་རང་ཡང་དགེ་སྦྱོར་ཆག་འགྲོ་བ་འདུག་པས་ལོག་ཕེབས།",
    "རང་ཕྱོགས་ལའང་འཆིངས་རྒྱབ་དམག་མི་འབོར་གང་ཆེ་ཞིག་མེད་ན་བློས་མི་འཁྱུད་ཙམ་འདུག་ཚུལ་འབྱོར་བྱུང་གཤིས།",
    "གོར་མི་གཙོ་དྲག་རྗེས་འབྱོར་རྣམས་ཀྱི་སྡོད་གནས་གྲ་སྒྲིག་བྱེད་མི་ཡིན་ཞེས་འབྱོར་བྱུང་བ་དེ་དག་ལའང་རྒྱ་མི་གོང་གསལ་ནས་ཐོག་མའི་ཆར་མི་གྲངས་སོགས་ཐོ་བཀོད་ཀྱིས་དུས་ཚེས་འདི་ལ་མི་གྲངས་འདི་འབྱོར་སོགས་འཕྲལ་འཕྲལ་བོད་བཞུགས་ཨམ་བན་ལྷན་རྒྱས་ལ་གནས་ཚུལ་འབུལ་གྱི་འདུག་ཀྱང་།",
    "རྫམ་རྡར་ཛ་ས་རབ་གཉིས་ནས་གྲ་སྒྲིག་ཀྱང་བྱེད་ཀྱི་འདུག་པར།",
    "མེ་མདས་མཚོན་དགྲ་ཆས་རྣམས་བཞག་ནས་དགོས་བྱས་འདུག་པར།",
    "ཐབ་ཚང་སོགས་ཁང་ཁུངས་ཚང་མར་ཡོང་སྟེ་རྒྱ་གར་རྡོ་རྗེ་གདན་གྱི་བྱིན་རྟེན་ཡིན་ཞེས་སིན་རྡུར་ལྟ་བུའི་ས་ཞིག་ཐམས་ཅད་ལ་གཏོར་བ་སོགས་བྱེད་ཀྱི་འདུག་པར།",
    "མི་མང་ཁ་མང་བྱུང་ན་རྒྱལ་ཁབ་ཕན་ཚུན་གྱི་ལས་རྩ་ཆེ་མི་འགྲིག་པ་བྱས་ཡོང་བས་ཞབས་ཕྱི་རྣམས་སྐུ་མདུན་དུ་མ་འཇོག་མི་ཁོག་མིས་མ་ལོན་པའི་ངེད་གཉིས་ལ་ཐུགས་ཡིད་མ་ཆེས་པ་འདུག་ན་ངེད་གཉིས་ཀྱི་མཚོན་ཆ་རྣམས་བཞག་ཆོག་ཅེས་རྫ་མ་རྡར་དང་།",
    "ཁོ་པར་གོར་མི་རྣམས་ཉེ་འགྲམ་དུ་བཅར་མ་ནུས་པའི་མུ་ནས་གཉའ་ནང་འཕེལ་རྒྱས་གླིང་ཕྱོགས་ཀྱི་ལམ་གཞུང་དུ་སྐྱོད་སྐབས་ཟམ་པ་རྣམས་བསྒྱུར་ཚར་གཤིས་འགྲོ་མ་ཐུབ་པའི་མུར་གོར་དཔུང་རྣམས་ཀྱིས་འགྲམ་ལ་བཅར་མ་ནུས་ཀྱང་རྒྱང་ནས་མེ་མདས་མེ་རུབ་བརྒྱབ་སྟེ་བསད་འདུག་པ་དང་།",
    "སྐྱབས་མགོན་རྒྱལ་མཆོག་སྐལ་བཟང་རྒྱ་མཚོའི་སྐུ་འགག་མཚོན་སྲུང་ལ་ཡོད་པའི་ཐུགས་རྗེར་གོར་ཁས་མདའ་གྲི་མདུང་གསུམ་ཇི་སྙེད་ཅིག་བརྒྱབ་ཀྱང་ནུས་པ་མ་ཐེབས་པར་བརྟེན་མཐར་གསོན་ཟིན་བྱས་ཏེ་གྱོན་པ་མཚོན་སྲུང་རྣམས་ཤུས་འཁྱེར་གྱི་ཐོག་ནས་དམར་གསོད་བྱས་འདུག་པས་མཚོན་དེ་ཉིན་འཐབ་འཛིང་སྐབས་དགྲ་ལག་རང་དུ་སྲོག་ཤོར་བ་གཞུང་དྲུང་ལས་བྱའི་གྲས་ཡར་འབྲོག་སྒོག་མཁར་བ་དང་།",
    "རྨོས་སྐྱོན་མེད་པ་གསུམ་བཅས་འདུག་ཅིང་།",
    "ངེད་ནས་ཁོ་པར་ཟླ་བོ་སྐྱོན་མ་བྱུང་ལུས་པ་སུ་འདུག་བྱས་པར།",
    "ཐབ་གཡོག་དགོས་སྐྱེས་གཉིས་ཀྱིས་འཐབ་འཛིང་མ་བྱས་པར་བརྟེན་མ་བསད་པར་བཞག་འདུག་ཅིང་།",
    "རྒྱལ་རྩེ་སྟོང་དཔོན་པའི་སྲི་གཅོད་ཚེ་རིང་རྩམ་སྒྲོམ་གྱི་ནང་དུ་ཡིབས་ནས་བསྡད་པ་གོར་ཁས་མ་ཤེས་པར་ལུས་འདུག་པ་ལས།",
    "དེ་ལྟར་བྱེད་ཐུབ་ན་རང་གཞན་ཚང་མ་བློ་ཁ་རྫོགས་པ་ཡོད་འདུག་རུང་།",
    "གནས་པོ་ཀོ་ཐང་པའི་ལམ་རྒྱུས་ཤིག་དང་འགྲོགས་ཏེ་གཉའ་ནང་སྔོ་ར་བརྒྱུད་འགྲོ་དགོས་བྱུང་འདུག་སྟབས་འགོར་གཞི་ཅི་ཆེ་ལས།",
    "ལམ་བར་དགྲ་ཇག་ཆོམ་རྐུན་སོགས་ཀྱི་ཉེར་འཚེ་མེད་པར་རིམ་འབྱོར་བྱུང་འདུག་ཅིང་།",
    "དེར་མ་ཟད་ཁྱེད་ངོ་མ་རྣམས་ནས་ཀྱང་ཕུང་གཡོས་ཀྱི་གཉའ་ནང་ཤོ་ཁང་དུ་མེ་རྒྱག་བཅུག་ནས་རང་གཞན་ཚང་མ་མེད་པ་བཟོ་རྩིས་བྱས་འདུག་པ་འོས་མིན་ཡིན།",
    "ངན་པའི་ཡིག་རིགས་གང་ལའང་ཚད་འཛིན་མ་བྱས་འདུག་རུང་།",
    "ཕྱིན་ཆད་ནས་ཀྱང་བོད་གོར་དཀར་འཚོ་ལེགས་ལམ་ཆུ་བོའི་རྒྱུན་བཞིན་ཆད་མེད་ཡོང་ཐབས་ཀྱི་བློན་པོ་ཕན་ཚུན་འདྲིས་འགྲོགས་ཆེ་བ་བྱེད་རྒྱུ་ཡིན་ཞེས་ལབས་འདུག་དོན་བཞིན་སྐུ་ཚབ་སེར་སྐྱ་སྦྲེལ་པོས་ཀྱང་དེ་དོན་གྱི་དགོངས་སྐོར་ཕུལ་འབྱོར་བྱུང་བར་བརྟེན།",
    "འདུག་ཚེ་དྲང་སྲོང་བཞིན་དུ་ཤིང་ཤུན་གདན།",
    "མ་འདུག་ཀ་མེད་སྡོད་པའི་བཙོན་མཚམས་འདི།",
    "ཆ་སྒོར་བསྟན་འཛིན་ཀྱང་ཤེལ་དཀར་ནས་མགྱོགས་འགྲོའི་བཞོན་པ་ལ་བརྟེན་ནས་རྟ་ཟམ་གོང་གསལ་གྱི་མཇུག་ཏུ་འགྱངས་ཆེ་མེད་པར་འབྱོར་འདུག་སྟབས།",
    "མཆི་མའི་སྒོམ་ལ་བརྟེན་པ་འདི་བྱ་འདི་བྱེད་བྲལ་བར་གནས་འདུག་སྐབས།",
    "འདི་གའི་ཟླ་བོ་བསམ་འགྲུབ་སོགས་དིང་རི་གླང་དུ་སླེབས་ཉིན་གོར་དམག་རྣམས་གཉའ་ནང་མཐོང་ལ་བརྒལ་ནས་དིང་རི་ཕྱོགས་སུ་འབྱོར་བ་དང་སྟབས་མཚུངས་བྱུང་འདུག་གཤིས།",
    "དིང་རི་ལ་ཡང་སྡོད་མ་ནུས་པར་ལྷ་རྩེར་ཕྱིར་ལོག་བྱེད་དགོས་བྱུང་འདུག་པ་དང་།",
    "མ་ཆེན་ནོར་བུ་བསམ་འགྲུབ་སོགས་མི་ལྔ་དྲུག་ཅིག་འདས་འདུག་པ་ལས།",
    "རྨས་སྐྱོན་རྣམ་གསོས་འདུག་པ་མ་ཟད།",
    "དེ་ནས་ལ་བརྒྱབ་སྟེ་ལ་སྟོད་ཅུང་རི་བོ་ཆེ་ནས་གཙང་པོ་སྦུགས་བརྒྱུད་ཀྱི་དགའ་བཞིར་ཕྱིར་ལོག་བྱས་འདུག་སྐབས་ལམ་འཁོད་ལ་ལས་ནི་ངོ་ཤེས་བཞིན་དུ་བཟའ་བཏུང་ཙམ་ཡང་མི་སྟེར་བའི་མཐའ་ངན་དང་།",
    "སྐུ་གསུང་ཐུགས་རྟེན་རྣམས་བཤིག་གཅོག་འཁྱེར་གསུམ་གྱི་ཐོག་ནས་ཕྱིར་ལོག་བྱས་འདུག་ཀྱང་།",
    "དགྲ་ཉམས་དགྲས་མ་ལོན་པར་དེ་སྐབས་དབུས་གཙང་ཚང་མར་འདྲེ་འུར་ལྟ་བུས་བརྡབས་ཤོག་ཅི་ཆེ་ཞིག་བྱུང་འདུག་སྟབས་བོད་མི་དྲག་ཞན་ལ་མ་ལྟོས་པར་སྲན་ཕུང་བེར་ཀས་གཏོར་བ་བཞིན་དུ་ཁ་འཐོར་ལ་རང་མགོ་གང་ཐོན་དུ་ཕྱིན་འདུག་སྟབས།",
    "མི་རྗེ་བཀའ་དྲིན་ཅན་དར་ཧན་གུང་པཎྜི་ཏ་ནི་གཞུང་སྒེར་གྱི་ལས་དོན་བཀའ་འདོམས་མཛད་པར་ལྷ་ལྡན་རང་དུ་བཅར་བཞུགས་མཛད་དགོས་བྱུང་འདུག་ཀྱང་།",
    "བྱ་ཡུལ་སྒེར་གཞིས་ས་བཙན་བཅས་བབས་འབྲེལ་མི་ཆགས་པ་མི་འདུག་རུང་འདྲ་ས་སྡང་ཞིང་ཆུ་ངན་པ་དང་།",
    "ལྕམ་ལའང་ལུས་གསོ་རྒྱུ་ཞིག་ཡོད་འདུག་པ་མ་ཟད།",
    "ད་ལམ་ཡང་ངེད་ཨམ་བན་གཉིས་ལ་གྲོས་འདྲི་ཙམ་མ་བྱས་པར་རང་མཚམས་ཀྱིས་སྔོན་མའི་ལས་མཇུག་མཐུད་པར་ས་མཚམས་གཉའ་ནང་དུ་ཕྱིན་འདུག་པར་དགྲ་ལག་ཏུ་ཤོར་ཞིང་།",
    "རྒྱ་ནག་ཏུ་འབྱོར་ནས་ཀྱང་དགོངས་འཕག་ཚབས་ཆེན་བྱུང་འདུག་ཅིང་།",
    "དཔུང་དམག་སྔོན་མ་རྣམས་འབྱོར་པའི་འགོ་ཡོད་མདུན་གནམ་བསྐོས་གོང་མ་བདག་པོ་ཆེན་པོས་མི་རྗེ་བཀའ་དྲིན་ཅན་དར་ཧན་གུང་པཎྜི་ཏར་ཡང་བསྐྱར་བཀའ་བློན་གྱི་ཕྱག་ལས་འགན་འཁུར་མཛད་དགོས་ཀྱི་བཀའ་ཡིག་བསྩལ་ཕེབས་བྱུང་འདུག་པ་མ་ཟད།",
    "གོས་ཆེན་ཡུག་བམ་བཅས་སྤྱི་བོར་བསྩལ་ཕེབས་བྱུང་འདུག་པ་མ་ཟད།",
    "བསམ་པ་བག་ལ་ཉལ་གྱི་རིམ་པ་དང་བསྟུན་ནས་གང་ལ་གང་འདུལ་གྱི་སྤྲུལ་བསྒྱུར་མཛད་པ་ལས་མཇལ་མི་རུང་བ་ནི་མི་འདུག་ཅིང་།",
    "ཁྱད་པར་དུ་ཡང་བདག་ཅག་ཐ་སྙད་ཀྱི་རིགས་ལམ་སྨྲ་བར་རློམས་པ་རྣམས་ཕྱི་རོལ་གྱི་སྟོན་པའི་བཞེད་གཞུང་དང་ཡང་ཕྲན་བུ་བསྟུན་དགོས་གཤིས་མཆོད་མཇལ་ཞིག་བྱས་པར་འགལ་བ་མི་འདུག་སྙམ་བཙོན་སྲུང་རྣམས་ལ་བརྡ་སྦྱོར་བྱས་པ་ན་དེ་གྲས་ནས་མི་ལྔ་རྒྱབ་རྫིར་སླེབས་བྱུང་བར་བུ་ཕྲུག་རྣམས་ཀྱི་སློབ་དཔོན་མཁས་མཆོག་ལགས་དང་།",
    "ཁོ་བོ་གཉིས་ནས་གཙུག་ལག་ཁང་དེའི་ནང་དུ་མཆོད་འཇལ་ལ་ངོས་བསྐྱོད་བྱས་པར་བརྟེན་གཙོ་བོ་ཁྱབ་འཇུག་ཁྱུང་ཞོན་ཁྲག་ཞགས་ཀྱི་སྦགས་པ་བྱིས་པ་ལོ་བརྒྱད་ཙམ་ཞིག་འཇལ་རྒྱུ་འདུག་ཅིང་།",
    "དམག་མི་བྱིངས་གྲས་ནས་ཀྱང་གཅིག་མགོ་བོ་ཧབ་འཁྱེར་གྱིས་ཤི་ཞིང་གཉིས་རྨས་འདུག་པ་ལས་མ་སྐྱོན་ཙམ་བཟོས།",
    "གཞོགས་སུ་ཐ་མི་ཁ་ཆུ་ལེན་བཙུགས་ཏེ་འདུག་ཅིང་།",
    "གོར་རྒྱལ་རཎ་སྦ་དུར་ངོ་མ་དེ་སྐབས་ན་ཚོད་ཕྲ་སྟབས་ངེད་རྣམས་ལ་བཟང་ངན་གྱི་དྲི་བ་ཡང་ཚིག་གཅིག་མི་ཟེར་འདུག་པ་མ་ཟད།",
    "ཡིག་རྟེན་གསེར་ཇི་ཡོད་མ་ཤེས་པ་ལས་ཡིག་དོན་ལ་ཐུགས་བློ་བདེ་ཁྱད་འཚམས་འདྲི་ཁོ་ན་མ་གཏོགས་འགལ་འཛོལ་རིགས་གང་ཡང་མེད་འདུག་ཀྱང་།",
    "འཁོར་ལོའི་སྔགས་ཡིག་འགོད་ཚུལ་སོགས་འདི་ལྟར་བྱེད་དགོས་པ་ལ་ཚད་ལྡན་ཞིག་མ་བྱུང་འདུག་ཅིང་།",
    "བྱ་རུང་ཁ་ཤོར་ལ་ནང་པས་མཆོད་ཅིང་མདུད་པ་མ་གཏོགས་ཕྱི་པ་རྣམས་ཀྱིས་རིགས་ངན་གྱི་མཆོད་རྟེན་ཞེས་དད་གུས་མི་བྱེད་འདུག་ཀྱང་།",
    "ཞེས་གསུངས་འདུག་པ་མ་ཟད།",
    "དགོངས་དྲོ་བཀའ་བརྒྱུད་པ་རྣམས་སྒྱུར་དད་ཆེ་གཤིས་སེར་སྐྱ་ཚང་མ་མྱོས་བྱེད་ཀྱི་བཏུང་བས་ར་རོ་བཞིན་དུ་གནས་འདུག་པ་དང་།",
    "ལྷ་ས་ཇུ་ལང་འགོ་བྱེད་ཚོང་དཔོན་རྣམ་རྒྱལ་སོགས་སེར་སྐྱ་དྲག་ཞན་ཚང་མས་དགོངས་རྫོགས་སྒྲུབ་རྒྱུས་མཚོན་གང་ཅིར་རོགས་རམ་གང་དྲག་བྱས་འདུག་ཅིང་།",
    "རྒྱུད་པའི་སློབ་དཔོན་སོགས་ཚང་མ་གོ་ཆོད་ཀྱི་ཐུགས་འགན་ཆེ་བཞེས་མཛད་འདུག་པ་དང་།",
    "བྱ་ཁྱིར་སྟེར་བ་སོགས་བྱས་ན་གཏན་ནས་མི་འཐུས་ཞེས་ཤ་ཚ་རྨོངས་ཞེན་གྱི་སྒོ་ནས་དགོངས་བཞེད་ལྟར་བྱ་གཏོར་བྱེད་མ་བཅུག་འདུག་སྟབས།",
    "ཞབས་གཉིས་ཀའི་ལོ་བུ་གཏན་ནས་མ་འཚིག་འདུག་པ་བཅས།",
    "སྨད་ཀྱི་རྒྱ་ནག་སོག་ཡུལ་སོགས་ས་ཐག་རིང་བའི་གནས་རྟེན་རྣམས་ལ་མཆོད་འབུལ་གསེར་གསོལ་སོགས་མཛད་མ་ཐུབ་འདུག་ཀྱང་།",
    "སྐུ་གཤེགས་ནས་ཀྱང་དགེ་འཐུད་གསོལ་རས་སྔར་ལམ་སྤྱི་འགྲོའི་ཐོག་གཟིམ་ཆུང་སྡུག་ནས་སྤྱན་གསལ་འཕར་མའི་གསོལ་རས་སྤམ་མཐོ་བ་བསྩལ་འདུག་ཅིང་།",
    "གཞན་ཡང་བོད་གོར་བར་ལ་ཕྱི་ལག་ནང་གྲོས་ཀྱི་མི་དང་ཡིད་འགྲུལ་སྣ་ཚོགས་ཡོད་འདྲ་ཞེས་རྨི་ལམ་དུ་ཡང་མ་དྲན་པའི་གཏམ་ཆ་ངན་པ་སྣ་ཚོགས་བྱུང་འདུག་པ་ནི།",
    "བཀྲ་ཤིས་ལྷུན་པོའི་ཞབས་པད་བློ་བཟང་སྦྱིན་པ་དཔོན་གཡོག་བཅས་ཀྱང་སྔ་ཕྱི་རིམ་བཞིན་རྒྱ་ནག་ཏུ་ཕེབས་དགོས་བྱུང་འདུག་ཅིང་།",
    "ཁོ་བོ་གཉིས་ཀ་མཉམ་དུ་འདུག་པ་མ་ཟད།",
    "སྡིག་སྒྲིབ་དག་ཐབས་སུ་རྡོར་སེམས་སྒོམ་བཟླས་བྱེད་དུས་དམིགས་པ་ལའང་རང་ལུས་ནས་དྲི་ཆུ་དང་མི་གཙང་བ་སོགས་ནག་ལྷུར་གྱིས་དོན་པ་བསྐྱེད་དགོས་ན།",
    "ད་ལམ་རྨི་ལམ་དང་མངོན་སུམ་གཉིས་ཀ་མཚུངས་པར་བྱུང་བ་འདི་འདྲ་སྡིག་སྒྲིབ་དག་པའི་མཚན་ལྟས་ཤིན་ཏུ་གསལ་བ་ཡིན་འདུག་ཟེར་བ་མ་ཟད།",
    "ཉ་མིག་མ་སོགས་ཆེ་ཆུང་སྣ་ཚོགས་མང་དུ་སྒྲུག་རྒྱུ་འདུག་པ་མ་ཟད།",
    "ས་འཛིན་པ་སོགས་ཚང་མ་སྡོད་གནས་དང་ཆས་དངོས་སྤོ་ཤུགས་བྱེད་པ་སོགས་ཅི་དྲག་ལ་གྱུར་བ་བྱུང་འདུག་གཤིས།",
    "ཁྱེད་རང་བོད་པ་རྣམས་ཀྱིས་བལ་ཡུལ་འདིར་བརྫངས་པའམ།",
    "གཞི་ནས་རྒྱ་ནག་གོང་མ་ཆེན་པོ་སྟོབས་འབྱོར་ཆེ་ཞིང་དཔུང་མང་བ་ཡིན་འདུག་རུང་།",
    "ཁྱེད་རང་བཀའ་མདའ་སོགས་ཀྱི་ཆས་དངོས་བླངས་པ་རྣམས་ལ་ངོ་ཡོད་ངོ་དང་།",
    "ངེད་ནས་མཐའ་ངན་བྱས་དོགས་ཡིད་མི་ཆེས་པ་ཡོད་ན་ནི་འགྲོ་རྒྱུ་ཡང་མི་འདུག་ཅིང་།",
    "གཡུ་ཐོག་ངོ་སོགས་ཀྱང་གཞུང་ནས་ཀར་སྲིད་བཅོམ་སྐབས་བྱེད་གཏེའི་གྲས་སུ་ཡོད་ངེས་ཀྱི་ལས་འབྲས་རྣམ་སྨིན་འཁུར་དགོས་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཞྭ་དམར་བ་ལས་དྲིན་ཆེ་བ་མི་འདུག་སྙམ་པ་ཡིད་ལ་ཝལ་གྱིས་ཤར་ནས་དེ་སྔ་ཕན་མཛད་སྤྱོད་བློ་ཡུལ་དུ་མ་ཤོང་བར་ལོག་བལྟ་འཕྱ་སྨོད་བྱས་པ་རྣམས་དྲན་བཞིན་པའི་ངང་ནས་འགྱོད་པ་དྲག་པོས་སྟོབས་བཞི་ཚང་བའི་བཤགས་སྡོམ་ཡང་བྱས་པར་བཀའ་བློན་གཡུ་ཐོག་སོགས་བོད་མི་དེར་ཡོད་ཚང་མས་ཁོ་བོ་ལ་བཟང་ངན་མི་ཤེས་པའི་ཅོལ་ཆུང་འདོ་མེད་དུ་ངོས་བཟུང་ནས་ཁྲེལ་ཞིང་རྒོད་པ་དང་།",
    "རང་ཡུལ་དུ་ལོག་པར་ཆུ་ཚོད་ཀྱི་སྔ་ཕྱི་ལའང་བལྟོས་པའི་རིངས་ཁྱད་ཆེ་བ་མཛད་འདུག་རུང་།",
    "ཕར་ཡང་དཔུང་སྣོན་དུ་འོང་མི་སོགས་ཀྱི་ལམ་མི་ཐར་བ་ལྟ་བུ་འདུག་གཤིས།",
    "ཇེ་མཐོར་བསྐྱེད་ཀྱང་རང་སྡུག་རང་ཉིད་ཀྱིས།",
    "དེ་རྗེས་རྒྱ་དཔོན་གོང་གསལ་གསུམ་ཀ་དཀྱིལ་སྒར་གྱི་ལྡིང་གུར་ཆེ་ལེགས་ཞིག་འདུག་པའི་ནང་དུ་ཕེབས་ནས་མཐའ་སྐོར་དུ་མཉྫདང་།",
    "དེ་མཚུངས་ཟས་གོས་སོགས་ཟད་འཛངས་རིགས་ལའང་གཡར་བསྐྱི་ཐབས་རྣམ་བྱས་རུང་མཐུན་གྲོགས་བྱེད་མི་ཉིན་སྐར་ལས་དཀོན་པ་ཞིག་འདུག་པ་ནི།",
    "བུ་ཕྲུག་རྣམས་ཀྱི་ཉེ་འབྲེལ་ལ་བརྟེན་དགའ་བཞི་བར་བཀའ་དྲིན་ཆེ་བ་ཞིག་ཡིན་ཡང་བྱས་ཉེས་མེད་པར་རྒྱ་ནག་ཏུ་ཕེབས་དགོས་བྱུང་འདུག་པར་མྱ་ངན་བྱུང་ཚུལ་ལས།",
    "དེ་སྔོན་ས་སྤྲེ་དུས་གཟིར་ལོ་ལ་སྟོད་དིང་རིར་ཁོ་བོ་དང་མཉམ་སྦྲེལ་གྱིས་ས་སྲུང་ལ་སྡོད་མི་རྒྱ་དཔོན་ཀྲང་རྡ་ལོ་ཡེ་རང་ཡང་དཔུང་དམག་འགོ་བྱེད་གྲས་སུ་འདུག་གཤིས།",
    "མེ་མདའི་སྒྲ་སྐད་དང་ཀུ་ཅོ་འབྲུག་སྟོང་ལྡིར་བ་ལྟ་བུ་འདུག་སྐབས།",
    "བྱེད་པོ་གྲོངས་ཚར་གཤིས་འགལ་བ་མི་འདུག་སྙམ་ཞུས་པ་ལས།",
    "ཕུ་ཟི་གུང་རྡ་ཀྲུང་ཐང་ཆེན་པོ་ནས་གོང་མ་ཆེན་པོའི་དགོངས་པ་དང་མཐུན་ཅིང་རང་གཞན་རྒྱ་བོད་ཚང་མར་སླེབས་ཚེ་དཀྱུས་རིང་ཡོང་ཐབས་ཀྱིས་གོང་མ་ཆེན་པོར་ཞུ་ཕྱོགས་དང་།",
    "ཁྱེད་རང་རྣམས་ལའང་བཀའ་སློབ་བསྩལ་ཡོད་པ་གཞིར་བཅས་གཤིས།",
    "དེ་དོན་བཞིན་བྱས་རྗེས་རྒྱ་སླེབས་བོད་དྲིན་ཆེ་བ་ཡོང་འདུག་ཅེས་པ་ཙམ་ལས་དངོས་སུ་ཞུ་འཐེན་རིགས་མི་བྱེད་འདུག་རུང་།",
    "ངེད་རྣམས་ལ་ལམ་ཆས་སྤྲོད་རྒྱུས་མཚོན་བློ་སེམས་མགུ་ཐབས་སོགས་མི་མངོན་ཤུགས་ཀྱིས་ལེ་འགྲིག་ཐབས་ལ་འབད་འབུངས་བྱེད་ཀྱི་འདུག་ཅིང་།",
    "རྒྱ་མཚོ་དོན་གཅིག་སོགས་འདུག་པ་ཡང་ངོས་འཕྲད་དུ་བྱུང་བ་མ་ཟད།",
    "ཆས་དངོས་མང་པོ་འཁྲིད་འཁྱེར་བྱས་རུང་བློ་གཡེང་ཆེ་རོགས་ལས་དགོས་ཚོགས་མི་འདུག་ལྷག་དོན་བུ་ཕྲུག་རྣམས་ལ་ཡོན་ཏན་འཕྲོ་སྐྱོང་ཡང་བསླབ་དགོས་སྟབས་སློབ་དཔོན་མཁས་མཆོག་ལགས་དང་ལྷན་ཅིག་ཟླ་བོ་མི་དགོས་པ་རྣམས་དང་།",
    "དབྱར་སྐྱེས་རྗེ་སངས་དང་འགྲོགས་སྦྲང་ཆར་གྱི་རྒྱུན་མི་ཟད་པར་འབབ་པ་སོགས་བོད་དབུས་གཙང་ལྗོངས་ཀྱི་དབྱར་སྒང་ལས་ཀྱང་དྲོད་ཆེ་བ་འདུག་རུང་།",
    "ཡུལ་དེ་ན་ཕོགས་དཔོན་ཚང་མའི་སྤྱི་ཁྱབ་གོང་མ་ཆེན་པོའི་ཕྱག་མཛོད་ལྟ་བུ་རྒྱ་སྐད་ལ་སྦོ་ཁྲིན་ཟེར་འབོད་པ་ཧོ་རྡ་རིན་ཞེས་པའི་ཨམ་བན་ཞིག་འདུག་པ་ནས་ཁོ་བོ་དང་།",
    "ཐུ་ལོ་ཡེར་རག་ཏོན་ཞིག་ལས་མི་འདུག་རུང་།",
    "གཡུ་ཐོག་བཀྲ་ཤིས་དོན་འགྲུབ་གཉིས་ནས་གོང་མ་ཆེན་པོའི་བཀའ་དྲིན་མ་བསམས་པ་རྐུན་མ་གོར་ཁར་མགོ་བཏགས་སོགས་བློ་སེམས་ལོག་པའི་བྱ་བ་ཚབས་ཆེ་བྱས་རིགས་ཀྱི་ཉེས་པ་མི་འདུག་ཀྱང་།",
    "འོན་མ་སང་ཞིང་རང་སྟོབས་ཞན་པའི་བྱ་བ་ལ་བརྟེན་དགྲ་ལག་ཏུ་ཚུད་གཤིས་གོང་མ་ཆེན་པོའི་གུང་དང་།",
    "ཉི་མ་རྩེ་ཤར་གྱི་དུས་ཚོད་ལ་གནམ་བསྐོས་འཇམ་དབྱངས་གོང་མ་བདག་པོ་ཆེན་པོ་སྟོན་འཁོར་རྣམས་ཆིབས་ཞལ་བསྒྱུར་བྱུང་དུས་འདི་སྐབས་སྟོན་འཁོར་ཉུང་བསྡུས་སྟབས་བདེ་ལས་ཆིབས་རགས་རྒྱས་སྤྲོས་མི་འདུག་ཟེར་ཡང་།",
    "ནང་བློན་ཀྲུང་ཐང་ཆེན་པོ་རྣམས་ཀྱང་དེའི་ནང་དུ་མི་ཐར་བར་ལྷ་ཁང་འགག་ཏུ་བཞུགས་དགོས་ཀྱི་འདུག་གཤིས།",
    "གཡུ་ཐོག་གཉིས་ལ་གོང་མ་ཆེན་པོའི་གསོལ་ཟས་མཆོད་འཕྲོའི་གསོལ་རས་ཡིན་འདུག་ཅེས་སྤྱོད་པ་དང་ལྷན་ཅིག་ལེའུ་ཨམ་བན་ནས་ཟེར་རིགས་སུ།",
    "ཧུང་རྡ་ཁྲིན་གཉིས་ཀྱང་ཟིན་ཆོན་ཆི་ཐུ་ཧུའི་རང་ཡུལ་དུ་ཕྱིར་སློག་མཛད་འདུག་ཅིང་།",
    "ཡི་གེ་འདི་བཞིན་བོད་སྡོད་ཨམ་བན་ནས་གོང་མ་ཆེན་པོར་ཕུལ་བའི་ཞུ་ཡིག་ཡིན་འདུག་ཅིང་།",
    "བྲག་ཟུར་བཅས་ཀྱི་མིང་དོན་གསལ་བར་འདུག་སྟབས་ཁོ་བོས་དེ་ལན་དུ།",
    "འགག་པ་དགེ་ལེགས་སོགས་ཁ་ཤས་ཤིག་ངོས་འབྱོར་བྱུང་འདུག་ཀྱང་།",
    "ཞྭ་མགྲོན་ཡེ་ཤེས་རྒྱལ་མཚན་པེ་ཅིང་དུ་སླེབས་འཕྲལ་འདས་འདུག་ཅིང་།",
    "སྲི་གཅོད་ཚེ་རིང་བཅས་ངའོ་ལྕང་ཇུན་ནས་རྒྱ་ནག་ཏུ་བཏང་འདུག་པ་འདིར་འབྱོར་མིན་དང་།",
    "ཡོད་ཚེ་ངེད་རང་ངོ་མ་གཉིས་ལའང་ཉེས་པ་མི་འདུག་པས་རང་ཡུལ་དུ་ལོག་འཐུས་བསྩལ་གཤིས།"
  ]
}