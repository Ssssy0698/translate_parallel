    "ཉོན་མོངས་དགྲ་རྣམས་མ་ལུས་འཚེས་པ་དང་།",
    "ཧ་ཅང་ཐལ་བས་ཆོག་སྟེ།",
    "ཟག་པ་མེད་པ་སྟེ་དྲི་མ་རྣམས་ནི་ཟག་པའི་མང་གི་རྣམ་གྲངས་ཡིན་ནོ།",
    "ཤོས་རབ་དེ་ཉིད་ཀྱང་སེམས་ལས་བྱུང་བ་ཡིན་པའི་ཕྱིར་ཤེས་རབ་ཉིད་སེམས་ཀྱི་འཁོར་ཡིན་པས་སེམས་གཙོབོར་འོས་པ་ཡིན་མོད་ཀྱང་།",
    "གཞི་ལྡོག་གི་རབ་ཏུ་དབྱེ་བ་ནི་དོན་དམ་པ་དང་བརྡར་བཏགས་པ་གཉིས་ཏེ།",
    "དེ་ལྟ་བས་ན་བསྟན་བསྟན་བཅོས་འདི་ནི་མོ་འི་མཛོད་ཅེས་བྱའོ།",
    "ཉོན་མོངས་པས་ཀྱང་འཇིག་རྟེན་སྲིད་མཚོ་འདིར་འཁྱམས་ཏེ།",
    "རབ་ཏུ་བྱེད་པའི་ག་ཞི་ནི་གནས་བརྟན་དབྱིག་གི་བཤེས་གཉེན་གྱིས་བྱས་པ་དང་།",
    "གདགས་པའི་བསྟན་བཅོས་ནིའཕགས་པ་མོང་གལ་གྱི་བུས་བྱས་པ་དང་།",
    "སྟོན་པ་མྱ་ངན་ལས་འདས་པའི་འོག་ཏུ་གནས་བརྟན་ཀླ་ཏྱཱའི་བུ་ལ་སོགས་པས་ཡེ་ཤས་ལ་འཇུག་པ་ལ་སོགས་པར་བསྡུས་ཤིང་ཚོམས་སུ་བྱས་ནས་ཕུང་པོར་བཅད་དེ་བཞག་སྟེ།",
    "རྒྱུ་དང་རྐྱེན་གྱིས་བསྐྱེད་པ་རྣམས་ནི་འདུས་བྱས་ཞེས་བྱ་བས་ལམ་གྱི་བདེན་པ་ཡང་རྒྱུ་དང་རྐྱེན་གྱིས་བསྐྱོད་པའི་འདུས་བྱས་ནི་ཡིན་མོད་མཛོད་ཀྱི་འོན་ཀྱང་ཟག་པ་དང་བཅས་པའི་མཚན་ཉིད་ཀྱི་གཞྱིར་མི་གཏོགས་ཏེ།",
    "དེ་ལས་མངོན་། གཞན་དུ་ཟག་པ་དྭང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་ཟག་པ་དྭང་བཅས་པ་ཡིན་ན་ནི་སེམས་དང་སེམས་ལས་བྱུང་བ་ཉོན་མོངས་པ་ཅན་དག་ཁོ་ན་ཟུག་པ་དང་བཅས་པར་འགྱུར་གྱི་ཉོན་མོངས་པ་དང་མཚུངས་པར་མ་ལྡན་པ་རྣམས་ནི་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་ཟག་པ་རྣམས་ཀྱི་རྟེན་གང་ཡིན་པ་དེ་དག་ཟག་པ་དང་བཅས་པ་ཡིན་ནཱ་ནི་ནང་གི་སྐྱེ་མཆོད་ཁེ་ན་ཟག་པ་དང་བཅས་པར་འགྱུར་གྱི་ཕྱིའི་གཟུགས་ལ་སོགས་པ་རྣམས་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་དག་ལ་ཟག་པ་རྒྱས་པར་འགྱུར་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པས་འགྲུབ་པར་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འདུས་མ་བྱས་གསུམ་ནི་སྔར་མོ་གྲགས་པའི་ཕྱིར་སྨོས་ཏེ།",
    "སོ་སོར་བརྟགས་པ་མ་ཡིན་པས་འགོག་པ་སྟེ། ། འགོག་པ་དེ་གཉིས་དང་གསུམ་མོཞེས་པའོ།",
    "དེ་ཡང་འདས་མ་ཐག་པའྀ་ནམ་མཁའ་ཞས་མིང་གིས་བསྟན་པ་དེའི་མཚན་ཉིད་ནི་མི་སྒྲིབ་པའི་རང་བཞིན་ཏེ་གང་ན་གཟུགས་ཀྱི་གོ་སྐབས་ཡོད་པའོ།",
    "རྩིག་པ་ལ་སོགས་པ་ཡོད་པ་དྲང་མྱེད་པ་གང་གི་ཚེ་ཡང་ནམ་མཁའ་ནི་དེ་མེད་ན་གོ་འབྱེད་པ་མེད་པའི་ཕྱིར་རྩིག་པ་ལ་སོགས་པ་ཡོད་པ་དངོོ་མེད་པ་ཉིད་དུ་འགྱུར་བའི་གནས་མེད་ཅིང་སྐབས་མེད་དོ།",
    "སོ་སོར་བརྟགས་པས་འགོག་པ་ཞེས་མིང་གིས་བསྟན་པ་དེ་ཉིད་ཀྱི་གདགས་དོན་གང་ཞེ་ན།",
    "བར་ཆཆད་མེད་པའི་ལམ་གང་གིས་ཉོན་མོངས་པའི་ཐོབ་པ་རབ་ཏུ་སྤོང་བ་ནུ་ཐོབ་པའི་བྲལ་བའི་ཐོབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ལམ་ལའང་འགོག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "སྡུག་བསྔལ་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པའི་འགོག་པ་མངོན་སུམ་དུ་བྱས་པས་ཉོན་མོངས་པ་ཐམས་ཅད་འགོག་པ་མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་ཞིང་།",
    "དེ་དག་ཀྱང་སེམས་དང་སེམས་ལས་བྱུང་བ་མ་འོངས་པ་རྣམས་སྐྱེ་བ་ལ་ཁྲེགས་བྱེད་པ་ནི་ཡིན་མོད་ཀྱི་དུས་རེ་ཞིག་པ་ཡིན་པས་གཏན་དུ་མ་ཡིན་ནོ།",
    "གེགས་བྱད་པ་ཞེས་སྨོས་པས་ནི་སོ་སོར་བརྟགས༵་པའི་འགོག་པ་བསལ་བ་ཡིན་ཏེ་བྲལ་བའི་མོཚན་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དཔར་ན་མིག་དང་ཡིད་གཟུགས་སྔོན་པོ་ལྟ་བུ་གཅིག་ལ་ཡེངས་པ་ནི་གཟུགས་གཞན་དང་སྒྲ་དྲི་རོ་རེག་བྱ་གང་ཡིན་པ་དགའདས་པར་གྱབཅོ་བརྒྱད་དག་ལ་དམིགས་པའི་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དག་ནི་ཡང་སྐྱེ་བར་མི་ནུས་ཏེ།",
    "བརྟགས་མིན་གྱི་འགོག་པ་ནི་སྐྱེ་བ་ལ་རྐྱེན་མོ་ཚང་བས་གཏན་དུ་གླེགས་བྱེད་པའི་མཚན་ཉིད་ཅན་ཡིན་ལ།",
    "གང་དག་གིས་གཉིག་འཐོབ་པར་འགྱུར་ཡང་ཡོད་དེ།",
    "གྱང་དག་གིས་གཉི་ག་མི་འཐོབ་པ་ཡང་ཡོད་དེ།",
    "རང་ལྡོག་གི་རྣམ་གྲངས་བསྟན་པ།",
    "མ་འོངས་པའི་གཟུགས་ལ་སོགས་པ་དག་ཀྱང་མ་སྐྱེས་མོད་ཀྱི་འོན་ཀྱང་འདུས་བྱས་ཉིད་ཡིན་པར་མི་འགལ་ཏེ།",
    "སོང་བ་དང་འགྲོ་བ་དང་འགྲོ་བར་འགྱུར་བའི་ཕྱིར་རམ།",
    "མིང་གིས་ནི་དོན་རྗོད་པར་བྱེད་དོན་དང་བཅས་པའི་གཞི་སྨོས་པའི་ཕྱིར་ན་འདུས་བྱས་ནི་གཏམ་གྱི་གཞི་ཞུས་བྱའོ་། དེ་ཡང་གཏམ་གྱི་ཡུལ་ནི་མངོན་སུམ་དང་བརྒྱུད་པའི་སྒོནས་རྣམ་པ་གཉིས་ཏེ།",
    "དེར་སོང་བ་ལ་སླར་འོང་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཉེ་བར་ལེན་པ་ཞེས་བྱ་བོ་ནི་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་སོ།",
    "ཉོན་མོངས་པ་དེ་དག་གིས་སྲིད་པ་གསུམ་དུ་སྐྱེ་བ་འཛིན་པར་བྱེད་པའི་ཕྱིར་ན་ཉེ་བར་ལེན་པའི་མིང་གིས་བཏགས་སོ།",
    "ཉོན་མོངས་པ་དེ་དག་ལས་བྱུང་བའི་ཕྱིར་ན་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཞེས་བྱ་སྟེ།",
    "གཞན་ཡང་ཉེ་བར་ལེན་པ་རྣམས་ཀྱི་ཕུང་པོ་ནི་ཉེ་བར་ལེན་པའི་ཕུང་རྩྭ་དག་གི་མ་ནི་རྩྭའིམ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "འཐབ་པ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་རྣམས་ཏེ།",
    "ཉོན་མོངས་པ་རྣམས་།",
    "རེག་བྱ་སྟེ་དོན་ལྔ་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རྟེན་ནང་གི་གཟུགས་དང་བའོ།",
    "ནང་གི་ཞེ་སྨོས་པ་ནི་ཕྱི་རོལ་གྱི་དོན་ལྔའི་གཟུགས་བསལ་བའི་ཕྱིར་རོ།",
    "རེག་བྱ་བཅུ་གཅིག་བབདག་ཉིད་དོ།",
    "དོན་ལྔ་པོ་དེ་དག་གི་མཚན་ཉིད་ནི་མིག་ལ་སོགས་པའི་ཡུལ་ཡིན་པར་འཇིག་རྟེན་ན་རབ་ཏུ་གྲགས་པས་དབྱེ་བ་བརྗོད་པ་འོ་ནས་བསྟན་ཏམཚན་ཉིད་ནི་མ་བསྟན་ཏོ།",
    "དེ་ལྟར་ན་གཟུགས་ཀྱི་དོན་ལ་བྱེ་བྲག་གི་རྣམ་པ་ཉི་ཤུ་སྟེ།",
    "དེ་ཡང་ཡིད་དུ་བ་དང་ཡིད་དུ་མི་འོང་བའི་བྱེ་བྲག་གིས་རྣམ་པ་བརྒྱད་དོ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བ་དག་གི་རྟེན་གྱི་དངོས་པོ་ཡིན་ནོ།",
    "བསྐ་བའི་བྱེ་བྲག་གིས་སོ།",
    "གཞན་ཡང་རོ་དྲུག་ཕན་ཚུན་ཕྲད་པའི་ཁྱད་པར་ལས་ནི་རེའི་རྣམ་པ་རབ་ཏུ་མ།",
    "ལུས་ཀྱི་ཡུལ་རེག་བྱ་ནིབཅུ་གཅིག་བདག་ཉིད་དོ།",
    "བྱང་གི་སྒྲ་མི་སྙན་པ་རྣམས་ཀྱི་དཔག་བསམ་ཤིང་གི་གོས་དག་ནི་སྲུང་གཅིག་འཇལ་བ་དེའི་ཁྱད་ནི་རྒྱལ་ཆེན་རི་ལྷ་བཞི་པ་རྣམས་ཀྱི་སྟེ།",
    "གང་གི་ཚེ་སྔོན་པོ་ལྟ་བུའི་རྣམ་པ་བྱེ་བྲག་ཏུ་གཅོད་པར་འགྱུར་བ་ནའོ།",
    "རེས་འགའ་ནི་མང་པོས་ཏེ།",
    "གང་གི་ཚེ་ཐག་རིང་པོ་ནས་དམག་བཤམས་འམ་ནོར་བུའི་ཚོགས་ཀྱི་ཁ་དོག་དང་དབྱིབས་དུ་མ་ལ་ལྟ་བ་ལྟ་བུ་ནའོ།",
    "གཟུགས་དང་བྱེད་པའི་རང་བཞིན་ཡིན་པར་འདྲ་ཡང་ལུས་དང་ངག་གི་རྣམ་པར་རིག་བྱེད་བཞིན་དུ་རང་ཀུན་ནས་སློང་བར་བྱེད་པ་གང་དགཞན་ལ་རྣམ་པར་རིག་པར་བྱེད་པ་མ་ཡིན་པས་ན་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་ཞེས་བརྗོད་པ་ཡིན་ནོ།",
    "མོའི་ཁམས་ནི་དྲོ་བའོ།"
