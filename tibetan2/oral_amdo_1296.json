    "དབུ་རུ་སྟེ་དེང་སང་གི་ལྷ་སའི་ཉེ་འཁོར་རྣམས་ཡུམ་བརྟན་གྱིས་བཟུང་ནས་དབུ་གཡོར་འཁྲུག་པ་རྒྱལ་རབས་གསལ་མེ་ལས།",
    "འོད་སྲུང་གིས་གཡོ་རུ་བཟུང་ནས་འཁྲུག་པ་བྱས་སོ་ཞེས་པ་ལས་གསལ་བར་ནུས།",
    "དེ་ནས་དབུ་གཡོའི་ཟིང་འཁྲུག་གི་ཡོ་ལང་ཤན་དེ་གང་སར་ཁྱབ་སྟེ།",
    "མཐར་ཡུམ་བརྟན་གྱི་ཕྱོགས་གཏོགས་རྣམས་འོད་སྲུང་ལས་རྣམ་པར་རྒྱལ་ནས་དབུ་རུའི་ཕྱོགས་སུ་གཞི་རྐང་བརྟན་པོ་ཚུགས་ཐུབ་པ་བྱུང་བ་རེད།",
    "ཐེངས་དེའི་དབུ་གཡོར་འཁྲུག་འཛིང་དེས་གོང་བུ་གཅིག་གྱུར་གྱི་སྤུར་རྒྱལ་བཙན་པོའི་རྒྱལ་རབས་ཐོར་ཞིག་ཏུ་སོང་ནས།",
    "བྱང་དང་སྣང་གིས་མ་ཕྱར་བྱས་ནས་ནི།",
    "སྣ་མོ་ཡར་རྩེ་མར་རྩེ་གཉིས་ལ་བསྟེན།",
    "འབྲོ་དང་སྦས་གཉིས་བཙན་པོའི་གདུང་རྒྱུད་ཀྱི་སྲས་གཉིས་ལས་གང་གི་ཕྱོགས་སུ་གཏོགས་པའི་སྐོར།",
    "བློན་པོ་ཐེ་རང་སྤྲ་མགོ་ཅན་སྦས་རྒྱལ་ཏོ་རེ་སྟག་སྣ།",
    "དབས་ནི་ཡུམ་བརྟན་ཕྱོགས་གཏོགས་ཡིན་ན་འབྲོའི་བློན་ཚོགས་རྣམས་འོད་སྲུང་གི་ཕྱོགས་སུ་སྣང་བས།",
    "འོད་སྲུང་གི་མེས་མོ་སྟེ་བཙན་པོ་དར་མ་འུ་དུམ་བཙན་གྱི་ཡུམ།",
    "ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་བཙུན་མོ་ལྷ་རྒྱལ་མང་མོ་རྗེ་ནི་འབྲོ་ཚང་ནས་བཞེས་པའི་བཙུན་མོ་ཞིག་ཡིན་པ་དང་།",
    "འབྲོ་རྒྱུད་ཀྱི་མེས་པོ་རྣམས་སྔར་ནས་སྤུ་རྒྱལ་བཙན་པོར་ཁ་ཞེ་གཉིས་མེད་ཀྱིས་སྲི་ཞུ་བསྒྲུབས་པའི་གཤིས་བཟང་འདི་འབྲོ་རྒྱུད་ཀྱི་བློན་རབས་ཕྱི་མ་རྣམས་རྒྱུད་འཛིན་ནས་སྔར་བཞིན་རང་ཉིད་ཀྱི་དབོན་པོ་འོད་སྲུང་གི་ཕྱོགས་སུ་ལངས་ནས་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་ཡོད་པ་ནི་འགྲོ་བ་མིའི་རང་གཤིས་དང་མཐུན་ཤས་ཆེ།",
    "དེའི་ཐད་ནས་འབྲོ་ནི་དབུ་གཡོར་འཁྲུག་པའི་སྐབས་འོད་སྲུང་གི་ཤོག་ཁག་ཏུ་གཏོགས་པ་བདེན་དཔང་ཁ་གསལ་བྱས།",
    "ཤིང་མོ་བྱ་ལོ་ལ།",
    "འབྲོ་གཙུག་དགྲ་ལྷ་སྡོང་གིས་བྱས།",
    "འབྲོ་ནི་དབུ་གཡོར་འཁྲུག་ཟིང་སྐབས་འོད་སྲུང་གི་ཕྱོགས་གཏོགས་ཡིན་པ་སླར་ཡང་ར་སྤྲོད་ཁ་གསལ་བྱ་ཐུབ།",
    "འབྲོ་སྦས་འཁྲུག་པའི་གཞི་མ་ཡང་འོད་སྲུང་དང་ཡུམ་བརྟན་དགྲ་འཛིན་ཕྱོགས་ཁག་གཉིས་སུ་གྱེས་ནས་འོད་སྲུང་གི་ཕྱོགས་སུ་འབྲོ་དང་ཡུམ་བརྟན་གྱི་ཕྱོགས་དབས་ཡིན་པའི་རྐྱེན་གྱིས་འབྲོ་དབས་བློན་ཚོགས་གཉིས་སྡང་དགྲར་གྱུར་ནས་འཐབ་པའོ།",
    "དབས་ནི་ཆེན་མོ་སྣ་ནམ་བཟའི་ཆབ་སྲིད་ཤོག་ཁག་ཏུ་ཡིན་པ་གོང་དུ་གླེང་ཟིན་པས།",
    "རྔོག་རྒྱལ་ཏོ་རེ་རྒྱལ་རྣམས་ཀྱིས་བྱས།",
    "གཞན་ཡང་བཙན་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་བཙུན་མོ་འབྲོ་བཟའ་ཁྲི་རྒྱལ་མོ་བཙན།",
    "གཅིན་འདྲེན་སྦུ་གུ་རྒྱུ་གྲོག་རྩ་སྟ་ཟུར་ནང་གི་འཕར་རྩ།",
    "དེ་ནི་རང་རེའི་བརྩེ་བར་འོས་པའི་བུད་མེད་མ་ཡུམ་རྣམས་གཟུགས་ཁམས་བདེ་ཐང་ངང་བྱ་ལས་སྣ་ཚོགས་གཉེཪ་རྒྱུ་དང་བུ་ཕྲུག་སྐྱེད་སྲིང་ལེགས་པོ་ཡོང་བ་བཅས་ལ་ཕན་པ་ཆེ་ཆེར་ལྡན་པས་དཔེ་སྐྲུན་འགྲེམས་སྤེལ་སོང་སྟེ་བུད་མེད་མ་ཡུམ་རྣམས་ལ་ལེགས་སྐྱེས་སུ་ཕུལ་བ་ལགས་ན།",
    "སྤྱིར་བཏང་གི་སྐྱེ་ལམ་གཉན་ཚད།",
    "བསམ་བློ་རྙིང་པས་བཅིངས་པའི་བུད་མེད་ཀྱི་གོ་གནས།",
    "བུད་མེད་བཅུ་གཉིས་ལོན་ནས་ལྔ་བཅུའི་བར།",
    "དྭངས་མ་ལས་བྱུང་ཟླ་རེར་བསགས་པའི་ཁྲག།",
    "དེའི་རིགས་ལ་དོ་སྣང་བྱེད་དགོས་པ་ཞིག་ནི་གཉེན་སྒྲིག་བྱས་ཟིན་པའི་བུད་མེད་ཅིག་ཡིན་ན།",
    "སྐྲན་ཡོད་ན་སྐྲན་གྱི་ཆེ་ཆུང་བཅས་གསལ་པོ་ཤེས་ཐུབ་མོད།",
    "ལུས་སྟོད་སྨད་ཀྱི་རུས་པ་དང་ལྷག་པར་དཔྱི་སྐེད་བརླ་རྐང་གི་རུས་པ་རྣམས་ཁོལ་ཞིང་ན་བ་དང་།",
    "གཉིད་མི་ཁུག་པརྐང་ལག་གི་མཐིལ་བཞིར་ཚ་བ་རྒྱག་པ།",
    "སྐབས་རེ་ཟས་འཇུ་དཀའ་བ།",
    "ཡང་ན་སྐྱེ་ལམ་ནས་ཟགས་ཁུ་འབབ་ལ་ཟླ་མཚན་མི་ཆོད་པར་རྒྱུན་དུ་འབྱམས་པར་བྱེད་པའམ་རེས་འགའ་ཟླ་མཚན་འཁྱིལ་ཏེ་དུས་སུ་མི་འབབ་པ་སོགས་ཀྱི་གནས་ཚུལ་ཡོད།",
    "སྐྱེས་འགོག་གི་གཤག་བཅོས་བྱས་པའམ་ཡང་ན་ཕྲུ་གུ་བཙས་རྗེས་མངལ་རྩ་གྲམ་ནས་རྩ་ཕྲན་དག་འགགས་པ།",
    "བུ་སྣོད་ཆུང་བ་ནི་བུད་མེད་དེ་ཉིད་ཀྱི་ལང་ཚོའི་ཆ་ཤས་ཡོངས་སུ་རྫོགས་ན་ཡང་།",
    "བུ་མོའི་ནུ་མ་ཆུང་བ་སྟེ་ནུ་མའི་འཚར་ལོངས་ཞན་པ།",
    "སྐྱེ་ལམ་དུ་ཚ་ཤུར་རྒྱག་གི་ཡོད།",
    "ཉི་ཟླ་གྱེན་ཟློག་ཚ་སྦྱོར་ཆེན་མོ།",
    "སྐབས་རེ་རྒྱུ་ཞབས་སྦོས་བརྒྱངས་བྱེད་པ་དང་།",
    "དཀའ་ཚེགས་ཐལ་ཆེ་བ་དང་།",
    "མངལ་ཆགས་ནས་ཉིན་ཞག་སུམ་ཅུ་སོང་བའི་དུས་སྐྱུག་མེར་ལངས་པའམ་སྐྱུག་པ་བསྐྱུགས་པ།",
    "གུར་ཀུམ་བརྒྱད་པ་ཁ་ཚར་ཐང་ཆེན་ཉེར་ལྔ་དང་གུར་ཀུམ་བརྒྱད་པའི་སྟེང་དོམ་མཁྲིས་ནས་རྡོག་ཙམ་རེ་སྣོན་དགོས་བརྒྱད་ལྔ་བཅས་བཏང་ནས་ངལ་གསོ་རྒྱག་དགོས།",
    "རྐང་པ་གཉིས་སྐྱིལ་ཀྲུང་གི་ཚུལ་དང་།",
    "པུས་མོ་གཉིས་དང་ལག་པའི་གྲུ་ཚིགས་གཉིས།",
    "ཐོད་པ་བཅས་ས་ལ་བཙུགས་ཏེ་འཕོངས་གྱེན་དུ་བསྟན་ནས་ཉིན་ལྔའི་ནང་ཉིན་རེར་ཆུ་ཚོད་སྐར་མ་བཅོ་ལྔ་ཙམ་བསྡད་ན་ལེགས་བསྒྱུར་བྱེད་ཐུབ།",
    "བུད་མེད་གང་ཡང་ཟླ་མཚན་འཛག་སྟེ་མངལ་གྱི་ཁ་བྱེ་ནས་མི་ཟུམ་པར་གནས་པའི་དུས་ནི་ཞག་གྲངས་བཅུ་གཉིས་པར་ཡིན་ཞིང་།",
    "མངལ་ལེན་པའི་ཞག་བཅུ་གཉིས་ཀྱི་དུས་སུ་འཁྲིག་པ་སྤྱད་ཚེ་མའི་མངལ་ཁ་བྱེ་ཡོད་པས་ཕའི་ཁུ་བ་མའི་མངལ་དུ་འཇུག་ནས་བདུན་ཕྲག་གཅིག་སོང་བ་ལ།",
    "བདུན་ཕྲག་གསུམ་པ་ལ་གོང་གི་ནུར་ནུར་པོ་དེ་ཞོ་ཆགས་ཟིན་པ་ལྟར་བསྐ་བའི་རང་བཞིན་ཅན་དུ་འགྱུར་བར་བྱེད་པ་ཡིན།",
    "དེ་ལས་ཕོ་མོ་མ་ནིང་རིམ་པར་འགྱུར།",
    "གཉིས་པ་ལྟར་མེར་མེར་པོར་གྱུར་ཚེ་བུ་མོ།",
    "མོ་རྩ་ཆགས་ན་མེར་མེར་པོར་འགྱུར།",
    "མ་བུ་གཉིས་ཀ་ལ་ཕན་ཞིང་འཕྲོད་པའི་ཟས་སྐོམ་འགའ་ཞིག་མཉམ་དུ་བསྲེས་ནས་ཅུང་ཟད་རེ་བྱིན་པར་བྱ་དགོས་པ་ཡིན།",
    "བཅུ་དྲུག་པ་ལ་སོར་མོ་ཉི་ཤུ་དོད།",
    "རྩ་གསུམ་སྐྲ་དང་བ་སྤུ་སེན་མོ་སྐྱེ།",
    "མ་དང་བུ་གཉིས་ཐང་རེ་གཟི་མདངས་འཕོ།",
    "སེན་མོ་བཅས་ཀྱི་དབྱིབས་རྣམས་སྐྱེ་བ་ཡིན་ཞིང་།",
    "དུས་འདིར་ཕལ་ཆེར་བཙའ་བའི་སྐབས་སུ་བབས་མེད་མོད།",
    "འོན་ཀྱང་རྐྱེན་འགའ་ཞིག་གིས་བཙའ་བར་ཡང་སྲིད་པ་ཡིན་པས།",
    "ཟླ་བ་དགུ་པ་ནས་ཞག་ལྔ་གོང་དུ་བཅད་པའི་འཕྲོས་བདུན་ཕྲག་གསུམ་ལྷག་ཙམ་ཡོད་པ་དག་གོང་གི་སྟེང་དུ་བརྩེགས་པའི་བདུན་ཕྲག་སོ་དྲུག་པའི་ཉིན་ཞག་དང་པོ་ནས་བཟུང་མངལ་གནས་ཀྱི་བྱིས་པ་དེ་རང་གི་གནས་ལ་མི་གཙང་བའི་འདུ་ཤེས་དང་།",
    "མུན་ནག་གི་འདུ་ཤེས།",
    "མངལ་ཆགས་ནས་ཟླ་བ་བདུན་པ་བདུན་ཕྲག་རྩ་བདུན་ནས་ལུས་ཡོངས་གསལ་པོར་རྫོགས་པས་ན་བདུན་ཕྲག་གཉིས་རེར་བརྟག་དཔྱད་ཐེངས་གཅིག་བྱེད་དགོས།",
    "ཟླ་བ་བརྒྱད་པ་བདུན་ཕྲག་སོ་གཅིག་ཐམས་ཅད་ཆེར་འཕེལ་བས་ན་གཟའ་འཁོར་རེར་བརྟག་དཔྱད་ནས་ཇཐེངས་རེ་བྱེད་དགོས།",
    "བུ་སྣོད་ཀྱི་མཐིལ་ཞབས་ཆེ་ཞིང་ངེས་གཏན་མེད་པའི་དངོས་པོ་ཟླུམ་པོ་ཅུང་སྲ་མཁྲེགས་ཅན་ཞིག་ལ་རེག་ཐུབ་པ་ནི་ཆུའི་སྟེང་གི་ལྒང་བུ་ལ་རེག་པའི་ཚོར་སྣང་ཡོད།",
    "མངལ་གནས་སྦྲུམ་བུ་རྒྱུན་ལྡན་གྱི་དབུགས་ཀྱི་རྒྱུ་བ་ནི་ཆུ་ཚོད་སྐར་མ་རེར་ཡིན་པ་དང་།",
    "གལ་ཏེ་ཆུ་ཚོད་སྐར་མ་རེར་ལན་ཡི་གཡས་གཡོན་ལས་མི་འཕར་བའམ་ཡང་ན་ལས་བརྒལ་བ་ཡིན་ན་མངལ་གནས་ཀྱི་ཚེ་སྲོག་ལ་ཉེན་ཁ་ཆེ།",
    "སྦྲུམ་མའི་ལྟོ་བར་ཐིག་ཚད་བླངས་ན་ཕྲུ་གུ་ཟླ་བ་གང་གི་ནང་དུ་སྐྱེས་མིན་ཤེས་ཐུབ།",
    "པ་ལྟེ་བ་ནས་མར་སོར་གཅིག་གི་བར།",
    "ལྟེ་བ་ནས་ཡར་སོར་གང་གི་བར།་",
    "བར་མཚམས་ཀྱི་དུས་ཚོད་ཐུང་དུ་ཕྱིན་ནས་ཕལ་ཆེར་ཆུ་ཚོད་སྐར་མ་གཉིས་གསུམ་གྱི་ནང་དུ་སྐྱེ་ཟུག་ཐེངས་རེ་ལངས་ཏེ་ཕྲུ་གུའི་མགོ་མར་བབས་པ་དང་།",
    "ངུ་འབོད་བྱེད་ཀྱི་མེད་ན་ཕྲུ་གུའི་འཕོངས་ལ་ཐལ་ལྕག་ག་ལེར་གཞུས་ཏེ་ངུ་འབོད་བྱེད་དུ་བཅུག་སྟེ་དབུགས་གཏོང་རྒྱུར་སྐུལ་འདེད་གཏོང་དགོས།",
    "ཕྲུ་གུའི་འཕོངས་དང་རྐང་མཐིལ་ལ་ཐལ་ལྕག་མ་གཞུས་ན་བཟང་།",
    "འཕོངས་དང་རྐང་མཐིལ་ལ་ཐལ་ལྕག་གཞུས་ན།",
    "ལྷག་པར་དུ་ཕྲུ་གུའི་རྐང་མཐིལ་ལ་ཐལ་ལྕག་གཞུས་ན།",
    "ཁ་མིག་གཞོགས་ཕྱེད་འཁྱོག་པའི་ཉེན་ཁ་ཡོད།",
    "བྱིས་པའི་ལྟེ་བ་འཕར་མཚམས་བཞག་པའི་རྗེས་སྔོན་ལ་ལྟེ་བའི་རྩ་བ་ནས་སོར་དྲུག་དང་བརྒྱད་སོ་སོའི་མཚམས་ནས་སྐུད་པ་ཕྲ་མོས་དམ་པོར་བསྡམས་པའི་དཀྱིལ་ནས་དུག་སེལ་ཆ་བྱད་ཀྱིས་གཅོད་དགོས།",
    "སླར་ཡང་ལྟེ་བའི་རྩ་བ་ནས་སོར་གང་དང་དོ་སོ་སོའི་མཚམས་སུ་དུག་སེལ་བྱས་པའི་སྐུད་པས་དམ་པོར་དཀྲིས་པ་དང་མདུད་པ་གཉིས་རེ་བརྒྱབ་རྗེས་དུམ་བུ་ལྷག་མ་རྣམས་དུག་སེལ་བྱས་པའི་ཆ་བྱད་ཀྱིས་བཅད་རྗེས་སྣེ་མོ་སང་རས་གཙང་མས་བཏུམ་སྟེ་སང་རས་གཞན་ཞིག་གིས་རྐེད་པར་དཀྲི་དགོས།",
    "ཕྲུ་གུ་དང་ཤ་མ་བཏོན་རྗེས་སྐྱེ་བསུ་བྱེད་མཁན་དང་ནང་མི་དག་གིས་ཕྲུ་གུ་དང་བྱ་བ་གཞན་དག་ལ་མགོ་འཁོར་ཏེ་ཕྲུ་གུའི་མ་ལ་ཡིད་གཟབ་མ་བྱས་ན།",
    "ཡང་བུད་མེད་ཁག་གཅིག་ལ་ཕྲུ་གུ་སྐྱེས་ནས་ཉིན་བཅུ་ནས་བཅོ་ལྔའི་བར་ཁྲག་མང་པོ་མི་ཡོང་བར་ཆུ་ཚོད་ཉེར་བཞིའི་ནང་དུ་ཧྲའོ་ཧྲེང་བར་ཡོང་བ་དང་།",
    "སྐབས་རེ་རྒྱུ་ཞབས་ལ་འཐེན་ཟུག་ཡོད་པ་ལྟ་བུའི་ན་ཟུག་གཏོང་བ།",
    "རང་བཞིན་གྱིས་བརྡོལ་བ་ནི་ཕྲུ་གུ་གཉིས་གསུམ་སྐྱེས་པའི་ཁར་ད་དུང་ཐེངས་ཁ་ཤས་བཀོག་པས་བུ་སྣོད་ནང་སྐྱི་སྲབ་ཏུ་སོང་ནས་བརྡོལ་བ་ཡིན།",
    "བརྡོལ་བའི་གནས་སུ་མནན་ན་གྲིས་བསྣུན་པ་བཞིན་ན་ཟུག་གཏོང་གི་ཡོད།",
    "ཁྲག་རིལ་དཀར་པོ་རྒྱུན་ལྡན་ལས་མཐོ་རུ་སོང་ཡོད་པ་དང་།",
    "ཕོ་མོ་གཉིས་གཉེན་སྒྲིག་གི་ལོ་ཚད་ལོན་ནས་གཉེན་སྒྲིག་བྱས་ཏེ་ལོ་གསུམ་བཞི་སོང་ཡང་མངལ་མི་ཆགས་པར་ཟེར།",
    "སྐབས་རེ་རླིག་འབྲས་སྐྲངས་ཏེ་ཚ་བ་རྒྱག་པ།",
    "ཚ་སྦྱོར་ཆེན་མོ་དང་།",
    "ལ་ལས་རང་ཁྱིམ་གྱི་ལས་ཀ་ཙག་ཙིག་གི་དོན་དུ་སྔ་པོ་ནས་བུ་མོར་མག་པ་ལེན་པའམ་བུ་ལ་མནའ་མ་ལེན་པ་དང་།",
    "ད་ལྟའི་བར་སྣང་ཚུལ་འདིར་ཞིབ་འཇུག་བྱས་ཐོག་དགེ་སྐྱོན་སྤང་བླང་གི་གསལ་ཁ་བགྱིས་པ་ཤིན་ཏུ་ཉུང་མོད།",
    "བུད་མེད་དང་སྐྱེས་པ་གང་ཡིན་རུང་ལོ་བཅུ་དྲུག་ཡས་མས་ཀྱི་བར་གཟུགས་ཁམས་དཪ་ལ་བབ་པའི་མགོ་ཚུགས་པའི་དུས་ཡིན་པས།",
    "དུས་འདི་དང་ཡང་ན་འདིའི་ཡར་སྔོན་དུ་གཉེན་སྒྲིག་བྱས་ན་ཕོ་མོ་གང་ཡིན་རུང་བདེ་ཐང་ལ་གནོད་སྐྱོན་ཤིན་ཏུ་ཆེ་བ་མ་ཟད་བུད་མེད་ལ་ལར་མཚོར་ན་སྐྱེ་ལམ་གྱི་རྩ་ཕྲན་ཆད་ནས་ཟུངས་ཁྲག་མང་པོ་ཤོར་ཏེ་ཚེ་སྲོག་ལ་ཡང་ཉེན་ཁ་ཡོང་གི་ཡོད།",
    "རང་ལོ་ཉི་ཤུ་ལ་མ་སླེབས་པར་གཉེན་སྒྲིག་བྱས་ཏེ་མངལ་སྦྲུམ་པ་ཡིན་ན་སྐབས་འདིར་བུད་མེད་ཀྱི་ལུས་ཁམས་ལ་འཚར་ལོངས་བྱུང་མེད་པས་བུད་མེད་དར་བབ་ལས་མཚང་ཁོག་ཆུང་བས་ཕྲུ་གུ་བཙའ་དཀའ་བས་མ་བུ་གཉིས་ཀྱི་བདེ་ཐང་དང་ཚེ་སྲོག་ལ་བར་ཆད་འབྱུང་སླ་བ།",
    "དེ་བཞིན་སྐྱེས་པའི་ཁུ་བ་ནི་ལུས་ཟུངས་བདུན་གྱི་དྭངས་མ་ཡིན་པས་དུས་མིན་དུ་ཕྱི་རུ་འཕོ་ན་བུད་མེད་ལས་སྐྱེས་པའི་གཟུགས་ཁམས་འཚར་ལོངས་ཡོང་བར་གནོད་སྐྱོན་ཤིན་ཏུ་ཆེ།",
    "ནུ་མར་བསྣད་སྐྱོན་ཤོར་བ་སོགས་ཀྱིས་སློང་གི་ཡོད།",
    "གོང་གི་གཉེན་པོ་དེ་དག་གིས་གཉན་ཚད་གཅོག་མ་ཐུབ་པར་རྣག་ཚད་སྐྱེས་ནས་རྣག་ཏུ་འཁྱིལ་ན།",
    "གཉེན་པོ་གཞང་དུ་མ་བཅུག་པའམ་མ་བཏང་གོང་གི་ཉིན་གཉིས་ཀྱི་སྔོན་ལ་ཁ་ཟས་མངར་མོའི་རིགས་མང་དུ་ཟ་བ་དང་དེ་ནི་སྲིན་ལངས་བྱེད་ཀྱི་ཐབས་ཡིན།",
    "སྦྲུམ་མ་དང་བུད་མེད་དར་མ་ལ་ལར་མོ་གཤིས་སྐུལ་རྩི་མཐོ་བས་མངལ་སྐེར་ཁྲག་རྒྱས་པ་དང་ཡང་ན་མོ་གཤིས་སྐུལ་རྩི་ཉམས་པས་སྐྱེ་ལམ་ལ་གཙང་སེལ་བྱེད་པའི་ནུས་པ་ཉམས་པ།",
    "མངལ་སྐེའི་རྨེན་བུའི་འཛག་ཐོན་བྱེད་ལས་ཆེར་སོང་བའམ་ཉམས་རྒུད་དུ་གྱུར་པ།",
    "སྐབས་རེར་གྲང་བའི་ནང་དུ་ཁྲག་འདྲེས་ཏེ་འཛག་པ།",
    "དེ་དུས་གསང་འབྱིད་ཆ་བྱད་སྤྱད་ནས་སྐྱེ་ལམ་འབྱེད་དེ་སྲིང་བལ་དུག་སེལ་ཅན་དེ་སྐམ་པས་བཙིར་ནས་མངལ་སྐེ་ཡི་གྲང་བ་ཕྱིས་རྗེས་འབྲུམ་བུ་མངལ་སྐེ་ཡི་གཞི་ཁྱོན་གཅིག་ནས་གཉིས་ལ་སླེབས་ཡོད་པ་ཤེས་ཐུབ།",
    "དེར་སྲིང་བལ་དུག་སེལ་ཅན་གྱིས་འབྲུམ་པའི་སྟེང་དུ་མནན་དུས་སྲིང་བལ་དུག་སེལ་ཅན་དེ་ཁྲག་གིས་རྫིས་ཡོང་།",
    "དེར་སྲིང་བལ་དུག་སེལ་གྱིས་རེག་ན་རྨ་འབྲུམ་གྱི་ཁྱབ་ཁོངས་མངལ་སྐེའི་གཞི་ཁྱོན་སུམ་ཆ་གཉིས་ནས་གསུམ་བར་ཟིན་ཡོད་པ་དང་འབྲུམ་གཟུགས་རིལ་རིལ་ཡིན་པ་བཅས་ནི་འབྲུམ་གསར་མིན་པས་ཅུང་གསོ་དཀའ།",
    "གྱོན་ཆས་བརྗེ་རེས་བྱས་ཏེ་གྱོན་པ།",
    "འགྲོ་འདོད་ལ་སྐྱེས་པ་འདོད་ཅིང་ཤ་སྐམ་ལ་མོ་མཚན་གྱི་དྲི་མ་ཤིན་ཏུ་མནམ་ཞེས་གསུངས་ཡོད།",
    "སྐྱེ་སྒོ་སྲིང་བལ་དུག་སེལ་ཅན་གྱིས་འཕྱི་དགོས་པ་ལས་མཛུབ་མོ་གཉིས་ཀྱིས་སྐྱེ་ལམ་ལ་བརྟག་དཔྱད་བྱེད་མི་རུང་།",
    "གོང་གི་དོ་སྣང་ལ་ཡིད་གཟབ་མ་བྱས་ན་སྐྱེ་ལམ་ལ་མི་གཙང་བའི་ཕྲ་ཕུང་འཛུལ་འགྲོ་བའི་ཕྱིར།",
    "སྲིན་འབུའི་མགོར་རེག་སྤུ་བཞི་ཡོད་པ་དང་མཇུག་སྣེར་རེག་སྤུ་གཅིག་ཡོད་པ་སྟེ་རླབས་འགུལ་སྐྱི་མོའི་ཕྱི་རུ་འབྲེལ་ཡོད།",
    "མཛུབ་མོ་ཤིང་བུས་ཕྲུགས་པས་སྲིན་ཁྲོས་ཏེ།",
    "གྲང་བར་ཕྲ་མཐོང་ཆེ་ཤེལ་གྱིས་བརྟག་ན་སྲིན་འབུའི་དབྱིབས་ནི་སྒོར་དབྱིབས་གོར་མོའི་གཟུགས་དང་འདྲ་ལ་དེའི་མཐར་བ་སྤུ་ཡོད་པ་དེ་དག་འགུལ་སྐྱོད་བྱེད་བཞིན་ཡོད་པ་དང་།",
    "འདིར་མངལ་གྱི་སྲིན་འབུ་མ་རུ་རྩེ་ལང་བའི་སྐབས་ལྟར་བཅོས་དགོས་པ་དང་དེའི་ཕན་འབྲས་མངོན་གསལ་མེད་ན་ལུག་གི་མཆན་ཁུང་འོག་གི་བལ་དགོས།",
    "ལུག་གི་མཆན་ཁུང་འོག་གི་བལ་ནི་ཞག་རྩི་ཆེ་ཤོས་ཡིན་པས་སྐྱེ་ལམ་གྱི་སྲིན་འབུ་ལངས་ཁྲོས་གཉིས་ནི་ནང་ཁྲོལ་མེད་པའི་སྲིན་འབུའི་རིགས་ཡིན་པས་ཞག་རྩི་དེ་སྲིན་འབུའི་ཁོང་དུ་ཕྱིན་ན་ཞི་བར་གྱུར་ནས་སྲིན་འབུ་ཤི་འགྲོ་བ་ཡིན།",
    "བསམ་བསེའུ་བྱེད་ལས་ཉམས་རྒུད་དུ་སོང་སྟེ་ཟགས་ཐོན་གྱི་མངར་ཆའི་ཚད་སྐྱེ་ལམ་དུ་འགྲོ་མ་ཐུབ་པ།",
    "མོ་གཤིས་སྐུལ་རྩི་ཉུང་དུ་སོང་བ་དང་སྐྱེ་ལམ་གྱི་གཤེར་རྨེན་དེ་དག་གི་ནུས་པ་ཉམས་པ་བཅས་ཀྱིས་སྐྱེ་ལམ་ལ་གཙང་སེལ་བྱེད་མི་ཐུབ་པར་སྐྱེ་ལམ་རུབ་པའམ་འབྱར་བས་གཉན་ཚད་རྒྱས་ནས་བྱུང་བ་ཡིན།",
    "གྲང་བ་དཀཪ་སེཪ་དྲི་ངན་ཅན་འཛག་པ་དང་སྐབས་རེ་སྐྱེ་ལམ་ལ་ཚ་ཤུཪ་རྒྱག་པ།",
    "སྤྱིར་བཏང་གི་སྐྱེ་ལམ་གཉན་ཚད།",
    "སྤྱིར་བཏང་གི་སྐྱེ་ལམ་གཉན་ཚད་ལ་རྒྱུ་རྐྱེན་དབྱེ་བ་རྟགས་དང་བཅོས་ཐབས་བཞི་ལས།",
    "སྐབས་རེ་སྐྱེ་ལམ་ལ་ཚ་ཤུར་རྒྱག་པ།",
    "བསམ་བློ་རྙིང་པས་བཅིངས་པའི་བུད་མེད་ཀྱི་གོ་གནས།་",
    "འདིར་བརྗོད་པའི་བསམ་བློ་རྙིང་པ་ཞེས་པ་ནི་བཀས་བཀོད་རྒྱུད་འཛིན་རིང་ལུགས་ཀྱི་བསམ་བློས་བུད་མེད་རྣམས་ལ་བཟུང་བའི་ལྟ་ཚུལ་ལ་ཟེར།",
    "དེ་ཡང་ཇི་སྐད་དུ་བུད་མེད་ཐམས་ཅད་ཉེས་རྒུའི་འབྱུང་གནས་ཡིན་ཞེས་དང་།",
    "བུ་མོའི་སྐྲ་སྣེ་རིང་ཡང་བློ་སྣ་ཐུང་།",
