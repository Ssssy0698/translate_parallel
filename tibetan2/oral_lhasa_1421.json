    "སྨྲས་པ་ཞེས་བྱ་བ་ནི་ཇི་སྲིད་ཀྱིས་བརྗོད་པར་འདོད་པའི་དོན་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའི་ངག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནས་ལྷའི་བུ་དེ་དག་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ།",
    "ཀྱེ་མ་འཕགས་པ་རབ་འབྱོར་འདི་ནི་ཡུམ་གསལ་བར་བྱེད་པ་སྟེ་ཟབ་པ་བས་ཀྱང་ཤིན་ཏུ་ཟབ་པ་སྟོན་པར་བྱེད་ཕྲ་བ་བས་ཀྱང་ཤིན་ཏུ་ཕྲ་བ་སྟོན་པར་བྱེད་པའོ་ཞེས་པའི་དོན།",
    "དེ་ནི་རྣམ་པར་ལྔར་རིག་པར་བྱ་སྟེ།",
    "རིགས་དང་ལམ་དང་ཡང་དག་པར་འགྲུབ་པ་དང་གནས་པ་དང་རྒྱུབའོ།",
    "དེ་ནི་མཚན་ཉིད་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "བདེན་པ་ལ་མཁས་པར་བྱེད་དེ་དེ་ནི་རང་སངས་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཤིན་ཏུ་ཚངས་པར་སྤྱོད་པའི་མཐར་གྱུར་པའི་དགྲ་བཅོམ་པ་ཉིད་ཐོབ་པར་ནི་མི་ནུས་ཏེ།",
    "ཤིན་ཏུ་ཚངས་པར་སྤྱོད་པའི་མཐར་གྱུར་པའི་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཕུང་པོ་ལ་མཁས་པ་དང་།",
    "དེ་ལ་ཡང་༢༧གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས།",
    "ཤིན་ཏུ་ཚངས་པར་སྤྱོད་པའི་མཐར་གྱུར་པའི་འབྲས་བུའི་མཆོག་དགྲ་བཅོམ་པ་ཉིད་ཐོབ་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་འགྲུབ་པ་གཉིས་པ་དང་གསུམ་པས་ནི་ཚོགས་དང་སྤྱོད་པའི་རང་རྒྱལ་བར་འགྱུར་ཏེ་བསེ་རུ་ལྟར་སྤྱོད་པར་མི་འགྱུར་རོ།",
    "ཞེ་འགྲས་པ་རྣམས་བཟློག་པའི་ཕྱིར་རྫུ་འཕྲུལ་གྱི་ཡུལ་རྣམ་པ་དུ་མ་སྟོན་པར་བྱེད་དོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་སྔོན་མ་བསྐྱེད་པའམ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་སྔོན་བསྐྱེད་པ་དང་།",
    "རྣམ་པར་མ་བརྟགས་རྣམ་པར་མ་དཔྱད་པར་ཚིག་ཏུ་མི་སྨྲ་བས་བརྗོད་པ་ནི་རྣམ་པར་གཡེང་བ་ཡིན་ལ།",
    "དེ་ཡང་རྒྱུད་འཁྲུག་པར་བྱེད་པ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པས་སོ།",
    "རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་བ་དང་།",
    "ལྷའི་བུ་དག་དེ་ལྟ་བས་ན་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་གནས་པར་འདོད་ཅིང་།",
    "ལྷའི་བུ་དག་དེ་ལྟར་བྱང་སེམས་ཆེན་པོས་སེམས་དང་པོ་བསྐྱེད་པ་ནས་བརྗོད་པ་དང་མཉན་དུ་མེད་པ་ལས་བཟུང་སྟེ་ཡུམ་ལ་གནས་པར་བྱའོ་ཞེས་པའི་དོན།",
    "དེ་ནས་ལྷའི་བུ་དེ་དག་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ།",
    "བཙུན་པ་རབ་འབྱོར་ཡུམ་འདི་ལྟར་ཟབ་པ་བརྟགས་པར་བྱ་བ་མ་ཡིན་པ་རྟོག་གེའི་ཡུལ་མ་ཡིན་པ་ཕྲ་ཞིང་ཞིབ་པ་ལྟ་དཀའ་བ་རྗེས་སུ་རྟོགས་པར་དཀའ་བ།",
    "འདི་ལྟར་ཟབ་པ་ལ་སོགས་པ་འདི་ལེན་པར་འགྱུར་ཏེ།",
    "ཡུམ་འདི་ལྟར་ཟབ་པ་ལ་སོགས་པ་འདི་ལེན་པར་འགྱུར་བ་དེ་དག་ནི་ངེས་པ་ཁོ་ནར་གཟུགས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྟོང་པ་ཉིད་གཟུགས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཞི་བ་དང་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་གཟུགས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "རྣམ་མཁྱེན་དང་འདུས་བྱས་ཀྱི་ཁམས་ཀྱི་བར་ལ་སྦྱར་བ་དང་།",
    "ལྷའི་བུ་དག་ཡུམ་དེ་ལྟར་ཟབ་པ་ལ་སོགས་པ་དེ་ལ་ལེན་པར་བྱེད་པ་སུ་ཡང་མེད་དོ།",
    "དེ་ནས་རབ་འབྱོར་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ།",
    "ཡང་དག་བསྡུས་པར་ཤེས་པར་བྱ།",
    "འགྲིབ་པར་བྱ་བའི་ཕྱིར་མི་སློབ་བོ།",
    "གང་གཟུགས་འཕེལ་བར་བྱ་བ་དང་འགྲིབ་པར་བྱ་བའི་ཕྱིར་མི་སློབ་པ་དེ་ནི་གཟུགས་ཡོངས་སུ་གཟུང་བར་བྱ་བ་དང་མེད་པར་བྱ་བའི་ཕྱིར་མི་སློབ་བོ།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་ལ་གསུངས་པའི་དོན།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་ཡོངས་སུ་གཟུང་བར་བྱ་བ་དང་མེད་པར་བྱ་བའི་ཕྱིར་མི་སློབ་པ་ཡིན།",
    "རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་བ་དང་།",
    "རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་བ་དང་།",
    "གཟུགས་ལ་སོགས་པ་ལ་སྐྱེ་བ་དང་འགག་པ་ལ་སོགས་པ་མེད་པ་ཞེས་བྱ་བའི་རྣམ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས།",
    "འདི་དང་ཉན་ཐོས་ཀྱི་ལམ་གྱི་སྐབས་སུ་བསྟན་པའི་ངེས་འབྱེད་ཆ་མཐུན་གཉིས་ཐེག་ཆེན་གྱི་ཡིན་པར་བཞེད་དེ།",
    "དམིགས་པའི་ཁྱད་པར་གྱིས་ནི་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་སྟོང་པ་ཉིད་ལ་དམིགས་པའི་ཕྱིར་རོ།",
    "རྣམ་པའི་ཁྱད་པར་གྱིས་ནི་གཟུགས་ལ་སོགས་པའི་སྟོང་པ་ཉིད་རྣམས་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་པ་རྣམ་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "སློབ་དཔོན་ལྟར་ན་ཐེག་དམན་གྱི་ཡིན་པར་བཞེད་དེ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་བ་དང་།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་དུ་སྦྱར་བ་དང་།",
    "ཀོའུ་ཤི་ཀ་དེ་ནི་འདི་ལྟར་གཟུགས་ཡུམ་མ་ཡིན་གཟུགས་ལས་གཞན་ཡུམ་མ་ཡིན་དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "ཕན་ཚུན་བརྟེན་པརྟེན་མེད་ཕྱིར།",
    "གང་ལ་བསླབས་ཤིང་རྒྱུན་དུ་ཞུགས་པ་རྣམས་ཀྱིས་ནི་རྒྱུན་དུ་ཞུགས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧པའི་འབྲས་བུ་འཐོབ་བོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ཏེ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པ་མཐའ་ཡས་པའི་ཕྱིར་བྱང་སེམས་ཆེན་པོ་རྣམས་ཀྱི་ཡུམ་འདི་ནི་མཐའ་ཡས་སོ།",
    "ཀོའུ་ཤི་ཀ་དེ་ནི་འདི་ལྟར་རྣམ་པར་ཤེས་པའི་མཐའ་དང་དབུས་མི་དམིགས་པས་སོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་གསུངས་པ་སོགས་ཀྱི་དོན།",
    "གཟུགས་སམ་ཚོར་བའམ་འདུ་ཤེས་སམ་འདུ་བྱེད་རྣམས་སམ་རྣམ་པར་ཤེས་པའམ།",
    "རྣམ་མཁྱེན་ཉིད་ལས་གཞན་ན་ཡང་དེ་བཞིན་གཤེགས་པ་མི་དམིགས་སོ་ཞེས་སོགས་ཀྱི་དོན།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དུ་མི་ལེན་མི་འདོར་བའི་ཚུལ་གྱིས་རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དུ་མཐུན་པར་འཛིན་པ་ངོ་མཚར་ཆེའོ་ཞེས་སོགས་ཀྱི་དོན།",
    "དེ་དག་ནི་ཉམ་ང་བ་མ་སྤངས་པར་དུས་བྱེད་པར་མི་འགྱུར་རོ།",
    "པའི་རིམ་གྲོས་བསྙེན་བཀུར་བྱས་པའི་ཕྱིར་རོ་ཞེས་སོགས་ཀྱི་དོན།",
    "ཀུན་ཆུབ་པར་བགྱིད་པའམ།",
    "རྣམ་མཁྱེན་གྱི་བར་དུ་ཡོངས་སུ་གཟུང་བར་འགྱུར་བ་ཡང་ངོ་མཚར་ཆེའོ་ཞེས་སོགས་ཀྱི་དོན།",
    "རྣམ་པར་བྱང་ཀུན་ཡོངས་བསྡུས་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་གཉེན་པོ་རྣམས་རྣམ་པ་ཐམས་ཅད་དུ་བསྡུས་པ་དང་།",
    "ཡུམ་འདི་ལ་སེམས་རྣམ་པར་གཡེང་བའམ་བརྒལ་བའི་མ་བརྩད་པའམ་འགལ་བར་བྱ་བའི་ཕྱིར་འོང་བར་མི་ནུས་ཏེ།",
    "དེས་སྲོག་ཆགས་ཀྱི་རིགས་དེ་བཟའ་བར་འདོད་ནས་དེའི་རྗེས་སུ་འབྲངས་ཏེ་བསྙགས་པར་གྱུར་ན།",
    "ཀོའུ་ཤི་ཀ་རྒོལ་བ་དང་རྩོད་པ་དང་འགལ་བར་བྱེད་པ་གང་དང་གང་བྱུང་བ་དེ་དག་ཡུམ་གྱི་གཟི་བརྗིད་དང་མཐུས་དེ་དག་མྱུར་དུ་ཞི་བ་དང་མེད་པར་འགྱུར་ཏེ་གང་དང་གང་ནས་བྱུང་བ་དེ་དང་དེ་ཉིད་དུ་མེད་པར་གྱུར་ཞིང་རྣམ་པར་འཕེལ་བར་མི་འགྱུར་རོ་ཞེས་པའི་དོན།",
    "ཡོད་པ་དང་མེད་པར་ལྟ་བ་དང་།",
    "རྟག་པ་དང་བདེ་བ་དང་བདག་དང་གཙང་བ་དང་སྡུག་པར་འདུ་ཤེས་པ་དང་།",
    "སྲེད་པའི་རྣམ་པར་སྤྱོད་པ་དང་།",
    "གཟུགས་ནས་མྱ་ངན་ལས་འདས་པར་འཛིན་པ་ཉེ་བར་ཞི་བར་བྱེད་དེ་རྣམ་པར་འཕེལ་བར་བྱེད་པ་མ་ཡིན་ཏེ་ཞེས་པའི་དོན།",
    "མི་མཇེད་ཀྱི་བདག་པོ་ཚངས་པ་དང་འོག་མིན་གྱི་བར་གྱི་ལྷའི་བུ་དེ་དག་བྱང་སེམས་ཆེན་པོ་གང་ཡུམ་འདི་འཛིན་ཅིང་འཆང་བ་དང་ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་དག་ལ་རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་བསྲུང་བ་དང་བསྐྱབ་པ་དང་སྦ་བར་བྱེད་དོ།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་གྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི་ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ་ཞེས་པའི་དོན།",
    "དེའི་ཚིག་བླང་བར་འོས་པ་དང་དྲན་པར་འགྱུར་རོ།",
    "ཁྲོ་བ་དང་ང་རྒྱལ་གྱི་ཟིལ་གྱིས་ནོན་པར་མི་འགྱུར་རོ།",
    "གཞན་ཡང་དེ་ལ་ཡང་དག་པར་བསྐུལ་བར་འགྱུར་རོ།",
    "དེའི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
    "གཞན་སྲོག་གཅོད་པ་སྤོང་བ་དེ་རྣམས་ཀྱི་ཡང་ལེགས་པ་བརྗོད་པར་འགྱུར་ཞིང་མཐུན་པས་དགའ་བར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་མ་བྱིན་པར་སྤོང་བ་ནས།",
    "ལོག་པར་ལྟ་བ་སྤོང་བའི་བར་ལ་སྦྱར་བ་དང་།",
    "བདག་ཀྱང་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པར་འགྱུར་ཞེས་སོགས་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "རྣམ་པ་ཀུན་མཁྱེན་ཚུལ་ལ་ནི།",
    "བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་དང་།",
    "ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་།",
    "དམིགས་པར་བྱ་བ་དང་དམིགས་པར་བྱེད་པ་མཉམ་པས་མཉམ་པར་ཤེས་པའང་དེ་ཡིན་ཏེ།",
    "སྡུག་བསྔལ་ལ་རྗེས་སུ་རྟོགས་པར་ཤེས་པའི་བཟོད་པ་དང་།",
    "འགོག་པ་ལ་རྗེས་སུ་རྟོགས་པར་ཤེས་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ལམ་ལ་རྗེས་སུ་རྟོགས་པར་ཤེས་པའི་བཟོད་པ་དང་།",
    "དེ་བཞིན་དུ་བདེན་པ་ལྷག་མ་རྣམས་ལ་ཡང་བཟོད་པ་དང་ཤེས་པ་རྣམས་ཅི་རིགས་སུ་ཤེས་པར་བྱའོ།",
    "བཟོད་པ་དང་ཤེས་པ་ཐམས་ཅད་ལ་ཡང་མཚན་མ་མེད་པར་རྟོགས་པའི་རྣལ་འབྱོར་ཅན་དུ་རིགས་པར་བྱའོ།",
    "སོ་སོའི་སྐྱེ་བོ་རྣམས་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་ཅེས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "༢༧མཚོན་པ་ཉི་ཚེ་མཛད་པར་ཟད་དོ།",
    "ལེན་པ་ཡང་མི་དམིགས་ཏེ་དེ་ལྟར་ཡུམ་ལ་སྤྱོད་པའི་བྱང་སེམས་ཆེན་པོ་ཡོངས་སུ་དུལ་བ་དང་ང་རྒྱལ་མ་མཆིས་པའི་སླད་དུ་ཉེ་བར་གནས་པར་འགྱུར་རོ།",
    "བསམ་གཏན་ལ་སྙོམས་པར་འཇུག་པ་དང་།",
    "དེ་ལྟར་ན་ཡུམ་ནི་བྱང་སེམས་ཆེན་པོ་ཡོངས་སུ་དུལ་བ་དང་ང་རྒྱལ་མ་མཆིས་པའི་སླད་དུ་ཉེ་བར་གནས་པར་འགྱུར་རོ་ཞེས་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ལྟ་བས་བྱས་པ་དང་ཀུན་ནས་ལྡང་བ་དང་བག་ལ་ཉལ་བའི་མཚོན་དང་མདའ་ཡང་བཅོམ།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པར་འགྱུར།",
    "ཆུར་བོར་ཡ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧རུང་སྟེ་དེ་དག་ཐམས་ཅད་ཀྱིས་དེ་ལ་གནོད་པར་མི་འགྱུར་རོ།",
    "ཕ་རོལ་གྱིས་བྱས་པའི་གནོད་པ་རྗེས་སུ་སྒྲུབ་པའི་ཡུལ་མ་ཡིན་པ་ཉིད་དང་།",
    "གཟུགས་ནས་རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དུ་ཡང་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "མི་དམིགས་པས་བདག་ལ་ཡང་གནོད་པར་མི་བྱེད་གཞན་ལ་ཡང་གནོད་པར་མི་བྱེད་གཉིས་ཀ་ལ་ཡང་གནོད་པར་མི་བྱེད་དེ།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པར་འགྱུར་བ་དེར་མིའམ།",
    "མི་མ་ཡིན་པ་གླགས་ལྟ་བ་གླགས་ཚོལ་བས་གླགས་རྙེད་པར་མི་འགྱུར་རོ།",
    "སྲུང་བ་དང་སྐྱོབ་པ་དང་སྦེད་པར་བྱེད་དེ་ལྷའི་བུ་དེ་དག་འོང་ནས་ཀྱང་ཡུམ་འདི་ལ་རིམ་གྲོ་བྱེད་པར་འགྱུར།",
    "བཀུར་བ་དང་ནི་བསྔགས་པར་འདོད།",
    "ཡོངས་སུ་བསྔོ་བ་ཁྱད་པར་ཅན་མཉམ་པ་མེད་པ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དང་།",
    "བརྟུན་པ་དང་ལྡན་པ་ཉིད་ཀྱིས་ཏེ་དམ་པར་གྱུར་པ་རབ་ཉིད་དང་།",
    "དེ་ལ་དམ་པར་གྱུར་པ་རབ་ཉིད་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "མཉམ་པ་མེད་པ་ཉིད་ཀྱིས་ཕུལ་དུ་ཕྱིན་པ་དང་ལྷག་པ་མེད་པས་གོང་ན་མེད་པ་སྟེ་ཚིག་བདུན་གྱིས་དེའི་ཁྱད་པར་གྱི་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཕན་པར་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧བཞེད་པ་དང་བྱམས་པ་དང་ཐུགས་རྗེ་ཆེན་པོ་གང་ཡིན་པ་དང་།",
    "ཡུམ་ནི་དེའི་ངོ་བོ་ཉིད་ཀྱིས་དབེན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ནོ་ཞེས་པ་ནས།",
    "དེས་ན་ཡུམ་འདིར་བྱང་སེམས་ཆེན་པོའི་ཐབས་མཁས་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་འདི་ལ་ལོག་པར་རིག་པ་དང་ལོག་པར་ཤེས་པ་དང་ལོག་པར་བསླབས་པ་ལ་ལ་དོན་མ་རྟོགས་མི་ཤེས་ཤིང་འདི་སྐད་དུ་སྟོན་ཏེ།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་ཡེ་ཤེས་དང་།",
    "དེ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེ་ལྟར་ཡོངས་སུ་བསྔོ་ན་དེ་བཞིན་གཤེགས་པས་མ་གསུངས་པ་མ་ཡིན་པ་དང་།",
    "ཁམས་གསུམ་པར་མ་གཏོགས་པ་ཞེས་མིང་དུ་བཏགས་པའི་བསྔོ་བ་ཡིད་ལ་བྱེད་པ་སོགས་ནི་འདོད་པ་ལ་སོགས་པའི་ཁམས་རྣམས་མི་དམིགས་པ་སོགས་སྔར་བཞིན་ནོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧བཀའ་སྩལ་པ།",
    "ཡོ་བྱད་མང་པོས་རིམ་གྲོར་བྱས།",
    "གོང་ན་མེད་པའི་བར་དུ་འགྱུར་བ་ལགས།",
    "རྣམ་པར་བྱང་བར་འགྱུར་བ་ཡང་མེད་དེ།",
    "བསྔོ་བ་ཡིད་ལ་བྱེད་པས་ནི་དེ་གསེར་མགར་གྱི་རྒྱན་བཞིན་དུ་ཡང་དག་པར་རྫོགས་པའི་བྱང་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ལྟ་བའི་མུན་པ་ཐམས་ཅད་སྤོང་བའི་སླད་དུ་རབ་རིབ་མ་མཆིས་པར་བགྱིད་པའོ།",
    "དེའི་ངོ་བོ་ཉིད་ཅེས་པའི་དོན་གཟུགས་ལ་སོགས་པ་ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བ་ནི་ངོ་བོ་ཉིད་དོ།",
    "བཅོམ་ལྡན་འདས་ཇི་ལྟར་ཡུམ་ལ་གནས་པར་བགྱི།",
    "ཤཱ་རིའི་བུ་སྟོན་པ་ལ་ཇི་ལྟར་བ་དེ་བཞིན་དུ་ཡུམ་ལ་གནས་པར་བྱའོ།",
    "སྟོན་པ་ལ་ཇི་ལྟར་ཕྱག་བྱས་པ་དེ་བཞིན་དུ་ཡུམ་ལ་ཕྱག་བྱའོ།",
    "ཀོའུ་ཤི་ཀ་འདི་ལྟ་སྟེ་དཔེར་ན་དམུས་ལོང་བརྒྱའམ་སྟོང་ངམ་བརྒྱ་ཕྲག་སྟོང་ཡང་རུང་སྟེ་ཡོངས་སུ་འདྲེན་པ་མེད་པར་ལམ་དུ་འཇུག་པའི་ཡང་སྐལ་པ་མེད་ན།",
    "ཀོའུ་ཤི་ཀ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་ནམ་ཡུམ་གྱིས་ཡོངས་སུ་ཟིན་པར་གྱུར་པ་དེའི་ཚེ་མིག་དང་ལྡན་པར་འགྱུར་ཏེ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བའི་མིང་ཡང་རབ་ཏུ་འཐོབ་བོ།",
    "ཀོའུ་ཤི་ཀ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་སྦྱིན་པས་ཡོངས་སུ་བཟུང་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བའི་མིང་འཐོབ་པར་མི་འགྱུར་རོ།",
    "མི་མཉམ་པ་དང་མཉམ་པར་ཞེས་བྱའོ་ཞེས་པའི་དོན།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་དང་།",
    "དེ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཙིའི་ཕྱིར་ཞེ་ན།",
    "ཅི་ལགས་ཡུམ་འདི་རྣམ་མཁྱེན་ཉིད་ཀྱང་གཏོད་པར་མི་བྱེད་དམ།",
    "བཀའ་སྩལ་པ་ཀོའུ་ཤི་ཀ་དེ་སྐད་དུ་ཅི་ལགས་ཡུམ་འདི་རྣམ་མཁྱེན་ཉིད་ཀྱང་གཏོད་པར་མི་བྱེད་དམ་ཞེས་ཟེར་བ་ནི་དེ་དེ་བཞིན་ཏེ།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱང་གཏོད་པར་མི་བྱེད་དམིགས་པར་མི་བྱེད་དོ།",
    "ཅི་ལྟར་ན་ཡུམ་རྣམ་མཁྱེན་ཉིད་ཀྱང་གཏོད་པར་མི་བགྱིད་པར་དམིགས་པར་མི་བགྱིད་པ་ལགས།",
    "འོ་ན་ཇི་ལྟར་གཏོད་པར་བགྱིད་པ་ལགས།",
    "གཏོད་པར་བྱེད་པ་ཞེས་པའི་དོན།",
    "གཞན་ཡང་ཡུམ་ནི་གཟུགས་འདུ་བར་མི་བགྱིད་ཡངས་པར་མི་བགྱིད།",
    "གཟུགས་སྟོབས་དང་ལྡན་པར་མི་བགྱིད་སྟོབས་མེད་པར་མི་བགྱིད་དེ།",
    "དེའི་འོག་ཏུ་གང་ཞིག་ཡོངས་སུ་བཟུང་བ་དང་བོར་བས་འཐོབ་པར་འགྱུར་བ་འདིའི་སྐྱེ་བ་དང་མི་སྐྱེ་བའི་རྒྱུ་གང་ཞིག་ཡིན་སྙམ་པའི་ཐེ་ཚོམ་བསལ་བའི་སྒོ་ནས།",
    "གཉིས་ཀ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་མཚན་ཉིད་སྟོན་པ་ལ་དང་པོ་སྐྱེ་བའི་རྒྱུ་ནི།",
    "རབ་འབྱོར་འདི་ནི་རྣམ་པར་ཕྱེ་ནས་ལུང་བསྟན་པར་བྱ་བ་ཡིན་ཏེ།",
    "སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྫོགས་པར་བྱེད་པ་དང་།",
    "སྐྱེས་བུ་གླེན་པ་དེ་དག་ནི་བདུད་ཀྱིས་བྱིན་གྱིས་བརླབས་པར་འགྱུར་བ་དང་།",
    "བདུད་ཀྱིས་གནོད་པ་བྱས་པ་དང་།",
    "སྐབས་སུ་བབ་པ་རྣམ་པར་དག་པ་འཕགས་བཞིའི་སྤྱིར་བསྟན་པ་ནི།",
    "རབ་འབྱོར་གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་རྣམ་པར་དག་པ་ཉིད་དོ།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་ཡུམ་རྣམ་པར་དག་པ།",
    "ཡུམ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་གཟུགས་རྣམ་པར་དག་པ་སྟེ་དེ་ལྟར་ན་གཟུགས་རྣམ་པར་དག་པ་དང་འབྲས་བུ་རྣམ་པར་དག་པ་དང་ཡུམ་རྣམ་པར་དག་པ་གང་ཡིན་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "གཅད་དུ་མེད་པས་དག་པར་བརྗོད།",
    "དེ་ལྟར་རྣམ་པར་དག་པར་བརྗོད་དོ།",
    "གཅད་པ་ནི་སོ་སོ་ཐ་དད་པར་ཡན་ལག་སོ་སོར་བྱེད་པའོ་ཞེས་སོ།",
    "ཡང་ན་རང་དང་སྤྱིའི་མཚན་ཉིད་ཀྱི་སྣ་ཚོགས་པ་དང་བྲལ་བས་གོ་རིམ་བཞིན་གསུངས་སོ་ཞེས་སོ།",
    "རྣམ་པར་དག་པ་སྤྱིར་བརྗོད་ནས་ཁྱད་པར་དུ་སྟོན་པ་ནི།",
    "རབ་འབྱོར་གཞན་ཡང་བདག་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་གཟུགས་རྣམ་པར་དག་པ།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་བདག་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་བདག་རྣམ་པར་དག་པ་དང་གཟུགས་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "མཐོང་བ་པོའི་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་གཟུགས་རྣམ་པར་དག་པ།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་མཐོང་བ་པོའོ་བར་དུ་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་མཐོང་བ་པོའི་བར་དུ་རྣམ་པར་དག་པ་དང་གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་བ་དང་།",
    "རབ་འབྱོར་གཞན་ཡང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་རྣམ་པར་དག་པས་གཟུགས་རྣམ་པར་དག་པ།",
    "གཟུགས་རྣམ་པར་དག་པས་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་རྣམ་པར་དག་པ་དང་གཟུགས་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "རབ་འབྱོར་གཞན་ཡང་གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་ནི་འབྲས་བུ་རྣམ་པར་དག་པ།",
    "དེ་བཞིན་དུ་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་རྣམ་པར་དག་པ།",
    "དེ་བཞིན་དུ་མ་རིག་པ་རྣམ་པར་དག་པས་འདུ་བྱེད་རྣམ་པར་དག་པ་ཞེས་པ་ནས།",
    "སྐྱེ་བ་རྣམ་པར་དག་པས་རྒ་ཤི་དང་མྱ་ངན་དང་སྨྲེ་སྔགས་འདོན་པ་དང་སྡུག་བསྔལ་བ་དང་ཡིད་མི་བདེ་བ་དང་འཁྲུག་པ་རྣམ་པར་དག་པ།",
    "རྒ་ཤི་དང་མྱ་ངན་དང་སྨྲེ་སྔགས་འདོན་པ་དང་སྡུག་བསྔལ་བ་དང་ཡིད་མི་བདེ་བ་དང་འཁྲུག་པ་རྣམ་པར་དག་པས་སྐྱེ་བ་རྣམ་པར་དག་སྟེ།",
    "དེ་ལྟར་ན་རྒ་ཤི་དང་མྱ་ངན་དང་སྨྲེ་སྔགས་འདོན་པ་དང་སྡུག་བསྔལ་བ་དང་ཡིད་མི་བདེ་བ་དང་འཁྲུག་པ་རྣམ་པར་དག་པ་དང་སྐྱེ་བ་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ་ཞེས་པའི་དོན།",
    "འདོད་པའི་ཁམས་དང་བསམ་གཏན་དང་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དག་སྟེ་ས་དགུ་ལ་མི་མཐུན་པའི་ཕྱོགས་ཆེན་པོའི་ཆེན་པོ་ལ་སོགས་པ་རྣམ་པ་དགུའི་གཉེན་པོའི་ངོ་བོར།",
    "གོ་རིམ་བཞིན་དུ་ལམ་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པ་རྣམ་པ་དགུ་རྣམ་པ་ཐམས་ཅད་དུ་རྣམ་པར་དག་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རྣམ་པར་དག་པ་ཤིན་ཏུ་བ་ཞེས་བྱའོ།",
    "ས་དགུ་ལ་མི་མཐུན་པའི་ཕྱོགས་ཆེན་པོའི་ཆེན་པོ་ལ་སོགས་པ་རྣམ་པ་དགུའི་གཉེན་པོའི་ངོ་བོར་གོ་རིམ་བཞིན་དུ་ལམ་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པ་རྣམ་པ་དགུ་ཅིག་ཤོས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧སུ་རྣམ་པར་དག་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རྣམ་པར་དག་པ་ཅིག་ཤོས་ཞེས་བྱའོ།",
    "མི་མཐུན་པའི་ཕྱོགས་ནི་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པར་རིགས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལ་གཉེན་པོ་ནི་ཆེན་པོའི་ཆེན་པོ་ལ་སོགས་པ་མི་མཐུན་པའི་ཕྱོགས་ནི་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པར་རིགས་སོ་ཞེས་བྱ་བའི་ཀླན་ཀ།",
    "རབ་འབྱོར་གཞན་ཡང་ཡུམ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་གཟུགས་རྣམ་པར་དག་པ།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་རྣམ་མཁྱེན་ཉིད་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་ཡུམ་རྣམ་པར་དག་པ་དང་གཟུགས་རྣམ་པར་དག་པ་དང་རྣམ་མཁྱེན་ཉིད་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "རབ་འབྱོར་གཞན་ཡང་ནང་སྟོང་པ་ཉིད་རྣམ་པར་དག་པ་དང་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་དུ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "རྣམ་མཁྱེན་ཉིད་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་ནང་སྟོང་པ་ཉིད་རྣམ་པར་དག་པ་དང་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་དུ་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "རབ་འབྱོར་གཞན་ཡང་འདུས་བྱས་རྣམ་པར་དག་པས་འདུས་མ་བྱས་རྣམ་པར་དག་པ།",
    "འདུས་མ་བྱས་རྣམ་པར་དག་པས་འདུས་བྱས་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་འདུས་བྱས་རྣམ་པར་དག་པ་དང་འདུས་མ་བྱས་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆད་པའོ།",
    "དེ་བཞིན་དུ་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བྱུང་བ་ལ་སྦྱར་ནས་གསུངས་པའི་ཆུང་ངུའི་ཆེན་པོ།",
    "རྣམ་པར་དག་པ་འདི་ནི་ཟབ་བོ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "གང་ཤིན་ཏུ་རྣམ་པར་དག་པའི་སླད་དུ་ལགས།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་ཤིན་ཏུ་རྣམ་པར་དག་པ་ནི་སྣང་བའོ།",
    "གང་རྣམ་པར་དག་པའི་སླད་དུ་ལགས།",
    "ཡུམ་རྣམ་པར་དག་པ་ཡིན་པའི་ཕྱིར་ཤིན་ཏུ་རྣམ་པར་དག་པ་སྣང་བའོ།",
    "རྣམ་པར་དག་པ་ནི་ཉིང་མཚམས་སྦྱོར་བ་མ་མཆིས་པའོ།",
    "ཤིན་ཏུ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པ་ཆེན་པོའི་ཆུང་ངུ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པ་ཆེན་པོའི་འབྲིང་།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པ་ཆེན་པོའི་ཆེན་པོ་བསྟན་པའི་དོན།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་དག་པ་ནི་འདོད་པ་དང་།",
    "གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་སུ་སྐྱེ་བ་མ་ལགས་སོ།",
    "ཤཱ་རིའི་བུ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ན་རྣམ་པར་དག་པ་འདོད་པ་དང་གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་སུ་སྐྱེ་བ་མ་ལགས།",
    "ཤཱ་རིའི་བུ་འདོད་པ་དང་གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་རང་བཞིན་གྱིས་མི་སྐྱེ་བའི་ཕྱིར་རྣམ་པར་དག་པ་མི་སྐྱེ་བའོ་ཞེས་པའི་དོན།",
    "རྣམ་པར་དག་པ་ནི་འཚལ་བ་མ་མཆིས་པའོ།",
    "ཤཱ་རིའི་བུ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ན་རྣམ་པར་དག་པ་འཚལ་བ་མ་མཆིས་པ་ལགས།",
    "ཤཱ་རིའི་བུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "ཤཱ་རིའི་བུ་ཤིན་ཏུ་རྣམ་པར་དག་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧པའི་ཕྱིར་རོ།",
    "ཤཱ་རིའི་བུ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "ལན་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ་ཤཱ་རིའི་བུ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་བདག་རྣམ་པར་དག་པའི་སླད་དུ་གཟུགས་རྣམ་པར་དག་པའོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "སོ་སྐྱེ་བོའི་དག་པ་དང་མ་དག་པའི་ཁྱད་པར་མི་འཐད་དོ་སྙམ་ན།",
    "རབ་འབྱོར་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "རབ་འབྱོར་བདག་མེད་པའི་ཕྱིར་གཟུགས་མེད་པ་ནི་ཤིན་ཏུ་རྣམ་པར་དག་པའོ།",
    "དེ་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་བར་ལ་སྦྱར་ནས་གསུངས་སོ།",
    "རབ་འབྱོར་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ཕུང་པོ་ཕྱི་མ་བཞི་ལ་སྦྱར་ནས་གསུངས་པའི་དོན།",
    "རབ་འབྱོར་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ་ཞེས་པ་ནི་བདག་དང་ཕུང་པོ་རྟག་མི་རྟག་ལ་སོགས་པ་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུ་ནི་བྱང་སེམས་ཆེན་པོའི་ཡུམ་ལགས་སོ།",
    "རབ་འབྱོར་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་ཕྱིར་རབ་འབྱོར་འདི་ནི་བྱང་སེམས་ཆེན་པོ་རྣམས་ཀྱི་ཡུམ་ཡིན་ནོ།",
    "དེ་ལྟར་ལམ་ཤེས་པ་ཉིད་བསྟན་ནས་གཞི་ཐམས་ཅད་ཡོངས་སུ་ཤེས་པ་མེད་པར་ལམ་ལེགས་པར་ཡོངས་སུ་ཤེས་པ་མེད་པས།",
    "བྱང་སེམས་ཆེན་པོ་རྣམས་ཀྱི་ཡུམ་ནི་ཚུ་རོལ་དང་ཕ་རོལ་གྱི་མཐའ་མ་ལགས་གཉིས་ཀའི་བར་ན་མི་དམིགས་ལགས།",
    "འབྱོར་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "ཕ་རོལ་གྱི་མཐའ་མ་ལགས་གཉིས་ཀའི་བར་ན་མི་དམིགས་ཏེ་ཤིན་ཏུ་རྣམ་པར་དག་པ་ལགས།",
    "ཤེས་རབ་ཕ་རོལ་ཕྱིན་པར་འདོད།",
    "དུས་གསུམ་མཉམ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧པ་ཉིད་དུ་ཤེས་པ་ནི་གཞི་རྟོགས་པ་ཁོ་ན་ཡིན་ལ།",
    "ཅི་ལྟར་ན་མིང་དང་མཚན་མ་ལས་ཀྱང་ཆགས་པ་ལགས།",
    "མིང་དང་མཚན་མར་འཛིན་པས་ཡུམ་འདོར་བར་འགྱུར་རིང་དུ་བྱེད་པར་འགྱུར་ཏེ།",
    "ཡུམ་གྱིས་རློམ་སེམས་སུ་བྱེད་པས་ཡུམ་འདོར་བར་འགྱུར་རིང་དུ་བྱེད་པར་འགྱུར་རོ་ཞེས་པའི་དོན།",
