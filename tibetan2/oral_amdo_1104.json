    "ནང་གང་ཟག་གི་སྙེམས་བྱེད་བཟང་རྟོག་ངན་ས་རྟོག་ཡིད་༡༤༣ན་པ་བྱ་ཡིད་བྱེད་ལ་སོགས་བློས་བྱས་ཀྱི་སྤྲོས་པ་༩༩༤བས་ཐམས་ཅད་རང་སར་ཆོད་ནས།",
    "དེ་ཡང་ནང་སྐོང་བ་ཡིད་བཞིན་ནོར་བུ་ལྟ་བུ་ཞིག་དགོས་པ་ཡིན་སྙེམས་བྱེད་གང་ཟག་གི་ཆོད་ཚད་ཟེར།",
    "དེ་ཡང་སྙེམས་བྱ་འདུལ་རྒྱུའི་ལྷ་འདྲེ་ཞེས་པ་གཞི་གདོད་མ་ནས་གྲུབ་པ་མེད་པ་ཁོ་རང་གི་ངོ་བོས་ས་བ་སྙེམས་བྱེད་གང་ཟག་རང་ཉིད་ཀྱང་གཞི་གདོད་མ་ནས་སྟོང་པ་དང་།",
    "རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པ་གང་ཟག་གི་ངོ་བོས་སྟོང་པ་གཉིསསྟོང་པ་ཞེས་དོན་དམ་བདེན་པའི་སྟེང་དུ་རོ་གཅིག་པས་དབྱེར་མེད་ལྷན་སྐྱེས་སུ་གནས་ཀྱང་།",
    "ཐུན་མོང་མ་ཡིན་པའི་མཚན་མ་ཡང་འབྱུང་།",
    "དེ་ལྟར་ཆོ་འཕྲུལ་གྱི་ཁྱད་པར་རྣམས་ཀྱང་ཤེས་ཤིང་ངོས་ཟིན་དགོས་སོ་། ཚར་ཚད་ལའང་ཐུན་མོང་བ་དང་།",
    "ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཀྱི་ས་ནང་ཚན་གྱི་ཁྱད་པར་དང་བཅས་པ་༡༤༤ན་ཤེས་ཤིང་ངོས་ཟིན་པ་གལ་ཆེའོ།",
    "ཚར་ཚད་ལ་ཐུན་མོང་བ་དང་ཐུན་མོང་མ་ཡིན་པ་གཉིས་ནང་ཚན་དང་བཅས་པ་དང་།",
    "བུ་ཉོན་དང་ཚར་ཚད་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཀྱི་རེ་རེ་ལ་ཡང་ལྔ་ལྔ་སྟེ།",
    "དང་པོ་ཐུན་མོང་ལ།",
    "གདོན་བུད་པའི་ཚར་ཚད་དང་ལྔའོ།",
    "འཚུབ་མ་ཆེན་མོ་རབ་ཏུ་གཡོས་པས་ནམ་མཁའ་བར་སྣང་ས་གཞི་ཐམས་ཅད་ཁེབས་པ་སླར་ལ་ཞི་ཟླ་པའ་ཞིང་དྭངས་ནས་ནམ་མཁའ་ས་གཞི་བཀྲག་མདངས་དང་ལྡན་ཞིང་པ་ས་",
    "འཁྲུག་རྩོད་གཡུལ་ལས་རང་ཉིད་རྒྱལ་ཏེ་ན་ཕ་རོལ་རང་གི་འཁོར་དུ་གྱུར་པ་དང་།",
    "སྒྲུབ་པ་བྱེད་པར་དུ་མ་ཞིག་གིས་དེ་བཞིན་དུ་དམ་བཅས་པ་དང་།",
    "གཞན་ཡང་བུ་དང་བུ་མོ་ཆུང་མ་བྲན་ཁོལ་རྣམས་འཕངས་པ་མེད་པར་འབུལ་བ་དང་།",
    "གི་རིགས་སྣ་ཚོགས་པ་དང་།",
    "ཤིང་གི་མེ་ཏོག་འབྲས་བུ་སྣ་ཚོགས་པ་དང་།",
    "ཐང་དང་ཆུ་ལས་སྐྱེས་པའི་མེ་ཏོག་གི་རིགས་ཁ་དོག་༡༤༦བ་སྣ་ཚོགས་པ་དང་།",
    "གཞན་ཡང་རྐྱལ་པ་ལ་ས་སོགས་སྣོད་སྟོང་གི་རིགས་དང་།",
    "རྫ་མ་ལ་སོགས་སྤྱད་ནག་གི་རིགས་དང་བྲ་བོ་ནག་པོ་དང་།",
    "སྲན་མ་ནག་པོ་ལ་སོགས་འབྲུ་ནག་གི་རིགས་དང་།",
    "ཁྱི་ནག་གི་བལ་སོགས་སྤུ་བལ་ནག་པོ་དང་།",
    "རེ་བ་ལ་སོགས་གོས་སྟན་ནག་པོ་དང་།",
    "བྱ་རོག་གི་སྒྲོ་དང་༧།",
    "༣་གཞན་ཡང་རྫས་ངན་པ་ལས་བྱས་པའི་ངོ་བོ་མི་སྡུག་པ་གང་གི་ཡིད་ན་གང་ལ་མི་འདོད་པ་གང་ཡིན་པ་དང་།",
    "ཡང་ན་དེ་རྣམས་རང་གི་ལུས་ལ་འབྱར་བ་ལུས་དང་བྲལ་ཏེ་གཞན་དུ་སོང་བ་ནི་ཉམས་སམ་རྨི་ལམ་དུ་བྱུང་ན་གདོན་བུད་པའི་ཚར་ཚད་ཡིན་ནོ།",
    "དེ་གང་ཡིན་པའི་ཤུལ་དུ་རང་གི་ལུས་ཡང་བ་དང་།",
    "གཉིས་པ་ཐུན་མོང་མ་ཡིན་པ་ལ་ལྔ་སྟེ།",
    "ཁྱད་པར་མཆོག་གི་དངོས་གྲུབ་ཀྱི་ཚར་ཚད་དང་།",
    "ནང་ནས་མི་གཙང་བ་རྣམས་མར་བཤལ་ནས་ཁོང་པའི་ནང་ཉའི་ལྟོ་བ་ལྟར་གཙང་དང་སིང་ངེ་སོང་བ་ནང་ཆ་ཐམས་ཅད་མ་ལུས་སྐྱུག་ནས་ཁོང་པ་རྐྱལ་པ་ལྟར་སྟོང་དང་།",
    "པེནབར་རྩའི་ནང་ནས་དུད་པའི་ཁུ་བ་ལྟར་ནག་ས་ཆ་ཚ་ནུ་རེ་བ་སེན་ཕྲག་དང་།",
    "དྲི་བཟང་གི་ངད་པ་བྲོ་ཞིང་བསྲེག་པའི་ཐལ་སོལ་མེད་པ་དང་།",
    "ནམ་མཁའ་གང་བས་ས་གཞི་ཐམས་ཅད་མར་བབ་པས་ཁ་ཡཔ་བ་བཞག་པ་ལྟར་རྡུལ་ནོན་ནས་ས་ཁྱོན་ཐམས་ཅད་དཀར་ལམ་མེར་ཅནརྒྱ་མཚོ་དང་ཆུ་བོ་ཆེན་པོ་རབ་ཏུ་དྭངས་པའི་ནང་དུ་གྱུར་པ་དང་།",
    "བཀྲུས་པས་ལུས་ཀྱི་དྲི་མ་དག་ནས་དྭངས་སིང་ངེ་སོང་བ་དང་།",
    "ཤེལ་གྱི་ཁང་པ་བརྩེགས་པའི་ནང་དུ་འདུག་པས་ཐམས་ཅད་སྒྲིབ་མེད་དུ་མཐོང་ཞིང་རང་གི་ལུས་ལ་ཡང་འོད་ཅུང་ཟད་ཆགས་པ་དང་།",
    "དུང་འབུད་པ་དང་།"
  ]
}