    "དེ་ལྟར་གྱི་ཚེ་བསམ་གཏན་གྱི་འདུག་སྟངས་སུ་སྡོད་པའང་མི་རིགས་པ་འདྲ།",
    "ཟབ་པ་དང་རྒྱ་ཆེ་བའི་ཕྲིན་ལས་མཁའ་ཁྱབ་མཁའི་རྡོ་རྗེ་ཅན་དུ་གསལ་ཞིང་བརྟན་པར་གསོལ་བ་འདེབས་པ་དང་རྗེས་འབྲེལ་ཁྱད་པར་དུ་གྱུར་པའི་དུས་བཟང་པོ་ལ་མཆོད་བསྐོར་གྱི་སེར་ཕྲེང་ཇི་ལྟར་གནང་བའི་མཆོད་བསྒྲིགས་ཀྱི་འཆར་གཞི་ཇི་ལྟར་སྩལ་བ་རྣམས་ངོ་མཚར་གཞལ་དུ་མེད་པའི་ལེགས་ཚོགས་ཕུན་སུམ་ཚོགས་པ་འདུག་ལགས་པར།",
    "ཕྱི་མ་ལ་ས་བཅད་བཅུས་བསྟན་པར་འགྲེལ་ཊཱིཀ་རྣམས་སུ་གསུངས་པ་བཞིན་བཀའ་ཐོར་ཡང་སྩལ་འདུག་པ་དང་།",
    "ལྷ་མིན་འགྲོ་བ་གཞན་གྱི་ཁོངས་སུ་འདུ་བའི་ཕྱིར་འགྲོ་བ་ལྔ་ཞེས་བསྡུས་པ་སྟེ།",
    "བོད་དུ་འགྱུར་སྔ་ཕྱི་ལ་ལྟོས་ནས་དེ་ལྟར་གྲགས་པར་བྱས་ན་འཐད་པ་འདུག་ལགས་པ་དང་།",
    "རོང་སྟོན་ཆེན་པོ་དུས་དེ་ཙམ་ན་ལུང་རིགས་སྨྲ་བ་ཐམས་ཅད་ཀྱི་བསྟོད་ཡུལ་མཐུན་སྣང་དུ་གྲུབ་པ་ཡིན་འདུག་པས།",
    "མེ་བྱ་ཞེས་པའང་འདུག།",
    "དེ་རྗེས་བྲག་ལྡན་གཟིམས་ཕུག་ཏུ་བསྙུན་བབས་ལྕི་བ་བྱུང་འདུག་ཀྱང་སྔར་གྱི་དགེ་སྦྱོར་གྱིས་ལས་ངན་བག་ལ་ཉལ་དུ་གནས་པ་དེ་ལྷོངས་པའང་ཡིན་མཆི།",
    "འོན་ཀྱང་དགེ་སྦྱོར་གྱི་དྲན་པ་ཡེངས་མེད་དང་འཕྲལ་གྱི་འཚོ་སྐྱོང་སོགས་ཉེ་བར་ལེན་པའི་རྐྱེན་གྱིས་དེང་སང་བདེ་བར་སོར་ཆུད་ཡོད་འདུག་པ་ལེགས།",
    "ཉེ་ལམ་གུ་རུ་ཕྱི་སྒྲུབ་ཀྱི་བཅད་རྒྱུར་བཞུགས་པ་བཀའ་དྲིན་ཆེ་འདུག་ཅིང་།",
    "ཕྱི་སྒྲུབ་ལ་མི་མཐུན་པའི་གནས་དཀའ་བ་རང་ཡང་མི་འདུག་པ་དང་།",
    "ད་ལྟ་གསང་སྒྲུབ་ལ་མ་གཏོགས་མི་གནང་བ་འདུག་ལགས།",
    "སྐུ་འབག་སོགས་རྫས་གཏེར་ཕྲན་འདྲ་ཡིན་པ་འདུག་ལགས།",
    "དེ་ཡང་ཞག་དུས་སྤར་བའི་འཆད་བློ་དང་ཞུ་བློ་ཙམ་ལས་སེམས་ཀྱི་གཞི་རྩ་ཆོད་པའི་འཆད་ཉན་ནི་མེད་པ་ལྟ་བུ་དང་།",
    "ཇི་ལྟར་ཕེབས་བཞིན་འཇམ་དཀར་གྱི་ལྗགས་བསྙེན་གནང་རྒྱུ་ཤིན་ཏུ་ལེགས་འདུག་ཅིང་།",
    "ལྷ་མདུན་དུ་དབྱེ་བ་མི་དགོས་པའི་ཕྱོགས་ཀྱང་འདུག།",
    "ཡོ་བྱད་ཀྱི་རྗེས་འབྲང་རྒྱལ་པོས་སྣ་དྲངས་གཟའ་གདོན་མངོན་གྱུར་དེ་བཞིན་ཡིན་འདུག་པ་དང་དེ་རྗེས་བསྐྱར་མ་རྣམས་ཀྱང་རྒྱལ་པོའི་འབྲང་དང་མི་ངོ་གསར་གྱི་རྐྱེན་བྱས་པ་རང་དུ་འདུག་པས།",
    "ཞེན་པ་འདུག་ན་རྦད་ཀྱིས་ཆོད།",
    "མྱོང་བ་འདུག་ན་ཤིག་གེས་བཤིག་དང་བློ་བྲལ་གྱི་ངང་གསལ་སྟོང་རྗེན་པ་དེ་ག་མ་ཡེངས་པའི་དྲན་པ་བསྟེན་པ་ལས་གཞན་ཅི་ཡང་མེད།",
    "སྤྱིར་ཡང་རང་ངོས་ནས་བློ་རྟོགས་ཀྱིས་རྟོགས་ཚུལ་མཐར་ཐུག་པ་གང་ཡིན་དེ་སྤྲོས་བྲལ་དུ་འཇོག་ཅིང་།",
    "བལྟ་བྱེད་ཀྱི་རིག་པ་ནང་ནས་ཤར་བ་སོ་སོ་མ་ཡིན་པ་སྣང་རིག་དང་བྲལ་བའི་རིག་པ་ཧར་སང་རྗེན་ལ་ཕུད་དེ་ཅེར་མཐོང་རང་གྲོལ་དུ་འཇོག་པ་འདི་ག་ལྟ་བའི་སྐྱོང་ལུགས་འཁྲུལ་མེད་དུ་རློམ་པ་ལགས།",
    "དེ་ཡང་རང་ངོ་ཤེས་ཙམ་ལ་དྲན་འཛིན་གྱིས་བཅོས་བསྒྱུར་མ་འཛིན་པའི་སེམས་རང་དག་ཏུ་བྱས་པས་འཛིན་བྱེད་རང་གྲོལ་དུ་འགྱུར་བ་ཡིན།",
    "དུས་མཉམ་དུ་རྣམ་རྟོག་ཡིན་པ་འདུག་སྙམ་པའི་བློས་བྱས་ཀྱིས་ཀྱང་མི་ཆོག་པས།",
    "ས་རྡོ་རི་བྲག་སོགས་ལུང་མ་བསྟན་གྱི་འཆར་སྒོ་ཡིན་ཡང་རུང་སྟེ་གང་ཤར་དེ་གའི་ཐོག་ཡིན་པ་འདུག་སྙམ་པའི་བློས་བྱས་ཀྱིས་ཀྱང་མི་ཆོག་པས།",
    "དེ་ལས་མཁྲེགས་ཤིང་ཞིབ་པ་དྲི་ཕྱོགས་འདྲ་འདི་མཆོག་ཏུ་བྱེད་འདུག་པའི་སྤུས་ཚད་ཁ་བྱང་ལྟར་ལགས།",
    "རིན་ཆེན་འབར་བའི་དབྱིངས་སུ་འདུག་པ་ནི།",
    "རང་དུ་མ་ཟད་འཁོར་འདས་ཐམས་ཅད་འདིའི་རང་བཞིན་དུ་འདུག་པས་གཞི་ཀ་དག་ཅེས་བརྗོད་པ་ལགས།",
    "དུས་མཉམ་དུ་རྣམ་རྟོག་ཡིན་པ་འདུག་སྙམ་པའི་བློས་བྱས་ཀྱིས་ཀྱང་མི་ཆོག་རྗེས་སྙེག་དང་བློས་བཅས་ཀྱི་གཉེན་པོས་མ་བསླད་པར།",
    "ལས་གསུམ་རྣམ་གཞག་བཅས་པ་ཙམ་ལས་ཡིག་རྙིང་རྣམས་ལུང་རྒྱུན་དང་དཔེ་རྒྱུན་ཡང་དཀོན་པ་ཙམ་འདུག་ཀྱང་།",
    "རྒྱུད་འགྲེལ་ལས་དེ་གཉིས་ཀ་གསུངས་འདུག་ལགས་ནའང་།",
    "མཚུར་ལུགས་ལེ་དྲུག་མ་སོགས་མང་པོར་འདུག་པ་ལྟར་ཚད་ཐུབ་ཏུ་བཟུང་སྟེ་བཀོད་པ་ལས།",
    "ན་ནིང་ཟླ་བ་བརྒྱད་པ་ཕྱི་མའི་སྟོང་ལ་རྩེ་ཐང་སོགས་སུ་སྒོ་ཡིག་སྦྱོར་མི་ཡང་བྱུང་འདུག་པ་ལྟར།",
    "ཚེར་དུང་པ་ཀུན་དགའི་མཚན་ཅན་སོགས་མང་པོ་ལས་ཀྱང་རང་གཞན་གྱི་རྩིས་ལུགས་མཐའ་ཡས་པ་ཞིག་གསན་འདུག་ལགས་ནའང་།",
    "སྐར་ནག་གཉིས་ཀ་རྫོགས་པ་ཞང་པོ་གཞོན་ཐ་དོན་གྲུབ་ཚེ་བརྟན་ཙམ་མ་གཏོགས་མ་བྱུང་འདུག་པ་དང་།",
    "དེ་དག་སོ་སོས་ཕྲིན་ལས་བསྐྱངས་པ་ཡང་ཆེར་མ་བྱུང་འདུག་ཅིང་།",
    "ལོ་ཟླ་ཞག་དུས་བརྩིས་པ་ཡི།",
    "དགོས་རྗེའི་མདུན་དུ་རྒྱག་སྲོལ་འདུག་པ་ལྟར།",
    "གནམ་ལོའི་མར་གྱི་དྲུག་འགྲམ་ན་དུ་ལོན་བགྲངས་པ་ལ་བརྩི་བ་འདྲ་ཞིག་འདུག་ལགས་པ་ཇི་ལྟར་འཐད།",
    "ཡང་ཐང་ཤིང་རིགས་ལྔ་འདི་ལ་སྐོར་འགོའི་བསྒྱུར་ཁ་ཡོད་མེད་མ་གཏོགས་འདི་ཕྱོགས་སུ་ཡང་ལག་ལེན་བྱེད་མི་ཁ་ཤས་འདུག་ལགས་རུང་།",
    "ལུང་རིགས་ཀྱི་བཅད་བརྡར་རྒྱ་ཆེར་སྩལ་འདུག་ལགས་ནའང་།",
    "སྨེ་བའི་དར་གུད་བཞག་པ་མ་གཏོགས་གཞན་འདི་ཉིད་ཇི་ལྟ་བ་ལ་རྡེའུ་བཅུ་དགུ་མ་ཞེས་ཀེག་རྩིས་ཀྱི་རྣམ་གྲངས་སུ་རྒྱག་སྲོལ་འདུག་པར་མ་ཟད།",
    "སྐྱེ་སྐར་སོ་སོའི་སྟེང་དུ་གཟའ་རང་རང་སྐྱེས་ནི་སྐྱེས་ལ།",
    "ལཀྵ་རོ་ཙ་ན་ལས་ཁཀའོ།",
    "བ་ར་བ་ཙ་ནཱ་མི་ཏཱ་བྷི་ཥེ་ཀེ་རྨ་ཧཱ་མུ་དྲཱ་མནྡྲ་པ་དེགྲུབ་སྟེ།",
    "ལ་ལར་སྭ་བྷཱ་ཝས་སྦྱངས་ཞེས་ཡོང་འདུག་ལགས་པ་འདི་གཉིས་གང་འཐད་ཡིན་ནམ།",
    "ཞེས་པའི་བར་ཡང་རང་བཞིན་ལྷུག་འདོན་ལས་དྲིལ་སྟབས་གདངས་མ་ཐུགས་རྗེ་ཆེན་པོ་ལྟར་བྱས་ན་ལེགས།",
    "དེང་སང་གཟུགས་ཐང་ཞིང་ཐུགས་དམ་འཕེལ་བར་ཡོད་འདུག་པ་སྤྲོ་བ་འཕེལ།",
    "༤ ཐོབ་ཐོབ་ཐོ་ཐ་༣ ཐཾ་ས་ཚཀྱི་མུཙ་ཨ་༧ ཝཚབསྶ་བསམ་ང་ཡིན་ཞིག་ཡིན་རུང་ས་༣ ན་༡༤༧༣༤ཀ་ཨ་ཙི་ཨ་ཅཙན་༦ ༧༥ ཡོ་པ།",
    "སྤྱན་འདྲེན་དུས་སྔགས་ཚར་གཅིག་བརྗོད་པར་གསུངས་པ་ཐུགས་ཀའི་ཧཱུཾ་མཐར་བསྐོར་བ་དེ་ཀ་ཡིན་པས་གཟུངས་རིང་རང་ལགས།",
    "ཞེས་པ་འདི་གས་དགོངས་པར་འདུག་པས་གསལ་བྱེད་ཞུ་མི་དགོས་པར་སྣང་ལགས། ལགས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "མཉམ་བཞག་བརྟན་ཞིང་རང་ས་ཟིན།",
    "ཐུགས་༧ ཕྱག་རྒྱ་གང་རུང་ལ་བརྟེན་ནས་མཆོག་མངོན་དུ་བྱེད་པ་ཞིག་དཀའ་བ་འདུག་ལགས་པས།",
    "འོན་ཀྱང་རང་གྲོལ་གཉུག་མའི་རྩལ་སྣང་ལྷ་སྔགས་ཀྱི་རང་གདངས་སུ་བྱ་རྩོལ་མེད་པར་ཁྱེར་ཤེས་ན་ཟུང་འབྲེལ་གྱི་ལམ་ཁྱད་པར་ཅན་དུ་འགྲོ་བ་ལགས་ཤིང་།",
    "རིག་པ་རྗེན་པ་འཆར་སྒོ་སྣ་ཚོགས་སུ་འཆར་ཡང་གང་ཤར་ཐམས་ཅད་དྲན་པ་ཁོ་རང་ལས་མ་གཡོས་པ་གཟུང་དྲན་ལ་མ་ལྟོས་པར་སྐྱོང་ཐུབ་པ་དེ།",
    "༧ གེགས་ཆེ་བ་མ་གཏོགས་མཚན་བཅས་ཀྱི་རྫོགས་རིམ་འདི་ཆེས་མྱུར་རྒྱུ་ཡིན་པ་འདྲ་ཞིག་འདུག་པ་དེ་ལྟར་ལགས་སམ།"
  ]
}