    "དང་ཞིན་དུགྱུར་ཅིགཅེསབརྗོད་ནས་མི་གདའ་བར་འགྱུར་རོ།",
    "ཨཀའི་མེ་ཏོགདུརཁྲོད་ཀྱི་མེས་བསྲེགས་ནས་མར་གྱི་ཞག་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྦྱང་བ་བགྱིས་ནས་ལྷ་ཆེན་པོའི་གནས་སུམཆིས་ལ་༣ ཤིང་ཨ་ཤཱཏྨའི་ལོ་མ་འ་སྟེང་དུ་བཞག་སྟེ་ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བགྱིས་ཐ་ཐག་འབགྱིསན་མི་གདའ་བར་འགྱུར་རོ།",
    "དུབའགྲུལ་ན་མི་གདའ་བར་འགྱུར།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "སྲེད་མེད་བུ་ཡང་ལྷོ་ཕྱོག་འདུག།",
    "དྲན་པ་ཙམ་གྱིསམྱུར་དུ་མདུན་འདུག་པ་འཁྲུལ།",
    "ཁྱབ་འཇུགན་བཅོམ་ལྡན་འདས་ཀྱི་གློ་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་བརྩྭ་ཀུ་ཤའི་སྙན་གྱི་སྟེང་དུ་འདུག་པའི་ལག་པ་གཡས་པས་མནནལ་འབར་བར་འགྱུར་ཀྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གསང་ཆེན་དང་བཅས་པར་དེའི་ལག་ཏུ་འདུག་པར་འགྱུར་ཏེ།",
    "མར་གྱི་མར་མ་བརྒྱུད་སྦྱར་ནས་རྩྭ་ཀུ་ཤ་ལས་སྟན་བྱས་པ་ལ་འདུགལརྡོ་རྗེ་ལག་པ་གཉིས་ཀས་བཟུང་སྟའབར་བར་གྱུར་ཀྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ན།",
    "རྒྱལ་མཚན་དང་དུང་ལ་སོགས་པ་ལ་བསྔགས་ནའང་དེ་མཐོང་ཞིང་ཐོས་པས་ཕ་རོལ་གྱི་དཔུང་རངས་པར་འགྱུར་རོ།",
    "ཁྲོས་བཞིན་དུ་མཚན་གཅིག་འདུག་པའི་སྟང་དུ་ལག་པས་མནན་ཏེ་བཟླས་བརྗོད་བྱསན་དེ་མ་ཐོབག་ཏུ་དགྲ་མེད་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ཁྲོ་བོ་ལའང་མར་གྱི་འདུག་པ་བསྲེགས་ན་ཕྱིར་ཞི་བར་འགྱུར་རོ།",
    "སྐྲ་གྱེན་དུ་འགྲེང་ལ་ས་ལ་ལྟ་ཞིང་འདུག་པ་བྲིས་ཏེ།",
    "ལགན་རྡོ་རྗེ་ལ་ལྟ་ཞིང་འདུག་པར་བྲིའོ།",
    "གདོན་རྣམས་ཀྱང་རངས་པར་བྱེད་ཅིང་སྐྱེལ་བར་བྱེད་དོ།",
    "ལྷ་ཆེན་ཁོ་ན་བཅོམ་ལྡན་འདས་ཀྱི་གློ་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "སྤྱནན་གཡས་ཕྱོགས་སུ་འདུག་གོ།",
    "དྲུག་མ་དང་དཀའ་ཟློག་མ་ནི་རྒྱབ་ལོགས་སུ་འདུག་སྟེ།",
    "དར་ལའི་གོས་གྱོན་ཞིང་པདྨ་ལ་འདུག་པ་བྲིའོ།",
    "གདོང་དྲུག་པ་རྡོ་རྗེ་རྩེ་གསུམ་པ་འདུག་པར་ཡིད་ཀྱིས་བསམས་ལ།",
    "སྦྲུལ་གྱི་འཕྲང་བས་བརྒྱན་ཏེ་པདྨ་ལ་འདུག་པ་འདྲིའི་གཞུག་གོ།",
    "དགྲ་གསད་པར་འདོད་ན་དགྲ་གང་ན་འདུག་པ་དེ་ལོགས་སུ་ཁ་བལྟས་ཏེ་ཞག་བདུནགྱི་བར་དུ་དུས་གསུམ་དུ་ལན་བརྒྱད་བརྒྱ་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ན་ཞག་བདུན་གྱི་ཉིན་པར་དགྲ་འཆི་བར་འགྱུརརོ།",
    "རིག་སྔགས་འཆང་གཅིག་ནུབ་ཕྱོགས་སུ་ཁབལྟས་ཏེ་འདུག་ལ།",
    "ལག་ན་རྡོ་རྗེའང་རིག་སྔགས་ཐམས་ཅད་ཀྱིས་བསྟོད་ཅིང་འདུག་པར་བྲིའོ།",
    "མཆོག་སྦྱིན་པའི་ཚུལ་དུ་འདུག་པ་དེའི་མདུན་དུ་རིག་སྔགས་བསྒྲུབ་པར་བྱ་སྟེ།",
    "མ་སྟག་འཕྲོ་བ་དང་བཅས་པ་སྲོག་པའིཟང་བཞིན་ཅན་གྱིས་ལག་ན་རྡོ་རྗེ་གཙོ་བོར་བྱས་ནས་དེ་བ་ཞིན་གཤེགས་པ་ཤཱཀྱཐུབ་པའི་སྤྱན་སྔར་འདུག་གོ།",
    "མཱ་མ་ཀཱའི་ཕྱག་རྒྱུའི་ཚོགས་བྲིས་པ་གང་ན་འདུག་པ་དེ་ན་དུ་ཕོ་ཉ་མ་རྣམས་ཀྱི་ཚོགས་ཀྱིས་བསྐོར་བའང་གནས་སོ།",
    "ཀུཤའི་སྟན་ལ་འདུག་སྟེ་རྡོ་ལེབ་ཤིན་ཏུ་བཀྲུས་པ་ལ་དབྱིག་དང་གསར་བཀྲམ་ནས།",
    "རྒྱལ་བའན་སྟེགས་བུའི་སྟེང་དུ་རྡོ་རྗེརྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ཀྱི་ཆང་ཟུང་དྲང་པོར་འདུག་པར་བྱའོ།",
    "དེའི་གཡས་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁྲ་གཅིགཔ་དབུས་དྲང་པོར་འདུག་པར་བྱའོ།",
    "དེའི་གཡས་ལོགས་སུ་རྡོ་རྗེ་རྩ་གསུམ་པ་ཁ་གཉིས་པ་དབུས་དྲང་པོར་བྱས་ལ་པདྨའི་སྟེང་ན་འདུག་པར་བྲིའོ།",
    "པདྨམཚན་གྱིན་སྟེགས་བུའི་སྟེང་དུ་པདྨཡདེ་ཙམ་གྱི་ཁ་བྱེ་བ་རྩ་བ་དང་སྡོང་བུ་དང་བཅས་པར་འདུག་པར་བྱས་ལ།",
    "དྲེའི་དབུས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་བ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པ་གཞག་གོ།",
    "མཆེ་བའི་ནོ་སྟགས་བུབ་སྟེང་དུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ཀྱི་ཆང་ཟུང་དྲང་པོར་འདུག་པར་བྲིས་ལ།",
    "དེ་གཉིས་ཀྱི་བན་རྡོ་རྗེ་རྩེ་གསུམ་པ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་བདུག་པ་སྦྲུལ་གྱི་མཇུག་མའི་སྟེང་ན་འདུག་པར་བྱའོ།",
    "དེའི་གཡོན་ལོགས་སུ་དོརྗེ་རྩི་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པར་བྱའོ།",
    "དགེ་སློང་ཅིག་ཤོས་ན་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུགཏུགཞུག་ཅིང་གཟུགབཟང་མབཟླས་བརྗོད་བྱེད་བཞིན་དུ་གཞུག་པར་བྱའོ།",
    "བདག་ནི་སྤྱན་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་ནུབ་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ལ།",
    "ང་གང་ན་འདུག་པ་དེ་ན་ཕྱག་རྒྱགནས་ལ།"
  ]
}