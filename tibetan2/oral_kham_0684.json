    "ཕྱིས་ནི་བདག་ཉིད་འདུག་པ་ལའོ།",
    "ཁོ་རང་རང་ལོ་ཡི་སྔོན་དུ་བཟའ་སྒྲིག་བྱས་མ་མྱོང་།",
    "ཕན་པ་ཅི་ཡང་མེད་པར་སེམས་ལ་རྨ་ཁ་བཟོ་བྱེད་དེ་རང་ཡིན་པར་འདུག་ཅེས་སྨྲས།",
    "གཞན་རྣམས་གསལ་པོ་ཞིག་ཤན་འབྱེད་མི་ནུས་ཀྱང་དེ་དུས་ངས་སྟོད་གོས་ཅི་འདྲ་ཞིག་གྱོན་འདུག་ཅེས་དྲིས་བྱུང་བ་འདི་ཤིན་ཏུ་མཚར་ཆེ་སྟེ།",
    "དེས་འབྲས་བུ་ཅི་འབྱུང་ཁྱེད་རང་ཡིད་མི་ཆེས་ན་ཚོད་བལྟ་ཐེངས་ཤིག་གྱིས་དང་གསལ་ཡོང་།",
    "ང་རང་འདི་ནས་ལན་མ་གཅིག་ཙམ་བརྒྱུད་ནས་འགྲོ་ངེས་ཡིན།",
    "ང་རང་འདི་ནས་ལན་གཉིས་སུ་འགྲོ་བ་མེད་པའི་ཕྱིར་རོ།",
    "རང་ཉིད་གཅིག་པུར་ཁེར་འདུག་བྱེད་པ་མཆོག་ཡིན།",
    "ལྟོས་དང་དེ་ཚོ་ཚང་མ་ཆུང་མ་མཛངས་མ་ཞིག་དང་གཅིག་ཏུ་འབྲེལ་མི་འདུག་གམ།",
    "ངས་བལྟས་ན་མ་ལགས་དངོས་གནས་ལེགས་པོ་འདུག་ཟེར།",
    "གཉེན་རྨོངས་པ་ཞིག་ཏུ་འདུག་ཅེས་སྨྲས།",
    "མ་གཞིར་རང་ཉིད་འཇིག་རྟེན་འདིར་འོང་བ་དེས་ཉེས་འདུག་སོགས་ཀྱང་ལབ་པ་མིན་ནམ།",
    "ལེགས་པོ་ཞིག་ཏུ་གྱུར་པར་འདུག་གོ།",
    "དེང་ཕྱིན་མི་ཚེའི་ལྷག་མ་དེ་དེ་ལྟའི་ངང་དུ་སྐྱེལ་དགོས་པ་ལ་བསམ་ཚེ་ལས་ཀ་དག་ཕར་ཞོག་འདང་རྒྱག་ཀྱང་ཡེ་ནས་བྱེད་མི་ཕོད་པར་འདུགདུས་ཚོད་དེ།",
    "ཁོ་རང་རང་ཉིད་ཀྱི་བྱ་བཞག་ལ་བློ་གཞུངས་ཤིང་ལས་ཀའི་རྣམ་འགྱུར་དང་སྤུས་ཚད་ཀྱང་འཕང་རིམ་མཐོ་བའི་ཚད་དུ་གནས།",
    "མཐར་བློ་འདུན་དེ་ལ་ཅིས་ཀྱང་ཡིད་ཆེས་དགོས་པར་འདུག་པ་ཤེས་ཤིང་དེའི་ཕྱིར་དུ་སྤྱོད་པའང་བརྩམས་ཏེ།",
    "ཡིད་ཆེས་ཙམ་ལས་བྱ་སྤྱོད་མེད་ཚེ་ནུས་པ་ཅི་ཡང་ཐོན་མི་ཐུབ་པར་འདུག་གོ།",
    "གལ་ཆེའི་དུས་དེ་འདྲར་སེམས་ཀྱི་ཁུང་རོལ་ནས་ང་རང་དངོས་གནས་པ་དེ་འདི་གའོ་སྙམ་པ་ཞིག་ཚོར་ཐུབ་ཏུ་འཇུག་གོ།",
    "བྱ་བ་སྒྲུབ་པ་དང་དམིགས་འདུན་གང་རུང་ཞིག་ལ་སྙེག་ཕྱིར་རང་ཉིད་ལ་སེམས་ཁུར་འོས་འཚམ་དུ་བྱེད་པ་ནི་ཅིས་ཀྱང་དགོས་ངེས་ཤིག་ཏུ་འདུག་ཅེས་འཁོད་ཡོད།",
    "རང་ཤུགས་ངང་རང་གཤིས་ནར་སོན་པར་དཔྱད་པ་ཞེས་པའི་ནང་དུ།",
    "འོན་ཀྱང་གཙོ་བོ་འཚར་དུ་ལོངས་པའི་གོ་རིམ་ཁྲོད་གསར་གཏོད་ཀྱི་ཉམས་དོད་པའི་བྱེད་ཕྱོགས་དང་རྣམ་འགྱུར་ཞིག་ཅིས་ཀྱང་ཡོད་དགོས་ཅེས་སྨྲས་འདུག་མི་གཤིས་ཀྱི་གཉོམ་སོ།",
    "རང་དང་རང་ཉིད་ལྷན་དུ་འགྲོགས་པའི་ཐབས་ལམ་འཚོལ་བྱེད་ལེགས་པོ་ཞིག་ཏུ་སྣང་།",
    "ངའི་ལྟ་ཚུལ་དེ་ཁྱེད་རྣམ་པ་དང་མི་མཐུན་པར་འདུག་ལ།",
    "རྩེད་འཇོ་གང་ལའང་རང་སྟོབས་ཀྱིས་འཇུག་ནུས་པ་ལས་བག་འཁུམས་པོར་མི་སྡོད་པ།",
    "ད་ལྟ་ཁོའི་ལྟ་ཚུལ་དེ་ཁས་ལེན་མཁན་མི་ཉུང་བ་བྱུང་འདུག་ལ།",
    "འདི་ལ་བརྟེན་ནས་ཅིས་ཀྱང་རང་གཞན་གྱི་དོན་དང་འགྲོ་བ་མིའི་རིགས་ཀྱི་བདེ་སྐྱིད་ཅིག་འཚོལ་སྙོག་བྱེད་པར་འོས་སོ།",
    "འོན་ཀྱང་དེ་ཚོར་དེ་འདྲའི་གོ་སྐབས་བེད་སྤྱོད་ཐུབ་པའི་ཐབས་རྩལ་ངོ་མཚར་བ་ཞིག་འདུག་སྙམ།",
    "མི་འདི་དག་དང་གཏམ་གླེང་བྱེད་པའི་བྱེད་ཐབས་ལེགས་ཤོས་ནི་ཁོ་རང་ཁོ་ན་ལས་གཞན་མི་སྐད་སྨྲ་ཤེས་མཁན་གཅིག་ཀྱང་མེད་པ་ལྟར་ཡིད་འཐད་ཁོ་ནའི་རྣམ་འགྱུར་སྟོན་པ་དེའོ།",
    "མིའི་རིགས་ལ་བློ་དཀར་བ་དང་བརྩེ་བ་ཆེ་བ་ཞིག་ཏུ་འདུག་པ་དེ་ཡིན་སྙམ།",
    "ང་རང་ལ་མཚོན་ནའང་འདི་ཕྱོགས་ཀྱི་མྱོང་བརྒྱུད་ཡོད་དེ།",
    "ཚེ་སྲོག་ཤོར་བའི་མི་དེས་ང་ལ་མཚོན་ན་དོན་དུ་ཚེ་སྲོག་བསྐྱབས་ནས་འདུག་ཅེས་པ་དེའོ་ཞེས་སྨྲས།",
    "གསར་གཏོད་རང་བཞིན་གྱི་སྒྱུ་རྩལ་པ་དེས་གསར་རྩོམ་ཁོ་རང་གལ་ཆེན་དུ་འཛིན་དགོས་པ་ལས།",
    "མིའི་ཕྱོགས་དུ་མའི་ནུས་པ་གང་ལ་མཚོན་ནའང་དོན་ལ་གནས་པ་ཞིག་ཏུ་འདུག་ཚུར་ལ་དགའ་དུང་འཐོབ་པར་འདོད་ན་དང་པོ་རང་ཉིད་དགའ་རི་བ་ཞིག་ཡིན་དགོས་ལ།",
    "མེད་ཀྱི་ངང་དུ་ཡུན་རིང་གནས་པར་འདུག་ཁོ་བོས་དེ་ལ་ཐབས་ཅི་དྲག་ཀྱིས་གོ་སྐོན་རོགས་རམ་མང་དུ་བྱས་ཀྱང་ཕན་པ་མ་བྱུང་།",
    "སེམས་མི་ཤེས་པར་འདུག་དེ་ཡང་གཙོ་བོ་བརྩེ་བ་དང་མཛའ་གཅུགས་སོགས་ཚུར་ལ་ལེན་བྱ་ཁོ་ན་ལས་ཕར་ལ་གཏོང་དགོས་པ་ཞིག་ཡིད་ལ་ཤར་མ་མྱོང་བས་ལན་འདུགདབེན་སྐྱོ་ཁེར་རྐྱང་ངང་གནས་པའི་མི་མང་པོ་ཞིག་དེ་ལྟར་གྱུར་པའི་རྒྱུ་རྐྱེན་ནི།",
    "དེ་ཚོ་དངོས་གནས་འབྱུང་སྲིད་ན་བདག་ལ་བྱ་ཐབས་མི་འདུག་སྙམ།",
    "དེའི་ཚེ་དེ་མཚར་པོ་ཞིག་ཏུ་འདུག་སྙམ་ཤར་ཞིང་།",
    "ད་ལྟ་བསམ་ན་འགྱོད་པ་མི་འདུག་སྟེ།",
    "ཨར་ལས་པ་སོགས་ཀྱང་རང་བཞིན་དེ་ལས་མ་འདས།",
    "པ་ལགས་ཞིང་པ་དཀྱུས་མ་སེམས་ཁོད་ཡངས་པ་ཞིག་ལས་མ་འདས་ཀྱང་རང་ལོ་བར་མི་ཚེའི་བདེ་སྐྱིད་སྐྱེལ་ཐུབ་པ་བྱུང་།",
    "སྐྱོ་ཁྲལ་ལ་ཡ་ལན་བསློག་མི་ཤེས་པའི་ཚོང་ལས་པ་ཚང་མ་ཚེ་ཐག་ཐུང་ངུ་ལས་འཚོ་མི་ཐུབ་པར་འདུག་གོ།་",
    "སྐྱོ་ཁྲལ་སེལ་ཐབས་ཀྱི་གཏམ་རྒྱུད་དངོས་མ་ཞིགསྐྱོ་ཁྲལ་ནི་ལག་ཡ་གཏུམ་ཤོས་སུ་འདུགཊེ་ཁ་ཏུན་པོ་སི།",
    "འགྲན་སྡུར་གྱི་སྐབས་སུ་ང་རང་སུ་ལས་ཀྱང་སྟོབས་ཆེ་བར་ཡོད།",
    "དེ་ཅི་འདྲའི་བླུན་ཚུགས་ཤིག་ཏུ་འདུག་གམ་སོགས་སྙམ་ནས་སྐྱོ་ཁྲལ་སེལ་བའི་ཐབས་ལ་བརྩོན་པར་བྱེད།",
    "ཕན་པ་ཤིན་ཏུ་ཆེན་པོ་ཐོན་པ་བསམ་ཡུལ་ལས་འདས་པའི་ཚོད་དུ་འདུག་གོ།",
    "དེ་སྔོན་ཨ་རི་རྒྱལ་ཚོགས་ཀྱི་གྲོས་ཞུགས་པ་ང་རང་ལོ་ན་ཙམ་གྱི་དུས་ནས་རང་དམན་འདུ་ཤེས་གཏིང་ཟབ་པ་ཞིག་ཆགས་ཡོད།",
    "དེ་ཡང་ང་རང་ལུས་གཟུགས་ཤིན་ཏུ་རིང་ལ།",
    "འོང་ཀྱང་ཕ་མ་སོགས་ཀྱི་སྐུལ་མ་ལ་བརྟེན་ཞིང་རང་ངོས་ཀྱིས་བརྩོན་པ་བསྐྱེད་ནས།",
    "གལ་ཏེ་ལེགས་འགྲུབ་ཐེངས་དེ་མེད་ན་ད་ལྟ་རྒྱལ་ཚོགས་ཀྱི་གྲོས་ཞུགས་པའི་གྲལ་དུ་ང་རང་ཞེས་པ་ཞིག་ཀྱང་ཡོད་མི་སྲིད་སྙམ།",
    "ལོ་ཙཱ་པ་ཞིག་བཙལ་ན་གཏམ་ལེགས་པོར་མ་སྨྲས་ཕྱིན་ཁོ་རང་ཁོང་ཁྲོ་འཕར་བའི་རྐྱེན་དུ་འགྲོ།",
    "སྐྱོ་ཁྲལ་ལ་ཡ་ལན་བསློག་མི་ཤེས་པའི་ཚོང་ལས་པ་ཚང་མ་ཚེ་ཐག་ཐུང་ངུ་ལས་འཚོ་མི་ཐུབ་པར་འདུག་གོ་ཞེས་པའོ།",
    "འོན་ཀྱང་དེ་ནི་སྟོང་བསམ་ཁོ་ན་ཡིན་འགྲོ།",
    "ང་རང་ཤ་ཁྲག་མིག་ཆུ་དང་བཅས་ཏེ་འཚོ་མྱོང་སྟེ།",
    "ཁོ་རང་སྐྱོ་ཁྲལ་གྱི་དགྲ་ལས་རྣམ་པར་རྒྱལ་ཟིན།",
    "ཉིན་ཞིག་ང་རང་ལ་ད་དུང་བུ་བྱིས་པ་ལོ་ན་རུ་ལོན་པ་ཞིག་ཡོད་པ་དེ་འོང་ནས་དེས་ང་རང་བསྐུལ་ཏེ་ཁོ་ལ་གྲུ་གཟིངས་ཆུང་ངུ་ཞིག་བཟོ་དགོས་ཟེར།",
    "སྐྱོ་ཁྲལ་བྱེད་པའི་དུས་ཚོད་མི་འདུག་ཅེས་པ་སྲིད་སྤྱི་ཆིའུ་ཇེར་ལགས་ཀྱི་གཏམ་སྟེ།",
    "ལན་དུ་ང་ལ་སྐོ་ཁྲལ་བྱེད་པའི་ཁོམ་ལོང་མི་འདུག་ཅེས་སྨྲས་པར་གྲགས།",
    "ང་རང་བྲེལ་བའི་ངང་དུ་ལུས་སུ་འཇུག་པ་དགའ་ཞེས་པ་ཙམ་གྱིས་ཀྱང་སྐྱོ་ཁྲལ་སྒོ་རུ་འདོན་ཐུབ།",
    "མི་ཡུལ་ན་འདི་འདྲ་འདུག་གོ་ལེའུ་བརྒྱད་པ།",
    "ང་རང་ཁ་སང་གྲུ་གཟིངས་ཆེན་པོ་ཞིག་ལ་བསྡད་ནས་འོང་བ་ཡིན།",
    "དེར་བཅད་ཤག་ཆེ་བ་ཁ་ཤས་ཤིག་འདུགགྲུ་གཟིངས་ལམ་ལ་ཆས་གྲབས་དང་བསྟུན་གཟིངས་དཔོན་གྱི་བཀོད་འདོམས་ལྟར་བཅད་ཤག་སོ་སོའི་བར་གླེགས་གཏན་ནས་སྲུབས་མཚམས་དམ་སྦྱར་བྱས།",
    "མལ་ཁྲིའི་སྟེང་དུ་འགྱེལ་བའི་བར་འཚོ་བཞིན་འདུག་ཅེས་སྨྲས་པ་འདི་ལེགས་གསུང་ཞིག་ཏུ་སྣང་།",
    "ང་རང་གནས་ས་དེ་ད་ལྟ་ཁོ་ན་ཡིན་པར་གོ་བ་སྐྱེས།",
    "ང་རང་དངོས་ཡོད་ཀྱི་འཚོ་བའི་ཁྲོད་དུ་གནས་མེད་པར།",
    "ང་རང་ནམ་རྒྱུན་སྔར་འདས་ཀྱི་དོན་བྱ་ཞིག་ལ་འགྱོད་པ་སྐྱེ་བཞིན་ཡོད་དམ།",
    "ང་རང་ཞོགས་པ་ཡར་ལ་ལངས་པ་དང་མཉམ་དུ།",
    "ཐབས་ཟད་དེ་ཕྱིར་ལོག་དུས་དེ་ནས་བཟུང་ཁོ་བོས་སྔར་བྱས་ཀྱི་དོན་བྱ་ཕྲན་ཚེགས་ཀྱི་ཆེད་དུ་ཆུང་མ་ལ་འཁོན་པ་སློང་བ་དང་།",
    "འདི་ཀར་འདུག་ཏུ་ག་ལ་རུང་།",
    "དེ་དུས་ང་རང་སེམས་ཁ་འཚེར་ཞིང་ལུས་ཕུང་ཡང་བདེ་ཐང་མིན་པས།",
    "ང་རང་བྱིས་པའི་དུས་ཀྱི་དུས་ཚོད་མང་ཤས་དེ་ཞིང་ར་རུ་བསྐྱལ་བ་ཡིན།",
    "མ་ལགས་ནས་ཅིའི་ཕྱིར་ཞེས་དྲིས་པ་ན་ང་རང་ནམ་ཞིག་གསོན་པོར་དུར་སྦས་བྱེད་སྲིད་དམ་ཞེས་ལན་སྨྲས།",
    "སྔོན་མ་ཡིན་ན་ང་རང་ཡང་འོས་མིན་ཀུན་ལ་སེམས་ཁྲལ་བྱེད་མཁན་གྲགས་ཆེ་བ་ཞིག་ཡིན།",
    "ནམ་ཞིག་ཙ་ནས་བཟའ་ཟླ་དང་པོ་དང་ཡང་ཁ་གྱེས།",
    "ཡོད་ན་གནས་བབ་ཅི་འདྲ་ཞིག་ཏུ་འདུག་དཔྱད་གཞིའི་རྒྱུ་ཆ་འཕྲལ་མར་འཚོལ་དགོས་ཟེར་ནས་བཀའ་འབེབས་བྱེད་ཟེར།",
    "དོན་བྱ་དེ་དེ་འདྲ་ཞིག་ཏུ་འདུག་པ་ཁོ་ཐག་ཆོད་ཕྱིན།",
    "གཡོལ་ཐབས་མེད་པའི་དོན་དག་ཅིག་ཏུ་འདུག་ཕྱིན་ཅིས་ཀྱང་དེ་དང་ལེན་དང་དེ་ལ་འཕྲོད་བསྟུན་བྱེད་དགོས།",
    "ང་རང་དགའ་ཞེན་ཤིན་ཏུ་ཆེ་བའི་སེམས་ཁམས་རིག་པ་སྨྲ་བ་དང་མཚན་ཉིད་རིག་པ་སྨྲ་བ་ཝེ་ལེམ་ཇམ་ཟི་ལགས་ཀྱི་གསལ་སྒྲོན་གྱི་གསུང་དེ་ཤིན་ཏུ་མད་དེ།",
    "ཞེས་བྲིས་འདུག་ལ།",
    "ཞེས་བྲིས་འདུག་ལ།",
    "མ་ངེས་པའི་རྒྱུ་རྐྱེན་སྣ་ཚོགས་ཀྱི་ཀློང་དུ་བྱིངས་པའི་ལྐོག་གྱུར་གྱི་གནས་དཔག་དཀའ་བ་ཞིག་འདུག་པའི་ཕྱིར་རོ་ཟེར།",
    "དེ་ལས་ལྷག་པའི་སེམས་འཚེར་ཆེ་བ་ཞིག་བྱེད་དགོས་དོན་མི་འདུག་སྲིད་སྤྱི་ཆེན་པོ་ལིན་ཁེན་ནས་འདི་ལྟར་སྨྲས།",
    "ང་རང་རང་ལོ་ཙམ་གྱི་དུས་དེར་སྒྲུང་རྩོམ་འབྲི་བར་ཤིན་ཏུ་དགའ་བོ་ཡོད།",
    "མ་མཐའ་ཡང་ད་ལྟ་ཕྱིར་དྲན་བྱས་ཚེ་ཁོ་བོ་ཧ་ཏེ་གཉིས་པར་མ་གྱུར་སྙམ་ནས་འགྱོད་པ་མི་སྐྱེ་བར་འདུག་གོ།",
    "དེ་ནས་དེ་ཉིད་ཡིད་ལ་མི་བྱེད་པར་འདོར་དགོས་པར་འདུགསྐྱོ་ཁྲལ་སེལ་ཐབས་ཀྱི་གཏམ་རྒྱུད་དངོས་མ་ཞིགནམ་ཡང་རང་ལ་ཕྱི་ལམ་ཞིག་འཇོག་པར་བྱ།",
    "ཐ་ན་ལས་ཀ་བྱེད་སྐབས་གླུ་དབྱངས་གཏོང་མཁན་ཡང་འདུག་གོ།",
    "དེ་བཞིན་སྐུ་ཞབས་ཐྲ་ལིས་ལགས་ཀྱིས་ཀྱང་རང་ཉིད་ཀྱི་ལས་ཀ་དེ་ལ་དགའ་བ་རྩེ་གཅིག་འཆང་ཡོད་ཕྱིན།",
    "ཕྱིས་སུ་ཁོ་རང་གྲགས་པ་ཆེ་བའི་ཨ་རིའི་རླབས་སྒྲ་གནམ་གྲུ་སྤྱི་གཉེར་གྱི་ལེའུ་དགུ་པ།",
    "སུམ་ཆའི་གཉིས་ཀྱིས་ལས་རིགས་ལྔ་ཁོ་ན་བདམས་འདུག་ཟེར།",
    "འདི་ལྟར་བསམ་ན་ལས་རིགས་ཁ་ཤས་ཀྱི་སྒོར་འཚང་ཀ་ཤིག་ཤིག་བྱེད་བཞིན་ཡོད་པ་ལའང་ཁག་མི་འདུག་ལ།",
    "སེམས་ཁ་བདེ་བོ་མིན་པའི་སྐོར་མང་པོ་འདུག་པ་ལའང་ཁག་མེད་སྙམ།",
    "ང་རང་ལ་བཟོ་སྐྲུན་བྱ་བ་ལེའུ་དགུ་པ།",
    "ལེགས་འགྲུབ་ཡོང་བའི་མཐུན་ཆར་གྱུར་པ་ཅང་འདུག་གམ།",
    "གལ་ཏེ་ང་རང་ཁྱེད་ཀྱི་བུ་ཡིན་ན།",
    "གནས་དེ་ནི་ང་རང་མི་ལོ་ལ་འཚོ་བ་བསྐྱལ་བའི་གནས་ཡིན་ཅིང་།",
    "དཔེ་དེབ་རྩོམ་པ་པོ་ཁྱེད་རང་འོང་ནས་ཚོད་བལྟ་ཞིག་གྱིས་དང་།",
    "ཐ་ན་ཡོངས་སུ་བརྩིས་ཟིན་རྗེས་ནོར་དོན་མཚལ་ཡིག་སྟེ་སྟོང་ཆ་ཐོན་འདུག་ཟེར།",
    "གང་ལྟར་མཐོང་ཐོས་དངོས་སུ་བྱུང་བའི་འདི་འདྲའི་དཔེ་ཡང་མང་པོ་ཞིག་འདུག་གོ།",
    "གལ་ཏེ་མ་ལགས་འཇིག་རྟེན་འདི་དང་ཁ་གྱེས་ཚེ་ང་རང་དྭ་ཕྲུག་ཁེར་རྐྱང་དུ་ལུས་པར་འགྱུར།",
    "ང་རང་དེ་ལ་ཞེད་སྣང་ཆེན་པོ་ཞིག་ཡོད།",
    "དཔའ་སྤོབས་ལྡན་ཞིང་བློ་ཁ་བརྟན་པ་དག་ལ་ཕྱོགས་ལྷུང་བསྟེན་པར་འདུག་གོ།",
    "སྨྲ་བར་འོས་པ་ནི་དེ་ལྟའི་ལྟ་བ་འཆང་མཁན་ཁོ་རང་གཅིག་པུ་ག་ལ་ཡིན་ཏེ།",
    "འོན་ཀྱང་དེ་ལྟ་བུ་མང་ཤས་ཡིན་པའི་སེམས་ཁྲལ་ཡང་བྱེད་མི་དགོས་པར་འདུག་སྟེ།",
    "དཔའ་སྤོབས་ལྡན་ཞིང་བློ་ཁ་བརྟན་པ་དག་ལ་ཕྱོགས་ལྷུང་བསྟེན་པར་འདུག་གོ་ཞེས་སྨྲས་པ་མིན་ནམ།",
    "འགན་ལེན་དེ་ཙམ་མེད་པའི་ཉམས་ཤིག་རང་ཤུགས་ཀྱིས་འདུག་སྙམ།",
    "དེ་ཡང་ཉིན་ཞིག་དེ་སྔོན་ལས་ཀ་སྒྲུབ་པའི་སྐབས་ཤོག་འཛར་དུ་མའི་ངོས་སུ་བློ་རྟེན་གྱི་ཆེད་དུ་བྲིས་པ་སྣ་ཚོགས་ཤིག་ཡོད་པ་ཤོག་གཟེབ་ཏུ་དོར་འདུག་པ་མཐོང་།",
    "ད་ལྟ་འཛམ་གླིང་རང་བཞིན་གྱི་སློབ་ཚན་ཞིག་ཁྲིད་མགོ་ཚུགས་ཡོད་དེ།",
    "ང་རང་ནི་རང་བྱུང་ཁམས་ཆེན་པོ་དེའི་བླ་བུ་ཞིག་ཡིན་ལ།",
    "ང་རང་འཕགས་པ་ཞིག་མིན་ནའང་ཚད་འདིར་བསླེབས་ཚེ་བྱེད་པོའི་འདོད་བློ་བཟློག་ཏུ་མེད་པ་ཤེས་ཡོད།",
    "དེ་ནས་བཟུང་ང་རང་ད་ལྟའི་བར་ལེགས་པར་འཚོ་ཐུབ་པ་ནི་སྒྱུ་འཕྲུལ་རང་བཞིན་གྱི་མཉམ་བྱའི་རྩིས་ཕྲེང་ཁྱད་པར་བ་ཞིག་སྤྱད་པ་སྟེ།",
    "ཁོ་རང་དང་པོ་ཙ་ན་གཉིད་སྟུག་པོ་དང་ལྡན་པ་ཞིག་ཡིན་པས།",
    "ང་རང་བགྲོད་བཞིན་པའི་ངང་ལ་གཉིད་དུ་འགྲོ་ཞིང་།",
    "དེ་ཡང་དྲན་པ་ཤོར་ཟིན་པ་ལྟར་དུ་འདུག་དེ་ཚོའི་མིག་ལྕིབས་ཕྱེས་ནས་བལྟས་པས་མི་འབྲས་དེ་མིག་ཀོང་འོག་ཕྱོགས་སུ་འདྲིལ་བའམ་མར་འཁོར་ནས་འདུག་ཁོ་བོས་དེ་ཤེས་པ་ནས་བཟུང་རང་ལ་གཉིད་མ་འོང་ཚེ་མིག་འབྲས་མར་བསྐོར་ཏེ་དབེན་འཇགས་ངང་ཅུང་ཙམ་བསྡད་པས་འཕྲལ་མར་བདེ་བླག་ཏུ་གཉིད་ལ་འཇུག་པར་འགྱུར་ཟེར།",
    "ཁྱེད་རང་གང་ལྟར་འཚོ་མི་འདོད་པ་ཐག་ཆོད།",
    "འཆི་ངེས་པ་ཅན་དུ་འདུག་འོན་ཀྱང་ཁྱེད་རང་གསོད་མཁན་ཞིག་མེད།",
    "དེས་ན་ད་ནས་བཟུང་ཁྱེད་རང་གྲོང་སྐོར་ལམ་འདི་དེད་ནས་སྐྱར་སྐོར་ཡང་ཡང་བྱས་ཏེ་ཐང་ཆད་ནས་འཆི་རུ་འཇུག་པ་དེ་ཐབས་བཟང་ཤོས་ཡིན་ཞེས་སྨྲས།",
    "ཁྱེད་རང་གཉིད་ཡེར་བའི་དོན་དུ་སྐྱོ་ཁྲལ་བྱེད་པ་ཡིན་ན།",
    "ང་རང་བྲེལ་བ་ཤིན་ཏུ་ཆེ་སྟེ།",
    "ང་རང་སྐྱོ་ཁྲལ་སེལ་བའི་ཐབས་ལ་མཁས་ཏེ།",
    "འཛེག་ན་ཐར་བ་གམ་ན་འདུགཅེས་པ་དང་།",
    "ནམ་མཁའི་དབྱིངས་ལ་ཅི་འདུག་ལྟོས་།",
    "ཞེས་དངོས་པོའི་གནས་ཚུལ་གྱི་དོན་དམ་ནི་རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པ་དེ་ཙམ་དུ་ཟད་པས།",
    "རང་བཞིན་དང་བཅས་པར་ངེས་པར་བྱེད་དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེ་དོ།",
    "ཞེས་ཡོད་པ་ཙམ་དང་རང་བཞིན་གྱིས་ཡོད་པ་གཉིས་ཀྱི་ཁྱད་པར་ཕྱེའོ།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ།",
    "དང་པོ་རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ་",
    "དེ་ལྟ་ན་མྱུ་གུ་རང་བཞིན་མེད་དོ་ཞེས་པའི་སྒྲས་ཀྱང་རང་བཞིན་མེད་པ་ཡོད་པ་དེ་ཤུགས་ལ་བསྟན་དགོས་ཏེ་སྒྲ་དེའི་རྗེས་སུ་འབྲང་བའི་བློས་དེ་ཡོད་པར་ཤུགས་ལ་རྟོགས་པའི་ཕྱིར་རོ།",
    "དགག་བྱའི་སྤྲོས་པ་མེད་པར་དགག་པ་ཙམ་དུ་བཟུང་ན་ཤེར་ཕྱིན་ལ་སྤྱོད་ཀྱི་མཚན་མ་ལ་སྤྱོད་པ་མིན་པ་ལ་དགོངས་ནས་ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "དེས་ན་རང་ལུགས་སྒྲུབ་པའི་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་ཁས་ལེན་ཀྱང་རང་རྒྱུད་ཀྱི་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་ཁས་ལེན་པ་མིན་ནོ།",
    "ཞེས་རང་མཚན་གྱི་གྲུབ་པའི་སོ་སོ་བ་ལ་རྒྱུད་གཅིག་པ་དང་རྒྱུ་འབྲས་བཀག་ཅིང་རང་མཚན་གྱིས་སོ་སོར་གྲུབ་ན་ལྟོས་པ་མི་རུང་བ་ལན་དུ་མར་གསུངས་སོ།",
    "ཅེས་གསུངས་པ་ལྟར་འགྲོ་འོང་རང་བཞིན་མེད་པར་འགྲུབ་བོ།",
    "འབྲས་བུ་རྒྱུ་དང་རང་བཞིན་གཅིག་ཐ་དད་བཀག་པ་ཉིད་ཀྱིས་བཅོ་བརྒྱད་པ་ལས་འཆད་པ་ལྟར་རྟག་ཆད་ཀྱང་སྤོང་ངོ།",
    "མར་དང་འབྲུ་མར་ཞེས་པའི་འབྲས་བུ་མེད་ན་འབྲུ་དང་ཞོ་དག་རྐྱེན་དང་རྐྱེན་མིན་དུ་མི་རིགས་པས་འབྲས་བུ་དང་རྐྱེན་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དེ་ཞེ་ན།",
    "དེ་ལྟར་བཟུང་བའི་དོན་དེ་ཡོད་པར་ཁས་ལེན་ན་འབྲས་བུ་སྐྱེ་བ་དེ་རྒྱུ་རྐྱེན་དང་རང་བཞིན་གཅིག་པ་དང་ཐ་དད་པའི་སྐྱེ་བ་གང་ཡིན་ཞེས་དཔྱད་ནས་འབྲས་བུའི་ངོས་ནས་བསྐྱེད་བྱའི་རང་བཞིན་དང་།",
    "དེ་ནས་རྒྱུ་འབྲས་དེ་དག་མིང་དུ་བཏགས་པ་ཙམ་དུ་འཆར་ལ་ཕན་གནོད་བྱེད་པའི་རྒྱུ་འབྲས་ལ་ནི་བསྙོན་ས་མེད་པས་བཏགས་པ་ཙམ་གྱི་རྒྱུས་འབྲས་བུ་སྐྱེད་པར་འདུག་པ་ལ།",
    "ཅི་སྟེ་ལྷས་བྱིན་གཅིག་འདུག་བཞིན་དུ་སྨྲ་བ་དང་ལྟ་བར་ཡང་བྱེད་པ་དེ་ཡི་ཚེ།",
    "བྱ་བ་ཐ་དད་པས་དེའི་སྒྲུབ་བྱེད་ནུས་པ་ཡང་ཐ་དད་པར་གྲུབ་པ་ཡིན་ཏེ་འདུག་པའི་བྱ་བས་སྨྲ་བ་པོར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "ནུས་པའི་བྱེད་པ་པོ་མང་པོ་དུས་གཅིག་ཏུ་ཡོད་ཀྱང་གང་ཟག་དུས་གཅིག་ཏུ་མང་པོ་མི་དགོས་སོ།",
    "དེས་ན་དེ་བརྗོད་པའི་རྒྱུ་འགྲོ་བ་ཡང་རང་བཞིན་གྱིས་མེད་དོ།",
    "དངོས་མིང་སོ་སོས་གོ་བྱ་ཐ་དད་དུ་མེད་པ་གཅིག་པའི་དོན་དང་འབྲེལ་མེད་དོན་གཞན་དུ་ཡོད་པ་ཐ་དད་པའི་དོན་དུ་བཟུང་ནས་དེ་གཉིས་སུ་མ་གྲུབ་ཀྱང་རང་བཞིན་གྱིས་ཡོད་སྙམ་པ་ཡིན་ལ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག།",
    "དང་པོ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག་",
    "རང་བཞིན་མེད་ན་མཚན་ཉིད་བསྟན་པ་མི་རིགས་པས་མཚན་ཉིད་ཡོད་པའི་ཕྱིར་ཁམས་རྣམས་རང་བཞིན་གྱིས་ཡོད་ལ་དེ་ལྟ་ན་ཁམས་བཞིན་དུ་ཕུང་པོ་དང་སྐྱེ་མཆེད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ།",
    "གལ་ཏེ་ཡང་མཚན་ཉིད་དང་མཚན་གཞི་རང་བཞིན་གྱིས་མེད་པ་དེ་ལྟ་ནའང་དངོས་པོའི་རང་བཞིན་གྱི་ནམ་མཁའ་ནི་ཡོད་ལ་དེ་ལྟ་ན་མཚན་གཞི་འམ་མཚན་ཉིད་དུ་འགྱུར་བས་དེ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེ་ན།",
    "འདིར་ཆགས་སོགས་རང་བཞིན་གྱིས་ཡོད་ན་ཕུང་པོ་ལ་སོགས་པ་ཡང་རང་བཞིན་གྱིས་ཡོད་ནའང་དེ་ལྟར་ནི་མེད་དོ།",
    "མུན་པ་གང་སེལ་བས་མར་མེས་གཞན་གསལ་བར་བྱེད་པ་ཡུལ་གང་དག་ན་མར་མེ་དེ་འདུག་པ་སྟེ་དེའི་འོད་ཀྱིས་ནོན་པ་དེ་ནའང་མུན་པ་མེད་དོ།",
    "གལ་ཏེ་སྣང་བའི་བདག་ཉིད་ཡིན་པས་མར་མེས་རང་བཞིན་གྱི་དངོས་པོ་གཉིས་སྣང་བར་བྱེད་པར་འགྱུར་ན་སྒྲིབ་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་མུན་པའང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉིས་ཀ་སྒྲིབ་པར་བྱེད་པར་འགྱུར་བར་ཐེ་ཚོམ་མེད་དོ།",
    "དེ་ལ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དེ་དེ་ནི་དངོས་པོར་མི་འཐད་པ་སྟེ་དངོས་པོའི་མཚན་ཉིད་འཇིག་པ་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "འདིར་རྒྱུན་དང་སྐད་ཅིག་གང་ལ་ཡང་རང་གྲུབ་པའི་དུས་ལས་དུས་གཉིས་པར་གནས་པ་ནི་ཐ་སྙད་དུ་ཡང་མེད་པས།",
    "དེའི་ཕྱིར་ལོ་རྫོགས་པ་ལ་ཟླ་བ་བཅུ་གཉིས་རྫོགས་དགོས་ཤིང་དེའི་འོག་ཏུ་ལོ་དེ་མི་གནས་པས་རྒྱུན་ཐམས་ཅད་ཀྱང་རང་གྲུབ་པའི་དུས་ལས་དུས་གཉིས་པར་མི་སྡོད་པའི་སྐད་ཅིག་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་སྒྱུ་མ་ལ་སོགས་པ་ལ་ཇི་ལྟར་སྣང་བ་ལྟར་གྱི་རང་བཞིན་མེད་ཀྱང་དེ་རྣམས་སྒྲའི་ཐ་སྙད་ཀྱི་ལམ་དུ་འགྱུར་བ་བཞིན་དུ་སྐྱེ་བ་ལ་སོགས་པ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཀྱང་འཇིག་རྟེན་ལ་གྲགས་པ་ཙམ་གྱི་སྒོ་ནས་བསྟན་ཏོ།",
    "རྩོད་ཟླས་འགལ་བ་བསྒྲིགས་པའི་ཚེ་དྲན་པར་འགྱུར་ལ་དེའི་ཚེ་ངས་སྔར་རྟག་པར་ཁས་བླངས་འདུག་སྙམ་དུ་དྲན་གྱི་དུས་ཕྱི་མའི་དུས་ན་ཡོད་པའི་ང་འདིས་སྔར་རྟག་པ་ཁས་བླངས་སོ་སྙམ་དུ་མི་དྲན་ནོ།",
    "དེ་བཞིན་དུ་ཚེ་འདིའི་མི་ལྷས་བྱིན་གྱིས་སྔོན་གྱི་སྐྱེ་བ་དྲན་པ་ན་ང་སྔར་དེ་དང་དེར་སྐྱེས་འདུག་སྙམ་དུ་དྲན་པ་ཡིན་གྱི་ཚེ་འདིའི་དུས་ཀྱིས་ཁྱད་པར་དུ་བྱས་ནས་ང་སྔར་དེ་དང་དེར་སྐྱེས་འདུག་སྙམ་དུ་མི་དྲན་ནོ།",
    "ཞེས་རྐྱེན་ལ་རག་ལས་པ་དེ་རང་བཞིན་གྱིས་མ་སྐྱེས་པའི་དོན་དུ་གསུངས་པ་ལྟར་འདུ་བྱེད་བརྫུན་པར་གསུངས་པ་དེ་ཀྱང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་སྟོན་གྱི་སྐྱེ་བ་བཀག་པའི་དངོས་མེད་སྟོན་པ་མིན་ནོ།",
    "ཕ་རོལ་པོས་འདི་ལ་ནི་སྦྱིན་རྒྱུའི་ཟོང་མེད་པར་འདུག་སྙམ་པའི་བློ་བསྐྱེད་པའི་ཕྱིར་དུ་ཚིག་དེ་སྨྲས་པས་ན་བློ་དེ་བསྐྱེད་དུ་མི་རུང་བ་མིན་གྱི་ཟོང་མེད་པ་དེ་ཟོང་གཅིག་ཡིན་པར་འདུག་སྙམ་པའི་བློ་དེ་བསྐྱེད་དུ་མི་རུང་ངོ།",
    "འཇིག་རྟེན་ན་བཅོས་མར་འཇོག་ན་རང་བཞིན་དུ་ཐ་སྙད་མི་བྱེད་པའི་ཚུལ་དེ་ཁས་མི་ལེན་ཞིང་རང་ལུགས་ལ་དེ་ལྟར་ཁས་ལེན་ནོ།",
    "གལ་ཏེ་བྱས་པ་ཡིན་པས་རང་བཞིན་མིན་ནོ་ཞེས་སྨྲ་ན་རང་བཞིན་གྱི་མཚན་ཉིད་ནི་གང་རང་བཞིན་དེ་ཡང་གང་ཞེ་ན།",
    "དུས་སྔ་མར་རང་བཞིན་གྱིས་ཡོད་པ་ཞིག་དུས་གཉིས་པར་ཞིག་པར་འདོད་ན་དེའི་རྒྱུན་ཆད་པར་ཁས་མི་ལེན་ཀྱང་ཆད་ལྟར་འགྱུར་བས་དངོས་པོ་རང་བཞིན་གྱིས་གྲུབ་པར་འདོད་ཕྱིན་ཆད་རྟག་ཆད་ཀྱི་ལྟ་བ་ལས་མི་འདའོ།",
    "ཁམས་ཀྱི་དབྱེ་བ་དང་རང་བཞིན།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "ཅི་སྟེ་རང་བཞིན་མེད་པ་ལ་བྱ་བྱེད་མི་འཐད་པའི་ཕྱིར་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་རྩོད་པས་ནི།",
    "དེའི་ལན་དུ་རང་བཞིན་དང་བཅས་པ་རྣམས་ལ་བྱ་བ་མ་མཐོང་བའི་ཕྱིར་དང་རང་བཞིན་མེད་པ་རྣམས་ཁོ་ན་ལ་བྱ་བ་མཐོང་བའི་ཕྱིར་རོ།",
    "རང་བཞིན་གྱིས་ཡོད་ན་བསྐྱེད་བྱ་བསྐྱེད་བྱེད་ལ་སོགས་པའི་བྱ་བྱེད་ཐམས་ཅད་མི་འཐད་ཅིང་རང་བཞིན་གྱིས་མེད་པ་ཁོ་ན་ལ་བྱ་བྱེད་དེ་དག་འཐད་པར་བསྟན་ཏེ།",
    "གཞན་ཡང་རང་བཞིན་མེད་པས་བྱ་བ་བྱེད་པའི་དོན་འདི་ཉིད་དཔེ་གསལ་པོ་འདི་ལས་ངེས་པར་བྱ་སྟེ།",
    "སྤྲུལ་པ་དེ་གཉིས་དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་གྱིས་སྟོང་ཞིང་རང་བཞིན་མེད་པ་ལྟར་དེ་རྣམས་ལ་རང་བཞིན་མེད་པའི་བྱ་བ་བྱེད་པ་དང་།",
    "ངའོ་སྙམ་པ་གང་ལ་སྐྱེ་བའི་གཞི་བདག་དེ་ཕུང་པོ་དང་རང་མཚན་གྱིས་གཅིག་ཏུ་གྲུབ་ན།",
    "དེའི་དུས་ཀྱི་བདག་ནི་ལུས་ལྟར་ཞིག་པའི་ཕྱིར་དང་ཚེ་འདིར་དེ་དང་རང་མཚན་ཐ་དད་པའི་བདག་སྐྱེས་པའི་ཕྱིར་རོ།",
    "རྣལ་འབྱོར་པས་ང་རང་བཞིན་གྱིས་གྲུབ་པར་འཛིན་པ་དང་ང་ཡི་བ་རང་བཞིན་གྱིས་གྲུབ་པར་འཛིན་པའི་འཇིག་ལྟ་སྤངས་ནས་མེད་པར་འགྱུར་ཏེ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "འདི་ནི་རྒྱུ་འབྲས་མིན་པའི་བརྟེན་ནས་བཏགས་པ་ཐམས་ཅད་ལའང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཐ་དད་དང་རྟག་ཆད་གཉིས་སྤོང་བའི་སྒོར་ཤེས་པར་བྱའོ།",
    "སྒྲ་ལ་འཆེལ་ཅིང་འདུག་པར་མ་བྱེད་པར།",
    "འདོད་ཆགས་ཞེ་སྡང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "མྱུ་གུ་ཞིག་པ་དེ་རང་དུས་ན་ཁོ་རང་ཞིག་པ་མིན་ཀྱང་སྤྱིར་ཞིག་པ་ཡིན་པས་འདས་པ་ཁོ་ནའོ།",
    "འབྲས་བུ་མ་སྐྱེས་པ་སྟེ་མ་འོངས་པ་ནི་རྒྱུ་སྐྱེས་པ་ད་ལྟར་བ་དང་མ་སྐྱེས་པ་མ་འོངས་པ་དང་འདས་པ་གཉིས་དང་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་ནི་ནམ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འབྲས་བུ་སྐྱེ་བ་དེ་ཡང་རང་བཞིན་གྱིས་ཡོད་པས་མི་སྟོང་པའམ་སྟོང་པ་ཞིག་སྐྱེ་གྲང་།",
    "དེས་ན་འབྲས་བུ་ཡང་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེ་ན།",
    "རྒྱུས་འབྲས་བུ་རང་བཞིན་གྱིས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ན་རྒྱུ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་འཐད་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་ཡང་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེ་ན།",
    "གཞན་ཡང་དངོས་པོ་འགའ་ཞིག་རང་བཞིན་གྱིས་ཡོད་ན་འབྱུང་འཇིག་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པར་འགྱུར་ནའང་དེ་ནི་མེད་དེ་རང་བཞིན་གྱིས་མ་སྐྱེས་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་དུས་གསུམ་དུ་རང་བཞིན་གྱིས་ཡོད་པ་མིན་པ་དེ་ནི་ཇི་ལྟར་ན་བདག་ཉིད་གཞན་གྱིས་ཡོད་པར་ག་ལ་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པ་ཡང་རང་བཞིན་ལས་ཡོད་པ་མིན་ཡང་ཕུང་པོ་ལ་བརྟེན་ནས་གཞན་གྱི་དངོས་པོ་ལས་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལྟར་ཕུང་པོ་ལེན་པ་ཅུང་ཟད་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་ན།",
    "དེ་བཞིན་གཤེགས་པ་སྔ་རོལ་ན་མེད་པས་ཉེ་བར་ལེན་པ་ཅུང་ཟད་ཀྱང་རང་བཞིན་གྱིས་ཉེ་བར་བླངས་པ་མ་ཡིན་པས།",
    "དངོས་པོ་རང་བཞིན་གྱིས་མེད་པ་ལ་མི་རྟག་པ་ཡང་རང་བཞིན་གྱིས་མེད་པས་རང་བཞིན་གྱིས་ཡོད་པས་སྟོང་པབལ་མི་རྟག་པའོ་ཞེས་འཛིན་པའང་ཇི་ལྟར་ན་ཕྱིན་ཅི་ལོག་མ་ཡིན་པར་རང་བཞིན་གྱིས་ཡོད་དེ་མེད་དོ།",
    "གལ་ཏེ་བདག་དང་གཙང་བ་དང་རྟག་པ་དང་བདེ་བ་རང་བཞིན་གྱིས་མེད་ན་ནི་བདག་མེད་པ་དང་མི་གཙང་བ་དང་མི་རྟག་པ་དང་སྡུག་བསྔལ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འབྲིང་དུ་ཕྱེ་ན་དངོས་པོ་དང་དངོས་མེད་དང་རང་དང་གཞན་གྱི་ངོ་བོ་སྟོང་པ་ཉིད་དེ་བཞི་དང་།",
    "མ་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པའི་ཁྱད་པར་ལེགས་པར་ཕྱེ་བའི་ཕྱིར་རོ།",
    "རང་རང་དངོས་ལ་ཐེར་ཟུག་གནས་དེ་ལ།",
    "དེ་བཞིན་དུ་མྱ་ངན་གང་ལས་འདས་པའི་དངོས་པོ་དེ་མེད་དོ་ཞེས་པར་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དོ།",
    "གཞན་ཡང་བཅོམ་ལྡན་འདས་བཞུགས་པར་གྱུར་པའི་དུས་ན་ཡང་རང་བཞིན་གྱིས་ཡོད་པར་མི་མངོན་ལ་དེ་བཞིན་དུ་མེད་དོ་ཞེའམ།",
    "གལ་ཏེ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཉིད་བདག་དང་རང་བཞིན་གྱིས་གཅིག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "འདི་ཡང་རང་མཚན་གྱིས་གཞན་དུ་གྲུབ་ན་ལྟོས་པ་མི་རུང་བས་འབྲེལ་བ་འགོག་ནུས་ལ།",
    "གང་ཟག་དེའི་ཚེ་འདིའི་དུས་ཀྱི་བདག་དང་རང་བཞིན་གྱིས་ཐ་དད་པ་མི་འཐད་པས་རང་བཞིན་གྱིས་གཅིག་ཏུ་འདོད་དགོས་སོ།",
    "བདེ་བར་གཤེགས་པའི་ཞིང་མཆོག་རབ་གསལ་ཀུན་ཀྱང་གདའ།",
    "དེ་དག་ཐམས་ཅད་ནམ་མཁའ་འདི་ཡི་དཀྱིལ་ན་གདའ།",
    "ལྔོན་མ་མཐོང་མ་ཐོས་པའི་བཀོད་པ་འདི་དག་གདའོ།",
    "བདག་ནི་ན་ཞིང་མི་བདེ་སྟེ་ཁྲིའི་སྟེང་ན་འདུག་ན།",
    "སྐྱེས་བུ་དམ་པ་དེ་ལ་ཕྱག་བགྱིས་ཏེ་གུས་པར་སྨྲས་ནས་དེ་ཉིད་དུ་མི་གདའ་བར་གྱུར་ཏེ།",
    "སྐད་ཅིག་ཙམ་དུའང་མི་འདུག་གོ།",
    "ཅིའི་ཕྱིར་ནང་པར་སྔར་ལྷུང་བཟེད་ཐོགས་ནས་ཁྱིམ་གྱི་སྒོ་དྲུང་འདི་ན་འདུག།",
    "ཁྲི་གང་ལ་དྲི་མ་མེད་པར་གྲགས་པ་ན་བ་ཉལ་ཞིང་འདུག་པའི་ཁྲི་གཅིག་པོ་དེ་མ་གཏོགས་པར་དེ་ན་ཁྲིའམ།",
    "དྲི་མ་མེད་པར་གྲགས་པ་ཉལ་ཞིང་འདུག་པའི་ཁྲི་གཅིག་པུ་དེ་ལས་གཞན་ཁྲི་འམ།",
    "སེང་གེའི་ཁྲི་ལ་འདུག་ཅིག།",
    "སེང་གེའི་ཁྲི་འདི་དག་མཐོ་ཞིང་ཆེ་བས་འདུག་མི་ནུས་སོ།",
    "འདུག་ནུས་པར་འགྱུར་རོ།",
