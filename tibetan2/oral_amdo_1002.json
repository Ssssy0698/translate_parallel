    "དེ་དག་ལྷའི་མེ་ཏོག་དེ་དག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་གཏོར་ནས་ཚིག་འདི་སྐད་འཛེར་༤ཏོ།",
    "བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་དག་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་བསྟན་པ་འདི་ལ་མོས་པ་དེ་དག་ནི་བདུད་དང་ཕྱིར་རྒོལ་བ་བཅོམ་པ་ལགས་སོ།",
    "ཚངས་པ་འདི་ལ་བདག་ཅག་གིས་རང་གི་ཤ་དང་ཁྲག་གིས་ཀྱང་ལན་༥མི་ལོན་ནོ།",
    "རིགས་ཀྱི་བུ་དེ་ལྷ་དེ་དག་གིས་ཡོངས་སུ་གཟུང་བར་འགྱུར་རོ།",
    "གྲོགས་པོ་དག་མོས་པར་བྱ།",
    "བཟུང་ཚོན་འཇིག་རྟེན་གྱི་ཟང་ཟིང་གང་གིས་དེ་ལ་ལན་བླན་༧པར་སླ་བ་དེ་ལྟ་བུ་ངས་མ་མཐོང་ངོ།",
    "འཇིག་རྟེན་གྱི་ཟང་ཟིང་གིས་དེ་སྦྱང་བར་སླ་བ་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་གྱི་ཟང་ཟིང་གིས་སྦྱང་བར་སླ་བ་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་གྱི་༩ཟང་ཟིང་གིས་སྦྱང་བར་སླ་བ་མ་ཡིན་ནོ།",
    "དེ་དང་དེ་དག་ནི་སྦྱིན་པ་ཕུན་སུམ་ཚོགས་ཤིང་ཉོན་མོངས་པ་ཐམས་ཅད་ཡོངས་སུ་གཏོང་བའོ།",
    "དེ་དག་གིས་ནི་ཕྱིན་ཅི་ལོག་སྤངས་སོཅ།",
    "དེ་དག་གིས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཁོང་དུ་ཆུད་དོ།",
    "ལྷའི་བུ་ཁྱོད་ནན་ཏན་འདི་ལ་ཞུགས་སམ།",
    "ངེས་དཔ་དེ་ནི་མིག་གི་རྣམ་པར་ཤེས་པས་ཤེས་པ་མ་ཡིན།",
    "མིག་གི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དང་།",
    "ཇི་ལྟར་མ་མོས་པ་རྣམས་ཀྱང་མོས་པར་བགྱིད་ལ་མོས་པ་རྣམས་ཀྱང་རྣམ་པར་འགྲོལ་བ་དེ་དེ་ལྟར་སྤོབས་སོ།",
    "ཉོན་མོངས་པ་སྐྱེས་པ་རྣམས་སྤོང་བ་དང་།",
    "ལྷའི་བུ་ཁྱོད་སེང་གེའི་སྒྲ་ཇི་ལྟ་བུ་ཡིན་པ་སྤོབས་པར་གྱིས་ཤིག།",
    "གང་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ཉོན་མོངས་པ་སྤོང་བ་༡༢ནི་སེང་དགེའི་སྒྲའོ།",
    "ཉན་ཐོས་རང་རྒྱལ་དགྲ་བཅོམ་དྲི་མེད་དེ་དག་གིས་ཡང་།",
    "ཅི་སླད་ཁྱོད་ཀྱིས་འཛུམ་མཛད་དེ་ཡི་༢རྒྱུ་ནི་རབ་ཏུ་བསྟན་པར་གསོལ།",
    "འཇིག་རྟེན་ལྷ་མི་ལྟོ་འཕྱེའི་ཚོགས་རྣམས་བྱམས་པས་བདག་པོ་ཁྱོད་ཞལ་ལྟ།",
    "གང་གི་སླད་དུ་འཛུམ་པ་འདི་བསྟན་ཐུབ་པ་བདག་ཅག་རྣམས་ལ་གསུངས།",
    "འཛིན་དང་རྟོག་དང་རྣམ་རྟོག་ཀུན་དང་བྲལ་བས་སྟོང་པ་ཉིད་ལ་མོས།",
    "ཁྱོད་ནི་སྲིད་པ་གསུམ་འདིར་གང་ལའང་མི་སྨོན་བསམ་གཏན་ཏིང་འཛིན་དགྱེས།",
    "གང་གི་སླད་དུ་འཛུམ་པ་བསྟན་མཛད་འདྲེན་པ་འདི་ནི་ལུང་བསྟན་གསོལ།",
    "ཁྱོད་ནི་དཔའ་བོ་བདུད་ཀྱི་སྟོབས་འཇོམས་༦མཐུ་བོ་ཆེ་ཡི་སྙེ་མཐུ་དང་ལྡན།",
    "ཁྱོད་ནི་སྐྱོབ་པ་དཔུང་གཉེན་འཇིག་རྟེན་མགོན་སྐྱབས་༡སྒྲོན་མ་སྣང་མཛད་པ།",
    "ཚངས་པ་ཁྱོད་ཀྱིས་ཕྱིར་མི་ལྡོག་པའི་ལྷའི་བུ་འདི་མཐོང་ངམ།",
    "ལྷའི་བུ་ཁྱོད་དེ་བཞིན་གཤེགས་པས་ལུང་བསྟན་ཏོ།",
    "ལྷའི་བུ་དེ་འང་དས་ཁྱོད་དེ་ལྟར་དེ་བཞིན་གཤེགས་པས་ལུང་བསྟན་པས་ན་ཁྱོད་སྔོན་གྱི་ཡང་དག་པར་རྫོགས་པའི་སངས་རྐྱལ་རྣམས་ཀྱི་དྲུང་དུ་ཚངས་པར་སྤྱད་ཅཔ་ལ་གནས་པ་ནི་དོན་མེད་པ་མ་ཡིན་ནོ།",
    "ལྷའི་༡༧བུ་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པ་ཞེས་བྱ་བ་དེ་གང་གི་ཚིག་བླ་དགས་ཡིན།",
    "ངག་གི་རྩོམ་པ་མེད།",
    "དེ་དེ་ལྟར་མོས་པས་ལྷག་པར་མི་བྱེད།",
    "སྦྱིན་པ་ཡང་སྦྱིན་པར་བྱེད་ལ་དེའང་རྣམ་པར་སྨིན་པ་ལ་མི་རེ་བས་སོ།",
    "འོད་སྲུང་ཇི་སྐད་ཟེར་བ་དེ་བཞིན་ཡིན་མོད་ཀྱི་ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་དེ་དག་ལ་ནི་གང་གི་ཕྱིར་འཛམ་བུ་ནགླིང་འདིར་ཆར་པ་མི་འབེབས་པར་འགྱུར་བའི་སེར་སྣ་མེད་དོ།",
    "འཛམ་བུ་དགླིང་གི་༤ཕྱོགས་ཀྱིས་ཆར་པའི་རྒྱུན་ཤིང་རྟའི་སྲོག་ཤིང་ཙམ་དེ་དག་མི་བཟོད་དོ།",
    "འོད་སྲུང་གལ་ཏེ་ཀླུ་ཆེན་པོ་དེ་དག་གིས་འཛམ་བུ་པགླིང་འདིར་ཆར་ཕབ་པར་གྱུར་ན་དེས་འཛམ་བུ་ཚོགླིང་འདི་གྲོང་དང་།",
    "རྫ་མའི་ཆུས་རྒྱ་ཤུག་གི་ལོ་མ་བཏེག་པ་བཞིན་དུ་བཏེག་ནས་ཁྱེར་བར་འགྱུར་ཏེ།",
    "འོད་སྲུང་འདི་ལྟ་སྟེ་དཔེར་ན་ཆར་པའི་རྒྱུན་ཤིང་རྟའི་སྲོག་ཤིང་ཙམ་བབ་པ་དེ་དག་གིས་ཀྱང་རྒྱ་མཚོ་ཆེན་པོ་བྲི་བ་ཡང་མེད།",
    "སྟོང་པ་ཉིད་ཀྱི་རོར་རོ་གཅིག་ཏུ་མོས་པར་འགྱུར་རོ།",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱིས་སྐྱེས་བུ་དམ་པ་དེ་དག་གི་གཏིང་ངམ་ཚད་གཟུང་བ་ཚོནི་མི་ནུས་ཏེ།",
    "འོད་སྲུང་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་སྙེ་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱི་རྒྱ་༡",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱིས་སྐྱེས་བུ་དམ་པ་བློ་གྲོས་ལམཆོག་རྒྱ་མཚོ་ལྟ་བུ་༥དང་ལྡན་པ་དེ་དག་གི་གཏིང་ངམ་ཚད་གཟུང་བ་༦ནི་མི་ནུས་སོ།",
    "དེ་དག་རྣམ་༩དག་ཉོན་མོངས་མི་སྡུད་དོ།",
    "སྐྱེ་བོ་གཅིག་གི་དོན་ཕྱིར་མི་གནས་ཏེ།",
    "དགྲ་བཅོམ་རང་རྒྱལ་དག་གིས་ཀྱི་ཤེས་མི་ནུས།",
    "ནམ་མཁའ་བས་ཀྱང་ལྷག་པ་དེ་དག་གི།",
    "རྟག་ཏུ་རྒྱལ་བ་དག་གི་ནོར་རྣམས་ཚོལ།",
    "དེ་དང་དེ་དག་སྦྱིན་པས་ཁྱད་པར་སོང་།",
    "སྐྱེ་བོ་དག་གི་སྤྱོད་པ་དེ་དག་ཤེས།",
    "ཇི་ལྟར་མོས་པ་མཁས་ཤིང་རྟོགས་པ་སྟེ།",
