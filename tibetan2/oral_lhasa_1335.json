    "ངའི་སེམས་འདི་འབྲི་གུང་ཐང་བས་ཀྱང་ཆེ་བ་ཅིག་ཡིན་གྱིས་གསུངས།",
    "མ་ཆགས་པ་ཁོ་ན་ཤེས་རབ་ཡིན་གསུངས།",
    "ཆགས་པ་སྤངས་ནས་གནོད་པ་བྱས་ཀྱང་ལན་དུ་ཕན་འདོགས་པ་ཡིན་ཏེ།",
    "ཡང་འདི་སྐད་དུ་གསུངས་ཏེ།",
    "ཞེས་གསུངས་པས་ཁོ་དགྲ་བཅོམ་པ་ཐོབ་སྟེ།",
    "ཁ་ཏོན་བྱེད་པ་རྣམས་དང་ལྟ་བྱ་རྒོད་ཀྱི་རི་ལ་ངའི་འཁོར་ན་ཡོད་པར་རིག་པར་བྱའོ།",
    "ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྷོ་ཕྱོགས་ཀྱི་རྒྱུད་དང་ཡུལ་བར་ཏ་དང་བྱང་ཕྱོགས་སུ་དར་ཞིང་རྒྱས་པར་འགྱུར་ཞེས་པས་དེ་འདི་ཡིན་པས།",
    "ཞེས་པའི་དོན་ཡང་དེ་ཡིན་གསུངས།",
    "ཡང་ནེ་ཙོ་སྣའི་བྱ་བ་སྡིག་ཅན་ཞིག་འཆི་འཕྲོ་ལ་ངས་གདམས་ངག་བསྟན་པས་འཆི་ཁར་ངའི་གདམས་པ་ཡོད་ཞེས་ལྟས་བཟང་པོ་བྱུང་སྐད་པས་ཀྱང་གཤིན་བསྔོ་བྱས་གསུང་།",
    "༥༩༣ ། ཞིང་བཟང་པོ་རྙེད་པར་དཀའ་བས་དེ་བསྙེན་བཀུར་བར་གདམས་པ།",
    "བརྒྱ་བྱིན་གྱིས་རྟོག་པ་ཤེས་ནས་མེ་སྤྲུལ་པ་དང་རི་བོང་མཆོངས་ནས་ཤ་ཁོང་ལ་དྲངས་ནས་ཞག་གཅིག་དགེ་སྦྱོར་བྱེད་དུ་འཇུག་པ་བརྒྱ་བྱིན་ངོ་མཚར་བས་རྣམ་པར་རྒྱལ་བའི་ཁང་པར་བྲིས་པ་དང་།",
    "ཞེས་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་གསུངས།",
    "རྩ་བའི་མ་གཅིག་པུ་ལ་བསྒོམས་ནས་གསུམ་ནས་བརྒྱའི་བར་ནམ་མཁའ་དང་མཉམ་པར་སྤྲོ་བ་ནི་ཟབ་མྱོང་བ་མེད་པ་ཡིན།",
    "འདི་ཡང་ཟད་པར་གྱི་ཏིང་ངེ་འཛིན་དང་འདྲ་སྟེ་མི་ཚེ་ལ་བྱམས་པ་གཅིག་པུའི་ཁྲིད་མི་ཚར་གསུང་།",
    "དེ་ལ་རྣམ་པར་ཤེས་པ་བསྒྲུབ་པའམ་འཇིག་པའམ་བག་ཆགས་འཇོག་པ་དང་སྤོང་བ་གཉིས་ཡིན་པས།",
    "གནས་གཙང་མ་སྔར་སྐྱེ་བ་ལ་བག་ཆགས་ཙམ་པོས་མི་འོངས་ཏིང་ངེ་འཛིན་རྟོགས་པ་དགོས་གསུང་།",
    "བྱུང་ཙམ་ན་སྐྱེ་འགག་གནས་གསུམ་གྱིས་སྟོང་པར་རང་སར་གྲོལ་དགོས་པ་ཡིན།",
    "ཇི་སྙེད་མཁྱེན་པ་དེའི་གཤིས་ལ་འཕོ་འགྱུར་མེད་པ་ཇི་ལྟ་བ་ཡིན་སྙམ།",
    "དེ་གཉིས་རུས་སུ་ཐོན་པས་སྐུ་གཉིས་འབྱུང་སྟེ་དམ་པ་ནི་ཐོབ་པར་ཤོག་ཀྱང་དེ་ཡིན།",
    "བྱམས་པ་མ་ལ་ཕལ་ཆེར་སྐྱེ་བ་ཡང་ཡིད་དུ་འོང་བའི་ནང་ནས་མ་མཆོག་ཡིན་པས་དེ་ལ་མཚོན་སྙམ་པ་ལགས།",
    "དེ་བཞིན་དུ་ཞེ་སྡང་དང་གཏི་མུག་དང་བཅས་སོ་ཞེས་སྣོད་བཅུད་མ་ལུས་པ་ཐམས་ཅད་སྐྱེ་བར་བྱེད་པའི་རྒྱུ་གནས་པར་བྱེད་པའི་གཞི།",
    "འཇིག་པར་བྱེད་པའི་རྐྱེན་ལ་མི་མཁྱེན་པ་སྐྲ་རྩེ་ཙམ་ཡང་མེད་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་མཁྱེན་པ་གཉིས་ཐུགས་སུ་ཆུད་པ་ཡིན་ཏེ།",
    "རྟོག་པ་སྤངས་ཀྱང་སྣང་སྟོང་ཟུང་དུ་མ་ཆུད་པས་སྟོང་པ་ཕྱོགས་གཅིག་གམ་ཉི་ཚེ་བ་ཡིན་ཏེ་ཇི་ལྟ་བར་མཁྱེན།",
    "མཉམ་པར་མ་བཞག་པར་གཞན་གྱི་ཁམས་དང་བག་ལ་ཉལ་ལ་སོགས་མི་ཤེས་ཇི་སྙེད་པར་མཁྱེན་ཏེ།",
    "རྟོག་པ་གང་ལ་ཟེར་ན་སེམས་ཀྱི་གནས་ལུགས་དེ་ལྟར་ཡིན་པར་ཡེ་ནས་རྟོགས་ཤིང་ངེས་ཤེས་སྐྱེས་པ་དེ་ལ་ཟེར་བ་ཡིན་ཏེ།",
    "ལུས་ཀྱི་ཕྱི་ནང་བསྒྱུར་བའམ་མི་གཙང་བའི་རྫས་སུམ་ཅུ་རྣམ་པར་བམ་པ་རྣམ་པར་སྔོ་བ་ལ་སོགས་སུ་བསྒོམ་སྟེ།",
    "རྣམ་པར་བམ་སྔོ་ཡང་དུར་ཁྲོད་ན་བྲིས་ཡོད་པ་དེ་ཡིན་གསུང་།",
    "ཐུལ་རུག་ཁུ་བ་སྟོན་པ་འགྲངས་པར་བཟའ།",
    "གནས་པར་བྱེད་པའི་གཞི།",
    "བསྒོམས་མ་བསྒོམ་མེད་པར་མི་བདེ་བ་གསུམ་གོ་རིམ་ལྟར།",
    "སྐྱོན་ཡང་གནས་སྦྱོང་ལོ་ལྔ་བྱས་པ་ཡིན་ཏེ་ཕན་པ་མ་བྱུང་གསུང་།",
    "ངའི་ཟས་ནོར་གོང་བའི་ཁབ་ཚུན་ཆད་རྩི་ལུང་དུ་འདི་རྣམས་ལ་ཟད་པར་བྱས་གསུང་།",
    "དམིགས་པ་ལ་ཟད་པ་མེད་དེ་ཟད་པར་གྱི་ཏིང་ངེ་འཛིན་གཅིག་པུ་ལ་ཁ་དོག་དབྱིབས་སོགས་རྡུལ་ཕྲ་རབ་ནས་རི་རབ་ཀྱི་བར་དུ་ཁྲིད་ན་བསམ་གྱིས་མི་ཁྱབ་སྟེ།",
    "ཡོན་ཏན་ཀུན་གྱི་གཞི་རྟེན་ཡིན་པར་ཐུབ་པས་གསུངས།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཡོད་མེད་སྤྲོས་པ་ཐམས་ཅད་ཀྱི་མཐའ་དང་བྲལ་བས་བློ་ཡུལ་དུ་བྱས་ནས་བསྒོམ།",
    "དབྱིབས་རྟ་རྔ་བརྒྱ་སྟོང་དུ་བཤགས་པའི་ཆ་ཙམ་ཟེར་ཏེ་མེད་པ་ལ་ཟེར།",
    "འཁོར་ལོ་དེ་ལ་ཚེས་བརྒྱད་ཀྱི་ཉིན་པར་གསོལ་བ་བཏབ་པས་ནམ་མཁའ་ལ་གསེར་གྱི་འཁོར་ལོ་རྩིབས་སྟོང་དང་ལྡན་པ་བྱུང་སྟེ།",
    "དབེན་པ་དང་ཁྲུས་གཙང་སྦྲ་ལ་དགའ་བ་བྲམ་ཟེ།",
    "རྣམ་པར་སྨིན་པ་རྒྱུ་དེ་འབྲས་བུ་རང་སད་པའི་དུས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ཟེར་བ་ཡིན་ཏེ་བསྒྲུབ་པར་བྱེད་པ་མང་པོ་ཞིག་དགོས་ཏེ།",
    "༦༡ ། སྔགས་དང་མཚན་ཉིད་ཀྱིས་ལམ་བགྲོད་པར་མྱུར་བུལ་བསྟན་པ།",
    "བརྒྱུད་པར་བགྲངས་པ་མཐོལ་ལོ་བཤགས།",
    "པ་ལ་གནང་བ་ཡིན་ཏེ།",
    "འགྲོ་བ་ཀླུའི་རྣམ་པར་སྤྲུལ་པ་བསམ་གྱིས་མི་ཁྱབ་པ།",
    "དེ་མེད་པར་བཟླས་པས་རྒྱ་མཚོའི་ནང་དུ་རྡོ་ཚན་ཅིག་བཅུག་པ་དང་འདྲ་གསུང་།",
    "ཤེས་རབ་ཆེན་པོས་གཞན་གྱི་ལམ་སྣ་འདྲེན་པར་ནུས་པ།",
    "སྤྲང་པོར་ཞལ་གྱིས་བཞེས་ཏེ་བསོད་སྙོམས་པ་དབྱར་ཟླ་བ་གསུམ་རྟ་ཆག་གསོལ་བ།",
    "དུས་ལན་ཞིག་ང་ལ་རིགས་བྱེད་གཞན་ལ་མ་བསྟན་པ་ཟབ་པ་ཞིག་ཡོད་དེ་བསྒྲུབ་པར་ནུས་སམ་ནུས།",
    "རང་ལ་དགེ་སྦྱོར་ཡོད་པ་དེ་ཞེ་འདོད་ཀྱིས་རི་དང་བྲག་ལ་རྩོལ་བ་བསྐྱངས་པས་ཉམས་མཐོ་དམན་སྐྱེས་པས་དགའ་བ་ལ་སྒོམ་དུ་བྱས།",
    "དེ་རང་ལ་སྦྱོར་རྗེས་ཀྱིས་ཟིན་པར་བྱ་ཞིང་ཐུག་ཕྲད་དུ་བཞག་པས་བོགས་ཐོན་གེགས་སེལ་ཐམས་ཅད་འོང་བ་ཡིན་གསུང་།",
    "དེ་ལྟར་བྱས་པས་འཁོར་འདས་ཐམས་ཅད་སེམས་སྐྱེ་མེད་དུ་ཆོད་ནས་ཡེ་ཤེས་ཀྱི་བོགས་ཀྱང་ཐོན་པ་ཡིན་གསུང་།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ལས་ཐམས་ཅད་ལ་གྱ་ནོམ་སྣང་དང་འོག་མིན་གྱི་བར་གྱི་གཙང་མ་རིགས་ཀྱི་ལྷ་ལྔ།",
    "བྱིས་པར་ཐུམ་པོར་འཚོ་བ་ཚུན་ཆོད་ཀྱང་དམག་ཏུ་འགྲོ་བ་ཡིན་ཏེ།",
    "དང་པོ་ཐོས་པ་མ་བྱས་དེ་ནས་བསམ་པ་མ་བྱས་པས་མི་རྟག་པ་བསམ་པ་ཀུན་ངན་པ་ངས་སྐྱེ་མེད་བསམས་པ་ཡིན་བྱས་ན།",
    "བཅུད་ཡི་དམ་གྱི་ལྷར་བྱས་ཏེ་བསམ་པའི་དཀྱིལ་འཁོར་གཅིག་ཏུ་བཅུག་ནས།",
    "བཟླས་པ་བྱས་པས་དེ་ཐམས་ཅད་སྨིན་པ་དང་གྲོལ་བར་ནུས་ཏེ་འདི་ཏིག་ཏིག་ཡིན།",
    "འདི་ལྟར་བྱས་ན་འདི་ལྟར་འོང་ལ་སོགས་པའི་བྱུང་ཟིན་ཡལ་ཟིན་པས་མི་དེ་ཐམས་ཅད་ཆུས་ཁྱེར་ནས་ཡོད་པ་ཡིན་པས།",
    "བཞག་པར་བྱ་བ་ཅུང་ཟད་མེད།",
    "རྟོགས་མ་རྟོགས་ཀྱི་ཁྱད་པར་ལས།",
    "ཕྱི་རོལ་གྱི་ཡུལ་འདི་ཁོ་ན་གཏན་ལ་འབེབས་ཏེ་འདི་ལྟར་ཕེབ་ཕེབས་མི་འདྲ།",
    "དེ་ཡང་ང་ལ་བདེ་བ་དང་ལྡན་པར་བསྒོམས་པ་ཞིག་ལས་མི་འོང་སྟེ་མ་ལུས་པ་ལ་བསྒོམས་པས་ཐམས་ཅད་ཀྱིས་མཐོང་བ་དང་ཐོས་པ་དང་།",
    "འདི་ནས་ཁམས་སུ་སྦྱོར་བ་བྱས་པས་འཆི་བ་ཡང་བསམ་པ་ཡིན།",
    "ཁྲོམ་དུ་ཕྱིན་པའི་དུས་སུ་ཡང་ཞལ་གྱི་དཀྱིལ་འཁོར་མཐོང་སར་བསྡད་ནས།",
    "གཟུང་དང་འཛིན་པ་རྣམ་པར་སྤངས།",
    "མ་རིག་པའི་རྐྱེན་གྱིས་རྒ་ཤིའི་བར་དེ་ཉིད་དང་ཡེ་ཤེས་སུ་ཤར་བ་ལས་བྱས་པའོ།",
    "བདེ་གསལ་མི་རྟོག་པ་ཉམས་མྱོང་བྱས་ཏེ་གཅིག་ཏུ་འདྲེས་ནས།",
    "སྔོན་ང་ལ་ཡང་མ་ཕན་ད་ཁྱེད་ལ་ཡང་མི་ཕན་བྱས་པས།",
    "དེ་ཚེ་ལས་ཀྱང་ལྡོག་པར་འགྱུར།",
    "དེ་མ་ཡིན་པའི་ཇོ་བོ་སྐྱོ་ལ་མེ་དང་ཁྲག་བྱས་ན་ཕན་ནམ་ཞེས་འདྲེས་ཁྱེར་ཀུན་ཟེར་རོ།",
    "དེ་ནས་ཞག་འགའ་ན་འདས་པའི་བཅུ་བདུན་གྱི་ཉིན་པར་འདི་གསུངས་ཏེ།",
    "དོ་ཧ་ལ་སོགས་པ་སྤྲོས་མེད་ལྷན་ཅིག་སྐྱེས་པར་ཟེར།",
    "འདི་ནི་བླ་ན་མེད་པ་ཞེས་གསུམ་དུ་རིམ་པས་སེམས་བསྐྱེད་པར།",
    "དགྲ་ལྷ་གྱིས་བྱས་པས་དགྲ་སྲི་བྱེད་ཟེར།",
    "སྲོག་ལྷ་གྱིས་བྱས་པས་ཕུང་སྲི་བྱེད་ཟེར་ཏེ།",
    "སྟོན་དཔྱིད་སྙོམས་པར་བཞུགས་པ་བཞིན་དུ།",
    "དོན་དམ་པ་སེམས་རིག་པའི་རྒྱལ་པོ་དེ་བཞུགས་ས་བཞིན་དུ་བཞུགས་པ་ཡིན་ཏེ།",
    "ལྕགས་སྲེགས་ས་གཞི་སུ་ཡིས་བྱས།",
    "ང་བོང་གུ་ཆེ་གོན་པ་ཡིན་བྱས་ཏེ།",
    "དེས་ན་རང་བས་གཞན་གཅེས་བྱས་པས་རང་གཅེས་པར་འོང་བ་ཡིན་ཏེ།",
    "ངས་གཞན་གཅེས་པ་ལྟར་བྱས་ནས་ཟ་མ་བྲ་བར་གཞན་ལ་བྱིན་པས།",
    "ཞེ་སྡང་མཉངྒཱའི་དྲུང་དུ་ཕྱིན་ཀྱང་སྐོམ་ཧུབ་ཞིག་ཀྱང་མེད་པར་འགྲོ་བ་ཡིན།",
    "དེ་ལྟར་ཚངས་པའི་འཇིག་རྟེན་དང་བདེ་བ་ཅན་གྱི་འཇིག་རྟེན་ལ་སོགས་པར་སྐྱེ་སྟེ།",
    "གཡོག་དང་ཁྲི་བརྩབཞིན་རྒྱུན་ཆད་པ་མེད་པར་དབུལ་ཏེ།",
    "ངའི་སློབ་དཔོན་ཡེ་ཤེས་མེད་པར་འདོད་ཞེས་མེད་པས་སུ་ལ་ཕན་སུ་ལ་གནོད།",
    "འཕགས་པ་ལམ་ཆུང་བ་ལྟ་བུ་བློ་གྲོས་དམན་པས་ཀྱང་རྡུལ་སྤངས་དྲི་མ་སྤངས་ལ་ཐོས་པའི་དོད་པོ་བྱས་ཏེ་འབྲས་བུ་དགྲ་བཅོམ་པ་ཐོབ་པ་ཡིན་གསུང་།",
    "དེས་ན་དེ་གསང་སྔགས་པ་ལ་འདི་ལྟར་བྱས་ན་འདི་ཙུག་འོང་བྱ་བ་ཞིག་རང་ཡོད་པ་ཡིན་པས་ང་བརྫུན་ཆེ་ཡང་ངའི་ཁ་ལ་ཉོན་ཅིག་སྒོམ་ཆེན་པ་ཀུན་འཚོལ་གསོག་བྱ་མི་དགོས་པར།",
    "དཀྱིལ་ཀྲུང་དང་མཉམ་གཞག་བྱས་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ལ་མཉམ་པར་བཞག་སྟེ།",
    "ལུས་དྲང་བ་འཁྲུལ་འཁོར་དུ་བསྡད་པ་གལ་ཆེ་སྟེ།",
    "པར་ལྟ་བའི་བྱེ་བྲག་ལྷན་སྐྱེས་ཀྱི་མ་རིག་པ་ཡིན་ཏེ།",
    "གཉེན་པོས་ངོ་ཤེས་པར་བྱས།",
    "རང་འཁྲིས་མེད་པའི་བསམ་པ་རྣམ་པར་དག་པའི་དུས་སུ་བསྔོས་ན་འགྲུབ་པ་ཡིན་གསུང་།",
    "སྔོན་ཁ་བ་བབས་པས་ངེད་ཉིད་བླ་བོ་བྱས་པས་འཁྱགས།",
    "སྐྱེས་བུ་ཀུན་ནང་པར་ལངས་པའི་དུས་སུ་མི་རྟག་པ།",
    "བྱས་པ་ལ་མི་རྟག་པས་ཁྱབ་པ་དེ་འཇིག་པ་ཡིན་ཏེ།",
    "སྟོང་པར་རྟོག་ན་རྒྱང་འཕེན་པ།",
    "སྨྲས་མི་བཏུབ་ཞེས་གསུངས་པས།",
    "གསེར་སྣོད་དངུལ་སྣོད་མ་ལགས་པ།",
    "གསུངས་པས།",
    "ལྕགས་སྲེགས་ས་གཞི་སུ་ཡིས་བྱས།",
    "ལམ་འབྲས་ཀྱི་གེགས་སེལ་བ་དང་བོགས་འདོན་པ་ཉམས་སུ་བླངས་པས་ཟབ་པར་བྱུང་བ་འདི་ཁོ་ན་ཡིན་ཏེ།",
    "དེ་ནས་རང་ལ་བསྟིམ་པའམ་མི་དམིགས་པར་བྱ།",
    "ཡང་རྣལ་འབྱོར་པ་ཞིག་ལུང་སྟོང་དུ་ཞེ་སྡང་སྐྱེས་པ་ལ་རྐྱེན་ཡང་མེད་ཞེ་སྡང་ཡང་མེད་བསམ་པ་ཡང་མེད་པར་གོ་ཙམ་ན།",
    "༦༣༡ ། རྡོ་རྗེ་འཆང་ནས་ཚིག་དོན་གྱི་བརྒྱུད་པ་སེལ་མ་ཞུགས་པ་འོ་སྐོལ་འདི་ལས་མེད་གསུངས་པ།",
    "གསང་བས་ངག་ཤེས་རབ་ཡེ་ཤེས་ཀྱིས་ཡིད་དག་པར་བྱེད།",
    "བཞི་པས་ཐམས་ཅད་དག་པར་བྱེད།",
    "དུས་རྒྱུན་ཆད་མེད་པར་རྟག་ན་ཡིན།",
    "ོད་ལམ་བཞི་ལ་ཁྱད་པར་མེད།",
    "དེ་ནས་དེར་ཅོག་སེར་བསྡད་པས་རྣམ་པར་མི་རྟོག་པ་གཤའ་མ་ཞིག་འོང་སྟེ།",
    "བྱང་སེམས་ཀྱི་སྦྱོར་བ་ཡང་མ་བྱས།",
    "ང་ཐབས་ལམ་འདི་རྣམས་ཕྱོགས་གཅིག་ཏུ་དྲིལ་བ་བས་སྒྱུ་ལུས་དང་རྨི་ལམ་འདི་གཉིས་ལ་ཟབ་པར་མཛད་གསུང་།",
    "ཡང་དྲག་ལས་བྱེད་ན་འཇིགས་བྱེད་ཧེ་རུ་ཀར་མཛད་ནས་ཕུར་པའི་ཕོ་ཉ་གདབ་ལས་ཚེའི་ལས་སྦྱོར་བྱས་ཏེ།",
    "ཟབ་པ་ནི་བློས་རྟོགས་པར་མི་ནུས་པ་ན།",
    "གཟུགས་ཀྱི་ཕུང་པོ་ལ་རྣམ་པར་སྣང་མཛད་དོ།",
    "དེ་ལྟར་ལསཡིན་ཏེ་རྣམ་པར་མི་རྟོག་པ་ཡིན་གསུང་།",
    "མཁའ་བཞིན་བྱེད་པ་མེད་པར་མངོན།",
    "ངས་ཐོས་པ་མ་བྱས་པས་ལན་མེད་པས་མ་ཤེས་གསུང་།",
    "དེ་ལ་ལྟ་བ་བྱ་བ་དམིགས་པ་ཞིག་ཡིན་ཏེ་ལྟ་སའི་ཡུལ་ཅིག་དང་ལྟ་མཁན་གྱི་ཤེས་པ་གཅིག་གཉིས་ཀྱི་འདུ་བྱས་པ་དེའི་སྟོང་པ་དང་།",
    "གནས་གཙང་རིགས་ལྔ་མ་གཏོགས་པ་ཕལ་ཆེར་བཅུ་གཉིས་ཁོ་ནར་སྐྱེ་བའི་རྒྱུ་ཡིན་ཏེ།",
    "སེམས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ།",
    "དེ་ལྟར་བྱས་པས་ནི་བསགས་པ་ཡིན་ལ་ཡོད་པ་ནི།",
    "དེ་ལྟར་རང་ལ་ཡོན་ཏན་ཐམས་ཅད་ཡོད་པར་ཤེས་པས་གཞན་མཐའ་དག་ཀྱང་དེ་ལྟར་ཡིན་ཏེ།",
    "གྲོས་འདྲི་བ་ལགས།",
    "འདོད་ཆགས་འདོད་ཆགས་དང་བྲལ་བས་སེམས་རྣམ་པར་གྲོལ་ཞེས་པས།",
    "ལས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་ཡིན་ནོ།",
    "དུག་འོང་ངོ་བྱས་པས་ཨ་ཅང་འོང་ངམ་ཟེར་ཏེ།",
    "འདི་ལ་རྩོལ་བ་བྱས་ན་ཉེས་པ་དཔག་ཏུ་མེད་དེ་ཨ་རྣ་བ་བྱེ་བ་རིའི་གཏམ་རྒྱུད་ཀྱང་གསུང་།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་གང་ལྟར་བྱས་པའི་བཟང་བ་ཞིག་ཡིན་ནས་ངོམས་ཀྱང་།",
    "རྐྱེན་འདི་ལྟ་བུས་འཇིག་པ་ཤེས་ནས་བྱས་པ་དེ་ཐམས་ཅད་གཟུང་འཛིན་སྤྲོས་པ་བྱ་བ་ཡིན་ཏེ།",
    "གར་ཡང་གནས་པར་འགྱུར་བ་མེད་དེ།",
    "བསྡམ་བྱ་ལུས་ངག་ཏུ་ཐོན་ན་བཤགས་པ་ད།",
    "ཡང་འདི་ལྟ་བུ་སྤང་བླང་གཉིས་དགག་སྒྲུབ་མེད་པ་འདིའི་ཐོག་ཏུ་དུས་རྒྱུན་ཆད་མེད་པར་བསྡད་དེ།",
    "དེ་ལྟར་སྤང་བླང་མེད་པ་དེ་ཞག་བདུན་ཙམ་དུ་བསྡད་ན་ཁྲིད་དེས་ཚར་གསུང་།",
    "དེ་ནས་ལྟེ་འོག་ཏུ་མ་ཡེངས་པར་སེམས་གཏོད་དུ་བཅུག་ལ་དེ་ནས་མི་དེ་གན་གྱལ་དུ་ཉལ་བའི་སྟེང་དུ་བཞོན་ལ།",
    "མཁྱེན་པ་གཉིས་པོ་མཐའ་དག་ཆུ་གང་བྱོར་འབྱུང་སྟེ།",
    "ཡང་དུས་ཅིག་ན་ཧེ་རུ་ཀ་སྐེ་རགས་རུམ་པོ་ཞིག་བྲིས་ནས་འདི་ཟོས་པ་མཐོང་བ་ཡིན་ཟེར་བ་ལ་ངས་ལྟས་ངན་མཐོང་ཞེས་དེའི་སྟེང་དུ་ལྷ་གཞན་བཀབ་ནས་བཅོས་མང་པོ་བྱས་ཏེ་མི་རུང་བ་ཞིག་བྱུང་ཡང་བྱུང་འོང་ཀྱང་འོང་སྟེ།",
    "སྔོན་ཇོ་བོས་གསང་སྔགས་སེམས་བསྐྱེད་ཀྱི་རྗེས་སུ་ལུང་བླངས་པས་ཆོག་བྱ་བ་གསུངས་པས།",
    "དེ་ཇི་ལྟར་བྱས་ན་སྤོགས་ཆེ་ལྟ་དགོས་གསུང་།",
    "ཕོ་ལྷ་ཞང་ལྷ་སྲོག་ལྷ་ཐམས་ཅད་འདིས་བྱེད་པ་ཡིན་ཏེ།",
    "རྣལ་འབྱོར་པ་ལ་ཕན་བདེ་ཐམས་ཅད་ཀྱང་གཤིན་བསྔོ་འདི་བྱས་པ་ལ་འབྱུང་གསུང་།",
    "དགོངས་པ་མྱ་ངན་ལས་འདས་དུས་སུ་ཡང་སྐུའི་བཞུགས་ལུགས།",
    "བསྒྲུབ་པ་ཚུལ་བཞིན་མཛད་པར་ཞུ་ཞེས་པའི་དོན་གསུང་པ།",
    "དངོས་པོ་བསྙེན་བཀུར་མང་པོ་བྱས་པའོ།",
    "སྐྱོན་ཆེན་པོ་ཞིག་བྱུང་ནས་ཅིས་ཀྱང་མ་སོལ་བ་ལ་བསྟོད་དིང་རི་དམ་པ་རྒྱ་གར་བཞུགས་པ་ལ་བུ་རམ་གྱི་ལྟང་ཆེན་པོ་གཅིག་ཕུལ་ནས།",
    "བདག་སྐྱོན་འདི་ལྟ་བུ་ཞིག་བྱུང་བས་ཅི་ལས་བྱང་ཞུས་པས་བུ་རམ་ཕྱག་ཏུ་བཞེས་ནས།",
    "གྲོགས་པོ་ལྟ་བུ་མི་མཉེས་པ་ཡོད་ན་ཁོ་ཅི་མགུ་བྱས་ནས་དེ་ནས་ཡང་སོ་སོར་སྡོད་པ་ཡིན་གསུང་།",
    "འདི་སུས་འཐུངས་ཞེས་ཕུ་བོ་ཁྲོས་ནས་ནུ་བོས་ངས་འཐུངས་ཏེ་ཆད་ལས་ཤིག་ཞུ་བྱས་བས།",
    "རྒྱལ་པོ་ལ་དེ་སྐད་བྱས་པས་མི་དགོས་ཟེར་ཡང་ཞུས་པས་འོ་ན་ཉི་མ་དྲུག་དུ་ཉི་མ་ལ་ཐོགས་ཞེས་པ་དང་།",
    "དེའི་ལས་ཀྱི་རྣམ་སྨིན་གྱིས་འཕགས་པ་སྒྲ་གཅན་འཛིན་ལོ་དྲུག་ཏུ་མའི་མངལ་དུ་བཞུགས་པ་ཡིན་གསུང་།",
    "དེས་ན་ཉེས་པ་མ་བཤགས་ཕྱིས་མ་བསྡམ་ན་རི་ཁྲོད་དམ་དབེན་པར་སྒྲུབ་པ་བྱས་པས།",
    "ཡང་རི་ལ་བསྒྲུབ་པ་བྱས་པས་འཛོམས་ན་ཡང་སྒྲུབ་པའི་ཆེད་དུ་ཚོགས་བསགས་པ་ཡིན་ལ་གྲོང་དུ་མི་འཛོམས་པ་ཡང་སྔར་དང་འདྲ་གསུང་།",
    "བྲམ་ཟེས་དང་པོ་བླངས་པས་སྟོང་པར་ལོག་རྒྱལ་བུས་ཐག་ཆོད་ནས་བླངས་པས་སྣོད་གང་བས།",
    "ཡང་དཔལ་ཆེན་གྱིས་ཡི་དམ་གྱི་ལྷར་བྱས་ནས་ཕུལ་ན་ཇི་ལྟར་འོང་ཞུས་པ་ལ།",
    "སྤྲེའུ་དད་ནས་སྦྲང་རྩི་ཕུལ་བས་བཞེས་པ་ལ་དགའ་ནས་སྤྲེའུས་འགྱུར་བྱས་པས།",
    "ཅིས་ཀྱང་བྱིན་གྱིས་རློབ་པར་ངེས།",
    "ང་བསྒྲུབ་པ་བྱེད་པར་དགོངས་ནས་ཡར་བྱོན་པ་ལ་ངའི་བུ་ཚའི་བསྲུང་བ་བྱེད་དགོས་ཟེར་ནས་མ་བཏང་།",
    "ཡེ་ཤེས་ཀྱི་མཚོ་དེས་བཀྲ་ཤིས་པར་ཤོག་གསུང་བ་དང་།",
    "རྟོག་པ་ལྟ་བར་མ་བྱས་ན།",
    "འདོད་ཆགས་སྐྱེ་བ་དེའི་རྩ་བ་ཡུལ་སྐྱེས་པ་མཐོང་བའི་རྟོག་པ་དེ་ལ་བལྟ་བར་མ་བྱས་ན་འདོད་ཆགས་མི་སྐྱེ་སྟེ་དེ་མ་ཡིན་ན་བུ་མི་འཆི་ཟེར་རོ།",
    "དོན་གང་ལྟར་བྱས་ཀྱང་སེམས་རྩུབ་པ་གྱོང་བ་ཞིག་ཡོད།",
    "ཡིད་ལ་དགའ་བ་ཡོད་པའི་ལས་དགོད་པ་ཙམ་ཡང་བཀག་སྟེ་དགེ་སྦྱོང་སོ་དཀར་བ་ཙམ་ཡང་མ་གནང་བ་དང་།",
    "ཟས་བསོད་སྙོམས་གདན་ཞིག་ཕྱིས་མི་ལེན་ཀྱང་འདི་ལ་དགོངས་ནས་གསུངས་ཏེ་བསམ་པ་དེ་གཅིག་པུ་རུས་སུ་འདོན་པ་ལས་གཞན་མི་བསམ་ཏེ།",
    "སྔོན་ནམ་རར་གསེར་མང་པོ་བྱུང་བས་ཅི་བྱ་སྙམ་པ་ལ་གསེར་གདུགས་བྱ་ཟེར་ནས་བྱེད་པར་དམ་བཅས་པ་ལ།",
    "ཡང་རྣམ་པར་མི་རྟོག་དབྱིངས་མི་ཟད།",
    "ལྟ་བའི་ཡུལ་ཞིག་ལ་བལྟ་མཁན་གྱི་ཤེས་པས་གཟུང་འཛིན་ཏུ་བྱས་པ་དེ་ལ་བལྟ་བ་མི་བཏུབ་ཏེ།",
    "མི་རྟོག་པ་གསུམ་ཡིན་ཏེ་གཉིས་པོ་ངོས་ཟིན་སྲིད་ཀྱང་མི་རྟོག་པ་འདི་ངོས་ཟིན་པར་དཀའ་སྟེ།",
    "ནམ་མཁའ་རང་ཡང་མེད་པར་བསྒོམ་ན་ཅི་ཡང་མེད་པ།",
    "མེད་པ་ཡང་མ་ཡིན་པར་བསྒོམས་ན་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་དེ།",
    "ཆགས་པ་དང་བྲལ་ནས་སྐྱེ་བ་མེད་ཅིང་ཀུན་ནས་ལྡང་བ་མེད་པར་ཤེས་པས་དེ་ཐོབ་པ་ལགས་གསུང་།",
    "ཡང་རྫུན་ལྟ་བུ་ཞིག་ལ་མཚོན་ན་རྫུན་རང་གཏན་གནང་བ་མེད་དེ།",
    "སྲོག་ལ་ཐུག་ཀྱང་རྫུན་མ་གནང་གསུང་།",
    "དེས་ན་སྐད་ཅིག་མ་དེ་འགྱུར་བ་ཡིན་པས་ན་རྫུན་ངག་ཏུ་མ་ཐོན་པར་ཉེས་པ་མི་འོང་ལ།",
    "ཡང་བཀག་པའི་དོག་ན་ཏུག་རྩེར་ཟུག་ན་གནང་བ་འཚོལ་བ་ལས།",
    "རི་བྲག་ཏུ་གཅིག་པུར་བསྒྲུབ་པ་བྱས་དུས་བར་ཆད་ཤིན་ཏུ་བྲེད་པ་སྐྱི་ཚ་བ་འོང་བ་ཡིན་ཏེ།",
    "ཌཱ་མ་རུ་ཞིག་བཙལ་ནས་ཉིན་མཚན་མེད་པརུས་གསུང་།",
    "དེ་ཡང་བདུད་རྩི་ཐོབ་པར་ཕྱི་རོལ་མུ་སྟེགས་པ་མཐའ་དག་ཀྱང་འདོད་དེ།",
    "འདུས་མ་བྱས་པ་ལྷུན་གྱིས་གྲུབ་པ།",
    "བདག་ལ་གནོད་པ་འདི་ལྟ་བུ་དགྲའམ་བདུད་དམ་འདི་སུས་བྱས་ཞེས་ཕྱིར་ཕྱུང་།",
    "འདུས་མ་བྱས་ཀྱི་རབ་ཏུ་ཕྱེ་བའི་བྱ་བ་ཡིན་གསུང་།",
    "དེ་ཡང་ང་ལ་གདམས་ངག་ལྷག་པོ་མེད་དེ་མྱོང་བ་ཡོད་པས་འདི་ལྟར་བྱས་ན་འདི་ལྟར་འོང་བྱ་བ་ཡོད་གསུང་།",
    "དེ་ལས་སྐད་ཅིག་ཀྱང་མ་ཡེངས་ཤིག་བྱས་ནས་དེ་ནས་དེ་བསྟན་པ་དང་།",
    "དེ་ཅི་ཡིན་སྙམ་པ་ལ་ངས་བསྒྲུབ་པ་བྱས་ནས་ཀྱང་གཞན་པས་ལྷག་པ་རང་མགོ་ཐོན་པ།",
    "དེས་ན་སྔོན་འདི་ཟབ་པས་མཉན་པར་ཡང་བྱས།",
    "དེའི་དུས་ན་དེ་བཞིན་གཤེགས་པ་འོད་ཟེར་གྱིས་བརྒྱན་པ་བྱ་བ་འཇིག་རྟེན་དུ་བྱོན་པ་ལ་བསྙེན་བཀུར་དཔག་ཏུ་མེད་པ་བྱས།",
    "གནོད་པར་བྱེད་པའི་བགེགས་ཀྱིས་གཙོ་བོ་བྱས་པ་འདི་རྣམས་བདེ་བ་དང་ལྡན།",
    "འབྱུང་ཤེས་ནས་གསེར་སྲང་བརྒྱ་རྩ་བཅུ་གཅིག་ཕུལ་ནས་བཞུགས་པར་ཞུ་བ་ཕུལ་བའི་དུས་སུ།",
    "འདི་བཅོལ་ཆུང་ངམ་བྱས་ཤ་མིན།",
    "འདིས་མཚོན་ནས་དུས་གསུམ་གྱི་བྱས་པ་དང་ཡོད་པ་བསྔོ་གསུང་།",
    "དེ་ལྟར་སྒྲུབ་པ་ཞིག་བྱས་པས་མཐུན་པ་དང་མི་མཐུན་པའི་རྐྱེན་བསྒྲུབ་པ་གཉིས་འོང་སྟེ།",
    "མཐུན་པ་ཕྱེ་ཕད་དང་ཞོ་རྫིའུ་འོང་བ་ལ་བརྟག་པར་བྱ་སྟེ།",
    "དེའི་ངོ་བསྲུང་ལ་སོགས་དཀའ་བས་སྒོ་དམ་པར་བཅད་ལ།",
    "དེ་མ་ཡིན་པ་མ་བླངས་པར་བསྒྲུབ་པ་བྱས་ན་ཁ་ན་བཟང་བ་ཡིན་ཏེ།",
    "ཇི་ལྟ་བ་མཁྱེན་པའི་ཡེ་ཤེས་དང་ཇི་སྙེད་པའོ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་སྐུ་ལ་ཞིང་ཁམས་ཐམས་ཅད་སྣང་ཞིང་ཞིང་ཁམས་ཐམས་ཅད་ལ་སྐུས་ཁྱབ་པ།",
    "རྣམ་པར་སྣང་མཛད་ཡེ་ཤེས་ནི།",
    "རྣམ་པར་སྣང་མཛད་ཡེ་ཤེས་དམ་པ་མཚོ་ཆེན་ལྡན།",
    "འདི་རྣམས་ལ་ང་སྔོན་འགྲོ་རྣམས་མི་ཁོམ་པར་ཕྱག་རྒྱ་ཆེན་པོ་ལ་རིངས་ཏེ་དེས་སུན་པས་གོང་མ་འདི་རྣམས་ཁོ་ན་གལ་ཆེ་སྟེ།",
    "རྟེན་ཅིང་འབྲེལ་པར་འབྱུང་འདི་རྒྱལ་བ་ཡི།",
    "བྱང་དུ་གསེར་འོད་དམ་པ་འདོན་པར་གསུངས།",
    "དང་པོ་ཚངས་པ་བརྒྱ་བྱིན་རྒྱལ་ཆེན་བཞི་ཁྱད་པར་དུ་གནོད་སྦྱིན་གྱི་བདག་པོ་ལྔ་རྩེན་གྱི་མིང་ནས་བོས་ལ་མིང་ཚིགས་སུ་བཅད་པ་ཐོན་ཞེས་པས།",
    "དེ་ལྟར་བྱས་པས་ལྔ་རྩེན་ལྷོ་ལམ་དུ་འགྲུལ་བཅད་པ་དང་ཕྲད་ནས་རི་བྲག་ན་ངའི་མིང་འདོན་པ་ཅི་བྱེད།",
    "དེས་ན་དགྲ་བཅོམ་ཐོབ་ཀྱང་དགག་པ་བཅས་པ་ཡོད་དེ་འཆར་ཀས་མ་བརྟགས་སྟན་ལ་བསྡད་པས་བུ་བསད་པས།",
    "སྟན་ལ་མ་བརྟག་པར་མི་སྡོད།",
    "དགེ་མི་དགེ་ལུང་མ་བསྟན་གྱི་འདུ་བྱེད་དེ་ཡང་རྣམ་པར་ཤེས་པ་དང་གཉིས་གཅིག་གམ་དེའི་ཁྱད་པར་གྱི་བརྟག་པ་ཡང་ཡོད་དེ།",
    "དེའི་རྣམ་སྨིན་གྱིས་ལམ་འཁྱར་བ་ཡིན་ཏེ་སྡུག་པར་བྱུང་།",
    "བཅོམ་ལྡན་འདས་ཆུ་སྲིན་བྱིས་པ་གསོད་ཀྱི་གནས་ན་བཞུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རི་འབིགས་བྱེད་ན་བཞུགས་ཏེ་བྱ་བ་གནས་འཁོར་མ་ངེས་པ་སྣ་ཚོགས་ལྔ་ལྔ་བསྡུས་པ།",
    "འདིའི་དུས་སུ་གཉིས་ཀྱིས་བསྡུས་པ་ཐམས་ཅད་གཉིས་སུ་མེད་པར་རྟོགས་ཏེ།",
    "ས་གསུམ་པོ་རྣམ་མཁྱེན་གྱི་ཡེ་ཤེས་ལ་སྒྲིབ་པས་ཤེས་བྱའི་སྒྲིབ་པ་ལྷག་པ་ཤེས་རབ།",
    "འདི་ཐོག་ན་བཞུགས་ཀྱང་ཟེར།",
    "འོ་ན་མ་རིག་པར་ཞེན་ན་མ་རིག་པ་ལ་དངོས་པོ་མེད་རིག་མ་རིག་ཡིན་ཏེ།",
    "མི་རྟོག་ཏིང་འཛིན་ལ་གནས་ན་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དེ་ཡང་དངོས་སུ་གནོད་སྦྱིན་མི་ཤ་རློན་པར་ཟ་བ་ལ་སོགས་པ་ལ་ངའི་བསྟན་པ་འདི་འཛིན་པར་གཏད་པ་ཡིན་པས།",
