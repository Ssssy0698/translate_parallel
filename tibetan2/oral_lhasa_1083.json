    "གཞན་དག་ཀྱང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཅིའི་ཕྱིར་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་ཐམས་ཅད་ཞུགས་ཤེ་༤ན།",
    "དཀྱིལ་འཁོར་སྤྲུལ་པ་བྱས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་ལྟར་མཛད་པ་དེ་ལྟར་རྗེས་སུ་སྤྱད་པར་བྱའོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོའོ།",
    "རྡུལ་ཕྲ་རབ་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་ཞུགས་ནས་གཅིག་ཏུ་གྱུར་པ་ཉིད་ཐོབ་པ་ནི་ངོ་མཚར་ཆེའོ།",
    "གསང་བ་སྲ་ཞིང་མཐོ་བ་ལས་རྣམ་པར་ཕྱེ་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་དང་།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ཐོབ་པའི་ཐབས་བསྟན་ནས།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་འདི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བྱེན་གྱིས་བརླབ་པར་ཞེས་བྱ་བ་ནི་སློབ་དཔོན་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པའི་བྲི་བའི་ཚོགས་༧ཡུན་རིང་དུ་གནས་པ་དེས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་པ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཏེ།",
    "དེ་ནས་༧ཐོག་མ་དང་ཐ་མ་མེད་པ་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ཀྱིས་ན་དེ་བཞིན་གཤེགས་པའི་རྡོ་རྗེ་ཆེན་པོ་འཛིན་པར་མཛད་དེ།",
    "གསོལ་བ་བཏབ་བོ་ཞེས་བྱ་བ་ནི་གསོལ་བ་བཏབ་པར་གྱུར་པའོ།",
    "སེམས་དཔའ་མཆོག་ཅེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དགྱེས་པ་ཡང་དག་པར་བསྐྱེད་པས་༥བླ་ན་མེད་པ་ཡིན་པས་སེམས་དཔའ་མཆོག་གོ།",
    "དགའ་བ་ཆེ་ཞེས་བྱ་བ་ནི་མགུ་བའི་ཚུལ་གྱིས་ནམ་མཁའ་ཐམས་ཅད་ཁྱབ་པར་མཛད་པས་སོ།",
    "ནོར་བུ་ཆེ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་རིན་ཆེན་གྱི་ཕྱག་རྒྱས་ནམ་མཁའ་ཁྱབ་པར་སྤྲོས་པས་ན་ནོར་བུ་ཆེའོ།",
    "རབ་དགའ་བྱེད་ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་རྒྱལ་མཚན་དེ་ཉིད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ངེས་པར་སྦྱོར་བས་ན་རབ་དགའ་བྱེད་དོ།",
    "རྡོ་རྗེ་ཆེན་པོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་རྒྱལ་མཚན་ཀྱི་ཕྱག་རྒྱས་ནམ་མཁའ་ཐམས་ཅད་ཁྱབ་པར་མཛད་པས་ན་རྡོ་རྗེ་ཆེན་པོའོ།",
    "བཞད་པའི་ཕྱག་རྒྱས་ནམ་མཁའ་ཐམས་ཅད་༦ཁྱབ་པར་མཛད་པས་ན་བཞད་པ་ཆེའོ།་།",
    "ཕྱག་རྒྱ་དེ་ཉིད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འཛུམ་པ་ལ་ངེས་པར་སྤྱོར་བར་མཛད་པས་ན་ངོ་མཚར་ཆེ་ཞེས་བྱ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་མི་མངའ་བ་རྣམས་ལ་ནི་བཞད་པ་མི་མངའ་བའི་ཕྱིར་རོ།",
    "མཚོན་ཆེན་པོ་ཞེས་བྱ་བ་ནི་རལ་གྲིས་ནམ་མཁའ་ཁྱབ་པར་མཛད་པའོ།",
    "ཚུལ་ཆེན་པོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དབྱིངས་ལ་སོགས་པའི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་ཀྱིས་ནམ་མཁའ་ཁྱབ་པར་སྤྲོས་པས་སོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིའི་རང་བཞིན་གྱི་སྒྲའི་རྗེས་སུ་འགྲོ་བའི་ཤེས་རབ་པོ།",
    "སྲ་བ་ཆེ་ཞེས་བྱ་བ་ནི་དེ་ཉིད་གཞིག་པར་རི་དཀའ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "བརྩོན་འགྲུས་མཆོག་ནི་ཐུབ་པར་དཀའ།་",
    "ཞེས་བྱ་བ་ནི་བརྩོན་འགྲུས་ཀྱི་མཆོག་ཀྱང་ཡིན་ལ་ཐུབ་པར་དཀའ་བ་ཡང་ཡིན་པས་ན།",
    "བརྩོན་འགྲུས་མཆོག་ནི་ཐུབ་པར་དཀའ།",
    "འཇིགས་པ་ཆེ་ཞེས་བྱ་བ་ནི་མཆེ་བའི་ཕྱག་རྒྱ་དེ་ཉིད་ཀྱིས་ནམ་མཁའ་ཐམས་ཅད་ཁྱབ་པར་མཛད་པས་སོ།",
    "རྡོ་རྗེ་མི་བཟད་པ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་མཆེ་བའི་ཕྱག་རྒྱས་༧དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འཇིགས་པར་མཛད་པས་ན་རྡོ་རྗེ་མི་བཟད་པའོ།",
    "ཞི་བ་ཞེས་བྱ་བ་ནི་སྡུག་བསྔལ་ཐམས་ཅད་ཟད་པར་བྱེད་པའི་རྒྱུར་གྱུར་པས་ན་ཞི་བའོ།་།",
    "དབྱངས་ཀྱིས་བསྟོད་ཐུཔས་ཞེས་བྱ་བ་ནི་རྣལ་མ་ཉིད་ཡིན་པའི་ཕྱིར་རྡོ་རྗེ་འཆང་ཆེན་པོ་ལ་དེའི་ཡང་དག་པའི་ཡོན་ཏན་བརྗོད་པར་འདོད་པས་སོ།",
    "ཚུལ་ཆེན་ཡང་ནི་རྒྱས་པར་མཛོད།",
    "དེ་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་ཏིང་ངེ་འཛིན་གང་ལ་མིང་དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དེ་ལ་སྙོམས་པར་ཞུགས་པ་སྟེ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་གསུངས་པའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེའི་དབྱིངས་ཀྱིས་ཉེ་བར་མཚོན་པས་ན།",
    "ཅི་རིགས་པར་ནི་མཆིས་ནས་ཀྱང་།",
    "༦ཅི་རིགས་པར་ནི་འདི་ཡིན་ཏེ།",
    "ཅི་ནུས་པར་བྱའོ།་།",
    "བཤགས་པ་དང་གསོལ་བ་འདེབས་པ་ལ་སོགས་པ་ནི་གཉིས་པའོ།",
    "དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་རྣམ་པར་བསྒོམས་ནས་བསྡུ་བ་བྱས་ལ།",
    "ཕྲིན་ལས་རྣམས་ལ་ངེས་པར་སྦྱར་བར་བྱའོ།",
    "ལས་ཀྱི་རྡོ་རྗེ་མས་རིགས་ཐམས་ཅད་བསྡུས་པར་རྒྱས་གདབ་པར་མཛོད་སྦུག་ཅེས་བྱ་བ་དང་།",
    "དོན་ཡོད་པར་ཧཱུཾགྲུབ་པ་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་མཛོད་ཅིག་ཅེས་བྱ་བ་དང་།",
    "ཆགས་པས་རྗེས་སུ་མཉེས་པར་མཛོད་ཅིག།",
