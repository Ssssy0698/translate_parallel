    "བར་སྣང་ལ་བཞུགས་པ་ཕབ་སྟེ་གཅིག་ཏུ་བྱའོ།",
    "བར་སྣང་ན་བཞུགས་པ་ཕབ་སྟེ།",
    "རྡོ་རྗེ་རིན་ཆེན་མ་ལ་སོགས་པའི་གདན་ཡང་དེ་ལྟ་བུ་ཉིད་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ཕྱེད་པའི་གདན་ལ་བཞུགས།",
    "ཕྱག་གཡོན་པ་གདན་ལ་བརྟེན་ནས་བཞུགས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་འཛུམ་པ་ལ་ངེས་པར་སྦྱོར་བ།",
    "ཕྱག་གཡོན་གདན་ལ་བརྟེན་པས་བཞུགས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་འདེབས་པའི་ཚུལ་གྱིས་ཡང་དག་པར་བཞུགས་པའོ།",
    "གཡོན་པ་གདན་ལ་བརྟེན་ནས་བཞུགས་པའོ།",
    "གཡོན་གདན་ལ་བརྟེན་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "ཞལ་གྱི་མཆེ་བ་གཅིགས་པ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་ཞལ་གྱི་མཐའ་གཉིས་སུ་མཆེ་བ་གཉིས་འཛིན་ཅིང་བཞུགས་པའོ།",
    "ཕྱག་གཉིས་ཀྱིས་གར་མཛད་ཅིང་བཞུགས་པའོ།",
    "ཕྱག་གཡས་ཀྱིས་དྲིའི་སྤྲིན་གྱེས་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་མཆོད་ཅིང་བཞུགས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་འབེེབས་པར་མཛད་པ།",
    "ཕྱག་གཡོན་གདན་ལ་བརྟེན་ཏེ་བཞུགས་པའོ།",
    "ཁྱད་པར་ནི་འདི་ཡིན་ཏེ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་ལེགས་པར་བཀོད་ནས།",
    "ཡང་རྡོ་རྗེ་དྲིལ་བུ་དཀྲོལ་ཞིང་དཀྱིལ་འཁོར་ལན་བདུན་བསྐོར་བ་བྱས་ལ།",
    "རྡོ་རྗེའི་གར་བྱས་ཏེ།",
    "བཛྲ་སཏྭ་ཧཱུཾ་ཞེས་བྱ་བ་བར་མ་ཆད་པར་བཟླས་པར་བྱའོ།",
    "འགྲུབ་འགྱུར་སྨད་པར་མི་བྱའོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་རྗེས་ལ་ཡི་གེ་ཧཱུཾ་ལས་བདག་ཉིད་རྡོ་རྗེ་ཧཱུཾ་མཛད་དུ་བསམ་པར་བྱའོ།",
    "དེ་ནས་རྡོ་རྗེ་སེམས་དཔའི་སྦྱོར་བ་དང་ལྡན་པའི་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའི་སྤྱན་སྔར་ལེགས་པར་གཞག་གོ།",
    "དཀྱིལ་འཁོར་གྱི་ཕྱི་རོལ་དུ་གཞག་པར་བྱའོ།",
    "དེའི་རྗེས་ལ་བུམ་པ་གང་བ་ལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྔགས་བཟླས་ལ་གཞག་པར་བྱའོ།",
    "བཅུ་ལས་ཉུང་བར་མི་བྱའོ་ཞེས་ངེས་པ་གསུངས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་སེམས་མ་རྡོ་རྗེ་མ་དྲལ་ཞིང་ཨཱ་༤ཞེས་བྱ་བས་བདག་ཉིད་ལ་དབབ་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་སུ།",
    "རྣམ་པར་སྣང་མཛད་དུ་བདག་ཉིད་བསྒོམ་༥པར་བྱ་བ་ནས་དེ་བཞིན་དུ་རྡོ་རྗེ་འབེབས་པའི་བར་གྱི་ཚོཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ལ།",
    "བཛྲ་གྷབྱེལྷ་ཧཾ་ཞེས་བྱ་བས་དྲིལ་བུའི་རྣམ་པར་བསྒོམས་ཏེ།"
  ]
