    "གཞན་དུ་ན་ཁྱེད་རང་ལ་ཁས་བླངས་འགལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཡང་ན་ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་དུ་མེད་པ་དེ་རང་བཞིན་མེད་པས་ཁྱབ་སྟེ།",
    "ཞེན་བྱེད་ཀྱི་བློ་དང་རང་བཞིན་གཉིས་བེམ་པོ་དང་།",
    "འོ་ན་ཁྱེད་རང་ལྟར་ན་ཆགས་བྲལ་གང་ཡིན་ཞེ་ན།",
    "འོ་ན་ཁྱེད་རང་ཡང་བྱམས་སོགས་གོམས་པ་དང་གཟུངས་སྔགས་བཟླས་པ་ལས་སྒྲིབ་པ་འདག་པར་འདོད་པ་དང་འགལ་ལ།",
    "འབྲེལ་བ་རང་ཉིད་ཤེས་པའི་ཡན་ལག་ཏུ་བསྟན་པ་དང་རང་ཉིད་ཤེས་ཟིན་མ་བརྗེད་ཀྱང་ཁྱབ་པ་གཉིས་ལ་དྲན་པ་བསྐྱེད་པའི་ཡན་ལག་ཏུ་བསྟན་པའོ།",
    "ཐ་མལ་དངོས་པོའི་འདུག་ཚུལ་ནི།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་བསྟན་པ་རྫོགས་སོ།",
    "ལྟ་བའི་ལ་ཟློ་ན་མུན་པའི་དམག་ལ་འདུག།",
    "བེ་རོ་ཙ་ནས།",
    "དག་སྣང་རང་རིག་ཡེ་ཤེས་ཉིད།",
    "དེའི་ཕྱི་རོལ་ཏུ་ལྟོས་དང་སྐྱེ་མེད་དུ་འདུག་པ།",
    "སྲོག་ཀླུང་དང་བུས་པ་བཙས་པའི་ལོ་ཟླ་ཞག་དུས་མ་བུ་དགྲ་གྲོགས་སྦྱར་བའི་འབྲས་བུ།",
    "འདི་དག་ལ་ལུང་ཡང་ཡོད་འདུག་པ་ནས་དགོས་ཞུས་པར།",
    "བསྟན་བཅོས་བརྩོམ་ཞིང་རང་སྐད་ཐོན་པ་འབྱུང་",
    "འདི་མཐོང་རང་སར་བསྙིལ་བ་དངོས་པོའི་གཤིས།",
    "རང་རང་བསྒོ་བའི་བགྱིད་དངོས་དཔེ་བྱ་ཐོགས་མེད་སྒྲུབ།",
    "རང་རང་ཡུལ་གྱི་རྗེས་འབྲངས་དོན་མཐུན་རྣམས།",
    "ཁྱབ་བདག་དུས་ཀྱི་འཁོར་ལོར་ཕྱག་འགྱིའོ།",
    "བསྟན་ལ་ཕན་དང་རང་བཞིན་དམན་པ་སོགས།",
    "གཙོ་བོར་༧གོང་ནས་ངོས་འཛིན་གནང་ཞིང་རང་ངོས་ལ་གདེང་ཚད་གང་ཡང་མེད་ཀྱང་བཀའ་གཏེར་ཀྱི་ལུང་དང་།",
    "སྲོང་བཙན་གྱི་སྲས་གུང་རི་གུང་བཙན་རྣམས་ལྷ་སྲས་ཀྱི་སྐྱེ་བ་གོང་མ་དངོས་བསྟན་ལྟ་བུར་འདུག་པ་དང་།",
    "འོན་ཀྱང་སད་ན་ལེགས་ཀྱི་མུ་ཏིག་ཐ་ཆུང་དེ་ལས་མུ་ནེ་ཐུ་བོ་དེ་མིན་པར་སེམས་ཤིང་རང་ངོས་ལྟ་བུར་ནི་རིན་ཅེན་ཕུན་ཚོགས་ཀྱི་བག་ཆགས་ལྟ་བུ་ཕྱི་ནང་མེད་པར་ཡེ་མི་སྣང་ལ།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་ཁོང་ལོ་བཅུ་གསུམ་མན་ལ་ཞམ་རིང་དུ་འབྱོར་འདུག་པ་བཅས་མཁས་གྲུབ་ནོར་བཟང་བ་དང་དྲུང་གནས་གཉིས་དུས་མཚུངས་པས་ཐུགས་རྒྱུད་གཅིག་པ་ལས་བརྒྱུད་པའི་སྐྱེ་ཕྲེང་མིན་པས་བཞག།",
    "བདག་ལྟ་བུ་དེ་གྲལ་དུ་ཁྱི་གུ་ཐོག་ཁར་བཞག་ན་ནམ་མཁའི་སྐར་མར་གནོད་པ་ལྟར་དང་རང་ཡང་སྒྲིབ་པ་གསོག་པ་ལས་མ་འདས་ཀྱང་༧གོང་ནས་ལྷ་སྲས་ཀྱི་སྐྱེ་ཕྲེང་དུ་གནང་བ་དང་།",
    "གང་ཞིག་དུས་སུ་ཆར་མེད་གང་དུ་ལམ་ཞུགས་སེར་བ་མི་མཐུན་དུ་མ་འབབ།",
    "ལྔ་བརྒྱ་དུས་ཀྱི་ཐ་མར་གྱུར་ཙ་ན།",
    "རྟགས་ཙམ་འཛིན་པའི་དུས་རྫོགས་ནས་ཀྱང་བགྲོད་པ་དྲུག་བརྒྱ་སོ་བཞི་ཙམ་འདས་འདུག་རུང་།",
    "རང་ལ་འཐོལ་བའི་སྤར་གང་ནོད་པར་འདུག་ན་ཕ་ཡང་མགོ་མཇུག་སློག་ལ་ཐེ་ཚོམ་དང་བྲལ་ཞིང་།",
    "ལེགས་ཁ་བུ་ལ་འདུག་ཀྱང་ཕས་མི་བཟོད་པའམ་ཟུག་པ་སོགས་ཀྱི་ལས་ཚུལ་མིན་རྣམས་དར་བས་སྲིད་པའི་ལྷ་ཆེན་ལ་སོགས་པ་ལྷ་ཀླུ་མཐུ་བོ་ཆེ་རྣམས་མ་དགྱེས་ཏེ་ཆར་ཆུ་དུས་སུ་མི་འབེབས་ཤིང་ལོ་ཕྱུགས་ཀྱང་རྟག་ཏུ་མི་ལེགས་ལ།",
    "དཔེ་མེད་མ་ཞེས་བྱ་བ་དེ་གཉིས་རྫིང་དགའ་བ་ཞེས་བྱ་བར་ཁྲུས་བྱས་ཏེ་སྤོས་ཆུས་གོས་བརླན་པས་སེང་གེའི་ཁྲི་པདྨའི་འབྱུང་གནས་བཟང་པོ་ལ་འདུག་གོ།",
    "དེ་གཉིས་དེར་འདུག་པའི་པང་པ་ནས་རྒྱལ་བུ་གཞོན་ནུ་གཟུགས་བཟང་བ་མཛེས་པ་བལྟ་ན་སྡུག་པ།",
    "ཆུ་བོ་གངྒཱ་དང་ཕྱིའི་རྒྱ་མཚོའི་ནང་མཐའི་བར་ན་འདུག།",
    "སྒོ་གསུམ་རིམ་དང་ལྡན་པ་དེར་བཅོམ་ལྡན་འདས་སོགས་ཡོད་འདུག་ལགས་པས་ཆུ་ནང་དུ་ཕྱེད་ནུབ་སོགས་དོགས་པ་ཆེ་བའི་ཚོམ་པ་ཙམ་བྱུང་བ་སྙན་སྒྲོན་དུ་ཕུལ། གཉིས་པའི་དོགས་ལན།",
    "མན་ལུང་གུ་རུ་ཅན་གྱི་འདི་ག་རང་འཐད་འདུག་པས་ཚོམ་པ་མི་འཚལ་ལོ། དྲི་བ་གསུམ་པ།",
    "ཞེས་གནང་འདུག་པ།",
    "རི་རབ་དང་ལུས་ཀྱི་རྫ་མ་དེ་ག་སྦྱར་ན་གཞི་དོགས་ངན་ལས་མ་འདས་ཀྱང་གོ་ཕྱོགས་སྣ་ཚོགས་ཀྱིས་ཚོམ་པ་འདུག་པས་སྙན་སྒྲོན་དུ་ཕུལ། བཞི་པའི་དོགས་ལན།",
    "རིམ་བཞིན་རང་རང་འབྱུང་ཁམས་ཀྱི།",
    "མཁས་གྲུབ་དགེ་ལེགས་དཔལ་བཟང་གཉིས་མ་གཏོགས་འཐེན་ཐོགས་ལས་ཤ་སྟག་བཞེད་པའི་ཚད་ཐུབ་རང་ལུགས་སུ་མེད་པ་དང་གང་བྱས་ཀྱང་སྐྱོན་མི་འདུག་པས།",
    "ཡིག་ཉོག་གཞན་མ་ལས་གསལ་ཞིང་ལག་ཏུ་བླང་བདེ་བ་ཙམ་ནི་རང་ཉིད་ཀྱིས་ལྟས་ཀྱང་ཡོད་ཅིང་ཐུགས་འབྱོར་བྱུང་འདུག་པ་ལེགས།",
    "རང་ལུགས་ལུང་རིགས་ཀྱིས་བསྒྲུབས་ན་བློ་གསར་རྣམས་ལ་ཕན་པ་ཞིག་འོང་རྒྱུར་འདུག་རུང་།",
    "ད་ལམ་ཚོམ་པ་མ་བྱུང་འདུག་པ་དང་།",
    "ཊ་སོགས་ཤུགས་ཀྱིས་བློ་གྲོས་དང་ལྡན་པ་རྣམས་ཀྱིས་བརྟགས་ཚེ་ལྷད་ཅན་དུ་གོ་འགྲོ་འདུག་ཀྱང་།",
    "པཎ་གྲུབ་སོགས་བསྟན་པའི་གསལ་བྱེད་དུ་གྱུར་པ་རྣམས་ཀྱི་འཁྲུངས་ལོ་སོགས་ལོ་ཚིགས་ཀྱི་ངེས་པ་འདིའོ་ཞེས་པ་ཡང་གལ་ཆེ་ངེས་སུ་འདུག་ལགས་པ།",
    "ལོ་འདིའི་ངོས་འཛིན་རྒྱུད་གསུངས་པའི་ལོར་བྱེད་དགོས་ཞེས་བཀའ་དྲིན་བསྐྱངས་འདུག་པ་དང་།",
    "ལྕགས་འབྲུག་ལ་གཤེགས་ཚུལ་འདུག་པ་དེས་ན་དགུང་ལོ་ཡང་དོན་གཅིག་བཞུགས་འདྲ་ཞིང་།",
    "ཡང་ཉུང་བ་ལོ་དྲུག་སོགས་མང་པོ་བྱུང་བ་རྩོད་ཡིག་ཚོར་འདུག་པ་དང་།",
    "ད་ནི་བདག་ཀྱང་འདི་རུ་མི་འདུག་སྟེ",
    "སྔར་བྱིངས་ཆེར་རྭ་འབྲོ་ལུགས་ཀྱི་བཞེད་པ་སོ་སོ་པ་ལས་དབྱེ་གསལ་མ་བྱུང་འདུག་པ་ནས་བསྟན་རྩིས་འདིའི་དུས་འཁོར་འཕགས་ཡུལ་དུ་སྤྱན་འདྲེན་མཛད་མཁན་ནི་ཙི་ལུ་པ་དང་དུས་ཞབས་དབྱེ་བ་མེད་པར་བཏང་སྙོམས་ཀྱིས་བཀོད་པ་སྟེ་ཚོམ་པ་མི་འཚལ་ལོ། དྲི་བ་བཅུ་བདུན་པ།",
    "ཞེས་གསུངས་པ་སོགས་ལུགས་འདི་མི་བཞེད་འདུག་གཤིས་སྟོབས་ཆེན་དུ་གོ་ཕྱོགས་ཡོང་བ་ནི་བདེན་པར་གོ་ཡང་།",
    "རྐང་པ་ཕྱེད་པའི་སྐོར་འདིའང་ཡོང་བབས་དེ་བཞིན་སྙན་འབུལ་ཞུ་མི་བྱུང་ཚེ་དགོངས་དག་པ་འདུག་ཅིང་།",
    "ཉེར་གསུམ་པ་ལེའུ་བདུན་པ་ཚེས་སྤྱོད་སྐོར་ཡུལ་དུས་སོགས་ཤེས་པ་ཞིག་ལ་ཞག་གསུམ་གང་ནས་བསྒྲུབས་ཀྱང་བྱ་པར་མ་མཆིས་པ་ཉིད་ཡུལ་དུས་རགས་པ་མཛད་འདུག་པས་དགོངས་པ་ལྟར་དང་།",
    "ནགས་ཚལ་འདུག་པ་དག་ལ་ཉི་མའི་ཟེར་གྱིས་ཕོག་པའི་འོད་ཟེར་འབུམ་ཕྲག་མང་པོ་དེའི་གདོང་དུ་བབས་ཏེ་མིག་ལ་གནོད་པར་གྱུར་པ་མཐོང་ངོ།",
    "སེམས་མི་དགའ་ཞིང་ཡིད་མུག་པས་བ་སྤུ་ལངས་པར་གྱུར་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཞེས་སོགས་གནང་འདུག་པ་དག་རྩིས་གཙོ་བོ་དག་པ་དང་།",
    "རང་འཁོར་འདོད་པ་གཉིས་རི་རོ་མེ་མིག་སོགས་ཀྱིས་དྲིལ་བས་༤༡༡༡༡༢དེ་གསུམ་གཅིག་ཏུ་བསྲེས་འོག་ནས་འདོད་པ་འདོད་པ་རི་རོ་མེ་མིག་དུས་མཁའ་རོ་མཁའ་རོ་སོགས་ཀྱིས་དྲིལ་བས་༢༤༢༢དབུཊ།",
    "འཇུག་མའི་སྐབས་ཚེས་ལོངས་ཟད་དུས་དང་ལྟ་སྣང་འགྲིག་འགྲོ་བ་དག་བྱེད་དུ་འདུག་ལགས་པར་མ་ཟད།",
    "ལགས་པ་ཇི་ལྟར་ཞུ་འདོད་ལ་བརྩེ་བ་ནས་མི་འདོར་བའི་གོ་སླ་ཞིང་དོན་གསལ་བ་ཞིག་དགོས་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། སོ་གཅིག་པའི་དོགས་ལན།",
    "དབུགས་ལ་དྲུག་ཚ་ལ་ཚེས་སྤྱོད་མིག་དམར་དུ་མཚོན་ན་རི་རོ་དང་རང་ཆར་ཉིས་བརྒྱ་ཉེར་དགུ།",
    "ཁོ་རང་ངོ་བོའི་སྒོ་ནས་དགེ་ཞན་གྱི་འབྲས་བུ་དེ་ལྟར་ཡོད་པ་དང་།",
    "གཡས་གཡོན་གྱི་སྡུག་བསྔལ་ནོར་ཉམས་སྟོན་པ་འཆི་མེད་བདེ་བའི་མན་ངག་ལས་འབྱང་ཞིང་རྒྱ་ཡུལ་མཁས་པའི་ཁྱད་ནོར་དུ་འདུག་པས་དེ་ལྟར་དུ་བཀོད་ཅིང་།",
    "དུས་སྦྱོར་གྱི་འཁོར་ལོ་གནས་མལ་བཅུ་གཉིས་རྣམས་གནམ་འཁོར་དང་བསྟུན་པའི་ངོས་འཛིན་བྱེད་སྲོལ་འདུག་པས་དོགས་ངན་གྱི་ཚོམ་པ་མི་འཚལ་ལོ། དྲི་བ་ཞེ་བདུན་པ།",
    "ཡང་རིགས་ཀྱི་སྐར་མའི་སྐབས་བོད་དུ་རང་རང་རིགས་རུས་ལ།",
    "ཡང་ན་སྐད་སོ་སོའི་དགོངས་མཚོན་ཡིན་གྱི་གསལ་བྱེད་བྱུང་ན་ཚོམ་པ་སེལ་འདུག་བསམ་པ་སྙན་སྒྲོན་དུ་ཕུལ། ང་དགུ་པའི་དོགས་ལན།",
    "སྤར་ཁའི་བཟང་བཞི་ངན་བཞིའི་བརྡ་རིས་ལ་འགའ་ཞིག་ཏུ་ལུས་ཆད་ཞེ་གཅིག་བྲིས་པ་ཡོད་འདུག།",
    "ཕུག་ལུགས་པ་ཀུན་ལ་རྩ་ཁུངས་འདིར་བརྟེན་པའི་མན་ངག་འདི་ཞེས་པ་ཞིག་ནི་ཕའི་གསོལ་ཞལ་ཀུན་ལ་གཙང་བའི་མཛད་པ་ལས་མེད་འདུག་དུས་འཁོར་མཁའ་འགྲོ་རྒྱ་མཚོ།",
    "ད་ཕན་འདི་ལ་ཐུགས་དོགས་འཕྲོས་རིགས་སུ་ལ་ཡང་མ་བྱུང་གཤིས་ལེ་ཐོ་སྦྱོར་འགྲོ་ལ་སོགས་པའི་སྤྱོད་ཁྲ་རྣམས་གསུང་བོད་སྐད་དུ་འབྱོན་པ་ལས་འོས་མ་མཆིས་འདུག་ལགས་ཤིང་།",
    "ཡིན་ཀྱང་ཁོ་རང་རྣམས་ཀྱིས་རྩ་ཁུངས་ཀྱི་སྒོ་ནས་འགལ་ཏེ་ལྔ་འཛོམ་རྡོ་རྗེས་བྱས་པ་ཕག་ཞག་ལ།",
    "ཉིན་ཞག་དུས་ལོངས་རྣམ་པར་དག་༦༤༣༤༢༩༣༡༤། ཁྱིམ་དཀྱིལ་ཞག་གནས་བྱུང་རི་བྲོ།",
    "རང་རང་སྐྱེས་པའི་སྨེ་བ་བསྲེ།",
    "རང་རང་ཕ་མེས་ཐོག་སླེབ།",
    "གསང་ཀེག་རྐུན་བུ་རུས་མིག་རྩུབ། ། ཟླ་ཞག་དུས་ཀྱི་ངོས་འཛིན་ལུགས།",
    "གནམ་ལོ་ལོག་མེན་ཟླ་ཞག་དུས།",
    "གཟུགས་༡བྱུང་རང་ཀེག་རྩུབ་པ་ཡིན།",
    "ཤིང་རིང་བའི་གྲིབ་མར་ཁྲུ་ཉི་ཤུ་ལྟ་བུ་ཞིག་འདུག་ཚེ།",
    "ལྐོག་གྱུར་གྲངས་ཀྱི་དོན་རྟོགས་ཟེར་བ་མེ་མདའ་ཐུབ་པས་བགྲངས་པ་སོགས་ཡོང་འདུག་རུང་།",
    "སྣག་སྨྱུག་འབྱོར་ཚད་ཀྱི་བསླད་པའི་འདི་ལྟ་བུའི་ངེས་ཁུངས་རྒྱུད་དོན་དང་འགལ་མེད་འཆད་ཐུབ་པ་ཞིག་མི་འདུག་པ་དང་།",
    "རྐང་མཐིལ་ལས་སྐྱེས་པ་སྟོབས་ཀྱི་འཁོར་ལོས་སྒྱུར་བར་གནང་འདུག་པ་སྐྱེ་གནས་ཀྱང་ཅུང་ཟད་མི་མཐུན་ཅིང་།",
    "དེབ་སྔོན་དུ་བགྲངས་པ་འདི་ཉིད་ནི་གང་དང་ཡང་མི་མཐུན་པས་ནོར་ངེས་སུ་འདུག་ཅིང་།",
    "དེ་སྔོན་ནས་དར་ཚར་བ་འདྲ་ཞིག་འདུག་པ་དང་།",
    "འདྲེས་པར་དོགས་པ་ཙམ་འདུག་རུང་ཞིབ་པར་བརྟག་ན་མི་འགྲིག་པ་མི་སྣང་སྟེ།",
    "འོ་ན་ལྷན་ཐབས་ཅིས་ཁྱད་པར་དུ་ཆེ་བསམ་ན་ཐོག་མའི་ཞལ་ལུང་རང་ལུགས་ཀྱི་གྲུབ་རྩིས།",
    "སྐར་ནག་གང་ལ་ཡང་མཐའ་ཆོད་པ་ཞིག་བྱུང་འདུག་པར་ཞལ་ལུང་བུ་ཡིག་ཟུར་བཀོལ་གྱིས་བརྒྱན་པ་སོགས་སྐར་རྩིས།",
    "སྤུག་སོགས་ཀྱི་ལུགས་ཀྱི་ཟླ་ཞག་དུས་ཚོད་ཀྱི་ཁམས་བརྩི་ལུགས་ཉིད།",
    "དར་རྒུད་སྐབས་འདིར་ལོ་ཟླ་ཞག་དུས་བཞིར་སྦྱོར་བ་གནང་བ་ལྟར།",
    "བརྒྱ་ཐམ་པ་ཡང་སྤུག་ལ་སོགས་པའི་ལུགས་ཀྱི་ཟླ་ཞག་དུས་ཚོད་ཀྱི་ཁམས་བརྩི་ལུགས་རྣམ་དག་མིན་ཞེས་བརྗོད་པ་འདི་ཉིད་ལ་སྐྱོན་ཡོད་པ་མིན་ཏེ།",
    "དེའི་རྒྱ་མཚན་ནི་ལོ་ཟླ་ཉིས་སྦྲགས་གཉིས་གཉིས་ཀྱི་ཁམས་མ་ལ་བུ་ཚེས་སུ་འཚོལ་བ་ཞག་དུས་ཀྱི་ཕ་དང་མེས་ལྟ་བུ།",
    "རྒྱུད་དོན་ལ་གཡག་ཞར་བའི་རྩྭ་མཛད་འདུག་པས་དེ་ལྟར་དུ་བགྱིས་སོ།",
    "གང་ལ་བསགས་པར་གཙགས་བུ་མགོ་ལ་འཛུགས་བའི་བཅོས་སུ་འདུག་ཀྱང་།",
    "ལོ་ཞག་དུས་དང་སྦྱོར་བ་མིན་ཞེས་ཟེར་བ་འདི་དག་ནི་འཐད་ཕྱོགས་མིན་ཏེ།",
    "ཟླ་བ་ར་བ་བཞི་པོ་བདག་པའི་ལོ་དེ་ལོ་ཟླ་ཞག་དུས་གང་ལ་འཆར་བ་སོ་སོ་ནས་དབུགས་བླངས་པའི་སོ་སོའི་དར་གུད་བརྟག་པ་ཡིན་ཏེ།",
    "རང་རང་བསྐོར་ཏེ་དར་གུད་བརྩེ།",
    "ཞག་དུས་གང་བརྟག་ཤེས་པར་བྱ་བ་དང་།",
    "ཕྱིས་རང་བདག་ཚོ་ལྟ་བུར་དེ་རིགས་དགོས་ཚུལ་གསུང་མི་ཆེར་མི་ཡོང་འདུག་ཀྱང་།",
    "རང་འབྱུང་རང་བཞིན་ནམ་མཁའི་ངང་།",
    "དེའི་ཟླ་གྲངས་ཀྱི་མངལ་དུ་གནས་དགོས་པ་བུས་པ་མའི་ལྟོར་ཟླ་བ་བཅུ་གཉིས་སོགས་དགུ་འདས་པ་སྲས་སྒྲ་གཅན་འཛིན་ལྟ་བུ་ལས་འབྲས་ཀྱི་ཆེ་བརྗོད་དུ་མཛད་པ་བསྟན་པ་ཙམ་ལས་གནས་དགོས་མི་འདུག་པ་སྐྱོན་ཆེ་བའི་དོགས་པ་ཤར་བ་སྙན་སྒྲོན་དུ་ཕུལ།",
    "སྒྲིག་ཁ་འདིར་མ་གནང་ཀྱང་སྐར་རྩིས་དབྱངས་འཆར་ནས་གསུངས་པ་རྣམས་ཀྱང་བདེ་ལེགས་ཀུན་ཐང་དུའང་ཐོར་བསྡུས་འདུག་པ་ལྟར་ལེན་དགོས་པ་གཞིར་བཅས་ལགས་ཤིང་།",
    "འདེར་དེ་བས་སྒོས་སུ་གནང་བ་འདིར་གསལ་སྒྲོན་གཅེས་བསྡུས་ལས་འགལ་ཆར་འགྲོ་མི་འགྲོ་དོགས་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་དྲུག་པའི་དོགས་ལན།",
    "བུས་པ་བཙས་པའི་ལོ་ཟླ་ཞག་དུས་མ་བུ་དགྲ་གྲོགས་སྦྱར་བའི་འབྲས་བུའི་སྐབས།",
    "དེ་ལྟ་མིན་ཅིང་མ་གྲུབ་པས་ཉེས་པ་འདི་མི་འཕོག་དེ་ཡང་དེ་ལྷག་ཅེས་དམིགས་སུ་བཀར་བའི་འབྲས་བུ་སྲོག་ཀླུང་དང་ལོ་ཟླ་ཞག་དུས་མ་བུ་དགྲ་གྲོགས་ཀྱི་གྲངས་ལས་སྟོན་ཅིང་།",
    "བོན་གཏོའི་རིགས་ནས་གཉེན་པོ་བསྟེན་པ་མང་བ་འདུག་རུང་དོན་ལ་འགལ་བ་ཆེ་བ་རྣམས་ཕུད།",
    "འཛེམ་ཆ་ཚུལ་བཞིན་མེད་པ་མང་ཙམ་ནས་གཞལ་ན་འདི་རང་ཅུང་ཟད་དྲག་པ་འདུག་རུང་།",
    "ཐུགས་ཀྱི་དམ་ཚིག་དུས།",
    "ངོ་ཡང་མི་ཤེས་པའི་མི་རབས་མང་པོའི་རུས་ཚན་གཅིག་པ་ཡིན་ཞེས་ཤིན་ཏུ་འཛེམ་པ་དེ་མཚུངས་བུ་དང་ནུ་བོའི་བག་མ་ཕ་དང་ཇོ་ཇོས་མཐོང་མི་ཐུབ་པ་སོགས་རང་རང་ཡུལ་སྲོལ་བཅས་མཐའ་གཅིག་ཏུ་དཀའ་ཞིང་།",
    "ཁོ་རང་ངོ་བོ་བཅས་བདུན་བརྒྱུད་དུ་གཏོགས་པའི་མི་རིགས་རྩིས་ཁོག་ཏུ་འཇུག་པས་རྟོགས་ཤིང་།",
    "རང་རང་ལས་ནི་བཙལ་བྱ་ཞིང་།",
    "མན་ངག་བུ་ཡིག་ནང་དུ་བསྟན་གནང་བ་བྱིས་པའི་བཙས་ཀླུངས་གོང་དུ་ཚེ་རབས་ལས་རྩིས་སྐབས་རྒྱས་པར་བཀོད་པ་གནང་བས་འདི་ལ་ཐེ་ཚོམ་ཙམ་བྱུང་ལགས་པ་དེ་སྤྲོས་ཟུར་པ་བཞིན་ཡོད་མེད་ལ་སོམ་ཉིར་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་བཅུ་དགུ་པའི་དོགས་ལན།",
    "བརྟག་བྱ་གསུམ་ཇི་ལྟར་ཡིན་དོགས་པ་ཡོང་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་ཉེར་བདུན་པའི་དོགས་ལན།",
    "དེ་ནི་ད་ལྟ་གང་ལ་འདུག་པ་ཡི།",
    "མ་ཡི་སྤར་ཁ་གང་ལ་འདུག་ལས་སྐྱེས།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་འགྱུར་གྱི་གྱེར་གཏོ་ལས།",
    "དེ་དག་ནུས་མེད་རྣམས་གཟུགས་ཅན་གྱི་དམག་ཡོང་སྐད་མི་འདུག་དེས་ན་དགོས་པ་ཁྱད་པར་ཆེ་བས་ནན་དུ་དགོས་ཞེས་གྲགས་པ་དང་།",
    "འགྲོ་བ་རྣམས་ཀྱང་བླང་བློས་ཁེལ་ན་སྤྱི་བྱེ་བྲག་ཏུ་ལྟས་ཆོག་མ་བཀའ་དྲིན་ཚད་བཟུང་དུ་མེད་པར་ཆེ་བ་བྱུང་འདུག་ལགས་པ་ནས་དོགས་གནས་གཞན་མ་མཆིས་པ་ལགས་རུང་།",
    "ལོ་ཟླ་ཞག་དུས་སྲོག་ཁམས་བཞི།",
    "ལོ་ཟླ་ཞག་དུས་བཞི་ཡི་ཁམས།",
    "དང་པོ་ལོ་ཟླ་ཞག་དུས་སྤར་ཁ་དང་།",
    "ལོ་ཟླ་ཞག་དུས་སྲོག་ཁམས་བཞི།",
    "ལོ་ཟླ་ཞག་དུས་བཞི་ཡི་ཁམས།",
    "དང་པོ་ལོ་ཟླ་ཞག་དུས་སྤར་ཁ་དང་།",
    "ལོ་ཟླ་ཞག་དུས་ཀྱི་སྤར་ཁའི་ཁམས་དང་།",
    "དང་པོ་ལོ་ཟླ་ཞག་དུས་སྤར་ཁ་དང་།",
    "ལག་ལེན་སྣ་ཚོགས་ལས་ངེས་པ་འདིའོ་ཞེས་གཏིང་ཚུགས་མི་འདུག་པར།",
    "ཅི་སྟེ་དཔོན་གཙོ་བ་དང་སྦྱར་ནས་བརྩི་བ་སོགས་ལ་དཔྱད་ཡུལ་སོམ་ཉིར་འདུག་པ་འདི་ཇི་ལྟར་ཞུ་རྒྱུ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་སོ་བདུན་པའི་དོགས་ལན།",
    "བགྱིས་པ་དྲིན་དུ་འདུག་ན་ལེགས་ཤིང་།",
    "ལག་ལེན་འདིའོ་ཞེས་འཆད་རྒྱུས་དབུལ་བར་འདུག་པས་དེ་ལྟར་དྲི་བའི་ལན་འདི་ཚེགས་མེད་དུ་བརྗོད་པར་བྱ་སྟེ།",
    "བདག་པོར་གཙོ་ཕལ་གྱི་དབྱེ་བ་ལྟ་བུ་ཡང་དབྱེར་འདུག་པའི།",
    "འདི་ནི་དར་ཆེན་ཐིག་ལེ་ནས་བརྒྱུད་པའི་སྐོར་འགོར་རང་མཆན་དུ་དང་པོ་ལ་དུ་ལོན་གྱེན་འདྲེན་བཀོད་འདུག་པ་ལྟར་དམིགས་བསལ་དུ་ངེས་ཤིང་།",
    "འདིར་ཞིབ་པའི་སྐོར་འགོ་ཞེས་གནང་བ་འདི་བྲན་གཡོག་ལ་ཡིན་པའི་ཤེས་བྱེད་མེད་ན་སོམ་ཉིར་བྱུང་དོགས་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་བཞི་ཅུ་པའི་དོགས་ལན།",
    "རྒྱུད་ས་འདིའི་ལུགས་སོར་བཞག་གོ་ཞེས་ཀྱང་བརྗོད་དཀའ་བའི་གནས་ཙམ་དུ་འདུག་རུང་།",
    "ལེའུ་ཉེར་བརྒྱད་པ་རྟགས་ཕྲན་གྱི་སྐོར་འདི་མ་གཞི་གཤམ་བསྡོམས་སུ་བཀའ་དྲིན་ཆེ་འདུག་པ་ལྟར་ཅུང་ཟད་མི་བཙན་པ་འདྲ་ཞིག་འདུག་རུང་།",
    "ད་ལམ་ཚང་མ་ནས་སྒྲིག་ཁ་དང་མི་འཐད་ངེས་རྣམས་དོར་བ་གནང་བའི་ཤིན་ཏུ་བཀའ་དྲིན་ཆེ་འདུག་ཅིང་།",
    "འདི་ནང་དགུན་ཉིན་གནམ་ལ་ཉི་ཟླ་སྐར་གསུམ་འཛོམས་ཟེར་བ་འདི་རྙིང་པ་ཚོར་ཀྱང་ཡོད་འདུག་ཅིང་།",
    "པ་སངས་ཉི་མ་ལྡོག་དུས་རྐང་པ་འགྱངས་པ་དགོས་པ་འདྲ་ཞིག་དང་།",
    "བོན་རྩིས་སོགས་སྣ་ཚོགས་པ་ཡོང་འདུག་ལགས་པ་ནས་དཔྱད་དཀའ་རུང་།",
    "ཁྱིམ་ཞག་དང་བསྟུན་ན་བཀའ་རྩོམ་འགྲིག་པ་ལྟ་བུ་འདུག་རུང་འདི་ཁྱིམ་ཞག་དང་བསྟུན་པའི་ཤེས་བྱེད་དང་།",
    "ཁྱིམ་ཞག་རྣམ་དག་ཡིན་ཚེ་རིགས་པ་ཞེས་གནང་བ་འདིར་སྐྱོན་གྱི་དོགས་པ་ཙམ་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལལ། བརྒྱ་ཞེ་བཞི་པའི་དོགས་ལན།",
    "ཁྱིམ་ཞག་དང་བསྟུན་ན་བསྟན་བཅོས་འདི་ཉིད་འགྲིག་པ་ལྟ་བུར་འདུག་རུང་འདི་ཁྱིམ་ཞག་དང་ཏུན་པར་ཤེས་བྱེད།",
    "ངན་པ་གནས་སྤར་ཐུབ་པ་སོགས་དགེ་དུ་མ་ཞིག་ཡོད་པ་ཡིན་འདུག་ཀྱང་།",
    "ད་ལྟ་བསྡུས་དོན་ཅུ་གསུམ་མའི་རྩ་བ་བློར་བཟུང་ནས་དེ་ནང་ལྟར་བྱེད་སྲོལ་འདུག་ལེགས་པ་ད་ཆ་བཀའ་རྩོམ་ཚོགས་ཆེས་པས་བློར་བློ་ཐ་མས་མི་ཟིན་ཅིང་།",
    "རྩིས་པས་མ་ནུས་དོགས་པ་ཙམ་ལས་གཞན་མ་འགྲོ་བ་སྤྱི་སྒོས་ཚང་མར་བཀའ་དྲིན་གྱི་དཔལ་དུ་ཆེ་འདུག་ལགས་ཤིང་།",
    "ལུགས་འདིའི་གནས་འདིའོ་ཞེས་བརྗོད་པ་པོ་རྣམ་དག་གཞན་མི་འདུག་པས་ན།",
    "དེ་དག་དྲུག་དང་རང་ལོ་གཉིས།",
    "ཞེས་འདུག་པའི་རྐང་གཅིག་པོ་འདི་ཆད་པར་དོགས་སྐྱོན་བྱུང་ལགས་པ་དང་།",
    "དེ་ལྟར་མིན་ན་དགྲ་དང་འཕྲལ་རྐྱེན་དེར་དམིགས་བཟུང་ཇི་ལྟར་འབྱུང་ལ་དོགས་ངན་འདུག་པ་དང་།",
    "སྦས་བཅད་ཅན་དང་སྦས་བཅད་མེད་པ་གཉིས་ཀར་མི་འདུག་པ་འདིར་ལོ་དང་མི་གྲངས་སྒྲེན་སྐྱོན་ནི།",
    "ལ་ལ་དག་ནི་སྡིག་ཅན་གྱི་རིགས་ལ་འདུར་ཀྱང་ཕན་མེད་ཅེས་དེ་ལ་དགེ་རྩས་ཕན་མེད་གྱི་གཏད་སོར་འདུག་པ་དེ་ཉིད་ནི།",
    "དེ་ནི་གནས་རྡེལ་དཀར་བའི་དཔྱད་དུ་མ་ཟད་འཆི་ལུགས་འདུག་ལུགས་སོགས་ལྷདྲི་བ་བརྒྱ་ལྔ་བཅུ་པ།",
    "ལོ་ཟླ་ཞག་དུས་བཞི་བརྩེགས་ན།",
    "ལོ་ཟླ་ཞག་དུས་ཁམས་སྤར་ཁ་དང་གཅིག་པ་ཡིན་ཚེ་དེ་ཉིད་ཁམས་ལ་མང་བས་གང་གཙོ་ཆེ་བ་དང་།",
    "ལོ་ཟླ་ཞག་དུས་བཞི་བརྩེགས་ན།",
    "ལོ་ཟླ་ཞག་དུས་བྱ་སྤྲེལ་ལ་ཤི་བའི་ལོ་ཟླ་ཞག་དུས་བཞི་སྤར་ཁའི་ཁམས་དང་སྲོག་མཐུན་པར་བརྩེགས་པའི་དོན་ལས་མ་འདས་ཤིང་།",
    "ཁུངས་རྣམ་དག་ཡེ་མི་སྣང་ཞིང་སྒྲུབ་བྱེད་རྣམ་དག་གཞན་ཡང་མི་འདུག་པས་རྟོག་བརྟགས་སོ།",
    "ཞེས་གསུངས་འདུག་པ་དང་།"
  ]
}