    "དངོས་དང་དངོས་མེད་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་སོགས་པའི་དངོས་པོ་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ངེས་གརབ་སཔར་བྲལ་བ་དེའི་ཕྱིར་རྟོག་བཅས་ཀྱི་རྨོངས་པ་ཡོངས་སུ་སྤངས་ནས་མི་རྟོག་པའི་ཡེ་ཤེས་སྐྱེ་བའི་ཐབས་སུ་འགྱུར་རོ།",
    "གཉིས་མེད་ནི་ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པ་དེ་འདམ་རྫབ་ཡ་ཆེན་པོ་དང་མཚུངས་སོ།",
    "མེ་ཏོག་ནི་ལས་ཀྱི་ཕྱག་རྒྱའི་པདྨ་རཀྟ་དང་བཅས་པ་དེ་ཐབས་ཀྱི་རྡོ་རྗེ་རྒྱས་པར་བྱས་པས་ཆུ་སྐྱེས་ཏེ་ལུས་ཀྱི་རྩོལ་བས་བྱང་སེམས་ཀྱི་ཐིག་ལེ་ཕབ་ནས་བདེ་སྟོང་དབྱེར་མེད་ཀྱི་ཉམས་སུ་མྱོང་བ་ཞིག་འབྱུང་ཞེས་པའི་དོན་ཏོ།",
    "དེའི་སྟེང་དུ་ཨ་ལས་ཟླ་བའི་དབུས་སུ་བདུད་རྩིའི་ས་བོན་ཀྵ་བསྒོམས་ནས་ཧ་ཧོ་ཧྲིས་བྱིན་གྱིས་བརླབས་ནས་ཟོས་ན་དངོས་པོ་དང་དངོས་མེད་ཀྱི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བར་འགྱུར་རོ།",
    "གཉིས་ཀ་ལས་ནི་བྱུང་སྐྱེ་བ་ཞེས་པ་ཡབ་ཡུམ་གཉིས་སྙོམས་པར་ཞུགས་པའི་བར་ནས་བྱང་སེམས་བྱུང་བ་དེ་བདུད་རྩིའི་མཆོག་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡི་གེ་གསུམ་པ་ལ་སོགས་པ་ནི་ཨ་བཏུས་པ་སྟེ་ཨ་དེས་བྱང་སེམས་ཡོད་མེད་ཀྱི་མཚམས་སུ་བསྒོམས་པར་བསྲུང་ངོ།",
    "ད་ནི་ལྕགས་ཀྱུ་ལྔ་བཟའ་བ་བསྟན་པའི་ཕྱིར་ཉོན་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རིགས་ལྡན་ནི་རིགས་དང་ལྡན་པར་སྐྱེ་སྟེ་ཟོས་པའི་ཕན་ཡོན་ནོ།",
    "ཤེལ་གྱི་ཚུལ་དུ་སྤྱད་པ་ནི་ཤ་ལྔ་པོ་དག་ཅིང་གཙང་བར་བལྟས་ལ་བཟའ་བའོ།",
    "ཁྱད་པར་དུ་ཚེས་བརྒྱད་ནི་མར་ངོའི་ཉི་ཤུ་གསུམ་ལ་ཤ་ལྔ་བསྒྲུབ་ཅིང་བསྟེན་པའོ།",
    "ད་ནི་ཕྱིའི་ཤ་ལྔ་དང་བདུད་རྩི་ལྔ་སྦྱར་བས་ལས་ཀྱི་ཚོགས་འགྲུབ་པ་བསྟན་པའི་ཕྱིར་དྲི་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐིག་ལེ་ནི་དཔྲལ་བར་ཐིག་ལེ་བྱས་ན་སྐལ་བ་ཅན་དུ་འགྱུར་རོ།",
    "དང་པོ་ཕོ་ཉ་བ་བཞི་བསྒྲུབ་པ་ལ་དྲི་བ་བསྟན་པའི་ཕྱིར་རྣལ་འབྱོར་མ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་འབར་བྱེད་མ་བསྒྲུབ་པའི་ཐབས་བསྟན་པའི་ཕྱིར་ཤིང་གཅིག་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྩོད་པའི་དུས་འདིར་སུམ་འབུམ་བཟླས་དགོས་གསུངས་སོ།",
    "ཉ་སྐམ་པོའི་བདུག་པ་ནི་གསུར་རྒྱུན་མི་ཆད་པར་བཏང་བའོ།",
    "དེ་ལྟར་བཟླས་པ་བྱས་པས་རྟགས་ནི་དང་པོར་སྒྲ་འབྱུང་།",
    "དམ་ཚིག་འདས་ན་བསྲེག་པར་བྱེད།",
    "ཅེས་བརྗོད་ལ་སྦྱིན་པར་བྱའོ།",
    "ཐང་སྐུ་རྡོག་པའི་འོག་ཏུ་བཅུག་ནས་ཨོཾ་ཧཱུྃ་སྭཱ་ཧཱ་ཞེས་བཟླས་ཤིང་འབར་བྱེད་མའི་སྤྱི་བོར་འགེམས་པར་བསྒོམས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "གཞན་ཡང་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་དེས་ཀྱང་མ་གྲུབ་ན་ཟོས་འཐུང་པའི་ཐང་སྐུ་ལྷག་མ་བསྡུས་ལ་ཐབ་ཁུང་གྲུ་གསུམ་པར་བྷ་ལ་ཏ་ཀ་དང་ལུང་ཏང་ཤིང་བརྩེགས་ནས།",
    "ཐང་སྐུའི་དུམ་བུ་གསུམ་བསྲེས་པ་དེ་ལས་མ་གྲུབ་པའི་མཁའ་འགྲོ་མར་བསྐྱེད་ལ་དགུག་གཞུག་བྱས་ནས།",
    "ཨོ་ཧཱུྃ་ཕཊ་ཞེས་བརྒྱ་རྩ་བརྒྱད་དུ་བཟླས་ཤིང་མེའི་དབུས་སུ་བསྲེགས་ན་འགྲུབ་པར་འགྱུར་བ་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "དེ་མ་གྲུབ་པར་བདག་གདན་ལེའུ་གཉིས་པའི་འཆི་རྟགས་བྱུང་ན་ལེའུ་གཉིས་པ་བཞིན་དུ་བསླའོ།",
    "ཕོ་ཉ་བཞི་བསྒྲུབ་པ་གཞན་གདན་ལེའུ་བཞི་པར་བཤད།",
    "སྦྱོར་གདན་ལེའུ་བཞི་པར་མཁའ་འགྲོ་མ་བཞིའི་སྒྲུབ་ཐབས་སྟོན།",
    "སྦྱོར་བགྱི་བ་ནི་རྡོ་རྗེ་དྲིལ་བུ་ལས་བསྒྲུབ་ན་ཇི་ལྟར་བསྒྲུབ་པ་ལགས་ཞེས་དྲིས་པའོ།",
    "རྡོ་རྗེ་ལ་སོགས་པའི་ནི་དེ་ཁོ་ན་ཉིད་བཞིའི་རྟོག་པ་དང་ལྡན་ན་ཡིད་ལ་འདོད་པའི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "བདག་ནི་རྡོ་རྗེ་ལ་ལྷ་སུམ་ཅུའི་བདག་ཉིད་དུ་བྱུང་བ་དེ་ཡང་བདག་ཉིད་ཀྱི་སེམས་ཡིན་ཞེས་པའི་དོན་ཏོ།",
    "རྡོ་རྗེ་ནི་རྡོ་རྗེ་དེ་ལ་སེམས་ཀྱིས་ལྷ་སུམ་ཅུ་བསྒོམས་ནས་ལས་ཐམས་ཅད་བྱ་བར་བྱའོ།",
    "རྡོ་རྗེ་དག་པ་ནི་རྡོ་རྗེ་དེ་ལྷ་སུམ་ཅུར་རྣམ་པར་དག་པས་སོ།",
    "བརྟན་པ་ནི་དེ་ལ་ཀྱི་སེམས་བརྟན་པར་བསྒོམས་ནའོ།",
    "རྡོ་རྗེ་འགུགས་པ་ནི་རྡོ་རྗེའི་རྟོགས་པ་དང་ལྡན་པས་རྡོ་རྗེ་གསོར་ན་དངོས་གྲུབ་ཐམས་ཅད་འགུགས་པར་བྱེད་པས་སོ།",
    "ཡང་རྡོ་རྗེ་དེས་མ་རིག་པའི་མུན་པ་ཐམས་ཅད་ཟག་པ་མེད་པའི་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེ་དེས་བཅོམ་ནས་རྣམ་པར་ཤེས་པ་དང་བཅས་པའི་རྡོ་རྗེའི་སྒྲོན་མས་ཕྱོགས་བཅུ་ཐམས་ཅད་སྣང་བ་གསལ་བར་འགྱུར་རོ།",
    "རྡོ་རྗེ་པདྨར་གནས་བྱས་ཏེ་ཞེས་པ་ནི་ལག་པ་གཡས་པ་ཐབས་ཀྱི་རང་བཞིན་ལ་པདྨ་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་དེ་བསྒོམས་པའི་མཁས་དབུས་སུ་རྡོ་རྗེ་ཐབས་ཀྱི་རང་བཞིན་ཞིག་བླངས་པས་ཐབས་ཤེས་རབ་དབྱེར་མེད་དུ་བྱ་བའོ།",
    "རྡོ་རྗེ་པདྨ་ནི་ལག་པ་ཐབས་ཤེས་རབ་དབྱེར་མེད་དུ་བྱས་པས་སོ།",
    "ཕྱོགས་བཅུའི་གནས་ནི་ཤར་ལ་སོགས་པ་ཕྱོགས་བཞི་མཚམས་བཞི་སྟེང་འོག་གཉིས་ཏེ་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་མཐའ་ཡས་མུ་མེད་པ་དེ་རྣམས་སུ་སྒྲ་དེ་ཐོས་པར་བསྒོམས་ལ་དཀྲོལ་ལོ།",
    "ནམ་མཁའི་དཀྱིལ་ནི་ནང་སྟོང་པར་གནས་པའི་དབུས་སུ་ཡུ་བའི་གཟུགས་དེ་བྱུང་ཞེས་པའོ།",
    "ཕྱོགས་བརྒྱད་དུ་དཀྲོལ་བ་ནི་དྲིལ་བུའི་ལྕེ་དེས་ཁ་ཁྱེར་གྱི་ཕྱོགས་བརྒྱད་དུ་ཕོག་པར་བྱས་ལ་དཀྲོལ་ཞེས་པའོ།",
    "ཤེས་རབ་ཐབས་བྱེད་ནི་ཐབས་ཤེས་རབ་གཉིས་སུ་མེད་པར་བྱེད་པས་སོ།",
    "ཐབས་དང་ཤེས་རབ་རྟོགས་པར་བྱ་ཞེས་པ་ནི་ལག་པ་གཡས་པ་པདྨར་བསྒོམས་ལ་རྡོ་རྗེ་བླང་བ་དང་ལག་པ་གཡོན་པ་རྡོ་རྗེར་བསྒོམས་ནས་དྲིལ་བུ་བླང་བ་སྟེ་ཐབས་ཤེས་རབ་དབྱེར་མེད་དུ་རྟོགས་པར་བྱ་ཞེས་པའོ།",
    "དེ་ཉིད་མེད་པ་ནི་ཐབས་ཤེས་རབ་ཀྱི་རྟོགས་པ་མེད་པར་དྲིལ་བུ་འཛིན་པ་དེ་གླང་པོའི་སྐེ་ལ་དྲིལ་བུ་བཏགས་པའི་སྒྲ་དང་མཚུངས་ཏེ་དངོས་གྲུབ་རིང་དུ་བསྟན་པ་ཡིན་ནོ།",
    "དྲི་ལ་སོགས་པ་ནི་ཙན་དན་དང་ག་པུར་དང་གླ་རྩི་ལ་སོགས་པའི་རི་ལུའམ་མཚོན་ཆའི་དབྱིབས་བྱས་པའོ།",
    "གཡོན་པ་པདྨ་འདབ་མ་ལྔ་པར་བསྒོམས་ལ་ལག་པ་གཉིས་ཁ་སྦྱར་ལ།",
    "དེ་ཉིད་དམིགས་པ་ནི་རྡོ་རྗེ་དང་དྲིལ་བུ་དང་བགྲང་ཕྲེང་ལ་ལྷའི་སྐུ་དམིགས་ནས་ལས་ཐམས་ཅད་པའི་ཀུན་འགྲུབ་པར་བྱེད་པས་སོ།",
    "ཁྱད་པར་ཡེ་ཤེས་ནི་ཐམས་ཅད་ཡེ་ཤེས་ཡིན་ཡང་ཡེ་ཤེས་ཀྱི་སྐྱེ་ལུགས་སོ་སོར་གནས་པས་སོ།",
