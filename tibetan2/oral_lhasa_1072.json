    "སྐྱེས་པ་གཞན་ཚོལ་ཞིང་ངན་གཡོ་བྱེད་པ་དེ་ལས་འདི་ལྟར་ལས་ནི་བསྒྲུབ་པར་བྱའོ།",
    "འོ་མས་དཀྲུས་ནས་སོས་པར་འགྱུར་རོ།",
    "ད་ནི་རྡོ་རྗེ་མཁའ་འགྲོ་མས་ཆུང་མ་གཡོ་ཅན་གྱི་བྷ་ག་གཟིར་བའི་ལས་གསུངས་པ།",
    "ཤིན་ཏུ་མཛེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཐམས་ཅད་གནས་ནི་སྤྱི་བོ་ལ་སོགས་པ་ནས་འཛག་པར་འགྱུར་རོ།",
    "ཚ་བ་གསུམ་བསྲེས་ལ་བྱ་རོག་སྒྲོའི་སྤྱི་གུས་ཁམས་ཕོར་གཉིས་ལ་ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་གཉིས་ཀྱི་གཟུགས་དང་མིང་རུས་བྲི།",
    "དེ་ནས་གཟུགས་ལ་བསྒྲུབ་བྱ་བསྐྱེད་ནས་རང་ཡེ་ཤེས་མཁའ་འགྲོ་མར་བསྒོམས་ལ་ཡུངས་ཀར་ལ་སྔགས་བཟླས་པས་ཁྲོ་བོ་མཚོན་ཆ་ཐོགས་པར་བསྒོམ་ཞིང་།",
    "སྔགས་ནི་ཨོ་ཏ་ནི་ཀྲོ་དྷ་མུ་ཕྱེ་དེ་བ་དད་ཏ་པཱ་ཙ་ཏྲད་པ་ལི་ལི་ལི་བཛྲ་ཏིཔ་མུ་ཁེ་༦་ཕྲ་ཕོ་ཕ་ཕཊ་ཅེས་པ་ལ་ལས་སྦྱོར་གྱི་དུས་སུ་བརྒྱ་ཐམ་པ་བཟླས་པས་མྱུར་དུ་འཐབ་པར་འགྱུར་རོ།",
    "སྦྱོར་བའི་གདན་གྱི་སྦྱོར་བའི་གདན་རྣམ་པར་ཕྱེ་བའི་ལེའུ་གསུམ་པའོ།",
    "ད་ནི་སྦྱོར་བའི་གདན་གྱི་གསང་བའི་གདན་ལ་གཉིས་ལས་དང་པོ་དྲི་བ་བསྟན་པའི་ཕྱིར་གཉིས་མེད་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་དྲུག་ལས་རྡོ་རྗེ་དྲིལ་བུའི་རྣམ་དག་གནས་དང་བཅས་པ་བསྟན་པའི་ཕྱིར་ཉོན་ཅིག་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཉོན་ཅིག་ནི་རྣ་གཏད་པར་བསྐུལ་བའི་ཚིག་གོ།",
    "ཆགས་པ་དང་བྲལ་བས་བསྐྱེད་རྫོགས་བསྒོམས་པའི་ཐུན་མཚམས་སུ་ཁམས་རྟས་པར་བྱ་བའི་དོན་དུ་ཕྱག་རྒྱ་མ་བསྟེན་ནོ།",
    "ཕྱག་རྒྱ་ཁ་སྦྱོར་ནི་ཐབས་ཤེས་རབ་ཀྱི་སྙོམས་པར་ཞུགས་པ་བྱ་བའོ།",
    "ཐབས་ཀྱི་རྡོ་རྗེ་ཐིམ་པར་གྱུར་ཞེས་པའོ།",
    "བདག་ཏུ་འཛིན་པར་བྱེད་པའི་ཤེས་པའི་བདེ་བ་དེ་ལ་རྣམ་པར་རྟོག་པ་ལས་གྲོལ་བའི་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཀྱི་སྦྱིན་པའི་ར་བ་བྱ་བའོ།",
    "སྦྱིན་བྱ་སྟེ་ཞེས་པ་ནི་དངོས་པོ་རྣམས་སུ་འཛིན་པར་བྱེད་པ་དེ་ཡང་སྟོང་པ་ཉིད་དུ་སྦྱིན་པའོ།",
    "རྒྱས་མ་ཐེབས་ན་སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པར་མི་འགྲོའོ།",
    "སྦྱིན་པའི་ར་བ་གསུམ་གྱིས་བར་དུ་གཅོད་པར་བྱེད་པའི་བདུད་དང་གནོད་པ་ཐམས་ཅད་བསྐྲད་ཅིང་བསྲུང་པར་བྱ་བའོ།",
    "དེས་ན་རང་སེམས་ནི་བསྡམ་པར་བྱ་སྟེ་སེམས་ཉིད་སྤྲོས་མེད་ཀུ།",
    "ཨབས་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཀྱི་ཉམས་སུ་མྱོང་བ་དེས་སེམས་བསྡམ་པར་བྱའོ།",
    "སེམས་ཉིད་ཟག་པ་མེད་པའི་ཡེ་ཤེས་སུ་གྱུར་པ་དེའི་ཚེ་བདུད་ཀྱིས་གཙེ་བར་ག་ལ་འགྱུར་ཏེ་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་དེ་ཉིད་བདུད་ཡིན་པས་སོ།",
    "འོ་ན་གསང་སྔགས་ཀྱི་བྱ་བའི་རྒྱུད་ལ་སོགས་པར་ཕྱི་རོལ་དུ་མཎྜལ་བྱསཏེ་དྲི་བྱུག་པ་དང་།",
    "དེ་ཡང་དྲི་དང་བའི་རྣམ་ལྔ་སོགས་པས་མཎྜལ་གྲུ་བཞི་རུ་བྱུག་པ་བཞིན་དུ་ཟག་མེད་ཀྱི་ཉམས་སུ་མྱོང་བ་དེས་བདག་དང་དངོས་པོ་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་རྟོགས་པའི་སེམས་ཀྱི་དྲི་དེ་ཡིས་ཕྱོགས་ཐམས་ཅད་དུ་མཉམ་པར་བྱུག་པར་བྱའོ།",
    "མར་མེ་ནི་མར་མེའི་འོད་ཀྱིས་མུན་པ་བཅོམ་ནས་རྫས་ཀྱི་དངོས་པོ་ལ་སོགས་པ་གསལ་བ་བཞིན་དུ་ཟག་མེད་ཀྱི་ཉམས་སུ་མྱོང་བའི་ཤེས་རབ་ཀྱི་མར་མེ་དེ་ཡིས་ཁམས་གསུམ་ཀུན་གྱི་རྣམ་པར་རྟོག་པའི་མུན་པ་ཐམས་ཅད་བཅོམ་ནས་རང་དགར་ལམ་སྟེ་དངོས་པོ་གཤིས་ཀྱི་དོན་དེ་ཚེགས་མེད་པར་གསལ་བར་འགྱུར་རོ།",
    "གཏོར་མའི་དུས་ནི་ཕྱིའི་གཏོར་མས་ཚིམ་པར་བྱེད་པ་བཞིན་དུ་ཟག་མེད་ཀྱི་ཉམས་མྱོང་དེས་ཀྱང་སེམས་ཚིམ་པར་བྱེད་དོ།",
    "དེ་ལྟར་ཉམས་མྱོང་དུ་སྐྱེད་པར་བྱེད་པའི་ཕྱག་རྒྱ་མ་བསྟེན་པར་བྱེད་པའི་གནས་ནི་ཡིད་དང་འཐད་པ་སྟེ།",
    "མཉམ་པར་བལྟ་བ་ནི་ཕྱག་རྒྱ་མས་ཐབས་ལ་བལྟ་བ་དང་།",
    "དེ་ནས་ལས་རྒྱའི་བྷ་ག་ལ་ཐབས་ཀྱི་རྡོ་རྗེ་དེ་བཙུགས་ནས་ཐབས་ཤེས་རབ་ཕན་ཚུན་དུ་གཉིས་ཀས་འཁྱུད་ནས་མགོ་ཤར་ཕྱོགས་ལ་སོགས་པར་བསྟན་ལ་སྙོམས་པར་འཇུག་པ་བྱའོ།",
    "པ་༡ མ་ད་ནི་ཀ་ར་ནའི་སྦྱོར་བ་ལ་གཉིས་ལས་ཤེས་རབ་གཙོ་བོར་གྱུར་པར་བསྟན་པའི་ཕྱིར་དྲིལ་བུ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསམ་པ་དག་ན་ཡང་བྱ་ཞེས་པ་ནི་གོ་ཆའི་ཡི་གེ་ཡང་དང་ཡང་དུ་དྲན་པར་བྱའོ།",
    "ཤེས་རབ་མས་དེ་ལས་གོ་བཟློག་སྟེ་ཡི་དྭགས་མེ་ཞེས་པ་ལག་པ་གཡོན་པར་སྔོན་དུ་འཁྱུད་ལ།",
    "ཕྱག་རྒྱ་གཉིས་ཀ་ནི་ཐབས་དང་ལས་རྒྱའི་ལག་པ་གཉིས་ཀས་ཕྱག་རྒྱ་དེ་དང་བཅས་ལ་གློ་སྟེ་སྐེད་པར་འཁྱུད་ནས་བསྡམས་པའོ།",
    "སེམས་ནི་ཀུན་རྫོབ་ལ་བརྟེན་པའི་དོན་དམ་ལྷན་ཅིག་བསྐྱེད་པའི་ཉམས་བསྐྱེད་པར་འདོད་པས་སོ།",
    "ཆུ་འདྲ་ཞེས་པ་ནི་སྙོམས་འཇུག་བྱས་པའི་བྱང་སེམས་ཀྱི་རྣམ་པའོ།",
    "ཚུལ་དག་ནི་རྩ་སད་པར་བྱ་བའི་དོན་དུ་བར་བར་དུ་རྩ་བསླང་བ་སྟེ།",
    "ཡེ་ཤེས་ས་བོན་ནི་ཤེས་རབ་ཀྱིས་ༀཨ་སྭཱ་ཧཱ་བཟླས་པར་བྱའོ།",
    "རྡོ་རྗེ་དྲིལ་བུའི་ཐབས་ཤེས་རབ་ཀྱི་སྙོམས་པར་འཇུག་པའི་རབ་ཏུ་སྦྱར་བའི་ཀུན་རྫོབ་ཀྱི་སེམས་ལ་བརྟེན་ནས་ཕྱག་རྒྱ་སྟེ།",
    "རང་སེམས་སྙོམས་པར་འཇུག་པའི་ཐིག་ལེ་དཀར་དམར་རོ།",
    "དེ་ནི་སྐྱེས་པས་གྲོགས་བྱས་ཏེ་ཕྱག་རྒྱ་མ་ས་ཡ་པ་ཀ་ལ།",
