    "གྲངས་ཅན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་མཉམ་པར་གནས་པ་ཐོབ་པས་ཡང་ཡོན་ཏན་འདི་རྣམས་འགྲོ་བས་བརྗོད་ལ།",
    "སྣ་ཚོགས་ཤིང་རྣམ་པ་སྣ་ཚོགས་པར་ཡོངས་སུ་གྱུར་པ་བརྗོད་དོ།",
    "བཅུ་དྲུག་པོ་ནི་རྣམ་པར་འགྱུར་བ་སྟེ།",
    "གཙོ་བོ་དེ་ཡང་འབྲས་བུ་མ་ལུས་པ་ནུས་པའི་རང་བཞིན་ཉིད་ཡོན་ཏན་གསུམ་གྱི་རང་བཞིན་ཁོ་ནས་འབྲས་བུ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གཞན་དུ་ན་ཇི་ལྟར་དེ་ལ་ཡོད་པ་མ་ཡིན་པ་འབྲས་བུ་སྣ་ཚོགས་པའི་གཟུགས་སྐྱེད་པར་བྱེད།",
    "འབྲས་བུའི་ཁྱད་པར་འཇུག་པ་ནི།",
    "དེ་ཉིད་བྱེད་པར་ནུས་ཡིན་ཏེ།",
    "འདི་ལྟར་གཙོ་བོ་ལ་ངེས་པ་ཁོ་ནར་འབྲས་བུའི་གཟུགས་ཀྱིས་འགྲོ་བ་འཇུག་པ་དང་ལྡོག་པར་བྱེད་དོ་ཞེས་སེར་སྐྱ་ཟེར་རོ།",
    "གཅིག་ལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡོན་ཏན་མེད་ན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སེམས་མེད་ཅེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཇི་ལྟར་ན་དེ་ལ་བདེ་བ་ལ་སོགས་པར་འགྱུར་བ་ཡིན།",
    "འོན་ཀྱང་བདེ་བ་ལ་སོགས་པ་དེ་ལས་སྐྱེས་པར་དོགས་ནས་དེ་དངོས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུའི་ངོ་བོ་ནི་བྱེད་པ་པོའི་རང་བཞིན་ཕྱི་རོལ་དུ་གྱུར་པ་ཡིན་པར་སྣམ་བུ་ལ་སོགས་པ་ཡང་གལ་ཏེ་འདོད་ནའོ།",
    "འདི་ལྟར་དངོས་པོ་རྣམ་པར་དཔྱད་ཅིང་བརྟགས་པ་ན་རིགས་པས་དངོས་པོ་སྣང་བ་རྣམས་ཀྱང་སྒྱུ་མ་ལྟ་བུ་ཡིན་ཏེ།",
    "བདེ་སོགས་ཡིན་ཏེ་སོགས་པའི་སྒྲས་སྡུག་བསྔལ་ལ་སོགས་པར་འགྱུར་རོ།",
    "བདེ་བ་ལ་སོགས་པར་མི་འགྱུར་རོ།",
    "བདེ་སོགས་ཀྱང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྣམས་རྟག་པ་ལ་སོགས་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་བདེ་བ་ལ་སོགས་པ་རྣམས་རྟག་པར་གྱུར་ན་དེའི་ཚེ་རྟག་ཏུ་དམིགས་པར་འགྱུར་རོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེའི་ཚེ་ཇི་ལྟར་ནམ་ཞིག་བདེ་བའི་རང་བཞིན་ཡིན་པ་དེ་བཞིན་དུ་ནམ་ཡང་ཞེས་པ་ནི་རྟག་ཏུ་དེ་རིགས་པར་འགྱུར་ཏེ།",
    "རགས་པ་དོར་ནས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅིའི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་མེད་པ་ཉིད་ཀྱི་འཇིག་པར་ཁས་མི་ལེན།",
    "དེ་ལྟ་བས་ན་ངེས་པར་དེ་དག་རྗེས་སུ་འགྲོ་བ་མེད་པར་འཇིགས་པ་ཡང་དག་པར་སྐྱེ་བ་ཉིད་དུ་ཁས་བླང་བར་བྱའོ།",
    "དེ་ལྟར་ན་ཡང་དེ་དག་འདི་ལྟར་གྱུར་པ་ན་དེ་བཞིན་དུ་གཞན་ཡང་ཁྱད་པར་མེད་པའི་ཕྱིར་འགྱུར་བ་ཡིན་ནོ།",
    "འདི་ལྟར་ཡང་རགས་པ་དེ་བདེ་བ་ལ་ཐ་དད་པའམ་ཐ་མི་དད་པར་འགྱུར།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་དེ་ལྟར་གྱུར་ན་ཡང་གལ་ཏེ་རྣམ་པ་ཐམས་ཅད་དུ་ཞིག་པར་འགྱུར་ན།",
    "གཏན་མེད་པ་ནི་ནམ་མཁའི་ཨུཏྤལ་བཞིན་དུ་སྐྱེ་བར་མི་རིགས་པའི་ཕྱིར་རོ་ཞེས་གཞན་གྱི་འདོད་པར་དགོད་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་གལ་ཏེ་གཞན་ཡང་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "འདི་ལྟར་གལ་ཏེ་འདོད་ན་དེའི་ཚེ་འདི་བརྗོད་པར་མི་བྱའོ་ཞེས་གསལ་བར་ཞེས་པ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གལ་ཏེ་རྒྱུ་ལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཟས་ཟ་བ་པོ་མི་གཙང་བར་འགྱུར་ཏེ།",
    "འདི་ལྟར་ཡོད་པར་སྨྲ་བ་ལ་ཡང་ཟས་ཀྱི་འབྲས་བུ་མི་གཙང་བ་ཉིད་ཡིན་ན་དེ་ཡང་ཟས་ཀྱི་གནས་སྐབས་ཉིད་ན་ཡོད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཟས་ཟ་བས་ན་དེ་ཟ་བའི་དོགས་པར་འགྱུར་རོ།",
    "རས་ཀྱི་རིན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཏེ་དེ་ལྟར་ན་གལ་ཏེ་དོན་དམ་པར་རྒྱུ་ལ་འབྲས་བུ་ཡོད་པ་དེ་ལྟར་ན་ཡང་འདི་ཀུན་རྫོབ་ཏུ་མ་རིག་པའི་རབ་རིབ་ཀྱིས་ཡེ་ཤེས་ཀྱི་མིག་ཉམས་པར་བྱས་པའི་ཐ་སྙད་པའི་འཇིག་རྟེན་པས་འདི་མི་མཐོང་བ་ཡིན་ནོ་ཞེས་འཇིག་རྟེན་རྨོངས་པས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་རིགས་པའི་གྲངས་ཅན་དེ་ཡང་ཡོད་པ་ཡིན་ཏེ།",
    "རས་དོན་དུ་གཉེར་བས་རས་བལ་གྱི་ས་བོན་བསྙོན་པར་བྱ་བ་མ་མཐོང་བ་ཡིན་ནོ།",
    "འདི་ནི་འདི་ལན་དུ་རིགས་པ་མ་ཡིན་ནོ་ཞེས་འཇིག་རྟེན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་དངོས་པོའི་དེ་ཁོ་ན་ཉིད་ཀྱིས་རྣམ་པར་གཞག་པ་ཐོབ་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ཡོངས་སུ་གནས་པ་ལ་སེར་སྐྱ་གྲུབ་པའི་མཐའ་སྨྲ་བ་ཡང་ཉེས་པ་མཚུངས་པར་རྒོལ་བས།",
    "དེ་གཞལ་བརྫུན་པར་མི་འགྱུར་རམ།",
    "བརྟགས་པའི་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བུམ་པ་ལ་རྣམ་པར་དཔྱད་པས་འཇིག་རྟེན་ལ་གྲགས་པ་ཉིད།",
    "དེའི་ཕྱིར་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ངེས་པར་བརྫུན་ཞིང་བདེན་པ་མ་ཡིན་པ་ཡིན་ཏེ།",
    "དེས་ན་རྨི་ལམ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞིག་པ་ན་བུ་མེད་དོ་ཞེས་པའི་རྣམ་པར་རྟོག་པ་ནི་དེ་མེད་པའི་རྣམ་པར་རྟོག་པའོ།",
    "དེའི་རྣམ་པར་རྟོག་པ་ནི་སྒྲོ་འདོགས་པ་ཡིན་ཏེ།",
    "འགེགས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ཡོད་པར་རྟོག་པ་འགེགས་པ་ཡང་བརྫུན་ཡིན་ལ།",
    "འདི་བརྗོད་པར་འགྱུར་ཏེ།",
    "དཔེར་ན་རྨི་ལམ་ནི་མཐོང་བའི་དངོས་པོ་མ་སྐྱེས་པ་དང་མ་འགགས་པ་རྟོག་པས་ཉེ་བར་བསྟན་པའི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་རྣམ་པར་རྟོག་པས་ཐ་སྙད་ཀྱི་ཡུལ་དུ་ཉེ་བར་གྱུར་པ་རབ་ཏུ་སྣང་ལ།",
