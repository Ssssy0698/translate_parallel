    "དེ་ལྟ་བས་ན་རྒྱུ་ཅུང་ཟད་ཀྱང་མེད་པར་འགྲོ་བ་འདི་ཐམས་ཅད་རྣམ་པ་སྣ་ཚོགས་པར་སྐྱེའོ་ཞེས་པ་ནི་དེ་རྣམས་ཀྱི་ལུགས་སོ།",
    "དེ་ལ་འདི་ལྟར་སྨྲ་བ་ལ་ནི་འཇིག་རྟེན་གྱི་རྟོག་པ་ཉིད་ཀྱིས་རྒྱུ་ལ་ནུས་པ་མེད་པ་ཉིད་ལ་གནོད་པར་འགྱུར་རོ་ཞེས་སྟོན་ཏེ།",
    "ལྡོག་པའི་བྱེད་པ་ཡང་འབྲས་བུ་སྐྱེད་པར་མཐོང་ལ།",
    "དེ་མེད་ན་མེད་པར་རྟོགས་པ་དེ་ནི་དེའི་རྒྱུ་ཡིན་ནོ་ཞེས་ངེས་པ་ཡིན་ནོ།",
    "པདྨའི་སྡོང་པོ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་རྒྱུ་སོ་སོར་ངེས་པ་ཉིད་ལས་ཁྱད་པར་སོ་སོར་ངེས་པར་སྐྱེ་བ་ཡིན་ཏེ།",
    "ཅི་སྟེ་གལ་ཏེ་རྒྱུ་ཉིད་ལ་རང་ཉིད་ཀྱི་ཁྱད་པར་འདི་གྲུབ་པ་ཡིན་ལ།",
    "འོན་ཀྱང་དེ་ཉིད་གང་ལས་སྲིད་པར་འགྱུར་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "ཁྱད་པར་མེད་པ་ལས་ཁྱད་པར་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "རྒྱུའི་དབྱེ་བས་བྱས་ཤེས་ན།",
    "དེ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་དབྱེ་བ་ལས་ཏེ།",
    "ཁྱད་པར་གྱི་དབྱེ་བ་ལས་སོ།",
    "དེའི་ཡང་རྒྱུ་སྔ་མ་གང་ལས་ཁྱད་པར་དུ་འགྱུར་ཞེ་ན།",
    "དེ་ལ་ཡང་སླར་རྒྱུའི་ཁྱད་པར་ལས་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ཕྱི་མ་ཕྱི་མའི་ཁྱད་པར་འདོད་པ་རྣམས་ལ་སྔ་མ་སྔ་མའི་ཁྱད་པར་ལས་ཞེས་ལན་བརྗོད་པར་བྱ་ལ།",
    "རྒྱུ་གང་ལས་འབྲས་བུ་སྐྱེད་པའི་ཁྱད་པར་འབྲས་བུ་འབྱིན་པའི་མཐུ་སྟེ་རྒྱུ་ཡིན་ཞེ་ན།",
    "སྔར་གྱི་དེ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་ལས་ཏེ།",
    "དེ་ལྟ་བུའི་རྣམ་པ་ཉིད་ཀྱིས་འབྲས་བུ་སྐྱེད་པར་བྱེད་དོ།",
    "འདི་ཡང་ངེས་པར་རང་བཞིན་དུ་སྨྲ་བ་རྒྱུ་དང་བཅས་པར་མི་འདོད་ན་ཡང་ཁས་བླང་བར་བྱ་བ་སྟེ།",
    "དེའི་ཕྱིར་ངོས་གཉིས་ཀྱིས་ཐག་པའི་ཞགས་པ་བཞིན་དུ་དོགས་པར་སྡུག་པ་འདི་ཆུད་པ་ཡིན་ནོ།",
    "རྒྱུ་ནི་མེད་ཅེས་བརྗོད་པ་གཏན་ཚིགས་དང་ལྡན་པར།",
    "ཞེས་གསུངས་སོ།",
    "ཁྱད་པར་བརྗོད་པའི་ཆེད་དུ་ཁྱེད་རྣམས་ཀྱིས་གྲོགས་ཉིད་བྱས་པ་ཡིན་ཏེ་ཞེས་སྨྲས་ཏེ།",
    "སྣ་ཚོགས་རྒྱུ་ཡིན་ལ་འབྱིན་པ་དང་གནས་པ་དང་འཇིག་པར་བྱེད་པའི་རྒྱུ་ཡིན་ནོ།",
    "སེམས་དང་ལྡན་པས་བྱིན་གྱིས་བརླབས་པ་ལས་སླར་ཡང་འདི་རྣམས་སྐྱེད་པར་ནུས་པ་ཡིན་ཏེ།",
    "དེའི་བྱེད་པ་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་འབད་པས་གྲོགས་ཉིད་དུ་དེ་ལ་རྟོག་པར་བྱེད་ན།",
    "འོན་ཏེ་བྱས་པའི་ལས་ཆུད་ཟོས་པར་འགྱུར་བའི་ཕྱིར་ངེས་པ་དེས་དེའི་འབྲས་བུ་མྱོང་བར་བྱ་ཞེས་དེ་ལོངས་སྤྱོད་པའི་ཆེད་དུ་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཡང་འདི་ལ་བྱ་བ་མི་བྱེད་ན་ངེས་པར་དེས་ཇི་ལྟར་ཉམས་སུ་མྱོང་བར་བྱ་སྟེ།",
    "དེས་ན་ལྷུར་ལས་ཉིད་རྟེན་པར་གྱིས་ཤིག།",
    "ཞེས་པས་བསྟན་པར་བྱའོ།",
    "སྡུག་བསྔལ་བ་ཅིའི་ཕྱིར་སྐྱེད་པར་བྱེད་ཅེས་བརྗོད་པར་བྱའོ།",
    "རོལ་པའི་དོན་དུ་འདོད་ཆགས་དང་བྲལ་བ་འཇུག་པས་འདི་ངེས་པར་འདོད་ཆགས་དང་བྲལ་བ་ཡིན་ཏེ།",
    "ཆགས་པ་དང་བྲལ་བ་འདི་ཅིའི་ཕྱིར་ཡང་འཇུག་པར་འགྱུར།",
    "གལ་ཏེ་རང་བཞིན་དུ་གནས་པ་ཡིན་ན་ཅིའི་ཕྱིར་འགྲོ་བ་དོན་མེད་པར་སྡུག་བསྔལ་བར་བྱེད།",
    "རང་བཞིན་དུ་གནས་པ་ནི་གནོད་པར་བྱེད་པ་མེད་པར་སྐྱེ་བོ་སྡུག་བསྔལ་བར་བྱེད་པ་མ་མཐོང་ངོ།",
    "འོན་ཏེ་ལོག་པའི་ལམ་དུ་འགྲོ་བ་ཉིད་དུ་གནོད་པ་བྱས་ཀྱང་གདུང་བར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་རྣམས་ཀྱི་རང་ཉིད་ཀྱིས་ཉེས་པ་བྱས་པ་ཉིད་ཀྱིས་ཉེས་པ་པོ་ལ་ཆད་པའི་ལས་བྱེད་དོ།",
    "སླར་ཡང་འདི་ནི་རང་ཉིད་ཀྱིས་བྱེད་དུ་བཅུག་པས་ན་ཁྱད་པར་ཆེའོ།",
    "འདི་ལྟར་ཡང་མཐོ་རིས་ལ་སོགས་པའི་འབྲས་བུ་འདོད་པས་རྟོགས་པ་དང་ལྡན་པ་རྣམས་རབ་ཏུ་འཇུག་པར་བྱེད་དེ།",
    "གཞན་དུ་ན་དེ་བསྟེན་པ་ལ་ཇི་ལྟར་འཇུག་པར་འགྱུར།",
    "དེ་ལ་སྨྱོན་པ་གཞན་གྱིས་ཉེས་པ་ཅི་ཞིག་བྱས་ཏེ།",
    "དེ་རྣམས་ནི་ནུས་པ་ཁྱད་པར་ཅན་དང་བྲལ་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྐབས་སུ་བབ་པ་ལ་ཡང་ཁྱད་པར་དུ་གྱུར་པའི་ནུས་པ་མཐོང་བ་ཡང་མ་ཡིན་ནོ།",
    "འགྲོ་བ་ཐམས་ཅད་ཁྱད་པར་དུ་ནུས་པའི་སྨྱོན་པ་ཞེས་པ་ནི་སྨྱོན་པ་ལས་གཞན་གྱིས་སྨྲ་བར་རིགས་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་འདི་ཤིན་ཏུ་རྣམ་པར་དཔྱད་པ་ན་འགའ་ཞིག་ཏུ་གནས་པའི་རྙེད་པ་མ་ཡིན་ནོ།",
    "དེ་བས་ན་བློ་གྲོས་ངན་པ་རྣམ་པར་གཡོ་བ་ལ་གུས་པས་ཅི་ཞིག་བྱ་སྟེ།",
    "དེ་ལྟ་བས་ན་འདི་ལེགས་པར་དཔྱད་པ་ཡིན་ནོ།",
    "བྱེད་པར་འགྱུར་ཞེས་ང་རྒྱལ་དོན་མེད་ཡིན།",
    "འདི་ཉིད་རྒྱས་པར་བསྟན་པའི་ཕྱིར།",
    "མ་དམིགས་པའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་བྱ་བ་དང་ལྡན་པའི་རྒྱུ་རུ་བརྟགས་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་དེ་ཉིད་འདོད་པས་མཐོང་བའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་ཁྱད་པར་ཉིད་ཁས་བླང་བར་བྱའོ།",
    "དེ་ཇི་ལྟར་ན་དེའི་འབྲས་བུ་ལ་མཁོ་བ་རྣམ་པར་གཞག།",
    "རྒྱུ་རྣམས་ཐུག་པ་མེད་པར་འགྱུར།",
    "འདི་ལ་ཁོ་བོ་ལོག་པར་རྟོགས་པ་མ་ཡིན་ནོ།",
