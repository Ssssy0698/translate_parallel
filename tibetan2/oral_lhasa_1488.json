    "གཞུང་ལུགས་ཆེན་པོ་མཐའ་དག་ཐོས་བསམ་གྱིས་གཏན་ལ་འབེབས་པ་ལ་ཡང་རིགས་པའི་ལམ་རྣམ་པར་དག་པ་ཅིག་ཤེས་དགོས་པས་ཐོག་མར།",
    "རིག་པའི་སྒོ་འབྱེད་བསྡུས་གྲྭ་དང་བློ་རྟགས་སོགས་ལ་ལེགས་པར་སྦྱངས་དགོས་སོ།",
    "ཁོ་འདི་ཟེར་སྣང་འདི་ཟེར་གྱི་གཤག་པ་འགྱེད་པ་ཙམ་དང་།",
    "ཁྱད་པར་དུ་གྲྭ་ས་གྲྭ་ཚང་ཁམས་ཚན་མི་ཚན་སོགས་ཀྱི་ཕྱོགས་རིས་འཐེན་ཁྱེར་སོགས་ལ་ཞེ་གཏོགས་བྱས་ཚེ།",
    "ཁྱད་པར་རྒྱལ་པོའི་གནོད་པ་ཤིན་ཏུ་མང་བས།",
    "གོ་བ་ཅན་གཞན་ལ་དྲི་གཏུགས་བྱས་ཏེ།",
    "དེ་ལྟར་ཐོས་བསམ་ཚད་ལྡན་བྱས་རྗེས་ཧ་ཅང་ཚིག་ལ་ཞེན་ནས།",
    "དེ་ཡང་ཁྲིད་གནང་མཁན་དང་ཉན་མཁན་གཉིས་ཀས།",
    "ཕྲག་དོག་བརྙས་བཅོས་སོགས་གཏན་ནས་མི་བྱེད་པར།",
    "ཚོགས་ཀྱི་འཁོར་ལོ་སོགས་ལ་བརྩོན་པར་བྱ།",
    "བསྔགས་པའི་ཅ་ཅོ་སྒྲོགས་པར་གྱུར།",
    "ཚ་བའི་ངད་ཀྱིས་མ་རུངས་པར།",
    "སྟོབ་པས་རོ་འཛིན་ཚིམ་པར་བྱེད།",
    "སྐྱེ་བོ་ཚ་བས་ཉམ་ཐག་པར།",
    "མི་གཙང་དྲི་མ་འཁྲུད་པའི་ཆུ།",
    "བསྐྲད་དེ་བག་ཕེབས་ཉམས་དགའི་དབེན་གནས་ཀུན།",
    "དུས་ཀུན་བཞུགས་ཏེ་བྱིན་གྱིས་རློབས།",
    "ན་རྒ་འཆི་མེད་གོ་འཕང་འཐོབ་པར་ངེས།",
    "འ་འུར་རྡོ་རྗེའི་བཟླས་པར་འབད་བྱས་ཏེ།",
    "ཡ་མཚན་གྲུབ་མཆོག་ཚེ་འདིར་འཐོབ་པར་བྱ།",
    "ཆགས་མེད་དབེན་པར་རི་དྭགས་ལྟར་རྒྱུ་ཞིང་།",
    "ལྷོད་ལྷོད་དྲན་ཤེས་རྣལ་དུ་ཕབ་བྱས་ཏེ།",
    "འཇམ་དཔལ་རྡོ་རྗེ་རྣོན་པོའི་མཁྱེན་རབ་དང་།",
    "གནས་འདིར་དགེ་ལེགས་ཕུན་སུམ་ཚོགས་པར་མཛོད།",
    "གནས་འདིར་དགེ་ལེགས་ཕུན་སུམ་ཚོགས་པར་མཛོད།",
    "གནས་འདིར་དགེ་ལེགས་ཕུན་སུམ་ཚོགས་པར་མཛོད།",
    "གནས་འདིར་དགེ་ལེགས་ཕུན་སུམ་ཚོགས་པར་མཛོད།",
    "གནས་འདིར་དགེ་ལེགས་ཕུན་སུམ་ཚོགས་པར་མཛོད། ། དྲོ་འཇམ་ཉི་མ་ཤར་ནས་མེ་ཏོག་སྣ་ཚོགས་བཞད་བྱུང་།",
    "ཤེས་རབ་ལྡན་པའི་གྲྭ་སློབ་བྱས་ན་འཚེངས།",
    "ངན་པའི་ལས་ལ་བྱོལ་ཐབས་མི་བྱེད་པར།",
    "ཤར་ཕྱོགས་ཡུལ་ནས་སྐྱེས་མཆོག་དམ་པ་ཕེབས་བྱུང་།",
    "སྤྲིན་ལ་གོ་སྐབས་འབྱེད་པར་གསོལ།",
    "བཀྲུ་བའི་གཙང་སྦྲ་ལྷུར་ལེན་པ།",
    "བྲམ་ཟེའི་བརྟུལ་ཞུགས་འཛིན་པར་བྱེད།",
    "འཛུམ་ཞིང་མགོ་ལྕོག་ལྡེམ་པར་བྱེད།",
    "ཤེས་རྒྱུད་གསེར་གྱི་བུམ་པར་འཁྱིལ།",
    "དགེ་ལེགས་འོད་དཀར་ལྷམ་མེར་འཚོ་བཞེས་ཞེས།",
    "ལེགས་བྱས་ཉི་མའི་འོད་ཀྱིས་ཕྱེ་བ་ལས།",
    "དེས་ཀྱང་བདག་ཡིད་བརྟན་པ་ལྷག་པར་འཕྲོག།",
    "མང་དུ་བསགས་ཀྱང་ཆ་ཙམ་སྤྱད་མེད་པར།",
    "ཐུགས་དགོངས་བང་མཛོད་དལ་གྱིས་འགེངས་པར་བགྱིད།",
    "མ་ཚང་མེད་པར་བཀོད་པ་རྒྱལ་པོའི་ཁབ།",
    "ཕན་བདེའི་གྲིབ་བསིལ་སྙོམས་པར་འབབ་པའི་གཏམ།",
    "འཆི་བདག་ཐན་པས་སྐེམ་པར་མ་གྱུར་ཙམ།",
    "དེང་སང་བསྟན་འཛིན་དམ་པར་ཁས་འཆེ་མང་།",
    "མཁྱེན་དཔྱོད་སྤྲིན་སྔོན་ཀློང་ནས་དུས་སུ་ཕོབས།",
    "དཀྱེལ་ཆེའི་ཐུགས་ནི་མཁའ་བཞིན་ཡངས་པར་མཛོད།",
    "གནང་སྐྱེས་བཀྲ་ཤིས་པའི་ལྷ་རྫས།",
    "ཚུལ་འདི་སྐྱེས་མཆོག་ཁྱེད་ཀྱིས་དགོངས་ལགས་གྲང་།",
    "བསྟན་འཛིན་བུང་བའི་ཚོགས་རྣམས་ཉམས་བྱས་ཤིང་།",
    "ངེས་པ་ལྔ་ལྡན་བཞིན་དུ་བརྟན་བཞུགས་ནས།",
    "སླད་མར་ཡང་གསུང་འཕྲིན་གྱི་རིམ་པ་ནོར་བུའི་དོ་ཤལ་ལྟ་བུ་ལྷུག་པར་སྩོལ་བའང་ཞུ་ཞུ།",
    "ཞུ་འདེགས་མཚོན་པར་གསེར་སྲང་དོ།",
    "མེ་བྱ་སྤྱི་ལོ་ལོར་དབུས་སུ་ཕེབས།",
    "དགུང་ལོ་ཞེ་གཉིས་པ་ས་ཕག་སྤྱི་ལོ་ལོའི་ཟླ་དྲུག་པར་རྗེ་ཉིད་འཁོར་དང་བཅས་རྒྱ་ནག་ཏུ་ཆིབས་ཁ་བསྒྱུར།",
    "གོང་མས་གཡང་ཊིའི་ཐམ་ག་དང་འཇའ་ས་གནང་།",
    "ལྕགས་བྱི་སྤྱི་ལོ་ལོའི་ཟླ་བ་བདུན་པར་པེ་ཅིན་ཡེ་ཧོར་བཀྲ་ཤིས་ལྷུན་པོར་གོང་མ་ཆན་ལུང་དང་གསེར་ཞལ་ལྷན་དུ་འཛོམས།",
    "དེར་ཟླ་བ་གསུམ་དང་ཞག་བཅུ་གསུམ་བཞུགས་ལ།",
    "ལོ་དེའི་ཟླ་བ་བཅུ་པར་པེ་ཅིན་དུ་སྐུ་གཤེགས།",
    "མཁྱེན་པའི་ཕ་མཐའ་ཡས་པའི་འོད་ཟེར་སྟོང་།",
    "བསྟོད་ཅིང་ཕྱག་མཆོད་བསྔགས་པར་བགྱིད་ལགས་ཀྱི།",
    "བསྟན་པ་རིན་ཆེན་ཕྱོགས་བཅུར་རྒྱས་པར་མཛོད།",
    "ལོ་ཕྱུགས་ལེགས་ཤིང་ཆར་ཆུ་དུས་སུ་ཕེབས།",
    "འདོད་པའི་དོན་ཀུན་ཡིད་བཞིན་འགྲུབ་པར་མཛོད།",
    "བག་ཕེབས་རི་དྭགས་སྣ་ཚོགས་རྒྱུ་བས་མཛེས།",
    "གདུག་ཅན་ཉེར་འཚེས་གླགས་ལྟར་མི་བཟོད་པར།",
    "གྲུབ་པའི་སྐྱེས་བུའི་བསྟི་གནས་འགའ་བཞུགས་པ།",
    "མཐའ་སྐོར་བག་ཕེབས་རྒྱུ་བའི་རི་དྭགས་དང་།",
    "དལ་འབྱོར་དོན་དང་ལྡན་པར་བྱེད་པ་རྣམས།",
    "དམ་རྫས་རྒྱ་མཚོའི་གཏོར་མ་འདི་བཞེས་ལ།",
    "འཕྲིན་ལས་ཐམས་ཅད་ཐོགས་མེད་སྒྲུབས་པར་མཛོད།",
    "མ་ལུས་ཡིད་བཞིན་འགྲུབ་པར་མཛད་དུ་གསོལ།",
    "རྟག་ཏུ་ཕུན་ཚོགས་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "སྣ་ཚོགས་གཟུགས་སྐུའི་རོལ་པར་ཉེར་བསྟན་ཏེ།",
    "སེམས་དཔའ་སུམ་བརྩེགས་རང་བཞིན་དུ་བཞུགས་པ།",
    "སྤྱི་དང་ཁྱད་པར་དཔལ་མགོན་ཕྱག་དྲུག་པ།",
    "འགྲོ་འདི་འདྲེན་ལ་རིངས་པར་ཆས་པ་སྙམ།",
    "རང་དང་གཞན་གྱི་དོན་ཀུན་སྨིན་བྱས་ནས།",
    "འགྲོ་བ་མ་ལུས་འདྲེན་པའི་ངོ་བོར་བཞུགས།",
    "ཨ་ཝ་དྷཱུ་ཏཱིའི་ལམ་ལས་འགྲུབ་པར་མཛོད།",
    "མྱུར་བ་ཉིད་དུ་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "ཁྱད་པར་མ་འོངས་དྲག་པོ་འཁོར་ལོ་ཆེའི།",
    "མགོན་གཞན་གྱིས་བཏང་སྙོམས་ཚུལ་དུ་བཞུགས།",
    "དོན་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་ཏེ།",
    "ཕུན་ཚོགས་ཀྱི་དཔལ་ལ་རོལ་པར་འགྱུར།",
    "བློ་ཕྱིན་ཅི་མ་ལོག་བསྒྲུབ་པར་སྨོན།",
    "ཡུན་དུས་མཐའི་སྐད་ཅིག་མི་འགྲོགས་པར།",
    "སྟོན་པའི་བསྟན་པ་ཡང་འཇིག་པར་འགྱུར་བས།",
    "རང་རྒྱུད་ཀྱི་སྡོམ་པ་རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར་རྟག་ཏུ་བག་ཡོད་པར་གནས་པའི་ཆེད་དུ་འབད་པ་བྱེད་དགོས།",
    "ཡུལ་དུས་ཀྱི་སྲོལ་དང་མཐུན་པར་འཇུག་དགོས་པ་འགའ་ཞིག་ལ།",
    "བསླབ་པའི་ཆ་འགའ་ཞིག་བག་ཡངས་སུ་སྤྱོད་པར་གསུངས་ཤིང་།",
    "དེ་ལྟར་བཟོད་པ་ངེས་པར་གོམས་པར་བྱས་ནས་ཆོག་ཤེས་པ་ལ་བསླབ་དགོས་ཏེ།",
    "འཚོ་བ་སྟན་གཅིག་པ་རྣམས་ཀྱིས་འཚོ་བར་ཁས་བླངས་པ་དང་འབད་རྩོལ་ལ་མི་ལྟོས་པར་རྙེད་ན།",
    "ཁང་པ་བརྩེགས་པ་ལྔ་བརྒྱ་པའང་ལོངས་སྤྱོད་དུ་གནང་ལ།",
    "སྡུག་བསྔལ་བསྐྱེད་པའི་གཞིར་ཤེས་པར་བྱས་ནས།",
    "ཕམ་པ་བཞི་པོ་འདི་ངོས་ཟིན་པར་བྱས་ནས་སྲུངས།",
    "རྒོད་མ་ལ་སོགས་པའི་ལུས་ཀྱི་ཆ་ཤས་ལ་རྩོལ་བ་བྱས་ནས་ས་བོན་ཡུངས་ཀར་གྱི་འབྲུ་ཚད་ཙམ་ཚུན་ཆད་ཕྱིར་བཏོན་པ་དང་།",
    "རྒྱལ་པོས་མ་གནང་བ་དང་རྩོད་པ་དང་བཅས་པ་དང་།",
    "ཁྱིམ་པ་རྣམས་མ་དད་པ་སྐྱེ་བའི་སྤྱོད་པ་མདའ་འཕེན་པ་སོགས་བྱས་ཤིང་།",
    "དེ་གཞན་གྱིས་བཟློག་པར་མི་ཉན་པ་དང་།",
    "སོ་སོར་བཤགས་པ་བཞི།",
    "གཡེང་བའི་དགྲ་ལས་གྲོལ་བྱས་ཏེ།",
    "དཔྱད་པ་རྣམ་པར་དག་པའི་མི་བསླུའི་ཤེས།",
    "བློ་གྲོས་ཀུན་ཏུ་གོམས་པར་བྱེད་ཅིང་མཆིས།",
    "རྟོགས་པའི་ཡོན་ཏན་གོང་ནས་གོང་དུ་ཁྱད་ཞུགས་པའི་གླེང་གཞིའི་གླེགས་བུ་མངགས་པར་མཛད་པའི་དོན་ལ་འདི་ལྟར་ཞུ་བར་བྱ་སྟེ།",
    "ལྷ་དང་མཁའ་འགྲོའི་མཁྱེན་བརྩེའི་འཁར་བའི་རྔ།",
    "འགྲོ་བ་ཀུན་དང་ཁྱད་པར་ནུབ་ཕྱོགས་ཀྱི།",
    "བཟང་པོའི་རྒྱལ་སྲས་སྤྱོད་ཚུལ་ལེགས་པར་སྨྲ།",
    "རིམ་གཉིས་རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་ལ།",
    "ཉམས་སུ་ལེན་པ་དཔའ་བོའི་སྤྱོད་ཚུལ་ལགས།",
    "ད་ཕན་ཆད་ཀྱང་ཀློག་པའི་བྱ་བ་ཡང་ལེགས་པར་ཚགས་སུ་འཛིན་དགོས་པར་མ་ཟད།",
    "དེ་ནས་གྲྭ་ས་ཆེན་པོ་ཞིག་ཏུ་བཞུགས་ཏེ།",
    "སྡོམ་པ་གསུམ་གྱི་བཤགས་པ་མི་འགྱང་བར་བྲིས་ནས་བསྐུར་རྩིས་བྱེད།",
    "ཕྱག་བྲིས་རྟེན་ལྡན་ཕོ་ཉ་བ་ཆེད་མངགས་ཀྱི་མདུན་དུ་གནང་བར་ཡིད་ཤིན་ཏུ་སྤྲོ།",
    "བྲག་ཁ་ཐེག་ཆེན་གླིང་རྣམས་སུ་སྔོན་དུས་རྣལ་འབྱོར་པ་དགེ་སློང་དཀའ་བཅུ་བློ་བཟང་རྣམ་རྒྱལ་གྱིས་སྒྲུབ་པའི་རྒྱལ་མཚན་བཙུགས་ནས་སྙན་བརྒྱུད་ཀྱི་ཏིང་ངེ་འཛིན་རྣམ་པར་དག་པ་སྲོལ་བཏོད་ཅིང་།",
    "གོང་སྨོས་ཚང་མས་ལེགས་པར་དགོངས་ཏེ་སྒྲུབ་གྲྭ་འདི་རྣམས་ཡར་རྒྱས་སུ་འགྱུར་ཐབས་ཁོ་ན་ལ་འབད་ཅིང་།",
    "བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོའི་སྣང་བརྙན་རྭ་པར་མ།",
    "གྱོན་པའི་ནོར་འཛིན་དོག་པོར་བྱས།",
    "དུས་ཀྱི་མཐར་སྐྱེས་པའི་འགྲོ་བ་ཐམས་ཅད་མགོན་དང་བཅས་པར་མཐོང་སྟེ།",
    "རྗེས་སུ་ཡི་རང་བའི་བསྟོད་པའི་ལེགས་སོ་བརྗོད་པར་བྱེད་པ་ལགས་ན་ཐུགས་བརྩེ་བ་ཆེན་པོས་ཉེ་བར་དགོངས་ཏེ་སྤྱན་རས་ཀྱིས་མ་སྐྱུང་བའི་བཀའི་ཕེབས་ཚོགས་ཀྱང་སྤྱི་བོར་སྩོལ་བ་མཁྱེན་མཁྱེན་མཁྱེན་ལགས།",
    "མཉམ་པར་བཞག་བཞིན་ཀུན་རྫོབ་དཔག་བསམ་ཤིང་།",
    "ཉེས་སྤྱོད་བཚྭས་ཁྱབ་པར་རྒྱལ་བསྟན་གྱི།",
    "སྣོད་ཀུན་རྣམ་པར་སྣང་མཛད་ངོ་བོའི་མདངས།",
    "བཅུད་ཀུན་མི་བསྐྱོད་ལྷ་ཡི་རྣམ་པར་རོལ།",
    "ཐོགས་པར་དམ་བཅས་ཡིད་ལ་རབ་འཆང་བས།",
    "འབྲས་བུར་ཀུན་རྫོབ་རྣམ་པར་བཀྲ་བ་གནས།",
    "བསང་གཏོར་དེ་ཡང་ལན་ཅིག་མིན་པར་མཛོད།",
    "ལེགས་པར་བལྟས་ཏེ་བང་ཕྱིན་རྣམས་ལ་གཞིས་ཁ་རྩེ་དང་ལྷ་ས་རྣམས་སུ་ཕན་འགྱུར་གྱི་རོགས་རམ་གང་དྲག་བྱས་པ་ཡིན།",
    "བྲམ་ཟེ་དང་བཅས་པའི་སར་ལས་ཁ་བྱེད་དུ་བཅུག་ཚུལ་ཚང་མ་ལྷ་ས་ནས་གནང་བའི་༧བཀའ་ཤོག་དང་།",
    "བང་ཕྱིན་རྣམས་ཀྱི་ངག་ལམ་ནས་ལྷ་ཉིད་ཀྱིས་རྟོགས་པར་འགྱུར་ཞིང་།",
    "ངེད་དགེ་སློང་བདེན་པར་སྨྲས་པའི་གཏམ་དྲང་པོར་བརྗོད་ན།",
    "སྔར་གྱི་ཟངས་ཊམ་རྣམས་ཀྱང་འགྲོ་རྒྱུག་མ་བྱས་ཚེ།",
    "ལྷག་པར་ནུབ་ཕྱོགས་ན་གར་ཀོ་ཊི་དང་།",
    "རྒྱལ་ཀུན་མཁྱེན་རབ་དྷཱི་ཡིག་བཞུན་མའི་ཁམས།",
    "རྙོག་བྲལ་བདེ་བའི་ངོ་བོར་བཞུགས་ལགས་སམ།",
    "རབ་སྤྱོད་ཐོས་བསམ་སྒོམ་ལ་འབད་པར་མཆིས།",
    "ཁྱད་པར་ཞྭ་སེར་རིང་ལུགས་ཟླ་མེད་པ།",
    "དུས་ཡུད་ཙམ་མནར་བའང་མ་བཟོད་པར།",
    "ཞལ་རྣམ་པར་འགྱུར་བའི་དྲི་བཞོན་གྱིས།",
    "དོན་འདི་ལས་རྫོགས་པར་མངོན་གྱུར་ཏེ།",
    "ཐོབ་འགྱུར་ཞེས་རྒྱལ་རྣམས་མགྲིན་གཅིག་གསུངས།",
    "ད་ལྟ་ནི་འདི་ན་ཡོད་དོ་ཞེས་པའི་མིང་ཡང་མི་གྲག་པ་འདི་ལྟར་ལགས།",
    "ད་འཆོལ་ལེགས་པའི་འཕྲིན་ལལས་བཅོལ་ན་ལེགས་པར་མཐོང་ནས།",
    "ཞེས་བྱ་བ་ལགས་སོ།",
    "མཛད་ཅེས་ཐོས་པ་དེང་འདིར་བདེན་པར་འཁུམས།",
    "ཞེས་སྙན་པར་སྨྲ་བའི་ཚིག་བརྗོད་ནས།",
    "བདག་ལྟ་བུས་ལན་བྱེ་བ་ཕྲག་བརྒྱར་བསྟོད་ཅིང་བསྔགས་པར་བྱེད་པ་ནི་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "ད་ལམ་གྱི་ཕན་ཐོགས་མཛད་ཚུལ་རྣམས་ཚེ་རབས་ཐམས་ཅད་དུ་རྨི་ལམ་ན་ཡང་མི་བརྗེད་ཅིང་དྲིན་ལན་གཞལ་བར་བརྩོན་པར་བགྱིད་པ་ལགས།",
    "ལེན་པར་འདོད་ཀྱང་འཇིགས་མེད་རྫུ་འཕྲུལ་ནི།",
    "པྲི་ཡངྐུའི་གླིང་ན་འཕགས་པ་སྒྲ་གཅན་འཛིན་བཞུགས་སོ།",
    "འཕགས་པ་ཡན་ལག་འབྱུང་ངམ་ཡན་ལག་སྐྱེས་སམ་ཟུར་གྱིས་ཤེས་གངས་རི་ཆེན་པོ་ཏི་སེ་ལ་བཞུགས་སོ།",
    "ནགས་ན་གནས་ནི་མཉན་ཡོད་ཀྱི་ལོ་མ་བདུན་པའི་རི་ཕུག་ན་བཞུགས་སོ།",
    "མ་ཕམ་པ་དྲང་སྲོང་ཨུ་ཤི་རའི་ཕུག་ན་བཞུགས་སོ།",
    "འཕགས་པ་བཟང་པོ་ནི་ཆུ་བོ་ཡ་མུ་ནའི་གླིང་ན་བཞུགས་སོ།",
    "རི་དེའི་དབུས་ན་ཕུག་པ་ཞིག་ཡོད་པ་དེར་སུས་བསྒོམས་ཀྱང་བསམ་གཏན་གྱི་བདེ་བ་ཐོབ་པར་འགྱུར་བས།",
    "དེའི་ནང་ན་འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་བྷ་ར་དྷྭ་ཛ་བསོད་སྙོམས་ལེན་བཞུགས་པ་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པ་གསེར་བེའུའི་བཞུགས་གནས།",
    "གུར་ཀུམ་དེ་དག་ནི་སྔོན་བཅོམ་ལྡན་འདས་ཀྱིས་ནམ་མཁའ་ལ་འཕུར་ནས་ཡུལ་དེར་བྱོན་ཏེ་སྐུ་གཟུགས་ཀྱི་གྲིབ་མ་རི་དེ་ལ་བབས་པར་མཛད་ནས།",
    "རི་དེའི་དབུས་ན་བརྒྱ་བྱིན་གྱི་ཁང་བཟང་རྣམ་པར་རྒྱལ་བ་ཡང་ཟིལ་གྱིས་གནོན་ནུས་པའི་འོད་ཟེར་གྱིས་རབ་ཏུ་བཀྲ་བའི་ཕུག་པ་ཞིག་ཡོད་དོ།",
    "ཕུག་པ་དེར་སྔོན་དྲང་སྲོང་ལྔ་བརྒྱ་ཙམ་བཞུགས་ཤིང་བསྒོམས་པའི་ཚེ་ལྷ་རྣམས་ཀྱིས་ཁྱེད་དྲང་སྲོང་རྣམས་ཀྱི་བྲག་ཕུག་དེ་དག་གདུག་པ་ན་ཞེས་བརྗོད་པས།",
    "དེ་ན་བཞུགས་པའི་གནས་བརྟན་བྷ་ར་དྷྭ་ཛ་གསེར་ཅན་མཆོག་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པའི་གནས་བརྟན་ལམ་ཆེན་པ་དེའི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "དེ་ནས་ལྷ་རྣམས་ཀྱིས་གྲོས་བྱས་ཏེ།",
    "བདག་ཅག་རྣམས་ལྷ་མ་ཡིན་ལས་རྒྱལ་བར་འགྱུར་བ་ནི་ལྷའི་དྲང་སྲོང་རྣམས་ཀྱི་བཀའ་དྲིན་ཡིན་པས་དྲང་སྲོང་རྣམས་ལ་བཞུགས་གནས་ལེགས་པ་ཞིག་བཟོས་ལ་དྲང་སྲོང་རྣམས་ལ་དབུལ་བར་བྱའོ།",
    "རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་ལས་ཀྱང་ལྷག་པར་གྱུར་ཏོ།",
    "དེ་ལྟ་བུའི་ཁང་བཟང་ངམ་བྲག་ཕུག་དེ་ན་བཞུགས་པའི་འཕགས་པའི་གནས་བརྟན་ལམ་པ་ཆེན་པོ་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པའི་གནས་བརྟན་སྒྲ་གཅན་འཛིན་གྱི་བཞུགས་གནས་པྲི་ཡངྐུའི་བྱུང་ཁུངས་ནི།",
    "དེ་ལྷ་རྣམས་ཀྱིས་རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་དང་མཉམ་པར་བྱིན་གྱིས་བརླབས་སོ།",
    "བྱི་ལ་དཔའ་བོའི་ཤ་ཁྲག་ཟས་སུ་བཟའ་བ་མང་པོ་ཡོད་པ་རྣམས་ལ་ཐུགས་བརྩེ་བར་དགོངས་ཏེ་ཡུལ་དེར་བྱོན་ནས་སྲོག་ཆགས་མང་པོ་བདེན་པ་ལ་འགོད་པར་མཛད་དོ།",
    "དེ་ལྟར་ཁང་བཟང་དམ་པ་དེ་ན་བསྟན་པ་སྐྱོང་ཞིང་བཞུགས་པའི་འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་སྒྲ་གཅན་འཛིན་བཟང་པོ་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་ནགས་ན་གནས་སམ་སེང་ལྡེང་ནགས་ཀྱི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་མ་ཕམ་པའི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "དེ་ལྟ་བུའི་རིའི་ངོགས་ལ་བཞུགས་པའི་འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་མ་ཕམ་པ་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པའི་གནས་བརྟན་ཤིང་ཤུན་ཅན་ནམ་བ་ཀུ་ལའི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "དེ་ལྟ་བུའི་གནས་མཆོག་ན་བཞུགས་པའི་འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་ཤིང་ཤུན་ཅན་ནམ་བ་ཀུ་ལ་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་བཟང་པོའི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "སྔོན་ཆུ་བོ་ཡ་མུ་ན་ལ་གནས་པའི་ཀླུ་རྣམས་ཀྱིས་གྲོས་བྱས་ཏེ།",
    "ཞེས་གྲོས་བྱས་ནས་ཡུལ་ཀོང་ཕྱོགས་སུ་ཆུའི་དཀྱིལ་ན་གླིང་ཞིག་ཏུ་ཁང་བཟང་ཕུན་སུམ་ཚོགས་པ་ཞིག་བཅོས་ཏེ་དེར་དབྱར་གྱི་དུས་སུ་ཀླུ་རྣམས་ཚོགས་ནས་ཤོ་བརྒྱག་པར་བྱེད་དོ།",
    "དེ་ལྟ་བུའི་ཁང་བཟང་དམ་པ་དེ་ན་བཞུགས་པའི་འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་བཟང་པོ་ལ་གསོལ་བ་འདེབས་སོ།",
    "འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་ཀཱ་ལི་ཀའམ་དུས་ལྡན་གྱི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "དེ་ནས་དབུལ་པོ་དེ་ཡུལ་ཁམས་དེའི་རྒྱལ་པོར་གྱུར་ཅིང་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "དེ་ལྟ་བུའི་བྲག་ཕུག་དམ་པ་ན་བསྟན་པ་སྐྱོང་ཞིང་བཞུགས་པའི་འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་ཀཱ་ལི་ཀ་ལ་གསོལ་བ་འདེབས་སོ།",
    "རྒྱ་ཤུག་གླིང་དུ་མི་དག་བཀོད་པར་བྱས།",
    "འཕགས་པའི་གནས་བརྟན་ཆེན་པོ་སྦེད་བྱེད་ཀྱི་བཞུགས་གནས་ཀྱི་བྱུང་ཁུངས་ནི།",
    "ཐམས་ཅད་དེ་ཡི་ས་ལ་འགོད་པར་ཤོག།",
    "དག་པའི་ཞིང་ཁམས་རྣམས་སུ་འཁྲིད་པར་ཤོག།",
    "དཔག་མེད་ལུས་ཀྱི་བཀོད་པ་སྟོན་པར་ཤོག།",
    "ཟས་གཙང་སྲས་ཀྱི་ཞབས་པད་གཙུག་ན་བསྟེན།",
    "འགྲོགས་པ་ལྷུར་ལེན་ཀུན་མཁྱེན་ཙོང་ཁ་པ།",
    "ནམ་ཡང་མི་འབྲལ་བསྟེན་ནོ་མཁྱེན་དང་བརྩེའི།",
    "ཕྱག་རྒྱ་ཆེན་པོ་བསྒྲུབ་པར་འདོད་པ་རྣམས་ལ་ཕན་གདགས་པ་དང་།",
    "དེ་ལས་ཀྱང་འཕགས་པའི་ཡུལ་གྱི་རྣམ་པར་བཞག་པའོ།",
    "ཞེས་གསུངས་ཤིང་།",
    "དེ་གཉིས་ཀའི་ཆེད་དུ་བྱ་བའི་གདུལ་བྱ་ལ་ནི་བལྟ་ཚུལ་གྱི་ཁྱད་པར་འགའ་ཞིག་ལས་གཞི་གཅིག་ཉིད་ལ་སྣང་ཚུལ་གཉིས་ཀ་བསྙོན་མེད་དུ་འཆར་བ།",
    "མཁས་པ་རྣམས་བྱ་རོག་དཀར་པོའི་བཞུགས་གྲལ་དུ་བསྒྲིག་པ་ལ་སྤྲོ་བ་ཅན་མང་བས་འདིར་མི་སྤྲོ་ཞིང་།",
    "ཞེས་གསུངས་པའི་ནང་ཚན།",
    "རང་ཅག་རྣམས་ཀྱི་བདག་པོ་ཆེན་པོར་བཞུགས་ཏེ།",
    "བར་དབུས་གཙང་རུ་བཞི།",
    "ད་ལྟར་གྱི་དུས་སུ་སྲིད་ཞི་ཡོངས་ཀྱི་གཙུག་རྒྱན་རྒྱལ་མཆོག་འཇམ་དཔལ་རྒྱ་མཚོ་མི་འཇིགས་རྡོ་རྗེའི་ཁྲི་ལ་བཞུགས་ཤིང་འཕྲིན་ལས་རྫོགས་ལྡན་གསར་བའི་དགའ་སྟོན་ངོམ་པའི་དབུ་བརྙེས་པའི་དུས་ཏེ།",
    "རྒྱ་དཀར་ནག་གཉིས་ཀའི་ཁོངས་སུ་ཡོད་དེ་གནས་ཚུལ་འགའ་ཞིག་སྐབས་འགར་འཆད་པར་འགྱུར་རོ།",
    "ཡུལ་རྣམས་ཀྱི་གཙོ་བོར་གྱུར་པ་འཕགས་པའི་ཡུལ་ཉིད་འཆད་པར་བྱེད་པ་ལ་གསུམ།",
    "སའི་ཆ་དུམ་བུ་ལྔར་ཕྱེ་ནས་གཏན་ལ་འབེབས་པར་བྱ་སྟེ།",
    "ཤེས་པར་འདོད་པ་རྣམས་ཀྱིས་རྟོགས་སླ་བའི་ཕྱིར་དུའོ།",
    "རང་ཅག་རྣམས་ཀྱི་རྣམ་འདྲེན་དམ་པ་རྒྱལ་བ་ཀུན་ལས་ཐུགས་རྗེ་ལྷག་པར་བསྔགས་པ་མཉམ་མེད་ཤཱཀྱའི་རྒྱལ་པོས་གཙོ་མཛད།",
    "གནས་འདིར་ཕྲེང་སྐོར་གཅིག་བཟླས་པ་ནུས་པ་མྱུར་བ་སོགས་ངོ་མཚར་བའི་ཁྱད་པར་མང་པོ་ཡོད་དེ།",
    "འདིར་ཕུང་པོ་ལྔའི་མཆོད་རྟེན་དང་འཕགས་པ་ཀུན་དགའ་བོའི་མཆོད་རྟེན་རྣམས་བཞུགས།",
    "མཚན་གྱི་བཀོད་པ་སྣ་ཚོགས་པ་སོགས་བརྗོད་པར་དཀའ་བ་དག་དང་།",
    "བྱེའུ་སྣ་ཚོགས་པས་ཁྱབ་ཅིང་སྒྲ་སྙན་པར་སྒྲོག་ཅིང་།",
    "བཞད་ལ་སོགས་པས་སྒྲ་སྙན་པར་སྒྲོག་ཅིང་།",
    "ཝཱ་ར་ཎ་སིའི་ཡུལ་འགྲམ་ནས་བརྒྱུད་བྷང་ག་ལའི་ལྷོ་ཕྱོགས་ལ་ཉེ་བའི་ངོས་ནས་ཤར་ཕྱོགས་སུ་འབབ་པའི་ཆ་གཉིས་སུ་གྱེས་པའི་ཆ་ཆེ་བ་བོད་ཀྱི་གཙང་པོར་འབབ་པ་དང་ཉེ་བ་ནས་རྒྱ་མཚོར་འགྲོ་ཞིང་།",
    "སྔོན་གྱི་གྲུབ་ཐོབ་གཞན་རྣམས་ཀྱི་བཞུགས་གནས་ཀྱང་མང་དུ་ཡོད་ལ།",
    "འདི་དག་སྤྱིའི་རྒྱལ་པོའི་མིང་ལ་བྷཱ་མ་རཱ་ཛ་ཞེས་འབོད་པར་སྣང་ཞིང་།",
    "དེ་ཝི་ཀོ་ཊི་ནི་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་མཁའ་འགྲོ་མ་རབ་ཏུ་མང་བས་རིག་སྔགས་ཀྱི་ཁྱད་པར་སྤྱི་དང་།",
    "ཡང་སྒོས་འཕགས་ཡུལ་བ་ཕལ་ཆེར་བོད་ལ་རིགས་ངན་དུ་བྱས་ནས་བཙོག་པའི་འདུ་ཤེས་ཆེ་བས་དེང་དུས་བགྲོད་པར་བྱ་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "གླིང་ཕྲན་འདི་དག་ཀྱང་སྐད་དང་ཆ་ལུགས་རྩ་བའི་བདག་པོ་སོགས་ཀྱི་ཁྱད་པར་ལས་རྒྱ་གར་ལྷོ་ཕྱོགས་ཀྱི་ཁོངས་སུ་བསྡུ།",
    "ཀླ་ཀློ་སྡིག་སྤྱོད་ཀྱི་ཡུལ་ཤ་སྟག་སྟེ་ནང་པ་ཕར་ཞོག་ཕྱི་རོལ་པའི་རིང་ལུགས་འཛིན་པའང་ཆེར་མེད་པར་སྣང་།",
    "ཡུལ་ཉེར་བཞི་རྣམས་སུ་འགྲོ་བའི་དོན་མཛད་པར་གསུངས་པ་ལྟར།",
    "དེ་ཁོ་ན་མ་ཡིན་ཏེ་རྗེ་ཕུན་ཚོགས་གླིང་པ་འདི་པ་དོལ་ཞེན་གྱིས་ཀླུ་སྒྲུབ་ཡབ་སྲས་ཀྱི་གཞུང་ལུགས་ལ་མི་དགྱེས་པ་ལ་མ་མཉེས་པའི་གསུང་ཡིན་པར་སྣང་བ།",
    "གྲུབ་ཆེན་དེ་ཉིད་ཀྱིས་མཛད་པའི་དེ་ཉིད་བདུན་པ་ལ་བརྟགས་པས་ལེགས་པར་ཤེས་ནུས།",
    "རྒྱལ་པོ་ཆེན་པོ་འདི་བློན་པོ་གནོད་སྦྱིན་དུ་བཅས་པ་སྔོན་བྱིས་པར་གྱུར་པའི་ཚེ་དེ་བཞིན་གཤེགས་པ་ལ་བྱེ་མ་སྤར་གང་ཕུལ་བས་མྱ་ངན་མེད་དུ་འགྱུར་བར་ལུང་བསྟན་པ་ནི་གྲགས་ཆེ་ལ།",
    "གསེར་འོད་དམ་པ་གསུངས་པའི་དུས་ཀྱི་བྲམ་ཟེའི་སློབ་དཔོན་ཀུན་གྱི་བཤེས་གཉེན་ཡང་རྒྱལ་པོ་འདིའི་སྐྱེས་རབས་དང་།",
    "འཕགས་མ་སྐྲ་ཅན་མའི་རིག་སྔགས་འགྲུབ་པར་རྩ་རྒྱུད་ལས་ལུང་བསྟན་ཏེ།",
    "དབུས་ཀྱི་མཚོན་ཆས་འཚོ་བ་ཐམས་ཅད་མགུ་བར་བྱས་ཏེ།",
    "ཁྱད་པར་བྲི་ཀ་མ་ལ་ཤཱི་ལའི་གཙུག་ལག་ཁང་བཞེངས།",
    "ཡཀྴ་པཱ་ལ་རྣམས་ཀྱིས་རྒྱལ་སྲིད་རིམ་པར་མཛད་མཐར་སྔོན་གྱི་ཙནྡྲའི་རིགས་ཀྱི་གདུང་བརྒྱུད།",
    "དེའི་བུ་ར་ཐཱི་ཀ་སེ་ན་སྟེ་བོད་རྣམས་ཤིང་རྟ་ཅན་དུ་འབོད་པ་རྣམས་ཀྱིས་ས་སྐྱོང་མཛད་དེ་ཐུབ་པའི་བསྟན་པ་ལ་སྲི་ཞུ་ཡང་དག་པར་མཛད།",
    "དུས་འདི་བོད་དུ་བུ་སྟོན་སོགས་བཞུགས་པའི་དུས་ཙམ་དུ་མངོན་ནོ།",
    "དེ་ནས་ལོ་བརྒྱ་ཙམ་འདས་པ་ན་བྷང་ག་ལའི་ཡུལ་དུ་རྒྱལ་པོ་ཙང་ག་ལཱ་རཱ་ཛ་ཞེས་བྱ་བ་བྱུང་སྟེ།",
    "ཁྱད་པར་ཏུ་རུ་ཀ་རྣམས་ཤིན་ཏུ་སྐྲག་པས་བྲན་གཡོག་ཏུ་ཁས་ལེན་ཞིང་ཇི་ལྟ་བའི་བཀའ་ནོད་པར་གྱུར་ཏེ།",
    "ཁྱབ་འཇུག་ལ་སོགས་པའི་ལྷ་ཆེན་པོ་རྣམས་ནས་བཞེངས་པར་གྲགས་པ་ཕྱི་བྲག་རི་མཆོད་རྟེན་གྱི་རྣམ་པ་ཅན་ལྟ་བུ་ལ་བེཌཱུརྱའི་རང་བཞིན་གྱི་བུམ་པ་ལྔ་བརྒྱའི་ལྟེ་བ་ཅན་ཁྱམས་ཀ་བ་ཉེར་བརྒྱད་དང་བཅས་པའི་སྟེང་དུ་དཔལ་ལྡན་རྒྱུ་སྐར་གྱི་དཀྱིལ་འཁོར་ཆེན་པོ་དང་།",
    "དེས་བཀའ་རྣམས་ཡང་དག་པར་བསྡུས་ནས་འཕགས་པ་ཀུན་དགའ་བོ་ལ་གཏད།",
    "གཞི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དང་།",
    "འཇིག་རྟེན་འདས་པར་སྨྲ་བ་དང་།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་ཡིན།",
    "ཞེས་གསུངས་ཏེ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་རྣམས་དང་།",
    "རལ་གྲི་ལ་སོགས་པའི་རིག་འཛིན་ལ་བརྟེན་ནས་ཐ་མལ་བའི་ལུས་འདི་ཁོ་ནས་བདེ་བ་ཅན་ལ་སོགས་པའི་ཞིང་ཁམས་སུ་བགྲོད་ནས་མགོན་པོ་འོད་དཔག་མེད་སོགས་ལ་དངོས་སུ་གདམས་ངག་ཉན་པར་བྱེད་པ་སོགས་ཀྱི་སྒོ་ནས་མྱུར་དུ་ཚོགས་གཉིས་རྫོགས་པ་དང་།",
    "ཆད་པར་སྨྲ་བ།",
    "ཞེས་བྱས་ནས་གཅེར་བུ་བའི་དཔུང་ཆེན་པོས་ཏུ་རུ་ཀའི་རྗེས་སུ་བསྙེགས་ཏེ།",
    "སྒྱུ་རྩལ་ཤེས་ཀྱི་བུ་རིང་འཕུར་སོགས་ཀྱི་སར་ཕེབས་ནས་བཀའི་གནང་བ་སྩལ་བ་དང་།",
    "ད་ནི་དུས་ཀྱི་འཁོར་ལོ་ནས་ཤིན་ཏུ་ཐ་དད་དུ་གསུངས་པ་ལྟར་གཏན་ནས་མི་གཅིག་སྟེ།",
    "ཡུལ་ཆེན་པོ་འདིར་ལོངས་སྤྱོད་ཀྱི་ཁྱད་པར་རྣམ་ཐོས་ཀྱི་བུ་ལ་འགྲན་བཟོད་པ་དང་ཡན་ལག་བཞིའི་རིག་པའི་གནས་བཅོ་བརྒྱད་ལས་བྱུང་བའི་སྒྱུ་དཔུང་བྱེ་བ་ཕྲག་མང་པོས་གང་བ་དང་།",
    "རིག་སྔགས་གྲུབ་པ་མ་ཡིན་པའི་ལྷོ་ཕྱོགས་ཀྱི་སྐྱེ་བོས་ནི་བགྲོད་པར་ཤིན་ཏུ་དཀའ་བ་ཡིན་སྣང་སྟེ།",
    "སྔོན་དུས་ཞབས་པ་བྱོན་པའི་ཚེ་བགྲོད་དཀའ་བ་ལ་དགོངས་ཏེ་རིགས་ལྡན་གྱི་སྤྲུལ་པས་ལམ་ནས་བཟློག་པར་གསུངས་ཤིང་།",
    "རྨི་ལམ་ལེགས་པར་བརྟགས་ཏེ་གནང་བ་ཐོབ་པའི་མཚན་མ་བྱུང་བ་ན་བགྲོད་པར་བྱ་བ་ཡིན་གྱིས།",
    "དེ་ལྟ་མིན་པར་བར་མ་དོར་ཕྱིན་ན་ལམ་སྲུང་བའི་གནོད་སྦྱིན་དང་།",
    "ཀླུ་གཏུམ་པོ་རྣམས་ཀྱི་ཆད་པས་སྲོག་འཕྲོག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ཨ་བྷི་ཏའི་ཁུ་བ་ལ་སོགས་པ་རྨད་དུ་བྱུང་བའི་གཏོར་མ་དང་སྦྱིན་སྲེག་སྟོང་ཕྲག་བཅུས་མཉེས་པར་བྱ་སྟེ།",
    "སྦྱིན་སྲེག་དེ་ཐམས་ཅད་ལ་རྣལ་འབྱོར་པ་མིང་འདི་ཞེས་བྱ་བ་བདག་ལ་དཔལ་ཀ་ལཱ་པའི་དངོས་གྲུབ་འགྲུབ་པར་མཛོད་ཅིག་སྭཱ་ཧཱ་ཞེས་སྤེལ་ཚིག་སྦྱོར་ཞིང་།",
    "བོད་ལྟ་བུ་ཤིང་དེ་རྣམས་མི་འབྱོར་བའི་ས་ཕྱོགས་སུ་དངོས་གྲུབ་རྒྱ་མཚོ་ལས་གསུངས་པ་ལྟར་འོམ་ཅན་གྱི་ཤིང་གང་ཡང་རུང་བར་བྱའོ།",
    "སིནྡྷུའི་ཡུལ་ནས་ཡིན་པར་མངོན་ནོ།",
    "རྣམས་ཀྱི་བ་ཐག་ཕྱུངས་ནས་ལོ་མ་མེ་ཏོག་འབྲས་བུར་བཅས་པ་ཞག་བདུན་གྱི་བར་དུ་བསྐམས་ནས་བྲག་ཕུག་ཅིག་ཏུ་བདུད་རྩི་ཐབ་སྦྱོར་གྱི་སྔགས་ཀྱིས་བསྲུང་ཞིང་སྦ་བར་བྱས་རྗེས་རི་དེའི་ཕྱོགས་དག་ན་ཙ་ཀ་ཁ་དོག་སྣ་ལྔ་ཡོད་པ་ལས་བསླང་སྟེ།",
    "དེ་ནས་སྐུ་གཟུགས་དེ་བྱང་ཕྱོགས་སུ་བལྟས་ཏེ་མེ་ཏོག་དང་འབྲས་བུ་མང་པོས་བཀབ་ནས་སྦའོ།",
    "རང་ཉིད་གཤིན་རྗེ་གཤེད་ཤིན་ཏུ་ཁྲོས་པ་མི་བཟད་པའི་དབྱུག་པ་དང་ཞགས་པ་ཐོགས་པ་མ་ཧེ་ལ་ཆིབས་པར་བསྒོམས།",
    "འདི་ནི་འཕགས་པ་གནས་བརྟན་མི་ཕྱེད་པ་བཞུགས་པའི་གནས་དེ་ཡིན་ནོ།",
    "དེར་སྒྲུབ་པ་པོ་རིགས་སྔགས་མཆོག་ཏུ་འགྲུབ་པ་ཞིག་ཡིན་ན་ནི་གྲུབ་པ་དང་གནོད་སྦྱིན་ལ་སོགས་པ་དེ་རྣམས་དང་རྩེ་བ་དང་ཕན་ཚུན་དགའ་བར་བྱས་པའི་མཐར།",
    "ད་ལྟ་རྒྱ་གར་བ་རྣམས་མཐུན་པར་ཆུ་ཀླུང་འདི་ལ་བྷས་ཏ་ནི་ཞེས་ཟེར་རོ།",
    "ནགས་དེའི་རྩ་བ་དང་འབྲས་བུ་དང་མེ་ཏོག་དག་ཟོས་ན་ཤིན་ཏུ་སྟོབས་དང་ལྡན་པར་གསུངས་པས་ཇི་ཙམ་ནུས་པར་བཟའ་བར་བྱ་སྟེ།",
    "དེར་དངོས་སམ་རྨི་ལམ་དུ་ཡན་ལག་ལས་གནག་པོ་དག་གཟགས་པར་འགྱུར་ལ།",
    "ཀ་བ་བཙུགས་པ་ལྟ་བུ་མཐོང་ན་འཇིགས་པ་སྐྱེད་པར་བྱེད་པ་དག་ཡོད་པས་རི་དེའི་ནང་ནི་གསེར་དངུལ་གྱིས་གང་ལ་ཕྱོགས་བཞི་ན་པདྨ་དང་ཨུཏྤལའི་མཚོ་བཞིས་བསྐོར་བ་སྟེ།",
    "དེས་ལྷ་མིན་སྲིན་པོ་ཡི་དྭགས་ཤ་ཟ་མཁའ་འགྲོ་ཐམས་ཅད་ཟིལ་གྱིས་ནོན་པར་འགྱུར་རོ།",
    "མན་ཊུ་ཝ་དག་མ་རྨོས་པར་སྐྱེ་སྟེ།",
    "རིང་མཐའ་འང་ཟླ་བ་དྲུག་ལས་མི་རིང་བར་བགྲོད་པར་བྱའོ།",
    "ཐམས་ཅད་ལ་འཇུག་པའི་ཤེས་རབ་ཐོགས་མེད་དུ་རྒྱས་པར་འགྱུར་རོ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཁྲུ་གང་སོར་བརྒྱད་མཉམ་པར་ཡོད་པའི་ཀེ་ལ་ཤའི་དུམ་བུ་དེའི་རྒྱབ་ལྷུན་པོའི་ཕྱོགས་ལ་བསྟན་པ་དང་།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྡོ་རྗེ་ཕ་ལམ་ལས་བྱས་པའི་ཤེལ་སྒོ་སྣ་ཚོགས་ལས་གྲུབ་པའི་འོད་ཀྱིས་ཉིན་མཚན་བྱེ་བྲག་མི་ཕྱེད་ཅིང་།",
    "འཛམ་བུ་ཆུ་བོའི་གསེར་ལས་བྱས་པའི་པྲོག་ཞུ་དང་།",
    "དུས་ཕྱིས་རྣམས་སུ་རིགས་ལྡན་གྱི་རྒྱལ་པོ་གཞན་གྱིས་བཞེངས་པའི་ངོ་མཚར་བའི་བློས་བསླངས་མང་པོའང་ཡོད་པར་སྣང་།",
    "སྐུའི་དེའི་ལྟེ་བའི་མཐའ་སྐོར་གྱི་རྣམ་པ་ཅན་གྱི་རི་བོ་བཅུ་ལ་བྱང་སེམས་རྣམས་བཞུགས་པ།",
    "དཔལ་སྐྱོང་སེང་གེ་རྣམ་པར་གནོན།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "རྩ་རྒྱུད་གསུངས་པའི་ལོ་གཉིས་པ་ལ་བློས་བསླངས་དེ་བཞེངས་ནས་གང་ནས་བྱོན་པའི་ཞིང་ལོངས་སྤྱོད་རྫོགས་པའི་གནས་སུ་གཤེགས་སོ།",
    "ཞབས་ལ་ཕྱག་བྱས་ནས་ཉི་མ་བཅུ་གཉིས་ཀྱི་བར་དུ་ལྷོ་ཕྱོགས་སུ་ཕྱིན་ནས་ལྟེ་བའི་མཐའི་ནགས་ཁྲོད་དུ་གྲོང་བཏབ་བོ།",
    "རི་བོ་བཞིན་དུ་འདར་བ་མེད་པར་གྱུར་ཏེ།",
    "རིག་པ་དང་འཕྲུལ་འཁོར་གྱི་ཁྱད་པར་དག་ལ་ཤིན་ཏུ་མཁས་པ་ཡིན་ནོ།",
    "ཞེས་རིགས་ལྡན་ཆེན་པོ་རྣམས་ཤཱཀྱའི་རིགས་མང་པོས་བཀུར་བའི་གདུང་དྲི་མ་མེད་པར་གསུངས་པ་ལ།",
    "འོ་ན་རྒྱུད་ཀྱི་རྒྱལ་པོ་འགྲེལ་ཆེན་དང་བཅས་པ་ལེགས་པར་སུན་ཕྱུང་ཞིག་ཅེས་བརྗོད་པར་བྱ་ཞིང་།",
    "ལ་ཝང་སེ་ནར་དམག་བྱེད་པ་དེ་ཀླ་ཀློ་ཡིན་པ་སོགས་ཁྱད་པར་ཤེས་དགོས་སོ།",
    "དེ་ཕྱིར་འཛམ་གླིང་སྤྱི་དང་ཁྱད་པར་དུ།",
    "དམ་ཚིག་གསུམ་བཀོད་ས་ལ་འགོད་པར་ཤོག།",
    "མཚན་བཅས་མཚན་མེད་ཟུང་དུ་འཇུག་པར་ཤོག།",
    "བདེ་བླག་ཉིད་དུ་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "ནམ་མཁའ་གང་བའི་ཤིས་པ་བརྗོད་བྱས་ན།",
    "ལམ་མཆོག་འདི་ཉིད་ཉམས་སུ་བཞེས་པ་ཡིས།",
    "ལྔ་ཡི་བདག་ཉིད་རྟེན་དང་བརྟེན་པར་བཅས།",
    "ཏིང་འཛིན་སྔགས་ཀྱི་ནུས་པ་གང་བཞུགས་པ།",
    "དུས་གསུམ་བདེ་གཤེགས་མཁྱེན་བརྩེ་མ་ལུས་པ།",
    "ཡེ་ཤེས་ཚོགས་རྣམས་ཡོངས་སུ་རྫོགས་པར་ཤོག།",
    "དེ་དབུས་རྣམ་པར་སྣང་མཛད་རྡོ་རྗེ་དབྱིངས།",
    "མངོན་དུ་བྱས་ནས་འགྲོ་ཀུན་སྒྲོལ་བར་ཤོག།",
    "འགྲོ་ཀུན་དོན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི།",
    "ཁྱེད་ལ་རྟག་ཏུ་དགེ་ལེགས་མཛད་པར་གྱུར།",
    "བློ་བཟང་གྲགས་པའི་དཔལ་ཉིད་ཐོབ་པར་ཤོག།",
    "གསུང་རྩོམ་ནི་མི་རིགས་དཔེ་མཛོད་ཁང་དུ་པོད་ཀ་ནས་ཅའི་བར་པོ་ཏི་ལྔ་བཞུགས་སོ།",
    "ཐམས་ཅད་མཁྱེན་པ་དངོས་ཀྱིས་ལུང་བསྟན་པ།",
    "བཞེས་ཏེ་སླར་ཡང་རྒྱ་མཚོར་ཆུ་བོ་བཞིན།",
    "ཆུ་འཇམ་པོས་ཁྲུས་བྱས།",
    "གཙུག་ཕུད་འཇོག་པ་སོགས་སྐྱེས་པའི་བྱ་བ་རྣམས་བྱས་ཏེ་རྫིང་ན་གནས་པའི་པདྨོ་བཞིན་དུ་སྐྱེད་བསྲིངས།",
    "འབྲི་ཀློག་གཉིས་ཀ་ཚེགས་མེད་པར་མཁྱེན་ཞིང་བྱིས་པའི་དུས་ནའང་ཐ་མལ་གྱི་སྤྱོད་པ་ལས་འདས་ཤིང་།",
    "ལེགས་བྱས་གཟུགས་གྲུབ་ངོ་འཛིན་ལྟོ།",
    "ངན་སྐྱུགས་ཀྱི་བུམ་པ་བཞིན་དུ་དོར་ཏེ་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་ཞིང་།",
    "བཀའ་རབ་འབྱམས་ཀྱི་མཚན་བཏགས་ཀྱང་རིམ་གྱིས་བཞེས་ཏེ།",
    "རང་ཉིད་ཀྱིས་ཉམས་སུ་བཞེས་ཤིང་།",
    "ནང་མི་རྣམས་ནས་དམ་པ་འདི་ཉིད་ལ་རིགས་རྒྱུད་འཕེལ་བའི་ཐབས་གནང་དགོས་ཞེས་ནན་ཏན་ཆེན་པོའི་སྒོ་ནས་ཞུས་པའི་ཚེ།",
    "བཞད་ཆབ་ཚན་ལ་ཕེབས་པའི་ཞོར་ཁྲོ་བརྒྱ་ཚོ་བའི་ནང་དུ་ཞག་གཅིག་བཞུགས་ནས་ནང་མི་རྣམས་ཀྱིས་མཐོང་ཐོས་ཀྱི་སར་གཟིམས་མལ་བཅས་ཏེ།",
    "ཚོགས་ལ་ཕེབས་པའི་ལམ་བར་དུ་དྲི་ཆུ་མི་ཐུབ་པའི་ཚུལ་བཞེས་པར།",
    "དེ་ལྟར་རྒྱུད་གྲྭའི་ཁྲི་ཐོག་ཏུ་ལོ་བཅུ་གཉིས་ཙམ་བཞུགས་ནས་དགུང་ལོ་བདུན་ཅུ་བའི་མཐར་སླེབས་པ་ན།",
    "ཕྱོགས་མཐར་བསྟན་འགྲོའི་དོན་རྒྱ་ཆེར་མཛད་དགོས་པའི་བཀའ་ཕེབས།",
    "ང་གཉིས་པ་ས་འབྲུག་ལོར་སླར་ཡང་དབུས་སུ་ཕེབས།",
    "དུས་རྟག་ཏུ་མི་འབྲལ་སྤྱི་བོར་བཞུགས།",
    "དྲིན་ལྷག་པར་ཆེ་བའི་བཤེས་གཉེན་འདི།",
    "ཚེ་འདི་སྣང་འཁྲི་བ་ཆོད་པར་གྱིས།",
    "དུས་མྱུར་དུ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "དབྱིངས་འོད་གསལ་ངང་ལས་མ་གཡོས་པར།",
    "དུས་སྐད་ཅིག་འབྲལ་བ་མེད་པར་བཞུགས།",
    "དུས་སྙིགས་མའི་གདུལ་བྱས་མཇལ་དཀའ་བར།",
    "དཔལ་ཟུང་འཇུག་བདེ་ཆེན་བགྲོད་པར་མཛོད།",
    "ལམ་བསླབ་གསུམ་ཉམས་ལེན་གཅེས་པར་སྐྱོངས།",
    "དོན་མ་ནོར་ཉམས་སུ་བླངས་བྱས་ནས།",
    "དགྲ་བདག་འཛིན་རྩ་བ་ཆོད་པར་གྱིས།",
    "དོན་མ་ནོར་ཉམས་སུ་བླངས་བྱས་ཏེ།",
    "དགེ་འདིས་མཚོན་རྣམ་པར་དཀར་བའི་མཐུས།",
    "སྐུ་ཆུང་ངུའི་དུས་པཎ་ཆེན་དཔལ་ལྡན་ཡེ་ཤེས་མཆོག་ནས་རྒྱལ་བ་སྐལ་བཟང་རྒྱ་མཚོའི་ཡང་སྲིད་དུ་ངོས་འཛིན་གནང་།",
    "དགུང་ལོ་གསུམ་ལ་ཕེབས་དུས་བཀྲ་ཤིས་ལྷུན་པོར་གདན་དྲངས།",
    "སྐྱིད་གྲོང་ནས་པཎྜི་ཏ་ཆེན་པོ་ཡེ་ཤེས་རྒྱལ་མཚན་གདན་དྲངས་ཏེ་སྐུ་ཡི་ཡོངས་འཛིན་དུ་བསྟེན་པར་མཛད།",
    "ཆུ་བྱི་ལོར་དངུལ་ཞོ་གང་སྐར་ལྔའི་རིན་ཐང་ཅན་གྱི་བོད་ཊམ་གསར་འགྲེམས་གནང་།",
    "རྒྱལ་ཀུན་མཁྱེན་པའི་སྲང་ལ་གཞལ་དཀའ་བའི།",
    "དགེ་མཚན་དུ་མའི་ལྟས་དང་ལྷན་ཅིག་པར།",
    "གཞུང་ལུགས་གདམས་པར་ཤར་ལ་གསོལ་བ་འདེབས།",
    "བདུད་དཔུང་ཕམ་པར་མཛད་ལ་གསོལ་བ་འདེབས།",
    "བསྙེན་པར་རྫོགས་པའི་དངོས་པོའི་དཔལ་ནོད་དེ།",
    "བློ་གྲོས་ལྷག་པར་འཕེལ་ལ་གསོལ་བ་འདེབས།",
    "སླར་ཡང་དབེན་པར་གཤེགས་ལ་གསོལ་བ་འདེབས།",
    "ཉམས་རྟོགས་ལྷག་པར་འཕེལ་ལ་གསོལ་བ་འདེབས།",
    "བལ་བོད་མཚམས་ཀྱི་སྐྱེ་འགྲོ་མ་ལུས་པར།",
    "ཕྱོགས་དེར་གནས་པར་མཛད་ལ་གསོལ་བ་འདེབས།",
    "རིག་པའི་གནས་ལྔ་མཁྱེན་པའི་པཎྜི་ཏར།",
    "ཕྱོགས་འདིར་འཛུགས་པར་མཛད་ལ་གསོལ་བ་འདེབས།",
    "བདག་པོ་འབྱུང་ཞེས་གསུངས་ལ་གསོལ་བ་འདེབས།",
    "ཐུགས་ཡིད་གཅིག་ཏུ་འདྲེས་པར་བྱིན་གྱིས་རློབས།",
    "འཇམ་མགོན་བསྟན་པ་སྤེལ་ཕྱིར་རིངས་པར་བྱོན།",
    "སྐུ་ན་ཆུང་དུས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་།",
    "སུམ་རྟགས་འགྲེལ་པ་སོགས་མང་དུ་བཞུགས།",
    "ཁྱད་པར་དུ་རྗེ་འདིའི་འདས་ལོ་མི་གསལ་བས།"
  ]
}