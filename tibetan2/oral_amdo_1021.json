    "དེ་བཞིན་གཞན་ཟེར་རྗེས་འབྲངས་མ་ཡིན་པའི་ཁུངས་ལྡན་གྱི་གནས་ཚུལ་རང་གིས་མཐོང་ཐོས་བྱུང་བ་དག་ཚང་མས་དོ་སྣང་ཆེན་པོས་ཡིག་ཐོག་ཏུ་འགོད་དགོས།",
    "ཁོང་གི་ལང་ཚོ་ཤེ་མུན་དུ་འདའ་ཡང་།",
    "འོད་ནམ་མཁའ་ཞེས་པའི་དཔེ་ལྟར་ཁོང་གི་བདེན་པའི་འོད་སྣང་གངས་དཀར་གྱི་དབུ་རྨོག་ལས་རིང་དུ་བརྒལ་ཡོད།",
    "གངས་ལྷ་མོ།",
    "ད་ལྟའི་ང་ཚོས་བློ་བཟང་བསྟན་འཛིན་དང་འབྲེལ་ཡོད་མི་སྣ་དུ་མར་འབྲེལ་གཏུགས་བགྱིས་པ་དང་དེའི་ནང་ནས་ཁོང་གི་སློབ་གྲོགས་གངས་ལྷ་མོ་དང་།",
    "གངས་ལྷ་མོས་བློ་བཟང་བསྟན་འཛིན་སློབ་ཕྲུག་སྐབས་ཀྱི་མི་ཚེ་གླེང་བ་དང་།",
    "ཡུམ་གྱི་མཚན་ལ་སྒྲོལ་དཀར་ཟེར་ཞིང་གཅེན་པོ་བཞི་དང་གཅེན་མོ་གཉིས།",
    "གཅུང་མོ་གཅིག་བཅས་ཁོང་སྡོམ་ན་སྤུན་ཕྲུག་བརྒྱད་ཡོད།",
    "གོང་གཏུགས་པ་ཚོས་རྐང་བཙུགས་ནས་མི་བསད་པའི་གྱོད་གཞིར་ཡིད་མོས་མ་བྱས་པར།",
    "ཞབས་དང་པུས་མོར་ན་ཟུག་གཏོང་བ།",
    "གསུམ་པའི་ལྔའི་ཞི་རྒོལ་སྐབས་རྒྱ་མིས་དྲག་གནོན་མེ་མདའ་བསྟུད་མར་བརྒྱབ་པས་རྨས་སྐྱོན་བྱུང་བའི་བོད་མི་རྣམས་སྤོམ་མདའ་ཚང་གི་ཁང་པའི་གསང་སྤྱོད་ནང་དབོར་ཏེ་རྨས་སྐྱོན་མ་བྱུང་བའི་བོད་མི་རྣམས་ཀྱིས་སྲུང་སྐྱོབ་འོག་ཁྱོན་བོད་མི་སུམ་ཅུ་ཙམ་གབ་སྟེ་བསྡད།",
    "༩སྐབས་ཚམ་ཚོམ་ངང་སྒེའུ་ཁུང་ནས་མར་མཆོངས་པ་རེད།",
    "ཡོན་ཧྲེ་ཧྲན་གསོད་མཁན་བློ་བཟང་བསྟན་འཛིན་རེད་ཅེས་ཉེས་བཙུགས་བྱས་པ་དང་།",
    "ཡང་དེའི་རྗེས་གསོད་མཁན་བློ་བཟང་བསྟན་འཛིན་མ་རེད་ཅེས་རྒྱ་མིའི་ཆབ་སྲིད་དགོས་མཁོར་བརྟེན་ནས་གནས་ཚུལ་ལ་འགྱུར་བ་གཏོང་གི་ཡོད་པ་མ་གཏོགས་དངོས་ཡོད་གནས་ཚུལ་ཕྱི་རོལ་དུ་མི་སུ་གཅིག་གིས་ཤེས་ཐབས་མེད།",
    "རུ་ཁག་དེའི་ནང་ཆབ་སྲིད་བཙོན་པ་བློ་བཟང་བསྟན་འཛིན་སོགས་བརྒྱད་འདུག་པ་ཁོང་ཚོ་ཚལ་ཞིང་འདེབས་ལས་བྱེད་བཅུག་གི་འདུགརུ་ཁག་གཉིས་པ།",
    "རུ་ཁག་གཉིས་པའི་ནང་ཆབ་སྲིད་བཙོན་པ་བདུན་འདུག་པ་དང་ཁོང་ཚོ་ལ་ཨར་ལས་བསྐུལ་གྱི་འདུགརུ་ཁག་གསུམ་པ།",
    "རུ་ཁག་བཞི་པའི་བཙོན་པ་རྣམས་ཀྱི་ལས་ཀ་ནི་དྲོད་ཁང་གི་ལས་ཀ་བྱེད་མཁན་ཁ་ཤས་ལས་ཕལ་ཆེ་བ་མོ་ཊ་དང་།",
    "ལྕགས་རྡུང་རྒྱུ་སོགས་རེད།",
    "བོད་སྤྱིའི་དོན་དུ་དེ་ལྟ་བུའི་བསམ་བློ་བཏང་བ་ཡག་པོ་རེད་ཀྱང་རང་ཉིད་ཀྱི་ཚེ་སྲོག་རྩ་ཆེན་པོ་རེད།",
    "རྒྱུ་གྲོན་ཐབས་འཚོལ་བྱེད་མི་དགའ་ལྡན་བཀྲ་ཤིས་ཀྱིས་ཁས་བླངས་པ་རེད།",
    "༡༥གསང་བའི་ངང་བཙུགས་པ་རེད།",
    "ནང་ཆབ་སྲིད་བཙོན་པ་ཁེར་རྐྱང་རུ་ཁག་ལྔ་པ་གསར་དུ་བཙུགས་པ་རེད།",
    "འགྲོ་སྟངས་གཞིར་བཟུང་ན་རུ་ཁག་བཞི་པའི་སྟེང་གི་ཁང་པ་དེ་ལྔ་པ་བཟོ་འོས་ཀྱང་ཆབ་སྲིད་བཙོན་པར་ཆེད་དུ་སྡུག་སྦྱོང་སྤྲོད་ཆེད་རྒྱབ་ཏུ་ཁང་རྙིང་གོག་རུལ་ཞིག་ཡོད་པ་དེའི་ནང་བཅུག་ནས་བཞག་བྱུང་།",
    "དེ་དུས་ནས་བཟུང་བློ་བཟང་བསྟན་འཛིན་དང་ང་ཚོ་མཉམ་དུ་བྱུང་བས་བློ་མཐུན་མི་བཟང་མཉམ་འཛོམས་བྱུང་རྐྱེན་ང་ཚོའི་མཛའ་བརྩེ་ཉིན་རེ་ལས་མ་འདས་པ་གོང་མཐོར་ཕྱིན་ནས་ཧ་ཅང་ཡིད་གཅུགས་སུ་གྱུར།",
    "དུས་ཕྱིས་ཕྲན་དང་བློ་བཟང་བསྟན་འཛིན་ཉལ་ཁང་གཅིག་ཏུ་ཁེལ་ཞིང་རང་ངོས་ནས་བློ་བཟང་བསྟན་འཛིན་ལ་ཁ་ཞེ་གཉིས་མེད་སེམས་དབུས་ནས་གུས་ཞབས་དང་བརྩི་མཐོང་ཆེན་པོ་བྱེད་ཀྱི་ཡོད་ལ་ཁོང་གི་རྐང་པ་ལྕགས་སྒྲོག་གིས་བཅིངས་ཡོད་རྐྱེན་དཀའ་ངལ་ཧ་ཅང་ཆེ་བས་གྱོན་གོས་བཀྲུ་རྒྱུས་མཚོན་ཞབས་ཕྱི་ཞུ་རྒྱུར་ཧུར་སེམས་ཀྱིས་འབད་བརྩོན་བྱེད་ཀྱི་ཡོད།",
    "༡༩དགུན་དུས་ཡིན་ཡང་བློ་བཟང་བསྟན་འཛིན་དོར་མ་སྲབ་པོ་ཞིག་ལས་གྱོན་མི་ཐུབ་ཅིང་ང་ཚོས་དེ་བརྗེ་དུས་རྐང་པ་གཉིས་དབར་ལ་ལྕགས་ཡོད་པས་དོར་རྟ་བཤགས་ནས་ཐེབས་ཆི་བརྒྱབ་རྒྱུ་ཡོད་པ་བཟོས་ཡོད།",
    "དེའི་ལན་བློ་བཟང་བསྟན་འཛིན་གྱིས་ཉམས་སྣང་སྤུ་ཙམ་མེད་པར་ག་རེ་བྱེད་རྒྱུ་ཡོད་ཀྱང་ཁྱེད་ཚོའི་ལག་པར་ཡོད་པས་འདོད་པ་ལྟར་གྱིས་ཤིག་ཅེས་བརྗོད་པ་དང་།",
    "བློ་བཟང་བསྟན་འཛིན་གྱིས་སུ་ཞིག་ཡིན་ཡང་རང་ཉིད་ཀྱི་ཚེ་སྲོག་རྩ་ཆེན་པོ་ཡིན་པས་ང་འཆི་རྒྱུར་ཞེད་ཀྱི་འདུག་འོན་ཀྱང་ཁྱེད་རང་ཚོར་ཆ་བཞག་ན་རྒྱ་ནག་རྒྱལ་ཁབ་དོན་དུ་དཀའ་ལས་རྒྱག་མི་དང་སྲོག་བློས་གཏོང་མཁན་དེ་ཚོ་མི་ཐ་ཤལ་ཞིག་ལ་མ་བརྩིས་པར་དཔའ་བོར་བརྩི་ཡི་འདུག་པ་དེ་བཞིན་ང་བོད་བསྟན་པ་ཆབ་སྲིད་ཀྱི་དོན་དུ་འཆི་ན་བོད་མི་མང་གིས་དཔའ་བོར་བརྩི་ཡི་རེད།",
    "གཅོག་པར་ཐ་མག་གཅིག་འཐེན་སོང་ནམ་རྒྱུན་ཐ་མག་འཐེན་གྱི་མེད་ཀྱང་ངས་ཨུ་ཚུགས་བརྒྱབ་སྐབས་ད་གཟོད་རེ་ཙམ་འཐེན་གྱི་རེད།",
    "གྲ་སྒྲིག་ག་རེ་བྱེད་དགོས་སམ་ཞེས་བརྗོད་བྱུང་།",
    "༡༩༩ ཟླ་༡ ནང་གི་དགོང་མོ་ཞིག་ང་ཚོ་ཉལ་ཚར་ཙམ་ལ་རྒྱའི་ཉེན་རྟོག་པའི་ཆབ་སྲིད་ཨུ་ཡོན་གཞོན་པ་པད་མ་རིན་ཆེན་དང་།",
    "ང་ཚོའི་ཉལ་ཁང་ནས་བློ་བཟང་བསྟན་འཛིན་དང་།",
    "རྐྱེན་རྒྱུགས་དུས་དང་དགྱེད་དགུར་དཀའ་བས་གློག་རྒྱུག་ཞུ་བ་དང་གློག་བཏང་ནས་བཙུགས་པ་བཅས་ཀྱི་དཀའ་ངལ་ཆེ་ཤོས་བྱུང་སོང་།",
    "ཉེས་རྡུང་གཏོང་མི་ཉེན་རྟོག་པ་ཀརྨ་མ་གཏོགས་གཞན་ཚང་མ་ཉིན་གུང་གི་ལས་བྱེད་ཡིན་པ་ལས་དགོང་མོ་འགན་འཁྲི་གང་ཡང་མེད་ཀྱང་ང་ཚོའི་ལྟ་སྤྱོད་ནམ་རྒྱུན་ནས་གྱོང་པོ་འདུག་ཅེས་ཆེད་དུ་མནར་གཅོད་གཏོང་བར་ཡོང་བ་རེད།",
    "རྡོག་པས་རྫིས་པ་བཅས་བྱས་སོང་།",
    "ལྷག་པ་ཚེ་རིང་ཉལ་ཁང་བརྒྱད་པ་དང་ང་བདུན་པ་ཡིན་པས་དགོང་མོ་མཉམ་དུ་མེད་ཀྱང་ཉིན་མོ་ལས་ཀར་མཉམ་དུ་འགྲོ་སྐབས་གཟུགས་པོར་ན་ཟུག་བཏང་བ་དང་།",
    "དེའི་མཚན་མོ་ཆུ་ཚོད་བཅུ་པ་ཙམ་ལ་ལྷག་པ་ཚེ་རིང་གིས་ཟུག་རྔུ་བཏང་བའི་སྐད་བཏོན་པ་ཐོས་མ་ཐག་ཉལ་ཁང་བདུན་པ་དང་།",
    "སྤྱི་ལོ་༡༩༩ ཟླ་༡༢ ཚེས་༡༤ མཚན་མོའི་ཆུ་ཚོད་བཅུ་གཅིག་ཙམ་ལ་ལྷག་པ་ཚེ་རིང་གྲོངས་འདུག་དེའི་དགོང་མོ་ཆུ་མང་པོ་དབོར་འགྲོ་བ་ཕུང་པོ་བཀྲུ་བྱེད་ཡིན་ནམ།",
    "དུག་གི་ནུས་ལྷག་ཕུང་སྟེང་ནས་མེད་པར་བཟོ་བྱེད་ཡིན་གང་ལྟར་བཙོན་པ་ཚང་མར་དུག་གིས་བསད་པའི་དོགས་གཞི་བྱུང་སོང་།",
    "གཞན་གཅིག་གསོན་པོར་གནས་པའི་ཆབ་སྲིད་བཙོན་པའི་གནས་བབ་ལེགས་བཅོས་བྱེད་དགོས་ཞེས་ཡིག་ཕྲེང་ཆེན་པོ་གཉིས་བྲིས་པའི་ཕྲེད་དར་གཉིས་བཟོས་རྗེས་ཕྲན་དར་རྒྱུག་བསྒྲུབ་པར་འགྲོ་ཁར་བློ་བཟང་བསྟན་འཛིན་གྱིས་ལས་ཀ་མགོ་མ་བཙུགས་གོང་གཞན་གྱིས་ཤེས་ན་ལས་དོན་ལ་བར་ཆད་ཡོང་གི་རེད།",
    "དེར་རྟེན་གཟབ་གཟབ་བྱས་ནས་སུ་ཞིག་ལ་ཡང་དོགས་འདྲོགས་མ་སློངས་ཤིག་ཟེར་གྱི་འདུག་པས་ངས་ཡཱ་ཡཱ་ཟེར་ནས་མར་དོན་ནས་ཐབ་ཚང་གི་ཤིང་བཞག་ཡུལ་ནས་རྒྱུག་པ་བཞི་བསྒྲུགས་པ་ཡིན།",
    "འབྲས་སྤུངས་སྐལ་བཟང་དང་ཁོང་གཉིས་ཀྱིས་ཡིད་སྐྱོའོ་ངང་ནས་འདས་པོ་ལྷག་པ་ཚེ་རིང་ལ་མྱ་ངན་ཞུ་ཞེས་པའི་ཕྲེད་དར་དེ་འཁྱེར་ནས་དོན་ཕྱིན་མ་ཐག་རྒྱ་དར་དང་ང་གཉིས་ཀྱིས་གསོན་པོར་གནས་པའི་ཆབ་སྲིད་བཙོན་པའི་གནས་བབ་བསྒྱུར་བཅོས་བྱེད་དགོས་ཞེས་པའི་ཕྲེད་དར་དེ་བཟུང་སྟེ་ང་ཚོ་མི་བཞི་སྒོ་ནས་མར་འཚང་ག་ཤིག་ཤིག་དོན་ནས་མེ་ཏོག་ལྡུམ་རར་སྐོར་བ་བརྒྱབ་པ་ཡིན།",
    "༣༣ཞྭ་མོ་ཕུད་ཅིང་ཕྲེད་དར་མདུན་དུ་བཀྲམས།",
    "ག་རེ་ཡིན་ཞེ་ན།",
    "ཁྱེད་རང་ཚོས་ཆ་རྐྱེན་ག་རེ་བཏོན་ཡང་ང་ཚོས་ཁས་བླང་གི་ཡིན།",
    "འོན་ཀྱང་ཁྱེད་ཚོས་དེ་རིང་གི་ལས་འགུལ་འདི་མཚམས་འཇོག་བྱེད་དགོས།",
    "གལ་སྲིད་ད་དུང་མུ་མཐུད་ལས་འགུལ་རྒྱུན་འཁྱོངས་བྱ་ན་དྲག་གནོན་བྱ་རྒྱུའི་རྣམ་པ་བསྟན་སོང་།",
    "མི་ཁ་ཤས་ཀྱིས་དགོས་འདུན་ཡིག་ཐོག་ལ་བྲིས་ནས་སྤྲད་སོང་བ་དང་།",
    "དེ་རིང་ང་ཚོས་ལས་ཀ་འདི་ཙམ་བྱས་པས་འགྲིག་པ་རེད།",
    "ད་ལྟ་ང་ཚོས་རྒྱབ་ལྗོངས་ལ་བསམ་བློ་མ་གཏང་ན་ནུས་པ་ཐོན་པའི་དོན་མ་འགྲུབ་པར་མི་མང་པོ་ཞིག་འཕྲོག་བརླགས་འགྲོ་རྒྱུ་ཡིན་པ་གཏན་འཁེལ་བས་བསམ་བློ་གཏོང་བའི་དུས་ཚོད་སླེབས་འདུག་ད་བར་ཡག་པོ་བྱུང་སོང་།",
    "ད་དུང་ཨུ་ཚུགས་རྒྱག་གིན་བསྡད་པ་ཡིན་ན་ཁེ་གྱོང་བསྡུར་ཐུབ་ཀྱི་མ་རེད་ཟེར་བྱུང་བས་གཞི་ནས་གློད་པ་ཡིན།",
    "ལས་འགུལ་མཚམས་མ་བཞག་གོང་ང་ཚོས་རེ་བ་ལྔ་བཏོན་པ་རེད།",
    "ནང་ཕོར་པ་དང་སྤག་གི་མཆོད་ཀོང་བཟོས་ནས་ལྷག་པ་ཚེ་རིང་དེ་ཉིད་ཀྱི་ཆེད་ཉལ་ཁང་གི་རྒྱ་ཅོག་སྟེང་མཆོད་མེ་ཕུལ་བ་ཡིན།",
    "ཅུང་ཕྱི་པོ་གྱུར་རྗེས་གཞན་ཚང་མ་ཉལ་སོང་ཡང་ང་རང་ལྷག་པ་ཚེ་རིང་འདས་པོ་ཡིད་ལ་འཁོར་ཏེ་སེམས་རྣལ་དུ་མི་གནས་པས་མ་ཉལ་བར་བསྡད་ཡོད།",
    "དགོང་མོ་ཆུ་ཚོད་༡ ཙམ་ལ་མ་བྱན་གྱི་ཚོགས་ཆུང་ནང་སྐད་ཅོར་རྒྱག་གི་འདུག་པ་བློ་བཟང་བསྟན་འཛིན་གྱིས་ག་རེ་ཡིན་ནམ་ཡག་པོ་ཉོན་དང་ཟེར་བྱུང་བ་ཉན་སྐབས།",
    "༣༧སངས་ཀྲང་ཨུད་ཆབ་སྲིད་དོ་དམ་པ་གཉིས་ཉེན་རྟོག་པ་ཁ་ཤས་འཁྲིད་ནས་སྐོར་བ་རྒྱག་པར་ཡོང་བ་དང་བཀྲ་ཤིས་ཁའོ་ཀྲང་གིས་ཁྱེད་མཆོད་མེ་སྤར་ནས་ག་རེ་བྱེད་ཀྱི་ཡོད་དམ།",
    "ང་མ་ཉལ་བར་གཅིག་པུར་བསྡད་ཡོད་རྐྱེན་བཀྲ་ཤིས་ཁའོ་ཀྲང་གིས་ཁོ་རེ་ཉལ་གྱི་མིན་ནམ།",
    "སྤར་ཆོག་གི་རེད་དམ་ཞེས་བརྗོད་བྱུང་བ་སྤར་མི་ཆོག་ཀྱང་མི་ཤི་བས་སྤར་གྱི་ཡོད་ཅེས་ཁོ་པར་ཁྱད་གསོད་ཤ་སྟག་བགྱིས་པས་བློ་བཟང་བསྟན་འཛིན་ཉལ་སར་གད་མོ་བགད་ནས་བསྡད་འདུག་ང་ཚོས་ཡ་ལན་དེ་ལྟར་སློག་ཀྱང་ཚུར་དྲག་གནོན་མ་བྱས་པ་ནི།",
    "དེ་ལ་ང་ཚོས་མི་དུ་མས་དྲི་བ་བཀོད་པའི་ནང་ནས་རྒྱུ་ལྷག་ཡིན་ན་ཙོག་པའི་ནང་ཁྲག་དང་རྣག་དོན་པ་ག་རེ་ཡིན་ནམ།",
    "ཞེས་དྲིས་པ་རེད།",
    "མི་མ་ཤི་ནའང་ན་ཚ་རྩད་མ་ཆོད་པ་གཅིག་པུས་གླ་ཆ་བཅགས་གོ་ས་ཕབ་བྱས་འདུག་ད་རེས་ན་ཚ་རྩད་མ་ཆོད་པར་མི་ཤི་བ་དེ་ལ་ཉེས་པ་ཕོག་གི་རེད་དམ།",
    "འགོ་ངས་བརྩམས་མཇུག་ཁུངས་འཁྱོལ་བ་མི་འདུག་ཅེས་མི་གཞན་ལ་རྩིས་སྤྲོད་བྱ་རྒྱུ་ངའི་དམིགས་ཡུལ་ཞིག་མིན་ལ་ཉེས་འགན་ཅི་འདྲ་ཞིག་ཕོག་ཀྱང་གཙོ་བོའི་འགན་འཁྲི་ང་རང་གིས་འཁྱེར་ཏེ་གནས་ཚུལ་ག་པར་ཐུག་ཀྱང་ཁྱད་པར་གང་ཡང་མི་འདུག་དེ་མིན་རོགས་པ་སུ་སུ་ཡོད་དམ་ཞེས་བརྗོད་ན་ཚང་མས་མཐོང་བས་ངས་སྦས་སྐུམ་བྱེད་ཐབས་མེད་ཅེས་བརྗོད་སོང་།",
    "ཡང་བསྐྱར་ལྷག་པ་ཚེ་རིང་གི་དོན་རྐྱེན་གྱི་འགན་འཁུར་གཙོ་བོ་ཡིན་པས་ཉེན་འགན་ཤིན་ཏུ་ལྗིད་པོ་གྱུར་པས་བཙོན་པ་ཚང་མའི་སེམས་ནང་བློ་བཟང་བསྟན་འཛིན་ལ་སེམས་ཁྲལ་བྱེད་ཀྱི་ཡོད།",
    "འོན་ཀྱང་མ་གསད་བར་བོད་མི་མང་ལ་ཕན་ཐོགས་པའི་ལས་ཀ་ཕྲན་བུ་ལས་མེད་ཀྱང་བྱེད་ཐུབ་ན་རང་གི་དམིགས་ཡུལ་དང་འཚམས་པ་ཞིག་ཡིན།",
    "༤༣བ་ཡ་མ་ཟུང་ཞིག་སྐྱེ་བཅུག་གི་རེད།",
    "ལས་འགུལ་དེ་འདྲ་ཞིག་མ་སྤེལ་ན་མ་འོང་པར་ཆབ་སྲིད་བཙོན་པ་མང་པོ་ཞིག་ཆུད་ཟོས་འགྲོ་རྒྱུ་གཏན་འཁེལ་བས་ངས་འགོ་འཁྲིད་དེ་ངོ་རྒོལ་གྱི་ལས་འགུལ་སྤེལ་བ་ཡིན་ཞེས་ཁས་ལེན་དོན་པས་ལས་དོན་རུ་ཁག་གི་ལས་ཀ་སྟབས་བདེ་པོ་གྱུར་ཏེ་སྐབས་དེར་མི་སུ་ལའང་ལམ་སེང་ཐག་གཅོད་བྱས་མ་སོང་ཡང་རྗེས་སུ་བློ་བཟང་བསྟན་འཛིན་སྤོ་བོ་སྤྲ་རྨོག་ཏུ་བསྐྱལ་དགོས་གནས་ཚུལ་དེ་དང་འབྲེལ་བ་ཡོད།",
    "ཁྱེད་རང་ཡག་པོ་ཆགས་རྒྱུ་དེ་རེད།",
    "ང་ཚོས་ཉམས་ཞིབ་བྱེད་དུས་ཁྱེད་རང་ཡག་པོ་ཆགས་ཀྱི་རེད་བསམས་པའི་ཡིད་ཆེས་ཀྱང་བྱེད་ཀྱི་ཡོད།",
    "སྔར་ཟུར་དུ་ཐག་གཅད་རྒྱུ་ཞེས་ཁྲོམ་བསྒྲགས་བྱས་པས་ཁ་སྐྱེངས་ངང་ལོ་ཚད་བཅག་པ་དང་རྐང་ལྕགས་བཀྲོལ་པ་རེད།",
    "ཕྱི་ནང་གི་རྒྱུ་རྐྱེན་དེ་དག་གི་ས་བློ་བཟང་བསྟན་འཛིན་བསྐྱབས་ཐུབ་པ་བྱུང་བ་དེ་ནི་སྐབས་དེར་བཙོན་པ་རྣམས་ཀྱི་ཡིད་ལ་ངལ་གསོ་ཞིག་བྱུང་བ་མ་ཟད་མཐར་གཏུག་ན་བོད་རྒྱལ་ཁབ་དང་མི་མང་གི་བདེན་པའི་གཟི་བརྗིད་དང་རྒྱལ་ཁའང་ཡིན།",
    "དེ་ནས་ཉིན་ཁ་ཤས་ཕྱིན་མཚམས་ཞིག་ནས་ང་ཚོའི་ཚོགས་ཆུང་ཁ་གཏོར་ཏེ་བློ་བཟང་བསྟན་འཛིན་ཚོགས་ཆུང་དང་པོ་དང་ང་ཚོགས་ཆུང་གསུམ་པའི་ནང་བསྐྱལ་བྱུང་།",
    "ང་ཚོ་ཚོགས་ཆུང་མི་འདྲ་ཡང་དགོང་དྲོ་ཉལ་དུས་ལས་ཉིན་མོ་ལས་ཡུལ་གཅིག་ཡིན།",
    "ཁོང་ཕེབས་རྒྱུར་བརྒྱ་ཆ་བརྒྱ་ཐག་ཆོད་འདུག་ད་དུང་བློ་བཟང་བསྟན་འཛིན་གྱིས་རྩེད་མོའི་རྣམ་པས་ཁྱེད་འཆར་གཞི་ག་རེ་ཡོད་དམ་ཟེར་བྱུང་།",
    "ཆབ་སྲིད་བཙོན་པར་རྒྱ་གཞུང་གིས་བལྟ་སྟངས།",
    "བོད་པའི་བསམ་བློའི་འཁྱེར་ཚུལ་བཅས་ཡི་གེ་འབྲི་བཞིན་ཡོད་ཀྱང་ད་ལྟ་ཚར་མ་སོང་ཟེར།",
    "ངས་ག་རེ་བྱས་ནས་གཉིས་བཟོ་དགོས་སམ་ཞེས་དྲིས་པས།",
    "སྐུ་ཞབས་འཇེམ་སེ་ལེ་ལིར་འབུལ་རྒྱུའི་ཡི་གེ་དེ་རྒྱ་མིས་འཕྲོག་པ་ཡིན་ན་མ་དཔེ་གཅིག་ང་ཚོར་དགོས་ཀྱི་རེད་ཟེར།",
    "ནམ་རྒྱུན་སློབ་ཚན་ཚུགས་ཀྱི་མེད་ཀྱང་བལྟ་སྐོར་ཡོང་སྐབས་སློབ་ཁང་གི་གཙང་སྦྲ་དང་འཛིན་ཆས་བཅས་གྲ་སྒྲིག་ཆ་ཚང་བ་བྱས་ཏེ་སློབ་ཚན་འཚོགས་ཀྱི་རེད།",
    "ང་ཚོའི་ལྟ་བ་དེ་ག་དུས་ཡིན་ཡང་བོད་རང་བཙན་བཙོན་ལེན་དང་གཞིས་བྱེས་མཉམ་འཛོམས་ཡོང་བ་བྱ་རྒྱུ་ལས་མེད་ན།",
    "དོན་དེ་ལ་མུ་མཐུད་རྒྱབ་སྐྱོར་གནང་རོགས་གྱིས་ཞེས་གསུངས་པ་རེད།",
    "གུང་ཁྲན་ཏང་གི་དབུ་འཁྲིད་འོག་ཕྱིན་པའི་རྗེས་ཁྱེད་རང་ལ་གྱོང་རག་གི་མ་རེད་དེར་རྟེན་འདིའི་ནང་བསྒྱུར་བཀོད་ཡག་པོ་གཏོང་དགོས་ཞེས་སྒྱུར་བ་རེད།",
    "ཨ་རི་བ་སྐུ་ཞབས་འཇེམ་སེ་ལེ་ལིའི་སྐད་བསྒྱུར་ཉེན་རྟོག་པ་རྒྱ་མོ་ཞིག་ཡོད་པ་དང་སྐུ་ཞབས་གཡུ་ལོ་དང་མཇལ་འཕྲད་གནང་སྐབས་ཉེན་རྟོག་པས་མཐའ་སྐོར་ནས་ཡོད།",
    "མཇུག་ཏུ་ང་ཚོས་ཡི་གེ་གཞན་དེ་འཕྲོད་ཐབས་གསང་འཆར་ཞིག་བགྱིས་ནས་བློ་བཟང་བསྟན་འཛིན་གྱིས་ཡི་གེ་འདི་ཁ་སྔོན་ཁྱེད་ཚོར་བཙོན་པ་ཞིག་གིས་སྲོག་ལ་མ་ལྟོས་པར་སྤྲད་ཀྱང་ངོ་ཚ་མེད་པའི་སྐད་སྒྱུར་གྱིས་འཕྲོག་པའི་ཡི་གེ་དེ་དང་ནང་དོན་གཅིག་མཚུངས་ཡིན་ཞེས་མཆན་བུ་ཞིག་བྲིས་ཏེ་འཐབ་གྲོགས་ཞིག་གི་རྐང་ལྷམ་མཐིལ་བཀོག་ནས་དེའི་ནང་ཡི་གེ་བླུགས་ཏེ་སྐུ་ཞབས་འཇེམ་སེ་ལེ་ལི་ཕན་ཏན་གསོལ་མགྲོན་ཁང་ནང་བཞུགས་འདུག་པ་མི་བརྒྱུད་ངེས་སྤྲོད་བྱས་འདུག་ང་རྒྱ་གར་དུ་སླེབས་རྗེས་བདེ་སྲུང་དྲུང་ཆེ་དངོས་གྲུབ་ལགས་ཀྱིས་ཡི་གེ་དེ་འདྲ་ཞིག་འབྱོར་ཡོད་པ་རེད་ཅེས་གསུངས་བྱུང་།",
    "བློ་བཟང་བསྟན་འཛིན་སྔོན་མའི་མི་ངན་དེ་མ་རེད་ཟེར།",
    "༥༣བློ་བཟང་བསྟན་འཛིན་སྔོན་མའི་མི་ངན་དེ་མ་རེད་ཟེར།",
    "འཛིན་གྱིས་གསང་གནས་དེ་ཐོས་ཏེ་ཉིན་ཞིག་ང་གསང་སྤྱོད་ཁུག་ཀྱོག་ལ་འཁྲིད་ནས་ཁྱེད་རང་ལས་འགུལ་ཞིག་སྤེལ་རྩིས་ཡོད་པ་འདྲ་རེད་དམ་ཞེས་དྲིས་བྱུང་།",
    "དེ་བློ་བཟང་བསྟན་འཛིན་སྔོན་མའི་མི་ངན་དེ་མ་རེད་ཟེར།",
    "ང་ཚོས་འཆར་གཞི་ཚང་མ་སྒྲིག་ཚར་བའི་རྗེས་ལ་འབྲས་སྤུངས་སྐལ་བཟང་སོགས་ཀྱིས་ལས་འགུལ་དེ་སྤེལ་ན་ཆབ་སྲིད་བཙོན་པ་མང་པོ་ཞིག་ལ་བརྡབ་སིག་འཕྲད་རྒྱུ་ཡིན་པས་མཚམས་འཇོག་བྱེད་དགོས་ཞེས་ནན་ཏན་བརྗོད་བྱུང་ཡང་།",
    "ང་ཚོ་ཚང་མས་སེམས་ཐག་གཙང་མ་བཅད་དེ་གྲ་སྒྲིག་བྱས་པ་ཡིན་ལ་ལས་འགུལ་དེས་ཁེ་གྱོང་གཉིས་བསྡུར་ཐུབ་ཀྱི་རེད་ན་ཕྱིར་འཐེན་བྱེད་ཐབས་མེད་ཅེས་བཤད།",
    "ད་སྐབས་སྔོན་མའི་མི་ངན་དེ་མ་རེད།",
    "ཁོ་རང་གིས་བྱས་རྗེས་ཡག་པོ་བཞག་པས་སྲོག་ཐོག་གཏང་རྒྱུ་ཕྱིར་འཐེན་གྱིས་ཉེས་འགན་ཚེ་བཙོན་དུ་ཕབ་ཡོད་ཅེས་མངོན་སུམ་ལ་སྙོན་པའི་རྫུན་གཏམ་དྲི་ངན་དྲོ་བ་ཞིག་བྱས་སོ།",
    "ང་ཚོས་བྱས་པ་ཅན་གྱི་རྒྱལ་གཅེས་དཔའ་རྒོད་དེའི་བཀའ་དྲིན་མགོ་རུལ་རྣ་བས་མ་ཚོར་བ་ལྟ་བུ་མུ་མཐུད་གནས་ན་ནམ་ཞིག་རྒྱ་གཞུང་གིས་བློ་བཟང་བསྟན་འཛིན་ལ་འཛིན་པའི་དམིགས་ཡུལ་བློ་བཟང་བསྟན་འཛིན་སྔོན་མའི་མི་ངན་དེ་མ་རེད་ཟེར།",
    "འོན་ཀྱང་སྐུ་ཞབས་ཁོང་གིས་ཡི་གེའི་ནང་དོན་ཤེས་ཀྱི་མེད་ལ་བཙོན་པ་སུ་ཞིག་གིས་ཀྱང་དོན་རྐྱེན་དེའི་སྐོར་ཅི་ཡང་ཤེས་ཀྱི་མེད།",
    "དེའི་ནང་ག་རེ་འཁོད་ཡོད་མེད་ཁྱེད་རང་ཚོའི་ལག་པར་ཡོད་པས་སྐད་ཆ་དྲི་དགོས་པའི་གཞི་རྩ་མེད།",
    "ངའི་ཡི་གེའི་ནང་དངོས་ཡོད་ལས་འདས་པའི་གནས་ཚུལ་གཅིག་འདུག་ན་ང་ལ་ཉེས་འགན་ཐག་གཅོད་ཅི་འདྲ་ཞིག་བྱེད་དགོས་བསམས་ཀྱང་ཁྱེད་རང་ཚོའི་ལག་པར་ཡོད་པས་རེ་འདོད་ལྟར་གྱིས།",
    "ལ་ངས་ག་དུས་ཞུས་བྱུང་ཁྱོད་རང་གིས་ང་ལ་ཞུས་མེད་དམ་ཟེར།",
    "ངས་ཨ་པའི་རོ་ཞེས་ཇ་དམ་དེ་ཕར་བཞག་ཁོའི་བྲང་ཁོག་ནས་ལག་གཡོན་གྱིས་བཟུང་ལག་གཡས་སུ་འཁྱེར་བའི་མོག་དེ་ཤུགས་གང་ཡོད་ཀྱིས་ཁོའི་གདོང་པར་ཞུས།",
    "ཡང་བསྐྱར་ཐེངས་གཉིས་པ་ཞུས་སྐབས་ལག་པ་ཡང་པོར་སྟོང་གཡུག་གྱུར་སོང་བ་ག་རེ་ཡིན་སྙམ་བལྟས་པས་མོག་གོག་ནས་ལྕགས་ལུང་ལས་ལག་པར་བསྡད་མི་འདུག་ཨམ་ཐེར་བར་མོག་འཕོག་སའི་གདོང་པ་དམར་པོ་བཟོས་པ་མ་ཟད།",
    "མོག་རྩི་གདོང་པར་འགོས་ནས་ཙིར་ཙིར་ཞེས་ཚུར་གོག་ཡོང་གི་འདུག་ཨམ་ཐེར་བས་ངུ་ངག་ཆེ་བར་སྒྲོག་གི་འདུག་ཀྱང་ངས་སྐྲ་དེ་ནས་བཟུང་མར་མནན་ཉེས་རྡུང་བློ་ཡིད་ཚིམས་པ་ཞིག་གཏོང་སྐབས་ཕུར་ཚིང་གིས་བར་མིའི་ཚུལ་བྱེད་སྐབས་ཨམ་ཐེ་རས་ལྡེ་མིག་ང་ལ་ཞུ་སྐབས་ཐུག་ཙམ་འཕོག་པར་སྙད་འདོགས་བྱས་ཏེ་ང་ལ་ལྡེ་མིག་ཞུས་བྱུང་ཞེས་ཉེས་རྡུང་མཉམ་རུབ་ཀྱིས་བཏང་སྐབས་ཧོར་བླ་རྒན་མཚན་དངོས་ལ་བློ་བཟང་བརྩོན་འགྲུས་ཞུ་ཞིང་།",
    "བཙོན་པ་གཞན་ཚང་མ་དགའ་སྣང་ཆེན་པོས་ལྟད་མོ་བལྟས་ནས་བསྡད་པ་ལས་བར་མི་བྱེད་མི་སུ་གཅིག་མི་འདུག་ཀྱང་སྐུ་ཞབས་ཐུབ་བསྟན་ཚེ་རིང་ལགས་ཕེབས་ཏེ་དེ་རིང་དེ་ཙམ་རེད་གཡུགས་ཞོག་ཅེས་གསུངས་བྱུང་བ་མཚམས་བཞག་བྱས་པ་ཡིན།",
    "དེ་ནས་རྒྱ་མིས་རྙོག་དྲ་ལྷགས་རྒྱུར་དོགས་ཟོན་གྱིས་མི་ཚང་མ་ཡར་བཅུག་སྟེ་ཉལ་ཁང་ཐམས་ཅད་སྒོ་བརྒྱབ་ནས་ང་གཅིག་པུར་ཤོག་ཟེར་བྱུང་བ་ཡིག་ཚང་ནང་ཕྱིན་པས་དེ་རིང་གནས་ཚུལ་གྱི་འབྱུང་རྐྱེན་གང་རེད་དམ་ཞེས་བརྗོད་བྱུང་།",
    "དེ་ནས་ཉེས་རྡུང་མ་བཏང་བར་ལོག་རྒྱུགས་ཞེས་ལབ་བྱུང་བས་སེམས་ནང་ཅུང་ཡ་མཚན་བྱུང་ཚུར་ལམ་ཚེ་རིང་ཁའོ་ཀྲང་འགན་འཛིན་གིས་ཁྱེད་ཀྱིས་བྱེད་བབ་ལ་བལྟས་ན་དེ་རིང་མནར་གཅོད་ཅིག་གཏོང་དགོས་ཀྱང་ཆོ་མི་འདུག་ཁྱོད་རང་ས་ཆ་ག་པར་སླེབས་ཀྱང་འདི་གར་རྟག་ཏུ་སྔོན་ཐོན་བྱས་པ་བཞིན་བགྱི་ན་གྱོང་ལས་ཁེ་བཟང་ཐོབ་ཐབས་མེད་པས་གཟབ་གཟབ་གྱིས།",
    "དེ་མཐའ་མའི་ཐག་གཅོད་རེད།",
    "བློ་བཟང་བསྟན་འཛིན་གྱིས་རྒྱ་དམར་ཁོ་པས་ག་རེ་ཡིན་ཡང་བྱེད་སྲིད་པ་རེད་འོན་ཀྱང་ང་ཚོས་ད་བར་བྱས་པ་ཚང་མ་འགྲིག་ཡོད་པས་བསམ་བློ་བརྟན་པོའི་ཐོག་འགྱོད་པ་སྤུ་ཙམ་བྱེད་དགོས་མེད།",
    "གལ་ཏེ་སི་ཁྲུའུ་ནང་ཁང་པར་གཅིག་པུ་བཅུག་ཚེ་ལས་ཀ་མེད་པར་བཞག་གི་ཡོད་པས་གཟུགས་པོ་ཆུད་ཟོས་མ་འགྲོ་བའི་ཆེད་སྐུ་ཕྱག་འབུལ་རྒྱུ་དང་ལུས་རྩལ་རྩེད་དགོས།",
    "མི་འདུག་དེ་རྗེས་ཁ་ལག་སྐྱེལ་མི་འབྱོར་བྱུང་བ་སྟར་པ་འདིར་ངའི་རོགས་པ་སུ་བཅུག་འདུག་གམ་ཞེས་དྲིས་པས་ཁྱེད་རང་གཅིག་པུ་རེད་འདུག་ཅེས་བརྗོད་བྱུང་སང་ཉིན་ཞོགས་པ་སྔ་པོ་ནས་ཡར་ལངས་ཁང་པ་གཙང་མ་བཟོས་ནས་ཞོགས་ཟས་བཟའ་རྩིས་བྱེད་སྐབས་མར་ཤོག་ཅེས་འཁྲིད་བྱུང་།",
    "རྗེས་དེ་མ་ཐག་ངལ་སྒྱུར་ཁང་གི་རླངས་འཁོར་ཞིག་ཡོང་ནས་རྒྱལ་ལགས་དང་།",
    "ངོ་མི་ཤེས་པའི་༉་དཔོན་པོ་ཞིག་འདུག་པ་གཉིས་ཀྱིས་སྲུང་དམག་ལྔ་རེ་དང་།",
    "དེ་དུས་ངལ་སྒྱུར་ཁང་དབུ་བརྙེས་པའི་དུས་ཆེན་སླེབ་རྒྱུ་ཡིན་པས་ང་ཚོའི་ལས་འགུལ་སྤེལ་བའི་འཆར་གཞི་དེ་ཡང་རྨེག་རྨེད་དུ་གྱུར།",
    "མཇུག་དེར་དམག་མིས་མེ་མདའ་འཕེན་ཆོག་གྲ་སྒྲིག་ཨང་གསར་སྦེ་ལེན་བྱས་ནས་འཁྲིད་དེ་སྤོ་བོ་སྤྲ་མོ་བར་ཉིན་མ་གཉིས་དང་མཚན་གཅིག་འགོར་ཡང་ལམ་བར་ཁ་ལག་ཐེངས་གཅིག་དང་ཁ་ཏོག་ཐེངས་གཅིག་ལས་སྤྲད་མ་བྱུང་།",
    "བློ་བཟང་བསྟན་འཛིན་དང་ང་གཉིས་མཉམ་དུ་བཞག་བྱུང་བས་བཀྲེས་ལྟོགས་དང་ལམ་ངལ་བཅས་ཀྱིས་ཐང་ཆད་པས་ཡུད་ཙམ་ལྷོད་ལ་བབ་རེས་ཉལ་ཆས་བཤིག་ནས་ངལ་གསོ་རྩིས་ཀྱང་གདན་བཏིང་ལོང་མེད་པ་བློ་བཟང་བསྟན་འཛིན་དང་།",
    "ཐུགས་རྗེས་གཟིགས།",
    "ང་ཚོ་ལྷ་ས་ནས་འདི་བར་ལག་ལྕགས་བརྒྱབ་སྟེ་ཉིན་གཉིས་དང་མཚན་གཅིག་རིང་ཁ་ཏོག་ཐེངས་གཅིག་ལས་མེད་པར་ཡོང་པས་དཀའ་ངལ་གང་ཡོད་མཁྱེན་གསལ་རེད་ན།",
    "མང་ཆེ་བ་བཀྲེས་ལྟོགས་ཀྱི་སྡུག་བསྔལ་མྱང་ནས་བསྡད་ཀྱི་ཡོད་རེད།",
    "དེ་ནི་ཐེངས་གཅིག་བྱུང་བའི་དཔེ་མཚོན་ཙམ་ཡིན་པ་ལས་རྒྱུན་དུ་རྒྱ་དཔོན་སུ་ཡིན་ཡང་བློ་བཟང་བསྟན་འཛིན་ལ་སྐྱོན་བརྗོད་བྱེད་སྐབས་བློ་བཟང་བསྟན་འཛིན་གྱིས་ལན་ནན་པོ་བརྒྱབ་རྐྱེན་ཁ་གྲགས་ཐབས་མེད་པ་བཟོ་ཡི་རེད།",
    "སྤྱི་ལོ་༡༩༩༢ ཟླ་༣ ནང་ངའི་བཙོན་ཆད་ལོ་ཚད་གཙང་གི་ཡོད་ཀྱང་རང་ཡུལ་ལྷ་ལྡན་ཕྱོགས་ལ་མ་བཏང་བ་ང་དགུའི་བཙོན་པ་བཞིན་ལས་མི་བྱས་ནས་བཞག་གི་ཡོད་སྐོར་ཐོས་བྱུང་།",
    "སྤོ་བོ་སྤྲ་རྨོག་གི་འདམ་ཆུ་བཅས་སོ།",
    "ང་དངོས་སུ་གློད་འགྲོལ་གཏོང་བའི་ཉིན་ང་ཚོ་ཚང་མ་སེམས་སྐྱོ་པོའི་ངང་ཕན་ཚུན་གྱེས་མཇལ་ཞུ་སྐབས་བློ་བཟང་བསྟན་འཛིན་དང་།",
    "ཕྲན་དང་ད་བློ་བཟང་བསྟན་འཛིན་གཤིབས་རིང་ཁོང་གི་ཤེས་སྤྱོད་གཉིས་ཀྱི་མིག་སྟོན་བཟང་པོས་རང་ཉིད་ལ་བག་ཆགས་བཟང་པོ་ཐེབས་བྱུང་ལ་རིན་ཐང་བྲལ་བའི་བཀའ་སློབ་ཀྱིས་རང་ཉིད་ལ་སློབ་སྟོན་དུ་མ་མཛད་ཀྱི་ཡོད།",
    "བློ་བཟང་བསྟན་འཛིན་བོད་མི་མང་གི་ཆེད་ལས་དོན་ཆེ་ཕྲ་གང་ཞིག་སྤེལ་སྐབས་ཀྱང་ཕུགས་རྒྱང་རིང་ཞིང་བྱ་བའི་ལེགས་ཉེས་མཇུག་ལྡོག་ལ་མཛངས་པ།",
    "འགག་རྩར་ཐུག་སྐབས་ལུས་སྲོག་གཏང་རྒྱུར་ཐེ་ཚོམ་དང་འགྱོད་སེམས་ཙམ་ཡང་མེད་པའི་བོད་རྒྱལ་ཁབ་དང་མི་མང་གི་མཁས་མཛངས་གཉིས་ལྡན་གྱི་དཔའ་བོ་ངོ་གནོངས་མི་དགོས་པ་ཞིག་ཡིན།",
    "དགའ་ལྡན་དགོན་གྱི་སྐུ་ཞབས་བཅུ་གཉིས་བཅས་རླངས་འཁོར་ནང་མི་རེར་ཉེན་རྟོག་པ་གཉིས་རེས་བཟུང་སྟེ་ཉེན་གཟོན་མེ་མདའ་རང་སྒྲིག་མི་རབས་གསར་པའི་སྣེ་འདྲེན་གཞོན་ནུ་བློ་བཟང་བསྟན་འཛིན།",
    "རྒྱ་གཞུང་གིས་དྲག་རྩུབ་ཀྱི་ཛ་དྲག་དང་ཞེ་གཏིང་ནས་བློ་བཟང་བསྟན་འཛིན་ལ་འཁོན་འཛིན་གྱིས་ངན་སྨྲས་རིམ་པར་བྱས་སོང་ཡང་དེར་འཁོད་རྒྱ་ཆེའི་མི་མང་རྣམས་ལ་བློ་བཟང་བསྟན་འཛིན་སྐོར་དོ་སྣང་ཤུགས་ཆེ་བྱུང་སོང་ལ་ཕྲན་ལ་ཡང་བློ་བཟང་བསྟན་འཛིན་གཞི་ནས་ངོ་འཕྲོད་བྱུང་།",
    "གདོང་ལ་རས་བཀབ་སྟེ་འཁྲིད་སོང་ཞེས་ཐོས།",
    "དུས་ཚོད་གང་ཙམ་ཞིག་ནས་ཁོང་ཚོ་གློད་དེ་བློ་བཟང་བསྟན་འཛིན་དང་བཀྲ་ཤིས་གཉིས་རྐང་ལྕགས་བརྒྱབ་ནས་རུ་ཁག་དང་པོའི་ནང་སྔར་བཞིན་བཞག་པ་དང་།",
    "རྗེས་སུ་རུ་ཁག་ལྔ་པ་བཙུགས་རྗེས་རུ་ཁག་ལྔ་པའི་ནང་ང་ཚོ་མཉམ་དུ་བྱུང་བས་དེ་ནས་བཟུང་བློ་བཟང་བསྟན་འཛིན་གྱི་སེམས་རྒྱུད་ཆ་ཚང་ལོན་བྱུང་།",
    "ཡང་མི་འདུག་པས་ཁྱེད་རྣམས་ཐུགས་ཁྲལ་གཏན་ནས་མཛད་མི་དགོས་ཞེས་སེམས་ཤུགས་ཆེན་པོའི་ཐོག་སེམས་ལྷོད་ལྷོད་ཀྱིས་ད་དུང་ང་ཚོར་སྤྲོ་བ་སྐྱེ་དགོས་པའི་བཀའ་མོལ་བརྗོད་བྱུང་།",
    "བློ་བཟང་བསྟན་འཛིན་ལོ་གཉིས་སྲོག་ཐོག་ཡིན་པས་དེའི་སྟེང་དོན་རྐྱེན་བྱུང་ན་ལམ་སེང་སྲོག་ཐོག་གཏང་གི་ཡོད་ཀྱང་ཟུར་དུ་ཐག་གཅོད་བྱེད་ཀྱི་ཡིན་ཞེས་བཤད།",
    "ཡང་དེའི་རྗེས་སྤྱི་ལོ་༡༩༩ ཟླ་༡༢ ཚེས་༡༤ མཚན་མོ་ཆབ་སྲིད་བཙོན་པ་ན་གཞོན་ལྷག་པ་ཚེ་རིང་འདས་རྐྱེན་ལས་བློ་བཟང་བསྟན་འཛིན་ལ་རྐང་ལྕགས་ཡོད་བཞིན་ཡང་ཁོང་གིས་ཕྲེད་དར་ཁག་གཉིས་སྟེང་ཡི་གེ་བྲིས་པ་དང་ཁོང་ཚོ་མི་བཞིས་ཕྲེད་དར་འཕྱར་ནས་འགོ་འཁྲིད་དེ་ཆབ་སྲིད་བཙོན་པ་ལྷག་པ་ཚེ་རིང་འདས་པའི་རྐྱེན་རྩད་གཅོད་དང་།",
    "དེ་ནས་ཉིན་ཞིག་ཆབ་སྲིད་བཙོན་པའི་རུ་ཁག་དཀྲུགས་ནས་ང་ཚོ་རྒན་རྒོན་རྣམས་དང་བློ་བཟང་བསྟན་འཛིན་རུ་ཁག་དང་པོའི་ནང་བཞག་བྱུང་བ་ནས་མི་རིང་བར་བློ་བཟང་བསྟན་འཛིན་ལ་ལོ་གཅིག་དང་ཟླ་བ་བརྒྱད་དང་མི་རབས་གསར་པའི་སྣེ་འདྲེན་གཞོན་ནུ་བློ་བཟང་བསྟན་འཛིན།",
    "༨༡ཉིན་གཉིས་རིང་བརྒྱབ་པའི་རྐང་ལྕགས་བཀྲོལ་བ་དང་ལོ་གཉིས་སྲོག་ཐོག་ནས་ཉེས་འགན་ཕབ་སྟེ་ཚེ་བཙོན་བཟོས་འདུག་པ་དེའི་དགོང་མོ་ང་ཚོ་སྟབས་བདེའི་ཇ་མངར་བཟོས་ནས་ཧ་ཅང་གི་ཡག་པོ་བྱུང་ཞེས་བློ་བཟང་བསྟན་འཛིན་ལ་འཚམས་འདྲི་མཚོན་པར་བྱས།",
    "བློ་བཟང་བསྟན་འཛིན་ལོ་གཉིས་སྲོག་ཐོག་གི་སྟེང་དེ་དུས་དོན་རྐྱེན་གསུམ་པ་ཡིན་པ་དང་།",
    "ཡི་གེ་བྲིས་པའི་ཉེས་འགན་གཡོལ་ཐབས་མེད་དུས་ང་ཚོ་ཚང་མའི་སེམས་འཚབ་ཆེ་ཤོས་བློ་བཟང་བསྟན་འཛིན་ལ་ཡིན་ཡང་བློ་བཟང་བསྟན་འཛིན་གྱིས་ཞེད་སྣང་རྩ་བ་ནས་མེད་པ་ཉེས་འགན་ཚང་མ་གཞན་སུ་གཅིག་ལ་དཀྲི་ཐབས་མེད་པར་ང་རང་གིས་འཁྱེར་རྒྱུ་ཡིན་ཞེས་ཨུ་ཚུགས་མཐའ་ནན་བྱེད་པ་དང་།",
    "ང་ཚོའི་ཚོགས་ཆུང་གི་མི་བཅུ་གཉིས་ངོས་ནས་ཕན་གྲོགས་གཞན་བྱ་ཐབས་མེད་པས་ཡི་གེ་དེའི་སྐོར་ཤེས་ཀྱི་ཡོད་ཀྱང་ཤེས་ཀྱི་མེད་ཅེས་སྨྲ་རྒྱུ་བགྱིས།",
    "ཚོགས་པ་མི་སྒེར་བཅས་ཀྱིས་ཁོང་མྱུར་དུ་སྐྱོབ་པའི་རེ་འདུན་ཞུ་ཡི་ཡོད།",
    "གངས་ལྷ་མོ།",
    "སློབ་ཕྲུག་ཚོས་ང་ཚོ་བདམས་མ་བཅུག་པ་གང་ཡིན་ནམ།",
    "བློ་བཟང་བསྟན་འཛིན་ཟེར་བ་སུ་རེད་དམ།",
    "དེ་ལྟར་ཡུན་རིང་གི་འབྲེལ་བ་བརྒྱུད་སློབ་ཕྲུག་ཚང་མས་ཁོང་གི་དབུ་འཁྲིད་འོག་མཐུན་ལམ་བཟང་བ།",
    "རྒན་ལགས་ཀྱིས་ཁྱེད་རང་ག་རེ་བྱས་སོང་ངམ་ཞེས་དྲིས་སོང་བས་ཁོང་གིས་འབུ།",
    "ཁོང་གི་རྣམ་འགྱུར་དེ་མཐོང་བས་ང་ཚོས་ཁོང་ལ་ཀུ་རེ་བྱས་པ་ལམ་དུ་སོང་རྐྱེན་སློབ་ཕྲུག་ཚང་མའི་གད་མོས་འཛིན་ཁང་ནང་བྲག་ཆ་འཁོལ།",
    "༩༡ཕྲུག་གཞོན་ནུ་ཚོ་ལ་ཡང་རང་རེའི་མི་རིགས་ཀྱི་སྡུག་བསྔལ་གྱི་གནོན་ཤུགས་ཤིག་འཕྲད་དེ་སེམས་རྣལ་དུ་མི་གནས་ཀྱང་ཡུན་རིང་ཞིག་ནང་ཁོང་དང་སློབ་གྲོགས་ཚོ་མཛའ་ཞིང་བརྩེ་བའི་ངང་ཡོན་ཏན་རྒྱ་མཚོར་མཉམ་རོལ་གནང་ཡོད།",
    "༩༣གངས་ལྷ་མོ་ནི།",
    "རྒྱ་གཞུང་གིས་ཁོང་དུས་བཀག་བཙོན་བཅུག་བྱ་རྒྱུར་བཏང་བའི་བཅད་ཁྲ།",
    "གངས་ལྷ་མོ།",
    "སྤོ་བོ་སྤྲ་རྨོག་གི་འདམ་གལ་ཆེའི་དུས་ཚེས་གསུམ་གྱི་མིང་ཟུར་ཡིན་ཞིང་།",
    "ཞབས་དང་པུས་མོར་ན་ཟུག་གཏོང་བ།",
    "གཞོན་བུའི་ཚོར་སྣང་གི་ན་ཟུག་གཏོང་བ།",
    "ན་མོ་མ་ཧཱ་མུ་དྲ་ཡེ།",
    "ཇི་བཞིན་རྟོགས་པ་ཕྱག་གིས་མཆོད།",
    "སྣང་སྲིད་འཁོར་འདས་མཐའ་དག་གི་དངོས་གཞིར་ཁྱབ་པ་ཡིན་ཞིང་།",
    "རྟོགས་མ་རྟོགས་ཀྱི་ཁྱད་པར་ཙམ་ལ་རྣམ་པ་སོ་སོར་སྣང་མོད་ཀྱི།",
    "དེ་གཉིས་གང་གི་ཚེ་ནའང་རང་གི་ངོ་བོ་ལ་བཟང་ངན་དང་འཕོ་འགྱུར་སོགས་ཀྱི་སྐྱོན་གྱིས་མ་གོས་པར་གདོད་ནས་སྐུ་གསུམ་དབྱེར་མེད་ཆེན་པོར་གནས་པ་འདི་ལ།",
    "ཡང་ཀུན་གཞི་ལུང་མ་བསྟན་དེའི་གཏི་མུག་གི་ཆ་ལས་རང་ངོ་རང་གི་མ་རིག་ཅིང་གནས་ལུགས་མ་རྟོགས་པར་རང་གིས་རང་ཉིད་བསྒྲིབས་པ་དེ་ལ་ལྷན་ཅིག་སྐྱེས་པའི་མ་རིག་པ་ཞེས་ཀྱང་བྱ།",
    "འདི་ལ་བརྟེན་ནས་ཉོན་མོངས་དང་འཁྲུལ་རྟོག་མཐའ་དག་འབྱུང་ཕྱིར་བག་ཆགས་སྣ་ཚོགས་པའི་ཀུན་གཞི་ཞེས་ཀྱང་བྱ་བ།",
    "དེ་ཡང་དགོངས་པ་ཟང་ཐལ་གྱི་རྒྱུད་ལས།",
    "ནང་གི་ལུས་གདོས་བཅས་རགས་པ་དང་།",
    "ཕྱི་རོལ་དུ་འཁོར་འདས་ཁམས་གསུམ་སྣོད་བཅུད་ཀྱི་དངོས་པོ་ཐམས་ཅད་གཅིག་ལ་གཅིག་བརྟེན་གྱི་ཚུལ་དུ་སྣང་བ་འདི་དག་ཀྱང་དོན་ལ་མེད་བཞིན་ཀུན་རྫོབ་ཏུ་སྣང་བའི་ཆོ་འཕྲུལ་རྨི་ལམ་གྱི་ཡུལ་སྣང་ལྟ་བུ་འདི་ལ་རྟག་འཛིན་ཨ་འཐས་བདེན་ཞེན་ལ་ཆེས་ཆེར་གོམས་པས་ཁམས་གསུམ་རིགས་དྲུག་གི་བདེ་སྡུག་བཏང་སྙོམས་སྣ་ཚོགས་ལ་སྤྱོད་ཅིང་།",
    "ཉོན་མོངས་དྲྭ་བས་གཡོགས་པ་ན།",
    "དེ་ཉིད་ཉོན་མོངས་བྲལ་གྱུར་ན།",
    "ལམ་ཕྱག་རྒྱ་ཆེན་པོས་འཁྲུལ་རྟོག་གི་དྲི་མ་སྦྱང་།",
    "སྒྱིད་སྙོམ་ཁྱད་གསོད་དུ་མ་སོང་བར་རེ་རེ་ནས་རྟགས་འཐོན་དུ་འབད་པ་དང་།",
    "རང་རང་གི་ངོ་བོར་ནི་དེ་དང་དེ་དག་བདེན་པར་གཞི་གྲུབ་ཅིང་།",
    "སེམས་ཉིད་ཡེ་གདོད་མ་ནས་ཡོངས་དག་ཆེན་པོར་ལྷུན་གྱིས་གྲུབ་ཅིང་འདས་མ་འོངས་ད་ལྟ་དུས་གསུམ་དུ་སྐྱེ་འགག་གནས་དང་འགྲོ་འོང་གི་སྤྲོས་པ་དང་བྲལ་བ།",
    "རང་གི་སེམས་ཉིད་ཀྱང་སྐུ་གསུམ་གྱི་རང་བཞིན་ཉིད་དང་།",
    "དེ་དག་ལ་ངེས་པ་རྙེད་ནས་སླར་མཚན་མེད་མཆོག་གི་ཞི་གནས་ལ་འཇུག་པར་བྱ་སྟེ།",
    "དེ་ཡང་ཕྱི་ནང་གི་ཡུལ་རྐྱེན་གྱི་རྗེས་སུ་སེམས་ཡེངས་པ་མ་ཡིན་པར་ཡེངས་མེད་སོ་མར་བཞག་པ་དང་།",
    "རྣམ་རྟོག་གི་ངོ་བོ་དང་དྲན་རིག་གཉིས་ཡ་བྲལ་ཐ་དད་གཉེན་པོ་བསྟེན་པ་ལྟ་བུ་མ་ཡིན་པར་རང་རིག་རང་གསལ་རང་གདངས་སུ་བཞག་པ་སྟེ།",
    "འདི་གསུམ་ལ་མིང་གི་རྣམ་གྲངས་གཞན་དུ།",
    "གང་ཤར་བ་དེ་ལ་རྗེས་མཐུད་དུ་མ་སོང་བར་རང་ངོ་ཧྲིག་གིས་ཤེས་པར་བྱ་བ་ཁོ་ནས་ཆོག་གི་ཆེད་དུ་བཀག་པའམ།",
    "ལམ་གྱི་བྱེ་བྲག་གཞན་ལས་སྣ་ཚོགས་འབྱུང་མོད་ཀྱང་།",
    "དེ་ལྟར་བསྐྱངས་པས་རྣམ་རྟོག་ཕལ་ཆེར་མགོ་ནོན་ཏེ་འཇམ་ཉལ་གྱི་འགྲོ་ཞིང་ལུས་སེམས་བདེ་འབོལ་གྱི་སོང་བས་བྱ་བྱེད་གཞན་ལ་ཞེན་པ་མི་འཇུག་པར་མཉམ་བཞག་ལ་སྤྲོ་ཞིང་།",
    "ཐེངས་རེ་ཙམ་ལས་གཞན་རྟོག་པའི་འགྱུ་འཕྲོ་མེད་པའི་གནས་པ་ཤས་ཆེར་གྱུར་པ་ནི།",
    "སེམས་གསལ་དྭངས་རྟོག་པ་མེད་པར་ཉིན་མཚན་འདས་པ་མི་ཚོར་ཞིང་ཇི་ཙམ་མཉམ་པར་བཞག་གི་བར་དུ་གཡོ་བ་མེད་ཅིང་རྐྱེན་གྱིས་མི་གནོད་ལ།",
    "སྐྱེ་བོ་དག་གིས་ཀྱང་གྲུབ་ཐོབ་ཏུ་མཐོང་བ་ལ་བརྟེན་ནས་རང་གཞན་མང་པོ་ཕུང་ཉེན་ཡོད་པས་གཟབ་འཚལ་ལོ།",
    "མངོན་སུམ་རྟོག་བྲལ་གྱི་ཡེ་ཤེས་ཡོད་མེད་ཡིན་མིན་རྟག་ཆད་གང་གི་ཡང་མཐར་མ་ལྷུངས་ཤིང་།",
    "གསལ་རིག་སྟོང་གསུམ་དབྱེར་མེད་དུ་མྱོང་ཞིང་ཤེས་ཀྱང་དཔེས་མཚོན་དུ་མེད་ལ་ཚིག་གིས་བརྗོད་ཐབས་ཟད་པ།",
    "རང་བྱུང་རང་གསལ་དུ་ཧྲིག་གེ་བ་འདི་ལ་ལྷག་མཐོང་ཞེས་མིང་དུ་བཏགས་མོད་ཀྱི།",
    "གནས་མི་གནས་ལྟ་མཁན་སོགས་ཐམས་ཅད་ཁོ་རང་ཡིན་ཀྱང་རང་གིས་རང་མ་མཐོང་བ་ལྟ་བུར་གྱུར་པ་སྟེ།",
    "ཞི་གནས་ཀྱི་ཉམས་དང་བདེ་གསལ་མི་རྟོག་དེ་ཐམས་ཅད་ལྷག་མཐོང་གི་རིག་པ་ཁོ་རང་དག་ཏུ་ཤར་བ་ལས་གཞན་མིན་ཀྱང་།",
    "རྣམ་རྟོག་རང་སར་ཞི་ནས་སེམས་བདེ་གསལ་མི་རྟོག་གི་ངང་དུ་གནས་པ་ནི་ཞི་གནས།",
    "དེ་གཉིས་གང་གི་ཚེ་ཡང་རང་ངོ་ཤེས་ན་ལྷག་མཐོང་གི་རང་བཞིན་ཉིད་དང་།",
    "ཕྱི་རོལ་ཚོགས་དྲུག་གི་སྣང་བ་གང་ལ་ཡང་ཨ་འཐས་ཀྱི་ཞེན་པ་མ་ཞུགས་པ་ནི་ཞི་གནས།",
    "རྣམ་རྟོག་ལྷངས་ཀྱི་ཤར་ཚེ་རང་ངོ་ཧྲིག་གིས་ཤེས་པར་བྱེད་པ་ཞི་གནས།",
    "ཡང་ཉོན་མོངས་པ་ཤིན་ཏུ་དྲག་པོ་ཞིག་སྐྱེས་པའི་ཚེ་ནའང་དེའི་རྗེས་སུ་ཨ་འཐས་མ་སོང་བ་རང་ངོ་ལ་བལྟ་བ་ནི་ཞི་གནས།",
    "ལྟ་མཁན་གྱི་རིག་པ་དང་བལྟ་བའི་ཉོན་མོངས་སོ་སོར་མ་གྲུབ་པའི་གསལ་སྟོང་རྗེན་པ་ནི་ལྷག་མཐོང་སྟེ།",
    "ཉོན་མོངས་ཀྱི་ཐོག་ཏུ་ཡང་ཞི་ལྷག་ཟུང་འཇུག་ཚང་སྟེ།",
    "རྣམ་པ་ལྟར་གང་ཟག་གིས་འཇུག་པ་བདེ་བའི་སླད་དུ་མིང་དང་དབྱེ་བ་སོ་སོར་བསྟན་ལ།",
    "ཕྱི་རོལ་མུ་སྟེགས་པ་དང་ནང་པའི་ཡང་ཉན་རང་གི་བསམ་གཏན་དག་དང་།",
    "ལྷ་གནས་རྣམས་ཀྱི་ཏིང་འཛིན་དང་ཐུན་མོང་བ་ཡིན་ཕྱིར།",
    "ཚོགས་དྲུག་གི་སྣང་བ་ཕྲ་རགས་ཐམས་ཅད་འགགས་པའི་ཤེས་པ་རྟོག་མེད་ཁོ་ན་ལ་སྒོམ་དུ་འཛིན་པར་གདའ་སྟེ།",
    "འགའ་ཞིག་ནི་དྲན་རིག་གིས་མ་ཟིན་པའི་གཏི་མུག་ལུང་མ་བསྟན་ལ་སྒོམ་བརྟན་པོ་རུ་རློམ།",
    "རྣམ་རྟོག་དང་ཉོན་མོངས་སུ་ཀར་རེ་འདུག་གམ།",
    "གྲུབ་ཐོབ་བརྒྱུད་པའི་བཀའ་འབུམ་མན་ངག་ཁྲིད་ཡིག་སོགས་ཀྱི་དགོངས་པ་དངོས་བསྟན་དང་མཐུན་པའི་ཉམས་ལེན་སྐྱོན་མེད་ཞིག་དགོས་པར་སྣང་ངོ། ། བྱེ་བྲག་གི་གོལ་ས་དང་ཤོར་སའི་དབྱེ་བསལ་ནི།",
    "སྒྲུབ་བརྒྱུད་གོང་མ་རྣམས་ཀྱི་གསུང་ལས་ཞིབ་རྒྱས་འབྱུང་མོད་ཀྱི།",
    "དེ་ཡང་མཉམ་བཞག་གི་སྐབས་སུ་བདེ་གསལ་མི་རྟོག་གསུམ་གང་རུང་གི་ཉམས་ལ་ཞེན་ན།",
    "བྱེ་བྲག་ཏུ་སྙོམས་འཇུག་གི་བསམ་གཏན་དགུ་ཡོད་དེ།",
    "དེ་ལྟར་འདི་དག་ནི་འཇིག་རྟེན་པའི་ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་ནང་ནས་ནི་མཆོག་ཏུ་གྲགས་ཤིང་ལྷག་མཐོང་གི་གཞི་རྟེན་ཡིན་ཀྱང་།",
    "དེ་ལྟར་སྙོམས་འཇུག་གི་བསམ་གཏན་དགུ་པོ་དག་སོ་སོས་གནས་སྐབས་སུ་མངོན་ཤེས་རྫུ་འཕྲུལ་སོགས་འགྲུབ་པའི་ཡོན་ཏན་ཙམ་ཡོད་ཀྱང་།",
    "འདིར་ནི་མཐར་ཐུག་གི་འབྲས་བུ་རྫོགས་བྱང་ཉིད་བསྒྲུབ་པ་ལས།",
    "ཀུན་རྫོབ་ལྟར་སྣང་གི་ཡོན་ཏན་མི་བསྒྲུབ་ཅིང་།",
    "གཞན་ལ་ཚིག་འཆད་ཤེས་ཀྱང་དོན་རང་གི་རྒྱུད་ལ་མེད་པ་དེ་ལ་གཤིས་ཀྱི་ཕྲལ་ཤོར་ཞེས་བྱའོ།",
    "ཉོན་མོངས་ལྟ་བུ་སྐྱེས་པའི་ཚེ།",
    "༧ སྔོན་མ་རྣམ་རྟོག་གི་རྗེས་སུ་འབྲངས་ནས་ཡེངས་སོ།",
    "ད་སླར་ལེགས་པོར་བསྒོམ་མོ་སྙམ་པའི་རྟོག་པ་ཁོ་རང་འཕྲོ་མཐུད་པའི་ངང་ལ་སོང་བའམ།",
    "འགའ་ཞིག་གིས་ནི་གནས་ཞི་གནས་འགོག་པ་བསྒོམས་པས་ཀླུར་སྐྱེ་བ་སོགས་ངན་ལེན་གྱི་རྒྱུ་རྐྱེན་བྱེད་པས།",
    "གཞན་ཡང་འགའ་ཞིག་གིས་སེམས་རྟོག་མེད་བྱིང་རྨུགས་ལ་ཞི་གནས་སུ་འཛིན་པ་དང་།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་ཙམ་ལ་ཟུག་རྔུ་མེད་པ་རང་བཞིན་མཆོག་གི་བདེ་བར་འདོད་པ་དང་།",
    "རྗེས་ཤེས་ཀྱང་བློས་བཏང་ཐ་མལ་འཁྲུལ་འབྱམས་ལ་མི་བསྡད་པར་དྲན་རིག་གིས་ཟིན་པར་བྱས་ན།",
    "འགའ་ཞིག་གིས་ཉམས་ཀྱི་མཉམ་རྗེས་དང་རྟོགས་པའི་མཉམ་རྗེས་སོ་སོར་དབྱེ་བ་དང་།",
    "ལ་ལས་རྣལ་འབྱོར་བཞི་སོ་སོ་ལ་རང་སའི་མཉམ་རྗེས་རེ་ཐ་དད་དུ་གསུངས་པ་སོགས་མཐའ་ཡས་མོད་ཅིང་།",
    "གང་ཟག་གི་མོས་ཁམས་བསམ་པས་ཇི་སྙེད་ཀྱི་གདུལ་ཐབས་ལ་དགོངས་པའི་ཐུགས་རྗེའི་རྣམ་རོལ་ཡིན་ཕྱིར་བདེན་པ་ཁོ་ནར་གོར་མ་ཆག་ཕྱིར་སྐྱབས་སུ་མཆི་ཞིང་།",
    "འདི་དང་འདི་ནི་ཡིན་ཞིང་འཐད་ལ།",
    "དམུས་ལོང་གིས་ཁ་དོག་བཟང་ངན་གྱི་དབྱེ་བ་མི་ནུས་པ་ལྟ་བུའོ།",
    "བསྐྱེད་རིམ་སོགས་ལམ་གྱི་ཉམས་ལེན་ཕལ་མོ་ཆེ་ལ་འགྲོ་སྟེ།",
    "དཔེར་བྱས་ན་རྡོ་རྗེ་གདན་ལྟ་བུ་ཞིག་གི་དབྱིབས་དང་བཀོད་པའི་གནས་ཚུལ་རྣམས་གཞན་གྱི་ངག་ལས་ཐོས་པའི་དོན་འོལ་སྤྱི་ཙམ་རང་གི་ཡིད་ལ་ཤར་ཞིང་གཞན་དག་ལ་འཆད་ནུས་པ་དེ་ལ་གོ་བ་ཟེར།",
    "ཐག་རིང་མོ་ནས་རྡོ་རྗེ་གདན་མཐོང་བའམ།",
    "བཀོད་པ་རི་མོར་བྲིས་པ་བལྟ་མྱོང་བས་དོན་ཕལ་ཆེར་ཙམ་བློ་ངོར་ཆུད་པ་དེ་ལ་མྱོང་བའམ་ཉམས་ཞེས་བྱ།",
    "གཞན་གང་ཟག་ཐུན་མོང་བ་སྤྱི་ལ་ཉམས་ལེན་བརྩོན་འགྲུས་ཆེ་ཆུང་ལྟར་གྱི་གོ་རིམ་ངེས་ཅན་དུ་ན་འཕར་བའི་རིགས་ལ་རིམ་གྱིས་པ་ཞེས་བྱ་སྟེ་ཕལ་པ་རྣམས་སོ།",
    "དེ་རེ་རེ་ལ་ཆེ་ཆུང་འབྲིང་དུ་ཕྱེ་བའི་བཅུ་གཉིས་པོ་འདི་ནི།",
    "རྒྱུད་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའི་ལུང་གི་དགོངས་པ་རྗེ་ཟླ་འོད་གཞོན་ནུས་གསལ་བར་མཛད་པ་སྟེ།",
    "བཟོད་པ་བརྟན་པོས་ངན་སོང་སྡུག་བསྔལ་སྤོང་།",
    "རྩེ་མོ་ཐོབ་ནས་འཕེལ་བ་རྒྱུན་མི་འཆད།",
    "སྤྱན་སྔ་ཐམས་ཅད་མཁྱེན་པ་སོགས་ཀྱིས་ཞིབ་མོར་ཕྱེས་ཤིང་།",
    "མི་དགེའི་ལས་རྣམས་ངང་གིས་སྤོང་།",
    "རྣལ་འབྱོར་བཞི་པོ་དེ་དག་གི་དངོས་དོན་ཇི་ལྟར་འཆར་ཚུལ་རིམ་པ་དང་།",
    "དང་པོ་རྩེ་གཅིག་གི་རྣལ་འབྱོར་ནི།",
    "རང་ཉིད་ཀྱི་གོ་ཚོད་ལ་ནི་གང་ཟག་གི་རིམ་པ་ཐ་དད་ཀྱི་ཁྱད་ནི་ལོས་ཀྱང་མཆིས་ལ།",
    "འདིར་ཡང་ལྷག་མཐོང་གིས་ཟིན་པར་གོའོ།",
    "རྩེ་གཅིག་འབྲིང་གི་ཚེ་མཉམ་བཞག་ལ་ཇི་ཙམ་འདོད་པ་ལྟར་གནས་ནུས་ཤིང་།",
    "རེས་འགའ་མ་བསྒོམས་ཀྱང་ཏིང་འཛིན་འཆར།",
    "ཕྱི་ནང་གི་སྲིན་བུ་མེད་ཅིང་འདོད་ཡོན་ལ་ཞེན་པ་མི་འཇུག་པ་དང་།",
    "དེ་ཡང་བདེ་གསལ་མི་རྟོག་གི་ངོ་བོ་དེ་ཀ་ལ་རང་རིག་ངེས་ཤེས་ཀྱི་གདེང་རྙེད་མ་རྙེད་ཀྱི་བྱེ་བྲག་ལ་རྩེ་གཅིག་ངོ་བོ་མཐོང་མ་མཐོང་དུ་དབྱེ་བ་དང་།",
    "རྗེས་ཤེས་ཀྱང་དྲན་པས་ནམ་ཟིན་མཉམ་བཞག་གི་ངང་དུ་སོང་བས་གྲོལ།",
    "སྤྲོས་བྲལ་འབྲིང་གི་ཚེ་སྟོང་འཛིན་དེ་དང་རྣམ་རྟོག་གི་རང་བཞིན་ལ་བདེན་ཞེན་སོགས་དག་ཀྱང་།",
    "འདི་སྐབས་སུ་སྟོང་འཛིན་ཉམས་ཀྱི་དྲི་མའམ་ངེས་ཤེས་ཀྱི་ཆ་དག་མ་དག་གི་ཁྱད་པར་ལ་སྤྲོས་བྲལ་ངོ་བོ་མཐོང་མ་མཐོང་གི་དབྱེ་བ་དང་།",
    "སྣང་ཐོག་སྟོང་ཐོག་གང་ལ་ཡང་རེ་དོགས་བྲལ་མ་བྲལ་ལམ་སྒྲོ་འདོགས་ཆོད་མ་ཆོད་ལ་རྩལ་རྫོགས་ཀྱི་ཐ་སྙད་དང་།",
    "སྣང་ངོའམ་འཁྲུལ་ངོ་ལ་ཨ་འཐས་དང་གཟུང་འཛིན་སོགས་སུ་ཡོད་པ་འདི་ལ་རང་རིག་གི་དྲན་པས་སླེབ་ན་རང་སར་གྲོལ་བ་ནི་རྣལ་འབྱོར་འོག་མ་རྣམས་ལ་ཡོད་མོད་ཀྱང་།",
    "དེ་ལྟར་དུ་གྱུར་མ་གྱུར་ལ་རོ་གཅིག་གི་ངོ་བོ་མཐོང་མ་མཐོང་དུ་དབྱེ་བ་དང་།",
    "གཉེན་པོའི་ཞེན་འཛིན་ཕྲ་མོ་ཡོད་མེད་དམ།"
  ]
}