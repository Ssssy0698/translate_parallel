    "འདིར་གང་གིས་མཐར་ཐུག་པ་ནི་གཉིས་ཏེ་དོན་དམ་བདེན་པ་དང་།",
    "བདེན་གཉིས་ཟུང་འཇུག་གི་གནས་ལུགས་འབྲས་བུའི་མཐར་ཐུག་ཡིན་ཚུལ་འཆད་པའོ།",
    "དགོངས་པ་ཅན་དང་སྦས་དོན་ངེས་དོན་མཐར་ཐུག་གི་དོན་འཆད་པར་བྱེད་པའོ།",
    "སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "ལུང་རིག་གི་རྩ་བ་མེད་ཀྱང་མང་དུ་སྨྲ་བ་གདུལ་བྱ་རྗེས་སུ་འཛིན་མི་ནུས་པ་ནི།",
    "དབྱིངས་མཐའ་བྲལ་གྱི་གནས་ལུགས་ཟབ་མོ་མི་ཤེས་པས།",
    "ལམ་གྱུར་གྱི་འབྲས་བུ་རིག་འཛིན་བཞི་དང་གསུམ་མོ།",
    "ལས་ཕྲན་ཚེག་བརྒྱད་བཅས་ཐུན་མོང་གི་གྲུབ་པ་ཐོབ་པ་དང་།",
    "མཆོག་གི་འབྲས་བུ་གཞི་འབྲས་ཟུང་དུ་འཇུག་ནས་རིག་འཛིན་བཞིའི་ས་ཐོབ་པའོ།",
    "དེ་ཡང་རང་ངོ་རང་གིས་མ་ཤེས་པས་ཡུལ་ཡུལ་ཅན་གཉིས་སུ་བཟུང་ནས་འཁྲུལ་བའོ།",
    "གཞིའི་རིག་པ་རྣམ་པ་ཕྲ་མོ་ཡི་ཤེས་པ་གཟུང་བའི་ཆ་ཕྲ་བའི་ཕྲ་བར་གནས་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པས་གཟིགས་ཚུལ།",
    "ཉོན་མོངས་དུག་ལྔ་སྟོབས་ཆེ་ན་དུག་ལྔ་རང་གྲོལ་དུ་ཤེས་པའི་གདམས་ངག་དགོས།",
    "ལྷན་ཅིག་སྐྱེས་པའི་མ་རིག་པས་རང་ངོ་རང་གིས་མ་ཤེས།",
    "དེ་ཉིད་ཕྱི་ཅི་ལོག་ཏུ་བཟུང་ནས་ལས་ཉོན་རང་གི་སྤྱད་ནས་ཡང་དག་པའི་ལམ་དང་བྲལ་ཏེ་འགྲོ་བ་རྣམས་སྡུག་བསྔལ་སྣ་ཚོགས་པས་ཉམ་ཐག་པར་གནས་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པས་གཟིགས་ཚུལ་ནི།",
    "འབད་པ་དང་རྩོལ་རྟོག་མེད་པས་ཉི་མ་དང་འོད་ཟེར་གྱི་ཚུལ་དུ་ངང་གིས་ཤར་བའོ།",
    "ཡང་ན་གསང་སྔགས་ལུང་གི་སྒོ་བཞི་ནི།",
    "དོན་དམ་གསལ་བྱེད་བརྗོད་པ་ཚིག་གི་སྒོ།",
    "ལག་གི་རྩ་བཞིན་དབུ་ཞབས་རྟོགས།",
    "རྒྱུད་དཀྱིལ་འཆད་པའི་སྐྱེས་བུ་གསུམ་གྱི་མཚན་ཐུན་མོང་དུ་བསྟན་པ་དང་།",
    "དོན་རང་གི་ངོ་བོ་ལ་བཏགས་པ་དང་གསུམ།",
    "ལུང་གི་སྤྱི་ཞེས་པ་ནི་རྒྱུད་ལུང་མན་ངག་མཚན་ཉིད་ཐམས་ཅད་ཀྱི་ལུང་གི་སྤྱི་ལྟ་བུར་གྱུར་པའི་ཕྱིར་ལུང་གི་མཚན་ནོ།",
    "ལག་གི་རྩ་བཞིན་དབུ་ཞབས་རྟོགས།",
    "དེ་ལྟར་རྡོ་རྗེ་སེམས་དཔའ་སྒྱུ་འཕྲུལ་དྲྭ་བ་ཞེས་གསུམ་ཀ་ལ་བཏགས་པའོ་རྒྱུད་དང་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་འཆད་པའི་སྐྱེས་བུ་གསུམ་གྱི་མཚན་ཐུན་མོང་དུ་བསྟན་པ་ནི།",
    "ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "འཇིག་རྟེན་ན་རྫས་དྲང་སྲོང་ཞོ་འཐུང་གི་རུས་པ་ལས་གྲུབ་པའི་རྡོ་རྗེ་ཕ་ལམ་ཞེས་པས་དངོས་པོ་གཞན་ཐམས་ཅད་ཕར་འཇོམས་པར་ནུས་པ།",
    "ཚུལ་དེའི་ངོ་བོ་ལ་གཞན་གང་གིས་ཀྱང་མི་ཚུགས།",
    "ཤི་ན་ངན་སོང་དུ་སྐྱེ་མི་སྲིད་པ་དང་བཞི་ལྡན་ལ་རྡོ་རྗེ་ཟེར།",
    "མེ་ཡིས་ཐལ་སོལ་དུ་བསྲེག་མི་ནུས་པས་བདེན་པ།",
    "རང་གི་ངོ་བོར་གང་གིས་ཀྱང་གནོད་མི་ནུས་པས་ཐམས་ཅད་དུ་མ་ཕམ་པའོ།",
    "གང་དུ་བསྡུ་ན་རིག་པ་རང་བྱུང་གི་ཡེ་ཤེས་སུ།",
    "གང་གིས་ན་སེམས་ཀྱི་རོལ་རྩལ་ཡིན་པའི་ཕྱིར།",
    "དེས་རྒྱུད་ལ་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བཏགས་པའི་དོན་སོང་།",
    "སེམས་ཉིད་རང་བྱུང་གི་ཡེ་ཤེས་དེ་ཉིད་ངོ་བོ་མཚན་མེད་སྟོང་པ་ཉིད་ཡིན་ཀྱང་།",
    "ཞེས་ལམ་ལ་ཞུགས་པའི་གང་ཟག་གི་ཉམས་སུ་ལེན་པའི་གྱི་ཚེ།",
    "བཏགས་པ་བ་ཚོགས་ལམ་དུ་མོས་པ་ཙམ་གྱིས་སྔ་འགྱུར་ཀ",
    "ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "ས་གཉིས་པ་ནས་བཅུ་པའི་བར་ལམ་ལ་རིམ་གྱིས་སློབ་དགོས་པ་ནི་སློབ་པའི་སྒྱུ་ལུས་དང་འོད་གསལ་གཉིས་ཟུང་འཇུག་གི་ལྷ་སྐུ།",
    "ཐབས་བདེ་བ་ཆེན་པོ་དང་ཤེས་རབ་སྟོང་པ་ཉིད་འབྲེལ་བའི་ཟུང་འཇུག་གི་དོན།",
    "སྟོང་པ་ཉིད་དེའི་སྣང་ཆ་ཐབས་རིག་པ་རང་བྱུང་གི་ཡེ་ཤེས་ཟུང་དུ་འཇུག་པ་སྟེ།",
    "དྲྭ་མིག་ཟང་ཐལ་དུ་ཡོད་པ་དང་།",
    "མཁའ་ཟང་ཐལ་དུ་ཡོད་པ་དང་།",
    "འདིར་རྒྱུད་དང་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་དང་འཆད་པའི་སྐྱེས་བུ་རྣམས་ལ་མཚན་ཐུན་མོང་དུ་བཏགས་པ་སོང་།",
    "གཉིས་པ་ཆེ་བ་ལ་མཚན་དུ་བཏགས་པ་ལུང་གི་མཚན་ནི།",
    "ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "ལྟ་བ་མཐུན་འཇུག་གི་སྤྱོད་པའི་ལུང་སྤྱོད་པ།",
    "ཡེ་ཤེས་རིང་ནས་ཤར་བ་རྒྱ་མ་ཞེས་པའི་དོན་ཡེ་གེའི་འབྱར་རམ་ཡི་གེའི་སྒོ་ནས་བུ་ལོན་ལ་རྒྱ་བཞག་པ་ལྟ་བུ་ལ་བོད་པས་རྒྱ་མ་ཟེར་དེ་ཡང་ལས་དཀར་ནག་གི་ལས་ནི་གནས་སྐབས་སུ་འགགས་ཀྱང་བག་ཆགས་ཆུད་མི་ཟ་བར་སྨིན་པའི་མཚན་ཉིད་ཅན་ཡིན།",
    "གསུམ་པ་དོན་རང་གི་ངོ་བོ་མན་ངག་གི་མཚན་ཉིད་ནི།",
    "པཎ་ཆེན་བྷི་མ་ལ་བོད་ཡུལ་དུ་བཞུགས་པའི་དུས་སུ་ལོ་ཙཱ་བ་རྨ་རིན་མཆོག་གིས་དཀའ་སྤྱད་མི་དགོས་པར་རྒྱུད་འདི་ཐོག་མར་འགྱུར་བའི་ཕྱིར་ན་རྒྱ་སྐད་སྨྲོས་པ་ལ་དགོས་པ་ཆེར་མ་མཐོང་ནས་བོད་སྐད་དུ་སྨྲོས་པའོ།",
    "སྤྱོད་ཡུལ་དང་བྲལ་བ་མ་རྟོགས་པ་དཔེར་ན་ནམ་མཁའ་ཉིད་མིག་གིས་མཐོང་བྱར་མ་གྱུར་པ་ལྟ་བུ་དབུལ་པོའི་ཁྱིམ་གྱི་ས་འོག་གི་གཏེར་ལྟར་མ་མཐོང་བས་ཕྱིར་ན་རང་བཞིན་གྱི་གསང་བའོ།",
    "དེས་ན་སྔགས་ལྟ་སྤྱོད་ཟབ་མོ་རྣམས་བརྡའི་ཚུལ་དུ་སྦས་པའི་གསང་བའོ།",
    "ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
