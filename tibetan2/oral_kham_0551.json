    "ཁ་སྤུ་མིག་ལ་མཛེས་པ་ཞིག་བཞག་འདུག་པ་དང་།",
    "མེ་མདའ་ཞིག་ཁུར་འདུག་ཁོང་དང་འབྲོག་པ་ཚོས་བོད་དམག་ལ་ཕྱུར་བ་དང་རམ་པ་དོ་ཁལ་བཅུ་གསུམ་དང་།",
    "ཐེངས་འདིར་དཔུང་བསྐྱོད་བྱེད་དོན་ཡང་ཁོ་ཚོ་མཉམ་དུ་མནའ་གན་གསར་པ་ཞིག་འཇོག་འཆར་ཡིན་འདུག་ཉིན་དྲུག་བདུན་རྗེས།",
    "དེར་བང་མི་བཏང་ནས་ཁོ་ཚོ་ནགས་གསེབ་ཏུ་ཕྱིར་འཐེན་དགོས་པའི་བརྡ་སྐྱེལ་དུ་བཏང་ཡང་འབྲེལ་བ་བྱུང་ཐུབ་མི་འདུག་གཡུལ་འཐབ་ཀྱི་ཉིན་དྲུག་པར།",
    "དུས་དེ་ཙ་ན།",
    "རྗེས་སུ་བྱ་དགའ་སྤྲོད་སྐབས་གསང་བ་བརྟོལ་མཁན་ཁོ་རང་ཡིན་པ་ཤེས་ཡོད།",
    "ང་རང་ལ་ཐབས་ཤེས་གང་ཡང་མི་འདུག་རྐང་ཐང་མར་ཁོང་གཉིས་ཀྱི་རྗེས་སུ་རྒྱུགས་ཀྱང་།",
    "ཁ་ནང་དུ་ཁྲག་དྲིས་བརྒྱངས་འདུག་ང་རང་རྡོ་ཕ་བོང་ཧ་ཅང་ཆེན་པོའི་སྟེང་དུ་གཡེར་བ་སྐྱེས་ཡོད་པ་དེར་སླེབས་སྐབས།",
    "མདའ་སྐད་ཆད་དུས་ང་ལ་གང་ཡང་ཕོག་མི་འདུག་དེ་ནས་ངས་ལམ་སེང་རིང་མདའ་བཏོན་ནས་སོ་ཁ་བླངས་པར།",
    "མཐིལ་ལེབ་ལེབ་ཡིན་པས་རྩྭ་མགོ་ནས་འདྲེད་བརྡབ་ཤོར་གྱི་འདུག་གང་སར་མདའ་སྐད་ཀྱིས་ཁེངས་ཡོད་ཀྱང་།",
    "ང་རང་ལ་གཏད་དེ་རྒྱག་བཞིན་པའི་མདའ་སྐད་གང་ཡིན་གསལ་པོ་ཤེས་ཀྱི་འདུག་ང་རང་ཐང་ལ་འགྱེལ་ཐེངས་ཤིག་ལ་ཁ་ཕར་འཁོར་ནས་བལྟ་སྐབས།",
    "ང་རང་ལ་མེ་མདའ་འཕེན་འདོད་མེད་པས།",
    "ང་རང་གསོན་པོར་འཛིན་དགོས་ཟེར་མཁན་རྒྱ་དམག་དེ་ཚོ་བཅུ་ཤོག་ཅིག་ཡིན་པ་འདྲ།",
    "མིག་ཀྱང་རབ་རིབ་ཏུ་གྱུར་འདུག་ཁོ་ཚོས་བོད་སྐད་ཐོག་ཇོ་ལགས།",
    "རི་མགོ་དེ་བརྒལ་ནས་ཀྱང་འགྲོ་ས་གཞན་མི་འདུག་ཁག་བགོས་ནས་རི་མགོ་གཞན་ཞིག་ལ་ཕར་རྒོལ་བྱས་ཏེ་རི་མགོ་དེ་ལེན་ཐུབ་པ་མ་ཟད།",
    "དམག་འཐབ་དེའི་ནང་བོད་དམག་སུམ་བརྒྱ་ལྷག་ཙམ་དགྲར་ཤོར་འདུག་དེ་དུས་བོད་དམག་ཕྱོགས་གང་སར་ཁ་ཐོར་བ་དང་།",
    "གླིང་ཁ་གཤིས་པ་དང་ར་སྒྲེང་གཟིམ་འགག་སོགས་ཚ་བ་གདོང་མདར་རྒྱ་དམག་དང་གཏུགས་སྐབས་རྒྱལ་ཁ་ཐོབ་འདུག་ཀྱང་།",
    "གོ་ཐོས་ལྟར་ན་ཁོ་ཚོ་གསུམ་བོད་དམག་དང་མཉམ་དུ་མ་ཤི་བར་དགྲ་རྒོལ་དུ་ཞུགས་འདུག་༡༩༦ ནས་༡༩༦༡ ལོ་བར་དུ།",
    "ང་འགྲོ་ཐུབ་ཀྱི་མི་འདུག་ང་མཉམ་དུ་བཅུ་དཔོན་ཐུབ་བསྟན་བཞག་ན་འགྲིག་ཅེས་བརྗོད་པ་ཡིན།",
    "རིམ་པས་ངའི་འཁྲིས་སུ་མི་ཉི་ཤུ་མ་ཟིན་ཙམ་ཞིག་འཛོམས་འདུག་དེ་དུས་དམག་འཐབ་ད་དུང་ཛ་དྲག་ཏུ་བྱེད་བཞིན་ཡོད་པ་དང་།",
    "འགུལ་ཀྱོག་རྒྱག་ས་མི་འདུག་ཐུབ་བསྟན་ནི་དཔའ་རྒོན་ཅིག་ཡིན་པ་དང་།",
    "དེ་ནས་རི་གཤམ་དེར་ཏར་གཏོང་འཕྲུལ་ཆས་དྲུག་བདུན་ཞིག་བསྟར་འདུག་པ་སྐད་རྒྱག་བཞིན་འདུག་ལ།",
    "དེ་དུས་ང་རང་ལོ་བཅུ་དགུ་ཡིན།",
    "མཐའ་མ་དེར་ཕུ་པ་དཔོན་ག་བ་ཡོད་དྲིས་པར་ང་རང་ཡིན་ཞུས་པས།",
    "ངས་རྒྱ་སྐད་ཚང་མ་བརྗེད་ཚར་འདུག་ཞུས་པ་ཡིན།",
    "ད་ཆ་བརྗེད་ཚར་འདུག་ཅེས་ཞུས་པས།",
    "མེ་མདའ་རིང་ཐུང་གཉིས་ཁྱེར་ནས་ས་དེར་བསད་འདུག་མི་གཞན་ཚོས་ཤོད་སྲོལ་ལྟར་ན།",
    "ཁོ་རང་ཐོག་མར་རྨས་པ་དང་།",
    "རི་མགོ་ཡོངས་རྫོགས་རྒྱ་དམག་ཤི་རོས་ཁེངས་འདུག་ཕྱོགས་གཉིས་ཀར་གོ་མཚོན་ཡག་པོ་ཡོད་སྟབས།",
    "བྲོས་ཐར་གྱི་འདུག་གམ་ཞེས་དང་།",
    "དེ་དུས་ང་རང་ཏོག་ཙམ་དྲག་ཡོད།",
    "ཁོ་རང་ཨ་རིར་དམག་སྦྱོང་ཁོངས་སུ་བསྐྱོད།",
    "གནམ་གྲུས་ས་ངོ་མ་ཆོད་པར་བྲག་གཡབ་གསེར་གཞུང་ཐང་དུ་གཡུག་པ་ནི་སྟབས་ལེགས་བྱུང་འདུག་དེ་མིན་སྨར་ཁམས་སུ་རྒྱ་དམག་གང་སར་བཀྲམ་ཡོད་སྟབས།",
    "སྐབས་དེར་རྨས་དྲག་བསྐྱེད་བྱུང་ནས་རང་ཁྱིམ་དུ་ལོ་གཅིག་ཙམ་འགོར་འདུག་པ་དང་།",
    "ཁོ་རང་མགོ་སྒུར་ནས་ཁ་མ་གྲགས་པར་བསྡད་པ་དང་།",
    "ཁོ་རང་ཤི་རྫུས་ཀྱིས་ཐུང་མདའ་ཞིག་བཟུང་ནས་ཉལ་ཞིང་།",
    "ཁོ་རང་མགོ་བཏགས་ཐེངས་གཅིག་ཞུས་པ་དེ་ཆོག་མཆན་ཐོབ་པ་གང་ཡང་མིན།",
    "ཁོ་རང་རྒྱ་ལ་གཏུགས་པ་མ་ཟད་རྒྱ་དམག་ཁྲིད་དེ་རྗེས་འདེད་དུ་ཡོང་བ་དང་།",
    "ཁོ་ཚོས་གཡག་ཁྲིད་སྐབས་འབྲོག་པས་ཤེས་ཚོར་བྱུང་ནས་ག་ལེར་རྗེས་འདེད་བཏང་འདུག་ཀྱང་།",
    "རང་དམག་བདུན་ཅུ་ལྷག་རི་མགོར་ཡོད་པ་མཐོང་བས་ཕྱིར་ལོག་བྱས་འདུག་དེ་དུས་བྲང་མགོ་ཕུར་བུས་རྒྱ་དམག་ཁྲིད་ནས་དེར་འབྱོར་བ་དང་ཏག་ཏག་འཁེལ་ཏེ་འབྲོག་པ་ཚོར་བོད་དམག་བརྩད་བཅད་པས།",
    "དེ་དུས་ཁོ་གཉིས་ཀྱི་མདུན་ཐག་དེ་ཙམ་མི་རིང་ས་དེར་འཕྲུལ་མདའ་ཞིག་བཀལ་འདུག་པ་དང་།",
    "བོད་གཞུང་རང་ངོས་ནས་བསྒྱུར་བཅོས་གཏོང་བར་དམིགས་ཡུལ་ལེགས་མིན་སོགས་བསྙད་དེ་འགོག་རྐྱེན་ཆེད་བཟོ་བྱས་པ་དང་།",
    "གྲ་སྒྲིག་ཆེད་ཁྱེད་རང་ཡང་ཡོང་དགོས་ཞེས་སོགས་བརྗོད་པར།",
    "ཁོ་རང་སྣེ་ལེན་བྱེད་མཁན་ནི་དྲག་ཇུས་དཔོན་གཞོན་པ་ཏིན་ཡིན་པ་དང་།",
    "འདིར་བཀོད་སྒྲིག་གང་ཡང་བྱས་མི་འདུག་ཨང་།",
    "ད་ཐེངས་རིང་མདའ་མ་ཁྱེར་བར་ཐུང་མདའ་གཅིག་པོ་ཁྱེར་ན་ག་འདྲ་འདུག་གམ།",
    "ནོར་གླིང་གཞུང་སྒོའི་འགག་ཏུ་མི་མང་ཕོན་ཆེ་འཛོམས་ནས་གཞུང་སྒོབརྒྱབ་འདུག་ཟེར་བ་དང་།",
    "ཁོ་སྔོན་ཆད་གོ་མིང་ཏང་དང་དམག་འཁྲུགས་རྒྱག་དུས་དཔའ་བོ་བརྒྱད་ཅུ་ཟེར་བའི་གྲས་ཤིག་ཡིན་པ་འདྲ།",
    "གནས་སྐབས་ངང་འཐེན་ཡོང་བ་ཞེས་ཞུས་འདུགཟླ་༣ ཚེས་༡༡ ཉིན།",
    "ཡིན་ནའང་མེ་མདའ་མང་པོ་ཞིག་བེད་སྤྱོད་མི་འདུག་འཕྲུལ་མདའ་བཞི་བཅུ་ཙམ་སྤྲད་ཡོད་པའི་ནང་ནས་དམག་དངོས་གནས་རྒྱག་སྐབས་མདེའུ་ཐོན་རྒྱུ་ཡོད་པ་བཞི་ལས་མི་འདུགཟླ་༣ ཚེས་༡༤ ཉིན།",
    "དེ་འདྲ་ཡིན་ན་ཐུགས་ཁག་མི་འདུག་ཡག་པོ་ཞེ་དྲག་བྱུང་།",
    "དེ་དོན་ལྟར་ཞུས་ཆོག་ཞེས་ལབ་འདུག་གང་དགའ་ཅི་ལེགས་ཀྱི་འཆར་གཞི་སྣ་ཚོགས་ཁྲོད་བྲོས་བྱོལ་གྱི་བསམ་ཚུལ་ཞིག་ཡོད་པ་འདྲའང་།",
    "ཞིབ་ཕྲའི་ཡིག་ལན་རྗེས་སུ་བསྐུར་ཆོག་ལུགས་སོགས་བཀོད་འདུག་སྐབས་དེར་རྒྱ་མིའི་དམག་སྒར་ནས་མེ་སྒྱོགས་གཉིས་བརྒྱབ་པར་མདེའུ་ནོར་གླིང་བྱང་སྒོའི་ན་འདམ་ནང་ཟགས་པར་བརྟེན།",
    "ང་རང་ནས་སྒོ་སྲུང་པ་ཚོར་བསྐོར་གཡེང་བྱེད་པར་འགྲོ་བའི་སྐབས་ལ་ཕར་ཚུར་སུ་ཡིན་པ་ཟེར་བའི་དྲི་བ་བྱེད་པ་དང་།",
    "ཁྱེད་རང་འདིར་བཞུགས་ནས་གང་ཡོང་།",
    "དེ་ནས་མགོན་པོ་ཁང་དུ་༧གོང་ས་མཆོག་འཕྲིན་བཅོལ་གནང་བར་ཕེབས་རིང་དེའི་ཕྱིར་དེར་སྐུ་ངོ་མགྲོན་ཆེན་ཁྱེད་རང་དང་ང་གཉིས་བཞུགས་དུས་སྐུ་སྲུང་པ་ཁོ་གཉིས་དེ་གར་བཞག་ན་ཤེས་ཡོང་བསམ་པའི་དྭོགས་གཞིས་ངས་ཁོ་གཉིས་ཕྱིར་སློག་བྱེད་བཅུག་པ་ཡིན།",
    "སྐུ་ངོ་ཁྱེད་རང་།",
    "ཞེསབཀོད་འདུགར་མ་གྲུ་ཁར་ཕེབས་འབྱོར་བྱུང་སྐབས།",
    "གོམས་ཚར་ན་སྐྱོན་མི་འདུག་ཅེས་ཞུས་པ་ཡིན།",
    "མང་ཆེ་བ་ངས་ངོ་ཤེས་ཀྱི་མི་འདུག་ཁོ་ཚོས་ང་སོ་སོའི་དམག་སྲུང་བར་འགྲོ་དགོས་ལུགས་བརྗོད་བྱུང་ཡང་།",
    "ཞེས་བཀོད་འདུག་འཕྱོངས་རྒྱས་ལ་མ་འབྱོར་གོང་།",
    "ཟ་ངེ་ཟིང་ངེ་བྱུང་ན་ལག་ཆ་ཞིག་དགོས་ངེས་འདུག་པས།",
    "གཡོག་པོ་མི་གཅིག་བཅས་སང་ཉིན་ཉི་མ་མ་ཤར་ཙམ་ལ་རྩེ་ལ་འབྱོར་བ་ཤོག་ཅེས་ཡི་གེ་སྐྱེལ་མཁན་མི་གཅིག་ཐོང་ཞེས་ང་རང་ལ་བཀའ་མངགས་བྱུང་བ་བཞིན་ཡི་གེའི་བརྗོད་བྱར་ཡང་དེ་རང་བཀོད་དེ་ཉིན་གུང་ཡོལ་ཙམ་ལ་མི་གཅིག་བཏང་བ་ཡིན།",
    "ནོར་བུ་གླིང་ག་ཕལ་ཆེར་ཚར་བ་མིན་འགྲོ།",
    "དམར་ནག་གཉིས་བསྐུལ་རྒྱག་ཡས་དང་ལྗགས་སྐྱེམ་འབུལ་རྒྱུ་སོགས་གནང་ན་ཕན་ཐོགས་ཆེ་བ་འདུག་ད་ནངས་ཞོགས་པ་རྩེ་ནས་ཁ་དཔར་ཞིག་སླེབས་བྱུང་།",
    "ཚེས་༢ ཉིན་གྱི་སྔ་དྲོར། བོད་ལྗོངས་ཀྱི་ངོ་ལོག་ཟིང་འཁྲུག་ཞོད་འཇགས་ཀྱི་གནས་ཚུལ་དངོས་བཀོད་ཟེར་བའི་ནང་ཚེས་༢༡ ཞེས་འཁོད་འདུག་པ་འབྲི་ནོར་ཤོར་བ་འདྲ།",
    "རྒྱ་མིའི་ལག་པ་ནས་ཤི་བ་ལས་བྲོས་ནས་ཐར་ས་འདུག་མི་འདུག་ཅིག་བལྟས་ན་ཞེས་བརྗོད་པར་ཁོས་དེ་ག་རང་བྱེད་དོ་ཟེར་བྱུང་།",
    "བསམ་འཆར་འདི་བོད་ལྗོངས་ཀྱི་ངོ་ལོག་ཟིང་འཁྲུག་ཞོད་འཇགས་ཞེས་པའི་ཤོག་ངོས་༨༡ པར་ལུང་འདྲེན་བྱས་འདུག་ཅིང་།",
    "བོད་ལྗོངས་ཟིང་འཁྲུག་ཞོད་འཇགས་ཀྱི་གནས་ཚུལ་དངོས་བཀོད་ཟེར་བའི་ཤོག་ངོས་༨༥ སྟེང་འདི་ལྟར་བཀོད་འདུག་སྟེ།",
    "དེ་མིན་མི་བཅུ་ལྷག་འདུག་མི་མང་ཆེ་བ་ཆུའི་ཕར་ཕྱོགས་སུ་འདུག་དེ་ནས་ཅང་མ་འགོར་བར་ཡབ་གཞིས་སྐུ་འཁོར་དང་ཡོངས་འཛིན།",
    "ག་དུས་འགོ་ཚུགས།",
    "ནམ་རྒྱུན་དེ་ཙམ་མིན་ཡང་བྲོས་བྱོལ་ལམ་དམག་འཐབ་ཀྱི་ཛ་དྲག་དུས་སྐབས་སུ་དེ་ནི་བར་ཐག་ཐུང་ཐུང་ཞིག་གཏན་ནས་མིན།",
    "ཁོ་རང་བཅས་གསུམ་སྐད་བཏང་སྟེ།",
    "མགོན་པོ་རིའི་དམག་འཁྲུག་ནང་རང་དམག་ལ་ཤི་རྨས་ཚབས་ཆེན་བྱུང་བ་དང་།",
    "ང་རང་དེ་དུས་ལོ་༣༢ ཡིན་སྟབས་འདེམས་མ་བྱུང་ཞེས་གསུངས།",
    "ང་རང་ལའང་བོད་བསྟན་སྲིད་མི་རིགས་ཀྱི་ཆེད་དུ་ལུས་སྲོག་འབུལ་རྒྱུའི་ཆོད་སེམས་བརྟན་པོ་ཡོད།",
    "ཨ་འབྲུག་ཚང་མཉམ་རང་དམག་བཞི་བརྒྱ་ལྷག་འབྱོར་འདུག་ལྷུན་རྩེར་འཐབ་ར་བཟུང་བ་མ་ཟད།",
    "ཕྱིར་བལྟས་ཀྱང་བྱེད་ལོང་མེད་པར་ཤར་བསྐྱོད་བྱས་འདུགཕྱི་ཉིན་གོང་ས་སྐྱབ་མགོན་ཆེན་པོ་མཆོག་ཕེབས་སྐྱེལ་ཞུས་པའི་གཞུང་དམག་༤ ལྷག་མཐའ་མཚམས་ནས་ཕྱིར་ལོག་པ་དང་།",
    "ཁང་པ་དེའི་ནང་རང་ཕྱོགས་ཀྱི་དམག་རྟ་ཡོད་པ་དང་།",
    "ང་རང་རྫ་སྟོད་དགེ་རྒྱས་ཚོ་ཁག་ནས་ཡིན།",
    "དེ་དུས་ང་རང་ལོ་ངོ་༡༦ ཡིན་པ་དང་ཕུ་བོ་ལོ་༡༨ ཡིན།",
    "ང་རང་ལོ་ན་ཆུང་ལ་གྲ་པ་ཡིན་སྟབས་བཏང་མེད།",
    "ང་རང་ལ་མེ་མདའ་མེད་ལ་གྲ་པ་ཡིན་སྟབས་རྒན་བྱིས་མཉམ་ཡིབ་སྟེ་རི་འོག་ཏུ་ངའི་ཨ་པ་དང་ཕུབོ་བཅས་ཀྱིས་རྒྱ་དམག་དང་དམར་འཛིང་བྱས་པར་བལྟས་ཏེ་བསྡད་པ་ཡིན།",
    "དམར་འཛིང་སྐབས་སྣ་ཆེ་ལ་མཆུ་ལྤགས་ཤིན་ཏུ་མཐུག་པའི་རྒྱ་དམག་ཤིག་ཁོང་ལས་མགོ་གཅིག་ཙམ་མཐོ་བ་འདུག་དགྲ་དམག་དེས་མེ་མདའ་སྦག་སྦག་ཅིག་ཁྱེར་ཏེ་མཆོངས་ཡོང་ཞིང་།",
    "ང་རང་གཅིག་པུས་མཐོང་བ་གྲངས་ཀ་དེ་ལས་ལྷག་ཅིག་རི་མགོ་གཅིག་པུར་གནམ་གྲུས་འབོམ་འོག་རྐྱེན་འདས་སུ་འགྲོ་བ་བརྒྱ་ཕྲག་འགའ་ཞིག་ཏན་ཏན་ཡོད་ཅེས་བརྗོད།",
    "ནུབ་མཚམས་ཀྱི་བོད་དམག་རྣམས་ནས་དགྲ་དམག་དང་ཐུག་དུས་ཤར་མཚམས་སུ་བྲོས་པ།",
    "ང་རང་ཡང་མར་ཉལ་ཏེ་མེ་མདའ་འགའ་ཞིག་བརྒྱབ་ཀྱང་མདེའུ་གྲོན་ཆུང་ཆེད་མང་པོ་རྒྱག་མ་ཕོད།"
  ]
}