    "གཅིག་ཏུ་འདུག་ན་དེ་ཡང་ཇི་ལྟ་བུ།",
    "མང་པོར་འདུག་ན་གྲངས་ཇི་ཙམ།",
    "མང་པོར་འདུག་ན་སོ་སོར་དབྱིབས་ཁ་དོག་སོགས་སུ་གྲུབ་པ་གཞིར་བཅས་པས་ཇི་ལྟར་སྣང་།",
    "ཕྱོགས་ཞེན་དང་བྲལ་བར་འདུག་པ་སྟོང་པ་དེ་ཡང་ངོ་བོ་ཉིད་མེད་པ་མ་ཡིན་ཏེ་གསལ་ལ་དངས་པ་མན་ཤེལ་ལྟ་བུ་འདི་མཐོང་ངམ།",
    "ཕྱིའི་སྣང་བ་གང་ཤར་ཐམས་ཅད་སྣང་སྟོང་རང་བྱུང་རང་ཞི་སྤྲོས་པའི་མཐའ་དང་ཉམས་སུ་ལན་པའ་ཆ།",
    "མེད་པ་ནི་མ་དང་རང་བཞིན་མེད་པར་ཤེས་པ་དེ་བུ་ཡིན་པས་ན།",
    "ཕྱི་རོལ་གྱི་ཡུལ་སྣང་སྣ་ཚོགས་སུ་འདུག་ཀྱང་རང་སྣང་བསས་སས་ས་། ཡིན་སྣང་བ་ལ་འཛིན་པ་མེད་པར་བལྟ།",
    "སྣང་སྟོང་གཉིས་པོ་ལ་སྔ་ཕྱི་མེད་པས་སྣང་བ་རང་སྣང་སྟོང་པ་རང་སྟོང་མསེམས་ཉིད་སྟོང་པ་གཉིས་མེད་བདེ་ཆེན་གསལ་ལ་མ་འདྲེས་པས་འཇའ་ཚོན་ལྟ་བུར་རྟོགས་ཙ་ན།",
    "བདེ་གསལ་མི་རྟོག་ཉམས་ཤིག་འཆར་བྲིས་ཞེས་གསུངས་པ་དོན་འདུས་ཤིང་གོ་སླ་བར་འདུག་པས་བྲིས་པ་ཡིན།",
    "སྐབས་འདིར་སྤྲོས་པ་ལ་དགའ་ན་དྲུག་བཞི་ལྡན་གྱི་སྒོ་ནས་ཕྱུར་བསལ་བར་མཛད་པའི་ཕྱག་ལེན་ཡང་གདའ་སྟེ་མི་འགལ་ལོ།",
