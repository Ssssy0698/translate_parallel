    "བཟླས་པ་དག་གི་མཐའ་རུ་ཚོགས་ཀྱིམ་ཚིམ་པར་བྱ།",
    "རང་གི་ཕ་ལ་ནམ་ཡང་གསོལ་བ་ཤྲྰི་འདེབས་ཏེ།",
    "རང་གི་ངག་གིས་ཀུན་ནས་རྣམ་པར་དག་པ་འདི།",
    "གང་གི་ཡིད་ཀྱི་རང་བཞིན་གང་གིས་ཤེས་ནནི།",
    "སྟོན་པ་དེ་ཡིས་དེ་ལ་རང་གི་ཞལ་སྦྱིན་ནོ།",
    "རང་གི་སེམས་ཀྱི་སྐྱོན་གྱིས་བདུད་དུ་སྐྱེ་བར་འགྱུར།",
    "བོར་ནས་ཡན་ལག་བཟང་པོ་བོར་ནས་ན་ཆུད་དག་ལ་མོས།",
    "གང་གིས་བདུད་རྩི་བོར་ནས་དུག་ནི་འཐུང་བར་བྱེད།",
    "གཞན་དག་རྣམས་ནི་བུད་མེད་ལུས་ཀྱི་འདོད་ཆགསཞེན།",
    "བྲམ་ཟེ་གང་གི་རད་གཟུགས་པགས་པའི་རང་བཞིན་གྱིས།",
    "འཇུག་ངོགས་དག་ཏུ་སོང་ནས་སླར་ཡང་འོངས་ནས་ནི།",
    "ས་ལ་འཁོད་དེ་རང་གི་ཁྱིམ་དུ་འགྲོ་བར་བྱ།",
    "རང་གིས་འབུལ་ན་སྤྱི་བོ་ཡིས་ནི་ཕྱག་བྱའོ།",
    "རང་གི་ཕྱག་རྒྱ་རབ་ཏུ་སྦྱངས་ཏེ་དབུལ་བར་བྱ།",
    "ཇི་ལྟར་རང་གི་སེམས་ནི་སྐྱོ་བར་མི་ཁ་གྱུར་བར།",
    "དེ་བཞིན་བུའི་ཆུང་མ་བུ་མོ་སྲིད་མོ་དང་།",
    "རྒྱུག་མོ་ལ་སོགས་དང་ནི་རིགས་ལྡན་ཁྱོ་མེད་མ།",
    "དག་ཅིང་བཞིན་ལྡན་ཁྱོ་མེད་རྣམས་དང་རིགས་ལྡན་མ།",
    "དེ་བཞིན་འདིར་ནི་རིགས་ལྡན་ཁྱོ་མེད་བསྟེན་བྱ་བ།",
    "དེ་ཕྱིར་ཁྱོ་མེད་རིགས་ལྡན་དག་ནི་སྦྱིན་མི་བྱ་ ཁྲོ་བའི་སེམས་དང་བཅས་ཤིང་ཆང་མི་ཐུད་བ་དང་།",
    "ཆང་གི་བརྒྱད་འགྱུར་ན་ཆུང་མ་ལ་རབ་སྦྱོར་ཏེ།",
    "ཁྱད་པར་འཕགས་པ་རང་གི་རྗེལ་དབུལ་བར་བྱ།",
    "རང་གི་ཁྱིམ་ན་བཞུགས་པའི་ཕྱག་རྒྱ་མེད་པ་ན།",
    "རང་གི་ཕྱག་ཆུ་ལ་ནི་བརྟེན་པར་མི་བྱའོ།",
    "དམ་ཚིག་ལ་ཞུགས་རྒན་པའི་བུད་མེད་མཆོག་ཡིན་གྱི།",
    "དམ་ཚིག་རབ་དམན་བུ་མོ་གཞོན་ནུ་མ་ཉིད་མ་ཡིན་ནོ།",
    "སྐྱེ་བ་འདི་རུ་རང་གི་ལུས་ཀྱི་བདུད་འཇོམས་པར།",
    "ཕྱག་རྒྱ་དེ་རྣམས་ཀུན་ནི་རྒྱལ་བའི་སྲས་མོ་སྟེ།",
    "ཇི་ལྟར་རང་གིས་ནུས་པས་འདོད་པ་གནས་པ་ན།",
    "དཔལ་ལྡན་ཚངས་པར་སྤྱོད་པ་བུད་མེད་ལ་སྦྱོར་བ།",
    "ཞུ་བར་འགྱུར་གྱི་ཐལ་བརུ་ནི་མི་འགྱུར་རོ།",
    "དེ་བཞིན་ཆུ་སྐྱེས་སྦྱོར་བས་མཆོག་གི་བྱངཆུབ་སེམས།",
    "བུད་མེད་སྦྱོར་བ་དམན་ཀྱང་སྲིད་མའི་སྡུག་བསྔལ་མེད།",
    "དེ་བསརང་གི་བློ་ཡིས་ལེགས་པར་དཔྱད་ནས་ནི།",
    "སྔགས་པས་གང་ལ་མོས་པ་ཡང་ནི་བླང་བར་བགྱིས།",
    "བུད་མེད་སྐྱེ་གནས་སྦྱོར་ལས་བདེ་བ་མ་ཉམས་པར།",
    "བཅུགསུཨེ་མ་བློ་གྲོས་ཕྱིན་ཅི་ལོག་གི་སྐྱ་བོ་རྣམས།",
    "རྨི་ལམ་གཟུགས་བརྙན་དེ་ནི་སུ་ཞིག་གིས་བྱས་ཏེ།",
    "བདེ་བ་དང་ནི་སྡུག་བསྔལ་གང་གི་དྲིནགྱིས་ཐོབ།",
    "བདུད་ན་རང་གི་སེམས་ཏེ་བདུད་གཞན་ཡོད་མ་ཡིན་ དེ་བཞིན་གཤེགས་པ་དེ་ཡད་བདེ་གཤེགས་གཞན་ན་མེད།",
    "མྱ་ངན་འདས་པའི་མཐར་ཐུག་དེ་བཞིན་བདག་གི་དོན།",
    "དཔག་མེད་རྒྱུ་རུ་དགེ་སློང་གིས་ནི་གང་ཞིག་བསྲུངས།",
    "ཕྱག་རྒྱ་བཟངམོ་བདེ་བའི་དོན་དུ་བཟུང་བར་བྱ།",
    "ཡན་ལག་བཟང་མོ་ཆགས་པ་ལ་ནི་རབ་ཏུ་ཞེ་ན།",
    "ཡེཤེས་དག་གིས་མེན་རབ་ཏུ་བཞེངས་པར་བྱ།",
    "གང་རྣམས་རང་གི་སེམས་ནིརྩ་དབུས་གནས་པར་འགྱུར།",
    "ཇི་ལྟར་ཡིད་བཞིན་ནོར་བུ་དཔག་བསམ་ཤིང་དག་གིས།",
    "རར་གི་སྟོང་པ་ལ་ནི་ངེས་པར་རྒྱས་གདབ་སྟེ།",
    "ཆགས་པཞེ་སྡང་གིས་ནི་རིགསནི་ལྡོག་པར་འགྱུར།",
    "མིང་བོ་དང་ནི་སྲིང་མོ་བག་མར་རིགས་མ་ཡིན།",
    "རང་གི་རིགས་ནི་འཛིན་ཕྱིར་དེ་དག་ལ་འགྱུར་པོ།",
    "དེ་ལྟར་དཔུང་བརླ་རྐར་པ་ལས་བྱུང་རྣམས་ལ་ནི་ གང་ཞིག་རང་གི་རིགས་ནི་འཛིན་ཕྱིར་ལྡོག་པརའགྱུར།",
    "གཞན་དུ་ན་ནི་རང་གི་རིགས་ཀྱི་རགས་འགྱུར་མིན།",
    "རང་གི་ལསཀྱི་རང་བཞིན་ལས་ཀྱི་ངོ་བོར་སྐྱེས།",
    "དཀའ་ཐུབ་ཁྱད་པར་དག་གིས་དྲང་སྲེང་རྣམས་སུ་འགྱུར།",
    "དག་པའི་བྲམ་ཟེ་མོ་གར་བདག་པའི་བརྟུལ་ཞུགས་ཅན།",
    "ལུས་འདིའི་སྔ་མའི་རགས་ཀྱི་ཐལ་བ་གཞན་ཡིན་ལ།",
    "གཞན་དུ་ལུས་དང་སྲོག་ཚེ་དག་གི་ནི་རིགས་དག་ཀྱང་།",
    "བུ་དང་བཅས་པ་སུ་ཞིག་གིས་ནི་འབྱིན་པར་བྱེད།",
    "བ་འདི་དག་ཐམསཅད་རང་གི་རིགས།",
    "རང་གིས་བྱིན་པ་རང་ཞྀད་ཀྱི་༥ནི་ཐོབ་འགྱུར་ཏེ་ གཞན་མ་རྣམས་ཀྱི་སྦྱིན་པ་བསྔོས་པའི་བློ་ཡིས་མིན།",
    "བདེ་བར་གཤེགས་པས་རང་གི་དོན་དུ་རང་ཤ་ནི།",
    "རང་གི་རྩ་ལག་གྲོགས་པ་ཡིད་འོང་བུ་དང་ཚ།",
    "བུ་དང་རྩ་ལག་སྟོབས་མེད་ལ་སོགས་གི་གྱུར་ན།",
    "ཤི་བརྣམས་ལ་གང་གི་ཆུ་དང་ཟན་སྦྱིན་ནོ་ རྨོངས་པ་དེ་ཡིས་ཇི་ལྟར་མ་སྐྱེས་ལ་སོགས་བསོད།",
    "བ་ལ་རེག་པ་དང་ནི་བྲམ་ཟེ་ཚི་མ་པ་དང་།",
    "བ་སྐྱོབ་ཀའུ་ཡིས་བ་ལ་རེག་པར་བྱེད་པ་དང་།",
    "བ་ནི་ལཱ་ཡི་མིག་ཡིན་རེག་པ་སྣང་བ་སྟེ།",
    "དྲན་པ་དང་ནི་རིག་བྱེད་གཞུང་གི་སྐུ་ཚོགས་པ།",
    "གང་གིས་ཡུལ་དེ་དག་ཏུ་འདོད་པའི་དངོས་གྲུབ་ནི།",
    "མེ་ཏོག་སོགས་དར་ལྷ་མོ་དང་ནི་དཔལ་མོ་དང་།",
    "བྱུང་ན་ལོར་བའི་འཐབ་མོའི་དུས་སུ་ཡོད་མ་ཡིན།",
    "རད་གི་ཕྱིས་བཞིན་དུ་རྣམ་པར་མི་དཔྱད་དོ།",
    "སྔོན་དུ་ཡུལ་སྐད་ཡིན་ན་རགི་བྱེད་ཐོག་མར་མེད།",
    "བུད་མེད་པས་ནི་མཐོ་ས་གནས་སུ་མི་འགྲོ་ན།",
    "གང་གིས་ས་ལ་རྐང་པ་གསུམ་དུ་བྱས་པ་ན།",
