    "དེའི་སྣང་བ་ཐམས་ཅད་ཁོ་རང་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པར་འདུག་ཀྱང་།",
    "སེམས་གཟུགས་སུ་ཀྲོང་ཀྲོང་གདའ་བ།",
    "སྣང་བ་དེ་ཁོ་རང་ངོ་བོ་ཉིད་ཀྱི་སྟོང་པར་འདུག་སྟོང་པར་འདུག་ཀྱང་སྣང་བ་འགག་ཏུ་མ་བཏུབ་སྟེ།",
    "སྒྱུ་མ་ལྟར་ཝལ་ལེ་འདུག་པས།",
    "དེར་ཁོ་རང་དག་ལ་འགྲོ།",
    "སྒོམ་བཟང་པོ་སྐྱེས་པ་དེ་ལ་ཚོགས་བསགས་པ་ཞིག་འདུག་ཟེར་བ་བཞིན་ནོ།",
    "དེས་ན་རྟེན་ལུས་འཕྲུལ་འཁོར་ལ་སིང་གཅུན་ཙ་ན་བརྟེན་པ་སེམས་ལ་རྣམ་རྟོག་མི་འགྱུ་དགུ་འགྱུ་རང་འགགས་སུ་འགགས་ཏེ།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "གདན་ནང་ཚངས་ཅན་ཤིན་ཏུ་འབོལ་བ་ལ་འདུག་སྟེ།",
    "ཐབས་མཁས་པའི་སྤྱོད་ལམ་བསྟེན་ཏེ་ལྡང་བ་དང་འགྲོ་འདུག་བྱེད་པའི་དུས་ཧུར་རྩེར་མི་ལང་བར་རྒན་གོག་ལང་བ་བཞིན་དལ་བུས་ལང་བ་དང་།",
    "སེམས་ཁོ་རང་རང་སར་ཕྱམ་མེ་ལྷོད་དེ་ཤིག་གེ་བ་ལ་མ་ཡེངས་ཙམ་མ་བརྗེད་ཙམ་དུ་སྐྱོང་བ་ལས།",
    "དེ་ལ་དྲིས་པས་བསྒོམ་ལ་བཞག་ཙ་ན་སེམས་གང་ལའང་མི་འཕྲོ་བར།",
    "སྒོམ་ལས་ལང་ཙ་ན་ཤེས་པ་བདེ་འབོལ་ལེ་བ་ཟི་བུན་ནེ་བ།",
    "སེམས་སྒོམ་ཐོག་ཏུ་བཞག་ཙ་ན་རྟོག་པ་རང་ཞི་ལ་ཁག་འགགས་ནས་སེམས་རྟོག་མེད་དུ་ལྷོད་དེ་གནས་པ་དེ་ལ་སྒོམ་ཞི་གནས་སྐྱེས་པ་ཟེར་བ་ལགས་སོ།",
    "འདུག་པ་མ་ཡིན་ལངས་པ་མིན།",
    "སེམས་ཁོ་རང་རང་སར་བཞག་པ་ལས་མ་ཡེངས་པར་བྱ།",
    "དེ་ལ་སྔར་དང་ཁྱད་ཅི་འདུག་དྲིས་པས།",
    "ད་ལན་གྱི་སེམས་གནས་པ་དེ་རིག་པ་དྭངས་པ་གསལ་སིང་ངེ་བ་ཞིག་འདུག་ཟེར་ན་སྐྱེས་པ་ཡིན།",
    "དེ་ལ་བལྟས་ཙ་ན་ངོས་བཟུང་ཅི་ཡང་མེད་པ་ཞིག་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན་ཏེ།",
    "དེ་དག་ལ་ཅུང་ཟད་གཅིག་བཅུན་ནས་འདྲིས་པས་ད་ཅིའི་དེ་ཀ་ལ་འཕོ་འགྱུར་མི་ཡོང་བར་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན།",
    "དེ་ལ་རྩེ་གཅིག་ཏུ་མི་ཡོང་བ་འདུག་ན་གོ་བ་ཡིན་པས་རྒྱུད་ལ་མ་སྐྱེས་པའི་གོ་ཡུལ་གྱིས་གྲོལ་མི་ཐུབ།",
    "ངོ་བོ་ལ་བལྟས་ཙ་ན་གཟུགས་གྲུ་བཞི་དང་།",
    "ནག་པོ་ལ་སོགས་པ་ཅི་ཡང་གྲུབ་པ་མི་འདུག་པས།",
    "འདི་འདྲ་ཞིག་འདུག་བརྗོད་མི་ཤེས་པའི་སྟོང་པ་ཉིད།",
    "རིག་པ་འདི་ལ་གཟུགས་ཁ་དོག་ལ་སོགས་པའི་ངོས་བཟུང་ཅིར་ཡང་གྲུབ་པ་མི་འདུག་པས་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་ཡང་མ་ཡིན།",
    "ད་དེ་ལྟར་དུ་འདུག་གམ་མི་འདུག་ལྟ་བ་ལ་ཡང་སྔར་བཞིན་ཞག་གསུམ་བསྒོམ་ལ་བྱོན།",
    "འདུག་ན་དགའ་བ་བསྒོམ་མཛོད།",
    "དེ་ནས་སྔར་བཞིན་འདུག་གམ་མི་འདུག་དྲིས་ནས།",
    "སྣང་ལ་རང་བཞིན་མེད་པ་ཞིག་འདུག་པ་དེ་སེམས་ཀྱི་མཚན་ཉིད།",
    "དེ་གསུམ་དབྱེར་མེད་པ་ཞིག་འདུག་པ་དེ་སེམས་ཀྱི་བཞུགས་ཚུལ་ལམ་གནས་ལུགས་ལགས་སོ།",
    "རྟོག་པ་དེའི་ངོ་བོ་ལ་ལྟོས་ལ་སེམས་གནས་པ་དེ་དང་འཕྲོ་བ་དེ་ལ་ཁྱད་ཅི་འདུག་ལེགས་སུ་ལྟོས་ལ་ཞག་གསུམ་ན་ཤོག་དེ་ལ་དམིགས་སྐོར་གཅིག།",
    "དེ་ལ་བལྟས་པས་ཁྱད་མི་འདུག་ཟེར་ན།",
    "ཁྱད་ཇི་ལྟར་མི་འདུག་རྟོག་པ་ནི་བློ་གྱ་གྱུ་བ་སྣ་ཚོགས་སུ་འཕྲོ་བ་འདི་ཡིན།",
    "རྟོག་པ་དེ་ལ་ཟེར་བལྟས་ཙ་ན་ངོ་བོ་ངོས་བཟུང་ཅི་ཡང་མི་འདུག་པ་དེ་རྟོག་པའི་རང་བཞིན་ཡིན།",
    "ཧྲིག་གེརྗེན་ནེ་བ་ཞིག་འདུག་པ་དེ་རྟོགས་པའི་མཚན་ཉིད་ཡིན།",
    "དེ་ནས་སྔར་བཞིན་བསྒོམས་པའི་སྒོམ་བཟང་བདོ་བ་དེ་ལ་ལྟོས་ལ་དེ་གཉིས་ལ་ཁྱད་འདུག་གམ་མི་འདུག་ལྟོས་ལ་ཞག་གསུམ་ན་ཤོག་དེ་ལ་དམིགས་སྐོར་གཅིག།",
    "གལ་ཏེ་སེམས་ཀྱིས་བཟུང་བས་སྣང་བ་ཙམ་མ་ཡིན་ཞིང་རང་རྒྱུད་པར་སྣང་བ་ཡིན་ནོ།",
    "དཔེ་རྨི་ལམ་གྱི་མི་རྟ་ལ་སོགས་ཡོད་པ་ལ་གཉིད་སད་ཙ་ན་མི་འདུག་པ་དེ་དང་པོ་ནས་མེད་པ་དེ་མེད་པར་མངོན་དུ་གྱུར་པ་བཞིན་ནོ།",
    "སྒྲ་དེ་ཇེ་མི་གསལ་ཇེ་ཆུང་ལ་མི་ཐོས་པར་འགག་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན་པས་གཟུགས་སྣང་ལ་ངོ་སྤྲོད་པ་བཞིན་ངོ་སྤྲད་དོ།",
    "དྲི་ཞིམ་ན་ཞིམ་པའི་ངོ་བོ་ལ་བདག་ཏུ་གྲུབ་པ་ཅི་འདུག་ལྟ།",
    "དྲི་མི་ཞིམ་ན་མི་ཞིམ་པ་དེ་ལ་བདག་ཏུ་གྲུབ་པ་ཅི་འདུག་ལྟ།",
    "དྲི་མངར་བ་དང་སྐྱུར་བ་ལ་སོགས་པའི་དྲི་དེ་ལ་བདག་ཏུ་གྲུབ་པ་ཅི་འདུག་ལེགས་པར་ལྟ།",
    "དེ་ལ་ངོ་བོ་གྲུབ་པ་རང་མི་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན་པས་ངོ་སྤྲད་དེ།",
    "སྒོམ་བསྒོམ་རྒྱུ་དེ་ཅི་འདྲ་ཞིག་འདུག།",
    "ཐ་མལ་གྱི་ཤེས་པ་བཅས་བཅོས་མེད་པ་འདི་ཀ་རང་དུ་གདའ་བ།",
    "དེས་ན་ཐ་མལ་རང་ལུགས་ཅི་བདེར་བཞག་པ་ལས་སེམས་ཁོ་རང་ལ་བཅས་བཅོས་དང་།",
    "ཆེད་འཛིན་དང་གཉེར་ཁ་མི་བྱེད་པར་སེམས་ཁོ་རང་ཇི་ལྟར་འདུག་པ་དེའི་རང་ཞལ་ལ་མ་ཡེངས་པར་ལྟའོ།",
    "དྲན་པ་ཁོ་རང་བསྒོམ་དུ་ཀྲོང་ངེ་ཤར་ནས་སྒོམ་ལོགས་སུ་བསྒོམ་དུ་མི་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན་པས་ངོ་སྤྲད་དོ།",
    "དྲན་པ་ལས་གཞན་པའི་སྒོམ་ཞིག་མི་འདུག་མ་དྲན་ན་མ་དྲན།",
    "བྱུང་བའི་ངོ་བོ་ཅི་འདྲ་ཞིག་འདུག་ལེགས་པར་ལྟོས།",
    "འགྲོ་བའི་ངོ་བོ་དེ་ཇི་འདྲ་ཞིག་འདུག་ལེགས་པར་ལྟོས།",
    "གནས་པའི་ངོ་བོ་ཇི་འདྲ་ཞིག་འདུག་ལེགས་པར་ལྟོས།",
    "སེམས་ཁོ་རང་ལ་ངོ་བོ་ངོས་གཟུང་གང་ཡང་མི་གདའ་བས།",
    "བྱུང་ས་དང་གནས་ས་དང་འགྲོ་ས་མི་གདའོ་ཟེར་ན་ངོ་སྤྲད་དེ།",
    "བྱུང་བའི་ངོ་བོ་འདི་འདྲ་ཞིག་འདུག་རྙེད་པ་ལ་ཡོད་མཁན་མ་གྲུབ་པས་དེ་རྣམས་མི་རྙེད་དོ།",
    "ཁ་ནང་དུ་ལོག་སྟེ་སེམས་ལ་ཅེར་བལྟས་པས་རྟག་པ་དང་ཡོད་པར་ལྟ་རྒྱུའི་གཟུགས་ཁ་དོག་ཏུ་གྲུབ་པ་འདུག་གམ།",
    "རྟག་གོ་ཡོད་དོ་སྙམ་དུ་བློ་ལས་བཟུང་བས་རྟག་པ་དང་ཡོད་པར་གྲུབ་རྒྱུ་ཞིག་འདུག་གམ།",
    "དེ་དག་ཡིན་ནོ་སྙམ་དུ་བློས་བཟུང་བས་དེ་དག་གང་དུའང་འགྲོ་བར་མི་འདུག་སེམས་གསལ་ལ་ངོས་བཟུང་མེད་པས་སལ་ལེ་སིང་ངེ་བ་དེ་ཀར་གདའོ་ཟེར་ན་ངོ་སྤྲད་དེ།",
    "རིག་ཅིང་གསལ་བ་དེ་ལ་གཟུགས་ཁ་དོག་ལ་སོགས་པ་ཅི་ཡང་གྲུབ་པ་མི་འདུག་པས་ཡོད་པའི་མཐར་མ་ལྷུང་།",
    "སེམས་ཅིར་ཡང་མ་གྲུབ་པས་དེ་ལ་ཕན་གནོད་བྱ་ས་མི་འདུག་དགེ་སྡིག་རང་ཡང་དོན་ལ་གྲུབ་པ་མི་འདུག་ཟེར་ནས་ངོ་སྤྲད་དེ།",
    "མྱོང་བའི་ཚེ་རྨི་ལམ་གྱི་འཁྲུལ་སྣང་ཡིན་པར་ངོ་ཤེས་ཙ་ན་བདེ་སྡུག་མ་སྤངས་ཀྱང་རང་སངས་ལ་འགྲོ་སྟེ།",
    "སེམས་གསལ་ལ་ངོས་བཟུང་མེད་པ་འདི་ལ་སྒྲིབ་པའི་འཆིང་བར་བྱེད་པའི་མ་རིག་པ་དེ་ཇི་འདྲ་ཞིག་འདུག་ཚུལ་ཇི་ལྟར་དུ་སྒྲིབ་འདུག་སྒྲིབ་པའི་ངོ་བོ་དེ་ཇི་འདྲ་ཞིག་འདུག་ལེགས་སུ་བལྟ།",
    "སེམས་ལ་ངོས་བཟུང་མི་འདུག་པས་བཅིངས་པ་དང་གྲོལ་བ་མི་འདུག་ཟེར་ན་ངོ་སྤྲད་དེ།",
    "འགྲོ་འདུག་པ་དང་།",
    "གནས་ལུགས་ཅིར་ཡང་མ་གྲུབ་པའི་སྟོང་པར་འདུག་པས་ན་ཕྱག་སྟེ།",
    "དེའི་རང་བཞིན་མེད་པས་སྟོང་པ་དེ་ལ་དེའི་རང་བཞིན་མི་འདུག་ཀྱང་དེའི་རྣམ་པར་གསལ་བས་སྣང་བའོ།",
    "འཁྱམས་པའི་དུས་ན་ཡང་རང་བཞིན་རྣམ་དག་ཏུ་ཡོད་དེ།",
    "སྐད་ཅིག་མ་ཕྱི་མ་སྐྱེ་ཙ་ན་སྐད་ཅིག་མ་སྔ་མ་འགགས་པས་མི་རྟག་པའོ།",
    "དུས་འདི་ཙ་ན་འགྲོའི་འགྲོ་སའི་མཐའ་མི་འདུག་པས་འགྲོ་འོང་དང་བྲལ་བ་སྟེ།",
    "འཛིན་ཤེས་ནམ་འགག་ཙ་ན་སྣང་བ་ཡང་འགག་གོ།",
    "འདི་ཡིན་གྱི་ངོ་བོ་ངོས་བཟུང་མེད་པ་ཞིག་འདུག་སྟེ།",
    "ཐ་མལ་གྱི་ཤེས་པ་འདི་ཁོ་རང་ལ་བཅས་བཅོས་མེད་པའི་རང་ལུགས་ལ་གྲ་ཡམ་མེ།",
    "ཇི་ལྟར་འདུག་པའི་རང་ཞལ་ལ་ལྟ་ཞིང་མ་ཡེངས་པར་བསྐྱངས་པ་ལས།",
    "གང་སྣང་བ་དེ་གའི་ཐོག་ཏུ་མ་བཅོས་པར་བཞག་པས་སྣང་བ་མ་བཀག་ཀྱང་རང་འགགས་པའམ།",
    "འགྲོ་འདུག་བྱེད་པ་དང་།",
    "སེམས་སྣང་ལ་རང་བཞིན་མེད་པ་དེ་འཁོར་འདས་ཐམས་ཅད་ཀྱི་བྱེད་པ་པོའམ་མཛད་པ་པོར་འདུག་པས་རྣམ་པར་སྣང་མཛད།",
    "དེ་ཡང་རང་ཉིད་རྡོ་རྗེ་གདན་དུ་ཕྱིན་ནས་དེའི་མཚན་ཉིད་མངོན་སུམ་དུ་རྟོགས་པ་ལྟ་བུའོ།",
    "དེ་ནམ་རྟོགས་ཙ་ན་རྟོགས་ལྡན་ཟེར་བ་ཡིན།",
    "ཡིན་ན་མཐོང་ལམ་གྱི་ཡོན་ཏན་གང་ཡང་མི་འདུག་པ་ཟེར་ན།",
    "དཀའ་སྤྱད་མ་བྱས་པས་ལམ་གྱི་དྲོད་རྟགས་ཀྱི་སྣང་ཆ་མི་འདུག་ཀྱང་མཐོང་ལམ་ཡིན་ཏེ།",
    "རིག་པའི་ཆ་ཞིག་འདུག་པ་དེ་བདེ་བ་ལ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་སྟེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "འཛིན་སེམས་མེད་པས་ཡུལ་སྣང་རང་སར་དག།",
    "ཤེས་པ་མ་བཅོས་གང་ལྟར་འདུག་པར་བཞག།",
    "ཚར་གཅད་རྗེས་བཟུང་རང་སོར་བཞག།",
    "གསལ་སྟོང་རང་ངོ་མཐོང་བ་དང་།",
    "དཀར་དམར་ལ་སོགས་པའི་ཁ་དོག་ཏུ་གྲུབ་པའི་རྫས་ཀྱི་དངོས་པོ་རྡུལ་ཙམ་ཡང་མི་འདུག་པས་སྟོང་པར་འདུག་སྟོང་པའི་གདངས་མ་འགགས་པ་གསལ་ལ་དྭངས་པ་དྲི་མས་གོས་པར་མི་འདུག་པས་གསལ་བར་འདུག།",
    "ང་ལ་སྒོམ་མི་ཡོང་བར་འདུག་སྙམ་པ་འབྱུང་སྟེ་དེ་ནི་རིག་པ་ཅུང་ཟད་དྭངས་ཏེ།"
  ]
}