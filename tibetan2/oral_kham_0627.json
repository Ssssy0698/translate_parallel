    "རས་སོགས་དངོས་པོ་ཡོན་ཆེ་བས་ཡིད་ཚིམས་པར་བྱས་འདུག།",
    "ལོ་སྔོན་མ་རྗེ་དེ་ཉིད་མྱ་ངན་ལས་འདའ་ཚུལ་སྒྲུབ་གསུམ་པར་བསྟན་པ་ཡིན་འདུག་ཀྱང་།",
    "ས་སུ་ཚུད་སྐབས་དརསོགས་བྱ་བ་ལས་ཀྱི་འཁོར་ལོ་རྒྱ་ཆེ་བས་ཞབས་འབྲིང་པ་ཚང་མ་བློ་ཁོལ་ཆེ་བ་བྱུང་འདུག་ཀྱང་ལ་ལོ་སྙོམས་ལས་སུ་མ་ལུས་པར།",
    "མག་ག་རདང་དངོས་སུ་མཇལ་བ་ལྟ་བུའི་སྤྲོ་དགའ་དང་ཡིད་ཚིམ་པ་བྱུང་འདུག།",
    "དེས་སློབ་དཔོན་དབུས་སུ་འདུག་སྟེ་ཁ་ཤར་དུ་བལྟས།",
    "དེ་ཡང་རང་ཉིད་དཀྱིལ་འཁོར་གྱི་གཙོཔོ་ལས་ཕྱེ་ནས་ཤར་སྒོ་ནས་འཐོན་ཏེ།",
    "ལས་སྔགས་དངཧཱུྃལན་བདུན་བཟླས་བའི་མར་དང་བཅས་པའི་སྤོས་དཀར་གྱིས་འདུག་པར་བྱའོ།",
    "དེ་ལྟར་མཛད་པའི་ལུགས་སྲོལ་མ་ཉམས་པ་ད་ལྟའང་ཡོད་པ་འདུག་ལགས།",
    "རང་རང་ངོ་བོའི་སྒོ་ནས་མ་གྲུབ་པའི།",
    "ད་ཕྱི་པོ་ཆགས་འདུག་ང་མེད་ཀྱང་ཁོ་པས་དཔོན་པོ་ཆེན་པོའི་བྱེད་སྟངས་གཉིས་འགྲུལ་ཁང་དུ་ལོག་འགྲོ་ཞེས་སྨྲས།",
    "ང་རང་ཧ་ཅང་འགྱོད་ལ།",
    "དམར་སྣུམ་གཟི་བརྗིད་ལྡན་པའི་འཛུམ་མདངས་དག་རིག་དུས།",
    "ཡིད་ལ་ཝ་ལེར་འཆར་བ་འགོག་ཐབས་རང་མི་འདུགརིང་རིང་ཟླ་དགུ་ཞག་བཅུའི་ལོ་ཟླ་ཡི་ཁྲོད་ནས།",
    "རྒྱུགས་མ་འདུར་ལ་སྐྱིད་པའི་རང་ཁྱིམ་དུ་ལོག་དུས།",
    "བག་མེད་ལོངས་ལ་གོམས་པའི་ཅོལ་ཆུང་རང་ལགས་སོ།",
    "ཁོང་ལ་ལྷག་བསམ་ཟོལ་མེད་ཁྱེད་རང་ལ་ཕུ་ལུས་ཏང་སེ་ཐུག་བྱུང་ཀྱི་བརྩེ་དུང་ཞིག་བཅངས་ཡོད།",
    "པོས་ང་མཇལ་དགོས་ཡོད་ཟེར་གྱི་འདུག་ཟེར།",
    "ཁྱེད་རང་ག་དུས་ཕེབས་པ་པ་ལགས།",
    "ཁྱེད་རང་ངེས་པར་དུ་ཡོད་པ་དེ་ལ་ང་བསམ་འཆར་གང་ཡང་མེད།",
    "ཁྱེད་རང་བསམ་བློ་གཏོང་དང་།",
    "ཀློག་པ་པོ་རྣམས་ཀྱིས་ཀློག་དུས་སྐུལ་ལྕག་མང་པོ་དང་།",
    "མིའི་འགྲོ་འདུག་སྤྱོད་གསུམ།",
    "དེང་སྐབས་འདུག་ནེམ་ཁྲི་དང་།",
    "ཉིན་ཞིག་སྟོབས་རྒྱལ་གྱིས་སྒོ་བརྡུངས་ཏེ་ཡང་ཁྱེད་རང་ལ་བསུན་པོ་བཟོ་མཁན་ཡིན།",
    "ངའི་དངུལ་ཁུག་བསྡད་མི་འདུག་ཅེས་བརྗོད།",
    "ཡིན་ནའི་ཁྱིས་ཤེས་ཀྱི་མི་འདུག་ཟེར།",
    "ཉི་མ་དགུ་ཤར་འབུམ་གཉིས་གཏེར་ཁུངས་གཅིག་མིན་ཙམ་ལས་ཤིན་ཏུ་གཅིག་པ་འདུག་གཤིས་དེ་ལུགས་ཞིབ་དཔྱད་གནང་མཁན་རྣམས་ཀྱིས་རྗེས་སུ་ངེས་གལ་ཆེ་ཞེས་ཞུ།",
    "རྟ་འུལ་སྐུལ་འདེད་བྱས་མིན་གང་ལྟར་དེ་ནུབ་རང་ཐོན་བསྐྱོད་བྱས་འདུགདེ་རྗེས་བོད་ཟླ་༡༢ནང་བྱང་སྤྱི་མཁན་ཆུང་ཐུབ་བསྟན་བཟང་པོ་དང་།",
    "དེ་བཞིན་ཁྲི་ཆེན་ནས་ལྷ་ལྕམ་ལ་སྐྱོང་འོས་ཐུགས་བརྩེའི་སྤྱོད་བཟང་དང་སྟོ་ཛོ་ལ་སུ་བྲལ་བའི་ཙུབ་སྤྱོད་ཁོ་ན་མཛད་རྐྱེན་ལྷ་ལྕམ་ཉིད་ཐུགས་ཕམ་ཡི་ཆད་ངང་རང་གཟིམ་དུ་གོ་ལོག་ཕྱིར་ཕེབས་མཛད་དགོས་བྱུང་ཞིང་།",
    "ཁྲི་འཛིན་སྐལ་བཟང་སྙན་གྲགས་དགུང་ལོ་༡༦ཐོག་ཁྲི་ཕེབས་མཛད་སྒོ་སྔར་ལམ་ལྟར་གཟབ་རྒྱས་བསྐྱངས་པ་དང་ཆབས་ཅིག་ལྷོ་ཁ་གོང་དཀར་འོ་སྦུག་རྒྱ་མཚོའི་རིགས་སྲས་རིག་འཛིན་ཞུ་བ་ལྷ་བླའི་ལུང་བརྟག་དང་རྩིས་འབྲས་གང་ཅི་དབེ་མཚན་ཕུན་སུམ་ཚོགས་པར་བརྟེན་ལྷ་ལྕམ་དུ་བསུ་བཞེས་མཛད་དེ་ཁྲུང་སའི་མ་ཛད་སྒོ་ཡང་སྟབས་གཅིག་དུས་གཉིས་སུ་མཛད།",
    "དེ་རྗེས་སྟོང་རྒྱུག་ཐེངས་གཅིག་རྒྱུག་དུས་ཞྭ་ཕུད་སོགས་གོང་བཞིན་དང་།",
    "ཉིན་གུང་ནས་ཚོགས་གཞུང་རང་ལ་མཆོད་ཆང་བཏེགས་བཞེས་མཛད་རྐྱང་ཡིན་པ་བཅས།",
    "རྒྱ་རི་བས་བསྐོས་པའི་གསེར་དཔོན་རི་མིག་པ་ཞེས་པའི་ཁྱིམ་ཚང་དེ་བཞིན་དངོས་པོའི་ཆ་རྐྱེན་གང་ལེགས་འདུག་པ་བཅས་དང་།",
    "ལྟ་བུར་གྱུར་འདུག་ཀྱང་གྲངས་ཀ་མ་ཆད་ཙམ་འདུག་པས་ཁུངས་སོ་སོར་རྩིས་འཕྲོད་ཐུབ་ཙམ་བྱུང་།",
    "རིན་ཆེན་གྲགས་པ་བཅས་འབྱོར་འདུགསྐབས་དེའི་སྲིད་སྐྱོང་སྟག་ལུང་བྲག་ཡིན་པས་ཤོད་འགག་ཏུ་གོང་གསལ་ཡབ་གཞིས་ཀྱི་འཚོ་འཛིན་གཉིས་དང་ཕྱག་མགྲོན།",
    "པད་སྦས་ཐང་དུ་མི་གྲངས་སུམ་ཅུ་ཙམ་ཡོད་སྐད་འདུགསར་རྡར་དར་རྒྱས་བོད་ལ་འབྱོར་ཚུལ་སྐོར་རྩོ།",
    "ས་ཚང་གཡར་ཏེ་གནས་སྐབས་ཀྱི་གྲོ་སྤྱི་ཁང་ཞིག་བཙུགས་འདུགགྲོ་སྤྱི་བདུན་པ།",
    "དེའི་ནང་ལྗིད་ཚད་གསེར་སྲང་བཞི་བརྒྱ་ཙམ་ཡོད་པའི་དམ་སྒམ་དེ་ཉིད་དྲུང་ཆེ་གཞོན་པས་གའོན་ཁྲལ་ལྟ་བུར་འཁྱེར་དགོས་ཀྱི་འདུག་ཡིག་ཚང་དུ་དེ་མིན་འགྱེད་འཛིན་ནམ།",
    "ས་ཡིག་ཚང་རང་ནས་བྱེད་སྲོལ་ཡོད།",
    "མ་འདུག་ལོ་ལྟར་རྩེ་རྣམ་སྲས་གན་མཛོད་སྒོ་འབྱེད་བཀར་འཇུག་སྐབས་གཅོོ་འགན་བཀའ་ཤག་དང་།",
    "མཚན་ཐོ་གཅིག་ཡིག་ཚང་རང་དུ་ཉར་དགོས་པ་དེའི་ནང་མཆན་གསལ་དུ་དང་པོ་ལོ་དང་།",
    "ས་ཤོར་གང་ཡང་བྱེད་ལམ་མི་འདུག་ནོར་གླིང་ཉེ་འཁོར་རྒྱ་མཚོ་སྨད་གཞིས་ཀྱི་ནང་བཟན་དང་།",
    "མི་དྲག་སྒེར་ཁག་སོགས་གང་ས་ནས་གཡར་ལེན་གྲ་སྒྲིག་ཞུ་དགོས་འདུག་ཅིང་།",
    "ཆོག་ལའང་སྙན་སྒྲོན་ཟིན་པས་དེ་ལུགས་འཐུས་ཤོར་མེད་པ་དགོས་རྒྱུའི་བཀའ་ཕེབས་འདུག་ཅེས་བཀའ་ནན།་",
    "ང་རང་ནས་ཕྱག་མཇོད་འགན་འཁུར་བྱས་པའི་བརྒྱུད་རིམ།",
    "བྱི་༡ཁ་༤ཊྭཱཾ་ལོར་ང་རང་ལྷ་སའི་ཕྱག་མཛོད་འགན་འཁུར་དང་།",
    "ང་རང་བཅས་སང་ཉིན་ཤོད་གཟིམ་འགག་ཏུ་བཅར་དགོས་བརྡ་ཐོ་བཏང་འབྱོར་ཐོག་སྣེ་མགྲོན་མཁན་ཆུང་ཐུབ་བསྟན་ལེགས་སྨོན་ཞོལ་པར་ཁང་དུ་བསྐོར་གཡེང་བྱེད་པར་བཏང་བས་ཨར་པོའི་ལས་བྱ་དང་།",
    "ཨར་པོ་ལམ་ཙམ་ཟིན་མཚམས་ང་རང་ནས་རྡོ་ཤིང་།",
    "ཞོལ་གཉེར་ཤོད་དྲུང་གཉིས་ཀྱི་ཐོག་ཤོད་སྐོར་ནས་ལས་འཕར་གཅིག་ཀྱང་བསྐོ་སྲོལ་འདུག་ཞོལ་པའི་དྲུང་ཡིས་རྩ་འབོར་མི་གྲངས་ཉི་ཤུ་ཙམ་ཡོད་ཁོངས་ནས་རྒན་གྲས་གསུ་མ་ལ་གཉེར་ཆུང་རྒན་པ་དང་།",
    "དེ་མིན་གཉེར་ཆུང་ལས་འཕར་གཅིག་ཀྱང་བསྐོ་སྲོལ་འདུག་གཉེར་ཆུང་ཟེར་བར་དྲུང་གཏོགས་ཀྱི་གོ་ཐོབ་ཡོད་པ་དང་།",
    "ང་རང་ནས་རྟག་པར་གཡག་པར་ལྷམ་ཀྲད་སྤྲོད་རྐྱང་བྱེད་ཀྱི་ཡོད།",
    "དེ་སྐབས་ང་རང་ལ་གཡག་ལག་དྲུག་ཙམ་གྱི་ཚོང་ཟོག་འགེལ་རྒྱུ་ཡོད་ཅིང་།",
    "འང་ཐོག་མར་བྱས་ན་མ་རྩ་ཅན་ཚོར་བགོས་ན་འགྲིག་ལུགས་གསུངས་ཀྱི་འདུག་འོན་ཀྱང་ཚང་མ་མ་རྩ་ཅན་ཚོར་བགོས་ན་ལས་ཀ་བྱེད་མཁན་གཞན་ཚོས་སེམས་ཕམ་བྱེད་པའི་བསམ་འཆར་ཡོད་སྟབས་ངོས་ནས་ཆ་ཤས་ཤིག་ལས་སྐ།་",
    "འདོན་འདྲེན་གྱི་དུས་ཚོད་གཏན་འཁེལ་བཟོས་པ་ལྟར་ཅ་ལག་དུས་ཐོག་འདོན་མ་ཐུབ་ན་རྐུབ་བརྡིབས་པའི་གྱོང་རྒུན་འཁེལ་བའང་བྱུང་ཡོད།",
    "གལ་ཏེ་བེ་རི་ནས་ཕྱིར་འཐེན་བྱེད་དགོས་ན་བོད་ཕྱོགས་ལ་སྙན་སེང་དགོངས་སྐོར་ཞུ་དགོས་ལུགས་སོགས་བརྗོད་འདུག་ཅེས་འཁོད།",
    "ཆུང་ཤག་རྔ་པ་བཅས་ཀྱང་བོད་ཁོངས་ཡིན་གཤིས་བོད་ཀྱི་དོ་དམ་བྱ་རྒྱུར་ངེས་པར་ཕྱིར་སྤྲོད་བྱ་དགོས་ཞེས་འཁོད་འདུག་པར་བརྟེན་ངས་ལིའུ་ཝུན་ཧུའེ་ཡན་ཧོ་དང་།",
    "ཆུང་ཤག་རྔ་པ་བཅས་ལ་སྲུང་བྱར་དམག་མེ་བཏོང་རྩིས་ཡོད་ཅེས་འཁོད་འདུག་ཁམས་ཀྱི་གྱོད་དོན་རྣི་བེ་དར་རྩོད་གཞི་ནས་མཐར་ཁྲོན་བོད་དམག་འཁྲུག་ཅིག་ཏུ་གྱུར་ཞིང་།",
    "ག་རྒྱག་རྒྱུའི་གྲ་སྒྲིག་བྱེད་བཞིན་འདུག་ཅེས་འཁོད།",
    "མེ་མདའི་མདེའུ་སོགས་ལྷ་སར་དབོར་རྒྱུ་བྱས་འདུག་ཅེས་དང་།",
    "ཚིལ་ལུ་ཕྲན་བུ་ཚོང་རོགས་ཟེར་བ་མི་སེར་ནས་ཁས་ལེན་མི་བྱེད་ཐབས་མེད་ཁར་རིན་ཡང་ཞུ་རིན་ཆོག་པ་མི་འདུག་ཟེར་ནས་ལེན་ནུས་ཀྱི་མེད།",
    "ནང་དུ་སླེབས་མཚམས་ཡི་གེ་བསྒྲིལ་འབོག་སེར་ཐིག་དེ་ཁྲི་སྟེང་དུ་བཞག་ང་རང་གདན་དམའ་ཙམ་ཞིག་ལ་སྡོད་ཀྱི་ཡོད།",
    "དེ་དུས་སྒེར་དྲག་ཚོས་བུན་ལོན་སཏོང་སྐབས་ཐབས་ཤེས་འདི་འདྲ་ཞིག་སྤྱོད་ཀྱི་འདུག་པ་སྟེ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་མི་དམིགས་པ་མཛོདལས་པད་ཟླར་དྷཱི",
    "སྟན་བདེ་བ་ལ་འདུག་པའི་མདུན་དུ་མཎྜལ་གྱི་སྟེང་ཡི་གེ་ལྔ་བཅུ་པོ་ནས་དང་བསྲེས་ནས་ཐོད་པ་མཚན་ལྡན་དུ་བླུགས་ལ་བཀོད།",
    "དེ་ནས་རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རྒྱལ་བའི་ཞིང་ཁམས་སྦྱང་ཞིང་རང་ལ་བསྟིམ།",
    "གདམས་པ་ཙ་ན་པི་ཀ་ར་ཡིག་འབྲུ་དྲུག།",
    "བཞི་པ་མངོན་དུ་གྱུར་པའི་དུས་ཞེས་བྱ་སྟེརྟོག་པ་ཐམས་ཅད་རྩ་བྲལ་དུ་པ་། ཤེས་ཙ་ན་ཆེད་དུ་སྤྱན་ལྔས་བལྟ་མི་དགོས་སོ།",
    "བསྙེས་པརྒྱལ་པོ་རོལ་པའི་འདུག་སྟངས་སོ།",
    "འདི་ཡི་ངོ་སྤྲོད་རྗེས་དང་རང་ཁ་གཉིས།",
    "ཐུན་མཚམས་སུ་ཉལ་འདུག་ལངས་འགྲོའི་རྩ་བའི་སྤྱོད་ལམ་བཞི་ལ་ཡན་ལག་ལྔ་ལྔར་ཕྱེ་བའི་ཉི་ཤུ་དང་།",
    "ཧཱུྃ་ཞེས་བརྗོད་པསཁྱེད་རང་རྣམས་བདག་མེད་མར་གསལ་བའི་དཔྲལ་བར་འཁོར་ལོ་ལ་ཨོ་དཀར་པོམགྲིན་པར་པདྨ་ལ་ཨཱ",
    "ཨོཾ་བཛྲ་ཝཱ་ར་ཧཱི་ངག་བེ་རོ་ཙ་ནི་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་བཛྲ་ཝཱ་ར་ཧཱི་བེ་རོ་ཙ་ནཱི་ཧཱུྃ་ཕཊ་ཨ་བྷི",
    "ༀབཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཕཊ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "སླར་ཡང་རང་ཉིད་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྐུར་གྱུར།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱཞེས་ངག་བཟླས་དང་ཡིད་བཟླས་ཅི་རིགས་པར་བྱའོ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ལུས་དྲང་པོར་བསྲང་།",
    "ཨོཾ་ཨ་གྷོ་ར་མ་ཧཱ་ཀཱ་ལ་མ་ཧཱ་མཾ་ས་ཁཱ་ཧིམ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "ཁྱེད་རང་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་བསྲེགསམ་དག་པའི་སྣང་བ་ཐམས་ཅད་སྦྱངས།",
    "དེ་ནས་ཁྱེད་རང་གསང་བའི་བདག་པོ་ཕྱག་ན་རྡོ་རྗེ་ཆེ་བཙན་འགྲན་ཟླ་ཐམས་ཅད་དང་བྲལ་བའོ་སྙམ་དུ་ང་རྒྱལ་བསྐྱེད་ཅིག།",
    "ཉམས་སུ་བླང་རྒྱུ་ཅི་ཡང་མི་གདའཐ།",
    "སྒོམ་ཆེན་པ་ལ་ཁོ་རང་སྔར་གོམས་ཀྱི་ཐོག་ཏུ་འཇུན་དུ་བཅུག་ལ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཐམས་ཅད་དུ་རྩ་བའི་ཉམས་དྲན་པས་བཟུང་ཕཊ་ཅེས་དུམ་བུར་བཅུད་ཀྱིན་རྗེན་རྟེན་མེད་དུ་ཁྱེར་ལ་སྤྱོད་ལམ་བྱའོ།",
    "གཉིས་པ་ནིརྗེ་བཅུ་བདུན་དམ་པས་འཆི་བ་མི་རྟག་པ་བསམ་ཙ་ན་ཅི་ཡང་དགོས་པ་མི་གདའ།",
    "ཚེ་ཐར་དུ་ལུས་པ་ནི་སུ་ཡང་མི་འདུག་པས་ངེས་པར་འཆི།",
    "ཟིན་ཙ་ན་བཤིག་ལ་བོརདེ་ཉིད་ལ་རྩལ་སྦྱོངསགང་བྱུང་ཐོག་ཏུ་ཁུར།",
    "ཞེས་པསསེམས་ལ་རྣམ་རྟོག་གང་ཤར་ཡང་ངོ་བོ་ཅིར་འདུག་ཅེར་གྱིས་ལྟོསབལྟས་པས་རྣམ་རྟོག་སོགས་རགས་པ་རྣམས་སྣང་སྟོང་གྲག་སྟོང་དུ་འཆར།",
    "གསལ་རྡོ་ཙ་ན་ཤིགས་སེ་བཤིག་ལ་རང་སོར་བཞག་གོ།",
    "ཆུང་ངུས་ཉམས་དེ་ལ་ངོ་བོ་ཅི་འདུག་ཡང་ཡང་བལྟ་ཞིང་ཉམས་སུ་བླང་།",
    "ལྷག་པར་བློ་གདིང་ཐུབ་པ་ཅི་འདུག་བལྟགཞན་གྱི་ཡོན་ཏན་བསམ་ནས་མཉམ་པར་བཞག་གོ།",
    "ཕྱིས་ཡུལ་རྐྱེན་གྱིས་བསྐྱེད་པའི་རྟོག་པ་དེ་གཅིག་ཏུ་འདུག་གམ་ཐ་དད་དུ་འདུག་བརྟགས་པསདེ་གཉིས་པོ་སོ་སོ་མཛོདཐ་དད་དུ་མི་འདུག་སྟེ།",
    "ཕོ་སྒོ་ཚེ་འདིར་མི་འབྱིན་ཏེཚེ་འདིའི་ཆེ་ཐབས་ཐམས་ཅད་ནམ་བཞག་གཏན་གྱི་ཆུང་ཐབས་སུ་ངག་ལའདུག་པས།",
    "དེ་ཡང་རང་ས་སྟོན་པའི་རྒྱལ་པོ་དྲུག།",
    "བཞི་པ་དེ་ཐམས་ཅད་ཀྱང་རང་སེམས་ཀྱི་འཆར་ལུགས་ཙམ་དུ་ཤེས་པར་བྱའོ།",
    "བཞི་པ་དེ་ཐམས་ཅད་ཀྱང་རང་སེམས་སྐྱེ་མེད་ལ་བཟང་ངན་དང་གོ་རིམ་སྤངས་བླང་མེད་དེ་གཉིས་མེད་དུ་འཛིན་པ་ཙམ་དུའང་མི་བྱ་བར་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་རྒྱས་གདབ་བོ།",
    "དེ་ཡང་འདུག་པའི་སྤྱོད་ལམ་ལྔ་ནི།",
    "རྒྱལ་པོ་རོལ་པའི་འདུག་སྟངས་སོ།",
    "འགྲོ་ངག་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡནཞེས་པས།",
    "ལུས་ལ་ན་ཚ་བྱུང་ཙ་ན།",
    "གཅིག་པུར་ལྐོག་ཏུ་ཉལ་ཙ་ན།",
    "མང་པོའི་གསེབ་ཏུ་སྡོད་ཙ་ན།",
    "ཤེས་པ་ཡུལ་ཕྱིར་འབྲང་ཙ་ན།",
    "ཚེ་འདིའི་ཆེ་ཐབས་གང་ཡང་ནམ་ཞིག་གཏན་གྱི་ཆུང་ཐབས་སུ་འདུག་པས།",
    "རྒྱལ་པོ་རོལ་པའི་འདུག་སྟངས་སོ།",
    "གསུམ་པ་བྱ་བྲལ་འབྲས་བུའི་རྣལ་འབྱོར་ནིདེ་ཡང་རང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་སྐུ་བཞིའི་ཕྲིན་ལས་དང་མཛོདབཅས་པ་རབ་ཀྱིས་ཚེ་འདི་ཉིད་དུ།",
    "ཁྱེད་རང་རྣམས་ལུས་སེམས་ཁོང་སློད་ལ་རང་ལུས་ལྷ་སྐུར་སྣང་བ་དེ་ཡང་སྣང་ལ་རང་བཞིན་མེད་པ་སྒྱུ་མ་ལྟ་བུ།",
    "ཁྱེད་རང་རྣམས་ལུས་སེམས་ཁོང་སློད་ལ་མཚན་བཅས་ལྷ་སྐུའི་ཐིག་ལེ་སྣང་སྟོང་།",
    "ཨཱ་ལི་ཀཱ་ལི་གུ་ཧྱ་ཨ་ཙིནྟཱ་པ་ནི་མ་ཧཱ་ཏན་ཁཎཱ་ནཱ་མ།",
    "ཁ་ཅིག་དམ་བཅའི་ལྕགས་ཀྱུ་སྔ་ཕྱིའི་ཁྱད་པར་ཡོད་གསུངས་པའང་རང་ལྡོག་ཁྱད་པར་མེད་ན་དམ་བཅའ་སྔ་ཕྱི་ཙམ་གྱིས་ཐ་དད་དུ་བྱེད་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ལྟར་ཐབས་དང་ལྡན་པར་རྟོགས་པ་ཙམ་ཡང་མ་ཡིན་ཏེ།",
    "ཇི་སྙེད་པ་མཁྱེན་པའི་ཡེ་ཤེས་ཤེས་བྱ་ཇི་སྙེད་པ་ལ་འཕྲོ་བ་དང་དེ་གཉིས་ཀ་སྤང་བྱ་ལས་རྣམ་པར་གྲོལ་བ་སྒྲིབ་པས་དག་པའི་ཕྱིར་དང་དེ་གསུམ་ཀ་ཡང་རང་བཞིན་ཐ་དད་མེད་པའི་ཕྱིར་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་འོད་གསལ་དང་གཞན་གསལ་བར་བྱེད་པའི་ཟེར་སྤྲོ་བ་དང་།",
    "སེམས་སྒྲིབ་པ་དང་རང་བཞིན་གྱིས་བྲལ་བ་ནི་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་གདོད་མ་ནས་གྲུབ་པའི་ཕྱིར་རོ།",
    "སེམས་ཀྱི་སྒྲིབ་པའི་ཉེས་པ་དེ་དག་ཡང་དག་པའི་བདག་མེད་པའི་ཞེས་པ་སེམས་དྲི་མ་དང་རང་བཞིན་གྱིས་བྲལ་བའི་ཕྱིར་རོ།",
    "འོང་མིན་འགྲོ་བ་མ་ཡིན་ཞིང་།",
    "དྲི་མ་དང་བཅས་པའི་དེ་བཞིན་ཉིད་དང་རང་བཞིན་ཐ་དད་མེད་ཀྱང་དྲི་མ་དང་བྲལ་བས་ཁྱད་པར་དུ་བྱས་པའོ།",
    "སྡོམ་ལ་ངོ་བོ་དག་པ་འཐོབ་པའི་རྒྱུ་དང་རྒྱུ་དེའི་བྲལ་བའི་འབྲས་བུ་དང་རང་གཞན་གྱི་དོན་བྱེད་པའི་ལས་དང་ཡོན་ཏན་གྱི་རྟེན་བྱེད་པའི་ལྡན་པ་དང་།",
    "རང་ཉིད་ཀྱི་སྲིད་པའི་སྡུག་བསྔལ་ཉེ་བར་ཞི་བར་བྱེད་པའི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ལམ་ལ་རབ་ཏུ་ཞུགས་པ་རྣམས་སོ།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧ་ཱུྃ་ཧ་ཱུྃ་ཧ་ཱུྃ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་ཀྱིས་བསྐོར་བ་ལས་འོད་ཟེར་བྱུང་བས་ལུས་ཕྱི་ནང་ཐམས་ཅད་གང་སྟེ་ལུས་ངག་ཡིད་གསུམ་གྱི་སྡིག་སྒྲིབ་ཐམས་ཅད་དག་པས་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧ་ཱུྃ་ཧ་ཱུྃ་ཧ་ཱུྃ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "ཙ་ནཱི་ཡེ་རྣམས་རིམ་པ་བཞིན་གཡོན་ནས་བསྐོར་བ་ཡིན་གྱི།",
    "རང་ཉིད་ཁ་ཤར་དུ་བལྟས་ནས་འདུག་པའི་མདུན་དུ་ནང་མཆོད།",
    "བདག་དུས་ཐམས་ཅད་དང་རྣམ་པ་ཐམས་ཅད་དང་།",
    "ཡང་སློབ་དཔོན་ལྷོར་འདུག་ལ་ཁ་བྱང་དུ་བལྟས་ཏེ།",
    "ཡང་དེའི་མཚམས་སུ་འདུག་སྟེ་ནུབ་ཏུ་བལྟས་ལ་ལྷོ་ཕྱོགས་ཀྱི་ཐིག་གདབ་བོ།",
    "དེ་ནས་དབུས་སུ་འདུག་ནས་ནི།",
    "ཡང་རང་ལ་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་འདུག་ལ།",
    "དེ་ནས་ཡང་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་འདུག་ལ།",
    "སྔ་མ་བཞིན་དུ་པདྨ་དང་ཟླ་བའི་སྟེང་དུ་ཕྱག་རྒྱ་ཆེན་པོ་བཅངས་ཏེ་འདུག་པར་བྱའོ།",
    "རྡོ་རྗེ་རིན་ཆེན་དམ་ཚིག་པར་གསལ་བར་སྔར་ལྟར་འདུག་པར་བྱའོ།",
    "ཐབ་མདུན་དུ་སྔར་ལྟར་འདུག་པར་བྱའོ།",
    "བཟང་བོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པ།",
    "ཙོག་པུའི་སྟབས་ཀྱིས་བ་སྒྲུབ་བྱའི་གཟུགས་བརྙན་ལ་འདུག་པར་བྱའོ།",
    "ཙོག་པུའི་འདུག་སྟངས་ཀྱིས་བསྒྲུབ་བྱའི་གཟུགས་བརྙན་ལ་སོགས་པ་ལ་འདུག་སྟེ།",
