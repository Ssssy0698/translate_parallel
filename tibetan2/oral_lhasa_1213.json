    "ཡང་ན་རྡོ་རྗེ་འཆང་ཡབ་ཡུམ་ཅན་གྱི་རྣམ་པར་གསལ་བཏབ།",
    "རྡོ་རྗེའི་བཟླས་པར་བསླབ་པའོ།",
    "དེ་ལ་སེམས་རྩེ་གཅིག་ཏུ་གཏད་གསལ་སྣང་ཐོབ་པར་བྱ།",
    "དེ་ནས་མགྲིན་པའི་འཁོར་ལོ་རྩ་འདབ་སོ་གཉིས་པའི་ལྟེ་བར་ཐིག་ལེ་ཁ་དོག་དམར་པོ་འོད་ཟེར་འཕྲོ་བ་ཞིག་བསྒོམས་ལ་གསལ་སྣང་ཐོབ་པར་བྱ།",
    "མགྲིན་པར་དམར་པོ་བསྒོམ་ན་འདིར་དཀར་པོ་བསྒོམས་ལ་གསལ་སྣང་ཐོབ་པར་བྱའོ།",
    "དེའི་ལྟེ་བར་ཐིག་ལེ་སེར་པོ་འོད་ཟེར་ལྔ་འཕྲོ་བ་ཞིག་བསྒོམས་ལ་གསལ་སྣང་ཐོབ་པར་བྱ།",
    "དེ་ནས་གསང་གནས་ཀྱི་འཁོར་ལོ་རྩ་འདབ་བཅུ་དྲུག་པའི་ལྟེ་བར་ཐིག་ལེ་སྔོན་པོ་འོད་ཟེར་འཕྲོ་བ་ཞིག་བསྒོམས་ལ་གསལ་སྣང་ཐོབ་པར་བྱ།",
    "དང་པོར་འོད་ཀྱི་སྣང་བར་བྱས་ཤིང་།",
    "བར་དུ་རྩ་རྣམས་དྭངས་པར་༢༤",
    "དངུལ་ཆུ་བྲེ་གང་ཙམ་གྱི་ཚོད་ཀྱི་ཐིག་ལེ་གཉིས་གཡས་གཡོན་དུ་ཡོད་པར་བསམས་ལ་དེ་ལ་སེམས་འཛིན།",
    "འོད་ཟེར་རྣམས་ཉི་མའི་བུ་ག་ནས་འཐོན་ཏེ་ལུས་ཐམས་ཅད་ཁྱབ་པར་བསམ།",
    "དར་ཅིག་སེམས་མ་བཅོས་པར་ངལ་གསོ།",
    "འདི་ཐམས་ཅད་བདེན་པར་གྲུབ་པ་གཅིག་ཀྱང་མེད་པ་སྒྱུ་མ་ལྟ་བུ་ཡིན་སྙམ་པའི་འདུན་པ་དྲག་ཏུ་སྦྱང་།",
    "ངོས་བཟུང་དང་བྲལ་བ་དེའི་ངང་ཅུང་ཟད་ཅིག་བསྐྱངས་ཏེ་མཉམ་པར་བཞག།",
    "ངོས་བཟུང་ཐམས་ཅད་དང་བྲལ་བའི་ངང་ལ་མཉམ་པར་བཞག་ལ།",
    "དེ་ལྟར་ཞག་བཅོ་ལྔ་ཙམ་རང་ཉིད་ལྷ་སྐུར་བསྒོམ་ཞིང་།",
    "ཡང་ཞག་བདུན་ཙམ་བོགས་འདོན་གཉིས་པོ་གང་རུང་ཞིག་བསྒོམ་བོགས་ཐོན་པར་བྱ།",
    "ཚུལ་དེ་ལྟ་བུས་ལྷ་སྐུ་ལ་ཡང་གསལ་སྣང་ཁྱད་པར་ཅན་ཐོབ་ཅིང་།",
    "འདུན་པ་ལ་མ་ལྟོས་པར་སྣང་བ་སྒྱུ་མ་ལྟ་བུ་ཅུང་ཟད་ཤར་བ་ན།",
    "སྣང་བ་དེ་རྣམས་རིམ་གྱིས་ནུབ་པ་ལ་མངོན་དུ་ཕྱོགས་པར་སྣང་ཞིང་།",
    "དག་པ་ལྷ་སྐུའི་སྣང་བ་སྒྱུ་མ་ལྟ་བུར་ངོས་འཛིན་པ་གཉིས་ལས།",
    "བཟུང་དང་བྲལ་བའི་ངང་ལ་མཉམ་པར་བཞག།",
    "དེ་ལ་ཡང་བདེན་པར་མ་གྲུབ་ཀྱང་།",
    "སྔ་དྲོ་ནས་བཟུང་ཉིན་ཕྱེད་ཀྱི་བར་དུ་དོ་ནུབ་ཅི་ནས་ཀྱང་རྨི་ལམ་ཟིན་པར་བྱ་སྙམ་པའི་འདུན་པ་རྒྱུན་མི་འཆད་དུ་བཏང་།",
    "དོ་ནུབ་ཅིས་ཀྱང་རྨི་ལམ་ལ་རྨི་ལམ་དུ་ངོ་ཤེས་པར་བྱ་སྙམ་པའི་འདུན་པ་བཏང་ཞིང་།",
    "བཞི་པོ་དེ་རྣམས་ལ་བརྟེན་ནས་རྨི་ལམ་བལྟར་ཆགས་སུ་ཟིན་པར་གྱུར་ན།",
    "རང་ཉིད་ཀྱང་འོད་གསལ་སྟོང་པ་ཉིད་ཀྱི་རང་ངང་དུ་ཐིམ་པར་བསམ་པ་ནི་རྩ་བའི་དམིགས་པ་གསུམ་པའོ།",
    "མི་གཙང་བའི་ཁྲོད་དམ།",
    "དེ་ལ་བདག་དོ་ནུབ་ཏུ་རྨི་ལམ་དུ་བདེ་བ་ཅན་དུ་སླེབ་པར་མཛད་དུ་གསོལ།",
    "དེའི་ལན་ཇི་ལྟ་བ་བཞིན་གསུངས་པའི་དམིགས་པ་ཉིན་པར་བསྒོམས་པས།",
    "དེ་ཡང་ཇེ་ཕྲར་གྱུར་ཏེ་སྟོང་པར་ཡལ་བར་བསམ་ལ་ཅུང་ཟད་མཉམ་པར་བཞག།",
    "དེ་ནས་རྣམ་རྟོག་གཞན་གྱིས་བར་མ་ཆོད་པར་སྣང་བ་འདི་རྣམས་ལ་ཤེས་པ་གཏད་དེ།",
    "དེ་ཡང་ཇེ་ཕྲར་གྱུར་ཏེ་སྟོང་པར་ཡལ་བའི་ངང་ལ་ཅུང་ཟད་མཉམ་པར་བཞག།",
    "དེ་ཀའི་ངང་ལ་རྟོག་པ་གཞན་གྱིས་བར་མ་ཆོད་པར་སྣོད་བཅུད་ཐམས་ཅད་ལ་ཤེས་པ་གཏད་དེ།",
    "མཁའ་འགྲོ་མའི་རིགས་བསྒོམ་ན་ལྷག་པར་བསྔགས་པ་དང་།",
    "ཡི་གེ་རྣམས་ལས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་སྒོ་རྣམས་བཀག་པར་བསམ།",
    "ཞབས་ཀྱུ་གཉིས་མཉམ་པར་གཞིབས་པ་ལ།",
    "ཀ་ཧི་ཞེས་པ་ཡིད་ཀྱིས་དྲན་པར་བྱ།",
    "རང་ལུས་ཀྱང་སྟོང་པར་ཐིམ་པར་བསམ།",
    "བཅུད་ཐམས་ཅད་ལྷར་གྱུར་པར་བསམ།",
    "དེ་བརྗིད་དང་ལྡན་པར་གྱུར་ཅིང་།",
    "ཤར་གྱི་པད་འདབ་སྟོང་སང་ངེ་གྱུར་པར་བསམས་ལ།",
    "དེ་ལ་སེམས་གཏད་པས་འོད་གསལ་ཟིན་པར་འགྱུར་རོ།",
    "ཡང་ལས་ཀྱི་ཕྱག་རྒྱ་དང་མཉམ་པར་སྦྱོར་བའི་རྗེས་ཆགས་ཀྱི་བདེ་བ་ལ་གོམས་པ་ཞིག་ཡིན་ནོ།",
    "དམིགས་པ་གང་རུང་ཞིག་ལ་བརྟེན་ནས་འོད་གསལ་ཟིན་པར་བྱས་པས་ཆོག་པ་ཡིན་ནོ།",
    "སྣོད་བཅུད་ཐམས་ཅད་འོད་ཟེར་དཀར་པོའི་རྣམ་པར་གྱུར།",
    "ཉིན་པར་གཉིད་དུ་འགྲོ་ཁ་དང་།",
    "སྣོད་བཅུད་ཐམས་ཅད་འོད་ཟེར་དམར་པོའི་རྣམ་པར་གྱུར།",
    "པད་འདབ་དམར་པོ་ཡི་གེ་དང་བཅས་པ་པད་འདབ་ནང་མ་ལ་ཐིམ་པར་བསམ་ཞིང་། ༢༥༩",
    "སྣོད་བཅུད་ཐམས་ཅད་འོད་ཟེར་སྔོན་པོའི་རྣམ་པར་གྱུར།",
    "ཉིན་པར་དང་གཉིད་དུ་འགྲོ་ཁ་དང་།",
    "པད་འདབ་སྔོན་པོ་ཐིག་ལེ་དང་བཅས་པ་ལྟེ་བའི་ཨ་ཤད་ལ་ཐིམ་པར་བསམ་ཞིང་།",
    "སྣང་མཆེད་ཐོབ་པའི་འོད་གསལ་གྱི་ཡེ་ཤེས་རྣམས་སྒྲུབ་པར་བྱེད་པའོ།",
    "དེའི་འོད་ཟེར་དམར་པོས་ལུས་ཐམས་ཅད་དམར་ལམ་སྟེ་ཁྱབ་པར་བསམ།",
    "བློ་ངོར་སྣང་བ་ཐམས་ཅད་དབྱིངས་སུ་ནུབ་པའི་ངང་ལ་ཅུང་ཟད་མཉམ་པར་བཞག་གོ།",
    "པའི་སྟོང་པའི་ངང་ལ་མཉམ་པར་འཇོག་པ་དང་།",
    "སླར་ཡང་ཡི་དམ་གྱི་སྐུ་ཐིག་ལེ་ས་བོན་དང་བཅས་པ་གྲུབ་པར་བསམ།",
    "སྣོད་བཅུད་ཐམས་ཅད་ལྷ་སྐུར་གྱུར།",
    "རང་གཞན་ཐམས་ཅད་ལྷ་སྐུར་བསྒོམ་ཞིང་།",
    "སྟོང་པར་༢༦༣",
    "བཅུད་ཐམས་ཅད་ལྷ་སྐུར་བསྒོམ།",
    "མགྲིན་པར་འོད་དཔག་མེད་ཡབ་ཡུམ།",
