    "དེའང་སྣང་བ་རང་སེམས་ཡིན་པའི་གོ་བ་ཡུ་ལེ་བ་དེ་འདྲ་མ་ཡིན་པ་སྣང་བ་སེམས་སུ་ཇི་ལྟ་བར་ངོ་འཕྲོད་ཙ་ན།",
    "ཡ་སཾས་ལ་མ་༣་ པ་བྷཙ་ན་ཝཱ་ན་མ་ཡ་སིལ་མ་ཨཱ་༧ རྣམ་ར་ས་༤༧ ནས་བ་ས་བ་ཡིན་རྣམ་གྲོལ་སྐྱེས་བུ་གྲོགས་མཛད་པ།",
    "དེ་ནས་ཀ་བཞིར་ཕེབས་ནས་སྐུ་ཞབས་སྐལ་ནོར་ལགས་ནས་ཕེབས་སྒྲིག་གཟབ་རྒྱས་གནང་འདུག་པ་དེར་ཟླ་བ་གཅིག་ཙམ་བཞུགས་ནས་སྐུ་ཞབས་སྐལ་ནོར་ལགས་ཀྱིས་བྱུས་བཀོད་གནང་སྟེ་ཕ་མ་གཉིས་དང་།",
    "དཀར་འཛོམས་ཨ་ཤམ་ཀྱི་ཞིང་ག་བཅས་བྲིས་པར་ཡུལ་ལྗོངས་འདི་ཇི་ཡིན་བཀའ་འདྲི་གནང་སྐབས་འདི་འབྲས་ལྗོངས་ཡིན་ང་རང་དེ་སྔོན་འབྲས་ལྗོངས་ལ་འགྲོ་མྱོང་བས་ལུང་པ་སྐྱིད་པོ་ཞེ་དྲག་ཡོད་བྱས་ཙང་ངས་འདིར་འབྲི་འདོད་བྱུང་བ་ལྟར་བྲིས་པ་ཡིན་ཞེས་ཞུས་འདུག་ཅིང་།",
    "རང་འགྲོ་འདུག་བསམ་ཚེ་གཏད་སོ་མེད།",
    "ཅེས་བཀའ་རྩོམ་གནང་འདུག་ཅིང་།",
    "བདག་འགྲོ་འདུག་འཕོ་འགྱུར་སྣ་ཚོགས་དང་།",
    "སྐྱེད་མ་གཉིས་ལ་ད་ཆ་ན་ཚ་རྩ་བ་ནས་མི་འདུག་གྲོད་པ་སྐྲངས་པ་འདི་ཞོམ་ན་གཞན་སྐྱོན་མི་འདུག་ཀྱང་།",
    "བདུད་ཀྱིས་བསླུས་འདུག།",
    "ཟས་ནོར་གོས་གྲོགས་འཁོར་གཡོག་སོགས་ཀྱིས་ཀྱང་རང་འཆི་བའི་རྐྱེན་ཇི་ལྟར་བྱེད་མི་ཤེས།",
    "གཞན་དག་སོས་དལ་དུ་འདུག་པ་དང་།",
    "དེ་རྣམས་ནི་ཇི་ཙམ་འཛོམ་ཡང་རང་འཆི་བའི་ཚེ་ན་ཕན་པ་ཏིལ་འབྲུ་ཙམ་ཡང་མེད།",
    "གླེན་ཅིང་མི་ཤེས་པ་ཆེན་པོ་ཡིན་འདུག་ཀྱང་དེ་སྔ་ཉེས་དམིགས་སྣ་གཅིག་ཀྱང་མ་དྲན་པ་འདི་ལ་མི་ཉན་མ་བྱེད་ཟེར་བ་ཞིག་ཀྱང་མ་བྱུང་།",
    "འདུག་མི་ཚུགས།",
    "དེ་ཙ་ན་བཤགས་པ་ཚད་ལྡན་ཞིག་འོང་།",
    "དེ་ཙ་ན་བཀའ་བསྟན་བཅོས་དབྱིངས་ཆེན་མཇལ་ཡང་གོ་དོན་སེམས་དང་འཕྲོད་པའི་བོག་ཆེན་འོང་།",
    "དཔེ་ཟབ་དགུ་མཇལ་ཡང་རང་རྒྱུད་ལ་སྣེ་གཅིག་ཀྱང་མ་ཕན་པར་གཤིས་ཀ་ཇེ་གྱོང་།",
    "སོ་སོའི་ས་ན་རང་རང་ལ་བདེན་པ་ཡོད་པས་གང་ལའང་གཤེ་མི་རུང་།",
    "རྗེས་ཐོབ་ཐུན་མཚམས་སུ་ཡང་རང་ངོ་ཤེས་ཙམ་གྱི་དྲན་རྫི་བསྟེན་ནས་མ་ཡེངས་པར་བསྐྱང་།",
    "རྣམ་རྟོག་འཕྲོ་རྒོད་ཀྱི་འགྱུ་བ་དེ་གཉིས་ཐ་དད་དུ་བཟུང་སྟེ་གནས་འདུག།",
    "འགྱུ་འདུག་བསམ་ནས་ངོ་བལྟ་བྱེད་པ་མ་གཏོགས་རང་ངོ་ལྟ་བ་ངོ་མ་ནི་མི་ཤེས་པའི་གནས་འགྱུ་ཤེས་ཟེར་བ་ཡིན།",
    "དེ་ཡང་མི་ཤེས་ན་གནས་འདུག།",
    "ཉམས་ཀྱི་མྱོང་བ་ཙམ་ལས་རྟོག་པའི་རང་ངོ་མཐོང་བ་དངོས་ནི་མིན་འདུག།",
    "འདི་སྐབས་བལྟ་བྱ་ལྟ་བྱེད་གཉིས་སུ་མེད་པར་ངེས་ཤེས་སྐྱེས་ནས་མ་བཅོས་པར་ཞོག་གསུངས་པ་དེ་འདི་ཡིན་པར་འདུག་སྙམ་པའང་འབྱུང་།",
    "སླེབ་ཀྱང་མགོ་ནོན་དཀའ་བར་འོང་བས་བརྟན་པ་ཤིན་ཏུ་ཐོབ་ན་མ་གཏོགས་རྣམ་གཡེངས་སྤང་ནས་རྩེ་གཅིག་ཏུ་བསྒོམ་ནུས་པ་ཞིག་གལ་ཅི་ནས་ཆེ་བར་གདའ།",
    "རང་རང་ནི་བདུད་ཀྱིས་བྱིན་གྱིས་རླབས།",
    "རོ་ཉལ་སོགས་ལ་ཞེ་ཟོན་དགོས་འདུག།",
    "རང་ངོ་མ་ཤེས་ན་མི་རྟོག་པའང་ལུང་མ་བསྟན་ཁོ་ན་ཡིན་འདུག།",
    "དེ་རྣམས་ཀྱིས་ང་རྒྱལ་སྐྱེ་བའི་རྐྱེན་བྱེད་པར་འདུག།",
    "སེམས་གནས་འགྱུ་དགའ་སྡུག་སོགས་གང་ལྟར་སྣང་ཡང་རང་བབས་གཉུག་མའི་རང་འགྲོས་སྐྱོང་བ་ལས་དགག་བསྒྲུབ་བཅོས་བསྒྱུར་གང་ཡང་མེད་པའི་ངོས་ཁ་ཏོན་བཟླས་བརྗོད།",
    "འགྲོ་འཆག་ཉལ་འདུག་སོགས་བྱེད་པ་ལ་སྤྱོད་པ་ཤུགས་འབྱུང་ཞེས་གྲགས།",
    "བདག་ལ་རང་བཞིན་མེད་པར་རྟོགས་པ་ན་དེའི་ཡན་ལག་ཏུ་གྱུར་པའི་ཕུང་པོ་རྣམས་ལའང་རང་བཞིན་ཡོད་པར་འཛིན་པ་ལྡོག་པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "ཕུང་པོའང་རང་བཞིན་མེད་པར་རྟོགས་པར་གསུངས་སོ།",
    "རྒྱུན་ཡང་རང་བཞིན་མེད་པར་འདོད་ན།",
    "གང་ཟག་འདི་མི་འདུག་སྙམ་དུ་ངེས་པ་ལ་མེད་རྒྱུའི་གང་ཟག་དེ་ཤེས་དགོས་པ་ལྟར།",
    "བདག་མེད་པ་དང་རང་བཞིན་མེད་པ་ཞེས་པའི་དོན་ངེས་པ་ལའང་མེད་རྒྱུའི་བདག་དང་རང་བཞིན་དེ་ལེགས་པར་ངོས་ཟིན་དགོས་ཏེ་དགག་པར་བྱ་བའི་སྤྱི་ལེགས་པར་མ་ཤར་ན་དེ་བཀག་པའང་ཕྱིན་ཅི་མ་ལོག་པར་མི་ངེས་པའི་ཕྱིར་ཏེ།",
    "རང་བཞིན་བཟློག་པར་མི་ནུས་སོ་ ཞེས་ཚིག་ལ་རང་བཞིན་མེད་ན་རང་བཞིན་འགོག་པ་དང་རང་བཞིན་མེད་པ་བསྒྲུབ་པར་མི་ནུས་སོ།",
    "རང་བཞིན་གྱིས་མི་སྟོང་པ་ལ་འབྱུང་འཇིག་སོགས་འཁོར་འདས་ཀྱི་རྣམ་གཞག་ཐམས་ཅད་མི་རུང་བའི་ཚུལ་དང་རང་བཞིན་གྱིས་སྟོང་པ་ལ་དེ་དག་ཐམས་ཅད་རུང་བའི་ཚུལ་རྒྱས་པར་གཏན་ལ་ཕབ་པས་ན།",
    "དེ་ནས་དཔྱོད་མཁན་ལའང་དེ་ལྟར་དཔྱད་པ་ན་དཔྱོད་མཁན་ཡང་མི་འདུག་གོ་སྙམ་དུ་ངེས་པར་འགྱུར་རོ།",
    "རྩ་བར་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་ཕྱོགས་ལ་དེ་དག་རུང་བ་དང་མི་སྟོང་པའི་ཕྱོགས་ལ་མི་རུང་བར་ལེགས་པར་ཕྱེ་ནས་གསུངས་པའི་ཕྱིར་དང་།",
    "ཅི་སྟེ་རང་བཞིན་མེད་པ་རྣམས་ལ་བྱ་བ་བྱེད་པ་མི་འཐད་པའི་ཕྱིར་ཉེས་པ་སོ་ན་འདུག་པ་ཉིད་དོ་སྙམ་ན།",
    "དེའི་ལན་དུ་རྒྱུས་འབྲས་བུ་བསྐྱེད་པ་སོགས་ཀྱི་བྱ་བྱེད་རྣམས་རང་བཞིན་ཡོད་པ་ལ་མི་རུང་བ་དང་རང་བཞིན་མེད་པ་ཁོ་ན་ལ་དེ་དག་རུང་བར་གསུངས་སོ།",
    "དེ་ལྟར་ཡེ་མེད་པ་དང་རང་བཞིན་མེད་པ་དང་།",
    "རིགས་པ་ནི་རང་བཞིན་ཡོད་མེད་འཚོལ་བ་ཡིན་པས་དེས་བཀག་པའང་རང་བཞིན་བཀག་ཅེས་པའི་དོན་ཡིན་པས་འདི་གཉིས་ཕྱེད་པར་བྱའོ།",
    "རྒོལ་ཕྱི་རྒོལ་གྱི་རྒྱུད་ཀྱི་མ་དཔྱད་པའི་བློའི་འཇུག་ཚུལ་ལ་ཇི་ལྟར་འདུག་བལྟས་པས་ཆོག་པ་ཡིན་ནོ།",
    "འདི་དག་ཀྱང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དང་མ་སྐྱེས་པ་གཉིས་ཀྱི་ཁྱད་མ་ཕྱེད་པས་ནོངས་སོ།",
    "རང་བཞིན་གྱིས་མ་སྐྱེས་ཞེས་བརྗོད་པའི་རང་བཞིན་ཞེས་པ་དེ་མ་ཐོས་པར་མ་སྐྱེས་པར་བཟུང་འདུག་པ་ལ་དགོངས་ནས་རྣ་བ་མེད་པ་དང་།",
    "རང་བཞིན་མེད་པ་དེ་འདུག་གོ་ཞེའམ་མི་འདུག་གོ་སྙམ་པ་གཉིས་གང་དུའང་མི་འཛིན་པ་ནི།",
    "ཞེས་པའི་སྟོང་པ་ཉིད་དུ་ལྟ་བ་ཞེས་པའང་རང་བཞིན་གྱིས་སྟོང་ངོ་སྙམ་དུ་ལྟ་བ་ལ་མི་ཟེར་གྱི།",
    "འདི་ལ་ནོར་མི་འདུག་གོ་སྙམ་དུ་འཛིན་པ་སྐྱོན་མ་ཡིན་གྱི།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པ་ལ་དངོས་པོ་རྣམས་རང་བཞིན་མེད་པའོ་ཞེས་གོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལ་རང་བཞིན་ཡོད་པ་མ་ཡིན་ན་ཚིག་མེད་པའང་ཚིག་མ་གཏོགས་པར་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་པར་རབ་ཏུ་གྲུབ་པ་ཡིན་ན།",
    "ཞེས་བརྫུན་པ་སྒྱུ་མ་ལྟ་བུའི་སྐྱེ་བ་མི་འགོག་པ་དང་བདེན་པའི་སྐྱེ་བ་འགོག་པས་བརྟེན་ནས་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་གཉིས་མི་འགལ་བར་གསུངས་ཏེ།",
    "ཅེས་བརྟེན་ནས་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་འགལ་བར་བརྩད་པའི་ལན་དུ་གསུངས་སོ།",
    "དོན་དམ་པ་དང་ཐ་སྙད་པ་གང་ལས་བརྩམས་པའི་ཁས་ལེན་ནི་ཐ་སྙད་དུ་ཡང་རང་ལུགས་ལ་མེད་དེ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པའི་དམ་བཅའ་ཡོད་ན་རང་རྒྱུད་པར་འགྱུར་རོ་ཞེས་པའི་དོགས་པ་སྐྱེ་བ་ནི་ཤིན་ཏུ་བདེན་པ་ཞིག་སྟེ།",
    "ཞེས་གསུངས་པའང་རང་ལུགས་མེད་པའི་ཁུངས་མ་ཡིན་ཏེ།",
    "དངོས་པོ་རྣམས་ལོག་པར་ཀུན་བརྟགས་པས་བསྐྱེད་པ་ཉིད་ཀྱིས་སྒྱུ་མ་ལྟར་མ་སྐྱེས་པའི་རང་བཞིན་ཡིན་ཞིང་རང་བཞིན་མེད་ཀྱང་།",
    "ཚོར་བ་དེ་ཡང་རང་བཞིན་གྱིས།",
    "དེ་ལ་དངོས་པོ་སྟོབས་ཞུགས་ཀྱི་རྟགས་ཀྱི་ཐ་སྙད་མི་སྦྱོར་དུ་ཆུག་ཀྱང་རང་རྒྱུད་ཀྱི་རྟགས་ཡིན་པ་བཟློག་ཏུ་མེད་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་ཡོད་པར་སྨྲ་བ་ཞེས་པ་ནི་དངོས་པོར་སྨྲ་བ་དང་རང་རྒྱུད་པ་གཉིས་ཀ་ལ་གོ་བར་བྱའོ།",
    "རང་བཞིན་གྱིས་སྟོང་པར་སྨྲ་བ་དང་རང་བཞིན་གྱིས་མི་སྟོང་པར་སྨྲ་བ་གཉིས་ཀྱི་ལུགས་ལ་མ་འཁྲུལ་བའི་ཤེས་པས་གྲུབ་པའང་མ་ཡིན།",
    "ཁྱེད་རང་ཡང་འདོད་པ་དེ་བཞིན་དུ།",
    "མིག་ལ་བལྟ་བའི་རང་བཞིན་ཁས་ལེན་ནའང་རང་ལ་མི་བལྟ་ན་གཞན་ལ་ཡང་མི་བལྟ་བར་འདོད་དགོས་པས་སྐྱོན་སྔ་མ་མི་གཡོའོ།",
    "དེ་ཡང་རང་ཉིད་ལ་གྲུབ་པའི་གཏན་ཚིགས་ཉིད་ཀྱིས་ཡིན་གྱི།",
    "ཤིང་རྟ་ནི་ཡན་ལག་དེ་དག་དང་རང་བཞིན་གཅིག་མ་ཡིན་ཏེ།",
    "རང་བཞིན་ཡོད་ན་ཚོགས་པ་ཅན་ཡན་ལག་རྣམས་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་རུང་ལས་མི་འདའ་ལ།",
    "བདག་ཕུང་པོ་རྣམས་དང་རང་བཞིན་གཅིག་ཏུ་གྲུབ་ན་གང་ཟག་གཅིག་ལ་ཡང་ཕུང་པོ་དུ་མ་ཡོད་པ་བཞིན་དུ་བདག་ཀྱང་མང་པོ་ཡོད་པར་འགྱུར་ལ།",
    "དེ་དག་ལ་གནོད་པ་མཐོང་བའི་ཚེ་གང་ཟག་ལ་སོགས་པ་ནི་ཡེ་མི་འདུག་གོ་སྙམ་པ་དང་།",
    "མྱུ་གུ་ལ་རང་བཞིན་མེད་པ་དེར་བདེན་སྙམ་པ་དང་རང་བཞིན་གྱིས་སྟོང་པའི་སྣང་བ་སྒྱུ་མ་ལྟ་བུར་བདེན་སྙམ་ན་རིགས་པས་དགག་དགོས་པའི་འཛིན་པ་སྐྱོན་ཅན་ཡིན་གྱི།",
    "གཞན་ཡང་ཡུལ་དཔྱད་དེ་རིགས་པས་གསིལ་བ་ན་མི་འདུག་སྙམ་པ་དང་པོར་འབྱུང་ཞིང་།",
    "དཔེ་དེ་དག་ཀྱང་རང་བཞིན་མེད་པར་རྟགས་ལ་བརྟེན་ནས་རྟོགས་དགོས་ན།",
    "དེ་ཡང་རང་རྒྱུད་ལ་ཡོད་པར་མྱོང་བས་འགྲུབ་བོ།",
    "དེ་ལྟ་ཡིན་ནའང་རང་བཞིན་མེད་པའི་དཔེར་རུང་ལུགས་ནི།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "དེ་ལྟར་ན་བདག་ལྟ་བུ་གཅིག་ལ་ཇི་ལྟར་དཔྱད་པས་རང་བཞིན་གྱིས་སྟོང་པ་དང་རང་བཞིན་མེད་པ་ལ་བྱ་བྱེད་འཐད་པའི་བདེན་གཉིས་ཀྱི་འཇོག་ཚུལ་ཤེས་ན།",
    "བདག་སྐྱེ་དང་རང་བཞིན་ཐ་དད་པའི་སྐྱེ་བ་ནི་གཞན་སྐྱེ་ཡིན་པས།",
    "དངོས་པོ་མེད་པ་ལ་ཡང་རང་བཞིན་མེད་པར་ངེས་པ་རྙེད་པར་སླ་བས།",
    "ཁྱེད་རང་དེ་ངེས་དོན་གྱི་ལྟ་བར་འདོད་པའི་ཕྱིར་རོ།",
    "སྒྲོན་མེ་བཏེག་ནས་དེར་འདུག་མི་འདུག་ལེགས་པར་རྩད་བཅད་ནས་འཇིགས་པ་དེ་མི་སེལ་བར།",
    "གཡུལ་འགྱེད་པའི་ཚེ་མིག་ཕྱེ་ནས་དགྲ་གང་ན་འདུག་ལེགས་པར་བལྟས་ཏེ།",
    "འཁྱིལ་བ་དེ་ཐག་པ་ཡིན་གྱི་སྦྲུལ་མ་ཡིན་པར་འདུག་གོ་སྙམ་པའི་ངེས་པ་བསྐྱེད་ནས།",
    "འདིར་ཡང་རང་བཞིན་མེད་པའི་ངེས་པ་ཇེ་འཕེལ་དུ་བརྟན་དགོས་ལ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "དེ་ལྟར་བསྒོམས་པས་ཡུན་རིང་མ་བསྒོམས་སྙམ་ནས་བལྟས་ཙ་ན་ནམ་དང་ཉི་མ་འུད་འུད་བཅད་ནས་སྣང་ན་སེམས་ཟིན་པ་ཡིན་ལ།",
