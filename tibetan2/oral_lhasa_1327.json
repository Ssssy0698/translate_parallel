    "ད་ནི་བཅོམ་ལྡན་འདས་འཇམ་དཔལ་གྱིས་ཤམ་བྷ་ལའི་ཡུལ་དུ་སྤྲུལ་པའྀ་སྐུ་བཞེས་པ་དང་།",
    "ཆིགས་སུ་བཅད་པ་བདན་ནུ་རྩ་བརྒྱད་ཀྱི་དོན་ནི་ལེགས་པར་བསྟན་ཏོ།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་ཚེ་ས་དཀའ་མ་ལ་སོགས་པ་ལྡ་ལ་བྱིན་གྱིས་རློབས་པར་བྱེད་དེ།",
    "དེ་བཞིན་དུ་མི་མཐུན་པའི་རྒྱུ་སྐར་དང་ལྡན་པར་གྱུར་པ་དེ་ལྟན་ནི།",
    "དོན་མི་འགྲུབ་པར་ཤེས་པར་བྱའོ།",
    "འཁྲུག་པའི་གནས་༥་ཞུགས་པར་གྱས་པའི་མི་དེ་འཆི་བར་འགྱུར་བའོ།",
    "བཅོམ་པར་གྱུར་པའོ།",
    "ཨེའི་དཀྱིལ་འ་ཁོར་ལ་བཀྲ་ཤིས་ཤར་བར་གྱུར་པ་དེ་ལྡན་ནི་ཆས་པར་གྱུར་པའོ།",
    "སའི་དཀྱིལ་འཁོར་འམ་དམན་པར་གྱུར་པ་ནི་སྔོན་པར་གྱུར་པ་དེ་ལྟ་ན་ནི་ཡུལ་དུ་འཁྲུག་པར་འགྱུར་རོ།",
    "ཆུ་གཡོན་པའི་དཀྱིལ་འཁོར་ལས་ཟླ་བ་ལ་སོགས་པ་ཤར་བ་དེ་ལྟ་ན་ནི་བཅོམ་པ་ལ་སོགས་པ་གཡུལ་གྱིས་གནས་སུ་ཤེས་པར་བྱའོ།",
    "བདུན་གྱིས་བཅུ་དནས་མི་མཉམ་པའི་རང་བཞིན་དུ་གྱུར་པའི་ཞི་མ་ལ་སོགས་པ་ལྷག་མར་གྱུར་པ་དེ་ལྟ་ན་ནཾ་དོན་གྲུབ་པར་མི་འགྱུར་རོ།",
    "དེ་ནས་མཉམ་པའི་རང་བཞིན་དུ་གྱུར་པ་ཟླ་བ་ལ་སོགས་པ་དེ་ལྟ་ན་ནི་དོན་གྲུབ་པར་འགྱུར་ཞེས་བྱའོ།",
    "བདུན་པ་ལ་གལ་ཏེ་དུས་ཀྱི་མེ་ལ་སོགས་པར་དེ་ལྟན་ནི་ཞུ་བ་བོ་ལའཆིའ་ལ་སོགས་པའི་སྡུག་བསྔལ་འགྱུར་བའོ།",
    "བར་གྱུར་པ་དེ་ལྟ་ན་ནི་དབུ་འཆི་བལ་སོགས་པར་གྱུར་པའོ།",
    "ངེས་པར་དོན་ནི་ཐམས་ཅད་འགྲུབཅེས་བྱའོ།",
    "དེ་རྣམས་ལ་ཞིམ་ལ་སོགས་པས་ལོངས་སྤྱོད་པར་བྱེད་དོ།",
    "དབྱངས་དང་གསལ་བྱེད་དུ་ཤེས་པར་བྱའོ།",
    "གཟའི་འཁོར་ལོ་ཤེས་པར་བྱས་ལ་གལ་ཏེ།",
    "དེ་ལྟ་ན་ནི་དགྲ་རྣམས་གསོད་པར་བྱེད་དོ།",
    "རྒྱབ་ཏུ་གྱུར་པ་དེ་ལྟན་ན་དགྲ་ལ་སོགས་པ་གསོད་པར་བྱེད་ཅེས་བྱ་བའོ།",
    "དེ་ནས་གལ་ཏེ་གདུག་པ་དང་ཞི་བའི་གཟའ་ལ་སོགས་པ་ནི་དུས་གཅིག་ཏུ་ག་ཡས་དང་རྒྱབ་ཏུ་མདུན་དང་གཡོན་དུ་རང་དང་དགྲ་ལ་གནས་པར་དེ་ལྟ་ན་ནི་སྟོབསགཞིས་བཅོམ་པར་བྱེད་ཅེས་བྱ་བའོ།",
    "ཤར་བའི་ཕྱོགས་དེ་རྣམས་ཤེས་ན་ས་བྱ་བ་འགྲུབ་པ་དང་མི་འགྲུབ་པར་བྱའོ།",
    "རྣམ་པ་དྲུག་ཏུ་དེ་ཡང་རྣལ་འབྱོར་པས་ཤེས་པར་བྱའོ།",
    "དེ་ཤེས་ནས་འཁྲུགས་པའི་དུས་སུ་རྒྱལ་བ་དང་ཕམ་པར་རིག་པར་བྱའོ།",
    "ཕམ་པ་དང་བཅོམ་པར་འགྱུར་རོ།",
    "འདི་དག་ལ་སོགས་པའི་ནང་ནས་ནན་ཏན་ཀྱི་སྒྲ་གཅན་གྱིས་མཚན་ཉིད་ཤེས་པར་བྱ་སྟེ།",
    "ཁྱབ་འཇུག་དང་དྲག་པོ་ནི་ལྷན་ཅིག་ཏུམིརྣམས་ཀྱིས་ཀྱང་བརྩོམ་པར་བྱེད་དོ།",
    "ཁྱད་པར་དུ་གྱུར་པར་གསུངས་ཞེས་བྱའོ།",
    "གངདར་གང་དུ་ཁྲིད་པཞེས་བྱ་བའི་ཚིགས་སུ་བཅད་པ་བཅོ་ལྔས་སྒྱོགས་ལ་སོགས་པའི་མཚན་ཉིད་དེ་བཞིནགཤེགས་པས་གསུངས་པ་དེས་བདག་ཅག་ལ་དགོས་པ་མེད་དེ།",
    "དཔག་ཚད་འབུམ་ཕྲག་གསུམ་ལ་མི་ཡིས་བདག་པོ་ཞི་མའི་དུམ་བུར་རིམ་པར་འཁོ་ཞེས་བྱ་བ་ལ།",
    "ཕུང་པོ་ལྔ་རྣམ་པར་དག་པའི་ཕྱིར་རྣམ་པ་ལྔར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་དེ་ཉིད་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ཐོབ་པར་བྱ་བའི་ཕྱིན།",
    "ད་ནི་མུ་རྒྱུད་འགྲེལ་། སྟེ་གས་པའི་སྐད་ཀྱིས་བཅོམ་ལྡན་འདས་དེཉིད་ཀྱི་མཚན་རྗོད་པརམཛད་དེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དབྱེ་བ་གཅིག་དངགཉིས་ལ་སོགས་པ་ཤེས་པར་བྱའོ།",
    "འདོད་འཇོ་དད་གདུག་པར་གྱུར་པའི་མི་རྣམས་ཀྱིས་གཤིག་པར་མི་ནུས་པའི་རྗོད་དང་།",
    "མགྲིན་པ་ལ་སོགས་ལས་སྐྱེས་པར་གྱུར་པའི་ཨཱ་ལི་དད་ཀཱ་ལིའི་ཡིག་གེ་རྣམས་དང་བྲལ་བའི་ཐམས་ཅད་མཁྱེན་པའི་སྐད་ཀྱིས་དེ་བཞིན་ག་ཤེགས་པས་སེམསཅནལ་ཕན་གདགས་པརམཇེདཅེས་བྱ་བའོ།",
    "སྐལ་བ་དང་ལྡན་པའི་སེམསཅན་རྣམས་ལ་མུ་སྟེགས་པའི་བློ་ཡིས་རིག་བྱེད་ལ་སོགས་པབསྟན་པརམཛད་དེ།",
    "དེ་བཞིན་དུ་འཇིག་རྟེན་པའི་བློ་ནི་རློབར་གྱུར་པའི་མི་རྣམས་ལ་རྟོག་གེ་དང་བསྟན་བཅོས་ལ་སོགས་པ་བསྟན་པར་མཛ་ད་དེ།",
    "བྱད་ཆུབསེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ཕྱག་ན་རྡོ་རྗེལསོགས་པ་རྣམས་ལ་དེས་པར་གནས་པར་མཛད་དེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཕྱག་ནརྡོརྗེ་ལ་ངེས་པ་ཇིལྟ་བ་བཞིན་དུ་གནང་ཞེ་ན།",
    "ཞེ་སབྱབ་ནི་འཁོར་དང་བཅས་པའྀ་ཀླ་ཀློ་རྣམས་བཅོམ་པར་མཛད་ཅེས་བྱ་བའོ།",
    "དེ་བཞིན་དུ་མྱོས་པར་གྱུར་པའི་གླང་པོཆེ་འབུམ་ཕྲག་བཞི་དང་།",
    "དེ་བཞིན་དུ་དྲག་པོས་རྟབ་སྟན་ལ་སོགས་པའི་ཀླ་ཀློའིརྒྱལ་པོ་། རྣམས་བཅོམ་པར་བྱེད་དེ།",
    "ཞེས་བྱབ་ལསེམསཅནཐམསཅད་ཀྱི་རྒྱུན་སྐྱོད་པར་མཛད་པས་ན་སྐྱོབ་པ་ཡིན་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བསོདནམས་ཀྱི་ཚོགས་དང་ཡེ་ཤེམ་ཀྱི་ཚོགས་རྗོགས་པར་མཛད་དོ།",
    "དེ་བསན་ལྷ་དང་ལྷ་མ་ཡིན་ལ་སོགས་བའི་རིགས་ལས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྲུལ་པའི་སྐུ་ཡང་དང་ཡད་དུ་བཞེས་པརམཛད་དེ།",
    "རྐད་པ་གཉིས་ལསོགས་པའི་རིགས་ལས་སྦྲུལ་པའི་སྐུ་འཁྲུངས་པར་མཛད་ནས།",
    "བདག་མ་འཚལ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྐང་པ་གཤིས་ཀྱིས་བསྟན་བཞེས་བྱ་བའོ།",
    "ཞུ་པལས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཁམས་རྣམས་ཀྱི་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་དང་དངོས་པོ་ཐ་དད་པ་རབསྟན་ཏོ།",
    "ས་བོནཞེས་བྱ་བ་ལ་སོགས་པས་རིམ་པ་བཞིན་དུ་བཞེས་བྱ་བའོ།",
    "སྐུ་བཞི་ཐོབ་པར་གྱུར་ནས་ངས་རྒྱས་ཞིང་ཐོབ་པར་གྱུར་པའོ།",
    "འོད་གསལ་བ་དང་བརྟགས་པར་རྣམ་པར་གྲོལ་བ་དང་།",
    "དེ་ཤིད་མངལ་དང་ཕྱི་རོལ་ཏུ་བསྟན་པརམཛད་དེ།",
    "དེ་ཉིད་སྐྱིད་གར་ཤེས་པར་བྱའོ།",
    "ད་ནི་ཐབས་དད་ཤེས་རབ་ཀྱི་དངོས་པོའི་མཚན་ཉིད་རྗོད་པར་མཛད་དེ།",
    "དེ་བས་རྩ་རྣམས་ཀྱི་འཕེལ་བ་རྗོགས་ནས་འགྲི་བ་པར་འགྱུར་ཏེ།",
    "དེ་བས་ན་ལོ་བརྒྱ་ཐམ་པའི་བར་དུམི་རྣམས་ཀྱི་ཚེ་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "དེ་སྟེང་ཞེས་བྱ་བ་ལ་སེགས་པས་དེ་རྣམས་ཀྱི་གནས་གསུངས་སོ།",
    "རྩ་འི་འཁོན་ལོལསམ་གཏོགས་པར་སྲོག་ལ་སོགས་པའི་བྱ་བབྱེད་པར་མི་འགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "དངལ་འདུས་པའི་རྒྱུད་ཀྱི་ཕྱོགས་ཤེས་པར་བྱའོ།",
    "འཁོར་ལ་སོགས་པའི་ཕྱག་རྒྱ་དྲུག་ཏུ་ཤེས་པར་བྱ་སྟེ།",
    "ལས་དང་པོ་པས་ཤེས་པར་བྱ་བའི་ཕྱིར་ཐབས་དང་ཤེས་རབ་ཀྱི་ཕྱག་རྒྱརྣམས་གསུངས་སོ།",
    "རྫོགས་པའི་གནས་སྐབས་སུ་ཀུནལ་ལྟོས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའོ།",
    "རྒྱུདང་འབྲས་བུའི་འབྲེལ་པ་མེད་པས་གསུངས་སོ།",
    "དྲང་བའི་དོན་དངངེས་པའི་དོན་དུབཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "ཕྱིནས་དེ་རྣམས་ཀྱི་འཁོར་དང་ལྷན་ཅིག་ཏུ་འདྲས་པར་གྱུདན་སྟོང་བརྒྱད་ཅུའི་རང་བཞིན་དུ་གྱུར་པའི་རྒྱུད་ཀྱི་རྒྱལ་པོ་བསྡུས་པའི་རྒྱུད་ཀྱི་ལྷ་དང་ལྷམརྣམས་སོ།",
    "དེ་ཉིད་ཟླ་བ་དང་ཞིམའི་དབྱིབས་ཕྱེ་བར་གྱུར་ན་སྟོང་དྲུག་བརྒྱ་ཉི་ཤུའི་རང་བཞིན་དུ་པར།",
    "དེབ་ས་ན་ཡོན་ཏན་དེ་ལྟར་རྣལ་འབྱོརཔ་ས་འགྲུབ་པར་འདོདན་ནན་ཏན་གྱིས་བསྲུང་བར་བྱའོ།",
    "དབུགས་ཞི་ཁྲི་ཆིག་སྟོད་དྲུག་བརྒྱའི་ཚོགས་དེ་ཉིད་གལ་ཏེརྩ་གཡོན་པ་འབའ་ཞིག་ལས་འབབ་པར་གྱུར་པ་དེ་ལྟ་ན་ནི།",
    "རྟགསཞ་དེས་ལོ་གསུམ་གྱིས་འཆི་བ་སྟོན་པར་བྱེད་དོ།",
    "ཉིན་མཚན་གཅིག་འབབ་པའི་རིམ་པ་དེ་བཞིན་དུ་ཤིན་མཚནག་སུམ་གལ་ཏེ་འབབ་པར་གྱུར་པ་དེ་ལྟ་ནནི་འཆི་ལྟས་འཕེལ་གཤེས་པར་བྱའོ།",
    "དེ་ལ་བླ་བ་གསུམ་དང་ཟླ་བ་བཞི་པའི་རྟིང་ནས་ཉིན་མཚན་གསུམ་འབབ་པར་འགྱུར་ཏེ།",
    "ལྟེ་བ་ལསརྩ་གཉིས་ཆད་པར་ཤེས་པར་བྱའོ།",
    "ལྟེ་བའི་འཁོར་ལོ་ལ་རྩ་གསུམ་ཆད་པར་འགྱུར་རོ།",
    "དེ་ནས་ཞག་གཅིག་ནི་དབུགས་ཀྱི་ཚོགས་ཟད་པར་འགྱུར་གྱི་བར་དུ་དགུས་མར་བབནས།",
    "སྔ་མ་བཞིན་དུ་ལོ་གསུམ་གྱིས་འཆི་བར་འགྱུར་ཏེ་ལྟེ་བའི་འཁོར་ལོ་ལས་རྩ་གཅིག་རྒུད་འཆད་པར་འགྱུར་རོ།",
    "དེ་ནས་གལ་ཏེ་རྒྱུན་མི་འཆད་པ་དཞིན་མཚན་བཅུས་བབ་པར་གྱུརཔ་དེ་ལྟན་ནི་ལོ་གཉིས་དང་འཆི་ལྟས་ཀྱི་མཚན་ཉིད་དང་ལྷན་ཅིག་ཏུ་ཉིན་མཚན་ནི་གུ་རྩ་ལྔས་འཆི་བར་འགྱུར་ཏེ།",
    "རྩ་དོར་བ་འགྲེལ་སྔོན་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཞིན་མཚན་བཅོ་ལྔ་གལ་ཏེ་འབབ་པར་གྱུར་པ་དེ་ལྟ་ན་ནི།",
    "ཉིན་མཚན་ཞི་ཤུ་འབབ་པར་གྱུར་པ་དེ་ལྟ་ན་ནི་ཟླ་བ་བདུན་དང་ཞག་ཞིཤུས་འཆི་བར་འགྱུར་རོ།",
    "ཏཞི་མཚན་ཉི་ཤུ་རྩ་ལྔ་འབབ་པར་གྱུར་པ་དེ་ལྟ་ན་ནི།",
    "ཐུར་སེལ་འདིར་གྱི་རྩ་གསུམ་གྱི་བྱ་བ་བྱེད་པའི་ཕྱིར་གསུམ་གྱིས་འཕེལ་བར་གསུངས་ཞེས་བྱ་བའི་ངེས་པའོ།",
    "དབུགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ལྟེ་བའི་འཁོར་ལོ་ལ་སོགས་པའིརྩ་རྣམས་ཇི་ལྟད་འཆད་པར་འགྱུར་ཞེ་ན།",
    "རྩ་དེ་རྣམས་ལོ་གསུམ་གྱིས་འཆད་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་མགྲིན་པ་ལ་སོགས་པའི་འཁོར་ལོའི་རྩ་རྣམས་ནི་ཉིན་མཚན་སུམ་མུལ་སོགས་པས་འཆད་པར་འགྱུར་རོ།",
    "རྒྱུ་དེའི་ཕྱིར་མིརྣམས་ཀྱི་ཚེ་ལོ་བརྒྱད་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "དེ་ཉིད་ཉིས་ལྡབ་དུ་བྱསན་ལོ་གསུམ་དང་ཟླ་བ་ཕྱེད་དང་གཉིས་པོ་ནི་ཉི་མས་དག་པར་བྱེད་དེ།",
    "དེ་ཉིད་དབུས་མའི་བདག་ཉིད་དུ་གྱུར་པར་ཤེས་པར་བྱའོ།",
    "ཞེས་བྱ་བཞི་ཤེས་པར་བྱ་བའི་ཕྱིར་འཇིག་རྟེན་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ལྷག་མ་ལོ་གསུམ་དང་བླ་བ་ཕྱེད་དང་གཉིས་པོ་ནི་མུན་པའི་རང་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དོན་དེ་དག་ལ་སོགས་པ་གང་ཡིན་པཀ་ལ་སོགས་པའི་ཚིགས་བཅདབཞིས་གསུངས་སོ།",
    "དེ་བས་ན་ཕྱི་རོལ་ཏུ་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་མཚན་ཉིད་དད་སེམས་ཀྱི་མཚན་ཉིད་གར་ཡིན་པ་དེ་ལུས་བོ་ལས་མ་གཏོགས་པ་ཤེས་པར་མི་འགྱུར་ཏེ།",
    "བདེ་བམ་ཐོབ་ཀྱི་བར་དུ་གང་དུ་བརྗོད་དུ་མེད་པའི་རང་བཞིན་དུ་གྱུར་པ་དེ་ཐོབ་པར་འགྱུར་ཏེ།",
    "རྣལ་འབྱོར་པ་དེ་རྣམས་ལ་འཆི་བ་བསླུ་བའི་ཐབས་ཀ་བསྟན་པརམཛད་དེ།",
    "དེ་ཡང་སྲོགརྩོ་ལ་བའི་མཚན་ཉིད་ཤེས་ནས་སྲོག་ལ་སོགས་པ་བསྡམ་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ཉིད་བསྟན་པར་མཛད་དེ།",
    "ཕྱག་རྒྱཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་ཉིན་མཚན་གཞན་དུ་ལས་ཀྱི་ཕྱག་རྒྱའི་བསྟེན་གང་གསུངས་པ་ངེམཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བ་འགྲུབ་པའི་ཕྱིར་ཡིན་གྱི་བདེ་བ་ཉམས་པའི་ཕྱིར་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུགཙང་བ་དང་མི་གཙང་བ་ལ་སོགས་པའི་ཟས་ཟ་བ་ནི།",
