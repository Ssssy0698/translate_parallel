    "རྣམ་པར་དཔྱད་ན་གཞན་ལས་སྐྱེ་བ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་དམ་པའི་རང་བཞིན་ཅན་གྱི་དངོས་པོ་སྐྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཡང་མ་ཡིན་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུ་མི་འཐད་པའི་ཕྱིར་དོན་དམ་པར་དངོས་པོ་མེད་པས་སོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མིག་ལ་སོགས་པ་ལས་གཞན་ཉིད་ཡོད་པར་འགྱུར་ནའོ་ཞེས་པའོ།",
    "དེའི་ཚེ་གཞན་ཉིད་དེ་ཡོད་པ་ཉིད་ཟིན་ཀྱང་གང་ཡོད་པར་གྱུར་པ་དེ་ལ་སྐྱེ་བ་དགོས་པ་ཅི་ཞིག་ཡོད་ཅེས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཇུག་ཉེ་བར་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་གཞན་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟར་གལ་ཏེ་འབྲས་བུ་སྐྱེས་པར་གྱུར་ན།",
    "དེའི་ཚེ་འབྲས་བུ་ལ་ལྟོས་པའི་རྒྱུ་གཞན་ཉིད་དུ་ཡོད་པར་འགྱུར་བ་ཡིན་པ་ལས།",
    "སྒྲ་ཙམ་འབའ་ཞིག་ལུས་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་བརྟགས་ཤིང་དཔྱད་ན་དོན་གཞན་གྱིས་སྟོང་པའི་སྒྲ་ཙམ་ལུས་པའོ།",
    "ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་བསྟན་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "ཡོད་པའམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཏེ་ཡོད་པ་ཡང་མ་ཡིན་མེད་པ་ཡང་མ་ཡིན་པ་གཉིས་ཀ་མ་ཡིན་པའི་རང་བཞིན་ཅན་ཞིག་སྐྱེད་པར་བྱེད།",
    "དེ་ལ་ཡོད་པ་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "མེད་པ་ཡང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "གཉིས་ཀའི་རང་བཞིན་ཅན་ཡང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཕྱོགས་གཉིས་ཀ་ལ་བསྟན་པའི་སྐྱོན་ཡོད་པར་འགྱུར་བས་སོ།",
    "ཡོད་པ་དང་མེད་པ་གཉིས་ཀ་མ་ཡིན་པ་ཡང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་དག་རྒྱུའི་གནས་སྐབས་ན་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ཡིན་ཏེ།",
    "སྔར་མེད་པའི་རྫས་སྐྱེད་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ་ཞེས་འདོད་པའོ།",
    "སེམས་ཙམ་པ་རྣམས་ནི་འབྲས་བུ་མེད་པར་སྨྲ་བ་ཡིན་ཏེ།",
    "དེ་ལ་བྱེ་བྲག་པ་རྣམས་ནི་ས་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་ལས་རྡུལ་ཕྲ་རབ་གཉིས་པ་ལ་སོགས་པའི་ཡན་ལག་ཅན་གྱི་རྫས་སྐྱེ་བ་ཡིན་ནོ་ཞེས་འདོད་པས་འབྲས་བུ་མེད་པར་སྐྱེ་བ་ཁས་ལེན་པ་ཡིན་ནོ།",
    "རྣམ་པ་གཞན་གྱིས་ཁྱིམ་དེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་ན་འབྲས་བུ་མེད་པར་ཁས་ལེན་པར་འགྱུར་བས་སོ།",
    "དེ་བཞིན་དུ་འབྲས་བུ་མེད་པར་སྨྲ་བ་རྣམས་ལ་ཡའབྲས་བུར་གྱུར་པའི་ཁྱིམ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "མྱུ་གུ་ལ་སོགས་པ་དངོས་པོ་ཐམས་ཅད་ལ་ཡོད་པ་དང་མེད་པར་བརྟགས་པས་མ་རིག་པ་དང་ས་བོན་ལ་སོགས་པའི་རྒྱུ་རྣམས་དོན་མེད་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "འབྲས་བུའི་ངོ་བོ་ཉིད་ཡོད་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གལ་ཏེ་རྒྱུས་འབྲས་བུ་སྐྱེད་པར་བྱེད་ན་དེས་འབྲས་བུ་ཡོད་པ་ཞིག་སྐྱེད་དམ་འོན་ཏེ་མེད་པ་ཞིག་སྐྱེད་གཉིས་ཀ་ཡང་མི་རིགས་ཏེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་མེད་པའི་འབྲས་བུ་དེ་ཡང་རྒྱུས་སྐྱེད་པར་མི་བྱེད་དེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་མེད་པའི་ཕྱིར་བོང་བུའི་རྭ་བཞིན་ནོ་ དེ་ལ་གཞན་དག་ནི་རྒྱུས་འབྲས་བུ་སྐྱེད་པའི་བྱ་བ་བྱེད་པར་ཁས་བླངས་ན།",
    "འོན་ཀྱང་འབྲས་བུ་སྐྱེད་པའི་བྱ་བ་མི་བྱེད་པར་རྒྱུའི་ངོ་བོ་ཉིད་དུ་ཡོད་པ་ཡིན་ལ།",
    "འབྲས་བུ་མེད་ན་ཡང་རྒྱུ་རྒྱུ་ཉིད་དུ་མི་འགྲུབ་པ་ཡིན་པས་དེའི་ཕྱིར་འབྲས་བུ་ཡང་ཡོད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལན་ནི་གལ་ཏེ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་རྒྱུ་ཉིད་དུ་འགྲུབ་ན་དེ་རྒྱུར་འགྱུར་བ་ཡིན་པ་ལས་སྐྱེད་བྱེད་མ་ཡིན་པ་རྒྱུ་ཉིད་དུ་ཅི་ལྟར་རིགས།",
    "དེ་ལ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནི་ཡོད་པ་དང་མེད་པའི་རང་བཞིན་ཅན་གྱི་དངོས་པོ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་མེད་པ་དག་མྱ་ངན་ལས་འདས་པ་གཅིག་ཉིད་ལ་མི་སྲིད་པས་མྱ་ངན་ལས་འདས་པ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ཅི་ལྟར་ཡོད་པར་འགྱུར་ཏེ།",
    "ཡོད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་ཅན་དང་།",
    "བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པའི་རང་བཞིན་ཅན་གྱི་ལས་མི་བྱེད་དེ།",
    "དངོས་པོ་གཅིག་ལ་དུས་གཅིག་ཏུ་བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་ཅན་དང་།",
    "བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པའི་རང་བཞིན་ཅན་དུ་མི་རིགས་པས་སོ།",
    "ཕྱོགས་བཞི་པ་དགག་པར་བྱ་བའི་ཕྱིར་གཉིས་ཀ་དང་བྲལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་གོ་སླའོ།",
    "ཅུང་ཟད་ཀྱང་ཁྱད་པར་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་མེད་པ་དག་བཀག་པས་ཁྱད་པར་དུ་བྱས་པའི་དངོས་པོ་ཅུང་ཟད་ཀྱང་མེད་པས་སོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་དངོས་པོ་ཞེས་བྱ་བ་འགའ་ཞིག་ཡོད་པར་གྱུར་ན།",
    "དེ་བཀག་པས་མྱ་ངན་ལས་འདས་པ་དངོས་པོ་མེད་ཅེས་བརྟག་པར་མི་རིགས་པ་དང་།",
    "འདིས་ནི་གཉིས་དང་བྲལ་བ་ཡང་མེད་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་འཇིག་རྟེན་པའི་སྒོ་ནས་གཞན་ལས་སྐྱེ་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "མེས་སྲེག་པར་བྱེད་པ་བཞིན་ནོ།",
    "བརྗོད་པར་འདོད་པའི་དོན་གྲུབ་པ་ཞེས་བྱ་བ་ནི་བརྗོད་པར་འདོད་པའི་དོན་གཞན་ལས་སྐྱེ་བ་གྲུབ་པའོ།",
    "དེ་ལ་གཞན་གྱི་ལན་ནི་དེ་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྗོད་པར་འདོད་པའི་དོན་གྲུབ་པ་ཉིད་ཡིན་ནོ་ཞེས་པའོ།",
    "དོན་གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ན་ལས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གལ་ཏེ་རིགས་པ་བརྗོད་པར་འདོད་ན་དངོས་པོ་མངོན་སུམ་པ་ལ་འམ།",
    "འདིར་གཞན་ལས་སྐྱེ་བར་མངོན་སུམ་གྱིས་གྲུབ་པར་རིགས་པས་ཅི་ཞིག་བྱ།",
    "དེ་ལ་ལན་གྱི་རིམ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཞིག་བསྟན་བཅོས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡི་མུག་པར་གྱུར་པ་ནི་ལན་བརྗོད་པར་མི་ནུས་པའོ།",
    "ཁྱད་པར་ཅན་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པ་ལ་གྲགས་པ་ཉིད་དོ་ བདེན་པ་གཉིས་ཀྱི་རྣམ་པར་གཞག་པ་ཞེས་བྱ་བ་ནི་ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པ་གཉིས་ཀྱི་རྣམ་པར་གཞག་པ་སྟེ།",
    "དེ་ལ་ཡུལ་གྱི་སྒོ་ནས་ཀུན་རྫོབ་དང་དོན་དམ་པའི་རྣམ་པར་གཞག་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་ཀུན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དངོས་རྙེད་ཅེས་བྱ་བ་ནི་ཡང་དག་པར་བརྫུན་པ་མཐོང་བ་སྟེ།",
    "ངོ་བོ་གཉིས་ནི་འཛིན་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་ཡང་དག་པ་ཕྱིན་ཅི་མ་ལོག་པ་དམིགས་པ་གང་ལ་ཡོད་པ་དེ་ནི་ཡང་དག་པར་མཐོང་བ་སྟེ།",
    "མཐོང་བ་བརྫུན་པ་ཀུན་རྫོབ་བདེན་པར་གསུངས།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ན་བདེན་པ་གཉིས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་དེའི་རང་བཞིན་འཆད་པར་འགྱུར་བས་སོ།",
    "ད་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་དབྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདེན་པ་གཉིས་རྣམ་པར་བཞག་ནས་ཞེས་བྱ་བ་ནི་ཡང་དག་པ་དང་།",
    "བརྫུན་པ་མཐོང་བའི་ཡུལ་གྱི་སྒོ་ནས་བདེན་པ་གཉིས་སུ་རྣམ་པར་བཞག་ནས་སོ།",
    "འཕགས་པ་རྣམས་ལ་ལྟོས་ནས་ཐམས་ཅད་བརྫུན་པར་མཐོང་བ་ཡིན་པས་སོ།",
    "འཕགས་པ་རྣམས་ལ་ལྟོས་ནས་བརྫུན་པར་མཐོང་བ་ཡིན་དུ་ཟིན་ཀྱང་།",
    "དེ་དང་བྲལ་བས་བརྫུན་པར་མཐོང་བ་དང་།",
    "དེས་གཟུང་བར་བྱ་བའི་དོན་དང་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་བརྫུན་པས་གཟུང་བར་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་པའི་ཞེས་བྱ་བ་ནི་འཛིན་པར་བྱེད་པའོ།",
    "གཉིས་འདོད་དེ་ཞེས་བྱ་བ་ལ་གཉིས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་ནི་བདེན་པ་མ་ཡིན་ནོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "ཏིལ་མར་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུས་ཁྱད་པར་ཅན་དང་ཉེ་བར་གྱུར་པའི་ཉི་མའི་འོད་ཟེར་ལ་སོགས་པ་རྣམས་ནི་ཞེས་བྱ་བ་ལ།",
    "ཡུལ་ཁྱད་པར་ཅན་ནི་མྱ་ངམ་གྱི་ཐང་ལ་སོགས་པའོ།",
    "དུས་ཁྱད་པར་ཅན་ནི་ཉི་མ་གུང་ལ་སོགས་པའོ།",
    "དེ་དག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡང་དག་པ་མ་ཡིན་པས་བྱས་པའི་གྲུབ་པའི་མཐའ་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་པས་བྱས་པའི་གྲུབ་པའི་མཐའོ།",
    "རྣམ་པར་གཞག་པ་ཞེས་བྱ་བ་ནི།",
    "འཆད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཅི་ལྟར་རྨི་ལམ་ཞེས་བྱ་བ་ལ་སོགས་པས་འཆད་པར་འགྱུར་བའོ།",
    "འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་བདེན་པ་དང་བརྫུན་པའི་རྣམ་གཞག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མི་ཤེས་པ་གཉིད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱོད་ཅེས་བྱ་བ་ནི་མི་རིགས་པའི་གཡོ་བར་བྱས་པའོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མུ་སྟེགས་ཅན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཁོ་ན་ཉིད་ལ་འཇུག་པར་འདོད་པས་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་མངོན་དུ་བྱེད་པ་ལ་འཇུག་པར་འདོད་པས་སོ།",
    "ངེས་པར་མ་བཟུང་བ་ཞེས་བྱ་བ་ནི།",
    "འཇིག་པར་བརྗོད་པས་སྐྱེ་བ་དང་།",
    "འཇིག་པར་ངེས་པར་མ་བརྗོད་པའོ།",
    "གཟུགས་ལ་སོགས་པ་ལས་ཐ་དད་དུ་གྱུར་པའི་ཡན་ལག་ཅན་དུ་བརྟགས་པའི་ཕྱིར་དངོས་པོ་ངོ་བོ་ངེས་པར་མ་བཟུང་བའོ།",
    "དེ་ཉིད་རི་སྟེ་གཞིག་པར་དཀའ་བས་སོ།",
    "པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་ཁོང་དུ་ཆུད་པའི་རང་བཞིན་གྱི་འབྲས་བུ་མི་ཐོབ་པས་སོ།",
    "འདིའི་དོན་ནི་ཅི་ལྟར་ཤིང་ཐོག་དོན་དུ་གཉེར་བའི་སྐྱེས་བུ་ཤིང་ཐོག་ཐོབ་པར་བྱ་བའི་ཆེད་དུ་ཤིང་ཐོག་དང་བཅས་པའི་སྡོང་པོ་ལ་འཛེག་ཅིང་ཡལ་ག་སྔ་མ་བཏང་ནས་ཡལ་ག་ཕྱི་མ་མ་བཟུང་ན་ཤིང་ཐོག་མ་ཐོབ་པར་གཡང་ས་ཆེན་པོར་ལྷུང་བར་འགྱུར་བ་དེ་བཞིན་དུ་མུ་སྟེགས་པ་རྣམས་སོ་ཞེས་པའོ།",
    "དེ་ལྟར་འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་དབྱེ་བའི་རྣམ་གཞག་བྱས་ནས་འཇིག་རྟེན་གྱི་མངོན་སུམ་གཞན་ལས་སྐྱེ་བ་འགོག་པ་ལ་གནོད་བྱེད་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་རྣམ་གཞག་བྱས་ནས་སོ།",
    "དེས་ན་འཇིག་རྟེན་པའི་མངོན་སུམ་གྱིས་གཞན་ལ་སྐྱེ་བ་གྲུབ་པས་འཕགས་པའི་སྤྱོད་ཡུལ་དུ་གྱུར་པའི་གཞན་ལས་སྐྱེ་བ་མེད་པ་ལ་གནོད་པ་ཡོད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ལས་སྐྱེ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱེ་བ་དགག་པ་འདི་ཁྱད་པར་དུ་ཡིན་པ་ཞེས་བྱ་བ་ནི།",
    "འཕགས་པ་ལ་ལྟོས་ནས་དབྱེ་བའི་རྣམ་གཞག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདེན་པར་སྣང་ཞེས་བྱ་བ་ནི་བདེན་པའི་རང་བཞིན་དུ་ཞེན་པའོ།",
    "རྫོབ་བདེན་ཞེས་ཐུབ་པ་དེས་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་དངོས་པོ་དེ་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པའོ་ཞེས་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པར་ནི་མ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་དང་འཕགས་པ་རྣམས་ལ་ཅི་ལྟར་རིགས་པར་དེ་དག་ལ་བདེན་པར་ཞེན་པ་མེད་པས་སོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་དེ་ལ་ཞེས་བྱ་བ་ནི་ཚིགས་སུ་བཅད་པས་གཏི་མུག་ལ་སོགས་པ་བརྗོད་པ་ལའོ།",
    "བས་མཐོང་བ་གང་ཡིན་པ་དེ་ལ་སྒྲིབ་པར་བྱེད་པ་སྟེ།",
    "བདེན་པར་སྣང་ཞིང་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་མེད་པ་ལ་ཡོད་པ་དང་།",
    "དོན་དམ་པའི་བདེན་པ་དག་ཀུན་རྫོབ་ཀྱི་བདེན་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་ཞིག་ཀུན་རྫོབ་ཏུ་ཡང་བརྫུན་པ་ཞེས་བྱ་བ་ནི་གཟུགས་བརྙན་དང་བྲག་ཅ་ལ་སོགས་པ་རྣམས་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པར་མི་འགྱུར་ཏེ།",
    "བདེན་པར་ཞེན་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་ཉན་ཐོས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཙམ་དུ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "བྱིས་པ་རྣམས་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བྱིས་པ་རྣམས་ལ་ནི་སླུ་བར་བྱེད་པ་ཡིན་པའི་ཕྱིར་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་འདིས་བྱིས་པ་རྣམས་ལ་བདེན་པ་མ་ཡིན་པ་ལ་བདེན་པར་ཞེན་པས་སླུ་བར་བྱེད་པ་ཡིན་གྱི་དོན་དམ་པར་བདེན་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལས་གཞན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་ནི་དེ་ཡང་ཤེས་བྱའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ཐམས་ཅད་འགག་པའི་ཕྱིར་རོ་ འདིའི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "དེས་ན་སེམས་དང་སེམས་བྱུང་ལོག་པར་འདོད་པ་ཡིན་ཏེ།",
    "དམིགས་པ་མེད་པར་རབ་ཏུ་ཞི།",
    "ཞེས་གསུངས་སོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཞེས་བྱ་བ་ནི་བདེན་པར་ཞེན་པའི་འཇིག་རྟེན་པ་ལ་ལྟོས་ནས་སོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པ་གང་ཡིན་པ་ཞེས་བྱ་བ་ནི་དེ་རྣམས་ལ་བདེན་པར་ཞེན་པ་ཡོད་པས་བརྫུན་པར་སྣང་བ་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་དོན་དམ་པའི་བདེན་པ་ཡིན་ལ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ད་ནི་དོན་དམ་པའི་བདེན་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤེས་པའི་ཡུལ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་ཤེས་པའི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་ཏེའོ།",
    "དངོས་སུ་བསྟན་པར་མི་ནུས་པས་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་དང་སྒྲ་མེད་པར་གཞན་ལ་བསྟན་པར་མི་ནུས་པས་སོ།",
    "ཉན་པར་འདོད་པ་རྣམས་ལ་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་ཉན་པར་འདོད་པ་རྣམས་ལའོ།",
    "འདིའི་དོན་ནི་དོན་དམ་པའི་བདེན་པ་ནི་སྒྲ་དང་རྣམ་པར་རྟོག་པའི་ཡུལ་མ་ཡིན་པ་ཉིད་ཀྱིས་དངོས་སུ་བསྟན་པར་ནུས་པ་མ་ཡིན་དུ་ཟིན་ཀྱང་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རབ་རིབ་ཀྱི་མཐུས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རབ་རིབ་མེད་པས་རབ་རིབ་ཅན་གྱི་ཚོགས་ཐོབ་པར་རིགས་ཏེ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་ཞེས་བྱ་བ་ནི་སྐྲ་ཤད་ལ་སོགས་པའི་ཚོགས་འདི་དངོས་པོའམ་དངོས་པོ་མེད་པ་ཡིན་སྙམ་པའི་སྤྱིའི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པའོ།",
    "དེའི་རྣམ་པར་རྟོག་པ་བསལ་བར་འདོད་པས་ཞེས་བྱ་བ་ནི་སྐྲ་ཤད་ཀྱི་རྟེན་ཅན་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་བསལ་བར་འདོད་པས་སོ།",
    "རབ་རིབ་ཅན་གྱིས་དམིགས་པའི་ངོར་བྱས་ནས་ཞེས་བྱ་བ་ནི་རབ་རིབ་ཅན་ལ་སྐྲ་ཤད་དུ་སྣང་བ་གང་ཡིན་པ་དེ་ལ་བརྟེན་ནས་ཏེ།",
    "དེ་ལ་རབ་རིབ་ཀྱི་སྟོབས་ཀྱིས་སྐྲ་ཤད་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཀུན་ཏུ་དཔྱོད་པས་སོ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་བློའི་མིག་ལ་གནོད་པ་བྱས་པས་སོ།",
    "རྣམ་པར་ཤེས་པའི་ཕུང་པོ་སྟེ་ལྔའོ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བ་དག་རྒྱས་པར་བྱེད་པའི་ཕྱིར་སྐྱེ་མཆེད་དོ།",
    "སྐྱེ་མཆེད་ལ་སོགས་པར་སྣང་བའོ།",
    "དེའི་ཡུལ་ཅན་གྱི་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཀུན་ཏུ་སྤྱོད་པ་མེད་པ་དེའི་ཚེ་སྐྲ་ཤད་ལ་སོགས་པའི་རང་བཞིན་ཡང་དག་པར་རྟོགས་པ་ཡིན་ནོ།",
    "བརྫུན་པར་སྣང་བ་ནི་ལྡོག་པ་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་བདེན་པར་ཞེན་པ་ལས་ལོག་པ་ཙམ་ཡིན་ནོ།",
    "དེའི་ཚེ་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལོག་པས་ཕུང་པོ་ལ་སོགས་པ་རྣམས་ཀྱི་རང་བཞིན་རྟོགས་པ་ཡིན་ནོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་རྣམ་པ་དེ་ལྟ་བུའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་ན་ཞེས་བྱ་བ་ཁྱད་པར་སྨོས་པ་ནི་ཀུན་རྫོབ་ཀྱི་ཐ་སྙད་དུ་བརྗོད་པ་ཡིན་པས་སོ།",
    "ཡིད་ཀྱིས་དམིགས་པར་བྱ་བ་ཉིད་ཀྱི་སྤྱོད་ཡུལ་དུ་གྱུར་ནའོ།",
    "དེ་དོན་དམ་པའི་བདེན་པ་ཞེས་བྱ་བའི་གྲངས་སུ་མི་འགྲོ་སྟེ་ཞེས་བྱ་བ་ནི་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མི་རིགས་པས་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་དང་བྲལ་བའི་དེ་ཁོ་ན་ཉིད་ལ་ཡུལ་གྱི་རང་བཞིན་དུ་འགྱུར་བ་མི་རིགས་པའི་ཕྱིར་དེ་འཛིན་པར་བྱེད་པ་ཡང་མི་རིགས་པའི་ཕྱིར་རོ།",
    "ཐ་སྙད་ཐམས་ཅད་ལས་འདས་པའི་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་ན་དེ་ཁོ་ན་ཉིད་དང་།",
    "བྱེ་བྲག་མེད་པར་ཞེས་བྱ་བ་ནི་སྔོན་པོ་དང་།",
    "མི་རྟག་པ་ལ་སོགས་པའི་ཁྱད་པར་དང་མི་ལྡན་པས་སོ།",
    "སྨྲ་བར་བྱ་བ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་གྱི་བར་ལས་འདས་པ་ཡིན་ཏེ།",
    "སྟོབས་དང་མི་འཇིགས་པ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པའི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་དང་བྲལ་བ་ཡིན་ཏེ།",
    "གདུལ་བྱ་རྣམས་ཀྱིས་ཐམས་ཅད་མཁྱེན་པས་དེ་ཁོ་ན་ཉིད་ཐུགས་སུ་ཆུད་པ་ཡིན་ནོ་ཞེས་ཡུལ་གྱི་དངོས་པོ་བརྟགས་པ་ཡིན་པས་སོ།",
    "དེ་ཁོ་ན་ཉིད་ཀྱི་སྒྲ་དང་རྣམ་པར་རྟོག་པའི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྨྲ་བར་བྱ་བ་དང་སྨྲ་བ་དང་ཞེས་བྱ་བའི་ཚིག་དེ་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལྷའི་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་མ་རིག་པ་སྤངས་པར་འགྱུར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་ཤེས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེས་ན་འཇིག་རྟེན་ལས་གཞན་དུ་གྱུར་པའི་ལམ་སྟོན་པར་བྱེད་པའི་འཕགས་པ་རྣམས་ཀྱིས་དགོས་པ་ཅི་ཞིག་ཡོད་དེ།",
    "འཇིག་རྟེན་ཉིད་ལམ་སྟོན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཕགས་པའི་ལམ་ཁོང་དུ་ཆུད་པར་ཞེས་བྱ་བ་ནི་མཐོང་བའི་ལམ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེ་ཁོ་ན་ཉིད་ཀྱི་སྐབས་སུ་འཇིག་རྟེན་གྱི་ཡུལ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་འཇིག་རྟེན་གྱི་གནོད་པ་ཡོད་པར་མི་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་གྱི་གནོད་པའི་ཡུལ་གྱི་ཁྱད་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འོ་ན་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་དེ་ཁོ་ན་ཉིད་ཀྱི་སྐབས་སུ་འཇིག་རྟེན་གྱིས་གནོད་པར་མི་འགྱུར་ན།",
    "འོ་ན་གང་ལ་འཇིག་རྟེན་གྱིས་གནོད་པར་འགྱུར་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདེན་པ་མ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་རྗོད་པར་བྱེད་དེ།",
    "དཔེར་ན་རབ་རིབ་མེད་པ་ལ་བསེ་རུ་ལ་སོགས་པའི་སྣོད་སྐྲ་ཤད་དང་མི་ལྡན་པར་མཐོང་ལ།",
    "རབ་རིབ་ཅན་གྱིས་བསེ་རུ་ལ་སོགས་པའི་སྣོད་སྐྲ་ཤད་དང་ལྡན་པར་མཐོང་བས་མི་གནོད་ཀྱི།",
    "འོན་ཀྱང་བདེན་པར་རྟོགས་པས་གནོད་པ་དེ་བཞིན་དུ་འདིར་ཡང་ངོ།",
    "དེས་ན་སད་པའི་གནས་སྐབས་ན་བུམ་པ་བདེན་པར་རྟོགས་པས་བུམ་པ་མེད་པ་ཉིད་སེལ་བ་ཡིན་པས་འཇིག་རྟེན་གྱིས་གནོད་པར་འགྱུར་བའོ།",
    "ཕྱོགས་འདིས་ཞེས་བྱ་བ་ནི་གཞན་ལས་སྐྱེ་བ་འགོག་པ་ལ་འཇིག་རྟེན་གྱིས་གནོད་པ་ཡོད་པར་མི་འགྱུར་བའི་རིགས་པས་སོ།",
    "དེ་ལ་སྔར་བསྟན་པ་བཞིན་དུ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ད་ནི་འཇིག་རྟེན་པའི་གྲགས་པས་ཀྱང་གཞན་ལས་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ལྟ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཉིད་ཡིན་ན་ནི་ལྗོན་ཤིང་དེ་གཞན་བཞིན་དུ་དེ་ཡང་ཉེ་བར་སྟོན་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་བར་བྱའོ།",
    "གཞན་ལས་སྐྱེ་བ་མེད་པས་གཞན་ཉིད་མ་གྲུབ་པའི་ཕྱིར་མྱུ་གུ་བཞིན་དུ་ས་བོན་ཡང་ཆད་པར་མི་འགྱུར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་མྱུ་གུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མྱུ་གུ་ཡོད་བཞིན་དུ་ཡང་ས་བོན་རྒྱུན་ཆད་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་ས་བོན་ཞིག་ནས་མྱུ་གུ་སྐྱེ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ནི་ས་བོན་དང་མྱུ་གུ་དག་གཞན་མ་ཡིན་པ་དེ་ཉིད་མ་ཡིན་ནོ་ཞེས་བསྒྲུབ་པར་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནི་རང་བཞིན་མ་གྲུབ་པའི་ཕྱིར་དེ་ཉིད་དམ་གཞན་ཉིད་དུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གཏན་ཚིགས་བསྟན་པ་ཡིན་ནོ།",
    "མ་རིག་པ་ཡང་ངས་འདུ་བྱེད་བསྐྱེད་པར་བྱའོ་སྙམ་དུ་སེམས་པ་མེད་པ་དང་།",
    "གཞན་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་མྱུ་གུའི་གནས་སྐབས་ན་མྱུ་གུ་བཞིན་དུ་ས་བོན་ཡང་དམིགས་པར་འགྱུར་བ་དང་།",
    "ས་བོན་བཞིན་དུ་མྱུ་གུ་ཡང་དམིགས་པར་མི་འགྱུར་རོ།",
    "མི་འཇིག་པར་ཁས་བླངས་པས་སོ།",
    "ས་བོན་མེད་པར་མྱུ་གུ་སྐྱེ་བར་འགྱུར་བ་དང་།",
    "མྱུ་གུའི་གནས་སྐབས་ན་ཡང་ས་བོན་ཡོད་པར་འགྱུར་བས་སོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེས་ན་རྒྱུ་དེ་ཆད་པ་དང་རྟག་པ་ཉིད་དུ་རྣམ་པར་གཞག་པར་མི་ནུས་སོ།",
    "ད་ནི་སྐྱེ་བ་མེད་པ་གདོན་མི་ཟ་བར་ཁས་བླངས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་དངོས་པོའི་རང་བཞིན་སྐྱེ་བར་ཁས་ལེན་ནའོ།",
    "སྟོང་པ་ཉིད་དངོས་པོ་འཇིག་པའི་རྒྱུར་གྱུར་ན་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་རང་བཞིན་སྐྱེས་པ་ལ་སྟོང་པ་ཉིད་ཀྱི་དངོས་པོའི་རང་བཞིན་བཀག་པས་སོ།",
    "དེ་ནི་རིགས་མིན་ཞེས་བྱ་བ་ནི་དངོས་པོའི་རང་བཞིན་ཡོད་པར་གྱུར་ན་སྟོང་པ་ཉིད་ཀྱི་དངོས་པོ་སྟོང་པ་ཉིད་དུ་བྱ་བར་མི་རིགས་ཏེ།",
    "མེ་ཡོད་པར་གྱུར་ན་དེའི་རང་བཞིན་ཚ་བ་ཉིད་གཞན་དུ་བྱ་བར་མི་ནུས་པས་སོ་ཞེས་པས་སོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐམས་ཅད་ཀྱི་ཚེ་སྐྱེ་བས་ཁས་བླངས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་གདོད་མ་ནས་སྐྱེ་བ་མེད་པར་ཁས་བླང་བར་བྱ་དགོས་ཏེ།",
    "དངོས་པོ་ཅི་ལྟ་བ་བཞིན་དུ་ཡང་དག་པར་ཡོངས་སུ་ཤེས་པ་གང་ཡིན་པའོ།",
    "ཡང་དག་པར་སོ་སོར་རྟོག་པ་ནི་ཞེས་བྱ་བ་དེ་ཉིད་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་སྟོང་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་དོན་དམ་པར་གཉིས་སུ་མེད་པ་ཡིན་པ་ལ་གཉིས་ཀྱི་དངོས་པོར་བརྟགས་པ་གང་ཡིན་པ་དེ་ནི་ཀུན་བརྟགས་ཀྱི་ངོ་བོ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པས་སོ།",
    "སྟོང་པར་མི་བྱེད་པ་སྟེ།",
    "སྨོན་པ་མེད་པར་རྣམ་པར་རྟོག་པའོ།",
    "རྣམ་པར་རྟོག་པའི་ངོ་བོ་སྐྱེ་བ་མེད་པའི་ཕྱིར་སྟོང་པ་ཉིད་དང་།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲས་བྱས་པ་ལ་སོགས་པ་བསྡུ་བར་བྱའོ།",
    "དེས་ན་དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའོ།",
    "ལོག་པར་ལྟ་བས་མྱ་ངན་ལས་མི་འདའ་བར་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གསུངས་ཏེ།",
    "ཡང་དག་པའི་ལྟ་བ་སྔོན་དུ་འགྲོ་བ་ཅན་ཉིད་ཀྱིས་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་རྣམ་གཞག་མཛད་པའི་ཕྱིར་རོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་ཕྱིར་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པས་སྟོང་པ་མ་ཡིན་པ་སྟོང་པ་ཉིད་དུ་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "ངེས་པར་འབྱིན་པ་ཞེས་བྱ་བ་ནི་མི་འཇུག་པ་སྟེ།",
    "འོད་སྲུངས་ལྟ་བའི་རྣམ་པ་ཐམས་ཅད་ཀྱི་ངེས་པར་འབྱིན་པ་ནི་སྟོང་པ་ཉིད་ཡིན་ལ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ།",
    "འོད་སྲུངས་དེ་བཞིན་དུ་ལྟ་བའི་རྣམ་པ་ཐམས་ཅད་ནི་སྟོང་པ་ཉིད་ཀྱིས་ངེས་པར་འབྱིན་པར་བྱེད་ལ།",
    "དེ་ལྟར་དོན་དམ་པར་གཞན་ལས་སྐྱེ་བ་མེད་པར་བསྟན་ནས།",
    "ཀུན་རྫོབ་ཏུ་ཡང་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་ཕྱོགས་སྔ་མ་འགོད་པ་ནི།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དོན་དམ་པར་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རིགས་པས་དཔྱད་ན་རང་དང་གཞན་ལས་སྐྱེ་བ་མ་གྲུབ་པའི་ཕྱིར་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་སྟོང་པ་ཉིད་ཁོ་ནར་གནས་པས་དོན་དམ་པར་བདེན་པ་གཉིས་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དགེ་སློང་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཞི་བའི་མཚན་ཉིད་ཅན་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནོ།",
    "བརྫུན་པ་ཞེས་བྱ་བ་ནི་མེད་པ་ལ་ཡོད་པར་སྣང་བའི་ཕྱིར་རོ།",
    "འོ་ན་བདེན་པ་གཅིག་ཁོ་ན་བརྗོད་པར་རིགས་ཀྱི་བདེན་པ་གཉིས་ཞེས་ཅི་ལྟར་བརྗོད་ཅེ་ན།",
    "ལན་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྗོད་པར་བྱ་བ་དང་།",
    "རྗོད་པར་བྱེད་པའི་མཚན་ཉིད་ཅན་གྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཁས་མ་བླངས་ན་དོན་དམ་པའི་བདེན་པ་བསྟན་པར་མི་ནུས་ལ།",
    "མ་བསྟན་ན་རྟོགས་པར་མི་ནུས་པས་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ནི་དོན་དམ་པའི་བདེན་པ་རྟོགས་པའི་ཐབས་ཡིན་ནོ་ འཇིག་རྟེན་པའི་ལུགས་ཀྱིས་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པའི་ཐ་སྙད་ཀྱིས་སོ།",
    "བདག་དང་གཞན་ལས་སྐྱེ་བ་མ་དཔྱད་པར་ཁས་ལེན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དཔྱད་པར་གྱུར་ན་བདག་དང་གཞན་ལས་སྐྱེ་བ་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།"
  ]
}