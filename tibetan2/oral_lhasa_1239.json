    "དེས་ན་གཉིས་ཀ་ལ་ཡང་གེགས་མི་བྱེད་པར་འགྱུར་བ་ཡོད་པས་བྱེད་པའི་རྒྱུ་ཉིད་དུ་འགལ་བ་མེད་དོ།",
    "མཚུངས་པར་ལྡན་པའི་རྒྱུ་ནི་རྟེན་གཅིག་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་དག་སྟེ།",
    "པོའི་སྐད་ཅིག་མ་ཡིན་པའི་ཕྱིར་དུ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "རྫ་ས་མཚུངས་པ་སྟེ་ལྔའི་སྒོ་ནས་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན་ཏེ།",
    "ལོག་པར་ལྟ་བ་དང་།",
    "ཀུན་འབྱུང་མཐོང་བསྤང་བར་བྱ་བའི་ལོག་པར་ལྟ་བ་དང་།",
    "དེ་ལ་དམིགས་པར་བྱ་བས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་འདུས་བྱས་དང་།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་སྐྱེད་པར་བྱེད་པའོ།",
    "ཕྱི་ནས་སྐྱེ་བ་ལ་སོགས་པ་ནི་དཔེར་ན་དུས་ཐམས་ཅད་དངོས་པོ་ཡོད་པར་སྨྲ་བ་རྣམས་ཀྱིས་དངོས་པོར་གྱུར་པའི་མ་འོངས་པ་ཤེས་པའི་རྒྱུར་འདོད་པ་བཞིན་ནོ།",
    "ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐ་དད་པ་ནི་ནམ་ཡང་འཐད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་དམ་བཅའ་བ་ཙམ་ཡིན་པས་འཐད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱུ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྒྲུབ་བྱེད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་སྐྱེད་པར་བྱེད་པར་འདོད་པའི་མེ་དུ་བ་ལས་གཞན་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་ས་བོན་ལ་སོགས་པ་ལས་གཞན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་འདི་ངེས་པ་ནི་འདི་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲོས་ཏེ།",
    "དེས་ན་སྐྱེད་པར་བྱེད་པ་ལས་ཞེས་བྱ་བ་ནི་སྔ་མའི་སྐད་ཅིག་མ་སྔ་མ་ཁོ་ན་ལས་ཡིན་གྱི།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་སྐད་ཅིག་མ་ཕྱི་མ་ལས་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་ལན་འདེབས་པ་ནི་མི་རུང་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་སྒྲུབ་པར་བྱེད་པ་མི་རིགས་པས་སོ།",
    "གལ་ཏེ་ངེས་པར་མཐོང་བའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་ནུས་པ་ངེས་པ་ཡིན་ནོ་ཞེས་བརྗོད་ན་དེ་ལ་ཡང་མཚུངས་པ་ཡིན་ཏེ།",
    "གཞན་ལ་ཡང་ནུས་པ་ཅིའི་ཕྱིར་ཡོད་པར་མི་འགྱུར།",
    "གལ་ཏེ་ངེས་པ་མཐོང་བས་ནུས་པ་ངེས་པར་སྒྲུབ་པར་མི་བྱེད་ཀྱི།",
    "འོ་ན་ངེས་པ་མཐོང་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་དེ་དགོད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "སྔར་ནུས་པ་ངེས་པར་ཁས་བླངས་ནས་སྐྱོན་བརྗོད་པ་ཡིན་ལ།",
    "ད་ནི་ནུས་པ་ངེས་པ་ཉིད་དང་མི་སྲིད་པ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ད་ནི་གཏན་ཚིགས་སུ་བཀོད་པའི་གཞན་ཉིད་ཀྱང་མ་གྲུབ་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ནི་མྱུ་གུ་མ་སྐྱེས་ན་མྱུ་གུ་ལ་ལྟོས་པའི་ས་བོན་ལས་གཞན་པ་ཉིད་མ་གྲུབ་པས་ས་བོན་ལས་གཞན་པ་ཉིད་ག་ལ་ཡོད་པར་འགྱུར་ཞེས་པའོ།",
    "ས་བོན་རྣམ་པར་མ་གྱུར་པར་ཞེས་བྱ་བ་ནི་འདས་པ་ལ་སོགས་པར་མ་གྱུར་ནའོ།",
    "གང་ཡོད་པས་ཡོད་པར་མཚོན་པ་ཞེས་བྱ་བ་ལ་གང་ཡོད་པས་ཞེས་བྱ་བ་ནི་རྐྱེན་ལ་སོགས་པ་ཡོད་པས་སོ།",
    "ཡོད་པ་མཚོན་པ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་ཡོད་པར་མཚོན་པའོ།",
    "དེ་ཡོད་ན་ཡོད་པར་མཚོན་པ་དང་།",
    "མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་གལ་ཏེ་འབྲས་བུ་དེ་རྐྱེན་ལ་སོགས་པ་རྣམས་ལ་བརྟེན་པ་ཉིད་དུ་ཡོད་པར་མ་གྱུར་ནའོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་གང་ཁོ་ནའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ཉིད་དཔེའི་སྒོ་ནས་སྟོན་པ་ནི་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུས་མཉམ་པ་མ་ཡིན་པ་ནི་མིན་པར་ཞེས་བྱ་བ་ནི་དགག་པའི་ཚིག་གཉིས་ཀྱིས་སྐབས་སུ་བབ་པའི་དོན་གོ་བར་བྱེད་པ་ཡིན་ནོ་ཞེས་པ་སྟེ།",
    "དུས་མཉམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟ་ན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དུས་གཅིག་པ་ཉིད་མི་རིགས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཡོད་པ་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་བྱ་བ་སྲིད་པར་ཁས་བླངས་ཏེ།",
    "ད་ནི་བྱ་བ་ཉིད་ཀྱང་མི་སྲིད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ལྷ་སྦྱིན་འགྲོ་བ་བཞིན་ནོ།",
    "རྟེན་མེད་པར་ཞེས་བྱ་བ་ནི་མྱུ་གུ་མེད་པར་རོ།",
    "མེད་ན་ཞེས་བྱ་བའི་དངོས་པོའི་ཁྱད་པར་རོ་ཞེས་བྱ་བའི་བྱེད་པ་པོའི་མཚན་ཉིད་ཀྱི་དངོས་པོ་མེད་པར་གྱུར་ནའོ།",
    "དོན་འདི་ཉིད་ལ་ལུང་དང་འགལ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་སྲང་མདའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
