    "ལུས་ནི་སྡུག་བསྔལ་དག་གིས་གནོད།",
    "སེམས་ཁྱོད་ཅི་ཕྱིར་རབ་ཏུ་ཁྲོ།",
    "དམའ་འདུག་ཟེར་ན་ཅུང་ཙམ་མི་སྐྱིད་པ་ལྟ་བུའི་རེ་དོགས་ལུ་གུ་རྒྱུད་ཀྱིས་བཅིངས་ནས་ཡོད་ཚོད་རེད།",
    "ལྐོག་ཁ་བཙད་པོ་ལའང་གཏོང་བྱ་བ་ཡིན་ཁྱོད་རང་ཕྲ་མ་བྱས་པའི་བཤགས་བ་གྱིས་གསུང་བ་དང་།",
    "མིས་སྨྲ་གཞི་མི་ཡིན་ཟེར་བ་དེ་བདེན་པ་རེད།",
    "མི་ཕལ་པ་བདག་ལྟ་བུས་ཇི་ལྟར་ནུས་བསམས་ཏེ་གཞན་གྱིས་ལེགས་འདུག་ཟེར་ནའང་དེ་འདྲ་ཞིག་རེད་བསམ་པ་དང་།",
    "ཉེས་འདུག་ཟེར་ནའང་དེ་འདྲ་ཞིག་ཡིན་གྱི་རེད་བསམ་པ་ལྟ་བུ་སྣང་མེད་དུ་བཏང་ན་སྐྱོན་མེད།",
    "མི་དགའ་བས་བདག་ལ་མི་གནོད་མོད་འོན་ཀྱང་དེ་ལ་བརྟེན་ནས་དེ་དག་ལས་རྙེད་བ་འཐོབ་བའི་བར་ཆད་བྱེད་བས་བརྙས་བ་དང་སྨད་པ་དང་མི་སྙན་བ་སྨྲ་བ་ལ་ཁྲོའོ་སྙམ་ན།",
    "གཞན་གྱིས་བརྙས་དམོད་བྱས་པ་ན་དེས་དངོས་སུ་རང་ལ་མི་གནོད་ན་ཡང་དེའི་རྐྱེན་གྱིས་གང་ཟག་གཞན་མང་པོ་བདག་ལ་མི་དགའ་བ་འགྱུར་ཞིང་།",
    "འཆི་བའི་ཚེ་ན་སྔར་ལོ་བརྒྱར་བདེ་བ་སྤྱོད་བ་དང་ལོ་གཅིག་ཙམ་བདེ་བ་སྤྱད་པ་གཉིས་འདྲ་སྟེ་གཉིས་ཀ་དྲན་བའི་ཡུལ་ཙམ་དུ་ཟད་ཀྱི་དེའི་ཚེ་བདེ་སྡུག་གི་ཁྱད་པར་ཅི་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "ཞེས་གལ་ཏེ་རང་ལ་གཞན་གྱིས་བརྙས་བཅོས་བྱེད་པའམ་དམོད་པ་ལྟ་བུ་འདི་དག་བདག་མི་འདོད་ན།",
    "བདག་གི་རྙེད་པ་འདིར་འདོར་གྱི།",
    "སྡིག་བ་དག་གི་བརྟན་བར་གནས།",
    "སྒྲེན་མོ་ལག་བ་སྟོང་བར་འགྲོ།",
    "ཁྱོད་ཉིད་ཀྱིས་ནི་སྦྱིན་བྱ་སྟེ།",
    "རང་གི་གཉེན་གྱིས་འཚོ་བ་ངན་ངོན་ཙམ་ཞིག་རྙེད་པར་གྱུར་ན།",
    "ཀུན་ཏུ་དེ་ཁྱོད་ལ་མེད་ན།",
    "གལ་ཏེ་དགྲ་ཁོ་རང་གི་སྦྱིན་བདག་ལྟ་བུ་དེ་ལས་རྙེད་པ་རྣམས་རྙེད་དམ།",
    "ཡང་ན་དགྲ་དེས་རྙེད་པ་མ་རྙེད་པར་སྦྱིན་བདག་གི་ཁྱིམ་ན་གནས་པར་གྱུར་པ་གཉིས་ཀ་ཡང་ཁྱོད་རང་ལ་ནི་ཐོབ་པ་ཅི་ཡང་མེད།",
    "རང་གི་དགྲ་ལ་སྦྱིན་བདག་གིས་རྙེད་པ་བྱིན་རུང་མ་བྱིན་རུང་རང་ལ་ནི་ཁེ་གྱོང་གང་ཡང་མེད།",
    "དེ་ལ་ཁྱོད་དགར་ཅི་ཞིག་ཡོད།",
    "ཁྱོད་ཀྱི་ཡིད་སྨོན་ཙམ་གྱིས་ནི།",
    "གྲུབ་ནའང་ཁྱོད་དགར་ཅི་ཞིག་ཡོད།",
    "ཉོན་མོངས་ཉ་བས་བཏབ་པ་ཡི།",
    "དེ་ལྟར་རང་དང་རང་གི་གཉེན་བཤེས་ཀྱི་འདོད་བའི་གེགས་བྱེད་པ་དང་།",
    "མི་འདོད་བའི་ཕྱོགས་བསྒྲུབས་པ་དང་རང་གི་དགྲའི་ཕུན་སུམ་ཚོགས་པ་ལ་མཐའ་གཅིག་ཏུ་མི་འདོད་བའི་རྣམ་བར་བལྟས་ན་དེ་ལས་ཡིད་མི་བདེ་བ་སྐྱེ་ལ།",
    "འགོག་པའི་གདམས་ངག་ཀྱང་སྔར་བསྟན་པའི་རྒྱལ་སྲས་རྣམས་ཀྱི་རིགས་བ་རང་གི་ཉོན་མོངས་བ་དང་བརྒལ་ལན་བྱས་ནས་ཁ་ནང་དུ་ལོག་སྟེ་དགྲའི་མཆོག་ཁོང་ཁྲོ་འཇོམས་པར་བྱེད་བའི་ཚུལ་འདི་དག་ཡིན་པས།",
    "ཡང་དག་བའི་ལུང་གི་དོན་དྲི་མ་མེད་བའི་རིགས་བས་རྙེད་པའི་གོ་བ་གཏིང་ཚུགས་པ་ལས་སྐྱེས་བའི་མྱོང་བ་ཡིན་པས་བག་ཆགས་ཤིན་ཏུ་བརྟན་པ་ཡིན་ནོ་གསུངས་ཏེ་ཡང་སོ་སོར་རྟོག་བའི་ཤེས་རབ་ཀྱིས་དཔྱད་སྒོམ་འདོར་བ་རྣམས་ནི་འདི་དག་ལ་སོགས་བའི་བྱང་སེམས་ཀྱི་སྤྱོད་བ་རླབས་ཆེན་བོ་ཐམས་ཅད་དོར་བ་ཡིན་པས།",
    "དེ་བཞིན་ཁོང་ཁྲོས་ཕ་རོལ་པོ་ལ་གནོད་མི་གནོད་ཡང་ཐེ་ཚོམ་ལས་མ་འདས་མོད།",
    "རང་གི་ཁྱིམ་མཚེས་དང་ཅུང་ཙམ་མ་འགྲིག་པ་བྱུང་ཚེ་དེ་ལ་ཁོང་ཁྲོ་ལངས་ནས་སེམས་ཧ་ཅང་འཁྲུག་ན།",
    "རང་གི་དགའ་ཉེ་བློ་དཀར་རྣམས་ལ་ཡང་རྒྱུན་དུ་ཁྲོས་ནས་མི་དགའ་བར་བྱེད།",
    "ལུས་ཀྱང་ཇེ་ཞན་དུ་སོང་།",
    "དེ་ལྟར་བྱུང་བ་ན་ཁྱིམ་མཚེས་ཀྱི་འདོད་དོན་འགྲུབ་པ་རེད།",
    "ད་ངའི་གྲོགས་པོའི་བཟོ་ལྟ་ཤོར་ཡོང་གི་འདུག་བསམས་ནས་དགའ་བ་འོང་མི་སྲིད་པ་མིན།",
    "ཁོང་ཁྲོ་བྱེད་མི་དགོས་པར་རང་གི་རྣམ་དཔྱོད་ཀྱིས་དཔྱད་ནས་ངན་པ་ལང་ཤོར་ལ་མི་གཏོང་བར་བྱེད།",
    "གླེན་རྟགས་ཀྱི་སྒོ་ནས་བྱས་པ་དེ་ཕན་ཐོགས་ཡོད་དམ་གནོད་པ་ཡོད་ཧ་མ་གོ་བར་རང་གི་བསམ་ངོ་ལ་ངས་ལན་སློག་པ་ཡིན།",
    "ཁ་གཏད་ལངས་པ་ཡིན་བསམས་ན་ཡང་མཐར་ཐུག་རང་གིས་རང་ལ་གནོད་པ་སྐྱེལ་བའི་ཉེན་ཡོད།",
    "བདེ་བའི་རྒྱུ་ནི་རེས་འགའ་ཞིག།",
    "སྡུག་བསྔལ་མྱོང་ནི་དགོས་ཧ་ཅང་སེམས་མི་སྐྱིད་པ་ཡོང་མི་དགོས་པ་ཞིག་བྱུང་ན་མཁས་པ་རེད།",
    "དེ་ལྟར་མ་ཡིན་པར་བཅོས་སུ་མེད་པའི་སྡུག་བསྔལ་ཐོག་ཏུ་བབ་པ་ན་དེའི་སྟེང་ད་དུང་སེམས་ཁྲལ་བྱས་ན་སྡུག་བསྔལ་སྣོན་པ་རེད།",
    "དེ་མེད་ན་སྡུག་བསྔལ་གཉུག་མ་དེའི་སྟེང་དུ་རང་གི་རྟོག་བས་བསྐྱེད་པའི་སེམས་ཁྲལ་གྱི་སྡུག་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "སྡུག་བསྔལ་གྱིས་ནོན་པ་འདྲ་འདྲ་ཡིན་ནའང་གཅིག་གི་བསམ་བློ་རྒྱ་ཆེ་བས་ནང་གི་བཟོད་སྲན་ཆེ་བ་དང་།",
    "གཅིག་གི་བསམ་བློ་རྒྱ་ཆུང་བས་དེའི་ཁྱད་པར་གྱིས་སྡུག་བསྔལ་མངོན་གསལ་དོད་པོ་ཡོང་མིན་གྱི་ཁྱད་པར་ཡོད།",
    "ལ་ལ་སྡུག་བསྔལ་ལ་གཡོལ་ནས་དེའི་ཕྱོགས་ལ་བསམ་བློ་མ་བཏང་བར་སེམས་གུ་ཡངས་པོ་བྱེད་མཁན་ཡོད་ན་ཡང་དེ་ནི་དགོས་པ་ཆུང་ཆུང་རེད།",
    "སྡུག་བསྔལ་ཕལ་མོ་ཆེ་ཞིག་ནི་སྔར་རང་གིས་བྱས་པའི་ལས་ལས་བྱུང་ལ།",
    "སྐབས་དེར་སེམས་ཀྱི་དཀའ་ངལ་མེད་པ་ཞིག་བྱུང་ན་ཁེ་བཟང་རེད།",
    "བཟེ་རེ་ཆེ་ན་སྡུག་བསྔལ་ཕྲ་མོ་ཤིན་ཏུ་བཟོད་དཀའ་བ།",
    "བཟེ་རེ་ཆུང་ན་སྡུག་བསྔལ་ཆེན་པོ་ཡང་བསྲན་ནུས་བའི་ཕྱིར་ཏེ།",
    "བདག་གིས་བཟེ་རེ་མི་བྱ་སྟེ།",
    "སྡུག་བསྔལ་རང་གི་ཡོན་ཏན་བསམ་པ་དང་།",
    "དེ་དག་དང་དེས་མཚོན་ནས་རང་གིས་ཀྱང་ཡོན་ཏན་གཞན་ཤེས་བར་བྱས་ལ་སྡུག་བསྔལ་འདི་ནི་འདོད་བའི་གནས་སོ་སྙམ་དུ་བློ་ཡང་ཡང་སྦྱངས་ཏེ།",
