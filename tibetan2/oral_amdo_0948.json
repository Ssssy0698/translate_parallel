    "པས་ངན་ལང་ཤོར་ཏེ་ཕྱིན་ཆད་ལས་གང་བྱས་ཀྱང་མཐར་མ་འཁྱོལ་བ་ཤ་སྟག་ཏུ་འགྱུར།",
    "ལས་དང་ཉོན་མོངས་ནུས་བ་སྟེ།",
    "བྱ་བ་གང་བརྩམས་པ་དེ་མཐའ་འཁྱོངས་པ་ཞིག་བྱེད་རྒྱུའི་དོན་དུ་ང་རྒྱལ་གསུམ་དགོས་ལ།",
    "ལས་དང་ཉོན་མོངས་ནུས་པ་སྟེ།",
    "ཞེས་ལས་ཀྱི་ང་རྒྱལ་ཉོན་མོངས་པའི་ང་རྒྱལ་ནུས་པའི་ང་རྒྱལ་ཏེ་ང་རྒྱལ་གསུམ་བསྟེན་དགོས།",
    "འོ་ན་འདིའི་ང་རྒྱལ་དེ་ཉོན་མོངས་པའི་ང་རྒྱལ་ཡིན་ནམ་ཞེ་ན།",
    "འདི་ཉོན་མོངས་འཇོམས་བྱེད་ཀྱི་ང་རྒྱལ་ཡིན་པས་ཉོན་མོངས་པའི་ང་རྒྱལ་མ་ཡིན།",
    "འོན་ཀྱང་གཞན་གྱིས་མི་ཐུབ་པ་ཞིག་ངས་བྱེད་ཐུབ་ཅེས་རང་གིས་རང་ལ་སྤོབས་པ་སྐྱེད་པར་བྱེད་པས་ང་རྒྱལ་གྱི་མིང་གིས་བཏགས་པའོ།",
    "གཞན་སུ་ལ་ཡང་རང་གི་ལམ་བསྒྲུབ་བའི་གྲོགས་ཀྱི་བལྟོས་པ་མི་འཆའ་བར་རང་ཁོ་ནས་བསྒྲུབ་བ་སྟེ།",
    "རང་གི་དོན་ཡང་འགྲུབ་བར་མི་ནུས་ན་གཞན་གྱི་དོན་ལྟ་ཅི་སྨོས།",
    "བདག་གིས་ནི་རང་གཞན་གྱི་དོན་བསྒྲུབ་བར་ནུས་སོ་སྙམ་ནས་བསྒྲུབ་བ་སྟེ།",
    "དེ་བས་བདག་གིས་འདི་བྱའོ།",
    "འོན་ཀྱང་དེ་གཉིས་བསྒྲུབ་བ་ན་གཞན་ཁྱད་དུ་བསད་ནས་རང་ལ་རློམ་པས་བསྒྲུབ་བ་མིན་གྱི་ཞེས་པའི་རློམ་པ་ནི་ཉོན་མོངས་པའི་ང་རྒྱལ་ཡིན།",
    "བརྩེ་བའི་རྣམ་པ་ཅན་དུ་བལྟས་ནས་ང་རྒྱལ་དང་ཉོན་མོངས་པའི་ང་རྒྱལ་གཉིས་མ་འདྲེས་བར་བྱ་སྟེ།",
    "ཉོན་མོངས་བའི་ང་རྒྱལ་ནི།",
    "ཉོན་མོངས་ཁྱད་དུ་གསོད་པར་བྱེད་པས་ཉོན་མོངས་པའི་ང་རྒྱལ་ཡིན་གྱི་ཉོན་མོངས་ཡིན་པར་གྱུར་པའི་ང་རྒྱལ་མིན།",
    "ཉོན་མོངས་བ་རྣམས་ཐམས་ཅད་དུ་ཁྱད་དུ་བསད་ནས་བདག་འདི་དག་ལས་རྒྱལ་བར་བྱ་ཡི།",
    "བདག་གིས་ཕ་རོལ་ཉོན་མོངས་ཀུན་ལས་རྒྱལ་བྱ་སྟེ།",
    "གཉེན་པོ་ཡང་ཁྱོད་ཀྱིས་བསྒོམ་མི་ནུས་པས་ངེད་རང་རྫོགས་པར་བྱེད་ཟེར་ནས་མི་འོང་།",
    "ཉོན་མོངས་པ་ཁོ་རང་ཡང་ཁ་གྱེས་ཤིག་ཟེར་ན་སྡུག་པོ་ཞིག་མ་གཏོགས་མི་འོང་བ་བ་ཡིན།",
    "དེ་ལྟ་མ་ཡིན་བར་སྒྲུབ་བ་བོ་ལྷུང་བས་ཕམ་པར་བྱས་ན་ཁམས་གསུམ་གྱི་ཉོན་མོངས་ལས་རྒྱལ་བར་འདོད་པ་ནི་མཁས་པས་ཁྲེལ་བའི་གནས་ཡིན་ཏེ།",
    "དེ་ནི་ཉོན་མོངས་ལ་ཁྱད་གསོད་བྱས་ནས་འཇོམས་བར་འདོད་བས་ཉོན་མོངས་པའི་ང་རྒྱལ་ཞེས་བཏགས་སོ།",
    "གཞུང་ལ་སྔ་མ་འགྲིག་གམ་སྙམ་མོ།",
    "དེ་ལྟར་ན་གཞན་ལ་རེ་བ་བཀག་ནས་རང་གཅིག་པུས་བྱེད་པར་གོ་བགོ།",
    "རང་གིས་ནུས་སོ་སྙམ་ནས་གདེང་འཆའ།",
    "ཉོན་མོངས་པ་དེས་ཚུར་ལ་ནམ་ཡང་འཇོམས་མི་ནུས་བར་བྱེད་པའི་བློའི་བརྟན་བ་བསྐྱེད་ཅིང་དམ་བཅའ་བར་སྐབས་སུ་འདོར་བའི་ཉེས་དམིགས་བསམ་ལ་ལེགས་པར་བརྟགས་ནས་གང་བྱ་བར་ཡི་དམ་བཅའ་བ་ཐམས་ཅད་ལ་མཐར་འབྱིན་འདོད་ཀྱི་བློ་བརྟན་པོ་མ་རྙེད་ཀྱི་བར་དུ་སྦྱང་བར་བྱའོ་།",
    "དེ་ལྟར་འདུན་པ་དྲག་པོས་མོས་བའི་སྟོབས་ཀྱིས་བརྩོན་འགྲུས་མ་སྐྱེས་བ་བསྐྱེད་ཅིང་།",
    "རྩེད་མོའི་བདེ་འབྲས་འདོད་བ་ལྟར།",
    "གང་གི་ལས་ཉིད་བདེ་འགྱུར་བ།",
    "བརྩོན་འགྲུས་བརྩམས་པས་ལུས་སེམས་དུབ་ན་རེ་ཞིག་ངལ་གསོ་དགོས་ཏེ།",
    "ཡོན་ཏན་སྔ་མ་རེས་ཆོག་ཤེས་བྱས་ན་ཁྱད་པར་གོང་མ་མང་བོ་འཐོབ་བ་ལ་གེགས་ཆེན་པོར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདིས་ནི་བརྩོན་འགྲུས་རྩོམ་ལུགས་བསྟན་ཏེ་ཧ་ཅང་བརྟུན་ངས་ཏེ་རྩོལ་བ་དྲགས་བ་དང་ཧ་ཅང་ལྷོད་བ་གཉིས་ཀ་སྤངས་ནས་ཆུ་བོའི་རྒྱུན་བཞིན་དུ་ན་རེ་བ་ཞིག་དགོས་ཏེ།",
    "ཁྱོད་ལ་ཐང་ལྷོད་འགའ་མ་བྱུང་།",
    "དེ་སླད་ཁྱོད་ཀྱི་ཁྱད་པར་རྣམས།",
    "སེ་མོ་གྲུ་བའི་ར་མདའ་ལྟ་བུས་མི་འོང་།",
    "ཤིག་གིས་སོས་བདལ་ནས་མ་བསྡད་བར་བྱིན་བས་མྱུར་དུ་ཕྱིན།",
    "ལྗི་བས་ཐེབས་རེ་མཆོངས་ཤིང་བསྡད་པས་མ་ཕྱིན་པ་ལྟ་བུའོ།",
    "མཐུན་རྐྱེན་དཔུང་གི་ཚོགས་བསགས་པ་དང་།",
    "གོང་གི་འདི་མཚམས་སྦྱོར་བྱས་ནས་སྔར་གྱི་རྩ་བའི་ས་བཅད་གསུམ་པ་དེ་འདིར་བྲིས་འདུག།",
    "ཉོན་མོངས་མཚོན་ལས་བཟུར་བྱ་ཞིང་།",
    "ཉོན་མོངས་དགྲ་རྣམས་འཇེབས་བར་བརྟག།",
    "འཐབ་མོ་བ་རྙིང་པ་དེ་གང་ཞེ་ན་ཉམས་མྱོང་ཡོད་མཁན་དེའོ།",
    "སྒྲུབ་བ་བོ་ཡང་ཉོན་མོངས་དང་འཐབ་བའི་ཚེ་ཉོན་མོངས་ཀྱིས་ཚུར་སེམས་ལ་རྨ་འབྱིན་པ་ལ་ཟོན་བྱེད་ཅིང་བཟུར་བ་དང་།",
    "ཡང་ན་སེམས་ལ་ཁ་ན་མ་ཐོ་བ་ཆེ་བ་ཞིག་བསྐྱེད་བས་གཉིས་ཀ་མཉམ་པོར་སོང་ནས་དགེ་སྦྱོར་ལ་སྐྱེད་འོང་བར་དཀའ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཉོན་མོངས་དང་འཐབ་བའི་ཚེ་ཡང་གཡུལ་འགྱེད་བའི་དུས་སུ་ལག་ནས་རལ་གྲི་ལྷུང་ན་བསད་ཀྱིས་དོགས་པའི་འཇིགས་པས་ལོང་ཡོད་མི་བྱེད་པར་དེ་མ་ཐག་ཏུ་ལེན་བ་ལྟར།",
    "སྤང་བླང་གི་འཇུག་ལྡོག་གི་དམིགས་རྣམ་མ་བརྗེད་པའི་དྲན་བའི་མཚོན་ཤོར་ན་ངན་འགྲོར་སྙུང་བའི་འཇིགས་པས་དེ་མ་ཐག་ཏུ་དྲན་བ་བསྟེན་དགོས་ཏེ།",
    "ཤོར་ན་ཡང་དེ་མ་ཐག་ཏུ་བསྟེན་བ་ནི་དྲན་པ་ཉམས་པའི་ཚེ་ཉེས་ལྟུང་གིས་གོས་བའི་འབྲས་བུ་ངན་སོང་དུ་ལྷུང་བ་ལ་འཇིགས་པ་ཚིག་ཙམ་མ་ཡིན་བར་རྒྱུད་ལ་སྐྱེས་བ་ལ་ཐུག་གོ།",
    "ཡང་ལས་འབྲས་ལ་མཐིལ་དུ་བྱས་ནས་སྐྱོང་བ་ལ་རག་ལས་བས་འོ་སྐོལ་དེ་དག་ལ་གདམས་པ་ཟབ་མོ་ཡིན་སྙམ་པའི་བློ་མི་སྐྱེ་བ་རྣམས་ལ་ལམ་གྱི་རྐང་དམ་བ་མཁས་པ་མགུ་བའི་སྒྲུབ་བའི་ཡོན་ཏན་རྣམས་ཀྱི་རྩ་བ་ཆད་བ་ཡིན་ནོ།",
    "དུག་མདས་ལུས་ལ་རྨ་ཅུང་ཟད་ཅིག་བཏོད་ན་དེ་ལ་བརྟེན་ནས་རིང་བོར་མི་ཐོགས་བར་ལུས་ཐམས་ཅད་ལ་དུག་རྒྱས་བར་འགྱུར་བས་རྨ་དེ་བཅད་ནས་རྨ་ཁ་དུག་གིས་ཟིན་པ་བཀོག་ནས་འབོར་དགོས་པ་ལྟར།",
    "འོ་ན་ཉོན་མོངས་ཀྱིས་གཡུལ་ལས་རྒྱལ་བར་འདོད་བས་དྲན་པ་དང་ཤེས་བཞིན་ཇི་ལྟར་བསྟེན་སྙམ་ན།",
    "ཉེས་བ་བྱུང་བ་རེ་རེ་བཞིན།",
    "བདག་ལ་སྨད་ནས་རང་གིས་རང་ལ་སྤྱོས་ཏེ་ཅི་ནས་ཀྱང་།",
    "ཁས་བླངས་ནས་མ་བསླབ་བ་ན་ཉེས་དམིགས་ཤིན་ཏུ་ཆེ་བ་དང་ཉོན་མོངས་ལ་དགྲར་བལྟ་ལུགས་དང་།",
    "དེ་ལྟ་བུ་རྣམས་བྱ་དཀའ་ཡང་དོར་མི་རུང་གི་འབད་དགོས་ཏེ།",
    "དེ་སླད་ཉིད་ཀྱི་ལུས་སྲོག་ལའང་མ་གཟིགས་པར།",
    "ལྔ་བ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "དུས་ཆེས་རིང་བ་དང་ཚོགས་མཐའ་ཡས་བ་དང་དཀའ་སྤྱད་དབག་ཏུ་མེད་པ་ལ་སྤྲོ་བའི་གོ་ཆའི་བརྩོན་འགྲུས་བསམ་བས་གྱོན་པ་ལ་ནི།",
    "ཕྱོགས་བཟུང་ནས་ཅི་ནུས་བའི་བརྩོན་འགྲུས་བརྩམས་ན་ལག་བཟང་གིས་ཞུས་པ་ནས་གསུངས་བ་ལྟར།",
    "དེ་དག་གི་དོན་བསྡུས་བའོ།",
    "ཕྱོགས་ཀྱི་སྒོ་ནས་ཞི་གནས་ཀྱི་ཕྱོགས་སམ་ལྷག་མཐོང་གི་ཕྱོགས་སམ་ཟུང་དུ་འབྲེལ་བར་འཇུག་བས་ལམ་དེ་གཉིས་ཀའི་ཕྱོགས་གང་ཡིན་པ་སྟེ།",
    "དོན་བྱ་བ་བཅུ་གཅིག་གི་དོན་རྣམས་བསྒྲུབ་པའི་བསམ་གཏན་ནོ།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "དེ་ཡང་ཇི་ལྟ་བ་བདག་མེད་པའི་ཤེས་རབ་ཡོད་མེད་ཀྱི་ཕན་ཡོན་དང་ཉེས་དམིགས་ནི་ལྷག་མཐོང་གི་སྐབས་ནས་འཆད་པར་འགྱུར་བས་འདིར་མི་སྤྲོ་ལ་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "དབེར་ན་རི་མོའི་ལས་ནི་ཡོངས་ཟིན་མིག་མེད་བ།",
    "ཤེས་རབ་ཀྱི་མགོན་ཡོད་ན་སྦྱིན་པ་དང་དད་པ་ལ་སོགས་བ་རྣམས་ཀྱི་སེར་སྣ་ལ་སོགས་བའི་སྐྱོན་དང་ཡོན་ཏན་ལེགས་བར་ཤེས་ནས་ཉོན་མོངས་ཟད་བ་དང་ཡོན་ཏན་འཕེལ་བའི་ཐབས་ལ་མཁས་པར་འགྱུར་ཏེ།",
    "ཉོན་མོངས་ཟད་པའི་ཚུལ་ལ་མཁས་བར་འགྱུར།",
    "ཁྱོད་བཀའ་ལ་ལར་གཅིག་ཏུ་ངེས།",
    "དམིགས་བུ་ཞེས་པ་ལོང་ཁྲིད་པ་རེད།",
    "ཤེས་བའི་སྐྱོན་གྱིས་ཉོན་མོངས་རྙོག་བཅས་འགྱུར།",
    "བཟོད་པའི་ཡོན་ཏན་དེ་ལ་གནས་མི་མོས།",
    "དེ་བས་རང་གི་མཐུ་རྣམས་ཀུན་གཏུགས་ཏེ།",
    "གྲོགས་ངན་བ་བསྟེན་བ་དང་ལེ་ལོ་དང་སྙོམས་ལས་དང་གཉིད་ཆེ་བ་དང་སོ་སོར་རྟོག་ཅིང་དཔྱོད་བ་ལ་མི་དགའ་བ་དང་རྒྱ་ཆེན་བོ་ལ་མི་མོས་པ་དང་།",
    "ཐུབ་པའི་ཡེ་ཤེས་མཆོག་ལ་མོས་མེད་དང་།",
    "ཟས་ཟ་ཐུབ་ཚོད་ཅིག་ཟ་དགོས་པ་བཞིན་གང་ཐུབ་ཐུབ་ཀྱིས་རང་གི་བློ་དང་འཚམ་པ།",
    "སེར་སྣ་ལ་སོགས་པའི་རྣམ་རྟོག་གང་ཡིན་པ་དེ་ནི་ཉོན་མོངས་པའི་སྒྲིབ་བར་འདོད་པ་ཡིན།",
    "བདག་འཛིན་ཉོན་སྒྲིབ་ཏུ་འདོད་པས་འཁོར་གསུམ་རྣམ་པར་རྟོག་པ་གང་ཟག་གི་བདག་འཛིན་དུ་མ་སྦྱར་ན་མི་འགྲིག་ལ།",
    "སེར་སྣ་ལ་སོགས་པའི་ཉོན་མོངས་པ་དེ་ཉོན་མོངས་པའི་སྒྲིབ་པར་གསུངས།",
    "ཤེས་རབ་དང་ལྡན་ན་ཉོན་མོངས་བ་རབ་ཏུ་ཞི་བར་འགྱུར་རོ།",
    "ཉོན་མོངས་བ་མེད་པ་ལ་བདུད་ཀྱིས་གླགས་མི་རྙེད་དོ།",
    "མི་དགོས་བར་འདུག་སྙམ་པའི་ཕྱིན་ཅི་ལོག་གི་ངེས་པ་རྙེད་བ་འབའ་ཞིག་གི་སྐྱོན་ཡིན་བས།",
    "འདི་ཕལ་ཆེར་ཟུར་ཟ་བྱས་ནས་གསུང་གི་ཡོད་ཚོད་རེད།",
    "ཤེས་རབ་བསྒྲུབ་ཀྱི་ཡིན་ཞེས་ཟླ་བ་གཅིག་ལ་འཇམ་པའི་དབྱངས་ཀྱི་སྔགས་བསགས་ན་ཤེས་རབ་འཕེལ་མི་འཕེལ་ཐེ་ཚོམ་རེད།",
    "དེ་ལས་ཟླ་བ་གཅིག་གི་རིང་ལ་བསྡུས་གྲྭ་སྦྱངས་ན་ཟླ་བ་གཅིག་གི་རྗེས་སུ་ཤེས་རབ་འཕེལ་མི་འཕེལ་ཐེ་ཚོམ་མེད་གསུངས་པ་དེ་དངོས་གནས་བདེན་པ་རེད།",
    "རྗེ་བཙུན་འཇམ་པའི་དབྱངས་བསྒྲུབས་ན་ཤེས་རབ་འཕེལ་གྱི་རེད་ཅེས་མགོ་བཏུམས་ནས་སྔགས་བགྲངས་ན།",
    "ཁྲིད་ཅིག་འདུག་ཟེར་ན་ངས་ཁྲིད་ལ་ཉན་མི་དགོས་ཞེས་ཕལ་ཆེར་རང་ཉིད་ཀུན་མཁྱེན་ཡིན་བསམ་པ་ལྟ་བུར་བྱས་ནས་བསྡད་ན་ནོར་འཁྲུལ་ཆེན་པོ་རེད།",
    "ཡང་འདོད་ཐག་ཐུང་དྲགས་པའི་སྐྱོན་ཡོད་པ་དེ་འདྲ་རེད་མ་གཏོགས་གཞན་དོན་གཉེར་ཡོད་པ་དེ་ལེགས་པོ་རེད།",
    "དེའི་སྐོར་ལ་གཟིགས་ཚུལ་ཆེན་པོ་ཞིག་ཡོད་པ་དེ་ཞར་དང་ཞོར་ལ་ནན་པོ་བྱས་ནས་གསུང་ཡོང་གི་འདུག།",
    "སྒྲུབ་བའི་བསྟན་པ་མ་ནོར་ཐར་འཛིན་པ་ལུང་གི་བསྟན་པ་མ་ནོར་བར་གོ་བ་ལ་རག་ལས་པའི་ཕྱིར་རོ།",
    "དང་བོ་ནས་མི་ཤེས་ན་ཡང་ཞེས་དང་པོ་ནས་གྲྭ་ས་འགྲིམས་ནས་རིམ་པས་ཐོས་བསམ་བྱེད་མ་མྱོང་བ་ཞིག་ཡིན་ན་ཡང་ཞུམ་བར་མི་བྱ་བར་བློ་དང་བསྟུན་བའི་ཐོས་བ་ཆེ་ཆུང་གང་འཐད་རེ་ལ་འབད།",
    "སེམས་ལས་དང་ཐོ་བའི་ཉམས་ལེན་ལམ་གྱི་རིམ་པ་རེ་ལ་ངེས་པར་བརྟེན་དགོས་ལ།",
    "དང་བོ་ཆུང་ཡང་གོམས་པས་ཆེ་བར་སོང་བའི་ཚེ།",
    "རྒྱས་པར་བཀྲལ་ན་བསྟན་པ་མཐའ་དག་ལ་འགྲོ་ཐུབ་བ་ཞིག་དགོས་པས་དེ་འདྲ་ཞིག་མ་རྙེད་བར་དུ་ཉམས་ལེན་གྱི་ཕྱོགས་རེ་ཙམ་ལ་བྲོད་པ་རྙེད་པ་སྲིད་ཀྱི།",
    "ཞེས་གསུངས་པ་ལྟར་གནང་གི་ཡོད།",
    "ཆུ་སྣ་བཞིན་དུ་ཅི་ཟེར་ལ་བདེན་སྙམ་ནས་གར་ཁྲིད་པར་འགྲོ་གསུང་ངོ།",
    "ཤེས་རབ་ཟབ་མོའི་དེ་ཉིད་ལྟ་བའི་མིག།",
    "འདི་ལྟ་བུའི་ཤེས་རབ་དེ་མི་ཐམས་ཅད་ལ་ཡོད་མོད།",
    "འཕགས་མཆོག་གིས་ཀྱང་ཐམས་ཅད་མཁྱེན་ཉིད་མི་འགྱུར་ཏེ།",
    "དེ་ལ་ཐོག་མར་བསྟན་བ་ལ་མ་མོས་པ་རྣམས་ཚར་གཅད་བའི་ཕྱིར་སྒྲ་དང་གཏན་ཚིགས་རིག་བ་དང་།",
    "དེ་དང་ཆབས་ཅིག་གཏན་ཚིགས་རིག་པའི་སྒོ་ནས་མ་མོས་པ་དེ་མོས་པ་བསྐྱེད་དུ་བཅུག།",
    "ལྔ་བ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "ཚེ་གཞན་དུ་ཡང་ལག་བཟང་གིས་ཞུས་བ་ལས་གསུངས་པ་ལྟར་ཤེས་རབ་ཀྱི་ཕར་བྱིན་བདེ་བླག་ཏུ་རྫོགས་བར་བྱེད་ནུས་བའི་ཕྱིར་རོ།",
    "བྱང་ས་ལས་བྱིན་དྲུག་རེ་རེའི་མཐར་ནན་ཏན་དུ་གསུངས་བས།",
    "དེ་ཡང་ཟང་ཟིང་གི་སྦྱིན་བ་བྱིན་ནས་ལུས་ལ་ཕན་འདོགས་པ་ལ་ལྟོས་སོ།",
    "ཁྱོད་རང་ཡང་དོན་དེ་མི་སྒྲུབ་ན་གཞན་ལ་དེ་སྒྲུབས་ཞེས་ཅིའི་ཕྱིར་སྨྲ།",
    "རང་གི་སྒྲུབ་པ་ཞིག་ཡིན་ན།",
    "ལོངས་སྤྱོད་སྤངས་ནས་སློང་མོས་འཚོ་བའི་རབ་བྱུང་ལ་འགོད་པ་སྟེ།",
    "དེ་ནས་བློ་འབྲིང་དུ་སོང་བ་ན་འབྲིང་གི་གདམས་ངག་དང་།",
    "དེ་ལྟར་ཁྱོད་ཀྱི་དགོངས་ནས་དེ་སླད་འགྲོ་བ་མཐའ་དག་ཐུགས་ལ་བཞག་མཛད་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་ཐོག་མར་རང་གི་ཐུགས་རྒྱུད་ལ་སྤངས་རྟོགས་ཡོངས་སུ་མ་རྫོགས་བར་དུ་སྔོན་ལ་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་།",
    "བསྡུ་བ་བཞི་ཡང་ཟང་ཟིང་གིས་བསྡུ་བ་དང་།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་ནི་དང་བོ་ཡིན་ལ།",
    "ཕྱིས་ནས་འབད་བ་ལ་མི་ལྟོས་པར་རང་གི་ངང་གིས་འཇུག་བ་འོང་བས་གོམས་པ་གལ་ཆེ་སྟེ།",
    "གང་ཡང་ཁྱོད་ཉིད་ཀྱིས་ཀྱང་ཡུན་རིང་སྐུ་ཉམས་བཞེས་པར་མི་སྤྱོད་བའི།",
    "ཞེས་བཅོམ་ལྡན་འདས་ཁྱོད་ཉིད་ཀྱིས་དང་པོ་ཉིད་ནས་ལས་སླ་པོ་ཞིག་གི་སྟེང་ལ་ཉམས་བཞེས་གནང་ཐུབ་པ་མ་བྱུང་གསུངས།",
    "དེ་ལྟ་བུའི་སྤྱོད་པ་དེ་དག་ཁྱོད་ལ་གོམས་བས་དུས་སུ་རང་གི་ངང་ཉིད་གྱུར།",
    "བརྩོན་པའི་སྟོབས་བསྐྱེད་དེ་གོམས་འདྲིས་མཛད་པ་ན་ག་ལེ་ག་ལེར་ཁྱོད་ལ་ལས་སླ་པོ་བྱུང་བ་ལགས་གསུངས།",
    "དེ་ལ་བློ་ཇེ་གོམས་སུ་འགྲོ་ཞིང་གོམས་ན་རང་གི་རྒྱུད་ཚོད་མཐོ་རུ་དང་ནུས་པ་ཆེ་རུ་སོང་བ་དེའི་ཚོད་ཀྱིས་ཉམས་ལེན་བྱེད་ཐུབ་པ་ཞིག་ཡོང་ངེས་ཡིན།",
    "བདག་གི་ལུས་དང་ངག་གི་ལས།",
    "རང་གི་ལུས་ངག་སེམས་ནི་རྣམ་དག་རྒྱུ།",
    "རང་དོན་སྒྲུབ་ལ་ནམ་ཡང་མི་རེ་ཞིང་།",
    "ཅེས་ཕ་རོལ་པོའི་ཁམས་དང་མོས་པ་ཇི་ལྟ་བ་བཞིན་མ་ཤེས་ན་ཡང་།",
    "དེ་ལྟ་བུའི་ཐུན་མོང་བའི་མངོན་ཤེས་སྒྲུབ་པ་ན།",
    "ལོ་ནི་སྟོང་ཕྲག་དག་གིས་ཀྱང་།",
    "དེ་ནས་དངོས་གཞི་ཞི་གནས་སྒྲུབ་ཚུལ་གང་འདྲ་རེད་ཅེ་ན།",
    "། རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མ་ནཱ་རོ་མཁའ་སྤྱོད་ཀྱི་སྒྲུབ་ཐབས་ཐུན་མོང་མ་ཡིན་པའི་རྒྱུན་ཁྱེར་ངག་འདོན་བཀླགས་ཆོག་ཏུ་བཀོད་པ་བཞུགས་སོ། ། ནཱ་རོ་མཁའ་སྤྱོད་ཀྱི་བརྒྱུད་པའི་རིམ་པ་ལ་གསོལ་བ་འདེབས་པ་པད་དཀར་བཞད་པའི་དགའ་སྟོན་ཞེས་བྱ་བ་བཞུགས་སོ། ། ན་མོ་གུ་རུ་བཛྲ་ཝཱ་ར་ཧཱི།",
    "ས་བསྟན་ཉིན་མོར་བྱེད་པའི་ནམ་མཁའ་ལེགས།",
    "བསླུ་མེད་སྐྱབས་གནས་གཙུག་གི་ནོར་བུར་བསྟེན།",
    "བྃ་ཡིག་ནང་གི་རྡོ་རྗེ་བཙུན་མོ་མཆོག།",
    "ཉུལ་བས་གང་གི་མཛོད་སྤུར་འཁྱིལ་རིས་ཅན།",
    "ནང་གི་ཕག་མོས་གཟུང་འཛིན་འཁྲི་ཤིང་བཅོམ།",
    "མཆོག་གི་དྷཱུ་ཏིར་ཞུགས་པའི་གར་མཁན་མ།",
    "བདེ་བ་མཆོག་གིས་བདག་རྒྱུད་ཚིམ་པར་ཤོག།",
    "ཐ་མལ་འོད་ཀྱི་གཏུམ་མོ་མཛེས་ལྡན་མ།",
    "འདིར་རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མ་ནཱ་རོ་མཁའ་སྤྱོད་མའི་སྒྲུབ་ཐབས་ཐུན་མོང་མ་ཡིན་པའི་རྒྱུན་ཁྱེར་ངག་འདོན་བཀླགས་ཆོག་མའི་ཚུལ་ནི།",
    "ཁྱེད་རྣམས་ཀྱིས་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "དེའི་ཕྱིར་དུ་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་ལམ་གྱི་རིམ་པ་ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱིའོ།",
    "རང་གི་སྤྱི་བོར་པདྨ་པདྨ་དཀར་པོའི་སྡོང་བུ་ཚངས་བུག་ལ་ཟུག་པ།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
