    "རང་གི་ལུས་དང་།",
    "དྲི་དང་རོ་༧དང་རེག་པ་ད་ང་ལྡན་པ་ཡིད་དུ་འོང་བ།",
    "གང་དག་ཡེ་ཤེས་ཀྱི་མེས་ཉོན་མོངས་པའི་བུད་༢ཤིང་ཐམས་ཅད་མ་ལུས་པར་བསྲེགས་པ། ༐",
    "ཕྲ་བ་གཟིགས་པ།",
    "ངང་མོ་མཚེའུ་ན་སྒྲ་སྐད་སྙན་པ་འབྱིན།",
    "མེ་ཏོག་རྒྱས་པའི་དཔག་བསམ་ཤིང་ཚལ་མཛེས་། མཛེས་པའི་ལྷ་མོ་༢གསེར་གྱི་ཕག་སྐད་དྲུང་།",
    "བན་༨གླང་མོ་རྒྱགས་དྲག་འགྲོ་ལང་ལོང་གྱུར།",
    "སིལ་མ་མོད་པོས་རི་༡༧གཞོལ་སྤྲས།",
    "མེ་ཏོག་ཐེགས་པའི་ཤིང་གི་༡༧ཡལ་གར་གནས་པའི་བུང་བ་དགའ་བས་འཕུར་རྣམས་དང་།",
    "སྦྲུལ་མང་འཁྲིས་༡༨པའི་ཙནྡ་ན་ཤིང་གི་ནགས་ཚལ་ན།",
    "མིའམ་ཅི་ཡི་༡༧བུ་མོ་ཕྲུགས་ཀྱིས་ཉམས་དགའ་ལ།",
    "ཤིང་གི་མེ་ཏོག་འཕྲུལ་༢༡པས་དྲི་ཞིམ་བྱས་པའི་སེར་བུ་ངད་ལྡང་ཞིང་།",
    "བ་གླང་མོས་བསྙོགས་སྣང་བ་རྩུབ་འགྱུར་ཚལ།",
    "ཉིན་རེ་ཉི་མའི་ཤིང་རྟས་རྡོ་༥སྣད་ཅན།",
    "ཁུང་ཚོན་གྱིས་༨ཁ་བསྒྱུར་ཕུག་དང་ལྡན་ཞིང་སྤྲིན་ཀྱང་ཆགས་གྱུར་ལ།",
    "གི་རྡོ་ལས་༥གྲུབ་པའི་ཆུང་མའི་སྐྱེ་བོ་གནས་ཤིང་བྱའི་ཁྱུ་དགའ་སྟེ་སྒྲ་འབྱིན་པས་གླུ་ལེན་པ་ལྟ་བུ་ཡོད་པའི་རྒྱ་མཚོའི་གླིང་དག་ན།",
    "ཁྱོར་བཅས་ལན་༨ཅིག་མ་ཡིན་ར་རོར་གྱུར་པའི་གནོད་སྦྱིན་མོ་དག་གནས་གྱུར་ལ།",
    "ད་བང་ཆེན་རྩེ་མོ་ཡིད་༡༧དུ་འོང་བར་བདེར་གནས་ཏེ།",
    "རྒྱ་མཚོ་རིན་ཆེན་གནས་ལ་རྣམ་པར་གཟིགས་པ་དང་།",
    "ཁྲི་༤ཤིང་གིས་འཁོར་ཞིང་རི་དྭགས་མང་པོ་གནས་པའི་ནགས་ཚལ་དེ་དང་དེ་དག་ན་བཞུགས་པ་རྣམས་དང་།",
    "འཁྲུར་བཅུག་གི་གྲོང་དང་། ༐",
    "དེ་ཡི་གཙུག་གི་རིན་ཆེན་འོད་ཀྱིས་མུན་བསལ་བའི།",
    "ན་བཟའི་ཐ་མས་སྤྲིན་མཐར་༡༧རེག་པས་སྤྲིན་ལིང་འཇིག་༡༧མཛད་དང་།",
    "རང་གི་མཆོད་རྟེན་དང་།",
    "གང་ད་ག་གློག་འགྱུ་བྱ་གག་༢༦དག་གིས་སྐུ་ལུས་བཀྲ་བྱས་སྤྲིན་སྣུམ་འདྲ་གྱུར་ནས།",
    "གང་དག་མི་རོ་མང་པོའི་ཤ་དང་ཁྲག་གི་རོ་བྲོ་བས་དགའ་བར་གྱུར་པའི་༐",
    "རང་གི་མེ་ལྕེས་ཤིང་བཅེར་བ་བསྐམས་ཤིང་རྙིངས་པའི་ལག་པ་དང་།",
    "ཅེ་སྤྱང་གི་སྟོབས་ཀྱི་ཤུགས་ཀྱིས་དྲངས་པའི་ནང་གྲོལ་དྲི་མི་ཞིམ་པའི་དུམ་བུས་འཁོར་ལ་བྱ་ཁྭ་བཀྲེས་པས་མིག་གི་༦ཤ་བྲུས་པ་དག་ལ་གཟིགས་ཤིང་།",
    "མི་རོ་བོར་བའི་ལུས་ལ་གཟིགས་པར་གྱུར་པ་དང་།",
    "སྒོ་དང་སྲང་བར་ལ་ལར་མེ་འབར་མེ་ལྕེའི་རྩེ་མོ་མང་པོས་མགོ་རྨོངས་ཤིང་།",
    "ས་ཧ་ཀ་༨ར་བསྐྱོད་པས་ཆུ་དྲི་ཞིམ་པོར་གྱུར་པའི་མཚེའུ་འགྲམ་ན་ཤིང་ལ་སྤྲེའུ་འི་༩ཁྱུ་གནས་པ་ཉེ་འཁོར་གྱི་རི་ལས་ཆུ་རླབས་མི་དྲག་༡༧པར་འབབ་པས་འཁོར་ནས་ནེའུ་གསིང་མོད་པའི་ས་གཞི་ཡོད་པའི་འབྲོག་དག་ན་ཞི་བའི་བད་ག་ཉིད་ཅན་འཆག་པ་དང་ཀློག་པ་དང་ཁ་ཏོན་དང་།",
    "ཕག་རྒོད་ཀྱི་སྣས་རློག་༢པའི་གླ་སྒོང་༢གི་རྩ་བ་འཛིངས་པ་རལ་པ་ལྟར་འདུག་པ་ཡོད་པ་ཤིང་ནི་ཙུ་༤ལའི་མེ་ཏོག་བྲུལ་༐",
    "ཤིང་གི་ཕྱོགས་སུ་རི་དྭགས་ཀྱི་ཁྱུ་འདམ་རྫབ་ལ་ཐོགས་པ་ཡོད་པ།",
    "ཐུགས་བསམ་གཏན་ལ་ཞེན་པས་དཔག་བསམ་གྱི་ཤིང་གི་ལྕུག་༐",
    "མའི་རྩེ་མོས་༩རེག་པའི་རི་སྤོས་ཀྱི་ང་ད་ལྡང་གི་སུལ་ན་རྩོལ་བ་མེད་པ་གང་དག་བཞུགས་པ་དང་།",
    "ཆུ་འདུས་ཏེ་འབབ་པ་ཡོད་པ་གཡོས་པས་སྟེང་གི་རྩེ་མོ་ལྡེམ་པའི་སྔགས་༡༧ཀྱིས་སྐར་མའི་ཚོགས་འཕངས་པ།",
    "སའི་སྟེང་ན་ལྕི་བ་ལྷུན་པོ་ཡང་ལྕུག་ཕྲན་ལ་བྱ་བ་བཞིན་དུ་སྒྲིམ་མི་དགོས་པར་ཞབས་ཀྱི་སོར་མོས་སའི་འོག་གི་རྨང་དང་བ་ཅས་པ་༡༨གསལ་བར་འཕེན་པ་ད་ག་དང་།",
    "ནང་དུ་རྩ་༢༡སྔོན་པོ་སྟུག་པོ་སྐྱེས་པའི་འཇག་མའི་དྲུང་གི་གསེབ་ན་ཕྱེ་མ་ལེབ་རྒྱུ་བ་ཡོད་ཅི་ང་།",
    "གང་དག་གཡག་གི་༡རྨིག་པས་རྡོ་བ་ཅག་ཡོད་ཅིང་སྤྲིན་ལྡིངས་ལྡན་གྱུར་ལ། ༐",
    "གང་ས་རི་དག་གི་ལྟོང་ན་འགྲོ་བ་ཤིང་གི་དྲུང་དུ་བཞུགས་པར་དགྱེས་པ་དང་།",
    "རྒྱ་མཚོ་ལ་ཡང་མཚན་མོ་བརྟན་པ་གང་ད་ག་འཆག་མཛད་པ།",
    "དེ་དག་སང་གི་གདུགས་ནི་ནམ་གྱི་གུང་དུ་ཕྱིན་པ་ན། ༐",
    "ལེགས་པར་སྤྱད་པ་སྟོང་གི་ཚོགས་བསགས་པས་གྲགས་པ་རྒྱ་ཆེ་བ་དང་ལྡན་པ།",
    "སྐྱེ་བོ་ཕན་ཕྱིར་ཐུབ་རྣམས་སོང་༢འདིར་གཤེགས་སུ་གསུ་གསོལ།",
    "ལུས་དང་ངག་དང་ཡིད་ཀྱི་འཇུག་པ་ཞི་བ་དང་ལྡན་པ་དེ་དག་ཀྱང་མ་ལུས་པར་ཅི་བདེར་དོ་མོད་ཀྱི་མཚན་མོ་ཟད་པར་མཛོད་ལ།",
    "ཐུབ་པའི་སྲས་མོ་ཤེས་རབ་ཞི་དང་དུལ་བས་བརྒྱན་པའི་དགེ་སློང་མ།",
    "ཐོས་པས་ཤིན་ཏུ་ཆེ་བའི་འཕགས་པའི་དགེ་སློང་གི་ད་གེ་འདུན་འདུས་པ་ལ་གསོལ་བ་འཚལ་ལ་ལོ།",
    "སེན་མོའི་འོད་ཀྱིས་ཁྱབ་པ་རྒྱལ་བའི་ཕྱག་གིས་བསྐྱབ་༥པར་ཤོག།",
    "༡༨པེ་གིས་༡༧པེ་སྣར་ཐར།",
    "༡༡༥ ༡པེ་སྣར་གི།",
    "༡༨པེ་སྣར་མོང་།",
    "༡༡༩ ༡པེ་སྣར་གིས།",
    "བཱ་རཱ་ཎ་སཱིའི་ལྗོངས་ཀྱི་སྐྱེ་བོའི་ཚོགས་རྣམས་ལ་རྩེད་མོས་མཛད་ནས་ཁ་ཆེར་གཤེགས་པ་ཡིན་ན་ནོ།",
    "དེར་འོངས་ནས་ལོ་ལྔའི་བར་དུ་དགེ་སློང་འབུམ་ཕྲག་གསུམ་ལ་སྟོན་མོ་བྱས་ཏེ།",
    "ཇི་ཙམ་ན་བྱང་གི་ལམ་ནས་རྒྱལ་པོ་ཀ་ནིངྐ་ཞེས་བྱ་བ་འཕགས་པ་སེང་གེ་བལྟ་བའི་ཕྱིར་ཁ་ཆེར་ཞུགས་སོ།",
    "ན་མ་འཇིག་རྐྱེན་ནི་གང་གིས་འཇིག་པར་འགྱུར་སྙམ་དུ་ཐེ་ཚོམ་སྐྱེས་ས་སོ།",
    "ནམ་འཇིག་རྐྱེན་གང་གིས་འཇིག་༢པར་འགྱུར་བ་ལགས།",
    "བུ་ཁྱོད་ཀྱིས་ལི་ཡུལ་ལ་སོགས་པའི་སྐྱེ་བོ་མང་པོའི་དོན་དང་།",
    "སློང་མོ་བ་རྣམས་ཀྱིས་འཚོ་བར་བྱེད་ད་དོ།",
    "རྩ་འཇིང་ཡང་ཚོལ་བར་བྱེད་པར་འགྱུར་ཏེ།",
    "རྐང་འགྲོས་ཀྱང་ཚོལ་བར་བྱེད་ད་དོ།",
    "རྒྱུ་དེས་ན་ལི་ཡུལ་ལ་སོགས་པར་གནོད་པ་སྣ་ཚོགས་འབྱུང་ཞིང་ལོ་རེ་བཞིན་དམའ་བར་འགྱུར་ཏེ།",
    "དེ་ནས་ལི་ཡུལ་ལ་སོགས་པར་དགེ་སློང་གི་གནས་སྔོན་རྒྱལ་པོ་ལ་སོགས་པ་དད་པ་ཅན་གྱིས་བྱས་པ་ཡང་བློན་པོ་ལ་སོགས་པ་དད་པ་མེད་པ་རྣམས་ཀྱིས་བཙན་༐",
    "བློན་པོ་ལ་སོགས་པ་དེ་དག་གིས་དགེ་སློང་གི་ཞིང་ཆུ་དང་།",
    "ནང་གི་གཡོག་༨རྣམས་ཀྱང་དགེ་སློང་གི་ངག་མི་ཉན་ཅིང་གཉའ་རེངས་སུ་བྱེད་པར་འགྱུར་ར་རོ།",
    "ཐབས་ནི་གང་གིས་འཚོ་བར་བྱ་ཞེས་༐",
    "ཡུལ་ཉེ་བ་གཞན་དང་གཞན་ན་ནི་དད་པ་མེད་པ་དག་གིས་གང་།",
    "དབྱར་ཟླཱ་བ་གསུམ་འདས་ན་ས་འདི་སྐད་དུ་ཡུ་བུ་རྣམས་བྱིན་གྱིས་བརླབས་༢པའི་ཡུལ་འདི་བལྟས་ལ་འགྲོ་བར་བྱའོ་ཞེས་སྨྲས་ཏེ་སོང་ནས།",
    "གསེར་ཕོར་ཆེན་པོ་མུ་ཏིག་གིས་གང་བ་ཞིག་བྱུང་བ་དང་དེ་ཡང་བླངས་ཏེ་འབྲུར་བསྒྱུར་ནས་ཕྱོགས་དེར་རྒུན་༦ཟླ་བ་གསུམ་གནས་པའི་འཚོ་བ་སྦྱར་ཏེ།",
    "དེ་ནས་དཔྱིད་བྱུང་སྟེ་འགྲོ་བའི་དུས་ལ་བབ་ནས་སོང་སྟེ།",
    "ཉི་མ་རེ་རེ་ཞིང་གཙུག་ལག་ཁང་༩དག་ཏུ་གདུགས་ཚོད་གསོལ་བར་འགྱུར་ར་རོ།",
    "གཞོན་ནུ་རྣམས་ནི་རྒྱང་ནས་ལྟ་ཞིང་གད་མོས་འདེབས་པ་དང་གྲོགས་བྱེད་པར་༢འགྱུར་ར་རོ།",
    "དེ་དག་གི་མདུན་དུ་ལྷགས་༨ནས་འཕགས་པ་རྣམས་བཟོད་པར་བཞེས་ཤིག་ཅེས་༐",
    "དེ་ནས་དགེ་སློང་རྣམས་མེ་སྐར་གྱི་ལམ་དུ་ཞུགས་ཏེ་སོང་བ་དང་།",
    "ད་གི་འདུན་དང་ལྷན་ཅིག་ཏུ་མི་དགའ་བའི་ཡིད་ཀྱིས་ཕྱིར་བྱིན་གྱིས་༢བརླབས་པའི་ཡུལ་དང་།",
    "དེ་ལྟར་སོང་བ་དང་དེའི་ཚེ་རྣམ་ཐོས་ཀྱི་བུ་དང་།",
    "སྣལ་ཆུ་ཅན་ཅིག་ཏུ་སྤྲུལ་ན་ས་དགེ་སློང་དེ་དག་གི་དྲུང་དུ་འོངས་པ་དང་དགེ་སློང་རྣམས་ཀྱིས་༩དེ་མཐོང་ནས་གཡག་འདི་ནི་མིའི་ཁལ་གཡག་ཅིག་ཡིན་ཏེ།",
    "འདིའི་ཕྱི་བཞིན་སོང་ན་གདོན་མི་ཟ་བར་མི་རྣམས་དང་ཕྲད་པར་འགྱུར་བས་ད་ནི་མི་འཆིའོ་སྙམ་དུ་ཡིད་སོས་ཏེ།",
    "བཙུན་མོ་དེས་ཉི་འོག་གཞན་ནས་དགེ་སློང་མང་པོ་བོད་ཀྱི་ཡུལ་དུ་ལྷགས་པར་མཐོང་ནས།",
    "བདེ་བར་གཤེགས་པའི་བསྟན་པ་ནི་དེ་འུ་རེ་༐",
    "དེ་ནས་བཙུན་མོ་དེས་རྒྱལ་པོ་ལ་འདི་སྐད་དུ་དགེ་འདུ་ན་དེ་རྣམས་བདག་གིས་བཞོན་པ་དང་གོས་ལ་སོགས་པའི་ཡོ་བྱད་སྦྱར་ནས་འདིར་སྤྱན་༐",
    "དེའི་ཚེ་བོད་ཀྱི་ཞང་བློན་རྣམས་ཁྲོས་འཁྲུགས་ཏེ་འདི་སྐད་ཅེས་བདག་ཅག་༤གི་ཡུལ་འདི་སྔོན་གྱ་ནོམ་པ་ལས་ཕྱིས་མི་བཀྲ་མི་ཤིས་པ་འཁྱམས་པ་ཤ་སྟག་འདིར་ལྷགས་ནས་ད་ནི་ཡུལ་དུ་ཡང་འདི་ལྟ་བུ་གནོད་པ་རྣམ་པ་སྣ་ཚོགས་༥བྱུང་བར་འགྱུར་གྱིས།",
    "དེའི་ཚེ་བོད་ཡུལ་གྱི་དགེ་སློང་རྣམས་ཀྱང་ཡི་ཆད་ནས་ཉི་འོག་གི་༡དགེ་སློང་རྣམས་དང་གྲོས་གཅིག་ཏུ་༐",
    "དེའི་ཚེ་བོད་ཀྱི་དམག་གིས་རྗེས་བཞིན་བསྙགས་ནས་ལམ་ཀར་བྲན་གཡོག་དང་།",
    "དེ་ལྟར་དགེ་སློང་དེ་དག་བོད་ཀྱི་དམག་གིས་བདས་ནས་ཀླུའི་རྒྱལ་པོ་ཨེ་ལའི་འདབ་ཀྱི་གནས་དྲུང་དུ་ཕྱིན་པ་དང་།",
    "དགེ་སློང་རྣམས་ཀྱིས་འདི་སྐད་དུ་བདག་ཅག་གི་ཡུལ་ན་དད་པ་མེད་པ་ཤ་སྟག་གིས་གང་བས་འཚོ་བའི་ཡོ་བྱད་ལ་སོགས་པས་ཕོངས་ཏེ།",
    "མཚོ་འདིའི་ནང་ན་ཡང་བདག་གི་འཁོར་གཏུ་མ་པོ་དད་པ་མ་མཆིས་པ་དུ་མ་ཞིག་མཆིས་པས་བདག་གིས་ཕྱིར་བཟློག་པར་མི་ནུས་ཏེ།",
    "དེའི་ཚེ་དགེ་སློང་ཕོ་མོ་མང་པོ་དེ་དག་ཐམས་ཅད་འདི་སྙམ་དུ་བདག་ཅག་རྣམས་འཆི་བའི་དུས་ལ་བབ་པ་འདྲ་སྙམ་ནས་ངུ་ཞིང་མྱ་ངན་བྱེད་པར་འགྱུར་ར་རོ།",
    "བདག་གིས་སྔོན་བདེ་བར་གཤེགས་པའི་བསྟན་པ་ཐོག་མར་ལེགས་པར་མ་བསྲུངས་པར་ཆ་ད་པར་སྲོག་གིས་གོད་པ་ཞིག་གཅོད་པར་འཚལ་ལོ་ཞེས་སྨྲས་པར་འགྱུར་རོ།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་དེས་རང་གི་ལུས་སྦྲུལ་ཆེན་པོ་ཞིག་གི་༦གཟུགས་སུ་བསྒྱུར་༧ནས།",
    "བོད་ཡུལ་ངོས་ཀྱི་རི་འི་རྩེ་མོ་ལ་ནི་མགོས་འཁྱུད།",
    "ཡུལ་གན་དྷ་ར་འི་རིའི་༨རྩེ་མོ་ལ་ནི་མཇུག་མས་འཁྱུད་དེ་ལུས་ཀྱི་ཞེང་དུ་ནི་ཤིང་རྟ་ལྔའི་ཁྱོན་ཙམ་གྱི་ཟམ་པར་བཏགས་སོ།",
    "དེའི་ཚེ་དགེ་སློང་དེ་དག་གིས་༩སྦྲུལ་ཆེན་པོ་དེའི་གཟུགས་དེ་མཐོང་ནས་སྔངས་སྐྲག་སྟེ།",
    "བདག་གི་༡༧ལུས་འདི་ཁྱེད་ཀྱི་སླད་དུ་ཟམ་པར་བཏགས་པ་ལགས་ཀྱིས།",
    "རྒྱལ་པོ་དེ་ཤི་བའི་འོག་ཏུ་རྒྱལ་པོ་དེའི་བུ་དད་པ་ཅན་ཞིག་དང་དད་པ་མེད་པ་ཞིག་རྒྱལ་སྲིད་ལ་བརྟོད་༨ནས་དམག་གི་གཡུལ་བཀྱེ་ནས།",
    "གི་ནང་ན་༦དགེ་སློང་དཔའ་བ་བརྟུལ་ཕོད་པ་ཚམ་ཚོམ་མེད་པ་སྟོང་ཞིག་ཡོད་པས་རྒྱལ་བུ་དད་པ་མེད་པ་དེ་དམག་གིས་བཏབ་སྟེ་ཕམ་པར་བྱས་ནས་རྒྱལ་བུ་དད་པ་ཅན་དེ་ལ་རྒྱལ་སྲིད་འབུལ་བར་འགྱུར་རོ།",
    "དེའི་ཚེ་ཡུལ་གན་དྷ་རའི་བློན་པོ་དང་ཡུལ་མི་ཐམས་ཅད་འདུས་ཏེ་གསང་ས་༡ནས་ཅིའི་ཕྱིར་ཉི་འོག་གི་མི་བདག་ཅག་གི་ཡུལ་དུ་བྲོས་པ།",
    "ཏ་ཟིག་གི་༦རྒྱལ་པོ་བྱེད་པར་འགྱུར་རོ།",
    "དེ་བཙས་པའི་ཚེ་ཁྲག་གི་ཆར་པ་ཡང་༡༨འབབ་ལག་པ་གཉིས་ཀྱང་གྲུ་༢༦མོ་མན་ཆད་ཁྲག་གིས་བསྐུས་པ་ལྟ་བུར་དམར་བ་ཞིག་ཡིན་ནོ་དེའི་བློན་པོ་ཡན་ལག་མཆོག་དང་ལྡན་པ་ལྔ་བརྒྱ་དང་དམག་མི་༡༧གཡུལ་ངོར་དཔའ་བ་ཉིས་འབུམ་བྱུང་༡༨བར་འགྱུར་རོ།",
    "ཏ་ཟིག་གི་རྒྱལ་པོ་ལ་སོགས་པ་གསུམ་ཡུལ་དབུས་ཀོ་ཤཱམྦཱིར་སོང་ནས་རྒྱལ་པོ་བཟོད་དཀའ་ཚོལ་བར་བྱེད་དོ།",
    "དེ་སྐད་༡ཐོས་ནས་དམག་དང་ཆས་ཏེ་རྒྱལ་པོ་དེ་ད་ག་གི་མདུན་དུ་བསྒུགས་ནས་ཟླ་བ་གསུམ་གྱི་བར་དུ་རྒྱུན་དུ་གཡུལ་ཆེན་པོ་སྤྲད་པ་དང་།",
    "རྒྱལ་པོ་བཟོད་དཀའ་དམག་ད་ང་བཅས་པ་སླར་ཡུལ་དུ་འཁོར་ནས་རྒྱལ་པོ་དེ་འདི་སྙམ་དུ་བདག་གིས་༢མི་མང་པོ་ཁ་བཏགས་༢ན།",
    "བདག་གི་འགྲོ་བ་ནི་ཇི་ལྟ་བུ་ཞིག་ཏུ་སྐྱེ་བར་འགྱུར།",
    "དེས་ལྷ་ཁྱོད་ཀྱི་ལས་ངན་པ་དེ་བཤགས་པར་འགྱུར་རོ་ཞེས་སྨྲ་བར་འགྱུར་ལ།",
    "དགེ་སློང་དེས་ཀྱང་འདི་སྐད་དུ་རྒྱལ་པོ་ཁྱོད་ཀྱིས་ཤིན་ཏུ་མ་ལེགས་པ་བྱས་ཀྱི་ཆེ་ཐང་དུ་འགྱོད་ལ།",
    "འཛམ་བུའི་གླིང་༦གི་དགེ་སློང་ཐམས་ཅད་འདིར་སྤྱན་དྲོངས་ལ་རྟག་ཏུ་ཡོ་བྱད་ལྔ་ཕུལ་ཏེ།",
    "ཁྱོད་ཀྱིས་མི་མང་པོ་ཁ་བཏགས་༨པའི་ལས་བསྲབས་པར་འགྱུར་རོ་ཞེས་སྨྲ་བར་འགྱུར་ར་རོ།",
    "དེ་ནས་དེའི་ཚེ་དགེ་སློང་དེ་དག་གི་ན་ང་ན་༥དགྲ་བཅོམ་པ་༐",
    "སུ་ཏ་ར་༦ཞེས་བྱ་བ་ལང་ས་ནས་སེང་གེ་ལྟ་བུའི་སྐད་ཀྱིས་དགེ་སློང་ཤིར་ཤ་ཀ་ལ་༧འདི་སྐད་ཅེས་ཁྱོད་ཅིའི་ཕྱིར་དེ་སྐད་ཅེས་སྨྲ་ཁོ་བོ་ནི་བདེ་བར་གཤེགས་པས་བཀའ་སྩལ་པ་བཞིན་༨བསླབ་པ་ཅིག་ཀྱང་མ་ཉམས་སོ་ཞེས་སྨྲས་པ་དང་།",
