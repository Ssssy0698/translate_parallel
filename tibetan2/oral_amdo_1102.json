    "གན་དྷ་ར་ཆེན་པོའི་ཡུལ་དུ་འགྲོ་བར་ཆས་ཏེ་སོང་ང་ངོ།",
    "ལ་ལར་ནི་རལ་ཏེ་རྣག་ཁྲག་གི་ཐིགས་པ་ཆ་ར་བཞིན་དུ་ཟགས་པས་མཚོ་ཡང་ཁྲག་ཅན་དུ་བྱས་ས་སོ།",
    "བན་དེ་གཅིག་གིས་རྒྱལ་པོ་བསད་ནས་རྒྱལ་སྲིད་བན་དེས་༐",
    "དེ་ནས་ཀོ་ཤཱམྦཱིའི་རྒྱལ་པོས་དམག་མང་པོ་བསད་པའི་སྡིག་སྦྱང་བའི་ཕྱིར་འཛམ་བུའི་གླིང་གི་དགེ་སློང་རིལ་སྤྱན་དྲངས་ནས་ཀོ་ཤཱམྨིའི་ཡུལ་དུ་ཕྱིན་པའི་རྗེས་༢།",
    "རྣམ་ཐོས་ཀྱི་༢བུས་སྣག་གི་རི་དྲིལ་ཏེ་ཆབ་ཕོ་ནས་དོགས་གདའ་པ་དང་།",
    "སཱ་ལ་༢ཟུང་གི་འོག་ཏུ་མྱ་ངན་ལས་འདས་པའི་སར་མཆོད་རྟེན་ཆེན་པོ་གཅིག།",
    "ཁ་རེའུ་སྟེང་ཞེས་བགྱི་བ་ལ་སོགས་པ་༩དྲང་སྲོང་མང་པོའི་༡ཡུན་མི་རིང་བ་ཞིག་ཏུ་ལི་ཡུལ་ཕྱོགས་ཀྱི་རི་རྩ་༡༧དག་ན་གནས་ཏེ།",
    "འདའ་བར་༤བསྟན་པ་ཉེ་བ་ཞིག་གི་དུས་ན།",
    "རྒྱལ་པོ་མ་སྐྱེས་དགྲའི་བུ་མོ་དྲི་མ་མེད་པའི་འོད་ད་དང་།",
    "ལྷའི་བུ་མོ་བློ་རབ་བརྟན་ད་ང་།",
    "ལྷ་མོ་འཕྲོག་༦མ་ལ་སོགས་པ་འཁོར་དང་བཅས་པ་ལ་གཏད་ནས་བཅོམ་ལྡན་འདས་ཉིད་ཀྱང་འཁོར་རྣམ་བཞི་འབུམ་ཕྲག་དུ་མ་དང་ནམ་མཁའ་ལ་ལྡིངས་ནས་ལི་ཡུལ་དུ་གཤེགས་ཏེ།",
    "པདྨ་རེ་རེའི་ཁར་ཡང་མེ་མར་ཁ་རེ་རེ་བྱུང་དེ་ནས་འོད་ཟེར་དེ་དག་གཅིག་ཏུ་འདུས་ནས་ཆབ་ཀྱི་སྟེང་དུ་གཡས་ཕྱོགས་སུ་ལན་གསུམ་བསྐོར་ནས་ཆུའི་དཀྱིལ་དུ་ནུབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་མོ་དྲི་མ་མེད་པའི་འོད་ད་དང་།",
    "ལྷ་མོ་ལྕགས་ཀྱུ་ཅན་འཁོར་སྟོང་ཕྲག་བཅུ་དང་།",
    "ལྷ་མོ་གནས་ལྡན་མ་འཁོར་ལྔ་སྟོང་དང་།",
    "རིགས་ཀྱི་བུ་མོ་དྲི་མ་མེད་པའི་འོད་ད་དང་།",
    "ལྷ་མོ་འཕྲོག་མ་འཁོར་ད་ང་བ་ཅས་པ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་དམ་ཚིག་བཅས་ནས་ལི་ཡུལ་བསྲུང་བར་ཞལ་གྱིས་བཞེས་ཏེ།",
    "ཕྱུང་ནས་དྲོ་དགོངས་ཤིག་༤བཏབ་པའི་ནུབ་མོ་རྒྱལ་པོའི་བཙུན་མོ་དམ་པ་ལས་ཁྱེའུ་མཚན་ད་ང་ལྡན་པ་བཟང་པོ་ཞིག་བཙས་ནས།",
    "སྔོན་རྒྱལ་པོའི་བཙུན་མོས་༢དེ་ཀུན་དགའ་ར་བའི་སྐྱེད་མོས་ཚལ་དུ་མཆིས་པ་ལས།",
    "རྫིང་བུའི་ནང་དུ་༦ཁྲུས་བགྱིད་ཅིང་མཆིས་པའི་དུས་ན་རྣམ་ཐོས་སྲས་འཁོར་དང་བ་ཅས་པ་ནམ་མཁའ་ལ་གཤེགས་པས་ཀྱང་༧གཟིགས།",
    "རྒྱལ་པོའི་བཙུན་མོས་ཀྱང་རྣམ་ཐོས་སྲས་༨ཀྱི་སྲས་བྱད་བཞིན་བཟང་པོ་མཐོང་བས་སེམས་ཀྱི་བུར་ཆགས་པས་ཀུས་པོ་༩ཡེན་དུ་བ་ཙ་ས་ནས་༢༢།",
    "དེ་ནས་རྒྱ་རྗེས་བུ་དེ་གསོས་༢ནས་སླད་ཀྱི་༢ཁྱེའུ་ཆེན་པོར་སྐྱེས་ནས་རྒྱའི་བུ་སྤུན་ད་ང་བྱིས་པ་རྩེ་རྩེ་བ་ལས་འཐབས་ནས་ཁྱོད་རྒྱ་རྗེའི་བུ་མ་ཡིན་ནོ་ཞེས་བགྱིས་པ་ད་ང་།",
    "རྒྱ་རྗེའི་ཞལ་ནས་ཁྱོད་ངའི་བུ་ཡིན་ཏེ།",
    "ཅག་གི་༤རྒྱལ་བུ་ས་ནུའི་ཡུལ་སར་རུང་ངོ་ཞེས་མཆིད་༥གྲོས་སུ་འཚལ་ནས་ཡུལ་ས་དེ་ལྟ་ཞིག་༦མཆིས་མཆིས་པ་དང་།",
    "ཡ་ཤས་ཀྱང་རྒྱལ་བུ་ས་ནུ་མེ་སྐར་ན་མཆིས་པའི་སྟེང་དུ་ཕོ་ཉས་འཕྲིན་༨པ་ལས་ཁྱོད་ནི་རྒྱལ་རིགས།",
    "ཁྱོད་ཀྱིས་ནི་རྒྱལ་པོ་བྱས།",
    "བདག་གིས་༩བློན་པོ་བྱས་ཏེ་འུ་ཐེན་གྱི་ལྗོངས་འདིར་ཡུལ་སར་བཙུགས་ན་རུང་ངོ་ཞེས་༐",
    "དཔལ་གྱི་ལྷ་མོ་བྱུང་ནས་བཤུག་༢༢ཏེ།",
    "དཔལ་གྱི་ལྷ་མོ་བཞུགས་པའི་སྟེང་ཁང་རེ་རེ་ཞིང་༡༨བརྩིགས་པ་ཡང་དེང་སང་གི་བར་དུ་མཆིས་ཏེ།",
    "འབངས་འཁོར་ད་ང་བ་ཅས་པ་ཀུན་གྱིས་ཀྱང་ཙར་མར་གཙུག་ལག་ཁང་རེ་རེ་བརྩིག་༢པར་གསོལ་ནས་བརྩིགས་༢པ་མང་པོ་ཞིག་བྱུང་བ་ལས་རྒྱལ་པོས་བསམས་པ།",
    "དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་མངོན་སུམ་དུ་གཤེགས་པའི་ད་ན་༥རྟགས་སུ་གོར་མ་ལ་ཞབས་ཀྱིས་བཅགས་པའི་རྗེས་ད་དུང་གི་བར་དུ་ཙར་མ་ན་མཆིས།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱ་གར་ཡུལ་ནས་འཕགས་པ་དགྲ་བཅོམ་པ་བུདྡྷ་དུ་ཏ་དང་།",
    "ཀྱེ་རྒྱལ་པོ་ཁྱོད་སང་ས་རྒྱས་ཀྱིས་ལུང་བསྟན་པ་བཞིན་འདིར་གཙུག་ལག་ཁང་གཅིག་བརྩིགས་༡༧པ་རིགས་སོ་ཞེས་བགྱིས་པ་དང་།",
    "དེ་ནས་རྒྱལ་པོས་མཆོད་རྟེན་འདི་གང་གི་༥དུས་ན་སུས་བརྩིགས་ཞེས་སྨྲས་པ་ད་ང་།",
    "ལི་ཡུལ་དུ་དགྲ་བཅོམ་པར་གྱུར་པ་འདི་ལས་སྔ་བ་མ་བྱུང་བས་འདི་ནི་ལམ་སྟོན་པའོ་ཞེས་མོ་རྒུ་བདེ་ཤི་བྱ་བར་བཏགས་ཏེ།",
    "ཐོག་མ་མོ་རྒུ་བདེ་ཤིའི་མིང་ནི་དེ་ནས་བྱུང་སྟེ་དེང་སང་གི་བར་དུ་ཡང་ཐུབ་ལྡན་དང་།",
    "མོ་རྒུ་བདེ་ཤིར་བསྒོ་བ་ལགས།",
    "ཡོན་བདག་འཕགས་པ་ཤ་སྟག་གིས་མཛད་ལ།",
    "གཙུག་ལག་ཁང་གི་སྲུང་མར་ཞལ་གྱིས་བཞེས་པ་ཡང་རྣམ་ཐོས་ཀྱི་སྲས་ད་ང་།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་ཛ་ཡ་ཞེས་བགྱི་བས་རྒྱ་རྗེའི་བུ་མོ་པུ་ཉེ་ཤྭ་ར་ཞེས་བགྱི་བ་མཆིས་འབྲང་༡༧དུ་བླངས་ནས་རྒྱ་༡༨རྗེའི་བུ་མོ་དེས་ལི་ཡུལ་དུ་སྲིན་བུའི་ས་བོན་ཞིག་འཚལ་ཏེ་མཆིས་ནས་ཡུལ་༐",
    "སྲིན་བུ་མ་ཚར་བའི་སྐབས་སུ་བློན་པོ་རྒྱུས་མ་འཚལ་བ་ཁ་ཅིག་གིས་རྒྱལ་པོ་བི་ཛ་ཡ་ཛ་ཡ་༐",
    "རྒྱ་རྗེའི་བུ་མོ་༡༨ཏྲ་རྒྱལ་པོའི་བཙུན་མོ་བགྱིད་པ་དེས་སྦྲུལ་གདུག་པ་མང་པོ་མ་ཞར་གསོ་ཞིང་མཆིས་ཏེ་ཆེན་པོར་གྱུར་པ་དང་།",
    "ཡུལ་ཕྱོགས་སུ་གནོད་པར་ཀློ་བ་ཆུང་ན་ཇི་ལྟར་བགྱི་ཞེས་བློན་པོ་དག་གིས་ཞུས་པ་དང་།",
    "དེའི་སླད་དུ་དཔྱིད་ཟླཱ་ར་བའི་ངོ་ཐོག་ཐག་བཅོམ་ལྡན་འད་ས་ཤཱཀྱ་ཐུབ་པའི་སྐུའི་གཟུགས་བརྙ་ན་མ་ཞོ་པོ་ཏརྱ་ཞེས་བགྱི་བའི་གཙུག་ལག་ཁང་ན་བཞུགས་སོ་ཞེས་འཕགས་པ་དག་གིས་ལུང་བསྟན་པས་༡༧དེང་སང་གི་བར་དུ་ཡང་།",
    "ཁྱོད་ཀྱིས་བད་ག་ལ་མདའ་འཕངས་ཏེ་ཅི་བྱ་ཞེས་བགྱིས་པ་ད་ང་།",
    "རྒྱལ་པོས་ཀྱང་ཤ་བ་མ་ལགས་པར་ཚོར་ནས་བདག་གིས་ནོངས་ན་ཁྲི་ལན་ཞེས་བགྱིས་པ་ད་ང་།",
    "དེང་སང་གི་བར་དུ་ཡང་གཟུགས་བརྙན་འདི་བཞུགས།",
    "ལྷ་མོ་ཨ་ཤོ་ཀ་དང་།",
    "གཙུག་ལག་ཁང་ཆེན་པོ་བརྩིགས་སྐུ་མཁར་གྱི་ནང་དུ་ཡང་ལྷོ་སྒོའི་སྒེའུ་ཆུང་མཆིས་པའི་ནང་ལོགས་ན་ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་བ་རུ་ཎའི་གནས་ཀྱི་སྟེང་ན་པ་རི་ཐ་ཞེས་བགྱི་བའི་མཆོད་རྟེན་གཉེན་པོ་བཞུགས་པའི་དྲུང་ན་ནང་གི་གཙུག་ལག་ཁང་ཞིག་༥དང་།",
    "དེང་སང་གི་བར་དུ་ཡང་མངོན་རྟགས་ད་ང་མཚན་མ་འབྱུང་ངོ།",
    "བློན་པོ་ཁ་ཅིག་གི་མཆིད་༧ནས་རྒྱལ་བུའི་གཅེན་རྒྱལ་བུ་འདོན་འདྲོས་རྒྱ་རྗེས་ལི་ཡུལ་གྱི་རྒྱལ་པོར་བསྐོས་ཏེ།",
    "ཁོ་བ་དག་གི་རིན་གྱིས་འཇལ་ཏེ།",
    "ལྷའི་རོལ་མོ་བཟང་པོ་སྔ་ན་མ་བྱུང་བ་དེ་ཐོས་ནས་མི་༡གཅིག་གིས་གཅིག་སྦྲན་ཏེ་མ་བཟོད་ནས་དེར་མཆིས།",
    "སང་ཏིར་གྱི་གཙུག་ལག་ཁང་གི་འདབས་སུ་༡༨མཆིས་པ་དང་།",
    "དུ་གྱུར་ནས་བདག་གིས་རབ་ཏུ་ནོངས་པ་བཟོད་པར་གསོལ་ཞིང་མཆིས་ན།",
    "བཟོད་པ་གསོལ་བའི་སར་མཇལ་མོ་ཀ་ཀ་རོ་ང་ཞེས་བགྱི་བའི་གཙུག་ལག་ཁང་ཞིག་༢བརྩིགས་ནས་ཐོག་མ་ལི་ཡུལ་༐",
    "གཙུག་ལག་ཁང་གི་སྲུང་མ་ཡང་ལྷ་ཀ་བི་ལ་ཞེས་བགྱི་བས་ཞལ་གྱིས་བཞེས་གསུངས།",
    "དེང་སང་གི་བར་དུ་ལོ་གཅིག་ཅིང་ཡང་རྟག་ཏུ་སྟོན་ཟླཱ་ར་བ་ཚེས་བདུན་ད་ང་བརྒྱད་ཀྱི་གདུགས་ལ།",
    "དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་དྷ་རྨའི་༩བུ་རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧས་རྒྱལ་པོ་བགྱིད་པའི་ཚེ་ག་འཇག་གི་རྒྱལ་པོས་ལི་ཡུལ་དུ་དམག་༐",
    "རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧ་དང་འཐབས་པ་ལས་ག་འཇག་གི་ད་མག་ཕམ་སྟེ།",
    "མཆོད་རྟེན་བརྩིགས་༦ཏེ་གཙུག་ལག་ཁང་གི་སྲུང་མ་༐",
    "གཙུག་ལག་ཁང་འདི་ཡང་དེང་སང་གི་བར་དུ་མ་༡༧ཞིག་སྟེ།",
    "རྒོལ་བ་༡༧ཞིག་བྱུང་སྟེ་དམག་གིས་༡༧བཏབ་ན་ཡང་འཁུམས་ཏེ་རྒྱལ་པོ་གཅིག་པུས་སེང་གེ་དེ་ལ་བརྒལ་ཏེ་ཟིན་ནས་བཀུམ།",
    "གཙུག་ལག་ཁང་གི་དོགས་བརྟག་པའི་ཕུར་བུ་བཏབ་ནས།",
    "རྒྱལ་པོ་རབས་བཅུ་བཞིའི་བར་དུ་རེས་འགའ་ནི།",
    "རེས་འགའ་ནི་ལི་རྗེ་དག་གིས་ཡུལ་གཞན་དུ་ད་མག་དྲངས་ནས་འབངས་ཀྱི་ཚེགས་གྱུར།",
    "དགེ་སློང་བདུན་ཞིག་ཆབ་ཀྱི་ནང་དུ་ཁྲུས་བགྱིད་ཅིང་རྩེད་མོ་སྣ་ཚོགས་༐",
    "འཕགས་པ་དེ་ད་ག་གིས་༡༡རྫུ་འཕྲུལ་རྣམ་པ་སྣ་ཚོགས་བསྟན་པ་མཐོང་ནས་དད་པ་ཡང་༡༧ཆེར་སྐྱེས་ཏེ་༢༢།",
    "བཟོད་པར་༡༧གསོལ་ནས་འཕགས་པ་དགྲ་བཅོམ་པ་པོ་ཉན་༢༦རེ་ཏ་ལ་སོགས་པ་འཕགས་པ་བདུན་གྱི་ཕྱིར་འགུ་ཞན་༡༧གྱི་གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "ཞི་བའི་ས་ད་གུ་ཞན་ཏ་ཞེས་བགྱི་བར་གཙུག་ལག་ཁང་གི་མཚན་མ་ཡང་བརྟགས་ཏེ།",
    "དེང་སང་གི་བར་དུ་མངོན་རྟགས་དང་མཚན་མ་དག་ཀྱང་འབྱུང་ང་ངོ་༐།",
    "རྒྱལ་༡༧རབས་དྲུག་གི་བར་དུ་གཙུག་ལག་ཁང་གཞན་མ་བརྩིགས་ས་སོ།",
    "དེ་ནས་སླད་ཀྱིས་རྒྱལ་པོ་དེའུ་ཐེན་གྱི་སྐུ་མཁར་གྱི་སྟེང་གི།",
    "བྱང་སྒོའི་སྒོ་ཁང་ན་མཆིས་པ་ཞིག་གི་ཚེ་ན་བ་ལྟས་ན་སྐུ་མཁར་གྱི་སླད་རོལ་ན་དགེ་སློང་ཅིག་ཁྱིམ་པ་༐",
    "དེ་དག་གིས་འོད་ཟེར་བཏང་བ་རྒྱལ་པོའི་སྤྱི་བོར་རིག་༡༧པར་མཐོང་སྟེ།",
    "དེང་སང་གི་བར་དུ་ཡང་དཔྱིད་ཟླཱ་ར་བ་ཡར་གྱི་ངོ་ལ་བྱང་སྲང་དུ་སྐུ་གཟུགས་ཆེན་པོ་འདྲེན་པ་དང་།",
    "དེ་ཡང་རྒྱལ་པོ་ཁྱོད་ཀྱིས་གཙུག་ལག་ཁང་གཅིག་བརྩིག་༡༧པའི་རིགས་སོ་ཞེས་བགྱིས་པ་དང་།",
    "ད་ལྟར་འཛམ་བུའི་གླིང་ན་འཕགས་པ་དག་གིས་བྱིན་གྱིས་བརླབས་ཏེ་འདིར་གཤེགས་པར་གནང་ན།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མ་དང་བུ་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མ་སྤང་རྒྱ་ཡུལ་དུ་མཆིས་ནས་སླར་ལི་ཡུལ་དུ་མཆི་བའི་བར་དུ་དྲུ་གུའི་དམག་གིས་ཤུལ་ཁུམས་༦པ་ལས་ཕ་ནི་རྒྱ་ཡུལ་དུ་གུམ་བུ་༐",
    "ཐོག་མ་དགེ་སློང་འཕགས་པ་བེ་རོ་ཙ་ན་ཙར་མའི་ཚལ་དུ་གཤེགས་པ་ཕྱུགས་རྫི་ལ་སོགས་པ་མི་འོག་མ་དག་གིས་མཐོང་ནས།",
    "ཅག་གིས་སྔ་ན་༨མ་མཐོང་བའི་མི་འདི་ལྟ་བུ་ཞིག་ཙར་མའི་ཚལ་དུ་༩མཆིས་སོ་ཞེས་༡གསོལ་བ་དང་།",
    "སྔ་ཕྱིའི་གོ་རིམས་ལ་རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧ་ཞེས་བགྱི་བ་ཞིག་ཆུང་ངུ་ནས་རྒྱལ་པོར་ཞུགས་ཏེ་ཆུངས་པའི་སྐབས་སུ་བློན་པོ་ཁ་ཅིག་གིས་རྔན་ཅན་བགྱིས་ཏེ།",
    "རྒྱལ་མོ་དང་།",
    "སྔར་བློན་པོ་དེ་དག་གིས་རྔན་ཅན་༢བགྱིས་ཤིང་བརྙ་ས་༤པ་དེ་དྲན་ནས།",
    "དེ་ནས་སྐུ་མཁར་དུ་མཆིས་ནས་རྒྱལ་པོ་མཆིས་པའི་གནས་ནས་རྒྱལ་མོ་༡༡ད་ང་།",
    "དེ་མ་ཐག་ཏུ་གནས་དེར་མཆིས་ཏེ་བལྟས་༡༧ན་རྒྱལ་མོ་མོག་ཤ་ཀོ་༡༨ཤ་དང་།",
    "༢དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་འདོན་འདྲོས་ཀྱི་བཙུན་མོ་རྒྱ་རྗེའི་སྲས་མོ་ཤོ་རྒྱ་ཞེས་བགྱི་བའི་བུ་མོ་དགེ་སློང་མ་ཤོའི་ཛ་ཡ་ཞེས་བགྱི་བ་ད་གྲ་བཅོམ་ནས་༐",
    "རྒྱལ་མོ་༥ཤོ་རྒྱས་ཡོ་ཟོ་འཇོའི་གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "༦དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་ཤ་ཏའི་ནུ་བོ་ཨ་མ་ཅ་ཟེ་༧རོའི་མཆིས་འབྲང་༨དུ་སུ་ཧ་ཚོ་ཧ་ཞེས་བགྱི་བ་ཁྱིམ་ཐབ་གུམས་༩པ་དང་།",
    "བུད་མེད་དེ་ལ་རྒྱལ་པོའི་མཆིད་ནས་བད་ག་ད་ང་མི་ཕྲད་དུ་མི་རུང་ངོ་ཞེས་བགྱིས་པ་དང་།",
    "བུད་མེད་དེའི་མཆིད་ནས་བདག་ད་གུང་བདུན་ཞིག་ཁྱིམ་ཐབ་ཀྱི་༐",
    "རྒྱལ་པོས་བུད་མེད་དེ་འགུགས་པ་ཞིག་བཏང་བ་དེའི་མཆིད་ནས་མོ་རབ་ཏུ་བྱུང་སྟེ།",
    "བུདྡྷ་ནནྡ་འི་༢སླད་དུ་ཟེར་རོ།",
    "མཇལ་བའི་བུ་མོ་གཅིག་ཅིག་མཆིས་པ་རབ་ཏུ་བྱུང་ནས་དགྲ་བཅོམ་པར་གྱུར་པས་༨བལྟས་ན།",
    "བདག་ནི་ལི་རྗེ་བི་ཛ་ཡ་མ་ཏིའི་༩བུ་མོ་ལགས་པར་ཐུགས་སུ་ཆུད་ནས་འཕགས་པ་དྷརྨ་༡བ་ལ་དེ་དང་།",
    "རྫུ་འཕྲུལ་རྣམ་པ་སྣ་ཚོགས་ཀྱང་བསྟན་པས་རྒྱལ་པོ་ཡང་དད་པ་སྐྱེས་ནས་བུ་མོ་འཕགས་མ་དགྲ་བཅོམ་མ་དྷ་རྨ་༡༧བ་ལའི་སླད་དུ་པོ་ཡེན་དོའི་གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མ་སེང་གེ་ཞེས་བགྱི་བའི་མ་རྒྱལ་མོ་དྷ་རྨ་༡༧ཞེས་བགྱི་བ་རབ་ཏུ་བྱུང་ནས་ད་གྲ་བཅོམ་པའི་༡༧འབྲས་བུ་ཐོབ་ནས་སྤྱིལ་པོའི་༡༨ནང་དུ་བསྒོམ་ཞིང་མཆིས་པ་ལས་ནུབ་མོ་འོད་ཕྱུང་སྟེ།",
    "མ་འཕགས་མ་དགྲ་བཅོམ་མ་དྷརྨ་༢༢ཞེས་བགྱི་བའི་སླད་དུ་རྒྱལ་པོས་དྲོ་མོ་མཛའ་༦ཞེས་བགྱི་བའི་གཙུག་ལག་ི་ཁང་བརྩིགས་ཏེ།",
    "ནུ་བོ་བྲེ་སྱ་༢སྟུ་ལག་ཅེས་བགྱི་བ་ཞིག་གིས་རྒྱལ་༐",
    "པོ་གྲུ་༢གུ་མོ་ཞིག་རབ་ཏུ་བྱུང་ནས་མིང་ཡང་ཨ་ཤུ་༤ཀ་སུ་མ་ཞེས་བགྱི་བར་བཏགས་ཏེ་དགྲ་བཅོམ་པའི་སླད་དུ་དད་པ་སྐྱེས་ནས།",
    "༦དེ་ནས་གཙུག་ལག་ཁང་འགུ་ཞན་༧བརྩིགས་པའི་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མའི་མཆིས་འབྲང་༨རྒྱལ་པོ་འཕྲོམ་༩གེ་སར་གྱི་བུ་མོ་འུ་རོང་ག་ཞེས་བགྱི་བའི་བུ་མོ་གཉིས་རབ་ཏུ་བྱུང་ནས་དགྲ་བཅོམ་སྟེ་འཕགས་མ་དེ་གཉིས་གཅིག་གི་མཚན་ནི་ཤིལ་མ་ཏ་ཞེས་བགྱི།",
    "གཅིག་གི་མཚན་ནི་གོ་༡ཤ་ར་ཞེས་བགྱི་སྟེ།",
    "འཕགས་མ་དེ་ཉིད་༡༧གཉིས་ཀྱི་སླད་དུ་རྒྱལ་མོས་ཧོ་རོན་འཛོའི་༡༧གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "༡༨དེ་ནས་རྒྱལ་པོ་བི་ཛ་ཡ་ཀཱིརྟིའི་བུ་མོ་བི་ཞ་༢༦ཛ་ཡས་བུ་མོ་འཕགས་མ་དགྲ་བཅོམ་མ་བི་༐",
    "༡༨དེ་ནས་རྒྱལ་པོ་བི་ཛ་ཡ་བ་༡༧ལའི་བུ་མོ་གུ་ཟན་གྱི་རྒྱལ་མོའི་མཆིས་འབྲང་༢བགྱིད་༐",
    "པའི་ཞ་༢༡ཕྲ་བ་ཞེས་བགྱི་བས་བུ་མོ་དགེ་སློང་མ་འཕགས་མ་དགྲ་བཅོམ་མ་བི་ཞ་༢༢ཛ་ཡའི་སླད་དུ་ཨེན་༢༤མོ་ནོའི་གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "༢དེ་ནས་ལི་རྗེའི་བློན་པོ་ཨ་མ་ཅ་ཁེ་༢མེག་ཅེས་བགྱི་བས་ཕུ་བོའོ་༤སྤུན་གསུམ་གདུགས་གཅིག་ཏུ་བཀུམ་ནས།",
    "དེ་ནས་རྒྱལ་པོ་བི་ཛ་ཡ་ཛ་ཡ་ཞེས་བགྱི་བས་ཨོ་སྐུའི་རྒྱལ་པོའི་བུ་མོ་མཆིས་འབྲང་༨དུ་བླངས་ཏེ།",
    "ད་ལྟར་ལྷ་མོ་ཞེས་བགྱི་བས་༐",
    "༡དེ་ནས་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མས་ཀུས་པའི་༡༧ཨོར་མྱོང་ནག་གི་གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "བ་ལས་ཅུ་༡༨གུན་པན་གྱི་རྒྱལ་པོའི་བུ་མོ་ཤུ་ཏོ་ཀ་ཞེས་བགྱི་བ་མཆིས་འབྲང་༡༧དུ་བླངས་པའི་བུ་མོ་དགེ་སློང་མ་དགྲ་བཅོམ་མ་ཨ་ཤོ་ཀ་ཤཱི་༡༧ལའི་སླད་དུ་གཙོའུ་ནོའི་གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "༡༧དེ་ནས་རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧའི་མཆིས་འབྲང་༢༢ག་འཇག་གི་རྒྱལ་མོ་ཨ་༐",
    "ཁྱིམ་བདག་ན་མོ་བོད་ཅེས་བགྱི་བ་དེ་ཡང་དད་པ་སྐྱེས་ནས།",
    "ཡོན་བདག་ལས་ཀྱང་མི་དྲས་ནས་གཙུག་ལག་ཁང་གི་མཚན་ཡང་ན་མོ་འབུ་གདོང་ཞེས་བྱ་བར་བཏགས།",
    "དེ་ནས་ལི་རྗེའི་བློན་པོ་འདའ་ནོ་ཡ་ཞེས་བགྱི་བ་ཞིག་གིས་ཚོང་འདུས་པར་མར་སྐུ་གཟུགས་ཆེན་པོ་བགྱིས་པ་ལས་སླད་ཀྱིས་ཡང་ལིའི་བློན་པོ་ཨ་མ་བི་དད་ཀྱི་སྐུ་གཟུགས་ཆེན་པོའི་ལྷ་ཞིག་རལ་དུ་གྱུར་པ་ཡང་གསོས།",
    "ཀོང་ཤེང་གི་དགེ་སློང་མའི་སླད་དུ་འདའ་ནོ་ཡོ་ནའི་༡༧གཙུག་ལག་ཁང་བརྩིགས་ཏེ།",
    "ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་ཀྱིས་ཞུས་པ་དང་།",
    "༨པེ་སྣར་གི།",
    "༡༨པེ་སྣར་གི།",
    "༩པེ་སྣར་གི།",
    "༡༨པེ་མཆིས་༡༧༡༧པེ་སྣར་གི།",
    "༢༢༤པེ་སྣར་གི།",
    "༥པེ་སྣར་གིས་༦པེ་སྣར་ད་ང་།",
    "༡༧པེ་སྣར་མ་ཞུ་༢༢སྣར་རྒྱ་རྗེའི་བུ་མོ།",
    "༢༢པེ་སྣར་གི་བྷམཱ་ཀླགས་༢༢པེ་སྣར་ཀྱི།",
    "༡༧པེ་སྣར་གི།",
    "༧པེ་སྣར་གི།",
    "༨པེ་སྣར་བྲེད་ཅེས་༩པེ་སྣར་གི།",
    "༡༧པེ་སྣར་གི།",
    "༡༧སྣར་ཚིག་༡༧པེ་སྣར་བཚིགས་༡༧པེ་སྣར་གི།",
    "༡༧པེ་སྣར་སོང་ཧ་ན་ཏ་ལ།",
    "༢པེ་སྣར་བུ་མོ།",
    "༥པེ་སྣར་རྒྱལ་མོ།",
    "༢༢པེ་སྣར་མྦྷམོ།",
    "ུ་༦པེ་སྣར་ཅོ་མོ།",
    "ཀྲུང་གོའི་པོད་རིག་པ་དཔེ་སྐྲུན་ཁང་གིས་བསྦྲུན།",
    "པད་འབྱུང་ཉིན་མོར་བྱེདཞབས་སྤྱི་བོས་མཆོད།",
    "གང་གི་སྒྱུ་འཕྲུལ་རོལ་བར་ཡོངས་འདུས་པ།",
    "ཚེ་འདི་ཉིད་ལ་མཆོག་གི་དངོས་གྲུབ་མངོན་དུ་བྱེད་པའི་མྱུར་ལམ་སྟེ།",
    "འཇུག་བྱ་གཞུང་གི་དོན།",
    "ཞེས་པ་འདོད་ཆགས་དག་པས་སོ་སོར་རྟོགས་པའི་ཡེ་ཤེས་ཀྱི་ཚོས་ཐུམས་ཅད་གལ་ལ་མཆབས་པར་གཟིགས་ནས་འཇིག་རྟེན་དུ་ཚེས་ཀྱི་སྣང་བ་ཆེན་པ་རྒྱས་པར་མཛད་པས་བརྡ་སྤྲོད་པ་གསུང་རྡོ་རྗེ་འོད་དཔག་མེད་ཀྱི་རིགས་སུ་སྟོན་པ་ཡིནལ།",
    "དེ་དག་ལ་ཕན་གདགས་པའི་དོན་དུ་བདྨ་བདག་གི་བདེ་གཤེགས་ཀུན་འདུས་སྒྲུབ་པའི་ཐབས་འདི་ཉིད་པསྟན་པར་བྱ་ཡིས་དམ་བཅའ་བརམཛད་དེ།",
    "དེ་ཡང་རིང་པོར་མི་ཐོགས་པར་དུས་གངས་ངེས་པ་དེ་དང་དེའི་བྱ་རྫོགས་ཀྱི་སྐད་ཅིག་མ་གཅིག་ཉིད་ལ་དགའ་བ་མེད་པར་ཐོབ་པར་བྱེད་པ་ལ་མི་བསླུ་བར་གཟིགས་ནས་ཏེ།",
    "གང་གིས་སྒྲུབ་པའི་གང་ཟག།"
  ]
}