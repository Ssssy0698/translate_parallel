    "དུས་རྒྱུན་གྱི་གནོན་འཚེ་དང་བསླུ་བྲིད་སོགས་བྱས་ཀྱང་།",
    "དུས་མཚུངས་སུ་རྫིག་རྫིག་རྔམ་རྔམ་གྱིས་འཇིགས་སྐུར་བྱས།",
    "གལ་སྲིད་ངེད་ཚོ་དང་མཉམ་འབྲེལ་མ་བྱས་ན་འཆི་ལམ་མ་གཏོགས་མེད་ཚུལ་བཤད།",
    "བལྟས་ཚོད་ཀྱིས་ང་ལ་འཚོ་ལམ་ཞིག་སྦྱིན་བསམ་པར་སྣང་ཡང་།",
    "དམག་ཤོག་གསར་བུས་ལག་གང་མགྱོགས་ཀྱི་དགའ་བསུ་དང་དགའ་འབོད་བྱས།",
    "མངོན་གསལ་དུ་མ་བྱུང་བའི་རང་ཉིད་ཀྱིས་མགོ་བོ་གཡུག་གཡུག་བྱེད་བཞིན་ང་ལ་སེམས་ཤུགས་སྐྱེད་དགོས་པར་བཤད།",
    "ཁོ་ཚོར་མི་འགྱངས་པར་རང་ཉིད་ཀྱི་ནང་སེམས་ཀྱིས་རྒོལ་གཏམ་བྱེད་ངེས།",
    "ཉི་ཧོང་ན་ཡོད་པའི་ངས་ཡུལ་གྱར་ཁྲོད་བཅོས་བསྒྱུར་ལ་ངོ་རྒོལ་བྱེད་པ་སྟ་གོན་བྱས་པ་ཡིན།",
    "ངས་ཡང་བསྐྱར་དང་ལེན་མ་བྱས་པ་ཡིན།",
    "བསླུ་བྲིད་བྱས་པ་དང་།",
    "ཉིན་དེར་ཚོགས་ཁང་ནང་མིས་གང་ནས་འཚང་ཁ་ཧ་ཅང་ཆེན་པོ་བྱས།",
    "ངས་ཅི་ཞིག་མངོན་འགྱུར་བྱས་ཡོད་པ་དང་གང་ཞིག་ཐོབ་ཡོད་ཅེས་པ་མ་ཡིན་པར།",
    "འཚོ་སྡོད་བྱས་ནས་བསྡད་པའི་ཚེ།",
    "ང་དང་ཧྲི་ཐེ་ཧྥོ་ཅིན་ཡང་ཐེངས་གཉིས་གསུམ་ཙམ་ལ་ལབ་གླེང་བྱས།",
    "དོན་དངོས་སུ་སྔོན་ཆད་དཀའ་སྡུག་མང་པོ་ཞིག་ལ་འཐད་རྩོད་བྱས་མྱོང་།",
    "མཚན་ཉིད་རིག་པ་ཁོ་ན་མ་ཡིན་པའི་ལྷ་སྒྲུང་རིག་པ་དང་།",
    "ལྷོད་ལྷོད་ཀྱིས་འཚོ་བ་ལ་མཉམ་ཞིབ་བྱས་ཚེ།",
    "བློ་ངོར་ལ་དོན་དག་ལེགས་པོ་ཞིག་གམ་བྱ་བ་བཟང་ཞིག་ཡིན་པར་སྣང་ཡང་།",
    "གནས་བབ་སྡུག་པོ་དང་ལེགས་པོ་གཉིས་བསྡུར་བ་བྱས་ཚེ།",
    "དེ་ལྟར་བྱས་ན་ཤེས་རབ་ཅན་གྱི་ལས་གཞི་ཞིག་ཡིན་པར་འདོད།",
    "སྒྱུ་རྩལ་མི་དང་གླེང་བྱེད་པར་དགའ་བའི་མི་ཞིག་ཡིན།",
    "འཇིག་རྟེན་ཁམས་ཀྱི་བྱ་དངོས་ཡོད་ཚད་ནི་རྒྱུ་འབྲས་འཁོར་སྐྱོད་ཀྱི་གནས་ལུགས་རྒྱུད་ནས་ཡོང་བར་ཡིན་པར་གཏན་འཁེལ་བྱས།",
    "ཁྱེད་གཉིས་ཀྱི་བར་ལ་འགལ་བ་མི་ཡོང་ངམ་ཞེས་འདྲི་སྲིད།",
    "འོན་ཀྱང་ངས་ཤུགས་རྐྱེན་དེ་དག་བེད་སྤྱོད་བྱས་ནས་རང་ཉིད་ལ་མཛེས་སྤྲས་བྱས་མ་མྱོང་།",
    "ཆེས་དྭངས་གཙང་ཡིན་པའི་གུ་ཡངས།",
    "མཉམ་དུ་འཚོ་བ་སྐྱེལ་ཀ་མ་བཅུག་པ་ཡིན་ཚེ་སྡུག་བསྔལ་ཆེན་པོར་ཆགས་འགྲོ་བས་གཉེན་སྟོན་འདི་དང་ལེན་བྱས་པ་ཡིན་ཟེར།",
    "འོན་ཀྱང་ང་ལ་དྲིན་ཆུང་ཆུང་ཞིག་ལས་མ་བྱས་ཀྱང་དེ་ཚོ་ལ་ཆེས་བཀའ་དྲིན་ཅན་དུ་འཛིན་ནས་དྲིན་ལན་མཇལ་ངེས།",
    "འོན་ཀྱང་དེ་ལྟ་བུའི་ཆབ་སྲིད་ནག་ཉེས་ཅན་ཐག་གཅོད་བྱས་པའི་མཇུག་འབྲས་ནི་ནང་འགལ་གྱི་གཞི་མ་ཡིན།",
    "དེ་ནས་དེ་དག་ལ་བཟོ་བཅོས་དང་བཙོ་སྦྱང་བྱས་ནས་ནང་ལོག་ཏུ་དར་སྤེལ་བྱས།",
    "འཇིག་རྟེན་གྱི་བྱ་དངོས་གང་ལ་ཞིབ་འཇུག་བྱས་ཀྱང་།",
    "སིན་ལོའུ་ཧུའུ་ཡིས་རྒྱལ་ཁབ་གསར་བཞེངས་ཀྱི་ལྷ་སྒྲུང་ནང་དམངས་ཡོངས་འཚོགས་ནས་རྒྱལ་ཁབ་ཀྱི་སྲིད་འཛིན་འདེམ་བསྐོ་བྱས་པའི་དོན་དག་ཡོད།",
    "བགྲོད་ལམ་མེད་པར་མ་ཡིན་ཀྱི།",
    "གལ་སྲིད་ངེད་ཚོས་དམངས་དང་ལེན་མ་བྱས་ཚེ།",
    "ཕལ་ཆེར་མ་འོངས་པར་དེ་ལས་ཕུལ་དུ་བྱུང་བའི་ལམ་ལུགས་ཤིག་ཡོང་དཀའ་བར་འདོད།",
    "རྒྱལ་ཁབ་གཞན་པས་བཙན་འཛུལ་བྱེད་དུ་མི་འཇུག་པར་གནས་པའོ།",
    "དེ་མཚུངས་གོ་ལའི་སྟེང་འཚོ་གནས་བྱས་པའི་ནགས་ཚལ་དང་།",
    "དབྱིན་ཡིག་ནི་དབྱིན་ཇི་དང་ཨ་རི་གཉིས་ཀྱི་སྐད་དང་ཡི་གེ་ཡིན་པར་མ་ཟད།",
    "འོན་ཀྱང་དཀའ་སྤྱད་འབད་བརྩོན་བྱས་ན་དོན་དག་ཐམས་ཅད་ལེགས་འགྲུབ་འབྱུང་ཐུབ་པས།",
    "འོན་ཀྱང་ཐེངས་གཅིག་གཉིས་ལ་ཚོད་ལྟ་བྱས་ཀྱང་།",
    "འོན་ཀྱང་སྐབས་དེར་ང་མི་གཅིག་ལའང་མགོ་མ་སྒུར་བ་བསྡད།",
    "དུས་ཡུན་ཅུང་ཙམ་འགོར་རྗེས་ངེད་གཉིས་ཀྱིས་གཉེན་སྟོན་བྱས་པ་ཡིན།",
    "ང་བཙོན་དུ་ཡོད་སྐབས་ངའི་ཁྱིམ་ཚང་ལ་བདག་སྐྱོང་བྱས་པ་དང་།",
    "གལ་སྲིད་ཕ་རོལ་བས་དང་ལེན་མ་བྱས་ཚེ།",
    "འོན་ཀྱང་ཁོ་ཚོས་ལྟག་རྒྱབ་ནས་བསྒྲུབ་པའི་བྱ་བའི་ངོས་ནས་རྟག་ཏུ་ཨུ་ཚུགས་བྱས་ནས།",
    "གྲོས་མཐུན་ལེགས་འགྲུབ་ཡོང་བར་སྐུལ་འདེད་བྱས།",
    "ལྷག་པར་དུ་༡༩༨༨ ལོའི་རྗེས་སུ།",
    "ཁོ་ཚོས་རང་ཉིད་རང་བསྐྲུན་གྱི་འདུ་ཤེས་ལྟར་བྱ་བ་ཐམས་ཅད་རང་ལ་རག་ལས་པར་འདོད་པ་ལས།",
    "སྒེར་གཅོད་པར་ངོ་རྒོལ་དང་བཀག་སྡོམ་བྱེད་པའི་འཐབ་རྩོད་ཀྱི་བརྒྱུད་རིམ་ཁྲོད།",
    "གཙང་སྤྱོད་ཀྱི་གྱང་ངོས།",
    "མཉམ་བཞག་མེད་པའི་སྐབས་སུ་གྲོགས་པོ་དང་མཉམ་དུ་བསྡད་ན་ང་ལ་སྔར་བཞིན་སྒེར་འཛིན་གྱི་གཤིས་ཀ་དེ་གསལ་བོར་ཡོད་ངེས།",
    "ཧ་ཅང་གཟབ་ནན་གྱིས་ཞིབ་ཉན་བྱས་ན་ཕ་རོལ་བ་ལ་རོགས་རམ་བྱེད་པོ་བྱེད་ཐུབ།",
    "དེ་ནི་སྤྱིར་བཏང་དུ་ཉན་པ་ཙམ་མ་ཡིན་པར།",
    "ཕྱོགས་གཉིས་ལ་དྲག་ཤུགས་ཀྱི་བྱ་བ་དང་འབྲེལ་བའི་ལག་ཆ་ལ་བརྟེན་པ་མ་ཡིན་པར།",
    "འཕེལ་རྒྱས་ཀྱི་འགྲོ་ལམ་གསར་པར་འཚོལ་ཞིབ་བྱེད་དགོས།",
    "ཁུང་ཙི་འཚོ་བཞུགས་བྱེད་པའི་དུས་སྐབས་སུ།",
    "ཙི་ཁྲིན་གྱིས་སྐུ་དྲག་བར་གྱི་འགལ་ཟླའི་འགྲན་རྩོད་རྣམས་མཐུན་སྒྲིག་བྱས་ཤིང་།",
    "ཁྲལ་བསྡུའི་ལམ་ལུགས་བསྒྱུར་བཅོས་བྱས་ནས་ས་ཞིང་ལམ་ལུགས་འགན་ལེན་བྱས་ཤིང་།",
    "ཁོས་ལོ་ངོ་༢༥ ཡི་ཡར་སྔོན་གྱི་རྨོངས་དད་གྱི་གོམས་སྲོལ་གོང་ལ་རྦད་དེ་ངོ་རྒོལ་དྲག་པོ་བྱས།",
    "མི་སེར་རྣམས་ཀྱིས་ཆབ་སྲིད་དང་འབྲེལ་བའི་སྐྱོན་བརྗོད་དྲག་པོ་བྱས་ན།",
    "དེ་ལྟར་བྱས་ཚེ།",
    "བསམ་འཆར་དེ་དག་དང་ལེན་བྱས་ན།",
    "སྐྱོ་དགོས་པ་ཞིག་ལ་དགེ་མཚན་ལྡན་པའི་སྐྱོན་བརྗོད་མ་བྱས་ན་རྒྱལ་ཁབ་ཀྱི་ཆབ་སྲིད་ཀྱི་རྣམ་པ་ཇེ་ལེགས་སུ་ཡོང་མི་སྲིད་ལ།",
    "ཧོང་ཞི་བློན་ཆེན་གྱིས་མགོ་ལྡེམ་ལྡེམ་ཙམ་བྱས་ནས།",
    "ཅིག་བྱས་ན་དེ་ནི་ཁོ་ཚོའི་རང་དོན་ཁོ་ནར་བསམ་བློ་བཏང་བ་རྩ་བ་ནས་མིན།",
    "འོན་ཀྱང་དོན་དངོས་ཐོག་དེས་ནག་ཉེས་ཅན་ཚོ་འདོད་སྤྲོད་བྱེད་པར་གཞོགས་འདེག་དང་རྒྱབ་སྐྱོར་གང་མང་ཞིག་བྱས་ཡོད།",
    "འཇར་མན་ལ་བྲོས་བྱོལ་བྱས་ཤིང་།",
    "མི་ཚང་མས་ཉེན་ཁ་ལ་མི་སྐྲག་པར་བཙོན་མ་རྣམས་ཀྱི་ཆེད་དུ་སྐྱོན་བརྗོད་བྱེད་མཁན་གྱི་གྲལ་དུ་ཞུགས་བྱུང་།",
    "ལམ་ཁ་གཅིག་ནས་འབད་པ་བྱེད་དགོས་པའི་མི་རྣམས་དངམཉམ་དུ་མདུན་བསྐྱོད་བྱས་ཆོག་ཟེར།",
    "སེམས་ཐག་གཙང་མར་བཅདདེ་བྱ་བ་ཞིག་བསྒྲུབ་པ་དང་།",
    "སྤྱི་དམངས་ཀུན་འདུས་ཀྱིས་བསྐྱོན་བརྗོད་བྱས་ན་ཕན་ཐོགས་ཡོད་པ་མ་ཟད།",
    "འོན་ཀྱང་མི་སྒེར་གྱི་བྱེད་སྟངས་ལ་སྐྱོན་བརྗོད་བྱས་ན་གཟབ་ནན་བྱེད་དགོས་ཤིང་།",
    "སྐྱོན་བརྗོད་ཀྱི་དམིགས་ཡུལ་ནི་ཕ་རོལ་དམའ་འབེབས་བྱས་ན།",
    "ལྷག་པར་དུ་མི་སྒེར་ལ་སྐྱོན་བརྗོད་བྱེད་པར་ཐབས་ལམ་དགོས།",
    "ཕ་རོལ་པའི་ལངས་ཕྱོགས་དང་དགེ་མཚན་ལ་བརྩི་སྲུང་མ་བྱས་ཚེ།",
    "གཅིག་བྱས་ན་མི་ཚར་བ་ནི་གོང་སྨྲས་ཀྱི་རྒྱུ་རྐྱེན་ཡོད།",
    "འདེམས་བསྐོའི་རྒྱལ་ཕམ་ཐག་གཅོད་བྱས་པའི་ཆོག་བཟོ་ཚོགས་རྒྱབ་སྐྱོར་ཐོབ་པར་བརྟེན།",
    "སྐབས་དེར་མི་འདེམ་བསྐོ་བྱས་པའི་འདེམས་ཤོག་མང་ཆེ་བ་ནི་ཡེ་ཏང་བ་ཡིན།",
    "ངའི་ཐོ་འགོད་བྱས་པའི་ནུས་པ་མེད་པར་གྱུར།",
    "ཉེན་རྟོག་པ་དང་དམག་དཔུང་ལ་ཇི་མི་སྙམ་པར་བཙན་ཤེད་ཀྱིས་ཐམ་ག་ཚང་མ་གཞུང་བཞེས་བཏང་བས།",
    "མངགས་བཅོལ་བྱས་ཤིང་།",
    "མི་བཞི་བཅུ་ལྔ་བཅུ་ཙམལ་གསར་དུ་ངོ་སྤྲོད་ཡི་གེ་བྲིས་ནས་མངགས་བཅོལ་བྱས་པ་མ་ཟད།",
    "ཁོ་ཚོར་གནོན་ཤུགས་ཆེན་པོ་ཡོད་པས་འདེམས་ཤོག་འཐེན་མཁན་པར་གྱུར་བས་ང་ནི་རང་འགུལ་གྱིས་བདམ་ཐོན་ལས་ཕྱི་རུ་ཕུད་ཅིང་།",
    "དེ་ནི་ངས་ཐེངས་གསུམ་པར་ཕམ་ཁ་ཉོས་པ་ཡིན།",
    "ནག་མེད་ནག་འཛུགས་ཀྱི་བྱ་སྤྱོད་ཀྱིས་མ་ཉེས་ཁ་གཡོག་བྱས་པས།",
    "ཁོ་ལ་མི་རྣམས་ཀྱིས་བསྟོད་བསྔགས་དང་རོགས་སྐྱོར་མང་པོ་བྱས་པས།",
    "འོན་ཀྱང་ཁོ་ཚོར་དམག་མི་རྣམ་གྱིས་རྒྱབ་སྐྱོར་བྱས་པར་བརྟེན་ནས་རྒྱལ་ཚོགས་ཀྱི་ཐོག་ཏུ་ཞུགས་ནས་དངོས་སུ་འདེམས་ཤོག་འཐེན་དུ་བཅུག་ཚེ།",
    "དེ་ལྟ་བུའི་མི་ནི་དོན་དག་མང་པོ་ཞིག་བསྒྲུབ་པར་སྤྲོ་བ་འཕེལ་བཞིན་ཡོད།",
    "ངས་རང་ཉིད་ཀྱིས་འབད་པ་བྱས་པའི་རྒྱུད་རིམ་དེ་ཁྱེད་ལ་འདོན་སྤྲོད་ཐེངས་གཅིག་བྱས་ན་འདོད་བྱུང་།",
    "ངའི་འགྲམ་ན་རང་ཉིད་ཀྱི་ཡོད་ཚད་བློས་གཏོང་ཐུབ་ཅིང་ཉེན་ཁ་ལ་མི་འཛེམ་པར་བྱ་གཞག་ལ་རང་ནུས་གང་ཡོད་ཀྱི་ཟབད་པ་བྱེད་པའི་བློ་མཐུན་མང་པོ་ཞིག་ཡོད།",
    "འདྲི་གཅོད་ཀྱིས་མནར་གཅོད་དྲག་པོ་བྱས་པ་དང་།",
    "འོན་ཀྱང་ཁོ་ཚོར་གཡོ་འགུལ་ཅི་ཡང་མ་བྱུང་བར་མདུན་བསྐྱོད་བྱས་པས།",
    "ཅིག་བྱས་ན་ཆབ་སྲིད་ནི་རུལ་གྱི་རྣམ་པ་ཅན་ཞིག་ཡིན་ལ།",
    "ཆབ་སྲིད་ནི་དབེན་པའི་རི་ཁུག་ཏུ་སྐྱེས་པའི་མེ་ཏོག་ཅིག་མ་ཡིན་པར།",
    "དབྱི་ཐ་ལིའི་རུལ་རྒོལ་གཙང་སྤེལ་ཡར་ངོའི་ཟླ་བཞིན་འཕེལ་བ་དང་།",
    "ཁ་སང་འུད་བསྟོད་བྱས་པའི་དོན་དག་རྣམ་དེ་རིང་ནོར་འཁྲུལ་ཅིག་ཏུ་ངོས་འཛིན་གྱིན་ཡོད་ཅིང་།",
    "ལྷག་པར་དུ་ཆབ་སྲིད་གནས་བབ་ཁོས་ནས་དེ་ལྟར་བྱུང་མི་ཉན་ནོ།",
    "དེ་ལྟར་བྱས་ན་ད་གཟོད་འདམ་རྫབ་ཀྱིས་གང་བའི་རྙིགས་རིགས་ཀྱི་ཁྲོད་ནས་པདྨ་མ་མང་པོ་ཞིག་སྐྱེས་སྲིད།",
    "རྒྱལ་ཁབ་ཀྱི་རྒྱལ་ས་གཏན་འཁེལ་བྱས་པ།",
    "རྒྱལ་པོས་ནམ་ཡང་དམག་མི་རྣམ་གྱི་སྣེ་ཁྲིད་ནས་གཡུལ་སར་མདུན་བསྐྱོད་བྱས་པ་དང་།",
    "རྒྱ་མཚོར་བརྟེན་ནས་གནས་ཐབས་བྱས་ཡོད་པས་ཡིན།",
    "རྒྱ་གར་གྱི་རྒྱལ་ས་བྱང་ཕྱོགས་སུ་ཡོད་པའི་དྷི་ལི་རུ་གཏན་འཁེལ་བྱས་ཡོད་པ་དང་།",
    "དེའི་རྗེས་སུ་ད་གཟོད་མཛུབ་སྟོན་ལ་གཞིགས་ནས་ཐོག་མར་གནས་མང་པོ་ཞིག་གཏན་འཁེལ་བྱས་པ་དང་།",
    "སྔོན་དཔག་བྱས་པ་ལྟར་ན་ཉོག་དྲ་ཆེ་བའི་མིག་མདུན་གྱི་གནས་བབ་དེ་བསྒྱུར་འགྲོ་བས་ཡིན་ལ།",
    "སོས་དལ་གྱི་བག་ཕེབས་ཀྱི་འཚོ་བ་ལ་ནན་རྒྱུན་གསལ་བརྡ་བྱས་པ་ཡིན།",
    "ལོ་འདི་དག་ལ་ངས་འཕེལ་རྒྱས་ཀྱི་རྗེས་སྙེགས་བྱས་ཏེ།",
    "སྔོན་མར་ཁོ་ཚོས་ངོ་རྒོལ་དང་འོས་ལངས་ཅི་ཙམ་བྱས་ཀྱང་།",
    "ཡང་ཅི་འདྲའི་ངང་ནས་ཐག་གཅོད་བྱས་ཡོད་པའང་ཤེས་ཀྱིན་མེད།",
    "གལ་སྲིད་ཁོ་ཚོས་དམངས་ཚོགས་ལ་བརྩི་བཀུར་དང་དམངས་ཀྱི་ཁེ་ཕན་ལ་བསམ་གཞིག་བྱས་ཡོད་ཚེ།",
    "རུས་ནེའུ་ཅན་གྱིས་ཧའོ་ལན་ལྟེ་བར་བཟུང་ནས་ཆུ་དམག་བསྡུ་རུབ་བྱས་ཏེ།",
    "རྒྱལ་དམངས་ལ་ཡིད་ཆེས་བྱས་ཏེ་ལག་གདང་སྤྲེལ་ནས་མདུན་དུ་སྐྱོད་པ།",
    "ངེས་པར་དུ་རང་ཉིད་ཀྱི་གོམ་སྟབས་ལ་སྙོམས་སྒྲིག་བྱས་ཏེ་རྒྱལ་དམངས་ཀྱི་ལག་པར་དམ་པོར་འཇུས་ནས་དེ་དང་མཉམ་དུ་མདུན་སྐྱོད་བྱེད་དགོས་པ་ཡིན།"
  ]
}