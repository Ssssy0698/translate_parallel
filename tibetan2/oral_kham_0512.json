    "ཁྱེད་རང་གང་དགའ་གནང་རོགས་གནང་།",
    "ཁོང་ཁྲོ་སེམས་འཁྲུག་ལྟ་བུས་མ་སྐྱིད་པ་ཆེན་པོ་བྱུང་སྟེ་༧རྒྱལ་བ་སྐུ་ཕྲེང་དགུ་པ་ལུང་རྟོགས་རྒྱ་མཚོའི་གསེར་གདུང་ལྷ་ཁང་ནང་ཡིབ་བཞུགས་འདུག་པ་དང་།",
    "ཡུལ་ལུང་སོ་སོའི་ནང་སྔར་མེད་ཁྲལ་འཕར་ཡོང་དོགས་ལྷ་ཀླུ་གཞི་བདག་ལ་ཕོག་ཐུག་བྱུང་ན་ལུང་པའི་ནང་བཀྲ་མི་ཤིས་པ་དང་ས་བཅུད་ཀྱང་ཉམས་སྐྱོན་བྱ་ཚུལ་ལ་ཁག་བཏགས་ཏེ་འདོན་ལས་གནང་རྒྱུར་མཛད་དཀའ་ཆེད་བཟོས་ཀྱིས་མཚམས་འཇོག་གནང་དགོས་བྱུང་འདུག་ས་གཏེར་ཐད་དེ་སྔ་འདོན་སྲོལ་མེད་པ་མིན་ཅིང་།",
    "བཀའ་རྒྱ་ཡང་གཏོང་འཐེན་མཛད་པ་ཡིན་ཚོད་འདུག་པ་བཅས་སྔོན་བྱུང་གནས་ལུགས་གང་དྲན་དགོངས་པའི་དཔྱད་གཞིར་ཐུགས་ཕན་གསོས་ན་སྙམ་ཟོལ་མེད་དུ་ཞུས་པ་ལགས།",
    "སྐུ་པར་ཡང་མང་པོ་བོད་ལ་ཕར་བསྣམས་ཕེབས་འདུག་ཆུ་བྱི་༡༩༡༢རྒྱ་བོད་དམག་འཁྲུག་སྐབས་དམག་སྤྱི་མཁན་དྲུང་བྱམས་པ་བསྟན་དར་ལགས་ནས་བསྐུལ་མ་ཞུས་པ་བཞིན་དབྱངས་འཆར་གཡུལ་རྒྱལ་རྒྱུད་ཀྱི་དགོངས་དོན།",
    "དེ་སྐབས་བཀའ་གྲོས་པ་ཚོ་དགོངས་རྫོགས་ཆོག་གྲྭ་སོགས་ལ་མྱོང་བ་ཆུང་ཞིང་ལྷུས་མི་ཐིངས་པ་ཞིག་འདུག་པ་ནས།",
    "གྲོལ་མཚམས་གདུད་ཆོག་བྱེད་དགོས་འདུག་གསུང་བ་བྱུང་བས།",
    "གདུང་ཆོག་བསྙུར་དགོས་པ་འདུག་པས།",
    "རྩིས་པ་ཚོ་ཡང་སྨྱོན་པའི་རྟུལ་ཞུགས་འཛིན་པ་དེར་འདུགའོན་ཀྱང་དགོངས་རྫོགས་དངོས་གཞིའི་དུས་ཐོག་དེ་ལ་འཁྲོལ་འདུག་པ་དང་།",
    "ཟླ་གཅིག་སྔ་བསྣུར་བའི་ཁུངས་སུ་འདུགཉེར་ལྔ་ལ་གདུང་ཆོག་གྲོལ་བ་ཡིན།",
    "གཅིག་ཁོ་ནར་མི་གདའ།",
    "ཐོར་པས་མི་འགྲོངས་པར་འདུག་སྙམ་ནས།",
    "དེ་ལོ་ཡང་སྐུ་རིམ་ཏ་མང་པོ་མཛད་གདའ།",
    "ཞེས་པ་དེར་གདའ།",
    "ཕུ་དཀྲུགས་མདའ་དཀྲུགས་རང་ཀ་བྱེད་པ་མང་བར་འདུག་གོ།",
    "གནང་སྒོ་མ་ལེགས་ཚུལ་མང་པོ་གླེང་བར་འདུགམི་ལེགས་པ་ཡོད་ཤས་ཆེ་ནའང་།",
    "ཡང་ཟེར་རིགས་འདི་ལ་དཔགས་ན་ག་འདྲ་ཡིན་ཡང་མི་ཤེས་པ་འདུག་བསམ་པའང་བྱུང་།",
    "མི་སྡོད་མཁན་ཚོས་སྡོང་ཡུལ་ལ་ཐེས་མེད་བྱེད་པ་འདི་ཚེ་ལོ་བཅུ་པ་ཧབ་རྒྱུགས་བྱེད་མཁན་ཀུན་གྱི་སྤྱི་ལུགས་སུ་འདུགཁྱེད་རྣམས་སྒོས་སུ་བློ་སྐྱོག་མི་དགོས་པ་འདུག་སྙམ་པའང་ཤར།",
    "ལོངས་སྤྱོད་དང་ཁ་དྲག་པོ་ནི་ང་རང་ལ་ཡོད།",
    "འཇིག་རྟེན་ཕལ་པ་ལ་ཕན་བཏགས་པ་ལ་འབྲས་བུ་དེ་ཀར་འདུགསྐུ་གཤེགས་པ་ནས་གཟུང་དེ་བར་ངེད་ཀྱིས་ནི་སྐུ་སྒྲིབ་སྦྱང་བའི་ཐབས།",
    "གྲྭ་སར་ཡར་མར་ན་ནི་འདུག་རྩེ་རང་ན་གོས་སྐུ་མི་བཞུགས།",
    "ངེད་ལ་འདི་དུས་དོན་དག་ནི་མ་གྲུབ་པ་དེར་འདུགཕྱིས་ཡོང་རྒྱུ་ཅང་མེད།",
    "ཉང་སྟོད་སྟག་ཙལ་གྱི་ཐད་སྨད་པ་ཚོའི་མི་ངོ་ལ་གསལ་པོར་བྱུང་འདུག་པས།",
    "དེ་རྗེས་བར་སྐབས་སུ་ཐུགས་གཏོང་ས་ཅུང་ཟད་འགྱུར་བའི་ཆ་ཤས་ཅིག་བྱུང་ཡོད་འདུག་པས་པར་ཤུན་གཙང་དུ་འབུལ་དགོས་བྱུང་བ་དེར་འདུགསྤྲེའུ་ལོ་འདིར་ངེད་ལ་འབོད་མཁན་གནང་།",
    "གཙང་ཀུར་འཛིངས་པ་འདི་ཚོ་ལ་གཙོ་བོར་ཞྭ་དམར་ནག་བཞུགས་འདུག་སྟེ་ཁྱེད་ཀྱིས་ཀྱང་ཕན་འདོགས་བྱེད་དགོས་རྒྱུར་འདུགདེ་མིན་ཡང་མར་ཕྱོགས་ལ་ཡོང་དགོས་གསུང་བ་བྱུང་།",
    "སྔར་ཤུལ་རང་དཀའ་བ་འདུག་སྟེ།",
    "ལར་མི་ཆེན་གྱི་རིགས་ཚོ་རིམ་གྲོ་དཀར་ཕྱོགས་བསྲུང་འཁོར་ལ་རྩོལ་འདོན་དགོས་པའི་རིགས་སུ་འདུག་གོ།",
    "དར་མ་ཙ་ན་དད་པ་ཡལ་ནས་སོལ་བའི་ཕྱེ་མ་ལྟར་ནག་ཐིབས་ཀྱི་འགྲོ།",
    "ཡང་ལ་ལ་དར་བབ་ཙ་ན་རྣམ་དཔྱོད་དང་ལྡན་ཞིང་གར་སླ་འཚམ་པ་ཅིག་ཡོད་པ་དེ།",
    "རྒན་འཆལ་སྔ་ཤོས་དེ་ལོ་ཉི་ཤུ་རྩ་གཉིས་ཙམ་ནས་ཡོང་ཟེར་བའི་དཔེ་དར་གདའ།",
    "ཞུད་ཁ་ཡང་མང་བར་འདུག་ཟེར་བས།",
    "འོ་ན་སྐུ་གལ་ཆེ་ཙ་ན་ཡོང་དགོས་བྱས་ཏེ།",
    "བརྟག་པའི་འཆར་སྒོ་ལ་ཉེས་སྐྱོན་ཡེ་མེད་ཅིང་ལེགས་པར་འདུག་ནས།",
    "བརྟག་པ་ཞུུ་བ་གནང་ཡོད་འདུག་པས་དབུས་ལ་ཕེབས་པ་མ་ཆུག་ཚུལ་ཞུ་དགོས་ཟེར་བ་ལ་བརྟག་པའི་གནས་ཚུལ་ཞུས་གྲུབ་ཚུལ་ལབས།",
    "ཁོང་རང་ཡོན་མཆོད་ཚོ་ལ་དེ་རང་ཡོང་འདུག་པས་ཡིན་ནམ།",
    "རྫུན་བྱེད་རྒྱུ་ཡིན་ན་བརྟག་པ་བྱེད་དོན་ཡང་མི་འདུག་གོ།",
    "ངེད་གནང་ཆུང་ཡིན་ཙ་ན་ལར་གྱི་ཡང་གསན་པ་ཀོགསྒོས་སུ་ཁྱེད་རང་རྣམས་ཀྱིས་ངེད་ཀྱིས་ཞུས་པའི་རིགས་ལ་གསན་དགོངས་མཛད་ན་ཡེ་མི་ཡོང་ཚུལ་རྒྱུན་མི་འཆད་ཕུལ་ནས།",
    "མུན་མུན་སྟོང་ཆང་ཆང་ཅིག་བྱུང་འདུགདེ་ནས་ཡར་ཡོང་རྟག་བརྟན་གྱི་འབྲས་སྤུངས་སུ་མཚམས་ཐུང་ཙམ་བྱས།",
    "མི་ཉན་པ་ལ་ཁ་ཏའི་དཔེར་འདུག་པས།",
    "སྔ་མ་ཞག་ལྔ་ཙམ་ལས་མི་བཞུགས་པའི་རྩིས་སུ་འདུག་ཀྱང་།",
    "གཞན་འདི་འདྲའི་རིགས་ལ་རང་འདོད་ཀྱི་ཞུ་དོན་མང་པོ་དབུ་ཚུགས་མུ་ཚུགས་བྱེད་པ་ཅིག་ཡོད་པར་འདུག་སྟེ།",
    "ཡིན་ཡང་ཡིན་པ་འདུགཧོར་ཟླ་བཅུ་པའི་ཚེས་བདུན་ལ་སྐུ་གདུང་ཞུས་འབུལ་བྱས་པ་ཡིན།",
    "དེར་འཚོགས་ཐམས་ཅད་ཀྱི་མཐོང་འདུགརབ་གནས་བྱས་པའི་སྐབས་ཀྱང་ཤིན་ཏུ་ཟིལ་ཆེ་བའི་རྣམ་འགྱུར་བྱུང་།",
    "དཔལ་རབ་ཀྱི་ཡིན་འདུག་པའི་སྔགས་ཐང་ཉི་ཤུ་སྐོར་ཅིག་སྟོན་པའང་གནང་།",
    "བཀའ་རྒྱུད་ཕོ་ཁྲོམ་ཚར་གཉིས་བཞེངས་པ་མཛད་འདུགཙན་དན་སྐྱེ་ལ་ཁད་ལ་སྲེད་དེ་མར་འགྱུར་གདའ།",
    "ཉང་སྟོད་གཞུང་ན་མར་ཡང་སྔགས་སྐུ་བཞེངས་ན་འཚུབ་ཡོང་ཟེར་བའི་ཁ་སྐད་ངན་པ་ཅིག་འདུག།",
    "དེ་ཙ་ན་སྔགས་སྐུ་བཞེངས་ཀྱི་དོགས་ནས་འདི་ལ་འཚུབ་ཡོང་ངོ་ཞེས་གདུག་འདྲེས་བསྒྲགས་པའི་གཏམ་དེ།",
    "ནུས་མཐུ་ཕན་ཡོན་འདྲ་ཆེན་པོ་ཏ་སུ་ལའང་མི་འདུག་སྟེ།",
    "སྔགས་ལ་ད་ལྟའང་ཅུང་ཟད་ཙམ་ཡོད་གཞན་ཚོ་ལ་མི་གདའ་བ།",
    "ཕྱག་ཆེན་དང་ཀ་མ་ལ་ཤཱི་ལའི་ལུགས་གཅིག་ཟེར་བ་སོགས་རྒྱལ་པོ་དམངས་སུ་འབེབས་པ་མང་པོ་འདུག་སྟེ།",
    "གྲྭ་རིགས་གྲོགས་མཆེད་མང་པོ་ཞིག་ནི་དྲི་ལོག་སྟེ་སྡོད་པར་འདུག་སྟེ།",
    "ཁག་ངན་འཁུར་དགོས་དང་དཀའ་ལས་ཡོང་གྲབས་འདུག་ན་འཁོར་མི་ཐེབས།",
    "དེའི་ཕྱིར་དུ་ཚོགས་པ་སྐྱོང་རིན་ཆོག་གསུང་བ་ཅིག་འདུག་པ།",
    "ཡིན་ནི་བྲག་དཀར་མགོན་པོའི་བཀའ་ཆད་རང་ཡིན་པ་འདུག་མ་ཕྱོགས་ཀྱི་རྒྱལ་ཞུད་ཡིན་ཟེར་བ་ཅིག་ཀྱང་འདུག་སྟེ།",
    "ཞེས་སོགས་དཔེའི་ཡེ་ཤེས་ལས་དོན་གྱི་ཡེ་ཤེས་ངོ་འཕྲོད་ཅིང་གསལ་བར་རྟོག་ཚུལ་ཅིག་གསུངས་འདུག་པ་དེ་ལ།",
    "བསྙུང་གཞི་དྲག་པོ་དེ་འདྲའང་ཡང་ཡང་ཐོག་བབས་ཡོང་པ་ཅིག་འདུག་པས།",
    "སྤྱི་བབས་བདེ་འགྲོས་རང་དུ་འདུག་ཅིང་།",
    "གསུམ་པོ་དེ་ནས་དེ་རིང་ཕེབས་མི་ཐུབ་པ་འདུགགནངས་བཞེས་ཅིག་གདན་འདྲེན་ལ་ཡོང་ཟེར་བ་མནལ་ལམ་མ་ཡིན་པར་གསལ་སྣང་དགོས་སུ་བྱུང་འདུགངས་སླེབ་དུས་ཐོག་མ་རང་ངོ་ཡང་མི་མཁྱེན་པ་ལྟར་འདུག་ཀྱང་།",
    "དེ་ཁ་ལ་བཞག་ན་ཕུ་མདའ་གཉིས་སུ་གོད་ཆེན་པོ་འོང་བར་འདུག་ནས།",
    "དེ་སྐབས་ཡོངས་པའི་ལག་རྗེས་དེ་ཁ་ཙམ་དུ་འདུགངེད་ལ་ཏ་འགྲོ་དོན་ནུས་པའི་སྐྱེས་བུའི་ཐ་སྙད་མེད་དེ།",
    "སྔར་མ་གོ་བ་འདྲ་ཁྲ་གསལ་གྱིས་གོ་བ་འདུག་ན།",
    "འཇིག་རྟེན་ལུགས་རང་ལ་ཕན་ཅི་རིགས་པ་ཡང་འདོགས་པར་འདུགཅིག་ཤོས་འདིས་ནི་འདི་ཕྱི་ཐམས་ཅད་དུ་སྡུག་བསྔལ་འབའ་ཞིག་རང་སྡུག་གཞན་སྡུག་འདིར་སྡུག་ཕྱི་མར་སྡུག་ལ་གཏོད་པར་འདུག་སྟེ།",
    "སྲིད་ཕྱོགས་སྒྲིགས་ནས་དམག་བྱུས་ལ་ཕན་པ་བྱས་པའི་བགྲོས་མི་གདའ།",
    "ཞེས་གསུངས་པ་ལ་ཐམས་ཅད་ཚངས་འདུག་པ་ཤེས་ལྡན་རྣམས་ཀྱིས་དཔྱོད་ཅིག།",
    "བདེན་གཏམ་ལ་བདེན་བསམ་པ་སྐྱེ་བ་ཡང་མི་ཡོང་བར་འདུག་སྟེ།",
    "ངས་ནི་ཁྱི་ལུད་དེ་འདྲ་ནོར་བུ་རང་ཤིན་ཏུ་ཡིན་པ་གདའ་ལགས་ཧ་ཡི་ཕ་ཕ་ཟེར་བ་མཁས་འཇུག་ཀྱག་ཁྲམ་དེ་འདྲ་སྔར་ཡང་བྱེད་མ་མྱོང་།",
    "སྤྱིར་མི་དམངས་ལ་ངེས་པ་མི་འདུག་ཀྱང་།",
    "སྐྱོན་ཡིན་པ་འདུག་ཀྱང་སྡུག་ཞེན་བྱས་ནས་ཡོན་ཏན་ཅན་དུ་སྒོམ་མཁན་ཅིག་མ་ཡིན།",
    "སྐབས་འདིར་ཡང་ར་ལུང་པ་ལ་ངེད་ཞེ་མ་སྡུག་ཡོད་ཀྱི་དོགས་པའི་རབ་བེ་རིབ་བེ་ཡིན་པ་འདུག་ནའང་།",
    "རང་ལ་མི་གནོད་པའི་བག་ཡོད་མཚམས་ཚིགས་ཟིན་པ་ཅིག་ནི་དགོས་རྒྱུར་འདུག།",
    "ཁོང་རང་རྣམས་ཀྱིས་ཡར་མར་དཀྲུགས་པ་ཡིན་ནའང་།",
    "ར་ལུང་ནས་སོགས་གཞན་རྣམས་ཀྱི་རྩར་ཁོང་རང་རྣམས་ཀྱིས་ལེགས་སམ་བྱས་གྱུ་བ་དང་།",
    "བརྟག་པ་ལ་ཆུག་གམ་མི་ཆུག་ཕེབས་ཀྱིན་འདུགབརྟག་པ་བྱས་དུས་ནི་ཕེབས་པ་ཆུག་ཅིང་།",
    "དབུས་ལ་ཕེབས་བསྐྱིལ་གྱི་སྐོར་ལ་གླེང་བརྗོད་སྣ་ཚོགས་ཅིག་འདུག་ཀྱང་།",
    "ལ་ལ་ཚོ་ཉེ་གནས་ཀྱིས་ལོངས་སྤྱོད་པ་ཅིག་གདའ།",
    "སྐུ་དོན་གསར་པ་གཞན་གང་ཡང་མི་འདུག་པས།",
    "དུས་ཐུག་པས་ཐེགས་གོང་སླེབས་མི་ཐུབ་པར་འདུག་ནས།",
    "དགྲ་ངོས་ལེན་བྱེད་རྒྱུའི་ཁུངས་བྱེད་ཀྱིན་འདུགངེད་ཀྱིས་སྔ་མ་ནས་གོ་སྟེ།",
    "གང་དང་གང་བསྒོམས་པ་དེ་དང་དེ་གསལ་བར་སྣང་བའི་ཚུལ་ནི་ལོས་ཡིན།",
    "དེ་ཙམ་ལ་རག་མ་ལུས་པའི་སྟོང་པ་དེ་མཐར་གཏུགས་ན་བདེ་བར་འདུགབདེ་བ་དེ་ཡེ་ཤེས་རྣམས་པ་མཐའ་ཡས་པར་རང་ཤར།",
    "ཤར་ཙམ་ཉིད་ནས་ཀུན་རྫོབ་གཟུང་འཛིན་གྱི་དྲི་མས་མ་གོས་པ་ཅིག་འདུག་པ་དེ་ཉམས་སུ་ནི་མྱོང་།",
    "དེ་ཙ་ན་གཞན་མཁས་པ་ཡིན།",
    "དེ་ལྟར་སྨོས་པ་དེ་དང་རྗེས་མཐུན་པ་ཙམ་ཀ་ལོས་ཡིན།",
    "ལན་ཅིག་བྱུང་ནས་ཉམས་རྒྱུ་ཡང་མི་འདུག་གོ།",
    "འདི་ཐུགས་རྡོ་རྗེའི་རིམ་པའི་གཟུགས་བརྙན་ཙམ་དུ་གདའ་ལགས།",
    "མེད་ཀྱང་རང་གཅིག་པུས་མི་ཕྱུགས་ཐམས་ཅད་འདེད་ཐུབ་པ་ཡིན།",
    "འདྲ་སྐུ་རང་ཡིན་ཟེར་ཡང་ཟེར་ཡིན་ཡང་ཡིན་ཡོད་པར་འདུགཞིབ་ཏུ་བརྟགས་ན་སྐུ་བཞུགས་དུས་ཀྱི་རྣམ་ཆ་ཡང་ངེས་པར་འདུག་ཅིང་།",
    "སྐྱེ་བ་འདིའི་ཕྱི་མ་ཅིག་ལ་ནྀ་དེ་ལས་ཀྱང་མི་འགྲུབ་པ་ཅིག་འདུགའོན་ཀྱང་ཞིང་ཁམས་རབ་འབྱམས་སུ་དུས་མཐའ་མེད་པའི་བར་དུ་སྒྲུབ་པ་ཡིན་ནོ།",
    "མགོན་ཁང་འོག་ན་ཕུར་པའམ་རྙིང་མ་ལྷ་ཁང་ཡིན་ཕེབས་པ་ཅིག་འདུག་པ་དེ་ལའང་ཉིན་གཅིག་རབ་གནས་བྱས།",
    "དེ་གོང་མ་གྲུབ་པས་དེ་ལོ་འཁྲིད་ཅིག་གནང་རྒྱུར་འདུག་པ་ལ་ཕན་ཐོགས་པར་མ་བྱུང་ཡང་།",
    "འདི་ཕྱོགས་ཕེབས་པའི་དུས་དང་ཉེ་བར་འདུག་ནས།",
    "དགོངས་བཞེད་ཀྱི་གཙོ་བོ་སྦྱོར་དྲུག་དང་ལམ་འབྲས་ཀྱི་སྐོར་སྔར་མ་གསན་འདུག་པ་དང་།",
    "ནེ་གུ་རགས་རིམ་ཙམ་གསན་འདུག་ཀྱང་།",
    "ལས་འབྲེལ་རྣམ་པར་དག་ཅིང་དམ་གཙང་བའི་རྟགས་ཅིག་ཅིས་ཀྱང་ཡིན་པ་འདུགའདི་སྐབས་ཀྱང་ཞིག་གསོས་ཕྲན་བུ་བྱེད་ཀྱིན་ཡོད།",
    "བཟོ་བོ་ལག་བདེ་ཤོས་རང་མི་འདུག་ཀྱང་ཞལ་རས་མཚར་ཞིང་ཚུགས་ཀྱང་བཟང་བར་བྱུང་།",
    "ལར་ཁོང་པ་ལ་ནོར་ཆེན་པོ་ཡོད་འདུག་ཅིང་།",
    "ཤི་རྗེས་ནོར་ཐམས་ཅད་ས་སྐྱ་རང་ནས་བཞེས་འདུག་པས།",
    "རྒྱུ་གང་ཡིན་ཡང་མི་ཤེས་པའི་རིགས་གཅིག་བྱུང་འདུགནོར་ལ་མིག་ཉི་ཤོས་འདི་ཚོ་ཀ་ཞེད་པར་གདའ།",
    "སྒྲུབ་གནས་ཆེན་པོའི་བླ་བྲང་རྙིང་པའི་གདོང་དེ་ན་ཐབ་ཚང་སོགས་ཁང་པ་སྐྱལ་སྐྱོལ་འཇིགས་ལ་ཁད་དུ་མ་འདུག་པ་རྣམས།",
    "ངེས་པར་མཇལ་དགོས་འདུག་གསུང་།",
    "ཞལ་རས་སྐུ་གཟུགས་ཀྱི་གཙོ་བོར་འདུག་པས།",
    "ཞལ་རས་ལ་གྲང་གསེར་འབུལ་བའི་རྩིས་ཀྱི་ཟངས་དམར་དུ་འཇོག་པའི་སྲོལ་ཞིག་དུས་ཕྱིས་ཕལ་ཆེར་ལ་འདུག་སྟེ།",
    "འགངས་མེད་བྱས་ཀྱང་ཐམས་ཅད་དེ་ཀ་ལ་རྡིབ་ནི་འགྲོ་བ་ཅིག་འདུགདེ་བས་ཕཊ་ཅིག་རྒྱག་པ་དགའ་བ་ཡིན།",
    "རང་ལ་མེད་ཙ་ན་དེ་ལས་ཐབས་མི་གདའ།",
    "འདུག་ནི་བླུན་རྟགས་ཀྱི་གཏམ་དུ་འདུག་སྟེ།",
    "གླེན་པ་རྣམས་ཀྱི་རྣེ་མཆོག་ཏུ་དེ་འཛུལ་བ་ཅིག་ཀྱང་གདའ།",
    "ཡ་མཚན་ཅན་དགུ་བཅུ་རྩ་དྲུག་རང་དུ་འདུག་གོ།",
    "ཐ་གུ་སྣ་དབུས་གཙང་ལ་མི་སྣར་ཡོང་རིགས་སུ་འདུག་པས།",
    "ཐེག་ཆེན་གྱི་ལམ་རིམ་ཟབ་ལ་རྒྱ་ཆེ་བ་གོང་ན་མེད་པར་འདུག་པས།",
    "སྐུ་ཤིན་ཏུ་ལྟེམ་པར་འདུག་ནའང་ཐུགས་རིག་དྭངས་བར་འདུག་ཅིང་།",
    "དེ་རྗེས་ཉི་མ་གཉིས་བསྙུངས་གཞི་རང་ནི་ཆུང་ངུ་མི་འགྲོ་འདུག་ནའང་།",
    "གང་ཡོད་ལ་ནི་ཟ་འདྲེ་ལས་ངན་གྱི་བསྐོས་བ་པོ་གདའ།",
    "ཐོད་པ་གཉིས་སུ་བདུད་རྩི་མང་དུ་བབས་འདུགམཚན་ལྡན་ཐོད་པ་ཅིག་ན་བདུད་རྩི་དམར་པོ་ཤས་ཆེ་བ་དང་།",
    "ཤིན་ཏུ་ཁོགས་འདུག་པས་བརྟན་བྱེད་ཀྱི་ཐབས་དང་།",
    "ཁང་གཡོག་དེ་རྙིང་པའི་དུས་ན་ཉིས་ཐོག་ཏུ་འདུག་ཀྱང་།",
    "རྡོ་རྗེ་གདན་པས་མཛད་པར་བརྫུས་པའི་སྟོད་པའི་ལུགས་དེ་སྔ་ཕྱི་ཀུན་ཏུ་དར་བར་འདུག་ཀྱང་།",
    "རྣམ་འགྱུར་གང་ཡང་མི་ཡོང་བ་འདྲ་ཅིག་འདུགཡོན་ཏན་སྣ་ཚོགས་སྐྱེ་བའི་ཉམས་ལ་ནི།",
    "ལ་ལ་ཟེར་ན་རྟོག་གེ་མགོ་མཁྲེགས་པོ་ཞིག་འདུག་ཟེར།",
    "ལ་ལ་ཟེར་ན་འཁྲུལ་ཞིག་ལྷོད་གྲོལ་བ་ཞིག་འདུག་ཟེར།",
    "ལ་ལ་ཟེར་ན་ལྟ་སྤྱོད་ངན་པ་ཅིག་འདུག་ཟེར།",
    "ལ་ལ་ཟེར་ན་བསམ་ངན་འཇིག་རྟེན་པ་ཅིག་འདུག་ཟེར།",
    "རྣམ་པ་ཐམས་ཅད་པ་ཞེས་པ་དེ་ཡིན་ཉེན་གདའ།",
    "ཉམས་འོག་ཏུ་ཆུད་པ་རྐྱང་ཀ་འདུག་གོ།",
    "ཟླ་ཚེས་གང་ཡིན་བརྗེད་གདའ།",
    "སྐུ་ཐིམ་འགྲོ་བའི་ལྟས་སུ་འདུག་སྙམ་པ་གཅིག་དེ་འདུས་ཀ་བྱུང་།",
    "སྐུ་དོག་སེལ་བ་ལ་དཀའ་ཚེགས་ཆེན་པོ་རང་མེད་རིགས་སུ་འདུག་ནའང་།",
    "ངེད་ལ་མི་གནོད་འདྲེར་འཛིན་བྱེད་ཀྱིན་འདུག་པས།",
    "ཁོང་རང་ཡུམ་སྲས་ཀྱིས་སྐྱོང་བའི་ས་ཆ་ནས་གཅོད་རྒྱུ་ནི་མིན།",
    "དགག་པ་མི་དགོས་པ་འདུག་སྟེ།",
    "ཕྱིས་རྟིང་ཁོང་རང་འདའ་ཁར།",
    "བྱང་བུ་གཅོག་པ་ཡང་ངེད་ལ་ཕུལ་ཟེར་བའི་ཁ་ཆེམས་བཞག་འདུགཤུལ་མ་ཚོས་ཀྱང་དེ་ཁ་བཞིན་བྱེད་རྩིས་བྱས་པ་ཀ་ཡིན།",
    "ངམ་རིང་རང་ནས་ནི།",
    "ཁྱད་པར་དུ་ཡང་ལྕམ་དྲུང་རང་བསམ་འགྲུབ་རྩེར་ཡང་ཡང་ཕེབས་པ་ཀུན་ལ།",
    "ངམ་རིང་རང་དུ་བཞུགས་དུས་ཀྱང་།",
    "ཁོང་རང་དཔོན་གཡོག་ཕལ་ཆེར་འདུས་པའི་གྲོས་ལ་བསྲུང་འཁོར་ཁྱད་དང་།",
    "གནས་བཟང་བའི་སྟབས་རི་ཁྲོད་ཆེན་པོར་བསྙེན་པ་ཞིག་མཛད་ན་ལེགས་ཟེར་བ་གྲོས་མཐུན་འདུག་པ།",
    "ལར་ནས་དུས་ཕྱིས་ཁྲོམ་ལ་གྲགས་པའི་སྐད་ཆ་ཀུན་གསང་གསང་བྱེད་པའི་སྲོལ་ཅིག་འདུག་པས།",
    "དེ་མཐུན་ལྕམ་དྲུང་རང་ཇོ་ནང་དུ་ཕེབས།",
    "མགོན་ཁང་ནི་རྡིབ་ལ་ཁད་རང་འདུགདེ་ན་ད་དུང་རྟེན་ངོ་མཚར་ཅན་འདྲ་ནི་བཞུགས་འདུགཟངས་དཀར་ལོ་ཙཱ་བས་བཞེངས་པའི་རྡོར་དབྱིངས་ལྷ་ཁངདེ་ཁ་ཆེའི་ལུགས་སུ་འདུག་ཅིང་།",
    "ལྷ་སའི་དཀྱིལ་འཁོར་སྟེང་ན་ཟངས་དཀར་གྱིས་བཟོ་བཀོད་ཅིག་མཛད་འདུག་པ།",
    "མ་བབས་ཐུགས་ཁོག་འཚབ་པའི་སྟབ་སྟོབ་ཀྱི་གསུང་དུ་འདུག་ནའང་།",
    "ཕུགས་ཀྱང་ཟར་ཟིར་གྱི་རྒྱུ་ཁོ་ནར་འགྲོ་བ་འདུག་པས།",
    "སྐུ་ཚེ་ཧྲིལ་པོ་བཟང་བཙོན་དུ་བཞུགས་དགོས་ཀྱི་སྒོ་དོད་པ་དེ་ཁར་འདུག་ཀྱང་།",
    "དེ་སྐབས་རང་དེ་འཇིགས་པ་ཆེན་པོ་ལས་ཐར་བ་དེས་ཞབས་དྲུང་རང་ཡང་ཐུགས་དགྱེས་བཞིན་དུ།",
    "ཞབས་དྲུང་རང་བཞུགས་ཡུལ་རྟག་བརྟན་རང་དུ་རྒྱུན་བཞུགས་མཛད་དགོས་གསུང་བ་ཡོད་ནའང་།",
    "ཞབས་དྲུང་རང་དང་དགོས་པ་དཔོན་གཡོག་གཉིས་ཀྱིས་དགོས་མེད་ལ།",
    "གཞན་ཡང་ཟར་ཟིར་ཡ་རི་མ་རི་མང་པོ་ཡོང་རྩིས་འདུག་པས།",
    "དཔྱིད་ཀ་དེ་ཞབས་དྲུང་རང་རྟག་བརྟན་དུ་གདན་འདྲེན་དགོས་བྱུང་།",
    "གཞུང་དེ་གོ་ཞིག་ཤེས་པ་སྲིད་མཐའ་ཙམ་མིན་པ་མི་ཡོང་བར་འདུག་པས།",
    "གཞུག་བློ་ལ་གཟུང་བ་ཚོ་ལ་གོ་བ་ལེགས་རབ་ཤར་བ་ཡང་གདའ།",
    "དེ་རྗེས་བསྙེན་རྫོགས་སྒྲུབས་ནས་སྟོད་ཕྱོགས་ལ་འབྱོན་བཞེད་ཅིག་འདུག་ནའང་།",
    "ཐ་ན་གཉེན་ཁ་ཙུན་ཆད་བྱེད་པའི་སྲོལ་ཅིག་དུས་ཕྱིས་ཡུལ་ག་ནའང་འདུགཁྱད་པར་སྟོད་ཕྱོགས་ཀུན་ན་དེ་ལྟ་བུ་ངོ་མཚར་ཆེ་ཞིང་བཟང་བར་རྩི་བ་ཅིག་ཡོད་འདུག་པའི་སྤྱན་ཤུགས་དང་།",
    "དེ་ངེད་ལ་ཁག་བསྐུར་ན་ངེད་ཚོ་ལ་སྨད་ར་རྒྱ་ཆེ་གཏིང་ཟབ་རང་ཡོང་རྒྱུའི་ཁུངས་ཀྱིས་སྨྲས་པས་ཡིན་པར་འདུག།",
    "ད་ལྟ་ཡང་དཔག་ཏུ་མེད་པ་ཅིག་ཡོང་ནི་ཡོད་པར་འདུགངོས་ནི་སུས་ཀྱང་མི་ཟིན།",
    "ད་དུང་སྐྱོང་བ་ལ་དཀའ་ལས་མི་འདུག་ཀྱང་།",
    "དཔལ་ཇོ་ནང་པའི་ལུགས་འདི་ད་ལྟ་ནུབ་ལ་ཁད་འདུག་པ་ཅུང་ཟད་གསོ་ཐུབ་ན།",
    "ཁྱད་པར་གཉེན་བསྒྲིགས་བྱེད་དགོས་ཚུལ་སོགས་འདུགངེད་རང་རྟོགས་ལྡན་ལ་མཛུ་གུ་འཛུགས་རྒྱུ་ཞིག་མི་འདུག་ཀྱང་།",
    "ཞེས་པའི་དོན་ཐུགས་ལ་འཁྲུངས་ན་ནི་ཕོ་སྐྱེས་རྒྱབ་གདའོ།",
    "སྐུ་དབྱིངས་སུ་ཐིམ་པའི་དུས་ངེས་ཅན་རྫུན་མེད་རང་ཅིག་ནི་རྫུ་བག་མང་གྲགས་པས་ཐིངས་པ་དཀའ་བ་འདུགདབྱར་སྨད་དེ་སྐུ་རིམ་ཡིན་ཟེར་བ་མང་བསྐོལ་མང་རབ་མཛད་འདུག་པའི།",
    "འབྲི་ཁུང་རིན་ཆེན་དཔལ་སོགས་ཀྱི་སྤྱན་ལྟོས་ཀྱི་གཞུག་དེ་ད་རུང་འདུགབླ་ཆེན་བཅོལ་ན་བླ་ཆེན་ཕེར་པ་དེ་བཀའ་བརྒྱུད་པ་འདི་ལ་ཀ་གདའོ་སྙམ་པ་ཅིག་བྱུང་།",
    "ཁྲོ་ཕུར་ཕེབས་འདུག་པས་གཞི་བྱེས་ལ་མང་ཇ་དང་།",
    "དགྱེས་པའི་ཚུལ་གྱི་གསུང་ཕེབས་ཁྲལ་ཁྲོལ་དུ་མཛད་ཀྱིན་ཡོད་འདུག་ཅིང་།",
    "ལྕི་ཐང་ཐང་འགྲངས་མ་གཙང་པོ་དེ་འདྲ་མིན་པའི་འབྲེལ་འཚོལ་བ་ལ་སྤྲོ་བ་སྐྱེས་ཡོད་པའི་རིགས་ཡིན་པར་དེར་འདུག་ལགས།",
    "ཅིས་ཀྱང་ཡོང་དགོས་འདུག་གསུང་ཕེབས།",
    "དར་ཐུབ་པའི་ནུས་པ་ནི་ང་རང་ལ་ཡང་མི་གདའ་སྟེ།",
    "རྒྱུད་པ་ཆད་ནས་རིང་ཞིག་ལོན་གདའ།",
    "འདྲ་རུང་བ་སྙམ་པ་ཅིག་ནི་འདུག་ཡང་འདུག་གོ།",
    "ཁོ་བོ་ལ་ཡང་སྨད་རའི་ཁུངས་ཀྱིས་མངོན་སྤྱོད་ཀྱི་ལས་བྱས་སོ་ཞེས་སྟོད་སྨད་འདི་ཚོ་ན་ཡང་ཡང་ཟེར་བ་འདུགདེ་རྣམས་ལ་སྨྲས་པ།",
    "ཅེས་བྱ་བ་ཅིག་མི་གདའ་འམ།",
    "ཁྲི་ཁྲག་དགུ་ཡི་གཙོ་བོར་འདུག་གྱུར་ཀྱང་།",
    "ང་རང་གར་འགྲོའི་གདེང་མེད་པ་ལ་ཟེར་བའི་རྩི་བཅུམ་བཅུམ་དེ་འདྲ་ཡང་ཤེས་འདོད་ལ་མེད།",
    "དེའི་རིགས་འགྲེ་ངེད་ལ་འགེབ་པར་འདུག་སྟེ།",
    "མཐུ་ཆེ་ཆེ་ཟེར་བ་དེ་རྣམས་དེ་འདྲ་ནི་མིན་པ་འདུགདེ་འདྲ་ཡོད་པ་ཚོལ་དགོས་ན་ནི།",
    "ལར་རྨོངས་པ་ལྟ་ཞོགམཁས་མཁས་ཀུན་ཡང་གཞན་གྱི་ཟེར་སྒྲའི་རྗེས་སུ་འབྲང་བ་ལས་མི་འདུགརྗེས་ཟློས་སྣ་ཚོགས་བྱས་པ་དང་།",
    "ལམ་སྐོར་བ་རྣམས་ཡུལ་སྣ་ཚོགས་ཀྱི་བདུད་རྩི་བསྟེན་པ་ཟར་བ་དེ་ཡང་བདེན་པར་འདུགལོ་སྔ་མའི་སྟོན་ཀ་དང་།",
    "ཁོང་རང་ཡོད་དུས་ནས་ངེད་ལ་སྦྱར་ཡིག་དང་བཅས་བྱིན་པ་ཡིན་ནའང་།",
    "ངན་ལན་ཏེས་འཛིན་བྱེད་རྒྱུ་ཡིན་ན་ཏ་ལས་བླ་བར་འདུག་སྟེ་ག་ལ་བྱེད།",
    "སྤྲེའུ་འཁྲབ་འཁྲབ་མཛད་ཀྱི་འདུག་ཟེར།",
    "ཀྲོག་ཤུ་ལངས་པ་གསུམ་ཀྱི་རྟགས་ཐམས་ཅད་བསྟན་པར་གདའ།",
    "ཁོང་རང་ཡང་ཉམས་རྟོགས་བཟང་ཞིང་སྒྲུབ་གྲྭ་འདི་ཡང་བཙུགས།",
    "དེ་དུས་ཨེན་གསོད་མ་ནུས་པས་ཕུང་བྱུང་ཟེར་གྱིན་ཡོད་པར་འདུག་གོ།",
    "འདི་སྐབས་བྱང་ནས་ལྕམ་དྲུང་ས་སྐྱར་ཕེབས་རྒྱུ་ཡིན་འདུགམི་དམངས་རྣམས་བར་བིར་དུ་ལབ་པ་ལ།",
    "དཀར་རྩི་དང་ནག་ཡུག་ནོར་གདའ།",
    "དེ་ཉིན་ཀ་བླ་ཆེན་ཡེ་ཤེས་དྲུང་སྐུ་སྙུང་བའི་འགོ་བརྩམས་པར་འདུགགངས་དེ་འཚུབ་འགྱུར་ཆེན་པོ་དུག་ཆར་གྱི་རྣམ་པར་འདུགཟླ་བ་གསུམ་པའི་འགོ་ལ་རྟག་བརྟན་དུ་ཕྱིན།",
    "ཡང་གཞིས་ཀ་རྩེ་ནས་འབོད་མི་ནན་ཆགས་གནང་ཧོར་ཟླ་བཞི་པའི་གུང་དཀྱིལ་ལ་སླེབ་དགོས་ཚུལ་འདུག་པས།",
    "བྱང་ཐང་ལ་དམག་ཆེན་མཛད་དགོས་སྟབས་སོགས་མ་ཕྱོགས་རང་ན་ཐུགས་བྲེལ་ལངས་འདུག་པས།",
    "ས་ཡུལ་གཉན་པ་ཞིག་ཡིན་འདུག་པས་བརྟག་པ་ལ་མ་ཐོན།",
    "ཁོང་པ་འདི་སྔོན་མ་ནས་གཡས་ཡོང་གཡོན་ཡོང་རང་མི་གསུང་བ་ལ།",
    "རིམ་ལྔ་སྨར་ཁྲིད་ཀྱི་རྩ་བ་རང་ཡིན་པ་འདུག་གནའང་།",
    "སྔོན་ཆད་འགྲེལ་པ་མི་འདུག་པས་འདི་ལ་ཊཱིཀ་ཁ་གསལ་ཅིག་བྱེད་དགོས་ཕེབས་པ་ལྟར་འཕྲལ་དུ་རྩོམས་པ་བྱས་ཏེ་ཕུལ།",
    "ལྕམ་དྲལ་གཉིས་ལ་ཇ་གྲལ་དང་མགྲོན་གཏོང་རྒྱུའི་ཁུངས་བྱེད་ཀྱིན་འདུག་པ་གསལ་པོ་རང་ཞིག་བྱུང་།",
    "བརྟན་པོ་མ་བྱུང་འདུག་ཅིང་།",
    "འོན་ཀྱང་སྔ་སོར་ནན་ཆགས་ཡང་ཡང་རང་གནང་བ་དེ་ལ་འགྲོ་མ་ཐུབ།",
    "སྔ་གོང་ངེད་གཞོན་དུས་གཅིག་ཙ་ན།",
    "དེ་ཀ་ཡིན་པ་འདུག་བསམས་ཆེད་ཀྱི་མཇལ་ཁ་ཞུ་བ་མ་བྱུང་།",
    "ངེད་ཀྱི་ལུས་ལོངས་སྤྱོད་ཡོང་དཀྲུགས་པའི་ཕར་མགོ་འབུལ་ལོ་འབུལ་བྱེད་དགོས་རྒྱུའི་ཁུངས་ཀྱི་ཧ་མ་ཧ་མ་ཐར་ཐར་བྱེད་པ་འདུགདོན་ལ་ནི་ངེད་སྔ་གོང་ཕྱོགས་ཀུན་ཏུ་འཁྱམས་དུས།",
    "བཀའ་བརྒྱུད་རྟོགས་ལྡན་འ་གད་ཅིག་ཡིན་པ་འདུག་ཟེར་ན་ནི་གཞོགས་གཅིག་ནས་འདྲ་རུང་ཡིན།",
    "ཏི་ཐུག་ཏི་ཐུག་ཟེར་བར་གདའ།",
    "གཞན་ལ་ཁག་བསྐུར་རྒྱུ་ཡེ་མི་གདའ།",
    "འགྲོ་འདུག་ལངས་སྡོད་གང་ཡང་མ་ཐུབ།",
