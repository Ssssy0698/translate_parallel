    "ངན་སོང་དུ་སྐྱེ་དཀའ་ཞིང་སྐྱེས་ནའང་མྱུར་དུ་ཐར་བ་དང་།",
    "རིན་ཆེན་དག་གིས་ཀུན་བཀང་སྟེ།",
    "གང་གིས་ཐལ་མོ་སྦྱར་བགྱིས་ཏེ།",
    "བ་སྐལ་བ་དུ་མའི་བར་དུ་རྨད་དུ་བྱུང་བའི་མཁྱེན་རབ་ཀྱིས་ཆེས་ཕྲ་བར་བྱས་ཏེ་ལམ་རྣམས་ལ་དཔྱད་པ་ན་འདི་ཉིད་འཚང་རྒྱ་བའི་ཐབས་དམ་བར་རྒྱལ་བ་སྲས་བཅས་ཀྱིས་གཟིགས་པའི་ཕྱིར་རོ།",
    "དེ་མ་དོར་ན་འདོད་ཡོན་ལ་འཛེམ་མེད་དུ་སྤྱོད་ཀྱང་བྱང་སེམས་ཀྱི་ཐུན་མོང་མ་ཡིན་བའི་སྡོམ་སེམས་མ་རལ་བ་ཡིན་བའི་ཕྱིར་རོ།",
    "བདག་གིས་སྦྱིན་སོགས་བགྱིས་བ་འདི་དག་གིས།",
    "ཅེས་པ་སྟེ་ལན་གསུམ་གསུམ་མོ།",
    "མེ་ཡི་དྲོད་མ་ཡལ་བ་ཡུན་རིང་དུ་གནས་པ་ལྟར་སེམས་བསྐྱེད་པའི་དྲོད་མ་ཡལ་བར་རང་གི་བྱ་བ་གང་ཡོད་ལ་ཞུགས།",
    "ངས་གཞན་ལ་ཁ་ངན་ཚིག་ངན་ཤོར་སོང་བསམ་པ་དང་།",
    "སྒོས་སུ་བོད་མི་རིགས་ལ་དམ་པོ་བྱེད་པ་དེ་འདྲ་མང་པོ་ཞིག་བྱུང་གི་ཡོད་ན་ཡང་དེ་འདྲ་ལ་དམིགས་ནས་ཁོང་ཚོར་སྡུག་བསྔལ་ཞིག་ཡོང་བར་ཤོག་བསམ་མཁན་དེ་མི་ཐབས་རྡུགས་དང་།",
    "དེ་ལྟར་བསམ་པ་དེ་བསམ་བློ་གཏོང་ཚུལ་ནོར་འཁྲུལ་ཅན་རེད།",
    "འཕྲལ་དུ་ངོ་རྒོལ་དང་གདོང་ལེན་བྱེད་དགོས་མོད་ཀྱང་།",
    "སེམས་ཀྱི་གཏིང་ནས་བརྩེ་བ་འདོར་མི་ཉན་པ་དེ་གལ་ཆེན་པོ་རེད།",
    "བདག་གིས་སྦྱིན་སོགས་བགྱིས་པའི་ཚོགས་རྣམས་ཀྱིས།",
    "ཁ་གཏད་གཅོག་དགོས་ནའང་སེམས་ཀྱི་གཏིང་ནས་དེ་དག་གི་ཆེད་དུ་ཕན་པའི་བསམ་པ་བསྐྱེད་དགོས།",
    "ཞེ་སྡང་གིས་ཀུན་ནས་བསླངས་ནས་བརྗོད་པ་དགོས་བར་བཞེད་པ་ནི་འགྲེལ་བ་དང་མཐུན་ནོ།",
    "རྒྱལ་བ་ཡེ་འབྱུང་གིས་རག་མར་གཏོང་བ་ལ་སྔོན་ལ་སྟོད་ལུངས་སུ་གཏོང་བྱས་ནས་བྱིས་རག་མ་ཅི་བདེར་ཁས་བླངས་པ་ལྟ་བུ་ཡིན་གསུང་ངོ།",
    "སྒྱུ་ནི་ཡོན་ཏན་མེད་བཞིན་དུ་ཡོད་པ་ལྟར་སྟོན་བ་དང་གཡོ་ནི་རང་གི་ཉེས་པ་སྦས་པའི་དོན་ཡིན།",
    "བྱ་བ་ནི་དེ་ལ་སྲོག་གམ་ཐ་ན་བཞད་གད་ཀྱི་ཕྱིར་ཡང་ཤེས་བཞིན་དུ་རྫུན་སྨྲ་བ་སྦོང་བ་སྟེ་དེ་ལྟར་བྱས་ན་རང་གི་མཁན་སློབ་སོགས་ཡུལ་ཁྱད་བར་ཅན་ལ་བརྫུན་གྱིས་མགོ་བསྐོར་བ་མི་འབྱུང་ངོ།",
    "གནས་ཚུལ་གཞན་རེད།",
    "རི་དྭགས་གསོད་མཁན་ཞིག་གིས་རི་དྭགས་གཅིག་དེད་ཡོང་ན།",
    "རང་གི་རི་དྭགས་དེ་མཐོང་ཡང་།",
    "རི་དྭགས་དེ་གང་དུ་བྲོས་སོང་ཞེས་དྲིས་པ་ན།",
    "གཞན་དོན་སྒྲུབ་པའི་ཆ་རྐྱེན་དུ་ལུས་ངག་གི་ལས་ལ་གནང་བ་ཡོད་གསུངས་པ་བཞིན་དེ་ལྟར་བྱུང་སྲིད་པ་ཡིན།",
    "འདི་ལེགས་པོ་རེད་བསམ་པས་རང་གི་སེམས་ཀྱི་གཏིང་ནས་དེ་དག་ལ་བསྔགས་པ་བརྗོད་དགོས།",
    "སུ་འདྲ་ཞིག་ལ་ཡིན་ནའང་དོན་དུ་འགྱུར་བའི་གོ་སྐབས་བྱུང་ཚེ་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་རྣམ་མཁྱེན་རྒྱལ་བའི་ས་ལ་བགྲོད་པའི་ཐབས་ཤེས་བྱས་ནས་རྫོགས་བྱང་གི་ལམ་ལ་འཇུག་པར་བྱེད་དགོས།",
    "ཁྱོད་ཀྱིས་ཡོང་གི་མ་རེད།",
    "ཁྱོད་ཀྱིས་བྱེད་ཐུབ་ཀྱི་མ་རེད།",
    "གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་གཞན་རྣམས་ཀྱང་རྫོགས་བྱང་གི་ལམ་ལ་འགོད་ཨེ་ཐུབ་ལྟ་དགོས།",
    "དགྲ་ནང་ན་འདུག་པའི་ཉོན་མོངས་ཐུལ།",
    "ཕྱོགས་བཞིར་སོང་ནས་མ་བརྗོད་ན་ཉེས་བར་འགྱུར་བ་ནི་མིན་ནོ།",
    "དེ་ཡང་རང་གི་ངོས་ནས་གདུལ་བྱ་དེ་ལ་སྒྱུར་བ་དགོས་ཀྱི།",
    "སྨོས་ཅི་འཚལ་བར་གང་གིས་འགྱུར།",
    "ལན་དྲུག་ལེན་བ་དང་ཚོགས་གཉིས་ལ་སློབ་བ་ཉམས་ནའང་ཉམས་བ་ཙམ་གྱི་རྒྱུ་ཡིན་བས་གཏོང་རྒྱུ་བྱུང་ན་སྨོན་སེམས་ལེན་པའི་ཆོ་ག་སྐྱོར་ལ།",
    "བྱང་སེམས་ལ་ཞེ་སྡང་གིས་ངན་སྨྲས་ཅུང་ཟད་བརྗོད་པ་དང་གཞན་གྱི་དགེ་རྩ་བྱས་པ་ལ་འགྱོད་པ་ཅུང་ཟད་བསྐྱེད་ནས་འགྱོད་པ་མེད་བར་ཐུན་ཚོད་འདས་ན་བྱང་སེམས་ཀྱི་སྡོམ་བ་གཏོང་བར་འགྱུར་ཏེ།",
    "དེ་དག་གིས་སྨོན་སེམས་གཏོང་ལ་སྨོན་སེམས་བཏང་ན་སྡོམ་བ་གཏོང་བར་བྱང་ས་དང་བསླབ་བཏུས་གཉིས་ཀ་ནས་གསུངས་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་རང་གི་ལུགས་ནི།",
    "དེ་ལྟར་སྨོན་པའི་སེམས་བསྐྱེད་ནས་སྦྱིན་པ་ལ་སོགས་བའི་བསླབ་པར་བྱ་བ་ལ་མི་སློབ་པ་དེ་ཡང་བྱམས་བའི་རྣམ་བར་ཐར་བའི་ལུང་སྔར་དྲངས་བ་ལྟར་ཕན་ཡོན་ཆེ་མོད་ཀྱང་།",
    "གཞན་དོན་བྱེད་པ་ལ་གཞན་དོན་བྱེད་པའི་ཐབས་དེ་སྔོན་ལ་རང་གིས་ཤེས་པར་བྱེད་དགོས།",
    "དེ་སེལ་བ་ལ་སྡུག་བསྔལ་དང་བྲལ་ན་སྙམ་བའི་སེམས་བཟང་བས་མི་ཆོག་གི།",
    "ཕྱིན་དྲུག་གི་ལམ་ལ་བསླབས་པ་འདི་ཉིད་ཡིན་ལ།",
    "ལམ་ཕྱོགས་རེ་བར་མ་སོང་བའི་ཕྱིན་དྲུག་གི་ལམ།",
    "དེ་མ་བྱུང་བར་ཐབས་ཤེས་རེ་རེ་བ་ལ་བསླབས་པས་མི་ཡོང་ངོ།",
    "རྒྱུ་ནོར་བ་ལ་ནན་ཏན་དུ་བྱས་ན་ཡུན་ཤིན་ཏུ་རིང་མོ་ཞིག་གིས་ཀྱང་འདོད་བའི་འབྲས་བུ་འཐོབ་བ་མེད་དེ།",
    "གསེར་སྒྲོག་དང་ཐག་སྒྲོག་གིས་བཅིངས་བ་དང་།",
    "ཁྱི་དཀར་ནག་གང་གིས་ཕུག་ཀྱང་སྡུག་བསྔལ་བསྐྱེད་བ་དང་འདྲའོ།",
    "གང་ལྟར་ཕྱིན་ཅི་ལོག་རེད་ཅེས་དཔེ་འདྲ་མི་འདྲ་ཞིག་བཀོད།",
    "ཅི་ཡང་མི་སེམས་པར་ཞི་གནས་ལ་དམིགས་པའི་འཇོག་སྒོམ་ལྟ་བུ་བྱེད་པ་དེ་ཡིན་པ་རེད།",
    "དེ་ལྟར་བྱས་ནས་ཞི་གནས་སྒྲུབ་པ་ཞིག་ཡོད་མོད།",
    "ལྷག་བསམ་དེ་དག་གིས་དྲངས་པའི་སེམས་བསྐྱེད།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་ནི་ཉོན་མོངས་བ་ཐམས་ཅད་སྤང་བར་འགྱུར་བ་ལགས་སོ།",
    "དེ་ཤེས་རབ་ཀྱི་ཤེས་བས་ནི་ཉོན་མོངས་བ་ཐམས་ཅད་ཡོངས་སུ་འདོར་རོ།",
    "གང་ལྟར་གཞན་དོན་སྒྲུབ་པ་ལ་ཐབས་ཤེས་མ་ནོར་བ་ཞིག་དགོས་པ་ཙམ་དུ་མ་ཟད་ཐབས་ཤེས་ཡ་བྲལ་དུ་སོང་ནའང་མི་འགྲིག་པར་གསུངས།",
    "ཅེས་ཁ་ཅིག་གིས་མགོ་འབྲི་ཤེས་ཀྱི་གཞན་མི་ཤེས།",
    "ཁ་ཅིག་ལག་པ་ཤེས་ཀྱི་གཞན་མི་ཤེས་པ་ལ་སོགས་བའི་རི་མོ་མཁན་མང་བོ་འཚོགས་ནས་རྒྱལ་པོའི་གཟུགས་འབྲི་ན།",
    "ཀ་ཤིའི་རྒྱལ་བོར་གྱུར་བ་གང་ཡིན་བ་དེས་ཕུག་རོན་གྱི་ཕྱིར་རང་གི་ཤ་ཁྲ་ལ་སྦྱིན་པ་དེ་ཤེས་རབ་འཆལ་བ་ཡིན་ནམ།",
    "ཁྱོད་ཀྱིས་ཀྱང་བསྐལ་པ་དྲུག་ཅུར་སྦྱིན་བའི་ཐ་རོལ་ཏུ་ཕྱིན་ཐ་ཡང་དག་བར་བསྒྲུབས།",
    "རང་གི་སྟོན་པའི་སྔོན་གྱི་སྐྱེས་རབས་བཟང་པོ་རྣམས་ལ་དེ་དག་གི་ངེས་དོན་མ་གོ་བའི་དུས་ཡིན་ནོ་ཞེས་སྐུར་བ་འདེབས་པ་ཡིན་ནོ།",
    "ཕྱག་ཆེན་བསྒོམས་ན་དེ་ཉིད་ཀྱིས་འགྲིག་ཅེས་པ་ལྟ་བུ་ཤ་སྟག་ཏུ་སོང་ན་མ་འགྲིག་པ་རེད།",
    "དེ་དག་གི་དོན་རྗེ་བཙུན་མ་ཕམ་བ་དང་ཀླུ་སྒྲུབ་དང་ཐོགས་མེད་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བཀྲལ་བས་རྣམ་པ་གཞན་དུ་དྲང་བར་མི་ནུས་བའི་བྱིར་རོ།",
    "ཏིང་ངེ་འཛིན་ཕྲ་མོ་རེས་ཆོག་ཤེས་བྱས་ནས་གཞན་རྣམས་འཇོག་པ་ནི་མཁས་བའི་བཞད་གད་ཀྱི་གནས་ཡིན་ནོ།",
    "རེ་རེའི་ནང་དུ་དྲུག་དྲུག་འདུས་བར་གསུངས་པས་དེ་ཙམ་གྱིས་ཆོག་པར་འདོད་ན་འོ་ན་མཎྜལ་འབུལ་བ་ལའང་།",
    "བུ་གཅིག་པ་ལྟ་བུ་ཤི་བ་ན་མ་དེས་དངོས་སུ་འགྲོ་འཆག་ཉལ་འདུག་གི་སྐབས་སུ།",
    "སྤྱོད་ལམ་སོ་སོར་བྱེད་ཀྱི་ཡོད་ནའང་བློའི་ཟུར་དུ་བུ་ཤི་བའི་སྡུག་བསྔལ་གྱིས་ཨ་མའི་སེམས་ལ་རྟག་ཏུ་སྐྱོ་ལྷང་ངེར་གནས་དགོས་པ་ཞིག་བྱུང་ཡང་།",
    "ཨ་མ་དེའི་སེམས་ལ་ཤར་ཚད་དང་སྤྱོད་ལམ་ཐམས་ཅད་སྐྱོ་སྣང་གི་བློ་དེ་ཡིན་མི་དགོས་པར་བྱ་བ་སོ་སོ་དང་བློ་སོ་སོར་འོང་།",
    "སྔགས་ཀྱི་ཐབས་ཤེས་ཡ་མ་བྲལ་བ་ནི་དེ་ལས་ཟབ་ཏུ་སོང་སྟེ།",
    "སྐབས་རེར་སློབ་པའི་མཉམ་གཞག་གཅིག་གིས་ཚོགས་གཉིས་ཅིག་ཅར་དུ་བསགས་པའི་ཐུན་མོང་མ་ཡིན་པའི་ནུས་པ་ཡོད་པ་གསང་སྔགས་ཀྱི་ལམ་མཐོན་པོའི་སྐབས་མ་གཏོགས་མེད་པ་མ་ཤེས་པར།",
    "གོང་མའི་ཐུན་མོང་མ་ཡིན་པའི་ཟབ་ཁྱད་ལ་ངེས་པ་རྙེད་ན།",
    "མཆོག་གི་དངོས་གྲུབ་སྒྲུབ་པའི་ལམ་ཆ་ཚང་བ་ཞིག་ཡིན་པ་ཤེས་ཐུབ།",
    "ནས་དེ་ཙམ་གྱིས་ཆོག་པར་འཛིན་པ་དགེ་ལུགས་པའི་ནང་ལ་ཡང་ཡོང་གི་ཡོད།",
    "ཞེས་པ་དེ་ལ་འགའ་ཞིག་གིས།",
    "འཁོར་ལོ་བར་པའི་སྐབས་ནས་གསུངས་པའི་རང་བཞིན་མེད་པ་དཔྱིས་ཕྱིན་པ་ཞིག་མ་ཤེས་ན་ཀ་དག་གི་དོན་དཔྱིས་ཕྱིན་པ་ཞིག་འཇོག་མི་ཤེས།",
    "རྫོགས་ཆེན་གྱི་ཐུན་མོང་མ་ཡིན་པའི་ཟབ་ཁྱད་ལྟ་བུ་འདོན་ས་དེ་སེམས་དང་རིག་པ་དབྱེ་བ་ཕྱེ་ནས་རིག་པ་ངོ་སྤྲད་ཅིང་རིག་པ་ངོ་འཕྲོད།",
    "སྟོང་པ་ལས་ཀྱང་རིག་པ་གཙོ་ཆེ་བར་བྱས་ཏེ་ནན་ཆེར་གསུངས་པ་ཞིག་ཡོང་ཆོག་པ་རེད།",
    "རིག་པ་ངོ་སྤྲོད་ཁོ་ནའི་ཐོག་ལ་སླེབས་པ་ན་སྐྱོང་སྟངས་ལ་དཔྱད་པ་བྱས་ན་བློ་ལ་སེམས་རིག་གཉིས་སུ་བྱས་ནས་སེམས་ལ་ལས་ཀ་བསྐོས་ནས་རིག་པ་ངོ་སྤྲོད་ཐུབ་པ་ཞིག་ཡོང་གི་མེད།",
    "འཁོར་ལོ་བར་པའི་སྐབས་ཀྱི་རང་བཞིན་མེད་པ་ཞེས་པ་སྟོང་པ་རྟེན་འབྱུང་གི་དོན་ཡིན་པ།",
    "ཉམས་མྱོང་གིས་ངོ་འཕྲོད་པ་དེའི་སྒོ་ནས་བསྒོམས་ན་ཟབ་ཁྱད་ཅིག་ཐོན་ཡོང་གི་ཡོད།",
    "རྙིང་མའི་ཟབ་ཁྱད་ཤེས་མཁན་ཞིག་གིས་ལམ་སྤྱིའི་འགྲོ་ཚུལ་དང་།",
    "བསམ་བློ་ཡང་འདི་ལྟར་གཏོང་གི་ཡོད།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་ལྟ་བ་རྣམས་གཅིག་པ་རེད་ཟེར་ན་ཅུང་ཙམ་བློ་ལ་འཆར་དཀའ།",
    "བཀའ་བརྒྱུད་པའི་ཐུན་མོང་མ་ཡིན་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་ལྟ་བ།",
    "དོན་དམ་དུ་འགོག་པ་གང་ཟག་གི་བདག་འགོག་པའི་དོན་དུ་བཞེད།",
    "དེ་རང་བཞིན་གྱིས་གྲུབ་པ་གང་ཟག་གི་བདག་ཏུ་བཞེད།",
    "གང་ཟག་ལས་འབྲས་ཀྱི་རྟེན་དང་གང་ཟག་གི་བདག་རྟགས་ཀྱི་དགག་བྱར་བཞེད།",
    "དེས་ན་ཡབ་སྲས་གཉིས་གང་ཟག་གི་བདག་ཐ་སྙད་དུ་འགོག་པ་དང་།",
    "གང་ཟག་གི་བདག་ཐ་སྙད་དུ་ཡོད་ཅེས་བརྗོད་ན་ཡ་མཚན་མོད།",
    "འོན་ཀྱང་རང་རང་གིས་དགོངས་པ་བཞེས་ཚུལ་ཞིག་གི་ཆ་ནས་གསུངས་པས་སྐྱོན་གང་ཡང་མེད།",
    "ཚད་ཐུབ་ཅིག་གིས་གསུངས་ན་བསམ་བློ་གཏོང་ཕྱོགས་དང་དགོངས་པ་བཞེས་ཚུལ་རེ་ཡོད།",
    "སྔར་སྐྱེས་བུ་འབྲིང་གི་སྐབས་སུ་གསུངས་པ་བཞིན།",
    "ཐབས་མཁས་པས་གཉེན་པོའི་ཕྱོགས་ཀྱི་བློ་དེ་དག་གིས་ཟིན་པ་ཞིག་བྱུང་ན་ཐར་བ་དང་ཐམས་ཅད་མཁྱེན་པའི་རྒྱུར་ཤིན་ཏུ་རུང་སྟེ།",
    "རེས་འགའ་ནི་མངོན་མཐོའི་རྒྱུར་འགྱུར་བའི་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "དམིགས་པར་ལྷུང་ཟེར་བའི་ཚིག་འདི་སྦྱར་བས་སྤྱིར་སྦྱིན་སོགས་ལ་བསླབ་པ་ཙམ་བཤགས་པའི་གནས་རེད་གསུངས་པ་མིན་གྱི།",
    "བདག་འཛིན་གྱི་མཚན་འཛིན་ཟེར་བ་འདི་རེད།",
    "རྟོག་པས་འདི་དང་འདི་རེད།",
    "འདི་དང་འདི་མ་རེད།",
    "འདི་དང་འདི་མ་རེད།",
    "སྤྱོད་བ་དང་ལྟ་བའི་ཕྱོགས་གཉིས་བོ་དེ་ཚ་གྲང་དང་འགལ་འདུར་སོང་ནས་སྤྱོད་ཕྱོགས་ཀྱི་ཉམས་ལེན་དེ་དག་ཐམས་ཅད་ཕལ་ཆེར་རྟོག་པ་ལ་རག་ལས་པ་ཤ་སྟག་ཡིན་ཀྱང་།",
    "ལྟ་སྤྱོད་གཉིས་པོ་ཕན་ཚུན་འགལ་འདུར་སོང་ན་ལྟ་སྤྱོད་རྣམ་དག་མ་ཡིན་པར་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་ཡིན།",
    "ལྟ་བ་དང་སྤྱོད་པའི་ཕྱོགས་གཉིས་ཚ་གྲང་དང་འགར་འདུར་སོང་ན་གཉིས་ཀ་ལ་ངེས་ཤེས་ཤུགས་དྲག་ལ་རྒྱུན་རིང་བ་བསྐྱེད་ས་མེད་བར་འགྲོའོ།",
    "ཇི་ཙམ་གྱིས་ལྟ་བ་ལ་ངེས་པ་དྲངས་པའི་ཚོད་ཀྱིས་སྤྱོད་ཕྱོགས་ལ་ངེས་པ་ཆུང་དུ་ཆུང་དུ་སོང་།",
    "བརྟེན་ནས་མིང་གིས་བཏགས་ཙམ་དང་།",
    "རང་གི་གཤིས་ལུགས།",
    "ཕན་ཚུན་གཅིག་གཅིག་གི་གྲོགས་སུ་འགྱུར་བ་ཞིག་ངེས་པ་རྙེད་ན་དེ་ནས་བདེན་བ་གཉིས་ཀྱི་དོན་རྟོགས་བ་དང་རྒྱལ་བའི་དགོངས་པ་རྙེད་པ་ཞེས་བྱ་བའི་གྲངས་སུ་འགྲོ་བ་ཡིན་ཏེ།",
    "དེ་ལྟར་མི་བྱེད་པར་རང་གིས་མི་ཤེས་བ་དང་མི་བྱེད་བའི་ཕྱོགས་བཟུང་ནས་དེ་དག་ལ་བསླབ་མི་དགོས་སོ་ཞེས་སྨྲ་ན་ནི།",
    "རང་གིས་ཤེས་ཀྱང་མི་ཤེས་དེའི་སྒོ་ནས་མི་བྱེད་པའི་ཕྱོགས་བཟུང་ནས།",
    "དེ་དགོས་པ་མ་རེད།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་བ་དང་མཚན་མར་འཛིན་པའི་འཆིང་བ་ལྷོད་དགོས་ལ།",
    "ཞེས་སྤང་བྱ་ཉོན་མོངས་པ་དང་དེ་ཐམས་ཅད་ཀྱི་རྩ་བ་བདག་ཉིད་མཚན་མར་འཛིན་པའི་འཆིང་བ་དེ་ལྷོད་ཅིང་།",
    "ད་ལྟར་གྱི་འབྲས་བུ་དམན་པ་བཟའ་བཏུང་སོགས་ལའང་རྒྱུ་རྐྱེན་དུ་མ་ཞིག་གིས་བསྒྲུབ་དགོས་པར་སྣང་ན།",
    "ཕ་རོལ་ཏུ་ཕྱིན་བ་དྲུག་གིས་བསྡུས་པ་ལ་སློབ་བ་ནི་སྔར་ད་བ་ལྟར་སྔགས་དང་ཕ་རོལ་ཏུ་ཕྱིན་བ་གཉིས་ཀའི་ཐུན་མོང་བ་ཡིན་ཏེ།",
    "སྔགས་ཀྱི་སྐབས་སུ་ཐུན་མོང་མ་ཡིན་པའི་འདོད་ཡོན་ལམ་འཁྱེར་བྱེད་པ་དེ་འདྲ་ཡོང་གི་ཡོད།",
    "དེ་ལྟ་བུའི་འདོར་ལེན་གནང་བཀག་འགའ་རེ་མ་གཏོགས་པ་སྤྱིའི་ཐབས་ཤེས་ཟུང་འབྲེལ་གྱི་སྒོ་ནས་ཉམས་ལེན་བྱེད་དགོས་པ་དེ་ཐུན་མོང་བ་ཁོ་ནར་ཤེས་པར་བྱའོ།",
    "དེ་གཞི་ལ་བཞག་ནས་རང་གིས་དཔྱད་པ་བྱས་ཏེ་ལཕྱོགས་རེ་བ་ཙམ་ལས་ལམ་ཆ་ཚང་བར་ངེས་པ་མ་རྙེད་ན་གྱོང་ཆེན་པོ་ཡིན་པས།",
    "ཤེས་རབ་དང་ལྡན་པ་རྣམས་ཀྱིས་ཐབས་ཤེས་ཟུང་འབྲེལ་དུ་བསྟེན་དགོས་པའི་ཚུལ་དེ་ལ་ངེས་པ་བརྟན་པོ་བསྐྱེད་ལ་སྒོ་དུ་མ་ནས་ཐེག་བ་མཆོག་གི་རིགས་ཀྱི་ནུས་བ་ཇེ་རྒྱས་སུ་གཏང་བར་བྱའོ་གསུངས།",
    "གཞུང་ཆེན་མོ་དེ་དག་གདམས་ངག་ཏུ་ཤར་ཐུབ་པ་དང་།",
    "དེ་ཡང་ཐབས་ཤེས་ཕྱོགས་རེ་པས་མི་འགྲུབ་པས་ཐབས་ཤེས་ཡ་མ་བྲལ་བར་ཐབས་ཤེས་ཟུང་འབྲེལ་གྱི་སྒོ་ནས་བསྒྲུབ་དགོས།",
    "ཤེས་རབ་ཀྱི་ཉམས་ལེན་གོང་ནས་གོང་དུ་འཕེལ་བ་དེ་ཡང་ཐབས་ཀྱི་གྲོགས་ལ་ལྟོས་དགོས་པས་དེ་གཉིས་པོ་ཡ་བྲལ་དུ་མ་སོང་བར་ཉམས་སུ་ལེན་དགོས།",
    "ཐབས་ཤེས་ཆ་ཚང་བ་ཞིག་གི་སྒོ་ནས་ཉམས་ལེན་བྱེད་དགོས་གསུངས་སོ།",
    "དེ་ཡང་ཚོགས་གཉིས་དང་བསླབ་པ་གསུམ་ལ་སོགས་པས་ཀྱང་བྱང་སེམས་ཀྱི་ལམ་ཐམས་ཅད་བསྡུས་མོད་ཀྱང་ཕྱིན་དྲུག་གིས་གོ་བ་བསྐྱེད་པ་ལྟར་སྡུད་བྱེད་གཞན་གྱིས་དེ་ལྟར་མི་ནུས་བས་ཕྱིན་དྲུག་ལ་བསྡུ་བའི་གཞི་བྱེད་བ་མཆོག་ཡིན་ནོ།",
    "ཚོགས་གཉིས་ལྟ་བུའི་སྒོ་ནས་བསྡུ་ཐུབ་པ་ཡིན་ཀྱང་ཕྱིན་དྲུག་གི་སྒོ་ནས་བསྡུ་བ་ནི་གོ་བ་རྒྱ་ཆེ་བ་ཡོང་བའི་ཁྱད་ཡོད་པར་གསུངས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བྱིན་དྲུག་གི་སྡོམ་ཙམ་མཛད་བ་ལ།",
    "གང་གིས་སྤྱོད་བའི་ལུས་དང་གང་དང་ལྷན་ཅིག་ཏུ་སྤྱོད་བའི་འཁོར་དང་ལས་ཀྱི་མཐའ་གང་བརྩམས་བ་རྣམས་འགྲུབ་བའི་ཕུན་སུམ་ཚོགས་བ་བཞི་ལྡན་ཞིག་དགོས་སོ།",
    "གཞན་དུ་ན་སྨྱིག་མ་དང་ཆུ་ཤིང་རང་གི་འབྲས་བུ་ཆགས་པ་དང་དྲེའུ་མོ་སྦྲུམ་པས་བརླག་བ་ལྟར་ཕུན་ཚོགས་དེ་ཉིད་ཀྱིས་བརླག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རྟེན་དེ་ལྟ་བུས་བྱང་སེམས་ཀྱི་སྤྱོད་བ་ལ་སློབ་པ་ན་བྱང་སེམས་ཀྱི་བྱ་བ་ནི་གཉིས་སུ་ཟད་དེ་རང་གི་དོན་དང་གཞན་གྱི་དོན་སྒྲུབ་བའོ།",
    "ལུས་ངག་གི་བདུན་པོ་དེར་དངོས་སུ་ལུས་ངག་གི་རྣམ་འགྱུར་ཐོན་ཏེ་གཞན་ལ་གནོད་པས་གཞན་གནོད།",
    "དེ་ལྟ་བུའི་གསུང་ཚུལ་འགའ་རེ་ཡོད་ལ།",
    "དེ་ལེ་ལོ་ཅན་ལ་མི་སྐྱེ་བས་ཉིན་མཚན་ཀུན་ཏུ་མི་ངབ་བའི་བརྩོན་འགྲུས་རྩོམ་དགོས་པས་དེ་ནི་དེ་དག་གི་གཞིའོ།",
    "དེ་ལྟར་ན་སེམས་འཛིན་ཟབ་བར་འདོད་པ་རྣམས་ཀྱང་འདིའི་བསམ་གཏན་གྱི་ཆ་ཤས་རེར་འགྱུར་བས་ཕྱིན་དྲུག་གི་ལུས་རྫོགས་པ་ལ་ངེས་པ་རྙེད་དགོས་སོ།",
    "སེམས་འཛིན་པའི་ཞི་གནས་སེམས་འཛིན་ཟབ་པར་འདོད་པ་དེ་དག་བསམ་གཏན་གྱི་ཆ་ཤས་སུ་འགྱུར་མོད་དེ་གཅིག་པུས་ཆོག་པར་མི་བལྟ་བར་ཕྱིན་དྲུག་གི་ལུས་རྫོགས་པའི་ཚུལ་ལ་ངེས་པ་རྙེད་པ་ཞིག་དགོས་གསུངས།",
    "སྣོད་རུང་དུ་སོང་བ་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "དེ་ཕྱིན་དྲུག་རེ་རེ་ནས་གཞན་དོན་སྒྲུབ་པའི་རྐྱེན་དུ་སྦྱར་ནས་གསུངས།",
    "གཞན་གྱི་དོན་སྒྲུབ་པ་ནི་རང་གི་དོན་མ་ཚང་བ་མེད་པ་ཡིན་ནོ།",
    "སྦྱིན་པའི་ཉམས་ལེན་ཡོད་ན་རང་གི་ལོངས་སྤྱོད་ལ་མི་བལྟ་བ་འོང་བ་ཡིན།",
    "ལྷག་མཐོང་གི་རྣལ་འབྱོར་མི་རྟོག་བ་བསྒོམ་བ་དྲུག་གིས་ནི་འདིས་འགྲོ་བའི་ཐེག་ཆེན་ཐམས་ཅད་བསྡུས་ལ་དེ་དག་ཀྱང་ཕྱིན་དྲུག་གི་རིམ་པར་བསྒྲུབ་ཅིང་དེ་ལས་མང་མི་དགོས་བའི་ཕྱིར་ཏེ།",
    "ས་འོག་མ་འོག་མའི་ཉོན་མོངས་མངོན་གྱུར་པ་རེ་ཞིག་འགོག་ནུས་པས་དེ་ལྟ་བུའི་སྒོ་ནས་གསུངས་པ་ཡིན་སྙམ།",
    "ཉོན་མོངས་མགོ་གནོན་བ་ལ་བསམ་གཏན་དང་།",
    "རྗེས་སུ་མཐར་མ་འཁྱོལ་བ་མང་པོ་བྱུང་བ་ནི་ཚགས་སུ་མ་ཚུད་པའི་སྐྱོན་ཡིན་ནོ།",
    "དམན་མཆོག་གི་རིམ་པ་ནི།",
    "སྔ་མ་རྣམས་ཕྱི་མ་རྣམས་ལས་འཇུག་པ་དང་བྱ་སླ་བས་རགས་ལ་ཕྱི་མ་རྣམས་སྔ་མ་རྣམས་ལས་འཇུག་པ་དང་བྱ་དཀའ་བས་རང་རང་གི་སྔ་མ་ལས་ཕྲ་བ་སྟེ།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "མི་མཁས་འཆི་བདག་བཞོན་པས་སོང་།",
    "འདི་ལྟར་བདག་གི་ལུས་དང་སེམས།",
    "སྐད་ཅིག་རེ་རེས་འགྲོ་བ་ཉིད།",
    "སྐད་ཅིག་སྐད་ཅིག་གིས་འཇིག་པ་དེ་ལྟ་བུའི་རྒྱུན་མི་རྟག་པའི་རང་བཞིན་མི་གཙང་བའི་ལུས།",
    "བྱིན་བ་བདག་གི་ཁྱིམ་བཞག་གཞན་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "དེ་ལས་ལྡོག་སྟེ་སེར་སྣས་ཡོངས་སུ་བཅིངས་ན་རང་གི་ཁྱིམ་ན་གང་བཞག་བ་དེ་ལས་འཇིགས་པ་འབྱུང་ལ།",
    "མི་ཆོག་ཐུན་མོང་རྟག་ཏུ་བསྲུང་དགོས་ཏེ།",
    "ཆོག་མི་ཤེས་པས་ཐུན་མོང་རྟག་ཏུ་བསྲུང་དགོས་ཏེ།",
    "བཏང་བས་ཉོན་མོངས་ཡོངས་སུ་འཛིན་མི་འགྱུར།",
    "སེར་སྣའི་སྐྱོན་ནི་གང་གིས་འཕེལ་འགྱུར་རམ།",
    "དེ་གཞོལ་རང་གི་དམ་བཅས་བསམ་བྱ་སྟེ།",
    "འགྲོ་བ་ཀུན་ལ་བདག་གི་ལུས་བཏང་སྟེ།",
    "ཕྱི་རོལ་དངོས་ལ་བདག་གིས་ཆགས་བྱ་བ།",
    "དེ་ལྟར་བཏང་བའི་ཕན་ཡོན་མང་དུ་བསམས་ནས་བྲོད་པ་ཆེན་བོ་དང་ཡོངས་སུ་བཟུང་བའི་ཉེས་དམིགས་བསམས་བའི་སྒོ་ནས་འཇིགས་བ་ཆེན་བོ་བསྐྱེད་ནུས་ན་གཏོང་བའི་བློ་ངང་གིས་སྐྱེའོ།",
    "འདི་ལ་བདག་གི་ང་རྒྱལ་ཏེ་བདག་ཏུ་བཟུང་བ་དེ་འདྲ་ཞིག་བདག་ལ་མེད།",
    "རང་གི་ལུས་གཏོང་བའི་གཏོང་སེམས་ད་ལྟ་ནས་སྦྱངས་ན་རྗེས་སུ་རིམ་གྱིས་ཉམས་ལེན་གྱི་ཚད་ལོན་པ་ན་དངོས་སུ་གཏོང་ཐུབ་པ་ཞིག་འོང་།",
    "གཞན་ལ་བསྔོས་བ་དེ་དག་ལ་གཞན་གྱི་རྫས་སུ་འདུ་ཤེས་ནས་རང་གི་ཕྱིར་སྤྱོད་ན་མ་བྱིན་ལེན་དུ་འགྱུར་ཞིང་རིན་ཐང་ཚང་ན་སོ་ཐར་གྱི་ཕམ་བར་འགྱུར་བར་བསླབ་བཏུས་ལས་གསུངས་སོ།",
    "རང་ལུགས་བསླབ་བཏུས་ཀྱི་གཞུང་ནས་གསུངས་པ་འདིའི་དགོངས་བ་ནི་མིའི་འགྲོ་བ་བ་ཞིག་ལ་རང་གི་ལུས་ལོངས་སྤྱོད་བསམ་བ་ཐག་བ་ནས་བསྔོས་ཤིང་མིའི་འགྲོ་བ་པ་ཕ་རོལ་པོ་དེས་ཀྱང་དེ་ལ་བསྔོས་པ་དེ་རིག་ནས།",
    "རང་གི་བསམ་བློས་བདག་ཏུ་བཟུང་བའི་སྐབས་སུ་གཞན་གྱི་ཡིན་པར་འདུ་ཤེས་ནས་རང་དོན་དུ་ལེན་པ་ལ་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཁྱིམ་པ་དང་རབ་བྱུང་གི་རྟེན་སོ་སོ་ལ་ལྟོས་བའི་རབ་དབྱེ་དང་།",
    "སྦྱིན་བ་རང་གི་ངོ་བོའི་རབ་ཏུ་དབྱེ་བའོ།",
    "སྤྱིར་ཟང་ཟིང་གི་སྦྱིན་པ་དེ་ནི་གཙོ་བོ་བྱང་སེམས་ཁྱིམ་བའི་རྟེན་ཅན་གྱིས་བྱེད་པ་ཡིན་ལ།",
    "ཤཱ་རིའི་བུ་དེ་བཞིན་གཤེགས་པས་ནི་རབ་ཏུ་བྱུང་བས་ན་ཟང་ཟིང་གི་སྦྱིན་བ་བྱ་བར་མ་གནང་ངོ།",
    "དེ་ཡང་ཐོས་པ་ལ་སོགས་པའི་བར་གཅོད་དུ་འགྱུར་བ་ལ་དགོངས་བར་བསླབ་བཏུས་སུ་གསུངས་ཏེ་རབ་བྱུང་གིས་ཟང་ཟིང་ཆེད་དུ་བསྒྲུབས་ནས་སྦྱིན་གཏོང་བྱེད་བ་བཀག་གི།",
    "ངས་ནི་ཁྱོད་ལ་གཏོང་བའི་ཕན་ཡོན་མི་བརྗོད་ཀྱི་འཛིན་བའི་ཉེས་དམིགས་བརྗོད་པ་ཡིན་གསུངས་ཏེ།",
    "གཞུང་སྐྱོར་སྦྱང་བྱེད་པ་ལྟ་བུའི་སྐབས་སུའང་མི་མ་ཡིན་གཟུགས་མེད་ཀྱི་ལྷ་དང་ཀླུ་གནོད་སྦྱིན་སོགས་ཀྱིས་མཐའ་བསྐོར་ནས་ཡོད་ཅིང་དེ་དག་གིས་གོ་ནས་སེམས་ལ་ཕན་ན་བསམ་པ་དང་།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་ལ་གཉིས།",
    "གང་གིས་གཏོང་བའི་བསམ་བ།",
    "དངོས་ཐོ་རེ་རེ་གཏོང་བ་ལ་དགོས་པ་འདི་དང་འདིའི་ཕྱིར་གཏང་བར་བྱའོ་སྙམ་བའི་དགོས་བ་ལ་དམིགས་བའི་བསམ་པ་རྒྱས་བར་ནི་ལག་བཟང་གིས་ཞུས་བ་དང་།",
    "གང་ལྟར་དམན་པ་ལ་སྦྱིན་པ་བཏང་བ་ནི་ཕན་སེམས་ཀྱི་སྒོ་ནས་གཏོང་གི་ཡོད།",
    "གང་ཞིག་སྐྱེ་བ་དམན་དང་ཕོངས་བ་རེ་བའི་བསམ་ལྡན་མཐོང་ན་ཡང་།",
    "དེ་སླད་ཁྱོད་ནི་ཟུགས་རྗེས་སློང་བ་རྣམས་ལ་སྦྱིན་པར་བཞེད་ལ་བཞུགས།",
    "རེ་བའི་བསམ་པ་དང་ལྡན་པ་ཞིག་ཏུ་མཐོང་ན་ཡང་།",
    "དེ་མིན་བསམ་བརླག་དེས་ནི་དོན་ལ་དངོས་སུ་སྦྱིན་པ་བྱེད་ཀྱི་ཡོད་ཀྱང་བསམ་པ་དེ་ལྟ་བུས་སྦྱིན་པ་གཏོང་བ་དོན་ལ་རང་ཉིད་སློང་མོ་བ་དང་མཚུངས་པ་ཡིན།",
    "བསམ་པས་སྦྱིན་པ་བྱིན་པ་དེ་གཞན་ལ་བརྩེ་བའི་བསམ་པས་བྱིན་པ་མ་ཡིན་པས་དོན་ལ་རང་ཉིད་སློང་མོ་བ་དང་མཚུངས་པ་རེད་གསུངས།",
    "སློང་མཁན་གྱིས་འུ་ཐུག་ནས་སློང་གི་ཡོད་པ་ལས་སྦྱིན་པ་པོ་ལ་འགྲན་རྩོད་པར་ཡོང་བ་མིན།",
    "ཁྱོད་ཀྱིས་ཐོས་དང་བློ་གྲོས་ཆེ་བའི་ཚེ་ན་བདག་བསྟོད་མ་མཛད་ལ།",
    "སྙན་གྲགས་འོང་དུ་རེ་ནས་སྦྱིན་པ་མིན་བའོ།",
    "ཕ་རོལ་བོས་ཕན་འདོགས་སུ་རེ་ནས་གཏོང་བ་མིན་བ་སྟེ།",
    "ཕྱི་མ་ལ་ལོངས་སྤྱོད་དང་ལུས་ཕུན་སུམ་ཚོགས་བའི་རྣམ་སྨིན་ལ་རེ་བ་མེད་དེ།",
    "གནས་སྐབས་སུ་འབྲས་བུ་དེ་དག་ལ་རེ་བ་འགོག་པ་མིན་གྱི།",
    "ཉོན་མོངས་བར་བྱས་ནས་དེ་ནས་སྟེར་བ་དང་།",
    "དངོས་པོ་གོ་མི་ཆོད་པའི་སྒོ་ནས་ཉོན་མོངས་པར་བྱས་ནས་བྱིན་པ་དང་།",
    "དྲིན་བགྲང་གིན་སྟེར་བ་དང་།",
    "བཞིན་གྱི་མདངས་གསལ་ཞིང་འཛུམ་བ་སྔར་བྱེད་ལ་གསོང་པོར་སྨྲ་བ་དང་ལྡན་བས་ཞིང་ཅི་འདྲ་ཞིག་ལའང་གུས་པ་དང་རང་གི་ལག་གིས་དང་།",
    "དེ་དག་གི་འབྲས་བུ་ནི།",
    "རང་ལ་ཡོ་བྱད་ཡོད་ན་སེར་སྣ་ཅན་ཕན་འགའ་ཡང་སྦྱིན་བ་གཏོང་མ་མྱོང་བ་རྣམས་ཀྱི་ཁྱིམ་དུ་སོང་ནས་མགུ་ཞིང་བག་ཕེབས་བར་བྱས་ཏེ།",
    "ཡང་ན་སློང་བ་བྱུང་བ་རྣམས་དད་པ་ཅན་འབྱོར་པ་དང་ལྡན་བའི་ཁྱིམ་དུ་གཏོང་བ་དང་རང་ཡང་དེར་སོང་ནས་ཅི་ནུས་ཀྱིས་སྦྱིན་པ་གཏོང་བའི་གྲོགས་བྱེད་དོ།",
    "གང་གིས་སྐྱོ་བར་འགྱུར་བའི་བརྩོན་འགྲུས་དེ་ཅི་འདྲ་ཞིག་ཡིན་ཞེ་ན།",
    "གང་འདི་སྟོབས་ཆུང་ཕ་ལས་ཀྱི་བའམ་དུས་ཡུན་རིང་བོར་རྩོམ་བའམ་མོས་པ་ཡོངས་སུ་མ་སྨིན་པ་རྣམས་བྱ་དཀའ་བའི་ལས་རྣམས་རྩོམ་པ་སྟེ།",
    "རང་གི་ཤ་སྦྱིན་པ་ལ་སོགས་བ་ལྟ་བུའོ།",
    "སྲོག་གཅོད་སོགས་གཞན་དང་རང་ལ་གནོད་བའི་ཉེར་སྤྱོད་བྱེད་དུ་གཞུག་བའི་ཕྱིར་དུ་སློང་ན་ནི་རེ་ཞིག་ཙམ་ཡང་རང་ཉིད་གཞན་ལ་སྦྱིན་བར་མི་བྱའོ།",
    "སྒོག་ཙོང་དང་ཤ་མི་ཟ་ཞིང་ཆང་མི་འཐུང་བ་དང་དེ་དག་ལ་བཟའ་བཏུང་བྱེད་པར་འདོད་ཀྱང་དེ་དག་ལ་ལོངས་སྤྱོད་དུ་མི་རུང་བའི་སྡོམ་བ་དང་ལྡན་བ་ལ་སྒོག་པ་ལ་སོགས་བ་དང་དེ་དག་གིས་འབགས་བ་སྟེར་བ་དང་།",
    "གླེགས་བམ་ལ་ནོར་གྱི་འདུ་ཤེས་ལས་རང་གིས་ཉམས་ལེན་མི་བྱེད་མཁན་ལ་གླེགས་བམ་དེས་དགོས་པ་ཆེན་པོ་གང་ཡང་བསྒྲུབ་མི་ནུས་པས་དེ་ལ་སྦྱིན་པར་བྱེད་ན་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པར་འགྱུར་རོ།",
    "ཁ་ན་མ་ཐོ་བ་མེད་པ་ཞེས་པ་སྐྱོན་མེད་པ་རེད།",
    "གླེགས་བམ་དེ་ཕ་རོལ་པོ་ལ་རྣམ་གཡེང་གི་རྒྱུར་འགྲོ་བ་དང་།",
    "འདི་ལྟར་རང་ལ་སེར་ྣའི་དྲི་མ་མེད་པས་སེར་སྣའི་ཉོན་མོངས་བསལ་མི་དགོས་པ་དང་།",
    "འདི་ཁྱོད་ལ་མི་སྦྱིན་ནོ་ཞེས་ཚིག་བརླང་བོས་བྱེད་བ་མ་ཡིན་གྱི།",
    "རིམ་ཆེན་མོའི་ནང་ལ་དཔའ་བོའི་རིན་གྱིས་ཉོས་པ་ཞེས་གསུངས་འདུག་པས་དཔའ་བོའི་རིན་ཟེར་བ་དེ་ཡིན།",
    "རང་གི་ཕ་མ་དང་།",
    "བརྡ་མ་སྤྲད་བ་དང་སྤྲད་ཀྱང་སྟེར་བ་ལ་མི་མོས་བའི་བུ་དང་ཆུང་མ་དང་བྲན་ལ་སོགས་བ་དང་བུ་དང་།",
    "སྐྱིད་ལོབས་ཟེར་ན་ཆུང་ཆུང་སྐབས་ནས་ཕ་མས་གཅེས་ཉར་བྱས་ཏེ་མགོར་དཀའ་ངལ་ཡོང་མ་བཅུག་པའི་བུ་དང་བུ་མོ་དེ་འདྲ་ཡིན་ན་སྦྱིན་དུ་མི་རུང་།",
    "རང་ངམ་གཞན་ལ་གནོད་པའི་ཕྱིར་དུ་སློང་བ་ལ་དུག་དང་མཚོན་དང་མེ་དང་ཆང་སྟེར་བ་དང་ངན་འགྲོར་འགྲོ་བའི་རྒྱུ་གསོག་བའི་དགག་བྱ་དང་ལྡན་བའི་དགའ་ཞིང་རྩེད་མོ་རྩེ་བའི་དངོས་བོ་སློང་བ་ལ་དེ་དག་སྦྱིན་པ་དང་།",
    "འདིས་ནི་སྲོག་ཆགས་ཀྱི་ལུས་སྲོག་དང་ལོངས་སྦྱོད་ལ་གནོད་པ་བསྐྱལ་བའི་ཕྱིར་དུ་དེ་དག་གི་མན་ངག་སློབ་བའང་མི་རུང་བར་བསྟན་བ་ཡིན་ནོ།",
    "དེ་ཡང་མེད་ན་བདག་གིས་འདི་བྱིན་པས་ཚེ་འདི་ལ་ལྐུགས་བར་གྱུར་ཀྱང་བླ་ཡི།",
    "བཞིན་བཟང་ངས་ཡོ་བྱད་འདི་དང་བོ་ནས་བཀྲེན་བ་འདི་ལ་བསྔོས་ཟིན་པས་ཁྱོད་ངོ་བཟློག་གོ་སྙམ་དུ་མ་སེམས་ཤིག་ཅེས་ཚིག་འཇམ་བོས་གོ་བར་བྱས་ནས་འབྱོར་བ་དང་མི་ལྡན་བའི་འདོད་བ་རྫོགས་པར་བྱའོ།",
    "སློང་བ་བོས་བསླངས་བའི་ཚེ་སེར་སྣས་ནོན་ན་འདི་སྙམ་དུ་དངོས་པོ་འདི་དང་བདག་གདོན་མི་ཟ་བར་འབྲལ་ཏེ་འདིས་ཀྱང་བདག་འདོར་བདག་གིས་ཀྱང་འདི་འདོར་རོ།",
    "དགའ་ཞིང་རངས་པ་སྐྱེའོ་སྙམ་དུ་བསམ་མོ།",
    "འཇམ་བའི་ཚིག་གིས་དེ་ཡི་ཡིད་ཀྱང་བཞོ།",
    "དེ་རང་གི་ཁེའི་དོན་དུ་སྤྲོད་པ་བཞིན་དུ་གྱུར་ནས་ཕན་ཡོན་མེད་གསུངས།",
    "འབྱོར་བ་དང་མི་ལྡན་པས་འདི་བྱ་བར་ལག་བཟང་གིས་ཞུས་པ་ལས་གསུངས་ཀྱང་།",
    "བཞི་བ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་འབུ་སྲིན་ཚུན་ཆད་ལ་སྤྲད་པ་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "གཞན་གྱི་དོན་ལྟ་ཞོག་རང་གི་དོན་ཡང་མི་འགྲུབ་བའི་ཕྱིར་རོ།",
    "ཚ་གདུང་སེལ་བའི་ཙནྡན་ལ་སོགས་བའི་ལྡེ་གུའི་བྱུག་པ་ནི་རབ་བྱུང་ལ་འགལ་ཡང་ཉོན་མོངས་པའི་ཚ་གདུང་སྐྱོབ་བའི་བྱུག་པ་ནི་རབ་བྱུང་ལ་མི་འགལ་ཞིང་མཐུན་པ་དང་།",
    "གཞན་ཡང་གཅམ་གསག་གི་ཚིག་མ་བརྗོད་ཅིང་འབད་རྩོལ་གྱི་ཚེགས་ཀྱིས་མ་ཀྱིས་མ་བསྒྲུབས་ཀྱང་ཉེ་བར་མཁོ་བའི་ལོངས་སྤྱོད་ངང་གིས་འདུ་བར་དྲག་བོའི་ལས་ཀྱིས་བསྡིགས་པ་མེད་ཀྱང་།",
    "སྐྱེ་བོ་ཀུན་འདུད་བ་དང་རང་གི་གཉེན་ལ་སོགས་བའི་རིགས་སུ་སྨོས་སུ་མེད་པ་དང་།",
    "རང་གི་བདེ་ལ་བརྐམ་པས་བྲལ་མི་བྱ།",
    "དེ་ཡང་རང་ངན་སོང་གིས་འཇིགས་པ་ཙམ་དང་ལྷ་དང་མིའི་ཕུན་སུམ་ཚོགས་བ་ཙམ་ལ་སྨོན་པ་བསལ་ནས།",
    "དེ་བས་ངན་སོང་འཇིགས་དང་རྒྱལ་སྲིད་དང་།",
    "སྦྱིན་པ་འགྲོ་བའི་རེ་སྐོང་ཡིད་བཞིན་ནོར།",
    "ཉོན་མོངས་ཚ་གདུང་སེལ་བའི་ཟླ་བའི་འོད།",
    "ནང་མི་འདས་གྲོངས་ལ་སོང་བ་ལྟ་བུའམ་གཉེན་ཉེ་དུ་ལ་བཀྲ་མི་ཤིས་པ་བྱུང་བའི་ཚེ་དེ་དག་ལ་རྒྱུ་དངོས་པོའི་ཐོག་ནས་རོགས་བྱེད་མ་ཐུབ་ན་ཡང་སེམས་གསོ་གཏོང་བ་ཚུན་ཆད་ཀྱི་སྒོ་ནས་རོགས་བྱེད་པ་འདི་ཚོའི་རིགས་གལ་ཆེན་པོ་ཡིན།",
    "དེ་འདྲའི་ཉམ་ཐག་པ་དེ་དག་དང་རང་ཉིད་མཉམ་དུ་གནས་ན་ཕ་རོལ་པོའི་སེམས་ལ་ང་གྲོགས་མེད་གཅིག་པུ་རེད་མི་འདུག་བསམ་པའི་སྒོ་ནས་བློ་སྤོབས་བསྐྱེད་པས་ཐབས་གང་ཐུབ་ཐུབ་བྱེད་དགོས།",
    "ཆང་དང་ཨ་རག་བག་མེད་དུ་སྤྱད་ནས་རང་གི་ཁྱིམ་ཚང་ནང་ལ་ཡིན་ན་ཡང་དཀའ་ངལ་བཟོ་མཁན།",
    "ངས་ན་ཚ་རང་གིས་ཉོས་པ་ཡིན་པས་བྱེད་ཐབས་གང་ཡང་མེད་ཅེས་འཆད་ཀྱི་ཡོད།",
    "དང་པོ་རང་གིས་ཚོད་མེད་པའི་ཆང་དང་ཨ་རག་ཐ་མག་སོགས་ལོངས་སུ་སྤྱད།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་མ་གཏོགས་སོ་ཟེར་བའི་སྐབས་ལ་སླེབས་ཚར་བ་རེད།",
    "༡ ལམ་ལོག་པར་ཞུགས་ནས་ཉེས་པ་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་བྱས་པ་གསུམ་ལ་འཇམ་པོས་ཕར་ཁ་ཡག་དོན་བཟང་གི་སྒོ་ནས་ལྡོག་ཐབས་བྱས་ནས་ལམ་ལོག་པ་ལས་འཕྲལ་བ།",
    "ཞིག་ཆགས་ན་དེ་ཐབས་རྡུགས་རེད།",
    "བསྟན་པའི་ཞབས་འདྲེན་རེད་མ་གཏོགས་བསྟན་པའི་ཞབས་འདེགས་ཞུ་མཁན་ཞིག་མ་བྱུང་བ་རེད།",
    "དུས་རྒྱུན་དགེ་སློང་གི་སྡོམ་པ་འབོགས་ཆོག་སྐབས་ལ་ཡང་དགེ་སློང་གི་ཞབས་ཟིན་པ་ཡིན་པས་དགའ་བ་སྒོམས་གསུངས་པ་བཞིན་དགེ་སློང་གི་རྗེས་ཟིན་པས་རང་གིས་དགའ་བ་སྒོམས།",
    "དགའ་བ་རྙེད་པའི་དགེ་སློང་དུ་གྱུར་སོང་བསམ་པ་སྟེ་སེམས་ནང་ལ་དགའ་ལྷང་ལྷང་འདྲ་ཞིག་ཡོང་གི་ཡོད།",
    "རང་གིས་བསླབ་གཞི་ཁས་བླངས་པ་དེ་གཅེས་སྤྲས་བྱས་ནས་རང་གི་དོན་ཡང་འདིའི་ངོས་ནས་ཡོང་དགོས་ལ།",
    "འོན་ཀྱང་དེའི་སྐབས་སུ་དད་པ་དང་དག་སྣང་ཤས་ཆེ་བས་མངོན་གསལ་དོད་པོ་དང་ལྟ་སྟངས་ལོག་པ་མི་འོང་མོད།",
    "དེ་ལྟ་བུའི་དུས་ཚོད་རྩ་ཆེན་པོ་ཞིག་གི་སྐབས་ཡིན་པས་རང་ཅག་སྟོན་པའི་རྗེས་འབྲང་དང་།",
    "སྟོན་པའི་སྐུ་ཚབ་ལྟ་བུ་བྱེད་མཁན་རང་གི་ངོས་ནས་སྤུས་དག་པོ་ཞིག་དང་།",
    "སྐབས་རེར་སེམས་མ་དུལ་བའི་ཆ་ནས་དཀའ་ངལ་འཕྲད་པ་དེ་འདྲའི་སྐབས་ཉམས་ལེན་མཐའ་འཁྱོལ་བ་ཡོང་བའི་དོན་དུ་ཞུམ་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "གཙོ་ཆེ་བ་དགོས་པ་ལ་ལྟ་དགོས་གསུངས་པ་དེ་དངོས་གནས་རེད།",
    "དངོས་དང་བརྒྱུད་པའི་འབྲེལ་བ་ལྟར་ཡོང་གི་ཡོད་མེད་འདི་དག་ཤེས་ཐུབ་པ་ཞིག་དགོས།",
    "ལྔ་བ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "དེ་དག་གི་ནང་ནས་ཀྱང་སྡོམ་པ་གང་ཁས་བླངས་བའི་རྩ་ལྟུང་རྣམས་ལ་སྡོམ་སེམས་ཡང་དང་ཡང་དུ་གཏོང་བ་ལ་འབད་པར་བྱའོ།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "རང་གི་རྒྱུད་ལ་སྡུག་བསྔལ་བྱུང་བ་ལ་དང་དུ་ལེན་བ་དང་།",
    "བཟོད་པ་ཞེས་པ་ཕྱིའི་གནོད་བྱེད་དང་སྡུག་བསྔལ་སོགས་གང་གིས་ཀྱང་སེམས་མི་འཁྲུག་པ་ལ་ཟེར།",
    "དེ་དག་གི་མི་མཐུན་པའི་ཕྱོགས་ཀྱང་གསུམ་ལས།",
    "གསུམ་པ་ནི་མ་མོས་ཤིང་མི་འདོད་པའོ།",
    "བསྒྲུབ་བར་མི་ནུས་བའི་ཕྱིར་དང་རང་གི་སེམས་བཏུལ་བ་ཉིད་ཀྱིས་དགོས་པ་འགྲུབ་པའི་ཕྱིར་ཏེ།",
    "བདག་གིས་ཕྱིར་བཟློག་མི་ལང་གི།",
    "བདག་གི་སེམས་འདི་ཕྱིར་བཟློག་བྱའི།",
    "གནོད་སེམས་འབྲོག་གི་མེ་ལ་ཆུ་ཡི་རྒྱུན།",
    "སྐྱེ་བོ་མཆོག་གི་བཟོད་བའི་གོ་ཆ་ལ།",
    "མི་བསྲུན་སྐྱེ་བོའི་ཚིག་གི་མདའ་རྡུགས་བས།",
    "ཉོན་མོངས་གདུང་བར་བྱེད་བའི་དཀའ་ཐུབ་རྣམས་ཀྱི་སྟོབས་དམ་བ་དང་གནོད་སེམས་ཀྱི་མེ་ཆེན་པོ་འཇོམས་བའི་ཆུའི་རྒྱུན་དང་མི་བསྲུན་བ་རྣམས་ཀྱི་ལོག་སྒྲུབ་ཀྱི་མདས་མི་ཕིགས་པའི་གོ་ཆ་དང་།",
    "ཁོང་ཁྲོ་གཅིག་གིས་འཇོམས་བར་བྱེད།",
    "བསྐལ་པ་བརྒྱ་དང་སྟོང་གི་ཁྱད་པར་གསུངས་པ་དེ་ཡུལ་ཇི་འདྲ་ཞིག་ལ་ཁྲོས་པ་དགོས་བ་ནི།",
    "བསགས་པ་སྐད་ཅིག་གིས་འཇོམས།",
    "འཁོར་ལོ་རྣམས་ལ་ཇུག་གི་བར་ན་བྱེ་མ་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་དུ་དགེ་སློང་འདིས་ར་ལོས་བསྒྱུར་བའི་རྒྱལ་སྲིད་སྟོང་འགྱུར་དུ་ལོངས་སྤྱོད་པར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ནས་དེ་ནས་ཚེ་དང་ལྡན་བ་ཉེ་བར་འཁོར་གྱིས་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "སྔགས་ཀྱི་སྐབས་སུ་གནང་བ་ཅུང་ཙམ་ཡོད་ཀྱང་དེ་དམིགས་བསལ་བ་རེད།",
    "ཁོང་ཁྲོ་སྐྱེ་བའི་སྐབས་སུ་སུ་ཡིན་ཀྱང་ཚ་གེ་ཚིག་གེར་གྱུར་ཡོང་གི་མི་འདུག་གམ།",
    "རང་གི་ངོས་ནས་བཟོད་པའི་ཕན་ཡོན་སོགས་བཟོད་པའི་ཉམས་ལེན་བྱེད་ཚུལ་སྤྱོད་འཇུག་ལས་གསུངས་པ་ལྟར་བརྩོན་ན།",
    "ཁོ་ཁོང་ཁྲོ་ཆེན་པོ་ཡོད་པ་རེད།"
  ]
}