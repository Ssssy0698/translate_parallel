    "དེ་ངོ་ཤེས་པར་བྱས་ནས་དེ་དག་གི་རྗེས་སུ་བསླབ།",
    "དེ་དག་གིས་རྟོགས་པ་བརྙེས་པ་ཇི་ལྟ་བ་བཞིན་རང་གིས་ཀྱང་མངོན་དུ་བྱེད་བསམ་པ་ཞིག་དང་།",
    "དེའི་ཆེད་དུ་བདག་གིས་ད་ལྟ་དལ་འབྱོར་གྱི་མི་ལུས་ཐོབ།",
    "ཙོག་ཙོག་པུར་སྡོད་ཅིང་ལག་གཉིས་ཐལ་མོ་སྦྱར་དེ་བཞུགས།",
    "ཕྱིའི་རྐྱེན་ལ་སྦྱར་ན་ཡང་འགྲིག་མོད།",
    "གཙོ་བོ་གདོད་མ་ཉིད་ནས་རྣམ་མཁྱེན་འགྲུབ་རུང་གི་རྒྱུར་འགྲོ་བའི་གཉུག་མ་ལྷན་ཅིག་སྐྱེས་པའི་འོད་གསལ་དེ་འདྲ་ཞིག་རང་ཅག་གི་རྒྱུད་ལ་རང་ཆས་སུ་ཡོད།",
    "ཞེས་ཐབས་མཁས་ལ་ཐུགས་རྗེ་ཆེན་པོ་དང་ལྡན་པའི་སྟོན་པ་བཀའ་དྲིན་ཅན་གྱི་སྐུ་གསུང་ཐུགས་ཀྱི་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོད་པ་དེ་སེམས་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཡིན་སྟབས་རང་གི་སེམས་ཀྱི་དེ་ཁོ་ན་ཉིད་མཁྱེན་ནས་དེ་མངོན་དུ་གྱུར།",
    "མཐར་སྐྱོན་ཀུན་ཟད་ཡོན་ཏན་ཀུན་ལྡན་དེ་བྱུང་བ་ཡིན་པ་རེད།",
    "གསང་སྔགས་གསར་མའི་གཞུང་གི་སྐབས་ཡིན་ན་ཡང་།",
    "སློབ་དཔོན་ཀླུ་བྱང་གིས་མཛད་པའི་གསང་འདུས་དཀྱིལ་ཆོག་ཉི་ཤུ་པ།",
    "གཞན་སུ་ཞིག་གིས་ཀྱང་བདག་ཏུ་བཟུང་ནས་རང་ཅག་ལ་སྦྱིན་པ་མ་ཡིན།",
    "རང་གི་སེམས་ཀྱི་དེ་ཁོ་ན་ཉིད་ཐོག་མ་མེད་པ་ནས་ཡོད་པ།",
    "རྒྱལ་བ་སྲས་དང་བཅས་པ་རྣམས་ལ་སྐྱབས་སུ་སོང་ནས།",
    "དངོས་གཞི་སྨོན་སེམས་ཆོ་གས་བཟུང་བ་དེ་ཡིན་པ་རེད།",
    "རང་ཅག་ལ་རྒྱལ་བ་སྲས་དང་བཅས་པ་རྣམས་ལ་སྐྱབས་གནས་ཡང་དག་ཏུ་མོས་པ་ཡོད།",
    "ཐེག་ཆེན་བཀའ་སྒྲུབ་དགོས་སའི་མི་ཞིག་གིས་ཉམས་ལེན་དེ་མ་བྱས་ནའང་ཧ་ལས་པ་མིན།",
    "ནང་པ་མ་ཡིན་པ་རྣམས་ཀྱང་རིམ་གྱིས་བག་ཆགས་བཞག་ནས་སྟོན་པའི་གསུང་གི་སྣོད་དུ་འགྱུར་བ་ཡོད་མོད།",
    "ཕྱིའི་སྤྱོད་པ་དང་ནང་གི་བསམ་བློ་གཏོང་ཚུལ་སོགས།",
    "ད་ལྟ་མདུན་ལ་གསལ་བཏབ་ནས་དྲན་ཡུལ་དུ་ཡོད་པའི་རྒྱལ་བ་སྲས་དང་བཅས་པ་དེ་དག་གིས་སྐུ་གསུང་ཐུགས་ཀྱི་ཡོན་ཏན་མཐར་ཐུག་པ་ཞིག་ཐོབ་ཡོད་པས།",
    "གཏན་ནས་ཡོང་གི་མེད།",
    "ཞི་བ་ལྷ་དེ་དག་གིས་རང་གཅེས་འཛིན་དང་གཞན་གཅེས་འཛིན་གྱི་སྐྱོན་ཡོན་ངོ་སྤྲད།",
    "རང་གཅེས་འཛིན་དུག་གི་གོང་བུ་ལྟ་བུ་ལ་སྐྱོན་དུ་བལྟས་ཏེ།",
    "རང་གི་ཁང་པའི་ནང་དུ་བཤགས་པ་བྱས་པ་ལས་འདིར་བཤགས་པ་བྱས་ན་ཉེས་པ་འདག་སྟོབས་ཆེ་བ་ཡོད།",
    "ད་ལྟ་ཕན་ལ་ནོར་འཁྲུལ་བྱས་པ་དེ་ནོར་འཁྲུལ་ཡིན་པ་མཐོང་སོང་ངམ་ཟེར་གྱི་ཡོད་པས་དེའི་ལན་ལ་མཐོང་ལགས་ཟེར་དགོས།",
    "དེ་ལྟར་ལན་གསུམ་སོང་བའི་རྗེས་ལ།",
    "ཁྱོད་རང་ཚོས་ལེགས་སོ་ཟེར་དགོས་པ་ཡིན།",
    "ཉམ་ཐག་འགྲོ་བ་འདི་ཀུན་བདག་གི་མ།",
    "ཐམས་ཅད་ཀྱི་རྒྱུད་ལ་བདེ་བ་རང་གི་ངང་གིས་དོན་དུ་གཉེར་བ་ཞིག་དང་།",
    "སྡུག་བསྔལ་མི་འདོད་པ་ཞིག་ཡོད་པ་རེད།",
    "བདེ་བས་ཕོངས་ནས་ཡོད་པའི་ངང་ཚུལ་འདི་བདག་གིས་བཟོད་གླགས་མི་འདུག།",
    "འདུན་མ་གཏན་ཉེས་ལ་བཏང་ནས་ཕྱིན་ཆད་རེ་བ་རྒྱག་ས་མེད་ཕ་ཞིག་བྱས་པ་ཡིན་ན་ཅི་བྱེད།",
    "རང་གི་ངོས་ནས་མཚོན་ནའང་།",
    "དེ་ཡོང་བར་བདག་གིས་བྱའོ།",
    "བདེ་བ་འདོད་ཀྱང་བདེ་བས་ཕོངས་ནས་ཡོད་པ་འདི་ཐམས་ཅད་གནས་སྐབས་དང་མཐར་ཐུག་གི་བདེ་བ་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་དང་ལྡན་པ་ཞིག་ཡོང་བར་ཤོག།",
    "བདེ་བ་མཐའ་དག་དང་ལྡན་པ་དེ་ཡང་བདག་གིས་བྱེད་ཀྱི་ཡིན་བསམ་པའི་ལྷག་པའི་བསམ་པ་ཡག་པོ་ཞིག་བསྐྱེད།",
    "ཚེ་འདིར་སེམས་བསྐྱེད་མི་ཉམས་པའི་རྒྱུ་དང་ཕྱི་མར་སེམས་བསྐྱེད་མི་ཉམས་པའི་རྒྱུ་གཉིས་ཕལ་ཆེར་སྲུང་ཐུབ་ཀྱི་རེད།",
    "སེམས་བཟང་པོ་དེ་འདྲ་ཞིག་སྐྱེ་བ་དེ་ཡང་ཧ་ཅང་བྱ་བ་རླབས་ཆེན་རེད།",
    "མི་ལུས་ཐོབ་པ་དོན་གོ་ཆོད་པ་རེད་བསམ་པ།",
    "བསྒོམ་ན་སྐྱེས་ཡོང་སྙམ་པའི་རེ་བ་ཡོད།",
    "ཁྱེད་ཅག་གིས་ཀྱང་དེ་བཞིན་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "སེམས་བསྐྱེད་མཚན་ཉིད་ཚང་བ་ཞིག་སྐྱེ་བ་ལ་སེམས་ཤུགས་བསྐྱེད་དགོས་པ་གལ་ཆེན་པོ་རེད།",
    "ལན་དང་པོ་སོང་།",
    "དུས་ད་རེས་ང་ལ་མཐུན་རྐྱེན་འཛོམས།",
    "འགལ་རྐྱེན་གཙོ་ཆེ་བ་རྣམས་བྲལ་ནས་ཡོད་པའི་སྐབས་འདིར་རེ་བ་ཅུང་ཟད་ཡོད་པས་ད་རེས་མ་གཟབ་ན་ག་དུས་གཟབ།",
    "སྐལ་བཟང་གི་དུས་ཚོད་འདི་ངས་ཆུད་ཟོས་སུ་བཏང་ན་ཇི་ལྟར་འགྲིག།",
    "དེ་ནས་གསུམ་པའི་སྐབས་སུ་ཡང་སྔར་བཞིན་ད་རེས་མི་ལུས་ཐོབ།",
    "འདི་ལས་གོ་སྐབས་བཟང་བ་ཞིག་སྔར་ཕན་ཆད་ཕལ་ཆེར་བྱུང་མ་མྱོང་བ་ལྟ་བུ་རེད།",
    "རང་ཅག་ཐམས་ཅད་སྐལ་བ་བཟང་པོ་རེད།",
    "ཕུལ་བ་དེ་མར་ཞུས་ནས་རང་གི་ཤག་ཏུ་དྲན་རྟེན་ལ་ལེགས་པོ་ཉར་དགོས།",
    "མི་ཚེ་འདིར་རང་གི་སེམས་ལ་འགྱུར་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཉིན་རེ་ཉིན་རེའི་ད་ལྟའི་གནས་ཚུལ་ལ་རག་ལས་པ་ཞིག་ཡིན་སྟབས་ད་ལྟ་ནས་མ་འཆུག་པ་བྱེད་རྒྱུ་གལ་ཆེ།",
    "འབྲལ་སྤང་བཞིན་དུ་གང་དུ་སོང་ན་འཁྱེར་དགོས་པ་ཡང་མིན།",
    "ཕྱི་ནང་གི་རྐྱེན་མང་པོ་ཞིག་གི་སྒོ་ནས་བློ་ཇེ་བཟང་ཇེ་བཟང་དུ་འགྲོ་ཐུབ་པ་ཞིག་ངེས་པར་ཡོང་།",
    "ང་ལ་ཁ་སྟབས་མེད་ན་ཡང་འདི་འདྲ་ཞིག་བྱེད་རྒྱུ་བྱུང་བ་དེ་ཕན་པ་ཆེན་པོ་རེད།",
    "ཉིན་རེ་བཞིན་དུ་ཉིན་ལན་གསུམ།",
    "གཞན་ལ་ཇི་ཙམ་བསྐུལ་བ་དེའི་ཚོད་ཀྱིས་ང་རང་གི་སེམས་ལ་འགུལ་བསྐྱོད་ཐེབས་ཡོང་གི་འདུག།",
    "འགལ་རྐྱེན་གཙོ་བོ་ཁོང་ཁྲོ་རེད།",
    "མཐར་རང་གི་ལུས་ལ་སྐྱོན་ཤོར།",
    "སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་འདྲེན་རེད།",
    "མཁས་བཙུན་བཟང་གསུམ་འཛོམས་པ་ཞེས་པ་གཙོ་བོ་བཟང་པོའི་ཡོན་ཏན་རེད།",
