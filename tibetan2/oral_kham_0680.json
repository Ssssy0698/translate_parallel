    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་དུ་སྤྱོད་པར་འདོད་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དོན་དུ་སྐྱེད་ཀྱི་ཁེ་འདོད་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དོན་དུ་རང་དགར་ཉོ་ཚོང་བྱེད་པར་འདོད་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དོན་དུ་རྒྱུན་དུ་འཆང་འདོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དོན་དུ་སློང་འདོད་ཀྱི་བསམ་པས།",
    "བསམ་པ་འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དོན་དུ་འཐབ་ཏུ་འཇུག་འདོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་ངམ་གཞན་གྱི་དོན་དུ་འཕྲོག་འདོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་ཞག་དྲུག་འབྲལ་འདོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་བསྙེན་པར་མ་རྫོགས་པ་དང་ཅིག་ཅར་རམ་མཇུག་ཐོག་ཏུ་འདོན་པར་འདོད་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་གར་འདུག་པའམ་འགྲོ་འདོད་ཀྱི་བསམ་པས།",
    "སྦྱོར་བ་དེ་ལྟར་བཞག་ནས་དེ་ཉིད་དུ་འདུག་པའམ་འགྲོ་བར་བརྩམས་ཏེ།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་འདོར་འདོད་ཀྱི་བསམ་པས།",
    "སྦྱོར་བ་རང་དེར་འདུག་པའམ་གཞན་དུ་འགྲོ་བའི་ཚེ་རང་ངམ་བསྐོས་པས་མ་བསྡུས་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིག་ཀུན་སློང་རང་དགར་སྐྲོད་འདོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་འདུག་འདོད་པའི་བསམ་པས།",
    "སྦྱོར་བ་དེ་ལ་འདུག་པ་ལ་སོགས་པ་བྱེད་པར་བརྩམས་ཏེ།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དོན་མ་ཡིན་པར་ལོངས་སྤྱོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་བཟོ་བྱེད་༢༢",
    "མཐར་ཐུག་སྔ་མ་ལ་ཡུལ་རྟེན་གཉིས་ཀ་འདུག་པ་དང་།",
    "ཡང་ཡང་དང་ནི་འདུག་གནས་གཅིག།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་འདུག་གནས་སུ་ཞག་ལོན་པའི་ཟས་ཟ་འདོད་པའི་བསམས་པས།",
    "དེ་བས་ལྷག་པ་འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་བསླངས་པ་གཞན་དུ་ཟ་འདོད་པའི་བསམ་པས།",
    "དེའི་ཚུལ་ནི་བྱིན་ལེན་བྱས་ནས་ཟས་ལག་ཏུ་བཟུང་ཏེ་ལྷག་པོར་གསོལ་བའི་ཡུལ་དགེ་སློང་ཟས་ཀྱི་གནས་མ་བཏང་བའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "ཁ་ཅིག་དགེ་སློང་རང་ཉིད་གནས་པའི་གླིང་ལ་བྱེད་དེ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་དེ་དག་དང་གནས་གཅིག་ཏུ་འདུག་པར་འདོད་པས།",
    "སྦྱོར་བ་མངོན་སུམ་དང་བརྟགས་ཏེ་འདུག་པར་བརྩམས་ནས།",
    "ཁྱིམ་དེར་ཤེས་བཞིན་དུ་དབེན་པ་སྐྱབས་ཡོད་པར་འགྲེངས་ཏེ་འདུག་པ་སྟེ།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་རང་དགར་སྦྱིན་པར་འདོད་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་མ་རྫོགས་པ་དང་ལྷན་ཅིག་ཉལ་འདོད་ཀྱི་བསམ་པས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་ཁྲུས་བྱེད་འདོད་ཀྱི་བསམ་པས།",
    "ཀུན་སློང་རང་དགར་ལྷན་ཅིག་འགྲོ་འདོད་ཀྱི་བསམ་པས།",
    "དེ་བསྙེན་པར་རྫོགས་པའི་རྗེས་ལ་མངལ་བཤོལ་དང་བཅས་པའི་ཉི་ཤུ་མ་ལོན་པའི་ཚེ་གོང་དུ་བསྙེན་རྫོགས་ལེན་དུས་ལོ་ཉི་ཤུ་མ་ལོན་པར་འདུག་སྙམ་དུ་འདུ་ཤེས་ན་དེའི་ཚེ་བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་འཇིག་སྟེ།",
    "མ་ལོན་ཡང་ལོན་པར་འདུ་ཤེས་པས་བསྙེན་རྫོགས་ཆགས་ནས་མངལ་བཤོལ་དང་བཅས་པའི་ཉི་ཤུ་ལོན་པའི་ཚེ་ལེན་དུས་ལོ་ཉི་ཤུ་མ་ལོན་འདུག་སྙམ་དུ་ཤེས་ཀྱང་སྡོམ་པ་མི་འཇིག་སྟེ།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་བརྐོ་འདོད་ཀྱི་བསམ་པས། ༢༢༥",
    "དེར་ཤེས་བཞིན་དུ་ཀུན་སློང་རང་དོན་དུ་དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལས་ཟས་བླངས་ཏེ་ཟ་འདོད་པའི་བསམ་པས།",
    "སྦྱོར་བ་རང་དང་དགེ་སློང་མ་གཉིས་ཀ་གྲོང་ངམ་ལམ་པོ་ཆེ་ན་འདུག་སྟེ་དེ་ལས་ཟས་བླངས་སྟེ་བཟའ་བར་བརྩམས་ཏེ།",
    "རྟེན་དགེ་སློང་རང་ངམ་ཟས་གཅིག་པའི་དགེ་སློང་གཞན་གྱིས།",
    "འདུ་ཤེས་མ་འཁྲུལ་ཞིང་ཀུན་སློང་རང་དགར་བསྐོ་བཤམ་བྱས་པ་ཟ་འདོད་ཀྱི་བསམ་པས།",
    "འདུག་པར་བྱ་བ་དགུ་དག་ནི།",
    "ཁྱིམ་དུ་སྟན་ལ་མི་བསྒོ་བར་མི་འདུག་མ་བརྟགས་པར་མི་འདུག་ལུས་ཐམས་ཅད་ལྗིད་ཀྱིས་ཕབ་སྟེ་མི་འདུག་རྐང་པ་བརྐྱངས་ཏེ་མི་བསྣོལ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་སྦགས་པའི་ཆུས་མི་གཏོར།",
    "ཉན་པ་པོ་མི་ན་བར་འདུག་པ་ལ་འཆད་པ་པོ་འགྲེངས་ཏེ་མི་འཆད་པ་དང་།",
    "དེ་བཞིན་དུ་ཉལ་བ་ལ་འདུག་པས་དང་།",
    "སྟན་མཐོན་པོའམ་བཟང་པོ་ལ་འདུག་པ་ལ་སྟན་དམའ་བའམ་ངན་པ་ལ་འདུག་པས་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "འདུག་གནས་ལ་སོགས་གསུམ་དང་དུས་མིན་ཟས།",
    "རྐུན་མ་བསྐོ་དང་མགྲོན་གཉེར་རིང་འདུག་དང་།",
    "མ་གུས་ཕྱོགས་གཅིག་ཆང་དང་དུས་མིན་འགྲོ།",
    "དབེན་པར་འདུག་དང་ཉལ་དང་དྲུག།",
    "འདུག་གནས་ཕྱེ་དང་གསོད་པ་དང་།",
    "མ་བསྐོས་སོགས་དགུ་འདུག་མ་གཏོགས།",
    "ཀུན་སློང་རང་ཁོ་ནའི་དོན་དུ་དགོས་པ་ནི།",
    "ཡང་ཡང་འདུག་ནས་ཕྱེ་དང་ནི།",
    "དབྱར་གྱི་ནང་དུ་ཐུགས་དང་འགལ་བ་ཐམས་ཅད་བཟོད་པར་གསོལ་ཞེས་བྱས་ལ་འདུག་སྟེ།",
    "དེ་ནས་དགེ་སློང་གཞན་རྣམས་གསུམ་གསུམ་མན་ཆད་ཀྱིས་བསྐོས་པ་དེ་རྒན་ན་ཕྱག་བྱས་ཙོག་པུར་འདུག་སྟེ།"
