    "དོན་གི་རྣམ་གཅོད་ཐ་དད་པ་བཞིན་དུ་སྒྲའི་རྣམ་གཅོད་ཀང་ཐ་དད་དུ་འཇུག་སེ།",
    "བྱས་པས་མ་བྱས་པ་བསལ་ནས་སྒྲ་ལ་མི་རག་པ་ལ་སོགས་པ་གོ་བར་བྱེད་པ་བཞིན་དུ་རོད་བྱེད་ཀིས་ཀང་བྱས་པ་ལ་སྒྲ་གཞན་དངོས་མིང་དུ་འཇུག་པ་རྣམ་པར་གཅད་ནས་ནི་སྒྲའི་སི་བྱས་པ་ཞེས་བརོད་པའི་ཚིག་གིས་བྱས་པ་བརོད་པར་བྱེད་པའི་ཕྱིར།",
    "སྒྲ་དོན་གཞན་བསལ་ནས་རང་གི་དོན་གོ་བར་བྱེད་པ་མི་འཐད་དེ།",
    "དེས་ན་སྐབས་འགར་སི་སྒྲ་ལས་ཁད་པར་ལ་ཐེ་ཚོམ་ཟ་བར་འགྱུར་སིད་ཀང་སི་སྒྲས་དོན་གཞན་རིགས་མི་མཐུན་བསལ་ནས་རང་གི་དོན་གོ་བར་བྱེད་པའི་སྐབས་སིད་དེ།",
    "རང་གི་བརོད་བྱའི་དོན་གི་ཆ་ཤས་ཡན་ལག་སོན་པའི་རེས་སུ་འགོ་བའི་ངེས་པའི་སོ་ནས་ཀུན་བཏུས་རབ་བྱེད་རྒྱན།",
    "རང་གི་བརོད་བྱའི་དོན་བརོད་པའི་ཕྱིར།",
    "རང་གི་བརོད་བྱའི་དོན་སི་ཤར་བ་ལ་འཁྲུལ་བའི་ཕྱིར་ཞེ་ན།",
    "རང་གི་བརོད་བྱའི་སི་ཤར་བ་ལ་འཁྲུལ་པ་཈ིད་ཀང་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "དེ་ཡོད་མེད་ཀི་རེས་སུ་འགོ་ལྡོག་བྱེད་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་དངོས་པོར་ཡོད་པའི་སྒྲས་གསུམ་ལ་ཐེ་ཚོམ་གི་རྒྱུ་དང་།",
    "རས་ཀི་སྒྲས་ག་཈ིས་ལ་ཐེ་ཚོམ་གི་རྒྱུ་དང་།",
    "དེ་ནི་གོང་གི་མ་མཐོང་ཡང་ཞེས་པའི་གཞུང་འཛུགས་པ་ཡིན་ནོ།",
    "སྒྲ་ཐ་དད་ཀིས་དོན་ཐ་དད་བརོད་པ་ཙམ་གིས་རས་ཐ་དད་ཀི་མཚན་཈ིད་རོགས་པ་ལས་དེ་ཡང་ཁོད་ཀིས་མི་འདོད་པའི་ཕྱིར་ཞེ་ན།",
    "ཤིང་བརོད་པ་དང་ཤ་པ་བརོད་པའི་སྒྲ་ཐ་དད་ཀིས་དོན་ནི་ཐ་དད་བརོད་པ་ཙམ་དེས་བརོད་བྱ་རས་ཐ་དད་དུ་འགྱུར་བའི་མཚན་཈ིད་རོགས་པ་མིན་པར་ཐལ།",
    "ཤིང་དེ་ཤིང་མ་ཡིན་གཞན་ལ་ཁབ་པ་བཀག་ཀང་རང་གི་གསལ་བ་ལ་རེས་སུ་འགོ་བ་མ་བཀག་པའི་ཕྱིར།",
    "དེ་ལ་ཁབ་པ་མེད་པར་ཐལ།",
    "ངེད་ཀི་ལུགས་ལ་སི་དོན་གཞན་ཡོད་པས་འཇིག་རེན་ན་གཟུགས་ཀི་སྒྲ་སོན་པོ་སོགས་ལ་འཇུག་ཅིང་།",
    "འཇིག་རེན་གི་གགས་པ་དེ་ཁོ་ན་཈ིད་ཀི་དོན་འབའ་ཞིག་ཏུ་མི་འཐད་པ་དང་།",
    "འཇིག་རེན་རོག་པ་ལ་ཇི་ལྟར་སྣང་བ་ལྟར་གགས་པའི་རེས་སུ་འབྲང་ནས་སི་གསལ་རས་ཐ་དད་ཀི་ཐ་སྙད་དེ་ཁོ་ན་཈ིད་དུ་གྲུབ་པར་མི་བཙལ་བ་སེ་བཙལ་མི་རིགས་པར་ཐལ།",
    "གཞི་ལྡོག་དང་རང་ལྡོག་གི་རྣམ་གཞག་ལ་མཁས་དགོས་པའི་ཕྱིར།",
    "གལ་ཏེ་འབྲེལ་མེད་ཐ་དད་དུ་མཚུངས་པ་ལ་གཟུགས་ཀི་སྒྲ་སོན་པོ་ལ་འཇུག་གི་རོ་ལ་སོགས་པ་ལ་མི་འཇུག་པ་ཅི་ཡིན་ཞེ་ན།",
    "ལ་འཇུག་ལ་རོ་ལ་སོགས་པ་ལ་མི་མཇུག་པའི་ཁད་པར་འཐད་པར་ཐལ།",
    "གཟུགས་཈ིད་ཀི་སི་དོན་གཞན་ལ་ཡང་གསལ་བ་རྣམས་དང་འབྲེལ་མེད་ཀི་཈ེས་པ་མཚུངས་པར་འགྱུར་བའི་ཕྱིར་ཞེས་འགེལ་པ་དང་།",
    "གཟུགས་ཀི་སྒྲ་སོན་པོ་ལའང་མི་འཇུག་པར་ཐལ།",
    "གཟུགས་ཀི་སྒྲ་རོ་ལ་མི་འཇུག་པར་ཐལ།",
    "ཁོད་སོན་པོ་ལ་མི་འཇུག་པར་ཐལ།",
    "མིག་གི་གཟུང་བྱ་཈ིད་དུ་འགྱུར་བའི་ཕྱིར་རམ།",
    "ཧ་ཅང་ཐལ་བ་དང་།",
    "ལྡོག་པ་མེད་པའི་རེས་འགོ་འབའ་ཞིག་གི་སྒྲ་ལས་ལས་དོན་རོགས་པ་མི་འཐད་པའོ།",
    "མིག་གི་གཟུང་བྱ་ཡིན་པའི་ཕྱིར།",
    "ཁོད་ལ་ཆེས་སོ་བ་ལ་སོགས་པའི་ཁད་པར་མེད་པར་འགྱུར་པར་ཐལ།",
    "དེའི་སྐྱོན་མེད་པར་ཐལ།",
    "གསུམ་པ་གངས་ཅན་གི་ལུགས་དགག་པ་ལ་ག་཈ིས་ཏེ།",
    "གངས་ཅན་ཁ་ཅིག་ན་རེ།",
    "རྣམ་འགྱུར་གི་དངོས་པོ་ཐམས་ཅད་ཆ་ཤས་མེད་པའི་མཚན་཈ིད་ལྔ་ལྡན་གི་གཙོ་བོའི་རྣམ་འགྱུར་དང་དེ་དག་གི་རང་བཞིན་དུ་འགྱུར་རོ་ཞེ་ན།",
    "ཧ་ཅང་ཐལ་བ་དང་།",
    "མཚན་཈ིད་ལྔ་ལྡན་དུ་ཡོད་པའི་གཙོ་བོ་དེ་རྣམ་འགྱུར་དུ་མའི་བདག་཈ིད་ལས་རང་བཞིན་ཡིན་ཞེས་འདོད་པ་མི་འཐད་པར་ཐལ།",
    "ཕན་ཚུན་མེད་པའི་གསལ་བ་ཐ་དད་ལས་གཞན་མིན་ཡང་སེ་དེ་མ་ཡིན་རྣམ་པར་གཅོད་པར་མཚུངས་པ་ལ་བ་གླང་ངོ་རའོ་སྙམ་པའི་ཐ་དད་ཀི་བོ་སྐྱེ་བ་ཅི་སེ་འགག་པ་མི་རིགས་པར་ཐལ།",
    "ཆ་ཤས་མེད་པའི་རང་བཞིན་གཅིག་ལ་རྣམ་འགྱུར་ཐ་དད་པའི་བོ་དུ་མ་འཇུག་པ་མི་རིགས་པར་ཐལ།",
    "ཐ་སྙད་ཡིན་ན་དེ་ཁོ་ན་཈ིད་ཀི་དོན་ཅན་འབའ་ཞིག་ཡིན་པས་ཁབ་པས་སར་གི་཈ེས་པ་མེད་དོ་ཞེ་ན།",
    "དེ་ནི་མི་རིགས་པར་ཐལ།",
    "ཀི་གནས་ལུགས་སུ་སྒྲོ་བཏགས་པའི་བདེ་སྡུག་གཏི་མུག་གསུམ་ལ་སོགས་པའི་ཡོན་ཏན་རྣམས་ཀི་རང་བཞིན་གི་མཆོག་གཙོ་བོ་གང་དུས་ནམ་ཡང་མངོན་སུམ་ལ་སོགས་པའི་སྣང་བའི་ལམ་དུ་མ་གྱུར་པ་གང་སྣང་བའི་ལམ་དུ་གྱུར་པ་ཡིན་ན་སྒྱུ་མ་བཞིན་དུ་སོང་ཞིང་བརྫུན་པས་ཁབ་པར་ཁས་བངས་པའི་ཕྱིར་རོ།",
    "གངས་ཅན་ན་རེ་རས་ཐ་དད་པའི་ཤིང་གསལ་རྣམས་མ་འདྲེས་པར་མཐོང་བ་ལ་གཞན་཈ིད་ཀི་བོ་སྐྱེ་བའི་དཔེར་ཀོག་ཤལ་སོགས་འདུས་པ་ལ་བ་གླང་གི་བོ་སྐྱེ་བ་ཞེས་སྨྲོས་པ་མི་འཐད་དེ།",
