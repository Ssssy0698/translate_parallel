    "རོད་བྱེད་ཀི་སྒྲ་ཀུན་གིས་སི་བརོད་པར་མཚུངས་ན་རིགས་བརོད་དང་ཚོགས་བརོད་ཀི་ཁད་པར་མི་འཐད་པ་སྤང་བའོ།",
    "སི་ནི་དུ་མ་ལ་བརེན་པ་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "འདོད་རྒྱལ་བའི་སྒྲ་ལའང་བརོད་བྱའི་དོན་གི་དབྱེ་བས་རིགས་བརོད་ཀི་སྒྲ་ཡན་ལག་དུ་མ་ལ་དངོས་སུ་འཇུག་པ་དང་།",
    "དཔེར་ན་ཚོགས་པ་ཅན་ལ་ཚོགས་པར་བཏགས་པ་གོང་གི་ཕག་བཟའ་བྱ་མ་ཡིན་ནོ་ཞེས་བརོད་པ་ན་དེའི་ཡན་ལག་གི་ཆ་ཤས་རྣམས་ཀང་བཟའ་བྱ་མ་ཡིན་པར་བསན་པ་ལྟ་བུའོ།",
    "རིགས་བརོད་ཀི་སྒྲ་རང་གི་རིགས་ཅན་དུ་གྱུར་པའི་ཚོགས་པ་ཅན་དང་ཚོགས་པ་དུ་མ་ལ་དངོས་སུ་འཇུག་ཀང་སི་བརོད་པ་ལ་ལྟོས་པར་བསན་པའོ།",
    "གལ་ཏེ་སྒྲ་ག་཈ིས་ཀ་ཡང་སི་བརོད་པར་བྱེད་པ་ཡིན་ན་རིགས་དང་ཚོགས་པ་བརོད་པའི་སྒྲ་ལ་ཁད་པར་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲ་དེ་ག་཈ིས་ཀིས་སི་བརོད་བྱར་བྱས་པར་མཚུངས་ཀང་རིགས་ཀི་སྒྲས་རང་གི་གསལ་བ་སོ་སོ་ལ་དངོས་སུ་འཇུག་ཅིང་ཚོགས་པའི་སྒྲ་ནི་ཚོགས་པའི་ཆ་ཤས་རྣམས་ལ་བཏགས་ནས་འཇུག་པའི་ཕྱིར་རོ།",
    "པུས་མོ་ཙམ་ནུབ་པ་ལ་མི་ལྟོས་པའི་ཕྱིར་དང་།",
    "དེ་བཞིན་དུ་ཁུར་ཚུར་གི་སྒྲ་ཁུ་ཚུར་གི་ཆ་ཤས་རྣམས་ལ་བདེན་པར་དངོས་སུ་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "ཚོགས་པ་བརོད་པ་ལ་ཡང་ཡན་ལག་སོ་སོ་བ་རོགས་པར་བརོད་པར་བྱེད་པ་གོང་གི་སྒྲ་ཁང་པ་དང་།",
    "འཇུག་པར་མི་བྱེད་པ་ཁྱུ་ཞེས་པའི་སྒྲ་བ་གླང་ལྟ་བུ་རེ་རེ་བ་ལ་བདེན་པར་མི་ལྟོས་པའི་ཕྱིར་དང་།",
    "ཚོགས་པའི་སྒྲས་ཚོགས་པ་ཅན་ལ་འཇུག་པ་དེ་ཆ་ཤས་ཀིས་བདེན་པར་ཁད་པར་དུ་བྱས་ནས་འཇུག་པ་མིན་པར་ཐལ།",
    "གལ་ཏེ་རིགས་བརོད་ཀི་སྒྲ་རང་གི་རིགས་ཅན་དུ་གྱུར་པའི་ཚོགས་པ་དང་།",
    "ཚོགས་པ་ཅན་དང་ཚོགས་པ་དུ་མ་ལ་དངོས་སུ་འཇུག་ན་སི་བརོད་པ་ལ་ལྟོས་པ་མི་འཐད་དོ་ཞེ་ན།",
    "རིགས་བརོད་ཀི་སྒྲ་རྣམས་ནི་རང་གི་རིགས་ཅན་཈ིད་བརོད་བྱར་མི་སྤང་བ་དང་།",
    "ཤིང་གི་སྒྲ་ལས་ཤ་པ་སོགས་སྐབས་སོབས་ཀིས་རོགས་པའི་དོན་ནི་བརྡས་བཏགས་ནས་བསན་པ་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་མི་འཐད་པར་ཐལ།",
    "བུམ་པ་ཞེས་པའི་སྒྲ་བུམ་པ་དང་ངོ་བོ་཈ིད་ཀིས་འབྲེལ་པ་མ་ཡིན་གི་བརྡའ་ཙམ་གིས་བཏགས་པའི་ཕྱིར་རོ།",
    "དོན་གི་རང་ཕྱོགས་སྒྲུབ་པའི་ཚུལ།",
    "གཞུང་གི་དོན་ནོ།",
    "རོལ་བས་སྒྲུབ་བྱེད་བཀོད་པས་ཕྱིར་རོལ་གི་ངོར་ངེས་པའི་ཤེས་པ་བསྐྱེད་པར་མི་ནུས་ཤིང་།",
    "རེས་འགོ་མེད་པ་དང་།",
    "སྒྲ་མི་རག་པར་སྒྲུབ་པའི་རགས་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "ཕྱིར་རོལ་བས་བསྒྲུབས་ནས་ངེས་ཤེས་བསྐྱེད་ནུས་ཀང་སར་གི་སྒྲུབ་བྱེད་སྐྱོན་ཅན་ལས་མ་འདས་སོ།",
    "གལ་ཏེ་སུན་འབྱིན་ཡང་དག་དུ་འགྱུར་བ་ལ་དོན་སྐྱོན་ཞུགས་པར་སོན་ནུས་པ་འབའ་ཞིག་གིས་ཁབ་པ་ཡིན་ནམ་ཞེ་ན།",
    "གཞན་དོན་རེས་དཔག་གི་སྐབས་སུ་བོའི་སྐྱོན་དང་།",
    "ཕྱིར་རོལ་གིས་ལན་རྣལ་མར་བསམ་ཀང་སྐྱོན་མེད་ལ་སྐྱོན་དུ་བརོད་པའི་ངག་ནི།",
    "ཕྱིར་རོལ་གི་ལན་ལོག་པ་མཐའ་དག་ཡིན་ཡང་།",
    "རང་གིས་཈ེས་པར་བརོད་པ་ཇི་ལྟ་བ་བཞིན་དུ་རང་ལ་཈ེས་པ་མཚུངས་པར་འཇུག་པའི་སུན་འབྱིན་ནི།",
    "ཚར་བཅད་པ་ཡི་གནས་ཡིན་གི།",
    "སྐབས་དེའི་སྒྲུབ་བྱེད་རོགས་ནས་ཡིན་གི།",
    "སྒྲུབ་བྱེད་ཀི་ཡན་ལག་སྐྱོན་མེད་སྨྲ་བ་བཞིན་དུ་རང་གི་ཕྱོགས་འགྲུབ་པ་མཚུངས་པ་མ་ཡིན་ནོ།",
    "ལྟག་ཆོད་ལ་ནི་རེས་མཐུན་གི་ལན་དེ་སྐྱོན་ཅན་དུ་ཤེས་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "རང་གིས་གཞན་གི་གཏན་ཚིགས་ལ་ཕད་མ་ཕད་བརགས་ནས་སྐྱོན་བརོད་པ་ཇི་ལྟ་བ་བཞིན་དུ་རང་གི་སུན་འབྱིན་ལ་ཡང་སྐྱོན་ཇི་ལྟ་བ་བཞིན་དུ་མཚུངས་པའི་སུན་འབྱིན་ལྟར་སྣང་བ་ཡིན་པའི་ཕྱིར།",
    "ཁོད་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་བསྒྲུབ་བྱ་དང་ཕད་མ་ཕད་སོགས་སར་བཞིན་བཏགས་པའི་སུན་འབྱིན་ལྟར་སྣང་ཡིན་ན་ཕད་པ་དང་མ་ཕད་པ་དག་མཚུངས་པའི་ལྟག་ཆོད་ཡིན་ཏེ།",
    "རགས་དེ་བསྒྲུབ་བྱ་ལས་སར་གྲུབ་ན་འདི་གང་གི་གཏན་ཚིགས་ཡིན།",
    "རང་གིས་གཞན་གི་གཏན་ཚིགས་ལ་དུས་གསུམ་དུ་བརགས་ནས་སྐྱོན་བརོད་པ་ཇི་ལྟ་བ་བཞིན་དུ་རང་གི་སུན་འབྱིན་ལ་ཡང་སྐྱོན་ཇི་ལྟ་བ་བཞིན་དུ་མཚུངས་པའི་སུན་འབྱིན་ལྟར་སྣང་ཡིན་པའི་ཕྱིར་རོ།",
    "སུན་འབྱིན་ལྟར་སྣང་ཡིན་པར་ཐལ།",
    "གཏན་ཚིགས་ཡང་དག་ཏུ་མ་ཚང་བ་ལ་བསྐུར་པ་འདེབས་པའི་རོད་པ་རེས་མཐུན་པ་སུན་འབྱིན་གི་གཟུགས་ཅན་ཙམ་གི་རོད་པའི་ངག་ཡིན་པའི་ཕྱིར།",
    "རང་གིས་གཞན་ལ་བརགས་ནས་སྐྱོན་བརོད་པ་ཇི་ལྟ་བ་ནཱ་ལནྡྲའི་མཁན་རབས་གསུམ་པ་དགྱེ་བ་རྒྱལ་མཚན།",
    "བསྒྲུབ་བྱ་རོགས་པའི་ངེས་ཤེས་སར་མ་སྐྱེས་པ་ལ་གཏན་ཚིགས་འཇུག་པ་ཡིན་གི།",
    "རེས་དཔག་སྐྱེས་ནས་གཏན་ཚིགས་དགོས་པ་མེད་པའི་ཕྱིར།",
    "རེས་དཔག་བསྒྲུབ་བྱ་དང་།",
    "སྒྲུབ་བྱེད་ཀི་ཚིག་གིས་བརོད་པའི་དོན་རགས་ཡིན་པ་ལ་བསམས་ནས་རོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་འདྲའི་སུན་འབྱིན་དེ་མ་གྲུབ་པ་ལྟར་སྣང་ཡིན་པར་ཐལ།",
    "སྒྲ་དང་མི་རག་པའི་ཚོགས་དོན་དེ་སྒྲུབ་ཀི་སྒྲུབ་བྱ་ཡིན་གི་རོགས་པ་སེ།",
    "དེ་བརོད་པའི་ཚིག་དེ་དེའི་ཚེ་དེ་སྒྲུབ་ཀི་ཕྱིར་རོལ་གིས་མ་གྲུབ་པ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱའོ།",
    "སྒྲ་མི་རག་པ་བསྒྲུབ་བྱ་ཡིན་གི་དེར་རོགས་ཀི་བོ་བསྒྲུབ་བྱ་མ་ཡིན་པས་སྒྲ་མི་རག་པ་དེའི་ཚེ་མ་གྲུབ་པ་མ་ཡིན་པའི་ཕྱིར་ཞེས་ཟེར་རོ།",
    "དེས་ན་སྒྲ་དེ་དག་རག་པར་འགྱུར་གི་མི་རག་པར་བཞག་ནུས་པ་མིན་པར་འགྱུར་ཏེ།",
    "དུས་རག་ཏུ་མི་རག་པའི་རེས་སུ་འགོ་བའི་ཕྱིར་ཞེས་ཟེར་རོ།",
    "རང་གིས་གཞན་གིས་སྒྲ་མི་རག་པར་དམ་བཅས་པ་ལ་཈ེས་པ་བརོད་པ་དེ་཈ིད་རང་གིས་ཀང་གཞི་གང་མི་རག་པར་དམ་བཅས་པ་ལའང་སུན་འབྱིན་དེ་཈ིད་རང་ལ་ཡང་མཚུངས་པའི་རོད་ངག་ཡིན་པའི་ཕྱིར་རོ།",
    "རེས་མཐུན་བརོད་པ་སེ།",
    "རོལ་བྱུང་གིས་དུང་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་གཏན་ཚིགས་ཀི་ཚིག་བརོད་པའི་སར་གཏན་ཚིག་མེད་པའི་བསྒྲུབ་བྱ་དུང་གི་སྒྲ་དང་མི་རག་པའི་ཚོགས་དོན་ཡང་མེད་པར་ཐལ་བས།",
    "དེས་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པར་མི་ནུས་ཞེས་རོད་དོ།",
    "རང་གིས་གཞན་གིས་རོལ་བྱུང་རགས་སུ་བརོད་པ་ལ་སུན་འབྱིན་བརོད་པ་ཇི་ལྟ་བ་བཞིན་དུ་གཞན་གིས་རགས་སུ་མ་བརོད་ཡང་རང་གིས་རགས་སུ་བརོད་པ་གཞན་ལའང་སུན་འབྱིན་ཇི་ལྟ་བ་བཞིན་དུ་མཚུངས་པའི་རོད་ངག་ཡིན་པའི་ཕྱིར།",
    "སུན་འབྱིན་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "དེས་ན་ཚིག་ཙམ་གིས་བསྒྲུབ་བྱ་སྒྲུབ་ནུས་པ་མ་ཡིན་ནོ།",
    "སུན་འབྱིན་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "གཏན་ཚིགས་ཡང་དག་གི་དཔེ་མ་ཚང་བའི་སུན་འབྱིན་ལྟར་སྣང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་རྒྱུའི་རོལ་བ་ལས་བྱུང་བ་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་རགས་མ་གྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་དེ་སྒྲུབ་ཀི་རགས་ཀི་ཚིག་བརོད་པ་ལས་སར་དུང་གི་སྒྲ་མ་སྐྱེས་པས་དེ་རོལ་བྱུང་དུ་མེད་པའི་ཕྱིར་དང་།",
    "དུང་གི་སྒྲ་རོལ་བྱུང་དུ་མ་འགྲུབ་པའི་ཤུགས་ཀིས་དེ་རག་པར་འགྱུར་རོ་ཞེས་རོད་ན།",
    "རང་གིས་གཞན་གིས་རོལ་བྱུང་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་རགས་སུ་བརོད་པ་ལ་སུན་འབྱིན་བརོད་པ་ཇི་ལྟ་བ་བཞིན་དུ་རང་གིས་རོལ་བྱུང་མ་ཡིན་པ་དུང་གི་སྒྲ་རག་པར་སྒྲུབ་པའི་རགས་སུ་བརོད་པ་ལའང་ཇི་ལྟ་བ་བཞིན་དུ་མཚུངས་པའི་རོད་པ་ངག་ཡིན་པའི་ཕྱིར།",
    "དུང་གི་སྒྲ་སྐྱེ་བ་ལས་སར་རོལ་བྱུང་དུ་སྒྲུབ་བྱེད་དུ་ནཱ་ལནྡྲའི་མཁན་རབས་གསུམ་པ་དགྱེ་བ་རྒྱལ་མཚན།",
    "སྒྲ་མི་རག་པར་སྒྲུབ་པ་ལ་བྱས་པའི་ཕྱིར་ཞེས་འབྲས་བུ་རགས་སུ་བཀོད་པ་ལ་འབྲས་བུའི་དབྱེ་བ་གཞན་཈ིད་ཀི་ཆ་ནས་བརགས་ནས་ར་བུམ་རང་གི་རྒྱུ་དབྱུག་གུ་དང་འཁོར་ལོ་སོགས་ཀི་འབྲས་བུ་ཡིན་ཞིང་།",
    "སྒྲ་རང་རེན་གི་འབྲས་བུ་ཡིན་པས་སྒྲའི་འབྲས་བུ་མཐུན་དཔེ་ལ་རེས་སུ་མི་འགོ།",
    "བུམ་པའི་འབྲས་བུ་རོད་གཞི་ལ་རེས་སུ་མི་འགོ་བའི་ཕྱིར་བསྒྲུབ་བྱ་སྒྲ་དང་མི་རག་པའི་ཚོགས་དོན་མི་འགྲུབ་པར་སོན་ཞིང་རོད་པར་བྱེད་ན།",
    "དེ་཈ིད་རག་པ་ལ་འགོད་ཚུལ་དང་མཐུན་པར་མེད་དོ་ཞེས་རོད་ན་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པའི་ལྟར་སྣང་དང་།",
    "དུང་གི་སྒྲ་ཡང་རག་པར་འགྱུར་རོ་ཞེས་རོད་ན།",
    "དུང་གི་སྒྲ་དང་ནམ་མཁའ་ལུས་ཅན་མ་ཡིན་པ་ཙམ་དུ་མཐུན་པའི་དཔེ་ཡིས་དུང་གི་སྒྲ་གཞན་རག་པར་སྒྲུབ་པར་འདོད་ནས་རགས་ཡང་དག་ལ་སྐུར་པ་འདེབས་པའི་རོད་པའི་ངག་ཡིན་པའི་ཕྱིར།",
    "རོལ་བྱུང་གིས་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་བུམ་པ་དང་།",
    "ལུས་ཅན་མ་ཡིན་ཕྱིར་དུང་གི་སྒྲ་རག་པར་འགྱུར་རོ་ཞེས་རོད་ན།",
    "དཔེ་ལྟར་སྣང་གི་སུན་འབྱིན་ལྟར་སྣང་དུ་བསན་པ་དང་།",
    "རོལ་བྱུང་གིས་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པ་ལ།",
    "དུང་གི་སྒྲ་རག་པར་འགྱུར་ཞེས་པ་དང་།",
    "དུང་གི་སྒྲ་རག་པར་ཡང་འགྱུར་རོ་ཞེས་རོད་ན།",
    "ཐུན་མོང་གི་མ་ངེས་པ་ལྟར་སྣང་བ་རྣམ་པ་ག་཈ིས་སུ་འགྱུར་བའི་སུན་འབྱིན་ཡིན་པའི་ཕྱིར།",
    "ཁོད་སུན་འབྱིན་ལྟར་སྣང་ཡིན་པར་ཐལ།",
    "རང་཈ིད་ལ་དཔེ་བཀོད་ཀང་རེས་འགོའི་ཁབ་པ་དང་ལྡོག་པ་ཅུང་ཟད་ཀང་བསན་པ་མེད་པའི་རོད་པའི་ངག་ཡིན་པའི་ཕྱིར་རོ།",
    "རོག་གེ་པ་ངན་པ་ཕལ་ཆེར་ན་རེ།",
    "སྒྲ་ནི་བུམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་མི་རག་པ་ཡིན་གི།",
    "དེ་མི་འཐད་པར་ཐལ།",
    "དེ་ལྟར་མི་འཐད་པར་ཐལ།",
    "གང་རོལ་བ་ལས་མ་བྱུང་བ་ཡིན་ན་རག་པས་ཁབ་ཅེས་པ་ལྟར་རེས་འགོ་ཕྱིན་ཅི་ལོག་཈ིད་ལས་ཀང་དེ་སྒྲུབ་ཀི་བསྒྲུབ་བྱ་འགྲུབ་དགོས་ན་དེ་ལྟར་དུ་མི་འཐད་པར་ཁས་བངས་པའི་ཕྱིར་རོ།",
    "དེས་ན་ཁོ་བོ་ཅག་གི་གཏན་ཚིགས་ལ་བཀོད་པའི་སྐྱོན་དེ་སུན་འབྱིན་ཡང་དག་ཏུ་འགྱུར་བ་མ་ཡིན་པར་ཐལ།",
    "རོལ་བྱུང་གིས་དུང་གི་སྒྲ་མི་རག་པར་སྒྲུབ་པའི་གཏན་ཚིགས་ཀི་ཚུལ་གསུམ་ཕྱོགས་གཅིག་ཏུ་ངེས་པ་ཡིན་ཡང་ཁོད་ཀིས་བཀོད་པའི་སྦྱོར་བ་ཕྱི་མ་དང་ས་མ་ལ་ཡོད་པ་མིན་པར་ཕྱིན་ཅི་ལོག་གི་མ་ངེས་པའི་ལྟར་སྣང་ཡིན་པའི་ཕྱིར།",
    "མི་རག་པར་འགྱུར་གི།",
    "དུང་གི་སྒྲ་ནི།",
