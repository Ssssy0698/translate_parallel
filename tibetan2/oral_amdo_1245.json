    "དེ་ལྟ་བས་ན་འདིར་ཡང་དེ་བཞིན་དུ་ཐ་དད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "སྒྲ་ནི་རང་གི་ངོ་བོའམ་རིགས་སུ་བྲྗོད་པ་དེ་ལ་འཇུག་ཅིང་དེ་དང་ལྡན་པར་ཉེ་བར་བརྟགས་པ་ཡིན་ནོ།",
    "དཔེར་ན་གང་མི་དེ་ནི་ང་རང་ངོ་ཞེས་བྲན་ལ་རང་གི་སྒྲར་བྲྗོད་པ་ནི་རྒྱལ་པོ་དང་བྲན་པོ་ལ་བློ་མཚུངས་པར་སྐྱེ་བ་ནི་མ་ཡིན་ནོ།",
    "དུང་གི་དཀར་པོའོ་ཞེས་བྱ་བ་བཞིན་ནོ།",
    "ལོག་པའི་ཤེས་པར་ཐལ་བར་འགྱུར།",
    "བྲྗོད་པར་བྱ་བའི་རིགས་དག་ལ་ཡང་སྒྲའི་རང་གི་ངོ་བོ་སྒྲོ་བཏགས་ནས་རྫས་སུ་བྲྗོད་པ་ཡིན་ནོ་ཞེས་སྲིད་པས་རིགས་དང་ལྡན་པ་དང་རིགས་ཀྱི་ངོ་བོ་ཡོད་པ་ལ་སོགས་པས་བྲྗོད་པ་ཡིན་ནོ།",
    "དེ་དག་གི་སྤྱི་དེ་ཇི་ལྟ་བུ་ཞིག་ཅེས་སྦྱར་བར་བྱའོ།",
    "དཔེར་ན་ཉིན་པར་མི་ཟའོ་ཞེས་པ་ལས་ནུབ་མོ་ཟ་བར་ངེས་པ་ལྟ་བུའོ།་།",
    "དེའི་ཕྱིར་སྔར་བྲྗོད་པ་ལྟར་བྱས་པ་ལ་སོགས་པ་བཞིན་དུ་སྒྲ་ཡང་གཞན་སེལ་བའི་སྒོ་ནས་རང་གི་དོན་སྟོན་པར་བྱེད་དོ་ཞེས་གནས་སོ།",
    "པ་བྲྗོད་པར་བྱ་བ་མང་མོད་ཀྱང་།",
    "རྣམ་གཅོད་ངག་གི་འབྲས་བུ་ཡིན།",
    "ཨཨུཏྤལ་སྔོན་པོ་ལ་སོགས་པའི་སྒྲ་ལ་བརྟེན་ན་ཡང་གཞན་སེལ་བའི་དབྱེ་བས་རང་གི་དོན་གྱི་ཁྱད་པར་བསལ་བར་བྱ་བའི་ཕྱིར་འགྲེང་བ་དང་བྱ་བབས་པ་དག་བཞིན་དུ་གཞན་སེལ་བའི་རང་གི་དོན་གཅིག་ལ་བསྡུས་ནས་གཞི་མཐུན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་སོ་སོ་བ་དེ་དག་རང་རང་གི་བྱེ་བྲག་ལ་ཐེ་ཚོམ་གྱི་རྒྱུ་ཅན་དུ་འདུག་པ་རྣམས་སྒྲ་གཞན་དང་ལྡན་བས་བསལ་བར་བྱེད་པ་མིན་པའི་ཕྱིར་དང་།",
    "ཁ་དོག་གི་དོན་ཅུང་ཟད་ཀྱང་།",
    "དེ་ལ་རེ་ཞིག་ཐ་མི་དད་པ་ནི་མ་ཡིན་ཏེ།",
    "ཕན་ཚུན་གཅིག་པར་ཐལ་འགྱུར་ཕྱིར།",
    "དོན་གཅིག་ལས་གཞན་མ་ཡིན་པའི་ཕྱིར་དེ་དག་ཀྱང་ཕན་ཚུན་ཐ་མི་དད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "འདུས་པ་དུ་མར་ཐལ་བར་འགྱུར།",
    "འདུས་པ་ནི་དུ་མ་ལས་གཞན་མ་ཡིན་པའི་ཕྱིར་དུ་མ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "ཨཨུཏྤ་ལའི་སྒྲ་དག་གི་དོན་ཡིན་ན་ནི་རང་དང་འདུས་པ་དག་ལ་ཡང་དེ་དག་ནི་དེ་ཉིད་དོ་ཞེས་གང་ལས་གཞི་མཐུན་པར་འགྱུར།",
    "འདི་ལ་རེ་ཞིག་སྔོན་པོའི་སྒྲས་ཐ་མི་དད་དུ་བྲྗོད་ཀྱི།",
    "སྤྱིའི་སྒྲ་ལས་བྱེ་བྲག་གི་སྒྲ་རྣམས་ལ་ཐེ་ཚོམ་ཟ་བར་མཐོང་ན་ནི་གང་ལས་ཐེ་ཚོམ་ཟ་བ་དེས་བྲྗོད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "འགྱུར་དུ་ཆུག་ན་ཡང་དོན་གྱི་བྱེ་བྲག་གི་སྒྲ་ལས་ཡིན་ཏེ།",
    "སྤྱི་རྟོགས་པ་ལ་ནི་འཁྲུལ་བའི་ཕྱིར་གང་ཡང་འདི་སྐད་དུ་བྱེ་བྲག་གི་ཁོངས་སུ་སྤྱི་འདུས་པའི་ཞེས་བྲྗོད་པར་བྱ་གྲང་ན་དེ་ལྟར་བྲྗོད་པར་བྱ་བ་ལས་བྲྗོད་པར་བྱ་བ་ཡང་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གཉིས་ཀ་ཡང་བྱེ་བྲག་གི་དོན་དུ་ཡིན་ན་ནི་རྣམ་གྲངས་པའི་སྒྲར་འགྱུར་ཏེ།",
    "དེ་དག་ནི་རེ་ཞིག་ཐ་མི་དད་པའི་ཕྱོགས་ལ་སྐྱོན་བྲྗོད་པའོ།",
    "གང་གི་ཚེ་ཡོན་ཏན་སྔོན་པོ་དང་།",
    "དེ་ལྟར་ན་རེ་ཞིག་དོན་ལ་གཉིས་སྲིད་པ་མ་ཡིན་ནོ།",
    "དེ་དག་གི་གཞི་མཐུན་པ་ལ་ཡང་འབྲེལ་པ་མ་བྲྗོད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་རིགས་དང་ཡོན་ཏན་ཙམ་བྲྗོད་པ་ཉིད་ཡིན་ནོ།",
    "མཚུངས་མི་མཚུངས་སུ་ཐལ་བར་འགྱུར།་།",
    "གང་གི་ཕྱིར་ཁྱད་པར་དུ་བྱེད་པ་ཐ་དད་པའི་རྫས་བྲྗོད་པ་དེའི་ཕྱིར་མི་མཚུངས་པར་འགྱུར་རོ།",
    "གལ་ཏེ་འདི་སྙམ་དུ་རེ་ཞིག་ཉེ་བར་བླངས་པའི་གཞི་མཐུན་པར་མཚུངས་པར་འགྱུར་བས་བྲྗོད་པར་མི་འདོད་པ་ནི་འབྲེལ་པར་བྱས་པ་ཁྱད་པར་མེད་དོ།",
    "དེའི་དངོས་པོར་བྲྗོད་པར་བྱ་བ་ཡིན་པས་ན་ཨཨུཏྤ་ལ་དང་སྔོན་པོ་ལ་སོགས་པ་བཞིན་པ་ལང་དང་རྟ་དག་ཀྱང་གཞི་མཐུན་པར་ཐལ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "རང་རང་གི་བསལ་བའི་རིགས་ཀྱི་རྒྱུའི་བྱེ་བྲག་དེར་བྱས་པ་དེ་དག་དེ་བཞིན་དུ་བྲྗོད་པ་ཡིན་པར་ཇི་ལྟར་ན་བྲྗོད་པར་མི་འདོད།",
    "དེ་བཞིན་དུ་གཞི་མཐུན་པར་ཐལ་བར་འགྱུར་བ་ཡང་མ་ཡིན་ནོ་ཞེ་ན།",
    "བ་ལང་ཉིད་ཀྱི་ཡོད་པ་ཉིད་ལ་སོགས་པ་གསལ་བར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་དེ་ལ་ཡང་མཚུངས་པར་བྲྗོད་པ་ནི་གཞི་མཐུན་པར་ཐལ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "ཡོན་ཏན་དང་རྫས་དག་ནི་དབྱིབས་མ་ཡིན་པའི་ཕྱིར་དེ་དང་འབྲེལ་པའི་སྤྱི་གསལ་བར་བྱེད་པ་མ་ཡིན་པར་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་ནུས་པའི་བྱེ་བྲག་གིས་རང་དང་སྤྱིའི་མཚན་ཉིད་གསལ་བར་བྱེད་པའི་ཕྱིར་རྫས་ལ་སོགས་པའི་ཐ་དད་ལ་ནི་དབྱིབས་ཀྱི་བྱེ་བྲག་ཡོད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "རེ་ཞིག་བ་ལང་ལ་སོགས་པའི་རྗོད་པར་བྱེད་པའི་སྒྲར་བྱས་པ་དེ་དག་གི་སྒྲ་འདོད་རྒྱལ་བ་ལ་རང་རང་གི་སྒྲས་བྲྗོད་པར་བྱ་བ་དེ་དག་ཁྱད་པར་ཡིན་ནོ།",
    "གལ་ཏེ་མངོན་སུམ་ཉིད་བ་ལང་གི་སྒྲ་ལ་སོགས་པའི་བྱེ་བྲག་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་དག་གི་ལྟར་ན་ཡང་།",
    "རྫས་ཀྱི་རང་བཞིན་ཅི་ཞིག་རང་གི་ཅི་གསལ་བར་བྱེད་པ་ཉིད་དོ།",
    "སྤྱིའི་རང་བཞིན་ཅི་ཞིག་རང་གི་རྫས་ཀྱི་གསལ་བར་བྱ་བ་ཉིད་དོ་ཞེས་ནུས་པའོ།་།",
    "རང་བཞིན་དུ་མ་དང་གཅིག་གི།",
    "རྫས་ནི་ཡོད་པ་ལ་སོགས་པ་སྤྱི་དུ་མའི་གསལ་བར་བྱེད་པའོ་ཞེས་སྤྱི་གཅིག་གི་རང་བཞིན་དུ་མར་བྱ་བ་དང་།",
    "ཁས་བླངས་པའི་བདག་ཉིད་དུ་མ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།་།",
    "དུ་མ་ཉིད་དུ་ཐལ་བར་འགྱུར།",
    "དེ་ལྟར་ན་རེ་ཞིག་གཞི་མཐུན་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "རེ་ཞིག་རྣམ་གྲངས་ཀྱི་སྒྲ་ལ་ནི་ཅིག་ཅར་དུ་སྦྱོར་བར་བྱེད་པའི་ཕྱིར་གཞན་སེལ་བར་མཚུངས་པ་ཡིན་གྱི་རང་གི་དོན་སོ་སོར་སྤོང་བ་ནི་རིགས་པ་མ་ཡིན་ནོ།",
    "སྤྱིའི་སྒྲས་ཀྱང་རང་གི་ཐ་དད་པ་རྣམས་ལ་དོན་གཞན་སེལ་བ་ནི།",
    "དེ་དག་གིས་ནི་སྤྱི་མ་ཡིན་པ་སྒྲའི་དོན་གཞན་སྤོང་བ་ལ་ལན་བྲྗོད་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་སྤྱིའི་སྒྲ་རང་གི་འདོད་པའི་དོན་གྱི་ཡུལ་ཉེ་བར་འགོད་པར་བྱེད་པ་ན་ཁྱད་པར་དུ་བྱེད་པ་རྣམས།",
    "དེ་བཞིན་དུ་སྤྱི་དང་ཁྱད་པར་གྱི་སྒྲ་དག་གི་རང་གི་དོན་ལ་སྤྱི་ལ་འཇུག་པར་བྱེད་པས་ན་གཉིས་སམ་མང་པོ་ཡང་རུང་སྟེ།",
    "ཅི་ཡང་རྒྱུ་གང་གིས་ན་ཐ་དད་པའི་སྒྲའི་དོན་གཞན་སེལ་བར་བྱེད་ཅེ་ན།",
    "ཤིང་ཤ་པའི་སྒྲ་ཤིང་དང་ལྷན་ཅིག་ཏུ་སྦྱར་བས་སེང་ལྡེང་ལ་སོགས་པའི་ཤིང་རྣམ་པར་སྤྱད་ནས་རང་གི་ཡུལ་དུ་ཉེ་བར་འཇོག་པར་བྱེད་པ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་རེ་ཞིག་ཐ་དད་པའི་སྒྲ་ལ་རྫས་གཅིག་བཏང་སྙོམས་སུ་བྱེད་པའི་ཕྱིར་ཁྱད་པར་དུ་གཞན་གྱི་སྒྲའི་དོན་སེལ་བར་རིགས་པ་ཡིན་ནོ།",
    "དེ་དག་གིས་ནི་སྤྱི་གཞན་གྱི་ཐ་དད་པ་རྣམས་དང་།",
    "ཤིང་གི་སྒྲ་དང་དོན་མཚུངས་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་ཤིང་གི་སྒྲས་པ་ལ་ཤ་ལ་སོགས་པ་སེལ་བར་མི་བྱེད་པ་དེ་བཞིན་དུ་ཤིང་ཤ་པའི་སྒྲས་ཀྱང་སེལ་བར་མི་བྱེད་དེ།",
    "གང་གི་ཕྱིར།",
    "གང་གི་ཕྱིར་ཐ་དད་ཀྱི་སྒྲ་ཐ་དད་པའི་དོན་གཞན་ལ་མཐོང་བ་དེའི་ཕྱིར་ཡང་སེལ་བ་ཉིད་དོ།་།",
    "ཅི་སྟེ་གང་གི་ཕྱིར་ན་མ་མཐོང་ངོ་ཞེས་བྱ།",
    "དངོས་པོའི་དོན་ལ་ནི་ཁོ་བོ་ཅག་གི་ང་རྒྱལ་ཙམ་གྱིས་ཆོག་པར་འཛིན་པའི་འཇུག་པ་བཀག་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མ་མཐོང་བ་ལས་སེལ་བར་བྱེད་ན་སྤྱིའི་སྒྲ་ཡང་རང་རང་གི་ཐ་དད་པ་རྣམས་ལ་མ་མཐོང་ངོ་ཞེས་གཞན་སེལ་བར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་བྱས་ན་ནི་སྤྱིའི་སྒྲ་དེ་བྱེ་བྲག་གི་སྣང་བ་ལ་ཐེ་ཚོམ་ཟ་བར་རིགས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་རྣམས་ལ་ཡང་སྔར་དམིགས་པ་ཡིན་ན་ནི་རེ་ཞིག་འགྲེང་བ་ལ་ཡང་།",
    "རང་གི་དོན་བྲྗོད་དེ།",
    "སྐྱོན་སྔ་མ་རྣམས་སུ་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རང་དང་འབྲེལ་པ་ཅན་དག་ལས་གཞན་ལ་མ་མཐོང་བའི་ཕྱིར་དེ་རྣམ་པར་སྤྱད་པའི་རྗེས་སུ་དག་པ་ནི་རང་གི་དོན་རྗོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྲྗོད་པར་བྱའོ།",
    "གང་དུ་ཤིང་གི་སྒྲ་ས་ལས་བྱུང་བ་ལ་སོགས་པ་མ་ཡིན་པ་ལ་མ་མཐོང་བ་དེའི་ཕྱིར་ལྡོག་པ་ཉིད་ལས་རྗེས་སུ་དཔག་པའོ།",
    "རང་གི་དོན་ལ་འཁྲུལ་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་རེ་ཞིག་ཉེས་པ་སྔ་མ་མེད་དོ།",
    "སྤྱིའི་སྒྲས་ནི་གང་དོན་གཞན་རྣམ་པར་གསལ་བར་བྱས་པ་རང་གི་བྱེ་བྲག་དེ་མི་འཕེན་པས་ན་ཐ་དད་པའི་སྒྲ་དང་གཞི་མཐུན་པ་དང་ལྷན་ཅིག་པར་འཐད་དོ།",
    "དེ་ལྟ་ན་རང་གི་དོན་ལ་མི་འཁྲུལ་བ་སྟེ།",
    "དོན་གཞན་ཉེ་བར་ལེན་པའི་སྒྲས་རང་རང་གིས་ཐ་དད་པ་རྣམས་ལ་འཇུག་པ་ནི་མེད་དོ།",
    "ཁ་དོག་གིས་ལྷག་པར་མ་བྲྗོད་པའི་ཕྱིར་རྗེས་མི་བཙལ།",
    "མིག་གི་གཟུང་བྱ་ཉིད་ནི་སྔོན་པོ་ལ་སོགས་པ་ཉིད་དང་ཐ་མི་དད་ཅིང་རོ་ལ་སོགས་པ་ལ་མེད་པ་ནི་རང་བཞིན་གྱིས་ཐ་དད་པ་ལས་སོ་ཞེ་ན།",
    "མིག་གི་གཟུང་བྱ་ཉིད་ཐ་མི་དད་ན་ནི་ཅིས་ན་གཟུགས་ཉིད་ཡིན།",
    "མིག་གི་གཟུང་བྱ་སྤྱི་ཉིད་ཀྱང་རུང་སྟེ།",
    "རྫས་ལ་སོགས་པར་ཐལ་བར་འགྱུར།",
    "རྫས་དང་གྲངས་དང་བོང་ཚོད་ལ་སོགས་པ་ཡང་མིག་གི་གཟུང་བར་བྱ་བ་ཡིན་པས་དེ་དག་ལའང་གཟུགས་ཉིད་ཡོད་པར་ཐལ་བར་འགྱུར་རོ།",
    "མིག་གི་གཟུང་བྱ་ཉིད་དུ་ཁྱད་པར་མེད་པ་ཡིན་པས་སྔོན་པོ་དང་སེར་པོ་དང་།",
    "དེའི་ཕྱིར་གདོན་མི་ཟ་བར་མིག་གི་གཟུང་བྱ་ཉིད་མེད་པར།",
    "འགའ་ཞིག་ན་རེ་འདི་སྐད་དུ།",
    "ཅད་ཀྱི་བདག་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཡོད་པ་མ་ཡིན་པའི་བདག་ཉིད་དུ་རབ་ཏུ་ཐོབ་པ་ཉིད་དོ་ཞེས་ཟེར་བ་ལ།་",
    "ཡིན་ཞེས་ཅི་ཞིག་གང་གིས་སྦྱོར།",
    "ཐམས་ཅད་མེད་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་པའི་ལན་འདི་ནི་སྦྱར་བར་མི་བྱའོ།",
    "གང་འགའ་ཞིག་ན་རེ།་",
    "ཇི་ལྟར་འཇིམ་པ་ལས་གཞན་མ་ཡིན་ན་ནི་དེ་ཙམ་གྱི་བློར་ཐལ་བར་འགྱུར་བ་ལ།",
    "གང་གིས་ན་བསྒྲུབ་པའི་སྒོ་ནས་ཁམ་ཕོར་ལ་སོགས་པའི་བློ་ཐ་དད་ཁས་ལེན་པར་བྱེད།",
    "བ་ལང་དང་ནོག་ལ་སོགས་པ་སྒྲ་ཐ་དད་པས་ཐ་དད་དུ་སེལ་བ་ཅན་ཡིན་ཡང་ཁྱོད་ཀྱི་ལུགས་ཁས་བླངས་ནས།",
    "རང་གི་རྣམ་རྟོག་སྤྲོས་པར་ཟད།",
    "རང་གི་ངོ་བོ་ནི་བྲྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་དེའི་སྒོ་ནས་ཐ་སྙད་དུ་མི་བྱའོ།",
    "བདག་གཞན་ཡོད་པར་ཁས་མི་ལེན་ན་ནི་ཁྱོད་ཀྱིའང་གསལ་བ་ནུས་པར་འགྱུར།",
    "གལ་ཏེ་དངོས་པོ་ལ་མེད་ན་ནི་བརྟག་པ་དེ་དག་རིགས་ན་ཁྱོད་ཀྱིའང་གསལ་བ་དང་ནུས་པ་མཚུངས་པར་འགྱུར་རོ།",
    "གང་ཞིག་ཚིག་གི་བྲྗོད་པ་འདི།",
    "ཚིག་གི་བྲྗོད་པ་ལ་དོན་མེད་དུ་ཟིན་ཀྱང་ཁ་ཡར་བ་ལ་ནུས་པ་མེད་པའི་ཕྱིར་ལུང་ལས་ཇི་ལྟར་གཞག་པ་ངག་ལས་རྣམ་པར་འཇོག་པར་བྱེད་དེ།",
    "དེའི་ཕྱིར་ཚིག་གི་དོན་གཟུང་བར་བྱ་བའི་ཐབས་ངག་གི་དོན་དུ་སྣང་བ་དང་པོའི་མ་གོམས་པའི་སྒྲའི་དོན་དང་འབྲེལ་པ་ཡིན་ཏེ།",
    "གང་དག་སོ་སོར་སྣང་བའི་དོན་རྣམས་ལ་ཕྱིའི་དོན་གཞན་ནམ་དེ་དང་འབྲེལ་པ་བོར་ནས་ངག་གི་དོན་དུ་རྟོགས་པར་བྱེད་པ་དེ་དག་གི་ལྟར་ན་ཡང་དེ་ནི་རྣམ་པར་རྟོག་པ་ཙམ་ཡིན་ནོ།་།",
    "རང་གི་རྐྱེན་དང་རྗེས་འབྲེལ་བས།",
    "དེ་དང་ཁྱད་པར་མེད་པ་དག་བཞིན་ཕྱི་རོལ་གྱི་དོན་མེད་ཀྱང་རང་གི་རྐྱེན་དང་རྗེས་སུ་འབྲེལ་པས་རྣམ་པར་རྟོག་པ་སྣ་ཚོགས་པ་སྐྱེད་པར་བྱེད་དོ།",
    "དེ་ཡང་ངག་གི་དོན་གཞན་ལས།",
    "འབྲེལ་པར་ཤེས་པའི་ངག་གི་དོན།",
    "དཔེར་ན་གྲོང་གི་ཕག་པ་བཟའ་བྱ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཁ་དོག་གི་ཁྱད་པར་ལ་ཁྲ་བོ་དང་།",
    "ན་ལུས་ཀྱི་ལས་ཀྱིས་བདག་གི་ལས་ཆད་པར་བྱེད་པ་ལྟ་བུའོ།",
    "ཇི་སྐད་དུ་ཕྱོགས་གྲུབ་པའི་སྒྲུབ་བྱེད་ཡིན་བཞིན་དུ་ཡང་གྲུབ་པ་ལྟར་སྣང་བར་འདོད་ཅེས་བྲྗོད་པ་དེ་དག་གི་སྒྲུབ་བྱེད་མ་ཡིན་པ་གཞན་ཉིད་དོ་ཞེས་ཕྱོགས་གྲུབ་པ་དགག་པའི་ཕྱིར་མ་ཚང་བ་ཉིད་ལ་སོགས་པ་གྲུབ་པའི་སྐྱོན་བྲྗོད་དོ།",
    "གང་གི་ཕྱིར་འདིས་ཕྱོགས་སྔ་མ་གྲུབ་པོ་ཞེས་བྲྗོད་པ་འདི་ལ་ལན་དུ་ཚང་བ་ལ་སོགས་པ་བྲྗོད་པར་རིགས་སོ།",
    "གྲུབ་པ་དང་ཕྲད་ན་ནི་བསྒྲུབ་བྱ་གྲུབ་ཟིན་ནས་འདི་གང་གི་གཏན་ཚིགས་ཡིན།",
    "གལ་ཏེ་གཏན་ཚིགས་བསྒྲུབ་བྱ་ལས་སྔར་སྒྲུབ་པར་བྱེད་ན་ནི་བསྒྲུབ་བྱ་འམ་གྲུབ་ན་འདི་གང་གི་གཏན་ཚིགས་ཡིན།",
    "གླང་གི་གཡས་གཡོན་བཞིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་ལྟར་ན་རེ་ཞིག་དང་བློའི་གཏན་ཚིགས་དག་ལ་བསྒྲུབ་པར་བྱ་བའི་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་གསུམ་མ་ཚང་བ་ལྟར་སྣང་བ་ཡིན་ནོ།་།",
    "གང་གི་ཚེ་དོན་གཏན་ཚིགས་ཡིན་པ་དེའི་ཚེ་ནི་ཚིག་ལས་ཡིན་པ་མ་བཀག་པའི་ཕྱིར་དེ་དོན་ལ་མ་གྲུབ་ལྟར་སྣང་བ་ཉིད་དེ།",
    "རིགས་སུ་ཆུད་མོད་ཀྱང་སེལ་བར་བྱེད་པའི་རང་བཞིན་གྱིས་སུན་འབྱིན་དུ་འགྱུར་རོ།",
    "བསྒྲུབ་བྱ་མེད་པར་ཐལ་བར་འགྱུར།",
    "སྨྲ་པོའི་ངག་གིས་སྒྲུབ་པར་བྱེད།་།",
    "གཞན་ལ་ནི་སྨྲ་བ་པོའི་ཚིག་གིས་དོན་སྒྲུབ་པ་ལ་སྨྲ་བ་ལས་སྔར་སྒྲོ་བཏགས་ནས།",
    "དེ་སྟེ་དེ་ཉིད་རྟག་པ་ལ་ཡང་མེད་དོ་ཞེ་ན་ནི་ཐུན་མོང་མ་ཡིན་པ་ཡིན་པའི་ཕྱིར།",
    "དེའི་དོན་སོ་སོར་ངེས་པ་ཉིད་ཀྱི་རྗེས་སུ་དཔག་པ་མེད་པ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུ་དག་གི།",
    "ཐུན་མོང་ལྟར་སྣང་རྣམ་པ་གཉིས།",
    "དེས་ཐུན་མོང་གི་མ་ངེས་པ་ལྟར་སྣང་པའོ།",
    "ཕྱོགས་ཕྱི་མ་ཇི་ལྟ་བ་བཞིན་དུ་ཕྱོགས་སྔ་མ་ཡང་ཡིན་པས་མཚུངས་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར།",
    "ཕྱིན་ཅི་ལོག་གི་ངེས་པ་ལྟར་སྣང་བར་བྲྗོད་དོ།་།",
    "ཕྱོགས་སྔ་མ་ལ་ནི་ཁོ་བོ་ཅག་གིས་སྦྱོར་བ་བཞིན།",
    "མིག་གི་གཟུང་བྱ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་བུམ་པ་ཁོ་ན་མི་རྟག་པར་འགྱུར་གྱི་སྒྲ་ནི་མ་ཡིན་ལ།",
    "འཁྲུལ་པ་ཅན་གྱི་བྱེ་བྲག་གིས།",
    "འདི་ལ་ཡང་འཁྲུལ་པ་ཅན་དང་ཐུན་མོང་མ་ཡིན་པ་དེ་བཞིན་དུ་རྟག་པའམ་སུན་འབྱིན་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་ཕྱོགས་ལ་མ་གྲུབ་པ་བཞིན་གཞན་ལ་མ་གྲུབ་པ་བསྟན་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པར་འགྱུར་རོ།",
    "སུན་འབྱིན་པ་ལ་ནི་ཐུན་མོང་ངམ་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པ་ལྟར་སྣང་བའོ།",
    "གལ་ཏེ་བསྲེག་པར་བྱ་བ་དང་བསྡོངས་པའི་བརྩལ་མ་ཐག་ཏུ་བྱུང་བ་ཉིད་བྲྗོད་ན་ནི་མངོན་སུམ་འབའ་ཞིག་པ་མིག་གི་གཟུང་བྱ་མ་ཡིན་པ་ཉིད་དང་རྫས་ཉིད་ལ་སོགས་པས་མ་ངེས་པ་ཡིན་ནོ།",
    "ཐལ་བར་འགྱུར་ཕྱིར་བྱེ་བྲག་མེད།",
    "ཟླ་བོ་མཉན་བྱ་མ་ཡིན་པའི་ཕྱིར་མེད་བཞིན་དུ་གང་དུ་གང་གིས་ན་བསྒྲུབ་བྱའི་ཞེས་གོ་བར་བྱ།",
    "བྱེ་བྲག་མེད་ཅེས་བྱ་བ་ནི་བྱེ་བྲག་མེད་པར་ཐལ་བའོ།",
    "འདི་ལ་ཡང་བྱེ་བྲག་མེད་པར་ཐལ་བར་འགྱུར་བས་ན་བུམ་པ་བཞིན་སྒྲའི་བྱེ་བྲག་ཉིད་རབ་ཏུ་སྟོན་པ་ཡིན་པའི་ཕྱིར་རྣམ་རྟོག་མཚུངས་པ་ལས་ཁྱད་པར་ཆེན་པོ་ཡོད་པ་མ་ཡིན་ནོ།",
    "བྱེ་བྲག་མེད་པར་མཚུངས་པ་སྔ་མ་ལས་ཐ་དད་དུ་བྱ་བའི་དོན་དུ་ཡང་གི་སྒྲ་སྨོས་སོ།",
    "དེ་ལྟར་འདིར་མཉན་བྱ་ཉིད་ལ་གནོད་པ་ནི་མཐོང་གི།",
    "ཇི་ལྟར་རྡུལ་གཉིས་པ་ནི་རྡུལ་གཅིག་སྔོན་དུ་སོང་བ་ཡིན་ཏེ།",
    "བུམ་པ་ལ་སོགས་པ་རྣམས་ཀྱི་སྔོན་དུ་རྡུལ་རགས་པ་སོང་བ་ཡིན་པའི་ཕྱིར་དེ་ལ་ལན་གང་ཞིག་ཡོད།",
