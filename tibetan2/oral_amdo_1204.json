    "རྟོག་པ་མངོན་སུམ་དུ་སྨྲ་བ་གཞན་གྱི་ལུགས་ལའང་སྐྱེས་བུ་གཅིག་གིས་ད་ལྟ་བ་ལ་མངོན་སུམ་དུ་མཐོང་ཞིང་དེ་ལས་རིགས་ནི་ཐ་དད་པ་འདས་པའི་བུམ་སོགས་ལ་རྣམ་པར་རྟོག་པ་སྐྱེ་བའི་ཚེ་དེ་གཉིས་རྟོག་པ་ཡིན་པས་རིམ་གྱིས་སྐྱེ་དགོས་ན།",
    "ཇི་ལྟར་བར་ཆད་པ་མིན་ཏེ་ཡིན་པར་ཐལ།",
    "དེ་ཐོས་པ་གང་གིས་འཇུག་པ་ཆེས་ཤིན་ཏུ་མྱུར་བའི་ཕྱིར།",
    "བར་མ་ཆད་དུ་མ་དམིགས་པར་ཐལ།",
    "ཡི་གེ་སྔ་མ་རྣམས་ཤེས་པ་དང་བར་རྣམ་པ་ཆོད་པ་དེ་ངོ་མཚར་ཏེ་མིན་པར་ཐལ།",
    "ཡི་གེ་སྔ་མ་རྣམས་ཤེས་པ་དང་བར་ཆོད་པ་དེ་ངོ་མཚར་ཏེ་མིན་པར་ཐལ།",
    "ཤེས་པ་ཅིག་ཅར་མི་སྐྱེ་བས་མཐོང་བ་སྔ་ཕྱིའི་བར་དུ་རྣམ་རྟོག་གིས་བར་བཅད་པ་ལས་རྟོག་པ་མངོན་སུམ་དུ་ཐལ་བའི་སྐྱོན་ཡོད་པ་མིན་ཏེ།",
    "སྣང་བ་ལ་ཁྱད་པར་མེད་པ་མིན་པར་ཐལ།",
    "ཡུལ་རིམ་དུ་འཛིན་པར་མི་འགྱུར་བར་མཐོང་བ་ཅིག་ཅར་མཚམས་སྦྱོར་བར་ཐལ།",
    "དོན་ངེས་པ་མི་འཛིན་པ་ཐམས་ཅད་འཛིན་པར་ཐལ།",
    "ཇི་ལྟར་ཁོ་བོ་ཅག་ཤེས་པ་ཅིག་ཅར་སྐྱེ་བ་དང་ཁྱོད་མི་སྐྱེ་བར་འདོད་པ་གཉིས་ཀ་ལ་ཡང་རྩོད་པ་འདི་ཡོད་པ་སྟེ་ངེད་ལ་བརྩད་པོ་ལྟར་ཁྱེད་ལའང་རྩོད་པ་མཚུངས་པར་འདོད་ལ།",
    "ཁྱོད་ཀྱིས་ཀྱང་ཡིད་བྱེད་མ་ཚང་བས་ཞེས་པའི་ཁོ་བོ་ཅག་གི་ལན་དེ་ལས་ལྷག་པ་མི་རྙེད་དོ།",
    "དེ་ལ་རིགས་སྤྱི་སྣང་བ་མ་ཡིན་པར་ཐལ།",
    "ཁྱབ་པ་ཡོད་འདི་ལྟར་སྔོན་པོ་ལ་སོགས་པའི་ཁ་དོག་དབྱིབས་ཡི་གེ་སྟེ་མིང་གི་རྣམ་པ་ཡིས་སྟོང་པ་བ་ལང་ཉིད་ཀྱི་སྤྱི་དག་ཏུ་བརྗོད་པའི་ཕྱིར།",
    "རང་གིས་འདོད་རྒྱལ་དུ་སྦྱར་བར་བྱས་ཀྱིས་དངོས་པོའི་སྟོབས་དང་འཇིག་རྟེན་གྱི་གྲགས་པ་ལ་འཇུག་པ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "འགའ་ཞིག་གི་ཚེ་ཡང་སྣལ་མ་དང་དུས་གཅིག་ཏུ་འདུ་བ་ཅན་གྱི་སྣམ་བུའི་རྫས་བརྗོད་པ་མིན་ཏེ།",
    "དང་པོར་སྣལ་མ་འདུ་བྱས་པ་ལས་བྱུང་བ་སྣལ་མའི་ཉེར་ལེན་ཅན་གྱི་སྣམ་བུ་སྣལ་མ་ལས་ཕྱིས་འབྱུང་གི་འབྲས་བུ་དེ་བརྗོད་པ་མཡིན་པའི་ཕྱིར།",
    "སྟེང་གི་རྭ་དེ་འོག་གི་ནོག་ལྐོག་ཤལ་དང་འབྲེལ་པའི་སྒོ་ནས་བར་རྣམ་པར་ཆད་པ་མེད་པར་སྣང་བ་ཉིད་ལས་འཇུག་པའི་ཕྱིར་རོ།",
    "དངོས་མིང་མ་༩དངོས་མིང་དུ་འཇུག་པའི་རྒྱུ་སྣལ་མ་དང་སྣམ་བུ་ལས་དོན་གཞན་པའི་འདུ་བ་མེད་པའི་ཕྱིར་ཡིན་པར་ཐལ།",
    "དབྱུག་པ་བཟུང་བ་མེད་པར་ཁྱོད་མི་འཇུག་ཅིང་དབྱུག་པ་དང་དབྱུག་པ་ཅན་ཕན་གདགས་བྱ་འདོགས་བྱེད་དུ་ཉེ་བར་བརྟགས་པ་ལ་རྟོག་པས་ཁྱད་པར་དང་ཁྱད་པར་ཅན་དུ་སྒྲོ་བཏགས་པའི་ཀུན་རྫོབ་པ་ལས་དེ་འདྲའི་ཐ་སྙད་འདོགས་པའི་ཕྱིར་རོ།",
    "ཚིག་གི་དོན་དང་དངོས་པོ་ལ་རྗེས་སུ་འགྲོ་བའི་ཕྱིར་དང་།",
    "ཐལ་བ་ལས་སྒྲ་འདི་དག་ཐམས་ཅད་དོན་གཞན་དུ་གྱུར་པའི་ཁྱད་པར་ལ་ལྟོས་པ་མིན་ཡང་རྗེས་སུ་འགྲོ་བས་མ་ངེས་པ་ཡིན་ནོ།",
    "ཅི་ཞིག་ཡིན་ཏེ་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "དེ་དག་གི་འབྲས་བུ་དེ་དག་འཛིན་པའི་བློ་བྱེད་པ་མེད་པའི་ཕྱིར།",
    "དཔེར་ན་ཤིང་གི་སྒྲ་རིགས་སྒྲ་ཡིན་པས་པཱ་ལ་ཤ་ལ་སོགས་པ་མང་པོ་ཡང་བརྗོད་ལ་གཅིག་ཀྱང་བརྗོད་པ་བཞིན་ནོ།",
    "ཆེན་པོ་དང་སོགས་པས་ཆུང་ངུ་དང་རིང་ཐུང་གི་སྒྲ་མི་འཇུག་པར་ཐལ།",
    "གལ་ཏེ་ཁང་བཟང་གི་ཕྲེང་སོགས་ལ་ནི་ཆེན་པོ་སོགས་མེད་པས་གསུམ་པ་དེའི་ཉེས་སྤོང་དགག་པ་ནི།",
    "ཆེན་པོ་སོགས་ཀྱིས་ཐ་སྙད་བཏགས་ནས་ཀྱང་མི་འཇུག་པར་ཐལ།",
    "གཞན་ཡང་ཁྱོད་གྱི་སྒྲ་ཤེས་དག་ལས་ཁྱད་པར་མེད་པའི་ཆེན་པོའི་སྒྲ་ཤེས་ཀྱི་གཟུང་བྱ་ཉིད་ཡིན་པའི་ཕྱིར་རོདུསཀ་ཀ་ཀྱིས་དངོས་བཏགས་ཀྱི་མཚན་ཉིད་བརྗོད་པ་དེ་ཡང་མ་གྲུབ་སྟེ།",
    "སྒྲ་འཇུག་པའི་ཡུལ་རང་ལས་དོན་གཞན་ཚིག་གི་སདོན་ཞེས་པ་གཅིག་ཡོད་པར་ཐལ།",
    "ཚིག་གི་དོན་ཞེས་པའི་སྒྲ་གཅིག་འཇུག་པའི་ཕྱིར།",
    "ཁྱེད་ཀྱི་དངོས་བཏགས་ཀྱི་མཚན་ཉིད་འཇིག་རྟེན་གྱི་གྲགས་པ་དང་མི་མཐུན་གྱི་རང་གིས་བཏགས་པ་འབའ་ཞིག་ཏུ་ཟད་དོ།",
    "འགའ་ཞིག་གི་ཚེ་བུའི་དངོས་པོ་འདོད་པའི་དོན་བསྒྲུབ་པའི་ནུས་པ་མེད་པ་ལའང་མེད་པ་བཞིན་དུ་དངོས་མེད་ཅེས་བཏགས་པའི་ཕྱིར་རོ།",
    "ཙིཏྟ་གྲགས་པས་གྲུབ་པ་དངོས་ཡིན་མོད་དེའང་ཁྱད་པར་དོན་གཞན་མེད་པར་མི་འཇུག་གོ་ཞེ་ན།",
    "འདོད་མི་ནུས་ཏེ་སྒྲས་དངོས་པོ་ལ་རེག་མི་ནུས་ཞེས་ཁྱོད་ཀྱིས་བརྗོད་པས་སོ།",
    "ཕྱི་རོལ་དོན་བྱེད་ནུས་པ་གཞན་རྣམ་པར་གཅོད་པའི་བདག་ཉིད་ལ་དངོས་སུ་རེག་པ་མེད་ཀྱང་སྣང་བརྟག་གཅིག་ཏུ་འཁྲུལ་ནས་དེ་རྟོགས་པར་འགྱུར་ཏེ།",
    "དེ་བརྗོད་པ་ལས་ཇི་ལྟར་ཕྱི་རོལ་གྱི་ཆ་དངོས་ཀྱི་བརྗོད་བྱར་བརྟེན་པ་སྟེ་ལྡན་པ་མ་ཡིན་པར་ཐལ།",
    "བ་ལང་གི་གསལ་བ་ལ་རྗེས་སུ་འགྲོ་བའི་བ་ལང་གི་སྒྲའི་དངོས་ཀྱི་བརྗོད་བྱ་མིན་ཏེ།",
    "བ་ལང་གི་གསལ་བ་ལ་རྗེས་སུ་འགྲོ་བ་མེད་པ་ཅན་ཡིན་པའི་ཕྱིར་ཏེ།",
    "གཟུགས་བརྙན་ལ་ཕྱི་རོལ་དུ་ཞེན་པའི་གཞན་སེལ་རྗོད་བྱེད་དུ་བརྡ་འབྲེལ་བྱས་པས་བརྡ་དང་ཐ་སྙད་ཀྱི་དོན་ཐ་སྙད་ཀྱི་ཚེ་མི་འདོད་པ་བཅད་ནས་རང་གི་དོན་ལ་གཅིག་ཏུ་འཁྲུལ་པས་ཕྱི་རོལ་དོན་རྟོགས་པར་འགྱུར་ཏེ།",
    "བརྗོད་བྱའི་རིགས་མཐུན་རང་གི་བརྗོད་བྱའི་རིགས་མི་མཐུན་གཞན་དུ་འཇུག་པ་མ་མཐོང་བ་ལ་ལྟོས་པ་དང་ལ་ལར་དེར་འཇུག་པ་མཐོང་བ་ལ་ལྟོས་ནས་བརྗོད་བྱ་རིགས་མི་མཐུན་བཅད་པ་སྟོན་པའི་སྒྲ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ནི་དྲང་སྲོང་ལ་བྱའི་བུ་རྫིས་ཚིག་གི་དོན་ཅན་དུ་ཡོད་པ་སྒྲུབ་བྱེད་རྗེས་དཔོག་ཀྱང་མེད་པའི་ཕྱིར་རོ།",
    "གཞན་ལས་ནི་ལྡོག་པ་ཉིད་ཁོ་སོགས་དང་དེ་དག་གི་འབྲེལ་པ་རྗོད་དུ་ཐ་སྙད་ཀྱི་དུས་སུ་བརྡ་སྦྱོར་བ་མིན་ཏེདེས་ནི་དྲང་སྲོང་རྟའི་བུ་རིགས་སྒྲའི་དོན་དུ་འདོད་པ་བཀག་གོན་ལ་ཐ་སྙད་ཀྱི་ཆེད་དུ་སྒྲ་སྦྱོར་བའི་ཕྱིར་རོ།",
    "རྟོག་པ་དེས་ད་ལྟར་གྱི་དོན་མིང་དང་སྦྱར་ནས་འཛིན་པར་ཐལ།",
    "ཐལ་བ་ལས་མིག་བློས་དོན་མཐོང་བ་ཡོད་ཀྱང་རྟོག་པས་མིང་དོན་སྦྱར་ནས་མི་འཛིན་པའི་ཕྱིར་ན་དེའི་ཚེ་མིག་ཤེས་དེ་བ་ལང་ལ་རྟོག་པ་མིན་གྱི་ཡུལ་གསལ་བའི་མངོན་སུམ་ཡིན་ཏེ།",
    "དེ་རང་ལ་སྣང་བའི་བ་ལང་གི་བརྡ་མི་འཛིན་པའི་ཕྱིར།",
    "ཁྱབ་པ་ཡོད་རྣམ་རྟོག་གི་ཡུལ་གང་ལ་སྒྲ་ནི་ངེས་པར་འགོད་པའི་མིང་གི་ཡུལ་དེ་ལ་དམིགས་ནས་སྒྲ་སྦྱོར་རྟོག་པ་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར།",
    "དེའི་གཟུགས་འཛིན་གྱི་བློ་མངོན་སུམ་གྱིས་མ་མཐོང་བར་ཐལ།",
    "ཐལ་བ་སྔ་མ་འདོད་ན།",
    "གཟུགས་ཀྱང་མངོན་སུམ་དུ་མ་རྟོགས་པར་ཐལ་ལ།",
    "རྩ་ཐལ་ལ་ཁྱབ་པ་ཡོད་གཟུགས་འཛིན་མྱོང་བ་དེ་ནི་ཁྱེད་ཀྱི་གཞུང་གིས་རྟོག་མེད་ཇི་ལྟར་ཡིན་ཏེ་མིན་པས་གཟུགས་འཛིན་དེ་མྱོང་བ་ཡོད་ན་གཟུང་འཛིན་གྱི་བློ་ཞེས་མཐོང་དགོས་པའི་ཕྱིར་རོརྩ་ཐལ་ལ་མ་གྲུབ་སྟེ།",
    "རང་གིས་རང་ཉིད་གཟུགས་མཐོང་བའོ་ཞེས་རྟོག་ཅིང་མྱོང་བ་མི་འཐད་པར་ཐལ།",
    "རང་དང་དུས་མཚུངས་པའི་རང་རྒྱུད་ཀྱི་རྟོག་པའི་རྣམ་པར་ཤེས་པ་གཞན་གྱིས་མྱོང་བ་མི་འཐད་པར་ཐལ།",
    "དེའི་ཚེ་གཟུགས་ཇི་ལྟར་འགྱུར་ཏེ་མི་འགྱུར་བར་ཐལ་གཟུགས་འཛིན་འདས་པ་མྱོང་བ་མེད་པའི་ཕྱིར་ཏེའཛིན་འདས་པ་འགགས་པའི་ཕྱིར།",
    "རང་ཡུལ་ལ་ཡོངས་སུ་གཅོད་པའི་ངོ་བོ་གཅིག་པ་སྟེ་ཚུལ་མཚུངས་པར་གྱུར་གྱི་མྱོང་མ་མྱོང་གི་ཁྱད་མི་འཐད་པར་ཐལ།",
    "གང་གི་ཕྱིར་ན་དེ་ལ་ནི་མངོན་སུམ་གྱིས་གྲུབ་པ་མ་ཡིན་ཞིང་རྟགས་ཅན་རྗེས་དཔག་གིས་གྲུབ་པ་མིན་པའི་ཕྱིར།",
    "ཁྱོད་ཀྱི་འདོད་པས་མངོན་སུམ་ནི་དེ་ལྟར་བའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་དང་།",
    "ཐལ་བ་ལས་སྔ་མ་དེ་རྣམས་མྱོང་བ་ཡང་ཡོད་པས་དེ་རྟོག་མེད་ཡིན་ནོ།",
    "སྤྱི་ཡན་གར་བ་རྟོགས་ཀྱི་འགའ་ཞིག་གི་ཚེ་ཡང་ཁྱད་པར་རང་མཚན་ཤེས་པ་གང་གིས་ཀྱང་གསལ་བར་རྟོགས་པར་མི་འགྱུར།",
    "རང་མཚན་གསལ་བར་མི་རྟོགས་པར་ཐལ།",
    "མངོན་སུམ་རྟོག་མེད་དུ་ཐལ།",
    "གལ་ཏེ་མིག་ཤེས་ཀྱི་གཟུང་བྱ་གཟུགས་ནི་རང་གི་བརྡ་དྲན་བའི་ཕྱིར་རོ།",
    "གཟུང་དོན་གཟུགས་ལས་བརྡ་དྲན་སྐྱེ་འགྱུར་བའམ་གཟུང་དོན་གཟུགས་ལས་དངོས་སུ་སྐྱེ་བ་མིན་པར་ཐལཨགཟུང་དོན་གཟུགས་ཉེ་བ་དེ་ལས་ཕྱིས་དུས་ཞིང་བརྡ་དྲན་ལས་ཁྱོད་སྐྱེ་བའི་ཕྱིར།",
    "གཟུགས་ཀྱི་བརྡ་དྲན་དང་མིག་ཤེས་གཉིས་བསྐྱེད་པར་འགྱུར་བའམ་ཕྱིས་ཀྱང་མིག་ཤེས་མི་བསྐྱེད་པར་ཐལ།",
    "བརྡའི་ཡུལ་དེ་སྒྲ་དང་བཅས་པར་མི་འཛིན་པར་ཐལ།",
    "གཟུང་དོན་ཁྱད་པར་ཉེ་བ་ལ་དངོས་སུ་ལྟོས་པར་མི་རུང་བར་ཐལ།",
    "ཐུན་མོང་མིན་པའི་རྒྱུ་ཡི་ཕྱིར།",
    "དང་པོ་རང་གི་ལུང་དང་འགལ་བའི་རྩོད་པ་སྤང་བ་ནི།",
    "སྐྱེ་མཆེད་ཀྱི་རང་གི་མཚན་ཉིད་དུ་འདོད་ཀྱི།",
    "རྫས་ཀྱི་རང་གི་མཚན་ཉིད་ཀྱི་ནི་མིན་ནོ་ཞེས་གསུངས་པས།",
    "ཚོགས་པ་དེ་དམིགས་པ་ཞེས་པ་འདི་ལ་རྡུལ་དུ་མ་བསགས་པ་དག་གི་སྒྲས་ནི་ཚོགས་པ་ཡིན་པར་བརྗོད་ལསྤྱི་ཡིན་ལ།",
    "རྟོག་པར་ཐལ།",
    "ཚ་རྡུལ་ཕྲན་གཅིག་སྟེ་སོ་སོ་རེ་རེ་བ་ལ་དམིགས་པར་ངེས་པ་མིན་པར་རྡུལ་ཕྲན་དུ་མ་ཚོགས་པའི་ཐུན་མོང་གི་འབྲས་བུ་ཡིན་པའི་ཕྱིར།",
    "གཉིས་པ་མུ་སྟེགས་བྱེ་བྲག་པའི་རྩོད་པ་སྤང་བ་ལ་བཞིའི་དང་པོ་ཏིལ་སོགས་ཅིག་ཅར་འཛིན་པ་མེད་པར་ཐལ་བ་ནི།",
    "གཉིས་པ་ཁྲ་བོ་ཅིག་ཅར་འཛིན་པ་མེད་པར་ཐལ་བ་ལ་གསུམ་གྱི་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "གཅིག་གི་རང་བཞིན་མིན་ཏེ།",
    "དེ་འདྲ་ཡོད་ན་དམིགས་སུ་རུང་བ་ལས་སྣ་ཚོགས་པ་ངོ་མཚར་དུ་གྱུར་པ་དེ་མ་མཐོང་ཚོགས་པ་མེད་པར་ཐལ།",
    "གཉིས་ཀ་ཡང་དུས་ཅིག་ཅར་དུ་དོན་གྱི་རྣམ་པ་ནི་སྣ་ཚོགས་སྣང་བར་ཅིའི་ཕྱིར་འདོད་དེ་མི་རིགས་པར་ཐལ།",
    "བློ་ལ་སྣང་བའི་སྔོ་སོགས་ཁ་དོག་སྣ་ཚོགས་མིན་པར་ཐལ།",
    "གལ་ཏེ་ཕྱེ་མ་ལེབ་ཁྲ་བོའི་ཡན་ལག་ཅན་དང་སྟན་དང་རི་མོའི་ཁྲ་བོའི་ཡན་ལག་རེ་རེ་བ་སོགས་ལ་གཉིས་ཀའི་ཡང་གཟུགས་སྣ་ཚོགས་དེ་ལྡན་པ་ལ་སྣ་ཚོགས་སུ་ཉེ་བར་འདོགས་པའི་རྒྱུའོ་ཞེ་ན།",
    "རི་མོ་སོགས་ཀྱི་ཁྲ་བོའི་ཡན་ལག་སྔོ་སོགས་རེ་རེ་བ་ལ་ཡང་ཡན་ལག་ཅན་སྣ་ཚོགས་མེད་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་རི་མོ་ལ་སོགས་པའི་ལྡན་པ་དེ་ནི་དོན་རྫས་ཡན་ལག་ཅན་གཅིག་ལ་ཡན་ལག་སྔོ་སོགས་རེ་རེ་བ་སྣ་ཚོགས་དང་འཕྲོད་པ་འདུ་བའི་ཕྱིར།",
    "དེ་ནི་སྔོ་སོགས་རེ་རེ་བ་དང་ཁྲ་བོའི་ཡན་ལག་ཅན་སྣ་ཚོགས་རྫས་གཅིག་ལ་འདུ་བ་མིན་པར་ཐལ།",
    "ཡན་ལག་སྔོ་སོགས་རེ་རེ་ལ་སྣ་ཚོགས་པའི་ཡན་ལག་ཅན་གཅིག་ཡོད་པ་མིན་པའི་ཕྱིར་རོའོན་ཏེ་དང་པོར་རི་མོའི་སྔོ་སོགས་ཡན་ལག་རྣམས་རིམ་བཞིན་དུ་མཐོང་བ་སྐྱེ་ཞིང་།",
    "སྔ་ཕྱིའི་དོན་དུ་མ་ཡིད་གཅིག་གིས་འཛིན་པའི་ཕྱིར་རོཅིག་ཅར་བློ་གཅིག་གིས་འཛིན་པ་ཐོབ་པར་ཐལ་ཁྱབ་པ་ནི་ཁས་བླངས།",
    "ཡུལ་དོན་དུ་མ་ཅིག་གསུམ་པ་སྐབས་དོན་ཉེ་བར་བསྡུས་ཏེ་བསྟན་པ་ན་རྒྱུརི་མོའི་སྔོ་སོགས་ལ་ཡན་ལག་ཅན་གྱི་སྣ་ཚོགས་གཅིག་སཅར་འཛིན་པ་ཅན་གྱི་བློ་གཅིག་གྲུབ་པར་འགྱུར་ཏེ་དེ་དོན་དུ་མས་བསྐྱེད་པའི་ཕྱིར་རང་མེད་པར་ཡང་སྣ་ཚོགས་སུ་ཡང་སྣང་བའི་བློ་ཅིག་ཅར་འཇུག་པ་དེའི་ཕྱིར།",
    "ཁྱབ་པ་ཡོད་རྟོག་གནས་པའི་སེར་པོ་རང་གི་མིང་དང་མ་འདྲེས་པ་དག་གསལ་བར་མཐོང་བའི་ཕྱིར་ཡང་ངོ་བསྲེས་ནས་མི་འཛིན་པ་དེའི་ཕྱིར་ཡང་མངོན་སུམ་དུ་རྟོག་མེད་དུ་གྲུབ་པོཔ་གཉིས་ཅིག་ཅར་མི་སྐྱེ་བས་སོགསུམ་པ་མ་ངེས་པ་སྤང་བ་ལ་གཉིས་ཀྱི་དང་པོར་ཐམས་ཅད་རང་བཞིན་མེད་པར་བསྟན་པ་ལ་གཉིས་གལ་ཏེ་སྣ་ཚོགས་གཅིག་པའི་རང་བཞིན་མིན་ཞེས་པའི་ཐལ་བ་མ་ཀྱི་དང་པོ་སྣང་བའི་རྣམ་པ་མི་བདེན་པ་ནིསྣ་ཚོགས་སུ་སྣང་བ་ཅན་གྱི་དོན་ཕྱེ་མ་ལེབ་ཁྲ་ལྟ་བུ་རྣམས་ལ་སྣ་ཚོགས་ཡིན་པས་གཅིག་ཉིད་དུ་མི་ངེས་ཏེ།",
    "མིན་པར་ཐལ།",
    "ཇི་ལྟར་སྣང་བའི་ཐལ་བ་ལས་གཅིག་ཉིད་དུ་འདོད་པས་མ་ངེས་པ་ཡིན་ནོ་ཞེ་ནཚོགས་སུ་སྣང་བའི་ཕྱིར།",
    "རྩ་བའི་ཐལ་བ་ལ་ཁྱབ་པ་ཡོད།",
    "དེ་དག་རེ་རེ་ལ་རགས་པ་མེད་ཅིང་ཚོགས་པ་ལ་རྫས་གཅིག་མེད་ཡང་བདེན་པར་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "བློ་གཅིག་ལ་དོན་དམ་པར་བློ་གཅིག་རྣམ་པ་གཉིས་སུ་འཁྲུལ་པ་ལ་སྣང་གིདོན་ཡོད་དམ་མེད་ཀྱང་རུང་།",
    "གལ་ཏེ་ཤེས་པ་རྣམས་ལ་རྣམ་པ་གཉིས་ཀྱི་དུ་མེད་པ་ཅན་དུ་གྲུབ་པའི་ཤེས་པ་གཅིག་གི་ངོ་བོ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལ་གཟུང་འཛིན་གྱི་རྣམ་པ་གཉིས་ཀ་ཉིད་དུའང་བདེན་པར་ཡོད་པ་ཉམས་པར་འགྱུར་བ་ཡིན་པར་ཐལ།",
    "གཟུང་འཛིན་དུ་འཁྲུལ་དེ་ལ་དེ་གཟུང་འཛིན་ནི་རི་བོང་གི་རྭ་བཞིན་གཏན་མེད་པས་ཀུན་བཏགསཕྱིར་རོ།",
    "སོ་སྐྱེས་ཀྱང་གཉིས་མེད་ཝུ་བཀ་ཀྱི་བློ་རང་རིག་གིས་རྟོགས་ཀྱང་འཁྲུལ་པའི་ས་བོན་དང་འབྲེལ་པས་མཐོང་བ་ལྟར་མ་ངེས་པའི་ཕྱིར་གཟུང་ཐཙ་ཙྪཱ་ཡང་མ་བཟུང་བ་དང་འདྲའོ་ཞེས་སོ།",
    "དེ་དག་གི་གཟུང་འཛིན་ཡུལ་ཡུལ་ཅན་ཐ་དད་ཡིན་པ་ཉིད་ཀྱང་བསླད་པ་སྟེ་འཁྲུལ་པ་ཡིན་ཏེ།",
    "དེ་དག་གི་མཚན་ཉིད་དོན་དམ་པར་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "གཟུང་བ་དང་འཛིན་པ་ཡི་རྣམ་པ་ཡུལ་ཡུལ་ཅན་དུ་བསྟན་པ་ལས་དེ་དག་གི་མཚན་ཉིད་གཞན་ནི་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དོན་དམ་པར་དེ་དག་གི་མཚན་ཉིད་རང་བཞིན་མེད་པ་དེས་ཀྱང་སྟེ་དེའི་ཕྱིར་རོ།",
    "སོ་སོའི་སྐྱེ་བོ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མ་རིག་པ།",
    "རབ་རིབ་ཅན་ལ་པའི་བག་ཆགས་གིས་བསླད་པའི་བདག་ཉིད་ཅན་ལའོ་གལ་ཏེ་ཕྱི་རོལ་དོན་ལ་མི་ལྟོས་ན་ཡུལ་དུས་ངེས་པ་སོགས་པ་བཞིན་དུ་ཕྱིན་ཅི་ལོག་གི་རྟོག་པའི་རྣམ་པའོ་རྐྱེན་གྱི་རང་གི་བདག་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་ཡོད་པ་ལ་ལྟོས་ནས་ངེས་པ་ཅན་དུ་ཅན་དུ་མི་སྐྱེ་བའམ་ཞེ་ན།",
    "རི་བོང་གི་རྭ་བཞིན་དུ་མེད་དོ།",
    "མི་མཚུངས་ཏེ་ཕྱིན་ཅི་ལོག་ཏུ་སྣང་བ་ཅན་གྱི་འཁྲུལ་པའི་ས་བོན་གྱི་བག་ཆགས་སད་གི་རྭ་མི་སྣང་བ་ཅི་ཞེ་ན།",
    "བཟློག་པ་འཛིན་པར་མ་བྱེད་ཅིག་ཅེས་ཕྱི་རོལ་དང་ནང་གི་སྐྱེ་མཆེད་རྣམས་ཀྱི་མཚན་ཉིད་རྣམ་པར་ཕྱེ་ནས་ཀ་པསྣང་བ་ཙམ་ལ་དགོངས་ནས་གཟུགས་ལ་རིལ་པོའི་བདག་འཛིན་བཟློག་དཔྱོད་པ་ལ་འཇུག་པར་མཛད་དེ།",
    "ཕྱི་རོལ་གྱི་གཟུགས་སྣ་ཚོགས་པར་མི་འདོད་པས་སྣ་ཚོགས་གཅིག་པའི་རང་བཞིན་ཅན་མིན་ཞེས་པའི་ཐལ་བ་དེ་མ་ངེས་པ་མིན་ཞེས་སྟོན་པ་ནི།",
    "ཤེས་པ་གཅིག་པོ་དེ་བཞིན་དུ་ཕྱི་རོལ་གྱི་རྫས་གཞན་ལ་བརྟེན་པ་མེད་པ་སྟེ་རྫས་གཞན་དུ་མར་མེད་དེཤེས་པ་གཅིག་གི་ཁྱད་པར་ཡིན་པས་དེའི་ཡན་ལག་སྔོ་སེར་སོགས་ཀྱི་སྣང་བ་ལས་ཡན་གར་བ་མཐོང་བར་ནུས་པ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཁྲ་བོར་སྣང་བའི་ཤེས་པའི་བདག་ཉིད་མིན་གྱི་རང་གི་ཆ་ལ་དོན་དུ་ཞེན་པའི་སྒོ་ནས་འཇུག་པར་འགྱུར་བའི་ཕྱིར།",
    "དབྱེ་བར་མི་ནུས་པའི་ཤེས་པ་གཅིག་གི་ངོ་བོར་འགྱུར་གྱི་ཕྱི་རོལ་གྱི་དོན་སྣ་ཚོགས་མིན་ཏེ།",
    "དེའི་ཕྱིར་ཕྱི་རོལ་སྣ་ཚོགས་སུ་རྣམ་པར་དབྱེ་ནུས་པ་དེ་ནི་གཅིག་གི་རང་བཞིན་མིན་ནོ་ཞེས་རྟགས་ཁྱད་པར་དང་བཅས་པ་ཡིན་པས་ན་མི་མཐུན་ཕྱོགས་ལ་མ་ཞུགས་པས་མ་ངེས་པ་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་ཕྱི་རོལ་གྱི་རས་སོགས་སྣ་ཚོགས་པ་དེ་ལ་ཡང་སྔོ་སོགས་གཅིག་བསྒྲིབས་པ་ན་གཞན་མ་བསྒྲིབས་པས་ཐ་དད་དུ་སྣང་བ་དེ་ཡང་ཡན་ལག་གི་གཟུགས་ཡིན་གྱི་ཡན་ལག་ཅན་མིན་ལ།",
    "ཅི་སྟེ་ཡན་ལག་གི་ངོ་བོ་དེ་དང་དེ་ཐ་དད་པར་འཛིན་གྱི་ཡན་ལག་ཅན་མི་འཛིན་པར་འདོད་པས་རང་རྒྱུད་དེ་མ་ངེས་སོ་ཞེ་ན།",
    "ལས་རྫས་གཞན་གཅིག་མེད་པར་ཐལགསལ་བྱེད་པ་དག་གལ་ཏེ་ཡན་ལག་ཅན་གཅིག་མེད་ན་གསུམ་པ་ཡན་ལག་ཅན་གཅིག་མེད་ཀྱང་སྣང་བ་ནརྡུལ་ཕྲན་སོ་སོ་བ་བཞིན་དུ་རྡུལ་དུ་མ་ཚོགས་ཀྱང་ཁྱད་མེད་པས་དོན་འགའ་ཞིག་ཀྱང་བློས་མཐོང་བར་མི་གལ་ཏེ་སོ་སོར་སྐྱེས་ཕུལ་བྱུང་ཞེས་པ་རྡུལ་སོ་སོ་ལ་ནུས་པ་མེད་ན་ཡང་ཕན་ཚུན་མངོན་དུ་འགྱུར་རོ་ཞེ་ན།",
    "ཁྱེད་ཀྱི་ལུགས་ལ་མཐོང་བ་ལ་འགལ་བ་དག་ནི་ཅི་ཞིག་ཡོད་ནས་གོང་གིས་ཡན་ལག་ཅན་རྟོག་པར་བྱེད།",
    "དམིགས་པའི་རྒྱུའི་དངོས་པོ་མ་རྒྱུ་ཡིན་ཡང་སྔར་མ་ཚོགས་པ་བཞིན་ཕྱིས་ཀྱང་ཡུལ་དུ་མི་འགྱུར་ཞེ་ནགཏོགས་པ་གཟུང་བ་ཞེས་བྱ་བ་གཞན་ཅི་ཡང་མེད་པས་རྒྱུ་དེ་ལ་བློ་ནི་དོན་གང་གི་རྣམ་པ་ཅན་དུ་སྣང་བའི་གཟུགས་དེ་ནི་བློ་དེ་ཡིས་གཟུང་བར་བརྗོད་དོ།",
    "གསུམ་པ་ནོག་སོགས་ཅིག་ཅར་འཛིན་པ་མེད་པར་ཐལ་བ་ནི།",
    "གལ་ཏེ་ཕན་ཚུན་སོགས་པའི་ཡན་ལག་རྣམས་མཐོང་བ་མེད་པར་ནི་བ་ལང་ཤེས་པས་མཐོང་བ་མེད་པས་སོབ་ལང་གི་ཡོན་ཏན་ཡན་ལག་དང་གཙོ།",
    "དེའི་ཡོན་ཏན་སྔོན་པོ་དང་ལ་སོགས་པས་རྣམ་བ་ཉིད་ཅེས་པའི་སྤྱི་དང་ལས་གཡོ་འགུལ་དང་ལྷན་ཅིག་ཅིག་ཅར་དུ་འཛིན་པ་མིན་པར་ཐལ།",
    "བ་ལང་གི་རྫས་དེ་ལྐོག་ཤལ་སོགས་ཡན་ལག་ཐམས་ཅད་དང་ལྡན་པ་རྫོགས་པར་མ་བཟུང་བར་ཐལ།",
    "བ་ལང་གི་ཡན་ལག་ཁྱད་པར་ཉིད་དུ་བརྗོད་འདོད་ཀྱིས་ཉེ་བར་གཟུང་བའི་རྭ་གང་ཡིན་པ་དེ་ཉིད་ཀྱིས་ནི་ཁྱད་པར་དུ་བྱས་པའི་ཁྱད་པར་ཅན་དུ་བ་ལང་དེ་ནི་འཛིན་པར་འགྱུར་གྱི་ཡན་ལག་ལྷག་མ་གཞན་མི་འཛིན་པའི་ཕྱིར་རོ།",
    "བཞི་པ་སྣ་ཚོགས་ཐ་དད་འཛིན་པ་མེད་པར་ཐལ་བ་ནི།",
    "དེ་དག་དུས་གཅིག་ཏུ་མཐོང་བ་ན་ཡང་སྐྱེས་བུའི་བློས་གཅིག་ཏུ་དམིགས་པར་འགྱུར་གྱི་ཐ་དད་དུ་མི་ཤེས་པར་ཐལ།",
    "དེ་དག་རང་རང་གི་རྫས་ཀྱི་དངོས་པོས་གཞན་དག་ལས་ཐ་དད་དུ་མེད་པའི་ཕྱིར་དང་།",
    "དུ་མ་ཅིག་ཅར་མི་འཛིན་ཞིང་བ་ལང་ཡང་རང་གི་ངོ་བོས་བ་ལང་མིན་ཞིང་།",
    "དེ་དག་ཐ་དད་དུ་མཐོང་བ་ན་དེ་དག་གི་འབྲེལ་པ་ཅན་གྱི་སྤྱི་སོགས་ངེས་པར་མཐོང་བའི་སྒོ་ནས་ཕན་ཚུན་ཐ་དད་པའི་རྫས་སུ་རྟོགས་པའི་ངེས་པ་འཆོལ་ནས་སྤྱི་སོགས་གཞན་གྱི་སྒོ་ནས་ཀྱང་དེ་དག་མིན་པའི་རྫས་གཞན་རྟོགས་པར་འགྱུར།",
    "དང་རྫས་སྒོ་ནས་གཞན་དུ་གཟུང་བྱ་ཡིན་ཞིང་རང་གི་སྤྱི་དང་དེ་ཅིག་ཅར་དུ་བློ་གཅིག་གིས་འཛིན་མི་སྲིད་དེ།",
    "དུ་མ་ཅིག་ཅར་འཛིན་པར་ཐལ་ལོ།",
    "བཀོད་པ་ཅན་བདེ་སོགས་གསུམ་འཛིན་པར་ཐལ།",
    "སོར་མོས་བཀོད་པའི་མཚན་ཉིད་ཅན་ཁུ་གསུམ་གྱིས་བཀོད་པ་སྟེ་ངོ་བོ་ཅན་གྱི་རྣམ་འགྱུར་སྒྲ་འཛིན་པའི་ཕྱིརཁྱབ་པ་ཡོད་བཀོད་པ་ཅན་ནི་མ་བཟུང་བར་བཀོད་པ་འཛིན་པར་ཚུར་འཛིན་པ་ན་སོར་མོ་འཛིན་པ་བཞིན་ནོ།",
    "ཐ་དད་པའི་དོན་ཏེ་ཡུལ་ཅན་དེ་གང་ལས་ཡིན་ཏེ་༩༢མིན་པར་ཡུལ་གཅིག་སྣ་ཚོགས་སུ་སྣང་བར་ཐལ།",
    "ཅི་སྟེ་བ་ལང་གི་སྒྲ་ཤེས་འདིའི་རྗེས་སུ་འགྲོ་བས་སྤྱི་དངོས་པོར་གྱུར་པ་རྗེས་སུ་འགྲོ་བ་ཡིན་ནོ་ཞེ་ན།",
    "རང་གི་རིག་བྱ་བསྟན་མིན་པ།",
    "རྣ་བ་མ་ཕུག་པ་ན་རེ།",
    "མར་ཇི་ལྟར་འདོད་དེ་འདོད་པར་མི་རིགས་པར་ཐལ།",
    "དེ་འབའ་ཞིག་ལ་ནུས་པ་མེད་པས་རྐྱེན་རེས་འགའ་བ་ལ་ལྟོས་ནས་དེ་གཉིས་རིམ་བཞིན་དུ་འབྱུང་ཞེ་ན།",
    "ལྷན་ཅིག་བྱེད་རྐྱེན་དེ་ལ་ལྟོས་ནས་རང་འཛིན་རིམ་ཅན་དུ་བསྐྱེད་པ་འགལ་བར་ཐལ།",
    "འབྲས་བུ་སྐྱེད་བྱེད་མིན་པར་ཐལ།",
    "འབྲས་བུ་བསྐྱེད་པ་མིན་པར་ཐལ།",
    "ཇི་ལྟར་ཙཡིད་ཀྱིས་འཛིན་ཏེ་མི་འཛིན་པར་ཐལ།",
    "ཡུལ་ཅན་ཡིད་གབྷཎ་ཤེས་ལ་རང་གི་རྣམ་པར་འཇོག་པར་ནུས་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་འབྲས་བུ་ཤེས་པ་རྣམས་ཀྱི་རྒྱུ་དུ་མ་ཉིད་ཡོད་ན་ཡང་འཇིག་རྟེན་ན་འབྲས་བུ་ཤེས་པ་དེ་རྒྱུ་གང་གི་རྣམ་པའི་རྗེས་སུ་བྱེད་པར་སྐྱེ་བ་གང་ཡིན་དེ་ནི་རྒྱུ་དེ་ཡིས་ངོ་བོ་སྟེ་རྣམ་པ་དེ་གཞག་པ་ཡིན་ཏེ།",
    "རྒྱུ་དེས་རང་གི་རྣམ་པ་འཇོག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་བདེ་༩སོགས་བེམ་པོ་འདོད་པ་དགག་པ་ལ་གཉིས་ཀྱི་དང་པོ་ནང་གི་བེམ་པོར་འདོད་པ་དགག་པ་ལ་གཉིས་ཀྱི་དང་པོ་འདོད་པ་བརྗོད་པ་ནི།",
    "རང་གི་ངོ་བོ་ཇི་ལྟར་རིག་ཏེ་མི་རིག་གོ།",
    "བདག་གི་ཡོན་ཏན་དུ་གྱུར་པའི་ནང་གི་བེམ་པོ་ཡིན་པས་སོ།",
    "དོན་གཟུགས་སོགས་དེ་བོར་ནས་ནི་བདག་ལ་འདུ་བའི་བདེ་སོགས་ཉིད་དེས་ནི་ཇི་ལྟར་རྟོགས་པར་འགྱུར་ཏེ་འགྱུར་བ་མིན་པར་ཐལ།",
    "རང་ཡུལ་བར་རྣམ་པར་ཆད་པ་མེད་པར་སྣང་བར་མི་འགྱུར་བར་གཟུགས་མཐོང་བ་བོར་ཆད་དང་བཅས་པ་དང་བདེ་སོགས་བར་མ་ཆོད་དུ་སྣང་བར་ཐལ།",
    "སྔ་ཕྱིའི་གཟུགས་བར་མ་ཆད་དུ་འཛིན་པར་ཞེན་པ་ཅིས་མ་ཡིན་ཏེ་ཡིན་པར་ཐལ།"
  ]
}