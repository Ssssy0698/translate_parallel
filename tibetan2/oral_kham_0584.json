    "རྒྱུ་རྣམས་རང་རང་ངོ་བོས་འགག།",
    "ཕུ་འགྲོ་མདའ་འདུག་ཁ་ཐབས་བྱ་བ།",
    "དེའང་དབུས་སུ་རི་རབ་ལྷུན་པོ་བང་རིམ་བཞི་དང་ལྡན་ལ་གྲུ་བཞིར་འདུག་པ།",
    "བསྡུས་པ་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ་ལྟ་བུ་རྣལ་འབྱོར་རྒྱུད་རྒྱས་པ་དཔལ་རྩེ་དབྱིངས་གསུམ།",
    "གནང་བ་དེའང་རྡོ་རྗེ་འཆང་ནས་བར་མ་ཆད་དུ་བྱིན་པ་ཞིག་དགོས་ཀྱི་རྡོ་རྗེ་སློབ་དཔོན་གྱི་གོ་འཕང་བརྙེས་པ་ཡིན་ཀྱང་རང་བཟོས་སྦྱིན་དུ་མི་རུང་ལ།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་སྟེ།",
    "སྤྱི་མཐུན་དུ་ལས་སྣང་མ་ཟད་ཀྱང་རང་ངོ་ལ་ཟད་པར་སྣང་བ་མི་འགལ་བ་བཞིན་དང་།",
    "དེས་ན་ཡུལ་གང་ཡང་རང་བཞིན་ཤེས་པས་ལོངས་སྤྱད་ཐབས་ཤེས་ཀྱིས་ཟིན་ན་གྲོལ་བའི་རྒྱུར་འགྱུར་ལ།",
    "མུར་འདུག་རྗེས་སུ་འབྲང་བའི་རྟོག་གེ་པ།",
    "གླལ་དང་འཁྲིག་དུས་སྐད་ཅིག་ཙམ།",
    "འདབ་བརྒྱད་ལ་ཕྱོགས་སྐྱོང་རང་གཟུགས་གསལ།",
    "ཟིན་བྲིས་གསུང་རྒྱུན་རྣམས་རང་གཞན་ལ་མཁོ་ཆེ་བས་བརྗེད་ཐོ་བཅས་བཞག་ཡོད་ཀྱང་ཁོམས་སྐབས་མི་འདུག་པས་དེ་སྔ་ནི་མ་གྲུབ་པ་བཞེད་སྐོང་ཐུབ་བ་ཅི་ནས་སྨོན་པ་ལགས། ལགས།",
    "གནས་བརྟན་ཕྱག་མཆོད་སྤྱན་འདྲེན་ཡོད་ཀྱང་བརྟན་བཞུགས་སོགས་ལ་རྟོག་དཔྱོད་བྱེད་མཁན་མི་འདུག་པ་རྟེན་ཡོད་ན་བརྟན་བཞུགས།",
    "མ་ཕན་ན་འདོན་འབུག་ཙམ་ཨི་ཐོན་བལྟ་བ་ལས་མ་མཆིས་ཕྱིར་དེ་དོན་གསུང་གསལ་དྲིས་འདུག་པར། ལགས།",
    "ད་ལྟ་སྤྲོས་མེད་ཁོ་ན་ལ་དྲིལ་ནུས་མཁན་དང་དེས་གོ་ཆོད་པའང་དཀོན་འདུག་པས་ན།",
    "འདི་ཁུང་ཐུབ་ཡིན་འདུག་ཀྱང་།",
    "ཀ་པ་ལ་པོད་གཉིས་ཡོད་པའི་སྔོན་མ་དེ་ཡིན་འདུག་རྟེན་བཅས་ཡང་ཁྲོད་རྒན་བུས་ཕུལ། མ་ཧཱ་གུ་རུ་ཐོད་ཕྲེང་རྩལ་ལ་འདུད།",
    "རྗེས་བསྡུ་རྟེན་བཞུགས་སོགས་ཀྱི་སྐབས་ཇི་ལྟར་ལགས། ཀཾ་ཚང་རང་ལུགས་ཀྱི་མ་མགོན་ཐད།",
    "བ་གཡུང་སྟོན་པ་གསར་རྙིང་གཉིས་ཀ་ལ་གསན་རྒྱ་ཤིན་ཏུ་ཆེ་བ་ཡིན་འདུག་ཅིང་།",
    "བེར་ཅན་དང་རང་བྱུང་མའི་འཁོར་རྣམས་ཀྱང་བསྲེས་ནས་འཁོར་ལོ་བཞི་རིམ་དུ་གྲགས་པའི་ཆོ་ག་འདི་ཐོག་མར་བཀོད།",
    "རང་ཧེ་རུ་ཀར་བསྐྱེད་ཟིན་པ་དེ་སྐྱབས་སེམས་ཀྱི་སྐབས་ཇི་ལྟར་བྱ་དགོས། དེ་སྐབས་ཧེ་རུ་ཀའི་ང་རྒྱལ་འཛིན་པ་ཙམ་ལས་སྐྱབས་སེམས་སྐབས་ཐ་མལ་པ་ལགས། ཡང་བགེགས་གཏོར་གོང་རང་ལས་ཀྱི་ཧེ་རུ་ཀར་བསྐྱེད་པ་དེ་མཚམས་གཅོད་གྲུབ་ནས་ལྷ་བསྐྱེད་པར་ཇི་ལྟར་བྱ། མཚམས་ལྷའི་ང་རྒྱལ་འཛིན་བཞིན་པ་ལས་བསྡུ་མི་དགོས། བདག་མདུན་སོ་སོར་ཡོད་རིགས་ལ་དྲང་བསྟིམ་ཕྱག་མཆོད།",
    "ཐུན་གཉིས་པ་དང་གསུམ་པའི་སྐབས་དེར་མ་བདེ་བ་ཞིག་འདུག་པ།",
    "འཁོར་ལོ་ཞེས་ལྔར་བཞེད་པ་དེ་གཉིས་ཀ་ལ་ངོས་འཛིན་དགོས་མིན། བདེ་མཆོག་བསྙེན་ལུགས་ཟིན་བྲིས་ཆགས་མེད་ཀྱིས་མཛད་པ་དེ་སྙན་བརྒྱུད་སོགས་ལུགས་སྲོལ་མང་པོ་ནས་སྤྲོ་བསྡུ་སྣ་ཚོགས་བྱས་པ་ཡིན་འདུག་པས་འདི་ནས་ཁྲིད་སྲོལ་མེད།",
    "ཡང་ཀུན་རིག་མི་འཁྲུགས་གཉིས་ཀྱི་ལྷོ་སྒོའི་དུས་བདག་བསྐྱེད་མདུན་བུམ་སྐབས་མ་བསྡུས་པར་རྗེས་ཆོག་དུས་རྒྱ་གསུམ་སོགས་བཀྲོལ་ནས་བསྡུས་པ་ལྟར་སྣང་ན།",
    "ཆགས་མེད་ཞབས་ཀྱིས་ཨ་ཏི་ཡོ་གའི་ཡང་ཏི་ལུགས་ཡིན་གསུང་འདུག་ཆོག་ཁྲིགས་རིགས་སྤྱི་དང་།",
    "ཀུན་མཁྱེན་དྷརྨ་ཀ་རས་ཟུར་མང་ལུགས་གསན་ནས་དཔལ་སྤུངས་སུ་སྒྲུབ་མཆོད་ཉིན་གསུམ་ཙམ་མཛད་སྲོལ་འདུག་ཀྱང་ཆ་ལག་གང་ཡང་མེད་པར་མ་ཟད།",
    "ཚོགས་མཆོད་དབུར་ཟིན་པ་དང་རང་ཉིད་གཙོ་བོའི་ཐུགས་ཀ་ནས་ལས་ཀྱི་ལྷ་རྡོ་རྗེ་སེམས་དཔའ་ཞིག་མདུན་དུ་འཕྲོས་པ་དེས་བྱ་བ་རྣམས་མཛད་པ་དང་།",
    "མགོར་འདོན་འདུག་པས་སྔར་ནས་རྡོར་སེམས་ཟུར་དུ་བྱེ་བ་དེ་ལ་དམིགས་པ་གཏད་དགོས་པ་ཡིན་འདྲ།",
    "དཀྱིལ་འཁོར་རྡུལ་ཚོན་ཡིན་ཀྱང་ས་ཆོག་ཆགས་མེད་ལུགས་ཀུན་རིག་ལྟར་བྱ་འདུག་པས་དེ་ག་རུང་ངམ།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧ་རི་ནི་ས་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ཅི་མཛད་ཁྱེད་རང་མཁྱེན།",
    "གཅིག་པུར་འདུག་དུས་བཙུན་ཚུགས་བཟུང་བ་མཆོག།",
    "དུས་མིན་འགྲོ་དོན་གཉིས་མེད་སེང་གེར་འགྲོ།",
    "ཕྱོགས་རིས་མེད་ཀྱང་རང་རྐང་བཟུང་ན་འཚེང་།",
    "འདུག་ཚུལ་འདི་བཞི་སེམས་ལ་སྐོར་རྫོགས་བྱ།",
    "སེམས་རྒྱུད་ཐུལ་ན་འདུག་ས་གར་ཡང་འདྲ།",
    "ཟབ་ཀྱང་ཡིད་ཡུལ་འདུག་པའི་གོ་བ་བསལ།",
    "ལུགས་རྟོགས་ཐབས་མི་འདུག་པས།",
    "མ་ཐོས་སྤང་བླང་ཤེས་ཐབས་མི་འདུག་པས།",
    "མ་མཐོང་ངེས་པར་འབྱུང་ཐབས་མི་གདའ་བས།",
    "མ་ཤེས་བརྩོན་འགྲུས་རྩོམ་ཐབས་མི་འདུག་པས།",
    "མ་མཇལ་ཡིད་ཆེས་སྐྱེ་ཐབས་མི་འདུག་པས།",
    "མ་སྤངས་བདེ་སར་ཕྱིན་ཐབས་མི་འདུག་པས།",
    "མ་སྤངས་བརྟན་པ་ཐོབ་ཐབས་མི་གདའ་བས།",
    "མ་ཞུགས་རང་ངོ་འཕྲོད་ཐབས་མི་གདའ་བས།",
    "མ་བསྟེན་ཡོན་ཏན་སྐྱེ་ཐབས་མི་གདའ་བས།",
    "གཅིག་ཡོང་ཙ་ན་གཅིག་མ་འཛོམ།",
    "ཅིག་གདའ་སྟེ།",
    "ཙནྡན་སོལ་བར་བསྒྱུར་བའི་བློ་ཆུང་རང་མང་ངོ།",
    "རང་ངོ་ཤེས་ན་ཅིར་སྣང་རང་གྲོལ་ཡིན།",
    "ཁོ་རང་རང་གྲོལ་དུ་འགྲོ་བ་ཡིན།",
    "མ་བཅོས་པ་ཟེར་ཙ་ན་ཡིད་བྱེད་ཐམས་ཅད་དང་བྲལ་དགོས་པ་ཡིན།",
    "ལྷན་སྐྱེས་རང་ཞལ་ལྟ་ལ་ཐེ་ཚོམ་འདྲ་མི་འདུག།",
    "མགོ་ལ་སྐྲ་དཀར་ཟུག་ཀྱང་འདུག་ཆས་སྒྲུབ།",
