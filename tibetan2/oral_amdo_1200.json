    "སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་དང་།",
    "དེ་དག་གི་ལུས་སུ་ནུབ་པར་བྱེད་དོ།",
    "འཇིག་རྟེན་ལན་བཅུར་བསྐོར་ངན་སོང་ཞི་ཞིང་བདུད་ཟིལ་གྱིས་མནན་ནས་བྱང་སེམས་དེའི་སྤྱི་བོར་ནུབ་ལ་འཁོར་གྱི་འོད་ཟེར་རྣམས་ནི་འཁོར་རྣམས་ཀྱི་སྤྱི་བོར་ནུབ་བོ།",
    "ཕྱོགས་བཅུའི་ཕྱོགས་རེ་རེའི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དག་ཏུ་མཆིས་པ་དང་།",
    "ལམ་ལ་འགོད་པའི་དང་པོར་འགྲོ་བ་བཟང་པོ་ལྷ་མི་དང་བཟང་པོ་མ་ཡིན་པར་ངན་འགྲོའི་མངོན་ཞེན་ཉོན་མོངས་ཞི་བ་ཞེས་ཚིག་སྦྱར་རོ།",
    "ཉན་རང་དང་ཐུན་མོང་མ་ཡིན་པ་ནི་མཚན་མེད་ཀྱི་དབྱིངས་སུ་ཡང་ཞུགས་པ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་བསྐུལ་བའི་མཐུས་ཡང་དག་མཐའ་མངོན་དུ་མི་བྱེད་པའོ།",
    "དང་པོའི་གཉིས་ནི་དེ་ལྟ་བུའི་རིམ་པ་ཞེས་པ་ནི་བཅུ་པ་ཐོབ་མ་ཐག་པ་ལ་བཀོད་རྗེས་སུ་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་ལ་བཀོད་པ་བཞིན་དུ་དེ་ལ་བཀོད་རྗེས་སུ་སྲིད་པ་ཐ་མ་ལ་འགོད་པའོ།",
    "ཁྱད་པར་གྱི་ལམ་ནི་ཚེ་གཅིག་གིས་ཐོགས་པ་ལས་ཁྱད་པར་དུ་ཞུགས་པ་དང་།",
    "བསྐལ་པ་མང་པོ་གཅིག་ཏུ་དཀའ་བ་བྱས་ནས་རང་གི་ཡེ་ཤེས་རྒྱུན་གཅོད་པ་ནི་མ་ཡིན་ནོ།",
    "གསུམ་པའི་གཉིས་པ་ནི་ཕྱིན་ཅི་ལོག་ནི་བདེན་གཉིས་ལོག་པར་རྟོགས་པ་སྟེ་དེ་བདེན་པ་ཐ་དད་དུ་མི་འཛིན་པའི་མཐུས་སྤོང་བས་འདི་སྔ་མའི་འབྲས་བུ་དང་ཕྱིན་ལོག་སྤོང་བ་དེ་ཡང་རྫས་ཡོད་བོར་བ་ནི་མ་ཡིན་གྱི་གཟོད་མ་ནས་དངོས་པོ་ཕྱིན་ལོག་ཕྲ་བ་ཡང་མེད་པས་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ཇི་ལྟར་གནས་པ་བཞིན་མཁྱེན་པ་ཙམ་མོ།",
    "དྲི་མ་ཐམས་ཅད་དང་བྲལ་བའི་རྣམ་བྱང་གི་རྒྱུ་ཚོགས་སོ་ཞེས་ཚིག་གསལ་ལས་སོ།",
    "དངོས་པོ་དྲུག་གིས་ཡང་དག་བཤད།",
    "འོན་ཀྱང་འགྱུར་འདི་མི་ལེགས་པས་རྒྱན་སྣང་གི་འགྱུར་ལྟར་རྒྱུ་དང་སྦྱོར་བ་གཞི་མཐུན་དུ་མཛད་པ་ལྟར་རིགས་སོ།",
    "མངོན་རྟོགས་རང་རང་གི་མཚན་ཉིད་དང་དྲུག་ཏུ་བཞག་པ་དེ་དག་གི་གོ་རིམ་ངེས་པ་དང་གསུམ་དུ་བཞག་པ་གྲངས་ངེས་དང་ཟློས་པའི་སྐྱོན་སྤོང་གཙོ་བོར་བྱས་ནས་བསྟན་པའོ་ཞེས་གསུངས་པར་བྱང་ཡེ་འཆད་དེ་བསྟན་བཅོས་ཀྱི་དགོངས་པ་མཐར་ཐུག་པའོ།",
    "དེས་ན་དངོས་པོ་སོ་སོའི་མཚན་ཉིད་ངེས་པར་འབྱེད་པ་ན་ཚིགས་ལྷུར་ལེན་དགོས་ལ་དེ་དག་གི་གོ་རིམ་ངེས་པ་གཙོ་བོར་བྱེད་པ་ན་ཚིག་དེ་ཙམ་དུ་མི་རྒྱས་པ་དང་ཡུལ་དང་རྒྱུ་འབྲས་གསུམ་དུ་བསྡུས་ནས་གྲངས་ངེས་དང་ཟློས་སྤོང་གཙོ་བོར་བྱེད་པ་ན་ཚིག་བསྡུས་པ་ཙམ་ཡོད་པ་སྟེ།",
    "དང་པོ་ནི་གལ་ཏེ་ཁྱོད་ཀྱིས་རྒྱན་འདི་ཡུམ་གསུམ་པོ་ཀུན་གྱི་རྒྱན་དུ་དབྱེ་ཞེས་པ་མ་གྲུབ་སྟེ།",
    "འདིས་ནི་ཡུམ་རྒྱས་འབྲིང་བསྡུས་གསུམ་དུ་འཇོག་པ་བརྗོད་བྱའི་དོན་གྱིས་མི་འཇོག་གི་རྗོད་བྱེད་ཀྱི་ཚིག་གིས་འཇོག་པར་བསྟན་ཏོ།",
    "ཡུམ་གསུམ་དོན་ལ་ཁྱད་པར་མེད་ཅིང་ཚིག་གིས་ཕྱེ་བ་དེ་ལྟ་མ་ཡིན་ན་ཡུམ་ཐམས་ཅད་ཀྱི་བརྗོད་།",
    "ཕྱོགས་གླང་གིས།",
    "ཡུམ་གསུམ་ལ་དོ་ན་ཁྱད་མེད་ན་ཟློས་པར་ཐལ་ཞེ་ན།",
    "ཡུམ་གསུམ་དེ་ལ་ཚིག་བསྡུས་པ་དང་སོགས་པས་རྒྱས་འབྲིང་གི་དབྱེ་བ་ཡོད་པས་ཁྱད་པར་ཡོད་དོ།",
    "འདི་དག་གིས་ནི་ཡུམ་གསུམ་ལ་དོན་ཁྱད་མེད་པར་འགྲུབ་ལ།",
    "དེ་གྲུབ་པ་ན་བསྟན་བཅོས་ཡུམ་ཀུན་གྱི་རྒྱན་དུ་གྲུབ་སྟེ་འབྲིང་གི་རྒྱན་དུ་གྲུབ་པར་མཐུན་ལ་དེ་དང་གཞན་གཉིས་དོན་ཁྱད་མེད་པས་སོ།",
    "བསྟན་བཅོས་རྒྱན་གྱི་དོན་ཀུན་ནི་བདག་གིས་གང་རྟོགས་པ་ཞིག་ཡིན་ཏེ་ཇི་བཞིན་མི་རྟོགས་ཏེ་བསྟན་བཅོས་ཀྱི་དོན་ཀུན་བདག་གི་བློ་ལས་ཕྱི་རོལ་ལྐོག་ཏུ་གྱུར་པའི་ཕྱིར་ཏེ་དོན་དེ་ལ་ཤེས་རབ་མི་གསལ་བ་སྤྱིའི་ཚུལ་གྱིས་འཇུག་པས་སོ།",
    "དེས་ན་འཕགས་ཆེན་གྱི་སྤྱོད་ཡུལ་གྱི་བསྟན་བཅོས་ཀྱི་དོན་དེ་ནི་ཚུར་མཐོང་བདག་གི་ཡུལ་གང་ན་ཡིན་ཏེ་མ་ཡིན་ནོ།",
    "སྤྱོད་ཡུལ་མ་ཡིན་པ་འོན་ཀྱང་སྤྱོད་ཡུལ་མ་ཡིན་པའི་བསྟན་བཅོས་ཀྱི་དོན་ལ་འགྲེལ་པ་རྩོམ་པའི་འབད་པ་བགྱིས་པའི་ནོངས་པ་ལ་མཁས་པར་བློ་སྦྱངས་པའི་སྐྱེ་བོ་རྣམས་ཀྱིས་བཟོད་པར་མཛོད་ཅིག་སྟེ་རང་གི་རྟོགས་པ་མི་བརྗེད་པའི་དོན་དང་གཞན་ཡུམ་ཟབ་མོ་ལ་ཞུགས་ན་ཅི་མི་རུང་སྙམ་ནས་དེའི་བློ་འཕེལ་བའི་དོན་གྱི་ངོ་བོར་བརྩམས་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཕྱིས་དུས་ཡུན་རིང་མོ་ཞིག་ནས་ཇི་ལྟ་བ་བཞིན་མཐོང་ཞིང་མཐོང་བ་ལྟར་གཞན་ལ་བསྟན་པས་ཡུམ་ཟབ་མོ་འདིའི་བསྟན་པ་ཕྱོགས་ཐམས་ཅད་དུ་རྒྱས་པར་བྱས་པ་ཡིན་ནོ།",
    "རིགས་པའི་གནས་མཐའ་དག་ལ་ཐོགས་པ་མེད་པའི་མཁྱེན་པ་རྒྱས་པས་མཁས་པ་རྣམས་གྱི་གཙུག་གི་ནོར་བུར་གྱུར་ཅིང་།",
    "འབུམ་ཕྲག་གཞུང་གི་རི་གླིང་གསལ་བའི་ཉིན་བྱེད་གཅིག།",
    "དེ་ཕྱིར་འདི་ལ་ནོངས་པ་མེད་སེམས་མོད།",
    "གཟིགས་པ་སྒྲིབ་མེད་རྣམས་ཀྱི་མཁྱེན་པ་ལ།",
    "རང་གི་འདོད་པས་རང་དགར་བྱེད་པ་བརྫུན།",
