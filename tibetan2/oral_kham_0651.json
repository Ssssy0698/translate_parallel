    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་བཅོམ་ལྡན་འདས་མ་ཡིད་བཞིན་འཁོར་ལོའི་སྐུ་གསུང་ཐུགས་དབྱེར་མེད་པར་གྱུར་ཅིང་ཡེ་ཤེས་པ་ཕེབ་བྱུང་སྙམ་པའི་ངང་ནས་སེམས་མ་བཅོས་པ་ལྷོད་གློད་ལ།",
    "དེས་ཁྱེད་རང་རྣམས་ཀྱིས་ལུས་ཀྱི་སྒོ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྒོ་ནས་ཞུགས།",
    "མདུན་བསྐྱེད་ལས་མར་མེ་གཅིག་ལས་གཉིས་མཆེད་ཀྱི་ཚུལ་དུ་རྗེ་བཙུན་མ་ཡིད་བཞིན་འཁོར་ལོའི་སྐུ་གསལ་ལ་རྫོགས་པ་བྱོན་ནས་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "དེས་ཁྱེད་རང་རྣམས་ཀྱིས་ཡིད་ཀྱི་སྒོ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་དག།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བ་ལ་རྒྱན་ཆ་གཏད་པས་དངོས་སུ་རྒྱན་ཆའི་རྣམ་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་ལྔར་ཐིམ།",
    "དེས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་ཆ་མཉམ་གྱི་སྡིག་སྒྲིབ་དག།",
    "ཁྱེད་རང་རྣམས་རྗེ་བཙུན་སྒྲོལ་མ་གནས་གསུམ་ཡིག་འབྲུ་གསུམ་དང་བཅས་པ་གསལ་ཐོབ།",
    "འདུག་སྟངས་ཆས་གོས་བསམ་པ་སོགས་སྤྱི་ལྟར་ཤེས་པར་བྱའོ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི།",
    "འདུག་སྟངས་ཆས་གོས་སོགས་བསྒྱུར།",
    "གཞན་ཡང་རང་གང་དུ་འགྲོ་བའི་ནམ་མཁར་སྒྲོལ་མ་སྐྱབས་སྦྱིན་མཛད་པའི་ཕྱག་འོག་ནས་འགྲོ་བར་བསམ་ལ་ཡིག་བཅུ་ཤམ་ཅན་བཟླ།",
    "དམིགས་གསལ་ཚེ་སྤེལ་བར་འདོད་ན་རྒྱས་པའི་སྦྱིན་སྲེག་དུས་སྐབས་དེ་ཉིད་དམ་གཞན་ཏུའང་རུང་འབུམ་ཕྲག་ལ་སོགས་པའི་གྲངས་ཇི་ཙམ་མང་བ་ལེགས་པས་དེ་བཞིན་དང་།",
    "འཇིགས་པ་བཅུ་དྲུག་དུས་མིན་འཆི་བའི་རྐྱེན།",
    "མཐར་ཐུག་དུས་གསུམ་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་ཡུམ་གྱུར་འཕགས་མ་སྒྲོལ་མའི་གོ་འཕང་དུས་མྱུར་བ་ཉིད་ཏུ་བདེ་བླག་ཏུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་རྗེ་བཙུན་མ་ཡིད་བཞིན་འཁོར་ལོའི་བསྐྱེད་རྫོགས་ལ་འཇུག་ཅིང་བརྩོན་པ་ཆེན་པོས་མཐར་དབྱུང་སྟེ།",
    "པཎ་ཆེན་བྱམས་གླིང་པའི་ཕྱོགས་ནས་བརྒྱུད་པའི་འཕྲོས་འདུག་གསུངས།",
    "ཇོ་ནང་ཁྲིད་བརྒྱ་ལྟར་ཚར་གཅིག་གསན་ནས་ཉམས་བཞེས་ཟླ་བ་དྲུག་མཛད་འདུག་ཅིང་།",
    "རྣལ་འབྱོར་བློ་གྲོས་ཆེ་ལ་སྐྱེ་གཟུགས་བཟང་བ་ཞིག་འདུག་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཀྱི་ངོ་བོ་ཧཱུྃཡིག་དམར་པོ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཁྱེད་རང་རྒྱལ་བ་ཚེ་དཔག་མེད་དུ་གསལ་བའི་སྤྱི་བོའི་རིགས་བདག་འོད་དུ་ཞུ་ནས་ཐིམ་པས།",
    "རང་རང་སོ་སོའི་བླ་ཚེ་ཡར་བ་ཉམས་པ་འཕྲོག་པ་བརྐུས་པ་ལ་སོགས་པའི་ཆ་ཤས་ཐམས་ཅད་དང་།",
    "ཁྱེད་རང་རྣམ་པའི་སྤྱི་བོ་ནས་ཞུགས།",
    "ད་ལྟ་ཉིད་དུ་འདུག་ས་འདི་ཉིད་དུ་མི་ཟད་ཚེ་ཡི་དངོས་གྲུབ་སྩལ་དུ་གསོལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "འདིའི་སྒོ་ནས་ཀྱང་རང་དང་གཞན་གྱི་དོན་རྒྱ་ཆེན་པོ་བསྒྲུབ་པར་ཞུ།",
    "མདུན་བསྐྱེད་རང་ལ་བསྟིམ་ཞིང་རང་ཡན་ལག་བཞི་རྫོགས་ཀྱི་ལྷར་གསལ་བས་རྣལ་འབྱོར།",
    "ཉལ་ལྡང་ཁ་ཟས་འགྲོ་འདུག་ལ་སོགས་པ་ལམ་དུ་འགྱུར་བའི་ཐབས་ཀྱི་རྣལ་འབྱོར་བསྐྱེད་རིམ་སྤྱིའི་རིགས་པས་འཕྲུལ་ཤེས་པར་བྱའོ།",
    "དེའང་རང་ལུས་ལྷ་སྐུ་སྣང་སྟོང་སྒྱུ་མ་དང་།",
    "གཉིས་སྣང་རང་གྲོལ་གྱི་ཉམས་མྱོང་ལ་བརྟན་པ་ཐོབ་པའི་རྟོགས་པ་དང་འབྲེལ་བའི་ལྟ་བས་བསྐྱེད་རྫོགས་ཀྱི་རྣལ་འབྱོར་ཐམས་ཅད་ལ་རྒྱས་ཐེབ་པར་བྱ་བ་ནི།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་པ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "འདི་ནི་སྐལ་ལྡན་རྒྱལ་པོ་ཛལ་བསྟན་པའི་ཐོག་མར་བབས་པའི་རྡོ་རྗེ་སེམས་དཔའི་མཛོད་ཆེན་པོའི་དགོངས་དོན་གྲུབ་པའི་སློབ་དཔོན་ཀུ་ཀུ་རཱ་ཙ་ནས་རིམ་པར་བརྒྱུད་དེ།",
    "ཁྱེད་རང་བསྒྱུར་ཏེ་ལྷ་གང་ཡིན་པ་དེར་བསྐྱེད་ལ་གནས་གསུམ་བྱིན་གྱིས་བརླབས།",
    "བཛྲ་མུགཏོར་མའི་མགྲོན་རྣམས་རང་རང་གནས་སུ་གཤེགས།",
    "དེའི་སྟེང་དུ་འདུག་པ་དང་།",
    "གནོད་བྱེད་ཀྱི་གདུག་རྩུབ་ཐམས་ཅད་ཞི་ནས་གུས་ཤིང་འདུད་པ་དང་རང་ཉིད་མཐུ་སྟོབས་རབ་ཏུ་རྒྱས་ཤིང་ཡོན་ཏན་ཕྲིན་ལས་མཐའ་དག་འགྲུབ་པར་གྱུར།",
    "གཏོར་མའི་མགྲོན་རྣམས་རང་རང་གནས་སུ་གཤེགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མདུན་དུ་བཤམས་པའི་མདུན་བསྐྱེད་ཀྱི་དམིགས་རྟེན་མཎྜལ་དབུས་ཀྱི་ཚོམ་བུའམ།",
    "དེ་ལྟར་གསོལ་བ་བཏབ་པས་སློབ་དཔོན་མདུན་བསྐྱེད་ཁྱེད་རང་དང་བཅས་པའི་ཐུགས་ཀ་ནས་འོད་འཕྲོས།",
    "དེས་ཁྱེད་རང་རྣམས་ཀྱིས་ལུས་ཀྱི་སྒོ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་དག།",
    "དེས་ཁྱེད་རང་རྣམས་ཀྱིས་ཡིད་ཀྱི་སྒོ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་མ་རིག་པ་བག་ཆགས་དང་བཅས་པ་དག།",
    "ཁྱེད་རང་རྣམས་ཕྱག་ན་རྡོ་རྗེ་གསལ་ཐོབ་ལ།",
    "གཏོར་མ་ཕྱག་རྡོར་དུ་གསལ་བ་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་ཕྱག་ན་རྡོ་རྗེའི་སྐུ་གསུང་ཐུགས་དབྱེར་མེད་འདྲེས་པར་གྱུར་སྙམ་དུ་བསྒོམ།",
    "ཉི་ཟླ་དུས་གཅིག་ཤར་དང་རང་ཉིད་ཀྱི།",
