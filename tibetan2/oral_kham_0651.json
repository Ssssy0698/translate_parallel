    "རང་རང་མཁོ་དགུའི་ཕུན་ཚོགས་བྱེ་བ་བརྒྱས།",
    "རྗེ་ཉིད་ཀྱིས་ང་ལ་ནི་འདི་ལ་འདོད་མེད་ཁྱེད་ནི་རྒྱ་ཁབ་མིག་བོལ་གྱི་རྗེས་ལ་བྱ་རྒོད་ཀྱི་ཉིན་ལམ་བཅོ་བརྒྱད་རྒྱུག་ཟེར་བར་གདའ།",
    "དཀོར་མཛོད་གླིང་རང་ན་སླེབ་འདུག་པ་སོགས་བཀའ་བཞིན་ལས་མི་འདའ་བར་སྣང་ཞིང་།",
    "མགོ་བརྙན་གྱི་རྣམ་པ་ཅན་མང་པོ་ཞིག་འདུག་པས་དེ་རྣམས་ཀྱིས་མགྲིན་གཅིག་ཏུ་ཞལ་ཏ་གང་གནང་ལས་ངེད་རྣམས་ཀྱིས་འདའ་བ་ནི་མི་བྱེད།",
    "དེ་ག་ལས་མ་འདས་པ་ཐག་ཆོད་འདུག་སྙམ་པ་ཐེ་ཚོམ་དང་བྲལ་བའི་ངེས་ཤེས་སྐྱེ་བ་མ་གཏོགས།",
    "ཀློག་པའི་འདུན་པ་བྱས་ཙ་ན་ཡལ་འགྲོ་བར་འདུག་གསུངས་པ་སོགས་ལ་ཐེ་ཚོམ་དུ་གྱུར་ཏེ།",
    "ད་ལོ་མ་ཤི་ན་ལོ་བརྒྱ་ཙམ་མི་ཐུབ་པའི་ངེས་པ་མི་གདའ་སྟེ།",
    "དེ་ཅིས་ཀྱང་ཡོང་བ་ཡིན་པ་གདའ་གསུང་།",
    "སྨྲ་བའི་དུས་ཀྱང་མིན་པ་འདུག་ཅིང་།",
    "ལོག་རྟོག་ཅན་རྣམས་ལས་ངན་གསོག་པ་ལས་མི་འདུག་པས་འདིར་མ་བྲིས།",
    "ཤེས་ལྡན་མང་དུ་ཐོས་པའི་བློ་གྲོས་དང་ལྡན་པ་རྣམས་ཡིད་ཆེས་པའི་གནས་སུ་གྱུར་ཅིང་ཐེ་ཚོམ་དང་བྲལ་བའི་ཞིབ་སེད་གནང་བཀའ་དྲིན་ཆེ་འདུག་ལགས་ཤིང་།",
    "ང་རྒྱལ་འཛིན་པའི་རྗེས་སུ་ཕྲ་ཐིག་དགོས་པར་གསུངས་འདུག་པ་དང་།",
    "ཁྱེད་རང་བློ་གྲོས་དང་ལྡན་པས་གོ་བར་ཟད་ཧེ་ཧེ།",
    "གླུའི་བསྐུལ་སོགས་ནི་སྐྱོན་ཅན་དུ་འདུག་པས་ཞུས་དག་དགོས་པའི་བཀའ་གྲོལ་འདུག་པ་ལྟར།",
    "འོན་ཀྱང་མཆན་བུ་རྗེས་སུ་གནང་བ་འདི་ཅུང་དག་ཏུ་གཏོང་བར་མཛད་པ་ཡང་འདུག་པ་དང་།",
    "ཅེས་གསུངས་པ་ཞིག་འདུག་པ་འདི་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་བསྡུས་གྲུབ་པས་ཅུང་ཟད་མི་བདེ་བ་འདྲ་ཟེར་བ་འདི་ལ་ཚིག་དོན་གཉིས་ཀ་ལ་མི་བདེ་རྒྱུ་གང་ཡང་མེད་དེ།",
    "རྣམ་དག་དུས་ཐབས་རྒྱུ་རྣམ་ངོ་བོ་ཡི།",
    "སྒྲུབ་པའི་ལུང་སྦྱིན་ཞིང་རང་གཞུང་རྩ་བའི་ཚིག་ལ།",
    "སྣང་ཡང་རང་བཞིན་མ་གྲུབ་པའི་ཕྱིར་སྒྱུ་མའི་ལུས་ཞེས་བྱའོ།",
    "རྣམ་དག་དུས་ཐབས་རྒྱུ་རྣམ་ངོ་བོ་ཡི།",
    "གླལ་དང་འཁྲིག་དུས་སྐད་ཅིག་ཙམ།",
    "སྣང་སྟོང་རང་ཤར་སོ་སོར་རྟོག་པ།",
    "དེའང་རང་ལུས་ཐབས་ལྡན་དང་གཞན་ལུས་ཤེས་རབ་ཀྱི་རྣལ་འབྱོར་གཉིས་ཀྱི་སྒོ་ནས་ཡས་བབ་ཟག་བཅས་དང་།",
    "སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་གྱི་མཚན་ཉིད་ནི།",
    "སྣང་ཡང་རང་བཞིན་མ་གྲུབ་པ།",
    "སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "ཀུན་ཀྱང་རང་བྱུང་སེམས་ཡིན་པས།",
    "རང་ལུས་གང་བདེར་འདུག་བྱས་ནས།",
    "ཀུན་ཀྱང་རང་བྱུང་སེམས་ཡིན་པས།",
    "ཉམས་ལེན་བྱེད་པ་ཉུང་བར་གདའ།",
    "འདིར་གོང་མ་མང་པོ་དག་དུས་ཞབས་སྙན་བརྒྱུད་ལས།",
    "ལས་དང་པོ་བས་འདུག་སྟངས་ལ་བསླབས་པས་སྲོག་ཐུར་བསྲེ་བ་བརྟན་པོར་བྱེད་པ་དང་།",
    "རྣམ་སྨིན་གྱི་ལུས་གནས་མ་གྱུར་ཀྱང་རང་སེམས་ལྷ་སྐུ་དངོས་སུ་འགྱུར་བ་དང་།",
    "འགྱུར་མེད་ཡེ་ཀློང་རང་བཞིན་དེར་བཞེངས་ནས།",
    "ཛྙཱ་ན་ཀཱ་ཡ་ཝཱ་གཱི་ཤྭ་ར་ཨ་ར་པ་ཙ་ནཱ་ཡ་ཏེ་ན་མ་ཨོཾ་སརྦ་དྷརྨ་ཨ་བྷ་བ།",
    "ཨོ་ཙཱ་བཛྲ་མཱ་ལ་མཱ་ཙ་ནི་ཀུ་རུ་ཀུ་རུ་སྭཱཧཱ།",
    "བྷཾཨོ་ཊྛ་བཛྲ་པྲ་དཱི་པེ་པྲ་དཱི་པཱ་ཙ་ནཾ་ཀུ་རུ་ཀུ་རུ་ཉྙོསྭཱཧཱ།"
  ]
}