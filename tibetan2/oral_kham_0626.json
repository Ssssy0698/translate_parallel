    "གཡས་གཡོན་དུ་གྲལ་ཆིག་སྦྲེངས་བྱས་པའི་ཚོགས་འཚོགས་པའི་རྣམ་པ་ལྟ་བུ་སོགས་ཕྱག་ལེན་མང་དུ་འདུག་པ་རྣམས་གསང་སྔགས་ཀྱི་ཤན་ཤོར་བས་ལུགས་སྲོལ་འདི་གའི་ཕྱག་ལེན་དང་ཅུང་ཟད་མི་མཐུན་པར་གདའ།",
    "དལ་འབྱོར་གྱི་མི་ལུས་ནི་གྱང་ལོགས་ལ་ཆགས་པའི་སྲན་མ་དང་ཚུལ་མཚུངས་པར་འདུག་གོ་སྙམ་ནས་དཔེ་དོན་རྒྱུད་ཐོག་ཏུ་འཕྲོད་ངེས་ཤིག་སྦྱར་ཏེ་བསྒོམས་པ་ན།",
    "ད་ལྟ་ཁྲོམ་ཆེན་པོ་ཁྲི་ཕྲག་མང་པོ་ཚོགས་པའི་ཚེ་ནའང་དེར་འཁོད་པ་མཐའ་དག་དུས་ཚོད་འདི་ནས་བཟུང་སྟེ་ལོ་བརྒྱ་ཚུན་གྱི་ནང་དུ་འཆི་བར་ངེས།",
    "ཡང་བྲོས་པས་ལྕགས་ཀྱི་ཁང་པའི་ནང་དུ་སླེབ་པ་ན་སྒོ་དབྱེར་མེད་དུ་འགྲིག་སྟེ་ཕྱོགས་ཀུན་ནས་མེ་འབར་ཏེ་བསྲེགས་པས་ད་འབྲོས་ས་ཡང་མི་འདུག་སྙམ་ནས་ངུ་འབོད་ལྷང་ལྷང་བ་བྱེད་དོ།",
    "རྒྱས་ཀྱི་སྐུའི་ཡོན་ཏན་ཕུལ་དུ་བྱུང་བར་འདུག་སྙམ་པའི་དད་པ་ལྷང་ལྷང་བ་དང་།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "དེ་བཞིན་དུ་ལུས་ཀྱི་མཐུ་ཉམས་པས་ལྡང་འདུག་ཚུལ་བཞིན་དུ་མི་འོང་།",
    "བདག་ལྟ་བུའི་གཞོན་ནུ་ཞིག་གནས་སྐབས་འདི་འདྲར་གྱུར་འདུག་གོ་བསམ་པའི་ཚུལ་གྱིས་བསྒོམ་གསུང་།",
    "དགེ་སྡིག་ཅན་གང་ཡང་འཆི་ཁའི་ཚེ་ད་ནི་འཆི་བ་འདུག་སྙམ་པའི་ལུས་ལ་ཆགས་པ་དྲག་པོ་ཞིག་སྐྱེས་པས་རྒྱུ་བྱས།",
    "ག་དུས་༥༣ན་གསུམ་པ་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པ་ལ་བློ་སྦྱོང་ཚུལ་ལ་ལམ་སྒྲོན་ལས།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "གཏིང་ནས་ཁྲེལ་བར་འདུག་པས་དེ་སྤངས་ཏེ་འགྲོ་བ་ཀུན་ལ་ཕན་པ་བསྒྲུབ་པར་བྱ་སྙམ་དུ་བསམ།",
    "དངོས་པོ་ཡིད་དུ་༦༦བ་འོང་བ་ལ་དམིགས་བསལ་གྱི་ཆགས་སེམས་གང་འདུག་པ་དེ་ལེགས་པར་བརྟག།",
    "མི་འདོན་དལ་བར་འདུག་རྣམས་གདོན་གྱིས་བརླམས།",
    "ད་དུང་དགྲ་ལ་ཕུན་སུམ་ཚོགས་པ་འདུག་པ་མི་བཟོད་པའི་བློ་ཐོལ་གྱི་ཤར་བྱུང་ན།",
    "ལས་ཡིན་པ་འདུག་སྙམ་དུ་སྡོམ་སེམས་དྲག་པོ་བྱ།",
    "རང་སྡུག་བསྔལ་ཐོག་ཏུ་བབས་པ་འདི་མི་བཟོད་པར་འདུག་སྙམ་ན།",
    "གཏོང་བ་ཡིན་པས་དཀའ་བ་མི་འདུག་སྙམ་པའི་སྤྲོ་བ་ཆེན་པོ་བསམ།",
    "ཞེས་སྐབས་སུ་བབ་ཅིང་རང་ཉིད་དམིགས་པ་གཅིག་ལ་གཏོད་པའི་ཡུལ་ནི་སྤྱིར་བཏང་ལ་སྐུ་གཟུགས་ལྟ་བུ་འོས་ཤིང་།",
    "གསལ་ཆའི་ངར་ཆ་ཧད་ཀྱི་ཤོར་ནས་དྭངས་ཆ་ཙམ་ལས་མི་འདུག་ན་བྱིང་བ་རགས་པར་ངོ་ཤེས་པར་བྱེད།",
    "དེ་ཡང་རང་ཅག་རྣམས་ཀྱི་རྒྱུད་ལ་གཉིད་ལོག་པ་དང་མ་ལོག་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་ངའོ་སྙམ་པའི་བློ་དམ་སྒྲིང་སྒྲིང་བ་ཞིག་ཡོད་ཀྱང་།",
    "ཞེས་སྐྱེ་བ་སྔོན་མའི་ང་དང་རྗེས་མའི་ང་རང་བཞིན་གྱིས་ཐ་དད་པ་ཡིན་ན་གཏན་ནས་འབྲེལ་མེད་པའི་ཐ་དད་པ་ཡིན་པས།",
    "ད་ང་དང་ཕུང་པོ་ལྔ་ཐ་དད་པ་ལས་འོས་མི་འདུག་སྙམ་པ་ན།",
    "ཤེས་བཞིན་གྱིས་ངར་འཛིན་པའི་རྟོག་པ་བཅད་མ་བཅད་ཀྱི་བྱ་ར་བྱེད་ཅིང་ང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཚུལ་ལ་གསལ་འདེབས་དགོས་པ་བྱུང་ན་ཅུང་ཟད་དཔྱད་པའི་སྒོ་ནས་ཚུལ་དེ་ལྟར་དུ་གྲུབ་པ་མེད་སྙམ་དུ་མཉམ་པར་བཞག།",
    "རྟ་གླིང་རང་བཞིན་གྱིས་གྲུབ་པ་རིགས་པས་འགོག་པའི་ཚེ་དེ་ལྟ་བུའི་ཐ་སྙད་པའི་ཤེས་ངོ་དེར་རྟ་གླང་ཡང་དག་པར་འཛིན་པའི་ཤེས་པ་དེ་འཁྲུལ་ཤེས་ཡིན་པ་སྒྱུ་མའི་རྟ་གླང་དང་མཚུངས་ཤིང་།",
    "དེ་གཞན་གྱིས་སྤྱོད་དུ་འཇུག་པ་ལ་ཡང་རང་ཉིད་ཀྱིས་དོན་དེ་ལ་འཇུག་པར་མ་བྱས་ན།",
    "ལག་ལེན་དམར་འཁྲིད་དུ་གསལ་བར་ཡི་གེར་འབྲི་བ་གཅིག་ཏུ་བསྟན་པའི་རྒྱུན་ལ་མི་ཕན་པར་འདུག་ནའང་།",
    "བློ་སྦྱོང་དོན་བདུན་མའི་འཁྲིད་ཡིག་གཉིས་པར་བགྲེས་སྐྱོན་ཆེ་ངེས་འདུག་པས་གསར་བསྐྲུན་དགོས་ཞེས།",
    "འཇིག་རྟེན་གསུམ་གྱི་མངའ་བདག་དུས་ཀྱི་ཕོ་ཉས་གཙེས་པས།",
    "ཧ་དཔྱད་ན་མི་གདའ་ཇི་ལྟར་ལགས།",
    "མངར་བར་གྱུར་པའི་རོ་ནི་ནང་༡༦བ་ན་འདུག།",
    "དགག་ལན་ཞིག་བྱས་ན་ཡོང་བར་འདུག་ཀྱང་།",
    "བྱེ་མ་བཙིར་བ་ལ་མར་ནག་ཡོང་རིགས་སུ་མི་འདུག་པས།",
    "ཟླ་བ་དེ་ནམ་མཁའ་མཐོན་པོ་ལ་གནས་ཤིང་རང་གང་ལ་གནས་པའི་ནམ་མཁའ་འོད་དཀར་པོས་མཛེས་པར་བྱེད་པ་དང་།",
    "སྒྲུབ་བྱེད་ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་།",
    "དང་པོ་མེད་ཚུལ་ཡང་རང་རྒྱུད་ཀྱི་རྟགས་དཔེ་བརྗོད་པ་ལ་དགོས་པ་མེད་དེ།",
    "ཁོ་རང་ལ།",
    "སེམས་ཙམ་པ་དང་རང་རྒྱུད་པ་གཉིས་ལ་དེ་ཡོད་པའི་ཕྱིར་ན་མ་ཁྱབ།",
    "དེ་དང་རང་བཞིན་གྱིས་གཞན་ཡིན་པའི་ཕྱིར་ཞེས་འདོད་པ་དེ་བཞིན་དུ།",
    "ས་ལུའི་མྱུ་གུ་དང་རང་བཞིན་གྱིས་གཞན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "ཤེས་བྱ་འདོམ་ལ་གཞལ་ཙ་ན།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར།",
    "བུམ་པ་ཞེས་བརྗོད་པའི་སྒྲས་ཀྱང་རང་ལ་དམིགས་པ་དང་།",
    "སྔོན་འཛིན་ཀྱང་རང་གཞན་གྱིས་མ་ཡིན་པའི་མྱོང་ཙམ་གྱི་ངོ་བོར་གྲུབ་དགོས་ཏེ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "རྨུགས་པའི་ཚེ་དུག་ཞུགས་པར་འདུག་སྙམ་དུ་དྲན་ཀྱང་སྔར་རྨུགས་མ་ཐག་པའི་ཚེ་དུག་མ་མྱོང་བ་བཞིན་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཡན་ལག་དེ་དང་ལྡན་པ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མིན་ཞིང་།",
