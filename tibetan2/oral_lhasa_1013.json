    "དགེ་སློང་མ་རྣམས་དང་ལྷན་ཅིཀ་ཚིག་རྩུབ་འཐབ་ཀྲོའ་དང་མཚང་འབྲུ་བ་དད་བརྒྱ་རྩོད་པ་དང་ཤགས་འགྱེད་པ་དང་བསྒོབ་ཕྱིར་བཟློག་བ་ལའོ།",
    "དངོས་པོ་གཞན་གྱི་ཆེད་དུ་རྙེད་པའི་ཤེས་ཟས་སུ་བྱས་ཏེ་བཟའ་བའི་ཕྱིར་འཇོག་བུ་ལའོ།",
    "དེ་ཡང་བུ་ཆུང་དུ་ལྷན་ཅིག་ཉལ་བའི་གནང་བ་ཐོབ་པ་ལ་འོ།",
    "གཞང་བ་དེ་སྦྱིན་པར་བྱའོ།",
    "གང་ཚུན་ཆད་ནས་ཤེ་ན་བདག་ཉིད་བསྙེན་པར་རྫོགས་པ་ནས་སོ།",
    "གནང་བ་སྦྱིན་པར་བྱའོ།",
    "འདུལ་ཅི་དགེ་སློང་མ་ཐམས་ཅད་ལ་སྦྱིན་པར་བྱབམ་ཞེན་དེ་ཉེ་བར་འཇོག་ནུས་པ་ལའོབསྙེན་པར་རྫོགས་ནས་ལོ་བཅུ་གཉིས་ལེན་པ་ཉིད་ལའོ།",
    "ཁྱིམ་སོབཟུད་བལོ་བཅུ་གཉིས་ཉིད་ཀྱི་མདུན་རོལ་དུ་བསྙེན་པར་རྫོགས་པར་བྱེད་པ་ལའོ།",
    "དེའི་མདུན་རོལ་དུ་བསྙེན་པར་རྫོགས་པར་བྱེད་པལའོ།",
    "ལོཉི་ཤུ་མ་ལོན་པར་བསྙེན་པར་རྫོགས་པར་ཕྱེད་པའི་ལང་བྱེད་དེཀྵ།",
    "བསླབ་པ་ལམ་བསླབ་པ་བསྙེན་པར་རྫོགས་པར་བྱེད་པའི་ལྟར་བྱེད་དོལོ་གཉིས་ལ་དགེ་སློའ་འི་བསླབ་པ་ལ་སྤྱད་པ་ཉིད་བསྙེན་པར་ལྕོགས་པར་མི་བྱེད་པའོབུསཱབ་པ་ལ་བསླབ་པ་བསྙེན་པར་རྫོགས་པར་མི་བྱེད་པའི་ལྟད།",
    "མངལ་གྱི་སྒོར་ཁུ་ཆུ་བླུགས་པར་མི་བྱའོ།",
    "མཛེས་འགྱུར་གྱི་བར་ཆདཀྱིས་ནུ་མའི་བར་དུ་བཅད་པར་མི་བྱའོ་། དེ་དག་ནི་ད་པེའོ།",
    "དེ་ལས་སྤུ་འཐོག་པར་བྱེད་དམ་ཕྱེད་དུ་འཇུག་བ་ལའོ།",
    "མལ་སོ་སོར་བྱ་པའི་སྐབས་ཡོད་ན་ཉེས་བྱས་སོ།",
    "ཚེས་ཉན་དུགཞུག་པའི་གནས་སྐབས་སུ་ཁྱིམ་པའི་སྟན་སྤྱད་པ་བྱིས་པ་ལ་མ་སྦྲན་པར་པར་ཏེ་འགྲོ་བ་ལའོ།",
    "ཁྲོ་བས་བདག་ཉིད་ལ་རྡེལ་བས་གནོད་པར་བྱེད་པ་ལའོ།",
    "དགེ་སློང་མའི་ཚོགོས་པར་བརྙས་ཐབས་བྱེད་པ་ལའོ།",
    "སྟན་བཏིང་སྟེ་ཕན་ཚུན་ཀུན་དགའ་བར་བྱས་ནས་ལུང་དྲི་བའི་སྦྱོར་བས་སྐབས་འབྱེད་དུ་གཞུག་པར་བྱའོ།",
    "སོར་བཤགས་བཅུ་གཅིག་པ་དམག་དཔོན་མེངགེའི་གླེང་གཞིལས་གྱུར་པའོ།",
    "དགེ་སློངམའི་རྣམ་པར་འབྱེད་པ་རྗོག།",
    "རྗེས་སུ་མ་གནང་བའི་ཕྱོགས་བྱེ་སྤུ་བྲེགས་པ་ལ་སོགས་པ་རྣམས་ནི་རྟགས་བླངས་པ་དེའི་ཕྱོགས་དང་མཐུན་པའི་བགོ།",
    "རྫས་གཞན་ལས་བྱས་པ་དང་།",
    "ཚིག་པད་བགོས་པར་འདོད་པའི་ཕྱོགས་དང་མཐུན་པ་ཉིད་དོ།",
    "འདོད་བའི་གཞི་ཉིད་ཞིམི་ཚངས་པར་སྤྱོད་པའི་ཕྱོགས་ཉིད་དོ།",
    "གཞན་དུ་ན། ༧འཇུགཔཉིད་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "འཁྲིགཔ་དང་ལྡན་པར་སྨྲ་བ་དང་།",
