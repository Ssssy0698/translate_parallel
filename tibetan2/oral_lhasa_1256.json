    "ཞེས་པ་ཡུན་རིང་བསྒྲུབ་པའི་ལྷ་མཐོང་པ་དེ་འདྲའི་དགའ་བ་དེ་ནི་ལྷ་སྒྲུབ་བྱེད་རྒྱལ་པོ་བི་དུ་རས་རྒྱུ་གཞན་ལས་མིན་ཞེས་འོས་པའམ་རིགས་པར་སྨྲས་པ་ཡིན་ཏེ།",
    "ར་གླུའི་རིགས་ཀྱི་རྒྱལ་པོ་དགའ་བའི་གོ་ཆ་ཡིས་དགའ་བ་རབ་ཏུ་གསལ་བར་བྱས་པ་གང་ཡིན་པ་དེ་ཡང་དགའ་བར་རྗེས་སུ་རྟོགས་པར་བྱའོ།",
    "སྔ་མ་ཁྱབ་འཇུག་དངོས་ལས་ཐོབ་པའི་དངོས་ཐོབ་ཀྱི་དགའ་བའི་ཁྱད་པར་དུ་འབྱེད་དོ།",
    "ཕྱི་མ་འདི་ལ་ཁྱད་པར་དུ་དགའ་བའི་རྒྱན་གྱི་ཐ་སྙད་བྱས་ཀྱང་མི་འགྲིགས་པ་མེད་དེ།",
    "དྭངས་བར་ནུས་པས་དགའ་བའམ་སྒེག་པའི་ཉམས་ཀྱི་ཆར་གཏོགས་པ་ཞི་བའི་ཉམས་སམ་ཡིད་དུ་འོང་བའི་ཉམས་དང་ལྡན་པ་ལགས་སོ།",
    "ཤི་བ་ཞེས་བྱ་བ་འཇིག་རྟེན་ཕ་རོལ་ཏུ་མཛེས་མ་གང་དང་འགྲོགས་པར་བྱ་ཕྱིར་བདག་འཆི་བར་འདོད་པ་ལ།",
    "དེ་ལ་མདངས་བཟང་པ་དང་ཟུར་མིག་མཛེས་པར་ལྟ་བ་དང་།",
    "སློང་བ་རྣམས་ལ་གང་འདོད་པའི་ནོར་རྣམས་ཀྱང་མ་བྱིན་པར་ཀུན་ལས་རྣམ་པར་རྒྱལ་བའི་ས་སྐྱོང་ཉིད་དུ་བདག་ཇི་ལྟར་འགྱུར་ཏེ་དེ་ལྟར་གྱུར་པ་ལ་སྤྲོ་བ་བརྗོད་པའོ།",
    "མ་ཞུམ་པའི་ཚུལ་གྱིས་སེང་གེ་ལྟར་བག་ཚ་བ་མེད་པར་བསྒྱིངས་ཤིང་བག་ཕེབས་པར་གནས་པའོ།",
    "འཇིག་རྟེན་གསུམ་གྱི་གཙོ་བོས་ཕྱག་བྱས་པ།",
    "ལུས་འཇམ་ཞིང་གཞོན་ཤ་ཅན་གང་ལ་མེ་ཏོག་པདྨ་ཡི་མལ་སྟན་དག་ཀྱང་རྩུབ་པར་བྱེད་པའི་རང་བཞིན་ཅན་མ།",
    "སེམས་ནི་བསྒྲིབས་པར་གྱུར་པའི་སྐྱེ་རྒུ་དང་།",
    "ལུས་ནི་མི་གཙང་ལས་བྱུང་སྟེ།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "རྒྱལ་པོས་དེ་ལྟར་ཅང་འགྱུར་རམ་ཟེར་བ་ལ་གསོས་པས་ལྷ་སྤྱན་སྔར་བབ་པར་བགྱིའོ།",
    "རྒྱལ་པོ་ཡང་དགའ་སྟེ་དེ་ལྟར་གནང་ངོ།",
    "གསོས་པས་ཁྱིམ་བྱི་དོར་བྱས་ཤིང་རྒྱལ་པོ་ལ་འོས་པའི་བཟའ་བཏུང་སྦྱར་ནས།",
    "རྒྱལ་པོ་ཡང་ཆུང་མ་གསར་པ་དེ་ལ་ཆགས་པས་གཞན་བཏང་ནས་དེ་ཁོ་ན་ལྷུར་ལེན་པར་གྱུར་པ་ན།",
    "ལྷ་རྣམས་འཁྲུགས་པར་གྱུར་ཏོ།",
    "འོན་ཀྱང་དེའི་དུས་སུ་བྲམ་ཟེ་འདུན་ན་འདོན་གྱིས་ལྷའི་ཤིས་པ་བརྗོད་པར་བགྱི།",
    "དེའི་ཚེ་ཡུལ་ས་འཛིན་ནས་ས་འཛིན་པའི་མི་ཞིག་ཟོང་ཐོགས་ཏེ་འཕགས་རྒྱལ་དུ་འོངས་པ་དེས་ཟོང་ཐམས་ཅད་བཙོང་སྟེ་སྨད་འཚོང་མ་དང་ལྷན་ཅིག་ཟོས་པར་བྱས་ནས་དེ་ལྟར་ལྷག་པར་ཆགས་སོ།",
    "རྗེའི་སྲས་བདག་ནི་ཞིང་པ་མ་ལགས།",
    "ཚོང་པ་མ་ལགས།",
    "གྲོང་མི་ཟོང་ཐོགས་ནས་ཡུལ་གཞན་དུ་འགྲོ་བ་མ་ལགས་ཏེ།",
    "གཞན་དུ་ན་ཁྱེད་ལྟ་བུ་དག་ལས་རྙེད་པ་གང་ལགས་པ་དེས་འཚོ་བ་ཡིན་པས་ཀཱར་ཥ་པ་ཎ་དག་སྩོལ་ཅིག་ཡང་ན་སྐྱེས་བུ་གཞན་གྱི་སྐབས་ཕྱེས་ཤིག་དེས་སྨྲས་པ།",
    "བྲམ་ཟེ་འདུན་ན་འདོན་ནི་ང་ལ་ཡོད་ན་པི་ཝཾ་སུས་བླང་པར་བྱ།",
    "ལྷ་ས་འཛིན་པ་པི་ཝཾ་ལེན་པས་འཚོ་བར་བགྱིད་པ་ཞིག་མཆིས་ཀྱི།",
    "དེའི་མིག་དར་གྱིས་བཀབ་ལ་ནང་དུ་དགུག་པར་བགྱིའོ།",
    "རྒྱལ་པོས་ལེགས་ཀྱིས་དེ་བཞིན་གྱིས་ལ་ཁུག་ཅིག་ཅེས་བྱས་སོ།",
    "བདེ་ལེགས་བྱས་ཏེ་གོས་དཀར་པོ་བགོས་ནས་རྒྱལ་པོའི་རྒྱབ་ཏུ་ཞོན་པ་དང་།",
    "བྲམ་ཟེ་མདུན་ན་འདོན་གྱིས་ཤིས་བརྗོད་བརྗོད་པར་བརྩམས།",
    "ཞེས་ཟེར་ཞིང་པི་ཝཾ་མི་ལེན་པར་ཡང་ནས་ཡང་དུ་གླུ་ཚིག་དེ་གླུར་ལེན་པར་བྱས་སོ།",
    "འདིས་བདག་ཤེས་ཀྱི་ཡུལ་ལས་དབྱུང་བར་བྱའོ་སྙམ་དུ་ཀཱན་པ་ཎ་ལྔ་བརྒྱ་བྱིན་ནས་ཡུལ་དབྱུང་བར་བྱས་སོ།",
    "གཞོན་ནུ་མ་འདིས་ནོངས་པར་མི་མཐོང་ཕྱིར།",
    "རྒན་ཞུགས་ཁྱེད་ཉིད་བདེ་བར་བཞུགས་མཛོད་ཅིག།",
    "ཞེས་གསུངས་ཀྱང་།",
    "བློ་སྔོན་དུ་བཏང་ནས་འདི་ལྟ་བུ་བྱས་པ་མིན་ཡང་ཡིད་རབ་ཏུ་དགའ་བའི་ཚལ་གྱི་ཤིང་ལྗོན་པ་བཟང་པོ་རྣམས་ཀྱི་འདབ་མ་རྙིང་པ་བརྗེས་ཏེ།",
    "འདི་ལ་འདི་དག་འགོད་འདོད་མེད་ཀྱང་སྐྱེས་བུས་བྱས་པ་ལས་ཀྱང་ལྷག་པར་ཡིད་དུ་འོང་བ་གང་ཞིག་གོས་དང་རྒྱན་ཕྲེང་ཁང་བའི་རྣམ་པར་བཀོད་པ་འདི་མཚར་ཞེས་པའོ།",
    "འདིར་སྙན་པ་ཡིད་འོང་ཉམས་དང་ལྡན་ཞེས་བརྗོད་པ་དེ་དག་སླར་ཡང་ཟློས་པར་མི་འགྱུར་རམ་ཞེ་ན།",
    "གཡུལ་དུ་དགྲ་བོ་གཞན་ཚུར་འཐབ་པར་ནུས་པ་རྣམས་ནི་གཞོམ་པར་དོན་གྱིས་བསྟན་པས་དེ་ལྟར་བཀག་པའམ།",
    "མེད་པར་བྱ་ནུས་པ་བསྟན་པར་བྱས་ནས་འཐབ་མི་ནུས་པར་འབྲོས་པ་རྣམས་ཇི་བདེར་གཏོང་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་བརྗོད་པ་ལ་གཞན་ཟིལ་གྱིས་གནོན་པའི་གཟི་བརྗིད་དང་ལྡན་པར་ཤེས་པར་བྱའོ།",
    "རལ་གྲི་ཕྱིར་ཕྱོགས་དང་རལ་གྲི་ཞེས་གང་ལྟར་བྱས་ཀྱང་དོན་ལ་མི་འགལ་ཡང་།",
    "དེ་ལྟར་ན་ཕ་རོལ་པོ་རལ་གྲིའི་སོ་ཚུར་མི་སྟོན་པར་ཕྱིར་ཕྱོགས་པའི་འབྲོས་པ་པོ་རྣམས་ཞེས་ཕ་རོལ་པོའི་རལ་གྲི་ལ་གོ་བར་བྱའོ།",
    "དེ་ལྟར་གང་དུ་ཡིད་མ་ཞུམ་ཞིང་སུ་ལའང་བག་ཚ་བ་མེད་ཅིང་འགྲན་ཟླ་མེད་པར་གནས་པའི་ཚུལ་བརྗོད་པ་ན།",
    "དེས་གཞན་ཟིལ་གྱིས་གནོན་ཞིང་དེ་ལ་ཅོ་འདྲི་བ་གཞན་མེད་པས་དེ་གཟི་བརྗིད་དུ་ལྡན་པ་ཉིད་དུ་ཤེས་པར་འགྱུར་རོ།",
    "རྒྱ་ཆེ་རོལ་པར།",
    "རྣམ་པ་གཞན་དག་ཐབས་མཁས་ཀྱི་སྒོ་ནས་བརྗོད་པ་གང་ཡིན་པ་དེ་ནི་རྣམ་གྲངས་བརྗོད་པར་འདོད་དེ་བརྒྱུད་ནས་ཕན་པར་རམ།",
    "ཐབས་ཀྱིས་ཕན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་གསུམ་བྲན་དུ་བྱས་པ་དེ་ཡི་མགོ་གཅོད་པའི་བྱ་བའི་ཁུར་ཆེན་པོ་ཡང་བློས་བཟོད་པར་ནུས་པ་ཡི།",
    "ང་སྤྲེའུ་ལས་དངོས་གྲུབ་ལེན་པར་མི་འདོད་ཟེར།",
    "ས་གསུམ་ལས་རྣམ་པར་རྒྱལ་བ་ཆེན་པོའི་དངོས་གྲུབ་བྱིན་པས་འཇིག་རྟེན་གསུམ་བྲན་དུ་འཁོལ་བར་གྱུར་ཏོ།",
    "དེའི་མིང་ཞིང་པ་རྣམས་ཀྱིས་རོལ་ནང་རྙེད་པས་རོལ་རྙེད་མའམ་སཱི་ཏཱ་ཞེས་པར་གྲགས་སོ།",
    "རང་ཉིད་རི་དྭགས་དེའི་རྗེས་བསྙེག་བཞིན་རྒྱ་མཚོའི་མཐར་ཐུག་པར་འདོང་དུ་ཕྱིན་པའི་ཤུལ་དུ།",
    "སྲིན་རྒྱལ་རྭ་བ་ཎ་བྲམ་ཟེའི་གཟུགས་སུ་སྤྲུལ་ནས་སི་ཏཱ་བླང་པར་བརྩམ་པ་ན།",
    "རྒྱལ་བུ་རཱ་མ་ཎས་རི་དྭགས་དེ་ཇི་ཙམ་བདས་ཀྱང་མ་ཟིན་པས་མིག་བསྒྱུར་བ་ཡིན་པར་གོ་ནས་སླར་རང་གནས་སུ་ལོག་པ་ན།",
    "དེས་མདའ་འཕངས་ཏེ་སྤྲེལ་རྒྱལ་བཱ་ལི་གསོད་པར་ཁས་བླངས་སོ།",
    "གཉིས་པར་དེ་གཉིས་དབྱེ་བ་མ་ཤེས་ནས་མདའ་མ་འཕོང་།",
    "དེ་ནས་མགྲིན་བཟང་དེས་དགའ་བྱེད་ཀྱི་ཇི་འདོད་སྒྲུབ་པར་ཁས་བླངས་པ་ལ།",
    "དེ་ལྟར་ན་ཁོ་བོའི་ཆུང་མ་སཱི་ཏཱ་སྲིན་པོས་ཁྱེར་བ་ལོངས་ཤིག་ཅེས་བྱས་པ་ལས།",
    "བདག་ལ་བློན་པོ་ཁྱད་པར་ཅན་ཧ་ནུ་མནྡྲ་ཞེས་ཡོད་པ་དེ་དང་གྲོས་བྱ་བར་འོ་སྐོལ་ཐབས་ཅིག་གཤེགས་ཞེས་ཟེར་བ་ལྟར་དེར་ཕྱིན་པ་དང་།",
    "རྒྱལ་པོ་འདིའི་དྲིན་ལན་བསབ་ཕྱིར་སཱི་ཏཱ་འགུགས་ཐབས་ཅི་ཡོད་ཅེས་བྱས་པ་ན།",
    "དེ་ནས་ཕྱིར་མཆོངས་གཅིག་བྱས་པས་ལངྐ་པུ་རིར་སོན་ཏེ་བལྟས་པས།",
    "དེ་ཉིད་ཀྱང་མིད་པར་བྱེད་ནུས་པ་དང་།",
    "དེ་ནས་རྒྱ་མཚོ་ལ་སྦྲེལ་དམག་སྦྲེལ་ནས་ཟམ་བྱས་པར་བརྟེན་ནས་དགའ་བྱེད་སྲིན་ཡུལ་དུ་བརྟོལ།",
    "དེ་ནས་རཱ་མ་ཎས་སྲིན་རྒྱལ་གསོད་པར་བརྩམ་པ་ན།",
    "སྲིན་པོ་རཱ་མ་ཎའི་བུ་བི་བྷིཥཞེས་པ་དེའི་ཚུལ་དུ་ད་ལྟ་སློབ་དཔོན་ཆེན་པོ་པདྨ་འབྱུང་གནས་སྲིན་པོའི་རྒྱལ་པོར་མཛད་དེ་སྲིན་པོའི་ཁ་གནོན་དུ་བཞུགས་པར་གྲགས།",
    "ཕའི་ལུགས་སུ་གསོད་པར་གྲོས་མཐུན་པར་གྱུར།",
    "གཞུང་དུ་དཔེ་ཞེས་དངོས་སུ་གསུངས་ཀྱང་དཔེ་རང་ལ་འཛིན་ན་བསྙོན་དོར་གྱི་གཟུགས་ཅན་ཡང་སྔར་བསྟན་པར་གསུངས་རིགས་ཀྱང་མ་གསུངས་པ་དང་།",
    "དེ་བཞིན་དུ་སྔ་ཕྱིའི་སྦྱོར་ཚུལ་ཤེས་པར་བྱས་ལ།",
    "ཚིགས་དུ་ཀ་རིས་འཇིག་རྟེན་གྱི་ཡིད་ནི་རབ་ཏུ་འཕྲོག་པར་བྱེད།",
    "ན་ཀྵ་ཏྲ་པ་ཐ་པརྟི་ནཱ།",
    "དགའ་བ་མེད་པར་ཅིས་མ་མནར།",
    "ཆུ་ཤེལ་གནས་བཟང་རྣམ་པར་བཀྲ་བ་ན།",
    "དགའ་བའི་སིམ་པ་ལའང་སྒྲ་ཕྱོགས་མཚུངས་པར་འཇུག་སྟེ་སེམས་ཚིམ་པའི་ལུས་ཉམས་ཀྱི་བྱེ་བྲག་ཡིན་པས་སོ།",
    "གར་ཆང་མཁུར་བཀང་བྱས་འདྲར་བདེ་བཞིན་ཟིམ།",
    "ཆུ་ཤེལ་གནས་བཟང་བཀྲ་བ་ནི་ཟླ་བའི་གདན་ལ་བཞུགས་པ།",
    "ཀླུ་ནོར་རྒྱས་ཀྱིས་བསྲུབ་ཐག་བྱས།",
    "འོག་ནས་རུ་སྦལ་གྱི་རྒྱབ་ཀྱིས་བརྟེན་ཏེ་བདུད་རྩིའི་དོན་དུ་འོ་མ་ཅན་གྱི་རྒྱ་མཚོ་བསྲུབས་པར་བྱས་སོ།",
    "ཤིང་ཡོངས་འདུ་སོགས་ལྷ་རྫས་དུ་མ་བྱུང་བ་བརྒྱ་བྱིན་སོགས་ལྷ་རྣམས་ཀྱིས་ཅི་རིགས་པར་ཁྱེར།",
    "ཨོ་སུ་ར་ལྷ་མིན་ཞེས་པའི་མིང་དུ་གྲགས་པར་གྱུར་ཏོ།",
    "དེ་ནས་བདུད་རྩི་བྱུང་བ་དེ་ཉིད་བླངས་པས་སྣོད་ཆེན་པོ་བརྒྱད་གང་བ་ལྷ་མིན་རྣམས་ཀྱིས་ཁྱེར་བས་ལྷ་རྣམས་ཡི་མུག་པར་གྱུར་ཚེ།",
    "བརྒྱ་བྱིན་ཡང་མི་སྣང་བའི་གཟུགས་ཀྱིས་ནམ་མཁའ་ལ་འཇུག་པར་བྱས་སོ།",
    "ཁྲུས་མ་བྱས་པར་ཟས་མི་བཟའ།",
    "དེ་རྣམས་ཁྲུས་བྱས་ནས་སླར་བདུད་རྩི་ལོངས་སྤྱད་དུ་འོངས་པ་ན་བདུད་རྩི་མ་མཐོང་བ་ཚོལ་བར་བརྩོན་པ་དང་།",
    "ལྷ་མ་ཡིན་རྣམས་མ་ཡིན་པས་བདེན་ནོ་སྙམ་ནས་བསྡད་དོ།",
    "བདུད་རྩིས་མགྲིན་པ་ཡན་ཆད་ཁྱབ་པས་མགོ་བོ་དེང་སང་ཡང་མ་ཤི་བར་ཉི་ཟླ་ལ་སྒྲིབ་པར་བྱེད་ཅེས་རིག་བྱེད་ཀྱི་གཏམ་ལས་གྲགས་སོ།",
    "ལྷ་རྣམས་འདུ་བའི་གནས་བཟང་པོ་ཤིང་ཡོངས་འདུ་ལ་སོགས་པ་རྒྱ་མཚོ་བསྲུབས་པ་ལས་འཇིག་རྟེན་འདིར་རྣམ་པར་བཀྲ་བ་སྟེ་སྣང་བར་གྱུར་པ་ནའོ།",
    "སུས་འཐུང་ན་ཆུའི་བཅུད་ཆང་ཞེས་པ་དེ་ལྷ་རྣམས་ཀྱིས་འཐུང་བས་མྱོས་བཞིན་དུ་བདེ་བར་ཚིམ་སྟེ་མིག་ཟིམ་བུར་བྱས་ནས་དགའོ་ཞེས་སོ།",
    "འདྲེས་པའི་ཚལ་སོགས་བཀོད་པ་རྣམ་པར་བཀྲ་བ་ན།",
    "ཚལ་དང་རི་ཏི་སེ་ལ་སོགས་པ་བཀོད་པ་རྣམ་པར་བཀྲ་བ་གང་ན།",
    "དེ་ཡི་རྗེས་སུ་མཐུན་པར་བྱེད་པ་ནི་རྡུལ་འཛག་པ་ཕན་ཆད་ནས་སྐྱེ་གནས་ལ་བདེ་བ་བསྐྱེད་པ་དོན་དུ་གཉེར་བས་སོ།",
    "དེ་ལུས་ལ་ཁུ་བའི་ཁམས་ཏེ་སྐྱེས་བུ་ལོ་བཅུ་དྲུག་ལོན་ནས་ཁུ་བ་འཛག་པའི་བདེ་བ་མྱོང་བས་ན་ཟླ་བ་ཆ་རྫོགས་པའམ་རྣམ་པར་བཀྲ་བ་ན།",
    "དཔེར་བྱས་ན་རྒྱ་མཚོ་ལྟར་མི་གཡོ་བ་དང་།",
    "དུས་མཚོན་པར་བྱས་ན་ཟླ་བ་རྣམ་པར་བཀྲ་བའམ་གསལ་བ་དུས་བཞིའི་ནང་ནས་སྟོན་ཀ་དང་།",
    "སྐབས་འདིར་གོང་བསྟན་རྣམས་ལས་གཞན་པ་འགའ་ཞིག་བསྟན་པར་བྱའོ།",
    "དཀར་མིན་གནག་པའི་མིག་ཅན་མཛེས་མ་དག་ལ་འཁྱུད་པར་བྱེད་དོ།",
    "འདོད་པ་ལས་ཆགས་པའི་མདངས་གདོང་དམར་པོར་གྱུར་པ་སྟོན་པར་བྱེད་ཅིང་།",
    "ཚ་ཟེར་ཅན་ནི་རི་ལས་ནུབ་པར་གྱུར་ཏེ།",
    "ལུས་སྐྱེས་འདོད་པ་དག་ནི་རྣམ་པར་རྒྱས་སོ་ཞེས་རྒྱས་པ་དང་།",
    "འདིར་རྒྱལ་པོ་དང་རལ་གྲི་གཉིས་ལས་རལ་གྲི་ཉིད་ལ་ནིཙྩཾ་ཤ་ཡི་སྒྲ་དོན་ཡོད་པར་ངེས་ཀྱི།",
    "མདའ་རྣམས་ཉིད་ལ་ངེས་པར་གནས་པ་ཡིན།",
    "རྒྱལ་པོ་དང་རལ་གྲི་སོགས་མ་སྦྱར་ན་སྒྲ་དེ་རྣམས་ཅིག་ཤོས་དེ་ལ་ངེས་པར་བཟུང་བའང་མེད་དེ།",
    "ཞེས་ངེས་བཟུང་བྱས་ནས་འོན་ཀྱང་དེ་ཁོ་ནར་ཡང་མ་ངེས་ཏེ།",
    "ཆགས་ཅན་གང་ཞིག་འཁྲིག་པ་ལ་ཞུགས་ནས་ཕན་ཚུན་འཁྱུད་པར་གྱུར་པ་རྣམས་ཀྱི་ལུས་ལའང་མཐོང་ངོ་ཞེས་བ་སྤུ་ལངས་པ་ལ་བསམ་པའོ།",
    "ཕྱི་མས་སླར་ཡང་ས་གཞི་ལ་ཆེར་མ་མེད་པར་བསྒྲུབ་པའོ།",
    "སྐྱེ་བོ་ངན་པ་མེད་པོར་བྱས་པ་ལ་ཚེར་མ་དཀྲུགས་པ་ཞེས་བརྗོད་པ་བཞིན་ནོ།",
    "དེས་ན་རྒྱལ་པོའི་ཡུལ་གྱི་ས་གཞིར་ཚེར་མ་དངོས་དང་སྐྱེ་བོ་ངན་པ་གཉིས་ཀ་མ་དམིགས་པས་ཀནའི་སྒྲ་པདྨའི་ཡུ་བ་ངེས་པར་བྱས་ནས།",
    "ཉི་མ་ངེས་པར་འཆར་བ་དང་།",
    "རྒྱལ་པོ་མངའ་ཐང་ངེས་པར་དར་བའོ།",
    "ཡང་ན་ཉི་མ་ནི་གཟི་བརྗིད་ངེས་པར་དར་བའམ་བདོ་བ་དང་།",
    "མྱུར་བར་བསྒྱུར་ན་ཕྱོགས་སུ་ལྷུང་ནས་སྒྲ་སྦྱར་ཞིག་པར་འགྱུར་ལ།",
    "རྒྱལ་པོ་བློ་མྱུར་བའམ་བྱ་བ་སྐྱེན་པར་བསྒྲུབ་པའི་མྱུར་བར་བྱས་ན་བོད་སྐད་དུའང་སྦྱར་བའི་ཚུལ་མི་འཇིག་གོ།",
    "ནུས་པ་འབའ་ཞིག་ལ་བསྒྱུར་ན་སྒྲ་སྦྱར་བ་ཞིག་པར་འགྱུར་ལ།",
    "ནུས་པར་བསྒྱུར་ན།",
    "ཁྱབ་འཇུག་གླང་གཅོད་མིན་པར་འགལ་ཏེ།",
    "ལྷ་ཡང་རྣམ་སད་མིན་པར་ཤེས།",
    "མི་འགལ་བའི་སྦྱར་བར་གྱུར་ན་འདི་ནི་འགལ་བའི་སྦྱར་བ་ཞེས་གསུངས་པའི་ཕྱིར་གང་རུང་དང་འགལ་བས་ཆོག་པ་འདྲ་སྙམ་པའོ།་",
    "ཉེར་ལྔ་པ་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ལ།",
    "རྒྱུ་དེ་ལ་ཡོན་ཏན་དང་རིགས་དང་བྱ་བ་ལ་སོགས་པ་ངག་གང་དུ་མ་ཚང་བ་ཉིད་བསྟན་པ་དེ་ནི་ཁྱད་པར་བརྗོད་པར་བྱས་པའི་རྒྱན་དུ་འདོད་དེ།",
    "དང་པོ་ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ནི།",
    "རིགས་མ་ཚང་པའི་ཁྱད་པར་བརྗོད་པ།",
    "བྱ་བ་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་དཔེར་བརྗོད་ནི།",
    "མིག་ཀྱང་སྡང་མིག་དམར་པོར་མ་གྱུར་པར།",
    "དགྲ་ཡི་རིགས་ནི་མཐའ་དག་ཉམས་པར་བྱས་ཏེ་བྲན་དུ་བཀོལ་ཞེས་ཁྲོས་པའི་རྣམ་འགྱུར་གྱི་བྱ་བ་དེ་དག་མེད་པར་དགྲ་འཇོམས་པའོ།",
    "རྫས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "རྟ་མེད་ལ་རྐང་ཐང་མེད་པར་ཡང་།",
    "ཤིང་རྟ་འདྲེན་པའི་རྟ་བདུན་ཡོད་པས་གྲངས་མི་མཉམ་པར་གྱུར་པ་ནི་རྒྱུ་ཡི་ཡན་ལག་མ་ཚང་བ་དེ་ལྟར་ན་ཡང་གཟི་བྱིན་ཆེན་པོ་ཅན་གྱི་ཉི་མས་ལྷ་ཀླུ་མིའི་འགྲོ་བ་གསུམ་པོ་ཟིལ་གྱིས་མནན་པར་གྱུར་ཏོ།",
    "གཞན་ཟིལ་གྱིས་གནོན་བྱེད་ཀྱི་རྒྱུ་དེ་ཡི་འབྱོར་པའི་ཁྱད་པར་འགའ་མ་ཚང་བ་ལྟར་སྣང་ཡང་།",
    "གཟི་བྱིན་ཅན་དང་སོགས་སྒྲས་ཚ་ཟེར་ལྡན་པ་སོགས་ཡོན་ཏན་གྱི་ཁྱད་པར་ལས་རྒྱུ་ཡི་བྱེད་པ་ཕུན་སུམ་ཚོགས་པར་གྱུར་པ་འདི་ནི་རྒྱུ་ཡི་ཁྱད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "བདུད་རྣམས་བྱེ་བས་བསོད་པར་མི་ནུས་ཏེ།",
    "དེ་ནི་ངེས་པར་སྐྱེ་བའི་ཕ་རོལ་འགྲོ།",
    "ཞེས་གསུངས་པ་ཡང་ཚུལ་འདི་དང་མཚུངས་སོ།",
    "ཉེར་དྲུག་པ་མཚུངས་པར་སྦྱོར་བའི་རྒྱན་ལ།",
    "དཔེར་མ་བྱས་པར་དོན་གཅིག་ཏུ་མཚུངས་པར་བྱས་ནས་འགའ་ཞིག་ནི་བསྟོད་པའམ།",
    "དེས་ན་སྐྱེས་བུ་ངན་པ་དང་མི་གཙང་བའི་འདམ་རྫོབ་དང་།",
    "རུལ་བའི་རོ་རྣམས་མི་སྡུག་ཅིང་སྐྱུག་བྲོ་བར་མཚུངས་པར་བརྗོད་ནའང་།",
    "སྐྱུག་བྲོ་བའི་རྣམ་པ་ཁྱད་འཕགས་མི་གཙང་བའི་འདམ་རྫབ་སོགས་དང་མཚུངས་པར་བརྗོད་པ་ཡིན་པས།",
    "མཚུངས་པར་བྱས་ནས་བསྟོད་པའམ།",
    "དེ་ནི་མཚུངས་པར་སྦྱོར་བར་བཤད།",
    "ཅེས་གཞན་པ་ཡོན་ཏན་ཁྱད་འཕགས་ཅན་དང་མཚུངས་པར་བྱས་ནས་དེ་རྣམས་ལ་མཉམ་དུ་བསྟོད་པའམ།",
    "གནས་སྐབས་གང་དུ་བརྗོད་འདོད་ཀྱི་དོན་འགའ་ཞིག་ནི་སྨད་པར་བྱ་བའི་སྐྱོན་ཅན་དང་མཚུངས་པར་བྱས་ཏེ་སྨད་པའི་དོན་དུ་བསྒྲགས་པ་གང་ཞེས་པའི་དོན་དུ་གོ་བར་བྱས་ཀྱང་རུང་ངོ།",
    "གཉིས་པ་ལ་དབྱེ་བ་གཉིས་གསུངས་པ་ལས།",
    "ཞེས་བརྒྱ་བྱིན་སོགས་དང་རྒྱལ་པོ་ལྷན་ཅིག་འཇིག་རྟེན་སྐྱོང་བ་ཡིན་པར་བསྟོད་པའོ།",
    "རང་བཞིན་གྱིས་སྐད་ཅིག་གཉིས་པར་མི་གནས་ཏེ་དེ་དག་སྐད་ཅིག་སྔ་ཕྱི་རིམ་བྱུང་ཡིན་པས་སོ།",
    "དངོས་པོ་གང་ལ་འགལ་བའི་ཟླ་བོ་ཡང་དེ་ཉིད་དུ་ཡོད་པ་གོ་བར་བྱེད་པའམ་སྒྲུབ་པར་བྱེད་པའི་སླད་དུ་ནི།",
    "སྤྲིན་དེས་ཆགས་པ་བསྐྱེད་པ་དག་ཏུ་བྱེད་པ་ཡིས་ཀྱང་འགྲོ་བ་རྣམས་ཀྱི་ཡིད་ནི་ཀུན་ཏུ་ཆགས་པར་གྱུར་ཏོ།",
    "ཡུལ་ཅན་འགྲོ་བའི་ཡིད་སྡུག་པ་ལ་ཆགས་པའི་ཆགས་ལྡན་དུ་བྱས་པའི་ཡོན་ཏན་འགལ་བས་སོ།",
    "མཆི་མ་ཟག་པར་བྱེད་པ་འགལ་ལོ།",
    "མིག་སྤྲིན་དཀར་པོ་དེའི་རྗེས་སུ་དམར་བ་ཡང་འདི་ལྟར་དཀྱུས་རིང་བའི་མཐའ་རྣ་བ་དག་ལ་བརྟེན་པ་འདི་ནི་འདི་ལ་བརྟེན་ནས་གང་ཟག་སུ་ཡི་ཡིད་བརྟན་པ་ཉིད་དུ་འགྱུར་ཏེ་མི་འགྱུར་རོ་ཞེས་འདི་མཐོང་བས་ཆགས་པས་ཡིད་མི་བརྟན་པར་གཡོའོ།",
    "འབད་པ་ཆེན་པོ་མེད་པས་རྙེད་པར་སླ་བའི་ནོར།",
    "གལ་ཏེ་རྣམ་པ་སྨད་པ་བཞིན་དུ་ཡང་དོན་ལ་བསྟོད་པ་བྱས་ནས།",
    "ཞེས་པ་དྲང་སྲོང་བྷི་གུ་སྟེ་ངན་སྤོང་ཤེས་པའི་རིགས་ལས་བྱུང་བ་རྭ་མ་ཞེས་པ་དེས་གཞན་གྱིས་སྤྱོད་པར་དཀའ་བའི་དཀའ་ཐུབ་དྲག་པོ་ཡུན་རིང་བྱས་པའི་མཐུས་ཚེ་དེ་ཉིད་ལ་ས་ཆེན་པོ་འདི་ལས་རྣམ་པར་རྒྱལ་བའི་གཏམ་རྒྱུད་རྒྱ་ཆེར་ཡོད་པ་དང་སྦྱར་བ་རཱ་མ་ཎ་སྔ་མ་དགྲ་སཱུ་རཱ་མ་དང་།",
    "ཚེ་སྔོན་གྱི་དཀའ་ཐུབ་སོགས་ཀྱི་མཐུས་ས་མཐའ་དག་ལས་རྣམ་པར་རྒྱལ་བ་ཐོབ་པ་ཡིན་པས།",
    "དེ་ལྟར་རཱ་མ་སྔ་ཕྱི་གཉིས་པོ་མིང་མཐུན་པས་བསྡུས་ནས་རཱ་མ་ཎའི་མིང་ཅན་དེས་ཀྱང་ནགས་སུ་རྒྱུ་བའི་དཀའ་ཐུབ་ལྷུར་བླངས་ནས་དཔུང་གཞན་མེད་པར་ཡང་འབྱུང་པོ་འཛིན་མ་ས་ཆེན་པོ་འདི་ལས་རྒྱལ་བར་གྱུར་ན།",
    "ཞེས་ང་རྒྱལ་བྱ་རིན་མི་ཆོག་པ་སྐད་དུ་སྨད་པ་ལྟར་བྱས་བའི་ཟོལ་གྱིས་ར་མ་གཉིས་བཞིན་ས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བའི་མཐུ་ཕུན་སུམ་ཚོགས་པའི་ཡོན་ཏན་རྒྱ་ཆེ་བའི་བསྟོད་པ་བྱས་པའོ།",
    "འདོད་ཆགས་ཀྱི་ཆགས་པར་གོ་བར་མི་བྱའོ།",
    "བརྗོད་ཚུལ་གྱི་སྒོ་ནས་ཀྱང་དབྱེ་བ་བྱས་ན་རབ་ཏུ་རྒྱ་ཆེ་མཐའ་དང་བྲལ་བ་ཡོད་དོ།",
    "སུམ་ཅུ་པ་ངེས་པར་བསྟན་པའི་རྒྱན་ལ།",
    "ཞེས་པའི་སྟོན་བྱེད་བཀོད་ནས་དེས་མཚོན་པའམ་བསྟན་པར་བྱ་བ།",
    "སྐྱེ་བོ་བཟང་པོ་དང་འགྲོགས་པས་དཔལ་ཕུན་སུམ་ཚོགས་པ་འགྲུབ་བམ་སྙམ་པ་ལ་ངེས་པར་འགྲུབ་པ་ཉི་མས་པདྨ་ལ་དཔལ་སྟེར་བ་བསྟན་པའི་ཕྱིར་རམ་ཤེས་པའི་ཕྱིར་རོ།",
    "འདིར་སྔ་མ་དཔེར་བྱས་པ་མིན་ཞིང་།",
    "དམ་པའི་སྐྱེས་བུ་གྲོགས་པོ་རྗེས་སུ་འཛིན་པ་རྣམས་ཀྱི་མཐུ་ལས་ཕུན་སུམ་ཚོགས་པའི་འབྲས་བུ་འགྲུབ་པ་ངེས་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ལྷན་ཅིག་བརྗོད་པ་ཡི་དཔེར་བརྗོད་འགའ་ཞིག་འདིར་བྱས་ཏེ།",
    "ཡོངས་སུ་བརྗེས་པའི་རང་བཞིན་ཡང་དཔེ་ཡིས་ངེས་པར་བསྟན་པ་ཅུང་ཟད་བྱ་ན་འདི་ལྟ་སྟེ།",
    "ཞེས་པར་མཚོན་བསྣུན་པས་གྲགས་པ་ཚུར་འཕྲོག་པ་བསྣོལ་བར་གྱུར་པས་ཡོངས་སུ་བརྗེས་པ་ཞེས་བྱ་སྟེ།",
    "ཐེ་ཚོམ་ཅན་གྱི་རྒྱན་ཞེས་པ་འདི་དག་ནི་རྒྱན་རང་རྐྱ་ཐུབ་པར་ལོགས་སུ་འཇོག་དགོས་པ་ཅི་ཡང་མེད་པས་དཔེ་ཡི་རྒྱན་ཉིད་ལ་བསྟན་ཏེ།",
    "བདག་རང་ཉིད་དང་མཚུངས་པར་འགྱུར།",
    "གཟུགས་ཅན་གྱི་རྒྱན་རྣམས་ལ་ངེས་པར་བསྒྲགས་ཏེ།",
    "གོང་བསྟན་མཚན་ཉིད་ཐ་དད་པའི་རྒྱན་རྣམས་ངག་སྦྱོར་གང་དུ་བསྲེས་པ་སྟེ་ཅི་རིགས་སུ་འདྲེས་པར་བྱས་པ་དེ་ནི་རབ་སྤེལ་ལམ་སྤེལ་མའི་རྒྱན་དག་ཏུ་བརྗོད་པ་སྟེ།",
    "དཀའ་བ་མེད་པར་འགོག་ནུས་སོ་ཞེས་སྔ་མའི་སྒྲུབ་བྱེད་དུ་གྱུར་པའི་དོན་གཞན་བཀོད་པའི་རྒྱན་དུ་གྱུར་པའོ།",
    "དེར་ཡང་པདྨ་དང་གདོང་མཛེས་པར་འདྲ་ཡང་དེའི་སྟེང་དུ་མཛོད་དང་ཡུ་བ་ཕུན་སུམ་ཚོགས་པ་པདྨ་ལ་ལྷག་པའི་ཕྱིར་འགོག་ནུས་ཞེས་སོ།",
    "འདིའི་རྐང་པ་དང་པོ་གཉིས་ཁྱད་པར་ཅན་དང་།",
    "འདམ་རྫབ་མེད་པར་འདམ་ལས་སྐྱེས་པ་བྱུང་།",
    "བདུད་ལ་འཕྱ་བ་བཞིན་དུ་དགོད་པར་གྱུར།",
    "ཅེས་གསུངས་པ་འདི་ལ་ཡང་།",
    "དང་པོ་དགོངས་པ་ཅན་གྱི་རྒྱན་ཞེས་པ་དཔེར་བརྗོད་ཀྱི་སྒོ་ནས་སྔ་མ་རྣམས་ལས་རྣམ་གྲངས་ཐ་དད་པར་བགྲང་བར་བྱ་བ་མིན་ཡང་།",
    "དོན་དང་བྲལ་བའི་ཁྱད་པར་ཞེས་པ་སྐབས་ཀྱིས་བརྗོད་བྱར་མི་འོས་པ་རྣམས་མ་བྱས་པས་བརྗོད་པ་ལ་དོན་ཡོད་པའོ།",
    "གསུམ་པ་གང་དང་གང་བརྗོད་པར་འདོད་པ་དེ་དང་དེའི་ཡོན་ཏན་ནམ་ངང་ཚུལ་གྱི་གནས་སུ་འོས་ཤིང་རིགས་པར་བསྔགས་པ་ནི་བརྗོད་ཚུལ་ཡིད་དང་འཐད་པའོ།",
    "རྣམ་པར་སྲེད་པ།",
    "མཉམ་པར་འཇོག་པ།",
    "རྣམ་པར་དར་བ།",
    "དེ་ལ་རིགས་བསྡུ་ན་བྱ་སླ་བ་དང་དཀའ་བ་སྟེ་གཉིས་སུ་ཡང་ཡོད་པ་དེ་ཡི་དཔེར་བརྗོད་འགའ་ཞིག་དག་ནི་འདིར་བསྟན་པར་བྱའོ་ཞེས་འགའ་ཞིག་ལས་ཐམས་ཅད་མ་བསྟན་ཀྱང་འདིས་མཚོན་ནས་ཤེས་སླའོ།་",
    "ཚིག་འགྲེལ་མཚོན་ཙམ་བྱས་ན།",
    "སྔར་བསླུས་པ་དེ་ཉིད་ལ་ངོ་ཚ་དང་ལྡན་པར་གྱིས་ཤིག་ཅེས་སོ།",
    "སྐྱེ་རྒུ་ཐམས་ཅད་རྒྱལ་པོ་བཟང་པོ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "གཉིས་པར་བ་ད་ན་བ་ད་ནེ།",
    "དེར་འགུགས་པར་བྱེད་ཅེས་མིག་ཕྲོག་ནས་བཀུག་པའི་དོན་ནོ།",
    "བདག་སྟེན་པར་མི་འདོད་པའི་ཁེངས་པ་ཅན།",
