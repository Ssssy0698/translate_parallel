    "ཁེངས་པ་དེ་དོར་བའི་ཚད་དེས་ལེགས་པར་འགྲོགས་སུ་ཆུག་ཅིག་ཅེས་ཆགས་བཞིན་དུ་ཁེངས་པ་མི་རིགས་པས་ཚུལ་མིན་ཡིན་ནོ་ཞེས་བརྗོད་པ་སྐད་དུའོ།་",
    "འཛིན་མ་ས་གཞི་ལ་སྤྱོད་པ་ས་སྐྱོང་རྣམས་ཀྱི་ལག་པ་ཕ་རོལ་རྣམ་པར་གནོན་པ་མི་དམན་ཞིང་།",
    "གཟུགས་མཚུངས་པའི་ཡི་གེ་དུ་མ་ཡོད་པས་ཟུང་ལྡན་ཡིན་པ་གང་ཞིག་ཟུང་ལྡན་ལུགས་ལས་བཟློག་པ་ཞེས་པར་བཤད།",
    "རྐང་པ་དང་པོ་གཉིས་པར་བཟློག་ཅིང་།",
    "གསུམ་པ་དང་བཞི་པར་བཟློག་པ་དང་།",
    "དང་པོ་བཞི་པར་དང་གཉིས་པ་གསུམ་པར་བཟློག་པའི་དཔེར་བརྗོད་གཉིས་ལས།",
    "ཡང་ན་དེ་ལ་བདེན་པ་མེད་པ་ཞེས་པའི་མིང་འཇུག་པར་རྒྱ་འགྲེལ་ལས་བཤད།",
    "གཉིས་པ་ན་མེ་ཀ་སོགས་ལུགས་ལས་བཟློག་པས་གསུམ་པ་བྱས་པ།",
    "དེའི་འབྲས་བུ་གདུང་བ་མེད་པར་བསྟན་པའོ།",
    "དཔེའུ་རིས་འདིས་ཤེས་པར་བྱའོ།་",
    "འདི་ཡང་དཔེའུ་རིས་ལས་རྟོགས་པར་བྱ་སྟེ།",
    "ཟུར་གྱི་གྲར་འགྲིག་ཅིག་འོང་ཡང་ཞར་བྱུང་དུ་ཐོན་པ་ལས་ཆེད་བྱས་མིན་ལ།",
    "དེར་ཡང་ཉམས་པ་མེད་པར་གོང་ནས་གོང་དུ་འཕེལ་བའི་ཚུལ་དུ་གསལ་བ་རབ་ལ་སོན་པ་ཉིད་དུ་རྒྱས་པར་འགྱུར་རོ།",
    "དེ་ཡང་བཞི་དང་གསུམ་ལ་སོགས་པར་ངེས་པར་རབ་ཏུ་བསྟན་པ་འདི་ཉིད་བྱ་དཀར་བརྗོད་ཀྱི།",
    "བཞི་པ་ཨེ་ཁོ་ནར་བྱས་པ་ཡོད་པ།",
    "བཞི་པ་དེ་གསུམ་འདྲེས་པར་བྱས་པའི་ཚིགས་བཅད་དེའི་དོན།",
    "ས་ལས་རྣམ་པར་རྒྱལ་བའི་བརྟན་པ་སྒྲུབ་པར་བྱེད་པའི་རྟུལ་ཞུགས་ལ་དགའ་ཞིང་།",
    "ལྕི་བར་ཞེས་ཤུགས་ཆེ་བར་འདར་བར་བྱས་སོ་ཞེས།",
    "ཀུ་ཞེས་པ་ཀ་ཁ་ག་གྷ་ང་མཚོན་པ་ལྟར་གཞན་མ་བཞི་ལའང་ཤེས་པར་བྱའོ།",
    "གཞན་བཞི་པོ་ཅི་རིགས་སུ་འདྲེས་པར་བྱས་པ་དེ་བོད་སྐད་དུ་བསྒྱུར་པ།",
    "དེ་རྣམས་བཅོམ་པ་ན་དེའི་གྲགས་པའི་སྒྲ་ཡིས་མཐོ་རིས་འཁྲུགས་པར་གྱུར།",
    "ཅེས་པ་ལྷ་གནས་སོ་སོར་གསང་མཐོར་སྨྲ་བས་སྒྲ་གསང་འཐབ་སྟེ་འཁྲུགས་པར་གྱུར་ཅེས་སོ།",
    "ཞེས་པ་སྒྱུ་རྩལ་སོགས་ཀྱི་རིག་པར་མཁས་པ།",
    "ལྷ་དང་ལྷ་མིན་ལ་ཁྱབ་པར་འགྲོ་བའི་སྟོབས་དང་ལྡན་པའི་བྱིན་པ་མཛེས་ཤིང་ལེགས་པ་ཅན།",
    "བཞིན་གྱིས་ངེས་ཚམས་པར་མ་བཅོམ་མིན།",
    "འདི་ཡིས་བཞིན་གྱིས་ངེས་པར་ནི་མ་བཅོམ་མིན་ཏེ་བཅོམ་པས་འདིའི་བཞིན་ལ་ལྟ་དཀའ་ཞིང་།",
    "དེ་བཞིན་རོ་སྔ་ཕྱིའི་སྒྲ་ལའང་ཤེས་པར་བྱ་ཞིང་།",
    "ར་རོ་བ་རྒྱུ་དེས་མྱོས་པའམ་རྨོངས་པར་བྱས་པའི་དོན་དང་།",
    "ར་རི་ནི་ནག་པོ་ར་རི་ཟེར་བ་ལྟར་དྲི་མའམ་སྐྱོན་དུ་དོན་གྱིས་གོ་བར་བྱས་ནས་འདི་སྐད་དུ།",
    "དེ་ཡན་ཆད་ཀྱིས་ཟུང་ལྡན་གྱི་རིགས་སུ་གཏོགས་པའི་བྱ་སླ་བ་དང་དཀའ་བའི་རིམ་པའི་དཔེར་བརྗོད་རྣམས་བསྟན་ཟིན་ནས་གབ་ཚིག་བསྟན་པར་བཞེད་པས།",
    "ལུགས་ཀྱང་རབ་ཏུ་བསྟན་པར་བྱ།",
    "ཞེས་གསུངས་སོ།",
    "གབ་ཚིག་མི་ཤེས་པའི་ཕ་རོལ་པོ་དག་ཚིག་དེའི་དོན་ལ་ཀུན་ཏུ་རྨོངས་པར་བྱེད་པ་ལ།",
    "བོད་སྐད་ལྟར་ན་ཚིག་ཕྲད་ཀྱི་ཡི་གེ་སོགས་ཚིག་སྔ་ཕྱི་མཚམས་སྦྱར་ནས་དོན་གཞན་དུ་གོ་བ་ཤས་ཆེ་བས་བརྗོད་དོན་གབ་པའམ་སྦས་པ་ནི་ཀུན་ཏུ་ཚོགས་པའི་གབ་ཚིག་ཅེས་པར་བརྗོད་དེ།",
    "ལྔ་པ་བརྗོད་བྱ་དངོས་མ་སྨྲས་པར།",
    "བདུན་པ་གང་དུ་བརྗོད་བྱའི་གྲངས་ཙམ་བརྗོད་པས་ཉིད་ཀྱིས་གྲངས་ཅན་དངོས་ཀྱི་བརྗོད་དོན་ལ་ཀུན་ཏུ་རྨོངས་པར་བྱེད་པ་གྲངས་ཉིད་ཀྱི་གབ་ཚིག་ཅེས་བྱ་སྟེ་དེ་ལྟར་ཤེས་པར་བྱའོ།",
    "བརྒྱད་པ་གང་དུ་གབ་པར་བྱ་བ་དེ་ཉིད་དེ་དང་མཚུངས་པའི་ངག་དོན་ནམ།",
    "ངག་སྦྱོར་གྱི་རྣམ་པ་གཞན་དུ་སྣང་བ་དག་ཏུ་བྱས་པ་དེ་ནི་རབ་བརྟགས་ཀྱི་གབ་ཚིག་ཉིད་དོ།",
    "ལེགས་པར་བརྟགས་ན་གབ་བྱའི་མིང་བསྟན་ཡོད་པའི་ངག་དེ་ནི་མིང་དུ་མ་འདུས་པ་ཉིད་དོ།་",
    "བཅུ་གཅིག་པ་བསྒྲིབ་བྱའི་དངོས་མིང་མ་སྨོས་པར།",
    "ངག་དེས་སླར་ཡང་རྨོངས་པར་བྱེད་པའི་ཕྱིར་ན་ཀུན་ཏུ་རྨོངས་པ་ཞེས་བྱ་བའི་གབ་ཚིག་གོ།",
    "རིམ་འབྲེལ་བྱས་ན་དོན་གོ་ཡང་དེ་ལྟར་མི་གོ་ནས་བརྗོད་བྱ་གང་ཡིན་ཡོངས་སུ་འཕྲོག་པའི་ཕྱིར་རོ།",
    "བཅུ་བཞི་པ་གང་དུ་རྟེན་ལུས་ལྟ་བུ་མ་བརྗོད་པར་སྦས་ཏེ།",
    "བཅོ་ལྔ་པ་གང་དུ་རྟེན་བརྟེན་པ་གཉིས་ཀ་སྦས་པར་གྱུར་པ་དེ་ནི་གཉིས་ཀ་བསྒྲིབས་པའོ།",
    "དེ་དུས་ན་ཞེས་ཡར་བཅད་ན་ཉི་མ་ཤར་ཚེ་ཆུང་མ་དང་སྐྱེས་བུ་ཉལ་པོ་བྱས་པ་ལས་ལངས་ནས་རང་གནས་སུ་འགྲོ་ཞེས་པ་ཡིན་ཡང་ཚིག་མཚམས་སྦྱར་བས་དེ་ལ་མི་གོ་བའོ།",
    "གྱ་ནོམས་ཟས་སྤངས་དབེན་པར་རྒྱུ།",
    "ཡོངས་གྲགས་མཚན་བཟང་མ་ལས་མཚལ་བསླངས་ཏེ་ག་བུར་དང་བསྲེས་ནས་སྐྱེས་བུའི་གཟུགས་བརྙན་བྱེད་པར་གོའོ།",
    "ས་ལ་འབེབས་པར་བྱེད་པ་འདི།",
    "ཁ་ལས་སྒྲ་སྙན་སྒྲོག་པར་བྱེད་ཅིང་།",
    "ཉམས་མཚར་དུ་སླར་ཡང་དཔེར་བརྗོད་གཉིས་བྱས་པ།",
    "དབེན་པར་ཅི་བདེར་སྤྱོད་པ་སྨྲོས་ཅི་འ་འཚལ།",
    "འདི་ལ་དཔེར་བརྗོད་བྱས་ན།",
    "བྱ་བ་ལ་ནི་འདི་མང་བྱས།",
    "རྣམ་པར་འཕྲུལ་ཞིང་ཕྱོགས་རྣམས་ཀུན་ཏུ་རྒྱུ།",
    "སྦྲང་རྩིས་ངོམས་པར་མ་གྱུར་དེ་སྲིད་དུ།",
    "ད་ནི་མྱོས་པར་བྱས་དེ་རྣམས།",
