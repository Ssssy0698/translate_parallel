    "རིག་པའི་སྒོ་འབྱེད་མཁན་ཞེས་པ་ནི་བློ་གྲོས་ཀྱི་སྒོ་འབྱེད་མཁན་ཞེས་པའི་དོན་ཡིན་དེ་ཡང་ཐོན་མིས་ཡི་གེ་བཟོས་པ་ལ་བརྟེན་ནས་རིམ་གྱིས་བཅུ་ཕྲག་རིག་པའི་གནས་རྒྱ་ཆེར་དར་བཅུ་ཕྲག་རིག་པའི་གནས་ལ་སྦྱངས་པ་བྱས་པ་ལ་བརྟེན་ནས་པོད་མི་མང་གི་བློ་གྲོས་རྒྱས་པས་སོཤོག་གྲངས་༡ཐིག་ཕྲེང་༡༣ན་གང་གི་མཁྱེན་རབ་རྒྱ་མཚོའི་ཀླུང་ཀློང་ཡངས་ལས་ཞེས་པ་ནས་གོ་སླའི་ངག་ཀིས་རྒྱ་ཆེར་དབྱེ་བར་བྱ།",
    "ཕོ་དང་མོ།",
    "ཞེས་པའི་བར་གྱི་ཚིགས་བཅད་འདི་ནི་དངོས་པོ་ངེས་བསྟན་ཡིན་དེ་ཡང་རྐང་བ་དང་པོས་ཐོན་མིའི་ཞལ་ལུང་ཞེས་པའི་བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་འདི་ད་ལྟའི་གདུལ་བྱའི་བློ་དང་འཚམ་པ་ཞིག་ཡིན་ཚུལ་བསྟན་ཡོད་རྐང་བ་གཉིས་པས་བསྟན་བཅོས་འདི་རང་བཟོ་སྤངས་ཏེ་ཁུངས་ལྡན་ཡིན་ཚུལ་བསྟན་ཡོད་རྐང་བ་གསུམ་པས་རིགས་པ་ཡང་དག་གིས་གཞན་གྱི་ལུགས་མ་དག་པ་དགག་པ་དང་རང་ལུགས་འཐད་ལྡན་དུ་བསྒྲུབས་ཡོད་ཚུལ་བསྟན་ཡོད།",
    "སྐལ་བཟང་ཞེས་པ་ནི་སློབ་སྦྱོང་གི་ཕྱོགས་ལ་ཆ་རྐྱེན་བཟང་པོ་ལྡན་པའི་དོན།",
    "ཁ་ཆེ་ནི་ཡུལ་ཀསྨི་ར་ཡིན་དེ་ཡང་རང་རེའི་བོད་མངའ་རིས་ཀྱི་ནུབ་མཐའ་དང་འབྲེལ་ཏེ་ཆགས་ཡོད།",
    "ཁོང་གིས་མཛད་པའི་བསྟན་བཅོས་དག་ལ་བེཌཱུརྱའི་མིང་གིས་བཏགས་ཡོད།",
    "ས་ཆེན་གྲགས་པ་རྒྱལ་མཚན་ཞེས་པ་ས་པཎ་གྱི་ཨ་ཁུ་ཡིན།",
    "རབ་བྱུང་གི་ལོ་ཇི་ལྟར་བྱུང་ཚུལ་གཉིས་ཤེས་དགོས།",
    "མེ་མཁའ་རྒྱ་མཚོ་ཞེས་པ་གྲངས་ཀྱི་མངོན་བརྗོད་དེ་ལོ་གྲངས་བཞི་བརྒྱ་དང་གསུམ་གྱི་མིང་རེད།",
    "རབ་བྱུང་རེ་ལ་ལོ་དྲུག་ཅུ་ཐམ་པ་ཡིན།",
    "ཀུན་ལ་རྒྱས་པར་བྱེད་པ་ཡིན་ཞེས་པའི་སྐབས་འདིར་དབུས་གཙང་གི་ཕྱོགས་ཀུན་ལ་སྤེལ་རྒྱུ་ཡིན་ཞེས་པའི་དོན་ཡིན་གསུངས།",
    "ཚང་མ་གཟུངས་སྔགས་སམ་མཚན་སྔགས་ཡེན་གསུངས་འདི་ཉེར་གཅིག་ནི་ཐོན་མིའི་ཞལ་ལུང་གི་ཤོག་གྲངས་སོ་གསུམ་གྱི་ཐོག་ན་གསལ།",
    "སེ་ར་ཐེག་ཆེན་གླིང་གི་གཡས་ཕྱོགས་ཀྱི་ཅུང་ཉེ་ས་ན་ཡོད།",
    "ཕ་བོང་གི་འོག་ཏུའང་མཇལ་ས་ཡོད།",
    "དཔལ་ལྡན་ལྷ་མོ་རང་བྱོན་ཡང་ཡོད།",
    "ཕ་བོང་གི་སྟེང་དུ་ལྷ་ཁང་ངམ་མཆོད་ཁང་འགའ་ཡོད་དོ།",
    "མགོས་ཀྱི་བློ་ཆེན་ཁྲི་བཟང་ཡབ་ལྷག་གིས།",
    "ཕྱི་རབས་བློན་པོ་གཡར་ཁྲལ་ཆུང་བར་བྱས་སྟག་བཙན་གདོང་གཟིགས་བློན་པོ་གཉེར་གྱི་བུས།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་དཔར་དུ་བསྐྲུན་པའི་དཔྱིད་ཀྱི་རྒྱལ་ཡར་རྒྱབ་པ་མོའི་གླུ་དབྱངས་ཀྱི་ཤོག་གྲངས་བརྒྱ་དང་དོན་བརྒྱད་ན།",
    "དེའི་སྲས་མོན་མོ།",
    "ཧོར་རྒྱལ་པོ་ནས་བཟུང་རྒྱ་ནག་གོང་མ་རིམ་བྱོན་གྱིས་བོད་ཀྱི་བླ་ཆེན་དག་ལ་གནང་བའི་གོ་གནས་སམ་མཚན་སྙན་ཞིག་ཡིན་གསུངསཤོག་གྲངས་༡༥ཐིག་ཕྲེང་ན་གོང་མ་གྲགས་པ་རྒྱལ་མཚན་ཞེས་པ་ནི་ཕག་གྲུའི་རྒྱལ་རབས་ཀྱི་ནང་གི་གོང་མ་གྲགས་པ་རྒྱལ་མཚན་ཞེས་པ་དེ་ཡིན།",
    "དབུས་ན་སྔོ་ལ་དྭངས་པའི་མཚོ་མོ་འཁྱིལ་རི་མཐོ་ས་གཙང་ཁ་བ་ཅན་འདི་ཡི་མི་རྗེ་ལྷ་ཡིས་མཛད་པའི་ཚུལ་དེ་དྲན་མེད་ཐབས་མེད་པའི་བློན་པོ་བཞི་ཡི་གྲས་ཐོན་མི་ཨ་ནུ་ཞེས་པའི་བློན་པོ་དེའི།",
    "སྟོང་གསུམ་ཁྱོན་འདི་དེ་ཡི་སྣོད་དུ་ཆུང་།",
    "ཞོགས་ཀ་ཞེས་པ་ནི་ནངས་སྔ་མོའི་དུས།",
    "ཟ་ཟེད་ཅེས་པ་ནི་འདུ་འཛི་ཟང་ཟིང་གི་དོན།",
    "ཤོག་གྲངས་༢ཐིག་ཕྲེངཡན་གུང་ལོ་ཆེན་མགོན་པོ་སྐྱབས་ཞེས་པ་ནི་སོག་པོའམ་ཧོར་གྱི་རིགས་ཡིན་ལ་གོང་མ་ཆན་ལུང་གི་བློན་པོ་ཞིག་ཡིན།",
    "ཞིབ་ཏུ་བསམ་བློ་བཏང་ན་སྐྱོན་ཆེན་པོ་མེད་ཀྱང་སྐྱོན་ཕྲ་མོ་ཞིག་ཡོད་གསུངས།",
    "རང་གི་ཀློག་ཚུལ་ཉེས་པ་ཡིན་ཏེ་རྒྱ་སྐད་ལ་ཡ་དང་ཇ་ཡང་ཤིན་ཏུ་སྒྲ་ཉེ་བས་ཡོ་གི་ལ་ཡང་ཛོ་གི་ཞེས་འབོད་པ་སོགས་ཡའི་ཚབ་ཏུ་ཇ་བྲིས་པ་ཤིན་ཏུ་མང་ལ་རང་རེས་ཛོ་གི་སོགས་ཐམས་ཅད་ཛ་ཡིག་བྲིས་པ་དེ་ཡིན་ནོ།",
    "གཞན་ཁྱེད་ཅག་གི་བློ་ངོར་ཆེས་འཐད་དཀའ་མོད།",
    "གསར་བ་ཅི་ཡང་མ་མཐོང་གི་ཙ་ལག་གམ་ཙ་རྟགས་སུ་གྲགས་པ་དེ་དག་གསར་དུ་བསྣན་པའི་ཡི་གེ་དག་ལ་རྟགས་བཏབ་པ་ཡིན་ནོ།་",
    "ཁྱེད་ཐལ་མོ་བརྡབ་སྟེ་བརྡ་ཧབ་བགད་ཅི་ཙམ་འདོད་པར་བྱས་ནས་སླར་འདི་བསམ་པར་བྱ་སྟེ།",
    "དེར་མ་ཟད་དཔེ་རྙིང་འགའ་ལ་ཙ་ཚ་ཛ་འ་ཞོ་ཞེས་རྟགས་དངོས་སུ་བཏབ་པ་བཞིན་དུ་སྣང་སྟེ་མིག་གིས་མ་བལྟས་པར་བསྙོན་འདིངས་པའི་ལམ་དུ་མ་ཞུགས་ཤིག་ཅེས་པ་སོགས་སྐབས་འདིའི་དཔྱད་གཞིར་འོས་པས་ཚེགས་ལ་མ་བལྟས་པར་བྲིས་པ་ཡིནརྒྱས་པར་སྔོན་དང་ད་ལྟའི་བར་ཡུལ་སོ་སོའི་ཡིག་རིགས་ཞེས་པ་ལ་བལྟས་ཏེ་རྟོགས་པར་བྱའོ།",
    "བོད་ཡིག་གང་ལ་དཔེར་མཛད་པའི་ཕྱི་མོ་ནི་གུཔྟའི་ཡི་གེ་ཡིན་ཞེས་ཟེར་རོ།",
    "ཞེས་པའི་བར་ནི་ཁོང་གི་རང་ལུགས་ཡིན།",
    "ཡུལ་ལྕང་ར་སྨུག་པོ་ཞེས་བྱ་བ་ཞེས་པ་ནི་ཤིན་ཅང་གི་ལྷོ་ཕྱོགས་སར་ངོས་འཛིན་དགོས་གསུངས།",
    "ཁྱོད་ནི་སྔོན་གྱི་ཐབས་ལ་མཁས་པ་ལགས།",
    "བཀས་བཅད་ཀྱི་སྐབས་འགྱུར་ཕྱག་གཏན་ལ་ཕབས་པ་ནི་འོག་ཏུ་འགྱུར་ཕྱག་གི་སྐབས་སུ་འཆད་དོ།",
    "གླིང་གེ་སར་རྒྱལ་བོ་ནི་ཡོངས་གྲགས་ཀྱི་གླིང་གེ་སར་རྒྱལ་བོའམ་ཨ་མྱེས་འཛམ་གླིང་ཞེས་པ་དེ་ཡིན།",
    "ཡ་གྱལ་གྱི་མིང་ཚོགས་པ་ལ་ཐོགས་ཏེ་མེ་ཡོས་ལོ་ནས་མེ་སྟག་གི་བར་གྱི་ལོ་རྒན་དྲུག་ཅུ་ལ་རབ་བྱུང་གཅིག་ཟེར་བ་ཡིན་ཤོག་གྲངས་༣༧ ཐིག་ཕྲེང་༧ན།",
    "མཚན་མོ་མཁའ་ལ་རྒྱུ་བ་མ་མཐོང་ནས།",
    "གནས་བརྒྱད་ཆེན་མོ་རྩ་འགྲེལ་ཞེས་པ་ནི།",
    "ཚིག་གི་བར་གྱི་རྣམ་དབྱེ་རྣམས་བསྡུས་ནས་མིང་སྔ་ཕྱི་ལྷན་ཅིག་ཏུ་སྦྱོར་བར་བྱེད་པ་ནི།",
    "མིང་ཚིག་གི་བར་གྱི་རྣམ་དབྱེ་གཉིས་པ་ལ་སོགས་པའི་རྣམ་དབྱེ་དྲུག་པོ་གང་རུང་བསྡུ་བ་ལ།",
    "འབྲུ་མང་གི་བསྡུ་བ་ཞེས་བྱ་ཞིང་།",
    "ཚིག་སྡུད་གང་གི་སྔ་མར་མི་ཟད་པའི་རྟགས་ཀྱི་བརྗོད་བྱ་གཙོ་བོར་སྟོན་པའི་བསྡུ་བ་ལ་མི་ཟད་པའི་བསྡུ་བའམ་གྲངས་མེད་པའི་བསྡུ་བ་ཞེས་བྱའོ།",
    "འབའ་ཛཱ་པཱ་ཎི་རྣམས་སུ་བཀླག་གོམིང་གི་དབུས་དང་མཐའ་མར་བྱུང་ན་བོད་ཀྱི་གདངས་དང་མཚུངས་པར།",
    "དེ་ཡང་རང་གི་བྱུང་བ་བརྗོད་པ་བདེན་གཏམ་རྣ་བའི་བདུད་རྩི་ལས་རང་ལོ་རེ་གཅིག་གི་ལོ་མཇུག་ཏུ་སེམས་ཀྱི་ཉམས་སྣང་སྐྱིད་དེ་བར་ཡོད་པའི་མཚན་དགུང་འགར་གཉིད་མི་ཁུགས་པའི་གོ་སྐབས་ལ་བརྟེན་ཀ་ཁ་སུམ་ཅུ་ཚང་བའི་ཚིགས་བཅད་འགའ་སྔས་ལ་མགོ་བཞག་ནས་བློ་ཐོག་ཏུ་བསྒྲིགས་པ་འདི་ལྟར།",
    "ཆིགས་༡༢བཅད་འདི་ནི་ཐོན་མིའི་ཞལ་ལུང་གི་ཤོག་གྲངས་བརྒྱ་དང་ལྔའི་ཐོག་ཏུ་བཀོད་ཡོད།",
    "རྐང་བ་གཅིག་གིས་དམན་པའི་ཞེས་པ་ནི་རྩིས་ཀྱི་ནང་གི་ཐ་སྙད་ཅིག་ཡིན།",
    "དེད་དཔོན་སིང་ག་ལ་ཞེས་པ་གནས་དེར་སོང་ནས་གཞི་ཆགས་པས་དེའི་མིང་ལ་སིང་ག་ལ་བཏགས་པ་ཡིན་གསུངས།",
    "བསྟན་བཅོས་གསར་རྩོམ་གྱི་མཚན་ལ་སྙན་ངག་གི་ཚིག་རྒྱན་དང་འབྲེལ་བའི་མིང་འདོགས་ཚུལ་ནི།",
    "ཨ་ག་རུའི་མིང་གི་རྣམ་གྲངས་ཤིམ་ཤ་བ་ཞེས་པའི་ཤིམ་གྱི་ཀླད་ཀོར་ང་ཡིག་ཏུ་ཀློག་པ།",
    "ཏུ་རུ་ཆ་ཞེས་པ་གར་ལོག་གི་སྐད་དོད་ཡིན་པ་མ་ཤེས་པར།",
    "ཨ་ན་ན་དང་རོ་རུ་སོང་ཞེས་པ་དང་།",
    "བོད་ཡིག་གི་སྟེང་ནས་ལེགས་སྦྱར་གྱི་གདངས་དངོས་གནས་པ་ཟོན་ཐུབ་པ་ཞེས་པའི་སྐབས།",
    "ཨ་མི་ཏཱ་བྷ་ནི་འོད་དཔག་མེད།",
    "བོད་ཀྱི་བསྟན་བཅོས་རྣམས་ཀྱི་གཞིར་གྱུར་པའི་ཕྱིར་ཞེས་པ་ནི་ཚད་ལས་བརྒལ་དྲགས་སོང་གསུངས།",
    "གླིང་བ་ཞིབ་མོ་རྣམ་འཐག་གི་སྒོ་ནས་འགོག་པ་ཡིན་ཙན་ཞེས་པ་ནི།",
    "ཁྱིམ་ཞག་རེ་ལྔ་དང་ཚེས་ཞག་རེ་བདུན་གཉིས་མཉམ་པ་ཡིན།",
    "དེ་དག་གི་དུས་ལོངས་དང་ཡུལ་ལོངས་ནི་སོ་སོའི་ཐད་ལ་ལྟོས་༣ ཉིན་ཞག་ཉི་མས་སའི་གླིང་ལ་བྱ་བ་བྱེད་ཚུལ་གྱིས་འཇོག་པས་ནམ་ལངས་ནས་ནམ་ལངས་བའི་བར་དབུགས་ཁུག་པ་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་སྟེ་ཆུ་ཚོད་དྲུག་ཅུ་ཐམ་པའམ་དེང་སྐབས་ཀྱི་དུས་ཚོད་ཉེར་བཞི་ལ་ཉིན་ཞག་ཕྲུགས་གཅིག་ཅེས་བརྗོད་ཉི་མ་ཉིན་ཞག་གཅིག་ཡུལ་གྱི་ཆུ་ཚོད་བཞི་དང་ཆུ་སྲང་ཉེར་དྲུག་རི་རོའི་ཆ་ཞེ་གཅིག་ལ་འཁོར་ལོ་ལག་མིག་གི་ཆ་ཆིག་སྟོང་བརྒྱད་བརྒྱ་ཞེ་དགུ་སྤྱོད་དོ།",
    "འགྲིབ་ཆ་བཅོ་ལྔའི་ཆ་རེ་འགྲིབ་པའམ་འཕེལ་བའི་ཡུན་ཚད་ལ་བརྗོད།",
    "ཚེས་ཞག་གཅིག་གི་དུས་ཀྱི་རྟག་ལོངས་ནི།",
    "དང་ཆུ་ཚོད་སོ་གཅིག་ཆུ་སྲང་ལྔ་བཅུ་རི་རོའི་ཆ་ཞེ་ལྔ་རི་མཁའ་རིའི་ཆ་སུམ་བརྒྱ་ཞེ་ལྔ་རེ་ཡིན་༧ ཁྱིམ་ཟླ།",
    "གཟའི་རང་འཁོར་ཆུ་ཚོད་ཉེར་བཞི་སོང་ཟིན་པའི་འཕྲོ་ན་གཟའ་གནས་སུ་གཉིས་དང་།",
    "ཧོར་ཇིང་གར་གྱི་རྒྱལ་བོས་མི་ཉག་གི་ལག་ནས་རྒྱལ་ས་ཐོབ་པའི་ཟླ་བར་བཀྲ་ཤིས་པའི་དགའ་སྟོན་བྱས་པ་མཆུ་ཟླ་ལོ་གསར་དུ་བཟུང་བ་དཀྱུས་སུ་ཤོར་བས།",
    "ཁྱིམ་ལོ་གཅིག་ལ་ཁྱིམ་ཞག་གསུམ་བརྒྱ་དང་དྲུག་ཅུ་ཐམ་ཉིན་ཞག་སུམ་བརྒྱ་དྲུག་ཅུ་རེ་ལྔ་དང་མིག་ཀླུ་མེ་སྐྱོན་གྱི་ཆ་༤༩༧༥།",
    "རང་གི་རྩིས་གཞིའི་ཉིན་ཞག་སུམ་ཅུ་ལ་ཉིན་ཟླ།",
    "སྐབས་འདིར་འདི་དག་གི་དོན་ཅུང་ཤེས་ན་ཕན་སླེབས་ཆེ་སྙམ་སྟེ་ཚེགས་ལ་མ་བལྟས་པར་བྲིས་པ་ཡིན་ནོ་ཤོག་གྲངས་༥༦ཐིག་ཕྲེང་༡༨ན།",
    "མཁས་མིན་མཁས་རློམ་ཞིག་གིས་བསྟན་བཅོས་རེ་བརྩམས་ཏེ་མཇུག་ཏུ་དཔལ་ལྡན་ཟླ་བ་གྲགས་པས་བརྩམས་ཟེར་བ་ལྟ་བུའི་སྲོལ་ཡོད།",
    "གླང་དར་མས་བསྟན་པ་བསྣུབས་རྗེས་གསང་སྔགས་ཉམས་སུ་ལེན་པར་རློམ་པའི་སྤྱོད་པ་རྩིང་བོ་ཅན་འགའ་རེས་ཆང་འཐུངས་ཏེ་བཟི་རྗེས་ཁོས་རྒྱུད་རྩོམ་རྒྱུ་ཡིན་ཟེར་ཏེ་ཕོད་ཚོད་ཀྱིས་རྒྱུད་རྩོམ་པའི་སྲོལ་ཡོད།",
    "སྐད་རིགས་ཐམས་ཅད་ཤེས་ན་བཟང་མོད་ཀྱང་།",
    "རང་གི་ཕ་སྐད་བརྗེད་ན་ངོ་ཚ་ཡིན།",
    "འགྱུར་ཕྱག་གི་སྐབས།",
    "ཁོང་གིས་ཀརྨ་སི་ཏུ་དང་སི་ཏུའི་ཞལ་ལུང་གི་རྗེས་སུ་འབྲངས་ཏེ་བརྩམས་ཡོད་པས།་",
    "ཐོན་མིའི་ཞལ་ལུང་ནི་ཚ་ཐམས་ཅད་ནས་སི་ཏུ་དང་སི་ཏུའི་ཞལ་ལུང་གི་རྗེས་སུ་འབྲངས་མེད་པས་ན་ལ་གཉིས་དེ་ཉིད་ལ་འཇུག་པར་འདོད་པ་ཡིན།",
