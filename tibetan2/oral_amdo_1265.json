    "ལེགས་སོ་དུར་ཁྲོད་བདག་པོ་ཁྱོད།",
    "ལུས་འོད་ཀྱི་གོང་བུར་གྱུར་པའི་མོས་པ་མཛོད།",
    "ཨ་ཙནྡྲ་མཎྜ་ལ་པད་ཉི་ཟླ་བའི་གདན་གཉིས་ཀྱི་སྟེང་དུ་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཀྱི་ངོ་བོ་ཧཱུྃ་དང་ཨྃ་ལས་དུང་དང་མགྲོན་བུ་ཧཱུྃ་དང་ཨྃ་གིས་མཚན་པ་སོགས་གཏོར་ཆོག་ལྟར་བསྐྱེད།",
    "གུ་གུལ་གྱིས་བདུག་དྲིལ་བུ་སོགས་རོལ་མོ་བྱ།",
    "ནུས་མཐུ་མ་ལུས་པ་ཞུགས་པའི་མོས་པ་མཛོད།",
    "གསུང་གི་རྗེས་སུ་གནང་བའི་དོན་དུ་དམིགས་པ་འདི་བཞིན་དུ་མཛོད།",
    "སྔགས་དང་རོལ་མོ་བདུག་པ་རྣམས་གོང་བཞིན་བྱ།",
    "དེ་ནས་བཟླས་པའི་ལུང་གི་དོན་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "གསུམ་པས་བརྟན་པར་བྱས་པའི་མོས་པ་མཛད་ནས།",
    "དེ་རྣམས་ཀྱིས་གསུང་གི་རྗེས་། གནང་ཐོབ་པས།",
    "གནས་སྐབས་སུ་གསུང་གི་བར་ཆད་ཐམས་ཅད་ཞི་ཞིང་།",
    "སྔགས་དང་རོལ་མོ་བདུག་པ་སོགས་འདྲ།",
    "ཉིན་མོ་ཡིན་ན་སྤོས་རེངས་བཙུགས།",
    "གཞན་རྣམས་ཀྱིས་རོལ་མོ་བདུག་པ་གོང་བཞིན་བྱ།",
    "དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་ལྷ་ཚོགས་རྣམས་ཀྱི་བཀའ་དང་དམ་ལས་མ་འདའ་བར།",
    "རོལ་མོ་བདུག་པ་གོང་བཞིན་བྱ།",
    "དུར་ཁྲོད་ཀྱི་བདག་པོ་ཡབ་ཡུམ་གྱི་སྐུ་གསུང་ཐུགས་མི་འབྲལ་ཞིང་དབྱེར་མེད་དུ་བྱིན་གྱིས་བརླབས་པའི་མོས་པ་མཛོད།",
    "དེ་རྣམས་ཀྱི་སྒོ་ནས་རྗེས་སུ་གནང་བ་ཟབ་མོ་ཐོབ་པས་དེ་དག་གི་གནས་སྐབས་སུ་ཁས་བླངས་པའི་དམ་ཚིག་དང་སྡོམ་པ་ལ་སྲུང་སྡོམ་ཚུལ་བཞིན་དུ་བགྱིའོ་སྙམ་པས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཨོཾ་སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་ཧཱུྃ།",
    "བདུད་ནག་ཕོ་མོ་བྱི་ཆིངས་སུ་བསྣོལ་བའི་གདན་གྱི་སྟེང་དུ།",
    "རང་གི་རྣམ་པར་ཤེས་པས་ས་བོན་གྱི་ཡིག་འབྲུ་ཧྲཱི་དམར་པོ་དང་།",
    "ཚུར་འདུས་ཡིག་འབྲུ་ལ་ཐིམ་པས་པདྨ་དམར་པོ་དང་བྷནྡྷ་ཁྲག་གིས་གང་བའི་རྣམ་པར་གྱུར།",
    "ཞལ་རེ་རེ་ལ་དམར་ལ་ཟླུམ་པའི་སྤྱན་གསུམ་དང་ལྡན་པ་ཞལ་བགྲད་ཅིང་མཆེ་བ་གཙིགས་པ།",
    "གཡོན་གྱི་དང་པོ་བྷནྡྷ་ཁྲག་གིས་གང་བ་བསྣམས་པས་ཡུམ་ལ་འཁྱུད་པ།",
    "རཀྟའི་ཐིག་ལེ་ཞག་གི་ཟོ་རིས།",
    "ཐལ་ཆེན་གྱི་ཚོམ་བུ་བཀོད་པ།",
    "མཧཱ་པཉྩ་ཨ་མྲྀ་ཏ་ཁཱ་ཧྲཱི།",
    "རང་གི་སྤྱི་བོར་ཧཱུྃ་སྔོན་པོ་ལས་བཛྲ་ཧེ་རུ་ཀ་སྔོན་པོ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པ།",
    "ཨོཾ་བུདྡྷ་ཧེ་རུ་ཀ་ཨ་བྷི་ཥིཉྩ་ཨོཾ།",
    "མཚོག་མར་ཨོཾ་དཀར་པོ་ལས་བུདྡྷ་ཧེ་རུ་ཀ་དཀར་པོ་འཁོར་ལོ་དང་དྲིལ་བུ་འཛིན་པ།",
    "དེ་ལྔ་གའང་ཐོད་སྐམ་གྱི་ཁང་བུ་རེ་རེར་བཞུགས་པས་དབུ་བརྒྱན་པར་བསམ།",
    "སྔགས་ཀྱི་རྗེས་སུ་མཧཱ་སརྦ་ཨ་མྲྀ་ཏ་ཁཱ་ཧྲཱི།",
    "རྒྱུད་དྲུག་ཉོན་མོངས་ཞེ་སྡང་འཇོམས་མཛད་པ།",
    "རྒྱུད་དྲུག་ལས་དང་ཉོན་མོངས་འཇོམས་མཛད་མ།",
    "རང་གི་ལྟེ་བ་ནས་འོད་དམར་ཞིང་གསལ་བ་སྒྲོན་མེ་བཏེག་པ་ལྟ་བུ་བདེ་བའི་རང་བཞིན་དམར་ཁྱུག་གིས་བྱུང་བས་ལུས་ཀྱི་ནང་ཐམས་ཅད་མེར་གྱིས་གང་།",
    "རང་ཉིད་ལྷའི་སྐུ་ཡབ་ཡུམ་ཞལ་སྦྱོར་སྤྱན་གྱི་དཀར་ནག་མ་འདྲེས་པར་མེ་དཔུང་གི་དབུས་ན་གསལ་སེང་ངེ་བཞུགས་པ།",
    "རྒྱས་པར་ལྷ་ཁྲིད་སེམས་བཟུང་གི་ཤོག་ས་ཟུང་འཇུག་གི་ཤོག་དྲིལ།",
    "དེའི་བོགས་འདོན་དུག་ལྔ་ལམ་སློང་གི་ཤོལ་དྲིལ།",
    "རང་གི་ཐུགས་ཀར་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་ཁ་གྱེན་དུ་བྱེ་བའི་ལྟེ་བར་ཧྲཱི་འདབ་མ་བརྒྱད་ལ་མདུན་ནས་བརྩམས་ཏེ་གཡས་སྐོར་གྱིས་སྔགས་ཕྲེང་ཁ་དོག་དམར་ནག་ཡིག་འབྲུ་གྱེན་དུ་ལངས་པས་བསྐོར་བར་བསམ།",
    "བྱེ་བྲག་ཏུ་དགྲ་བགེགས་ལོག་པར་འདྲེན་པ་རྣམས་ལ་འོད་ཟེར་ཕོག་པའི་མོད་ལ་ཚར་བཅད།",
    "ཡུམ་གྱི་ཐུགས་ཀར་པདྨའི་ལྟེ་བར་མ་ཡིག་འདབ་མ་ལ་སྔགས་ཕྲེང་གིས་བསྐོར་བ་ལས་འོད་ཟེར་སྤྲོ་བསྡུ་གོང་བཞིན་བྱས་ལ།",
    "མཆོག་གི་དངོས་གྲུབ་ཡེ་ཤེས་དབྱིག།",
    "ཨོཾ་པདྨནྟ་ཀྲྀ་ཏ་པདྨེ་ཤྭ་ར་མཧཱ་ཀྲོ་དྷ་ཧ་ཡ་གྲི་བ་མི་མ་ཏྲག་མོ་དུནྟི་ཧྲཱིཾ་ཧྲཱིཾ་ཧྲཱིཾ་ཛ་ཞེས་པ་ཉེར་གཅིག་ཙམ་དང་།",
    "དེ་ལྟར་ཉམས་སུ་ལེན་པའི་ཚེ་བར་ཆད་ཀྱི་རྣམ་པ་ཅི་བྱུང་ཡང་སྔགས་ཀྱི་ངར་བཏགས་ཏེ་ཚར་གཅོད་པ་ནི་རང་གི་ཐུགས་ཀའི་ཧྲཱི་ལས་ཁྲོ་ཆུང་དམར་ནག་ཁྲོ་ཞིང་རྔམས་པ་གྲངས་མེད་པ་དང་།",
    "སྔར་གྱི་སྤྲོས་པ་རྣམས་ཚུར་འདུས་རང་གི་མཐའ་སྐོར་དུ་ཁྲོ་བོའི་གུར་ཁང་སྔགས་ཀྱི་ང་རོ་འབྲུག་ལྟར་ལྡིར་བ།",
    "དེའི་ཕྱིར་མེ་དཔུང་གི་གུར་ཁང་གསལ་བཏབ།",
    "མེ་སྟག་ཆུ་ནང་ཤོར་བ་ལྟར་རྗེས་མེད་དུ་སོང་བར་བསམས་ལ།",
    "ཅེས་པ་བདེ་གཤེགས་གཅིག་དྲིལ་གྱི་སྔགས་ཟབ་མོ་རྣམས་ཐུན་མཚམས་སུ་བརྒྱ་རྩའམ་ཉེར་གཅིག་ཡན་བཟླ་བར་བྱའོ།",
    "བ་མོ་དྷ་ཡ་ཧྲཱི་གབ།",
    "ཡབ་ཧྲཱི་ཡིག་གི་བར་དུ་བསྡུས།",
    "ཧྲཱི་ཡིག་གི་གུའི་བར་བསྡུས།",
    "དེ་ཡང་ནམ་མཁའ་ལ་འཇའ་ཡལ་བ་ལྟར་རིག་སྟོང་གི་ངང་དུ་མཉམ་པར་བཞག་ནས།",
    "མཐར་ལྡང་བར་འདོད་པས་དེའི་ངང་ལས་རང་ཉིད་སྐད་ཅིག་གིས་དཔལ་གྱི་སྐུར་ལངས་པར་བསམས་ལ།",
    "ཞག་རེ་ལ་ཐུན་བཞིར་བཅད་ནས་ཉམས་སུ་བླང་།",
    "རང་གི་སློབ་བུ་བློ་དམན་པ་དག་ལ་ཕན་པའི་བསམ་པས་ཀུན་ནས་བསླངས་ཏེ།",
    "ན་མོ་གུ་རུ་ཧ་ཡ་གྲཱི་བཱ་ཡ།",
