    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "ཁྱོད་ཀྱིས་བརྩོན་པས་མཆོད་ནུས་སམ།",
    "སྣོད་དང་ལྡན་པའི་བུ་ཁྱོད་ཀྱིས།",
    "ཁྱོད་ཀྱི་སྤྲོ་བས་བརྩོན་པས་མཆོད།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "ཡང་སྣོད་གཅིག་ཏུ་ལྕམ་སྲིང་གི་གཏོར་མ་ཟུར་གསུམ་ཆེ་བ་གཅིག་གི་གཡོན་དུ་ཟུར་གསུམ་ཆུང་བ་གཅིག་བསླན་ལ་ཅིག་ཤོས་ལས་རྩེ་ཅུང་ཟད་དམའ་བ།",
    "ཡོད་ན་ལྕམ་སྲིང་གི་ཙ་ཀ་ལི་ཡང་བཙུགས།",
    "མཧཱ་པདྨེ་ཤྭ་ར་ས་པ་རི་ཝཱ་ར་མཧཱ་སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་ཁཱ་ཧྲཱི་ས་ནང་མཆོད་འབུལ།",
    "སྟོང་པའི་ངང་ལས་ཡི་དམ་གྱི་མདུན་ངོས་ཀྱི་འོག་ཕྱོགས་སུ་རྟ་ཁྲག་དང་མི་ཁྲག་གི་རྒྱ་མཚོ་དམར་ལ་དྭངས་པ་རྦ་ཀློང་གྲུ་གསུམ་བསྣོལ་མར་འཁྲུགས་པའི་ཀློང་དཀྱིལ་དུ་པདྨ་དང་ཉི་མའི་གདན་ལ་རྟ་རོ་དང་མི་རོ་བརྩེགས་པའི་སྟེང་དུ།",
    "དྲེད་མོ་ནག་མོ་མི་ཟན་ལ་ཞོན་ནས་སྟོང་གསུམ་སྐད་ཅིག་ལ་ཉུལ་བ།",
    "རང་གི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་འཕྲོས་པས།",
    "བསེ་མཁར་སྨུག་པོ་དུང་གི་བ་གམ་ཅན།",
    "བོད་ཡུལ་མ་མོའི་སྟོང་དཔོན།",
    "ཡབ་གནོད་སྦྱིན་ཟངས་ཀྱི་རལ་པ་ཅན་དང་ཡུམ་སྲིན་མོ་ཁྲག་གི་རལ་པ་ཅན་གྱི་སྲས་གནོད་སྦྱིན་ཟངས་ཀྱི་བེག་རྩེ་ཅན།",
    "སྲིང་མོ་སྲིད་པའི་ལྷ་མོ་གདོང་དམར་མོ་འཁོར་དང་བཅས་པ་རྣམས་ལ་འབུལ་བ་ཡིན་པས།",
    "ཤཱཀ་ཐུབ་འཇིག་རྟེན་དུ་འབྱོན་པ་ཙམ་གྱི་དུས་སུ་འཛམ་བུ་གླིང་གི་བྱང་ཤར་དུར་ཁྲོད་མ་རུ་ཙེ་ཞེས་པ་འཇིགས་ཤིང་ཡ་ང་བའི་གནས་དེར།",
    "སྲིན་མོ་ཁྲག་གི་རལ་པ་ཅན་གཉིས་བཤོས་པ་ལས་ཟངས་ཀྱི་སྒོ་ང་གཅིག་དང་།",
    "མཆོང་གི་སྒོ་ང་གཅིག་སྐྱེས།",
    "ལྕམ་སྲིང་འདི་དང་གནོད་སྦྱིན་ཤུ་ཀྲ་ནག་པོ་གཉིས་ལ་དཔལ་མགོན་གདོང་བཞི་པའི་ལས་མཁན་ཤན་པ་དམར་ནག་ཅེས་མངའ་གསོལ་བའི་དམར་པོ་ལྕམ་སྲིང་གི་རྗེས་གནང་གདམས་པའི་སྐོར་རྣམས་གཉན་ལོ་ནས།",
    "གྲུབ་ཐོབ་ཆེན་པོས་ལི་ཡུལ་ལྕང་ར་སྨུག་བོ་ནས་སློབ་དཔོན་ཆེན་པོ་པདྨའི་ཕྱག་བཟོ་བསེ་ལས་གྲུབ་པའི་ལྕམ་སྲིང་གི་འཆམས་སྐུ་རྫུ་འཕྲུལ་གྱིས་གདན་དྲངས་ཏེ་བྲག་རམ་གྱི་གཙུག་ལག་ཁང་དུ་བཞུགས་སུ་གསོལ།",
    "འཁོར་མང་གི་ཐབས་། རྗེས་སུ་གནང་བའི་བཀའ་སྲོལ་གཉིས་ལས།",
    "འདིར་ལྕམ་སྲིང་གི་རྗེས་གནང་སྒྲུབ་པར་བྱེད་པ་ལ་སློབ་དཔོན་གྱིས་བགྱི་འོས་རྣམས་གྲུབ་ནས།",
    "ཁྱེད་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་ཐོག་མར་རྗེས་གནང་ཟབ་མོ་ཞུ་བའི་ཡོན་དུ་དམིགས་ཏེ་མཎྜལ་འབུལ་དུ་གཞུག་གང་གི་དྲིན་གྱིས་ནས།",
    "རྗེས་གནང་གི་གཞི་ལུས་བསྒྲུབ་པའི་སླད་དུ་ཐུགས་འདུན་དམིགས་པ་འདི་བཞིན་མཛད་པར་ཞུ།",
    "རྣམ་སྨིན་གདོས་བཅས་ཤ་ཁྲག་གི་ཕུང་པོ་འདི་ཡང་འོད་གསལ་གྱི་ངང་དུ་གཙང་སིང་སྦྱངས་ཏེ།",
    "ཞལ་རེ་རེ་ལ་སྤྱན་གསུམ་གསུམ་དང་ལྡན་པ།",
    "ཞག་གི་ཟོ་རིས།",
    "ཐལ་ཆེན་གྱི་ཚོམ་བུ་ཅན།",
    "གཡོན་དུང་ཆེན་དམར་འཁྱིལ་གཙོ་བོ་ལ་སྟོབ་པའི་སྐུ་ཅན་རེར་གསལ་ལམ་སྟེ་གྱུར་པའི་མོས་པ་གནང་བར་ཞུ།",
    "དེ་ཡང་མདུན་གྱི་གནས་འདི་ཉིད་དུ་རྟ་ཁྲག་དང་མི་ཁྲག་གི་རྒྱ་མཚོ་དམར་ལ་དྭངས་བ་ཞེས་པ་ནས།",
    "བཀའ་ཉན་དམ་ཅན་རྒྱ་མཚོས་བསྐོར་བ་མངོན་སུམ་ལྟ་བུར་བཞུགས་པའི་ཐུགས་མོས་གནང་མ་། བ་དང་།",
    "གུ་གུལ་གྱི་དུད་པ་དང་རོལ་ཆེན་བྱས་ལ་ལྕམ་སྲིང་གི་སྲོག་སྔགས་བརྗོད།",
    "བྲག་རམ་བཀའ་བཞི་ཆེན་མོ།",
    "འདི་ཡི་བྲན་གཡོག་བཀའ་སྡོད་གྱིས་ལ་ཅི་བཅོལ་བའི་ལས་རྣམས་སྒྲུབས་ཞེས་བརྗོད་ལ་གཏོར་མ་སྔར་གྱི་སྟེགས་ཀྱི་སྟེང་དུ་བཞག་ཡང་སློབ་དཔོན་གྱིས་ལྕམ་སྲིང་གི་སྲོག་སྔགས་ཚར་གཅིག་བརྗོད་པ་དེས་རྐྱེན་བྱས།",
    "ཕྱག་བཞེས་ཇི་ལྟར་མཛད་པ་ལ་གཞི་བརྟེན་ནས་རང་དང་སྐལ་བ་མཉམ་པ་རྣམས་ལ་ཕན་པའི་དོན་དུ་ས་མོ་ལུག་ལོ་དབྱར་དུས་ཟླ་བ་དྲུག་པའི་ཡར་ངོའི་ཚེས་བཅུའི་ཉིན་བུལ་རོང་དབེན་པའི་རི་ཁྲོད་དུ་ལེགས་པར་སྦྱར་བའོ།",
    "རང་གི་བརྒྱུད་པའི་ལུགས་མཆོག་གཙོར་བཟུང་ནས།",
    "སྐབས་༥ པའི་སྤྱི་འཐུས་ཚོགས་གཙོ་བཅས་ཀྱི་འགན་བཞེས་རྗེས་བོད་གཞུང་གི་དྲིལ་བསྒྲགས་དང་།",
    "བཀའ་བློན་ཁྲི་པའི་ཐུགས་འགན་མི་ལོ་༨ ལ་བཞེས་གནང་བ་སྟེ་གོང་ས་མཆོག་གིས་བསྐོ་གཞག་སྩལ་བའི་བཀའ་ཁྲི་མཐའ་མ་དེ་ཆགས་ཡོད།",
    "བོད་གཞུང་གི་རྩིས་དང་འབྲེལ་བའི་ཆེས་མཐོའི་ཞིབ་འཇུག་ཚོགས་ཆུང་གི་ཚོགས་གཙོ།",
    "རྒྱ་ནག་མན་ཇུའི་དམག་བོད་ནས་ཕྱིར་འབུད་བཏང་རྗེས།",
    "གོ་མིན་ཏང་གི་དམག་དང་།",
    "བྲེ་བོ་དཔོན་ཚང་གི་དོན་དུ་དམག་འཁྲུག་སྔ་རྗེས་བྱས་ཏེ།",
    "སོག་མོ་དབར་གྱི་རྩོད་རྙོག་སྐོར།",
    "སེ་ཆེན་ཧན་གུབ་ལེ་ཁང་གིས་འགྲོ་མགོན་འཕགས་པ་བློ་གྲོས་རྒྱལ་མཚན་དབུ་བླར་བཀུར་བའི་སྐོར།",
    "ང་ཚོའི་ཡུལ་དུ་ཡོད་པའི་རང་བྱུང་གི་མེ་ཏོག་འདྲ་མིན།",
    "རྒན་རབས་རྣམས་ཀྱིས་དུས་ངན་ཤར་བའི་རྟགས་མཚན་གླེང་རེས་བྱས་པ།",
    "ཨ་མ་ལགས་དང་མཉམ་དུ་བསྡད་སྐོར།",
    "ལུག་གི་ལོར་ཙྭ་འདྲ་གནས་སྐོར།",
    "འཇུ་ཆེན་གྱི་མ་རྒྱུད་ཕྱི་མ་རྫོགས་ཆེན་འབྲོག་རུ་སྲས་ཚ་ཚང་གི་ཉེ་རྒྱུད།",
    "༡༩༥༦ ལོར་རྒྱ་དམར་གྱི་ལུགས་ངན་ལས་འགུལ་ལ་ངོ་རྒོལ་གྱིས་རང་ཡུལ་དང་བྲལ་བ་ནས་མི་ཚེའི་རིང་གི་བྱུང་རིམ་ས་བོན།",
    "ང་ཚོ་མའི་སོར་གཞིས་ཆགས་སུ་ཕྱིན་པ་རྣམས་ཀྱི་གནས་ཚུལ་ཟུར་ཙམ།",
    "ཁོང་ཚོས་སྐྱོན་བརྗོད་བྱས་པ་རྣམས་ཀྱི་ཚིག་ཐོ་སྙན་འབུལ་དགོས་སྐོར་གོང་ས་མཆོག་གི་བཀའ་ཕེབས་ལྟར་ཕུལ་བ།",
    "བོད་རྒྱ་ཞི་མོལ་ཡོང་ཐབས་སྐོར།",
    "བོད་རྒྱ་ཞི་མོལ་གནང་ཕྱོགས་ཀྱི་རིམ་པ་དང་།",
    "ཞི་མོལ་གནང་གཞི་ཇི་ལྟར་ཡིན་མིན་སྐོར།",
    "ཞི་མོལ་གནང་མཁན་གྱི་ཚོགས་མི་ཇི་ལྟར་ཡིན་མིན་ལན་གསལ་དགོས་སྐོར།",
    "ལོ་ངོ་བཅུ་སོང་མཚམས་བོད་རྒྱ་འབྲེལ་ལམ་གསར་དུ་འགོ་ཚུགས་པའི་རྣམ་པ་ཡོངས་ཁྱབ་ཏུ་གསལ་བར་བསྒྲགས་པ།",
    "གཏན་གྲོགས་དབྱངས་ཅན་ལྷ་མོའི་ཡབ་ཚང་མདུན་ཧོ་ཆོ་ཚང་།",
    "འཛམ་གླིང་ཞི་བདེའི་དེད་དཔོན་ཆེན་པོ་སྐྱབས་མགོན་རྒྱལ་བ་ཐམས་ཅད་མཁྱེན་གཟིགས་སྐུ་ཕྲེང་༡༤ པ་ཆེན་པོ་མཆོག་གི་མདུན་སར་ངོ་བཅར་ཞུས་ཏེ།",
    "གང་ཅིའི་སྐོར་སྙན་གསོལ་ཞུས་མོལ་དང་འབྲེལ་བའི་སྐབས།",
    "བྱུང་རང་གི་མི་ཚེའི་ནང་མིག་མཐོང་ལག་ཟིན་རྣམས་ཡིག་ལམ་དུ་འགོད་འོས་པ་སྙམ་གཤིས།",
    "དེ་ལའང་རྒྱ་དམར་བོད་དུ་མ་ཡོང་གོང་གི་བོད་རྒྱལ་ཁབ་དང་།",
    "རྒྱ་ནག་དམར་པོའི་གཞུང་གིས་བོད་ཡོངས་ལ་དྲག་པོའི་དཔུང་འཇུག་རིམ་པར་བྱས་པའི་སྐོར་རང་གིས་ཤེས་ཚོད་འབྲི་དགོས་པ་རང་བཞིན་དུ་ཆགས་ཀྱི་ཡོད།",
    "གྲོ་མོ་བར་ཉེན་གཡོལ་དུ་གདན་ཞུ་བྱས་པའི་སྐོར།",
    "ཕྱི་བར་གསུམ་གྱི་སྐོར་རོབ་ཙམ་རེ།",
    "གཞིས་ཆགས་བྱ་ཡུལ་དུ་འབྱོར་སྐབས་རང་འགུལ་གྱིས་ལས་གཞིའི་བཀོད་སྒྲིག་ལྟར་གཞིས་སྒར་གཉིས་པའི་བཅུ་དཔོན་ཞིག་གི་གྲས་སུ་འཇོར་དང་སྦུག་མ།",
    "རང་བཙན་ཚོགས་ཆུང་གི་ཚོགས་གཙོ་སོགས་མའི་སོར་གཞིས་ཆགས་ཁག་གི་གནས་སྟངས་སྐོར།",
    "གཅིག་སྒྲིལ་ཚོགས་པ་འབྲེལ་བའི་དོགས་གཞི་ལས་འབྲུག་གཞུང་གིས་བོད་མིར་མུ་མཐུད་དཀའ་ངལ་ཆེད་བཟོ་བྱས་སྐོར་དང་།",
    "རྒྱ་ནག་ཏུ་ཚོགས་མི་ལྔ་ལས་གྲུབ་པའི་གཟིགས་སྐོར་སྐུ་ཚབ་ཚོགས་པ་ཐེངས་དང་པོ་ཆེད་བཏང་གནང་བའི་འགན་འཛིན་གྱི་ལས་འགན་བསྐུར་བའི་སྐོར་དང་།",
    "ཡང་ཕྱི་ལོ་༡༩༨ ལོར་བོད་ནང་ཚོགས་མི་ལྔ་ལས་གྲུབ་པའི་གཞོན་ནུ་ལྟ་སྐོར་ཚོགས་པ་ཆེད་བཏང་གནང་བ་དང་།"
  ]
}