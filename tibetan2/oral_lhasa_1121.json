    "གནང་སྦྱིན་ཟབ་རྒྱས་དང་།",
    "རི་ཁྲོད་མ་རྣམས་ཀྱི་རྗེས་གནང་ཕུལ།",
    "ནས་འདི་གཏོར་ལ་བགེགས་བསྐྲད་ཅིག་གྱིས་ཤིག་ཞེས་བསླབ་པ་ཁོས་ཀྱང་དེ་ལྟར་བྱས་ནས།",
    "གུར་གྱི་མགོན་པོ་ཁྲོ་བོ་བཅུ་དང་བཅས་པའི་རྗེས་གནང་།",
    "ཁྲོ་བོ་གཙུག་ཏོར་འབར་བ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་ཕྱག་གཉིས་པའི་རྗེས་གནང་།",
    "བསྲུང་བཟློག་ཁྱད་པར་ཅན་རྣམས་ཀྱི་ལུང་།",
    "ལྷ་སྐྱབས་ཚང་དུ་འབོད་པར་ཕྱིན།",
    "སེང་གདོང་དང་གཤེད་དམར་རྗེས་གནང་བྱས།",
    "བྱང་ཆོག་དང་གཤིན་རྗེ་གཤེད་དམར་རྗེས་གནང་ཕུལ།",
    "ལམ་དུ་དགེ་སློང་བློ་གྲོས་རྒྱ་མཚོ་ལ་ནཱ་རོ་མཁའ་སྤྱོད་བྱས་ནས།",
    "མགོན་པོ་ཁྲོ་བོ་བཅུ་དང་བཅས་པའི་རྗེས་གནང་བྱས་མཐར་རྡོ་རྗེ་འཇིགས་བྱེད་ཞི་བའི་སྲེག་བླུགས་ཚར་ལྔ་བླུགས་པ་སོགས་ཐུགས་བཞེད་བསྐངས་ནས་ལྷུན་གྲུབ་སྟེང་དུ་སླེབས།",
    "དགུན་ཀ་འདིར་ཀརྨའི་ལྷ་དགའ་སྤུན་གྱིས་ཚོན་མདངས་བཅད་སོགས་རྫོགས་པར་འདྲི་བར་ཆེད་བྱས་པས།",
    "སྐུ་དབོན་རིན་ཆེན་མཆོག་གྲུབ་ནས་རྡོ་རྗེ་འཆང་ཀུན་དགའ་བཟང་པོའི་བཀའ་འབུམ་གྱི་ལུང་གནང་བ་ནས།",
    "ཉེར་དགུ་ལ་ལྕགས་རར་དཔོན་སྲུང་ལུ་པ་འཚོ་དུས་ལས་བསྐལ་པར་འདའ་ཀ་མའི་གདམས་པ་གསལ་འདེབས་དང་ཀུན་རིག་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་ཕྱིར་བཟློག་བཅས་བགྱིས།",
    "ངེས་པར་བཀྲུ་བཞིན་ལྷ་དེའི་སྐལ་བས་ཐོབ།",
    "བསྟན་པའི་སྦྱིན་བདག་ཆེན་པོ་ཆབ་འབངས་སུ་བཅས་པས་ཉེ་བར་མཚོན་པའི་བསྟན་འགྲོ་སྤྱིའི་སྐྱབས་མགོན་མཆོག་ཏུ་གེགས་བྲལ་ལེགས་པར་ཐོབ་བོ།",
    "རང་ལ་བསྟོད་པ་ཞིག་ཀྱང་སུག་བྲིས་བྱས།",
    "ངོ་མཚར་དགའ་སྟོན་ལེགས་མཚོན་ཁྲི་འབུལ་ས་སྐྱོང་བསྟན་པའི་སྦྱིན་བདག་ཆེན་པོ་གཙོར་བཞུགས་པའི་སྐུ་འཁོར་ཡོངས་རྫོགས་དང་།",
    "རྫོགས་བཞུགས་བཅས་མི་སྣ་འཛོམ་པ་ཀུན་དང་ལྷན་ཅིག་མདུན་འཇོག་སྟོབ་པའི་ཐོག་མར།",
    "ཁྲི་འབུལ་རྣམས་རིམ་པར་བསྟར་ནས།",
    "མཁན་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནས།",
    "གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མ་ལྷ་དགུའི་རྗེས་སུ་གནང་བ་དང་།",
    "ཛམ་དམར་གྱི་རྗེས་གནང་ལུང་བཅས་དང་།",
    "འདོད་པའི་རྒྱལ་པོའི་འཁོར་ལོ་ཐ་ཆེན་བཅས་པའང་རབ་ཏུ་གནས་པ་བྱས་པ་བཅས་བྲིས།",
    "ནོར་རྒྱས་པར་བྱེད་པ་གནོད་སྦྱིན་གྱི་འཁྲུལ་འཁོར།",
    "སྟོབས་རྒྱས་པར་བྱེད་པ་གླང་པོ་ཆེའི་འཁྲུལ་འཁོར།",
    "ཚེ་རྒྱས་པར་བྱེད་པ་བུམ་པའི་འཁྲུལ་འཁོར་སོགས་འདྲི་བ་རྣམས་ནི་སྔགས་བཏུ་བ་དྲངས་པ་སྤོ་བ།",
    "སླར་ཁོང་ལ་ཞལ་གདམས་ཞིག་ཀྱང་གནང་དགོས་ཞེས་གསུངས་པའི་ངོར།",
    "དེ་དང་མཐུན་པར་བདུད་འདུལ་རྡོ་རྗེའི་གང་ཟག་སྒོས་ཀྱི་ལུང་བསྟན་རཏྣའི་སྒྲོམ་བུ་ལས།",
    "ཕྱག་ན་རྡོ་རྗེ་རྣམས་ཀྱི་རྗེས་གནང་ཕུལ།",
    "དབོན་སྟོད་པ་དང་སྣ་འབྲང་བའི་དགེ་སློང་དེར་བཞུགས་རྣམས་ལ་མགོན་དཀར་གྱི་རྗེས་གནང་དང་།",
    "སྤྲུལ་པའི་སྐུ་ཉིད་བསྟན་འཛིན་གྱི་སྐྱེས་བུ་ཁྱད་འཕགས་སུ་བཞུགས་པར་གོར་མ་ཆག་པ་དང་།",
    "ཁོ་བོར་ལེགས་སོར་ལོ་པཎ་གྱི་དབུ་ཞྭ་གཙོས་བརྒྱ་འབུལ་གྱི་སྟེར་ཆ་གནང་།",
    "དེ་ནས་ཀུན་མཁྱེན་ལྔ་པ་ཆེན་པོ་མན་གོང་བཞིན་དང་། ཡང་ལྔ་བསྡུས།",
    "ཀུན་མཁྱེན་ལྔ་པ་མན་འདྲ། དཔལ་དབྱངས་འཆར་གྱི་བརྒྱུད་པ་ནི།",
    "ཡང་དག་པར་ལེན་པ་སྟེ་ལེན་པ་མི་བཞི།",
    "མཁྱེན་རབ་རིན་ཆེན་མཆོག་གྲུབ།",
    "ཀུན་མཁྱེན་ལྔ་པ་ཆེན་པོ།",
    "ཡང་ལན་གཅིག་དཔལ་ས་སྐྱ་པ་ཆེན་པོ་སྐུ་ཤིན་ཏུ་མདངས་གསལ་ཁྲི་བཀོད་ལེགས་ཀྱིས་སྟེང་དུ་བཞུགས་པ་མཇལ་བར་སྔོན་མེད་ཀྱི་དད་དགའ་གསར་འཕེལ་རྨིས།",
    "དེ་ནུབ་ནས་མི་རིང་བར་ལྷ་སྲས་དམ་པ་འདི་ཉིད་ཡུམ་གྱི་སྐུ་ལ་གནོད་པ་མེད་པ་བདེ་བར་བཙས་སོ།",
    "ངེད་རང་ནས་ཀྱང་རྗེས་གནང་སོགས་ཅི་གྲུབ།",
    "ལོ་འདིར་དཔལ་ས་སྐྱའི་གསུང་བརྟག་ལ་ཁོ་བོའི་སྲོག་ཕྱར་འཚུབས་ཆ་ཡོད་ཚུལ་ཕེབས་པ་ལྟར་ལག་རྩ་འཚུབས་ཤིན་ཏུ་ཆེ་ཞིང་།",
    "ས་སྐྱོང་ཆེན་པོའི་བཀའ་ལུང་བཞིན་དཔོན་སྟོད་གཙུག་ལག་ཁང་སྟེང་གསེར་འཕྲུ་འཛུགས་པར་བཏེག་ནས།",
    "ཕེབས་ལམ་འདི་ནས་གནང་བའི་ངེད་རང་མཚམས་ཀྱི་བར་བསྲིངས་ཏེ་ཞལ་མཇལ་གསུང་ཐོས་བཟང་པོ་བྱུང་།",
    "ཀ་ཐོག་སྤྲུལ་པའི་སྐུར་སྒྲོལ་དཀར་རྗེས་གནང་ཕུལ།",
    "ཚུར་དྲི་མེད་བཤགས་རྒྱུད་ལུང་ཞུས།",
    "ཡང་བསྐྱར་བསྙེན་མཚམས་བསྡོམས་པར།",
    "རིམ་གྱིས་རུས་པ་བཀྲུ་སྦྱོང་སཱཙྪ་སོགས་མཐའ་ཚང་དགོས་ཚུལ་གྱི་བཀོད་པ་བྱས།",
    "ཟླ་ཚེས་ལ་དཔོན་དོན་འགྲུབ་བཀྲ་ཤིས་ཀྱི་ཆེད་དུ་འཆི་བསླུ་བྱས་པར་དེ་ཉིན་བདག་དཀའ་ཚེགས་ཤིན་ཏུ་ཆེ་སྙམ་ཞིག་བྱུང་བར།",
    "ངེས་པར་འཆི་ཟེར་བ་ཞིག་རྨི་ལམ་ལ་བྱུང་།",
    "ལྷ་ས་ལ་བསྐོར་བ་དམ་བཅའ་ཉིས་བརྒྱ།",
    "གྲངས་བཅད་མེད་པར་འདོན་བྱ་གོང་དུ་སྨོས་པ་རྣམས་དང་།",
    "དབོན་དགེ་ལེགས་ལ་འཕྲོད་པར་བྱས།",
    "དད་སྒྲོལ་ཆེན་པོ་ཡབ་སྲས་སྐུ་ཚེ་བསྐལ་པར་བརྟན་ཅིང་བསྟན་སྲིད་རྒྱས་པའི་བདེན་སྨོན་སོགས་ཀྱིས་རྒྱས་བཏབ་སྟེ་ཕུལ།",
    "ད་འབྱུང་དཔོན་སེར་སྐྱ་གྲྭ་རིགས་བཅས་ལ་བཀའ་དྲིན་ཆེ་བསྐྱང་མཁྱེན་ཞེས་ཚེས་༨ ལ་ཞུ་ཡིག་འདི་ལྟར་ཕུལ།",
    "ངེད་རང་མཆོད་ཡོན་དམ་ཚིག་སེལ་མེད་ཐུགས་ནང་ཁྱད་པར་ཅན་དག་པར་བརྟེན་པའི།",
    "ཚེས་བཅུ་གཉིས་ཀྱི་སྔ་ཆར་འདི་གར་ཕེབས་བྱུང་བ་དེ་འཕྲལ་མཇལ་ཕྲད་བྱས།",
    "ལྕམ་ལྷན་རྒྱས་ནས་དངུལ་སྲང་བཅུའི་གཙོས་པའི་ཚན་གྲངས་བཅུ་གཅིག་ཙམ་གྱི་གནང་ཆ་དང་།",
    "གོས་སེར་འབྲུག་བརྒྱ་མས་སྦུབས་ཤན་བྱས་པའི་ཚར་སློག་རྣམས་གནང་བྱུང་།",
    "ངེད་རང་ནས་ཀྱང་ལྕམ་མཆེད་ལ་བཀའ་བསྒོ་ནན་ཏན་བྱས།",
    "ཐོག་མར་ཕྱི་དབུགས་སྡུད་པ་ནས་དྲང་འགྱེལ་ཇི་ལྟར་གྱུར་ཀྱང་བཅའ་བཅོས་སོགས་གཏན་ནས་མ་བྱེད་པར།",
    "མཉམ་མེད་ཐུབ་པ་མཆོག་གཙོའི་འདུས་བྱས་ཀུན།",
    "བློ་ལྡན་ཡོངས་ཀྱིས་བསྔགས་པའི་གླིང་བུ་ལན་ཅིག་མིན་པར་བསྒྱུར་བའི་གནས།",
    "ངེས་པར་སྐྱེ་འཇིག་མཐའ་ལས་རྣམ་གྲོལ་ཀྱང་།",
    "ཕལ་དང་དམ་པའི་ཁྱད་པར་སྟོན་ཕྱིར་སོགས།",
    "བཟླས་པ་སྔགས་ཀྱི་རྩལ་འབྱངས་པས་བརྟན་གཡོའི་སྒྲ་སྐད་ཐམས་ཅད་དེར་འཛིན་མེད་པར་གྲགས་སྟོང་བརྗོད་བྲལ་སྐྱེ་འགག་མེད་པའི་གདངས་སུ་ཤར་བ།",
    "གོང་དུ་སྨོས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་རྣམས་བརྗོད་པ་པོ་རང་ཉིད་རང་བློ་ལྐོག་ཏུ་གྱུར་པས་འཕགས་པ་རྣམས་ཀྱི་དགོངས་པ་འདི་དང་འདིའོ་ཞེས་བརྗོད་དུ་ག་ལ་བཏུབ་ཀྱང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡོན་ཏན་ནི།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱིས་མཁྱེན།",
    "མཐའ་ཡས་ཉིད་ཀྱིས་ཤེས་པར་འགྱུར།",
    "ཞེས་པའི་དོན་ས་ཆེན་པོའི་དཀྱིལ་འཁོར་འདི་ཡོངས་སུ་རྫོགས་པར་གྱེན་དུ་བཏེགས་ན་ལྕི་བར་ཤེས་ཀྱང་།",
    "ལེགས་པར་བརྟགས་ལ་ང་ཡི་བཀའ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཡོན་ཏན་ཀུན་གྱི་མཆོག་མངའ་རྒྱལ་བ་དེ་སྐད་གསུངས།",
    "གཞན་རྗེ་ཉིད་ཀྱི་བཀའ་འབུམ་སྐོར་གྱིས་མཚོན་པའི་སྤྱན་ལམ་དང་ཕྱག་བསྟར་གནང་རིགས་མཐའ་དག་ལ།",
    "ཐ་དད་ཡོད་ཅེས་གང་གསུངས་པ།",
    "ཞེས་གསུངས་པ་ལྟར།"
