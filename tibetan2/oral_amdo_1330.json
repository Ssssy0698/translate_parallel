    "མདང་དགོང་ཁྱོད་དང་ལྷན་དུ་ཆང་འཐུང་རོགས་དེ་དག་སུ་ཡིན་ཞེས་དྲིས་བྱུང་ལ་འདྲི་བའི་དུས་ཀྱི་མིག་མདངས་ཁྲོད་དུ་ངའི་ངག་ནས་ཅི་ཞིག་ཐོབ་པར་རེ་བའི་ཧམ་སེམས་ཀྱི་འོད་ཅིག་འཁྱུག་གིན་འདུགམ་གཞི་ཁོས་ང་ལ་ཆང་ཤེལ་དམ་གང་ཁྱེར་ཡོང་དོན་དེ་ཡིན་པར་འདུག་ངའི་ངག་ནས་ཁོ་རང་ལ་བསྙད་བརྐོ་བའི་མི་དེ་དག་སུ་ཡིན་པའི་སྐོར་གྱི་སྐད་ཆ་ཤེས་འདོད་པ་ཡིན་འདུག་ད་སྔོན་ད་དུང་ངའི་སེམས་ལ་ཁོས་བསམ་པ་རྣམ་དག་གིས་ང་ལ་བཟོད་གསོལ་དང་དགོངས་དག་ཞུ་རུ་ཡོང་བ་རེད་སྙམ་ནས་ཁོའི་སྟེང་ལ་ཚིག་པ་ཟ་གྱིན་པ་དེ་ཡང་ཅུང་རང་ཡལ་དུ་གྱུར་སོང་མོད།",
    "ཁྱོད་རང་གོ་བ་ལོག་མི་ཉན་ཟེར་བཞིན་ཆང་དམ་དེ་ཕྱིར་སྔར་མལ་དུ་བཞག་པ་དང་།",
    "གཞན་གྱིས་ཐོས་ན་མི་ལེགས་པ་རེད་ཟེར།",
    "ངའི་སྟེང་ལ་ན་སེམས་སྐྱེས་བར་མ་ཟད་འཁོན་ལན་སློག་པའི་མགོ་ཡང་བརྩམས་པ་རེད།",
    "དེ་ནས་ངའི་སྟེང་ལ་ཧ་ཅང་ཁོང་ཁྲོ་ལངས་པར་གྱུར་ཏེ་གང་བྱུང་ངང་སྡིགས་མོ་འགའ་བྱས་རྗེས།",
    "ཁོ་མོར་ཁོང་ཚང་གི་བུ་མོར་བརྙས་བཅོས་བྱས་པ་རེད་དམ་ཞེས་དྲིས་པ་ན།",
    "ཁོ་མོས་ཁོང་ཚང་ལ་བུ་མོ་མེད་ཟེར་སྐད།",
    "སློབ་གཙོས་ཧ་མ་གོ་བར་འོ་ན་ཇི་ལྟར་བརྙས་བཅོས་བྱས་པ་རེད་ཅེས་དྲིས་པ་ན།",
    "ཁོ་མོས་ང་རང་ནམ་གུང་ལ་ཁོང་ཚང་གི་ཁྱིམ་ནང་ཡོང་བ་རེད་ཅེས་ཟེར་སྐད།",
    "ཁོ་མོ་ཕྱིར་སོང་མ་ཐག་ང་རང་སློབ་གཙོའི་གཞུང་ལས་ཁང་དུ་བོས་བྱུང་།",
    "ང་རང་སློབ་གཙོའི་གན་དུ་འགྲོ་དུས་སློབ་གཙོ་ཀུན་བཟང་གཏན་ནས་ཁྲོས་མི་འདུག་དེ་ལས་ལྡོག་སྟེ་དགོད་ཀྱིན་འདུག་འོན་ཀྱང་ངའི་མིག་ལམ་དུ་སློབ་གཙོ་ཀུན་བཟང་གི་ངོ་གདོང་ཕྲ་བོ་དེ་ནམ་རྒྱུན་ལས་ཇེ་ཆེར་གྱུར་ཡོད་པ་ལྟར་སྣང་ལ།",
    "ཁོའི་གདོང་གི་འཛུམ་དམུལ་གྱི་ཁྲོད་དུའང་དཔོན་པོའི་ཟིལ་ཤུགས་ཤིག་གིས་ཁེངས་འདུག་པའི་སྣང་བ་སྐྱེས་བྱུང་།",
    "ངས་ཀྱང་མྱུར་མོར་མཐོང་བྱུང་ཞེས་ལན་བཏབ་པ་ཡིན།",
    "ཁྱོད་ཀྱིས་དོན་ངོ་མར་ཁོ་མོར་ཅི་ཞིག་བྱས་པ་ཡིན།",
    "ཁོས་གདོང་གི་འཛུམ་དམུལ་དེ་དལ་བུར་ཕྱིར་བསྡུས་སོང་བ་དང་།",
    "ཁྱོད་ཀྱིས་ཁོ་མོར་བརྙས་བཅོས་བྱས་སོང་ཟེར།",
    "སྐད་ཆ་འདི་ཕྱི་རུ་འཁྱར་ན་དགོད་བྲོ་བ་ཞིག་མ་རེད་དམ།",
    "ལག་པ་ཡར་བཏེགས་ནས་རེག་ཙམ་བྱས་པ་ན་རྔུལ་ཆུ་རྡོག་པོ་ཞིག་ཡིན་འདུག་ང་ལ་གཞན་གྱིས་འཕྱ་སྨོད་བྱེད་དུས་ནམ་རྒྱུན་རྔུལ་ཆུ་བཞུར་འོངས་ལ་དེ་དང་བསྟུན་ནས་སྤོབས་ཤུགས་ཤིག་ཀྱང་རྒྱས་ཡོང་བ་ཡིན།",
    "ངས་རྔུལ་ཆུས་བརླན་པར་བྱས་པའི་ལག་པའི་མཛུབ་མོའི་ངོས་ལ་ལྟ་ཙམ་བྱས་རྗེས་གཞི་ནས་སེམས་ལ་ངར་ཤུགས་ཤིག་རྒྱས་ཤིང་།",
    "ང་རང་ཁོང་ཚང་ལ་ཆུ་ཁོལ་སློང་དུ་སོང་བ་ཡིན་མོད།",
    "སློབ་གཙོ་ཀུན་བཟང་ནི་ཡ་མཚར་སྐྱེས་སོང་བ་འདྲ།",
    "མ་གཞི་དེ་འདྲ་ཡིན་ནམ་ཟེར་ནས་རེ་ཞིག་ལ་ཧད་དེ་སྡོད་ཅིང་།",
    "དེ་ནས་ཁྱོད་ཀྱིས་ཅི་ཞིག་བྱས་པ་ཡིན་ཟེར་ནས་ངའི་ཁ་ནང་ལ་ཅེར་བྱུང་།",
    "ངས་ལན་བཏབ་པ་དེ་སློབ་གཙོས་རེ་སྒུག་བྱས་ཡོད་པ་དང་ཡོངས་སུ་མི་མཐུན་པས་ཁོའི་རེ་བ་ཁེངས་ག་ལ་ནུས།",
    "དེ་འཕྲལ་སློབ་གཙོས་དངན་པ་ཞིག་འཐེན་ནས་ན་རེ།",
    "གང་ལྟར་ཁྱོད་ཀྱི་སྟེང་ནས་དོན་དག་འདི་འདྲ་ཞིག་བྱུང་སོང་བ་རེད།",
    "ངས་བལྟས་ན་ཁྱོད་སོང་སྟེ་ཁོ་མོར་འགྱོད་བཤགས་ཤིག་བྱས་ན་འོས་པ་རེད།",
    "ང་རང་ཡ་མཚར་བར་གྱུར་སོང་།",
    "ངས་ཅི་ཞིག་འགྱོད་བཤགས་བྱེད་དགོས་པ་རེད།",
    "ཇ་བག་ཅིག་ཁྱེར་སོང་སྟེ་ང་རང་ནོར་སོང་བ་རེད་ཅེས་དགོངས་དག་ཅིག་ཞུས་པས་ཆོག་པ་རེད།",
    "ཁོ་མོའི་དམོད་མོ་བྱེད་པའི་ཆུ་ཚད་ཧ་ཅང་མཐོ་བར་འདུག་པས་ངའི་བློ་ངོར་མི་ཤོང་བ་ཤ་སྟག་རེད་དེ།",
    "ངེད་ཚང་གི་གནའ་ནས་ཤི་བ་དང་ད་ལྟ་གསོན་པ།",
    "ངེད་ཚང་གི་མི་རབས་ཚང་མར་ལུས་ལ་ན་ཚ་ཡོང་བ་དང་ཁ་ལ་མུ་གེ་ཡོང་བའི་སྨོན་འདུན་དང་བཅས་ངས་ཁྱེར་ཡོང་བའི་ཇ་བག་དེ་ཡང་རྡོ་བ་བཞིན་དུ་ཕྱིར་ངའི་སྟེང་ལ་གཡུགས་བྱུང་།",
    "ངས་ནི་གུས་གུས་ཞུམ་ཞུམ་གྱིས་སེམས་བསམ་པའི་སྟེང་ནས་ཁོ་མོ་ལ་དགོངས་དག་ཞུ་སྙམ་པ་ཡིན་ཡང་།",
    "བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ལ་ཁོ་མོས་ནི་ཕྱིར་ལྡོག་སྟེ་ཞེ་འཚེར་བའི་དམོད་མོ་དེ་འདྲ་ཞིག་བོར་བའི་ཁར།",
    "སྐབས་དེར་ངེད་གཉིས་ཀྱི་མཐའ་འཁོར་དུ་མི་མང་པོ་འདུས་པར་གྱུར་བས་ངའི་ངོ་གདོང་ཡོངས་ཚ་ལམ་ལམ་དུ་གྱུར་སོང་།",
    "ཁོ་མོར་འཁོན་སེམས་མ་བཅངས།",
    "མི་མང་གི་མདུན་ནས་ཁོ་མོས་ཀྱང་ང་ལ་ལག་འཛིང་བྱེད་མི་སྲིད་སྙམ་ནས།",
    "ཕར་ཁོ་མོའི་མདུན་དུ་གོམ་པ་འགའ་བཅར་ཏེ།",
    "ཁྱོད་ཁོང་ཁྲོ་མ་ལངས།",
    "ངས་ཁྱོད་ལ་ཁ་བརྡ་ཞིག་བྱེད་སྙམ་པ་ཡིན་ཞེས་བཤད།",
    "དེ་ལས་ལྡོག་སྟེ་སྔར་ལས་ཀྱང་སྨྱོས་པ་ལྟར་གྱུར་ཏེ་མི་མང་གི་ཁྲོད་ནས་ང་ལ་ག་ལོག་གླེང་འགེལ་བྱས་བྱུང་།",
    "ངས་ཁོ་མོའི་གདོང་ལ་མཆིལ་མ་བཏབ་བྱུང་ཟེར།",
    "ཁྱོད་ཀྱིས་ངའི་ངོ་གདོང་ལ་ལེན་སྲོལ་མེད་པ་བྱས་སོང་།",
    "ཁྱོད་ཀྱིས་ངའི་ངོ་ལ་ཕྱི་ལག་གིས་བརྒྱབ་བྱུང་།",
    "ཁྱོད་ཀྱིས་ངའི་མིག་ཀོང་ནང་ལ་ཕྱི་རྟིང་སྤོས་པ་མིན་ནམ།",
    "ང་རྒན་མོའི་ངོ་གདོང་གཞན་ལ་སྟོན་སྲོལ་མེད་པ་བྱས་སོང་ཟེར།",
    "འདི་ནི་ཁོ་མོས་བསམ་གཟས་ཏེ་ང་ལ་བསྙད་འདོགས་བྱས་པ་མ་རེད་དམ།",
    "འདི་ནི་ཁོ་མོས་མི་མང་གི་མདུན་དུ་ང་ལ་ག་ལོག་གླེང་འགེལ་བྱས་པ་མ་རེད་དམ།",
    "ངས་ནི་ད་བར་དུ་མི་ཞིག་གི་གདོང་ལ་ཐལ་ལྕག་ཙམ་ཡང་གཞུ་མ་མྱོང་བས་ན་མིག་ཀོང་ནང་དུ་རྐང་བའི་ཕྱི་རྟིང་བསྐོར་རྒྱུ་ནི་དེ་བས་ཀྱང་ག་ལ་སྲིད།",
    "ལར་མི་ཡི་ངོ་གདོང་ནི་མི་ཞིག་གི་ལ་རྒྱའི་མཚོན་བྱེད་ཡིན་ཏེ།",
    "འོན་ཀྱང་སྐབས་འདིར་ངས་དངོས་གནས་ཁོ་མོའི་ཉུང་མ་ཕྱིད་པོ་ལྟ་བུའི་ངོ་གདོང་མི་སྡུག་པ་དེའི་སྟེང་ལ་ལག་པས་ཕྱི་ལག་གིས་རྒྱག་པར་ཐེ་ཚོམ་མི་འདུགའགྲམ་དུ་ཡོད་པའི་མི་ཚོགས་ཀྱིས་ནི་ད་དུང་ཡང་དོན་དག་ཅི་ཞིག་བྱུང་སོང་བ་མ་ཤེས་པར་ཅུང་ཁག་འདོགས་བྱེད་པའི་མིག་མདངས་ཀྱིས་ང་ལ་བལྟས་འདུག་པས།",
    "ངས་ཁོ་མོའི་གདོང་ལ་གཞུ་ག་ལ་རུང་།",
    "ཁོ་མོས་བསྙོན་འཛུགས་བྱེད་པ་རེད་ཅེས་བཤད།",
    "ཁྱོད་ཀྱིས་ད་དུང་འཇུན་འདོད་དམ་ཟེར།",
    "ཁོ་མོས་ད་དུང་ཁ་གསབ་ཀྱི་ཚུལ་དུ།",
    "ང་རྒད་མོའི་ངོ་གདོང་གི་འདི་ཤ་མ་རེད་དམ་ཟེར་ནས་ནན་འདྲི་བྱས་སོང་།",
    "ནང་དོན་ནི་ཕྱི་རོལ་ཏུ་གཏམ་ཡན་སྒྲོག་པར་བྱས་པ་དེ་ནི་ཁོ་མོའི་གདོང་ལ་ཐལ་ལྕག་གིས་བརྒྱབ་པ་དང་མཆིལ་མ་བཏབ་པ།",
    "གཏམ་ཡན་དེ་སྒྲོག་མཁན་ནི་གཞན་མ་ཡིན་པར་ང་རང་རེད་ཟེར་བ་ཡིན་འདུགམི་སྐྱ་བྷ།",
    "དབུགས་ཅུང་ཙམ་ལྷོད་དུ་ཕབ་སྟེ་མི་མང་གི་གྲས་ནས་རང་ཉིད་དཀར་འདོན་ཅི་ནུས་བྱས་པ་ཡིན།",
    "དེའི་ཐད་ནས་ངས་ཁྱོད་ལ་མནའ་བསྐྱལ་ཆོག་ཅེས་བཤད།",
    "དེ་ལས་ལྡོག་སྟེ་མོ་རང་དམྱལ་ཁམས་བཅོ་བརྒྱད་དུ་མགྲོན་པོར་འགྲོ་རྒྱུ་ཞེས་པར་གྱུར་འདུག་ཁོ་མོས་ངུད་མོ་དང་བཅས་ཤོད།",
    "ང་འཇིག་རྟེན་འདི་ནས་སྡོད་དུ་མ་བཅུག་པ་རེད།",
    "ཉེ་གན་གྱི་མི་ཚང་མས་བྱ་བ་མི་ལེགས་པ་ཞིག་འབྱུང་རྒྱུ་ཡིན་པ་ཤེས་ཏེ་ཁོ་མོ་བཟུང་ནས་ཁ་ཏ་བྱེད་བཞིན་གློད་མ་བྱུང་།",
    "གལ་ཏེ་ཁོ་མོ་བྲག་ལ་ལྕེབས་པའམ་ཆུ་ལ་མཆོངས་ཏེ་ཤི་ཐབས་བྱས་ཚེ་ཉེས་པ་ཡོད་ཚད་ངའི་སྟེང་དུ་ཡོང་པ་མ་རེད་དམ།",
    "འགྲམ་རོལ་གྱི་མི་འགའ་རེས་ཁོ་མོ་བཟུང་འདུག་པ་དང་འགའ་རེས་ང་རང་ཕར་དེད་བྱུང་བས།",
    "ང་རང་ཡང་གོ་སྐབས་དེར་བསྟུན་ནས་ཕྱིར་ལོག་ཐུབ་ཙམ་བྱུང་སོང་།",
    "འོན་ཀྱང་ངའི་རྣ་རྒྱབ་ཏུ་ད་དུང་ཡང་ཁོ་མོའི་སྐད་ཅོར་ཏེ།",
    "ཁྱོད་ཀྱིས་ཅི་ཞིག་མཐོང་བྱུང་།",
    "ཁྱོད་ཚོས་ང་འཆི་རུ་ཆུགས།",
    "ཉིན་དེ་ནས་བཟུང་ངས་ཀྱང་ཁོང་གཉིས་ལ་མི་ཁ་བསྐོར་བའི་གཏམ་ཡན་དེའི་འབྱུང་ཁུངས་ངོ་མ་དེ་གང་ཡིན་ལ་རྩད་གཅོད་བྱས་པ་ཡིན་ལ་ཅུང་མ་འགོར་བར་མཇུག་འབྲས་ཀྱང་བྱུང་སོང་།",
    "ཁོ་མོ་ནི་ཡག་མོ་སྒོ་དང་ལུས་སྐྱེ་གཟུགས་གང་ཐད་ནས་འཛོམས་གསུམ་འཛོམས་པའི་བུ་མོ་མཛེས་མ་ཞིག་ཡིན་པས།",
    "གསར་བུ་ཚོས་ཇི་ལྟར་ཟིང་ཟིང་ལོང་ལོང་བྱས་ཀྱང་རེ་བའི་སེམས་པ་ནམ་ཡང་སྟོང་བར་འགྱུར་གྱིན་ཡོད་སྐད།",
    "གསར་བུ་འགའ་རེ་ཁོའི་ལག་ཏུ་ཚུད་ནས་དོན་མེད་ཀྱི་རྡེག་རྡུང་ཡང་མྱངས་མྱོང་བར་གྲགས།",
    "ཁྱི་རྒན་རྒྱ་བྷ་ནི་ནམ་རྒྱུན་མཚན་མོ་རུ་འདབས་ཉུལ་ནས་རྐུ་བྱེད་པའི་དུས་དག་ཏུ།",
    "མི་ཡི་གྲིབ་གཟུགས་ཙམ་མཐོང་ནའང་སྲོག་ལེན་གྱི་གཤེད་མར་འཕྲད་པ་ཇི་བཞིན་བྱ་འཕུར་བ་ལྟར་འབྲོ་རྐྱང་བྱེད་མོད།",
    "སྐེ་གཅུས་ཏེ་མ་མཐོང་བ་ལྟ་བུའི་བཟོ་ལྟ་བསྟན་ནས་བུད་སོང་བས་ཁོ་རང་ངའི་སྟེང་ལ་ཁོང་ཁྲོ་ལངས་ཡོད་འདུག་པ་མ་ཟད་ཁོའི་ཡོང་དོན་ཡང་ཚོད་དཔག་བྱས་ན་ཤེས་ཐུབ།",
    "དེ་བས་ངས་ཀྱང་དེང་ཐོག་ཁོ་རང་ལ་ཁ་ཡ་མ་བྱས་པར་ཐད་ཀར་རང་ཉིད་ཀྱི་གཞུང་ལས་ཁང་དུ་སོང་བ་ཡིན།",
    "ཅུང་མ་འགོར་བར་སློབ་གཙོ་ཀུན་བཟང་ང་ཚོའི་གཞུང་ལས་ཁང་གི་སྒོ་ཁར་ཡོང་སྟེ་སྒོ་ཕྱེ་ནས་ང་རང་ཁོའི་གན་དུ་ཡོང་ཙམ་བྱོས་ཞེས་བོས་རྗེས་ཁོ་རང་སྔོན་དུ་ཕྱིར་བུད་སོང་།",
    "ང་རང་སློབ་གཙོ་ཀུན་བཟང་གི་གཞུང་ལས་ཁང་དུ་ཕྱིན་པ་ན།",
    "སློབ་གཙོས་ནི་ཡར་རོལ་གྱི་ཁོ་རང་གི་འདུག་སྟེགས་སྟེང་དུ་དུ་བ་འཐེན་བཞིན་འདུག་ཅིང་།",
    "སྐད་བསངས་ཙམ་བྱས་ཏེ་ན་རེ།",
    "དོན་དག་འདི་འདྲ་ཞིག་རེད།",
    "ངོ་མ་ང་རང་རང་ཉིད་ཀྱི་རྣ་བར་ཡང་ཡིད་མི་ཆེས་པར་གྱུར་སོང་།",
    "དེར་ཁྱོད་བྲེལ་མི་དགོས།",
    "ངས་གྲ་སྒྲིག་ལེགས་པོ་ཞིག་བྱས་ཏེ་འགྲོ་དུས་སློབ་ཁང་ནང་དུ་གསར་བུ་གསར་མོ་གང་འདུག་ཅིང་།",
    "གསར་བུ་གསར་མོ་དག་གི་གདོང་ལ་མཚར་སྣང་དང་མ་རབས་ཀྱི་འཛུམ་རེ་མངོན་བཞིན་འོད་འཚེར་བའི་མིག་མདངས་མང་པོས་ལྷན་དུ་ང་ལ་བལྟས་འདུག་ཅིང་།",
    "ང་རང་ཧ་ཅང་དོགས་མི་བདེ་བར་གྱུར་པ་དང་གདོང་ཡང་ཚ་ལམ་ལམ་དུ་གྱུར་སོང་།",
    "འོ་ན་ང་ཚོས་ད་ལྟ་འགོ་རྩོམ་པར་བྱ།",
    "ཚང་མས་ཧུར་བརྩོན་བྱས་ཏེ་རྨོངས་ཐར་བྱེད་དགོས་པ་རེད།",
    "ངས་ཀྱང་རེ་ཞིག་དོན་དག་ཅི་ཞིག་བྱུང་སོང་བའང་མ་ཤེས་པར་རྟབ་རྟབ་པོར་ཡར་ལངས་ཤིང་གདོང་ལ་བཙན་ཚུགས་ཀྱི་འཛུམ་ཞིག་བསྟན་ནས་གུས་འདུད་ཅིག་ཞུས་པ་ན།",
