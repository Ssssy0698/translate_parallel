    "ཡང་ས་སྐྱའི་དབུ་རྩེ་རྙིང་མར་སྐུ་མཚམས་ལ་བཞུགས་ཙ་ན་སྐབས་ཤིག་ཐོ་རངས་ཁ་མནལ་ལམ་དུ།",
    "ཁྱེའུ་དེ་ནི་འཇམ་དབྱངས་ཀྱི་སྤྲུལ་པ་ཡིན་ངེས་སུ་འདུག་ཅེས་རྗེ་ཉིད་གསུང་བར་ཤད་པ་དང་།",
    "དེའི་མདུན་ན་གདེངས་ཀ་ལེགས་པོ་བྱས་པ་ཞིག་འདུག་པ་དེར་སྔ་དྲོ་ཚོགས་མཆོད་ཀྱི་གནས་མཛད་པས་ལན་ཅིག་མདུན་བསྐྱེད་སྒྲུབ་པའི་སྐབས་སུ་ཐུགས་ཉམས་འུར་ནས་ཐོག་མར་ཐུགས་དྲན་གྱི་འཛིན་དགོས་པ་བྱུང་ཞིང་།",
    "ཨ་ར་པ་ཙ་ནའི་བྱེ་བསྙེན་ཞིག་མཛད་པ་ན།",
    "དེ་གསུམ་ངོ་བོ་གཅིག་ཡིན་ཟེར་བའི་བརྡར་འདུག་སྙམ་པའི་ངེས་ཤེས་ཐུགས་ལ་འཁྲུངས་པ་དང་།",
    "རྗེའི་སྐུ་མདུན་གྱི་ཕ་ཚད་དེ་ན་གཟུངས་ཐག་གཅིག་འདུག་པ་དེ་ཁྱེར་ཤོག།",
    "ས་སྐྱ་པའི་བསྟན་པ་ལ་ཕྱི་ནང་ཐམས་ཅད་ནས་གང་གནོད་རང་བྱེད་པ་ཞིག་གདའ།",
    "འདིར་བཀའ་བགྲོས་གནང་ལོང་ཡོང་བ་འདུག་ནའང་།",
    "གཞན་ལ་འཆད་པ་དང་རང་ཉིད་ཉམས་སུ་ལེན་པ་སོགས་གང་ལ་ཡང་ཐོགས་པ་མེད་པའི་བློ་གྲོས་མངའ་བ་ཞིག་སྟེ།",
    "མི་ཚོ་བདེ་མཆོག་སྔོན་པོ་ཡིན་ཟེར་ཏེ་འདི་ནི་དཀར་པོར་འདུག་གསུང་བ་ལ་སོགས་པ་དང་།",
    "སེམས་དཔའ་ཆེན་པོ་ལས་འཇིགས་པ་འདུག་ཅེས་རྗེ་ཉིད་ཀྱིས་གསུངས་ཞེས་ཀྱང་གྲགས་ཤིང་།",
    "དེས་ཀྱང་ནམ་མཁའ་ལ་བལྟས་པས་ནམ་མཁའ་ཤིན་ཏུ་དྭངས་པ་ལ་འཇའ་འོད་ཟླུམ་པོ་ཤིན་ཏུ་ལེགས་པ་གཅིག་འདུག་ནས།",
    "འདི་བཞིན་འདུག་གཞན་ནི་མ་མཐོང་ཞུས་པས།",
    "ཅུང་དམའ་བ་དེར་གཞན་ཞིག་ཕེབས་རྒྱུ་ཡིན་པའི་མཚན་དོན་བྱུང་བ་བརྗེད་འདུག་གསུངས།",
    "ཞིང་ཁམས་དེ་ལས་ཡིད་དུ་འོང་བ་མི་འདུག་གསུངས།",
    "ཁ་སང་བདེ་བ་ཅན་གྱི་ཞིང་ན་ཡོད་པའི་ཁྲི་སྟོང་པ་དེ་མཁན་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་འབྱོན་པའི་ལྟས་སུ་འདུག་ཅེས་གསུངས་པར་གྲགས་ལ།",
    "འདི་ལྟར་འདུག་ལགས་པ་ཅི་འདྲ་ལགས་སམ་ཞུས་པས།",
    "དེ་ཙམ་འདུག་ལོང་མེད་གསུངས་ཤིང་།",
    "བེ་རོ་ཙ་ན་དང་ཀུན་དགའ་བོ་ཐུགས་རྒྱུད་གཅིག་པ་ནི།",
    "སྔགས་འཆང་རང་ཉིད་ཀྱི་ཐུགས་སྟེང་ན་ཡོད་པའི་དོན་འགའ་ཞིག་ཞུས་པ་ན་རྗེས་སུ་གནང་བའི་ཚུལ་སོགས་གསུངས་པའི་རྗེས་སུ།",
    "ཨ་ར་པ་ཙ་ན།",
    "དེའི་འགྲམ་ན་རྫིང་བུ་ཤིན་ཏུ་ཡིད་དུ་འོང་བ་ཞིག་ཀྱང་འདུག་ཅིང་།",
    "དེའི་འཁྲིས་ན་ནེའུ་གསིང་སྔོ་ཏལ་པ་ཞིག་འདུག་པ་སྤུ་གྲིས་གཏམས་པའི་ཐང་ཡིན་ལ།",
    "དེའི་འགྲམ་ན་མི་མང་པོ་ཞིག་ནག་ཕུང་ཕུང་འདུག་པ་ལ།",
    "བསྟན་པ་དར་རྒྱས་སུ་ཡོང་བ་དཀའ་བ་འདུག་པས།",
    "རྒྱབ་བརྟེན་རྡོ་རྗེ་སེམས་དཔའ་ཁྱེད་རང་ལ་བྱས།",
    "ད་ལྟ་ནི་སྔགས་པ་རྒན་པོ་ཞིག་ཏུ་འདུག་ཅེས་རྗེ་ཉིད་རྗེ་བཙུན་ཆེན་པོ་ཡིན་པ་ཞལ་གྱིས་བཞེས་པ་སོགས་ངོ་མཚར་གྱི་བཀའ་མང་དུ་སྩལ་ཞིང་།",
    "བར་སྐབས་སུས་ཀྱང་རྩད་མ་ཆོད་པ་ཞིག་བྱུང་འདུག་པས།",
    "ས་རྡོའི་གསེབ་ན་ཤིང་ལེབ་གཅིག་ལ་ཡི་གེ་དབུ་ཅན་ཁྲལ་ལེ་བ་གསལ་པོ་རང་མིན་པ་ཞིག་བརྐོས་ནས་འདུག་པ་ལ་ཁྲུས་གསོལ་ནས་ཡི་གེ་དེ་ཉིད་བཀླགས་པ་ན།",
    "ད་ལྟའི་གཟུག་རྒྱབ་པ་འདི་ནི་མཧཱ་ཀཱ་ལའོ་ཟེར་བ་འདུག་པ།",
    "དེའི་སྤྲོས་པ་ཡིན་ནི་ཆོད་འདུག།",
    "དགེས་བཤེས་སུ་འཕྲིན་སྐྱོལ་ཟེར་བར་འདུག་པས།",
    "སྔགས་འཆང་ཉིད་ལ་གུས་འདུད་དང་བཅས་འདུག་པ་མཁན་ཚང་པ་བསྟན་པ་དར་རྒྱས་ཀྱིས་མངོན་སུམ་དུ་མཐོང་ཞིང་།",
    "སྐུ་དེ་ཉིད་ཅུང་ཟད་མདུན་དུ་བུབ་ནས་འདུག་པ་ལ།",
    "ས་ལོ་ཐམས་ཅད་མཁྱེན་པ་ཡིན་སྙམ་པའི་པཎྜི་ཏ་ན་བཟའ་ངུར་སྨྲིག་བསྣམས་པ་གཉིས་ཀྱང་འདུག་ཅིང་།",
    "ལྕོག་རྙིང་པ་འདི་ལ་ཡང་ཞིག་གསོས་ཤིག་བྱས་ན་ལེགས་པ་འདུག་སྙམ་དུ་དགོངས་ནས།",
    "བདག་ཉིད་ཆེན་པོས་འོ་ན་འདིར་ཁྱེད་རང་གནས་སའི་ལྕོག་ཅིག་གསར་ཏུ་བཏབ།",
    "དེ་མཐུན་ལྕོག་རྙིང་པ་ལ་ཡང་ཞིག་གསོས་ཤིག་བྱེད་དགོས་འདུག་པས།",
    "མི་ལ་མི་འཛེམ་པར་གྲལ་བསྒྲིགས་ཏེ་ལངས་ནས་སྔགས་འཆང་ཉིད་ལ་བསུ་བའི་ཚུལ་དུ་འདུག་པ་ནི།",
    "དེ་དུས་ཞབས་དྲུང་ན་འདུག་པ་ཀུན་གྱིས་མཐོང་བར་གྲགས་ལ།",
    "ལྷག་པར་ད་དུང་ལོ་དུ་མའི་བར་དུ་བསྟན་འགྲོའི་དོན་དཔག་ཏུ་མེད་པ་འགྲུབ་པ་འདུག་ཅིང་།",
    "འཇམ་པའི་དབྱངས་སྐུ་མཆེད་ཀྱིས་བདག་རྣམས་ཀྱིས་དེ་བཞིན་མི་ཤེས་པ་འདུག་ལགས་ཞེས་ཞུས་པ་ན།",
    "སྐུ་ཤེད་ཇེ་ཆུང་དུ་འགྲོ་བ་འདི་ལ་བློ་བདེ་བ་ཞིག་གཏན་ནས་མི་འདུག་པས།",
    "གང་ལྟར་ད་ལོ་ས་ལོ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཞལ་བཞུགས་པའི་དུས་བཞིན་སྐུ་འཁོར་མང་པོ་དང་བཅས་དུས་སྐབས་ཕལ་ཆེ་ཐར་རྨི་ལམ་དུ་འབྱོན་པ་ཞིག་འདུག་པས།",
    "དགེ་སློང་པས་ཅི་འདུག་ལགས་ཞུས་པས།",
    "རྒྱུན་རིང་པོ་འདུག་ལོང་མེད་ཅེས་གསུངས་ཤིང་།",
    "ཞེས་ཀྱང་རང་བབས་སུ་སྨྲས་སོ།",
    "འཇམ་དབྱངས་ཡིན་ཟེར་བར་འདུག།",
    "ཁྱེད་རྣམས་ཀྱིས་བུ་ཚ་ལ་བཅའ་ག་ཆེར་མི་བྱེད་འདུག་ནའང་འདི་རང་ལ་གྲོགས་འགྲུལ་བཏུབ་ཅིག་སླེབས་འདུག་ཅེས་གསུངས་པ་ལ།",
    "འདུག་གྲོགས་སུ་པུ་ཏྲ་ངོ་མཚར་ཆེ།",
    "མཁའ་འགྲོ་རྣམས་ཀྱི་ནང་ནས་བདེ་བའི་རྡོ་རྗེ་གསལ་ཏེ་རིག་འཛིན་བརྒྱུད་པའི་ཟླ་ལ་འདུག།",
    "ཁྲམ་ཤིང་སྐེད་ལ་བཙུགས་པ་ཞིག་འདུག་པ་དེ་གཉིས་གསལ།",
    "རིག་འཛིན་བཞིའི་གོ་འཕང་ཐོབ་ངེས་པ་ཞིག་ཁྱེད་མཁྱེན་ཞེས་ཕུར་ཚུགས་སུ་གསོལ་བ་འདེབས་ཀྱིན་འདུག་པས།",
    "དེའི་རྐྱེན་གྱིས་ཉི་མ་ཡང་ཤར་ཏེ་བྱས་འགྱུར་གྱི་ལུང་པ་ཐམས་ཅད་འོད་ཀྱིས་གང་ནས་འདུག་པ་དང་།",
    "དོ་ནུབ་འདིར་བསྡད་ན་སྙམ་པ་ཙམ་འདུག་སྟེ་སྐྱེད་ལྷས་མགོན་ཁང་དུ་བསྐང་གསོའི་གྲབས་བྱས་པ་སོགས་ཁྲེལ་བའི་སྟབས་ཀྱིས་འགྲོ་བ་ཤར་ཚེ།",
    "རྗེ་ཉིད་མྱུར་དུ་དག་པའི་ཞིང་དུ་ཕེབས་པའི་དགོངས་པ་དེ་དུས་ནས་གཏད་པའི་གསུང་དུ་འདུག་ཅིང་།",
    "གཞན་ནི་འོས་རིགས་གང་ནས་བཙལ་ཀྱང་མི་འདུག་ཅིང་།",
    "དེའི་ངང་ནས་གུར་གྱི་མགོན་པོའི་སྐུ་ཡོངས་རྫོགས་ཇེ་གསལ་ཇེ་གསལ་འགྲོ་བ་ཞིག་འདུག་པ་ལ།",
    "གཞན་གཉིས་པོ་དེ་ཅུང་ཟད་ཁྲོས་པའི་ཚུལ་གྱིས་འདུག་པས།",
    "ངེད་ལ་མདང་ནུབ་རྨི་ལམ་འདི་བཞིན་བྱུང་བ་བྲིས་ཐང་འདི་ལ་པུ་ཏྲ་མིང་སྲིང་གསུམ་ཀ་མ་བྲིས་པས་ལན་པར་འདུག་ཅེས་གསུངས་ཤིང་།",
    "ངེད་ཀྱི་རྨི་ལམ་དེ་བྲིས་སྐུ་མྱུར་དུ་འདྲི་དགོས་པའི་རྟགས་སུ་འདུག་གསུངས་ནས་ཐུགས་རྩོལ་ཆེན་པོས་ཕྱག་བྲིས་ལེགས་པར་མཛད་ནས་རབ་གནས་དང་བསྐང་གསོ་རྒྱས་པར་མཛད་པའི་དུས་སུ་ཡང་ངོ་མཚར་བའི་རྟགས་དུ་མ་བྱུང་བ་ཡིན་ལ།",
    "སེང་ཁྲི་མན་གྱི་རྩིག་པ་ཤིན་ཏུ་གསལ་བ་འདུག་པར་མཐོང་བའི་ཚེ།",
    "ངེད་ནི་བདེ་བ་ཅན་ལ་འགྲོ་ཁྱེད་རང་ཨེ་འགྲོ་གསུང་བྱུང་བ་ལ།",
    "ཧེ་ཧེ་བདེ་བ་ཅན་དུ་འགྲོ་ན་ཚང་འདུག་པ།",
    "ངོས་ནི་ཉེར་དགུའི་ཟླ་བར་འདུག།",
    "སེམས་ཁུར་བསྐྱེད་པ་རང་གལ་ཆེ་ཞེས་གསུང་བ་འདུག་པ་དེ་དུས་ནི་རང་ཉིད་རྟག་འཛིན་ཆེས་པས་གོ་བ་མ་བྱུང་ཡང་།",
    "ད་ལོ་ངེད་ལ་དོག་ཆ་ཆེན་པོ་ཡོད་ཉེན་འདུག།",
    "བསྟན་པ་ལ་བྱ་བ་ཐུབ་ངེས་ཀྱི་ལུས་ཤིག་དགའ་བ་འདུག་ཅེས་སོགས་མྱུར་དུ་གཞན་དོན་ལ་ཕེབས་པར་དགོངས་པའི་གསུང་མང་དུ་བྱོན་ཞིང་།",
    "ནམ་མཁའ་ལ་ངོ་མཚར་བའི་རྟགས་འདི་ལྟ་བུ་རྟག་པར་ཡོང་ལུགས་ཀྱིས་བྱང་ཕྱོགས་ཀྱི་རྒྱུད་འདི་མགོན་དང་བྲལ་བ་ཞིག་མྱུར་དུ་མཐོང་བར་འདུག་གོ་ཞེས་མི་བཟོད་པའི་སྨྲེ་སྔགས་དྲག་པོ་དུས་ཀུན་དུ་སྒྲོགས་པར་གྱུར་ཅིང་།",
