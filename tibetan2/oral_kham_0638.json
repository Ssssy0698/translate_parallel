    "རང་དོན་ཞི་བར་གཞོལ་མིན་འགྲོ་བའི་ཕྱིར།",
    "ཇི་བཞིན་ཉམས་སུ་བླངས་པས་ཕྱི་ནང་གསང་བའི་དྲོད་རྟགས་ཐོན་པ་ཞིག་དགོས་པར་འདུག།",
    "རིག་པའི་ངང་དུ་ལྷོད་ནས་བགྱིས་ཙ་ན།",
    "ཁ་ཅིག་རིག་པའི་ངང་ལ་བཞག་ཙ་ན།",
    "ཉིང་འཁྲུལ་ལམ་དུའང་རང་ལ་སྨོད་བཞིན་མཆིས།",
    "ནམ་མཁའི་འཇའ་བཞིན་རང་བྱུང་རང་ཡལ་དུ།",
    "འགྲོ་བར་འདུག་ན་སྤྱད་ཀྱང་འགལ་བ་མེད།",
    "གཞན་ཡང་འབྲས་བུ་བྱེད་པའི་དུས་ན་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་དང་འདུག་པའི་དངོས་པོ་གང་ཡིན་པ་དེ་ཉིད་ལྷན་ཅིག་བྱེད་པའི་རྒྱུ་དང་བྲལ་བའི་དུས་ན་ཡང་འདོད་ན་ནི་དེའི་རྗེས་སུ་འཇུག་པ་ཉིད་ཀྱི་ཕྱིར་དེའི་ཚེ་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་རྣམས་ཀྱང་མགུལ་ནས་བཏགས་པ་བཞིན་དུ་སྟོབས་ཀྱིས་དྲངས་ནས་གནས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་དེས་བརྩམས་དང་།",
    "དེ་བས་ན་འབྲེལ་པ་ཅན་མེད་པའི་ཕྱིར་འདུ་བ་ཡང་རང་བཞིན་མེད་པ་ཁོ་ནའོ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་དཔྱད་པའི་ཞར་ལ་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་ཡང་རང་བཞིན་མེད་པར་བསྟན་ཏོ།",
    "དྲན་པ་ནི་མདུན་ན་འདུག་པའི་དངོས་པོ་ལ་ཡང་ཤིན་ཏུ་གསལ་བར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེ་གཉིས་ཀྱང་འདུག་པའི་ཕྱིར་རོ།",
    "འདས་པའི་དུས་ན་ཡང་རང་བཞིན་གྱི་ངོ་བོ་ཉིད་ཀྱིས་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "དགེ་ཚུལ་གྱིས་མཚོན་པའི་ཉན་ཐོས་ཀྱི་རིགས་ཅན་རྣམས་ལ་ཉན་ཐོས་དགྲ་བཅོམ་པའི་གཟུགས་དང་རང་རྒྱལ་གྱི་རིགས་ཅན་རྣམས་ལ་བསེ་རུ་ལྟ་བུར་རིགས་མཐུན་པའི་ཚུལ་དུ་བསྟན་ནས་དོན་མཛད་དོ།",
    "ལྷག་པའི་ཐུགས་ཀྱི་དགོངས་པའི་ངོ་བོ་བདེ་བ་ཆེན་པོའི་རོ་ཡེ་ཤེས་ལྔར་འཆར་བས་ལྟ་བྱ་ལྟ་བྱེད་མེད་པའི་ཚུལ་གྱིས་ལྟ་ཞིང་རང་གསལ་བའོ།",
    "རང་སྣང་བཀོད་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་གསུངས་པ་ཡང་རང་བཞིན་བརྗོད་དུ་མེད་ཅིང་སེམས་དང་ཡེ་ཤེས་ཀྱི་སྣང་བར་བསྟན་པ་དེ་དག་ཏུ་འདུས་པར་གཙོ་བོ་གདོད་མའི་དེ་བཞིན་གཤེགས་པ་ཉིད་ཀྱིས་དུ་། མཁྱེན་ཏོ།",
    "བའང་བསྐྱེད་པའི་རིམ་པའང་རང་བཞིན་མེད་པའི་རྫོགས་རིམ་དུ་ལྷུན་གྱིས་གྲུབ་པས་དེའི་ངང་ལ་མཉམ་པར་བཞག་ཅིང་སྤྲོས་པར་ས་པ་མེད་པའི་དོན་ལ་གནས་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་ས་མ་ཡ་ཧོ་ཞེས་པས་ཐུགས་ཀྱི་དམ་ཚིག་དུས་ལ་བབ་པས་བསྐུལ་བའོ།",
    "ལ་ལས་འདུག་སྟངས་ཉེས་པས་སྦྲིད་པ་སངས་པར་གོ།",
    "སེམས་ཉིད་གདོད་ནས་དག་པའི་ངོ་བོ་ཕྱག་ང་དྲུག་འགྲེལརྒྱ་ཆེན་པོའི་ངང་ལས་གང་ཤར་གྱི་རྟོག་པ་ཡེ་ཤེས་ཆེན་པོའི་ཚོགས་མཆོག་ཏུ་ཡེ་ནས་གནས་པ་ནི་དོན་གྱི་འདུག་ཚུལ་ལོ།",
    "ལུས་མ་བསྐྱོད་ཡན་ལག་མ་བསྐུལ་ཡང་འགྲོ་འདུག་དང་སྤྱོད་ལམ་ཐམས་ཅད་ཀུན།",
    "སྲན་མའི་གའུ་ཕྱེད་པ་ཙ་ནའི་འབྲུ་ཙམ་གྱི་པདྨའི་གདན་གྱི་སྟེང་དུ།",
    "ལྔ་པ་རྡོ་རྗེ་རྒྱལ་པོ་བཀའ་རབ་འབྱམས་ཀྱི་ཏིང་ངེ་འཛིན་ནི་མགོ་ལ་སོགས་པ་ཡན་ལག་ལྔ་ནི་འགྲོ་འདུག་དང་ཕྱག་རྒྱ་དང་ཡུལ་ལ་ལྟ་ཞིང་བསྒུལ་བསྐྱོད་བྱེད་པས་བསྐྱོད་ཆེན་འཁོར་ལོའི་གཞལ་ཡས་སུ།",
    "རང་རང་བཞུགས་པའི་ཕྱོགས་དང་དུས་མ་ལུས་པ་ཀུན་ནས་དུས་དང་རྣམ་པ་ཐམས་ཅད་དགུ་བཅུ་འགྲེལ་དུ་ གསང་ཆེན་དོན་གྱི་དཀྱིལ་འཁོར་མ་ལུས་པ་ཐམས་ཅད་རྒྱུད་ལ་བསྙེན་པ་སྟེ་མྱུར་དུ་འཐོབ་པ་ཡི།",
    "ཞེས་ལྷུན་སྟུག་པོ་བཀོད་པའི་ཞིང་རང་སྣང་དག་པའི་འཁོར་ལ་ཞུ་བ་པོ་མེད་པར་ཆེད་དུ་བསྒྲགས་སོ།",
    "སྲོག་དང་སྲོག་ལྡན་གྱི་སྐྱེས་བུ་ལྟར་སྣང་བ་ཡང་རང་སེམས་འཁྲུལ་བའི་ལོག་རྟོག་ཙམ་ལས་དོན་གཉིས་སུ་གྲུབ་པ་མེད་དོ།",
    "འགུག་པ་དང་བཅིང་བ་དང་གསོད་པ་ལ་སོགས་པ་སོ་སོའི་ལས་རྣམས་དཔལ་ཆེན་པོས་རང་རང་ལ་བསྐོས་པ་དེ་ཉིད།",
    "དེ་ལྟར་བྱིན་གྱིས་བརླབས་པའི་གཏན་ཚིགས་ཀྱིས་སྣོད་བཅུད་སྐུ་དང་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་རྟོགས་པས་ཡེ་ནས་གཞི་གདངས་སུ་རང་ཆེར་གནས་པ་མངོན་དུ་གྱུར་ཞིང་རང་ངོ་ཤེས་པ་ལ་ནི་མངོན་སུམ་པའི་རྟགས་ཀྱི་བསྒྲུབ་བྱ་ཡིན་ལ།",
    "སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་དོན་དཀའ་དམ་པ་ཉིད་ལ་ཉམས་པ་མེད་དེ།",
    "གཉིས་པ་རིམ་གྱིས་པའི་རིམ་གྱི་པ་ཕལ་བའི་སེམས་བརྒྱད་ནས་བཟུང་ཡོ་ག་མན་ཆད་སྦྱངས་ནས་འདིར་མ་ཧྭ་ལ་འདུག་ཚུལ་ནི།",
    "སྐྱོན་འདུག་པ་དེ་བས་དོན་དང་ཚིག་ལྡན་པར་བྱོས་ཤེས་ཞེས་སོ།",
    "ལམ་རང་རང་གཏིང་འཛིན་ཆ་དང་མཐུན་པའི་སྤྱོད་པ་དངོས་སུ་ནུས་པས་སྤྱོད་ལ།",
    "དེའང་སྤྱོད་ལམ་འགྲོ་ཉལ་འདུག་སྡོད་ཟ་ཞིང་སྤྱོད་པའི་དུས་ཀུན་ཏུ་སྤྱོད་པའི་ཏིང་འཛིན་འགྲེལ་ཉམས་པར་མི་བྱ་བ།",
    "ནོར་བུ་ཉི་མའི་འོད་ཕོག་ཆུ་ཡི་རང་བཞིན་སྤངས་ནས་འོ་མ་དང་ཞོ་རུ་གྱུར་ཏེ་འདུག་གོ།",
    "གཞན་དོན་གདུལ་བྱའི་ཡུལ་དང་རང་དོན་དགོངས་པ་ཏིང་འཛིན་གྱི་ནུས་པ་ལའང་མཐོ་དམན་གྱི་ཁྱད་པར་ཡོད་དེ་གང་ཞེ་དུ།",
    "གཞི་གཞན་དོན་བར་བའང་འདུག།",
    "ལུས་ཀྱི་འདུག་སྟངས་དང་།",
    "རང་འབྱུང་རང་ཞི་དང་།",
    "ཁྱིམ་བདག་གཙོ་བོའི་བུ་གྲགས་པ་ཁྱིམ་པའི་ཆ་བྱད་དུ་འདུག་བཞིན་པར་དགྲ་བཅོམ་པ་ཐོབ་ནས་ཕྱིས་རབ་ཏུ་བྱུང་བ་ལྟ་བུ་སྟེ།",
    "མངོན་གྱུར་དུ་མེད་ཀྱང་རང་བཞིན་དུ་ཡོད་དེ།",
    "བཅས་སོཇག་པ་དང་རང་བཞིན་དད་པས་སྡིག་ལྟུང་ཡང་ཐ་དད་ཟེར་རོ།",
    "དེའི་ཕྱིར་ན་རྡོ་རྗེའི་གསུངས་འདིས་སྣང་བ་རང་རང་སེམས་གསལ་པོར་བསྟན་པ་ཡིན་ནོ།",
    "གཤིས་མ་གྲུབ་པ་དང་འཁྲུལ་སྣང་ཡིན་པ་དང་རང་བཞིན་མ་ངེས་པའི་ཕྱིར་ཞེས་ཟེར་རོ།",
    "གཡས་གཡོན་དུ་བལྟས་པས་ཟུར་ཞིག་ན་ཁྱི་མགོ་ཞིག་འདུག།",
    "སྤང་རྟོག་ཕུན་སུམ་ཚོགས་ཅིང་རང་གཞན་གྱི་དོན་གཉིས་ལྡན་པ་རྫོགས་པའི་སངས་རྒྱུས།",
    "རབ་ཏུ་དམའ་བའི་ས་ལ་འདུགདུལ་བའི་དཔལ་ནི་རྣམ་པར་བསྐྱེད།",
    "འོ་ན་ཁྱེད་རང་རྣམས་དངོས་གྲུབ་བླངས་པའི་ཕྱིར་ཐུགས་ཀྱི་འདུན་པ་གནས་ཁང་འདི་ཡངལྕང་ལོ་ཅན་ནམ་རྔ་ཡབ་པདྨ་འོད་ཀྱི་ཞིང་ཁམས་སུ་གསལ་བའི་དབུས་སུ་སློབ་དཔོན་ཡང་ཨོ་རྒྱན་པདྨ་རྒྱལ་ལྷན་དེ་ཡང་རྟོགས་བརྗོད་དཔག་བསམ་འཁྲི་ཤིང་ལས་གང་ལ་པོ་ནོར་ལྷ་ཛཾ་བྷ་ལ་དངོས་སུ་གསལ་བཏབ་ཏེ་གསན་པར་འཚལབ།",
    "སྐད་ཅིག་འདིར་བྱོན་རང་རང་གདན་ལ་བཞུགས།",
    "དེ་འདྲའི་རི་རྒྱལ་རྩེ་ནས་ལྟས་ཙ་ན།",
    "རི་རྒྱལ་ཆེན་པོ་ཤར་ནས་ལྟས་ཙ་ན།",
    "རི་རྒྱལ་ཆེན་པོ་ལྷོ་ནས་ལྟས་ཙ་ན།",
    "རི་རྒྱལ་ཆེན་པོ་ནུབ་ནས་ལྟས་ཙ་ན།",
    "གང་བྱེད་ན་དགའ་ཐབས་གང་ཡང་མི་འདུག།",
    "རང་བྱུང་རང་ཤར་སྤྲུལ་པའི་དཀྱིལ་འཁོར་ལ་",
    "ཕྱོགས་གཞན་ཞིག་ནས་སྔར་སྲོལ་ལྟར་བསམ་བློ་དང་སྤོབས་པར་འབུར་འཇོམས་ཐེབས་ཀྱིན་འདུག་པས་ན།",
    "ནས་སྐབས་དེ་དུས་འབངས་མི་དཀྱུས་མ་དང་ཐ་ན་ཆུན་པ་བྲན་གཡོག་ལ་ཡང་ས་ཞིང་ཐོབ་པ་གསལ་པོར་མཐོང་ཐུབ་ཀྱི་འདུག་བློན་པོ་དང་མི་དྲག་རྣམས་ཀྱིས་ས་ཞིང་འབངས་བྲན་ལ་བོགས་མར་བཏང་བའམ་སྐལ་བར་སྤྲད་པ་ཡོས་པོ་ལོའི་སྟོན་ཞང་ལོན་གྱི་འབངས་ཞིང་པ་མཆིས་པའི་རྣམས་གྱི་ཐོག་བུལ་གོད་བརྩིས་ནས།",
    "འདི་ནི་ནམ་མཁའ་ནས་འོང་བའི་ལྷ་སྲས་ཡིན་པར་འདུག་པས།",
    "གཤམ་དུ་གཞན་ལུགས་ལ་སུན་འབྱིན་དང་རང་ལུགས་འཇོག་པའི་སྒྲུབ་བྱེད་རྣམས་རིམ་བཞིན་བརྗོད་པར་བྱ་བ་ལ།་",
    "བོད་ཡིག་དུས་ཅི་ཙམ་ནས་བྱུང་ཚུལ་དང་སྲོལ་གཏོད་མཁན་སུ་ཡིན་སྐོར་དེང་སྐབས་རྒྱལ་ཁབ་ཕྱི་ནང་ཀུན་ཏུ་ཞིབ་འཇུག་བྱེད་མཁན་ཤིན་ཏུ་མང་ཡང་རྩོད་པའི་གནས་སུ་གྱུར་པ་ལས་གཏན་འཁེལ་ངེས་པ་རྙེད་པ་ཞིག་བྱུང་མེད།",
    "ལྷོ་ཡིག་དང་འབྲུག་པའི་ཡི་གེ་བྲུ་ཤའི་ཡི་གེ་སོགས་ཞང་ཞུང་ཡི་གེ་ཡིན་ཟེར་མཁན་འདུག་ཀྱང་།",
    "སྐབས་དེར་མི་རྣམས་ནི་རང་བྱུང་ཁམས་སུ་འཚོ་གནས་བྱས་ཡོད་པས་མི་ཡང་རང་བྱུང་ཁམས་ཀྱི་བྱེ་བྲག་ཅིག་ཡིན་པ་སྟེ།",
    "འདི་ནི་ནམ་མཁའ་ནས་འོང་བས་ལྷ་སྲས་ཡིན་པར་ནས་དད་གུས་བྱས་པ་ཞིག་ཡིན་པས་གསོན་ཉམས་ཀྱི་རང་བཞིན་དང་གཏམ་འདུག་པས།",
    "ཤར་ཕྱོགས་ནི་རྒྱུ་འདུག་པ།",
    "རྒྱལ་པོ་འདི་ཉིད་ཀྱིས་ཡོན་བདག་བགྱིས་ནས་འཕགས་པ་བེ་རོ་ཙ་ནའི་སླད་དུ་ཐོག་མར་ལི་ཡུལ་དུ་ཙར་མའི་གཙུག་ལག་ཁང་ཆེན་པོ་བརྩིགས།",
    "ཁོ་རང་དད་པ་ཆེ་བའི་རྐྱེན་གྱིས་ལྷ་ཀླུ་རྣམས་ཀྱིས་བསྐྱབས་ཤིང་མཐར་དགྲ་བཅོམ་པའི་གོ་འཕང་ཐོབ།",
    "ལི་ཡུལ་ལུང་བསྟན་ཡང་ཞིབ་འཇུག་ལ་དཀའ་ཁག་མི་ཉུང་བ་ཞིག་འདུག་སྟེ།",
    "མི་སྒེར་གྱི་འགྲོ་ལུགས་འདུག་སྟངས་ཐད་ལ།",
    "ཡང་ཚིག་རྐང་སོ་སོའི་ཡིག་འབྲུའི་ཚེག་བར་ཆ་དང་ཡ་ཁེལ་སྟངས་གཅིག་མཚུངས་མ་བྱུང་ན་ཀློག་དུས་གཏན་ནས་སྙན་པོ་མིན།",
    "ངག་ཏུ་བརྗོད་བདེ་ཞིག་དུས་རབས་བདུན་པའི་དུས་དཀྱིལ།",
    "ལོ་ཙཱ་ཆེན་པོ་བེ་རོ་ཙ་ན་དང་།",
    "ཕྱོགས་ཀུན་འོད་ཀྱིས་རྣམ་པར་གསལ་བར་གདའ།",
    "འུད་བརྗོད་ཀྱི་ཤུལ་ལམ་རྟགས་གསལ་བོར་མངོན་འདུག་ལྷོ་བའི་མཛེས་པ་ནི་དེ་གཉིས་ཀྱི་བར་མ་ཞིག་གམ་རན་པར་འུད་ཀྱིས་བརྗོད་པ་ཞིག་ཡིན་པར་སྙམ།",
    "གཉིས་པ་སྙན་པ་གཉིས་ཐ་མི་དད་པར་དོན་གཅིག་ཏུ་ངོས་འཛིན་གྱིན་འདུག་པ་རྟོགས་ཐུབ་ལ།",
    "ཁྱེད་རང་ལན་མེད་པའི་འདྲི་རྟགས་དུ་མ་ལས་གྲུབ་པའི།",
    "རྒྱ་ལྕང་འདེབས་བློ་མི་འདུག།",
    "ལོ་ཙཱ་བ་གཉིས་ཀྱི་སྒྱུར་རྩལ་ཕུལ་བྱུང་ལ་དགྱེས་མཇལ་བྱུང་བའི་ཞོར་དུ་ཕྱོགས་གཉིས་ཀྱིས་མ་ཡིག་ལ་གོ་བ་ལེན་སྟངས་ཐ་དད་བྱུང་བ་དང་ནང་དོན་མཚོན་ཚུལ་ཐ་དད་བྱུང་བ་སྐོར་ཞིག་འདུག་པ་དེར།",
    "སྒར་ཞེས་པ་ཐོག་མའི་དུས་སུ་དམག་དཔུང་འདུག་སའི་སྦྲ་གུར་དང་ཁང་པར་གོ་ནའང་རིམ་བཞིན་ནང་དོན་འགྱུར་ཏེ་བླ་ཆེན་དང་དཔོན་པོ་འདུག་སའི་མིང་ལ་སྒར་ཁ་དང་སྒར་བ་སོགས་བྱུང་བས་སོ།",
    "དེར་མཐུད་ནས་ཁྱེད་ཀྱི་ལུས་ཀྱི་བ་སྤུ་གཅིག་བལ་ནའང་ངེད་ཚོའི་སྐེད་པ་ལས་སྦོམ་ཞེས་ལབ་འདུག་པས།",
    "ཐུབ་ཚོད་དུ་འདུག་ལ།",
    "ལྡོག་སྟེ་ཚིག་ཉ་ཉོག་ཏུ་གྱུར་འདུག་ཟེར་བར་ཡང་གནས་ལུགས་ཤིག་ལོས་ཡོད།",
    "མི་ལ་ལས་དེ་ནི་ཡ་ཐོག་དུས་ཀྱི་ལོ་ཙཱ་ཡིན་ཟེར་བ་ལའང་ཁག་ཅི་ཡོད།",
    "རང་རང་སོ་སོར་ཐ་དད་ཀྱི་སྒྱུར་ཐབས་དང་ཐ་དད་ཀྱི་ཐ་སྙད།",
    "འགྱུར་ཁ་པས་ག་ཕྱི་ཚུལ་ནས་འདྲ་ཆགས་པོ་འདུག་ཀྱང་མ་རྩོམ་དང་བསྡུར་ཚེ།",
    "བེ་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
