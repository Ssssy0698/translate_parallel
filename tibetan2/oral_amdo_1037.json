    "རོ་རེས་ཐམས་ཅད་སྲུང་བར་བྱེད་པའཱི་དོན་གཱིས་སོ།",
    "མཆོག་ཆེན་མཆོག་ཅེས་བྱ་བས་ནཱི་རོ་རེ་གནོད་སཱིན་གཱི་ཕྱག་རྒྱ་སོན་ཏེ།",
    "རཱིག་མཆོག་ཅེས་བྱ་བས་ནཱི་རོ་རེ་ཁུ་ཚུར་གཱི་ཕྱག་རྒྱ་སོན་ཏེ།",
    "དེ་ལྟར་རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་གཱི་སོ་ནས་བསོད་པ་བསན་ཟཱིན་ནས།",
    "རོ་རེ་དབྱཱིངས་དང་གསང་བ་ཆེ།",
    "རོ་རེ་དབྱཱིངས་དང་གསང་བ་ཆེ།",
    "རོ་རེ་གསང་བ་ཞེས་བྱ་བ་ནཱི་གསང་བའཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ཕ་བ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཕ་མོར་བསན་པའོ།",
    "རོ་རེ་དགོས་ཞེས་བྱ་བ་ནཱི་དེ་཈ཱིད་བསྡུ་བའཱི་སོ་ནས་སོ།",
    "རོ་རེའཱི་དངོས་གྲུབ་ཅེས་བྱ་བ་ནཱི་དཀཱིལ་འཁོར་གཱི་མཱིང་གཱི་སོ་ནས་སོ།",
    "རོ་རེའཱི་རོ་རེ་ཞེས་བྱ་བ་ནཱི་དམ་ཚིག་གཱི་ཕྱག་རྒྱའཱི་སོ་ནས་ཏེ།",
    "རོ་རེ་སེམས་དཔའཱི་རོ་རེ་ཡཱིན་པས་ན་རོ་རེའཱི་རོ་རེའོ།",
    "གེགས་བམ་ལ་ལས་ནཱི་རོ་རེའཱི་སེམས་ཞེས་ཀང་ཟེར་ཏེ།",
    "ཁབ་ཅེས་བྱ་བ་ནཱི་རོ་རེ་སེམས་དཔའཱི་སོ་ནས་ཏེ།",
    "རོ་རེ་སེམས་དཔའ་ནཱི་ཀུན་དུ་འགྲོ་བ་ཡཱིན་པའཱི་ཕྱཱིར་རོ།",
    "སོན་ཞེས་བྱ་བ་ནཱི་རོ་རེ་རྒྱལ་པོའི་སོ་ནས་ཏེ།",
    "ཞཱི་ཁོ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཆགས་པའཱི་སོ་ནས་ཏེ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ལེགས་པའཱི་སོ་ནས་ཏེ།",
    "དེ་཈ཱིད་ཆེ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་རཱིན་ཆེན་གཱི་སོ་ནས་ཏེ།",
    "ཡང་དག་མཐའ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་གཟཱི་བརཱིད་ཀཱི་སོ་ནས་ཏེ།",
    "ཆེ་བའཱི་ཚུལ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་དབལདཔལ་གཱི་སོ་ནས་ཏེ།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་བཞད་མོའི་སོ་ནས་ཏེ།",
    "ཀུན་དུ་བཟང་ཞེས་བྱ་བ་ནཱི་རོ་རེ་རྣོན་པོའི་སོ་ནས་ཏེ།",
    "སོད་པ་མཆོག་ཅེས་བྱ་བ་ནཱི་རོ་རེ་རྒྱུའཱི་སོ་ནས་ཏེ།",
    "བདུད་ཅེས་བྱ་བ་ནཱི་རོ་རེ་སྨྲ་བའཱི་སོ་ནས་ཏེ།",
    "ཀུན་གཱི་མཆོག་ཅེས་བྱ་བ་ནཱི་རོ་རེ་སྲུང་བའཱི་སོ་ནས་ཏེ།",
    "མ་཈མ་཈ཱིད་མཁེན་ཞེས་བྱ་བ་ནཱི་རོ་རེ་གནོད་སཱིན་གཱི་སོ་ནས་ཏེ།",
    "ཀུན་དུ་འགྲོ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཁུ་ཚུར་གཱི་སོ་ནས་ཏེ།",
    "རོ་རེ་ཧཾཧཱུྃ་ཞེས་བྱ་བ་སོས་པས་ནཱི་འདོད་པའཱི་རྒྱལ་པོའི་སཱིང་པོ་གཟུང་སེ།",
    "གང་གཱིས་འཇཱིག་རེན་གསུམ་པོ་ཐམས་ཅད་ཀཱི་བདག་པོ་འཁོར་དང་བཅས་པའཱི་དཀཱིལ་འཁོར་གཱི་དྲུང་དུ་བཀུག་ནས་གཞག་པ་དེའཱི་སོ་ནས་བསོད་པ་སེ་གསུམ་པའོ།",
    "གདུལ་བ་པོ་ཞེས་བྱ་བ་ནཱི་འཇཱིག་རེན་གསུམ་པོ་ཐམས་ཅད་ཀཱི་བདག་པོ་ངེས་པར་གནོད་མཛེས་ནཱི་ཧཾཧཱུྃ་མཛད་ཡཱིན་ཏེ།",
    "རོ་རེ་ཡན་ལག་ཀུན་ཞེས་བྱ་བ་ནཱི་ཞབས་སུ་བཀུག་པ་ལ་བྱ་སེ།",
    "གང་གཱི་ཕྱཱིར་འཇཱིག་རེན་གསུམ་གཱི་བདག་པོ་རྣམས་ཞབས་ག་཈ཱིས་ཀཱིས་བཀུག་ནས་ཕྱག་ན་རོ་རེའཱི་ཞབས་ཀཱི་འོག་ཏུ་འཇོག་པའཱི་སོ་ནས་བསོད་པ་སེ་ལྔ་པའོ།",
    "དག་པོའི་སྔགས་འདཱི་ཡང་ཕྱག་ན་རོ་རེ་ཇཱི་ལྟར་བགཱི་ཞེས་ཞུས་པ་དང་།",
    "ཕྱག་བྱ་ཞེས་བྱ་བ་ནཱི་གང་གཱི་ཕྱཱིར་རོ་རེ་ལྟ་བུའཱི་ཐུགས་ནཱི་ཕྱག་ན་རོ་རེའོ་ཞེས་གསུངས་ཏེ།",
    "རེད་པ་ནཱི་ཕེང་བ་བཅཱིང་བ་ལ་སོགས་པ་སེ།",
    "གང་ཕྱཱིར་རོ་རེ་སེམས་བརན་པས།",
    "ཞེས་བྱ་བ་ནཱི་ཅཱིའཱི་ཕྱཱིར་དེ་བཞཱིན་གཤེགས་པ་རྣམས་ཀཱིས་ཕྱག་ན་རོ་རེ་ལ་ཕྱག་བྱ་བ་ལ་སོགས་པར་མཛད་པར་རཱིགས་པ་ཡཱིན་ནོ་ཞེས་རོལ་བ་རྣམས་ཀཱི་དོགས་པ་དེ་བསལ་བའཱི་ཕྱཱིར།",
    "གང་ཕྱཱིར་རོ་རེ་སེམས་བརན་པ།",
    "གང་ཕྱཱིར་རོ་རེ་སེམས་བརན་པ།",
    "ཁོད་ཀཱིས་བསྒྲུབས་ཞེས་བྱ་བ་ནཱི་ཁོད་ཀཱིས་རེད་པར་མཛད་པ་སེ།",
    "རབ་ཏུ་མོས་པ་ཞེས་བྱ་བ་ནཱི་ཤཱིན་ཏུ་དད་པས་སོ།",
    "གང་ཞཱིག་གཱིས་ཚིགས་སུ་བཅད་པ་དང་གླུར་བླངས་པས་བསོད་པ་བྱས་ན་དེ་ཡང་རོ་རེ་འཛིན་པ་དང་འད་བར་འགྱུར་རོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གསོལ་བ་ནཱི་བསཱི་སོང་ཐོག་མར་བྱས་ཏེ་གསོལ་བ་འདེབས་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའཱི་ཏཱིང་ངེ་འཛིན་ལ་བཞུགས་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་གཙོ་བོའོ།",
    "འདཱིའཱི་ཕྱག་ནཱི་རོ་རེ་མངའ་བས་ན་ཕྱག་ན་རོ་རེ་སེ།",
    "དཔལ་རོ་རེ་སེམས་དཔའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་གསོལ་བའཱི་ཚིག་ཐོས་ནས་ཞེས་བྱ་བ་ནཱི་གསོལ་བ་བཏབ་པའཱི་རེས་ཐོགས་ལའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "དེ་བྱཱིན་གཱིས་བརླབ་པའཱི་ཕྱཱིར་རོ་རེ་ལྟར་མཱི་ཕྱེད་པའཱི་ཏཱིང་ངེ་འཛིན་གང་དོན་དང་མཐུན་པའཱི་མཱིང་འདཱི་཈ཱིད་ཅེས་བྱ་བའཱི་ཏཱིང་ངེ་འཛིན་གང་ཡཱིན་པ་དེ་ལ་སོམས་པར་ཞུགས་པའོ།",
    "སོམས་པར་ཞུགས་མ་ཐགཐབ་ཏུ་ཞེས་བྱ་བ་ནཱི་སོམས་པར་ཞུགས་པའཱི་རེས་ཐོགས་཈ཱིད་ལའོ།",
    "ནམ་མཁའཱི་དབྱཱིངས་ཐམས་ཅད་ཀཱི་རྡུལ་ཤཱིན་ཏུ་ཕ་མོ་དང་མ་཈མ་པར་སྤྲོས་པ་སེ།",
    "དེས་ན་ནམ་མཁའཱི་དབྱཱིངས་ཐམས་ཅད་ཀཱི་རྡུལ་ཤཱིན་ཏུ་ཕ་མོ་དང་མ་཈མ་པར་སྤྲོས་པ་཈ཱིད་ཀཱིས་སོ།",
    "རཱི་རབ་རཱིའཱི་རེ་མོར་རོ།",
    "རེ་མོ་རོ་རེ་དང་ནོར་བུ་དང་རཱིན་པོ་ཆེ་ལས་བྱས་པའཱི་ཁང་བུ་བརེགས་པར་བསྡུ་བ་མཛད་པའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་སུ་བདག་཈ཱིད་བྱཱིན་གཱིས་བརླབས་ཏེ་ཞེས་བྱ་བ་ནཱི་བདག་཈ཱིད་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་སུ་དམཱིགས་ནས་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་མ་཈མ་པ་཈ཱིད་དང་མཚུངས་པར་གྱུར་པ་སེ།",
    "མ་རུངས་པ་ཐམས་ཅད་གདུལ་བར་བྱ་བའཱི་ཕྱཱིར་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱིར་གཏོགས་པའཱི་ཐུགས་རེ་ཆེན་པོ་དེས་བསེད་པའཱི་ཐབས་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སཱིང་རེ་ཆེན་པོའི་ཐབས་སོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སཱིང་རེ་ཆེན་པོའི་ཐབས་དེས་བསེད་པའཱི་ཏཱིང་ངེ་འཛིན་གང་ཡཱིན་པ་དང་།",
    "དེའཱི་ཡེ་ཤེས་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སཱིང་རེ་ཆེན་པོའི་ཐབས་ཀཱི་ཏཱིང་ངེ་འཛིན་གཱི་ཡེ་ཤེས་སོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སཱིང་རེ་ཆེན་པོ་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སཱིང་རེ་ཆེན་པོ་སེ།",
    "དེ་཈ཱིད་ནཱི་བསན་པའཱི་ཕྱཱིར་རོ་རེ་སེ་དེ་ལ་དམཱིགས་པའཱི་ཏཱིང་ངེ་འཛིན་དོན་དང་མཐུན་པའཱི་མཱིང་འདཱི་཈ཱིད་ཅེས་བྱ་བའཱི་ཏཱིང་ངེ་འཛིན་གང་ཡཱིན་པ་དེ་ལ་སོམས་པར་ཞུགས་པའོ།",
    "སོམས་པར་ཞུགས་མ་ཐག་ཏུ་ཞེས་བྱ་བ་ནཱི་སོམས་པར་ཞུགས་པའཱི་རེས་ཐོགས་཈ཱིད་ལ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་དམ་ཚིག་ཅེས་བྱ་བ་ལ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་ཞེས་བྱ་བའཱི་སྒྲ་ནཱི་འདཱིར་རོ་རེ་སེམས་དཔའ་ལ་སོགས་པ་སེམས་དཔའ་རྣམས་གཟུང་ངོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་དམ་ཚིག་ནཱི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པའཱི་དམ་ཚིག་གོ།",
    "དེ་ཕྱུང་མ་ཐག་ཏུ་ཞེས་བྱ་བ་ནཱི་སཱིང་པོ་བརོད་པའཱི་རེས་ཐོགས་཈ཱིད་ལའོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "ཕྱག་ན་རོ་རེའཱི་ཐུགས་ཀའཱི་རོ་རེ་ལས་ཞེས་བྱ་བ་ནཱི་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེའཱི་རང་གཱི་ཐུགས་ཀར་བསོད་པའཱི་ཚུལ་གཱིས་གཟུང་བའཱི་རོ་རེ་གང་ཡཱིན་པ་དེ་ལས་ཞེས་བྱ་བ་ཡཱིན་པའཱི་ཕྱཱིར།",
    "ཕྱག་ན་རོ་རེའཱི་ཐུགས་ཀའཱི་རོ་རེ་ལས་སོ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེ་དེ་཈ཱིད་རྫུ་འཕྲུལ་གཱི་སོབས་ཀཱིས་ན་རོ་རེའཱི་སྐུ་རྣམ་པ་མང་པོ་ཕལ་མོ་ཆེར་གྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀཱིས་ཕྱོགས་ཀུན་དུ་རོ་རེའཱི་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ཆེན་པོའི་ཚུལ་དུ་ཟ་བའཱི་དཀཱིལ་འཁོར་ལ་འདུག་སེ་ཞེས་བྱ་བར་སར་རོ།",
    "དེའཱི་ཕྱཱིར་རོ་རེ་དང་ལྕགས་ཀྱུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རོ་རེ་དང་།",
    "ཞགས་པ་ལ་སོགས་པ་གང་ཡཱིན་པ་དེ་དག་ནཱི་རོ་རེ་དང་ལྕགས་ཀྱུ་དང་།",
    "དེ་དག་ཀང་རོ་རེའཱི་མེ་ལྕེ་འབར་བའཱི་མཚོན་ཆ་ཕྱག་ན་བསྣམས་པ་཈ཱིད་ཡཱིན་པས་ན་རོ་རེ་དང་ལྕགས་ཀྱུ་དང་རལ་གྲཱི་དང་ཞགས་པ་ལ་སོགས་པ་རོ་རེའཱི་མེ་ལྕེ་འབར་བའཱི་མཚོན་ཆ་ལག་ན་ཐོགས་པའོ།",
    "ཕྱག་ན་རོ་རེའཱི་སྐུ་ལས་ཞེས་བྱ་བ་ནཱི་ཕྱག་ན་རོ་རེའཱི་ལུས་ལས་བྱུང་ནས་འཇཱིག་རེན་གཱི་ཁམས་ཐམས་ཅད་དུ་ཤཱིན་ཏུ་མ་རུངས་པ་ཐམས་ཅད་གདུལ་བ་བྱས་ནས་ཞེས་བྱ་བ་ནཱི་གདུལ་དཀའ་བ་ཐམས་ཅད་བཏུལ་ནས།",
    "ཕྱག་ན་རོ་རེའཱི་སྐུ་དེ་རྣམས་ཀང་ཟ་བའཱི་དཀཱིལ་འཁོར་ལ་འདུག་སེ་ཆེད་དུ་བརོད་པ་འདཱི་ཆེད་དུ་བརོད་པ་མཛད་དོ།",
    "ཁོ་བོ་ཆེན་པོའི་རོ་རེ་ཡང་ཡཱིན་པས་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཁོ་བོ་ཆེན་པོའི་རོ་རེ་སེ།",
    "རོ་རེ་ཧཾཧཱུྃ་མཛད་ཅེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་཈ཱིད་རོ་རེ་ཡཱིན་པས་དམ་ཚིག་རོ་རེའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་ཧཾཧཱུྃ་ཞེས་བྱ་བའོ།",
    "བྱུང་མ་ཐག་ཏུ་ཞེས་བྱ་བ་ནཱི་སཱིང་པོ་བརོད་པའཱི་རེས་ཐོགས་ཁོ་ན་ལའོ།",
    "འཇཱིག་རེན་གཱི་ཁམས་རབ་འབྱམས་ནཱི་རྒྱུན་ཏེ།",
    "དེས་ན་འཇཱིག་རེན་གཱི་ཁམས་རབ་འབྱམས་སྤྲཱིན་གཱི་རྒྱ་མཚོ་སེ།",
    "རོ་རེ་ཁོ་བོ་ཆེན་པོ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཁོ་བོ་ཡང་ཡཱིན་ལ་ཆེན་པོ་ཡང་ཡཱིན་པར་གྱུར་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "རོ་རེ་ཁོ་བོ་ཆེན་པོའི་སྐུ།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཧཾཧཱུྃ་མཛད་ཀཱི་སྐུ་སེ།",
    "དེ་འདཱིར་ནཱི་འཇཱིག་རེན་གསུམ་པོ་ཐམས་ཅད་ཀཱི་བདག་པོ་རྣམས་དགུག་པའཱི་ཕྱཱིར་བཀའ་ནོད་པ་ཡཱིན་ཏེ།",
    "གསོལ་བ་བཏབ་པའཱི་ཚེ་བཀའ་མནོས་མོད་ཀཱི།",
    "དེ་དག་གཱི་དམ་ཚིག་ནཱི་བཀའ་སེ་འཇཱིག་རེན་གསུམ་པོ་རྣམས་དགུག་པའཱི་ཕྱཱིར་བཀའ་བསོ་བའོ།",
    "དེ་཈ཱིད་ནཱི་འདའ་བར་བྱ་བ་མ་ཡཱིན་པས་ནཱི་རོ་རེའོ།",
    "དེ་བས་ན་དེ་ནཱི་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་དམ་ཚིག་གཱི་འགུགས་པ་རོ་རེ་སེ།",
    "དེ་ནས་དེ་བྱུང་མ་ཐག་ཏུ་ཞེས་བྱ་བ་ནཱི་སཱིང་པོ་བརོད་པ་དེའཱི་རེས་ཐོགས་཈ཱིད་ལའོ།",
    "འཇཱིག་རེན་གཱི་ཁམས་ཀང་ཡཱིན་ལ་ཐམས་ཅད་ཀང་ཡཱིན་པས་འཇཱིག་རེན་གཱི་ཁམས་ཐམས་ཅད་དོ།",
    "འཇཱིག་རེན་གཱི་ཁམས་ཐམས་ཅད་ཀཱི་རབ་འབྱམས་ཞེས་བྱ་བ་ནཱི་རྒྱུན་ཏེ།",
    "འཇཱིག་རེན་གསུམ་ཞེས་བཏགས་པ་ནཱི་འཇཱིག་རེན་པའཱི་ཚུལ་གཱིས་ས་འོག་གཱི་འཇཱིག་རེན་དང་།",
    "ས་སེང་གཱི་འཇཱིག་རེན་དང་།",
    "ལྷའཱི་འཇཱིག་རེན་དེ་འཇཱིག་རེན་གསུམ་མོ།",
    "འཇཱིག་རེན་ཐམས་ཅད་ན་གནས་པའཱི་གྲོང་དང་གྲོང་ཁེར་དང་ཡུལ་ལ་སོགས་པའཱི་ཚོགས་རྣམས་ཏེ།",
    "དེ་རྣམས་ཀཱིས་ཡོངས་སུ་བསྐོར་བས་ན་འཇཱིག་རེན་ན་གནས་པའཱི་ཚོགས་དེ་རྣམས་ཀཱིས་བསྐོར་བའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱིར་གཏོགས་པའཱི་དམ་ཚིག་གཱི་རོ་རེ་ཡཱིན་ལ་ལྕགས་ཀྱུ་ཡང་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་དམ་ཚིག་གཱི་རོ་རེའཱི་ལྕགས་ཀྱུའོ།",
    "དེའཱི་ཕྱཱིར་རཱི་རབ་རཱིའཱི་རེ་མོ་གང་ན་བ་དང་རེ་མོ་རོ་རེ་དང་ནོར་བུ་དང་རཱིན་པོ་ཆེ་ལས་བྱས་པའཱི་ཁང་བུ་བརེགས་པ་གང་ན་བ་ཞེས་གསུངས་ཏེ།",
    "ཕྱོགས་ཐམས་ཅད་ནས་རཱི་རབ་རཱིའཱི་རེ་མོ་རོ་རེ་དང་ནོར་བུ་དང་རཱིན་པོ་ཆེ་ལས་བྱས་པའཱི་ཁང་བུ་བརེགས་པར་བཀུག་ནས།",
    "བཅོམ་ལྡན་འདས་ཀཱི་ཁང་བུ་བརེགས་པ་རེ་མོ་རོ་རེ་དང་ནོར་བུ་དང་རཱིན་པོ་ཆེ་ལས་བྱས་པ་དེ་དག་ཐམས་ཅད་དུ་བསྐོར་ཞེས་བྱ་བ་ནཱི་ཕྱོགས་བཞཱི་ཆར་ནས་བསྐོར་ཏེ་འཁོད་དོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "ད་ནཱི་དེ་ནས་ཕྱག་ན་རོ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པས་གདུལ་བ་པོའི་བྱ་བ་སོན་པར་བཞེད་པའཱི་ཕྱཱིར་སོས་པ་ཡཱིན་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་བར་སྐབས་དེའཱི་རེས་ཐོགས་ལའོ།",
    "ཕྱག་ན་རོ་རེ་མངའ་བས་ན་ཕྱག་ན་རོ་རེའོ།",
    "རང་གཱི་ཐུགས་ཀ་ནས་རོ་རེ་དེ་བླངས་ཏེ་ཞེས་བྱ་བ་ནཱི་རང་཈ཱིད་ཀཱི་ཐུགས་ཀར་གཞག་པ་དེ་དེ་ནས་བླངས་ཏེ་གསོར་བ་ནཱི་གེན་དུ་འཕེན་ཞཱིང་འཕེན་ཞཱིང་འཛིན་པའོ།",
    "ཐམས་ཅད་དང་ལྡན་པའཱི་ཁམས་གསུམ་པ་ཇཱི་སེད་པ་ཐམས་ཅད་ཀཱི་འཇཱིག་རེན་གསུམ་གཱི་ཞེས་བྱ་བ་ནཱི་སོང་གསུམ་གཱི་སོང་ཆེན་པོའི་འཇཱིག་རེན་གཱི་ཁམས་ན་གཱིང་བཞཱིའཱི་འཇཱིག་རེན་གཱི་ཁམས་ཇཱི་སེད་པ་ཐམས་ཅད་གཟུང་ངོ།",
    "དཀཱིལ་འཁོར་ལ་བལྟས་ཏེ་ཞེས་བྱ་བ་ནཱི་དེ་ན་གནས་པའཱི་འཇཱིག་རེན་གསུམ་གཱི་འཁོར་ལོ་མ་རུངས་པ་ལ་བལྟས་ཤཱིང་བརགས་ནས་འདཱི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ་ཞེ་ན།",
    "དེ་ནས་འཇཱིག་རེན་གསུམ་གཱི་བདག་པོ་རྣམས་བསན་པ་ལ་འཇུག་པ་མ་ཤེས་ནས།",
    "དེ་ཐོབ་པའཱི་ཕྱཱིར་ཞེས་བྱ་བ་ནཱི་དེ་རེད་པར་བྱ་བའཱི་ཕྱཱིར་སྒྲུབས་ཤཱིག་ཅེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "འཇཱིག་རེན་གཱི་ཁམས་འདཱི་ན་ཞེས་བྱ་བ་ནཱི་གཱིང་བཞཱི་པའཱི་འཇཱིག་རེན་གཱི་ཁམས་ནའོ།",
    "དེ་ལྟར་ན་འཇཱིག་རེན་གསུམ་པོ་ཐམས་ཅད་ཀཱི་བདག་པོར་གྱུར་པ་དེས་དེགས་པའོ།",
    "ཡང་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་སར་བཀའ་སྩལ་པ་ནཱི།",
    "གལ་ཏེ་སྒྲུབ་པར་མཱི་བྱེད་ན་ཕྱག་ན་རོ་རེ་འདཱི་ཞེས་བྱ་བ་སེ།",
    "མ་རུངས་པ་ནཱི་སཱིང་རེ་མེད་པར་སོན་པའོ།",
    "རོ་རེ་འབར་བས་ཁམས་གསུམ་པ་འདཱི་དག་ཐམས་ཅད་བརླག་པར་བྱས་ལྟ་རེ་ཞེས་པའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀཱིས་བཀའ་སྩལ་པའཱི་རེས་ཐོགས་ལ།",
    "དགོད་པ་ནཱི་གད་མོའོ།",
    "ཕྱག་ན་རོ་རེ་ཞེས་བྱ་བ་ནཱི་བཅོམ་ལྡན་འདས་ཀུན་དུ་བཟང་པོའོ།",
    "མཛེས་པ་ལང་ཚོ་ལ་བབ་པ་ལུས་ལ་རྨ་མེད་པ་ཞཱིག་གནས་པ་ལས།",
    "དེར་ཡང་མཚན་མོར་གྱུར་ཏོ་སམ་ནས་མ་སྲེག་པར་གཞག་པ་དང་།",
    "དེ་ནས་དེའཱི་ག་཈ེན་རྣམས་ཀང་ནང་པར་རོ་བསྲེག་ཏུ་སོང་བ་དང་།",
    "དུར་ཁོད་ཀཱི་ཐལ་བས་ནཱི་ལུས་དང་མགོ་ལ་བྱུགས་ཤཱིང་གཏོར།",
    "དེ་ནས་ཡང་ལྷ་ཆེན་པོས་དེ་བས་ཀང་ཆེས་ལྷག་པའཱི་སྤྲུལ་པ་བསན་ནས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེ་ལ་འདཱི་སྐད་ཅེས་སྨྲས་སོ།",
    "འཇཱིག་རེན་གསུམ་པོ་མཐའ་དག་ཅེས་བྱ་བ་ནཱི་འཇཱིག་རེན་གསུམ་ན་གནས་པའཱི་སེ་བོ་དེར་ལྷག་པར་གཏོགས་པ་ཇཱི་སེད་པ་རྣམས་དང་གཞན་ཡང་ཕྱཱིའཱི་དངོས་པོ་རྣམས་ཁོ་བོ་ཆེན་པོས་ནོན་པར་བྱཱིན་གཱིས་བརླབས་ཏེ་རྣམ་པར་གཡོ་བར་བྱེད་ཅཱིང་འདཱི་སྐད་ཅེས་སྨྲས་སོ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་ཡང་དེ་཈ཱིད་ཀཱི་ཚིག་གཱི་དེགས་པ་གཞོམ་པར་བྱ་བའཱི་ཕྱཱིར་བཀའ་ནོད་པ་ཡཱིན་ནོ།",
    "རོ་རེ་ཆེན་པོ་ནཱི་དེ་བཞཱིན་གཤེགས་པའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀཱི་བཀའཱི་རེས་ཐོགས་ལ།",
    "བཅོམ་ལྡན་འདས་ཀཱིས་གདུལ་བའཱི་ཐབས་སུ་བསན་པའཱི་རོ་རེ་སཱིང་པོ་དེ་བརོད་པའོ།",
    "཈མ་ཐག་པའཱི་སྒྲ་འབྱཱིན་པར་གྱུར་ཅཱིང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དང་ཕྱག་ན་རོ་རེ་ལ་སབས་སུ་དོང་ངོ།",
    "ཕྱག་ན་རོ་རེ་འཇཱིག་རེན་གསུམ་པོའི་འཁོར་འདཱི་ཐམས་ཅད་ལ་སབས་བྱཱིན་པ་བྱོས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀཱི་བཀའཱི་རེས་ལ་ཕྱག་ན་རོ་རེ་ཁོ་བོ་ཆེན་པོའི་རྒྱལ་པོས་བཅོམ་ལྡན་འདས་ཀཱིས་བཀའ་སྩལ་པ་ཐོས་ནས།",
    "རོ་རེ་འབར་བ་འདཱིས་ཞེས་བྱ་བ་ནཱི་ཕྱག་ན་གནས་པ་འདཱིས་སོ།",
    "གཅཱིག་ཏུ་འབར་བར་བྱས་ནས་ཁེད་ཐམས་ཅད་ཀང་ཐལ་བར་བྱས་ས་རེ་ཞེས་བྱ་བ་ནཱི་སོག་མའཱི་ཕུང་པོ་བསྲེགས་པ་བཞཱིན་དུ་ཐལ་བར་བྱས་པའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཐུགས་བསེད་པ་དེ་ཞེས་བྱ་བ་ནཱི་཈ོན་མོངས་པ་ཟད་པ་རྣམས་ཀཱི་ཐུགས་སེད་པའོ།",
    "གདུལ་བ་ནཱི་཈ོན་མོངས་པ་བག་ཆགས་དང་བཅས་པས་སྤངས་པའཱི་ཕྱཱིར་རོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་ཡང་དེ་རྣམས་ཚར་གཅད་པར་བྱ་བའཱི་ཕྱཱིར་འདཱི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེ་ལ་ལྟ་ཞཱིང་ཞེས་བྱ་བ་ནཱི་ཡུལ་དེ་ལ་རབ་ཏུ་དད་པར་སོན་པ་སེ།",
    "དེ་ནས་དན་པ་མེད་པར་གྱུར་པ་ལས་དན་པ་རེད་པར་གྱུར་ཏེ་ལྡང་བར་འདོད་ན་ལྡང་མ་ནུས་སོ།",
    "བཅོམ་ལྡན་འདས་འདཱི་཈ཱིད་ཀཱིས་བདག་བཏུལ་བ་འདཱི་བྱས་ཀཱི་གཞན་ནཱི་སུས་ཀང་མ་ཡཱིན་ནོ་སམ་མོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀཱིས་དེ་ལ་བསམ་པ་དང་རེས་སུ་མཐུན་པའཱི་ལན་སར་གསུངས་པ་ཡཱིན་ཏེ།",
    "དེ་ནས་བར་སྐབས་དེར་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་ལྷ་ཆེན་པོ་ལ་བཀའ་སྩལ་པ།",
    "རོ་རེའཱི་ཕྱཱི་བཞཱིན་འབྲང་བ་ཡཱིན་པས་ན་རོ་རེའཱི་རེས་སུ་སོད་པས་སོ།",
    "དེ་ནས་དེ་སྐད་ཅེས་གསུངས་པ་དང་ཞེས་བྱ་བ་ནཱི་སཱིང་པོ་བརོད་པའཱི་རེས་ཐོགས་཈ཱིད་ལའོ།",
    "བཅོམ་ལྡན་འདས་རོ་རེའཱི་རེས་སུ་སོད་པས་རྐང་པ་བཀུག་སེ་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེའཱི་ཞབས་ཀཱི་དྲུང་དུ་བཞག་པ་སེ།",
    "ད་ནཱི་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་ཇཱི་ལྟར་བགཱི་ཞེས་པས་བཅོམ་ལྡན་འདས་ལས་བཀའ་ནོད་པ་ཡཱིན་ནོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀཱིས་རེས་སུ་གནང་བ་དང་།",
    "ད་ནཱི་བདག་཈ཱིད་ཆེན་པོ་འདཱིས་འདཱི་ལྟར་བཏུལ་ལོ་ཞེས་གད་མོ་འདེབས་ཤཱིང་འཕྱ་བའོ།",
    "སཱིང་པོའི་རེས་ཐོགས་཈ཱིད་ལ་ལྷ་ཆེན་པོ་ལ་བབས་པའཱི་སྡུག་བསྔལ་དེ་མེད་པར་གྱུར་ཏོ།",
    "དེ་ནས་ཡང་ཕྱག་ན་རོ་རེའཱི་ཞབས་ཀཱི་མཐཱིལ་གཱིས་རེག་པས་བདེ་བ་བླ་ན་མེད་པའཱི་གྲུབ་པ་སེ་འཚང་རྒྱ་བ་ཡཱིན་ནོ།",
    "དེ་ནས་བར་སྐབས་དེར་ལྷ་ཆེན་པོ་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེའཱི་ཞབས་ཀཱི་མཐཱིལ་གཱིས་རེག་པའཱི་བདེ་བ་ལ་རེག་པ་ལས།",
    "མྱོང་བ་ནཱི་དེ་དག་ལས་བྱུང་བའཱི་བདེ་བས་བདག་཈ཱིད་཈ོན་མོངས་པ་ཚིམ་པར་གྱུར་པའོ།",
    "ལྷ་ཆེན་པོའི་ལུས་ཕྱག་ན་རོ་རེའཱི་ཞབས་ཀཱི་མཐཱིལ་ལ་ཕུལ་བ་དང་།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀང་ཡཱིན་ལ་རོ་རེ་ཡང་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའོ།",
    "དེ་རྣམས་ཀཱི་དམ་ཚིག་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་དམ་ཚིག་གོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་དམ་ཚིག་ཀང་ཡཱིན་ལ་དཀཱིལ་འཁོར་ཆེན་པོ་ཡང་ཡཱིན་པས་ན་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེའཱི་དམ་ཚིག་གཱི་དཀཱིལ་འཁོར་ཏེ་དེར་ཞུགས་ཤཱིག་པའོ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་བཀའ་སྩལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེས་ལྷ་ལ་སོགས་པ་དེ་རྣམས་གཞུག་པར་བྱ་བའཱི་ཕྱཱིར།",
    "ཚུལ་བཞཱིན་དུ་བཙུད་ནས་ཞེས་བྱ་བ་ནཱི་སོའི་ཕྱཱི་རོལ་དུ་གཞག་པའཱི་བུམ་པ་རོ་རེས་བྱཱིན་གཱིས་བརླབས་པ་ལས།",
    "རོ་རེའཱི་ཆུའཱི་བསང་གཏོར་བྱས་ལ་དམ་ཚིག་གཱི་སྔགས་བརོད་པ་དང་།",
    "རོ་རེའཱི་ཆུ་བླུད་ལ་དེང་ཕྱཱིན་ཆད་ཁོད་ཀཱི་ཕྱག་ན་རོ་རེ་ང་ཡཱིན་གཱིས་ང་ལ་བརས་པར་མ་བྱེད་ཅཱིག་ཅེས་བྱ་བ་ལ་སོགས་པའཱི་དམ་ཚིག་བྱཱིན་ཞཱིང་སོམ་པ་འཛིན་དུ་བཅུག་ལ།",
    "རོ་རེ་དབབ་པ་བསེད་དེ།",
    "རོ་རེ་དང་རཱིན་པོ་ཆེའཱི་རཱིགས་གཅཱིག་ཏུ་བསྡུས་པའཱི་ཕྱཱིར་རོ།",
    "མཚན་མ་ཞེས་བྱ་བ་ནཱི་རེ་གསུམ་ལ་སོགས་པ་སོ་སོའི་ཕྱག་རྒྱའཱི་ཁད་པར་རོ།",
    "རོ་རེའཱི་མཚན་མ་ནཱི་མཚན་མ་རོ་རེས་བྱས་པ་སེ།",
    "མཛོད་སོང་ནཱི་ནོར་བྱཱིན་ནོ།",
    "སོགས་པ་ཞེས་སོས་པས་ནཱི་ཡུལ་འཁོར་སོང་ལ་སོགས་པའོ།",
    "འདཱི་དག་ཀང་བཅོམ་ལྡན་འདས་རོ་རེ་ཧཾཧཱུྃ་མཛད་འཇཱིག་རེན་གསུམ་གཱི་བདག་པོའི་རྒྱལ་པོ་ལ་སོགས་པ་ཁོ་བོའི་ཚོགས་ཀཱི་བདག་པོ་དང་།",
    "འཇཱིག་རེན་གསུམ་ན་བདག་པོ་ཡཱིན་པས་ན་འཇཱིག་རེན་གསུམ་གཱི་བདག་པོ་སེ།",
    "དེ་རྣམས་ཀཱི་ལྷ་མོ་ཡཱིན་པས་ན་འཇཱིག་རེན་གསུམ་གཱི་བདག་པོའི་ལྷ་མོ་ཐམས་ཅད་དོ།",
    "དེ་ལ་རོ་རེས་བྱཱིན་གཱིས་བརླབས་པ་ཞེས་བྱ་བ་ནཱི་རོ་རེའཱི་མཚན་མ་བྱཱིན་པའོ།",
    "རོ་རེའཱི་མཱིང་གང་དང་གང་ཡཱིན་པ་མ་བསན་པས་དེ་བསན་པར་བྱ་བའཱི་ཕྱཱིར།",
    "ཨུ་མའཱི་ཁོ་བོ་རོ་རེའཱི་མེའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདཱིར་རཱིག་པའཱི་རྒྱལ་པོ་རྣམས་ཀཱིས་ཇཱི་ལྟར་བསན་པ་དེ་བཞཱིན་དུ་ལྷ་མོ་རྣམས་ཀཱི་གོ་རཱིམས་ཀང་དེ་དང་འད་བར་ཤེས་པར་བྱའོ།",
    "མཱི་འཆཱི་མ་ནཱི་རོ་རེ་འཁཱིལ་པའཱི་འོ།",
    "ཟ་བ་རོ་རེ་མ་ནཱི་སང་རཱིར་བྱེད་ཀཱིའོ།",
    "བསོ་བ་མོ་ནཱི་རྒྱལ་བའཱི་འོ།",
    "ཞཱི་བ་མ་ནཱི་རོ་རེ་གཏུན་རཱིངས་ཀཱིའོ།",
    "མེ་ནཱི་རོ་རེ་འབར་བའཱི་འོ།",
    "ཀུ་བེ་ར་ནཱི་རོ་རེ་གཙིགས་པ་མའོ།",
    "རོ་རེ་ཁ་ནཱི་ཕག་གཱིའོ།",
    "ཙ་མུན་ཎྜཱི་ནཱི་གཤཱིན་རེའོ།",
    "སྣ་ཆད་མ་ནཱི་རོ་རེ་ཚོགས་བདག་གཱིའོ།",
    "དེའཱི་དམ་ཚིག་ནཱི་རོ་རེའཱི་དཀཱིལ་འཁོར་གཱི་དམ་ཚིག་གཱི་ཕྱག་རྒྱ་གང་ཡཱིན་པ་སེ།",
