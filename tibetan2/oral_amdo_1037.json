    "གང་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ལ་སོགས་པའོ།",
    "རེག་པ་ནཱི་གཟུང་བར་བྱའོ།",
    "རོ་རེ་ཕ་མོའི་ཚུལ་སར་ལ།",
    "ཞེས་བྱ་བ་ནཱི་ཕ་མོའི་རོ་རེ་བསོམ་པའཱི་སོར་བ་གོམས་པར་བྱས་པའོ།",
    "རོ་རེ་དབྱཱིངས་ལ་སོགས་པའཱི་དཀཱིལ་འཁོར་འདཱི་དག་ཐམས་ཅད་ནཱི་རོ་རེ་དབྱཱིངས་ཏེ་རྣམ་པར་སྣང་མཛད་ཀཱིས་བསེད་པ་ཡཱིན་ནོ་ཞེས་ནཱི་འབྱུང་ན།",
    "གོ་རཱིམས་གང་གཱིས་རོ་རེ་དབྱཱིངས་སུ་འགྱུར་བ་དེ་མ་བསན་པས་ན།",
    "མཚན་མའཱི་མཆོད་རེན་བྱཱིན་བརླབས་ཏེ།",
    "བདག་཈ཱིད་རོ་རེ་དབྱཱིངས་སུ་བསོམ།",
    "ད་ནཱི་རོ་རེ་བཅཱིང་བ་ཞེས་བྱ་བ་ལ་སོགས་པས་དམ་ཚིག་གཱི་ཕྱག་རྒྱ་སོན་ཏེ།",
    "སེམས་དཔའ་རོ་རེ་མ་ལ་སོགས་པ་ལས་མཛུབ་མོ་ག་཈ཱིས་དང་མཐེའུ་ཆུང་ག་཈ཱིས་གཤཱིབས་ན་རོ་རེ་རེ་གསུམ་པའཱི་དམ་ཚིག་ཡཱིན་ནོ།",
    "རོ་རེ་ཕ་མོའི་ཚུལ་དུ་ནཱི།",
    "ཞེས་བྱ་བ་ནཱི་སོར་བ་གང་གཱིས་སྣའཱི་རེ་མོར་རོ་རེ་ཕ་མོ་བསོམ་པའཱི་སོར་བ་དེ་཈ཱིད་ཀཱིས་རབ་ཏུ་མ་཈མ་པར་བཞག་ནས།",
    "དཀཱིལ་འཁོར་པདྨའཱི་འདབ་མ་སོར་མོ་ག་཈ཱིས་ཙམ་གཱི་ཚོད་དུ་སྣའཱི་རེ་མོར་དམཱིགས་ཤཱིང་བསོམ་པ་སེ།",
    "རོ་རེ་ཕ་མོའི་དཀཱིལ་འཁོར་ཏེ།",
    "རོ་རེ་ཕྱག་རྒྱ་ག་཈ཱིས་བཅཱིངས་ལ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་དཀཱིལ་འཁོར་འདཱིར་རོ་རེ་གང་གཱིས་བཟུང་ནས་སྒྲུབ་པ་དེའཱི་ཕྱག་རྒྱ་སོན་ཏེ།",
    "རོ་རེ་ཁུ་ཚུར་ག་཈ཱིས་བྱས་ན།",
    "རོ་རེ་ཕྱག་རྒྱ་ག་཈ཱིས་སུ་འགྱུར།",
    "ཞེས་བྱ་བ་དེ་ལྟ་བུའཱི་རོ་རེའཱི་ཕྱག་རྒྱ་ག་཈ཱིས་བཅཱིངས་པའོ།",
    "དེ་ག་཈ཱིས་རོ་རེ་དམ་དུ་གཟུང་།",
    "ཞེས་བྱ་བ་ནཱི་བསྒྲུབ་པར་བྱ་བའཱི་རོ་རེ་གང་ཡཱིན་པ་དེའོ།",
