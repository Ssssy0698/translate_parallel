    "འགྲོ་འདུག་སོགས་སྤྱོད་ལམ་གང་བྱེད་ཀྱང་དྲན་པས་རྩིས་ཟིན་པར་མཛོད།",
    "ཕལ་ཆེར་དྲང་དོན་རྒྱུ་འབྲས་བསླུ་མེད་ཡིན་ལུགས་རང་ཕན་ཡོན་ཆེ་བ་འདུག།",
    "དེ་ལ་སོགས་པ་ཁྱུ་བསགས་དལ་གཏམ་འདི་ལ་སྐྱོན་གཅིག་ལས་མི་འདུག།",
    "ཚེ་དུས་ལ་སྡོད་པའི་ལོང་ཁོམ་ནི་མི་འདུག།",
    "རང་རང་ཞིང་གནས་ཡིད་དུ་འོང་བ་ཡི།",
    "ད་ལྟ་ཉིད་དུ་རང་རང་གནས་སུ་གཤེགས།",
    "སྔ་འགྱུར་བསྟན་པའི་སྲོག་ཤིང་རང་གྲོལ་ཞབས།",
    "སེར་སྐྱ་ཀུན་ལ་རང་རང་བློ་འཚམས་ཀྱི།",
    "རང་སྡུག་ཉོ་བའི་ཟོང་རང་།",
    "ངེས་པར་ཡིན་པར་འདུག་པས།",
    "རང་རང་སོ་སོའི་གནས་སུ་གཤེགས།",
    "ག་འདྲ་མཛད་ཀྱང་ཁྱེད་རང་ཤེས།",
    "ཕ་དེ་རྗེས་ཟིན་པ་དཀའ་བ་འདུག།",
    "མཐུན་རྐྱེན་ཀུན་བསྒྲུབ་རང་རང་དངོས་གྲུབ་སྟེར།",
    "ལོ་ཟླ་ཞག་དུས་སྐག་རྣམས་བཟློག་པར་མཛད།",
    "གནས་འགྱུ་གཉིས་མེད་སྐྱེས་བུའི་འགྲོ་འདུག་བཞིན།",
    "ང་རང་དང་དཀྱིལ་འཁོར་གང་ལ་ནི་སྐྱོན་མ་བྱུང་།",
    "བདེ་ཡང་སྲིད་དམ་སྙམ་པ་ཤར་ཀྱིན་འདུག།",
    "ཅི་ལ་ཐོབ་ཀྱང་རང་ཆེས་འཕུང་སྒྲ་སྒྲོག།",
    "ལས་འཕྲོ་ཅན་གྱིས་ང་རང་དངོས་སུ་མཐོང་",
    "དེ་ནས་སྟེང་འོག་ཏུ་བལྟ་ཞིང་འདུག།",
    "ཁྱེད་རང་གང་དུ་གནས་པའི་གཞི་བདག་དེ་དང་བསྡོངས་ནས་གནོད་པར་བྱེད་དེ།",
    "ད་ལྟ་མ་ལྟོགས་པ་འདུག་བྱས་པས།",
    "རྡོ་རྫའི་རྒྱུའི་བྲག་ལ་སྲོག་ཆགས་ཀྱི་གཟུགས་ཀྱི་རང་བྱོན་ཞིག་འདུག་པར།",
    "གཞན་ལུས་བྱིངས་ཡོངས་རྫོགས་རྡོ་རྫ་བཟོ་ནས་ཟད་ཚར་བ་ཞིག་འདུག་པར།",
    "དེ་བཞིན་མང་དུ་བྱེད་འདུག་པར།",
    "སྐུ་ཞབས་པདྨ་འགྲོ་མགོན་རྡོ་རྗེ་དང་མཇལ་བར་སྐུ་ཞབས་ཉིད་དགྱེས་ཉམས་བསམ་གྱིས་མི་ཁྱབ་པ་མཛད་ཅིང་མཇལ་དར་ཡིན་གསུངས་ལྕགས་ཀྱི་ལྡེ་མིག་ཤིན་ཏུ་ཆེ་བ་ཞིག་གནང་བྱུང་བར་ང་ཡང་སྐུ་ཞབས་ཀྱི་ཕྱག་ཏུ་ཡི་དམ་དགོངས་འདུས་ཀྱི་པོ་ཏི་ཚང་མ་ཡིན་གསུངས་པོ་ཏི་མང་པོ་རང་ཞིག་འདུག་པར།",
    "ཞལ་འབྱེད་པའི་པོ་ཏི་གསུམ་པ་དེ་ཡིན་འདུག་པ་རྨིས།",
    "དེ་མ་ཐག་རྒྱ་དམག་བསམ་གྱིས་མི་ཁྱབ་ཞིག་འདུག་པར།",
    "བཞིའི་ཚད་ཙམ་པ་ཞིག་ལ་ཁང་པ་མེས་ཚིག་ཤུལ་སོལ་བ་ནག་འབྱམ་མེ་འདུག་པར།",
    "བུ་ག་གསུམ་རྩ་དབུ་རྐྱང་རོ་གསུམ་ཡིན་པར་འདུག།",
    "གནས་ཁྱད་པར་འཕགས་པ་ཞིག་ཡིན་པ་འདུག་བསམ།",
    "གཞན་ཡང་པོ་ཏི་བསམ་གྱིས་མི་ཁྱབ་པ་འདུག།",
    "དེ་ཡི་མར་ཙམ་ལ་ཌཱ་མ་རུ་རྒྱན་དང་ཅོད་པན་ཤིན་ཏུ་འཆོར་བ་ཞིག་འདུག་པར་བཀྲོལ་བས།",
    "ཌཱ་མ་རུ་གཡོགས་མེད་གཉིས་ལ་ཤོག་བསྒྲིལ་མང་པོ་བཅིངས་འདུག་པར།",
    "གཙང་པོ་དེ་ཡང་མཚོར་གྱུར་པས་རྦ་རླབས་རབ་ཏུ་འཁྲུགས་ཤིང་འདུག་པར།",
    "ད་ནི་མཚོ་རླབས་ཆེ་བའི་ཆབ་ལ་གཤེགས་ཚར་བ་ཡིན་འདུག་སྙམས་སེམས་སྐྱོ་བ་ལ་བཟོད་གླགས་མེད་པའི་ངང་ནས་སྐད་ཆེན་པོས་ངུས་པས།",
    "སྐད་ཅིག་མ་དེ་ལ་མཚོ་རླབས་ཞི་ནས་ང་རང་དང་ཉེ་བའི་སར་མཚོ་མཐའ་འདོམ་བཞི་ཙམ་ནས་ཉིད་རང་སྔོན་དུ་མཚོ་ཁར་ཆིབས་བཅས་མཇལ་བར་མཚོ་རླབས་འཁྲུག་པས་འོ་བརྒྱལ་ནས་ཕྱོགས་འཆོལ་ཀྱི་དགོས་ནས།",
    "ཀ་གནམ་གྱི་ཞལ་ངོ་རྣམས་ཀྱང་ཐུགས་དགྱེས་ཚོར་ཆེན་པོ་མཛད་འདུག་ཅིང་།",
    "བཞུགས་ཁྲིར་ཕེབས་ནས་མགུར་མ་མང་པོ་གསུངས་ཤིང་ཐུགས་སྐྱོ་བའི་རྣམ་འགྱུར་མཛད་འདུག་པས།",
    "ང་རང་གཉིས་དམ་ཚིག་ལ་སེལ་མེད་པར་བཟང་ལ་བརྒལ་བ་ཡིན།",
    "ཡང་ཕྱིར་ཉིན་ནམ་ལངས་ནས་ཅུང་ཟད་བདེ་འདུག་མ་ཤི་ཙམ་ཨེ་ཡོང་གསུངས་ནས་སེམས་གསོ་མཛད་འདུག་པས་དགོངས་པ་ཅན་གྱི་གསུང་ཡིན་པར་ཤེས།",
    "ལ་བར་གྱི་པདྨ་འཛོམས་པ་གཉིས་ངའི་མདུན་དུ་འདུག་ནས་རྣམ་འགྱུར་དང་སྤྱོད་པ་སྣ་ཚོགས་ཞིག་བྱེད་འདུག་གསུངས་པ་དང་།",
    "ཆང་མང་པོ་བཙོ་ནས་མགོ་མཐོ་བ་ཀུན་ལ་སྟེར་འདུག།",
    "ཆང་དེ་སྟེར་བ་དང་དཔོན་སྔ་མ་དེ་བྲག་ལ་ཐིམ་པས་ཤུལ་དུ་བྲག་དེ་ལ་གཟུགས་བརྙན་ཤར་འདུག།",
    "ཡང་མེ་ཏོག་དཀར་པོ་མང་པོས་བར་སྣང་གང་འདུག།",
    "འཁྲུག་བཅོས་འདི་སྐོར་མང་པོ་ཡོད་ཚོད་འདུག་རུང་གསུང་ཐུབ་པ་ཞིག་མ་བྱུང་",
    "ཟླ་བ་བཅུ་གཅིག་པའི་ཉི་ཤུ་ལྔ་དྲུག་ནས་བཟུང་བསྙུན་གྱི་ཟུག་རྔུས་འོ་བརྒྱལ་བའི་རྣམ་པ་མི་འདུག།",
    "བསྟན་བཅོས་རྩོམ་པ་སོགས་བག་ཆགས་བཟང་བ་ཡོད་འདུག་ཀྱང་།",
    "པར་བུ་དེ་ཞལ་འབྱེད་པས་ཚེ་སྒྲུབ་འོད་ཀྱི་དྲྭ་བའི་ཁ་བྱང་འདུག་པ་དེ་ཉིད་ལས།",
    "ཁ་བྱང་གཏེར་གནས་བྲག་རྔ་ལྡེབས་ལྟ་བུར་འདུག་པསདེ་ཉིན་ཐེའུ་གཟོང་སོགས་ལག་ཆ་མེད་སྟབས་ཐབས་ཟད་པས་ཕྱིར་ལོག་ནས་ཚེས་བཅུ་བདུན་ཕྱི་མ་ལ།",
    "སྟོན་པ་སྤྲུལ་པའི་སྐུ་ཤཱཀྱ་ཐུབ་པ་མཚན་གྱི་མེ་ཏོག་རྒྱས་པས་འཁོར་ཉན་ཐོས་དང་རང་རྒྱལ་བྱང་སེམས་ལ་སོགས་པར།",
    "ཏུ་འཛིན་འདུག་ཀྱང་།",
    "ང་ཆེ་ང་འཇིགས་ང་བཙན་ཟེར་མི་མང་པོ་འདུག་ཅིང་།",
    "གཞན་ཡང་གཙུག་ལག་ཁང་དང་རང་བྱོན་ཁྱད་པར་ཅན་ནོར་རྫས་ཀྱི་གཏེར་སོགས་རྣམ་གྲངས་བསམ་གྱིས་མི་ཁྱབ་པ་སྦ་བར་མཛད་པ་དེ་དག་ཐམས་ཅད་ཀྱང་དགོས་པ་དུས་ལ་བབས་ཚེ་ལས་ཅན་རྣམས་ཀྱིས་རིམ་པར་བཏོན་ཅིང་ཐོན་པར་འགྱུར་བ་ཕྱིའི་གཏེར་ཡིན་ནོ།",
    "དེ་དག་ནི་སྔ་མའི་བག་ཆགས་ཨ་འཐས་པ་ཡིན་པ་འདུག།",
    "ཕོ་ལོ་ཉེར་བདུན་ཉེར་བརྒྱད་རྣམས་སུ་མཁའ་འགྲོའི་ལུང་བསྟན་ཤིན་ཏུ་མང་བ་བྱུང་བ་རྣམས་ཡི་གེར་བྲིས་པར་རང་དང་སེམས་ཉེ་བའི་གྲོགས་མཆེད་འདྲ་ལ་བསྟན་པའི་ལོག་པར་ལྟ་བའི་ས་བོན་རང་དུ་འདུག་བསམ་མེ་ལ་བསྲེགས།",
    "ཐུགས་རྗེའི་གདངས་རྩལ་རང་སྣང་རང་ངོ་ཤེས",
    "ཡེ་ཤེས་རང་བྱུང་རང་ལ་གནས་པ་ལ",
    "རྡོ་རྗེ་ཅན་གྱི་གནས་ཀྱི་བཞུགས་བྱང་འདིར་བྲིས་པའི་དགོས་པ་མི་འདུག་སྙམ་བཞག། ས་ཁྱི་ཧོར་ཟླ་དགུ་པ་བྱི་བ་ཟླ་བའི་ཉི་ཤུ་གསུམ་གྱི་ཐོ་རངས་ཁར་རྨི་ལམ་ཞིག་ལ།",
    "བྲག་ལ་དགའ་བ་འཁྱིལ་པ་གསུམ་འཁྱིལ་ཤིན་ཏུ་གསལ་བ་ཞིག་ལ་སྦྲུལ་རིགས་ལྔ་ཡིས་འཁྲིལ་ནས་འདུག་པར།",
    "གུ་རུ་ཡབ་ཡུམ་གྱི་བཀའ་རྟགས་འདི་ཟབ་གཏེར་གྱི་མི་འགྱུར་མཚན་མ་ཞིག་ཡིན་ཚོད་འདུག།",
    "དཔལ་མགོན་མ་ནིང་རང་བྱོན་བཅས་ཤིན་ཏུ་གསལ་བ།",
    "སྒྲུབ་ཕུག་དེ་ཡི་ཕུ་ན་བརྩིགས་པ་ཞིག་འདུག་པ་དེ་འོད་འཁྱིལ་འཁྱིལ་འདུག་པར།",
    "འོད་དེ་སྔར་ལྟར་འདུག་པར་བརྩིགས་པ་བཤིག་པའི་མཚན་མ་དོན་བྱུང་བར།",
    "ད་ལམ་ཡང་ལག་ཐོག་ཏུ་ཁེལ་བ་ཞིག་མི་ཡོང་བས་བཞག་པ་རང་ལེགས་ཤིང་རང་ཉིད་མི་ངལ་བ་དང་གཞན་གྱི་ཡ་ག་མི་ཡོང་བའི་ཁྱད་ཆེ་བ་འདུག་ཞུས་པས།",
    "བོད་ཁམས་འཕུང་བྱེད་ཀྱི་དམ་སྲི་བཞིའི་གྲས་སྟག་འབྲོང་སྙབས་པ་ལག་རིང་ཞེས་འདུག་པར་དམ་སྲི་དེའི་འཕྲུལ་ཞིག་ཡིན་འདྲ་སྙམ་པའི་རྣམ་རྟོག་ཤར།",
    "གཏོར་ཟན་ཕྱག་ཏུ་བཞེས་མ་ཐག་བདུད་རྩི་ཕེབས་པ་བང་ཆེན་པས་ཀྱང་མཇལ་འདུག་ཅིང་།",
    "ཁ་བྱང་ལས་དུག་རིགས་རྣམ་པ་བཞིའི་བསྲུང་བའི་རྒྱ་ཡོད་གསུངས་འདུག་པར།",
    "པར་བུ་དེ་ཞལ་འབྱེད་པའི་ཚེ་སྒྲུབ་འོད་ཀྱི་དྲྭ་བའི་ཁ་བྱང་འདུག་པ་དེ་ཉིད་ལས།",
    "ཧཱུྃ་ཡིག་ཤིན་ཏུ་གསལ་བ་འདུག་ཟེར་ཡང་།",
    "ང་རང་ཡིད་ཆེས་པ་ཞིག་མ་མཐོང་བར།",
    "དུ་འདུག་པར།",
    "བདུད་རྩི་འཁྱིལ་པ་རང་རང་ཡུམ་གྱིས་འཁྱུད",
    "འདུག་འདུག་བྱུང་བྱུང་སྟོང་པ་ཉིད།",
    "ཁྱེད་རང་ཕུར་པ་མ་ཁུར་བར་འདི་ནས་ཡར་ལ་ཕེབས་ཀྱང་ས་བདེ་ས་ལ་ཐར་ཡང་བྲག་སོགས་དཀའ་སར་མི་ཐར་བའི་སྔོན་དུ་ཕུར་པ་ལེན་ཕེབས་པ་དྲག་མི་ཡོང་ངམ་ཟེར་བ་རྨིས།",
    "གསར་གསར་བསྡིག་བསྡིག་བྱེད་ཅིང་འདུག",
    "དུག་ལྕེ་གཡུག་གཡུག་བྱེད་ཅིང་འདུག",
    "ཨེ་དཀྲོལ་ཨེ་སྒྲོག་ཁྱེད་རང་ཤེས",
    "ད་ནི་ས་འདིར་ཡུན་རིང་རང་ཨེ་སྡོད་མི་ཤེས་ཤིང་།",
    "ད་མྱུར་དུ་མ་འགྲོ་ན་འདི་ཚོས་ཟ་བའི་ཉེན་འདུག་པས་འགྲོའོ་བྱས་པས།",
    "ང་རང་ཕར་ཡང་མ་ཕྱིན་པར་སྡོང་པོའི་རྩ་བར་སླེབས་འདུག་པར།",
    "རྦ་ལ་རྩེ་ཞིང་འདུག།",
    "ང་རྡོ་རྗེ་ཐོད་ཕྲེང་མཇལ་འདོད་ཀྱི་གདུང་བས་འཚོལ་ལོང་ཡང་མི་ཡོངས་འདུག་བྱས་པས།",
    "ལྟོས་དང་ཡེ་སྟོང་རང་གསལ་ངང་།",
    "ད་དུང་ཁ་ཙམ་མ་དམས་པར་སྔར་ལྟར་འདུག་པར་འདི་འདྲ་རང་ངོ་མཚར་ཤིན་ཏུ་ཆེ་སྙམ་པ་དང་།",
    "ཨེ་འདུག་ལྟོས་ཟེར།",
    "མི་འདི་འདྲའི་ངག་མི་སྙན་ཞིང་གཤིས་ངན་པ་ལ་ཟེར་འདུག།",
    "ཡང་ཕ་ཀི་ན་མི་མང་པོ་ཉ་རོའི་ཕུང་པོ་ཆེན་པོ་སྤུངས་ནས་འདུག་པར།",
    "ཁོ་ཁྲོས་ནས་རྡོ་མང་ང་ཡི་སྟེང་དུ་འཕེན་འདུག་ཅིང་།",
    "ཁོ་རབ་ཏུ་ཁྲོ་ཞིང་འདུག་པར།",
    "སྒོ་བསྲུང་པ་ལ་ཁྱེད་རང་དགོས་པའི་ཉ་ཤ་འདི་ན་ཡོད་པས་ད་ནང་དུ་གཏོང་བར་ཞུ་བྱས་པས།",
    "ད་འདི་ལ་བརླ་ཤ་མ་སྟེར་ན་ནང་དུ་མི་གཏོང་འདུག་པས་སྟེར་དགོས་སྙམ།",
    "མང་པོ་གཅིག་ཏུ་བསྡུ་བ་སོགས་རྫུ་འཕྲུལ་ཡ་མ་ཟུང་སྣ་ཚོགས་སྟོན་ཅིང་འདུག།",
    "དེ་དག་ཀྱང་དགྲ་ཡང་མི་བྱེད་གྲོགས་ཀྱང་མི་བྱེད་འདུག།",
    "དེ་ནས་ནང་སྒོའི་སྒོ་སྲུང་སྲིན་པོ་མིག་བདུན་པ་ཞིག་འདུག་པ་དེས་ང་ལ་ཅི་ཡང་མི་ཟེར་བར་ངོ་འཛུམ་འཛུམ་བྱེད་ཅིང་འདུག།",
    "ལྷ་བ་ཐམས་ཅད་འཁོལ་ཞིང་སྒལ་ནས་རྒྱལ་པོ་མཇལ་འགྲོ་འདུག་པར།",
    "ང་ཅག་སྲིན་པོའི་ཟས་སྐལ་ཞིག་ཡོང་བ་འདུག་ཟེར།",
    "ལྕགས་རིའི་ནང་དེར་སྔ་མ་འཕྲད་པའི་མི་དེ་དག་སོགས་མི་བསམ་གྱིས་མི་ཁྱབ་པར་འདུག་པར།",
    "སྲུང་པའང་གུས་གུས་ལྟར་གནས་འདུག།",
    "ལ་ལ་རྡོ་ཡི་འོག་ཏུ་ཆུད་ནས་ཤི་འདུག་པར།",
    "བསམ་པར་ཚེ་འདིར་ཀརྨ་ཐོད་ཕྲེང་རྩལ་དང་མི་མཇལ་བ་འདུག།",
    "ཁོ་བཟུང་ནས་ཆད་པ་གཅོད་པའི་གྲབས་འདུག་པར།",
    "ང་ཡིས་མི་འདི་ཚོད་མེད་ཧམ་རྒྱལ་ཁོ་ན་ཞིག་ཡིན་འདུག་ཀྱང་ད་ཁོ་རང་གང་དགར་གཏོང་བར་ཞུ་བྱས་ཀྱང་།",
    "གསེར་དཔོན་དེ་ཡང་སྔ་མའི་སྒོ་བསྲུང་དཔོན་དེ་ཡིན་འདུག་པར།",
    "མཁའ་འགྲོ་མ་མིག་གསུམ་མ་ཞིག་ལ་མཁའ་འགྲོ་མང་པོས་བསྐོར་ནས་འདུག།",
    "ནང་སྒོའི་དྲུང་ངུ་ཀེང་རུས་སྐམ་པོ་གཉིས་ལངས་ནས་སོ་དཀྲིག་བསྡད་འདུག་པར།",
    "དེ་དང་ལྷན་ཅིག་ནང་དུ་ཕྱིན་པའི་འོག་ཁང་ན་ཁྲོ་བོ་མིག་སྟོང་པ་ལྕགས་ཀྱུར་ཕུར་པ་བསྣམས་པ་ཞིག་ཁྲོ་བོ་བརྒྱད་ཀྱིས་བསྐོར་ནས་བཞུགས་འདུག།",
    "ཁྱེད་རང་འདི་ལ་བཞུགས་ཤིག་ཟེར།",
    "ངས་ཁྱེད་རང་དེར་བཞུགས་ང་གཞན་ཞིག་ཏུ་བསྡད་ཆོག་བྱས་པས།",
    "དེ་ནས་ཡང་ཕྱིན་པས་རྫིང་བུ་གཙང་ཞིང་ཡིད་དུ་འོང་བ་ཞིག་འདུག་པར།",
    "ད་དུང་གཞན་གྱིས་ཁྲུས་གསོལ་འཇུག་ཅིང་འདུག་སྙམ་པ་བྱུང་།",
    "གཞན་བཞི་པོ་དགའ་ཡང་དགའ་ལ་སྐྱེངས་ཡང་སྐྱེངས་པའི་རྣམ་འགྱུར་གྱིས་བསྡད་འདུག་ཅིང་།",
    "ཁོང་གཞན་བཞི་པོ་ཁ་ཕྱིར་ཕྱོགས་ནས་བསྡད་འདུག།",
    "རྫིང་བུའི་དབུས་ན་བེ་ཌཱུཪྻའི་ཕ་ཝོང་བུམ་པའི་དབྱིབས་ཅན་ཞིག་ཆུ་ཡན་ལག་བརྒྱད་ལྡན་དྲི་མཆོག་ཕུན་སུམ་ཚོགས་པ་འཁོལ་དུ་འདུག་པར།",
    "དེ་ནས་ཡང་སྔར་བཞིན་ཕྱིན་པས་མཚོ་དང་རི་ཡི་བར་དུ་དཔའ་བོ་མཁའ་འགྲོའི་འདུ་བ་བསམ་གྱིས་མི་ཁྱབ་པར་འདུག་པར་བསུ་བ་ཚོགས་འཁོར་སྔ་མ་བས་ཀྱང་ཆེས་ཆེར་ལྷག་པ་བྱུང་།",
    "མཁས་པ་ཆེན་པོ་བེ་རོ་ཙ་ནའི་དྲུང་།",
    "ཕྱི་ནང་མེད་པ་འཇའ་ཚོན་འོད་ཟེར་སྤུང་སྤུང་འདུག།",
    "ནོར་རྐུན་མར་ཤོར་དོགས་མི་འདུག་སྟེ།",
    "རང་གང་ཡོད་སྟོར་བ་མི་ཚོར་འདུག།",
    "འདི་ད་རུང་རང་སར་བཞག་ན་ལེགས།",
    "མཛོད་བཙན་པོའི་ནོར་དེ་རིབ་རིབ་འདུག།",
    "མི་ཡུལ་དེ་རུ་སྡོད་ཀྱང་འགྲོ་ཕན་མི་འགྲུབ་པའི་ཁར་རང་ངལ་བ་ལས་མི་འདུག་པས།",
    "ཅེས་སོགས་གསུངས་པ་དགོངས་པ་བཅོ་བརྒྱད་དག་འདུག་པས།",
    "དེ་འདྲ་ཡི་གེར་བཀོད་ཀྱི་རང་ཉིད་ངལ་བ་དོན་མེད་སྣག་ཤོག་གཟན་རོགས་འདུག་སྙམ་ནས་མ་བཀོད་དོ། གཞན་ཡང་གྲ་ཡུལ་ཧོ་གར་སོགས་དང་།",
    "སླར་ཡང་འདི་ལྟར་འགྱུར་ནས་འཆར་འདུག་གོ།",
    "ངས་འདི་མཚོ་གཉན་ཞིག་མིན་པ་འདྲ་འདུག་བྱས་པས།",
    "མཚོ་དེའི་ནང་ཕར་འབོག་ཚུར་འབོག་བྱེད་ཅིང་འདུག།",
    "ཟད་ཀྱི་དོགས་པ་ཅུང་ཟད་ཨེ་འདུག་གམ།",
    "སྐྱོན་ཅིག་འདུག་གོ་མི་རྟག་ནན་ཆེར་སྒོམས།",
    "གསལ་སྟོང་རང་རིག་བཀའ་ལས་མ་འདའ་ཞིག།",
    "ཐ་མ་ཚད་ངེས་ཀྱི་སེལ་བྱར་གསུངས་འདུག་ན།",
    "རང་ལུགས་གཉིས་ཀར་ཕུང་བོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུའང་མ་གྲུབ་པའི་རྟགས་ཀྱིས་རང་རྐྱང་བའི་བདག་མེད་ངེས་སུ་སྒྲུབ་པ་སྦྱོར་བ་ལྟར་སྣང་དུ་གསུངས་པ་དང་།",
    "ཡང་རང་རིག་ཡོད་དེ།",
    "སྔར་བྱི་བས་རྨུགས་ཚེ་དུག་ཞགས་འདུག་སྙམ་དུ་དྲན་པ་བཞིན་ནོ།",
    "གལ་ཏེ་སྔར་གྱི་སྒྲ་འཛིན་ལས་ཚུལ་གཞན་གཟུགས་འཛིན་གྱི་ཚུལ་དེ་ཉིད་ཚུལ་གཞན་ཡིན་ཡང་སྒྲ་འཛིན་དང་རང་བཞིན་གཅིག་ཡིན་པས་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "དེ་སྐད་ཅིག་གཉིས་པར་ཞིག་པ་ན་ཡང་རང་བཞིན་གྱིས་འགགས་པའི་ཕྱིར།",
    "ལུས་མ་ཟད་ཚོར་བ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ།",
    "ཚོར་བ་མ་ཟད་ཚོར་བ་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མིན་ཏེ།",
    "དེ་ལྟར་རང་བཞིན་གྱིས་གྲུབ་པའི་བདག་མེད་པའི་ཕུང་བོའི་ཚོགས་འདི་ལ་ཚོར་བ་སྡུག་བསྔལ་འདི་ཡིས་ཅི་སྟེ་གནོད་པར་བྱ་སྟེ་མྱང་བྱ་མྱོང་བྱེད་མྱོང་བ་པོ་གང་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱིས་བསྡུས་པ་ཐམས་ཅད་ཀྱི་སྐྱེ་བ་དང་གནས་པ་དང་འགག་པའང་རང་བཞིན་གྱིས་མ་གྲུབ་པས་ན།",
    "དེ་ལྟར་རང་བཞིན་གྱིས་མི་སྐྱེ་བ་དེ་ཡང་རང་བཞིན་གྱིས་མྱ་མན་ལས་འདས་པ་ཡིན་ལ།",
    "དོན་ཁས་བླངས་པ་ལ་གནས་པ་ཉིད་དུ་འདུག་པས་མིང་མ་སྦྱར་བར་ཟད་དོ།",
    "གཉིས་འཐུང་རང་བཞིན་མཛེས་པའི་གོམ་སྟབས་ལ།",
    "ལས་དང་པོ་པས་དེ་དག་སྤང་ཆོག་པའི་ལུང་དུ་སྦྱར་འདུག་པའི་ཕྱིར་རོ།",
    "འདུག་སྟངས་དང་།",
    "གཞན་གྱི་གདམས་ངག་སྒོམ་བཞིན་པར་འདུག་༡༡",
    "སྔར་རྒོལ་ཁྱེད་ལ་སྒྲུབ་བྱེད་རྣམ་དག་འགོད་རྒྱུ་ཏིལ་འབྲུ་ཙམ་ཡང་མི་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་གཉིས་དང་རང་ལུགས་༡༦",
    "ཕྱག་ཆེན་ཕྱག་རྒྱ་གསུམ་པར་བྱེད་དགོས་པའི་ངེས་པ་མི་འདུག་པའི་ཕྱིར་ཏེ།",
    "དངོས་བཏགས་ཀྱི་རྣམ་དབྱེ་ཅི་ཡང་མ་ཕྱེད་འདུག་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ངོས་བཟུང་འདུག་པའི་ཕྱིར་རོ།",
    "ཅེས་གསུང་དགོས་པ་བྱུང་འདུག་པའི་ཕྱིར་དང་།",
    "ཞེས་གཞུང་ལམ་གྱི་ཤེས་ཕྱིན་གྱིས་ཤེས་ཕྱིན་གྱི་གོ་མི་ཆོད་འདུག་པའི་ཕྱིར་དང་།",
    "གཞན་ལ་སྟོན་པའི་ངག་ཏུ་འདུག་པས།",
    "དོན་དམ་དོན་དམ་རང་རང་སྟེ།",
    "སེར་པོར་བཏགས་པའི་དུང་སེར་པོར་སྣང་ཡང་ཁོ་རང་དཀར་པོ་ཡིན་པ་བཞིན།",
    "དེ་ལྟར་མ་ཡིན་པར་དེའི་ཚེ་ཡང་རྣམ་རྟོག་ཁོ་རང་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "མིག་མ་བསླད་པས་དུང་སེར་པོར་མ་མཐོང་དཀར་པོ་ཁོ་རང་མཐོང་བ་བཞིན།",
    "རྣམ་རྟོག་ཁོ་རང་མཐོང་ཞེས་པ་དང་སྦྱར་དགོས་པ་ལས།",
    "ཞེས་སོགས་ཀྱང་རང་ལ་ཁས་བླངས་ནང་འགལ་བསྟན་པར་སྣང་སྟེ།",
    "གལ་ཏེ་ཁོ་རང་གཅིག་པུ་ལས་འབྲས་བུ་དུ་མ་བསྐྱེད་པའི་དོན་དུ་འཆད་དོ་སྙམ་ན།",
    "སླར་བསྔོ་བ་བྱེད་དགོས་བྱུང་འདུག་པའི་ཕྱིར་ཞེས་རྩོད་པའི་ལན་དུ།",
    "ཁོ་རང་བསྔོ་བའི་གོ་ཆོད་པའི་ཆིག་ཐུབ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ན་ཁྱེད་རང་བཞེད་པའི་གཤིས་ལུགས་ཕྱག་རྒྱ་ཆེན་པོ་ནི།",
    "དེས་ན་དེས་གཅིག་ཅར་བ་བཀག་གོ་སྙམ་ནས་ཐ་སྙད་དེ་བཟོ་བ་ལ་འཇིགས་འཇིགས་བལྟ་བའང་གདའ་སྟེ།",
    "ཁོ་རང་དང་མཚུངས་པར་ལྡན་པའི་སེམས་བྱུང་དྲན་པ་དེས་དམིགས་པ་དྲན་པ་དང་།",
    "རྒྱལ་བས་གསུངས་པའི་ས་ལམ་གྱི་རིམ་པ་ཐམས་ཅད་རྡོག་པས་བརྫིས་ཏེ་ཅིག་ཅར་དུ་བགྲོད་ཅེས་ཁས་མ་བླངས་འདུག་པའི་ཕྱིར་དང་།",
    "ཞེས་པའང་རང་ཉིད་ཀྱི་བློ་སྐྱོན་ཏེ།",
    "ཞེས་པ་དེར་གདའ་འོ།",
    "ཕྱག་ཆེན་པ་ཁོ་ནས་འབེན་དུ་ངོས་བླངས་གནང་རང་མི་དགོས་པ་འདྲ།",
    "ཞེས་བཀའ་སྩལ་པ་དེ་གདའ།",
    "གཞི་གནས་ལུགས་ལ་འགྱུར་བ་མི་གདའ་ནའང་།",
    "ལམ་དྲང་པོ་ཡ་ཡོ་མི་གདའ་ནའང་། ༨༧",
    "སྤྱོད་ལམ་འཕྲུལ་འཁོར་འགྲོ་འདུག་བྱ།",
    "གྲོགས་ལ་བྱ་འདུག་ནམ་མཁའ་འཕར།",
    "བྱའི་འདུག་སྟངས་བྱས་པས་ཐིག་ལེ་འགྲོངས།",
    "ཉམས་མྱོང་རང་གྲོལ་མཚོན་གྱིས་བསྣུན།",
    "དེ་ནས་ཡང་རང་ལུས་དང་སེམས་ནུབ་ཕྱོགས་ལ་སོགས་པའི་ཞིང་ཁམས་དཔག་ཏུ་མེད་པར་འཕངསདྲག་པོ་བྱ་ཞིང་།",
    "ཉལ་ཁར་སྣང་སྲིད་དང་རང་ལུས་རྨི་ལམ་ཡིན་སྙམ་དུ་དྲན་འདུན་བར་མ་ཆད་པར་བྱ་བ་ལ་ནན་ཏན་བསྐྱེད་པར་བྱ་སྟེ།",
    "ཉིན་ནུབ་བསྲེ་བ་དང་རང་སྣང་སྒྱུ་མར་དཔྱད།",
    "སྤྱོད་ལམ་བཞི་ཇི་ལྟར་སྤྱོད་ཀྱང་རང་བྱུང་རང་ཤར།",
    "གང་དུ་འདུག་ཀྱང་གཞལ་ཡས་ཁང་།",
    "བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "ཤེས་བྱ་གཤིས་ཀྱི་འདུག་ཚུལ།",
    "བདེ་བའི་སྟན་ལ་ཅི་བདེ་བའི་སྤྱོད་ལམ་གྱིས་འདུག་སྟེ།",
    "སྟན་ལ་འདུག་ནས་གསོལ་བ་གདབ་པ་ནི།",
    "བདེ་སྟོང་རང་རིག་རྟོགས་པ་དང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཐུན་གཉིས་པ་གསུམ་པ་ལ་སོགས་པ་ལའང་རང་ཉིད་བསམ་གཏན་གྱི་ཁང་པར་གནས་ལ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་ཕཊ་སྭཱ་ཧྭ།",
    "ཐུན་གཉིས་པ་དང་གསུམ་པ་ལ་སོགས་པ་ལའང་རང་ཉིད་བསམ་གཏན་གྱི་ཁང་པར་གནས་ཏེ།",
    "སྟེགས་བུའི་སྟེང་དུ་རྡོ་རྗེ་སློབ་དཔོན་རྒྱན་དང་བཅས་པ་འདུག་སྟེ།",
    "བལྟས་ཙ་ན་ཞེས་པའི་བར་གྱི་ཚིགས་བཅད་ཀྱི་རྗེས་ལ།",
    "ཕྱག་གཡས་པ་ཐམས་ཅད་རང་རང་རིགས་ཀྱི་ཕྱག་མཚན་དང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་ཧི་ལི་ཧི་ལི་བྷེ་རོཙ་ན་ཙཀྲ་ཝརྟི་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "དག་ཅིང་རང་བཞིན་དྲི་མེད་ཀྱིས།",
    "རྡོ་རྗེ་ཕྱེད་པའི་འདུག་སྟངས་ཀྱིས།",
    "བདུད་རྩི་བྱེད་ཙ་ན་ཚོགས་འཁོར་གཅིག་བྱས་ལ།"
