    "སོ་སོའི་མཚན་ཉིད་ལ་ཉོན་མོངས་བཅུ་ལས།",
    "ཉེ་ཉོན་ཉི་ཤུ་ཟེར་བ་ལྟ་བུའི་ཉོན་མོངས་རྣམ་གྲངས་མང་།",
    "དེའི་ནང་ནས་ད་ལྟ་འདིར་ཉོན་མོངས་གཙོ་ཆེ་བ་འདིར་ལྟ་བ་ལྔ་དང་ལྟ་མིན་ལྔ་བཅས་བཅུ་གསུངས།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "འདི་ཡང་རང་གི་དམིགས་པ་སྟེ་ཕྱི་དང་ནང་གི་ཡུལ་ལ་ཞེན་ཅིང་མཆེད་པ་མུ་མཐུད་ནས་སྲེད་པ་ཇེ་ཆེར་འགྲོ་བ་ཞིག་ཡིན།",
    "དོན་ལ་གང་ཡིན་ཀྱང་རང་གི་འཆར་སྣང་ལ་མི་འདོད་པའམ་རྒྱབ་ཀྱིས་ཕྱོགས་པའི་བློ་ཤུགས་དྲག་པོ་ཞིག་སྐྱེ།",
    "རྩ་ཉོན་གྱི་ཁོང་ཁྲོ་དང་ཉེ་ཉོན་གྱི་འཚིག་པ་དང་ཁྲོ་བ་དང་དེ་དག་གི་སྤུ་རིས་མྱོང་ཐོག་ནས་འབྱེད་དགོས་པ་ཡིན།",
    "གང་ལྟར་འདོད་ཆགས་དང་ཞེ་སྡང་གཉིས་རང་ཅག་གི་ཐུགས་དམ་གྱི་མཐིལ་ལྟ་བུ་བྱས།",
    "ཁྱོད་སྐྲག་མི་དགོས་རྒྱོབས་ཤིག་མཆོངས་ཤིག་ཟེར་བ་བཞིན་རང་གིས་ཀྱང་རྒྱག་རྐྱང་མཆོང་རྐྱང་བྱེད།",
    "དེ་ལྟ་ན་སྤྱིར་ཉོན་མོངས་ཐམས་ཅད་དང་དེའི་ནང་ནས་ཆགས་སྡང་གཉིས་པོ་འདི་ཤིན་ཏུ་ཐུ།",
    "འཇིག་ལྟ་ལ་བརྟེན་ཏེ་ཕྱིའམ་ནང་གི་མཐོ་དམན་དང་བཟང་ངན་ལ་དམིགས་ནས་སེམས་ཁེངས་པ་སྟེ།",
    "ཕྱི་ནང་གི་རྐྱེན་འདི་ལྟ་བུ་འཛོམས་ཡོད་པའི་སྐབས་ད་རེས་མི་བསྒྲུབ་ན་ནམ་བསྒྲུབརང་གིས་སྒྲུབ་དགོས་པའི་འགན་ཇི་ཙམ་གྱི་ཁག་པོ་དང་ལྗིད་པོ་ཞིག་ཡོད་ན་ཡང་།",
    "སེམས་ཀྱི་གཏིང་ནས་ཞུམ་པ་མེད་པར་སྤྲོ་སྣང་གི་སྒོ་ནས་ངས་བསྒྲབ་བསམ་པ་དེ་སྤོབས་པ་ཡིན།",
    "དེ་དག་གི་རང་བཞིན་ལ་རྨོངས་པ།",
    "དངོས་པོའི་གནས་ཚོད་ཡིན་པ་ཞིག་ལ་ལོག་ལྟ་ལ་སོགས་པས་རྐྱེན་བྱས་ནས་ཨེ་ཡོད་དམ་ཨེ་ཡིན་ནམ་བསམ་པ་ལྟ་བུ་ལྡོག་ཕྱོགས་ཀྱི་བློ་རྩེ་གཉིས་པ་དེ་ཉོན་མོངས་ཅན་གྱི་ཐེ་ཚོམ་ཡིན་སྙམ།",
    "ང་དང་ང་ཡི་བ་གང་ལ་དམིགས་ཀྱང་དམིགས་པ་ང་ལ་དམིགས་པ་གསལ་པོ་རེད།",
    "འཇིག་ལྟས་གང་བཟུང་བའི་བདག་དང་བདག་གི་བ་དེ་ལ་དམིགས་ནས་རྟག་པ་ཐེར་ཟུག་པའམ་འདི་ནས་ཕྱི་མར་ཉིང་མཚམས་སྦྱོར་བ་མེད་པའི་ཆད་པར་ལྟ་བའི་ཤེས་རབ་ཉོན་མོངས་ཅན་ནོ།",
    "སྐྱེ་བ་སྔ་ཕྱི་ཁས་མི་ལེན་མཁན་དག་གིས་བསམ་ཚུལ་གཅིག་དང་།",
    "ཆད་ལྟ་སྨྲ་མཁན་ཞིག་ལ་འདི་མཁས་པ་ཆེན་པོ་རེད།",
    "དོན་གྱིས་དེ་ཉིད་མཐོང་མཁན་རེད་བསམས་ནས་དེ་མཆོག་ཏུ་འཛིན་པའི་ལྟ་བ་མཆོག་འཛིན་ནི་ཤེས་རབ་ཉོན་མོངས་ཅན་ནོ།",
    "སྤྱོད་ཚུལ་དང་ལུས་དང་ངག་གི་འཇུག་པ་ངེས་པར་བྱེད་པའི་བརྟུལ་ཞུགས་དང་།",
    "ལུས་དང་ངག་གི་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཤེས་རབ་ཉོན་མོངས་ཅན་ཟེར་བ་དེ་དག་ལྟ་བ་ངན་པ་རེད།",
    "གོང་དུ་ཞུས་པ་བཞིན་དེ་གང་ལ་གང་འཚམ་གྱིས་དཔྱད་པ་བྱས་པའི་སྒོ་ནས་ངེས་པ་ལྟར་སྣང་རེ་དྲངས་པའི་ངེས་པ་ཅུང་ཙམ་ཡོད་པ།",
    "དེ་ལྟ་བུའི་ཉོན་མོངས་དེ་དག་དཔྱོད་པའི་ཤེས་རབ་ཀྱི་མཐུས་དཔེར་ན།",
    "ཤེས་རབ་ཉོན་མོངས་ཅན་ཟེར་བ་དེ་ལ་ཤེས་རབ་ཀྱིས་ནུས་པས་ཚར་གཅོད་ཐུབ་པ་ཞིག་ལ་ཟེར་དགོས་པ་མིན་ནམ།",
    "ཐག་པ་བསྡོགས་པ་ལ་མུན་པ་ཅུང་ཟད་བབ་སྟེ་ཐག་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "འཇིག་ལྟ་དེ་ལས་ཉོན་མོངས་གཞན་རྣམས་སྐྱེའོ།",
    "བློ་མི་གསལ་བ་ནག་མོག་མོག་ལྟ་བུ།",
    "དེ་ལས་ཉོན་མོངས་ཆགས་སྡང་སྐྱེ།",
    "དེ་དག་གི་འདོད་པ་ལྟར་ན་འཇིག་ལྟ་ཉིད་ཉོན་མོངས་ཀྱི་རྩ་བའོ།",
    "དེ་ལྟར་བཅད་ནས་རང་གི་ཕྱོགས་ལ་ཆགས་པ་དང་གཞན་གྱི་ཕྱོགས་ལ་ཞེ་སྡང་འབྱུང་ཞིང་བདག་ལ་དམིགས་ནས་ཁེངས་པ་ཡང་སྐྱེ་ལ།",
    "ཉོན་མོངས་པ་ཇི་ལྟར་སྐྱེ་ཞེ་ན།",
    "ཕྱོགས་རིས་དེ་ལ་བརྟེན་ནས་ཆགས་སྡང་གི་བློ་སྐྱེ་བར་གསུངས་སོ།",
    "གསུམ་པ་ཉོན་མོངས་པ་སྐྱེ་བའི་རྒྱུ་ནི་དྲུག་ལས།",
    "རྟེན་ནི་ཉོན་མོངས་པའི་བག་ལ་ཉལ་ལོ།",
    "ད་ལྟ་ཉོན་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "མོངས་མངོན་གྱུར་པ་མེད་ན་ཡང་།",
    "རྐྱེན་དང་འཕྲད་ན་དེ་མ་ཐག་ཉོན་མོངས་མངོན་ཏུ་གྱུར་པའི་ནུས་པ་དེ་ལ་ས་བོན་གྱི་བག་ལ་ཉལ་ཟེར།",
    "དམིགས་པ་ནི་ཉོན་མོངས་པ་ཆགས་སྡང་ལྟ་བུ་སྐྱེ་བའི་རང་གི་བློ་ལ་ཡིད་དུ་འོང་བ་དང་ཡིད་དུ་མི་འོང་བ་འཆར་བའི་ཉོན་མོངས་པ་སྐྱེ་བ་དང་མཐུན་པའི་ཡུལ་རྣམས་སྣང་བའོ།",
    "ཡང་ན་ཉོན་མོངས་པ་སྐྱེ་བ་དང་མཐུན་པའི་ཞེས་ཉོན་མོངས་པ་ཆགས་སོགས་སྐྱེ་བ་དང་རྗེས་སུ་མཐུན་པའི་ཡུལ་གཉེན་ཉེ་དུ་དགྲ་ལ་སོགས་པ་རྣམས་སྣང་བའོ།",
    "རང་ཉིད་འགྲོགས་འདྲིས་བྱེད་སའི་མིའི་གཤིས་ཀ་དེའི་རྐྱེན་གྱིས་རང་ཅག་ལའང་དེའི་ཤན་ནམ་དེའི་ཤུགས་རྐྱེན་ཞིག་ཐེབས་ཡོང་གི་འདུག།",
    "གོམས་པ་ནི་སྔོན་ཉོན་མོངས་པ་འདྲིས་པའི་སྟོབས་བསྐྱེད་པའོ།",
    "ཉོན་མོངས་གང་དང་གང་ཡིན་ལ་འདྲིས་ཐབས་བྱེད་པ།",
    "ཚེ་འདི་ལ་ཡིན་ན་ཡང་ཚེ་སྟོད་ལ་ཉོན་མོངས་གང་འདྲིས་ཆེ་བ།",
    "དེ་བཞིན་ཚེ་སྔོན་མའི་ཉོན་མོངས་གང་འདྲིས་ཆེ་བའི་སྟེང་ནས་ཁྱད་པར་ཡོད།",
    "སྡུག་མི་སྡུག་གི་མཚན་མ་སྒྲོ་འདོགས་པ་དང་མི་རྟག་པ་ལ་རྟག་པར་འཛིན་པ་སོགས་ཚུལ་མིན་ཡིད་བྱེད་དོ།",
    "འཇིགས་སྣང་ཙམ་ཡང་བྱེད་མི་དགོས་པར་ང་ཡང་སྐྱིད་ལ་ཁྱོད་རང་ཚོ་ཡང་མི་དཀའ་བ་ལྟ་བུ།",
    "ལས་ཞེས་པའང་ཀུན་སློང་གིས་རྐྱེན་བྱས་ནས་ལུས་ངག་གི་ལས་ཤིག་ཐོན་ཏེ་དེས་ལས་བསགས།",
    "སེམས་ཉོན་མོངས་པ་ཆགས་སྡང་གི་བློ་ཞིག་སྐྱེ་བའི་ཚེ་ཉོན་མོངས་པར་བྱས།",
    "ཚུལ་མིན་ཡིད་བྱེད་ཀྱིས་སྒྲོ་བཏགས་ནས་ཉོན་མོངས་སྐྱེ་བས་དམིགས་པ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་བྱེད་པ་དང་།",
    "ད་ལྟ་ཉོན་མོངས་སྐྱེ་བ་དེས་མ་འོངས་པར་ཡང་ཆགས་སྡང་མུ་མཐུད་ནས་སྐྱེ་བའི་བག་ལ་ཉལ་བརྟན་པར་བྱེད་བ་དང་།",
    "རིགས་མཐུན་གྱི་ཉོན་མོངས་མི་འཆད་པར་བྱེད་པ་དང་།",
    "ཆགས་སྡང་གི་རྐྱེན་གྱིས་གང་འཚམ་ཞིག་ནས་ཟས་གཅོད་པ་ལྟ་བུ།",
    "ཐ་མ་དེ་ལ་རང་སྲོག་རང་གིས་གཅོད་དགོས་པ་ལྟ་བུ།",
    "གཞན་ལ་ཡིན་ན་ཡང་ཅི་མི་སྙམ་པའི་བྱ་བ་བྱས་ཡོང་བ་རང་གཞན་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ལོངས་སྤྱོད་ལས་ཉམས་པ་དང་འཁོར་གྱི་ནང་དུ་སོང་བ་ན་ཡིད་ཞུམ་པ་དང་དགའ་བ་དང་མི་འཇིགས་པ་མེད་པ་དང་།",
    "འགྱོད་བཞིན་དུ་འཆི་ལ་ཤི་ནས་ཀྱང་ངན་འགྲོར་སྐྱེ་ཞིང་རང་གི་དོན་མི་འཐོབ་པའོ།",
    "འཁོར་གྱི་ནང་དུ་སོང་ནའང་ཐམས་ཅད་ཀྱིས་མི་དགའ་བ་བྱས་ཏེ་གཡོལ་འགྲོ་བ།",
    "ཚོགས་ཀྱི་ནང་དུ་སོང་ན་ཡིད་ཞུམ་པ་དང་།",
    "དཀར་ཕྱོགས་སྐྱོང་བའི་སྲུང་མ་རྣམས་ཀྱང་མི་དགའ་བ་ཆགས་པ་དེ་འདྲ་ཡོང་གི་ཡོད།",
    "ཉོན་མོངས་ལ་ཅུང་ཙམ་སྟངས་འཛིན་བྱེད་མ་ཐུབ་ན་ཡོན་ཏན་ཆེན་པོ་ཡོད་ནའང་ཅི་བྱེད།",
    "བྱ་བ་ཚང་མ་ཉོན་མོངས་ཀྱིས་བསྐྱེད།",
    "དེ་ཐམས་ཅད་ཉོན་མོངས་ཀྱི་ཉེས་དམིགས་ཡིན།",
    "མི་ཚེ་སྟོང་ཟད་དལ་འབྱོར་སྟོང་ལོག་ཉོན་མོངས་ཀྱིས་བྱེད།",
    "རྟག་འཛིན་གྱི་བློ་ཉོན་མོངས་ཀྱིས་བསྐྱེད།",
    "སྐྱོན་ཐམས་ཅད་ཉོན་མོངས་ཀྱིས་འདྲེན་འོང་།",
    "དེའི་སྟེང་ཕན་ཐོགས་ཡོད་པ་དེ་དག་ཕལ་མོ་ཆེ་ཞེ་སྡང་དང་འདོད་ཆགས་མེད་པའི་ཕན་སེམས་ཀྱི་སྒོ་ནས་ཡོང་བ་ཞིག་ཡིན།",
    "གང་ས་གང་དུ་ཁྱི་སྨྱོན་པ་བཞིན་འཁྱམ་འགྲོ་བ་ཞིག་ཆགས་ཡོང་གི་མི་འདུག་གམ།",
    "ཆགས་སྡང་གཙོ་བོར་གྱུར་པའི་ཉོན་མོངས་པའི་དགྲ་ཚོགས་འདི་རྣམས་ནི།",
    "ཉོན་མོངས་དེ་དག་གིས་བདག་ཉིད་བྲན་བཞིན་དུ་བྱས།",
    "བདག་གི་སེམས་ལ་གནས་བཞིན་དུ།",
    "དགའ་མགུར་བདག་ལ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཅེས་གསུངས་པ་བཞིན་རང་རྒྱུད་ལ་ཡོད་པའི་ཉོན་མོངས་པའི་དགྲ་བོ་དེ།",
    "དེ་འདྲ་ཡིན་སྟབས་བདག་ལ་རྣམ་པ་ཐམས་ཅད་དུ་གནོད་འབའ་ཞིག་བྱེད་པའི་ཉོན་མོངས་ལ་བཟོད་བསྲན་བྱས་ནས་ཉོན་མོངས་ལ་དག་པ་བསྟེན་པ་ལྟ་བུ་ནི་གནས་མིན་པར་བཟོད་པ་སྨད་པའི་གནས་རེད་ཅེས་གསུངས།",
    "ཡང་ན་ཆགས་སྡང་གིས་མཚོན་པའི་ཉོན་མོངས་དེ་དག་གིས་རང་ཅག་ལ་དགྲ་ཟོན་བྱེད་དགོས་པ་གཏན་ནས་མེད།",
    "རང་ཅག་གིས་ཉོན་མོངས་ལ་ཁ་གཏད་གཅོག་གི་མེད་པས་ཉོན་མོངས་རྣམས་རྐང་བརྐྱངས་ལག་བརྐྱངས་བྱས་ནས་བསྡད་ཆོག་པའི་ཉོན་མོངས་ཀྱིས་ཟོན་བྱེད་མི་དགོས་པར་དགའ་མགུར་གནས་པའི་སྒོ་ནས་རང་ཅག་ལ་གནོད་པ་སྐྱེལ་གྱིན་ཡོད།",
    "དེ་ལྟ་བུའི་གནོད་བྱེད་མཐར་ཐུག་པ་རྣམ་པ་ཀུན་ཏུ་གནོད་པ་ཁོ་ན་སྐྱེལ་མཁན་ཉོན་མོངས་དེ་ལ་མི་ཁྲོ་བར།",
    "དེ་དག་གིས་ཀྱང་མནར་མེད་པའི།",
    "ཉོན་མོངས་སྟོབས་ཅན་དགྲ་འདིས་ནི།",
    "ཐལ་བ་ཡང་ནི་མི་ལུས་པ།",
    "དེའི་མེ་ནང་དུ་བདག་སྐད་ཅིག་གཅིག་ལ་འདོར་བར་བྱེད་ཀྱི་རེད་ཅེས།",
    "བདག་གི་ཉོན་མོངས་དགྲ་བོ་གང་།",
    "ཉོན་མོངས་རྣམས་ནི་བསྟེན་བྱས་ན།",
    "བདག་ལ་ཉོན་མོངས་པའི་དགྲ་བོ་དེས་རྣམ་པ་ཐམས་ཅད་དུ་འཚེ་བ་བྱེད་ཅིང་གནོད་པ་བྱེད་པ་ལས་ཕན་ཐོགས་གང་ཡང་མེད།",
    "ཐ་མལ་པའི་དགྲ་བོ་དེ་མི་ཚེ་གཅིག་གི་དགྲ་ཡིན་པ་མ་གཏོགས་ཚེ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "ཉོན་མོངས་པས་ཐོག་མཐའ་མེད་པར་རང་ལ་འཚེ་བ་བྱས་པ་བཞིན་ཐ་མལ་པའི་དགྲ་གཞན་སུས་ཀྱང་དེ་ལྟར་བྱས་མེད།",
    "དེ་ལྟར་ན་ཡང་ཉོན་མོངས་པའི་དགྲ་ལ་ཕར་ཇི་ཙམ་གྱིས་བསྟུན་ན་ཡང་དེའི་ཚོད་ཀྱིས་ཕྱིར་ཞིང་ཉོན་མོངས་པ་ཐུ་རུ་ཐུ་རུ་འགྲོ་བ་དང་།",
    "སྟོན་པ་བཀའ་དྲིན་ཅན་གྱི་བསྟན་པ་ལ་སྡང་བའི་ཞིང་བཅུ་ཚང་བའི་དགྲ་བོ་ཞིག་གིས་ཚེ་གཅིག་ཙམ་མ་ཟད་ཚེ་རབས་བརྒྱ་ཕྲག་གི་རིང་སྟོན་པའི་བསྟན་པ་ལ་སྡང་པོ་བྱེད་པ་ལྟ་བུའི་ཐ་མལ་པའི་དགྲ་ཡང་ཡོང་སྲིད་ཀྱང་དེས་ཇི་ཙམ་ཐུབ་ནའང་ལོ་ཁྲི་གཅིག་གཉིས་སམ་ཡང་ན་ལོ་འབུམ་ཁ་ཤས་དང་ས་ཡ་ཁ་ཤས་ཤིག་གི་གནས་ཚུལ་རེད་མ་གཏོགས་དེ་ལས་ལྷག་སྡོད་པ་ཕལ་ཆེར་མེད།",
    "ཉོན་མོངས་སྤོང་བ་ལ་ཉོན་མོངས་པའི་ཉེས་དམིགས་དང་མཚན་ཉིད་དང་གཉེན་པོ་དང་སྐྱེ་བའི་རྒྱུ་རྣམས་ཤེས་དགོས།",
    "རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་རྣམས་ངོ་ཤེས་པར་བྱས་ནས་ཆགས་སྡང་ལ་སོགས་པ་གང་རུང་རྒྱུད་ལ་སྐྱེས་ཙ་ན།",
    "ཁོ་བྱུང་ངོ་སྙམ་དུ་ངོས་བཟུང་གིན་ཉོན་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "མོངས་དང་འཐབ་པ་ཡིན་ནོ་གསུངས་པ་ལྟར་གོ་དགོས་པ་ཡིན་ནོ།",
    "ལྷག་པར་ཉོན་མོངས་པའི་ཀུན་འབྱུང་ཞེས་པ་གཉེན་པོ་བསྟེན་ནས་ལྡོག་རྒྱུ་ཡོད་པ།",
    "ཀུན་འབྱུང་ཉོན་མོངས་པ་ལ་གཉེན་པོ་བསྟེན་ནས་སེམས་དེའི་རྒྱུན་སྔ་མ་ཉོན་མོངས་དང་བཅས་པ་དེ།",
    "གཉེན་པོའི་སྟོབས་ཀྱིས་རྒྱུན་ཕྱི་ནམ་ནས་ཉོན་མོངས་སྤངས་པའི་བྲལ་བའི་ཁྱད་པར་དང་ལྡན་པའི་འགོག་པའི་བདེན་པ་ཐོབ་རྒྱུ་ཡོད་པ་ཞིག་ཡིན་གསུངས།",
    "བཅོས་རྒྱ་ཡོད་པས་རང་གིས་ཐབས་ཤེས་བྱས་ན་སྡུག་བསྔལ་ལས་ཐར་ཐུབ་པ་ཞིག་དང་།",
    "བདེ་བ་ཐོབ་ཐུབ་པའི་རེ་བ་བྱེད་ས་ཡོད་པ།",
    "སེམས་ཁྲལ་བྱས་ན་ཡང་དེའི་རང་བཞིན་བཅོས་སུ་མེད་པས་འཇོག་རྒྱུ་རེད།",
    "རང་ཅག་གིས་སྡུག་བསྔལ་མི་འདོད་པ་དང་བདེ་བ་འདོད་ཀྱི་ཡོད།",
    "རང་རེ་རྣམས་ཀྱིས་རྙེད་པར་དཀའ་བའི་དལ་འབྱོར་གྱི་མི་ལུས་ཐོབ།",
    "ད་ལྟ་རྟོགས་པ་དེ་ཡོངས་སུ་རྫོགས་པ་ཞིག་མ་བྱུང་ན་ཡང་རིམ་པས་རྟེན་བཟང་འདི་ལྟ་བུ་ཐོབ་ནས་ཇེ་བཟང་ཇེ་བཟང་དུ་འགྲོ་ཐུབ་པའི་རེ་བ་བྱེད་དགོས།",
    "རང་ཅག་མི་ཕལ་པ་ཞིག་གི་བསམ་པ་ལྟ་བུ་མ་ཡིན་པར་བློ་ཧ་ཅང་མཁས་པོ།",
    "དེ་ཡོང་བ་ལ་ཉོན་མོངས་པའི་གཉེན་པོ་བསྟེན་ནས་ཉོན་མོངས་སྤང་ཐུབ་པ་ཞིག་མ་བྱུང་བར་དུ་འབད་དགོས།",
    "ཉོན་མོངས་སྐྱེད་པའི་རྐྱེན་དང་འཕྲད་ཚེ་ཡང་ལས་གསར་དུ་གསོག་ཡོང་།",
    "དེར་བརྟེན་རིག་པ་བསྒྲིམ་དགོས་ས་དེ་ཉོན་མོངས་ལ་ཁ་གཏད་གཅོག་ཚུལ་དེ་ཡིན།",
    "ཉོན་མོངས་ལ་ཁ་གཏད་བཅག་ནས་ཉོན་མོངས་སེལ་ཐུབ་པ་ཞིག་བྱུང་ན་སྐྱོན་ཐམས་ཅད་རང་བཞིན་གྱིས་འགག་འགྲོ།",
    "དེ་ཡོང་བ་ལ་ཉོན་མོངས་མེད་པར་བྱེད་དགོས་ཀྱང་ལམ་སང་མགོ་མི་སྒུར་བས་དེ་ལས་སླ་པོའི་སྒོ་ནས་མེད་པ་བྱེད་མི་ཐུབ།",
    "ཉོན་མོངས་བྱེ་བྲག་པ་རྣམ་གྲངས་རེ་རེ་ལ་ཆ་བཞག་ན་ཡང་མཐུ་ཆེ་ཐག་ཆོད།",
    "ཉོན་མོངས་རྣམས་དང་གཡུལ་འགྱེད་ལ།",
    "ཉོན་མོངས་རྣམས་དང་གཡུལ་འགྱེད་པའི་གནས་སྐབས་ལ་སྡུག་བསྔལ་མང་པོ་འོང་བ་ཡོད།",
    "སྐྱིད་ཉལ་བྱས་ནས་ཉོན་མོངས་ལ་འཐབ་ཐུབ་པ་གཏན་ནས་མེད།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "ཉོན་མོངས་པའི་ཉེས་དམིགས་མཐོང་ནས།",
    "གཙོ་བོ་ཉོན་མོངས་ལ་གཉེན་པོ་བསྟེན་དགོས་པ་ཡིན་ཀྱང་།",
    "དེ་ལས་མིའི་ལུས་རྟེན་འདི་སྐྱེ་བའི་ཉིན་མོ་ནས་བཟུང་མིག་མ་བཙུམ་བར་དུ་སྡུག་སྡུག་ཅིག་གི་ངང་ནས་འགྲོ་རྒྱུ་ཡིན་པ་དེར་ཡག་པོ་ཤེས་ན་དེ་ལ་ངེས་པར་དུ་བཟོ་བཅོས་བྱེད་དགོས་བསམ་པ་ཞིག་བློ་ལ་འཆར་ཐུབ།",
    "ལྗོན་ཤིང་གི་རིགས་དང་འགྲོ་བ་ལ་སེམས་ཡོད་མེད་ཀྱི་ཁྱད་པར་ཆེན་པོ་ཡོད།",
    "ཞེས་གསུངས་པ་བཞིན་སེམས་ཞེས་པ་དེ་དྲི་མ་དང་འབྲལ་རུང་གི་རང་བཞིན་ཡིན།",
    "དེ་ལྟར་སྐྱེ་རྒ་ན་འཆིའི་སྡུག་བསྔལ་གྱིས་མཚོན་པའི་སྡུག་བསྔལ་འདི་ཐམས་ཅད་གཙོ་བོ་གང་གིས་ལན་པ་རེད་ཅེ་ན།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཐམས་ཅད་རྫོད་མཁན་དང་ལན་མཁན་དེ་ཉོན་མོངས་ཡིན།",
    "ཉོན་མོངས་དེ་མེད་པར་བྱེད་ཐུབ་ན་དག་པའི་ཕུང་པོ་ལྔ་ཐོབ་ཐུབ་པ་དང་།",
    "རིམ་པས་ཉོན་མོངས་པའི་བག་ཆགས་ཀྱང་མེད་པར་བྱེད་ཐུབ་ན་དོན་གཉིས་ཕུན་སུམ་ཚོགས་པའི་ཕུང་པོ་ཞིག་ཐོབ་ལོས་ཐུབ།",
    "ཉོན་མོངས་མེད་པར་བྱེད་པ་དེ་སྐབས་སུ་བབ་པའི་ལས་འགན་ཡིན།",
    "ཉོན་མོངས་ལ་རྩ་ཉོན་དྲུག་དང་ཉེ་ཉོན་ཉི་ཤུ་སོགས་ཉོན་མོངས་ཀྱི་རྣམ་གྲངས་མང་པོ་ཡོད།",
    "ཉོན་མོངས་པ་དེ་དག་ལ་སོ་སོར་བྱས་ནས་གཉེན་པོ་བསྟེན་ཚུལ།",
    "དེར་ཡང་ནས་ཡང་དུ་གོམས་པ་བསྲིང་ཐུབ་ན་བདེན་འཛིན་ལ་དངོས་སུ་གནོད་པའི་སྒོ་ནས་དེ་མེད་པར་བྱེད་པས་ཉོན་མོངས་ཐམས་ཅད་རང་ཤུགས་ཀྱིས་འགག་འགྲོ།",
    "ལས་ལ་སེམས་བྱུང་སེམས་པ་རྐྱང་རྐྱང་བཞག་ན་ཐོག་མར་རྒྱུའི་ཀུན་སློང་གི་གནས་སྐབས་ཀྱི་སེམས་བྱུང་སེམས་པ་དེ་སེམས་པའི་ལས་དང་།",
    "རྒྱུའི་ཀུན་སློང་སེམས་པ་དེས་ཀུན་ནས་བསླངས་པའི་ལུས་ངག་གི་ལས་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "སེམས་པ་དེས་ཀུན་ནས་བསླངས་པའི་ལུས་ངག་གི་ལས་ཏེ།",
    "དེས་བསྐྱེད་ལུས་དང་ངག་གི་ལས།",
    "ལུས་ངག་གི་ལས་ལ་རིག་བྱེད་དང་རིག་བྱེད་མ་ཡིན་པ་གཉིས་སུ་བྱས་ནས་གཟུགས་ཅན་ཁོ་ནར་བྱེ་བྲག་ཏུ་སྨྲ་བ་འདོད་པ་ལ།",
    "ལུས་ངག་གི་རིག་བྱེད་དང་མཉམ་དུ་འཇུག་པའི་སེམས་པ་ལ་བཞེད་པས།",
    "ལུས་ངག་གི་ལས་རྒྱུན་མཐུད་བཞིན་པའི་གནས་སྐབས་ཀྱི་དུས་ཀྱི་ཀུན་སློང་གི་སེམས་བྱུང་སེམས་པ་དེ་བསམ་པའི་ལས་ཡིན།",
    "བྱེ་བྲག་སྨྲ་བ་དང་ཐལ་འགྱུར་བ་གཉིས་ཀྱིས་ལུས་ངག་གི་ལས་གཟུགས་ཅན་དུ་བཞེད་ལ།",
    "བསམ་གཟུགས་གང་རུང་དུ་འཕེན་བྱེད་ཀྱི་ལས་དེ་དག་རང་གི་ས་དེ་དག་ཏུ་ལས་ཀྱི་འབྲས་བུ་རྣམས་སྨིན་པའི་ཕྱིར།",
    "རྒྱུན་ཞུགས་དང་ཕྱིར་འོང་གིས་ཀྱང་བདག་འཛིན་དང་དུ་མི་ལེན་ཅིང་།",
    "སྤྱིར་ཚོགས་ལམ་པ་དང་སྦྱོར་ལམ་པར་འཕེན་བྱེད་ཀྱི་ལས་རང་དགའ་བ་སོགས་ཡོད་ཀྱང་ངེས་འབྱུང་གི་བསམས་པ་དེ་ལྟ་བུས་ཀུན་ནས་བསླངས་པ་དང་།",
    "ཡང་སྲིད་ཕྱི་མ་བསྐྱེད་པའི་ཀུན་འབྱུང་དངོས་དང་རྗེས་སུ་མཐུན་པའི་ཀུན་འབྱུང་གིས་བསྡུས་པར་བཞག་གོ།",
    "རང་ཅག་གི་ཡང་སྲིད་ཅེས་པ་འདི་དག་གི་རིགས་ཡིན་དགོས།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "སྲིད་པའི་ཕུན་ཚོགས་ལ་ཞེན་པ་གཏིང་ནས་ལོག་པའི་ངེས་འབྱུང་གི་བསམ་པ་མེད་པ་ཅན།",
    "ཁ་ཕྱིར་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "འདོད་པ་ལ་ཡང་ཆགས་པ་ལོག་ཅིང་ཚོར་བའི་བདེ་བས་ཀྱང་ཡིད་སུན་ནས་ཚོར་བ་བཏང་སྙོམས་པའི་དོན་དུ་ལས་འདུ་བྱེད་ན་ནི་བསམ་གཏན་བཞི་པ་ནས་སྲིད་རྩེའི་བར་དུ་སྐྱེ་བའི་མི་གཡོ་བའི་ལས་གསོག་སྟེ།",
    "རང་གིས་དྲན་པའམ།",
    "རང་གིས་དྲན་པའམ་གཞན་གྱིས་དྲན་པར་བྱེད་ཀྱང་རུང་སྟེ།",
    "གོ་སྐབས་མཐའ་མ་དེ་རེད།",
    "གལ་ཏེ་མ་ཐུབ་ཀྱང་རོགས་པ་དག་གིས་དགེ་སེམས་སྐྱེ་བའི་ཐབས་ཤེས་བྱས་ནས་དེའི་རྒྱུད་ལ་དགེ་སེམས་ཡག་པོ་ཞིག་བསྐྱེད་ཐུབ་ན་སྐྱེ་བ་ཕྱི་མར་བདེ་འགྲོའི་ལུས་རྟེན་ཐོབ་པའི་རེ་བ་ཡོད།",
    "འཆི་བའི་དུས་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "རང་གིས་དྲན་པའམ་གཞན་གྱིས་དྲན་དུ་བཅུག་ཀྱང་རུང་སྟེ།",
    "འཆི་ཁར་རྐྱེན་ཞིག་གིས་ཁོང་ཁྲོ་ལངས་པ་དང་།",
    "ཡང་ན་ཆགས་སེམས་ཆེན་པོ་སྐྱེས་ན་ནོར་འཁྲུལ་ཤོར་ཚར་བ་རེད།",
    "གདུལ་བྱའི་ཁམས་དང་བསམ་པ་དང་འཚམ་པ་གནང་བ་དེ་ཧ་ཅང་རྩ་ཆེན་པོ་རེད།",
    "འཁྲིད་སྟངས་དེ་ཡང་ཕ་རོལ་པོའི་ཁམས་དང་མོས་པ་དང་འཚམ་ཞིང་རན་པ་ཞིག་གི་སྒོ་ནས་འཁྲིད་མ་ཐུབ་ན།",
    "མི་ཤི་བའི་རྗེས་མ་གཏོགས་མ་ཎི་བགྲང་གི་མེད་པ་ཨེ་ཡིན་སྙམ།",
    "དུས་རྒྱུན་བཏོན་ན་ཤི་བའི་རྣམ་རྟོག་ལངས་པས་མ་དགའ་བ་བྱེད་ཀྱི་ཡོད་ཚོད་རེད།",
    "གང་ལྟར་མིའི་ཁམས་དང་མོས་པར་རན་པ་བྱས་ནས་མ་བསུན་པ་བྱེད་པ་གལ་ཆེན་པོ་ཡིན།",
    "ཡང་ཁ་ཤས་ལ་མེའི་སྣང་བ་ལྟ་བུ་འདྲ་མི་འདྲ་ཅུང་ཙམ་ཡོང་གི་ཡོད་ཚོད་རེད།",
    "གིས་བདག་འདི་མེད་པར་འགྱུར་རོ་སྙམ་ནས་ལུས་ལ་དགའ་བར་འགྱུར་ཏེ།",
    "དེ་ལ་རྒྱུན་ཞུགས་དང་ཕྱིར་འོང་ལ་ཡང་བདག་ལ་ཆགས་པ་འབྱུང་མོད་ཀྱི་ཤེས་རབ་ཀྱིས་བརྟགས་ནས་སྤོང་གི་དང་དུ་མི་ལེན་ཏེ།",
    "རང་གིས་དེ་གཉིས་མ་དྲན་ལ་གཞན་གྱིས་ཀྱང་དྲན་པར་མ་བྱས་པའོ།",
    "དེ་མེད་ན་འཆི་སེམས་ཕྲ་མོའི་གནས་སྐབས་ལ་ལུང་མ་བསྟན་མ་གཏོགས་མེད་པས།",
    "རང་གི་རྒྱུན་ལྡན་གྱི་དྲན་པ་རགས་པ་དེ་དག་ཉམས་པས་གནས་མི་ཐུབ།",
    "སྔོན་སྤྲོས་པ་ལ་དགའ་བས་ཡོངས་སུ་བསྒོས་པ་དང་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "དགེ་མི་དགེ་གང་རུང་གི་ལས་དེ་གཉིས་བོ་དེ་ལ་བརྟེན་ནས་སོ།",
    "ཞེས་ལྷ་ཡི་བར་སྲིད་ནང་ཕན་ཚུན་རིགས་མཐུན་པ་དེ་དག་གིས་མཐོང་ཞིང་།",
    "མིའི་བར་སྲིད་པའང་རིགས་མཐུན་ནང་ཕན་ཚུན་མཐོང་གི་ཡོད།",
    "འདི་མཛོད་པའི་ལུགས་ཐུན་མོང་མ་ཡིན་པ་ཡིན།",
    "བྱས་པ་ཆུད་མི་ཟ་བ་ཞེས་དམིགས་བསལ་གྱི་འབྲེལ་བ་ཡོད་པ་དེ་གཅིག་གིས་གཅིག་ལ་ལས་ཀྱི་སྒོ་ནས་འབྲེལ་བ་བཤིག་མི་ཐུབ་པ་ཞིག་ཡོད།",
    "དཔེར་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "བུ་ཕྲུག་གི་ཆེད་དུ་ཕ་མས་དམིགས་བསལ་གྱིས་དགེ་རྩ་བསྒྲུབས་པ་ལྟ་བུ་བྱུང་ན་ཕན།",
    "ཕྱར་བ་ནག་པོའམ་མཚན་མོ་མུན་ནག་ཏུ་སྣང་བ་ལྟ་བུའོ།",
    "སྣམ་བུ་དཀར་པོའམ་ཟླ་བའི་འོད་དང་བཅས་པའི་མཚན་མོའི་སྣང་བ་ལྟ་བུའོ།",
    "གཟུགས་མེད་ནས་ཁམས་འོག་མ་གཉིས་སུ་སྐྱེ་ན་བར་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "ངན་སོང་གསུམ་ག་ལ་དགོངས་པ་འདྲའོ།",
    "རེ་ལྟར་ཐོགས་ནའང་ཞག་བདུན་དུ་གནས་སོ།",
    "ཡང་ཕ་ཡི་ཁུ་བ་ཡུན་རིང་པོར་གཙང་མར་ཉར་ཏེ་མ་ཉམས་པར་ཡོད་པ་མ་ཡི་མངལ་དུ་བཏབ་ནས་ཉིང་མཚམས་སྦྱར་བ་དེ་འདྲ་ཡང་ཡོང་གི་ཡོད།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "དེ་ཡང་མོར་སྐྱེ་ན་བུད་མེད་དང་འབྲལ་བར་འདོད་ཅིང་སྐྱེས་བ་ལ་ཆགས་ཏེ་ཉལ་བར་འདོད་དོ།",
    "ཕོར་སྐྱེ་ན་ནི་སྐྱེས་པ་དང་འབྲལ་བར་འདོད་ཅིང་བུད་མེད་ལ་ཆགས་ནས་ཉལ་བར་འདོད་དོ།",
    "དེ་ལྟ་བུའི་འདོད་པ་སྐྱེས་ནས་ཇི་ལྟ་ཇི་ལྟར་ཉེ་བར་ཕྱོགས་བ་དེ་ལྟ་དེ་ལྟར་སྐྱེས་པ་དང་བུད་མེད་དེའི་ཡན་ལག་གཞན་གང་ཡང་མི་སྣང་བར་ཕོ་མོའི་མཚན་མ་གཉིས་ཙམ་ཞིག་མཐོང་ངོ།",
    "དེའི་རྗེས་ལ་གཉིས་ཀ་ལས་ཁུ་ཁྲག་གི་ཐིགས་པ་གཉིས་གདོན་མི་ཟ་བར་འབྱུང་སྟེ།",
    "ལུང་གི་རྗེས་འབྲང་གི་སེམས་ཙམ་པས་ཀུན་གཞི་ཁས་ལེན་པ་ལྟར་བྱས་ན།",
    "ཀུན་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཟླ་བ་བརྒྱད་ཀྱིས་ནི་རྫོགས་མོད་ཀྱི་ཤིན་ཏུ་རྫོགས་པ་མིན་ནོ།",
    "དེ་ནས་དེར་དགའ་བ་དང་འདོད་པ་བསྐྱེད་དེ་སོང་བ་དང་སྐྱེ་བའི་གནས་ལ་ཁྲོས་ནས་བར་སྲིད་འགག་ཅིང་།",
    "གྲང་དམྱལ་དུ་སྐྱེ་ན་བསིལ་བ་འདོད་ནས་བར་སྲིད་འགྲོ་བར་འགྲེལ་པ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "སྟོན་པ་བཀའ་དྲིན་ཅན་གྱིས་རང་ཅག་གི་སྡུག་བསྔལ་འགག་སྟངས་དང་སྡུག་བསྔལ་སྐྱེ་སྟངས།",
    "བདེན་བཞི་གསུངས་པ་ན་རྟེན་འབྱུང་གསུང་གི་ཡོད།",
    "དེ་ཡང་ཅི་འདྲ་རེད་ཅེ་ན།",
    "ལམ་བསྒོམས་ནས་འགོག་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཀུན་ནས་ཉོན་མོངས་པས་ལས་བསགས་ཏེ་ཇི་ལྟར་བྱས་ཡོད་ཅེ་ན།",
    "རྟེན་ཅིང་འབྲེལ་བ་ཞེས་འབྲས་བུ་སྐྱེ་བའི་ནུས་པ་ཡོད་པ་འགྲོས་དང་མཐུན་པ་འབྲེལ་བ་ཡོད་པ་ཞིག་གི་སྒོ་ནས་སྐྱེ་དགོས་པར་བསྟན།",
    "དེ་དག་ཐམས་ཅད་འདིའི་སྟེང་ནས་ཡོང་གི་ཡོད།",
    "ཐོག་མའི་མ་རིག་པ་ནས་མགོ་བཙུགས་ཏེ་བསམས་ན་ཀུན་འབྱུང་གི་རྩ་བ་ངོ་འཕྲོད་ཚུལ་གྱི་ཁྱད་པར་ཞིག་ཡོད།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "སྐྱེ་བ་འགག་པ་དེ་སྲིད་པ་འགགས་པ་ལ་བརྟེན་ནས་བྱུང་བ་ཞེས་འགག་རིམ་ལུགས་ལྡོག་གི་སྒོ་ནས་བསམས་ན་རྒ་ཤིའི་རྟེན་བྱེད་པའི་ཉེར་ལེན་གྱི་ཕུང་པོ་འགྲུབ་བྱེད་ཀྱི་ཉོན་མོངས་རྣམས་འགགས་ནས།",
    "ལུགས་འབྱུང་གི་སྒོ་ནས་མ་རིག་པ་འགགས་པས་འདུ་ཤེས་འགག།",
    "ཤེས་པའི་རྒྱུན་སྐད་ཅིག་མ་མུ་མཐུད་ནས་ཡོད་པ་གཉེན་པོའི་སྟོབས་ཀྱིས་སྐད་ཅིག་སྔ་མ་ཉོན་མོངས་ཅན་དེ་སྐད་ཅིག་ཕྱི་མར་ཉོན་མོངས་མེད་པར་བྱས།",
    "ཡན་ལག་གི་དབྱེ་བ་དང་།",
    "ཡན་ལག་གི་བསྡུས་པ་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་བའི་ཚུལ་ལོ།",
    "དང་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "མཛའ་བ་དང་བདེན་ཚིག་གི་འགལ་ཟླར་གྱུར་པའི་མི་མཐུན་ཕྱོགས་ལ་བྱེད་པ་ལྟར།",
    "དབུ་སེམས་ཐུན་མོང་ལྟར་གསུངས་པ་ཡིན་སྙམ།",
    "དེ་ལ་འདིར་གཉེན་པོ་རིག་པ་ནི་ཡང་དག་པ་གང་ཟག་གི་བདག་མེད་པའི་དོན་རིག་པ་ཡིན་པས་དེའི་འགལ་ཟླ་ནི་གང་ཟག་གི་བདག་ཏུ་འཛིན་པའི་འཇིག་ལྟའོ།",
    "ཐབས་མཁས་ལ་ཐུགས་རྗེ་ཆེན་པོ་དང་ལྡན་པའི་སྟོན་པ་བཀའ་དྲིན་ཅན་རང་ཉིད་ཀྱིས་རྒྱ་གར་མཐའ་འཁོབ་ཀྱི་རྒྱལ་པོ་ཨུ་ཏྲ་ཡ་ན་དང་ཡུལ་དབུས་ཀྱི་རྒྱལ་པོ་གཉིས་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལ་གྲོགས་སུ་གྱུར་ནས།",
    "དེའི་ལན་སྤྲོད་པ་གྲ་འགྲིག་པོ་ཞིག་མ་བྱུང་བའི་སྐབས་བཅོམ་ལྡན་འདས་ཀྱིས་སྲིད་པའི་འཁོར་ལོ་ཆ་ལྔ་པ་དེ་བྲིས་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "དེར་བརྟེན་གཙུག་ལག་ཁང་གི་སྒོ་འཕྱོར་ལ་སྲིད་པའི་འཁོར་ལོ་ཆ་ལྔ་པ་འབྲི་བའི་ལུགས་སྲོལ་ཞིག་བྱུང་བ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པ་བཞིན་གནས་ལུགས་མཐོང་བ་ལ་སྒྲིབ་པའི་བྱེད་ལས་ཅན་ཡིན་སྟབས་རྒད་མོ་ལོང་བ་ཞིག་བྲིས།",
    "རྫ་ཁོག་བཟོ་བའི་ཕྱི་ནང་གི་རྐྱེན་འཛོམས་པས་བུམ་པ་ལ་སོགས་པ་རྫ་ཁོག་འདྲ་མི་འདྲ་འདུ་བྱེད་པ་ཡིན་པས་དེའི་མཚོན་དོན་ལ་སྦྱར་བ་ཡིན།",
    "མིང་ཟེར་བའི་དོན་དེ་གཟུགས་ཅན་མ་ཡིན་པའི་ཕུང་པོ་བཞི་པོ་དེ་ལ་མིང་གི་བརྡས་བཏགས།",
    "མིང་ནི་ཕུང་པོ་ལྷག་མ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "དེ་ནས་མིག་གི་སྐྱེ་མཆེད་དང་རྣ་བའི་སྐྱེ་མཆེད་ལ་སོགས་པའི་སྐྱེ་མཆེད་དྲུག་གྲུབ་པ་ན་ལུས་ཀྱི་ཁྱད་པར་གྲུབ་པས་ལོངས་སྤྱོད་པ་བོ་གྲུབ་པའོ།",
    "རེག་པ་འོ་བྱེད་འདྲ་ཞེས་གདའ།",
    "ཞེས་དེ་ལྟར་རེག་པ་ཞེས་ཡུལ་ཡིད་དུ་འོང་མི་འོང་བར་མ་གསུམ་ཡོངས་སུ་གཅོད་པའི་རྗེས་ལ་ཡུལ་ཡིད་དུ་འོང་བ་ཞིག་ཡིན་ན་དེ་ལ་དམིགས་ནས་ཚོར་བ་བདེ་བ།",
    "མི་འོང་བ་ཞིག་ཡིན་ན་ཚོར་བ་སྡུག་བསྔལ་སྐྱེས་ནས་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞེས་གསུངས།",
    "ཚོར་བ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "བདེ་སྡུག་ཤུགས་དྲག་པོའི་མཚོན་དོན་ལ་ཚོར་བ་མིག་ལ་མདའ་རྒྱབ་འདྲ་ཞེས་མིག་ལ་མདའ་ཟུག་པ་དེས་ཡན་ལག་བདུན་པ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞེས་པ་དེ་མཚོན།",
    "རེག་པས་ཡུལ་གསུམ་བཅད་པ་དང་རྗེས་སུ་མཐུན་པར་ཚོར་བ་བདེ་སྡུག་བཏང་སྙོམས་གསུམ་སྐྱེས་བའོ།",
    "ཚོར་བའི་རྐྱེན་གྱིས་སྲེད་པ་སྐྱེ་བར་གསུངས་པ་ནི་མ་རིག་པའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་སྲེད་པ་བསྐྱེད་ཀྱི།",
    "འདིར་མ་རིག་པས་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་སྲེད་པ་བསྐྱེད་པ་ཡིན།",
    "དེ་ལྟར་ན་རེག་བ་ནི་ཡུལ་གྱི་ལོངས་སྤྱོད་དང་།",
    "དེ་ལྟ་བུའི་སྒོ་ནས་ཉོན་མོངས་ལ་ཉེས་དམིགས་སུ་མཐོང་ཐུབ་པ་ཞིག་དགོས།",
    "ཞེས་སྲིད་པ་འཁོར་ལོའི་རི་མོའི་ནང་སྲེད་པ་མཚོན་བྱེད་ཆང་འཐུང་མཁན་གྱི་རི་མོ་ཡོད་པ་བཞིན།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "ཁྱིམ་པ་ལྟ་བུ་ལ་སྦྱར་ན་ཚེ་འདི་དོན་གཉེར་ཅན་དག་གིས་གཙོ་བོ།",
    "ལུས་གདུང་བྱས་པ་འབའ་ཞིག་གིས་གསུངས་པ་བཞིན།",
    "ཞེས་ལེན་པ་མཚོན་བྱེད་སྦྲེའུ་ཤིང་ཏོག་འཐོག་མཁན་གྱི་རི་མོ་བྲིས་ཡོད།",
    "སྤྱིར་བཏང་འདུན་པ་ཡུལ་ངེས་ལྔའི་ནང་གི་འདུན་པ་དེ་ཡིན།",
    "དེ་ལ་ཕལ་ཆེར་འདོད་ཆགས་ཡིན་པ་དང་མ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཞེས་སྦྲུམ་མ་བཙའ་རྒྱུ་ཡོད་པའི་རི་མོ་ཞིག་འབྲི།",
    "རྒྱུ་ལ་འབྲས་བུའི་མིང་གིས་བཏགས་པའོ།",
    "ཞེས་སྐྱེ་བའི་མཚོན་བྱེད་བུ་སྐྱེ་བཞིན་པའི་རི་མོ་འབྲི།",
    "ཞེས་རྒ་ཤི་མཚོན་བྱེད་རོ་འཁུར་བའི་རི་མོ་འབྲི།",
    "སྲེད་ལེན་རེག་པ་དང་ཚོར་བ་དེ་དག་ལས་བྱུང་བ།",
    "དེ་མེད་ན་ཉེ་བར་ལེན་པའི་ཕུང་བོ་འདིའི་སྟེང་གི་མི་འདོད་པའི་སྡུག་བསྔལ་སྣ་ཚོགས་པ་དེ་དག་འགག་འགྲོ།",
    "མིང་དང་གཟུགས་དང་སྐྱེ་མཆེད་དྲུག་དང་རེག་པ་དང་ཚོར་བའོ།",
    "རང་གི་ངོ་བོ་མ་གྲུབ་པས་མ་འོངས་པ་ན་སྡུག་བསྔལ་བར་འགྱུར་ལ།",
    "སའི་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "གང་གིས་འཕངས་ན་མ་རིག་པ་ལ་བརྟེན་པའི་འདུ་བྱེད་ཀྱིས་སོ།",
    "གང་གིས་འགྲུབ་པར་བྱེད་ན་སྲེད་པའི་རྐྱེན་ཅན་གྱི་ལེན་པས་སོ།",
    "སྲེད་ལེན་གྱིས་ཡང་ཡང་གསོས་བཏབ་པས་ལས་ཀྱི་བག་ཆགས་མཐུ་ཅན་དུ་སོང་ནས་ཕྱི་མར་བདེ་འགྲོ་དེ་དག་ཏུ་སྐྱེ་བ་སོགས་འགྲུབ་བོ།",
    "དེ་ལྟ་བུའི་ཡན་ལག་བཅུ་གཉིས་པོ་དེ་ཡང་ཉོན་མོངས་པ་དང་ལས་དང་སྡུག་བསྔལ་གྱི་ལམ་གསུམ་དུ་འདུ་སྟེ།",
    "དང་པོ་བརྒྱད་པ་དགུ་ཉོན་མོངས།",
    "འཕེན་བྱེད་དང་འཕངས་པའི་ཡན་ལག་གི་བར་དུ་བསྐལ་པ་བགྲང་ལས་འདས་པས་ཆོད་པ་ཡོད་པའང་སྲིད་ལ།",
    "འགྲུབ་བྱེད་དང་གྲུབ་པ་གཉིས་དང་འཕེན་བྱེད་གསུམ་ལ་ཚེ་རེ་རེ་དགོས་ལ།",
    "འཕེན་བྱེད་དང་འགྲུབ་བྱེད་ཀྱི་བར་དུ་ཚེ་དུ་མས་ཆོད་ཀྱང་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "གཅིག་གི་མཇུག་ཏུ་གཅིག་མཐུད་པ་མ་ཡིན་ཀྱང་།",
    "གཅིག་མ་རྫོགས་གོང་ཡང་གསར་པ་ཞིག་གི་མགོ་བཙུགས།",
    "ཉོན་མོངས་པ་གསུམ་ལས་ལས་གཉིས་དང་།",
    "སྲེད་ལེན་དེ་ཡང་ཉོན་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "སྤྱིར་གསོས་འདེབས་མཁན་གྱི་རྐྱེན་དེ་ཡང་ཉོན་མོངས་ཀྱིས་བྱེད་པ་མ་བྱུང་ན་ལས་གཅིག་པུས་འབྲས་བུ་སྡུག་བསྔལ་སྟེར་མི་ཐུབ།",
    "དེས་ན་གཙོ་བོ་ལན་པ་དེ་ཉོན་མོངས་ལ་ཐུག་པ་གསལ་པོར་ཤེས་ཐུབ་ཀྱི་འདུག་གསུངས།",
    "དེ་ནས་བདེ་འགྲོ་གཉིས་ཀྱི་ཡན་ལག་བཅུ་གཉིས་ཀྱི་ལྡོག་འཇུག་སེམས་པ་ནི་སྐྱེས་བུ་འབྲིང་གི་སྐོར་རོ།",
    "སྡུག་བསྔལ་བརྒྱད་བསམ་པ་དང་སྡུག་བསྔལ་དྲུག་བསམ་པ་སོགས་རང་རང་གི་བློ་ལ་གང་ཞིག་འཁོར་ཆེ་བ་ཡོད་ནའང་དེ་དག་བསམ།",
    "རབ་ཏུ་མ་ཞི་བ་ཉོན་མོངས་པ་སྤྱི་དང་།",
    "ཚུལ་མིན་ཡིད་བྱེད་ཀྱི་རྣམ་རྟོག་གིས་སྒྲོ་བཏགས་ནས་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "རྫུན་པ་ཇི་ལྟར་བྱས་ཀྱང་ཁུངས་འཁྱོལ་བ་མེད་པ་འཇིག་རྟེན་སྤྱི་ལ་གྲགས་པ་ཡིན།",
    "དེ་བཞིན་འདིར་ཡང་ཉོན་མོངས་པ་ཆགས་སྡང་གི་རྩ་བ་དང་རྟེན་ས་དེ་འཁྲུལ་པའི་བློ་ཞིག་ཡིན།",
    "དེ་ཡང་ཐོག་མ་མེད་པ་ནས་རང་ལ་རྣམ་པར་ཤེས་པ་ཡོད་པ་དེ་སྲིད་དུ་ཉོན་མོངས་ཡོད་པ་ཞིག་ཡིན་ནམ་ཞེ་ན།",
    "ཆགས་སྡང་ཉོན་མོངས་དེ་དག་ཤུགས་ཆེན་པོ་སྐྱེ་བའི་སྐབས་ཡོད་ནའང་།",
    "ཤེས་པ་ནམ་ཡོད་ལ་དེ་དག་མངོན་གྱུར་དུ་ཡོད་པ་ཞིག་མིན་པ་རང་ཅག་གིས་མྱོང་བས་ཤེས།",
    "ཡུལ་གཅིག་ལ་དམིགས་ནས་མཐའ་གཅིག་ཏུ་བྱམས་བརྩེའི་བློ་ཧ་ཅང་འཇམ་པོ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "རང་ཅག་གི་སེམས་རྒྱུད་ཀྱི་དྲི་མ་ཆགས་སོགས་ཉོན་མོངས་དེ་དག་ཟད་རུང་བ་ཞིག་ཡིན་པ།",
    "མཐོང་ཚོད་ལ་ཆ་བཞག་ནའང་ཚེ་སྟོད་ལ་ཧ་ཅང་ཁོང་ཁྲོ་ཆེ་བའི་མི་ཞིག་ག་ལེ་ག་ལེར་སེམས་ལ་འགྱུར་བ་བཏང་ནས་རྗེས་སུ་ཁྲོ་བ་མེད་པ་དེ་འདྲ་ཡོང་གི་ཡོད།",
    "བློ་སྐྱོན་དེ་དག་གི་མི་མཐུན་ཕྱོགས་ལ་གོམས་འདྲིས་བསྟེན་ནས་ཡར་རྒྱས་བཏང་ན་ག་ལེ་ག་ལེར་སྐྱོན་ཅན་གྱི་བློ་དེ་དག་ཤུགས་ཆུང་དུ་འགྲོ།",
    "སྤྱིར་དེ་ལྟ་བུའི་སྒོ་ནས་ཉོན་མོངས་ཟད་པ་དང་འགྲིབ་པ་ཡོད།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "རང་རྒྱུད་ཀྱི་དགེ་ཚུལ་སློང་གི་བསླབ་པ་ལ་གཅེས་སྤྲས་བྱོས་དང་ཚེ་འདི་དང་ཕྱི་མའི་དོན་ཆེན་སྒྲུབ་པའི་ནོར་བུ་ལྟ་བུ་ཡིན།",
    "དམིགས་ཡུལ་ཕུགས་ཐག་རིང་པོ་ཞིག་དང་རྒྱ་ཆེན་པོ་ཞིག་ལ་བསམས་ཏེ་དངོས་ཡོད་གནས་ཚུལ་གྱི་ལག་ལེན་ཇི་ལྟར་འགྲོ་དགོས་པ་དེ་ལག་ལེན་དགལ་དགོས་པ་རེད་མ་གཏོགས།",
    "དངོས་སུ་ལམ་གྱི་རྟོགས་པ་སྐྱེ་བར་མོས་སྒོམ་བྱེད་པ་གཅིག་པུས་མི་འོང་བར་ཁ་ཡོད་ལག་ཡོད་ཀྱི་ལག་ལེན་ཞིག་གི་སྒོ་ནས་སྐྱེ་དགོས།",
    "འུ་ཅག་གིས་རྟགས་ཆ་ལུགས་བརྗེས་ནས་ཐབས་མཁས་ལ་ཐུགས་རྗེ་ཆེན་པོ་དང་ལྡན་པའི་སྟོན་པ་བཀའ་དྲིན་ཅན་གྱི་རྗེས་སུ་འབྲངས།",
    "ཁོང་རང་ཉིད་ཀྱིས་བཞེས་པའི་ན་བཟའ་དེ་འདྲ་ཞིག་རང་ཅག་གིས་གྱོན་ཡོད་པས།",
    "སྤྱི་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "བཞི་པ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "དེ་ལྟར་ཡང་དབུང་བཟང་གིས་ཞུས་པའི་རྒྱུད་ལས།",
    "གསུང་གི་མཛོད་ཀྱི་གཅེས་པ་ཕ་བོང་ཁ་པའི་གསུང་འབུམ། ཅ་",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "ཟབ་མོ་སྟེ།",
    "མཆོག་ཟུང་གཅིག་གི་ཀུན་སྤྱོད་ནི་དུས་དུས་སུ་འགྲོ་བ་ལྔར་རྒྱུ་བ་ཡིན་པས།",
    "དེ་དག་གི་སྡུག་བསྔལ་རྣམས་བརྗོད་པར་མཛད་དོ།",
    "དེ་སྟོན་པས་གཟིགས་ནས།",
    "དེ་དག་འདོར་བར་འདོད་པ་དང་དེ་རྣམས་ཉེ་བར་ཞི་བ་ལ་ཐོབ་འདོད་བྱུང་བ་ཙམ་ནས་ངེས་འབྱུང་གི་བསམ་བ་ཙམ་ཡིན་མོད་ཀྱང་དེ་ཙམ་གྱིས་མི་ཆོག་པས།",
    "རིགས་པ་དྲུག་ཅུ་པའི་འགྲེལ་པ་ལས་ས་གསུམ་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "རང་ཉིད་མེ་འབར་བའི་མགྲོན་ཁང་ལྟ་བུ་ཞིག་གི་ནང་བསྡད་ཡོད་ན་སྐད་ཅིག་གཅིག་ཀྱང་དེའི་ནང་སྡོད་མི་ནུས་པ་དེ་མ་ཐག་སྒེའུ་ཁུང་ནས་མཆོང་བ་སོགས་ཐབས་སྣ་ཚོགས་ཀྱིས་ཐར་ཐབས་བྱེད་པ་ལྟར།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "དེ་ལྟར་ངེས་འབྱུང་གི་བསམ་པ་སྦྱང་།",
    "ངེས་འབྱུང་གི་བསམ་པ་དོན་དུ་གཉེར་བ་དག་གིས་དེ་སྒོམ་དགོས་ཀྱི།",
    "འགྲོ་བའི་སྡུག་བསྔལ་ཐམས་ཅད་བསྡོམས་པ་སྐད་ཅིག་རེ་རེ་ལ་ལུས་དང་སེམས་ལ་བབ་ཀྱང་།",
    "རང་གི་དོན་ཡང་མི་ནུས་ན་གཞན་གྱི་དོན་ལྟ་ཅི་སྨོས།",
    "དེ་ལྟར་མ་ཕྱེད་པར་སྔར་ལྟར་སྨྲ་ན་ནི་སྨྲ་བ་པོ་དེ་ལ་བྱང་སེམས་ཀྱི་སྡོམ་པ་ཡོད་ན་ཉེས་བྱས་ཉོན་མོངས་ཅན་ཞིག་བསྐྱེད་པར་བྱང་ས་ལས་གསུངས་ཏེ།",
    "ཚིག་མངས་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "གཞན་གྱི་དོན་ལ་བསམས་ནས་དང་དུ་བླངས་ན་འདི་ངོ་མཚར་སྐྱེ་བ་ཞིག་རེད་མ་གཏོགས་སྲིད་པའི་ཕུན་ཚོགས་ལ་གཞལ་མེད་ཁང་ལྟར་མཐོང་བའི་སྲེད་པ་ཅུང་ཟད་ཀྱང་ཁ་མ་བྲི་བར་གཞན་དོན་ལ་སྙད་བཏགས་ནས།",
    "དེ་ནས་ཉོན་མོངས་རང་མེད་པར་བྱེད་པ་རིམ་པ་གཉིས་པ།",
    "དེ་ནས་ཉོན་མོངས་དེས་བཞག་པའི་བག་ཆགས་མེད་པར་བྱེད་རྒྱུ་རིམ་པ་གསུམ་པ་སྟེ།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་ལ་ཕར་རྒོལ་བྱེད་པ་ལ་སྔོན་དུ་ཉོན་མོངས་པའི་ཉེས་སྤྱོད་ཀྱིས་རང་ལ་ཚུར་མི་གནོད་པ་ཞིག་བྱེད་དགོས་པས་ཐོག་མར་དེ་བྱས།",
    "མངོན་མཐོའི་ལུས་རྟེན་སྒྲུབ་པ་འདིའི་སྟེང་ནས་ཉོན་མོངས་ལ་ཁ་གཏད་དུ་ལངས་དགོས།",
    "གཙོ་བོ་མིའི་ལུས་རྟེན་གྱི་སྟེང་ནས་ཉོན་མོངས་ལ་ཕར་རྒོལ་བྱེད་པ་མ་གཏོགས་རྟེན་གཞན་གྱི་སྟེང་ནས་དཀའ།",
    "ཉོན་མོངས་ཀྱི་རྩ་བ་བདག་ཏུ་འཛིན་པའི་བདག་འཛིན་འདི་ལ་གཉེན་པོ་བསྟེན་ནས་རྒོལ་དགོས།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "དེ་ཡང་སྐབས་རེར་གོང་དུ་ཞུས་པ་བཞིན་སྒྲ་ཇི་བཞིན་པ་ལ་ཡིད་ཆེས་ཡོང་བ་དཀའ་ནའང་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ལ་བསམས་པས་དེ་ལས་ཐར་བ་ཞིག་བྱུང་ན་བསམ་པ་བློ་ལ་ཤར་རྒྱུ་འདུག།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་དང་ཉོན་མོངས་པས་མནར་ཚུལ་བསམ།",
    "སྐྱོ་མེད་འཇིགས་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཉོན་མོངས་ཟེར་བ་རང་གཞན་ཐམས་ཅད་ཕུང་ལ་སྦྱོར་མཁན།",
    "ཞེས་གསུངས་པ་བཞིན་གླེན་པ་རེད།",
    "ཞིབ་པར་བསམས་ན་ཉོན་མོངས་པ་ཐབས་རྡུགས་དེའི་བཙན་འོག་ལ་ཚུད་ཅིང་ཉོན་མོངས་ཀྱི་ཚེ་གཡོག་ཏུ་གྱུར་ནས་ཡོད།",
    "དཔོན་པོ་བཙན་པོ་ཡིན་ནའང་ཉོན་མོངས་པའི་ཚེ་གཡོག།",
    "ཚོང་པ་ཆེན་པོ་ཡིན་ནའང་ཉོན་མོངས་པའི་ཚེ་གཡོག།",
    "སྤྲང་པོ་གཉོམ་ཆུང་ཡིན་ནའང་ཉོན་མོངས་པའི་ཚེ་གཡོག།",
    "དཔོན་གཡོག་སོགས་གོ་ས་ཆེ་ཆུང་མ་གཏོགས་སྡུག་གིས་མི་ཚེ་སྐྱེལ་བ་མཉམ་མཉམ་རེད།",
    "ཉོན་མོངས་ལ་ཉོན་མོངས་སུ་ངོ་ཤེས་པར་བྱས་ནས་དེ་ལ་ཉེས་དམིགས་སུ་བལྟས།",
    "ཉོན་མོངས་ཀྱི་གཉེན་པོ་སྟོབས་ལྡན་སྐྱེས་ནས་ཉོན་མོངས་པའི་དགྲ་ལས་རྒྱལ་བ་ཞིག་བྱུང་ན་ངོ་མཚར་སྐྱེ་ས།",
    "མིག་དཔེ་ལྟ་ས་རེད་མ་གཏོགས་ཐམས་ཅད་ཉོན་མོངས་དེའི་གཡོག་པོ་རེད།",
    "ཚེ་གཡོག་ཙམ་དུ་མ་ཟད་ཐབས་རྡུགས་ཤོས་ཉོན་མོངས་དང་དུ་བླངས།",
    "ཉོན་མོངས་ལ་ཕལ་ཆེར་སྐྱབས་སུ་སོང་ནས་ཉོན་མོངས་ཀྱིས་གང་སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པར་བསླབ་ཚུལ།",
    "མང་པོ་ཞིག་གིས་དེ་མི་ཚེའི་ཆ་ཤས་ཤིག་ཡིན་བསམས་ནས་སྡོད་ཀྱི་ཡོད།",
    "དེ་ནོར་འཁྲུལ་ཆེ་ཤོས་རེད།",
    "དེ་བཞིན་དུ་སེམས་ལ་ན་ཚ་གཏོང་བ་དང་སེམས་མི་སྐྱིད་པ་ཡོང་བ་ཉོན་མོངས་ཀྱི་རང་བཞིན་ཡིན་ན་ཡང་དེ་ཅུང་ཙམ་ཆུང་དུ་གཏོང་ཐུབ་པའི་ཐབས་ཤེས་བྱེད་རྒྱུ་ཡོད་ན་བྱེད་དགོས་པ་དང་བྱེད་འོས་པ་ཞིག་ཡིན།",
    "རང་ཅག་གིས་སྡུག་བསྔལ་མི་འདོད་ཀྱང་བདེ་བ་འདོད་པ་རེད།"
  ]
}