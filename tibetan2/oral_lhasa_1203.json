    "སྐུ་གསུང་ཐུགས་ཀྱི་གསང་བ་སྟོན་པར་མི་སྤྱོད་པ་དེ་བྱིན་གྱིས་རློབ་མཛོད་དེ་བཀའ་སྩལ་དུ་གསོལ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་བར་དག་ཐོབ་པར་བགྱི་བའི་སླད་དུ་བསྟན་དུ་གསོལ་ཞེས་གསོལ་བ་བཏབ་པོ།",
    "དེ་སྐད་ཅེས་གསོལ་བ་བཏབ་པ་དེ་མཁྱེན་ནས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བྱིན་གྱིས་བརླབ་པ་མཛད་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་དབུས་སུ་ཡི་གེ་ཧཱུཾ་ལས་ཡོངས་སུ་གྱུར་པའི་འཁོར་ལོ་ལས་བྱུང་བའི་རྣམ་པར་སྣང་མཛད་རིག་མ་དང་བཅས་པ་ཞུ་བ་ལས་གྲུ་བཞི་གཞལ་ཡས་ཁང་དུ་གྱུར་པར་མཛད་དེ།",
    "དེ་ནམ་མཁའི་དབྱིངས་འདི་དག་ཐམས་ཅད་རྡོ་རྗེ་ངོ་བོར་གནས་པར་གྱུར་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་འདོད་ཆགས་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ་ཐབས་དང་ཤེས་རབ་ཀྱི་སྒྲས་གོང་དུ་ཞུ་བར་གསོལ་བར་མཛད་པའི་དེ་བཞིན་གཤེགས་པའི་འཁོར་དེ་དག་ཐམས་ཅད་ཉིད་ཀྱི་སྐུ་ལ་ཞུགས་པར་མཛད་དོ།",
    "ལ་ལ་ནི་གཟུགས་ཀྱི་ངོ་བོ་ལྟ་བུར་ཞེས་བྱ་བའི་བར་དུ་རིགས་སོ་སོ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་གྱུར་ཏེ།",
    "གཞིའི་རིག་མ་ལ་ཐིམ་པར་མཛད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་ཀུན་གྱི་གནས་སུ་བྱིན་གྱིས་བརླབ་པར་མཛད་དོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་སྐུ་གསུང་ཐུགས་རྡོ་རྗེའི་བདག་པོ་དེ་དཀྱིལ་འཁོར་ཆེན་པོའི་དབུས་སུ་མི་བསྐྱོད་པའི་བདག་ཉིད་དུ་བཞུགས་པར་གྱུར་ཏོ།",
    "དེ་ནས་མི་བསྐྱོད་པ་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རབ་ཏུ་ངོ་མཚར་སྐྱེས་པར་གྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་ཐུགས་ཀ་ནས་བྱུང་སྟེ།",
    "ཆེད་དུ་གླེང་བ་འདི་གསུངས་སོ།",
    "འཁོར་གྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་གསང་བའི་དཀྱིལ་འཁོར་ལ་འཁོད་ནས་ཆེད་དུ་གླེང་བ་འདི་གསུངས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ལྟར་སྦྱོར་བ་དང་པོ་རྫོགས་པར་མཛད་ནས།",
    "དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ལ་འཇུག་པའི་ཕྱིར་དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་བདག་པོ་རྡོ་རྗེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་གསོལ་བ་བཏབ་པར་མཁྱེན་ནས་ཞེས་འདིར་ཡང་སྦྱར་ཏེ།",
    "དེ་ལ་རྡོ་རྗེ་འཛིན་མཉེས་པའི་དམ་ཚིག་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ནི་རྡོ་རྗེ་རིགས་མཉེས་པར་བྱེད་པའི་ཡུམ་མཱ་མ་ཀཱི་ཡིན་པས་སོ།",
    "ཤར་ཕྱོགས་ཀྱི་གྲྭར་བཞུགས་ཞེས་པ་ནི་རིམ་པ་མ་ཡིན་པར་སྦྱར་ཏེ་དེ་ནི་ལྷོའི་གྲྭར་བཞུགས་པ་ཡིན་ལ།",
    "རྡོ་རྗེ་བརྫུན་གྱི་སྒོ་ནས་འགྲོ་བ་རྣམས་ཐབས་ཀྱིས་འདྲེན་པར་བྱེད་པའོ།",
    "དེ་ནས་ཁྲོ་བོ་ཆེན་པོ་རྣམས་དབྱུང་བར་བྱ་བའི་ཕྱིར་དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ།",
    "དེ་ལ་རྣམ་པར་སྣང་མཛད་རྡོ་རྗེ་ཞེས་བྱ་བ་འདིར་སྐུའི་ཁྲོ་བོར་བརྗོད་པས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བསྙེངས་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་ལོག་པར་རྟོག་པ་མི་གནས་པའི་ཚིག་གོ།",
    "རྡོ་རྗེའི་དམ་ཚིག་བསྙེངས་པར་བྱེད་པ་ནི་ཐུགས་ཀྱི་རྣམ་པར་རྟོག་པ་མི་མངའ་བར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་མཉེས་པར་བྱེད་པ་དཀྱིལ་འཁོར་གྱི་དམ་ཚིག་སེམས་དཔའ་རྣམས་སོ་ཞེས་བྱ་བ་ནི་ཁྲོ་བོ་འདི་བཞི་ཡང་སྐུ་གསུང་ཐུགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ལས་བྱེད་ཀྱི་བདག་ཉིད་ཡིན་པས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་གསོལ་བ་བཏབ་པ་ཡང་མཁྱེན་ཅེས་བྱའོ།",
    "སེམས་ཚིག་ཏུ་བརྗོད་པ་ལྟ་བུར་སྐྱེད་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "སེམས་དེ་ཉིད་བཛྲ་དྷྲྀཀ་ཅེས་བྱ་བ་ལ་སོགས་པའི་སྒྲའི་རྣམ་པར་སྣང་བས་སེམས་ཀྱང་ཚིག་བརྗོད་པ་ལྟ་བུའོ།",
    "ལུས་ངག་ཡིད་གསུམ་དབྱེར་མེད་པར་བྱས་ནས་འདི་སྐད་དུ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་ལྟར་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གསོལ་བ་བཏབ་པ་ཡང་མཁྱེན།",
    "སེམས་རྣམ་པ་དང་བྲལ་བ་ཆད་པའི་མཐའ་སེལ་ཞིང་དེ་ཉིད་ཀྱིས་སེམས་དང་ལུས་དབྱེར་མེད་པར་ཡང་སྟོན་ཏེ།",
    "སེམས་དེ་ཡང་ཚིག་བརྗོད་པ་ལྟ་བུ་ཡིན་ཏེ་སྣང་ལ་རང་བཞིན་མེད་པ་ཡིན་ཞིང་སེམས་དང་ངག་དབྱེར་མེད་པར་སྟོན་ཏོ།",
    "དེ་སྐད་ཅེས་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེས་གསུངས་སོ།",
    "དེ་ནི་དངོས་པོ་ཐམས་ཅད་དང་བྲལ་བ་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་མཚན་ཉིད་རྣམ་པར་སྤངས་པ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་དེའི་འབྲེལ་བ་ནི་ལེའུ་དང་པོར་བྱིན་གྱིས་རློབ་མཛོད་དེ་ཞེས་ཞུས་པ་ལས་བྱིན་གྱིས་བརླབ་པ་མཛད་པའི་ཕྱིར་ཟིལ་གྱིས་གནོན་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ན།",
    "ལེའུ་འདིར་ནི་ཏིང་ངེ་འཛིན་གསུམ་རྫོགས་པར་བྱེད་པ་ལ་འདིར་མ་ཚང་བ་རྣམས་ནི་གཞན་དག་ནས་ཁ་བསྐང་བར་བྱ་སྟེ།",
    "ནམ་མཁའ་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "རྣམ་པར་སྣང་མཛད་ཕྱག་རྒྱ་ཆེ།",
    "རྣམ་པར་སྣང་མཛད་ཕྱག་རྒྱ་ཆེ།",
    "རྣམ་པར་གཙིགས་པ་འཇིགས་འཇིགས་བལྟ།",
    "འདི་གཉིས་ཀྱི་ཁྱད་པར་ནི།",
    "གཡས་ཀྱི་དང་པོའི་རྡོ་རྗེ་ནི་རྩེ་དགུ་པར་འགྱུར་ཏེ།",
    "སྣ་ཚོགས་རྒྱན་གྱིས་མཛེས་པར་བརྒྱན།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "ཤེལ་དང་ཟླ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "ཕྱག་ན་རིན་ཆེན་བསྣམས་པར་བསྒོམ།",
    "འདིའི་དོན་ནི་བརྟག་པར་བྱའོ།",
    "རྣལ་འབྱོར་པས་ནི་རྟག་པར་བསྒོམ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟ་བའི་མཚན་ཉིད་ནི་རྗེས་སུ་དྲན་པའི་སྐབས་སུ་ཤེས་པར་བྱའོ།",
    "ནམ་མཁའ་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "སྐུའི་དཀྱིལ་འཁོར་ཏེ་དེ་བཞིན་གཤེགས་པའི་སྐུ་ནི་མཚན་བཟང་པོ་ལ་སོགས་པ་ཐམས་ཅད་ནི་ཡང་དག་པར་རྫོགས་ཤིང་མཚན་ཉིད་ངན་པ་སྤངས་པ་ནི་ཀུན་དུ་བཟང་པོའི་སྐུ་སྟེ།",
    "དེས་ན་མཚན་མིན་ཞེས་སྨོས་པའི་དགག་པ་འདི་ཡང་མཚན་ཉིད་ཀྱི་ངོ་བོ་ཉིད་མ་གྲུབ་པར་སྦྱར་བར་རིགས་སོ།",
    "གཙང་བ་ནི་རྒྱུ་དང་སྦྱོར་བ་ལ་སྐྱོན་མེད་པའོ།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཀུན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་སོ།",
    "རྣམ་པར་མི་རྟོག་ལས་བྱུང་བ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་བྱུང་བའི་འདོད་ཆགས་ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་ཏེ།",
    "བསྒྲུབས་ཀྱང་འགྲུབ་པར་ཡང་མི་འགྱུར།",
    "རྡོ་རྗེ་སློབ་དཔོན་སྨོད་པ་ལ་སོགས་པ་ནི་དམ་ཚིག་ཆེན་པོ་ལ་གཏོགས་པ་ཡིན་པས་འདི་དང་ལྡན་ན་མཉམ་པ་ཉིད་དང་འགལ་བའི་ཕྱིར་འདི་ནི་གནང་བ་མ་མཛད་དོ།",
    "གཞན་ཡང་རྣམ་པར་རྟོག་པའི་སྲོག་གཅོད་པ་དང་།",
    "དེ་ཉིད་དམ་པར་བསྔགས་པ་མཛད་པས་དེ་དག་བརྒྱལ་བར་གྱུར་ཏོ་ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་རོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་དག་བསླང་བའི་ཕྱིར་ནམ་མཁའ་དང་མཉམ་པ་གཉིས་སུ་མེད་པ་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ།",
    "ནམ་མཁའ་དང་མཉམ་པ་ནི་རྣམ་པར་རྟོག་པའི་གཉེན་པོ་ཡིན་ཏེ།",
    "ཐུགས་ནི་དེ་བཞིན་གཤེགས་པའི་གཙོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཐུགས་ཀྱི་རྣམ་པར་དག་པའོ།",
    "དེ་ལ་དེ་བཞིན་གཤེགས་པ་མི་བསྐྱོད་པ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་གསང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ་ཞེས་བྱ་བའི་ཐུགས་ཀྱི་བདག་ཉིད་ཀྱི་གསང་བའི་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེའི་རང་བཞིན་དང་ལྡན་པར་བྱེད་པའི་སྔགས་སོ།",
    "གསོལ་བ་གདབ་པ་བྱས་ནས་དབྱེར་མེད་པར་ཞུགས་པར་བྱས་ནས་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟ་བར་གསོལ་བ་བཏབ་པ་ལ་སོགས་པ་བྱས་ནས་བསྒྲུབ་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སེམས་ལ་དམིགས་པ་བདག་མེད་པར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ཇི་ལྟར་སེམས་ལ་བདག་མེད་པར་དམིགས་པ་དེ་བཞིན་དུ།",
    "ངག་དང་ལུས་ལ་ཡང་བདག་མེད་པར་དམིགས་ཏེ་ནམ་མཁའ་ལྟ་བུར་སྦྱོར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་སོ།",
    "ནམ་མཁའ་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "གཞན་ཡང་གསལ་བའི་དཀྱིལ་འཁོར་ནི་ཟླ་བ་སྟེ་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "དཀྱིལ་འཁོར་རྒྱལ་བ་མཆོག་དང་ལས་ཀྱི་རྒྱལ་བ་མཆོག་རྣམས་ལ་ནན་ཏན་དུ་བྱས་ཏེ།",
    "ཡན་ལག་བཞིའི་ཚུལ་གྱིས་བསྐྱེད་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁོར་ཡང་ཁྱད་པར་དག་ཏུ་སྤྲོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དམ་ཚིག་དང་སྡོམ་པའི་བདག་ཉིད་ཡིན་པས་ལེའུ་ལྔ་པར་ཁ་བསྐང་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་འདོད་པ་བསྟེན་པས་འགྲུབ་པར་བསྟན་ཏོ།",
    "གཟུགས་ལ་རྣམ་གསུམ་ཤེས་བྱས་ནས།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་བདག་ཉིད་དེ་དེ་ལྟར་བསྒོམས་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལ་དབུལ་ཞེའོ།",
    "ཞེས་བྱ་བའི་དོན་གྱིས་གཟུགས་ཉིད་རྣམ་པར་སྣང་མཛད་ཡིན་ཏེ།",
    "རིགས་ཀྱི་ཚུལ་དུ་རྣམ་པར་བསྒོམ།",
    "ཞེས་བྱ་བ་ནི་རིགས་དེ་དག་ཐམས་ཅད་ཀྱང་ཐུགས་ཀྱི་བདག་ཉིད་དུ་བྱས་ཏེ་མཆོད་ཅིང་སྤྱན་དྲང་བར་བྱའོ།",
    "སྤྱོད་ལམ་གྱི་ཏིང་ངེ་འཛིན་དུ་ཤེས་པར་བྱའོ།",
    "ཕཊ་ཀྱང་རབ་ཏུ་བརྟགས་པར་བྱ།",
    "རྡོ་རྗེ་རྗེས་སུ་དྲན་པ་ནི་མི་འཁྲུགས་པར་སྦྱར་བའོ།",
    "དེ་ཡང་དཀྱིལ་འཁོར་གྱི་ལྷའི་སྦྱོར་བ་དྲན་པར་བྱེད་པས་རྗེས་སུ་དྲན་པའོ།",
    "འདི་ནི་ཐམས་ཅད་ཀྱི་རང་བཞིན་ཡབ་མི་དམིགས་པར་དྲན་པའོ།",
    "དེའི་གནས་ནི་ས་ཕྱོགས་གཙང་ཞིང་དབེན་པ་དང་།",
