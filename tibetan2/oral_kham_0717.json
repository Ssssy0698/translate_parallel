    "སུ་ཏ་སོ་མ་ཕྱིར་ཁྱིམ་དུ་ཕྱིན་ཙ་ན།",
    "བྲམ་ཟེ་དེ་ཡང་འདུག་པས་རབ་ཏུ་དགའ་ནས་སྦྱིན་པ་བྱིན་ནོ།",
    "ང་སྔོན་རི་ལ་འདུག་སྟེ་འཇིག་རྟེན་ན་མི་དགའ་བ་ལས་ནན་གྱིས་རྒྱལ་པོར་བཅུག་སྟེ།",
    "བདག་ཤིང་གཞན་གྱི་སྟེང་ན་འདུག་ཚེ་སྐད་མི་སྙན་ལ།",
    "གྱོས་པོའི་ཁྱིམ་ན་འདུག་པའི་ཚེ་ཕ་མའི་ཁྱིམ་འདོད་ན་དེ་ཅིའི་ཕྱིར་ཞུས་ཤིག་ཅེས་སྨྲས་སོ།",
    "རྒྱལ་པོའི་ན་བཟའ་ལ་དུད་པའི་དྲི་མ་འདུག་པས་དེས་མཆི་མ་ཤོར་རོ་ཟེར།",
    "གསེར་གྱི་གླང་པོ་ཆེ་དེ་ཡང་རྟག་ཏུ་དྲུང་ན་འདུག་གོ།",
    "འདྲེན་མ་ནུ་ས་པར་འདུག་པ་ན།",
    "དེ་དག་གཅིག་ལ་གཅིག་དགའ་བས་འགྲོ་ན་ཡང་ལྷན་ཅིག་ཏུ་འགྲོ་འདུག་ན་ཡང་ལྷན་ཅིག་ཏུ་འདུག་སྟེ་ཡུལ་མི་རྣམས་ཀྱང་དགའ་ནས་རྗེས་སུ་ཡི་རང་ངོ།",
    "སུ་ནི་ཕོངས་ཤིང་འདུག་སུ་ནི་ཉམ་ང་བར་གྱུར།",
    "དགེ་སློང་རང་ཉིད་ཀྱིས་སྔོན་གྱི་གནས་རྗེས་སུ་རྟོག་པར་བྱས་པས།",
    "དད་པས་ཁྲི་ལས་ལྡང་བར་བརྩམས་པ་དང་སྐུར་བ་དེ་ཡང་རང་སངས་ཏེ་ལུས་སྔ་མ་ཁོ་ན་བཞིན་དུ་གྱུར་ནས་སྟོན་པའི་སྤྱན་སྔར་འདུག་པ་དང་།",
    "ལུས་ཡོངས་སུ་རྫོགས་ཤིང་རངས་པར་གྱུར་ཏེ་རབ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་བསྙེན་པར་རྫོགས་ཏེ་དགྲ་བཅོམ་པའི་གོ་འཕང་མངོན་དུ་བྱས་སོ།",
    "དོམ་དེ་ཕུག་ན་འདུག་པ་བསྟན་པས་དེ་ག་ཉིས་ཀྱིས་དུག་མདས་བསྣུན་ཏེ་བསད་ཅིང་དེའི་ཚེ་དོམ་གྱིས།",
    "དེ་དེ་ན་འདུག་ཀྱང་ཁ་ཅིག་ནི་འཐོབ་ལ་ཁ་ཅིག་ནི་མི་འཐོབ་བོ།",
    "བདག་ཐོངས་ཤིག་དང་ཕྱིན་ཆད་སུ་ལའང་སྤྱིན་པར་མི་བྱེད་ལ་བྱིན་ཆད་ཁྱིམ་འདིར་ཡང་མི་འདུག་གོ་ཞེས་སྨྲས་ཀྱང་མ་ཉན་པར།",
    "ཆུང་མ་དེ་ཡང་རང་ཁྱིམ་དུ་ཁྲིད་དེ་ཆུང་མ་བྱའོ་སྨྲས་པས།",
    "ཡི་དྭགས་ལུས་ཆེ་ལ་རོ་སྨད་ནི་ཐ་མལ་པར་འདུག་པ་ལ་རྐེད་པ་ཡན་ཆད་ནི་ལུས་གཉིས་སུ་གྱུར་ཏེ།",
    "དེའི་ཚེ་བུ་དེས་ཕའི་རུས་བུ་དེ་བྱ་རྒོད་ཕུང་པོའི་རི་ལས་ཐག་མི་རིང་བ་ཞིག་ཏུ་ཕྱུངས་ཏེ་བསྲེགས་ནས་དུར་ཁྲོད་དེ་ཉིད་དུ་འདུག་ཅིང་མྱ་ངན་གྱིས་བྲང་རྡུང་ཞིང་ཆོ་ངུས་འདེབས་པར་བྱེད་དོ།",
    "དེ་ཐོས་པ་དང་རབ་ཏུ་དགའ་ནས་དེར་ཕྱིན་ཏེ་ཞ་འས་ལ་ཕྱག་བྱས་ནས་འདུག་པ་དང་།",
    "སྨྲ་ཞིང་འདུག་པ་ན།",
    "སེམས་ནི་ཀུན་ནས་དཀྲིས་ཤིང་འདུག།",
    "དེ་དག་སྐྲག་སྟེ་རང་རང་འདོད་པའི་ལྷ་ལ་གསོལ་བ་བཏབ་པ་ན།",
    "རྩ་བ་དང་འབྲས་བུས་འཚོ་ཞིང་སུ་ལའང་འཚེ་མི་འདོད་པ་ཞིག་འདུག་པ་དེ།",
    "སེམས་དད་པར་བྱས་ཏེ་སྤྱན་སྔར་འདུག་གོ།",
    "ནམ་ཞིག་བྲམ་ཟེ་དེ་ཁང་སྟེང་དུ་འདུག་པ་ན།",
    "དེ་ནས་གདོལ་པའི་ཁྱེའུ་དེས་འཕགས་པ་ལ་ཕྱག་བྱས་ནས་འདུག་པ་ན།",
    "དེས་ཡིད་བྱེད་ཀྱི་ལུང་ཕོག་པས་ནག་པོས་ཀྱང་བསམ་གཏན་བཞི་དང་མངོན་ཤེས་ལྔ་ཐོབ་སྟེ་དྲང་སྲོང་རྒན་པོ་ཤི་བའི་འོག་ཏུ་གནས་དེར་འདུག་པར་བྱེད་དོ།",
    "དེ་ནས་གནོད་སྦྱིན་དེ་རང་གནས་སུ་ཕྱིན་ཏེ་འདུག་པ་ན།",
    "ནམ་ཞིག་ན་རྒྱལ་པོ་ཚངས་བྱིན་གཡུལ་ཕམ་ནས་གཅིག་པུར་བྲོས་པས་ཐར་ནས་ནགས་ཁྲོད་ཅིག་ཏུ་ཞུགས་ཏེ་རྟ་ལས་བབས་ཏེ་འདུག་པ་ན།",
    "ཁྱིམ་བདག་དེ་བུ་དང་འཁོར་དུ་བཅས་པ་ཐམས་ཅད་སྟན་དེ་ཉིད་ལ་འདུག་བཞིན་དུ་བདེན་པ་མཐོང་ནས།",
    "སྟན་ཕྱེད་འདི་ལ་འདུག་ཅིག་ཅེས་སོགས་གསུངས་ཏེ་སྟན་གྱི་ཕྱེད་བསྟབས་པས་ཐམས་ཅད་འགྱོད་ཅིང་ངོ་མཚར་དུ་གྱུར་ཏོ།",
    "འབབ་ཆུ་དྲག་པོ་ཞིག་ཡོད་པའི་ནང་དུ་ཁྱུ་མཆོག་རང་ཉིད་འདུག་སྟེ་ཟམ་པ་བྱས་ནས་དེའི་སྟེང་དུ་ཐམས་ཅད་བྲིས་སུ་བཅུག་པས།",
    "ནས་པའི་སྐྱེ་བོ་མང་པོ་དག་དུས་དུས་སུ་དེ་ལ་བལྟར་འགྲོ་ཞིང་།",
    "ངས་ནི་འཕྱེ་བོ་ཁྲི་ལ་འདུག་པ་ཁྱེད་རྣམས་ལ་ཅི་ད་པ་བསྒྲུབ་སྟེ་བྱིན་ན་ཁྱེད་ཀྱིས་བདག་གཅིག་པུ་ལ་མི་ཟེར་བར་མང་པོའི་ནང་དུ་དམའ་ཕབ་བོ་ཞེས་བྱས་སོ།",
    "བདག་ནི་གཅེས་བུར་འདུག་པས་དེ་དག་དང་མངོན་སུམ་དུ་ཕྲད་པར་འགྲོ་མི་ནུས་སོ་སྙམ་སྟེ།",
    "འཕགས་པ་ཀཱ་ཏྱཱ་ཡ་ནའི་བུ་གྲོང་དུ་བསོད་སྙོམས་བྱེད་ཅིང་འདུག་པར་ཀི་བཏབ་སྟེ།",
    "སྲོག་ཕངས་པ་སྦྱིན་པར་མཛད་དུ་གསོལ་ཞེས་ཟེར་ཞིང་འདུག་པ་ན་རྨི་ལམ་སད་པར་མཛད་པས།",
    "ཁྱེད་ཀྱང་དེའི་འདབ་ཏུ་འདུག་སྟེ།",
    "ཉིས་ནི་འདི་ན་འདུག་བཞིན་དུ།",
    "རང་རང་གང་ལ་དགའ་བ་དེ་འི་བསྔགས་པ་བརྗོད་པར་བྱེད་པ་ལས།",
    "གཙུག་ལག་ཁང་དུ་འདུག་བཞིན་དུ་དེས་རྒྱུན་ཞུགས་ཀྱི་འབྲས་བུ་ཐོབ་ཅིང་།",
    "༣་ ཕ་ཞེས་བརྗོད་ཅིང་ཞབས་ལ་ཕྱག་བྱས་ཏེ་སྐུའི་དྲུང་ན་འདུག་གོ།",
    "དོན་འདི་བཅོམ་ལྡན་འདས་ལ་གསོལ་ལོ་སྙམ་ནས་དྲུང་དུ་ཕྱིན་ཏེ་ཞབས་ལ་ཕྱག་བྱས་ནས་ཚོས་མཉན་པའི་ཕྱིར་སྤྱན་སྔར་འདུག་པ་ན།",
    "དེས་ཀྱང་ཡུལ་དེ་ཆམ་ལ་ཕབ་སྟེ་འདུག་པ་ན།",
    "ཁ་ཅིག་ནི་བཙོན་རར་འདུག་ཅིང་ཁ་ཅིག་ནི་ཡུལ་གཞན་ན་འདུག་པས་བཙོན་རྣམས་ཐོངས་ལ་ལྗོངས་དག་ཏུ་ཡང་དྲིལ་བསྒྲགས་ཏེ་དེ་དག་དང་ལྷན་ཅིག་ཏུ་བསྙེན་བཀུར་གྱི་ཕྱིར་སོངས་ཤིག་ཅེས་བསྐུལ་བས།",
    "འདུག་པ་དང་།",
    "ཆ་བདུན་དུ་བསྒོས་པའི་ཆ་དྲུག་པོ་རྒྱལ་རིགས་གཞོན་ནུ་དྲུག་པོ་དེ་ལ་བྱིན་ཅིང་རང་རང་རྒྱལ་སྲིད་ལ་བཀོད་ནས་ཆ་གཅིག་པོ་དེ་རྒྱལ་པོ་རྡུལ་རང་ཉིད་ཀྱིས་བཟུང་ངོ།",
    "རྒྱལ་པོའི་ཁང་སྟེང་དུ་འདུག་སྟེ།",
    "དེ་བློ་གསལ་བར་གྱུར་པ་ཁྱིམ་གྱི་ནང་ན་འདུག་བཞིན་དུ་བསྟན་བཅོས་རྣམས་བསླབས་སོ།",
    "ངོ་ཚ་བཞིན་དུ་སྒོ་ཁང་དུ་འདུག་སྟེ་བདུག་པ་ན།",
    "དེ་གཉིས་རང་རང་འདོད་ཕྱོགས་ལྟར་གྱིས་ཆེ་བ་བརྗོད་ནས་བདོག་པ་ཐམས་ཅད་ཡལ་བའི་སྐུགས་ཀྱི་གཏའ་བཞག་གོ།",
    "བདུག་པ་དང་ཆུ་ནི་སྤྱན་སྔར་འདུག་གོ།",
    "གུ་ལང་ལ་སོགས་པ་རང་རང་འདོད་པའི་ལྷ་རྣམས་བོས་ཀྱང་ཅུང་ཟད་ཀྱང་སྐྱོབ་པར་བྱེད་པ་མ་བྱུང་བས།",
    "སྐྱེ་དགུ་ལ་བྱམས་པ་ཞིག་སྟེ་དེས་རྒྱལ་ས་ལ་འདུག་ན་ཉེས་པ་མང་བར་མཐོང་ནས་རྒྱལ་པོ་ལ་གསོལ་ཏེ།",
    "ངོ་ཚ་ཞིང་གདོང་སྨད་དེ་གནས་དེར་འདུག་པ་ན།",
    "དེ་ལྟ་བུའི་སྡུག་བསྔལ་མི་བཟད་པ་མྱོང་ཞིང་འདུག་གོ་གསུངས་སོ།",
    "བདག་ནི་གཅེར་བུར་འདུག་པས་ངོ་ཚ་སྟེ་མི་ནུས་སོ།",
    "རུས་པ་པགས་པ་སྐྱི་རྣམས་ད་དུང་འདུག།",
    "ཡི་དྭགས་དེས་དེ་ལྟར་གཤེགས་པ་མཐོང་ནས་བཅོམ་ལྡན་འདས་ལ་སེམས་དགའ་བ་སྐྱེས་ཤིང་རང་ཉིད་ངོ་ཚ་བར་ཡང་གྱུར་ཏོ།",
    "དུར་ཁྲོད་ན་འདུག་བཞིན་དུ་ཀེང་རུས་ཀྱིས་བསྐོར་བ་ཉིན་མཚན་དུ་བུ་ལྔ་ལྔ་འབྱུང་ཞིང་།",
    "རང་རང་འདོད་པའི་ལྷ་ལ་འབོད་པར་བྱས་ཀྱང་སྐྱབས་བྱེད་པ་ནི་སུ་ཡང་མ་བྱུང་ངོ།",
    "གནས་གང་དང་གང་དུ་ཡང་བདེ་བར་འདུག་ཏུ་ཡོད་དོ་ཞེས་དགའ་བའི་ཚིག་ལན་གསུམ་དུ་བརྗོད་པར་བྱེད་དོ།",
    "གཅིག་པུར་འདུག་པ་ནི་དགའ་བར་བྱ་དཀའོ།",
    "སོ་སོ་སྐྱེ་བོར་འདུག་བཞིན་དུ།",
    "རྒན་བླུན་དུ་འདུག་ལ་མི་ལྔ་བརྒྱ་དང་ལྷན་ཅིག་འཁོད་ཅིང་དྲུང་དུ་བཞག་པས།",
    "དེའི་དུས་ཀྱི་དགེ་སློང་གཞོན་ནུར་གྱུར་པ་དེ་ནི་དགེ་སློང་རྒན་པོ་འདི་ཡིན་ཏེ་ལས་དེས་ལོ་དྲུག་ཅུའི་བར་དུ་མའི་ལྟོ་ན་འདུག་གོ།",
    "གནས་གཞི་དང་ལྡན་པ་ཞིག་འདུག་པར་གྱུར་ཏོ།",
    "མེ་ཏོག་ཀུན་ད་ལྟར་འདུག་པ་དང་།",
    "ཚེ་འདི་ལ་མིག་ཡོན་པོར་འདུག་པ་ནི་སྔོན་ལོག་པའི་སེམས་ཀྱིས་གཞན་གྱི་ཆུང་མ་ལ་བལྟས་པ་ལས་འོངས་སོ།",
    "འདུག་ཀྱང་རུང་།",
    "འགྲོ་བ་དང་ནི་འདུག་པ་ན།",
    "བཟོ་དང་ཡི་གེའི་གཟུགས་སུ་འདུག།",
