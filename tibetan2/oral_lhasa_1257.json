    "འདུས་བྱས་མི་རྟག་རྒྱ་ལས་སུ་ཡིས་འགོང་།",
    "གཉིས་པ་ཁྱད་པར་ལ་གནས་པའི་དོན་གཞན་བཀོད་པ་ནི།",
    "འོས་པ་ལ་འོས་པར་སྒྲུབ་བྱེད་གཞན་བཀོད་པ་སྟེ།",
    "དེ་གཉིས་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་གཉིས་ཀ་ལ་རིམ་པར་བཀོད་པ་སྟེ།",
    "མཆོག་གསུམ་སྐྱབས་སུ་འཛིན་པས་འོས་ལགས་སམ།",
    "མཚུངས་པར་རྟོགས་པའི་ལྡོག་པ་ཅན།",
    "ཚངས་སྲས་མགྲིན་པར་འཁྱུད་པའི་གླུས།",
    "སླར་འཆད་འགྱུར་ནི་སྒྲས་ཟིན་པ་མེད་ཀྱང་དོན་གྱི་གོ་བས་མཚུངས་པར་རྟོགས་པ་ལས་འབྱེད་པའི་ལྡོག་པ་ཅན་གྱི་རིགས་ཏེ།",
    "འདི་གཉིས་ཀྱི་ནི་ཁྱད་པར་ཡང་།",
    "འདི་དང་ཕུལ་བྱུང་དཔེའི་ཁྱད་པར།",
    "དཔེ་བས་དཔེ་ཅན་གྱི་ཡོན་ཏན་ལྷག་པར་བརྗོད་པའི་སྒོ་ནས་ལྡོག་པ་སྟེ།",
    "གསུམ་པ་གཞི་གཉིས་པོ་མཚུངས་པར་མ་ཟད་དེ་གཉིས་ཀྱི་འབྱེད་བྱེད་ཀྱང་མཚུངས་པའི་ལྡོག་པ་ཅན་ལ་གཉིས་ལས།",
    "གང་དང་རིགས་མཐུན་པ་ལས་ཁྱད་པར་དུ་འབྱེད་པ་སྟེ།",
    "བདག་བློའི་ཀུན་རྨོངས་འཁྲུད་པར་བྱེད།",
    "འཇིག་རྟེན་ན་དེའི་རྒྱུ་ཡིན་པར་གྲགས་པ་དེ་བཟློག་ཅིང་མེད་པར་བརྗོད་ནས།",
    "སྣ་ཚོགས་ཚོན་གྱིས་བསྒྱུར་མིན་ཆུ་སྐྱེས་རྣམ་པར་བཀྲ།",
    "སུས་ཀྱང་མ་བསྒྱུར་མགོ་སྐྱེས་རྣམ་པར་དཀར།",
    "ཆེད་དུ་བྲིས་མིན་དཔྲལ་རིས་ལྷག་པར་གསལ།",
    "བྱས་པ་མེད་ཀྱང་མི་ཁས་མནར་འདིས་སྐྱོ།",
    "འདི་གཉིས་རྒྱན་གཅིག་ལ་དཔེར་བརྗོད་གཉིས་བྱས་པ་སྟེ།",
    "བསྐུལ་མིན་ཉི་ཟླའི་བགྲོད་པས་རྣམ་པར་མཛེས།",
    "བརྗོད་འདོད་ཀྱི་དངོས་པོ་དེ་ཉིད་ཆེས་འཕགས་པའི་ཁྱད་པར་འཇིག་རྟེན་ན་ཡོངས་སུ་གྲགས་པའི་མཚམས་ལས་བརྒལ་བར་གྱུར་པའི་འུད་བརྗོད་པ་ལ།",
    "བརྗོད་ཚུལ་ཉམས་ཀྱི་ཁྱད་པར་མཚར་ཕུལ་ཅི་ཆེར་བརྗོད་པ་སྟེ།",
    "བསྒྲལ་བར་མ་བྱས་ཡིད་ཅན་འགའ།",
    "ལོག་སྲེད་ཅན་འགའ་ལུས་པར་ཤེས།",
    "ཡང་ཡང་བསིལ་ལྡན་ལྗོངས་འདིའི་མགོན་ཕེབས་ནས།",
    "སྐྱེངས་ནས་གངས་ཀྱི་རི་བོར་ཡིབ་པར་དོགས།",
    "ཞབས་སེན་ཟླ་ཚེས་དྲུང་དུ་བསྙེགས་པར་ངེས།",
    "རྒྱུ་གཞན་རྣམས་དེ་ལས་འཕྲོས་པར་བཞེད།",
    "རྒྱུ་དེས་འབྲས་བུ་དགའ་བ་སོགས་བསྐྱེད་པར་འོས་པ་སྟེ།",
    "ངེས་གསང་བསྟན་མཆོག་ཆེས་ཆེར་གསལ་བྱས་པས།",
    "བསགས་པར་མ་བྱས་ཉེས་སྤྱོད་གདུག་པ་ལ།",
    "འཛེམ་བག་ཅུང་ཟད་བྱས་མིན་སྐྱེ་བོ་རྣམས།",
    "ཤགས་དང་ཀུ་ཅོ་རྒྱུག་མཆོང་ལུས་མཐུ་ཉམས།",
    "ཕང་པར་གནས་པའི་ལྷུང་བཟེད་འདི་ནི་སྲེད་ལྡན་འཆིང་བའི་ཆུང་མ་མིན།",
    "ལྟ་བུ་ཡིན་ནམ་དཔྱད་པར་བྱའོ།",
    "སྤྱིར་ཆེད་དུ་མ་བྱས་པའི་འབྲས་བུ་དང་།",
    "ཞེས་གསུངས།",
    "མཁྱེན་རབ་མཆོག་གྱུར་ཕྱོགས་ཀྱི་གླང་པོ་ཡིས།",
    "བློ་སྔོན་དུ་བཏང་ནས་ཆེད་དུ་བརྡ་བྱས་པ་མིན་ཀྱང་།",
    "གནག་པའི་བཞིན་རུམ་འདྲེན་བྱེད་རྣམ་པར་གཡོ།",
    "འདི་དང་ཤེས་བྱེད་ཀྱི་རྒྱུའི་ཁྱད་པར།",
    "ལུས་ཀྱི་འཁྲི་ཤིང་རྣམ་པར་བསྐྱོད་པ་འདི།",
    "རང་སྲིད་ཉམས་པར་དོགས་ནས་འཇམ་པའི་དབྱས།",
    "ཟོལ་བསྟོད་དང་འདི་གཉིས་ཀྱི་ཁྱད་པར།",
    "རྒ་བས་ཆེས་ནོན་ལྔ་པར་ཕྱོགས་ཉེ་བའི།",
    "སྐད་ཅིག་གཉིས་པར་འཚོ་བའི་སྐབས་ཡོད་དམ།",
    "ཡུན་རིང་སྦྱངས་པར་མ་བྱས་ཙ་མི་བདག།",
    "འཇིགས་མེད་བག་ཕེབས་སྤྱོད་འདི་ཇི་ལྟར་འགྱུར།",
    "སྣང་འདི་རྒྱ་སྐྱེགས་ཁུ་བས་སྒྲིབ་པར་མཛོད།",
    "འདོད་པའི་དོན་དེ་མངོན་དུ་མ་བརྗོད་པར་དེ་ཉིད་འགྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "བག་ཕེབས་བདེ་བར་རྒྱུ་བའི་དཔལ་ལ་རྩེན།",
    "གཞན་ལ་ཕན་པར་བཞེད་པ་འབའ་ཞིག་ལས།",
    "རང་འདོད་དྲི་མས་གཞར་ཡང་གོས་མ་ལགས།",
    "ཡོངས་བཟུང་བེཟླུར་གཙང་མའི་ཁྱིམས་ཀྱི་གཞིར།",
    "ཟུང་ཉིད་མ་ལགས་དེ་སྙེད་རྣམ་པའི་གྲངས།",
    "གསར་དུ་བསྡམས་པར་བྱེད་པོ་འདི་ནི་གཞན།",
    "དོན་གཉིས་ཀ་ལ་ཚིག་ཐ་དད་གཅོད་མཚམས་ཐ་དད་མིན་པར་གཅིག་པ་སྟེ།",
    "བྱ་དང་བྱ་མིན་རྣམ་དཔྱོད་འགའ་མེད་པར།",
    "བྱ་བྱ་མིན་གྱི་བླང་དོར་ལ་རྣམ་པར་དཔྱོད་པའི་སེམས་མེད་པས།",
    "རྟག་པར་བྱམས་དང་བརྩེ་བ་ཡིས།",
    "ཁྱད་གཞི་གཉིས་ཀས་བྱ་བ་ཐ་དད་མིན་པར་གཅིག་བྱེད་པ་སྟེ།",
    "འགྲོ་བའི་སྒྲོན་མེ་རྣམས་རིམ་པར།",
    "ཉི་མ་རྣམས་སྒྲ་སྦྱར་ནས་འདིར་ཁམས་གསུམ་གྱི་འདོད་ཆགས་དང་མ་བྲལ་བའི་དྲང་སྲོང་སོགས་སྨད་འོས་ཀྱི་སྐྱོན་རྣམས་བཀག་ནས་སྤངས་པ་ཕུན་ཚོགས་སོགས་ཀྱི་ཆ་ལས་བཏགས་པའི་ལེགས་པའི་ཡོན་ཏན་ཁོ་ནར་ངེས་བཟུང་བྱས་པའོ།",
    "དེ་ལྟར་བྱས་པའི་ངེས་བཟུང་དེ་སླར་ཡང་འགོག་པ་བརྗོད་པ་སྟེ།",
    "དང་པོ་ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "ལོག་ལྟའི་རྒྱལ་པོ་གཉིས་འཐུང་བཞོན་པར་བཅས།",
    "གཉིས་པ་རིགས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "གསུམ་པ་བྱ་བ་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "བཞི་པ་རྫས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "ལྔ་པ་རྒྱུའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "ལྟ་བུ་སྟེ་འདིས་མཚོན་ཏེ་གཞན་སྤྲོ་ཡང་སྤྲོས་པས་ཆོག་གོ། ཉེར་དྲུག་པ་མཚུངས་པར་སྦྱོར་བའི་རྒྱན་ནི།",
    "ཚིག་སྦྱོར་གང་ཞིག་བརྗོད་པར་འདོད་པའི་ཡོན་ཏན་ཁྱད་པར་འཕགས་པའམ།",
