    "དབྱངས་ཅན་མགྲིན་པར་ཆགས་པའི་དཎྜི་ཡི།",
    "བློ་གསལ་ཉན་པར་འདོད་ཀུན་འདིར་འདུས་ཤིག།",
    "མཁྱེན་གཉིས་ལུས་ཤེད་རྫོགས་པའི་སྤྱན་ལམ་དུ།",
    "བརྒྱན་པར་གྱུར་ཅིང་སོགས་ཀྱིས་བསྟན་པའི།",
    "གླིང་བཞིའི་འབྱོར་པའི་ཁྱད་པར་ཇི་སྙེད་པ།",
    "མཁའ་འགྲོའི་གསང་མཛོད་བཏོལ་འདིས་ཁྱད་པར་བྱས།",
    "ཕྱོགས་ཀྱི་གཙང་བྱེད་རྒྱུན་འབུམ་བྱེད་པོ་ཡི།",
    "འབད་པར་མ་བྱས་ལོ་མ་འབྲས་བུའི་ཁ་ཟས་ལྡན།",
    "སྲོག་དང་བཅས་པའི་ལུས་འདི་ཉེ་བར་བསྐྱོད་བྱས་ནས།",
    "ཨུཏྤལོ་རྒན་པོ་འདར་བཅས་ཟག་པར་ངེས།",
    "གསལ་དེས་བླང་དོར་ལམ་བཟང་སྣང་བར་བྱས།",
    "ཕྱོགས་རིས་མེད་པར་ཀུན་ལ་མཉམ་པའི་མ།",
    "ས་འདི་སྐབས་གསུམ་ཚལ་བཞིན་འབྱོར་བར་བྱས།",
    "རྩེ་ཞིང་རྣམ་པར་སྙན་པའི་གདངས།",
    "ཁྱབ་བྱས་རྣམ་སད་སྐྱེད་ཚལ་བཞིན།",
    "བག་ཕེབས་དལ་གྱིས་ཞུགས་པར་གྱུར།",
    "མགྲིན་པའི་འཁྲི་ཤིང་བཏེགས་དང་ཆབས་ཅིག་པར།",
    "ཚངས་གནས་རྒྱན་དུ་བཀོད་དང་ཆབས་ཅིག་པར།",
    "སྙན་ངག་མེ་ཏོག་གསར་པའི་ཆུན་པོས་བསྙེན་པ་ལགས།",
    "ཞབས་སེན་ཆུ་སྐྱེས་བསྙེན་དང་ཆབས་ཅིག་པར།",
    "ཟག་མེད་ཞི་བའི་འབྱོར་དགུས་ཕྱུག་པར་མཛད།",
    "སྲིད་ན་རྣམ་པར་མཚར་བའི་མཚན་རིས་བཅོ་བརྒྱད་བཀྲ་བའི་རིགས་ལྡན་དཱ་རི་ཀཱ།",
    "དེ་ནས་ཉིན་བྱེད་ཆུ་ལྷའི་ཕང་པར་ཡིབ་པ་དང་།",
    "སིལ་སིལ་རྐང་གདུབ་འཁྲོལ་བའི་སྒྲ་དང་ཆབས་ཅིག་པར།",
    "ལྷང་ལྷང་མགྲིན་པའི་གླུ་དབྱངས་སྙན་པར་སྒྲོགས་བྱེད་མ།",
    "རྒྱན་གྱིས་རྣམ་པར་བརྒྱན་པར་བྱས།",
    "ཕན་བདེའི་སྣང་བ་དཀར་པོས་ཀུན་ནས་མཛེས་པར་བྱས།",
    "དགེ་མཚན་གསེར་གྱི་པདྨོས་རྣམ་པར་བརྒྱན་བྱས་ཤིང་།",
    "གཞོན་ནུའི་ཞབས་སེན་ཟླ་བ་གསར་པ་མཆོད་བྱས་ནས།",
    "སྐལ་བ་བཟང་གྱུར་མིང་འདི་དོན་ལྡན་བྱས་པ་ལགས།",
    "ཡོན་ཏན་མཐའ་ཡས་འགྲོ་ལ་ཕན་པར་མཛད་པ་ཉིད།",
    "དེ་སླད་བློ་ལྡན་རྣམ་ཀྱི་དབྱངས་ཅན་བསྙེན་བྱས་ནས།",
    "རབ་དུ་སྐྱོ་བས་ཕན་ཚུན་འདི་སྐད་བགྲོ་བར་བྱས།",
    "རྔ་ཡབ་ནོར་བུའི་ཡུ་བས་ལན་བརྒྱར་བསྙེན་བྱས་དེ།",
    "གཙུག་ནོར་མུ་ཏིག་དམར་པོའི་འོད་ཀྱིས་མཛེས་བྱས་གང་།",
    "འཇིགས་པ་འཇིགས་བ་པ་འདུས་བྱས་རང་མཚན་འདི་ལ་ལྟོས།",
    "བསགས་ཚད་འཛད་པར་ངེས་ན་སྒྱུ་མའི་ནོར་འདིས་བསླུས།",
    "འབྱོར་ཚད་རྒུད་པར་ངེས་ན་གྲགས་སྐམ་འདིས་ཅི་བྱེད།",
    "སྔར་ཕན་བྱས་པ་དོན་མེད་སྡུག་བསྔལ་ཁོ་ནའི་རྒྱུ།",
    "ད་ནི་འུ་ཅག་ཚེ་འདིར་ཞེན་པར་མི་བྱའོ།",
    "བསིལ་ལྡན་སྐྱེ་དགུའི་མགོན་དུ་དྲངས་པར་གྱུར།",
    "བུ་རམ་ཤིང་འཕེལ་གྲོང་དུ་གཤེགས་པར་གནང་།",
    "ཐུབ་གསུང་སྣང་བས་གསལ་བར་མ་བྱས་པའི།",
    "ལམ་གོལ་མུན་པར་མཐོམ་པའི་འགྲོ་རྣམས་ཀྱི།",
    "རྫུ་འཕྲུལ་བྱེ་བའི་འོད་ཟེར་འགྱེད་པར་མཛད།",
    "ཉེར་དྲངས་རིན་ཆེན་ཤིང་རྟའི་ཁྲིར་བཞུགས་པའི།",
    "དེ་ནས་རིམ་བཞིན་བྲག་རིའི་ཁང་བཞུགས་འོད་སྲུང་ཆེ།",
    "འཕོས་སྙམ་ཡིད་ཀྱི་འཁྲི་ཤིང་རྣམ་པར་བསྐྱོད།",
    "ཀུན་དཀྲིས་མེ་མདག་ཆིལ་ཆིལ་གསོད་བྱས་པས།",
    "ལྷག་བསམ་ལུས་དཀར་ཐུབ་བསྟན་མཁར་མཛེས་སྨར་གཡོ་གཙང་གསུམ་ཞི་བའི་འགྲོས།",
    "རྒྱལ་བའི་སྲས་ཀྱི་མཛད་པར་ཅུང་རིགས་སམ།",
    "ས་ཆེན་རིར་བཅས་ཀུན་ཏུ་བཟུང་བྱས་ན།",
    "ཁྱབ་པར་བྱས་སོ་མཁའ་ངོས་ཆུ་འཛིན་ཏེ།",
    "བསྐལ་པར་བསགས་པའི་ལས་ཉིན་མུན་པའི་དཔུང་།",
    "དལ་འབྱོར་གྲངས་སུ་བསྒྲུངས་ཀྱང་རུང་ཙམ་བྱས།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་བརྒྱན་པར་གྱུར་པའོ།",
    "ལུས་ཅན་ཕན་བདེའི་སྣང་བས་མཛེས་པར་གྱུར།",
    "དཀར་མིན་ཕྱོགས་ཀྱི་ཕྲུ་མ་མིང་མཐར་བྱས།",
    "སྤྱིར་སྦྱོར་བ་འཇམ་ན་འཇམ་པར་མཉམ།",
    "རྩུབ་ན་རྩུབ་པར་མཉམ།",
    "ཐོག་མར་འཇམ་པར་མཉམ་པ་ནི།",
    "གཉིས་པ་རྩུབ་པར་མཉམ་པ་ནི།",
    "མཁྱེན་བཟང་ཆེར་འབར་ཚ་ཟེར་གཟིས།",
    "མ་བརྟགས་པར་སྦྱོར་བའི་རྣམ་པས་ཚིགས་བཅད་ཕྱེད་མི་མཉམ་པ་སྟེ།",
    "སྲིད་པ་གསུམ་པོ་འདར་བར་བྱས།",
    "བསྐལ་མང་གོང་ནས་སྦྱིན་ལ་གོམས་བྱས་རྒྱུས།",
    "བཞི་པ་ལ་བརྩེགས་པ་མཚུངས་པར་བྱས་པ་ལྟ་བུ།",
    "ཚིགས་བཅད་གཅིག་ལ་རིགས་མི་མཐུན་པ་མི་མཉམ་པར་གྱུར་བ་དེ་ལྟ་བུར་སྦྱོར་དགོས་ཤིང་།",
    "གཉིས་པ་དབྱེ་བ་ལ་ལྷོ་བ་ཁོ་ནས་འདོད་པ་མཚུངས་པར་ཐོས་པའི་སྒྲའི་ཉམས་དང་།",
    "གཉིས་ཀ་ཅི་རིགས་པར་འདོད་པའི་རྗེས་ཁྲིད་ཀྱི་ཉམས་སོ།",
    "གཟུགས་མཚུངས་ཀུན་ནས་ཀུན་ཏུ་ཀུན་མཁྱེན་བསྟན་པ་མཆོག།",
    "གཉིས་པ་ལྷོ་ཤར་གཉིས་ཀ་ཅི་རིགས་པར་འདོད་པའི་རྗེས་ཁྲིད་ཀྱི་སྒྲའི་ཉམས་ལས།",
    "ཀུན་དགའ་བཟང་པོ་ཀུན་མཁྱེན་བསྟན་པའི་རྒྱན།",
    "ཡང་ཡང་སྲིད་པར་ཡོན་གནས་ཚུལ་བཟུང་ནས།",
    "ཀུན་ཀྱང་ཀུན་མཁྱེན་གོ་སར་དཀྲི་མཛད་པའི།",
    "ལེགས་བྱས་ཁྱུང་སྔོན་སྐྱེས་ཀྱིས་བོས་པའི་མགྲོན།",
    "ཤར་བ་ཁོ་ནས་འདོད་པའི་རྗེས་ཁྲིད་རྐང་པ་ཕྱེད་སྔ་མ་གཉིས་རྩུབ་ཅིང་ཕྱེད་ཕྱི་མ་གཉིས་སྦྱོར་བ་ལྷོད་པ་སྟེ་འཇམ་རྩུབ་ཆ་མཉམ་པར་བསྐོར་བ་ནི།",
    "རྒྱལ་བས་ལེགས་གསུངས་ཡན་ལག་བརྒྱད་པ་ཡིས།",
    "ཤར་བ་རྣམས་ཀྱིས་དེ་ཡང་༧མཛེས་པར་བསམ་སྟེ་སྦྱོར་བའོ།",
    "ཁྱད་པར་དུ་སྒེག་པ་ལ་སོགས་པའི་ཉམས་དང་ལྡན་པར་བྱ་དགོས་སོ།",
    "ཉིན་མཚན་བར་མེད་བསྟེན་པས་འཚེངས་པར་གྱུར།",
    "འདོད་ལྡན་གྱིས་ན་ཆུང་མཚན་ལྡན་ཚོལ་བ་དེ་གཉིས་སོ་སོར་ཤན་མི་འབྱེད་པར་སྐྱོན་དུ་གོ་ཤས་ཆེ་བའོ།",
    "རྩུབ་པ་སྲོག་ཆེན་གྱི་ཡི་གེ་གཏན་མེད་མ་ཡིན་པར་འདྲེས་ཙམ་ཡོད་པས་བརྗོད་བདེ་བ་ལྷོ་ཕྱོགས་པའི་འདོད་པ་ནི།",
    "ཀུ་མུཏ་རྣམ་པར་རྒྱས་པའི་ཟིལ་དངར་ལ།",
    "སྦྱར་བ་དང་འདི་གཉིས་འཇམ་པའི་ཡི་གེ་མང་ཞིག་རྩུབ་པའི་ཡི་གེ་འདྲེས་དགོས་པར་འདྲ་ཡང་།",
    "བདུད་རྩིས་མྱོས་དྲེགས་བིརླ་པར་འགྲན་སུ།",
    "མཉམ་པའི་སྐབས་རྩུབ་ན་རྩུབ་པར་མཉམ་པ་དང་མི་མཚུངས་ཏེ།",
    "འདི་ཚིག་སྦྱོར་བརྗོད་དཀའ་བ་ཁོ་ན་དགོས་པའི་ཁྱད་པར་ཡོད་གསུངས།",
    "བརྗོད་བྱའི་དོན་གང་ཡིན་པ་དེ་ཉིད་རྗོད་བྱེད་ཀྱི་ཚིག་ཐོས་མ་ཐག་ཏུ་རྟོགས་པར་འགྱུར་ཕྱིར།",
    "སླར་བརྟག་དཔྱད་མི་དགོས་པར་གསལ་བར་སྟོན་པ་སྟེ་ཤར་ལྷོ་འདོད་པ་མཐུན་པའི་དོན་གསལ་ནི།",
    "ལེགས་བྱས་ཟླ་བའི་མ་མ་བསྲུབས་པ་ལས།",
    "བརྗོད་ཡུལ་དེ་གཞན་ལས་ཆེས་ཁྱད་པར་དུ་འཕགས་པར་རྟོགས་ནུས་པའི་ཡོན་ཏན་དང་ལྡན་པ་བེ་དབྷའི་འདོད་པ་ནི།",
    "ཡང་ཡང་རྒྱུ་བའི་གོ་སྐབས་མཆིས་མ་ལགས།",
    "ལྟ་བུ་སྟེ་སྔ་མས་ཀུན་མཁྱེན་ཙོང་ཁ་པ་དང་ཕྱི་མས་མངའ་རིའི་པཎ་ཆེན་གྱི་ཡོན་ཏན་ཤུགས་ཀྱིས་གོ་བས་མཚོན་ནོ།",
    "དབྱེ་ན་ཀ་ལཱ་པར།",
    "མཉམ་ལ་འཁྲུགས་པ་སོགས་རིགས་འགྲེ་དེ་ཡང་ཡི་གེ་ལྕི་བ་རྣམས་སྒྲ་མཐོ་ཞིང་ཡང་བ་རྣམས་སྒྲ་དམའ་བས་འདིར་མཐོ་དམན་ཤས་ཆེ་ཞིང་མང་ཉུང་བྱས་པས་གློ་ཀའི་རྒྱུན་དེ་ལ་མི་མཉམ་པར་གྱུར་པ་ཡིན་གྱི་བློ་ཀ་གཅིག་ལྟ་བུར་རྣམ་པ་གསུམ་ཀ་ཚང་བའི་མཐོ་དམའ་དགོས་པ་ནི་མ་ཡིན་ནོ།",
    "ཡི་གེ་ལྕི་ཡང་མི་སྙོམས་པར་འཁྲུགས་པ་དེ་ལྟ་བུ་མ་ཡིན་པར།",
    "བརྗོད་དོན་གསལ་ཞིང་རྗོད་བྱེད་ཀྱང་གོ་རིམ་མ་འཆོལ་བར་འཇམ་རྩུབ་མཉམ་པས་ཡིད་དུ་འོང་བ་ལ་ཚིག་སྡུད་མང་པོ་ཡོད་པར་འདོད་པ་བེ་དབྷའི་བརྗིད་པ་ནི།",
    "དེང་ནས་འོག་མིན་ལས་ཀྱང་བསྔགས་པར་འོས།",
    "སྔོ་བསངས་དགའ་མའི་ཕང་པར་ཅི་སྟེ་རྫོགས།",
    "དོན་རྒྱན་གྱི་ཕུལ་བྱུང་ལ་འཇིག་རྟེན་ལས་བརྒལ་ཙམ་ལས་འུད་དེ་ཙམ་མི་ཆེ་བར་བརྗོད་ཚུལ་གྱི་རྣམ་པ་མཚར་ཕུལ་ཅི་ཆེར་བྱེད་དགོས་པའི་ཁྱད་པར་རོ།",
    "གཟུར་གནས་བློ་ལྡན་སྐྱེ་བོ་མཆིས་ན་མགྲིན་པའི་རྒྱན་དུ་འབུལ་གྱི་བཞེས།",
    "ནུབ་པར་ཕངས་ནས་ལྷག་པའི་བསམ་པས་ཀུན་གྱི་བློ་དང་འཚམ་པའི་ཕྱིར།",
    "ཁྱད་པར་༢༥མཚུངས་༢༦པར་སྦྱོར་བ་དང་།",
    "ཟོལ་བསྟོད་༢༩ངེས་པར་བསྟན་པ་དང་༣།",
    "དངོས་པོ་བརྗོད་པར་བྱ་བ་རྣམས་ཀྱི་རང་བཞིན་རིགས་བྱ་བ་ཡོན་ཏན་རྫ་ས་བཞི་པོ་གང་ཡང་རུང་བའི་ཁྱད་གཞི་དེའི་གནས་སྐབས་ཏེ།",
    "ལུས་ཀྱི་བ་སྤུ་རྣམ་པར་གཡོ་བ་དང་།",
    "མིག་ཀྱང་མཆི་མའི་རྡུལ་གྱིས་བརླན་པར་བྱེད།",
    "མ་བརྗོད་ཀྱང་དོན་གྱི་ཤུགས་ལས་རྟོགས་པར་བྱེད་པ་སྟེ།",
    "མཁྱེན་རབ་ལྷ་ཡི་ལམ་བཞིན་ཕ་མཐའ་བྲལ།",
    "ཕྱོགས་ཀྱི་གླང་པོའི་མཁྱེན་རབ་ཇི་བཞིན་དུ།",
    "མཚུངས་དཔེ་བཀོད་པ་དེ་ཁོ་ན་ལས་གཞན་མེད་ཅེས་ངེས་པར་བྱས་པ་སྟེ།",
    "མེད་པ་ལ་ཡོད་པར་སྒྲོ་བཏགས་ཏེ་རབ་བཏགས་དང་དཔེ་རྒྱན་སྦྱར་བ་སྟེ།",
    "དཔེ་ཅན་དཔེས་བསྐྲུན་དུ་མེད་པར་བརྗོད་པ་སྟེ།",
    "དཔེ་དཔེ་ཅན་དུ་འཁྲུལ་ནས་སོ་སོར་དབྱེ་བ་མ་ཕྱེད་པར་རྨོངས་པ་སྐད་དུ་བརྗོད་པ་སྟེ།",
    "ཤནྟ་རཀྵི་ཏ་ཡི་མཛད་པར་རྟོགས།",
    "སོམ་ཉིའི་སྒོ་ནས་དཔེ་དོན་མཚུངས་པར་བསྟན་པ་སྟེ།",
    "ཞི་འཚོ་གང་ཡིན་བདག་སེམས་རྣམ་པར་གཡོ།",
    "བཅུ་གསུམ་པ་གཏན་ཕེབས་ཀྱི་དཔེ་ནི།",
    "སྒྱུ་ལུས་སྐྱེད་བྱེད་མ་ལགས་ཀྱང་།",
    "དཔེ་ལ་བསྔགས་པའི་སྒོ་ནས་མཚུངས་པར་བསྟན་པ་སྟེ།",
    "སྐྱོན་ཡོན་གང་དུ་གྱུར་ཀྱང་བརྗོད་འདོད་ཀྱི་སྒོ་ནས་དེ་གཉིས་མཚུངས་པར་བསྟན་པ་སྟེ།",
    "དཔེས་འགྲན་ནུས་བཀག་པའི་སྒོ་ནས་མཚུངས་པར་བྱས་པ་སྟེ།",
    "གཡོན་ཅན་བྱས་པ་གཟོ་མིན་གོམ་གསུམ་པ་ཡིས་ནི།",
    "དཔེ་ཅན་ལ་ངོ་བསྟོད་ཀྱི་ཟོལ་གྱིས་མཚུངས་པར་བསྟན་པ་སྟེ།",
    "དཔེ་དཔེ་ཅན་གཉིས་མ་འཁྲུལ་པར་ཡིན་ལུགས་བདེན་པར་བརྗོད་པ་སྟེ།",
    "འཇིག་རྟེན་ན་དཔེ་གཞན་མ་རྙེད་ནས་རང་ཉིད་དཔེར་བྱས་པ་སྟེ།",
    "སྔར་དེ་ལྟར་མ་བྱུང་བ་ལ་སྙན་ངག་མཁན་གྱིས་རྟོག་པས་བཏགས་པ་ངོ་མཚར་བའི་དཔེར་བྱས་པ་སྟེ།",
    "དཔེ་དོན་ཀུན་ལ་རྣམ་དབྱེ་ལྔ་པ་སྦྱར་ཞིང་འབྱུང་མི་སྲིད་པའི་བསམ་པས་དེ་གཉིས་མཚུངས་པར་བྱས་པ་སྟེ།",
    "འཇིག་རྟེན་ཐམས་ཅད་སྣང་བར་བྱས།",
    "ངོ་བོ་གསེར་ལྟ་བུ་ལ་རྣམ་འགྱུར་རྣ་རྒྱན་སོགས་ཀྱི་ཁྱད་པར་ལྟར་དཔེ་ཉིད་དཔེ་ཅན་གྱི་རྣམ་འགྱུར་ཐ་དད་དུ་སྣང་བ་ཙམ་དུ་བརྗོད་པ་སྟེ།",
    "དེ་གཉིས་མཚུངས་པར་དངོས་སུ་མ་བརྗོད་ཀྱང་ཤུགས་ལས་རྟོགས་པར་བྱེད་པ་སྟེ།",
    "ལོ་ཧའི་ཏ་ཡིས་ལོ་བརྒྱར་བརླན་བྱས་ཀྱང་།",
    "རྣམ་པར་འགྱིང་བའི་འཕགས་མ་ནི།",
    "བརྗོད་ཚུལ་བྱ་བ་གང་ཡང་རུང་བ་ལ་བྱེད་པ་མཚུངས་པར་བསྡུས་ནས་སྨྲས་པ་སྟེ།",
