    "དེ་དང་མཁྲུན་པར་སྐྱེ་བ་ལེན་པའི་རྟེན་གྱི་རྣམ་པ་ལྟ་བུ་ཚོགས་གསོག་པ་བེའི་རྟེན་ནི་གང་ཟག་དང་།",
    "འུ་ནས་སྤུས་བསྐུལ་ཏེ་ལྷའི་རྣམ་པར་མ་བཞེངས་ཚུན་མངལ་གྱི་གནས་སྐབས་དང་།",
    "ལྷའི་རྣམཔར་བསྐྱེད་པ་ལའང་ཡབ་རྐྱང་བསྐྱེད་པརྡོ་རྗེ་འཇིགས་བྱེད་ལྟ་བ་སྟེ།",
    "རྒྱུད་ཅེས་བྱ་བ་ཡིན་པར་བརྗོད།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་འབྲས་བུ་རྡོ་རྗེ་འཛིན་པའི་ངོ་བོར་བསྐྱེད་པར་བྱའོ།",
    "ཞལ་ཕྱག་ལ་སོགས་པའི་སྣང་བ་ཁྱད་པར་ཅན་དུ་གྱུར་བ་ནི་རྡོ་རྗེ་འཛིན་པ་ཡིན་པའི་ང་རྒྱལ་འཇོག་རིགས་པའི་རྒྱམཚོན་ཡིན་ནོ།",
    "དེ་ལྟ་བུའི་གནས་ལུས་ལོངས་སྤྱོད་ཁྱད་པར་ཅན་ལ་བསྐྱེད་རིམ་གྱི་སྒོནས་ར་རྒྱ་ལ་གོམས་པར་བྱས་པས།་",
    "འཕགས་པ་ཡབ་སྲས་གང་རྣམས་ལས་རྒྱས་པར་འབྱུང་ཞིང་།",
    "སྤྱི་དང་ཁྱད་པར་འདུ་ཤེས་ཀྱི་ཕུང་བོ་དང་འདིད་ཆགས་སྦྱངས།",
    "སྤྱི་དང་ཁྱད་པར་འདུ་བྱེད་ཀྱི་ཕུར་པོ་དང་ཕྲག་དོག་སྦྱངས།",
    "སྤྱི་དང་ཁྱད་པར་ས་ཁམས་སྦྱངས།",
    "སྒྲ་རྡོ་རྗེ་མ་ལི་བསྐྱོད་པ་འདྲབ་ལ་ཁྱད་པར་པི་ཝཾ་འཛིན་པ་སྤྲོས་ནས་སྒྲ་དང་ཚུལ་ཆལ་སྦྱངས།",
    "དོན་ཡོདརྡོ་རྗེ་བསམ་པ་ཐམས་ཅད་རྫོགས་པར་མཛད་པ་ནི།",
    "དེ་ཉིད་ལས་བསྐྱེད་ན་རིགས་ལྔ་དང་ཡུམ་གྱི་ས་ལེན་གྱིས་མཚན་པར་རིགས་ཀྱི།",
    "འབྲས་བུ་རྣམས་སེམས་ལྡོག་པའི་རྟ་ས་ལས་ཁྱད་ཕྱི་རོལ་གྱི་དོན་ཡོད་པར་མི་འགྲུབ་སྟེ།",
    "འོག་ནས་འཆད་པའི་ལྷའི་རྣམ་དག་འཆད་པ་ལྟ་འབྲེལ་བ་བྱས་ཀྱང་མི་རུང་མེདདོ།",
    "དེ་བས་ན་བསྐྱེད་དོར་གཅིག་ཏུ་རྟོགས་པའི་བློས་དོན་དམ་དུ་ཁྱད་པར་འགའ་ཡང་མེད་པར་བརྟག་པར་བྱསྟེ།",
    "བདག་ཏུ་སྣང་བསྟོན་ཡིད་རྣམ་པར་དག་པ་ནི་མཉམ་ཉིད་ཡེ་ཤེས་ཏེ།",
    "ས་སྣ་ལ་སོགས་རྣམ་པར་དག་པ་ན།",
    "དེ་ལྟ་བདེན་པ་མེད་པར།",
    "དེ་ནས་ཡང་འོད་འཕྲོས་ནས་རང་དམ་ཚིག་པ་དང་བཅས་ཨེ་པའགན་བརྟེན་བརྟེན་པ་དང་བཅས་པ་གསལ་བར་བྱས་ནས།",
    "བཟླས་པའི་སྐབསསུང་སྐྱེད་པ་ལའང་ཤེས་པར་བྱའོ།",
    "སློབསྡུ་ལ་བསླབ་པར་བྱའོ།",
    "དེའང་ནམ་མཁའི་ཁམས་ཁྱབ་པར་སྤྲོ་དང་།",
    "ནམ་མཁའི་ཁམས་ཁྱབ་པར་སྤྲོ་བ་དང་།",
    "དེའི་དབུས་སུ་ལྷ་རྫོགས་པར་བསྐྱེད་ནས།",
    "ཁ་ཟས་སྲེག་རྫས་སུ་བསྐྱེད་ནས་སྦྱིན་སྲེག་འབུལ་བའི་ཚུལ་གྱིས་ལོངས་སྐྱེད་པར་བྱའོ།",
    "དེ་ལྟར་བྱས་ན་ལུས་ཀྱི་སྒུལ་སྐྱོད་གང་ཡིན་ཕྱག་རྒྱ་དང་།",
    "དེ་ལྟར་བྱས་ན་ལས་དང་པོ་པ་རྣམས་ཀྱང་ཕུང་མ་བསྟན་ཏུ་འགྱུར་རྒྱུ་རྣམས་དག་པར་བསྐྱར་ནས་པ་ཡིན་ནོ།",
    "སྐྱ་མཆེད་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་རྫོ་གས་པར་བྱས་པས་ཀྱང་རུང་ངོ།",
    "ཞི་སོགས་ཀྱི་དངོས་གྲུང་བསྒྲུབ་པར་བྱའོ།",
    "གསུམ་བ་ལམ་དེ་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་པ་སྒྲུབ་པ་ནི།",
    "དེ་ལྟར་ན་ནམ་ཀླཁའ་མཐའཡས་སྐྱེ་མཆེད་ཀྱིས་ཀྱང་བདག་མེད་རྟོག་པ་ལ་གནོད་པར་འགྱུར་ཏེ།",
    "གཉེན་པོ་གོམས་བར་བྱསཔ་ལས་གང་ནས་གང་དུ་འཕེལ་ཞིང་གོམས་པ་མཐར་ཐུག་པ་ན་སྤང་བྱ་ཟད་པར་མཐོར་བ་དང་།",
    "ལམ་འདི་དེ་ལས་ཁྱད་པར་དུ་འཕགས་པར་ཇི་ལྟར་འགྲུབ་ཙན།",
    "བསྙམ་པ་དེ་སན་མ་དེ་ངེས་པར་བསྒོམ་དགོས་པར་གདམས་པ་ནི།",
    "དེ་ལྟར་ཡུལ་དུས་ཚད་ཅན་འཇོམ་བའི་གཉེན་པོ་ཟབ་གསལ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ལམ་འདི་ལ་ཡོད་པར་རྟོགས་ནས་སྟངརྗེཆེན་བོ་དང་ལྡན་པ་དག།",
    "མས་ཅད་མཁྱེན་པའི་གསུང་མི་ཉམས་པའི་ཕྱིར་དུ།",
    "འགྲོ་ཀུན་སྐྱོད་པར་སྐུ་འབུམ་བྱམས་པ་གླིང་།",
    "ཞེས་པས་སྟོང་པར་སྦྱངས།",
    "གཤེགས་ཤིང་བཞུགས་པའི་གནས་ངན་ཡོང་།",
    "གཏོར་མ་ཕུལ་བ་འདི་དག་བཞེས་སུ་གསོལ།",
    "རབ་ཏུ་དགྱེས་པ་ཡས་ནི་བཞེས་ནས་ཀྱང་།",
    "འདི་རྣམས་བཏུང་ཞིང་ལེགས་པར་གསོལནས་ཀྱང་།",
    "མཉམ་མེད་ཀྱང་ཆུབ་སེམས་ནི་བསྐྱེད་པར་བགྱི།",
    "གཡས་བསྐུམ་ཞང་གཡོན་བརྐྱང་བའི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "བགེགས་རྣམས་བརླག་པར་འགྱུར་བར་གདོན་མི་ཟ།",
    "ཅེས་པས་བགེགས་རྣམས་བསྲེགས་པ་ལ་སོགས་པར་བསམ།",
    "བདག་ལ་དགོངས་པར་མཛད་དུ་གསོལ།",
    "ཡང་དག་ཉིད་དུ་བཟུང་པར་བགྱི།",
    "སེམསཅན་ཐམས་ཅད་བདེ་བ་དང་བདེ་བའི་རྒྱུ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཏེ་རངེ་ཆགས་ལྡང་གཉིས་དང་བྲལ་བའི་བཏང་སྙོམས་ལ་གནས་པར་གྱུར་ཅིག།",
    "པར་སླ་ར་ཨཞུ་པྲ་བའི་སརྦ་དྷརྨཱ་བཛྲ་ཨཉྫ་ལིཞེམ་ལྷ་ཕན་ཚུན་མར་མེ་གཅིག་ལམ་གཉིས་ཆད་ཀྱི་ཚུལ་དུ་འཕྲོས་ཏེ་འདྲེས་པར་བསམ།",
    "ཐམས་ཅད་རང་བཞིན་གྱིས་རྣམ་པར་དག་པར་གྱུར།",
    "དེས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་ཐམས་ཆད་ཀུན་ཏུ་སྣང་བར་བྱས་པོ།",
    "ཕྱག་གཉིས་ཏིང་ངེ་འཛིན་གྱི་ཕྱག་རྒྱས་རྡོརྗེ་དཀར་པརྩེ།",
