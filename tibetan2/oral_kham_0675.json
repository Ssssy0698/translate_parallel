    "དེ་ནས་བཟུང་སྟེ་བྲག་སྟེང་དུ་སྤྱིལ་བུ་བརྩིགས་པར་ཨ་ར་པ་ཙ་ན་བསྒྲུབ་དུ་བཅུག་དགུང་ལོ་བཅུ་དྲུག་པ་རབ་བྱུང་དྲུག་པའི་ཆུ་གླང་༡༣༧༣",
    "བདེ་བ་མ་བྱུང་འདུགདགུང་ལོ་ཞེ་གསུམ་པ་རབ་བྱུང་དགུ་བའི་ས་སྟག་༡༥༡༨",
    "སྔར་ས་ཕག་དུས་ཟིང་སྐབས་རྗེ་དཔལ་ལྡན་བཀྲ་ཤིས་པའི་ཡོངས་འཛིན་དྲུང་ཆེན་དཔལ་ལྡན་རྒྱ་མཚོ་དང་།",
    "ཐའི་ཇིས་ང་རང་བློ་འགྱུར་ཅེས་ལན་བཏབ།",
    "སྲས་བཅོ་བརྒྱད་འདུག་པ་ལས་ཡུལ་གྲུ་སོ་སོའི་འགོ་དཔོན་དུ་མངགས།",
    "གསར་མའི་གཤེད་སྐོར་དེ་ལེགས་པོ་ཡིན་འདུག་ཀྱང་།",
    "བྷམ་ས་ཧེབ་ཅན་གསུམ་གྱིས་སུ་ལའང་མ་གྲོས་པར་གོར་ཁའི་གང་འདོད་ལྟར་བྲིས་པ་ཡིན་འདུག་དེ་གང་ཞེ་ན།",
    "གོར་བོད་འཁྲུག་དུས་བོད་ཀྱི་སྐྱིད་གྲོང་ནས་གོར་ཁའི་མངའ་ཁོངས་བར་ས་རོང་རྩུབ་ལ་ལམ་རྒྱུད་དོག་པས་ཁ་ལམ་གཏན་ནས་མི་ཐར་བས།",
    "ད་ནི་ལྷ་སར་ང་རང་གཅིག་བུ་མ་གཏོགས་མེད་པ་དང་།",
    "བོད་མིའི་བྱེད་སྤྱོད་ལ་གཞིག་ན་ཡག་པོ་མི་འདུག་སྙམ་ནས་ཤིན་ཏུ་སྐྲག་ཅིང་འུ་ཐུག་པར་གྱུར་ཀྱང་།",
    "རྒྱལ་ཁབ་གཞན་གྱི་རྡུལ་ཕྲན་གྱི་དུག་རྫས་སྙིགས་རོའང་གླ་དངུལ་སྤྲོད་ལེན་གྱི་ཐོག་ནས་བོད་ནང་ཕུང་གསོག་བྱ་རྒྱུར་རྒྱ་ནག་གཞུང་ནས་ཁས་ལེན་བྱས་འདུགའདི་ལྟ་བུའི་ཉེན་ཚབས་ཆེ་བའི་གནས་སྟངས་ཀྱི་ཆ་ནས།",
    "ཕྲན་གྱི་གྲོགས་པོ་ཁ་ཤས་ནས་འགྲོ་བ་མིའི་རིགས་ནི་དྲག་རྩུབ་ཅན་ཞིག་ཏུ་བརྗོད་ཀྱི་འདུག་ཀྱང་།",
    "དེ་བཞིན་འགྲོ་བ་མི་ཡང་རང་བཞིན་ཞི་འཇམ་བག་ཕེབས་དང་།",
    "དེས་ཁྱེད་རང་ལའང་ཕུན་སུམ་ཚོགས་པའི་བདེ་སྐྱིད་དང་སྤྲོ་སྣང་ཡོང་རྒྱུ་ཡིན་པ་ཐེ་ཚོམ་མི་དགོས།",
    "ཧམ་པ་དང་རང་འདོད་ཁོ་ན་མི་བྱེད་པར།",
    "ཁྱེད་རང་ཡང་སྐྱེ་བ་སྔ་ཕྱི་ཡོད་པར་བསམ་བློ་འཁོར་ན།",
    "སྐྱེ་བ་ཕྱི་མ་ཁྱེད་རང་དུད་འགྲོའི་རིགས་ཤིག་གམ།",
    "ཁོང་ཁྲོ་དང་རང་གཅེས་འཛིན་འདོད་རྔམ་གྱི་བསམ་བློ་དེ་ཚོ་རྩ་མེད༵་བཟོ་དགོས།",
    "ངས་བལྟས་ན་ཁྱེད་རང་ཟླ་བའི་གོ་ལའི་ཐོག་དངོས་སུ་བསྐྱོད་ན་དེ་ནི་སྐྲི་གཡའ་བའི་མྱ་ངམ་ཐང་ཆེན་པོ་ཞིག་ཡིན།",
    "ཁྱེད་རང་འཇིག་རྟེན་༥༤འདིར་འཚོ་གནས་ཐུབ་རྒྱུ་ཁག་པོ་ཡིན།",
    "ཛ་དྲག་ཆེ་བའི་འཕོ་འགྱུར་དེར་སྤྱི་བྱེ་གང་ནས་བལྟས་ཀྱང་ཉེན་ཚབས་ཧ་ལས་དགོས་པ་ཞིག་འདུག་དཔེར་ན།",
    "འཛམ་གླིང་རང་བཞིན་གྱི་དོན་ཆེན།",
    "དེང་སང་ལྷག་པར་དུ་ཡར་རྒྱས་འགྲོ་བཞིན་པའི་རྒྱལ་ཁབ་ཁག་ནང་རང་བྱུང་ཐོན་ཁུངས་ལ་འཛེམ་བག་མེད་པར་སྔོག་འདོན་བྱེད་བཞིན་པ་དང་།",
    "ད་ཆ་རྡུལ་ཕྲན་མཚོན་ཆའི་གཏོར་བཅོམ་ལ་ཞེད་སྣང་བྱེད་དགོས་མི་འདུག་བརྗོད་པར་ཁོང་ནས།",
    "ནང་དོན་འདྲ་པོ་འདུག་དཔེར་ན།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦྦ་ཨརྠ་སཱ་དྷ་ནི་སཱཧཱ།",
    "བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་།",
    "མི་རྟག་ཅིང་རང་བཞིན་གྱིས་འོད་གསལ་ལ་གདོད་མ་ནས་མ་སྐྱེས་པ་ཉིད་དོ།",
    "མཛེས་པའི་བདག་ཉིད་ཅན་མཐོང་ནས་དགའ་ཞིང་རངས་ཏེ་བདག་སྐལ་བ་དང་ལྡན་ནོ་སྙམ་བསམས་ཏེ་དེ་ལ་གསོལ་པ།",
    "རྩ་དེའི་གཟུགས་དང་རང་བཞིན་ཇི་ལྟ་བུ་ལགས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དཔལ་ལྡན་ས་སྐྱའི་གཙུག་ལག་ཁང་མ་ཧཱ་བེ་རོ་ཙ་ན་ཨ་བཧི་སཾ་བོ་དཧི་བི་ཀུརྦ་ཏི་ཨ་དྷིཥྛཱ་ན་བེ་པུ་ལྱ་སཱུ་ཏྲ་ཨིནྡྲ་རཱ་ཛ་ནཱ་མ་དྷརྨ་པརྱཱ་ཡ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ལ་གསང་བ་པའི་བདག་པོ་ཕྱག་ན་། རྡོ་རྗེ་འཁོར་འདུས་པ་དེ་ཉིད་ན་འདུག་པ་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གང་ཐམས་ཅད་དུ་བདག་ཉིད་བཅིངས་ཤིང་འདུག་པའོ།",
    "གང་རྐང་པ་གཉིས་ལ་འདུག་སྟེ་སེམས་པའོ།",
    "ལོ་ལ་སོགས་པར་འདུག་ཅིང་བདེ་བ་དང་སྡུག་བསྔལ་རྣམ་པ་མང་པོ་མྱོང་བར་མཐོང་ལ།",
    "རྒྱལ་བའི་གནས་དབུས་འདུག་ནས་ནི།",
    "དེ་དག་དུས་གསུམ་དུ་སྒྲིབ་པ་མེད་པའི་ཡེ་ཤེས་ཀྱི་སྡོམ་པ་ཡང་འཛིན་དུ་གཞུག་གོ།",
    "བསྒྱུར་ཏེ་དེ་རུ་འདུག་ནས་སུ།",
    "པདྨ་དཀར་པོའི་སྟན་ལ་འདུག།",
    "སྤུ་དག་སེངྒེ་ལྟར་འདུག་པ།",
    "པདྨ་དཀར་ལ་འདུག་པར་བྲི།",
    "པདྨའི་སྟེང་ན་འདུག་པར་བྲི།",
    "ཁྲོ་དང་བཅས་པ་བྲག་ལ་འདུག་བཞིན་ནི་ཁྲོ་གཉེར་རབ་ཏུ་བསྙེར།",
    "བཀའ་ལུང་ནོད་པ་ལྟར་འདུག་ཅིང་།",
    "པདྨའི་སྟེང་ན་འདུག་པ་སྟེ།",
    "མེ་ལྕེ་འབར་བའི་དབུས་ན་འདུག་བགྲང་ཕྲེང་། གུནྡྷེ་ཐོགས་པར་བྲི།",
    "འདུག་ཅིང་ལྷ་རྣམས་ཀྱིས་བསྐོར་བ།",
    "ཉི་མ་ཤིང་རྟའི་སྟེང་འདུག་བྲི།",
    "ངང་པ་པདྨའི་སྟན་འདུག་བྲི།",
    "པདྨ་དཀར་པོའི་སྟན་ལ་འདུག་རབ་ཏུ་འཛུམ་པ་བཞིན་དུ་གནས།",
    "པདྨ་དམར་པོའི་སྟན་ལ་འདུག་རྒྱལ་བའི་སྲས་ལ་ལྟ་བར་བྲི།",
