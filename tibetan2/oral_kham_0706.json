    "ཁོ་ཚོས་སྐད་ཆ་ཉན་པ་ཙམ་ལས་དེར་དོ་སྣང་ཆེར་བྱེད་ཀྱི་མི་འདུག་པ་དང་།",
    "བསམ་བློའི་ནང་དེ་རིང་སྤྱི་མཚུངས་བྱས་ན་དགའ་བ་འདུག་སྙམ་པ་ལས།",
    "ང་རང་ཡང་ཅུང་ཟད་དོགས་གཟོན་སྐྱེས་ཏེ་རླངས་འཁོར་གཞུང་ལམ་བརྒྱུད་གཏོང་མ་བཅུག་པར་རྐྱང་ཐང་ན་ཁ་བརྒྱུད་ཕྱིན་སྟེ་ནོར་གླིང་།",
    "ཟིང་ཆ་ཆེན་པོ་འདུག་ཟེར་བར་ང་རང་ཡང་ཐེ་ཚོམ་སྐྱེས་ཏེ་ཕྱིར་ལོག་བརྒྱབ་ཐོག་རླངས་འཁོར་ནང་འཛུལ་ཏེ་དེ་ཉིན་ཁྱིམ་དུ་ལོག་པ་ཡིན།",
    "ཤོག་ཁག་གང་ཡིན་ངེས་གཏན་ཤེས་ཀྱི་མི་འདུག་གཤིས།",
    "དམག་སྤྱི་རྒན་པའི་སྲུང་ཁོངས་ནོར་གླིང་གཞུང་སྒོ་འཁེལ་འདུག་ངས་ཉིན་དགུང་ཆུ་ཚོད་གསུམ་པ་ཙམ་ལ་གཞུང་སྒོར་བལྟ་བར་ཕྱིན་པ་ཡིན།",
    "ལག་ཆ་མེ་སྒྱོགས་གནམ་བླུག་ག་ཅིག་མེ་མདའ་སྦག་སྦག་ཆེ་བ་གཅིག་བཅས་འདུག་པ་དེར་ངས་བཀོད་པ་བཏང་དོན།",
    "ད་དུང་མི་ཁ་ཤས་ཕར་ངོས་སུ་བསྡད་འདུག་ཟེར་བ་ཐོས་འཕྲལ་རོཊ་པ་ཕ་ལྷའི་ཕོགས་དཔོན་ཞེད་སྣང་སྐྱེས་ཏེ་འདིར་མ་བཞུགས་ཤར་གྱི་ཁང་པ་དེའི་ནང་ཐུག་འཕྲད་གནང་བར་ཕེབས་ན་ཞེས་བརྗོད་སྟབས་ང་རང་ཡང་དོགས་པ་ཆེན་པོ་ཟ་བྱུང་།",
    "མི་ཁ་ཤས་ཀྱིས་གྲིབ་ནག་འདྲེར་མཐོང་ལྟ་བུས་ང་རང་ལའང་རྡོགས་པ་ཟ་སྟེ་འཕགས་པ་ལྷའི་མཁན་ཆུང་ནང་བཞིན་སྲོག་ཉེན་ཡང་ཡོང་སྲིད་པས་དེ་རིང་གཟབ་གཟབ་བྱེད་དགོས་བསམ་སྟེ་མེ་མདའ་སྤྱི་སི་ཏོབ་ཟེར་བ་ཐུང་མདའ་གཉིས་ཡོད་པ་གཅིག་ཨམ་ཕྲག་ནང་བླུགས།",
    "མགྱོགས་པོ་ཕེབས་ན་དགའ་བ་འདུག་ཟེར་བར་ང་རང་ཡང་ཕྲན་བུ་ཚབས་ཤ་ལངས་ཏེ།",
    "དེ་རྗེས་བརྩད་གཅོད་བྱེད་སྐབས་ཁྱེད་རང་ནང་དུ་བསྡད་ཡོད་པ་གོ་ཐོས་བྱུང་།",
    "ཁྱེད་རང་སླར་ཡང་དམག་སྤྱི་བྱེད་དགོས་ཟེར་བར།",
    "ད་ཇི་བྱེད་ཟེར་གྱི་འདུག་ཁོ་པའི་རྣམ་འགྱུར་ལ་བལྟས་ན་ང་བོས་ཚེ་མཉམ་དུ་འགྲོ་རྒྱུའི་བཟོ་བལྟ་འདུག་ཀྱང་།",
    "འགྲོ་ལམ་ཆད་དེ་ཐར་ས་མི་འདུག་ལྕགས་པོ་རིར་མེ་སྒྱོགས་དང་།",
    "མེ་སྐྱོགས་ཀྱི་ཉེན་ཁ་ཆེན་པོ་འདུག་སྟབས་ངས་རང་ཉིད་ཀྱི་ཁང་པ་སྲུང་མི་སྒོ་སྲུང་ཁམས་པ་མི་གཉིས་དང་།",
    "ག་དུས་བསད་ཡོང་ངམ་སྙམ་བྱུང་།",
    "སྐུ་སྲུང་མདའ་དཔོན་སྣང་དཀར་བས་གཙོས་རུ་དཔོན་དང་ཞལ་ངོ་དམག་དཀྱུས་མི་གྲངས་སུམ་ཅུ་ཙམ་བཅས་འདུག་པ་ཞོལ་གཉེར་རམ་པ་བ་དང་།",
    "སྐལ་དོན་དང་ནང་གཟན་རྣམས་ནི་ཅི་བྱ་གཏོལ་མེད་དུ་བསྡད་འདུག་པ་མ་ཟད།",
    "གཉེར་ཆུང་སྐལ་བཟང་དོན་གྲུབ་ནི་ལྕང་མ་ལག་པར་བཟུང་བཞིན་གཡོལ་བ་ལྟ་བུས་ཕར་ཙམ་ཞིག་ན་ལངས་ནས་འདུག་པ་དང་།",
    "ནང་གཟན་དེ་ཚོ་ཡང་ཧོན་ཐོར་ནས་བསྡད་འདུག་ལམ་ཟུར་དུ་བཀག་པའི་འགྲུལ་པ་དང་མཇལ་ཁ་ཞུ་མི་རྣམས་ཀྱིས་ཀྱང་བལྟ་རུབ་རྒྱག་ཅིང་།",
    "ཨ་ཀྱཱ་སྒར་བར་སྡོད་གནས་གོ་སྒྲིག་བྱས་འདུག་ཅིང་།",
    "ཁྱེད་ཚོ་དཔོན་རིགས་ངོ་མ་མིན་སྟབས་དོན་གཅོད་ཁྲུའུནས་རོགས་ཕན་བྱ་ཐབས་གང་ཡང་མི་འདུག་ཅེས་གསལ་འདུག་པ་དང་།",
    "ཨ་ཙི།",
    "ཧོ་ཆེན་སོགས་སུ་དབོར་འདྲེན་བྱེད་ཀྱི་འདུག་པས་ངས་དེའི་སྐོར་གོང་ལ་སྙན་སེང་ཞུས་པ་ཡིན།",
    "ང་ལ་དེ་སྔ་མཚོ་བོད་ལམ་བར་ཁོ་རང་ལ་རྨི་ལམ་རྨིས་ཚུལ་བརྗོད་པར།",
    "དུས་བབས་ནི་མི་རྣམས་བློ་ཕོམ་ཡིད་ཆད་སྐྱེ་བ་ཞིག་འདུག་ཅེས་པའི་ཚིག་དོན་འཁོད་འདུག་བྱས་ཏེ་མེ་མདའ་པི་སི་ཏོབ་ཐུང་མདའ་འཁོར་ལོ་ཅན་འཕངས་ཏེ་ཀུན་དམག་དོན་སྡོམ་རྩིས་ཅུས་ཀྱི་ལྷ་སར་བཅའ་སྡོད་འགོ་པ་ཤའོ་ཙུང་བཟང་རྩེའི་རྒྱུ་སྒོའི་མདུན་དུ་བསད།",
    "ལོར་ཞིའི་ཚེས་ཉེར་ལྔ་བློ་བཟང་དོན་ཡོད་ཉིད་ཅང་ཤིན་ཤིས་ཀྱི་ཁྱིམ་དུ་མགྲོན་པོར་ཡུས་དབྱིས་ཀྱིས་ཁོ་པའི་ལས་ཀ་རྒྱུན་མཐུད་མ་བྱས་བར་ཤུའོ་ཙུང་ཆིང་ཡོ་བསྐྱོད་ནས་མཚན་གུང་རང་གནས་སུ་ལོག་པའི་སྐབས།",
    "ཧའུ་ཡིས་རྭ་སྒྲེང་ལ་སྲིད་སྐྱོང་རང་འཇགས་གནང་དགོས།",
    "ང་རང་བཅས་མི་གསུམ་ཡོད་ཅིང་།",
    "ལོག་སྤྱོད་ཤོག་ཁས་ཆེད་དུ་བཟོས་པའི་རྒྱ་བོད་མི་རིགས་བར་གྱི་འགལ་ཆའི་བསམ་བློར་ཐོག་མའི་འགྱུར་ལྡོག་ཡོང་རྒྱུར་ཕན་འབྲས་ཧ་ཅང་ཆེན་པོ་ཞིག་བྱུང་བ་ཚོར་གྱིན་འདུག་རྙོག་འཛིངས་ཀྱི་འཐབ་རྩོད་སྣ་ཚོགས།",
    "ང་རང་དང་ཧྲེང་ཙུང་ལེའང་སྔར་འབྲེལ་བ་གང་ཡང་མེད་རུང་།",
    "ཀྲོན་ཡོན་མི་གཉིས་སུ་ཡིན་དྲན་གྱི་མི་འདུག་ཁོང་གཉིས་གཞུང་ལམ་ཅུས་ཀྱི་ཀུང་ཁྲེང་ཧྲི་ཡིན་པ་དང་བོད་དུ་བཏང་སྟེ་ཁམས་བོད་གཞུང་ལམ་གྱི་ལམ་ཐིག་ལ་བརྟག་དཔྱད་བྱེད་མཁན་ཡིན་པ།",
    "སྐབས་དེར་ལྷ་ས་ནས་ཁྲུའུ་ཀྲང་གསར་པ་བསུ་བ་ཞུ་མི་ལི་གོ་ལིང་ཡང་ཀ་སྦུག་ཏུ་འབྱོར་ཟིན་འདུག་པ་ཚང་མ་མཉམ་འཛོམས་བྱུང་ཞིང་ཟླ་བ་བདུན་པའི་ཟླ་དཀྱིལ་ལ་སྒང་ཐོག་ཏུ་བསྐྱོད་པར་འབྲས་ལྗོངས་རྒྱལ་པོས་གསོལ་སྟོན་བཤམས་ནས་སྣེ་ལེན་གནང་བྱུང་།",
    "ཁོ་ཚོས་བོད་རིགས་ལ་མཐོང་ཆུང་བྱེད་ཀྱིན་འདུག་ཅེས་ཡང་ཡང་ཤོད་ཀྱི་ཡོད་འབྲེལ་འདྲིས་ཆེ་བའི་སྤོམ་མདའ་ཚང་དང་ས་འདུ་ཚང་གཉིས་ཅང་ཤིན་ཤིས་དང་འབྲེལ་བ་ཧ་ཅང་དམ་པོ་ཡོད།",
    "སྲིད་སྐྱོང་ལ་རྒྱ་མིས་དར་ཆ་མང་པོ་བཀལ་འདུག་པས་བསམ་ཡུལ་ལས་འདས་པའི་བྱ་སྤྱོད་གང་ཞིག་སྤེལ་རྩིས་ཡོད་དམ་ཞེས་སྙན་སེང་ཞུས།",
    "རང་འགན་ཡངས་གནང་རོགས་འཁོད་པའི་ཏར་ཞིག་བཏང་འདུག་པ་ངས་ལམ་སེང་དགོངས་པ་ཞུ་རྒྱུའི་བསམ་འཆར་ཕུལ་རུང་དེར་ལན་བཏབ་མ་བྱུང་།",
    "སྐབས་དེར་རང་ཉིད་ཀྱང་རང་མཚམས་ཀྱིས་ལས་གནས་ཐོག་ནས་ཁ་བྲལ་འདོད་མ་བྱུང་།",
    "ཁང་པ་འདིའི་ནང་ཁྱེད་རང་བཞུགས་པ་གནང་།",
    "ང་བཀའ་ཤག་ནས་ལོག་ཡོང་སྐབས་ས་རུབ་ལ་ཉེ་བར་འདུག་ཅིང་།",
    "མདའ་དཔོན་གྱིས་མི་རྩིས་སྤྲོད་རྒྱུ་ཡིན་པས་དེ་དོན་གནང་དག་མེད་པ་ཞུས་ཆོག་ཅེས་ཟེར་གྱི་འདུག་པས་ཚང་མས་ཉན་རྗེས་གཞི་ནས་སོ་སོར་ཕྱིར་ལོག་བྱས།",
    "རྟ་ར་ཅོག་དུས་སྣེ།",
    "སྐབས་དེར་ཀ་ལི་ཀ་ཏར་བཅའ་སྡོད་སྤྱི་ཁྱབ་ལིང་ཧྲི་ཁང་ལ་སྤྱི་ཁྱབ་ལིང་ཧྲི་མི་འདུག་པས་ཧོ་མན་ཧྲན་གྱིས་སྤྱི་ཁྱབ་ལིང་ཧྲིའི་ལས་ཚབ་བྱེད་ཀྱི་ཡོད།",
    "སྐུལ་བསྐྱོད་བྱེད་སྐབས་བྲང་ཁོག་བསྣམས་ནས་དབུགས་རྔུབ་གཏོང་བྱེད་རྒྱུར་དཀའ་ངལ་ཆེན་པོ་འདུག་དམག་དཔུང་ལ་ས་མཐོའི་ཐོག་རི་བོ་འཛེགས་པའི་ཉམས་མྱོང་མེད་པ་དང་།",
    "ལུག་ཤ་བཅས་ཟ་བ་དེ་ཡང་ཧ་ཅང་ཉུང་ཉུང་ལས་མི་འདུག་བོད་རིགས་ཀྱི་སྡོད་ཁང་ནི་རྡོ་ཤིང་ལས་གྲུབ་པའི་ཁང་པ་ཡིན་པ་དང་།",
    "འབྲས་ཉམས་མེད་དམག་དཔུང་ལ་སྐྱེལ་བ་སོགས་བྱེད་ཀྱི་འདུག་ཁྱེད་ཚོས་དེ་དག་འཁྲུབ་ཚན་ཆུང་ཆུང་ཞིག་བརྩམས་ནས་འཁྲབ་དགོས།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "བདེན་པ་གཉིས་ཆར་དུའང་རང་བཞིན་གྱིས་སྐྱེ་བ་བཀག་པ་ལ་རྟག་ཆད་ཀྱི་ལྟ་བ་སྤང་སླ་བའི་ཡོན་ཏན་བསྟན་པའི་ཚིག་རྐང་གཉིས་ནི།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པས།",
    "རིགས་པ་གཞན་གྱིས་ཀྱང་རང་རིག་མི་འཐད་པར་བསྟན་པའི་སྐྱསྤྲ་ཀ་གཅིག་ནི།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དང་ཐོག་མ་དང་མཐའ་མ་མེད་པ་སྟོང་པ་ཉིད་དང་དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དང་རང་བཞིན་སྟོང་པ་ཉིད་དང་བཞི་བསྟན་པའི་སྐྱསྤྲ་ཀ་བདུན་ནི། ། གང་ལ་མཐའ་ནི་ཡོད་མིན་པ།",
    "སློབ་དཔོན་གྱིས་བཞི་ག་སེམས་བསྐྱེད་སྟོན་བྱེད་ཀྱི་གཞུང་དུ་བྱས་འདུག་པས།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "བདག་མེད་རྟོགས་པའི་ཤེས་རབ་སོགས་བསམ་སྦྱོར་ཕུན་ཚོགས་ཚོགས་གཉིས་རླབས་པོ་ཆེ་ལས་འཁྲུངས་པར་འདུག་སྙམ་དུ་བདེན་པ་གཉིས་ཀྱི་རྣམ་དབྱེ་དཔྱིས་ཕྱིན་པར་ཤེས་པ་དེ།",
    "ཉི་ཁྲི་དང་བརྒྱད་སྟོང་པ་ནས་ཁ་བསྐངས་པ་ཡིན་འདུག།",
    "ཡང་བེ་རོ་ཙ་ནས་བསྒྱུར་བ་དུམ་པ་དྲུག།",
    "ཕུང་པོ་བཞི་ལས་དོན་གཞན་དུ་གྱུར་པའི་འདུས་བྱས་ཞེས་གསུངས་པ་ནི་ལྡན་མིན་འདུ་བྱེད་རྫས་སུ་གྲུབ་ཅིང་རང་གང་ལ་ལྡན་པའི་གནས་སྐབས་ཅན་དེ་ལས་རྫས་གཞན་དུ་འདོད་པའི་ལུགས་སོ།",
    "ཡང་དད་པས་དང་ཆ་འཛིན་པ་ཡང་རང་སྟོབས་དང་།",
    "གཞན་གྱི་ཡུལ་ན་འདུག་པ་ལྟར་རོ་ཞེས་གསུངས་ལ།",
    "དཔེར་ན་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་དེས་རྟོག་པའི་ཡུལ་ལ་ཞེན་པ་མ་ཡིན་ཡང་དེའི་རྫས་ལ་ཡུལ་ལ་ཞེན་པའི་ཆ་ཡོད་པ་ནི་རྟོག་པ་ཡིན་གྱི་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་མ་ཡིན་པ་བཞིན་ནོ།",
    "བཏང་སྙོམས་ནི་དུག་གསུམ་མེད་པ་བརྩོན་འགྲུས་དང་བཅས་པ་ལ་གནས་ནས་སེམས་རྣལ་དུ་འདུག་པའི་སེམས་བྱུང་།",
    "རང་རང་བསྣན་པས་ཉི་ཤུ་རྩ་གཅིག་དང་ལྡན་ཏེ།",
    "སྔར་བག་ཆགས་བསྒོ་བར་བྱ་བའི་གཞི་དེ་འབྲས་བུ་དེ་དང་དེ་སྐྱེད་པའི་ནུས་པ་དང་མི་ལྡན་པའམ་ནུས་པ་མཐུ་ཆུང་ངུར་འདུག་པ་ལ་ཕྱིས་ནུས་པ་དང་ལྡན་པའམ་ནུས་པ་མཐུ་ཅན་དུ་གྱུར་པ་དགོས་པའི་ཕྱིར་རོ།",
    "ཆ་ལས་ཕྱི་རོལ་ལྟ་བུར་འདུག།",
    "མིང་དང་གཟུགས་མདུང་ཁྱིམ་ལྟར་གཅིག་ལ་གཅིག་བརྟེན་པའི་ཚུལ་གྱིས་འདུག་པར་གསུངས་པ་གང་ཡིན་པ་དེའང་མི་རུང་སྟེ།",
    "འདུག་ས་འདི་ཉིད་དུ་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "མགོ་ཝ་ཞྭ་ཅན་གྱི་ཨ་ཞང་སྐྱིད།",
    "འབྲོང་རི་དམར་གོང་ནས་འདུག་སྲོལ་ཡག།",
    "ང་རང་ང་སྤུན་འདང་ཡོད་ནི་མིན།",
    "ད་ལོ་ཨ་ཞང་མགོ་ན་ཡོད།",
    "རྗེ་བེ་རོ་ཙ་ནས་སྐུ་གཡོག་བསྒྲུབས།",
    "ཁ་མ་འདུག་མ་ཎི་འདོན་ཞོར་ར།",
    "ལག་མ་འདུག་མདའ་རྩེ་འབེན་ལ་བྱོས།",
    "ཀ་རྟ་འདོ་བ་སྐྱིད་དུས་སྡུག་དུས་ཡོད།",
    "མཛོ་ཁྱུང་དཀར་སྐྱིད་དུས་སྡུག་དུས་ཡོད།",
    "སྡུག་དུས་གནས་ཡུལ་ཁྱིམ་ན་ཡོད།",
    "བྱ་ངང་བ་མཚོ་ནང་འདུག་དུས་ན།",
    "ཉ་གསེར་མིག་ངང་བའི་འདུག་རོགས་བྱས།",
    "བྱ་ཁུ་བྱུག་ནགས་ནས་འདུག་དུས་ན།",
    "བྱ་ནེ་ཙོ་རྨ་བྱའི་འདུག་རོགས་བྱས།",
    "ང་གླུ་བ་གྲལ་ནས་འདུག་དུས་ན།",
    "རྟ་འདོ་བ་སྐྱིད་དུས་སྡུག་དུས་གཉིས།",
    "མཛོ་ཁྱུང་དཀར་སྐྱིད་དུས་སྡུག་དུས་གཉིས།",
    "སྡུག་དུས་རི་ཞིང་ཁུག་ན་ཡོད།",
    "སྡུག་དུས་གནས་ཡུལ་མཚམས་ན་ཡོད།",
    "ནམ་ལངས་ནས་ཉི་རྩེ་འགྱོག་དུས་ན།",
    "སེར་གྱི་ལེར་ཉི་རྩེ་འཇོག་དུས་ན།",
    "ཞེ་ཆགས་རུང་འདུག་ས་གང་ན་ཡོད།",
    "ཞེ་ཆགས་རུང་འདུག་ས་གང་ན་ཡོད།",
    "གསེར་བྱ་མི་འདུག་འཕུར་རྒྱུ་ཡིན།",
    "དངུལ་བྱ་མི་འདུག་འཕུར་རྒྱུ་ཡིན།",
    "ནེ་ཙོ་མི་འདུག་འཕུར་རྒྱུ་ཡིན།",
    "ང་མགྲོན་པོ་མི་འདུག་འགྲོ་རྒྱུ་ཡིན།",
    "ང་མགྲོན་པོ་མི་འདུག་འགྲོ་རྒྱུ་ཡིན།",
    "ང་མགྲོན་པོ་མི་འདུག་འགྲོ་རྒྱུ་ཡིན།",
    "གསེར་བྱ་མི་འདུག་འཕུར་རྒྱུ་ཡིན།",
    "དངུལ་བྱ་མི་འདུག་འཕུར་རྒྱུ་ཡིན།",
    "ནེ་ཙོ་མི་འདུག་འཕུར་རྒྱུ་ཡིན།",
    "སྤོབས་པ་མེད་པས་བྱེད་པར་འགྱུར་བས་མི་སྨྲ་བར་འདུག་པར་གྱུར་པའི་ཕྱིར་ཏེ།",
    "སྒྲུབ་པའི་ངོ་བོ་ཡང་རང་བཞིན་གྱི་ངོ་བོ་དང་རྒྱུའི་ངོ་བོར་འགྱུར་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པས་མི་གསལ་བའི་དོན་རྣམས་སོ།",
    "གྲུབ་པ་དེ་ཡང་རང་ཡོད་ན་བདག་ཉིད་དུ་ཉེ་བ་སྟེ།",
    "གང་བསྐལ་པ་རྣམ་པ་གསུམ་གྱི་ངོ་བོ་བསྒྲིབས་པ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱི་མཚན་ཉིད་རི་རབ་དང་ར་མ་ན་དང་ལྷ་ལ་སོགས་པའི་ངོ་བོ་ལྟ་བུ་དེས་མ་བསྐལ་པ་ནི་རང་བཞིན་ཁྱད་པར་ཅན་དུ་བརྗོད་དོ།",
    "རིན་མེད་པར་ཡང་རང་ངོ་བོ་འཇོག་པ་ནི་བཞད་གད་དུ་བྱེད་པའོ།",
    "འདིས་ནི་འགལ་བའི་འབྲས་བུ་དམིགས་པའི་ཡང་ཡུལ་དང་རང་བཞིན་གྱིས་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་ཏུ་སྒྲུབ་པ་ནི་གོ་སླ་བ་ཉིད་དོ།",
    "གཉིས་པོ་མི་བརྗོད་པ་ནི་མི་སྨྲ་བར་འདུག་པས་སོ།",
    "འོ་ན་ཡོད་པའི་བདག་ཉམས་པ་དང་མེད་པའི་བདག་ཐོབ་པར་ཁས་བླངས་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་གཅིག་པའི་རྣམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བ་གང་ཡིན་པ་འདིའི་ཕྱོགས་ལ་དམ་བཅའ་སྔ་མ་དེ་ནི་འདིར་གྲུབ་པར་མི་འགྱུར་ཏེ།",
    "རྐང་མིག་བདག་ཉིད་འདིར་རང་བཞིན་འགྱུར་བའི་མཚན་ཉིད་འདྲི་བར་བྱེད་ཅིང་རང་བཞིན་དང་འདྲེལ་པ་མེད་ཅིང་ངེས་པ་མེད་པས་རང་བཞིན་གྱི་དོན་ལ་རག་ལས་པའི་ཕྱིར་ཚིག་ལ་འཇུག་པར་བྱེད་དོ།",
    "དེ་ལྟ་ན་གྲངས་ཅན་དེའི་གཏན་ཚིགས་མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པའི་སྐྱོན་བརྗོད་པས་བརྩད་པ་ན་གསལ་བ་འདི་དང་རང་བཞིན་གཅིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་སུན་དབྱུང་བར་འགྱུར་རོ།",
    "རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱང་རང་བཞིན་གྱིས་ལྐོག་ཏུ་གྱུར་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཅི་ལྟར་ཡང་ཡོད་པ་མ་ཡིན་ཞིང་དེ་ཙམ་གྱི་རྗེས་སུ་འདྲེལ་པར་མ་གྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཙུག་ཏོར་དྲི་མ་མེད་པར་སྣང་བའི་གཟུངས་བཀླག་ཅིང་མཆོད་རྟེན་བརྒྱ་རྩ་བརྒྱད་དམ་མཆོད་རྟེན་ལྔ་གདབ་པའི་ཆོ་གའགྲོ་བའི་དོན་དུ་གཟུགས་སྐུ་ཙིར་ཡང་གདའ།",
    "ཇི་ལྟར་ཉི་ཟླ་ནི་དོག་ས་ལ་ལྟུང་ཡང་གདའ།",
    "རི་རབ་རིའི་རྒྱལ་པོ་ནི་གནས་ནས་འཕོ་ཡང་གདའ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ནི་དུས་ལས་ཡོལ་ཡང་གདའ།",
    "སེམས་ནི་ཞགས་པས་གཟུང་དུ་རུང་ཡང་གདའ།",
    "འདུན་ཚོགས་ནས་སྟན་བདེ་བ་ལ་འདུག་ནས་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ཅི་ནུས་སུ་བསྒོམ།",
    "མགོ་མཇུག་དུས་ཀུན་དུ་གནོད་སེམས་དང་།",
    "ཕྲ་མེན་གྱི་སྦྱོར་བ་ངན་པ་ཐམས་ཅད་རང་ཞིག་ཅིང་རང་ཞི་བར་གྱུར་ཅིག།",
    "ཅི་བསམས་པའི་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ་ཞེས་ཇི་སྐད་བཀའ་སྩལ་པ་འདི་ལྟར་ཉི་ཟླ་ནི་དོག་སར་ལྟུང་ཡང་གདའ།",
    "རིའི་རྒྱལ་པོ་ནི་གནས་ནས་འཕོ་ཡང་གདའ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ནི་དུས་ལས་ཡོལ་ཡང་གདའ།",
    "བསེར་མ་ནི་ཞགས་པས་བཟུང་དུ་རུང་བར་འགྱུར་ཡང་གདའི།",
    "ཕན་ཡོན་དཔག་ཏུ་མ་མཆིས་པ་རྒྱས་པར་བཀའ་སྩལ་པ་འདི་ལྟར་ཉི་ཟླ་ནི་དོག་སར་ལྷུང་ཡང་གདའ།",
    "རི་རབ་རིའི་རྒྱལ་པོ་ནི་གནས་ནས་འཕོ་ཡང་གདའ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ནི་དུས་ལས་ཡོལ་ཡང་གདའ།",
    "བསེར་མ་ནི་ཞགས་པས་གཟུང་དུ་རུང་ཡང་གདའི།",
    "འདི་ལྟར་ཉི་ཟླ་ནི་དོག་སར་ལྷུང་ཡང་གདའ།",
    "རི་རབ་རིའི་རྒྱལ་པོ་ནི་གནས་འཕོ་ཡང་གདའ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ནི་དུས་ལས་ཡོལ་ཡང་གདའ།",
    "བསེར་མ་ནི་ཞགས་པས་གཟུང་དུ་རུང་བར་ཡང་གདའི།",
    "བཙོན་བཅུག་དུས་བཀག་ཐིམ་ནས་གློད་གྲོལ།",
    "ངའི་ཕ་མ་གཉིས་ཀྱང་སྤྲང་པོའི་གནས་སུ་གྱུར་བས་ས་གནས་གཞན་དུ་རྩམ་པ་སློང་བར་འགྲོ་དགོས་ཐུག་ང་རང་ནང་ལ་འོག་མ་དང་བ་ཕྱུགས་གཉིས་ལ་ལྟ་སྐྱོང་བྱས་ནས་བསྡད།",
    "དེ་དུས་ང་རང་ལོ་བཅུ་གཅིག་ཡིན་པ་དང་།",
    "སྐབས་དེར་པ་ལགས་ཁོང་ཁྲོ་ཟ་ནས་ང་རང་ལ་ཉེས་རྡུང་མང་པོ་བཏང་བྱུང་།",
    "ཉལ་ཆས་མེའི་སྟེང་དུ་ཐེངས་མང་དབྱུག་དབྱུག་བྱས་རྐྱེན་ཉལ་ཆས་ཚང་མ་མེས་ཚིག་འདུག་སྐབས་དེར་བོད་སྤྱི་ཡོངས་སུ་འཚོ་གོས་ཀྱི་དཀའ་ངལ་ཤིན་ཏུ་ཆེན་པོ་ཡོད།",
    "ལས་གྲྭ་དེར་ང་རང་ཡང་ཕ་མ་གཉིས་དང་མཉམ་དུ་ཕྱིན་པ་ཡིན།",
    "ང་རང་ལ་ཆུང་དུས་ནས་ཕ་མ་གཉིས་ཀྱིས་ཞིང་ལས་བྱེད་སྟངས་ཀྱང་མང་པོ་བསླབས་མྱོང་།",
    "ཆར་བ་མ་འབབ་སྟབས་ག་དུས་ཡིན་ནའི་འཚོ་བར་དཀའ་ངལ་འཕྲད་དེ་བསངས་བཙོངས་ཚར་བ་དང་རྩམ་པ་སློང་བར་འགྲོ་ཡི་ཡོད།",
    "ཉིན་དགུང་ཞལ་ལག་སྐབས་ལ་འཁེལ་འདུག་པས་བསངས་མང་པོ་བྲིན་གྱི་འདུག་ཀྱང་།",
    "དེ་མུར་མ་འདུག་པར་པ་ལགས་མཉམ་དུ་རྟ་འཚོང་རྒྱག་པར་ཕྱིན་ཏེ་འཚོ་བའི་དཀའ་ངལ་སེལ་ཐབས་བྱེད་པ་དང་།",
    "ལོ་གསར་ཉེ་བར་ཟླ་བ་གཅིག་ལས་བསྡད་མེད་ཁར་ཕ་མ་གཉིས་ནས་ཉིན་བཅུ་ལས་ཀར་བསྡད་དེ་ལོག་ཤོག་གསུང་ནས་ལས་ཀར་འགྲོ་སྐབས་ལམ་བར་ཚོང་ཁང་ནས་ཐ་མག་སྒམ་ཆུང་བཞི་ཉོས་ཏེ་ལས་ཀ་བྱེད་སར་འབྱོར་བ་དང་ང་རང་རོགས་པ་ཚང་མ་མཉམ་དུ་འཛོམས་ནས་གནས་ཚུལ་རྣམས་བཤད།",
    "བོད་ཚེས་བདུན་ཉིན་གྱི་ཉིན་དགུང་ཆུ་ཚོད་བཅུ་གཉིས་ཙམ་ལ་གྲལ་འཛིན་བྱས་ཏེ་ཚོགས་འཁྱུག་ཙམ་ཚོགས་དགོས་ཀྱི་འདུག་པས།",
    "དེའི་སྐབས་ང་རང་དང་པོ་འགྲོ་སྐབས་ཚེ་སྔོན་ལས་དང་བག་ཆགས་ཀྱིས་སེམས་པ་སྐྱོ་ནས་མིག་ཆུ་ཤོར་བྱུང་།",
    "སྦྱིན་བདག་རྣམས་ཀྱི་ཕྱག་ཏུ་གདུག་སྤོས་བསྣམས་ཏེ་བརྗིད་ཉམས་ལྡན་པའི་ངང་སྤོས་འཁོར་དུ་ཕེབས་ཀྱི་འདུག་དེ་ཉིན་ཐུག་པ་མིང་ལྡན་ནང་མར་ཁུ་དང་ཤ།",
    "དེའི་མཚམས་ལ་ང་རང་ཆབ་སྲིད་ཀྱི་ཐོག་ལ་ལེགས་ཉེས་གང་ཡང་ཤེས་ཀྱི་མེད།",
    "སྐབས་དེར་ང་རང་ལོ་བཅུ་བདུན་ལ་སོན་ཙམ་ཡིན།",
    "༡༩༨༧ ལོར་ང་རང་ནང་ལ་ལོ་གསར་གཏོང་བར་འགྲོ་རྒྱུ་བྱུང་།",
    "སྐབས་དེར་ཕྱི་རྒྱལ་སྐྱེས་པ་ཞིག་དང་སྐྱེས་དམན་ཞིག་དེ་གར་ཡོང་བ་དང་སྟབས་འཁེལ་ནས་ཁོང་གཉིས་ཀྱིས་ང་རང་དཔར་རྒྱབ་པ་དང་།",
    "རྒྱ་དམར་གུང་བྲན་གྱིས་བཙན་བཟུང་བྱས་པ་ནས་བཟུང་བོད་ནང་དུ་རང་རིགས་ཤ་ཁྲག་གཅིག་པའི་སྤུན་ཟླ་དམར་གསོད་དང་རང་ཤི་རྒྱབ་པ།",
    "ང་རང་སྐབས་དེ་དུས་སྐད་འབོད་བྱས་མེད།",
    "ནང་ནས་ཡོང་གྲབས་བྱེད་ཀྱི་འདུག་པས།",
    "ང་རང་ལམ་སེང་སྒོ་རྒྱབ་ལ་ཡིབ་ནས་བསྡད་པ་ཡིན།",
    "དེ་ནས་ངའི་རྐང་པ་ཏོག་ཙམ་དྲག་ཏུ་ཕྱིན་འདུག་པ་མ་ཟད།",
    "མགྱོགས་པོ་ང་རང་གསང་སྤྱོད་ནང་ནས་དོན་ཏེ་བྲོས་ཕྱིན་པ་ཡིན།",
    "དེ་ནས་ང་རང་ལ་རྐང་ལྕགས་ལག་ལྕགས་གཉིས་ཀ་བརྒྱབ་བྱུང་།",
    "བཙོན་སྲུང་བ་གཞན་པ་དེ་ཚོས་དགོད་བཞིན་ད་སྐྱིད་པོ་འདུག་གམ་བརྗོད།",
    "ང་རང་གནམ་ཐག་རྒྱབ་ནས་བཞག་སྐབས་འཁྲིས་སུ་ཡར་མར་བཙོན་པ་རྙིང་པ་དེ་འདྲ་མང་པོ་འགྲོ་ཡི་འདུག་པས་ང་ལ་ཡང་ཡང་བལྟ་བ་དང་།",
    "འདྲི་ཞིབ་བྱེད་སའི་ཁང་པ་གཞན་གྱི་ནང་ནས་བོད་མི་འགའ་ཤས་ཉེས་བརྡུང་བཏང་སྟེ་ན་ཟུག་བཟོད་མ་ཐུབ་པར་ངུ་འབོད་བྱེད་པའི་སྒྲ་ཡང་རྣ་བར་ཐོས་བཞིན་འདུག་པས།",
    "རྗེས་སུ་རྐང་པའི་མཐིལ་ལ་རྨ་མང་པོ་བཟོས་འདུག་དེ་ནས་སླར་ཡང་དྲི་བ་ལེན་ཏེ་ངས་བོད་རང་བཙན་ཡིན་ཞེས་སྐད་འབོད་བྱས་པ་ཡིན་ཅེས་བརྗོད་པས།",
    "གང་ཡིན་ཟེར་ན་སྐྲ་རིང་པོ་མེད་པ་དང་རྐང་ལྕགས་ལག་ལྕགས་རྒྱབ་ནས་ཁྲིད་འགྲོ་བཞིན་འདུག་ང་རང་ལ་སླར་ཡང་དྲི་བ་ཞིག་ལེན་པར་སླེབས་བྱུང་བས།",
    "དྲི་བ་གཙོ་བོ་ནི་རྒྱ་དམག་བསད་པའི་སྐོར་ལ་དྲི་བ་ལེན་གྱི་འདུག་པ་མ་ཟད།",
    "ངོ་ཤེས་ཀྱི་འདུག་གམ་ཞེས་སྐད་ཆ་དྲིས་བྱུང་བས་ངས་མི་དེ་རྣམས་ངོ་ཤེས་ཀྱི་མེད་ཅེས་ལབ་པ་ཡིན།",
    "རུང་བློ་སྟོབས་ཆེན་པོ་ཞེ་དྲག་འདུག་སྙམ་བྱུང་།",
    "ང་རང་ཡང་གྲོད་པ་མང་པོ་བཤལ་བྱུང་།",
    "དེར་ང་རང་ཡ་མཚན་ཆེན་པོ་བྱུང་།",
    "སྦི་རག་ཀྱང་སྤྲད་འདུག་དེ་ཉིན་ཞིག་ཞོགས་པའི་ཆུ་ཚོད་བདུན་དང་ཕྱེད་ཀའི་ཐོག་ཁོ་པ་འཁྲིད་དེ་བསད་ཡོད་པ་མ་ཟད།",
    "༡༩༨༨ ཟླ་༩ ཚེས་༡༥ ཞོགས་པ་ང་རང་ལ་གཉིད་ལམ་དེས་རྐྱེན་སེམས་སྐྱིད་པོ་བྱུང་བ་མ་ཟད།",
    "བཙོན་ཆས་དེ་ཚོ་བཟོ་ལྟ་ངན་པོ་ཞེ་དྲག་འདུག་དཔེར་ན།",
    "སྐབས་དེར་ལས་ཀ་དཀའ་ངལ་ཤིན་ཏུ་ཆེན་པོ་འདུག་ལམ་བར་དུ་རླངས་འཁོར་ནང་ནས་ཕྱི་ལོགས་ཀྱི་མི་དམངས་མཐོང་དུས་སེམས་ནང་དགའ་ཚོར་ཆེན་པོ་བྱུང་།",
    "ང་རང་དངོས་གནས་དགའ་པོ་བྱུང་བ་མ་ཟད།",
    "ང་རང་ནམ་རྒྱུན་མང་ཆེ་བ་ཆུ་རགས་རྒྱབ་པར་འགྲོ་བཞིན་ཡོད་པ་དང་།",
    "དེར་ལྷ་ཁང་ཆུ་ཆུང་ཞིག་དང་སྟོབས་ལྡན་སྡོད་སའི་ཁང་པ་ཞིག་འདུག་སྟོབས་ལྡན་ཁོ་རང་ལ་སྐྱེ་དམན་དང་ཕྲུ་གུ་ཁ་ཤས་ཡོད་ཅིང་།",
    "ང་རང་རྒྱལ་སྒོ་བརྒྱབ་ས་ནས་ཉིན་དགུང་ཁ་ལག་ཟ་བར་ཕྱིན་པ་ཡིན།",
    "ཁྲག་དེ་རྣམས་གོ་ཐོས་ལ་རྒྱ་མིའི་དཔོན་རིགས་ཚོ་དང་མཐའ་མཚམས་དམག་མིར་བླུགས་པའི་གནས་ཚུལ་གོ་རྒྱུ་འདུག་རྒྱ་མིས་བོད་ནང་རིག་དངོས་ཤུལ་མེད་བཟོས་པ་མ་ཚད།",
    "དེ་དག་ཚང་མ་བོད་པ་ཤ་སྟག་ཡིན་འདུག་ལ།",
    "དགའ་གྲྭ་བཀྲིས་བཙོན་བཅུག་དུས་བཀག་ལོ་དགུ་འཕར་སྣོན་བྱས་པ་དང་།",
    "བཙོན་གྲོགས་གཞན་ཚོས་ང་རང་བཟུང་བྱུང་།",
    "༡༩༩༡ ཟླ་༤ ཚེས་༡༧ ཉིན་བཙོན་འཇུག་དུས་བཀག་ཐིམ་ནས་ཀློད་བཀྲོལ་བྱུང་།",
    "ཁོ་པ་ཁོང་ཁྲོ་བཙོན་འཇུག་དུས་བཀག་ཐིམ་ནས་ཀློད་བཀྲོལ་བྱས་པའི་སྐོར།",
    "དེ་ནས་ནང་ལ་ལོག་ནས་གཙང་ཏོག་ལ་རླངས་འཁོར་འབབ་སྟེ་པ་ལགས་དང་མཉམ་དུ་གོམ་པ་རྒྱབ་ནས་ལོག་དུས།",
    "བཙོན་འཇུག་དུས་བཀག་ཐིམ་ནས་ཀློད་བཀྲོལ་བྱས་པའི་སྐོར།",
    "གང་ཡིན་ཞེ་ན་ང་རང་དེ་སྔོན་ཕྲུ་གུ་ཉར་མྱོང་མེད་ཙང་ཞབས་ཕྱི་ཡོང་བ་མི་འདུག་ཅེས་བརྗོད་པ་ཡིན།",
    "དེ་ནས་ང་རང་ཟ་ཁང་ལས་ཀ་བྱས་ནས་བསྡད་དུས་ངའི་ངོ་ཤེས་པ་མང་པོས་ཟ་ཁང་ནང་ལས་ཀ་བྱས་ཏེ་བསྡད་ཡོད་པ་མཐོང་ནས།",
    "ངས་ཟ་ཁང་ལས་ཀ་སྐྱིད་པོ་འདུག་ཅེས་ལབ་པ་ཡིན།",
    "ཟ་ཁང་དེའི་ནང་ལས་ཀ་སྐྱིད་པོ་ཞེ་དྲག་འདུག་ཡིན་ནའང་དབུ་ཚུགས་བྱས་ཞེ་དྲག་བསྡད་ན་སྦྱིན་བདག་ལ་དཀའ་ངལ་བཟོས་བཙོན་འཇུག་དུས་བཀག་ཐིམ་ནས་ཀློད་བཀྲོལ་བྱས་པའི་སྐོར།",
    "རྣམ་གྲྭ་བྱམས་པ་ཕུན་ཚོགས་ལགས་ཁོ་རང་ལོ་ན་མཐོ་བ་མ་ཟད།",
    "ང་བོད་ནས་བྲོས་བྱོལ་དུ་ཡོང་མཁན་རྣམས་ནས་གླ་ཆ་བླངས་ཏེ་འཁྲིད་ཀྱི་ཡོད་ཅེས་བརྗོད་ཀྱི་འདུག་ངས་ས་ཆ་ག་ནས་འགྲོ་དགོས་མིན་དང་།",
    "ལྷག་པར་དུ་ང་རང་དང་རྣམ་གྲྭ་བྱམས་པ་ཕུན་ཚོགས།",
    "དེའི་སྐབས་བལ་ཡུལ་སྣེ་ལེན་འགན་འཛིན་བློ་བཟང་ཞེས་པ་ཞིག་འདུག་ཅིང་།",
    "སྐབས་དེར་ང་རང་ན་ཚ་སྡུག་ཏུ་ཕྱིན་ཞིང་།",
    "འོན་ཀྱང་དེ་ནི་རིའི་སྒང་ལ་ཆགས་ཤིང་འགྲུལ་སྐྱེལ་རླངས་འཁོར་ནས་མར་བབས་སྐབས་ང་རང་མི་གཉིས་ཀྱི་སྐྱོར་ནས་སྣེ་ལེན་ཁང་དུ་འཁྲིད་བྱུང་།",
    "མཇལ་ཁ་ཞིག་བྱུང་ན་ག་དུས་འཆི་བ་ཡིན་ནའི་འགྱོད་པ་མེད་བསམ་བྱུང་།",
    "ང་གཉིས་བསམ་པར་མི་དེ་འདྲ་དམག་སྒར་གྱི་འགོ་འཁྲིད་ལ་སླེབས་པ་དེ་དངོས་གནས་འགྲིག་འདུག་བསམ་བྱུང་།",
    "སྐབས་དེར་ང་རང་ལ་དེང་སྐབས་གཟུགས་པོ་བདེ་མིན་གང་འདྲ་ཡོད་མེད་སྐོར་བཀའ་འདྲི་གནང་བྱུང་།",
    "ངས་དེང་སང་ཏོག་ཙམ་དྲག་ཏུ་ཕྱིན་འདུག་ཅེས་ཞུས་པ་ཡིན།",
    "ཉིན་ཤས་རྗེས་མེག་ལོར་གན་ཇི་ནས་ང་རང་མཚན་ཉིད་གྲྭ་ཚང་ལ་སྤོས་པ་ཡིན་ལ།",
    "༡༩༩༢ ཟླ་༡ ནང་སུད་སིར་ཡོད་པའི་མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱི་བོད་དོན་ཐོག་རྒྱབ་སྐྱོར་བྱེད་མཁན་མི་སྣ་གལ་ཆེན་ལྕམ་ཀྲི་ཀ་ལགས་བཞུགས་སྒར་རྡ་རམ་ས་ལར་ཕེབས་ཏེ་ང་རང་སླར་ཡང་མཇལ་འཕྲད་བྱུང་།",
    "ལམ་བར་དུ་ཕ་རན་སིའི་གནམ་ཐང་དུ་ང་རང་བསུ་མཁན་ཡོད་དམ་བསམ་པའི་སེམས་ཚབས་བྱུང་།",
    "དེར་བོད་པའི་ཟ་ཁང་པད་མ་ཐང་ཞེས་པ་ཞིག་ཡོད་པ་དེའི་ནང་དུ་ཇ་འཐུང་བར་ཕྱིན་ནས་ང་རང་སྡོད་སར་བསྐྱལ་བྱུང་།",
    "ང་རང་དེར་སྡོད་རིང་ཁང་པ་སྐྱིད་པོ་དེ་འདྲའི་ནང་སྡོད་པ་ཐེངས་དང་པོ་ཡིན་པ་མ་ཟད།",
    "དེ་ནས་ཉིན་ཤས་རྗེས་འཇིགས་མེད་ལགས་ཀྱིས་ཕ་རན་སེ་ལ་ཡོད་པའི་བོད་པ་བསྟན་འཛིན་ཀུན་ཁྱབ་ལ་འབྲེལ་བ་གནང་སྟེ་ང་རང་ཕ་རན་སེ་རྒྱལ་སའི་ནང་བལྟ་སྐོར་ལ་འཁྲིད་བྱུང་བས།",
    "ང་རང་བཅས་ཡིན་ཞེས་ཐག་གཅོད་གནང་།",
    "༡༩༩༣ ཟླ་༨ ཚེས་༨ཞོགས་པ་ཕ་རན་སེ་རྒྱལ་ས་པེ་རལ་སེ་ནས་ཞོགས་པ་ཆུ་ཚོད་དྲུག་པ་ཙམ་ལ་བོད་དོན་རྒྱབ་སྐྱོར་ཚོགས་པའི་ཚོགས་གཙོ་སི་རི་དང་སྐད་བསྒྱུར་བཅས་ང་རང་བསུ་བར་ཕེབས།",
    "ང་རང་ལ་སེམས་གསོ་ཡང་གནང་བྱུང་བ་མ་ཟད།",
    "ཁོང་གསུམ་གྱིས་དབྱིན་ལན་ནང་དུ་ཡོད་པའི་བོད་དོན་རྒྱབ་སྐྱོར་ཚོགས་པ་སོགས་ཀྱི་སྐོར་ང་རང་ལ་ངོ་སྤྲོད་གནང་བྱུང་།",
    "ཉིན་དགུང་ཆུ་ཚོད་དང་པོ་ཙམ་དུ་སྐུ་ཚབ་དོན་གཅོད་ཀྱིས་དབྱིན་ཇིའི་གྲོས་ཚོགས་ཀྱི་མི་སྣ་གལ་ཆེ་ཞིག་ལ་ཐུག་འཕྲད་གནང་འདུག་སྐབས་དེར་ངའི་སྐད་བསྒྱུར་བོད་གཞུང་སྐུ་ཚབ་སྟག་ལྷ་སྐལ་བཟང་དབྱངས་སྐྱིད་ལགས་ཡིན།",
    "བོད་དོན་རྒྱབ་སྐྱོར་ཚོགས་པའི་ཚོགས་གཙོ་བཅས་མི་སྣ་མང་པོ་ཕེབས་ཏེ་ང་རང་ལ་གསོལ་ཚིགས་ཀྱང་བཀྱག་བྱུང་།",
    "ཚེས་༥ ཉིན་ང་རང་རྒྱ་གར་དུ་ཕྱིར་ལོག་བྱ་རྒྱུའི་གྲ་སྒྲིག་བྱས་ཏེ་ཞོགས་པའི་ཆུ་ཚོད་ལྔ་པ་ཙམ་དུ་བོད་དོན་རྒྱབ་སྐྱོར་ཚོགས་པའི་ཚོགས་གཙོ་ཁྲིན་དང་ཨ་ཝབ་པོའི་ཅི།",
    "ཀྱི་མི་སྣ་གཉིས་ནས་ང་རང་འཆམ་འཆམ་དུ་འཁྲིད་བྱུང་།",
    "ལྷ་ལྕམ་མཆོག་ནས་དེང་སྐབས་གཟུགས་གཞིའི་གནས་སྟངས་ཇི་ཡོད་སྐོར་བཀའ་འདྲི་གནང་སྐབས་ཉེ་ཆར་གཟུགས་པོ་ཡག་པོ་འདུག་ཅེས་ཞུས་པ་ཡིན།",
    "དྲག་ཤུལ་གྱི་སྦྱོར་བ་རྩུབ་པར་སྟོན་པ་ཐམས་ཅད་ཁོ་རང་ལ་སྒྱུར་ཅིག་ཟློག་ཅིང་།",
    "སེམས་ཀྱི་དབྱིངས་སུ་བསྒོམས་པས་ལམ་གྱི་ཕུགས་ན་འདུག་པ་དེ་ཡིན་གྱིས་།",
    "ཀྱང་རང་ངོ་མ་ཤེསཔལྷན་ཅིག་སྐྱེས་པའི་མ་རིག་པ་དང་།",
    "ཞེས་དང་རང་ཤར་ལས།",
    "དེ་ཡང་རང་བྱུང་ངང་འདིར་ལྷུན་གྲུབ་པས།",
    "འདི་ལ་ངེས་པར་འདུག་པའི་རྣལ་འབྱོར་པས།",
    "འཁོར་འདས་རིག་པར་འདུག།",
    "ཅིར་སྣང་རང་བྱུང་ཡེ་ཤེས་ཀྱི་རོལ་པ་མཐོངབམེལད་ངུ་བཞིནགྱིགཟུགས་བརྙན་ཤར་བ་ལྟར་རྟོགས་པས།",
    "ཉལ་དང་འདུག་པ་སྒྲུབ་པའོ།",
    "ལུས་ཀྱི་འདུག་སྟངས་གཞིར་བྱསནས།",
    "འདུག་པ་དང་།",
    "གཉིད་ཀྱང་རང་བྱུང་གདོད་མའི་ཀློང་ཆེནཏེ།",
    "རྟོག་པ་ཆུང་ཞིང་རང་བཞིན་དལ།",
    "བུ་ཆུང་རངང་ལ་ན་བློ་བདེ་བའི་སྣང་བའམ།",
    "བསམ་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིསརྣམ་པར་དག་ནས་དགོངས་པ་རྣམས་ཅིག་ཆར་དང་།",
