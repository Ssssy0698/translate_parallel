    "བདུད་འཇོམས་ཐུ་ལུ་ཨོག་ཚོམ་ཅན་དེ་ངར་ཆེན་གྱིས་དཀྱིལ་སྒར་ཐོག་ཏུ་ཐེ་ཚོམ་མེད་པར་རྒྱ་སྟག་ནགས་ནས་མཆོངས་པ་ལྟར་ཤོར།",
    "གེ་སར་རྒྱལ་པོའི་གནང་བའི་བསྲུང་འཁོར་འདི།",
    "དེ་ནས་ཁོང་གཉིས་གཡག་རྒོད་ར་འཛིང་རྒྱག་པ་ལྟར་གྲི་འཐབ་ཇ་ཡུན་གཉིས་ཙམ་རིང་གྲི་འཐབ་བྱས་ཀྱང་དཔའ་ཁ་འདྲ་མཉམ་ཚེ།",
    "ད་དཔའ་རྒོད་ཁྲབ་ཆེན་སྦར་འཛིང་ཞིག་མ་བྱས་ན་བུ་མིན་བསམ་སྟེ་རལ་གྲི་ཤུབས་ལ་བཅུག་ནས་དཔུང་པ་གཡས་འཕུར་གཡོན་འཕུར་བྱས་ནས།",
    "ཡ་མེད་གཡུ་འབྲུག་ཐོག་རྒོད་དེ་མཆོངས་ནས་སྤྱང་དར་མས་ལུག་ཁྱུ་དཀྲུགས་པ་ལྟར་ཁྲག་དམར་གྱི་ཡུལ་ཆུ་བབས་ལེ་བྱས།",
    "སྲོག་བདག་ཁུ་ལེ་ལག་དགུ་མཁྱེན།",
    "དེ་ནས་ཁོང་གཉིས་གྲི་འཛིང་བྱས་སྐབས།",
    "ལུས་འབུལ་དཔའ་རྟུལ་དཔུང་ལ་བྱས།",
    "ལས་དཀར་ནག་རྒྱུ་འབྲས་དབྱེར་འགྱེད་བྱས།",
    "མགོ་ལུས་ཕྱེད་གཤགས་མ་བཏང་ན།",
    "དེ་དུས་གླིང་དམག་ཡོངས་ཀྱི་ཀི་བསྭོ་ལྷ་རྒྱལ་གྱི་སྒྲ་གནམ་ས་འདར་བ་ཙམ་བརྒྱབ་ནས་དཔའ་རྟགས་གཡུལ་ལས་རྒྱལ་བའི་མགོ་འཕྲུ་གོང་ལེན་བྱས་ནས་བསྡད།",
    "ནུབ་ག་ཞའི་ཡུལ་གྱི་ལྷ་སྲུང་རྣམས།",
    "ནུབ་གླིང་གཡུལ་འཁྲུག་བྱས་པའི་དུས།",
    "གནང་ཟླའི་ཚེས་པ་བཅུ་དགུ་ལ།",
    "ཆད་ལུས་མེད་པར་ཡར་ཞུ་ཕུལ།",
    "ཁྱེད་འགྲན་མེད་རྒྱལ་པོའི་སྐུ་མདུན་ལ།",
    "ངག་འཆལ་པ་བྱུང་ན་བཟོད་པར་གསོལ།",
    "ནུབ་སོག་གཡུལ་འགྱེད་དྲག་པོ་བྱས།",
    "ངག་འཆལ་པ་བྱུང་ན་བཟོད་པར་གསོལ།",
    "ནུབ་གླིང་གཡུལ་འཁྲུགས་བྱས་པའི་དུས།",
    "ཉི་མ་དམར་ཐག་ཆོད་པ་ལྟར་བྱེད་དགོས་གསུངས།",
    "དཔེ་བཞག་ན་འདྲ་མ་ཨེ་འདྲ་གསུངས།",
    "དགྲ་ལ་ཤི་འཐབ་སྤྱང་འཐབ་བྱས།",
    "དོན་ཅི་བསམ་ལྷུན་གྱི་འགྲུབ་པར་ཤོག།",
    "མ་རྗེ་བཙུན་སྒྲོལ་མ་དཀར་སྔོན་མཁྱེན།",
    "དོན་མ་འཆུག་འདིར་བཞུགས་ཐུགས་ལ་ཞོག།",
    "གླིང་དཔའ་རྟུལ་སྔོན་ནས་ཁས་ལེན་བྱས།",
    "དཔའ་ཚོད་འཛིན་མེད་པར་ཡང་སྤྱང་དར་མས་ལུག་ཁྱུ་གཏོར་གཏོར་ནུབ་དམག་མང་པོ་གྲི་ལ་དྲངས་སྐབས།",
    "ལག་མགོ་སུ་ལུ་འཕུར་འཕུར་བྱས་ཏེ་འདོ་བ་བྱ་ནག་འཕུར་ཤེས་ཀྱི་གོང་ནས་མི་འཇིགས་པའི་ཆས་དང་བཅས་གླུ་འདི་བླངས་སོ།",
    "རི་རབ་ཆབ་རྡེལ་འཕེན་འཕེན་བྱས།",
    "ལྷ་སྲས་དགྲ་ལྷ་རྩེ་རྒྱལ་གྱི་གསེར་རྟ་མིག་མ་ལ་སུམ་ཅུ་དང་།",
    "འདིར་བཞུགས་དགའ་བོ་གཞོན་ནུ་དང་།",
    "དེ་འདྲ་འཐབ་འཁྲུགས་བྱས་ན་ཡང་།",
    "འདིར་བཞུགས་རྣམས་ཀྱི་ཡིད་ལ་ཞོག།",
    "ནུ་བོ་དང་བཀའ་བློན་དམག་དཔོན་ཀུན་གྱི་བདེན་པར་གོ་ནས་དེ་ཡིན་ཟེར་བའི་ཁ་གསལ།",
    "བུ་ཁྱེད་ཀྱི་མ་མཁྱེན་ཅི་ཡོད་དེ།",
    "གྲོགས་ནེ་ནེ་ལུང་བསྟན་ཁས་ལེན་བྱས།",
    "མུ་སྟེགས་བོན་གྱི་ལྷ་སྲུང་དང་།",
    "རི་བོང་གཉོམ་རྡུང་བྱས་བྱས་དེ།",
    "བུ་དཔའ་བོའི་རོ་གོ་ཆོད་ལེ་ཡིན་ཟེར་ཏེ་བསྡད་པ་དང་།",
    "སོགས་ཀྱི་དཔའ་ང་འགྲོ་ཁོ་འགྲོ་ཟེར་བའི་དཔའ་སྐད་གཡུ་འབྲུག་གྲག་གྲག་བྱས་པའི་དུས་སུ།",
    "མགོ་ལུས་ཕྱེད་གཤགས་མ་བཏང་ན།",
    "ལྷ་སྲས་དགྲ་ལྷ་རྩེ་རྒྱལ་ཁོང་།",
    "སྐྱེས་པའི་བུ་རྟ་དམར་བསད་བྱས།",
    "མགོ་ལུས་ཕྱེད་གཤགས་མ་བཏང་ན།",
    "ལྷ་སྲས་དགྲ་ལྷའི་གདོང་ལེན་ལ།",
    "ཁོས་རལ་གྲི་ཕྲག་ལ་གཟར་ཏེ་ཐེ་ཚོམ་སྤུ་ཙམ་མེད་པར་དཀྱིལ་རུ་སྒར་ལ་ཤོར་སྐབས།",
    "ཁོས་རལ་གྲི་ཀླད་སྐོར་བྱས་ཏེ་ཐག་པ་དུམ་མེར་བཅད་དེ་ཤོར།",
    "ནུབ་ག་ཞའི་ཡུལ་གྱི་ལྷ་སྲུང་རྣམས།",
    "རྒྱལ་པོའི་བཀའ་བཀོད་གནང་རོགས་ཞུས།",
    "ད་སྡུག་སྡུག་བྱས་ཀྱང་ཕན་པ་མེད།",
    "བར་རྡོའི་འཕྲང་ནས་སྒུག་བསྡད་ཡོད།",
    "ང་འདྲ་ང་ངོ་ལོས་ཀྱང་མཁྱེན།",
    "ཤི་བདུད་སྟག་རྒོད་ཤི་འཐབ་བྱས།",
    "ས་དེ་ལ་བསྡད་ན་ཕན་ཐོགས་མེད།",
    "བློན་འབུམ་ཐུབ་དེ་འོ་ལགས་སོ་ཞུས་ཏེ་དེ་མ་ཐག་ལེའུ་སོ་གསུམ་པ།",
    "བཀའ་བློན་དང་དམག་དཔོན་ཡོངས་ལ་རྒྱལ་པོའི་བཀའ་གསུངས་ལྟར་ཡར་ཞུས་ཕུལ་བ་དང་།",
    "ང་འདྲ་ང་ངོ་ལོས་ཀྱང་མཁྱེན།",
    "མིང་ཡང་མེད་པར་ཚར་ཆོད་ཅིག།",
    "ཅེས་གསུངས་ནས་ནམ་མཁའ་ནས་འཇའ་ཡལ་བ་ལྟར་མི་སྣང་བར་གྱུར་ཏོ།",
    "སྨྱུག་ཁ་བསྟན་པའི་ལྷ་སྲུང་རྣམས།",
    "ཁ་ཕྱིར་བལྟས་མེད་པར་ཕྱི་གླིང་བྲོས།",
    "ཁྱེད་འདིར་བཞུགས་ཡིད་ལ་དེ་ལྟར་ཞོག།",
    "ཨ་ཁ་ཁ་བསམ་ནས་ཞེ་འགྱོད་རི་བོ་ཙམ་ཞིག་ལངས་ནས་བསྡད།",
    "བཀའ་བློན་དམག་དཔོན་རྣམས་ཀྱི་དགྲ་ལན་སྤྲོད་ལུགས་ཀྱི་གཏམ་གླེང་གྲོས་གཞི་བྱས་པའི་མཐར།",
    "འདིར་བཞུགས་ཐུགས་ལ་དེ་ལྟར་ཞོག།",
    "ལྷ་སྲུང་བྱེ་བ་ས་ཡ་རྣམས།",
    "སྟེང་ཕྱོགས་དག་པ་ལྷ་ཡི་ཡུལ་ནས་རྒྱལ་བ་སྲས་བཅས་ཐམས་ཅད་ཀྱི་ངོ་བོར་གཅིག་ཏུ་བསྡུས་པའི་དགོངས་པར།",
    "གཏིང་མཐའ་གསལ་བའི་རྣམ་མཁྱེན་གྱིས།",
    "འོད་དཔག་མེད་ཀྱི་སྐུ་མདུན་དུ།",
    "ནས་ཡར་ཙམ་ཕེབས་དུས་ཆུ་མགོ་ཙག་གེ་ཙིག་གེ།",
    "རྒྱལ་བློན་བཞི་ཡི་ཅི་ཡིན་བསམ་ནས་ཡར་བལྟ་མར་བལྟ་བྱས་དུས།",
    "སྦྲུལ་གྱི་ཤུན་སྤགས་ནམ་ཕུག་མཁོ་ཡོང་ཟེར་ཏེ་པགས་པ་བཤུས་ཏེ་ཉར་ཚག་བྱས།",
    "ཁ་ཆེ་དང་རྦེ་ར་གཉིས་ཀྱི་ལས་དམག་སྤྱང་དར་མས་ལུག་ཁྱུ་དཀྲུགས་པ་ལྟར་བྱས་སྐབས།",
    "ཤ་ཕ་ལག་དམར་ཡིན་པར་གྲགས།",
    "དེ་ནས་རྦེ་སྲས་སྟོབས་ཆེན་གྱིས་རལ་གྲི་ཤུབས་ལ་བཅུག་ནས་ལག་གཡས་ཀྱིས་སྟོབས་བདུད་ཁྲབ་ཀྱི་ཐོང་རྩ་ནས་བཟུང་སྟེ་གཡོན་པས་ཁྲབ་ཀྱི་རྒྱབ་དར་ནས་དམ་བཟུང་བྱས་ཏེ་རྩལ་ཆེན་སྦར་འཛིང་ཡུན་རིང་བྱས་ཀྱང་དཔའ་ཁ་འདྲ་མཉམ་བྱུང་།",
    "མི་གཙང་དྲི་མའི་འདམ་རྫབ་ཁྲོད།",
    "ཁམས་གསུམ་བདེ་ལ་འགོད་པར་ཤོག།",
    "གླིང་དཀར་བསམ་དོན་འགྲུབ་པར་ཤོག།",
    "ག་གླིང་གཡུལ་འགྱེད་དྲག་པོ་བྱས།",
    "འདིར་བཞུགས་ཡིད་ལ་དེ་ལྟར་ཞོག།",
    "ཁྱེད་འདིར་བཞུགས་རྣམས་ཀྱི་ཡིད་ལ་ཞོག།",
    "དེ་དུས་ཚ་ཞང་འདན་མ་བྱང་ཁྲ་དེ་རལ་གྲི་ལྗང་བ་ཡུ་དམར་ནམ་མཁའ་ལ་འཕྱར་ཏེ་ཁོང་གཉིས་གྲི་འཛིང་ཡུན་རིང་བྱས་ཀྱང་དཔའ་ཁ་འདྲ་མཉམ་བྱུང་།",
    "ནས་ཕྱིར་ནུད་བྱས།",
    "ཤ་ལན་མ་འཕྲོད་ལུས་བསྡད་ཡོད།",
    "འབྲལ་མེད་སྤྱི་བོར་གཙུགས་ཏུ་བཞུགས།",
    "དེ་ནས་ནུབ་དམག་ཚོ་འཕར་བས་ར་ཁྱུ་དཀྲུགས་པ་བཞིན་བྱས་སྐབས།",
    "བདེན་ཨེ་བསམ་གཡུ་འབྲུག་ཐོག་རྒོད་ལགས།",
    "ཐང་སྤང་དཀར་འགྲིམ་དང་ཁྱད་པར་མེད།",
    "དེ་དུས་བདུད་འཇོམས་ཐུ་ལུ་ཨོག་ཚོམ་ཅན་དེ་ཞེ་རྒོད་གཏིང་ནས་འཁྲུགས་ཏེ་གླུ་ལེན་པའི་དལ་ཁོམ་མ་བྱུང་སྟེ་ཁོང་གཉིས་འབྲོང་རྒོད་ར་འཛིང་རྒྱབ་པ་ལྟར་གྲི་འཐབ་ཡུན་རིང་བྱས་ཀྱང་ཕམ་རྒྱལ་གྱི་དབྱེར་བ་མ་ཕྱེར་པའི་དུས་སུ་ཉི་མ་དམར་ཐག་ལ་ལ་ནས་བརྒལ་ཏེ་གྲིབ་སོ་ནག་པོ་ཆུ་ལ་ཕོག་སྐབས།",
    "ཁྱད་པར་སྟོབས་བདུད་རྒྱལ་པོ་དེ་ཤིན་ཏུ་ཁྲོས་པའི་སྒོ་ནས་གླུ་འདི་བླངས་སོ།",
    "འདིར་བཞུགས་ཐུགས་ལ་དེ་ལྟར་ཞོག།",
    "སྡང་དགྲ་ཆམ་ལ་ཕབ་པར་ཤོག།"
  ]
}