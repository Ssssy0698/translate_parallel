    "ལྷན་ཅིག་བྱེད་པ་ཐ་དད་ཀྱང་ཅིས་ན་ཐ་མི་དད་པར་འགྱུར་བ་ཡིན།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་འབྲས་བུ་གཞན་སྐྱེད་པར་ནུས་པ་དང་འབྲེལ་པ་རྣམས་ནི་གཞན་པ་ལས་ཡིན་ཏེ།",
    "གང་ལས་ཁྱད་པར་མེད་པ་ཡིན།",
    "དེའི་རྒྱུ་སྔ་མ་ནི་སྐྱེད་པར་བྱེད་པ་ཉིད་འབྲས་བུ་ཕྱི་མའི་རྟེན་ཉིད་དེ་སྐྱེད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་དེ་ནི་ངོ་བོ་ཡིས་སྐྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་དག་མ་ངེས་པའི་གནས་སྐབས་སུ་འགྱུར་ཞེ་ན།",
    "སྐད་ཅིག་མ་འདི་ཟད་པ་ལ་གནོད་པ་བྱེད་པ་མེད་ལ་ཕན་འདོགས་པ་སྤོང་བར་བརྗོད་པ་ནི་ཁྱད་པར་དུ་བོགས་དབྱུང་དུ་མེད་པ་དག་ཅེས་བྱ་བ་སྨོས་ཏེ།",
    "འོན་ཏེ་ཁྱད་པར་བོགས་དབྱུང་དུ་མེད་པ་ཉིད་ཀྱིས་༤སྟེལྷན་ཅིག་བྱེད་པ་ཉིད་མེད་དོ་ཞེས་བསྟན་པའི་དོན་འདི་ཅི་ཞིག་ཡིན།",
    "ནུས་པ་འགོག་པ་མེད་དོ་ཞེས་བྱ་བའི་ནུས་པ་འགོག་པར་བྱེད་པའི་ལྷན་ཅིག་བྱེད་པར་བརྗོད་པ་མེད་དོ་ཞེ་ན།",
    "ནུས་པ་ལ་གེགས་བྱེད་པ་མེད་པས་ཕན་འདོགས་པ་ཉིད་དུ་བཏགས་པའི་ལྷན་ཅིག་བྱེད་པ་ནི་འགགས་པ་དེའི་༡ཕྱིར་ཁྱད་པར་ཕུལ་དུ་བྱུང་བ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འདི་དག་ནི་ཉེ་བར་བཏགས་པར་གྱུར་ན་ལྷན་ཅིག་བྱེད་པ་འདི་དག་ཕུལ་དུ་བྱུང་བ་བསྐྱེད་པས་དངོས་པོ་ཡིན་ནོ་ཞེ་ན།",
    "བརྗོད་པར་འདོད་པའི་འབྲས་བུའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཐའ་མའི་༦རྒྱུའི་ཚོགས་པའི་རྣམ་པ་དེ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་དཔེར་ན་ཐ་མའི་དོན་གཅིག་པའི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་སྔ་མའི་ཚོགས་པ་ལས་ཕྱི་མ་ཕྱི་མའི་སྐད་ཅིག་མ་ཁྱད་པར་ཅན་ཐ་དད་པར་ངེས་ཏེ་ཐ་མ་ཉིད་དཔེར་བསྟན་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་དུ་དོན་གཅིག་བྱེད་པའི་འབྲས་བུ་འཕེལ་པ་དང་འགྲིབ་པའི་རྒྱུ་ནི་ལྷན་ཅིག་བྱེད་པའི་རྒྱུའི་ཚོགས་པ་ཉིད་དུ་ཁྱད་པར་དུ་སྐྱེད་པ་ཡིན་ནོ་ཞེས་བྱའོ།",
    "འདི་དག་དོན་གཅིག་བྱེད་པ་ཡང་དེ་ལ་ལྷན་ཅིག་བྱེད་པ་ཡོད་ན་ཁྱད་པར་དུ་སྐྱེད་པ་མཚན་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "ཐ་མའི་བྱེ་བྲག་ཏུ་བྱེད་པར་མི་ནུས་པ་ཉིད་ན་ལྷན་ཅིག་བྱེད་པས་ཀྱང་ཁྱད་པར་དུ་བྱེད་པ་མ་ཡིན་ནོ།",
    "གང་ལས་ཁྱད་པར་དུ་བྱེད་པར་མི་ནུས་ཤེ་ན།",
    "ངོ་བོ་ཉིད་གཅིག་ལ་ཆ་ཤས་དབྱེར་མེད་པ་དེ་ལ་འདི་ཁྱད་པར་དུ་མི་བྱེད་པ་ནི་ཆར་མི་བྱེད་པའོ།",
    "གལ་ཏེ་དབྱེར་མེད་པ་ལ་ཁྱད་པར་ཡོད་ན་ཅིའི་ཕྱིར་མི་བྱེད་ཅེ་ན།",
    "ཆ་མེད་པ་ག་ལ་ཡིན་ངོ་བོ་ཉིད་གཞན་རྣམ་པར་འཇོག་པ་ན་བདག་ཉིད་ལས་གཞན་པའི་ཁྱད་པར་ཡོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དངོས་སུ་ཁྱད་པར་དུ་སྐྱེད་པའི་ཕྱིར་དོན་གཅིག་བྱེད་པ་ཉིད་ལྷན་ཅིག་ལྐུབྱེད་པ་ཡིན་ནོ།",
    "འོ་ན་ནི་ལྷན་ཅིག་བྱེད་པ་རྣམས་ཁྱད་པར་དུ་སྐྱེད་པ་མི་བདེན་ན་འབྲས་བུ་སྐྱེད་པའི་ནུས་པ་དེ་དག་མི་རིགས་སོ་ཞེ་ན།",
    "རྣམ་པ་དེ་ལྟ་བུ་རྣམས་ལ་བྱ་བ་གཅིག་པ་ཁོ་ནའི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཡིན་གྱི་ཁྱད་པར་དུ་སྐྱེད་པའི་མཚན་ཉིད་མ་ཡིན་ཏེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ནུས་པའི་དངོས་པོ་དང་ཕན་ཚུན་འགལ་བས་ནུས་པ་ལས་སྐྱེད་པར་ཁས་ལེན་པར་རིགས་ནཔ་མ་ཡིན་ནོ་སྙམ་དུ་གཞན་དག་སེམས་ནས།",
    "དོན་གཅིག་བྱེད་པར་ངེས་པའི་སྐད་ཅིག་མ་ནི་མི་རིགས་ཏེ།",
    "འདི་ལྟ་བུའི་ཞེངོ་བོ་མ་ཡིན་པ་ཞེས་མཐོང་བ་དང་མ་མཐོང་བ་དག་ལས་རྣམ་པར་འབྱེད་པའི་ཕྱིར་རོ།",
    "དེས་ན་འབའ་ཞིག་ཁོ་ན་ཞེས་བྱ་བ་སྨོས་ཏེ་གཅིག་ཀྱང་སྐྱེད་པར་བྱེད་པ་སྲིད་པས་དུ་མ་ཉི་ཚེ་ནི་མ་ཡིན་ནོ།",
    "གང་ཅུང་ཟད་ཅིག་ཞིང་དང་ས་བོན་ལ་སོགས་མྱུ་གུ་ལ་སོགས་པ་འབྲས་བུ་འགའ་ཞིག་དེས་སྐྱེད་པར་ནུས་ཀྱི།",
    "རྟེན་དང་རྒྱུ་དང་རྐྱེན་གྱི་ཁྱད་པར་ལ་དངོས་སུ་བྱེད་པའི་རྐྱེན་ལས་ཐ་དད་པའི་རྣམ་པར་ཤེས་པ་དེ་སྐྱེད་པར་ནུས་པའི་རྒྱུ་ནི་དེ་ཡོད་ན་ཡོད་པ་ཉིད་དུ་མཐོང་བ་ཉིད་དོ།",
    "བར་དུ་ཆོད་པ་སྤང་བའི་རྒྱུ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་ནུས་པའོ།",
    "ཐམས་ཅད་ལ་ཞེས་བྱ་བ་བརྗོད་པས་སྐད་ཅིག་མ་མ་ཡིན་པ་རྣམས་ལ་སོ་སོར་ངེས་པར་མ་གྱུར་ཅིག་སྙམ་ན།",
    "གཅིག་པུ་སྨོས་པ་ནི་སྐད་ཅིག་མ་གཅིག་ཡོད་པའི་ཕྱིར་བརྟན་པར་འཛིན་ཏོ།",
    "དེའི་ཕྱིར་བསྟན་པའི་དོན་༤ནི་གལ་ཏེ་འབྲས་བུ་སྐྱེད་པར་ནུས་པའི་རང་བཞིན་ཡིན་པ་དེ་བས་ན་མི་བྱེད་པར་མི་འཐད་དེ།",
    "ཐམས་ཅད་དུ་བྱེད་པར་འགྱུར་རོ།",
    "ནུས་ན་ཅིའི་ཕྱིར་མི་བྱེད་ནུས་ན་མི་བྱེད་པ་ནི་ལྷན་ཅིག་པའི་གནས་སྐབས་ཀྱིས་སྦྱོར་རོ་ཞེས་བྱ་བ་ལྷན་ཅིག་པ་ཁོ་ན་བྱེད་པར་འདོད་ཀྱི་འབའ་ཞིག་པ་ནུས་པ་མེད་པའི་ངོ་བོ་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཇི་ལྟར་ནུས་པར་བརྟག་པར་བྱ།",
    "འདིར་གང་ནུས་པའི་ངོ་བོས་གདོན་མི་ཟ་བར་འབྲས་བུ་བྱེད་པར་ངེས་པ་མ་ཡིན་ཏེ།",
    "སྐྱིད་དེ་བར་སྐྱེས་པ་ནི་བསྟན་བཅོས་ལ་མི་སྦྱོར་བའོ་། མི་སྦྱོར་བའི་བློ་ངན་པ་གང་ཡིན་པ་དེ་ནི་བྱས་ཀྱང་དངོས་པོ་བརྗེད་པའི་ངང་ཚུལ་ཅན་ཡང་བྱེད་པའོ།",
    "བྱས་པ་ནི་རབ་ཏུ་བརྩམས་པའོ།",
    "འདི་ཉིད་སྐད་ཅིག་མ་མེད་པའི་ནུས་པའི་ངོ་བོ་ཉིད་ལ་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཀྱིས་འབྲས་བུ་གཅིག་བྱེད་པའི་ངོ་བོ་འགལ་བས་འགའ་ཞིག་བྱེད་པར་འཐད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་མཇུག་བསྡུ་བ་ནི་དེ་ལྟ་བས་ན་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ངོ་བོ་གཅིག་པའི་ནུས་པ་ཉིད་སྔར་མེད་པས་སྐྱེད་པར་མི་ནུས་ཞེས་པ་མི་རིགས་ཏེ།",
    "གལ་ཏེ་ནུས་པ་དང་ལྡན་པ་སྐྱེད་པ་དང་མི་སྐྱེད་པ་ངོ་བོ་ཉིད་གཅིག་པར་རྟོགས་པ་ཁོ་ན་ཇི་ལྟར་སྤོང་བར་ནུས་པ་ཡིན་ནོ་ཞེ་ན།",
    "སྐད་ཅིག་མ་ཉིད་དོན་གཅིག་བྱེད་པར་ངེས་པའི་མཚན་ཉིད་ལ་ལྷན་ཅིག་བྱེད་པ་ཉིད་འདོད་པར་ཁས་བླངས་སོ།",
    "དེ་ཉིད་བསྟན་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་སྔོན་ཡང་བྱེད་པར་འགྱུར་བ་དེས་ན་དོན་གཅིག་བྱེད་པར་སོ་སོར་ངེས་པའི་དངོས་པོར་ག་ལ་འགྱུར།",
    "སྐད་ཅིག་མ་མེད་པར་ཁས་ལེན་པ་ལ་དོན་གཅིག་བྱེད་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཁོ་བོ་ཅག་རིགས་པ་ལ་རྗེས་སུ་ཆགས་པ་རིགས་པར་བརྗོད་པ་ལ་ཅིས་ན་རྗོབཏང་སྙོམས་སུ་བྱེད་པ་འདིར་ཡང་ཁྱེད་ཀྱིས་ཐམས་ཅད་ཀྱི་ཚེ་རིགས་པ་བརྗོད་པ་སྤངས་པ་ཡང་རས་འགའ་ཞིག་རིགས་པ་དང་ལྡན་པར་སྨྲ་བ་ལ་དགའ་བ་སྐྱེ་སྟེ།",
    "གལ་ཏེ་དེའི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་མི་བྱེད་པས་ཐ་དད་པ་ཡིན་ཏེ།",
    "འབྲས་དང་ནས་ཀྱི་ས་བོན་བཞིན་དུ་ཇི་ལྟར་དངོས་པོ་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "འོ་ན་ནི་བདག་ཉིད་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་མི་བྱེད་པའི་ངོ་བོ་སྤངས་པའི་ཕྱིར་རྐྱེན་གཞན་པའི་ངོ་བོ་ལ་ལྟོས་པའི་ཕྱིར་སྐྱེད་པར་བྱེད་པ་དང་།",
    "དེའི་ཕྱིར་ཕན་མི་འདོགས་པའི་དངོས་པོ་ལ་འབྲས་བུ་ལྟོས་དུཔར་མི་འགྱུར་ཏེ།"
  ]
}