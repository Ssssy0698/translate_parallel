    "ཁྱེད་ཅིག་ནས་དེ་ལུགས་མཛོད་ལ་མཁའ་འགྲོ་ཁོ་རང་གནས་གང་དུ་བྱོན་དགོངས་པ་དེ་ལྟར་གྱི་མཐུན་རྐྱེན་བྱེད་པ་མ་༢༧༡",
    "རྒྱལ་སྲས་སང་ལ་དེ་གཉིས་ཀྱི་ཁ་ལ་མ་ཉན་པར་ཁྱེད་རང་ཡབ་ཡུམ་གྲོས་མཐུན་བྱེད་པ་གལ་ཆེ་གསུངས།",
    "བདག་མ་བུ་གཉིས་དང་ཐུབ་བསྟན་བཟང་པོ་བཅས་རྗེས་ནས་འདུག་པས།",
    "ངེད་མི་རྟ་གཉིས་པོ་རྗེས་སུ་འདུག་སྟེ།",
    "བཞིན་མཛེས་ཌཱཀྐི་ང་རང་།",
    "པདྨའི་དབྱིབས་ཅན་ལ་སོགས་པས་གང་འདུག་པས།",
    "འདི་ནི་ཡ་མཚན་ཤིན་ཏུ་ཆེ་བ་ཞིག་གདའ་བས་འུ་ཅག་རྣམས་ཀྱིས་དངོས་གྲུབ་ཞིག་ལོན་པ་འདྲ་ཟེར།",
    "ང་རང་རྐང་བ་ངན་པས་སྐོར་མི་ཐུབ་པ་འདྲ་ན་གནས་འདི་ཀ་ནས་ཁྱེད་ཅག་སྒུག་འདུག་སྨྲས་ཚོ།",
    "ད་ང་རང་དང་གནས་འདི་ལ་ཕྱག་ཕུལ་དང་།",
    "ད་ལྟ་འདིར་དེའི་ཚེ་ང་རང་སྔོན་ལ་ཁྱིམ་དུ་འགྲོ་དང་།",
    "དཀའ་བར་འདུག་པས།",
    "ང་རང་ལ་བཟང་ངན་གཉིས་ཀ་མི་ཟེར་ཀྱང་སེམས་བབ་མེད་པའི་རྣམ་འགྱུར་མངོན་ཚེ།",
    "ལམ་ང་རང་ལ་ཆ་ཞིབ་ཡོད་ཟེར།",
    "ཕུག་པའི་ནང་དུ་བྱ་རྒོད་སོ་མ་གཏོགས་ཟུངས་ས་ཚུགས་པ་མི་འདུག་པས།",
    "ང་རང་ནི་བློ་གྲོས་ཀྱི་གྲལ་ན་མེད་ཟེར་བས།",
    "དེའི་ཉེ་ས་དེ་ཀར་མཚོ་ཆེན་པོ་འཇིགས་སུ་རུང་པ་ཞིག་འདུག་པས།",
    "ང་རང་ཁོ་ཡི་གཟུགས་ལ་འཇིགས་ནས་མཚོ་ནང་དུ་འགྲོ་མ་ཕོད།",
    "ང་རང་ལ་བསྟོད་པ་བྱས་པ་སོགས་གཏེར་གཞུང་དུ་གསལ་བའོ།",
    "ཟངས་སྒྲོམ་ཡང་གཏེར་དུ་སྦས་ནས་གཏེར་སྲུང་རང་ལ་གཉེར་དུ་གཏད་དོ།",
    "ང་རང་གཟུགས་བྱད་ངན་ཅིང་༢༩",
    "ད་ལྟ་ཚོགས་ཀྱི་དྲང་བའི་སྐབས་ང་རང་ལ་ཚོགས་སྐལ་འོང་མི་ཉན་སྨྲས་ནས།",
    "ཁོ་རང་ལ་ཚོགས་ཀྱི་ཡོ་བྱད་རྣམས་གཏད།",
    "ལུས་ཀྱི་མདངས་མ་ཉམས་ཤིང་མངལ་གྲིབ་དང་བྲལ་བ་དཀར་ལ་དམར་བའི་མདངས་ཆགས་པ་ཟིལ་བ་ཁྲོམ་མེར་འདུག་པས།",
    "དཔེར་ན་སྒྱུ་མ་བཙོས་པ་ལྟར་འགྲེངས་འདུག་པས་ཤི་བ་ཡིན་པ་ཐག་ཆོད་པར་བྱུང་ནས་རིམ་གྱིས་ཐུབ་བཟང་དང་།",
    "ནས་ཐུགས་ཆུང་མཛད་ཅིང་འགྱོད་པ་ཆེན་པོ་བྱེད་འདུག་པས།",
    "ང་རང་ལ་ཡོན་བདག་དད་ལྡན་རྣམས་ཀྱིས་ཟས་གོས་ཀྱི་རྟེན་དུ་སྦྱིན་པའི་རྒྱུ་རྫས་དང་།",
    "ཡོན་བདག་ང་རང་ལ་སེམས་དཀར་བ་རྣམས་ཀྱིས་མར་མེའི་རྟེན་དང་སེམས་གསོས་བྱེད།",
    "བུ་རོ་ཕྱིར་ལོན་ཐབས་གཏན་ནས་མེད་ཟེར་ཞིང་ཀུན་གྱིས་རྩོད་གཞི་དཔེ་རུ་བྱེད་འདུག་ཀྱང་།",
    "དེས་ངེད་ཅག་ལ་འདུག་སའི་ཀླུས་ལྷས་མལ་སོགས་ཀྱི་མཐུན་རྐྱེན་བསྒྲུབ་པ་དང་།",
    "ངེད་རྣམས་ཕར་ངོས་ཆུ་འགོ་ཞོག་འདུག་པ་དེ་ཀའི་ཐད་དུ་སྡོད་གྲབས་བྱས་ཏེ།",
    "མིན་ཀྱང་ཁོ་རང་ཡང་གཏེར་སྟོན་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "དེ་བས་ལྷ་པའི་ང་རང་ལ་རྩ་བའི་གྲོགས་ཁྱད་པར་བ་ཞིག་ཡོད་པས་དེའི་ཐུགས་བབས་མེད་ཚེ།",
    "ལུས་མ་ངེས་པ་དུ་མར་སྣག་ནས་ལྟོ་བ་མི་བདེ་བ་ལྟ་བུར་གནས་འདུག་སྐབས།",
    "ཁྱེད་རང་དང་ནི་འདུ་འབྲལ་ནམ་ཡང་ཡོད་ཆགས་ཡོད་པའི་ཆ་འཇོག་མིན་གསུངས་ཚེ།",
    "ཁྱེད་སྐུ་མ་བཞུགས་རྗེས་སོར་ང་རང་ཡང་མི་འདུག་ངེས་པ་ཡིན་ལགས།",
    "ང་རང་འཇིག་རྟེན་འདི་སྣང་དུ་འདུག་སྙམ་ཀྱང་།",
    "ཉི་མ་ལ་ཁ་འདུག་ཐག་ཐུང་ཟེར་༣༡༡",
    "མིན་ཀྱང་ང་རང་ལ་དགོས་པ་ཆེན་པོ་ཞིག་ཡོད་པས་ཅི་འགྱུར་མི་ཤེས་གསུངས།",
    "དེའི་རྗེས་འུ་ཅག་དཔོན་གཡོག་གྲོས་བྱེད་དང་ཆོག་དེ་མིན་སྔར་ཞུས་ལྟར་ཁྱེད་མ་བཞུགས་ཚེ་ང་རང་ཡང་འཆི་མ་ཐུབ་ཀྱང་ས་མཐའ་ཞིག་ལ་འགྲོ་བ་ལས་འོས་མེད་པ།",
    "བླ་བྲང་ནང་དུ་མི་འདུག་ངེས་པ་ཡིན་ཞུས་ཚེ།",
    "ང་རང་ལ་དགོས་པ་ཡོད་དོན་ནི་སྔ་སོར་ཁྱེད་གནས་ནང་དུ་ཐོག་མར་བྱོན་སྐབས།",
    "ཁྱད་པར་སྐྱེས་བུ་དམ་པའི་སྐུ་ཚེ་མཛད་ཕྲིན་སོགས་ལ་བར་ཆད་ཤིན་ཏུ་ཆེ་བར་འདུག་པས།",
    "མིན་ཀྱང་རང་ཡང་ཚེ་ཡི་འཕེན་པ་སོགས་ཀྱིས་ཅི་འགྱུར་མི་ཤེས།",
    "ཁོ་རང་སྐྱེ་བ་ངན་པ་རྒྱལ་པོའི་ཆོ་འཕྲུལ་ཡིན་ནམ།",
    "འབུལ་བ་སོགས་ང་རང་ནས་འཕྲོད་འོང་གསུངས་པ་དང་།",
    "ཁྱད་པར་ཡང་བདག་ལ་ད་ལོ་ཚེ་ལ་བར་ཆད་འདུག་པས།",
    "ང་རང་ཕྱིར་རང་ཁྱིམ་ལ་འགྲོ་གྲབས་བྱས་ཚེ།",
    "ཀྱང་འགྲོ་འདུག་མ་ཐུབ་ནས་རང་རང་སོ་སོའི་ཁྱིམ་ལ་ལོག་འདུག་སྐབས།",
    "ཁོང་རང་སྦས་པའི་རྣལ་འབྱོར་མ་འགྲན་བྲལ་ཞིག་ཡིན་པས།",
    "མཁའ་འགྲོ་ཁོ་རང་རིམས་ཀྱིས་ན་གྱིན་ཡོད་པས་འདི་ཀར་འོང་མི་ཐུབ།",
    "དེ་ནས་སྐུ་མདུན་ལ་ང་རང་གཅིག་པུ་ཡིན་པས།",
    "ཁ་ཕྱེས་ཏེ་སྒྲུབ་རྟེན་གྱི་ཕུར་བུ་གསུམ་འདུག་པས།",
    "ང་རང་སྔར་བསྐལ་བ་ཡོས་བུའི་ལོར་གཏེར་སྟོན་སང་ལ་སྦྱིན་རབ།",
    "ང་རང་ལོ་བཅུ་གསུམ་གྱི་དུས་ནས་མ་དང་མཁའ་འགྲོའི་ལུང་བསྟན་ཏེ།",
    "ང་རང་ཁྱེད་ཅག་ལ་ཤིན་ཏུ་གནོད་འདུག་པས།",
    "མཐོ་དམན་ཀུན་ལ་སྦྱིན་ས་མ་ཐོན་པ་ལྟ་བུར་བྱེད་འདུག་པས།",
    "ངེད་ཀྱིས་རང་བྱ་མ་ཐོན་པའི་རྐྱེན་གྱིས་ད་ལན་ལྟ་བུ་ཞིག་ལ་ཡང་ཅི་དགོས་མི་ཤེས་པར་བྱས་འདུག་ཀྱང་བྱ་ཐབས་མེད།",
    "ད་ཁྱེད་སྐུ་མདུན་ལ་འདུག་དགོས་འདྲ་གསུངས་ན།",
    "ང་རང་ལ་མཁའ་འགྲོའི་བརྡ་འཕྲུལ་དོན་འབྱེད་དཀའ་བ་ཞིག་ཡོད་པ་དེ་ཀའི་དོན་རྗེ་དེ་ཉིད་ཀྱིས་དགོངས་ཏེ།",
    "དེ་མིན་སུས་ཕན་པར་དཀའ་འདུག་གསུངས་པས་དེ་ལུགས་ཐུགས་ནས་མ་འདོར་བར་ཞུ་ཞུས་ཚེ།",
    "ཁོ་རང་སྐྱིལ་ཀྲུང་བཅས་ནས་ཀཱི་ལི་ཀཱི་ལ་ཡ་ཧཱུཾ་ཕཊ་ཞེས་ལན་གསུམ་བརྗོད་པ་དང་།",
    "ཁོང་རང་ནོར་འཛིན་པའི་སྐྱེས་བུ་འབྱུང་།",
    "གནས་མི་རིང་རང་གནས་ཉེ་བའི་སར།",
    "ཉིན་མཚན་མེད་པར་སེམས་གཏིང་སྡུག་བསྔལ་ལས་མི་འདུག།",
    "དབྱར་རྔའི་སྒྲ་སྐད་ལྷང་ལྷང་རྒྱུན་མེད་དུ་སྒྲོག་དུས།",
    "རི་དེ་ཀའི་ངོས་ལ་ཆུ་འགོ་ཞིག་ཨེ་འདུག་སྨྲས།",
    "ཁོ་རང་རྣམས་ཀྱིས་གྲོས་བྱས་ཏེ།",
    "གྲོགས་ངན་གྱི་རྐྱེན་གྱིས་བསླངས་ནས་གངས་རི་ཐོད་དཀར་ལ་བྱོན་འདུན་ཡོད་འདུག་ཀྱང་།",
    "ང་རང་ལ་འགྱོད་པ་ཆེན་པོ་བྱེད་འདུག།",
    "ང་རང་མ་བུ་གཉིས་གུར་ནང་ལ་བསྡད་ཡོད་སྐབས།",
    "ང་རང་ལས་ངན་པ་ཡིན་པས།",
    "རྡོ་དང་ལྕགས་བཞིན་ཡིན་པས་སྟབས་གཟབ་དགོས་ཟེར་བ་དང་མཉམ་དུ་ང་རང་གཉིད་ལས་སད་དོ།",
    "འུ་ཅག་ད་ལན་ཡུལ་ཕྱོགས་འདི་ཀར་འདུག་མི་ཉན་པ་འདྲ།",
    "ཁྱད་པར་རྒྱལ་སྲས་ཁོ་རང་བཅས་པས་དགོངས་པ་དེ་ཁྱེད་གཉིས་ཀྱིས་གསལ་བ་ལྟར།",
    "ང་རང་མཐོང་ཚེ་ཐམས་ཅད་ཀྱིས་མཆི་མ་བྱུང་ནས།",
    "ཡང་ང་རང་རྗེའི་བཀའ་གནང་ལྟར་མཚམས་དམ་རྒྱ་ཞིག་ལ་བསྡད་ཡོད་སྐབས།",
    "ཁྱེད་འདི་རུ་འདུག་དོན་ཅི་ཡང་མེད།",
    "ས་འདིའི་བདག་པོ་ང་རང་ཡིན།",
    "ཁྱད་པར་གནས་གསུམ་དུ་རང་རང་དང་མཚམས་པའི་ལོངས་སྤྱོད།",
    "དེ་ནས་རང་ལོ་སོ་གཅིག་དུས་རྗེའི་སྐུ་ཚེའི་བར་ཆད་སེལ་བའི་ཕྱིར་དུ་མཚམས་ཞིག་ལ་བསྡད་ཡོད་སྐབས།",
    "རྫུ་འཕྲུལ་ལྡན་པའི་ཡིད་མཐུན་ང་རང་།",
    "མི་རིང་རང་གནས་ཉེ་བའི་ཕྱོགས་ནས།",
    "སྔར་ཁྱེད་ལ་ང་རང་འབུལ་ནས་བདག་པོ་ཁྱེད་ཡིན་ཞུས་པ་དང་།",
    "དེ་སྐབས་ལུགས་གཉིས་གང་ཐད་ནས་ང་རང་ཀུན་གྱིས་གཅེས་སྤྲས་བྱས་པ།",
    "དེ་ལ་རྐྱེན་བྱས་ཏེ་ང་རང་འདི་སྣང་ལ་མི་འདུག་སྙམ་ཡོད་ཚེ།",
    "སྔར་ང་རང་བསྭོ་ཐོག་གནས་ལ་འགྲོ་སྟབས་ལྡན་ན།",
    "ཡང་རྗེའི་ཞལ་ནས་ང་རང་ལ་ཞལ་གདམས་གསུངས་ཡོད་པ་འདི་དེའི་གནས་སྐབས་ལ་དགོངས་པ་ཡིན་ན།",
    "སྐུ་ལུས་སོགས་གང་ལ་བརྟག་དཔྱད་བྱས་ཀྱང་ཡིད་མི་ཆེས་པ་ཞིག་འདུག་པས།",
    "ཁྱད་པར་ང་རང་རྣམས་ཐུགས་ཀྱིས་དོར་ནས་འདིར་སྣང་ལ་མི་བཞུགས་དོན་ཅི་ལགས།",
    "ཐུགས་ངལ་ཆེན་པོ་མཛད་འདུག་པས།",
    "ང་རང་ཡང་ཡུན་རིང་མི་འགོར་བར་ཁྱེད་དང་མཉམ་དུ་འདུན་པ་གཏད་ངེས་པ་དང་།",
    "ང་རང་ཕྱི་དབུགས་ཆད་མ་རག་པར་ཡོད་ཀྱང་ཅུང་ཟད་ཞིག་དྲན་པ་རྙེད་པ་ལྟར་བྱུང་བས།",
    "ཁྱིམ་ཐམས་ཅད་མར་མེ་མང་པོས་གང་འདུག་བསོད་སྤྲུལ་སང་དང་།",
    "རྗེའི་བཀའ་བཞིན་ང་རང་མཚམས་དམ་རྒྱ་ཞིག་ལ་བསྡད་ཡོད་སྐབས།",
    "ཡང་མ་ཉམས་པར་འདུག་པས།",
    "ང་རང་ཨ་འཛོམ་སྒར་ལ་འོང་དགོས་པའི་བཀའ་ཤོག་ཐོན་བྱུང་བས།",
    "ང་རང་ཨ་འཛོམ་སྒར་ལ་མི་འགྲོ།",
    "གཅིག་ཐད་ནས་ང་རང་ལ་རྐང་བ་མེད་པ་དང་།",
    "གྲོགས་ཞིག་དང་མཉམ་དུ་འདུག་དགོས་སྙམ་པ་མེད་པས་ན།",
    "ང་རང་བློ་རྒྱ་ཆུང་བས་འགྲོ་ལན་མ་བདེ་བར་སྣང་།",
    "གཞན་སློབ་འབངས་གལ་ཆེན་ཐམས་ཅད་ཀྱིས་ང་རང་མར་འོང་དགོས་གསུངས་ནས།",
    "ཁྱེད་ཡབ་ཡུམ་གྱི་བདག་པོ་ང་རང་ལས་གཞན་སུ་མེད།",
    "དེའི་ཕྱིར་ན་ཁྱེད་རང་ཨ་འཛོམ་སྒར་ལ་གཏན་བཞུགས་བྱེད་པ་ལྟ་ཞོག་ཁྱེད་ཡབ་ཡུམ་གསུང་གྲོས་མཛད་པ་ཕན་ཆད་འགྱང་མི་ཉན་གསུངས།",
    "ང་རང་དབྱུག་པ་ཅན་ལ་ཅི་བྱུང་ཡང་ལྷུང་འབབ་མེད་པ་ཡིན་པས།",
    "ཁོང་ཐུགས་ཤིན་ཏུ་དགྱེས་ཏེ་ཆུ་ཆེ་བས་ཞག་ཁ་ཤས་འདི་ཀར་འདུག་དགོས་གསུངས།",
    "ད་ལན་ང་རང་མི་འདུག་ཕྱིས་ནས་འུ་ཅག་མཇལ་འོང་ཞུས་ཚེ།",
    "དེ་ཀ་ཐོན་བྱུང་ནས་ཁྱེད་ད་ནས་སྐུ་མདུན་ལ་བྱོན་གསུངས་འདུག་ཟེར།",
    "ཆེན་པོས་ང་རང་ལ་མཁོ་བའི་ཡོ་བྱད་ཕྱག་རིན་རྙེད་ཐང་ཆེ་བ་སྣ་ཚོགས་གནང་།",
    "དེའི་སྐབས་ང་རང་ལ་ལེགས་ཉེས་ཀྱི་འཁྲུལ་སྣང་ལུང་བསྟན་ཁ་ཤས་ཡོད་པ་རྗེའི་ཕྱག་ཏུ་ཕུལ་བས།",
    "དེ་ཐམས་ཅད་ཀྱི་འདོད་དོན་བྱེད་དཀའ་འདུག་གསུངས།",
    "ད་ལན་གྱི་ཚོགས་གྲལ་འདི་ལ་འཇིག་རྟེན་མཁའ་འགྲོ་མང་བར་འདུག་པས།",
    "ང་རང་ལ་ལུགས་གཉིས་གང་ཐད་ནས་ཉེས་པ་དུ་མ་ཡོད་ནས།",
    "རྗེ་ཁོ་རང་ནས་བདག་ལ་བཀའ་གནང་མ་ཐོབ་ནས་བྱ་ཐབས་བྲལ།",
    "ཡང་གཏེར་སྟོན་བླ་བྲང་ནས་མི་འདོད་པའི་རྐྱེན་དུ་མའི་སྣ་འདྲེན་བྱེད་འདུག་པས།",
    "ད་ནི་བྱ་བ་འདི་རྣམས་ལུང་བསྟན་དང་ཆ་མཚུངས་འདུག་པས་ན།",
    "ད་ལོ་ཅི་བྱུང་ཆ་ཆོད་དཀའ་བར་འདུག་ན།",
    "དེའི་ཕྱིར་ན་ཁྱེད་སྐུ་ཚེ་ཞབས་པད་བརྟན་འདུག་ན།",
    "ང་རང་ཁྱེད་ཀྱི་རིགས་སུ་སྐྱེ་སྲིད་བཟུང་ནས།",
    "རྗེའི་ཞལ་ནས་གཅེས་ཕྲུག་ཁྱེད་ཀྱིས་ང་རང་ཐུགས་ནས་དོར་ཏེ།",
    "ད་ནི་ང་རང་ན་སོ་ལོན་པ་དང་།",
    "འུ་ཅག་ཐུགས་སྣང་མཐུན་པ་སོགས་ཀྱིས་ཁྱེད་མེད་ཚེ་ཇ་ཡུན་གཅིག་ལའང་བདག་འདུག་ཐབས་བྲལ་བ་ཡིན་པས།",
    "ང་རང་ལ་ལྟ་ཚོད་མེད་པ་བྱུང་བ་ཁྱེད་ཀྱིས་མཁྱེན་བཞིན་དང་།",
    "ང་རང་གཅིག་པུར་ཤུལ་དུ་འདུག་ཐབས་མེད་པ་ལྟ་བུར་བྱུང་བས།",
    "ཁྱེད་མེད་ཕྱིན་ཆད་ང་རང་ལ་འདི་ཕྱི་གཉིས་ཀྱི་བློ་གཏད་ས་གཏན་ནས་མི་འདུག་པ་ལ་བསམ་ན།",
    "སྨྱོན་པ་འུར་ལང་བ་ལྟ་བུར་བྱ་སྤྱོད་ཐམས་ཅད་ཅི་བྱེད་ལྟོས་མེད་དུ་འདུག་ཞུས་ཚེ།",
    "ཁྱེད་དང་མ་བྲལ་ཚེ་ད་དུང་ལོ་སུམ་ཅུ་སོ་ཁ་ཤས་འདུག་རྒྱུའི་ལུང་བསྟན་ཡོད་གསུངས།",
    "ལོ་ལྔ་ཕན་ཆད་ཁོ་རང་གདན་སར་འཁོད་ཐབས་འོང་ན་བཟང་གསུངས་པ་ཡིན།",
    "སྤྲད་ལེན་གྱི་དུས་ཚོད་མྱུར་དུ་བསྒོས་པ་སོགས་བྱས་འདུག་པས།",
    "དེ་ནས་ང་རང་ནི་སྐྱབས་མེད་མགོན་མེད་ལོང་ང་ཐང་དཀྱིལ་དུ་ལུས་པ་ལྟ་བུའི་སྡུག་བསྔལ་ཆེན་པོས་ནོན་ཏེ་བྱ་ཐབས་དང་བྲལ་ཡོད་སྐབས།",
    "རུང་ཙམ་གྱི་ལུང་ཐོབ་པ་ཡིན་གསུངས་འདུག་པས།",
    "མིན་ཀྱང་ང་རང་ལོ་ཤས་ཙམ་ལ་འདུག་ན།",
    "བདེ་གཤེགས་རིགས་ལྔ་ཡབ་ཡུམ་ཀྱི་སྐུ་གསལ་སྟོང་འཛིན་མེད་ཆེན་པོར་ཡོད་པ་ཞིག་ལྷོ་ནུབ་ཀྱི་ཕྱོགས་ཀྱི་ནམ་མཁའ་ལ་སྤྱན་དྲངས་འདུག་པས།",
    "ཁོང་མཆེད་གྲོགས་རང་རང་གནས་སུ་ཕེབས།",
    "ལས་འདི་འདྲའི་བྱ་བ་མཐོང་ཙ་ན།",
    "བསོད་སྤྲུལ་སང་དང་ཐག་ཅུང་ཟད་ཉེ་ས་ན་འདུག་དགོས་སྨྲས་ཀྱང་།",
    "གནས་འདི་ཀར་ཡུན་རིང་པོར་འདུག་སྐལ་མེད་པ་འདྲ་སྙམ།",
    "ད་ལན་ཁོ་རང་ཕུ་ནུ་ཉེ་འབྲེལ་རྣམས་ཡོད་པས་དགའ་སྙམ་ན།",
    "ང་རང་ལ་ཁྲུས་བྱས།",
    "རྗེ་དེ་ཉིད་ཀྱིས་ཚོགས་དཔོན་མཛད་འདུག་པས།",
    "དེའི་མདུན་ཕྱོགས་སུ་ང་རང་སྡོད་ཟེར།",
    "ད་ལོ་ཁྱེད་ཀྱི་ཚེ་ལ་བར་ཆད་ཞིག་འདུག་པས།",
    "གནས་སྐབས་ང་རང་འདི་ཀར་འོང་ཡང་།",
    "ཡུལ་གཉན་པོར་བསྐུར་འདེབས་བྱེད་ཀྱིན་འདུག་པས།",
    "ཁྱེད་ནི་བྱོན་མི་ཉན་གསུངས་ནས་ཐུགས་ཆུང་བར་མཛད་འདུག་པས།",
    "ཡུལ་དེ་ཀའི་བདག་པོ་གཞི་བདག་དྲག་རྩལ་ཅན་ཞིག་འདུག་པས།",
    "དེ་ཀ་ང་རང་ལ་ཡིད་བཞིན་ནོར་བུས་མཐུན་རྐྱེན་མཛད་ནས་གནང་བ་ཡིན་ཞུས་པས།",
    "བྲག་བཙན་ཁོ་རང་དམ་ལ་གནས་པ་བྱུང་ངོ།",
    "ང་རང་གནས་སྐབས་ལོ་ཤས་ཙམ་ལ་གནས་འདི་ཀར་འོང་དགོས་ཡང་ཡང་ཟེར་བས།",
    "མཚོ་ཆུང་རྣམས་ལོན་ནས་གཏེར་བུམ་སྦ་བའི་སྐབས་ཆར་ཅུང་ཟད་འབབ་འདུག་པས།",
    "ཀླུ་རྣམས་ཀྱང་ཉམ་ཐག་གོས་རྒྱན་དང་བྲལ་བ་ཤ་སྟག་འདུག་པས།",
    "ང་རང་མནར་མེད་ཀྱི་གནས་སུ་འགྲོ་དགོས་པ་དང་།",
    "རྗེ་འབངས་རང་རང་རྣམས་ལ་སྨིན་གྲོལ་བསྩལ་ནས་བཀའ་ཡི་བསྡུ་བ་མཛད་ཅིང་།",
    "བེ་རོ་ཙ་ན་བཞུགས་པ་ཞུས་ཚེ།",
    "ང་རང་ཡུལ་འཇིགས་རྔམ་ཡིད་དུ་མི་འོང་བ་མཐོང་བ་ཙམ་གྱིས་ལུས་སེམས་སྡུག་བསྔལ་གྱིས་གདུང་ཞིང་འགྲོ་བ་རྣམས་ཀྱང་སྡུག་བསྔལ་ཁོ་ནས་མནར་བ་ཤ་སྟག་ཏུ་འདུག་པས།",
    "ཨམ་གཙིག་བསྡམ་ཞིང་རྐང་རྡེབ་བྱེད་ཅིང་ཧ་ཧེའི་སྐད་སྒྲ་འགྲུབ་སྒྲ་ལྟར་མི་བཟོད་པ་ལྟ་བུར་བྱེད་འདུག་པས།",
    "ཐོག་མར་ང་རང་ཡང་ཅུང་ཟད་ཞིག་སྐྲག་བྱུང་བས་འདི་སྐད་སྨྲས།",
    "ལ་ལའི་སྤུ་གྲི་སོགས་མཚོན་ཆ་སྣ་ཚོགས་ཆར་བབས་པ་ལྟ་བུར་འདུག་པས།",
    "ཁོ་རང་ལ་དམིགས་ནས་མཆོད་གསོལ་ཕྲན་བུ་ཞིག་བྱས་ཚེ།",
    "གཞན་ཡང་རང་གཏེར་དང་།",
    "རང་ལ་ནི་ཡོན་ཏན་སྤུ་རྩེ་ཙམ་ཡང་མི་འདུག་པས།",
    "ས་རྒོད་ཞིག་ལ་ནས་རྨོ་དགོས་ཟེར་ཞིང་དཀའ་བ་ཆེན་པོ་བྱེད་འདུག་པས།",
    "ངས་བྱེད་རྒྱུའི་བྱ་བ་གཉིས་ཀ་འདྲ་འདུག་ཨང་ཟེར།",
    "ཡུན་རིང་འདུག་ཐབས་བྱ་བ་དེ།",
    "ང་རང་དགའ་དྲགས་ནས་ཁོང་ལ་ཕྱག་ཕུལ་ཏེ་སྐུ་ཁམས་བཟང་ཞུས་པས།",
    "ང་རང་གཅིག་པུས་མི་ཚད།",
    "ང་རང་ལྟ་བར་འགྲོ་དགོས་ཞུས།",
    "ད་ལན་ཡང་ཡོས་ཟླའི་ཚེས་བཅུའི་ཉིན་མཁའ་འགྲོས་བསུ་བ་ཞིག་འདུག་པས།",
    "མཁའ་འགྲོ་པདྨ་མཚོ་སྐྱིད་ཀྱི་ཟབ་གཏེར་མཁའ་འགྲོ་གསང་བ་ཀུན་འདུས་ཀྱི་ཟབ་ཤོག་རྡོ་སྒྲོམ་ཆེ་བ་གཅིག་འདུག་པ་དེ་དངོས་སུ་སྤྲད་བྱུང་བ་ཡང་གཏེར་དུ་སྦས།",
    "གཞན་ཡང་རང་ལ་དད་འདུན་ཡོད་པའི་ཇོ་ནང་དང་།",
    "རི་འཕྱི་ཇི་བཞིན་གད་ཕུག་དག་རི་ངོགས་ལ་འདུག་ཐབས་ཨེ་འོང་བསམ་པ་མིན།",
    "ཁྱེད་གཏེར་སྟོན་ཡིན་པས་གྲོགས་པོའི་ཆེད་དུ་ངེད་གཉིས་འདུག་སྙམ་པ་ཡིན་ཟེར་བས།",
    "ཡུལ་འདིར་མ་འདུག་ཁྱེད་གཉིས་ངས་བསད་དགོས་ཀྱང་མཛད་འཛེམ་མི་ལྟ་སྨྲས་ཚེ།",
    "ང་རང་མི་རུས་ངན་པའི་རྐྱེན་གྱིས་ལུང་བསྟན་ཇི་བཞིན་པར་བསྒྲུབ་ཐབས་འོང་བ་མིན།",
    "གཅིག་ཐད་ནས་ང་རང་སྐྱེ་ལུས་དམན་པས།",
    "གྲོགས་དེའི་བཀའི་གནང་བ་མ་ཐོབ་པར་གཏེར་ལུང་དང་མཐུན་པར་ཡོད་ཀྱང་རང་བློ་ཐད་ཆོད་བྱས་ནས་གྲོགས་གཅིག་དང་འགྲོགས་པ་མི་དྲན།",
    "ཁྱེད་ཐབས་ཤེས་བར་ལ་བར་ཆད་ཅུང་ཟད་ཡོད་པར་འདུག་པས་གཟབ་དགོས་ཟེར་བ་དང་༤༧༤",
    "ཡུན་རིང་འདུག་གྲབས་མ་བྱེད།",
    "ཀྱང་རང་བློའི་རྗེས་སུ་འབྲང་ནས།",
    "ཁ་ཉན་མི་ཉན་བལྟ་དོན་མི་གདའ།",
    "ཡུལ་དེར་འཇིག་རྟེན་མཁའ་འགྲོ་དུ་མས་མགྲོན་འགྱེད་བྱེད་འདུག་པས།",
    "ངེད་ཀྱི་དཔོན་པོ་གླིང་རི་བསོད་རྒྱས་ཞེས་པ་དེ་ཁྱེད་ལ་ཤིན་ཏུ་དད་པ་ཆེ་འདུག་པས།",
