    "བདག་གི་ཚོགས་རྫོགས་པ་ལ་དམིགས་པ་དང་།",
    "ར་བ་ཞེས་བྱ་བ་ནི་གང་གིས་ཁང་པ་བསྐོར་བའོ།",
    "འོག་གི་མནར་མེད་པའི་བར་གྱི་སྒྲ་ཐོས་པས་སོ་ ཕྲ་བ་དང་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་མི་གསལ་བའོ།",
    "ཉོན་མོངས་པ་དང་བཅས་པ་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་དང་།",
    "གཏི་མུག་ལས་གཞན་པའི་ཉོན་མོངས་པ་རྣམས་དང་ལྡན་པའོ།",
    "ཉོན་མོངས་པ་མེད་པ་དང་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་ལ་སོགས་པ་ལས་གཞན་པའི་ཉོན་མོངས་པ་དང་བྲལ་བའོ།",
    "རྣམ་པར་གྲོལ་བ་དང་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བའོ།",
    "རྣམ་པར་མ་གྲོལ་བ་དང་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་ལྡན་པའོ།",
    "སྐྱོན་ཅན་དང་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་དང་ལྡན་པའོ།",
    "ཆེ་གེ་མོ་ཞིག་ན་ཞེས་བྱ་བ་ནི་ཡུལ་ལོ།",
    "རང་གི་ཡུལ་ལམ་གཞན་གྱི་ཡུལ་དུའོ།",
    "རྣམ་པ་དང་བཅས་ཞེས་བྱ་བ་ནི་ཆེ་གེ་མོ་ཞིག་ན་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བདེ་བར་སོང་བ་དང་ཞེས་བྱ་བ་ནི་བདེ་འགྲོར་སྐྱེས་པས་སོ།",
    "ངན་པར་སོང་བ་དང་ཞེས་བྱ་བ་ནི་ངན་འགྲོར་སྐྱེས་པའོ།",
    "ངན་སོང་ངན་འགྲོ་ཞེས་བྱ་བ་ནི་ངན་སོང་ཉིད་ན་འགྲོ་སྟེ།",
    "དེ་དག་གི་སྒྲ་དང་དོན་སོ་སོར་རྟོགས་པ་ཡིན་པས་སོ།",
    "མ་འོངས་པ་དག་གིས་ཡིན་པ་སྟེ།",
    "དེ་དག་གི་སྔོན་གྱི་མཐའ་དང་།",
    "དང་གི་སྒྲ་ནི་མ་སྨོས་པ་བསྡུ་བར་བྱ་བའི་ཕྱིར་ཏེ།",
    "འདིར་འདོད་པའི་ཁམས་ཀྱི་ཉོན་མོངས་པ་ཆེན་པོའི་རྣམ་པར་གསུམ་སྤངས་པར་གསུངས་པ་ཡིན་ཏེ།",
    "གཞན་དུ་ཉོན་མོངས་པ་ཐམས་ཅད་གཏི་མུག་གི་ཆ་དང་ལྡན་པ་ཡིན་པས་གཏི་མུག་སྤངས་ནས་ཉོན་མོངས་པའི་རྣམ་པ་ཐམས་ཅད་སྤང་བར་འགྱུར་བས་ད་ལྟར་ཉིད་དུ་ཕྱིར་མི་སྤོང་བར་འགྱུར་རོ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་ས་གསུམ་པ་འོད་བྱེད་པས་སོ།",
    "ཅེས་པ་ནི་ས་གསུམ་པ་ཐོབ་པ་ལ་ནི་གེགས་བྱེད་པའི་ཉོན་མོངས་པ་འཇོམས་པར་བྱེད་པར་འདོད་པའོ།",
    "རང་གཏོགས་མུན་པ་རྣམས་ཞེས་བྱ་བ་ནི་རང་གི་རྒྱུད་དུ་གཏོགས་པའི་ས་གསུམ་པའི་སྒྲིབ་པའོ།",
    "རང་གི་ཡོན་ཏན་ཡོངས་སུ་དག་པའི་སྒོ་ནས་ཞེས་བྱ་བ་ནི་མི་དམིགས་པའི་སྒོ་ནས་ཏིང་ངེ་འཛིན་བྱེ་བ་ཕྲག་བརྒྱ་ཐོབ་པ་ལ་སོགས་པའི་ཡོན་ཏན་ཐོབ་པས་སོ།",
    "བརྩོན་འགྲུས་བརྩམ་མོ་ཞེས་བྱ་བ་ནི་སྐྱོ་བ་མེད་པའི་བརྩོན་འགྲུས་ཀྱིས་སོ།",
    "རྒྱས་པར་འགྱུར་བ་དང་ཞེས་བྱ་བ་ནི་ཆུང་ངུ་དང་འབྲིང་གི་སྒོ་ནས་སོ།",
    "གསུམ་ནི་ལྷག་མཐོང་གི་ཕྱོགས་སོ།",
    "རང་དུ་ལྟ་བ་དང་འབྲེལ་བ་ཡོངས་སུ་ཟད་ཅེས་བྱ་བ་ལ་རང་གི་སྒྲས་ནི་བདག་དང་བདག་གི་བ་བརྗོད་པ་ཡིན་ནོ།",
    "འདིའི་དོན་འདི་ཡིན་ཏེ་ལྷན་ཅིག་སྐྱེས་པའི་འཇིག་ཚོགས་ལ་ལྟ་བ་ཆེན་པོ་ལ་སོགས་པའི་རྣམ་པ་ནས་འབྲིང་གི་ཆེན་པོའི་བར་འདོད་པའི་ཁམས་ཀྱི་རྣམ་པ་བཞི་སྤངས་པ་ནི་རང་དུ་ལྟ་བ་ཡོངས་སུ་སྤངས་པ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "འབྲིང་གི་ཆེན་པོའི་བར་སྤངས་པ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་རྣམས་ཀྱི་རང་བཞིན་ཞིབ་མོ་ནི་དེ་བཞིན་ཉིད་དོ།",
    "དེའི་རྟོགས་པ་ལ་ཤིན་ཏུ་མཁས་པ་ཐོབ་པ་ནི་སེམས་མཉམ་པར་གཞག་པས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "གིས་རྒོལ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དོན་དམ་པ་དེ་ལ་ངག་གི་འཇུག་པ་དང་།",
    "དོན་དམ་པ་དེ་ནི་གཞན་ལ་བརྟེན་ནས་རྟོགས་པ་མ་ཡིན་པ་དང་ཞི་བ་དང་འཕགས་པ་རྣམས་ཀྱིས་སོ་སོ་རང་གི་རིག་པའི་བདག་ཉིད་ཅན་དང་།",
    "རྒྱུ་དང་འབྲས་བུ་ལས་ཐ་དད་དུ་གྱུར་པའི་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ནི་ཀུན་འབྱུང་གི་བདེན་པའོ་ཞེས་བྱ་བ་ནི་རྒྱུའི་ཆ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལམ་གྱི་བདེན་པ་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་ཁོངས་སུ་གཏོགས་སོ་ཞེས་བྱ་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པའི་བདག་ཉིད་ཅན་སྡུག་བསྔལ་བ་དང་།",
    "འགོག་པའི་བདེན་པ་ནི་དོན་དམ་པའི་བདེན་པ་རང་གི་ངོ་བོ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་ཀྱི་རང་བཞིན་ཡིན་པས་སོ།",
    "དེ་བཞིན་དུ་བདེན་པ་གཞན་གང་ཅུང་ཟད་ཅིག་ཡོད་པ་ཞེས་བྱ་བ་ནི་ཕྱིས་དེ་མ་ཐག་ཏུ་འཆད་པར་འགྱུར་བའི་ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གིས་སོ།",
    "དེ་ལ་རང་གི་མཚན་ཉིད་དང་།",
    "འགྲོ་བར་ཉིང་མཚམས་སྦྱོར་ངགཏོགས་པས་ཞེས་བྱ་བ་ནི་ཆེ་གེ་མོའི་འགྲོ་བ་ཆེ་གེ་མོར་སྐྱེས་སོ་སྙམ་པའི་ལྷའི་འགྲོ་བ་ལ་སོགས་པར་སྐྱེས་པས་ཡོངས་སུ་ཤེས་པས་རབ་ཏུ་སྐྱེ་བའི་བདེན་པར་རབ་ཏུ་ཤེས་པའོ།",
    "གང་གི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རབ་ཏུ་སོན་པ་ཐོབ་པ་ལས།",
    "རང་བཞིན་ཕྱིན་ཅི་མ་ལོག་པ་གང་གིས་མཐོང་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཡོངས་སུ་དག་པ་ཐོབ་པ་ནི་དེ་ལ་གེགས་བྱེད་པའི་ཉོན་མོངས་པ་རབ་ཏུ་སྤངས་པས་རབ་ཀྱི་མཐར་སོན་པ་ཐོབ་པས་སོ།",
    "དེ་ནི་ཐབས་གང་གིས་ཤེས་རབ་སྐྱེ་བ་དེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འོན་ཏེ་རང་བཞིན་ཉིད་ཀྱིས་ལུས་ངག་གི་རྗེས་སུ་འབྲང་ནས་སམ།",
    "འོ་ན་གང་གིས་མཐོང་བའི་ཡུལ་དུ་འགྱུར་ཞེ་ན།",
    "རབ་རིབ་ནི་གང་གིས་སྐྲ་ཤད་དང་།",
    "ད་ནི་རང་དགར་ལུས་ངག་གི་རྗེས་སུ་འབྲངས་ནས་དེ་ཁོ་ན་ཉིད་ཁོང་དུ་ཆུད་པ་ཡང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་རྒོལ་བ་ནི།",
    "ལུང་གི་དགོངས་པ་ངེས་པར་དཀའ་བའི་ཕྱིར་ཞེས་པ་ནི་གང་གི་ལུང་ལས་གསུངས་པའི་དོན་གང་ཡིན་པ་དེ་སོ་སོའི་སྐྱེ་བོས་ཉམས་སུ་མྱོང་བ་མ་ཡིན་པས་ལུང་གི་དགོངས་པ་ངེས་པར་དཀའ་བའོ།",
    "གལ་ཏེ་ལུང་གི་རྗེས་སུ་འབྲངས་པས་དེ་ཁོ་ན་ཉིད་མི་རྟོགས་ན།",
    "ལོག་པར་འཆད་པ་མཐོང་བ་ལས་ལུང་གི་དགོངས་པ་ཕྱིན་ཅི་མ་ལོག་པར་ངེས་པ་ཡིན་ནོ་ཞེས་རང་ཉིད་བཞེད་པའི་ཕྱོགས་སྟོན་པ་ནི།",
    "ལུང་གི་དགོངས་པ་ངེས་པ་ནི་དེའི་སྒོ་ནས་ལུང་གི་དགོངས་པ་ངེས་པའོ།",
    "འོན་ཀྱང་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཞབས་ཀྱིས་དེ་ཁོ་ན་ཉིད་དངོས་སུ་གཟིགས་པ་ཡིན་པས་དེས་མཛད་པའི་བསྟན་བཅོས་ཀྱི་སྒོ་ནས་ལུང་གི་དགོངས་པ་ཤེས་པ་ཡིན་ནོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "ཟབ་མོ་ནི་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ཅན་ནོ།",
    "དགེ་སློང་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པས་བཅོམ་པས་སོ།",
    "གང་གི་ཕྱིར་གཞན་གྱི་སེམས་ཤེས་པར་མི་ནུས་པ་དེའི་ཕྱིར་རོ།",
    "སྐྱེས་བུ་ནི་ཡོན་ཏན་དང་སྐྱོན་གྱི་རྟེན་དུ་གྱུར་པ་ཡིན་པས་དེའི་ཕྱིར་དེས་བྱས་པའི་ངག་རྣམས་ལ་ཕྱིན་ཅི་ལོག་གི་དོན་ཡང་སྲིད་ལ།",
    "གང་གི་ཕྱིར་ངག་རྣམས་ཀྱི་ཕྱིན་ཅི་ལོག་དང་།",
    "བདེན་པ་ཉིད་ཀྱི་རྟེན་དུ་གྱུར་པ་ཡོན་ཏན་དང་སྐྱོན་དང་ལྡན་པའི་སྐྱེས་བུ་ལོག་པས་ངན་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དཔེར་ན་དུག་ཞི་བར་བྱ་བའི་ཕྱིར་འཇོག་པོའི་གཙུག་གི་ནོར་བུ་ལེན་པའི་བསྟན་བཅོས་བཞིན་ནོ།",
    "དཔེར་ན་བྱ་རོག་གི་སོ་རྟོག་པའི་བསྟན་བཅོས་བཞིན་ནོ།",
    "ལུང་གིས་གནོད་པའི་དོན་ལྟ་བུའོ།",
    "གང་གི་ཕྱིར་ནང་གི་བདག་ཉིད་ཁོ་ནར་དགའ་བ་དང་གདུང་བའི་རང་བཞིན་ཅན་གྱི་བདེ་བ་དང་སྡུག་བསྔལ་ཉམས་སུ་མྱོང་བ་ཡིན་གྱི།",
    "གང་ཟག་གི་ཕྱིར་གཟུགས་ལ་སོགས་པ་ལས་ཐ་དད་དུ་གྱུར་པའི་རྫས་ལ་སོགས་པ་གཞན་མངོན་སུམ་པ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་རྗེས་དཔག་གི་ཡུལ་ལྐོག་ཏུ་གྱུར་པའི་དངོས་པོ་རྣམས་ལ་རྗེས་དཔག་གིས་དེ་ཁོ་ན་བཞིན་དུ་གྲུབ་པ་ནི་མི་སླུ་བ་སྟེ།",
    "ནང་གི་འདོད་ཆགས་ལ་སོགས་པ་ནི་མ་ཡིན་ནོ།",
    "འདི་ལྟར་གང་ཅི་ལྟར་བསྟན་པའི་ལུང་གི་ཁྱད་པར་ལ་བརྟེན་ནས་རྟོགས་པ་དེ་ནི་མི་སླུ་བ་ཡིན་ཏེ།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པས་རྟོགས་པར་བྱ་བའི་གནས་གཉིས་གང་གིས་གསུངས་པ་དེ་ཉིད་ཀྱིས་གནས་གསུམ་པ་གསུངས་སོ་ཞེས་པ་དེ་ལ་ངེས་པ་ག་ལ་ཡོད།",
    "དེས་ན་ཅི་སྐད་གསུངས་པའི་ལུང་གི་ཁྱད་པར་ལ་བརྟེན་ནས་ཞེས་པའི་གཏན་ཚིགས་དེ་ལ་ངེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "གང་སྟོན་པ་དང་ཉེ་བའི་ཉན་པ་པོ་དེ་རྣམས་ཀྱིས་གནས་གསུམ་ཀ་སྟོན་པ་པོ་གཅིག་གིས་བསྟན་པས་མངོན་སུམ་ཁོ་ནས་རྟོགས་པར་འགྱུར་དེ་རྣམས་ལ་ཐེ་ཚོམ་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "ད་ལྟར་གྱི་ཉན་པ་པོ་རྣམས་ཀྱིས་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་ཉེས་པ་ཟད་པའི་ཚིག་གི་མཚན་ཉིད་ཀྱིས་སོ།",
    "གལ་ཏེ་ཉེས་པ་ཟད་པའི་ཚིག་གི་མཚན་ཉིད་འདི་ཉིད་ཀྱང་ཉེས་པ་ཟད་པས་གསུངས་པ་ཡིན་ནོ་ཞེས་གང་ལ་ངེས་ཤེ་ན།",
    "དེ་ལྟར་ཐབས་གང་གིས་ཤེས་རབ་སྐྱེ་བ་དེ་བསྟན་ཟིན་ཏོ།",
    "སྔར་གོམས་པས་རྒྱུད་ལ་སྟོང་པ་ཉིད་ཀྱི་ས་བོན་སྟོང་པ་ཉིད་ལ་ལྷག་པར་མོས་པའི་རྒྱུ་གང་གི་རྒྱུད་ལ་ཡོད་པ་དེ་ཉིད་ལ་བསྟན་བཅོས་བསྟན་པར་བྱ་བ་ཡིན་ཏེ།",
    "རེས་འགའ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྷག་པར་མོས་པའི་ཁྱད་པར་ངེས་པར་བྱས་ཏེ་ཞེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་ལ་མོས་པའི་ཁྱད་པར་ངེས་པར་མཛད་དེ་ཞེས་པའི་དོན་ཏོ།",
    "དེས་ན་ཕྱིའི་རྟགས་གསུམ་གྱི་སྒོ་ནས་སྟོང་པ་ཉིད་ལ་ལྷག་པར་མོས་པར་ཤེས་པ་ཡིན་ནོ།",
    "མོས་པས་སྤྱོད་པའི་སའི་རིམ་པས་སོ།",
    "དེ་ལ་དེ་ཁོ་ན་ཉིད་ནི་གང་ཟག་གི་བདག་མེད་པ་དང་།",
    "དེ་ཡང་འདིར་ལུང་དང་རིགས་པས་བསྒྲུབ་པར་བསྟན་པ་ཡིན་པས་དེ་ལ་ལུང་གིས་བསྒྲུབ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྐྱེ་བ་མེད་པ་དང་ཞེས་བྱ་བ་ནི་གང་དོན་དམ་པ་ཡོངས་སུ་གྲུབ་པའི་རང་བཞིན་ཅན་དེ་རང་གི་བདག་ཉིད་ཀྱིས་སྐྱེ་བ་མེད་པའི་ཕྱིར་སྐྱེ་བ་མེད་པར་མཉམ་པ་ཉིད་དོ།",
    "བྲག་ཅ་དང་ཞེས་བྱ་བ་ནི་ངག་གི་ལས་ཀྱི་རང་བཞིན་ཅན་རྣམས་བྲག་ཅ་དང་མཉམ་པ་ཉིད་དོ།",
    "དེ་རྣམས་རང་གི་སེམས་ཡོངས་སུ་དག་པས་སྤྲུལ་པའི་ཕྱིར་རོ།",
    "ཡང་ན་ནང་གི་ཁམས་ནི་སྒྱུ་མ་ལྟ་བུ་ཡིན་ཏེ།",
    "བརྟེན་པའི་ཚིག་གིས་ན་ཞེས་བྱ་བ་ནི་བརྟེན་པའི་དངོས་པོ་བརྗོད་པར་བྱའོ།",
    "ཕྱི་དང་ནང་གི་དངོས་པོ་བརྗོད་པའོ་ཞེས་བྱ་བ་ནི་མིག་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མཚུངས་པར་ལྡན་པའི་བར་ནི་ནང་གི་དངོས་པོ་ཡིན་ལ།",
    "རེག་བྱ་དང་།",
    "ཡང་འདི་ག་ལས་ངེས་ཤེ་ན་ཞེས་བྱ་བ་ནི་དམ་བཅའ་བ་བཞི་པོ་འདི་གཏན་ཚིགས་གང་གིས་ངེས་པ་ཡིན་པའི་དོན་ཏོ།",
    "འདིའི་དོན་ནི་གང་གི་ཚེ་རང་ཉིད་ལས་རང་ཉིད་སྐྱེ་ན་དེའི་ཚེ་རྒྱུའི་རང་བཞིན་ལ་ཁྱད་པར་མེད་པས་འབྲས་བུའི་རང་བཞིན་སྐྱེ་བའམ་ཁྱད་པར་དང་བཅས་པར་སྐྱེ་བར་འགྱུར།",
    "སྐྱེ་བཞིན་པ་དེ་ཉིད་ཀྱི་བདག་གི་ངོ་བོ་ལས་ཞེས་བྱ་བ་ནི་མྱུ་གུ་ལས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྐྱེས་ཟིན་ཞེས་བྱ་བ་ནི་འདི་ཡང་ཐལ་འགྱུར་སྟོན་པ་ཡིན་ཏེ།",
    "དེ་ལ་རེ་ཞིག་མངོན་སུམ་གྱིས་ཁྱབ་པ་མི་འགྲུབ་སྟེ།",
    "འདི་ལྟར་ཚང་བང་དུ་མངོན་སུམ་དང་མི་དམིགས་པ་དག་གིས་མེ་དང་དུ་བ་དག་ལ།",
    "གང་གི་ཕྱིར་གང་ན་བསྒྲུབ་པར་བྱ་བ་དང་འབྲེལ་བའི་རྟགས་ཡོད་པ་དེ་ཁོ་ན་མི་རྟག་པ་ལ་སོགས་པ་ཤེས་པ་སྐྱེ་བར་འགྱུར་བ་ཡིན་གྱི།",
    "གལ་ཏེ་དངོས་པོ་རྣམས་བདག་ལ་མི་སྐྱེ་བ་ཁོ་ན་ཡིན་ནོ་ཞེས་ངེས་གཟུང་དུ་བྱེད་ན་གཞན་ལས་སྐྱེ་བ་ཡིན་པར་མི་འདོད་ཀྱང་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཐུག་པ་མེད་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་བདག་ཉིད་ཀྱིས་ཡོད་པའི་དངོས་པོ་རྣམས་ཀྱང་སྐྱེ་བ་ལ་དགོས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་ཁ་ཅིག་གིས་སྐྱོན་བརྗོད་པ་འདི་ནི་མི་རིགས་ཏེ།",
    "ཐལ་འགྱུར་གྱི་ངག་ཡིན་པའི་ཕྱིར་སྐབས་སུ་བབ་པའི་དོན་ལས་ཟློག་པས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "སྐྱེ་བ་ཐུག་པ་མེད་པར་མི་འགྱུར་བའི་གཏན་ཚིགས་ཀྱིས་དངོས་པོ་རྣམས་གཞན་ལས་སྐྱེ་བར་བསྒྲུབས་པས་རང་གི་གྲུབ་པའི་མཐའ་དང་འགལ་བར་འགྱུར་རོ་ཞེའོ།",
    "དེ་ལྟར་རེ་ཞིག་གང་གཏན་ཚིགས་དང་དཔེ་དག་མ་བརྗོད་པ་དང་ཞེས་བྱ་བ་དེ་མི་རིགས་སོ།",
    "ཞེས་ཁྱོད་ཀྱིས་བརྗོད་ལ།",
    "ཁྱོད་ཀྱིས་སྐྱེས་པ་ཡང་སྐྱེ་བར་མི་འདོད་པ་དང་།",
    "དེས་ན་ཁྱོད་ཀྱིས་རྒོལ་བ་དེ་ལ་རིགས་པ་མེད་པ་དང་།",
    "རང་གིས་ཁས་བླངས་པ་དང་འགལ་བ་ཡིན་ནོ་ཞེས།",
    "གང་གིས་གཏན་ཚིགས་དང་དཔེ་བརྗོད་པ་དོགས་པ་དང་བཅས་པར་འགྱུར་བ་ཡིན།",
    "གཉིས་ཀ་ལ་གྲུབ་པའི་རྗེས་སུ་དཔག་པས་གཞན་གྱི་དམ་བཅའ་ཟློག་པར་མི་བྱེད་ཀྱང་གཞན་གྱིས་དམ་བཅས་པ་ལ་རང་གི་རྗེས་སུ་དཔག་པས་གནོད་པའི་འགལ་བ་བརྗོད་ན།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གང་གི་ཕྱིར་གང་གི་དོན་གང་དང་བཅས་པ་དེས་རང་གི་ཅི་ལྟར་ངེས་པར་བྱས་པ་བཞིན་དུ་གཞན་དག་ལ་ཡང་ངེས་པ་སྐྱེད་པར་འདོད་པས་རིགས་པ་གང་གིས་དོན་འདི་རྟོགས་པའི་རིགས་པ་དེ་ཉིད་གཞན་ལ་བསྟན་པར་བྱ་དགོས་སོ།",
    "དེའི་ཕྱིར་རེ་ཞིག་གང་གཞན་དག་གིས་དམ་བཅས་པའི་དོན་ལ་སྒྲུབ་བྱེད་ཁས་ལེན་དགོས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་རིགས་པ་ཡིན་ལ།",
    "འདི་ལྟར་རང་གིས་དམ་བཅས་པའི་དོན་སྒྲུབ་པར་མི་ནུས་པ་གང་ཡིན་པའོ།",
    "གལ་ཏེ་ཡང་རང་གི་རྗེས་སུ་དཔག་པ་དང་འགལ་བའི་སྐྱོན་ངེས་པར་བརྗོད་པར་བྱ་དགོས་སོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་དངོས་པོ་རྣམས་བདག་ལས་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "འདིར་ནི་དེ་ཞེས་བྱ་བ་འདིས་རང་གི་བདག་ཉིད་ཡོད་པ་ཉིད་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་མདུན་ན་གནས་པའི་བུམ་པ་ལ་སོགས་པ་རང་གི་ངོ་བོར་གནས་པ་ནི་ཡང་སྐྱེ་བར་ལྟོས་པ་མ་ཡིན་པར་མཐོང་ལ།",
    "དེ་བཞིན་དུ་འཇིམ་པའི་གནས་སྐབས་ན་ཡང་གལ་ཏེ་བུམ་པ་ལ་སོགས་པ་རང་བཞིན་གྱིས་ཡོད་པར་སེམས་ན་ནི་དེའི་ཚེ་རང་གི་བདག་ཉིད་ཀྱིས་ཡོད་པ་ལ་ཡང་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་རང་གི་རྗེས་སུ་དཔག་པའམ་གནོད་པའི་རྒོལ་བའི་སྐྱོན་བསྟན་པ་ལ་ཡངསྐད་བསྟན་པའི་སྐྱོན་ཡོད་པ་མ་ཡིན་པས་གཞན་གྱིས་བརྗོད་པའི་སྐྱོན་མ་སྤངས་པའི་ཉེས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པའི་ཕྱིར་དཔེར་ན་སྐྱེས་བུ་ཞེས་པ་འདིར་དཔེར་བརྗོད་པར་བྱའོ།",
    "ཐལ་བར་འགྱུར་བ་ལས་བཟློག་པའི་དོན་གྱིས་ནི་གཞན་ལ་འབྲེལ་བ་ཡིན་གྱིས་ཁོ་བོ་ཅག་ལ་མ་ཡིན་ཏེ།",
    "དེས་ན་ཐལ་འགྱུར་བརྗོད་པ་ནི་གཞན་གྱི་དམ་བཅའ་བ་འགོག་པ་ཙམ་གྱི་འབྲས་བུ་ཅན་ཡིན་པས་ཐལ་བར་འགྱུར་བ་ལས་བཟློག་པའི་དོན་དང་འབྲེལ་པར་འགྱུར་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ཡང་ཕལ་ཆེར་སློབ་དཔོན་གྱིས་ཐལ་འགྱུར་གསུངས་པའི་སྒོ་ནས་གཞན་གྱི་ཕྱོགས་འགོག་པ་ཡིན་ཏེ།",
    "མཚན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར།",
    "རེ་ཞིག་མྱ་ངན་འདས་དངོས་མིན།",
    "རྒ་ཤིའི་མཚན་ཉིད་ཐལ་བར་འགྱུར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ཐལ་བར་འགྱུར་བའི་སྒོ་ནས་གཞན་གྱི་ཕྱོགས་དགག་པ་མཛད་པ་ཡིན་ནོ།",
    "ལ་ལར་རང་གི་ཚིག་ཁོ་ནས་སོ།",
    "གཞན་གྱི་ཚིག་གིས་ནི་རྒྱལ་བར་ཡང་མི་འགྱུར་ལ་ཕམ་པར་ཡང་མི་འགྱུར་རོ།",
    "ཐེ་ཚོམ་གྱིས་ནི་མ་ཡིན་ནོ་ཞེས་གང་གིས་སེམས་པ་དེས་ཀྱང་འཇིག་རྟེན་པའི་རྣམ་གཞག་ལ་བརྟེན་ནས་རྗེས་སུ་དཔག་པ་ལ་ཇི་སྐད་བསྟན་པའི་རིགས་པས་ཁས་བླང་བར་བྱ་སྟེ།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཐམས་ཅད་དུ་རང་ཉིད་ལ་གྲུབ་པ་ཁོ་ན་སྟོབས་དང་ལྡན་པ་ཡིན་གྱི།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་གེགས་བྱེད་པས་སོ།",
    "ཇི་སྐད་སྨྲས་པའི་ཉེས་པའི་སྐབས་མེད་ཅིང་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཆུ་ལ་སོགས་པའི་རྐྱེན་དང་ཕྲད་ནས་མྱུ་གུ་སྐྱེ་བ་དེའི་ཕྱིར་མྱུ་གུ་ལ་སོགས་པ་རྣམས་གཏན་མི་སྐྱེ་བར་འགྱུར་བ་མ་ཡིན་ཞེས་པའོ།",
    "ས་བོན་དང་མྱུ་གུ་དག་ཐ་མི་དད་པ་ཡིན་ཏེ་ནས་ཀྱི་ས་བོན་དང་ནས་ཀྱི་མྱུ་གུ་ཞེས་སྒྲ་གཅིག་གི་ཡུལ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "རང་གི་བདག་ཉིད་ཅེས་བྱ་བ་ནི་ས་བོན་གྱི་རང་གི་བདག་ཉིད་ཀྱིས་སོ།",
    "དེ་ལ་ཡོངས་སུ་འགྱུར་བ་སྨྲ་བ་གྲངས་ཅན་པ་ན་རེ།",
    "ཅི་ལྟར་སྐྱེས་བུ་གཞོན་ནུའི་གནས་སྐབས་དོར་ནས་ལང་ཚོ་ལ་བབ་པའི་གནས་སྐབས་ལེན་ཀྱང་གནས་སྐབས་ཅན་སྐྱེས་བུ་གཅིག་ཉིད་ཡིན་ནོ།",
    "སྔར་གྱི་བདག་གི་དངོས་པོ་ཞེས་བྱ་བ་ནི་ས་བོན་གྱི་རང་བཞིན་ནོ།",
    "རེ་ཞིག་ཐ་དད་པ་ནི་མ་ཡིན་ཏེ།",
    "བུམ་པ་དང་སྣམ་བུ་བཞིན་དུ་དེའི་དེའོ་ཞེས་འབྲེལ་པ་མེད་པར་ཐལ་བར་འགྱུར་བས་སོ།",
    "གནས་སྐབས་དང་གནས་སྐབས་ཅན་ལ་འབྲེལ་པ་བསྒྲུབ་པའི་དོན་དུ་འབྲེལ་པ་གཞན་ཁས་ལེན་ན་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "འོ་ན་འདུ་བ་དེ་རྟག་པ་དང་གཅིག་པུ་ཡིན་པས་ས་བོན་གྱི་གནས་སྐབས་ཀྱི་འདུ་བ་གང་ཡིན་པ་དེ་ཉིད་མྱུ་གུའི་གནས་སྐབས་ན་ཡང་ཡོད་པ་ཡིན་པས་གནས་སྐབས་གཉིས་སུ་གནས་སྐབས་གཉིས་དམིགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེས་ན་རྫ་ས་ཐ་མི་དད་པའི་དོན་ནི་ས་བོན་དང་མྱུ་གུ་དག་གི་དབྱིབས་ཐ་མི་དད་པར་བསྟན་པ་ཡིན་ནོ།",
    "བཞིན་དུ་མྱུ་གུ་ཡང་མི་དམིགས་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མྱུ་གུ་ལས་ས་བོན་ཐ་མི་དད་ན་དེའི་ཚེ་མྱུ་གུ་བཞིན་དུ་ས་བོན་ཡང་མི་དམིགས་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "བསྟན་པའི་ཕྱིར་གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ན་ཡང་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཕྱོགས་གཉིས་ཀ་ལྟར་ན་ཡང་རང་ལས་སྐྱེ་བ་མི་རིགས་པའོ།",
    "དེའི་དོན་དམ་པར་ཞེས་བྱ་བའི་ཁྱད་པར་དོན་མེད་དོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཕྱོགས་གཉིས་ཀ་ཡང་རང་ལས་སྐྱེ་བ་མི་རིགས་པས་དེའི་ཕྱིར་དོན་དམ་པར་ཁྱད་པར་དུ་བྱས་པ་ལ་དགོས་པ་ཅི་ཞིག་ཡོད་ཅེས་པའོ།",
    "ལས་དང་གཅིག་ཏུ་ཐལ་བར་འགྱུར་རོ།",
    "ལས་དང་བྱེད་པ་པོ་གཅིག་ཏུ་འགྱུར་བ་ནི་མེ་དང་བུད་ཤིང་ལྟ་བུའོ།",
    "འདིར་འབར་བཞིན་པའི་བུད་ཤིང་ནི་ལས་ཡིན་ལ།",
    "བུད་ཤིང་ནི་མེའི་འབྲས་བུ་མ་ཡིན་པས་སོ་ཞེ་ན།",
    "འདི་ལྟར་མེ་ནི་འབར་བྱའི་བུད་ཤིང་གི་རྒྱུ་ཁོ་ན་ཡིན་ཏེ།",
    "དེའི་སྟོབས་ཀྱིས་བུད་ཤིང་ཁྱད་པར་ཅན་དུ་སྐྱེ་བའི་ཕྱིར་རོ།",
    "དབྱིབས་དང་ཁ་དོག་ལ་སོགས་པས་སྔར་སྐྱོན་གང་བརྗོད་པ་དེ་འདིར་ཡང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་གཅིག་ཉིད་དུ་ཁས་བླང་བར་བྱ་བ་མ་ཡིན་པའོ།",
    "དེ་ལ་བུད་ཤིང་གང་ཡིན་པ་དེ་ཉིད་མེར་ཡོངས་སུ་རྟོགས་ན་དེའི་ཚེ་བྱེད་པ་པོ་དང་ལས་དག་གཅིག་ཏུ་འགྱུར་བ་ལ།",
    "བུམ་པ་དང་རྫ་མཁན་ཡང་གཅིག་ཏུ་ཐལ་བར་འགྱུར་བས་སོ།",
    "འདི་རང་ལས་སྐྱེ་བ་འགོག་པར་བྱེད་པ་ལ་གཞན་དག་གིས་རྒོལ་བར་བྱེད་དེ།",
    "ཅི་ལྟར་ཁྱོད་ལ་དངོས་པོ་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་ཡིན་ནོ་ཞེས་ངེས་པ་སྐྱེ་བ་དེ་བཞིན་དུ་ཁོ་བོ་ཅག་གི་ཡང་དངོས་པོ་ཐམས་ཅད་སྐྱེ་བར་འགྱུར་བར་ངེས་པ་ཡིན་ནོ།",
    "འོན་ཏེ་ཁྱོད་ལ་དངོས་པོ་ཐམས་ཅད་སྐྱེ་བ་མེད་དོ་སྙམ་པའི་ངེས་པ་མེད་ན་དེའི་ཚེ་རང་ཉིད་ལ་ངེས་པ་མེད་པར་གཞན་དག་ལ་རྟོགས་པ་བསྐྱེད་པ་མི་སྲིད་པས་བསྟན་བཅོས་རྩོམ་པ་དོན་མེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་དངོས་པོ་ཐམས་ཅད་མ་བཀག་པར་ཡོད་པ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "གང་གི་ཚེ་ཁོ་བོ་ཅག་ལ་མ་ངེས་པ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་དེ་དང་འགལ་བའི་ངེས་པ་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "ཅི་འཕགས་པ་རྣམས་ལ་རིགས་པ་ཡོད་དམ་མེད་དོ་ཞེས་གང་གིས་བརྗོད།",
    "དོན་དམ་པ་གང་གིས་འཇིག་རྟེན་པ་རྣམས་ལ་རྟོགས་པར་བྱེད་ཅེ་ན།",
    "དཔེར་ན་ལུས་ལ་མི་གཙང་བ་ཉིད་ཡོད་དུ་ཟིན་ཀྱང་ཕྱིན་ཅི་ལོག་གི་རྗེས་སུ་འབྲང་བའི་ཆགས་པ་ཅན་གྱིས་མི་དམིགས་པ་དང་།",
    "དེ་བཞིན་དུ་འདིར་ཡང་འཕགས་པ་མ་ཡིན་པ་རྣམས་རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་པའི་རང་བཞིན་གྱི་དངོས་པོ་རྣམས་ལ་མ་རིགས་པའི་རབ་རིབ་ཀྱིས་བློའི་མིག་ཉེ་བར་བཅོམ་པས་ཕྱིན་ཅི་ལོག་གི་རང་བཞིན་ཅན་དུ་སྒྲོ་བཏགས་ནས་ལ་ལར་ཅུང་ཟད་ཁྱད་པར་བྱས་ནས་ཤིན་ཏུ་ཉམ་ཐག་པར་འགྱུར་བ་ཡིན་ལ།",
    "དེ་ཡང་མི་རིགས་ཏེ་རྟོག་པ་མི་མཁས་པས་བྱས་པའི་ཕྱིན་ཅི་ལོག་གི་མཚན་ཉིད་ཀྱིས་འཇིག་རྟེན་གྱི་མཚན་ཉིད་ཀྱི་གཞི་ཕྱིན་ཅི་ལོག་པར་གྱུར་ན་དེའི་ཚེ་དེའི་དོན་དུ་འབད་པ་དགོས་པ་དང་བཅས་པར་འགྱུར་བ་ལས་དེ་ལྟར་ཡང་མ་ཡིན་ཏེ།",
    "འགྲུབ་ན་ཐུག་མེད་ཐལ་བར་འགྱུར།",
    "མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཐུག་པ་མེད་པར་ཐལ་བའི་སྐྱོན་གནས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འདི་ལྟར་རྨི་ལམ་ན་འཁྲིག་པའི་བདེ་བ་ཉམས་སུ་མྱོང་བའི་ཚེ་སེན་མོ་བཏབ་པ་ལ་སོགས་པའི་ཕྱིས་མི་མཐོང་ལ།",
    "གང་གི་ཕྱིར་དོན་གྱི་བྱ་བ་དེ་རྨི་ལམ་ན་མཐོང་བའི་སྐྱེས་བུ་རྣམས་ལ་ཐུན་མོང་པར་སྣང་བ་མ་ཡིན་ནམ།",
    "དེའི་ཚེ་སད་པའི་གནས་སྐབས་ཀྱི་དོན་གྱི་བྱ་བ་ཡང་རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡོད་པའི་སྐྱེས་བུ་རྣམས་ཀྱིས་མི་དམིགས་པའི་ཕྱིར་སད་པའི་གནས་སྐབས་ཀྱི་དོན་གྱི་བྱ་བ་ཡང་མེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "འདི་ལྟར་གང་གི་ཚེ་གྲང་བ་ལ་སོགས་པ་འཇུག་པ་དེ་ཉིད་ཀྱི་ཚེ།",
    "གང་གི་ཕྱིར་རྨི་ལམ་ན་ཡང་ཞིང་རྨེད་པ་དང་ཉོ་ཚོང་ལ་སོགས་པ་སྔོན་དུ་འགྲོ་བའི་དོན་གྱི་བྱ་བ་དམིགས་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་རྨི་ལམ་ན་དོན་གྱི་བྱ་བ་རྫོགས་པ་ཉིད་དམིགས་པ་ཡིན་ཏེ།",
    "དཔེར་ན་ཁུ་བ་འཛག་པ་བཞིན་དུ་སེན་མོའི་རྗེས་ལ་སོགས་པ་ཡང་དེར་དམིགས་པ་ཡིན་པས་སོ།",
    "འདི་ལྟར་སྐྱེས་བུ་འགའ་ཞིག་གིས་ཁྲུས་བྱས་ཏེ།",
    "སྐྲ་སྐམ་པོ་དམིགས་ན་དོན་གྱི་བྱ་བ་རྫོགས་པར་མི་དམིགས་པས་སད་པའི་གནས་སྐབས་ཀྱི་དོན་གྱི་བྱ་བ་ཡང་ཡོངས་སུ་མ་རྫོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་སད་པའི་གནས་སྐབས་ན་རྒྱུན་ཆགས་པ་མེད་པས་མི་བདེན་པ་ཡིན་ན་སད་པའི་གནས་སྐབས་ན་མཐོང་བའི་དོན་གྱི་བྱ་བ་ཡང་རྨི་ལམ་གྱི་གནས་སྐབས་ན་རྒྱུན་ཆགས་པ་མེད་པས་དེ་ཡང་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལ་དམིགས་པའི་དོན་གྱི་བྱ་བ་ཤེས་པ་བདེན་པ་ཉིད་དུ་ཁྱོད་ཀྱིས་མི་འདོད་ལ།",
    "གལ་ཏེ་ཤེས་པ་ཡང་ཡོད་པར་མ་གྱུར་ན་གང་གི་བདག་ཉིད་དུ་སྣང་བ་ཡིན།",
    "བྱེད་པ་པོ་དང་ལས་དག་གཅིག་ཏུ་ཐལ་བར་འགྱུར་བ་དང་།",
    "རང་གི་བདག་ཉིད་ལ་བྱེད་པ་འགལ་བ་སྟེ།",
    "གལ་ཏེ་ཤེས་པ་དང་ཤེས་བྱའི་བདག་ཉིད་ཅན་གཅིག་ལ་རང་རིག་པ་ཞེས་མི་བརྗོད་ཀྱི་འོན་ཀྱང་རང་གི་བདག་ཉིད་གསལ་བ་དེ་གསལ་བ་གཞན་ལ་མི་ལྟོས་པར་གསལ་བར་སྐྱེ་བ་གང་ཡིན་པའོ།",
    "དེ་ལ་ཁ་ཅིག་ན་རེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་གང་གིས་འདི་བྱེད་པ་དེ་རྣམས་བྱེད་པའི་རྒྱུ་ཡིན་གྲང་ན།",
    "གང་གིས་འདི་མི་བྱེད་པ་དེ་རྣམས་ཅི་ལྟར་བྱེད་པའི་རྒྱུ་ཡིན་ཞེ་ན།",
    "འདི་ཡང་མཐོང་སྟེ་གྲོང་གི་དཔོན་པོ་ནུས་པ་མེད་དུ་ཟིན་ཀྱང་གྲོང་གི་མི་རྣམས་འདིས་ཁོ་བོ་ཅག་བདེ་བར་བྱས་སོ་ཞེས་བརྗོད་པར་འགྱུར་བ་བཞིན་ནོ།",
    "གཅིག་མེད་ན་ཡང་མཚུངས་པར་མི་ལྡན་པས་འདི་ནི་དེ་དག་གི་རྒྱུའི་དངོས་པོ་ཡིན་ནོ།",
    "དེ་ལྟར་ཉོན་མོངས་པ་ཅན་བཅུ་གཅིག་ནི་ཀུན་ཏུ་འགྲོ་བའོ།",
    "ཉོན་མོངས་པ་ཅན་སྤྱིའི་རྒྱུ་ཡིན་པས་སྐལ་བ་མཉམ་པའི་རྒྱུ་ལས་ལོགས་སུ་རྣམ་པར་འཇོག་པ་ཡིན་ཏེ།",
    "ཕུང་པོའི་ལྷག་མ་མེད་པར་མྱ་ངན་ལས་འདས་པར་འཇུག་པའི་སེམས་ལས་ཞེས་བྱ་བ་ནི་གང་གི་ཕུང་པོ་ལྡོག་པའི་མཚན་ཉིད་ཅན་གྱི་མྱ་ངན་ལས་འདས་པ་འཇུག་པའི་སེམས་གང་ཡིན་པ་དེ་ལ་འདི་སྐད་ཅེས་བྱའོ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་འབྲས་བུའོ།",
    "དམིགས་པ་གང་གིས་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པ་རྣམས་ཀྱིས་སོ།",
    "དེ་ལ་གཞན་དག་གི་དོགས་པ་བསུ་བར་བྱ་བའི་ཕྱིར།",
    "དེས་ན་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་རྒྱུ་ཉིད་དུ་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "ཚིག་གི་དོན་ནི་གོ་སླའོ།",
    "པ་དེ་ལ་ཁྱོད་ཀྱིས་ངེས་པ་མཐོང་བས་སོ་ཞེས་ལན་གསུམ་བརྗོད་པ་ཡིན་ལ་དེ་ཡང་མི་རིགས་ཏེ།",
    "འོ་ན་ངེས་པ་མཐོང་བ་གང་གི་ཕྱིར་ཞེ་ན།",
    "རང་གི་རྒྱུ་ཁོ་ན་ལས་ཁྱད་པར་ཅན་སྐྱེ་བས་སོ་ཞེ་ན།",
    "གཞན་ཡང་རང་གི་རྒྱུ་ལས་ཁྱད་པར་ཅན་དེ་སྐྱེ་བ་དེ་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་གྲུབ་པར་གྱུར་ན་འགྲུབ་པ་ཡིན་པ་ལ་དེ་ཡང་མི་རིགས་ཏེ།",
    "གང་གི་ཕྱིར་རྒྱུ་རྟག་པའམ་མི་རྟག་པ་ལས་འབྲས་བུ་སྐྱེ་བ་ཡིན།",
    "རེ་ཞིག་རྟག་པ་ལས་ནི་མི་རིགས་ཏེ།",
    "གང་གི་ཕྱིར།",
    "དེས་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་དག་མ་གྲུབ་པའི་ཕྱིར་རང་གི་རྒྱུ་ལས་ཁྱད་པར་ཅན་སྐྱེ་བ་ག་ལ་ཡོད།",
    "ཀི་ཤུ་ཀ་ཞེས་བྱ་བ་ནི་མེ་ཏོག་གི་ཁྱད་པར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་གྲུབ་གྲུབ་ལྟར་རྗེས་སུ་བརྗོད་ནས་ཞེས་བྱ་བ་ནི་འབྲས་བུ་ལ་ལྟོས་ནས་རྒྱུ་གཞན་ཉིད་མ་གྲུབ་ཏུ་ཟིན་ཀྱང་གཞན་ཉིད་དུ་ཁས་བླངས་ནས་སྐྱོན་བརྗོད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "རྣམས་ལ་ཞེས་པའི་བདུན་པའི་ཚིག་གི་རྐྱེན་ལ་སོགས་པར་གྱུར་ན་འབྲས་བུ་ཡོད་པར་གྱུར་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "གང་གི་ཚེ་གཞི་ཡིན་པས་དེའི་ཚེ་ནི་ཞེས་བྱ་བ་ནི་རྐྱེན་ལ་སོགས་པ་རྣམས་ལ་བདུན་པའི་ཚིག་ནི་གཞི་སྟོན་པར་བྱེད་པར་འདོད་ནའོ་ཞེས་པའོ།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་དག་གི་སྐྱེ་འགག་འགྱུར་ཞེ་ན་ཞེས་བྱ་བ་ནི་སྲང་མདའི་དཔེས་འཇིག་པ་སྐྱེ་བ་དག་དུས་མཉམ་པ་ཉིད་དུ་བསྟན་པས་འགག་བཞིན་པ་ས་བོན་དང་།",
    "དེའི་ཕྱིར་ཉེས་པ་མེད་དོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ས་བོན་དང་མྱུ་གུ་དག་དུས་མཉམ་པ་དེའི་ཕྱིར་གཞན་ཉིད་དུ་མ་གྲུབ་པོ་ཞེས་བྱ་བའི་སྐྱོན་ཡོད་པར་མི་འགྱུར་བའོ།",
    "གལ་ཏེ་གཅིག་ཚེ་ཡིན་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་ས་བོན་དང་མྱུ་གུ་དག་ལ་དུས་གཅིག་གི་ཚེ་ན་སྐྱེ་བ་དང་འཇིག་པ་དུས་གཅིག་པའི་སྒོ་ནས་དུས་གཅིག་པ་ཉིད་ཁས་ལེན་ནའོ།",
    "དུས་གཅིག་མེད་ཅེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ས་བོན་དང་མྱུ་གུ་དག་དུས་མཉམ་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྲང་གི་དཔེས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་གོ་སླའོ།",
    "དེས་ན་སྲང་གི་དཔེ་དང་།",
    "དེའི་བྱེད་པ་པོ་མྱུ་གུ་ནི་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་མྱུ་གུ་སྐྱེ་བ་དེའི་ཕྱིར་མྱུ་གུ་བྱེད་པ་པོ་ཡིན་ཏེ།",
    "གཞི་མཐུན་ནོ་ཞེས་བྱ་བ་ནི་དོན་གང་དངོས་པོའི་སྒྲས་བརྗོད་པ་དེ་ཉིད་དེ་ཞེས་བྱ་བའི་ཚིག་གིས་ཀྱང་བརྗོད་པ་ཡིན་པས་སྒྲའི་བརྗོད་བྱ་མཚུངས་པར་ཉིད་ཡིན་ནོ་ཞེས་པའོ།",
    "ཅི་ཞིག་གི་སྒྲ་ནི་སྐྱེ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་སྒྲ་འདི་དང་སྦྱར་བར་བྱ་སྟེ་ཞེས་བྱ་བ་ནི་ཅི་ཞིག་སྐྱེ་བར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཉེ་བར་བཀོད་པ་ནི་བདེན་མོད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དང་།",
    "མིག་གི་བློ་ལ་ཞེས་བྱ་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ལའོ།",
    "གཞན་ཉིད་ཡོད་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་འདུ་ཤེས་ལ་སོགས་པ་དང་།",
    "ཅི་སྟེ་དེ་མེད་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་སྐྱེ་བ་མེད་པའི་སྐྱོན་སྤང་བའི་ཕྱིར་མིག་གི་རྣམ་པར་ཤེས་པ་ཡོད་པར་ཁས་མི་ལེན་ནའོ།",
    "རི་བོང་གི་རྭ་བཞིན་དུ་མེད་པའི་ཕྱིར་རོ།",
    "རེ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་མེད་པ་བྱེད་པ་འཐད་པ་མིན་ཕྱིར་དང་ཞེས་བྱ་བ་ལ་སོགས་པས་འབྲས་བུ་ཡོད་པ་ཉིད་དུ་ཁས་བླངས་པ་ཡིན་ཏེ་འབྲས་བུ་མེད་པར་སྐྱེ་བ་ཁས་ལེན་ན་ནི་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ནི་དངོས་པོ་མེད་པ་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་འཇིགས་པས་དངོས་པོ་རྣམས་དུས་གསུམ་ན་ཡོད་པ་ཡིན་ནོ་ཞེས་རྟོག་པར་བྱེད་དེ་ཚོགས་པ་ནི་གནས་སྐབས་ཀྱི་འབྲས་བུ་ཅན་ཡིན་གྱི།",
    "ཡོད་པ་ནི་འགག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ལུང་གིས་རྒྱུ་ལས་འབྲས་བུ་མེད་པ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་ཁས་ལེན་ནོ།",
    "སེམས་ཙམ་དུ་སྨྲ་བ་རྣམས་ཀྱང་དངོས་པོ་ཐམས་ཅད་སྐྱེ་བའི་རྒྱུ་བག་ཆགས་ཀྱི་བྱེ་བྲག་གི་རྟེན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་བག་ཆགས་ཡོངས་སུ་སྨིན་པའི་རྐྱེན་ཉེ་བར་གནས་པའི་གང་འཇུག་པའི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་སྐྱེ་བ་དེ་ནི་མེད་པ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་ཁས་ལེན་པ་ཡིན་ནོ།",
    "ཁྱིམ་གྱི་དོན་དུ་གང་ཀ་བ་དང་སྒོ་དང་སྒོ་སྐྱེས་ལ་སོགས་པ་རྣམས་ལ་རི་མོ་ལ་སོགས་པ་བཀོད་པའི་ཁྱད་པར་ཅན་གྱི་བདག་ཉིད་ཅན་གྱི་རྒྱན་དེ་རེ་ཞིག་འབྲས་བུ་ཡོད་པར་སྨྲ་བའི་ཕྱོགས་ལ་མི་རིགས་ཏེ།",
    "མོ་གཤམ་གྱི་བུ་དེ་གང་གིས་ཀྱང་བསྐྱེད་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྐྱོན་དེ་སྤང་བར་བྱ་བའི་ཕྱིར་འབྲས་བུ་རྣམ་པ་ཐམས་ཅད་དུ་མེད་པ་ཉིད་དུ་ཁས་མི་ལེན་ན་འབྲས་བུ་མེད་པར་སྨྲ་བ་ཉམས་པར་འགྱུར་རོ་ ཅི་ལྟར་ཁྱིམ་ཡོད་པ་དང་མེད་པ་བསྒྲུབ་པའི་དོན་དུ་ཀ་བ་ལ་སོགས་པའི་རྒྱན་མི་རིགས་པ་དེ་བཞིན་དུ་ཕྱི་དང་ནང་གི་འདུ་བྱེད་དང་།",
    "ཁྱོད་ཀྱིས་བརྗོད་པའི་སྐྱོན་ཡོད་པ་ཡིན་གྱི།",
    "རྒྱུ་ཉིད་མེད་པས་འབྲས་བུ་གང་གི་ཡིན་པར་འགྱུར་དེས་ན་འབྲས་བུ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "གཉིས་ཀྱི་དངོས་པོ་འདི་གཉིས་ཉིད་ཡིན་ཞིང་ཞེས་བྱ་བ་ནི་གྲངས་ཙམ་མོ།",
    "དཔེར་ན་ཁྱིམ་གཅིག་གི་ནང་དུ་ཕན་ཚུན་འགལ་བ་སྣང་བ་དང་མུན་པ་དག་དུས་གཅིག་ཏུ་མི་སྲིད་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གང་གི་ཚེ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་མ་གྲུབ་པ་དེའི་ཚེ་དེ་དག་བཀག་པ་ཡང་མེད་པས་མྱ་ངན་ལས་འདས་པ་དངོས་པོ་དང་།",
    "བུད་ཤིང་སྐམ་པོ་མར་གྱིས་བྲན་པ་ལྟར།",
    "ཁྱོད་ཀྱི་ཤེས་རབ་ཀྱི་མེ་སྤོར་བ་ལྷུར་བྱེད་པ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་འཕེལ་བར་བྱེད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "གང་གི་ཕྱིར་གཞན་ལས་སྐྱེ་བ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་པ་རང་གི་ལྟ་བ་ལ་གནས་པ་སྟེ།",
    "དེས་ན་གང་གི་ཕྱིར་ཞེས་བྱ་བས་ནི་འཇིག་རྟེན་པས་གཞན་ལས་སྐྱེ་བ་མངོན་སུམ་གྱིས་གྲུབ་པས་གཞན་ལས་སྐྱེ་བ་ཡོད་པ་ཁོ་ན་ཡིན་ནོ།",
    "གཉིས་ཀྱི་རྣམ་གཞག་གི་སྒོ་ནས་སོ།",
    "དེ་དག་གི་སྒོ་ནས་འཇིག་རྟེན་གྱི་གནོད་པའི་ཡུལ་ཁོང་དུ་ཆུད་པས་སོ།",
    "དངོས་ཀུན་ཞེས་བྱ་བ་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི་དངོས་པོ་རྣམས་སོ།",
    "དེ་དག་གི་ཡུལ་དང་ཡུལ་ཅན་གྱི་དངོས་པོ་ནི་ཡུལ་དང་ཡུལ་ཅན་མི་དམིགས་པ་གང་ཡིན་པའོ།",
    "ཡེ་ཤེས་ཀྱི་ཁྱད་པར་གྱི་ཡུལ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་བག་ཆགས་དང་བཅས་པ་སྤངས་པ་ནི་ཡེ་ཤེས་ཀྱི་ཁྱད་པར་ཡིན་ལ།",
    "ཉིད་ཀྱི་སྒོ་ནས་བདག་གི་རང་གི་དངོས་པོ་རྙེད་པ་སྟེ།",
    "དེའི་ཡུལ་ཉིད་ཀྱིས་བདག་གི་ངོ་བོ་རྙེད་པ་ཡིན་གྱི་ཞེས་བྱ་བ་འདི་ཡང་གདུལ་བྱ་རྣམས་ཀྱིས་དེ་ལྟར་བརྟགས་པ་ཡིན་པས་དེ་ལྟར་བརྗོད་པ་ཡིན་གྱི།",
    "རང་གི་བདག་ཉིད་ཀྱིས་གྲུབ་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་དེའི་ཡོད་དང་།",
    "ཅི་ལྟ་བ་དེ་ལྟ་བུའི་རང་བཞིན་དུ་རང་གི་ངོ་བོས་འགྱུར་བའི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཅི་ལྟར་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱིས་དངོས་པོ་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པར་བརྟགས་པ་ཡིན་གྱི།",
    "ཞེས་བྱ་བ་ནི་གཏི་མུག་གི་སྟོབས་ཀྱིས་ཡོན་ཏན་གསུམ་ལ་སོགས་པ་བརྟགས་པ་གང་ཡིན་པའོ།",
    "གནག་རྫི་དང་བུད་མེད་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲས་ནི་བྱིས་པ་ལ་སོགས་པ་བསྡུ་བར་བྱའོ།",
    "ཕྱིར་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་འཕགས་པ་དང་།",
    "འདིར་ཞེས་བྱ་བ་ནི་ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པའི་རྣམ་གཞག་གི་སྐབས་སུའོ།",
    "འཕགས་པ་རྣམས་ཀྱིས་གཟིགས་པ་ཁས་བླངས་ནས་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འཕགས་པ་རྣམས་ཀྱིས་གཞན་ལས་སྐྱེ་བ་བདེན་པ་ཉིད་དུ་མ་གཟིགས་པའི་ཕྱིར་རོ།",
    "གཏི་མུག་གི་སྟོབས་ཀྱིས་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་དང་བྲལ་བའི་དེ་ཁོ་ན་ཉིད་མི་སྣང་བ་དང་།",
    "དེས་བྱ་བ་ནི་གཏི་མུག་གི་རང་བཞིན་ཅན་གྱི་ཀུན་རྫོབ་ཀྱིས་སོ།",
    "དེ་བཞིན་དུ་སྣང་བ་དང་བཅས་པའི་སྤྱོད་ཡུལ་ཅན་གྱི་འཕགས་པ་རྣམས་ལ་ཤེས་བྱའི་སྒྲིབ་པའི་མཚན་ཉིད་ཅན་གྱི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་གཏི་མུག་གི་ཕུང་པོ་ལ་སོགས་པ་གང་སྣང་བ་དེ་ཀུན་རྫོབ་ཡིན་ནོ་ཞེས་ཐུབ་པས་གསུངས་ཀྱི།",
    "ཀུན་རྫོབ་ཙམ་མོ།",
    "དངོས་པོ་ནི་རང་གི་ངོ་བོ་ཡོད་པ་མ་ཡིན་པ་སྒྲོ་འདོགས་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི།",
    "སྡུག་བསྔལ་བ་ལ་སོགས་པ་དངོས་པོའི་རང་གི་ངོ་བོ་ཡོད་པ་མ་ཡིན་པ་སྒྲོ་འདོགས་པར་བྱེད་པའོ།",
    "ཀུན་རྫོབ་དེས་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་གཏི་མུག་གིས་ཞེས་པའོ།",
    "འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཞེས་བྱ་བ་ནི་མ་རིག་པའི་ལིང་ཐོག་གིས་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཞེས་པའོ།",
    "ཀུན་རྫོབ་ཏུ་བདེན་པས་ཞེས་བྱ་བ་ནི་གཏི་མུག་གི་བདེན་པ་ཡིན་གྱི།",
    "མ་རིག་པ་དང་ལྡན་པ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཅན་དང་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་གཏི་མུག་དང་ལྡན་པ་རྣམས་ལའོ།",
    "གཏི་མུག་གི་སྟོབས་ཀྱིས་མི་སྣང་བའི་ཕྱིར་རོ།",
    "སྲིད་པའི་ཡན་ལག་གིས་ཡོངས་སུ་བསྡུས་པ་ཞེས་བྱ་བ་ནི་མ་རིག་པའི་རྐྱེན་གྱིས་འདུ་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒོ་ནས་སྲིད་པའི་ཡན་ལག་བཅུ་གཉིས་གང་བརྗོད་པ་དེ་ནི་མ་རིག་པའི་ནང་ནས་ཉོན་མོངས་པ་ཅན་གྱི་མ་རིག་པ་སྲིད་པའི་ཡན་ལག་ཏུ་གང་གསུངས་པ་དེའི་སྒོ་ནས་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་རྣམ་གཞག་བྱས་ནས།",
    "དེའི་སྒྲིབ་པ་ནི་གང་གིས་དེ་མི་སྣང་བར་བྱེད་པའོ།",
    "ཉོན་མོངས་པ་ཅན་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "བདེན་པར་ཞེན་པ་མེད་པ་ཉིད་ཀྱིས་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་སྐྱེད་པར་མི་བྱེད་པས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པར་མ་རིག་པའོ།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མ་རིག་པ་ནི་གཟུགས་ལ་སོགས་པ་སྣང་བའི་རྒྱུ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སོ་སོ་རང་གིས་རིག་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་དམིགས་པ་མེད་པའི་སྒོ་ནས་སོ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་བརྗོད་ནས་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པའི་གཏི་མུག་གི་སྟོབས་ཀྱིས་བདེན་པ་གཉིས་སུ་བརྗོད་ནས་སོ།",
    "རང་གིས་མྱོང་བ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པ་རང་གིས་ཉམས་སུ་མྱོང་བའི་དཔེའི་སྒོ་ནས་སོ།",
    "བདག་ཉིད་གང་གིས་ཞེས་བྱ་བ་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་བྲལ་བའི་བདག་ཉིད་ཀྱིས་སོ།",
    "སྐྲ་ཤད་དང་སྐྲ་ཤད་མ་ཡིན་པ་དང་ཞེས་བྱ་བ་ནི་བྱེ་བྲག་གི་རྣམ་པར་རྟོག་པའོ།",
    "རབ་རིབ་མེད་པ་རང་བཞིན་ཉིད་ཀྱི་སྐྲ་ཤད་ལ་སོགས་པ་མི་དམིགས་པའི་ཕྱིར་རབ་རིབ་ཅན་གྱི་རྗེས་སུ་འབྲངས་ནས་དེའི་རྣམ་པར་རྟོག་པ་བསལ་བའི་ཆེད་དུ་རབ་རིབ་མེད་པ་འདི་ལ་སྐྲ་ཤད་དག་ཡོད་པ་མ་ཡིན་པས་འདི་ན་སྐྲ་ཤད་ལ་སོགས་པ་དག་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་དགག་པ་ལྷུར་བྱེད་པའི་ཚིག་གི་ཐ་སྙད་དག་བརྗོད་པ་ཡིན་པས་སོ།",
    "སྐྲ་ཤད་དག་གི་དེ་ཁོ་ན་ཉིད་ཅེས་བྱ་བ་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་།",
    "དེ་ཁོ་ན་ཉིད་མ་མཐོང་བ་དག་གིས་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་མ་མཐོང་བའི་ཕྱིར་དངོས་པོའི་རང་བཞིན་ཕྱིན་ཅི་ལོག་ཏུ་སྒྲོ་འདོགས་པའོ།",
    "དེ་བཞིན་དུ་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་ཁམས་དྲུག་དང་།",
    "དེ་ལ་ཁམས་ཀྱི་རྣམ་གཞག་བྱས་པའི་སྐབས་སུ་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་ཁམས་དྲུག་དང་།",
    "ཡིད་ཀྱི་ཁམས་ཏེ་བདུན་གང་བསྟན་པ་དེ་སྐྱེད་མཆེད་ཀྱི་རྣམ་གཞག་བྱེད་པའི་གནས་སྐབས་སུ་ཡིད་ཀྱི་སྐྱེ་མཆེད་ཀྱིས་བསྡུས་པའི་ཕྱིར་མིག་གི་རྣམ་པར་ཤེས་པའི་ཁམས་ལ་སོགས་པ་རྣམས་སྐྱེ་མཆེད་ཀྱི་ནང་དུ་མི་འདུས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་དག་གི་ཞེས་བྱ་བ་ནི་དངོས་པོ་རྣམས་ཀྱིའོ།",
    "ངོ་བོ་ཀུན་རྫོབ་པའི་ཞེས་བྱ་བ་ནི་གཏི་མུག་གི་སྟོབས་ཀྱིས་བྱུང་བ་གང་ཡིན་པའོ།",
    "རང་བཞིན་གང་གིས་བྱ་བ་ནི་ཕུང་པོ་དང་།",
    "མ་རིག་པའི་བག་ཆགས་དང་བྲལ་བ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཅན་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་བག་ཆགས་མེད་པའི་ཕྱིར་རོ།",
    "དེ་དག་གི་ཞེས་བྱ་བ་ནི་དངོས་པོ་རྣམས་ཀྱིའོ།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་རྣམས་ཀྱིས་ཕུང་པོ་ལ་སོགས་པ་འདི་རྣམས་ནི་འགའ་ཞིག་ཀྱང་ཡོད་པ་མ་ཡིན་པའོ་ཞེས་གསུངས་པ་དེའི་ཚེ།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མ་རིག་པས་ཕུང་པོ་ལ་སོགས་པ་སྣང་བའི་འཁྲུལ་པ་ཡོད་པས་སོ།",
    "གང་གི་ཚེ་ཉོན་མོངས་པ་ཅན་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མ་རིག་པ་རྣམ་པ་ཐམས་ཅད་དུ་ལོག་པས་ཕུང་པོ་ལ་སོགས་པ་རྣམ་པ་ཐམས་ཅད་དུ་མི་སྣང་བ་དེའི་ཚེ་ཕུང་པོ་ལ་སོགས་པ་དེ་རྣམས་ཀྱི་རང་བཞིན་རྟོགས་པ་ཡིན་ཏེ།",
    "བདེན་མོད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུས་དང་ངག་དང་ཡིད་ཀྱི་ཡུལ་གྱི་རང་བཞིན་དུ་འགྱུར་ན་ཞེས་བྱ་བ་ནི་ལུས་ཀྱིས་རེག་པར་བྱ་བ་ཉིད་དང་།",
    "ངག་གིས་བརྗོད་པར་བྱ་བ་ཉིད་དང་།",
    "སྒྲ་དང་རྣམ་པར་རྟོག་པ་དག་གི་སྤྱོད་ཡུལ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་གི་སྟོན་པ་དང་ཞེས་བྱ་བ་ནི་སྟོན་པའོ།",
    "ཅི་སྟོན་པ་དང་ཞེས་བྱ་བ་ནི་སྒྲ་དང་རྣམ་པར་རྟོག་པ་དག་གི་ཡུལ་གང་ཡིན་པའོ།",
    "སྟོང་པ་དང་ཞེས་བྱ་བ་ནི་བདག་གི་བ་དང་བྲལ་བས་སོ་ མི་སྟོང་པ་དང་ཞེས་བྱ་བ་ནི་བདག་གི་བ་ཉིད་ཀྱིས་སོ།",
    "དེ་རང་གི་ངོ་བོ་མ་དམིགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རིགས་པའི་སྒོ་ནས་དངོས་པོ་མེད་པ་དག་མི་འཐད་པའི་ཕྱིར་དེའི་རང་གི་ངོ་བོ་མ་དམིགས་པའི་ཕྱིར་རོ།",
    "ཡོད་པ་དང་མེད་པ་ཉིད་ལ་སོགས་པའི་ཕྱིན་ཅི་ལོག་གི་དངོས་པོར་སྒྲོ་བཏགས་པ་ལ་བླུན་པོ་ཞེས་བྱ་ལ།",
    "གང་གི་ཡུལ་ཅན་གྱི་ཞེས་བྱ་བ་ནི་དངོས་པོའི་རང་བཞིན་ཅན་གྱི་ཡུལ་ཅན་ནོ།",
    "དཔེར་བྱས་ནས་གང་གི་ཚེ་སད་པའི་གནས་སྐབས་ཀྱི་བུམ་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་སུན་འབྱིན་པར་བྱེད་པ་དེའི་ཚེ་འཇིག་རྟེན་གྱིས་གནོད་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་སད་པའི་གནས་སྐབས་ན་མཐོང་བའི་བུམ་པ་འཇིག་རྟེན་གྱིས་བདེན་པ་ཉིད་དུ་རྟོགས་ལ།",
    "གང་གི་ཚེ་འཕགས་པའི་གཟིགས་པ་ལ་གནས་ཏེ་ཞེས་བྱ་བ་ནི་འཕགས་པའི་གཟིགས་པ་ཁས་ལེན་ན་སྟེ།",
    "འཕགས་པའི་གཟིགས་པ་ལ་ལྟོས་ནས་སོ་ཞེས་བྱ་བ་ཐ་ཚིག་གོ།",
    "གཞན་ཡང་དཔྱད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རང་གི་བདག་ཉིད་མི་མཐོང་བ་དེས་གཞན་ཡང་མི་མཐོང་སྟེ།",
    "དཔེར་ན་བུམ་པ་བཞིན་མིག་གིས་ཀྱང་གཟུགས་མི་མཐོང་བ་སྟེ།",
    "རང་གི་བདག་ཉིད་མི་མཐོང་བའི་ཕྱིར་རོ།",
    "དེ་ལ་གཞན་དག་ན་རེ་མིག་གིས་གཞན་མཐོང་བར་འཇིག་རྟེན་ལ་གྲགས་པའི་ཕྱིར་འཇིག་རྟེན་ལ་གྲགས་པའི་གཞན་མཐོང་བས་མིག་གིས་གཞན་མཐོང་བ་འགེགས་པ་དེ་སེལ་བར་བྱེད་པ་ཡིན་ནོ་ཟེར་ན།",
    "གང་མིག་གིས་གཞན་མཐོང་བའི་འགོག་པ་དེ་ནི་འཕགས་པ་རྣམས་ཀྱི་གཟིགས་པ་ལ་ལྟོས་ནས་ཡིན་ལ།",
    "ས་བོན་ཙམ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ནུར་ནུར་པོ་ལ་སོགས་པ་སྐྱེད་པར་བྱེད་པའི་མི་གཙང་བ་ཙམ་མོ།",
    "བདག་གིས་བུ་འདི་བསྐྱེད་ཅེས་སྨྲ་བྱེད་ཅིང་།",
    "དེ་བཞིན་དུ་ཨ་མྲ་ལ་སོགས་པའི་ས་བོན་ཙམ་བཙུགས་ནས་ཨ་མྲ་སྐྱེས་པ་ན་ཨ་མྲ་གང་གིས་བཙུགས་པ་ཡིན་ཞེས་བརྗོད་པའོ།",
    "གང་གི་ཕྱིར་མི་གཙང་བ་དང་།",
    "ཨ་མྲའི་རྒྱུ་དང་།",
    "གཞན་ལས་སྐྱེ་བ་འཇིག་རྟེན་ལས་ཀྱང་མེད་དོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་འཇིག་རྟེན་པས་སྐྱེད་པར་བྱེད་པ་དང་བསྐྱེད་པར་བྱ་བ་དག་གཅིག་ཉིད་དུ་ངེས་པ་དེའི་ཕྱིར་འཇིག་རྟེན་པའི་སྒོ་ནས་གཞན་ལས་སྐྱེ་བ་གྲུབ་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "གཞན་ཉིད་ཡིན་ན་ནི་གང་ཟག་གཞན་ལྟར་དེ་ཡང་ཉེ་བར་སྟོན་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་འཇིག་རྟེན་པས་ས་བོན་དང་མྱུ་གུ་དག་གཞན་ཉིད་དུ་རྟོགས་པར་འགྱུར་ན་ནི་ཅི་ལྟར་ས་བོན་དེ་ལ་རང་གི་བུ་གཞན་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་རང་གི་བུ་ལས་གང་ཟག་གཞན་ཡང་རང་གི་ས་བོན་ལས་གཞན་ཡིན་ལ།",
    "ཉིད་ཡིན་དུ་ཟིན་ཀྱང་ཅི་ལྟར་གང་ཟག་གཞན་རང་གི་བུ་ཉིད་དུ་མི་སྟོན་པ་དེ་བཞིན་དུ་གཞན་ཉིད་ཁྱད་པར་མེད་པའི་ཕྱིར་རང་གི་བུ་ཡང་བུ་འདི་ཕས་བསྐྱེད་པ་ཡིན་ནོ་ཞེས་སྟོན་པར་བྱེད་པར་མི་འགྱུར་བའོ།",
    "འོན་ཀྱང་དེའི་ས་བོན་ཙམ་མོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "དེ་ཉིད་རེ་ཞིག་དེ་ཉིད་མིན།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་དག་གཅིག་ཉིད་དུ་ཐལ་བར་འགྱུར་ལ།",
    "དེ་ལྟར་ན་ས་བོན་རྟག་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དེས་ན་སྐྱོན་ཆེན་པོ་རྟག་པར་ཐལ་བར་འགྱུར་བ་དང་།",
    "ལས་ཀྱི་འབྲས་བུ་ལ་སོགས་པ་མེད་པར་ཐལ་བར་འགྱུར་ལ།",
    "དེ་ལྟར་རེ་ཞིག་ས་བོན་གང་ཡིན་པ་དེ་ཉིད་མྱུ་གུ་ཡིན་པར་རིགས་པའོ།",
    "གང་གི་ཕྱིར་རྒྱུ་གང་ལ་བརྟེན་ནས་འབྲས་བུ་གང་སྐྱེ་བའི་རྒྱུ་ཉིད་འབྲས་བུ་མ་ཡིན་པ་དང་།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་བརྟེན་གྱུར་ན།",
    "ཅི་ལྟར་སྐྱེས་པའི་རང་བཞིན་ལ་སྐུར་པ་བཏབ་པས་སྟོང་པ་ཉིད་རྟོགས་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་དངོས་པོ་རང་གི་རྒྱུ་ལས་སྐྱེས་པ་ལ་སྟོང་པ་ཉིད་དུ་མཐོང་བས་སྐུར་པ་སྟོང་པ་ཉིད་དུ་བཏབ་པའི་སྒོ་ནས་སྟོང་པ་ཉིད་དུ་རྟོགས་པར་འགྱུར་བའོ་ཞེས་པའོ།",
    "སྟོང་པ་ཉིད་དུ་མཐོང་བ་ལོག་པའི་ཤེས་པར་ཐལ་བར་འགྱུར་བས་སོ།",
    "དུས་ཐམས་ཅད་དུ་གྲོལ་བར་ཐལ་བར་འགྱུར་བ་དང་།",
    "སྟོང་པ་ཉིད་དངོས་པོ་ཉིད་དུ་ཐལ་བ་དང་།",
    "མི་རྟག་པ་ཉིད་མངོན་སུམ་གྱིས་གྲུབ་པར་ཐལ་བར་འགྱུར་རོ།",
    "བཞི་བརྒྱ་པ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་མྱ་ངན་ལས་འདས་པ་ལ་བདག་གིར་གྱུར་ཅིག་སྙམ་ནས་སྟོང་པ་ཉིད་མ་ཡིན་པའི་དངོས་པོ་སྟོང་པ་དང་ལྡན་པར་མཐོང་བ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་མཚན་མོ་དགེ་ཚུལ་བཏུང་བར་བྱ་བ་མ་ཡིན་པའི་དོན་དུ་མི་གོ་བ་བཞིན་དུ་སྟེ།",
    "དགེ་ཚུལ་འགའ་ཞིག་སློབ་དཔོན་གྱིས་མཚན་མོ་བཏུང་བར་བྱ་བ་མ་ཡིན་པའི་དོན་དུ་ཡང་དང་ཡང་དུ་མངགས་པ་དང་།",
    "དེས་དེ་ལ་འདི་དགེ་སློང་རྣམས་ལ་མི་འོས་པས་ཁྱོད་ཅི་ལྟར་གསོལ་ཞེས་སྨྲས་པ་དང་།",
    "དེས་སྨྲས་པ་ཅིའི་ཕྱིར་ཁྱོད་ཀྱིས་གཞན་ཉིད་ཁྱེར་ཏེ་འོངས།",
    "གང་གི་ཚེ་ཁྱེད་ཀྱིས་ཆུ་ཡིན་ནོ་སྙམ་དུ་བསམས་ནས་གསོལ་ན་དེ་དག་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "ཅི་ལྟར་འདིར་ཆུའི་སྒོ་ནས་ཆང་གི་སྲེད་པ་མི་ལྡོག་པ་དེ་བཞིན་དུ་ལོག་པར་ལྟ་བས་ཀྱང་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་མི་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་དག་ཁྱོད་ཅི་ཡང་མ་ཡིན་པ་ཞིག་རིན་དུ་སྦྱིན་ནོ་ཞེས་བརྗོད་པ་ན་ཅི་ཡང་མ་ཡིན་པ་ནི་དེ་ཁོ་བོ་ལ་བྱིན་ཅིག་ཅེས་བརྗོད་པར་གྱུར་ན་དེ་ལ་ཐབས་གང་གི་སྒོ་ནས་ཅི་ཡང་མ་ཡིན་པའི་དངོས་པོ་རིན་དུ་སྦྱིན་པར་ནུས།",
    "གཞན་དག་གིས་སྨྲས་པ་ནི་དོན་དམ་པར་བདག་དང་གཞན་ལས་སྐྱེ་བ་མེད་པར་འདོད་པ་ཉིད་དོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གིས་དམིགས་པ་ཞེས་བྱ་བ་ནི་དེ་ལ་དངོས་སུ་ཤེས་པ་སྐྱེད་པར་རུང་བ་རྣམས་ནི་མངོན་སུམ་གྱིས་དམིགས་པ་ཡིན་ལ།",
    "དངོས་སུ་ཤེས་པ་སྐྱེད་པར་རུང་བ་མ་ཡིན་པ་གཞན་གྱི་སྒོ་ནས་རྟོགས་པར་བྱ་བ་རྣམས་ནི་རྗེས་དཔག་གིས་དམིགས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་བདེན་པ་གཅིག་ཁོ་ན་མ་ཡིན་པ་དེའི་ཕྱིར་གཞན་ལས་སྐྱེ་བ་ཡོད་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཕྱོགས་སྔ་མའོ།",
    "འདི་ནི་བདེན་མོད་ཀྱི་ཞེས་བྱ་བ་ནི་བདེན་པ་གཉིས་ཅི་སྟེ་བརྗོད་ཅེས་བྱ་བ་དེའོ།",
    "གང་གི་ཕྱིར་དངོས་པོ་སྟེ་གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་རྣམས་དཔྱད་ན་སྟེ།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་འདི་ལྟར་ཀླ་ཀློ་རྣམས་ཀྱིས་སྐད་གཞན་མི་གོ་བས་རང་གི་སྐད་ཀྱིས་སྟོན་པར་བྱེད་པ་དེ་བཞིན་དུ་འཇིག་རྟེན་པ་ལ་ཡང་འཇིག་རྟེན་པའི་དངོས་པོའི་རྣམ་པར་གཞག་པའི་སྒོ་ནས་དེ་ཁོ་ན་ཉིད་བསྟན་པར་ནུས་ཀྱི།",
    "ཞེས་བྱ་བ་ནི་རྒྱུད་གསུམ་པ་ལ་སོགས་པས་རོལ་མོའི་ཆ་རྐྱེན་ལས་སོ།",
    "མཁས་པ་ལས་ཞེས་བྱ་བ་ནི་བློ་དང་ལྡན་པ་འགའ་ཞིག་གིས་སོ།",
    "གང་ནས་འོངས་ལ་གར་སོང་ཞེས་བྱ་བ་ནི་ཕྱོགས་དང་ཕྱོགས་མཚམས་གང་ནས་འོངས་ཤིང་ཕྱོགས་དང་ཕྱོགས་མཚམས་གར་སོང་སྙམ་དུ་བརྟགས་ནས་སོ།",
    "ཞེས་བྱ་བ་ནི་གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་རྣམས་སྐྱེ་བའོ།",
    "ནང་ཡང་སྟོང་ལ་ཞེས་བྱ་བ་ནི་མིག་ལ་སོགས་པ་ནང་གི་བདག་ཉིད་ཅན་རྣམས་སྟོང་པ་སྟེ།",
    "གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་དཔེར་ན་སེམས་ཙམ་པ་རྣམས་ཀྱིས་ཇི་ལྟར་རྫ་ས་སུ་ཡོད་པའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་འདོད་པའི་རྣམ་པར་ཤེས་པ་དེ་ཉིད་ལ་གཟུང་བ་དང་འཛིན་པར་ཞེན་པ་ཡོད་ན་ཀུན་ནས་ཉོན་མོངས་པ་ཡིན་ལ།",
    "རིགས་པ་གང་ཞིག་གིས།",
    "དེའི་ཕྱིར་རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བས་བདེན་པ་གཉིས་ཀར་དུ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་བདག་དང་གཞན་ལས་སྐྱེ་བ་མ་གྲུབ་པ་དེའི་ཕྱིར་དངོས་པོའི་རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་ནི་བདེན་པ་གཉིས་ཀར་ལ་ཡང་འགྲུབ་པ་མ་ཡིན་ནོ།",
    "དེ་དག་གིས་ཞེས་བྱ་བ་ནི་བརྟགས་པ་ལ་སྐྱེ་བ་མེད་པར་སྨྲས་པ་དག་གོ།",
    "ད་ནི་གཞན་དག་གི་དོགས་པ་བསུ་བའི་ཕྱིར།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པ་རྣམས་ལ་སྐྱེ་བ་མེད་པས་ངོ་བོ་མི་དམིགས་པ་བཞིན་ནོ།",
    "དེས་ན་དམིགས་པ་ཙམ་ལས་རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་མི་འཐད་པས་སོ།",
    "གལ་ཏེ་སྐྱེ་བ་མེད་པ་རྣམས་ཀྱང་སྣང་བར་འགྱུར་ན་རི་བོང་གི་རྭ་ལ་སོགས་པ་རྣམས་ཅིའི་ཕྱིར་མི་སྣང་ཞེ་ན།",
    "འདི་ནི་ཁྱོད་ལ་ཡང་མཚུངས་ཏེ།",
    "ཅི་ལྟར་གཟུགས་བརྙན་ལ་སོགས་པ་རྣམས་རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་མེད་ཀྱང་སྣང་ལ།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པ་རྣམས་ཅིའི་ཕྱིར་མི་སྣང་།",
    "ཁྱོད་ཀྱིས་ལན་ཅི་ལྟར་བརྗོད་པ་དེ་བཞིན་དུ་ཁོ་བོས་ཀྱང་བརྗོད་པར་བྱ་བ་ཡིན་པས་སྐྱོན་ཅི་ཞིག་ཡོད་ཅེས་པའོ།",
    "ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་རྣམས་ལ་ལོག་པར་ཞུགས་པ་བསལ་བའི་དོན་དུ་རབ་རིབ་མེད་པར་རྗོད་པར་བྱེད་པ་བཞིན་དུ་ཁོ་བོ་ཅག་གིས་དངོས་པོ་ཐམས་ཅད་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་བ་ཡིན་པས་ཁོ་བོ་ཅག་དེ་ལྟར་བརྗོད་པ་ལ་ཆད་པར་ལྟ་བར་འགྱུར་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "མེད་པ་ཉིད་ཀྱི་ལྟ་བར་ཐལ་བར་མི་འགྱུར་གྱི།",
    "གང་གི་ཕྱིར་ཡོངས་སུ་བརྟག་པར་བྱ་བའི་དངོས་པོ་དེ་རྟག་པར་འགྱུར་བ་ཞིག་གམ།",
    "ཉོན་མོངས་ལས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ཉོན་མོངས་པ་ནི་འདོད་ཆགས་ལ་སོགས་པ་སྟེ།",
    "གང་གི་ཚེ་བུ་ལོན་གྱི་ཡི་གེས་ནོར་ཁུགས་ཏེ་ལོངས་སྤྱད་ནས་ཕྱིས་ཡོད་དམ་མེད་ཀྱང་རུང་ནོར་འོང་བའི་ནུས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར་གང་གི་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཞེས་བྱ་བ་ནི་ལས་ཀྱི་རང་བཞིན་འགག་པར་སྨྲ་བ་རྣམས་སོ།",
    "གང་གི་ཕྱིར་རང་བཞིན་མེད་པའི་ཕྱིར་སྐྱེ་བ་མེད་པའོ།",
    "ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་དགོངས་པ་ཡིན་པའི་ཕྱིར་ཁྱོད་དེ་སྐད་ཟེར་བས་ཁོ་བོ་ཅག་ལ་གནོད་པ་ནི་མ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་རྟག་པཔ་ཞེས་བྱ་བ་ནི་ཡོད་པར་འགྱུར་བ་ཡིན་ལ།",
    "ཁྱོད་ཀྱི་ཕྱོགས་ལ་ཡང་མ་སྐྱེས་པ་ཉིད་ཀྱིས་འབྲས་བུ་འབྱིན་ན་མ་བྱས་པས་མྱོང་བར་ཅིའི་ཕྱིར་མི་འགྱུར་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཁོ་བོས་འཇིག་རྟེན་གྱི་ཐ་སྙད་དུ་ལས་གང་བྱས་ནས་འཇིག་པར་འགྱུར་བ་དེ་ལ་རྣམ་པར་དཔྱད་ན་སྐྱེ་བ་དང་འཇིག་པ་མེད་པས་དེ་ལ་འབྲས་བུ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ཡིན་གྱི།",
    "ཡུལ་གྱི་བུད་མེད་བཟང་མོ་ཞེས་བྱ་བ་ནི་ཡུལ་ན་ཡོད་པ་རྣམས་ཀྱི་ནང་ན་མཛེས་པའོ།",
    "འཆི་དུས་དང་ཚོད་ཉེ་བར་གནས་པའི་ཚེ་ཞེས་བྱ་བ་ནི་འཆི་ཁ་ནའོ།"
  ]
}