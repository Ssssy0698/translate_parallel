    "༡ པ་གཉིས་ལ་འཆན་ལུང་ཁྲི་བཞུགས་༥༨ ནང་ཏུང་རྩེ་ཞེས་པའི་དེབ་བཟོས་ལུགས་དང་།",
    "བོད་གཞུང་སྐུ་ཚབ་ནས་ཤིང་སྟག་ཟླ་ཚེས་པ་ཕུལ། ། རྒྱ་ཕྱོགས་ནས་ཆིངས་ཟིན་ལ་བཅོས་བསྒྱུར་དགོས་རྒྱུའི་ཡི་གེ་ཕུལ་གཤིས་རང་ཕྱོགས་ནས་ཀྱང་བསྐྱར་བཅོས་གནང་ལོས་འབེལ་བརྒྱུད་ཕྱག་བྲིས་འབུལ་གནང་བའི་ཚིག་གཞིར།",
    "ཁ་ཆ་ཚོ་རིགས་ནས་རྒྱ་རྡོད་སུམ་སྟོང་བརྒྱ་དང་ལྔ་བཅུ་ང་དྲུག་སྲང་བཅོ་བརྒྱད་དང་ཞོ་ལྔ་བཅས་རྒྱ་གཞུང་ནས་ཕྱིར་སློག་དགོས་རྒྱུ་ཞེས་ཕེབས་བྱུང་བར་དགོངས་འཇོག་ཡོད་པ་ཞུ།",
    "ལོ་པཎ་གྱི་ཚུལ་དུ་སྐུ་ཕྲེང་རིམ་པར་བྱོན་པའི་༧རྒྱལ་ཁབ་རང་བཙན་ཡིན་ཞིང་།",
    "སྐུ་ཕྲེང་ལྔ་པ་ཆེན་པོའི་སྐབས་༧གོང་མ་ཤུན་ཙི་རྒྱལ་པོ་གསེར་ཁྲིར་ཕེབས་རྒྱུ་ཐུགས་ཀྱིས་མཁྱེན་ཏེ།",
    "༧རྒྱལ་པོ་ཐུགས་ཤིན་ཏུ་དགྱེས་ཏེ་མི་སྣ་ཕྱིར་ལོག་གདོང་གནང་རྟེན་བསམ་གྱིས་མི་ཁྱབ་པ་དང་།",
    "སླད་ནས་ངོས་ཀྱི་མི་རབས་རིམ་པར་བྱོན་པ་རྣམས་དང་།",
    "པཎ་ཆེན་ཨེ་ཏེ་ནི་བཅས་མཆོད་ཡོད་འབྲེལ་བ་ནས་ཟམ་མི་ཆད་པ་བྱེད་ཅེས་བཀའ་བཟང་ཕེབས།",
    "གསེར་གྱི་འཇའ་ས་སྤོང་ལེབ་བཅུ་ལྔ་བརྩེགས་འབུལ་གནང་སོགས་ཕན་ཚུན་དགྱེས་དགུའི་གཟེངས་བསྟོད་བླ་ན་མ་མཆིས་པ་བསྐྱངས་ཤིང་།",
    "བོད་ཀྱི་ལོ་པཎ་རྣམས་བར་དུ་བཞུགས་ཏེ་ཆིངས་སྒྲིག་མཛད་པའི་ཕན་ཚུན་མཐུན་པར་བྱུང་།",
    "རྒྱའི་གུ་གུ་རྨེ་རུར་རྡོ་རིང་བཙུགས་ཏེ་རྒྱ་བོད་ས་མཚམས་སུ་བཅད་ནས་ཕན་ཚུན་གཉིས་ཀའི་ས་མཚམས་ལས་ཕྱི་རོལ་དུ་བསྒྲལ་བའི་དམག་མི་གཡུལ་གཤམས་པ་སོགས་མི་བྱེད་པའི་དཔང་དུ་ལྷ་ཀླུ་གཉན་པོ་བཞག་སྟེ་མནའ་བོར་བའི་ཡིིག་གེ་ལྷ་ས་དང་།",
    "༧གོང་མའི་དཔུང་དམག་སྔ་ཕྱིར་གནང་རུང་།",
    "བོད་དཔོན་རིགས་ཆེ་བ་ཞིག་རྒྱ་གར་ཕེབས་ཚེ་མཐུན་ལམ་གྱི་རྩ་བར་འབུམ་ཉི་ཤུ་རྩ་ལྔ་ཡང་ཆག་ཡང་སྩལ་རྒྱུའི་དགོངས་བཞེད་ཡོད་ལུགས་ཕྱག་བྲིས་ཕེབས་བྱུང་རུང་།",
    "རྒྱ་གཞུང་ནས་མཆོད་ཡོན་གྱི་ལར་རྒྱར་དགོངས་ཏེ་གནང་བ་ལས།",
    "བོད་ནས་ཆིངས་དངུལ་འབུལ་སྤྲོད་མ་ཐུབ་པར་རྒྱ་གཞུང་ནས་གནང་གྲོགས་ཞེས་སྔ་ཕྱིར་གང་སར་ཞུས་རིགས་མེད།",
    "བླ་སློབ་ཀྱི་བར་དུ་དེ་ལྟ་བུའི་ཕན་ཆར་གནང་སྲོལ་ཡོང་ཞིང་།",
    "ལར་ནས་ཕན་ཚུན་དགའ་ཉེའི་བབ་ཀྱི་དངུལ་དངོས་ཕན་ཆར་གནང་རིགས་རྙོག་མ་གཏིང་སློང་གནང་ཚེ་བོད་ནས་ཀྱང་མང་པོ་ཞུ་རྒྱུ་ཡོང་གནས།",
    "རྒྱ་ཕྱོགས་ནས་གང་བྱས་ལ་ཆ་འཇོག་གནང་མ་ཡོང་ཞིང་།",
    "མཐར་ཕྱི་ལོ་༡༩༤ ལོར་ཡང་ཧ་སེ་སྦན་ཊེའི་དྲག་པོའི་དམག་དཔུང་ལྷ་སར་སླེབས་པ་དང་།",
    "ཕྱི་ལོ་༡༩༡ ལོར་ལྷ་སར་སླེབས།",
    "དེའི་ཕྱི་ལོ་༡༩༡༢ ལོར་ལྷ་སར་བཅའ་སྡོད་རྒྱ་རིགས་དང་མན་ཇུ་མི་རིགས་ནང་འཁྲུགས་བྱུང་།",
    "ས་མཚམས་སོགས་ཀྱི་ཚད་ཐིག་གཙང་མ་ཞིག་ཡོང་རྒྱུའི་ཆེད།",
    "གོ་ལྡོག་ཏུ་འགྱུར་བའི་རིགས་མ་ཡིན་པའི་ཚིག་གཞི་གང་ཡོད་ལ་ཕན་ཚུན་གྱི་དོ་བདག་གཞུང་ས་རྣམས་ནས་བརྩི་འཇོག་གནང་དགོས།",
    "བོད་ཀྱི་སའི་ཆ་ཤས་ཙམ་ཡང་བདག་བཟུང་མི་བྱེད་པ་ཁས་ལེན་བྱས།",
    "མི་སེར་ས་ཞིང་འདེབས་འཁོས་ཀྱིས་གཞིས་ཆགས་གཏན་སྡོད་མི་འཇུག་པར་ཁས་ལེན་བྱས།",
    "ཡིན་ཡང་སྐུ་སྲུང་ཐད་མི་གྲངས་གསུམ་བརྒྱ་ལས་ལྷག་པ་གཏན་ནས་བཞག་མི་ཆོག་པ་བྱས་ཡོད།",
    "རྒྱལ་ཁག་གཞན་དག་དང་ཡང་མི་འཇོག་པ་རྒྱ་བོད་གཉིས་ཀྱིས་ཁས་ལེན་བྱས་ཡོད།",
    "རྒྱལ་ཁག་དགའ་ཉེ་གཞན་དག་ལ་གནང་བའི་ཚོང་བྱུང་བདེ་ཐབས་དེ་བཞིན་དབྱིན་ཇིའི་ཚོང་ཟོག་ལ་ཡང་གནང་དགོས།",
    "ཀ་པར་ཕྱི་ལོ་ཆིག་སྟོང་བརྒྱད་བརྒྱ་དགུ་བཅུ་གོ་གསུམ་དང་།",
    "ད་ལམ་ཆིངས་ཡིག་འདི་བཞིན་དབྱིན་ཡིག་རྒྱ་ཡིག་བོད་ཡིག་རྣམས་ཡི་གེ་བསྒྱུར་སྐབས་གོ་བསྡུར་གཏན་ཏིག་བྱས་ཡོད་པ་གོ་ཕྱོགས་ལོག་གླེང་བྱུང་ན་དབྱིན་ཡིག་ཏུ་གསལ་བ་དེ་རང་ལ་སོར་གནས་བྱ་རྒྱུ།",
    "རྒྱ་ནག་བར་བོད་འབྲས་སྐོར་བཞག་པའི་ཆིངས་ཡིག་གཉིས་པར།",
    "ཕྱི་ལོ་༡༩༤ ཟླ་༩ ཚེས་༧ ཉིན་དབྱིན་བོད་བར་ལྷ་སར་བཞག་པའི་ཆིངས་ཡིག་གསུམ་པར།",
    "རྒྱ་གཞུང་བར་པི་ཅིང་ལ་བཞག་པའི་ཆིངས་ཡིག་ཚིག་འབྲུ་འདི་ལྟར་འཁོད་པའི་ཤོག་ལྷེ་སྣོན་འཇོག་བྱས་ཡོད།",
    "གཉིས་པར།",
    "སྐབས་དེར་འཇའ་མན་དང་དབྱིན་ཇི་གཉིས་ཛ་དྲག་རང་བཞིན་ལྡན་པའི་དམག་འཁྲུག་ལངས་པར།",
    "ཆིངས་ཡིག་འདི་ཉིད་རྩ་འཛིན་གནང་ན།",
    "དེའི་ཐོག་ནས་ཕྱི་ལོ་༡༩༤ལོའི་ཟླ་༩ཚེས་༧ཉིན་དབྱིན་བོད་དབར་དུ་བཞག་པའི་ལྷ་སའི་ཆིངས་ཡིག་ཡིན་ན་འདྲ།",
    "ཅེས་གསུངས་པ་ལྟར།",
    "ཅེས་གསུངས་པ་དེ་དང་།",
    "རྒྱ་གར་དུས་བབ་ལས་བཤུས་ཅེས་གསུངས་པ་གཉིས་ནང་དོན་གྱི་རྩ་བའི་ཁ་ཕྱོགས་ཧ་ལམ་གཅིག་མཚུངས་ཡིན།",
    "ཕྱི་ལོ་དུས་རབས་༡༥ནས་༡༦དབར་པོར་ཅུ་གྷལ་དང་སི་པན་གཉིས་ཡོ་རོབ་ནང་དངོས་རིག་གསར་རྙེད་རྟོག་དཔྱོད་ཐད་གྲུབ་འབྲས་འབུར་དུ་ཐོན་པའི་རྒྱལ་ཁབ་གཉིས་ཆགས་པར་བརྟེན།",
    "མཆོག་ལ་དབྱིན་ཇི་དང་བར་འདུམ་གནང་རྒྱུའི་ཞུ་ཡིག་ཕུལ།",
    "བོད་ཀྱི་གནས་བབས་ཤོག་གྲངས་༤པར་གསལ།",
    "ཕྱི་ལོ་༡༧༧༤ ལོའི་ཟླ་༥ པར་ཇོར་ཆི་བྷོ་གྷལ་དང་དེའི་ལས་རོགས་ཨེ་ལེག་ཛན་སྒྲེར་ཧེ་མིལ་ཁྲོན་གཉིས་ཀ་ལི་ཀ་ཏ་ནས་འབྲུག་བརྒྱུད་བོད་དུ་མངགས་ཤིང་ལོ་དེའི་ཟླ་༡༢ནང་བོད་དུ་འབྱོར།",
    "ཕྱི་ལོ་༡༨༨༡ལོར་ཡང་བསྐྱར་གཞིས་རྩེ་ནས་ལྷ་སར་ཐོན་པས་༡༨༨༢ལོར་ལྷ་སར་འབྱོར་ཏེ་གོང་ས་མཆོག་མཇལ་ཁ་ཐོབ།",
    "ཕྱི་ལོ་༡༩༣ལོའི་ཟླ་༧པར་ཡང་ཧ་སི་སྦན་དང་ཝེའི་ཀྲི།",
    "སུམ་བརྒྱ་ལྷག་རྨས་ཡོད་པར་བཤད།",
    "དབྱིན་དམག་ལྷ་སར་མ་ལྷགས་པའི་ཉིན་བཞིའི་གོང་སྟེ།",
    "ཕྱི་ལོ་༡༩༤ལོའི་ཟླ་༩ཚེས་༧ཉིན་སྐུ་ཚབ་སོ་སོའི་མིང་རྟགས་དང་ཐམ་ཀ་ཕབ་སྟེ་ལྷ་སའི་ཆིངས་ཡིག་བཞག་ཅིང་།",
    "ཅེས་གསུངས་པ་ལྟར།",
    "མ་གཞི་ཡང་ཧ་སི་སྦན་གྱི་དྲག་པོའི་དོན་གཅོད་དང་ལྷ་སའི་ཆིངས་ཡིག་བཞག་པ་དེས།",
    "རྙོག་གྲ་དེའི་རྒྱུན་གྱི་མཐའ་མ་ཕྱི་ལོ་༡༩༡༣ནས་༡༤བར་དུ་བཞག་པའི་སིམ་ལའི་ཆིངས་ཡིག་ལ་གཏུགས་དགོས་པར་གྱུར།",
    "དུས་ཕྱིས་ཕྱི་ལོ་༡༩༤ལོར་གོང་ས་མཆོག་སོག་པོ་ཨུར་སྒར་ཕེབས་སྐབས།",
    "ལྷག་པར་གོང་ས་མཆོག་སོག་ཡུལ་དུ་བཞུགས་རིང་མཇལ་ཁ་བ་ཧ་ཅང་མང་པོ་ཡོད་པའི་ནང་ནས་རུ་སུའི་དཔོན་རིགས་ཀྱང་ཡོད་པ་སྟེ།",
    "སྲིད་འབྱོར་འཕེལ་ཐབས་ཀྱི་རོགས་རམ་གནང་མུས།",
    "ཅེས་གསུངས་པ་ལྟར།",
    "ལྷག་པར་དུ་ཕྱི་ལོ་༡༩༤ལོའི་ལྷ་སའི་ཆིངས་ཡིག་འཇོག་སྐབས་སུ།",
    "ཕྱི་ལོ་༡༩༤ལོའི་ཟླ་༧ཚེས་༣ཉིན་གོང་ས་མཆོག་ཉེན་བྱོལ་ཏུ་ཕེབས་དགོས་བྱུང་བར་བརྟེན།",
    "དོན་རྐྱེན་དེའི་ཞིབ་གཅོད་ཡིན་ཚུལ་གྱིས་ཀྲའོ་ཨེར་ཧྤེང་དམག་དཔུང་དང་བཅས་པ་མངགས་ཏེ་བོད་མི་རྣམས་ལ་དྲག་གནོན་ཧ་ཅང་ཆེན་པོ་བྱས་སྟབས།",
    "སྦྲ་ཡེལ་དགོན་བཅས་པར་གཏོར་བཅོམ་དང་སེར་སྐྱ་མང་དག་ཅིག་གསོད་བརྡུང་བྱས།",
    "བོད་ལ་ཕན་པ་ཅན་གྱི་རོགས་ཟླ་འཐོབ་རྒྱུར་དགོངས་ཏེ་ཕྱི་ལོ་༡༩༧ལོའི་ལོ་མཇུག་ཏུ་སྐུ་འབུམ་ནས་ཕེབས་ཐོན་གྱིས་རི་བོ་རྩེ་ལྔ་བརྒྱུད་ཕྱི་ལོ་༡༩༨ལོའི་ཟླ་༩ཚེས་༢༧ཉིན་པེ་ཅིང་དུ་ལྷགས།",
    "ལྷག་པར་ས་འདྲེས་བབ་ཀྱི་ཨུ་རུ་སུ་དང་།",
    "འཇར་མན་བཅས་ཀྱི་གཞུང་ཚབ་སོ་སོར་དངོས་དང་ཤུགས་ཀྱིས་འབྲེལ་བ་བྱེད་པར་སྐུ་ཚབ་བཏང་གནང་མཛད།",
    "དེ་ལྟར་རྒྱ་ནག་ཏུ་ཟླ་འགའི་རིང་བཞུགས་ཏེ་ཕྱི་ལོ་༡༩༨ཟླ་༡ཚེས་༢༨ཉིན་པེ་ཅིང་ནས་བོད་ཕྱོགས་སུ་རྡོག་ཕེབས་ཀྱིས་སྐུ་འབུམ་བརྒྱུད་ཕྱི་ལོ་༡༩༩ཟླ་༡༡ཚེས་༡ཉིན་ལྷ་ལྡན་དུ་ལྷགས་འབྱོར་བྱུང་།",
    "ཞེས་གསུངས་པ་ལྟར་གཏོར་བཅོམ་བསམ་ཡུལ་ལས་འདས་པ་བྱས་པ་མ་ཟད།",
    "རྒྱ་གར་དུ་འབྱོར་མཚམས་རྒྱ་ཕྱོགས་སུ་ལྕགས་འཕྲིན་ཐོག་ནས་གནས་ལུགས་སྔ་རྗེས་ཇི་ལྟར་ཞུས་ཀྱང་གནང་ཡོད་བློན་ཆེན་འགའ་ཤས་རྒྱུ་རྔན་གྱི་རྗེས་སུ་འབྲངས་ཏེ་འདི་བྱེད་གནས་ལན་སྣེ་གཅིག་མེད་མུར།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "རང་བཙན་སོག་པོའི་རྒྱལ་ཁབ་ཀྱིས་ཁས་ལེན་བྱས་པ་དང་།",
    "དེ་བཞིན་རྗེ་བཙུན་དམ་པ་ཧོ་ཐོག་ཐུ་སོག་པོ་རང་བཙན་རྒྱལ་ཁབ་ཀྱི་དབུ་ཁྲིད་གཙོ་བོ་ཡིན་པ་བོད་གཞུང་ནས་ཁས་ལེན་དང་ཆ་འཇོག་བྱས་པ་ཡིན་ཞེས་འཁོད་ཡོད།",
    "ཕྱི་ལོ་༡༩༡༣ལོར་ཤོག་དངུལ་དཔར་འགྲེམས་དང་ཡིག་སྐྱེལ་སྦྲག་ཟམ་བཙུགས་པ་མ་ཟད།"
  ]
