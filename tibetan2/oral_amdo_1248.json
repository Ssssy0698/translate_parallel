    "འོན་ཀྱང་གང་གི་རྗོད་པར་བྱེད་པ་དང་།",
    "རྣམ་པ་ཐ་དད་པར་འཛིན་པའི་ཤེས་པ་དང་སྒྲ་ཐ་དད་ཀྱང་དངོས་པོ་གཅིག་གི་ཡུལ་ཅན་ཉིང་ཡིན་པའི་ཕྱིར།",
    "གལ་ཏེ་བསྒྲུབ་པའི་ཚུལ་ལ་དངོས་པོ་ཉིད་ལ་སྒྲ་དང་རྣམ་པར་རྟོག་པ་རྣམས་ཀྱིས་ཡུལ་དུ་བྱེད་ན་དེ་ནི་འདིར་དོན་ཐམས་ཅད་ལ་ཐམས་ཅད་དུ་རྟོགས་པར་ཐལ་བར་འགྱུར་བ་དང་།",
    "དེ་ནི་དངོས་པོ་ཆ་མེད་པ་གཅིག་པོ་ཡིན་ན་ཇི་ལྟར་ན་བློ་རྣམ་པ་ཐ་དད་པ་དག་གི་ཡུལ་དུ་བྱེད་དེ།",
    "སྒྲ་དག་གིས་བདག་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་དོན་ཐ་དད་པ་བྲྗོད་པ་ན་ཇི་ལྟར་དོན་གཅིག་པ་ཅན་གྱི་བློའི་རྟེན་དུ་འགྱུར།",
    "ཐལ་འགྱུར་ཉེས་པ་དེ་དག་མེད།",
    "དེ་དག་གཅིག་ལ་འཇུག་པ་ནི་གཞན་ལ་ཤེས་པ་མི་སྐྱེ་སོ་སོར་ཉེ་བ་མེད་པར་ཤེས་པ་བསྐྱེད་ན་ཤིན་ཏུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "ཐ་དད་པའི་རང་གི་ངོ་བོ་དག་ལ་སོ་སོར་སྦྱོར་བ་ན་དེ་ལྟར་སྟོན་པ་དག་གི་རྣམ་པར་དབྱེ་བ་ཡོངས་སུ་མི་ཤེས་པའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་ན།",
    "འོན་ཀྱང་དགོས་པ་འགའ་ཞིག་གིས་སྒྲ་གང་ཞིག་ལ་དགོད་པར་བྱེད།",
    "འདི་གཞན་དང་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོར་བྲྗོད་པར་མི་ནུས་ཤིང་ཕོངས་པ་འདི་ལ་ཡང་འབྲས་བུ་ཅུང་ཞིག་དང་བཅས་པ་ཡང་མེད་དོ།",
    "གང་གིས་ནུས་པར་འགྱུར།",
    "རང་གི་ངོ་བོ་ཉིད་ལ་ཡང་གཅིག་པ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "བདག་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པ་ཅན་གྱི་དངོས་པོའི་རང་གི་ངོ་བོ་དག་ཕན་ཚུན་ངོ་བོ་འདྲེས་པ་མེད་པའི་ཕྱིར།",
    "འོན་ཀྱང་དེའི་དོན་མ་ཡིན་པ་དག་ལས་དངོས་པོ་དེ་དག་ལས་ཐ་དད་པ་དེ་ལྟར་ན་དེ་དག་གི་ཐ་དད་པ་ཁོན་ཐ་དད་པ་མེད་པ་ཡིན་ནོ།",
    "མ་ལུས་པ་ལ་གང་དག་གིས་འབྲས་བུ་འགའ་ཞིག་བྱེད་པ་དེ་དག་ནི་དེ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་ལ་ཁྱད་པར་བྲྗོད་པ་དོན་མེད་པ་ཅན་ཡིན་པས་ན།",
    "གང་ཡང་སོ་སོ་འམ་བསྡུས་པ་དག་འགའ་ཞིག་ཅིག་ཅར་ཤེས་པ་ཉིད་ཀྱི་དོན་དུ་ཉེ་བར་སྦྱོར་བ་ནི་གནས་སྐབས་ཁྱད་པར་ཅན་གྱི་ཚིག་དག་གིས་བསྟན་དུ་ཡོད་པའམ།",
    "དེ་གཞན་ལས་ཐ་དད་པ་བུམ་པ་ལ་སོགས་པའི་སྒྲ་རྣམས་ཀྱིས་བརྡར་བྱས་པ་དེ་བཞིན་དུ་རྒྱུ་ལ་ལྟོས་པ་དུ་མ་དག་ཀྱང་གཅིག་གི་ཐ་སྙད་དུ་བྱ་བའི་དོན་ཁོ་ན་ཡིན་ཏེ།",
    "དཔེར་ན་ཁྲ་མོའི་བུ་དང་སེར་སྐྱའི་བུ་དང་།",
    "དེ་བཞིན་དུ་འབྲས་བུ་དགག་པས་ཀྱང་སྒྲ་ནི་མིག་གིས་གཟུང་བར་བྱ་བ་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་གཅིག་གནས་པ་ཡིན་པའི་ཕྱིར་སྒྲ་གཅིག་གིས་འབྲས་བུ་དུ་མ་བྲྗོད་པ་ལ་འགལ་བར་འགྱུར་བ་ཅི་ཡོད།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བས་འཇིགས་པའི་ཕྱིར་རོ།",
    "གཅིག་ལ་གཅིག་གམ་གཞན་དག་གིས་ཕན་འདོགས་པ་མེད་པ་ནི་རག་ལུས་པ་མེད་པའི་ཕྱིར་དང་།་",
    "མི་འགྱུར་ན་ནི་ཇི་སྐད་དུ་བསྟན་པའི་ཉེས་པར་ཐལ་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་རྟེན་འདི་ནི་ལྟོས་པ་མེད་པ་རང་གི་བདག་ཉིད་ལ་ཕན་པ་མི་བྱེད་པས།",
    "འོན་ཏེ་དེ་ལྟ་ཡིན་ན་ཇི་ལྟར་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་འཁར་གཞོད་རྒྱ་ཤུག་གི་འབྲས་བུའི་རྟེན་ཡིན་ཞེ་ན།",
    "དེའི་སྐད་ཅིག་མ་སྔ་མའི་ལྷན་ཅིག་བྱེད་པའི་འཁར་གཞོང་ནི་དེ་ཉིད་ལ་རྒྱ་ཤུག་གི་འབྲས་བུ་བསྐྱེད་པ་ན་རྟེན་ཞེས་བྱའི།",
    "གཞན་དུ་ན་འཁར་གཞོང་འདི་ལ་རྒྱ་ཤུག་གི་འབྲས་བུ་དག་ཅེས་བྱ་བར་ཡང་མི་འགྱུར་རོ།",
    "དེ་དག་གིས་བསྐྱེད་པའམ།",
    "བསྐྱེད་པར་བྱ་བ་དང་བསྐྱེད་པར་གྱུར་པ་མ་ཡིན་པ་དག་གི་ཕན་པར་བྱེད་པ་འདི་ཡང་ཅི་ཡིན།",
    "རང་གི་འབྲས་བུ་གྲུབ་ཟིན་པ་འབྲས་བུ་ཉིད་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "རྟེན་གྱི་ངོ་བོ་ཉིད་ཀྱང་རྒྱ་ཤུག་གི་འབྲས་བུ་ལ་སོགས་པ་བསྐྱེད་པར་ནུས་པ་ཁོ་ན་ཡིན་ན་དེ་ཡང་འདི་ལ་མི་སྲིད་དོ།",
    "དེ་ནི་འགའ་ཞིག་གིས་བྱ་བའི་ངོ་བོ་ཉིད་ཡིན་ན་དངོས་པོ་མེད་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་འདི་ནི་ཅུང་ཞིག་ཀྱང་མི་བྱེད་ན་ཅུང་ཞིག་ཀྱང་མི་བྱེད་པ་གང་དང་གང་གིས་འཇོག་པར་བྱེད་པ་ཡིན།",
    "དེའི་ཕྱིར་འདི་ནི་འགའ་ཞིག་གིས་གེགས་མ་བྱས་པའི་ཕྱིར་འགའ་ཞིག་གི་ཚེ་ཡང་གནས་པ་མེད་དོ།",
    "དེ་ལ་ཡང་ཐལ་བ་མཚུངས་པ་དང་།",
    "སྤྱི་ལ་གནས་པ་ཐ་དད་པ་མེད་པ་ཡིན་ན་ཡང་དེ་ནི་དེའི་རང་གི་ངོ་བོ་ཁོ་ན་ཡིན་ཏེ།",
    "འདི་ནི་འགའ་ཞིག་གིས་ཀྱང་གནས་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར།",
    "གཞན་རང་གི་ཡུལ་ལ་རྣམ་པར་ཤེས་པ་བསྐྱེད་པར་ནུས་པ་རིགས་མཐུན་པའི་ཉེ་བར་ལེན་པ་ལ་ལྟོས་པའམ།",
    "གནས་པ་བཞིན་དུ་ཐལ་བར་འགྱུར་བ་དེ་བས་ན་གསལ་བར་བྱེད་པ་དེ་བྱེད་པ་མ་ཡིན་ཞིང་གཞན་ཡང་བྱེད་པ་མ་ཡིན་པ་དེ་ལྟར་ན་ཅུང་ཞིག་ཀྱང་མི་བྱེད་པ་དང་ལྟོས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འགལ་བ་ཡིན་ནོ།",
    "རང་གི་རྟེན་ལ་འཕྲོད་པ་འདུ་བ་ལས་ཏེ།",
    "རང་གི་རྟེན་ལས་འཕྲོད་པ་འདུ་བས་འབྲེལ་པ་དེ་ནི་བདག་ཉིད་དམ་གཞན་ལ་རྣམ་པར་ཤེས་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་རྟེན་གྱིས་འཕྲོད་པ་འདུ་བ་ལ་ལྟོས་པ་ཅན་རྣམ་པར་ཤེས་པའི་རྒྱུ་ཡིན་པ་དེས་བསྐྱེད་པར་བྱ་བ་ཁོ་ནར་འགྱུར་ཏེ།",
    "དེའི་ངོ་བོ་རྟག་ཏུ་ཡོད་པ་ཡིན་ན་འཕྲོད་པ་འདུ་བ་ལས་སྔར་ཡང་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་དག་གིས་སྐྱེད་པར་བྱེད་པའི་བདག་ཉིད་གང་ཡིན་པ་དེ་ནི་དེའི་ཚེ་དེ་ཉིད་ལས་འགྱུར་བའི་ཕྱིར་སྐྱེད་པར་བྱེད་པ་དག་ཉིད་ནི་ཕན་ཚུན་ལྟོས་པ་ཡིན་ནོ།",
    "སྣང་བ་ལེགས་པར་བྱས་པ་ལ་ལྟོས་པའི་མིག་གིས་དོན་རྟོགས་པའི་ཕྱིར་རོ།",
    "ཕུལ་དུ་བྱུང་བའི་རང་གི་ངོ་བོ་ཉིད་བྱ་བར་མི་ནུས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འཕྲོད་པ་འདུ་བ་ཁོ་ན་ལས་ཤེས་པའི་རྒྱུ་ཉིད་ཡིན་ན་ནི་གཞན་རང་གི་རྟེན་ལ་འཕྲོད་པ་འདུ་བ་དག་ཀྱང་མཐོང་བར་འགྱུར་བ་དེ་བས་ན་བསལ་བར་བྱེད་པ་ཉིད་ནི་ཤེས་པའི་རྒྱུ་ཉིད་ཡིན་ནོ།་།",
    "ཐལ་པར་འགྱུར་བ་དེ་ཉིད་དོ།",
    "དངོས་པོ་ཡོད་པ་ནི་རང་གི་ནུས་པ་ཉིད་ཀྱིས་གཞན་ལ་རང་གི་ངོ་བོའི་རྗེས་སུ་བྱེད་པ་ཅན་གྱི་བློ་སྐྱེད་པར་བྱེད་པ་དེ་དང་འབྲེལ་པ་ལ་རག་ལུས་པ་ཡིན་གྱི།",
    "གཞན་དུ་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བསལ་བ་གཞན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་གིས་ཕན་བཏགས་པ་མེད་པར་རག་ལུས་པ་མེད་པས་ན་བསལ་བར་བྱ་བ་དང་།",
    "བསལ་བར་བྱེད་པའི་ངོ་བོ་ལ་སོགས་པ་ལས་འབྲེལ་པ་གཞན་ཡང་མེད་པའི་ཕྱིར་འབྲེལ་པ་མེད་པ་ཅན་ལས་ཀྱང་ཤེས་པ་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཞན་ཡང་སྤྱི་དོན་གཞན་དུ་རྟོག་པ་འདི་རང་གི་རྟེན་ཙམ་ལ་ཡོད་པའམ།",
    "དེ་ལ་གལ་ཏེ་རང་གི་རྟེན་ཙམ་ལ་ཡོད་པ་དེའི་ཚེ།",
    "རང་གི་ཕྱིར་དེ་ནི་རྫས་སྔ་མ་ལས་འགྱུར་བའི་རྫས་ལ་མི་འགྲོ་སྟེ།",
    "གང་གི་ཕྱིར་གཞན་ན་གནས་པའི་དངོས་པོ་དེ་ལས་མི་གཡོ་བ་དེ་གཉི་གའི་བར་ལ་ཁྱབ་པ་མ་ཡིན་པ་ནི་ཡུལ་ཐ་དད་པའི་དངོས་པོ་དང་ལྡན་པར་རིགས་པ་མ་ཡིན་ནོ།་།",
    "ཡུལ་ཐ་དད་པའི་དངོས་པོ་དག་གི་འབྲེལ་པ་ཅན་ནི་ཡན་ལག་དུ་མའི་བདག་ཉིད་ཅན་ནམ།",
    "གཅིག་གི་བདག་ཉིད་ཅན་གྱིས་རྣམ་པ་གཉིས་སུ་འགྱུར་ཏེ།",
    "ཡན་ལག་གཞན་དང་གཞན་དག་གིས་དེ་དང་འབྲེལ་པའི་ཕྱིར།",
    "ཡན་ལག་དང་བཅས་པ་མ་གཏོགས་པར་ཡུལ་ཐ་དད་པ་དག་དང་འགའ་ཞིག་གིས་ཀྱང་ཅིག་ཅར་འབྲེལ་པ་རིགས་པ་མ་ཡིན་ཏེ།",
    "རང་གི་གནས་ལས་མི་གཡོ་བ།",
    "སྒྲོན་མ་ལ་སོགས་པ་བསལ་བར་བྱེད་པ་ནི་བདག་ཉིད་རྟོགས་ནས་གཞན་རྟོགས་པར་བྱེད་པའི་རྒྱུ་ནི་རང་གི་ངོ་བོས་སྟོང་པ་ལ་བསལ་བར་བྱ་བ་རང་ཉིད་མཐོང་བར་བྱེད་པ་མ་ཡིན་ལ།",
    "རྣམ་པ་འགའ་ཞིག་གིས་དེ་ལྟ་རྟོགས་པ་མེད་པར་སྣང་བའི་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "འཚེད་པ་པོ་སོགས་དག་གི་སྒྲ།",
    "གང་གིས་ཐ་དད་པ་དག་གིས་ནི་དེ་ལྟར་རྟོགས་པར་འགྱུར།",
    "བསལ་བ་དག་གིས་ཉེས་པ་ཅི་ཞིག་བྱས་ན་གང་གིས་དེ་དག་དེ་ལྟར་མི་འདོད།",
    "གལ་ཏེ་དེ་དག་གི་ལས་ཀྱི་རིགས་ཐ་དད་པ་མེད་པའི་ཕྱིར་རྒྱུ་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲ་ཡི་རྒྱུ་ཉིད་ཐལ་འགྱུར་ཕྱིར།",
    "གཞན་དུ་ནི་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ནི་ཤེས་པ་དང་བྲྗོད་པ་དག་གི་མཚན་ཉིད་དུ་འདོད་པའི་ཕྱིར་རོ།",
    "འཚེད་པ་པོ་ལ་སོགས་པ་དག་གི་ནུས་པ་ཞེས་བྱ་བ་གཞན་ཅུང་ཞིག་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འདི་ཉིད་ནི་འཚེད་པ་ལ་སོགས་པའི་དོན་གྱི་བྱ་བ་ལས་ཉེ་བར་སྦྱོར་བ་ཡིན་པས་ན་རྫས་ནི་ཉེ་བར་སྦྱོར་བ་མ་ཡིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ནུས་པ་གཞན་ཐ་དད་པ་ཁས་ལེན་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར།",
    "ཅི་སྟེ་ཡང་འཚེད་པ་པོ་ཉིད་ཅེས་བྱ་བའི་འགའ་ཞིག་ཡོད་པ་ཡིན་ན་ཡོད་པའི་དོན་ལ་འཕྲོད་པ་འདུ་བ་དེ་ནི་རེས་འགའ་བ་ཉིད་མ་ཡིན་པའི་ཕྱིར།",
    "དེ་བས་ན་རང་གི་སྐྱེ་བའི་གནས་འཇིག་པ་ཅན་གྱི་བྱ་བ་གང་ལས་གང་ལ་ལྟོས་པ་བསལ་བར་བྱེད་པར་འགྱུར།",
    "དངོས་པོ་ནི་ཤེས་པ་དང་སྒྲ་དག་གི་རྗེས་སུ་འགྲོ་བ་ཅན་ལ་འཇུག་པར་འགྱུར།",
    "རྨི་ལམ་དང་རབ་རིབ་ཅན་དག་གིས་དམིགས་པའི་དོན་དང་དངོས་པོ་མེད་པ་དང་།",
    "ཁོ་ཅོ་ཅག་གིས་འདིར་རང་བཞིན་གྱིས་ཀྱང་ཤེས་པ་གཅིག་གི་འབྲས་བུ་ཅན་འགའ་ཞིག་ངོ་བོ་ཉིད་ཐ་དད་པའི་ཕྱིར་ཞེས་བྱ་བ་ཅུང་ཞིག་བསྟེན་ཏོ།",
    "ཉེ་བ་གང་གིས་འགའ་ཞིག་ལ།",
    "གཅིག་གི་འབྲས་བུ་གཞན་གྱིར་ནི།",
    "གལ་ཏེ་ལྡོག་པ་མ་གཏོགས་པར་རྗེས་སུ་འགྲོ་བ་ཅན་གྱི་རང་བཞིན་འགའ་ཞིག་གིས་དངོས་པོ་དེ་དག་སྟོང་བ་ཡིན་ནོ།",
    "དུ་མ་གཅིག་བྱེད་པ་ཡིན་ན་དེ་དག་གི་རང་བ་མེད་པའི་རང་བཞིན་དེའི་གཅིག་ཉེ་ཡང་ཡོད།",
    "གནས་པ་གཅིག་གིས་ཀྱང་འབྲས་བུ་བསྐྱེད་པར་འགྱུར་བ་ཞིག་ན་འགྱུར་བ་ཡང་མ་ཡིན་ནོ།",
    "ལྷན་ཅིག་བྱེད་པ་དུ་མའི་ཐུན་མོང་དུ་གྱུར་པའི་འབྲས་བུ་དེ་ནི་ཁྱད་པར་གཅིག་དང་བྲལ་ན་ཡང་མི་འགྱུར་ཞིང་ཁྱད་པར་ཐམས་ཅད་དང་མ་བྲལ་བ་དག་ལ་ཡང་འགྱུར་ཏེ།",
    "དེ་ལས་གཞན་ལས་སྐྱེ་བར་རྟོག་ན་ནི་ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འོ་ན་ཀྱང་རང་བཞིན་གྱི་རྗེས་སུ་འགྲོ་བ་མེད་པས་གཅིག་གི་སྐྱེད་པར་བྱེད་པའི་ངོ་བོ་གཞན་ལ་མེད་པའི་ཕྱིར།",
    "རང་བཞིན་འདི་ཡིན་གཅིག་གི་སྐྱེད་པར་བྱེད་པའི་བདག་ཉིད་ལས་ཐམས་ཅད་ཐ་དད་པར་གྱུར་པ་ན་མཚུངས་པར་སྐྱེད་པར་བྱེད་པའམ།",
    "དེ་བས་ན་རང་བཞིན་ནི་འདིའི་རང་གི་རྒྱུ་ལས་ཞེས་བྲྗོད་པར་བྱའོ།",
    "ཐ་དད་པ་དག་གི་འགའ་ཞིག་རྒྱུ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ཏེ།",
    "རང་གི་བདག་ཉིད་བཞིན་དུ་སྣ་ཚོགས་པའི་རྣམ་པར་དབྱེ་བ་སྐྱེ་བ་དང་གནས་པ་དང་འགག་པ་ལ་སོགས་པར་མི་འགྱུར་རོ།",
    "ཡིན་ན་གང་གིས་དེ་ལྟར་འགྱུར།",
    "གཅིག་གི་འཇིག་ན་གནས་པ་ཡི།",
    "གལ་ཏེ་གཞན་སེལ་བ་ལ་ཡང་དེ་མཚུངས་པར་ཐལ་པར་འགྱུར་རོ་ཞེ་ན།",
    "གཞན་སེལ་བ་ཞེས་བྱ་བ་འགའ་ཞིག་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ་དེ་ཡང་རང་བཞིན་གྱི་རྗེས་སུ་སོང་བ་ཅན་རང་བཞིན་དང་གནས་པ་དང་འཇིག་པའི་རྣམ་པར་རྟོག་པ་དག་གིས་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དུ་མ་ལ་གཅིག་གི་རྣམ་པ་ཅན་ཡིན་པ་དེ་ན་ཡུལ་མེད་པའི་ཕྱིར།",
    "གཅིག་གི་དེ་སྐྱེད་པར་བྱེད་པའི་རང་གི་ངོ་བོ་གང་ཡིན་པ་དེ་ནི་གཞན་གྱི་མ་ཡིན་ནོ་ཞེས་སྨྲའོ།",
    "གཞན་དག་ཀྱང་རང་གི་ངོ་བོ་ཁོ་ནས་སྐྱེད་པར་བྱེད་པ་ཡིན་གྱི་ངོ་བོས་ནི་མ་ཡིན་ཏེ།",
    "གཅིག་གིས་སྐྱེད་པར་བྱེད་པའི་ངོ་བོ་གང་ཡིན་པ་དེ་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཡང་གི་སྒྲ་ནི་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་ལ་སོགས་པའི་ཁྱད་པར་དག་ཡིན་ནོ།",
    "འདིར་ཐ་དད་པ་མེད་པའི་སྣང་བ་གཞན་མཐོང་བ་ནི་མེད་མོད་ཀྱི་གང་གི་སྟོབས་ཀྱིས་ཐ་དད་པ་མེད་པའི་ཤེས་བ་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་ནི་རང་གི་མཚན་ཉིད་འདོད།",
    "ཐ་དད་ན་ཡང་འགའ་ཞིག་གིས།",
    "ཐ་དད་པ་ཙམ་དུ་ཁྱད་པར་མེད་པ་ཡིན་ན་ཡང་རང་གི་རྒྱུ་དང་རྐྱེན་གྱིས་ངེས་པའི་རང་བཞིན་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རྣམ་པ་འགའ་ཞིག་གི་ཐ་དད་པའི་ཕྱིར་ལྷན་ཅིག་བྱེད་པ་ནི་བྱེད་པ་པོར་མི་འགྱུར་རོ།",
    "རྣམ་པ་འགའ་ཞིག་གི་ཁྱད་པར་ཡིན་ན་གཅིག་པ་ཉིད་ཉམས་པའི་ཕྱིར་དེ་ནི་ཅིར་ཡང་མི་རུང་ངོ།",
    "རང་གི་བདག་ཉིད་དུ་གྱུར་པས་ཐ་དད་པའི་དངོས་པོ་དག་ནི་དེས་ཐ་དད་པ་མེད་པའི་བདག་ཉིད་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་དེ་དང་ལྡན་པར་འགྱུར་བ་ཐ་དད་པར་ཡང་གང་ལས་ཕན་ཚུན་ཐ་དད་པ་ཡིན།",
    "གལ་ཏེ་བདག་ཉིད་གང་གིས་དེ།་།",
    "གང་གི་ཕྱིར་དེ་དག་ནི་གལ་ཏེ་དེ་དག་གི་རང་གི་བདག་ཉིད་ཡིན་ན་ཐ་དད་པ་ཅན་དེ་དག་ཐ་དད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་ནི་དངོས་པོ་ཡིན་ནོ།",
    "བདག་ཉིད་གང་གི་མདུན་བྱས་ནས།",
    "འཇུག་པ་ལ་སོགས་ཐལ་འགྱུར་ཕྱིར།",
    "ཅད་ཁྱད་པར་ཁོ་ན་ལ་དངོས་པོའི་རང་གི་ངོ་བོ་ཡིན་ན་ཞེས་ལྷག་པར་བྱས་ནས་འཇུག་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་འདིའི་བདག་ཉིད་གང་ཞིག་གཞན་དང་ཐུན་མོང་མ་ཡིན་པ་འདི་མདུན་དུ་བྱས་ནས་ཁྱད་པར་ཅན་གྱི་དོན་བྱེད་པ་དོན་དུ་གཉེར་བ་སྐྱེས་བུ་འདི་འཇུག་པར་འགྱུར་ཏེ།",
    "རང་གི་ངོ་བོ་ཉིད་བདག་ཉིད་ཇི་ལྟ་བུའི་སྒྲས་བྲྗོད་པ་ཡིན་གྱི།་",
    "དེའི་བདག་ཉིད་དུ་གྱུར་པ་དག་གི་རྗེས་སུ་འགྲོ་བ་དག་མེད་པས་དེ་ལ་གཉི་གའི་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "ལྡོག་པའི་མཚན་ཉིད་ཅན་གྱི་སྤྱི་དང་ཐམས་ཅད་ལ་རང་གི་ངོ་བོ་ཐ་དད་པ་ཁས་བླངས་པའི་ཕྱིར་རོ།་།",
    "རང་གི་བདག་ཉིད་ཀྱིས་ཐ་དད་པ་མེད་དུ་ཟིན་ཀྱང་དེའི་རང་གི་ངོ་བོའི་རྒྱུ་ཅན་དོན་བྱེད་པ་དོན་དུ་གཉེར་བ་དག་གི་ནི་གཉི་ག་ལ་མཚུངས་པར་འཇུག་པར་འགྱུར་རོ།",
    "ཅིའི་ཕྱིར་རྔ་མོ་ལ་མི་རྒྱུག།",
    "འདི་ལྟར་རྔ་མོ་ཡང་ཞོར་འགྱུར་ཞིང་དེ་ཉིད་ཀྱང་རྔ་མོ་མ་ཡིན་ཏེ།",
    "གང་གིས་གཞན་ཡང་རྔ་མོར་འགྱུར།",
    "དེ་བཞིན་དུ་ཞོ་ཡང་རྔ་མོར་འགྱུར་ལ་དེ་ཉིད་ཀྱང་ཞོ་མ་ཡིན་ཏེ།་",
    "གང་གིས་གཞན་ཡང་ཞོར་འགྱུར།",
    "འགྱུར་བ་མ་ཡིན་པའི་རང་གི་ངོ་བོ་ལ་ངེས་པ་མེད་པའི་ཕྱིར།",
    "ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་པས་ཞོ་འཐུང་ཅིག་ཅེས་བྲྗོད་པ་ན་རྔ་མོ་ཡང་ཟོས་པར་འགྱུར་རོ།",
    "གང་གི་ཁྱད་པར་འཇུག་འགྱུར་ན།",
    "འགའ་ཞིག་ལ་ཡང་སོ་སོར་ངེས་པའི་རྣམ་པ་གཅིག་མ་མཐོང་བར་རྣམ་པ་གཞན་དང་འདྲེས་པ་མེད་པ་དང་ལྡན་པ་ཅན་གྱི་བློས་དོན་ལ་མོས་པའམ།",
    "རྔ་མོ་ཞོར་འགྱུར་ཞིང་མི་འགྱུར་རོ་ཞེས་བྱ་བ་དེ་བསྡུས་པ་སྨྲ་བར་མི་འགྱུར་རོ།",
    "དངོས་པོ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཐ་དད་པའི་སྤྱི་ཡིན་ཡང་བླ་སྟེ།",
    "གང་ནུས་པ་མེད་པ་དག་ལ་ནི་རང་གི་ངོ་བོ་ཉིད་ཡོད་པ་མ་ཡིན་ན།",
    "རྣམ་པ་འགའ་ཞིག་གིས་ཀྱང་རྣམ་པར་མ་གཞག་པ་དག་ལ་ནི་སྒྲུབ་པ་དང་དགག་པ་མི་རུང་བའི་ཕྱིར་རོ།",
    "རང་བཞིན་གཞན་མེད་པ་ལ་ནི་རྣམ་པ་འགའ་ཞིག་གིས་རྣམ་པར་གཞག་པ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེ་དག་འཇུག་པ་ཡིན་ན་ཚིག་ནི་གང་གིས་འགོག་པར་བྱེད།་",
    "བྲྗོད་པར་བྱ་བ་མ་ཡིན་པའི་དོན་བློ་དག་གིས་དམིགས་པ་མ་ཡིན་ནོ།་།",
    "འབྲེལ་པ་ཡང་རང་གི་ངོ་བོས་བྲྗོད་པ་མེད་པར་བསྟན་ཏོ།",
