    "སྐྱེས་བུ་གསུམ་སོགས་ལམ་རིམ་མ་འཆུགས་པར།",
    "ཕྱོགས་གཅིག་ཙམ་ཡང་བརྗོད་པར་མི་ནུས་ཀྱང་།",
    "དེ་ལ་ནོངས་པར་གྱུར་པ་ཅི་མཆིས་པ།",
    "ཇོ་བོ་ཡབ་སྲས་བརྒྱུད་པར་བཅས་པ་དང་།",
    "དམ་ཚིག་གཙང་ཞིང་ས་བཅུ་བགྲོད་པ་དང་།",
    "འགྲོ་བའི་སྡུག་བསྔལ་དྲུངས་ནས་འབྱིན་པར་ཤོག།",
    "ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་རྗེ་ལ་གནང་།",
    "རྣམ་པར་བཞག་པ་ཐམས་ཅད་བསྟན་རྗེས་སུ།",
    "དགྲ་བཅོམ་རྣམས་ཀྱིས་སྨད་པར་གྱུར་མ་ལགས།",
    "སྐྱེས་བུ་ཆེན་པོ་སྨད་པར་གྱུར་མ་ལགས།",
    "ཕྱོགས་བཅུའི་སྒྲོན་མེར་སྨད་པར་གྱུར་མ་ལགས།",
    "རྒྱུ་འབྲས་ལས་ཀྱིས་ཁྲེལ་བར་གྱུར་མ་ལགས།",
    "ཀུན་གྱིས་སྤྱི་བོའི་གཙུག་ཏུ་བཀུར་བ་ལགས།",
    "བསྟན་བསྲུང་ཐམས་ཅད་དམག་ཏུ་འཐིབས་པ་ལགས།",
    "ཆགས་པ་མེད་པར་དཀའ་སྤྱད་གོ་གོན་ནས།",
    "ཤེས་བྱ་འདི་ལ་ཕྱོགས་རིས་མེད་པར་བསླབས།",
    "ལེགས་པར་སྦྱར་བའི་གཡོ་ངག་མ་ཟོས་ན།",
    "འོན་ཀྱང་པཾ་དེ་ལ་ཤོག་ཅེས་གསུངས།",
    "ལེགས་པར་གཏན་ལ་ཕོབ་ལ་ཡང་འདིར་ཤོག།",
    "ལན་དུ་ཨ་ཏི་ཤ་ཡིས་འདི་སྐད་གསུངས།",
    "ལམ་དུ་ཉེ་ཞོ་མེད་པར་བྱིན་གྱིས་རློབས།",
    "ཨ་ཏི་ཤ་ཡི་སྙན་པས་ཁྱབ་པར་གྱུར།",
    "ལྷག་པར་རྒྱ་ནག་སྟོང་ཁུན་རྒྱལ་པོ་ཡིས།",
    "གཤེགས་པར་མ་ནུས་ཤིན་ཏུ་ཐུགས་སྐྱོ་བས།",
    "དཔོན་གཡོག་ལྔ་བཅུ་ཚོང་པར་བཅས་པ་ཡིས།",
    "ཕན་བྱ་ཐམས་ཅད་བརྩེ་བའི་ཐུགས་ཀྱིས་གནང་།",
    "ཡན་ལག་བདུན་པ་རྒྱས་པར་ཕུལ་བ་ན།",
    "ཇི་སྲིད་བཙན་ས་ཟིན་པར་མ་གྱུར་པར།",
    "ཇོ་བོས་དབུས་སུ་འབྱོན་པར་ཆས་པའི་ཚེ།",
    "ལྷ་གཅིག་འདི་རུ་མ་བཞུགས་བྱང་དུ་བྱོན།",
    "ལྷ་བྱ་འཕུར་ལྡིང་བག་ཕེབས་རྒྱུ་བའི་ཡུལ།",
    "རི་མཐོ་ས་གཙང་སྤོས་རྒྱ་ལྟ་བུའི་ཡུལ།",
    "འཇིགས་པ་མེད་པར་དཔའ་བོ་བག་ཕེབས་རྒྱུ།",
    "བོད་ཀྱི་སྣང་ཚུལ་མཐོང་སྟེ་སྐྲག་པར་གྱུར།",
    "རྣམ་གཞག་མ་ཆགས་གཙང་ཤུན་ཤན་མ་ཕྱེད།",
    "ཟླུམ་ཞིང་དུལ་བར་བཞུགས་པས་ཞི་བར་སྟོན།",
    "གཙུག་ལག་ཁང་རྣམས་ཕུན་སུམ་ཚོགས་པར་མཛད།",
    "རྟེན་གསུམ་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་མཛད།",
    "ཀུན་དགའ་ར་བ་ཤིན་ཏུ་མཛེས་པར་མཛད།",
    "བདེ་གཤེགས་མཆོད་རྟེན་ཐམས་ཅད་མཛེས་པར་མཛད།",
    "ཉམས་པ་གསོས་ཤིང་གཙུག་ལག་རྒྱས་པར་མཛད།",
    "ཉན་ཐོས་མཆོད་རྟེན་ཐམས་ཅད་རྒྱས་པར་མཛད།",
    "ཀུན་དགའ་ར་བ་བཅུ་གསུམ་རྒྱས་པར་མཛད།",
    "སྐྱེས་བུ་དམ་པའི་སྙན་པས་ཁྱབ་པར་གྱུར།",
    "རྒྱལ་བ་བོད་དུ་འབྱོན་པར་བཞེད་ན་ཡང་།",
    "མགོན་པོ་བོད་དུ་ཐེངས་པར་མ་གྱུར་ལགས།",
    "སྒྲོ་བསྐུར་མེད་པའི་ལྟ་བ་ལགས་སམ་ཞེས།",
    "ཐུགས་རྗེས་མཁྱེན་ནས་རྒྱང་ནས་བསུ་བ་མཛད།",
    "མཇལ་མ་ཐག་ཏུ་གུས་པས་འདི་སྐད་གསུངས།",
    "ཨ་ཏི་ཤ་ཡིས་དེ་ལ་ལན་གསུངས་པ།",
    "ནངས་པར་འགལ་ཞིང་སྔར་གྱི་ཡིན་པ་ཉམས།",
    "གླང་པོས་གླང་པོ་ཡུལ་དུ་བྱས་པ་ལྟར།",
    "གསེར་གླིང་པའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "ཨ་ཏི་ཤའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "དང་པོ་མྱུ་གུ་མེད་པར་ཀུན་གྱིས་ཤེས།",
    "མགོན་པོ་ཨ་ཏི་ཤ་ཡིས་འདི་གསུངས་པ།",
    "གསེར་གླིང་པའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "ད་ནི་ལྟ་བ་གཉིས་སུ་མེད་པར་བྱ།",
    "དཔེ་དོན་བཅུ་དྲུག་སེམས་ལ་གོམས་པར་བྱ།",
    "དི་པཾ་དོན་ཆེན་ལྟ་བ་རྣམ་པར་དག།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པར་ཐེ་ཚོམ་མེད།",
    "ངེས་པར་ཁྱེད་ཀྱིས་ཐུགས་རྗེ་སྤེལ་དུ་གསོལ།",
    "མགོན་པོ་ཨ་ཏི་ཤ་ཡིས་ལན་གསུངས་པ།",
    "ཐུགས་རྗེ་ཆེན་པོས་ཞིང་དེར་བཞུགས་པ་ལ།",
    "དེ་ནས་ཟླ་བ་བཅུ་གཅིག་དེར་བཞུགས་ནས།",
    "ཁོ་བོ་བོད་དུ་འབོད་དུ་འོངས་པར་ངེས།",
    "གཞུང་ལུགས་རྣམས་ལ་བཀའ་བསྒོ་ལེགས་པར་བྱ།",
    "སྡིག་ཏོ་ཅན་ལ་བཅའ་ཀ་ལེགས་པར་བྱ།",
    "ཡན་ལག་བདུན་པ་རྒྱས་པར་མཛད་པ་ན།",
    "ཁོ་བོ་དགེ་སློང་གཙང་མ་ཡིན་པ་ལ།",
    "གསུང་དེ་ཐོས་ནས་སྒྲོལ་མ་ཡིན་པར་ངེས།",
    "མ་གཅིག་ཐུགས་རྗེའི་དབྱིངས་ན་རབ་བཞུགས་པའི།",
    "ཁོ་བོའི་སྒོ་གསུམ་མངོན་དུ་གྱུར་ལགས་ན།",
    "ནོངས་པ་མཆིས་ན་བཟོད་པར་བཞེས་སུ་གསོལ།",
    "མ་གཅིག་ཏ་རའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "ལྷ་གཅིག་འབྲོམ་རྗེས་ལྷ་སའི་མཐིལ་དུ་འབོད།",
    "རྗེ་བཙུན་བྱམས་པའང་དེ་ན་དངོས་སུ་བཞུགས།",
    "འོད་ཟེར་འཕྲོས་པའི་ལྷ་རིགས་དུ་མ་བཞུགས།",
    "བདག་དང་ཁྲོ་གཉེར་ཅན་གྱིས་ཡུམ་བྱས་ནས།",
    "ཨ་ཏི་ཤ་ཡིས་དེ་ལ་ལན་གསུངས་པ།",
    "ཨུ་པ་སི་ཀ་ད་ལྟ་གང་ན་བཞུགས།",
    "སྒྲོལ་མའི་ཞལ་ནས་དེ་ལ་ལན་གསུངས་པ།",
    "ཕྱེ་ཁལ་ལྔ་ལྔ་ཞིབ་པར་འཐག་པ་ན།",
    "དལ་འཁྱུག་འཛུམ་ཆགས་འཁོབས་པར་བསྙེན་བཀུར་འགྲིམ།",
    "ལྷག་ཆད་མེད་ཅིང་ཀུན་ཡིད་ཚིམ་པར་བྱེད།",
    "ཚེ་ལོ་ཉི་ཤུ་འབྲིད་པར་འགྱུར་ན་ཡང་།",
    "ཐོགས་པ་མེད་པར་པདྨོ་ལ་འཁྲུངས་ནས།",
    "ནམ་མཁའ་དྲི་མ་མེད་པར་ཡོངས་གྲགས་པའི།",
    "བྱ་ལམ་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་འོང་།",
    "བྱ་བ་ཆེན་པོས་ད་དུང་མ་ཐོན་ལགས།",
    "དེ་ལ་གདན་འདྲེན་ཡིན་སྐད་མ་བྱས་པར།",
    "འདི་ཡིས་ད་རུང་པཎ་ཆེན་སྤྱན་དྲོངས་གསུངས།",
    "ཞུས་པས་ཇོ་བོའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "ཨེ་མ་ཧོ་མགོན་པོ་ཐུགས་རྗེ་ཆེན་པོ་ལགས།",
    "མུ་མཐའ་མེད་པར་སྐྱེ་བ་བརྒྱུད་ན་ཡང་།",
    "འོན་ཀྱང་སུ་འགྲོས་ཕྲིན་འདིའང་མཛོད་ཅེས་གསུངས།",
    "དེ་ལྟར་ལྷ་ཆེན་ཞི་བར་གཤེགས་པར་གྱུར།",
    "ད་ལན་ཅིས་ཀྱང་འབྱོན་པར་མཛད་དུ་གསོལ།",
    "ལན་དུ་ཇོ་བོའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "དེའི་སྟོབས་ཀྱིས་ད་དུང་མ་ཐོན་ལགས།",
    "དེ་ལྟར་མཛད་ན་བོད་དུ་ཕྱིན་པར་འགྱུར།",
    "འགྲོ་བའི་ཆས་ཀ་ཐམས་ཅད་ལེགས་པར་བྱས།",
    "ཐམས་ཅད་མཐུན་པར་ཞུ་བ་ཕུལ་བ་ནི།",
    "ར་ཧུ་ལའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "སྐྱེ་རྒུའི་ཉེར་མཁོ་ཐམས་ཅད་སྤྲུལ་པར་བྱེད།",
    "རྟེན་གསུམ་ཐམས་ཅད་རབ་ཏུ་གནས་པར་མཛོད།",
    "སྐྱེ་བོ་ཐམས་ཅད་སྡོམ་པས་ཕྱུག་པར་མཛོད།",
    "སྡོམ་ལྡན་ཐམས་ཅད་བསྲུང་སྡོམ་མཁས་པར་མཛོད།",
    "སྔགས་པ་ཐམས་ཅད་དམ་ཚིག་གཙང་བར་མཛོད།",
    "ཡོན་རྣམས་ཐམས་ཅད་བསྔོ་བས་བརྟན་པར་མཛོད།",
    "བརྒྱུད་པ་གང་ལའང་དམ་ཉམས་མེད་པར་མཛོད།",
    "ལྟ་བ་ཀུན་ལ་གཡང་ས་མེད་པར་མཛོད།",
    "སྒོམ་སྒྲུབ་ཀུན་ལ་གོལ་ས་མེད་པར་མཛོད།",
    "གསུང་དེ་ཐོས་ནས་ཤིན་ཏུ་ཚིམ་པར་མཛད།",
    "བསྙེལ་བ་མེད་པར་ཐུགས་ཀྱིས་འཛིན་པ་དང་།",
    "རྟག་པར་ཐུགས་དགོངས་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "དྷརྨ་རཀྵི་ཏའི་ལན་གསུངས་པ།",
    "བག་ཕེབས་རི་དྭགས་རྒྱུ་བའི་སུལ་དུ་྾།",
    "རྒྱུག་རྒྱུག་ཐམས་ཅད་མཁྱེན་པ་མྱུར་དུ།",
    "གཡོ་བ་མེད་པར་བརྐྱངས་བསྐུམས་བགྲད་ཅིང་྾།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཚོགས་གཉིས་དཔལ་ལས་རྒྱལ་བ་གཉིས་པར་གྱུར།",
    "བྱམས་པས་ཕྱོགས་རིས་མེད་པར་ཁྱབ་པར་གནས་ལུགས་གཉིས་སུ་མེད་པར་གློད་ལ་བསྒོམས།",
    "ཤེས་བྱ་ཀུན་རིག་མཁྱེན་རྩེའི་ཕ་རོལ་ཕྱིན།",
    "དམ་པ་གཞན་ལས་ཁྱད་པར་འཕགས་པ་ལགས།",
    "ཁྱེད་ཀྱི་ཐུགས་རྗེ་ཆེན་པོས་བསྐུལ་མ་ལགས།",
    "དེ་ལྟར་ལགས་པས་ཁྱེད་ཀྱི་སྐུ་མཆོག་ནི།",
    "ལྷ་སྐུའི་སྣང་བས་རྡོ་རྗེའི་ཤུགས་ཀྱིས་བགྲོད།",
    "ཡིད་ནི་མཁྱེན་རྩེའི་མངའ་བདག་དབྱིངས་སུ་དྲོངས།",
    "མི་ཤེས་གཏི་མུག་ཐམས་ཅད་འཇིགས་པར་འགྱུར།",
    "ཀུན་གྱིས་ལས་འབྲས་ཐམས་ཅད་ཕྱེད་པར་འགྱུར།",
    "ནུས་པ་གང་ཡོད་ལྷོད་པར་མི་བྱ་སྟེ།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པར་བྱིན་གྱིས་རློབས།",
    "དམ་ཚིག་གཙང་ཞིང་འགྲོ་དོན་འཕེལ་བར་ཤོག།",
    "མངོན་ཤེས་མེད་པར་སུ་ལའང་སྡིག་མ་བསགས།",
    "ཕྱོགས་རིས་མེད་པར་འཆལ་བའི་ཚིག་མ་གཏང་།",
    "མཚམས་མེད་བྱས་པའི་མི་དང་གཏན་མ་འགྲོགས།",
    "དམ་ཚིག་གཙང་མ་དྲུང་དུ་སྟོན་པ་དང་།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཕྱོགས་ཆ་མེད་པར་བུ་བཞིན་བྱམས་པར་མཛོད།",
    "རང་རྒྱུད་ཐུལ་ལ་གཤིས་ངན་ཕྱིན་པར་མཛོད།",
    "དད་གཞི་ཟུང་ལ་ལྟ་སྤྱོད་འཛོམ་པར་མཛོད།",
    "ཀུ་སུ་ལུའི་གཞན་དོན་བྱས་པ་བཙན།",
    "ལྟ་བ་བཟང་ལ་གཡང་ས་མེད་པར་གྱིས།",
    "གཞི་མར་འཁོར་འདས་སྐྱོན་ཡོན་ཕྱེད་པར་གྱིས།",
    "སྟོབས་བཞི་སྦྱོར་བས་ཉོན་སྒྲིབ་དག་པར་གྱིས།",
    "བསྔོ་བ་བཟང་པོས་ཁ་ལོ་ཆུན་པར་གྱིས།",
    "ཀུན་ལ་འགྲོགས་ཤེས་ཞེ་འབྲས་མེད་པར་གྱིས།",
    "གྲོགས་པོས་མི་སྨོད་གཉེན་པོ་ཐོབ་པར་གྱིས།",
    "ཉིན་དང་མཚན་དུ་སེམས་ལ་ཞེན་པར་མཛོད།",
    "དམ་ཚིག་གཙང་ཞིང་འགྲོ་དོན་འཕེལ་བར་ཤོག།",
    "ཤེས་རབ་དབྱིངས་སུ་མཁྱེན་པ་རྒྱས་གྱུར་ཅིང་།",
    "ཆགས་ཐོགས་ཡད་པར་རྫུ་འཕྲུལ་སེམས་ཀྱིས་བྱོན།",
    "ཐོས་པ་འཚོལ་ཞིང་ལམ་ལ་མཁས་པར་འགྱུར།",
    "ངོ་ཚ་ཆེ་ཞིང་ཁྲེལ་ཡོད་རྒྱས་པར་འགྱུར།"
  ]
}