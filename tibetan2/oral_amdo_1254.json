    "གཏེར་བདག་ཆེན་པོ་འཇིག་རྟེན་ཁམས་། མཐོ་རིས་མི་ཡུལ་ས་འོག་གི།",
    "བདག་གི་དད་པས་སྤྱན་འདྲེན་ནོ།",
    "འདི་ན་ཡོད་མོས་བློ་ཡི་གཟུང་ནས་ཀུན།",
    "བ་རྟག་ཏུ་མིགནི་ཡ་མཚན་ལྟད་མོས་བྲེལ།",
    "གལུས་ལ་རེག་འཇམ་མཛེས་པའི་གོས་རྒྱན་མཚར།",
    "རིན་ཆེན་བང་མཛོད་ཁྱོད་དང་མཉམ་པ་དང་།",
    "ཡིད་ལ་ཅི་འདོད་བསམ་པའི་མོད་ཉིད་དུ།",
    "རྣམ་ཐོས་སྲས་པོ་ཁྱོད་ལ་བདག་བསྟོད་དོ།",
    "སྨྱུག་འཛིན་རྒྱལ་པོ་ཁྱོད་ལ་བདག་བསྟོདདོ།",
    "རྡོ་རྗེ་ནག་པོ་ཤེས་རབ་ལྷ་མོར་བཅས།་།",
    "མཆོག་གི་ནོར་བུ་ལག་རྩེར་ལོན་པར་མཛོད།",
    "ལྷན་སྐྱེས་མཛེས་མའི་རེག་བྱས་འཁྱུད་གྱུར་པ།",
    "སྙན་པའི་དར་འཕྱར་གྲོགས་པའི་དུང་འབུད་ལ།",
    "མིག་ལ་ཡ་མཚན་ལྟད་མོས་དགའ་བ་དང་།",
    "ཟབ་མོ་རྒྱུད་ཀྱི་སྲུང་མ་མ་མོ་ནི་གཞལ་གཅིག་ཕྱག་བཞི་འཕྲིན་ལས་རྣམ་བཞི་སྒྲུབ།",
    "དུས་གསུམ་རྒྱལ་བའི་སྤྱན་སྔར་རང་རང་གི།",
    "ལྷ་མིན་དམག་གི་གཡུལ་བཟློག་ཅིང་།",
    "ཕྲིན་ལས་ཀུན་སྒྲུབ་དཔལ་ལྡན་རེ་མ་ཏི།",
    "སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་པཱུ་ཛ་ཁཱ་ཧི་དཔལ་ཆེན་བཀའ་ཉན།",
    "འཁོར་ཚོགས་དང་བཅས་བརྒྱ་བྱིན་སྲས་མོ་ནི།",
    "ཡུལ་གྱི་གནས་བདག་སྒྲོག་གི་བཙན་རྒོད་ཆེ།",
    "རྣལ་འབྱོར་བདག་གི་གྲོགས་མཛད་དམ་ཚིག་ཅན།",
    "རྣལ་འབྱོར་བདག་གི་རྟག་ཏུ་རེ་ལྟོས་ཀྱི།",
    "ཐུན་མོངས་འདོད་པའི་འབྲས་བུ་ཀུན།",
    "བདུད་རྗེ་མགར་བ་ནག་པོ་ཁྱོད།",
    "རྒྱལ་བསྟན་ཉི་མོར་བྱེད་པའི་དགེ་ལགས་རྩོལ།",
    "དེང་ནས་བདག་གི་ཁ་འཛིན་མཛོད།",
    "བསམ་པ་སྒྲུབས་ལ་རེ་བ་སྐོངས།",
    "ལས་མཁན་མ་མོ་ཁྱབ་འཇུག་བ།",
    "གསོད་བྱེད་བདུདྲ་མོ་སེང་གེའི་གདོང་།",
    "ནག་པོ་སྟོང་ཚོགས་གནས་འདིར་བྱོན།",
    "མ་མོ་བྱེ་བ་གནས་འདིར་བྱོན།",
    "རང་འདྲ་སྟོང་གི་ཚོགས་དང་བཅས་ཡང་སྤྲུལ་བྱ་རོག་མཁའ་ལྡིང་དང་།",
    "གཞྭ་ནག་གོས་ནག་ནང་གི་རྟེན།",
    "མི་ཁྲག་གི་ཁྲག་དང་འདྲེས་པའི།",
    "བཙན་དུག་ར་དུག་དུག་ཤིང་གི།",
    "རོལ་མོ་ལ་སྙན་གུར་མ་དབྱངས།",
    "ཞལ་གདངས་མཆེ་གཙིགས་གད་མོ་སྒྲོག།་",
    "སྟག་གི་ལྤགས་པས་སྨདྲ་དཀྲིས་ཤིང་།",
    "སྐད་ཅིག་གཅིག་གིས་བརླག་པར་མཛོད།",
    "བདག་གིས་འཕྲིན་ལས་བཅོལ་བའི་ཚེ།",
    "དཔའ་བོ་སྟག་གི་ཤམ་ཐབས་ཅན།",
    "ཡིད་འཕྲོག་མཁའ་འགྲོ་ཆེན་མོ་དྲུག་སྐྱེས་བུ་ཆེན་པོ་གང་གི་ཚོགས།",
    "ཁྱོད་ཀྱི་ཐུགས་དམ་བསྐང་བན་ཤ་ཁྲག་དམར་གྱི་གཏོར་ཆེན་དང་།",
    "བྱ་རོག་གདོང་གི་ཐུགས་དམ་བསྐང་།",
    "སེངྒེའི་གདོང་གི་ཐུགས་དམ་བསྐང་།",
    "ནག་པོ་སྟོང་གི་ཐུགས་དམ་བསྐང་།",
    "མ་མོ་བྱེ་བའི་ཐུགས་༴།",
    "དོ་ནུབ་རྒྱན་གྱི་གཏོར་མ་འབུལ་། བདག་གི་བཅོལ་བའི་འཕྲིན་ལས་མཛོད།",
    "ཅེས་དཔལ་ཡེ་ཤེས་མགོན་པོའི་བསྐང་བཤགས་འདི་ལྷ་གཟིགས་རས་པ་ལ་མཛད་པ་ཕྱོགས་དུས་ཀུན་དར་ཞིང་རྒྱས་གྱུར་ཅིག་མགོན་པོའི་འགགས་པ་ནི།",
    "ༀབཛྲ་ས་ཏཱ་སོགས་ཡིག་བརྒྱ་བརྗོད། ལྷ་མོའི་བསྐང་བ་ནི།",
    "སྤེ་ཤེས་ལྷ་དང་ལྷ་མོ་མི་ཕམ་བདག།",
    "དཔལ་ལྡན་ལྷ་མོའི་ཐུགས་དང་འགལ་གྱུར་པས།",
    "དམ་ཚིག་ཉམས་པར་གྱུར་པ་སྐོད་གྱུར་ཅིག། ༢༦ལ་ལྡན་ལྷ་མོའི་རྟེན་འཐུལ་བསྐང་བཤགས་མངའ་གསོལ་སྨོན་ཚིག་བཅས་པ་ཀུན་ཚང་རྒྱུན་ཁྱེར་ཤིན་ཏུ་བསྡུས་པ་བཞུགས་སོ།",
    "ནག་མོ་འཁོར་དང་བཅས་ལ་འབུལ།",
