    "རིགས་ཞེན་གྱི་གླུ་གཞས་གཏོང་མཁན་ཧ་ཅང་དཀོན་དུ་ཕྱིན་ཡོད་པ་རེད།",
    "ད་ལྟའང་གཞས་ཚིག་རྩོམ་པ་པོ་དང་རམ་དཀྲོལ་བ་ན་གཞོན་དེའི་གནས་སྟངས་གང་ཡང་གོ་ཐོས་མེད་པ་རེད།",
    "དེ་བཞིན་བོད་ནང་གི་གླུ་བ་པདྨ་རིག་འཛིན་དང་།",
    "འབྲེལ་ཡོད་དད་ལྡན་སེར་སྐྱ་མང་ཚོགས་ཀྱི་སེམས་ལ་རྨ་ཁ་སྔར་ལས་ཆེན་པོ་བཟོ་ཡི་ཡོད་འདུགདེ་ཡང་འབྲེལ་ཡོད་ཅིག་གིས་འདི་གར་གནས་ཚུལ་མཁོ་སྤྲོད་གནང་བ་ལྟར་ན།",
    "རྒྱ་ནག་གཞུང་གིས་བོད་ནང་གི་ཀིརྟིའི་དགོན་ཁག་དང་འབྲེལ་ཡོད་མང་ཚོགས་བཅས་ལ་རྒྱུན་དུ་དམ་དྲག་དམིགས་བསལ་གྱིས་བྱེད་བཞིན་ཡོད་པ་ལྟར།",
    "བཙིར་གནོན་སོགས་རྒྱུན་དུ་བྱེད་བཞིན་ཡོད་པ་རེད།",
    "དེ་རིང་སྔ་དྲོར་ཉེན་རྟོག་པ་ཁག་ཅིག་ཡོང་ནས་ཁོང་མོ་འདྲུད་ནས་རླངས་འཁོར་ནང་དུ་བཅུག་སྟེ་བཙན་འཁྲིད་བྱས་ཡོད་འདུག་ལ།",
    "མང་ཚོགས་ཀྱིས་ལྟོས་དང་།",
    "ཉེན་རྟོག་པ་ཁག་ཅིག་ཡོང་ནས་ཁོང་མོ་བཙན་ཁྲིད་བྱས་ཏེ་རང་ཁྱིམ་དུ་ཀློད་ཡོད་པ་མ་ཟད།",
    "༤ བོད་དུ་ཕྱིར་ལོག་བྱེད་མཁན་ཚོར་ཁྱིམ་ཐོ་མ་སྤྲད་པར་དཀའ་ངལ་འཕྲད་ཀྱི་འདུགརྒྱ་ནག་གཞུང་གིས་རྒྱ་གར་དང་བལ་ཡུལ་སོགས་ནས་ཕྱིར་བོད་དུ་ལོག་པའི་བོད་མི་མང་པོར་ལོ་ཤས་རིང་ཁྱིམ་ཐོ་སྤྲོད་ཀྱི་མེད་པའི་རྐྱེན་གྱིས་ལས་ཀ་མི་རག་པ་དང་ས་གནས་གཞན་དུ་འགྲོ་སྐྱོད་མི་ཐུབ་པའི་དཀའ་ངལ་འཕྲད་ཀྱི་ཡོད་འདུགརྒྱ་ནག་གཞུང་གིས་བོད་ནས་བཙན་བྱོལ་དུ་ཕྱིན་པ་རྣམས་རིམ་གྱིས་ཁྱིམ་ཐོ་ནས་མེད་པ་བཟོས་པ་དང་།",
    "ལོ་༦ རིང་གཏན་ནས་བཟོ་ཐུབ་ཀྱི་མ་རེད།",
    "དེའི་རྗེས་ནས་བཟོ་ཐབས་བྱས་ན་འགྲིག་གི་ཡོད་སྐོར་འགྲེལ་བརྗོད་བྱས་བྱུང་ཟེར།",
    "ལྷ་སར་གནས་སྡོད་བོད་མི་ཞིག་གིས།",
    "ཡང་འབྲེལ་ཡོད་བོད་མི་གཞན་ཞིག་གིས།",
    "སྤྱིར་རྒྱ་ནག་གཞུང་གིས་ཕྱི་ལ་ཡོད་པའི་བོད་མི་མང་པོ་ཞིག་མིང་ཐོ་ནག་པོའི་ནང་དུ་བཅུག་ཡོད་པ་དང་།",
    "རྒྱ་ནག་གཞུང་གིས་ཕྱིར་ཕ་ཡུལ་དུ་ལོག་པའི་བོད་མི་རྣམས་ལ་ལོ་ཤས་རིང་ཁྱིམ་ཐོ་སྤྲོད་ཀྱི་ཡོད་ཀྱང་།",
    "ཁོང་གི་ཕ་ཡུལ་ཇོང་པ་གྲོང་བརྡལ་གྱི་ཉེ་འཁྲིས་རི་སྒང་ཞིག་ནས་མཚམས་ལ་བཞུགས་ཡོད་པ་དང་།",
    "ཕྱི་ལོ་༡༩༨༨ ཡས་མས་ཙམ་ལ་དོ་རྒྱལ་དང་འབྲེལ་བའི་གནས་སྟངས་ཤིག་གི་རྐྱེན་བྱས་ཏེ།",
    "ད་སྐབས་གར་ཡོད་འདིར་ཡོད་ཀྱི་གནས་ཚུལ་གང་ཡང་ཤེས་རྟོགས་ཐུབ་ཀྱི་མེད་པ་རེད།",
    "དེ་ནི་རྒྱ་ནག་གི་ཁ་གཡར་ས་ཙམ་ལས་དོན་དངོས་མ་རེད།",
    "བོད་ནང་དུ་རྒྱ་ནག་གཞུང་གིས་དམ་དྲག་ཤུགས་ཆེན་བྱེད་བཞིན་ཡོད་པའི་རྐྱེན་གྱིས་ཞིབ་ཕྲའི་གནས་ཚུལ་ཤེས་རྟོགས་ཐུབ་ཀྱི་མི་འདུག་པས་མུ་མཐུད་རྩད་གཅོད་བྱེད་མུས་ཡིན།",
    "གོང་རིམ་གྱི་བཀའ་ལྟར་ཁང་པ་རྒྱག་གིན་ཡོད་པ་ལས།",
    "རྩྭ་ཆུ་འཛོམས་ཤིང་མཛེས་སྡུག་གི་མཐོ་སྒང་དེར་རྒྱ་ནག་གི་དམག་སྒར་ཆེན་པོ་ཞིག་འཛུགས་ཉེན་ཡོད་སྐོར་འགྲེལ་བརྗོད་བྱས་བྱུང་།",
    "གནས་སྤོར་བྱས་པའི་བོད་མི་དུད་ཚང་རེ་རེར་རྒྱ་སྒོར་ཁྲི་གཅིག་རེ་ཡི་རོགས་སྐྱོར་སྤྲོད་རྒྱུའི་ཁས་ལེན་བྱས་ཡོད་ཀྱང་ཕྱིས་སུ་སྤྲད་མེད་པ་དང་།",
    "དུད་ཁྱིམ་མང་པོའི་ནང་མི་རེ་འགའ་མཚེར་རྙིང་དུ་ལྷག་ཡོད་པ་དང་།",
    "འདས་པའི་ལོ་མང་ནས་བཟུང་རྒྱ་ནག་གཞུང་གིས་བོད་ཡུལ་གང་སར་རོང་འབྲོག་མང་ཚོ་ཁྲི་ཚོ་མང་པོ་བཙན་གྱིས་གནས་སྤོར་དུ་བཅུག་པ་དང་།",
    "རྩི་ཤིང་ནགས་ཚལ་འཛོམས་ཤིང་ལྟ་ན་སྡུག་པའི་མཛེས་ལྗོངས་མང་པོ་ཞིག་རྒྱལ་ཁབ་སྤྱི་གླིང་དང་ནགས་ཚལ་གླིང་ཟེར་བ་སོགས་ཀྱི་མིང་བཏགས་ནས་ཡུལ་སྐོར་ས་ཚིགས་སུ་བསྒྱུར་དང་སྒྱུར་མུས་ཡིན་པ་རེད།",
    "སང་ཉིན་ནས་བཟུང་ཉིན་ལྟར་ཏོག་དབྱིབས་བརྟག་དཔྱད་བྱེད་པལའང་རྒྱ་སྒོར་༥ རེ་སྤྲོད་དགོས་ཀྱི་ཡོད་པ་དེ་དཀའ་ངལ་ཡིན་སྐོར་བརྗོད་བྱུང་།",
    "གསེར་ལུང་གྲོང་ཚོའི་བུ་མོ་རང་ལོ་༢༦ ཡིན་པའི་འཛམ་དཀར་དང་།",
    "ཁྱོན་མ་དངུལ་སྒོར་དུང་ཕྱུར་༢༩ ལྷག་ཅིག་དང་།",
    "མཐའ་མཚམས་ཀྱི་བརྟན་ལྷིང་སྲུང་སྐྱོང་བྱེད་པ་སོགས་ཀྱི་ཐད་ནུས་པ་གལ་ཆེན་འཐོན་རྒྱུ་རེད།",
    "ལས་གཞི་དེ་ནི་རྒྱ་ནག་དབུས་གཞུང་གི་ཕྱི་ལོ་༢༢༡ ནས་༢༢༥ ལོ་བར་གྱི་ལྔ་ཚན་༡༤ པའི་ལས་གཞི་ཡི་ཆ་ཤས་ཤིག་དང་།",
    "དེ་ནི་རྒྱ་ནག་དམར་ཤོག་ཚོགས་པའི་དབུས་རྒྱུན་གྱི་ཕྱི་ལོ་༢༣༥ བར་ཀྱི་ཕུགས་རྒྱང་རིང་བའི་ལས་འཆར་ཞིག་ཡིན་སྐོར་བསྒྲགས་ཡོད་པ་རེད།",
    "དུས་ཡུན་ཐུང་ངུ་ཞིག་གི་ནང་ཆུ་མཛོད་ཀྱི་ལས་གཞི་ཤུགས་ཆེན་འགྲོ་བཞིན་པའི་དམིགས་ཡུལ་ནི།",
    "རྒྱ་ནག་གཞུང་གིས་རྒྱ་གར་དུ་བཞུར་བཞིན་པའི་ཆུ་བོར་སྟངས་འཛིན་བྱེད་ཐུབ་ཆེད་དང་།",
    "བོད་ནི་ཨེ་ཤ་ཡའི་ཆུ་བོ་ཆེན་པོ་ཁག་གི་འབྱུང་ཁུངས་ཡིན་ཞིང་།",
    "བོད་ཀྱི་ཆུ་གློག་གི་ཐོན་ཁུངས་ནི་རྒྱ་ནག་རྒྱལ་ཡོངས་ཀྱི་གློག་གི་ཐོན་ཁུངས་ཀྱི་སུམ་ཆའི་གཅིག་ཙམ་ཟིན་གྱི་ཡོད་པ་དང་།",
    "བོད་ནང་ཆུ་ལོག་དང་རི་ཉུལ་བྱུང་བའི་དོན་རྐྱེན་བསྟུད་མར་འབྱུང་གི་ཡོད་ལ།",
    "བདུན་ཕྲག་གཅིག་གི་ནང་རི་ཉིལ་ཐེངས་གཉིས་བྱུང་ནས་ཆུ་བོའི་བཞུར་རྒྱུན་འགག་སྟེ་འགྲམ་རྒྱུད་ཀྱི་མི་མང་ལ་ཛ་དྲག་དཀའ་ངལ་ཆེན་པོ་འཕྲད་ཡོད་པ་རེད།",
    "སྒོ་ཕྱི་ནང་དུའང་མི་གཉིས་ཀྱིས་སྐྱོར་ཏེ་མ་སོང་ན་རང་འགུལ་གྱིས་འགྲོ་སྐྱོད་ཐུབ་ཀྱི་མེད་པ་རེད།",
    "འདས་པའི་ལོ་ངོ་འདི་དག་རིང་རྒྱ་གཞུང་གིས་བོད་མི་ཚོར་རྒྱལ་ཁབ་ཀྱི་གསང་བ་ཕྱིར་གྱར་དང་།",
    "ཡང་ན་ཟླ་ཤས་ཀྱི་རྗེས་སུ་འདས་གྲོངས་སུ་ཕྱིན་པའི་ཡིད་སྐྱོའི་གནས་ཚུལ་བསྟུད་མར་བྱུང་ཡོད་པ་རེད།",
    "ཁོང་མོའི་བཟའ་ཟླའི་མིང་ལ་ཉི་མ་ཟེར་ཞིང་།",
    "ནག་ཉེས་ག་རེ་བཙུགས་ཡོད་མེད་སོགས་གང་ཡང་གསལ་ཁ་མེད་པ་རེད།",
    "ལྷ་སར་ཡོད་པའི་སྒོ་ཤེས་རབ་ལགས་ཀྱི་སྲིང་མོ་གཉིས་ནས་ད་ལྟ་བར་དུ་རྩམ་པ་རྒྱ་མ་ལྔ་ཙམ་ལས་གཞན་ཟས་གོས་སོགས་གང་ཡང་མཁོ་སྤྲོད་ཐུབ་མེད་ལུགས་བརྗོད་བྱུང་།",
    "བོད་ཕྱི་ནང་གཉིས་ཀྱི་བོད་མི་ཚོས་སྒེར་གྱི་དྲ་ལམ་སོགས་སུ་ཁོང་གི་སྐུ་པར་བཏང་སྟེ།",
    "ཁོང་གིས་མི་རིགས་ལ་བཟུང་བའི་འདུ་ཤེས་སོགས་ལ་བསྔགས་བརྗོད་དང་ཡི་རང་བྱས་ཡོད་པའི་ཁྲོད།",
    "བོད་མི་ཞིག་གིས།",
    "ཁོ་ཚོའི་སེམས་ནས་ཀྱང་ནག་ཉེས་ཅན་ཞིག་རེད་དོ་སྙམ་པའི་འདུ་ཤེས་གཏིང་ཟིན་པར་གནས།",
    "ཡང་གཞན་ཞིག་གིས།",
    "ང་ཚོ་སད་རན།",
    "༢༨ལོའི་ས་བྱི་ཞི་རྒོལ་ཆེན་མོ།",
    "ཕྱི་ཟླ་༡ ཚེས་༢༡ དང་༢༢ བར་ལ་རྒྱ་ནག་གཞུང་གིས་ལོ་བཅོ་བརྒྱད་མ་ལོན་པའི་བྱིས་པ་ཚོ་གྲྭ་བ་བྱས་མི་ཆོག་ཟེར་ནས།",
    "དགོན་ནང་དུ་དམག་མི་འགྲེམས་འཇོག་གིས་ལྟ་སྲུང་དང་བཀག་འགོག་བྱས་ནས་བསྡད་ཡོད་པ་མ་ཟད།",
    "ཕྱི་ཟླ་༡ ཚེས་༡༣ ཉིན་ལས་མི་ཞིབ་བཤེར་དང་ངལ་རྩོལ་ར་བར་འགྲོ་མཁན་ལས་མི་ཚོས་ཞྭ་མོ་གྱོན་མེད་པའི་རང་གི་ཕྱེད་པར་གཉིས་རེ་དང་།",
    "ལས་མི་ཚོར་གླ་ཆ་ཧ་ཅང་དམའ་བོ་དང་བུད་མེད་ཅིག་ལ་ཟླ་རེར་གླ་ཆ་རྒྱ་སྒོར་༩ དང་སྐྱེས་པ་ཞིག་ལ་རྒྱ་སྒོར་༡༢ སྤྲོད་རྒྱུ་དང་།",
    "ཁྱིམ་བདག་དང་ས་གནས་མི་མང་སོགས་ཀྱིས་མོས་མཐུན་མེད་པའི་བསམ་འཆར་ཤུགས་ཆེན་ཡོང་གི་ཡོད་པ་དང་།",
    "ཡང་རྩོམ་པ་པོ་མཛོད་དགེ་མཐའ་སྒྲོལ་གྱིས་བྱིས་པ་ཞིག་ཨ་མའི་མངལ་དུ་ཆགས་ནས།",
    "ད་ལྟའི་ཆར་ག་ཚོད་ཡོད་མེད་ཤེས་མ་སོང་།",
    "སྔོན་ཆད་ང་རང་བོད་དུ་ཡོད་སྐབས་བཞི་ལྔ་ཞིག་ཡོད་པ་རེད་ཅེས་བརྗོད་བྱུང་།",
    "ཕ་མ་ཁག་ཅིག་གིས་གཞུང་ལ་ངོ་རྒོལ་བྱེད་སྐབས།",
    "རྒྱ་ཡིག་གཙོར་བཟུང་གིས་སློབ་འཁྲིད་ཀྱི་ལམ་དུ་ཞུགས་བཅུག་སྟེ།",
    "དེང་སྐབས་བོད་ནང་དར་སྲོལ་ཆེ་བའི་མགྱོགས་འཕྲིན་ཟེར་བ་དེ་རེད།",
    "མགྱོགས་འཕྲིན་རྩེ་མཁན་ཕལ་ཆེ་བ་གཞོན་སྐྱེས་རྐྱང་རྐྱང་ཡིན་པ་རེད།",
    "དེ་འབྲེལ་གནས་ཚུལ་ནང་ད་ལོ་ནས་བཟུང་ཀྲུང་ཧྭ་མི་རིགས་ཀྱི་མཐོང་ཚོར་གཟུགས་བརྙན་སྔར་ལས་བརྟན་པོ་འཛུགས་པ་དང་།",
    "རྒྱ་ཆེའི་མང་ཚོགས་ལ་ཏང་གི་བཀའ་དྲིན་དྲན་པ་དང་ཏང་གི་བཀའ་ལ་ཉན་པ།",
    "ཏང་གི་རྗེས་སུ་འབྲང་བ་བཅས་ཀྱི་ཆོད་སེམས་བརྟན་པོ་འཛུགས་ཆེད།",
    "ཏང་གི་བཀའ་དྲིན་བརྗེད་མེད་ཀྱི་འདུ་ཤེས་ལེགས་པར་མཚོན་བཞིན་ཡོད།",
    "བཅོས་མིན་ཡིད་ཆེས་དེ་ཡིད་ཆེས་རྫུན་མ་ཞིག་ལ་བརྗེ་བོ་རྒྱག་ཐབས་བྱེད་རྒྱུ་དེ་རེད།",
    "ཅེས་བརྗོད་འདུགཡང་ཕྱི་ལོ་༢༡༧ ལོ་ནས་རྒྱ་ནག་གཞུང་གིས་དབུལ་སྐྱོབ་དགོས་ན་སྐུ་པར་བཤམ་དགོས་ཞེས་པའི་ལས་འགུལ་ཞིག་བཙན་གྱིས་སྤེལ་ཏེ།",
    "ཁྱིམ་དུ་༧གོང་ས་མཆོག་གི་སྐུ་པར་བཤམ་ཡོད་པ་མཐོང་ཚེ།",
    "ཁོང་གི་ཞབས་རྗེས་འབྲངས་ན་སོ་སོར་ཆག་སྒོ་འབྱུང་རྒྱུ་ཡིན་སྟབས།",
    "དེ་ལས་རྒྱ་ནག་གཞུང་གི་རྗེས་སུ་འབྲངས་ན་ཡག་པོ་ཡོང་སྐོར་བརྗོད་ཡོད་པ་མ་ཟད།",
    "མཐར་རྒྱ་ནག་གཞུང་གིས་ཁོང་ལ་ན་ཚ་ཞིག་ཕོག་ཡོད་པས་ལེན་དུ་ཤོག་ཅེས་ནང་མིར་རྩིས་སྤྲད་ཡོད་འདུག་ཅེས་བརྗོད་བྱུང་།",
    "ཡང་ཁོང་གིས།",
    "ཁོང་གི་སྤུན་མཆེད་ཀྱིས་མཆན་འོག་ཏུ་བྱིས་པ་ཞིག་བཅུག་ཡོད་པ་ནང་བཞིན་གྱིས་འཁྱེར་ཡོང་ཡོད་པ་རེད།",
    "བཀྲ་ཤིས་ཕུན་ཚོགས་ལགས་ཀྱིས་སྣེ་འཁྲིད་པའི་ཡུལ་མི་རྣམས་ཀྱིས་རྒྱ་གཞུང་གི་ཤིང་ནགས་འབྲེལ་གཅོད་ཀྱི་ལས་འགུལ་དེ་བཀག་འགོག་གིས་ངོ་རྒོལ་གྱི་ལས་འགུལ་སྤེལ་ཡོད་སྟབས།",
    "རྒྱ་ནག་གཞུང་གིས་བོད་ཀྱི་ཆབ་སྲིད་བཙོན་ཟུར་མང་པོར་གཅར་རྡུང་མནར་གཅོད་ཚད་ལས་བརྒལ་བ་བཏང་བ་དང་།",
    "ཕྱི་ལོ་༢༡༣ ཟླ་༡ ཚེ་༢༧་ཉིན་ཁོང་གི་ནང་མིར་རྩིས་སྤྲད་ཡོད་པ་དང་།",
    "༡༩ ཡ་ཆེན་སྒར་ནས་ཕྱིར་འཕུད་བཏང་བའི་བཙུན་མ་ཞིག་གིས་རང་སྲོག་བཅད།",
    "སྔར་ལོའི་ཕྱི་ཟླ་༥ པའི་ནང་རྒྱ་ནག་གཞུང་གིས་བོད་ནང་གི་ཡ་ཆེན་སྒར་ནས་ཕྱིར་འཕུད་བཏང་བའི་བཙུན་མ་ཚོའི་ཁྲོད་ནས།",
    "རྒྱ་ནག་གཞུང་གིས་དམ་དྲག་ཆེན་པོ་བྱེད་བཞིན་ཡོད་འདུགབཙུན་མ་ཁོང་གིས་རང་སྲོག་གཅོད་དགོས་པའི་རྒྱུ་རྐྱེན་སྐོར་ལ་ཁོང་གིས།",
    "མོས་རང་སྲོག་བཅད་རྗེས་བཀག་སྐྱིལ་ཁང་དུ་ཡོད་པའི་བཙུན་མ་གཞན་ཚོས་གནས་ཚུལ་དེ་གོ་བ་དང་ཟས་བཅད་ངོ་རྒོལ་བྱས་ཏེ་ཉིན་ཤས་རིང་ཟ་མ་མ་ཟོས་པ་སོགས་བྱས་ཡོད་སྟབས།",
    "ཁོ་མོས་རང་བཅད་བཅད་རྗེས་རྒྱ་ནག་གཞུང་གིས་བཀག་སྐྱིལ་ཁང་གི་བཙུན་མ་གཞན་ཚོར་སྔར་ལས་དམ་དྲག་དང་རྡུང་རྡེག་མནར་གཅོད་བཏང་ཡོད་པ་མ་ཟད།",
    "འདི་གར་འབྲེལ་ཡོད་ཅིག་གིས་གནས་ཚུལ་མཁོ་སྤྲོད་གནང་བ་ལྟར་ན།",
    "རྒྱ་ནག་གི་ཆབ་སྲིད་དང་འགལ་བའི་ལས་ཀ་སོགས་མ་བྱས་ན་འདི་ལོ་ནས་མིང་ཐོ་ནག་པོ་ནས་ལེན་རྒྱུ་ཡིན་སྐོར་བརྗོད་ཡོད་འདུག་ལ།",
    "རྒྱ་ནག་གཞུང་གིས་ཕྱི་རྒྱལ་ནས་བོད་དུ་ལོག་མཁན་ཚོའི་རྒྱབ་ལ་ཉུལ་མ་གཏོང་གི་ཡོད་པའི་སྐོར་ལ་ཁོང་གིས།",
    "ཐ་ན་ཡུལ་ཕྱོགས་གཞན་ལ་སོང་ནས་ཟ་མ་གང་ནས་ཟོས་པ་དང་མི་སུ་དང་ཐུག་འཕྲད་བྱས་པ་སོགས་ཤེས་རྟོགས་བྱུང་གི་ཡོད་པ་དང་།",
    "རྒྱ་ནག་གཞུང་གིས་ཕྱི་ཕྱོགས་ཀྱི་བོད་མིར་བསླུ་བྲིད་གཏོང་ཆེད་བོད་ཀྱི་ས་གནས་ཆེ་ཁག་ཏུ་སྣེ་ལེན་ཁང་གསར་རྒྱག་གིས་ལས་བྱེད་བསྐོ་བཞག་བྱས་ཡོད་པ་དང་།",
    "མང་ཚོགས་དང་ཚོགས་པའི་ནུས་པ་སྔར་བས་ལེགས་པར་འདོན་སྤེལ་བྱ་རྒྱུ་ཡིན།",
    "ཞེས་བསྒྲགས་ཡོད་པ་རེད།",
    "རྒྱ་ནག་གི་འཕེལ་རྒྱས་དང་གུང་ཁྲན་ཏང་གི་སྟོབས་ཤུགས་ཟེར་བ་སོགས་ངོ་སྤྲོད་བྱེད་པའི་ལས་གཞི་ཞིག་མགོ་འཛུགས་བྱས་ཡོད་པ་དང་།",
    "ལྟ་སྐོར་ལ་འགྲོ་ཞོར་གུང་ཁྲན་ཏང་གི་འཕེལ་རྒྱས་དང་སྟོབས་ཤུགས།",
    "རྒྱ་ནག་གིས་བཙན་བྱོལ་བོད་མི་ཚོ་ཕྱིར་བོད་དུ་ལོག་ཐབས་སྣ་ཚོགས་བྱེད་བཞིན་པ་དེ་ནི།",
    "དུས་རབས་༢ པའི་ལོ་རབས་༨ ནས་བཟུང་ཕྱི་ལ་སོང་སྟེ་ཕྱི་རྒྱལ་དུ་གནས་སྡོད་བྱས་ཡོད་པའི་བོད་རིགས་སྤུན་ཟླའི་ལས་དོན་ཟེར་བར་ཤུགས་སྣོན་དགོས་པ་མ་ཟད།",
    "ཕྱི་ན་ཡོད་པའི་བོད་རིགས་ཀྱི་མི་རབས་གཉིས་པ་དང་གསུམ་པའི་འབྲེལ་གཏུག་གི་ལས་དོན་ཡག་པོ་སྒྲུབ་སྟེ།",
    "བོད་ནང་གི་འབྲེལ་ཡོད་སུ་གང་ལའང་འབྲེལ་བ་བྱེད་ཐུབ་ཀྱི་མི་འདུག་པས་གནས་ཚུལ་ག་འདྲ་ཡིན་གསལ་བོ་ཤེས་ཐབས་མེད་སྐོར་བརྗོད་བྱུང་།",
    "མི་མང་ལ་མགོ་སྐོར་བསླུ་བྲིད་དང་མང་ཚོགས་ལ་མངོན་ལྐོག་གཉིས་ནས་རྨོངས་དད་ཀྱི་བསམ་བློ་བསྒྲགས་པ།",
    "ཕྱི་ལོ་༢༡༩ ལོའི་ཟླ་༦ ནང་རྒྱ་ནག་གཞུང་གིས་བཏང་བའི་ནག་སེལ་གཤེད་བཅོམ་ལྟ་སྐུལ་མཛུབ་ཁྲིད་ཚོགས་ཆུང་༡༣ པ་ཟེར་བ་དེས།",
    "ཐལ་སྤྱོད་རིང་ལུགས་པ་བཅས་ཡིན་ལ།",
    "ལྷག་པར་དུ་ཁ་བྲལ་རིང་ལུགས་པ་ཚོར་ལས་འགུལ་འདིའི་ཁྲོད་ནས་གུ་ཡང་གཅིག་ཀྱང་མེད་ཅེས་བརྗོད་ཡོད་པ་རེད།",
    "ཀོའུ་ཡི་བུ་དེ་ཕྱི་ལོགས་སུ་ཐེངས་མང་པོར་སོང་ནས་མི་མང་པོ་འབྲེལ་འདྲིས་དམ་ཟབ་བྱས་ཡོད་སྟབས།",
    "རྒྱ་ནག་གི་བྱེད་སྟངས་དེ་ནི་ཧང་སང་དགོས་པ་ཞིག་མིན།",
    "འགྲོ་བ་མིའི་བྱ་སྤྱོད་ལས་འདས་པའི་བྱེད་ཐབས་དེ་ང་ཚོས་བཟོད་སྒོམ་བྱེད་ཐབས་མི་འདུག་ཅེས།",
    "ཝུ་ཧན་ནས་རྒྱ་ནག་གི་ས་ཆ་གཞན་དུ་འཕུར་མཁན་གནམ་གྲུ་ཚང་མ་འཕུར་མཚམས་བཞག་ཡོད་ཀྱང་།",
    "མང་ཚོགས་ཀྱིས་ཁོ་རང་མཐོན་པོའི་མཐོན་པོར་བསྒྲེངས་ཡོད།",
    "དྲིལ་བསྒྲགས་པུའུའི་པུའུ་གཙོ་རེད།",
    "༢༡༣ལོའི་ཟླ་༡༢པའི་ཚེས་༡༦ཉིན་བློ་མཐུན་པི་ཧྲི་ཞང་གཞི་རིམ་དུ་ཟབ་འཇུག་བྱས་ནས་མང་ཚོགས་ལས་དོན་སྒྲུབ་པར་ཕེབས།",
    "འདས་དུས་དགུང་ལོ་ལྔ་བཅུ་ང་གསུམ་རེད།",
    "ཁོང་གི་རྒྱལ་གཅེས།",
    "ཐོག་མཐའ་བར་གསུམ་དུ་གུང་ཁྲན་ཏང་མིའི་བསམ་བློའི་འཚོལ་ཞིབ་རྒྱུན་འཁྱོངས་པ།",
    "ཆབ་སྲིད་བརྟན་པོར་འཛིན་ཞིང་ཏང་དང་དྲན་བསམ་གཅིག་པའི་ལས་བྱེད་ཡག་པོ་ཞིག་རེད།",
    "ཁོང་གི་སེམས་པ་མང་ཚོགས་དང་སྦྲེལ་ཞིང་དགེ་སེམས་ཆེ་བ།",
    "ལས་གནས་སུ་ཀྲོང་ངེར་འགྱིངས་ཞིང་ཏང་གི་དགོངས་དོན་ལག་ལེན་བསྟར་བའི་དཔེ་མཚོན་ཡིན།",
    "མང་ཚོགས་ལ་ཞབས་འདེགས་ཞུ་ཞིང་དམངས་དང་བློ་ཉེ་བའི་ལས་བྱེད་ཡག་པོ་ཞིག་རེད།",
    "ཁོང་ནི་ནན་ནན་ཏིག་ཏིག་དང་མགོ་སངས་དོན་ཐོན་གྱི་ལས་བྱེད་ཡག་པོ་ཞིག་རེད།",
    "ཏང་གི་སྒྲིག་ལམ་བསྲུངས་པ།",
    "ཏང་གི་ཀུན་སྤྱོད་སྤུས་གཙང་རྒྱུད་འཛིན་བྱས་པ།",
    "དཔེར་ན་མཐོ་སྒང་གི་ཉི་འོད་ཀྱིས་ཚེ་སྲོག་ལ་གསོན་ཤུགས་གནང་བ་དང་གངས་ཆུ་བསིལ་མས་སྲ་བརྟན་གྱི་གཞི་ཆེན་བརླན་པར་བྱས་པ།",
    "ཡང་ན་རྩྭ་ཐང་གི་ནོར་ནག་གིས་བདེ་སྐྱིད་ཀྱི་འཚོ་བ་ཕྲག་ཏུ་ཁུར་བ་ཇི་བཞིན་རེད།",
    "བགྲང་བྱ་བཅོ་ལྔའི་སྟོན་དཔྱིད་ནི་ངའི་མི་ཚེའི་གཏན་འཇགས་ཀྱི་དྲན་སྣང་རེད།",
    "གངས་རིའི་བུ་ཕྲུག་ས་གཞི་ཆེན་པོས་ཁྱོད་ལ་སྲ་བརྟན་གྱི་རྨང་རྡོ་བསྐྲུན།",
