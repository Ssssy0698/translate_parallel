    "རང་ཉིད་ཀྱང་གནས་ལ་མི་གནས་པར་འདུག་པར་མི་བྱ་སྟེ།",
    "དགེ་སློང་རང་ཉིད་ཀྱིས་རྐུའམ།",
    "མ་བྱིན་པའི་ཁྱད་པར་ཡང་རང་ལས་ཡ་། རྫས་ཐ་དད་པའི་མིའི་རྒྱུད་ཀྱིས་ཡོངས་སུ་བཟུང་བའོ།",
    "རྟེན་དགེ་སློང་རང་ལས་རྫས་ཐ་དད་པའི་བདག་པོ་ཉིད་དང་མ་བྲལ་བ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "སྐབས་འདིའི་རྒྱ་དཔེ་དང་རང་འགྲེལ་ན་རང་བཞིན་མི་མཐུན་པའི་ཞལ་ལྟ་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "འཐག་གཉིས་གོས་གཉིས་འདུག་གནས་དང་།",
    "གསོད་པ་གཅེར་བུ་རིང་འདུག་དང་།",
    "དབེན་པ་ན་འདུག་པའི་དང་།",
    "གཉིས་ལ་འདུག་གནས་སུ་ཟ་བ་ལ་གཉིས་ཏེ།",
    "ལྷག་པོར་མ་བྱས་པ་འདུག་གནས་གཅིག་པོ་དེ་ཉིད་དུ་ཟོས་ན།",
    "གློ་གཡས་གཡོན་ན་འདུག་པ་མ་ཡིན་པ་ལ་འཆད་དགོས་པའི་ཕྱིར།",
    "དེ་ལྟར་ན་ནོད་པ་པོའི་རྒྱབ་ན་སྟོབས་པ་པོ་འདུག་ཀྱང་ཡན་ལག་གཞན་རྣམས་ཚང་ན་བྱིན་ལེན་ཐོབ་པ་ཡིན་ནོ།",
    "རས་ལིང་རང་ཆུ་ངལ་པོའི་སྟེང་དུ་གཏིང་ནས་ཆུ་བཅུ་པ་ཞིག་ལ་ཕལ་ཆེར་གྱིས་འདོད་ལ།",
    "ཉལ་པོ་བྱེད་པར་བཤོམས་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "ཆོ་ག་རྣམ་པར་དག་པའི་རྒྱུ་ལ་དེར་བསྒྲུབ་པ་གཅིག་དུས་ཁྱད་པར་ཅན་གྱི་ཆོ་ག་ལ་དེར་བསྒྲུབ་པ་གསུམ།",
    "འགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པ་ཡིན་ལ།",
    "རབ་ཏུ་བྱུང་བ་མེད་ཅིང་རང་ཉིད་དགེ་སློང་དུ་རློམ་པ་མ་ཡིན་པའི་ཕྱིར།",
    "འདུག་གནས་ཕྱེ་དང་བཅའ་དང་དུས་མིན་དང་།",
    "ཉལ་བཤོམ་ཁྱིམ་ན་འདུག་དང་འགྲེང་བ་དང་།",
    "མ་སྒོ་སྟན་འདུག་རྩ་སྔོན་མི་གཙང་འདོར།",
    "མཐུན་རྐྱེན་བརྟེན་ཚུལ་ནི་འདུག་མ་ལགཔའི་སོགས་སོ།",
    "དང་པོ་ལྟར་ན་ཁྱེད་ཅག་དུས་དེར་འོད་དམར་བསྲུང་བ་ཡིན་ནོ།",
    "རྟགས་ལ་འགྲོ་མཚམས་རྒྱུམི་འདུག་པས་ལྡོག་ན་འཁོར་གསུམ་ལས་མ་འདས་པའི་ཕྱིར་དང་།",
    "གཉིས་པ་ནི་མི་འདུག་པར་འགྲེང་བར་སོགས་སོ།",
    "འགྲེང་བ་ཡང་མི་འཚལ་འདུག་པ་དང་ཉལ་བ་ཡང་མི་འཚལ་ན།",
    "བྱིན་གྱིས་བརླབ་པར་འོས་པ་རྣམས་བྱིན་གྱིས་བརླབས་ཟིན་པ་ཞིག་བྱས་ཏེ་འདུག་པར་བྱའོ།",
    "ཡང་དགེ་སློང་གང་གཞན་གྱི་གྲོང་ན་འདུག་པའམ།",
    "དེའི་མདུན་དུ་འདུག་སྟེ།",
    "ཙོག་པུར་འདུག་སྟེ།",
    "རྒན་པའི་མཐར་ཙོག་པུར་འདུག་སྟེ།",
    "དགག་དབྱེ་བྱེད་པ་པོའི་མདུན་དུ་ཙོག་པུར་འདུག་ལ།",
    "དབྱུང་བ་ལ་ནི་དངོས་པོ་མེད་པ་དང་རང་ཅིག་པུས་ཀྱང་རུང་ལ།",
    "ཡང་དག་སྦྱངས་དང་རང་བཞིན་དང་།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ།",
    "ཁྱེད་རང་དགེ་སློང་དུ་ཁས་བླངས་ནས་པཎ་ཆེན་བརྒྱུད་ཀྱི་དགེ་སློང་མང་པོ་ལ་གཞི་མེད་པར།",
    "ལས་བརྒྱ་རྩ་ཐམས་ཅད་འདུག་པའི་སྤྱོད་ལམ་གྱིས་བྱ་དགོས་ཏེ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ་ཞེས་དང་།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ་ཞེས་དང་།",
    "ལས་རང་རང་ངོ་བོའི་གནས་སུ་བློ་མཐུན་པས་ལས་གཞན་གྱི་གནས་སོ་གཉིས་སུ་མི་འགྱུར་བའི་ཕྱིར་དང་།",
    "བློ་མཐུན་ནམ་ཁོ་རང་དང་ལྟུང་མཐུན་བྱིན་བརླབས་མ་གཏོགས་ལས་ཐམས་ཅད་ཀྱི་སྔོན་འགྲོ་ཡིན་གསུངས་པ་དང་པཎ་ཆེན་ཤཱཀ་མཆོག་བཀའ་འབུམ་འཚམས་བུ་ཆུང་དང་དཀྱིལ་འཁོར་པ་གཅིག་ཏུ་བཞེད་པ་ཡང་མི་ལེགས་པར་གྲུབ་པ་ཡིན་ནོ།",
    "བདག་དུས་འདི་ནས་བཟུང་སྟེ་སང་ཉི་མ་ཤར་གྱི་བར་དུ་བསྙེན་གནས་པར་བཙུན་པས་བཟུང་དུ་གསོལ།",
    "བྱིན་གྱིས་བརླབས་པས་ཕྱིར་བཅོས་ཏེ་འདུག་པར་བྱའོ།",
    "བསྒྲུབ་བྱ་དེ་བསྙེན་པར་རྫོགས་པའི་ལས་གྲལ་དུ་འདུག་དགོས་པ་ཁྱབ་པ་ཡང་མེད་པའི་ཕྱིར།",
    "སྔར་བསྟན་མ་ཟིན་པའི་ལྷུང་བཟེད་ཞིག་དུས་གཞན་གྱི་ཚེ་བྱིན་གྱིས་རློབ་པ་ན།",
    "ལས་གྲལ་དེར་འདུག་དགོས་པ་མ་ཡིན་ཏེ།",
    "མ་འདུག་ཀྱང་ལས་མི་འཆགས་པའི་ཉེས་པ་མི་མཐུན་པ་བསྐྱེད་པ་ཡང་མེད་ཅིང་།",
    "ལས་གྲལ་དེ་ཉིད་དུ་མི་འདུག་དགོས་པའི་ཁྱབ་པ་ཡང་མེད་དེ།",
    "འོན་ཀྱང་གང་ལ་བྱ་བ་དེ་མངོན་སུམ་དུ་མི་འདུག་པའི་ཚེ།",
    "རྒན་པའི་མཐའ་ལོགས་སུ་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "གཎྜི་བརྡུང་བ་ནས་ཙོག་པུར་འདུག་སྟེ།",
    "འདུག་ལ་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "མི་ཐོག་པའི་ཕྱོགས་ན་འདུག་པ་དང་མདུན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ལྷག་པོར་བྱ་བ་མི་འབྱུང་ངོ།",
    "ཐ་མལ་པའི་གཟུགས་སུ་འདུག་པ།",
    "གནས་མེད་ཀྱང་འདུག་ཏུ་རུང་བའི་དམིགས་གསལ་ནི།",
    "ཤེས་པ་ཕྱིར་བཅོས་ཏེ་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ།",
    "འདུག་པ་ན་དྲན་ནམ་ཡིད་གཉིས་ཟ་ན།",
    "དེ་ལས་ཀྱང་སྔ་ཚེས་བྱེད་ན་ཉེས་པ་སྔ་མ་སོ་ན་འདུག་པའི་ཕྱིར།",
    "ཚུལ་དང་མཐུན་པས་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "རྒན་པའི་མཐར་ཙོག་པུར་འདུག་སྟེ།",
    "དགག་དབྱེ་བྱེད་པའི་མདུན་དུ་ཙོག་པུར་འདུག་ལ།",
    "དུས་རུང་ནི་བྱིན་གྱིས་མ་བརླབས་ཀྱང་རང་དུས་མ་འདས་ཀྱི་བར་དུ་སོག་འཇོག་མི་འབྱུང་ལ།",
    "གསོ་སྦྱོང་ཡང་རང་གཅིག་པུས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཁས་པཎ་ཆེན་ཤཱཀ་མཆོག་བཀའ་འབུམ་ལེན་ན་རྩོད་པ་མི་འདུག་པའི་ཕྱིར།",
    "སྟེར་ན་དེས་དགྲ་བཅོམ་པ་མ་ཐོབ་པ་ཡང་རང་བཞིན་དུ་གནས་པར་ཐོབ་པར་འགྱུར་རོ།",
    "རང་འབྱུང་རང་རིག་ཀ་དག་ལྷུན་གྱིས་གྲུབ།",
    "རྩམ་གཟན་ཙམ་མིན་འགྲོ་ལ་ཐར་ལམ་བསྟན།",
    "དེའང་རང་ངོས་ནས་རྣམ་པ་ཀུན་གྱི་མཆོག་དང་ལྡན་པའི་སྟོང་པ་ཉིད་དང་།",
    "རྗེ་ཉིད་ནི་གང་ཅིར་ཕ་ལ་རོགས་དོན་གྱིས་ཕན་ཐོགས་པའི་ཉམས་སུ་མི་འདུག་པའི་ཐད་ནས།",
    "རི་གསེབ་ཅིག་ན་བྱ་བྲལ་བའི་ཚུལ་དུ་འདུག་པ་ཞིག་ནམ་ཞིག་ན་འོང་སྙམ་པའི་ཐུགས་འདུན་ཡང་ཡང་བཏང་བས།",
    "གྲུབ་རྗེའི་དམྱལ་སྣང་འདི་ལ་བརྟག་ན་རིག་པའི་རྩལ་ལས་འཆར་ཚུལ་གྱི་བྱེ་བྲག་སྣ་ཚོགས་རང་སྣང་བའི་ལུགས་སུ་འདུག་པས།",
    "ཉམས་ཀྱི་སྣང་བ་གང་ལྟར་ཡིན་ཀྱང་རང་སེམས་ཀྱི་རྩལ་ལས་སྣང་བའི་འཆར་སྒོའི་བྱེ་བྲག་ཡིན་པས་མིང་དུ་འདས་ལོག་ཅེས་བླ་དྭགས་སུ་ཐོགས་ཀྱང་ཤི་ནས་ཡར་ལང་པའི་ཐ་སྙད་མི་སྣང་བས་བྱེ་བྲག་མ་ཕྱེད་ན་དུ་བ་དང་རླངས་པ་གང་ཡིན་ནོར་ཉན་དུའང་སྣང་ངོ།",
    "ཀུན་ཏུ་བཟང་པོ་མཐིང་ཀ་ཞལ་གཅིག་ཕྱག་གཉིས་རྒྱན་མེད་གཅེར་བུ་མངོན་སུམ་དུ་མཇལ་བ་ཞིག་བྱུང་མཆེད་གྲོགས་རྣམས་ལ་ཁྱེད་རྣམས་ཀྱིས་ཅི་ཞིག་མཇལ་དྲིས་པས་འཇའ་གུར་ཞིག་མཐོང་དེ་ལས་གཞན་མཇལ་རྒྱུ་ཅང་མི་འདུག་ཅེས་ཟེར་ཏེ།",
    "ཟེར་ས་གཏན་ནས་མེད་ཅིང་ཚིག་ལན་ཡང་མི་སྟེར་བར་འདུག་པས།",
    "འདི་ཚང་ལོ་གཅིག་ལས་མི་འགོར་བར་ཡུལ་འཕོ་སྐྱས་ཀྱིས་ཐེག་ནས་འགྲོ་དགོས་པར་འདུག་ཅེས་གསལ་བར་ཕེབས།",
    "རྗེ་ཉིད་ཀྱི་ཞལ་སྔ་ནས་གནས་ལུགས་ངོ་སྤྲོད་པའི་རིག་པའི་རང་ངོ་ལ་འཕོ་འགྱུར་འབྲི་བཀོད་མི་འདུག་ཀྱང་ཐུན་དང་ཐུན་མཚམས་དང་ཉིན་མཚན་ལ་ཁྱད་པར་ཡོད་པར་འདུག་ལ།",
    "མདང་རྨི་ལམ་དུ་མི་དམར་རྟ་དམར་ཞིག་བྱུང་བས་ཁྱེད་ཀྱི་སྲུང་མ་དེ་བཙན་ཞིག་ཡིན་འདུག་གསུངས།",
    "ལམ་ལ་རིམ་པར་ཞུགས་པའི་བཀའ་སྲོལ་ལ་བརྟེན་ནས་གདུལ་བྱ་དཀྲི་བ་རྒྱལ་བ་གཉིས་པ་དམ་པ་ཡབ་སྲས་དང་མཉམ་མེད་ཆེན་པོའི་ཕྱག་ལེན་གྱི་ཆེ་བ་ཡིན་པས་ལམ་གྱི་གཞུང་བསྲང་ནས་འབྲེལ་འགྲིགས་ན་དེ་ཉིད་བབས་ཀྱི་མཐར་ཐུག་ཡིན་པས་བློ་གྲོས་ཀྱི་མིག་དང་ལྡན་པ་རྣམས་ཀྱིས་དེ་ལྟར་ཁོང་དུ་ཆུད་པར་བྱ་བ་ཆེས་ལེགས་ཤིང་བསྟན་པའི་གཉེར་ཁ་སྐྱོང་ན་ཚུལ་དེ་ལྟ་བུའི་སྒོ་ནས་ལམ་གྱི་སྲོལ་འཛིན་དགོས་པས་ཁྱེད་ཀྱི་ཐུགས་ངེས་འདྲོང་ཚུལ་དེ་འདྲ་ཕ་ལས་བུ་སྐྱེས་བའི་གཏམ་དུ་འདུག་པས་རྒན་པོ་བདག་ཀྱང་ཡིད་ལྷག་པར་བདེ་ཞིང་རྗེས་སུ་ཡི་རངས་བའི་སེམས་སྐྱེས་པ་ཡིན་ཞེས་དགྱེས་ཚོར་ཆེན་པོ་གནང་།",
    "ཁྲིད་རྣམས་ཟིན་པ་དང་རང་དགོན་སྟེང་ཆེན་བ་དང་།",
    "འོག་མ་དེ་གསལ་པོ་ཞིག་འདུག་པའི་རྒྱབ་ནས་ཉི་མའི་དཀྱིལ་འཁོར་ཞིག་ཤར་ནས་ཡུལ་ཐམས་ཅད་འོད་ཟེར་གྱིས་གསལ་བ་ཞིག་བྱུང་བ་ལས།",
    "དེར་ཁམས་གསེང་ལ་བྱོན་ཅིག་ཅེས་ནན་བསྐུལ་མཛད་པས་གསན་ནས་གཉིས་ཀ་དེར་ཕྱིན་པས་རིའི་རྩ་བ་ནས་ན་བུན་ཞོ་ཆགས་པ་ལྟར་འཁྲིགས་པའི་ནང་ནས་ཡར་ཕྱིན་པས་གནས་རིའི་རྐེད་པ་ཡན་ཆད་ན་བུན་མེད་པས་ཕྱོགས་ཐམས་ཅད་གསལ་བའི་ཉམས་དགའ་བ་ཞིག་འདུག་པ་ལ།",
    "མགུར་མ་འཐེན་གྱིན་ཕ་ཝཾ་སྟེང་དུ་གར་སྟབས་བསྒྱུར་བ་དང་མཉམ་པར་འཇོག་པའི་སྟངས་བྱས་ནས་དགའ་ཉམས་ཆེན་པོ་བྱེད་འདུག་པས།",
    "ས་ཕྱོགས་འདི་གང་ནས་བལྟས་ཀྱང་ཉམས་སུ་དགའ་ཞིང་གནས་ཆེན་ཁྱད་པར་དུ་འཕགས་པའང་ཡིན་པས་རི་ངོགས་འདིར་རི་ཁྲོད་ཅིག་ཟིན་ན་ཅི་མ་རུང་སྙམ་དུ་དགོངས་ནས་ཐུགས་སྨོན་དང་ཤིས་བརྗོད་ཀྱང་གནང་བར་གདའ།",
    "རྟ་རྫི་བུ་བརྟན་བྱ་བ་ཞིག་སླེབ་འདུག་པས་ས་འདི་ལ་མིང་ཅི་ཡིན་དྲིས་པས་དེ་ལ་གོང་བཀྲ་ཤིས་ཁྱུང་ལུང་ཞེས་ཟེར་བ་ཡིན་ཟེར།",
    "ས་འདི་ཉམས་བདེ་ལ་ས་བཀྲ་ཡང་ལེགས་པ་ཞིག་གདའ་བས་ལེགས་གསུངས།",
    "དེའི་ཚེ་སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པའི་རིང་ལུགས་རྗེས་སུ་སྐྱོང་བ་དང་རང་ཉིད་སྒྲུབ་པའི་གེགས་ལས་གྲོལ་བའི་ཕྱིར་དུ་དམ་བཅའ་འདི་ལྟར་མཛད་པའང་གནང་སྟེ།",
    "རང་རང་བློ་ཡི་བརྟུལ་ཞུགས་ཆེ་ཆུང་དང་།",
    "མཐའ་མདུན་རྟེན་རྣམས་ཀྱི་ཐུགས་དང་རང་སེམས་དབྱེར་མེད་ཀྱི་དགོངས་ཉམས་ཁྱད་པར་ཅན་ཐུགས་ལ་འཁྲུངས།",
    "ཕྱིས་སུ་འདི་སྐོར་ལ་ཞུ་གནང་བགྱིས་པས་དེ་དུས་རྣམས་སུ་དམ་ཚིག་མ་ཉམས་པའི་རྟགས་ཁོ་ན་འོང་འདུག་ལ།",
    "ཕྱིས་སུ་ནི་དམ་ཚིག་ཉམས་པའི་རྟགས་ཀྱང་འོང་འདུག་ཅིང་།",
    "འོན་ཀྱང་བྱད་ཁ་ཆེན་པོ་ཞིག་འཁོར་འདུག་གསུངས་ནས་ཧ་ལས་པ་ལྟར་མཛད།",
    "ཉམས་ལེན་སྐོར་གྱི་རྟོགས་པ་ཕུལ་བས་ཉམས་རྟོགས་མཐོན་པོར་འདུག།",
    "ཐོན་ཕྱག་ཞུས་པས་ཁྱེད་ཀྱི་དབེན་གནས་དེ་ཡང་གནས་རི་ཁྱད་འཕགས་ཤིག་ཡིན་འདུག་པས་གནས་སྒོ་འབྱེད་པ་ཞིག་ཀྱང་མི་རིང་བར་འོང་བར་སྣང་བས་ངེས་པར་མཛོད་གསུངས།",
    "ཁྱེད་རྣམས་པས་ཐུགས་བསམ་དེ་ལྟར་མཆིས་ཚེ་ཕྱིན་ཆད་བསྟན་པ་ལ་ཕན་པ་དང་བོན་དང་མཐུན་པ་ཞིག་བྱུང་ན་ཁོ་བོ་གར་འདུག་ཁྱད་པར་མེད།",
    "བརྡ་ཡིག་ཀ་དཔེ་ལྟར་ངོས་བཤུས་བགྱིད་ཆོག་པའང་ཡོད་པ་འདུག་ཅིང་།",
    "དགོངས་པའི་གདེང་མེད་པ་ལ་ལྷ་འདྲེའི་བསླུ་བ་དང་རྫས་གཏེར་ལོག་པའང་ཡོད་རིགས་སུ་འདུག་ལ།",
    "ཚེས་བཅོ་ལྔའི་སྔ་དྲོར་ཝཱ་ན་མཚོ་ཁར་ཕེབས་ནས་ཀླུ་མཆོད་རྒྱས་པ་དང་ཀླུ་བསང་ཀླུ་བུམ་བཅས་ཕུལ་ནས་གཡུང་དྲུང་རང་བྱོན་སོགས་ངོ་སྤྲོད་མཛད།",
    "རྗེའི་ཞལ་སྔ་ནས་བསྟན་དོན་ལ་རྩོལ་སྒྲུབ་བྱེད་ན་བྱ་བ་ལས་ཀྱི་འཁོར་ལོ་དང་འབྲེལ་མ་ཞིག་དགོས་འདུག་པས།",
    "མདུན་དུ་ལྗོན་ཤིང་ཆེན་པོ་ཞིག་འདུག་པའི་འགྲམ་ན་པར་རྐོས་པའི་ཤིང་ཕྱེ་རྣམས་ལས་སླར་ཡང་ལྗོན་ཤིང་མེ་ཏོག་དང་འབྲས་བུ་རྒྱས་པ་མང་པོ་སྐྱེས་ཏེ་རི་ལུང་ཐམས་ཅད་ཁེང་བ་ཞིག་རྨིས་བྱུང་ཞེས་ཟེར་ནས་སེམས་ལ་སྤྲོ་བ་སྐྱེས་ནས་འདུག་པ་ལ་ཞུ་གནང་ཞིབ་ཆ་བྱས་ནས།",
    "ད་ལན་ངེད་རང་མཚམས་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་དགེ་སྦྱོར་ལམ་རིམ་གྱི་མཚམས་ལ་འདུག་ཡོད་པ་ཡིན་གསུངས་སྐད།",
    "ལམ་རིམ་སྐོར་ལ་བློས་དཔྱད་སྒོམ་དང་འཇོག་སྒོམ་སྤེལ་མའི་སྒོ་ནས་ཉམས་ལེན་བྱེད་པ་གལ་ཆེ་བའི་ཚུལ་ཤེས་ནས་དགེ་སྦྱོར་བ་མང་པོ་ཞིག་ལ་གོ་བ་སྐྱེས་ཤིང་དུས་ཕྱིས་སུ་ཡང་ཤར་རྫ་པས་དེ་སྐད་གསུངས་པ་ཡིན་ཞེས་ངག་རྒྱུན་ལ་ཀུན་གྱིས་གླེང་བར་འདུག་གོ།",
    "འགའ་ཞིག་འཇིག་རྟེན་གྱི་ཆགས་སྡང་དུ་འདུག།",
    "དེ་ནས་གཏེར་ཆེན་ཡབ་ཡུམ་ནས་པདྨ་གསང་གླིང་ཞེས་འབོད་པའི་རི་ཁྲོད་ཅིག་བཏབ་ནས་བཞུགས་པར་གནང་འདུག་པས་དེར་འབྱོན་པར་བསྐུལ་བཞིན་ཕེབས་བསུ་རིང་ཐུང་འབྱོར་བ་བཅས་ཕེབས་ནས།",
    "གཞན་གྱི་མིག་ལྟོས་ལའང་ཕན་པར་འདུག་སྙམ་དུ་ཐུགས་ལ་དགོངས་ནས་འདི་ལྟ་བུའི་རྒྱུན་གྱི་ཕྱག་ལེན་གནང་བ་རྣམས་ཅུང་ཟད་འབྲི་ན།",
    "དེ་ལ་བརྟེན་ནས་སྣང་བ་དཔེ་རུ་ཤར་བའི་ཕྱིར་བུང་བ་དང་བྱིའུའི་གཏམ་ཚོགས་ཀྱང་དགོངས་ཉམས་ཀྱི་སྟེང་ནས་མཛད་པ་ཡིན་འདུག།",
    "རྗེའི་ཞལ་སྔ་ནས་དེ་སྐབས་རྨིས་ལྟས་བཟང་པོ་ཁོ་ན་འོང་འདུག།",
    "སྒྲུབ་ཕུག་དེ་ཉམས་རྟོགས་ཧ་ཅང་འཕེལ་བའི་གནས་བཟང་པོར་འདུག་པས་ཡུན་རིང་བསྡད་པ་ཡིན་ཞེས་དང་།",
    "འགའ་ཞིག་དབུ་འཕང་དམའ་ཞིང་འཕོ་སྐྱས་བྱེད་པའང་མང་དུ་ཡོད་འདུག་པས་དུས་ངན་བདོ་བའི་སྣ་འདྲེན་ལ་དམར་ཆོག་ལས་ཐུ་བ་གཞན་མེད་ཅེས་ལུང་རིགས་མང་པོ་རྒྱུན་དུ་གསུང་པ་དང་།",
    "དེ་ཨ་བསྭེ་ཡིན་པར་འདུག།",
    "ཉིད་ཀྱི་གསུངས་འདི་རྣམས་རྗེ་མཉམ་མེད་ཆེན་པོའི་དགོངས་པའི་གསལ་བྱེད་དུ་འདུག་ཅིང་།",
    "དེས་ཁྱེད་ལ་ཡར་བྱོན་ཞེས་འབོད་པའི་སྙེན་བསྐུལ་ཞུ་བའི་བརྡར་འདུག།",
    "ཡུལ་བྱིངས་ནས་སྐད་ཀྱང་མི་ཚོར་བར་གདའ་བས་ཞབས་འདེགས་སུ་འགྱུར་བ་དཀའ་ཡང་ཅི་འགྲུབ་ཙམ་ཞུ་ཞུས་པས།",
    "འོན་ཀྱང་དེས་ཀྱང་ཡིད་བདེ་བ་ཞིག་མི་འོང་པས་སྲོག་ཤ་ལ་འབགས་པ་འདི་སེམས་ལ་རང་གཟན་པར་གདའ་ཞེས་རྣམ་པ་ཀུན་ཏུ་དགག་པ་ཁོ་ན་མཛད་པས།",
    "རྒྱུ་འབྲས་ཤེས་པའི་རྒན་པོའི་ཡི་གར་ཡང་མི་འགྲོ་བའི་ལས་སྤྱོད་ཚབས་ཆེན་དུ་འདུག་པ་འདི་འདྲ་སྔོན་ནས་བྱེད་ཅིང་ད་དུང་ཡང་བྱེད་བཞིན་པ་ལ་དཔགས་ན།",
    "ཁོ་བོའི་རིག་ངོར་ཤར་ཚད་ཡི་གེར་བྲིས་ན་ཟད་མེད་ལྟ་བུ་ཞིག་འདུག་ཀྱང་ཉམས་ཀྱི་གཟུགས་བརྙན་ཙམ་ཡིན་ལ།",
    "ཚུལ་དེས་ན་རྩ་གསུམ་གྱི་སྐོར་གྱི་སྦྱར་བྱང་བཀའ་རྩོམ་ལྟ་བུར་གནང་འདུག་པ་ནི་དགག་དགོས་ལ་དགོངས་པར་གདོན་མི་ཟ་སྟེ།",
    "བུག་སེར་ཆུང་ངུ་ཞིག་འདུག་པའི་ནང་ནས་ཕྱིན་པས།",
    "ཚིག་དོན་གསལ་བར་མ་ངེས་ཀྱང་རྣམ་འགྱུར་ལ་དཔག་ན་ལེགས་འདུག་སྙམ་པ་ཤར་འཕྲོར་གཟིམས་ལས་སད་པ་ཞིག་བྱུང་ཞེས་གསུང་ངོ།",
    "འདི་སྐབས་གཟིམ་ལམ་གྱི་སྣང་བར་འཚུབ་འགྱུར་ཅུང་ཟད་བྱུང་བས་གཞན་གྱི་རིམ་གྲོ་ལ་འབད་པ་འདི་རིགས་ལ་ཅུང་ཟད་གནོད་འདུག་སྙམ་པ་ཤར་ཞེས་ཀྱང་གསུངས།",
    "དེ་དག་རང་རང་སྔོན་གྱི་ལས་འཕྲོ་ཡིན།",
    "གང་ཞིག་བསྒྲུབ་དགོས་ནའང་རང་བློའི་ཕུགས།",
    "དགོས་སུ་རང་རང་བཟའ་ཚང་གང་ཡོད་ཀྱིས།",
    "རབ་རྒྱལ་བཙན་རྒྱལ་དེང་སང་སྟོང་ནས་འདུག།",
    "གྲོང་དུ་མི་འདུག་རྒྱུན་དུ་དགོན་གནས་བཟུང་།",
    "ཐབས་མཁས་བྱ་བས་འདུད་ཅིང་རང་སྲིད་བསྲུངས།",
    "དེང་ཡང་རང་བཟོས་བསྟན་པ་གྲོང་ཆོག་ཏུ།",
    "རྒྱལ་ཡུམ་བྱམས་མའི་ཞལ་ལ་གསེར་ལན་གཅིག་བྱུག་པས་གཞན་ཐམས་ཅད་ལས་ལྷག་པའི་གསེར་མདངས་དམར་སེར་འོད་དུ་འཕྲོ་བ་བྱུང་བས་བཟོ་བོ་རྣམས་ཀྱིས་འདི་ངོ་མཚར་བའི་རྟགས་ཁྱད་པར་ཅན་དུ་འདུག་ཅེས་གླེང་བ་བྱུང་།",
    "སྒོམ་ནས་སྐུ་ཚེ་རི་ལ་བསྐྱལ་བ་ཡིན་ཟེར་མཁན་ནི་སྲིད་མཐའ་མ་བཀག་ཙམ་ལས་མི་འདུག།",
    "གྲུབ་ནས་བརྟུལ་ཤུགས་སྤྱོད་པ་ཡིན་གསུངས་མཁན་ནི་མང་བར་འདུག་པས་རྒྱལ་བའི་བསྟན་པ་ལ་རྨ་མི་འབྱིན་པ་དང་།",
    "དེའི་སྐབས་སུ་མཚན་ལམ་དུ་ཨུདྡྷསྨཱ་ར་ཡིན་ཟེར་བའི་མེ་ཏོག་སེར་པོ་བྱིས་པ་ལོ་བཅུ་གསུམ་པའི་ལུས་ཚད་དང་འདྲ་སྙམ་པ་དར་གྱི་གུར་ཕུབ་པ་ལྟ་བུའི་འདབ་མ་རྣམས་འབྲེལ་ནས་ཡོད་པ་ཞིག་སྐྱེས་ནས་འདུག།",
