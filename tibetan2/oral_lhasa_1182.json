    "སེར་སྣ་རྡོ་རྗེ་ནི་སེར་སྣ་འཇིག་པའི་ཕྱིར་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་སྟེ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་གསུངས་པ།",
    "དེ་ནི་རྡོ་རྗེ་འཛིན་པར་བཤད།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་བདེ་བ་ཆེན་པོ་སྟོང་པ་ཉིད་དང་རོ་གཅིག་པ་ཉིད་ཀྱིས་ན་སྤྲོས་པའི་འཁྲུག་པ་མེད་པའི་ཕྱིར་མ་དཀྲུགས་ལས་ཞེས་གསུངས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་གསུངས་པ།",
    "རྡོ་རྗེ་སྟེ་དེ་བཞིན་གཤེགས་པ་རྣམས་འདི་རྣམས་ཀྱི་བདག་པོ་རྣམས་ཏེ་ལོངས་སྤྱོད་པ་པོ་ཉིད་ཀྱིས་སོ་ཞེས་དེ་ལྟར་གསུངས་སོ།",
    "རྣམ་པར་དག་པའི་གཟུགས་ལ་སོགས་པའི་རང་བཞིན་ཉིད་ཀྱིས་འདི་རྣམས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ལོངས་སྤྱད་བྱ་བླ་ན་མེད་པའི་ངོ་བོ་ཉིད་ཁོ་ནར་བསྟན་ཏོ།",
    "དེ་ལྟར་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་རྣམ་པར་དག་པའི་ངོ་བོར་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རྣམས་གསུངས་སོ།",
    "དེ་ལས་གཞན་པ་དཔག་ཏུ་མེད་པ་རྣམས་ཀྱང་འདི་ལྟ་བུ་ལ་སོགས་པ་རྣམས་རྣམ་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་རྣམས་ཐམས་ཅད་ནི་ཕུང་པོ་ལ་སོགས་པ་རྣམ་པར་དག་པ་ལས་ཐ་མི་དད་པ་རྣམས་སོ་ཞེས་པས་འདི་རྣམས་མི་བསྐྱོད་པ་ལ་སོགས་པའི་སྒོ་ཅན་དུ་འགྲུབ་པའོ།",
    "དེ་འང་རྣམ་པར་མི་རྟོག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མཁའ་འགྲོ་མ་རྡོ་རྗེ་གུར་དུ་གསུངས་པ།",
    "ཤེས་པ་༡ཞེས་པ་ཤེས་པ་བཅུ་རྣམ་པར་དག་པས་འཁོར་ལོའི་རྩིབས་བཅུ་པའོ།",
    "སྐུ་གསུང་ཐུགས་རྣམ་པར་དག་པས་དེའི་ཟུར་གསུམ་སྟེ།",
    "སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ཉིད་ཀྱིས་ན་དབྱེར་མེད་པའི་ཡེ་ཤེས་ལྔ་རྣམ་པར་དག་པས་སྣ་ཚོགས་རྡོ་རྗེའོ།",
    "ཚངས་པའི་གནས་བཞི་རྣམ་པར་དག་པས་ཟུར་བཞིའོ་། དྲན་པ་ཉེ་བར་གཞག་༡པ་བཞི་རྣམ་པར་ད་ག་པས་ཤར་གྱི་སྒོའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་རྣམ་པར་དག་པས་ལྷོའི་སྒོའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞི་རྣམ་པར་དག་པས་ནུབ་ཀྱི་སྒོའོ།",
    "དད་པ་ལ་སོགས་པ་སྟོ་བས་ལྔ་རྣམ་པར་དག་པས་ཚོན་ལྔའི་རྩིག་པ་རྣམས་ས་སོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞི་རྣམ་པར་དག་པས་སྒོ་ཁྱུད་རྣམས་སོ་ཞེས་ཀླུའི་བློའི་ཞབས་སོ་། འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་༢རྣམ་པར་དག་པས་སྒོའི་ཀ་བ་བརྒྱད་རྣམས་སོ།",
    "ཀ་བ་བརྒྱད་པོ་ཞེས་པར་བཤད།་།",
    "ཅེས་གསུངས་སོ།",
    "ཀ་བ་བརྒྱད་པོ་ཞེས་པར་བཤད།་།",
    "དེའི་སྟེང་དུ་སོ་སོ་ཡང་དག་པར་༡རིག་པ་བཞི་རྣམ་པར་དག་པས་གདུང་བཞི་སྟེ།",
    "སེང་གེ་རྣམ་པར་རྩེན་༢པ་སྟེ་ཏིང་ངེ་འཛིན་བཞི་རྣམ་པར་ད་ག་པས་སྟེགས་བུ་བཞིའོ།",
    "ཤེས་རབ་ཡེ་ཤེས་རྣམ་པར་དག་པས་ཉི་མ་རྣམས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་ལམ་གྱི་ཡེ་ཤེས་རྣམ་པར་དག་པས་ཇ་ཡབ་རྣམས་སོ།",
    "དེ་སྐད་དུ་ཡང་ཐམས་ཅད་གསང་བའི་རྒྱུད་དུ་གསུངས་པ།",
    "རྣམ་པར་གནོན་དང་སྤོང་བ་ནི།",
    "ཏིང་འཛིན་ཡེ་ཤེས་ཀྱིས་བྱས་པ།",
    "ལམ་གྱི་ཡེ་ཤེས་ཁྱད་པར་ནི།",
    "བསམ་གཏན་བཞི་རྣམ་པར་དག་པས་རྟ་བབས་བཞི་རྣམས་སོ།་།",
    "སྡུག་བསྔལ་ཤེས་པར་བྱ་བ་དང་ཤེས་པ་དང་སླར་ཤེས་པར་བྱར་མེད་པ་དང་།་",
    "འགོག་པ་མངོན་དུ་བྱ་བ་དང་བྱས་ཟིན་པ་དང་སླར་མངོན་དུ་བྱར་མེད་པ་དང་།་",
    "ཡང་ད་ག་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་རྣམ་པར་དག་པས་འོད་ཟེར་འབར་བའོ།",
    "དུར་ཁྲོད་བརྒྱད་རྣམས་ནི་རྣམ་པ་ཐམས་ཅད་པའི་སེམས་རང་བཞིན་མེད་པ་ཉིད་རྣམ་པར་དག་པ་སྟེ།",
    "དེའི་ཕྱིར་གནས་པའི་བདེ་བ་རྣམས་ཀྱིས་ཉེ་བར་སྟོན་པའི་ཕྱིར་འདི་རྣམས་ཀ་བ་རྣམ་པར་དག་པ་རྣམས་ས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་དེ་བཞིན་ཉིད་ལ་འགྲོ་བ་མཐའ་དག་ཐ་མི་ད་ད་པར་བརྗོད་ཅིང་དེར་སོན་པའི་སྐྱོན་གྱིས་མ་གོས་པ་རྣམ་པར་དག་པས་གདན་གྱི་མཚོ་སྐྱེས་རྣམས་སོ།",
    "ཞི་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་རྣམ་པར་དག་པས་འདབ་མ་སྣ་ཚོགས་རྣམས་ཏེ།",
    "ཁ་ཅིག་ཏུ་གདན་འཇིགས་བྱེད་ལ་སོགས་པ་དང་ཁ་ཅིག་ཏུ་ཚངས་པ་ལ་སོགས་པ་དང་ཁ་ཅིག་ཏུ་འདོད་ལྷ་ལ་སོགས་པ་དང་ཁ་ཅིག་ཏུ་རོ་ནི་རང་བཞིན་མེད་པ་དང་གཉིས་སུ་མེད་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་སྐྱོན་རྩད་ནས་འདོན་པ་རྣམ་པར་ད་ག་པས་སོ།",
    "ང་རྒྱལ་རྩད་ནས་བཏོན་པ་དང་མུ་སྟེགས་ངན་པའི་རི་དྭགས་ཟིལ་གྱིས་གནོན་པ་དང་ཟིལ་གྱིས་མི་ནོན་པའི་དེ་ཁོ་ན་ཉིད་རྟོགས་པ་རྣམ་པར་དག་པས་སེང་གེའི་གདན་ན་ནོ།",
    "གཏི་མུག་རྩ་བ་ནས་མེད་པ་རྣམ་པར་དག་པས་གླང་པོ་ཆེའོ།",
    "ཞེ་སྡང་འཇོམས་པ་རྣམ་པར་དག་པས་སྦྲུལ་ལ་ལོ།",
    "ཉེ་བར་སྤྱོད་པས་གསུམ་སྤོང་བ་ལས་ཐུགས་དང་གསུང་ད་ང་སྐུ་རྣམ་པར་དག་པས་རིམ་པ་བཞིན་དུ་ནག་པོ་དང་ད་མར་པོ་དང་དཀར་པོའི་འཁོར་ལོའི་གདན་རྣམས་སོ།",
    "ཕྱིན་ཅི་མ་ལོག་པ་ལས་གཟུགས་ལ་སོགས་པ་རྣམ་པར་དག་པས་བླ་ན་མེད་ཅིང་མཐའ་ཡས་པའི་འདོད་པའི་ཡོན་ཏན་ལྔ་རྣམས་ཏེ།",
    "གྲགས་པ་རྣམ་པར་དག་པས་དྲི་བཟང་དང་།",
    "རྟེན་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་དག་པའོ།་།",
    "དེ་ལ་བརྟེན་པའི་ལྷའི་རྣམ་པར་དག་པ་ཡང་རྒྱུད་རྣམས་སུ་༡རྣམ་པ་མང་པོར་བསྟན་ཏེ།",
    "མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་རྣམ་པར་དག་པ་ནི་རིན་ཆེན་འབྱུང་ལྡན་ན་ནོ།",
    "འདུ་ཤེས་ཀྱི་ཕུང་པོ་དང་འདོད་ཆགས་དང་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་རྣམ་པར་དག་པ་འོད་དཔག་མེད་ད་དོ།",
    "འདུ་བྱེད་ཀྱི་ཕུང་པོ་དང་ཕྲག་དོག་ད་ང་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་རྣམ་པར་དག་པ་དོན་ཡོད་གྲུབ་པའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་རབ་ཏུ་དགའ་བའི་ས་རྣམ་པར་དག་པས་གཟུགས་རྡོ་རྗེ་མའོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ས་འོད་བྱེད་པ་རྣམ་པར་ད་ག་པས་དྲི་རྡོ་རྗེ་མའོ།",
    "བརྗེད་ངས་པ་དང་ཕུང་པོའི་བདུད་ད་ང་སྐྱེ་བའི་སྒྲིབ་པ་སྤོང་བའི་ཕྱིར་དྲན་པ་ལ་སོགས་པ་རྣམ་པར་དག་པའི་རང་བཞིན་པདྨ་མཐར་བྱེད་དོ།",
    "མི་འཇིགས་པ་བཞི་རྣམ་པར་དག་པས་ཀྱང་སྒོ་སྐྱོང་བཞི་པོ་རྣམས་སོ།",
    "སྟོབས་བཅུ་རྣམ་པར་དག་པ་ཡང་འདི་རྣ་མས་ཏེ་རབ་ཏུ་དགའ་བ་ལ་སོགས་པ་ས་བཅུ་རྣམ་པར་དག་པ་ཡང་ངོ།",
    "ས་ཀུན་དུ་འོད་རྣམ་པར་དག་པ་རྡོ་རྗེ་སེམས་དཔའོ།",
    "རྒྱུད་འདིར་ནི་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་ལ་ཟག་པ་མེད་པའི་བདེ་བ་ཆེན་པོ་རྣམ་པར་དག་པས་རི་རབ་སྟེ།",
    "སྲུང་བའི་འཁོར་ལོར་སྔར་བཞིན་ཏེ་ཤེས་རབ་༡དང་སྟོབས་དང་ས་བཅུ་རྣམ་པར་དག་པ་ཁྲོ་བོ་རྣམས་སོ།",
    "དབུས་ཀྱི་རིམ་པའི་ལྷ་དགུ་སྔར་བཞིན་རྣམ་པར་དག་པའོ།",
    "ཕྱོགས་གཞན་ལ་བྱམས་པ་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་རྣམ་པར་དག་པའོ།",
    "འོད་དཔག་ཏུ་མེད་པ་དང་མི་བསྐྱོད་པ་རྣམ་པར་དག་པ་རྣམས་སོ།",
    "བཅོམ་ལྡན་འདས་ནི་མི་བསྐྱོད་པ་རྣམ་པར་དག་པས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་སྟེ།",
    "འདི་རྣམས་ཀྱིས་ཀུན་ནས་རྒྱས་པར་༤བྱེད་པའི་ཕྱིར་ཟད་པར་རྣམས་སུ་བརྗོད་ཅིང་ཡང་ད་ང་ཡང་དུ་མི་སྣང་བར་གྱུར་ནས་ཀྱང་མཐོང་བར་བྱ་བ་ལ་སོགས་པའི་ཟད་པར་བཅུ་རྣམས་དང་།",
    "སེང་གེ་བཞིན་དུ་དོགས་པ་མེད་པ་ཉིད་ཀྱིས་རིགས་པར་གསུངས་པ་ཉིད་མི་འཇིགས་པ་རྣམ་པ་བཞི་ད་ང་།",
    "བསྡུ་བའི་དངོས་པོ་བཞི་རྣམས་ཞེས་༢པ་སུམ་ཅུ་རྩ་བདུན་རྣམ་པར་དག་པས།",
    "གོ་རཱི་ལ་སོགས་པ་བཞི་རྣམས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་བཞིན་དུ་རྣམ་པར་དག་གོ།",
    "ཤ་དང་ཁྲག་དང་ཁུ་བ་དང་རྐང་དང་ཚིལ་བུ་དག་རྣམ་པར་དག་པས་ཀྱང་འདི་རྣམས་གོ།",
    "སྒོ་སྐྱོང་མ་རྣམས་ནི་སྒོ་སྐྱོང་བཞིན་རྣམ་པར་དག་པའོ།་།",
    "གླིང་བུ་མ་ལ་སོགས་པ་བཞི་རྣམས་བསྡུ་བའི་དངོས་པོ་བཞི་རྣམ་པར་དག་པའོ།",
    "ཆུ་མ་དང་རྡོ་རྗེ་མཁའ་འགྲོ་མ་དང་བདག་མེད་མ་རྣམས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རང་བཞིན་རྣམས་སོ།",
    "ས་སྤྱོད་མ་དང་མཁའ་སྤྱོད་མ་དག་སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པ་དག་གོ་ཞེས་པ་ཁྱད་པར་རོ།",
    "ཐམས་ཅད་དུ་ཡང་ལྷ་རྣམས་ཀྱི་གཉིས་སུ་མེད་པའི་དེ་ཁོ་ན་ཉིད་རྣམ་པར་དག་པས་སྐུའི་མཆོད་ལྡོང་གཅིག་དང་ཞལ་གཅིག་གོ།",
    "ལམ་ཡོན་པོ་མིན་པ་རྣམ་པར་དག་པས་སྐུ་དྲང་བའོ།",
    "གང་གསུངས་པ།",
    "ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པ་རྣམ་པར་དག་པས་ཞབས་གཉིས་དང་ཕྱག་གཉིས་སོ།",
    "བསྡུ་བའི་དངོས་པོ་བཞི་རྣམ་པར་དག་པས་ཞབས་བཞི་རྣམས་སོ།",
    "དགའ་བ་བཞི་རྣམ་པར་ད་ག་པས་ཕྱག་བཞི་རྣམས་སོ།",
    "ཁམས་བཅོ་བརྒྱད་དང་བདེན་པ་གཉིས་དང་སྟོབས་དང་མི་འཇིགས་པ་རྣམ་པར་ད་ག་པས་སུམ་ཅུ་རྩ་བཞིའོ།",
    "གདུག་པ་དང་བདུད་ཐམས་ཅད་རྣམ་པར་འཇོམས་པ་དང་།",
    "སྐུ་གསུང་ཐུགས་རྣམ་པར་དག་པས་ཞལ་གསུམ་རྣམས་སོ།",
    "བདུད་བཞི་འཇོམས་པའི་དགོངས་པ་དག་པས་གད་རྒྱངས་དང་བཅས་པར་བཞད་པའོ།",
    "ལོག་པར་ལྟ་བ་སྤངས་པ་ལས་རྣམ་པར་འགྱུར་བའོ་། བདུད་བཞི་འཇོམས་པ་ལས་མཆེ་བ་གཙིགས་ཤིང་འཇིགས་པའོ།",
    "བྱམས་པ་རྣམ་པར་དག་པས་ཀྱང་ཡན་ལག་ནག་པོ་ཉིད་དོ།",
    "བདེན་པ་གཉིས་རྒྱས་པ་སྟོན་པ་དག་པས་དབུ་སྐྲའི་ཕོན་པོ་གཉིས་བྱས་པའོ།",
    "བདེ་བ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་དག་པས་སྒེག་པ་དང་བ་ཅས་པར་དབུ་སྐྲ་བཅིངས་པའོ།",
    "རིགས་ལྔའི་རྣམ་པར་རྟོག་པ་དག་པས་དཔྲལ་བའི་སྟེང་དུ་ཐོད་པ་ལྔ་རྣམས་སོ།",
    "དེ་རྣམ་པར་དག་པས་ཚངས་པའི་སྐུད་པའོ།",
    "རྣམ་པར་༡རྟོག་པ་གཅོད་པའི་ཤེས་རབ་དག་པས་གྲི་གུག་གོ།",
    "བགེགས་ཐམས་ཅད་འབྱེད་པར་བྱེད་པ་དག་པས་ཐོང་གཤོལ་ལོ།",
    "དེ་རྣམས་ལ་འགའ་ཞིག་བརྫོད་ཟིན་པའི་རྗེས་སུ་འབྲང་བས་བརྟག་པར་བྱ་སྟེ།",
    "རྣམ་པར་དབྱེ་བར་ནུས་ན་ཡང་གཞུང་མངས་པས་འཇིགས་པས་ངལ་བསོའོ།",
    "དེ་ལྟར་ཤིན་ཏུ་བའི་ཡང་ཁྱད་པར་གྱི་རྣམ་པར་དག་པ་རྒྱས་པར་བསྟན་པ་རྟོགས་པར་བྱའོ།",
