    "རིགས་མེད་གྲོགས་ངན་སྔོན་དགེ་མ་བྱས་བློ་མ་སྦྱངས།",
    "ཅེས་སྔར་བསྟན་པ་ལྟར་དཔྱད་ན་དོན་དམ་དུ་བདེན་པར་གྲུབ་པར་མེད་ཀྱང་།",
    "ཞེས་པ་ལྟར་ཀུན་རྫོབ་སྣང་ཙམ་དུ་བདེན་པར་འཇོག་པ་ཡིན་པ་ལ།",
    "ཉན་ཐོས་གནས་མ་བུ་པ་ལ་སོགས་པ་བརྗོད་དུ་མེད་པའི་གང་ཟག་དོན་དམ་དུ་བདེན་པར་འདོད་པ་ནི་མི་རིགས་ཤིང་།",
    "འཇིགས་པ་པོའི་བདག་མེད་པའི་ཕྱིར་ཡང་འཇིགས་པར་མི་རིགས་སོ་ཞེས་སྟོན་པ་སྟེ།",
    "རྣམ་པར་ཕྱེ་སྟེ་དགག་པ།",
    "མཚེར་པ་ལ་སོགས་པའི་ནང་ཁྲོལ་གཞན་མང་པོ་ཡང་བདག་མིན་ཏེ༵་བདག་ནི་ཕྱི་ས་དང་གཅིན་ལ་སོགས་པ་མི་གཙང་བ་རྣམས་ཀྱང་མ་ཡི༵ན་ལ།",
    "ཕུང་པོ་ལས་གཞན་ཡིན་ན་ལུས་མེད་པར་འགྱུར་བའི་ཕྱིར་ཡང་རྣམ་པ་ཐམས་ཅད་དུ་བདག་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཕུང་པོའི་མཚན་ཉིད་མེད་པར་འགྱུར།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྒྲ་སོགས་དེ་ཙམ་ལྔ་འཛིན་པ་ཡི་རྣམ་པར་ཤེས་པའི་བདག་རྟག་པར་ཡོད་ན༵།",
    "འདོད་པར་མི་ནུས་ཏེ་སྒྲ་འཛིན་ན་སྒྲ་ལ་ལྟོས་ནས་འཇོག་པ་ཡིན་པས་ཤེས་པར་བྱ་བའི་ཡུལ་སྒྲ་མེད་པའི་དུས་ན་སྒྲ་འཛིན་གྱིས་ཅི་ཞིག་རི༵ག་སྟེ་ཅི་ཡང་རིག་པ་མི་སྲིད་ན།",
    "གཟུང་པ་ལ་ལྟོས་ནས་འཛིན་པར་འཇོག་པ་དེས་ན་ཤེས་པར་བྱ་བ་སྒྲ་རུང་ཡུལ་དུ་ཉེ་བར་གནས་པ༵་མེད་པར་སྒྲ་འཛིན་གྱི་ཤེས་པ་དེའང་མེད་ཅེས་བྱ་བར་ངེ༵ས་པའི་ཕྱིར་སྒྲ་འཛིན་མི་རྟག་པ་ཉིད་དུ་གྲུབ་བོ།",
    "སྒྲ་ཉེ་བར་མེད་པས་མི་ཐོས་པ་དེས་ན་སྒྲ་མེད་པར་གྱུར་པ་དེའི་ཚེ་སྒྲ་འཛིན་གྱི་ཤེས་པའང་མེ༵ད་པ་ཉིད་དུ་གྲུབ་བོ།",
    "གཞན་ཡང་སྒྲ་འཛིན་ཉན་ཤེས་ཀྱི་རང་བཞིན་དུ་མི་འགྱུར་བར་གནས་པ་གང་ཡིན་པ༵་དེ་ཡུལ་གཟུགས་སོགས་གཞན་ཡང་འཛིན་པར་ཇི་ལྟར་འགྱུ༵ར་ཏེ།",
    "སྐྱེས་བུ་གཅིག་ནི་ལྟོས་ས་གཉིས་ལ་ལྟོས་ཏེ་ཕ་དང་བུ་ཉིད་དུ༵་བརྟགས་ནས་བཞག་པ་ཙམ་ཡིན་པས་ཕ་དང་བུ་གཉིས་སུ་ཡང་དག་པར་བདེན་པ་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་སྔ་ཕྱི་ཁྱད་མེད་ཀྱི་རང་བཞིན་གཅིག་ཏུ་འདོད་པས་བུའང་མིན་ལ་ཕ་ཡང་མི༵ན་པ་བཞིན་ནོ།",
    "བཞི་པ་རྟག་གཅིག་བདེན་པར་དགག་པ་ནི།",
    "དེ་ལྟ་ན་ཤེས་པ་དེ་རྟག་པ་མི༵ན་པར་འགྱུར་ཏེ།",
    "རྟག་པ་གཅིག་པུ་ཐམས་ཅད་ལ་ཁྱབ་པ་སྐྱེས་བུའི་རྒྱུད་དུ་གཏོགས་པའི་བེམ་པོ་སེམས་ཐ་དད་དུ་ལྡན་པས་ཡུལ་ལ་ལོངས་སྤྱོད་པའི་བདག་ནི་བདེན་པར་ཡོད་དོ་ཞེ་ན།",
    "འོན་ཏེ་སེམས་ཀྱི་ངོ་བོར་མེད་ཀྱང་སེམས་རྫས་གཞན་དང་ལྡན་པར་ཡོད་པའི་ཕྱི༵ར་ཡུལ་ལ་ལོངས་སྤྱོད་པ་པོ་ཡིན་ནོ་ཞེ་ན།",
    "ལས་བྱས་ནས་ནི་བྱེད་པ་པོའི་བདག་དེ་མི་རྟག་ཅིང་ཞིག་པས་འབྲས་བུ་མྱོང་དུས་ན༵་མེད་པའི་ཕྱིར་རོ།",
    "བདག་མེད་ན་ནི་ལས་བྱས་པ་ཆུད་ཟ་བ་ལ་སོགས་པའི་ཉེས་པ་འབྱུང་ཞིང་བདག་ཡོད་པས་དེ་ཉིད་ཀྱིས་རྣམ་སྨིན་མྱོང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "རྒྱུ་ལས་བྱས་པ་དང་ལྡན་པའི་བདག་རྟག་པ་གཅིག་པུ་དེ་ཉིད་ཀྱིས་འབྲས་བུ་རྣམ་སྨིན་མྱོང་བ་དང་བཅས་པ་ཞེ༵ས་བྱ་གཞི་མཐུན་པར་མཐོང་བ་དེ་ནི་ཕྱིན་ཅི་ལོག་ཡིན་གྱི།",
    "བསྐྱེད་བྱ་སྐྱེད་བྱེད་དུས་མཉམ་དུ་གྲུབ་པར་ཤིན་ཏུ་འགལ་བའི་ཕྱིར་རོ།",
    "འདི་ཉིད་ཀྱིས་བྱས་པའི་ལས་ཇི་ལྟར་གཞན་གྱིས་མྱོང་བར་འགྱུར།",
    "དགེ་སློང་དག་བྱས་ཤིང་བསགས་པའི་ལས་འདི་ནི་ཕྱི་རོལ་གྱི་སའི་ཁམས་ལ་སོགས་པ་ལ་སྨིན་པར་མི་འགྱུར་གྱི།",
    "ཟིན་པའི་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་འདི་ཉིད་ལ་སྨིན་པར་འགྱུར་རོ་ཞེས་པ་ལ་སོགས་པས་སོ།",
    "ཞེས་ཀུན་རྫོབ་ལས་འབྲས་ལ་ཡིད་ཆེས་པའི་དོན་དུ་བཏགས་ནས་བསྟན་པ་ཡིན་གྱི་དོན་དམ་དུ་རྫས་སུ་གྲུབ་པ་ནི་མེད་པར་གསུངས་སོ།",
    "འདུས་བྱས་ཐམས་ཅད་སྐྱེས་མ་ཐག་འཇིག་པས་སྐད་ཅིག་གཉིས་པ་ཕན་ཆད་དུ་མི་གནས་པའི་ཕྱིར་རོ།",
    "རྨོངས་པ་ནི་ཐམས་ཅད་དུ་སྤང་པར་བྱ་བ་མ་ཡིན་ནམ་དེས་བརྟགས་པའི་ཡུལ་ཁས་བླངས་ནས་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "དེ་ལྟ་བུའི་རྨོངས་པ་ནི་བཟློག་པར་བྱ་སྟེ།",
    "ཁྱད་པར་དུ་འཕགས་ཚུལ་ལོ།",
    "དང་པོ་ནི་དོན་ལྔས་རིགས་པར་བྱ་སྟེ།",
    "དུར་ཁྲོད་ཀྱི་ཀེང་རུས་དང་རྣམ་པར་སྔོས་པ་དང་རྣམ་པར་གནག་པ་དང་རྣམ་པར་བམ་པ་ལ་སོགས་པར་རྟོག་ཡུལ་དུ་སྣང་བའི་ལུས་མི་གཙང་བའི་ངོ་བོར་མཉམ་པ་ཉིད་དུ་རྗེས་སུ་ལྟ་ཞིང་དྲན་པ་ལ་འཇོག་པ་དང་།",
    "ཚོར་བ་ལ་སྲེད་པའི་གཉེན་པོར་འདི་ལྟར་གང་ཅི་ཚོར་ཡང་རུང་འདི་ནི་འདིར་སྡུག་བསྔལ་ལོ་ཞེས་གསུངས་པ་ལྟར་ཟག་བཅས་ཀྱི་ཚོར་བ་ཐམས་ཅད་སྡུག་བསྔལ་བར་མཉམ་པ་ཉིད་དུ་ལྟ་ཞིང་དྲན་པ་ལ་འཇོག་པ་དང་།",
    "སེམས་ལ་རྟག་པར་འཛིན་པའི་གཉེན་པོར།",
    "འདུས་བྱས་ཐམས་ཅད་སྐད་ཅིག་མ།",
    "དེ་ལྟར་མི་གཙང་བ་དང་སྡུག་བསྔལ་བ་དང་མི་རྟག་པ་དང་བདག་མེད་པ་རྣམས་བསྒོམས་པས།",
    "ཞེས་པ་ལྟར་ལུས་འདུ་བྱེད་གནས་ངན་ལེན་གྱི་སྡུག་བསྔལ་གྱིས་བསྡུས་པར་རིག་ནས་སྡུག་བསྔལ་ཡོངས་སུ་ཤེས་པ་ལ་འཇུག་ཅིང་།",
    "གཉིས་པ་ཁྱད་པར་འཕགས་ཚུལ་ལ།",
    "དེ་ལས་གཞན་ལས་ཁྱད་པར་འཕགས།",
    "དོན་རྣམ་པ་བཅུ་བཞིས་ཁྱད་པར་དུ་འཕགས་པ་ཉིད་དོ།",
    "དངོས་པོ་ལ་མཚན་མར་འཛིན་པ་མ་ཡིན་གྱི་ལུས་ལ་སོགས་པ་ཐམས་ཅད་མི་དམིགས་པར་ཡིད་ལ་ཕྱེད་པའི་ཕྱིར་དང་།",
    "བསམ་སྦྱོར་མཐུན་པར་འཇུག་པས་འབྲས་བུ་མཐར་ཐུག་ཐོབ་པ་ན་འདྲེས་ཤིང་ཉེ་བར་འདྲེས་པའི་མཆོག་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་དང་།",
    "ཡན་ལག་ཅན་གྱི་ལུས་རིལ་པོ་རྫས་གཅིག་ཏུ་བདེན་པར་གྲུབ་པ་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འདི་ལ་ཡན་ལག་ཅན་གྱི་ལུས་རིལ་པོ་རྫས་གཅིག་ཏུ་བདེན་པར་གྲུབ་པ་ནི་གང་ཞིག་ཡི༵ན་ཏེ་གང་ཡང་གྲུབ་པ་མེད་དོ།",
    "ཡན་ལག་ཐམས་ཅད་ལ་ཁྱབ་པར་གནས་པའི་ལུས་ཡོད་དོ་ཞེ་ན།",
    "ཆ་མེད་ཀྱི་ལུས་རིལ་པོ་གཅིག་པུ་དེ་རང་ཉིད་ནི་ཡན་ལག་གང་ལ་གན༵ས་ཞེས་བརྟགས་ན་གང་དུ་ཡང་གནས་པར་མི་འགྲུབ་སྟེ་ཆ་ཤས་དུ་མར་གྱུར་བས་གནས་པ་པོ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "རིལ་པོ་གཅིག་ཏུ་བདེན་པར་འདོད་པ་ཡང་འགལ་ལོ།",
    "གསུམ་པ་ཚོགས་པའང་བདེན་པ་མེད་པར་བསྟན་པ་ནི།",
    "དེ་ལྟར་ཕྱི་རོལ་དང་ནང་དུ་རྣམ་པར་དཔྱད་པ་ན་ལུས་རིལ་པོ་གཅིག་ཏུ་བདེན་པར་གྲུབ་པ་མེད་པའི་ཕྱིར་ན༵།",
    "ཇི་ལྟར་ལག་པ་ལ་སོགས་པའི་ཡན་ལག་རྣམས་ལ་ལུས་ཡོ༵ད་པར་འགྱུར་ཏེ་མེད་པར་གྲུབ་བོ།",
    "དེས་བརྩམས་པའི་ལུས་ཀྱང་བདེན་པར་གྲུབ་པ་མེད་དེ།",
    "དེ་ལྟར་རྣམ་པར་དཔྱད་ན་བདེན་པར་གྲུབ་པ་མེད་ཀྱང་འཁྲུལ་ཤེས་ལ་སྣ་ཚོགས་སུ་སྣང་བ་རྨི་ལམ་ལྟ་བུ༵འི་གཟུགས་སམ་ལུས་འདི་ལ་རྟོགས་དཔྱོད་དང་ལྡན་པའི་མཁས་པ་སུ་ཞིག་ཆ༵གས་པར་བྱེད་དེ་ཆགས་ཤིང་ཞེན་པར་ནི་རིགས་པ་མ་ཡིན་ནོ།",
    "གཉིས་པ་ཚོར་བ་དྲན་པ་ཉེ་བར་གཞག་པ་ལའང་ཟག་བཅས་ཀྱི་ཚོར་བ་བདེ་སྡུག་བཏང་སྙོམས་སུ་སྣང་བ་རྣམས་དོན་དམ་དུ་བདེན་པར་འདོད་པ་བརྟགས་ནས་འགོག་པ་སྟེ།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བ་དེ་ཁོ་ན་ཉིད་དུ་བདེན་པར་ཡོད་ན༵་ནི་ནམ་ཡང་མི་ལྡོག་པར་འགྱུར་ཞིང་།",
    "དགའ་བདེ་མྱོང་པའི་དུས་ན་ནི་སྡུག་བསྔལ་མ་དམིགས་པའི་ཕྱིར་དེ་ཁོ་ན་ཉིད་དུ་བདེན་པར་མ་གྲུབ་པོ།",
    "དེ་བཞིན་དུ་བདེ་བའི་ཚོར་བ་དེ་ཁོ་ན་ཉིད་དུ་བདེན་པར་ཡོད་ནའང་ནམ་ཡང་ལྡོག་པར་མི་འགྱུར་ཞིང་།",
    "སྡུག་བསྔལ་མྱོང་དུས་ན་དགའ་བདེ་མ་དམིགས་པའི་ཕྱིར་ཡང་དེ་ཁོ་ན་ཉིད་དུ་བདེན་པར་མ་གྲུབ་པོ།",
    "སྡུག་བསྔལ་དེ་ཁོ་ན་ཉིད་དུ་བདེན་པར་ཡོད་ཀྱང་དགའ་བདེ་སྟོབས་དང་ལྡན་པས་ཟིལ་གྱིས་མནན་པའི་ཕྱི༵ར་གལ་ཏེ་བདེ་བ་མྱོང་བའི་གནས་སྐབས་ན་སྡུག་བསྔལ་དེ་ཉམས་སུ་མྱོང་བ་མ་ཡིན་ནོ་ཞེ་ན༵་གང་ཞིག་ཉམས་སུ་མྱོང་པའི་བདག་ཉིད་ཅན་མི༵ན་པ་དེ་ནི་སྡུག་བསྔལ་གྱི་ཚོར་བ་ཇི་ལྟར་ཡི༵ན་ཞེས་བརྟགས་ན་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་སྡུག་བསྔལ་གྱིས་ཟིལ་གྱིས་མནན་པའི་དུས་ན་བདེ་བའི་ཚོར་བ་ཡོད་པར་འདོད་པ་ལ་ཡང་མཚུངས་སོ།",
    "ཡིད་ལ་བྱེད་པ་རྣམ་པར་ཤེས་པ་ལུས་སམ་གཟུགས་སུ་གྲུབ་པ་མེད་པ་ལ་ནི༵།",
    "ལག་པའང་གང་ཞིག་ཡིན་པར་འགྱུར།",
    "ཞེས་པས་སྔར་ནི་ཇི་ལྟར་རིགས་པས་རྣམ་པར་དཔྱད་ཅིང་བདེན་མེད་དུ་གཏན་ལ་ཕབ་པ་བཞི༵ན་ནོ།",
    "ཚོར་བ་ཡུལ་གྱི་རྣམ་པར་སྔ་མར་སྐྱེས་པ་དང་སེམས་ཡུལ་ཅན་གྱི་རྣམ་པར་ཕྱི་མར་སྐྱེས་པས་ཀྱ༵ང་སེམས་ལ་སྔར་གྱི་ཡུལ་དེ་དྲན་པ་ཙམ་དུ་འགྱུར་གྱི་དངོས་སུ་མྱོང་ཞིང་མཐོང་བ་ནི་མ་ཡི༵ན་ཏེ།",
    "མྱོང་བ་པོ་མེད་པ་དེས་ན་ཕན་ཚུན་ལྟོས་ནས་འཇོག་པས་མྱང་བྱའི་ཚོར་བའང་དེ་ཁོ་ན་ཉིད་དུ་བདེན་པ་མི༵ན་པར་གྲུབ་པོ།",
    "བདེ་བར་སྣང་བས་ཕན་པ་བྱས་པའང་མེད་པས་དམིགས་མེད་ཀྱི་ངང་དུ་མཉམ་པར་གཞག་པ་བྱ༵་སྟེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་གང་དུ་བཙལ་ཡང་མི་རྙེད་པས་བདེན་པར་གྲུབ་པ་མེད་དེ།",
    "ཕྱི་ནང་དེ་དག་འདྲེས་པའི་དངོས་པོར་ཡང་ཡོད་པ་མིན་ཞིང་དེ་དག་ལོགས་སུ་འགར་བཙལ་ཡང་བདེན་པར་གྲུབ་པ་མེད་དེ།",
    "དེ་ཡང་དུས་གསུམ་ལ་བརྟགས་ན་དོན་དམ་པར་སྐྱེ་བ་མེད་དེ།",
    "ཤེས་པར་བྱ་བའི་ཡུལ་གཟུགས་སོགས་ལས་སྔ་བར་མིག་ཤེས་ལ་སོགས་པ་ཡོད་ན༵།",
    "དེ་སེམས་ཀུན་ཏུ་ཚོལ་བ་ན་སེམས་དེ་ནི་ནང་དང་ཕྱི་དང་དེ་གཉི་ག་དང་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་རྣམས་ལ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ཞེས་གསུངས་པ་ལྟར་བཙལ་ནས་མ་རྙེད་པའི་ངང་དུ་གཞག་པར་བྱ་སྟེ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེའི་ལུགས་ལ་བདེན་པ་གཉིས་ཀྱི་རྣམ་བཞག་ག་ལ་ཡོ༵ད་དེ་མེད་པར་འགྱུར་ཞིང་།",
    "དེ་ལྟར་མིན་པར་རྒྱུ་འབྲས་སུ་སྣང་བ་འདི་འགགས་ནས་མེད་པའི་དུས་ན་ཀུན་རྫོབ་མེད་པ་ཉི༵ད་ཡིན་ཡང་།",
    "ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དོན་དམ་དུ་བདེན་པ་མེད་ཀྱང་ཀུན་རྫོབ་ཙམ་དུ་རྟོག་པར་བྱེད་པའི་བློ་དང་བརྟག་པར་བྱ་བའི་ཡུལ་ད༵ག་ནི་གཉིས་པོ་ཕན་ཚུན་གཅིག་ལ་གཅིག་བརྟེན་ནས་འཇོག་པ་ཡི༵ན་པས།",
    "འདིར་ནི་བློའི་ངོ་བོ་ལ་མ་དཔྱོད་ཀྱང་དཔྱད་པར་བྱ་བའི་ཡུལ་རིགས་པས་རྣམ་པར་དཔྱད་པར་བྱས་ནས་སྟོང་པ་ཉིད་དུ་གྲུབ་པ་ན༵།",
    "རྣམ་པར་དཔྱོད་བྱེད་ཀྱི་བློ་ལ་ནི་རྟེན་ནམ་ཡུལ་ཡོད་པ་མི༵ན་ལ།",
    "རྟེན་དམིགས་ཡུལ་བདེན་པར་མེད་པའི་ཕྱིར་ན་ཡུལ་ཅན་གྱི་བློ་ཡང་མི་སྐྱེ་སྟེ༵།",
    "འོན་ཏེ་ཤེས་བྱའི་ཡུལ་ལམ་དོན་ཡོད་པ་ཉིད་ལས་ཡུལ་ཅན་གྱི་ཤེས་པ་བདེན་པར་གྲུ༵བ་པར་འདོད་ན་ཤེས་བྱ་དེ་རང་ཡོད་པར་བཇོག་པ་ལའང་རྟེན་ནམ་སྒྲུབ་བྱེད་ཅི་ཞིག་ཡོ༵ད་དེ་ཅི་ཡང་མེད་པས་སྒྲུབ་བྱེད་ཡང་དག་མེད་པར་གྲུབ་བོ།",
    "སྣང་ཙམ་དུ་དེ་ལྟར་ཡིན་ཡང་རྣམ་པར་དཔྱད་ན་ཡུལ་དང་ཡུལ་ཅན་གཉི་ག་ཡང་ནི་དོན་ལ་བདེན་པ་མེད་པར་འགྱུ༵ར་ཏེ།",
    "བུ་སྐྱེད་པ་མེད་པར་ནི་ཕ་ཡིན་པ་མི་སྲིད་པས་དེ་གཉིས་གཅིག་གྲུབ་པ་མེད་ན་གཉིས་མི་འགྲུབ་པ༵་དེ་བཞིན་དུ།",
    "ཤེས་པ་དང་ཤེས་བྱ་དེ་གཉིས་ཀྱང་ལྟོས་ནས་གཞག་པས་གཅིག་བདེན་པར་མེད་ན་གཉིས་ཀ་བདེན་པར་མེད་པ་ཉི༵ད་དོ།",
    "དཔེར་ན་མྱུ་གུ་ནི་ས་བོན་ལས་སྐྱེས་ཤི༵ང་ལྟོས་པ་ཡིན་ཡང་ས་བོན་ཡོད་པར་མྱུ་གུ་སྐྱེས་པ་དེ་ཉིད་ཀྱིས་རྟོགས་པར་བྱེད་པ་དེ་བཞི༵ན་དུ་ཤེས་པའང་ཤེས་བྱ་ལས་སྐྱེས་ཤིང་ལྟོས་པ་ཡིན་ཡང་ཡུལ་ཅན་ཤེས་པ་ཡོད་པ་ཡི༵།",
    "རྟགས་ལས་ཡུལ་ཤེས་བྱ་དེ་ཡོད་པར་ནི་ཅིས་མི་རྟོ༵གས་ཏེ།",
    "སུས་ཀྱང་རྟོགས་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "རྟག་པར་ཁས་བླངས་བའི་ཕྱིར་དང་།",
    "དེས་བྱས་པ་མིན་པའི་དངོས་པོ་གཞན་ཅུང་ཟད་ཀྱང་ཡོད་པ་མིན་པར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "རྡུལ་ཕྲན་འདུས་ནས་རགས་པ་རྩོམ་པ་ན་དབུས་རྡུལ་ལ་ཕྱོགས་དྲུག་ནས་སྦྱོར་ན་ཆ་དང་བཅས་པར་འགྱུར་ཞིང་།",
    "ཕྱོགས་གཅིག་ནས་སྦྱོར་བས་ཆ་མཉམ་ན་རགས་པ་རྩོམ་མི་ནུས་པའི་ཕྱིར་ཡང་དཔྱད་ན་བདེན་པར་གྲུབ་མ་མེད་དེ།",
    "ཉི་ཤུ་པར།",
    "གྲངས་ཅན་པའི་ལུགས་ཀྱི་ཤེས་བྱ་ཐམས་ཅད་གྲངས་ཉི་ཤུ་རྩ་ལྔར་ངེས་པར་འདོད་ལ།",
    "གཙོ་བོ་རྟག་པ་གཅིག་པུ་བེམ་པོ་སྣང་ཤེས་ཀྱི་ཡུལ་ལས་འདས་པ་ཐམས་ཅད་ཀྱི་བྱེད་པ་པོར་གྱུར་པ་ནི་འགྲོ་བ་བརྟན་གཡོ་མ་ལུས་པ་ཡི༵་རྒྱུ་ཡིན་པར་ནི་གྲངས་ཅན་རྣམས་འདོ༵ད་ཅིང་།",
    "བདག་དང་གཙོ་བོ་མ་གཏོགས་པ་ཕྱི་མ་ཉི་ཤུ་རྩ་གསུམ་ནི་འབྲས་བུ་འགྲོ་བ་ཡིན་པར་བརྗོ༵ད་དེ།",
    "དེ་བས་ན་གཙོ་བོ་དེ་ནི་བདེན་པར་གྲུབ་པ་ཡོད་པ་མི༵ན་པས།",
    "དེ་ཁེགས་པ་ན་དེའི་འབྲས་བུར་འདོད་པ་ཐམས་ཅད་ཀྱང་ཁེགས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་རྒྱུར་འདོད་པའི་ཡོན་ཏན་གསུམ་བདེན་པར་གྲུབ་པ་མེད་ན་འབྲས་བུར་འདོད་པའི་སྒྲ་སོགས་རྣམ་འགྱུར་རྣམས་ཀྱ༵ང་ཡོད་པ་ཉིད་ཤིན་ཏུ་རྒྱང་རིང་ཞིང་མེད་པར་འགྱུ༵ར་ཏེ།",
    "སེམས་མེད་པའི་དངོས་པོ་གོས་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་དོན་རྣམས་ལ༵་བདེ་བ་ལ་སོགས་པའི་ཚོར་བ་བདག་ཅིག་ཏུ་ཡོད་པ་སྲིད་པའང་མི༵ན་པར་འགྱུར་ཏེ།",
    "སྔར་ཡན་ལག་ཅན་དང་རྡུལ་ཕྲ་རབ་དང་གཟུང་འཛིན་འགོག་པའི་སྐབས་སུ་རྣམ་པར་དཔྱད་ནས་བདེན་མེད་དུ་གྲུབ་ཟིན་པ་མིན་ན༵མ་སྟེ་ཡིན་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་རྒྱུ་རྣམ་བུ་ལ་སོགས་པའི་ཡུལ་དེ་དག་བདེན་པར་མེད་པའི་ཕྱིར་ན་འབྲས་བུ་བདེ་བ་ལ་སོགས་པའི་ཡུལ་ཅན་ཡང་བདེན་པ་མེ༵ད་པར་གྲུབ་པོ།",
    "གསུམ་པ་བདེ་སོགས་རྟག་པར་འདོད་པ་དགག་པ་ནི།",
    "བདེ་སོགས་མི་རྟག་པར་གྲུབ་པ་དེ་བཞིན་དུ་རྣམ་འགྱུར་འབྲས་བུའི་དངོས་པོ་ཐམས་ཅད་ཀྱ༵ང་མི་རྟག་པ་ཉིད་དུ་ཅིས་མི་འདོ༵ད་ཅེས་རྟགས་ན་འདོད་དགོས་ཏེ།",
    "རྣམ་འགྱུར་རགས་པ་རྣམས་ནི་བདེ་སོགས་ཡོན་ཏན་གསུམ་ལས་གཞན་མིན་པར་འདོད་ན༵་བདེ་བ་ལ་སོགས་པ་ནི་ཕྲ་རགས་ཀྱི་སྒོ་ནས་གསལ་བར་མི་རྟག་པ་ཉི༵ད་དུ་གྲུབ་ཟིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་བདེ་བ་ལ་སོགས་པ་རྟག་ཏུ་མེད་ན་སྔར་ལས་འགགས་པའི་དངོས་པོ་འགའ་ཡང་ནི༵་ཕྱིས་སྐྱེ་བ་མིན་པར་འགྱུར་ཏེ།",
    "རྒྱུ་ཟན་ལ་འབྲས་བུ་མི་གཙང་བ་ངོ་བོ་གཅིག་ཏུ་གནས་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་རས་བཟང་པོ་ཉོས་ནས་གོན་པར་འདོད་ནའང་རས་ཀྱི་ངོ་བོ་ཉུང་ངུ་ལ་འཇལ་བའི་རིན་ཆེན་པོ་གང་ཡིན་པ་དེ་ཉིད་ཀྱིས་རས་བལ་གྱི༵་ས་བོན་མང་པོ་ཉོས་ལ་ཡུན་རིང་དུ་བགོ་བར་གྱི༵ས་ཤིག་དང་རྒྱུ་རས་བལ་གྱི་ས་བོན་ལ་འབྲས་བུ་རས་ཡུག་བཟང་པོ་གཅིག་ཏུ་གནས་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ལ་འབྲས་བུ་ངོ་བོ་གཅིག་ཏུ་ཡོད་ཀྱང་འཇིག་རྟེན་པ་རྨོངས་པ་དེ་ཁོ་ན་ཉིད་མི་ཤེས་པ་རྣམས་ཀྱིས་ས་བོན་ལ་རས་ཡུག་ཡོད་པར་མི་མཐོང་བས་མི་གོན་པ་ཡིན་ནོ་ཞེ་ན༵།",
    "མཁས་པར་འདོད་པ་དེ་ཁོ་ན་ཉིད་ཤེས་པ་ཁྱེད་ཀྱི་ལུགས་ལའང་ས་བོན་མི་གོན་པར་རས་གོན་པ་ལ་སོགས་པའི་རྣམ་གཞག་དེ་ཉི༵ད་བྱེད་ཀྱི།",
    "དེ་ལྟ་ན་འཇིག་རྟེན་པའི་མངོན་སུམ་དང་རྗེས་དཔག་ལ་སོགས་པས་འབྲས་བུའི་གནས་སྐབས་སྒྲ་ལ་སོགས་པ་གསལ་བར་མཐོང་བའང་བདེན་པར་ཡོད་པ་མ་ཡི༵ན་པར་འགྱུར་ཏེ།",
    "བུ་དེ་ཤི་ནས་མེད་དོ་སྙམ་པའི་རྣམ་པར་རྟོག་པ་ནི༵་བུ་དེ་ཡོད་པར་འཛིན་པའི་རྣམ་པར་རྟོག་པ་ཡི༵་གེགས་སམ་གཉེན་པོ་ཡིན་ཞིང་།",
    "དོན་དམ་པར་བདག་ལས་མ་ཡིན་གཞན་ལས་མིན།",
    "དུས་གསུམ་རྫས་སུ་གྲུབ་པར་འདོད་པ་ལྟར་དུས་གཞན་ནས་འདིར་འོངས་པའང་མ་ཡིན་པས་དང་པོར་སྐྱེ་བ་མེད་ལ༵།",
    "དེ་ལྟར་བརྟགས་ན་མ་གྲུབ་ཀྱང་དེ་ཁོ་ན་ཉིད་ལ་རྨོངས་པའི་བྱིས་པ་རྣམས་ཀྱིས་བདེན་པར་གང་བྱས་པའི་ཀུན་རྫོབ་ཀྱི་སྣང་བ་འདི༵་དག་སྒྱུ་མའི་རྟ་དང་གླང་པོ་ལ་སོགས་པ་ལས་ནི་ཁྱད་པར་ཅི་ཞིག་ཡོ༵ད་དེ།",
