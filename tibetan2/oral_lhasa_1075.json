    "འདི་ནི་བྱ་བའི་ཁྱད་པར་ཡིན་ཏེ།",
    "རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་ངོ་བོ་ཉིད་དེ་བཞིནཉིད་ཀྱི་རང་བཞིན་ནོ།",
    "ཇི་ལྟར་མཁའ་འགྲོ་མའི་དྲབ་སྡོམ་པ་དེ་བཞིན་དུ་བདག་ཉིད་དཔའ་བོ་ཡིན་པ་ལ་དཔལ་དེ་ལ་ཡང་དག་པར་སྦྱོར་བར་དབྱེ་པའི་དོན་ཏོ།",
    "ཅེས་གསུངས་སོ།",
    "ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་སྐྱེ་བས་དངོས་པོ་བདག་ཉིད་ཡོད་པ་ཡིན་ན་དངོས་པོ་ཡོད་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་ལྟ་ན་ནི་སྐྱ་པའི་སྔོན་རོལ་ཏུ་སྐྱེ་བ་མེད་པའི་དངོས་པོ་ཡོད་པར་བསྟན་པར་འགྲུབ་བོ།",
    "གལ་ཏེ་ཡང་སྐྱེ་བ་མེད་པར་ཡོད་པར་ལན།",
    "གཞན་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་བླངས་པར་བྱ་བ་ཉིད་དུ་དེ་བ་བྱེད་པར་བྱའོ་ཞིན།",
    "རྣམ་པར་ཤེས་པ་སྔ་མ་སྔ་མལས་རིག་པའིས་བསྡུས།",
    "དྲི་ན་བའི་རྣམ་པར་ཤེས་པ་རྟོག་པ་མེད་པ་འམ།",
    "ཁ་ཅིག་ཏུ་ཐོག་ཆ་ལྟར་ཕྱུང་བ་ལས་རྟོག་པ་མེད་པ་ལས་རྣ་བའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ཡིན་ནོ།",
    "མེད་པར་འགྱུར་རོ།",
    "ཐོག་མ་མེད་པའི་རྣམ་པར་རྟོག་པའི་བག་ཆགས་འབའ་ཞིག་ལས་གྱུར་བའི་རྣམ་པར་རྟོག་པསབྱས་པའི་ཤེས་བྱའི་དོན་དམ་མ་ཡིནཔིདདོ།",
    "རང་ཉིད་གསལ་བའི་ངོ་བོ་ཉིད་ཡིན་པར་འགྱུརཏེ།",
    "གཞན་དུན་སྒྲུབ་པར་མི་ནུ་ས་ཏ་དེའི་གསལ་བར་བྱེད་པ་ཉིད་རྟོགས་པར་དཀའ་བ་ཡིན་ཏེ།",
    "དེ་གཞན་གྱི་མགཅ་ཁ་པ་ལ་བྱེད་པའི་ངོ་བོ་ཉིད་ཡིན་ན་དེ་ཡང་གཞན་གྱིས་བྱེད་དགོས་པས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པའི་རྒྱུད་ལས་བྱུང་བའི་དེ་མ་ཐག་པའི་རྐྱེན་གྱིས་རྨི་ལམགྱི་རྣམ་པར་ཤེས་པ་བཞིན་དུརྣམ་པར་ཤེས་པར་སྲུབས་ཀྱང་དེ་བཞིན་དུ་གདགཕྱིར་སྒོ་བཅད་ནས་ཁྱིལ་དུ་ཉལ་ཏེ།",
    "དེ་ལ་ཉེ་བར་དམིགས་པམེད་པར་ནི་མི་གྲུབ་པོ།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པགཟུགསལསོགས་པའི་གཟུགས་བརྙན།",
    "མངོན་སུམཉིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་བསྒྲུབ་པས་དོན་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་དོན་ཉིད་མངོན་སུམ་ཡིནགྱིརྣམ་པར་ཤེས་པནི་མ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་དེ་རྟག་པའི་ངོ་བོ་ཉིད་དུ་འགྱུར་རོ།",
    "ཡང་དག་པར་རིག་པ་ཡང་ཡིན་ནོ།",
    "ཉིད་ཀྱིས་དེ་ན་ཡང་དག་པར་རིག་པ་ནི་མི་སྲིད་དོ།",
    "སྒྲའི་ཚུལ་ལས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་སྟེང་དུ་བར་མ་ཆོད་པར།",
