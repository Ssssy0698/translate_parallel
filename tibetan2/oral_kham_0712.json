    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ།",
    "ཛཧཱུྃ་བི་ཧོཞེས་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་མེད་པར་ཐིམ།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
    "ཞེས་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
    "ཞེས་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཞེས་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཅེས་པས་བྱིན་གྱིས་བརླབས་ནས་སློབ་དཔོན་གྱིས་སྔགས་དང་ཕྱག་རྒྱས་དངོས་སུ་ཕུལ་ཞིང་ཁྱེད་རང་རྣམས་ཀྱིས་ཀྱང་ཐུགས་དམིགས་མཛད་པར་ཞུ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་གསུང་རྡོ་རྗེའི་ང་རྒྱལ་ལས་འཕོས་ཏེ་ཐུགས་རྡོ་རྗེ་མི་བསྐྱོད་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གསང་བའི་གནས་ཧཱུྃ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པའི་ནོར་བུ་ལ་ཨོ་དཀར་པོས་མཚན་པ་དང་།",
    "དེ་ནས་རིག་མའི་རྐང་པ་གཡོན་པ་ཁྱེད་རང་རྣམས་ཀྱི་མགོ་ཐོག་དུ་བཞག་སྟེ།",
    "དེ་གསུམ་ལྡོག་ཚུལ་ཐ་དད་ཀྱང་རང་བཞིན་སོ་སོར་དབྱེར་མི་ཕྱེད་པ་ནི་ངོ་བོ་ཉིད་ཀྱི་སྐུ་སྟེ།",
    "དེའི་གཙོ་བོ་བཅུ་བདུན་སྤྱན་མ་དང་མཉམ་པར་སྦྱོར་བའི་མདུན་ཏུ་བདག་ཉིད་འདུག་པར་གྱུར།",
    "དེའི་གཙོ་བོ་མཱ་མ་ཀཱི་དང་མཉམ་པར་སྦྱོར་བའི་མདུན་ཏུ་བདག་ཉིད་འདུག་དཔལ་ལྡན་རྡོ་རྗེ་ཐུགས་འཆང་བ།",
    "སླར་ཡང་རང་ཉིད་རྡོ་རྗེ་འཆང་ཆེན་པོའི་ངོ་བོར་གྱུར།",
    "ཞེས་ཤེས་པའི་ཆེད་དུ་སྤྲོ་བ་བསྐྱེད་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "དེ་དེ་ལྟར་བྱས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་གདོད་མ་ནས་རྡོ་རྗེ་གསུམ་གྱི་ངོ་བོར་གནས་པ་དེ་ཆོ་ག་འདིས་ངོ་འཕྲོད་ཅིང་དེར་གསལ་བར་བྱས་པ་ཡིནགྱི་དོན་སྔགས་ཀྱི་ས་བོན་བཏབ་པ་ཡིན་ནོ།",
    "ད་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་ལྷ་དང་སྐལ་བ་མཉམ་པའི་ཆེད་དུ་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་ཆོ་ག་དང་།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་བཅོམ་ལྡན་འདས་དཔལ་གསང་བ་འདུས་པ་མི་བསྐྱོད་རྡོ་རྗེའི་ལྷ་ཚོགས་རྣམས་ལ་ལུས་ངག་ཡིད་གསུམ་།",
    "ཕྱག་རྒྱ་དེ་ཉིད་མེ་ཏོག་དང་བཅས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་བཞག་ཅིང་ཕན་ཡོན་གྱི་སྒོ་ནས་དམ་ལ་གཞག་པ་ནི།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་ཀྱི་ལག་པ་གཡས་ནས་བཟུང་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་རྐང་མཐིལ་གྱི་བར་ཁོང་སྟོང་དུ་གྱུར་པའི།",
    "ཁྱེད་རང་རྣམས་ཁྲུས་ཀྱི་ཁང་པར་ཞུགས་ཏེ།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཅུང་ཟད་དཀྲོལ་ཏེ་དཀུ་གཡོན་པའི་ཕྱོགས་སུ་བཀན་ཏེ་བཟུང་།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཨོ་ལས་བྱུང་བའི་འཁོར་ལོ་རྣམ་པར་སྣང་མཛད་ཀྱི་རང་བཞིན་ཁྱེད་རང་རྣམས་ལ་བརྟན་པའི་ཕྱིར།",
    "ཧཱུྃལས་བྱུང་བའི་པདྨ་འོད་དཔག་མེད་ཀྱི་ངོ་བོ་ཁྱེད་རང་སོགས།",
    "ཨོ་བཛྲ་གསང་འདུས་ཧཱ་ལས་བྱུང་བའི་རྡོ་རྗེ་རྐྱང་པའམ་རྡོ་རྗེ་རྒྱ་གྲམ་དོན་ཡོད་གྲུབ་པའི་ངོ་བོ་ཁྱེད་རང་སོགས།",
    "བསྡུ་། ན་ཁྱེད་རང་རྣམས་དང་རིག་མ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཡབ་ཡུམ་དུ་གྱུར།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སྭ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་ས་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཞེས་བརྗོད་ལ་རང་གནས་སུ་འདུག་གོ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཇི་ལྟར་བསྐུར་བ་ཆོ་གའི་མཚན་ཉིད་རྣམས་ཀྱང་ཐུགས་ལ་མངའ་བཞིན་ཡིན་པར་འདུག་པ་ཞེས་ཙམ་གྱིས་འཐུས་སོ།",
    "དེའང་རང་ཉིད་གཅིག་པུའི་དོན་དུ་མ་ཡིན་ཏེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་།",
    "སྟོང་པའི་ངང་ལས་པདྨ་དང་ཉི་མའི་སྟེང་དུ་ཁྱེད་རང་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་།",
    "དེ་ལྟར་ཁྱེད་རང་རྣམས་མི་བསྐྱོད་པ་གདན་གསུམ་ཚང་བའི་སྐུ་ཅན་དུ་གྱུར་པ་ལ།",
    "ཞེས་པས་ཆ་གཅིག་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཡན་ལག་བཞི་པར་བསྒྲུབ་པའི་སླད་དུ་གསོལ་བ་འདེབས་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཨོ་ཇ་ཨཱབིགྷཱན་ཀྲྀཏ་ཧོཞེས་པས་ཆ་གཅིག་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཡན་ལག་བཞི་པར་བསྒྲུབ་པའི་སླད་དུ་གསོལ་བ་འདེབས་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཞེས་པས་ཆ་གཅིག་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཡན་ལག་བཞི་པར་བསྒྲུབ་པའི་སླད་དུ་གསོལ་བ་འདེབས་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གཟུགས་ཀྱི་ཕུང་པོ་མི་དམིགས་ཏེ་སྟོང་པར་གྱུར།",
    "ཁྱེད་རང་རྣམས་ཡན་ལག་བཞི་པར་བསྒྲུབ་པའི་སླད་དུ་གསོལ་བ་འདེབས་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་རྣམས་བཅོམ་ལྡན་འདས་འཇམ་པའི་རྡོ་རྗེའི་སྐུ་ཅན་དུ་གསལ་བའི་སྟེང་དུ་བླ་བྲེ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
