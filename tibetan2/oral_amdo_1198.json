    "ཁོ་གཉིས་ཀྱིས་རྒྱལ་པོ་དང་བཙུན་མོའི་ཆས་གོས་རྣམས་ཕུད།",
    "ཞིམ་ཕྲུག་གིས་མགོ་ལ་ཁ་བཏགས་ཤིག་དཀྲིས་པ་དང་།",
    "ཁྱི་ཕྲུག་གིས་སྟོད་ཐུང་རྩབ་རལ་ཞིག་གྱོན་པ་རེད།",
    "ཁྱི་ཕྲུག་གིས་ད་ང་གཉིས་རྒྱལ་པོ་དང་བཙུན་མོ་འཁྲབ་ཀྱི་མིན།",
    "ཞིམ་ཕྲུག་གིས་ད་རེས་ཁྱེད་རང་རྒྱལ་པོ་མ་རེད་ལ་ངའང་བཙུན་མོ་མིན།",
    "ཞིམ་ཕྲུག་གིས་ནང་གི་པ་ཕ།",
    "ང་གཉིས་ཀྱིས་བུ་མོར་ལྟ་སྐྱོང་ཡག་པོ་བྱེད་ཐུབ་ཀྱི་མི་འདུག་པས།",
    "ད་ག་རེ་བྱས་ན་ཡག་གི་རེད་ལབ།",
    "མོ་དེར་གཡུགས་ནས་ངུ་བའི་ཚུལ་ཡང་བྱས་པ་རེད།",
    "གཅིག་བྱས་ན་མོ་སྤྱང་ཀིས་ཟ་རྒྱུའི་ཉེན་ཁ་ཡོད་རེད།",
    "དེ་ལས་མི་ཡག་པོ་དེ་འདྲ་ཐུག་ན་ཁོ་ཚོར་བཙོང་ཆོགཁོ་རང་ཚོ་ལའང་ཕན་ཐོགས་ཡོད་ཀྱི་རེད་ཟེར།",
    "ད་ཁྱེད་རང་གཉིས་ཀྱིས་ང་གཉིས་ལ་རོགས་པ་ཞིག་བྱེད་དགོས་འདུགཁྱེད་རང་གཉིས་ལ་བུ་མོ་ཞིག་དགོས་པས་ང་ཚོའི་བུ་མོ་ཉོས་ཨང་།",
    "ང་གཉིས་བུ་མོ་འཚོང་བར་ཡོང་གི་ཡིན་ལབ་པ་རེད།",
    "ཁྱི་ཕྲུག་གིས་བློ་བཟང་དང་འཛོམས་སྐྱིད་ལ་བལྟས་ཏེ།",
    "ཕ་གིར་མི་ཁ་ཤས་འདུག་ལབ་པ་དང་ཁོང་གཉིས་ཀྱི་འགྲམ་ལ་ཕྱིན་ནས།",
    "ང་གཉིས་ལ་བུ་མོ་ཞིག་འཚོང་ཡས་ཡོད།",
    "ཁྱེད་གཉིས་ལ་བུ་མོ་ཞིག་དགོས་སམ།",
    "བུ་མོ་ཞིག་དགོས་ཡོད།",
    "བློ་བཟང་གིས་ཁྱེད་རང་གཉིས་ཀྱི་བུ་མོས་ག་རེ་ཤེས་ཀྱི་རེད་ཅེས་སྐད་ཆ་དྲིས་པས།",
    "ཁྱི་ཕྲུག་གིས་ག་རེ་ཡིན་ནའང་ཤེས་ཀྱི་རེད།",
    "མོས་ཁ་ལག་བཟོ་ཤེས་པ་དང་ཁང་པ་གཙང་མ་བཟོ་ཤེས་པ།",
    "ཕྲུ་གུ་གཉིས་ཀྱིས་ང་གཉིས་ལ་བུ་མོ་དེ་འདྲ་ཞིག་དགོས་ཡོད་ཟེར།",
    "འཛོམས་སྐྱིད་ཀྱིས་མོས་ད་དུང་ག་རེ་ཤེས་ཀྱི་རེད་དམ་ཅེས་དྲིས་པས།",
    "ཞིམ་ཕྲུག་གིས་ད་དུང་མང་པོ་ཤེས་ཀྱི་རེད།",
    "ད་དུང་ཁྱེད་རང་གཉིས་ཀྱིས་རོགས་པ་བྱས་ན་མོས་གྱང་གི་ལྡེབས་ལ་ཡང་འཛེག་ཐུབ་ཀྱི་རེད་ལབ།",
    "ཁྱི་ཕྲུག་གིས་གལ་སྲིད་གྱང་ནས་མར་ཟགས་ནའང་ངུ་ཡི་མ་རེད་ལབ།",
    "ཕྲུ་གུ་གཉིས་ཀྱིས་ང་གཉིས་ལ་དགོས་ཡས་དེ་ག་རང་རེད།",
    "མོ་ལ་རིན་པ་ག་ཚོད་རེད་ལབ་པས།",
    "ཁྱི་ཕྲུག་གིས་རིན་པ་མི་དགོས།",
    "གལ་སྲིད་ཁྱེད་རང་གཉིས་ཀྱིས་མོ་ལ་ལྟ་སྐྱོང་ཡག་པོ་བྱས་ན་རིན་གོང་གཅིག་ཀྱང་མི་དགོས་ལབ།",
    "འཛོམས་སྐྱིད་དང་བློ་བཟང་ལ་དུག་ལོག་སེར་པོ་གཡོགས་པའི་ཨ་ལད་པད་ཀོག་བུ་ཞིག་ཀྱང་ཡོད་རེད།",
    "ཨ་ལད་པད་ཀོག་ཆུང་ཆུང་དེ་ཁོའི་མནའ་མར་བསུས་ནས་ཆང་སའི་གྲ་སྒྲིག་བྱས་པ་རེད།",
    "ཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གིས་ཡང་བསྐྱར་རྒྱལ་པོ་དང་བཙུན་མོའི་གོས་ཆེན་གྱི་གཟབ་སྤྲོས་གྱོན་པ་རེད།",
    "དེ་ལྟར་ཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གིས་ཕྲུ་གུ་གཉིས་ཀྱི་ཆེད་གཏམ་བརྗོད་འཁྲབ་པ་དང་།",
    "ཉིན་མོ་དེ་ནི་ལོ་གསར་ཚེས་གཅིག་རེད།",
    "བློ་བཟང་གིས་འཛོམས་སྐྱིད་ལ་ང་གཉིས་ན་དུས་ཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གིས་གཏམ་བརྗོད་འཁྲབས་ནས་སེམས་པ་སྐྱིད་པོ་བཟོས་བྱུང་།",
    "ད་རེས་ཁོ་གཉིས་ཀྱི་དྲིན་ལན་འཇལ་ཆེད།",
    "ཁྱེད་རང་གིས་ལྷ་མོའི་ཆས་གོས་གྱོན་ནས།",
    "བློ་བཟང་གིས་བལ་གྱི་ཨ་ར་དཀར་པོ་ཞིག་བསྒར་བ་དང་།",
    "སྐྱིད་འཛོམས་གྱིས་མགོ་ལ་ཤོག་བུའི་རིག་ལྔ་ཞིག་གྱོན་ནས་ལྷ་མོ་ནང་བཞིན་བཟོས་པ་རེད།",
    "ཁོ་གཉིས་ཀྱིས་ཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གི་ནང་ལ་ཕྱིན་ནས་ཁང་པའི་སྒོ་བརྡུངས་པ་དང་།",
    "ཧོབ་དེ་ཁ་ལ་འབྲས་དཀར་འཁྲབ་ནས་ཧང་སང་འཇུག་དགོས་བསམས་པ་རེད།",
    "འོན་ཀྱང་སྒོ་ཕྱེ་ནས་ལྟ་དུས་ཁོ་རང་གཉིས་ཧང་སང་དགོས་བྱུང་བ་རེད།",
    "འབྲས་དཀར་གཅིག་དང་ཨ་ཅེ་ལྷ་མོ་གཅིག་བསྡད་ཡོད་པ་རེད།",
    "འདིའི་ནང་འབྲས་དཀར་དང་ལྷ་མོ་གཞན་དག་ཅིག་འདུགཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གཉིས་མཐོང་སར་མི་འདུག་པས།",
    "ཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གིས་ཀྱང་ལོ་གསར་ཚེས་གཅིག་ཉིན་འབྲས་དཀར་དང་ལྷ་མོའི་ཆས་གྱོན་གྱི་རེད་བསམ་པ་ཁོ་གཉིས་ཀྱི་བསམ་བློའི་ཡུལ་ལ་མེད།",
    "ཁྱི་ཕྲུག་དང་ཞིམ་ཕྲུག་གིས་ཕྲུ་གུ་གཉིས་ཧང་སང་དགོས་པ་ཞིག་བཟོ་ཆེད།",
    "འབྲས་དཀར་དང་ལྷ་མོའི་ཆས་གྱོན་ནས་འགྲོ་ཆོག་ཆོག་བྱེད་བཞིན་པའི་སྐབས།",
    "འབྲས་དཀར་དང་ལྷ་མོ་གཞན་ཞིག་ཁོ་གཉིས་ཀྱི་ཁྱིམ་དུ་སླེབས་པ་རེད།",
    "ཨ་མཆོག་གཅིག་སློང་བ་ནི་མཉམ་པ་ལས་ཆུན་མ་བླང་བའོ།",
    "ལྷ་རུང་གིས་དེ་བཞིན་དུ་མཛོད་ཅིག།",
    "དེ་ནས་གང་གི་འཕྲོ་བཟུང་བར་བྱ་སྟེ།",
    "གཟུགས་ཁམས་ཀྱི་ལྷ་རྣམས་ཀྱང་རང་རང་གི་ཁྱིམ་གྱི་བཀོད་པར་དུར་ཁྲོད་ཀྱི་འདུ་ཤེས་སྐྱེས་པར་གྱུར་ཏོ།",
    "ཞེས་སོགས་ཏེ་དེ་དག་གི་སྡོམས་ཚིགས་སུ་བཅད་ན།",
    "མོས་དང་མི་སྡུག་སོ་སོར་རྟོག།",
    "ལྷའི་མེ་ཏོག་གི་ཆར་པུས་མོ་ནུབ་ཙམ་ཡང་བབ་བོ།",
    "གང་གི་ཚེ་ན་དགའ་ལྡན་གནས་མཆོག་ནས།",
    "གྲོགས་པོ་དག་ཤེས་པར་གྱིས་ཤིག་ང་འཛམ་བུའི་གླིང་གི་ཡུལ་དབུས་སུ་ཉིང་མཚམས་སྦྱོར་བ་ལེན་གྱིས།",
