    "ཡང་མང་པོས་རོལ་མོའི་ཆ་བྱད་ཐོགས་པ་དང་།",
    "སྐྱེ་བོ་རྣམས་ཀྱི་ལས་ཀྱི་མཐའ་རེ་ཞིག་རྒྱུན་ཆད་པ་དང་།",
    "ཤིང་གི་ལྷས་ལུས་ཕྱེད་སྟོན་ཅིང་འདུད་པ་རྣམས་སོ།",
    "དེ་ནས་ལྷ་མོ་སྒྱུ་འཕྲུལ་གྱིས་ཀྱང་བཙའ་བའི་དུས་ཤེས་ནས་ནམ་སྲོད་ལ་རྒྱལ་པོའི་དྲུང་དུ་སྐྱེད་མོས་ཚལ་བཟང་པོར་འགྲོ་བར་གསོལ་ནས།",
    "ཤིང་རྟ་བརྒྱད་ཁྲི་བཞི་སྟོང་ལ་སོགས་པ་བསྟད་ཅིང་བརྒྱན་ནས་དེར་ཤིང་རྟ་མཆོག་གི་ནང་དུ་ལྷ་མོ་སྒྱུ་འཕྲུལ་གཅིག་པུ་ཞུགས་ཤིང་།",
    "ཤཱཀྱའི་བུ་མོ་སྟོང་ཕྲག་དྲུག་ཁྲིས་ནི་མདུན་དུ་བདར།",
    "༤ ༧ ༥ མཚོན་ཐོགས་པ་བརྒྱད་ཁྲི་བཞི་སྟོང་གིས་ནི་སྲུང་།",
    "བཙུན་མོའི་འཁོར་རོལ་མོ་འཁྲོལ་ཞིང་གླུ་དབྱངས་ལེན་པ་དྲུག་ཁྲིས་ནི་བསྐོར།",
    "ལྷ་མ་ཡིན་རྣམས་ཀྱི་བུ་མོའི་ཚོགས་སོ་སོར་བརྒྱད་ཁྲི་བཞི་སྟོང་རེས་ཀྱང་དེ་བཞིན་དུ་གླུ་དབྱངས་ལེན་ཅིང་བསྔགས་པ་བརྗོད་བཞིན་པས་རྗེས་སུ་འབྲངས་ཏེ་འཇིག་རྟེན་སྐྱོང་བ་བཞིས་ནི་ཤིང་རྟ་འདྲེན་པར་བྱེད།",
    "རེག་ན་བདེ་བ།",
    "དེ་ནས་ལྷ་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་དེ་ཉིད་མཁའ་ལ་གློག་ཕྲེང་འགྱུ་བ་ལྟ་བུའི་ཕྱག་གཡས་པ་བརྐྱངས་ཏེ་སླཀྵའི་ཡལ་ག་ལ་འཇུས་ནས་ནམ་མཁའི་ངོས་ལ་ལྟ་ཞིང་བྱ་རྨྱང་བྱེད་ཅིང་འདུག་སྟེ།",
    "དེའི་ཚེ་འདོད་པ་ན་སྤྱོད་པའི་ལྷའི་བུ་མོ་དྲུག་ཁྲིས་ཀྱང་བཀུར་བསྟི་བྱེད་དོ།",
    "བརྒྱ་བྱིན་དང་ཚངས་པ་དག་གིས་ལྷའི་གོས་ཀཱ་ཤི་ཀཱའི་སླེ་མོས་གུས་པ་དང་བཅས་པས་བླངས་ཤིང་།",
    "ཀླུ་ཆེན་པོ་དགའ་བོ་དང་ཉེ་དགའ་དག་གིས་ནམ་མཁའ་ལས་ལུས་ཕྱེད་ཕྱུངས་ཏེ་བསིལ་བ་དང་དྲོ་བའི་ཆུ་རྒྱུན་གཉིས་ཀྱིས་སྐུ་ཁྲུས་གསོལ་བ་དང་།",
    "ས་ཆེན་པོའང་རྣམ་པ་དྲུག་ཏུ་གཡོས་ཤིང་ལྷ་མིའི་སིལ་སྙན་དང་རོལ་མོ་ཐམས་ཅད་ཀྱང་མ་བརྡུངས་པར་སྒྲ་འབྱིན་པ་གྱུར་ཏོ།",
    "དེ་ཚེ་སྐྱེ་དགུ་དག་ཀྱང་ཉོན་མོངས་ཚོགས།",
    "གང་གི་ཐུགས་རྗེའི་ཆར་གྱིས་ཞི་མཛད་པས།",
    "ངན་སོང་ངན་འགྲོ་ལོག་པར་ལྟུང་རྣམས་ཀྱང་།",
    "ལྷ་མོའི་ནུ་སྡུག་གངས་རི་རྒྱས་པའི་འགྲམ།",
    "གཞོན་ནུ་ཉིན་མོར་བྱེད་པ་འདི་ཤར་བས།",
    "གྲགས་ལྡན་ལ་སོགས་པའི་བུ་མོ་ཁྲི།",
    "བྲན་མོ་བརྒྱད་བརྒྱ།",
    "རྟེའུ་མོ་ཁྲི།",
    "བལ་གླང་གི་ཕྲུ་གུ་ཕོ་མོ་སྟོང་།",
    "དེ་ནས་ལྷའི་བུ་མོ་ཁྲི་ཕྲག་མང་པོས་སྤོས་ཀྱི་འབྲུ་མར་དང་།",
    "ཇི་ལྟར་ངན་སོང་རྣམས་ཞི་ཞིང་།",
    "འདི་ཨ་མས་འམ་ལྷའམ་དྲི་ཟའམ།",
    "སྒྱུ་འཕྲུལ་ཆེན་མོས་ལུམྦི་ནཱིའི་ཚལ་དུ་ལྗོན་པ་མྱ་ངན་འཚང་གི་ཡལ་གས་བཏུད་པ་དེར་འཇུས་ཏེ་འགྲེང་བཞིན་དུ་འདུག་པའི་ཚེ།",
    "འགྲོ་བ་མཐའ་དག་གི་ཡོན་གནས་སུ་འགྱུར་བར་བྱའོ།",
    "འདི་ལྟ་བུའི་རྫུ་འཕྲུལ་ཆེ་བ་དང་མཐུ་ཆེ་བའི་བུ་སྐྱེས་པ་ནི་བདག་གིས་རྙེད་པ་ལེགས་པར་རྙེད་དོ་ཞེས་ཆེད་དུ་བརྗོད་པ་དང་།",
    "གྲགས་འཛིན་མ་སོགས་ཤཱཀྱའི་བུ་མོ་ལྔ་བརྒྱ་བཙས་པ་དང་།",
    "དེའང་བུ་མོ་ཁྲི་ཕྲག་བརྒྱ་སྟོང་མང་པོས་བུམ་པ་སྤོས་ཆུས་བཀང་བ་དང་།",
    "བྲམ་ཟེ་ལྔ་སྟོང་གིས་དྲིལ་བུ་ཐོགས་ནས་ཤིས་པ་བརྗོད་པ་དག་མདུན་ནས་འགྲོ་བ་དང་།",
    "ལྷའི་བུ་མོ་རྒྱན་གྱིས་བརྒྱན་པ་ཉི་ཁྲིས་དྲངས་སོ།",
    "སེར་སྐྱའི་གཞིར་ཡང་ཤཱཀྱ་ལྔ་བརྒྱས་གཞོན་ནུའི་ཆེད་དུ་ཁྱིམ་ལྔ་བརྒྱ་ཕུབས་ཏེ་རང་རང་གིས་བྱས་པའི་ཁྱིམ་གྱི་སྒོར་གུས་པ་དང་བཅས་པས་འཁོད་དེ་སོ་སོ་ནས་ཀྱེ་དོན་ཐམས་ཅད་གྲུབ་པ་འདིར་གཤེགས་སུ་གསོལ།",
    "གཞོན་ནུའི་སྲུ་སྐྱེ་དགུའི་བདག་མོ་གོ་ཏ་མཱི་དང་།",
    "ཤཱཀྱའི་བུ་མོ་ལྔ་བརྒྱ་དག་ཀྱང་རིམ་གྲོ་བྱེད་པར་བསྐོས་ཤིང་།",
    "ཀྱེ་མི་ཁྱོད་རྒྱལ་པོའི་དྲུང་ཚོ་ཚན་ཁ་བག་ཡལ་བ་པ་ས",
    "དུ་སོང་ལ་ཆབ་སྒོར་དྲང་སྲོང་ཞིག་མཆིས་སོ་ཞེས་གསོལ་ཅིག།",
    "ཁྱོད་ཀྱི་སྲས་ཞིག་བལྟམས་པ་དེ་བལྟའོ།",
    "དེ་ནས་ཡབ་ཀྱིས་གཞོན་ནུ་དོན་ཐམས་ཅད་གྲུབ་པ་ལག་པ་དག་གིས་ལེགས་པར་བླངས་ནས་དྲང་སྲོང་གི་དྲུང་དུ་ཁྱེར་བ་ལ།",
    "རྒྱལ་པོ་ཆེན་པོ་གཞོན་ནུ་དོན་ཐམས་ཅད་གྲུབ་པ་འདི་བདག་གིས་བསྟན་དང་སྦྱར་བ་ན།",
    "འདིའི་མཚན་ནི་གོང་གི་སྐུ་གསུམ་གྱི་སྐབས་སུ་བསྟན་ཟིན།",
    "གཟིགས་པ་སྒྲིབ་མེད་དག་པ་དང་།",
    "གཞུང་དང་སྦྱར་བའི་ཉན་ཐོས་ལ་ཡོད་པ་དང་རྗེས་མཐུན་གྱི་དང་པོར་དྲན་པ་ཉེར་བཞག་གི་རྣམ་པ།",
    "སྤང་བྱ་མ་ཤེས་ན་ལམ་ཤེས་དེ་གང་གི་གཉེན་པོ་ཡིན་པ་ཡང་མི་རྟོགས་པས་སོ།",
    "བྱང་སེམས་ཀྱི་གཞི་ཤེས་ཀྱི་ཡུམ་ནི་ཚུ་རོལ་དང་ཕ་རོལ་སྲིད་པ་དང་ཞི་བའི་མཐའ་ལ་གནས་པ་མིན་ཞིང་སྲིད་ཞི་དེ་དག་གི་བར་དེ་ལས་གཞན་ནའང་མི་གནས་པར་འདོད་པ་ཡིན་ཏེ།",
    "འཁོར་འདས་དེ་དག་གི་བར་ན་ཡང་མི་གནས་པའི་ཕྱིར་ཏེ།",
    "ཡང་དག་པའི་ཡུམ་དང་རིང་བར་གྱུར་པའི་ཉན་ཐོས་དང་སོགས་པས་རང་རྒྱལ་གྱི་རྒྱུད་ལ་ཡོད་པ་རང་གི་རྟོགས་པ་གང་ཟག་དང་།",
    "ཏེ་མི་འགྱུར་བར་ཐལ།",
