    "མེ་ཏོག་བཅས་ཀྱི་ཡིད་བརྙན་དེ་བསྐྱར་ཅིང་ཟློས་མོད།",
    "དེ་ལས་ལྡོག་སྟེ་སྒྱུ་རྩལ་གྲུབ་ལུགས་ཀྱི་སྐབས་ཐོག་རེ་རེར།",
    "རང་རང་ལ་ཐུན་མོང་མ་ཡིན་པའི་བྱེད་ནུས་མངའ་བ་ལས་གཞན།",
    "བརྗོད་བྱ་ཟབ་འཇུག་དང་ཚོར་འདུའི་འཕེལ་འགྱུར་དུའང་རམ་འདེགས་ཀྱི་ནུས་པ་ཐོན་པར་བྱས་འདུག་ཞི་བསོ་ལྟ་དང་གཟབ་ཉན།",
    "སྤྱིར་ཤིས་ཚིག་ནི་དངོས་ཡོད་མ་ཡིན་པའི་འབྱུང་འགྱུར་གྱི་ཡུལ་ལ་སྨོན་པ་ཡིན་མོད།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བསམ་བློ་རེ་བཏང་ན་ཤིས་ཚིག་གང་ཡིན་ཀྱང་།",
    "ཁ་གཡང་ཁོག་སྟོང་ཞིག་གི་འདམ་དུ་བྱིང་དུ་མ་བཅུག་པར་སྙན་ངག་པ་ཞིག་གི་འགན་འཁྲི་རུ་ལྷག་བསམ་གྱི་འོ་མཚོ་ལས་བཏོན་པ་ཡིན་ཕྱིན།",
    "དངོས་ཡོད་ལ་རེ་བའི་ཁེངས་ཤིང་མ་འོངས་མངོན་འགྱུར་བྱེད་པར་ཁས་འཆེས་པའི་སྤོབས་སེམས་ཤིག་ཅི་མ་ཡིན།",
    "འཇིག་རྟེན་གནམ་འོག་གི་རང་ཡུལ་ཙམ་འདིར་བློ་སྣ་རེ་གཏད་ནའང་ཤམ་བྷ་ལ་དེ་ང་ཚོ་དང་རྒྱང་ཐག་ག་ཙམ་རིང་ཨང་།",
    "རང་རྟོག་ལ་འགོག་མེད་ཀྱི་གཤོག་ཟུང་ཐོགས་ཆོག་མོད།",
    "སྐྱ་སེར་གཉིས་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་འཚོ་བའི་རོལ་སྟངས་སམ་སྤྱོད་ལུགས་ལས།",
    "ང་ཚོས་རྩོམ་མཁན་ལ་འཇིག་རྟེན་འཚོ་བའི་ཉམས་མྱོང་ཞན་ཞེས་སྨྲ་ཡོད་མོད།",
    "སྐྱེས་བུ་གང་རུང་གི་ཚེ་གཅིག་ལུས་གཅིག་ནམ་ཡང་ཆགས་འཇིག་གི་ཕྱོགས་སུ་བགྲོད་པའི་གོམ་སྒྲ།",
    "སྐྱེས་བུ་གང་རུང་གི་ཚེ་གཅིག་ལུས་གཅིག་དྲན་བྱུང་།",
    "སྨྲེང་སེམས་ཀྱིས་བྲིས་པའི་རི་མོ་བཞིན།",
    "ཕྱི་གསལ་ནང་གསལ་གྱི་ཆགས་འཇིག་སྐྱེས་བུ་ཞིག་དང་སག་ལྷམ་ཆ་གཅིག་གི་སོ་ལྟ་དང་གཟབ་ཉན།",
    "སྐྱེས་བུ་ཞིག་གི་ཚེ་གཅིག་ལུས་གཅིག་ལ།",
    "སྐྱེས་བུ་གང་རུང་གི་ཚེ་གཅིག་ལུས་གཅིགབསམས་ཤིང་བསམས་ན།",
    "ཆགས་འཇིག་གིས་གློད་པའི།",
    "སྐྱེས་བུ་ཆེ་ཆུང་གི་དབྱེ་མཚམས་ནས་གྱེས་པའི།",
    "ཐེར་ཟུག་གི་ངོས་ཤིག་ཀྱང་ཡོད་པ།",
    "ལྗིད་ཏིག་ཏིག་འཇིག་རྟེན་འཇིག་རྟེན་ཡིན་པའི་མཐར་ཐུག་གི་གནས་ལུགས་རྙེད་པས།",
    "ང་ཚོའི་མྱོང་སྣང་ལ་མཁར་ཤུལ་ཤིག་ལས་བསླངས་པའི་སྐྱོ་ཉམས་མེད་པར།",
    "དེ་ལས་ལྡོག་སྟེ་བསམ་བློས་ཕྱུག་པའི་སྐྱེས་བུ་ཞིག་གི་གཟི་བརྗིད་ཀྱི་བརྒྱུད་རིམ་ཡིན།",
    "གོམ་སྒྲ་དེ་དངོས་གནས་ཇི་འདྲའི་ལྗིད་ཏིག་ཏིག་ཅིག་རེད་ཨང་།",
    "སྨྲེང་སེམས་ཀྱིས་བྲིས་པའི་རི་མོ་བཞིན།",
    "དེ་སློང་བྱེད་ནི་རང་ཚོར་དྲག་སྐྱེད་ཀྱི་རྐྱེན་ཞིག་ལ་བརྟེན་དགོས་པ་ཡིན་སྟབས།",
    "བརྗོད་གཞི་འདི་ལྟ་བུའི་སྙན་རྩོམ་གང་མང་ཞིག་མཐོང་མོད།",
    "མང་བོ་ཞིག་ནི་རང་གི་ངོས་ཟིན་ཞིག་ལས་ཐོན་པ་མིན་པར།",
    "བསམ་བློས་སྟོང་བའི་རང་གི་ཐད་ཚོར་གྱིས་བཏེགས་དྲགས་པས་འུད་དུ་ཕྱོགས་ཕྱིར་བདེན་པའི་མཛེས་ཉམས་ཟད་པ་ཡིན།",
    "རང་གི་ངོས་ཟིན་ལས་ཐོན་པའི་དཔལ་ཡོན་གྱི་རང་བཞིན་དང་།",
    "ཀློག་མཁན་ལ་ངོས་ཟིན་དེ་ལས་ཐོན་པའི་སྒྱུ་རྩལ་གྱི་ཤེས་རྟོགས་ཤིག་སྦྱིན་ཡོད་པ་རེད།",
    "ཕྱི་གསལ་ནང་གསལ་གྱི་ཆགས་འཇིག་ང་ཚོ་ནམ་ཡང་ཆགས་འཇིག་གི་མགྲོན་པོ་ཡིན་པ་དྲན།",
    "དེ་ལྟ་བུའི་དཔལ་ཡོན་ཁྲོད་གནས་པའི་བྱུང་འདས་ཀྱི་སྐྱེས་བུ་གང་རུང་ཞིག་གི་རྒྱལ་ཕམ་དང་གསོག་གསོབ།",
    "རྟོགས་པ་ཞིག་གི་ཟབ་ཚད་དེ་རྩོམ་མཁན་གྱི་ཚོར་ཤེས་དང་བསྟུན་ནས་རིམ་བཞིན་དུ་ཇེ་དྲགས་ལ་སོང་ཞིང་།",
    "མཛེས་པར་སྣང་བའི་ཚིག་གི་ལྡེམ་ཤུགས་དེའང་མྱོང་རོལ་གྱི་བརྐྱང་སོ་ལྟ་དང་གཟབ་ཉན།",
    "སྙན་ངག་གི་མཛེས་ཉམས་ཞེས་པ་དེ་ལྟ་བུ་ལ་ཟེར་བར་ངེས།",
    "གཅེས་ཕྲུགཨ་མའི་པང་ན་འབྱོར་ཕྱུག་གི་གཏེར་མཛོད་དང་།",
    "ངོ་མཚར་ཆོག་ཤེས་བྲལ་པའི་ལྟད་མོ་མེད་མོད།",
    "ཁྱོད་ཀྱི་ལུས་ལ་དྲོད་སྐྱིད་ཀྱི་བདེ་སྣང་སྟེར་ནུས།",
    "རང་སེམས་ཞིབ་མོས་བཅོས་པའི་ཚང་མལ་འདི།",
    "ཁྱོད་ལ་བྱིན་པའི་ཤམ་བྷ་ལའི་ཞིང་ཁམས་ཡིན།",
    "དགོས་འདོད་ཀྱི་ནོར་བུའང་མི་གནས་མོད།",
    "ད་རུང་དབྱངས་གསལ་སོ་བཞིའི་གླུ་དབྱངས་སྙན་མོ་དེ།",
    "མེས་པོས་ཁྱོད་ལ་བཞག་པའི་ཚིམ་མེད་ཀྱི་རོལ་རྩེད་ཡིན།",
    "ཨ་མའི་མཆུ་འདབ་ཡང་མོས་འདི་ལྟར།",
    "ཁྱོད་ཀྱི་ལུས་ཡོངས་མ་ལུས་འོ་ཡིས་ལྡག་པར་ཆུགས་ཤིག།",
    "༡ནམ་ཞིག་ཁྱོད་ནར་སོན་ནས་སྟག་ཤར་ཡིན་དུས།",
    "དགའ་བས་དང་དུ་ལེན་མི་སྲིད་པ་དེ་རེད་ཨང་།",
    "གཅེས་ཕྲུགགོ་ལའི་སྟེང་ཆེས་མཐོ་བའི་ལྗོངས་ནི་ཁྱོད་ཀྱི་ཕ་ཡུལ་ཡིན་ལ།",
    "འཇིག་རྟེན་དུ་ཆེས་བརྩེ་བའི་གཉེན་ནི་ཁྱོད་ཀྱི་མ་ལོ་ཡིན།་",
    "སེམས་རྟེན་ཁྱོད་ཀྱིས་མིའི་རིགས་ཀྱི་འབྱུང་འགྱུར་ལ།",
    "དུས་སྐབས་དེའི་མོར་མཚོན་ན་ཐོས་བསམ་དང་ཡང་ན་ཉམས་མྱོང་བོད་ཀྱི་སྙན་ངག་གསར་བ་བདམས་དཔྱད།",
    "སྙན་རྩོམ་མང་ཤས་ཤིག་བསམ་གཞིག་གི་མཐའ་ཟླུམ་ཐབས་བྲལ་ཕྱིར་གཉོམ་ལག་མ་རྒྱས་པའི་རང་ལྟ་ཐད་ཀར་བའི་ཤན་ཡང་ཅུང་ཆེ་བར་མངོན།",
    "བརྒྱུད་རིམ་ཞིག་གི་མྱོང་སྟོབས་ལས་འཚོ་བ་དང་བྱ་བ།",
    "མོའི་སྙན་ངག་ཀྱང་རིམ་བཞིན་རང་གཤིས་ཅན་དུ་འགྱུར་བཞིན་ཡོད་པ་མཐོང་།",
    "ལྷག་པར་དུ་དྲིན་ཆེན་མའི་མདུན་དུ་གཅེས་སློང་བའི་གཞོན་ནུ་མ་ཞིག་ནས་བུས་པ་ཞིག་གི་སྐྱིད་སྡུག་ལ་སེམས་ཁུར་བྱེད་པའི་བརྩེ་སེམས་ཀྱིས་ཁེངས་པའི་མ་རུ་གྱུར་པའི་གོ་རིམ་དེའི་ཁྲོད།",
    "མོའི་སྙན་ངག་གི་བརྗོད་གཞི་དེའང་རིམ་བཞིན་མ་བུའི་བརྩེ་དུངས་ཀྱི་ཕྱོགས་དེར་བསྐྱོད་པ་དང་།",
    "རིགས་རྒྱུད་ཅིག་མུ་ནས་མུ་རུ་བརྒྱུད་བྱེད་ཀྱི་འབྲེལ་ཐག་ཅིག་ཀྱང་ཡིན་པ་རེད།",
    "གཅེས་ཕྲུག་ཁྱོད་ལ་བྱིན་པའི་ཤམ་བྷ་ལའི་སོ་ལྟ་དང་གཟབ་ཉན།",
    "ཨ་མ་ཞིག་གིས་བུས་ཕྲུག་ལ་འཆང་བའི་ཕྱི་རྣམ་པའི་སྟེང་གི་བརྩེ་སེམས་དེའང་ངང་ཤུགས་ཀྱིས་མངོན་ཡོང་།",
    "མའི་བྱམས་སེམས་ཀྱི་འདུ་ཤེས་དེ་རྩོམ་མཁན་རང་གི་ལག་ལེན་ཞིག་གི་གནས་གཞིར་གཏད་པས།",
    "རང་གི་བུའི་སྟེང་དུ་འབྱུང་དུ་མི་འཇུག་པའི་སེམས་འདུན་དེ་ཡིད་བརྙན་དེ་ལས་བསྟན་ཡོད་པ་ལས་གཞནསྙན་ངག་དངོས་གཞིའི་བརྗོད་བྱ་དེ་གཏིང་ཇེ་ཟབ་དང་རྒྱ་ཇེ་ཆེར་གཏོང་བར་རྨང་བཏིང་ཡོད།",
    "གནས་ཡུལ་དང་སྲོལ་རྒྱུན་དེ་ལ་ང་ཚོས་གུ་དོག་པར་འདོད་པ་དང་འཁང་སེམས་རིགས་ཤིག་ཏུ་བཀྲལ་རུང་།",
    "སྙན་རྩོམ་གང་ཡིན་ཀྱང་དགོངས་པ་ཅན་དུ་གཏོགས་པས་འགལ་བ་ཆེན་པོ་མེད་མོད།",
    "ཆོག་ཤེས་ཀྱིས་ཁེངས་པའི་ང་ཚོའི་མི་རིགས་འདིར་མཚོན་ན།",
    "བུས་ཕྲུག་གི་ཕྱི་ནང་གཉིས་ཀའི་འཚོ་གནས་ལས་དེའི་འབྱུང་འགྱུར་ལ་ཡིད་ཆེས་ཀྱིས་ཁེངས་ཤིང་།",
    "གཅེས་ཕྲུག་དགའ་བས་དང་དུ་ལེན་མི་སྲིད་པ་དེ་རེད་ཨང་ཞེས་བུས་ཕྲུག་ནི་ནམ་ཡང་མོའི་སེམས་སུ་བུས་ཕྲུག་ཡིན།",
    "སྟག་ཤར་གྱི་དུས་སྐབས་མངོན་ཡང་ཨ་མའི་སེམས་སུ་བྱིས་ཆུང་སེམས་མེད་ཅིག་གི་རྣམ་འགྱུར་ལས་མེད་ལ།",
    "བདེ་སྐྱིད་སྒྲོལ་མས་འགྲོ་བ་མི་སྤྱིའི་སེམས་ཁམས་ཤིག་བཟུང་སྟེ་ཨ་མ་མཐའ་དག་གི་བྱམས་བརྩེ་གོང་བུར་བསྒྲིལ་པས།",
    "གཅེས་ཕྲུག་ཅེས་པའི་བར་འདིར་ཚན་པ་རེ་རེའི་མགོར་བརྗོད་སྟངས་འདི་བསྐྱར་ཅིང་ཟློས་ཏེ།",
    "བུས་ཕྲུག་གི་ལུས་ཁམས་ནར་སོན་གྱི་གོ་རིམ་དང་སྦྱར་ཐོག་མ་ཞིག་གིས་རང་གི་བུས་ཕྲུག་ནར་སོན་བཞིན་པའི་དུས་རིམ་རེ་རེར་བུ་ལ་འཆང་བའི་སེམས་འདུན་རེ་རེ་སློང་ཞོར་དུ།",
    "ནར་སོན་པ་ལས་བྱུང་བའི་འཇིག་རྟེན་གྱི་གོ་རྟོགས་དང་མ་ཞིག་གིས་བུར་གནང་བའི་གདམས་ངག་གམ།",
    "བརྗོད་བྱའི་ཁྱབ་རྒྱ་དང་སྙན་ངག་སྤྱིའི་རིམ་པའང་སྤྱིར་བཏང་གི་མ་བུའི་བརྩེ་སེམས་ཁེར་རྐྱང་པའི་རྒྱ་ལས་འགོངས་ཏེ།",
    "མི་རིགས་ཤིག་གི་འབྱུང་འགྱུར་ལ་ཡིད་ཆེས་དང་རེ་བས་ཁེངས་པའི་སེམས་གཤིས་དེའང་མངོན་ཡོད་པ་ཡིན།",
    "རང་གི་མར་ཡང་དྲིན་མི་གཟོ་བ་དག་གིས་གནམ་ས་འགུལ་བའི་ལག་རྗེས་ཕར་ཞོག།",
    "རང་གི་ལྟོ་ཙམ་ཡང་འོང་དཀའ་ངེས།",
    "བརྗོད་བྱར་རམ་འདེགས་དང་རང་ཉིད་སྙན་ངག་མཁན་ཞིག་གི་སྤོབས་པ་མངོན་ཆེད།",
    "ང་ཚོས་མ་བུའི་བརྩེ་སེམས་ཀྱི་མཛེས་པ་མཐོང་བ་ལས་གཞན།",
    "སྙན་ངག་མཁན་ཞིག་གི་སྤོབས་གདེང་དང་མི་རིགས་ཤིག་ལ་འཆང་བའི་བརྩེ་སེམས་དེའང་རྟོགས་ཐུབ་པ་ཡིན།",
    "དེར་བརྟེན་སྙན་རྩོམ་འདིར་མ་བུའི་བརྩེ་སེམས་ཕལ་བ་ཞིག་གི་རང་བཞིན་བརྗོད་པ་ཙམ་དུ་མ་སོང་བར།",
    "གོ་རྟོགས་གཞན་ཞིག་ནས་བསླངས་པས་ཅུང་དཔངས་ཆེ་བར་སྙམ་པའི་འདུ་ཤེས་དེའང་ཀློག་མཁན་རང་རང་གི་མྱོང་རོལ་ལས་རང་བཞིན་ཉིད་དུ་ཐོན་ཐུབ་པར་ཡིད་ཆེས་ལྡན་ནོ།",
    "ཉི་ཟླ་ཟུང་གི་ཕ་རོལ་ན་ད་དུང་གཞན་ཅི་ཞིག་ཡོདརྔམ་ཆེན་གྱིས།",
    "སེམས་པ་མེ་ལྟར་འབར་ནསརི་རབ་དང་རྒྱ་མཚོ་ཡང་བསྲེགས་སོང་།",
    "རང་ཉིད་ཀྱིས་ལམ་བུ་ཞིག་བཙལ་བའང་ད་དུང་རྙེད་མ་སོང་འཕྲུལ་སྣང་གི་གཤོག་འོག་ནས།",
    "ངའི་མི་དམངས་ཀྱི་རེ་བཅོལ་འཁུར་ནས།",
    "དཀའ་ཁག་གི་ལོ་ཟླ་ག་ཚོད་འགོར་ཡོད་ཨང་།",
    "གདོང་མཆོང་གི་རལ་གྲི་གང་སར་གཡུགས་དུས།",
    "འཛུམ་མདངས་ཤིག་གི་རྒྱབ་ཏུ།",
    "འཇིགས་རུང་གི་ལྐོག་གཡོ་ཅི་ཙམ་སྦས་ཤིང་།",
    "གོམ་སྟབས་གཅིག་གི་འོག་ཏུ།",
    "གནས་ལུགས་བཙལ་རྒྱུ་དེ་དཀའ་སོང་།",
    "གཞན་ངོ་སྲུང་རྒྱུ་དེ་ཤིན་ཏུ་དཀའ་སོང་།",
    "དག་གཙང་གི་མཛེས་སྡུག་གི་ཁེར་རྐྱང་གི་མེ་ཏོག་རྐང་གཅིག་འཐུ་ནུས་ན།",
    "འཇིག་རྟེན་གཞན་ཞིག་གི་བློས་བསླང་བྱེད་འདོད།",
    "འཇིག་ངེས་ཤ་ཁྲག་གི་ཕུང་བོ་འདི།",
    "ཐུང་ཐུང་མི་ཚེ་གཅིག་གི་དུས་ཡུན་ནང་།",
    "གངས་ཞུན་གྱིས་མིག་སྔར་བརྩམས་པའི་སྙན་རྩོམ་གང་ལ་བལྟས་ཀྱང་ཐབས་བཀོད་ཅིག་གམ་ཡང་ནི་རྣམ་པ་ཞིག་གི་ཐད་ནས་དེའི་དགེ་སྐྱོན་གྱི་དབྱེ་བ་མི་ཕྱེས་ཤིང་།",
    "ལྐོག་གྱུར་གྱི་དུས་ཚིགས་ལ་དུས་གཏན་དུ་མངའ་བ་ནི་གང་ཟག་རེ་རེའི་འདུན་མའི་ཁྲོད་འཆར་བའི་གཟུགས་མེད་ཀྱི་འབྲས་བུ་ཙམ་ཡིན།",
    "ཟང་ཟིང་གི་འཇིག་རྟེན།",
    "མྱོང་རོལ་ལ་ལྷག་དོན་སྟོང་ཁམས་ཤིག་གི་སྒོ་གླེགས་ཕྱེས་བྱུང་།",
    "སྐད་ཆའི་སྒྱུ་རྩལ་དུ་གྱུར་པ་ནི་རྩོམ་རིག་མཐའ་དག་གི་སྤྱི་གཤིས་ལགས་ན།",
    "མི་རིགས་རང་གི་རང་གཤིས་དེ་རང་སྐད་རྣལ་མའི་ཁྲོད་སྒྱུ་རྩལ་དུ་བཞེངས་བསྐྲུན་བྱེད་ཐུབ་པ་ནི་འཛམ་གླིང་རང་བཞིན་ཞེས་པའི་དན་རྟགས་ཡིན།",
    "དེང་གི་དུས་འདིར་གང་ཟག་རེ་རེས་རང་རང་ས་ནས་གཡོ་སྒྱུ་ཁྲམ་གསུམ་དུ་རང་དོན་འབའ་ཞིག་ལ་རྒྱལ་ཕམ་དང་ཐོབ་ཤོར་གྱི་བྲེལ་ཟིང་ཁྲོད་རང་མགོ་འཐོམ་དུས།",
    "འཕྲུལ་སྣང་གི་གཤོག་འོག་ནས་རང་སེམས་དྭངས་མོ་ཞིག་གམ་ཕུགས་འདུན་ཡ་མེད་ཅིག་གི་མིག་ཟུང་རྒྱལ་པོ་ལྟ་བུའི་སེམས་བསྐྱེད་ཁྲོད།",
    "སྙན་ངག་ཅིག་གི་རིན་ཐང་ནི་སྙན་ངག་རྩོམ་མཁན་ཞིག་གི་འཚོ་བའི་རོལ་སྟངས་ལས་ཀྱང་འཇལ་ནུས་པ་ཡིན།",
    "སྙན་རྩོམ་འདི་ལས་ང་ཚོས་གནས་དེ་གཉིས་ཀྱི་ལེགས་ཉེས་དང་སྙན་ངག་ཅིག་གི་རིན་ཐང་འཇལ་བྱེད་ཀྱི་རྟེན་ཞིག་རྙེད་སླ།",
    "འཇིག་རྟེན་འདོད་འདུན་ལས་ང་ཚོས་ནམ་ཡང་རང་ཉིད་ལས་མི་མཐོང་ཞིང་།",
    "ཕྱི་དངོས་ཀྱི་ཚུལ་རྣམ་ལས་ང་ཚོ་སུ་ཡིན་རུང་འཛུམ་མདངས་ཤིག་གི་རྒྱབ་ཏུའང་ལྐོག་གཡོ་དང་གདུག་རྩུབ་ག་ཙམ་སྦས་ཡོད་ཨང་།",
    "མིའི་རིགས་ཀྱི་རང་གཤིས་སྤྱི་ལས་ང་ཚོས་ཐད་ཚོར་དུའང་འཇིགས་རུང་གི་འཇིག་རྟེན་ག་ཙམ་མཐོང་ཐུབ་པ་དཔོག་དཀའ་ཡང་།",
    "གནས་སྐབས་དེ་ལྟ་བུར་བསླེབས་ན་ང་ཚོ་ནི་ཕྱི་གསལ་ནང་གསལ་ཡིན།",
    "ང་ཚོ་ལ་ཆགས་ཞེན་མེད་ལ་གཡོ་སྒྱུ་སོགས་ངན་རྒྱུ་ཅི་རིགས་ཀྱང་དགོས་མེད་ཀྱི་གད་སྙིགས་ཡིན།",
    "བར་ཆད་མཐའ་དག་ལས་བརྒལ་པས་ཁོའི་མིག་རྒྱང་དུ་འཇིག་རྟེན་རྒྱ་ཆེ་ཞིང་འགྲོ་བ་མི་སུ་ཡིན་རུང་རང་གི་བརྩེ་བ་འདྲེན་བྱའི་ཡུལ་དུ་གྱུར་པས་སྲོག་ལྡན་མཐའ་དག་ཁོའི་མི་དམངས་ཡིན།",
    "སྐད་ཆས་སེམས་འགྱུ་ཡོད་ཚད་དུས་ནམ་ཡང་ངེས་དོན་དུ་སྟོན་ཐབས་མེད་མོད།",
    "ཁེར་རྐྱང་གི་རྒྱལ་པོ་ལ་བར་ཆད་ཀྱི་དཔུང་ཚོགས་དང་ཉེན་ཁའི་བསྟར་ཕྲེང་གིས་བཀླུབས་ཤིང་།",
    "འཇིག་རྟེན་འདིའི་འོད་སྣང་གི་རྒྱབ་ཏུ་གནས་ལུགས་ཤིག་གི་བདེན་ཁ་ཙམ་ཡང་འཚོལ་བའི་སྐལ་བ་མི་ལྡན་ན།",
    "ཉེན་ཁ་ཡི་ཚེར་ཕུང་རྩུབ་ཀྱང་གནས་ལུགས་ཤིག་གི་ཟབ་ས་རུ་ཐོན་པའི་བརྩེ་དུངས་དང་།",
    "བདག་གིས་གོང་དུ་གླེང་བ་བཞིན་འཚོ་བའི་རོལ་སྟངས་ལས་ང་ཚོས་རང་འདུན་གྱི་ཕུགས་གཞི་འཇལ་ཚར་བ་ཡིན་ཞེས་པ་ལྟར།",
    "སྒྱུ་རྩལ་བདེན་སྣང་གི་ཚོར་རྟོག་ལྡན་པར་མ་ཟད།",
    "ལང་ཚོའམ་མི་ཚེ་ལ་གནས་གཞན་ཞིག་ནས་གདེང་ཐོབ་པའི་གསེད་འགྲོལ་ཡིན།",
    "ལྷ་མོ་འཚོ།",
    "གང་གི་བསྟན་པ་གསལ་མཛད་བྱམས་འཇམ་དབྱངས།",
    "འཕྲལ་ཡུན་ཐུན་མོང་མཆོག་གི་དངོས་གྲུབ་སྩོལ།",
    "ནོར་རྒྱུན་དབྱུ་གུ་མཆེད་སོགས་གཏེར་བདག་གིས།",
    "གང་གི་སྐུ་གསུང་ཐུགས་མི་ཟད་པ་རྒྱན་གྱི་འཁོར་ལོའི་གནས་ལས་བརྩམས་ཏེ་ངོ་མཚར་གྱི་གཏམ་མཐོང་ཐོས་ཀྱི་ལེགས་བྱས་ཕྲ་མོས་ཀྱང་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་གཟིགས་པའི་རྒྱུན་ཡིད་ལ་འཇུག་པར་མཛད་པ་པོ་ནི་མཚན་ཉིད་དང་ལྡན་པའི་རྡོ་རྗེ་སློབ་དཔོན་ཉིད་ཡིན་ལ།",
    "སྐྱར་མོས་མཚོ་ལས་ཉ་ལེན་བཞིན།",
    "ཡང་ན་རྒྱལ་བ་ཉིད་ཀྱང་རྡོ་རྗེ་སློབ་དཔོན་ཆེན་པོ་དག་གི་རྣམ་པར་རོལ་པ་ལས་མ་འདས་པ་ཉིད་ཡིན་ལ།",
    "རེས་འགའ་ཞི་ལ་རེས་འགའ་ཁྲོ།",
    "རེས་འགའ་བགེགས་ཆེན་དོན་མཛད་ཅིང་།",
    "རང་གི་ཚོགས་ལྡན་ཉན་པ་ང་།",
    "ཉིས་བརྒྱ་ལྔ་བཅུ་ཆར་གཏོགས་དང་བཅས་པའི་ཉེས་ལྟུང་གི་འདམ་ལས་ཡོངས་སུ་གྲོལ་བའི་སྡོམ་བརྩོན་སྦྲང་རྩིའི་རྒྱལ་མཚན་འཛིན་པ་ཀུན་གྱི་གཙོ་བོ།",
    "ཕྱི་གསོ་དཔྱད་ཀྱི་གཞུང་ལུགས་ལ་མཁས་པས་མི་འཇིགས་པ་སྲོག་གི་སྦྱིན་པ་གཏན་པ་མེད་པར་སྩོལ་ཞིང་།",
    "བཟོའི་རིག་བྱེད་ལ་སོགས་པ་ཤེས་བྱ་རིག་པའི་གནས་མཐའ་དག་གི་ཚིག་དོན་འཁྲུལ་པ་མེད་པར་ཐུགས་སུ་ཆུད་པས་རྩོད་དུས་གནས་ལྔ་མཁྱེན་པའི་པཎྜི་ཏ་ཆེན་པོ།",
    "ནམ་མཁའི་མཐའ་ཡང་གཞལ་བ་ལྟ་བུར་གྱུར་པ་གང་གི་ངོ་མཚར་བའི་རྟོགས་པའི་ཆ་ཤས་ཙམ་ཡང་བརྗོད་པར་རིགས་པ་ཉིད་ལས།",
    "རྗེ་བཙུན་འདིའི་ཕུལ་དུ་བྱུང་བའི་མཛད་པ་དག་གི་ཆ་ཤས་ཙམ་བསྙད་པས་ཀྱང་དད་པ་ཅན་དག་གི་སེམས་ཀྱི་གདུང་བ་སེལ་བར་འགྱུར་བ་མ་ཟད།",
    "ནང་གི་ཡོན་ཏན་ལེགས་བརྟགས་ཏེ།"
  ]
}