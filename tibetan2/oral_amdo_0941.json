    "ཁུར་གྱིས་ལྕི་བའི་ལོ་ཏོག་གི་གར་སྟབས་ཡིད་དུ་འོང་།",
    "ངས་ས་ནག་སྤར་མོ་གང་སྙིམ་པར་བཏེགས་ཏེ།",
    "ད་དུང་ཁྱོད་དང་སྦྲེལ་བའི་གླང་རྒན་གཞན་དག་ཚོ་ལའང་།",
    "ཁུ་བྱུག་མོན་ནས་བསླེབས་དུས།",
    "གི་རང་གཤིས་བསྟན་རྗེས།",
    "དུས་ཚིགས་དེ་ལྟ་བུའི་གནས་བབ་ཏུ་སྣང་བའི་ཞིང་གྲོང་གི་འཚོ་བའི་སྣུམ་རིས་དེའང་མཐོང་སྣེ་རྒྱང་བཀྱེད་ཀྱི་སྒྱུ་རྩལ་མཚོན་ཐབས་ཁམས་གཡེང་པ་ཞིག་གི་ཚུལ་དུ་རྩོད་མེད་དུས་ཀྱི་འཇིག་རྟེན་ལྟ་བུ་བེད་སྤྱད་དེ།",
    "སྤྱིར་ཞིང་གྲོང་གི་འཚོ་བ་ནི་དཀའ་སྡུག་གིས་ཁེངས་པ་ཞིག་ང་ཚོར་བཀྲམ་བྱུང་།",
    "ཞིག་ཡིན་མོད།",
    "གཙོ་བོ་འཚོ་བར་འཆང་བའི་བརྩེ་དུངས་དང་རེ་འདུན་ལས་མངོན་ཕྱིར།",
    "རྩོམ་མཁན་གྱིས་སེམས་འདུན་དེ་ལྟ་བུའི་མཐོང་སྣེ་ནས་ཞིང་གྲོང་གི་དཔྱིད་དུས་ཀྱི་ཕྱི་བཀོད་ཀྱི་མཛེས་སྡུག་དང་རེ་བཞག་འབུམ་ཕྲག་གིས་བརྟས་པའི་ཉམས་སྣང་ཞིག་ཀྱང་ང་ཚོར་བསྟན་འདུག་ལ།",
    "རེ་བ་མང་བོ་འགྲུབ་པར་སྟ་གོན་གྱི་དུས་སྐབས་ཡིན།",
    "འདི་ལས་ང་ཚོས་མཐོང་བ་ནི་ཞིང་གྲོང་གི་དཔྱིད་ཀྱི་ཉམས་སྣང་ལས་གཞན།",
    "རྒྱུན་ལྡན་གྱི་འཚོ་བའི་སྤྱོད་སྟངས་དང་ཐོན་སྐྱེད་བྱེད་ལུགས་དེའང་སྣུམ་ཤིག་ཤིག་གི་ཡིད་ཡུལ་ཁྲོད།",
    "བག་ཡོད་ཀྱི་སེམས་ཁམས་ཤིག་དང་རྩོད་མེད་བདེ་སྣང་གི་བར་སྟོང་ཞིག་ལས་ལྷག་པར་དུ་ཡིད་ཀྱི་དང་བ་འདྲེན་པ་ཞིག་ཏུ་བཟོས་འདུག་རབ་བཏགས་ཀྱི་དཔེ་འཇལ་དང་བྱིས་སྒྲུང་ལྟ་བུའི་རྟོག་བཟོའི་ཁྲོད།",
    "འཚོ་བར་དུངས་སེམས་འཁོལ་བའི་ན་གཞོན་དག་གི་འདོད་འདུན་དང་།",
    "རྩོམ་མཁན་རང་གི་མྱོང་སྟོབས་ལས་བྱུང་བའི་ཞིང་གྲོང་གི་འཚོ་བའི་མཛེས་ཉམས་དེ།",
    "སྐྱེངས་སླ་བའི་དགོང་ཁའི་མཚམས་སྤྲིན་དེའང་ཕྱི་འཇགས་ནང་ཟིང་གི་མཚོན་སྟངས་དེ་དག་མཐོང་བས།",
    "རང་ལ་འདྲིས་གྱིས་རང་གི་མྱོང་བ་རྐྱང་རྐྱང་བརྗོད་པའི་ལམ་དུ་མ་ཞུགས་པར།",
    "ང་ཚོ་རང་ལ་དེ་ལྟ་བུའི་བརྒྱུད་རིམ་མངའ་གནས་བབ་དེར་གནས་པའི་ན་གཞོན་ཕོ་མོ་གཉིས་ལའང་འཁྲེང་སེམས་མི་བས།",
    "སྒྱུ་རྩལ་གང་རུང་ཞིག་འཚོ་བའི་བསྐྱར་དཔར་མིན་མོདསྐྱེས་རང་སྐྱེས་སུ་གྱུར།",
    "གལ་ཏེ་རང་ལ་ཆ་རྒྱུས་ཡོད་པའི་འཚོ་བ་དེར་ཞུན་ཐར་བཅད་ནས་དཔེ་གཞི་ཅན་དེ་ནི་འཚོ་བ་དངོས་ལས་ཀྱང་བདེན་སྣང་ཐུན་མོང་མ་ཡིན་པ་སྟེར་དུ་བསྒྱུར་ན།",
    "དུ་ཞིང་གྲོང་གི་ས་སྲོད་དེ་བརྗོད་པས།",
    "མ་ཐག་ཞིང་པའི་བུ་མོ་དེས་སྔོ་དྲེག་གིས་བརྒྱན་པའི་ལག་ཆུང་གཡུག་ཏེ་ང་ཚོར་འབོད་པ་བཏང་བྱུང་།",
    "མི་ཚེ་ཞིག་ལ་མཚོན་ན་ཞིང་གྲོང་གི་འཚོ་བ་ནི་དཀའ་སྡུག་གི་འགྲུལ་བཞུད་སོ་ལྟ་དང་གཟབ་ཉན།",
    "ལྗོངས་རྒྱུ་པའི་སྐད་ཅིག་མའི་མྱོང་སྣང་ལས་ཤེས་རྟོགས་བྱེད་མི་ཐུབ་མོད།",
    "སྙན་ངག་གི་ལམ་ནས་ང་ཚོས་རྩོད་མེད་ཀྱི་ཤམ་བྷ་ལ་རུ་ཡིད་སྤྲུལ་བྱ་ཆོག་མོད།",
    "ང་ཚོས་རང་གི་ཕ་ཡུལ་ལ་ཕྱིར་ལྟ་བྱས་ཙམ་གྱིས་ཀྱང་ཐོད་གཉེར་ལ་རི་མོ་བྲིས་པའི་ཕ་མ་དང་།",
    "སྙན་ངག་པའི་སྨྱུག་རྩེ་ལས་བཀྲམ་པ་ལྟ་བུ་ཞིག་ག་ལ་ཡིན་མོད།",
    "འོན་ཀྱང་རྩོམ་མཁན་གྱིས་ཟོར་ཡངས་པའི་ཚིག་སྦྱོར་དང་རི་མོ་བཞིན་བསླངས་པའི་ཡིད་ཡུལ་ལས།",
    "སྤྱིར་སྙན་ངག་ནི་གནས་ལུགས་གང་རུང་གི་འདུལ་གྲོལ་ཞིག་ཏུ་ཡོང་ཐབས་བྲལ་མོད།",
    "ནང་ངོས་ཀྱི་སྐྱིད་སྡུག་དེའང་ལཱ་བར་སྣུམ་གྱིས་སིམ་པ་བཞིན་མི་བརྗོད་ཐབས་སྙན་རྩོམ་འདི་ལས་ཀྱང་དངོས་དོན་ཞིག་གི་སྣེ་ནས་ངལ་རྩོལ་པའི་མེད་ཡིན།",
    "ཕྱི་བཀོད་ཀྱི་མཛེས་ལྗོངས་དང་བག་ཡོད་ཀྱི་འཚོ་བས་ཟང་ཟིང་གི་གནས་ན་སེམས་ངལ་ལ་དབུགས་དབྱུང་གི་གོ་འཚོ་བའི་དེང་རབས་མི་དག་ལ་མཚོན་ན།",
    "ད་དུང་ལྟོ་རྒྱབ་ཙམ་ལ་སྙེག་པའི་ཞིང་པའི་བུ་མོའི་ལྷད་མེད་ཀྱི་སྐབས་སྟེར་མོད།",
    "མཛུབ་མོ་ཀེར་པས་རང་སེམས་ལ་སྡུག་གི་མྱུ་གུ་འབུ་མགོ་རྩོམ་སྐབས།",
    "གླང་ལྗིད་ཏིག་ཏིག་གི་གོམ་སྟབས་ཀྱིས་ཞིང་པའི་བུ་མོར་འཆང་བའི་རྒན་སེར་ཐོའི།",
    "རང་གདུང་སེམས་ལས་ཡོངས་སུ་དྲངས་ཏེ་དངོས་ཡོད་འཚོ་བར་ཞུགས་པསཞིང་གྲོང་གི་ས་སྲོད་ཀྱི་མཚར་ཉམས་ནས་སེམས་ཀྱང་ལྗིད་ཏིག་གེར་གྱུར།",
    "གཙང་པོའི་ཕར་ཚུར་དུ་དྲན་གདུང་རུམ་པའི་ན་གཞོན་ཕོ་མོ་དེ་གཉིས་ཀར་གདུང་སེམས་འཆང་བ་དང་།",
    "སྟོང་གི་རྒྱ་ལས་ཤོར་ཏེ་ཞིང་གྲོང་གང་མང་ཞིག་གི་དངོས་གཞི་ལ་བབས་བྱུང་རྩོམ་མཁན་གྱིས་རང་འདུན་གྱི་ཡིད་སྤྲུལ་དེ་ལ་ཞིང་གྲོང་གི་ཕྱི་ངོས་བརྟོལ་མི་སེམས་ལ་སྒྱུ་རྩལ་དུ་གྲུབ་པའི་ཡུལ་ལྗོངས་གསོན་ཉམས་ལྡན་དུ་བཅུག་ནས།",
    "བའི་སྣང་ཚུལ་དེའང་ཚོར་བ་སྐྱེན་པོར་རིམ་པ་བཞིན་ང་ཚོའི་སྣང་ངོར་འཆར་དུ་བཅུག་ཞིང་གྲོང་གི་རྒྱུན་ལྡན་གྱི་ཐོན་སྐྱེད་བྱེད་ལུགས་ལས།",
    "རྩོམ་མཁན་གྱིས་རང་ཚོར་དུ་བཏོན་པ་ནི་གནས་སྐབས་དེ་ཙམ་གྱི་སྡུག་ཡུས་རྐྱང་རྐྱང་ཞིག་མིན་ལ།",
    "ཞིང་གྲོང་གི་རྒྱུན་ལྡན་གྱི་བྱེད་ལུགས་སྟེ།",
