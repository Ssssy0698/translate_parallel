    "ན་མོ་མ་ཎི་བྷ་དྲ་ཡ།",
    "ཞབས་ཕྱེད་སྐྱིལ་གྱིས་གཏེར་བུམ་དང་དུང་གི་སྟེང་ན་རོལ་པ།",
    "རང་གི་ལག་པ་གཡས་པའི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་བྷྲ་ཨཾ་ཛཾ་ཁཾ་ཧཱུྃ་ལས་དེ་བཞིན་གཤེགས་པ་ལྔ་ཟླ་བ་དང་ལྷན་ཅིག་ཡེ་ཤེས་ཀྱི་བདུད་རྩིར་ཞུ་བ་མིང་མེད་ཀྱི་རྩ་བ་ནས་བྱུང་སྟེ་ཛཾ་བྷ་ལའི་དབུར་བབས་པས་ཟག་མེད་ཀྱི་བདེ་བས་ཐུགས་ཡོངས་སུ་མཉེས་ཤིང་དངོས་གྲུབ་ཐམས་ཅད་ཡིད་བཞིན་དུ་སྩོལ་ཨོཾ་ཛཾ་བར་གྱུར།",
    "སྒྲུབ་འདོད་ན་ཉི་མ་འགྱུར་ཚེ་རི་རྩེར་སོང་ལ་ས་ཡ་བཟླས་ན་རྒྱལ་སྲིད་དམ་གཏེར་ཆེན་སྩོལ།",
    "མཚན་མོ་གདོང་བསྔགས་གང་འདོད་རྨི་ལམ་སྟོན།",
    "ལག་གཉིས་ཐལ་མོ་མཉམ་པར་སྦྱར་ལ་གུང་མོ་གཉིས་ཕྱིར་བཟློག་པ་དེ་མིང་མེད་གཉིས་ཀྱི་རྩེ་མོ་གཉིས་ལ་སྦྱར་ལ།",
    "མཛུབ་མོ་གཉིས་ཚིགས་གསུམ་པ་བཅགས་ནས་དེར་བཞག་སྟེ་མཐེ་བོང་ཕྱོགས་སུ་སྦྱར།",
    "སྔགས་ནི་གོང་གི་རྩ་སྔགས་སོ།",
    "འདི་འབུམ་གཅིག་གིས་རྒྱལ་པོ་འབུམ་གཉིས་ཀྱིས་གནོད་སྦྱིན་མོ།",
    "ནོར་རྒྱུན་ལྷ་མོ་སྔོ་བསང་མཛེས་པའི་སྐུ།",
    "ལྷ་རྫས་ཡོ་བྱད་ཡིད་འཕྲོག་ལྷ་མོའི་ཚུལ།",
    "ཡབ་ཡུམ་ཕྱེད་སྐྱིལ་ཚུལ་བཞུགས་ཕན་ཚུན་གཟིགས།",
    "ལྷ་ཡི་བུ་དང་བུ་མོ་གར་བྱེད་དང་།",
    "མངྒ་ལཾ། དབྱངས་ཅན་དཀར་མོའི་སྒྲུབ་ཐབས་ནི།",
    "མདུན་དུ་མཎྜལ་ལ་དྲི་བཟང་གི་ཚོམ་བུ་ལྷ་གྲངས་ལྟར་བཀོད་པའི་མཐར་མཆོད་ཡོན་སོགས་བསྐོར་བཤམས་ཀྱི་མདུན་དུ་འབུལ་གཏོར་དང་བཅས་པ་བཤམས།",
    "ཨོཾ་ཨ་མྲྀ་ཏེ་ཧཱུྃ་ཕཊ་ཀྱིས་བསངས།",
    "དེ་ནས་གཏོར་མ་ཨོཾ་ཨཱ་ཧཱུྃ་གི་བྱིན་གྱིས་བརླབ།",
    "ལྟ་མོ་ཡིན་ན་བཅོམ་ལྡན་འདས་མས་ཞེས་བྱའོ།",
    "མེ་ཏོག་ཁྱེད་རང་གིས་བཟུང་།",
    "གསོལ་བཏབ་དུས་ཐལ་མོ་སྟོང་པ་མི་བྱ།",
    "ངེད་ཀྱི་བྱ་བ་རྣམས་སྔོན་དུ་སོང་ནས།",
    "དཔོན་གྱིས་བདག་བསྐྱེད་བཟླས་པ་དང་བཅས་པ་མདུན་གྱི་དྲིའི་མཎྜལ་གྱི་དབུས་སུ་ལྷ་བསྐྱེད་ཅིང་མཆོད་བསྟོད་བཟླས་པས་མཉེས་པར་བྱ་བ་གཏོར་མ་ཕུལ་བ་རྣམས་སྔོན་དུ་སོང་ནས།",
    "ཁྱད་པར་དུ་བཅོམ་ལྡན་འདས་ལྷ་རྒྱེ་མོའི་རྗེས་གནང་སྩལ་དུ་གསོལ་སྙམ་པའི་འདུན་པས་འདིའི་རྗེས་ཟློས་ཀྱང་གསུངས་ཤིག།",
    "བདག་ལ་བཅོམ་ལྡན་འདས་ལྷ་རྒྱེ་མོའི་རྗེས་གནང་མ་ལུས་པ་སྩལ་དུ་གསོལ།",
    "ད་སྦྱོར་བ་རྗེས་གནང་གི་གཞི་འགོད་པའི་སླད་དུ་དམིགས་པ་འདི་བཞིན་དུ་མཛད་པར་ཞུ།",
    "ཕྱི་ནང་གི་དངོས་པོ་ཐམས་ཅད་མི་དམིགས་པ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཁྱེད་རྣམས་ཀྱི་སྤྱི་གཙུག་ལ་སོགས་པ་བ་སྤུའི་བུ་ག་རྣམས་ནས་ཆར་བབ་པ་བཞིན་སིབ་སིབ་ཐིམ་པར་མོས་པ་མཛོད་ཅིག།",
    "དེས་རྗེས་གནང་གི་གཞི་འགོད་པའམ་སྐུའི་རྗེས་གནང་སོང་ནས་གསུང་གི་རྗེས་སུ་གནང་བའམ་ར་",
    "གསུམ་པས་བརྟན་པར་བྱས་པའི་མོས་པ་མཛོད།",
    "བཅོམ་ལྡན་བདག་གིས་བཟུང་ལགས་ཀྱི།",
    "གསུམ་པ་དམ་བཅའ་བའི་ལུང་གི་ཕྱིར།",
    "དེས་དངོས་གཞིའི་ལུང་གསུམ་སོང་ནས།",
    "ད་ནི་ཐུགས་ཀྱི་བྱིན་གྱིས་བརླབ་པའི་རྗེས་གནང་གི་སླད་དུ།",
    "མདུན་གྱི་ལྷ་ལ་མོས་གུས་དུང་དུང་བ་དང་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ་སྙམ་པ་མཛད་པས།",
    "ཅེས་བྱས་ལ་གནས་ལུགས་ལ་ཅུང་ཟད་རེ་མཉམ་པར་བཞག།",
    "དེས་ནི་ལྷ་རྻ་མོའི་རྗེས་གནང་ལུང་དང་བཅས་པ་ལེགས་པར་གྲུབ་པ་ཡིན་ལ།",
    "སླར་ཡང་བཀའ་དྲིན་གཏང་རག་གི་ཡོན་དུ་མཎྜལ་ཞིག་ཕུལ་བར་ཞུ།",
    "དེ་ལྟར་ལྷ་རྒྱེ་མོའི་རྗེས་སུ་གནང་བ་ལེགས་པར་གྲུབ་པ་ཡིན་པས་འདིའི་སྒོ་ནས་རང་གཞན་གྱི་དོན་རྒྱ་ཆེན་པོ་མཛད་པ་དང་།",
    "འདིར་བ་རི་བརྒྱ་རྩ་དང་སྒྲུབ་ཐབས་རྒྱ་མཚོའི་རྗེས་གནང་ལ་བར་ལྔའི་མཚམས་སྦྱོར་སོགས་ཕྲན་བུ་རེའི་ཁྱད་པར་ལས་དབྱེ་བ་ཆེར་མེད་ལ།",
    "དེ་ནི་གཞུང་སོ་སོའི་ཕྱག་ལེན་བཞིན་དུ་མཛད་པའང་ལེགས་མོད་ཀྱི།",
    "ཚིག་གི་མཚམས་སྦྱར་ཚུལ་ཙམ་ལ་གང་ལྟར་བྱས་ཀྱང་འགལ་བ་མེད་ངེས་པས་འདིར་ནི་བརྒྱ་རྒྱམ་གཉིས་སོགས་རྗེས་གནང་ཀུན་གྱི་སྤྱི་འགྲོར་རུང་བར་མཐོང་ནས་དཀྱུས་གཅིག་ཏུ་སྦྱར་བ་ཡིན་ལ།",
    "དེ་ནས་གསུང་གི་རྗེས་གནང་གི་ལུང་བཞིན་རྗེས་སུ་བཟླས་པའི་ལུང་སྟེར་བ་ཡིན་ནོ།",
    "གང་བའི་ཟླ་བ་ལས་བརྒྱུད་པའི་སྒྲུབ་ཐབས་བཅུ་དྲུག་སྐོར་གྱི་ཉེ་སྲས་བརྒྱད་པོ་ཐམས་ཅད་བཟླས་ལུང་ཁོ་ན་རེད།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་རྗེ་བཙུན་སྒྲོལ་མ་འདིར་ལྷ་སོ་སོ་གང་འདོད་ལ་ཁ་བསྒྱུར།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྩལ་དུ་གསོལ།",
    "གཙོ་མོའི་ཐུགས་ཀའི་འོད་ཟེར་གྱིས་རེག་པ་ཙམ་གྱིས་སྲིད་ཞིའི་མགྲོན་ཐམས་ཅད་རྗེ་བཙུན་སྒྲོལ་མའི་འདིར་ལྷ་གང་འདོད་དེར་ཁ་བསྒྱུར།",
    "ༀམུཾ་ཤྲཱི་ཨ་ར་ག་ཡ་སྭཱ་ཧྭ། ཧྲཱི་སྤྱན་གཟིགས་དཀར་པོ་མཆོག་སྦྱིན་པད་དཀར་བསྣམས།",
    "ཨ་ཨ་རོ་ལིཀ།",
    "ཨོཾ་ཨ་མྲྀ་ཏ་བིནྡྲ་ཛྭ་བ་མ་ཧཱ་སུ་ཁ་སྭཱ་ཧཱ། སཾ།",
    "ཨོཾ་ཨསྟ་བ་རཱ་བྷོ་གི་སྭཱ་ཧཱ།",
    "ཤེར་ཕྱིན་དཀར་མོ་མཆོག་སྦྱིན་གླེགས་བམ་བསྣམས།",
    "རྡོ་རྗེ་རྒྱལ་མོ་མཐིང་ག་རྡོ་རྗེ་བསྣམས།",
