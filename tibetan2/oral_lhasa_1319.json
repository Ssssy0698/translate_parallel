    "མྱ་ངན་ལས་འདས་པ་ལ་སོགས་པ་དེ་དག་མེད་དུ་ཟིན་ཀྱང་ཇི་ལྟར་ཡོད་ཅིང་མེད་པ་མ་ཡིན་པ་དེའོ་། ན་བཱ་ཞིན་དུ་བགུགས་བྱེད་མི་ནུས་པར་འགྱུར་ཏེ།",
    "མྱ་ངན་ལུས་འདས་པ་ལ་སོགས་པ་བགྲོགས་བྱེད་པར་མི་ནུས་པ་རྣམས་ཀྱང་བགེགས་མི་བྱེད་པའི་ངོ་བོར་གནས་པའི་ཕྱིར་བྱེད་པའི་རྒྱུ་ཡིན་པར་གྲུབ་པ་ཡིན་ནོ།",
    "རྒྱུའི་གཙོ་བོ་གང་ཡིན་པ་འདི་ནི་སྐྱེད་པར་བྱེད་པ་དེ་ཡིན་ས་བསྐྱེད་པར་བྱ་བ་ལ་ཡང་ནུས་པ་ཡོད་དེ།",
    "ཞེས་གསུངས་སོ།",
    "ཅིའི་ཕྱིར་ན་ཅི་རིགས་པར་སྨོས་ཤེ་ན།",
    "སེམས་དང་མཚུངས་པར་ལྡན་པ་ཐམས་ཅད་དང་།",
    "དེ་བཞིན་དུབར་ཆད་མེད་པའི་ལམ་གྱིས་བསྡུས་པ་ཟག་པ་མེད་པ་རྣམས་ལ་ནི་རྣམ་པར་སྨིན་པའི་འཐུས་བུ་མེད་ལ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་ལ་སོགས་པ་ཟག་པ་མེད་པ་གཞན་རྣམས་ལ་ནི་རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་དག་མེད་ལ།",
    "སེམས་ནི་ཁྱད་པར་དུ་འཕགས་པ་མཚན་ཉིད་དང་མཐུན་པའི་མཚན་ཉིད་རྣམས་ཀྱི་རྒྱལ་པོ་ལྟ་བུ་ཡིན་ལ་དེ་དག་ནི་དམན་པ་ཡིན་པས།",
    "ཡང་ན་འཇིག་ཚོགས་ལ་ལྟ་བ་སྨོས་པས་འཇིག་ཚོགས་ལ་ལྟ་བ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་ཀྱང་དོན་གྱིས་སུམ་སྐབས་ཀྱི་ཚུལ་གྱིས་ན་དེ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་ཀྱི་ཞེས་བྱ་བ་དེ་ལྟར་གོ་བར་བྱའོ་ཞེས་ཟེར་རོ།",
    "རྒྱུར་བྱས་པའི་གཟུགས་ཐོགས་པ་དང་བཅས་པ་ཕན་ཚུན་དང་།",
    "རྒྱུར་བྱས་པའི་གཟུགས་ཐོགས་པ་དང་བཅས་པ་ཕན་ཚུན་དྲུང་ཞེས་བྱ་བ་ནི་རྡུལ་ཕྲ་རབ་རྫུས་བརྒྱད་ལ་སོགས་པ་ཡིན་ནོ།",
    "ཐོགས་པ་མེད་པ་ཅུང་ཟད་དང་ཞེས་བྱ་བ་ནི་ཐོགས་པ་མེད་པ་རྣམ་པར་རིགབྱེད་མ་ཡིན་སོ་སོར་ཐམ་པ་ཡོངས་སུ་གཅོད་ཅིང་བསམ་གཏན་དང་ཟག་པ་མེད་པའི་སྡོམ་པ་རྣམ་པར་བཅད་པ་ཡིན་ཏེ།",
    "མི་གསལ་བ་ནི་གསལཾ་ཞེ་བའི་བའི་འབྲས་བུ་ཡིན་པར་མི་རུང་ངོ།",
    "རྒྱུ་ནི་མ་ཡིན་ནོ་ཞེས་སྟོན་པར་བྱེ།",
    "རྭ་ལ་ཡའདམ་བྱའི་སྲ་བྱོན་ཡོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་གང་དག་གཟུགས་ཀྱི་སྐལ་བ་མཉམ་པའི་རྒྱུ་གཟུགས་ཡིན་པར་མི་འདོད་པ་དེ་དག་ལ་ནི།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དང་སམས་དང་སམས་ལས་བྱུང་བ་མ་ཡིན་པའི་ཕྱིར་ནོ་མཚུངས་པར་ལྡན་པའི་རྒྱ་ཡང་མ་ཡིན་ནོ།",
    "ལུང་དུ་མ་བསྟན་པ་ཡིན་པའི་ཕྱིར་ན་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡང་མ་ཡིན་ནོ།",
    "ཡང་ཀྱང་སྐྱེ་བ་ཡོད་པར་མི་འགྱུར་རོ།",
    "ཞུས་གསུངས།",
    "འདས་པ་དང་ད་ལྟར་བྱུང་བ་རྣམས་ནི་མ་འོངས་པ་རྣམས་ཀྱི་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "ནམ་ཡང་རྒྱ་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་དེ་ནི་ཉེས་པ་མེད་དེ།",
    "འདི་ལྟར་བསྟན་བཅོས་ལས་ནི་ནམ་ཡང་རྒྱ་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེས་སྤྱིར་གསུངས་པས་གནས་སྐབས་ཐམས་ཅད་ཟླངོས་པོར་སྒྲུབ་པར་བྱེཁྱེད་ཀྱི་སྨྲ་བ་ལས་ནི་མ་འོངས་པའི་གནས་སྐབས་མང་པོ་ཞིག་ཡོད་པ་ལས་ཐ་མའི་གནས་སྐབས་གཅིག་ཉིད་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཉིད་དུ་ངེས་ལ།",
    "གནས་སྐབས་འདི་དག་ལ་ཡང་སྐལ་བ་མཉམ་པའི་རྒྱུམ་ཡིནནོ་ཞེས་བརྗོད་། པར་ནུས་པས་གླགས་དང་བཅས་པ་ཉིད་དུ་མཐོང་བས་དེ་ནི་དེའི་ལན་དུ་མི་རུང་ངོ།",
    "གཞན་ཡང་དར་ཇི་ལྟ་བ་དེ་བཞིན་འདིར་ཡང་བརྗོད་པར་བྱ་ལ།",
    "འདིར་ཇི་ལྟ་བ་དེ་བཞིན་དེར་ཡང་བརྗོད་པར་བྱའོ་ཞེས་གཉིས་སུ་བསྟན་པར་བྱ་བའི་བུར་དུ་གསུངས་པ་ཡིན་ཏེ།",
    "ནམ་ཡང་མ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་ལ།",
    "དགོངས་པའི་། དོན་གཅིག་ཏུ་མ་ངེས་པ་ཉིད་ཡིན་པར་འགྱུར་ན་ནི་དེ་ལྟར་སྒོ་གཉིས་སུ་བསྟན་པ་ལ་ཡོན་ཏན་ཅི་ཡང་འཐོབ་པར་མི་འགྱུར་རོ།",
    "གླགས་དང་བཅཔ་དང་གླག་ས་མེད་པ་ད་དག་དེར་ཇི་ལྟ་བ་དེ་བཞིན་འདིར་ཡང་བརྗོད་པར་བྱལ་འདིར་ཇི་ལྟ་བ་དེ་བཞིན་དེར་ཡང་བརྗོད་པར་བྱའོ་ཞེས་སྒོ་གཉིས་སུ་བསྟན་པར་བྱ་བའི་བར་དུ་བསྟན་པ་ཉི་ཀྱི་ཕྱིར་རོ།",
    "ཐ་མའྀ་གནས་སྐབས་ན་སྐུལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་བ་དང་བཅས་པ་ཉིད་ཀྱི་ཕྱི།",
    "ནས་སྐབས་ན་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ཉིད་དུ་ངེས་པར་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་དང་མཚུངས་ལ་གྱི་བདེན་པ་མ་གཏོགས་པ་ཞེས་མུ་གསུམ་པའི་དོན་དུ་བྱ་བའི་ཕྱིར་མ་གཏོགས་པར་འཇོག་པར་འགྱུར།",
    "ལུང་དུ་མུ་བསྟན་པ་ཉིད་ཡིན་པའི་ཕྱིར་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡང་མ་ཡིན་ནོ།",
    "དེའི་ཕྱི་རྒྱུ་ཞིག་ཡིན་དུ་འགྱུར་ན་ཤུགས་ཀྱིས་སྐལ་བ་མཉམ་པའི་རྒྱུའམ་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་དེ་ཉིད་ཡིན་པར་འགྱུར་ཏེ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་དང་མཚུངས་པར་ལྡན་པ་འོ་ན་མ་གཏོགས་པོར་བྱ་བ་ཡིན་གྱི་འཇིག་ཆོ་གོས་ལ་ལྟ་བཞྤྱིད་ནི་མ་ཡིན་ཏེ།",
    "འདིར་རྒྱུ་ནི་མཚུངས་པར་ལྡན་པའྲི་རྒྱུ་དང་ལྷན་ཅིག་བའི་རྒྱུ་ལ་དགོངས་པ་ཡིན་གྱི་སྐལ་བ་མཉམ་པའི་རྒྱུ་དང་ཀུན་ཏུ་འགྲོ་བོའི་རྒྱུ་ནི་མ་ཡིན་ཏེ།",
    "རྒྱུ་དེ་དག་ནི་མ་འོངས་པའི་གནས་སྐབས་སུ་རྣམ་པར་བཞུག་པ་འཕགས་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡང་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་ལ་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ཡོད་པ་ཡང་མཔའི་ཡིན་ནོ།",
    "བྱེ་བྲག་མད་པར་འཇུག་པའི་ཕྱིར་བྱེད་རྒྱུ་ཡང་མ་ཡིན་ནོ།",
    "གྲགལ་ཏེ་རྣམ་པར་སྨིན་པའི་རྒྱུ་བཞིན་དུ་སྐེལ་བ་མཉམ་པའི་རྒྱུ་ཡང་མ་འོངས་པ་ཡིན་ན་སྐྱོན་ཅིར་འགྱུར་ཞེ་ན།",
    "གལ་ཏེ་རྣམ་པར་སྨིན་པའི་རྒྱ་དུ་མ་འོངས་པ་ཡིན་པར་འགྱུར་ན་ནི་བསྟན་བཅོས་ལས་ད་སྨོས་པར་འ་",
    "དེའི་ཕྱིར་སྐལ་བ་མཉམ་པའི་རྒྱུམ་འོངས་པ་ཡོད་པར་རྟོག་ན་བསྟན་ཅས་དང་འགལ་བར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "འབྱིན་པ་དང་འཛིན་པར་བྱེད་མི་ནུས་པའི་ཕྱིར་མ་སྨོས་པ་དེ་ནི་མ་ཡིན་ཏེ།",
    "སྔ་མ་དང་ཕྱི་མའི་དངོས་པོ་མེད་ན་ནིའདྲ་ངས་པ་ཡིན་པར་ཡང་ཇི་ལྟར་རུང་།",
    "དེ་ལྟ་ཅུ་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡང་མ་འོངས་པ་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "རྒྱུ་བཱས་འབྲས་བུ་སྔ་བ་མི་རུང་བས་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་སྔ་བ་མི་རུང་བའི་ཕྱིར་དང་།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུའི་མཚན་ཉིད་ཀྱང་གཞན་ཏེ།",
    "དེ་ལྟ་བས་ན་སྐལ་བ་མཉམ་པའི་རྒྱུ་ནི་སྔ་མ་དང་ཕྱི་མའི་རིམ་པས་རྒྱུ་དང་འབྲས་བུ་ངེས་པ་ཡིན་པའི་ཕྱིར་འདས་པ་དང་ད་ལྟར་བའི་གནས་སྐབས་ཁོ་ན་ཡི་ན་གྱི་མ་འོངས་པའི་གནས་སྐབས་ནི་མ་ཡིན་ནོ་ཞེས་གནས་སྐབས་ལས་རྣམ་པར་གནས་པ་འོ་ནེ་ཡིན་ལ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུནི་མཚན་ཉིད་ལས་རྣམ་པར་གནས་པ་ཡིན་ལ་མཚན་ཉིད་ཀྱང་དུས་གསུམ་དུ་འཁྲུལ་པ་མེད་པས་མ་འོངས་པ་ཡང་མི་བཟློག་གོ་ཞེས་ཟེར་རོ།",
    "དེ་ཁོ་ན་ལྟར་ངེས་པར་བཟུང་བ་ཞིག་ཡིན་ནམ་འོན་ཏེ་དེ་ལྟ་མ་ཡིན་པ་ཡང་ཡོད་ཅེན།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་དང་།",
    "སྲེད་པས་བདག་གྱིར་བྱས་པས་ཡོངས་སུ་བཅད་པས་འདོད་པ་དང་གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་དྲང་ས་རྣམས་ཡོངས་སུ་གཅོད་པ་ཡིན་ལ།",
    "དུས་ཀྱི་རྣམ་པར་གྲོལ་བ་དང་།",
    "ས་ཀྱི་རྣམ་པར་གྲོལ་བའི་ལམ་ནི་དུས་ཀྱི་རྣམ་པར་གྲོལ་བའི་ལམ་གཞན་དང་།",
    "དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བའི་ལམ་རྣམས་ཀྱི་ཡིན་པས་གསུམ་གྱི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "དུས་དང་མི་བར་རྣམ་པར་གྲོལ་བའི་ལམ་གྱི་ཡིན་པས་གཉིས་ཀྱི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "མི་སློབ་པའི་ལམ་ལ་ནི་དེ་དག་གཉིས་དུས་ཀྱི་རྣམ་པར་གྲོལ་བ་དང་།",
    "དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བ་དག་ཡིན་ནོ།",
    "འདི་ལྟར་མཐོང་བའི་ལམ་དབ༵ང་པོའི་སྒོ་ནེས་ས་གོང་མ་པ་ས་ག་མ་པའི་ལམ་དང་མཉམ་པའམ་ཁྱད་པར་ཅན་ཡིན་པ་ནི།",
    "ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཀྱིས་པའི་དུས་ཀྱི་རྣམ་པལ་བའི་ལམ་ས་འོག་མ་པའི་དུས་ཀྱི་རྣམ་པར་གྲོལ་བའི་ལམ་དང་མཉམ་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་པས་ས་འོག་མ་པའི་དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བའི་ལམ་ཁྱད་པར་ཅན་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་སུ་གོང་མ་པའི་མཐོང་བའི་ལམ་དང་ས་གྲ་མ་པའི་མཐོང་བའི་ལམ་དུ་སྐད་ཅིག་མ་མཐུན་པ་རྣམས་ནི་རྒྱུས་རྒྱས་པར་བྱས་པའི་སྒོ་ནས་མཉམ་པ་ཡིན་ཏེ།",
    "བསམ་གཏན་བཞི་པའི་ས་པའི་དད་པས་རྗེས་སུ་འབྲང་བའི་ལམ་ེཔས་ས་འོག་མ་པའི་མཐོང་བས་ཐོབ་པ་དིང་དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བའི་ལམ་དག་ལྟ་བུ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མཐོང་བའི་ལམ་མ་གཏོགས་པ་ལམ་གཞན་རྣམས་ནི་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པ་གོང་ནས་གོང་དུ་རྒྱུས་རྒྱས་པར་བྱས་པའི་སྒོ་ནས་ཁྱད་པར་ཅན་ཡིན་ཏེ།",
    "འབད་པ་འབྲས་བུ་མེད་པར་འགྱུད་ཕྱིར་རོ།",
    "ངུའི་འབྲིང་པོ་ལ་སོགས་པ་གཞན་བརྒྱད་ཀྱི་ཡང་ཡིན་པསཀྱང་རྣམ་པ་དགུ་ཐ་དད་པའི་ཕྱིར་ཆུང་ངུའི་ཆུང་ངུ་དག་ནི་མཉམ་པ་ཆུང་ངུའི་ཆུང་ངུ་གཞན་དག་དང་ཁྱད་པར་ཅའི་ཆུང་ངུ་ནི་དམན་པའི་ཕྱིར་དོར་བ་ཡིན་ནོ།",
    "བརྩལ་བ་ལས་བྱུང་བ་མ་ཡིན་པའི་ཕྱིར་རྣམ་པ་དགུ་པོ་ཐམས་ཅད་ཕན་ཚུན་དུ་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་པས་མཉམ་པ་དང་ཁྱད་པར་ཅན་ཉིད་ལ་ལྟོས་པ་ནི་མེད་དོ།",
    "མ་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པ་རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་དང་།",
    "གཅིག་དག་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡི་ན་ཏེརྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་ནི་རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་ལ་སོགས་པ་བཞིའི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "ཞེས་གསུངས།",
    "མཚུངས་པར་ལྡན་པའི་རྒྱུ་ནི་གོང་ཞེ་ན།",
    "གང་དག་ལ་རྟེན་མཚུངས་པ་ཡོད་པའི་སམས་དང་སམས་ལས་བྱུང་བ་དེ་དག་ནི་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན།",
    "མཚུངས་པ་ཞེས་བྱ་བ་ནི་འདིར་ཐ་མི་དད་པ་ལ་བརྗོད་པར་འདོའདོད་ནས་སྦྱར་བ་ཡིན་ཏེ།",
