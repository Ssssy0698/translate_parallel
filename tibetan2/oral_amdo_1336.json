    "གལ་ཏེ་སྔར་གྱི་བདག་གི་དངོས་པོ་བསལ་ནས་དེ་ལས་གཞན།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ས་བོན་མྱུ་གུ་འདིར་གཞན་མ་ཡིན་ན།",
    "ཐམས་ཅད་ལས་ཀྱང་ཐམས་ཅད་སྐྱེ་བར་འགྱུར་ཏེ་གང་གི་ཕྱིར།",
    "ཇི་ལྟར་སྲང་གི་མདའ་གཉིས་མཐོ་བ་དང་ནི་དམའ་བ་དག།",
    "བསྐྱེད་པར་བྱ་དང་སྐྱེད་བྱེད་དག་གི་སྐྱེ་འགག་འགྱུར་ཞེ་ན།",
    "གལ་ཏེ་མིག་གི་བློ་ལ་རང་གི་སྐྱེད་བྱེད་དུས་གཅིག་པ།",
    "བདག་གིས་བུ་འདི་སྐྱེད་ཅེས་སྨྲ་བྱེད་ཅིང་།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་བརྟེན་འགྱུར་ན།",
    "དེ་ཉིད་སྐབས་སུ་རིགས་པ་གང་ཞིག་གིས།",
    "ཁྱོད་ཀྱི་སྐྱེ་བ་གང་གིས་ཡིན་པར་འགྱུར།",
    "མཐོང་གི་དངོས་གཞན་རྣམ་པར་མ་ཡིན་ལྟར།",
    "དེ་བཞིན་དངོས་རྣམས་རང་བཞིན་མེད་མོད་ཀྱི།",
    "ཡོད་མིན་དེ་ཚེ་ཁྱོད་ཀྱི་དཔེ་ཡོད་མིན།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་ངས་མཐོང་སྙམ་དྲན་པ།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་ཕྱི་ཡུལ་རྨི་ལམ་དུ།",
    "མིག་དང་མིག་གི་ཡུལ་དང་དེས་སྐྱེད་སེམས།",
    "མོ་གཤམ་བུ་ལའང་དེ་ནི་ཡོད་པར་ཐལ།",
    "ཕྱི་གཟུང་མེད་པར་རང་གི་ས་བོན་ལས།",
    "གལ་ཏེ་ཁྱོད་ལྟར་རྨི་ལམ་དྲུག་པ་ཡི།",
    "འདི་ཡི་ཡོད་པ་གང་གིས་ཤེས་པར་འགྱུར།",
    "རང་རིག་པ་ནི་གྲུབ་ལ་རག་མོད་ཀྱི།",
    "གང་ཕྱིར་གང་གིས་ཡུལ་མྱོང་གྱུར་དེ་ལས།",
    "གང་གིས་ན་འདི་ཡོད་པ་མི་རིགས་པ།",
    "ཁྱོད་ལ་མོ་གཤམ་བུས་གནོད་ཅི་ཞིག་བསྐྱལ།",
    "དེ་གཉིས་རྣམ་དབྱེ་གང་གིས་མི་ཤེས་པ།",
    "ཀུན་རྫོབ་ཀྱང་ནི་བདག་གིས་ཁས་མ་བླངས།",
    "གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་མི་གནོད་ན།",
    "ཁྱོད་དང་འཇིག་རྟེན་འདིར་ནི་རྩོད་གྱིས་དང་།",
    "ཕྱི་ནས་སྟོབས་ལྡན་བདག་གིས་བསྟེན་པར་བྱ།",
    "ཇི་ལྟར་རང་གི་བསྟན་བཅོས་དེ་དེ་ལས།",
    "སྨྲས་པ་དེ་དག་བྱེད་པོར་མ་གཟིགས་ནས།",
    "གལ་ཏེ་གཟུགས་ཡོད་མོད་ཀྱི་དེ་ལ་ནི།",
    "བཟློག་གི་གཟུགས་ནི་བཀག་པ་མ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱི་རྫས་ནི་བཀག་པས་འགྲུབ་མི་འགྱུར།",
    "གཉིས་ལས་སྐྱེ་བའང་རིགས་པའི་ངོ་བོ་མ་ཡིན་གང་གི་ཕྱིར།",
    "གང་ཕྱིར་རེ་རེ་ལས་ནི་སྐྱེ་བ་འགྲུབ་པ་ཡོད་མ་ཡིན།",
    "བརྒྱ་ཕྲག་དག་གི་སྒོ་ནས་སྡུད་པར་བྱེད་པར་ཡང་མི་ཀུན་བཟང་ཐེག་མཆོག་ཡེ་རྗེ་གསུང་འབུམ།",
    "རང་གི་བློ་བཞིན་འཇིག་རྟེན་རྒྱུ་ལས་ཡིན་པར་ཤེས་པར་གྱིས།",
    "གང་གི་ཕྱིར་ན་གོང་དུ་རང་གཞན་ལས་དང་གཉིས་ཀ་ལས།",
    "གང་གི་ཕྱིར་ན་བདག་དང་གཞན་དང་གཉིས་ཀ་ལས་སྐྱེ་དང་།",
    "ཐ་སྙད་དུ་ཡང་མོ་གཤམ་བུ་ཇི་བཞིན།",
    "ཁྱོད་ལ་ཇི་ལྟར་དེར་འགྱུར་དེ་མི་རིགས།",
    "མོ་གཤམ་བུ་ལྟར་གང་ཕྱིར་འཇིག་རྟེན་གྱི།",
    "མོ་གཤམ་བུ་ལ་རང་གི་བདག་ཉིད་ཀྱིས།",
    "མོ་གཤམ་བུ་དང་མཚུངས་པར་ཐལ་མི་འགྱུར།",
    "བུད་ཤིང་མེད་པར་མེ་ཡོད་མིན་དེ་བཞིན།",
    "རང་གི་ལྟ་ལ་ཆགས་དང་དེ་བཞིན་དུ།",
    "ཉོན་མོངས་སྐྱོན་རྣམས་མ་ལུས་འཇིག་ཚོགས་ལ།",
    "མོ་གཤམ་བུ་ལྟར་སྐྱེ་བ་དང་བྲལ་ཕྱིར།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ལ།",
    "ཁྱོད་ཀྱི་སེམས་སམ་ཕུང་པོ་བདག་མི་འགྱུར།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ཡིས།",
    "ཁྱོད་ལ་དེ་དག་ཉིད་བདག་ཅེས་འགྱུར་གྱི།",
    "ཁམས་དྲུག་དང་ནི་མིག་སོགས་རེག་པ་ཡི།",
    "རྩེ་མོ་མཐོ་བར་གྱུར་པ་འདི་དག་གོ།",
    "གང་ཕྱིར་ཁྱོད་བུམ་དངོས་པོར་མ་གྲུབ་པའི།",
    "རང་གིས་ཡོད་པར་གྲུབ་པར་རྟོགས་མི་བྱ།",
    "ཁྱོད་དབྱིབས་ཡན་ལག་རེ་རེ་སྔར་ཡོད་གྱུར།",
    "གང་ཕྱིར་ཁྱོད་ཀྱི་ཚོགས་པ་ཅང་མེད་པས།",
    "ཁྱོད་ཀྱི་འདི་ནི་ཇི་ལྟར་འདོད་དེ་ལྟར།",
    "རྣམ་པ་བདུན་གྱིས་འགྲུབ་འགྱུར་མིན་མོད་ཀྱི།",
    "རང་གི་ཡན་ལག་བརྟེན་ནས་འདོགས་པ་ཡིན།"
  ]
}