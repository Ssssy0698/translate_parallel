    "ཨེ་ཀ་ཛ་ཏི་སོགས་སྨུག་མོའི་ཚོགས་དང་།",
    "རེ་མ་ཏི་སོགས་ནག་མོའི་ཚོགས་ནག་སྨུག་གནོད།",
    "བྱང་ཤར་ས་བདག་རིག་འཛིན་ཕྱོགས་སྐྱོང་བཅུ་ཡི་ནང་གི་རིག་འཛིན་རྒྱལ་བོ་བཅོས་པར་བྱ།",
    "༥༧༡༥པདྨ་འདྲ་ན་མ་ལྷ་གནོད་འདི་ཡན་ལྷ་ངོ་སྟེ་ལྷ་སྲུང་གི་བཀའ་ཆད་སོགས་བརྟག་༥༧༡༧ཤ་རུ་འདྲ་ན་ཡམ་ཤུད་དེ་བཙན་གནོད།",
    "༥༧༡༨ ཏམ་བུ་ར་པི་ཝང་འདྲ་ན་བདུད་མོ་གནོད།",
    "བསྐོར་ཕྲུ་བཏབ་པ་སྟེ་ནས་འབྲུ་དགུའི་མོ་འདེབས་ཚུལ།",
    "ཕྱུ་ཞེས་མོ་འདེབས་པའི་དོན།",
    "རྗེས་འཇུག་གི་དོགས་པ་བཅད་པའི་དོན་དུ་ཞུས།",
    "༥༧༣༥གནས་ཀྱི་བཅོ་བརྒྱད་ནི་མི་ཐོད་རྙིང་བ་མི་ཡི་དུར་ཐོད་ཐལ་པས་རྣག་ཆུ་སྐེམ་འབྲུག་རུས་ཏིག་ཏ་གསུམ།",
    "༥༧༣༩ནག་མཚུར་སེང་ཕྲོམ་སྟེ་ཞུ་མཁན་ཨ་རུའི་གྲང་ཐང་གིས།",
    "༥༧༣༡༥ ཤིང་གསུམ་ཐང་གིས་མཆེར་ཚད་སྦོ་འཁྲོག་སེར་བར་བྱེད།",
    "མོ་རིགས་བིལ་བར་གྲགས་པ་དང་འབྲས་དཀར་བཏབ་པས་ཀ་པེད་དྲུག་ཐང་གིས་ཚད་འཁྲུ་གཅོད།",
    "གཟེ་མ་ར་མགོ་ལྕམ་པ་ཉི་དགའ་སྡིག་སྲིན་གཟེ་མ་སུམ་ཐང་གིས་ཆུ་འགགས་སེལ།",
    "སྒ་སྐྱ་ཚྭ་འདེབས་ཙམ་གིས་རིམས་ཚད་སྨིན་པར་བྱེད།",
    "༥༧༤ ༦ཨ་རུ་བཞི་ཐང་ཨ་རུ་ལྡུམ་བུ་རེ་རལ་བོང་ང་དཀར་བོའི་བསྡུས་ཁུ་ལ།",
    "༥༧༤ ༡༢ གུར་ཀུམ་དོམ་མཁྲིས་ཚོས་རྒྱ་སྐྱེགས་ཐང་གིས་ཁྲག་སྐྱུགས་གཅོད།",
    "ཤིང་མངར་བཞི་ཐང་གིས་རྩ་ཡི་ཚད་པ་སེལ་བར་བྱེད།",
    "མོན་ལུག་གླ་སྒང་ག་དུར་སྲོ་ལོ་དཀར་བོ་ཡི།",
    "ཁ་རུ་ཚ་དྲུག་ཐང་གིས་ཁ་ཟས་མི་འཇུ་སྐྱུག་པ་སེལ།",
    "སྲང་གཉིས་ཁྱོར་གང་།",
    "༥༧༦༢ཐལ་ཚ་རིགས་གཉིས་གང་རུང་ཡ་བཀྟ་ཐང་སྦོས་པ་སེལ།",
    "སོག་ཡུའི་ལུག་ཐུང་ངམ་གཡག་རྒོད་ཀྱི་སོག་པའི་ཐང་གིས་ཤ་མ་ཞུ་བ་འཇུ།",
    "མ་ཞུ་ཚབས་ཆེ་ན་བསྲེགས་ཐལ་གཏོང་དགོས་སོ།",
    "མང་ནི་ཤིང་ཚིང་གིང་ལས་བྱུང་བ་སེར་ལ་སྣ་རིང་མཉེན་ལ་ཡང་བའམ།",
    "ཤིང་ཀཉྫ་ཞེས་པའི་ཐང་ཆུ་སྟག་ཟིལ་མདངས་སེར་སུལ་མང་ཕོ་ཅོང་ནུས་པ་གོང་སོང་འདྲ།",
    "ཤིན་ཏུ་བསིལ་བས་རྒྱས་ཚད་རྐྱང་བ་འཇོམས་ཤིང་ཕལ་ཆེར་རྒྱ་གར་ནས་འབུད།",
    "རྩོ་རི་ཞེས་པ་མི་རྒོད་གཅིག་གིས་གྲོགས་ལ་མ་ལྟོས་པར་སྲོག་ཆགས་མང་བོ་འཇོམས་པ་ལྟར་ག་བུར་དེ་འདྲ་ཡང་ཅུ་གང་བློན་དགོས་པ་ནི།",
    "རྒྱལ་བོ་ལྟ་བུའི་སྦྱོར་བ་བཅུ་གསུམ་སོང་།",
    "ཁ་ཆེ་གུར་ཀུམ་ཅུ་གང་གི་ཝཾ་མི་འགྱུར་གཙོ་བོ་ལ།",
    "དེ་སྟེང་ག་བུར་བསྣན་པས་ག་བུར་དགུ་བས་ཟུངས་བཟང་གི་ཚ་བ་ཚབས་ཆེན་སེལ།",
    "རྗེ་རིགས་ས་རེག་རྗེ་འུ་འོ།",
    "གནས་རིགས་ཐུན་མོང་བ་ཉི་ཤུའོ།",
    "༥༨༧ མོན་ལུག་གླ་སྒང་བོང་ང་དཀར་བོ་བ་ལེ་ཀ་རེ་སྐོན་ཀ་ར་སྦྱར་བས་མཁྲིས་ཕྱེ་བདུན་པ་རྒྱུ་ལྷག་ལ་གལ་ཆེ།",
    "༥༨༩ཅོང་ཞི་མཛོ་མོའི་འོ་མར་འདམ་བཏགས་གྲིབ་སྐམ་བྱ།",
    "མིའི་སོག་ཐལ།",
    "དྲི་ཆེན་ཚབ་ཏུ་སྒོག་བསྲེག་ཐལ་བ།",
    "༥༨ ༡༢ཁ་ཚེགུར་ཀུམ་ལི་ཤི་གི་ཝཾ་བསེ་རུ་མཚལ།",
    "དེ་སྟེང་ཙན་དན་དཀར་བོ་དང་གི་ཝཾ་གཉིས་བསྣན་པས་ཅུ་གང་བདེ་བྱེད་ཆེན་པོ་ཟེར་བས་ཚ་བ་གབ་རྙིང་སེལ།",
    "འཕྱི་ཐོད་ཐལ་བ།",
    "འོལ་མོ་སེ་བསྣན་པས་ཟུག་གཅོག་༥༨༢༢སུག་སྨེལ་ཀ་རས་ཙན་དན་བཅོ་བརྒྱད་བུད་མེད་ལ་རིམས་བཏབ་དང་།",
    "༥༨༢༤ཤུ་མོ་ཟ་གོར་རྩི་དང་ཀ་ར་བཞི་འགྱུར་སྦྱར།",
    "མོན་ལུག་གླ་སྒང་ཤིང་ཚ་སེ་འབྲུ་ཀ་ར་སྦྱར།",
    "སྤང་རྒྱན་དཀར་བོའི་ཕྱེ་མས་ལྷོག་པ་འཇོམས་དམངས་ལྟ་བུ་སོ་གཅིག་སྟེ་ཚ་སེལ་དགུ་ཅུ་གོ་དྲུག་པོ་སོང་།",
    "༥༨ ༣༣ སེ་འབྲུ་ཞོ་བརྒྱད་ཤིང་ཚ་སུག་སྨེལ་ཞོ་རེ་རེ་པི་པི་ལིང་ཞོ་གཉིས།",
    "ཤིང་མངར་ཅུ་གང་རྒུན་འབྲུམ་ཟི་ར་དཀར་ཞོ་རེ་རེ།",
    "༥༨ ༣༡༢ ཛཱ་ཏི་ཤིང་ཀུན་ཁ་རུ་ཚ་རྣམས་ཞོ་རེ་དང་། ཕྱི་མའི་རྒྱུད་ཀྱི་མཆན་འགྲེལ།",
    "༥༨ ༣༡༥ ཤིང་ཀུན་གླ་རྩི་ཐང་ཕྲོམ་དཀར་བོ་བྱི་ཏང་ག་རྣམས་ཞོ་རེ།",
    "༥༨ ༣༡༦ད་ཏྲིག་ཀ་པེད་ཐ་རམས་མོན་ཆ་ར་རྣམས་ཞོ་རེ།",
    "༥༨ ༣༡༧ཤུ་དག་ནག་པོ་འུ་སུ་དབྱི་མོང་དཀར་བོ་ཙིཏྲ་ཀ་རྒྱ་ཚ་ཡ་བཀྟ་ར་ཁ་རུ་ཚ་རྣམས་ཞོ་རེ།",
    "ད་ཏྲིག་ཤིང་ཀུན་དབྱི་མོང་ཁ་རུ་ཚ་རྣམས་ཞོ་རེ།",
    "འུ་སུ་མ་ནུ་པུཀྐར་བསེ་ཡབ་སླེ་ཏྲེས་བཞི་རྣམས་ཞོ་རེ།",
    "༥༨༤ ༦ཤིང་ཚ་བཟང་བོ་གསུམ་ཛཱ་སུག་ཀ་དང་ལ་ལ་ཕུད་རྣམས་ཞོ་རེ།",
    "༥༨༤༨གོང་སྟེང་ཟི་ར་ནག་པོ་དབྱི་མོང་ཙི་ཏྲ་ཀ་ལ་ལ་ཕུད་དང་སུག་སྨེལ་ཁ་རུ་ཚ་རྣམས་ཞོ་རེ།",
    "༥༨༥༨ རྒྱ་ཚ་ཝ་ཚ་དབྱི་མོང་དཀར་བོ་ཙི་ཏྲ་ཀ་ལ་སོགས་པའི་ད་ལིས་སྦྱོར་བ་བཅུ་བཞི་བོ་སོང་།",
    "ཀ་རཉྫ་དྲུག་པ་བཏང་བས་ཐུན་གཅིག་གིས་ཕན་པས།",
    "རྟ་གདོང་གི་མེ་ཟེར་བ་ཡིན།",
    "དེ་ལྟར་གོང་གི་ཀ་རཉྫ་དྲུག་པོ་དེ་གཞིར་བཞག་པ་དེའི་སྟེང་ལ་ཁ་བསྒྱུར་བའི་ཚུལ།",
    "༥༨༦༡ཤིང་ཀུན་ཤུ་དག་ནག་པོ་སེ་འབྲུ་ཚ་བ་སྒ་པི་ཕོ་དབྱི་མོང་ཙིཏཱ་ཀ་ལྔ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེས་ཤུ་ཏི་གོ་སྟོད་ཀྱི་མིང་གི་རྣམ་གྲངས་སུ་བཞག་པའང་མཆིས་ཞེས་གསུངས།",
    "བསྲེགས་ཐལ་པི་པི་ལིང་།",
    "༥༨༧༢ཚ་གྲང་ཚ་ན་ཀ་ར་གྲང་ན་བུ་རམ་ལྟོས་བསྒྱུར་འཁྲུ་བ་གཅོག་པའི་མཆོག་༥༨༧༤ཤིང་མངར་དང་འབྲས་དཀར་བོ་དང་བསེ་ཡབ་སྨུག་པོ་བྱི་ཏང་ག་༥༨༧༦སོ་མ་ར་ཛ་དྲེས་འབྲུ་ཕུར་མོང་ནག་པོའི་ཐལ་བ་དང་།",
    "༥༨༧༧རྒྱམ་ཚ་ལ་ལ་ཕུད་དང་ཨ་ཟ་མོ་སྟེ་དབྱི་མོང་དཀར།",
    "༥༨༧༩ཁ་མཐོར་བཅོ་བརྒྱད་སྟེ་གྲང་སེལ་རེ་དགུ།",
    "གོང་གི་ཚ་སེལ་གོ་དྲུག་བསྡོམས་པས་ཕྱེ་མའི་སྦྱོར་བ་བརྒྱ་དང་རེ་ལྔ་དེ་སོགས་ཕྱེ་མ་གང་ཡང་སྦྱར་བའི་ཐབས།",
    "དར་མོའི་ཁྱུང་སྦྱོར་གསུམ་ལས།",
    "མཛེ་ཚ་སྟོད་ནས་བྱུང་ཁ་བ་ལྟ་བུ་ཐལ་ཚ་དང་ཡ་བཀླུ་ར་རྣམས་ཆ་གཅིག་དང་།",
    "གྲེ་བ་མཐའ་དག་གཡག་རྒོད་འབྲོང་རྐྱང་གི་ཤ་བཟང་དྲུག་ཚ་བ་སྒ་པི་ཕོ་གསུམ་དང་ཚྭ་སྣ་རྒྱ་ཚ་རྒྱམ་ཚ་ཁ་རུ་ཚ་གསུམ།",
    "༥༨༩༢ཀ་པེད་ཀུ་བ་རྣམས་ཞོ་རེ་མོན་ཆ་ར་དང་ད་ཏྲིག་གཉིས་ཞོ་དོ་རེ་དང་།",
    "༥༨༩༤ད་ལིས་ནི་ཕྲོམ་གྱི་སྐད་ཡིན་བ་ལུའི་མེ་ཏོག་དབྱི་མོང་དཀར་བོ་གནྡཱ་པ་ཏྲ་དང་།",
    "རྒྱ་བལ་མོན་རྣམས་ནས་སོ་རྩི་བྱེད་དེ་གོ་ལ་ཟེར།",
    "༥༨༩༡༢དུར་ཐོད་ཤ་རུ་སྤེན་མ་རྣམས་དུ་བ་མ་ཤོར་བར་བསྲེགས་པའི་ཐལ་བ་གསུམ་དང་།",
    "ཙ་བྱ་སྟེ་དབྱི་མོང་དཀར་བོ།",
    "༥༨༩༡༧ཀར་བུར་སྦྲང་གི་རྟ་དང་སྦྱོར་ན་མ་སླས་མ་གཤེར་བར་དྲིལ་བཏུབ་ལ།",
    "ལུག་རིལ་ཙམ་དང་དེ་ལས་ཆེ་ན་སེར་བ་རུས་ལུག་གི་ཆུ་བུ་ཙམ་དྲིལ།",
    "གློ་མཆིན་དང་ཟླ་མཚན་འབྱམས་པ་དང་རྨ་རྙིང་གི་ཁྲག་དང་སྣ་ཁྲག་འཛགས་པ་གཅོད།",
    "མངར་གསུམ་ལྡེ་གུ་ཨ་རུ་རྒྱ་སྐྱེགས་བཙོད་དང་འབྲི་མོག་ཕྲ་ཞིང་རྩི་མཐུག་བཟང་།",
    "ཨ་ཝ་ཕག་གི་ཟེ་བ་འདྲ།",
    "ཐོག་མ་ནས་རིམ་པས་ཆ་བསྐྱེད་ལྕགས་ཕྱེ་དང་སྤོས་དཀར་བརྒྱད་ལྕགས་ཕྱེ་སྤོས་དཀར་གཉིས་སྒྲིལ་བ་ཕྱི་མ་དེའི་བརྒྱད་རེ་རྣམས།",
    "ཚོན་མཐིང་གི་བར་ཤུན་མཐིང་དང་སྤང་མོ་གཉིས་ཟངས་རྡོའི་ཁ་ཤུན་ཡིན་ཟེར།",
    "བུད་མེད་ལྟོ་བ་ནས་ཐོན་པའི་མོ་རྡེ་ཉི་དགའ་ལྕམ་པ་འབྲས་སྣ་གསུམ།",
    "༥༩༢༡༢སེང་ལྡེང་བདུན་པ་སེང་ལྡེང་གུ་གུལ་ཐལ་ཀ་རྡོ་རྗེ་དང་།",
    "༥༩༣༡༡རྩ་ལྔའི་ར་མཉེ་ལ་ར་མོ་ཤག་ཉེ་ཤིང་ལྕ་བ་བ་སྤུ་བ།",
    "མེར་བསྲེགས་ནས་ཕྱི་ནག་ཚོམ་བཏོན་པས་དུག་འདོན་ལུག་ཐུག་འབྲས་མ་མོར་མ་ཞུགས་པ་རབ།",
    "དེ་ལ་ཚ་སེལ་བ་ར་དང་ཐུན་མོང་ལ་མཛོ་ཡི་མར།",
    "ཆུ་ཆོད་དྭངས་སྙིགས་ཕྱེ་ནས་མཛུབ་མོས་དཀྲུགས་ཀྱང་མི་འཚིག་པར་དཀྲུགས་ཚུགས་པ་དང་།",
    "༥༩༥༦ཤིང་ཚ་ཐལ་ཚ་པི་པི་ལིང་མཱུ་ལ་སྟེ་རྩ་བ།",
    "གོང་གི་འཇམ་པོའི་སྟེང་བསྣན་བ་རའི་ཞོ་ཡིས་སྦྲུ།",
    "ཐ་མ་གཡག་ཆུང་གི་རྭ་ཕྱེ་དང་སྔོ་ཡི་ཚ་བ་སྲུབ་ཀ་དབྱི་མོང་ལྕེ་ཚ་གསུམ།",
    "མོ་རིགས་བརླན་ལ་སྐྱེ་བ་བོང་བུ་ལན་ཚའམ་མེ་ཏོག་གསུམ་པ་ཟེར།",
    "བོང་ང་དཀར་བོ་ཞོ་རེ་མུ་ཟི་བཏུལ་བ་ཞོ་ཕྱེད་ཆ་མཉམ་གཉིས་འགྱུར་གྱི།",
    "ཅོང་ཞི་མུ་ཟི་འཇའ་ལིང་གི་རྒྱུད་ལས།",
    "ཞིག་དཀའ་ཕུལ་རེ་སོལ་ཕྱེད་ཕུལ་རེ།",
    "རྟ་སྦངས་ཆར་ཟོས་ཕུལ་ཕྱེད་རེ།",
    "སྟག་གེས་ཐལ་བཟོར།",
    "སོལ་བའི་གོང་བུ་གང་བ་མེ་དབུས་དང་ཕྱེ་དཀར་བ་ལྟ་བུ་བཅུག་ལ་ཆུ་ཁོལ་བ་ལྕེར་འབིགས་ཤ་རྗེན་ཚ་བ་འཚོས་པར་བསྲེག་མུ་ཟིའི་དྲི་སངས་འཚོས་པའི་ཚད་ཡིན་འདོན་ལ་མ་ཚོས་ན་ཐལ་བའི་དུག་ཏུ་བཤད།",
    "༥༩༦༡༤བིག་པན་སྟེ་ནི་ལ་ཐོ་ཋ་ཕྱག་ལེན་སྒོག་ཐལ་སྲིད་དཀར་སྙ་ལོ་ཀྱི་ལྕེ་བཞི།",
    "དངུལ་ཐལ་དངུལ་ཆུ་སྟར་བུས་བཤིག་པ་དངུལ་གཡའ་ཚྭ་དང་སླེ་ཏྲེའི་ཁུ་བར་བསྒྲུང་ནས་འདོན་པ་དང་།",
    "༥༩༧༡ཚ་བ་གསུམ་དང་ཟ་འོག་རི་མོ་ཅན་ལ་གོས་ཆེན།",
    "རི་མོ་མེད་པ་འཇམ་ཇུས།",
    "ཟ་འོག་རུ་ཟི་དང་གསོར་ཡུན་ཕུར་མོ་དང་།",
    "ན་མོ་པྲཛྙཱ་པཱ་ར་མི་ཏ་ཡེ།",
    "འཕྲལ་དུ་ཡིན་ན་ལུས་སྦྱིན་དཀར་འགྱེད་མང་ཞིག་གི་མཐར།",
    "སྐད་ཅིག་གིས་སྟོང་གསུམ་འདི་ཨོ་རྒྱན་རང་བྱུང་གི་དུར་ཁྲོད་དུ་གྱུར་པའི་དབུས་སུ།",
    "གཡོན་མི་རྐང་གི་གླིང་བུ་འབུད་པས་སྲིད་གསུམ་ཟིལ་གྱིས་གནོན་ཅིང་ཁམས་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་སྐུར་གྱུར།",
    "ན་མོ།",
    "ཡི་དམ་ཁྲོས་མ་ནག་མོའི་བདེན་པ་དང་།",
    "རྐང་གླིང་འབུད།",
    "ཕུང་ཁམས་སྐྱེ་མཆེད་ཚང་བ་རེ་རེ་ལའང་བརྒྱ་སྟོང་གྲངས་མེད་པ་འཕྲོ་བ་འདི་ཉིད་མ་ཅིག་རིགས་ལྔ་མཁའ་འགྲོ་བྱེ་བ་འབུམ་དང་བཅས་པ་ཕྱོགས་བཅུའི་ལྷ་འདྲེ་འབྱུང་པོ་ལན་ཆགས་ཀྱི་བདག་པོ་བདག་མོ་ཐམས་ཅད་ལ་སྦྱིན་ནོ།",
    "གྲེ་བོ་གྲེ་མོ་ཐེའུ་རང་འགོང་།",
    "དེ་ལྟར་ལན་བརྒྱ་རྩ་བརྒྱད་སོང་ནས།",
    "དེ་ཡང་རང་རེའི་ན་ཚ་སྡུག་བསྔལ།",
    "ཟུར་མང་ལུགས་ཀྱི་དམིགས་འབུམ་ཆེན་མོ་ན།",
    "འཕྲལ་དགོས་ཞིག་གི་ཆེད་དུ།",
    "ཀྲུང་ད་ག་པ་བ་འཇུག་གནས་བཀའ་བསྟན་དཔེ་སྡུར་ཁང་གིས་དཔེ་བསྡུར་ཞུས།",
    "༥༦༣བསྡུར་འབྲས་རེའུ་མིག་༥༧༥༡༨༤ དྲི་མ་མེད་པའི་འོད་ཀྱིས་ཞུས་པ།་",
