    "དེའི་འགྲམ་ན་མི་མང་པོ་ཞིག་ནག་ཕུང་ཕུང་འདུག་པ་ལ།",
    "བསྟན་པ་དར་རྒྱས་སུ་ཡོང་བ་དཀའ་བ་འདུག་པས།",
    "རྒྱབ་བརྟེན་རྡོ་རྗེ་སེམས་དཔའ་ཁྱེད་རང་ལ་བྱས།",
    "ད་ལྟ་ནི་སྔགས་པ་རྒན་པོ་ཞིག་ཏུ་འདུག་ཅེས་རྗེ་ཉིད་རྗེ་བཙུན་ཆེན་པོ་ཡིན་པ་ཞལ་གྱིས་བཞེས་པ་སོགས་ངོ་མཚར་གྱི་བཀའ་མང་དུ་སྩལ་ཞིང་།",
    "བར་སྐབས་སུས་ཀྱང་རྩད་མ་ཆོད་པ་ཞིག་བྱུང་འདུག་པས།",
    "ས་རྡོའི་གསེབ་ན་ཤིང་ལེབ་གཅིག་ལ་ཡི་གེ་དབུ་ཅན་ཁྲལ་ལེ་བ་གསལ་པོ་རང་མིན་པ་ཞིག་བརྐོས་ནས་འདུག་པ་ལ་ཁྲུས་གསོལ་ནས་ཡི་གེ་དེ་ཉིད་བཀླགས་པ་ན།",
    "ད་ལྟའི་ཟུག་རྒྱབ་པ་འདི་ནི་མཧཱ་ཀཱ་ལའོ་ཟེར་བ་འདུག་པ།",
    "དེའི་སྤྲོས་པ་ནི་ཆོད་འདུག་གཞན་སེམས་ཀྱི་ལྷག་མ་ཅུང་ཟད་ཀྱང་མེད་ཅེས་གསུངས་པ་དང་།",
    "དགེས་བཤེས་སུ་འཕྲིན་སྐྱོལ་ཟེར་བར་འདུག་པས།",
    "སྔགས་འཆང་ཉིད་ལ་གུས་འདུད་དང་བཅས་འདུག་པ་མཁན་ཚང་པ་བསྟན་པ་དར་རྒྱས་ཀྱིས་མངོན་སུམ་དུ་མཐོང་ཞིང་།",
    "སྐུ་དེ་ཉིད་ཅུང་ཟད་མདུན་དུ་བུབ་ནས་འདུག་པ་ལ།",
    "ས་ལོ་ཐམས་ཅད་མཁྱེན་པ་ཡིན་སྙམ་པའི་པཎྜི་ཏ་ན་བཟའ་ངུར་སྨྲིག་བསྣམས་པ་གཉིས་ཀྱང་འདུག་ཅིང་།",
    "ལྕོག་རྙིང་པ་འདི་ལ་ཡང་ཞིག་གསོས་ཤིག་བྱས་ན་ལེགས་པ་འདུག་སྙམ་དུ་དགོངས་ནས།",
    "བདག་ཉིད་ཆེན་པོས་འོ་ན་འདིར་ཁྱེད་རང་གནས་སའི་ལྕོག་ཅིག་གསར་ཏུ་བཏབ།",
    "དེ་མཐུན་ལྕོག་རྙིང་པ་ལ་ཡང་ཞིག་གསོས་ཤིག་བྱེད་དགོས་འདུག་པས།",
    "མི་ལ་མི་འཛེམ་པར་གྲལ་བསྒྲིགས་ཏེ་ལངས་ནས་སྔགས་འཆང་ཉིད་ལ་བསུ་བའི་ཚུལ་དུ་འདུག་པ་ནི།",
    "དེ་དུས་ཞབས་དྲུང་ན་འདུག་པ་ཀུན་གྱིས་མཐོང་བར་གྲགས་ལ།",
    "ལྷག་པར་ད་དུང་ལོ་དུ་མའི་བར་དུ་བསྟན་འགྲོའི་དོན་དཔག་ཏུ་མེད་པ་འགྲུབ་པ་འདུག་ཅིང་།",
    "འཇམ་པའི་དབྱངས་སྐུ་མཆེད་ཀྱིས་བདག་རྣམས་ཀྱིས་དེ་བཞིན་མི་ཤེས་པ་འདུག་ལགས་ཞེས་ཞུས་པ་ན།",
    "སྐུ་ཤེད་ཇི་ཆུང་དུ་འགྲོ་བ་འདི་ལ་བློ་བདེ་བ་ཞིག་གཏན་ནས་མི་འདུག་པས།",
    "གང་ལྟར་ད་ལོ་ས་ལོ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཞལ་བཞུགས་པའི་དུས་བཞིན་སྐུ་འཁོར་མང་པོ་དང་བཅས་དུས་སྐབས་ཕལ་ཆེ་ཐར་རྨི་ལམ་དུ་འབྱོན་པ་ཞིག་འདུག་པས།",
    "དགེ་སློང་པས་ཅི་འདུག་ལགས་ཞུས་པས།",
    "རྒྱུན་རིང་པོ་འདུག་ལོང་མེད་ཅེས་གསུངས་ཤིང་།",
    "ཞེས་ཀྱང་རང་བབས་སུ་སྨྲས་སོ།",
    "འཇམ་དབྱངས་ཡིན་ཟེར་བར་འདུག་ཁྱེད་རྣམས་ཀྱིས་གཙང་སྦྲ་དང་བཅའ་གས་ཐོན་པར་གྱིས་ཞེས་གསུངས་པ་དང་།",
    "ཁྱེད་རྣམས་ཀྱིས་བུ་ཚ་ལ་བཅའ་ག་ཆེར་མི་བྱེད་འདུག་ནའང་འདི་རང་ལ་གྲོགས་འགྲུལ་བཏུབ་ཅིག་སླེབས་འདུག་ཅེས་གསུངས་པ་ལ།",
    "འདུག་གྲོགས་སུ་པུ་ཏྲ་ངོ་མཚར་ཆེ།",
    "མཁའ་འགྲོ་རྣམས་ཀྱི་ནང་ནས་བདེ་བའི་རྡོ་རྗེ་གསལ་ཏེ་རིགས་འཛིན་བརྒྱུད་པའི་ཟླ་ལ་འདུག་གཞན་རྣམས་གོང་བཞིན།",
    "ཁྲམ་ཤིང་སྐེད་ལ་བཙུགས་པ་ཅིག་འདུག་པ་དེ་གཉིས་གསལ།",
    "རིགས་འཛིན་བཞིའི་གོ་འཕང་ཐོབ་ངེས་པ་ཞིག་ཁྱེད་མཁྱེན་ཞེས་ཕུར་ཚུགས་སུ་གསོལ་བ་འདེབས་ཀྱི་འདུག་པས།",
    "དེའི་རྐྱེན་གྱིས་ཉི་མ་ཡང་ཤར་ཏེ་བྱས་འགྱུར་གྱི་ལུང་པ་ཐམས་ཅད་འོད་ཀྱིས་གང་ནས་འདུག་པ་དང་།",
    "དོ་ནུབ་འདིར་བསྡད་ན་སྙམ་པ་ཙམ་འདུག་སྟེ་སྐྱེད་ལྷས་མགོན་ཁང་དུ་བསྐང་གསོའི་གྲབས་བྱས་པ་སོགས་བྲེལ་བའི་སྟབས་ཀྱིས་འགྲོ་བ་ཤར་ཚེ།",
    "རྗེ་ཉིད་མྱུར་དུ་དག་པའི་ཞིང་དུ་ཕེབས་པའི་དགོངས་པ་དེ་དུས་ནས་གཏད་པའི་གསུང་དུ་འདུག་ཅིང་།",
    "གཞན་ནི་འོས་རིགས་གང་ནས་བཙལ་ཀྱང་མི་འདུག་ཅིང་།",
    "དེའི་ངང་ནས་གུར་གྱི་མགོན་པོའི་སྐུ་ཡོངས་རྫོགས་ཇེ་གསལ་ཇེ་གསལ་འགྲོ་བ་ཞིག་འདུག་པ་ལ།",
    "གཞན་གཉིས་པོ་དེ་ཅུང་ཟད་ཁྲོས་པའི་ཚུལ་གྱིས་འདུག་པས།",
    "ངེད་ལ་མདང་ནུབ་རྨི་ལམ་འདི་བཞིན་བྱུང་བ་བྲིས་ཐང་འདི་ལ་པུ་ཏྲ་མིང་སྲིང་གསུམ་ཀ་མ་བྲིས་པས་ལན་པར་འདུག་ཅེས་གསུངས་ཤིང་།",
    "ངེད་ཀྱི་རྨི་ལམ་དེ་བྲིས་སྐུ་མྱུར་དུ་འདྲི་དགོས་པའི་རྟགས་སུ་འདུག་གསུངས་ནས་ཐུགས་རྩོལ་ཆེན་པོས་ཕྱག་བྲིས་ལེགས་པར་མཛད་ནས་རབ་གནས་དང་བསྐང་གསོ་རྒྱས་པར་མཛད་པའི་དུས་སུ་ཡང་ངོ་མཚར་བའི་རྟགས་དུ་མ་བྱུང་བ་ཡིན་ལ།",
    "སེང་ཁྲི་མན་གྱི་རྩིག་པ་ཤིན་ཏུ་གསལ་བ་འདུག་པ་མཐོང་བའི་ཚེ།",
    "ངེད་ནི་བདེ་བ་ཅན་ལ་འགྲོ་ཁྱེད་རང་ཨེ་འགྲོ་གསུང་བྱུང་བ་ལ།",
    "ཧེ་ཧེ་བདེ་བ་ཅན་དུ་འགྲོ་ན་ཚང་འདུག་པ།",
    "སེམས་ཁུར་བསྐྱེད་པ་རང་གལ་ཆེ་ཞེས་གསུང་བ་འདུག་པ་དེ་དུས་ནི་རང་ཉིད་རྟག་འཛིན་ཆེས་པས་གོ་བ་མ་བྱུང་ཀྱང་།",
    "བསྟན་པ་ལ་བྱ་བ་ཐུབ་ངེས་ཀྱི་ལུས་ཤིག་དགའ་བ་འདུག་ཅེས་སོགས་མྱུར་དུ་གཞན་དོན་ལ་ཕེབས་པར་དགོངས་པའི་གསུང་མང་དུ་བྱོན་ཞིང་།",
    "ནམ་མཁའ་ལ་ངོ་མཚར་བའི་རྟགས་འདི་ལྟ་བུ་རྟག་པར་ཡོང་ལུགས་ཀྱིས་བྱང་ཕྱོགས་ཀྱི་རྒྱུད་འདི་མགོན་དང་བྲལ་བ་ཞིག་མྱུར་དུ་མཐོང་བར་འདུག་གོ་ཞེས་མི་བཟོད་པའི་སྨྲེ་སྔགས་དྲག་པོ་དུས་ཀུན་དུ་སྒྲོགས་པར་གྱུར་ཅིང་།",
    "ལྷག་པར་ཚེས་བཅུ་བཞིའི་སྔ་དྲོ་རྗེ་ཉིད་སྔགས་འཆང་ཆེན་པོའི་སྐུ་བསྟོད་ཤེས་བྱ་ཀུན་ལ་མ་གདངས་དང་བཅས་པ་ཞིག་གསུང་ཤུགས་ཆེན་པོས་མཛད་ཀྱིན་འདུག་པ་ལ།",
    "ངེད་རང་ཆིབས་གདོང་ལ་བྱས་ནས་བླ་བྲང་ཟམ་པའི་སྟེང་ནས་འབྱོན་གྱིན་འདུག་པ་ལ།",
    "དེ་དུས་ཀྱང་སྔགས་འཆང་ཉིད་དང་མཇལ་བར་འདུག་གོ།",
    "ཞེས་པའང་རང་བབས་སུ་སྨྲས་ཤིང་གསོལ་བ་བཏབ་པའོ།",
    "དེ་ཡང་རང་ལོ་བརྒྱད་གཉིས་ལྷག་ཙམ་ལོན་པའི་སྐབས་སུ་སྔགས་འཆང་ཉིད་ཀྱི་གསུང་ལས།",
    "ཕྱིས་བསམས་པས་སྔགས་འཆང་ཉིད་རང་དག་པའི་ཞིང་དུ་མྱུར་དུ་ཕེབས་པའི་དགོངས་པ་དེ་དུས་ནས་གཏད་པའི་གསུང་དུ་འདུག་ཅིང་།",
    "རང་ངོས་ནས་གདན་སའི་ཁུར་འདི་ཙམ་མི་ལྕོགས་པ་ལ་ཐུག་འདུག་ཀྱང་འདི་བཞིན་གྱི་ཁུར་བྱས་པས།",
    "ཁྱེད་རང་རིང་པོར་མི་ཐོགས་པ་ལོག་སྒྲུབ་ཐམས་ཅད་ནམ་མཁའ་ལ་དེངས་ནས།",
    "ཡང་ས་སྐྱ་པ་དྲག་ཞན་མེད་ཁྱེད་རང་ལ་མགོ་འབུལ་ལུས་འབུལ་བྱེད་པ་ཞིག་ཡོང་ངོ་ཞེས་གསུངས་པ་སོགས་དུས་ཕྱིས་འདི་བཞིན་གྱི་གདན་སའི་ཁུར་དགོས་པའི་ལུང་བསྟན་ངེས་ཤེས་ཅན་མང་དུ་ཡོད་ཀྱང་།",
    "འདི་མ་ཤེས་ཀུན་ཀྱང་རང་ཕུང་ཡིན།",
    "རང་རང་སེམས་དེ་དང་དབྱེར་མེད་པ།",
    "ཤོག་ལྷེ་དེའི་མཐའ་སྣེར་སྙན་ངག་པ་སྨྱོན་པ་ནས་སྤྱི་ལོ་ཟླ་ཚེས་ལ་རང་ཤག་ནས་སྦྱར་ཞེས་བཀོད་འདུག་ཉིན་དེ་ནས་བཟུང་།",
    "རྣམ་པར་སྣང་བེ་རོ་ཙ་ན་མཛད་གཡུ་བི་རོ་ཙ།",
    "ངའི་སློབ་གྲོགས་ཚོས་དེབ་དེར་གདེང་འཇོག་ཆེན་པོ་བྱེད་ཀྱི་འདུག་པས།",
    "ངས་པར་སྐྲུན་བྱེད་རྒྱུ་ཁས་ལེན་བྱས་པ་དེ་ནོར་མི་འདུག་བསམས།",
    "ཡིན་ནའང་སྔོན་གླེང་དེ་གློག་ཀླད་ལས་རྩ་ཡལ་དུ་གྱུར་འདུག་པས་སླར་ཡང་འབྲི་དགོས་བྱུང་།",
    "ཡ་མཚན་གྱི་ཚོར་སྣང་ཡལ་གྱི་མི་འདུགགསུམ་པ་ནི།",
    "མི་དེའི་རང་གཤིས་དང་རང་ཚུགས་བརྟན་མིན།",
    "ཁྱེད་རང་ཡང་བསྐྱར་ཕེབས་ནས་ལོ་རབས་ལྔ་བཅུ་པའི་སྐོར་ལ་བཀའ་འདྲི་ཅི་ཡོད་གནང་རོགས།",
    "ཨ་ལི་བཱ་བཱ་ཡི་སྒྲུང་ལྟ་བུ་དྲན་སོས་ཀྱི་འདུགདུས་སྐབས་དེའི་རིང་།",
    "ངོས་སྐལ་བཟང་ཚེ་རིང་འབའ་ཐང་དུ་ཡོང་ཚུལ་དེ་གསལ་པོར་དྲན་གྱི་འདུག།",
    "མེ་མདའ་འཕེན་འགོ་ཚུགས་སྐབས་ང་རང་འཇིགས་ཤིང་སྐྲག་པར་གྱུར།",
    "དེ་ལྟར་དམག་འཁྲུག་དུས་ཡུན་ཟླ་བ་གསུམ་རོབ་ཚོད་བྱས་ན་ཕྱི་ལོ་༡༩༣༢ ལོའི་ཕྱི་ཟླ་བཞི་པའི་ཟླ་དཀྱིལ་ནས་ཟླ་བ་བདུན་པ་བར།",
    "འོན་ཀྱང་གནས་ཚུལ་དེས་ང་རང་ཧོན་འཐོར་ཅིང་གདུང་བས་མནར།",
    "ང་རང་ཞང་པོ་དང་སྐལ་བཟང་ཚེ་རིང་ལྟ་བུ་ཞིག་ཆགས་འདོད་ཡོད་པས།",
    "འོན་ཀྱང་རྦད་དེ་རྗེས་ལུས་ཐེབས་ཟིན་འདུག།",
    "དེ་བཞིན་ངས་མ་ཤེས་པ་བྱས་ཏེ་ངའི་ཁྱིམ་དུ་ཡང་མི་ཞིག་གནས་ཚུལ་བརྗོད་པར་མངགས་འདུགཕྱི་ཉིན་ཞོགས་པ།",
    "ཞང་པོ་ནི་ངའི་འཇིགས་སྣང་ལ་ཡ་མཚན་སྐྱེས་འདུག་ཅིང་།",
    "ཁང་བརྩེགས་རྣམས་ཀྱང་གཡོ་འགུལ་བྱེད་ཀྱི་འདུག་བསམ་མྱོང་།",
    "འོན་ཀྱང་ད་ཆ་ང་རང་དགའ་སའི་དེང་རབས་ཀྱི་འཇིག་རྟེན་ནང་དུ་སླེབས་པས།",
    "མཉན་དཔོན་དེ་དེ་སྔོན་བོད་མི་གཏན་ནས་མཐོང་མྱོང་མེད་པ་ཞིག་ཡིན་འདུག་ཅིང་།",
    "ཁང་བརྩེགས་དང་རླངས་འཁོར་ཚང་མར་ཧོན་འཐོར་འཐོར་དུ་བལྟ་བའི་སྒྲུང་ཞིག་ཀློག་པ་དེས་ཡིད་འཕྲོག་པ་དྲན་གྱི་འདུག།",
    "སྒྲུང་དེར་ང་རང་དགའ་པོ་ཡོང་དོན་ནི།",
    "ང་རང་བོད་ཀྱི་རིག་གཞུང་དང་བོད་ཟས་དང་རྦད་དེ་འབྲེལ་མེད་དུ་གནས་མེད།",
    "ཁ་ལག་ཀྱང་ཡག་པོ་འདུག།",
    "ང་རང་དེར་སླེབས་པ་དེ་སྐལ་བ་བཟང་པོ་ཡིན་སྙམ་གྱི་ཡོད།",
    "རྐེད་པར་གྲི་རིང་པོ་ཞིག་བཏཌ་འདུག་ལ་སྐབས་དེར་ངའི་སེམས་ནང་།",
    "ཚོང་པ་བཅས་པ་རྣམས་གཅིག་ཏུ་བསྒྲིལ་ཏེ་རྒྱལ་ཁབ་སྐྱོབ་དགོས་པའི་སྐོར་གྱི་གཞས་ཚིག་ཅིག་ད་ལྟའང་གསལ་པོར་དྲན་སོས་ཀྱི་འདུག།",
    "ང་རང་འབའ་ཐང་དུ་འཚར་ཞིང་དེ་སྔོན་གྱི་གནས་ཚུལ་དེ་དག་རིག་མྱོང་བའི་ཆ་ནས།",
    "བཟོ་པ་ཚོས་ཨུ་རུ་སུར་བསྔགས་བརྗོད་ཆེན་པོ་བྱེད་ཀྱི་ཡོད་སྐོར་བྲིས་འདུག།",
    "ང་རང་འབའ་པའི་ནང་ནས་རྒན་ཤོས་མིན་ནའང་རང་གཤིས་གྱོང་སྟབས་འབའ་པ་ཚང་མས་བརྩི་འཇོག་བྱེད་ཀྱིན་ཡོད།",
    "དེ་ནུབ་གནས་ཚུལ་ཇི་བྱུང་ད་ལྟ་གསལ་པོ་དྲན་གྱི་མི་འདུགང་ཉལ་ཁང་དུ་སླེབས་རྗེས།",
    "ང་རང་གཅིག་པུར་ཨུ་རུ་སུའི་གཞུང་ཚབ་ཁང་ལ་འགྲོ་རྒྱུའི་བློ་ཐག་བཅད།",
    "ང་རང་དེ་ལ་འཇིགས་སྣང་ཅི་ཡང་མེད་པས་བསྐྱོད་ཐབས་བྱ་རྒྱུ་ཡིན།",
    "ཤེས་རབ་དང་ང་རང་དགའ་སེམས་དང་ངར་ཤུགས་ཆེས་ཆེར་འཕེལ་བས་ལག་པ་བརྐྱངས་ནས་ངེད་ཚོ་ཚེ་གང་བློ་མཐུན་བྱ་རྒྱུ་དང་།",
    "ངེད་ཚོས་བསམས་པ་ལས་དཀའ་ཚེགས་ཆེ་བ་འདུག།",
    "མཐའ་མ་ངས་ཤེས་རབ་ལ་ཁོ་རང་ངེས་པར་བསྐྱོད་དགོས་པ་དང་།",
    "འོན་ཀྱང་སྒྲིག་ཆས་འབྱོར་རྒྱུའི་ཚབ་ཏུ་ཤེས་རབ་ཁོ་རང་སླེབས་བྱུང་།",
    "འདུ་འཛོམས་དེར་སླེབས་པའི་མི་རྣམས་ངའི་བསམ་ཚུལ་ལ་ཧ་ལས་འདུག།",
