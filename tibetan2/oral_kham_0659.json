    "དེ་ཙ་ན་འཆི་ནུས་དགོས་པར་འདུག་པས།",
    "སྤང་བྱར་བྱས་ཏེ་ཞེན་པའི་འཁྲི་བ་གཅད་བཟློག་བསྒོམ་དུ་བྱས་ཏེ་རྐྱེན་དང་རང་ཐོག་ཏུ་རོ་སྙོམས་པའོ།",
    "ཟས་ནོར་ལ་སོགས་སྟེར་བ་བྱུང་བ་ལ་དགའ་སྤྲོ་སྐྱེ་ཞིང་དོན་གང་ཆེ་བ་གཏོང་བའི་བློ་མི་འདུག་ན།",
    "སྡོམ་པ་སྐྱེལ་ལམ་ཆ་མི་འདུག་པས།",
    "བཙལ་ཡང་མི་རྙེད་ཙ་ན་རྙེད་པ་སྒྲུབ་པའི་བློ་མི་ཡོང་བས།",
    "ནོར་རྫས་བསགས་པས་སོག་པ་མི་འདུག་ཅིང་ནོར་ལ་དགོས་མེད་དང་ཞེན་ལོག་སྐྱེས་ནས་མ་བསགས་པ་མིན།",
    "དམ་དུམ་འདུག་པ་འདི་ཡང་སུས་འདོད་པ་ཁྱེར་ཅི་དགའ་བ་བཟར་མེད་བགོར་མེད་ཐོང་བགྱིས།",
    "དེ་གཉིས་ཀ་མི་འདུག་ནའང་།",
    "དོན་སྤྱི་མ་ནོར་བར་གོ་བའི་མཁས་པ་འདུག་གམ་མི་འདུག་ལྟ།",
    "གཉིས་ཀྱང་མི་འདུག་གཉིས་ལས་གཅིག་ཀྱང་གཙང་སིང་པ་མི་འདུག་མི་ཕྱུགས་ལ་སོགས་རགས་པ་མ་བསད་ཀྱང་ཤིག་ས་ལ་སྐྱར་བ་དང་།",
    "ངག་འཁྱལ་སྨྲས་པ་ལ་གྲངས་མི་འདུག་པས།",
    "མ་བྱུང་བ་ལ་རང་ཡང་མི་དགའ་བ་འདུག་ན།",
    "འདི་ཕྱི་གཏན་དུ་བདེ་སྐྱིད་ཡོད་པ་ཞིག་འགྲུབ་པར་འདུག་པས་གོ་བཅད་སྙམ་དུ་བསམ།",
    "ཉེ་འཁོར་འཛོམས་དུས་སུས་ཀྱང་མནར་བ་མེད་པར་བློ་ལྷོད་དེ་སྡད་བས་ཆོག་དུས་འདིར་དགེ་སྦྱོར་བྱ་དགོས།",
    "ཐམས་ཅད་ཕྱུག་པོ་བྱ་སྙམ་པ་ལས་དབུལ་པོ་བྱ་སྙམ་པ་སུ་ཡང་མེད་པས་ཚོང་དང་སོ་ནམ་ལ་འབུངས་ཀྱང་ལྟོ་རྒྱགས་མི་འབྱོངས་པར་འདུག་ཅིང་།",
    "ཕྱུག་པོ་བས་དབུལ་པོ་འབུམ་འགྱུར་གྱིས་མང་བར་འདུག་གལ་ཏེ་གསོག་ཀྱང་བོར་སྟོར་ཆུད་ཟོས་དང་སུས་འཕྲོག་ཆ་མི་འདུག།",
    "སྒྱུ་། ནོར་ཕྱིར་རྩྭ་ར་འཚན་ཆུ་དང་སྲོག་དང་ནམ་བྲལ་མི་ཤེས་པར་འདུག་འཕྲལ་དུ",
    "ངས་ལུས་ཀྱི་སྦྱིན་པ་སྲོག་གཏོང་བ་ནི་མི་ནུས་པར་འདུག་ཀྱང་།",
    "ཁ་འདི་བཅོས་པས་ཆོག་པ་ཞིག་ཡིན་ན་ནི་དུཁ་བྱ་མི་དགོས་པར་འདུག་སྟེ།",
    "དེ་ལ་མི་དགའ་བ་སྐྱེས་ན་ཇི་ལྟར་སྐྱོན་བརྗོད་པ་དེ་ཁ་ནང་དུ་ལོག་ལ་རང་ལ་འདུག་གམ་བལྟས་ལ།",
    "དེ་འདུག་ན་རང་སྐྱོན་མེད་པར་ཁོ་པས་བརྗོད་པ་མིན།",
    "རྐྱེན་བྱུང་ཙ་ན་དེ་ཐོག་ཏུ་རོ་སྙོམས་པ་དྲན་པའི་དགོས་པ་ཡོད།",
    "ལོགས་སུ་གྲུབ་པ་འདུག་གམ་མི་འདུག་སྣང་བ་དེ་རྣམས་ཀྱི་དངོས་སུ་ཕན་བཏགས་པ་དང་།",
    "གནོད་པ་འདུག་གམ་མི་འདུག་མཉམ་དུ་བརྟགས་ལ།",
    "ཇི་ལྟར་ཤར་བ་དེ་དག་ཀྱང་རང་བཞིན་གྱི་རྣམ་པར་དག་པའི་སྟོང་པ་ཉིད་དང་རོ་མཉམ་དུ་གྱུར་པས།",
    "ད་ལྟ་མངོན་དུ་གྱུར་པའི་སྣང་བ་གང་འདུག་པ་དེ་ཕུལ་ལ།",
    "ཡིད་འགྱུ་སྟོང་དབྱེར་མེད་དུ་འདུག་དེ་ཡང་སྣང་བ་མ་བཅོས་པར་བཞག་པས།",
    "གྲང་སར་འགྲོ་འདུག་བྱེད་ན་ལུས་མེ་དཔུང་དུ་བསྒོམ་ལ།",
    "སྤྱིར་འོད་གསལ་ལམ་དང་རང་བཞིན་གཉིས་སུ་འདུས་པའོ།",
    "སྣང་བཞིན་དུ་མི་བདེན་པར་སྣང་སྟོང་རང་བཞིན་མེད་པའོ།",
    "ཟུང་འཇུག་ལ་བརྟན་པ་མ་ཐོབ་པར་སྐྱེ་བ་ལེན་པར་འདུག་ན་མངལ་སྒོ་དགག་པའི་གདམས་ངག་ཉམས་སུ་ལེན་པའོ།",
    "དེ་ལ་ཡང་བརྟན་པ་མ་ཐོབ་པར་སྐྱེ་བར་ལེན་པ་འདུག་ན།",
    "བསྒོམ་དང་རང་བཞིན་འོད་གསལ་གཉིས།",
    "ཅིར་སྣང་རང་སེམས་ཀྱི་རྣམ་འཕྲུལ་ཡིན།",
    "འཁོར་འདས་ཐམས་ཅད་ལ་དག་སྣང་འབའ་ཞིག་བསྒོམ་ཞིང་རང་སེམས་ཐུལ་བར་བྱེད་པའོ།",
    "དེ་ཡང་རང་སྣང་འཁྲུལ་པས་ཕྱི་རོལ་གྱི་སྡུག་བསྔལ་ཕྲ་རགས་ཉམས་སུ་མྱོང་བ་ཡིན་ཏེ།",
    "རང་སེམས་འདུལ་ཞིང་རང་སྣང་དག་པར་བྱ་བ་གལ་ཆེ་སྟེ།",
    "སེམས་འདི་ཡོངས་སུ་གྱུར་ཙ་ན།",
    "གསུམ་པ་མཛེས་རྒྱན་རྗེས་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་གཟུང་ཞིང་རང་ངོ་སྤྲད་པ།",
    "ཉིན་སྣང་ལམ་དང་རང་བཞིན་གཅིག་ཏུ་བསྲེ་བ།",
    "ཞར་ལ་སྒྲིག་དུས་བཞི་མ་འཆོལ་མ་བའོ་། དང་པོ་ལ་ཡང་བཞི་སྟེ།",
    "རྗེ་ཁྱེད་རང་ལ་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "རང་བྱུང་རང་ཞི་ཆུ་ཡི་པ་ཏྲ་འདྲ།",
    "ཁོ་རང་ཁར་ཡན་དུ་བཞག་པས་སྦྲུལ་མདུད་བཞིན་རང་གྲོལ་དུ་འགྲོ་བ་ཡིན་སྟེ།",
    "རྩོལ་བ་ཆེ་ལ་ཡོན་ཏན་ཆུང་བ་ཞིག་གདམས་ངག་ལྔ་བྱེད་པར་འདུག་སྟེ།",
    "ཡང་འདི་སྒོམ་ཞེས་བློས་བྱས་ལ་སྒོམ་རྒྱུ་གཅིག་ཀྱང་མི་འདུག་པས་སྒོམ་གྱིས་སྟོང་ལ།",
    "མི་འདུག་པས་ཝལ་གྱིས་སྟོང་པ་སྟེ།",
    "རང་སྣང་རང་ངོ་ཤེས་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ལ་འགག་པ་མེད།",
    "ཉེར་གཅིག་དུས་བསྐལ་པ་དང་སྐད་ཅིག་མ་ལ་ཁྱད་མེད་པ་དང་དུས་གསུམ་དུས་མེད་མངོན་སུམ་དུ་མཁྱེན་པ་དང་།",
    "རང་སྟོང་ཡེ་སྟོང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "དེ་ཡང་རང་སྟོང་བས་ཡུལ་མེད།",
    "། རྟོགས་པ་ལ་བོགས་མེད་ཙ་ན་གསོལ་བ་འདེབས།",
    "ཉེ་གནས་ཀྱི་ཚ་བ་དྲང་བ་ཕྱག་ཏུ་བཞེས་པ་བྱུང་འདུག་སྟེ།",
    "འདི་ལྟར་ཡིན་བྱ་བ་མི་འདུག་ལྷོ་ལམ་དུ་འཁྱེར་ལུགས་གཅིག་ཡོང་ངོ་ཞེས་སྙམ་ནས།",
    "ད་ལྟ་ཡང་སྐུ་ཁམས་ནམ་བཟང་ཙ་ན་འོང་གསུང་།",
    "དེའི་འཕྲོ་ལ་མནལ་སད་ཙ་ན།",
    "ལྷ་འདྲེ་ལམ་དུ་འཁྱེར་ལུགས་ཀྱི་གསང་སྤྱོད་འདི་གསལ་ལམ་མེར་ཤར་ནས་འདུག་གཞན་ཡང་སྐུའི་བཀོད་པ་དང་།",
    "སྡུག་བསྔལ་གྱི་རང་བཞིན་དུ་འདུག་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལ་གནས།",
    "བགེགས་ཁོ་རང་ཡི་དམ་དུ་བསྒོམ་ཙིཏྟཾཔས་གནོད་བྱེད་ཀྱི་བསམ་སྦྱོར་ཕན་བདེར་བཟློག་པ་ཡིན།",
    "རང་ཞི་ཙ་ན་བདུད་ཀྱང་ཞི་བ་ཡིན་རང་གནས་ཙ་ན་བདུད་ཀྱང་གནས་བདུད་རང་དུ་ཤེས་ཤིང་།",
    "ཞེས་པ་ལ་སོགས་པ་གསལ་བར་འདུག་སྟེ།",
    "འཁྲུལ་འཁོར་སྐྱིལ་ཀྲུང་དྲང་པོར་འདུག་པ་ལ།",
    "གང་རུང་རུང་ལ་བྱས་ན་རང་ལ་གཟན་པར་འདུག་དམ་སེལ་ལམ་སྡིག་སྒྲིབ་འཆལ་བའི་སྐྱོན་ཡོད་པཎྞཾཔ་ལ་བྱས་ན།",
    "སྤྱན་སྔ་ནས་ཕྱག་ལེན་འགའ་མཛད་པར་འདུག་པ།",
    "ཉན་ཙ་ན་རྣ་བར་ཉན་པ་དེ་ལ་བསྒོམས་ཙ་ན་གཡུ་ཏོ་མི་འདུག་གསུང་།",
    "གདམས་ངག་འདི་ལྟ་བུ་གཞན་ལ་མི་འདུག་གསུང་།",
    "དམིགས་པ་འདི་གཉིས་ཀ་པཀྵ་འདྲེན་འཕར་ཆེ་བས་ཆུན་ཆེ་བར་འཇུག་འཛག་པ་དྲུག་ཀ་བསྲུང་བར་འདུག་རྨི་ལམ་དུ་འཛག་ན་གཉིད་ལོག་ཁར་ཡང་མང་དུ་བསྒོམ།",
    "གྱད་ཀྱི་འདུག་སྟངས།",
    "ལན་གཉིས་གསུམ་གྱིས་གཟེར་བཏབ་པ་བཞིན་འགྲོ་བ་འདུག་སྟེ།",
    "རྩ་ཁ་ཕྱེས་ཏེ་ཆུ་བཞིན་འཛག་པ་ལའང་འཕྲལ་ལ་ཁེགས་པར་འདུག་ཟླ་བ་ཕྱེད་ཀྱིས་བར་ལ་བསྟེན།",
    "རང་རང་རིགས་དང་ལུས་དང་བསམ་པ་ལས།",
    "ཐད་ཀར་སེང་ཞིང་རང་སར་གཞིལ་བར་བྱ།",
    "རང་རང་གནས་སམ་བསྐྱེད་པའི་རྩ་སྒོ་ནས།",
    "རང་རང་རིགས་དང་ལུས་དང་བསམ་པ་ལ།",
    "ཎྞཾཐིག་ལེའི་རྣལ་འབྱོར་ཐམས་ཅད་རྗེས་དྲན་དུ་འདུག་གོ།",
    "ཐད་ཀར་བསྲང་ཞིང་རང་སར་གཞིལ་བར་བྱ།",
    "རང་རང་གནས་སམ་བསྐྱེད་པའི་རྩ་སྒོ་ནས།",
    "འཁྱིལ་བའི་འདུག་སྟངས་རུ་སྦལ་ཚང་དུ་བཅིང་།",
    "འཛུལ་སྒོ་ཅན་ལ་མུན་པ་ལེགས་པར་བསྒྲུབས་ནས་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "རང་རང་རིགས་སམ་ལུས་དང་སེམས་དཔའ་ལས།",
    "ཐོད་ཀར་བསྲང་ཞིང་རང་སར་གཞིལ་བར་བྱས།",
    "ངོ་བོ་ཆུ་རུ་འདུག་པ་ཞིག་བསྒོམས་ལ།",
    "མར་རྡེབ་ཙ་ན་ལྷོད་བཏང་ལ།",
    "རང་རང་གནས་སམ་བསྐྱེད་པའི་རྩ་སྒོ་ནས།",
    "ཡུམ་པདྨའི་འདུག་སྟངས་ཀྱིས་སྙོམས་པར་ཞུགས་པ།",
    "འགྲོ་འཆག་ཉལ་འདུག་དང་།",
    "སེམས་ཇི་ལྟར་བྱེད་ཀྱིན་འདུག།",
    "སླར་ཡང་རང་བྱིན་བརླབ་པ་སྟེ།"
