    "བྱིས་པ་དང་རྒན་པོ་དང་མངལ་ན་འདུག་པ་དང་གཞོན་ནུ་དང་འདི་རྣམས་ལས་གང་བསད་ཀྱང་ཕམ་པར་འགྱུར་རོ།",
    "གསེར་ཕྱེ་འམ་པ་ནེའམ་༧དོང་ཙེའམ་འགྲོན་བུའམ་ནས་འབྲས་ལ་སོགས་པ་ཕུང་པོར་འདུག་པ་ལ་སྔ་༡ཕྱིར་ཚག་བུར་བླངས་ཤིང་རྐུ་ན་ཅི་ཙམ་ཐོབ་ཀྱང་རུང་ཕུང་པོ་མ་ཟད་ཀྱི་བར་དུ་རིན་ཐང་མ་ཚང་ན་ཕམ་པར་མི་འགྱུར་རོ།",
    "སྨྱེན་༡ཚིག་དང་ཀུན་སྤྱོད་དང་ག་ག་ཚིལ་ལ་སོགས་པ་དང་གོས་དང་ཟས་སློང་བ་ལ་སོགས་པ་རྣམས་ནི་སྨྱོས་ཤིང་རང་བཞིན་སྟོར་བ་ལས་བྱས་པ་ནི་ཉེས་པ་འབྲི་༡༧བར་འགྱུར་རོ།",
    "བསམ་གཏན་དུ་འདུག་པའི་འོག་ཏུ་སའི་སྟེགས་བུ་བྱས་ཀྱང་ཉེས་མེད།",
    "ནམ་མཁའ་ལ་མི་འདུག།",
    "དད་པ་ལེན་པའི་ཚེ་གཅིག་ནམ་མཁའ་ལ་མི་འདུག་པ་ལའང་བྱ།",
    "དད་པ་བླངས་ནས་ནམ་མཁའ་ལ་མི་འདུག་པ་ལའང་བྱ།",
    "ཚོལ་བ་དང་དགྲ་༨དང་མཐོན་པོར་འདུག་སྟེ་ཕྱོགས་སུ་ལྟ་བ་ནི་དེའོ།",
    "ཚོར་བ་སོ་སོར་བྱ་སྟེ་ཐམས་ཅད་དུ་འདུག་ག་གོ།",
    "ཕྱོགས་མཐོན་པོར་འདུག་ལ་ཕྱོགས་བཞིར་བ་ལྟ།",
    "དགེ་སློང་བཞིར་མ་ཚང་སྟེ་གསུམ་མན་ཆད་ཅིག་འདུག་ནའང་གཅིག་ལ་གཅིག་ཉེས་པ་ཅི་ཡོད་པ་བརྟགས་ཏེ་དཔང་བཙུགས་༦ཏེ་གཞག་གོ།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ།",
    "དགེ་སློང་མང་དུ་མེད་དེ་གཉིས་སུ་འདུག་ན་ཉེ་བར་ཙོག་ཙོག་པོར་ཕས་འདུག་ཚུས་༩འདུག་སྟེ་གཅིག་ལ་གཅིག་བརྟག་ག་གོ།",
    "བར་དུ་བསྡད་དེ་མ་འོངས་ན་གསུམ་ཆར་ཁྲིའུའི་སྟེང་དུ་འཁོད་དེ་འདུག་ལ་བརྟགས་ཏེ་གཞག།",
    "ཁས་པ་གུད་ནས་འོངས་ན་བསྟི་སྟང་དང་མགུ་བར་བྱ་ཞིང་རྟག་པར་འདུག་པར་བྱ་བའི་ཕྱིར་ཡི་གེ་གྲ་བཙུགས་པ་དང་ཁ་དོན་༡མཚན་རངས་བྱ།",
    "ཡང་དག་པར་བྱས་པ་དེར་འདུག་པར་འདོད་ནའོ།",
    "མུར་༡འདུག་བར་དུ་གཅོད་ན་ཆད་པས་རབ་ཏུ་བཅད་དེ་ཁྲོས་པ་དང་འཁྲུགས་པས་ནི་མི་བསྟན།",
    "དགེ་སློང་ཀུན་མུར་འདུག་ཏུ་ཞུགས་པ་དང་།",
    "ཤིང་གཅིག་འདུག་པའི་མཚམས་ཀྱིས་དུ་མ་བཞིའི་མཚམས་ས་སོ།",
    "སྒྱུ་མར་སྤྲུལ་ཅིང་འདུག་པ་ལྟ་བུ་ལ་༡༧མཚན་མར་མི་གཟུགས།",
    "ཁའ་ལ་ཁ་དྲང་དུ་མི་བཅད་ཀྱི་སའི་གཞི་གྱེན་ཐུར་ཅི་ལྟར་འདུག་པ་བཞིན་དུ་འདོམ་གྲངས་ཀྱིས་བཅལ་༤ཏེ་དཔག་ཚད་ཕྱེད་དང་གསུམ་དུ་བཅད་དོ།",
    "གྲལ་ཐོག་མ་པས་ཁ་དོན་ཀློག་མི་ནུས་ན་དེའི་འོག་ནས་༡༧འདུག་པ་ལ་མེ་ཏོག་བྱིན་ཏེ་བྱེད་དུ་གཞུག་གོ།",
    "དེས་ཀྱང་མ་༡༧ནུས་ན་གཉིས་ཀྱི་འོག་ནས་དགེ་སློང་སུ་འདུག་པ་ལ་མེ་ཏོག་བྱིན་ཏེ་ཀློག་ཏུ་གཞུག་ག་གོ།",
    "ཞག་ལྔ་ཞིག་འདིར་འདུག་ཞག་དྲུག་ཅིག་འདིར་ཛོའདུག་གོ་ཞེས་ཟེར་ཞིང་གནས་ག་ཅིག་ཏུ་མ་བཅད་པར་མནོད་པར་མི་བྱའོ།",
    "འདུག་པའི་ཁྲི་ཆེན་པོ་རྒྱབ་རྟེན་ཅན་དང་ཁྲི་ཆུང་ངུ་ཡང་བགོའོ་༤།",
    "བྱིས་པའི་སྐྲ་རལ་བུར་འདུག་འདུག་པ་ལས་འདྲེག་པའི་ཚེ་བཀྲ་ཤིས་ཀྱི་ཕྱིར་འབོད་པ་དང་།",
    "མུར་འདུག་ཏུ་ལྟ་བ་དབྱེ་བའི་ཕྱིར་དང་།",
    "གྱི་ན་མི་སྨྲ་བར་འདུག་༐",
    "འདོམ་གང་ཙམ་དུ་འདུག་ལ་དགུས་༢ཏེ་བཟོད་པ་བགྱིར་ཅི་གནང་ཞེས་གསོལ་ལ་ལོ།",
    "རས་སང་སེང་དུ་འདུག་ཅིང་ཐགས་བཟང་ངན་དུ་འདུག་པ་དང་།",
    "དགེ་སློང་སོ་སོའི་མདུན་དུ་འདུག་སྟེ་གདིང་ངོ་ཞེས་བྱའོ།",
    "དེ་བས་ན་དད་པ་མ་བྱིན་པ་ཉལ་ལམ་བསམ་གཏན་དུ་ཞུགས་ཤིང་འདུག་ན་གདིང་བའམ་དབྱུང་བ་མི་སྐྱེ་སྟེ་བརྙན་ཚུན་ཆད་དུའོ།",
    "ཉེས་མེད་པ་ནི་བཏིང་བ་དྲུབས་ནས་སྦྱར་མ་མེད་པར་གྲོང་དུ་འཇུག་པ་ལ་སོགས་ཏེ་མངོན་སུམ་དུ་འདུག་པས་༡༧ཡང་ངོ།",
    "གཙུག་ལག་ཁང་ག་ཅིག་ན་དགེ་སློང་ག་ཅིག་པུ་འདུག་པ་ལས་ཡོན་བདག་དད་པས་ཡོན་མང་ཞིག་༢ཕུལ་ན་དགེ་སློང་ག་ཅིག་པུ་དེས་ཁྱེར་ཡང་ཉེས་མེད།",
    "མཚམས་ཀྱི་བར་ན་འདུག་པ་ལུས་ལ་ཆགས་པའམ་གཞན་ཡང་ཇི་སྙེད་དུ་ཆུད་པ་དེ་གཏོགས་ས་སོ།",
    "དགེ་སློང་ཤི་བའི་ནོར་ཁྱིམ་ཅ་པ་ལ་གཏམས་ཤིང་འདུག་པ་ལས་དགེ་སློང་ཕོངས་པས་བླངས་ཏེ་བྱིན་ན་ནི་ཉེས་མེད་དོ།",
    "པོ་འདིའི་སྟེང་དུ་༡བདག་ཀྱང་མི་འདུག་གཞན་ཀྱང་མི་གཞག།",
    "དགེ་སློང་གུད་དུ་འགྲོ་ན་བདག་འདུག་འདུག་པའི་གནས་ཕྱག་དར་དང་ཆག་ཆག་ལ་སོགས་པ་བྱས་ཏེ་འགྲོ།",
    "གསང་༡༧བའི་ཕྱོགས་སུ་སྒྲ་བསྐྱུངས་༡༡ཏེ་མཛེས་ཤིང་རབ་ཏུ་བསྡམ་༡༧པའི་སྤྱོད་པས་ས་སོ་། ༐འགྲེངས་ཏེ་༡༧འདུག་པ་ནི་ཀུན་གྱིས་མཐོང་ཞིང་གསལ་བའི་ཕྱོགས་སུ་སྒྲ་བསྐྱུངས་ལ་མཛེས་ཤིང་ཚུལ་བསྡམས་ཏེ་གཏོགས་འདོད་དང་ཤེས་འདོད་མི་བྱ་བར་འདུག་གོ།",
    "མུར་འདུག་ངོ་ཤེས་ཤིང་གཡོ་མི་བྱེད་པ་ཞིག་འོངས་ན་འང་ངལ་སོར་གཞུག།",
    "སྟོད་ཏྲ་༩བྱ་བ་ནི་དགའ་བར་བྱ་བའི་ཕྱིར་ཀུན་གྱིས་མཐོང་བར་ས་མཐོན་པོར་འདུག་སྟེ་བྱའོ།",
    "དེ་ལྟ་བུའི་རྐྱེན་མེད་ན་མ་བཅད་པར་གྲོང་དང་ཁྱིམ་དུ་འཇུག་པ་དང་འདུག་པ་མ་ཡིན།",
    "ཡོད་ན་འདུག་པར་མ་ཡིན།",
    "ཡུལ་གཞན་དུ་འདུག་པ་ལ་བརྟགས་ན་མི་འཇིག།",
    "དེའི་ཕྱིར་བསྙུང་༡༧བུ་དང་གླ་༡རྒྱུན་བ་ཅངས་ཡན་མན་ཡུལ་རྒྱུ་༡༧བའམ་གནས་ན་འདུག་པའང་༡༧རུང་ལྷམ་རལ་ན་བཙེམ་པའི་ཕྱིར་གླ་༦རྒྱུན་དང་བསྙུང་༢བུ་བཅང་བཟོ་གྲི་མ་ཡིན།",
    "གྲོང་དུ་གཞན་མེད་ན་པགས་པ་ལ་འདུག་༡།",
    "དམ་ཞེས་སྨྲོས་༡༨ཏེ་སྟན་གཞན་མེད་ཅེས་ཟེར་ན་པགས་སྟན་ལ་འདུག་ཀྱང་ཉེས་མེད་དོ།",
    "མཐོ་རིས་ཀྱི་ཁམས་ན་འདུག་པ་ཞིག་སྟེ་འདི་ཡང་མར་དུ་གཏོགས་ཏེ་ཞག་བདུན་པའོ།",
    "གཏར་ག་༡༧གདོད་ལ་བྱ་ན་རྩ་ག་ལ་འདུག་པའི་སྟེང་དུ་བྱས་པ་ནི་ཉེས་མེད་ད་དོ།",
    "གནས་བརྟན་གྱིས་བརྗེད་ན་དྲུང་ན་སུ་འདུག་པས་ཀྱང་དྲི།",
    "ལྟག་ཏུ་ཤ་བཟར་མི་རུང་བའི་རྣམས་དང་འོ་མ་རྣམ་གཉིས་ཟོས་ན་ཉེས་བྱས་སུ་འགྱུར་གྱི་མི་བཟའ་བར་འབྲས་སམ་སྣ་ལ་ཕན་པའི་ཕྱིར་གླན་པ་དང་སྲབ་༡ཅིང་འདུག་པ་ལ་སོགས་པ་ལུས་ཀྱི་ཕྱིར་ལོགས་སུ་སྤྱད་པ་ནི་ཉེས་མེད་དོ།",
    "ཆོག་ཙམ་ཞིག་༢ལོང་ཤིག་སྤངས་ཏེ་ལྷག་༢མ་མི་ཟ་བར་བསམ་༤པ་དེ་སླར་བླངས་ཏེ་ཟོས་ཀྱང་ཉེས་མེད་ཟ་བའི་ཚེ་ལངས་ཏེ་ཡང་འདུག་ནས་ཟོས་ཀྱང་ཉེས་མེད་དོ།",
    "ཟན་བཟའ་བར་ས་ལ་འདུག་སྟེ་ཟོས་༐",
    "གྲོང་དུ་སློང་བའི་ཚེ་ལམ་སྲང་གྱ་གྱུ་མང་དུ་འདུག་ན་ཐོག་མའི་ལམ་སྲང་མི་ནོར་བར་བསམ་ཞིང་། ༐",
    "རྩྭའི་༡ཐུམ་པོ་ལ་འདུག་ཀྱང་རུང་དགེ་སློང་སྟན་མེད་ན་རྩྭའི་ཐུམ་པོ་ལ་འདུག་ཀྱང་ཉེས་མེད་ད་དོ།",
    "དགེ་སློང་རྒན་པོ་དང་གཞོན་ནུ་དང་དགེ་སློང་ཞིག་༡༧འདུག་ན་འདྲིམ་པ་ལ་མཉམ་པའི་ཕྱིར་སོ་སོར་བཀང་དུ་བཅུག་ལ་ཞལ་ཏ་བ་མང་དུ་བསྐོས།",
    "དགེ་སློང་མ་ཚར་ག་ཅིག་ཏུ་བཀང་ན་ལྟག་ཏུ་སྟན་རིམ་པ་གཉིས་གསུམ་བོར་ལ་འདུག་པར་བྱའོ།",
    "ཟས་བཟའ་བའི་ཚེ་གྲོང་དང་གཙུག་ལག་ཁང་འདྲ་སྟེ་ཅ་ཅོ་མེད་པར་སྒྲ་བསྐྱུངས་ཏེ་འདུག།",
    "སྟན་ལ་འདུག་པའི་ཚེ་གོང་མ་རྣམས་བཞུགས་ལ་འདུག་གོ།",
    "དེར་ཆུད་པ་བཞིན་དུ་གཞན་གྱིས་སྤྱན་དྲངས་ཏེ་འདུག་པ་ལས་དེས་གནང་ནས་གཞན་གྱིས་བྱིན་ན་ནའོ།",
    "ཟ་བའི་ཕྱིར་འདུག་པ་ལ་འདི་དང་འོ་༐",
    "ཉེས་མེད་པ་ནི་ཟ་གུ་སྟེ་ཐ་མར་ཕྱིས་མཚམས་ཏེ་འདུག་ཀྱང་ང་ངོ།",
    "དེ་ལས་གཞན་གྱི་༩ཆུ་ཡོད་ན་མ་བཀྲུས་པར་མི་འདུག།",
    "ཁ་རོག་ཏུ་འདུག་ཅེས་པ་ཡན་ཆད་ད་དོ།",
    "འཁོར་དུ་མ་འདུག་ན་མ་རྫོགས་པའོ།",
    "འདུག་པ་ལས་ལས་ཀྱི་མགོ་བརྩམས་ཏེ་མ་ཟིན་པར་གྲལ་ན་ཉི་༐",
    "གང་ཟག་ལ་འབུལ་བ་༡༧ན་ཚིག་ལན་གསུམ་བཟླས་ཏེ་སྨྲ་མདུན་༡༧དུ་ཙོག་ཙོག་པོར་འདུག་པ་ལས་ཏེ་བཏང་བ་ཡང་ངོ།",
    "གསོལ་བ་བྱེད་ཅིང་ལས་པའི་དགེ་སློང་དང་རབ་ཏུ་བྱུང་བ་གཉིས་ཀ་ཙོག་ཙོག་པོར་འདུག་པ་༡ལ་གསོལ་བ་དང་ཞུ་བ་དང་བར་ཆད་དྲི་བ་བྱ།",
    "ལས་ནི་འདུག་སྟེའོ།",
    "བསྔོ་བ་དང་བརྟག་པ་གཉིས་གུད་ན་བཞག་ལ་བདག་འདི་ན་འདུག་པས་སྔགས་གདབ་ཏུ་མི་རུང་ངོ།",
    "ཚུལ་ནས་འབྱུང་འཇུག་དང་བརྟག་པ་དང་བསྔོ་བ་ལ་སོགས་པའི་སྔགས་གྲོགས་ག་ཅིག་དང་གཉིས་འདུག་ལ་སྔགས་གདབ་པའི་ཚེ་བདག་༥པས་ན་རྒན་པ་ཞིག་ཡིན་ན་ཕྲག་པ་གཡས་པ་ཕྱུང་ལ་གུས་པའི་ཚུལ་དུ་ལས་བྱའོ།",
    "དགེ་སློང་གོས་བདག་པོས་ནི་དྲུང་ན་འདུག་༐",
    "མཚམས་བ་ཅད་པ་གང་ཚུན་ཆད་བཅད་པའི་ཕྱི་རོལ་དུ་འདུག་སྟེ།",
    "དེ་བཞིན་དུ་གང་ཟག་བཅུ་གཉིས་ཀྱི་ལས་སུ་བསྐོས་པ་༡༧ཡང་མཚམས་ཀྱི་ནང་དུ་འདུག་ལ་བྱའོ།",
    "འདུག་པར་བྱེད་པས་འདུག་པར་བསྒོ་སྟེ་གཎྜཱི་བརྡུཊྭངུས་པ་དང་དྲིས་སྨྲོས་ཤིག་བསྒོ།",
    "མཚམས་གཞན་དུ་འདུག་༡༧པ་ནི་གང་དུ་ཡང་ཡན་ལག་མ་ཡིན་ན་ནོ།",
    "གཉིས་སུ་འདུག་པ་ནི་ཚུ་ལོགས་སུ་རྐང་པ་༡༧ག་ཅིག་ཕ་ལོགས་སུ་རྐང་པ་ག་ཅིག་ཅིག་ནའོ།",
    "ཀུན་སྤྱད་མི་ནུས་ན་བདག་གར་དགའ་བར་འདུག་ལ་སྤྱོད་ཅིག།",
    "མུར་འདུག་དང་བསྟེན་པ་༧འདི་གཉིས་ལ་ཡན་ལག་ག་ཅིག།",
    "མཚམས་གཞན་དུ་འདུག་པ་ལ་ཡང་ང་ངོ།",
    "དགེ་སློང་གྲོགས་ལ་བསྔོ་བ་གྲོགས་ནམ་མཁའ་ལ་འདུག་གམ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་ལ་བདག་མཚམས་ཀྱི་ནང་ངམ་ས་ལ་འདུག་པས་༐",
    "འདུག་ན་བཅང་།",
    "ཁས་ཕུབ་༥པའི་ཁྱིམ་དུ་ནོར་ཏེ་ཕྱིན་ནས་སྟན་ལ་འདུག་ཅེས་ཟེར་ཀྱང་མི་འདུག།",
    "དགེ་སློང་རང་བཞིན་ཉམས་ཏེ་སྨོས་པའི་ཚེ།",
    "ལྷག་མ་བྱས་ནས་བདག་འཁོར་དུ་མཐོལ་དུ་དགེ་སློང་གྲོགས་མེད་དེ་རྒྱང་གྲགས་ག་ཅིག་གཉིས་ཕན་ཆད་ག་ཅིག་ན་དགེ་སློང་འདུག་ལ་ག་ཅིག་ལ་མཐོལ་དུ་འགྲོར་ལམ་དུ་ཆུས་ཆོད་དེ།",
    "ལྷག་མར་གྱུར་པའི་འོག་ན་ཉེ་འཁོར་དུ་མཐོལ་དུ་ནི་དགེ་སློང་མེད་རྒྱང་ཏྲ་གྲགས་གཉིས་གསུམ་ཙམ་གྱི་དགེ་སློང་འདུག་པ་ལ་ནམ་ཕྲད་པ་ན་མཐོལ་བར་བསམས་ཏེ་སེམས་ལ་བཅབས་པའི་སེམས་མེད་༡ན་ལེ་ལོ་བྱས་ཏེ་མྱུར་དུ་མ་མཐོལ་ཀྱང་བཅབས་པར་མི་འགྱུར།",
    "ཆད་པ་པ་སྟན་མཐོན་པོ་ལ་བཞག་སྟེ་ཆད་པ་མེད་པ་སྟན་དམའ་བ་ལ་མི་འདུག།",
    "མུར་འདུག་སེམས་བརྟག་༡༧པའི་ཕྱིར་ཟ་༡༧བ་ག་ཅིག་ཏུ་གཞག་པའང་ལྷན་ཅིག་ཏུ་ཉལ་ན་ཉེས་མེད་དོ་ཞེས་བྱི་ཛ་ཡས་བཤད།",
    "ལམ་སྲང་ངམ་གྲོང་བར་ན་འདུག་ན་བྱོལ་༢ཏེ་འགྲོ།",
    "དགེ་སློང་གཉིས་ཤིག་རྩོད་ཅིང་འདུག་འདུག་པ་ལས་རྩོད་པའི་འཕྲོ་ལས་ཤིའམ་ཁྱིམ་པར་བབས་ཏེ་ལམ་རིང་པོར་བབས་༥ན་ཞི་བར་འགྱུར་ར་རོ། ༐",
