    "ཉི་མ་གཉིས་པ་ལ་གཞན་ནས་བསོད་སྙོམས་བླངས་ནས་འདུག་གནས་དེར་ཟོས་པ་ལ་ཉེས་བྱས་ས་སོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད། ༐",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "དགེ་སློང་ཟས་༢ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་༤ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "ཟས་སྤངས་པ་ཉིད་ཅེས་བྱ་བ་ནི་དགེ་སློང་ཟས་བརྩམས་པས་འདུག་པའི་གནས་བཏང་བ་སྟེ།",
    "དགེ་སློང་ཟས་བརྩམས་པའི་གནས་སུ་འདུག་སྟེ་༨།",
    "ཆོག་གོ་ཞེས་བྱ་བ་དག་ལས་གང་ཡང་རུང་བས་བྱིན་ལེན་སྟོབས་པ་དེ་སྤངས་པ་བྱས་ནས་ཟས་བརྩམས་པའི་ཕྱོགས་གང་དུ་སྔར་འདུག་པར་གྱུར་པའི་གནས་བཏང་སྟེ།",
    "འདི་ལ་རྒྱུ་ལྔས་ནི་ཟས་བརྩམས་པས་འདུག་པའི་གནས་༢གཏོང་བར་མི་འགྱུར་ཏེ།",
    "པུ་ར་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྫོད་པར་བྱའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་༢འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་༤དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་ད་གའ་བར་བྱེད་དགའ་མགུར་སྤྱོད་༐",
    "བདག་སློབ་དཔོན་འདིས་རྟག་ཏུ་མདུན་དུ་ཙོག་པུར་འདུག་༐",
    "གྲུར་མ་ཞུགས་པ་དང་༡སོ་སོར་ངེས་པའི་ཟས་ཀྱི་གནས་ཅན་དག་ལས་གཞན་པ་ད་གེ་འདུན་དུ་ལོངས་པའི་ད་གེ་སློང་ཅིག་ཅར་དུ་ཟ་བས་མཚམས་ཀྱི་ན་ང་དུ་ད་གེ་འདུན་གཞིའི་༢འདུག་གན་ས་སུ་ཟ་བ་ལས་ལོགས་ཤིག་ཏུ་འདུག་སྟེ་དུས་སྟོན་ཆེན་པོ་མ་ཡིན་པ་དང་།",
    "ད་གེ་འདུན་གཞིའི་༡འདུག་གནས་སུ་ཟ་བ་ལས་ལོགས་ཤིག་ཏུ་འདུག་སྟེ་ཟ་བ་ལ་ན་སྨད་པ་མེད་ད་དོ།",
    "ཟས་གང་ཡང་རུང་བ་ཆུང་ཟད་ཀྱིས་གཞིའི་༡༧འདུག་གན་ས་སུ་ཟ་བའམ་འདུས་ཤིང་ཟ་བ་གང་ཡང་རུང་བ་༐་",
    "ཟས་གང་ཡང་རུང་བ་ཆུང་ཟད་ཀྱིས་གཞིའི་འདུག་གནས་སུ་ཟ་བའམ་འདུས་ཤིང་ཟ་བ་གང་ཡང་རུ་ང་བ་ཞིག་ལ་མ་བསྲུལ་བ་དང་།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་དུས་མ་ཡིན་པར་བཅའ་བ་དང་ཟ་བར་བྱེད་ཅེས་སྨོད་པར་བྱེད་ཕྱར་ཀ་གཏོང་བར་བྱེད་༢།",
    "བཙོས་པའི་སྣོད་རུང་བ་མ་ཡིན་པའི་ཕྱོགས་ན་འདུག་ན་དེས་ཀྱང་བ་ཙོ་བར་བྱ་བའི་རྫས་དེ་རུང་བ་༨ཡིན་པའི་ས་དེར་བཙོས་པ་ཉིད་ཡིན་པས་ནང་དུ་བ་ཙོས་པ་ཉིད་ཡིན་ནོ།",
    "འཚོད་པར་བྱེད་པའི་མེ་མཚམས་ཀྱི་ནང་རོལ་ན་འདུག་པ་ཉིད་ཀྱིས་བཙོ་བར་བྱ་བའི་རྫས་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་འཚེད་པར་བྱེད་པ་ནི་ནང་དུ་བཙོས་པ་ཉིད་མ་ཡིན་པས་དེ་ལ་ཉེས་པ་མེད་དོ།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་དང་།",
    "བྱིན་ལེན་གྱི་མཚན་ཉིད་ནི་མངོན་སུམ་དུ་མཚམས་ཀྱི་ནང་དུ་འཐོབ་པའི་ཕྱོགས་ན་འདུག་པས་ལག་པ་བ་ཀན་པས་ལུས་སམ་དེ་དང་འབྲེལ་པར་གྱེན་དུ་འདེགས་ནུས་པ་བསྙེན་པར་མ་རྫོགས་པ་༐",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་དང་།",
    "བྱིན་ལེན་གྱི་མཚན་ཉིད་མངོན་སུམ་དུ་མཚམས་ཀྱི་ནང་དུ་འཐོབ་པའི་ཕྱོགས་ན་འདུག་པས་ལག་པ་བཀན་པས།",
    "མཐའ་ག་ཅིག་ཏུ་འདུག་གོ།",
    "དེང་ལ་ལྷག་རོལ་ཆུང་ཟད་ཅིག་གདའ་བ་དེ་བྱིན་ཅིག།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "བཞིན་བཟངས་མིག་ལམ་ན་མ་འདུག་ཤིག་༡༨ཅེས་བཇོད་པར་བྱའོ།",
    "ཁ་ཟེར་བར་བྱེད་ནས་༩དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་༡བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཉེས་པ་ནི་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པའོ།",
    "མངོན་སུམ་དུ་བརྣག་པས་འདུག་པ་༤ལ་ན་སྨད་པ་མེད་དེ་༥།",
    "མངོན་སུམ་དུ་བརྣག་པས་འདུག་པའོ།",
    "དགེ་སློང་དེར་མངོན་སུམ་དུ་བརྣག་པས་འདུག་པའི་ལྟ་བ་དང་ཉན་པ་སྤྲོད་པར་བྱེད་པ་གཉིས་ཀྱི་གནས་ལས་གཞན་པའི་གནས་ལ་སེམས་གཏོད་པ་ལ་ཉེས་བྱས་སོ།",
    "དབེན་པར་བརྣག་༤པས་འདུག་པ་ལ་ཉེས་བྱས་སོ།",
    "དེ་ན་དགེ་སློང་འདུག་པ་ཡིན་ན་ཡང་།",
    "བྱེ་བྲག་ཏུ་ན་སྔ་མ་ནི་མངོན་སུམ་དུ་བརྣག་༦པས་འདུག་པའི་ཡུལ་ལ་རྣམ་པར་གཞག་ག་གོ།",
    "ཤེས་པ་ཅན་དགེ་སློང་དག་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་ཅིག་དང་།",
    "དེ་དེར་འདུག་པ་དང་དགེ་སློང་རྣམས་ཀྱིས་དེ་ལ་ལྷུང་བྱ་བཟེད་ཀྱི་ལྷག་མ་བྱིན་ནས་དེའི་སློང་ཕོར་ཁུར་བས་བྱུར་བུར་བྱས་སོ།",
    "རི་བྲགས་པ་དེ་དེ་ལྟ་ན་ཡང་མི་༦ཕེབས་ནས་རྒྱལ་པོས་དེ་ཉིད་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་༧འདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།་",
    "དེའི་ནང་ན་གནས་པའི་ཚེ་༢ཡང་ཞེས་བྱ་བ་ནི་འདུག་པའི་ཚེ་ཡང་ང་ངོ།",
    "དབུས་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "རྒྱབ་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "དབུས་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "མདུན་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "སྨྲ་འམ་འདུག་པ་༢བདེ་བ་མ་ཡིན་གྱི།",
    "རི་བྲགས་དེ་ནས་བྱིས་པ་ཁྱེའུ་གཉིས་ཤིག་ལམ་ཀར་འོངས་ཏེ་རྩེ་ཞིང་འདུག་ག་གོ།",
    "བོང་དྲུག་༢དང་ཉེ་བ་ཞིག་ན་སེང་གེ་རལ་པ་ཅན་ཅོད་པན་ལྟ་བུ་དང་ལྡན་པ་ཞིག་འདུག་པ་དེས་ཕྱིར་ལོག་༢༢ཅིང་དབུགས་ཕྱུང་སྟེ།",
    "འགྱུར་བ་༡༧ན་དགེ་སློང་གླེང་བ་པོ་རྒན་པའི་མཐའ་ལོགས་སུ་འདུག་སྟེ་ཉེ་དགའ་ལ་སྨྲས་པ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ་༡༧།",
    "འདུག་༡༧ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེས་རྙེད་པ་ཐམས་ཅད་དེ་དག་ལ་བྱིན་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་ག་གོ།",
    "སྣ་མའི་མེ་ཏོག་དག་ཐོགས་ཏེ་བཅོམ་ལྡན་འདས་ལ་གཏོར་ཏེ་མཐའ་ག་ཅིག་༨ཏུ་འདུག་གོ།",
    "དེ་ལྟ་བས་ན་༡ཀུན་དགའ་ར་བར་གཏོགས་པ་ན་༢འདུག་པའམ།",
    "གནས་ཁང་དུ་གཏོགས་པ་ན་༢འདུག་པ་མ་གཏོགས་ས་སོ།",
    "ཀུན་ད་གའ་ར་བར་གཏོགས་པ་ན་འདུག་པའམ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བའི་ཕྱི་རོལ་ནའོ།",
    "གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བའི་ནང་ནང་ནའོ།",
    "མ་གཏོགས་ཏེ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བར་གཏོགས་༢པ་ན་འདུག་པའམ།",
    "གནས་ཁང་དུ་༤གཏོགས་པ་ན་འདུག་པ་བཞག་སྟེའོ།",
    "གཙུག་ལག་ཁང་དང་དེའི་ཉེ་འཁོར་ན་འདུག་པ་མ་ཡིན་པ་ཉིད་༐",
    "༨ཁྱིམ་པའི་ཁྱིམ་དུ་ཁྱིམ་པས་གཤེགས་༩པ་ན་གསེར་དང་དངུལ་གྱི་སྤྲས་༡༧པ་དྲིལ་བུ་གཡེར་ཁས་གཤིབས་༡༧པའི་གོས་དག་ལ་ཁྱིམ་པའི་ཡིན་ནོ་སྙམ་དུ་འདུ་ཤེས་བསྐྱེད་ནས་འདུག་པར་བྱའོ།",
    "ལས་གཉིས་ཀྱིས་༡༨ཁྲུས་བྱ་བར་བརྩམས་ཏེ་བཞིས་གྲོགས་བྱེད་ཅིང་འདུག་གོ།",
    "ལུས་དང་དེ་དང་འབྲེལ་པ་དང་འཕངས་པ་དང་གཞན་ཡང་རང་ལ་བསྒོ་བ་ལ་ན་སྨད་པ་མེད་ད་དོ།",
    "དུག་དང་ཕྱེ་མ་དང་དོང་དང་ཤིང་དང་རང་བཞིན་ཉམས་པ་གཏོང་༤བ་དང་བྲང་དུ་འདེབས་པ་དང་འཁྲུལ་འཁོར་དང་སྒྱུ་ཐབས་དང་རོ་ལོངས་༥དང་རྗེས་སུ་སྦྱོར་བ་རྣམས་ལ་ན་སྨད་པ་མེད་དོ་། གཡང་དུ་གཏོང་བ་དང་མེ་དང་ཆུར་འཇུག་པ་དང་གྲང་བ་དང་ཚ་བར་བྱ་གཏོགས་༡པ་དང་འཆི་བའི་ཕྱོགས་སུ་གཏོང་བ་ལ་ན་སྨད་པ་མེད་དོ།",
    "ཚེ་དང་ལྡན་པ་དག་འདི་ག་ཅིག་པུ་ཕར་རྒྱུག་ཚུར་རྒྱུག་ཅིང་འདུག་ན་འུ་བུ་ཅག་ལས་སུས་ཀྱང་འདིའི་གྲོགས་མ་བྱས་སམ།",
    "བྱ་བ་༡ན་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "རྒྱལ་པོ་སྐྱེངས་ནས་ཅང་མི་སྨྲ་བར་འདུག་ག་གོ།",
    "ལྷས་དེ་ནི་གསན་ན་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་ན་ངས་དགེ་སློང་འདུག་པ་ན་འདོད་ཆགས་དང་བཅས་ཞེ་སྡང་དང་བཅས་གཏི་མུག་དང་བཅས་པར་མཐོང་ལ།",
    "རྒྱལ་པོ་ཐོས་པ་ཉུང་བས་དེ་ཅང་མི་སྨྲ་བར་འདུག་ག་གོ།",
    "བསྲངས་ཏེ་༡དྲན་པ་ཕྱོགས་པར་བཞག་ནས་འདུག་གོ།",
    "དེའི་༡༧ཕྱི་དེ་ཉིན་པར་ལུས་དག་འབྲུ་མར་གྱིས་༡༨བསྐུ་མཉེ་བྱས་ནས་ཁྲི་ལ་ཉལ་ཞིང་འདུག་པ་དང་།",
    "མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པ་དང་།",
    "ས་ཞེས་བྱ་བ་ནི་ས་གཉིས་ཏེ་རང་བཞིན་ཅན་དང་རང་བཞིན་ཅན་མ་ཡིན་པའོ།",
    "དེའི་མགོ་ལ་ནོར་བུ་འདུག་པ་དེ་སློངས་༡༧ཤིག་དང་།",
    "དྲང་སྲོང་དེས་དེ་བཞིན་བྱས་པ་དང་ཀླུ་གཞོན་ནུ་དེས་ཕ་མ་ལ་དྲིས་ན་ཡང་ནོར་བུ་སྦྱིན་དུ་མི་རུང་ངོ་ཞེས་ཟེར་ནས་ཕྱིན་ཆད་མི་འོང་ཞིང་མི་སྣང་བའི་ལམ་ལ་འདུག་པར་གྱུར་པ་དང་།",
    "འཕགས་པ་དག་དུས་ཀྱིས་༡༧མགྲོན་དུ་བོད་དོ་ཞེས་ད་ཟེར་བའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བ་ཅོམ་༡ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "༥པེ་སྣར་ཞིག་འདུག་པ།",
    "༡པེ་སྣར་འདུག་པར།",
    "༦པེ་སྣར་འདུག་གོ།",
    "གླུ་དང་གར་ལ་མཁས་པའི་མི་རིགས་ཤིག་ཡིན་ཙ་ན་ཀུན་གྱིས་གླུ་གར་གྱི་རྒྱ་མཚོ་ཞེས་པའི་མཚན་སྙན་གྱི་ཆོ་ལོའ་གནང་ཡོད་པ་དང་།",
    "མཐར་མཁའ་ལྡིང་བཏུལ་བའི་གཏམ་རྒྱུད་བརྗོད་བྱར་བྱས་འདུག་ལ།",
    "བྲག་སྟོང་འདི་ཚོ་ཐག་རྙི་ཁྲ་བོ་ཡིས་བསྐོར་ཡོད་ཐང་དཀར་རྒོད་པོ་ཁོ་ལ་འགྲོ་ས་ཨེ་འདུག་ལྟོས་ཤིག།",
    "རྒྱལ་པོའི་དབུ་ལ་རྨོག་ཆེན་བཞེས་ཙ་ན།",
    "རྒྱལ་པོའི་སྐུ་ལ་སྟག་དོང་གསོལ་ཙ་ན།",
    "བསམ་བློ་གང་ནས་བཏང་ཡང་འབྲལ་དུ་ཕོད་པ་མི་འདུག་རྟ་དང་རྟེའུ་འཕྲུལ་ཡང་རྟ་ར་ཕན་ཚུན་ཡིན་འདུག་ང་དང་རྒྱལ་པོའི་བར་དུ་ལ་ལུང་མང་བོས་བཅད་འགྲོ།",
    "བལྟས་པས་མཐོང་ས་མི་འདུག་བོས་པས་ཚོར་ས་མི་འདུག།",
    "ང་དང་རྒྱལ་པོ་ནོར་བཟང་འབྲལ་དུ་ཕོད་པ་མི་འདུག།",
    "མ་ཤི་གསོན་བྲལ་བྱེད་པ་ང་མིན་གཞན་ལ་མི་འདུག།",
    "དགྲ་བོ་དགའ་ཞིང་རང་ཉིད་བརླག་པ་ཡི།",
    "བར་ན་ཆུ་ཕྲན་འབབ་པ་ཞིག་འདུག་རྒྱལ་བུ་རི་དེ་ལ་ཕེབས་པ་ཙམ་གྱིས་ཤིང་སྐམ་པོ་ལ་ལོ་འདབ་རྒྱས་པ།",
    "བཙན་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་སྐུ་རིང་ལ་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན་དང་ཤེའུ་ལོ་ཙཱ་བ་གཉིས་ཀྱིས་རྒྱུ་གྱུར་ནས་བོད་སྐད་དུ་བསྒྱུར་པར་གྲགས།",
    "བར་དུ་མི་བསད་དེ་བེམ་རོ་གཟུགས་ཀྱི་ཉི་མའི་སྔས་མགོར་ཁྱེར་ནས་ཁོག་སྟོད་གཡས་དང་ཁོས་སྨད་གཡོན་དུ་བཞག་ཁ་ནས་ཁྲག་འཛགས་ཚུལ་བྱས་འདུག་པ་ལ།",
    "གསེར་གྱི་ཉ་ཆུང་རྒྱུ་བ་འདུག།",
    "རྒྱལ་པོ་ཟླ་བ་སེང་གེ་ལ་ཟེར་བུར་འདུག་ལྟ་གསུམ་བར་དུ་འཕེལ་ཞེས་པ་འདི་ནི།",
    "ཟླ་བ་ཡར་ངོའི་ཚེས་བཅོ་ལྔ་ལ་ཟེར་བར་འདུག་བཅུ་བཞིའི་ཐོ་རངས་ཉི་མས་བཟུང་ཞེས་པ་དེ།",
    "དེའི་ཉི་མ་ནི་གཟུགས་ཀྱི་ཉི་མ་ལ་ཟེར་བ་ཡིན་པར་འདུག་ཁྱབ་འཇུག་ལ་མགོན་སྐྱབས་བཅོལ་ན་ཟེར་བ་དེ།",
    "མཛའ་བའི་གྲོགས་ལ་ཕྱི་ཐག་ཅི་ཞིག་འདུག།",
    "གསར་འགྲོགས་ཅན་ལ་ཁྲེལ་གཞུང་ཅི་ཞིག་འདུག།",
    "པོའི་སྐུ་མདུན་དུ་ཁྲིད་ཙ་ན་གྲོངས་སོ།",
    "༥ དཔོན་པོ་སྒྲ་ཆེན་བཀའ་དྲིན་དྲན་ཙ་ན།",
    "གྲགས་པ་བསམ་གྲུབ་ཞལ་ལ་བལྟས་ཙ་ན།",
    "ལྷའུ་དར་པོའི་ངོ་ལ་བལྟས་ཙ་ན།",
    "དགྲ་མི་རྟག་འཆི་བ་བྱུང་ཙ་ན།",
    "འདུག་པས།",
    "བུ་དེ་མེད་པའི་ཐབས་ཤིག་མ་བྱས་ན་དེ་ནི་ང་ཡི་གོང་ལ་ཤོར་ཉེན་འདུག་སྙམ་ནས།",
    "ཆུ་ཞིག་དེ་ཕྱིར་ཨ་ཇོ་ཆུ་ཞིག་འཚོལ་གྱིས་སྐུ་མཆེད་གཉིས་ལ་འདྲེ་སྲིན་གཅན་གཟན་རྣམས་གྲོགས་དང་སྒོ་ཁྱིའི་ཚུལ་དུ་འདྲིས་ནས་གནོད་པར་མ་གྱུར་ཏོ།",
    "བྱོན་པས་ལུང་བ་ཆུ་མེད་པ་ཞིག་ཏུ་ཕེབས་ནས་གཅུང་བོ་འབྱོན་མ་ཐུབ་ཀྱང་ཨ་ཇོས་སྐུ་རྒྱབ་ཏུ་བསྣམས་ནས་རྒྱང་ཕྲག་བདུན་གྱི་བར་དུ་བྱོན་ཀྱང་ཆུ་མ་བྱུང་བས།",
    "ད་ལྟ་གར་བཞུགས་ཟས་སྐལ་འདི་ན་ཡོད་ཅེས་སྐད་འདོན་བཞིན་འདུག་པས་རྒྱལ་པོ་དོན་གྲུབ་ཐུགས་ལྷག་པར་སྐྱོ་སྟེ་སྤྱན་ཆབ་འདོན་བཞིན་དུ་འདི་ལྟར་གསུངས་སོ།",
    "ཨ་ཇོ་དོན་གྲུབ་ད་ལྟ་འདི་ན་ཡོད་ཅེས་གསུངས་པ་དང་གཅེན་གཅུང་གཉིས་མཇལ་བར་གྱུརདེར་བདུད་བློན་ཏྲི་ཤུ་དོན་གྲུབ་རྒྱལ་ཚབ་ཏུ་བསྐོས་པ་ལ་མི་དགའ་བར།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མའི་མཚན་རྟགས་དང་ལྡན་པ་ཞིག་འདུག་པས།",
    "རྩྭ་ཕུང་རི་རབ་ཙམ་དུ་ཚིག་པ་འདུག་ཆུ་ནི་ཆུང་ངུའི་དུས་སུ་མ་བཀག་ན།",
    "ལྷ་སྲས་ཀྱི་སྐུ་རུས་དང་དབུ་སྐྲ་ཅི་ཡང་མི་འདུག་སྐྲ་ཐུང་བ་དང་རུས་པ་ཆུང་བ་རྣམས་ཁུར་ནས།",
    "དེར་བྲམ་ཟེ་སྒོམ་ཆེན་པ་གཅིག་འདུག་པ་དེའི་དྲུང་དུ་ཕྱིན་ཏེ།",
    "ཡུན་རིང་མི་སྡོད་མྱུར་དུ་འཆི་དགོས་འདུག་ཉིན་གྱི་དུས་སུ་སྣང་སྟོང་དབྱེར་མེད་སྒོམས།",
    "འདུག་ཏུ་བཅུག་པ་སོགས་ཀྱི་ངན་སྦྱོར་བྱས་པས།",
    "གཞན་རྣམས་ཀྱིས་འཐུང་ལོག་བྱས་པས་བཟི་ཞིང་སྐྱུགས་ཏེ་བོ་འདུག་ལ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྦྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲད་རྣམས་ཏེ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར།",
    "གང་ཞིག་མ་སྤྱད་ཕྱེད་ཀྱི་ཆུ་ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ལག་པའི་རྒྱབ་ཀྱིས་སོད་ཅིག་ངེས་པར་རབ་ཏུ་བརྗོད་དེ་མངོན་དུ་ཕྱོགས་པས་འདུག་ཅིག་འདུག་ཅིག་གོ།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོ་རང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀཾ་ད་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སཾ་དང་འདིར་ནི་ཋྐ་ཉིད་དོ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར།",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "འཁོར་རྣམས་ལ་རང་རང་གཙོ་བོས་དབུ་བརྒྱན་པར་གྱུར།",
    "པྲ་བརྟག་པ་ནི་འཁོར་ལོའི་དབུས་སུ་འདུག་སྟེ་ཁ་ཕྱིར་བལྟ་བས་བྱང་ཤར་གྱི་མཚམས་སུ་ཕྱི་མཐར་དཀར་པོ།",
    "སླར་ཁྱེད་རང་རྣམས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐར་གསལ་ཐོབ་ཅིག་འཇིག་རྟེན་ཁམས་ནི་ཐམས་ཅད་དུ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་ཆེན་པོའི་ཤར་སྒོ་ཕྱེས་པ་ནས་ཞུགས་ཏེ་ཤར་གྱི་ལྷ་སྣམ་ལ་གནས་པས།",
    "ཁྱེད་རང་རྣམས་རྡོར་དྲིལ་འཁྱུད་སྟངས་ཀྱིས་འཛིན་པ་དང་ལྷན་ཅིག་བཅོམ་ལྡན་འདས་མི་བསྐྱོད་དགྱེས་པ་རྡོ་རྗེ་ཡབ་ཡུམ་གྱི་སྐར་གསལ་བ་ལ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ལེགས་པར་གསན་པས་ཁྱབ་པར་གདའ།",
    "དངོས་གྲུབ་ཀྱི་ལྟས་བརྟགས་པའི་ཆེད་དུ་ཁྱེད་རང་རྣམས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་རྐང་པ་གཉིས།",
    "སློབ་དཔོན་གྱིས་བསྐོར་ཏེ་མེར་འདུག་ལ་ཤར་གྱི་ལོགས་ཐིག།",
    "པྲ་བརྟག་པ་ནི་འཁོར་ལོའི་དབུས་སུ་འདུག་སྟེ་ཁ་ཕྱིར་བལྟ་བས་བྱང་ཤར་གྱི་མཚམས་སུ་ཕྱི་མཐར་དཀར་པོ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས།",
    "སླར་ཁྱེད་རང་རྣམས་རྣམ་པར་སྣང་མཛད་དུ་སྒོམས་ཤིག།",
    "དེ་ལྟ་མི་འཐད་རང་རང་གཞུང་།",
    "པྲ་བརྟག་པ་ནི་འཁོར་ལོའི་དབུས་སུ་འདུག་སྟེ་ཁ་ཕྱིར་བལྟ་བས་བྱང་ཤར་གྱི་མཚམས་སུ་ཕྱི་མཐར་དཀར་པོ།",
    "ཁྱེད་རང་རྣམས་རྣམ་པར་སྣང་མཛད་དུ་སྒོམས་ཤིག།",
    "དེས་ན་ཡི་གེ་འདི་རྣམས་ཀྱིས་གཞན་ལ་ཕན་པ་འདི་འགྲུབ་སྙམ་པ་ཅི་ཡང་མི་འདུག་ཀྱང་ད་ལམ་དཔེ་རྣམས་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ནས་དེབ་ཆུང་འགའ་ཞིག་ཏུ་བྱས་པ་ཡིན།",
    "མི་འབུམ་ཚོ་བློ་གསར་ཡིད་ཀྱི་དགའ་སྟོན་ལས་སྐྱེ་བ་སྔ་ཕྱིའི་རྣམ་གཞགགཉིས་ཙམ་གྱི་ཚེ་སྲོག་དུས་གཅིག་ལ་བརླགས།",
    "དེ་ལྟ་བུའི་ཀླད་ཆེན་མེད་པའི་མི་ད་སྔོན་དངོས་སུ་མཐོང་ཟིན་པ་ཡང་བཅུ་ཕྲག་འགའ་ཞིག་བྱུང་ཡོད་འདུག་གོ།",
    "དམུས་ལོང་རྣམས་ཀྱིས་གླང་ཆེན་གྱི་གཟུགས་སྨྲས་ཚུལ་གསུངས་པ་ཇི་བཞིན་དུ་བྱུང་འདུག་སྟེ།",
    "སྔོན་གནས་རྗེས་དྲན་གྱིས་བྱུང་བ་རྣམས་གྲངས་དང་སྤུས་ཚད་གཉིས་ཀ་ཇེ་མང་ཇེ་བཟང་དུ་འགྲོ་བར་འདུག་པས་མི་རྣམས་ལ་སྐྱེ་བ་སྔ་ཕྱི་འདི་ཡོད་ལས་ཆེ་སྙམ་བྱེད་དུ་འཇུག་པ་ཙམ་ཡིན་ནོ་ ཞེས་དང་།",
    "རྒྱུན་མི་འཆད་པའི་ཚེ་སྲོག་དེ་ཡོད་པ་ད་དུང་འགོག་ཐབས་མི་འདུག་གོ།",
    "མིང་འདི་ཡི་གེ་སོ་སོ་ལས་སྒྲ་གདངས་བསྒྱུར་ཚུལ་མི་འདྲ་པ་མང་པོ་བྱས་འདུག་ཀྱང་ཕྱི་ཡིག་ཏུ་འདི་ལྟར་བྲིས་སྣང་།",
    "ཨ་པེས་ཀྱི་དུར་ས་དེ་ལ་ཐུན་མིན་གྱི་མཚོན་རྟགས་ཅི་ཡང་མི་འདུག་ཀྱང་ཁོས་མ་ནོར་མ་འཆུག་པར་དེར་ཕྱིན་ཏེ།",
    "ཡུལ་དེ་གའི་མི་རྣམས་ལ་དེ་འདྲའི་སྲོལ་མི་འདུག་ཀྱང་།",
    "ཐེན་སན་ཉོས་སྒོ་དྲུང་དུ་འདམ་མང་པོ་བསགས་འདུག་པ་ཕྱིར་དབོ་བའི་ཆེད་དུ་ཕྱིན་ཚེ་ཆར་གྱིས་རླན་པའི་ཕུག་པ་རྡིབ་སྟེ་རྡིབ་འོག་ཏུ་ཤི་དེ་ལྟ་ནའང་ཁོས་རང་ཉིད་ཤི་བ་མ་ཤེས་ཏེ།",
    "དེ་འཕྲལ་ཡང་ཨ་ཙི་ངའི་ལག་པ་ཅིའི་ཕྱིར་འདི་འདྲའི་ཆུང་ངུར་གྱུར་ཅེས་ཟེར་བས་དེར་ཡོད་ཐམས་ཅད་ཤིན་ཏུ་སྐྲག་ཅིང་ཧ་ལས་ཏེ།",
    "ས་བྲུ་བའི་སྐབས་གད་པ་རྡིབས་ཏེ་གད་འོག་ཏུ་ཤི་འདུག་པས།",
    "ཁང་བའི་སྒོ་ནི་ཕྱེ་སྟེ་བཞག་འདུག་ནང་དུ་ཕྱིན་པས་མི་གཅིག་ཀྱང་མི་འདུག་ཁང་བའི་གྱང་ལོགས་སུ་གོས་ནག་པོ་འགའ་ཞིག་བཀལ་བ་མཐོང་ནས་རྐུ་སེམས་སྐྱེས་ཏེ།",
    "མི་ཁྱིམ་ཞིག་ཏུ་སྐྱེས་ཏེ་ལུས་ཀྱང་བྱིས་པ་ཆུང་ངུ་ཞིག་ཏུ་གྱུར་ཏེ་གཏམ་སྨྲ་བར་འདོད་ཀྱང་སྨྲ་མི་ནུས་པ་ཞིག་ཏུ་འདུག་འོན་ཀྱང་ལག་མགོ་གཡོན་པ་འདི་ནི་འདི་ལྟར་ཕག་སུག་ཏུ་གྱུར་འདུག་ཟེར་རོ།",
    "ཕྱི་ཉིན་བལྟས་པས་ཇི་ལྟ་བ་བཞིན་འདུག་པ་ཧྲང་ཧེའི་ཏ་ཁྲང་པའོ་ཧྭ་དགོན་གྱི་ཚེ་ཐར་ར་བར་བཏང་སྟེ་ཚེ་ཐར་བྱས།",
    "བརྙན་པར་དེ་ད་དུང་དུའང་འདུག་གོ།",
    "ཚེ་འདིའི་བག་ཆགས་མཐུ་བརྟས་པས་མི་གསལ་བའམ་བརྗེད་འགྲོ་བར་འདུག་གོ།",
    "དེའི་ཚེ་ཇི་འདྲ་འདུག་པ་དྲིས་ན་ཐམས་ཅད་ཇི་བཞིན་དུ་ལན་འདེབས་སོ།",
    "དེ་ལ་གཉིད་འབེབས་བྱས་པས་འཛམ་གླིང་གཡུལ་ཆེན་གཉིས་པའི་སྐབས་སུ་ཁོང་རང་འཇར་མན་གྱི་གནམ་དམག་འཕུར་བསྐྱོད་པ་ཡིན།",
    "ཀྲན་ཧྲིན་ལ་དེང་རབས་སུའེ་ཏེན་གྱི་དངོས་རྫས་ལ་ཆ་རྒྱུས་ཡེ་མི་འདུག་འོན་ཀྱང་།"
  ]
