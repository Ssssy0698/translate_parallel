    "གཉིས་པ་གཅིག་ཏུ་འདུག་པའི་གྲང་གྲོགས་པ་འདུ་འཚོག་སྟབས་སུ་བྱེད་ཅིང་བསྲེ་སླད་ཆེ་བའི་རིགས་རྣམས་ལ་མཐོ་དམན་ལ་སོགས་པ་འཆོར་བས་རྟག་ཏུ་བཀོལ་ལ་བསྒོམ།",
    "གསུམ་པ་རང་དང་འདྲེན་ངེས་སུ་འདུག་སྟེ།",
    "འཛོམས་ཅིག་བྱ་སྙམ་ཙ་ན་ས་གཉི་ལུང་དུ་ཕྱིན་པས་འཛོམས་པ་ཅིག་བྱུང་བས་རྨོངས་ནས་མ་གོ་བར་འདུག།",
    "དེ་ཡང་ཕྱིས་མི་ལ་འཆད་ཙ་ན་དེ་སྐད་ཅེས་ཟེར་བ་ཡིན་སྙམ་པ་དེས་མི་འོང་།",
    "སྤྱན་མངའ་བ་ང་ནི་མི་དགའ་བར་འདུག་ཅེས་དང་།",
    "ཐོས་བསམ་ལ་མེད་ཐབས་མི་གདའ་སྟེ།",
    "དེ་གང་ན་འདུག་ཀྱང་ཐེ་ལེ་ལེ།",
    "འགྱུར་བའི་སྡུག་བསྔལ་བསམས་ཙ་ན།",
    "མི་ཕྱུག་པོ་སྤྲང་པོར་འགྲོ་ཡིན་འདུགཁ་དྲག་པོ་ཞན་པོར་འགྲོ་ཡིན་འདུག།",
    "མི་མང་པོ་གཅིག་ཏུ་འགྲོ་ཡིན་འདུག།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བསམས་ཙ་ན།",
    "དེ་ལྟར་ཚེ་འདི་ལ་ཉེས་པ་དེ་ལྟར་འདུག་ཀྱང་གཞན་འཁོར་ལོས་བསྒྱུར་བ་དང་།",
    "ཁམས་གསུམ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས་མ་འདས་པར་འདུག་པས།",
    "དལ་འབྱོར་ལུས་འདི་ངོ་བོའི་སྒོ་ནས་དལ་བ་བརྒྱད་དང་འབྱོར་པ་བཅུ་ཚང་བ་རྙེད་པར་དཀའ་བ་འདུག།",
    "སྐྱེས་ནས་མ་ཤི་ཚེ་ཐར་དུ་སྡོད་པ་སུ་ཡང་མི་འདུག་པས་ངེས་པར་འཆི།",
    "འཁོར་མང་པོས་བསྐོར་བའི་ཚེ་ཡང་ད་ལྟ་ཏ་འདི་དང་འདི་ལྟ་བུ་འདུག་སྟེ།",
    "དེ་ལ་ཤེས་རབ་དགོས་པས་རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱི་བསྒྲུབ་པ་བགྱིས་ཤིག་གསུངས་ནས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་ལུང་གནང་།",
    "ཞེས་གསུངས་པས་གནས་ཁམས་གསུམ་པོ་དེར་རྟེན་འགྲོ་བ་རིགས་དྲུག་པོ་གང་དུ་སྐྱེས་ཀྱང་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཅན་གང་ལ་ལོངས་སྤྱོད་ཀྱང་སྡུག་བསྔལ་གྱི་ལོངས་སྤྱོད་འབའ་ཞིག་ཏུ་འདུག་པས།",
    "ཆུའི་རྒྱལ་ཁམས་ཆེན་པོ་འདུག་སྙམ་ནས་ཕྱིན་པ་དང་།",
    "དེ་ལྟར་ཤིན་ཏུ་སྡུག་བསྔལ་ཡང་ལས་དེ་མ་ཟད་ཀྱི་བར་དུ་སྡུག་བསྔལ་དྲག་པོ་མྱོང་དགོས་པར་འདུག།",
    "དེ་ལའང་རང་དོན་མ་རྫོགས་ཤིང་གཞན་དོན་རྒྱ་ཆེན་པོ་མི་ནུས་ལ།",
    "སྐྱེ་བོའི་རྒྱུ་འགྲུལ་དང་དགྲའི་ཅོར་གློག་སོགས་བསམ་གཏན་གྱི་ཚེར་མ་མེད་པར་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "རང་རང་སྡུག་བསྔལ་རྒྱུ་རུ་མི་འདུག་གམ།",
    "བསམས་ན་ཐམས་ཅད་གཉེན་དང་ཕ་མར་འདུག།",
    "ཞེས་གསུངས་པ་ལྟར་མཐོ་རིས་ཐོབ་པའི་རྟེན་ལའང་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་ལ་འཛེམ་མེད་དུ་སྤྱོད་ཅིང་ཕྱིན་ཆད་མི་བྱེད་པའི་སྡོམ་སེམས་ཐོབ་པ་ཤིན་ཏུ་ཉུང་བས་ངན་འགྲོར་འགྲོ་བ་ནི་མང་ལ།",
    "ནམ་འཆི་ལ་ནི་ཆ་མི་འདུག།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "ལེ་ལན་གདའ་ས་འཆུགས་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་རང་གཅེས་འཛིན་གྱིས་གནོད་པ་དུ་མ་ལ་སྦྱར་ཞིང་།",
    "དགེ་སྡིག་ཁྱད་དུ་བསད་ནས་མངོན་མཐོ་ངེས་ལེགས་ཀྱི་སྲོག་རྩ་གཅོད་པའི་སྡིག་ཅན་ཤན་པ་མཁན་དེ་ཡང་འདིར་འདུག།",
    "ཁ་ཡན་པ་དེ་ཡང་འདིར་འདུག།",
    "གནོད་པ་དང་སྡུག་བསྔལ་དུ་མ་ལས་སྐྱོབ་པའི་དྲིན་ཅན་དུ་འདུག་ཨང་སྙམ་པའི་ཤེས་པ་ཉེ་དུང་ངེ་བ་བསྐྱེད་ལ།",
    "ལེགས་སྙམ་དུ་བསམ་པ་ཐག་པ་ནས་དགའ་ཞིང་རངས་པར་བྱའོ།",
    "སྡུག་ན་སྡུག་ཁྱག་པ་ཅིག་དགོས་གསུང་བར་གདའ།",
    "ཡོན་ཏན་ཆེན་པོ་གཅིག་གདའ་སྟེ།",
    "སྨ་འབེབས་སུ་འདུག་བརྟགས་པའི་ཚེ།",
    "འོན་ཀྱང་དེ་དང་འགྲོགས་བཏུབ་པ་ཅིག་མི་འདུག་སྙམ་དུ་སེམས་པ་དང་སྨྲ་བར་མི་བྱའོ།",
    "དེ་འདྲའི་རིགས་ལ་བཟང་བྱས་མ་བྱས་མི་གདའ།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "བདག་འཛིན་གྱི་འཛིན་སྟངས་ཀྱི་ལོག་ཕྱོགས་ངེས་ནས་འཛིན་པ་མི་འདུག་པའི་ཕྱིར་ཏེ།",
    "ང་རང་བཞིན་ཧོར་སྟོན་ནམ་མཁའ་དཔལ་བས་མཛདམེད་པར་གཏན་ལ་དབབ་པ་དང་།",
    "དེ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་གཞི་མཐུན་འགོག་ཚུལ་ནི།",
    "གང་རང་བཞིན་གྱིས་གྲུབ་པ་དེ་ནི།",
    "གཟུགས་བརྙན་གྱི་སྟེང་དུ་རྟེན་འབྱུང་དང་རང་བཞིན་གྱིས་གྲུབ་པ་གཞི་མཐུན་ལ་གནོད་པ་མཐོང་ཞིང་།",
    "གཟུགས་བརྙན་གྱི་སྟེང་དུ་རྟེན་འབྱུང་དང་རང་བཞིན་གྲུབ་པ་གཞི་མཐུན་ལ་གནོད་པ་མཐོང་ནས།",
    "ཅི་སྟེ་ཁྱེད་ཅག་ཅིས་ཀྱང་ཙོག་བུར་འདུག།",
    "གདན་སྟེང་འདུག་སྟེང་མེ་སྟག་འཕྲོ་བའི་སྟག།",
    "རང་རང་རྗེས་མཐུན་ད་དྲག་ཐོབ་རྣམས་ལ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཧྲི་ད་ཡ་ཤི་ར་ཤི་ཁ་ཀ་བ་ཙ་ནེ་ཏྲ་ཨ་སྟ་བཛྲ་ཤ་ཊ་གྷ་སྭ་བྷ་བ་ཨཱཏྨ་ཀོ་ཧྃ།",
    "ཨོཾ་བཛྲ་གྷནྡྷེ་གན་དྷ་ཨར་ཙ་ནྃ་ཀུ་རུ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "གཞན་ཐམས་ཅད་ཞལ་གཅིག་ཕྱག་བཞི་ཕྱག་མཚན་གཙོ་བོ་དང་མཐུན་པ་སྤྱན་གསུམ་གསུམ་པ་གཙོ་བོ་ཡབ་ཡུམ་སྐྱིལ་དཀྲུང་དང་པད་མའི་འདུག་སྟངས།",
    "འདིའི་གཟུགས་ཀྱང་གསོལ་ཇ་བ་ལ་མཛེས་རྒྱུ་ཡང་མི་འདུག་པ་དང་།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "ས་སྐྱ་པའི་བསྟན་པ་ལ་ཁྱད་ཆེ་བར་གདའ་སྟེ།",
    "སྒོ་རུམ་གྱི་ཕྱག་དཔེའི་དཀར་ཆག་ཏུ་འདུག་པས་ཐུགས་དགེས་ཏེ།",
    "བདག་ཆེན་གྱི་དྲུང་ནས་དཀོན་གཉེར་ལ་ཁོང་ཕྱག་དཔེ་རྣམས་ལ་ལྟ་རྟོག་ཚར་གཅིག་བྱེད་འདོད་པར་འདུག་པས།",
    "ཁང་པ་སྒོ་ཤར་བསྟན་ཅིག་འདུག་པའི་སྐས་ཤིག་ལ་འཛེགས་བྱོན་པས།",
    "ཁང་པ་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པའི་སྐས་ལ་འཛེགས་བྱོན་པས།",
    "དེ་ནས་མཚམས་དེའི་ཤར་འགུག་ཅིག་ན་བཞུགས་གདན་ཅིག་མཛད་འདུག་པ་ལ་བཞུགས་ནས།",
    "མནལ་ལམ་དུ་ས་བཟང་ན་བཞུགས་འདུག་པའི་རྣམ་པ་ཞིག་ལ།",
    "འདིའི་ཆོ་འཕྲུལ་ན་ནིང་འོང་རྒྱུར་འདུག་ནའང་།",
    "བྱ་སྤྱོད་གཉིས་པོ་འདི་དིང་སང་བཀའ་མ་ཆད་ཙམ་ལས་མི་འདུག་པས།",
    "འདི་གཉིས་སོས་པ་ཅིག་བྱུང་ན་བོད་དུ་བསྟན་པ་ཡོངས་སུ་རྫོགས་པ་ལེགས་པོ་ཅིག་འོང་བ་འདུག་སྙམ་སྟེ།",
