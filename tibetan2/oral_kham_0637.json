    "གཞན་ཕན་མི་འོང་ཡང་དགེ་སྦྱོར་གྱི་གཙོ་བོ་དེ་ལ་བྱེད་དགོས་པར་འདུག་དགོངས་པ་བྱུང་གསུངས།",
    "རྗེ་འདིའི་མདུན་དུ་རྡོ་ཅིག་འདུག་པ་ལ་ཕྱག་རྗེས་དོད།",
    "མར་མེ་གཉིས་ཀྱི་གཅིག་ཤི་བ་དེ་སློབ་དཔོན་བློ་རིན་དང་མཆོད་གཡོག་པ་གཉིས་ན་ནས་མཆོད་གཡོག་པ་ཤི་བའི་བརྡར་འདུག་གསུངས།",
    "རྗེ་འདི་ཐུགས་དམ་ཁོ་ན་བཞེད་པའི་ཞུས་ལན་ཡང་བྱུང་འདུག་གོ།",
    "རྗེ་འདིས་གྲ་ས་མ་བསྐྱངས་པར་ཐུགས་དམ་ཁོ་ན་མཛད་ན་མཁའ་སྤྱོད་དུ་མྱུར་བར་ཐེགས་ངེས་ཤེས་སུ་འདུག་སྟེ།",
    "ངེད་ཀྱང་གཡེང་པས་ཁྱེར་བ་ལ་ལྟ་བ་འདུག་གསུངས།",
    "དེ་ལྟ་བུའི་ཉམས་བསྒྱིལ་ན་ཤིན་ཏུ་མི་དགའ་བར་འདུག་གསུངས་སོ།",
    "འདི་ཁོ་ནར་འདུག་དགོངས་པ་བྱུང་གསུངས།",
    "རྗེ་འདི་སྐུ་སྟོད་ཕུད་ནས་བཤུམ་ཞིང་འདུག་པས་ཅི་ཡང་ཞུ་མ་ནུས་པར་ལོག་ཕྱིན་ཟེར་རོ།",
    "དེ་ཙམ་མཛད་ན་སྟོད་འཚོངས་ལ་སོགས་སྐུ་ཁམས་ལོག་འོང་ཞེས་ཡང་ཡང་ཞུ་བར་འདུག་གསུངས་སོ།",
    "སྔར་ནི་གུ་ཞུས་པའི་ཉམས་ཤར་བ་ཡིན་པ་འདུག་གསུངས།",
    "རྩིག་པ་ལ་ཡང་ཐོགས་པ་མི་འོང་བར་འདུག་གསུངས་སོ།",
    "འཇུག་པ་སེལ་བའི་ལམ་དེ་འདི་ཀ་ཡིན་པར་འདུག་གོ་དགོངས་པ་བྱུང་གསུངས་སོ།",
    "རྗེ་འདི་ནི་སྔར་ལས་ཀྱང་དམ་པར་མཛད་པ་འདུག་གོ།",
    "བཟའ་བའི་དམ་ཚིག་དུས་ཁྱད་པར་ཅན་དང་།",
    "ད་ཕེབས་པར་ཞུ་ཟེར་བའི་ངང་ནས་ཁོང་གཤེགས་འདུག།",
    "ཆུ་བོ་ལས་བསྐྱབས་པའི་མནལ་ལྟས་བཟང་པོ་བྱུང་འདུག་ཀྱང་དེ་འདྲ་ཡི་གེར་བྲི་རིན་མེད་གསུངས་པས་མ་བྲིས་སོ།",
    "ཁྱེད་རྣམ་རྟོག་དེ་འདྲ་ཚོ་མ་རྒྱུ་དགེ་སྦྱོར་ལ་གནོད་ཅེས་ཁོང་རང་ལ་གསུངས་པ་དང་།",
    "སྤྱོད་པ་སྔ་རྟིང་དུ་ཅི་བྱས་རྗེ་འདི་ཉིད་ཀྱིས་མཁྱེན་ནས་ཁོང་རང་ལ་གསུངས་པ་དང་།",
    "འོན་ཀྱང་པོ་སོའི་རྟ་ཞོན་པས་ཆོག་པར་འདུག་གསུངས།",
    "དེར་དོལ་པའི་པོ་སོ་སྟག་ལའི་ཚ་བོ་ཤི་ནས་བོ་དོང་དུ་ཆོ་ག་བྱེད་ཀྱིན་འདུག་པས།",
    "གཞན་ཡང་མངོན་ཤེས་གསུངས་ཚུལ་མང་པོ་འདུག་ཅིང་།",
    "རྗེ་དཔོན་སློབ་ལ་ཡང་བུ་སློབ་དེ་ཙམ་འཕེལ་ཞེས་པའི་མཚན་ལྟས་ཡིན་པར་འདུག་གོ།",
    "བཀའ་བཅུ་པ་ཆེན་པོ་སངས་གྲུབ་ཀྱིས་གསན་འདུག་ཟེར་རོ།",
    "རྗེའི་གཡས་སུ་གདན་མཐོན་པོ་བཤམ་འདུག།",
    "ལམ་འབྲས་ཀྱི་རྣམ་གཡེངས་ཆེན་པོ་འདི་ཚོ་ལ་ལྟ་བར་འདུག་གསུངས།",
    "བདེ་བ་ཅན་གྱི་ཞིང་བཀོད་བཞེངས་པ་ལ་ཐུགས་རྩོལ་མཛད་འདུག་པས་རྗེ་འདི་བདེ་བ་ཅན་དུ་འབྱོན་ངེས་པར་འདུག་གོ།",
    "བཞི་ལྔ་ཞིག་འདུག་པ་འདིའི་མགོ་འདོན་ཁྱེད་ཁོ་ན་ལ་རག་ཟེར་བ་ཅིག་བྱུང་སྟེ།",
    "རྗེ་བཙུན་ཆེན་པོས་མི་བདུན་ཁུར་བ་དང་འདྲ་པར་འདུག་གསུངས།",
    "སུ་ཡིན་ངེས་པ་མི་འདུག་གསུངས་སོ།",
    "རྗེ་ངོར་པ་དང་ཡང་ཡང་དུ་མཇལ་ཚོད་དུ་འདུག་གོ།",
    "ཨ་ཙི་སློབ་དཔོན་དཀོན་རྒྱལ་གྱིས་ཁ་ནས་དེ་འདྲ་འོང་བ་གསུངས་ཏེ།",
    "འོན་ཀྱང་རང་གཞན་དོན་དུ་ཕྱོགས་མཐོང་ཙམ།",
    "བདག་ཆེན་རྣམས་ཀྱི་ཕྱག་དམ་འབྱར་བ་ཅིག་འདུག་པ་བཤིག་ནས་ནང་ཚུན་ཆད་བལྟས།",
    "ནས་མང་པོ་འདུག།",
    "གཞན་སྐུ་ལ་སོགས་པ་ནི་ཅི་ཡང་མི་འདུག།",
    "ངས་ཀྱང་བྱང་ཕུག་ཏུ་བརྒྱུད་འཛིན་ཙ་ན་གཏོར་མ་ཆག་མེད་དུ་ཕུལ་གྱིན་བཟུང་བ་ཡིན་གསུངས།",
    "རྗེའི་དྲུང་ན་བཞུགས་ཙ་ན།",
    "ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "བ་རི་ལུགས་ཀྱི་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "མི་ཕམ་བཤེས་གཉེན་གྱིས་མཛད་པའི་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔའི་སྒྲུབ་ཐབས།",
    "སྦས་པ་མིག་དུས་འཁོར་རྩ་རྒྱུད་ཀྱི་དུམ་བུ་ཡིན་པ་འདྲ།",
    "རྩ་རྒྱུད་བརྟག་གཉིས་ཅིག་གསུང་བར་བཞེད་འདུག་ཀྱང་ཞུ་བ་པོའི་སྟབས་ཀྱིས།",
    "དེ་ངུས་པས་ད་ལན་སྔགས་ཕྱོགས་པ་སྦྱངས་པ་ཆེ་བ་མང་ཞིང་འདུན་པ་ཆེ་བའི་སྒོ་ནས་མཉན་པ་ཡང་མང་བར་འདུག་པས་བསྟན་པའི་རྒྱུན་ལ་ཕན་སྟོབས་ད་ལན་ངོས་ཆེ་བ་འོང་བར་གདའ་གསུང་ཞིང་།",
    "དཔོན་པོས་ཟླ་ཤོལ་འདོན་པ་འདུག་ནའང་།",
    "ཁྱེད་རང་ཀྱང་སྒྲུབ་མཆོད་ཚུགས་ལ་ནམ་ནུས་ཀྱི་བར་དུ་བྱས་པས་ཆོག་གསུང་བ་ལ་སོགས་མཁྱེན་ཅིང་དགོངས་པའི་ཞལ་ད་མང་དུ་གནང་།",
    "བསེར་མ་ཅུང་ཟད་ཤས་ཆེ་བར་འདུག།",
    "མི་གནང་ཁ་མེད་དུ་ནི་མི་འདུག།",
    "དེ་རིང་སྐུ་ཁམས་ལྟེམ་པར་འདུག་པས།",
    "དེ་རིང་ལུས་ཤེད་ཆུང་བར་འདུག་པས།",
    "འཐེན་པ་དེ་ངོས་ཀྱང་ཡིན་ཚོད་འདུག་གསུངས།",
    "ང་འབོད་པ་དེ་མི་འཁྲུགས་པ་ཡིན་པ་འདུག་གམ་གསུང་།",
    "རྣམ་འགྱུར་ཤིན་ཏུ་ཆེ་ཞིང་མང་བ་ཅིག་མཛད་ཀྱིན་འདུག་པས།",
    "ཧེ་རུ་ཀ་དང་འདུག་གསུངས།",
    "ངོ་མཚར་བའི་ལྟས་རྣམས་བསྟན་ཅིང་བསྐྱེད་པར་གདའ།",
    "རྡོའི་མཎྜལ་གཅིག་དང་ནས་མང་པོ་འདུག།",
    "གཞན་སྐུ་ལ་སོགས་པ་ནི་ཅི་ཡང་མི་འདུག།",
    "གཞན་ཐམས་ཅད་ནི་འཇིགས་པོར་བྱེད་ཀྱི་གདའ་གསུངས་ཏེ།",
    "སྔོན་གྱི་ས་སྐྱ་པ་རྣམས་རྒྱུད་འཛིན་ཙ་ན་ཐུན་གཏོར་ཆག་མེད་དུ་བྱེད་པ་ཡིན་ནོ།",
    "ངས་ཀྱང་བྱང་ཕུག་ཏུ་རྒྱུད་འཛིན་ཙ་ན་གཏོར་མ་ཆག་མེད་དུ་འབུལ་གྱིན་བཟུང་བ་ཡིན་གསུངས།",
    "དེ་དུས་པས་ད་ལན་སྔགས་ཕྱོགས་ལ་སྦྱངས་པ་ཆེ་བ་མང་ཞིང་འདུན་པ་ཆེ་བའི་སྒོ་ནས་མཉན་པ་ཡང་མང་བར་འདུག་པས་བསྟན་པའི་རྒྱུན་ལ་ཕན་སྟོབས་ད་ལན་ངོས་ཆེ་བ་ཡོང་བ་འདྲ་གསུངས་ཤིང་ཐུགས་སྤྲོ་བ་མཛད་ཀྱིན་སྣང་།",
    "ཚོགས་པ་ཡང་མང་བར་འདུག།",
