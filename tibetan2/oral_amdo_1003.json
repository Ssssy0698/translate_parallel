    "དེ་ནས་ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་ཀྱི་མིང་པོ་ཐ་ཆུངས་༢༢རྒྱལ་པོ་མ་སྐྱེས་དགྲའི་བུས་བཅོམ་ལྡན་ཝ་འདས་གང་༡ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཅི་ནས་ཀྱང་བདག་གི་སྟེང་དུ་འོད་ཟེར་༦བཏང་བ་དེ་ལྟ་བུར་བདག་ལ་བྱིན་གྱིས་བརླབ་པར་གསོལ།",
    "བདག་གི་རིགས་ཀྱིས་ཡུན་རིང་པོར་ལི་ཡུལ་དུ་ཡུལ་འཛིན་པར་འགྱུར་བ་དེ་ལྟ་བུའི་གཟུངས་ཀྱང་སྩལས་བར་གསོལན།",
    "གང་གི་ཚེ་ལི་ཡུལ་དུ་སུམ་པའམ།",
    "ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་དེའི་མིང་པོར་གྱུར་༡༡།",
    "གང་གི་ཚེ་གཞོན་ནུ་དེས་དེ་སྐད་ཅེས་གསོལ་ནས།",
    "ལྷ་རྣམས་ཀྱིས་ཀྱང་ལྷའི་མེ་ཏོག་གི་ཆར་ཕབ་༡༢སྟེ།",
    "ཆོ་འཕྲུལ་དེ་དག་ངས་ཅགཅིག་ཏུ་བསྡུས་ཏེ་གཅིག་ཏུ་བརྟུལ་༥བས་མ་འོངས་པའི་དུས་སུ་ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་འདིས་ཡོངས་སུ་བསྐྱང་བའི་༥ཕྱིར་ལག་ཏུ་བླངས་པའི་ལི་ཡུལ་གྱི་ཡུལ་འཁོར་རབ་ཏུ་གནས་པར་བྱའོ།",
    "བུད་དྷ་བ་བ་ར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་དང་།",
    "ལི་ཡུལ་གྱི་ཡུལ་འཁོར་ཁྱོད་ལ་གཏད་དཔས།",
    "དེའི་ཚེ་ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་དང་།",
    "བཅོམ་ལྡན་འདས་ལི་ཡུལ་གཏདམ་༡་པ་འདི་བདག་ཅག་གིས་མནོད་༡་པར་འཚལ་ལོ།",
    "གནས་པ་ཞེས་བྱ་བའི་བསྐལ་པ་ལ་འཇིག་རྟེན་གྱི་ཁམས་བུད་མེད་དུ་གྲགས་པ་ཞེས་བྱ་བརན།",
    "པྲཛྙཱ་ཀེ་༨རེ།",
    "བདག་གིས་དེར་སྐྱེ་བ་བླངས་ཏེ་སྐར་རྡོའི་རྒྱལ་པོའི་བུ་མོར་གྱུར་ནས་གསེར་གྱི་ཡུལ་གང་དུ་བདག་གི་ཕ་མ་གུམ་པའི་སྡུག་བསྔལ་གྱིས་བདག་སྐྱོ་བར་གྱུར་པ་དེར་བདག་འགྲོ་བར་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "བདག་གི་ཁྱིམ་ན་ཁྱོད་བུད་མེད་ཀྱི་ལུས་ཀྱིས་ལས་དེ་དག་བྱེད་ཅིང་བདག་གིས་ཀྱང་དེར་དབར་ཆད་བྱེད་པར་མི་འགྱུར་བ་དང་།",
    "ཁྱོད་ཀྱི་ཡུལ་གྱི་ཕྱིར་དང་།",
    "དེ་ཕྱིན་ཅད་འཚེ་རབས་ཐམས་ཅད་དུ་ཁྱོད་ནི་བདག་གི་མར་གྱུར་ལ།",
    "བདག་ནི་ཁྱོད་ཀྱི་༧བུར་གྱུར་ཏོ།",
    "ཁྱོད་ཀྱང་བདག་གི་ཚོནམར་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "དེའི་ཚེ་འཁོར་དེའི་ནང་ན་ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་དེའི་ཕྱི་བཞིན་དུ་འབྲང་བའི་རིགས་དང་ལྡན་པའི་བུད་མེད་ཅིག་འདུག་པ་ང་རྒྱལ་གྱིས་ཤིན་ཏུ་ཁེངས་ཤིང་རྒྱགས་ལ།",
    "གཞོན་ནུའི་ཚེ་བདག་གིས་སྐྱེས་བུ་མང་པོ་དག་དང་འདོད་པའི་ཅི་འདོད་ཆགས་ཀྱི་ཕྱིར་བགདས་པ་དང་སྐེ།",
    "མས་༧པ་གང་ཡིན་པའི་བདག་གི་ལས་དེ་དག་ཐམས་ཅད་བྱང་བར་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "གང་གི་ཚེ་དམག་གི་དཔུང་ཆེན་པོ་དེ་དག་ཕན་ཚུན་འགྱེད་༡་པར་འགྱུར་བ་དེའི་ཚེ་བདག་སྐུར་རྡོའི་རྒྱལ་པོར་གྱུར་ནས།",
    "གང་གི་ཚེ་གདོང་དམར་དག་དམག་འདྲེན་པ་དེའི་ཚེ།",
    "བདག་གི་གསེར་གྱི་རིགས་ཀྱི་རྒྱལ་པོ་ལས་ནོར་བླངས་ཏེ།",
    "བདག་ལི་ཡུལ་དུ་ཚེ་རབས་བདུན་གྱི་བར་དུ་རྒྱལ་པོའི་བཙུན་མོ་དམ་པར་༥༥",
    "གྱུར་ཅིག་གང་གི་ཚེ་དམག་གི་དཔུང་ཆེན་པོ་གང་ཡིན་པ་དེ་དག་ལི་ཡུལ་དུ་གཡུལ་འགྱེད་པའི་དུས་ལ་བབ་པ་དེའི་ཚེ་ནི་བདག་རྒྱ་ཡུལ་དུ་སྐྱེ་བ་ལེན་པར་གྱུར་ཅིག།",
    "ལྷ་མོ་འཕྲོག་མ་བུ་དང་བཅས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་པུས་མོའི་ལྷ་ང་ས་ལ་བཙུགས་༡ལྷནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་མ་འོངས་པའི་དུས་སུ་ལི་ཡུལ་དེ་བསྲུང་བའི་༧སླད་དུ་མནོད་པར་འཚལ་ཏེ།",
    "མི་དང་མི་མ་ཡིན་པ་༡དེ་དག་ཐམས་ཅད་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་སྟེང་གི་ནམ་མཁའ་ལ་མེ་ཏོག་གི་ཆར་ཕབསན།",
    "ཀུན་ཏུ་རྒྱལ་ལ་སོགས་པ་གང་དག་གི་ལག་ཏུ་ཡུལ་དེ་བསྲུང་བའི་༤ཕྱིར་གཏད་པ་དེ་དག་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ་༤༥།",
    "གང་གི་ཚེ་གདོང་དམར་དག་གིས་ཡུལ་བཟུང་སྟེ།",
    "གང་གི་ཚེ་ཕན་ཚུན་གཡུལ་འགྱེད་པར་བྱེད་པ་༡་དེ་ནི་འཇིགས་༡༨པ་ཆེན་པོ་ཡིན་ཏེ།",
    "གང་གི་ཚེ་གདོང་དམར་རྣམས་སྐྲག་༩པར་གྱུར་པ་དེའི་ཚེ་གསེར་གྱི་རིགས་ཝ་ཀྱི་ཡུལ་དུ་འགྲོ་བར་ཆས་སོ།",
    "གང་གི་ཚེ་གསེར་གྱི་རིགས་ཀྱི་ཡུལ་གདོང་དམར་མི་གཏོང་ལ།",
    "གང་གི་ཚེ་ནོར་ཐོབ་པར་གྱུར་པ་དེའི་ཚེ་ཐོག་མར་ལི་ཡུལ་དུ་ནོར་རྫོངས་ལ་གདོང་དམར་ལ་སྐུར་༡་ཅིག་ལི་ཡུལ་པ་རྣམས་ལ་ཡང་དེར་སྦྱིན་པར་བྱ་སྟེ།",
    "གང་གི་ཚེ་ལི་ཡུལ་དུ་སྐྱེས་བསྐུར་བ་ན།",
    "དེ་དག་གིས་༡་དམག་གི་དཔུང་ཆེན་པོ་ཡང་དེར་འོང་བར་མི་ནུས་སོ་ཞེས་སྨོས་ཤིག།",
    "གང་གི་ཚེ་དེའི་དམག་ལི་ཡུལ་དུ་འོང་ན་དེར་མ་འོངས་ཤིག་ཚདང་ཡུལ་དེ་༣།",
    "ཕྲིན་ཡིག་འདི་བཞིན་དུ་བྱེད་པར་འགྱུར་༡༨ན་བདག་ཅག་གིས་ལི་ཡུལ་ཐམས་ཅད་བསྡུས་ཏེ་༡༩འདུམ་པར་བྱའོ་ཞེས་བྱས་ན་རྫི་བར་མི་ནུས་ཏེ་འདི་ལ་ཐེ་ཙོམ་༢་མི་བྱའོ།",
