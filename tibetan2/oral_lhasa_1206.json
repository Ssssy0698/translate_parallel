    "འདས་པ་ལ་སོགས་པ་རྣམས་ཀྱང་ད་ལྟར་བྱུང་བ་ཉིད་ཀྱིས་དེ་ཡང་དག་པར་རིག་པ་ཡིན་པའི་ཕྱིར།",
    "སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་དང་།",
    "མན་ངག་ལ་ངེས་པ་ཡོད་པར་རྟོགས་སོ་ཞེས་ཟེར་ན།",
    "ཐབས་ལ་སོགས་པ་རྣམ་པར་དག་པ་སྤྱན་དང་།",
    "དམིགས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཉིད་ཀྱིས་རྣམ་པར་དག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་རྡོ་རྗེ་འཛིན་པ་ཡིན་པར་ནི་མི་འདོད་དེ།",
    "དེ་རྣམས་ཀྱི་རྣམ་པར་དག་པ་དགོས་པ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་ཐུགས་ལ་བཞུགས་སོ་ཞེས་བྱ་བའི་མཐར་ཐུག་པའི་ཚིག་བཞིས་གཉིས་པ་གསོལ་བའི་ཚིག་དང་མཐུན་པ་ཡིན་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་པས་ན་རྣམ་པར་སྣང་མཛད་དེ།",
    "དེ་བཞིན་གཤེགས་པའི་བཀོད་པ་དེ་དག་ཐམས་ཅད་ཉིད་ཀྱི་སྐུ་ལ་ཞུགས་པར་མཛད་དོ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ཡང་དག་པར་མཉེས་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "སའི་ཁམས་ཀྱི་གཟུགས་ལ་སོགས་པ་རྣམ་པར་དག་པའི་སྤྱན་ནི་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་གཟུགས་ཀྱིས་འབྱིན་པ་དང་།",
    "འཇུག་པ་དག་ལས་ཤེས་པར་བྱ་སྟེ།",
    "བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་དགོད།",
    "གནས་པ་དང་བརྟན་པར་གྱུར་པས་ཀུན་དུ་རྩོལ་བས་ན།",
    "དེ་ལྟར་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བྱུང་བ་ལྷར་ངེས་པར་སྣང་བ་དང་།",
    "དྲི་མ་མེད་པའི་ཏིང་ངེ་འཛིན་ལས་ཡང་དག་པར་བྱུང་བ།",
    "ལྷུན་གྱིས་གྲུབ་པར་ཐོབ་ཅིང་།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྒྲུབ་པ་སྟེ་གཉིས་ཀ་ཡང་མཆོག་ཏུ་བདེ་བ་བསྐྱེད་པའི་རྒྱུར་གྱུར་པ་ལ་རྒྱལ་བ་ལྔ་པོ་བཞུགས་པའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཕྱག་ན་རྡོ་རྗེ་འདོད་པའི་ལོངས་སྤྱོད་ཐམས་ཅད་ཀྱི་དཔལ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་གནས་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་གྱིས་ཚིག་གཉིས་པས་གསོལ་བ་གདབ་པ་གཉིས་པ་དང་ཡང་དག་པར་སྦྱར་བ་ཡིན་ནོ།",
    "དང་པོའི་དོན་དྲུག་པར་བྱས་པ་ཡིན་ནོ།",
    "ཞུགས་མ་ཐག་ཏུ་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་སྙོམས་པར་ཞུགས་པའི་རྗེས་ཐོགས་ཉིད་ལའོ།",
    "མཚན་ཡོངས་སུ་གྱུར་ནས་ཟླ་བ་གཉིས་ཀྱི་རྣམ་པར་ཞུ་བར་གྱུར་པ་ལ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་སྒྲར་གསུངས་སོ།",
    "དེའི་ངོ་བོ་ནི་དེའི་རང་བཞིན་དུ་གནས་པར་གྱུར་ཏོ།",
    "ཨ་ལ་སོགས་པའི་ཡི་གེ་ནི་དངོས་པོ་མ་ལུས་པར་རབ་ཏུ་འགོག་པའི་ངོ་བོ་ཉིད་ཀྱི་ང་རྒྱལ་སྟོན་པ་ཉིད་ཀྱིས་སྟོན་ཏེ།",
    "དེ་བས་ན་དེ་ལྟར་བསྐྱེད་པའི་རིམ་པས་རྒྱུར་གྱུར་པ་ཡིན་པར་བཅོམ་ལྡན་འདས་སྟོན་པར་མཛད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ནི་ལ་ལར་བསྡུ་བར་བྱས་ཏེ།",
    "ཤེས་རབ་དམ་པར་ངེས་པར་སྣང་ཞིང་མཆོག་ཏུ་བདེ་བ་བསྐྱེད་པའི་རྒྱུར་གྱུར་པའོ།",
    "དབྱངས་ལ་སོགས་པར་ངེས་པར་སྣང་བ་ཡོངས་སུ་གྱུར་པའི་ཟླ་བ་གཉིས་ཡོངས་སུ་གྱུར་པའི་གཟུགས་ཅན་གྱི་རྣམ་པ་གཞན་དུ་གྱུར་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིག་གསུམ་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཏིང་ངེ་འཛིན་གང་ལས་ཟླ་བ་གཉིས་ཡང་དག་པར་རིག་པ་རྩེ་གཅིག་པའི་མཚན་ཉིད་ཅན་དབྱེར་མི་ཕྱེད་པར་གྱུར་པ་དེ་ལ་སྙོམས་པར་ཞུགས་པ་ནི་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་པའོ།",
    "རིག་པ་དང་ཡང་དག་པར་འདུས་པའི་སྐྱེས་བུའི་གཟུགས་ཀྱང་ཡིན་ལ།",
    "དེ་རྣམས་ཀྱི་བྱིན་གྱིས་རླབས་ནི་རྒྱུད་དེ་བྱིན་གྱིས་བརླབས་པར་གྱུར་པའོ།",
    "བཅོམ་ལྡན་འདས་དེ་ཉིད་ཅེས་བྱ་བ་ནི་གང་འདི་ཟིལ་གྱིས་གནོན་པའི་ཏིང་ངེ་འཛིན་ལ་སྔར་བཞུགས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་གཞན་དག་ལ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ཐོག་མ་བྱས་པ་ལ་སོགས་པ་སྟེ།",
    "ཚིག་དང་པོ་གསུངས་པ་ཡིན་ཏེ།",
    "གོང་མ་གོང་མའི་ཁྱད་པར་གྱིས།",
    "མི་སྲིད་པར་ཤེས་པ་ནི་རྨད་དུ་གྱུར་པའོ།",
    "སྣོད་དུ་རུང་བར་བྱས་ནས་ཡང་དག་པར་བསྟན་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ད་ནི་དཀྱིལ་འཁོར་གྱི་མཆོག་སྟོན་པར་བྱེད་པ་དཀྱིལ་འཁོར་འབྱིན་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིག་བདུན་པས་སྟོན་ཏེ།",
    "དེ་ཉིད་ནི་མི་ཕྱེད་པས་རྡོ་རྗེར་གྱུར་པའི་ཏིང་ངེ་འཛིན་རྡོ་རྗེ་འཆང་བ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་དེ་ཉིད་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "ཞེ་སྡང་ནི་ད་གྲ་བོའི་རྒྱུད་དང་དེ་ལས་ཡང་དག་པར་བྱུང་བ་རལ་གྲི་ལ་སོགས་པ་འཛིན་པའི་མཚན་ཉིད་ལ་ཁྲོ་བོ་ཞེས་བྱ་བའི་ཞེ་སྡང་བ་ཉིད་ནི་ཁྲོ་བོ་མ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "མི་བསྐྱོད་པ་ཉིད་ཕྱག་རྒྱ་ཆེན་པོས་རང་སྣང་བའི་རིག་པ་དང་ཡང་དག་པར་སྦྱོར་བས་ན་ཕྱག་རྒྱ་ཆེན་པོར་སྦྱོར་བའོ།",
    "ལས་ཡིན་ཡང་གསུམ་པར་བྱས་སོ།",
    "ཚུལ་འདིས་ན་དེ་ཉིད་དེར་བཞུགས་སོ་ཞེས་བྱ་བ་སྟེ།",
    "བདག་ཉིད་ཀྱི་ནང་དུ་ཐིམ་པར་གྱུར་པའོ།",
    "དེའི་གཉེན་པོ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཕྱོགས་མེད་པར་དངོས་པོ་ཐམས་ཅད་ལ་བདག་གོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་ཚུལ་གྱི་ང་རྒྱལ་ནི་གཏི་མུག་ཆེན་པོ་སྟེ་གཉིས་པའོ།",
    "དཀར་པོ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དོ།",
    "ཏིང་འཛིན་གང་ལ་བསམ་པ་ཐམས་ཅད་རྫོགས་པར་བྱེད་པར་འགྱུར་བས་མིང་དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "དེ་ཉིད་ནི་མི་ཕྱེད་པར་ཏིང་ངེ་འཛིན་གང་དུ་གྱུར་པ་དེ་ལ་སྙོམས་པར་ཞུགས་ནས་ཞེས་སྔ་མ་བཞིན་དུ་སྦྱར་བར་བྱའོ།",
    "པདྨ་རྣམ་པར་དག་པ་ནི་འདིར་འདོད་ཆགས་ཏེ།",
    "ཕྲག་དོག་ལ་སྤྱོད་པ་རྣམས་ལ་དེ་རྣམ་པར་དག་པའི་ཐབས་བསྟན་པའི་ཕྱིར།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "ཡོངས་སུ་གྱུར་པའི་དབྱེ་བ་རྣམ་པར་དག་པ་ལས་རིགས་ཀྱི་དབྱེ་བ་བསྟན་པའི་ཕྱིར།",
    "ཞེ་སྡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་འདོད་ཆགས་དང་ཞེ་སྡང་དང་།",
    "དེ་རྣམ་པར་དག་པས་གྲོལ་བ་ཡིན་ཏེ།",
    "དེའི་བདག་ཉིད་ཅན་གྱི་མི་གནས་པ་རབ་ཏུ་སྒྲུབ་པར་བྱེད་པའོ།",
    "དེ་ཉིད་ནི་འདའ་བར་བྱ་བ་མ་ཡིན་པས་ན་དམ་ཚིག་སྟེ་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་སོ།",
    "མི་བསྐྱོད་པ་རྗེས་སུ་མཉེས་པའི་ཏིང་ངེ་འཛིན་ལས་བྱུང་བས་ན་མི་བསྐྱོད་པའི་རིགས་དང་འབྲེལ་བ་ནི་མཱ་མ་ཀཱི་སྟེ་རིགས་ཀྱི་རྣམ་པར་གཞག་པ་འདི་ལྟ་བུ་ནི་གཞན་དག་ལ་ཡང་སྦྱར་བར་བྱའོ།",
    "ཤར་ཕྱོགས་ཀྱི་གྲྭར་ཞེས་བྱ་བ་ནི་པདྨའི་ནང་ན་མཚམས་གང་དུ་མཱ་མ་ཀཱི་བཞུགས་པ་དེ་ཉིད་ཀྱི་མཚམས་སུ་བཞུགས་པ་སྟེ་དེ་ཡང་བདེན་བྲལ་གྱི་མཚམས་ཉིད་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་དེ་དེ་ནི་སྤྱན་ལ་རྗེས་སུ་མཉེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་འདོད་ཆགས་འཛིན་པ་རྗེས་སུ་མཉེས་པར་བྱེད་པ་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་འོད་དཔག་ཏུ་མེད་པའོ།",
    "དེ་བཞིན་དུ་ཏིང་ངེ་འཛིན་སྔ་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལེའུ་བཅུ་གསུམ་པ་ལས་གསུངས་པའི་ཆོ་ག་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བགེགས་འཇོམས་པར་བྱེད་པའི་སྒོ་སྲུང་གདོན་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་དེ་དེའི་དཀྱིལ་འཁོར་ནི་སྐུའི་དཀྱིལ་འཁོར་རོ།",
    "དེ་རྣམས་ལ་དད་པ་རྣམ་པར་དག་པ་བརྟེན་པ་པོའི་ཚུལ་ནི་གཤིན་རྗེ་མཐར་བྱེད་ཅེས་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་དེ།",
    "དེ་རྣམ་པར་དག་པ་བརྟེན་པ་པོའི་ངོ་བོ་སྟེ་ཤེས་རབ་མཐར་བྱེད་དོ།",
    "དེ་ཉིད་ནི་སྔ་མ་བཞིན་བསྙེམས་པར་བྱེད་པའོ།",
    "དེ་རྣམས་ལ་འདུན་པ་ལ་སོགས་པས་དམིགས་པར་བྱེད་པ་ལ་མི་བརྗེད་པའི་མཚན་ཉིད་ཅན་གྱི་དྲན་པ་དང་བརྩོན་འགྲུས་རྩོམ་པ་ལ་ཉེ་བར་གནས་ཤིང་།",
    "དམིགས་པ་བརྗེད་པའི་གཉེན་པོ་ལ་ཀུན་དུ་སྤྱོད་པས་འདུན་པ་མེད་པ་ལ་སོགས་པ་རྣམ་པར་འཇིག་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ནི་མི་ཕྱེད་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་མི་བསྐྱོད་པ་ལྟ་བུར་སྙོམས་པར་ཞུགས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་སྟེ་དེ་རྣམས་ཀྱི་སྐུ་ལ་སོགས་པའི་དཀྱིལ་འཁོར་རོ།",
    "དེར་བཞུགས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་སྣང་མཛད་ཐུགས་གཙོ་འོད་དཔག་མེད།",
    "བྲི་བའི་དཀྱིལ་འཁོར་གྱི་རྗེས་སུ་འབྲངས་ནས་ཁྲོ་བོ་རྣམས་ལ་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "དྲན་པ་འཇོག་པ་རྣམས་ནི་དགུག་པ་ལ་སེམས་མཉམ་པར་འཇོག་གོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་ལེའུའི་གཞུང་རྫོགས་སོ།",
    "ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "རང་སེམས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གཞན་ཡང་གསུངས་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་དེ་ཉིད་བརྟེན་པར་བྱས་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ་དམིགས་སུ་མེད་པའི་ཡེ་ཤེས་ཙམ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དེ་རྣམ་པར་སྤངས་པའོ།",
    "ཕུང་པོ་ལ་སོགས་ཁྱད་པར་དུ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཐུགས་ཀྱིས་མཁྱེན་ནས་ཞེས་བྱ་བ་ནི་དག་པ་འཇིག་རྟེན་པའི་ཡེ་ཤེས་ཉིད་ཀྱིས་སོ།",
    "སེམས་ཚིག་ཏུ་བརྗོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ངག་དང་སེམས་ཀྱང་ཁྱད་པར་མེད་པར་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཉན་པ་པོ་དེ་རྣམས་དངོས་པོའི་ངོ་བོ་ཉིད་ཅི་ལྟར་གནས་པ་བཞིན་དུ་དེ་ཉིད་རྗེས་སུ་བརྗོད་པ་ཡིན་པར་སྡུད་པར་བྱེད་པས་སྨྲས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ཀྱི་སྐུ་དང་གསུང་ཐུགས་ནམ་མཁའ་ལྟ་བུར་ཞེས་བྱ་བ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ཚུལ་དུ་ཡང་དག་པར་སྦྱར་ནས་ཆེད་དུ་བརྗོད་པ་ཞེས་བྱ་བ་ཆེད་ཀར་བརྗོད་དོ་ཞེས་བྱ་བ་སྨྲས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཨེ་མའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྟགས་པའི་རྣམ་པ་མེད་པ་ལ་སོགས་པ་གང་ཡིན་པ་དེའི་སྐྱེ་བ་མེད་པའི་ཚུལ་གྱིས་ན་དངོས་པོ་གནས་པར་གྱུར་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ལེའུ་གསུམ་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་མེད་པར་ཡང་དངོས་པོ་མེད།",
    "འདོད་པར་བྱ་བ་ཡིན་པས་ན་འདོད་པའོ།",
    "དེ་ཉིད་ནི་རྣམ་པར་དག་པ་ཉིད་ཀྱི་ཚུལ་གྱིས་གོམས་ཤིང་བསླབ་པར་བྱ་བ་ཡིན་པས་ན་ཡོན་ཏན་ནོ།",
    "གཟུགས་སོགས་ཡུལ་རྣམས་རྣམ་པར་དག་པ་ནི།",
    "དེ་དག་ནི་འདིའི་འོག་མ་རྣམས་ལ་ཤེས་པར་བྱའོ།",
    "འདི་ཡང་གོང་མ་དང་འོག་མ་གཉིས་ཀ་ལ་ཡང་སྦྱར་ཤེས་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱིས་ན་མརྒད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་རྫོགས་པའི་ལྷ་རྣམས་བྱིན་གྱིས་བརླབ་པའི་སྔགས་གསུངས་པ་ཡིན་ཏེ།",
    "དེའི་ངོ་བོ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བྱ་བར་སྦྱོར་རོ།",
    "རྟག་པར་ཞེས་བྱ་བ་ནི་ཅི་སྲིད་སེམས་རྩེ་གཅིག་པར་གྱུར་གྱི་བར་དུའོ།",
    "ཞེས་དགར་བའི་ཚིག་ཏུ་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཡང་ཉི་མའི་དཀྱིལ་འཁོར་ཉིད་དུ་ཡང་དག་པར་བྱུང་ཞིང་ལྡན་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ཅི་ལྟར་ཤེས་ཤེ་ན་དེ་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་གླེང་གཞིའི་ལེའུ་ལས་གསུངས་ལ།",
    "དེར་སོགས་པ་ཞེས་སྨོས་པས་ནི་ཉི་མའི་དཀྱིལ་འཁོར་ཉིད་ཡིན་པར་འདོད་དོ།",
    "འདིར་ཡང་རྣམ་པར་སྣང་མཛད་ཀྱི་གདན་ནི་ཟླ་བའི་དཀྱིལ་འཁོར་ཡིན་པས།",
    "གསལ་བའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བའི་སྒྲས་ངེས་པ་ཉིད་དུ་གསུངས་ལ།",
    "དོན་གྱིས་ན་མི་བསྐྱོད་པ་ལ་སོགས་པ་བཞིའི་གདན་ནི་ཉི་མའི་དཀྱིལ་འཁོར་ཉིད་ཡིན་པར་ཤེས་སོ།",
    "རྡོ་རྗེ་ལས་བྱུང་བའི་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཛིན་པ་ལས་ཡང་དག་པར་བྱུང་བའོ།",
    "ཐམས་ཅད་འཛིན་པའི་ཚུལ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཚུལ་ཡིན་ལ་ཚུལ་ཉིད་ཀྱང་ཐམས་ཅད་མཁྱེན་པ་སྟེ་དེ་ཐོབ་པའོ།",
    "ཚིགས་སུ་བཅད་པ་གཉིས་པས་ནི་སྐུའི་དཀྱིལ་འཁོར་སྤྲུལ་པར་གསོལ་བ་བཏབ་པ་ཡིན་ནོ།",
    "ཚིགས་སུ་བཅད་པ་བཞི་པས་ནི་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་སྤྲུལ་པར་གསོལ་བ་བཏབ་པ་ཡིན་ནོ།",
    "ལེགས་པར་བཀལ་ཞེས་བྱ་བ་ནི་ཤིན་ཏུ་ལེགས་པར་བསྒྲིལ་བའོ།",
    "ཞེས་བྱ་བའི་བར་ལས་ཤེས་པར་བྱའོ།",
    "ཐིག་གདབ་པའི་ཆོ་ག་ཡང་དེ་ཉིད་ལས་ཤེས་པར་བྱའོ།",
    "ཕྱག་རྒྱ་དགོད་པར་བྱ་ཞེས་བྱ་བ་ནི་མཚན་མའི་ཕྱག་རྒྱ་དགོད་པ་ལ་བྱའི་ཞལ་དང་ཕྱག་ལ་སོགས་པ་དང་ལྡན་པའི་ཕྱག་རྒྱ་དགོད་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཞེས་བྱ་བ་ནི་ཐུགས་རྣམ་པར་དག་པའི་རྡོ་རྗེ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཉི་མའི་དཀྱིལ་འཁོར་ལ་བྲི་བར་བྱ་སྟེ།",
    "དཀྱིལ་འཁོར་འདི་ནི་ཐུགས་གཙོ་བོར་བྱས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་སྐུ་ལ་སོགས་པ་རྣམ་པར་དག་པ་འཁོར་ལོ་ལ་སོགས་པ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་མཚན་ཏེ།",
    "འཁོར་ལོ་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཤར་ཕྱོགས་ཀྱི་སྒོའི་ངོས་གཉིས་སུ་གཞག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྐུ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཀྱི་ཡི་གེ་གསུམ་གྱིས་གདོན་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཟླ་བ་ཉི་མར་གདན་བྱས་པར།",
    "ད་ནི་སྒྲུབ་པ་གཙོ་བོ་ཡིན་པར་སྟོན་པ་ནི།",
    "དེ་ལྟར་ཐུགས་གཙོ་བོར་གྱུར་པའི་དཀྱིལ་འཁོར་ནི་ལེའུ་བཅུ་དྲུག་པ་ལས་འདི་ཉིད་ཀྱི་ཚུལ་དང་རྗེས་སུ་མཐུན་པ་ཉིད་དུ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ལེའུ་ལྔ་པས་སྒྲུབ་པ་པོའི་ཁྱད་པར་གྱི་སྤྱོད་པའི་ཁྱད་པར་བསྟན་པའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་མི་རྟོག་པའི་དོན་ནི་ཐེ་ཚོམ་དང་བྲལ་བའི་དོན་ཏེ།",
    "ཕྱིས་དེ་རྣམ་པར་དག་པར་གྱུར་པ་ཡིན་ལ་དེ་ཡང་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་དོ་ཞེས་སྦྱར་བར་བྱའོ།",
    "ཡང་གང་ཞིག་འགྲུབ་པར་མི་འགྱུར་ཞེ་ན།",
    "རྣམ་པར་མི་རྟོག་བློ་ཅན་གྱིས།",
    "ཞེས་བྱ་བ་ནི་ཁྱད་པར་དུ་འཕགས་པའི་ཏིང་ངེ་འཛིན་རྣམ་པ་གསུམ་དང་།",
    "རིགས་ངན་ལ་སོགས་པ་ཁྱད་པར་དུ་སྨོས་པ་ནི་ཐེ་ཚོམ་མེད་པར་སྣང་བ་འདི་ལྟ་བུའི་བདག་ཉིད་ཅན་ནི་དེ་ཁོ་ན་ཉིད་དུ་དགག་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པའི་ཕྱིར་རོ།",
    "འཇིགས་པ་ལ་སོགས་སྟོན་པར་མཛད་པ་ཡིན་པས་ན།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་སྟེ་མི་ཕྱེད་པའི་ཡེ་ཤེས་ཀྱི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བྱ་བར་སྦྱོར་རོ།",
    "དེས་དོན་དག་པར་འགྱུར་བའི་བདག་མེད་པའོ་ཞེས་མཚམས་སྦྱར་བའོ།",
    "རྣམ་པར་མི་འགྱུར་ཞེས་བྱ་བ་ནི་དུས་གསུམ་ཆར་ཡང་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཅན་གྱི་ཡིན་པའི་ཕྱིར་རོ།",
    "ཐུགས་རྡོ་རྗེ་བྱིན་གྱིས་བརླབ་པའི་སྔགས་བརྗོད་པའི་དུས་སུ་མི་བསྐྱོད་པ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "མི་བསྐྱོད་པ་རྡོ་རྗེའི་སྒྲས་ནི་སྟོན་པ་པོ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་བྱའོ།",
    "དེ་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བྱའོ།",
    "དེ་ཉིད་ནི་ཁམས་གསུམ་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་པས་ན་གནས་སོ།",
    "ཡི་གེ་ཧཱུཾ་ལ་སོགས་པས་རྣམ་པར་བསྒོམ་ཞིང་བསྐྱེད་པར་བྱ་བ་གང་ཡིན་པའོ་ཞེས་མཚམས་སྦྱར་རོ།",
    "བསྒྲུབ་པ་ཉིད་དུ་བྱ་ཞེས་བྱ་བ་ནི་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ་བསྐྱེད་པར་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེས་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "རིན་ཆེན་འབྱུང་ལྡན་ཉིད་ནི་འདི་ཉིད་ཀྱི་རྗེས་སུ་མཉེས་པར་བྱེད་པའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "གདོན་མི་ཟ་བའི་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་དོན་ཡོད་པར་གྲུབ་པ་ལྟ་བུ་སྟེ།",
    "ཨོཾ་སརྦྦ་ཏ་ཐཱ་ག་ཏ་པཱུ་ཛ་སྭ་བྷཱ་བ་ཨཱཏྨ་ཀོཧཾ་ཞེས་བྱ་བའི་བར་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "ད་ནི་སྐུ་ལ་སོགས་པ་བྱིན་གྱིས་རློབ་པར་མཛད་པའི་བདེ་བར་གཤེགས་པའི་ཚོགས་རྣམས་ཡང་དག་པར་བསྐུལ་བའི་འོད་ཟེར་དང་།",
    "ཚིགས་སུ་བཅད་པ་ལ་སོགས་པ་བསྟན་པའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔགས་ལ་དམིགས་པ་ནི་ངེས་པར་བསམ་པའོ།",
    "དེའི་འོག་ཏུ་ངག་དང་ཞེས་བྱ་བ་ནི་བྱིན་གྱིས་རློབ་པའི་སྔགས་ཀྱི་ལས་ཀྱི་རྣམ་པ་ལྟ་བུའི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་རྣམ་པར་བསྒོམ་ཞེས་བྱ་བ་བྱིན་གྱིས་བརླབ་པར་བྱ་ཞིང་བསྒྲུབ་པར་བྱ་བའོ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "འདི་ཉིད་ཀྱི་ཁྱད་པར་བསྟན་པའི་ཕྱིར།",
    "རྡོ་རྗེ་པདྨ་རྣམ་པར་བསྒོམ།",
    "ཞེས་བྱ་བ་ནི་བེམས་པོའི་ལུས་ལ་སོགས་པ་རྣམ་པར་འདས་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ལེའུ་བདུན་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་སྟོན་པར་བྱེད་པའི་ལེའུ་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གསང་སྔགས་པ་རྣམས་ཀྱིས་གསང་སྔགས་སྒྲུབ་པ་ལ་འཇུག་པར་སློབ་པའོ།",
    "དེ་ལྟར་ན་འདི་ནི་རྣམ་པར་སྤྲོས་པའི་ཚུལ་བསྟན་ནས།",
    "རྣམ་པར་སྤྲོས་པ་མེད་པའི་ཚུལ་དུ་རྡོ་རྗེ་སེམས་དཔའ་གསུངས་པ་ནི་གཟུགས་དང་སྒྲ་ལ་སོགས་པ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ལྷ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པར་རོ།",
    "རིགས་ཀྱི་ཚུལ་དུ་རྣམ་པར་བསྒོམ།",
    "སྤྲོ་བ་ལ་སོགས་པའི་ཚུལ་གྱིས་ཕྱིས་དྲན་པར་བྱ་བ་ཡིན་པས་ན་རྗེས་སུ་དྲན་པའོ།",
    "གལ་ཏེ་རྗེས་སུ་མཐུན་པའི་མཚན་ཉིད་དང་ལྡན་པ་རྙེད་ན་ཕྱི་རོལ་གྱི་རིག་མའི་རྣམ་པར་དག་པ་གསུངས་པ་ནི་ལོ་གྲངས་བཅུ་དྲུག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྡོ་རྗེ་དང་པདྨ་འི་རྣམ་པར་དག་པ་གསུངས་པ་ནི་ཡི་གེ་ཧཱུཾ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཡི་གེ་ཨོཾ་ནི་རྡོ་རྗེའི་ནོར་བུའི་ཆ་གྲུབ་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་དག་པའི་གཟུགས་ལ་སོགས་པའི་ཕུང་པོས་གང་བའོ།",
    "མཁའ་དང་མཚུངས་པར་སྤྱོད་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་ནམ་མཁའ་དང་མཉམ་པར་ཀུན་དུ་རྒྱུ་བའི་ངང་ཚུལ་ལོ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་གཅིག་ཏུ་བསྡུས་པའི་རྗེས་སུ་དྲན་པ་གསུངས་པ་ནི་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཡང་དམ་ཚིག་རྗེས་སུ་དྲན་པའི་དབྱེ་བ་གསུངས་པ་དེ་ནི་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གསད་ན་ཞེས་བྱ་བ་ནི་རོ་གཅིག་པར་བྱའོ།",
    "དོན་དམ་པར་ནི་དེ་ཐམས་ཅད་དབྱེར་མེད་པ་ཉིད་ཡིན་ནོ།",
    "ཚེ་འདི་ཉིད་ལ་ཞེས་བྱ་བ་འདིར་ནི་ཉིན་མཚན་གྱི་སྦྱོར་བས་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "སྐུ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་བརྒྱད་པ་དམ་ཚིག་ལེའུ་གསུངས་པ་ཡིན་ཏེ།",
    "གསོལ་བ་བཏབ་པའི་རྗེས་ཐོགས་ཉིད་ལ་ལན་གསུངས་པ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གཙང་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཙང་སྦྲ་དང་ལྡན་པའོ།",
    "རྒྱལ་བ་ཉིད་སྐྱེས་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལས་བྱུང་བའོ།",
    "རིགས་ལྔའི་ཚོགས་སུ་བྱ་བ་གསུངས་པ་ནི་ནུ་མའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རྐང་པའི་བར་ཞེས་བྱ་བ་ནི་བརླ་གཉིས་ཀྱི་མཚམས་ལ་སོགས་པར་རོ།",
    "ལྟེ་བ་དང་རྐེད་པ་དང་གསང་བར་རྒྱལ་བའི་ངོ་བོ་ཉིད་ཀྱི་ས་བོན་རིགས་ལྔའི་དགོད་པར་བྱའོ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "དེ་ལྟར་སོ་སོར་བསྐྱེད་ནས་བདག་དང་ལྷན་ཅིག་ཏུ་བྱའོ་ཞེས་གསུངས་པ་ནི་ཞི་བ་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཤེས་རབ་དེ་ཉིད་ཁྱད་པར་དང་བཅས་པར་གསལ་བར་གསུངས་པ་ནི་རིན་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "མེ་ཏོག་ཀར་ཎི་ཀ་དང་ཞེས་བྱ་བ་ལ་སོགས་པའི་མེ་ཏོག་བཞིས་ནི་སྤྱན་ལ་སོགས་པ་བཞི་ཡིན་པར་འདོད་དོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་རྫོགས་པར་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ལེའུ་དགུ་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་བདག་ཉིད་དུ་བྱས་པའོ།",
    "བསམ་གཏན་ལས་བྱུང་བའི་ལས་ཀྱི་ཚོགས་གསུངས་པ་ནི་ནམ་མཁའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཁ་སྦྱར་དབྱེ་བ་ལ་སོགས་པའི་ཆོ་གས་རྡོ་རྗེས་ཕྱེ་མར་བརླག་པར་བྱའོ་ཞེས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "བདེ་བའི་ཁྱད་པར་ལ་ཆགས་པས་མཐོ་རིས་ཀྱི་དོན་དུ་ཕྱུགས་ཀྱི་མཆོད་སྦྱིན་བྱེད་པ་ལ་སོགས་པ་ལྟ་བུ་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་གཞན་དག་ཏུ་ཡང་ཤེས་པར་བྱའོ།",
    "སེར་སྣས་བསྒྲུབས་པའི་ཡི་དྭགས་ལ་སོགས་པའི་འགྲོ་བ་དགག་པར་བྱ་བའི་ཕྱིར།",
    "མ་བྱིན་པར་ལེན་པ་རྣམ་པར་དག་པར་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འཁོར་ལོའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "འདི་དག་ཀྱང་ཐམས་ཅད་དུ་ཤེས་པར་བྱའོ།",
    "འདོད་པས་ལོག་པར་གཡེམ་པའི་སྤྱོད་པ་རྣམ་པར་དག་པ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདི་ནི་འདོད་ཆགས་ཀྱི་རིགས་ཀྱི་དམ་ཚིག་སྟེ་སྦྱོར་བ་གཞན་དག་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ན་ལུས་ཀྱི་ལས་རྣམ་པ་གསུམ་རྣམ་པར་དག་པ་བསྟན་ནས།",
    "བརྫུན་དུ་སྨྲ་བ་རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་ཐོགས་མེད་ཅེས་བྱ་བ་ནི་གདོན་མི་ཟ་བར་གྲུབ་པ་སྟེ་གཞན་དག་ལ་ཕན་པར་བྱ་བའི་ཕྱིར།",
    "ཚིག་དེ་གདུལ་བྱའི་སྐྱེ་བོ་རྣམས་ལ་ཕན་གདགས་པར་བྱ་བའི་ཕྱིར་སྤྲོ་བར་བྱའོ།",
    "དེས་ལྷ་རྣམས་ཀྱི་འཁོར་ལོ་བསྟེན་ན་བླ་ན་མེད་པའི་ཡེ་ཤེས་ཐོབ་པར་འགྱུར་རོ།",
    "སེམས་རྣམ་པར་དག་པར་བྱེད་པ་ནི་གཞན་དག་མེད་དེ།",
    "དེ་བས་ན་བདག་ཉིད་དེ་རྣམ་པར་དག་པར་བྱེད་པ་ཡིན་ནོ།",
    "སེམས་རྣམ་པར་དག་པ་དེ་ཡང་དེ་དང་དེར་མང་དུ་གསུངས་པ་ཉིད་ཡིན་ནོ།",
    "མ་འོངས་པའི་འགྲོ་བ་རྣམས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་ངོ་མཚར་ལ་སོགས་པ་བརྗོད་པ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རྨད་བྱུང་ཆེན་པོ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་འདིས་ནན་དུ་བྱས་ནས་ཤེས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དག་པ་ལས་ཞེས་བྱ་བ་ནི་འགལ་བའི་ལས་རྣམ་པར་དག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ནི་རྣམ་པར་ཤེས་པར་གྱུར།",
    "ལེའུ་བཅུ་པར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཡང་དག་པར་བསྐུལ་བ་བསྟན་པ་གསུངས་པ་ནི།",
    "དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "ལས་རྣམས་བྱེད་པར་རིག་པར་བཤད།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྐུའི་སྒོ་ནས་རྩོམ་པའི་སྔགས་ཀྱི་རྣམ་པར་དག་པ་སྟོན་ཏོ།",
    "འདར་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྔགས་ཀྱི་ཆེ་བའི་བདག་ཉིད་གསུངས་པ་ཡིན་ཏེ།",
    "ད་ནི་རྒྱལ་བ་སྐྱེད་པར་བྱེད་པའི་ཡུམ་གྱི་སྐུ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་ཟླ་བ་གཉིས་ཀྱི་རྗེས་ཐོགས་ལ།",
    "ཧཱུཾ་དང་ལྡན་པའི་རྡོ་རྗེ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་ལས་བྱུང་བའི་སྐུ་ལ་སོགས་པའི་རྡོ་རྗེ་གསུམ་རྣམ་པར་བསམ་པར་བྱའོ།",
    "རྡོ་རྗེ་ཀྱོ་བའི་ཁྱད་པར་གྱིས།",
    "དོན་འདི་ཉིད་རབ་ཏུ་བསྒྲེ་བའི་ཕྱིར་གསུངས་པ་ནི་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་སྔགས་ཀྱི་སྐྱེས་བུ་ནི་ལྷ་རྣམས་སོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ལེའུ་བཅུ་གཅིག་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ལས་བྱུང་བའི་རིག་པའི་སྐྱེས་བུ་སྟེ་དེ་སྟོན་པར་བྱེད་པའི་ལེའུ་བཅུ་གཅིག་པ་འདི་གསུངས་པའོ།",
    "ཡེ་ཤེས་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་ཟླ་བ་ཞུ་བ་ལ་གླུ་ཡིས་བསྐུལ་བ་ལ་སོགས་པ་གཞན་དག་ཏུ་གསུངས་པ་འདིར་སྦྱར་བར་བྱའོ།",
    "སྔགས་ཀྱི་བཟླས་བརྗོད་དང་འབྲེལ་བའི་ཡི་གེ་གསུམ་པོ་གདན་དང་བཅས་པ་གསུངས་པ་ནི་རྡོ་རྗེ་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་དེ་དག་ལ་གནས་པ་ནི་ཡི་གེ་ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་བྱ་བ་སྤྲོ་བ་བསྒོམ་ཞིང་བཟླས་པར་བྱའོ།",
    "གནས་དེར་བརྟན་པར་བྱས་ནས་ནི།",
    "ཡང་ན་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཉིད་ནི་མི་ཕྱེད་པ་ཉིད་ཡིན་པས་ན་རྡོ་རྗེའི་དཀྱིལ་འཁོར་རོ།",
    "གང་ཡང་ཕན་ཚུན་དབྱེ་བ་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "རྡོ་རྗེའི་དཀྱིལ་འཁོར་དབུས་གནས་པར།",
    "གསང་བའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཉིད་དོ།",
    "ཡི་གེ་ཨཱ་ནི་རྣམ་པར་བསམ།",
    "ཞེས་བྱ་བ་སྟེ་འཁོར་ལོ་ལ་སོགས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "མཉེས་པར་བྱེད་པ་ནི་ཡི་གེ་ཧོ་དམར་པོ་གཉིས་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཞེས་གསུངས་པ་དེའི་དོན་གནས་ནི་ཡི་གེ་གསུམ་གྱི་མཚན་ཉིད་ཅན་ཏེ་སྐུ་རྡོ་རྗེ་ལ་སོགས་བསྐྱེད་པའི་ས་བོན་གསུངས་པ་ནི་ཨོཾ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་བཞིན་དུ་གསུང་རྡོ་རྗེ་དང་ཐུགས་རྡོ་རྗེ་དག་ལ་ནི་ཡི་གེ་ཨཱ་དང་ཧཱུཾ་ས་བོན་ཡིན་པར་གསུངས་པ་ནི་ཨཱ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དམ་ཚིག་ཅེས་བྱ་བ་ནི་དམ་ཚིག་སེམས་དཔའ་སྐྱེད་པར་བྱེད་པའི་མིག་ལ་སོགས་པ་བྱིན་གྱིས་རློབ་པར་བྱེད་པའི་དམ་ཚིག་དང་བཅས་པ་སྟེ།",
    "འདིས་ནི་སྐུ་རྡོ་རྗེ་དང་འོད་མཉམ་པར་འགྱུར་གྱི་སྐུའི་རྡོ་རྗེ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "ཐུགས་རྡོ་རྗེའི་རྟོག་པའི་དངོས་གྲུབ་གསུངས་པ་ནི་རྡོ་རྗེའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འཕགས་པ་འཇམ་དཔལ་གྱི་དངོས་གྲུབ་གསུངས་པ་ནི་རྡོ་རྗེའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རང་སྔགས་སྐྱེས་བུ་ནི་འཕགས་པ་འཇམ་དཔལ་ཏེ།",
    "ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་གཞན་དག་གསུངས་པ་ནི་ནམ་མཁའི་དབྱིངས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "མི་བསྐྱོད་པ་རྣམ་པར་བསམས་ལ་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་དེའི་ཐུགས་ཀར་ཡི་གེ་ཨོཾ་བསམ་པར་བྱའོ།",
    "སྦྱོར་བའི་ཁྱད་པར་གཞན་གསུངས་པ་ནི་ནམ་མཁའི་དབྱིངས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ནམ་མཁའ་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་རིན་ཆེན་འབྱུང་ལྡན་ནོ།",
    "གནས་གསུངས་པ་ནི་རྣམ་པར་དབེན་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་པས།",
    "དེ་བཞིན་དུ་མཚན་མ་གཞན་དག་ལ་ཡང་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "ཡི་གེ་བྷྲཱུཾ་གྱི་རྗེས་ལ་འཁོར་ལོ་ལ་སོགས་པ་ཁང་པ་བརྩེགས་མའི་རྒྱུ་ཡིན་པར་གསུངས་པ་ནི་རྡོ་རྗེ་མཁའ་འགྲོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདི་ནི་སྦྱོར་བ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྡོ་རྗེ་ནམ་མཁའ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "དེ་བཞིན་དུ་འདིར་དཔག་ཏུ་མེད་པ་དང་མི་བསྐྱོད་པ་དག་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ལེའུ་བཅུ་གཉིས་པ་གསུངས་ཏེ།",
    "མཾ་ཞེས་བྱ་བ་ལ་སོགས་པས་མི་སྣང་བའི་དངོས་གྲུབ་གསུངས་པ་ཡིན་ཏེ།",
    "འདིར་གང་དང་གང་མ་གསུངས་པ་དེ་ནི་སྔ་མ་དང་ཕྱི་མས་ཁ་བསྐང་བར་བྱའོ།",
    "འདིར་ཡང་གོང་མ་དང་འོག་མའི་ཁ་བསྐང་བ་ལ་ལྟོས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་དང་པདྨ་དང་རལ་གྲི་ལ་ཡང་བསྐྱེད་པ་ལ་སོགས་པ་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "མཁའ་དབྱིངས་གསལ་བའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་ལ་སོགས་པ་ལ་ཡང་གཟུང་བར་བྱ་བར་གསུངས་པ་ནི་མཁའ་དབྱིངས་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ཐམས་ཅད་ནི་སྔ་མ་དང་འདྲའོ།",
    "རྩེ་གསུམ་ལ་སོགས་པ་ལ་ཡང་སྐྱེས་པ་ལ་སོགས་པ་གསུངས་པ་ནི་ཏྲི་ཤུ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རྡོ་རྗེ་ཁྱད་པར་གྱིས་ཞེས་བྱ་བ་ནི་བདག་པོའི་རྗེས་སུ་མཐུན་པའི་ཚུལ་དུའོ།",
    "ད་ནི་དགུག་པའི་སྦྱོར་བ་གསུངས་པ་ནི་ལམ་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རྡོ་རྗེ་དགུག་པ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དགུག་པའོ།",
    "དེ་ནི་ཏིང་ངེ་འཛིན་གསུམ་གྱི་སྦྱོར་བ་ཡང་དག་པར་རྫོགས་པའི་ལྷའི་སྐྱེས་བུར་བདག་ཉིད་བསམས་ལ་སྦྱོར་བ་གསུམ་དང་ལྡན་པའི་ལྕགས་ཀྱུ་བསྒོམས་ཏེ།",
    "མཐུ་ཆེན་པོ་དང་ལྡན་པའི་བཟའ་བའི་ཁྱད་པར་རྣམ་པར་སྦྱང་བར་བྱ་བའི་ཕྱིར།",
    "སྐུ་ལ་སོགས་པའི་རྡོ་རྗེ་ཅན་ནི་ཕྱག་རྒྱ་བཞི་ལ་སོགས་པ་དང་ལྡན་པར་བསྟན་པའི་ཕྱིར་རྣམ་པའི་མཆོག་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ནི་རྡོ་རྗེ་གསུམ་ཉིད་འཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡི་གེ་ཧཱུཾ་ཡང་འདིར་བར་སྣང་ལ་རྡོ་རྗེའི་བདག་ཉིད་ཅན་གྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་ལྡན་པ་ཐོད་པར་གནས་པར་བྱའོ།",
    "ཞེས་བྱ་བ་སྟེ་འདི་ནི་འདིའི་ཕན་ཡོན་གསུངས་པའོ།",
    "ད་ནི་ཡན་ལག་བཞི་པོའི་འབྲས་བུ་དང་བཅས་པ་བསྟན་པའི་ཕྱིར་བསྙེན་པའི་དམ་ཚིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་འདི་ཉིད་ཆུང་ངུ་དང་ཆེན་པོ་ལ་སོགས་པའི་དབྱེ་བས་རྣམ་པར་དབྱེ་བ་ནི་བསྙེན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ཏིང་ངེ་འཛིན་ནི་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་གྱི་དཀྱིལ་འཁོར་གྱི་བདག་པོ་སྟེ།",
    "ཉེ་བར་སྒྲུབ་པའི་ཡན་ལག་དང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ཆུང་ངུ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཚུལ་དུ་གསུངས་པ་ནི་ཉེ་བར་སྒྲུབ་པ་ལ་སོགས་པ་སྟེ་ཉེ་བར་སྒྲུབ་པའི་དངོས་གྲུབ་ཀྱི་མཆོག་ནི་གང་རྡོ་རྗེའི་བདག་ཉིད་ཅན་དུ་མིག་ལ་སོགས་པའི་སྐྱེ་མཆེད་རྣམ་པར་དཔྱད་པའོ།",
    "སྨིན་ལས་ཐམས་ཅད་མཁྱེན་ཉིད་འགྱུར།",
    "མཚན་ཉིད་དག་དང་བྲལ་བར་དམིགས་པར་བྱ།",
    "ཕྱོགས་ཚོགས་ཀུན་ན་བཞུགས་པ་ཡི།",
    "བསྙེན་པ་ཉིད་ཁྱད་པར་དུ་དབྱེ་བ་གསུངས་པ་ནི་བསྙེན་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ལ།",
    "དེ་ལྟར་གཡེང་བ་མ་ལུས་པ་བསལ་བར་མི་ནུས་ཤིང་ཡེ་ཤེས་ཤིན་ཏུ་བྱང་བའི་རང་བཞིན་མ་ཡིན་པས་ན་ཆུང་ངུའི་སྒྲས་ཁྱད་པར་དུ་ཕྱེ་བ་ཡིན་པས་ཤེས་པར་བྱའོ།",
    "ད་ནི་དཀྱིལ་འཁོར་གྱི་ལྷ་མ་ལུས་པར་གཏོགས་པས་སྤྱིའི་བསྙེན་པ་དང་།",
    "དེ་བཞིན་དུ་ཉེ་བར་སྒྲུབ་པ་ཆེན་པོ་ལ་སོགས་པ་ལ་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ཆེན་པོ་ནི་དཀྱིལ་འཁོར་པའི་ལྷ་རྣམས་ཀྱི་སྤྱིའི་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཡན་ལག་བཞི་པོ་ཆུང་ངུ་དང་ཆེན་པོ་འདི་གཉིས་ཀྱི་བར་ན་གནས་པས་ན་བར་མའི་སྒྲས་ཁྱད་པར་དུ་ཕྱེ་བ་ཡིན་ཏེ།",
    "རང་སྣང་ཤེས་རབ་རྣམ་པར་སྦྱང་།",
    "དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དྲག་ཤུལ་གྱིས་སྒྲུབ་པ་ཡང་ལེའུ་བཅུ་པར་གསུངས་པའི་བསྐུལ་བའི་ཚིགས་སུ་བཅད་པ་འདི་སྦྱར་བར་བྱ་བ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྤྱིའི་བཟླས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "སྔགས་ཀུན་ཉིད་ནི་དོན་ཡིན་ཏེ་དེ་རྣམས་ཀྱི་བཟླས་པ་ལ་རྡོ་རྗེ་གསུམ་གྱི་མི་ཕྱེད་པའི་མཚན་ཉིད་གང་ཡིན་པ་དེ་ནི་འདི་ལྟར་རྡོ་རྗེ་དབྱེ་བ་གསུམ་སྟེ་དེའི་མཐར་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "སྐུ་གསུང་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྔགས་བཟླས་པའི་རིམ་གྱིས་སྤྲོས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཡང་རྣམ་པ་གཞན་དུ་ན་ཅིག་ཅར་སྤྲོ་བ་གསུངས་པ་ནི་ཡང་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་སོ་སོ་ལས་ཅིག་ཅར་ཉིད་དུ་སྐུ་ལ་སོགས་པའི་རྡོ་རྗེ་སྤྲོ་བར་བྱའོ།",
    "ཡེ་ཤེས་སེམས་དཔའ་སྤྲོ་བ་གསུངས་པ་ནི་ལུས་དང་ངག་སེམས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "སྐུ་ལ་སོགས་པའི་བཟླས་པའི་མཚན་ཉིད་སོ་སོར་བསྟན་པ་གསུངས་པ་ནི།",
    "སྒྲའི་ཡེ་ཤེས་ནི་སོ་སོར་སྣང་བའི་བདག་ཉིད་ཅན་ཏེ་དེ་སྒྲ་མ་ཡིན་ཞིང་ཚིག་མ་ཡིན་པ་ཉིད་དུ་རྣམ་པར་དཔྱད་པའོ།",
    "སེམས་གནས་པ་རྡོ་རྗེ་ཉིད་དེ་གནས་པ་མེད་པ་ཉིད་དུ་རྣམ་པར་དཔྱད་པ་འདི་ནི་སེམས་རྣམ་པར་དག་པའི་བཟླས་པ་ཡིན་ནོ།",
    "ཁྲོ་བོ་ལ་སོགས་པའི་བཟླས་པ་གསུངས་པ་ནི་ཁྲོ་བོའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཀུན་དུ་སྐྱོ་བ་ཅིང་ཕན་པར་དགའ།",
    "འདོད་ཆགས་ཉིད་ནི་རྣམ་པར་དག་པ་ཡིན་པས་ན་རྡོ་རྗེའོ།",
    "དེ་ལས་བྱུང་བས་ན་སྔགས་ཀྱི་བདག་ཉིད་ཅན་གྱི་ཚིག་སྟེ་ལུས་ལ་སོགས་པ་ལྷའི་ཚུལ་གྱིས་ཡང་དག་པར་གནས་ནས་སྤྲོས་པར་བྱའོ་ཞེས་ཤེས་པར་བྱའོ།",
    "ཞེ་སྡང་རྣམ་པར་དག་པ་ཉིད་ནི་རྡོ་རྗེ་སྟེ།",
    "ཞེ་སྡང་གནས་ཞེས་བྱ་བ་ལ་ཞེ་སྡང་རྣམ་པར་དག་པ་ནི་མི་བསྐྱོད་པ་སྟེ།",
    "དེ་ལ་རྣམ་པར་གཞག་ཅིང་བསྡུའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "འདོད་པའི་ལོངས་སྤྱོད་ཅེས་བྱ་བ་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་རྣམ་པར་དག་པ་དང་ལྡན་པའི་སེམས་ཀྱིས་ལོངས་སྤྱོད་ཀྱིས་སོ།",
    "ཐིག་ལེའི་རྣལ་འབྱོར་གསུངས་པ་ནི།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་ཤེས་པར་བྱའོ།",
    "ཡང་སྔགས་བཟླས་པ་དང་འབྲེལ་བའི་དོན་གསུངས་པ་ནི།",
    "རིགས་ཀྱི་བདག་པོ་གཞན་གྱིས་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་སྐུ་ཡིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་སྐུ་ནི་རྣམ་པར་སྣང་མཛད་དེ།",
    "ཡང་ན་གཅིག་པུ་ཉིད་ས་རྣམ་པར་དག་པ་ཡིན་དུ་ཟིན་ཀྱང་།",
    "དཀྱིལ་འཁོར་ཆེན་པོའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ན་དཀྱིལ་འཁོར་དེ་རྣམ་པར་བསྒོམས་ལ།",
    "ཞི་བའི་ལས་ལ་དེ་བདག་པོའི་ལྷ་དཀར་པོའི་ཚུལ་དུ་བསམ་པར་བྱ་བ་དང་།",
    "དོན་ཡོད་པར་གྲུབ་པའི་ཚུལ་དམར་པོའི་རྣམ་པར་གཟུང་བར་བྱའོ།",
    "དེ་ལ་མངོན་སྤྱོད་པའི་ལས་རྣམས་ཀྱི་ཡུལ་གསུངས་པ་ནི།",
    "དེ་ཉིད་ཀྱི་ཆོ་ག་གསུངས་པ་ནི་ཁམས་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེས་ན་བསྒྲུབ་པར་བྱ་བ་དེ་འཆི་བར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའི་དོན་གྱི་ཆོ་གའོ་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "བྲི་བའི་དཀྱིལ་འཁོར་དུ་བགེགས་བསལ་བ་གསུངས་པ་ནི་ནམ་མཁའི་དབྱིངས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་འཁོར་ལོ་གསུངས་པ་ནི་ནམ་མཁའི་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གཤིན་རྗེ་གཤེད་བདག་པོར་གྱུར་པའི་འཁོར་ལོས་དགྲ་རྣམས་གསོད་པར་བྱེད་པ་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་བསམ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྲུང་བའི་འཁོར་ལོ་ལ་སོགས་པ་གསུངས་པ་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་སྐུ་ལ་སོགས་པས་སམ།",
    "རིག་མར་བཅས་པའི་རྣམ་པར་སྣང་མཛད་ཡན་ལག་ཡང་དག་བྱུང་།",
    "རྡོ་རྗེའི་ང་རྒྱལ་དུ་བྱ་བ་གསུངས་པ་ནི་ནམ་མཁའི་དབྱིངས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ཅན་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དང་།",
    "མཱ་མ་ཀཱི་ལ་སོགས་པ་ཡང་རྣམ་པར་བཞག་སྟེ།",
    "དེའི་རྡུལ་ཕྲ་རབ་ཀྱི་གཟུགས་ཀྱི་ཆུ་དེ་བཞིན་གཤེགས་པའི་ཚོགས་ཀྱི་ཆུའི་སྟེང་ནས་བ་ཅག་པར་བྱའོ།",
    "དཔུང་ཕུར་བུས་གདབ་པ་གསུངས་པ་ནི་ཧཱུཾ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཡུལ་ཕྱོགས་སུ་ཉེ་བར་འཚེ་བ་ཞི་བ་གསུངས་པ་ནི་གྲོང་ངམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "བསྐལ་པ་བསྲེག་པ་ལྟར་ཞེས་བྱ་བ་ནི་འཕྲོ་བས་ནམ་མཁའི་ཁམས་ཁྱབ་པར་གྱུར་པའི་རྡོ་རྗེའི་ལྷ་རྣམས་ཀྱིས་ཡུལ་དེ་ཁྱབ་པ་སྟེ་དེ་བས་ན་ཉེ་བར་འཚེ་བ་སྲེག་པར་བྱེད་པའི་སྤྲོ་བ་ལ་སོགས་པའི་ཚུལ་བསམས་ནས།",
    "ཉེ་བར་འཚེ་བ་བསྲེག་པའི་ཡུལ་དེར་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་ཞི་བའི་སྔགས་ཟློས་པའི་རྣལ་འབྱོར་པས་སྦྱིན་པར་བྱའོ།",
    "དེ་ལྟར་ཆོ་ག་བཞིན་དུ་ལས་བྱས་ན་ནོར་ཕུན་སུམ་ཚོགས་པར་ཡང་འགྱུར་རོ་ཞེས་གསུངས་པ་ནི་བསམ་གཏན་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བགེགས་མེད་པར་བྱས་པའི་ཡུལ་དུ་ཉེ་བར་འཚེ་བའི་ཉེས་པ་དགག་པའི་ཕྱིར་ཕུར་བུའི་ཆོ་ག་གསུངས་པ་ནི་རྡོ་རྗེ་བདུད་རྩི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "བདུད་རྩི་ཐབ་སྦྱོར་ཉིད་དུ་སྐུ་སྟོད་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ལ་སྐུ་སྨད་རྡོ་རྗེ་རྩེ་གཅིག་པའི་གཟུགས་ཅན་གྱི་རྡོ་རྗེ་ཕུར་བུ་བྱས་ལ།",
    "ཕུར་བུ་ལ་གདབ་པའི་སྔགས་ཀྱིས་ཕྱོགས་བཅུར་སྤྲོས་ནས་གདབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བའི་མིང་དང་ལྡན་ཞིང་ཡི་གེ་གསུམ་དང་སྤེལ་བའི་འབྱིན་པའི་སྔགས་སམ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "སྔར་སྤྱད་པའི་མངོན་སྤྱོད་དང་རྗེས་སུ་འབྲེལ་བའི་ལས་གསུངས་པ་ནི་ནམ་མཁའ་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེར་གནས་པའི་དགྲ་བོ་ལ་སྲིན་པོ་ལ་སོགས་པས་རྣམ་པར་གཙེས་པར་གྱུར་པར་བསམས་ལ་ཁྲོས་པའི་ལྷའི་རྣལ་འབྱོར་པས་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་སྤེལ་བའི་སྔགས་བཟླ་བར་བྱ་ཞིང་།",
    "མཱ་མ་ཀཱི་དང་ཤེས་རབ་མཐར་བྱེད་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "རྣམ་པར་སྣང་མཛད་ཞལ་གསུམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཡོན་པ་ནི་དཀར་པོ་སྟེ་ཁྱད་པར་ནི་དེ་ཡོད་དོ།",
    "རྡོ་རྗེ་འཛིན་པ་མངོན་དུ་གྱུར་པས་ལྷག་པར་གྲུབ་པར་བསྟན་པའི་ཕྱིར་དོན་དེ་ཉིད་བཟླས་ཏེ་བསྟན་པ་ནི་ནམ་མཁའི་དབྱིངས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བྱ་བ་ནི་སྔར་རྡོ་རྗེ་སེམས་དཔར་གྱུར་པས་རྡོ་རྗེ་སེམས་དཔའ་ཉིད་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་བཞུགས་པའམ།",
    "མི་བསྐྱོད་པ་ཉི་མའི་དཀྱིལ་འཁོར་ལ་བཞུགས་པ་བསམ་པར་བྱ་སྟེ།",
    "སྤྱན་ལ་སོགས་པ་གསུངས་པ་ནི་རྡོ་རྗེའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་ཐུགས་རྣམ་པར་དག་པའི་མཱ་མ་ཀཱིའི་དཀྱིལ་འཁོར་ཏེ་རིགས་ཀྱི་བདག་པོ་རྣམ་པར་དག་པའོ།",
    "ནམ་མཁའ་རྡོ་རྗེ་མཆོག་ཅེས་བྱ་བ་ནི་མཱ་མ་ཀཱི་སྟེ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་བཞུགས་པའོ།",
    "ཨུཏྤལ་མཐིང་ག་ཞེས་བྱ་བ་ནི་འདིར་ཨུཏྤལ་དམར་པོ་ཡིན་པར་བཞེད་དེ།",
    "དངོས་གྲུབ་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་གདོན་མི་ཟ་བར་གྲུབ་པ་རྣམ་པར་དག་པ་སྒྲོལ་མ་གཙོ་བོར་གྱུར་པའི་དཀྱིལ་འཁོར་རོ།",
    "དེ་རྣམས་ནི་དེའི་རིགས་དང་ཡང་དག་པར་འབྲེལ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་སྣང་མཛད་ཐུགས་གཙོ་བོ།",
    "འདོད་པའི་རྒྱལ་པོ་ལ་སོགས་པ་གསུངས་པ་ནི་ཉི་མའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རྡོ་རྗེ་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་མི་ཕྱེད་པའི་དཀྱིལ་འཁོར་ཏེ་དེ་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལེའུ་བཅུ་བཞི་པར་ཞི་བ་ལ་སོགས་པའི་ལས་རྣམས་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་མཆོག་ནི་རྣམ་པར་སྣང་མཛད་ཡིན་པས་མིང་དེ་སྐད་ཅེས་བྱའོ།",
    "དེའི་རྗེས་སུ་འབྲངས་ནས་གཞན་དག་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཕུང་པོ་ལ་སོགས་པ་གང་བར་བྱས་ཏེ།",
    "དེ་ནས་སྔགས་ལས་སྔ་མ་བཞིན་དུ་སྤྲོས་པའི་འོད་ཟེར་གྱི་གོང་བུ་དབབ་པ་ལ་སོགས་པ་བྱས་པར་གྱུར་པས་ཤི་བ་འཚོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "འདིའི་མཛད་པ་གསུངས་པ་ནི་རྡོ་རྗེ་སྲུང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདི་ཡང་སྤྱན་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "དེའི་ལྟེ་བར་མཱ་མ་ཀཱིའི་རྣམ་པར་བསྒོམས་ནས།",
    "ཞེས་བྱ་བ་ནི་སྤྱན་ལ་སོགས་པའི་ལས་རབ་ཏུ་སྒྲུབ་པར་བྱེད་པའོ།",
    "རྒྱས་པ་ནི་རྒྱས་པར་གྱུར་པ་ཉིད་དོ།",
    "དེ་ནས་བསྒྲུབ་པར་བྱ་བ་རྒྱས་པར་འགྱུར་རོ།",
    "ཕྱི་རོལ་ལྟོས་པ་མེད་པར་རོ།",
    "སྒྲོལ་མའི་སྔགས་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "བསྒྲུབ་པར་བྱ་བའི་ཁར་བཅུག་ལ།",
    "ལེའུ་བཅུ་གསུམ་པ་ལས་གསུངས་པའི་སྟོབས་དབབ་པ་ལ་སོགས་པའི་ཆོ་ག་བྱས་ལ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་སྔགས་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་རྣལ་འབྱོར་པས་བཟླས་པ་ལས་གསུངས་པའི་ཆོ་གས་དཔག་ཏུ་མེད་པ་བཟླས་ལ།",
