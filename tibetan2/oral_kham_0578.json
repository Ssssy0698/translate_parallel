    "བྱང་སྣེ་དང་ཐག་མི་རིང་བའི་སར་ང་འཁྱགས་རོམ་ཐོག་འགྱེལ་ནས་དྲན་པ་ཐོར་འདུག་དྲན་པ་གསོས་སྐབས་ངའི་ལུས་སྟེང་དུ་དོམ་དཀར་པོ་ཞིག་ཁ་གདངས་ནས་ང་ཟ་ཉེར་བསྡད་འདུག་ངས་ལྟེབ་གྲི་བཏོན་ནས་ཐེ་ཚོམ་སྤུ་ཙམ་མེད་པར་དོམ་དཀར་གྱི་རྐང་མཛུབ་གསུམ་བཅད་པས་དོམ་དཀར་སྐད་ངན་ཤོར་ཏེ་ལམ་སེང་ང་གློད་བྱུང་།",
    "ང་རང་བློ་ཁོག་ཆེ་ཤོས་ཡིན་ནའང་སྐབས་དེར་ལུས་ཡོངས་འདར་བྱུང་།",
    "ཁོ་བོ་མིག་སྣང་དུ་མི་མཛེས་པ་ཙམ་ལས་ད་དུང་ཁྱེད་དང་མི་སྙོམ་པ་ཅི་འདུག་ཅེས་སྨྲས།",
    "རྔོན་པའི་ཁུག་མ་གཅིག་རས་ཁུག་གཅིག་བཅས་ངེས་པར་ཉོ་དགོས་ཞེས་སྨྲས་པར་ཧན་སིས་ཟ་མཁས་བྱས་ཀྱང་དབུལ་བ་ལས་མི་འདུག་ཅེས་སྨྲེ་ངག་འདོན་བཞིན་དུ་དངུལ་ལྷག་རྣམས་བསྡུ་རུབ་བྱས།",
    "༢བྱི་ལས་བློ་ཕམ་པ་ཞིག་ལ་ཁྱེད་ཀྱིས་བྱི་བར་སྤྲུལ་གནང་ཐུབ་ཀྱི་ཡོད་བཟོ་མི་འདུག་ཅེས་བརྗོད།",
    "ས་རུབ་ཁེར་ཁོ་གཉིས་སྤྲོ་ཁང་དུ་འབྱོར་ནས་གཅན་གཟན་དེས་མཛེས་མ་རང་འགུལ་ངང་ཡོང་བ་ཤེས་རྗེས་མཛེས་མར་ཁྱེད་སེམས་བཟང་ཞིག་ཡིན་འདུག་པས་ངས་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན་ཞེས་སྨྲས་པ་དང་།",
    "དངོས་འབྲེལ་དེ་རང་འདུག་ཡིན་ནའང་ཁྱེད་སེམས་བཟང་པོ་ཡོད་ཤག་བྱེད་ཀྱི་ཡོད་ཅེས་སྨྲས་པར་ཁོས་ཡིད་མཐུན་པའི་རྣམ་པ་བསྟན།",
    "གཅན་གཟན་དྲན་པ་གསོས་ཏེ་ཁྱེད་མེད་སྟབས་ང་རང་ཤི་རྒྱག་རྒྱུའི་བློ་ཐག་བཅད་ཚར།",
    "ཨ་ཙིའི།",
    "འདུག་ཅེས་བརྗོད།",
    "ཁྱེད་ཚོས་བརྗེད་འདུག་གམ་ཞེས་སྨྲས།",
    "ཟེར་བའི་དཔེ་ལྟར་འདུག་བསམ་ན།",
    "སྔགས་ལ་མི་དད་པའི་ནང་དུ་ཞག་བདུན་སོགས་སུ་འདུག་པ།",
    "རློམ་སེམས་ཀྱི་སྒོ་ནས་འབད་པ་བྱས་པས་ཕྱུག་པོར་གྱུར་བའི་དཔེ་མི་སྲིད།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།",
    "ད་ནི་སྐྱོབ་མཁན་ཞིག་མི་འདུག་ད་ངས་ཅི་བྱེད་བསམས།",
    "ཁ་དང་གསང་པ་ལ་བ་དེའང་སྔར་རང་ཉིད་མི་མཇེད་འཇིག་རྟེན་གྱི་ཞིང་འདིར་འདུག་སྐབས།",
    "དེའི་ནང་དུ་ཁྲུས་ལན་གཅིག་བྱས་ཀྱང་རང་རྒྱུད་ལ་ཏིང་ངེ་འཛིན་གྱི་སྒོ་འཕར་བརྒྱ་ཕྲག་ཅིག་ཆར་དུ་འབྱེད་པའི་ནུས་པ་དང་ལྡན་པའོ།",
    "སྤྱི་འདུག་པར་འདོད་ཚེ་རིན་ཆེན་གཞལ་ཡས་ཁང་།",
    "བསམ་པ་ཙམ་གྱིས་ཡིད་འོང་དབེན་པའི་གནས་མཆོག་ཉིད་དུ་གནས་གྱུར་ཏེ་ཏིང་ངེ་འཛིན་གྱི་ངང་དེར་འབྱམས་ཀླས་ནས་འདུག་གོ།",
    "དེ་ལ་གཞལ་ན་རང་ཅག་རྣམས་ཀྱང་ངན་འགྲོ་རུ་འགྲོ་དགོས་ངེས་པ་ཅན་ཡིན་པ་འདྲ་འདུག་འོན་ཀྱང་བདེ་ཅན་དུ་སྐྱེ་བའི་རྒྱུ་བཞི་ལ་འབད་ན།",
    "ཞེས་པའང་རང་གཞན་ལ་ཕན་པའི་སེམས་ཀྱིས།",
    "ཕལ་ཆེར་ཤཱཀྱ་བཤེས་གཉེན་གྱི་རྗེས་སུ་འབྲང་བར་འདུག་ཀྱང་།",
    "གསུང་སྲས་ཉན་ཐོས་དང་རང་རྒྱལ།",
    "བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་པའི་ཉེས་པའི་ཚོགས་ཅི་མཆིས་པ་ཁྲི་ཐམས་ཅད་བཤགས་པ་དང་།",
    "ཅི་ཡང་མི་དྲན་འདུག་ཞུས་པས།",
    "ད་ལྟ་བལྟས་ན་དགེ་སློང་དེ་འཕགས་པ་ཤཱ་རིའི་བུ་ཡིན་འདུག་དེ་ཕྱིན་ཆད་ཁྱིའི་སྐྱེ་བ་ལེན་མ་དགོས་གསུངས།",
    "ཌ་ཀ་ཌ་པ་དེའང་གང་ཡང་ངམ་གང་དག་དུས་གསུམ་གཤེགས་པའི་རྒྱལ་བ་གྲངས་མེད་པ་བློའི་དཔག་ཏུ་མེད་པ་ཇི་སྙེད་ཅིག་བྱོན་པ་དེ་ཡི།",
    "སྤྲོ་ན་གསུམ་པ་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནའི་འགྱུར་སྨོན་ནི།",
    "དབུས་ན་འདུག་པའི་རྡུལ་ཕྲ་རབ་ལ་ལྟོས་ནས་ཕྱོགས་དང་ཡུལ་ཐ་དད་པ་ན་གནས་པའི་རྡུལ་ཕྲ་རབ་རྣམས་བསགས་པ་ཡིན་ན།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ལམ་མངོན་སུམ་དུ་བྱེད་པ་ན་ནི་དེ་ལྟ་མ་ཡིན་ནོ།",
    "སློབ་པ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་བའི་དྲོ་བར་གྱུར་པ་ལ་སོགས་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་དོ།",
    "འཛམ་བུའི་གླིང་སྨོས་པ་ནི་གླིང་འདི་ན་འདུག་པ་རྣམས་ལ་གྲགས་པའི་ཕྱིར་རོ།",
    "རྒྱལ་པོ་བཏང་སྙོམས་འདུག་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཞེས་བྱ་བ་ཁོང་ནས་དྲང་ངོ།",
    "བཏང་སྙོམས་སུ་འདུག་པ་ཉིད་རབ་ཏུ་བསྟན་པའི་ཕྱིར་རྒྱལ་པོ་གྲོང་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ཐམས་ཅད་ནི་སྣང་བ་དང་རྣམ་པར་རྟོག་པ་ལ་རག་ལས་པ་ཁོ་ན་ཡིན་ལ་དེ་གཉིས་ཀྱང་རང་རིག་པའི་མཚན་ཉིད་ཡིན་པས་འཛིན་པ་པོ་ལྐོག་ཏུ་གྱུར་པ་གཞན་བརྟག་པའི་ཚེགས་དབྱུང་བ་ནི་མི་དགོས་སོ།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡང་རང་ཡོད་པ་ཙམ་མ་གཏོགས་པ་བྱེད་པ་གཞན་ནི་མེད་པ་ཁོ་ན་ཡིན་ལ་དེ་ནི་འདི་དང་ཡང་ཁྱད་པར་མེད་དོ།",
    "དེར་ནི་རབ་ཏུ་དང་བ་ལ་སོགས་པའི་ཡན་ལག་དང་བཅས་པར་འདུག་པས་ན་བསམ་གཏན་ཡན་ལག་དང་བཅས་པ་རྣམས་སོ་ཞེས་བྱ་བར་བལྟའོ།",
    "པེ་སྣར་དེའི་བློ་ལ་འདུག་པ།",
    "ཁོ་ཚོའི་དཔའ་སྟོབས་དང་དྲག་རྩལ་ནི་ཧང་སངས་དགོས་པ་ཞིག་ཡོད་རུང་ལུས་ལ་རྒྱན་གོས་མི་ཉུང་བ་ཞིག་ཡོད་ཙང་དེས་རྟ་རྩལ་འདོན་རྒྱུར་འགོག་རྐྱེན་ཐེབས་ཀྱི་འདུག་ཟླ་བ་༥པའི་ཚེས་༧ཉིན།",
    "གཅིག་བཙན་རྒྱལ་རིང་ལུགས་ཀྱི་ལྐོག་གཡོ་དང་མི་ངན་གྱི་གཏོར་བཤིག་ལ་ངེས་པར་དུ་ག་དུས་ཡིན་རུང་དོགས་ཟོན་ཆེན་པོ་བྱེད་དགོས།",
    "རྟག་ཏུ་རྒྱ་མཚོའི་ངོས་ལས་སྤྱི་ཁྲེ་བཞི་སྟོང་ནས་ལྔ་སྟོང་ཡོད་པའི་སར་བྱེད་སྒོ་སྤེལ་དགོས་པས་དེ་བས་ཀྱང་ཡིད་གཟབ་བྱེད་དགོས་པ་འདུག་ཟླ་བ་༥པའི་ཚེས་༡༩ཉིན།",
    "འོན་ཀྱང་ཁྲ་མའི་ཤེལ་སྒོ་དང་ཁྲ་ཡོལ་སྤུས་དག་བཅས་འདུག་ཁང་པའི་མདུན་ཕྱོགས་སུ་སྤང་དང་མེ་ཏོག་ལྡུམ་ར།",
    "མཐའ་བཞི་རུ་ལྕང་མ་དང་སྦྱར་པས་བསྐོར་ཡོད་པ་དེ་དག་དྲོ་སྐྱིད་ཀྱི་ཉི་འོད་འོག་ལྗང་ཐིང་ངེར་གནས་འདུག་སྤང་ལྗོངས་ཀྱི་སྟེང་གུར་དཀའ་པོ་ཞིག་རྒྱབ་པའི་ནང་གདན་བཏིང་བ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཁ་ཅིག་ནི་ཟླ་བ་གམ་པ་ལྟ་བུར་འདུག་གོ།",
    "ཁ་ཅིག་ནི་པདྨོ་བརྩེགས་པ་ལྟ་བུར་འདུག་གོ།",
    "ཁ་ཅིག་ནི་ཤིང་རྟའི་དབྱིབས་སུ་འདུག་གོ།",
    "ཞེས་བརྗོད་ནས་རི་གངས་ཅན་གྱི་ཁྲོད་དུ་བྲོས་ནས་འདུག་པས།",
    "བྲག་རུམ་ཞིག་ལ་སྒོམ་ཞིང་བསྡད་ཙ་ན",
    "སྤྱོད་ལམ་མ་དག་འདུག་མི་ཚུགས",
    "དེ་ནས་ཆེར་སྐྱེས་མ་ནི་ཟ་བར་འདུག་ཕ་ཡི་ལྷོ་ཕྱོགས་ནགས་མ་བྱ་ཚོགས་བསྐྱལ",
    "བེ་རོ་ཙ་ན་དང་བདུན་ནོ",
    "བེ་རོ་ཙ་ན་དང་།",
    "བེ་རོ་ཙ་ན་མཚོ་རྒྱལ་གསང་ཕུག་ཡོད།",
    "བྱང་གཏེར་རྫོགས་ཆེན་རང་བྱུང་རང་ཤར་ཞུས།",
    "དེ་ནས་ལོ་ཉེར་བརྒྱད་ཀྱི་ཐོག་ཏུ་དགོན་གནས་གཅིག་ཏུ་འདུག་པའི་དུས་སུ།",
    "དེ་ནས་ལོ་ཉེར་བརྒྱད་ཀྱི་ཐོག་ཏུ་དགོན་གནས་གཅིག་ཏུ་འདུག་པའི་དུས་སུ།",
    "སྟོང་གཟུགས་ལྟ་བུ་ཞིག་འདུག་ཀྱང་།",
    "མི་འབྱེད་པའི་ལྟས་རྣམས་ཀྱང་གསལ་པོར་ཤར་བ་ཡིན་འདུག་ཅེས་གསུངས།",
    "ཞེས་གསུངས་པ་དང་ཀ་ཐོག་ཞིག་གསོ་མཛད་པའི་ཆ་རྐྱེན་གསེར་དངུལ་སོགས་གནང་སྐྱེས་བཅས་ཕུལ་བ་བྱུང་འདུག་པས་རྒྱལ་བ་ཀ་ཐོག་པའི་བསྟན་པ་བླ་ནས་བླར་འདེགས་པའི་ཐུགས་བསྐྱེད་གནང་།",
    "ཡིག་ཐོག་བཀོད་སོགས་མ་བྱུང་འདུག།",
    "དེ་ཡང་ལོ་ཆེན་བེ་རོ་ཙ་ནའི་ཐུགས་སྤྲུལ་རོང་སྟོན་པདྨ་བདེ་ཆེན་གླིང་པ་ནི།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་ཐུགས་སྤྲུལ།",
    "སྩལ་ཡང་རང་ཉིད་ཡོན་ཏན་ལྡན་བཞིན་དུ།",
    "ཞེས་བརྗོད་སྲོལ་འདུག་པས་དེ་ལྟར་དུ་བཀོད་པ་ཡིན།",
    "ཁོང་ཉིད་ཀྱིས་སྟག་བླ་པདྨ་བློ་གྲོས་ཀྱི་གསུང་འབུམ་པོད་གསུམ་དངོས་སུ་མཇལ་མྱོང་བ་གསུངས་འདུག་པ་དང་།",
    "སྐབས་འགར་ཉག་ཆུ་ཡང་བགྲང་ཚུལ་འདུག་ཡོངས་གྲགས་ཆུ་བཞི་ནི།",
    "རུ་བ་བསྐྱལ་འགྲོ་ཞེས་པའི་ཐ་སྙད་ད་ལྟའང་རང་སོར་སྤྱོད་བཞིན་ཡོད།",
    "བར་མཚམས་ཕྱི་ལོ་༡༩༨ ཙམ་ནས་ཨམ་བན་སོགས་ཀྱིས་ཁམས་བྱང་ཕྱོགས་སུ་ཡུལ་དཔོན་རྒྱ་བསྒྱུར་གྱི་ལམ་ལུགས་བཙུགས་འདུག་པས་རྒྱ་འོག་ཏུ་ལོ་ངོ་ཉུང་ཙམ་ཚུད་པ་གྲགས།",
    "ཤེ་ཁྲལ་བཅས་ཆེ་ཆུང་འབྲིང་གསུམ་གྱི་རིམ་པ་ཡོད་སྲོལ་འདུག་ཁྲལ་ཆེ་བ་རྟ་རྐང་བཅུ་གཉིས།",
    "སྦྲ་ནག་ཆེན་པོ་དེ་དག་གུ་ཡངས་ཤིང་རྒྱ་ཆེ་བས་རྟ་རྒྱུགས་ས་ལྟ་བུ་འདུག་ཟེར་སྲོལ་ཡོད།",
    "འཆང་བུར་འདུག་ཐུབ་ཙམ་ཚད་དུ་བྱས་ཏེ་ཉིན་ཤས་སྦངས་ནས་བངས་ངེས་བྱེད།",
    "ཞེས་གསལ་བ་འཁོད་འདུག་པས་སྔོན་མའི་དུས་རྐུན་ཇག་སོགས་དར་སྲོལ་ཡོད་པ་ཤེས་ཐུབ།",
    "དེ་དག་འདྲ་མཉམ་དང་ནང་ཕན་ཚུན་གཉེན་སྒྲིག་སོགས་གཅིག་ཕན་གཅིག་གྲོགས་ཀྱི་ཨ་ཞང་དང་།",
    "མཁར་ནང་འདུག་པའི་མི་གསུམ་ཡོད།",
    "མཁར་ནང་འདུག་པའི་མི་གསུམ་དེ།",
    "སྐྱེས་ཕོ་རབ་དང་ཕོ་རབ་ཐུག་དུས།",
    "ཕོ་འབྲིང་དང་ཕོ་འབྲིང་ཐུག་དུས།",
    "ཕོ་ཐ་དང་ཕོ་ཐ་ཐུག་དུས་ནས།",
    "ཕ་མ་འདྲ་ལེ་མི་འདུག།",
    "ཟླ་རྩིས་དེ་ལ་བརྟེན་ནས་ཟླ་བ་དང་ལོ་འཁོར་ཡང་རྩིས་སྲོལ་བྱུང་འདུག་ཀྱང་།",
    "ཕོ་ཕྱུག་པོའི་བུ་ཞིག་ཡིན་གྱི་འདུག།",
    "སྟོད་ཧོར་སོག་འཕྱུག་དུས་ཁྱི་སྐད་ལན་གསུམ་བསྒྲགས།",
    "སྟེང་ལ་དགོན་ཁྲ་བོ་ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྤྲུལ་པ།",
    "སྒྲ་གང་ཐུབ་ཉན་ནས་ཕབ་ཡོད་ཀྱང་སྒྲ་དོན་མི་གསལ་བ་མང་པོ་འདུག་པ་རང་སོར་བཞག་ཡོད།",
    "གཞན་ནི་ཡོད་པའི་ལུས་ལྔ་ཞེས་པ་ནི་ཁ་ཟས་ཅན་གྱི་ལུས་དང་འོད་ཀྱི་ལུས་དང་རང་བཞིན་ཅན་གྱི་ལུས་དང་།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་པར་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཅི་ལྟར་འགྲོ་ཞེས་པ་ནི་འདིར་སད་པའི་དུས་སུ་སད་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱ་བ་དང་བཅས་ཤིང་།",
    "འོག་ཏུ་ཡེ་ཤེས་ཀྱི་ཁམས་ལས་སྐྱེས་པ་ཡིད་ནི་ཀུན་ཏུ་བཟང་པོ་ཁ་དོག་སྔོན་པོ་ཞལ་གསུམ་པ་ཕྱག་དྲུག་པ་ཁ་དོག་དུས་ཀྱི་འཁོར་ལོ་ལྟ་བུ་སྟེ་ཤར་གྱི་སྒོའི་གཡོན་དུ་ར་བའི་རྩིག་པ་ལའོ།",
    "རང་རང་ཞིང་དུ་རབ་ཏུ་གཞུག་ཅེས་པའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "རྣམ་པར་དག་པ་དེས་ལྷ་རྣམས་ཀྱི་སྟབས་དང་འདུག་སྟངས་རྣམ་པར་དག་པར་འགྱུར་ཏེ་གཡོ་བ་མེད་པ་ལས་སོ་ཞེས་པ་ངེས་པའོ།",
    "ཨོཾ་ལོ་ཙ་ནེ་བ་སུ་དེ་སྭཱ་ཧཱ།",
