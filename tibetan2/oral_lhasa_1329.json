    "སྒྲུབ་བརྒྱུད་ཀྱི་རྒྱལ་མཚན་འཛིན་པ་ལགས།",
    "ལྷག་པར་དུ་འཇམ་མགོན་སྙན་བརྒྱུད་ཐོབ།",
    "ཕལ་ཆེར་འདི་བྱས་ལོ་དང་མཁས་ལོ་ཡི།",
    "རྒྱུ་ཚོགས་ལས་འབྲས་བུ་ངེས་པར་འབྱུང་།",
    "སྤེལ་བའི་མགྲིན་རྒྱན་དོ་ཤལ་མཛེས་པར་ངོམ།",
    "བསྔགས་འོས་ལྷག་པར་རྗེས་སུ་ཡི་རང་ངོ།",
    "གྲུབ་པའི་གོ་འཕང་མཐོན་པར་གཤེགས་པར་མཛོད།",
    "བྱས་ནས་ཟབ་དང་རྒྱ་ཆེའི་ལམ་རིམ་གྱི།",
    "ཤིན་ཏུ་དབེན་པར་མི་རྟོག་རྩེ་གཅིག་འགྲུབ།",
    "བརྟན་པའི་ཆོ་ག་ནན་ཏུ་བསྒྲུབ་པར་མཛོད།",
    "སྐྱབས་དུས་གསུམ་རྒྱལ་རྣམས་མཁྱེན་བརྩེའི་གཟུགས།",
    "སྤྱིར་ཕྱག་མཚན་བཞེས་པའི་རྒྱལ་བའི་ཞིང་།",
    "དབྱིངས་ཞི་བའི་ངང་དུ་མཉམ་པར་བཞག།",
    "བོད་བསྟན་པ་རྒྱས་པར་ལུང་ཡང་བསྟན།",
    "ལྷ་སྲོང་བཙན་སྒམ་པོ་ཞེས་བྱ་བྱོན།",
    "སྟེང་གཙང་རིས་ལྷ་དང་གནས་གསུམ་གྱི།",
    "དོན་རྣམ་པར་དཀར་བའི་ཕྱག་བཞེས་མཛད།",
    "ལར་བུས་པར་འཛིན་པ་ཀུན་དང་བྲལ།",
    "རྗེ་ཁུ་བོ་ཐུ་བཙུན་ཐམས་ཅད་མཁྱེན།",
    "ལྷ་འཇམ་པའི་དབྱངས་ཀྱི་རྣམ་པར་འཕྲུལ།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པ་བྱམས་གླིང་པ།",
    "རྗེ་བྱམས་གླིང་ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "གསུང་ནུས་མཐུས་ལྷ་སྲིན་བྲན་དུ་འཁོལ།",
    "རྟེན་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་ཆེ།",
    "དོན་མ་ཚང་མེད་པར་འཛིན་མཛད་པའི།",
    "ཆབ་ཁའུ་གཙང་པོས་བསུ་ཆང་ཕུལ།",
    "སྟོད་གཙང་ཕྱོགས་མི་ཆེན་ཐམས་ཅད་ཀྱིས།",
    "ཕ་རྗེ་བཙུན་ཐམས་ཅད་མཁྱེན་པ་དེའི།",
    "བོད་གངས་ཅན་དབུས་གཙང་ཁམས་གསུམ་དང་།",
    "ཞབས་གཙུག་ཏུ་བསྟེན་ནས་གུས་པར་བསྟོད།",
    "ཞབས་ཐོད་དུ་ཁུར་ནས་གསུང་བཅུད་བཞེས།",
    "རྗེ་མཁྱེན་སྤྱན་མངའ་བ་མང་པོས་ཀྱང་།",
    "ཐུགས་དགོངས་པ་རྫོགས་པའི་ཕྱག་བཞེས་བསྐྱངས།",
    "ཐུགས་གཏིང་ནས་དད་ཐོབ་རྣམ་པར་དཀར།",
    "ཡུལ་དབུས་གཙང་མཚམས་སུ་རྒྱལ་སྲིད་བཟུང་།",
    "བདག་པདྨའི་བསྟན་པ་འཛིན་ཞེས་གསུངས།",
    "ཐུགས་མཁྱེན་གཉིས་ཀློང་ནས་བྱིན་གྱིས་བརློབས།",
    "དབྱིངས་གཅིག་ཏུ་འདྲེས་པར་བྱིན་གྱིས་བརློབས།",
    "དོན་མ་ཚང་མེད་པར་བྱིན་གྱིས་བརློབས།",
    "ཐུགས་གཅིག་ཏུ་མཐུན་པར་བྱིན་གྱིས་བརློབས།",
    "དུས་མྱུར་དུ་འགྲུབ་པར་བྱིན་གྱིས་བརློབས།",
    "ཡིད་རྩེ་གཅིག་གུས་པར་དྲན་གྱུར་ནས།",
    "བསྐལ་པའི་འཇིག་རྟེན་སྟོང་པར་ཉེ་བའི་ཚེ།",
    "གནོད་པར་བརྩམས་ཚེ་སློབ་དཔོན་ཆེན་པོ་ཡིས།",
    "བསེ་ལས་བྱས་པའི་གའུ་སེན་གང་པ།",
    "གནས་མཆོག་དེ་ན་ངེས་པར་ཡོད་ཅེས་གསུངས།",
    "ཁྱད་པར་བསྟན་པའི་ཉི་མ་སྔགས་འཆང་རྗེ།",
    "འཕེལ་ཞིང་རྒྱས་པར་མཛད་ཅེས་ཡོངས་སུ་གྲགས།",
    "རིམ་པར་བྱོན་པ་རྣམས་དང་ཁྱད་པར་དུ།",
    "སྤྱིར་གྱི་བསྟན་དང་ཁྱད་པར་ས་སྐྱ་པའི།",
    "ཡར་ངོའི་ཟླ་ལྟར་འཕེལ་ཞིང་རྒྱས་པར་མཛོད།",
    "རྒྱུན་ཆད་མེད་པར་བསྟན་པ་འཛིན་པ་དང་།",
    "དབུས་གཙང་ཁམས་ཀྱི་འགྲོ་བ་མ་ལུས་པ།",
    "གསལ་གདབ་པར་བྱའོ།",
    "དེ་ནས་བདུད་རྩིའམ་ནང་མཆོད་གཏོར་མ་ལྟར་བྱིན་གྱིས་བརླབས་པ་ལྕེ་ལ་མྱངས་པས་དཀྱིལ་འཁོར་གྱི་ལྷ་ཐམས་ཅད་ཀྱི་སྐུ་བདུད་རྩིས་གང་ཞིང་མཉེས་པར་བསྒོམས་ལ།",
    "ལྷའི་སྐུ་སྣང་ལ་རང་བཞིན་མེད་པ་ལ་ཡིད་མཉམ་པར་གཞག་གོ།",
    "རྒྱས་བས་རྡོ་རྗེ་གུར་ལས་གསུངས།",
    "ལས་སུ་རུང་བར་གྲུབ་པ་ལགས།",
    "འགྱུར་བ་ཤིན་ཏུ་ངོ་མཚར་ལགས།",
    "འགའ་ཡིས་ཚིག་སྦྱོར་ཤེས་ལགས་ཀྱང་།",
    "དོན་གྱི་ཆ་ལ་རྣམ་པར་རྨོངས།",
    "ངོ་མཚར་ལགས་པས་མཁྱེན་པར་མཛོད།",
    "། པོ་ཏོ་བའི་བེའུ་བུམ་སྔོན་པོའི་རྩ་བ་བཞུགས་སོ།",
    "བདག་ཉིད་བློ་དམན་བརྗེད་བྱང་བྱས་པ།",
    "གཙང་གཅིག་མ་ཡིས་བསྟེན་ཚུལ་ཞུས་པས།",
    "དེ་ལས་བཟློག་པས་ཚང་བར་གསུངས་ཀྱང་།",
    "འབད་པས་དེ་མཉེས་བྱས་ལ་ཞུགས་ན།",
    "བཏུས་པའི་དབུ་ཡི་བྱས་གཟོའི་སྐབས་སུ།",
    "བྱས་གཟོ་མེད་ཅིང་ཡིད་མ་ཆེས་ན།",
    "དེ་ལ་ཡིད་ཆེས་གུས་ཤིང་བྱས་གཟོ།",
    "དེ་བས་ཡིད་ཆེས་བྱས་གཟོ་གལ་ཆེ།",
    "དེ་ནི་དེ་ལ་དོ་གལ་ཆེར་གསུངས།",
    "ལྷ་ཅིག་ཏིང་འཛིན་ཁྱད་པར་ཅན་བརྙེས།",
    "ཨ་ཏི་ཤ་ཉིད་གསུངས་པ་ཁུངས་དྲངས།",
    "བརྟགས་པ་ཅིག་ལ་བརྟེན་པར་བྱ་ཡི།",
    "གཞན་དུ་སྟོན་ལ་མཉན་པར་མི་བྱ།",
    "ཁྱི་གླེན་ལམ་དུ་ཞུགས་བཞིན་བྱས་ན།",
    "བཞི་པ་འཇུག་པར་བྱ་བའི་རྩོམ་དངོས་ལ་ཇི་ལྟར་འཇུག་ཚུལ།",
    "དེ་བས་དེ་ལྟར་འཇུག་པར་བྱ་ཡི།",
    "དེ་ཡང་འདི་ལྟར་གསུངས་ལས་ཤེས་ཏེ།",
    "གོ་རིམས་ཇི་ལྟར་བསླབ་པ་གསུངས་ནས།",
    "དེ་ཡང་ཏིང་འཛིན་རྒྱལ་པོ་ལས་གསུངས།",
    "སྤྲིང་ཡིག་ནོར་བདུན་གསུངས་པའི་སྐབས་སུ།",
    "ཤེས་རབ་རྗེས་འབྲང་མཆོག་ཏུ་གསུངས་ཀྱང་།",
    "གསུངས་ཕྱིར་དེ་ནི་དེ་ལྟར་བསྒོམ་བྱ།",
    "དལ་བ་རྙེད་པར་དཀའ་ལ་སོགས་པ།",
    "དེ་ནས་འཆི་བ་གཙོ་བོར་བྱས་པའི།",
    "འཕགས་པ་ཐོགས་མེད་གསུངས་པའང་ཁུངས་དྲངས།",
    "མ་བཏུབ་ན་ཡང་དེ་ཉིད་རྒྱུར་བྱས།",
    "དལ་བ་རྙེད་ཅིང་བསྟན་པར་ཞུགས་ནས།",
    "བྱས་པ་ཁྱིས་ཁྱེར་རིགས་པ་མིན་སྙམ།",
    "མཁྱེན་པར་མཛོད་དེ་རང་དང་གཞན་ལ།",
    "ཕན་པར་འགྱུར་བས་ཁྱེད་ཀྱིས་དེ་མཛོད།",
    "གཞན་རྣམས་ཡུལ་དུ་བྱས་ལ་ཚོགས་གསགདེ་ཉིད་རང་དོན་ཉམས་སུ་མྱོང་འགྱུར།",
    "དལ་བ་རྙེད་པར་དཀའ་བའི་ཚིག་འདི།",
    "འདུན་མ་བྱས་ནས་མ་འཛིངས་སུ་ཡོད།",
    "བག་ཡོད་ལེའུའི་སྐབས་སུ་གསུངས་པ།",
    "ངེད་ཅག་དུག་ལ་འབགས་པར་གྱུར་ནས།",
    "མུན་མཐར་ཐུག་པར་འགྲོ་བའི་ཉེན་ཆེ།",
    "བསྡད་པ་དང་ནི་ཡུལ་དུ་འགྲོ་བ།",
    "དེ་ཡང་ཕྱིར་མི་ལྡོག་པར་གནངས་འགྲོའི།",
    "ག་ཤེད་གཤེགས་འཚལ་རྒྱལ་ལ་གསུངས་པ།",
    "རྟོག་གེས་གང་ཡང་རྟོགས་པར་མི་ནུས།",
    "ཡོད་པར་འདོད་པའང་འབྲས་བུ་ཆུང་འདོད།",
    "དེ་ལ་སོགས་པ་མང་དུ་གསུངས་ན།",
    "བདེན་པ་མཐོང་ལ་འཕེན་པ་མེད་གསུངས།",
    "མི་འཕེན་ཞེས་གསུངས་བཟློག་ལ་ལས་གནོད།",
    "ཐེ་ཚོམ་ཟ་ནའང་འཇུག་ལྡོག་རྒྱུར་གསུངས།",
    "བརྩོན་འགྲུས་ལེའུའི་སྐབས་སུ་གསུངས་པ།",
    "དང་པོ་དེ་ཉིད་གྲུབ་པར་བྱས་ལ།",
    "ཉེས་པར་ཤེས་ཀྱང་འགྱོད་པར་རབ་དཀའ།",
    "འགྱོད་ཀྱང་དེ་ལས་ལྡོག་པར་མི་ནུས།",
    "དེ་བས་ལས་ངན་བྱས་ལ་འགྱོད་ནས།",
    "གང་མེད་དེ་ཉིད་གཉེན་པོར་བྱས་ལ།",
    "དེ་ལ་འབད་གསུངས་དེས་ཀྱང་དེ་བཞིན།",
    "སྔར་བྱས་ལས་ངན་དག་ཀྱང་ཟད་བྱ།",
    "འཕགས་པ་ཐོགས་མེད་བཟོད་པ་ལ་གསུངས།",
    "ཉན་པོར་ཕྱིས་སུ་ལ་ནི་གསུངས་པ།",
    "གཅིག་ཏུ་ཆད་པར་གསུངས་ཏེ་དེ་ཡང་།",
    "ཕྱོགས་དེའང་ཅུང་ཟད་རྙེད་མིན་གསུངས་པས།",
    "མཁར་ཐོག་ལྕང་སྟོན་ལ་ནི་གསུངས་པ།",
    "སྦྲགས་སུ་གཞོན་ནུ་འོད་ཟེར་གསུངས་པ།",
    "གཞན་ཡང་དེ་ལྟར་སློབ་པར་འདོད་པས།",
    "དེ་སྐྱེད་རྒྱུ་ནི་བྱས་པ་གཟོ་བ།",
    "སྡུག་པ་གཞན་རྒྱུར་བྱས་པས་མ་ཡིན།",
    "དེ་བས་སྔར་བཞིན་གཙོ་བོར་ལྷས་གསུངས།",
    "དེ་བས་བཞིར་གསུངས་གཉིས་ཀྱི་ནང་འདུ།",
    "སློབ་དཔོན་རྟ་དབྱངས་ཉིད་ཀྱིས་གསུངས་ཏེ།",
    "དེ་ཡི་མན་ངག་རྒྱས་པར་གསུངས་པས།",
    "དེ་བས་ལྟ་བ་དམན་པར་གྱུར་ཀྱང་།",
    "བྱས་པ་གཟོ་དང་མི་གཟོའི་སྐྱོན་ཡོད།",
    "ཆུ་གང་གཉེན་ལ་བྱས་པའི་དངགས་ཀྱང་།",
    "བྱས་གཟོ་རྟག་བསྟེན་མི་གཟོ་རྟག་སྤང་།",
    "གོམས་པར་གྱུར་ན་ཅི་ལྟར་ཡང་རུང་།",
    "ཐོག་མའི་སེམས་བསྐྱེད་དུས་སུ་གསུངས་པ།",
    "སྡོང་པོ་བཀོད་ལས་གསུངས་པ་བཞིན་དུའོ།",
    "མིན་ཀྱང་ཐམས་ཅད་མཁྱེན་ཉིད་རྒྱུར་འགྱུར།",
    "ཤེས་རབ་མི་འཇུག་པ་ལ་གསུངས་ཡིན།",
    "དེ་ལ་དགོངས་ནས་དེ་ལྟ་བུར་གསུངས།",
    "དེ་བས་དེ་ཉིད་དགོངས་ཏེ་གསུངས་པ།",
    "སྟོང་པར་ཤེས་པས་མི་འཇུག་དེ་སྤོང་།",
    "བཟློག་ན་ལོག་པར་ལྟ་བའི་རྒྱུ་ཡིན།",
    "ས་མ་ཐོབ་པར་མཐའ་ཡས་བསྟོད་བཞིན།",
    "གནང་དང་བཀག་པ་དཔག་མེད་གསུངས་ཀྱང་།",
    "བཀག་པ་དག་ཀྱང་དེ་ལ་གནང་ཡིན།",
    "བསྒྲུབ་པར་གསུངས་པའང་དེ་ལ་མ་གནང་།",
    "དེ་བས་གནང་དང་བཀག་པ་དག་ནི།",
    "བྱས་ཀྱང་ཉེས་མེད་ལྷ་ཅིག་དཔོན་སེམས་བཞིན།",
    "གཙོ་བོར་གསུངས་པས་བཟློག་པ་ཕལ་བ།",
    "སྤྱོད་འཇུག་བཟོད་པའི་སྐབས་སུ་གསུངས་པ།",
    "རྟག་ཏུ་ཞི་བར་བྱས་ན་དེ་ནི།",
    "ཐོས་པ་གཙོ་བོར་བྱ་བར་མ་གནང་།",
    "སྒྲུབ་ལ་བརྩོན་འགྲུས་རྩོམ་པར་བྱེད་པས།",
    "ལི་སྒོམ་ཟེར་བའི་རྟོགས་པ་དཔེར་བྱས།",
    "སྒྱིད་མ་ལུག་པར་བརྩོན་འགྲུས་མུར་གཞུག།",
    "ཚེ་འདིར་ཐམས་ཅད་བསླབ་པར་མི་ནུས།",
    "བསྒོམས་པས་ཚེ་འདི་དོན་ཡོད་བྱས་ལ།",
    "ཇི་ལྟར་འཕེལ་ལུགས་བཤེས་དེས་གསུངས་པ།"
  ]
}