    "ཕུང་ཁམས་སྐྱེ་མཆོད་རིགས་དྲུག་རྣམས་ཤེས་པ་རྣམ་པར་སྣང་མཛད་དང་འོད་དཔག་མེད་དང་རིན་ཆེན་འབྱུང་ལྡན་དང་།",
    "ཀུན་རྫོབ་དང་དོན་ད་མ་པའི་བདེན་པ་གཉིས་ཡོངས་སུ་དག་པ་འཇིག་རྟེན་དང་འཇིག་རྟེནལས་འདས་པའི་ཡེ་ཤེས་མ་ལུས་པ་རྟོག་པར་བྱེད་པ།",
    "དེ་ལརྡོ་རྗེ་ནི་མི་འགྱུར་བའི་ཡེ་ཤེས་ཆེན་པོ་རྣམ་པར་དག་པ་ཡིན་ལ།",
    "གཞོམ་དུ་མེད་པའི་སྒྲརྣམ་པར་དག་པ་ཞེས་པའི་དོན་ཏོ།",
    "རྡོ་རྗེ་དང་དྲིལ་བུའི་འདི་དག་ཉིད་འཁྱུད་པས་ཐབས་དང་ཤེས་རབ་དབྱེར་མེད་པ་ཉིད་དུ་སྟོན་པར་བྱེད་པའྀ་དོན་ཏོ།",
    "རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་ཁོནར་སྦྱིན་པར་བྱ་བ་ཡིན་གྱིས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱུད་རྣམས་སུ་མ་གསུངས་  པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འདི་ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམས་ཀྱིས་དེ་སྒྲུབ་པར་བྱེད་པའི་ལམ་གསུངས་ཏེ། འདི་ཞེས་པ་ནི།",
    "སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་སྐུ་བཞི་པོ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་བླ་ན་མེད་པའི་བདེ་བ་ཆེན་པོའི་རང་བཞིན་གྱི་རྡོརྗེ་སེམས་དཔའ་ཡིའོ།",
    "རྣམ་པར་མི་རྟོག་པ་བླ་ན་མེད་པའི་ཤེས་རབ་ཀྱི་རང་བཞིན་སྣད་བའི་རྣམ་པ་བླ་བ་དང་ཟླ་བའི་འོད་བཞིན་དུ་དབྱེར་མེད་པ་རྣམས་ཀྱིས་སོ།",
    "ཕུག་པར་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡེ་ཤེས་ཀྱིས་རྣལ་འབྱོར་པསམཐོད་བར་འགྱུར་རོ།",
    "རྣམ་པརམི་རྟོག་ཅིད་རྨི་ལམ་གྱི་སྣང་བལྟར་མཐོང་བར་འགྱུར་རོ།",
    "ཐོག་མ་དང་དཔུས་དང་མཐར་རྣམ་པར་མ་བརྟགས་པའོ།",
    "འདི་ཉིད་གསུངས་པ།",
    "དེའི་ཕྱིརདཔེ་གསུངས་པ།",
    "ཇི་ལྟར་མེ་ལོདསལ་གཞོན་ནུ་མས་འདས་པ་དང་མའོངས་པ་དང་དལྟར་གྱི་རྐུན་པོལ་སོག་ས་པའི་རྫས་རྣམ་པར་མ་བརྟགས་པར་སྣང་པ་དེ་ཁོ་ན་བཞིན་དུ་རྣལ་འབྱོར་པས་ཀྱང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཀྱི་རྡུལ་དང་བྲལ་བའི་ནམ་མཁའི་དྲི་མ་མེད་པལ།",
    "རྣམ་པ་ཐམསཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་སྟོང་པ་ཉིད་ཅེ་ས་བརྗོད་པར་བྱའོ།",
    "འདི་ལས་ཤེ་ས་པ་ལ་སོགས་པ་རྣམས་ཀྱིས་དཔེ་གསུངས་ཏེ།",
    "མེད་པའོ་ ཅི་ལྟརཞ་བཅོམ་ལྡན་འདས་དེ་རྣམ་པར་མིརྟོག་པའི་ཡེ་ཤེས་ཀྱིས་གཞན་གྱི་དོན་མཛད་པར་འགྱུར་ཞེས་བྱ་བའི་དོགས་པ་བསལ་བའི་ཕྱིར།",
    "རྣམ་པར་མ་བརྟགས་པའི་རྣམ་པ་ཐམས་ཅད་པའི་གཟུགས་བརྙན་མཐོད་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་འཛིན་པར་བརྗོད་པར་བྱའོ།",
    "སྒྲིབ་པ་མེད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ལ་ལཱ་ན་ལ་སོགས་པའི་རྩ་རྣམས་ཁོ་ནའི་རང་བཞིན་གྱི་ཁྱད་པར་ཟླབ་ཞེས་པ་ལ་སོགས་པའི་ཚིགསསུ་བཅད་པ་གཉིས་ཀྱིས་གྲངས་ཇིལྟ་བར་ཁོད་དུ་ཆུད་པརབྱའོ།",
    "ལ་ལནཱ་ལ་སེགས་པ་རྩ་རྣམས་ཀྱི་དེ་བཞིན་གཤེགས་པའི་རིགས་དག་པར་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལེ་པདྨའཛིན་པ་ལ་སོགས་པ་ནི་འོད་དཔག་མེད་ལ་སོགས་པར་ཤེས་པར་བྱའོ།",
    "ཁུ་བ་འབབ་མའི་མཐར་ཐུག་པར་ཨ་བནྡྷུ་ཏིའི་མིང་གསུངས་པ་ཡིན་ནོ།",
    "ལྟེ་བཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་ནི།",
    "སྐྱེས་བུ་ལ་ཡང་རྡུལ་དང་ཡང་དག་པར་སྦྱོརབ་ཁོན་ལས་ལུས་སྐྱེ་བའི་ཕྱིར་ན།",
    "གཡོན་དང་ག་ཡས་ཀྱི་སྣའི་བུ་ག་དག་ཏུ་རྣམ་པར་ཤེས་པལ་སོགས་པའི་ཕུར་བ་དང་།",
    "དེ་བཞིན་དུ་ཕྱི་དང་སྟེང་དང་དབུས་ཀྱི་ཆ་རྣམས་ནི་གཡས་ལ་སོགས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "སྣ་བུག་གཡོན་པར་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་རང་བཞིན་གྱིས་དང་པེར་ཤར་བའི་སྲོག་འབབ་པའི་རིམ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་ཕུང་པོ་རྣམས་ནི།",
    "ཉེ་བར་བཏགས་ནས་ཐ་དད་མེད་པར་རབ་ཏུ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་བཞི་པོའི་དབུས་སུ་བྱས་ནས་ཤར་ལ་སོགས་པའི་ཐ་སྙད་སྦྱོར་བའི་ཕྱིར་རོ།",
    "འདི་འདི་དུ་ཡིན་གྱི་དེ་ལ་སྣའི་བུག་པར་ནི་སྟེང་ལ་ཤར་དུབརྗོད་དོ།",
    "ཕྱག་རྒྱ་བཅིང་བལས་ཤེས་རབ་དང་ཐབས་རྣམ་པར་དག་པར་ཤེས་པར་བྱའོ།",
    "ཕུང་པོ་དང་ཁམས་དང་རྡོ་རྗེགསུམ་པོ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པའི་རང་བཞིན་དུ་རྟོགས་པར་བྱེད་པའོ།",
    "འདི་རྣམས་གྲོལ་ནཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་ཕྱེད་ཀྱིས་ལྡོག་པའི་སྐྱོན་གསུངས་པ་ཡིན་ནོ།",
    "ལྔ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་ཞི་མའི་འཆི་ལྟས་ཀྱི་མཚན་ཉིད་གསུངས་སོ།",
    "དེ་ནས་འདབ་མ་དེ་ཞིད་ལ་གཡས་ཀྱི་སྣའི་བུག་པར་ཉིན་མཚན་བཅུརརྣམ་པར་འཆད་པར་འབབ་སྟེ།",
    "དེ་ནས་ཞིན་ཞག་སུམ་ཆུ་རྩ་ལྔ་ལྷག་པའི་བརྒྱ་ཕྲག་གསུམ་དུ་ཇི་ལྟར་རིགས་པར་འབབ་པས་དམན་པར་བྱས་ནས་ཉིན་ཞག་བཅུ་དང་བཅས་བའི་ཟླ་བས་ལྷག་པའི་ལོ་གཅིག་བཟུང་སྟེ།",
    "འདབ་མ་གསུམ་པ་ལ་ཡང་དག་པར་རྒྱུའོ་འདབ་མ་འདི་ལ་ཉན་མཚ་ན་བཅོ་ལྔར་འཆི་ལྟས་འབབ་སྟེ།",
    "འདབ་མ་བཞི་པ་ལ་ཡང་དག་པར་རྒྱའོ།",
    "དེ་ནས་ཉན་ཞག་གཉིས་ལྷག་པའི་ཟླ་བ་གཉིས་སུ་ཇི་ལྟར་རིག་པར་འབབ་པས་སུམ་དམན་པར་བྱས་ནས་ཉན་ཞག་ཉི་ཤུ་རྩ་བརྒྱད་ལྷག་པའི་ཟླ་བ་བཞི་གཟུང་སྟེ།",
    "དེ་ནས་ཉིན་ཞག་གཉིས་ཇི་ལྟར་རིག་པར་འབབ་པས་དམན་པར་བྱས་ནས་ཉིན་ཞག་གསུམ་ལྷག་པའི་ཟླ་བ་གཉིས་གཟུང་སྟེ།",
    "འདབ་མ་བདུན་པ་ལ་ཡར་དག་པར་རྒྱའོ།",
    "ཇི་ལྟར་རིག་པར་འབབ་པ་ནི་མེད་དོ།",
    "དེ་ནས་འདབ་མ་བཅུ་གཞིས་པ་ལ་ག་ཡོན་གྱི་སྣའི་བུག་པར་ཤིན་ཞག་གཉིས་འབབ་པོ།",
    "ཞིན་ཞག་སུམ་ཅུལྷག་པའི་བརྒྱཕྲག་གསུམ་ལ་སོགས་པ་རྣམས་ཀྱི་ཇི་ལྟར་རིག་པར་འབབ་པར་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཁམས་ཐམས་ཅད་རྣམ་པར་ཆད་པར་འགྱུར་རོ།",
    "གཡས་ཀྱི་སྣ་བུག་ལ་རྣམ་པར་འཆད་པའི་ཉན་ཞག་སུམ་ཅུ་རྩ་གསུམ་དང་།",
    "འཆི་ལྟས་མཚན་ཉིད་ཤེས་ནས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པས་འཆི་ལྟས་བསླ་བའི་མན་ངག་གསུངས་ཏེ།",
    "སུམ་ཅུ་དང་སུམ་ནུ་རྩ་གསུམ་གྱིས་དམན་པའི་ཟླ་བ་གསུམ་གསུམ་དུ་ཇི་ལྟར་རིག་པར་འབབ་པར་བྱས་ནས།",
    "རྣམ་པར་ཤེས་པ་ནི་འཇིག་རྟེན་གཞན་དུ་འགྲོ་སྟེ།",
    "ཟླ་དེ་ནས་གཡས་ཀྱིསྣ་བུག་ཏུ་ནིན་ཞག་གཉིས་རྣམ་པར་མ་ཆད་པར་འབབ་པོ།",
    "དེ་བཞིན་དུ་སླར་ཡང་ཉིན་ཞག་གཞིས་རྣམ་པརམ་ཆད་པར་འབབ་པོ།",
    "ལོ་གསུམ་དུ་འཚོ་བ་མཚོན་པར་བྱེད་དོ།",
    "དེ་ནས་ཉིན་ཞག་གཉིས་ཀྱིས་དམན་པའི་ཟླ་བ་གསུམ་པ་དང་བཞི་པ་ལ་ཇིལྟར་རིགས་པར་འབབ་པོ།",
    "དེ་ནས་ཉིན་ཞག་གསུམ་གྱིས་དམན་པའི་ཟླ་བ་ལྔ་པ་དང་དྲུག་པ་ལ་ཇི་ལྟརརགས་པར་འབབ་པོ།",
    "གཞན་ཟླ་བ་སུམ་ཅུ་པོ་རྣམས་གཟུང་ནས་འད་བ་མ་གཉིས་པ་ལ་ཡང་དག་པར་རྒྱུའོ།",
    "ཟླ་བཞི་ཤུ་རྩ་བདུན་རྣམས་གཟུང་སྟེ་འདབ་མ་གསུམ་པ་ལ་ཡང་དག་པར་རྒྱུའོ།",
    "འཆི་ལྟས་ཀྱི་ཉིན་ཞག་གསུམ་འཕེལ་བའི་རིམ་པ་འདི་ཉིད་ཀྱིས་ཟླ་གསུམ་དམན་པར་བྱས་ནས་འཆི་ལྟས་ཀྱི་ཉིན་ཞག་ཉི་ཤུརྩ་གཅིག་རྣམས་ཀྱིས་འདབ་མ་བདུན་པའི་མཐར་ཐུག་པར་འདོད་པར་བྱེད་དོ།",
    "མཛོད་སཱུའི་པདྨར་ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམས་ཀྱིས་དགའ་བ་རྣམས་ཀྱི་རྣམ་པར་བཞག་པ་གསུངས་ཏེ།",
    "དཔྲལ་བར་རབ་ཏུ་གནས་པ་མ་ཡིན་ཞིང་རྡོ་རྫོལས་ཕྱིར་འགྲོ་བ་མ་ཡིན་པ་རྡོ་རྗགསུམ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ།",
    "འདི་ལས་ཕྱི་མར་ཚིགས་སུ་བཅད་པ་དུ་མརྣམས་ཀྱིས་རྗེས་སུ་དྲན་པ་དང་ཏིང་འཛིན་དག་ཁོ་ནའི་ཁྱད་པར་དེ་དང་དེ་རྗོད་པར་བྱེད་དོ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
