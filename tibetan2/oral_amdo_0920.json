    "མཁྱེན་ཡངས་གཏིང་མཐའ་རྒྱ་མཚོར་རེག།",
    "ལྷ་ཁྱོད་ཡིད་བཞིན་ནོར་བུར་སེམས།",
    "ཁྱོད་གདོང་མཆུ་ཡི་ཡལ་འདབ་གཡོ།",
    "ཞེས་གདོང་གི་ཡན་ལག་ཡིན་པ་མཆུ་དང་།",
    "མིག་གི་ཨུཏྤལ་དམར་པོ་ཅན།",
    "ཞེས་གདོང་གི་ཡན་ལག་མིག་གཅིག་པུ་གཟུགས་སུ་བཀོད་པ་ལ་བསམས་ནས་དེ་ལྟར་བྱས་པ་འདྲ།",
    "དེའི་ཉག་མ་རེ་ལ་ཟེར།",
    "མཚན་དཔེའི་མེ་ཏོག་འབར་བའི་ཆ་རེར་ཡང་།",
    "ཞེས་པའི་སྐབས་སུ་སྐུའི་ཡན་ལག་མཚན་དཔེ་མེ་ཏོག་གི་གཟུགས་སུ་བཀོད།",
    "དེ་རེ་རེ་ལ་ཡང་བལྟ་བས་མི་ངོམས་པའི་མཚར་སྡུག་ལྡན་པ་སྦྲང་རྩིའི་གཟུགས་སུ་བཀོད་པ་ཡིན་པས་ཤེས་དགོས།",
    "མཆུ་དང་རྔུལ་ཆུ་གཉིས་ལས་གཞན་པའི་མིག་སྨིན་མ་མཁུར་ཚོས་སོ་ལ་སོགས་པའི་ཆ་ཤས་གང་ཡང་གཟུགས་སུ་མ་བཀོད་པས་ཆ་ཤས་གཟུགས་ཅན་མིན་པར་ཐལ་ལམ་སྙམ།",
    "ལུས་ཀྱི་ཚོགས་པ་ན་ཡོད་པའི་རྔུལ་ཆུ་ལུས་ཀྱི་ཆ་ཤས་ཡིན་ཡང་ཕྱིར་ཐོན་ཟིན་པའི་རྔུལ་ཆུ་དེ་གདོང་གི་ཆ་ཤས་མིན་བྱས་ན་བདེ་སྙམ་ཡང་།",
    "སློབ་དཔོན་དཎྜིས་ཐ་སྙད་རགས་པ་དང་བསྟུན་ནས་གདོང་ལས་ཟག་པའི་རྔུལ་ཆུ་དེ་གདོང་གི་ཆ་ཤས་སུ་བཞེད་པར་མངོན།",
    "ས་ཧཱ་ཀཱ་ར་ནི་ཨ་མྲ་ཁྱད་པར་བ་ཡིན་པར་གྲགས།",
    "ཛཧྣུའི་བུ་མོའི་ཆུ་གོས་ནི།",
    "ཛཧྣུའི་བུ་མོ་རྒྱལ་མཚན་དར་གོས་ཀྱི་གཟུགས་སུ་བཀོད་ཅིང་།",
    "ཁྱབ་འཇུག་གི་རྐང་པ་དེ་ལ་ལྡན་པར་འགྱུར་གསར་ལྟར་ནའང་ཁས་ལེན་དགོས་པས་འགྱུར་སྔ་མ་གོ་བདེའམ་སྙམ།",
    "ཁྱབ་འཇུག་གི་རྐང་པའི་ཁྱད་པར་གཉིས་ཚོགས་པའི་དཔེ་ཅན།",
    "ཞེས་པ་འགྱུར་གསར་དུ་ཛཧྣུའི་བུ་མོ་རྒྱལ་མཚན་གྱི་གོས་ཀྱི་གཟུགས་སུ་བཀོད་ལ།",
    "ཁྱབ་འཇུག་གི་རྐང་པ་གཟུགས་སུ་མ་བཀོད་པ་དང་འགལ་ལམ་དོགས།",
    "ཀ་ཡེ་མཛེས་མ་ཁྱོད་ལུས་ཚལ་འདི་ན།",
    "རྙོག་བྲལ་པདྨ་ཅན་གྱི་ལང་ཚོ་འབར།",
    "གསུང་གི་རྫིང་བུ་ལ་ཞེས་པ་ལོངས་སུ་སྤྱོད་ཅེས་པ་དང་འགྲིགས་ཀྱང་།",
    "ཁྱོད་ཀྱི་ཞལ་ནི་སྣང་སྟོང་སྒྱུ་མའི་འཕྲུལ།",
    "ཞེས་པ་རྡོ་རྗེ་ཕག་མོ་ལྟ་བུའི་རྣལ་འབྱོར་མ་ལ་སྦྱར་ན་འགྲིགས།",
    "མཛེས་མ་ཁྱོད་ལུས་ཧ་རི་ཙནྡན་ནའི།",
    "ཞེས་པ་ཙནྡན་གྱི་འཁྲི་ཤིང་དེ་ལོ་འདབ་རྒྱས་པ་སོགས་དཔྱིད་དུས་ཀྱི་རྣམ་འཕྲུལ་ལ་ཞུགས་ཞེས་པས་འཁྲིག་པའི་རྒྱུ་ལང་ཚོ་དར་ལ་བབས་པ་སོགས་སྟོན་པས་བསྡུས་བརྗོད་ཅུང་ཟད་བསྲེས་སམ།",
    "དྲན་པའི་སྙེ་མ་ནི་བུད་མེད་དོ།",
    "ཞེས་རིགས་སོགས་བཞི་པོ་གང་རུང་ཚིག་གཅིག་གིས་བརྗོད་པ་དེས།",
    "ཚིགས་བཅད་དེའི་ངག་གི་རྒྱུན་སྔ་ཕྱི་ཀུན་ལ་ཕན་པའམ་གསལ་བར་བྱེད་པ་གསལ་བྱེད་ཀྱི་རྒྱན་དུ་འཇོག་ན་རྩ་བའི་རིགས་རང་བཞིན་བརྗོད་པའི་དཔེར་བརྗོད་དེ་རིགས་མཐའ་གསལ་དུ་བཞག་ཆོག་གམ་ཞེ་ན།",
    "ཞེས་ཚིགས་བཅད་འདིའི་ཁོངས་སུ་ཁྲི་ཤིང་གི་འདབ་མ་རྙིང་པ་ལྷུང་བར་བྱེད་པ་དང་།",
    "ལང་ཚོས་དྲེགས་པ་མོའི་ཁེངས་པ་འཇོམ་པར་བྱེད་པའི་བྱ་བ་གཉིས་བརྗོད་པ།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་ཀུནྡའི་འོད་ཅེས་དང་།",
    "དེང་ཡང་བདག་གི་སྲོག་རྣམས་ལེན།",
    "༡༤ན་ཐམས་ཅད་གཟིགས་ཏེ་མོས་པ་རྒྱ་མཚོའི་ངོར།",
    "རྒྱས་པའི་དོན་དུ་གཅིག་པར་སོང་བས་དོན་སྐོར་ཟེར།",
    "ཀ་ཊ་ཛ་ཞེས་པ་དུག་མོ་ཉུང་གི་ཤིང་དང་།",
    "ཤིང་དེ་རྣམས་དོན་དུག་མོ་ཉུང་གི་ཤིང་སྡོང་གཅིག་པོ་དེ་ཉིད་ཡུལ་ཁམས་ཐ་དད་ཀྱི་མིང་ཐ་དད་དུ་བྱུང་བ་ལ་རྣམ་པར་རྒྱས།",
    "རྒྱས་པར་གྱུར་ཅེས་དོན་དུག་མོ་ཉུང་གི་ཤིང་རྒྱས་པ་གཅིག་པུ་བཟླས་ཏེ།",
    "རྐང་པ་བཞི་ཀར་དུག་མོ་ཉུང་གི་ཤིང་རྒྱས་སོ་ཟེར་བ་ལན་བཞིར་བཟླས་ན་སྐྱོན་བཅུའི་ནང་ཚན།",
    "ཀུན་གཟིགས་ལྔ་པ་ཆེན་པོ་ཡང་འདིའི་རྗེས་འབྲང་ཡིན་ཡང་།",
    "དུག་མོ་ཉུང་གི་ཤིང་ལན་བཞིར་བཟླས་པ་ལས་རྒྱས།",
    "ཀུན་ལས་རྒྱལ་ནས་དེ་རིང་ཁྱོད།",
    "བཙུན་མོ་རྣམས་དང་རྩེ་བར་བྱེད།",
    "ལྷ་མོ་རྣམས་དང་རྩེ་བར་བྱེད།",
    "ཕྱི་མས་གླུ་དང་རོལ་མོས་རྩེ་བ་སྟོན་པས་ཚིག་བསྐོར་དུའང་འཇོག།",
    "ལུས་མེད་ཀྱི་མེ་ཏོག་གི་མདའ་འཇམ་པ་དང་།",
    "འདི་ལ་བྱུང་བ་འགོག་པ་ཟེར་དོན་འགོག་བྱེད་ཀྱི་བློ་མ་སྐྱེས་པའི་སྔོན་དུ་དགག་བྱའི་རྒྱུ་དེ་བྱུང་ཟིན་པའི་ཆ་ནས་བཏགས་པ་འདྲ་ཞིག་དཔང་ཊིཀ་གིས་ཚིག་ནུས་ལ་བརྟགས་ན་ཡོད་ཀྱང་།",
    "དེ་ལྟ་ན་རྣ་བ་ལ་ཨུཏྤལ་འཇུག་པ་ཡང་འགོག་བྱེད་ཀྱི་སྔོན་དུ་བྱུང་ཟིན་པས་དེ་ཡང་བྱུང་བ་འགོག་པར་ཐལ་ལོ་ཞེ་ན།",
    "གང་ཕྱིར་མཛའ་མོ་མཁས་པ་ཡིས།",
    "ཞེས་བཅོས་ཀྱང་ཤོང་དཔང་གི་འགྱུར་དུ།",
    "ཁྱོད་ཀྱི་མིག་ནི་དམར་གྱུར་ཅིང་།",
    "ཞེས་སོགས་ཁྲོས་པའི་རྣམ་འགྱུར་སྟོན་མཁན་བུད་མེད་ལ་སྦྱར་ན་འཆད་བདེ།",
    "ཅེས་པ་ཁྲོ་ཕུ་དུས་འཁོར་ཞབས་དྲུང་གི་བཞུགས་གནས་དེ་ཡིན་པ་འདྲ།",
    "ན་ཚོད་མཐའ་དག་སོང་བར་གྱུར།",
    "དཀའ་ཐུབ་བྱས་པ་རྣམས་དགག་ཚིག་གིས་བཀག་པ་ཙམ་མ་གཏོགས་ཚེ་ཟད་པ་དེ་དག་གི་འབྲས་བུར་བསྟན་པ་མིན།",
    "ཁྱོད་གདོང་ཟླ་བ་འདི་ཡོད་༡༧ན་བཞིན།",
    "ཞེས་པའི་དོན་གདོང་གིས་མིག་སིམ་པར་བྱེད་པ་དང་།",
    "ཟླ་བ་བསིལ་ཟེར་དང་ལྡན་པས་བདུད་རྩིའི་བདག་ཉིད་ཅེས་སྒྲ་སྦྱར་གདོང་གི་པདྨའི་མཛེས་པ་ལ་འགྲན་པ་དང་།",
    "ཏཱ་ར་ཀཱ་ཞེས་པ་མིག་འབྲས་ཀྱི་རྒྱལ་མོ་དང་།",
    "ཁྱོད་ཞལ་དག་པའི་མཁའ་དབྱིངས་འདི་མཐོང་བཞིན།",
    "ལྷ་ལ་ཚེམས་ཕྲེང་གི་ཞལ་གྱི་ཁྱོན་ཀུན་གསལ་བ་དང་།",
    "ཡང་ན་ཀུན་གསལ་ཞེས་པ་ནམ་མཁའི་མིང་གི་རྣམ་གྲངས་སུ་ཡོད་པ་ལྟར་གཟུགས་སྣང་ཐམས་ཅད་གསལ་བ་དང་།",
    "ཁྱོད་གདོང་ཟླ་བ་ཞེས་པ་དང་།",
    "ཁྱོད་ཞལ་དག་པའི་མཁའ་དབྱིངས་ཞེས་པ་གཟུགས་ཅན་ཡིན་སྟབས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཅིང་གཟིགས་པའི་ཐུགས།",
    "ཞེས་པའི་སྐབས་བསམ་བློ་མིའུ་ཐུང་གིས།",
    "དགོས་འདོད་ཀུན་འབྱུང་ནོར་བུ་བསམ་འཕེལ་ཁྱོད།",
    "རྫོགས་པས་ཟེར་མོད།",
    "གསོས་པས་ཞེས་སྦྱར་ན་ཚིག་འཇམ་པ་ཡིན་རྒྱུ་རེད།",
    "གང་ཕྱིར་སློང་པས་ཁྱོད་ཀྱི་ནོར།",
    "རང་གི་ཉིད་དུ་བསམས་ནས་ལེན།",
    "འགོག་བྱེད་སློང་བ་པོ་རྣམས་ཀྱིས་ཁྱོད་ཀྱི་ནོར་རང་ནོར་དུ་བསམས་ནས་ལེན་པའོ།",
    "གཞན་ཁྲོ་བའི་རྒྱུ་དགག་བྱར་བྱས་ནས་དེ་དགག་ཚིག་གིས་བཀག་པ་སྟེ།",
    "མཚན་མོར་བྱེད་པའི་དྲི་མ་དང་།",
    "ད་ལྟ་ཁྱོད་འདྲ་གཅིག་ཀྱང་མེད།",
    "དེས་ན་ཀུན་ཁྱབ་དང་ཁྱད་པར་ལ་གནས་སྐབས་གཞུང་གོ་རིམ་དཀྲུགས་མི་དགོས་པར་ཤོང་དཔང་གི་འགྱུར་རང་སོར་བཞག་ན་ལེགས་པར་བོད་མཁས་དང་།",
    "སྒྲ་མཁས་ཁྱོད་ཀྱིས་ཐུབ་པའི་བསྟན་པ་དང་།",
    "རིན་ཆེན་འབྱུང་གནས་ཡིན་མོད་ཀྱང་།",
    "ས་གཞི་ཐམས་ཅད་འཛིན་མོད་ཀྱང་།",
    "ཁྱོད་ཀྱི་གདོང་དང་པདྨ་སྟེ།",
    "ཁྱོད་གདོང་ཁྱོད་ལ་བརྟེན་པའོ།",
    "ཁྱོད་ཀྱི་ཞལ་ནི་ཁྱོད་ཉིད་ལ།",
    "ཕུལ་བྱུང་གི་དཔེའི་སྐབས་སུ་གདོང་དང་།",
    "རྣམ་བཀྲའི་ཚིག་སྦྱོར་འཁྱོག་པོ་ཡིད་ཀྱི་རྒྱན།",
    "རབ་གྲགས་ཀྱི་རྒྱུ་བཟློག་ནས་རང་གི་ངོ་བོ་ཙམ་སྟོན་པ་གཉིས།",
    "ནང་ལང་ཚོ་སྦྱར་བ་གཉིས་ཞེས་འགྲེལ་པ་ཕལ་ཆེར་དུ་བྱུང་ཡང་།",
    "ནང་ལང་ཚོ་རྒན་གཞོན་བར་མ་ལྟ་བུའི་བརྗོད་བྱ་ལ་མ་སྦྱར་ན་དཔེར་བརྗོད་ཀྱང་བཞག་དཀའམ་སྙམ་པས་བརྟག།",
    "རབ་ཏུ་གྲགས་པའི་རྒྱུ་བཟློག་པ་མིན་པར་ཐལ་ལམ་དཔྱད།",
    "འདི་ནི་བདག་གིས་ཡང་དག་ཐོབ།",
    "ཡལ་གའི་ཁྱོན་རྣམས་མི་ཆུང་ཞིང་།",
    "ཤིང་འདི་བདག་གིས་སྐལ་བས་རྙེད།",
    "ཅེས་ཡལ་གའི་ཁྱོན་མི་ཆུང་བ་དང་།",
    "གཅིག་གི་གྲིབ་མས་མང་པོ་སྐྱེད།",
    "ཡལ་གའི་ཁྱོན་མི་ཆུང་བའི་བསམ་དོན་མངའ་ཐང་རྒྱ་ཆེ་བ་དང་།",
    "མཆོག་གི་དངོས་པོ་གྲུབ་པ་དང་།",
    "གསང་གསུམ་བཀོད་པའི་ངོ་མཚར་བགྲང་ཡས་མོད།",
    "རསྨི་དྷྭ་ཛས་མཐུན་པར་སྒོར་མོ་འདི།",
    "མུ་ཁྱུད་ལྔ་པ་ཕྱི་རྩིབས་མཚམས་རེ་དོར།",
    "ན་མོ་གུ་རུ་དཱི་པཾ་ཀ་ར་ཡེ།",
    "རྣལ་འབྱོར་ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱི།",
    "ཞབས་གཉིས་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས།",
    "དགེ་སྦྱོང་ཆས་ཞུགས་མཚན་དཔེའི་ལང་ཚོས་སྒེག།",
    "ལེགས་པའི་ཤེས་རབ་ལང་ཚོ་བགྲེས་ཉམས་ཅན།",
    "ཅེས་ཚོགས་ཞིང་གི་ལྷ་ཚོགས་རྣམས་གསལ་བཏབ།",
    "སྲོལ་བཟང་རྒྱ་མཚོའི་ཁྱོན་ལ་འཇིགས་བྲལ་འཛིན།",
    "བགྲང་ཡས་བསྐལ་མང་ཚོགས་གཉིས་མཐར་བགྲོད་ཅིང་།",
    "དེ་སྲིད་གསུང་གི་དབུགས་དབྱུང་སྩལ་དུ་གསོལ།",
    "དྲང་དོན་ཐུན་མོང་གདུལ་བྱའི་སྣང་ངོ་རུ།",
    "ལྷག་པར་བརྩེ་བའི་ཐུགས་རྗེའི་ཕྱག་རིང་གིས།",
    "དེ་ལྟར་མོས་གུས་གདུང་ཤུགས་དྲག་པོ་ཡིས།",
    "ཐུགས་ཀའི་ཧྲཱི་ལས་འོད་འཕྲོས་རིགས་དྲུག་གི།",
    "ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་ཧྲཱི་ཡིག་གི་མཐར་ཡིག་དྲུག་དང་།",
    "རིགས་དྲུག་གནས་སྦྱོང་གི་དམིགས་པ་དང་བཅས།",
    "ཞེས་ལན་གསུམ་གྱིས་བདུད་རྩི་འབེབས་སྦྱང་གི་དོན་དུ་གསོལ་བ་བཏབ་པས།",
    "བལ་སྐུད་བརྐྱང་བཞིན་རང་གི་ལུས་ལ་ཐིམ།",
    "ངའོ་སྙམ་པའི་རང་གཅེས་ཤུགས་དྲག་གི།",
    "གཉེན་པོས་འགོ་གནོན་བདག་འཛིན་ངང་གིས་འཇོམས།",
    "སྦྱོར་བ་བཞི་དང་ལྡན་པའི་བློ་སྦྱོང་གི།",
    "བྱིང་རྒོད་རྣམ་གཡེང་སྐྱོན་བྲལ་རྩེ་གཅིག་གིས།",
    "ཐུན་མོང་ལམ་གྱིས་བདག་རྒྱུད་སྔོན་སྦྱངས་ཏེ།",
    "དེ་ལྟར་མོས་གུས་གདུང་ཤུགས་དྲག་པོ་ཡིས།",
    "དགྱེས་ཤིང་བརྩེ་བས་བདག་གི་སྤྱི་བོར་བྱོན།",
    "གཞན་དོན་འཕྲིན་ལས་གྲུ་འཛིན་མགོན་ཁྱོད་དང་།",
    "རབ་མཚུངས་ཀུན་གྱི་རེ་བ་སྐོང་བར་ཤོག།",
    "གང་ཤར་ཐ་མལ་ཀུན་རྟོག་གི་སྣང་ཞེན་དང་བྲལ་བར་སྤྱོད་ལམ་དང་།",
    "ཕུན་སུམ་ཚོགས་པ་འབུམ་ཕྲག་གིས་ཤིས་པ་བརྗོད་པས་མཐའ་བརྒྱན་པ་ནི།",
    "རབ་ཡངས་ཁྱོན་ལ་རྣམ་དཀར་དགེ་རླབས་ཀྱིས།",
    "ཞིང་འདིར་ཐུབ་བསྟན་ཉིན་མོ་ནུབ་རིའི་ཕྲག།",
    "ཐར་འདོད་དེད་དཔོན་མཆོག་གི་བཀྲ་ཤིས་ཤོག།",
    "འཕྲིན་ལས་སྒྲུབ་མཆོག་མཁའ་འགྲོ་སྲུང་ཚོགས་བཅས།",
    "ཐོབ་དཀའི་བྱང་ཆེན་རྒྱལ་སར་མྱུར་རེག་ཤོག།",
    "རང་གི་སྤྱི་བོའི་ཚངས་བུག་པད་ཟླའི་སྟེང་།",
    "དཀར་གསལ་མདངས་ལྡན་རེ་འདོད་དང་འཚམ་པར།",
    "ཨོཾ་ཨཱ་གུ་རུ་ཝ་གིནྡྲ་སུ་མ་ཏི་མུ་ནི་ཤཱ་ས་ན་ས་མུ་དྲེ་ན་སརྦ་སི་དྡྷི་ཧཱུཾ་ཧཱུཾ།",
    "གནས་སྐབས་མཐར་ཐུག་དགོས་འདོད་རེ་བའི་འབྲས།",
    "༡བ་ན་མོ་ཨཱརྱ་ལོ་ཀེ་ཤྭ་ར་ཡ།",
    "གནས་གསུམ་ཨོཾ་ཨཱ་ཧཱུཾ་གིས་མཚན་པའི་སྐུར།",
    "འཕགས་མཆོག་འགྲོ་བའི་མགོན་པོ་སྤྱན་རས་གཟིགས།",
    "ཐུགས་ཀར་ཐལ་སྦྱར་ནོར་བུ་ཆུ་ཤེལ་འཛིན།",
    "མགོན་ཁྱོད་རླབས་ཆེན་མཛད་པའི་དགེ་ཚོགས་ཀུན།",
    "སླར་ཡང་མོས་གུས་གདུང་ཤུགས་གསོལ་བཏབ་པས།",
    "རིགས་ཀྱི་བུ་ཁྱོད་སྒྱུ་ལུས་འཕོས་པའི་ཚེ།",
    "རྫུས་ཏེ་སྐྱེས་ནས་ཟབ་གསང་ཐེག་མཆོག་གི།",
    "རེ་བའི་དགོས་འདོད་འབྲས་བཟང་མ་ལུས་པ།",
    "ན་མོ་གུ་རུ་ཨཱརྱ་ལོ་ཀེ་ཤྭ་ར་ཡ།",
    "བྱང་ཆེན་ས་ལ་མ་རེག་པར་དེ་སྲིད།",
    "རྒྱལ་སྲས་སྤྱོད་པ་ཁྱོད་ལས་གཞན་ན་སུ།",
    "ཟབ་མོའི་སྒྲུབ་ཐབས་ཉམས་སུ་ལེན་པའི་ཚུལ།",
    "ཅེས་བདེ་ལེགས་སུ་བྱེད་པའི་ཚིག་གི་ལམ་ཡངས་པོར་བྱས་པ་སྔོན་དུ་བཏང་སྟེ།",
    "ལམ་ཐུན་མོང་བ་དང་ཐུན་མོང་མ་ཡིན་པའི་ཀུན་སློང་གི་བསམ་པ་ཤུགས་དྲག་པོས་རང་རྒྱུད་དུ་ལེགས་པར་བརྟག་ལ་གཞན་ཕན་བསམ་པ་ཁྱད་པར་ཅན་གྱི་ངང་ནས།",
    "རང་གི་མདུན་དུ་གསེར་གྱི་ས་གཞིའི་དབུས།",
    "བར་སྣང་ནམ་མཁའི་ཁྱོན་ཀུན་ཡོངས་འགེངས་པ།",
    "ཡེ་ཤེས་ལྔ་ཡི་འཇའ་ཚོན་འོད་ཕུང་གི།",
    "དབྱེར་མེད་གྲུ་འཛིན་ཞིང་མགོན་སྤྱན་རས་གཟིགས།",
    "རྩ་བའི་ཕྱག་གཉིས་ཐུགས་ཀར་ཐལ་མོ་སྦྱར།",
    "མཁའ་འགྲོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་བཞི་ཡི།",
    "སྤྱན་རས་གཟིགས་དངོས་རྒྱལ་བ་རྒྱ་མཚོ་ལ།",
    "དམིགས་མེད་ཐུགས་རྗེས་རླབས་ཆེན་སྤྱོད་མཆོག་གི།",
    "ཕྱག་བཞིའི་དང་ཟུང་ཐལ་སྦྱར་རྒྱལ་རྣམས་མཆོད།",
    "མགོན་ཁྱོད་དགྱེས་པ་བསྐྱེད་ཕྱིར་རྟག་ཏུ་འབུལ།",
    "མཁའ་ཁྱབ་གདུལ་བྱའི་མོས་ངོ་དང་འཚམ་པའི།",
    "དགྱེས་པའི་མཆོད་སྤྲིན་གཟིགས་མོར་ལེགས་འབུལ་ཏེ།",
    "ཨོཾ་ཨཱ་གུ་རུ་ཝ་གིནྡྲ་སུ་མ་ཏི་མུ་ནི་ཤཱ་ས་ན་ས་མུ་དྲེན་སརྦ་སིདྡྷི་ཧྲུཾ་ཧྲུཾ།",
    "ཆགས་སྡང་ཉོན་མོངས་རྒྱུད་དཀྲུགས་འགྲོ་བ་ཡི།",
    "འཕགས་པའི་ནོར་བདུན་དག་གིས་ལེགས་ཕྱུག་ཅིང་།",
    "འགྲོ་བའི་རེ་བ་ཡིད་བཞིན་སྐོང་བ་ལ།",
    "ཚོགས་ཞིང་གི་རྣལ་འབྱོར་ཉམས་སུ་ལེན་པའི་ཚུལ་ནི།",
    "འཇིག་རྟེན་གསུམ་མགོན་འཕགས་མཆོག་སྤྱན་རས་གཟིགས།",
    "མགྲིན་པར་པད་ཟླའི་སྟེང་དུ་སྤྱན་རས་གཟིགས།",
    "ཕྱག་བཞི་དང་གཉིས་ཐུགས་ཀར་ཐལ་མོ་སྦྱར།",
    "ཐུབ་བསྟན་སྲོལ་བཟང་རྒྱ་མཚོའི་གོས་ཅན་ཁྱོན།",
    "མགྲིན་པ་ལོངས་སྤྱོད་གསུང་གི་རྡོ་རྗེའི་༡༧བ་དབུས།",
    "འགྲོ་རྣམས་ཐུགས་རྗེའི་ཕྱག་གིས་འདྲེན་མཛད་པའི།",
    "ཡིད་འོང་ལྷ་མོ་ནམ་མཁའི་ཁྱོན་ཀུན་ཏུ།",
    "མོས་ངོ་དང་འཚམ་རགས་པའི་གཟུགས་སྐུ་མཆོག།",
    "ཁྱེད་ལས་རེ་ས་གཞན་དུ་མ་མཆིས་པས།",
    "ཐུགས་ཀའི་ཧྲཱི་ལས་འོད་འཕྲོས་རིགས་དྲུག་གི།",
    "ཨོཾ་ཨཱ་གུ་རུ་བཛྲ་དྷ་ར་ཝ་གིནྡྲ་སུ་མ་ཏི་མུ་ནི་ཤཱ་ས་ན་ས་མུ་དྲེན་སརྦ་སི་དྡྷི་ཧཱུཾ་ཧཱུཾ།",
    "ཨོཾ་ཝཱ་གི་ཤྭ་རི་མུཾ།",
    "མགོན་ཁྱོད་སྐྱབས་ཀུན་འདུས་པའི་བདག་ཉིད་དུ།",
    "ཐུན་མོང་ལམ་སྦྱངས་སྔོན་སོང་གསང་སྔགས་ཀྱི།",
    "ཟབ་ལམ་རིམ་ལྔའི་རྣལ་འབྱོར་ཟབ་མོ་ཡི།",
    "ཕྱག་གཡོན་མཉམ་གཞག་གདུལ་བྱའི་རེ་འདོད་དང་།",
    "མ་ལུས་ནམ་མཁའི་ཁྱོན་ཀུན་ཡོངས་འགེངས་བཞུགས།",
    "མགྲིན་པར་གསུང་གི་ངོ་བོ་ཨཱ་དམར་པོ།",
    "མགོན་ཁྱོད་སྐུ་གསུང་ཐུགས་ཡོན་མཛད་ཚོགས་ལ།",
    "དངོས་སུ་བཤམས་དང་ཡིད་སྤྲུལ་ཀུན་བཟང་གི།",
    "ཨོཾ་ཨཱ་གུ་རུ་ཝ་གིནྡྲ་སུ་མ་ཏི་མུ་ནི་ཤཱ་ས་ན་ས་མུ་དྲེན་སརྦ་སིདྡྷི་ཧཱུཾ་ཧཱུཾ།",
    "འཇིག་རྟེན་གསུམ་མགོན་རྗེ་བཙུན་སྤྱན་རས་གཟིགས།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་མཚན་དཔེའི་ལང་ཚོ་འབར།",
    "སྐྱབས་ཡུལ་མ་ཚང་མེད་པ་ནམ་མཁའི་ཁྱོན།",
    "སྐྱོབ་པ་སྤྱན་རས་གཟིགས་ཞེས་མཚན་གསོལ་བའི།",
    "སྣང་གསལ་དྲི་ཆབ་ཞལ་ཟས་རོལ་མོ་དང་།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་འདོད་ཡོན་སོགས།",
    "ཨོཾ་ཨཱ་གུ་རུ་ཝ་གིནྡྲ་སུ་མ་ཏི་མུ་ནི་ཤཱ་ས་ན་ས་མུ་དྲེན་སརྦ་སིདྡྷི་ཧཱུཾ་ཧཱུཾ།",
    "བདག་གི་སྒོ་གསུམ་དུ་ཞུགས་སྒྲིབ་བཞི་སྦྱངས།",
    "ཐུན་མོང་ལམ་གྱིས་རྒྱུད་སྨིན་བྱིན་གྱིས་རློབས།",
    "གསུང་གི་དབུགས་དབྱུང་ཟབ་མོས་ཚིམ་བྱས་ནས།",
    "དགྱེས་ཤིང་བདག་གི་སྤྱི་བོར་བྱོན་པ་ལ།",
    "མོས་གུས་གསོལ་བ་བཏབ་པས་ཚངས་བུག་ནས།",
    "ཀུན་གྱི་རེ་བ་ཡིད་བཞིན་སྐོང་བར་ཤོག།",
    "ཟབ་རྒྱས་བདེན་གཉིས་ཇི་བཞིན་གཟིགས་པའི་ཐུགས།",
    "དེ་ལྟར་གདུང་ཤུགས་དྲག་པོའི་མོས་གུས་ཀྱིས།",
    "ན་མོ་གུ་རུ་ལོ་ཀེ་ཤྭ་ར་ཡ།",
    "རྒྱལ་ཀུན་ཐུགས་རྗེའི་རང་གཟུགས་སྤྱན་རས་གཟིགས།",
    "གནས་གསུམ་ཡི་གེ་ཨོཾ་ཨཱ་ཧཱུཾ་གིས་མཚན།",
    "བདག་གི་ལུས་དང་དུས་གསུམ་དགེ་ཚོགས་རྣམས།",
    "རབ་འབྱམས་ཞིང་ཁམས་ཁྱོན་འགེངས་བློས་སྤྲུལ་ཏེ།",
    "འོད་ཟེར་རྒྱུན་དང་རང་འདྲ་གཉིས་པ་རེ།",
    "ཕྲ་མོའི་རྐྱེན་གྱིས་ནམ་མཆི་ངེས་མེད་པས།",
    "མངོན་བྱས་བདེན་གཉིས་དབྱེར་མེད་ཟུང་འཇུག་གིས།",
    "སྐད་ཅིག་རེར་ཡང་དཔག་ཡས་འགྲོ་བའི་ཚོགས།",
    "བཙན་ཐབས་འཚང་རྒྱའི་སྟོབས་ལྔའི་གདམས་ངག་གིས།",
    "མགོན་ཁྱོད་བཞུགས་གནས་དག་པའི་ཞིང་མཆོག་ཏུ།",
    "རྒྱུད་ཚིམས་རེ་སྨོན་ལྷུན་འགྲུབ་བྱིན་གྱིས་རློབས།",
    "བཅུད་རྣམས་ལྷ་དང་ལྷ་མོའི་སྒྱུ་འཕྲུལ་གར།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་གིས་བྱིན་གྱིས་བརླབས།",
    "རྒྱུ་བའི་དཔའ་བོ་དཔའ་མོ་སྲུང་ཚོགས་བཅས།",
    "ཞེས་ཚོགས་རྣམས་ནང་གི་སྦྱིན་སྲེག་གི་ཚུལ་དུ་རོལ།",
    "ལྷག་ལ་རེ་བའི་མགྲོན་རྣམས་ཚིམ་ཕྱིར་འབུལ།",
    "མཐའ་ཡས་འགྲོ་བའི་རེ་བ་སྐོང་བའི་གསུང་།",
    "མ་ལུས་ཤེས་བྱ་ཇི་བཞིན་གཟིགས་པའི་ཐུགས།",
    "ཟབ་མོ་ལྟ་བ་རྒྱ་ཆེན་སྤྱོད་པའི་ལམ།",
    "བློ་གྲོས་གཟིགས་པ་སྒྲིབ་མེད་ཀེ་ལ་ཤའི།",
    "སྙིགས་དུས་ཚ་ཟེར་བརྒྱ་ཕྲག་གིས་མནར་བས།",
    "མཁྱེན་རབ་ཟབ་མོས་ཐུགས་རྒྱུད་ལེགས་གཏམས་པ།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྩོལ་མཛད་པའི།",
    "ཚེ་དང་ལྡན་པ་ཆེ་གེ་མོ་ཞེས་བགྱི་བ་ལ་སོགས་པ་རང་ཅག་རྣམས་ལ་རེ་ལྟོས་བཅའ་བའི་དད་ལྡན་སྐྱེ་བོ་རྣམས་འགལ་རྐྱེན་ཕྱི་ནང་ཉེར་འཚེས་ནམ་ཡང་མི་བརྫི་བར་གནས་སྐབས་དང་མཐར་ཐུག་གི་སྨོན་པའི་འབྲས་བཟང་མཐའ་དག་ཡིད་བཞིན་དུ་འགྲུབ་པར་གྱུར་ཅིག།",
    "བདག་གི་ལྷག་བསམ་དག་པའི་མཐུ་སྟོབས་ཀྱིས།",
    "བླ་བརྒྱུད་ཕུན་ཚོགས་དགེ་ལེགས་ནས་སྐྱབས་གསུམ་ཀུན་འདུས་མའི་བར་ཤོ་ལོ་ཀ་རེ་རེ་བཞིན་ནས་དབུ་བསྐུལ་དང་།",
    "སོགས་ཤོ་ལོ་ཀ་རེ་རེ་མཐར་ཕྱག་ཏིང་ལན་གཉིས་རེ།",
    "ཁྲུས་གསོལ་སརྦ་ཏ་ཐཱ་ག་ཏའི་སྐབས་ཕྱག་ཏིང་ལན་གསུམ་རེ་བརྡུང་གནང་དང་།",
    "རྒྱལ་བ་རྒྱ་མཚོའི་རོལ་མོའི་སྐབས་ཕྱག་ཏིང་ཕུལ་ཏེ་ལན་གསུམ་བརྡུང་གནང་དང་།",
    "བདག་གི་བསམ་པའི་དབུ་བསྐུལ་མཛད་དེ།",
    "ན་མོ་གུ་རུ་མཉྫུགྷོ་ཥཱ་ཡ།",
    "འཛམ་གླིང་མཁས་པའི་གཙུག་རྒྱན་དབྱིག་གི་གཉེན།",
    "ཟབ་མོའི་ཏིང་འཛིན་བརྟན་པའི་སྣེའུ་ཟུར་བ།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "ཟབ་མོའི་དོན་གཟིགས་འཕགས་མཆོག་ཀླུ་སྒྲུབ་ཞབས།",
    "འགྲོ་བའི་རེ་སྐོང་གསུམ་ལ་ལུང་རྟོགས་མངའ་བདག་བྱང་སེམས་སྤྱིལ་བུ་བ།",
    "ཐུན་མོང་ལམ་སྦྱངས་སྣོད་དུ་གྱུར་པ་ན།",
    "ཕྱི་དང་ནང་གི་བར་དུ་གཅོད་པའི་ཚོགས།",
    "གསུང་གི་བདུད་རྩིས་དབུགས་དབྱུང་ཐོབ་པར་ཤོག།",
    "སྒྲིབ་གཉིས་བྱང་ཞིང་ཚོགས་གཉིས་མྱུར་རྫོགས་ནས།",
    "རབ་འབྱམས་ཞིང་གི་དཀྱིལ་འཁོར་མཐའ་ཀླས་པའི།",
    "གྲུབ་བརྙེས་གསུམ་ལྡན་དགེ་སློང་མ་དཔལ་མོ།",
    "རྨད་བྱུང་བདེ་གཤེགས་རྒྱལ་ཀུན་མཐའ་དག་གི།",
    "གང་འདུལ་མོས་ངོ་དང་འཚམ་སྐུའི་བཀོད་པ།",
    "སྤྲོ་མཁས་མིག་གི་བདུད་རྩི་དགའ་བའི་རྒྱན།",
    "གསུང་གི་མཛད་པ་མཆོག་དེར་ལྷག་པར་དད།",
    "ཇི་སྙེད་ཤེས་བྱའི་ཁྱོན་ཀུན་མ་ལུས་པ།",
    "གང་གི་མཁྱེན་པའི་ཆ་ཤས་རེ་རེས་ཀྱང་།",
    "རྒྱལ་རྣམས་ཕན་ཚུན་མཁྱེན་པའི་གཟིགས་ཡུལ་ལས།",
    "བརྗོད་ཀྱང་ཁྱོད་བསྔགས་ཇི་བཞིན་ག་ལ་སྤོངས།",
    "ཚངས་སྤྱོད་ཡོངས་སུ་འཛིན་པའི་ངུར་སྨྲིག་གི།",
    "ཐུན་མོང་ཕྱིན་དྲུག་བསྡུ་བཞིའི་ཉམས་ལེན་དང་།",
    "ལྷག་པའི་ལྷ་མཆོག་གང་གི་ཞལ་དཀྱིལ་མཐོང་།",
    "གསུང་གི་ལུང་བསྟན་དབུགས་དབྱུང་ཐོབ་པར་ཤོག།",
    "དེར་ཡང་ལྷ་ཁྱོད་ཞལ་བཟང་མངོན་འགྱུར་ནས།",
    "ཟབ་རྒྱས་བདུད་རྩིའི་གསུང་གི་དགའ་སྟོན་མྱོང་།",
    "མཐར་ཐུག་༦བ་གི་རེ་བའི་འདོད་དོན་ལྷུན་གྱིས་འགྲུབ་པ་དང་།",
    "རྣམ་དག་གི་བསླབ་གསུམ་ལེགས་ནོད་དེ།",
    "རྨད་བྱུང་རིང་ལུགས་བློ་ཆེན་བཟང་པོའི་ཁྱོན།",
    "ངང་གི་འདུ་བའི་དགེ་མཚན་ཕྱོགས་ཁྱབ་ཤོག།",
    "ཕུལ་བྱུང་མཛེས་སྡུག་ལང་ཚོའི་ལྷའི་རྣམ་རོལ།",
    "ཕུལ་བྱུང་ཚེ་སྦྱིན་ལྷ་མོས་དགེ་ལེགས་སྩོལ།",
    "མ་སྨད་ཐུབ་བསྟན་རྒྱ་མཚོའི་ཁྱོན་ཡངས་པོར།",
    "འཇིགས་མེད་སེང་གེའི་ཁྲི་ལ་ཞབས་ཟུང་གི།",
    "རྡོ་རྗེ་རེ་ཁ་གདུལ་བྱའི་ཕྱི་མཐའི་བར།",
    "ཐབས་ལ་མཁས་པའི་རྒྱལ་སྲས་སྤྱོད་མཆོག་གིས།",
    "ནང་དུ་རིམ་གཉིས་རྣལ་འབྱོར་ཟབ་མོས་གཏམས།",
    "ཐུན་མོང་ལམ་གྱིས་བདག་རྒྱུད་སྨིན་པ་ན།",
    "མི་བཟད་ངན་སོང་འཇིགས་པའི་གཡང་སྤོངས་ནས།",
    "མགོན་ཁྱོད་རྗེས་སུ་སློབ་པར་བྱིན་གྱིས་རློབས།",
    "གསུང་གི་བདུད་རྩིར་ངོམས་མེད་ལོངས་སྤྱོད་པའི།",
    "དད་མོས་གཉིས་ཚོགས་རྒྱུ་འབྲས་རྗེས་འགྲོ་བའི།",
    "གང་གི་ཞབས་ཀྱི་པདྨོར་གསོལ་བ་འདེབས།",
    "མཚན་ལྡན་བཤེས་གཉེན་མཆོག་གི་མགོན་དང་བཅས།",
    "ཉོན་མོངས་གདུག་པའི་དཔུང་ཚོགས་གཞོམ་པར་མཛོད།",
    "ན་མོ་ལོ་ཀེ་ཤྭ་ར་ཡ།",
    "ཐུན་མོང་ཐུན་མིན་ལམ་བཟང་མངོན་འགྱུར་ཤོག།",
    "དེ་ལྟར་སྨོན་པའི་རེ་འབྲས་མཐའ་དག་རྣམས།",
    "ཞལ་བཟང་ངོ་མཚར་མིག་གི་ཡུལ་དུ་འཆར།",
    "གསུང་གི་བདུད་རྩིའི་དབུགས་དབྱུང་ཐོབ་པར་ཤོག།",
    "རེ་བའི་འབྲས་བུ་ཇི་བཞིན་འགྲུབ་པར་ཤོག།",
    "པད་དཀར་ལྟར་བསྔགས་རྣམ་འདྲེན་སྟོང་གི་དབུས།",
    "རང་གཞན་དོན་ཀུན་སྒྲུབ་པའི་ཐབས་མཆོག་གི།",
    "ཐབས་མཁས་གང་འདུལ་གཞན་ཕན་འོད་སྣང་གིས།",
    "སྲིད་ཞིའི་ཕུན་ཚོགས་ནོར་བུའི་ཏོག་གིས་མཛེས།",
    "བརྗོད་བྲལ་ཁྱོན་ཡངས་མཐའ་དབུས་ཀུན་ཁྱབ་ཤོག།",
    "གྲགས་སྙན་སྲིད་པའི་ཁྱོན་ཡས་བརྒལ་བར་ཤོག།",
    "བཤེས་གཉེན་འདྲེན་པ་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "མཐུན་རྐྱེན་རེ་བ་རྫོགས་པའི་དགའ་སྟོན་སྩོལ།",
    "རབ་སྒེག་ཡིད་འོང་ལྷ་མོའི་གཟུགས་ཤར་བ།",
    "ལྷ་མོ་ཡིད་བཞིན་འཁོར་ལོར་གསོལ་བ་འདེབས།",
    "ཐུན་མིན་སྣོད་རུང་ཚོགས་ལ་འདོམས་མཛད་པ།",
    "ཕན་བདེའི་རྩ་ལག་ཉི་མའི་གཉེན་མཆོག་གི།",
    "སྐབས་བབས་ཐུན་མོང་གདུལ་བྱའི་ཚོགས་རྣམས་ཀྱང་།",
    "བསམ་དོན་རེ་བ་འགྲུབ་པའི་བཀྲ་ཤིས་ཤོག།",
    "རྨད་བྱུང་རྒྱལ་ཡུམ་ཤེར་ཕྱིན་ཟབ་མོའི་དོན།",
    "ཐུགས་རྗེའི་རང་མདངས་རྗེ་བཙུན་མ་དཔལ་མོ།",
    "འགྲོ་བའི་རེ་སྐོང་རྣམས་ལ་གསོལ་བ་འདེབས།",
    "སླར་ཡང་གདུལ་བྱའི་རེ་འདོད་སྐོང་བའི་ཕྱིར།",
    "ཟབ་རྒྱས་བདུད་རྩིའི་མཛད་འཕྲིན་འོད་སྣང་གིས།",
    "དེ་ལྟར་སྨོན་པའི་རེ་འབྲས་མཐའ་དག་རྣམས།",
    "མཆོག་གསུམ་དམ་པའི་བདེན་འབྲས་ཟབ་མོའི་དོན།",
    "གདུལ་བྱའི་རེ་འདོད་ཡིད་བཞིན་ལེགས་སྐོང་སྟེ།",
    "མི་འཇིགས་པའི་ཕྱག་རྒྱ་སོགས་རང་གང་མོས་ཀྱི་སྐབས་སུ་གང་བབས།",
    "རྨད་བྱུང་ལྷ་མོ་གསུམ་གྱིས་ཤིས་པར་སྩོལ།",
    "ཐ་མལ་གཉིས་འཛིན་འཁྲུལ་བའི་བདེན་སྣང་གི།",
    "དེང་ནས་བྱང་ཆེན་ས་ལ་མ་རེག་པར།",
    "འཕྲལ་ཡུན་གཏན་བདེའི་སྨོན་པའི་རེ་འདོད་ཀྱིས།",
    "སྐྱོང་མཁས་བུ་མོ་ཟླ་བ་མཆོག་མངའ་དང་།",
    "གྲུབ་པ་མཆོག་བརྙེས་མ་ཏང་གི་པའི་ཞབས།",
    "འཆད་རྩོད་རྩོམ་པའི་རྒྱལ་མཚན་རྩེ་མོ་རུ།",
    "མཚན་དཔེ་ངོ་མཚར་དུ་མའི་ལང་ཚོས་སྒེག།",
