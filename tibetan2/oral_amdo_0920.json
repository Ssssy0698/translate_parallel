    "བདག་གི་ཐོས་བསམ་བསྒོམ་ལ་ཉེར་བརྩོན་པའི།",
    "མངོན་སུམ་ཞལ་མཐོང་དྲན་པའི་མོད་ཉིད་ལ།",
    "གསུང་གི་དབུགས་འབྱིན་དངོས་སུ་ཐོག་པར་ཤོག།",
    "གོང་དུ་སྨོན་དོན་རེ་འབྲས་ཅི་མཆིས་པ།",
    "གཞན་ཡང་སྐྱེ་བོ་མཆོག་དམན་མཐའ་དག་གི་ཁ་འདོན་དུ་བྱས་ཆོག་པ་ཞིག་ངག་རྩོམ་འདྲི་དགོས་ཞེས་ལྷ་རེག་ནང་མཛོད།",
    "ཕྱིན་དྲུག་བསྡུ་བཞིའི་རླབས་ཆེན་སྤྱོད་མཆོག་གི།",
    "ཡིད་འོང་ལང་ཚོའི་འགོར་ཚོགས་འཁོར་གཏོང་།",
    "ཡིད་འོང་ལང་ཚོ་ནས།",
    "སྐྱབས་སེམས་ལན་གསུམ་རེ།",
    "ཡུལ་མཐའ་འཁོབ་འགྲོ་ལ་ལྷག་པར་གཟིགས།",
    "རྙེད་དཀའ་བ་ད་རེས་ལན་ཅིག་ཐོབ།",
    "འཆི་བདག་གིས་གཤིན་རྗེས་མདུན་ནས་བསུས།",
    "སྐྱབས་གྲུ་འཛིན་བདག་པོའི་དཔལ་མཆོག་གིས།",
    "ཐུགས་བརྩེ་བས་མི་གཟིགས་ག་ལ་མངའ།",
    "གཟིགས་བཞིན་དུ་ཡལ་བར་འདོར་སྲིད་ན།",
    "འགྲོ་བདག་ཅག་ཁྱོད་མིན་སུ་ལ་རེ།",
    "དུས་དེང་ཡང་ལྷག་པར་དགོངས་གཟིགས་གསོལ།",
    "ཡོངས་འགྲོ་བའི་མོས་དང་ཁམས་ཕྲ་རགས།",
    "སྒྲིབ་མི་མངའ་ཀུན་མཁྱེན་གཟིགས་མོ་རུ།",
    "དུས་དེ་རིང་ཐུགས་རྗེས་གཟིགས་ཤིག་ཀྱེ།",
    "མྱུར་བའི་ལམ་རྣལ་འབྱོར་ཟབ་མོ་ཡིས།",
    "དགའ་ཆེན་མཆོག་ཐར་ལམ་མྱུར་རེག་ཤོག།",
    "དུས་འདི་ནས་བྱང་ཆེན་མ་རེག་པར།",
    "གཞུང་ལུགས་ཟབ་མོའི་དཔྱད་བསྒོམ་ལེགས་རྟོགས་ཤིང་།",
    "དེ་ལྟར་ལེགས་བྱས་སྨོན་པའི་རེ་འབྲས་རྣམས།",
    "འཕྲིན་ལས་སྒྲུབ་མཛད་མཁའ་འགྲོ་སྲུང་ཚོགས་ཀྱིས།",
    "རྣམ་འདྲེན་སྟོང་གི་སྤྱི་ཕུད་ཉི་མའི་གཉེན།",
    "རྒྱལ་བའི་བསྟན་ལ་རི་མོར་བྱེད་པ་ཡི།",
    "དེ་ལྟར་སྨོན་པའི་རེ་འབྲས་ཅི་མཆིས་ཀུན།",
    "གསོལ་དཔོན་གུ་ཤྲི་བློ་བཟང་རབ་རྒྱས་བཅས་ནས་འདོད་དོན་སྨོན་ཚིག་ཚོགས་འདོན་དུ་བཙུགས་ཆོག་པ་འདི་ལྟར་འདྲི་དགོས་ཞེས་སོག་དར་ཨ་མུ་ཤེ་དང་།",
    "ན་མོ་གུ་རུ་མེ་ཏྲི་ཡ།",
    "དགའ་ལྡན་དུ་བཞུགས་འཛམ་གླིང་འདི་ན་གཟིགས།",
    "གསུང་གི་བདུད་རྩིས་བདག་རྒྱུད་ཚིམ་བྱས་ནས།"
  ]
