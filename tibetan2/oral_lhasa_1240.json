    "ཀུན་གྱི་ས་བོན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱི་རྒྱུར་གྱུར་པའོ།",
    "ཆགས་ལ་སོགས་པ་དང་ལྷན་ཅིག་ཏུ་སྐྱེ་བ་དང་འགག་པ་ཡང་དང་ཡང་དུ་ཉམས་སུ་མྱོང་བར་བྱས་ནས་ས་བོན་ཡོངས་སུ་གཟུང་བའི་སྒོ་ནས་སྐྱེ་བར་འགྱུར་བ་དེ་རྣམས་ཀྱི་སྐྱེ་བའི་རྒྱུར་གྱུར་པའོ།",
    "དེ་ལྟ་བུའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ལྟར་ཡོད་པར་ཅིས་གྲུབ་ཅེ་ན།",
    "དེ་ལ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡོད་པ་མ་གྱུར་ན་གཉིད་སྟུག་པོ་ལོག་པའི་སད་པའི་རྣམ་པར་ཤེས་པ་གང་ལས་སྐྱེ་བར་འགྱུར།",
    "དེས་ན་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ཡོད་པ་ཡིན་ཏེ།",
    "གང་ལས་སད་པའི་དུས་རྣམ་པར་ཤེས་པ་སྐྱེ་བའོ།",
    "བརྒྱལ་བ་ལས་ལངས་པའི་དུས་དང་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལས་ལངས་པའི་ཚེ་གལ་ཏེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མི་འདོད་ན་རྣམ་པར་ཤེས་པ་གང་ལས་སྐྱེ་བར་འགྱུར།",
    "དེས་ན་གང་ལས་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་འགྱུར་བའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡོད་པ་ཉིད་དོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་རྒྱ་མཚོའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཉིད་ལོག་པ་ལྟ་བུའི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་རྒྱ་མཚོ་ལྟ་བུ་ཡིན་ལ་གཉིད་ལོག་པ་ལྟ་བུ་ནི་བག་ཆགས་ཡིན་ཞིང་།",
    "འདིར་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་ཡང་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་སྐྱེ་བའི་དུས་ན་ཡང་ངོ།",
    "རྣམ་པར་ཤེས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ཞེས་བྱ་བ་ནི་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་ཤེས་པ་བརྒྱུད་པའོ།",
    "གཟུང་བ་དང་འཛིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་བག་ཆགས་ནི་གཟུང་བ་དང་འཛིན་པར་རྣམ་པར་རྟོག་པ་དང་རྗེས་སུ་མཐུན་པའི་ཤེས་པ་སྐྱེ་བའི་ནུས་པའི་ཁྱད་པར་རོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་རྣམ་པར་ཤེས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པས་གང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་བསྐྱེད་ནུས་པ་གང་གཞག་པ་དེ་ལས་སོ།",
    "དེའི་རྒྱུར་གྱུར་པའི་ཁྱད་པར་རོ།",
    "དེ་ལས་ཞེས་བྱ་བ་ནི་བག་ཆགས་ཀྱིས་བསྒོས་པའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་སོ།",
    "དཔེར་ན་སྒོའི་རྣམ་པར་ཤེས་པ་ཡོད་ན་ནང་རོལ་གྱི་ཤེས་པ་ཡོངས་སུ་སྨིན་པའི་རྐྱེན་ཡིན་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་ལས་ཐ་དད་དུ་གྱུར་པའི་གཟུང་བ་ནི་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "དེ་བཞིན་དུ་སེམས་ཙམ་པ་རྣམས་ཀྱིས་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་རྒྱུ་ཉིད་དུ་བརྗོད་པ་ཡིན་ནོ།",
    "བ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་སེམས་ཙམ་པའི་ལུགས་ཀྱི་རྣམ་གཞག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་ནི་དངོས་པོ་བརྟགས་པར་ཡོད་པའི་རྒྱུར་གྱུར་ཅིང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཐ་སྙད་ཙམ་དུ་ཡོད་པ་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་དངོས་པོ་བརྟགས་པར་ཡོད་པ་ཞེས་བྱ་ལ།",
    "སེམས་ཙམ་པ་རྣམས་ནི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པའི་ཚོགས་ལ་དངོས་པོ་བརྟགས་པར་ཡོད་པ་ཞེས་བརྗོད་ལ།",
    "སྔོན་པོར་སྣང་བའི་མཚན་ཉིད་ཅན་མེད་ན་གཟུང་བ་དང་འཛིན་པར་རྣམ་པར་རྟོག་པའི་ཚོགས་གང་ལ་བརྟེན་པར་འགྱུར།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་མ་ལྟོས་པར་ཞེས་བྱ་བ་ནི་ཐག་པ་ལ་མི་ལྟོས་པར་རོ།",
    "རྣམ་པར་རྟོག་པ་ལོག་པའི་རྟེན་ཡིན་པའི་ཕྱིར་རྣམ་པར་བྱང་བའི་རྒྱུ་ཡིན་ནོ།",
    "ཡང་དག་པར་རྗེས་སུ་མཐོང་ལ་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་པས་སོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདིར་ཞེས་བྱ་བ་ནི་ཚིགས་སུ་བཅད་པར་རོ།",
    "གལ་ཏེ་དངོས་པོར་བརྟགས་པར་ཡོད་པའི་རྒྱུར་གྱུར་པ་ཉིད་ཀྱང་དོན་བཞི་པར་གསུངས་པས་གསུམ་ཞེས་ཇི་ལྟར་བརྗོད་ཅེ་ན།",
    "དེ་ལ་ལན་ནི་བཏགས་སུ་ཡོད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་རྨི་ལམ་ན་དོན་མེད་ཀྱང་དོན་དུ་སྣང་བའི་སྒོ་ནས་དོན་འགྲུབ་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "ཅེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་འགྱུར་བས་ལན་མི་བརྗོད་དོ།",
    "དེས་ན་ཉམས་སུ་མྱོང་བས་འགྲུབ་པར་འདོད་ན་གཉིས་ཀ་ཡང་ཉམས་སུ་མྱོང་བས་ཁས་ལེན་དགོས་སོ།",
    "འདི་ཉིད་ཅེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་དོན་མེད་པས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བསྒོས་པའི་བག་ཆགས་ཀྱི་ཁྱད་པར་ལས་དོན་དུ་སྣང་བའི་ཤེས་པ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེའི་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁང་མིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅུང་ཟད་གཉིད་ཀྱིས་ལོག་པས་ཞེས་བྱ་བ་ནི་གཉིད་སྟུག་པོ་ལོག་པའི་གནས་སྐབས་ན་རྨི་ལམ་མཐོང་བ་མི་སྲིད་པས་ཅུང་ཟད་གཉིད་ཀྱིས་ལོག་པས་ཞེས་གསུངས་སོ།",
    "གླང་པོ་ཆེ་མྱོས་པའི་ཁྱུ་རྨིས་པ་ནི་ཅི་ཞིག་ལྟར་ཡང་ཡོད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་ཤིན་ཏུ་མི་སྲིད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
