    "འདི་ཕྱིར་རིག་པའི་གནས་ལྔར་མཁས་པར་འགྱུར",
    "ཡེ་ཤེས་རྒྱན་ལྡན་རང་༢༢བ་བཅས་ཐོབ་པར་འགྱུར",
    "པད་འབྱུང་སྐུ་འདྲ་རྡུལ་ཕྱིས་སུས་བྱས་པ",
    "པད་འབྱུང་སྐུ་ཚབ་མཆོད་གཡོག་སུས་བྱས་པ",
    "རྫུ་འཕྲུལ་རྐང་པའི་མྱུར་མགྱོགས་ཐོབ་པར་འགྱུར",
    "དབུལ་ཕོངས་ཀུན་བྲལ་དཀོར་ནོར་ཚོགས་པར་འགྱུར",
    "གནས་གཙང་ཐོབ་ཅིང་དྲི་མ་མེད་པར་འགྱུར",
    "བཀྲེས་པ་མེད་ཅིང་བདེ་ལེགས་ཐོབ་པར་འགྱུར",
    "བདུད་རྩིའི་རྒྱ་མཚོ་མཆོག་ལ་སྤྱོད་པར་འགྱུར",
    "འདོད་འཇོའི་བ་དང་རྐང་འགྲོས་སྤྱོད་པར་འགྱུར",
    "ཞལ་ཟས་འདོད་དགུའི་ལོངས་༢༣ན་སྤྱོད་ཐོབ་པར་འགྱུར",
    "ལྷ་ཡི་ན་བཟའ་རྒྱན་བཟང་ཐོབ་པར་འགྱུར",
    "པད་འབྱུང་སྐུ་འདྲར་བསྐོར་ཕྱག་སུས་བྱས་པ",
    "རྒྱལ་པོ་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "བློན་པོ་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "དམག་དཔོན་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "རྟ་མཆོག་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "གླང་པོ་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "ནོར་བུ་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "འཁོར་ལོ་རིན་ཆེན་ལྟ་བུ་ཐོབ་པར་འགྱུར",
    "ལོངས་སྤྱོད་རྫོགས་པའི་ཞིང་ཁམས་ཐོབ་པར་འགྱུར",
    "དབྱིངས་རིག་དོན་ལ་མ་ཡེངས་གནས་པར་འགྱུར",
    "པད་འབྱུང་སྐུ་འདྲར་སྤྱན་འབྱེད་སུས་བྱས་པ",
    "ལྷ་སྙན་དར་བུ་ཁས་ལ་གསང་བར་འགྱུར",
    "དྲི་ཞིམ་ངད་ལྡན་རྒྱུན་ལ་གནས་པར་འགྱུར་པད་འབྱུང་ཚེམས་ལ་དཀར་མདངས་སུས་བཏོན་པ",
    "ཐམས་ཅད་སྒྲོལ་བྱེད་ལྗགས་དང་ལྡན་པར་འགྱུར",
    "སེམས་བསྐྱེད་ཏིང་ངེ་འཛིན་ལ་གནས་པར་འགྱུར",
    "འགྲོ་བ་མང་པོའི་ལས་སྒྲིབ་དག་པར་འགྱུར",
    "རང་བཞིན་མེད་པར་རང་ལུས་ཡབ་ཡུམ་གསལ",
    "དགའ་བའི་མདངས་ཕྱུང་སྙན་པའི་གསུངས་བསྒྲགས་ཀུན",
    "འདི་ལྟར་ཅི་ཡང་མེད་པར་གཏོང་ཤེས་ན",
    "ཉི་ཟླའི་ཞལ་ནི་ཀུན་ལ་མཛེས་པར་སྟོན",
    "བདེན་པའི་ཚིག་ནི་རང་བཞིན་མེད་པར་སྒྲོག",
    "མཁྱེན་པའི་ཡེ་ཤེས་ཉི་ཟླ་གསལ་བའི་འོད",
    "བྱི་དོར་དག་ཅིང་གཙང་མའི་དངོས་གྲུབ་གཏེར",
    "ཆེ་བའི་ཡོན་ཏན་ཁྱད་པར་འཕགས་ལ་ཕུལ",
    "སློབ་དཔོན་ཞལ་ནས་ལྷ་སྲས་བཙན་པོ་ལགས",
    "སྙན་པས་ས་སྟེང་ཐམས་ཅད་ཁྱབ་པར་འགྱུར",
    "གཟུགས་མཛེས་བོངས་འཚམ་ལྕེ་རིང་གདོང་པར་ཚུགས",
    "གཏེར་ཁ་ཉེར་བརྒྱད་གཞན་ཡང་འབྱེད་པར་འགྱུར",
    "ཉིན་པར་མང་གསེབ་བག་མེད་ཆང་མ་འཐུང་",
    "ཅེས་གསུངས་བཀའ་གཏད་གཟེངས་བསྟོད་ལུང་བསྟན་པས",
    "སློབ་དཔོན་པདྨའི་ཞལ་ནས་འདི་སྐད་གསུངས",
    "དད་པ་ཚོལ་ཕྱིར་སྡུག་བསྔལ་བཟོད་པར་གྱིས",
    "འདྲེ་ཡི་གཙེར་བ་རྣམས་ཀྱང་སྒྲིབ་པར་འགྱུར",
    "ཡུལ་བདག་བྱམས་ཤིང་བརྡུང་བཙོག་མེད་པར་འགྱུར",
    "༢༩ན་བརྟགས་ཤིང་དཔྱད་ནས་བླང་དོར་མེད་པར་སྐྱོངས",
    "ཕྱི་ནང་བར་གསུམ་ཞེན་པ་ལོག་བྱས་ནས",
    "བསམ་འགྲུབ་ཤེལ་གྱི་བྲག་ཕུག་དགོངས་པར་བཞུགས",
    "ང་ནི་འཁུ་ཞིང་དམ་འདའ་ལྡོག་པར་འགྱུར",
    "སྐུ་གསུང་ཐུགས་བརྟེན་པེ་ཀར་གཏོད་པར་བྱས",
    "འཁུ་དང་བཟློག་ན་ཇི་ལྟར་ཡོང་ཞེས་གསུངས",
    "དྲག་དྲག་འཆི་ཞིང་ཞན་ཞན་ལུས་པར་བྱེད",
    "གདམས་པར་བློ་མི་ཁེལ་ཞིང་ཡིད་གཉིས་ཟ",
    "ང་བཟློག་པ་ལ་བཟློག་ལུགས་གསུམ་བྱས་འོང་",
    "བུ་སྨད་ལྕེབ་པར་མཁར་གཡང་མཐོན་པོར་འཆོར",
    "ས་གཞི་བཤེག་ཅིང་རྒྱ་མཚོ་དཀྲུག་པར་བྱེད",
    "ལོ་ཧི་ཏའི་འགྲམ་དགོངས་པ་བཞུགས་པའི་དུས",
    "མགོ་ལུས་མེད་པར་མིག་ཡོད་ཇི་ལྟར་ཡིན",
    "ཚེ་འདིར་ལེགས་པར་བྱས་དང་ཉེས་པར་བྱས",
    "ཚ་གྲང་མ་སྙོམས་བསྒུལ་བསྐྱོད་བྱས་པ་དང་",
    "ཨིག་དང་གློ་འབྱུང་ཁ་མིག་ལྟག་པར་ཡོ",
    "ང་ཞུད་འཁོན་དང་མི་གཙང་གྲིབ་ལ་གཟའ",
    "དགྲ་མགོ་ཡན་པར་བཏང་ནས་དམ་ཚིག་ཉམས",
    "སློབ་དཔོན་ཞལ་ནས་ལྷ་སྲས་བཙན་པོ་གསུང་",
    "ཁོ་ཐག་མ་ཆོད་པད་འབྱུང་དྲུང་དུ་བཞུགས་ནན་ཏན་དྲི་བ་ད་ལྟའི་དུས་སུ་གྱིས",
    "གོས་ཟད་དུག་པོ་གསར་པར་མི་འགྲོ་བཞིན",
    "ཡོན་མཆོད་དགྱེས་སོ་ལྷ་སྲས་བཙན་པོ་གསུང་",
    "སྦྲ་དང་ཆ་ཐེར་ཕུབ་ལ་ཐབ་ཀ་ཚུགས་བཟའ་བཏུང་གཡོས་ལ་ཆེ་རུ་ཤོམས་ཤིག་གསུངས",
    "ཆིབས་པ་བབས་ནས་རྡོ་ཡི་མཆོད་རྟེན་བཞུགས",
    "ད་ལྟ་བཞུགས་དང་མ་འོངས་འབྱོན་པ་ཡི",
    "ཐམས་ཅད་ཐུགས་ལ་འདི་བཞིན་གཞག་པར་ཞུ",
    "རིམ་པར་བར་བར་དཔག་ཚད་བཞི་སྟོང་ཡོད",
    "རིམ་པར་བར་བར་དཔག་ཚད་ཉིས་བརྒྱ་ཡོད",
    "རིམ་པར་བར་བར་དཔག་ཚད་ལྔ་སྟོང་ཡོད",
    "རིམ་པར་བར་བར་དཔག་ཚད་བཞི་སྟོང་ཡོད",
    "རིམ་པར་བར་བར་དཔག་༢༡༧བ་ཚད་གསུམ་སྟོང་ཡོད",
    "སྐོམ་ནི་རྣག་ཁྲག་མི་གཙང་ཁྲོ་ཆུར་མངོན",
    "འགུལ་ཞིང་རྒྱུག་དང་ཕྱི་ནས་འདེད་པར་མཐོང་",
    "ཤིན་ཏུ་བཀྲེས་སྐོམ་སྡུག་བསྔལ་མ་བཟོད་ནས་མི་གཙང་བ་དང་སྣབས་ལུད་རྙེད་གྱུར་ཀྱང་",
    "གཞན་གྱིས་ཁྱེར་དོགས་གྲིམས་པར་བསྲུང་བ་ཡང་",
    "ལོངས་སྤྱོད་དཀྱིལ་དུ་རྐེད་པ་ནུབ་བྱས་ནས",
    "རྒྱུ་ཤེ་སྐྱེད་ཚད་ལོག་པར་འགྲོ་བ་དང་",
    "རིམ་པར་ཆགས་ནས་ལྟེ་བའི་རྩ་མདུད་ནི",
    "མ་ཡི་མངལ་གནས་དྲོ་འཇམ་མ་ལགས་ཏེ",
    "བུ་རྫིས་ཉར་ཅག་མ་བྱས་ཉེན་གྱུར་རྣམས",
    "འདི་བྱུང་འཆད་པར་མི་ཤེས་ངུ་བ་ལས",
    "མེད་པར་དབུལ་ཕོངས་ཡོ་བྱད་ལག་བོར་ཏེ",
    "ཉིན་པར་བྱིང་རྨུགས་ཚ་གྲང་རྐྱེན་མི་ཐེག",
    "གོས་ཕུད་གྱོན་པར་མི་ནུས་འཁྱགས་པ་བསྲན",
    "ངོ་ཚའི་གནས་རྣམས་སྦེད་པར་མི་ཤེས་སྟོན",
    "མ་རིག་པས་ན་རྒྱུ་བྱས་ཡི་དྭགས་རྐྱེན",
    "རྒན་པས་གཡོག་བྱས་གཞོན་པས་འདྲེ་བརྡུངས་བཟིར",
    "གཏར་སྲེག་དཔྱད་བྱས་འཆི་ཡང་ན་ཚེ་བསྲན",
    "མེད་པར་བྱས་ནས་བློ་ཡི་བདེ་ཤོས་བྱེད",
    "སྨྲ་ཚན་ཅན་གྱིས་ཡུས་གཤགས་འདེབས་སུ་མེད",
    "ཡི་དྭགས་བཀྲེས་སྐོམ་སྡུག་བསྔལ་སྐྱོབ་པར་བྱེད",
    "དྷི་ནི་ལྷ་མིན་གུ་རུ་རྣམ་པར་རྒྱལ",
    "ལྷ་མིན་འཐབ་རྩོད་སྡུག་བསྔལ་སྐྱོབ་པར་བྱེད",
    "དབེན་གནས་རི་ཐང་མཚམས་སུ་མ་བྱེད་པར",
    "ལྷ་ས་བསམ་ཡས་ཁྲ་འབྲུག་རྩར་སྐྱེས་ཀྱང་",
    "དུས་དང་རྣམ་པར་ཤིན་ཏུ་སྡུག་བསྔལ་ཡོད",
    "ད་ལྟ་བཞུགས་དང་མ་འོངས་འབྱོན་པ་ཡི",
    "བོད་རྣམས་ཐུགས་ལ་འདི་ལྟར་བཞག་པར་ཞུ",
    "སོར་གྱིས་སླེབ་པར་འདོམ་གྱིས་མི་འགྱངས་འགྲོ",
    "ཡང་སྒོས་བོད་ཁམས་ཡོངས་ལ་དྲིན་ཆེར་བྱས",
    "ཀུན་གྲོས་མ་བྱས་བློ་མཐུན་བཤོལ་བཏབ་སྟེ",
    "ཨུ་རྒྱན་བརྒྱུད་འཛིན་འགའ་ཡང་བཞུགས",
    "ལྷ་ས་བསམ་ཡས་ལ་སོགས་པའི",
    "ཨུ་རྒྱན་བཞུགས་དང་ཁྱད་པར་མེད",
    "ང་ཡི་སྤྲུལ་པས་འགྲུབ་པར་འགྱུར",
    "དངོས་ཀྱིས་བསྡད་ཀྱང་འཐུལ་མི་འགྱུར",
    "འགྲོ་དོན་ཐེབས་གཅིག་བྱས་ཟིན་གསུང་",
    "བཤོལ་མ་ཐེབས་པར་གུང་ཐང་ལ་གར་བྱོན",
    "ལྷ་སྲས་རྗེ་འབངས་རྣམས་ཀྱིས་ཕྱི་ཕྱག་མཛད",
    "སློབ་དཔོན་རྗེ་འབངས་རྣམས་ལ་མགུར་འདི་གསུངས",
    "ཉིན་མཚན་བསྒོམ་དུ་མེད་པར་ཡེངས་མེད་འགྲོ",
    "ཤེས་བྱར་མ་རྨོངས་ཐམས་ཅད་མཁྱེན་ནས་འགྲོ",
    "རྗེ་འབངས་ཡུན་དུ་སྐུ་ཁམས་བདེ་བར་བཞུགས",
    "ཅེས་གསུངས་ང་འགྲོ་གསུངས་ནས་སེང་ལྡེང་སྒའི",
    "འདོམ་གང་ཙམ་གྱིས་ནམ་མཁར་འཕགས་ནས་བཞུགས",
    "ཉིན་པར་འཇིག་རྟེན་བྱ་བས་གཡེངས",
    "སང་བྱ་གནངས་བྱར་མི་ཚེ་ཟད",
    "ཞེས་གསུངས་རྟ་མཆོག་རིན་ཆེན་སྟེང་དུ་ཆིབས",
    "ཉི་ཤུ་ལྔ་པར་མཉམ་པར་བཞག་ནས་སུ",
    "ཕྲིག་ཕྲིག་བོད་དུ་ལམ་ལམ་བྱས་ནས་བཞུད",
    "མཉམ་པར་བཞག་ཅིང་བལྟས་ཀྱང་མ་མཐོང་བར",
    "རྒྱ་གར་ཕར་བརྒལ་ཨུ་རྒྱན་མ་སླེབ་པར་ཛམྦུ་ཟ་རིའི་ཁར་གཤེགས་བཞུགས་པ་མཐོང་",
    "དེ་ནས་ནང་པར་མཉམ་གཞག་བལྟས་པ་ཡིས",
    "ལྗོན་ཤིང་ཙམ་པ་ཀ་ཡི་བསིལ་གྲིབ་བཞུགས",
    "སྲིན་པོའི་རྒྱལ་པོ་ཐོད་འཕྲེང་རྩལ་དུ་བཞུགས",
    "སྲིན་པོ་ཐམས་ཅད་འདུད་ཅིང་གུས་པར་མཐོང་",
    "བོད་ཡུལ་ལུང་པ་སྟོང་པར་བཏང་",
    "སྣོད་ལྡན་རྣམས་ལ་གདམས་ངག་རྫོགས་པར་གནང་",
    "བོད་དུ་བྱོན་ནས་གཏན་དུ་མི་བཞུགས་པར་ཡེ་ཤེས་རྟ་མཆོག་ཆིབས་ཁ་ཅང་བདེན་ནམ",
    "བོད་ཡུལ་སྟོང་པར་བཞག་པ་ཅང་བདེན་ནམ",
    "སྒྲུབ་པའི་རྒྱལ་མཚན་བོད་དུ་མི་ཚུགས་པར",
    "དབེན་གནས་སྟོང་པར་འཇོག་པའི་དུས་ཀྱང་བྱུང་",
    "ཉིན་མཚན་མེད་པར་གདུང་བའི་སྒྲ་ཡིས་འབོད",
    "གུང་ཐང་ལ་ཀར་ཐམས་ཅད་རོ་བཞིན་འགྱེལ་རྒྱུན་ཆད་མེད་པར་མཆི་མ་ཁྲག་ཏུ་འཛག་རྐང་པས་གར་ཕྱིན་དོན་མེད་ས་ལ་འགྱེལ",
    "བསྡད་པས་མ་ཚུགས་ཕྱིན་ནས་དོན་མ་མཆིས",
    "སྨྲེ་༢༣་བ་སྔགས་གདུང་བས་ཕྱོགས་བཅུར་བོས་ལགས་ཀྱང་",
    "གཞོན་ནུའི་དུས་ནས་སློབ་དཔོན་གཟུངས་མ་བྱས",
    "རྒས་པའི་དུས་བྱུང་ཤི་ཡང་འགྱོད་མེད་བྱས",
    "སྐྱེས་ནས་གཞན་དོན་དཔག་མེད་འགྲུབ་པར་ཤོག",
    "སྐལ་ལྡན་ལས་འཕྲོ་ཅན་དང་འཕྲད་པར་ཤོག",
    "ཁྱད་པར་དུ་གཏེར་སྟོན་གྱི་ཕྱག་བྲིས་ལས་བཤུས་ཟེར་བ་ཞིག་དང་།",
    "ཨ་ཧོ་ཞབས་སེན་དམར་བའི་རྡུལ་དེ་རྣམ་མཁྱེན་ཐོབ་པར་གཙུག་འབབ་མཛོད།",
    "ཁྱད་པར་རྒྱ་བལ་པཎ་གྲུབ་དངཚུལ་གྱིས།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ལས་གཞན་དམིགས་སུ་མེད།",
    "རྨོངས་ཞེན་ཕ་ཕོར་གཙང་བ་མ་ཡིན་པའི།"
  ]
