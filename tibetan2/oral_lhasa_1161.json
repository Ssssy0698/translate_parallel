    "གཟུགས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་གཟུགས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྒྲ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྒྲ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲི་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཞི་བ་དྲི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རོ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "གཟུགས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་གཟུགས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྒྲ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་སྒྲ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲི་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དྲི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རོ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་རོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།་",
    "སྟོང་པ་ཉིད་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།་",
    "སྟོང་པ་ཉིད་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྣའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ལྕེའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།་",
