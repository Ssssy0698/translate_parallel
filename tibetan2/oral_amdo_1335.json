    "འབྲལ་མེད་རྣལ་འབྱོར་བློ་རེ་བདེ།",
    "ལྡང་བའི་དུས་སུ་བསྔོ་བ་རེ་མཛད།",
    "མོས་གུས་བྱས་ཤིང་།",
    "རང་གི་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་དོན་གྱི་རྒྱུ་དང་དབྱེ་བ་མེད་པར།",
    "གང་གིས་ཀྱང་གོས་པ་མེད་པས།",
    "ཤེས་པ་གཟེངས་བསྟོད་དེ་མོས་གུས་ཐོད་རྒལ་སྟོང་ཉམས་བྱུང་རྒྱལ་དུ་སྐྱང་ངོ།",
    "བློ་རྩལ་མེད་ཀྱི་ངང་ལ་མོས་གུས་དྲན་རིག་ཏུ་ལྷང་ངེ་བྱའོ།",
    "དག་སྣང་ཕྱོགས་མེད་དུ་ཤར་བའི་མོས་གུས་ནི།",
    "ཚུར་ལ་གང་གིས་ཀྱང་ཟིལ་གྱིས་མི་ནོན་པར་འགྱུར་ལ།",
    "མོས་གུས་ཀྱི་ལྟ་སྒོམ་སྤྱོད་གསུམ་ནི།",
    "མོས་གུས་ཀྱི་རིག་པ་མཐའ་དབུས་མེད་པར་སྒྲོ་འདོགས་ཆོད་པ་ལྟ་བ།",
    "དེ་ཉིད་ཉམས་སུ་མྱོང་ཞིང་ཐམས་ཅད་མོས་གུས་སྐྱེ་བ་དང་།",
    "དོན་རྟགས་སུ་འཁོར་འདས་ཐམས་ཅད་མོས་གུས་ཀྱི་ངང་དུ་རོ་གཅིག་པ་དང་།",
