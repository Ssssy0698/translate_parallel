    "བེ་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "སྐབས་འདིར་བི་རོ་ཙ་ན་ཞེས་པ་གཏན་ནས་བཀོད་མེད་པས་ཀྱང་གསལ་སྟོན་བྱས་ཡོད།",
    "སྔགས་ལྟར་བི་རོ་ཙ་ན་ཞེས་གསོལ།",
    "སྔགས་བསྒྱུར་ནང་དུ་བེ་རོ་ཙ་ན་བྲིས།",
    "དེ་ཕྱོགས་ཀྱི་བླ་གྲས་བེ་རོ་ཙ་ན་ཚ་བ་རོང་དུ་ཕེབས་པར་ཐོས་ནས་ངོས་བཟུང་བ་དང་འབྲེལ་བ་ཡོད་མི་སྲིད་པ་ག་ལ་ཡིན་ལ།",
    "སྦ་བཞེད་དུ་རྒྱའི་སྙན་ཕྲས་བེ་རོ་ཙ་ན་ཚ་བ་རོང་དུ་སྤྲུགས།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་མཛད་པ།",
    "ཨ་ཙརྱ་བི་རོ་ཙ་ན་སང་ཤི་ཏས་མཛད་པའི་སྣང་བ་མཐའ་ཡས་པའི་མཚན་༣བརྗོད་པ།",
    "དུམ་བུ་གཉིས་ལས་མ་བཞུགས་འདུག་ལ།",
    "བི་རོ་ཙ་ན་ནི་བོད་དུ་རྫོགས་ཆེན་རིང་ལུགས་འདྲེན་པ་པོ་དེ་ཉིད་ཡིན་པས།",
    "བདག་ཉིད་བེ་རོ་ཙ་ནའི་བཞེད་ཆེན་པོར་ལྟ་བ་དང་།",
    "གཞན་དཀྱུས་སུ་བེ་རོ་ཙ་ནའི་མཚན་གཏན་ནས་བཀོད་མི་འདུག་ལ།",
    "ཀུན་ཏུ་བཟང་པོའི་ཆེ་བ་རང་ལ་གནས་པའི་རྒྱུད་ཙམ་ལས་བཀོད་མི་འདུག་ལ།",
    "བེ་རོའི་རྒྱུད་འབུམ་ཞེས་པའི་རྫོགས་ཆེན་གྱི་དཔེ་ཚོགས་ཀྱང་བི་རོ་ཙ་ན་རྫོགས་ཆེན་གྱི་རྣམ་འདྲེན་གྱི་གཟུགས་སུ་བཀོད་ཟིན་པའི་རྗེས་སུ་རིམ་པས་ཕྱོགས་བསྒྲིགས་ཀྱིས་བེ་རོར་ཞལ་གཡར་བྱས་པ་ཞིག་ཡིན་པར་མངོན་ཡོད།",
    "འོ་ན་བེ་རོ་ཙ་ནས་བོད་དུ་རྫོགས་ཆེན་སྤེལ་བ་ལ་བརྟེན་ནས་རྒྱལ་རོང་དུ་སྤྲུགས་པ་མ་ཡིན་ནམ་ཟེར་ན།",
    "དོན་འདིར་སྔར་ནས་དཔྱད་པ་བྱས་པ་ཡང་འདུག་སྟེ།",
    "༦ཞེས་གསུངས་འདུག་པས།",
    "༧ཞེས་དགག་འདུག་ཅིང་།",
    "དོན་ལ་མི་མཐུན་པ་ཙམ་མི་འདུག་སྟེ།",
    "རྩེ་མིན་པ་རིམ་གྱིས་པའི་སྐབས་ཏེ་བཅུ་གཉིས་པ་ལས་རྒྱ་ནག་བསམ་གཏན་བརྒྱུད་རིམ་རྣམས་བཀོད་འདུག་ལ།",
    "༤ ཞེས་བཀོད་འདུག་ལ།",
    "འདི་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དགོངས་པ་ལྟར་ཡིན་འདུག་ལ།",
    "༤༡ཞེས་བཀོད་འདུག་ལ།",
    "༤༢ ཞེས་འཁོད་འདུག་ལ།",
    "བོད་ཀྱི་མཁས་ཆེན་དང་མཁས་རྒན་གྱི་ཁྲིར་འགྱིང་བ་འགའ་དང་འགས་ཀྱང་དཔྱད་གཞིགས་གང་ཡང་མ་བྱས་པར་ད་དུང་ཤོད་སྲོལ་རྙིང་པ་དེ་སྤྱོད་ཀྱིན་འདུག་ལ།",
    "༤ཞེས་བཀོད་འདུག་དེ་དང་སྦ་བཞེད་དུ་བཀོད་པ་གཉིས་བསྡུར་ནཚིག་ཟུར་ཙམ་ལས་བརྒྱ་ཆ་གོ་དགུ་གཅིག་གྱུར་དུ་འདུག་སྐབས་འདིར་སྦ་བཞེད་ནི་བརྩམས་པ་སྔ་བའི་ཆ་ནས་ལྷད་བཏབ་པ་དེ་ས་པན་ལས་ཅུང་སྔ་བ་ཆ་འཇོག་བྱས་ཡོད་ཀྱང་།",
    "༦ཞེས་བཀོད་འདུག་པ་ལ་བརྟགས་ན།",
    "ཕྱིས་སེམས་ངོ་མཐོང་བས་འཚང་རྒྱ་ཟེར་བ་འདི་རྣམས་ཁོའི་ལུགས་སུ་འདུག་ཅེས་གསུང་ངོ་ཞེས་ལྷད་བཅུག་པ་འགའ་ཟུང་སྣང་ཞིང་།",
    "༧ཞེས་བཀོད་འདུག་པས།",
    "དབའ་བཞེད་ཀྱི་ངོས་༣༦ནས་༤༦བར་དུ་སྟོན་རྩེན་གཉིས་རྩོད་པའི་སྐོར་ཞིབ་ཕྲ་༨འཁོད་འདུག་ཀྱང་།",
    "དེའི་ནང་དུ་སྦ་བཞེད་དུ་འཁོད་པ་དེ་འདྲ་ཟུར་ཙམ་ཡང་བཀོད་མི་འདུག་པས།",
    "༩ཅེས་འཁོད་འདུག་པ་འདི་ཡིན་ལ།",
    "རྡོ་རིང་དུ་མ་བུ་ཡང་ཆ་མ་ཚང་བས་ཐད་ཀར་དེ་ཡིན་འདི་མིན་གྱི་ཁ་ཚོན་གཅོད་ཐབ་བྲལ་འདུག་དེར་བརྟེན་ཞིབ་འཇུག་ཐད་ལ་དཀའ་ངལ་འཕར་མ་ཞིག་འཕྲད་འདུག།",
    "བསྔོགས་ཤུལ་ལྟ་བུ་མཐོང་རྒྱུ་གཏན་ནས་མི་འདུག་ལ།",
    "ལྡོང་རུས་ཆེན་བཅོ་བརྒྱད་ཟེར་ཙ་ན།",
    "༡༦ཞེས་གསལ་པོར་བཀོད་འདུག་པས།",
    "མྱང་མང་པོ་རྗེ་ཞང་སྣང་ནི་མྱང་རིགས་ལས་བཙན་པོ་གནམ་རི་ཡབ་སྲས་ཀྱི་བློན་ཆེན་བྱས་རྗེས་ཆེ་ཤོས་ཞིག་ཡིན་འདུག་སྟེ།",
    "སྤྱི་ལོ་༡༩༩༣ལོར་ཁོང་ཉིད་སྐུ་ངོ་མ་གནས་འདིར་ཕེབས་ནས་ཞིབ་འཇུག་གནང་ཚུལ་ཤོག་ངོས་༡༡༩་ལས་༣ས་ལེར་གསུངས་འདུག་པས།",
    "བཛྲ་གུ་རུ་སོགས་མང་པོ་ཞིག་བརྐོས་འདུག་པ་ལས་མི་གསལ།",
    "འཐོར་ཆེ་བས་ཞིབ་ཆ་ཀློག་ཐུབ་ཀྱི་མི་འདུག་ལ།",
    "བྲག་ངོས་ཁ་ཤར་བསྟན་འདི་ལ་ཉི་གཡབ་ལྟ་བུའི་ཉི་ལྷག་ཆར་པ་འགོག་པའི་ཐབས་ཤེས་གང་ཡང་བཏང་མི་འདུག་པས།",
    "ཡི་གེ་རྣམས་ཉི་ལྷག་ཆར་པས་དག་ནས་གསལ་ལ་མི་གསལ་བ་ཧ་ཅང་མང་པོ་ཆགས་ཟིན་འདུག་དེ་བཞིན་གོང་གསལ་རྒྱ་གར་གྱི་གནའ་ཡིག་དང་གཤམ་དུ་བོད་ཡིག་རྙིང་མ་ཡོད་སའི་ངོས་སུ་བྲག་བརྐོས་ཐོག་ཏུ་མ་ཎི་འབུར་བརྐོས་སོགས་དུས་ཕྱིས་བྱས་པ་དང་།",
    "ཉེ་དུས་མ་ཎིསོགས་གང་བྱུང་བརྐོས་ནས་རྙིང་བ་ཡོད་པ་ཤེས་ཙམ་ལས་ལྷག་མི་འདུག་ལ།",
    "ལྷན་དཀར་ཞེས་བྲིས་འདུག་༡ཅེས་གསུངས་པ་ལས་ཤེས་ཐུབ།",
    "དེ་ནི་ཆེས་སྔ་དུས་ནས་ཀྱང་ནོར་ནས་རྫོགས་ཞེས་བཀོད་འདུག་དོན་དུ་གཉའ་ཁྲིའི་བློན་པོ་ལྷོ་དང་སྙགས་གཉིས་ལས་སྙགས་ཀྱི་དོན་ཡིན་ཀྱང་བྲིས་ནོར་བྱུང་ཡོད་པས།",
    "༤ཞེས་གསལ་པོར་བཀོད་འདུག་ལ།",
    "༥ཞེས་བཀོད་འདུག་གཞན་ཡང་ཡིག་རྙིང་དབའ་བཞེད་ལས།",
    "༦ཞེས་འཁོད་འདུག་པས་ཤེས་ལ།",
    "༧ཞེས་འཁོད་འདུག་པས་དང་།",
    "༨ཞེས་གསལ་པོར་བཀོད་འདུག་པ་ལ།",
    "༩ཞེས་ལྡན་ཀར་དུ་བཅོས་གནང་འདུག་པས།",
    "དེ་ནས་ལྷ་ལུང་དཔལ་རྡོར་གྱིས་ལུང་བསྟན་བཞིན་བཙན་པོ་བཀྲོངས་ཚུལ་བཀོད་འདུག་ལ།",
    "གཞན་དུ་མཐོང་རྒྱུ་རྩ་བ་ནས་མི་འདུག་པས་འཛེམས་ཆ་ཆེན་པོ་བྱེད་པར་མངོན་ལ།",
    "དེའི་ཐོག་གཅིན་པ་གཏོང་བར་བྱེད་སྲོལ་ཡོད་འདུག་པས་མཚོན།",
    "ལྷ་ལུང་དཔལ་རྡོར་གྱིས་དཀྲོངས་པའང་འོས་ཤིང་རིགས་པ་ཆགས་འདུག་གལ་ཏེ་ལྷ་ལུང་དཔལ་རྡོར་གྱིས་དར་མ་འུ་དུམ་བརྟན་མ་བཀྲོངས་ན།",
    "༡༡ཞེས་འཁོད་འདུག་པས།",
    "ལོ་གྲངས་ཇི་ཙམ་ནུབ་པ་ལ་འང་བཞེད་པ་མི་མཐུན་པ་ཅི་རིགས་ཤིག་བྱུང་འདུག་དཔེར་ན།",
    "དེ་ནི་ལྷ་ལུང་དཔལ་རྡོར་གྱིས་བཙན་པོ་དཀྲོངས་པ་དེ་ཉིད་རབ་བྱུང་པས་བསྟན་པའི་ཆེད་དུ་བྱ་བཟང་ཞིག་ཏུ་སྒྲུབ་པའི་ཆེད་དུ་འང་ཡིན་འདུག་སྟེ།",
    "ཧོར་གྱི་ཡུལ་དུ་ཕྱིན་ཙ་ན།",
    "༥ཞེས་བཀོད་འདུག་དེ་ལས་ཤེས་ཐུབ་པ་ནི།",
    "༧ཞེས་སོགས་བཀོད་འདུག་པ་ལས།",
    "བླ་ཆེན་ཡང་ཁྲི་རལ་པའི་དུས་སུ་བྱུང་བར་འདོད་པའང་ཡོད་འདུག་སྟེ།",
    "༨ཞེས་སོགས་བཀོད་འདུག་པས།",
    "སྡོམ་རྒྱུན་དུ་ཡོད་པ་ནི་དཔལ་དབྱངས་ཡིན་འདུག་ལ།",
    "དེས་ཀླུ་མེས་༡༣ཞེས་བཀོད་འདུག་ཚལ་པ་དེབ་ཐེར་དམར་པོ་ངོས་༥༥ལས།",
    "༡༥ཞེས་འཁོད་འདུག་པ་ལ་གཞིགས་ན།",
    "དེས་ཀླུ་མེས་བཞེད་པར་གདའ།",
    "༡༩ཞེས་གསལ་བར་འཁོད་འདུག་པས་ཤེས་ལ།",
    "༢༡ཞེས་བཀོད་འདུག་པ་ནི་བུ་སྟོན་དང་དེབ་སྔོན་སོགས་ཀྱི་བཞེད་པ་དང་ཡོངས་སུ་ཐ་དད་པ་སྟེ།",
    "དེ་ལ་ལོ་ཚིགས་སྒྲིག་དུས་མི་འགྲིག་པའི་སྐྱོན་ཆ་ཆེན་པོ་གནས་ཡོད་པས།",
    "༢༤ཞེས་དོགས་པ་བཀོད་འདུག་པས་མཚོན་ལ།",
    "༢༦ཞེས་བཀོད་འདུག་པས།",
    "༢༧ཞེས་བཀོད་འདུག་པ་ལས།",
    "དེ་ཡང་ག་དུས་བརྩམས་ན་ཡིན་སྙམ་ན།",
    "༣ཞེས་ཆེ་བའི་གྲས་སུ་ཡང་བཀོད་འདུག་པས་མཚོན།",
    "༣ ༡ཞེས་བཀོད་ནས་དོགས་སེལ་གྱི་རིགས་ལམ་ཀྱང་དྲངས་པར་མཛད་འདུག་དོན་དངོས་ཐོག་བསམས་གཞིགས་བྱས་ན།",
    "༦ཞེས་འཁོད་འདུག་པས་ཀྱང་ཤེས་ཐུབ།",
    "དེའི་གཉིལ་གྱི་སྟེང་ན་མུ་ཏིག་ལྡན་ཡོན་ངོས་ཅིག་དམར་བ་ཅིག་གདའ་བ་ཀུན་གྱིས་མཐོང་།",
    "༡ཞེས་འཁོད་འདུག་པས།",
    "༡༡ཞེས་བཀོད་འདུག་པས་ཤེས་ཐུབ།",
    "༡༣ཞེས་འཁོད་འདུག་པ་དང་།",
    "བསམ་ཡས་ཀྱི་རྟེན་བཞེངས་ཀྱི་བཟོ་བོའང་རྒྱ་ནག་པ་ཡིན་འདུག་སྟེ།",
    "ཕྱིར་བསྐྱལ་བར་བརྩམས་པ་སོགས་ཀྱི་གནས་ཚུལ་རྩ་བ་ནས་ཐོན་མི་འདུག་འོ་ན་དེ་དུས་བོད་དུ་ནང་པའི་རྟེན་ཇོ་བོ་ཤཱཀྱ་མུ་ནེ་གཅིག་པུ་ཡིན་ནམ་ཞེ་ན།",
    "སྔོན་དུས་བོད་ཀྱི་བཙན་པོའི་དུས་རབས་ནི་ཀླ་ཀློའི་དུས་རབས་ཤིག་ཡིན་འདུག་ལ།",
    "༤ཞེས་འཁོད་འདུག་ལ།",
    "སྲོག་ཆགས་མཆོད་སྦྱིན་གྱི་བྱ་བ་འབོར་ཆེན་ཡོད་པ་མངོན་འདུག་དབའ་བཞེད་ངོས་༥༥ལས།",
    "༧ཞེས་འཁོད་འདུག་པ་དང་།",
    "༩ཞེས་འཁོད་འདུག་པ་དང་།",
    "༡ ཞེས་བཀོད་འདུག་པས་ཕྱོགས་ཙམ་ངེས་པ་རྙེད་ཐུབ།",
    "༡༢ཞེས་འཁོད་འདུག་པས་དེ་དག་ལ་བརྟགས་ན།",
    "མི་ཤི་དུས་སོག་ལུགས་དེ་བྱ་སྲོལ་ཡོད་པ་ཡིག་ཚགས་སུ་༡༣འཁོད་འདུག་པ་དང་།",
    "མང་དུས་སྟོང་ཕྲག་ལོན་གྱི་ཡོད་འདུག་ལ།",
    "༡༥ཞེས་གསལ་པོར་བཀོད་འདུག་པས།",
    "༡༦ཅེས་བཀོད་འདུག་པ་ལས་ཀྱང་།",
    "མཁར་གྱི་ཐོག་མ་འཕྱིང་བ་སྟག་རྩེ་ཞེས་བརྗོད་ན་མི་འགྲིག་རྒྱུ་གཏན་ནས་མི་འདུག་ཕྱིས་སུ་གྲོང་ལ་སྔ་བ་ཕྱིང་བ་སྟག་རྩེ་ཞེས་གྲགས་ནའང་།",
    "༡༨ཞེས་གསལ་བར་འཁོད་འདུག་པར་གཞིགས་ན།",
    "དེ་གཉིས་མི་སྣ་གཅིག་ཡིན་པའི་གཏན་ཚིགས་གང་ཡང་རྙེད་ཐབས་མི་འདུག་ལ།",
    "དེང་དུས་གསར་དུ་རྟོགས་པའི་སར་རྐྱང་ཞིག་མ་ཡིན་པར་སྔོན་དུས་ནས་དོ་སྣང་བྱུང་མྱོང་བ་ཞིག་ཡིན་འདུག་སྟེ།",
    "༡ཞེས་བཀོད་འདུག་པ་དེ་ལས།",
    "ཕྱག་ན་ལྷམ་ཡ་གཅིག་ཀྱང་ཐོགས་ནས་འདུག་གོ།",
    "ལྷམ་ཡ་གཅིག་ལས་མི་འདུག་སྟེ།",
    "དེ་ནི་ཕྱིས་སུ་བཏགས་པ་ཞིག་ཡིན་པ་ལས་གཞུང་རང་ལ་བརྟགས་ན།",
    "བསམ་གཏན་མིག་སྒྲོན་ཞེས་གཏན་ནས་བཀོད་མི་འདུག་སྟེ།",
    "༢༢ཞེས་བཀོད་འདུག་ལ།",
    "༢༣ཞེས་གསལ་འདུག་པས།",
    "འདིའི་ནང་དུ་རྒྱུད་ཀྱི་ལུང་མང་པོ་ཞིག་དྲངས་འདུག་ཀྱང་།",
    "བརྗོད་བྱའི་དོན་ལ་འགྱུར་བ་ཕྱིན་འདུག་པས།",
    "དེ་ལ་ཕྱིས་སུ་སྣོན་འཁྲི་གང་ལ་གང་འཚམས་ཤིག་མ་བྱུང་བའི་ངེས་པ་མི་འདུག་ལ།",
    "མཆན་བུ་རྣམས་ལ་བརྟགས་ནའང་རྩོམ་པ་པོའི་རང་མཚན་མ་ཡིན་པར་དུས་ཕྱིས་སུ་བཀོད་པ་ཞིག་ཡིན་འདུག་སྙམ་སྟེ།",
    "༢༧ཅེས་གཤིབ་བསྡུར་གྱིས་བཀོད་འདུག་པས་རགས་ཙམ་ཤེས་ཐུབ་ལ་ད་དུང་བསམ་གཏན་གླིང་པའི་ཨ་ཏིའི་སྐོར་ལ་ཉམས་ཞིབ་དང་།",
    "དེ་ཡང་སྔགས་ཀྱི་སློབ་དཔོན་ཆེན་པོ་ཞིག་ཡིན་པ་ནི་གསལ་པོར་ངེས་པ་རྙེད་ཐུབ་པ་ཡིན་འདུག་སྙམ།",
    "ནམ་ལངས་རང་གནས་སླེབས་ཙ་ན།",
    "འོ་སྐོལ་བོད་འདིར་བསྟན་པའི་འཕེལ་འགྲིབ་ཤིན་ཏུ་མང་བར་བྱུང་གདའ།",
    "༥ཞེས་གསལ་པར་འཁོད་འདུག་པ་དང་།",
    "བསྟན་པ་ལ་གནོད་པ་ཆེན་པོ་བྱུང་འདུག་པས།",
    "༦ཞེས་འཁོད་འདུག་པས།",
    "༧ཞེས་གསལ་བ་བཞིན་དུ་སྦྱོར་སྒྲོལ་གཉིས་ལས་སྦྱོར་བ་གཙོ་བོར་སྤེལ་བ་ཡིན་འདུག་སྙམ།",
    "རྒྱུའི་རྡོ་རྗེ་འཆང་ལས་འབྲས་བུའི་རྡོ་རྗེ་འཆང་དུ་བསྒྱུར་བའི་གཞུང་འདུག་ན་དེ་གསར་མ་ཡིན་ག་ཏིང་ངེ་འཛིན་གསུམ་སྔོན་དུ་བཀོད་ནས་འབྲས་བུའི་རྡོ་རྗེ་འཆང་དེ་ཕལ་ཆེར་ཡོངས་རྫོགས་སུ་གྲུབ་པའི་གཞུང་དེ་ནི་རྙིང་མ་ཟེར་ཏེ།",
    "དེ་ལ་ལུང་མི་གདའ་འོ།",
    "བདུན་རྣམ་དག་བཀོད་ནས་རྒྱུའི་རྡོ་རྗེ་འཆང་ལས་འབྲས་བུའི་རྡོ་རྗེ་འཆང་དུ་བསྒྱུར་བའི་གཞུང་འདུག་ན་དེ་གསར་མ་ཡིན་ལ།",
    "ཆུང་བ་མི་ཉུང་ཙམ་ཡོད་འདུག་ཁམས་སུ་རྫོགས་ཆེན་དགོན་དང་།",
    "༡༧ཞེས་བཀོད་འདུག་པས།",
    "༡༩ཞེས་བཀོད་འདུག་པ་དང་།",
    "དེ་འདྲའི་སྒོ་ནས་བརྟག་དུས་བོད་དུ་དར་བའི་རྙིང་རྒྱུད་ཀྱི་བརྗོད་བྱ་འགའ་ཞིག་ནི་པར་མ་དང་མཚུངས་ལ།",
    "འགའ་ཞིག་ནི་གསར་མའི་རྒྱུད་རྗེས་མ་ལས་ཀྱང་ཕྱི་བའི་ཉམས་མངོན་རྒྱུ་འདུག་དཔེར་ན་གསར་མའི་ནང་དུ་དུས་གསུམ་གྱི་རྣམ་གཞག་ཡོད་ཅིང་།",
    "༢༤ཞེས་བཀོད་འདུག་པ་ལ་བསམས་ན།",
    "སྤྱིར་ན་རྒྱ་གར་དུ་ལོ་གཅིག་དུས་བཞི་ནི་སྐར་མའི་སྒོ་ནས་བརྩི་བ་དང་།",
    "གངས་ཅན་ཁྲོད་འདིར་དེ་སྐད་ཟེར་བ་ཤིན་ཏུ་མང་བར་གདའ་ནའང་།",
    "འདིར་རང་བཞིན་གྱི་རྣལ་འབྱོར་མའི་རིས་སུ་གདའ་གསུང་།",
    "དོན་དངོས་ཐོག་རྒྱ་གར་གྱི་ཡིག་ཐོག་ཏུ་བཀོད་ནས་མིའི་མིག་ལམ་དུ་ཕབ་མཁན་ནི་གྲུབ་ཆེན་ཁོང་རང་ཡིན་པས།",
    "བོད་མིའི་དད་པ་བརྟན་ཞིང་རང་རྐྱ་འཕེར་བ་དང་།",
    "༨ཅེས་གསུངས་འདུག་པས།",
    "༡ཞེས་གསལ་པོར་བཀོད་འདུག་ལ།",
    "༣ཞེས་བཀོད་འདུག་ལ།",
    "སྤྱི་ལོ་༡ ༡༩ ས་ལུག་ལོར་དགུང་ལོ་བདུན་ཅུ་དོན་གཉིས་ལ་འདས་སྐོར་ཁ་གསལ་པོར་བཀོད་འདུག་པས་ཤེས་ཐུབ།",
    "༩ཞེས་གསལ་བས་མཐོ་གླིང་རང་དུ་བརྩམས་པ་ཞིག་ཡིན་པས་ཡིད་རྟོན་འོས་པར་མཐོང་།",
    "བྱང་སྒྲ་མི་སྙན་གླིང་བཅས་གླིང་བཞི་ཀའི་ས་མིང་ཕྱོགས་མ་ནོར་བར་དངོས་སུ་ཡོད་ཚུལ་གསལ་པོར་གསུང་འདུག་པས།",
    "ད་ལྟ་ཡུལ་ལང་ཀ་པུ་ར་ན་འདུག་༦ཅེས་དང་།",
    "ལྷོ་ནུབ་མཚམས་ལ་ཆུ་དང་མི་སོགས་འགྲོ་བའི་ལམ་འདུག་སྟེ།",
    "སྤྲེལ་གྱི་སྒྲུང་ལས་བོད་རིགས་སྤྲེལ་ཡིན་པའི་གཏམ་རྒྱུད་བྱུང་ཚུལ་ཀྱང་གསལ་པོར་བསྟན་འདུག།",
    "༥ཞེས་བཀོད་འདུག་པ་ལས་ཀྱང་ཆུ་བོ་གང་གཱའི་གཏམ་རྒྱུད་ཀྱི་བག་ཆགས་ཤེས་ཐུབ་ལ།",
    "༡༣ཞེས་བཀོད་འདུག་པར་གཞིགས་ན།",
    "༡༤ཞེས་བཀོད་འདུག་པ་དང་།",
    "༡༥ཞེས་བཀོད་འདུག་པ་དང་།",
    "༡༦ཞེས་བཀོད་འདུག་པ་དང་།",
    "༡༧ཅེས་བཀོད་འདུག་པས་ཀྱང་།",
    "སློབ་དཔོན་དང་རྒྱལ་པོ་ཁྲི་སྲོང་རང་ཡང་པེ་ཧར་སྤྱན་འདྲེན་དུ་ཡོད་པར་གསུངས་ཏེ།",
    "༢ཞེས་བཀོད་འདུག་ལ།",
    "༤ཞེས་བཀོད་འདུག་པར་བསམས་ན།",
    "བོད་དུ་བཙན་པོ་རིམ་བྱོན་གྱིས་བཏབ་པའི་གཙུག་ལག་ཁང་ལ་དཔེ་ཧར་ཞེས་ལེགས་སྦྱར་གྱི་སྒྲ་སོར་གཞག་ཏུ་བོས་ཀྱི་ཡོད་འདུག་པ་ནི།",
    "༩ ཞེས་འཁོད་འདུག་པས།",
