    "དེ་ནས་ཐུན་མཚམས་ཀྱི་ལྷར་ལྡངས་ནས་གནས་གསུམ་སྲུང་བ་སོགས་བྱ་བ་ནི་མཁྱེན་བཞིན་ལགས། ། འདི་གར་དགུ་ཆེན་སྐབས་མགོན་པོའི་གཏོར་ཆེན་ཞལ་གཏོར་ཡིན་ན་དེ་དགྲ་ཕྱོགས་སུ་ཞལ་བསྒྱུར་བའམ་གཙང་སར་གཤེགས་པ་མ་གཏོགས་གཏོར་ཟོར་དུ་འཕེན་མི་རུང་ཞེས་རྗེ་དོན་ལྡན་ཞབས་སོགས་གོང་མ་རྣམས་ནས་ནན་ཏན་གྱིས་གསུངས་འདུག་ཀྱང་།",
    "དཀྱིལ་འཁོར་རྡུལ་ཚོན་ཡིན་ཀྱང་ས་ཆོག་ཆགས་མེད་ལུགས་ཀུན་རིག་ལྟར་བྱ་འདུག་པས་དེ་ག་རུང་ངམ།",
    "མགོན་པོའི་དཀྱིལ་འཁོར་རྡུལ་ཚོན་ལས་བཞེངས་རྒྱུ་འདི་སྐོར་ལ་ནི་སྲོལ་མི་འདུག།",
    "ལག་ནས་བྲིས་བཞིན་སྤེལ་བཞིན་གཞན་སྐད་དུ་བསྒྱུར་བཞིན་འདུག་ཁོ་ཚོའི་ལྟ་ཚུལ་ལ་ཆོལ་ཁ་གསུམ་ཞེས་པའི་ཐ་སྙད་དེའི་ཁྱབ་ཁོངས་ནང་དུ་བོད་ས་ཡོངས་རྫོགས་འདུས་པའི་ངོས་འཛིན་བྱེད་པ་མ་ཟད།",
    "ཕྱི་དར་གྱི་དུས་མགོར་ཐ་སྙད་འདི་གཏན་ནས་ཐོན་མི་འདུག་ག་དུས་གཞི་ནས་བོད་ཀྱི་ཐ་སྙད་ནང་དུ་ཐོན་པ་ཡིན་ནམ་ཞེ་ན།",
    "ཕྱོགས་ཁ་ཞེས་བོད་སྐད་ཡིན་བཞག་བྱས་འདུག་ཕྱོགས་ཁ་དང་ཕྱོགས་ཁག་ཏུ་འགྱུར་བའི་དབྱེ་མཚམས་ལ་གོ་བ་བླང་ན།",
    "༩ཞེས་བཀོད་འདུག་དེ་ནི་སྐབས་དེའི་དགོས་མཁོ་དང་བསྟུན་པ་ཞིག་ཡིན་ངེས།",
    "༣༥ཞེས་གསལ་པོར་འཁོད་འདུག་ལ།",
    "༤༤ཞེས་པའི་རྒྱལ་ཕྲན་དེ་ཡིན་པར་བཞེད་མཁན་འདུག་པས།",
    "ཆོལ་ཁ་ལྟ་བུ་གཞན་སྐད་དང་གཞན་གྱིས་བཏགས་པ་ཞིག་མ་ཡིན་པར་རང་སྐད་དང་རང་མེས་ཀྱིས་བཏགས་པའི་ཁུངས་བཙུན་མེས་པོའི་ཞལ་རླངས་མ་ཡལ་བ་ཞིག་ཡིན་པར་བརྩི་ཆོག་སྙམ།",
    "དེ་བདེན་པ་ཡིན་ན་དབུས་གཙང་ཙམ་ལས་གཞན་རྣམས་བོད་ས་མིན་པ་ཞིག་ཆགས་འགྲོ་འདུག་བོད་ཁམས་གླིང་དགུ་འདིའི་ཁྱབ་ཁོངས་ལ་ངོས་འཛིན་ཡག་པོ་ཞིག་བྱུང་ན།",
    "༥༥ཞེས་རགས་རྩིས་བྱས་པ་ཞིག་འཁོད་འདུག་དེའི་ཁུངས་ཡར་དེད་ན་བཀའ་ཆེམས་ཀ་འཁོལ་མ་དང་མ་ནི་བཀའ་འབུམ།",
    "༥༧ཞེས་གསལ་པོར་འཁོད་འདུག་ལ།",
    "བོད་ཆེན་པོའི་ལོའི་མྱིང་སྐྱིད་རྟག་༢ཅེས་གསལ་ལེར་བཀོད་འདུག་ལ།",
    "མངའ་རིས་ནི་ཆེ་ཆུང་གང་ལ་ཡང་མི་ཐེ་བ་ཞིག་ཆགས་འདུག་ལ།",
    "ཤུགས་ཀྱིས་བོད་མིན་པ་ལྟ་བུ་ཞིག་ཀྱང་ཆགས་འགྲོ་འདུག་པས།",
    "བོད་དྲང་པོ་གསུམ་གསུངས་འདུག་པ་རིམ་བཞིན་སྟོད་མངའ་རིས་སྐོར་གསུམ་དང་།",
    "འདི་ནི་ལྷ་སྒྲུང་དང་རང་འདོད་མིན་པ་ནི།",
    "དེ་བཞིན་དཔའ་རིས་ནས་ཀན་ལྷོའི་བར་དེར་བོད་ས་མིན་པའི་ས་ཐིག་བྲིས་འདུག་ཀྱང་།",
    "བོད་ཀྱི་ཐ་སྙད་ཁྲོད་དུ་བོད་ལྗོངས་ཞེས་པ་འདི་ག་དུས་ཐོན་པ་དང་།",
    "༡༧ཞེས་གསལ་འདུག་ལ།",
    "༡ཞེས་འཁོད་འདུག་པས་མཚོན་ཐུབ།",
    "༢༤ཞེས་འཁོད་འདུག་པ་དང་།",
    "༢༥ཞེས་འཁོད་འདུག་པས་གཡེ་འམ་དབྱེ་ན་ཡོད་པར་ཤེས་ཐུབ་ལ།",
    "ཡེ་ངམ་ནི་སྣང་མུན་གྱི་དོན་དང་འཁོར་འདས་ཀྱི་དོན་སོགས་སུ་འགྲེལ་ཚུལ་ཡོད་འདུག་ནའང་།",
    "དམུ་རི་སྨུག་པོ་ནི་ཀོང་པོ་བོན་རིའམ་ལྷ་རི་གྱང་ཐོ་ཞེས་པ་འདི་ཉིད་ཡིན་འདུག་སྟེ།",
    "༣ ༡ཞེས་སོགས་བཀོད་འདུག་ལ་བསམ་ན།",
    "ཞང་ཞུང་རང་ནས་གདན་དྲངས་པར་བརྩིས་པས་ཡིན་ལ།",
    "༣༤ཞེས་བཀོད་འདུག་པ་ལས།",
    "སླར་ཡང་རང་ཡུལ་ལོག་པ་ས་ཡི་མིང་།",
    "༦ཅེས་གསལ་པོར་འཁོད་འདུག་པས།",
    "༡༡ཅེས་འཁོད་འདུག་ལ།",
    "༡༢ཞེས་གསལ་བར་འཁོད་འདུག་ལ།",
    "༡༤ཞེས་འཁོད་འདུག་པས།",
    "སྐབས་འདིར་ཕྲན་གྱིས་ཀྱང་རང་བློ་ཚད་འཛིན་དང་།",
    "འདུག་དུས་བརླ་མ་སྣོལ།",
    "༢ཞེས་བཀོད་འདུག་ལུས་སྨད་ནས་རྐང་པ་གཉིས་སུ་གྱེས་ཕྱིན་གྱི་ནང་ངོས་ཀྱི་མིང་དང་།",
    "གློག་ལ་ཀློག་གཅིག་ལ་ཆིག་ཇག་ལ་བྱག་དགྲ་ལ་གྲའ་སོགས་སྒྲ་གང་དོན་གཙོ་བོར་བྱས་པའི་སྣང་ཚུལ་ཞིག་ཆགས་འདུག་སྙམ།",
    "༤ཞེས་འགྲེལ་བ་བརྒྱབ་པ་འཁོད་འདུག་ལ།",
    "བརླའ་ནི་ཡིག་རྙིང་ཁྲོད་དུ་བླ་ཡི་འབྲི་སྲོལ་ཡིན་འདུག་དེ་ནི་ལྷོ་བྲག་དགའ་ཐང་འབུམ་པ་ནས་ཐོན་པའི་བོན་གྱི་གནའ་དཔེ་བདམས་བསྒྲིགས་ངོས་༦ལས།",
    "༦ཅེས་འཁོད་འདུག་པས།",
    "༡༢ ཞེས་འཁོད་འདུག་པ་དང་།",
    "ངེས་པར་དུ་བྱེད་པའི་བོན་ཆོག་ཅིག་འདུག་པ་ནི།",
    "གྲོངས་ནས་ལོ་གཉིས་ཙམ་གསང་རྒྱ་བྱས་ཚུལ་རྒྱལ་རབས་ཀ་པར་གསལ་བ་དེ་དང་འགྲིག་འདུག་པས།",
    "ད་ལྟ་ལྕགས་ཁྱི་ལ་བཞེད་པ་ནི་རྒྱའི་ཐང་ཡིག་ལ་གཞིར་བཞག་པ་ཡིན་འདུག་ཀྱང་།",
    "ཞེས་པ་བསྟན་འདུག་པ་འདི་དང་།",
    "ཕྱིས་ནར་སོན་རྗེས་གཞི་ནས་ངོ་ལོག་པ་དེ་དག་ཐུལ་བའི་དོན་དུ་འགྲེལ་བ་མཛད་འདུག་དོན་དངོས་ནི་སྐབས་དེར་སྲས་སྲོང་བཙན་སྐུ་གཞོན་པ་སྟེ།",
    "དུག་པ་རྣམས་རིམ་པས་ཚར་བཅད་པའི་དོན་བསྟན་འདུག་གལ་ཏེ་དེ་དུས་སྲོང་བཙན་ལོ་བཅུ་གསུམ་ལས་མ་ལོན་ན་ཏུན་ཧོང་ཡིག་ཚང་དུ་བལ་བཟའ་བསུས་པ་སོགས་ཀྱི་དོན་ཆེན་རྣམས་ཀྱི་སྐོར་འོག་ནས་འབྱུང་དགོས་པ་ལ་མེད་པའི་ཕྱིར།",
    "མགར་སྟོང་བཙན་གྱིས་སྤུང་སད་ཀྱི་གཡོ་བཤམས་པ་རྟོགས་པས་བཙན་པོ་ལ་སྐྱོན་མ་བྱུང་འདུག་ལ།",
    "༩ཞེས་བཀོད་འདུག་པ་འདི་ཡིན་ལ།",
    "༡༡ཞེས་སོགས་འཁོད་འདུག་པ་ལ་ལེགས་པར་གཞིགས་ན།",
    "བྲག་ལྷ་བགྱིས་༡༣ ཞེས་འཁོད་འདུག་པ་ལས་སྐབས་དེར་དུས་མཉམ་དུ་རྒྱ་བཟའ་བསུ་ཚུལ་བཀོད་མི་འདུག་པས།",
    "༡༤ཞེས་བཀོད་འདུག་ལ།",
    "དེ་ནི་བཙན་པོས་འ་ཞ་དང་མཚོ་སྔོན་རྒྱུད་ཀྱི་རྒྱུ་རྣམས་ལ་འཐབ་པའི་རྗེས་སུ་ཡིན་འདུག།",
    "ཡང་དེབ་དཀར་དུ་བྱམས་མ་ལས་སྲོང་བཙན་བོན་ལ་སྡང་བས་ལོ་སོ་དྲུག་ལས་མ་ཐུབ་ཞེས་འཁོད་པ་ལ་ཁུངས་མཛད་འདུག་པས།",
    "༡༦ཞེས་བཀོད་འདུག་པ་ལས།",
    "འདིར་གཅིག་ཏུ་སྒྲུབ་འདུག་པའི་ཕྱིར།",
    "སྐབས་དེར་བོད་ཧྲིལ་པོ་བོན་ལ་དད་པ་ལས་མ་གཡོས་པས་བོན་ལ་སྡང་པ་ཞེས་པའང་རྩ་བ་ནས་མ་བྱུང་བས་ཀྱང་ཁུངས་དང་མི་འབྲེལ་བ་གསལ་པོར་མཚོན་འདུག་སྙམ།",
    "དེ་ནི་ཕྱིས་སུ་འཇམ་དཔལ་རྩ་རྒྱུད་ཀྱི་ལུང་ལ་བརྟེན་པར་བཞེད་པའང་འདུག་སྟེ།",
    "༡༨ཞེས་བཀོད་འདུག་ལ།",
    "གནམ་རི་སྲོང་བཙན་གྱིས་ལོ་བརྒྱད་ཅུ་རྩ་༤ཐུབ་འདིའི་རིང་ལ་རྒྱ་ནག་ནས་རྩིས་བསྒྱུར་གསུང་༢ཞེས་མཆན་བུ་བཀོད་འདུག་པས་ཡབ་སྲས་ཀྱི་སྐུ་ཚེའི་ལོ་ཚིགས་འཛོལ་བ་འང་ཡིན་སྲིད་ལ།",
    "༢༢ཞེས་འཁོད་འདུག་ལ།",
    "ན་རི་དེ་ཉིད་རྒྱལ་ཕྲན་གྱི་རྒྱལ་པོར་བསྐོས་པ་ཡིན་འདུག་པས།",
    "༦ཅེས་བཀོད་འདུག་པས་ཀྱང་མཚོན་ཡོད།",
    "༧ཞེས་བཀོད་འདུག་པས།",
    "༩ ཞེས་བཀོད་འདུག་པས།",
    "ཆུ་མི་དབེན་གྱི་དཔོན་གཅིག་ཡོད་འདུག་པའི།",
    "མི་མིང་ཐོགས་ཚུལ་སོགས་ཀྱང་རང་བྱུང་གན་འི་ཡི་གེས་བསྡུ་ཉར་བྱས་པའི་འབྲས་བུ་ལས།",
    "དེ་ཡང་དངུལ་གྱི་བྱང་བུ་ལ་ཡི་གེ་བཀོད་ནས་སྤྲད་པ་བསྟན་འདུག།",
    "རྒྱལ་རབས་ཀྱི་ཡིག་ཚངས་གུང་མཐུན་པས་དེ་གོང་ཡི་གེ་མེད་ཅེས་ཚིག་ཐག་བཅད་འདུག་སྟེ།",
    "ཕྱིས་ཁྲི་སྲོང་ལྡེ་བཙན་ཡབ་སྲས་ཀྱི་རིང་ལ་སླར་བསྒྱུར་ཅིང་གཏན་ལ་ཕབ་ཚུལ་སྒྲ་སྦྱོར་བམ་གཉིས་ནང་གསལ་པོར་འཁོད་འདུག་པས་ཤེས་ཐུབ།",
    "ཤིན་ཏུ་ནས་བགྲེས་པ་ཞིག་མིན་པ་ནི་སྲོང་བཙན་གཤེགས་ནས་འགར་གྱི་ལོ་བཅུ་བདུན་ལྷག་རིང་བོད་ཀྱི་སྲིད་དོན་ཐད་དམག་དཔོན་བྱས་ནས་གཤེགས་པ་དང་དེ་སྐབས་ཀྱང་འགར་ཉིད་ལོ་མཐོན་པོ་ཞིག་མིན་འདུག་འདི་ཙམ་མ་ཟད་ཡིག་ལམ་གཞན་དུའང་གསལ་ཏེ།",
    "དེ་སྐབས་ཞང་ཡིག་ལ་བལྟོས་དགོས་ཚུལ་གསལ་བར་བསྟན་མི་འདུག་གམ།",
    "རུ་ཡོང་བཟས་བྲག་ལྷ་ཀླུ་ཕུག་བཞེངས་ཟེར་རྒྱུ་ཡིན་འདུག་སྟེ།",
    "གནའ་བོའི་གྲུང་ཤུལ་ཡོད་ས་འདི་ཡིན་པ་ཐེ་ཚོམ་མི་འདུག་སྙམ།",
    "དེ་ཉིད་རིམ་པས་ཁྲིམ་བུ་དང་ཁྲོམ་བུ་ལྐོག་ཏུ་འགྱུར་བ་ཞིག་ཡིན་པར་ཐེ་ཚོམ་མི་འདུག་སྟེ།",
    "ཐོག་མར་རུས་མིང་དུ་རྙེགས་ཞེས་བཀོད་སྲོལ་ཡོད་འདུག་པས།",
    "དེའི་གོང་ན་མི་ཁྱིམ་རི་ལ་འདུག།",
    "བོད་ཀྱི་ཡུལ་ལྷ་གྲགས་ཅན་ཁྲོད་དུ་དྲེགས་ལྷ་བྱར་མངས་ཞེས་པ་ནི་ཤིན་ཏུ་ནས་མཐོང་དཀོན་པའི་ངང་ཚུལ་ས་ལེར་གནས་འདུག་ལ།",
    "རྔོགས་ནི་གཉགས་ཀྱི་དོན་ཡིན་ཚུལ་གསལ་པོར་བཀོད་འདུག་སྟེ།",
    "༡༤ཞེས་བཀོད་འདུག་པ་ནི།",
    "༡༧ཞེས་འཁོད་འདུག་པས་འདི་ཡིན་ལ།",
    "༣ཞེས་གསུངས་འདུག་པས།",
    "འཕགས་པ་ཤིང་ཀུན་ནི་མཆོད་རྟེན་གོ་མ་ས་ལ་གྷན་དྷ་ཡིན་ཚུལ་གསལ་པོར་༦གསུངས་འདུག་དོན་དུ་སྒྲོལ་མ་རལ་པ་གྱེན་བརྫིས་ཀྱི་རྒྱུད་ལས།",
    "གཞན་ཡང་མཆོད་རྟེན་ཞིག་པོ་དང་སྔོན་གྱི་དགོན་རོ་ཤིན་ཏུ་མང་བ་ཡོད་འདུག་༡༩ཅེས་གསལ་པོར་གསུངས་པས་བསྙོན་དུ་མེད་པར་ཡིད་ཆེས་པར་འགྱུར་ལ།",
    "༡༡ཞེས་སོགས་གསལ་པོར་འཁོད་འདུག་པས།",
    "བེ་རོ་ཙ་ན་དང་།",
    "༨ ཞེས་གསལ་འདུག་པས།",
    "༡༤ཞེས་ཐ་དད་དུ་གསལ་པོར་བཀོད་འདུག་ལ།",
    "འདི་ནི་དཀར་ཆག་ཡིག་རྙིང་ཤོག་དྲིལ་གྱི་སྟོད་ན་སྐུ་བརྙན་བྲིས་པའི་མཚན་བྱང་ཡིན་ཚུལ་ཟུར་མཆན་བཀོད་འདུག་པས།",
    "༡༧ཞེས་བཀོད་ཅིང་གྲགས་སོ་ཞེས་ཞལ་བསམ་བ་གཟིམ་བཞེས་གནང་འདུག་ལ།",
    "དོང་འཕམས་ཀྱི་གསོད་མི་འབག་ཏུ་བྲིས་པ་བཞིན་དུ་འདུག་པ་ལས།",
    "༡ཞེས་འཁོད་འདུག་པ་ནི།",
    "འཇིམ་གཟུགས་སམ་བྱུང་ལ་བྲིས་པ་བཞིན་དུ་འདུག་སྟེ།",
    "༢ཞེས་འཁོད་འདུག་ལ།",
    "བེ་རོ་ཙ་ན་སྐ་ཅོག་སྣ་དྲངས་པའི།",
    "༥ཞེས་འཁོད་འདུག་ལ།",
    "༡ ཞེས་འཁོད་འདུག་པས།",
    "གུང་ཐང་ལའི་ཤར་ངོས་ཀྱི་པད་ཁུད་མཚོའི་བྱང་ངོས་ཀྱི་དོང་ཕྲང་ཞེས་པའི་འཕྲང་འདི་ཡིན་པ་ཐེ་ཚོམ་མི་འདུག་སྙམ།",
    "༡༢ཞེས་འཁོད་འདུག་ལ།",
    "ཕྱིས་སུ་གོ་ལ་ཧྲིལ་པོའི་ལོ་ཚིགས་སུ་རྩོད་མེད་དུ་གྱུར་པ་ཡིན་འདུག་འོ་ན་ནང་པའི་སྟོན་པ་ཤཱཀྱ་ཐུབ་པའི་འདས་ལོ་དེ་ཉིད་ཡེ་ཤུའི་འདས་ལོ་ལྟ་བུར་ཡོངས་ཁྱབ་ཏུ་མི་འགྱུར་བ་ཅི་ཡིན་སྙམ་ན།",
    "བོད་ཡུལ་དུ་ནང་བསྟན་དར་ཞིང་རྒྱས་པའི་སྐབས་སུ་སྟོན་པའི་འཁྲུངས་འདས་ནི་ལོ་ཚིགས་གླེང་བའི་སྲོལ་བྱུང་འདུག་སྟེ།",
    "འདིར་ཡང་རང་བློས་དཔྱད་པའི་གྲུབ་དོན་ཞིག་བསྟན་དགོས་པ་ཡིན།",
    "སྔར་རྒྱ་བལ་ཁ་ཚེ་ཀུན་ཏུ་ཡང་མཁས་པ་རྣམས་ཀྱིས་བརྩིས་ཚུལ་འདི་ཉིད་ལ་ཆ་འཇོག་པར་འདུག་ལ།",
    "འདིར་ཡང་རང་ནུས་ཀྱིས་དཔྱད་གླེང་བྱ་རྒྱུ་ཡིན།",
    "སྟོད་འདུལ་དང་ཁ་ཆེའི་ལུགས་ཀྱི་སྡོམ་རྒྱུན་སྐོར་གླེང་གནང་མི་འདུག།",
    "༤ཞེས་བཀོད་འདུག་ལ།",
    "སྡོམ་གསུམ་རབ་དབྱེ་སོགས་སུ་མཁན་བརྒྱུད་ལ་དོགས་པ་གནང་མི་འདུག་ལ།",
    "ཞི་བ་འཚོའི་བར་དུ་འང་མི་སྣ་ཁ་ཤས་མ་ཆད་པའི་ངེས་པ་གཏན་ནས་མི་འདུག་དེ་བཞིན་དུ་ཁ་ཆེའི་སྡོམ་རྒྱུན་ལ་དཔྱད་ནའང་།",
    "སྟོན་པ་ནས་ཁ་ཆེ་པན་ཆེན་བར་དུ་མི་སྣ་བཅུ་ལས་མི་འདུག་པས།",
    "དག་སྣང་དང་ཡེ་ཤེས་ཀྱི་སྐུ་མཇལ་བ་སྐད་དུ་བྱས་ན་སོ་ཐར་གྱི་རང་སྐད་ལ་ཆུ་བུན་གྱིས་ཚོས་རྒྱུག་པར་འདུག་པས་མཁྱེན་ལྡན་རྣམས་ཀྱིས་དཔྱོད་ཅིག་ཅེས་བསྟན་པ་འདི་ཡི་སྐྱོན་འབབས་རྒྱུ་ལས་མ་འདས་པ་ཁོ་ནའོ།",
    "འདི་ལ་སྟོན་པ་ནས་བརྩིས་པས་མཁན་རབས་བཅུ་དྲུག་འདུག་པས།",
    "༥ཅེས་གསུངས་འདུག་པས།",
    "༦ཞེས་བཀོད་འདུག་པ་ལས།",
    "༧ཞེས་བཀོད་འདུག་པས།",
    "དོན་དུ་གཅེར་བུའི་སྟོན་པ་རྒྱལ་བ་དམ་པའི་སྐུ་བརྙན་ཡིན་འདུག་པས།",
    "༡༢ཞེས་གསུངས་འདུག་ལ།",
    "སློབ་དཔོན་སོགས་སུ་གསལ་པོར་བཀོད་འདུག་པས།",
    "༢༥ཞེས་གསུངས་འདུག་པས།",
    "དེ་དང་འབྲེལ་བའི་གསང་སྔགས་ཀྱི་ཉམས་ལེན་བྱས་ན་ནང་པའི་གསང་སྔགས་ཀྱི་གོ་ཆོད་པར་གསུངས་འདུག་ཐེག་ཆེན་པའི་སྐབས་སོགས་སུ་ནང་པའི་བསྟན་པའི་རྩ་བ་ལ་ངོས་འཛིན་བསྐུར་མ་བྱུང་བ་ནི།",
    "ཙ་ན་ཀའི་བསྟན་བཅོས་ལས།",
    "དེང་དུས་བེ་རོ་ཙ་ནའི་སྐོར་ལ་དཔྱད་པ་བྱེད་མཁན་མང་པོ་ཡོད་ཀྱང་།",
    "བེ་རོ་ཙ་ནའི་རིགས་གང་ཡིན་དང་མཚན་ཇི་ལྟར་ཐོགས་ཚུལ།",
    "པ་འོར་ན་འདོད་ཀྱི་བུ་བེ་རོ་ཙ་ན་དང་།",
    "༣ཞེས་བཀོད་འདུག་པའི་དོན་ལ་གཞིགས་ན།",
    "བེ་རོ་ཙ་ན་ཞེས་པའི་སློབ་དཔོན་འདི་ཉིད་ནི་དབུལ་པོའི་ཁྱིམ་གྱི་བུ་ཚབ་ལྟ་བུ་མ་ཡིན་པར།",
    "བེ་རོའི་ཡབ་པ་གོར་ན་འདོད་ནི་ཕྱི་འབྲེལ་བློན་ཆེན་ཞིག་ཡིན་པར་བསྟན་འདུག་པས་དུམ་བུ་འདིས་ཡབ་ནི་བློན་རིགས་ཡིན་པ་བསྟན་པ་མ་ཟད།",
    "དེའི་རྗེས་ལ་བི་རོ་ཙ་ན་ལ་སོགས་པའི་སད་མི་མི་བདུན་རབ་ཏུ་བྱུང་ངོ།",
    "སྔགས་ལྟར་བི་རོ་ཙ་ན་ཞེས་གསོལ།",
    "སྤྱིར་སད་མི་བདུན་རབ་ཏུ་བྱུང་ཚེ་བི་རོ་ཙ་ན་རཀ་ཤི་ཏ་ཞེས་རྣམ་སྣང་སྲུང་བའམ་རྣམ་སྣང་འཚོར་མིང་བརྗེས་པ་ཡིན་ཀྱང་།",
    "གང་ལྟར་གསང་སྔགས་ཀྱི་རྣམ་སྣང་དང་འབྲེལ་བ་ཞིག་ཡིན་པར་ཐེ་ཚོམ་མི་འདུག།",
    "༡ ཞེས་བཀོད་འདུག་པས།",
    "བེ་རོ་ཙ་ནས་སྔགས་བདག་མཛད།",
    "བོ་རོ་ཙ་ན་དང་སློབ་དཔོན་པདྨའི་བར་འབྲེལ་བ་ཡོད་མེད་བརྟག་པ།",
    "བསམ་ཡས་སུ་སློབ་དཔོན་པདྨས་བི་རོ་ཙ་ན་ལ་རྒྱུ་གར་གྱི་སྐད་བསླབ་གནང་བ་དང་།",
    "བི་རོ་ཙ་ན་ཡེ་ཤེས་སྤྱན་དང་ལྡན།",
    "དེ་འདྲའི་ངོས་འཛིན་ཚུལ་འཁྲུལ་པ་ཅན་དེ་ཉིད་ག་དུས་ནས་བྱུང་བ་ཡིན་ནམ་ཞེ་ན།",
