    "ཞེས་སློབ་དཔོན་མ་ཁོལ་གྱིས་གསུངས་པ་ལྟར་ཇི་ལྟ་ཇི་སྙེད་ཐམས་ཅད་མ་འདྲེས་པར་༤༤བ་འབྱེད་པའི་ཤེས་རབ་ཏུ་འདུག་པའི་ཕྱིར་རོ།",
    "འཆི་བ་རྗེས་སུ་དྲན་པའི་བློ་རྣལ་མ་ཞིག་སྐྱེས་ན་དཔེར་ན་དེ་རིང་སང་རང་འཆི་བར་ཐག་ཆོད་པ་ན།",
    "དོན་མེད་དུ་ཚེ་མང་པོ་ཞིག་ནི་སྔར་འདས་འདུག་པ་དང་ལྷག་མ་ལའང་གཉིད་ཀྱིས་ཕྱེད་འདའ་ཞིང་།",
    "དཔེར་ན་རང་ལ་གནོད་པ་དྲག་པོ་བྱེད་པའི་༦༥བ་དགྲ་ཆེན་པོ་ཞིག་དུས་འདི་ནས་འདིའི་བར་ལ་འོང་བར་ནི་ཐག་ཆོད་ལ།",
    "ཀ་མ་པ་ལ་དམིགས་པ་སྤོ་བར་ཞུས་ཙ་ན་སྔ་མ་སྐྱོར་སྐད།",
    "འཕྲོ་ནས་ཞུས་ཙ་ན་འཕྲོ་ཡེ་མ་ཐོད་པ་ཞེས་གསུང་ལོ།",
    "ལུས་སྦྲེབས་འདར་ཞིང་སྒུར་ནས་ཀུམ་ཀུམ་པོར་འདུག་པ།",
    "ད་ལྟ་བྱེད་དམ་མི་བྱེད་ཕྱི་མ་བྱ་སྙམ་འདུག་གམ་མི་འདུག་བརྟགས་ལ།",
    "སྔར་བྱས་སམ་ད་ལྟ་བྱེད་དམ་ཕྱི་མ་བྱ་སྙམ་འདུག་ན་དེར་འགྲོ་བ་ཡིན་པས།",
    "དེར་སྐྱེས་ན་དེ་ཙ་ན་ད་ཅི་ཙུག་བྱེད་ངས་ནུས་སམ་སྙམ་དུ་ཀླད་པ་ཚ་ཀམ་ཀམ་པའམ།",
    "ཐང་ལ་འདུག་པ་ཀོག་ཀོག་ལྡང་ཡིན་པ་ཚུགས་ཐབས་ཡེ་མེད་པ་བསམས་ལ་འཇིགས་ཤིང་སྐྲག་པའི་བློ་ཅི་སྐྱེ་བྱ་གསུང་ངོ།",
    "དེ་ནི་འཆག་འདུག་འགྲེང་ཞིང་གནས་པའི་ཚེ།",
    "ང་རང་ཤེས་ཟེར་ན།",
    "སྲོག་གཅོད་པ་བྱས་སམ་བྱེད་པའམ་བྱེད་པར་འགྱུར་བ་ལ་དགའ་ཞིང་རངས་པའི་སེམས་དང་ལྡན་པ་དང་རང་ཡང་བྱེད་ལ་གཞན་དེ་འཛིན་དུ་འཇུག་ཅིང་དེའི་བསྔགས་པ་བརྗོད་པ་དང་།",
    "དེ་བཞིན་དུ་ཐོབ་བྱ་མཆོག་དམན་ལ་དམིགས་པ་དང་རང་གཞན་གྱི་དོན་ལ་དམིགས་པ་ལ་སོགས་པའི་བསམ་པའི་ཁྱད་པར་༡༩བ་དང་དེ་ཡང་ཤུགས་དྲག་ཞན་དང་རྒྱུན་རིང་ཐུང་སོགས་ཀྱི་སྒོ་ནས་ཤེས་པར་བྱའོ།",
    "འདི་ལྟ་སྟེ་རྨི་ལམ་དུ་བྱས་པ་དང་མ་ཤེས་པར་བྱས་པ་དང་བསམས་བཞིན་མིན་པར་བྱས་པ་དང་དྲག་པོ་མིན་ལ་རྒྱུན་ཆགས་མིན་པར་བྱས་པ་དང་ནོར་བར་བྱས་པ་དང་བརྗེད་པས་བྱས་པ་དང་མི་འདོད་བཞིན་དུ་བྱས་པ་དང་རང་བཞིན་གྱིས་ལུང་དུ་མ་བསྟན་པ་དང་འགྱོད་པས་བསལ་བ་དང་གཉེན་པོས་བསལ་བ་སྟེ།",
    "རབ་ཏུ་དོག་པ་མུན་གནག་ཐིབས་པོར་འདུག་པ་ཡི།",
    "ཧ་ཅང་བརྒྱུག་པ་དང་མགྱོགས་པ་དང་མཆོང་བ་དང་རྐྱལ་བ་དང་མེའི་དྲུང་ན་འདུག་གམ་ཙོག་ཙོག་པོར་འདུག་ན་ཡང་མངལ་ན་གནས་པ་ལ་གནོད་པར་གསུངས་ཤིང་།",
    "འགྲོ་འདུག་དང་ཉལ་བ་དང་བཟའ་བཏུང་དང་ཉི་མ་དང་གྲིབ་མ་བསྟེན་པ་སོགས་ཀྱང་ཇི་ཙམ་རིང་དུ་བསྟེན་པ་དེ་ཙམ་དུ་བདེ་བ་ཇེ་འཕེལ་དུ་འགྲོ་དགོས་པ་ལ།",
    "དགའ་བོ་འཆག་པ་དང་འདུག་པ་དང་འགྲེང་བ་དང་ཉལ་བའི་སྤྱོད་ལམ་དག་ཀྱང་སོ་སོ་སོ་སོར་སྡུག་བསྔལ་བར་རིག་པར་བྱ་སྟེ།",
    "གལ་ཏེ་འཆག་པས་ཉི་མ་འདའ་བར་བྱེད་ཅིང་འགྲེང་བར་མི་བྱེད་འདུག་པར་མི་བྱེད་ཉལ་བར་མི་བྱེད་ན།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "ས་གསུམ་མི་རྟག་པ་ཉིད་ཀྱི་མེ་རབ་ཏུ་འབར་བ་ན་འདུག་པ་ནི།",
    "སིང་སྐྱུར་ལ་བཏབ་པའི་ཕྱེ་བཞིན་ཁ་ན་ཕར་ཡམ་མེ་བ་ཞིག་ལས་མི་འདུག་ན།",
    "པོ་ཏོ་བའི་ཞལ་ནས་ཀྱང་སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན།",
    "ད་ཡང་རང་ལོག་མི་འོང་བས་བཟློག་དགོས།",
    "ཁམ་ལུང་བའི་ཞལ་ནས་ཀྱང་མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "དེ་ལྟར་མིན་པར་དང་པོར་བྱུང་ཙ་ན་དང་དུ་ལེན།",
    "འདུག་ས་སྤོས་པ་དང་སྐེ་ཅུ་ཅུ་བྱས་པ་ཙམ་གྱིས་ཀྱང་ཉལ་གྱིས་འགྲོ་གསུང་སྟེ།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "རང་ལ་གཅེས་པར་འཛིན་པ་དང་གཞན་ཡལ་བར་འདོར་བའི་བློ་གཉིས་གོ་ས་བརྗེས་ཏེ་གཞན་ལ་རང་ལྟར་གཅེས་པར་འཛིན་ཅིང་རང་ལ་གཞན་ལྟར་ཡལ་བར་འདོར་བའི་བློ་བསྐྱེད་པའོ།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "འོན་ཀྱང་སྔ་མ་རྣམས་ལ་གྲགས་པ་ལ་པུ་རངས་སུ་འགྲེལ་པ་བསྡུས་པ་ཞིག་མཛད་དེ་ནས་བསམ་ཡས་སུ་ཕེབས་པ་ན་དེ་ལ་ལོཙྪ་བས་སྣོན་མ་ཞུས་ནས་རྒྱས་སུ་བཏང་ཟེར་བ་འདུག་པས་ཇོ་བོས་འགྲེལ་པ་བསྡུས་པ་ཞིག་མཛད་པ་ལ།",
    "གཞན་ལ་གནོད་པར་འགྱུར་བའི་ཐབས་ཀྱིས་སྦྱིན་པ་གཏོང་བ་དང་རང་ཉིད་སྙོམས་ལས་སུ་བསྡད་དེ་གཞན་ལ་བྱེད་དུ་འཇུག་པ་དང་སློང་བ་ལ་སྨོད་པས་འཕྱ་བ་དང་ཟུར་གྱིས་སྨོད་པའི་བསྟིང་བ་དང་ངག་རྩུབ་པོས་སྤ་བཀོང་བར་བྱས་ནས་སྟེར་བ་དང་།",
    "འོ་སྐོལ་ལ་འགབ་མ་ཡང་གྲགས་ཟེར་ནས་མིས་སྨྲ་ཡིན་འདུག་བྱས་པས།",
    "དགྲ་རྒུད་པ་ལ་དགའ་བ་དང་བརླག་ན་སྙམ་པའི་བསམ་པ་ངན་པ་རྣམས་ཀྱང་དེ་ཙམ་གྱིས་དགྲ་ལ་མི་གནོད་པས་རང་སྡུག་བསྔལ་བ་ཙམ་དུ་ཟད་ལ་གནོད་ནའང་རང་གཞན་ཕུང་བར་འགྱུར་བའི་ཉེས་དམིགས་བསམས་ནས་རྣམ་པ་ཐམས་ཅད་དུ་དགག་པར་བྱ་སྟེ།",
    "སྡུག་བསྔལ་བྱུང་བ་དེ་སླར་བཅོས་སུ་འདུག་ན་ནི་ཡིད་མི་དགའ་བ་བྱ་མི་དགོས་ལ་བཅོས་སུ་མི་རུང་ན་ནི་མི་དགའ་བ་བྱས་ཀྱང་ཕན་པ་མེད་པས་དགོས་ནུས་མེད་ཅིང་ཉེས་དམིགས་ཀྱང་ཡོད་དེ།",
    "འཆག་པ་དང་འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བ་ནི་སྤྱོད་ལམ་བཞི་ཡིན་ལ།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
