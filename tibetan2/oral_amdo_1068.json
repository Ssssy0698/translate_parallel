    "གུང་མོ་དང་མརྦེ་བོ་ཁབ་ལྟར་བྱ་སྟེ།",
    "མཐེ་བོ་རྩེ་མོ་གཉིས་དཔྲལ་བའི་ཕྱོགས་སུ་བཞག་ལ་བསྐོར་བ་ནི།",
    "མ་མོ་ཐམས་ཅད་༩པའི་ཕྱག་རྒྱ་ཐམས་ཅད་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་གམ།",
    "ལས་ཀྱི་དུས་སུ་རང་གི་ལས་ལ་གཞག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ལ་རྒྱབ་གཉིས་སྦྱར་ནས་མཛུབ་མོ་གཉིས་བརྐྱང་སྟེ།",
    "སེན་མོ་སྦྱར་ནས་བཅིངས་ཏེ།",
    "རྩེ་མོ་བཅིར་བས་འབྱུང་པོ་དང་།",
    "སྔགས་དང་ཕྱག་རྒྱ་རྣམས་ཐལ་བར་བྱེད་དོ།",
    "མཛུབ་མོ་གཉིས་སོ་སོར་བསྒྲེངས་ཞེས་སྦྱར་ཏེ།",
    "དཀྱིལ་འཁོར་རྒྱལ་པོ་པྱ་མཆོག་གི་དུས་སུ་སྔོན་དུ་སྦྱར་བར་བྱའོ།",
    "གཡོན་པའི་རྡོ་རྗེ་མཛུབ་མོ་ལ།",
    "གཡས་པའི་མཛུབ་མོ་བཀུག་ནས་གཟུང་།",
    "ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བསྦུངས་པའི་གཡོན་པའི་མཛུབ་མོ་གཡས་པའི་མཛུབ་མོའི་ལྕགས་ཀྱུས་བཟུང་ཡོནས།",
    "གཡོན་པའི་རྡོ་རྗེ་མཛུབ་མོ་ལ།",
    "གཡས་པའི་མཛུབ་མོ་ལྕགས་ཀྱུས་དབྱུང་།",
    "ཅེས་བྱ་བ་ནི་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་བསྒྲེང་བ་ལ།",
    "གཡས་པའི་ཁུ་ཚུར་གྱིས་མཛུབ་མོའི་ལྕགས་ཀྱུར་ཁྲུདྲངས་པ།",
    "དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་གི་དུས་སུ་དགུག་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་དུས་སམ།",
    "མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་ཡིས།",
    "འདི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་གི་དུས་སམ།",
    "རྡོ་རྗེ་ཐལ་མོ་དམ་བྱས་ཏེ།",
    "མཛུབ་མོ་གཉིས་ནི་བཀུག་ནས་སུ།",
    "རྡོ་རྗེ་ཐལ་མོའི་མཛུབ་མོ་གཉིས་ལྕགས་ཀྱུ་ལྟར་བཀུག་ནས།",
    "ཨོཾ་བཛྲ་ཀནྡྲ་བི་ཤོ་དྷཱ་ཡ་སཟླ་ཨ་བ་ར་ཎ་ནེེ་བུདྷེ་སཥྛ་ན་ས་མ་ཡ་ཧཱུཾ་ཞེས་བྱ་བའོ།",
    "གུང་མོ་གཉི་ག་ངོས་སྦྱར་ནས།",
    "གུང་མོ་གཉིས་བསྒྲེང་བའི་རྩེ་མོ་སྦྱར་ནས།",
    "རང་གི་ཁྲོ་བོའི་སྔགས་ཀྱིས་ཡི་གེ་བཟླས་པ་འབུམ་བྱས་ལ།",
    "གནོད་སྦྱིན་མོ་ལ་སོགས་པའི་གཟུགས་བརྙན་མདུན་དུ་བཞག་ལ།",
    "བུདྷ་བེེ་ཏྲི་ཞེས་བྱ་བས་བབས་པའི་སྡུག་བསྔལ་བསལ་ལ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་པས།",
    "རྡོ་རྗེ་ཧེ་རུ་ཀའི་ཕྱག་རྒྱས་རང་གི་ལས་ལ་སྦྱར་བས་གནོད་སྦྱིན་མོ་ཐམས་ཅད་བུད་མེད་ཀྱི་གཟུགས་ཀྱི་ཆུང་མ་དང་།",
    "བུ་མོ་ལ་སོགས་པ་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ནས་རང་གི་ཁྲོ་བོའི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་ཅིང་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་ཏོ།",
    "རང་གིས་བཀའ་བསྒོའོ།",
    "ཁྲོ་བོ་གཞན་གྱི་སྦྱོར་བས་རེ་རེ་ཞིང་བསྙེན་པ་ཁྲི་བྱས་ལ།",
    "སྔགས་གཉི་ག་རེ་རེ་ཞིང་འབུམ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཁྲོ་བོ་གཞན་གྱི་རྣལ་འབྱོར་པས་དེའི་མཚན་མོར་དུར་ཁྲོད་དམ།",
    "མཛུབ་མོ་རྩེ་མོ་རབ་སྦྱར་བ།",
    "མཛུབ་མོ་གཉིས་བསྒྲེང་སྟེ།",
    "ཕན་ཚུན་དུ་ལོགས་ཀྱི་རྩེ་མོ་སྦྱར་ནས།",
    "མཛུབ་མོའི་རྩེ་མོ་ཡང་དག་པར།",
    "སྒོ་འབྱེད་པའི་དུས་སུ་མཛུབ་མོ་གཉིས་སོ་༤སོར་བྱས་པ་ནི།",
    "དེ་དག་གི་རྡོ་རྗེ་དམ་ཚིག་གི་རྡོ་རྗེའི་རིགས་ཆེན་པོ་དེ་ཉིད་གསལ་བར་བྱེད་པའི་སྒྲའི་ཚོགས་དེ་ཉིད་ནི་རྟོག་པའི་རྒྱལ་པོའོ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལྷ་མོ་སསྣལ་སོགས་པའི་གཟུགས་དེ་ལས་བྱུང་བའོ།",
    "གང་གི་ཕྱིར་ཕྱག་ན་རྡོ་རྗེའི་ཐུགས་སུ་གྱུར་པའི་རྡོ་རྗེ་དེ་ཉིད་རྡོ་རྗེ་གཟུངས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལས་བྱུང་བའི་རྡོ་རྗེ་དེས་བྱིན་གྱིས་བརླབས་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེའི་དོན་གྱི་རྗེས་སུ་སོང་བའི་མིང་དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་སྙོམས་པར་ཞུགས་ནས་རྡོ་རྗེ་ཁྲོ་བོའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཕྱག་ན་རྡོ་རྗེའི་ཐུགས་ཀར་གནས་པའི་སེམས་དཔའི་རྡོ་རྗེའི་མཐུ་ལས་བྱུང་བའི་གཟུངས་ཀྱི་ལྷ་མོ་སྤྲུལ་པའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་ལྷ་མོ་རྣམས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་དག་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི།",
    "དེ་རྣམས་ཀྱི་ཉེ་བར་མཚོན་པའི་ལྷ་མོ་ནི་ཁྲོ་བོ་རྡོ་རྗེ་དམ་ཚིག་གིས་མཚོན་པའི་ལྷ་མོའོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་བཙུན་མོའི་གསང་བ་སྦ་བའི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་དང་འབྱེལ་བའི་གསང་བའི་བཙུན་མོ་ནི་གསང་བའི་བཙུན་མོ་སྟེ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་གསང་བའི་བཙུན་མོ་དེ་སྦ་བའི་ཕྱིར།",
    "སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་གཟུངས་ཀྱི་ལྷ་མོ་རྡོ་རྗེ་ལ་སོགས་པའི་ཕྱག་རྒྱའི་གཟུགས་སུ་གྱུར་ནས།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པའི་ལྷ་མོའི་གཟུགས་ཡིན་པ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "གསང་བའི་བཙུན་མོ་ཞེས་བརྗོད་པའི་ཕྱིར་རམ།",
    "གསང་བའི་ཡེ་ཤེས་ཀྱི་གཟུགས་ཀྱི་ལྷ་མོར་སྤྲུལ་ལ།",
    "གང་གི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་འབྱེལ་པའི་བདེ་བ་ནི།",
    "བཙུན་མོ་ཉིད་དུ་གྱུར་པ་ཡིན།",
    "བྱེ་ཡི་གེ་དྷཱིཟུ་བརྗོད་པས་ལྷ་མོ་ཐམས་ཅད་དུ་གྱུར་ནས་ཕྱོགས་བཅུར་སོང་སྟེ།",
    "རྡོ་རྗེའི་རིགས་ཀྱི་ལྷ་མོ་བསྒྲུབ་པའི་ཕྱིར་རོ་ཁྱེ།",
    "དེ་ནས་ཡི་གེ་དྷཱི་༥བརྗོད་པས་ལྷ་མོའི་གཟུགས་སུ་གྲུབ་ཅིང་རྫོགས་པར་བྱ་སྟེ།",
    "རང་གི་རིགས་ནི་རྡོ་རྗེའི་རིགས་སོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་གཟུངས་ཀྱི་མཚན་མའི་ཕྱག་རྒྱ་སྟེ།",
    "གང་གི་ཕྱིར་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དུ་འཇུག་པ་མེད་པར་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དུ་གསུངས་པའི་༦དངོས་གྲུབ་རྣམས་འགྲུབ་པ་མ་ཡིན་པས་ན།",
    "ཞེས་བྱ་བ་ནི་ཁྲོ་བོ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པའི་གསང་བ་གང་གི་ཕྱིར་ལྷ་མོ་དེ་དག་གི་༧གཟུགས་སྦས་ནས།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་རྣལ་འབྱོར་དང་ལྡན་པའི་རྣལ་འབྱོར་པས་དེ་ལས་གསུངས་པའི་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ལ་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་གཟུངས་ཀྱི་རིག་པ་ཐམས་ཅད་རེ་རེ་ཞིང་བཟླས་བརྗོད་ཁྲི་བྱས་ལ།",
    "ཉི་མ་འཆར་ཀར་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཐིག་གི་ཆོ་གས་ཐིག་གདབ་པའམ།",
    "དེ་བཞིན་དུ་ཐམས་ཅད་ཀྱང་རང་གི་རིག་པས་བཀུག་ལ་གཟུགས་བརྙན་དང་གབྱུག་ཏུ་གྱུར་པར་བྱའོ།",
    "དེ་ལ་དབུས་སུ་མདུང་རྩེ་ཆུར་བྲིས་ལ་རྡོ་རྗེ་རབ་ཏུ་གཞག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་གནས་སུ་མདུང་རྩེ་གསུམ་པའི་རྩེ་མོ་གཡས་སུ་བལྟས་པ་བྲི་བར་བྱས་ལ།",
    "ལྟེ་བར་ཡིད་བཞིན་གྱི་ནོར་བུ་རྩེ་མོ་རྡོ་རྗེ་རྩེ་ལྔ་པས་མཚན་པ་དང་།",
    "དེའི་མཐར་སྣ་ཚོགས་རྡོ་རྗེ་ཚད་ཕྲ་མོས་བསྐོར་བ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་ཀྱི་གནས་སུ་རྡོ་རྗེ་དབྱིངས་ལས་གསུངས་པའི་དམ་ཚིག་གི་ཁུ་ཚུར་གྱིས་གཟུང་བའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་བྲི་བར་བྱའོ།",
    "སྒེག་མོའི་ཕྱག་རྒྱ་ལ་ཁར་དགྲོལ་བཞིས་བསྐོར་བའོ།",
    "ཨོཾ་སཛེེ་སཾ་སྠཱ་༩ར་པ་རི་ཤུདྷེ་དྷཛྲེ་ཏེ་ག་ག་ན་ས་མུངྒ་ཏེ་སྭ་བྷཱ་བ་བི་ཤུདྷེ་མ་ཧཱ་ན་ཡ་པ་རི་བཱ་རེ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་ནི།",
    "གཟུངས་ཀྱི་ལྷ་མོའི་གཟུངས་ཀྱིས་གཟུངས་རྣམས་བསྡུ་བ་བྱ་སྟེ།",
    "ཁྲོ་བོ་རྡོ་རྗེ་ལེགས་པའི་ཕྱག་རྒྱ་རྣམས་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཁྲོ་བོ་རྡོ་རྗེ་གསུང་གི་ཕྱག་རྒྱ་རྣམས་ནི།",
    "རྡོ་རྗེ་སློབ་དཔོན་གྱིས་རྡོ་རྗེ་སེམས་མའི་ཕྱག་རྒྱ་དྲག་ཏུ་གཏོགས་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ལག་པ་གཡས་པའི་ཁུ་ཚུར་བྱས་ནས་གུང་མོ་སོར་མོའི་རྒྱབ་ཏུ་མཐེ་བོང་གི་ལྟོ་སྦྱར་ལ།",
    "གུང་མོ་སོར་མོ་འདི་ལ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་མཛུབ་མོ་བརྐྱང་བས་དྲག་ཏུ་གཏོགས་པར་བྱ་ཞིང་བཛྲ་ཨཱ་བེ་ཤ་ཡ་ཨ་དུཞེས་བྱ་བ་ལན་བརྒྱའི་བར་དུ་བྱའོ།",
    "དེ་བས་ན་དེ་དག་གི་ནང་ནས།",
    "རྡོ་རྗེ་ཁྲོ་བོ་མཛུབ་མོ་གཉིས།",
    "འགའ་ཞིག་རྡོ་རྗེ་ཁྲོ་བོའི་སོར་མོ་གཉིས་བཅིངས་ཏེ།",
    "དེ་ནས་ཁྲོ་བོའི་སོར་མོ་གཉིས་དང་གར་བྱས་ནས།",
    "དེ་ནས་རང་གི་གནས་སུ་ཕྱག་རྒྱ་བགྲོལ་ནས་བཛྲ་མུ་ཞེས་བྱའོ།",
    "དེ་ནས་རྡོ་རྗེ་རིན་ཆེན་གྱི་ཕྱག་རྒྱ་བཅིང་བ་ལ་གཉིས་སུ་བྱས་ལ་མཛུབ་མོའི་རྩེ་མོ་གཉིས་གོ་ཆ་འཆིང་བ་ལྟར་བྱས་ནས།",
    "དར་དཔྱངས་བཅིང་བ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ་སཏྠ་མུ་དྲ་མོ་ཏྲི་༨ཊི་ཀུ་རུ་བ་ར་ཀ་བ་ཙེ་ན་བཾ་ཞེས་བྱ་བ་འདི་བྱའོ།",
    "མཉམ་པའི་ཐལ་མོས་མཉེས་པར་བྱའོ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་སོར་མོ་གཉིས་གར་ཕྱབྱས་ནས།",
    "གཡས་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་ཀྱི་མཛུབ་མོ་བཟུང་ནས་བསྒྱུར་ཞིང་།",
    "མཛུབ་མོའི་ངོས་དཔྲལ་བའི་ཕྱོགས་སུ་བཞག་ནས།",
    "དེ་བཞིན་དུ་གཡས་པའི་ཁུ་ཚུར་གྱིས་གཡོན་པའི་མཛུབ་མོ་དྲངས་ནས།",
    "དེ་བཞིན་དུ་གར་བྱས་ནས་གཡོན་པའི་སོར་མོ་གཡས་པའི་ཁུ་ཚུར་གྱི་མཛུབ་མོ་བཟུང་ནས་དགོད་པའི་ཚུལ་དུ་ཁར་བཞག་ནས།",
    "ཉོན་མོངས་པའི་བག་ཆགས་དང་བཅས་པ་སྤོང་བའི་མཚན་ཉིད་དང་།",
    "བཀན་ནས་རྩེ་མོ་སྦྱར་ནས་ཀྱང་།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་གྱི་རང་བཞིན་གྱི་ཉེ་བའི་ཕྱག་རྒྱ་བཅིངས་པས་རང་གི་ངང་གིས་སྤྲུལ་པ་ལ་སོགས་པ་བྱ་བ་ནན་ཏན་གྲུབ་པའི་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་བསྐྱེད་པ་དེའི་ཕྱིར་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་བརྗོད་དོ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་མཛུབ་མོ་དག།",
    "བཀན་ཏེ་རྩེ་མོ་སྦྱར་བ་ལས།",
    "བསྒྱུར་༥ནས་གཙུག་ཏོར་གྱི་ཕྱོགས་སུ་མཛུབ་མོ་དག་གཞག་པར་བྱ་སྟེ།",
    "བནྡྷ་བཛྲ་ཞེས་བརྗོད་པར་བྱས་ནས་སྔ་མ་བཞིན་དུ་རེ་རེ་ཞིང་ཡང་ཕྱག་རྒྱ་དགྲོལ་བར་བྱའོ།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བྱ་བས་བསྒྲུབ་སྤྱོཔར་བྱ་བའི་མིང་གི་གནས་སུ་བསྒྲུབ་པར་བྱ་བ་དགུག་པ་དང་།",
    "ཧཱུཾ་བཛྲ་༡༡སྒོ་ཊ་ཆེ་གེ་མོ་མཱ་༡རྟར་ཡ་ཐ་ཞེས་བྱ་བའོ།",
    "གང་གི་མིང་སྨོས་གཟིར་བ་ནི།",
    "ཧཱུཾ་མ་ན་ས་བཛྲ་ཆེ་གེ་མོ་ཙིཏྟ་ཐོསྒོ་ཊ་ཡ་ཐ་ཞེས་འདི་སྐད་སྨོས་པ་བཞིན་དུ་བཟླས་པར་བྱའོ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལ་སོགས་པ་རྣམས་ཀྱི་རང་གི་ཕྱག་རྒྱ་བཞིས་ལུས་ལ་རྒྱས་གདབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གཡོན་པའི་མཛུབ་མོ་ཐད་ཀར་བརྐྱང་།",
    "གཡོན་པའི་མཛུབ་མོ་ཐད་ཀར་བརྐྱང་བ་ནི་རིན་ཆེན་ཧཱུཾ་མཛད་ཀྱིའོ།",
    "འཇིག་རྟེན་པའི་འཁོར་ལོ་ལས་རིག་པ་མཆོག་གི་པདྨའི་ཕྱག་རྒྱ་མེ་ཏོག་བཞི་པ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "མཛུབ་མོ་གཉིས་ཀྱང་ཕན་ཚུན་ལྕགས་སྒོག་ཏུ་བཅིང་བ་བྱས་ནས།",
    "གུང་མོ་དང་སྲིན་ལག་བཞི་རྒྱབ་སྦྱར་ལ།",
    "གཡོན་པའི་མཛུབ་མོ་ཐད་ཀར་བརྐྱང་ལཧཱུཾ།",
    "གཡས་པའི་མཛུབ་མོས་མནན་པ་ནི་ཀྭ།",
    "མཛུབ་མོ་ལྕགས་ཀྱུར་བཀུག་པ་ཉིད།",
    "རྡོ་རྗེ་རྒྱལ་པོའི་གནས་སུ་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིང་བའི་མཛུབ་མོ་གཉིས་ལྕགས་ཀྱུར་བྱའོ།",
    "མཛུབ་མོའི་ངོས་ནི་སྦྱར་བ་ནི།",
    "རྡོ་རྗེ་ཆགས་པའི་གནས་སུ་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིང་བའི་རྡོ་རྗེ་མཛུབ་མོ་གཉིས་ཕན་ཚུན་ལྟོ་སྦྱར་ནས་ཁབ་ལྟར་བྱའོ།",
    "དེ་བཞིན་ཀེ་མཛུབ་མོ་ལེགས་སྦྱིན་པ།",
    "རྡོ་རྗེ་ལེགས་པའི་གནས་སུ་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིང་བའི་མཛུབ་མོ་དང་མཐེ་བོ་གཉིས་སེ་གོལ་བརྡབ་པར་བྱའོ།",
    "མཛུབ་མོ་སྤྲད་དེ་དཔྲལ་བར་གཞག།",
    "མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་བགྲེངས་ཛུནས་མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་བསྐོར་ཕྱོཞིང་།",
    "མཛུབ་མོ་བསྙམས་པ་རྐྱེསྤྱི་བོར་གཞག།",
    "མཛུབ་མོ་གཉིས་ཁབ་ལྟར་བྱས་ལ་སྤྱི་བོར་གཞག་གོ།",
    "མཐེ་བོང་གཉིས་ནང་དུ་བཅུག་ལ་མཐེ་བོ་གཉིས་ཀྱི་རྒྱབ་ཏུ་མཛུབ་མོ་གཉིས་གཞག་པར་བྱའོ།་",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཁོར་ལོའི་གནས་སུ་ཕྱརྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་མཛུབ་མོ་གཉིས་ཁབ་ལྟར་བྱས་ནས་མཛུབ་མོ་གཉི་ག་ཉིད་རྡོ་རྗེ་ལྟར་བྱའོ།",
    "མཛུབ་མོ་བསྙམས་ཏེ་ཁ་ནས་དབྱུང་།",
    "རྡོ་རྗེ་སྲུང་བའི་གནས་སུ་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཞག་ལ་མཛུབ་མོ་གཉིས་རྩེ་མོར་བྱས་ཏེ།",
    "མཛུབ་མོ་ཤིན་ཏུ་བརྐྱང་བ་དང་།",
    "མཛུབ་མོ་གཉིས་སོ་སོར་ཁབ་ལྟར་བྱའོ།",
    "མཛུབ་མོ་མགུལ་དུ་བཅིང་བར་བྱ།",
    "མཛུབ་མོ་གཉིས་སྐམ་༦པ་ལྟ་བུའི་ཕྱག་རྒྱས་མགུལ་པ་བཅིང་བར་བྱའོ།",
    "གནོད་སྦྱིན་གྱི་གནས་སུ་རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་པའི་ཕྱག་རྒྱ་ཉིད་ལས་མཛུབ་མོ་གཉིས་བརྐྱང་ལ་ཁ་འགྲམ་དུ་མཆེ་བའི་ཚུལ་དུ་གཞག་པར་བྱའོ།",
    "མཛུབ་མོ་རལ་གྲི་འདེགས་ཉུཔ་འདྲ།",
    "བྱེ་དམ་དུ་བསྡམས་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྒེག་མོ་ལ་སོགས་པ་ནས་རྡོ་རྗེ་འབེེབས་པའི་མཐར་ཐུག་པར་བཅིང་བར་བྱའོ།",
    "ལས་ཀྱི་ཧཱུཾ་མཛད་ཀྱི་བར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་སྤྱོར་བས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་དང་།",
    "དེ་ནས་སྒེག་མོ་ལ་སོགས་པའི་ཕྱག་རྒྱའི་དོན་གསལ་པོར་བརྗོད་པར་བྱ་སྟེ།",
    "མཛུབ་མོ་གཉིས་ནི་གྱེན་དུ་བསྒྲེང་།",
    "རྡོ་རྗེ་མཛུབ་མོ་སོ་སོར་བྱས།",
    "ཐལ་མོ་སྦྱར་བ་ཁ་ནས་དབྱུང་།",
    "གར་ལས་ཐལ་མོ་སྤྱི་བོར་གཞག།",
    "རང་གི་ཐལ་སྦྱར་གྱེན་དུ་གཏོར་༢་།",
    "མཛུབ་མོ་གཅིག་པུ་བཀུག་པ་དང་།",
    "མཐེ་བོ་མཛུབ་མོ་མདུད་པར་་༧བཅིངས།",
    "རྡོ་རྗེ་བཅིངས་པ་མཛུབ་མོ་ཐུབསྡམས།",
    "ཞེས་བྱ་བ་གཟུངས་ཀྱི་སྒེག་མོ་ནས་བརྩམས་ནས།",
    "གཞན་ཡང་གཟུངས་ཀྱི་ཁྲོ་བོ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གཉིས་སུ་བྱས་ནས་གསང་བའི་ལས་ཀྱི་ཉུཉེཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "རེ་རེ་ཞིང་གར་བྱས་ནས།",
    "ཡང་རེ་རེ་ཞིང་རྡོ་རྗེ་ཁུ་ཚུར་བཅིང་བ་༧གཉིས་སུ་བྱས་ནས་གཡོན་པའི་རྡོ་རྗེ་མཛུབ་མོ་བགྲེང་བ་གཡས་པས་གཟུང་སྙབ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "མཛུབ་མོ་ལྕགས་ཀྱུ་ལྟར་གནས་པ་ནི།",
    "སྒེག་མོ་ལ་སོགས་པ་རྣམས་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་བོར་གསུངས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ནས།",
    "མཛུབ་མོ་ལྕགས་ཀྱུར་༧བཅིང་བ་ནི།",
    "ཡང་སྒེག་མོ་ལ་སོགས་པ་ནས་རྡོ་རྗེ་འབེེབས་མའི་བར་གྱི་གཟུངས་ཀྱི་ཁྲོ་བོ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གཉིས་སུ་བྱས་ནས།",
    "ལས་ཀྱི་ཧཱུཾ་མཛད་རྣམས་རྔོརང་གི་དཀྱིལ་འཁོར་སྤྲུལ་པར་བྱེད་པ་སྟོན་པར་མཛད་པའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་དོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནས་རང་གི་གནས་སུ་ལྷ་ཐམས་ཅད་དགོད་༤པའི་མཐར་ཐུག་པ་བསྟན་པ་ནི།",
    "རྡོ་རྗེ་རིགས་ཀྱི་ཕྲ་མོའི་ཡེ་ཤེས་ནི་རྡོ་རྗེ་ཕྲ་མོ་སྟེ།",
    "དེའི་དམ་ཚིག་གི་དཀྱིལ་འཁོར་དུ་གྱུར་པ་ནི།",
    "གང་གི་ཕྱིར་དཀྱིལ་འཁོར་འདིར་འཇུག་པའི་རྡོ་རྗེ་རིགས་ཀྱི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་རྡོ་རྗེ་ཕྲ་མོ་བསྒོམས་ནས་བྱ་བ་ཡིན་པ་དེའི་ཕྱིར།",
    "གང་གི་ཕྱིར་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེ་དང་།",
    "ངན་སོང་ལ་སོགས་པའི་སྡུག་བསྔལ་རྣམས་བསལ་བའི་དོན་དུའོ།",
    "རྡོ་རྗེ་ཇི་ལྟ་བ་བཞིན་དུ་ལག་པ་གཉིས་སུ་སྦྱིན་ནོ་ཞེས་བྱ་བ་ནི་ནས་འབྲས་ཙམ་གྱི་རྡོ་རྗེ་ཕྲ་མོའོ།",
    "ཡེ་ཤེས་ཕྲ་མོ་ནི་རྡོ་རྗེ་ཕྲ་མོ་བརྟན་པར་གྱུར་པ་སྔོན་དུ་སོང་བའི་ཡེ་ཤེས་སོ།",
    "དེ་ཡི་རྡོ་རྗེ་ཕྲ་མོ་བརྟན་བྱས་ལ།",
    "རྡོ་རྗེ་རང་གི་རྣལ་འབྱོར་གྱིས།",
    "རང་འདོད་པའི་ཁྲོ་བོའི་རྣལ་འབྱོར་པས་ཡི་གེ་ཧཱུཾ་གིས་ཧཱུཾ་ཞེས་བྱ་བ་བཟླས་པ་ལ་སྦྱར་བར་བྱའོ།",
    "རྡོ་རྗེ་ཕྲ་མོ་བརྟན་བྱས་ཏེ།",
    "སྣའི་རྩེ་མོར་རྡོ་རྗེ་ཕྲ་མོ་བརྟན་པར་བྱས་ལ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་ཚུལ་སྦྱར་ལ།",
    "ཁྲོ་བོར་ལྡན་པ་ཞེས་བྱ་བ་ནི་རང་གི་ཁྲོ་བོ་དང་ལྡན་པའི་རྡོ་རྗེ་ཕྲ་མོ་སྣའི་རྩེ་མོར་གནས་པར་བྱའོ།",
    "དེ་ལྟར་སྤྱོར་བ་དེས་རྡོ་རྗེ་ཕྲ་མོའི་རྣལ་འབྱོར་འདི་རབ་ཏུ་སྦྱར་བ་དེ་བཞིན་དུ་རང་གི་སྣའི་རྩེ་མོར་བསྡུས་ལ།",
    "སྤྱོར་བ་བཞི་པོ་དེ་ཡང་རྡོ་རྗེ་ཕྲ་མོ་ཤཱ་བརྟན་པར་བྱས་ལརབ་ཏུ་སྦྱར་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཕྲ་མོ་བསྒོམས་ལ་འདི་བྱའོ་༧ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་ཕྲ་མོ་རབ་སྦྱར་བ།",
    "རང་གི་ཁྲོ་བོ་སྙོམས་པར་ཞུགས་ཏེ་གནས་པའོ།",
    "བསྒྲུབ་པར་བྱ་བ་གང་གི་མིང་ནས་བཟུང་བས་རྡོ་རྗེ་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་རང་གི་ལུས་ཀྱིས་འཁྱུད་པས་གང་༡༡གི་མིང་སྨོས་པ་དེ་འཆི་བར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ཕྲ་མོ་སྙོམས་འཇུག་ལ།",
    "ཧཱུཾ་མཛད་ལ་སོགས་པའི་རྣལ་འབྱོར་པས་རྡོ་རྗེ་ཕྲ་མོ་སྣའི་རྩེ་མོར་བརྟན་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་ཕྲ་བ་མུརྡོ་རྗེ་ཕྲ་མོའོ།",
    "སྣ་ནས་ནི་དེའི་སྣའི་རྩེ་མོར་རོ།",
    "རྡོ་རྗེ་ཕྲ་མོ་སྣའི་རྩེ་མོར་བསྟན་པར་བྱས་ལ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་ཚུལ་སྦྱར་ལ།",
    "ཁྲོ་བོའི་ལྟ་བའི་ཚུལ་གྱིས་རང་གི་མིག་གཉིས་སུ་བསྒོམས་ལ།",
    "བསྒྲུབ་པར་བྱ་བའི་མིག་བཅོམ་ཞིང་བསྒྲུབ་པར་བྱ་བ་༤ཐལ་བར་བྱས་པར་བསམ་པར་བྱའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ་ཕྱག་རྒྱ་བཞིས་རྒྱས་བཏབ་ནས།",
    "སྐྱིལ་མོ་ཀྲུང་འདུག་གན་རྐྱལ་དུ།་།",
    "མཛུབ་མོ་གཉིས་བཀུག་མདུན་དེ་བཞིན།",
    "ཁྲོ་བོ་རྡོ་རྗེ་ཁུ་ཚུར་ཀྱི་མཐར་ཐུག་པ་ཇི་ལྟ་བའི་རིམ་གྱིས་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ལྷག་མ་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ཡིན་ནོ།",
    "གཡོན་པའི་རྡོ་རྗེ་མཛུབ་མོ་ནི།",
    "ཁྲོ་མོ་རྡོ་རྗེ་རིན་ཆེན་མའིའོ།",
    "གཡོན་པ་ལ་ནི་གྲུ་མོ་ད་གཟུགས།",
    "ཁྲོ་མོ་དབལ་གྱིའོ།",
    "རྡོ་རྗེ་གར་ནི་བསྐོར་བ་ཡིསཐལ་མོ་དགྲམ་པ་སྤྱི་བོར་གཞག།",
    "ཁྲོ་མོ་རྡོ་རྗེ་ལས་མའིའོ།",
    "སྒེག་མོའི་ཕྱག་རྒྱའོ།",
    "རང་གི་ཁུ་ཚུར་གྱེན་དུ་འཐོར་ནི་མེ་ཏོག་མའིའོ།",
    "མཛུབ་མོ་ལྕགས་ཀྱུ་བཅིང་བ་ནི།",
    "མཛུབ་གཉིས་མདུད་ནི་ལྕགས་སྒོག་གིའོ།",
    "གང་གི་ཕྱིར་ཐུགས་ཀའི་ཚོསེམས་དཔའི་རྡོ་རྗེ་ལས་བྱུང་བ་ནི།",
    "རང་བྱེ་རང་གི་རིག་པ་འདི་གསུངས་སོ།",
    "རང་གི་རིགས་ནི་རྡོ་རྗེ་རིགས་སོ།",
    "གང་གི་ཕྱིར་ལས་ཀྱི་དཀྱིལ་འཁོར་དུ་འཇུག་པ་མེད་པ་ན།",
    "ཇི་སྲིད་ཁྲོ་བོ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་བར་དུ་ལྷ་མོར་བཞུགས་པའི་རིག་པར་འགྱུར་རོ།",
    "སྦྱིན་སྲེག་གི་ནི་ལས་རྣམས་བྱ།",
    "ཞི་བའི་ཆོ་ག་ལ་ནི་བེེཐི་ཁེལ་སོགས་པ་འོ་མ་དང་བཅས་པ་མངར་བའི་བུད་ཤིང་ལ་མེ་སྦར་ལ།",
    "ནིམ་པ་ལ་སོགས་པའི་ཤིང་ལས་བྱུང་བའི་བུད་ཤིང་གིས་མེ་སྦར་ལ་དགུག་པའི་སྦྱིན་སྲེག་གི་ཆོ་གས་སེ་བ་ཚེར་མ་ཅན་གྱི་སྦྱིན་སྲེག་གིས་དགུག་པར་བྱེད་དོ།",
    "ཞེས་བྱ་བ་ནི་ནིམ་པ་ལ་སོགས་པ་ལས་བྱུང་བའི་ཁ་བའི་བུད་ཤིང་ལ།",
    "ཞི་བའི་ཆོ་གས་ཚེར་མའི་སྡོང་བུའི་རྩེ་མོས་ཡམ་ཤིང་བྱའོ།",
    "ནམ་མཁའི་ལྕུག་མའི་མེ་ཏོག་གིས་ཞི་བའི་ཆོ་གས་སྦྱིན་སྲེག་བྱས་ན།",
    "ཞེས་བྱ་བ་ནི་ནིམ་པའི་ཤིང་ལས་བྱུང་བའི་བུད་ཤིང་གིས་མེ་སྦར་ལ།",
    "ཟུར་བཞི་པའི་རྡོ་རྗེའི་ཤིང་དེའི་མེ་ཏོག་གིས་སྦྱིན་སྲེག་བྱའོ།་།",
    "ཡང་ཐབ་ཁུང་གི་དབུས་སུ་དཀྱིལ་འཁོར་གྱི་དབུས་ཀྱི་པདྨ་ལ་རྡོ་རྗེ་རྩེ་ལྔ་པ་སོར་བརྒྱད་པའི་ཚད་དུ་བྱའོ།",
    "ཐབ་ཁུང་གི་དབུས་སུ་མདུང་རྩེ་གསུམ་པའི་སྟེང་དུ་སོར་བརྒྱད་ཀྱི་ཚད་ཀྱི་ཁྲོ་བོ་རྡོ་རྗེ་རྩེ་ལྔ་པ་བྱའོ།",
    "ཡང་ཐབ་ཁུང་གི་ས་གཞི་ནག་པོས་བྱུགས་ལཧཱུཾ།",
    "རྔ་མོའི་སྦངས་དང་།",
    "རོ་བསྲེགས་རྔུཔའི་ཐལ་བ་དང་།",
    "ཐབ་ཁུང་གི་དབུས་སུ་སོར་བརྒྱད་པའི་ཚད་ཀྱི་རྡོ་རྗེ་ལྕགས་ཀྱུ་གཞག་པར་བྱའོ།",
    "དཔངས་དང་རྒྱར་སོར་བཞི་པའི་ཚད་ཀྱི་ཁ་ཁྱེར་གཞུའི་དབྱིབས་ཀྱིས་ཀུན་ནས་བསྐོར་བའི་འུཐབ་ཁུང་གི་དབུས་སུ་རྡོ་རྗེ་པདྨ་འདབ་མ་བཅུ་དྲུག་པ་བྱས་ལ།",
    "དེ་ནས་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་སྔགས་བཟླས་པའི་ལས་ཐམས་ཅད་པའི་ཆུའི་སྣོད་དང་རང་གི་ལྷའི་བཟླས་པ་བྱས་པའི་མཆོད་ཡོན་གྱི་སྣོད་དག་ནི་ཞི་བའམ།",
    "ཐལ་བའི་ཐིག་ལེས་བསྲུང་བར་བྱའོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ལ་རྡོ་རྗེ་རབ་ཏུ་འདུད་པ།",
    "མཛུབ་མོ་གཉིས་བསྒྲེང་བ་ནི་ཐམས་ཅད་སློང་བའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་བཟློག་ནས་མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་སྤྱི་གཙུག་ཏུ་གཞག་པ་ནི་རྡོ་རྗེ་གཙུག་ཏོར་གྱི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་བཟློག་ལ་མཛུབ་མོའི་རྩེ་མོ་གཉིས་སྨིན་མཚམས་སུ་གཞག་པ་ནི་རྡོ་རྗེ་མཛོད་སྤུའིའོ།",
    "དེ་ཉིད་ཁར་གཞག་པ་ནི་རྡོ་རྗེ་རིག་པ་མཆོག་གིའོ།",
    "དེ་ཉིད་བསྒྱུར་ནས་ལྟེ་བར་མཛུབ་མོའི་རྩེ་མོ་གཏད་ཉུ་ནས་གཞག་པ་ནི་གཤིན་རྗེ་གཤེད་ཀྱིའོ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོ་གཉིས་ཀྱི་ལྕགས་ཀྱུ་ཕྲག་པ་གཡས་སུ་གཞག་པ་ནི་རྡོ་རྗེ་ལྕགས་ཀྱུའིའོ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོ་གཡས་པའི་ལྕགས་ཀྱུས་གཡོན་པའི་སྡིགས་མཛུབ་ཀྱི་དབུས་ནས་བཟུང་སྟེ་ཕྲག་པ་གཡོན་པར་གཞག་པ་ནི་རྡོ་རྗེ་ཞགས་པའིའོ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོའི་རྩེ་མོ་བརླ་གཡོན་པར་གཞག་པ་ནི་རྡོ་རྗེ་བསྙེམས་པའོ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོ་ཕན་ཚུན་ལྕགས་སྒོག་བཅིངས་ནས།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོའི་རྩེ་མོ་གཉིས་ཀྱིས་མཐེ་བོང་གི་རྒྱབ་མནན་པ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིའོ།",
    "དེ་ཉིད་མདའ་འཕེན་པ་ལྟ་བུར་གཡས་པའི་མཛུབ་མོས་གཡོན་པའི་མཛུབ་མོ་བླངས་ནས་འདྲེན་ཅིང་གཡོན་ཕྱོགས་སུ་གཞག་པ་ནི་སྤྱི་གཙུག་གིའོ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོ་དང་མཇེའུ་ཆུང་སྟེལ་བ་ནི་རྐང་གདུབ་ལྟ་བུ་སྟེ།",
    "དེ་ཉིད་ཀྱི་མཛུབ་མོ་དང་མཐེབ་མོ་ལུ་གུ་རྒྱུད་དུ་སྦྲེལ་བ་ནི་རྡོ་རྗེ་ལྕགས་སྒོག་གིའོ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་བཟླས་པའི་ཆུ་ཀུ་ཤའི་རྩེ་མོས་བླངས་ལ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་ཕྱག་རྒྱ་དང་སྔགས་ཀྱིས་མེ་བུད་པ་དང་།"
  ]
}