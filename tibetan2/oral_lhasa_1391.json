    "བརྟག་ཅིང་དཔྱད་ནས་ཡིད་ལ་བཀྲམས་བྱས་ཏེ།",
    "གཡུང་དྲུང་ས་བཅུའི་ལམ་ལ་བགྲོད་པར་གྱིས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོན་པ་ལགས།",
    "ད་ལྟ་སྡུག་བསྔལ་ཡ་བཞི་ཟུང་བརྒྱད་ཕྱེ་ནས་གསུངས།",
    "ཐབས་དང་ཚུལ་ནི་ཅི་ལྟར་བསྒྲུབ་པ་ལགས།",
    "འཛམ་གླིང་སོག་ཁའི་གནས་འདིར་འོངས་པ་ལགས།",
    "དང་པོ་སྐྱེ་བ་བཞེས་པའི་དུས་སུ་ཡང་།",
    "རྒྱུ་འབྲས་རྣམ་པར་འབྱེད་པའི་བོན་བསྟན་ནོ།",
    "གཉིས་པར་ཡང་དག་དོན་ལ་འཇུག་པའི་ཕྱིར།",
    "གཉིས་པ་ཚངས་ཤིང་མཚུངས་པར་བྱ་བའི་ཕྱིར།",
    "འཁོར་རྣམས་དབྱེ་བ་དེ་ལྟར་ཤེས་པར་གྱིས།",
    "ཡང་སྟོན་པ་ལ་བསྐོར་བ་ནི་བྱས།",
    "མཁྱེན་པའི་སྟོན་པ་ལགས།",
    "བཀའ་ནི་ཅི་ལྟ་བུ་ཞིག་ལ་བསླབ་ཅིང་གཞུང་ནི་གང་ལྟ་བུ་ཞིག་འཛིན་པ་ལགས།",
    "དེ་ལ་ཉན་པའི་ཚུལ་དང་འཆད་པའི་ལུགས་ནི་ཅི་ལྟ་བུ་ཞིག་བྱེད་པ་ལགས།",
    "ནོར་བུ་ཐམས་ཅད་འདྲ་འདྲ་ཡིན་པར་བསམ།",
    "དེ་ལྟར་མཁས་པར་ཤེས་ནས་ཚོད་ཟིན་བྱ།",
    "ཐ་མར་ཤེས་པས་མི་ཆོག་བསྒྲུབ་པར་གཅེས།",
    "སྔ་རབས་འདས་དང་ད་ལྟར་བཞུགས་པ་དང་།",
    "སོ་སོར་མཐའ་ཡས་གྲངས་སུ་གསུངས་ལགས་ཀྱང་།",
    "ད་ལྟར་བཞུགས་པའི་བཀའ་ཡང་རྣམ་པ་གསུམ།",
    "ཞལ་ནས་གསུངས་དང་བྱིན་གྱིས་བརླབས་པ་སྟེ།",
    "རྗེས་སུ་གནང་བ་དག་དང་གསུམ་དུའོ།",
    "ཞལ་ནས་གསུངས་པའི་བཀའ་ཡང་གསུམ་དུ་སྟེ།",
    "རྗེས་སུ་གནང་བའི་བཀའ་ཡང་གསུམ་དུ་སྟེ།",
    "བཀའ་ལ་བསྡུ་བ་རྗེས་སུ་གནང་བ་དང་།",
    "བཀའ་ལ་དབྱེ་བ་རྗེས་སུ་གནང་བ་དང་།",
    "བཀའ་ལ་བརྟེན་པ་རྗེས་སུ་གནང་བའོ།",
    "སློབ་དཔོན་ཐུགས་བཟུང་མཁྱེན་པའི་ཞུ་དོན་གསོལ།",
    "མཁས་པར་བསླབ་ཅིང་གོམས་པར་ག་དར་བྱ།",
    "འདྲིས་པར་བྱས་ཤིང་ཤིན་ཏུ་ནན་ཏན་གཏུགས།",
    "གཞིག་པར་བྱ་ཞིང་དོན་གྱི་གདར་ཤ་བཅད།",
    "གང་ཞིག་བསླབ་པ་མེད་པར་བོན་སྤྱོད་པས།",
    "མཁས་པར་བསླབ་ཅིང་གོམས་པར་འདྲིས་པ་ན།",
    "སྒོམ་སྤྱོད་གསུམ་གཉིས་མཐར་མ་ལྷུངས་པར།",
    "དབྱངས་ནི་སྙན་ཞིང་ཆེ་ཆུང་རན་པར་སྤྲོ།",
    "གཞི་ཡི་ཐེ་ཚོམ་བསལ་ན་གུས་པར་ཞུ།",
    "ལུས་ནི་འཆད་པའི་ཐུན་མཚམས་མ་རྫོགས་པར།",
    "ངག་ནི་ཞུས་ལེན་སྐབས་ལ་མ་བབས་པར།",
    "མི་སྨྲ་མི་གླེང་མི་བརྗོད་ལྐུགས་པར་བཞག།",
    "གཞིག་དང་འབྲེལ་དང་རྟོག་དཔྱོད་མ་གཏོགས་པར།",
    "སྣང་བའི་ཡུལ་ལ་མི་འཕྲོ་མི་ཡེངས་པར།",
    "གསུམ་པར་ཅི་ལྟར་ཉན་པའི་མཚན་ཉིད་དོ།",
    "ངོ་མཚར་ཡིད་འོང་མཛེས་བརྗིད་ལྡན་པར་བཞུགས།",
    "མཐའ་རུ་གང་དག་མི་འགལ་སྡུད་པར་ཤེས།",
    "ཉེས་སྐྱོན་དྲི་མ་རྡུལ་གྱིས་མ་གོས་པར།",
    "ས་ལམ་རྒྱུ་འབྲས་རིམ་པར་བརྩི་བ་ཡི།",
    "གཞན་དག་མི་བསླབ་བཀག་པར་བྱེད་པ་ཡིན།",
    "མཐའ་རུ་གང་དང་མི་འགལ་སྡུད་པར་ཤེས།",
    "སྤྱི་ཁོག་གྲོལ་བར་ཕུན་སུམ་ཚོགས་པར་བཤད།",
    "གང་དག་མཛད་པ་མཐར་རུ་ཕྱིན་པར་བཤད།",
    "བསྙེན་སྒྲུབ་ལས་གསུམ་མཐའ་རུ་ཕྱིན་པར་བྱ།",
    "མཐའ་རུ་གང་དང་མི་འགལ་སྡུད་པར་ཤེས།",
    "འཁོར་དེ་རྣམས་ཀྱི་ནང་ནས་གཡུང་དྲུང་སེམས་དཔའ་འགྲོ་བ་ལ་རྣམ་པར་བརྩེ་བ།",
    "དེ་ཡང་འགྲོ་བ་གང་ལ་ཡང་རྟག་པར་མི་འཛིན་ཞིང་མི་རྟག་པའི་འདུ་ཤེས་དང་ལྡན་པས།",
    "དེས་ན་རིགས་ཀྱི་བུ་རྟག་པར་མ་ངུ་ལ།",
    "ཚངས་པ་གཙུག་ཕུད་ཀྱིས་གསུངས་པར་ཤིན་ཏུ་ཡང་བདེན་པ་སྐྱེས་ཤིང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོན་པ་ལགས།",
    "འགྲོ་བ་ཡོངས་ལ་རྣམ་པར་བརྩེ་བས་སུ།",
    "བྱས་བྱེད་ལས་སྤྱོད་དོན་གྱི་མི་རྟག་པ།",
    "གཏན་དུ་སྐྱེ་འཆི་མེད་པར་མི་བརྟན་ཞིང་།",
    "ཆ་ཕྲའི་མུ་གེ་དུས་དང་རྒྱུན་པར་འཁོར།",
    "དུར་ཁྲོད་གནས་སུ་རོ་ལ་བརྟག་བྱས་ན།",
    "དེ་ལ་གོམས་ཤིང་འདྲིས་པར་གྱུར་པ་ན།",
    "རང་ཡང་བསྒོམ་ཞིང་གཞན་ལའང་སྟོན་པར་མཛོད།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོན་པ་ལགས།",
    "ཅི་ལྟར་སྤྱོད་ཅིང་ཅི་ལྟར་བསྒྲུབ་པ་ལགས།",
    "འདུས་པའི་འཁོར་རྣམས་མ་ཡེངས་བརྟན་པར་ཉོན།",
    "དབེན་གནས་རི་ཁྲོད་གཙང་མར་བསྟེན་པར་བྱ།",
    "མང་དུ་ཡོད་ཀྱང་སོ་སོར་དབེན་པར་བཙལ།",
    "དག་ཚོགས་རྣམས་སྤོངས་ལ་དབེན་པར་བྱ།",
    "ལྷ་སངས་ཞལ་ཟས་དཔའ་བོ་འབྲུ་བཅུད་དང་།",
    "ཆུ་རྒྱུན་སྐབས་མེད་དུས་དང་རྟག་པར་བསྙེན།",
    "དབེན་བའི་གནས་སུ་མི་ཡེངས་པར།",
    "གྲུབ་པའི་རྟགས་དང་མཚན་མ་རྫོགས་པར་བྱ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོན་པ་ལགས།",
    "ཐབས་མཁས་ཐུགས་རྗེ་མཁྱེན་བརྩེ་ཡེ་ཤེས་ལྡན།",
    "གང་དུ་བཞུགས་ཀྱང་གང་ནས་ཐབས་ཀྱིས་བཙལ།",
    "གང་གསུང་བཀའ་བསྒྲུབ་གང་གནང་གཙོ་བོར་འཛིན།",
    "དེས་ན་གདམས་པའི་ཐུགས་བཅུད་ལོན་པར་འགྱུར།",
    "མེ་ཆུ་ཤིང་འཆང་མཁོ་མཐུན་རན་པར་བསགས།",
    "ཟ་ཆུ་ཆ་སྙོམས་ལྟོ་རྒྱབ་རན་པར་བསྟེན།",
    "ཐ་མ་གོམས་ཤིང་ཀློང་དུ་ཆུད་པར་བསྒོམ།",
    "ཡིད་ཀྱི་འགྱུ་བྱེད་རྣམ་པར་ཤེས་པ་ནི།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོན་པ་ལགས།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཐོབ་པར་བྱ་བ་ལ།",
    "དཀའ་བ་ནི་ཅི་ལྟ་བུ་ཞིག་ལ་སྤྱད་པ་ལགས།",
    "རྣམ་པར་དག་དང་དྲི་མ་མེད་པ་དང་།",
    "གཏད་པའི་གནང་རྫས་བཅུ་གསུམ་ལེན་པར་བྱ།",
    "དང་པོ་ལེན་པའི་ཚུལ་དུ་ཤེས་པར་བྱ།",
    "དེ་ལྟར་སུམ་བརྒྱ་དྲུག་ཅུ་ཤེས་པར་བྱ།",
