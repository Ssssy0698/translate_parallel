    "ནོར་མི་བདོག་ཀྱང་ཡང་དག་འབྱོར་པ་ལགས།",
    "འདོད་པ་ཆུང་རྣམས་དེ་ལྟ་མ་ལགས་ཏེ།",
    "ཆུང་མ་གསུམ་པོ་དེ་དག་རྣམ་པར་སྤང་།",
    "འདོད་ཆགས་ཞེ་སྡང་མེད་པར་བསྟེན་བགྱི་སྟེ།",
    "རྒྱགས་ཕྱིར་མ་ལགས་བསྙེམས་པའི་ཕྱིར་མ་ལགས།",
    "འཚག་ཕྱིར་མ་ལགས་ལུས་གནས་འབའ་ཞིག་ཕྱིར།",
    "རིག་པའི་བདག་ཉིད་ཉིན་པར་མཐའ་དག་དང་།",
    "མནལ་ཚེའང་འབྲས་བུ་མེད་པར་མི་འགྱུར་བར།",
    "དྲན་དང་ལྡན་པར་དེ་དག་བར་དུ་མནོལ།",
    "གོང་མ་བརྙེས་པར་མ་གྱུར་དེ་ལྟ་ནའང་།",
    "ཚངས་པའི་འཇིག་རྟེན་བདེ་བ་ཐོབ་པར་འགྱུར།",
    "རྣམ་པར་སྤངས་པའི་བསམ་གཏན་བཞི་པོ་ཡིས།",
    "འཕྲོག་པའི་ཆོམ་རྐུན་ལགས་པར་མཁྱེན་པར་མཛོད།",
    "གང་ཟག་ལོག་པར་ལྟ་བས་ལེགས་སྤྱད་ཀྱང་།",
    "ཐམས་ཅད་རྣམ་པར་སྨིན་པ་མི་བཟད་ལྡན།",
    "མི་རྟག་བཤེས་པའི་སྤྲིང་ཡིག་༦༧༥བདག་མེད་མི་གཙང་རིག་པར་བགྱི།",
    "གཟུགས་ནི་བདག་མ་ཡིན་ཞེས་གསུངས་ཏེ་བདག།",
    "ཕྱིན་ཅི་ལོག་པར་ལྟ་དང་ཐེ་ཚོམ་སྟེ།",
    "བདེན་པ་རྣམ་པ་བཞི་ལ་འབད་པར་མཛོད།",
    "ལྷག་པའི་སེམས་ལ་རྟག་ཏུ་བསླབ་པར་བགྱི།",
    "སད་ཁོམ་གང་ལགས་དེ་ནི་ངོ་མཚར་ཆེ།",
    "རྣམ་པར་འཇིག་དེངས་མྱགས་པར་འགྱུར་བ་སྟེ།",
    "༡༨༨མཁྱེན་པར་མཛོད།",
    "ངན་སྐྱུགས་འཕྱགས་པར་བགྱིད་པ་དེ་བས་ནི།",
    "བགྱིད་པ་དེ་ནི་ཆེས་རབ་བླུན་པ་ལགས།",
    "མཐུན་པར་གྱུར་པའི་ཡུལ་དུ་གནས་པ་དང་།",
    "ཡོངས་སུ་རྫོགས་པ་ཐུབ་པས་གསུངས་དེའི་ཕྱིར།",
    "ལོག་པར་ལྟ་བ་འཛིན་དང་དུད་འགྲོ་དང་།",
    "སྐྱེ་བ་བཟློག་པའི་སླད་དུ་འབད་པར་མཛོད།",
    "ཀྱང་གསན་པར་མཛོད།",
    "རྣམ་པར་མཛེས་འཚལ་སོན་པར་རྩེས་ནས་སླར།",
    "རྐང་ལག་རྣ་བ་སྣ་གཅོད་འཐོབ་པར་འགྱུར།",
    "གདོང་མཛེས་གསེར་གྱི་པདྨ་ལྷན་བཞུགས་ནས།",
    "འོད་ཀྱིས་འཇིག་རྟེན་མཐའ་དག་སྣང་བྱས་ཏེ།",
    "རྣམ་གསུམ་མར་མེའི་སྣང་བ་རབ་བཞེས་ཤིག།",
    "ཁུ་བ་འབར་བ་འཁྲིགས་པ་ལྟུད་པར་བགྱིད།",
    "ཚེར་མ་ཅན་ལ་ཀུན་དུ་རྒྱུད་པར་བགྱིད།",
    "རྒྱུན་མི་འཆད་པར་རབ་བསྲེག་ཁ་ཡང་བགྲདི།",
    "ཁ་ཅིག་ལྕགས་ལས་བྱས་པའི་ཟངས་ཆེན་དུ།",
    "མི་འཇིག་གང་ལགས་རྡོ་རྗེའི་རང་བཞིན་ནོ།",
    "རབ་ཏུ་དྲག་བཏབ་སྡུག་བསྔལ་གང་ལགས་པ།",
    "དེ་ལྟར་ཉིད་ཀྱི་རྩལ་གྱིས་འབད་པར་མཛོད།",
    "འཚལ་བའི་མཐུ་དང་ལྡན་པ་མ་ལགས་སོ།",
    "ཏ་ལའི་ཡང་ཏོག་བསྐམས་པ་ལྟ་བུ་ལགས།",
    "ཁྲག་སོགས་མི་གཙང་བ་ཡང་མི་རྙེད་དེ།",
    "བལྟས་པ་ཙམ་གྱིས་ཀླུང་ཡང་བསྐམ་པར་འགྱུར།",
    "བར་ཆད་མེད་པར་སྡུག་བསྔལ་རྟེན་གྱུར་པ།",
    "ཉེས་པར་སྤྱད་པའི་ལས་ཀྱི་ཞགས་པ་ནི།",
    "སྡུག་བསྔལ་རོ་གཅིག་ཐོབ་པ་གང་ལགས་པ།",
    "སྒྲོན་པར་བྱེད་པའི་འཆི་ལྟས་རྣམས་དང་འདྲ།",
    "སྐྱེ་བ་བཟང་པོ་མ་ལགས་སྐྱེ་བ་ནི།",
    "གནོད་པ་དུ་མའི་སྣོད་གྱུར་ལགས་མཁྱེན་མཛོད།",
    "ཡང་སྲིད་མེད་པར་བགྱི་སླད་འབད་འཚལ་ཏེ།",
    "མྱ་ངན་འདས་ཐོབ་བགྱིད་པའི་དགེ་ཚོགས་ལགས།",
    "ཤེས་རབ་མེད་པར་བསམ་གཏན་ཡོད་མིན་ཏེ།",
    "བསམ་གཏན་མེད་པར་ཡང་ནི་ཤེས་རབ་མེད་། གང་ལ་དེ་ཉིད་ཡོད་པས་སྲིད་པ་ཡི།",
    "ཉི་མའི་གཉེན་གྱིས་རབ་གསུངས་གང་དག་ལགས།",
    "དེ་དག་རྣམས་ལ་བསམ་པར་མི་བགྱི་སྟེ།",
    "དེ་ཡིས་བློ་ནི་ཞི་བར་བགྱིད་མ་ལགས།",
    "སྤྲིང་ཡིག་ཚེ་༡༨༨སྲེད་པས་ལེན་པ་བསྐྱེད་པར་འགྱུར་བ་སྟེ།",
    "དེ་ལས་སྲིད་པ་སྲིད་ལས་སྐྱེ་བ་ལགས།",
    "སྐྱེ་བ་འགགས་པས་འདི་ཀུན་འགག་པར་འགྱུར།",
    "རྟེན་ཅིང་འབྲེལ་པར་འབྱུང་འདི་རྒྱལ་བ་ཡི།",
    "འདི་འགོག་པ་ནི་ཐར་བ་ལགས་ཏེ་དེ།",
    "འཐོབ་བགྱིད་འཕགས་ལམ་ཡན་ལག་དེ་བརྒྱད་ལགས།",
    "མཐོང་བར་བགྱི་སླད་རྟག་ཏུ་བརྩོན་པར་བགྱི།",
    "གནམ་ེལས་བབས་པ་མ་ལགས་ལོ་ཏོག་བཞིན།",
    "ས་རུམ་ལས་འཐོན་མ་ལགས་དེ་དག་སྔོན།",
    "བསྙེངས་དང་བྲལ་ལ་མང་དུ་གསོལ་ཅི་འཚལ་། ཕན་པའི་གདམས་ངག་དོན་པོ་འདི་ལགས་ཏེ།",
    "ལེགས་པར་སྤྱད་པ་རྣམ་གསུམ་ཡང་།",
    "སྐྱེ་བ་དཔག་ཏུ་མེད་པར་ལྷ་མི་ཡི།",
    "མགོན་པོ་སྐུ་ཚེ་དཔག་ཏུ་མེད་པར་མཛོད།",
    "བདེ་དགས་༧དགའ་བ་ངེས་པར་རབ་ཏུ་ཞི་མཛད་དེ།",
    "མི་བགྲེས་ནོངས་པ་མི་མངའི་གོ་འཕང་བརྙེས་པར་མཛོད།",
    "ཉི་པེ་སྣར་བརྟེན་པར།",
    "པེ་སྣར་པར།",
    "རྣམ་པར་དག་ཚུལ་གང་ཡིན་ཀླུ་མགོ་གདེངས་ཀ་ཅན།",
    "ཐོབ་པར་མི་བྱེད་མི་སྤྱོད་འཛིན་པར་མི་བྱེད་པ།",
    "བསྟན་པ་ལེགས་པར་རྙེད་ནས་གང་ཞིག་འདོར་བ་དེ།",
    "གང་དག་གཅིག་པུའང་ཡིད་ཀྱིས་ངེས་པར་རབ་བརྟགས་སྟེ།",
    "ཡང་དག་ལམ་དང་ལྷན་ཅིག་འགྲོགས་པར་བྱེད་པ་དེ།",
    "དགའ་བས་ངེས་པར་དེ་ཡི་སེམས་བསླུས་འགྱུར་བ་སྙམ།",
    "འགྲོ་བ་མཉམ་དང་མི་མཉམ་ཀུན་དུ་འཁྱམ་པར་འགྱུར།",
    "བཙིར་བ་ལྟར་བྱས་དེ་ནས་ཅི་ཞིག་ལྟར་དེ་བཙའ།",
    "མི་གཙང་དེ་ནང་གནས་བཅས་འཕེལ་བའི་ལུས་དེ་ནི།",
    "ལམ་བཟང་རྣམ་པར་སྤངས་ནས་ལམ་མིན་པར།",
    "སྨྱུག་མ་འབྲུ་ཆགས་ལྟ་བུར་བརླག་པར་ཟད།",
    "རྒོད་པ་བཞིན་དུ་སྤྱི་ནས་འཛིན་པར་བྱེད།",
    "བློ་ཡང་བསླད་འགྱུར་འགྲོ་བ་ཉམས་པར་འགྱུར།",
    "ཡུལ་ལ་ཆགས་ཀྱང་ནུས་པ་ཉམས་པར་འགྱུར།",
    "ཅི་སྟེ་དེ་ལྟར་དེ་བྱས་འགྲོ་བ་ཉམས།",
    "ཤིན་ཏུ་མི་བཟད་མུན་རུམ་འཇུག་པར་འགྱུར།",
    "འབད་པ་ལྷུར་བླངས་སྲུང་བ་བྱས་པའི་ལུས།",
    "ཡིད་འོང་འདྲིས་པ་རྣམ་པར་འདོར་བར་འགྱུར།",
    "གཏུམ་པོ་རྣམས་ཀྱིས་དབྱུག་པས་བདའ་ཞིང་ཁྲིད་༧པར་འགྱུར།",
    "མགུལ་ཕུགས་ཡངས་པ་ཉིད་དུ་ཕྱིན་པར་མ་གྱུར་པར།",
    "༦ ༩ ༣དཀའ་རླག་པར་དགའ་བའི་ལུས།",
    "ཤིན་ཏུ་སྡུག་པའི་ཚུལ་དུ་བཅུམ་ནས་འཁྱུད་པར་བྱེད།",
    "ཟུག་རྔུ་ཚབས་པོ་ཆེ་དག་ཁོང་རླག་ནུབ་པར་འགྱུར།",
    "དེ་ན་གནས་པའི་མིག་དག་ཚམ་ཚོམ་མེད་པར་འདུ།",
    "ས་གཞི་རྐང་པ་གཞག་པའི་གནས་མི་ཐོད་པར་ལྷུང་།",
    "ཚོགས་ཀྱིས་ལུས་རྨུགས་བམ་ཞིང་རྣམ་པར་འདྲུལི།",
    "མེ་ལྕེའི་ལག་མང་རྣམ་པར་འཕྲོས་ནས་ཕྱོགས་ཀྱི་དཀྱིལ་འཁོར་ཁེབས།",
    "བརྡ་མི་ཕྲད་པའི་སྐད་ཆེན་ཙམ་ཞིག་འདོན་པར་བྱེད་པར་ཟད།",
    "མི་ཡི་དངོས་པོ་ཤིན་ཏུ་རྙེད་པར་དཀའ་བ་ཉིད།"
  ]
}