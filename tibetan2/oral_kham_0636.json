    "ཟས་ནོར་འཕེལ་ཞིང་སྐྱིད་པར་གདའོ།",
    "ལན་ཆགས་གཏོར་མ་བཅས་བསྒྲུབ་ན་སྟོབས་འབྱོར་ལོངས་སྤྱོད་འཕེལ་བར་གདའོ།",
    "སྲུང་མར་གསོལ་ཞིང་རིགས་སྐྱོབས་བྱམས་མའི་གཟུངས་ཅི་མང་བཏོན་ན་སྲིད་འཕེལ་བར་གདའོ།",
    "དགྲ་དཔུང་རང་སར་ཞིག་པས་དགྲ་ངོ་མེད་ཅིང་བཟང་བར་གདའོ།",
    "གཅིག་པུར་འདུག་ན་སེམས་ལ་བརྟག།",
    "བྲག་ཆ་ལྟ་བུར་བརྗོད་བྱ་མི་གདའ་ལགས།",
    "སྤྲུལ་པ་ལྟ་བུར་ངོས་བཟུང་མི་གདའ་ལགས།",
    "གཟུགས་བརྙན་ལྟ་བུར་རང་ཚུགས་མི་གདའ་ལགས།",
    "ཞེས་གདའ།",
    "རྒྱལ་སྲིད་སྤངས་ནས་རབ་༡༢ཏུ་འབྱུང་ཞེས་གདའ།",
    "རྒྱལ་བུ་སྟན་ལ་འདུག་ལ་གང་དགོངས་གསོལ།",
    "དེ་མ་ཐག་ཏུ་སྟན་ལ་འདུག་པ་དང་།",
    "ང་རྒྱལ་བསྐྱུངས་ཏེ་སྟན་ལ་རབ་འདུག་ནས།",
    "འཁོར་དང་བཅས་པ་དྲུང་དུ་འདུག་པ་ན།",
    "ཆགས་སེམས་སྐད་ཅིག་ཙམ་ཡང་མི་གདའོ།",
    "ཁྱད་པར་ཅུང་ཟད་ཙམ་ཡང་མི་གདའ་ན།",
    "བྷཾ་ག་ལ་རུ་ཁོ་བོ་འཆིང་ཉེན་གདའ།",
    "དམན་པའི་གནས་སུ་ལྭ་བ་གྱོན་ཉེན་གདའ།",
    "ལོ་མའི་སྤྱིལ་བོར་ཀྲྀཥྞ་འདིང་ཉེན་གདའ།",
    "ཐམས་ཅད་འཕྲེང་ཞིང་རང་སར་མཆི་མ་འབྱིན།",
    "ཐོག་ཆེན་པོ་དྲུག་ནམ་མཁའ་ལ་ཆགས་འདུག་པ་མཐོང་།",
    "དེ་མཐོང་ཙ་ན་ཁྲོ་བོ་གཞན་གྱི་ལག་ཆ་བྲུལ་བ་གཅིག་ཏུ་མཛད་དེ།",
    "དེ་ནས་གཟིངས་ཆེན་པོ་ཕྲག་ཁྲིག་ཙམ་ཡང་མེད་པར་གནས་གཞི་ཆེན་པོ་བཞིན་དུ་འདུག་པ་ལ་ཅི་ཡིན་སྙམ་ནས་བལྟས་པ་དང་།",
    "དབུའི་ཅོད་པན་སྤྲིན་གྱི་གསེབ་ན་ལྷག་གེ་འདུག།",
    "ཁོ་བོ་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དྲུང་དུ་འོངས་ཏེ་གུས་པས་འདི་སྐད་དོ།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "ཐམས་ཅད་མི་འདོད་པ་ཅི་བྱུང་བ་ཐམས་ཅད་གཞན་ལ་མི་གདའ་༤༦བར་བདག་འཛིན་གཅིག་ལ་གདའ།",
    "འཁྲུལ་སྣང་རང་སེམས་ནས་སྐུ་གནོད་བྱ་གནོད་བྱེད་བཞིར་ལག་བཅངས་སུ་གཏད་པ་",
    "འབྲལ་མེད་གསུམ་དང་དག་སྦྱར་གསུམ་དང་ལུས་ངག་ཡིད་གསུམ་དང་འགྲན་ངོས་སུ་འདུག་པ་ལྡན་པར་བྱས།",
    "བསྐལ་པ་ལྷན་ཅིག་ན་འདུག།",
    "ཀོ་ལོང་རང་ལ་གཞན་གྱིས་ཇི་ལྟར་བྱས་ཀྱང་སེམས་ཀྱི་",
    "དེ་ལྟར་དཔྱད་ན་ཀུན་རྫོབ་ཙམ་དུ་ཡང་རིག་པའི་དོན་བདེན་པའི་དོན་དུ་གྲུབ་པ་གང་ཡང་མི་འདུག་ཨང་སྙམ་དུ་བསམ།",
    "དཔྱད་ན་ངོས་བཟུང་ཐམས་ཅད་དང་བྲལ་བཡེ་ནས་མ་སྐྱེས་པར་འདུག་ཨང་སྙམ་དུ་བསམ།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "སེམས་སྤྱི་དུས་ན་རང་བཞིན་མེད་པར་གྲུབ་པ་གོང་དུ་དཔྱད་པས་ཡེ་ནས་བདེན་པར་མ་གྲུབ་པར་འདུག་ཨང་སྙམ་དུ་བསམ་ལ།",
    "ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱིས་ཕན་འདོགས་པའི་དྲིན་ཅན་དུ་འདུག་པ་ཨང་སྙམ་དུ་བསམ་ལ།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ཏུ་གདའ།",
    "ཕུང་བྱེད་ལུག་མགོ་ཅན་དེ་ནི་ང་དང་བདག་༦༤ཏུ་འཛིན་པར་བྱ་བ་རང་དོན་འབའ་ཞིག་བསྒྲུབ་པའི་བློ་ཅན་འདིར་འདུག་པ་སྙམ་དུ་བསམས་ལ་དགྲ་ལ་དགྲར་ངོ་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་བསྡུ་ན་བདག་ཏུ་འཛིན་པ་གཅིག་པུར་འདུག་པས།",
    "ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱིས་ཕན་འདོགས་པའི་དྲིན་ཅན་འབའ་ཞིག་ཏུ་འདུག་ཨང་སྙམ་དུ་ཤེས་པ་ཉེ་དུངས་པ་བསྐྱེད་ལ།",
    "དེ་ཐམས་ཅད་ཀྱི་ལེ་ལན་ཡང་བདག་ལ་ཐུག་ནས་འདུག།",
    "འོ་ན་ཐོག་མ་མེད་པ་ནས་འདིས་ང་ལ་ཕན་པ་འབའ་ཞིག་བསྒྲུབ་ནས་འདུག་པ་ལ་ངས་གནོད་པ་འབའ་ཞིག་བསྐྱལ་ནས་འདུག་ཨང་སྙམ་དུ་བསམས་ལ།",
    "མི་མ་ཡིན་པ་འདུག་པ་མདུན་དུ་སྤྱན་དྲངས་ལ།",
    "དེ་འཕྲོག་ལ་ཨ་པ་རང་སེམས་སུ་འདུག་པ་སྙམ་ན།",
    "བདེ་བ་ཐམས་ཅད་བསྒྲུབ་པར་འདུག་པས།",
    "དེས་ན་འདིས་བདག་ལ་ཕན་འདོགས་པར་འདུག་པ་ཨང་སྙམ་དུ་བསམ།",
    "འདི་ཐམས་ཅད་ལུས་བཟུང་བས་ལན་ནས་འདུག་པས།",
    "ཚེ་འདིའི་ཆེ་ཐབས་དང་འདོད་པ་བསྒྲུབ་པར་འདུག་ན།",
    "མ་རྒྱུད་ལ་སྐྱེས་འདུག།",
    "ང་ལ་སྒོམ་ལོག་སྐྱེས་ནས་འདུག་སྙམ་དུ་བསམས་ཏེ།",
    "ཞེས་བྱ་བའི་རྣམ་གྲངས་ལ་རིམ་པས་བརྟག་ནས་འགལ་བར་སྤྱད་ནས་འདུག་ན།",
    "རང་ལ་ལྡན་ནས་འདུག་ན་དགའ་བ་བསྒོམས་པ་ཁྱད་པར་དུ་འབད་པར་བྱ།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "དགེ་སྦྱོར་བྱས་ཀྱང་རང་རྒྱུད་མ་ཐུལ་ཚེ།",
    "ད་ནི་ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "གང་ཡང་རང་སེམས་སྣ་ཚོགས་སྤྲུལ་པ་ལས།",
    "ཁྲི་ཁྲག་དགུའི་གཙོ་བོར་འདུག་གྱུར་ཀྱང་།",
    "དབེན་པའི་གནས་སུ་འདུག་ལ་དགར་མ་ཚོར།",
    "ཆགས་སྡང་རང་སར་བརླག་པར་གྱིས།",
    "རང་རང་ལས་ཀྱིས་བརླག་པར་འགྱུར།",
    "ཅིའི་ངོ་བོར་ཡང་མ་གྲུབ་པས་ནམ་མཁའ་ལྟ་བུར་འདུག་པ།"
  ]
}