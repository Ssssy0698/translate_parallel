    "དྲུང་ན་ཡོད་པ་ཀུན་འདུ་ཤེས་ཆུང་བར་འགྲོ་བས་ཅིས་ཀྱང་གཅིག་ཐུགས་ལ་འདོགས་པར་ནན་གྱིས་ཞུས་པས།",
    "དེ་ནས་ཉི་ཤུ་ལྔའི་སྔ་དྲོ་ས་ཆེན་པོ་འདི་རབ་ཏུ་གཡོས་པར་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་མངོན་དུ་གྱུར།",
    "ལྷག་པར་སྐྱི་སྨད་ཀྱི་ཕྱོགས་ན་གནས་པ་རྣམས་ཀྱི་མཐུན་སྣང་དུ་གྲུབ་པ་བསམ་ཡས་ཀྱི་ཐད་ཀ་ཙམ་དུ་ཡིད་གདུང་བར་བྱེད་པའི་སྒྲ་ཆེན་པོ་དེ་གསལ་བར་ཐོས་པས།",
    "སྐྱེས་བུ་ཆེན་པོ་དེ་མི་བཞུགས་པའི་ལྟས་ཡིན་པར་ངེས་ཏེ།",
    "དེ་ལྟར་རྒྱུན་གྱི་ཐུགས་དམ་གྱི་རིམ་པ་རྣམས་ཡོངས་སུ་རྫོགས་པར་གྲུབ་པའི་ཚེ།",
    "སུ་ཡང་དྲུང་དུ་སྡོད་མ་གནང་ནའང་།",
    "སྐུ་ཚེ་འདིའི་མཛད་པ་རྫོགས་པར་དགོངས་ཏེ།",
    "ནང་རྟེན་ཆེ་བ་བཅོམ་ལྡན་འདས་མགོན་པོ་བྱམས་པའི་སྐུར་བཞེངས་པ་ས་སྐྱར་བཞུགས་སུ་གསོལ།",
    "སྔར་གྱི་བཞུགས་པ་ཐམས་ཅད་དུའང་མེ་ཏོག་ཆེ་ཆུང་དང་ཁ་དོག་སྣ་ཚོགས་པའི་ཆར་ཆེན་པོ་བབས།",
    "ནམ་མཁའ་ལའང་ཁྱད་པར་ཅན་གྱི་ལྟས་དུ་མ་དང་།",
    "ཁྱད་པར་སྤྱན་སྔ་ནས་དཔོན་ཞང་པས་གཙོ་མཛད་རྣམས་ཀྱིས་བྱ་ས་ནས་བསུས་ཤིང་།",
    "དུས་རྒྱུན་གྱི་ཟླ་མཆོད་མ་ཆག་པར་སྒྲུབ་པའི་དམ་བཅའ་མཛད་ཅིང་།",
    "གང་ཕེབས་སར་དཔོན་གྲགས་པས།",
    "ཁྱད་པར་ཞ་ལུར་བསུ་བ་བཀུར་སྟི་ཕུན་སུམ་ཚོགས་པ་དང་བཅས་ཏེ།",
    "ཤིང་ཁང་བླ་བྲང་དུ་བཞུགས་སུ་གསོལ་ནས།",
    "བོ་དོང་ཨེར་བཞེངས་ཏེ་ས་སྐྱར་གདན་དྲངས་ནས་བཞུགས་སུ་གསོལ།",
    "བོ་དོང་དུ་བཞུགས་རྒྱུའི་གསེར་སྐུ་མི་ཚད་ངོ་མཚར་བ་བཞེངས་ཤིང་།",
    "བསམ་ཡས་སུ་སྐུ་གདུང་བཞུ་བའི་གདུང་ཁང་མ་ཉམས་པ་ལ་མཆོད་རྟེན་སྒོ་མངས་ཀྱི་རྣམ་པར་བཞེངས།",
    "ལོ་མཆོད་ལ་སོགས་པ་གདན་ས་ཆེན་པོས་གཙོ་མཛད་རྣམས་སུ་རྒྱུན་དུ་མ་ཆག་པར་བསྒྲུབས་ཤིང་བསྒྲུབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ལྷག་པར་ཡང་བཀའ་ཆེམས་བཞིན།",
    "ཚུ་རོལ་མཐོང་བས་རྟོགས་པར་ག་ལ་ནུས།",
    "ལེགས་བྱས་དཔག་ཏུ་མེད་པ་བསྐྲུན་པ་ལས།",
    "ཁྱེད་ཐུགས་རྒྱ་མཚོ་ཆེན་པོར་ལེགས་བཞུགས་པས།",
    "མགོན་པོ་ནམ་མཁའི་ངོས་ལ་རྣམ་པར་རོལ།",
    "གཞུང་ལུགས་རྒྱ་མཚོའི་རྣམ་པར་འགྲེལ་ཞིང་ལྟ་བར་ལྷུང་བའི་སྨྲ་བ་བཟློག་པ་དང་།",
    "འདི་ན་ཉིན་བྱེད་འོད་དང་བྲལ་ཞིང་ནོར་འཛིན་མ་ཡང་ཀུན་ཏུ་གཡོས་བྱས་ཤིང་།",
    "མཁས་པ་དང་གྲུབ་པའི་སྐྱེ་བོ་རབ་ཏུ་མང་པོ་རྒྱུན་མི་ཆད་པར་བྱུང་བའི་གནས།",
    "དཔལ་ལྡན་ས་སྐྱ་ཞེས་ཡོངས་སུ་གྲགས་པའི་གནས་ཀྱི་ཞ་ལུ་ཁང་གསར་ཞེས་པར་འཁྲུངས་ཏེ།",
    "བདག་ཉིད་ཆེན་པོ་འདི་ནི་དེས་ཉེར་བདུན་བཞེས་ཤིང་།",
    "གཡས་རུ་གཙང་པོ་འཐུངས་པ་སོགས་རྨིས་པ་ལ།",
    "ཁའུ་གཙང་པོ་རྐྱེན་གཞན་མེད་པར་རྒྱས་པ་ལ་སོགས་པའི་ལྟས་བཟང་པོ་དང་བཅས་ཏེ་ཁྱེའུ་གཟུགས་བཟང་ཞིང་མཛེས་པ།",
    "རྣམ་འཇོམས་སྟོང་ཁྲུས་ལ་སོགས་པའི་སྐུའི་རིམ་གྲོ་བཙུགས་ཏེ་འཁྲུངས་ནས་ཞི་བར་མ་གཤེགས་ཀྱི་བར་དུ་བོ་དོང་ན་མ་ཆག་པར་བསྒྲུབས།",
    "གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་ཇི་ལྟར་མཛད་པའི་ཚུལ་བརྗོད་པར་བྱ་བ་ལས།",
    "རབ་བྱུང་བྱེད་དུ་མི་སྟེར་ན་ས་སྐྱ་པའི་མངའ་རིས་སུ་མི་སྡོད་གསུང་བ་ལ་ཉེ་གནས་རྣམས་ཀྱིས་གང་དགོངས་པ་ལས་འོས་མེད་པས་འབྱོན་པར་ཞུ་ཞེས་བྲིད་པ་ལ།",
    "ཡུམ་གྱིས་གོང་མའི་ཆད་པས་འཇིགས་བཞིན་དུ་ཁས་བླངས་ནས་ཡི་གེ་བྱས་ཏེ་ཕྱག་ཏུ་ཕྱིན་པ་དང་དཔལ་ལྡན་ས་སྐྱར་ཕྱགས་ཕབ་བོ།",
    "ཆ་ལག་དང་བཅས་པ་རྫོགས་པར་གནང་སྟེ།",
    "ཉམས་འོག་ཏུ་ཆུད་པར་མཛད།",
    "བཟོའི་གནས་ལ་སོགས་པའི་རིག་པའི་གནས་ཕལ་ཆེ་བ་དག་མཁྱེན་ཅིང་།",
    "འདི་ནི་དམ་པ་ལས་ཀྱང་དམ་པར་གྱུར་པ་ཡིན་པས་ཇི་ཙམ་དུ་མཁས་པར་གྱུར་པ་དེ་ཙམ་དུ་ཁེངས་པའི་དྲི་མ་ཅུང་ཟད་ཀྱང་མི་མངའ་ཞིང་།",
    "འཁོར་རྣམས་ལ་ལེགས་པར་སློབ་པར་མཛད་དེ།",
    "རྡོ་རྗེ་ཕུར་པའི་དབྱངས་གཅིག་པུའི་ཕྱིར་ཡང་ཕྱག་ལེན་ཡོད་པའི་རྙིང་མ་བ་རྣམས་ཀྱི་ཐད་དུ་སློབ་པ་པོ་སོ་སོར་བཀྱེ་ནས་དེ་དག་ལས་བྱུང་བ་རྣམས་ཁྲིགས་སུ་ཚུད་པར་མཛད་ལ།",
    "ཇི་ལྟ་བའི་ཕྱོགས་ལ་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་རིགས་པའི་ཚོགས་རྗེས་འབྲང་དང་བཅས་པ་ལ་མཁས་པར་སྦྱངས་ནས་བདག་མེད་པ་གཉིས་ལ་ངེས་པའི་ཤུགས་ཆེན་པོ་འཆང་ལ།",
    "ལོ་དེ་ཉིད་ལ་གོང་མའི་ལུང་སི་ཏུ་དར་མ་རྒྱལ་མཚན་གྱིས་གདན་དྲངས་ནས་བཞི་ཐོག་ཏུ་བཞུགས་པའི་མངའ་གསོལ་མཛད།",
    "གོས་དར་གྱི་འགྱེད་ཕུན་སུམ་ཚོགས་པར་མཛད་དེ།",
    "ཏ་དབེན་བློ་གྲོས་རྒྱལ་མཚན་པ་བཞི་ཐོག་ཏུ་བསྐོས་ནས་གནང་བྱིན་རྒྱ་ཆེན་པོ་མཛད།",
    "འདམ་སོགས་སུ་ཕེབས་པའི་ཚེ་མར་གྱི་འབུལ་བ་སྟོབས་ཆེན་པོ་བྱུང་བའང་ར་སྒྲེང་དུ་ཐེགས་ནས་དཀར་མེར་ཕུལ།",
    "ཆེན་པོ་དཔལ་རྒྱལ་བ་ལ་གནང་བྱིན་ཆེན་པོ་མཛད།",
    "སླར་ཡང་གསེར་ཡིག་པའི་རྐྱེན་གྱིས་དྭགས་པོར་ཕེབས།",
    "དེ་ནས་སྔར་ནས་སློབ་དཔོན་ཤེས་རབ་དཔལ་ལ་ཕྱག་རྫས་མང་པོ་སྐུར་ནས་སྐོང་པོ་ནས་པར་དུས་འཁོར་ཐུགས་དཀྱིལ་གྱི་བློ་སློངས་བློས་བསླངས་བཞེངས་བཅུག་པ་ཚར་བའི་རབ་གནས་ལ་བྱོན།",
    "སྐོང་པོའི་འཁོན་ཅན་རྣམས་བསགས་ནས་མཛོ་རྟ་སུམ་བརྒྱ་ཙམ་གྱི་གནང་བྱིན་མཛད།",
    "དེའི་ཉིས་འགྱུར་གྱིས་ཡོན་རྫོ་ངས་གནང་།",
    "ཁྱད་པར་དུ་རྒྱུད་འགྲེལ་གྱི་དཔེ་འགྲེམས་ལྔ་བརྒྱ་ལྷག་ཙམ་བྱུང་།",
    "དེའི་ཟླ་བ་བཞི་པ་ལ་བོ་དོང་ཨེར་ཕེབས།",
    "ལོ་དེའི་ཟླ་བ་བདུན་པ་ལ་ལྷ་སར་བྱོན།",
    "བླ་ཡོལ་ཁྱད་པར་ཅན།",
    "མི་དཔོན་སོ་སོ་ལའང་གནང་བྱིན།",
    "ཁོང་གཉིས་བོ་དོང་དུ་བྱུང་བ་བསགས་ཏེ་ཁྲིགས་གནང་བས་འཇགས་ཏེ་ལོ་མང་པོའི་བར་དུ་བདེ་བ་ལ་བཀོད།",
    "མངའ་བདག་ལྷག་པར་དད་པར་གྱུར།",
    "དཔོན་ཆེན་པ་ལ་ཞལ་ཏ་ནན་གྱིས་གནང་བ་ལ་དཔོན་ཆེན་པས་མ་གསན་པར་བྲོས།",
    "དུས་ཕྱིས་ཀྱང་ཏའི་སི་ཏུ་པ་སྟོབས་རྒྱས་ཏེ་དཔོན་ཆེན་པ་ལ་གནོད་པ་ཆེན་པོ་བྱེད་པར་བྱུང་བ་ལ་ངེད་བར་ན་ཡོད་པས་དེ་མི་ཉན་གསུང་བའི་ཞལ་ཏ་དང་།",
    "ཤིང་ཕོ་རྟའི་ལོ་ལ་སྐུ་ཞང་ཡེ་ཤེས་ཀུན་དགའ་པ་ཏའི་སི་ཏུས་གཟུང་བ་ལ་གོང་དཀར་དུ་མགྱོགས་པར་བྱོན་ནས་སྐུ་ཞང་པ་དཀྲོལ།",
    "གཞན་ཐོས་བསམ་སྒོམ་གསུམ་ལ་སྦྱོར་བའི་ཞལ་ཏ་སོགས་ཀྱང་དུས་མ་ཡོལ་བར་གནང་།",
    "ཁྲིད་ཐམས་ཅད་ཀྱི་གེགས་སེལ་དང་འཕྲུལ་འཁོར་སོགས་ཀྱང་ཉིད་ཀྱིས་མངོན་སུམ་དུ་གནང་བ་ཡིན་ནོ།",
    "སྔགས་མཚན་ཉིད་ཀྱི་རྩོམ་པའང་མང་དུ་གནང་།",
    "ཁྱད་པར་དུ་དུས་ཀྱི་འཁོར་ལོའི་ཊིཀ་ཆེན་རྩོམ་པའི་གྲབས་མཛད་པའི་ཚེ།",
    "དུས་བཞི་སྟོང་པར་འཇུག་ཚུལ་གྱི་བརྩིས་གཞི།",
    "འོ་ཡང་ཡང་ཆོ་ག་བྱེད་པ་མི་འོང་བས་ཁྱེད་རྣམས་ལ་སྐད་བྱས་པ་ཡིན་པས་རྒྱ་གར་གྱི་དཀྱིལ་ཆོག་སོ་སོ་དང་།",
    "དེ་སྲས་ལྷག་བསམ་རྣམ་པར་དག་པའི་ཐུགས་མངའ་བདག་ཆེན་པ།",
    "གངས་རིའི་ལྗོངས་ཀྱི་སྐྱེ་རྒུ་ཐམས་ཅད་ཀྱི་མི་ཤེས་པའི་ལོག་པར་རྟོག་པ་ཐམས་ཅད་དྲུངས་ནས་འབྱིན་པར་མཛད་པའི་སྐྱེས་མཆོག་ཆེན་པོ།",
    "ཏིང་ངེ་འཛིན་གྱི་སྒོ་བསམ་གྱིས་མི་ཁྱབ་པ་རྣམས་ལ་འབད་རྩོལ་མེད་པར་ལྷུན་གྱིས་གྲུབ་པར་འཇུག་པའི་ཐུགས་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་དཔལ་གྱིས་ལྷང་ངེར་བརྗིད་པའི་བདག་ཉིད་ཆེན་པོ་དེ།",
    "ལྷག་པའི་བསམ་པ་རྣམ་པར་དག་པའི་ཐུགས་རྗེའི་རླབས་ཆེ་ཞིང་བརྩོན་པའི་ཤུགས་དྲག་པོས་བདེ་བར་གཤེགས་པའི་བསྟན་པ་ལ་ལྷག་པའི་བྱ་བ་རླབས་པོ་ཆེ་མཛད་པའི་སྐྱེས་བུ་དམ་པ།",
    "མཁས་ཤིང་གྲུབ་པ་བརྙེས་པའི་སྐྱེས་མཆོག་ཁྱད་པར་ཅན་དུ་མ་རྒྱུན་མ་ཆད་པར་བྱོན་པས་བྱིན་གྱིས་བརླབས་པའི་གནས་མཆོག་ཁྱད་པར་ཅན།",
    "དེའི་གནས་ཀྱི་ཁྱད་པར་ཁང་བཟངས་ཆེན་པོ་ཞ་ལུ་ཁང་གསར་དུ་གྲགས་པའོ།",
    "བདེ་བར་གཤེགས་པའི་བསྟན་པ་ལ་ལྷག་བསམ་རྣམ་པར་དག་པའི་ཐུགས་མངའ་བས་བསྟན་པའི་མངའ་བདག་ཆེན་པོར་གྱུར་ཅིང་།",
    "ཡབ་ཀྱིས་དགུང་ལོ་ལྔ་བཅུ་བཞེས་པ་ན།",
    "དཀར་གསུམ་བསྟེན་པར་གྱིས་ཞེས་སོ།",
    "ཡུམ་གྱི་རྨི་ལམ་ལྟས་དག་ལ་དཔེར་བྱས་ནས།",
    "གཙང་སྦྲ་ཆེ་བ་དང་ལྡན་ཞིང་བྱིས་པའི་རང་བཞིན་གྱི་སྤྱོད་པ་མེད་པར་ཚུལ་བཟང་པོས་ཡིད་ཁྲོ་བ་དང་བྲལ་བས།",
    "ཀློག་དང་ཡི་གེ་ལ་སོགས་པ་འཇིག་རྟེན་གྱི་རིག་པ་ཐམས་ཅད་བརྡ་སྤྲད་པ་ཙམ་གྱིས་ཐོགས་པ་མེད་པར་མཁྱེན་པའི་བློ་གྲོས་རྣམ་པར་དག་པ་དང་ལྡན་ཞིང་།",
    "བསྟེངས་པ་ལ་སོགས་ཀྱིས་གླགས་ཚོལ་བའི་སྐབས་མེད་པར་གྱུར་པས།",
    "བློའི་ནོར་ཅན་འདི་དགུང་ལོ་ཕྱེད་དང་གསུམ་ཙམ་བཞེས་པའི་དུས་སུ།",
    "ཡུམ་དང་བཅས་པས་ཀྱང་བསྙེན་པའི་གྲོགས་བྱས་ཏེ།",
    "དེ་ནས་ཀྱེ་རྡོ་རྗེའི་རྒྱུད་བརྟག་པ་གཉིས་པ་ལ་ཐུགས་སྦྱོང་མཛད་པས་དཀའ་ཚེགས་མེད་པར་ཚིག་དོན་རྣམས་ཐུགས་སུ་ཆུད།",
    "བོད་ཀྱི་རྗེ་བཙུན་གོང་མ་རྣམས་ཀྱི་བཞེད་ཚུལ་གྱི་རྣམ་གཞག་མང་པོ་གསུངས་པས།",
    "ཚོགས་སུ་གསུངས་པའི་དོན་མ་གོ་བ་རྣམས་ནང་དུ་ཞུས་པའི་ཚེའང་།",
    "ཁྱེད་རྣམས་ཁ་ཟུམ་པར་གྱིས།",
    "བུ་ཆུང་ད་ལྟ་བློ་གསལ་རིང་ལ་ཡོན་ཏན་སློབ་དགོས་པ་ཡིན་གསུངས་སོ།",
    "སྡོམ་བརྩོན་ཆེན་པོ་འདི་ནི་སྐུ་ཚེ་དཔག་ཏུ་མེད་པ་ནས་ཚངས་པར་སྤྱོད་པའི་ཚུལ་ཁོ་ན་ལ་གནས་པའི་བག་ཆགས་སད་དེ།",
    "དགུང་ལོ་བཅུ་གཅིག་བཞེས་པ་ན།",
    "བླ་ཆེན་པ་ལ་རབ་ཏུ་བྱུང་བ་ཞུ་བ་ཆེར་བགྱིས་ཀྱང་གནང་དུ་མ་འདོད།",
    "སྐབས་ཤིག་ན་ཡུམ་གྱིས་རབ་ཏུ་བྱུང་བར་མ་གནང་བས་ཐུགས་སྐྱོ་བར་གྱུར་ཏེ།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་ཡིད་ལ་ཐེ་ཚོམ་དང་བྲལ་བར་གྱུར་ནས་རབ་ཏུ་བྱུང་པར་ཁས་བླངས་སོ།",
    "རིགས་རར་ལན་འདེབས་པ་ཐམས་ཅད་ལོ་ཕྱེད་དང་གཉིས་ཙམ་གྱི་ཁོངས་སུ་དཀའ་ཚེགས་མེད་པར་ཕུལ་དུ་ཕྱིན་པར་གྱུར་པས།",
    "གནས་རྒྱལ་བློན་ཁྱད་པར་ཅན་རྣམས་ཀྱིས་བཞེངས་པའི་གཙུག་ལག་ཁང་བོ་དོང་བྱ་རྒོད་གཤོངས་ཞེས་པར་གྲགས།",
    "འཇམ་པའི་དབྱངས་དོན་ཡོད་རྒྱལ་མཚན་དཔལ་བཟང་པོ་དང་སྐུ་མཆེད་གཉིས་པོ་བསྙེན་པར་རྫོགས་པ་མཛད་ཅིང་།",
    "ཡང་སྐབས་གཅིག་ན་པཎ་ཆེན་ཤཱཀྱ་ཤྲཱི་ཡིན་ཟེར་བའི་དགེ་སྦྱོང་གཟུགས་རིང་པོ་རགས་པ་བྱས་པ་ལ།",
    "བྱེ་བྲག་ཏུ་འཇམ་པའི་དབྱངས་ལོངས་སྐུའི་རྣམ་པར་བྱས་པའི་སྟོང་གཟུགས་གསལ་པོ་བྱུང་།",
