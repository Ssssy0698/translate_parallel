    "གསེར་གྱི་རིན་དུ་པུསྟི་ཀ་རེ་སྐུ་རྒྱབ་ཏུ་འཁུར་ཕེབས་ཏེ་བོད་ཁ་བ་ཅན་པའི་རྨོངས་པ་བསལ་བ་མ་གཏོགས་གསེར་སྐུ་ཉོས་རབས་དང་།",
    "མཐུན་པ་སྤུན་བཞིའི་མཚོན་བྱར་གྲུབ་པའི་ཤག་ཚང་གི་རླབས་འཕྲེང་ལྟ་བུའི་ཉིན་རེའི་མཛད་རིམ་དམ་ལྷོད་མེད་པར་ཆུ་བོའི་རྒྱུན་བཞིན་དུ་གནས་པ་ཐུགས་ལ་ཞོག་ད་ནི་བདག་ཏུ་མ་བཟུང་བའི་བླ་རྒན་གྱི་ཁ་བག་ཡོད་པར་བྱ་བ་གལ་ཆེ་བས།",
    "རང་གི་མི་ཚེ་ཟེར་བ་དང་།",
    "ད་ལྟ་སྣ་བུག་ནས་ལྷམ་ལྷམ་བྱེད་པའི་དབུགས་ཀྱི་རྒྱུ་བ་དྲོན་མོ་གཏོང་རྔུབ་བྱེད་པ་འདི་ལས་མི་རྙེད་ཅིང་།",
    "སྐད་ཅིག་རེ་རེ་བཞིན་དངུལ་ཁུག་ནང་གི་དངུལ་ག་ལེར་འཛད་པ་བཞིན།",
    "བཙས་པའི་ཚེ་དབུགས་ཀྱི་རྒྱུ་བ་འདི་ཉམ་ཐག་པས་ཕ་མས་ཆད་པར་དོགས་ཏེ་མས་རང་ཤ་དྲོན་མོར་སྦྱར།",
    "རང་གི་ནུ་ཞོ་བསྣུན་མཚན་མོའི་གཉིད་བཅག་ཉིན་མོའི་ལས་ཀ་བཅག་སྟེ་ཉེན་ཁ་ལས་བསྐྱབས་པས་མི་མཚན་ཉིད་པར་གྱུར་ཐུབ་པ་མ་ལོའི་དྲིན་མིན་ན་སུའི་དྲིན།",
    "མཐར་རང་གིས་སེམས་ཐག་བཅད་པས་སྐྱིད་པའི་རང་ཡུལ་དང་གཅེས་པའི་ཕ་མ་བཞག་ནས་མི་ཡུལ་རྒྱ་གར་དུ་བརྟོལ་དུས་མིས་བཟོད་བསྲན་བྱས་ཏེ།",
    "རྒྱལ་མཚན་དཀར་པོའི་འོག་ཏུ་ལྷ་རམས་གྲྭ་སྐོར་དམ་བཅའ་འཇོག་ལ་ཉེ་བའི་དུས་སུ་བླ་རྒན་ངེད་ཅག་གིས།",
    "སླད་ནས་དྲིན་ཅན་མ་ལོས་དཀའ་ཚེགས་ལ་མ་འཛེམས་པར་བསྐྱངས་པའི་གཅེས་ཕྲུག་གི་དབུགས་ཀྱི་རྒྱུ་བ་འདི་ཉིད་དོན་མེད་ལ་བེད་མི་སྤྱོད་པར་དོན་ལྡན་འདི་ཕྱི་གཉིས་ལྡན།",
    "བརྒྱད་གཉིས་ལང་ཚོས་སྒེག་པའི་ཏཱ་རེ་མའི།",
    "བཟླས་པའི་མོད་ལ་འཛུམ་པའི་ཚེམས་འཕྲེང་གིས།",
    "རྩེ་གཅིག་ཁྱོད་ཉིད་སེམས་པའི་མིག་ཞགས་འདི།",
    "ཡང་ཡང་སྦྲེལ་བའི་བུ་སློབ་འདི་དག་གི།",
    "ཉམས་ལེན་མཐའ་རུ་འཁྱོང་བར་བྱིན་གྱིས་རློབས།",
    "འདི་ལྟར་བརྗོད་པར་བྱ་སྟེ་ལོ་བརྒྱའི་མཚམས་སུ་རྒྱ་མཚོར་བྱིང་བའི་རུས་སྦལ་ལོང་བས་མགོ་བོ་ལན་ཅིག་རྒྱ་མཚོར་གཡེང་བའི་གསེར་གྱི་གཉའ་ཤིང་གི་བུ་གར་འཕྲད་པའི་དཔེ་བཞིན།",
    "རང་ཅག་ཆེར་སྙིགས་རྒུད་པའི་དུས་སུ་འཛམ་གླིང་འདིར་མི་ལུས་བླངས་པ་ཡང་ན་སྔ་དྲགས་པ་དང་ཡང་ན་འཕྱིས་མོད།",
    "རང་གིས་ཀྱང་ལེགས་པར་ནོད་པའི་དུས་འདི་རྣམ་པ་གཅིག་ཏུ་ན་རང་ཉིད་ལ་ལྟོས་ཏེ་བསྐལ་པ་རྫོགས་ལྡན་དང་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "འུ་ཅག་གི་བརྩོན་པ་འདི་ནི་ཇི་འདྲའི་དོན་དང་ལྡན་པ་ཞིག་ཡིན།",
    "ཡར་རྩེ་མོ་ལ་ཐག་ཉེ་ཞིང་འཛེགས་ན་ཕན་པ་རྒྱ་ཆེ་ལ།",
    "ཚིག་འཁྲི་སྐམ་པོའི་ཐལ་བ་རྣོ་མོད་ཀྱང་།",
    "རང་གི་ཁེ་ཉེན་འདམ་ཀ་ནོར་བའི་ཚེ།",
    "ནང་གི་རྒྱུ་བ་དཀར་ནག་གི་ཕྱོགས་གཉིས་ལ་གནས་གཞི་ཀླད་པའི་ཕྱོགས་སོ་སོར་ཡོད་མེད་སོགས་གླེང་བས།",
    "རང་རེའི་བླ་རྒན་རྣམ་པས་བརྟག་དཔྱད་ཀྱིས་ཁྱབ་འདུག་པས་ཁྱོད་ཅག་སྤོབས་པ་བྱོས་ཤིག་ཡང་གནས་འདི་དག་ལ་ཕྱི་ནང་གི་མཁས་པ་དག་དང་ལྷན་ཅིག་ལྷག་པར་༧གོང་ས་མཆོག་གི་སྤྱན་སྔར་རྣམ་དཔྱོད་གང་ཡོད་འདོན་པའི་སྐལ་བ་འདི་ཡང་།",
    "ཨ་རི་བ་གཉིས་ཀྱིས་ཇི་ལྟར་སྐད་རིགས་གཉིས་སྦྱོར་བའི་ཚུལ་ལའང་ངོ་མཚར་བའི་ལྟད་མོ་དང་།",
    "ཇི་བསམ་དྲང་མོར་ཤོད་པའི་གཅེས་ཕྲུག་ཀླུ་སྒྲུབ་ཐབས་མཁས།",
    "མགོ་ཡིས་ཐ་སྙད་སྟོན་པའི་རིག་འཛིན་རྡོ་རྗེ་སོགས་མཐུན་པ་སྤུན་བཞིའི་ཤག་ཚང་བདེ་སྐྱིད་དཔག་བསམ་ཤིང་གི་གྲིབ་མར་བསྟེན་ནས་ལུས་སེམས་དགའ་བདེའི་དཔལ་ལ་རོལ་བཞིན་མཆིས།",
    "འཛམ་གླིང་གི་ཆེས་མཐོའི་ཧི་མཱ་ལ་ཡའི་རི་རྒྱུད།",
    "རྡོ་ལ་རི་མོར་བྲིས་པའི་དམ་བཅའ་དང་།",
    "དམར་མོའི་ལག་རྗེས་དཀར་ཆག་བྱུང་རབས་འདིར།",
    "དཔེ་མཛོད་ཁང་གི་བྱུང་རབས་ངོ་སྤྲོད་ཅིག།",
    "ལོ་ཟླ་འགའ་རེ་ད་དུང་མཚམས་ལ་བཞུགས།",
    "ལེའུ་རིང་མོའི་མིག་འཁྲུལ་ཟློས་གར་ནང་།",
    "དཔྱིད་ཉི་རིང་མོར་སྒྱུ་མའི་གཟིགས་མོ་ལ།",
    "ཟབ་མོའི་ལམ་གྱི་སྲོལ་འདི་སྒྲུབ་པ་ཡི།",
    "སྣ་ཚོགས་ཚོན་གྱིས་བྲིས་པའི་རི་མོའི་དཔེར།",
    "ས་གསུམ་སྒྲོན་མེས་ཚིམས་པ་ཕྱག་གི་ཡུལ།",
    "གོ་ལའི་རྩེ་མོར་མཛེས་པའི་གངས་ཅན་ལྗོངས།",
    "ཁ་བ་ཅན་པའི་གཙུག་གི་ནོར་བུ་སྟེ།",
    "མ་བསྐུལ་བར་ཡང་གང་གི་ཞབས་སེན་རྡུལ།",
    "སྙན་པའི་བ་དན་སྲིད་པའི་རྩེ་མོ་རུ།"
  ]
}