    "རྒན་པོ་རྒྱ་མཚོ་ཞེས་པར་དྲན།",
    "གར་ནི་གྲོགས་པོ་ཞེས་པར་དྲན།",
    "ཤེས་པ་སྤང་པར་གེས་པར་བྱ།",
    "རྒོད་པ་ཞེས་བྱ་བྱིས་པར་བསྟན།",
    "མཚམས་ནི་དུད་མེད་ཤེས་པར་བྱ།",
    "ལེགས་པར་བསྙུན་ལན་ལྗོན་པ་ཡིན།",
    "དེ་ལ་སྲིན་ལག་བསྟན་པར་བྱ།",
    "དེ་ལ་ལྕེ་ནི་བསྟན་པར་བྱ།",
    "དེ་ལ་རྩེ་གསུམ་བསྟན་པར་བྱ།",
    "དེ་ལ་མཚོག་མ་བསྟན་པར་བྱ།",
    "དེ་ལ་མཁུར་ཚོས་བསྟན་པར་བྱ།",
    "དེ་ལ་ས་གཞི་བསྟན་པར་བྱ།",
    "དེ་ལ་ལག་ངར་བསྟན་པར་བྱ།",
    "དེ་ལ་ལྟོ་བ་བསྟན་པར་བྱ།",
    "དེ་ལ་ཀོས་ཀོ་བསྟན་པར་བྱ།",
    "དེ་ལ་ལྕི་ནི་བསྟན་པར་བྱ།",
    "དེ་ལ་ཀོས་ཁུར་བསྟན་པར་བྱ།",
    "དེ་ལ་ལྟོ་བ་བསྟན་པར་བྱ།",
    "དེ་ལ་ལིང་ག་བསྟན་པར་བྱ།",
    "དེ་ལ་གཞང་ནི་བསྟན་པར་བྱ།",
    "དེ་ལ་རྐང་མ་ཐིལ་བསྟན་པར་བྱ།",
    "གང་ཞིག་གཙང་པོ་སྟོན་བྱེད་པ།",
    "དེ་ལ་རྒྱ་མཚོ་བསྟན་པར་བྱ།",
    "དེ་ལ་ཉི་མ་བསྟན་པར་བྱ།",
    "དེ་ལ་ནམ་མཁའ་བསྟན་པར་བྱ།",
    "དེ་ལ་མཚམས་ནི་བསྟན་པར་བྱ།",
    "དེ་ལ་མཆུ་ནི་བསྟན་པར་བྱ།",
    "དེ་ལ་ཁ་ནི་བསྟན་པར་བྱ།",
    "དེ་ལ་རྒྱབ་ནི་བསྟན་པར་བྱ།",
    "པདྨའི་དྲི་ནི་རྣམ་པར་གཏོང་།",
    "སྨིན་མཚམས་པར་ན་རྩེ་གསུམ་ཡོད།",
    "ཡང་ན་ཤག་ཏི་གསལ་འགྱུར་བ།",
    "མཁའ་འགྲོ་ཡིན་པར་གདོན་མི་ཟ།",
    "གང་ཞིག་གཞན་མིན་བདག་ཉིད་བཞུགས།",
    "ཉི་མའི་དཀྱིལ་འཁོར་སྟེང་ན་བཞུགས།",
    "གཡས་བརྐྱང་བས་ནི་གནས་ན་བཞུགས།",
    "ལེགས་དགྱེས་དགྱེས་པར་རོལ་བགྱིད་དེ།",
    "ནུབ་སྒོ་ཡི་ནི་གནས་ན་བཞུགས།",
    "ལྷོ་ཡི་སྒོ་ན་བཞུགས་པའོ།",
    "ལྷོ་ནུབ་མཚམས་ན་བཞུགས་པའོ།",
    "ནུབ་བྱང་མཆམས་ན་བཞུགས་པའོ།",
    "བདུད་ཀུན་བཅོམ་ནས་བཞུགས་པའོ།",
    "ལྷོ་ནུབ་གྲྭ་ན་བཞུགས་པའོ།",
    "ནུབ་བྱང་ཕྱོགས་ཀྱི་གྲྭ་ན་བཞུགས།",
    "གཡོན་བརྐྱང་པས་ནི་བཞུགས་པའོ།",
    "དངོས་པོ་མེད་པར་བདག་མི་འགྱུར།",
    "བདག་ནི་རང་བཞིན་གནས་སུ་བཞུགས།",
    "འགྲོ་འགྱུར་པར་ནི་ཐེ་ཚོམ་མེད།",
    "བདུད་བཞི་ཡི་ནི་སྟེང་ན་བཞུགས།",
    "ཕྱག་གཉིས་མདའ་གཞུ་འགེངས་པར་ལྡན།",
    "རྣམ་པར་རྟོག་པའི་ཕུང་པོའི་གཟུགས།",
    "ལྷ་ཡི་སྐུ་ནི་ཐོབ་པར་འགྱུར།",
    "ཕྱི་ནསརྣམ་པར་རྟོག་པ་སྐྱེ།",
    "དེ་ལ་དངོས་གྲུབ་མེད་པར་འགྱུར།",
    "ཐབས་ནི་བད་བཞེས་སུ་བསྟན།",
    "དཀྱིལ་འཁོར་ནང་དུ་ཡང་དག་བཞུགས།",
    "བདེ་བ་གཉིས་གྱེས་ཤེས་པར་བྱ།",
    "རིམ་པ་ཡིས་ནི་ཤེས་པར་བྱ།",
    "གང་ཚེ་ངེས་པར་ཡིན་པར་འགྱུར།",
    "གསུམ་གྱི་རྣམ་པར་དག་པར་འགྲོ།",
    "འདོད་པ་འདུན་པ་ཡིན་པར་བཤད།",
    "དེ་ཚེ་རྒྱས་པ་ཡིན་པར་འགྱུར།",
    "ལྷན་ཅིག་སྐྱེས་རིམ་ཤེས་པར་བྱ།",
    "བ་ཏ་༡ གསལ་ཞིང་རིག་པའི་རྟགས་ཀྱིས་སྣང་བ་སེམས་སུ་སྒྲུབ་པར་མི་ནུས་པ།",
    "ཏ་༢ ལྷན་ཅིག་དམིགས་པ་ངེས་པའི་རྟགས་ཀྱིས་སྣང་བ་སེམས་སུ་སྒྲུབ་པར་མི་ནུས་པ།",
    "ཇ་༡ ཧེ་དུ་དང་མཚུངས་པར་དོགས་པ་སྤང་བ།",
    "ཆ་༡ མཚན་ཉིད་གཏན་མི་དགོས་པར་ལོག་པར་རྟོག་པ་དགག་པ།",
    "ཆ་༢ མཚན་ཉིད་གཞན་དུ་ལོག་པར་རྟོག་པ་དགག་པ།",
    "ཆ་༥ རྫས་སུ་ཡོད་པས་མཚན་ཉིད་ལ་མི་དགོས་པར་རྟོག་པ་དགག་པ།",
    "བ་ཇ་༡ བསྒྲུབ་བྱ་དང་མཚུངས་པར་དོགས་པ་སྤང་བ།",
    "ཉ་༡ གཏན་ལ་འབེབས་པར་བྱེད་པའི་མཚན་གཞི།",
    "བབབབབབབ་བབ་ཆ་༢ གྲངས་ཉུང་བར་ལོག་པར་རྟོག་པ་དགག་པ།",
    "ཆ་༣ གྲངས་མང་བར་ལོག་པར་རྟོག་པ་དགག་པ།",
    "བ་བ་བ་ཅ་༢ མཚན་གཞི་ལ་རྟེན་པའི་རྣམ་པར་དབྱེ་བ།",
    "བབབབབ་ཉ་༡ མ་ཁྱབ་པར་བསྒྲུབ་པ།",
    "ཅ་༣ མཚན་གཞི་ལ་ལོག་པར་རྟོག་པ་དགག་པ།",
    "ཅ་༡ རང་ལས་ངེས་དང་གཞན་ལས་ངེས་ཀྱི་ཁྱད་པར་རྣམ་པར་བཞག་པ།",
    "བབབབབབབ་བ་བབབབབ་ཆ་༡ རང་ལས་ངེས་ཀྱི་རྣམ་གཞག་ཇ་༡ ཡུལ་ལ་རྒྱབ་ཀྱི་མེ་བདེན་པར་དངོས་སུ་རྟོགས་པའི་ཚུལ།",
    "ཆ་༢ གཞན་ལས་ངེས་ཀྱི་རྣམ་གཞག་ཇ་༡ གཞན་ལས་ངེས་པར་བྱ་བའི་ཁྱད་པར།",
    "ཇ་༣ ངེས་པར་བྱས་པའི་དོན།",
    "ག་༢ མངོན་སུམ་གྱི་ཁྱད་པར་གྱི་མཚན་ཉིད།",
    "ཉ་༢ ཡིད་ཁྱད་པར་ཅན་ལ་བརྟེན་ནས་སྐྱེས་པ།",
    "ཇ་༣ ཞར་ལ་མཚན་ཉིད་པ་དང་བཏགས་པ་བའི་ཁྱད་པར་རྣམ་པར་གཞག་པ།",
    "བབ་ཆ་༢ སྐབས་སུ་བབ་པའི་དོན་གྱི་ཁྱད་པར་ཉེ་བར་བཟུང་བའི་དགོས་པ།",
    "ཆ་༡ ཤེས་འདོད་འཇུག་པར་འགལ་ནས་ཤེས་འདོད་མེད་པ།",
    "ཇ་༡ རྩོད་གཞི་དང་རྩོད་གཞི་མ་ཡིན་པའི་རྣམ་པར་དབྱེ་བ།",
    "བས་ཏ་༡ མི་མཐུན་ཕྱོགས་ལ་ཁྱབ་པར་ཡོད་པའི་འགལ་བ།",
    "ཉ་༢ མི་དམིགས་པའི་ཁྱབ་པ་ངེས་པར་བྱེད་པའི་ཚུལ།",
    "ཅ་༣ གང་ཟག་ལ་ལྟོས་ནས་བརྩི་བའི་བརྩིས་རྣམ་པར་གཞག་པ།",
    "བ་ཆ་༡ མཚན་ཉིད་མི་དགོས་པར་ལོག་པར་རྟོག་པ་དགག་པ།",
    "ཤཱཀུ་ལ་ཤག་ཀྱ།",
    "འདུས་བྱས་ཐམས་ཅད་ནི་མི་རྟག་པའོ་ཞེས་ཁྱབ་པ་དངོས་སུ་གསུངས་ལ།",
    "མ་དམིགས་པའི་རྟགས་ལ་རྟེན་པའི་རྗེས་དཔག་ཀྱང་གསུངས་སོ།",
    "དང་པོ་ལ་ཡང་དཔེར་བརྗོད་པ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རྟོག་པ་ལ་སྣང་བ་སྟེ།",
    "རྫའི་བུམ་པའམ་གསེར་གྱི་བུམ་པ་ཡིན་ཞེས་བྱེ་བྲག་མི་ཕྱེད་པར་སྤྱིར་བུམ་པ་ཙམ་ཞིག་སྣང་བ་ལྟ་བུའོ།",
    "འོ་ན་མེ་ལ་སོགས་པ་བཙོ་བ་དང་བསྲེག་པའི་དོན་བྱེད་ནུས་པར་སྣང་བ་དོན་བྱེད་པ་དངོས་མེད་དུ་འགལ་ལོ་ཞེ་ན།",
    "འདི་དག་རྣམ་པར་རིག་ཙམ་ཉིད།",
    "ཞེས་སློབ་དཔོན་དབྱིག་གཉེན་གྱིས་གསུངས་པའི་ཚུལ་གྱིས།",
    "མེས་བཙོ་བ་དང་བསྲེག་པའི་དོན་བྱེད་ནུས་པར་སྣང་ཡང་དོན་བྱེད་པ་ལྟ་བུར་སྣང་བ་ཡིན་གྱི་དོན་བྱེད་པ་ཡང་དག་པ་མེད་དེ།",
    "འོ་ན་ཡུལ་ཐམས་ཅད་བརྫུན་པས་ཡུལ་ཅན་ཤེས་པ་མཐའ་དག་ཀྱང་འཁྲུལ་པར་མི་འགྱུར་རམ་ཞེ་ན།",
    "དེའི་ལན་ནི་ཡུལ་ཅན་ཤེས་པ་འཁྲུལ་མ་འཁྲུལ་གྱི་ཁྱད་པར་ཡུལ་བདེན་བརྫུན་གྱིས་འབྱེད་ན་ཡུལ་ཅན་ཤེས་པ་ཐམས་ཅད་འཁྲུལ་བར་འགྱུར་བ་བདེན་ཡང་དེས་ཁྱད་མི་འབྱེད་ཀྱི།",
    "འོན་ཀྱང་དེའི་ཁྱད་ནི་གཉིས་ལས་ཀུན་རྫོབ་རྣམ་བཞག་ནི་ཡུལ་ཅན་ཤེས་པ་འཁྲུལ་མ་འཁྲུལ་གྱི་ཁྱད་པར་བག་ཆགས་བརྟན་པ་དང་མི་བརྟན་པས་འབྱེད་དེ།",
    "བག་ཆགས་མི་བརྟན་པ་ལ་ཟླ་བ་གཉིས་ལ་སོགས་པར་སྣང་ཞིང་།",
    "མེད་པར་སྣང་བ་ལ་ཀུན་བརྟགས་སུ་བྱེད་ན་རྣམ་བརྫུན་གྱི་ལུགས་ཀྱིས་ཀུན་བརྟགས་ཤིན་ཏུ་མང་ངོ།",
    "མེད་པར་འདོད་པ་ལས་དབྱེའོ།",
    "མེ་དང་ཆུ་ལ་སོགས་པས་བཙོ་བ་དང་བསྲེག་པའི་དོན་བྱེད་ནུས་པར་མཐོང་བཞིན་དུ་དངོས་པོ་མེད་ཅེས་སྨྲ་ན་ཁ་ནང་ལྟས་ཀྱི་ཤེས་པའང་དངོས་པོར་མེད་ཅེས་སྒྲེའོ།",
    "ཞེས་པས་ཕྱི་རོལ་གྱི་དོན་ཡང་དག་པར་ཡོད་ན།",
    "ཐོག་མ་དབུས་ཀྱང་བརྟག་པར་གྱིས།",
    "དེ་ལྟ་ན་དངོས་པོ་ཙམ་ལ་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པས་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "དངོས་པོ་ཙམ་ལ་ཆ་མེད་ཀྱི་གཅིག་དང་དུ་མས་མ་ཁྱབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདོད་པ་ལ་བསལ་ཏེ་དངོས་པོ་ལ་ས་བོན་གྱིས་མྱུ་གུ་བསྐྱེད་པ་ལྟ་བུའི་རིམ་གྱིས་དོན་བྱེད་པར་ཡོངས་ཆོད་ལ་གྲུབ་པ་ན་ཅིག་ཅར་གྱིས་དོན་བྱེད་པ་རྣམ་གཅད་ལ་ཁེགས་ལ།",
    "དངོས་པོ་ལ་ཆ་མེད་ཀྱི་གཅིག་དང་དུ་མས་ཁྱབ་པར་མི་འགྲུབ་སྟེ།",
    "གཅིག་དང་དུ་བྲལ་ཧེ་དུ་རུ་བཀོད་པ་ན་མ་གྲུབ་པར་འགྱུར་ཏེ།",
    "སྔ་མ་ནི་འདོད་པར་མི་རུང་སྟེ།",
    "དེ་ཕྱིར་རྣམ་དབྱེ་ཤེས་པར་བྱ།",
    "བག་ཆགས་བརྟན་པ་ལ་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པར་སྣང་ཞིང་།",
    "བག་ཆགས་མི་བརྟན་པ་ལ་ཟླ་བ་གཉིས་ལ་སོགས་པར་སྣང་ཞིང་དེའི་ཡུལ་བརྫུན་ཞེས་ཐ་སྙད་གདགས་ལ།",
    "དེ་ལྟར་མ་ཡིན་པར་མྱོང་བ་ཡིན་ན་རྟོག་པ་ལ་མ་ཁྱབ་ལ།",
    "འོས་གཞན་མེད་པས་བདག་གཅིག་པའི་འབྲེལ་བ་ལ་རྟེན་པར་འགྲུབ་སྟེ།",
    "བྱས་ཡོད་རྟག་པའི་སྟེང་དུ་བཀག་ཙམ་ན་འོས་གཞན་མེད་པས་བྱས་ཡོད་ལ་མི་རྟག་པས་ཁྱབ་པ་འགྲུབ་པ་བཞིན་ནོ་ཞེས་འདོད་དོ།",
    "དང་པོ་ལའང་གཉིས་ལས་གསལ་ཞིང་རིག་པའི་རྟགས་ཀྱིས་སྣང་བ་སེམས་སུ་སྒྲུབ་པར་མི་ནུས་པ་ནི་ཤེས་པའི་མཚན་ཉིད་གསལ་ཞིང་རིག་པ་མ་ཡིན་ཏེ།",
    "འདོད་པར་ཡང་མི་ནུས་ཏེ།",
    "དེ་ལྟ་ན་སྔོ་ལྷང་ངེ་བ་འདི་ཉིད་འཛིན་ཆ་ཤེས་པ་དང་གཅིག་ཡིན་པར་འདོད་པར་འགྱུར་ལ།",
    "སིམ་གདུང་ལ་སོགས་པར་མ་དམིགས་ཀྱང་ཤེས་པ་ཡིན་ན་ཅི་སྟེ་ཁྱབ་པ་མེད་དོ་ཞེ་ན།",
    "ས་ཕྱོགས་རྐྱང་པ་འབའ་ཞིག་པར་ཡོངས་གཅོད་ལ་གྲུབ་པ་ན་བུམ་པ་དང་བཅས་པ་རྣམ་གཅད་ལ་ཁེགས་པས་བུམ་པ་མེད་དོ་ཞེ་ན།",
    "ཧེ་དུ་མ་གྲུབ་སྟེ་སྔོན་པོ་དམིགས་པ་ཉིད་སིམ་གདུང་ལ་སོགས་པར་དམིགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཐ་དད་མེད་པར་ངེས་པར་འགྱུར།",
    "འཁྲུལ་ན་འཁྲུལ་བའི་ཡུལ་བརྫུན་པ་དངོས་མེད་ཡིན་པའི་ཕྱིར་བདེན་པ་ཙམ་ཡང་མེད་པར་བྱེ་བྲག་བདེ་སྡུག་གཉིས་གཅིག་ཏུ་བདེན་པ་འགལ་ལ།",
    "མ་འཁྲུལ་ན་མ་འཁྲུལ་བའི་ཤེས་པས་བདེ་སྡུག་ཐ་དད་དུ་དམིགས་པས་ཐ་དད་ཉིད་དུ་བདེན་དགོས་ཀྱི་གཅིག་ཏུ་བདེན་ཐབས་མེད་དོ་ཞེས་བོད་བགྲེས་པོ་རྣམས་ཟེར་ཏེ་ཉེས་པ་དེ་ནི་སྤང་པར་ནུས་སོ།",
    "འདིར་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དེ་མ་གྲུབ་པས་གཟུང་ཆ་ཕྱི་རོལ་པ་བདེན་པར་མ་གྲུབ་ཅིང་དེ་མ་གྲུབ་པས་ན་འཛིན་ཆ་ཤེས་པ་དང་བཅས་པ་རྣམ་གཅད་ལ་མི་ཁེགས་སོ་ཞེ་ན།",
    "དེ་མ་གྲུབ་པས་སྤྱི་གཅིག་པོ་བདེན་པར་མ་གྲུབ་ཅིང་།",
    "འདིར་ཡང་བདག་མ་གྲུབ་པར་བདག་ལ་བདག་ཏུ་བརྟགས་པའང་མི་འགྲུབ་བོ།",
    "འདིས་ནི་སེམས་ཙམ་སྣ་ཚོགས་གཉིས་སུ་མེད་པར་སྨྲ་བའི་རྣམ་བདེན་ཏེ།",
    "སྣང་བ་སེམས་ཡིན་ཀྱང་བུམ་པར་སྣང་བ་ལ་སོགས་པ་ནི་གཟུང་ཆས་བསྡུས་པའི་ཤེས་པ་ཡིན་ལ།",
    "ནང་ཤེས་པ་ནི་འཛིན་ཆས་བསྡུས་པའི་ཤེས་པར་འདོད་དེ།",
    "འཇོག་པར་ནུས་པའི་རྒྱུ་ཉིད་ལ།",
    "དེ་ལྟ་མ་ཡིན་པར་ཉན་ཐོས་བྱེ་བྲག་ཏུ་སྨྲ་བ་བཞིན་དུ་གཟུང་འཛིན་དུས་མཉམ་དུ་འདོད་པ་ནི་འཐད་པ་མ་ཡིན་ཏེ།",
    "དེ་ནས་བུམ་སྣང་ལ་སོགས་པ་དམིགས་པའི་ཕྲུགས་གསུམ་ཚང་བ་མེད་པས་རྒྱུ་འབྲས་མ་ཡིན་ནོ་ཞེས་མགོ་སྙོམས་པར་བྱའོ།",
    "འོ་ན་མེ་དང་མེའི་བྱས་པ་དང་མེའི་མི་རྟག་པའི་དོན་སྤྱི་སོ་སོར་ཤར་བས་གཅིག་ཡིན་པ་ལ་གནོད་དོ་ཞེ་ན།",
    "དེས་ན་ལོག་ལྟ་གཅིག་གམ་ཐ་དད་ཅེས་འདྲི་ན་གཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "རྒྱས་པར་འོག་དུ་འཆད་གཉིས་པ་བློའི་འཛིན་སྟངས་ལ་གསུམ་སྟེ།",
    "གཡོར་གཉན་ནི་ཡུལ་ལ་གཞན་སེལ་དུ་བྱས་ནས་བུམ་པ་འདི་སྣམ་བུས་དབེན་ཞེས་པ་ལྟ་བུ་ལ་འདོད་དེ།",
    "དང་པོ་ལྟར་ན་རྗེས་དཔག་རྟགས་ལ་མི་ལྟོས་པར་འགྱུར་ལ།",
    "བཞི་པ་ནི་མུན་ཁུང་ལྟ་བུར་དྲིའི་ཁྱད་པར་ལས་དུ་བ་དཔགས་པའི་ཚེ་ཡང་དུ་མེད་ཀྱི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་འཇལ་བར་འགྱུར་ལ།",
    "རྒྱུས་བསྐྱེད་དུ་མི་རུང་སྟེ་མེད་པ་ལ་མེད་པར་ཤེས་པ་ཙམ་གྱིས་རྒྱུས་བསྐྱེད་པར་མི་འགྱུར་བས་སོ།",
    "བྱས་ཡོད་ལ་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པས་ཁྱབ་པའི་ལྡོག་ཁྱབ་གྲུབ་པ་ན་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པས་སྟོང་པ་ལ་བྱས་ཡོད་ཀྱིས་སྟོང་པས་ཁྱབ་པའི་རྗེས་འགྲོའི་ཁྱབ་པའང་ཚང་བས་སོ།",
    "ཡང་སྔོན་པོར་ཡོངས་གཅོད་ལ་གྲུབ་པས་སེར་པོ་རྣམ་གཅད་ལ་མི་ཁེགས་པར་འགྱུར་ཏེ་སྔོ་མ་ཡིན་བཀག་ཙམ་གྱི་མེད་དགག་གཞལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "རྩོལ་བ་ཉིད་ཕྱིར་མི་རྟག་ཉིད་ཅེས་གསུངས་པས་བསལ་ལོ།",
    "ཕྱི་མ་ལྟར་ན་རྗེས་དཔག་རྟགས་ལ་མི་ལྟོས་པར་འགྱུར་ལ།",
    "བསྒྲུབ་བྱ་དུ་བ་མེད་པའི་མཚོ་ཞེས་པ་ནི་མེད་པས་མ་ངེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཐ་དད་ཀྱིས་སྟོང་པར་གནས་ཏེ་སྔོན་པོ་དང་སྔོན་པོའི་བྱས་པ་དང་།",
    "བློ་ལ་ཡང་ཐ་དད་མེད་པར་སྣང་པས་སོ།",
    "དུས་མཚུངས་ཅན་གྱི་རྣམ་པར་ཤེས།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་གཅིག་ལས་མེད་ཀྱང་།",
    "ཞེས་ཟེར་ཏེ་དཔྱད་པར་བྱའོ།",
    "མི་རྟག་པའི་དོན་སྤྱི་མ་ཤར་རྟག་པའི་སྒྲོ་འདོགས་མ་ཆོད་པས་དེ་ལ་ལྟོས་ནས་མི་རྟག་པ་ངེས་བྱ་མ་ཡིན་པར་བཞག་སྟེ་གཅད་བྱའི་སྒྲོ་འདོགས་ཐ་དད་པས་སོ།",
    "མི་འགལ་ན་མི་འགལ་བས་མི་འགལ་བ་དགག་དུ་མི་བཏུབ་སྟེ་དཔེར་ན་བྱས་པས་མི་རྟག་པ་དགག་ཏུ་མི་བཏུབ་པ་བཞིན་ནོ།",
    "ཀུན་རྫོབ་པའི་གཅིག་ཡིན་པ་དང་དོན་དམ་པའི་གཅིག་ཡིན་པ་གཉིས་ཀ་རྟགས་སུ་མི་འགོད་པར་ཕན་ཚུན་དབྱེར་མེད་ཀྱི་གཅིག་ཡིན་པ་རྟགས་སུ་འགོད་དོ།",
    "འདིར་ཡང་སྔོན་པོ་དང་རྫས་མི་གཅིག་པར་དོགས་ན་སྔོ་མ་ཡིན་དུ་བློས་བཟུང་བ་དེ་ལ་སྔོན་པོ་ཙམ་གྱི་སྒྲོ་འདོགས་ཀྱང་མི་སྐྱེ་བར་མི་སྣང་བའི་སྒྲོ་འདོགས་སྐྱེ་བ་འགལ་ལོ་ཞེ་ན།",
    "སྔོན་པོ་དང་རྫས་མི་ཅིག་པར་དོགས་ན་སྔོ་མ་ཡིན་དུ་དོགས་པ་ཡིན་ལ།",
    "ཡང་ན་དངོས་པོ་ཅིག་ལ་ལྡོག་པ་ཐ་དད་པ་བྱས་པ་དང་མི་རྟག་པ་ལྟ་བུ་དང་།",
    "དངོས་པོ་དང་ལྡོག་པ་གཉིས་ཀ་ཐ་དད་པ་རྟ་དང་གླང་པོ་ལྟ་བུ་སྟེ་མུ་བཞི་ཡང་བསམ་པར་བྱའོ།",
    "དང་པོ་ལའང་ཡུལ་ལ་ཕྱིན་ཅི་ལོག་དུ་འཇུག་པ་དང་ཕྱིན་ཅི་མ་ལོག་པར་འཇུག་པ་གཉིས་ལས་དང་པོ་ནི་ལོག་ཤེས་སོ།",
    "ཡོད་པ་བར་མ་ཆད་པར་དམིགས་པས་ཀྱང་བསླུས་ཏེ་ཀློག་ལྟ་བུ་སྐད་ཅིག་གཅིག་དང་པོ་ལ་བྱུང་ནས་གཉིས་པ་ལ་འགགས་ན་མི་རྟག་པར་རྟོགས་པ་ཡིན་པ་ལ་སྔོན་པོ་དེ་སྐད་ཅིག་མ་དང་པོ་དང་གཉིས་པ་ལ་སོགས་པ་ལ་ཡང་ཡོད་པས་སྐད་ཅིག་མར་མ་རྟོགས་པ་ཡིན་ནོ།",
    "འདོད་དེ་སྒྲ་རྟག་པར་འཛིན་པའི་ལྡོག་པ་ནས་ལོག་ཤེས་དང་མྱོང་བ་དང་རྟགས་ལ་མ་བརྟེན་པར་དོན་ངེས་པའི་ལྡོག་པ་ནས་ཡིད་དཔྱོད་ཀྱང་ཡིན་པས་སོ་ཞེ་ན།",
    "སྔ་མའང་འདོད་དེ་མེ་མེད་ཀྱི་སྒྲོ་འདོགས་ཆོད་པའི་ལྡོག་པ་ནས་རྗེས་དཔག་དང་མྱོང་བ་ལ་མ་བརྟེན་པར་དོན་ངེས་པའི་ལྡོག་པ་ནས་ཡིད་དཔྱོད་ཀྱང་ཡིན་པས་སོ།",
    "གསུམ་པ་ནི་དེས་ན་ཡིད་དཔྱོད་ཀྱི་མཚན་ཉིད་མྱོང་བ་དང་རྟགས་ལ་མ་བརྟེན་པར་དོན་བདེན་པ་གསར་དུ་ངེས་པའོ།",
    "དེའང་མྱོང་བ་ལ་མ་བརྟེན་པར་དོན་བདེན་པ་གསར་དུ་ངེས་པའོ།",
    "ཕྱི་མ་ལྟར་ན་དོན་བདེན་པ་ངེས་པས་ཀྱང་མ་ཁྱབ་པས་ཡིད་དཔྱོད་ཀྱི་མཚན་ཉིད་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "གཉིས་པ་ལྟར་ན་རྟོག་བཅས་གཞན་སེལ་བའི་སྒོ་ནས་འཇུག་པ་མ་ཡིན་པར་འགྱུར་ལ།",
    "གཉིས་པ་ལྟར་ན་བ་ལང་དུ་དོགས་པ་ཡང་སེལ་མི་ནུས་པར་འགྱུར་རོ།",
    "རྟོག་བཅས་ལོག་ཤེས་དང་རྟོག་མེད་ལོག་ཤེས་ཀྱི་ཁྱད་པར་ཡང་རིམ་པ་བཞིན་དུ་ཡུལ་དཔྱད་ན་ལྡོག་པ་དང་།",
    "འདི་ལ་ཡང་གསུམ་སྟེ་མཚན་ཉིད་མཚོན་བྱ་མཚན་གཞི་གསུམ་གྱི་ཐ་དད་པའི་ཁྱད་པར་བསམ་པ་དང་།",
    "དེ་ལ་རྟེན་པའི་ཉེས་པའི་རྣམ་པར་དབྱེ་བའོ།",
    "དངོས་པོ་གཅིག་ལ་ལྡོག་པས་བྱས་པའི་ཐ་དད་ཡིན་ནོ།",
    "ཡང་བ་ལང་རྫས་ཡོད་དེ་ལ་མཚན་ཉིད་ནོག་དང་ལྐོག་ཤུལ་དགོས་པ་བཞིན་དུ་ནོག་དང་ལྐོག་ཤལ་རྫས་ཡོད་ལ་ཡང་མཚན་ཉིད་གཞན་ཞིག་དགོས་པས་ཐུག་པ་མེད་པར་འགྱུར་བས་སོ་ཞེས་ལོ་ཙ་བ་ཟེར་རོ།",
    "སྒྲས་ཁྱད་པར་བྱས་པ་ནི་བཏགས་ཡོད་ཡིན་ལ།",
    "ཐ་དད་གཏན་མེད་ཀྱང་མ་ཡིན་ཏེ་ནོག་དང་ལྐོག་ཤལ་མཚན་གཞི་བ་ལང་དུ་མཚོན་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་དང་ལྡན་པ་བཀོད་པ་བཞིན་དུ་ལྡོག་པ་ཐ་དད་མེད་ནས་མི་སྲིད་པར་འགྱུར་བས་སོ།",
    "བྱས་པའི་བུམ་པ་མཚན་གཞི་བྱས་པ་ཙམ་དུ་མཚོན་རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པ་མཚན་ཉིད་དུ་བཀོད་པ་ལྟ་བུ་ཡིན་ཏེ།",
    "དེའི་རིགས་པས་རྩོལ་བ་ལས་བྱུང་བའི་སྒྲ་ལ་རྩོལ་བྱུང་ཙམ་པོ་མི་རྟེན་པར་འགྱུར་རོ།",
    "དཔྱད་བཟོད་པའི་དོན་བྱེད་པས་སྟོང་པ་བློའི་ཡུལ་དུ་བྱས་པ་དེའང་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་ཧེ་དུའི་ཐ་སྙད་དུ་བྱར་རུང་ལ་ཡང་མཚན་ཉིད་མི་དགོས་པར་འགྱུར་རོ།",
    "ཡང་ན་གཏན་མི་འཇུག་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཡང་ན་གཏན་མི་འཇུག་པར་འགྱུར་རོ།",
    "འདིས་ནི་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "དངོས་འགལ་ཡིན་ཞེས་པས་ནི་བྱས་པའི་མཚན་ཉིད་དུ་མི་རྟག་པ་བཀོད་པ་ལྟ་བུ་དོན་ལྡོག་གཞན་གྱུར་དང་།",
    "རྟག་མི་རྟག་གཉིས་དངོས་འགལ་མི་རྟག་པའི་ཁྱབ་བྱ་བྱས་པའམ་རྩོལ་བྱུང་དང་རྟག་པ་གཉིས་རྒྱུད་འགལ་ཡིན་པས་སོ།",
    "ལྔ་པ་རྫས་སུ་ཡོད་པས་མཚན་ཉིད་ལ་མི་དགོས་པར་རྟོག་པ་དགག་པ་ནི་ནོག་དང་ལྐོག་ཤལ་རྫས་ཡོད་ཡིན་པས་དེ་ལ་མཚན་ཉིད་གཞན་མི་དགོས་སོ་ཞེས་རྟོག་ན།",
    "ཕྱི་མ་ལྟར་ན་དཀར་ཟལ་མཚན་གཞིར་བཞག་ནས་བ་ལང་དུ་མཚོན་པ་ལ་ནོག་དང་ལྐོག་ཤལ་མཚན་ཉིད་དུ་བཀོད་པའི་ཚེ་ནག་སྒུར་ལ་མ་ཁྱབ་པར་འགྱུར་ཏེ།",
    "བསྒྲུབ་བྱ་དང་མཚུངས་པར་དོགས་པ་སྤངས་པ་དང་།",
    "དང་པོ་ནི་བསྒྲུབ་བྱ་ལ་གྲུབ་མ་ཟིན་པ་དང་བསལ་བ་མ་ཞུགས་པ་དང་བསྒྲུབ་པར་འདོད་པ་ཞེས་བྱ་བ་ཤེས་དགོས་པ་བཞིན་དུ།",
    "བསལ་བ་མ་ཞུགས་པ་དང་མཚོན་པར་འདོད་པ་སྨྲོས་དགོས་པར་འགྱུར་ཞེ་ན།",
    "རྟགས་ཀྱིས་དཔག་པར་བྱ་བ་ཁོ་ན་ཡིན་པའི་ཕྱིར་རོ།",
    "མཚོན་བྱ་ལ་རྟགས་ཀྱིས་དཔག་པར་བྱ་བ་ཁོ་ན་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྒྲ་མཉན་བྱ་མ་ཡིན་པར་དམ་བཅས་པ་ལྟ་བུ་གཅོད་པའོ།",
    "མཚན་གཞི་ཡིན་ན་མི་སྲིད་དུ་མི་བཏུབ་ལ་མི་སྲིད་ན་མཚན་གཞི་ཡིན་དུ་མི་བཏུབ་སྟེ་མཚན་གཞིར་བཀོད་པ་ལ་མི་སྲིད་པས་ན་མཚན་གཞི་ལ་མི་སྲིད་པར་གཞག་གོ།",
    "གཏན་ལ་འབེབས་པར་བྱེད་པའི་མཚན་གཞི་དང་།",
    "མཚན་ཉིད་དང་མཚོན་བྱ་གཏན་ལ་འབེབས་པར་བྱེད་པ་ལ་མཚན་གཞི་མི་དགོས་སོ་ཞེས་སྨྲ་ན།",
    "དེ་མ་ངེས་ན་ནག་སྒྱུར་ལྟ་བུ་ལ་ནོག་དང་ལྐོག་ཤལ་མཐོང་ཡང་བ་ལང་ཡིན་པར་མི་ངེས་སོ།",
    "ཅིས་ཀྱང་མཚན་ཉིད་དང་མཚོན་བྱའི་འབྲེལ་བ་ངེས་པ་ལ་མཚན་གཞི་གཅིག་དགོས་ན་དོན་དམ་པའི་དངོས་པོའི་མཚན་ཉིད་དཔྱད་བཟོད་པའི་དོན་བྱེད་ནུས་པ་མ་ཡིན་པར་འགྱུར་ཏེ་མཚན་གཞི་མེད་པས་སོ་ཞེ་ན།",
    "འདོད་ན་མཚན་གཞི་ཙམ་ལ་མཚན་གཞིའི་སྤྱིའི་མཚན་ཉིད་ཀྱིས་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "དེ་ལ་རྟེན་པའི་ཉེས་པའི་རྣམ་པར་དབྱེ་བ་ལ་གཉིས་ཏེ།",
    "མཚན་གཞི་ལ་རྟེན་པའི་ཉེས་པའི་རྣམ་པར་དབྱེ་བའོ།",
    "གྲངས་ཉུང་བར་ལོག་པར་རྟོག་པ་དགག་པ་དང་།",
    "གྲངས་མང་བར་ལོག་པར་རྟོག་པ་དགག་པའོ།",
    "དང་པོ་ལྟར་ན་བྱས་པའི་མཚན་ཉིད་དུ་དུས་གཉིས་པར་མི་སྡོད་པ་བཀོད་པ་དེ་སྐྱོན་ཆགས་ནས་ནི་མཚན་ཉིད་མ་ཡིན་ལ།",
    "མཚན་ཉིད་ཀྱི་སྐྱོན་ཐམས་ཅད་མི་སྲིད་པར་འདུ་ན་ཧེ་དུའི་སྐྱོན་ཐམས་ཅད་མ་གྲུབ་པར་འདུ་ཟེར་བ་ལ།",
    "ཁྱབ་པ་མ་གྲུབ་སྟེ་བུམ་པ་མ་ཡིན་པའི་གྲངས་ངེས་མི་ཤེས་ཀྱང་བུམ་པར་ཡོངས་གཅོད་ལ་གྲུབ་པས་བུམ་མ་ཡིན་རྣམ་གཅད་ལ་ཁེགས་སོ་ཞེ་ན།",
    "འོན་ཀྱང་སྐྱོན་ཅན་ལྔ་པ་ཡོད་པར་དོགས་སོ་ཞེས་ཟེར་བ་ལ།",
    "དེ་ལས་གཞན་མཚན་ཉིད་ཀྱི་སྐྱོན་དྲུག་པ་ཕན་ཆད་ཡོད་པར་རྟོགས་པ་ནི་འཐད་པ་མ་ཡིན་ཏེ།",
    "དང་པོ་ཤོས་མཚན་ཉིད་སྐྱོན་མེད་དེ་སྐྱོན་ཅན་ལྔ་ལས་གཞན་ཡོད་པར་དོགས་པ་ཁེགས་སོ་ཞེས་ཕྱི་པ་ཟེར་རོ།",
    "མཚན་གཞི་ལ་རྟེན་པའི་ཉེས་པའི་རྣམ་པར་དབྱེ་བ་ལ་གཉིས་ཏེ།",
    "མི་ཁེགས་ན་མཚན་ཉིད་ཀྱིས་མཚོན་བྱ་ལ་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "འདིར་ཡང་དུས་གཉིས་པར་མི་སྡོད་པ་ལྡོག་པ་ཆིག་རྐྱང་ལ་མཚན་གཞི་བྱས་ན་མཚན་ཉིད་མེད་ལ།",
    "མི་ཁེགས་ན་ཁྱབ་བྱེད་ཀྱིས་ཁྱབ་བྱ་ལ་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "དང་པོ་ལའང་མ་ཁྱབ་པར་བསྒྲུབ་པ་དང་།",
    "དོན་གྱི་སྐབས་སུའང་དེ་བཞིན་དུ་རིག་པར་བྱ་སྟེ།",
    "འོན་ཀྱང་དུ་ཙམ་གྱི་སྟེང་དུ་ཧེ་དུའི་ཐ་སྙད་དུ་བྱར་རུང་མཚོན་པར་འདོད་ཅིང་།",
    "དང་པོ་ལྟར་ན་རྟགས་མ་གྲུབ་རིལ་པོར་འགྱུར་ཏེ་བྱས་པ་ལ་སྒྲས་མ་ཁྱབ་པས་སོ།",
    "འོ་ན་སྒྲ་ཁོ་ན་མི་རྟག་པར་སྒྲུབ་མ་ནུས་པ་ཟེར་ན།",
    "དོན་ལྡོག་གཞན་གྱིས་དོན་ལྡོག་གཞན་མཚོན་པར་འགལ་བས་སོ།",
    "འདིར་ཡང་དོན་ལྡོག་གཞན་གྱིས་དོན་ལྡོག་གཞན་མཚོན་པར་འགལ་བས་སོ་ཞེ་ན།",
    "ཕྱི་མ་ལྟར་ན་གང་མ་ཁྱབ་པར་འདོད་པ་གཅིག་དང་མགོ་སྙོམས་པས་ཆོག་གོ།",
    "དེ་ལྟར་མ་ཡིན་པར་མི་སླུ་བ་ཡིན་ན་སྔོན་པོ་ལྟ་བུ་བཅད་ལ།",
    "ཞུགས་ཏེ་ཕྱིན་པ་ན་སྐད་ཅིག་མ་དེ་འགགས་ནས་ཐོབ་པར་མི་ནུས་པའོ།",
    "བཅད་པའི་ཡུལ་ཅན་ལ་ཡོངས་སུ་བཅད་པའི་འཇུག་ཡུལ་ཐོབ་པར་བྱེད་པའི་ནུས་པ་ཞེས་པ་མེད་པས་དེ་ལྟ་བུ་གཅད་མི་དགོས་སོ།",
    "འོ་ན་རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པའི་མཚོན་བྱ་བྱས་པ་ཡིན་ནམ་མ་ཡིན།",
    "དང་པོ་ལྟར་ན་སྤྱིར་མཚན་ཉིད་དང་མཚོན་བྱ་གཉིས་དོན་གྱི་ལྡོག་པ་ནི་ཐ་དད་མེད་ལ་དོན་དང་ཐ་སྙད་ཀྱི་ལྡོག་པ་ཐ་དད་པ་ཡིན་པས་དུས་གཉིས་པར་མི་སྡོད་པ་དང་།",
    "དེའི་ཚེ་དུས་གཉིས་པར་མི་སྡོད་པས་རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པའི་མཚོན་བྱ་བྱས་པ་དེ་མཚོན་ནམ་དེ་ལས་གཞན་མཚོན།",
    "གཞན་མཚོན་ན་དུས་གཉིས་པར་མི་སྡོད་པ་བྱས་པའི་མཚན་ཉིད་མ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ཉིད་མཚོན་ན་དུས་གཉིས་པར་མི་སྡོད་པ་དང་རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པ་གཉིས་དོན་ལྡོག་ཐ་དད་པས་རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པའི་མཚོན་བྱ་བྱས་པ་དང་དུས་གཉིས་པར་མི་སྡོད་པ་གཉིས་དོན་ལྡོག་ཐ་དད་དུ་འགྱུར་རོ་ཞེ་ན།",
    "ཡུལ་གྱི་ཁྱད་པར་ཡོངས་སུ་བཅད་པའི་འཇུག་ཡུལ་ཐོབ་པར་བྱེད་པའི་ནུས་པ་ཡིན་པ་དང་།",
    "བྱེད་པའི་ཁྱད་པར་རྟེན་ཡོངས་སུ་གཅོད་བྱེད་ཀྱི་བྱེད་པ་དང་འབྲེལ་བ་སྟེ།",
    "མངོན་སུམ་གྱི་བཟུང་བ་སྐད་ཅིག་མའང་ཐོབ་པར་ནུས་ཟེར་ན་ལན་ཅི་ཡོད།",
    "རྟོགས་པ་ཞེས་བྱ་བ་ནི་ཡུལ་དུ་བྱས་ཙམ་མ་ཡིན་ཏེ་སྣང་ལ་མ་ངེས་པ་ལའང་ཡོད་པས་སོ།",
    "དུས་མཚུངས་ཅན་གྱིས་རྣམ་པར་ཤེས།",
    "མཚན་གཞི་ལ་ལོག་པར་རྟོག་པ་དགག་པའོ།",
    "གནོད་བྱ་གནོད་བྱེད་ངོ་བོ་ཕྱིར་ཞེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡིད་དཔྱོད་བཟང་ཤོས་གཅིག་ལ་དཔྱོད་པ་ཞེས་མིང་བཏགས་པར་ཡང་དོགས་ལ།",
    "གསུམ་པ་མཚན་གཞི་ལ་ལོག་པར་རྟོག་པ་དགག་པ་ནི་གཉིས་ཏེ།",
    "ལྐོག་གྱུར་བདེན་པར་རྟོགས་པ་དེ་མྱོང་སྟོབས་ཀྱིས་ནི་རྟོགས་པ་མ་ཡིན་ལ་རྟགས་སྟོབས་ཀྱིས་རྟོགས་པ་ལ་ཚུལ་གསུམ་དང་ལྡན་པ་དགོས་སོ་ཞེ་ན།",
    "ཕྱི་མ་ལྟར་ན་རྟགས་གསུམ་དུ་མི་ངེས་པར་འགྱུར་རོ།",
    "རང་ལས་ངེས་དང་གཞན་ལས་ངེས་ཀྱི་ཁྱད་པར་རྣམ་པར་བཞག་པ་དང་།",
    "སོ་སོའི་རྣམ་པར་བཞག་པའོ།",
    "དེ་ཤེས་པ་ལའང་འཇལ་བྱེད་དེ་ཉིད་མ་ཤེས་པར་དེའི་གཞལ་བྱ་ཤེས་པ་མི་སྲིད་པས་ཡུལ་ཅན་ཤེས་པ་སྔོན་པོ་འཇལ་བྱེད་ཅེས་བྱ་བར་ཤེས་དགོས་ཏེ།",
    "རྒྱུས་བསྐྱེད་པ་ནི་བྱས་པའོ་ཞེ་ན།",
    "རང་རིག་མེད་པར་འདོད་ན་ཤེས་པའང་མེད་པར་འགྱུར་རོ།",
    "མ་ལུས་པར་ནི་གཞན་ལས་ཡིན་ཞེས་པའི་ཚུལ་གྱིས་སོ།",
    "དེའང་རྗེ་བཙུན་སྤྱོད་པ་ཞེས་བྱ་བ་སྤྱིའི་མཚན་ཉིད་ལ་ལེགས་པར་ཞུགས་པའི་བློ་གྲོས་ཅན་འགལ་འབྲེལ་གྱི་རྩ་བ་ལ་བརྟེན་ནས་མཐའ་གཞན་དུ་སྲིད་པའི་དོགས་པ་གཅོད་བྱེད་ཅེས་བྱ་བས་ངེས་ཏེ།",
    "ཞེས་པའི་ཚུལ་གྱིས་འཇུག་ཡུལ་སོ་སོར་ངེས་པ་ལ་སྒྲོ་འདོགས་མི་གཅོད་ཀྱང་སྤྱི་ནམ་མཁའ་ལྡིང་དུ་བྱས་ཕན་ཆད་མི་རྟག་ཅེས་དཔྱོད་པའི་བློས་ངེས་སོ་ཞེས་འདོད་དོ།",
    "དེ་ལྟར་ན་སྒྲ་མི་རྟག་པར་དཔྱོད་པས་ངེས་པར་འགྱུར་རོ།",
    "སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་དངོས་པོ་བསྒྲུབ་པ་ཡིན་ཡང་བྱས་པ་ཉིད་རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པའི་འབྲས་བུ་ཡིན་པས་འབྲས་རྟགས་སོ།",
    "དོན་བྱེད་པར་སྣང་བའི་མངོན་སུམ་དང་།",
    "སོ་སོའི་རྣམ་པར་བཞག་པ་ལ་གཉིས་ཏེ།",
    "ཡུལ་ལ་རྒྱབ་ཀྱི་མེ་བདེན་པར་དངོས་སུ་རྟོགས་པའི་ཚུལ་དང་།",
    "སྔ་མ་ལའང་མེ་བདེན་པར་ཡོད་པར་ངེས་པ་ན་ཡུལ་ཅན་ཤེས་པ་མེ་འཇལ་བྱེད་ཅེས་བྱ་བར་མ་ངེས་པ་འགལ་ལོ།་",
    "གཉིས་པ་གཞན་ལས་ངེས་ཀྱི་རྣམ་པར་བཞག་པ་ལ་གསུམ་སྟེ།",
    "གཞན་ལས་ངེས་པར་བྱ་བའི་ཁྱད་པར་དང་།",
    "ངེས་པར་བྱེད་པའི་ཁྱད་པར་དང་།",
    "ངེས་པར་བྱས་བའི་དོན་ཏོ།",
    "གནས་ལུགས་དང་མཐུན་པར་བློ་ལ་སྣང་བས་མི་སྣང་བ་དང་རྣམ་པ་གཞན་དུ་སྣང་བའི་སྒྲོ་འདོགས་ཆོད་ཀྱང་།",
    "དོན་བྱེད་པར་སྣང་བའི་མངོན་སུམ་གྱིས་ནགས་ཚལ་སྲེག་པ་ལ་སོགས་པར་མཐོང་བས་ཡུལ་དངོས་པོར་ཤེས་ལ།",
    "མེར་བདེན་བརྫུན་ལ་ཐེ་ཚོམ་ཟ་སྟེ་མེར་བརྫུན་པར་དོགས་པས་སོ་ཞེ་ན།",
    "སྔ་མའང་བུམ་པ་ཀུན་རྫོབ་པ་ཡིན་མིན་ལ་ཐེ་ཚོམ་ཟ་སྟེ་བུམ་པ་དོན་དམ་པའི་བདེན་པར་རྟོགས་པས་སོ།",
    "སྤྱི་གཞལ་བྱ་ཙམ་གྱིས་དོན་བྱེད་པའང་ཁྱད་པར་མི་རྟག་པའི་མཐར་ཐུག་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་སྔ་དྲོ་བྱས་པའི་རྟགས་ལས་སྒྲ་མི་རྟག་པར་དཔགས་ལ།",
    "ཡང་ཤ་པས་ཤིང་སྒྲུབ་དོན་སྒྲུབ་ཀྱི་རྟགས་སུ་མི་འགྱུར་ཏེ་དཔེར་ན་སྔོན་པོ་དང་སྐད་ཅིག་མའི་སྔོན་པོ་ལ་གཞལ་མ་གཞལ་གཉིས་བྱུང་བས་དོན་ལྡོག་ཐ་དད་ཀྱང་སྐད་ཅིག་མའི་སྔོན་པོ་ཡིན་པའི་ཕྱིར་སྔོ་ཙམ་ཡིན་ཞེས་དཔག་ཏུ་མི་རུང་སྟེ་སྐད་ཅིག་མའི་སྔོན་པོར་ངེས་ཙམ་ན་སྔོ་ཙམ་དུའང་ངེས་ཟིན་པས་ཤེས་འདོད་མེད་པ་བཞིན་དུ་ཤིང་དང་ཤ་པ་དོན་ལྡོག་ཐ་དད་ཀྱང་དོན་སྒྲུབ་ཏུ་མི་འགྱུར་ཏེ་ཤིང་ཤ་པར་ངེས་པའི་ཚེ་ཤིང་ཙམ་དུའང་ངེས་ཟིན་པས་སོ།",
    "གཞལ་བྱ་ལ་ཐ་དད་མེད་པར་འཇལ་བྱེད་ཀྱི་ཤེས་པ་གཉིས་ཡོད་པ་འགལ་ལོ་ཞེས་ཟེར་ཏེ་དེ་ནི་མ་ཡིན་ཏེ་ངེས་བྱ་དང་པོ་བཞིན་ནོ་ཞེས་གསུང་ངོ།",
    "ལུས་གྲུབ་ཀྱང་བློའི་རྣམ་པར་བཏགས་པ་ལ་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ་ཞེས་རྟགས་སུ་འགོད་པ་ཡིན་ནོ།",
    "ལ་ལ་དུ་བ་ཡོད་ཀྱང་མེར་བདེན་པར་མི་འགྲོ་ན་ཅི་སྟོ་ཟེར་ན།",
    "དེ་ལས་བྱུང་བའི་འབྲེལ་བ་ཡོད་ཀྱང་དམར་འབར་བའི་རྣམ་པ་དེ་ལས་དུ་བ་སྐྱ་བོར་ནམ་གྲུབ་ཙམ་ན་མེ་ཡོད་ཀྱི་དངོས་པོ་བདེན་པར་དོན་བྱེད་པར་སྣང་བའི་མངོན་སུམ་ཉིད་ཀྱིས་ངེས་སོ།",
    "དེས་ན་ངེས་བྱེད་ནི་མི་བསླུ་བ་ངེས་པར་བྱེད་པ་དོན་བྱེད་པར་སྣང་བའི་མངོན་སུམ་དང་།",
    "དབྱེ་བ་ངེས་པར་བསྒྲུབ་བ་དང་།",
    "དོན་བྱེད་པར་སྣང་བའི་ཡང་དག་པའི་ཤེས་པ་དང་།",
    "དེས་ན་དོན་བྱེད་པར་སྣང་བའི་ཡང་དག་པའི་ཤེས་པ་བསྟན་བཅོས་ཀྱི་ནང་དུ་དཔྱད་བྱ་མ་ཡིན་ཏེ་ཚད་།",
    "དེ་བཞིན་དུ་མཚན་ཉིད་དང་སྤྱོད་ཡུལ་དང་ཚད་འབྲས་ཀྱི་སྐབས་སུ་ཡང་དོན་བྱེད་པར་སྣང་བའི་ཡང་དག་པའི་ཤེས་པ་ཡང་རྣམ་པ་གཅིག་ཏུ་ན་དབྱེ་གཞི་ལ་ཡ་གྱལ་གཏན་ལ་དབབ་བྱ་མ་ཡིན་ནོ།",
    "གཉིས་ཀྱིས་ཁྱབ་དགོས་པ་ལས་དོན་བྱེད་པར་སྣང་བའི་ཡང་དག་པའི་ཤེས་པ།",
    "ཤེས་པར་ངེས་པས་ཀྱང་དཔྱད་མི་དགོས་སོ་ཞེས་མཚུངས་སོ།",
    "ཡང་དོན་བྱེད་པར་སྣང་བའི་ཤེས་པ་དབྱེ་གཞི་ཡིན་པ་ཁེགས་པས་དོན་བྱེད་ནུས་པ་ལ་རབ་ཏུ་འཇུག་པའི་ཤེས་པ་དབྱེ་གཞིར་འགྲུབ་ན།",
    "དོན་བྱེད་པར་སྣང་བའི་རྫས་དབྱེ་གཞི་ཡིན་པ་ནི་མ་ཁེགས་ལ་ལྡོག་པ་དབྱེ་གཞི་ཡིན་པ་ཁེགས་ཀྱང་ལྡོག་པ་ལ་དེ་གཉིས་སུ་ཁ་ཚོན་མ་ཆོད་དེ་དེ་གཉིས་སུ་འདུས་པའི་ཤེས་པ་ཙམ་པོ་ཡོད་པས་སོ།",
    "བྱས་པའི་རྫས་རྟག་པ་ལ་ཁེགས་པ་ན་བྱས་པ་ལ་མི་རྟག་པས་ཁྱབ་པ་འགྲུབ་བོ།",
    "གལ་ཏེ་ཐ་དད་ན་རྗེས་དཔག་དེ་རང་རིག་ལས་ཐ་དད་ཕྱིར་ཤེས་པ་མ་ཡིན་པར་འགྱུར་བས་སོ།",
    "དེ་ལྟ་མ་ཡིན་པར་དངོས་པོ་ཡིན་ན་རྨི་ལམ་ན་གསད་བྱའི་མི་དངོས་པོར་མེད་ཀྱང་གསོད་བྱེད་དངོས་པོར་ཡོད་པ་ཅིས་འགོག།",
    "གསད་བྱའི་མི་དངོས་པོར་མེད་པར་གསོད་བྱེད་དངོས་པོར་ཡོད་པ་འགལ་ལོ་ཞེ་ན།",
    "གཟུང་བའི་ཡུལ་མེའི་དོན་སྤྱི་དངོས་པོར་མེད་པར་དེ་འཛིན་གྱི་ཤེས་པ་དངོས་པོར་ཡོད་པའང་འགལ་ལོ་ཞེའོ།",
    "གསད་བྱའི་མི་དངོས་པོར་མེད་པར་གསོད་བྱེད་དངོས་པོར་ཡོད་པ་འགལ་ལོ།",
    "གཟུང་བའི་ཡུལ་དངོས་པོར་མེད་པར་དེ་འཛིན་གྱི་ཤེས་པ་དངོས་པོར་ཡོད་པ་འགལ་ལོ་ཞེ་ན།",
    "གཟུང་བའི་ཡུལ་སྒྲོ་བཏགས་ཀྱིས་དེ་འཛིན་གྱི་ཤེས་པ་ཁྱད་པར་དུ་བྱས་ཏེ་སྒྲོ་བཏགས་དེ་སྒྲོ་བཏགས་ཚོད་ཉིད་དུ་གནས་པས་སོ།",
    "གཞན་ཡང་གཟུང་བའི་ཡུལ་དངོས་པོར་མེད་པས་དེ་འཛིན་གྱི་ཤེས་པ་དངོས་པོར་མེད་ན་རང་རིག་ལ་གཟུང་བ་ཐ་དད་མེད་པས་དེ་འཛིན་གྱི་ཤེས་པ་མེད་པར་འགྱུར་རོ།",
    "གསུམ་པ་དབྱེ་བ་ངེས་པར་བསྒྲུབ་པ་ནི་གྲངས་ཉུང་བའི་ལོག་རྟོག་དགག་པ་དང་།",
    "གཞན་བློ་རྟོགས་པར་བྱ་ཕྱིར་དང་།",
    "གཞལ་བྱ་ཙམ་ཁེགས་པ་ན་གཞལ་བྱ་བདེན་པར་རྟོགས་པ་ཞེས་པའང་ཁེགས་པས་སོ།",
    "གཞན་དུ་རྟོགས་པར་བྱེད།",
    "དེ་ཡང་དཔེར་ན་ནོག་དང་ལྐོག་ཤལ་དང་ལྡན་པ་འདི་བ་ལང་ངོ་ཞེས་བརྡའ་ཆད་བྱས་པས་དེའི་མིང་དུ་གྲགས་པ་ལྟ་བུའོ།",
    "གཉིས་པ་ནི་ཡི་གེ་སོ་སོར་ངེས་པའི་དོན་ཕྱེ་སྟེ་འབྲུ་ནོན་བྱས་པས་མིང་འཐོབ་པ་སྟེ་ལྷས་བྱིན་པའི་ཕྱིར་ན་ལྷས་བྱིན་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "རྒྱ་གར་གྱི་སྒྲ་ལས་དྲངས་ན་འཁྲུལ་བ་དང་དོན་གཅིག་ལ་འདུ་བའི་མུ་བཞི་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་གྱི་མཚན་ཉིད་དོ།",
    "སྒྲོ་བཏགས་རྣམ་པ་ཅན་རྟོག་ཡིན་ཞེས་པ་ལྟ་བུ་ནི་མ་ཡིན་ཏེ་མངོན་སུམ་ཀྱང་རྟོག་པར་འགྱུར་བས་སོ།",
    "བརྗོད་པ་དང་འདྲེས་ཟིན་པའི་རྒན་རྒོན་གྱི་རྟོག་པ་ལ་མ་ཁྱབ་པར་ཡང་མི་འགྱུར་ཏེ།",
    "མ་འདྲེས་པས་ཁྱད་པར་དུ་བྱས་པའི་འདྲེར་རུང་ལ་མི་འདོད་པར་འདྲེས་ཟིན་པ་ལ་ཡང་ཡོད་པའི་འདྲེར་རུང་ཞེས་བྱ་བ་ལ་འདོད་པས་སོ་ཞེས་ཟེར་རོ།",
    "དེ་ལྟར་ན་ཀློག་དང་ནགས་ཀྱི་མེ་ཏོག་ལ་ཡང་མི་རྟག་པ་ཡོད་པས་རྩོལ་བྱུང་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་པར་བཟུང་ཡུལ་བདེན་པ་ལ་མངོན་སུམ་ཞེས་བརྗོད་ན་ལྗོན་ཤིང་འགྲོར་སྣང་ལ་སོགས་པའི་མངོན་སུམ་ལ་མ་ཁྱབ་ལ།",
    "མཚོན་བྱ་བྱས་པ་ནི་རྒྱུས་ཁྱད་པར་དུ་བྱས་ལ་མཚན་ཉིད་དོན་བྱེད་ནུས་པ་ནི་འབྲས་བུས་ཁྱད་པར་དུ་བྱས་པས་དོན་ལྡོག་གཞན་འགྱུར་གྱི་སྐྱོན་ཆགས་སོ་ཞེ་ན།",
    "གཉིས་པ་མངོན་སུམ་གྱི་ཁྱད་པར་གྱི་མཚན་ཉིད་ལ་གཉིས་ཏེ།",
    "འཛིན་པར་བྱེད་པའི་ཡིད་ཀྱང་ངོ།",
    "ཡང་རྣལ་འབྱོར་གྱི་མངོན་སུམ་རྒྱ་བསྐྱེད་ནས་བསྒོམས་པའི་སྟོབས་ཀྱིས་ཐོབ་པ་ཞེས་བྱ་བ་ལྟ་བུ་ལ་བྱས་ན་གཞན་གྱི་སེམས་ཤེས་པ་འདུ་ཡང་།",
    "འདིས་ནི་ཉེས་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "བཟློག་པར་རབ་དུ་སྐྱེ་བ་སྟེ།",
    "དེ་འདིར་བདག་ཉིད་རིག་པར་བརྗོད།",
    "བཟུང་ཡུལ་སྒྱུ་མ་ལྟ་བུ་ཡིན་ཏེ་ཡོངས་ཆོད་ལ་སྒྱུ་མ་ལྟ་བུར་བྱས་པས་གཟུང་དོན་ལ་མ་འཁྲུལ་བ་ཡིན་ལ།",
    "བསླད་པ་ཇི་བཞིན་གུས་པར་ནི།",
    "དེ་ནི་རང་བཞིན་ཡིན་པར་བརྗོད་ཅེས་སོ།",
    "ཡང་སྐྱེ་བ་ཕྱི་མ་གྲུབ་ན་ཡང་ཕྱི་ལ་སོགས་པ་ལ་ཤེས་པ་ཕྱི་མ་སྐྱེད་ངེས་ཀྱིས་ཁྱབ་པར་ཅིས་གྲུབ་ཅེ་ན།",
    "དེས་ན་ཤེས་པ་ཙམ་ལ་ཤེས་པ་ཕྱི་མ་སྐྱེད་ངེས་ཀྱིས་ཁྱབ་པར་མངོན་སུམ་གྱིས་ཤུགས་ལས་ངེས་སོ་ཞེས་ཀྱང་ཟེར་རོ།",
    "སྔར་བྱས་པ་འབད་པ་ལའང་མི་ལྟོས་ལ།",
    "ཚུར་ཤོག་བྱ་རྒོད་སྟེན་པར་གྱིས།",
    "དངོས་པོ་ཐ་དད་པར་འགྱུར་བས་སོ།",
    "དེའི་ཕྱིར་མཚན་ཉིད་ཀྱིས་མཚོན་བྱ་རྣམ་པར་བཞག་པའོ།",
    "བྱས་ཤིང་མི་རྟག་པའི་མཚན་ཉིད་དུ་རྒྱུས་བསྐྱེད་ཅིང་དུས་གཉིས་པར་མི་སྡོད་པ་བཀོད་ཀྱང་སྐྱོན་དུ་མི་ཆེ་བ་བཞིན་ནོ་ཞེས་ཕྱི་པ་ཟེར་རོ།",
    "དེས་ན་གཞུང་རིགས་ཐིགས་སུ་རྗེས་སུ་དཔག་པར་བྱ་བ་ལ་ཡོད་པ་ཉིད་དང་།",
    "སྐབས་སུ་བབ་པའི་དོན་གྱི་ཁྱད་པར་ཉེ་བར་བཟུང་བའི་དགོས་པའོ།",
    "ཞར་ལ་མཚན་ཉིད་པ་དང་བཏགས་པ་བའི་ཁྱད་པར་རྣམ་པར་གཞག་པའོ།",
    "ཁྱབ་པར་བྱེད་པའི་ཁྱབ་པ་ནི་མེ་ལྟ་བུ་ཡིན་ནོ།",
    "ཡང་ལ་མེ་ལྡན་གྱི་ཚོགས་དོན་མཚན་གཞིར་བཞག་ནས་བསྒྲུབ་བྱའི་ཐ་སྙད་དུ་བྱར་རུང་དུ་མཚོན་པ་ལ་སྔར་གྱི་བློ་ལ་ལྟོས་ནས་གྲུབ་བསལ་མེད་ལ་སྒྲུབ་འདོད་ཞེས་བྱ་བ་མཚན་ཉིད་དུ་བཀོད་པ་ལ་མཚན་ཉིད་ལ་ཡང་མཚོན་བྱས་ཁྱབ་ལ་མཚོན་བྱ་ལ་ཡང་མཚན་ཉིད་ཀྱིས་ཁྱབ་བོ་ཞེས་རིགས་ཀྱི་སྤྱི་འབྲེལ་ངེས་པར་བྱེད་པ་ནི་བསྒྲུབ་བྱའི་མཚན་ཉིད་གཏན་ལ་འབེབས་པའི་གནས་སྐབས་ཡིན་ལ།",
    "ཡང་ཧེ་དུའི་ཐ་སྙད་དུ་བྱེད་པ་དང་ཁྱབ་པའི་དངོས་པོ་དང་བསྒྲུབ་བྱའི་ཐ་སྙད་དུ་བྱེད་པའི་གནས་སྐབས་གསུམ་ལ་ཡང་སྒྲའི་དོན་བསམ་མི་དགོས་ཏེ་སྔར་མཚན་ཉིད་དང་མཚོན་བྱའི་འབྲེལ་བ་ངེས་ན་སྒྲ་ལོག་པར་འཇུག་དགོས་མེད་པས་བསམ་མི་དགོས་ལ།",
    "འདི་གསུམ་ཁོ་ན་ལ་རྗེས་སུ་དཔག་བྱ་ཞེས་བརྗོད་ལ་གཞན་ལ་མི་བརྗོད་པ་ནི་སྒྲའི་དོན་ལ་གྲགས་པས་རྣམས་པར་བཅད་ནས་འཇུག་པའི་ཕྱིར་ཏེ།",
    "ཟློས་པར་འགྱུར་བས་སོ།",
    "མཚན་ཉིད་རྗེས་སུ་དཔག་བྱ་ལ་ཡོད་པ་ཞེས་བྱ་བ་ནི་ལ་མེ་ལྡན་གྱི་ཚོགས་དོན་གྲུབ་ཟིན་པ་ལ་ཡོད་པར་རྗོད་ན་མ་གྲུབ་པའི་སྒྲུབ་བྱེད་ཡིན་ན་གྲུབ་ཟིན་དུ་འགལ་ལ་གྲུབ་ཟིན་ན་མ་གྲུབ་པའི་སྒྲུབ་བྱེད་དུ་འགལ་བས་སོ།",
    "ཕྱི་མ་ལྟར་ན་ལ་མེ་ལྡན་གྱི་ཚོགས་དོན་ཉིད་མ་གྲུབ་པར་རྗེས་སུ་དཔག་བྱ་ལ་ཡོད་པ་ཞེས་བྱ་བ་མི་འགྲུབ་ལ།",
    "ཞར་ལ་མཚན་ཉིད་པ་དང་བཏགས་པ་བའི་ཁྱད་པར་རྣམ་པར་གཞག་པ་ཡང་ལ་རྐྱང་ལ་རྗེས་སུ་དཔག་བྱ་ཞེས་བརྗོད་པ་དང་།",
    "གཉིས་པ་སྐབས་སུ་བབ་པའི་ཁྱད་པར་ཉེ་བར་བཟུང་བ་ལ་གཉིས་ཏེ།",
    "དཔེར་ན་ཨུད་པ་ལ་མང་པོ་བརྩེགས་པ་ལ་མདའ་རྒྱབ་ཙམ་ན་བློས་དུས་གཅིག་ལ་ཕུག་པ་སྙམ་བྱེད་ཀྱང་རིམ་གྱིས་ཕུག་པ་བཞིན་ནོ་ཞེས་གསུངས་སོ།",
    "དེ་ཡང་མ་ཡིན་ཏེ་མེ་ཡིད་དཔྱོད་ཀྱི་ངེས་པ་དང་མེ་ལ་བློ་ཁ་མ་ཕྱོགས་པ་དང་མེ་ཡོད་པ་ལ་མེ་ཡོད་ཅེས་ལོག་པར་རྟོགས་པ་དེ་དག་ལ་ཡང་དུ་བ་ཡོད་པའི་ཕྱིར་མེ་ཡོད་ཅེས་རྗེས་དཔག་སྐྱེད་དུ་རུང་ཡང་ཐེ་ཚོམ་ཟ་བ་མེད་པས་མ་ཁྱབ་བོ་ཞེས་ཟེར་ཏེ།",
    "གྲུབ་ཟིན་ནས་ཤེས་འདོད་མེད་པ་སྒྲ་མཉན་བྱ་ཡིན་ཏེ་བྱས་པའི་ཕྱིར་ཅེས་པ་དང་།",
    "བསལ་བ་ཞུགས་ནས་ཤེས་འདོད་མེད་པ་དེ་ལས་བཟློག་པ་གཉིས་ནི་ཤེས་འདོད་འཇུག་པར་འགལ་བས་ཤེས་འདོད་མ་ཡིན་གྱི།",
    "ནོག་དང་ལྐོག་ཤལ་ཅན་ལ་བ་ལང་ཞེས་མིང་བཏགས་པར་འདྲ་ཡང་དོན་སྒྲོ་བཏགས་དགོས་པ་དང་མི་དགོས་པའི་ཁྱད་པར་གྱིས་བཏགས་པ་བ་དང་མཚན་ཉིད་པ་བཞིན་ནོ།",
    "འོ་ན་སྔ་མའང་མི་ཟློས་ཏེ་མཐུན་ཕྱོགས་ཉིད་ལ་ཡོད་ཅེས་བྱས་པས་ཚོགས་པའི་སྤྱི་ལ་ཡོད་པར་བསྟན་ལ།",
    "ཚོགས་པའི་སྤྱི་ལ་ཡོད་པར་བསྟན་པ་ལ་བྱེ་བྲག་ལ་མེད་པ་འགལ་ལོ།",
    "རིགས་ཀྱི་སྤྱི་ལ་ཡོད་པར་བསྟན་པ་ལ་བྱེ་བྲག་ལ་མེད་པ་འགལ་ལོ་ཞེ་ན།",
    "དེའི་ཕྱིར་རྣམ་འགྲེལ་ལས་ཁྱད་པར་གཞན་ནི་སྤོང་བ་དང་།",
    "མ་ཆོད་ན་རྟགས་མི་མཐུན་ཕྱོགས་ལ་བཀག་པས་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་མི་འགྲུབ་པར་འགྱུར་ལ།",
    "ཤེས་འདོད་འཇུག་པར་འགལ་ནས་ཤེས་འདོད་མེད་པ་དང་།",
    "སྤྱིར་ཤེས་འདོད་འཇུག་པར་མི་འགལ་ཡང་ད་ལྟ་དངོས་སུ་ཤེས་འདོད་མེད་པའོ།",
    "དང་པོ་ལ་གཉིས་ལས་གྲུབ་ཟིན་ནས་ཤེས་འདོད་མེད་པ་ནི་སྒྲ་མཉན་བྱ་ཡིན་ཏེ་བྱས་པའི་ཕྱིར་ཞེས་པ་ལྟ་བུའོ།",
    "བསལ་བ་ཞུགས་ནས་ཤེས་འདོད་མེད་པ་ནི་སྒྲ་མཉན་བྱ་མ་ཡིན་ཏེ་བྱས་པའི་ཕྱིར་ཞེས་པ་ལྟ་བུའོ།",
    "ལོག་པར་རྟོག་པ་དང་།",
    "སྒྲ་གཞལ་བྱ་ཡིན་པའི་ཕྱིར་མི་རྟག་ཅེས་དཔགས་པའི་ཚེ་གཞལ་བྱ་མཚན་གཞི་ཧེ་དུའི་ཐ་སྙད་དུ་བྱར་རུང་དུ་མཚོན་ཚུལ་གསུམ་དང་ལྡན་པ་མཚན་ཉིད་དུ་བཀོད་པའི་ཚེའང་མཚན་གཞི་ཕྱོགས་གཅིག་ལ་མཚན་ཉིད་མི་སྲིད་པར་འདོད་ན་ཉེས་པ་ཅི་ཡོད།",
    "དེ་ལྟ་ན་དཀར་ཟལ་མཚན་གཞི་བ་ལང་དུ་མཚོན་ནོག་དང་ལྐོག་ཤལ་མཚན་ཉིད་དུ་བཀོད་པའི་ཚེའང་ནག་སྒྱུར་གྱི་ནོག་དང་ལྐོག་ཤལ་གྱིས་དཀར་ཟལ་ལ་མ་ཁྱབ་པས་མཚན་གཞིའི་ཕྱོགས་གཅིག་ལ་མ་ཁྱབ་པར་འདོད་པ་སུན་ཇི་ལྟར་འབྱིན།",
    "བྱེ་བྲག་བྲག་སྒྲ་ལ་རྩོལ་བྱུང་བཀག་པས་སྤྱི་སྒྲ་ཙམ་ལ་རྩོལ་བྱུང་མི་ཁེགས་ཏེ་ལྷས་སྦྱིན་ལ་གོས་སྔོན་པོ་བཀག་པས་མི་ཙམ་ལ་གོས་སྔོན་པོ་དགག་པར་མི་ནུས་པ་བཞིན་ནོ་ཞེས་མགོ་མཚུངས་སོ།",
    "བུམ་པ་རྟག་པར་དམ་བཅས་པ་ལ་བསལ་ལ་སྒྲ་རྟག་པར་དམ་བཅས་པ་ལ་དེ་ཉིད་ཀྱི་ཚེ་སེལ་མི་ནུས་པ་ལྟ་བུ་དང་།",
    "དྲིལ་བུའི་སྟེང་དུ་མཉན་བྱ་ལ་མི་རྟག་པས་ཁྱབ་པ་ངེས་པའི་ཚེ་རྩོད་གཞི་སྒྲ་ཉིད་ཀྱང་མི་རྟག་པར་ངེས་པས་ཤེས་འདོད་མེད་དོ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་པར་དུ་བ་ཡོད་པ་ལ་མེ་ཡོད་པས་ཁྱབ་པ་གྲུབ་ཀྱང་ལའི་དུ་བ་ལ་མེ་ཡོད་པས་ཁྱབ་པ་མི་འགྲུབ་ན།",
    "དངོས་པོ་ངེས་པའི་བློ་དང་མཚན་ཉིད་ངེས་པའི་བློའི་ཁྱད་པར་ཡང་ཡུལ་དུས་སོ་སོར་ངེས་པ་ལ་དགག་བསྒྲུབ་བྱེད་པ་དང་མི་བྱེད་པ་ལས་རྣམ་པར་དབྱེའོ།",
    "དེའང་འདོད་ན་བྱས་པ་ལ་མི་རྟག་པས་ཁྱབ་པ་གྲུབ་ཀྱང་བྱས་པ་རྟག་པའི་སྟེང་དུ་མི་ཁེགས་པས་རྗེས་འགྲོའི་ཁྱབ་པ་སྐྱོན་མེད་དུ་ངེས་ཀྱང་མི་མཐུན་ཕྱོགས་ལས་རྟགས་མི་ལྡོག་པར་འགྱུར་རོ།",
    "ཁྱབ་པར་ཡོད་པ་ནི་མི་འགྲུབ་སྟེ་མཉན་བྱའི་ཡོད་པ་ཉིད་གཏན་ཡུལ་དུ་མ་བྱས་པས་སོ།",
    "ཕྱིས་མཉན་བྱའི་ཡོད་པས་ཡུལ་དུ་བྱས་ནས་དེ་ལ་མི་རྟག་པས་ཁྱབ་པ་ངེས་པའི་ཚེ་བསྒྲུབ་བྱ་སྒྲ་ཡང་མི་རྟག་པར་ངེས་ཟིན་པའི་ཕྱིར་རོ།",
    "དགག་བྱ་དོན་དམ་པའི་དངོས་པོ་ཉིད་བཀག་པའི་སྒོ་ནས་དེ་ལ་རྟགས་མི་འཇུག་པར་ངེས་པས་གཅིག་དང་དུ་བྲལ་ལ་སྟོང་པ་ཉིད་ཀྱིས་ཁྱབ་ཅེས་པའི་རྗེས་འགྲོའི་ཁྱབ་པ་ངེས་ཏེ་དཔེར་ན་ཤེས་བྱ་ལ་རྟག་མི་རྟག་གཉིས་སུ་ཁ་ཚོན་ཆོད་པས་བྱས་ཡོད་རྟག་པའི་སྟེང་དུ་བཀག་པ་ན་བྱས་ཡོད་ལ་མི་རྟག་པས་ཁྱབ་པ་འགྲུབ་པ་བཞིན་ནོ།",
    "འདི་ནི་མཉན་བྱའི་ཡོད་པ་ལ་མི་རྟག་པས་ཁྱབ་པ་ངེས་པ་ན་བསྒྲུབ་བྱ་མི་རྟག་པར་ཡང་ངེས་ཟིན་པས་ཤེས་འདོད་མེད་པར་ག་ལ་མཚུངས་ཞེས་ཟེར་རོ།",
    "བྱས་པའི་རྟགས་འདི་ཡང་མི་མཐུན་ཕྱོགས་མི་རྟག་པ་ལ་མཐོང་མ་མཐོང་གཉིས་སོ།",
    "མི་མཐུན་ཕྱོགས་ལ་རྟགས་མཐོང་ན་བྱས་པ་དང་མི་རྟག་པ་གཉིས་རང་བཞིན་འབྲེལ་བར་ངེས་མ་ངེས་གཉིས་ལས།",
    "བྱས་པ་དང་མི་རྟག་པ་གཉིས་རང་བཞིན་འབྲེལ་བར་ངེས་ན་ནི་འགལ་བའོ།",
    "གཉིས་པ་ནི་འོ་ན་ནམ་མཁར་སྣང་ཙམ་དང་མ་བྱས་བ་འགལ་ལམ་མི་འགལ།",
    "ནམ་མཁར་སྣང་ཙམ་དང་མ་བྱས་པ་མི་འགལ་བས་ཉེས་པ་དང་པོ་ལས་གྲོལ་ལ།",
    "གཉིས་པ་དེ་སུན་དབྱུང་བ་ནི་དཀར་ཟལ་མཚན་གཞི་རྟར་མཚོན་ནོག་དང་ལྐོག་ཤལ་དང་ལྡན་པ་མཚན་ཉིད་དུ་བཀོད་པ་ན་སྤྱིར་མཚོན་བྱ་ལ་མི་སྲིད་པ་ཡིན་པ་ལ་མཚན་གཞི་ལ་མི་སྲིད་པར་འདོད་པ་ཅིས་འགེགས།",
    "ནམ་མཁར་སྣང་ཙམ་མ་བྱས་པའི་རྟགས་ཀྱིས་འགོག་གམ།",
    "དང་པོ་ནི་དངོས་པོར་གྱུར་པའི་ནམ་མཁའ་དང་བྱས་པས་སྟོང་པའི་ཧེ་དུ་གཉིས་འགལ་ལམ་མི་འགལ།",
    "གྲུབ་པ་ལྟར་ན་དགག་པར་མི་ནུས་ཤིང་མི་རྟག་པས་སྟོང་པའི་དམ་བཅའ་ལ་ཡང་བསལ་ལ།",
    "འདི་ཡང་བློ་ལ་ལྟོས་ནས་གསུམ་དུ་འགྱུར་ཏེ་བྱས་པའི་རྟགས་དེ་མཐུན་ཕྱོགས་མི་རྟག་པ་ལ་མཐོང་མ་མཐོང་གཉིས་ལས་མ་མཐོང་ན་མཐུན་ཕྱོགས་ལ་རྟགས་ཡོད་ཀྱང་མ་མཐོང་མི་མཐུན་ཕྱོགས་ལ་རྟགས་མེད་ནས་མ་མཐོང་བས་གཉིས་ཀ་ལ་ཐེ་ཚོམ་ཟ་བའི་མ་ངེས་པར་འགྱུར་ཏེ།",
    "བྱས་པ་དང་མི་རྟག་པ་ལྟ་བུ་རང་བཞིན་འབྲེལ་བ་ཡིན་ཏེ་འགལ་བའང་དེ་ལྟར་ཤེས་པར་བྱའོ།",
    "སྒྲ་རྟག་སྟེ་བྱས་པའི་ཕྱིར་ཞེས་བཀོད་པའི་ཚེ་མི་མཐུན་ཕྱོགས་ལ་རྟགས་མ་མཐོང་ན་དངོས་པོ་ལ་མི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པ་དང་།",
    "དེས་ན་ངེས་པ་ཉེ་དུའི་མཚན་ཉིད་དུ་འདོད་པ་ལྟར་ན་ཧེ་དུ་དང་ཧེ་དུ་ལྟར་སྣང་རྣམ་པར་དབྱེ་བ་བཅོ་བརྒྱད་དོ།",
    "འོ་ན་ངེས་པ་རྟགས་ཀྱི་མཚན་ཉིད་དུ་འདོད་པ་དང་ངེས་རུང་ཧེ་ངུའི་མཚན་ཉིད་དུ་འདོད་པའི་ཁྱད་པར་གང་ཡིན་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་པར་ངེས་པ་ཧེ་དུའི་མཚན་ཉིད་དུ་འདོད་པ་མི་འཐད་དེ།",
    "ཐམས་ཅད་མཚན་ཉིད་ཡིན་པར་འགྱུར།",
    "ངེས་པར་རྣམ་གཅད་ཡོད་མིན་ཏེ།",
    "ཕྱི་མ་ལྟར་ན་ངེས་པ་ཐེ་ཚོམ་ཟ་བའི་ཧེ་དུ་ལྟར་སྣང་གཅོད་མི་ནུས་པར་འགྱུར་ལ།",
    "ས་བོན་ལྟ་བུ་དེས་མྱུ་གུ་སྔོན་པོ་སྐད་ཅིག་དང་པོ་ལ་མི་སྐྱེད་པར་གསུམ་པ་དང་བཞི་པ་ལ་རིམ་གྱིས་སྐྱེད་ཀྱང་རིམ་གྱིས་དོན་བྱེད་པ་རྟག་པར་འདོད་པ་ལ་ཉེས་པ་ཅི་ཡོད།",
    "ནོག་དང་ལྐོག་ཤལ་དང་ལྡན་པར་ངེས་སོ་ཤེ་ན།",
    "དུ་བ་ཚུལ་གསུམ་དང་ལྡན་པར་ངེས་སོ་ཞེ་ན་བསྒྲུབ་བྱ་བསྒྲུབ་ནུས་གཅིག་ཐེ་ཚོམ་ཟ་བ་འདི་ལ་ཡང་ཡོད་པས་ངེས་པ་སྨྲོས་མི་དགོས་སོ།",
    "བྱེ་བྲག་ཐགས་འཁན་གྱི་རྩོལ་བྱུང་བཀག་པས་སྤྱི་རྩོལ་བྱུང་ཙམ་པོ་མི་ཁེགས་ཏེ་ཤ་པ་བཀག་པས་ཤིང་ཙམ་མི་ཁེགས་པ་བཞིན་ཡིན་པས་སྐྱེས་བུ་སུ་ལ་ལྟོས་ནས་ཀྱང་རྫ་མ་ཅན་གྱི་རྩོལ་བྱུང་དགག་པར་མི་ནུས་སོ་ཞེ་ན།",
    "དེ་ཉིད་དུ་ངེས་ན་བསྒྲུབ་བྱ་མི་རྟག་པའང་ངེས་པར་འགྱུར་ལ།",
    "སྔ་མ་ནི་མཚན་ཉིད་སྐྱོན་མེད་ཡིན་པས་འདོད་པར་མི་ནུས་པས་མི་མཚུངས་སོ།",
    "དེའང་འདོད་ན་གྲུབ་པ་བསྒྲུབ་པ་དང་མངོན་གྱུར་རྟགས་ལ་ལྟོས་པར་འགྱུར་རོ།",
    "གཞན་ཡང་གྲུབ་ཟིན་པ་བསྒྲུབ་བྱ་ཡིན་ན་རྫས་ཡོད་མཚོན་བྱ་ཡིན་ནོ་ཞེས་པ་ལ་སོགས་པའི་སྐྱོན་བརྗོད་དེ་ཉེས་པ་དེ་དག་ཡོད་དམ་མེད་བསམ་པར་བྱའོ་ཞེས་གསུང་ངོ།",
    "ཡོད་དང་མེད་ལ་མེད་པར་ནི།",
    "ཡང་འགལ་བ་མི་འཁྲུལ་བ་གཅོད་པ་ལ་བརྗོད་པར་འདོད་པའི་གྲངས་གཅིག་པ་ཅན་ཞེས་བྱ་བ་སྨྲོས་དགོས་ཏེ།",
    "འདི་ཡང་མ་ཡིན་ཏེ་དེ་ལྟར་ན་ཚུལ་གསུམ་གྱི་སྟེང་དུ་རྟགས་པའི་དངོས་པོ་མ་ཡིན་པ་ཞེས་སྨྲོས་དགོས་པར་འགྱུར་རོ།",
    "འོ་ན་སྤྱི་གཅིག་ཡོད་པ་དང་མེད་པར་བསྒྲུབ་པའི་རྟགས་མཐོང་བས་གནོད་དོ་ཞེ་ན།",
    "མི་མཐུན་ཕྱོགས་ལ་ཁྱབ་པར་མེད་པའམ།",
    "མི་མཐུན་ཕྱོགས་ལ་ཁྱབ་པར་མེད་པའམ།",
    "གཞན་ཡང་དུ་བའི་རྒྱུ་ནུས་པ་ཐོགས་མེད་ཡོད་པའི་ཕྱིར་དུ་བའི་རྟགས་ཡོད་ཅེས་པའི་རང་བཞིན་གྱི་རྟགས་ལ་ཡང་མ་ཁྱབ་བོ་ཞེས་ཕུ་པ་ཟེར་ཏེ་དཔྱད་པར་བྱའོ་ཞེས་གསུང་ངོ།",
    "དེའང་འདོད་ན་བྱས་པའི་མཚན་ཉིད་དུ་རྒྱུས་བསྐྱེད་ཅིང་དོན་བྱེད་ནུས་པ་ཡིན་པ་ཅི་འགོག།",
    "བྱས་པ་ཡང་ཕལ་ཆེར་མངོན་སུམ་གྱིས་གྲུབ་སྟེ་སྒྲ་ལྟ་བུ་བྱེད་བཞིན་པར་མངོན་སུམ་གྱིས་གྲུབ་པ་ན་བྱས་པ་ཡང་མངོན་སུམ་གྱིས་གྲུབ་པས་སོ།",
    "འདིའི་ཁྱབ་པ་ནི་བཟློག་པ་ལས་ཤེས་ཏེ་དཔེ་བུམ་པའི་སྟེང་དུ་བྱས་ཡོད་ལ་རིམ་གྱིས་དོན་བྱེད་པར་ཡོངས་སུ་གཅོད་ལ་ཅིག་ཅར་གྱིས་དོན་བྱེད་པ་རྣམ་གཅད་ལ་ཁེགས་ཏེ་དེས་གཉིས་ཀ་ཡིན་པའི་ཕུང་གསུམ་སེལ་ལ་ཅིག་ཅར་གྱི་དོན་བྱེད་པ་རྣམ་གཅད་ལ་ཁེགས་ཙམ་ན་རིམ་གྱིས་དོན་བྱེད་པར་ཡོངས་གཅོད་ལ་གྲུབ་ལ་དེས་གཉིས་ཀ་མ་ཡིན་པའི་ཕུང་གསུམ་སེལ་བས་བྱས་ཡོད་ལ་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པས་ཁྱབ་བོ་ཞེས་ངེས་པ་ན་ཁྱབ་བྱ་ལོག་པ་ཁྱབ་བྱེད་ཁྱབ་བྱེད་ལོག་པ་ཁྱབ་བྱ་ཡིན་པས་རིམ་དང་ཅིག་ཅར་གྱི་དོན་བྱེད་པ་སྟོང་པ་ལ་བྱས་ཡོད་ཀྱིས་སྟོང་པས་ཁྱབ་པའི་རྗེས་འགྲོ་ངེས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་མ་ཡིན་པར་བློ་གཉིས་ཀྱིས་ངེས་དགོས་ན་བུམ་པ་ཤེས་བྱ་མ་ཡིན་པ་འགེགས་པ་ལ་ཤེས་བྱ་མ་ཡིན་པ་ལ་དམིགས་པའི་བློ་དགོས་སོ།",
    "བུམ་པ་ཤེས་བྱར་ཡོངས་གཅོད་ལ་གྲུབ་པ་ན་དེ་ཉིད་ཀྱིས་ཤེས་བྱ་མ་ཡིན་པར་རྣམ་གཅད་ལ་ཁེགས་པས་ཤེས་བྱ་མ་ཡིན་པ་ལ་དམིགས་པའི་བློ་མི་དགོས་སོ་ཞེ་ན།",
    "འདིར་ཡང་དེ་ལྟར་བརྗོད་པར་བྱ་སྟེ་སྔ་མ་བཞིན་ནོ།",
    "འདིར་ནི་ཡོད་པ་རྟག་པའི་སྟེང་དུ་ཁེགས་ཀྱང་ཡོད་པ་ལ་མི་རྟག་པས་ཁྱབ་པ་མི་འགྲུབ་སྟེ་རང་རིག་མངོན་སུམ་གྱིས་དེ་གཉིས་བདག་གཅིག་པར་དྲན་པ་མེད་པས་སོ་སྙམ་ན།",
    "དེའི་ཕྱིར་རྟག་པར་ཡོངས་གཅོད་ལ་གྲུབ་པ་དངོས་འགལ་དང་དངོས་འགལ་གྱིས་ཁྱད་པར་དུ་བྱས་པའི་བརྒྱུད་འགལ་ཁེགས་ཀྱི་དེ་གཉིས་ཀ་མ་ཡིན་པའི་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པ་མི་ཁེགས་སོ།",
    "དང་པོ་ནི་རང་རིག་མངོན་སུམ་ལ་རྟག་པའི་སྒྲ་དོན་གྱི་ཁྱད་པར་དུ་བྱས་པ་སྣང་ན།",
    "བློ་དོན་དམ་པའི་བདེན་པ་འཛིན་བྱེད་དོ་ཞེས་བྱ་བར་གྲུབ་ཀྱང་འཛིན་བྱེད་མ་འཁྲུལ་བར་མ་གྲུབ་པས་དེའི་ཡུལ་བདེན་པར་མ་གྲུབ་ལ་དེ་མ་གྲུབ་པས་ཀུན་རྫོབ་ཀྱི་བདེན་པ་རྣམ་གཅད་ལ་མི་ཁེགས་ཏེ།",
    "ཡིན་ཀུན་རྫོབ་ཡིན་ཡང་དོན་དམ་གྱི་རྣམ་པའི་ཆ་བྱད་དུ་བྱས་པའི་ཀུན་རྫོབ་དེ་ལྟ་བུ་མི་ཁེགས་པས་སོ།",
    "འདིར་ཡང་བློ་སྐད་ཅིག་མ་མ་ཡིན་པའི་འཛིན་བྱེད་དོ་ཞེས་བྱ་བར་གྲུབ་ཀྱང་འཛིན་བྱེད་མ་འཁྲུལ་བར་མ་གྲུབ་པས་དེའི་ཡུལ་སྐད་ཅིག་མ་མ་ཡིན་པ་བདེན་པར་མ་གྲུབ་ལ་དེ་མ་གྲུབ་པས་སྐད་ཅིག་མ་རྣམ་གཅད་ལ་མི་ཁེགས་ཏེ་སྐད་ཅིག་མའི་རྣམ་པ་ཅན་གྱི་སྐད་ཅིག་ཁེགས་ཀྱང་།",
    "འདི་ནི་ཤེས་བྱ་མ་ཡིན་པའི་སྒྲ་དོན་དང་དངོས་པོའི་སྒྲ་དོན་ལ་ཤེས་བྱ་དང་དངོས་མེད་མི་ཁེགས་པ་ལ་སོགས་པ་ལའང་ཤེས་པར་བྱའོ།",
    "མེ་སྒྲུབ་ཏུ་བྱས་པ་ཡང་མི་འགྱུར་ཏེ་དུ་བ་ནི་མཐོང་ལ་མེ་ནི་ཆ་ཕྲ་བའམ་ཉི་མའི་འོད་ཟེར་གྱིས་ཟིལ་གྱིས་མནན་པས་མ་ངེས་པ་ལ་སྣང་བའི་ཆ་ལ་རྒྱུའི་ངོ་བོ་དཔོག་པའི་རྗེས་དཔག་དགོས་པས་སོ།",
    "མེ་དམིགས་པ་མི་དགོས་ན་ལའི་སྟེང་དུ་མེ་དུད་རྒྱུ་འབྲས་སུ་ངེས་པར་འགྱུར་ཞིང་།",
    "དུ་བ་དམིགས་པ་མི་དགོས་ན་མགར་གྱི་སོ་མལ་དུའང་མེ་དུད་རྒྱུ་འབྲས་སུ་ངེས་པར་འགྱུར་རོ།",
    "མི་དམིགས་པའི་ཁྱབ་པ་ངེས་པར་བྱེད་པའི་ཚུལ་ལ་གཉིས་ཏེ།",
    "བྱས་པའི་ཕྱིར་རྟག་པས་སྟོང་ཞེས་བརྒྱུད་འགལ་རྟགས་སུ་འགོད་ནའང་དགག་བྱ་རྟག་པ་དེ་དང་འགལ་བ་མི་རྟག་པ་དེའི་ཁྱབ་བྱ་བྱས་པ་དམིགས་པ་ཡིན་པས་རང་བཞིན་འགལ་བས་ཁྱབ་པ་དམིགས་པ་ཡིན་པས་སོ།",
    "དེ་དང་འགལ་བ་མི་རྟག་པ་དེའི་ཁྱབ་བྱ་བྱས་པ་དམིགས་པས་ཁྱབ་བྱེད་འགལ་བས་ཁྱབ་པ་དམིགས་པ་ཡིན་ཞིང་།",
    "ཁྱབ་བྱེད་འགལ་བ་ཡང་ཡིན་ཏེ་དགག་བྱ་རྟག་པའི་དངོས་པོ་དེ་ལ་མ་བྱས་པས་དེ་དང་འགལ་བ་བྱས་པ་རྟགས་སུ་བཀོད་པས་སོ།",
    "མི་རྟག་པའི་དུ་བ་མེད་པའི་ཕྱིར་དུ་བའི་རྒྱུ་ནུས་པ་ཐོགས་མེད་མེད་ཅེས་པའི་འབྲས་བུའི་ཁྱབ་བྱེད་བཀག་པའི་སྒོ་ནས་རྒྱུ་ནུས་པ་ཐོགས་མེད་འགོག་པའི་འབྲས་བུས་དམིགས་པ་ལའང་བཟློག་པ་དུ་བའི་རྒྱུ་ནུས་པ་ཐོགས་མེད་དང་མི་རྟག་པའི་དུ་བ་རྒྱུ་འབྲས་ཡིན་པས་བདག་མི་གཅིག་ཀྱང་དུ་བའི་རྒྱུ་ནུས་པ་ཐོགས་མེད་དང་དེ་ཁྱད་པར་དུ་བྱེད་པ་དུ་བ་ངེས་པར་སྐྱེད་ངེས་གཉིས་བདག་གཅིག་གོ།",
    "སྒྲ་བྱས་པའི་ཕྱིར་རྟག་པའི་དངོས་པོས་སྟོང་པའི་ཕན་ཚུན་སྤང་བའི་ཁྱབ་བྱེད་འགལ་བས་བཟློག་པ་ལ་རྟག་པ་དང་མ་བྱས་པ་བདག་གཅིག་ཅིང་།",
    "དེའི་ཕྱིར་བཟློག་པ་བདག་གཅིག་པའི་འབྲེལ་བ་ལ་རྟེན་པ་ཐམས་ཅད་ནི་ཁྱབ་བྱེད་མི་དམིགས་པར་འདུ་ལ།",
    "སྔ་མ་ནི་འདོད་པར་མི་རུང་སྟེ་ངོ་བོས་གནོད་པར་བྱས་པས་སོ་ཞེས་ཟེར་ཏེ་བརྩོད་པ་དེ་ལ་སྤོངས་སམ་མི་སྤོངས་བསམ་པར་བྱའོ་ཞེས་གསུང་ངོ།",
    "རྫ་མཁན་དུས་མཉམ་པ་དེས་འཇིམ་པ་ལ་ཕན་གནོད་ཀྱི་ཁྱད་པར་གང་ཡང་མ་བྱས་པས་ཉེས་པ་དང་པོ་ལས་གྲོལ་ལ།",
    "སྐད་ཅིག་ཅེས་བརྗོད་ཀྱང་སྐད་ཅིག་གསུམ་ཡིན་པས་སྐད་ཅིག་དང་པོ་ལ་ལྡོག་པར་མི་འགྱུར་རོ་སྙམ་ན།",
    "སེམས་ཙམ་པ་ཡན་ཆད་ཀྱིས་ནི་སྐད་ཅིག་དེ་རྣམས་ལ་གཞིག་པ་ན་མཐར་གཞིག་པར་མི་ནུས་པའི་དངོས་པོ་ཆུང་ངུ་གཅིག་ཡོད་པར་འདོད་དེ།",
    "དེ་ལྟ་མ་ཡིན་པར་ཐུག་པ་ཡོད་ན་དངོས་པོའི་མཐར་ཐུག་གམ་དངོས་མེད་ཀྱི་མཐར་ཐུག།",
    "ཐོག་མ་དབུས་ཀྱང་བརྟག་པར་གྱིས།",
    "དེས་ན་སྐད་ཅིག་ལ་གཞིགས་ཙམ་ན་མཐར་རང་བཞིན་མེད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དུས་ལ་སོགས་པ་ལྟོས་པར་འདོད།",
    "མེད་པ་ཙམ་ལ་བྱས་ན་བུམ་པ་དེས་ཆུ་སྐྱོར་བའི་དོན་བྱེད་ནུས་ཀྱང་དུ་བསྐྱེད་པའི་དོན་བྱེད་མི་ནུས་པས་བུམ་པ་དང་བུམ་པ་ཡང་ཕན་ཚུན་སྤུངས་འགལ་དུ་འགྱུར་བས་དེ་ལྟ་བུ་གཅད་པའི་ཕྱིར་འབྲས་བུ་གཅིག་ལ་ལྟོས་ནས་ཞེས་སྨོས་པ་ཡིན་ནོ།",
    "འོ་ན་བྱས་པའི་མཚན་ཉིད་གང་ཡིན་རྒྱུས་བསྐྱེད་པའོ་ཞེ་ན།",
    "དང་པོ་ནི་འགལ་ཟླ་རྣམ་པར་བཅད་ཙམ་དེའི་ངོ་བོར་ཡོངས་སུ་ཆོད་པ་སྟེ་དཔེར་ན་རྟག་པར་རྣམ་བཅད་ཙམ་ན་མི་རྟག་པ་ཡོངས་སུ་ཆད་པ་ལྟ་བུའོ།",
    "བརྒྱུད་འགལ་གྱི་མཚན་ཉིད་ནི་འགལ་ཟླ་རྣམ་པར་གཅད་ཙམ་ན་དེའི་ཁྱབ་བྱེད་དུ་ཡོངས་སུ་ཆོད་པ་སྟེ་དཔེར་ན་སྔོ་མ་ཡིན་རྣམ་པར་བཅད་ཙམ་ན་ཨུཏྤ་ལའི་སྔོན་པོ་མི་འགྲུབ་ཀྱང་དེའི་ཁྱབ་བྱེད་སྔོ་ཙམ་དུ་ཡོངས་སུ་ཆོད་པ་ལྟ་བུའོ།",
    "དངོས་འགལ་དུ་ཁྱད་པར་མེད་ཀྱང་བློ་ལ་ལྟོས་ནས་ཕུང་པོ་གསུམ་པ་སེལ་མི་སེལ་གྱི་ཁྱད་པར་ཡོད་དོ།",
    "དངོས་འགལ་གྱི་ཁྱད་པར་དུ་མ་བྱས་པའི་བརྒྱུད་འགལ་མི་ཁེགས་སོ།",
    "དེ་ཡང་གོ་མ་ཟིན་པས་ཁྱད་པར་དུ་བྱས་པའི་གོར་རུང་ནི་མ་ཡིན་ཏེ་དཔེར་ན་རྟོག་པའི་མཚན་ཉིད་འདྲེར་རུང་སྣང་བ་ཡིན་ན་བརྗོད་པ་དང་འདྲེས་ཟིན་པའི་རྒན་རྒོན་གྱི་རྟོག་པ་ལ་མ་ཁྱབ་བོ་ཞེས་ཟེར་བ་ལ་བརྗོད་པ་དང་འདྲེས་པས་ཁྱད་པར་དུ་བྱས་པའི་འདྲེར་རུང་ལ་འདོད་ན་དེ་ལྟར་འགྱུར་ཡང་བརྗོད་པ་དང་མ་འདྲེས་པ་ལ་ཡང་ཡོད་འདྲེས་ཟིན་པ་ལ་ཡང་ཡོད་པའི་འདྲེར་རུང་ལ་འདོད་པས་མ་ཁྱབ་པ་མེད་དོ་ཞེས་ཟེར་བ་ལྟར།",
    "གཉིས་པ་ནི་ལ་མེ་ལྡན་གྱི་དོན་སྤྱི་ལྟ་བུ་མཚན་གཞིར་བཞག་ནས་སྐྱོན་ཡོན་བརྩི་བའི་བསྒྲུབ་བྱར་མཚོན་པ་ལ་ཐེ་ཚོམ་དང་ལྡན་པའི་དོན་ལ་འདོད་པོས་ཡུལ་དུ་བྱས་པ་ཞེས་པ་མཚན་ཉིད་དུ་བཀོད་པ་ལྟ་བུ་སྟེ་གྲུབ་བསལ་མེད་ལ་བསྒྲུབ་འདོད་དང་དོན་མཐུན་ཡང་ངོ་བོའི་ས་མཚམས་གཞག་དཀའ་བས་སོ་ཞེས་ཟེར་ཏེ་འོག་ཏུ་བལྟ་བར་བྱའོ།",
    "སྔ་མ་ལྟར་ན་ཡང་བསྒྲུབ་བྱའི་མཚན་ཉིད་མི་འཐད་པ་ནི་ཐེ་ཚོམ་དང་ལྡན་པའི་དོན་ལ་འདོད་པས་ཡུལ་དུ་བྱས་པ་སྐྱོན་ཡོན་རྩི་བའི་བསྒྲུབ་བྱའི་མཚན་ཉིད་ཡིན་ན།",
    "མཚན་གཞིར་བཀོད་པ་ལ་མི་སྲིད་པས་མཚན་གཞི་ལ་མི་སྲིད་པར་གཞག་གོ།",
    "ཞེན་ཡུལ་གྱི་ལ་མེ་ལྡན་གྲུབ་མ་ཟིན་པས་ཐེ་ཚོམ་དང་ལྡན་པའི་དོན་ལ་འདོད་པས་ཡུལ་དུ་བྱས་པ་སྲིད་དོ་ཞེ་ན་ཞེན་ཡུལ་གྱི་དུ་བ་ལ་ཡང་ཚུལ་གསུམ་སྲིད་དོ།",
    "ཞེན་ཡུལ་གྱི་ལ་མེ་ལྡན་གྱི་ཚོགས་དོན་ལ་འདོད་པས་ཡུལ་དུ་བྱས་པ་ཡོད་པ་ལ་མཚན་གཞི་ལ་མེ་ལྡན་གྱི་དོན་སྤྱི་འཇོག་པ་མི་འཐད་དོ།",
    "འགལ་བ་རྗེས་འགྲོ་དང་ལྡན་པར་ཡང་མི་འགྱུར་ཏེ་དངོས་པོར་ན་རང་བཞིན་བསམ་ན་དོན་དམ་པའི་དངོས་པོ་བརྟག་པ་དེ་རང་བཞིན་མེད་པ་ཡིན་ལ་དེ་ལ་རྟགས་ཞུགས་ཀྱང་དོན་དམ་པའི་དངོས་པོར་གྲུབ་པའི་མི་མཐུན་ཕྱོགས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྟགས་ལྡོག་པ་མ་གྲུབ་པར་ཡང་མི་འགྱུར་ཏེ་དངོས་པོར་ན་རང་བཞིན་ན་བསམ་ན་དོན་དམ་པའི་དངོས་པོར་བརྟག་པ་དེ་རང་བཞིན་མེད་པ་ཡིན་པས་དེ་མཐུན་ཕྱོགས་ཡིན་པས་སོ་དེས་ན་དགག་བྱ་ཡིན་པས་མཐུན་ཕྱོགས་སུ་འགྱུར་བའི་ངེས་མེད་དོ།",
    "ཞེན་ཡུལ་དོན་དམ་པའི་དངོས་པོ་བཀག་པས་དགག་བྱ་ལ་གནོད་པར་གཞག་གོ།",
    "དམ་བཅའ་ཉམས་པར་མི་འགྱུར་ཏེ་ལ་མེ་ལྡན་ཚོགས་པའི་བསྒྲུབ་བྱ་ཀུན་བརྟགས་ཡིན་པས་སོ་ཞེ་ན།",
    "དམ་བཅའ་ཉམས་པར་ཡང་མི་འགྱུར་ཏེ་མཚོ་དང་དུ་བའི་དགག་བྱ་ཀུན་བརྟགས་ཡིན་པས་སོ།",
    "རྒྱ་ལྟར་ཐེ་ཚོམ་དང་ལྡན་པའི་དོན་ལ་འདོད་པས་ཡུལ་དུ་བྱས་པ་མཚན་ཉིད་དུ་འགོད་ན།",
    "ཡིད་དཔྱོད་ཀྱི་ཡུལ་གྱི་མཚན་ཉིད་གང་ཡིན་ཁྲོན་པ་རྙིང་པའི་ཆུ་ལྟ་བུ་མཚན་གཞི་ཡིད་དཔྱོད་ཀྱི་ཡུལ་དུ་མཚོན་མྱོང་བ་དང་རྟགས་ལ་མི་རྟེན་པར་དོན་བདེན་པར་ངེས་པར་བྱ་བ་ཞེས་པ་མཚན་ཉིད་ཡིན་ནོ།",
    "ཁྲོན་པ་རྙིང་པའི་ཆུ་ངེས་པས་མཚན་གཞི་ཡང་གྲུབ་ལ་འོན་ཀྱང་སྔར་གྱི་བློ་ལ་ལྟོས་ནས་ཡིད་དཔྱོད་ཀྱི་ཡུལ་དུ་མཚོན་པ་ལ་མཚན་ཉིད་སྔར་གྱི་བློ་ལ་ལྟོས་ནས་མྱོས་པ་དང་རྟག་ལ་མ་བརྟེན་པར་དོན་བདེན་པར་ངེས་པར་བྱ་དགོས་པས་མི་སྲིད་པའི་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "འོ་ན་བསྒྲུབ་བྱ་དངོས་པོའི་ཚོགས་དོན་ཡིན་ན་སྒྲ་རྟག་པར་དམ་བཅས་པ་ལ་དངོས་པོའི་ཚོགས་དོན་མེད་པས་དམ་བཅའ་མ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "དམ་བཅའ་ལྟར་སྣང་དུའང་གཞག་དུ་མེད་དེ་དཔེར་ན་སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་ལ་ཤེས་བྱ་མ་ཡིན་པའི་བུམ་པ་མཐུན་ཕྱོགས་ཀྱང་མ་ཡིན་པ་བཞིན་ནོ།",
    "འོན་ཀྱང་སྒྲ་རྟག་པར་དམ་བཅས་པ་བསལ་བ་དེ་དམ་བཅའ་བཀོད་པ་ལ་བསལ་བ་ཡིན་ནོ་ཞེས་བཞེད་དོ།",
    "གང་ཟག་ལ་ལྟོས་ནས་རྩི་བའི་རྩིས་རྣམ་པར་བཞག་པའོ།",
    "འོ་ན་དཔག་བྱ་དཔོག་བྱེད་ཆ་གཉིས་སུ་བཟུང་བ་དང་པོ་སྒྲ་བྱས་པའི་ཕྱིར་མི་རྟག་ཅེས་བརྗོད་ལ་རྟགས་མ་གྲུབ་ཅེས་ཟེར་ན།",
    "རྟགས་སུ་དགོད་པར་བྱ་བའི་ངོ་བོ་གཞལ་བྱ་སྒྲའི་སྟེང་དུ་གྲུབ་པ་ལ་ཉེ་དུ་གྲུབ་ཅེས་བྱའི་ཚུལ་གསུམ་གྲུབ་པ་མེད་དོ་ཞེ་ན།",
    "དཔེར་ན་ཧེ་དུའི་མཚན་ཉིད་ཚུལ་གསུམ་ཡིན་པས་སྒྲ་མི་རྟག་པར་བསྒྲུབ་པའི་ཧེ་དུ་བྱས་པ་ཡིན་ཡང་ལ་མེ་ལྡན་ཡིན་མིན་རྩོད་པའི་སྐབས་སུ་བབ་པས་ཚར་བཅད་པའི་གནས་སུ་འགྲོ་བ་བཞིན་དུ་སྔར་གཏན་ལ་ཕབ་ཟིན་ཏོ།་",
    "ལྔ་པ་ནི་བསྒྲུབ་བྱ་ལ་གྲུབ་བསལ་མེད་པའི་སྟེང་དུ་བསྒྲུབ་པར་འདོད་པ་ཞེས་བྱ་བ་སྨྲོས་དགོས་པ་བཞིན་དུ།",
    "ཧེ་དུ་ལ་འདོད་པ་སྨྲོས་དགོས་ཏེ་ཚུལ་གསུམ་དང་ལྡན་པར་ངེས་པ་ལ་སྒྲུབ་བྱེད་དུ་མི་འདོད་པ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེས་ན་སྔ་མ་དོན་མཐུན་ཡང་བསྒྲུབ་བྱའི་མཚན་ཉིད་ཐེ་ཚོམ་དང་ལྡན་པའི་དོན་ལ་འདོད་པས་ཡུལ་དུ་བྱས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "སྒྲུབ་བྱེད་དུ་བཀོད་པའི་མ་གྲུབ་པ་ལ་ཧ་ཅང་ཁྱབ་ཆེས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "འདོད་པ་ཞེས་བྱ་བ་ནི་རྗེས་དཔག་བསྐྱེད་པར་འདོད་པ་སྟེ་ཕྱིར་རྒོལ་ལ་སོགས་པ་ལའོ།",
    "བསལ་བ་འཇུག་མི་སྲིད་པར་ངེས་ཙམ་ན་ཤེས་འདོད་མེད་པའི་སྐྱོན་བྱུང་བས་སྔ་མ་ལྟར་བྱའོ་ཞེས་གསུང་ངོ།་",
    "གཉིས་པ་ནི་ཁས་བླངས་ཀྱི་རྗེས་དཔག་ཅེས་བྱ་བ་ཡོད་པ་བཞིན་དུ་ཁས་བླངས་ཀྱི་མངོན་སུམ་ཡང་ཡོད་པར་འགྱུར་ཏེ་ཁོ་བོ་ལ་སྣང་བའི་སྔོན་པོ་འདི་སྔོ་མ་ཡིན་མ་སྤངས་སོ་ཞེས་ཁས་ལེན་པ་ལྟ་བུའོ་ཞེ་ན།",
    "གྲགས་པའི་མངོན་སུམ་མེད་དེ་སྒྲས་ཁྱད་པར་དུ་བྱས་པ་དངོས་སུ་འཇལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "གྲགས་པའི་རྗེས་དཔག་ཀྱང་མེད་དེ་སྒྲས་ཁྱད་པར་དུ་བྱས་པ་དངོས་སུ་འཇལ་བ་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྒྲ་བྱས་པར་ཡོངས་གཅོད་ལ་གྲུབ་པས་དངོས་འགལ་མ་བྱས་པ་ཁེགས་ཀྱི་བརྒྱུད་འགལ་མི་ཁེགས་པས་མངོན་སུམ་གྱིས་བསལ་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲ་བྱས་པར་ཡོངས་གཅོད་ལ་གྲུབ་ན་མ་བྱས་པ་ཁེགས་ཀྱི་རྟག་པ་མི་ཁེགས་པས་ཁས་བླངས་ཀྱི་བསལ་བ་མ་ཡིན་ནོ་ཞེས་འགོ་བསྒྲེ་ན།",
    "རྟགས་འཛིན་གྱི་ཤེས་པས་ནི་ནོག་དང་ལྐོག་ཤལ་དང་ལྡན་པའི་ཕྱིར་ཞེས་དོན་སྤྱིའི་རྣམ་པ་ཅན་གྱིས་ཡུལ་དུ་བྱས་ལ།",
    "དེ་གཉིས་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "དཔེར་ན་བྱས་པ་དང་ཉེ་དུ་བཞིན་ནོ།"
  ]
}