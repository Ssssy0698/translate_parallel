    "ཁོང་རང་ལོ་བཅོ་བརྒྱད་ལོན་པའི་ཚོ་དར་ཡུལ་དུ་གཤེན་ས་ཕུག་པ་ལ་རབ་ཏུ་བྱུང་།",
    "བསུ་སྟེ་ནམ་སྐྱོ་ཙ་ན་འབྱོན།",
    "ཁོ་བོ་བོད་དུ་འོང་མི་དགོས་པར་འདུག་པ་ལ་ཞེས་སྐྱེས་བུ་ཆུང་ངུའི་ལག་ལེན་འཆི་བ་རྗེས་སུ་དྲན་ཏེ།",
    "ད་སྣ་ཤུད་ཀྱི་འཁྲུག་པ་ཅིག་ན་ཀུ་དི་རི་འདུག་པས།",
    "རྡོའདུག་པས་མ་དགྱེས་ནས།",
    "དཔོན་སློབ་ནག་པོ་སྤྱོད་པ་བ་ཡིན་གསུང་ཟེར་བ་འདུག་དེ་ནས་གན་བྱང་ཐང་དུ་ཕེབས་དུས་ལྷ་སའི་རྣམས་བྲོས་ཏེ་མྱང་པོའི་གྲུ་ལ་ཞུགས་ཏེ་གཙང་པོའི་སུམ་ཆ་ཙམ་དུ་ཕེབ་པ་ན།",
    "འདི་ན་མི་མ་ཡིན་ཆེན་པོ་ཞིག་འདུག་ཁྱེད་རྒྱས་འོང་ཐད་དགོངས་པའི་ཚེ།",
    "ཁོང་རང་དང་ནག་ཚོ་སྐྱེ་བ་སྔ་ཕྱི་ཡིན་ཟེར།",
    "ཅེས་བྱ་བ་མི་གདའ་འམ་གསུང་།",
    "གཞན་གོ་བ་ཙམ་ཡང་མི་འདུག་གསུང་།",
    "ཀླུ་གཉན་ཆེ་བ་ཞིག་འདུག་པའི་སྟེང་དུ་གཟིམས་མལ་བཅས་ནས་བཏུལ།",
    "སྔོན་གྱི་སྒོམ་འཕྲོ་ཡིན་པར་འདུག་སྟེ་ངོ་མ་ཤེས།",
    "དེཙ་ན་རོ་སྟོད་རྒྱངས་ཀྱི་བསྙུང་བ་ལ།",
    "ཕྱིས་ལོ་ན་བཞུགས་ཙ་ན་དེ་རྣམས་འདྲ་འདྲ་འདུག་གསུང་།",
    "ཐུགས་དགོངས་རྩད་གཅོད་དགོས་པར་འདུག་པ་ལ།",
    "ཡང་མནལ་ལམ་དུ་ཡོལ་བ་ཅིག་འདུག་པ་བསལ་ནས་སྤྱན་སྔར་བྱོན་པས།",
    "བདེན་གཉིས་གོ་རུང་ཞིག་འདུག་གསུང་སྟེ།",
    "གཏོར་མ་བཏོན་དུས་མ་བསྐམས་པར་རློན་པར་འདུག་ཅེས་གྲགས།",
    "འདི་གཤེགས་ནས་ཕྱི་མ་མ་བསྐོས་པའི་བར་དུ་ལོ་སུམ་ཅུ་རྩ་དགུ་འདུག་གོ།",
    "ཇོ་བོའི་གདམས་པ་ཇི་ལྟ་བ་བཞིན་དུ་གནང་བར་འདུག་སྙམ་པ་བྱུང་བ་བཞིན།",
    "དགྲ་བཅོམ་པ་དེའི་ཞལ་ནས་མེ་ཏོག་འདི་རྣམས་ཁྱེད་ཀྱི་ཕུ་བོ་དེ་བོད་དུ་འགྲོ་བར་འདུག་པས་དེ་ལ་བསྐུར་ལ།",
    "འབྲོམ་སྟོན་བཞུད་པའི་ཕྱི་དེ་ལོ་བྱའི་ལོ་ལ་ཏུ་མཚམས་སྡོམ་པ་ཡིན་སྙམ་ཙ་ན།",
    "སྤྱིར་ན་ཇོ་བོས་བོད་དུ་ལོ་བཅུ་གསུམ་བཞུགས་པའི་རིང་ལ་གདམས་ངག་བཏབ་ཅིང་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་སྐྱེས་པ་ནི་ཤིན་ཏུ་མང་བར་བྱུང་འདུག་ནའང་གྲངས་སུ་མ་བཅད།",
    "སློབ་དཔོན་ཕྱུ་པའི་དུས་རྡུལ་ཕྲན་ཐུག་མེད་བཞེད་པ་ལ་དགག་པ་མང་པོ་མཛད་འདུག་ནའང་།",
    "མེ་ཏོག་མར་ལ་ལོག་དུས་གསུངས་ཏེ།",
    "དེ་ནས་ཏི་ར་ཧུ་ཏིར་ཕེབས་དུས་མི་མང་པོ་འདུ་ཞིང་འདུག་པ་ཅི་ཡིན་དྲིས་པས།",
    "དེར་ཁྲོམ་གསེབ་ཏུ་ཕྱིན་ནས་ནཱ་རོ་པའི་དྲུང་དུ་སླེབ་ཙ་ན།",
    "ད་ང་རང་ཡང་རྒྱ་གར་དུ་འགྲོ་སྙམ་པའི་འདུན་པ་སྐྱེས།",
    "ད་རྒྱ་གར་ནས་ལོག་དུས་སྣ་ལེན་མཛད་དགོས་གསུངས་པས།",
    "སྦྲུམ་མས་ས་གཞན་སུ་འདུག་ཅིང་།",
    "ཁྱེད་རང་མཁས་དེབ་ཐེར་སྔོན་པོ།",
    "ཁྱེད་རང་དེར་རྒྱུག་གསུང་བས།",
    "འོན་ཀྱང་སྡིག་ཆེན་པོ་འདུག་པས་སྦྱོང་དུ་བཅུག་པ་ཡིན།",
    "ཡུམ་སྲས་གཉིས་ཀྱི་ཞིང་སྐལ་ཞིག་ཡོད་པ་སུས་ཀྱང་འདེབས་མ་ནུས་པར་འདུག།",
    "ད་ནི་དཀའ་བ་སྤྱད་ནུས་པར་འདུག་སྙམ་པའི་དགོངས་པ་སྐྱེས་ནས་ཡུལ་ནས་འཐོན་ཏེ།",
    "དས་རི་ཟུར་དེ་ནས་བལྟས་པས་ཁྱེད་རྣམས་ས་དེ་འདྲ་ན་སླེབ་འདུག་པ་ལ།",
    "རྗེ་བཙུན་མ་མཐོང་གསའ་ཞིག་འདུག་པ་ལགས་ཞུས་པས།",
    "རྩམ་པ་ཕུལ་བཞི་ཙམ་ལས་མ་གོད་པར་འདུག་རྩམ་ལྷག་དང་ཤ་གཟུག་ཁོང་རྣམས་ལ་བྱིན།",
    "བདག་སྣོད་དུ་རུང་བ་ཤིན་ཏུ་དཀོན་པར་འདུག་པས།",
    "དེ་ནས་ལེགས་པར་གདའ།",
    "པར་ཡུན་རིང་དུ་འདུག་པ་མཐོང་ནས།",
    "འོ་ན་ད་རང་མང་སྐལ་ལྡན་དུ་འདུག་སྙམ་པའི་ཁེངས་པ་ཅུང་ཞིག་བྱུང་བས།",
    "ཆང་ཀ་པཱ་ལ་གང་འདུག་པ་གནང་བ།",
    "ད་ངའི་བུ་དྭགས་ལྷ་སྒམ་པོས་གདན་འདྲེན་པར་འདུག་པས་དེར་གཤེགས་ཤིག་ཟེར་ནས་མི་སྣང་བར་གྱུར།",
    "ཕྱིས་མགོན་པོ་འདི་ཧ་ཅང་བརྩུབ་དྲགས་འདུག་དགོངས་ནས།",
    "ངའི་ཡི་གེ་དེ་རྣམས་ཅུང་ཟད་ནོར་འདུག་པས་སོ་སོ་ནས་ཁྱེར་ཤོག་གསུང་ནས་བསྡུས་ཏེ།",
    "ཁོང་ང་ཟིལ་གྱིས་གཞོན་འདོད་འདུག་སྟེ།",
    "ཡུལ་དེ་ན་ལྷ་འདྲེ་གདུག་པ་ཅན་འདུག་པའང་བཏུལ།",
    "སྒྲུབ་པ་མཛད་པས་རང་རང་སོ་སོའི་གཞུང་ལྟར་གྲུབ་རྟགས་མང་དུ་བྱུང་།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པའི་མཐར་དགུང་ལོ་བདུན་བཅུ་འདུག་པས་སྐྲག་སྟེ་བྲོས་བྱོན་པས།",
    "མཚོ་ཅིག་འདུག་བཞེས་པ་དབྱར་ཟླ་ར་བའི་ཉི་ཤུ་ལྔ་ལ་ཞིང་དག་པར་གཤེགས།",
    "དགའ་ལྡན་དུ་འགྲོ་བས་དེར་ཁྱེད་རང་རྣམས་གསོལ་བ་ཐོབ།",
    "དམ་པའི་སྐུ་དེ་འཇའ་ཚོན་ལྟ་བུར་འདུག་པ་ལས་རང་ལ་ཐིམ་པའི་སྣང་བ་བྱུང་།",
    "ཟླ་བ་དང་གླང་པོ་ཆེ་དང་སེང་གེ་ལ་སོགས་པ་ལ་འདུག་པ་ཡད་ང་ཡིན་གསུང་།",
    "རྒྱལ་སྲིད་ལའང་གནོད་པ་འོང་བར་འདུག་པས།",
    "བོད་དུ་རྒྱའི་དམག་མི་འོང་བ་འདུག་ཅེས་པའི་གསུང་ཡང་བྱོན་པར་གྲགས།",
    "དེ་ནས་རྗེ་ཞིག་ན་ནང་ན་མི་བཞུགས་པར་རིག་ན་མ་ཚར་བར་ཡུལ་གཞན་མི་སྤྲོ་འདུག།",
    "གཤེགས་འདུག་དེ་ནས་མཁའ་སྤྱོད་པར་གྲགས་སོ།",
    "རྗེས་དྲན་ལ་སླེབ་ནས་གདའ།",
    "ཅིག་ཆར་བའི་རིགས་སུ་འདུག་གསུང་།",
    "ལ་ལས་རྣམ་འཇོམས་སོགས་མཛད་ཀྱི་འདུག་ངེད་ཚུལ་བློ་གཉིས་ཀྱིས་གཤིན་རྗེའི་བཟློག་པ་ལ་ཞུགས་པས།",
    "ཨུ་རྒྱན་གྱི་དོར་ར་ཚག་འདི་ཡིན་པར་འདུག་གསུང་།",
    "ད་ནི་སྐྱོ་བོས་ངའི་ཁ་མི་རྙེད་པར་འདུག་གསུང་།",
    "ཕྱོགས་འདིར་མྱུར་དུ་སླེབ་པར་འདུག་ཅེས་ཉེ་གནས་རྣམས་ལ་གསུངས།",
    "ལོ་གསུམ་ལོན་པའིཚེ་མས་པད་ནས་ཆུ་བཙགས་པས་ངོ་ཚ་མི་བསྲུང་བར་འདུག་སྙམ་པ་བྱུང་སྟེ།",
    "ཞི་གནས་རྐྱང་བར་འདུག་དགོངས་ནས་ཐུགས་ཅུང་ཟད་མ་ཁེངས།",
    "ལར་གདམས་ནས་གསོལ་བ་མཛད་པའི་ཐན་ཆདས་ཤིག་འདུག་པ་ཕྱག་ཏུ་བསྣམས་ནས།",
    "ལྷན་ཅིག་སྐྱེས་སྙི་སྒོམ་ཁོ་ན་སྙམ་པ་ཆེ་བར་འདུག་པ་གསུངས་པས།",
    "ཁོང་རང་སྒོ་དྲུང་དུ་བྱོན་ནས་ཚ་བ་ཞུས།",
    "ཁྲིད་བཏབ་པས་འདི་ལ་ང་རང་ཞིབ་པར་འདུག་སྙམ་ནས་ཡོན་ཏན་མ་སྐྱེས།",
    "ཅུང་ཞིག་བསམས་ཙ་ན་གནས་ལུགས་ཀྱི་དོན་མངོན་དུ་གྱུར།",
    "ཨེ་བྱོན་ངེད་ཀྱིས་གྲོགས་བྱེད་ཟེར་བ་ལ་བརྟེན་ནས་དགེ་སློང་མ་དེའི་རྗེས་ལ་ཕྱིན་ཙ་ན",
    "གཅིག་གཡོན་འཁོར་འདུག་པའི་ནང་ནས་རཀྟ་ཞིག་གནང་བྱུང་",
    "འདི་རྣམས་འཇའ་ལུས་འོད་ཕུང་གྲུབ་ཚར་འདུག་པསམས་བྱུང་",
    "ཐུགས་དགྱེས་ཉམས་ཤིན་ཏུ་ཆེ་བར་བྱེད་འདུག་པ་ལ",
    "རིག་འཛིན་རྒོད་ལྡེམ་རྣམས་ཡིན་འདུག་ཟེར",
    "དེ་ནས་ང་འགྱོད་དྲགས་ཏེ་དགེ་སློང་མ་ལ་མཐོལ་ལོ་བཤགས་སོསྔོན་མ་ཤེས་པ་ཡིན་འདུག་ཞུས་པས",
    "གར་ཕྱིན་ཀྱང་རང་སེམས་ལས་གཞན་མ་རྙེད",
    "བདེ་སྡུག་སྣ་ཚོགས་གང་ཤར་ཀྱང་ངོ་བོར་ལྟ་ཞིང་རང་ཐོག་འཇོག་དངོས་འཛིན་རྣམ་རྟོག་རང་སར་ཡལ་འདི་དོན་ལྟ་ཞིང་རང་སར་གཞག",
    "བར་ན་གཡའ་སྤང་ནགས་ཚལ་རྒྱས་པ་འདུག།",
    "དེ་བཞིན་གཡོན་ལའང་རི་བོ་དེ་ལྟར་འདུག།",
    "དམར་སྨུག་ལྡན་པའི་རི་རོང་མང་པོ་འདུག།",
    "འདབ་ཆགས་སྣ་ཚོགས་གར་སྒྱུར་བྱེད་པར་འདུག།",
    "མཛེས་སྡུག་གཟུགས་སུ་བསྐོར་བས་འཐིབས་པ་འདུག།",
    "བར་བར་མཚམས་སུ་ཟུར་དང་ལྡན་པ་འདུག།",
    "ཤིན་ཏུ་མཐོ་ཞིང་མཐོ་བར་འདུག་པ་མཐོང་།",
    "ཤིན་ཏུ་ཡ་མཚན་ཆེ་བའི་བཀོད་པར་འདུག།",
    "སྒོ་རྣམས་ཐམས་ཅད་ནང་དུ་བསྟན་པ་འདུག།",
    "སྐས་ཐེམ་གསུམ་དང་བཅས་པ་གསལ་བ་འདུག།",
    "ཤིན་ཏུ་མཛེས་ཤིང་འབུར་དུ་དོད་པ་འདུག།",
    "སྣ་ཚོགས་བཀོད་པས་མཛེས་པའི་རབ་གསལ་ནི་ རིན་ཆེན་སྣ་ཚོགས་དུ་མས་བརྒྱན་པ་འདུག།",
    "རིན་ཆེན་ལས་གྲུབ་གསེར་གྱི་སྒོ་རུ་འདུག།",
    "ཚད་ལས་འདས་ཤིང་བརྗོད་པར་དཀའ་བ་འདུག།",
    "སེངྒེ་ཐམས་ཅད་དཀར་པོ་ཉིད་དུ་འདུག་ཁོ་ནས་རིན་ཆེན་དུ་མའི་ཟ་རལ་ལ།",
    "བང་རིམ་ཁ་དོག་ལྔ་དང་ལྡན་པ་འདུག།",
    "དྷུ་ན་ཧ་རི་མཆོད་རྟེན་སྔོན་པོར་འདུག།",
    "གླུ་ན་ཧ་རི་མཆོད་རྟེན་དམར་པོ་འདུག།",
    "གྷ་ན་ཧ་རི་མཆོད་རྟེན་ལྗང་ཁུར་འདུག།",
    "དྲྭ་ཕྱེད་མདའ་ཡབ་པུ་ཤུད་མཛེས་པ་འདུག།",
    "རིན་ཆེན་སྣ་ཚོགས་དུ་མས་བརྒྱན་པ་འདུག།",
    "དར་དཀར་སྨད་དཀྲིས་རིན་ཆེན་བརྒྱན་ལྡན་འདུག།",
    "བར་གྱི་ལྷ་བུ་བཞི་ཡིས་བཟུང་བ་འདུག།",
    "གར་སྒྱུར་རོལ་རྩེད་སྤྱིར་ཡང་སྟོན་པ་འདུག།",
    "བྱང་དུ་སོག་ཁའི་དབྱིབས་དང་ལྡན་པ་འདུག།",
    "དེ་ནས་ཡང་ཌཱ་ཀི་མ་དང་རང་ཉིད་གཉིས་འགྲོགས་ནས་བལྟས་ཚེ",
    "ད་དུང་འདུག་པའི་དུས་མིན",
    "རྨི་ལམ་ཉིད་ཀྱི་ཞིང་འདིར་འདུག་པར་ག་ལ་ཆོག་གོ",
    "མི་ཡི་ལུས་སུ་འདུག་ཀྱང་",
    "འགག་མེད་ལོངས་སྐུའི་སྒྲུབ་ཐབས་ཡིད་ཡུལ་དུ་ལེགས་པར་གསལ་བར་འདུག་གོ",
    "ཞེ་སྡང་རང་སར་གྲོལ་པའི་རྡོ་རྗེ་བཞད",
    "བདེ་གསལ་མི་རྟོག་པའི་ཉམས་ཡང་རབ་ཏུ་འབར་འདུག་གོ",
    "བེ་རོ་ཙ་ན་ལ་སོགས་པཎ་ཆེན་ཚོགས།",
    "དགདནའདདངདད་ཀག་ཀདགདའ་ཨམཀ་སོག་སྐར།",
    "བེ་རོ་ཙ་ན།",
    "ཝ་ལེར་ཡིད་ལ་དྲན་རྒྱུ་དེ་ལས་གཞན་མི་འདུག།",
    "ཤིན་ཏུ་བག་དྲོ་ལ་བྱིན་ཆེ་བ་ཞིག་འདུག་པའི་དབུས།",
    "། སས་་པ་༦ དབྱིབས་པསམ་ཡས་དབུ་རྩེ་རིམ་གསུམ་དང་མཚུངས་པ་ཞིག་འདུག་པ་ལ།",
    "རིགས་ལྔའི་དཔའ་བོ་མཁའ་འགྲོ་ཡབ་ཡུམ་སྐུ་ལ་མ་བསྒྲིབས་བཞིན་དུ་རྫོགས་པ་ཞིག་བཞུགས་འདུག་གཡས་གཡོན་ཐམས་ཅད་དུ་དཔའ་བོ་དང་མཁའ་འགྲོས་ས་དང་བར་སྣང་ཐམས་ཅད་གང་བ་སྤྲིན་འཐིབས་པ་ལྟར་འདུག་པ་ལ།",
    "སྐུའི་གཡས་ཕྱོགས་དར་ཡོལ་གྱི་ནང་དུ་དཀྱིལ་འཁོར་དང་མཆོད་གཏོར་རྣམས་བཤམས་འདུག་བདག་ཐེ་ཚོམ་དུ་གྱུར་ནས།",
    "སྐུ་ལུས་གར་གྱི་རྣམ་འགྱུར་དུ་ཤིག་ཤིག་འདུག་པས།",
    "སླར་རྩ་བ་གསུམ་གྱི་ལྷ་ཚོགས་ཐམས་ཅད་ཀྱང་རང་སྣང་དུ་ངོ་ཤེས་ཏེ།",
    "ཞེས་ལན་བཏབ་སྟེ་དགྱེས་པའི་ཚུལ་གྱིས་བཞད་པའི་གད་རྒྱངས་རི་བསྐྱེལ་བ་ཙམ་མཛད་ཀྱིན་གདའ།",
    "དེ་ནས་གདན་ཁྲི་དཔག་ཏུ་མེད་པ་འདུག་པ་རྣམས་ལ་རིག་འཛིན་དཔའ་བོ་མཁའ་འགྲོ་གོང་མ་རྣམས་བཞུགས།",
    "ཐམས་ཅད་ཀྱིས་དགྱེས་པའི་ཉམས་སུ་མཛད་ཀྱིན་གདའ།",
    "ཕྱེད་ནག་པོ་བྱས་པ་ཞིག་ལ་མེ་དམར་འུར་འུར་འབར་ནས་ལུང་པ་ཐམས་ཅད་མེས་གང་ནས་ཚེག་ཚེག་འུར་འུར་ཟེར་ཞིང་མི་མང་པོ་ལ་ལ་ཚིག་ཅིང་ལ་ལ་ང་ལ་འཇུས་ནས་འདུག་ང་ཡང་འཇིགས་སྣང་ཅུང་ཟད་གཅིག་ཤར་ནས་འདུག་ཀྱང་",
    "གོས་དང་རྒྱན་མེད་པ་བྷ་ག་སྦེད་པའི་འདུ་ཤེས་དང་བྲལ་བསྐད་ཐོས་པ་ཙམ་གྱིས་བདེ་བ་ལྷང་ལྷང་སྐྱེ་བ་ཞིག་འདུག་པ་ཁོ་བོས་དེའི་གསུང་ལ་ཉན་པས་འདི་སྐད་ཟེར།",
    "ལུང་པ་དབྱིབས་རྔ་ཡུ་བ་དང་བཅས་པའི་ཚུལ་ལ་ཟིལ་ལྟར་སྔོ་ཐིང་ངེ་བ་ཅིག་འདུག་དེའི་ནུབ་བྱང་མཚམས་ན་གངས་སྒྲོམ་བུའི་དབྱིབས་ཅན་གཞན་ལས་མཐོ་བ་ཞིག་འདུག།",
    "དུས་ཚིགས་ཞིང་ཁམས་དུ་མར་བསྐྱོད་ཕྱིར་ཚེ་ཡང་ཕུར་གསུམ་གྱི་བསྙེན་མཚམས་ལ་འདུག་དགོས་པར་ལུང་བསྟན།",
    "ཤི་བའི་ཚུལ་དུ་ངེས་པར་འདུག་དགོས་ཞེས་ཞུས་པའི་ཚེ།",
    "དེ་ནས་ཚེས་ཉེར་ལྔའི་ཉིན་པར་འདུག་ལུགས་སོགས་ཕྱོགས་ཐམས་ཅད་ཀུན་བློ་ཕུད།",
    "ཞི་དྲག་ཐབས་ཚུལ་དུ་མའི་སྒོ་ནས་མ་འདུག་ཅེས་ཡང་ཡང་གསུངས་ཀྱང་མ་ཕན་པར།",
    "ད་འདུག་པར་ཐུག་པ་ཡིན་པས་ཚིག་འདི་རྣམས་མ་བརྗེད་པར་ཡིད་ལ་ཟུངས་ཤིག་གསུངས།",
    "མཁའ་འགྲོ་ཞིག་ལ་ཁྲུས་མཛད་ནས་འདུག།",
    "འཁོར་དུ་མཁའ་འགྲོ་མ་བཅུ་དྲུག་ཙམ་ཞིག་འདུག།",
    "ཁང་བཟང་ཡིད་དུ་འོང་བ་གཅིག་འདུག།",
    "ད་དུང་ཨུ་འུ་གཉིས་དཔལ་རི་ལ་འདུག་པའི་དུས་ལ་ནི་མ་བབས།",
    "དེ་ནས་ཡང་ཤེལ་དམར་པོའི་ཁང་པ་བྱུ་རུའི་ལག་གདུབ་ཀྱི་འཕར་ཁ་འཐེན་པ་ལྟ་བུ་ལ་ལྡེ་མིག་མི་དགོས་པ་བརྡ་ཡིག་དམར་པོ་ཞིག་སྤུངས་པ་འདུག།",
    "མཆོད་ཡོན་ནི་བརྒྱ་ཡང་འདུག།",
    "ང་རང་དར་དཀར་པོའི་གདན་ལ་པུས་བཙུགས་སུ་བསྡད་དེ།",
    "གཡུ་འབྲུག་ཕྱག་ན་ནོར་བུ་ཡོད་པ་བརྒྱུད་འཁྱིལ་བ་ཞིག་ན་མལ་དང་སྔས་གདན་ཡིད་སྤྲོ་བ་ཞིག་འདུག་པ་དེར་བསྡད།",
    "ཁྱེད་རང་མ་ངུ་བར་བྱོན།",
    "རང་རང་གྲུབ་རྟགས་སོ་སོར་ཐོན་པའི་དུས་སློབ་དཔོན་པ་དྨ་འབྱུང་གནས་སྐུ་མདུན་དུ",
    "རང་རང་གྲུབ་རྟགས་རྫུ་འཕྲུལ་སྣ་ཚོགས་བསྟན",
    "ལྟེ་བ་འབྲེག་དུས་སྤུ་གྲིས་སྲོག་གཅོད་འདྲ",
    "དྲང་སྲོང་རྒན་པོ་ཞིག་བཞུགས་འདུག་ཁྱེད་ཀྱི་མཚན་པ་བ། བ་ག།",
    "ང་རང་མེས་བུ་གསིན་བྱ་བ་ཡིན་ཟེར",
    "གཞན་མི་ནི་མི་ཐར་བར་འདུག་པ་འདྲ",
    "ཕྱག་རྟེན་ཕུལ་བས་དེར་བཞུགས་པ་ཐམས་ཅད་ཀྱིས་ཡན་ལག་བདུན་པ་དང་མཎྜལ་གསུང་ཞིང་འདུག",
    "ཁྱེད་རང་ཚེ་འདིའི་འཛིན་ཞེན་སྤྱོང་ལ་བདག་མེད་ཀྱི་དོན་སོམས",
    "ཁྱེད་རང་ལ་ཡང་འདི་ལྟ་བུ་འོང་རན་ཟེར།",
    "ཆ་ལུགས་མ་གཏོགས་སྐུ་ནི་སྐྱབས་མགོན་ཐམས་ཅད་མཁྱེན་པ་རང་དུ་འདུག།"
  ]
}