    "དེ་ཡིས་ལེགས་པའི་ལས་དེ་བྱས་པས་ན།",
    "གཞན་ལ་གནོད་པས་ནམས་ཀྱང་གནོད་མ་བྱས།",
    "ཇི་ལྟར་བསམ་། བཞིན་ཞི་གནས་བསྟེན་པར་བྱེད།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་རྣམ་པར་སྣང་བྱེད་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་ཚིགས་སུ་བཅད་པའི་དབྱངས་ཀྱིས་ཞུ་བ་ཞུས་པ།",
    "དཔེ་མེད་རྣམ་གནོན་འདི་དག་བདག་ལ་གསུངས།",
    "རྣམ་པར་སྣང་བྱེད་ཀླུ་ནི་ཡིད་དགའ་སྟེ།",
    "མི་ཡི་མཆོག་གྱུར་དེ་དག་བདག་ལ་གསུངས།",
    "ཀླུ་ཡི་རྒྱལ་པོ་བསྒྱིངས་པས་རྣམ་པར་འདྲེན།",
    "རྣམ་འདྲེན་གནས་མ་ལགས་པ་འཚལ་བ་འཐོབ།",
    "ལས་གང་བྱས་པས་ནམ་ཡང་གདུང་མི་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པས་འགྲོ་ཀུན་རབ་ཏུ་མཁྱེན་ སྟོན་པས་ལུང་བསྟན་པས་ནི་འོད་ཆེན་ཀླུ།",
    "འདམ་ལས་རྒལ་ཅིང་སྐམ་ལ་ཤིན་ཏུ་བཞུགས།",
    "དུས་གསུམ་མཁྱེན་ལ་རབ་ཏུ་བརྟན་པར་བཞུགས།",
    "ནམ་མཁའ་ལྟ་བུར་མཁྱེན་ལྡན་ཞུ་བ་གྱིས་། པ་ འགྲོ་བའི་འདྲེན་པ་དེ་དག་བདག་ལ་གསུངས།",
    "ཐོགས་མེད་མཁྱེན་པས་ཐུགས་ནི་མ་ཆགས་ཤིང་།",
    "ངེས་པའི་ལས་བྱས་པས་ནི་བདེ་འབྱུང་དང་།",
    "མཁས་པ་དེ་ཡིས་ལས་དེ་བྱས་པས་ན།",
    "དུས་གསུམ་ཤེས་ལ་རྣམ་པར་བརྩེ་བྱེད་ཅིང་།",
    "བདག་དང་དེ་བཞིན་གཞན་ཡང་ཤེས་པར་བྱེད།",
    "ལས་དང་རྣམ་སྨིན་དེ་བཞིན་རབ་ཏུ་མཁྱེན།",
    "མི་མཆོག་མཆོག་རབ་མཁྱེན་རབ་མཐའ་ཡས་པ།",
    "སྐྱེན་པར་དགུ་མ་ཕྱིར་བདེ་བར་གཤེགས་པས་གསུངས།",
    "སྟོབས་བཅུའི་སྟོབས་མཁྱེན་བདག་ཉིད་ཤིན་ཏུ་ངེས།",
    "དེ་ཚེ་རྨི་ལམ་ལྟ་བུར་རབ་ཏུ་མཁྱེན།",
    "སྟོབས་བཅུས་བསྟན་པའི་ལམ་ལ་གཞག་པར་བྱ།",
    "མི་ཡིས་སྔོན་གྱི་འཕྲིན་ལས་བྱས་པ་མཐོང་།",
    "རྨི་ལམ་ལྟ་བུར་བྱས་པར་རྣམ་རིག་ཅིང་།",
    "དེ་ནས་བདུད་སྟོབས་བསྙེན་པར་དཀའ་ཞེས་པ།",
    "དེ་ཡི་འདོད་པ་བདུད་སྟོབས་ཐམས་ཅད་དག་དེ་ཚེ་བསྐྱེད་ནས་བདུད་བསྟེན་འཇིགས་བྱས་ཀྱང་།",
    "མྱུར་དུ་དུས་ལས་འདའ་ཞིང་འགོག་པར་གྱིས།",
    "གཞན་ཡང་བདེ་གཤེགས་བསྙེན་པར་བྱ་བའི་ཕྱིར།",
    "རྣམ་འདྲེན་དེ་ནི་གཙེས་པར་མ་ནུས་ཤིང་།",
    "ཕྱུགས་གཞོན་ཞེ་སའི་སྐད་དག་འབྱིན་པར་བྱེད།",
    "ཤིན་ཏུ་མི་བཟད་རྣམ་པར་གཅེས་། བྱས་ཀྱང་།",
    "བདུད་སྟོབས་བསྟེན་པའི་མཐུ་ཡིས་བཅོམ་པར་གྱུར།",
    "འཇིག་རྟེན་རྣམ་པར་འདྲེན་པས་ཟིལ་གྱིས་མནན།",
    "དེ་ཚེ་བསྟེན་པར་དཀའ་བ་སྡུག་བསྔལ་གྱུར།",
    "འགྲོ་བ་དེ་དག་བདག་ལས་གྲོལ་བར་བྱས།",
    "དེ་ཚེ་ཐུབ་པར་དཀའ་བའི་བདུད་ལས་རྒྱལ།",
    "ང་ཡི་སྲས་ཀྱིས་དེ་ལྟར་བསླབ་པར་བྱ།",
    "ཡིད་ཀྱིས་ཡིད་ཀྱིས་རྣམ་པར་བསམ་པར་བྱོས།",
    "བདག་མེད་བདག་དང་མི་གཙང་གཙང་འཛིན་པ།",
    "དྲན་པ་ཉམས་པའི་འགྲོ་བ་འདྲེན་པ་ལགས།",
    "རྒྱལ་བ་དྲན་པ་ཉེ་བར་གཞག་པ་མཁྱེན།",
    "ཀླུ་བདག་དེ་ཡིས་སྔོན་ནི་བསྙེན་བཀུར་བྱས།",
    "སྤྱོད་ཡུལ་དང་ནི་སྤྱོད་ཡུལ་མ་ཡིན་མཁྱེན།",
    "སྤྱད་པར་བགྱི་ཞིང་བདུད་ཀྱི་སྤྱོད་ཡུལ་སྤང་།",
    "རྒྱལ་བ་ཐུབ་ལ་མཁྱེན་པས་བསྟོད་ནས་སུ།",
    "གང་དག་ཐོས་ནས་ཐབས་མཁས་མཉམ་པར་རྩོམ།",
    "བདག་ཉིད་གཏོང་ལ་ཞུམ་པར་མི་འགྱུར་རོ།",
    "དེ་ནི་གང་དུའང་གནས་པར་མི་འཇིག་སྟེ།",
    "དཔག་མེད་གཤེགས་པ་དེ་དག་བདག་ལ་གསུངས།",
    "རྒྱལ་བ་མི་མཆོག་རང་བྱུང་མཁྱེན་པས་སུ།",
    "དེ་ཡིས་ལེགས་པའི་ལས་དེ་བྱས་པས་ན།",
    "དེ་ཡི་འཁོར་ནི་ཐམས་ཅད་མཐུན་པར་འགྱུར།",
    "བྱམས་པའི་སེམས་ཀྱིས་ཉེས་པ་རྣམ་པར་བཏུལ།",
    "ཡོངས་སུ་དག་ལ་ཤིན་ཏུ་གནས་མཁྱེན་ནས།",
    "གཏི་མུག་རྣམ་པར་བཅོམ་ཞིང་བདུད་ལས་རྒྱལ།",
    "རྒྱལ་བས་དེ་ཡི་བསམ་པ་མཁྱེན་པ་ན།",
    "རབ་ཏུ་སེམས་དང་ཚིག་ནི་གཙང་བ་དང་།",
    "འགྲོ་བ་ཀུན་གྱི་བསམ་པ་རྣམ་པར་མཁྱེན།",
    "རང་སེམས་ཤེས་པར་བྱ་ཕྱིར་བརྩོན་འགྲུས་བརྟན།",
    "རང་སེམས་ཤེས་པར་བྱ་ཕྱིར་ངེས་པར་གྱུར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཀླུའི་རྒྱལ་པོ་དེ་དག་ཐམས་ཅད་ཀྱི་བསམ་པ་མཁྱེན།",
    "ལས་ཀྱང་མཁྱེན།",
    "རྗེས་སུ་ཆགས་པའི་རྟགས་དག་སྟོན་པར་བྱེད་རྗེས་སུ་འཛིན་པའི་རྟགས་དག་སྟོན་པར་བྱེད།",
    "འདྲེན་པའི་རྟགས་དག་སྟོན་པར་བྱེད།",
    "རྣམ་པར་འདྲེན་པའི་རྟགས་དག་སྟོན་པར་བྱེད།",
    "མུར་བྱེད་པའི་རྟགས་དག་སྟོན་པར་བྱེད་དེ།",
    "ཡིད་བདེ་བ་སྐྱེས་པས་སྤྱད་པ་སྤྱོད་པར་འགྱུར་ལགས་སོ།",
    "བདག་གནས་ཤེས་པ་ཐོབ་པར་གྱུར་ཅིག།",
    "ཞེས་བྱ་བ་རྗེས་སུ་གནང་སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་གསུངས་སོ།",
    "བསམ་གཏན་པ་ཡི་གནས་བྱས་ཤིང་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་གསུངས་སོ།",
    "གནས་ནི་ཤེས་པར་བྱ་བའི་ཕྱིར།",
    "ངའི་སེམས་རྣམ་པར་མ་གཡོས་ཤིང་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་གསུངས་སོ།",
    "རྐང་གཉིས་མཆོག་ནི་དེ་མཁྱེན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་མི་གནས་པར་དྲུག་ཁྲི་བརྒྱད་སྟོང་བྱུང་ངོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་གསུངས་སོ།",
    "བག་ཡོད་པས་གནས་མ་ཡིན་པ་ཤེས་པ་འགོག་པར་འགྱུར་པའི་ལམ་ཤེས་པར་ཡོངས་སུ་བསྔོ་བར་བྱའོ།",
    "དེ་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་དེས་ཞབས་ཤིན་ཏུ་བརྟན་པར་གནས་ཏེ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་དེས་ང་གནས་མ་ཡིན་པ་ཤེས་པ་འགོག་པར་འགྱུར་བའི་ལམ་ཤེས་པ་བརྙེས་སོ།",
    "སྦྱིན་བདག་དམ་བཅས་པར་དོན་ཡོད་པར་བྱེད་པ།",
    "བདག་སློང་འབྲས་བུ་ཡོད་པར་རྒྱལ་པོས་མཛོད།",
    "རལ་པའི་ཐོར་ཆུགས་ཅན་དེ་མཐོང་ནས་རྒྱལ་པོ་དེ་འཇིགས་ཤིང་སྐྲག་ལ་མི་དགའ་སྟེ་བ་སྤུའི་ཁུང་བུ་ཟིང་ཞེས་བྱེད་པར་འགྱུར་པ་ནས་འཇིགས་པར་སེམས་པའི་རྗེས་སུ་ཞུགས་པའི་བར་དུ་གྱུར་ཏེ།",
    "རྒྱལ་པོའི་ཁྱད་པར་དུ་འཕགས་པའི་ཚུལ་ཐམས་ཅད་དང་ལྡན་པ་ཞིག་བྱུང་བར་གྱུར་ཏོ།",
    "འདི་ལྟར་དེའི་བདག་པོར་མི་དགའ་བར་འགྱུར་བས་དམ་བཅས་པ་གཞིག་པར་བྱའོ།",
    "ཡབ་ཅིག་དགོངས་ཤིང་ཤིན་ཏུ་དགོངས་པར་མཛོད།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་གསུངས་སོ།",
    "སྤྱོད་དང་བསམ་པ་ངེས་པར་དེ་ཡི་མཐུས།",
    "དེ་དག་ཐམས་ཅད་ཀྱི་རིམ་གྲོ་པར་ཡང་དགེ་སློང་ཡིད་འོང་དེ་གྱུར་ཏོ།",
    "དེའི་རིམ་གྲོ་པར་ཡང་དགེ་སློང་ཡིད་འོང་དེ་གྱུར་ཏེ།",
    "དེའི་ཚེ་དེའི་དུས་ན་དགེ་སློང་ཡིད་འོང་ཞེས་བྱ་བར་གྱུར་པ་དེ་གཞན་ཡིན་པར་སེམས་ན།",
    "དྲན་པ་ཤེས་པ་དེ་ངས་སྐྱེ་བོ་མང་པོ་ཡང་དག་པར་འཛིན་དུ་བཅུག་ཅིང་།",
    "དེ་ལྟ་བུ་རབ་ཏུ་ཤེས་པར་མི་འགྱུར་ཏེ།",
    "ཐོས་ནས་ཀྱང་དེ་བཞིན་གཤེགས་པ་དེའི་དྲུང་ནས་ངོ་མཚར་དུ་བྱ་བ་གཞལ་དུ་མེད་པ་ཞིག་སྐྱེས་པར་གྱུར་ཏེ།",
    "དེའི་ཚེ་དེའི་དུས་ན་བྲམ་ཟེ་བློ་ལྡན་ཤིང་སཱ་ལ་ཆེན་པོ་ལྟ་བུར་གྱུར་པ་དེ་གཞན་ཡིན་པར་སེམས་ན།",
    "ད་ལྟར་བྱུང་བའི་ཤེས་པ་དེའང་ངས་མངོན་སུམ་དུ་བྱས་ཤིང་ཡང་དག་པར་རབ་ཏུ་བསྟན་པས་སྐྱེ་བོའི་ཚོགས་མང་པོ་དག་ཀྱང་མངོན་སུམ་དུ་བྱས་སོ།",
    "མི་གཙང་བའོ།",
    "འདི་ལྟ་སྟེ་མཚན་མ་ཐམས་ཅད་ཡིད་ལ་མི་བྱེད་པ་འྡིའང་ཐམས་ཅད་ཀྱི་སྤྱོད་པ་ཐེ་ཚོམ་མེད་པའི་ལམ་འཆིང་བ་ཐམས་ཅད་ཡང་དག་པར་གཅོད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་དེའི་དུས་ན་རྒྱལ་རིགས་ས་གའི་བཤེས་གཉེན་ཤིང་སཱ་ལ་ཆེན་པོ་ལྟ་བུར་གྱུར་པ་དེ་གཞན་ཡིན་པར་སེམས་ན།"
  ]
}