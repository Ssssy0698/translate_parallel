    "གཞན་ལ་སྦྱིན་པར་མི་བྱ།",
    "ཀུན་དུ་སྤྱད་པ་ཇི་སྐད་བསྟན་པ་བཞིན་མ་བྱས་ན།",
    "ལྷུང་བཟེད་འབྲེལ་པ་མེད་པ་འཆང་བས་ཀུན་དུ་སྤྱད་པ་ནི་ལྷུང་བཟེད་ཀྱི་སྣོད་གཉིས་ཉེ་བར་གཞག་པར་བྱའོ།",
    "བཟང་པོ་ནི་དེར་གཞུག་པར་བྱའོ།",
    "གཉི་ག་ཡང་ཁྱེར་ཏེ་བསོད་སྙོམས་ལ་འཇུག་པར་བྱའོ།",
    "འབྲས་ཆན་སྐམ་པོ་ནི་དེར་གཞུག་པར་བྱའོ།",
    "བསྲེག་པའི་རྫ་བོ་བཟང་པོ་ནི་དེ་བསྲེག་པར་བྱའོ།",
    "འགྲོ་ན་ཡང་ལྷུང་བཟེད་ཀྱི་སྣོད་བཟང་པོར་དེ་གཞུག་པར་བྱའོ།",
    "དེ་མེད་ན་ཕྲག་པ་གཡོན་པར་ནི་དེ་གདགས་པར་བྱའོ།",
    "གཡས་པར་ནི་བྱིན་གྱིས་བརླབས་པའོ།",
    "དེ་དག་ཅི་སྐད་བསྟན་པ་བཞིན་མ་བྱས་ན་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ།",
    "དེས་དེ་ཉིད་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "མི་ཕོངས་པར་བྱ་བའི་ཕྱིར་དེ་དེ་ལ་སྦྱིན་ནོ་ཞེས་ཟེར་རོ།",
    "སྐྱོ་སྟེ་ཅི་ནས་མྱུར་དུ་ཆག་པར་འགྱུར་བ་དེ་ལྟར་མི་བྱའོ།",
    "དེ་ལྟར་བྱས་ན་ཉེས་བྱས་སོ།",
    "གཞན་དག་ནི་མཛའ་བོ་རྣམས་ལ་བགོས་སྟེ་སྦྱིན་པར་བྱའོ།",
    "བཞི་གླན་པར་འོས་པ་ལས་གླན་ཏམ་མ་གླན་ཀྱང་རུང་ཡོངས་སུ་ལོངས་སྤྱད་པར་བཟོད་ན་བཟང་པོ་འདོད་པའི་ཕྱིར་གཉིས་པ་ཚོལ་ན་སྦྱོར་བའི་ཚེ་ཉེས་བྱས་སོ།",
    "དེ་བཞིན་དུ་ལྔས་གླན་པར་འོས་པ་ལས་མ་གླན་ཅིང་ཡོངས་སུ་ལོངས་སྤྱད་དུ་བཟོད་པ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "ལྔས་གླན་པར་འོས་པ་ལས་གླན་ཏམ།",
    "མུ་སྟེགས་ཅན་ལས་བཙལ་ན་ཉེས་བྱས་སོ།",
    "ཉེ་དུ་ལ་རྗེས་སུ་གནང་བ་དང་།",
    "གདིང་བ་སྲིན་བལ་སར་པ་ལས་བྱས་པ་དང་།",
    "ཉེ་དུ་མ་ཡིན་པ་ལས་གོས་ཀྱི་ཕྱིར་དོག་པ་བསླངས་ན་ཉེས་བྱས་སོ།",
    "དོག་པ་གང་ཡང་རུང་བ་བདག་ཉིད་ཀྱིས་བཏགས་ན་ཉེས་བྱས་སོ།",
    "ཐག་པ་ཉེ་དུས་གྲོགས་བྱས་སམ།",
    "བདག་ཉིད་ཀྱིས་གྲོགས་བྱས་ཏེ།",
    "ཉེ་དུ་ལ་ཉེ་དུར་འདུ་ཤེས་པ་ལ་སོགས་པ་མུ་བཞིར་སྦྱར་བ་ནི་དགེ་སློང་མའི་བསླབ་པའི་གཞི་བཞིན་དུ་རིག་པར་བྱའོ།",
    "གལ་ཏེ་བདག་ཉིད་ལ་ཡང་དག་པ་མ་ཡིན་པའི་ཡོན་ཏན་བསྔགས་པ་བརྗོད་ཅིང་དོག་པ་བསླངས་ན་ཉེས་བྱས་དང་ཕམ་པར་འགྱུར་བ་སྟེ།",
    "ཡང་དག་པ་མ་ཡིན་པའི་ཡོན་ཏན་བསྔགས་པ་བརྗོད་ཅིང་འཐག་ཏུ་བཅུག་ན་ཕམ་པར་འགྱུར་བ་དང་སྤང་བའོ།",
    "དེ་ལ་དུས་མ་ཡིན་པར་ཉེ་དུ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "དེ་ལ་དུས་མ་ཡིན་པ་ནི་གང་རུང་བ་མ་ཡིན་པར་འགྱུར་བ་དང་།",
    "སྦྱིན་བདག་ཉེ་དུ་མ་ཡིན་པར་གྱུར་ན་ཉེས་བྱས་སོ།",
    "སྣམ་བུ་མ་བྱས་པའམ།",
    "གཞན་གྱི་ཕྱིར་ཡང་འཐག་ཏུ་བཅུག་ན་ཉེས་བྱས་སོ།",
    "སྔར་མ་བསྟབས་པར་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་རྟོག་པ་འགའ་ཞིག་ཅེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་རྣམ་པ་བཞི་སྟེ།",
    "སྟུག་པོ་ཉིད་དུ་རྣམ་པར་རྟོག་ནས།",
    "གང་ལེགས་པ་བརྟགས་པར་གྱིས་ཤིག་ཅེས་སྨྲ་བ་དང་།",
    "དཀར་པོ་རྣམ་པར་རྟོག་ནས་ཤིན་ཏུ་དཀར་བ་གང་ཞེང་ཆེ་བ་དང་།",
    "འཇམ་པོར་རྣམ་པར་རྟོག་ནས་ཐགས་རན་བཟང་བར་གྱིས་ཤིག་ཅེས་སྨྲས་པའོ།",
    "ལེགས་པར་བརྟགས་པར་ཞེས་བྱ་བ་འདིས་ཚད་རྣམ་པར་རྟོག་པར་ཡང་བལྟ་བར་བྱའོ།",
    "གཞན་དག་ནི་ཞེང་ཆེ་བ་དང་ཁྲུན་རིང་བ་ལ་སྨྱིག་གུས་ལེགས་པར་སྦྱངས་པའམ།",
    "གོས་མ་ཐོབ་པའི་བར་དེ་སྲིད་དུ་ཉེས་བྱས་སོ།",
    "གོས་ཀྱི་ཕྱིར་རྣམ་པར་རྟོག་པར་བྱེད་ན་ཉེས་བྱས་སོ།",
    "བཞིའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པའོ།",
    "ལུས་ཀྱིས་ཁྲོས་པར་སྟོན་ཏོ།",
    "ཡི་མ་རངས་པར་གྱུར་ཅེས་བྱ་བ་ནི་ཁྲོས་པའི་མཚན་མ་གནོད་པའི་དངོས་པོར་སྟོན་པའོ།",
    "རྣམ་པ་གཞན་དུ་ནི་ཕམ་པར་འགྱུར་རོ།",
    "དེའི་ལྷག་མ་ཡོད་པ་ཕྱིར་སྦྱིན་པར་བྱ་ཞིང་ཞེས་བྱ་བ་ནི་གང་དེར་ཡོངས་སུ་ལོངས་སྤྱོད་པའི་ལྷག་མ་ལུས་པར་གྱུར་ན་དགེ་སློང་དེ་ཉིད་ལ་ཕྱིར་སྦྱིན་པར་བྱའོ།",
    "གོས་ཀྱི་གྲྭ་ལུས་དང་མ་བྲལ་གྱི་བར་དུ་ནི་ཉེས་བྱས་སོ།",
    "དགེ་ཚུལ་ལ་སོགས་པ་ནི་ཉེས་བྱས་སོ།",
    "ཡོངས་སུ་སྤྱད་པ་ལ་ཡོངས་སུ་མ་སྤྱད་པར་འདུ་ཤེས་སམ།",
    "ཡོངས་སུ་སྤྱད་པ་ལ་ཡོངས་སུ་སྤྱད་པར་འདུ་ཤེས་ན་ལང་པ་དང་སྤང་བའོ།",
    "གཉི་ག་ཡང་མཚན་གྱུར་ན་ཉེས་བྱས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འགོད་ན་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "གཉིས་ཀྱི་ལས་ཀྱིས་གོས་སྦེད་པ་བསྐོ་བར་བྱའོ་ཞེས་གསུངས་སོ།",
    "དེ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་དབྱར་གྱི་ནང་ལོགས་སུ་གོས་རྙེད་པ་ལ་རྗེས་སུ་གཟུང་བར་མཛད་ནས་གསུངས་པའོ།",
    "རུང་བར་མ་བྱས་པ་ལ་རུང་བར་མ་བྱས་བར་འདུ་ཤེས་ན་སྔ་མ་བཞིན་ཏེ།",
    "འོན་ཀྱང་གཙུག་ལག་ཁང་ཉིད་དུའོ་ཞེས་གསུངས་སོ།",
    "དེ་ལས་རིང་དུ་མ་གནས་ཤིག་ཅེས་གསུངས་ན།",
    "དོགས་པ་དང་བཅས་པ་ཞེས་བྱ་བ་ནི་དེ་ནི་དོགས་པ་དང་བཅས་པར་ཤེས་པ་སྟེ།",
    "འཇིགས་པ་དང་བཅས་པར་གྲགས་པ་ཞེས་བྱ་བ་ནི།",
    "གང་དུ་ཆོམ་རྐུན་པས་འཇིགས་པ་ལན་ཅིག་བྱུང་བ་དེ་ཡང་ཤེས་ལ་མི་རྣམས་སྟབས་ཤིང་བྲོས་པར་སྣང་བའོ།",
    "འཇིགས་པ་ཐ་དད་པས་འཇིགས་སུ་རུང་བ་དང་བཅས་པར་གྲགས་པར་ཞེས་བྱ་བ་ནི།",
    "འཇིགས་པ་ཐ་དད་པས་འཇིགས་སུ་རུང་བ་དང་བཅས་པར་གྲགས་པའོ།",
    "སྟག་ལ་སོགས་པས་འཇིགས་པ་ན་ཆོམ་རྐུན་པས་གནས་པར་ཡང་རིག་པར་བྱའོ།",
