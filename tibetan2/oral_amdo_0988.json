    "ཏིང་ངེ་འཛིན་ལ་བརྟན་པ་མ་ཐོབ་ཀྱང་མོས་མནོ་ཙམ་གྱིས་ཐུན་རེའི་ནང་དུ་སྲུང་འཁོར་ནས་གོ་བགོ་ལུས་སྲུང་བར་གྱི་སྒྲུབ་ཐབས་ཚང་བ་རེ་ཉམས་སུ་ལེན་པ་མོས་སྒོམ་དང་།",
    "མོས་སྒོམ་འདི་ལ་བསྐྱེད་རིམ་གྱིས་ཁྱབ་ཅིང་།",
    "དེར་ཐུན་རེའི་ནང་དུ་ཚང་བར་སྒོམ་རྒྱུའི་ཏིང་ངེ་འཛིན་ནི་རྒྱ་སྤྲོས་མན་ཆད་ཀྱི་བཞི་པོ་ཙམ་ཡིན་ཡང་།",
    "སེམས་བརྟན་པའི་མཚན་མ་མ་མཐོང་པའི་སྒྲུབ་པ་པོ་མང་པོས་ཚོགས་སྒྲུབ་བྱེད་པའང་མོས་སྒོམ་དུ་བཞག་དགོས་པས་སྤྱིར་མོས་སྒོམ་གྱི་ལྔ་ཀ་ཡོད་དོ།",
    "གོམས་པའི་ཉམས་བྱང་ཐང་གི་དལ་འབབ་ལྟ་བུ།",
    "འདིའི་རྒྱ་གཅིག་གི་བསྐྱེད་རིམ་ལྟ་བུ་ནི་རྫོགས་རིམ་ཐོབ་ལ་མ་ཉམས་པའི་རྒྱུད་ཀྱི་བཅོས་མའི་རྣལ་འབྱོར་ཡིན་པས།",
    "དེ་ལྟ་བུའི་རིམ་པས་སྤྲོས་བཅས་ཀྱི་བསྐྱེད་རིམ་མཐར་སོན་པ་ན་ཚོགས་སྒྲུབ་ཀྱིས་འདོད་གཟུགས་གང་རུང་གི་རིག་འཛིན་བསྒྲུབས་ཏེ་མཁའ་སྤྱོད་ཀྱི་ཞིང་སོགས་ཉུལ་ཞིང་དཔའ་བོ་མཁའ་འགྲོའི་ཚོགས་དང་ལྷན་ཅིག་ཏུ་རྫོགས་རིམ་ལ་བརྟེན་ནས་ལམ་ལྔ་མཐར་དབྱུང་བ་སྟེ།",
    "དེ་འདྲའི་དཀྱིལ་འཁོར་དང་ཚོམ་བུ་སྤྲོ་བ་གཉིས་དང་གྲངས་དང་ཞལ་ཕྱག་རྒྱ་སྤྲོ་བ་སྟེ་ཕྱག་རྒྱ་སྤྲོས་བཅས་ཀྱི་དབྱེ་བ་བཞི།",
    "རྒྱས་པ་དེའི་སྟེང་དུ་རིག་ཆུང་གི་སེམས་དཔའ་ཡབ་ཡུམ་བཞི་བཅུ་བསྣན་པས་བརྒྱད་ཅུ་རྩ་གཉིས་པ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་རིགས་གསུམ་གྱི་གཙོ་བོ་རིགས་ཆུང་དང་བཅས་པ་ལ་ཁྲོ་བོ་བཅུ་ལས་སྟེང་འོག་གི་ཁྲོ་བོ་སྤངས་པའི་ཡབ་ཡུམ་ཟུང་བརྒྱད་བསྣན་པས་ཞེ་དྲུག་མ་དང་།",
    "བུད་ྡྷདང་པདྨའི་གཙོ་འཁོར་ཡང་བསྣན་པའི་གོ་བརྒྱད་མ་དང་།",
    "བསམ་ཡས་ལྷུན་གྲུབ་སྟེ་སྤྲོ་བ་གསུམ་མོ།",
    "སླར་དེ་རྣམས་ཐུན་རེའི་ནང་དུ་ཚང་བར་བསྒོམ་སྟེ་བོགས་འདོན་པའམ་ཁྱད་པར་དུ་འགྲོ་བར་བྱེད་པ་ནི་ཚོམ་བུ་ཚོགས་སྒྲུབ་ཡིན་ཏེ།",
    "དཀྱིལ་འཁོར་ཕྱེ་བ་དེ་རང་ལ་བསྟིམ་ཞིང་ཚོགས་མཆོད་སོགས་བྱེད་པ་ནུབ་དང་པོའི་བསྙེན་པ་སྟེ་བསྙེན་པའི་ཡན་ལག།",
    "བརྩོན་འགྲུས་དྲག་པོས་བསྒྲུབས་པས་ཟླ་དྲུག་ལ་སོགས་པའི་དུས་ངེས་པ་ཅན་ན་ཕྲ་ཡང་སོགས་ཀྱི་ཡོན་ཏན་དང་ལྡན་པའི་རིག་འཛིན་གྱི་ལུས་འདོད་གཟུགས་གང་རུང་གི་ལྷ་དང་རྗེས་སུ་མཐུན་པར་ཐོབ་སྟེ།",
    "འདི་ལྟ་བུའི་རིག་འཛིན་ནི་ཐུན་མོང་གི་དངོས་གྲུབ་ཆེན་པོའོ།",
    "ཐ་མས་དྲུག་ན་འགྲུབ་པ་སོགས་ཀྱི་ཁྱད་གསུངས་པ་ལ་འཛབ་འཐོར་འདྲིལ་གྱི་ཁྱད་དུ་བཞེད་པའང་ཡོད་མོད་ཀྱི།",
    "མ་ཧཱ་ཱཡོ་གའི་རྒྱུད་གཞན་ལས་ཚོགས་སྤྱོད་ཀྱི་མཐར་ཐུན་མོང་གི་གྲུབ་པ་ཆེན་པོ་སྒྲུབ་པ་ལ་ད་དུང་སྦྱིན་སྲེག་དང་འཁྲུལ་འཁོར་སོགས་པར་དུ་བརྒྱུད་དགོས་པར་གསུངས་ཤིང་།",
    "བློ་ཆུང་གདམས་ངག་གི་སྟོབས་ཀྱིས་འཇོག་པ་གཉིས་ཏེ།",
    "དེ་ལྟ་བུའི་འོད་གསལ་དེ་ལ་འཁྲུལ་པའི་ཀུན་རྟོག་གིས་སྟོང་པས་སྟོང་པ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ཞེས་བྱ་སྟེ།",
    "འདིའི་ཚེ་སྟོང་གཟུགས་ཤར་བ་དེ་ལ་གཙོ་བོར་མི་བྱེད་པར་འོད་གསལ་རང་གི་བཞུགས་ཚུལ་མི་རྟོག་པའི་དབྱིངས་ལ་བསྲེ་བ་རྩལ་འདོན་བྱེད་པར་མངོན་ནོ།",
    "དེ་བརྟན་པའི་ཚེ་སྟོང་གཟུགས་ལ་ལས་རུང་གི་ཡོན་ཏན་ཁྱད་པར་ཅན་ཐོབ་པས།",
    "གང་ལྟར་ཡང་འཕེན་པའི་རྐྱེན་ལ་བརྟེན་ནས་སྟོང་གཟུགས་དེ་ཐམས་ཅད་ལྷ་སྐུ་ཕྱག་རྒྱ་གཅིག་པའི་རྣམ་པར་སད་པ་ནི་རྒྱ་གཅིག་གི་རྣལ་འབྱོར་ཏེ།",
    "སྟོང་གཟུགས་ཀྱི་ལྷ་སྐུ་ཇི་སྙེད་ཤར་ཡང་ཀུན་བཟང་ཡབ་ཡུམ་ལྟ་བུ་གཅིག་གི་རྣམ་པ་ཅན་དུ་མཚུངས་པས་དེ་ལྟར་བརྗོད་ཀྱི།",
    "ཟུང་འཇུག་གི་སྐུ་དངོས་མིན་ནོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་དང་ཚོམ་བུའི་འཁོར་ལོ་སྤྲོ་བའི་བསྐྱེད་རིམ་གྱི་རྐྱེན་ཅུང་ཟད་ལས་སྟོང་གཟུགས་ཀྱི་ལྷ་གཙོ་འཁོར་དང་ཚོམ་བུའི་རྣམ་པ་མཐའ་ཡས་པ་དང་།",
    "དེ་བཞིན་དུ་ཉིན་མོ་ཏིང་ངེ་འཛིན་གང་ལ་སློབ་པ་དེ་ཉིད་མཚན་མོའི་རྣལ་འབྱོར་དུ་འཁྱེར་ཚུལ་ཡང་རྒྱུད་འགྲེལ་ལས་སྟོང་ཆེན་གྱི་སྐབས་སུ་སད་པའི་དུས་ཀྱི་འོད་གསལ་དང་མཚན་མོའི་གཉིད་འཐུག་གི་འོད་གསལ་གཉིས་སྦྲེལ་ཏེ་ཉམས་སུ་ལེན་པ་དང་།",
    "ཚོགས་སྒྲུབ་ཀྱི་སྐབས་སུའང་རྒྱ་སྤྲོས་ཀྱི་ཏིང་ངེ་འཛིན་ཕུལ་དུ་བྱུང་བ་ཡོད་མོད་ཀྱི།",
    "ཤེས་འཇུག་གི་མཚན་ཉིད་དེ་དག་ལ་ཚོགས་སྦྱོར་གྱི་ལམ་གཉིས་ཀྱི་རྣམ་བཞག་བྱ་བའི་ཚུལ་ནི།",
    "རང་བཞིན་གྲུབ་པའི་རྣལ་འབྱོར་རམ་མ་བཅོས་པའི་རྣལ་འབྱོར་འབའ་ཞིག་ཏུ་སོང་བ་ན་སྦྱོར་ལམ་པར་འཇོག་སྟེ།",
    "ཞེན་པ་ཕྱིན་ཅི་ལོག་གི་སྒྲོ་འདོགས་ཉོན་མོངས་པའི་དང་།",
    "དེས་ན་གང་ཟག་གཅིག་གིས་རིག་འཛིན་འདི་གཉིས་ཀ་བགྲོད་པ་ནི་མི་སྲིད་དེ།",
    "རིག་འཛིན་ཕྱི་མ་གཉིས་སུ་ལྷན་ཅིག་གནས་པ་དང་བག་ལ་ཉལ་གྱི་དྲི་མ་ཕྲ་མོ་སྤང་བར་གསུངས་པའི་དྲི་མ་རྣམས་ནི་ཤེས་སྒྲིབ་ཁོ་ན་ཡིན་ཏེ།",
    "དེ་དག་གི་དཀའ་བའི་གནས་ལ་དཔྱོད་པའི་སྒོ་ཅུང་ཟད་བཏོད་ན།",
    "རྣམ་སྨིན་རིག་འཛིན་ནི་སེམས་ཡི་དམ་གྱི་ཕྱག་རྒྱར་སྨིན་པའི་མོས་སྤྱོད་པ་དང་།",
    "དེ་ལྟར་གཉིས་ཡོད་པ་བཞིན་དུ་དེ་དག་གིས་ཐོབ་པའི་མཐོང་ལམ་གཉིས་ཀྱང་ཁྱད་ཆེ་བས།",
