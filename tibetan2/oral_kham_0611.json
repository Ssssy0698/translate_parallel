    "བརྩམས་སྒྲུང་ཧྲིལ་པོ་སྐྱེ་ཁུངས་དང་རང་གཤིས།",
    "ཞེས་པ་ལྟ་བུའི་དྲི་བ་བཏོན་འདུག་པ་དང་།",
    "འཚོ་བའི་འགལ་ཟླ་བཅས་མཚོན་འདུག་ཅིང་།",
    "རྫི་བོ་ལ་ཚེ་ཐར་གྱི་ཆེད་དུ་མིག་ཆུ་ཐིགས་པ་གཅིག་བཞུར་བའང་བྲིས་མི་འདུག་ཡིན་ནའང་།",
    "རྩོམ་པ་པོས་ཕྱོགས་མང་པོ་དང་སྣེ་དུ་མ་ནས་གསར་བཞེངས་བྱས་པའི་མི་སྣ་འདི་བོད་ཀྱི་དཔེ་མཚོན་མི་སྣ་ཞིག་ཏུ་སྒྲུབ་བཞེངས་བྱས་འདུག་སྟེ།",
    "འགྲོ་འདུག་ཉལ་འཆག་བཟའ་བཏུང་ཡོ་བྱད་སོགས་དངོས་པོའི་འཚོ་བར་རྒྱུས་ལོན་ཡོད་དགོས་པ་མ་ཟད།",
    "འོན་ཀྱང་རང་དམན་གྱི་འདུ་ཤེས་སྐྱེས་ནས་ལྷ་སྒྲོན་དང་མཉམ་དུ་འཚོ་བ་བསྐྱལ་ན་ལྷ་སྒྲོན་ལ་བགེགས་དང་བར་ཆད་ཡོང་ངེས་སྙམ་གྱི་ཡོད།",
    "ལྷ་སའི་གྲོང་མི་རྣམས་རང་རང་འཁོས་འབྱོར་ལ་གཞིགས་པའི་རྒྱན་གོས་ཀྱི་གཟབ་འཕྱོར་སྤྲས་ཤིང་།",
    "དམངས་ཁྲོད་ཀྱི་འགུལ་སྐྱོད་སྣ་ཚོགས་བཅས་གསལ་རྟོགས་ཐུབ་པའི་དགེ་མཚན་ལྡན་འདུག་༤ གཙུག་གཡུ་ཡི་བརྗོད་བྱའི་བསྟན་དོན་དང་སྒྱུ་རྩལ་རིན་ཐང་སྐོར།",
    "དེ་བས་ཁོས་རང་ལ་ཡིད་ཆེས་དང་རང་དང་སྐྱེས་ཁུངས་གཅིག་འདྲ་ཡིན་པའི་ཕུ་ནུ་དག་ལ་རྒྱབ་རྟེན་བྱས་ན།",
    "བོད་ཀྱི་བརྩམས་སྒྲུང་གསར་རྩོམ་ཐད་མིག་དཔེ་ལྟ་བུའི་ནུས་པ་ཐོན་འདུགབཞི་པ།",
    "སྐལ་བཟང་བཀྲ་ཤིས་ཀྱི་ཁོམ་ལོང་མེད་ཚུལ་དང་བྲེལ་ཟིང་ཆེ་ཚུལ་འབྲི་སྐབས་ཁོ་རང་ནངས་སྔ་ལངས་དང་དགུང་འཕྱི་ཉལ་བྱེད་པ།",
    "ཁོ་རང་ལན་པ་ཡིན་ནམ།",
    "ཁོ་རང་ཕ་ཡུལ་དུ་ལོག་རྗེས།",
    "ལག་པས་མ་ཎི་འཁོར་ལོ་བར་མེད་བསྐོར་བའི་བོད་མི་རྣམས་ཀྱིས་གཞན་ཕན་དང་བྱམས་སེམས་ཀྱི་འཛུམ་བག་ནམ་ཡང་གདོང་ལ་བསྐྱིལ་འདུག་པ་སོགས་ལ་མཉམ་སྣང་འཇོག་པ་མ་ཟད།",
    "ཁོ་རང་རྩོམ་རིག་གསར་རྩོམ་གྱི་ལམ་ལ་སྐུལ་བ་དང་།",
    "ཁོ་རང་ལ་ཆ་རྒྱུས་ཡོད་པའི་དམངས་ཁྲོད་གཏམ་རྒྱུད་ཁྲོད་ཀྱི་རྐུན་ཇག་བྱེད་པའི་བྱུང་རིམ་འདྲ་མཚུངས་རྣམས་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པ་དང་ཆབས་ཅིག་བོད་ཡུལ་དུ་གེ་སར་སྒྲུང་དར་ཁྱབ་ཆེ་བ་དང་།",
    "དེ་ལ་བཀུར་བསྟི་བྱེད་པའང་རང་སེམས་ཀྱི་འཕྲུལ་སྣང་ལ་བཀུར་བསྟི་བྱེད་པ་ཁོ་ན་ལས་མ་འདས།",
    "ནམ་ཡང་རང་བྱུང་ཁམས་ཀྱི་བྲན་གཡོག་བྱེད་པ་ཙམ་དུ་ཟད་དེ།",
    "ནག་ཕྱོགས་མ་རུངས་བ་ཚར་གཅོད་བྱེད་མཁན་གྱི་དཔའ་བོ་བློ་རིག་དང་དྲག་རྩལ་ལ་མཁས་པ་ཞིག་ཏུ་བྲིས་འདུག་ཀླུ་འབུམ་མི་རྒོད་དྭ་ཕྲུག་ཏུ་ལུས་པ་དང་།",
    "དེ་ནི་འུད་ཆེན་པོས་བརྗོད་པའི་དམངས་ཁྲོད་གཏམ་རྒྱུད་ཀྱི་ས་བོནཀྱང་ལོས་ཡིན་སྙམ་པ་ཞིག་བློ་ལ་འགོག་མེད་དུ་འཆར།",
    "རང་ཕྱོགས་སྐྱོང་བའི་དཔུང་གཉེན་བཅས་ཡིན་པའི་དྲང་ཕྱོགས་དཔའ་བོ་ཞིག་ཏུ་བཞེངས་སྐྲུན་བྱས་འདུག་ལ།",
    "སྒྱུ་རྩལ་ནུས་པ་བསམ་གྱིས་མི་ཁྱབ་པ་ཙམ་ལ་བསླེབས་འདུག་པ་དང་།",
    "མཁས་རྨོངས་བར་གསུམ་གྱིས་རང་རང་དང་འཚམས་པའི་བྲོ་བ་མྱོང་རྒྱུ་ཡོད།",
    "བུ་ཁྲམ་པ་ང་ལ་འདུག་གདན་མེད།",
    "ད་དུང་རང་ཉིད་ཀྱི་གསར་རྩོམ་ལག་ལེན་དངོས་ལས་མི་རིགས་རང་ཉིད་ཀྱི་སྐད་དང་ཡི་གེ་ལ་བརྟེན་ནས་གསར་རྩོམ་བྱེད་རྒྱུ་དེ་ནི་བོད་ཀྱི་རྩོམ་རིག་མི་ཉམས་གོང་དུ་སྤེལ་བའི་ཐབས་ལམ་ཉག་གཅིག་ཡིན་པ་ར་སྤྲོད་བྱས།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ་བཅས་ཕྱོགས་བཞི་ལ་གོ་དགོས་པ་དང་།",
    "སེམས་པས་འགོག་ཐབས་རང་མི་འདུག།",
    "ང་རང་དབེན་འཇམ་གྱི་གཉིད་ལས་སད་ཚེ།",
    "བསམ་བློའི་འདུ་ཤེས་དེའི་འབྱུང་ཁུངས་ནི་ཁོང་རང་བསྐྱེད་ཅིང་གསོས་པའི་མཐོ་སྒང་འདི་དང་།",
    "སྐབས་འདིར་སྙན་ངག་མཁན་གྱིས་ང་རང་།",
    "དེ་དུས་ཁྱེད་ཀྱིས་ང་རང་ཁྲིད་དེ་མཚོ་སྔོན་པོའི་རླབས་རྒྱུན་ལ་ཞུགས་ཤིང་།",
    "རང་བཀུར་རང་གཅེས་ཀྱི་འདུ་ཤེས་ཀྱང་རུས་རྐང་དུ་སིམ་འདུག་འདུ་ཤེས་དེ་ལྟ་བུའི་འོག་མིའི་སྡུག་བསྔལ་གྱི་གོ་རྟོགས་དང་དེར་བཟུང་བའི་རྣམ་འགྱུར།",
    "ཁོ་རང་ཡང་ཞིབ་ཚགས་མཁན་ཞིག་ཡིན་དགོས།",
    "འགའ་ཞིག་དུས་ཡུན་རིང་པོར་ངག་ནས་ངག་ཏུ་བརྒྱུད་པ་རྣམས་ཐོ་འགོད་བྱས་པས་དམངས་ཁྲོད་ངག་རྒྱུན་གཏམ་རྒྱུད་དུ་གྱུར།",
    "འབྲེལ་ཡོད་དཔྱད་གཞི་ལྟར་ན་༡༩༨༥ལོ་ནས་༢༥བར་ལྷུག་རྩོམ་བཅུ་ཕྲག་གཅིག་ལྷག་ལ་རིམ་པ་སོ་སོའི་བྱ་དགའ་ཐོབ་ཡོད་པ་འདིས་དེངརབས་བོད་ཀྱི་ལྷུག་རྩོམ་ཞེས་པའི་རྩོམ་ལུས་ཀྱི་གསར་རྩོམ་ཉམས་མྱོང་དང་སྒྱུ་རྩལ་མཚོན་སྟངས་ཀྱི་ཆུ་ཚད་ཅུང་མཐོ་བ་ཞིག་ཏུ་བསླེབས་འདུག་པ་མཚོན་ནོ།",
    "རྟོག་བཏགས་ཀྱི་རླབས་རིས་ནམ་མཁའི་ཀློང་རིམ་དུ་འཕྱོ་བ་ཞིག་ཡིན་ཕྱིན་ཕྱི་སྣོད་ཀྱི་འཇིག་རྟེན་མཐའ་དག་དུས་སྐབས་གསར་པའི་ལྷུག་རྩོམ་གྱི་བརྗོད་གཞིའི་སྟེགས་བུར་ཉམས་འགྱུར་རྫོགས་པའི་སྟངས་སྟབས་བསྒྱུར་བ་དང་།",
    "སྨུག་སེང་ངེར་འདུག་ལམ་དཀྱིལ་ཀྱི་རྡེའུ་ཟེགས་རྣམས་བརླན་ཞིང་འཇམ་ལ།",
    "ཤེས་མེད་ཚོར་མེད་དུ་སྐྱེས་ཤིང་རྒྱས་བཞིན་འདུག་ཅེས་རང་བཞིན་བརྗོད་པའི་འབྲི་ཚུལ་གྱིས།",
    "ལེགས་པར་མི་འོང་རང་སྲོག་འགུམས་ཉེན་ཡོད།",
    "རྩོམ་མཁན་གྱིས་ཐོག་མར་ཡར་འབྲོག་གཡུ་མཚོ་དེ་གནས་གང་འདྲ་ཞིག་ཏུ་ཆགས་འདུག་པ་བྲིས་པ་བརྒྱུད་ནས།",
    "བདག་པོར་བློ་དཀར་ཞིང་རང་བཞིན་བརྟན་པ།",
    "དེ་ལྟར་རྩོམ་ལུས་རྙིང་ཡང་རྩོམ་ཚུལ་གྱི་རྣམ་པ་གསར་པ་བསྟེན་པའི་ལྷུག་རྩོམ་དག་དུས་རབས་ཀྱི་རྗེས་སུ་དམ་པོར་འབྲངས་ཤིང་།",
    "ང་རང་དཔྱིད་ཀའི་འདམ་རྫབ་ཀྱི་ལམ་ཀྱག་ཀྱོག་དེའི་སྟེང་དུ་ས་ལ་འགྱེལ་བ་དང་།",
    "ང་རང་བརྒྱུད་ཟིན་པའི་ལམ་བུ་དེའི་སྟེང་ན་རྒྱ་མཚོའི་རླབས་གཉེར་ལ་འཕྱ་བའི་གཞོན་ནུ་ཁྲི་མ་འབུམ་གྱིས་ས་གཞི་ཡོམ་ཡོམ་འདར་བའི་གོམ་སྟབས་སྒྱུར་བཞིན་མདུན་དུ་སྐྱོད་བཞིན་འདུག་ཡིན་ནའང་།",
    "ང་ལ་ཅི་ཡང་སྟོན་རྒྱུའང་མི་འདུག་ཅེས་ཏེ།",
    "སྤང་ཐང་དུ་གཡོ་འགུལ་བྱེད་བཞིན་མཆིས་པའི་རྟ་ནོར་ལུག་གསུམ་གྱི་ཁྱུ་ཚོགས་བཅས་གསོན་ཉམས་ལྡན་པར་བྲིས་འདུག་པ་ནི།",
    "གང་བསྟེན་བསྟེན་པ་ཀུན་རྒྱལ་ནས་གདའ།",
    "གང་བསྟེན་བསྟེན་པ་ཀུན་བརླགས་ནས་གདའ།",
    "དེ་ལོས་ཡིན།",
    "ད་དེ་ལོས་ཡིན།",
    "བདུད་ཚོགས་ཀྱིས་གསོད་བཅོམ་འཕྲོག་གསུམ་བྱེད་ཀྱིན་གདའ།",
    "ཁྱེད་རང་བདུད་ལ་ཐེངས་གཅིག་ཕེབས་ན།",
    "ཧ་ལས་ཏེ་ཨ་ཙི།",
    "ཕྱག་མཛོད་ལ་ཁ་གཏད་ནས་དེ་སྔོན་ཁོ་ཚོས་བསྐྱལ་ཡོང་བའི་མར་ད་དུང་གཉེར་ཚང་ནང་མང་ལོད་འདུག་གམ།",
    "སྒྱུ་རྩལ་དེ་ག་དུས་ཡིན་ཡང་དངོས་ཡོད་ལ་གཡོལ་བྱོལ་བྱ་མི་རུང་ཞིང་།",
    "བོད་ཀྱི་དེང་རབས་རྩོམ་རིག་དུས་རབས་ཉེར་གཅིག་པར་སླེབས་ནའང་།",
    "སྒྱུ་རྩལ་གྱི་ནུས་པ་སོགས་རྒྱ་ཚད་ལ་ལོངས་པའི་རྩོམ་པ་པོ་ད་དུང་ཡང་ཤིན་ཏུ་ཉུང་བའི་ཚད་དུ་ལུས་འདུག་སྙམ།",
    "སྙན་ངག་གསར་པས་པར་ངོས་ངེས་ཅན་ཞིག་ཟིན་འདུག་ནའང་།",
    "ཞེས་པ་ཡིས་སྙན་དེབ་སོགས་དཔེ་སྐྲུན་བྱེད་པའི་དགོས་ངེས་རང་བཞིན་དང་གལ་ཆེན་རང་བཞིན་བསྟན་འདུག་དུས་རབས་སྔོན་མའི་ལོ་རབས་དགུ་བཅུའི་དཀྱིལ་ཙམ་དུ་སླེབས་པ་ན།",
    "སེམས་མུན་པ་ལྟ་བུར་འདུག་པ་དང་།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "གནས་ཚུལ་ལ་རྟ་གླང་རང་མཚན་པར་ཞེན་འཛིན་ཡོད་མེད་ཀྱི་ཁྱད་པར་བྱུང་བ་ལྟར།"
