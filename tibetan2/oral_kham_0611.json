    "དགྱེས་པ་རྡོ་རྗེ་ནི་དགྱེས་སྦྱོར་གྱི་སྐུ་རུ་མ་བསྟན་གོང་དུ་ལྷ་མ་ཧ་དེ་བ་རུ་འདུག་པའི་ཕྱིར་དང་ཀུན་རིག་རྣམ་པར་སྣང་མཛད་འདི་སྲིད་པ་ཐམས་ཅད་ཀྱི་མེས་པོ་ལྷ་ཚངས་པ་གདོང་བཞིར་འདུག་པའི་ཕྱིར།",
    "ཚེ་འདིར་ཡི་དམ་ལ་བྱེད་ནས་ཕྱི་མར་དེའི་འཁོར་སྐྱེ་བར་འདུག་པ་དང་།",
    "རྒྱལ་ཐེབས་མུ་ཆོའི་རིང་ལ་སྲས་བཅུ་དང་བཅས་པས་བསྟན་པ་སྤེལ་བ་བཞིན་མི་འདུག་ན།",
    "ཡིན་མིན་གྱི་སྐྱོན་འདུག་པ་མ་གོ་བས།",
    "འཇམ་དཔལ་ཟེར་ཡང་ཤེས་རབ་གང་བཟང་རང་ལ་ཟེར་བ་སྣང་།",
    "བོན་འདི་ཙམ་ཟབ་འདུག་པས།",
    "འདི་ལ་ཕུན་སུམ་ཚོགས་པའི་ལས་མཐའ་ཞིག་མི་འདུག་སྟེ།",
    "བདེ་བསྟོད་སྒྲོལ་མ་མཛད་བཅུ་ཡན་ཆད་མཐུད་ནས་འདུག་པས།",
    "མ་བརྟགས་ན་མང་པོའི་ལྡིར་བ་བསླང་བས་འདྲ་འདྲ་ཞིག་འདུག་ཀྱང་།",
    "བརྟགས་ན་ངེས་ཤེས་དད་པ་ཐོབ་པ་ཞིག་མི་འདུག་གོ།",
    "ངའི་ཀློང་རྒྱས་ལྟ་བུ་ཞིག་དགོས་པ་ལ་དེ་མི་འདུག་པའི་ཕྱིར།",
    "གཅིག་ལས་མི་འདུག་པས་ཕྱི་མའི་དོན་ཡོད་པ་མ་ཡིན་ཟེར་ན།",
    "སྐྱབས་གནས་སུ་རུང་དང་མི་རུང་མང་པོ་ཞིག་འདུག་ནུའང་།",
    "འཕན་ཡུལ་དུ་ཕྱིན་ཏེ་བརྟགས་པས་རྒྱལ་པོས་རྟགས་ཡོད་གསུངས་པ་ཀུན་མི་འདུག་པས།",
    "གྷ་ན་ཏ་མིའི་བརྒྱུད་རིམ་འདུག་གོ།",
    "གཡོན་ན་དངུལ་གྱི་དྲིལ་བུ་རྒྱ་མདུད་ཅན་རྩེ་དགུ་པ་བཟུང་ནས་འདུག་གོ།",
    "ཁོ་རང་གོ་བ་ཆུང་བ་ཡིན།",
    "ལ་ལ་ལོ་ཟླ་མང་པོར་བཞག་ནས་སྒྲིབ་པ་ཆེ་འདུག་ཟེར།",
    "གཞན་གྱི་བསྟན་པ་དར་བས་རང་ལ་ཅི་ཕན་ཟེར་བ་ཁ་ཅིག་འདུག་སྟེ།",
    "ཁ་གང་སྔ་བྱེད་དེ་ང་དང་བོན་ལ་ཚུར་མུ་སྟེགས་པ་ཡིན་ཟེར་བ་ཅིག་འདུག་སྟེ།",
    "གཡུང་དྲུང་བོན་གྱི་བསྟན་པ་བསྣུབས་པའི་ཚིག་སྦྲེལ་ནས་ཐབས་ཤོམ་པར་འདུག་གོ།",
    "ངོ་ཡོལ་ཡོལ་འདི་ལ་ཕ་རོལ་སྐྱེ་བོ་ཀུན་གྱིས་ཀྱང་ཡིན་པར་འདུག་གོ་བསམ་པ་འདིས།",
    "བསྟན་པ་ཡང་མི་གསལ་བར་འགྱོ་ཉན་འདུག་པས།",
    "རྒྱུད་རྡོ་བར་སྣང་ལ་མི་ཚད་ཙམ་ན་འདུག་པ་ས་ལ་ལྷུང་མི་རུང་ཟེར་ནས་འོག་ནས་རྩིག་པས་སྐྱོར་བའི་སྲོལ་འདུག་ཟེར།",
    "དེང་སང་པདྨ་བཀོད་སོགས་སུ་ཡོད་པའི་བ་མེན་རྒྱ་ཚ་ཟེར་བ་དེ་ཡིན་པར་འདུག་ཧཱུཾ་ག་ལ་ནས་ཤར་ཕྱོགས་ཟླ་བ་གསུམ་དུ་ཕྱིན་པ་ན་ཟངས་གླིང་ཞེས་པ་མི་ཤ་ཟ་བ་ད་དུང་ཡང་ཡོད་པས་མི་ཕལ་བ་ཤིན་ཏུ་ཡང་འགྲོ་བར་དཀའ།",
    "ཆུ་སྲིན་བྱིས་པ་གསོད་དང་ཀླུ་དང་གློག་སོགས་ཀྱི་འཇིགས་པ་ཆེན་པོ་ཡོད་འདུག་ཟེར་རོ།",
    "བོན་ལུགས་བོད་ནས་དར་བའི་བརྒྱུད་འཛིན་ཅི་རིགས་ཡོད་འདུག་དེའི་ཤར་ན་ཀོ་ཀི་ཟེར་བའི་རྒྱལ་ཁམས་ནི་རྒྱ་གར་གྱི་ཡུལ་མཐའ།",
    "ནང་པའི་རྟེན་གསུམ་ནི་མང་པོ་འདུག་ཕྱི་རོལ་པའི་གནས་གཞི་ཡང་མ་ཐུ་ར་དང་།",
    "དེ་ནས་ཚེ་ལོ་བདུན་འབུམ་ཐུབ་པའི་དུས་སུ་མེ་ཏོག་པདྨ་ཧ་སྤུངས་ཀྱི་རྩེ་ལ་སྲས་སྟོང་རང་བྱུང་དུ་འཁྲུངས་ཏེ།",
    "སྲས་སྟོང་རང་བྱུང་དག་ཏུ་འཁྲུངས།",
    "ཤུན་པ་དར་ཟབ་ཏུ་འདུག་པ།",
    "སྤྲིན་དཀར་གྱི་གདན་ལ་འཇའ་ཚོན་གྱི་གུར་ནང་དུ་འདུག་པ་ཞིག་སྟོན་པའི་སྤྱན་སྔར་བྱུང་ནས།",
    "མི་གནས་བོན་སྐུར་བཞུགས་ཙ་ན།",
    "རང་བྱུང་རྫོགས་སྐུར་བཞུགས་ཙ་ན།",
    "གླང་པོ་ཏེ་ར་བི་ཤ་བྱ་བ་ཡོད་པ་སྟོར་ནས་གླང་རྫིས་ཚོལ་དུ་ཕྱིན་པས་གླང་པོས་ཆུ་མིག་སྔོ་སངས་ལ་ཆུ་འཐུང་ནས་ཤེལ་གྱི་བྲག་བཟང་ལ་ཉན་པའི་ཚུལ་དུ་འདུག་པ།",
    "གཤེན་ལྷ་འདུག་པ་ངས་མ་མཐོང་།",
    "བོན་ཉིད་འདུག་པ་ངས་མ་མཐོང་།",
    "གཤེན་ལྷ་འདུག་པ་ངས་མ་མཐོང་།",
    "སེམས་ཉིད་འདུག་པ་ངས་མ་མཐོང་།",
    "གཤེན་ལྷ་འདུག་པ་ངས་མ་མཐོང་།",
    "ནམ་མཁའ་དང་ས་གཞི་དང་རྒྱ་མཚོ་ལ་ཚོལ་ཙ་ན་ངེས་པའི་ལུང་བསྟན་པ་ཡང་ང་ཡིན་ནོ།",
    "ཤི་བ་དང་ཁྲག་སྐྱུག་པ་ལ་སོགས་པའི་སྐད་ཅིག་ལ་བརླག་འགྲོ་བ་འདུག་པས་ཤིན་ཏུ་འདར་ཞིང་དངངས་ནས་སྡུག་བསྔལ་བ་ཞེས་ཞུས་སོ།",
    "ལྷ་ཕྲུག་གཤའ་མར་འདུག་པས་ཤ།",
    "རྭ་ཅོ་འདུག་པས་ཁྱུང་ཕོ་ཡིན་འདུག་ཟེར།",
    "རང་རང་ཡུལ་དུ་སྐད་རིགས་སོ་སོར་བསྒྱུར།",
    "དེའང་པི་རོ་ཙ་ནས་བོད་དུ་བསྒྱུར་བ་སྟེ།",
    "ད་ལྟ་རྒྱ་གར་གྱི་ཡི་གེ་དང་བོད་ཡིག་རྣམས་སྒྲ་གཟུགས་བརྙན་དང་བཅས་པ་མི་མཐུན་ང་ར་འདུག་པའི་ཕྱིར་དང་།",
    "རྩི་ཤིང་རང་སྡུད་བྱེད་པའི་གཅོ་གྱིམ་བུ་ལན་ཚ།",
    "བདག་ཀྱང་མི་འདུག་ཟེར་ནས་བཞུགས་སུ་མ་འདོད་དོ།",
    "དེར་ལོ་ངམ་བློ་སེམས་མ་བདེ་བར་ཡོད་ཙ་ན།",
    "འོ་སྐོལ་གཉིས་ལ་རྗེ་འབངས་ཀྱི་ཁྱད་འདུག་པས།",
    "སད་ནས་བལྟས་ཙ་ན་སྔས་ན་གཡག་དཀར་པོ་ཞིག་ཉལ་ནས་སྣང་།",
    "གཞན་རྐྱེན་དང་རང་རྐྱེན་ནོ།",
    "ཁྱེའུ་འདི་ལས་ཅན་ཞིག་ཡིན་པར་འདུག་ཟེར།",
    "བོད་ཀྱི་རྒྱུལ་པོས་ཀྱང་མི་བཟོད་པར་འདུག་ན་འདི་སྨད་པའི་ཐབས་ཡོད་དམ།",
    "བོད་ཀྱི་མངའ་རིས་སུམ་གཉིས་སྟེར་བར་འདུག་གོ།",
    "དུག་མདེལ་གཅིག་དང་གསུམ་བཞག་གདའ་འོ།",
    "བ་གོར་བི་རོ་ཙ་ན་རྐང་འགྱོགས་བྱ་དང་མཉམ།",
    "དེ་ནས་སྒོ་ནང་དུ་བྱོན་པས་ལྡེར་སོ་ཆེན་པོ་ཞིག་གདའ་བ་འདི་ཅི་ལགས་གསུངས་པས།",
