    "རི་རབ་པ་ནི་སྒྲིབ་པ་སེལ་བ་སྟེ་ཉོན་མོངས་པ་དང་རྣམ་རྟོག་གིས་མི་བསྐྱོད་པའི་ཕྱིར་རོ།",
    "པདྨ་ཅན་ནི་སྤྱན་རས་གཟིགས་ཏེ་པདྨའི་རིགས་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་གསང་གདན་ནས་མོས་ཀློགས་འདྲི་སྟེ།",
    "གཞན་གྱི་གདན་གྱི་མཚན་ཉིད་ནི་ཕྱི་རོལ་གྱི་ཡུལ་དང་ནང་གི་ཡུལ་ལ་སོགས་པ་སྟེ།",
    "བདག་གི་གདན་གྱི་མཚན་ཉིད་ནི་འབྱུང་དང་འཇུག་པའི་དབུགས་དག་ལ་བརྟེན་ནས་ཅི་ལྟར་ཡེ་ཤེས་སྐྱེ་བའི་ཐབས་དང་།",
    "བདག་གི་གདན་གྱི་མཚན་ཉིད་ནི་ཟག་པ་མེད་པའི་ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པ་དང་བཅས་པའི་ལུས་འདི་ལ་འཆི་བའི་ལྟས་བརྟག་ན་ཇི་ལྟར་བརྟག་རྟགས་བྱུང་ན་འཆི་བ་བསླུ་བའི་ལ་སོགས་པ་ཇི་ལྟར་སྦྱར།",
    "ཞེས་དྲི་བ་ཐམས་ཅད་ཀྱི་ཞབས་སུ་རེ་རེ་སྦྱར་རོ།",
    "ད་ནི་ལན་ལ་གདན་བཞི་ཡོད་པ་ལས་བདག་གི་གདན་ནོ།",
    "དེ་ལ་གདན་ཆུང་བཞི་ཡོད་པ་ལས་བདག་གི་གདན་གྱི་བདག་གི་གདན་ནོ།",
    "དེ་ཡང་སྡུད་པ་པོ་ཟབ་མོའི་དོན་ལ་མོས་པས་གསང་བའི་གདན་ནས་དྲིས་ཡང་རྒྱུད་ཀྱི་སྟོན་པས་གསང་གདན་ཟབ་པའམ་རྟོགས་པར་དཀའ་བས་མཐར་བསྟན་ལ་བདག་གདན་ནི་ལས་བསྒྲུབ་སླ་བའམ་ཕྱིའི་བྱ་བ་ལ་འཇུག་སླ་བས་སྔོན་དུ་བསྟན་པའི་ཕྱིར་ཉོན་ཅིག་ལ་སོགས་པ་ཡག་གསུངས་ཏེ།",
    "བཅུ་གཉིས་ནི་རེའུ་མིག་བཅུ་གཉིས་ས་ལ་བྲི་སྟེ།",
    "ཇི་ལྟར་ཚེས་གྲངས་བརྩི་བ་བཞིན་ཞེས་པ་ཚེས་གཅིག་དང་གཉིས་དང་གསུམ་ལ་སོགས་པའི་གོ་རིམ་ཡོད་པ་ལྟར་རེ་མིག་བཅུ་གཉིས་ཀྱི་མིག་ཏུ་ཟླ་ཁྱིམ་བཅུ་གཉིས་བཞག་པར་བྱས་ལ་བརྩིའོ།",
    "གོ་རིམ་ནི་དེའི་འོག་ཏུ་དེ་འབྱུང་གིའོ།",
    "བཅུ་གཉིས་ནི་རོ་ཧི་ཏ་ལ་སོགས་པ་རབ་ཏུ་བརྩོན་འགྲུས་དང་བཅས་པ་ཤར་ཕྱོགས་ཀྱི་རེ་མིག་ནས་སྨིན་དྲུག་ཚེས་བཅུ་གསུམ་ལ་སོང་བའི་དགུན་ཟླ་འབྲིང་པོ་ལ་སོགས་པ་གཡོན་བསྐོར་དུ་བཞག་ཅིང་དགོད་དོ།",
    "དགུན་ཟླ་ཐ་ཆུང་མོ་ཧི་ཏ།",
    "མོ་ཧི་ཏ་དང་བྷ་ཏྲ་བ་གསུམ་དུ་རིམ་པ་ལྟར་བསྡུ་གསུང་ངོ།",
    "ཚེས་བཅུ་དྲུག་ལ་རོ་ཧི་ཏ་བཅུ་བདུན་མོ་ཧི་ཏ་ནས་ཉི་ཤུ་བདུན་ཀཱ་མ་ནའི་བར་དུ་སྦྱར་རོ།",
    "བཅུ་གཉིས་ནི་ཟླ་ཁྱིམ་བཅུ་གཉིས་པོ་ས་ལ་བྲིས་པའི་རེ་མིག་ཏུ་དགོད་དོ།",
    "དེ་བཞིན་དུ་མོ་ཧི་ཏ་ལ་སོགས་པ་ལ་ཡང་སྦྱར་རོ།",
    "ད་ནི་དུག་དབྲོག་པ་བསྟན་ཏེ་འདི་ལ་ཞེས་བྱ་བ་ནི་དུས་སྦྱོར་བཅུ་གཉིས་པོ་འདི་ལ་དུག་གསོར་རུང་ངམ་མི་རུང་གི་རིམ་པ་སྦྱར་ཏེ།",
    "གང་གིས་ནི་ཀླུའི་སྦྲུལ་གང་གིས་ཟོས་པའམ་གང་ཟག་གང་གིས་ཤ་དུག་གམ་སྦྱར་དུག་ལ་སོགས་པ་ཟོས་པ་ལ་བབ་ན་ངེས་པ་ཁོ་ནར་འཆི་བདག་དང་འགྲོགས་པར་འགྱུར་རོ།",
    "ད་ནི་ཉིན་མོ་དང་མཚན་མོའི་ཉི་མ་རིང་ཐུང་གི་དབུགས་ཀྱི་སྐྱེ་འབྲིང་བསྟན་པའི་ཕྱིར་རིམ་པ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བགྲོད་པ་བྱང་ནི་ཉི་མ་བྱང་དུ་བགྲོད་པའི་དུས་སུ་ཉི་མ་རིང་དུ་འགྲོ་སྟེ་ཟླ་བ་རེ་རེ་ལ་ཆུ་ཚོད་གཉིས་གཉིས་སྐྱེ་འབྲི་བྱེད་དོ།",
    "ལྷོ་ཕྱོགས་སུ་བགྲོད་པ་ནི་དབྱར་ཟླ་ཐ་ཆུང་ལ་སོགས་པ་ཉི་མ་ལྷོར་བགྲོད་པའི་དུས་སུ་མཚན་མོ་རིང་དུ་འགྲོ་སྟེ་ཆུ་ཚོད་གཉིས་ཀྱི་སྐྱེ་འབྲི་བྱེད་དོ།",
    "དེ་ཡང་དགུན་ཟླ་འབྲིང་པོ་ལྟ་བུ་ཉི་མ་ཐུང་ཐག་མཚན་མོ་རིང་ཐག་ཅིག་ནས་དགུན་ཟླ་ཐ་ཆུང་དུ་འཕོ་སྟེ་ཉི་མ་ལོག་ནས་ཉི་མ་རིང་དུ་འགྲོ་ལ་མཚན་མོ་ཐུང་དུ་འགྲོ་བའི་དུས་སུ།",
    "གོང་གི་དགུ་བཅུ་གོ་གཉིས་ཀྱི་སྟེང་དུ་དྲུག་ཅུ་རེ་བརྒྱད་ཀྱི་བརྒྱད་བསྣན་པས་བརྒྱའོ།",
    "དབྱར་ཟླ་འབྲིང་པོ་ལྟ་བུ་ཞིག་ལ་ཆུ་ཚོད་གཉིས་ཉིན་མོ་ལ་འཁོར་ཞིང་འཕེལ་ནས་མཚན་མོ་ལ་ཆད་པ་སྟེ་འབྲི་བའོ།",
    "གོང་གི་རི་ཧི་ཏ་ལ་ཞི་བའི་ལས་ཤེས་པ་ལ་སོགས་པ་དང་འབྲེལ་ལོ།",
    "ཁ་ར་ལ་སོགས་པས་ཞག་གཅིག་གི་དབུགས་དང་ལོ་གཅིག་གི་ཆུ་ཚོད་མཉམ་པར་སྟོན་ཏེ།",
    "དེ་རེ་རེ་ལ་ཡང་བཅུ་བཅུས་བསྒྱུར་བས་བརྒྱད་བརྒྱའོ།",
    "དེ་རྣམས་ལ་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་ཡོད་དེ་ལོ་གཅིག་གི་ཆུ་ཚོད་དོ།",
    "ན་ལོ་གཅིག་གི་ཚེ་བསྲིང་ནུས་པའོ།",
    "ད་ནི་མོ་གདབ་པ་བསྟན་པའི་ཕྱིར་ངག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ངག་གི་ཁོ་མོ་ཞུ་བ་པོས་ཅི་བརྗོད་པ་ཀུན་ནོ།",
    "གཟུང་བ་ནི་ཁོས་བརྗོད་པའི་ཚིག་སྟེ་ངན་བུ་ལ་མོ་གཅིག་གདབ་པར་ཞུ་ཟེར་ན་ཨཱ་ལིས་བསྒྱུར་བ་དང་ཀཱ་ལིས་བསྒྱུར་བའོ།",
    "མཎྜལ་གྱི་སྟེང་དུ་ཐོད་ལེ་ཀོར་གྱི་རེ་མིག་བཅུ་གཉིས་བྲིའོ།",
    "རེ་མིག་རྣམས་ལ་སྒྲ་ཡིག་སྟེ་ཨཱ་ལི་དགོད་པའོ།",
    "ཨ་ལ་སོགས་པ་ནི་མོ་བཟང་ངན་གྱི་ལྟས་རྣམས་སོ།",
    "གོང་དུ་ཞེས་བྱ་བ་ལ་སོགས་པས་མོ་གདབ་ཐབས་དྲུག་སྟོན་ཏེ།",
    "མོ་ཞུ་བ་པོ་ན་རེ་ཁོ་བོ་ལ་མོ་ཅིག་ཞུ་ཟེར་ན་ཁདང་ཀ་ལ་རྡེའུ་གཉིས་བཞག་གོ།"
  ]
}