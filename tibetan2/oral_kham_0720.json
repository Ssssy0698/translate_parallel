    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྗེས་སུ་དཔག་པ་ཡང་རང་ལས་ངེས་པ་ཁོ་ན་སྟེ།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "གང་ཞིག་ཕྲ་ཞིང་གཅིག་པུ་སྐྱེ་གནས་འདུག།",
    "དབྱིབས་ཤེས་པའི་སྒྲའི་སྤྱི་ཙམ་ནི་འཇུག་པར་མཚུངས་པར་མཐོང་བ་ལས་ལྷུན་པོའི་དབྱིབས་ཀྱང་རང་བྱེད་པ་པོའི་བློ་སྔོན་དུ་བཏང་ནས་བྱས་པར་སྒྲུབ་པར་བྱེད་པ་མི་རིགས་ཏེ།",
    "གལ་ཏེ་དུ་མའང་གཅིག་དུས་ཅེ་ན།",
    "ཁྱད་པར་འཕེལ་ཡང་རང་བཞིན་ཉིད།",
    "དེ་ལྟར་ན་སྲིད་པའི་ལྗོན་ཤིང་ཆེན་པོ་དེ་ཐོག་མ་མེད་པ་ནས་ཇི་སྲིད་མྱ་ངན་ལས་འདས་པའི་ས་ལ་ཕྱིན་གྱི་བར་དུ་འདུག་པའི་ཚུལ་དེའང་འཕྲུལ་འཁོར་མཁན་གྱིས་བྱས་པའི་ཟོ་ཆུན་གྱི་འཁོར་ལོ་འཕྱན་པ་དང་འདྲ་སྟེ།",
    "དེ་ཙམ་གྱིས་རང་རང་བཞེད་དོན་མྱ་ངན་ལས་འདས་པ་འགྲུབ་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་དང་རང་བཞིན་མ་ཡིན་པའི་ཁྱད་པར་རོ།",
    "རྩ་བ་མེད་པ་དང་མི་བརྟན་པ་དང་རང་བཞིན་ཡིན་ཏེ།",
    "འཕྲོད་པ་འདུ་བ་ལ་སོགས་པ་མེད་ན་ཡང་རང་བཞིན་དང་།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "སྔར་བུམ་པའི་གསལ་བ་ཡོད་པའི་དུས་སུ་བདག་ཉིད་ལ་དམིགས་པའི་མངོན་སུམ་གྱི་ཤེས་པ་བསྐྱེད་པ་ལ་ནུས་པ་དང་ལྡན་པ་གང་ཡིན་པ་དེ་ཉིད་བུམ་གསལ་མེད་པའི་དུས་སུ་ཡང་རང་འཛིན་པའི་མངོན་སུམ་བསྐྱེད་པ་ལ་ནུས་པ་དང་ལྡན་པའི་རྟག་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཡིན་ན་བུམ་པའི་སྤྱི་དེ་ལ་ནི་བུམ་གསལ་ཡོད་པའི་དུས་ཀུན་གྱི་ཚེ་ན་ཡང་རང་འཛིན་མངོན་སུམ་བསྐྱེད་པའི་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "ཡང་ན་ཤིང་རང་མཚན་དུ་སྣང་ཡང་དེར་མེད་པ་ནི་སྤྱི་ཡིན་པར་འདོད་པའི་ཕྱིར་དང་།",
    "ཤིང་དུ་མེད་བཞིན་དུ་ཤིང་དུ་སྣང་བ་དེའང་རང་འཛིན་རྟོག་པས་བཏགས་ནས་བསླད་པའི་ཕྱིར་དང་།",
    "རྣམ་པ་འགས་ཀྱང་རང་འཛིན་པའི་རྣམ་པར་ཤེས་པ་ལ་སྤྱི་དེ་རྫས་ཐ་དད་པའི་དངོས་པོར་སྣང་བ་མེད་པའི་ཕྱིར་རོ།",
    "རྟགས་དང་རྟགས་ཅན་གྱི་བློ་དེ་དག་འཇུག་ཡུལ་རང་མཚན་གྱི་དངོས་པོ་ལ་སླུ་བར་བྱེད་པ་ཉིད་མིན་ཡང་རང་མཚན་མ་ཡིན་པ་ཞིག་ལ་རང་མཚན་དུ་འཁྲུལ་བར་རྣམ་གཞག་བྱས་པ་ཡིན་ནོ།",
    "ཡོད་པ་ཉིད་དང་རང་རྒྱུ་དང་།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "ཅི་སྟེ་རྟོག་པ་ལ་དོན་དུ་སྣང་བའི་རྣམ་པར་སྒྲོ་བཏགས་པའི་གཞན་སེལ་དེ་བརྗོད་ན་ཡང་རང་མཚན་སྣང་ནས་བརྗོད་པར་འགྱུར་ཏེ།",
    "འདིས་ནི་རྣམ་པར་ཤེས་པ་ཡང་རང་བཞིན་མེད་པར་གཏན་ལ་ཕབ་པས།",
    "ཕྱི་རོལ་གྱི་དོན་ཁས་བླངས་ཀྱང་རང་བཞིན་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "དེས་ན་ཅིག་ཅར་དུ་མ་འཛིན་པ་གྲངས་ཅན་ཁྱེད་རང་ལ་ཡང་གྲུབ་བོ།",
    "དེ་ལྟར་མིག་ཤེས་ཀྱིས་མཐོང་བའི་བ་ལང་རང་མཚན་རྟོག་པས་རྟོགས་པ་མེད་པར་ཡང་ནི་བརྗོད་པ་དང་རྣམ་པར་རྟོག་པ་འཇུག་པའི་ཕྱིར།",
    "རྟགས་ཀྱི་ངོ་བོ་ཙམ་གྲུབ་ཀྱང་རང་བློ་རྗེས་སུ་དཔག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "དོན་འདི་ལ་སྔར་བདེ་སྡུག་བསྐྱེད་པའི་ནུས་པ་འདུག་གོ་ཞེས་མྱོང་བ་སྔ་ཕྱི་མཚམས་སྦྱོར་བའི་དྲན་པ་ལས་བྱུང་ལ།",
    "གཟུང་འཛིན་དུས་མཉམ་པ་དགག་དུས་མི་མཉམ་པ་ལ་གནོད་པ་མེད་པའོ།",
    "དེ་ལྟར་མ་ཡིན་ན་བུམ་གཟུགས་ལ་སོགས་པ་རང་ཤེས་པའི་ཡུལ་དུ་གསལ་བ་གསལ་བྱེད་གཞན་ལ་བལྟོས་པ་བཞིན་དུ་མར་མེ་ཡང་རངང་གསལ་བ་གསལ་བྱེད་གཞན་ལ་བལྟོས་པར་འགྱུར་དགོས་པ་ལས་དེ་ལྟར་ཡང་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཟུགས་གཞན་གསལ་བ་དང་རང་གསལ་བའོ།",
    "དེ་ཡང་རང་དང་དུས་མཉམ་གཞན་གྱིས་མྱོང་བར་མཚུངས་ཤིང་།",
    "དེ་ཡང་རང་དང་དུས་མཉམ་གཞན་གྱིས་མྱོང་དགོས་པ་ལ་སོགས་པ་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར།",
    "བདེ་སོགས་མྱོང་བའི་རང་རིག་དེ་ནི་བདེ་སོགས་དེའི་བདག་ཉིད་ཀྱི་རང་བཞིན་མ་སྐྱེས་ནས་མེད་པ་བཞིན་དུ་དེ་མྱོང་རང་རིག་ཀྱང་མ་སྐྱེས་ནས་མེད་པའི་ཕྱིར་རོ།",
    "ཡུལ་བདེ་སོགས་དང་དེ་མྱོང་རང་རིག་པ་ཡང་འགགས་པའི་ཕྱིར་ཏེ།",
    "བརྡ་བྱ་བའི་ཡུལ་བདེ་སོགས་དེ་དང་བརྡ་བྱེད་པ་དེ་མྱོང་རང་རིག་ཐ་དད་པ་མེད་པའི་ཕྱིར་ནའོ།",
    "དེ་ལྟར་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་སོ་སོར་ངེས་པ་ལ་བལྟོས་པ་མི་འཐད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདེ་སོགས་ཤེས་པ་ཡིན་པ་དེ་ལ་ཡང་རང་རིག་མངོན་སུམ་གྱིས་དགའ་བ་དང་ཡོངས་སུ་གདུང་བ་དེ་མཐོང་།",
    "གཞན་ཡང་རྗེས་དཔག་དེ་ལས་ཀྱང་རང་རྒྱུད་ལ་ལོངས་སྤྱོད་བྱེད་མི་འགྲུབ་པ་ཉིད་དེ།",
    "དེས་ན་བློ་མྱོང་གཉིས་པོ་དེ་ཡང་རང་བཞིན་གཅིག་ཉིད་དུ་མངོན་སུམ་གྱིས་མཐོང་བའི་ཕྱིར།",
    "གསུམ་པ་བྲལ་བྱ་རྟོག་པའང་རང་རིག་པར་བསྟན་པ་ལ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཕྱི་རོལ་ལྟར་སྣང་ཡང་རང་རིག་པའི་སྒྲུབ་བྱེད་བརྗོད།",
    "དོན་གྱི་རྣམ་པ་སྣང་བའི་མངོན་སུམ་གྱི་སོ་སོར་རིག་པར་བྱ་བ་དེ་ཕྱི་རོལ་ལྟར་སྣང་ཡང་རང་རིག་པ་ཡིན་ཏེ།",
    "དེ་ལ་འདོད་པའམ་མི་འདོད་པའི་དོན་དུ་ཐ་སྙད་བྱེད་པ་དེས་ཀྱང་རང་རིག་ལ་དོན་རིག་པའི་ཐ་སྙད་བྱེད་པར་ནི་འགྱུར་བ་ཡིན་པའི་ཕྱིར།",
    "རིགས་ཞེས་པ་ཡང་དོན་ཡོད་ཀྱང་རང་རིག་པ་ནི་རིགས་པས་གྲུབ་པ་ཡིན་གྱི།",
    "དེའི་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་གྱི།",
    "གཟུང་བའི་རྣམ་པ་དེའི་བསྒྲུབ་པར་བྱ་བ་ཡང་རང་རིག་པ་དེ་ཉིད་ཡིན་ཏེ།",
    "ཕྱི་དོན་གཞལ་བྱར་བྱས་ཀྱང་རང་རིག་པར་རིགས་པ།",
    "དོན་རིག་དེ་ཡང་རང་རིག་པ་དེའི་བདག་ཉིད་དུ་གནས་ཚུལ་ལ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དངོས་པོར་མེད་ན་ཡང་རང་བཞིན་གྱིས་གསལ་བར་གནས་པ་འགལ་ལོ་ཞེ་ན།",
    "ཡུལ་ཤེས་པ་དང་དེ་ཤེས་པའི་རྟགས་ལས་ཚུལ་གཉིས་དང་རང་རིག་བསྒྲུབ།",
    "ངདུས་ཕྱིས་དྲན་པའི་རྟགས་ལས་ཚུལ་གཉིས་དང་རང་རིག་བསྒྲུབ།",
    "འདས་པའི་དོན་ནི་འཛིན་པའི་དྲན་པ་ལ་རྣམ་པ་སྣང་བའི་རྟགས་ཀྱིས་བློ་ཚུལ་གཉིས་པ་དང་རང་རིག་པར་གྲུབ་པ་ཡིན་ཏེ།",
    "འཆད་པ་པོས་རང་ཡུལ་བརྗོད་པ་དེ་ཉན་པ་པོས་ཀྱང་རང་ཡུལ་དུ་འབྲེལ་བ་གོ་བའི་ཕྱིར་ཞེ་ན།",
    "གཞན་རིག་དང་རང་རིག་པའི་ཚུལ་གཉིས་པ་ཅན་དུ་གྲུབ་སྟེ།",
    "བློ་རང་ཉིད་དང་ཡིད་བྱེད་སྔ་མ་ནི་ཤེས་པ་ཡིན་པ་ལ་དེ་ཡང་རང་ངོར་མ་གྲུབ་པ་ཉིད་ཡིན་པས་མ་གྲུབ་པ་ནི་རྟགས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ཡིན་གྱི།",
    "རྒྱུ་རྫས་གཞན་ལས་སྐྱེས་པ་དེ་ཡང་རང་བློ་བསྒྲུབ་པ་ལ་ཁྱབ་པ་འཁྲུལ་བ་ཅན་ཡིན་པའི་ཕྱིར།",
    "བུམ་པ་དག་ཀྱང་རང་གསལ་མིན་པ་དེར་བརྟེན་ནས་གསལ་བྱ་གསལ་བྱེད་ཀྱི་ངོ་བོ་ཡིས་ཐ་སྙད་རབ་ཏུ་རྒྱས་པར་བྱེད་དོ།",
    "དེ་ཡང་རང་རིག་པ་ལས་ཡིན་ནོ།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "མགྲིན་བཟང་ལ་སོགས་པ་ཐ་དད་ལ་གཅིག་ཏུ་རྟོག་པའི་ངོ་ཤེས་པ་དག་ལ་ཡང་རང་ཡུལ་གསལ་བར་སྣང་བ་ཡོད་པའི་ཕྱིར་མངོན་སུམ་དུ་འགྱུར་ལ།",
    "རང་གཞན་གྱི་བློ་གཉིས་ཀ་ལྐོག་ཏུ་གྱུར་པ་དང་རང་རིག་མེད་པར་བྱེ་བྲག་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་སྐྱོན་སོ་ན་འདུག་སྟེ།",
    "ལྷ་གནས་དང་ཉི་མ་ལྡོག་དུས་སོགས།",
    "༡༣ སྤྱོད་བསྡུས་སྒྲོན་མར་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ།་",
    "དོན་དམ་གྱི་མཚན་བརྗོད་དུ་གསུངས་བ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ་ལ་བཅུ་གསུམ།་",
    "༤ དོན་དམ་པའི་མཚན་བརྗོད་ཀྱིས་རང་བྱུང་ཡེ་ཤེས་ལྔ་རྒྱས་པར་བསྟན་ཚུལབ་༥ སྟོང་པ་ཆེན་པོ་ཡི་གེ་ལྔས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ལྔ་གསལ་བར་བསྟན་ཚུལ་པཐིག་ལེ་སྟོང་པ་འགྱུར་མེད་དྲུག་ཀྱང་དེ་དང་དབྱེར་མེད་པར་བསྟན་པ།་",
    "དངོས་རྣམས་ཀུན་གྱི་རང་བཞིན་མེད་ཀྱང་རང་བཞིན་འོད་གསལ་ལ་བཏུད་ནས།",
    "ཀྱེ་མི་ང་ནི་གཏེར་ཆེན་པོ་སྟེ་སས་ཡོག་ཅིང་འདུག་གོ་ཞེས་མི་སྨྲ་སྟེ།",
    "བདེན་པ་ཉིད་དེ་ནི་ནམ་ཡང་གང་ནའང་འདུག་པ་སྟེ།",
    "འདི་དག་ཀྱང་རང་བཞིན་གྱི་རིགས་སོ།",
    "བུམ་པའི་ནང་ན་མར་མེ་འདུག་པ་བཞིན་དུ།",
    "རང་བཞིན་གཞུག་མའི་ཡོན་ཏན་བགྲང་ཡས་ཚང་ཞིང་རང་བཞིན་གྱིས་གདོད་ནས་དག་པ་འོད་གསལ་བ་ཡིན་པ་ལ་འགའ་ཞིག་དེ་ལས་བཟློག་ནས།",
    "ཉེས་པ་ཀུན་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ།",
    "ཅི་རྫ་མའི་ནང་ན་རྫ་མ་འདུག་པ་ལྟ་བུ་ཞིག་གམ།",
    "འོན་ཏེ་རླན་ལྟ་བུར་ཁྱབ་པར་འདུག་གམ།",
    "གྱད་རྨོངས་པའི་སྨིན་འཚམས་ཀྱི་རྒྱན་ལྟ་བུར་འདུག་གམ་སྙམ་པ་ལ།",
    "གང་ཞིག་གང་ན་མེད་པ་མེད་དགག་དང་རང་སྟོང་དང་མེད་ཙམ་དང་སྟོང་ཙམ་ལ་དགོངས་པ་ཡིན་ལ།",
    "དེ་བཞིན་ཉིད་དང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་དང་།",
    "ཞེས་གསུངས་ཏེ་འདིར་ཡང་རང་བཞིན་སྦྱང་ཕྱིར་ཞེས་པ་ལ་རང་བཞིན་ནི་རང་བཞིན་གྱི་སྐུ་སྟེ།",
    "སྣང་བཅས་དང་སྣང་མེད་དང་ཡེ་ཤེས་ལ་ཡང་རང་བྱུང་གཞན་བྱུང་དང་།",
    "ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་བའི་སྟོང་བ་ཉིད་ལ་འཇུག་པ་རྣམས་ཡང་དག་པ་མ་ཡིན་པར་དོན་གྱིས་བསྟན་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ན་གནས་ལུགས་ལ་ཡོད་མེད་དང་རང་སྟོང་གཞན་སྟོང་དང་མེད་དགག་མ་ཡིན་དགག་དང་རྣམ་གཅོད་ཡོངས་གཅོད་དང་སྤངས་པ་དང་ཡེ་ཤེས་དང་སྟོང་བའི་སྟོང་བ་དང་མི་སྟོང་བའི་སྟོང་པ་དང་གང་མེད་ཅིང་དེའི་ལྷག་མ་གང་ཡིན་པ་དང་གང་ཟད་ཅིང་དེའི་ལྷག་མ་གང་ཡིན་པ་དང་།",
    "དེ་བཞིན་དུ་རང་སྟོང་དང་མཚན་མ་མེད་པའི་དབྱིངས་རྣམ་གྲངས་སུ་འདོད་ན་མཚན་མ་འགགས་པའི་དངོས་པོ་རྣམས་ཀྱང་རང་སྟོང་ཡིན་པའི་ཕྱིར་མཚན་མ་མེད་པའི་དབྱིངས་ཡིན་པར་འགྱུར་ལ།",
    "སྒྲིབ་པ་གཉིས་ཀྱང་རང་སྟོང་ཡིན་པའི་ཕྱིར་དོན་དམ་པའི་བདེན་པར་འགྱུར་ལ།",
    "སྤྱོད་བསྡུས་སྒྲོན་མར་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ།",
    "གང་རང་བཞིན་གྱིས་དག་པ་དེ་དྲི་མ་རང་བཞིན་གྱིས་མེད་པའོ།",
    "གང་རང་བཞིན་གྱིས་འོད་གསལ་བ་དེ་རང་བཞིན་གྱིས་སེམས་ཀྱི་རང་བཞིན་ནོ།",
    "དོན་དམ་གྱི་མཚན་བརྗོད་དུ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་མ་བཅུ་གསུམ།",
    "དོན་དམ་པ་དང་རང་བཞིན་འགྱུར་མེད་བདེ་བ་ཆེ་མཁའ་ཁྱབ་༧།",
    "དེ་བཞིན་དུ་ཝཾ་ཡིག་མཁའ་ཁྱབ་༧དང་བདེ་བ་ཆེན་པོ་མཁའ་ཁྱབ་༧དང་ཆགས་པ་ཆེན་པོ་དང་རང་བཞིན་ལྷན་ཅིག་སྐྱེས་པ་དང་མཆོག་ཏུ་མི་འགྱུར་བ་དང་ཐིག་ལེ་དང་དེ་ཁོ་ན་དང་རང་བྱུང་ཡེ་ཤེས་དང་རྣམ་པར་དག་པའི་སེམས་མཁའ་ཁྱབ་༧ཀྱི་མིང་རྣམས་ཀྱི་ནང་ནས་ཝཾ་ཡིག་གཅིག་པུ་གཙོ་བོའི་མིང་མ་ཡིན་ཏེ།",
    "ཡོངས་སུ་དག་པའི་ཕུང་པོ་ཁམས་སོགས་རྣམས་ཏེ་དེ་ཡང་རང་བྱུང་མི་ཤེས་དོན་དམ་གྱི་ལྷ་ཚོགས་རྣམས་སོ།",
    "ཕྱི་མ་འདི་གཉིས་ཀྱིས་ཀྱང་རང་སྟོང་དང་གཞན་སྟོང་བསྟན་པ་ཡིན་ལ།",
    "དེ་ལ་ཟ་བ་དང་བཟའ་བ་ལ་སོགས་པ་ནི་རང་རང་ངོ་བོས་སྟོང་བའི་ཕྱིར་གང་ཞིག་གང་ན་མེད་པ་སྟེ་ཅིར་ཡང་མ་གྲུབ་ཅིང་ཅུང་ཟད་ཀྱང་མེད་པའོ།",
    "གང་ཞིག་ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་པ་ཁོ་ནར་ལྟ་གྱུར་པ།",
    "གང་དག་ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་པ་ཉིད་ལྟ་བ།",
    "སྒྲིབ་པ་གཉིས་ཀྱི་བདག་ཉིད་བཟུང་འཛིན་གྱི་དངོས་པོ་ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་ཡང་རྣམ་པར་དག་པ་མ་ཡིན་པར་གསུངས་ཤིང་དེ་རྣམ་རང་སྟོང་དུ་ངོ་ཤེས་པའི་སེམས་ཀྱང་དྲི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཚུངས་པར་ཐམས་ཅད་རང་རང་ངོ་བོས།",
    "ཕུང་པོ་རྣམས་རྣམ་པར་དཔྱད་ན་རང་རང་ངོ་བོས་སྟོང་བ་རྣམས།",
    "ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་བ་ཉིད་སྟོན་པ་གང་ཅི་ཡང་རུང་བ་དེ་ཐམས་ཅད་ནི་དྲང་དོན་དགོངས་པ་ཅན་དུ་རིག་པར་བྱ་ལ།",
    "སྟོང་པའི་གཟུགས་རྣམ་པར་འགགས་པའི་ལམ་བདེན་གྱིས་རྐྱེན་གྱིས་རང་རང་ངོ་བོས་སྟོང་བ་མ་ཡིན་པའི་འགོག་བདེན་གྱི་གཟུགས་ཀྱི་རྣམ་པར་གྲོལ་བ་མཐོབ་པར་འགྱུར་ཏེ་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་དང་རྣམ་པར་ཤེས་པའི་བར་དུ་ཡང་དེ་བཞིན་དུ་རྒྱས་པར་རིག་པར་བྱའོ།",
    "པོད་དང་པོརང་སྟོང་དུ་གནས་པ་འདི་རྣམས་འགགས་པས་ཕུང་པོ་གཞན་ལ་སོགས་པ་ཐོབ་པར་གསུངས་པ་འདིས་ཀྱང་རང་སྟོང་ལས་གཞན་པའི་ཕུང་པོ་ཁམས་སོགས་གཤིས་ལ་ཡོད་པར་གསུངས་ལ།",
    "གཟུགས་སོགས་རང་རང་ངོ་བོས་སྟོང་པ་གང་ཡིན་པའམ་དེ་ལྟར་ངོ་ཤེས་ཤིང་རྟོགས་པ་དེ་ཉིད་དེ་བཞིན་ཉིད་དང་རྣམ་མཁྱེན་མ་ཡིན་ནམ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "དེ་ལ་རང་རང་ངོ་བོས་སྟོང་པ་ཞེས་བྱ་བ་ནི་རང་རང་ངོ་བོས་སྟོང་བ་དང་རང་རང་ངོ་བོས་མི་སྟོང་བ་གཉི་ག་མི་མཐོང་བ་ར་ཕྱོགས་གཅིག་ཏུ་ཆད་པ་འོ།",
    "ཤེས་རབ་ཅན་གྱིས་ནི་རང་རང་ངོ་བོས་སྟོང་བ་ཀུན་རྫོབ་དང་རང་རང་ངོ་བོས་མི་སྟོང་བ་དོན་དམ་དང་དོན་དམ་རྟག་པ་དང་ཀུན་རྫོབ་འདུས་བྱས་མི་རྟག་པ་དང་ཁམས་གསུམ་འདི་སྡུག་བསྔལ་བ་དང་ཁམས་གསུམ་གཞན་བདེ་བ་དང་དག་པའི་བདག་དོན་དམ་དང་བདག་མེད་པ་ཀུན་རྫོབ་སྟེ་བདེན་གཉིས་ཀྱི་གནས་ལུགས་ཀུན་ཇི་ལྟ་བར་མཐོང་ངོ།",
    "རང་རང་ངོ་བོས་མི་སྟོང་བ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཆེན་པོ་འོ།",
    "དོན་དམ་བདེ་བ་དང་རང་བཞིན་གྱི་བདེ་བ་མེད་པ་ཀུབ་རྫོབ་དང་།",
    "༥ སྟོང་པ་ཆེན་པོ་ཡི་གེ་ལྔས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ལྔ་གསལ་བར་བསྟན་ཚུལ།",
    "གཞན་འབྱུང་ཡེ་ཤེས་བཞི་དང་རང་བྱུང་ཡེ་ཤེས་ལྔ་སྟེ་ཡེ་ཤེས་དགུར་ཡང་འགྱུར་ཞིང་།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱི་སྐུ་དང་ལོངས་སྤྱོད་རྫོགས་སྐུ་སྟེ་གཉིས་ལ་གནས།",
    "ཇི་ལྟར་ཉིད་ཀྱི་སྤྱོད་པ་དང་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་སྤྱོད་པ་དག་དུས་གཅིག་ཏུ་རང་ཉིད་ཀྱི་བ་སྤུའི་ཁུང་བུར་སྟོན་པར་མཛད་པ།",
    "ཇི་ལྟར་གསེར་བཟང་པོ་བཞུ་ཞིང་བཏུལ་ཏེ་སྦྱངས་པ་ལ་རྡུལ་དང་དྲི་མས་ཕྱིར་མི་གོས་ཤིང་རང་བཞིན་རྣམ་པར་དག་པའི་གསེར་ཉིད་དུ་སྣང་སྟེ་གསེར་གྱི་དངོས་པོ་རྣམ་པར་དག་པ་ཡང་མེད་པར་གྱུར་པ་མ་ཡིན་པ་བཞིན་ནོ།",
    "གཞན་ཡང་དཔལ་དོན་དམ་གྱི་རྣམ་གྲངས་གཞན་མང་པོ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པའོ།",
    "སྤྱོད་བསྡུས་སྒྲོན་མར་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ།",
    "དེ་བཞིན་དུ་སློབ་དཔོན་དོན་དམ་གྱི་མཚན་བརྗོད་དུ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ།",
    "དེ་བཞིན་དུ་བདག་དང་རང་བཞིན་འོད་གསལ་གྱི་གཟུགས་སོགས་ཀྱང་སྔར་བསྟན་པ་རྣམས་དང་དོན་ཅིག་ཚུལ།",
    "དེ་བཞིན་དུ་མཚན་སྟོང་པ་ཆེན་པོ་ཡི་གེ་ལྔས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ལྔ་གསལ་བར་བསྟན་ཚུལ།",
    "རྣལ་འབྱོར་པ་དེ་ནི་ཐབས་ཀྱི་རྩ་ན་མར་ཡུར་ཆུ་འབྲུག་ཅིང་འདུག་པའི་ནང་ན་ཆུའི་སྲོག་ཆག་འདུག་པ་རྣམས་བཟུང་ནས།",
    "ཕྱོགས་ཐམས་ཅད་དུ་བལྟས་པས་སུའང་མི་འདུག་ནས།",
    "དེ་ནས་ཕྱིས་འདི་ན་འདུག་བྱ་བའང་མེད་པར་གཤེགས་ནས་གཏན་མ་མཇལ་ལོ།",
    "གཞི་དང་རང་བཞིན་འབྲས་བུའོ།",
    "གཞི་དང་རང་བཞིན་རྒྱུ་ཡིན་ཏེ།",
    "དུ་བ་འདུག་པའི་ཕྱི་མེ་ཡིན་ཞེས་ཧེ་དུ་དུ་བའི་སྒོ་ནས་མེ་རུ་ངེས་པ་བཞིན་དུ།",
    "རྗེ་དཔག་རྟོག་བཅས་ཡིན་ཡང་རང་ལ་རང་རིག་པ་མངོན་སུམ་ཡིན་ཏེ་དེ་གཉིས་གཅིག་པ་མི་འགལ་བ་བཞིན་ནོ།",
