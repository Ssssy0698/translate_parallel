    "ཤཱ་རིའི་བུ་ལ་སྐྱབས་སུ་སོང་།",
    "སྐྱབས་འོས་དག་ལ་སྐྱབས་སོང་ནས།",
    "གཙུག་ལག་ཁང་གི་ཐིག་པཱ་ཏ་སྱ་ཏུ་ལ་ཨེ་བ་ཀྵཎེ་མ་ཧཱན།",
    "ཧེ་མོ་བི་ཧཱ་ར་སཾ་བྲྀཏྟསྟུ་ཥི་ཏེ་དེ་བ་པདྨ་ནི།",
    "གང་གི་ཚེ་ན་ཕྱོགས་དེ་རུ།",
    "དེ་མཐོང་མཚར་ནས་དགེ་སློང་གིས།",
    "བཀའ་སྩལ་ཆུ་འདིར་རེངས་པ་ཡི།",
    "བུད་ྡྷཱ་ཡ་ཤི་ཁི་ནེ་པྲ་འདིས།",
    "རྣམ་པར་གཟིགས་ལ་འདི་ཉིད་ཀྱིས།",
    "མཆོག་གི་ཀུན་དགའ་ར་བ་ཡི།",
    "ཀཱ་ལེ་ན་སུ་དྷནཱ་ཁྱོ་ཡཾ་མེ་ཏྲེ་ཡཱ་ཡ་པྲ་དཱ་སྱ་ཏི།",
    "ཙཀྲེ་པྲ་ཏྱེ་ཀ་བུད་ྡྷསྱ་སཾ་སྐཱ་རཾ་པ་རི་ནིརྦྲྀ་ཏོ།",
    "ཤྲཱི་མཱན་པུ་རཱ་ཤཱཀྱ་པུ་རེ་ན་རེནྡུ་ཤུད་ྡྷོ་ད་ན་ཤུད་ྡྷི་སུ་དྷཱ་ནི་དྷཱ་ནཾ།",
    "བུ་ཡི་བཞིན་རས་གང་ཚེ་བདག་གིས་མཐོང་།",
    "བདག་གིས་གང་གང་རྒྱལ་བྱེད་ཚལ་དུ་བཏང་།",
    "དེ་དགུག་སླད་དུ་བདག་གིས་ཡང་དག་བཏང་།",
    "དེ་ཡི་ཁ་ལ་བདག་གི་འཕྲིན་གྱི་ཚིག།",
    "བི་ལོ་ཀ་ནེ་ནེ་ཏྱ་ནི་ཥིཉྩ་ཏཱུརྞཾ་པཱི་ཡཱུ་ཥ་པཱུ་རེ་ཎ་མ་མཱཾ་ག་སངྒཾ།",
    "རྟག་ཏུ་བདུད་རྩིས་ཁེངས་པའི་རྣམ་གཟིགས་ཀྱིས།",
    "མྱུར་དུ་བདག་གི་ལུས་ལ་ཆགས་གྱུར་པ།",
    "ཡིད་ལ་རེ་བ་འདི་ཡིས་ས་ཡི་བདག།",
    "ཨུཏྐཎྛི་ཏ་ཀུཎྛི་ཏ་དྷེཪྻ་བྲྀཏྟི་སཾ་མོ་ཧ་མུརྩྪཾ་། སོང་བའི་ཚེ།",
    "ས་ལབ་ྡྷསཾ་ཛྙཱ་ཤི་ཤི་རེ་པ་ཡེ་བྷི་ས་པྲཙྪ་ཏཾ་ཀིནྣུ་ས་མེ་ཥྱ་ཏཱི་ཏི།",
    "ལྷ་གཅིག་ཁྱོད་ཅན་ཉིན་ཞག་ཚོགས་ཀྱིས་དེས།",
    "དགེ་སློང་ཚོགས་ཀྱི་རྗེས་འབྲང་ལྷ་རྣམས་ཀྱི།",
    "ནི་རནྟ་རེ་རནྟ་རི་བཱ་ཀེ་ཏཱ་རེ་སུ་རེ་ས་པའི་ལྷ་ཡི་རི་བོ་བཞིན།",
    "གཞལ་ཡས་ཁང་གི་ཕྱོགས་ཀྱི་གདོང་མཛེས་པ།",
    "ཨཱཤྩཪྱ་རུ་ཙི་གིས།",
    "སྐྱེ་བོའི་མིག་གི་རབ་དགའ་སྤུངས་པ་དང་།",
    "ས་བདག་རིང་ནས་ཐལ་མོ་སྦྱར་ནས་བཏུད།",
    "ཡིད་ཀྱི་ཟླ་བ་མིག་གི་བདུད་ནཱ་མྲྀ་ཏོ་གྷཾ་མ་ནོ་ར་ཐ་པྲཱརྠ་ན་ཡོ་ས་ཡཱ་ཏཾ།",
    "ཡིད་ལ་རེ་བས་དོན་གཉེར་འོངས་པ་དེ།",
    "སྣེ་ཧཱཏ་པྲ་མོ་དཱ་ཏ་ལ།",
    "བདག་ཅག་རྣམས་ལ་ཁྱོད་ཀྱིས་ཅི་ཕྱིར་མཛད།",
    "བདག་གི་བློ་ནི་འཕྲལ་ལ་ཁྱོད་ཅན་རྒྱུག།",
    "ཅུང་ཟད་གང་དེ་བདག་གིས་བརྗོད་པ་འདི།",
    "བདག་ལ་བྱམས་ངོར་ཁྱོད་ཀྱིས་གསན་པར་བྱ།",
    "ཡོན་ཏན་སྤངས་པའི་ཆགས་བྲལ་རིམ་པ་ར་ས་ཀྲ་མཾ་དཱ་ན་སྣེ་ཧ་མོ་ཧ་སྱ་བྷབ་ཏྱ་བཱ་ཙྱཾ།",
    "བཏང་ནས་ཁྱོད་ནི་ནགས་ན་སྟོང་པར་འཁྱམ།",
    "མི་བདག་ལ་འོས་ཁྲི་སྟན་བླ་རེ་ཆེ།",
    "དཔལ་མོས་གསར་འཁྱུད་ལོངས་སྤྱོད་འོས་གྱུར་པ།",
    "ཁྱོད་ཀྱི་ལུས་ཀྱིས་སྟན་ངན་ཇི་ལྟར་བཟོད།",
    "ཁྱོད་ཀྱི་ཕྱག་ནི་པདྨོའི་རོལ་གནས་འདིར།",
    "ཁྱོད་ཀྱི་མགྲིན་པ་རྒྱབ་ཀྱི་གནས་འདི་དག།",
    "ལོངས་སྤྱོད་དཔལ་མོའི་རབ་དགའ་ཉམས་གྱུར་ཅིང་།",
    "ལང་ཚོ་དགའ་བའི་རྩེ་ས་ཉེ་བའི་ནགས།",
    "ཅི་སླད་ཁྱོད་ཀྱི་མི་བཟད་ཆགས་བྲལ་བྱས།",
    "ཟླ་བའི་ཆ་བཞིན་རོལ་པའི་འཛུམ་དག་གིས།",
    "རྣ་བ་ཐོས་པས་ཀཱ་ཡ་ཀ་རུ་ཎཱ་ཀུ་ལཱ་ནཱཾ་པ་རོ་པ་ཀཱ་རེ་ཎ་ན་ཙནྡ་ནེ་ན།",
    "ཨེ་ཏཱ་ནི་མོ་ཧཱ་ཧ་ཏ་བལླ་བྷཱ་ནི་སཾ་སཀྟ་མུཀྟཱཾ་ཤུ་སི་ཏ་སྨི་ཏ་ནི།",
    "ས་བདག་གིས་སྤྱད་ལྷག་མར་གྱུར་པའི་རྒྱན།",
    "ནིརྨོ་ཀ་ཀཱནྟེ་ན་བ་རཱཾ་ཤུ་ཀེ་ན་བྷུ་ཛཾ་ག་པྲྀཏྟིརྣ་ཏུ་ཙཱི་བ་རེ་ཎ།",
    "རེག་ན་བདེ་བའི་ལམ་ན་གཉིད་ཡོད་མིན།",
    "ཛཱ་ཌྱཾ་ས་ཛྲྀཾ་བྷཛ་ན་ཡ་ཏྱ་ཛ་སྲཾ་ཏ་ནོ་ཏི་ཏྲྀཥྞཱ་བྷྲ་མ་མོ་ཧ་མཱུརྩྪ།",
    "གང་གི་ལུས་ལ་གནོད་པ་རྟག་གནས་དེ།",
    "གང་ཚེ་བདེ་དཔལ་ཟླ་ཚེས་རི་མོ་དང་།",
    "ལོང་ཚོ་ཡང་ནི་སྔ་དྲོའི་མེ་ཏོག་སྟེ།",
    "དེ་ཡི་སྤྱན་གྱིས་འཁོར་ལ་རྣམ་པར་གཟིགས།",
    "དེ་བཞིན་སམྱཀྟ་ཐཱ་ནུཏྟ་ར་བོ་དྷི་སཀྟཱ་པ་རེ་བ་བྷཱུ་བུརྒ་ག་ན་པྲ་སནྣཱ།",
    "ཉོན་མོངས་རྣམ་གྲོལ་གཞན་གྱིས་དགྲ་བཅོམ་ཐོབ།",
    "ཨེ་ཀསྟུ་ཏ་ཏྲཱ་ཛི་ཏ་པཱ་པ་ཤ་པསྟ་མ་ས་མུ་ཧོ་པ་ཧི་ཏ་པྲ་མོ་ཧ།",
    "སྡིག་དམོད་མ་ཐུལ་སྐྱེ་བོ་རྣམས་ཀྱི་ལུགས།",
    "མོདྒ་ལྱ་བྷི་ཀྵུ་ཛི་ན་ཤཱ་ས་ནེ་ན་མ་ཧར་ྡྷི་བྷིརྦཱི་ཏ་མ་དཾ་ཙ་ཀཱ་ར།",
    "ཨ་རྒྱལ་བའི་བཀའ་ལས་དགེ་སློང་མོ་གལ་བུས།",
    "ཕུལ་བྱུང་མཛད་པ་གོམས་པས་རེག་པ་ནི།",
    "དེ་ཐ་པ་རེ་དྻུརྦྷ་ག་བཱན་སུ་རེནྡྲ་སཾ་པ་དི་ཏེ་ཧེ་མ་མ་ཧཱ་བི་མཱ་ན།",
    "ལྷུན་པོའི་ལྕོག་ལྟར་སོགས་ཚིག་རྐང་གཅིག་གི་སྐད་དོད་ཆད་པ་འདར་ལོས་བཅུག་པ་སླར་དཔྱད།",
    "ཨ་ནྱོ་ནྱ་སཾ་གྷཊྚ་བི་ལོ་པ་ཧཱ་རེར་ྒྷནཱ་བ་ཧཱ་རེ་ཏྲི་ད་ཤེརྦི་ཤད་ྦྷི།",
    "ནི་རནྟཱཾ་ཏཱཾ་བྷུ་བ་མེ་བ་རཱ་ཛཱ་དྭཱ་རེ་ཥུ་མཱརྒཱ་ན་ཙ་ཏུཪྵུ་ལེ་བྷེ།",
    "དོ་ཤལ་ཕན་ཚུན་རེག་ཅིང་གཡོ་བ་ཡིས།",
    "ཤུད་ྡྷོ་ད་ནསྟཾ་པྲ་ཎི་པ་ཏྱ་མཱུར་ྡྷྣཱ་ཙིཏྟ་པྲ་སཱ་དེ་ན་པུ་རེ་སྱ་ཏསྠོ།",
    "སྭ་སྱ་བྲ་བཱིཏྟཾ་བྷག་བཏྤྲ་དིཥྚཾ་དཙྪཱ་ས་ནཾ་མོ་ད་ཡི་ཏཾ་ན་རཱ་ཛྱཾ།",
    "སོང་ནས་ཟས་དཀར་ལ་སྨྲས་རྒྱལ་སྲིད་གཟུང་།",
    "དེ་ནས་ཟས་གཙང་གིས་ན་སཾ་པྲ་དིཥྚཾ་ཏཱཾ་རཱ་ཛྱ་ལ་ཀྵྨཱི་མཐ་བྷཏྲི་ཀཱ་ཁྱ།",
    "ཟས་གཙང་ཡིད་ལ་རེ་བ་དག་པར་གྱུར།",
    "རིམ་པས་ལོང་ལ་ཁྱོད་ནི་ཅི་ཞིག་བརྗོད།",
    "རབ་ཏུ་བྱུང་བས་ཁྱོད་དང་བདག་མཚུངས་འགྱུར།",
    "འཁྱོག་ཚིག་བརྗོད་པ་རྒྱལ་པོས་ཐོས་གྱུར་ནས།",
    "ཤཱཀྱའི་ཚོགས་འདི་ཁྱོད་ཀྱི་བརྟག་པ་ཡིས།",
    "ཅི་སླད་བདག་གིས་ཕྱིན་ཅི་ལོག་འདི་བརྗོད།",
    "རང་གི་རྒྱལ་ཧཱ་བྷཏྲི་ཀཱ་དྱཱ།",
    "འཕགས་པའི་སྤྱོད་ཚུལ་ལ་དགྱེས་ཟས་གཙང་གི།",
    "ཁྲག་གིས་བྱུགས་འདྲ་ཏཱམྦ་རཱ་གྲཾ།",
    "ཀོ་ཀཱ་ལི་ཁཎྜོཏྐ་ཊ་མོ་ར་ཀཱ་ཎཱཾ་ཏི་ཐྱཱ་དི་ནཱམྣ་མ་དུརྨ་དཱ་ཤ་འདོད་ཁྲ་ཡིས་ཁྱེར།",
    "དེ་ནས་མཚན་མཁན་གྱིས་དེའི་ཁྲག་གི་རྟགས།",
    "འཚེ་སོགས་མིང་དང་ཆང་གིས་རབ་ནཱཾ།",
    "བྷཱུ་པ་པྲ་མོ་དཱ་ད་ཐ་བྷདྲི་ཀོ་པི་ཏེ་རྡེ་བ་དཏྟ་པྲ་མུ་ཁེ་ས་ཧེ་བ།",
    "པ་བྲ་ཛྱ་ཡཱ་མོ་ཧཱ་ནུ་བན་ྡྷི་སཾ་ཏྱ་ཛྱ་ཏེ་ཛཱ་ཏི་མ་ཡོ་བི་མཱ་ན།",
    "བཅོམ་ལྡན་གསུང་གིས་རུ་ཥཱ་བྷི་དྷཱ་ཡཱི་པ་དོ་བ་བནྡེ་བྷག་བཱན་གི་རཱ་སྱ།",
    "ཨུ་བཱ་ཙ་རཱ་ཛྙཱ་ཀི་ལ་ཀལྤ་ཀ་སྱ་ཛནྨཱནྟ་རེ་སྱ་སྱ་ཀྲྀ་ཏ་པྲ་ཎཱ་མ།",
    "པུ་ར་ཡུ་བཱཾ་ཀཱ་ཤི་པུ་རེ་དེ་ཡི་རྐང་པ་ལ།",
    "དགེ་སློང་ཚོགས་ཀྱིས་དྲིས་ཤིང་སྟོན་པ་ཡིས།",
    "ཏ་ཡཱ་བི་སྲྀཥྚ་ཀུ་སུ་མོཙྩ་ཡཱ་ཡ་པུ་ན་པུ་ནར་ྦྷྲྀདྒ་ཨི་བཱ་དྷི་ཀཱརྠཱི།",
    "ཏཏྶཾ་ག་མཱ་ནཾ་ག་མ་ནོ་ར་ཐེ་ན་ཤྲཱནྟ་སྨད་འཚོད་བཟང་མོ་ཞེས་པ་སྔོན་མཐོང་གྱུར།",
    "དེ་དང་འགྲོགས་པའི་ལུས་མེད་རེ་བ་ལས།",
    "ནགས་ནང་ས་བ་བྷྲ་མ་བ་ནཱནྟ་རེ་ཥུ།",
    "ཨ་ཏྲཱནྟ་རེ་ཤྲཱནྟ་ཏ་ར་ཀྵི་ཏཱི་ཤ་པྲཱཔྟོ་བ་ནནྟཾ་མྲྀ་ག་ཡཱ་ར་སེ་ན།",
    "ལུས་ནི་འཁྲི་ཤིང་གིས་བསྒྲིབས་ཚངས་བྱིན་གྱིས།",
    "ཅི་སྟེ་དེ་ལྟར་གདུང་བས་ཁྱོད་འཇོམས་མྱུར་དུ་སོང་།",
    "གང་ཕྱིར་ཉིན་མོའི་མཇུག་ཏུ་ཟུམ་པར་གྱུར་པ་ཡིན།",
    "མི་བདག་གིས་ནི་དེ་ཡི་གླུ་སྐད་ཐོས།",
    "འཛུམ་ཟེར་དོ་ཤལ་མཛེས་པ་ལ་རེག་ཅིང་།",
    "ཏེ་ནཱ་ཐ་རཱ་ཛཱ་བི་ཛ་ནི་ཤྲ་མཱ་ཏུ་ཤཱི་ཏོ་པ་ཙཱ་རེ་ར་པ་ནཱིཏ་ཏཱ་པ།",
    "སུ་ཞིག་དག་གིས་བསྙེན་བཀུར་གནས་མི་འགྱུར།",
    "མཛེས་པས་མཚན་མོ་བསམས་པ་བདག་ཡཱཾ།",
    "ཨེ་ཀཱརྠ་ཡོ་གེ་ས་དཱ་བིབཱ་དཱི་དྭ་ཡོརྷི་བྷོ་གེ་ཀ་ལི་རེ་བ་མུརྟྟཱ།",
    "བཟང་མོ་མེད་ན་རྒྱལ་སྲིད་བདེ་བས་ཅི།",
    "རྒྱལ་སྲིད་མཐའ་དག་གིས་ནི་བདག་རྫོགས་འགྱུར།",
    "བདག་གིས་ཅི་བསམས་མཆོག་ཏུ་སྨད་འོས་འདི།",
    "སྭསྟྱསྟུ་རཱ་ཛྱཱ་ཡ་ན་མ་སུ་ཁེ་བྷྱ་སཾ་མོ་ཧ་མཱ་ཏཱ་ཀྵམ་ཏཱཾ་ཙ་ལ་ཀྵྨཱི།",
    "ཀྱེ་མ་རང་སེམས་ལ་ཡང་ངོ་རེ་ཚ།",
    "མི་ཡི་བྷྱརྠྱ་མཱ་ནོ་པི་ན་རེ་ཤྭོ་རེ་ཎརཱ་ཛྱཾ་ན་གྲཱ་ཧ་ནི་བྲྀཏྟ་ཏྲྀཥྞ།",
    "པྲ་ཏྱེ་ཀ་བུད་ྡྷཏྭ་མ་བཱཔྟ་མེ་ནཾ་ཀཱ་ལེ་ན་དྲྀཥྚཱ་ནྲྀ་པ་ཏིརྨ་ཧར་ྡྷི།",
    "ཏཏྤཱ་ད་པདྨ་ཙྱུ་ཏི་མོ་ལི་མཱ་ལྱཤྩིཏྟ་པྲ་སཱ་དོ་ཙི་ཏ་མི་ཏྱ་བོ་ཙཏ།",
    "རྫུ་འཕྲུལ་ཆེ་ལྡན་མི་བདག་གིས་མཐོང་ནས།",
    "གང་གི་མཐུ་ལས་ཆགས་པ་བྲལ་རྣམས་ཀྱིས།",
    "མཆོག་གི་ལས་ཀྱི་སྦྱོར་བས་རབ་བྱུང་ལས།",
    "ཨི་ཏྱཱཤྩཱཪྱཾ་བྷག་བ་དུ་དི་ཏཾ་བྷི་ཀྵབསྟེ་ཤ་མྱ་སྭ་ཙྪཾ་ཙིཏྟཾ་སུ་ཀྲྀ་ཏ་ཤ་ར་ཎེ་མེ་ནི་རེ་ཧེ་ཏུ་མེ་བ།",
    "ལྷ་པུ་རཱ་ཤཱཀྱ་པུ་རེ་ཛི་ན།",
