    "དགེ་སློང་གིས་དྲིས་བཅོམ་ལྡན་འདས།",
    "དེར་ནི་མི་བདག་ཛ་ཡཱ་ཁྱོ་བྷཔཏྟ་སྱཱ་མ་མི་ཏྲ་ཏི་མི་རཱཾ་ཤུ་མཱན།",
    "ཨ་པཱུརྦྦ་ཏྱ་གི་ནཱ་ཡེ་ན་ཀྲྀ་ཏཾ་ཀལྤ་ཏ་རོཪྻ་ཤ།",
    "མིག་གི་ཀུན་དགའ་བདུད་རྩིའི་གཟུགས།",
    "གང་གིས་སྔོན་མེད་གཏོང་བ་ཡིས།",
    "དཔག་བསམ་ཤིང་གི་གྲགས་པ་ཕྲོགས།",
    "བདེན་པ་གང་གི་ཚིག་དང་ནི།",
    "གང་གི་གྲགས་པ་ཀེ་ཏ་ཀའི།",
    "ནང་གི་འདབ་ལྟར་དྲི་མེད་པ།",
    "བ་བྷཱུ་བཱ་ཀྲཱནྟ་ཧྲྀ་ད་ཡཤྩིནྟཏྟ་ཡ་བ་ན་རེ་སྭ་ར།",
    "འོད་ཀྱིས་ཡིད་ལ་རེ་བ་འཕྲོག།",
    "རིན་ཆེན་མཆོག་གིས་བརྒྱན་པ་བྱིན།",
    "ཏཏྟོ་ར་ཐ་ཀུ་མཱ་རེ་ཎ་ས་ཛེ་ཏྲ་ཤ་ཏྲུ་མརྡྡ་ན།",
    "ལ་ཀྵྨཱ་སུ་ཁ་ནི་ཥཎྞཱཾ་མེ་ཡཱ་ཏཱ་ཡིད་ལ་རེ་བ་བསམས་པས་ནོན།",
    "གང་གི་མཐུ་ཡིས་རབ་བསྒྲུབས་པ།",
    "ར་ཐེ་སོཪྻ་པ་ཐེ་ཏསྨིན་ཛ་ཡ་ཀུཉྫེ་བ་ཀུཉྫ་རེ།",
    "འདི་ནི་རྒྱལ་པོ་ཁྱོད་ཀྱི་སྐྱོན།",
    "ལྗོན་པ་གཟིགས་སུ་ནགས་སུ་གཤེགས།",
    "བ་བྷཱ་ཥི་རེ་ས་མ་བྷྱེ་ཏྱ་སྭསྟི་བཱ་ད་པུ་ར་ས་རཱ།",
    "ལེགས་པ་ཁྱོད་ནི་འཇིག་རྟེན་ན།",
    "ཁྱོད་དང་མཐོ་བརྟན་གླང་འདི་འོ།",
    "ཁྱོད་ལས་གཞན་གྱིས་གཏོང་དཱ་ཏུ་མེ་མེ་ཥ་ཤཱཀྱ་ཏེ།",
    "གྲགས་པ་མི་བདག་གིས་ཐོས་ནས།",
    "བཙུན་མོ་མ་དྲིས་ལྷ་གཅིག་དེས།",
    "བུ་མོ་ཁྱེར་ནས་ནགས་སུ་སོང་།",
    "སོང་ཚེ་བྲམ་ཟེ་སུ་ཞིག་གིས།",
    "བུ་སྲིང་བཱ་ལ་ཀཱ་བི་མོ།",
    "ཁྱོ་ཡི་མདུན་དུ་འགྱེལ་བར་གྱུར།",
    "ཁྱོ་ལ་མཛའ་བས་རྗེས་ཞུགས་དེ།",
    "ཨ་ཏྲཱནྟ་རེ་ས་མ་བྷྱེ་ཏྱ་བི་པྲ་རཱུ་པ་སུ་རེ་ཤྭ་ར།",
    "རྒྱལ་པོའི་སྲས་ལ་བཙུན་མོ་ནི།",
    "སྡུག་མ་འབངས་མོའི་དོན་དུ་བསླངས།",
    "བཙུན་མོ་དང་བྲལ་མྱ་ངན་དག།",
