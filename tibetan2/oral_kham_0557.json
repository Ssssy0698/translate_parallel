    "དོའི་ཕྱིར་ན་རང་བཞིན་མེད་པ་ཉིད་ཀྱིས་ནམ་ཡང་རང་རིག་པ་གྲུབ་པམ་ཡིནནོ།",
    "སེམས་དེ་ཡང་རང་བཞིནཀྱི་འོད་གསལ་བ་ཡིན་པའི་ཕྱིར་རྣམ་པར་བྱང་བའི་རང་བཞིན་ཡིན་པས་སྤང་བར་བྱ་བ་མ་ཡིན་ལ།",
    "ཞག་པར་ཞེནནས་འདུག་པ་དེ་ནི་ཚོར་བར་རྐྱེན་གྱིས་སྲེད་པ་ཞེས་བྱའོ།",
    "ལྷག་པར་ཞེན་ནས་འདུག་སྡུག་པའི་ངོ་བོ་དང་།",
    "ཚོ་གསཔ་སྟེ་ཚོགས་པའི་ཡུལ་ལའབྲས་བུཐམས་ཅད་བྱེད་པ་ལ་ནུས་པ་དང་བྲལ་བའི་ཕྱིར་ཚོགས་པ་སྐྱེད་པལ་ཡང་བཏང་སྙེམསུ་འདུག་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "ནུས་པ་ཡོད་པ་འདི་ཡང་རང་བཞིན་གྱིས་ལྷན་ཅིག་བྱེད་པའི་རྒྱུདང་ཉེ་བ་མ་ཡིན་ན་བྱེད་པ་པོ་མ་ཡིན་ནོན་ན།",
    "དེ་བཞིན་དུ་ཆུ་དང་མེ་དང་རང་དང་ནམཁའ་དང་ངུས་ཀྱང་མ་ཚང་བ་མེད་པར་འགྱུར་ཏེ།",
    "འགྲོ་ཡང་རུང་འགྲེང་ཡང་རུང་འདུག།",
    "ཁོ་བོ་ཅག་ནི་ཡུལ་སྒྱུ་མ་ཙམ་འདི་མེད་ཀྱང་རང་རིག་པའི་སྒོ་ནས་ཤེས་པ་ཉིད་དུ་ཁས་ལེན་པས་དམབཅས་པ་ཕན་ཚུན་འགལ་བའི་ངེས་པ་མི་མཚུངས་སོ་ཞེ་ན།",
    "འོན་ཏོ་གང་ལས་༦ཀྱང་མ་སྐྱེས་ཀྱང་རང་བཞིན་གྱིས་གནས་སོ་སྙམ་ན།",
    "ལྷག་པར་བྲམ་ཟེ་དང་བདག་རྒྱུར་བྱེད་པའི་མཚན་ཉིད་རིག་པ་དང་རང་བྱུང་རྣམས་ལྷར་བྱེད་སྲོལ་གྱིས་སྐྱེ་འགྲོའི་འདོད་བློ་མ་ཚིམས་པ་དང་།",
    "ལམ་འགོག་ཅིང་འདུག་པ་དང་།",
    "བསླང་ནས་ཀྱང་དེ་ནམ་མཁའི་དཀྱིལ་ན་འདུག་སྟེ།",
    "སེང་གེའི་ཁྲིའི་ཟིལ་གྱིས་མནན་ནས་འདུག་གོ།",
    "ཐག་གཅོད་ཐུབ་པའི་གནས་ཚུལ་ནི་ཤིན་ཏུ་ནས་དཀོན་པོ་འདུག་ཕྱི་ལོའི་གོང་ཤཱཀྱའི་འདས་ལོ་ཟེར་བ་སོགས་དུས་ཚིགས་མེད་སྟབས་རྒྱལ་པོ་གྲགས་ཆེ་བ་ཞིག་རྒྱལ་ཁྲིར་འཁོད་དེ་ལོ་འདི་ཟེར་རྒྱུ་ཙམ་ལས་ལྷག་མེད།",
    "དགྲ་བཅོམ་པ་གྲགས་པ་ཁོ་ན་ཡིན་གསུངས་འདུག་ཀྱང་།",
    "ཚེ་དང་ལྡན་པ་གྲགས་པས་དེ་བཞིན་རྒན་རིམས་སུ་འདུག་པ་ལ་དངོས་པོ་བཅུ་བཟླས་པར་ཞུགས་ཏེ།",
    "སྐྱེ་རབས་སུམ་ཅུ་སོ་གཉིས་ཡོད་འདུག་ཟེར།",
    "ཕྱི་ལོགས་སུ་རྒྱས་སྒོ་ཡོད་པའི་མཆོད་རྟེན་ཆེན་པོ་ཞིག་བྱུང་འདུག་མཆོད་རྟེན་འདི་ཕྱི་ལོའི་གོང་བཞེངས་ནས་དུས་རབས་གཉིས་པའི་དཀྱིལ་དུ་ཉམས་གསོ་རྒྱ་བསྐྱེད་དང་རྒྱས་སྤྲོས་ཅན་ཞིག་ཏུ་བསྒྱུར་ཅིང་རྡོ་བརྐོས་ཡི་གེ་བཅུ་གཅིག་རྙིང་པ་དང་།",
    "མུ་སྟེགས་པའི་ལྷ་ཁང་བརྒྱ་ཕྲག་དུ་མ་ཡོད་པར་ཕྱི་རོལ་གཅེར་བུ་པ་མང་ཙམ་འདུག་གོ།",
    "ཕྱིས་ཐེབས་པར་འདུག་སྐད།",
    "ཅེས་པའི་དོན་བོད་སྔ་རབས་ཁ་ཅིག་སྒྲ་ཇི་བཞིན་ཞལ་བཞེས་གནང་མཁན་འདུག་ཀྱང་།",
    "ཀ་འདི་ཀླུ་སྒྲུབ་ཀྱི་ཡིན་པར་འཁོད་འདུག་འདི་ཤེར་ཕྱིན་མན་ངག་བམ་པོ་བཅོ་བརྒྱད་པར་ཡང་ལུང་འདྲེན་བྱས་ཡོད།",
    "མིང་གསལ་པོར་འཁོད་འདུག་ན་དེའི་རྗེས་སུ་བརྩམས་པར་ཤོད་ཅི་དགོས།",
    "མངོན་སུམ་གྱི་ངོ་བོ་ཉིད་ཀྱི་ལྐོག་ན་འདུག་པའི་ངོ་བོ་ཉིད་བརྟག་པའམ།",
    "འདི་ལྟར་འདི་ན་ཁ་ཅིག་དུས་ལ་བབ་པ་ན་ཚིག་དལ་བུས་སྨྲ་བར་བྱེད་ཀྱི་རིངས་པར་མི་སྨྲ་བ་ལྟ་བུ་སྟེ།",
    "དག་པའི་མངོན་སུམ་རྣལ་འབྱོར་མངོན་སུམ་བཅས་བཞི་གསུངས་འདུག་ཀྱང་།",
    "ཞེས་སོགས་ཀྱི་ཁ་ཇི་ཡ་མས་གསུངས་པ་ལྟར་རང་བཞིན་རྟགས་དང་འབྲས་རྟགས་བསྟན་པར་ཁས་བླངས་ཀྱང་འགལ་བ་དེ་ཙམ་མི་འདུག་ཀྱང་།",
    "ཚུལ་མིན་བྱ་སྤྱོད་ལ་གཏིང་ནས་མི་དགའ་ཞིང་རང་བཞིན་དྲང་པོ་ཅན་རྣམས་ལ་རྗེའུའི་རིགས་དང་།",
    "སེམས་བདེན་སྟོང་རང་བཞིན་གྱིས་འོད་གསལ་ཞིང་།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་ཡང་རང་ཉིད་ཀྱིས་ཇི་ལྟར་གཏན་ལ་ཕབ་པ་ལྟར་དོན་ལ་གནས་མི་གནས་ནི།",
    "འོན་ཀྱང་ངའི་རིགས་པ་འདི་གཞན་གྱིས་མ་ནོར་བར་མི་ཤེས་པར་འདུག་དགོངས་ཏེ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པ་ཡིན་ནོ་ཞེས་འདོད་དོ།",
    "ཉི་ཁྲིར་ཨ་ར་པ་ཙ་ན་སོགས་གཟུངས་སྔགས་ཡིག་འབྲུ་བཞི་བཅུ་ཞེ་གསང་སྔགས།",
    "ཤེར་ཕྱིན་དུ་སྔགས་ཀྱི་ཡིག་འབྲུ་དེ་རྣམས་ལ་གཟུངས་ཀྱི་སྒོ་ཞེས་མཚན་བཏགས་འདུག་ཉི་ཁྲིའི་འགྲེལ་པ་ཤེར་ཕྱིན་མན་ངག་ཏུ་གཟུངས་སྔགས་ཡིག་འབྲུ་བཞི་བཅུ་ཞེ་གཉིས་ཀྱི་འགྲེལ་བརྗོད་རྒྱས་པར་བཞུགས།",
    "ཡིག་ཚང་མང་ཞིག་ན་མེ་ཡོས་ལ་རྨང་བཏིང་ནས་ས་ཡོས་ཀྱིས་ཚར་ཞེས་པ་འདུག་ཀྱང་།",
    "རྒྱ་ནག་པོའི་ལོ་ཙ་ནི་བྲེན་ཀ་ལེགས་ཀོ་དང་།",
    "འདུག་པ་ཡང་བླའི་གོང་དུ་སྟོན།",
    "བེ་རོ་ཙ་ན་དང་།",
    "བེ་རོ་ཙ་ན་དང་གཙང་བཙུན་ལེགས་གྲུབ་འཚོལ་དུ་བཏང་།",
    "བི་རོ་ཙ་ན་ཚ་བ་རོང་དུ་སྐྱུགས་པའི་བཀའ་ཆད་ཀྱིས་དེ་ནས་ཟླ་བ་གསུམ་ལོན་པ།",
    "འཁོད་མིན་འདུག་ཀྱང་།",
    "ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "དེའི་རྗེས་སུ་བརྩམས་པའི་སྐོར་གྱི་ཁུངས་བསྐྱེལ་བརྗོད་ཟིན་པར་མ་ཟད་དཀར་ཆག་ཕྱི་མ་དེ་གཉིས་ཀྱང་ག་དུས་སུ་མཛད་མིན་ད་བར་དཔྱད་གཞིའི་ཡིག་རྙིང་མ་རྙེད་པས་ན་ད་དུང་དཔྱད་དགོས་སོ།",
