    "རོལ་མོ་བསླབ་དང་བསྟན་བཅོས་བཀླག།",
    "དེ་བདུན་ནུབ་སྒོའི་རྒྱུ་སྐར་ཡིན། མོན་གྲེ་ལ་བཞི་བྱ་ཡི་དབྱིབས།",
    "གྲོང་བརྩམས་བུད་མེད་ལས་རྒྱལ་ཞིང་།",
    "རྨ་༣ ཚ་སྶམ་མོན་གྲུ་གཅིག་ཡིན་ཐིག་ལེའི་དབྱིབས།",
    "བུད་མེད་དང་ནི་བཏུང་བ་མོད།",
    "སུམ་ཅུ་ལུག་གི་ཤ་ཁྲག་ཟས།",
    "སྒྲ་གཅན་ལྡན་ན་རོལ་མོ་པ།",
    "སྲིང་མོ་བརྒྱད་ཀྱི་རྒྱུད་ཡིན་ནོ།",
    "ཆང་གི་ལས་རྣམས་བྱ་བར་བཟང་།",
    "བཙོན་བཟུང་ཞག་གསུམ་གྱིས་༡༧ཐར་འགྱུར། བྲ་ཉེ་གསུམ་ཡིན་མོ་རྟགས་འདྲ།",
    "འདི་བདུན་བྱང་གི་རྒྱུ་སྐར་རོ།",
    "སྨིན་དྲུག་དང་ལྡན་པའི་སོས་ཀའི་ཟླ་བ་ཐ་མ་ལ་ཆར་བབས་ཟླཐ་མལ་སླར་བབས་ཧ་པ་ནི་ཨ་ལངྐ་དྲུག་ཅུའི་ཆར་ནུབ་བཅུར་འབབ་ཅིང་པ་ཝ་སངས་སྔོན་དུ་གནས་པ་ནི་ཆར་རྒྱུན་ཆད་མེད་ཅིང་མཚན་མོ་ཆར་འབབ་པར་ཤེས་པར་བྱ་སྟེ་དགུན་དང་དཔྱིད་ཀྱི་བར་གསུམ་བཟུང་བར་གྱུར་པ་ནི་མའི་སྟོབས་ཞེས་བྱ་བར་འགྱུར་ཏེ་སྨིན་དྲུག་གི་ཡིན་པར་བསྟན་ཏོ།",
    "ཞེས་སོགས་རྒྱས་པར་བསྟན་མོད་ཀྱང་ཁོ་བོས་ནི་དེ་དག་མ་བྲིས་སོ།",
    "གྲོ་བཞིན་ནམ་གྲུ་མོན་གྲེ་དང་།",
    "བྱང་ནས་གསུམ་ནི་མོན་གྲུ་ཁྲུམས་སྟོད་ཐ་སྐར་ཡིན་པར་རིགས་སོ།",
    "རྒྱུ་སྐར་སྔོན་དུ་འགྲོ་ཞིང་ཟླ་བ་ཕྱི་ནས་འགྲོ་བ་ནི་ཁྱུ་མཆོག་གི་འཇུག་པ་ཞེས་བྱའོ།",
    "གང་གི་ཚེ་ཟླ་བ་དང་རྒྱུ་སྐར་གཉིས་ལྷན་ཅིག་ཏུ་འཇུག་པ་དེ་ལྟ་བུ་ནི་འདིར་ཟུང་དུ་འཇུག་པ་ཞེས་བྱའོ།",
    "མེ་བཞིན་འཇུག་གི་སྲིང་མོའི་བུ།",
    "ཁ་ཟས་མོན་སྲན་ཚོད་མ་སྟེ།",
    "ཆུ་སྟོད་ཐ་སྐར་མོན་གྲུ་མཆུ།",
    "ལག་ནག་པ་མོན་གྲེ་དང་།"
