    "འཇམ་ཞིང་མཐོ་བའི་སྟན་འདུག་ལ།",
    "དེ་ཁོ་ནའི་འོད་ཟེར་དགག་པ་དང་གཏོད་པ་དང་གཉིས་ཀ་མ་ཡིན་པ་རྒྱུན་འབབ་ཆུ་བོ་བཞིན་དུ་གནས་པཉིད་ཀྱི་ཕྱིར་འོད་ཟེར་༢བྲོ་བ་མང་པོ་འདུག་པ་སྟེ་གསལ་བ་ནི་ཟླ་བས།",
    "གཞན་གྱི་ཆུ་དང་གླེང་བ་ནི་སྤྱན་སྔར་འདུག་ནས་བརྗོད་པ།",
    "དེས་གང་དགག་པ་རྒྱན་རྣམས་རྫོགས་ཤིང་སེར་ལ་འགྱིང་བག་ཏུ་འདུག་པ་རལ་གྲིའི་དབུ་རྒྱན་ཅན་དགུག་པའཚོགས་སོ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་གྲུབ་པར་རིམ་གྱིས་བསྟན་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ཕྲག་དོག་ཀྱང་རང་བཞིན་མེད་ངོ།",
    "རང་རང་ངག་ནས་གནས་ཕྱིར་རོ།",
    "དང་བནི་ཤེལ་ལྟ་བུར་འདུག་ཅིང་འོད་གསལ་བའོ།",
    "དབུས་སུ་གནས་པའི་རྣལ་འབྱོར་པ་དེའི་དཀྱིལ་དུ་འདུག་པའོ།",
    "མམས་དཔའི་སྐྱིལ་ཀྲུང་བཅས་ནས་མིསྒྲུབ་སྣོད་དེའི་སྟེང་དུ་བཞག་ཅེས་པ་ནི་སྒྲུབ་པ་ཆེན་པོ་བྱེད་པའི་འདུག་ཐབས་བཙུནཏེ།",
    "འབར་བོའི་དབུ་ནི་གྱེན་དུ་བཅིངས་པ་དབུ་སྤསེར་སྐྱར་འདུག་ར་བརཞིང་གྱེན་དུ་འཁྱིལ་པས་ཐོར་ཅོག་དུ་འདུག་པའོ།",
    "གཡས་བརྐྱང་འགྱིང་བའི་ཆོལ་དུ་གནས་པ་ནེ་འདུག་སྟངས་སོ།",
    "ཞེས་པ་ནི་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་འདུག་པ་བསྟར་ཏེ།",
    "སླར་ཡང་རངག་ཞིང་དུ་འགྲོ་བར་འགྱུར་རོ་ཞེས་སོ།",
    "ཁ་དོག་དམར་པོ་ལ་སོགས་པ་ནི་གོ་སླའོ་ཡིག་འབྲུའི་ཚོད་ཙ་ན་ཀའི་ཚོད་ཙམ་གྱི་ཐིག་ལེའི་དབུས་སུ་གནས་པ་ལས།",
    "བསྐུར་ཞིང་རང་རང་ལྷ་ཁྲིད་སྤེལ་ ཡང་དྲིལ་སྒྲུབ་ཐབས་ཐུགས་སྒྲུབ་སྦྱིན།",
    "རང་རང་ལས་ཚོགས་ལུང་དང་སྤེལ་ དེ་རྗེས་ཁྲོ་བོ་རིགས་བསྡུས་ཀྱི།",
    "ཕྱིས་སྲད་རྒྱུད་དུ་ཕེབས་སྐབས་དེ་ཁོ་ན་བཞིན་དུ་འདུག་གསུངས།",
    "ཁྱད་པར་དུ་སྒྲ་ལ་ཆེར་མ་སྦྱངས་ཀྱང་རང་ཤུགས་ཀྱིས་ཤེས་པ་ཞིག་ཡོད་ཅེས་ཞལ་ནས་གསུངས།",
    "བདག་གཟུགས་པོ་བདེ་ཞིང་ཁྱེད་རང་ལ་སྐལ་བ་ཡོད་ན་གང་ཡོད་སྟེར་གསུངས་ནས་ཐུགས་དགྱེས་པའི་ཞལ་བཞེས་མཛད་དེ།",
    "དེ་སྐབས་ཕལ་ཆེར་འདུལ་མཛོད་ཀྱི་གསུང་འཕྲོས་ཁོ་ན་མཛད་པར་འདུག་ཅེས་ཐོས་ཏེ་ཤིན་ཏུ་དད་པར་བྱ་བའི་གནས་སོ།",
    "འོན་ཀྱང་རང་བློས་ནུས་བཞིན་བརྗོད་པ་ཡིན།",
    "མ་ནུབ་པ་རྣམས་ཀྱང་ཚུལ་བཞིན་དུ་འཆད་ཤེས་པ་ཡང་དཀོན་པའི་དུས་འདིར་སྔོན་གྱི་མཁས་པ་དེ་དག་རང་རང་དང་དངོས་སུ་མཇལ་ན་ཡང་དེ་ལས་ལྷག་པ་གསུངས་གསུང་",
    "སྟན་ལ་མ་བརྟག་པར་སྡོད་པ་སོགས་འདུག་པའི་ཉེས་པ་དང་།",
    "བྱང་སེམས་སོ་སྐྱེས་ཀྱིས་གཞན་དོན་བྱས་པ་ནི་བུམ་པ་གང་བྱོ་དང་འདྲ་སྟེ་གཞན་གང་ཙ་ན་རང་ཉིད་སྟོང་བར་འགྲོ།",
    "དེ་ཡང་རང་དོན་གྱི་འཁྲི་བ་ཅུང་ཟད་ཀྱང་མ་ཞུགས་པའི་ཚུལ་བཀའ་མི་འགྱུར་བའི་བདེན་པས་ཞལ་གྱིས་བཞེས་པ་ཡིན་ཏེ།",
    "བཀྲ་ཤིས་དགེ་མཚན་མཐའ་དག་དུས་གཅིག་ཏུ།",
    "འགའ་ཞིག་དུས་བབས་ཀྱི་བར་དུ་སྦེད་དགོས་སོགས་ཀྱིས་ཁྲོམ་བསྒྲགས་མ་བྱས་པ་ཡིན།",
    "འདི་བཀྲ་ཤིས་བཀོད་པ་ཡིན་འདུག་གསུངས་པས་དོན་གྱིས་བཀྲ་ཤིས་འཁྱིལ་ཡང་ལུང་བསྟན།",
    "དེ་ནས་མཛོད་དགེ་སྐུ་སྐྱེས་ཀྱིས་གསུང་ལྟར་རི་སོ་སོའི་ངོས་ནས་དཔྱད་པ་ཞིབ་ཏུ་བྱས་ཏེ་སླར་སྐུ་མདུན་དུ་འོངས་ནས་རྒྱབ་རི་འདི་གླང་ཆེན་ཉལ་བ་ལ་ཡིད་བཞིན་གྱི་ནོར་བུ་བཀལ་བ་ལྟ་བུའི་རི་བྱིན་ཆགས་པ་ཞིག་འདུག་ཅེས་སོགས་ས་དཔྱད་ཞིབ་ཏུ་ཞུས་པར།",
    "འདི་ཡང་གསུང་རང་ག་བ་མ་ཡིན་ཏེ།",
    "སྐུ་མཚམས་གྲོལ་ནས་གནས་འདིའི་གཞི་བདག་ཐམས་ཅད་དཀར་ཕྱོགས་པར་སྣང་བས་དགའ་བཞིན་དུ་ངེད་ལ་གནས་སྟེར་བར་འདུག་སྔོན་ཆད་སུ་ལ་ཡང་མ་བྱིན་པར་སྲུང་བསྡད་པ་འདྲ་གསུངས།",
    "ཀ་དག་ལྷུན་གྲུབ་ཀྱི་ཀུན་བཟང་རང་ཞལ།",
    "དེ་དུས་རྒ་ལོ་རྣམ་རྒྱལ་ཆུ་ཕག་ལ་འཁྲུངས་ནས་ལོ་ཉེར་དྲུག་པ་ཡིན་འདུག་པས་སོ།",
    "སེར་བ་ཕབས་པས་སེར་སྲུང་ནུས་ལྡན་གྱི་ཐུན་ཕོག་པ་ཡིན་ཞེས་ལུས་རྗེན་པར་བསྟན་ཚེ་ཤ་རུས་པགས་གསུམ་ཡུངས་ཀར་གྱིས་གཏམས་ནས་འདུག་པར་ཁྱུང་ལྔ་དང་དངུལ་ཆུས་ནང་ནས་ཕུལ།",
    "གསེར་གཡུ་རྣམས་ཁང་ཐོག་ཏུ་བཀྲམ་ནས་བསྐམས་པ་ཕྱུགས་རྫི་སོགས་ཀྱིས་མཐོང་ནས་གཡུའི་ཐོག་འདུག་གོ་བྱས་པས་གཡུ་ཐོག་པར་གྲགས།",
    "རྒྱ་བལ་གྱི་མཚམས་རི་ཀུན་ཏུ་རྒྱུ་ཞེས་བྱ་བར་བེ་རོ་ཙ་ན་དང་མཇལ།",
    "འདིར་མཚན་ཉིད་གྲྭ་ཚང་ཁོ་ན་འགྲིམ་པས་ཀྱང་རང་བློས་འཆུན་ན་སྔགས་ཀྱི་ཕྱག་ལེན་དང་།",
    "ཐ་ན་ཇ་མཆོད་ཚུན་ཆད་ཀྱང་རང་ལུས་ལྷ་སྐུའི་ངོ་བོ་ཉིད།",
    "དེ་བཞིན་དུ་ས་རྡོ་རི་བྲག་གང་ལ་ཡང་རང་མིང་དེ་མི་འབྱར་བ་ཞིག་ཡོད།",
    "མི་འདུག་གསུངས།",
    "རྩ་ཤེའི་ཊཱིཀ་ཆེན་དུ་ལུང་དེ་ལན་མང་པོ་འདྲེན་པར་མཛད་འདུག་ཅེས་གསུངས་པར་སྐྱབས་མགོན་རྡོ་རྗེ་འཆང་ནས་གསུངས།",
    "བྱས་འདུག་ཅིང་ལུས་ངག་ཡིད་གསུམ་འཕྲུལ་སྐྱེན་པའི་ངོ་མཚར་གྱི་གཏམ་མང་དུ་སྣང་།",
    "ཐུགས་འཛིན་དང་འཛིན་རྒྱ་གྲྭ་ཐོག་དེ་ན་རྗེ་འདི་དང་མཉམ་པ་མེད་པར་གྲགས་པ་དོན་ལ་ཡང་གནས་པ་ཡིན་འདུག་སྟེ།",
    "ཙ་ན་ཀ་རྒྱལ་པོའི་ལུགས་ཀྱི་བསྟན་བཅོས་ལས།",
    "བྱེད་ན་དེའི་གྲབས་ནས་མི་འདུག་དེ་མིན་པའི་གྲོས་གང་བྱེད་ཀྱང་གྲོས་གྲབས་གཅིག་ཡིན་གསུངས་ནས་ཧར་གྱིས་བཞེངས་ཏེ་ཕེབས་ཡོང་བར་ཟིལ་སྟོན་པར་སུས་ཀྱང་རྔོ་མ་ཐོགས་སྣང་སྟེ།",
    "གཅིག་ཁྱི་སྨྱོན་ཞིག་དང་ཐུག་སྟེ་ཁོ་རང་དང་ཁྱི་སྨྱོན་གཉིས་ཕན་ཚུན་ཁྱི་འཛིང་བལྟར་བྱས་གཉིས་ཀ་ཆེར་མ་འགྱངས་པར་ཤི་བས་དཔོན་སློབ་ཐམས་ཅད་མི་མཐུན་པའི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བར་གྱུར་ཏོ།",
    "དེ་སྐབས་མཆོག་དམན་ཚང་མས་ཀུན་མཁྱེན་ཆེན་པོའི་གསུང་དང་དུ་བླངས་ན་ལེགས་ཚོགས་ཆེ་བར་ཡོང་རིགས་སུ་འདུག་ཀྱང་།",
    "འདོག་ས་མི་འདུག་ཞུས་པས།",
    "ཧ་ཅང་རང་བཞིན་དྲང་བོའི་གཏམ།",
    "དེ་བཞིན་བྱས་པས་ཐུགས་མཉེས་ཏེ་བཟང་བཟང་ཡོང་བ་འདུག་གསུངས།",
