    "རོ་རྗེ་ཧཱུྃ་གི་ཕྱག་རྒྱ་སྟེ།",
    "ཇོ་རྗེ་ཧཱུྃ་གི་ཕྱག་རྒྱ་ཆེ།",
    "༥༢ པ་སྒྲུབ་པ་བརྗོད་ན་གཡོན་པའི་རྡོ་རྗེ་ཐུའུར་བཅུས་ལ་འཛི་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་མཛུབ་མོ་གཡས་པ་སྡིགས་མཛུབ་ཀྱི་ཚུལ་དུ་བྱས་པ་བཅུ་སྟེ།",
    "རྡོ་རྗེ་ཕྲ་མོ་དགོད་པ་སྔར་འགྲོ་བའི་རྡོ་རྗེ་ཧཱུཾ་མཛོད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་སྔར་ཡང་བསྐོས་པ་དང་།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་དཾ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་པའེ་ངམ་ཚིག་གི་ཕྱུ་རྒྱུ་བཅིངས་པ།",
    "པོད་༢༦༥རྗེ་བཙུན་ས་སྐྱ་པའི་ཐུན་མོང་མ་ཡིན་པའི་སྲུང་མ་དཀར་བདུད་ལྕམ་དྲལ་ཕུར་སྲུང་དང་བཅས་པ་ལ་བསྟོད་པ། ། རྗེ་བཙུན་ས་སྐྱ་པའི་ཐུན་མོང་མ་ཡིན་པའི་སྲུང་མ་དཀར་བདུད་ལྕམ་དྲལ་ཕུར་སྲུང་དང་བཅས་པ་ལ་བསྟོད་པ་དཔལ་འབར་ལྷའི་རྔ་སྒྲ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "གོང་མའི་ཕྱག་ལེན་ལ་དཀར་མོའི་བསྐང་བ་རྒྱས་བསྡུས་ཀྱི་བསྟོད་པར་གཞན་ཡང་མ་འབྲིང་གུང་འཇུག་པར་མཛད་འདུག་པའི་ཕྱིར་རོ།",
    "སྣང་སྲིད་མ་མོའི་བདག་མོ་ནི།",
    "དུས་གསུམ་གཟིགས་པའི་སྤྱན་གསུམ་གཡོ།",
    "སྤྲུལ་པའི་མ་མོ་ལས་ལ་འགྱེད།",
    "ཁྱོད་ནི་སྲིད་པའི་མ་མོ་སྟེ།",
    "རེས་འགའ་སྟོང་ཁམས་ཁྱབ་པར་སྤྲུལ།",
    "རེས་འགའ་སྐུ་གཅིག་མ་ལ་བསྟོད།",
    "ཡེ་ཤེས་དབྱིངས་ཀྱི་རྗེ་མོ་སྟེ།",
    "མཁའ་འགྲོ་གྲངས་མེད་གཙོ་མོ་སྟེ།",
    "རྡོ་རྗེ་རེ་མ་ཏི་ལ་བསྟོད།",
    "ཀུན་རྫོབ་འཇིག་རྟེན་ཀླུ་མོ་དཀར།",
    "ཀླུ་ཆེན་བརྒྱད་ཀྱི་ལྕམ་མོ་སྟེ།",
    "གདུལ་བྱ་འདུལ་ཕྱིར་མ་མོའི་གཟུགས།",
    "འཁོན་རོག་ཡབ་མེས་སྲུང་མ་ཁྱོད།",
    "འཁོན་རིགས་བདག་གིས་བསྟོད་པའི་མཐུས།",
    "བདག་གི་ཚེ་སོགས་ལེགས་ཚོགས་སྤེལ།",
    "ཅེས་རྗེ་བཙུན་ས་སྐྱ་པའི་བཀའ་སྲུང་དཀར་བདུད་ལྕམ་དྲལ་ཕུར་སྲུང་དང་བཅས་པ་ལ་བསྟོད་པ་དཔལ་འབར་ལྷའི་རྔ་སྒྲ་ལས་ཐིག་ལེ་གསང་བའི་ཡུམ་ལ་བསྟོད་པ་རབ་སྙན་མ་མོའི་འགྱིང་གླུ་ཞེས་བྱ་བའི་ལེའུ་སྟེ་དང་པོའོ།",
    "རབ་དྲག་གསུང་གི་གསང་བ་ས་གསུམ་གཡོ།",
    "ཁམས་གསུམ་སྲོག་གི་བདག་པོ་ཁྱོད་ལ་བསྟོད།",
    "ཉམས་པའི་ཁྲག་འཐུང་ནག་པོ་ཁྱོད་ལ་བསྟོད།",
    "མཐུ་ཆེན་བདུད་འདུལ་སྟོབས་ལྡན་ཁྱོད་ལ་བསྟོད།",
    "ཕ་རོལ་ཕྱིན་བཅུའི་མངའ་བདག་ཁྱོད་ལ་བསྟོད།",
    "ཁྲག་ཞག་ཐིག་ལེ་ཐལ་ཆེན་ཚོམ་བུས་སྤྲས།",
    "སྒྲུབ་མཆོག་རྣལ་འབྱོར་དྲག་ལྷ་ཁྱོད་ལ་བསྟོད།",
    "རིག་འཛིན་ཡོངས་ཀྱི་སྲུང་མ་ཁྱོད་མ་བསྟོད།",
    "སྣང་སྲིད་དྲེགས་པའི་དེད་དཔོན་ཁྱོད་ལ་བསྟོད།",
    "ནག་ཕྱོགས་ལྷ་མིན་གཡུལ་བཟློག་ཁྱོད་ལ་བསྟོད།",
    "ཁྱོད་ནི་བདུད་དུ་སྤྲུལ་ཡང་ལྷ་ཡི་རྗེ།",
    "རེས་འགའ་ཙནྡན་བེང་ཆེན་ཀླད་ལ་འཕྱར།",
    "ལྷ་དམག་དཀར་པོའི་དབུགས་འབྱིན་ཁྱོད་ལ་བསྟོད།",
    "ཁྱོད་ནི་མནའ་ཟན་ཀུན་གྱི་གཤེད་མ་སྟེ།",
    "བདུད་མགོན་སྤུ་གྲི་ནག་པོ་ཁྱོད་ལ་བསྟོད།",
    "ཁྲོ་རྒྱལ་རྡོ་རྗེ་དུར་ཁྲོད་ཁྱོད་ལ་བསྟོད།",
    "དམ་ཅན་རྡོ་རྗེ་ཐོད་ཕྲེང་ཁྱོད་ལ་བསྟོད།",
    "ངོ་མཚར་ཆུ་ཟླའི་རོལ་རྩེད་ཁྱོད་ལ་བསྟོད།",
    "དཔལ་ཆེན་རྣལ་འབྱོར་བདག་གིས་བསྟོད་པའི་མཐུས།",
    "དུས་གསུམ་རྒྱལ་བའི་བསྟན་བསྲུང་ནག་པོ་ཁྱོད།",
    "ཞེས་གསུངས་པའི་ཕྱིར། ་དུས་དགྲ་ཁྱོད་ཀྱི་ཞལ་དུ་ཀུ་ཊ་ཡཾ།",
    "ནམ་གྲུ་ནག་མོ་རེ་མ་ཊི།",
    "བསྟན་སྲུང་སེར་ནག་རེ་མ་ཊ།",
    "ཤ་བ་ཡུ་མོ་ཆིབས་ལ་བསྟོད།",
    "ཁྲག་འཐུང་དམར་ནག་རེ་མ་ཛ།",
    "སེར་ཁྲ། ་རེ་ལྡེ་རུས་རྒྱན་རལ་པ་འཕྱང་།",
    "དམ་ཅན་ལྗང་ནག་རེ་མ་ཛུ།",
    "རྔ་མོང་གྭ་པ་ཆིབས་ལ་བསྟོད།",
    "སྲིད་མཐར་འཕེལ་ཞིང་བདག་ཅག་གི།",
    "འདིའི་ཤློ་ཀ་གཅིག་ལ་ཤྭ་ཐུང་གི་དབྱངས་རོལ། ་བྷྱོ་ཟངས་ཀྱི་མི་མོ་ཝ་གདོང་དམར།",
    "གཅེར་མོ་རྡོ་རྗེ་ཕུར་པ་འཛིན།",
    "ཟངས། ་། ཝ་མོ་རྐང་གསུམ་ཆིབས་ལ་བསྟོད།",
    "གསེར་གྱི་མི་མོ་འཕར་གདོང་སེར།",
    "གཅེར་མོ་ལྕགས་ཀྱུ་ཕུར་པ་འཛིན།",
    "ལྕགས་ཀྱི་མི་མོ་སྤྱང་གདོང་སྔོ།",
    "གཅེར་མོ་ཐོད་དབྱུག་ཕུར་པ་འཛིན།",
    "གཡུ་ཡི་མི་མོ་ཁྱི་གདོང་མཐིང་།",
    "གཅེར་མོ་གཞིང་་བྱིས་རོ་ཆུང་ཕུར་བུ་འཛིན།",
    "སྲིད་མཐར་འཕེལ་ཞིང་བདག་ཅག་གི།",
    "བྷྱོ་་འདིའི་ཤློ་ཀ་གཅིག་ལ་གཞན་ཡང་མ་ཐུང་བ་དཔལ་ཐུང་གི་དབྱངས་རོལ།",
    "བདུད་ལྕམ་སྤྱི་བྱིན་གཅེར་མོ་ནག།",
    "ཀུ་ལནྡྷ་རི་་གསང་མཚན་ཁྱོད་ལ་བསྟོད།",
    "གཟའ་ལྕམ་ཡ་བྱིན་གཅེར་མོ་སེར།",
    "ཤུ་ལནྡྷ་རི་་གསང་མཚན་ཁྱོད་ལ་བསྟོད།",
    "བཙན་ལྕམ་བསེ་བྱིན་གཅེར་མོ་དམར།",
    "ཙ་མུནྡྷ་རི་་གསང་མཚན་ཁྱོད་ལ་བསྟོད།",
    "ཀླུ་ལྕམ་ཕག་བྱིན་གཅེར་མོ་ལྗང་།",
    "ཀམ་ཀ་དྷ་རི་ཁྱོད་ལ་བསྟོད། ་གསང་མཚན།",
    "བསེ་མོ་མཆེད་བཞི་བསྟོད་པའི་མཐུས།",
    "སྲིད་མཐར་འཕེལ་ཞིང་བདག་ཅག་གི།",
    "བོད་གངས་ཅན་སྐྱིད་སྡུག་ཨེ་མ་གཟིགས།",
    "ཞེ་དྲག་པོའི་ཚིག་གིས་བསྟན་སྐྱོང་གཤེ།",
    "ཐུགས་དགྱེས་པའི་གཏམ་་ལོ་ཆེན་གྱིས་མགོན་པོ་ལ་སྲིན་གཟུགས་མ་འཁྱེར་བས་ཞལ་གཟིགས་པ་དང་།",
    "འཇམ་མགོན་ཨ་མེས་ཞབས་ཀྱིས་པུ་ཊའི་བསྟོད་བསྐུལ་བདུད་དཔུང་ཀུན་འཇོམས་མ་མཛད་པས་པུ་ཏྲ་ཉིད་བན་གཟུགས་ཀྱི་ཚུལ་དུ་ཞལ་གཟིགས་པ་སོགས་མང་།",
    "རྩོམ་འདོད་སོགས་བདུད་དུ་གསུངས་མོད་ཀྱང་།",
    "ཁྱོད་བར་ཆད་ནམ་མཁའི་དབྱིངས་སུ་ཕཊ།",
    "སྟོང་ཁུན་གོང་མ་ཆེན་པོའི་ཁབ་ཏུ་གིན་གུ་ཅེས་གྲགས་ལ།",
    "བོད་རིགས་གསར་བརྗེ་པ་དང་ཚན་ཉིད་རིག་པ་བ་ཞིག་གི་ཚན་རིག་འཆར་སྣང་།",
    "གཅིག་པུར་ཁེར་རྐྱང་གི་འཚོ་བ་སྐྱེལ་དགོས་བྱུང་བ་རེད།",
    "རྩོད་སྒྲུབ་རིག་པའི་གཞུང་ལུགས་ཀྱི་མ་ལག་ལ་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་བློ་བཀོད་ཅིག་ཆགས་ཡོད་པ་རེད།",
    "རྩོམ་པ་པོས་རང་རྒྱལ་ཐུབ་པའི་བློ་རིག་གི་བརྟགས་པ་དང་།",
    "ཟླ་བའི་གོ་ལ་དང་བཅས་པའི་སྐར་མའི་གོ་ལ་རྣམས་ཀྱི་ཐོག་ཏུ་སླ་གཟུགས་རྩད་གཅོད་བྱེད་པའི་མཚན་ཉིད་རིག་པའི་ཚན་རིག་གི་བསྟན་བཅོས་འདི་ནི།",
    "མཁས་པ་ཆེན་པོ་ཨོ་རོ་མོན་ཅེ་ལེ་ཧྥུ་ཡི་གྲུབ་རྫས་འཁོར་ཚད་རེའུ་མིག་དང་ཡང་ཨུ་རུ་སུ་གནས་ཚུལ་ཧ་ཅང་འདྲ་པོ་རེད་ཅེས་པ་ལྟར་རེད།",
    "གཞུང་ལུགས་ཀྱི་རྒྱབ་རྟེན་ཞིག་མཁོ་འདོན་བྱས་ཡོད་པ་རེད།",
    "འདི་ཡིས་མཚན་ཉིད་རིག་པའི་ཚན་རིག་གི་ཐད་ལ་ཉམས་ཞིབ་དོན་ལྡན་དང་།",
    "ཐད་ལ་ཕན་ནུས་དང་རིན་ཐང་ཆེན་པོ་ཡོད་པ་ནི་ཐེ་ཚོམ་མེད་པ་ཞིག་རེད།",
    "སླར་ཡང་བརྗོད་པ་རྩོམ་པ་པོས་ལོ་ངོ་ཉི་ཤུའི་སྔོན་ལ་རྩོམ་གཞི་འདི་ཉིད་ང་ཚོའི་གཏིང་ཡོད་པ་དང་།",
    "རྩོམ་སྒྲིག་ཁང་གིས་རྩོམ་སྒྲིག་གི་ལས་སྣོན་ཆ་ཚང་གྲུབ་སྟེ་པར་རྒྱག་གྲབས་བྱེད་པའི་ལོའི་ཟླ་བ་སྐབས་སུ།",
    "ལྷག་དེར་བརྟེན་པར་དུ་ང་ཚོས་མཚན་ཉིད་རིག་པའི་མཚར་ཉམས་དེ་མཐོང་བྱུང་།",
    "ཉིད་མཐོང་བའི་རྗེས་སུ་བློ་བདེ་ཞིང་ཡིད་སྤྲོ་བའི་ཉམས་འགྱུར་སྐྱེ་བར་ང་ཚོར་ཡིད་ཆེས་ཡོད།",
    "སྐྱེ་ལྡན་མེད་པ་ཞིག་རེད།",
    "ད་ལྟ་ཨ་མེ་རི་ཀའི་བར་སྣང་བསྐོར་བསྐྱོད་ཁང་གི་ཚན་རིག་པ་རྣམས་ཀྱིས་ཟླ་བའི་གོ་ལའི་ཐོག་ཏུ་འཁྱགས་ཏུན་དུང་ཕྱུར་ཁ་ཤས་སྤུངས་ཡོད་པར་མཐོང་འདུག་འདི་ལྟར་ན་ཟླ་བའི་ཐོག་ཏུ་ཕལ་ཆེར་མི་འཚོ་གནས་བྱེད་ཐུབ་ས་རེད།",
    "མཁས་པ་ལྗམ་པོ་ལོན་ཏེན་པོས་ཟླ་བའི་ཐོག་གི་འཁྱགས་དེ་བཞུ་ནས་འཐུང་ཆུ་བྱེད་ཆོག་ལ།",
    "འདི་སླ་གཟུགས་ཀྱི་ཨོ་རྫས་བཟོས་ནས་མཁའ་དབྱིངས་བསྐོར་གྲུ་བཏང་རྫས་བྱེད་ཆོག་གི་རེད་ཅེས་གསུངས་སོ།",
    "ཟླ་བའི་གོ་ལའི་འཚོལ་ཞིབ་ཚོད་ལེན་འཕྲུལ་ཆས་ཏེ་རྟགས་ཅན་ཁེ་ལེ་མོན་ཐན་ཟླ་བ་གཉིས་པ་ནས་བཟུང་བར་སྣང་ཁམས་སུ་བསྐོར་བསྐྱོད་བྱེད་ཅིང་ཡོད་པ་ཅེས་པ་དེས་ཟླ་བའི་གོ་ལའི་ལྷོ་མཐའ་ན་འཁྱགས་རིམ་ཡོད་པར་མཐོང་སྟེ་ཨ་མེ་རི་ཀའི་བར་སྣང་བསྐོར་བསྐྱོད་ལྟེ་གནས་ལ་འཕྲུལ་ཆས་ལེ་ཏ་ནས་བརྡ་བཏང་བ་རེད།",
    "ཁེ་ལེ་མོན་ཐན་ཅེས་པ་སྤྱི་ལོ་ལོར་ཨ་པོ་ལོ་རྟགས་ཅན་གྱི་འཇིག་རྟེན་བསྐོར་སྐྱོད་པ་ཟླ་བའི་ཐོག་ཏུ་འཛེགས་པ་ནས་བཟུང་།",
    "ཐེངས་དང་པོར་ཟླ་བ་ལ་ལྟ་སྐོར་འགྲོ་མཁན་ཞིག་རེད།",
    "དེང་དུས་ཚན་རིག་ལག་རྩལ་ཀྱི་རིག་གཞུང་དང་ལྟ་བ་མ་འདྲེས་པར་རང་རྐྱ་ཐུབ་པ་ཞིག་སྲུང་སྐྱོབ་བྱེད་རྒྱུ་དེ་ལ་ངོས་འཛིན་བྱེད་ཅིང་འདུག་དེ་ནི་ལྷག་བསམ་རྣམ་དག་ཅན་གྱི་རང་གི་རིགས་དང་རིག་གཞུང་ལ་ཤ་ཞེན་ཅན་གྱི་བསམ་བློ་ཞིག་ཡིན་ཀྱང་།",
    "མ་འོངས་འབྱུང་འགྱུར་གྱི་དོན་ལ་གཟིགས་ཐག་ཐུང་བའི་ཕྱོགས་རེ་བའི་ལྟ་བ་ཞིག་ཡིན་སྟབས།",
    "མི་རིང་བའི་འབྱུང་འགྱུར་གྱི་དུས་ན་རང་གི་མི་རིགས་འདི་ཉིད་རང་ཤུགས་ཀྱིས་རྒྱ་མཚོའི་ནང་དུ་ཁབ་ཟག་པ་ལྟ་བུ་གར་སོང་ཆ་མེད་དུ་འགྱུར་བར་བྱེད་པའི་རྫས་ངན་ལྟ་བུའི་བསམ་བློ་ཞིག་ཡིན་པའི་ཕྱིར་ན།",
    "ཡར་རྒྱས་གཏོང་ཟེར་བ་དེ་སྔར་ཡོད་ཀྱི་དངོས་པོ་དེ་དག་མི་ཉམས་སྲུང་སྐྱོབ་བྱེད་རྒྱུའི་གཞིར་བཞག་གི་ཐོག་ཏུ།",
    "རང་ལ་འཚོ་བའི་རྟེན་དུ་སྒོར་མོ་ཅུང་ཟད་རེ་ཐོབ་པའི་ཕན་པ་ལས།",
    "སླ་གཟུགས་ཚ་མོ་དང་།",
    "གཞན་ཡང་དེང་དུས་གཞོན་ནུ་མི་ཉུང་བ་ཞིག་གིས་བྱ་བ་གང་ཞིག་སྒྲུབ་པ་ལ་ཆ་རྐྱེན་ངེས་གཏན་ཞིག་མེད་ན་མི་འགྲུབ་པར་སེམས་ཏེ།",
    "ལས་དོན་ལ་དཀའ་ངལ་ཅུང་ཟད་འཕྲད་པའི་སྐབས་སུ་ལེ་ལོ་དང་སྒྱིད་ལུག་གི་གནས་སུ་ལྷུང་སྟེ་ནག་ཆང་བག་གསུམ་ཁོ་ན་ལ་གཡེངས་ནས་དུས་འདའ་བ་ལས།",
    "འདི་ལྟ་བུའི་རང་བྱུང་ཚན་རིག་གི་གནས་ལུགས་བརྗོད་པའི་བསྟན་བཅོས་ཤིག་བརྩམས་ནུས་ན།",
    "རང་རེ་རྣམས་ལ་དེ་ལས་ལྡོག་པའི་ཆ་རྐྱེན་བཟང་པོ་ཡོད་པ་ན་བསྒྲུབ་འོས་ཀྱི་བྱ་བ་རྣམས་མི་འགྲུབ་པ་གང་ཡོད་སྙམས་པའི་སྐུལ་སློང་གིས་བྱ་བའི་ལས་ལ་འཇུག་པའི་རེ་བ་དང་གསུམ་ནི་དེབ་འདི་བསྒྱུར་བའི་དམིགས་ཡུལ་གཙོ་བོ་ཡིན།",
    "རྫས་འགྱུར་གྱི་ཐ་སྙད་ཁག་གཅིག་སྔར་བོད་ཀྱི་རིག་གཞུང་གི་གོམས་སྲོལ་ནང་དུ་མ་གྲགས་པས་དེ་དག་ཐད་སྒྱུར་མི་བྱེད་ཀ་མེད་བྱུང་སོང་།",
    "རྒྱ་བོད་ཤན་སྦྱར་བྱས་ནས་ཚིག་མཛོད་ནང་དུ་བཀོད་ཟིན་པའི་ཡོངས་གྲགས་ཀྱི་ཐ་སྙད་འགའ་ཞིག་འདིར་མཚན་ཉིད་རིག་པའི་གཞུང་གི་ཆེད་སྤྱོད་ཀྱི་ཐ་སྙད་དུ་བེད་སྤྱོད་བྱེད་སྐབས།",
    "ཆུ་འགོ་གངས་ལ་ཐུག་པའི་དཔེ་ལྟར་འདི་དག་གི་འབྱུང་ཁུངས་ཕལ་ཆེར་དབྱིན་ཡིག་དང་ལ་ཏིང་སོགས་ལས་བྱུང་སྟབས།",
    "བརྗོད་དོན་མི་གསལ་བ་ལ་སོགས་པའི་སྐྱོན་དང་ནོར་འཁྲུལ་མི་ཉུང་བ་ཞིག་ཡོད་པ་ནི་སྨོས་མ་དགོས་པ་རེད།",
    "མཐར་གསོན་པོར་གནས་ཐུབ་པ་ཙམ་བྱུང་སོང་།",
    "ཉེ་དུས་ཀྱི་ཚན་རིག་གི་དཔེ་དེབ་གསར་པ་རྣམས་བལྟ་ཀློག་བྱས་པའི་རྗེས་སུ་རིག་པ་ནར་སོན་ཏེ་བློ་རྩེ་གཅིག་སྒྲིམ་གྱིས་ཞིབ་འཇུག་དང་།",
    "རྩོད་སྒྲུབ་རིག་པར་གསར་ཞིབ་ཅེས་པའི་དེབ་འདི་སྤྱི་ལོ་ལོར་བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་པར་དུ་བསྐྲུན་པ་རེད།",
    "རྒྱལ་ས་པེ་ཅིན་གྱི་མཚན་ཉིད་དང་རིག་གཞུང་གི་ཆེད་རམས་པ་དང་།",
    "ཡིན་ནའང་སྔོན་བྱོན་མཁས་པ་རྣམས་ཀྱིས་གསུངས་པ་ལྟར་མི་རྣམས་ཀྱིས་རང་བྱུང་ཁམས་དེ་ཐད་ཀར་དུ་སྟབས་བདེ་པོ་ཞིག་གིས་ཤེས་ཐུབ་པ་ཞིག་མིན་ལ།",
    "དེ་ནི་དེབ་འདིའི་ནང་གི་གོ་དོན་དང་།",
    "འཇར་མན་གྱི་སྐད་གྲགས་ཅན་གྱི་མཚན་ཉིད་རིག་པའི་ཆེད་རམས་པ་ཧེ་གེར་གྱིས་གཏན་ཚིགས་རིག་པ་ནི་གྲིབ་གཟུགས་ཀྱི་རྒྱལ་ཁམས་ཤིག་རང་རེད་ཅེས་གསུངས་ཡོད་པ་རེད།",
    "རྣམ་པ་འདྲ་པོ་ཞིག་གིས་དཔེ་ཁ་ཤས་བླངས་ནས་མཇུག་རྫོགས་པར་བྱས་ཡོད་པ་རེད།",
    "ཇི་བཞིན་བརྗོད་པ་ཁོ་ན་ཙམ་གྱི་ནང་ནས་ཚན་རིག་གང་ཡང་ཐོན་ཐུབ་ཀྱི་མ་རེད་ཅེས་གསུངས་ཡོད་པ་རེད།",
    "འདི་ནི་མཚན་ཉིད་རིག་པའི་ཁོངས་སུ་གཏོགས་པའི་གོ་དོན་གྱིས་སྤྱི་མཚན་ཅན་གྱི་ཡོངས་གྲགས་ཀྱི་རྩ་གཞུང་དེས་ཐུན་མིན་རང་མཚན་གྱི་ནང་དོན་ཞིག་སྟོན་ཐུབ་ཅིང་ཡོད་པ་སྨོས་མ་དགོས་པ་རེད།",
    "དེ་དང་མཚུངས་པ་ཕྱི་རོལ་ཡུལ་གྱི་འཇིག་རྟེན་ལྟ་ཚུལ་གྱི་ནང་དུ་ཁྱོན་ཡོངས་ལ་ཞིབ་འཇུག་བྱེད་པར་རང་ཤུགས་ཀྱིས་འབྲེལ་བ་ཡོད་པ་དང་།",
    "དུས་གཏན་དུ་འཕེལ་ཞིང་འགྱུར་བ་ཅན་གྱི་མཚན་ཉིད་རིག་པའི་ཚན་རིག་གི་རྩོད་སྒྲུབ་རིག་པ་དེ་ནི།",
    "ཚད་ལྡན་ཚན་རིག་གི་ཚད་གཞི་ཟེར་བ་དེ་ནི།",
    "དེ་དག་གཞུང་གི་སྤྱི་དོན་གྱི་སྤྱི་འགྲོས་དང་།",
    "རྩོད་སྒྲུབ་རིག་པའི་རྩ་གཞུང་གི་འཕེལ་རིམ་དེ་ཡང་དག་ཤོས་ཀྱི་སྤྱི་འགྲོས་དང་།",
    "ལོ་མང་པོའི་རིང་ལ་བསམ་བློ་ཞེ་དྲག་བཏང་སྟེ་གཞི་ནས་གྲུབ་པ་ཞིག་རེད།",
    "དེ་ལྟར་ན་འགོ་འཇུག་གོ་ལྡོག་པ་ཞིག་རེད་ཅེས་ཟེར་ཆོག་འགྲོ་བ་མིའི་རིགས་ཀྱི་བསམ་བློ་གཏོང་སྟངས་ལ་བསམ་གཞིགས་བྱས་ནས་དེར་ཚན་རིག་དང་མཐུན་པའི་དབྱེ་ཞིབ་བྱེད་རྒྱུ་དེ་གང་ལྟར་དོན་དངོས་ཀྱི་འཕེལ་ཕྱོགས་དང་ལྡོག་པའི་བསམ་གཞིགས་བྱེད་སྟངས་འདི་ལྟ་བུ་ནི་དོན་དངོས་དེའི་རྗེས་སུ་འགོ་འཛུགས་ཀྱི་ཡོད།",
    "དེ་ལྟར་ན་གཞི་ནས་ཚན་རིག་ལ་ཞིབ་འཇུག་བྱེད་པའི་སྐབས་སུ་ལྡོག་ཏུ་མེད་པའི་བསམ་བློ་དང་བཟོ་བཀོད་ཀྱི་གོ་རིམ་དེ་དག་ཉུང་དུ་གཏོང་ཆོག་གི་ཡོད་ལ།",
    "རྩོམ་པ་པོའི་ལྟ་བ་དེ་ཀློག་པ་པོ་རྣམས་ཀྱིས་གོ་བདེ་བར་ཡང་ཡོང་གི་ཡོད།",
    "བསམ་ཚུལ་དེ་མངོན་སུམ་དུ་སྣང་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "ད་རུང་བྱ་སླ་དོན་ཆེ་བལྟས་པ་ཙམ་གྱིས་ཤེས་ནུས་པའི་དམིགས་གསལ་གྱི་ནུས་པ་འགའ་ཞིག་ཀྱང་འདོན་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "བསམ་བློའི་བཅིངས་སྒྲོགས་རྣམས་རེ་རེ་བཞིན་གྲོལ་ནས།",
    "ད་རུང་སྔ་མཐུད་ཕྱེ་སྐྱོང་གི་སྒོ་ནས་དེ་དག་གི་ཡོང་ས་འགྲོ་ཁུངས་སྟོན་ཐུབ་ཀྱི་ཡོད།",
    "གཞན་ཡང་ཡུལ་ཡོད་དོ་ཅོག་གི་རྩ་བའི་གྲུབ་ཚུལ་དང་འཕོ་འགྱུར་གྱི་ཁ་ཕྱོགས་སྟོན་བྱེད་ཆེས་བཟང་ཤོས་ཀྱི་ལག་ཆ་ཞིག་ཀྱང་ཡིན།",
    "ཞིབ་འཇུག་གི་བགྲོ་གླེང་།",
    "བདེན་དོན་ཆེ་བ་ཞིག་ཡོང་གི་རེད།",
    "ལིའང་ཟེར་བ་དེ་ནི་བྱ་དངོས་ཁག་གི་ནང་དུ་གཏན་ལ་དབབ་བྱའི་ཕལ་པའི་ཆ་དེ་ལ་ཟེར།",
    "རྟེན་དང་བརྟེན་པའི་འབྲེལ་བའང་གྲུབ་ཡོད་པ་ཞིག་རེད།",
    "དེ་དག་སོ་སོའི་རང་མཚན་གྱི་དོན་མཐོང་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "མཚན་ཉིད་རིག་པའི་གཞུང་གི་དོན་སྤྱིའི་ཁྱབ་ཁོངས་དང་།",
    "བྱེ་བྲག་གི་རིག་གཞུང་ཚན་ཁག་གི་གོ་དོན་དང་དུས་རྒྱུན་འཚོ་བའི་ནང་གི་སྐད་ཆ་དང་གོ་དོན་གཅིག་པ་ཆགས་འགྲོ་བཞིན་ཡོད་པ་རེད།"
  ]
}