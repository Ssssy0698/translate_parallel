    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "འདིར་འཁྲུག་པོ་གང་འདྲ་མི་འདུག་གམ།",
    "དེ་དུས་རྒྱབ་ནས་རྡོག་སྒྲ་ཐྲག་ཐྲག་གྲགས་པས་ཨར་ཅོམ་གྱིས་ཁ་ཕྱིར་འཁོར་ཏེ་བལྟས་ཙ་ན།",
    "ཨ་ཙི་ཙིད་ག་པར་འཚོལ་བར་འགྲོ་དགོས་སམ།",
    "ཁྱེད་རང་ཕྲན་དང་ཉལ་འདོད་མི་འདུག་གམ་ཞེས་དྲིས།",
    "པཱ་ཝེརད་ང་གཉིས་སྲོག་ཤོར་བའི་ཉེན་ཁ་འདུག་མཐར་ཐུག་གནས་ཚུལ་ཇི་ཡོང་དཔོག་པར་དཀའོ་ཞེས་སེམས་ཁྲལ་ཆེ་བའི་ངང་ནས་བརྗོད།",
    "ཁོ་ལ་དོ་དགོང་མེ་ཏོག་ལྡུམ་རྭའི་ནང་ཐུང་མདའ་སྐྱེལ་བར་ཤོག་ཅེས་ལན་སྐྱེལ་རོགས་ཞེས་བརྗོདཏུང་ཉི་ཡས་པཱ་ཝེར་གྱི་མངག་བཅོལ་ལྟར་བྱ་བ་ལེགས་པར་བསྒྲུབས་ནས་ལོག་ཡོང་དུས་ཧ་ཅང་ཕྱི་པོ་ཆགས་འདུག་པཱ་ཝེར་ནི་མལ་དུ་གཉིད་ཧ་ཅང་སྐྱིད་པོ་ཁུག་ཡོད་ཀྱང་།",
    "མེ་འཁོར་གྱི་མགོ་ཞིག་རླངས་པ་འཚུབ་འཚུབ་ཀྱིས་ཁོ་ཚོའི་ཕྱོགས་སུ་དལ་གྱིས་བཏང་ཡོང་བ་དང་ཁ་ལོ་བ་རྒན་པ་པོ་རུ་ཀྲ་ཁེས་མགོ་བོ་མེ་འཁོར་གྱི་སྒེའུ་ཁུང་ནས་བསྲིང་བཞིན་མདུན་ཕྱོགས་སུ་རྒྱང་ལྟ་བྱེད་ཀྱིན་འདུག་ིིཁོ་ཚོ་འཚབ་བེ་འཚུབ་བེར་གྱེས་མཚམས་ཞུས།",
    "མགྱོགས་པོ་ཡར་ལོངས་ཤོག་དགྲ་ལ་རྒོལ་ལན་སྤྲོད་པའི་དུས་ཚོད་སླེབས་འདུག་གཉིད་སྐྱིད་པོ་སང་ཉིན་ཉལ་ཆོག་མགྱོགས་པོ་ལོངས་ཤོག་ཅེས་བསྒོས།",
    "འདི་གའི་ལས་ཀ་ནི་གཡུལ་ས་ལས་ཛ་དྲག་ཆེ་བ་འདུག་ཉེ་ལམ་ཉིན་ཤས་རིང་སུའུ་ཏི་ལིའི་ཇག་ཚོགས་གཙང་བཤེར་བྱེད་པའི་ལས་ཀས་ང་ཤི་མིན་རོ་མིན་བཟོས་བྱུང་།",
    "མེ་འཁོར་འབབ་ཚུགས་ལ་སླེབས་འདུག་པས་ད་འགྲོ་རན་འདུག་ཅེས་སྨྲས་ཏེ་ཁོ་གཉིས་ལྷན་དུ་མེ་འཁོར་སྤ་སེ་འབྲེག་སར་ཆས་སོ།",
    "མི་སྡུག་ཅག་ཁོ་རང་ཡར་འཛུལ་ཡོང་བ་ཙམ་དུ་མ་ཟད།",
    "པཱ་ཝེར་གྱིས་སྒོ་དལ་བུར་ཕྱེ་ནས་བལྟས་ཙ་ན།",
    "ལམ་ལ་འགྲོ་དུས་གནོད་ཀྱི་འདུག་གམ་ཞེས་དྲིས་པར།",
    "གནོད་ཀྱི་མི་འདུག་རྡོ་ཕོག་པའི་ཉིན་དེར་ངས་ཡིད་འཇོག་རྩ་ནས་བྱས་མེདངལ་གསོ་ཆུ་ཚོད་གཉིས་བརྒྱབ་རྗེས་མུ་མཐུད་རྟ་ལ་བཞོན་ནས་གཡུལ་ངོར་བཤར་བ་ཡིན།",
    "ཚི་ཝེ་ཐ་ཡེ་ཧྥུས་ཐ་མག་ཡང་ཡང་འཐེན་བཞིན་པར་དལ་གྱིས་འདུག་པར་བྱེད།",
    "གཞོན་ནུ་མ་ཚོས་སྔར་ནས་ང་ལ་ཁྱེད་ཁྲིད་ཤོག་ཟེར་གྱི་འདུག་སྟེཁྱེད་ཀྱིས་ཆབ་སྲིད་མ་གཏོགས་ཡིད་ལ་མི་འཇོག་པས་གདན་འདྲེན་ཞུ་ལོང་མ་བྱུང་རྩེད་འཇོར་རོལ་ཏེ་སྣང་བ་སྐྱིད་པོ་མི་གཏོང་བ་ཅི་ཡིན།",
    "ཨན་ནཱ་སྐྲག་སྣང་འཇགས་མེད་པར་མལ་ཁྲིར་རྒྱབ་བསྙེས་ཏེ་འདུག་པ་དང་།",
    "ཁ་སང་སོ་ལོ་མན་ཁ་ཆུས་སུ་གྲོགས་པོ་ཁ་ཤས་དང་ཐུག་དུས་ཁོ་ཚོས་སེམས་དཀར་པོ་གངས་རི་མཐོན་པོ་འདྲ།",
    "འོན་ཀྱང་བགྲེས་པོའི་གདོང་རིས་ངན་པ་དེ་མཐོང་ཚེ་སེམས་མི་སྐྱིད་པར་གྱུར་ཅིང་འཆར་གཞི་མང་པོ་བཀོད་ཀྱང་ཚང་མ་ལག་ལེན་དུ་བསྟར་ཐུབ་པ་མི་འདུག་སྙམ།",
    "མིའུ་ཐུང་གེལ་བའི་འདུག་སྟངས་ཀྱིས་རོའི་སྟེང་ན་བཞུགས་པ།",
    "གདོང་བཞིའི་སྤྲུལ་པ་ཕྱོགས་བཅུར་འགྱེད་ཙ་ན།",
    "མཁའ་འགྲོ་མང་པོའི་གཙོ་བོ་མཛད་ཙ་ན།",
    "དམ་ཉམས་དགྲ་བགེགས་རྩད་ནས་གཅོད་ཙ་ན།",
    "རྣལ་འབྱོར་དམ་ལྡན་སྲུང་མ་མཛད་ཙ་ན།",
    "མིའུ་ཐུང་གེལ་བའི་འདུག་སྟངས་ཀྱིས་རོའི་སྟེང་ན་བཞུགས་པ།",
    "འཇིག་དུས་བསྐལ་བའི་མེ་ལྟར་མི་བཟད་པའི།",
    "སྲོག་བདག་དུས་ཀྱི་མེ་དཔུང་དང་མཚུངས་པ།",
    "བེག་ཙེ་ལྕམ་དྲལ་གྱི་བསྐང་གསོ་ཕྲིན་ལས་ལྷུན་གྲུབ་སོགས་རྒྱས་བསྡུས་དུ་མ་འདུག་པ་སོགས་དགོངས་དོན་མ་འཕྱུགས་ཤིང་།",
    "རྒྱལ་བ་སྤྱི་བསྐུལ་འདི་བཀའ་བརྒྱད་ཁྲོ་རོལ་གྱི་ཚིག་ཡིན་པས་གསར་མ་ལ་ཧ་ཅང་འབྲེལ་མི་ཆགས་ཀྱང་དིང་སང་མཛད་སྲོལ་འདུག་པ་དང་།",
    "མིའུ་ཐུང་འགྱིང་བའི་འདུག་སྟངས་ཀྱིས།",
    "གཏང་རག་དུས་སུ་མ་ཐོངས་མཐོལ་ལོ་བཤཊ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ན་སྭ་ཧཱ།",
    "རང་རང་ཡུམ་བཅས་དཔའ་བོ་མཁའ་འགྲོས་བསྐོར།",
    "མཆོད་གཏོར་གཏང་རག་དུས་སུ་ཆགས་པ་བཤགས།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནཱི་སརྦ་ཨརྠ་སཱ་དྷ་ན་སཱ་ཧཱ།",
    "འཇིགས་རུང་རང་འདྲའི་སྤྲུལ་པའི་འཁོར་ཚོགས་དང་།",
    "གོ་རིམ་སོགས་ངེས་ཅན་ཞིག་མི་འདུག་པས།",
    "གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "རང་རང་མཐུན་པའི་རྫས་སུ་བྱིན་བརླབས་ནས།",
    "དམ་ཉམས་དགྲ་བོ་སྟེང་འོག་གར་འདུག་ཀྱང་།",
    "སྟེང་འོག་ཕྱོགས་མཚམས་བར་གསུམ་གར་འདུག་ཀྱང་།",
    "གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "རང་རང་མཁོ་དགུའི་འབྱོར་བ་ཇི་སྙེད་པ།",
    "རང་རང་དགྱེས་པའི་གདན་ལ་བརྟན་པར་བཞུགས།",
    "མེའུ་ཐུང་གེལ་བའི་འདུག་སྟངས་ཀྱི་བཞུགས་པ།",
    "དེང་སང་གསོལ་མཆོད་འདྲ་འདུག་པ་རྣམས་ཁུངས་མེད་ཀྱི་ཡིག་ཧྲུལ་དང་བློས་བྱས་སྣ་ཚོགས་སྣང་བར་ཡིད་བརྟན་དཀའ་ལ།",
    "ཧཱུྃ་རྣམ་སྣང་ཐུགས་ཀློང་རང་བཞིན་གནས་རྣམས་ནས།",
    "ཀུན་ཀྱང་རང་རང་གདན་ལ་བརྟན་པར་བཞུགས།",
    "རང་རང་གནས་གཤེགས་སླར་ཡང་མཆོད་བསྟོད་ཆེད།",
    "རང་རང་དགྱེས་པའི་གདན་ལ་བརྟན་པར་བཞུགས།",
