    "གསུམ་པ་ཐ་། མ་མལ་གཅིག་ཏུ་ཏིང་ངེ་འཛིན་སྐྱེད་པ་ནི་འགྲོ་འདུག་དང་།",
    "དེ་རྣལ་འབྱོར་པས་ལམ་བསྒོམས་སྟོབས་ཀྱིས་བདེ་སྟོང་དབྱེར་མེད་ཀྱི་ཡེ་ཤེས་དངོས་གནས་པའི་ལྷའི་སྐུར་ལྡང་བར་བྱས་པ་ན་སྒྱུ་མ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་དེའི་སྟོབས་ཀྱི་ཆགས་སྡང་ཐམས་ཅད་རང་ཞི་བར་བྱེད་ནུས་པས་སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་ཞེས་གསུངས་སོ།",
    "འདུག་ས་འདི་ཉིད་དུ་བསྒྲལ་དུ་གསོལ།",
    "བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧ།",
    "དེ་འདྲའི་ང་དེ་ཕུང་པོ་རྣམས་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་ན།",
    "གཞན་ཡང་ང་དེ་ཕུང་པོ་རྣམས་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་ན།",
    "བདག་ཕུང་རང་བཞིན་གཅིག་པའི་ཕྱོགས་ལ་ཉེས་པ་དེ་ལྟ་བུ་མཐོང་བའི་ཕྱིར་ན་ཡང་དེ་ལྟར་མ་གྲུབ་བོ་སྙམ་དུ་བསམ་སྟེ།",
    "དེ་ལྟར་དགག་བྱ་བཀག་ཤུལ་ན་ལྷག་མར་ལུས་པ་ཅི་འདུག་བལྟས་པས་ད་དུང་ངའི་མིང་ཙམ་ཞིག་སྣང་བ་ཙམ་མ་ཁེགས་པར་ཡོད་པ་དེ་ལ་སྒྱུ་མ་ལྟ་བུར་ངེས་ཤེས་འདྲེན་ཅིང་དེར་མ་ཟད་ཀུན་རྫོབ་པའི་སྣང་བ་ཅི་ཤར་ཡང་།",
    "དེ་རྣམས་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་པའི་ཕྱིར།",
    "དེས་ན་ཤ་རུས་རྡོས་བཅས་ཀྱི་ཕུང་པོ་འདིའི་སྟེང་ནས་ལུས་སུ་གྲུབ་རྒྱུ་ཅུང་ཟད་ཀྱང་མི་འདུག་སྙམ་དུ་ངེས་པ་ན་སྔར་ལྟར་བསྐང་ངོ།",
    "ཁང་པའི་རྒྱ་མཐོངས་ཀྱི་ནམ་མཁའ་ལྟ་བུ་ལ་ནི་ཤར་ནུབ་དང་ལྷོ་བྱང་སོགས་ཀྱི་ཆ་ཇི་སྙེད་ཅིག་ཡོད་པ་ལས་ཆ་དེ་རྣམས་དང་རང་བཞིན་གྱིས་གཅིག་ཐ་དད་དཔྱོད་པའམ།",
    "ཅི་སྨྲས་ཀྱང་ཡལ་སྟེང་ནས་གྲུབ་པ་ཞེ་ལ་འཚངས་ཏེ་འདུག་གོ།",
    "དངོས་པོ་རྣམས་ཀྱི་མིང་དང་བརྡ་རྣམས་ཀྱང་འགྲོ་བ་རང་རང་ལ་ཇི་ལྟར་གྲགས་པ་དང་སྒོ་བསྟུན་ནས་འདོམས་པར་མཛད་ཀྱི་སྐད་རིགས་གཅིག་ཁོ་ན་དང་།",
    "ད་དཔྱད་ན་མི་གདའ་ཇི་ལྟར་ལགས།",
    "ད་དུང་རྣམ་པ་ཝ་ལེར་གདའ།",
    "ལུགས་འདིའི་རྗེས་འབྲང་ཁ་ཅིག་ང་རང་བཞིན་གྱིས་མེད་སྙམ་དུ་བློ་ལ་སྒོམ་ཞིང་ཚིག་ཏུ་ཡང་དེ་ལྟར་བརྗོད་པ་དང་།",
    "ཆ་ཅན་དེ་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་སྟེ།",
    "རྗེས་ཐོབ་ཏུ་བདག་དང་འཁོར་འདས་ཐམས་ཅད་ཀྱང་སྒྲ་མ་རྨི་ལམ་ལྟ་བུར་སྣང་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་དང་།",
    "རང་རང་གནས་སུ་རྒྱས་བཏབ་བོ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "ཨ་ར་པ་ཙ་ན་ཡ་ཏེ་ན་མ།",
    "ཐམས་ཅད་མཁྱེན་པ་བུ་སྟོན་ཁ་ཆེས་ཀྱང་ཐེ་ཚོམ་གྱི་མཚན་བརྗོད་གཞིར་མཛད་འདུག་པས།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ་ཞེས་པའི་བར་ཏེ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "རང་ཉིད་བྱེད་ཅིང་རང་ཉིད་འཕྲོག།",
    "ཨ་ར་པ་ཙ་ནཱ་ནི་རྡོ་རྗེ་སེམས་དཔའི་ཐུགས་ཀར་ཡེ་ཤེས་བསྡུས་པ་བསྒོམས་པས་ཏེ།",
    "ཨ་ར་པ་ཙ་ན་ཞེས་པ་ནི།",
    "ཁྲུས་བྱས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡང་རང་བྱིན་གྱིས་བརླབ་པ་སྒྱུ་མ་ལྟ་བུའི་ལུས་ཏེ་གཞོམ་དུ་མེད་པའི་སྒྲའི་ཚུལ་ཉིད་ཀྱིས་དེའི་དག་པའི་རྒྱུ་དོན་དམ་པའི་བདེན་པ་འོད་གསལ་ཞེས་བྱའོ།",
    "ཕྱོགས་འདི་དག་ཏུའང་རྣམ་པ་ཐམས་ཅད་པའི་སྟོང་གཟུགས་ལ་ཁཀུན་རྫོབ་བདེན་པ་དང་རང་བྱིན་གྱིས་བརླབ་པ་ཞེས་པའི་ཐ་སྙད་བྱེད་དེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ་ཞེས་པ་ནས།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "བདེ་ཆེན་དེ་ཡང་རང་། སྐྱེད་པར་བྱེད་པའི་ཐབས་ཀྱི་རྒྱལ་པོ་ཕྱག་རྒྱ་དང་སྙོམས་པར་འཇུག་པའི་སྒྱུ་འཕྲུལ་སྣ་ཚོགས་པའི་སྦྱོར་ཐབས་འཛིན་པ་ལས་བྱུང་ཞིང་།",
    "ཡེ་ཤེས་དེ་ཡང་རང་བཞིན་གྱིས་མེད་པའི་སྟོང་པ་ཉིད་ལས་བྱུང་བ་དང་།",
    "རྒྱལ་བ་རྡོ་རྗེ་འཆང་རང་ཉིད་ཀྱིས་དང་པོར་གསུངས་། པའི་རྩ་བའི་རྒྱུད་རྒྱས་པ་བློ་ཀ་ཉི་ཁྲི་ལྔ་སྟོང་ཡོད་པ་དང་།",
    "སུ་ཙ་ནི་ཡང་།",
    "གཏན་མེད་དང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་འགལ་བའི་ཕྱིར།",
    "སྨོན་པའི་ཚུལ་ལ་སོགས་པ་གང་ཡང་རང་བཞིན་གྱིས་དམིགས་སུ་མེད་པའི་ཕྱིར་རོ།",
    "ས་དོང་དེའི་ནང་ཕྱོགས་གཅིག་ལ་གྲིབ་ནག་འདུག་ལ་ཕྱོགས་གཞན་དེར་མི་འདུག་དེ་ལས་སའི་གོ་ལ་འདིའི་སྟེང་ལ་ཡོད་པ་བཞིན་དེར་ཡང་གྲིབ་ནག་དེ་འཕངས་མཁན་གྱི་འོད་ཀྱི་འབྱུང་ཁུངས་ཤིག་ངེས་པར་དགོས་པ་དེ་ཚོད་དཔག་བྱེད་ཐུབ་བྱུང་།",
    "ཁོས་དུ་བ་མཐོང་ནས་མེ་ཡོད་པ་དང་ཁོ་རང་ཞག་གཅིག་རིང་སྡོད་སའི་གནས་ཚང་ཡོད་པ་དཔོག་ཐུབ།",
    "ང་རང་ལོ་ན་ཕྲ་བའི་སྐབས་ནས་གནའ་བོའི་རྒྱ་གར་གྱི་ལྟ་གྲུབ་ལ་རྒྱུས་མངའ་བྱེད་པའི་གོ་སྐབས་བྱུང་བ་དང་།",
    "ཁོང་རང་ཉིད་ཧ་ཅང་སྒམ་ཚུགས་ཅན་ཞིག་ཡིན།",
    "འགྲོ་བ་མི་བཅས་ཀྱི་ཐད་ལ་ཁོང་ལྟར་གོ་རྟོགས་ཡོད་པའི་ཚན་རིག་པ་མང་ཙམ་ཡོད་ན་སྙམ་གྱི་འདུགངས་ཤེས་རྟོགས་བྱུང་བ་ལྟར་ན་དུས་རབས་ཉི་ཤུ་པའི་འགོ་སྟོད་དུ་དེང་དུས་ཀྱི་ཚན་རིག་ལ་ཉེན་ཁ་གཅིག་འཕྲད་ཡོད།",
    "དེ་ལས་ལྡོག་སྟེ་འགྲེལ་ཆེན་ནི་བརྒྱ་ཕྲག་དང་པོ་དང་གསུམ་པའི་བར་བྱུང་བར་བརྩི་བའི་བསྟན་བཅོས་སམ་གཞུང་རང་མཚན་པ་ཞིག་ཡིན།",
    "ང་རང་ལ་དེའི་སྐོར་ལྟ་གྲུབ་དང་འབྲེལ་ཏེ་འགྲེལ་བརྗོད་གནང་མཁན་ཐོག་མ་དེ་ཡང་ཌེ་ཝི་ཌི་བྷོམ་ཁོང་རང་ཡིན།",
    "ཌེ་ཝི་ཌི་བྷོམ་ནི་དེ་དག་ལ་དགག་པ་རྒྱག་མཁན་གཙོ་བོ་ཞིག་ཆགས་འདུགངས་ད་དུང་རླབས་རྡུལ་གཉིས་ཀྱི་རང་བཞིན་འགལ་སྣང་ལྟ་བུའི་ལྟ་གྲུབ་དང་།",
    "འདི་ངས་གསལ་པོ་དྲན་གྱི་འདུག་གང་ཡིན་ཟེར་ན་ངོས་ཀྱི་སྐད་སྐྱར་པ་གཉིས་དངངོས་རང་བཅས་དཔེ་མཚོན་དེའི་སྟེང་ནས་འཇིག་རྟེན་རྒྱ་སྐྱེད་འཕེལ་ཕྱོགས་བྱེད་སྟངས་དེ་བློ་ལ་འཆར་ཁག་པོ་བྱུང་།",
    "ང་རང་སྒེར་གྱི་བསམ་ཚུལ་བྱས་ན་འཇིག་རྟེན་ཁམས་ཆགས་པའི་བརྒྱུད་རིམ་འདི་མཐའ་དག་རྒྱུ་དང་འབྲས་བུའི་རང་བཞིན་གྱི་འགྲོ་ལུགས་ལས་བྱུང་བའི་དོན་ཞིག་ཡིན་ལ།",
    "འདིར་ཡང་རང་ཉིད་ཀྱིས་རང་བསྐྱེད་སྤེལ་དང་རང་བྱུང་འདེམས་སྒྲུག་བརྒྱུད་ལུ་ཀ་དེ་ཉིད་རིམ་པས་སྲོག་ཆགས་ཀྱི་རིགས་ཐམས་ཅད་དུ་འགྱུར་ལྡོག་བྱེད།",
    "ངས་མིང་འདི་ནམ་ཞིག་ཐོས་ཀྱང་ཁེར་དགོད་ཅིག་ཤོར་གྱི་འདུག་གང་ཡིན་ཟེར་ན།",
    "དེར་འགྲོ་བ་མིའི་ལུས་ཀྱི་ལྗིད་ནོམ་གོ་རིམ་ངེས་ཅན་དུ་སྒྲིག་བཞིན་ཡོད་པའི་ནུས་སྟོབས་ཅན་གྱི་འཕྲུལ་ཆས་མང་པོ་འདུག་ལ་དེ་ལྟར་ལྗིད་ནོམ་གོ་རིམ་སྒྲིག་བཞིན་པའི་རིམ་པ་འགའ་ཞིག་བསྟན་གནང་བྱུང་།",
    "དེར་བརྡ་ལེན་བྱེད་མཁན་མང་པོ་མཐུད་འདུག་ཌེ་ཝི་ཌེ་སན་གྱི་བརྟག་དཔྱད་ཁང་ནང་ཡོད་པ་དེར་བརྡ་ལེན་བྱེད་མཁན་ཉིས་བརྒྱ་ང་དྲུག་ཡོད་སྟབས།",
    "འཛམ་གླིང་ནང་ཞིབ་ཚགས་ཆེ་ཤོས་ཞིག་ཡིན་པ་གསལ་པོ་འདུག་དེའི་སྟེང་ཨེམ།",
    "བློ་ཕམ་པ་ཞིག་ལ་ཁོང་གྲོངས་ཚར་འདུག་གཞན་ཁོང་སྐུ་འཚོ་བཞུགས་སྐབས་རི་ཅར་ཌེ།",
    "རྩལ་དེ་དག་དུས་ཡུན་རིང་པོའི་རྗེས་ལ་གཞི་ནས་ཐོབ་ཐུབ།",
    "དེའི་བྱེད་ཚུལ་ཡང་རང་ཉིད་ཁུ་སིམ་པོའི་ངང་དམ་བཅའ་ཞིག་བྱས་ཏེ།",
    "རྩེ་རྣོ་བའི་ཚེར་མར་འཛེམས་ཟོན་དགོས་པ་ཞིག་འདུག་སྙམ་པའི་རྟོག་པ་མངོན་གྱུར་བ་ཞིག་སླེབས་ཡོང་།",
    "ཨམ་སེ་ཊོང་བབསས་དེ་ཟླ་བ་ཡིན་འདུག་སྙམ་པའི་བློ་མ་ནོར་བའི་ཕྱོགས་སུ་མཇུག་བསྡོམས་རྒྱག་ཐུབ།",
    "དེ་ལྟ་ནའང་རང་ཉིད་དང་རང་ཉིད་གནས་སྡོད་བྱ་ཡུལ་གྱི་རང་བཞིན་གྱི་འཇིག་རྟེན་ཁམས་གཉིས་ཀའི་རིགས་རྫས་ཀྱི་གསང་ཚེགས་ཡང་བསྐྱར་བཅོས་བྱེད་འགོ་བཙུགས་ཡོང་དུས།",
    "འགྲོ་བ་མིའི་རིགས་ཡོངས་དང་རང་ཉིད་གནས་སྡོད་བྱེད་པའི་ས་གཞི་འདི་ཉིད་ཀྱི་བདེ་ཐབས་ཀྱི་དམིགས་ཡུལ་གཙོ་བོ་དེ་སེམས་ནང་འཇོག་དགོས།",
    "དེ་ལ་དང་པོ་ཡིད་དང་མཐུན་པའི་གནས་སུ་སྟན་བདེ་བ་ལ་འདུག་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "དངོས་གཞི་ལ་ཁྱེད་རང་རྣམས་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཁྱེད་རང་རྣམས་རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མ་སོགས་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་དམིགས་པ་འདི་བཞིན་དུ་མཛོད།",
    "སླར་ཡང་སློབ་དཔོན་མདུན་བསྐྱེད་། དང་བཅས་པའི་ཐུགས་ཀ་ནས་ཀྱང་རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྐུ་བསམ་གྱིས་མི་ཁྱབ་པ་སྤྱན་དྲངས་ཏེ་ཁྱེད་རང་རྣམས་སོགས་ནས།",
    "ཞེས་པས་བྱིན་གྱིས་བརླབས་ནས་སློབ་དཔོན་གྱིས་ཨོཾ་བཛྲ་ནེ་ཏྲ་ཨ་པ་ཧཱ་ར་པ་ཊ་ལཾ་ཧྲཱི་ཞེས་པས་ཁྱེད་རང་རྣམས་ཀྱི་མ་རིག་པའི་ལིང་ཐོག་དང་མིག་རས་ལྷན་ཅིག་ཏུ་ཕྱེས་ནས་དཀྱིལ་འཁོར་གྱི་ལྷ་ངོ་བསྟན་པ་ནི།",
    "བཛྲ་། བེ་རོ་ཙ་ནཱི་ཡེ།",
    "སུ་ཁ་བལྟས་ཏེ་འདུག་ནས། ། གསུམ་པ་ཆོ་ག་ཉམས་སུ་བླང་བའི་རིམ་པ་བསྟན་པ་དེའི་རྗེས་ལ་རྫས་སྔགས་ཏིང་ངེ་འཛིན་གྱིས་ལུས་དང་ངག་དང་ཡིད་དག་པའི་ཕྱིར་ལྷ་རྫས་ཀྱི་བཏུང་བ་སྦྲང་ཆང་ངམ།",
    "དཔེ་ལ་ལར་ཊ་ལོག་ཅེས་སྣང་བ་ཏ་ཡིག་ལ་ངོས་བཟུང་བའིབཀོད་ལུགས་ཀྱང་འདུག།",
    "བེ་རོ་ཙ་ནཱི་ཉ་ལའི་དབུས་གནས་ཡི་གེ་ཡ་ལ།",
    "མ་གསང་རང་གཞན་གཉིས་ཀའི་དོན་ལ་བར་ཆད་འཇུག་པའི་གེགས་ནི་འབྱུང་འགྱུར་ཏེ།",
    "དེ་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་བ་ལ།",
    "ད་ཁྱེད་རང་རྣམས་ཐུགས་འདུན་པ་མ་ཡེངས་པར་འདི་ལ་སྙན་གཏད་པར་ཞུ།་",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་སྣང་སྟོང་སྒྱུ་མ་ལྟ་བུ་དེ་ཡང་མི་དམིགས་པར་བསྒོམ།",
    "ཁྱེད་རང་རྣམས་ཐུགས་འདུན་འདི་བཞིན་དུ་གནང་བར་ཞུ།",
    "དེའང་རང་བཞིན་གྱིས་འོད་གསལ་བར་བསམས་ལ།",
    "སུ་འདུག་པར་བསམས་ལ་བཟླས་པ་བྱའོ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "སླར་ཡང་སློབ་དཔོན་གྱིས་བདུད་རྩི་ཁྱེད་རང་རྣམས་ཀྱི་ལྗགས་ཐོག་དང་།",
    "ཞེས་པས་ཁྱེད་རང་རྣམས་ཀྱི་མ་རིག་པའི་ལིང་ཏོག་དང་མིག་རས་ལྷན་ཅིག་ཏུ་བསལ་ཏེ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་ནུབ་ཕྱོགས་སུ་འཁོད་པའམ།",
    "ཞལ་ནས་ཐོན་པའི་སྔགས་ཕྲེང་དང་དབྱེར་མེད་དུ་གྱུར་པ་དེ་ཉིད་ཁྱེད་རང་རྣམས་རྗེ་བཙུན་མའི་སྐུ་ཅན་དུ་གྱུར་པའི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་རྗེ་བཙུན་མའི་སྐུའི་རྣམ་འགྱུར་དུ་བྱས་པའི་ཕྱག་གཡོན་དུ་བདུད་རྩི་དང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཕཊ།",
    "སྟན་བདེ་བ་ལ་ནུབ་ཀྱི་ཕྱོགས་སམ་ལྷོ་ཕྱོགས་སུ་ཁ་བལྟས་ནས་འདུག་སྟེ།",
    "གཡས་སུ་བེ་རོ་ཙ་ན་དགོད་པའམ།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཕཊ།",
    "རང་ཉིད་ཅེས་པར་ཁྱེད་རང་རྣམས་ཞེས་བསྒྱུར།",
    "བཾ་ཡིག་དམར་པོའི་ཚོགས་དཔག་ཏུ་མེད་པའི་རྣམ་པར་བྱུང་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བའི་བཾ་ཡིག་ལ་སིབ་སིབ་ཐིམ་པས་ལུས་ཀྱི་ནང་ཐམས་ཅད་གང་།",
    "བཾ་ཡིག་དམར་པོའི་ཚོགས་དཔག་ཏུ་མེད་པའི་རྣམ་པར་བྱུང་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བའི་བཾ་ཡིག་ལ་སིབ་སིབ་ཐིམ་པས་ལུས་ཀྱི་ནང་གང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཕཊ་ཅེས་བཟླ།",
    "རང་ཉིད་ཅེས་པར་ཁྱེད་རང་རྣམས་ཞེས་བསྒྱུར།",
    "ཞེས་པས་ཁྱེད་རང་རྣམས་ཀྱི་མ་རིག་པའི་ལིང་ཏོག་དང་མིག་རས་དུས་མཉམ་དུ་བསལ་ནས་དཀྱིལ་འཁོར་གྱི་ལྷ་ངོ་བསྟན་པ་ནི།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཕཊ།",
    "ༀབཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཕཊ།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཕཊ།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཕཊ།",
    "དེ་ནས་རྗེས་སུ་གནང་བ་དངོས་ནི་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "བཞི་པ་སྤྱོད་པའི་རྗེས་གནང་ཡང་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ལྔ་པ་གཞན་དོན་བྱ་བའི་རྗེས་གནང་ནི་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་ཝརྞ་ནཱི་ཡེ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ་ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "སློབ་དཔོན་གྱིས་ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དག་པར་གྱུར་པའི་ལྟེ་བར་པདྨ་སོགས་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་གཙུག་ལ་སོགས་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བར་པདྨ་འདབ་མ་གསུམ་པ་ཧྲཱི་འབར་བ་དང་བཅས་པ་ལ་སེམས་གཏད་དེ།",
    "སླར་ཡང་རང་ཉིད་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྐར་གྱུར་པའི་གནས་རྣམས་སུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཅེས་པའང་རང་འདྲའི་བློ་དམན་རྣམས་ལ་ཉེ་བར་མཁོ་བའི་ཆེད་དུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་འཇམ་པའི་རྡོ་རྗེ་ཞེས་བསྐྱར་བས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ཀྱིས་སྐྱེ་བ་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཡིད་ཀྱིས་སྐྱེ་བ་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྐུ་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་བག་ཆགས་དང་བཅས་པ་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར་པ་སློབ་དཔོན་གཤིན་རྗེ་གཤེད་དམར་པོ་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "དེ་ནས་མདུན་བསྐྱེད་ཀྱི་དཔལ་གཤིན་རྗེ་གཤེད་ཡབ་ཡུམ་ཁྱེད་རང་རྣམས་ལ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་ས་ཚོགས་ཞིང་རང་ལ་བསྟིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཉེས་ལྟུང་ལྷ་འདྲེས་བྱད་དུ་བཅུག་པ་སོགས་སྤང་བྱ་མི་མཐུན་པའི་ཚོགས་དང་།",
    "དེའི་ངང་ལས་ཁྱེད་རང་རྣམས་གང་དུ་གནས་པའི་གོ་སར་པཾ་ལས་པདྨ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "གནས་དབེན་པར་བདེ་བའི་གདན་ལ་བསམ་གཏན་གྱི་རོལ་པས་འདུག་སྟེ་མདུན་གྱི་ནམ་མཁར་སྐྱབས་ཡུལ་རྣམས་མངོན་སུམ་བཞིན་དུ་གསལ་བཏབ་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "གདན་སྟེང་རང་ཉིད་ཡི་གེ་ཧྲཱི།",
    "རང་རང་སྔགས་ཀྱིས་བསྐོར་བ་ལས།",
    "མཆོད་ཡོན་འདུག་སྤོས་མེ་ཏོག་སྣང་གསལ་དྲི།",
    "དེ་ནས་ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་བདུད་རྩི་མཆོད་རྫས་དང་གནས་ཁང་དང་རང་ཉིད་ཀྱི་ལུས་ལ་གཏོར།",
    "རྟགས་མཐོང་ནས་སྔགས་ཡོངས་རྫོགས་སྦྲེལ་ལ་བཟླ་གསུངས་ཀྱང་ད་ལྟའི་ཕྱག་ལེན་ཏུ་རྟ་སྔགས་མི་སྦྲེལ་བར་འདུག་བདག་མདུན་སྒོམ་ཚུལ་རྙིང་མ་སྤྱི་མཚུངས་བྱ་ཆོག་ཀྱང་ཕྱག་རྒྱུན་དུ་ཐུན་སྟོད་བདག་བསྐྱེད་ཐུན་སྨད་མདུན་བསྐྱེད་མཆོད་བསྟོད་སོགས་སྤྲོས་པ་ཆེ་བར་མཛད་པར་སྣང་།",
    "མདུན་རྟེན་། ལའང་རང་ཉིད་ཇི་ལྟ་བར་བསྐྱེད་ཅིང་སྤྲོ་བསྡུ་བྱ།",
    "རང་རང་གནས་སུ་བྱེར་བར་གྱིས།",
    "ཁྱེད་རང་རྒྱལ་བ་རྒྱ་མཚོའི་སྐུར་གསལ་བའི།",
    "གསེར་གྱི་རི་བོ་ལྟ་བུར་རབ་ཏུ་གདའ།",
    "ནང་གཞལ་ཡས་ཀྱི་ཁང་པ་ཟླུམ་པོ་གུར་ཐབས་སུ་འདུག་པ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཏིཥྛ་ཛྭ་ལ་སརྦ་སིདྡྷི་ལོ་ཙ་ནི།",
    "ཟླ་སྟེང་རང་སེམས་ཨུཏྤལ་དཀར།",
    "དེའི་སྟེང་དུ་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཏཱཾ་དཀར་པོ་ལས་སོགས་དང་།",
    "ཡོངས་སུ་གྱུར་པ་ལས་ཁྱེད་རང་རྣམས་འཕགས་མ་སྒྲོལ་མ་སོགས་མངོན་རྟོགས་ལྟར་དགོད་པ་ལས་ཐུགས་ཀར་ཧཱུཾ་སྔོན་པོས་མཚན་པ་སྒོམས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་བཅོམ་ལྡན་འདས་མ་ཡིད་བཞིན་འཁོར་ལོའི་སྐུ་གསུང་ཐུགས་དང་དབྱེར་མེད་པར་གྱུར་ཅིང་ཡེ་ཤེས་པ་ཕེབས་བྱུང་སྙམ་པའི་ངང་ནས་སེམས་མ་བཅོས་པ་ལྷོད་གློད་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཁ་སྒོ་ནས་ཞུགས།",
    "མདུན་བསྐྱེད་ལས་མར་མེ་གཅིག་ལས་གཉིས་མཆེད་ཀྱི་ཚུལ་དུ་རྗེ་བཙུན་མ་ཡིད་བཞིན་འཁོར་ལོའི་སྐུ་གསལ་ལ་རྫོགས་པ་བྱོན་ནས་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བ་ལ་རྒྱན་ཆ་གཏད་པས་དངོས་སུ་རྒྱན་ཆའི་རྣམ་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་ལྔར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་རྗེ་བཙུན་སྒྲོལ་མ་གནས་གསུམ་ཡིག་འབྲུ་གསུམ་དང་བཅས་པ་གསལ་ཐོབ།",
    "གཏོར་མ་ལྷར་གསལ་བ་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་ལྷག་པའི་ལྷའི་སྐུ་གསུང་ཐུགས་དབྱེར་མེད།",
    "མངྒ་ལ་གོ་རོ་ཙ་ན་༴",
    "ཀུ་ཤའི་ཆུན་པོའང་གང་བདེར་བཞག་འདུག་སྟངས་ཆས་གོས་བསམ་པ་སོགས་སྤྱི་ལྟར་ཤེས་པར་བྱའོ།",
    "རབ་གནས་དང་རང་གཞན་གྱི་ཞི་བའི་ལས་སྤྱི་འགྲོ་ཙམ་བསྒྲུབ་པ་ལ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི།",
    "འདུག་སྟངས་ཆས་གོས་སོགས་བསྒྱུར།",
    "དམིགས་བསལ་ཚེ་སྤེལ་བར་འདོད་ན་རྒྱས་པའི་སྦྱིན་སྲེག་དུས་སྐབས་དེ་ཉིད་དམ་གཞན་ཏུའང་རུང་འབུམ་ཕྲག་ལ་སོགས་པའི་གྲངས་ཇི་ཙམ་མང་བ་ལེགས་པས་དེ་བཞིན་དང་།",
    "འཇིགས་པ་བཅུ་དྲུག་དུས་མིན་འཆི་བའི་རྐྱེན།",
    "མཐར་ཐུག་དུས་གསུམ་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་ཡུམ་གྱུར་འཕགས་མ་སྒྲོལ་མའི་གོ་འཕང་དུས་མྱུར་བ་ཉིད་དུ་བདེ་བླག་ཏུ་འཐོབ་པར་བྱ་བའི་ཕྱིར་རྗེ་བཙུན་མ་ཡིད་བཞིན་འཁོར་ལོའི་བསྐྱེད་རྫོགས་ལ་འཇུག་ཅིང་བརྩོན་པ་ཆེན་པོས་མཐར་དབྱུང་སྟེ།",
    "པཎ་ཆེན་བྱམས་གླིང་པའི་ཕྱོགས་ནས་བརྒྱུད་པའི་འཕྲོས་འདུག་གསུངས།",
    "ཇོ་ནང་ཁྲིད་བརྒྱ་ལྟར་ཚར་གཅིག་གསན་ནས་ཉམས་བཞེས་ཟླ་བ་དྲུག་མཛད་འདུག་ཅིང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་རིག་གཏད་ཞུ་བའི་ཡོན་དུ་དམིགས་ཏེ་མཎྜལ་འབུལ་བར་ཞུ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི།",
    "དེ་ནས་ཁྱེད་རང་དམ་ཚིག་སྒྲོལ་མ་རྩ་བའི་ལྷ་འདི་ལྟར་དུ་གསལ་ཐོབ་ཅིག་ༀཤཱུ་ནྱཏཱ་ཛྙཱ་ན་བཛྲ་སྭཱབྷཱ་བ་ཨཱཏྨ་ཀོཧཾ།",
    "ཁྱེད་རང་གང་དུ་གནས་པའི་གོ་སར་སྣ་ཚོགས་པདྨ་དང་ཟླ་བའི་གདན་ལ་སེམས་ཉིད་ཏཱཾ་ཡིག་ལྗང་སྔོན་ལས་ཨུཏྤལ་སྔོན་པོ་ཏཱཾ་གྱིས་མཚན་པ།",
    "ཁྱེད་རང་སྒྲོལ་མར་གསལ་བའི་ཞལ་དུ་བཞུགས།",
    "གང་ཞིག་དུས་གསུམ་ཀློག་བྱེད་ན།",
    "འདི་ལ་འགྱུར་སྔ་ཕྱི་མང་དུ་འདུག་ནའང་སླར་གྱིས་རྒྱ་གར་གྱི་དཔེ་ཁ་ཡར་ལ་གཏུགས་ནས།",
    "རང་ཉིད་སྟན་ལ་འདུག་པའི་དྲུང་དུ།",
    "དེ་ནས་མཚན་བརྒྱ་རྩ་བརྒྱད་པའི་ལུང་བྱ་བ་ལ་ཐོག་མར་གླེང་གཞི་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་ཕན་ཡོན་བརྗོད་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་སློབ་དཔོན་ལ་མེ་ཏོག་འཐོར་བཞིན་པས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "སློབ་དཔོན་གྱིས་ཀྱང་ཁྱེད་རང་རྣམས་ལ་མེ་ཏོག་གཏོར་ནས།",
    "དང་པོ་སློབ་དཔོན་གྱིས་བགྱིད་འོས་ཐམས་ཅད་ལེགས་པར་གྲུབ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ།",
    "དང་པོ་ནི་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "རོལ་པའི་འདུག་སྟངས་འགྱིང་བག་མཛེས་མ།",
    "ཕྱེད་སྐྱིལ་རོལ་པའི་འདུག་སྟངས་མཛེས་བརྗིད།",
    "དྲི་བ་ལྔ་པ་ཡེ་ཤེས་ཞབས་ལུགས་ཀྱི་གསང་འདུས་དང་གཤེད་སྐོར་གྱི་སྐབས་འགའ་ཞིག་ཏུ་བདག་བསྐྱེད་ཀྱི་ཡེ་ཤེས་པ་གཤེགས་གསོལ་བྱེད་པ་གདའ་མཆིས་པ་དེའི་དགོངས་པ་ཇི་ལྟར་ལགས་ཞེས་པའི་ལན་ནི།",
    "མྱུར་བུལ་ཙམ་མ་གཏོགས་འབྲས་བུའི་ངོ་བོ་ལ་ཁྱད་པར་མེད་པར་འདོད་པ་གདའ་ལགས་པས་ཅི་ལྟར་ལགས།",
    "ལྗོན་ཤིང་བྱིན་པོར་སེམས་ལས་བྱུང་བའི་གཞི་ནི་སེམས་བྱུང་ལྔ་བཅུ་རྩ་གཅིག་གོ་ཞེས་གསུངས་གདའ་ལགས་ཞེས་པའི་ལན་ནི།",
    "ཀུན་རྫོབ་ཏུ་གནས་འགྱུར་ཞེས་གནོད་བྱེད་གཏོང་བ་གདའ་ན།",
    "དྲི་བ་བཅུ་གཉིས་པ་སེམས་ཙམ་པས་ཕྱི་རོལ་གྱི་དོན་ཁས་མི་ལེན་ཙ་ན་ཐེག་བསྡུས་སུ་གཟུགས་ཀྱི་ཕུང་པོ་གནས་གྱུར་པའི་ཕྱིར་ཞིང་དང་ལུས་ཞེས་སོགས་གཟུགས་ཕུང་པོ་ཁས་ལེན་པ་ཅི་ལྟར་ལགས་ཞེས་པའི་ལན་ནི།",
