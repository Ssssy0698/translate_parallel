    "དོན་རང་གི་མཚན་ཉིད་ནི་དངོས་པོར་ཡོད་དེ།",
    "དཔེར་ན་རབ་རིབ་ཅན་དག་གིས།",
    "དོན་དམ་རྣམ་བཞག་གི་ཁ་ནང་ལྟས་ཀྱི་བདེ་སྡུག་ཤེས་པ་གཅིག་པུ་མ་གཏོགས་པ་ཁ་ཕྱིར་ལྟས་ཀྱི་བློ་ལ་སྣང་བ་ཐམས་ཅད་འཁྲུལ་བ་ཡིན་ཞིང་།",
    "རྣམ་པར་རྟོག་པ་གང་གང་གིས།",
    "དོན་རང་གི་མཚན་ཉིད་དངོས་མེད་དུ་འདོད་པ་མི་འཐད་དེ།",
    "ཕྱི་རོལ་དོན་རང་གི་མཚན་ཉིད་ཀྱང་དངོས་པོར་ཡོད་དེ་མེས་བཙོ་བ་དང་བསྲེག་པའི་དོན་བྱེད་ལ།",
    "མེས་བཙོ་བསྲེག་གི་དོན་བྱེད་པ་དེ་དོན་བྱེད་པ་ལྟ་བུ་ཡིན་གྱི་དོན་བྱེད་པ་ཡང་དག་པ་མེད་དོ་ཞེ་ན།",
    "མེས་བཙོ་བསྲེག་གི་དོན་བྱེད་པ་ཡང་དག་པ་ཡོད་ནའང་གནོད་པ་ཅི་གཏོང་།",
    "དྲུག་གིས་ཅིག་ཅར་སྦྱར་བ་ན།",
    "རགས་པ་གཅིག་ཏུ་ཡོད་དམ་ཕྲ་མོ་དུ་མར་ཡོད།",
    "མ་འབྲེལ་ན་རི་དང་རྩིག་པ་ལ་སོགས་པ་རགས་པ་ཆེ་ལིང་ངེ་བ་འདི་བརྩམ་དུ་མེད་པར་ཐལ་ལོ་ཞེ་ན།",
    "མ་འབྲེལ་ན་ལོ་དང་ཟླ་བ་ལ་སོགས་པ་རྒྱུན་རིང་པོ་བརྩམ་དུ་མི་བཏུབ་པར་ཐལ་ལོ།",
    "གསུམ་པ་དེ་ལ་བརྩོད་པ་སྤང་བ་ནི་ཟུར་ན་གནས་པའི་རྒོལ་བ་ཞིག་ན་རེ་འོ་ན་ཆ་མེད་ཀྱི་གཅིག་དང་དུ་མ་བཀག་པས་དོན་དང་ཤེས་པ་གཉིས་ཀ་དོན་དམ་དུ་ཡོད་པ་ཁེགས་ཀྱི་ཀུན་རྫོབ་ཏུ་ཡོད་པ་མི་ཁེགས་ན།",
    "འོ་ན་ཆ་མེད་ཀྱི་གཅིག་དང་དུ་མ་བཀག་པས་དོན་དང་ཤེས་པ་དོན་དམ་དུ་ཡོད་པ་ཁེགས་ཀྱི་ཀུན་རྫོབ་ཏུ་ཡོད་པ་མི་ཁེགས་ན་དངོས་པོ་ཙམ་དུ་ཡོད་པའང་མི་ཁེགས་པར་ཐལ་ལོ་ཞེ་ན།",
    "དེ་ལ་ཕྱི་པ་ན་རེ་གཞལ་བྱའི་ངོས་ནས་ཁྱད་འབྱེད་པ་ནི་བདེན་ཡང་།",
    "དེ་དག་གི་གཞུང་ལས།",
    "དོན་རང་གི་མཚན་ཉིད་དང་རྟོག་བྲལ་མ་འཁྲུལ་བ་དང་བདག་གཅིག་ཅིང་།",
    "དེ་ལྟ་མ་ཡིན་ན་སྔོན་པོ་ཉིད་ཀྱང་མ་དམིགས་པར་ཐལ་ལོ།",
    "གང་ཞིག་མ་ཡིན་དགག་གི་ཁྱབ་བྱ་ཁྱབ་བྱེད་ཡིན་པ་དེ་ལ་འབྲེལ་བས་ཁྱབ་སྟེ།",
    "ཡིན་ན་ཟླ་བ་གཉིས་སུ་སྣང་བའི་སྣང་ཡུལ་ལ་གསལ་ཞིང་རིག་པ་ཡོད་པས་ཤེས་པར་ཐལ་ལོ།",
    "དེ་འདོད་ན་ཡོད་པར་བསྒྲུབ་བྱར་བཏུབ་པར་ཐལ་ལོ།",
    "དེས་ན་ཕྱི་རོལ་གྱི་དོན་གཟུང་བ་མངོན་སུམ་གྱིས་ཁེགས་པས་དྲུག་གིས་ཅིག་ཅར་སྦྱར་བ་ན་ཞེས་པ་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་དོན་འགོག་པའི་རྗེས་དཔག་དོན་མེད་པར་ཐལ་ལོ་ཞེས་རྒྱ་ཟེར་ཏེ།",
    "ལྷན་ཅིག་དམིགས་པ་ངེས་པའི་རྟགས་ཀྱིས་སྣང་བ་སེམས་སུ་བསྒྲུབ་པར་མི་ནུས་པ་ནི་ཕྱི་པ་ན་རེ་གང་ཞིག་མ་ཡིན་དགག་གི་ཁྱབ་བྱ་ཁྱབ་བྱེད་ཡིན་ཀྱང་འབྲེལ་བ་མེད་ན་ཅི་ལྟོ་སྟེ་ཁྱབ་པ་མ་གྲུབ་བོ།",
    "འདི་ལྟར་བུ་རམ་གྱི་རོ་མངར་པོ་དང་ཁ་དོག་སྨུག་པོ་གཉིས་མ་ཡིན་དགག་གི་ཁྱབ་བྱ་ཁྱབ་བྱེད་ཡིན་ཀྱང་།",
    "དེ་གཉིས་དུས་མཉམ་པས་དེ་ལས་བྱུང་བའི་འབྲེལ་བ་མ་ཡིན་པར་ཐལ།",
    "གཞན་ཡང་ལྷན་ཅིག་དམིགས་ངེས་ཀྱི་རྟགས་ལ་ལྡོག་གཅོད་ཀྱི་རིགས་པ་མེད་པས་ཀྱང་ཡང་དག་གི་རྟགས་མ་ཡིན་ཏེ།",
    "གཞན་ཡང་ཡོད་པ་བསྒྲུབ་བྱར་བཏུབ་པར་ཐལ་བ་ལ་སོགས་པའི་ཉེས་པའང་ཡོད་དེ་སྔ་མ་ལྟར་རྒྱ་ཆེར་ཤེས་པར་བྱའོ།",
    "རང་རིག་གི་ཤུགས་དང་བརྟག་པ་མཚུངས་པའོ།",
    "དེས་ན་བསྐལ་པ་རྣམ་པ་གསུམ་གྱིས་མ་བསྐལ་པའི་བུམ་པ་ཡོད་ན་སྐད་ཅིག་མ་ལྟ་བུ་རྣམ་མེད་ནི་མ་ཡིན་པས་རྣམ་ལྡན་གྱི་དོན་ལ་ཡིད་ཉེ་བར་གཏད་པ་ན་དམིགས་པར་ཐལ་བ་ལས་མ་དམིགས་པའི་ཕྱིར་བུམ་པ་མེད་དོ་ཞེ་ན།",
    "བདེ་བ་དང་དུ་ཁ་གཉིས་ཀྱང་གཅིག་པར་འདོད་པ་གང་གིས་བཟློག།",
    "བུམ་པ་ཆ་སྣ་ཚོགས་དང་བཅས་པ་འདི་དོན་དམ་པའི་གཅིག་རགས་པ་ཡན་ལག་ཅན་གྱི་རྫས་ཆ་མེད་གཅིག་ཏུ་འདོད་པ་གང་གིས་འགོག།",
    "མུ་སྟེགས་པས་འདོད་ཐོག་གི་ལན་འདེབས་ན་བསལ་བ་ཅི་གཏོང་།",
    "བརྫུན་ན་བརྫུན་ཏེ་ལེགས་དུ་མ་དང་གཅིག་པ་བཀག་པའི་ཐ་དད་དུ་སོང་བས་གཅིག་སྣང་གི་སྟེང་དུ་མ་བཀག་པ་ལ་མི་འཁྲུལ་ལོ་ཞེ་ན།",
    "འདིར་ཡང་གཟུང་ཆ་ཕྱི་རོལ་པ་བདེན་ན་བདེན་ཏེ་ལེགས་ན་ཤེས་པ་དང་དངོས་པོ་ཐ་དད་དུ་སོང་བས་ཉན་ཐོས་བྱེ་བྲག་ཏུ་སྨྲ་བའི་ལུགས་གཅིག་བྱུང་ལ།",
    "དུ་མར་ཐལ་བ་འདོད་ཐོག་ལ་ཁྱེད་རང་གིས་སྤྱི་གཅིག་ཏུ་ཁས་བླངས་པས་བསལ་བ་ཡིན་གྱི།",
    "གཞན་ཡང་རྣམ་པའི་གྲངས་ཇི་སྙེད་པ་ཤེས་པའི་གྲངས་ཀྱང་དེ་སྙེད་དུ་འདོད་པ་སློབ་དཔོན་ཤག་ཀྱ་བློ་ལ་སོགས་པའང་རགས་སྣང་རྒྱུན་ཆད་དུ་ཐལ་བ་དང་།",
    "ཁྲ་བོར་སྣང་བ་རྒྱུན་ཆད་དུ་ཐལ་བ་དང་།",
    "ཁྲ་བོར་སྣང་བ་རྒྱུན་ཆད་དུ་ཐལ་བའི་ཉེས་པ་ཡོད་དོ།",
    "དེ་དག་ལའང་གཟུང་འཛིན་གཉིས་མེད་མ་རྟོགས་པར་ཐལ་བའི་ཉེས་པ་ཡོད་དོ།",
    "འཛིན་ཆ་ཤེས་པ་ནི་སྐད་ཅིག་གིས་འཕྱིའོ།",
    "གཟུང་འཛིན་དུས་མཉམ་པས་དེ་ལས་བྱུང་བའི་འབྲེལ་བ་མ་ཡིན་པར་ཐལ།",
    "རྐྱེན་གསུམ་ཚང་ཡང་རེས་འགའ་བར་དམིགས་པའི་ཕྱིར་རོ།",
    "དོན་རང་གི་མཚན་ཉིད་ནི་དངོས་པོ་ཡིན་ནོ་ཞེས་རིག་པར་བྱ་སྟེ་སྔ་མ་བཞིན་ནོ།",
    "དོན་རང་གི་མཚན་ཉིད་གཟུང་ཡུལ་དུ་བྱེད་པ་རྟོག་བྲལ་མ་འཁྲུལ་བའི་ཤེས་པའི་འཇུག་པའི་ཚུལ་དང་།",
    "མེ་དེ་མེར་གནས་ཏེ་བཙོ་བསྲེག་གི་བྱེད་པ་དང་འབྲེལ་བས་སོ།",
    "གལ་ཏེ་ཐ་དད་ན་མེ་དེ་བྱས་པ་ལས་ཐ་དད་པའི་ཕྱིར་མ་བྱས་པར་ཐལ་བ་དང་།",
    "མི་རྟག་པ་ལ་ཐ་དད་པའི་ཕྱིར་རྟག་པར་ཐལ་བའི་ཉེས་པ་གནས་པས་སོ།",
    "དེ་ལྟ་མ་ཡིན་པར་ཐེ་ཚོམ་ཞེས་པའི་རྗེས་སུ་འགྲོ་བའི་སྤྱི་གཅིག་ཡོད་ན་སྐད་ཅིག་དང་པོའི་མེ་འགགས་པའི་ཚེ་གཉིས་པའི་མེའང་འགག་པར་ཐལ་བ་དང་།",
    "ཙན་དན་གྱི་མེ་མཐོང་བའི་ཚེ་བོང་བའི་མེ་ཡང་མཐོང་བར་ཐལ་ལོ་ཞེས་པ་ལ་སོགས་པའི་ཉེས་པ་ཡོད་པས་སོ།",
    "ཞེན་པའང་དོན་སྤྱི་ལ་དོན་རང་གི་མཚན་ཉིད་ཀྱི་མེར་ཞེན་པ་ནི་ལོག་ཤེས་ཡིན་ལ།",
    "ཡུལ་དང་ཡུལ་ཅན་མཐུན་མི་མཐུན་བརྟག་པ་ནི་སྣང་བའི་བྱེད་པ་དང་མེར་གནས་པ་ནི་མཐུན་མོད་ཀྱི།",
    "གཞན་སེལ་ཀྱང་མེད་དགག་གི་གཞན་སེལ་བའི་ཡུལ་ཅན་ཡིན་ནམ་མ་ཡིན་པར་དགག་པའི་གཞན་སེལ་བའི་ཡུལ་ཅན་ཞེ་ན།",
    "དུ་བ་ཡིན་པའི་ཕྱིར་ཅེས་པའི་འབྲས་བུའི་རྟག་ལ་རྟེན་པའི་རྗེས་དཔག་གིས་ཀྱང་མེའི་སྟེང་དུ་མེ་མེད་ཀྱི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་འཇལ་ལ།",
    "སྒྲ་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་ཅེས་པའི་རང་བཞིན་གྱི་རྟགས་ལ་བརྟེན་པའི་རྗེས་དཔག་གིས་ཀྱང་སྒྲའི་སྟེང་དུ་རྟག་པའི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་འཇལ་ཞིང་།",
    "མཚོ་ལ་དུ་བ་མེད་དེ་མེ་མེད་པའི་ཕྱིར་ཅེས་པ་མི་དམིགས་པའི་རྟགས་ལ་བརྟེན་པའི་རྗེས་དཔག་གིས་ཀྱང་།",
    "དེ་ལྟར་མ་ཡིན་པར་མ་ཡིན་དགག་འཇལ་ན་མེ་གཞལ་བའི་ཚེ་དེ་དང་རྫས་གཅིག་པའི་སྐད་ཅིག་མའང་གཞལ་བར་ཐལ་ལོ་ཞེས་བཞེད་དོ།",
    "ལྡོག་པ་གཞལ་བར་ཐལ་བ་ནི་ཁྱབ་པ་མེད་དོ་ཞེ་ན།",
    "ལྡོག་པ་གཞལ་བར་ཐལ་བ་ནི་ཁྱབ་པ་མེད་དོ།",
    "མེད་པས་མི་མཐུན་ཕྱོགས་མཐུན་ཕྱོགས་སུ་ཐལ་བ་དང་།",
    "དང་པོ་ནི་རྗེས་དཔག་གིས་མེ་མེད་ཀྱི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་འཇལ་ན་རྟགས་དུ་བས་མེ་ཡོད་ཀྱི་དངོས་པོ་སྒྲུབ་བམ་མེ་མེད་ཀྱི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་སྒྲུབ།",
    "དང་པོ་ལྟར་ན་རྗེས་དཔག་གི་གཞལ་བྱ་རྟགས་ཀྱི་མི་སྒྲུབ།",
    "རྟགས་ཀྱི་བསྒྲུབ་བྱ་རྗེས་དཔག་གིས་མི་འཇལ་བས་རྗེས་དཔག་དེ་རྟོགས་ལ་མི་ལྟོས་པར་ཐལ་ཏེ་དཔེར་ན་མངོན་སུམ་བཞིན་ནོ།",
    "རྗེས་དཔག་གིས་མེ་མེ་ལྡན་གྱི་དངོས་པོ་མ་ཡིན་དགག་ཁོ་ན་འཇལ་གྱིས་མེད་དགག་གཏན་མི་འཇལ་ལོ་ཞེས་བསྒྲེ་བར་བྱའོ།",
    "དུ་བ་ལ་མེ་མེད་ཀྱི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་གིས་ཁྱབ་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གཉིས་པ་ལྟར་ན་མེ་མེད་ཀྱི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་དེ་རི་བོང་གི་རྭ་ལའང་ཡོད་པས་མེ་སྒྲུབ་པའི་མཐུན་ཕྱོགས་སུ་ཐལ་ལོ།",
    "འདོད་ན་སློབ་དཔོན་དར་མ་ཀིར་ཏིས་མེད་པས་མི་མཐུན་ཕྱོགས་རི་བོང་གི་རྭ་ལྟ་བུ་དང་།",
    "སྔར་རྗེས་དཔག་གིས་ངེས་པ་དེ་ཉིད་ཕྱིས་རྟགས་སུའང་འགོད་དེ།",
    "དང་པོ་ལྟར་ན་མ་ཡིན་དགག་གི་དངོས་པོར་འགྱུར་ལ།",
    "གཉིས་པ་ལྟར་ན་དུ་བ་དང་མེ་གཉིས་ལ་དེ་ལས་བྱུང་བའི་འབྲེལ་བ་མེད་པས་འབྲེལ་མེད་ཀྱིས་འབྲེལ་མེད་སྒྲུབ་པའི་རྟགས་སུ་ཐལ་ལོ།",
    "ཡང་སློབ་དཔོན་བྲམ་ཟེ་ཆེན་པོ་ན་རེ་རྟགས་གསུམ་ལ་རྟེན་པའི་རྗེས་དཔག་ཐམས་ཅད་ཀྱིས་ཀྱང་མ་ཡིན་དགག་ཁོ་ན་འཇལ་ཏེ།",
    "རྣམ་བཞག་གི་ཡུལ་དུ་མི་འགལ་བ་དང་།",
    "ཡོད་མེད་ཕྱོགས་ཀྱི་བྱེ་བྲག་གིས།",
    "ཐུན་མོང་གི་མ་ངེས་པ་དང་པོ་རྒྱུན་ཆད་དུ་ཐལ་བ་དང་།",
    "རྣམ་གྲངས་མ་ཡིན་པའི་དོན་དམ་འཇལ་བའི་རིག་ཤེས་རྒྱུན་ཆད་དུ་ཐལ་བ་དང་།",
    "མ་ཁྱབ་ན་རྟག་པའི་དངོས་པོ་སྲིད་པར་ཐལ་ལོ།",
    "མ་ཁྱབ་ན་དོན་དམ་པའི་དངོས་པོ་སྲིད་པར་ཐལ་ལོ།",
    "གཞལ་བྱ་ཙམ་ཁེགས་པ་ན་གཞལ་བྱ་མངོན་འགྱུར་ཀྱང་ཁེགས་པའི་ཕྱིར་དེ་འཇལ་གྱི་རྣལ་འབྱོར་གྱི་མངོན་སུམ་ཀྱང་ཁེགས་པར་ཐལ་ལ།",
    "གཞལ་བྱ་ལྐོག་གྱུར་ཁེགས་པའི་ཕྱིར་དེ་འཇལ་མཁན་གྱི་སྤྲོས་པ་གཅོད་པའི་རྗེས་དཔག་ཀྱང་ཁེགས་པར་ཐལ་ལོ་ཞེས་རྒྱུ་དང་ཕྱི་པ་ཟེར་རོ།",
    "དོན་དམ་གཞལ་བྱར་མི་འདོད་པ་ཁོ་བོ་ཅག་རྣམས་ནི་འདོད་ཏོག་གིས་ལན་འདེབས་སོ་ཞེས་བྱང་སྐྱབས་གསུང་ངོ།",
    "འདོད་ན་རྗེས་དཔག་ཙམ་ཡང་མ་ཡིན་པར་ཐལ་ལོ།",
    "རྗེས་དཔག་ཙམ་མ་ཡིན་པ་འདོད་ན་ཚུལ་གསུམ་རྟགས་ལས་དོན་ཤེས་ཀྱང་མེད་པར་ཐལ་ལོ།",
    "ཡང་ཡ་གྱལ་བདེན་པས་སྟོང་ཙམ་གྱི་མེད་དགག་གཏན་མི་འཇལ་བའི་ཕྱིར་ཚོགས་པ་བདེན་པས་སྟོང་པའི་སྣང་བའང་མི་འཇལ་བས་སྣང་བ་འདི་སྒྱུ་མ་ལྟ་བུ་འདི་མི་འགྲུབ་པར་ཐལ་བ་དང་།",
    "ཡང་རྒྱ་ན་རེ་འབྲས་རྟགས་དང་རང་བཞིན་གྱི་རྟགས་ལ་རྟེན་པའི་རྗེས་དཔག་གིས་དངོས་སུ་ལ་མེ་ལྡན་གྱི་ཚོགས་དོན་དང་སྒྲ་མི་རྟག་པའི་ཚོགས་དོན་འཇལ་ལ།",
    "མི་དམིགས་པའི་རྟགས་ལ་རྟེན་པའི་རྗེས་དཔག་གིས་མཚོའི་སྟེང་དུ་དུ་བའི་དངོས་པོ་བཀག་ཙམ་གྱི་མེད་དགག་ཁོ་ན་འཇལ་ལོ་ཞེས་ཟེར་རོ།",
    "མི་ཁེགས་ན་མཉན་བྱ་ལ་མི་རྟག་པས་ཁྱབ་པ་གྲུབ་ཀྱང་སྒྲ་ལ་མི་རྟག་པས་ཁྱབ་པ་མི་འགྲུབ་པས་མཉན་བྱ་ནང་ཁྱབ་ཀྱི་ཚུལ་གྱིས་ཡང་དག་གི་ས་རྟགས་སུ་ཐལ་ལོ།",
    "འོ་ན་ཁྱབ་པ་གྲུབ་པའི་དུས་སུ་བསྒྲུབ་བྱ་གྲུབ་ཟིན་པས་ཕྱིས་ཀྱི་རྗེས་དཔག་སྐྱེ་མི་དགོས་སུ་ཐལ་ལོ།",
    "འདི་ཡང་དག་གི་རྟགས་ཡིན་ནམ་མ་ཡིན།",
    "དང་པོ་ལྟར་ན་རྗེས་དཔག་མ་ཡིན་དགག་གི་ཡུལ་ཅན་དུ་གྲུབ་ལ།",
    "དེ་ལ་རྩོད་པ་སྤང་བ་ལ་གཉིས་ལས་རིགས་པ་དང་འགལ་བ་སྤང་བ་ནི་རྗེས་དཔག་གིས་མཚོ་དང་དུ་བའི་ཚོགས་དོན་མ་ཡིན་དགག་འཇལ་ན་རྟགས་མེ་མེད་པས་ཀྱང་དེ་ཉིད་བསྒྲུབ་བམ་དེ་ལས་གཞན་བསྒྲུབ།",
    "དང་པོ་ལྟར་ན་རྟགས་མེ་མེད་ནི་རི་བོང་གི་རྭ་ལ་ཞུགས་ཤིང་།",
    "སྒྲུབ་བྱེད་སྔ་མ་དག་གིས་ནི།",
    "གཉིས་པ་ལ་སྒྲོ་འདོགས་མོ་གཤམ་དུ་བསྐྱེད་ཅིང་།",
    "དོན་རང་གི་མཚན་ཉིད་གཟུང་ཡུལ་དུ་བྱེད་པ་རྟོག་བྲལ་མ་འཁྲུལ་བའི་ཤེས་པའི་འཇུག་ཚུལ་ལ་གསུམ་སྟེ།",
    "གལ་ཏེ་ཐ་དད་ན་སྔོན་པོ་དེ་བྱས་པ་ལས་ཐ་དད་པའི་ཕྱིར་མ་བྱས་པར་ཐལ་བ་ལ་སོགས་པའི་ཉེས་པ་ཡོད་པས་སོ།",
    "འོ་ན་བྱས་པ་དང་མི་རྟག་པ་གཉིས་ཐ་དད་ཀྱང་ཡིན་ལ་དངོས་པོའང་ཡིན་པས་དངོས་པོ་ཐ་དད་དུ་ཐལ་ལོ་སྙམ་དུ་རྟོག་ན།",
    "རས་ཡུག་གི་སྔོན་པོ་དང་གཡུ་རྟོག་གི་སྔོན་པོ་རང་བཞིན་ཐ་དད་པས་ཐ་དད་དྲུག་ཡིན་གྱི་གཅིག་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གཅིག་ན་ཡུལ་འདིའི་སྔོན་པོ་མཐོང་བའི་ཚེ་ཡུལ་གཞན་གྱི་སྔོན་པོའང་མཐོང་བར་ཐལ་ལོ་ཞེས་པ་ལ་སོགས་པའི་སྐྱོན་ཡོད་པས་སོ།",
    "སྒྲོ་འདོགས་པའི་རྣམ་པ་ནི་སྔོ་ཙམ་གྱི་དོན་སྤྱི་གཅིག་ཤར་བས་ཕྱི་རོལ་དོན་རང་གི་མཚན་ཉིད་ལ་ཡང་སྔོ་ཙམ་ཞེས་པ་གཅིག་ཡོད་དེ་སྙམ་པའོ།",
    "ཡུལ་ཕ་གི་ལའང་སྔོན་པོ་དང་བྱས་པ་དང་མི་རྟག་པ་ཐ་དད་མེད་པར་གནས་ལ།",
    "མི་རྟག་པ་ལོགས་ཤིག་ཏུ་སོང་ནས་མི་སྣང་ངམ་གཏན་མེད་ནས་མི་སྣང་།",
    "ཡུལ་ཅན་མྱིག་གི་རྣམ་པར་ཤེས་པ་གཅིག་ལ་ལྟོས་ནས་སྣང་མི་སྣང་ཆ་གཉིས་མི་འཐད་དེ་དོན་ངོ་བོ་གཅིག་ཡིན་པའི་ཕྱིར་ཞེས་འགལ་ཁྱབ་དམིགས་པའི་རྗེས་དཔག་གིས་གནོད་པས་སོ།",
    "གལ་ཏེ་སྲིད་ན་བུམ་པ་ཁ་དོག་གི་ཆ་ནས་རྟག་ལ་དབྱིབས་ཀྱི་ཆ་ནས་མི་རྟག་པར་འདོད་པ་ཅིས་འགེགས།",
    "དོན་གྱི་རང་གི་ངོ་བོ་གཅིག།",
    "མཉན་བྱ་ནང་ཁྱབ་ཀྱི་ཚུལ་གྱིས་ཡང་དག་གི་རྟགས་སུ་ཐལ་བ་སྤང་བའོ།",
    "གཅིག་པོ་དེ་ཉིད་ཡུལ་ལ་རྒྱབ་ཀྱི་མེ་ལ་ལྟོས་ནས་དོན་སྤྱི་འཛིན་ལ་ཤེས་པ་རང་གི་ངོ་བོ་ལ་ལྟོས་ནས་དོན་སྤྱི་མི་འཛིན་པ་མི་འགལ་བ་བཞིན་དུ།",
    "ཡུལ་ལ་རྒྱབ་ཀྱི་མེ་ལ་ལྟོས་ནས་དོན་སྤྱི་འཛིན་པའི་རྫས་སུ་རིལ་གྱིས་སོང་གི་དོན་སྤྱི་མི་འཛིན་པའི་དྲི་ཙམ་ཡང་མེད་ལ།",
    "ཤེས་པ་རང་གི་ངོ་བོ་ལ་ལྟོས་ནས་དོན་སྤྱི་མི་འཛིན་པའི་རྫས་སུ་རིལ་གྱིས་སོང་གི་དོན་སྤྱི་འཛིན་པའི་དྲི་ཙམ་ཡང་མེད་དོ།",
    "མངོན་སུམ་མ་ཡིན་པའི་ཤེས་པ་ལོག་པ་ན་མི་རྟག་པའང་ལྡོག་པར་ཐལ་ལོ།",
    "ཤེས་པའི་རང་གི་ངོ་བོ་ལོག་པ་ན་རང་རིག་ལྡོག་པར་ཐལ་ལོ་ཞེ་ན།",
    "འོ་ན་ལུང་སྟོང་ན་སྔོན་པོ་དང་མི་རྟག་པ་མེད་པར་ཐལ་ལོ།",
    "མི་རྟག་པའི་དོན་རང་གི་མཚན་ཉིད་སྣང་བའི་མིག་ཤེས་མ་སྐྱེས་པས་དེ་ལ་ལྟོས་ནས་མི་རྟག་པ་མི་སྣང་བ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་སྔོན་པོ་དང་མི་རྟག་པ་སོ་སོ་ནས་སྣང་ན་དོན་རང་གི་མཚན་ཉིད་གཉིས་སུ་ཐལ་ལོ།",
    "འདིར་ཡང་སྔོན་པོ་དང་མི་རྟག་པའི་དོན་སྤྱི་རིམ་གྱིས་སྐྱེ་ན་དོན་སྤྱི་གཉིས་སུ་ཐལ་ལོ་ཞེ་ན།",
    "དོན་རང་གི་མཚན་ཉིད་གཉིས་སུ་ཐལ་འདོད་དུ་མི་རུང་སྟེ་ཐ་དད་ཀྱིས་སྟོང་པར་བསྒྲུབས་པས་སོ།",
    "ཡང་ན་རྒྱུ་ན་རེ་སྔོན་པོ་ངེས་ལ་མི་རྟག་པ་མ་ངེས་པ་མི་འགལ་ཏེ།",
    "སློབ་དཔོན་ཞི་བ་ལྷས་ཀྱང་རྒྱུ་དང་ཚོགས་ཞེས་བྱ་བ་ནི།",
    "རྡུལ་ཕྲན་ཕྲ་མོ་དོན་དམ་པའི་གཅིག་ཡིན་ཞིང་།",
    "དེ་ལྟར་ན་འདུས་བྱས་ཐམས་ཅད་སྐད་ཅིག་མ་ཡིན་པས་ཐོག་མ་དབུས་དང་ཐ་མའི་ཆ་གསུམ་གང་བྱུང་སར་ཀུན་རྫོབ་པའི་གཅིག་ཁེགས་པས་ཀུན་རྫོབ་ཙམ་དུའང་གཅིག་དང་དུ་མ་དང་བྲལ་བས་ཀུན་རྫོབ་ཙམ་དུའང་རང་བཞིན་མེད་པའི་ཕྱིར་ལ་སོགས་རྒྱང་ཕན་པ་བས་ཀྱང་ལྟ་བ་དམན་པར་ཐལ་ལོ་ཞེ་ན།",
    "དབྱེར་མེད་པའི་གཅིག་ཡིན་པའི་ཕྱིར་དོན་དམ་པའི་གཅིག་ཏུ་ཐལ་ལོ་ཞེ་ན།",
    "ཡོད་ན་གཞན་རིག་ཏུ་ཐལ་ལ།",
    "མེད་ན་དོན་དམ་པའི་གཅིག་ཏུ་ཐལ་ལོ།",
    "བཞི་པ་ནི་སྔོན་པོ་ལ་མི་སྣང་བ་ཁེགས་པ་ན་དེ་དང་རྫས་ཅིག་པའི་སྐད་ཅིག་གི་མི་རྟག་པ་མི་སྣང་བ་ཁེགས་སམ་མི་ཁེགས།",
    "ཁེགས་ན་སྣང་མི་སྣང་ཆ་གཉིས་འགོག་པའི་རྗེས་དཔག་དོན་མེད་དུ་ཐལ་ལ།",
    "དེས་ན་གོང་ཉིད་དུ་འགལ་ཁྱབ་དམིགས་པའི་རྟགས་མི་དགོས་པར་ཐལ་བ་འདོད་ཐོག་དུ་བྱས་ལ།",
    "དང་པོ་ལྟར་ན་སྣང་མི་སྣང་ཆ་གཉིས་འགོག་པའི་རྗེས་དཔག་དོན་མེད་དུ་ཐལ་ལོ།",
    "གཉིས་པ་ལྟར་ན་མཉན་བྱ་ལ་མི་རྟག་པས་ཁྱབ་པ་གྲུབ་ཀྱང་སྒྲ་ལ་མི་རྟག་པས་ཁྱབ་པ་མི་འགྲུབ་པས་མཉན་བྱ་ནང་ཁྱབ་ཀྱི་ཚུལ་གྱིས་ཡང་དག་གི་རྟགས་སུ་ཐལ་ལོ་ཞེ་ན།",
    "འདིར་ཡང་སྔོན་པོ་མི་སྣང་བ་ཁེགས་ལ་སྐད་ཅིག་གི་མི་རྟག་པ་ལ་མི་སྣང་བ་མ་ཁེགས་པའང་འགལ་ཏེ་སྔོན་པོ་དང་སྐད་ཅིག་གི་མི་རྟག་པ་བདག་གཅིག་པར་དྲན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལྟ་ན་སྔོན་པོ་ས་འཛིན་པའི་མངོན་སུམ་དེ་རྟོག་པར་ཐལ་ཏེ་འདས་པ་ལ་དམིགས་པའི་ཕྱིར་རོ།",
    "གནོད་བ་ཅན་གྱི་རྗེས་དཔག་རྟོག་པར་ཐལ་བ་ནི་འདོད་པ་ཉིད་དོ།",
    "རྟོག་མེད་ཡིན་པ་དང་དོན་རང་གི་མཚན་ཉིད་མི་སྣང་བའི་ཕྱིར་རིམ་པ་བཞིན་དུ་གཞན་སེལ་དང་བསྒྲུབ་པའི་སྒོ་ནས་འཇུག་པའང་མེད་དོ།",
    "ཕྱི་མ་ནི་ཐེ་ཚོམ་མོ།",
    "གཉིས་པ་ལ་ཡང་མངོན་འགྱུར་ལ་འཇུག་པ་དང་ལྐོག་གྱུར་ལ་འཇུག་པ་གཉིས་ལས་དང་པོ་ནི་མངོན་སུམ་མོ།",
    "དོན་རང་གི་མཚན་ཉིད་སྣང་ཞེས་པས་ནི་གཞན་བཞི་པོ་བཅད་དོ།",
    "རྒྱ་ན་རེ་སྒྲོ་འདོགས་དང་མི་འགལ་བའི་སྣང་བ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ་མངོན་སུམ་མ་ཡིན་པ་ལ་སྣང་ལ་མ་ངེས་པ་ཡོད་དམ་མེད་དཔྱད་པར་བྱའོ།",
    "དོན་རང་གི་མཚན་ཉིད་སྣང་བར་རང་གཞན་གྱི་རྟགས་ལ་རྟེན་པའི་རྗེས་དཔག་གིས་ངེས་སོ།",
    "དེ་ལ་གཡོར་གཉན་ན་རེ་རྗེས་དཔག་གི་རྒྱུན་ཡིན་པས་ཕྱིས་ཀྱི་བཅད་ཤེས་དེ་རྗེས་དཔག་ཡིན་ནོ་ཞེས་འདོད་པ་ནི་མི་རིགས་ཏེ།",
    "རང་གི་ལུགས་རྣམ་པར་གཞག་པ་དང་།",
    "དང་པོ་ནི་རྒྱ་ན་རེ་ཡིད་དཔྱོད་ཀྱི་མཚན་ཉིད་མྱོང་བ་དང་རྟག་ལ་མ་བརྟེན་པར་དོན་ངེས་ཙམ་ཡིན་ནོ་ཞེས་ཟེར་རོ།་",
    "དེ་ལྟ་ན་མྱོང་བ་ལ་མ་བརྟེན་པར་དོན་ངེས་ཙམ་ཡིད་དཔྱོད་ཀྱི་མཚན་ཉིད་ཡིན་པར་འདོད་པ་གང་གིས་འགོག།",
    "དེ་ལྟ་ན་རྗེས་དཔག་ཀྱང་ཡིད་དཔྱོད་དུ་ཐལ་ལོ་ཞེ་ན།",
    "སྔ་མ་ལྟར་ནའང་སྒྲ་རྟག་པར་འཛིན་པའི་ལོག་ཤེས་ཀྱང་ཡིད་དཔྱོད་དུ་ཐལ་ལོ།",
    "ལོག་ཤེས་དོན་མི་བདེན་པ་ཡུལ་དུ་བྱེད་པ་དང་ཡིད་དཔྱོད་དོན་བདེན་པ་ཡུལ་དུ་བྱེད་པ་གཉིས་ཀྱང་ཡིད་ཤེས་གཅིག་གི་ལྡོག་པ་གཅིག་ལ་འགལ་ལོ་ཞེས་ཕྱི་པ་ཟེར་ཏེ།",
    "ཡིད་དཔྱོད་ཀྱི་གོ་བ་བཞག་ན་སྔ་མ་ཡང་བསྐྱང་བར་ནུས་སོ་ཞེས་རེས་འགའ་གསུང་ངོ།",
    "རྒྱུ་ན་རེ་ཐེ་ཚོམ་ལ་གཞན་སེལ་མེད་དེ་ཐེ་ཚོམ་གྱིས་གང་ཡང་ཡོངས་སུ་མ་བཅད་པར་གང་ཡང་རྣམ་པར་མི་ཆོད་པས་སོ།",
    "དེ་ལ་ཕྱི་པ་ན་རེ་ཐེ་ཚོམ་ལ་གཞན་སེལ་ཡོད་དེ།",
    "ཡང་བོད་བགྲེས་པོ་ཁ་ཅིག་ན་རེ་མི་ཡིན་ནམ་ཐོ་ཡོར་ཡིན་ནམ་ཞེས་སེམས་པ་ན་བ་ལང་ལྟ་བུར་དོགས་པ་སེལ་བས་གཞན་སེལ་ཡོད་དོ་ཞེས་ཟེར་རོ།",
    "རྒྱུ་ན་རེ་དོན་ལ་ཕྱིན་ཅི་ལོག་ཏུ་ཡོངས་སུ་གཅོད་པ་ཞེས་བྱ་བ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ་གཅོད་པ་ཞེས་བྱ་བ་ངེས་ཤེས་འདྲེན་པ་ལ་ཟེར་ན་རྟོག་མེད་ལོག་ཤེས་ལ་མ་ཁྱབ་བོ།",
    "རི་བོང་གི་རྭ་དང་རི་བོང་གི་འགོ་ལྟ་བུ་གཅིག་པ་བཀག་པའི་ཐ་དད་ཀྱང་མ་ཡིན་ཏེ།",
    "འདི་ལ་ཉེས་པ་བཞི་ལས་དང་པོ་མི་སྲིད་པ་ནི་བུམ་པ་མཚན་གཞི་དོན་དམ་པའི་དངོས་པོ་རགས་པ་ཡན་ལག་ཅན་གྱི་རྫས་ཆ་མེད་དུ་མཚོན་མཚན་ཉིད་དུ་ཆེ་སྣ་ཚོགས་དང་བཅས་པ་བཀོད་པ་སྐྱོན་མེད་དུ་འདོད་པ་གང་གིས་བཟློག།",
    "གཉིས་པ་མཚོན་བྱ་བ་ལང་དངོས་མེད་ཀུན་བརྟགས་ཡིན་པའི་དམ་བཅའ་ལ་བསལ་བ་ནི་ཁྱོད་མཚོན་བྱ་དངོས་མེད་དུ་འདོད་པ་དེ་ཙམ་དུ་མཚན་ཉིད་ཀྱང་དངོས་མེད་དུ་འདོད་པ་གང་གིས་བཟློག།",
    "བ་ལང་ཡང་རང་རིག་གི་ཤུགས་ལ་བློ་བ་ལང་འཛིན་བྱེད་དུ་གྲུབ་པ་ན་ཡུལ་བ་ལང་གི་སྒྲས་ཞེན་རུང་གི་དངོས་པོར་གྲུབ་པས་བསལ་ལོ།",
    "རང་རིག་གི་ཤུགས་ལས་གྲུབ་པ་དེ་དངོས་པོར་ཡོད་ཀྱང་མཚོན་བྱ་མ་ཡིན་གྱི་མཚོན་བྱ་ནི་བ་ལང་གི་མིང་དངོས་མེད་ཀུན་བརྟགས་ཡིན་ནོ་ཞེ་ན།",
    "དོན་རིག་གིས་ནོག་དང་ལྐོག་ཤལ་མཐོང་བ་དེ་དངོས་པོར་ཡོད་ཀྱང་མཚན་ཉིད་མ་ཡིན་གྱི་ནོག་དང་ལྐོག་ཤལ་གྱི་དོན་སྤྱི་མཚན་ཉིད་ཡིན་ནོ།",
    "གསུམ་པ་མི་སྲིད་པ་འགའ་ཞིག་སྐྱོན་མེད་དུ་ཐལ་བ་ནི་བུམ་པ་མཚན་གཞི་དངོས་པོར་མཚོན་དོན་བྱེད་ནུས་པས་སྟོང་པ་མཚན་ཉིད་དུ་བཀོད་པ་ན་ལུགས་ཀྱིས་མཚོན་བྱ་དངོས་པོ་ལ་མཚན་ཉིད་དོན་བྱེད་པས་སྟོང་པ་མི་སྲིད་པ་ཡིན་པ་ལ་ཁྱེད་ལྟར་ན་སྐྱོན་མེད་དུ་ཐལ་ཏེ་མཚོན་བྱ་ཐམས་ཅད་དངོས་མེད་ཡིན་ལ་དེ་ལ་དོན་བྱེད་ནུས་པས་སྟོང་པ་སྲིད་པས་སོ།",
    "བཞི་པ་སྐྱོན་མེད་འགའ་ཞིག་མི་སྲིད་པར་ཐལ་བ་ནི་བུམ་པ་མཚན་གཞིར་བཞག་ནས་དངོས་པོར་མཚོན་པ་ལ་དོན་བྱེད་ནུས་པ་མཚན་ཉིད་དུ་བཀོད་པ་ན་སྐྱོན་མེད་ཡིན་པ་ལ་ཁྱེད་ལྟར་ན་སྐྱོན་ཅན་དུ་ཐལ་ཏེ་མཚོན་བྱ་ཐམས་ཅད་དངོས་མེད་ཡིན་པས་དེའི་དོན་བྱེད་ནུས་པ་མི་སྲིད་པས་སོ།",
    "ཡིན་ན་བ་ལང་གི་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་བཀོད་པ་མི་སྲིད་པར་འགྱུར་ཏེ།",
    "དཔེར་ན་བ་ལང་གི་མཚན་ཉིད་དུ་བ་ལང་བཀོད་ན་མི་སྲིད་པ་ཡིན་པ་བཞིན་ནོ།",
    "ཡང་བ་ལང་གི་མཚན་ཉིད་དུ་བ་ལང་བཀོད་ན་མཚན་ཉིད་སྐྱོན་མེད་དུ་འགྱུར་ཏེ།",
    "དཔེར་ན་བ་ལང་གི་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་བཀོད་ན་སྐྱོན་མེད་ཡིན་པ་བཞིན་ནོ།",
    "གལ་ཏེ་ཡིན་ན་བྱས་པའི་མཚན་ཉིད་ཀྱང་མི་རྟག་པར་འགྱུར་ལ་མི་རྟག་པའི་མཚན་ཀྱང་བྱས་པར་འགྱུར་བས་ཧ་ཅང་ཐལ་བ་དང་།",
    "ཡང་བ་ལང་གི་མཚན་ཉིད་ནོག་དང་ལྐོག་ཤལ་ཡིན་པ་ལྟར་ནོག་དང་ལྐོག་ཤལ་གྱི་མཚན་ཉིད་ཀྱང་བ་ལང་ཡིན་པར་འགྱུར་བས་ཕན་ཚུན་འཆོལ་བ་དང་།",
    "གཉིས་པ་ལྟར་ན་ནོག་དང་ལྐོག་ཤལ་དེ་དངོས་མེད་དུ་ཐལ་ལོ།",
    "དང་པོ་ལྟར་ན་བཏགས་ཡོད་དུ་ཐལ་ལོ།",
    "དེ་ལྟ་མ་ཡིན་པར་རྩོལ་བྱུང་གི་སྒྲ་ལ་རྩོལ་བྱུང་གི་ལྡོག་པ་ཆིག་རྐྱང་མི་རྟེན་པ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "འདོད་ན་ཀློག་དང་ནགས་ཀྱི་མེ་ཏོག་རྟག་པར་ཐལ་ཏེ་རྣམ་འཇོག་གི་རྒྱུ་རྩོལ་བྱུང་མེད་པའི་ཕྱིར་རོ།",
    "མཚན་ཉིད་ལོག་པའི་སར་མཚོན་བྱ་ལྡོག་པར་ཐལ་བ་ནི་འདོད་པ་ཡིན་པས་དེ་གཉིས་ཀ་ལ་མཚུངས།",
    "གཉིས་པ་མཚོན་བྱ་དང་མཚུངས་པའི་རྩོད་པ་སྤང་བ་ནི་བ་ལང་མཚན་གཞི་བ་ལང་དུ་མཚོན་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་བཀོད་པ་ཡང་སྐྱོན་མེད་དུ་ཐལ་ཏེ་དཔེར་ན་བ་ལང་དཀར་ཟལ་མཚན་གཞི་བ་ལང་དུ་མཚོན།",
    "སྔ་མ་ནི་བ་ལང་དཀར་ཟལ་ཞེས་པའི་ལྡོག་པ་གཉིས་ཚོགས་ལ་ལྡོག་པ་ཆིག་རྐྱང་གི་བ་ལང་རྟེན་པས་ཉེས་པ་དེས་མི་གནོད་དོ།",
    "དོན་བྱེད་ནུས་པའི་མ་ཡིན་དགག་བུམ་པ་སྣམ་བུ་ལ་སོགས་པ་ལྟ་བུ་གསུམ་དུ་ཕྱེ་ཡང་བཏུབ་མོད་ཀྱི།",
    "དེའང་མཚན་གཞི་བུམ་པ་ལ་སྲིད་པ་ཡིན་ཏེ་དེ་ལྟ་མ་ཡིན་ན་དཔྱད་བཟོད་པའི་དོན་བྱེད་ནུས་པར་ཐལ་ཏེ་དགག་པ་བཀག་པ་བསྒྲུབ་པ་ཡིན་པས་སོ།",
    "མི་རྟག་པ་དབྱེར་མེད་དུ་མེད་ན་བུམ་པའི་དངོས་པོ་རྟག་པར་ཐལ་ལོ་ཞེ་ན།",
    "དཔྱད་བཟོད་ཀྱིས་དོན་བྱེད་ནུས་པར་གྲུབ་པར་ཐལ་ལོ།",
    "དེས་ན་ཕུ་པ་ན་རེ་དཔྱད་བཟོད་པའི་དོན་བྱེད་ནུས་པས་སྟོང་པ་ནི་དོན་དམ་པའི་བདེན་པ་ཡིན་ལ།",
    "དེ་ལྟ་མ་ཡིན་པར་བདེན་པ་གཉིས་ངོ་བོ་གཅིག་ཡིན་ན་བུམ་པ་དེ་དངོས་པོའང་ཡིན་ལ་དོན་དམ་པའང་ཡིན་པས་དོན་དམ་པའི་དངོས་པོ་གྲུབ་པར་ཐལ་བ་ལ་སོགས་པའི་སྐྱོན་ཡོད་པས་སོ་ཞེས་གསུང་ངོ།",
    "དབྱེར་མེད་པ་ཙམ་གྱིས་བདག་གཅིག་པར་མི་འགྱུར་ཏེ་དེ་ལྟར་ན་ཤིང་མེད་པའི་ཕྱིར་ཤིང་ཤ་པ་མེད་ཅེས་པའི་ཁྱབ་བྱེད་མི་དམིགས་པའང་རང་བཞིན་གྱི་རྟགས་སུ་ཐལ་ཏེ་དབྱེར་མེད་པས་སོ།",
    "དེས་རྒྱུ་འབྲས་ཀྱི་འབྲེལ་པ་ངེས་པར་གཟུང་པར་མི་ནུས་པར་འབྲས་རྟགས་སུ་ཐལ་བའི་ཉེས་པ་མེད་དོ།",
    "དེའང་མཚན་གཞི་གཅིག་དང་དུ་བྲལ་ལ་སྲིད་པ་ཡིན་ཏེ་དེ་ལྟ་མ་ཡིན་ན་གཅིག་དང་དུ་བྲལ་ཡང་དག་གི་རྟགས་མ་ཡིན་པར་འགྱུར་བས་སོ།",
    "དེའང་དབྱེར་མེད་དུ་སྲིད་དགོས་ཏེ་དེ་ལྟ་མ་ཡིན་པར་ཚུལ་གསུམ་གཅིག་དང་དུ་བྲལ་ལ་དབྱེར་མེད་དུ་མི་སྲིད་ན་ཚུལ་གསུམ་དང་མི་ལྡན་པ་དབྱེར་མེད་དུ་སྲིད་དགོས་པས་ཡང་དག་གི་རྟགས་མ་ཡིན་པར་ཐལ་ལོ།་",
    "དང་པོ་ལ་བདུན་ལ་མཚན་ཉིད་གཏན་མི་དགོས་པར་ལོག་པར་རྟོག་པ་དགག་པ་ནི་བོད་བགྲེས་པོ་ཁ་ཅིག་ན་རེ་མཚན་ཉིད་ལ་མཚན་ཉིད་གཞན་མི་དགོས་ཏེ་ཐུག་པ་མེད་པར་འགྱུར་བས་སོ།",
    "འོ་ན་ཧེ་དུའི་ཐ་སྙད་དུ་བྱར་རུང་དེ་མཚོན་བྱ་མ་ཡིན་པར་ཐལ་ལོ་ཞེ་ན།",
    "མཚན་ཉིད་ཀྱི་ཐ་སྙད་དུ་བྱར་རུང་ཡང་མཚོན་བྱ་མ་ཡིན་པར་ཐལ་ལོ།",
    "འགལ་མ་ངེས་མ་གྲུབ་ཐམས་ཅད་ལས་ཐ་དད་དུ་ཕྱེ་ནས་ཧེ་དུའི་ཐ་སྙད་དུ་བྱར་རུང་ཞེས་བྱ་བ་ཐུན་མོང་མ་ཡིན་པའི་སྒྲ་བརྗོད་རུང་དུ་རང་རིག་གི་ཤུགས་ལ་གྲུབ་པས་བསལ་ལོ་ཞེ་ན།",
    "མ་ཁྱབ་ཁྱབ་ཆེས་མི་སྲིད་ལ་སོགས་པ་ལས་ཐ་དད་དུ་ཕྱེ་ནས་མཚན་ཉིད་ཀྱི་ཐ་སྙད་དུ་བྱར་རུང་ཞེས་བྱ་བ་ཐུན་མོང་མ་ཡིན་པའི་སྒྲས་བརྗོད་རུང་དུ་རང་རིག་གི་ཤུགས་ལ་གྲུབ་པས་བསལ་ལོ།",
    "དེ་ལ་ཕྱི་པ་ན་རེ་དེ་ནི་མི་འཐད་དེ།",
    "བཞི་པ་མཚན་ཉིད་སྨོས་པའི་དགོས་པའམ་རྣམ་གཅད་བསམ་པ་ནི་རིགས་མི་མཐུན་པ་དང་འགལ་ཞེས་པས་རིགས་མི་མཐུན་པ་དང་གཏན་མི་འགལ་བའི་ཁྱབ་ཆེས་བ་ལང་གི་མཚན་ཉིད་དུ་ཤེས་བྱ་བཀོད་པ་ལྟ་བུ་དང་།",
    "རིགས་མི་མཐུན་དང་གཏན་མི་འགལ་བའི་མི་སྲིད་པ་བ་ལང་གི་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་དང་མི་ལྡན་པ་བཀོད་པ་ལྟ་བུ་བཅད་དེ་དེ་གཉིས་རིགས་མི་མཐུན་པ་དང་བཏན་འགལ་བའི་ཕྱིར་རོ།",
    "རིགས་མི་མཐུན་གྱི་ཕྱོགས་གཅིག་ལ་ཡོད་པའི་མི་སྲིད་པ་བ་ལང་གི་མཚན་ཉིད་དུ་རྔ་རྔོག་དང་ལྡན་པ་བཀོད་པ་ལྟ་བུ་བཅད་དེ།",
    "བ་ལང་གི་མཚན་ཉིད་བ་ལང་ཡིན་ཞེས་པའི་ལྡོག་པ་ཐ་དད་མེད་ནས་མི་སྲིད་པ་སེལ་ཏོ།",
    "དེས་ན་བ་ལང་གི་རིགས་མི་མཐུན་པ་ལ་མ་ཡིན་པ་ཡིན་ལ།",
    "སྔོན་པོ་མངོན་འགྱུར་ཡིན་པའི་ཕྱིར་སྔོན་པོ་དེ་ཉིད་དཔག་མི་དགོས་པར་ཐལ་ལོ་ཞེས་པ་ནི་འདོད་ལ།",
    "སྔོན་པོ་མངོན་འགྱུར་ཡིན་པའི་ཕྱིར་སྔོན་པོའི་ཐ་སྙད་དུ་བྱར་རུང་རྟགས་ཀྱིས་དཔག་མི་དགོས་པར་ཐལ་ལོ་ཞེས་པ་ནི་ཁྱབ་པ་མ་གྲུབ་ཅིང་།",
    "སྔོན་པོའི་ཐ་སྙད་དུ་བྱར་རུང་མངོན་འགྱུར་ཡིན་པའི་ཕྱིར་དེ་རྟགས་ཀྱིས་བསྒྲུབ་མི་དགོས་པར་ཐལ་ལོ་ཞེས་པ་ནི་ཧེ་དུ་མ་གྲུབ་སྟེ་སྔོན་པོའི་མཚན་ཉིད་དུ་བྱར་རུང་རྨོངས་པ་ལ་ལྐོག་ཏུ་གྱུར་པས་སོ་ཞེ་ན།",
    "འདིར་ཡང་དེ་དང་མཚུངས་ཏེ་ནོག་དང་ལྐོག་ཤལ་རྫས་ཡོད་ཡིན་པའི་ཕྱིར་དེ་ལ་མཚན་ཉིད་དགོས་པར་ཐལ་ལོ་ཞེས་པ་ནི་འདོད་ལ།",
    "དང་པོ་ལྟར་ན་རྟ་མཚན་གཞི་བ་ལང་དུ་མཚོན་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་དང་ལྡན་པ་བཀོད་པ་ཡང་མི་སྲིད་པ་མ་ཡིན་པར་ཐལ་ཏེ་མཚན་གཞིར་བཀོད་པའི་རྟ་ལ་ནོག་དང་ལྐོག་ཤལ་མི་སྲིད་ཀྱང་མཚན་གཞི་ཡིན་པའི་དཀར་ཟལ་ལྟ་བུ་ལ་སྲིད་པས་སོ།",
    "དེའི་ལན་ནི་ཕུ་པ་ན་རེ་མཚན་གཞིར་བཀོད་པ་ལ་ལྡན་པ་ཡིན་ནོ།",
    "དེའི་རིགས་པས་སྒྲ་བྱས་པའི་ཕྱིར་མི་རྟག་ཅེས་པ་དེ་མཐུན་ཕྱོགས་ཐམས་ཅད་ལ་ཁྱབ་པའི་ཡང་དག་གི་རྟགས་ཡིན་པ་ལ་ཁྱེད་ལྟར་ན་མ་ཡིན་པར་ཐལ་ཏེ་སྒྲའི་སྟེང་གི་ཚུལ་གསུམ་བུམ་པ་ལ་མེད་པས་སོ།",
    "བདུན་པ་མཚན་ཉིད་ཐུག་པ་མེད་པར་ཐལ་བ་སྤང་པ་ནི་བ་ལང་ལ་ནོག་དང་ལྐོག་ཤལ་རྫས་ཡོད་དགོས་ལ་དེ་ལ་ཡང་མཚན་ཉིད་གཞན་དགོས་ན་མཚན་ཉིད་ཐུག་མེད་དུ་འགྱུར་རོ་ཞེ་ན།",
    "དང་པོ་ནི་མཚོན་བྱ་བ་ལང་དེ་བ་ལང་ཞེས་པའི་ཁ་ནང་ན་གྲུབ་པའི་སྒྲ་དང་བ་ལང་གི་སྒྲ་སྤྱི་མ་ཡིན་ཏེ་གཉིས་ཀ་ལ་མཚན་ཉིད་ནོག་དང་ལྐོག་ཤལ་དངོས་པོ་བ་མི་སྲིད་པས་སོ།",
    "བ་ལང་གི་སྒྲས་བརྗོད་རུང་ཡང་མ་ཡིན་ཏེ་དེ་ནི་བརྡའི་གྲགས་པའི་བསྒྲུབ་བྱ་ཡིན་པས་ཤེས་བྱ་ཐམས་ཅད་ལ་ཡོད་ལ་མཚན་ཉིད་ནོག་དང་ལྐོག་ཤལ་ནི་མེད་པས་མ་ཁྱབ་པར་འགྱུར་བས་སོ།",
    "འོ་ན་གང་ཡིན་ཞེ་ན་བ་ལང་མ་ཡིན་པ་ཐམས་ཅད་ལས་ཐ་དད་དུ་ཕྱེ་ནས་བ་ལང་ཞེས་བྱ་བའི་ཐུན་མོང་མ་ཡིན་པའི་སྒྲས་བརྗོད་དུ་རུང་བ་སྟེ།",
    "རྒྱ་ན་རེ་རང་ཉིད་ཐུན་མོང་མ་ཡིན་པར་བརྗོད་པའི་ཞེན་ཡུལ་དུ་གཞུག་ཏུ་རུང་བ་ཡིན་ནོ་ཞེས་ཀྱང་ཟེར་རོ།",
    "མཚོན་བྱ་གཅིག་ལ་མཚན་ཉིད་གཉིས་རུབ་པར་ཐལ་བ་སྤངས་པའོ།",
    "གཉིས་པ་ནི་མཚོན་བྱ་བ་ལང་གཅིག་ལ་མཚན་ཉིད་ནོག་དང་ལྐོག་ཤེལ་དང་གཞན་སེལ་ཕྱིན་ཅི་མ་ལོག་པ་སྒྲའི་རྣམ་པ་ཅན་གྱི་ཞེན་རུང་གཉིས་རུབ་པར་ཐལ་ལོ་ཞེ་ན།",
    "རང་གི་ལུགས་དང་གཞན་གྱི་ལུགས་དགག་པའོ།",
    "དང་པོ་ལ་མཚན་གཞིའི་མཚན་ཉིད་ནི་མཚན་ཉིད་དང་མཚོན་བྱ་ཟུང་ཅིག་གི་རྟེན་དུ་འདུག་པའོ།",
    "འོ་ན་མཚན་ཉིད་ཀྱི་རྟེན་དུ་འདུག་པ་ཞེས་པས་ཆོག་མོད་མཚོན་བྱའི་རྟེན་དུ་འདུག་པ་ཞེས་པ་སྨྲོས་ཅི་དགོས་ཞེ་ན།",
    "དེ་ལྟ་ན་མཚོན་བྱའང་མཚན་གཞིར་ཐལ་ཏེ་མཚན་ཉིད་ཀྱི་རྟེན་དུ་འདུག་པས་སོ།",
    "མཚན་གཞིར་ཐལ་བའི་སྐྱོན་ཡོད་པས་སོ།",
    "གཉིས་པ་ནི་མཚན་ཉིད་དང་མཚོན་བྱ་ཟུང་གཅིག་གི་རྟེན་དུ་འདུག་པ་མཚན་གཞིའི་མཚན་ཉིད་ཡིན་ན་རྟ་མཚན་གཞི་བ་ལང་དུ་མཚོན་མཚན་ཉིད་དུ་ནོག་དང་ལྐོག་ཤལ་བཀོད་པའི་ཚེ་མཚན་གཞི་རྟ་ལ་བ་ལང་དང་ནོག་དང་ལྐོག་ཤལ་གཉིས་ཀ་མི་རྟེན་པས་མཚན་གཞི་མ་ཡིན་པར་ཐལ་ལ།",
    "འདོད་ན་རྟ་ལ་ནོག་དང་ལྐོག་ཤལ་མི་སྲིད་པ་དེ་མཚན་གཞི་ལ་མི་སྲིད་པ་མ་ཡིན་པར་ཐལ་ཏེ་མཚན་གཞི་མ་ཡིན་པས་སོ་ཞེ་ན།",
    "འོ་ན་སྒྲ་མཉན་བྱ་མ་ཡིན་པར་དམ་བཅས་པ་དེ་དམ་བཅའ་མ་ཡིན་པར་ཐལ་ཏེ་མཚན་ཉིད་ཀྱི་གྲ་གཅིག་བསལ་བ་མེད་པ་མེད་པས་སོ།"
  ]
}