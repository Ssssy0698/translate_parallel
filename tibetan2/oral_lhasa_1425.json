    "ཀུན་མཁྱེན་མཁའ་ཀློང་ཡངས་པའི་དབྱིངས་སུ་བསྔོ།",
    "ཞེས་པས་ཡན་ལག་བདུན་པ་བྱས་ལ།",
    "ཚོམ་བུ་གཅིག་པ་སོགས་རྒྱུད་དང་དམ་པ་རྣམས་ཀྱི་བསྟན་བཅོས་ཁྱད་པར་ཅན་དག་ལས་བྱུང་བ་རྣམས་ལས་ཅི་རིགས་པ་དཀའ་ཚེགས་ངལ་དུབ་ཐམས་ཅད་ཁྱད་དུ་བསད་དེ་འབད་རྩོལ་དྲག་པོས་འབུལ།",
    "རབ་འབྱམས་མཁྱེན་བརྩེའི་གཏེར་ཆེན་ཁྱེད་ལ་འབུལ།",
    "དགྱེས་བཞིན་དགོངས་ཏེ་བརྩེ་བས་བཞེས་སུ་གསོལ།",
    "དཔལ་མཁྱེན་གཉིས་སྣང་བ་མཆོག་བསྩལ་ནས།",
    "ཟུང་འཇུག་རྒྱལ་ས་ཟིན་པར་བྱིན་གྱིས་རློབས།",
    "དེ་ལྟར་མཉམ་པར་བཞག་པ་ན་སེམས་དེ་འདས་པས་རྗེས་མ་གཅོད།",
    "ཅེས་བསྔོ་སྨོན་ཤིས་པས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "དེ་མཉེས་པས་ནི་ཀུན་མཁྱེན་གྱི།",
    "ཡེ་ཤེས་མཆོག་དེ་ཐོབ་པར་འགྱུར།",
    "ཚུལ་མ་ཡིན་པར་བསྟེན་པའི་ཉེས་དམིགས།",
    "ཇི་ལྟར་བསྟེན་པའི་ཚུལ་ལ་ལེགས་པར་བསླབ་པ་སོགས་གལ་ཆེ་སྟེ།",
    "སྔོན་མེད་ལེགས་བྱས་རྣལ་འབྱོར་ཨ་དར།",
    "ཉེ་ཆར་དྭངས་གསལ་རིན་ཆེན་ཤེལ་ཀྱི་ཡོལ་གོ་དྲི་མེད་དྭངས་བསིལ་ཚུ་རྒྱུན་གཙང་མའི་ལེགས་པར་བཀང་སྟེ་དྲི་བྲལ་སྲིད་དུ་རིང་བའི་ལྷ་རྫས་ཀྱིས་མཛེས་པར་བརྒྱན་ཏེ་ནན་གྱི་བསྐུལ་བའི་གཡར་ངོ་ལྡོག་མིན་ཙམ་དུ།",
    "ཞེས་ལན་གསུམ་གྱིས་སྐྱབས་སེམས་བྱས་ལ།",
    "ཞེས་སོགས་གུར་ལས་བྱུང་བའི་རྒྱུན་བཤགས་ལན་གསུམ་བྱ།",
    "སྲས་བཅས་རྒྱལ་བའི་མཁྱེན་རབ་ཚུར་གསུང་འབུམབསྡུས་ཏེ།",
    "བསྙེན་ཚད་འབུམ་ཕྲག་བརྒྱད་དུ་གསུངས་ཀྱང་།",
    "ཞེས་གསུངས་པའི་དགོངས་པ་ལྟར་གྲུབ་ན་ལེགས་སམ་སྙམ།",
    "མ་གྲུབ་ཀྱང་གཏམ་གཞན་གྱིས་བར་མ་ཆོད་པར་བཟླ།",
    "ལྕེའི་རྩ་བའི་དྷིཡིག་ཀྱང་མིད་པར་བསམ་ལ།",
    "ཅེས་རྩེ་གཅིག་ཏུ་བསམ་ལ་མཉམ་པར་བཞག།",
    "རྗེ་བཙུན་མཁྱེན་པའི་གཏེར་ལ་ལེགས་འབུལ་ན།",
    "བརྩེ་བས་བཞེས་ལ་ཤེས་རབ་མཆོག་སྩོལ་མཛོད།",
    "བསྟོད་པ་རྒྱས་པར་མཚན་༡། ཡང་དག་པར་བརྗོད་པ་དང་།",
    "ཁོ་བོས་བྱས་པའི་བསྟོད་པ་སོགས་ཅི་ལྟར་འོས་པས་གདངས་སྙན་དབྱངས་བཅས་བསྟོད་ལ།",
    "དུས་གསུམ་རྒྱལ་བའི་མཁྱེན་རབ་གཅིག་བསྡུས་སྐུ།",
    "མཁའ་ཁྱབ་འགྲོ་ཀུན་རིང་བོར་མི་ཐོགས་པར།",
    "གོ་འཕང་མཆོག་དེར་མྱུར་ཏུ་ཟླ་འགོད་པར་ཤོག།",
    "སྟོང་པའི་ངང་ལས་རིན་ཆེན་སྣོད་ཡངས་པར།",
    "མཁྱེན་རབ་ཤེས་བྱའི་ཡུལ་བའི་རྡོ་ལ་སྙོམས་འཇུག་ཅིང་།",
    "བདག་བློའི་གཏི་མུག་མུན་པ་མཐར་བྱས་ནས།",
    "མ་འབྱོར་བ་དང་ཉམས་པ་སོགས་ཀྱིས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "འདིར་ནི་རྟེན་དང་སོགས་ཀྱིས་བརྟན་བཞུགས་བྱ།",
    "ཅེས་བསྲུང་བ་བྱས་ཏེ་བསྔོ་སྨོན་བཀྲ་ཤིས་ཅི་། རིགས་པས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "བདུད་བགེགས་མི་མཐུན་ཚོགས་ཀུན་བསྲེག་པར་བསམ།",
    "ཅེས་པས་ངེས་པར་སེལ་ལོ།",
    "ཐ་། ། རྗེ་བཙུན་འཇམ་དབྱངས་དམར་སེར་གྱི་མངོན་རྟོགས་བསྡུས་པ་བློ་མཆོག་སྣང་བའི་སྒོ་འབྱེད་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "སྐྱབས་སེམས་སྤྱི་ལྟར་བྱས་ལ།",
    "རིན་ཆེན་རྒྱན་ཕྲེང་དུ་མས་མཛེས་པར་སྤྱད།",
    "ས་བོན་སྔགས་ལས་འོད་ཀྱིས་དོན་གཉིས་བྱས།",
    "མཁྱེན་རབ་ཡེ་ཤེས་སྣང་བ་མ་ལུས་པ།",
    "བརྒྱ་རྩ་ཙམ་དབུགས་ཐེངས་གཅིག་ཏུ་གྲུབ་པའམ་མ་གྲུབ་ཀྱང་གཏམ་གཞན་བའི་རྡོ་གྱིས་བར་མ་ཆོད་པར་བཟླས་ལ།",
    "དེ་ཡིས་ས་ལ་འགོད་པར་ཤོག་༧ ཅེས་རྗེ་བཙུན་འཇམ་དབྱངས་དམར་སེར་གྱི་མངོན་རྟོགས་བསྡུས་པ་བློ་མཆོག་སྣང་བའི་སྒོ་འབྱེད་ཅེས་བྱ་བ་འདི་ནི།",
    "འཇམ་དཔལ་གཞོན་ནུ་བསྒྲུབ་པར་བྱ།",
    "ཡོངས་གྱུར་རང་ཉིད་མཁྱེན་པའི་གཏེར།",
    "རྒྱན་ཕྲེང་དུ་མས་རྣམ་པར་སྤུད།",
    "གཟུངས་སྤོབས་ཤེས་རབ་མཁྱེན་པ་དང་།",
    "མཁྱེན་རབ་ཡེ་ཤེས་རྒྱས་པར་གྱུར།",
    "དྷིམཐར་སྔགས་ཕྲེང་འོད་ཀྱིས་དོན་གཉིས་བྱས།",
    "དབུགས་ཐོག་གཅིག་ལ་དྷིཋབརྒྱ་རྩའམ་མ་གྲུབ་ཀྱང་གཏམ་གཞན་གྱིས་བར་མ་ཆོད་པར་བཟླས་ལ།",
    "ཇི་ལྟ་ཇི་སྙེད་མཁྱེན་པའི་འོད་སྟོང་གཟིས།",
    "མཁྱེན་རབ་ཡེ་ཤེས་གཏེར་ཆེན་གྲོལ་བྱིན་རློབས།",
    "དེ་ཡིས་ས་ལ་འགོད་པར་ཤོག།",
    "དགེའོ། ། རྗེ་བཙུན་འཇམ་དཔལ་དབྱངས་ཀྱི་མངོན་རྟོགས་ཤིན་ཏུ་བསྡུས་པ་ཤེས་རབ་དཔལ་སྟེར་ཞེས་བྱ་བ་བཞུགས་སོ།"
  ]
}