    "གནས་དང་གནས་མིན་ཚུལ་བཞིན་འབྱེད་པར་འགྱུར།",
    "དེས་ན་མེད་པར་འཛིན་པའི་བློ་ཙམ་གྱིས།",
    "འཇིག་རྟེན་མཐུན་འཇུག་ཡིན་པར་ཐུབ་པས་གསུངས།",
    "འོག་མ་དག་ལས་གོང་མ་རིམ་པར་འཕགས།",
    "རྙེད་དཀའི་དུས་སུ་རྙེད་ལ་བརྩོན་པར་གྱིས།",
    "འགྱུར་མེད་རྟག་པར་གནས་པའི་བདག་ཉིད་ཅན།",
    "འདུས་བྱས་སྒྱུ་མའི་དཔེ་བཞིན་ཤེས་པར་བྱ།",
    "འཁོར་ལོ་རྣམ་པར་བརྩེགས་པ་ཞེས་བྱའོ།",
    "ལེགས་པར་བསྐོར་ཏེ་གཉའ་ཤིང་འཛིན་དང་ནི་ གཤོལ་མདའ་འཛིན་དང་སེང་ལྡེང་ཅན་ལྟ་སྡུག།",
    "ཆེ་ཆུང་གཙོ་བོའི་ཕྱེད་དུ་ཡོད་པར་ཆགས།",
    "འཁྲུལ་བའི་ལས་སྣང་སྣ་ཚོགས་ཡོད་པར་བཤད།",
    "ཁོང་སེང་ནང་ནས་རིམ་པར་སྒྲ་གཅན་དང་།",
    "གཉིས་པར་ཕྲེང་ཐོགས་གསུམ་ན་རྟག་མྱོས་གནས།",
    "བཞི་པར་རྒྱལ་ཆེན་རིགས་བཞིའི་ལྷ་གནས་ཏེ།",
    "རིམ་པར་འཐབ་བྲལ་དགའ་ལྡན་འཕྲུལ་དགའ་དང་།",
    "ཚེ་ལོ་གྲངས་མེད་ནས་བཟུང་མར་འགྲིབ་པར།",
    "བསམ་གཏན་ཐོབ་པ་དེ་སྒྲས་རྐྱེན་བྱས་ནས།",
    "བསམ་གཏན་གཉིས་པར་སྐྱེས་ཚེ་འདོད་ཁམས་སྟོང་།",
    "རིམ་པར་ཤར་བས་གླིང་བཞི་རི་རབ་ཀུན།",
    "རབ་ཏུ་བསྲེག་ཅིང་འབར་བས་རྐྱེན་བྱས་ནས།",
    "བསམ་གཏན་དང་པོའི་ཁང་སྟོང་བསྲེགས་པར་འགྱུར།",
    "གཉིས་པར་གནས་པ་དག་ཀྱང་གསུམ་པར་སྐྱེ།",
    "བསམ་གཏན་གཉིས་པ་མན་ཆད་ཞིག་པར་འགྱུར།",
    "དེ་ནས་ཁམས་སྟོང་གཉིས་པར་སྐྱེ་བའི་ཡུན།",
    "པར་གནས།",
    "ཚེ་ལོ་གྲངས་མེད་ཐུབ་ཅིང་དེ་མཐུན་པར།",
