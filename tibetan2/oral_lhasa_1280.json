    "ཐོབ་པའི་སྟོབས་ཀྱིས་དེ་ལས་མ་ཉམས་པར།",
    "ཟག་མེད་སྡོམ་པ་སྐྱེ་བ་མེད་པར་འདོད།",
    "སྐྱེ་བའི་གནས་ལ་ངེས་པ་མེད་པར་བཤད།",
    "དེ་ཚེ་སྔ་གཏོང་ཕྱི་མ་ཐོབ་པར་བཤད།",
    "སྡོམ་མིན་སྔོམ་སེམས་མེད་པར་ཤན་པ་སོགས།",
    "སྡོམ་པ་སྡོམ་མིན་གང་ཡང་མ་ཡིན་པར།",
    "དུས་ཀྱི་རྣམ་པར་རིག་བྱེད་ལས་ཡིན་ནོ།",
    "རྩ་ཉོན་དང་ནི་ཉེ་ཉོན་རྒྱས་པར་འགྱུར།",
    "ཟག་མེད་ལ་ནི་དམིགས་པར་བྱེད་པའོ།",
    "སེམས་དང་སེམས་བྱུང་མཚུངས་པར་ལྡན་གྱུར་ཏེ།",
    "མཚུངས་པར་མི་ལྡན་ལྷག་མ་གཞན་རྣམས་ལྡན།",
    "མཚུངས་པར་ལྡན་ལ་བསམ་གཏན་གསུམ་པར་བདེ།",
    "མཚུངས་པར་ལྡན་པ་འདོད་ཆགས་དང་འདྲའོ།",
    "ཆགས་སྡང་རྨོངས་གསུམ་འདོད་པར་ཚོགས་དྲུག་དང་།",
    "ཆགས་ཁྲོ་ང་རྒྱལ་འདོད་པར་དངོས་པོའི་ཕྱོགས།",
    "བདེན་བཞིར་ཁྱད་མེད་འཇུག་པར་འདོད་པ་ན།",
    "འདོད་པར་ཀུན་དང་བསམ་གཟུགས་བརྒྱད་པོ་ལ།",
    "འདོད་པར་ལྷག་པར་ཞེན་དང་ལྟ་བར་ཞེན།",
    "ཀུན་རྟོག་ལམ་ལ་དཀྲིས་པར་བྱེད་པ་ནི།",
    "རྩོད་པ་ལེགས་པར་མི་སྒྲུབ་ཚུལ་མིན་རྟོག།",
    "བཏང་སྙོམས་ལྔ་ལ་སྒྲིབ་བྱེད་འདོད་པར་འདུན།",
    "འདོད་འདུན་གནོད་སེམས་ལྔ་ཡི་གནོད་པར་སྦྱོར།",
    "འདི་སྤངས་པས་ནི་དགྲ་བཅོམ་ཐོབ་པར་བཤད།",
    "བསྡུ་ན་འཆིང་བ་གསུམ་དུ་འདུ་གསུངས་པས།",
    "ཟག་བཅས་རང་བཞིན་ཡིན་པར་ཤེས་པར་བྱ།",
    "ཐམས་ཅད་མཁྱེན་པ་མྱུར་དུ་ཐོབ་པར་གསུངས།",
    "ངེས་པར་བསམ་ནས་གཏན་གྱི་བདེ་བ་ཞིག།",
    "དམ་ཚིག་ཚུལ་བཞིན་བསྲུང་ཞིང་བག་ཡོད་པར།",
    "གཏན་བདེ་ཀུན་མཁྱེན་ཡེ་ཤེས་འདི་ཉིད་དོ།",
    "དེ་ལ་མ་རྟོགས་པ་དང་ལོག་པར་རྟོག།",
    "རིག་སྟོང་ཟུང་འཇུག་རང་བྱུང་འདུས་མ་བྱས།",
    "སྤང་བྱའི་སྐྱོན་མེད་གཞན་ཡང་སྨིན་པར་བྱེད།",
    "ལམ་གྱི་གཙོ་བོ་སེམས་བསྐྱེད་ཁྱད་པར་སྟེ།",
    "མཐར་འབྲས་གནས་སྐབས་འགོག་པར་གནས་པའོ།",
    "དེ་ལ་འབོགས་པའི་ཆོ་ག་ཡུལ་དག་པར།",
    "སྡོམ་པ་ལེན་པར་བྱ་ཞིང་དེ་ཡི་ཚུལ།",
    "གནོད་པར་མི་ནུས་གཉེན་པོས་ཟིན་པ་སྟེ།",
    "མཚན་ཉིད་ལམ་ལ་གོམས་པའི་ཁྱད་པར་གྱིས།",
    "འདི་ལ་མི་ཟད་བརྒྱད་ཅུ་ཞེས་ཀྱང་གསུངས།",
    "བརྒྱད་པར་སྟོབས་ལ་ཉེར་སྟོན་ཚོགས་གཉིས་དང་།",
    "བཅུ་པར་མངོན་ཤེས་དྲུག་ལ་མངའ་མཉེས་ཤིང་།",
    "རྣམ་པར་སྨིན་པའི་སེམས་བསྐྱེད་ཅེས་བྱ་ཞིང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ས་རུ་དེ་འགྲོ་བས།",
    "དེ་ལ་རྟོགས་དང་མ་རྟོགས་ཁྱད་པར་གྱིས།",
    "བདག་ཏུ་རྟོག་པས་བདག་ཕུང་ལོག་པར་འཛིན།",
    "རྒྱས་པར་དབྱེ་བ་སུམ་བརྒྱ་དྲུག་ཅུ་སྟེ།",
    "ཚུལ་མིན་ལྟ་ལ་ཞུགས་ཤིང་ལམ་ལོག་པར།",
    "ཁྱད་པར་ལྔ་དང་ལྡན་པའི་བདག་ཉིད་ལ།",
    "འདོད་ན་རང་བཞིན་འདུས་བྱས་ཉིད་དུ་གྱུར།",
    "ཆེན་པོ་ལ་སོགས་རིམ་པར་བསྐྱེད་གྱུར་ན།",
    "ཕྱི་ནས་ཡོད་པར་འགྱུར་སོགས་སྐྱོན་མང་དང་།",
    "སྤྱོད་ན་དེ་ཆ་བཅས་ཕྱིར་འདུས་བྱས་སོ།",
    "ནམ་མཁར་གནས་པར་འདོད་པ་ཡང་།",
    "དེ་དག་འབྲེལ་མེད་འདོད་པས་བྱས་པ་ཡིན།",
    "འདོད་ན་མི་རྟག་འདུས་བྱས་ཉིད་གྱུར་ཏེ་ རྟེན་དང་བརྟེན་པའི་རྟག་པ་མི་སྲིད་ལ།",
    "འགལ་བ་ཁོ་ནར་སྣང་བས་ཁེགས་པར་འགྱུར།",
    "ཐོབ་པར་མི་རུང་གཙོ་བོ་ཇི་བཞིན་ནོ།",
    "རྐུ་གསོད་སོགས་ཀྱིས་མཐོ་རིས་ཐོབ་པར་སྨྲ།",
    "རིག་བྱེད་སྐྱེས་བུས་མ་བྱས་མི་འཐད་དེ་ ངག་ཚིག་བརྗོད་པ་གཞན་དང་མཚུངས་པའི་ཕྱིར།",
    "རྟག་པར་ཡོད་པ་མི་འཐད་གཞི་མ་གྲུབ།",
    "དྲན་ནས་བྱས་ན་རྟག་པར་ཡོད་པར་འགལ།",
    "ཐམས་ཅད་མུན་པ་བཞིན་དུ་འཐུམ་པར་འགྱུར།",
    "རིག་བྱེད་མཐའ་བས་ཁྱད་པར་དགུ་ལྡན་གྱིས།",
    "རྟག་པ་གཅིག་པུ་ཤེས་པར་མི་རུང་ལ།",
    "སྲོག་དང་ཟག་པ་སྡོམ་པ་ངེས་པར་རྒས།",
    "ངོ་བོ་ཉིད་རྒྱུར་འདོད་པས་ཆད་པར་ལྟ།",
    "རྗེས་སུ་དཔོག་པར་མི་རུང་དེ་ཕྱིར་རོ།",
    "དེ་ལྟའི་ལོག་པར་རྟོག་པའི་སྐྱེ་བོ་རྣམས།",
    "དགྲ་བཅོམ་པ་ནི་མཐར་ཐུག་ཡིན་པར་སྨྲ།",
    "རིག་བྱ་རིག་བྱེད་མེད་པས་དོན་དམ་པར།",
    "བུམ་སོགས་ཐོ་བས་བཅོམ་མེད་རྟག་པར་འགྱུར།",
    "འདུས་མ་བྱས་རྣམས་དགག་བྱ་མེད་པའི་ཆར།",
    "དེ་ཕྱིར་རྟག་དང་མི་རྟག་བརྗོད་མེད་པར།",
    "མ་འཕྲད་པར་རྩོམ་བར་དང་བཅས་པའི་ཕྱིར།",
    "རྣམ་དབྱེ་འཐད་པར་དཀའ་ལ་དེ་བཞིན་དུ།",
    "ཕྱི་དོན་བདེན་པར་གྲུབ་པ་མི་སྲིད་དོ།",
    "འོ་ན་སྐད་ཅིག་སྔ་ཕྱི་མ་འཕྲད་པར།",
    "རྫ་ས་སུ་གྲུབ་པར་གསུངས་པ་མ་ཡིན་དགེ་རྩེ་འགྱུར་མེད་བསྟན་པ་རྣམ་རྒྱལ་གྱི་གསུང་འབུམ།",
    "ཆ་མེད་ཙམ་ལ་བདེན་པར་འཛིན་པའི་ཕྱིར།",
    "འོན་ཀྱང་ཕུང་པོར་འཛིན་པའི་བདག་སྟོང་པར།",
    "དེ་ཙམ་ཐོབ་ཀྱང་རྫོགས་པར་རྟོགས་མིན་ཏེ།",
    "ཤེས་པ་ཉིད་དུ་བདེན་པར་ཡོད་ཅེ་ན།",
    "གསལ་རིག་རྟགས་ཀྱིས་དོན་ཤེས་པར་མི་འགྲུབ།",
    "ཕྱི་དོན་རྫུན་པར་གྲུབ་ཀྱང་བདེན་ཤེས་དང་།",
    "གཅིག་པར་མི་གྲུབ་གཟུགས་བརྙན་བྱད་ཡིན་པ།",
    "སྔ་མ་བརྗོད་པའི་དམ་བཅའ་འཇིག་པར་འགྱུར།",
    "དོན་དམ་པར་ན་མེད་མཉམ་ཤེས་པར་གྱིས།",
    "བདེན་ན་དེ་ལྟར་དོན་དུའང་གྲུབ་པར་འགྱུར།",
    "ཅིག་ཅར་གཅིག་ལ་སྲིད་པར་གྱུར་བ་སོགས།",
    "དེ་སྙེད་ཡོད་པར་སྨྲ་ན་ཁྲ་མཐོང་སོགས།",
    "གཟུགས་ལ་སོགས་ཀྱང་དངོས་པོ་གྲུབ་པར་འགྱུར།",
    "འདོད་པ་དེ་ཡང་འདི་ཡིས་ཁེགས་པར་འགྱུར།",
    "གཉུག་མའི་ཤེས་ཞེས་བདེན་པར་གྲུབ་ཅེ་ན།",
    "དོན་བྱེད་པར་སྣང་དེ་ལ་བདེན་པའི་ཕྱིར།",
    "གཞལ་བྱ་ཡིན་ན་རྣམ་པར་སྣང་དགོས་ལ།",
    "གྲུབ་པར་མི་འགྱུར་གཉིས་ཀ་བཏགས་པ་ཙམ།",
    "མཉམ་པ་ཉིད་ལ་ཚུལ་བཞིན་གནས་པར་གྱིས།",
    "ངོ་བོ་བདེན་པར་གྲུབ་པས་སྟོང་བཞིན་དུ།",
    "ཟབ་ཞི་སྤྲོས་བྲལ་རང་བཞིན་འོད་གསལ་བ་ མཉམ་བཞག་རྣམ་པར་མི་རྟོག་ཡེ་ཤེས་ཡུལ།",
    "སྒྲིབ་པའི་དྲི་མ་དྲུང་ནས་འབྱིན་པར་བྱེད།",
    "ཀུན་ཤེས་ཐམས་ཅད་མཁྱེན་ལ་སྒྲིབ་པའོ།",
    "ཞུགས་ཀྱང་འཁོར་གསུམ་རྣམ་པར་རྟོག་པ་ཡིས།",
    "རྒྱལ་སྲས་རྣམས་ཀྱིས་རིམ་པར་སྤྲང་གྱུར་ཀྱང་།",
    "སྒྲིབ་བྲལ་ཀུན་མཁྱེན་ཡེ་ཤེས་མངོན་དུ་བྱེད།",
    "རྒྱལ་བས་སྟོང་པ་ཉིད་གང་གསུངས་པ་ཀུན།",
    "ལྟ་ཀུན་ངེས་པར་འབྱིན་པར་བྱ་བའི་ཕྱིར།",
    "མནར་མེད་པར་ནི་སྤྱི་ཚུགས་འགྲོ་ཞེས་གསུངས།",
    "ངེས་པར་གྲོལ་བ་རྟོགས་པའི་དེ་ཁོ་ན།",
    "འགྲོ་བ་མ་ལུས་བཀང་ཞིང་སྟོན་པར་མཛད།",
    "འབྲས་བུ་ཡེ་ཤེས་དམ་པར་གནས་གྱུར་པ།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་གཅིག་བསྡུས་བསམ་མི་ཁྱབ།",
    "རང་ཡིད་མི་འཕྲོག་པར་བྱེད་ཁྱད་པར་རོ།",
    "སྟོབས་ནི་གནས་དང་གནས་མིན་མཁྱེན་པ་དང་།",
    "འཆི་འཕོ་སྐྱེ་བ་ཟག་ཟད་མཁྱེན་པའི་སྟོབས།",
    "བདུད་བཞི་བཅོམ་ཕྱིར་རྡོ་རྗེ་ལྟ་བུར་གསུངས།",
    "ཕུན་ཚོགས་ཞལ་གྱིས་བཞེས་ལ་མི་འཇིགས་པ།",
    "ཐུགས་རྗེ་ཆེན་པོས་འགྲོ་ལ་ཕན་པར་མཛད།",
    "མངོན་སུམ་མཁྱེན་པ་རང་བྱུང་ཡེ་ཤེས་ཏེ།",
    "མཁྱེན་པའི་ཡོན་ཏན་ཐམས་ཅད་བསྡུས་པས་ན།",
    "ལོངས་སྤྱོད་ཆེན་པོའི་རྣམ་པར་རྟག་བཞུགས་པ།",
    "གསུངས་དབྱངས་ཡན་ལག་དྲུག་དགེ་རྩེ་འགྱུར་མེད་བསྟན་པ་རྣམ་རྒྱལ་གྱི་གསུང་འབུམ།",
    "གདུལ་བྱའི་རྒྱུད་ཀུན་སིམ་པར་བྱེད་པ་གསུམ།",
    "སྟབས་ཀྱིས་གཤེགས་དང་གཡས་ཕྱོགས་མཛེས་པར་གཤེགས།",
    "དྲང་དང་འཁྲིལ་བག་ཆགས་དང་རིམ་པར་འཚམས།",
    "བྱི་དོར་བྱས་འདྲ་གཙང་འཇམ་དག་པའི་སྐུ།",
    "གོམ་སྙོམས་པ་དང་སྤྱན་གཉིས་རྣམ་པར་དག།",
    "ཤིན་ཏུ་གྲིམ་དང་ཡན་ལག་རྣམ་པར་དབྱེ།",
    "ཀུན་ནས་བལྟ་ན་སྡུག་དང་ཀུན་སྤྱོད་གཙང་།",
    "དཔྲལ་བ་ལེགས་པར་འབྱེས་དང་དབྱེས་ཆེ་བ།",
    "སྐེས་བུའི་ཡིད་ནི་འཕྲོག་པར་བྱེད་པ་དང་།",
    "བདུད་རྩིའི་གསུངས་དབྱངས་རྒྱ་ཆེན་རྟག་ཏུ་འབྱུང་།",
    "ཐོགས་པ་མེད་པར་སྟོན་ལ་མངའ་བརྙེས་པ་ ཏིང་འཛིན་གཟུགས་སོགས་དཔག་མེད་དང་ལྡན་པས།",
    "ཇི་ལྟར་མཁྱེན་པའི་ཡེ་ཤེས་རྨོངས་པ་མེད།",
    "དེ་ལྟར་ཇི་ལྟ་ཇི་སྙེད་མཁྱེན་པ་ཡི།",
    "ཇི་བཞིན་བཀྲལ་ལ་བློ་གྲོས་མི་རྨོངས་པར།",
    "ཡང་དག་ཐར་བའི་སྣང་བ་རྒྱས་པར་འགྱུར།",
    "འདི་བྱས་རྙེད་བཀུར་གྲགས་འདོད་མ་ཡིན་ཞིང་།",
    "མཁྱེན་རབ་བདག་པོའི་གོ་འཕང་འགྲུབ་གྱུར་ཅིག།"
  ]
}