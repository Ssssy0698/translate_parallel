    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེདང་ལྡན་པ་ཀུན་དགའབོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་གལ་འདུག།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་འདས་པའི་དུས་ན་བྲེགས་ཤིག་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ཏེ།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་འདས་པའི་དུས་ནརི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་ཤིང་རྟ་སྤྱོད་པ་ཞིག་འདུག་པ་དེལ་བ་དགའ་བྱེད་དང་ས་རིཞེས་བྱབ་གཉིས་ཤིག་ཡོདཔ་དེ་གཉིས་ལས་དཔྱིད་ཀྱི་ཟླ་བལ་བེའུ་ཁྲ་བོདང་།",
    "ཀྱི་རྒྱལ་པོ་སེང་གེ་དེ་ལ་ཝ་རྒན་པོ་རབ་ཏུ་བརྐམ་པ་ལྷག་མ་ཟ་བ་ཞིག་འཁོར་ཞིང་ཕྱི་བཞིན་ཕྱི་བཞིན་རྗེས་སུ་འབྲང་ནས་སེང་གེ་དེས་རི་དགས་ད་དག་ཟོས་ཤིང་ཁྲག་དམ་པ་དག་འཐུངས་པག་ཚབམེདཔར་དེན་འདུག་པས་ཕྱོགས་དེར་།",
    "ཇི་ཙམ་ན་ཁྱུ་མཆོག་དང་ལྷན་ཅིག་རྩེ་ཞིང་འདུག་པ་མཐོང་ནས་དེས་བསམས་པ།",
    "ཁྱེད་རང་ཅིའི་ཕྱིརམི་བྱེད།",
    "མཐའགཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ལྷ་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཕྲན་གྱིས་ཀྱང་རང་འཁྲིའི་འགན་དུ་བསམས་ཏེ་ཐེངས་འདིར་རྒྱལ་ཚབ་གྲགས་པ་དོན་གྲུབ་ཀྱི་ལམ་སྒྲོན་འགྲེལ་བ་པར་སྐྲུན་བྱ་བའི་ལས་ཀར་ཞུགས་པ་ཡིན།",
    "ཡིན་ནའང་དུས་ཀྱི་འཕེལ་འགྲིབ་ལ་བརྟེན་ནས་དཔེ་རྒྱུན་ཙམ་ཡང་མཐོང་དཀོན་པའི་ཚད་དུ་བསླེབས་འདུག་པ་མྱུར་སྐྱོབ་དང་།",
    "ཞེས་ཡོད་པ་བཞིན་འདིར་ཡང་འདུག་པ་དང་།",
    "དེ་ནས་བརྩོན་འགྲུས་ཀྱང་བླ་ལྷག་ཏུ་ཆེ་བས་བཅོམ་ལྡན་འདས་བྱམས་པ་བསྐལ་པ་བཅུ་གཉིས་ཀྱིས་ཐུགས་བསྐྱེད་པ་སྔ་བ་ལགས་པར་གདའ།",
    "ཁྱེད་ཀྱིས་བདུད་རྩི་བརྙེས་ཙ་ན་བདག་ཅག་རྣམས་ལ་ཡང་བགོ་བར་ཞུ་བྱས་པའི་ལན་དུ་ང་ལ་གནོད་པ་ཡིན་ན་མི་བཟོད་པ་ཡིན་པ་ལས།",
    "མ་དྲོས་པ་ད་ལྟ་མ་ཕམ་དུ་གྲགས་པ་དེ་ཡིན་པར་གདའ།",
    "རྟགས་ཙམ་འཛིན་པའི་དུས་ལ་གཅིག་ལགས་པར་གདའ་བ་ལས།",
    "འོ་སྐོལ་བོད་ལ་སྒྲུབ་པའི་ཕྱི་ཐ་ལ་གདོད་བྱུང་བ་ལགས་པར་གདའ་སྟེ།",
    "དེ་ཀུན་ཡང་རང་ཅག་ལ་ཡིད་ཆེས་པ་བསྐྱེད་པའི་ཐབས་ཁོ་ན་ཡིན།",
    "དེ་ཙམ་གྱི་དུས་ན་ཏ་ལྷ་མི་ཉིད་དུ་འདུག་པའི་སྦ་མང་པོ།",
    "རྒྱལ་པོ་མེས་དབོན་གསུམ་པོ་འདི་བཅོམ་ལྡན་འདས་རིགས་གསུམ་མགོན་པོའི་སྤྲུལ་པ་ཡིན་པར་གདའ་སྟེ།",
    "དུས་དེ་ཙ་ན་དབུས་པ་ཉིད་ཀྱི་གཡོ་དགེ་འབྱུང་ལ་སོགས་པའི་དགེ་སློང་གཉིས་གསུམ་ཁམས་སུ་བྱོན་པ་ལ་བླ་ཆེན་པོས་སྡོམ་པ་བཞེས་བྱ་བ་ཡང་ཟེར།",
    "ཕྱིས་དགེ་གོང་དུ་ལན་གཅིག་དེ་ལྟར་མངའ་རིས་སྟོད་དང་དབུས་གཙང་འདིར་རབ་ཏུ་བྱུང་བ་ལྕིབས་ཀྱིས་བྱུང་བ་ལགས་པར་གདའ།",
    "ཇོ་བོ་སྤྱན་དྲངས་ནས་བྱོན་པ་ལགས་པར་གདའ།",
    "སྟོན་པས་བོད་ཀྱི་རབ་ཏུ་བྱུང་བ་ཅི་ཙུག་གདའ་ཞུས་པས་ཨ་ཝ་དྷཱ་ཏིས་འབྲིང་པོ་ཙམ་གསུངས།",
    "འདི་ལ་འགྲེལ་བ་གཅིག་ཁོ་ན་ཡོད་ན་བྱས་ཀྱིན་ཡིད་སྨོན་དང་བྱས་ཙ་ན་འདིའི་འགྲེལ་བ་ཁོ་ན་ད་ལྟ་ང་ཡིན་གསུངས་སྐད་དེ།",
    "ཁོའི་དེ་ད་ཡག་པར་བྱུང་གདའ་སྟེ།",
    "རྒྱ་གར་དུ་གསེར་སྐྱིལ་དུ་ལན་གསུམ་གྱི་བར་བྱོན་པ་ལགས་པར་གདའ།",
    "འདི་བཞིན་དུ་བྱས་ན་འདི་ཀུན་མཉེས་ནས་ང་ལ་མན་ངག་གནང་སྟེ་འོང་སྙམ་པའི་རྟོག་པ་རང་ཡང་སྐད་ཅིག་ཀྱང་སྐྱེ་མ་མྱོང་བ་ལགས་པར་གདའ།",
    "ནུས་པ་ཡང་མི་ཉམས་པར་འོང་བ་ལགས་པར་གདའ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཁོ་རང་དམའ་ས་ན་བསྡད་ནས་མཛད།",
    "དེའི་འོག་མ་ལ་ཁོང་རིང་བཞུགས་པ་ལ་ཁྱེད་དེར་མ་འདུག་མི་གཞན་ཡོད་བྱས་པས་ཁོ་ཤེད།",
    "རྒྱ་ནག་ཀྱང་རང་བཟོ་དང་བསྣོན་འདེབས་ལ་དགའ་ཞིང་ལན་གཉིས་སུ་ལྡབ་རྒྱང་དུ་བསྒྱུར་བ་ཡིན་པས་ཁུངས་མི་བཙུན།",
    "ཞབས་སུ་ཞུས་རྒྱ་དང་རྒྱལ་པོའི་མཐེབ་རྒྱས་ཀྱང་བཏབ་ནས་བཞུགས་པ་ལགས་པར་གདའ་སྟེ།",
    "ཀློག་པའི་སློབ་དཔོན་ཡང་རིགས་པ་གླེགས་བམ་ལས་བླངས་པ་དང་དཔོན་སློབ་དམ་ཚིག་ཉམས་ཤིང་རང་སྒྲུབ་པ་དང་བྲལ་བ་ལ་མཉན་པས་ཉེས་དམིགས་ལས་དངོས་སུ་ཕན་ཡོན་མི་ཡོང་བས།",
    "སྔོན་ཙ་ན་རྗེ་བློན་ལོ་ཙཱ་ཤེས་པ་ཉིད་ཀྱང་ཉི་ཤུ་རྩ་བགྲངས་པ་ཡོད།",
    "དེ་བཞིན་དུ་ཡིན་པས་ཁྱིམ་པ་ཀུན་གྱིས་ཇོ་བོའི་རུང་ཆུ་འདི་ལ་ཡོང་བཏང་བ་ཙམ་མི་གདའ་བྱས་པ་ཙམ་གྱིས་ཀྱང་དེ་དང་དུ་བླངས་ནས་ལྷོད་ལྷོད་མི་གཏང་།",
    "དཀྱིལ་འཁོར་གཅིག་ཏུ་དུས་གཅིག་ཏུ་ཞུགས་པ་གཉིས་ལ་རྒྱུད་དམ་སྒྲུབ་ཐབས་གཅིག་ཉིད་འཆད་ཀྱང་སོ་སོར་འཆད་དགོས་པ་ཡིན་གསུང་བར་གདའ།",
    "ཇོ་བོ་སྟོན་པས་བག་མེད་པ་ཆེན་པོ་བྱས་གསུངས་ཙ་ན།",
    "དུས་དེ་ཉིད་དུ་སྦྲ་གས་པ་ལ་སོགས་པའི་བཀྲ་མི་ཤིས་པ་བྱུང་བ་ལགས་པར་གདའ།",
    "དེ་ཀུན་ཏུ་བཞུད་ཙ་ན་ཡང་ད་ལྟ་གསང་ཕུ་ན་བཞུགས་པའི་མཆོད་རྟེན་དེ་སྤྱན་དྲངས་ནས་བཞུད།",
    "ལྷུང་བཟེད་ཀྱང་དཀར་པོ་ཞིག་གདའ་མཆི།",
    "དེ་བཞིན་དུ་དེ་ཙ་ན་བོད་ཐམས་ཅད་ལྷ་བཙུན་པ་ལ་ཡིད་ཆེས་པའི་གནས་སུ་བྱེད་པས་དེས་གསོལ་བ་བཏབ་ནས་བརྩམས་པས་བོད་ཐམས་ཅད་ཀྱི་ཡིད་རྟོན་པའི་གནས་སུ་གྲུབ་པར་བྱ་བའི་མན་ངག་ཏུ་གྱུར་པ་ཡིན།",
    "རྡོ་རྗེའི་གླུ་དང་སྤྱོད་པའི་གླུ་ལ་སོགས་པ་ཀུན་ཡང་དེ་ཙ་ན་མཛད་པར་གདའ།",
    "དུས་དེ་ཙ་ན་དེ་ལ་རིག་པས་སུན་འབྱིན་ནུས་པ་ནི་ཡེ་མེད་གསུངས།",
    "དེ་གཉིས་ལའང་ཁྱད་དེ་ཙམ་འདུག་གསུང་སྐད།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ཐོབ་པ་ལགས་པར་གདའ།",
    "ཕྱི་ནས་ཇོ་བོ་རྣལ་འབྱོར་པ་དེ་དང་ནམ་མཇལ་བར་བཞེད་ཙ་ན་ཁོ་བོ་འདི་ན་མཆིས་གསུང་ཡིན་འབྱོན་པ་ལ།",
    "ཇོ་བོ་ནི་དེ་ཙུག་ཏུ་མི་འདུག་པས།",
    "གནས་བརྟན་པ་དང་མང་པོས་བཀུར་བ་ཀུན་ཡང་ཇོ་བོ་ལ་ལུང་ལེན་པ་ལགས་པར་གདའ།",
    "མཁས་པ་ཡིན་རུང་མི་སྒྲུབ་པ་ཡང་ཡོང་བ་ལ་ཇོ་བོ་དེ་ཙུག་ཏུ་མི་འདུག་པས།",
    "ཇོ་བོ་དེ་ཙུག་ཏུ་མི་འདུག་པས།",
    "རྗེ་བཙུན་བྱམས་པ་ལ་གསོལ་བ་བཏབ་པས་སྐུའི་སྣང་བ་བྱུང་ཙ་ན་དྲག་ནས་ཡོང་བ་ལ།",
    "དང་པོ་ཙ་ན་གཙང་དུ་ཕྱིན་ལ་སྔགས་ཤིག་བསླབ་སྙམ་པ་ཞིག་ཡོད་པ་ལ།",
    "དེ་ཡང་རང་ཉིད་བདེ་བ་དེ་ལྟ་བུ་ལ་སྤྱོད་འདོད་ཀྱི་བསམ་པས་དོན་དུ་གཉེར་བར་བྱེད་པ་དེ་ནི་སྐྱེས་བུའི་གནས་སྐབས་གསུམ་ལས་སྐྱེས་བུ་ཆུང་ངུའམ་ཐ་མར་ཤེས་པར་བྱ་ཞེས་པ་སྟེ།",
    "སྐྱེས་བུ་ཆུང་ངུ་སྐད་པར་མིང་བཏགས་པ་དེ་རྒྱུ་འབྲས་ལ་ཡིད་ཆེས་པ་ཞིག་ལ་གསུང་བར་གདའ་སྟེ།",
    "འཆི་ཙ་ན་མེད་དེ་མི་ཆ་སྐྱེ་དགོས།",
    "འཆི་བའི་དུས་དེ་ཙ་ན།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "ཤི་ཙ་ན་ཕུང་པོ་འདི་ཡང་།",
    "ཉི་གཡོག་རང་དཀར་དུ་མར་ལ་འགྲོ་ཙ་ན་ཡང་།",
    "ཡར་ལོག་ཙ་ན་ཡང་ཆར་བ་བབ་པས་ཐིགས་པ་བྱུང་བ་གཅོད་ཚགས་ཀྱང་མི་མཛད་པར་འབོལ་སྟན་དྲིལ།",
    "དེ་ལ་སྒུར་བརྟེན་མཛད་ནས་ད་ཅིག་ཁོ་ན་སྐད་གསུང་ཡིན་བཞུགས་པར་གདའ།",
    "པུ་ཏོ་བ་ཉན་པོ་ན་བཞུགས་ཙ་ན།",
    "སྨད་གཤོག་ཙ་ན་སྟོད་སོས།",
    "སྟོད་གཤོག་ཙ་ན་སྨད་སོས་ནས་ཡོང་བ་ལ་རྟག་ཏུ་དྲ་གཤགས་བྱེད་པས་སྡུག་བསྔལ།",
    "གྲོངས་ལ་འོབས་སམ་ལྕགས་རི་བཞི་རིམ་གྱིས་བསྐོར་ནས་ཡོད་པ་བཞིན་དུ་ཡོད་པར་གདའ།",
    "པདྨ་ཆེན་པོ་ལྟར་གས་པ་ཀུན་ལ་ཡང་རང་མིང་དང་མཐུན་པའི་སྡུག་བསྔལ་གྱི་རྣམ་པ་གྲང་དམྱལ་གྱི་གནས་དེ་དག་ན་གོས་དང་ཁང་པ་དང་།",
    "བགྱི་བ་གསུངས་པས་ཚེ་ཡང་ཤིན་ཏུ་རིང་བ་ལགས་པར་གདའ་ན།",
    "དེ་ཡང་རྒྱལ་བུ་འཕགས་སྐྱེས་པོས་ཤཱཀྱ་རྣམས་ལ་བཀྱོན་ཕབ་ནས་ཁ་བཏགས་ཙ་ན།",
    "ནམ་ཞིག་ཏུ་ལྟོ་བར་ཕྱིན་ཙ་ན་འགྲངས་པའི་བྱ་བ་མི་བྱེད་ཀྱི་ཁར་ལུས་ཀྱི་རྒྱུ་ལྟོ་བསྲེག་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་མྱོང་བ་ཡོད་ཅིང་།",
    "དུད་འགྲོ་ཁ་འཐོར་བ་སྐད་པ་འདོད་ལྷའི་གནས་ན་ཡོད་པ་དང་མི་དང་འགྲོགས་པ་འདི་ཀུན་ལགས་པར་གདའ་སྟེ།",
    "ལས་ཚུལ་བསམ་གྱིས་མི་ཁྱབ་པར་འདུག་པས།",
    "གཏམ་རྒྱུད་འདི་ཇོ་བོའི་བཀའ་ལུང་ལགས་པར་གདའ།",
    "གཉིས་ཀར་འདུག་པའི་མཁན་སློབ་ལ་སོགས་པ་ལ་བརྟེན་པ་ཐམས་ཅད་ཆེན་པོར་གསུངས་ཏེ།",
    "ཞེས་པའི་ཚུལ་གྱིས་རང་བཞིན་སྐྱེ་མེད་དུ་གནས་པ་ལ་དོན་དམ་པའི་བདེན་པ་ཞེས་བྱ་སྟེ་བདེན་པ་གཉིས་ཀྱང་རྒྱུ་འབྲས་ཀྱི་སྟེང་ན་འདུག་པ་ཡིན་གསུངས་ཤིང་།",
    "སྐམ་ལ་གནས་པའི་སྲོག་ཆགས་གྲོག་སྦྱར་ལ་སོགས་པ་ཆུ་ནང་དུ་ལྷུང་ནས་འདུག་ན་མཐོང་ཚད་དུ་གདོན།",
    "དེ་ལ་ཡང་སྣ་ཁྲིད་པ་ཟེར་བ་ཞིག་ཁོ་ན་གལ་ཆེ་བར་གདའ།",
    "མ་བྱིན་པར་ལེན་པ་སྤངས་པས་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་དང་རང་ཇི་ལྟར་འདོད་འདོད་དུ་ལོངས་སྤྱད་དུ་ཡོད་པ་ཡོང་།",
    "མཚོ་འཁྱགས་པའི་བྱ་བཞིན་དུ་སྡོད་ས་མེད་པར་ཤེས་ཙ་ན་སྐྱེས་བུ་འབྲིང་ཟེར་བ་ལགས་པར་གདའ་སྟེ།",
    "མིར་སྐྱེས་པ་ལ་ཡང་སྐྱེ་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་བརྒྱད་ཀྱིས་དུས་རྟག་ཏུ་གསེད་ནས་འདུག་པ་ལས།",
    "ད་ལྟ་ཇི་ལྟ་བུའི་འདོད་པ་ཅན་ཞིག་ཡིན་ཡང་མའི་མངལ་དེར་ཞག་གཅིག་ཉལ་ནས་ཕྱིར་བྱུང་ཙ་ན་གསེར་སྲང་གཅིག་སྦྱིན་བྱས་ཀྱང་ནུས་པ་ཡེ་མི་ཡོང་།",
    "དེ་ནས་ཕྱིར་བཙས་ཙ་ན་ཡང་ཚེར་ལྕགས་ཀྱིས་བྲབས་པའམ་རྡོ་གང་ན་རྩུབ་རྩུབ་ཀྱིས་བྲད་པའི་ཚོད་ཙམ་གྱི་སྡུག་བསྔལ་ལ་སོགས་པ་ཡོད།",
    "དེ་ཡང་མནར་མེད་ཀྱི་ཟངས་ཁ་ན་འདུག་པ་ཉིད་དུ་སྒོམ་གསུངས།",
    "ཇི་ཞིག་ཙ་ན་ཕྱི་མའི་ལྷ་ཏ་ནམས་ཀྱང་བརྗེད་དེ་འདིའི་སྐྱིད་ཀྱང་བརྗེད་ནས་སྡུག་ལ་ཟད་པར་བྱེད།",
    "ཕྱིས་བློ་སྣ་སྦྱངས་པ་ཙམ་གྱིས་མི་ཆོག་ཆོ་ག་ཉིད་ཀྱང་གཞི་ནས་སྐྱོར་དགོས་གསུང་བར་གདའ་སྟེ།",
    "ཕྱིར་ལོག་ནས་མི་སྐྱ་ཙ་ནའི་བཤེས་དང་དགྲ་ཡིན་པ་དེ་ཉིད་ལ་ཕྱིས་ཀྱི་ཡང་དགྲ་དང་བཤེས་སུ་བྱེད།",
    "མི་སྐྱ་ཙ་ནའི་ལོངས་སྤྱོད་དེ་ཉིད་ཕྱིས་ཀྱི་ཡང་ལོངས་སྤྱོད་དུ་བྱེད་པ་ཡིན།",
    "རང་ཅག་ཐམས་ཅད་དེ་བཞིན་དུ་འདུག་པ་ཡིན།",
    "གསུངས་པ་བཞིན་དུ་སྐྱེས་བུ་མཆོག་ལ་བཀྲི་བར་མི་ནུས་པའི་རིགས་ཅན་རྣམས་སོ་སོའི་ལམ་ལ་འགོད་པ་ལགས་པར་གདའ་ནའང་།",
    "ཕ་ལ་སོགས་པ་ཀུན་གྱིས་ཀྱང་རང་གནོད་པ་སྣ་ཚོགས་ལས་བསྲུངས་ཤིང་ཕན་པ་སྣ་ཚོགས་ཀྱིས་བསྐྱངས་པའི་དྲིན་དྲན་པར་བྱས་ལ་གཅེས་པར་འཛིན་པའི་བློ་བསྐྱེད།",
    "པུ་ཏོ་བ་ཞུ་མཁན་བྲག་ཏུ་བཞུགས་ཙ་ན་ཀ་མ་བ་ཡང་དེར་བྱོན།",
    "སློབ་དཔོན་པས་ཅི་ཡང་མི་ཡོང་ཁོ་ན་གསུངས་པས་དེས་ཞུམ་ནས་སླར་གནོད་པར་ཡང་མཆི་བར་གདའ་བས།",
    "དེའི་ནང་ནས་སྦལ་ལྗོང་རྒྱུ་རྒྱུ་འདུག་པ་འཚེད།",
    "དེ་ཙ་ན་སེམས་བསྐྱེད་གྱིས་བྱས་ནས་ཀྱལ་ཀ་ཡང་བྱས་གསུངས་པ་བཞིན་དུ།",
    "སྤྱིར་མི་ཉིད་དུ་འདུག་པ་ཞིག་ལ་རྨང་ངམ་གཞི་མ་བྱེད་དགོས་པ་ཡིན།",
    "མི་ཉིད་དུ་འདུག་པ་ལའང་འཇིག་རྟེན་པའི་ལུགས་ཀྱི་བསྟན་བཅོས་ལ་བརྟེན།",
    "དེ་ནས་མཆོད་རྫོས་ཁྱེར་ནས་བྱུང་ན་སེམས་བསྐྱེད་གཤའ་མར་བྱེད་པ་ཡིན་པས་དེ་ཙ་ན་གཟོད་དེ་ཆོ་ག་བྱེད་པ་ཡིན་ཏེ།",
    "བསྲུངས་པའི་འབྲས་བུ་ཡང་རང་ཉིད་ཀྱི་རྣམ་པར་གྲོལ་བ་ཙམ་ལས་མི་འཐོབ།",
    "དེས་གང་གནང་གནང་ཟློ་མཁྱེན་གསུངས་པར་གདའ་སྟེ།",
    "ཚ་བྱུག་བསྐྱངས་ཀྱང་དེས་ཤི་ཙ་ན་རོ་བཟུང་བ་ཡང་ཉུང་།",
    "གཞན་གྱི་སྐྱབས་བྱེད་དུ་འགྲོ་བ་བྱ་བའི་དོན་ཡིན་གསུངས་པར་གདའ།",
    "ཁོང་ཚན་ཞིག་སེམས་བསྐྱེད་བྱེད་པ་ཡོད་ཟེར་དགའ་ཆེས་ནས་བལྟར་བྱོན་ཙ་ན་བསྙེན་གནས་འབོགས་པ་འདྲ་ཞིག་ལས་མི་སྣང་གསུང་བར་གདའ་གསུངས།",
    "དེ་དག་ལ་ཤེས་པས་ནི་སང་རང་ལ་ཅི་ཡོང་ཡང་དུས་སུ་མི་ཤེས་སྐད་དེ།",
    "གསང་སྔགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཕྱི་རིམ་དུ་ཡང་འོང་བ་ཞིག་གདའ།",
    "རང་འགུལ་བྱས་ཙ་ན་ཡུལ་འགུགས་བྱེད།",
    "སྤོ་ཏོ་བའི་ཞལ་ནས་དེས་ཏ་ཉེས་པ་དེ་མི་ཡོང་སྟེ་དེ་ཙམ་ལ་ཐུག་པ་ཟོན་བྱེད་དགོས་གསུངས་པར་གདའ།",
    "སོ་སོ་སྟོང་པར་བྱས་དུད་འགྲོ་དེས་མི་ཁྱག་པར་འདུག་པ་ཡང་ཅི་སྙམ་ཡང་མི་བྱེད་དེ་མི་རུང་གསུངས།",
    "ཇོ་བོ་རྗེའི་སྤྱན་སྔ་ནས་གཤེགས་བཞུད་མཛད་ཙ་ན།",
    "ཀ་ཅ་ཀློག་ཙ་ན་སྙིལ་སྙིལ་བྱེད།",
    "འདུག་ན་ཡང་སྐྱབས་སུ་འགྲོ།",
    "ད་ལྟ་ནས་པྲིལ་ལི་བྱས་པས་ན་ཙ་ན་ཡང་།",
    "ན་ཙ་ན་སྐྱབས་སུ་འགྲོ་བ་བྱས་པས་འཆི་ཁར་ཡང་སྐྱབས་སུ་འགྲོ།",
    "ཉ་མཆིལ་བས་བཟུང་བ་ཉ་བྱིན་པོ་དང་མཚོ་ན་མཉམ་པོར་འཕྱོ་ཡིན་འདུག་ཀྱང་ཉ་པ་བྱུང་བས་མཆིལ་བའི་ཉ་སྐམ་ལ་ནར་གྱིས་ཐོན་ཏེ་འོང་།",
    "དབུ་སྐྲ་བ་ལ་སོགས་པའི་དུས་ཀྱང་ཡོད་པ་ཡིན་པར་འདུག་དུས་དྲུག་ལ་འཆག་མེད་དུས་ཚོད་ཀྱང་ཅག་ཅག་པོར་ཡོད་དེ།",
    "སྲིན་གྱི་གོང་བུ་ལྟར་འདུག་པ་དེ་བརྩེ་བའི་སེམས་ཀྱིས་བག་ཟོན་ད་ང་བཅས་པར་བླངས།",
    "དེ་ཡང་རང་དོན་གཞན་དོན་གཉིས།",
    "རྩིག་པ་ཀུན་ལ་ཡང་ཐོགས་པ་མི་མངའ་བ་ཡིན་པར་གདའ་སྟེ།",
    "འོ་ན་ངའི་ཁུར་ན་ཅི་འདུག་དྲིས་པ་ལ།",
    "གསེར་ཞོ་གཉིས་ཀྱང་འདུག་གསུངས།",
    "བལྟས་ཙ་ན་དེ་བཞིན་དུ་བྱུང་།",
    "དེ་ཉིད་དུ་དེའི་ཕན་ཡོན་བསྡུས་ནས་ཚིགས་བཅད་གསུམ་གསུངས་པ་དེ་བྲི་ཞེས་གསུངས་པར་གདའ་བས།",
    "རང་ཞུམ་ནས་འདུག་སྟེ།",
    "བསླུ་ཐུབ་རུང་མ་ཐུབ་རུང་ཐུན་ཚོད་ལས་འདས་ཙ་ན་སེམས་བསྐྱེད་འཆོར།",
    "བློ་སྣ་དང་འདི་ལྟ་བུར་སྐྱེ་བར་གདའ་ན་ཇུག་མི་ཆེ་ཟེར་གྱིན་རང་ལ་སྐྱེས་པ་སྐད་ཟེར་བ་བྱུང་སྟེ།",
    "ནང་རྡོལ་ལ་ཁད་པའི་སྨིན་པར་འདུག་པས།",
    "རྒས་ཙ་ན་མི་མཆིའོ།",
    "ན་ཙ་ན་མི་མཆིའོ་ཟེར་ནས་དེ་བསྐྱེད།",
    "ཅེས་པ་བཞིན་དུ་ཡིན་གསུང་བར་གདའ།",
    "རང་བཞིན་སྔར་བསྟན་པ་དེ་ཡིན་པས་གནས་སྐབས་བཏང་ཡང་རང་བཞིན་བཏང་བར་མི་འགྲོ།",
    "གོང་མ་སྲེག་ཏུ་སྐྱེས་ཙ་ན་ཉོད་པ་སྲོག་ཆགས་བསད་པ་མི་འདོད་པ་བཞིན་གསུངས།",
    "དེ་ཡན་ཆད་དུ་མི་ལྟོ་བའི་བཀའ་ལུང་དུ་གསུངས་པར་གདའ་སྟེ།",
    "དེ་ནན་ཆགས་བྱེད་པར་གསོལ་བ་ཀུན་གྱིས་མཆན་དུ་བཏབ་ནས་འདུག་པ་ལ།",
    "པུ་ཏོ་བ་ན་མགོ་ན་བཞུགས་པའི་དུས་སུ་གདམས་ངག་ཞུས་པས་དེ་ཙ་ན་པུ་ཏོ་བ་དང་སྤྱན་སྔ་གཉིས་མི་གནང་བས་རང་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་སམ།",
    "ཕུ་ཆུང་བས་ཡེར་པ་ལ་ཞུས་པས་ངས་ཇོ་བོ་ལ་ཞུས་ཏེ་མཉམ་གསུངས་གསུངས་པར་གདའ་གསུངས་ཤིང་།",
    "ཚེ་འདིའི་བདེ་སྡུག་ཅི་ལ་ཡང་མི་ལྟ་བ་ཞིག་དགོས་བྱས་ཙ་ན་ཞུམ་ནས་ཡོང་བ་ཡིན་ཏེ།",
    "དེ་དག་ལ་བར་དུ་གཅོད་པ་འདུག་ན་མི་འཇུག་པ་བྱ་བ་ཐམས་ཅད་ཀྱི་ཐོག་མར་འགྲོ་བའི་བག་ཡོད་པ་དང་།",
    "ལྷན་ཅིག་འཚོགས་ན་ཡང་དམག་གཡུལ་ལེགས་པ་བཞིན་དུ་ཁ་གཏོད་མི་ཐུབ་པར་སྨྲ་གསུང་བར་གདའ།",
    "ཡོད་ན་འདོད་པའི་བདེ་བ་བས་ཀྱང་ཉམས་ལ་སྤེན་པ་སྤང་དཀའ་བ་ལགས་པར་གདའ།",
    "དེ་ལྟར་བྱས་པས་འབྲས་བུ་ཐོབ་ཙ་ན་ཕྱིན་ཅི་ལོག་སྤོང་ཞིང་ཕྱིན་ཅི་མ་ལོག་པ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "རྒྱལ་བུས་སྨྲ་ཤེས་སོ་བྱས་ཀྱིན་ཁྱིམ་དུ་ཡོང་ཙ་ན་ཡང་སྨྲར་མ་ཉན།",
    "བཟོད་པ་ཡང་རང་འཁྲུངས་སུ་ཡོང་སྟེ།",
    "བྲེལ་དོགས་ལངས་ནས་འདུག་པའི་དུས་ན་ཙིར་ཙིར་བཟུང་གྱིན་ལས་ཕྲ་བ་ལ་ཡང་ཁྱད་དུ་བསད་དུ་མི་རུང་།",
    "དེ་དང་བླའོ་བྱས་པས་ཁོ་དབུས་ཀྱི་དྲི་མེད་ཟེར་བ་ལ་ཡོད་བྱས་ཤི་བ་ལ་ཤི་བྱས་ཙ་ན།",
    "དགེ་སློང་འདི་ལྟ་བུ་ཞིག་ཡོད་པ་དེ་ཙུག་འདུག་འདྲི།",
    "ཇོ་བོ་བོད་དུ་བྱོན་ཙ་ན་ད་ཚོད་སུམ་ཅུ་ཙམ་ལོན་པའི་ཚོད་ཡིན་གསུང་སྐད་པ་དང་།",
    "རྟེན་དེ་དག་ཏུ་སྐྱེས་ཙ་ན་ཉེས་དམིགས་ཤེས་ཀྱང་སྡིག་ལས་ལྡོག་མི་ནུས་པ་ཡིན་གསུངས།",
    "ད་ལྟ་མཛེ་ཕོ་གཅིག་པུ་མི་ཁྱུ་ལས་བཀར་ནས་འདུག་པ་དག་ལ་སེམས་གནས་པ་བྱུང་བ་ཡོད་ཟེར་ཏེ།",
