    "གྲུབ་དོན་དོན་བཞིན་སྒྲུབ་པར་བྱེད།",
    "གཉིས་ཀའི་ཆ་ལ་ནི་གང་ལ་མེད་པ་དེ་ལས་རྣམ་པར་གཅོད་དོ།",
    "དེའི་སྒོ་ནས་བསྒྲུབ་བྱའི་རིགས་མཐའ་དག་གམ་ཕྱོགས་གཅིག་ལ་ཞུགས་ནས་དོན་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པར་བྱེད་པའི་གཏན་ཚིགས་སུ་བརྗོད་པ་ཡིན་ཏེ།",
    "དཔེར་ན་སྒྲ་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བ་དང་།",
    "གསུམ་གཉིས་གཅིག་ཏུ་རྟོགས་པར་འགྱུར།",
    "འགལ་བ་རྣམས་གཅིག་ལ་བརྗོད་པར་མི་འདོད་པས་སོ།",
    "དེ་རྣམ་པར་བཅད་སྟེ་བསྒྲུབ་པར་བྱ་བའི་དོན་དུ་གཞན་ལ་ཞུགས་པའི་ཕྱིར་བཟློག་པ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "དཔེར་ན་གཏན་ཚིགས་དེ་དག་ཉིད་ལས་རྟག་པ་ཡིན་ནོ་ཞེས་སྒྲུབ་པར་བྱེད་པ་ལྟ་བུའོ།",
    "འདི་ལ་ཡང་རྟག་པ་བཀག་པའི་སྒོ་ཉིད་ནས་བཟློག་པ་སྒྲུབ་པར་བྱེད་དོ།",
    "ཅི་སྟེ་བྱས་པ་ཉིད་ནི་རྩོལ་བ་ལས་བྱུང་བ་དང་མ་བྱུང་བ་གཉིས་ཀ་དང་ཐ་མི་དད་པ་ཡིན་ལ།",
    "ཐ་མི་དད་ཐམས་ཅད་ལས་མ་ལོག་པར་ཞུགས་པས་མི་རྟག་པ་ཉིད་རྗེས་སུ་ཞུགས་པའི་ཤེས་པས་ནི་རྟག་པ་བཀག་པ་ལ་མི་ལྟོས་པ་ཡིན་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "གལ་ཏེ་གང་ཞིག་གང་ལ་ཞུགས་པ་དེ་ནི་རྗེས་སུ་ཞུགས་པའི་ཤེས་པའི་བྱེ་བྲག་དེ་རྣམ་པར་གཞིག་བྷཱུ་བྱ་པའི་སྒོ་ནས་བྱེད་པར་ནུས་ན་ནི་དེ་ལྟར་འགྱུར་རོ།",
    "དཔེར་ན་བྱས་པ་ཉིད་རྩོལ་བ་ལས་བྱུང་བ་དང་།",
    "གལ་ཏེ་བྱས་པའི་ཕྱིར་རྩོལ་བ་ལས་བྱུང་བའོ་ཞེས་སྒྲུབ་པའམ།",
    "ཡང་ན་བྱས་པ་ཡིན་པའི་རྩོལ་བ་ལས་མ་བྱུང་ངོ་ཞེས་སྒྲུབ་ཀྱང་རུང་ངོ།",
    "དེ་བཞིན་དུ་རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ལས་ཡོན་ཏན་ནམ་ཡོན་ཏན་མ་ཡིན་པར་སྒྲུབ་པ་ཡང་ངོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ནི་བྱས་པའི་ཕྱིར་མི་རྟག་གོ།",
    "གལ་ཏེ་མི་རྟག་པ་དང་བྲལ་བའི་བདག་མེད་པ་ལ་བྱས་པ་ཡོད་པར་འགྱུར་ན་ནི་དེ་ལྟ་བུ་ཉིད་དུ་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཕན་ཚུན་ལོག་པ་ཉིད་ལས་འདིའི་ཁྱད་པར་དུ་འགྱུར་རོ།",
    "དེའི་ཕྱིར་སྒྲ་ལ་བྱས་པ་ཉིད་མི་རྟག་པ་དང་བདག་མེད་པ་ལ་སོགས་པ་མཐོང་བའི་ཕྱིར་དང་།",
    "གང་རིགས་མཐུན་མཐའ་དག་ལས་ལོག་པ་དེའི་སྒོ་ནས་བསྒྲུབ་བྱ་ལ་ཤེས་པ་འཇུག་པར་བྱེད་པ་དེ་དག་ནི་རིགས་ཀྱི།",
    "འདིར་གོར་མ་ཆགས་པར་མཐུན་ཕྱོགས་མཐའ་དག་ལ་ཡོད་པའོ་ཞེས་པ་ནི་མ་ཡིན་ཞིང་།",
    "ཐམས་ཅད་ལ་ཡོད་པར་འཛིན་པ་ཡང་མི་སྲིད་དོ།",
    "དེར་ནི་ཉིད་ཀྱིས་ངེས་པར་བསྐྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "གཉིས་ཀའི་ཆ་ནི་གཞན་ལས་རྣམ་པར་བཅད་ནས་གང་ན་ཐེ་ཚོམ་ཡོད་པ་དེ་ན་གཞན་དང་ལྡན་ན་ངེས་པའི་གཏན་ཚིགས་ཡིན་ཏེ།",
    "ལས་མཐོ་ཡོར་དུ་རྟོགས་པ་མཐོང་བ་ནི་ཁ་ཡར་བ་ལས་ངེས་པར་མི་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དང་།",
    "དེ་ནི་གང་ཞུགས་པ་ཉིད་ལ་ལྟོས་ནས་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དེ།",
    "དཔེར་ན་ཅི་སྒྲ་འདི་བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན་རྩོལ་བ་ལས་བྱུང་བ་ཡིན་ནམ།",
    "འདི་ལྟར་བྱས་པ་ཉིད་ནམ་མཁའ་ལ་སོགས་པ་རྟག་པ་ཉིད་ལས་རྣམ་པར་བཅད་ནས་མི་རྟག་པ་ལ་ཐེ་ཚོམ་གྱི་གཏན་ཚིགས་སུ་འགྱུར་རོ།",
    "དོན་གཞན་རྣམ་པར་བཅད་པའི་གཏན་ཚིགས་གཞན་གྱིས་ཡོངས་སུ་གྱུར་པའི་དེ་ལ་ཐེ་ཚོམ་དུ་གྱུར་པ་ནི་མ་ཡིན་ནོ།",
    "མ་ཡིན་པར་དགག་པ་ལ་ཡང་དེ་བཞིན་དུ་སྦྱར་བར་བྱའོ།",
    "འདི་ལ་ཡང་མེད་པར་དགག་པ་ལས་ཁྱད་པར་དུ་བསྒྲུབ་པར་བྱ་རྒྱུའི་བྱ་བ་རྟག་པ་རྣམ་པར་བཀག་པ་དང་སྦྱར་བ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འདི་ལྟར་ལུས་ཅན་མ་ཡིན་པའི་ཕྱིར་རྟག་པའི་ཞེས་བྱ་བ་ལྟ་བུ་ཐམས་ཅད་དུ་བསྒྲུབ་པར་བྱ་བ་གཉིས་ཀའི་ཆ་ལ་ལྟོས་པ་རྣམ་པ་གསུམ་པ་འདི་ཅི་ལྟར་རྣམ་པར་གཅོད་པའི་གཏན་ཚིགས་ཡིན་ཞེ་ན།",
    "འདི་ཡང་གོང་ལ་ལྟོས་པའི་ཐེ་ཚོམ་གྱི་གཏན་ཚིགས་དེ་གཞན་ལས་རྣམ་པར་བཅད་པ་ཡིན་ཏེ།",
    "ད་ནི་གཞན་གྱི་འདོད་པ་ལ་དཔྱད་པར་བྱ་སྟེ།",
    "མེད་པ་ཉིད་ལས་ངེས་པར་གཟུང་།",
    "འོན་ཀྱང་མེད་པ་ཁོ་ན་ལ་མེད་པའོ་ཞེས་ངེས་པར་བཟུང་བ་དེའི་ཕྱིར་ཁྱབ་མཉམ་པོར་ཡོད་པ་ཁོ་ན་གཏན་ཚིགས་སུ་འགྱུར་ཏེ།",
    "དེ་སསབསལ་བྱས་པ་ཁོ་ན་མི་རྟག་པ་གོ་བྱེད་དུ་འགྱུར་གྱི་རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ནི་མ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ནི་མི་པརྟག་པ་དང་ཁྱབ་མཉམ་པ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་བྱས་པ་ཉིད་ནི་མི་རྟག་པ་དང་བདག་མེད་པ་ལ་སོགས་པ་མེད་ན་མེད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ངེས་པར་བཟུང་བ་གསུམ་ག་སྐྱོན་ཅན་ཡིན་ནོ།",
    "ཡང་དེ་དང་མཐུན་པ་དང་ལྷན་ཅིག་ཏུ་རྒྱུ་བའི་གཏན་ཚིགས་ཁས་བླངས་ནས་དཔྱད་པར་བྱ་སྟེ།",
    "ཅི་སྟེ་འདི་ཡང་དག་པའི་དོན་ཇི་ལྟར་ཡོད་པ་ལྟར་མཚན་ཉིད་རྗོད་པར་བྱེད་དོ་ཞེ་ན།",
    "ཤེས་པར་བྱེད་ལས་འདས་པ་བཞིན།",
    "གལ་ཏེ་བྱས་པ་ཉིད་ཀྱི་གཏན་ཚིགས་ཀྱི་སྒྲ་མི་རྟག་པ་ཉིད་དུ་སྟོན་པར་བྱེད་ན་གཞན་ཅི་མ་གྲུབ།",
    "གང་གྲུབ་པ་དེའི་དོན་དུ་ཡང་དཔེར་རྗོད་པར་བྱེད་དམ།",
    "ལྷན་ཅིག་ཏུ་བརྗོད་པར་འདོད་པས་ནི་ཐ་དད་པ་ཡིན་ཡང་ཐ་མི་དད་དུ་འཇུག་པ་རྣམས་ཉིད་ཀྱིར་འགྱུར་ཏེ་དདམག་ལ་སོགས་པ་བཞིན་ནོ།",
    "ཁྱད་པར་དུ་བྱ་བ་དག་ཐ་དད་དུ་རྗོད་པར་བྱེད་པ་ཡང་མ་མཐོང་བས་སོ།",
    "ཁྱད་པར་ཅན་དུ་འགྱུར།",
