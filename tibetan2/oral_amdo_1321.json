    "སྤྱན་སེར་དབུ་སྐྲ་སེར་ཞིང་རོ་ཡི་རོ་ལ་གཤེགས་པར་དགྱེས་པའི་ཞེས་བསྒྱུར་ན་རྒྱ་དཔེ་དང་མཐུན་ཡང་དཀྱུས་བཞིན་དོན་འགྱུར་ཡིན་འདུག་པས་རང་སོར་བཞག་གདན་ལ་དགྱེས་པའི་ཞིང་རྣམས་སྐྱོང་བ་ཁྱོད་ཀྱིས་བསྲུང་བར་མཛོད།",
    "ཆེན་པོའི་དབུས་སུ་གདོང་གི་རྩེ་མོ་ཡིས།",
    "དྲག་ཤུལ་ཕྱག་གིས་བསད་པའི་མི་མགོའི་དུམ་བུ་བཟུང་ནས་ཁྲག་བི་ནོད་རྣམ་སེལ་ཡིན་ཡང་དོན་དུ་རྩོད་མོའི་འཁྱོག་ཚིག་ལ་འཇུག་པས་རྣམ་རོལ་དུ་བསྒྱུར།",
    "ཀྲིཥྚཀྱིཌོབི་བི་ནོད་རྣམ་སེལ་ཡིན་ཡང་དོན་དུ་རྩོད་མོའི་འཁྱོག་ཚིག་ལ་འཇུག་པས་རྣམ་རོལ་དུ་བསྒྱུར།",
    "མི་རྣམས་བསྲེག་པའི་ས་ལ་རྩེ་ཞིང་བརྩེ་བས་རྣམ་པར་རོལ་པ་ཞིང་སྐྱོང་ཁྱོད་ཀྱིས་རྒྱ་དཔེ་ཁ་ཅིག་ལ་ན་ར་ག་ཏ་ན་ཞེས་ཡོད་པས་མི་ཡིས་གང་བ་ཞེས་བསྒྱུར་ཀྱང་དོན་དུ་བི་ཀྲྀ་བ་ན་ཞེས་པའི་ནགས་ཏེ་དུར་ཁྲོད་ལ་འདུག་པ་བཞིན་འདིར་ཡང་མིའི་ནགས་ཏེ་དུར་ཁྲོད་ཀྱི་དོན་ཡིན་མོད།",
    "ཞིང་སྐྱོང་གིས་ནི་སྒྲུབ་པོ་རྣམས་ཀྱི་བགེགས་རྣམས་རབ་ཏུ་སྐྱོད་ཅིང་ངེས་པར་ཞི་བར་མཛད་དུ་གསོལ།",
    "ཧཱ་ཧཱ་ཧཱ་ཊྛ་ཌཱ་ཞེས་བཞད་པ་གང་གིས་དུས་ཀུན་དུ་ནི་ཕྱུགས་རྣམས་ཤིན་ཏུ་འདིར་རྣམ་དབྱེའི་འགྲོས་ཀྱིས་ཕུལ་བྱུང་འཇིགས་པ་དང་འབྲེལ་གྱི་གད་རྒྱངས་དང་མི་འབྲེལ་བས་འདི་བཞིན་བྱས།",
    "ཉིན་རེ་བཞིན་དུ་བགེགས་དང་འདིར་རྒྱ་དཔེ་ཁ་ཅིག་ན་ལོ་ཀཱ་ནཱཾ་ཞེས་སྣང་ཡང་དཀྱུས་ལྟར་རྒྱ་དཔེ་གཞན་མང་པོ་མཐུན་ཞིང་འགྱུར་རྙིང་ལ་ཡང་སྣང་བས་འདི་ལྟར་བསྒྱུར།",
    "རྒྱས་པའི་ཞིང་རྣམས་སྐྱོང་བ་ཁྱོད་ཀྱིས་༩༡ར་བ་འགག།",
    "ཁོ་ཁོ་ཁཾ་ཞེས་རལ་གྲིའི་ཕྱག་གིས་ཁྲག་གསོལ་མཛད་ནས་རྒྱན་ལོ་བ་ཀ་ཞེས་པ་ལོ་བ་གར་འཁྲུལ་ནས་གསུས་འཕྱང་དུ་བསྒྱུར་ཀྱང་རྒྱ་དཔེ་ཐམས་ཅད་མཐུན་པར་འདི་བཞིན་ཡོད་པས་རྒྱན་དུ་བསྒྱུར་དགོས།",
    "གྱིས་རྩེ་ཞིང་འཇོ་སྒེག་དག་གིས་རོལ།",
    "རཾརཱརཾརཀྟནེཏྲརུརུརུདྷིརཀརེབྷཙྩཏཙྩཎྜབེག།",
    "རཾ་རཾ་རཾ་ཞེས་དམར་བའི་སྤྱན་དང་རུ་རུ་རུ་ཞེས་ཁྲག་གི་ལག་པས་གཏུམ་པོའི་ཤུགས་བོད་དཔེ་འགར་འདིར་ཀུ་རུ་ཀུ་རུ་ཞེས་འདུག་པས།",
    "དེ་དང་བདག་གིས་མཐོང་བའི་བོད་དཔེ་ཉིས་བིད་ཅན་རྣམས་ལ་ཀྲྀ་ཀྲྀ་ཀྲོ་སོགས་འོག་གི་བློ་ཀ་གཅིག་འདིར་སྣང་།",
    "ཌོཌ་ཌོ་ཞེས་འདུལ་མཛད་ཌ་མ་རུ་དང་ལྡན་པའི་ཞིང་རྣམས་སྐྱོང་བ་ཁྱོད་ཀྱིས་བསྲུང་བར་མཛོད།",
    "ཡཾཡཾཡཾཡཱཏིབིཧཱུྃཡ་འདིར་བོད་དཔེ་ཉིས་བིད་ཅན་འགར་ཡཱ་མ་ལོ་པཱ་མ་ལོ་ཙཱ་ཞེས་འདུག་པ་སྔར་འགྱུར་དང་ཞ་ལུས་དྲི་མ་མེད་པའི་ཆུ་བཞིན་གཟིགས་ཞེས་བསྒྱུར་ཀྱང་ཡདང་སམ་ལ་མཚམས་སྦྱར་བ་ཡིན་ན་རྣམ་བཅད་ཕྱི་ཞིང་མཚམས་སྦྱོར་བ་མི་འཐད།",
    "བྷུཉྩིཙྩགིཥཎཱགོདྷཱིཀུཊིཀྲྀཏབྷཱཡོམུཀྟིདསཱདྷཀཱནཾ།",
    "ངེས་པར་འཇོམས་ར་ཞེས་ཡོད་པས་བདུད་དང་དགྲ་བོ་ཉོན་མོངས་གྱུར་རྣམས་མ་ལུས་ངེས་པར་འཇོམས་མཛད་པ།",
    "ཀྲྀཏྟིབཱསཱཙྪཀྲྀཏརི་པུ་ནི་ཡ་མོཀེཤིཀཱནཱཤནེཤ།",
    "སྤྲོ་ཚིགས་མཚན་ནག་པོ་ཆེན་པོ་ལ་སྦྱར་བ་ཏེ་འཆི་མེ་མཛོད་དུ་གཟིག་གོས་ཅན་ཞེས་བསྒྱུར་ཀྱང་དཀྱུས་བཞིན་ལེགས།",
    "གང་ཞིག་ཞིང་རྣམས་སྐྱོང་བར་མཛད་པ་ཁྱོད་ཀྱིས་མཐའ་ཀྵཏཎཱིཔཱལཀོཉསོསཀལཛནཏནུཔཱ་འདིར་ཙི་རཱ་ཡུ",
    "པོ་པོ་པོ་ཞེས་ཕྱག་གི་ཞགས་པས་ཕྱུགས་རྣམས་བཟུང་ནས་འདིར་ལ་ལར་བིབྲྀ་ཏ་ཀ་ར་ཞེས་ཡོད་པས་རྣམ་འཛིན་ཕྱག་གིས་ཞེས་བསྒྱུར་ཀྱང་དཀྱུས་བཞིན་གཞན་དུ་བྱུང་བ་ལེགས།",
    "སྲིད་པ་གསུམ་གྱིས་བཏུད་ཅིང་གང་གིས་དུས་ཀུན་ཉམས་པར་མཛད།",
    "ཀྟི་ཀཾ་ཀྵ་ཞེས་བདེ་བར་མཛད་པའི་ཞིང་རྣམས་སྐྱོང་བས་དཔེ་འགར་བཀྐཎཱཏྲཞེས་འདུག་པ་དེ་ལྟར་ན་ཞ་ལུས་འགྱུར་བཞིན་ཞིང་སྐྱོང་ཁྱོད་ཀྱིས་གནོད་པ་སྐད་ཅིག་གིས་ནི་བསལ་དུ་གསོལ་ཁྲོ་གཉེར་མཛད་པས་སྒྲུབ་པོ་རྣམས་ལ་གྲོལ་སྟེར་བ།",
    "པམ་༧ ཏ་ཀྱིས་མརར་དྷན་༩ ལ་ས་ཅུ་ཤིན་ས་འདིར་དཔེ་འགར་ཕྲ་ཙ་ལ་ཏ་ར་ཙ་མ་ཌ་ར་ཀྲིལླི་ཀ་ལོ་ཀཱ་ཞེས་དང་འགར་ཌཱ་ར་བྷུ་རློ་ཀ་ལོ་ཀ་ཞེས་སྣང་ཡང་སྔར་འགྱུར་བའི་རྨད་བྱུང་གི་སྐད་དོད་མ་ངེས་ཤིང་མ་བདེ་བས་བལ་དཔེ་རྣམས་མཐུན་པར་བྱུང་བས་འདི་བཞིན་བཀོད་པ་ཡིན།",
    "སཾསཾསཾསཱསཾ་གྷ་ཏཱ་དྨ་དང་ཨོཾ་ཛ་ཏཱ་བླ་ཟེར་བ་འགའ་ཞིང་སམ་ཡཾ་སུ་ཏ་དྷ་ར་ཞེས་དང་ས་མ་ཡ་ཤུ་བྷ་ཙ་ར་ཞེས་མི་འདྲ་ཙམ་འདུག་པས་དེ་དག་དང་བསྟུན་ནས་བསྒྱུར་ཀྱང་རུང་མོད་ཀྱི་འདིར་བལ་པོའི་དཔེ་ལྟར་བྱས།",
    "སཾ་སཾ་སཾ་ཞེས་གཤེགས་པར་མཛད་ཅིང་མཚུངས་མེད་བདེ་བའི་འབྲས་སྟེར་ཞིང་སྐྱོང་ཁྱོད་ཀྱིས་བསྲུང་བར་མཛོད།",
    "ཐུན་གསུམ་དུ་ནི་སྔགས་རྣམས་བརྒྱད་པོ་ཀློག་པར་བྱེད་པ་དེ་ནི་ཉིན་དང་མཚན་མོར་རྟག་ཏུ་ནི།",
    "སརྦཛཱི་བསྟོད་པ་བཀླག་པའི་ཕན་ཡོན་བསྟན་པའི་ཚིགས་བཅད་འདི་རྣམ་དབྱེ་དང་ཚིག་གི་འགྲོས་དང་དོན་ཐོབ་ལ་ལེགས་པར་བརྟགས་ནས་འདི་ལྟར་བསྒྱུར་བ་ཡིན་གྱི།",
    "བོད་དུ་སྔར་བྱུང་བའི་རྒྱ་དཔེ་དངོས་དང་ཞལ་བཤུས་ཉིས་བིད་ཅན་འགའ་རེ།",
    "བལ་ཡུལ་ཡམ་བུ་དང་ཡེ་རང་གི་དཔེ་དག་མིན་མང་པོ་བཅས་གོ་བསྡུར་ནས།",
    "ཡུདྷིསྦིརཤཱནྟན་བོབུནརེབཱབྷབྷཥཏྲ།",
