    "༡པཾ་ཙ་མོ་ལ་གླུ་སརྦ་ཏྲ་ས་བྷ་མོ་དྲི་ཙ་ཏུན་ཡོ།",
    "གཉིས་བཞི་དག་གི་བདུན་པ་ཡང་ངོ།",
    "༡༢དེ་ནས་ལྗོན་ཤིང་གི་གཟུགས་ཅན་ཞེས་བློ་ལྡན་མཁས་པ་རྣམས་ཀྱིས་དེའི་ཚེ་ངེས་པར་ཤེས་པར་བྱེད་དོ་སྟེ་འཆད་པར་བྱེད་དོ།",
    "གང་གི་ཚེ་ཇི་ལྟ་བུ་ཞེ་ན་གང་དུ་གཉིས་པ་དང་བཞི་པ་དང་དྲུག་པའི་ཡི་གེ་རྣམས་དང་།",
    "༡༥ཀྱེ་པི་ཝཾ་གི་ངག་ཅན་ཏེ་པི་ཝཾ་དང་འདྲ་པ་དབྱངས་སྙན་པའི་ངག་ཅན་གང་ལ་དེ་ལྟར་འབོད་པའོ།",
    "༡༦ཧྲ་སྭ་བཎོ་ཛཱ་ཡ་ཏེ་ཡ་ཏྲ་ཥཊྛཱཀཾ་བུ་གི་བེ་ཏདྨ་དེ་བཱཉྩ་མཱི་ཏྱ།",
    "མནྡཱ་ཀཾ་ཏཱ་ཏྱཱ་ཡ་ཏི་ར་ཧི་ཏཱ་སཱ་ལཾ་ཀཱ་རེ་བྷ་བ་ཏི་ཡ་དི་སཱ།",
    "ངང་མོར་བརྗོད་པར་ཤེས་བྱ་རྒྱུན་དང་བཅས་མ།",
    "༡༨ཨཱ་རྱ་ཙ་ཏུརྦ་མ་ཧཱི་ན་ནི་ཏཾ་བེ་སད་མ་ཀཾ་ད་ཤ་མོ་ཙ་ཏ་ཐཱ་ཎཾ།",
    "ཡ་ཏྲ་གུ་རུཔྲ་ཀ་གསང་བ་བསམས་ཊ་སྨ་ར་སཱ་རེ་ཏཏྟཱ་ཐི་ཏཾ་དོ་དྷ་ཀ་བྲྀཏྟཾ།",
    "དེའི་ཚེ་དེ་ངེས་པར་ངང་མོ་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "རྒྱན་རྣམས་དང་ལྷན་ཅིག་ཏུ་འཇུག་པར་བྱེད་པ་དེ་ནི་རྒྱུན་དང་བཅས་པ་མོ་སྟེ་དེ་ལ་ཡང་དག་པར་འབོད་པའོ།",
    "༢༩ཡ་སཱུ་སྦི་ཥཊ་སཔ་མ་མ་ལྟ་རོ་སདྨ་སཾ་སུ་ཛི་གྷ་ན་བ་མོ་ཙ་ཏེ་ཞུ།",
    "བྱིན་ལེགས་མ་ཀྱེ་གང་གི་གསུམ་དྲུག་བདུན་པ་དང་།",
    "འགྲོས་ཀྱིས་ངང་མོ་མཛེས་པ་སྐྱེང་བར་བྱས་མ་ཀྱེ།",
    "ཨ་མནྡ་མཱ་དྱ་རྨ་ད་ནེ་ཏ་དཱ་ནཱི་མུ་པེནྡྲ་བཛཱ་ཀ་ཐི་ཏཱ་ཀ་བཱིནྡྲི།",
    "༢༡ཀྱི་འགྲོས་ཀྱིས་ངང་མོའི་མཛེས་པ་རྣམ་པར་སྐྱེང་བར་བྱས་མ།",
    "གང་གི་རྐང་པ་རྣམས་ལ་གསུམ་པ་དང་དྲུག་པ་དང་བདུན་པའི་ཡི་གེ་རྣམས་ཡང་བར་གྱུར་ཅིང་།",
    "དག་གི་ཚེ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "བིདྨ་དྷི་རཱ་དྱཔ་རི་ཀཱིརྟི་ཏི་ཡཱཔྲ་ཡུ་ཚུ་ཏཱ་མི་ཏུ་པ་ཛཱ་ཏི་རེ་ཥཱ།",
    "མཚམས་ལྡན་མ་ཀྱེ་འདི་དག་གཉིས་ཀ་དག་གི་ཡང་།",
    "༢༣ཨཱ་རྱ་མ་ཀྵ་ར་མ་ཏ་སྨྲི་ཏི་ཡ་ཀཾ་སཔ་མོ་ཙ་ན་བ་མཾ་ཏ་ཐཱ་ཏི་མཾ།",
    "༢༤ཧྲ་སྭཱ་པཎསཱུཏྲཔཱ་མོ་ཡ་ཏྲ་བཱ་ལེ་ཏངྑདྲི་བོཎྜི་ནུསྟ་ཨེ་ཀཱ་ད་ཤཱ་པཾ།",
    "སྨིན་ལེགས་སྣ་ཚོགས་ལྷ་མོའི་མིང་གིས་ངེས་པར་བསྟན་ཏོ།",
    "གང་གི་སྨིན་མ་མཛེས་པ་དེ་ལ་དེས་ཡང་དག་པར་འབོད་པའོ།",
    "ཀྱེ་གཞོན་ནུ་མ་སྟེ་ལོ་བཅུ་དྲུག་གི་བར་གྱི་ན་ཚོད་ཅན་ནོ།",
    "ཀྱེ་བིནྡའི་མཆུ་ཅན་མོ།",
    "བཱའི་སྒྲ་ནི་དང་གི་དོན་ནོ།",
    "འོ་མ་འཛིན་པ་དེ་དག་སྟུག་པའང་ཡིན་ལ་རྒྱས་པའང་ཡིན་པས་སྡུག་ཅིང་རྒྱས་པའི་ནུ་མ་དག་སྟེ་དེ་དག་གི་ཁུར་གྱིས་ལྷག་པར་དུད་པ་དེ་ལ་ཡང་དག་པར་འབོད་པའོ།",
    "གསུམ་པ་དང་དྲུག་པ་དག་གིས་ལྷན་ཅིག་ཏུ་འཇུག་པ་ནི་གསུམ་པ་དང་བཅས་པའི་དྲུག་པའོ།",
    "རྐང་པ་དང་པོ་གསུམ་པ་དག་གི་ཐོག་མའི་ཡིག་གེ།",
    "མཛེས་མ་དེ་ནི་རི་དྭགས་མོ་ཡི་འགྲོས་སུ་འགྱུར་རོ།",
    "དེའི་ཚེ་དེ་རི་དགས་མོ་ཡི་འགྲོས་སུ་འགྱུར་རོ།",
    "གང་གི་ཚེ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "འ་༡ཀྱེ་པདྨའི་མིག་ཅན་མ་གལ་ཏེ་མྱུར་དལ་ཅན་གྱི་རྐང་པ་དང་པོ་དང་གསུམ་པ་དག་གི་ཐོག་མའི་ཡིག་གེ་འདིར་མེད་པར་གྱུར་པའོ།",
    "དང་པོ་དང་གསུམ་པ་དག་ནི་དང་པོ་གསུམ་པ་སྟེ་དེ་དག་གིའོ།",
    "ལང་ཚོའི་རོལ་པ་རྩེ་བའི་ཚོན་གྱིས་ཤིན་ཏུ་སྒེག་མ།",
    "ཞཉཀྱེ་ལང་ཚོའི་རོལ་པ་རྩེ་བའི་ཚོན་གྱིས་ཤིན་ཏུ་སྒེག་མ།",
    "མྱ་ངན་མེད་པའི་མྱུ་གུ་བཞིན་དུ་གང་གི་ལག་པའི་ཡལ་འདབ་ཀུན་ཏུ་དམར་བ་དེ་ལ་དེས་ཡང་དག་པར་འབོད་པའོ།",
    "བི་ཤྭ་མོ་བྷ་བ་ཏི་མ་ཧེ་ཤ་ནེ་ཏྲ་དིནྡྲིབི་ཛྷེ་ཡཱ་ན་ནུ་སུ་ད་ཏི་པྲ་ཧརཱི་ཎཱི་སཱ།",
    "༢༤ཨཱ་དྲོ་དཱི་ཏཱི་ཡ་མ་པི་ཙེདྷུ་རུ་ཏཙྪ་ཏུཏྠཾ་ཡ་ཏུཏྟཱ་མོ་ཙ་ད་ཤ་ཚྭ་ཏུ་མུ་བཱནྟ་མཾ་ཏུཾ།",
    "ཀྱེ་སོ་ལེགས་མ་སྟེ་གང་གི་སོ་མཛེས་པའོ།",
    "ཀི་ལ་ཞེས་པ་ནི་ངག་གི་རྒྱན་ལའོ།",
    "༣༥པྲ་ཐ་མ་མ་གུ་རུ་ཥ་བི་བྱ་ཏེ་ཡ་ཏྲ་ཀཱི་ཏེ་ཏ་ད་ནུ་ཚད་ཤ་མོ་ཙེ་དཀྟ་རི་དཱ་ད་ཧཱུཾ་ཧཱུཾ།",
    "གི་རི་བྷིར་ཐ་ཏུ་རི་གེརླུ་ཏྲ་ཀཱནྟེ་བི་རཱ་མསུཀ་བི་ཛ་པ་དང་མ་ན་མ་ནོ་ཐ་མཱ་ལི་ནཱི་སཱ་པྲ་སིདྡྷ།",
    "རོ་དང་རིག་བྱེད་རྟ་རྣམས་ཀྱིས་ཀྱང་སྡོད་པ་དེ་ནི་རི་དགས་མོ་རུ་བཤད།",
    "༢༧ཡ་དཱ་ཧྲ་སཱཔུཊྚཀ་ལི་ཏ་ཀ་མ་ལེ་ཁཎྜ་ཀ་པ་ར་ཏ་ཏོ་བཎྞཔཉྩ་པྲ་ཀྲྀ་ཏི་སུ་ཀུ་མཱ་རཱི་གི་ར་ཙི་ཏཱ།",
    "སྐད་ལ་ནི་ཚིག་གི་མིང་ཏེ།",
    "ཨ་མ་བྱིན་པའི་མཆན།",
    "བེ་རེ་ཙྩཾ།",
    "སུ་དྷི་དག་གི་ཡཎ་དུ་འགྱུར་ཏེ་ཨི་ཡ་ཨུ་བ་དག་ཀྱང་ངོ།",
    "ཨ་མ།",
    "སུ་དྷི་ཡོ་ཧ་བྱ་མངྒེབློ་བཟང་གི་ལྷ་བཤོས་མེར།"
