    "རྡོ་རྗེ་རྒྱལ་པོས་ཞུ་དག་བྱས།",
    "ཕྱི་ལོ་༡༩༨༦་ལོར་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་ནས་པར་དུ་བསྐྲུན།",
    "ཆིངས་ཡིག་ནང་རྒྱ་ནག་མི་སེར་རྒྱལ་ཁབ་ཀྱི་སྐུ་ཚབ་ཨི་ཝན་ཆན་མིང་འཁོད་ཡོད་ཀྱང་མཐར་ཕྱིར་འཐེན་བྱས་པས་ཆིངས་ཡིག་འཇོག་མཁན་དུ་བགྲངས་མི་འོས།",
    "ཆིངས་ཡིག་འདི་༡༩༡༤ ལོར་བཞག་པ་དང་༡༩༣༡ ལོར་ཡང་གཙང་མདའ་དཔོན་ཁྱུང་རམ་པ་དང་བདེ་སྨོན་པའི་དམག་དཔུང་བྲག་མགོ་དང་།",
    "ཨིན་ཇིས་བོད་ལ་ཨུ་རུ་སུའི་བཙན་འཛུལ་འགོག་ཐབས་དང་འབྲེལ་བ་ཡོད་པར་༡༩༦ དང་༡༩༧ སོ་སོར་ཨིན་རྒྱ་བར་དང་ཨིན་སུ་ཨུ་རུ་སུ་བར་བཞག་པའི་ཆིངས་ཡིག་ཁག་ལས་ཤེས་ཐུབ་པ་དང་།",
    "ལྷ་སའི་རྒྱ་ནག་སྐུ་ཚབ་ཀྱི་སྐུ་སྲུང་དམག་མི་བརྒྱ་དང་དབྱིན་ཇིའི་སྐུ་སྲུང་དམག་མི་བདུན་ཅུ་དོན་ལྔ་ལས་ལྷག་པ་མི་འཇོག་པ་སོགས་མང་པོ་ཡོད་ཀྱང་ཐམས་ཅད་བགྲངས་བས་མི་ལངས།",
    "ཐོག་མར་བོད་རྒྱ་གཉིས་པོ་བོད་རང་བཙན་ཡིན་མིན་སྐོར་རྩོད་པ་ཡུན་རིང་བྱས་པ་དང་།",
    "དེར་ཨིན་ཇི་དང་རྒྱ་གར་གཉིས་ཀྱིས་ངོས་ལེན་དང་རྩ་འཛིན་བྱེད་ཀྱིན་ཡོད་པ་དེས་བོད་པ་ལ་རྐྱེན་ངན་གྲོགས་ཤར་དུ་གྱུར་ཡོད་པར་འདོད།",
    "མི་མང་ལ་བསམ་ཡུལ་ལས་འདས་པའི་དམར་གསོད་དང་འཕྲོག་བཅོམ་བཙན་གཡེམ་བྱས་པ་སོགས་ཀྱིས་ཀྲའོ་ཨེར་ཧྤེང་མི་གསོད་ལག་དམར་ཆེན་པོ་ཞེས་ཡོངས་སུ་གྲགས།",
    "ད་དུང་སི་ཁྲོན་གྱི་དམག་མི་ཉིས་སྟོང་ལྷག་ཐད་ཀར་བོད་ཀྱི་རྒྱལ་ས་ལྷ་སའི་ནང་བཙན་འཛུལ་གྱིས་བོད་མི་སྐྱ་སེར་མང་པོ་དམར་གསོད་དང་རྒྱུ་དངོས་གང་འདོད་ལྟར་འཕྲོག་བཅོམ་བྱས་པ་སོགས་བཙན་གནོན་གྱི་བྱ་སྤྱོད་བསམ་ཡུལ་ལས་འདས་པ་རྣམས་མཐར་སྐྲོད་གཏོང་ཕྱིར་བོད་གཞུང་མང་མ་གྲོས་བསམ་པ་གཅིག་མཐུན་གྱིས་ངོ་རྒོལ་བྱེད་བཞིན་པའི་སྐབས་དེར།",
    "བོད་འདི་རྒྱལ་ཁབ་རང་བཙན་ཡིན་པར་ཐག་བཅད།",
    "ཀ་ྭང་ཞུའི་ཁྲི་བཞུགས་སོ་གཉིས་པ་ཕྱི་ལུགས་འདས་ལོ་༡༩༦ཟླ་བཞི་བའི་ཚེས་བདུན་ལ་པེ་ཅིང་དུ་རྒྱ་ཕྱི་གཉིས་ཆིངས་ཡིག་རྟགས་འཇོག་སྐབས་བོད་ཀྱི་སྐུ་ཚབ་དང་།",
    "ཐ་མ་ཀ་ཕབ་རིགས་མེད་གཤིས་བརྩི་འཇོག་བྱེད་མི་ཐུབ་པར་བརྟེན་རྒྱལ་ཁབ་གསུམ་ཀ་ནས་ཆ་འཇོག་མེད་པ་བྱེད་རྒྱུ།",
    "ཤར་ལྷོའི་མཚམས་བྱན་དྲངས་ཟེར་བའི་ཡུལ་དུ་མཆོད་རྟེན་དཀར་པོ་ཞེས་པ་བཅས་ཡིན་ངེས་ཡོངས་གྲགས་བཞིན་ད་ལམ་དབྱེ་འབྱེད་བགྱིས་པར་བོད་ཀྱི་ས་ཁོངས་ཞིབ་ཆ་བྱང་ཕྱོགས་ཀུན་ལུང་རི་རྩེ།",
    "བ་ོད་ཕྱོགས་ཀྱི་གནས་བོད་དཔོན་ཁག་དང་མི་སེར་རྒྱ་ཕྱོགས་ལ་དཀར་བ་ཡོད་རིགས་མཁྱེན་གསལ་བཙོན་བཅུག་བྱས་རིགས་དང་རྒྱུ་དངོས་གཞུང་བཞེས་བྱས་རིགས་རྣམས་དགོངས་དྭངས་ཀྱིས་བཙོན་འདོན་དང་རྒྱུ་དངོས་ཕྱིར་ལོག་བྱེད་རྒྱུ་བྱས།",
    "ཕ་ྱི་ལོ་༡༩༡༣ཨོཀྵ་པར་ཏཱ་རིག་སུམ་ཅུ་ལ།",
    "ལག་རྟགས་ས་ཡིག་ཕབ་རྒྱག་གནང་བ་མ་ཟད།",
    "གོ་ལྡོག་ཏུ་འགྱུར་བའི་རིགས་མ་ཡིན་པའི་ཚིག་གཞི་གང་ཡོད་ལ་ཕན་ཚུན་གྱི་དོ་བདག་གཞུང་ས་རྣམས་ནས་བརྩི་འཇོག་གནང་དགོས།",
    "བོད་ཀྱི་སའི་ཆ་ཤས་ཙམ་ཡང་བདག་བཟུང་མི་བྱེད་པ་ཁས་ལེན་བྱས།",
    "ཟླ་གསུམ་མི་འགྱངས་པར་ཕྱིར་འཐེན་བྱེད་རྒྱུར།",
    "མི་སེར་ས་ཞིང་འདེབས་འཁོས་ཀྱིས་གཞིས་ཆགས་གཏན་སྡོད་མི་འཇུག་པར་ཁས་ལེན་བྱས།",
    "ཡིན་ཡང་སྐུ་སྲུང་ཐད་མི་གྲངས་གསུམ་བརྒྱ་ལས་ལྷག་པ་གཏན་ནས་བཞག་མི་ཆོག་པ་བྱས་ཡོད།",
    "རྒྱལ་ཁག་གཞན་དག་དང་ཡང་མི་འཇོག་པ་རྒྱ་བོད་གཉིས་ཀྱིས་ཁས་ལེན་བྱས་ཡོད།",
    "རྒྱལ་ཁག་དགའ་ཉེ་གཞན་དག་ལ་གནང་བའི་ཚོང་བྱུང་བདེ་ཐབས་དེ་བཞིན་དབྱིན་ཇིའི་ཚོང་ཟོག་ལ་ཡང་གནང་དགོས།",
    "ཀ་པར་ཕྱི་ལོ་ཆིག་སྟོང་བརྒྱད་བརྒྱ་དགུ་བཅུ་གོ་གསུམ་དང་།",
    "ད་ལམ་ཆིངས་ཡིག་འདི་བཞིན་དབྱིན་ཡིག་རྒྱ་ཡིག་བོད་ཡིག་རྣམས་ཡི་གེ་བསྒྱུར་སྐབས་གོ་བསྡུར་གཏན་ཏིག་བྱས་ཡོད་པ་གོ་ཕྱོགས་ལོག་གླེང་བྱུང་ན་དབྱིན་ཡིག་ཏུ་གསལ་བ་དེ་རང་ལ་སོར་གནས་བྱ་རྒྱུ།",
    "རྒྱ་ནག་བར་བོད་འབྲས་སྐོར་བཞག་པའི་ཆིངས་ཡིག་གཉིས་པར།",
    "ཕྱི་ལོ་༡༩༤ ཟླ་༩ ཚེས་༧ ཉིན་དབྱིན་བོད་བར་ལྷ་སར་བཞག་པའི་ཆིངས་ཡིག་གསུམ་པར།",
    "རྒྱ་གཞུང་བར་པེ་ཅིང་ལ་བཞག་པའི་ཆིངས་ཡིག་ཚིག་འབྲུ་འདི་ལྟར་འཁོད་པའི་ཤོག་ལྷེ་སྣོན་འཇོག་བྱས་ཡོད།",
    "གཉིས་པར།",
    "དེ་རྗེས་ས་ཁྲ་སྔོན་མའི་མཇུག་མཐུད་ཡིན་ཞེས་དྭགས་ཀོང་ནས་མཚོ་སྣ་བར་གྱི་ས་ཁྲ་གནང་སྟེ།",
    "རྨི་ལི་སོགས་ནས་དབྱིན་གཞུང་ལ་ཐུགས་ཕན་ཐོག་པ་ཕུལ་འཐུས་སོགས་དྲོན་མེད་ངོ་གསོ་ཐོན་པའི་ཐབས་བློ་མ་བྱས་པ་མེད་པའི་མཐར།",
    "དབྱིན་གཞུང་ནས་བོད་ཕྱོགས་ཀྱི་སྐུ་དོན་ལ་ཕན་གྲོགས་ཡག་པོ་གནང་མུས་དང་།",
    "ད་དུང་ཡང་གང་ཐུབ་ཅི་ཐུབ་གང་དགོས་སྟབས་བོད་ཕྱོགས་ནས་ཀྱང་དགོངས་བཞེས་གང་དྲག་གནང་དགོས་ཞེས་གསུང་རྐྱང་མ་ཟད།",
    "ཚུལ་དེ་ལྟར་གནང་ན་བོད་ཀྱི་མིང་དེ་ཚོའི་སྒང་ནས་ཉར་ཚགས་བྱེད་ཀྱི་ཡོད།",
    "བོད་གཞུང་དབར་བཞག་པའི་གྲོས་མཐུན་ཁག་བརྩི་འགྲོ་ཡོད་མེད་ཐད་རྒྱ་གར་གཞུང་ལ་གླེང་སློང་བྱས་པར་རྒོལ་གཏམ་སྤེལ་དོན་དུ།",
    "ཆིངས་འགྲིགས་བྱས་ཡོད་པ།",
