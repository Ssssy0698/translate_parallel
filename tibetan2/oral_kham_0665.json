    "དུས་རབས་བདུན་པའི་ནང་ཞང་ཞུང་དང་བོད་དབར་གཉེན་གྱི་འབྲེལ་བ་འགོ་བཙུགས་པ་དང་མཐར་རྒྱལ་ཁབ་གཉིས་ཀྱི་འཐབ་རྩོད་ཀྱི་འོག་ནས་ཞང་ཞུང་ལ་ཕམ་ཁ་དང་བོད་ལ་རྒྱལ་ཁའི་དར་ཆ་ཐོབ་པའི་བརྒྱུད་རིམ་ཁྲོད་དུ་སད་མ་ཀར་ནི་ལས་འགུལ་འདིའི་ཇུས་འགོད་མཁན་ལྟ་བུར་གྱུར་འདུག་སྙམ།",
    "གོས་ཞུས་ཞེས་པའི་ནང་ཞེས་པར་བསྒྱུར་འདུག་གཡར་སྔ་རུ།",
    "ཤོག་ངོས་༨༧ནང་མ་རུང་བ་ཞེས་པར་མཆན་འགྲེལ་བྱས་འདུག་གུ་གེ་རྐང་ཕྲན།",
    "གཉིས་འཚོ་སྐྱོང་བྱ་བ་ལ་དཀའ་ངལ་འདུག་སྟེ།",
    "ཞུས་དོན་གྲུབ་རྒྱལ་གྱི་དཔྱད་དེབ་ཀྱི་ཤོག་ངོས་༨༧ནང་རྐང་པའི་ཡན་ལག་ཅེས་པར་འགྲེལ་གནང་འདུག།",
    "ཉ་བཟའ་བའི་སོ་བྱ་གྲེ་བོ་ཆུང་བ་དེས་བཟའ་གྲབས་འདུག་གལ་སྲིད་གཡོན་དུ་ཡོ་བ་ན།",
    "སྲམ་བུ་དེ་གོང་གོང་བྱས་ནས་བསྡད་འདུག་དེས་ན་མར་ལ་འཕྱང་འཕྱང་བྱས་ནས་མ་བསྣར་ན།",
    "ཐག་རིང་བའི་ནམ་མཁའི་དགུ་ཚིགས་དང་ཆུ་མིག་གཉིས་རྩ་བ་ནས་མཐུན་ཐབས་མི་འདུག་ཅེས་བརྗོད་པར་སྙམ།",
    "བོད་ཀྱི་རྒྱལ་པོས་ཀྱང་མི་བཟོད་པར་འདུག་པས་ན།",
    "བོད་ཀྱི་མངའ་རིས་ཀྱི་སུམ་གཉིས་སྟེར་བར་འདུག་གོ་སྨྲས།",
    "དང་གསུམ་གདའ་འོ།",
    "ཁ་བྱང་དུ་བལྟས་ནས་ཕྱིན་ན་འདུག་ཅིང་།",
    "ཐོས་ཚོད་ལྟར་ན་ཧྥ་ཡིག་ཏུ་བསྒྱུར་བའི་ཡིག་དྲིལ་ནང་གནས་ཚུལ་དེ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་དུས་སུ་བྱུང་བ་ཡིན་པ་རྒྱུད་འཛིན་བྱས་འདུག་པར་འཆད་ཅིང་།",
    "འོན་ཀྱང་དེབ་དཀར་དུ་སྲོང་བཙན་སྐབས་བཞག་འདུག་གོ།",
    "རང་རང་ཡུལ་བསྒྱུར་མཐའ་མར་བོན་བསྣུབས་ཚེ།",
    "ཡོངས་གྲགས་ལ་བསམ་ཡས་ནས་ཨ་ཙ་ར་མི་གསུམ་གྱིས་གཏེར་བཏོན་པ་དེར་སྔ་གཏེར་དུ་འབོད་ཀྱི་འདུག་པས།",
    "དེའི་འོག་ཏུ་རྩྭ་མི་ཤིང་མིའི་དུས་ཞེས་བྱུང་བ་འདིར་དཔྱད་པ་ཅུང་བྱེད་དགོས་པ་ཞིག་འདུག་སྟེ།",
    "ཡིན་ན་ཡང་དུང་དཀར་ཀྱི་ཚིག་མཛོད་དུ་གསལ་བའི་རྩྭ་མི་ཤིང་མི་ཞེས་པའི་གོ་དོན་གྱི་འགྲེལ་ཚུལ་འདིར་བསམ་གཞིགས་བྱེད་དགོས་པ་ཞིག་ཀྱང་འདུག་སྟེ།",
    "༡༣ ཞེས་བཀོད་འདུག་པ་ལས་རྩོམ་པ་པོ་སུ་ཡིན་མི་གསལ།",
    "ཞང་ཞུང་ཞེས་པ་ཚང་མར་ཞང་ཞོང་ཞེས་བྲིས་འདུག་ཅིང་།",
    "བློ་འཛིན་གཙོ་བོ་འདུག་ས་ཡིན།",
    "ཞེས་ཞིབ་པར་གསལ་འདུག་པ་དེར་བལྟས་པས་ཤེས།",
    "བཀོད་ན་ཡིག་ཚོགས་ཤིན་ཏུ་མང་བར་འདུག་པས།",
    "དེའི་གཞུང་ལུགས་ཀྱི་བྱུང་ཁུངས་སྐོར་ལ་ད་ཕན་དཔྱད་རྩོམ་དེ་ཙམ་ཞིག་མི་འདུག་པ་འདི་ལ་གཞིགས་ཏེ།",
    "དེའི་སྐབས་སུ་ཡང་རང་གཞུང་ལས།",
    "ནམ་ཟླ་གང་ལ་བསྟེན་དགོས་པའི་ལེགས་ཉེས་ཀྱི་དཔྱད་གཞི་མེད་པར་གང་བྱུང་དུ་བསྟེན་བཞིན་འདུག་པ་མཐོང་ཐོས་བྱུང་བར་བརྟེན།",
    "རྒད་པ་གསེར་གྱི་བྱ་སྐྱིབས་ནས་བོན་པོ་ཞིག་བཞུགས་འདུག་པས།",
    "ཁོང་རྣམ་པས་ཀྱང་སྒོ་སྟེང་དུ་དར་ལྕོག་སློང་བའི་གོམས་གཤིས་དེ་དག་གཅིག་པུ་ལ་བལྟས་པས་ཀྱང་འདི་ཉིད་ཞང་ཞུང་ནས་མཆེད་པའི་བོད་རིགས་ཤིག་ཡིན་པར་བརྗོད་སྤོབས་པའི་གནས་སུ་འདུག།",
    "བོན་གཞུང་དུ་ལ་ཧྲང་ཞེས་བྱུང་བ་བཞིན་ཁུ་ནུ་བས་ཀྱང་རང་ཟེར་བས།",
    "གླིང་ལྔའི་སྲིད་འབྱོར་སྒྲོག་ཚེ་སྐྱིད་སྣང་ཞིག་འདུག་ཀྱང་།",
    "ཞབས་རྡོལ་སྣོད་ཀྱི་མཚན་གཞི་མཐར་ཐུག་ཏུ་གྱུར་འདུག།",
    "ད་དུང་རང་ཆེའི་དྲེགས་པ་མི་འཇོམས་ཤིང་།",
    "རིག་ལམ་གྱི་གོམས་པ་ཡང་ཧ་ཅང་ལེགས་པོ་ཡོད་པའི་རྟགས་མཚན་གསལ་པོ་འདུག་དེ་དག་ལ་རྗེས་སུ་ཡི་རངས་དང་འབྲེལ་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "ཡི་གེ་དེ་ཁོ་རང་ནས་བྲིས་པ་ཡིན་ཞེས་བརྗོད་ཀྱི་འདུག་སྐབས་དེར་ཡང་སྤྱི་འཐུས་ཁོང་ལ་བརྗོད་རྒྱུ་བྱུང་ལ།",
    "གསུང་རྟེན་གཡུང་དྲུང་བོན་གྱི་བརྟེན་འགྱུར་པོད་གྲངས་སུམ་བརྒྱ་ལྷག་ཐུགས་རྟེན་གཡུང་དྲུང་བཀོད་ལེགས་ཀྱི་མཆོད་རྟེན་བཅས་གཞན་ཡང་རང་ལུགས་ན་བཟའ་གོས་དྲུག་དང་།",
    "དགེ་སློང་བེ་རོ་ཙ་ནས་ཞུས་ཤིང་བསྒྱུར་ཏེ་གཏན་ལ་ཕབབསྡུར་མཆན།",
    "དེའི་འོག་ཏུ་བསྒྲུབ་པ་པོས་དེའི་སྟེང་དུ་བརྩོན་འགྲུས་ཆེན་པོའི་སེམས་བསྟན་པ་སྐྱེད་ནས་འདུག་གོ།",
    "དེའི་འོག་ཏུ་སྒྲུབ་པ་པོས་དེའི་སྟེང་དུ་བརྩོན་འགྲུས་ཆེན་པོའི་སེམས་བསྟན་པ་བསྐྱེད་ནས་འདུག་གོ།",
    "དེའི་འོག་ཏུ་སྒྲུབ་པ་པོས་དེའི་སྟེང་དུ་བརྩོན་འགྲུས་ཆེན་པོའི་སེམས་བརྟན་པ་བསྐྱེད་ནས་འདུག་གོ།",
    "ཁཾ་ཁའི་དབུས་ན་འདུག་པར་བསམ།",
    "དེའི་དབུས་ན་འདུག་བསམ་པ།",
    "དེའི་དབུས་ན་འདུག་བསམ་པ།",
    "རྒྱུད་༩༨༨བྱའོ་། དེའི་འོག་ཏུ་སྒྲུབ་པ་པོས་ཐུགས་རྡོ་རྗེ་ཆེན་པོའི་སེམས་སྐྱེད་ནས་འདུག་གོ།",
    "ཁ་དོག་སྣ་ཚོགས་པའི་གདན་གང་ཡང་རུང་བའི་སྟེང་ན་འདུག་པ།",
    "སེམས་དགའ་བས་མདུན་དུ་སྨོས་པའི་གནས་སུ་སྟན་ལ་འདུག་གོ།",
