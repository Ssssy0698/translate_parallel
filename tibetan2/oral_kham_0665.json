    "བསང་ཆུང་ཡིད་བཞིན་ནོར་བུ། སློབ་དཔོན་པདྨས་མཛད་པའི་བསངས་ཆུང་འདི་གཞིས་བྱེད་གར་འགྲོ་གར་འདུགཀྱང་དོན་ཐམས་ཅད་ཡིད་བཞིན་དུ་འགྲུབ་པ་ཡིན་ནོ།",
    "རང་རང་སོ་སོའི་སྤོད་ཡུལ་དུ།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་རང་རང་གནས་རྣམས་ནས།",
    "ཡང་རང་རང་གར་བཞུགས་གནས་མཆོག་ནས།",
    "དབེན་པ་སྐྱབས་ཡོད་འདུག་པའོ།",
    "ཡང་ཡང་དང་ནི་འདུག་གནས་གཅིག།",
    "སྲོག་ཆགས་དང་བཅས་ཉལ་སར་འདུག།",
    "འདུག་པར་བྱ་བར་དགུ་དག་དང་།",
    "ཁས་བླངས་ཐོག་ཏུ་ཁེལ་བ་མི་གདའོ།",
    "ཁས་ལེན་ཆེ་ལ་ཉམས་ལེན་ཞན་པ་གདའ།",
    "རང་གཞན་གཉིས་ཕུང་ལས་ལ་སྦྱོར་ཉེན་གདའ།",
    "ཚིག་དང་ཉམས་ལེན་འགལ་ནས་མི་གདའོ།",
    "ཉམས་ལེན་ཕྱོགས་ཙམ་འགྲུབ་པ་མི་གདའོ།",
    "བདག་ལ་སྐྱོབ་པའི་ནུས་པ་མི་གདའོ།",
    "དཔེ་གཅོད་འདོད་མི་གདའ་ན་གཡོར།",
    "འདུག་པར་འདོད་ཚེ་རིན་ཆེན་གཞལ་ཡས་ཁང་།",
    "འཆད་ཀྱིན་འདུག་ཅེས་གསན་ལ་གསོལ་བ་འདེབས།",
    "ཕྱོགས་གཅིག་ན་རི་རྩེ་ལྔ་པ་དཀྱིལ་མ་མཐོན་པོ་གཅིག་འདུག་པར་འདི་ན་ངའི་བུ་ཞིག་ཡོད་སྙམ་པ་བྱུང་།",
    "ཨོ་ལོ་འདི་ཁ་སང་ནས་རྟ་རང་ཟེར་གྱིན་འདུག་ཅེས་གསུངས་པ་ལྷ་སར་འགྲོ་རྒྱུ་འདི་མཁྱེན་པའི་བརྡ་ཡིན་འདུག་གསུང་།",
    "ཁྲ་བོ་གསུམ་བཅས་བཅུ་སྐོར་ཞིག་རྫིང་ནང་དེར་ཡོད་འདུག་པ་རྗེ་འདི་ཉིད་དང་ཉེ་བར་འོངས་ཏེ།",
    "ཨོ་ལོའི་ཡིན་པ་འདུག་ཟེར།",
    "གཞན་མ་རྣམས་དེའི་འཁོར་ཡིན་པར་འདུག་ཅེས་གསུངས།",
    "དད་པ་དང་གཏོང་བ་དང་རང་བཞིན་གྱིས་ཡིད་གཞུང་བ་སོགས་ཡ་རབས་ཀྱི་སྤྱོད་པ་དུ་མས་ནི་མཛེས།",
    "བདག་སོགས་རྗེས་འཇུག་རྣམས་དམུས་ལོང་ལོང་ཁྲིད་མེད་པ་ལྟ་བུར་འདུག་པས་ལུང་གསལ་པོ་ཕེབས་དགོས་ཚུལ་གྱི་ཞུ་བ་ནན་ཏན་དུ་ཕུལ་བ་ན།",
    "ད་ལམ་བཀྲ་ཤིས་རྩེ་པར་འཁྲུངས་པ་དེ་ཉིད་གང་ཅི་ནས་ངེས་ཤེས་འདྲོངས་པའི་གསལ་ཐོན་བྱུང་འདུག་པ་ཤིན་ཏུ་ལེགས་པས།",
    "བླ་བྲང་རང་ནས་ཀྱང་དགའ་སྤྲོའི་གསོལ་སྟོན་རྒྱ་ཆེན་པོ་བཀོད་པ་མཛེས་པར་བཤམས་ཏེ་མཆོག་དམན་མཐའ་དག་མགུ་བར་བྱས།",
    "ཉིན་གཅིག་གསོལ་ཆས་ཆེར་མི་བཞེས་པར་འདུག་པ་ལ་མཆོད་དགོས་ཚུལ་ནན་གྱིས་ཞུས་པར།",
    "ཡང་ལན་ཅིག་སྦུགས་ཀྱི་ཕྱག་མཛོད་ན་རྗེ་བཙུན་སྒྲོལ་མ་བཞུགས་འདུག་ངས་ཕྱག་བཙལ་བ་ཡིན་ཞེས་པ་དང་།",
    "གཡས་གཡོན་དུ་རྗེ་བཙུན་འཇམ་དབྱངས་དང་ཕྱག་རྡོར་བཅས་བཞུགས་འདུག་པ་ལ་གསོལ་བ་བཏབ་པ་ཡིན་ཞེས་བཀའ་ཕབས།",
    "འཇམ་དཀར་གྱི་སྒྲུབ་ཐབས་ཤེས་རབ་མཆོག་སྦྱིནའཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ནོར་བུ་ཆུ་ཤེལ་དང་བློ་གསལ་ཀུནྡའི་དགའ་བྱེད།",
    "སྐྱབས་མགོན་མཆོག་ཚོགས་དབུར་གདན་དྲངས་ཏེ་ཞབས་བརྟན་འབུལ་མི་སུ་འདྲ་ཞིག་ཡིན་ཀྱང་འདུས་ཚོགས་ལ་ཡང་རང་འབྱོར་དང་བསྟུན་ཏེ་མང་འགྱེད་ཀྱི་བསྙེན་བཀུར་ཞུ་བ་འཆར་ཅན་ཡིན་པས་གཤམ་གསལ་ཚོགས་དབུ་རྣམས་ཀྱི་སྐབས་སུ་འདི་སྐོར་མ་བྱུང་ཡང་།",
    "དེའི་ཕྱག་ཏུ་ལྷུང་བཟེད་བདུད་རྩིས་གང་བ་འཛིན་པ་ཆིལ་གྱིས་ཁོལ་བ་ལས་ཕྱིར་མ་ལུད་པར་འདུག་པ་དང་།",
    "སླར་ཡང་པོ་ཏ་ལར་ཕེབས་ཏེ་རྒྱུན་རིང་ཙམ་མ་བཞུགས་ན་ངོས་འདོད་པ་ཡང་མི་ཁེངས་པ་ཡོང་འདུག་ཅེས་ཐུགས་བརྩེ་བླ་ན་མ་མཆིས་པས་བཀའ་བཟང་པོ་ཕེབས་ཀྱང་།",
    "དྲུང་འཁོར་གཅིག་བརུས་གཏོང་བ་གནང་བར་སྔར་གྱི་རབ་གཏིང་རིང་བས་ཕེབས་ཐུབ་པ་ཞིག་མི་ཡོང་འདྲ་ཟེར་བའི་ཐོག་དེའི་མས་ཙམ་ན་ཕོ་རོག་གཉིས་སྐད་སྒྲོག་ཅིང་ཡོད་འདུག་པ་དེར་རབ་བཙལ་བས་རབ་བདེ་བ་ཞིག་རྙེད།",
    "ཆུང་བ་བརྒྱ་ཇ་སྦུག་བརྒྱ་ཐམ་པ་རྣམས་རྟ་ཟམ་ཐོག་བསྩལ་འདུག་པ་འབུལ་བར་རྒྱུན་བཞུགས་ཨམ་པན་རྣམས་འབྱོར་བར་དཀར་སྤྲོ་དང་ཁ་བཏགས་གནང་།",
    "རྟ་ཟམ་གྱི་ཐོག་ཁོང་རང་ལ་ཡི་གེ་གནང་བས་ཚེས་དྲུག་ལ་འབྱོར་ཏེ་གོང་མ་ཆེན་པོའི་བཀའ་ཕབ་པ་གསན་ཅིང་གོང་དུ་ཞུ་ལན་ཀྱང་འབུལ་བ་མཛད།",
    "ཞེས་གསུངས་པའི་དོན་ཐོག་ཏུ་བབས་པ་ཡིན་འདུག་པས་བཀའ་དྲིན་བསམ་བརྗོད་ཀྱི་ཡུལ་ལས་འདས་པ་དེས་ན་བདག་ལུས་ལོངས་སྤྱོད་དུས་གསུམ་དུ་བསགས་པའི་དགེ་ཚོགས།",
    "ཊཱིཀ་ཆེན་རིགས་པའི་རྒྱ་མཚོའི་མགོ་ནས་འཇམ་དབྱངས་ཀྱི་བསྟོད་པ་ཤོ་ལོ་ཀ་གཅིག་ཨ་ར་པ་ཙ་ན་བཅས་ཀྱི་ལྗགས་ལུང་བསྩལ།",
    "གོང་ནས་རྗེ་ཉིད་ལའང་གསེར་ཡིག་དང་གནང་སྐྱེས་གྱ་ནོམ་པ་བསྩལ་འདུག་པ།",
    "འོལ་ཁ་ཕྱོགས་སུ་ཡང་ཡོད་འདུག་པར་དེ་ལ་བརྟག་དཔྱད་བྱེད་མི་བཏང་ན་གསུང་བར།",
    "སྐུ་ན་ཤིན་ཏུ་ཕྲ་གཤིས་གསུང་གསལ་བའི་དུས་ཚོད་མིན་འདུག་པ་ལས་སྐུ་སྐྱེད་སོགས་བག་དྲོ་བར་སྣང་བ་ཙམ་དུ་མ་ཟད།",
    "ཁོང་རང་ངོ་གཡོག་བཞི་བཅུ་ཙམ་དང་།",
    "དེར་འདུས་སྐྱེ་བོ་རྣམས་ནས་སྔ་སོར་པཎ་ཆེན་སྐུ་གོང་མ་རྗེ་བཙུན་བློ་བཟང་ཡེ་ཤེས་ཀྱིས་ཉང་སྟོད་འདི་ཞབས་ཀྱིས་གཅགས་པ་ཞིག་མ་བྱུང་འདུག་རུང་།",
    "དཀའ་བཅུ་ཐབས་མཁས་སོགས་ཞབས་ཕྱི་རྣམས་ནས་ཀྱང་རང་འབྱོར་དང་བསྟུན་པའི་དངོས་འབུལ་བསྟར།",
    "ཚེས་ཉེར་བརྒྱུད་ལ་རྒྱལ་སྲས་སྤྲུལ་པའི་སྐུས་ཞུས་ངོར་ཁོང་རང་དང་།",
    "མདུན་དུ་འདུག་སེ་ལན་གསུམ་དུ་བརོད་དགོས་སོ།",
    "ཙོག་ཙོག་པོར་འདུག་ཅྱིང་གསོལ་བ་གདབ་པར་གྱུར་པ་གསུམ་དང་།",
    "གང་རང་཈ྱིད་སྐྱེས་ཙམ་཈ྱིད་ནས་མཚན་མ་ག་཈ྱིས་ཀ་མེད་པ་ནྱི་སྐྱེས་ནས་མ་ནྱིང་ཡྱིན།",
    "འབུལ་ཆོག་བྱས་པ་བསབ་པ་བསྲུང་དཀའ་བར་འདུག་ཅེས་མ་སྨྲས་པ་ལྟ་བུའོ།",
    "དུས་དང་མཐུན་པའྱི་ཆུ་དང་འདུག་པའྱི་སན་སོགས་ཀང་བསབ་པར་བྱའོ།",
    "མྱི་མཐུན་པ་དང་ཁྱིམ་གཞན་འདུག།",
    "རང་བས་གཞོན་དང་མྱི་སང་འདུག།",
    "མྱི་བདེ་བར་འདུག་ལུང་ནོད་ཞུགས།",
    "ཡེངས་དང་ཟས་ཀྱི་གལ་ན་འདུག།",
    "དྲུག་སེ་སབས་ཕྱི་སའྱི་ཁང་པར་འདུག་ནས་གཞན་དག་བྱུང་ཚེ།",
    "འགའ་ཞྱིག་འགེངས་ནས་ཁམས་དྱི་བ་སོགས་བྱས་པས་ས་ལ་འདུག་ནས་ཀང་ནྱི་བལྟ་བར་བྱའོ།",
    "ཡང་ན་སོ་གསུམ་པོ་དེ་དག་ལེགས་པར་མ་དོད་པས་དགའ་བ་མྱི་སྐྱེད་པའྱི་གནས་སུ་འདུག་གོ་ཞེས་པ་དང་།",
    "རྒྱལ་པོའི་རྒྱལ་མཚན་དང་རང་གྱི་མགོ་སེ་སོབས་ཀྱིས་འཕོག་པ་ནྱི་བཙན་འཕོག་ཅེས་སུ་བརོད་དོ།"
  ]
}