    "བ་ནི་དེ་གཉིས་ཀྱི་འཆི་བ་ཡིན་ལ་སེམས་གསལ་རུང་མི་གསལ་རུང་རང་གཞན་གྱི་རྐྱེན་མ་ཚང་བས་དགེ་མི་དགེ་མངོན་དུ་བྱེད་མི་ནུས་པ་ནི་ལུང་མ་བསྟན་གྱི་འཆི་བ་ཡིན་ནོ།",
    "འཁོར་ལོས་བསྒྱུར་དང་རང་འབྱུང་ངོ།",
    "ཁོང་ཁྲོ་ནི་ཡིད་དུ་མི་འོང་བ་དང་རང་དང་མི་མཐུན་པའི་ལྟ་བ་ལའོ།",
    "བགྲོད་མིན་འགྲོ་བར་འདོད་པ་ཡིས།",
    "དེ་དང་ལྷན་ཅིག་འདུག་མི་བྱ།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "ལོག་ཤེས་ལམ་དུ་འགྲོ་ན་བློ་ཐམས་ཅད་ལམ་དུ་འགྲོ་བར་འགྱུར་བའི་ཕྱིར་དང་ལོག་ཤེས་ཀྱི་ཆ་ཡོད་པས་དེ་སྐད་དུ་བརྗོད་ན་མ་རྟོགས་པ་དང་རང་རིག་ལ་སོགས་པའང་ཡོད་པའི་ཕྱིར་རོ།",
    "སྒྲོ་འདོགས་བཅུ་དྲུག་དུས་གཅིག་ལ་གཅོད་པའམ།",
    "བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "ཡོན་ཏན་འདི་དག་ཕལ་ཆེར་ནི་གནས་དང་དམིགས་པ་དང་རྣམ་པ་དང་རང་བཞིན་དང་གྲོགས་ཏེ་རྣམ་པ་ལྔས་རིག་པར་བྱའོ།",
    "དེ་དང་རང་ཉིད་ལྷར་དམིགས་པའི་ཆ་ནི་བསྐྱེད་རིམ་སྟེ་གསལ་བའི་མཚན་ཉིད།",
    "ལྷར་སྣང་རང་བཞིན་ཡོངས་ཤེས་སོ།",
    "དེ་ཙ་ན།",
    "མཚམས་ཀྱི་ཀུན་སྤྱོད་ཟ་ཉལ་འགྲོ་འདུག་ཁྲུས་སོགས་རྣལ་འབྱོར་བྱ།",
    "འགྲོ་འདུག་སྐོར་བའི་རྣལ་འབྱོར།",
    "ཐ་མས་ཡི་དམ་ལ་བསྐོར་བ་བྱེད་པར་བསམ་པས་འགྲོ་འདུག་སྐོར་བའི་རྣལ་འབྱོར་ཞེས་གསུངས་ཏེ།",
    "འདུག་ཟིན་དུས་ལ་མི་སྙེག་གོ།",
    "འཇུག་དུས་ཡབ་ཡུམ་ཁྲིལ་གྱིས་འཁྲིལ་བར་བསམ།",
    "འགྲོ་འདུག་ལས་ཁུར།",
    "བདེ་བས་ཡིད་ཚིམ་ཞིང་རངས་པས་རངས་མ།",
    "དེར་ཡང་རང་བཞིན་ལས་གཡོ་བ་མེད་པ་ནི་འཁོར་ལོའི་དབུས་སུ་ལྟ་བའི་དོན་ཏེ།",
    "འདི་ལ་ཉི་ཟླའི་ཟེར་གྱིས་ཡེ་ཤེས་ངོ་སྤྲོད་པ་ཞེས་གསུངས་པའི་ཉི་ཟླའི་ཟེར་དེ་གསལ་ཡང་རང་བཞིན་མེད་པས་མཚོན་ནས་སྣང་ལ་རང་བཞིན་མེད་པ་བསྐྱེད་རིམ་སྒྱུ་མའི་སྒོམ་རིམ་བསྟན་པ་ཡིན་ལ།",
    "སྒྱུ་མར་སྣང་ཙམ་དེ་ཡང་རང་བཞིན་མ་གྲུབ་པར་རྟོགས་པས་དང་།",
    "བསྲུང་བྱ་སྲུང་བྱེད་ཀྱི་འཁོར་གསུམ་ཡང་རང་བཞིན་མེད་པའི་སྒྱུ་མར་རྟོགས་པས་བསྲུང་འཁོར་སོགས་མི་དགོས་པའོ།",
    "བཟང་ངན་སྒྱུ་མ་ཅིར་སྣང་རང་གྲོལ་འགྱུར།",
    "ཅིར་སྣང་རང་གྲོལ་འགྱུར་གྱིས་བསྟན་པའང་ཡིན་ནོ།",
    "རིག་དུས་ན་རིག་བྱ་རིག་བྱེད་ལས་གྲོལ་བས་གཟུང་འཛིན་སྤྲོས་བྲལ་གྱི་གནས་ལུགས་ལེགས་པར་མཐོང་བས་ཡིན་ལ།",
    "ཨཱུ་རིང་པོ་བཞག་དུས་ཀྱི་འཁོར་ལོར།",
    "འཆར་དུས་སུ་ཡང་རང་ཚུལ་ལས་གཡོས་པ་མེད་པའོ།",
    "རྣལ་འབྱོར་པས་གྲོང་འཇུག་བྱེད་པའང་རང་དོན་ལ་ལམ་སྦྱོར་བ་ཉིད་དམིགས་གཏད་ཀྱི་གཙོ་བོར་བྱས་པས་སོ།",
    "ཐབས་ཀྱི་རྐང་པ་རྒྱབ་ཏུ་བཅིངས་ནས་བསྐྱོད་པ་སྟེ་ནཱ་རིའི་འདུག་སྟངས་ཞེས་ཀྱང་བྱ་ལ།",
    "ཅིར་ཡང་གཞི་མེད་རང་བྱུང་རང་ལ་ལྟོས།",
    "དེ་ལྟ་བུའི་རྣམ་པ་ཅིར་སྣང་རང་བཞིན་མེད་པའམ་རང་ཚུགས་ཐུབ་པ་མེད་པའི་ཕྱིར་གཞི་རྩ་བྲལ་བ་དང་།",
    "དང་རང་ལས་འཕྲོས་པའི་སྣང་རྟོག་ཇི་སྙེད་པ་ནི་འཇིག་རྟེན་པ་སྟེ།",
    "དེ་བས་སྒྲུབ་པ་པོས་སྣང་རྟོག་ཐམས་ཅད་ཀྱང་རང་བཞིན་ཤེས་པར་སྤྱོད་པས་དེ་བཞིན་ཉིད་ཀྱི་བདག་ཉིད་ཀྱི་རྗེས་སུ་འགྲོ་བ་སྟེ།",
    "ཅིའི་ཕྱིར་གཤིས་གདངས་ཟུང་འཇུག་བདེ་ཆེན་དང་ལོངས་སྐུར་བཞག་ཙ་ན།",
    "གདངས་སྟོང་གཟུགས་ཀྱང་དེ་ལས་སྤྲོས་པ་དང་རང་བཞིན་བདེ་བར་ཡོད་པས།",
    "སྒྲིབ་པ་ཆེད་དུ་མ་སྤངས་ཀྱང་རང་ལུགས་མཐོང་བས་དེ་དག་པ་རང་དག་གོ།",
    "དེ་ལ་དོན་གྱི་འོད་གསལ་ནི་སྣང་གསུམ་དང་རང་བཞིན་བརྒྱད་ཅུ་དངོས་ཀྱི་གཉེན་པོར་གྱུར་པ་ཡིན་ཀྱང་།",
    "གཉིད་བསམ་གཏན་དུ་བསྲེ་ཞིང་རང་བཞིན་འོད་གསལ་དུ་བསྲེ་བ།",
    "རྟོག་པ་དང་ཉམས་སྣང་རང་གྲོལ་དུ་གཏོང་བའོ།",
    "འོན་ཀྱང་རང་ཉིད་མྱོས་པར་མི་འགྱུར་ཞིང་།",
    "སྣང་བ་དེ་ཐམས་ཅད་ཀྱང་རང་བཞིན་བདེ་ཆེན་ལས་མི་འདའ་བས་དེ་དག་ལ་དམ་ཚིག་ཅན་དུ་བརྗོད་དོ།",
    "རྩ་བ་སུན་འབྱེན་གྱི་འགྲེལ་པ་འདི་ལུང་རིགས་ཀྱིས་ཚར་བཅད་ལ་ཁོ་རང་གསུབ་ཏུ་གཞུག་དགོས་གསུངས་ནས་འབྱོན་པར་བརྩམས།",
    "དགེ་སློང་དག་དུས་ནི་གསུམ་སྟེ།",
    "སྣ་དང་ལ་སོགས་པ་ལྕེ་དང་ལུས་གསུམ་གྱིས་ནི་རང་རང་དང་ཕྲད་པ་འཛིན་པས་ཡུལ་ནི་མཉམ་པ་འཛིན་པར་འདོད་དེ།",
    "བསམ་གཏན་དང་པོའི་མིག་ཤེས་དེའི་ཡུལ་དུ་ནི་གོང་འོག་དང་རང་སའི་གཟུགས་རིགས་ཐམས་ཅད་མངོན་དུ་འགྱུར་རོ།",
    "ངེས་ལྡན་གསུམ་རང་རང་བསྣན་ནས་བཞི་བཞི་དང་གདོན་མི་ཟ་བར་ལྡན་པའི་ཕྱིར།",
    "སྔ་མ་བདུན་གྱི་སྟེང་དུ་རང་རང་བསྣན་པས་བརྒྱད་དང་ལྡན་པའི་ཕྱིར།",
    "ངེས་ལྡན་གསུམ་བདེ་བ་ཡིད་བདེ་དད་སོགས་ལྔ་རང་རང་དང་ལྡན་པའི་ཕྱིར།",
    "སྔར་གྱི་བརྒྱད་དང་རང་ཉིད་དང་དགུ་ལྡན་པའི་ཕྱིར།",
    "སེམས་ཀྱི་རྗེས་འཇུག་དུས་དང་ནི།",
    "དེའང་རང་ས་དམན་པ་ལ་ནི་མ་ཡིན་གྱི་མཉམ་པ་དང་ཁྱད་པར་ཅན་གྱི་ཡིན་ཏེ།",
    "དེའང་རང་སར་སྐྱེས་པ་དང་འབྲས་བུ་དེ་ལས་ཀུན་འགྲོ་དེ་ཉིད་དུས་སྔ་བར་སྐྱེས་པའོ།",
