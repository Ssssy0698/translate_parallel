    "བདག་མེད་པར་བསྟན་པར་ཡང་རུང་སྟེ།",
    "མྱ་ངན་ལས་འདས་པའི་དུས་ན་གསེར་གྱི་འབྱུང་ཁྱངས་སུ་གསེར་གྱི་ཁམས་བཙོ་སྐྱེ་བ་ལ་སོགས་པའི་ཆོ་གས་དྲི་མ་མེད་པར་འགྱུར་བ་བཞིན་དུ་དེ་ཉིད་མ་རིག་པས་གློངས་པའི་ཉེས་པ་དྲི་མ་ཐམས་ཅད་ཤེས་རབ་ཀྱི་ཚུལ་གྱིས་སྤངས་ཏེ།",
    "ཁྱད་པར་ལ་སོགས་པར་བརྟག་པར་མི་བྱའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐོབ་པར་བྱ་བ་དང་།",
    "བདག་དང་གཞན་ལ་ཕན་པར་བྱ་བ་དང་།",
    "སེམས་ཙམ་པོ་ལ་རྣམ་པར་བརྟགས།",
    "གང་ཟག་ནི་སྐྱེས་བུ་དང་རིག་པ་པོ་ལ་སོགས་པར་སེམས་ཉིད་ལ་མིང་ཐ་དད་པར་འདོགས་སོ།",
    "ཆུད་པའི་རྒྱུན་མ་གཏོགས་པར་ཡང་རྟག་པ་དང་།",
    "བདེ་བ་དང་སྡུག་བསྔལ་དུ་ཡང་དག་པར་ཚོར་བར་འབྱེད་པས་དབྱེ་བ་ན་རྟག་པ་པོར་མི་རིགས་ཏེ།",
    "བློ་ཡང་སྐད་ཅིག་པ་གཞན་དུ་མི་གནས་ཏེ་གྲངས་ཅན་འདོད་པ་ལྟར་རྒྱུན་གྱི་ཡུལ་ལ་གཅིག་པར་ལྷག་པར་ཆགས་པར་མི་རིགས་ཏེ།",
    "སྐྱེས་བུ་ཡང་གྲང་བ་དང་དྲོ་བ་ལ་སོགས་པ་བཞིན་པས་ན་གཅིག་པར་མི་རུང་བ་སྟེ་ཚོར་བ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "ཕྱིའི་དོན་ཡང་རྣམ་པར་ཤེས་པ་མ་གཏོགས་པར་དངོས་པོ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཤེས་པ་ཡང་རྣམ་པ་གཅིག་པར་མི་རུང་སྟེ།",
    "སྣ་ཚོགས་པ་གཅིག་པར་ཡང་སྤྱོམི་འཐད་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཀྱིས་དབེན་པར་ཡོངས་སུ་ཤེས་པ་ན་དྲི་མ་མེད་པ་པྱམི་གཉིས་པར་འགྱུར་རོ།",
    "ཕྱི་རོལ་གྱེ་དོན་མེད་པའི་ཕྱིར་གཟུང་བ་དང་འཛིན་པ་དག་ཀྱང་མེད་དེ་ཅིས་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོར་འཛིན་པར་འགྱུར།",
    "བསམ་པ་མེད་ཅིང་སྣང་བ་མེད་པ་དོན་དམ་པའི་བདེན་པ་མི་གཉིས་པར་ཡང་དག་པར་རིག་པ་ནི་བདག་ལ་ཡང་རིག་པར་བྱ་བ་དང་།",
    "རིག་པ་པོའི་དངོས་པོར་མི་འཛིན་ན་ཐ་དད་པར་ལྟ་ཅི་སྨོས།",
    "མི་སྣང་ན་ཇི་ལྟར་ན་རྣམ་པར་རྟོག་པར་འགྱུར།",
    "རྐྱེན་རྣམས་ཡོད་པར་མི་རུང་སྟེ།",
    "གཞན་གྱི་ཁྱད་པར་མེད་ཀྱང་རྐྱེན་འགའ་ཞིག་ལས་རང་བཞིན་ངེས་པའོ།",
    "གཟུང་བ་མེད་པས་ན་ཕྱི་རོལ་གྱེ་དོན་མེད་དེ་ཇི་ལྟར་འདི་ཉིད་དུ་བསྒྲུབ་པར་མཛད་པ།",
    "གང་དག་ཡང་ཕྱོགས་ཐ་དད་པར་ཕྱེ་བ་ན་ཁང་པ་དང་།",
    "བྱེད་པ་ལ་སོགས་པ་ཡོངས་སུ་ཤེས་པའི་ཁྱད་པར་ནི་ཆུད་པའི་བདག་ཉིད་ཀྱི་ཡིན་ནོ།",
    "གལ་ཏེ་འདོད་ཆགས་དང་བྲལ་བ་ཞིག་ན་ནི་གཞན་ལ་གནོད་པ་ཇི་ལྟར་བྱེད་པར་འགྱུར།",
    "བདག་ཉིད་ལ་ཕན་པར་མི་ནུས་ན་གཞན་ལ་ཕན་པར་ཀྱེཅིས་ན་བྱེད་པར་འགྱུར།",
    "འབྲོག་དང་ཤིང་ལ་སོགས་པ་དེ་དག་ཐམས་ཅད་ནི་བློ་ཅན་གྱི་སྐྱེས་བུས་སྔར་བྱས་པར་མི་བཟུང་སྟེ།",
    "ལྷ་ཁང་ལ་སོགས་པའི་འབྲས་བུ་ལས་ཐིག་བཏབ་པ་ལ་སོགས་པ་རྗེས་སུ་དཔག་པ་བཞིན་པ་འབྱེལ་པ་བཟུང་ཉུརྟེནས་རྣམ་པ་དེ་ལྟ་བུ་ལ་ནི་ཆུད་པར་བྱ་བ་དང་།",
    "ཆུད་པར་བྱེད་པའི་དངོས་པོར་རུང་ངོ།",
    "དབུལ་བ་ལ་སོགས་པ་རྣམས་ཀྱི་ཁྱད་པར་དམིགས་སུ་མེད་པར་འགྱུར་ལ།",
    "ཐམས་ཅད་ཀྱང་ཞི་བའི་རང་བཞིན་པར་འགྱུར་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པས་ཀྱང་བཀའ་སྩལ་པ།",
    "འཇིག་པའི་ལྟ་བ་རྣམ་པར་སྤོང་བ་ནི་སྐྱེ་བ་དང་།",
    "རབ་རིབ་ལ་སོགས་པར་ཁྱེ་སྣང་བ་བཞིན་དུ་དོན་དམ་པར་གཉིས་ཀྱི་རྣམ་པ་ཐམས་ཅད་སྐྱེ་བ་དང་།",
