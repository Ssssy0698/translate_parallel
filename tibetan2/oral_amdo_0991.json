    "བཞིན་བཟངས་ཁྱོད་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "འཕགས་པ་བཀྲུ་བཤལ་ས་འདིར་གཅིག་གིས་མི་གཙང་བ་བླུགས་ཏེ་ལས་བགྱིར་མ་མཆིས་པས་ད་ཇི་ལྟར་འཚོ་བ་སྦྱར་བར་བགྱི་མ་འཚལ་ཏོ།",
    "བཀྲེན་པ་ཁྱོད་འདི་ལྟར་མི་དགའ་བར་བྱའོ།",
    "ཉོན་མོངས་པ་ནི་མི་བཟོད་པ།",
    "ཚེ་དང་ལྡན་པ་ཉེ་དགའ་ལྡུམ་པའི་གན་དུ་སོང་སྟེ་སྨྲས་པ།",
    "འཕགས་པ་ཁྱོད་ཀྱིས་སྔོན་ནི་བདག་ཅག་བསྲུང་བ་བྱས་པར་གྱུར་ན།",
    "དེང་སང་མི་བྱེད་པས་ཅིའི་ཕྱིར་ཁྱོད་ལ་ལྡུམ་སྦྱིན།",
    "དེས་སྡོད་ཅིག་བྱས་ཏེ་སོང་ནས་དེས་བསམས་པ།",
    "མི་གཙང་བས་གྱོ་མོ་བཀང་ནས་ཕྱགས་མ་ཐོགས་ཏེ།",
    "ལྡུམ་ཞིང་གི་སྟེང་དུ་ཐམས་ཅད་དུ་མི་གཙང་བས་གཏོར་ནས།",
    "དེ་དག་གིས་ཀྱང་ལྡུམ་ཐམས་ཅད་མ་རུང་བར་བྱས་སོ།",
    "ནང་པར་སྔར་ལངས་ཏེ་ལྡུམ་རར་སོང་བ་དང་།",
    "ཉེ་དགས་དེའི་ཆེད་དུ་བསམས་ཏེ་ཕྱོགས་དེར་སོང་ནས་སྨྲས་པ།",
    "བཞིན་བཟངས་ཁྱོད་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "འཕགས་པ་དག་ལྡུམ་ཞིང་འདིར་གཅིག་གིས་མི་གཙང་བ་གཏོར་ཞིང་ཝས་ཀྱང་ཟོས་ཏེ།",
    "བཀྲེན་པ་ཁྱོད་དེ་ལྟར་མི་དགའ་བར་བྱའོ།",
    "ཉོན་མོངས་པ་ནི་མི་བཟོད་པ།",
    "ཚེ་དང་ལྡན་པ་ཉེ་དགའ་ལ་དགེ་སྐོས་ཀྱི་བསོད་སྙོམས་ནོད་པའི་རེས་བབ་པ་ནས།",
    "བདག་གིས་དེ་ལ་ཇི་སྐད་བརྗོད་པར་བྱས་རྣམ་པ་ཐམས་ཅད་དུ་གོམ་པ་དག་གིས་ས་གཞི་གཞལ་བར་བྱའོ་སྙམ་ནས།",
    "དེ་གོམ་པ་དག་གིས་ས་གཞི་འཇལ་ཞིང་དལ་བུས་འོང་བ་དང་།",
    "དེ་ཡུན་རིང་དུ་ཐོགས་པས་བདག་ཟན་ཆད་ན་མི་རུང་གིས་བལྟའོ་སྙམ་ནས།",
    "ཚེ་དང་ལྡན་པ་ཁྱོད་འགྲོས་དེ་ལྟ་བུར་འོང་བ་ལས་ན།",
    "དོན་གྱིས་ན་ཁྱོད་ཀྱིས་ཆེད་དུ་བསམས་ཏེ་ཁོ་བོ་ཟན་བཅད་དུ་བཅུག་གོ།",
    "ཁྱོད་ཀྱིས་ཁོ་བོ་ཇི་ལྟར་མཐོང་ཁོ་བོས་ཤིང་ལྗོན་པ་ལ་འཛེགས་ཏེ་བལྟས་སོ།",
    "ཁྱོད་ཤིང་ལྗོན་པ་ལ་འཛེག་ཏུ་རུང་ངམ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་ཤིང་ལ་མི་འཛེག་པར་བསླབ་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་ཤིང་ལ་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བཀའ་སྩལ་ནས།",
    "སྟག་གིས་མཆོངས་པ་བྱས་པས་བསད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཉོན་མོངས་པ་ནི་དུས་དང་བྱ་བ་མི་ཤེས་པ།",
    "དེ་ལ་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་ལ་ཅི་འདི་ལ་ཁྱེད་ཡོངས་སུ་དག་གམ་ཞེས་དྲིའོ།",
    "སྡོམ་ལ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་དང་དགོས་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "དེ་ལ་འཁྲུག་ལོང་གི་རྒྱུ་བཞི་གང་ཞེ་ན།",
    "འཁྲུག་ལོང་གི་རྩོད་པ་བཞི་གང་ཞེ་ན།",
    "འཁྲུག་ལོང་གི་རྒྱུ་བཞི་པ་ལས་ལ་མཐུན་པ་མི་སྦྱིན་པ་ལས་བྱུང་བའི་འཁྲུག་ལོང་བྱ་བའི་ཕྱིར་རྩོད་པ་ནི།",
    "འཁྲུག་ལོང་གི་རྒྱུ་དང་པོའི་དེ་བཞིན་ཉིད་ལས་ལོག་པར་སྒྲུབ་པ་ལས་བྱུང་བའི་འཁྲུག་ལོང་འགྱེད་པའི་ཕྱིར་རྩོད་པ་ཡིན་ཏེ།",
    "འཁྲུག་ལོང་གི་རྒྱུ་གཉིས་པ་གདམས་ངག་ལ་སོགས་པ་འཇོག་པས་གཞན་སྤོང་བ་ལས་བྱུང་བའི་འཁྲུག་ལོང་མི་གདམས་པའི་ཕྱིར་རྩོད་པ་རྒྱུ་དང་བཅས་པ་ཉིད་ཀྱང་ཡིན་ཏེ།",
    "རྩོད་པ་བྱུང་བར་གྱུར་པ་རྣམས་ཞེས་བྱ་བ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་བཞི་ལས་བྱུང་བའི་འཁྲུག་ལོང་གི་རྩོད་པ་བཞི་པོ་རྣམས་སོ།",
    "མཇུག་གི་གནས་སྐབས་སམ།",
    "དེ་ལ་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་ལ་ཅི་འདི་ལ་ཁྱེད་ཡོངས་སུ་དག་གམ་ཞེས་ལན་གཉིས་ལན་གསུམ་དུ་དྲིའོ།",
    "དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བ་ཡིན་གྱི་ཁྲོ་བ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བ་འཁྲུག་ལོང་ཡིན་པ་ལ་དེ་ཉིད་རྩོད་པ་ཡིན་ན།",
    "འདི་ལྟར་འཐབ་པ་ལ་སོགས་པ་ནི་དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བའི་ཕྱིར་འཁྲུག་ལོང་འདིའི་འཁོར་ཡིན་ཏེ།",
    "རྩོད་པ་བཞི་པོ་གང་དག་ཡིན་པ་དེ་དག་གི་རང་གི་ངོ་བོ་ངེས་པར་བཟུང་བའི་ཕྱིར།",
    "འཁྲུག་ལོང་གི་རྒྱུ་བཞི་ལས།",
    "འཁྲུག་ལོང་གི་རྩོད་པ་བཞི་གོ་རིམས་བཞིན་དུ་འབྱུང་སྟེ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འཁྲུག་ལོང་གི་རྒྱུ་བཞི་གང་ཞེ་ན།",
    "དེ་ལ་དཔྱོད་པ་ཞེས་བྱ་བ་ནི་ཅིའི་ཕྱིར་ཁྱོད་ཀྱི་བྱ་བ་འདི་མ་བྱས་ལ།",
    "དངོས་པོའི་རྣམ་པ་ལ་དཔྱོད་པ་དེ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་དང་པོ་ཡིན་ནོ།",
    "དེ་ལས་འཁྲུག་ལོང་གི་རྒྱུ་དང་པོ་འགྱེད་པའི་ཕྱིར་རྩོད་པ་འབྱུང་སྟེ།",
    "དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བའི་འཁྲུག་ལོང་འཐབ་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ཁྱོད་ལ་བརྗོད་པ་དང་བཅས་པ་ཉིད་བྱས་ཀྱིས།",
    "གསོ་སྦྱོང་གི་དུས་སུ་དེ་ལ་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་དེའི་གསོ་སྦྱོང་གཞག་པར་བྱའོ།",
    "སྨྱོན་པས་བྱས་པས་གླེང་བ་དག་གིས་སྤོང་བའོ།",
    "དེ་ལྟར་གདམས་ངག་ལ་སོགས་པ་འཇོག་པས་གཞན་སྤོང་བ་དེ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་གཉིས་པ་ཡིན་ནོ།"
  ]
}