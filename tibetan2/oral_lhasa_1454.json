    "འདི་དག་ནི་སྐྱེས་བུ་རྣམས་ཀྱི་རྒྱན་གྱིས་འབྱོར་པ་སྟོན་པར་བྱེད་པ་གདུ་བུ་རྒྱན་ཅན་དང་དཔུང་རྒྱན་དང་ལག་རྒྱན་ལ་སོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "ལུས་ཅན་ཁྱད་པར་ཐོབ་པའི་ཡོན་ཏན་གྱིས།",
    "དེ་ལྟ་ཡིན་ན་གོ་རིམས་ཟློག་པའི་ཉེས་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དེའི་ཕྱིར་ཉེས་པ་ལས་རྣམ་པར་གྲོལ་བ་ཉིད་ཀྱིས་ཡོན་ཏན་གནས་པར་གྲུབ་ན་འདིས་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "དེ་བས་ན་ཁྱད་པར་འདི་གཉི་ག་བརྗོད་དོ།",
    "འོན་ཏེ་སྡུག་བསྔལ་དང་དུ་ལེན་པ་དེ་ལས་བཟོད་པར་འགྱུར་ལ།",
    "འབྲས་ཆན་གྲུབ་པ་ལ་ཡང་དེ་ཉིད་འབྲས་བུ་ཉིད་དུ་བརྗོད་པར་འདོད་པས་དེ་གྲུབ་གྲུབ་པ་ཞེས་བྱ་བ་མ་ཡིན་ནམ།",
    "སྐྱེས་རབས། གཏི་༡༨༧ཞིག་ཕུལ་དུ་དབྱུང་དུ་ཡོད་པ་གང་ཡིན་པ་ནི་དེ་ཉིད་འབྲས་བུ་ཉིད་དུ་བརྗོད་པར་འདོད་པས་ཉེས་པ་མེད་དོ།",
    "དྲུག་པ་དང་བདུན་པ་དག་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "༣ ༤༧འགྲོ་། ཞེས་འཆད་པར་འགྱུར་རོ།",
    "ཁ་ཅིག་ནི་དོན་ངེས་པར་མ་ཟིན་པས་ཆད་པར་ལྟ་བར་ལྟུང་སྟེ།",
    "ངེས་པར་ལེགས་པ་ལ་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་བྱེ་བྲག་ཏུ་སྟོན་པར་བྱེད་དོ།",
    "བདེ་བ་ལ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དོན་ཕྱིན་ཅི་མ་ལོག་པར་རབ་ཏུ་ཤེས་པས་ན་ཤེས་རབ་སྟེ་བློའི་ཁྱད་པར་རོ།",
    "སྔ་མ་ནི་སྒྲུབ་པའི་ཁྱད་པར་རོ།",
    "དེའི་ཕྱིར་དད་པ་ཅན་ལ་བརྟེན་ནས་ཞེས་བྱ་བ་རྣམ་པར་དབྱེ་བ་སྔ་མ་བཞིན་ནོ།",
    "རྟེན་པར་བྱེད་པ་ནི་བྱེད་པའོ།",
    "རིག་ཅེས་བྱ་བ་ནི་ཤེས་པའོ་། དད་པ་ཡང་བརྒྱུད་པས་ངེས་པར་ལེགས་པའི་རྒྱུར་འགྱུར་བ་ཉིད་དེ།",
    "ཡིན་ཞེས་བྱ་བ་ནི་ངེས་པར་གཟུང་བ་སྟེ།",
    "མི་འདོར་བ་དེ་ནི་དད་པ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བར་ཤེས་པར་བྱ་ཞིང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "མི་ཞེས་བྱ་བ་ནི་གསོད་པ་མེད་པ་ཁོ་ནའོ་ཞེས་མེད་པར་དགག་པ་ཡིན་པས་མི་གསོད་པ་ནི་སྲོག་གཅོད་པ་སྤངས་པ་ཡིན་ནོ།",
    "དེ་སྤོང་བ་ནི་བསམ་པ་ཐག་པ་ནས་ལོག་པ་སྟེ་མ་བྱིན་པར་ལེན་པ་སྤངས་པ་ཡིན་ནོ།",
    "དེ་དག་སྤོང་བ་ནི་ཡོངས་སུ་སྤོང་བ་སྟེ་། འདོད་པས་ལོག་པར་གཡེམ་པ་སྤོང་བ་ཡིན་ནོ།",
    "དེ་དག་ནི་ལོག་པར་ལྟ་བ་ལ་སོགས་པ་ཡང་ཡིན་ལ་སྨྲ་བ་ཡང་ཡིན་པས་ཞེས་ཚིག་རྣམ་པར་སྦྱར་ནས་ཚིག་བསྡུའོ།",
    "དེ་དག་ཡང་དག་པར་སྡོམ་པ་ནི་སེམས་ཀྱིས་བག་བྱ་བ་སྟེ་སྤོང་བའོ།",
    "བཅུ་ཞེས་བགྲང་བ་ནི་བདེ་བླག་ཏུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "མྱོས་པར་འགྱུར་བས་ན་ཆང་སྟེ།",
    "མི་བྱ་བ་ཅི་ཡང་མེད་པས་མེད་པར་དགག་པའི་ཚུལ་གྱིས་ཞེས་བྱ་བ་ནི་དགག་པ་ཡིན་ནོ།",
    "རྣམ་པར་འཚེ་བ་ནི་རྣ་བ་དང་སྣ་གཅོད་པ་དང་རྡེག་པ་དང་།",
    "དེ་ལྟ་བུ་མེད་པས་ན་རྣམ་པར་མི་འཚེ་བའོ།",
    "དད་པའི་ཆུ་ཀླུང་དྲི་མེད་བྱས་པ་ཡིད་ཀྱིས་ནི།",
    "གནོད་པར་བྱེད་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདི་ལྟར་ལུས་གདུང་བ་དེ་ནི་འབའ་ཞིག་པས་ནི་གཞན་ལ་གནོད་པ་སྟེ་གནོད་པར་བྱེད་པ་སྤོང་བར་བྱེད་ཅིང་ལྡོག་པ་ཡང་མེད་ལ།",
    "གང་ཞིག་མ་བྱིན་པར་ལེན་པ་སྤངས་པ་དེ་ཇི་ལྟར་བརྣབ་སེམས་སྐྱེད་པར་འགྱུར།",
    "གསོད་པ་སྤངས་པ་ཡང་ཇི་ལྟར་གནོད་སེམས་སྐྱེད་པར་འགྱུར།",
    "བཅུ་པ་སྤངས་པར་གསུངས་པ་ནི།",
    "གནོད་པ་བྱས་པ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པ་དང་།",
    "དེ་དག་ཉིད་གནོད་པར་བྱེད་པའི་ཕྱིར་གདུག་པའོ།",
    "རབ་ཏུ་འཇུག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་གང་དུ་ཚེ་ཇི་སྲིད་པར་གསུངས་པ་དེ་སྲིད་དུ་ཐམས་ཅད་མི་འཐོབ་པའོ།",
    "རྐུ་ིབ་ནི་མ་བྱིན་པར་ལེན་པ་སྟེ།",
    "སྤྱད་པར་བྱ་བས་ན་ལོངས་སྤྱོད་དེ།",
    "དེས་ནི་ཕན་པར་འདོད་པའི་བཤེས་དང་འབྱེ་ཞིང་འབྲལ་བར་འགྱུར་རོ།",
    "འཇིག་རྟེན་ཕ་རོལ་ལ་སོགས་པ་མེད་པའི་རྣམ་པ་ཅན་གྱི་ལྟ་བ་ནི་ལོག་པར་ལྟ་བ་སྟེ།",
    "དེ་ཐོབ་པར་འགྱུར་ཏེ།",
    "ཡང་ལོག་པར་ལྟ་བ་ཁོ་ནར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "༣ ༥༩པ་སྟེ་འཐོབ་པར་འགྱུར་ཞེས་བྱ་བ་ལྷག་མ་ཡིན་ནོ།",
    "དེ་གཉིས་ཀྱི་འབྲས་བུ་ནི་མི་འདོད་པ་འདི་གཉིས་ཡིན་པར་དམིགས་ནས་སྤང་བར་རིགས་སོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ཞེ་སྡང་ནི་གསོད་པར་བྱེད་པའི་བདག་ཉིད་དོ།",
    "དེ་སྟོན་པར་མཛད་དེ།",
    "བདེ་བ་ནི་ཚིམ་པར་བྱེད་པའི་ཚོར་བའོ།",
    "རྒྱས་པ་ཞེས་བྱ་བའི་སྒྲ་ནི་ཐམས་ཅད་ལ་བརྗོད་པར་བྱའོ།",
    "གཟུགས་མེད་པ་ནི་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སོགས་པ་སྙོམས་པར་འཇུག་པ་བཞི་སྟེ།",
    "ནི་ཞེས་བྱ་བའི་སྒྲ་ནི་དེ་ཁོ་ན་ཞེས་བྱ་བ་ངེས་པར་བཟུང་བ་ཡིན་ནོ།",
    "དེ་ཉིད་ངེས་པར་ལེགས་པ་ཡིན་ནོ།",
    "ཕྲ་ཞེས་བྱ་བ་ནི་ཕྲ་བ་སྟེ་རྣམ་པར་ཤེས་པར་དཀའ་བ་ཡིན་ནོ།",
    "གང་ལ་ཟབ་པར་སྣང་བ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ་། བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་ཐོས་པ་དང་མི་ལྡན་པ་རྣམས་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་དུ་ནི་ཡོད་པར་མི་འགྱུར་རོ་སྙམ་པ་སྟེ།",
    "ཚེ་རབས་གཞན་དུ་ཡོད་པར་མི་འགྱུར་རོ་སྙམ་པ་སྟེ།",
    "དེ་ལྟར་རྣམ་པར་རྟོག་པའི་བྱིས་པ་བླུན་པོ་ནི་སྐྲག་པར་འགྱུར་རོ།",
    "ལུང་ཉེ་བར་འགོད་པར།",
    "ཡང་དག་པར་ལྡན་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ལ་དེ་གཅིག་ཏུ་ངེས་པར་གསུང་བའི་ངང་ཚུལ་ཡོད་པས་ན་དེ་གསུང་བའོ།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དག་གོ།",
    "བརྫུན་པ་ནི་མི་བདེན་པར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དེ་སྟོན་པར་བྱེད་དེ།",
    "ལྟ་བ་ངན་པར་ལྷུང་བས་དམིགས་སོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེ་ཉིད་དུས་མཉམ་པ་ཉིད་ཡིན་ན་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པའི་ངེས་པ་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་བརྟགས་ན་ངར་འཛིན་པ་ནི་ཟད་པར་འགྱུར།",
    "ཅི་སྟེ་ཅིའི་ཕྱིར་འཇིགས་པར་བྱེད་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "དངོས་པོ་ཡིན་པར་མི་སྲིད་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་འོ་ན་ཅི་ཞེ་ན་དངོས་པོ་མེད་པ་ཡང་ངོ།",
    "༣ ༦༩ཅད་དུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་སྨྲ་ོན་མེད་པར་ལྟ་བ་ལ་བརྟེན་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྒྱས་པར་བྱ་ན་ནི་བདེ་བ་དང་།",
    "ཏིང་ངེ་འཛིན་དང་བསམ་གཏན་ལ་སོགས་པ་མེད་དོ་ཞེས་ལྟ་བ་ནི་མེད་པར་ལྟ་བ་སྟེ།",
    "མྱ་ངན་ལས་ཀྱི་འདས་པ་དངོས་པོ་དང་དངོས་པོ་མེད་པར་ཡང་མེད་དོ་ཞེས་དེ་སྐད་དུ་སྨྲ་བས་ཡང་དག་པའི་ལྟ་བ་བསལ་ནས་མེད་པར་ལྟ་བ་ལ་བརྟེན་པའི་ཕྱིར་ལོག་པར་ལྟ་བ་ཁོ་ན་ལ་ཡང་དག་པར་བརྟེན་པར་འགྱུར་རོ་ཞེས་དེ་དགག་པའི་ཕྱིར་མེད་པ་དང་།",
    "མེད་པ་དང་ཡོད་པར་ལྟ་བ་ཉེ་བར་ཞི་བའི་ངོ་བོ་དེའི་ཕྱིར་རོ།",
    "འདས་པ་ཞེས་བྱ་བའི་དོན་ཡང་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ན་ཇི་ལྟར་དངོས་པོ་ལ་སོགས་པའི་ངོ་བོ་ཡིན་པར་འགྱུར།",
    "༣ ༧༡པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཡང་དག་པར་ན་དེ་ཡང་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ཆད་པ་དང་རྟག་པར་ལྟ་ིབ་མི་སྲིད་པར་སྟོན་ཏེ།",
    "འབྲས་བུ་ལ་འགྲོ་ཞིང་སྒྲུབ་པར་བྱེད་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྒྱུ་དང་བཅས་པར་འཇུག་པས་ན་དེ་སྐད་ཅེས་བྱའོ།",
    "ངར་འཛིན་པ་ནི་ཟད་པར་འགྱུར།",
    "ཡང་དག་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་སྔར་སྐྱེས་པ་དང་ཞེས་བྱ་བ་ལ་སོགས་པས་སྟོན་པར་བྱེད་དེ།",
    "དོན་དུ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་རོ།",
    "དོན་ནི་རིགས་པས་བསམས་པ་ལས་ཀྱི་བྱུང་བའི་ཤེས་རབ་ཕྱིན་ཅི་མ་ལོག་པར་དོན་འཛིན་པ་ལ་བྱ་སྟེ།",
    "འབྲས་བུ་བྱུང་བ་ཡིན་ན་དེའི་རྟེན་སྐྱེད་པར་བྱེད་པ་རྒྱུ་ཡིན་ལི།",
    "དེ་ལྟར་ཡང་དག་པ་ཉིད་དུ་སྐྱེ་བ་བཀག་པ་བྱས་པ་དང་།",
    "གང་ལ་ལ་འོ་ན་རྐྱེན་ཉིད་འདི་པ་ཙམ་ཡང་བཀག་གོ་ཞེས་ཟེར་བ་དེ་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "དོན་དེ་ཉིད་དཔེ་གཞན་གྱིས་སྒྲུབ་པར་བྱེད་དེ།",
    "ཡང་དག་པར་ན་སྐྱེ་བ་མེད་པའི་ཕྱིར་ཏེ།",
    "དཔེར་ན་མར་མེ་བྱུང་ན་འོད་བྱུང་བ་བཞིན་ནོ་ཞེས་བྱ་བ་མར་མེ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "འོ་ན་ཅི་ཞེ་ན་ཐ་སྙད་པ་ཡིན་ནོ་ཞེས་མཇུག་ཐོགས་པས་སྟོན་པར་བྱེད་དེ།",
    "ཡང་དག་པར་སྐྱེ་བ་མེད་ཀྱང་མེད་པ་ཉིད་དུ་ཁས་མི་ལེན་ཅིང་ཉེ་བར་མི་འགྲོ་སྟེ་མེད་པ་ཉིད་ཀྱི་ལྟ་བ་མི་འཛིན་ཏོ།",
    "མྱ་ངན་ལས་འདས་པ་དང་བར་ཆད་མེད་པར་གནས་པ་ལ་མི་ཤེས་པ་ཆུང་ངུའི་ཆུང་ངུ་ཡང་འགག་པ་ལ་མངོན་དུ་ཕྱོགས་སོ།",
    "ཆུ་མ་ཡིན་པ་ལ་ཆུའི་རྣམ་པར་མཐོང་བས་སོ།",
    "གལ་ཏེ་ལན་འགའ་ཞིག་སྨིག་རྒྱུ་དེ་ལ་ཆུ་ཡོད་པར་མཐོང་བར་གྱུར་ན་ནི་ལ་ལར་ཡོད་པར་མཐོང་བས་འདི་ན་མེད་དོ་ཞེས་བྱ་བར་རུང་ངོ།",
    "དེ་བཞིན་དུ་སྨིག་རྒྱུ་ལྟ་བུའི་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་ན་སྨིག་རྒྱུ་དང་འདྲའོ།",
    "གཞན་ལ་ཡོད་པ་གང་ཡིན་པ་སུན་ཕྱུང་བ་བྱས་པ་གང་ཡིན་པ་དེ་ཉིད་དངོས་པོའི་སྟོབས་ཀྱི་དོན་གྱིས་མེད་པར་བསླན་དགོས་ཞེས་བྱ་བར་སེམས་ན་དེ་དྲང་བའམ་འཐོབ་པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟར་ཐབས་དེས་མེད་པ་པ་ཉིད་ཀྱི་དོན་རྒྱས་པར་བཀག་པས་ན།",
    "དོན་གྱི་སྟོབས་ཀྱིས་མེད་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བར་རོ།",
    "དེ་ཡང་བསམ་གཏན་དང་འདོན་པ་ལྷུར་ལེན་པའི་ཚངས་པར་སྤྱོད་པ་ལ་སོགས་པའི་ཡོན་ཏན་གྱིས་བརྒྱན་པ་ལ་མེད་དོ།",
    "འོན་ཏེ་རྙེད་པ་དང་བཀུར་སྟི་རྣམ་པར་ཆད་ཀྱིས་དོགས་པས་ཉེས་པར་སྤྱོད་པ་བོར་ནས་ལེགས་པར་སྤྱད་པ་སྤྱོད་དུ་ཟད།",
    "སེམས་ནི་མེད་པར་ལྟ་བས་གནས་སོ་ཞེ་ན།",
    "འགྱུར་བའི་ཚོགས་ལ་ནི་ཡང་དག་པར་ན་མེད་པ་ཉིད་དུ་ཤེས་ཏེ།",
    "གོས་མེད་པ་རྣམས་ཀྱང་ཡིན་པར་སྨྲ་བ་སྟེ།",
    "གང་ལས་དུས་གསུམ་ཆར་ལས་འདས་ཤིང་རྣམ་པར་འདས་པའི་བདག་སྟེ།",
    "དམ་ཞེས་བྱ་བའི་སྒྲ་ནི་རྣམ་པར་རྟོག་པ་སྟེ།",
    "གང་ཕྱིར་གཉི་ག་འོང་ཞེས་བྱ་བ་ལ་སོགས་པས་འཇིག་རྟེན་དང་མྱ་ངན་ལས་འདས་པ་དག་དོན་དམ་པར་ཨིན་ཁྱད་པར་མེད་པར་སྟོན་ཏེ།",
    "འདི་ཐམས་ཅད་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "རྒོལ་བ་ལ་ལ་འདི་སྙམ་དུ་གང་དག་དངོས་པོ་ཐམས་ཅད་སྐྱེ་ཞིང་དགག་པར་འདོད་ན་དེ་དག་ཁོ་ན་ལ་ཉེས་པ་འདིར་འགྱུར་གྱི།",
    "ཁོ་བོ་ཅག་ནི་སྐྱེ་བ་མེད་པ་དང་འགག་པ་མེད་པ་དང་སྐད་ཅིག་མ་མ་ཡིན་པར་འདོད་དེ།",
    "གལ་ཏེ་རྟག་པར་འགྱུར་ན་ནི།",
    "གལ་ཏེ་རྟག་པར་འགྱུར་ན་ནི།",
    "རྟག་པར་ཞེས་བྱ་བ་ནི་དུས་ཐམས་ཅད་དུའོ།",
    "འོན་ཏེ་དེས་འཇིག་པར་འགྱུར་བར་མི་འདོད་ན་དེའི་ཚེ་ཉེས་པ་༧གཞན་གལ་ཏེ་འགྱུར་བ་མེད་ན་ནི།",
    "༡༨༧བརྗོད་པར་ཡང་མི་ནུས་སོ།",
    "རྟག་པའི་ཕྱོགས་གཅིག་ཟད་པར་སྐད་ཅིག་ིམ་ཉིད་དུ་འདོད་ལ།",
    "ཐམས་ཅད་དུ་ཟད་པས་སྐད་ཅིག་མ་ཡིན་པར་ཡང་རྟག་པར་སྨྲ་བ་རྣམས་མི་འདོད་པས་རྣམ་པ་གཉི་ག་ཡང་རིགས་པ་དང་ིལྡན་པ་ཡིན་ནོ།",
    "ཡང་དག་པར་ན་མི་འཐད་པའི་ཕྱིར་དེ་ལྟར་སྐད་ཅིག་མ་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་མེད་ཅེས་བརྗོད་པར་བྱ།",
    "འདི་ནི་དེ་ཁོ་ན་ཉིད་བསམ་པར་བརྗོད་པ་ཡིན་ནོ།",
    "བརྟག་དགོས་ཞེས་བྱ་བ་འདིས་ནི་འདི་རྟོག་པས་ཀུན་ནས་བསླང་བ་ཐ་སྙད་༧པ་ཡིན་གྱི་ཡང་དག་པ་ནི་མ་ཡིན་ནོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "ཇི་ལྟར་སྐད་ཅིག་མའི་ཐ་མ་ལ་སོགས་པ་ལ་བསམ་པ་བྱས་པ་དེ་བཞིན་དུ་ཐོག་མ་ལ་སོགས་པ་ལ་ཡང་བྱའོ།",
    "འོ་ན་བརྡ་སྤྲོད་པ་པས་བརྟགས་པ་སྒྲ་གསལ་ཞེས་བྱ་བའི་སྒྲ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "མ་ཡིན་པར་འགྱུར་རོ་ིསྙམ་དུ་སེམས་ན།",
    "མེད་པར་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དུ་མ་ནི་གཅིག་ལ་ལྟོས་ནས་ཡིན་གྱི་དེ་མེད་པར་ནི་མ་ཡིན་པས་གཅིག་ཀྱང་མེད་ལ་དུ་མ་ཡང་མེད་དོ།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་གཅིག་ཁས་བླངས་པར་གྱུར་ན་ནི་དེ་ལ་ལྟོས་ནས་དེར་འགྱུར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "མེད་པ་ཉིད་ནི་དེ་ལྟ་ཡིན་པར་འགྱུར་གྲང་ན།",
    "དེའི་ཕྱིར་འཇིག་རྟེན་འདི་མཐའ་དང་ལྡན་ནམ་ཅི་ལགས་ཞེས་ཞུས་ན།",
    "བཅོམ་ལྡན་འདས་ཅང་མི་གསུང་བར་བཞུགས་ཏེ།",
    "རྒྱུ་དེ་ཉིད་ཀྱི་ཕྱིར་མཁས་པ་ཤེས་ཉེན་ཅན་རྣམས་ཀྱིས་ཀུན་མཁྱེན་པའི་ངོ་བོར་ཐམས་ཅད་མཁྱེན་པའོ་ཞེས་བྱ་བར་ཤེས་ཤིང་རྟོགས་སོ།",
    "རྒྱལ་བའི་སྲས་རྣམས་དངོས་པོ་རྣམ་པར་འཇིག།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཅེས་གསུངས་པ་ལྟ་བུའོ།",
    "བརྗོད་པ་ནི་ཤེས་པའི་འབྲས་བུ་ཡིན་ནོ་ཞེས་གཞན་ནས་རྒྱས་པར་བསྟན་ཟིན་ཏོ།",
    "རྣམ་པར་བསམས་ནས་དེ་བཞིན་དུ་སྨྲ་བའི་ཕྱིར་རོ།",
    "གང་ལ་ཤེས་པ་སྣང་བར་གྱུར་པ་ཡོད་པ་དེ་ལ་མི་ཤེས་པ་མུན་པར་གྱུར་པ་འགག་སྟེ་སྣང་བ་དང་མུན་པ་བཞིན་ནོ།",
    "གང་ལ་ཡུལ་ཐམས་ཅད་པའི་ཡེ་ཤེས་ཡོད་པ་དེ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཞེས་བྱའོ།",
    "ཡང་དང་ཡང་དུ་བཀའ་སྩལ་པ་ནི་གསུངས་པའོ།",
    "ཁམས་དྲུག་ལ་བཏགས་པར་ཟད་པས་ཁམས་དྲུག་སྐྱེས་བུ་འདུས་པའི་ཕྱིར་དེའི་ངོ་བོ་ཡིན་པ་ཇི་ལྟ་བ་ཡིན་པ་དེ་བཞིན་ཁམས་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱང་ཚུལ་འདི་ཉིད་ཀྱིས་སོ།",
    "རྟེན་ཀྱང་ཇི་ལྟ་བུ་ཞིག་ཡིན་པར་འགྱུར།",
    "དེ་མེད་པར་ཏེ་ཕུང་པོ་དེ་མེད་པར་ཡང་རིགས་པའི་སྒོ་ནས་དམིགས་པ་མ་ཡིན་ནོ།",
    "འདི་དག་ནི་ཕུང་པོ་ཞེས་བྱ་བར་ཕྱེད་པར་མི་འགྱུར་ཏེ་ཆུ་དང་འོ་མ་བཞིན་ནོ།",
    "གཅིག་མེད་པར་ཡང་གསུམ་མེད་པ་ཞེས་བྱ་བ་ནི་ཚིག་ལྷག་མ་ཡིན་ནོ།",
    "གཅིག་མེད་པར་ཡང་གསུམ་མེད་ན།",
    "སོ་སོ་རང་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་ཕན་ཚུན་བསྟེན་པ་ཡང་སྐྱོན་ཡིན་པར་ནི་མཇུག་ཐོགས་ནས་འབྱུང་ིབས་སྟོན་ཏོ།",
    "འདི་དག་ཀྱང་འདྲེས་པར་འགྱུར་བར་འདོད་དོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་རྣ་བའི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་ལ་བརྟེན་ནས་སོ།",
    "རྣམ་པར་ཤེས་པ་སྨོས་པས།",
    "ལས་ཞེས་བྱ་བའམ་བྱ་བ་ཕུང་པོ་ལ་མ་གཏོགས་པ་དོན་གྱི་ཁྱད་པར་གཞན་དུ་བརྗོད་པའམ་དམིགས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ནི་ཐ་སྙད་དུ་གསུངས་ཀྱི་དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "རྒྱས་པར་སྟོན་ཏེ་བྱེ་བྲག་ཏུ་ཤེས་པས་ན་རྣམ་པར་ཤེས་པའོ།",
    "ཕ་བི་ནི་ཕ་བི་ནའོ་ཞེས་བྱ་བར་བསྟན་པར་མི་ནུས་པས་ན་བསྟན་དུ་མེད་དོ།",
    "གནས་སྐབས་རྙེད་པར་མི་འགྱུར་རོ།",
    "གཞན་དག་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "གང་འདི་ཞེས་བྱ་བར་ཐམས་ཅད་ཀྱི་ཁྱད་པར་ཡིན་ཏེ།",
    "སྔོན་སོ་སོའི་སྐྱེ་བོའི་གནས་སྐབས་ཀྱི་རྣམ་པར་ཤེས་པ་ལས་བྱུང་ཞིང་སྐྱེས་པ་དེ་ཐམས་ཅད་ནི་ཟག་པ་དང་བཅས་པའི་རྣམ་པར་ཤེས་པས་བརྟགས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཡོད་པ་མ་ཡིན་པ་ལས་བརྟགས་པ་དེ་ཤེས་པའི་ཕྱིར་ཏེ་འདི་ལ་བདེན་པ་གང་ཡིན་ཞེས་དེ་ལྟར་བརྟགས་ན་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ཡོངས་སུ་ཤེས་པའི་ཕྱིར་བྱིས་པ་སོ་སོའི་སྐྱེ་བོའི་གནས་སྐབས་ཀྱི་འོག་རོལ་ཏུ་རྣམ་པར་ཤེས་པ་ཁོ་ནར་འགག་པར་འགྱུར་ཞིང་དེ་ལ་མི་སྣང་བར་འགྱུར་རོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་རྟོག་པ་ནི་ཇི་བཞིན་རབ་འབྱེད་པའོ།",
    "དེ་ལྟར་ན་ཐམས་ཅད་མེད་པར་ཁས་བླངས་པའི་ཕྱིར་དེ་ཉིད་དངོས་པོ་མེད་པར་སྨྲ་བ་ཁས་བླངས་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་ནམ་མཁའ་དངོས་པོར་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྔར་ནི་ཁྱད་པར་དུ་མིག་དང་།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "གཟུགས་དང་མ་རིག་པ་མེད་པར་སྟོན་ཏོ།",
    "ཁམས་དྲུག་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "གཏན་ལ་ཕབ་པས་ན་མེད་དོ་ཞེས་ངེས་པར་བྱ་སྟེ།",
    "རྒྱུ་དེའི་ཕྱིར་སྐུ་དང་གསུང་དང་ཐུགས་ཐུབ་ཅིང་ཡང་དག་པར་བསྡོམས་པས་ཐུབ་པ་ཆེན་པོ་སྟེ་བཅོམ་ལྡན་འདས་སོ།",
    "ཟློག་པར་གྱུར་པའོ་། དེ་ལྟར་མཐོང་བ་དང་ཐོས་པ་ལ་སོགས་པ་སྟེ།",
    "བྱེ་བྲག་ཕྱེད་པ་དང་རྣམ་པར་ཤེས་པ་གང་ལ་དང་པོ་མཐོང་བ་དང་ཐོས་པ་ཡོད་པ་དེ་ནི་མཐོང་བ་དང་ཐོས་པ་ལ་སོགས་པ་སྟེ།",
    "འདི་ནི་དེ་ཁོ་ན་ཉིད་ལ་བརྟེན་ནས་གསུངས་སོ།",
    "འདི་གཉི་ག་བདེན་པ་མ་ཡིན་པ་ལ་བརྟེན་ནས་ཅི་སྟེ་མ་གསུངས་ཤེ་ན་ཕྱོགས་ལས་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་འགོག་སྟེ།",
    "གལ་ཏེ་དོན་འགའ་ཞིག་སྔར་ཕྱོགས་སུ་བྱས་པར་གྱུར་ན་དེ་ལ་ལྟོས་ནས་འགལ་བའི་ཕྱོགས་མི་མཐུན་པའི་ཕྱོགས་སུ་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ཐབས་འདིས་ཡོད་པ་ཉིད་དང་མེད་པ་ཉིད་དུ་ཞལ་གྱིས་བཞེས་པར་མི་མཛད་དེ་དེའི་ངོ་བོ་ཉིད་དུ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དུས་གསུམ་དུ་གནས་པར་ཞལ་གྱིས་མི་བཞེས་ཏེ།",
    "དེ་བཞིན་ཞེས་བྱ་བ་སྤྱིར་བརྗོད་པར་བྱའོ།",
    "འདི་ནི་འོག་ནས་སྟོན་པར་འགྱུར་རོ།",
    "སྒྱུ་མའི་རིག་སྔགས་ལ་ལེགས་པར་གོམས་པས་འཇིམ་པའི་དུམ་བུ་བླངས་ཏེ་གསང་སྔགས་ཀྱི་སྟོབས་ཀྱིས་བསྒྲུབས་པའི་གླང་པོ་ཆེ་ལ་སོགས་པའི་གཟུགས་ནི་སྒྱུ་མའོ།",
    "དོན་གྱི་ཡང་དག་ཏུ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་ཏེ།",
    "ཐ་སྙད་གདགས་པ་མ་གཏོགས་པར།",
    "གང་ཞིག་ཡོད་པའམ་མེད་པར་འགྱུར་བ་སྟེ།",
    "ཐམས་ཅད་མཁྱེན་པས་ཇི་ལྟར་དེའི།",
    "སྔོན་མཐའ་ལུང་མ་བསྟན་པར་མཛད།",
    "འཆད་པར་འགྱུར་བའི་ཚུལ་གྱིས་དེ་ལྟ་བུ་ལ་དགོངས་ནས་ཞེས་བྱ་བ་ནི་ཚིག་ལྷག་མ་ཡིན་ནོ།",
    "མི་གཙང་ཉིད་ནི་མི་གཙང་བའི་ངོ་བོ་ཉིད་དོ།",
    "མངོན་སུམ་སྤྱོད་ཡུལ་བ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "སེམས་ལ་བདེ་བླག་ཏུ་ཚེགས་མེད་པར་འཇུག་པར་འགྱུར་ཏེ།",
    "སྐྱེ་བོ་རྣམས་ཀྱིས་ཤེས་པར་དཀའོ་ཞེས་ཤེས་པར་དཀའ་བར་ཐུགས་སུ་ཆུད་པ་དེ།",
    "ཅིའི་ཕྱིར་ལོག་པར་གྱུར་ཞེ་ིན།",
    "༣༩ ༩ཤེས་པ་ནི་ཐ་སྙད་དུ་ཡང་ཅི་ཡང་མེད་དོ་ཞེས་ལོག་པར་ཤེས་པའོ།",
    "མེད་པ་ཉིད་དུ་ལྟ་བ་ཉིད་མི་གཙང་བ་སྟེ་སྨེ་ཞིང་བཙོག་པ་ཡིན་ནོ།",
    "ཡང་ན་ལྟ་བ་མི་གཙང་བ་དེར་རོ།",
    "དེ་ཉིད་ལྷག་མས་སྟོན་པར་བྱེད་དོ།",
    "དེ་རྣམས་གྲུབ་ཅིང་གྲུབ་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གུས་པ་ནི་དེའི་གཞི་ལས་ཡིད་རབ་ཏུ་དང་བའི་ལུས་དང་ངག་དང་ཡིད་ཀྱིས་བརྩོན་པའི་འབད་པ་སྟེ་དེ་དང་ལྡན་པར་མཛོད་ཅིག་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྒྲུབ་པ་ནི་སྒྲུབ་པར་བྱེད་པའོ།",
    "ཡོན་ཏན་ལྡན་རྣམས་ཉིད་ལ་ཡང་དག་འདུད་པར་འགྱུར།",
    "དུལ་བས་ཡོན་ཏན་ཕུལ་དུ་ཕྱིན་པ་འཐོབ་པར་འགྱུར།",
    "གཞན་ཚེ་རབས་གཞན་དུ་གནོད་པར་མི་འགྱུར་ཞིང་ཉམ་ང་བར་གནས་པར་མི་འགྱུར་རོ།",
    "༡༨༧པར་འགྱུར་བ་སྟེ་ཆེན་པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ནི་ཞེས་བྱ་བའི་སྒྲ་ནི་ངེས་པར་བཟུང་བ་སྟེ་ཁོ་ནས་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "མི་དགར་འགྱུར་ཞེས་བྱ་བ་ནི་ཕུན་སུམ་ཚོགས་པས་བྱས་པའི་ཡིད་བདེ་བ་མི་འཐོབ་པའོ།",
    "དེས་ན་ཕུན་སུམ་ཚོགས་པར་འགྱུར་ལ།",
    "དེ་ལྟ་བུ་ནི་ཟིལ་གྱིས་གནོན་པར་མི་ནུས་ཀྱི་དེ་ཉིད་ཀྱིས་ཟིལ་གྱིས་གནོན་པས་དེ་མི་དགའ་བར་འགྱུར་རོ།",
    "འདི་ཡང་སྦྱིན་པའི་ཁྱད་པར་གནོད་པའི་སྦྱིན་པ་དུག་དང་མཚོན་ལ་སོགས་པ་སྤོང་བའོ།",
    "བསྡུ་བ་ནི་སེམས་དད་པར་བྱའོ།",
    "ཡིད་ཆེས་ཞེས་བྱ་བ་ནི་བག་ཕེབས་པའོ།",
    "བརྟན་པ་ཞེས་བྱ་བ་ནི་མི་སླུ་བའམ་བག་ཕེབས་པའི་ཁྱད་པར་ཏེ།",
    "ཡོན་ཏན་དེ་རྣམས་འཇོམས་པ་ནི་འཇིག་པར་བྱེད་པའོ།",
    "རྒོད་པ་ལ་སྐྱེ་བོས་བཀུར་སྟི་ལ་སོགས་པ་ཐོག་འདྲེན་པར་མི་བྱེད་དེ།",
    "དེས་ན་བརྗིད་པ་ནི་བསྙེན་པར་དཀའ་བའོ།",
    "དེ་ལྟ་བས་ན་རྒྱལ་པོས་ཤེས་རབ་ཅན་དུ་བྱ་དགོས་སོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "ཇི་ལྟར་ན་བློ་མི་འཕྲོགས་པར་འགྱུར་ཞེ་ན།",
    "གཞན་དག་ལ་དྲིང་འཇོག་ཅིང་བག་ཕེབས་པ་ནི་དེའི་སྟོབས་ཀྱིས་ཕན་ཚུན་འཁྲིད་པ་ཞིག་ན་དེ་ལྟ་བུ་མ་ཡིན་ནོ།",
    "བསྟོད་ཅིང་བསྔགས་པར་འགྱུར་རོ་ཇི་ལྟ་བུར་ཞེ་ན།",
    "གང་དག་ལ་ལུས་ལ་གནོད་པ་བྱས་ནས་ཕེབས་པར་སྨྲ་བའི་ངང་ཚུལ་ཡོད་པ་དེ་དག་ནི་ཕེབས་པར་སྨྲ་བས་ཏེ།",
    "ཕན་པར་སྨྲ་བ་དཀོན་པ་སྟེ།",
    "ཇི་ལྟར་འཕྲོད་པའི་ཟས་ཕན་པར་འགྱུར་བ་ལྟར་འདི་ཡང་དེ་དང་འདྲའོ།",
    "འདི་དག་ལ་ཕན་པར་སྨྲ་བའི་ངང་ཚུལ་ཡོད་པས་ན་དེ་དག་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "རྙེད་ཅིང་ཕྲད་པར་དཀའ་བས་ན་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "ཉན་པའི་སྐྱེ་བོ་ཡང་ཕལ་འཕྲོད་པར་མི་བྱེད་པས་དེ་དགག་པར་ཚིག་སྨོས་ཏེ།་",
    "གང་དག་འདི་ཉན་པར་འགྱུར་བ་དེ་དག་ཀྱང་ཤིན་ཏུ་དཀོན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཅིག་ཏུ་ཞེས་བྱ་བ་ནི་དེ་ལ་གཏོང་བ་དང་ལུས་དང་ངག་དང་ཡིད་ཀྱིས་ངེས་པར་རོ།",
    "ཡང་དག་པར་བརྩོན་པའི་རྒྱུ་གཞན་གདོན་མི་ཟ་བར་ཞེས་བྱ་བ་འདི་ཡང་སྨོས་ཏེ།",
    "གདོན་མི་ཟ་བ་ནི་ངེས་པར་རོ།",
    "བདེ་ན་ཡང་ཞེས་བྱ་བ་ནི་འདོད་པ་ལ་ལོག་པར་སྤྱོད་པ་ལ་སོགས་པས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཆགས་པ་ནི་ལྷག་པར་ཞེན་པ་སྟེ་འཛིན་པ་དམ་པའོ།",
    "གཙང་བ་ཅུང་ཟད་ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་ཇི་ལྟར་གཙང་བ་མེད་པ་དེ་ལྟར་སྟོན་ཏོ་། ཁ་ཆུ་རུལ་བ་ནི་མཆིལ་མའོ།",
    "གཉིས་ཀ་ཡང་མི་གཙང་བས་སོ།",
    "གཞན་ལ་ཡང་དོན་ནི་དེ་ཁོ་ན་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "དགའ་བ་ནི་ཉམས་དགའ་ཞིང་ལྷག་པར་ཞེན་པ་སྟེ།",
    "གཙང་བའི་འདུ་ཤེས་ཀྱིས་འདོད་ཆགས་པར་འགྱུར་ན་དེ་ལྟ་བུ་ནི་མ་ཡིན་ནོ།",
    "ཇི་སྐད་དུ་ཇི་ལྟར་མི་གཙང་བ་རྙིང་བའམ།",
    "མི་གཙང་གང་བའི་བུམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དཔེས་དོན་ཉིད་གསལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "མི་གཙང་བའི་རང་བཞིན་ཏེ་དེའི་ངོ་བོ་ཉིད་དེས་གང་བའོ།",
    "ཁྲེལ་དུ་རུང་བ་ནི་སྨད་པར་བྱ་བ་ལ་སྟོད་པར་བྱེད་པས་སོ།",
    "དེ་ཡང་བདེ་བ་ལ་ལྷག་པར་ཞེན་པའི་ཕྱིར་ཡིན་ན་འདི་ལ་དོན་དུ་ནི་བདེ་བ་ཅུང་ཟད་ཀྱང་མེད་དོ་ཞེས་སྟོན་ཏོ།",
    "དེ་བས་དེ་ནི་དོན་དུ་བདེ་བ་མ་ཡིན་པ་ཉིད་དུ་ཤེས་པར་བྱའི།",
    "ཆགས་པ་ནི་ལྷག་པར་ཞེན་པའོ།",
    "ཇི་ལྟར་གཞན་ལ་བྱས་པ་དེ་བཞིན་དུ་ཚེ་ཐུང་བ་དང་།",
    "ཇི་ལྟར་འཇིགས་པར་བྱས་པ་དེ་བཞིན་དུ་འཇིགས་པ་དང་།",
    "ཇི་ལྟར་སྡུག་བསྔལ་བར་བྱས་པ་དེ་བཞིན་དུ་སྡུག་བསྔལ་བའོ།",
    "༤༡༡མི་བཟད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་བསྟན་ཏོ།",
    "མི་གཙང་བ་དང་འཇིགས་སུ་རུང་བ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རི་དྭགས་ལིངས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དུ་ཉེ་བར་མཚོན་པར་མཛད་པ་ཡིན་ཏེ།",
    "གཡེལ་བ་མེད་པར་ཞེས་བྱ་བ་ནི་བག་ཡོད་པར་ཏེ།",
    "བག་མེད་པ་ནི་བྱ་བ་བཟང་པོ་དང་བཟང་པོ་མ་ཡིན་པ་རྣམ་པར་དབྱེ་བ་ལ་གསལ་བར་མི་འགྱུར་རོ།",
    "འདོད་ན་དེ་ཇི་ལྟར་འཐོབ་པར་འགྱུར་ཞེ་ན།",
    "སྩོགས་པའམ་རྒྱས་པར་འགྱུར་བས་ོན་སེམས་སོ།",
    "ལེགས་པར་རྗེས་སུ་མཐུན་པར་ཀུན་ནས་ཡོངས་སུ་བཀུར་བ་སྟེ།",
    "ཅི་རིགས་པར་ཕྱག་བྱ་བ་དང་།",
    "རྐང་མཐིལ་ས་ལ་མཉམ་པར་འབབ་པས་ན་ཤིན་ཏུ་ཞབས་གནས་པའོ།",
    "ལེན་པ་ནི་ལེན་པར་བྱེད་པའོ།",
    "ཡང་དག་བསྡུམ་པ་བྱས་པ་ནི་ཀུན་ནས་ིསྤྲད་པའོ།",
    "ཤིན་ཏུ་འཇམ་པ་ནི་ལེགས་པར་བྱི་དོར་བྱས་པའོ།",
    "རྒྱས་པ་ནི་རྒྱས་པར་འགྱུར་བའོ།",
    "ཐུབ་པར་དཀའ་བ་ནི་བདུད་ལ་སོགས་པས་ཐུབ་པར་དཀའ་བའོ།",
    "ལྷག་པར་གུས་པ་ནི་གུས་པ་ཁྱད་པར་ཅན་ནོ།",
    "དགོངས་པ་ནི་འདི་ཡིན་པར་སྣང་སྟེ།",
    "དེ་དག་ལས་མཉན་དུ་པར་འདོད་པ་ནི་གུས་པར་ཉན་པའོ།",
    "ཞིང་བཙལ་བ་ཡི་ངེས་པ་ནི་། ཚད་དམ་བརྟན་པར་བྱས་པའོ།",
    "རྫིང་ནི་ཆུ་རིངས་སམ་ཆུའི་གནས་ཀྱི་ཁྱད་པར་རོ།",
    "ཆུ་ཚགས་ནི་ཆུ་བཙག་པའི་ཐབས་ཀྱི་ཁྱད་པར་རོ།",
    "རྟག་པར་ནི་རྟག་ཏུའོ།",
    "གཙེས་པ་ནི་རྒྱལ་པོ་ལ་སོགས་པས་བྱས་པའོ།"
  ]
}