    "སྟོང་པ་ཉིད་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་རང་བཞིན་སྟོང་པ་ཉིད་དེ་དེ་གཙོ་བོར་སྨྲ་བས་ན་སྨྲ་བའི་ཁྱུ་མཆོག་སྟེ་རྣམ་པར་རྟོག་པ་དང་བྲལ་བས་ན་ཟབ་ཅིང་སྤྲུལ་པ་སྣ་ཚོགས་སྟོན་པས་རྒྱ་ཆེ་བ་སྟེ་དེ་གཉིས་ཀྱི་སྒྲ་སྒྲོགས་པས་མུ་སྟེགས་ལ་སོགས་པ་རྣམས་ཟིལ་གྱིས་གནོན་པ་དང་།",
    "སྔར་བརྗོད་པའི་སྤྲིན་མེད་པའི་ནམ་མཁའ་ལས་བྱུང་བའི་སྣང་བ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའི་སེམས་ཏེ་ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བའོ།",
    "དེ་ནི་ཕྱོགས་སྔ་དང་རང་འདོད་གཅིག་ཏུ་བྱས་པས་ཕྱོགས་སྔ་ལ་གནོད་བྱེད་བརྗོད་པ་ཇི་སྙེད་པ་རང་ཉིད་ལ་འཇུག་པར་༡༥ ༣ ན་འགྱུར་རོ།",
    "འབྱུང་རྔུབ་འདུག་པས་སོ་སྙམ་པའམ།",
    "བག་ཆགས་བསྒོ་བའི་གཞི་ང་ཙམ་སྟེ་དེའི་དབུས་སུ་རང་རང་གང་ལ་དགའ་བའི་བསམ་པ་དང་མཐུན་པར་ངར་འཛིན་གྱིས་ལས་བསགས་པས་ཁམས་གསུམ་དུ་སྐྱེ་བ་ལེན་པར་བྱེད་པ་སྟེ་ཚིག་དོན་སྔར་གསུངས་ཟིན་ལ།",
    "གང་ཟག་རྫས་ཡོད་དེ་བྱེ་བྲག་སྨྲ་བའི་ངོར་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་རང་ལུགས་སུ་གསུངས་པའི་ཕྱིར་རོ།",
    "གཞན་དག་དུས་སྦྱོར་འདི་དག་ཕྱིའི་ཉིན་མཚན་དང་།",
    "གཞུང་འདིས་མིག་དམར་གྱི་རགས་པའི་ཉིན་ཞག་ཉེར་གསུམ་གྱི་སྣོན་འབྲིད་སྟོན་རྒྱུར་འདུག་པ་ལ་སྟོང་པ་སྦྲུལ་ཟླའི་རྩིས་མ་དག་པའི་སྣོན་འབྲིད་ལ་སྦྱར་བའི་ཕྱིར་རོ།",
    "གཡག་འདུག།",
    "གལ་ཏེ་དེས་ནི་རྩ་བའི་རང་བཞིན་ནམ་མཁའི་ཁམས་སུ་སྟོན་པར་འདུག་ལ།",
    "ཉེར་བདུན་ཐབས་ཤེས་ཀྱིས་ཕྱེ་བའི་ཉིས་འགྱུར་ང་བཞི་ཡང་རང་ལུགས་ལ་འཇོག་སྟེ།",
    "དེ་མཉེས་པ་ཡིས་བདག་དུས་ཀྱི་འཁོར་ལོ་ནི་མགུ་སྟེ་རང་ཉིད་ལ་རྒྱུད་སྟོན་པ་པོ་དེ་ལ་ཁྲོ་བའི་མེ་ཡིས་ཁྲོས་པ་ཞེས་པ་ཁྲོས་པ་ཆེན་པོ་སྟེ་རྡོ་རྗེ་སེམས་དཔའ་ལ་ཁྲོས་པའོ།",
    "མདུན་མངོན་དུ་ཕྱོགས་པ་སྟོན་པར་གྱུར་ན་འདུག་ཅིག་ཅེས་སྟོན་པའོ།",
    "ངའོ་སྙམ་དུ་འཛིན་པའི་གཞི་འདི་ལའང་བཅོས་མ་དང་རང་བཞིན་གཉིས་ཡོད་པ་ཤེས་དགོས་ལ།",
    "དེ་ལྟར་བཞི་ནི་ཡབ་དང་བཅས་པ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་ཡུམ་པདྨའི་འདུག་སྟངས་དང་ཡབ་རྡོ་རྗེའི་གདན་གྱིས་འཁྱུད་པ་སྟེ།",
    "འདིར་ཡང་སེམས་དཔའ་རྣམས་རྡོ་རྗེའི་གདན་དང་སེམས་མ་རྣམས་པདྨའི་འདུག་སྟངས་ཅན་ཕན་ཚུན་འཁྱུད་པའོ།",
    "དེ་ནི་མཚོན་གྱིས་བཅད་དུ་མེད་པ་དང་རང་བཞིན་ཐ་དད་དུ་དབྱེར་མེད་པ་ཉིད་ཀྱི་ཕྱིར་དང་རྡུལ་ཕྲན་གྱི་རྫས་མེད་པའི་ཕྱིར་ནམ་མཁའི་རྡོ་རྗེ་སྟེ།",
    "གར་གྱི་སླད་དུ་ལྷའི་འདུག་སྟངས་བསྟན་པའོ།",
    "སྟང་སྟབས་འདུག་སྟངས་དེ་དག་ཀྱང་ཇི་ལྟ་བུ་སྙམ་ན།",
    "དེ་ལྟར་ན་མི་བསྐྱོད་པ་ལ་ཡང་རང་འདྲས་རྒྱས་གདབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "དུས་ནི་དུས་ཚོད་དེ་དེའི་དུས་སུ་འཁྲིག་པ་བྱས་པ་ན་ལུས་ངག་ཡིད་ཀྱི་ཐིག་ལེ་གྲོལ་ཏེ་འཛགས་པ་ལས་དགའ་བ་གསུམ་མྱོང་བ་ཉིད་ཀྱི་མཐར་ལྷན་ཅིག་སྐྱེས་པའི་སྐད་ཅིག་དུས་ཅིག་ན་བདེ་བ་ཆེན་པོ་མྱོང་བར་རབ་ཏུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདུག་སྟངས་གཉིས་ཏེ་ལྔའོ།",
    "དེ་ཡང་རང་གཙོ་བོ་དང་རིག་མ་སྣ་ཚོགས་ཡུམ་དུ་བསྐྱེད་པའི་དཔྲལ་བ་ལ་སོགས་པ་གནས་བཞིར་རིམ་བཞིན་རྡོ་རྗེ་བཞིའི་ངོ་བོ་ཨོ་ཨཧཱུཾ་ཧོ་བཞི་པོ་དགོད་ཅིང་།",
    "གདན་རུས་སྦལ་ལ་ནི་འདུག་སྟངས།",
    "རོ་ཙ་ནི་གྷི་ཧཾ་སྟེ།",
    "ཨོཾ་ལོ་ཙ་ན་སྤྱན་མ།",
    "ཐབ་དང་གདན་ནམ་འདུག་སྟངས་ལ་སོགས་པའི་ཆོ་གས་ལྷ་འགྲུབ་པར་འགྱུར་བ་ཇི་སྲིད་ཉིད་ཀྱི་བར་དུ་སྦྱིན་བསྲེག་བྱའོ།",
    "དེ་ནས་མི་བསྐྱོད་པས་སྦྲུས་ནས་སྲན་མ་ཙ་ན་ཀའི་ཚད་ཀྱི་རི་ལུ་བྱས་ཏེ།",
    "འཆི་བདག་དུས་ཀྱི་ཆུ་ཚོད་ངོས་གཟུང་།",
    "སྤེན་པ་རྫོགས་ཤིང་ཉི་མ་འཆར་བའི་དབུས་སུ་སྟོང་པར་སྒྲ་གཅན་རིགས་ལྡན་མི་དག་འཆི་བདག་དུས་ཀྱི་གཟུགས་ཏེ།",
    "འཆི་བདག་དུས་ཀྱི་ཆུ་ཚོད་ཕྱེད་པོ་དེ་ཉིད་ནི་སྦྲུལ་གྱི་སོས་ཟིན་པ་དང་།",
    "རྡོ་རྗེའི་འདུག་སྟངས་ལ་སོགས་པའི་གདན་རྣམས་དང་།",
    "དཔེ་དེབ་དེ་ཚོའི་མ་དཔེ་ངོ་མ་རྣམས་དེང་སང་རྙེད་རྒྱུ་ལས་སླ་པོ་མེད་པ་ང་རང་བརྒྱུད་ནས་ཤེས་ཡོད།",
    "ལྷ་ས་ནས་ཕྱི་ལ་འགྲོ་མི་ཆོག་པ་བཟོས་འདུག་སྐབས་དེ་དུས་ཇོར་ཇེ་རོརིག་ཡང་རྡོ་རྗེ་གླིང་ལ་བཞུགས་ཡོད་པ་དང་།",
    "ཁོ་ཚོས་དོ་ཆས་སཱིར་སཱ་ག་ཌཱི་ལ་སྔོག་བཤེར་བྱེད་རྒྱུའི་ཚབ་ཏུ་འདིར་རང་ལ་བྱེད་ཀྱི་འདུག་སྐབས་དེ་དུས་ངའི་གཟུགས་པོར་རི་གཟར་པོ་གཉིས་ལ་འཛེག་པའི་ནུས་པ་ལྷག་མི་འདུག་པས་ཧིན་སྒོར་བཅུ་བཞི་དང་ཨ་ན་དྲུག་སྤྲད་ནས་དོས་འཁུར་པ་བཞི་ཅན་གྱི་འགྱོགས་བྱམས་ཤིག་གླས་པ་ཡིན།",
    "གྱེན་ཐུར་ལ་མི་མང་པོ་འདྲེད་བརྡར་ཤོར་བ་དང་ལྷུང་བ་མཐོང་ཙང་ང་རང་འགྱོགས་བྱམས་ནང་འདུག་པ་ལས་གོམ་པ་རྒྱག་འདོད་ཆེ་བ་བྱུང་བས་མར་གོམ་པ་བརྒྱབ་ནས་ཕྱིན་པ་ཡིན།",
    "ལ་ང་རང་བལ་ཡུལ་ལ་ཕྱི་ཟླ་༢ ཚེས་༡༨ ནས་ཟླ་བ་བཞི་པའི་ཚེས་༡༤ བར་ཟླ་བ་གཉིས་ཙམ་སྡོད་དགོས་ཡོད།",
    "སྐབས་དེ་དུས་བོད་པའི་འགྲུལ་པ་མང་པོ་དེར་བསྡད་འདུག་དེ་ངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "མི་ཚོས་གང་ལྟར་དེའི་སྐོར་ཤེས་ཀྱི་འདུག་གང་ཡིན་ཟེར་ན།",
    "ཁོང་ནི་ཁྱིམ་བཞག་ནས་རྣལ་འབྱོར་པའི་ལམ་ལ་ཞུགས་འདུག་ཁོང་ཕྱི་ལོ་༡༩༢༦ བར་རྒྱ་གར་རྒྱལ་ཡོངས་ལྷན་ཚོགས་ནང་ཕྱག་ལས་གནང་བ་དང་།",
    "ཇཱ་ཡསི་ཝཱལ་ལགས་འདིར་ཡོང་འདོད་འདུག་པས་ངས་ཁོང་ངེས་པར་དུ་ཡོང་བ་ཞུ་ཞེས་ཡི་གེ་བཏང་བ་ཡིན།",
    "ལོ་དེར་ས་ཡོམ་གྱི་གནོད་སྐྱོན་ཆེན་པོ་བཏང་འདུག་ངས་ཕྱི་ཟླ་༣ ཚེས་༢ཉིན་བཏང་བའི་ཡི་གེའི་ནང་།",
    "མི་དམངས་ཁྲོད་མི་མང་པོའི་ནང་ལ་འཕྲོག་བཅོམ་བྱས་འདུག་ཅེས་བྲིས་པ་ཡིན།",
    "དེ་ནས་རྩིས་པ་ཚོས་ཕྱི་ཟླ་༣ ཚེས་༢ ལ་ཡོང་སྲིད་པའི་སྔོན་བརྡ་བྱས་འདུགཕྱི་ཟླ་༣ ཚེས་༦ ཉིན་ང་ལ་ཇཱ་ཡསི་ཝཱལ་ལགས་ཀྱིས་འགྲུལ་བཞུད་ཆོག་མཆན་ཐོབ་པར་དཀའ་ངལ་འཕྲད་བཞིན་ཡོད་པའི་བརྡ་ལན་འབྱོར་བྱུང་།",
    "པ་ཤུ་པ་ཏི་ལ་འགྲོ་དགོས་དོན་མེད་པ་ཤེས་ནས་དེ་གར་བཞུགས་རྒྱུའི་ཐག་གཅོད་བྱས་འདུགཕྱི་ཟླ་༣ ཚེས་༡༧ ཉིན་ཨབྷྱ་སིངྒ་ངའི་སར་སླེབས་བྱུང་།",
    "ང་རང་ཡང་རྒྱུན་རིང་པོར་དེར་བསྡད་མེད།",
    "ཀུ་དཱ་རི་འགག་སྒོའི་དམག་དཔོན་གྱིས་གུརཱུ་ཇི་ཡིས་རྟ་རྫི་མཐོང་འདུག་འགག་སྒོའི་ལས་བྱེད་ནས།",
    "ལམ་བར་གངས་ཞེ་དྲགས་མི་འདུག་སྐབས་དེ་དུས་དེར་མི་ཚོས་ཚྭ་འོར་འདྲེན་བྱེད་ཀྱི་འདུག་དེ་ང་གཉའ་ལམ་དུ་སླེབས་པ་ཐེངས་གསུམ་པ་དེ་ཡིན།",
    "སྐབས་དེའི་རྟ་རྣམས་བཟང་བ་འདུགཨབྷྱ་སིངྒ་རྟ་རྒྱུག་གཏོང་འདོད་ཀྱིས་མདུན་ལ་ཐོན་ཕྱིན་པ་དང་།",
    "ས་ཆ་དེ་རྒྱ་མཚོ་ནས་ཕི་ཊི་༡༥ ལས་མ་དམའ་བ་འདུག་ཨབྷྱ་སིངྒ་མཚན་གང་གཉིད་ཁུག་མ་ཐུབ་སྟབས་ང་ལ་སེམས་ཁྲལ་བྱུང་།",
    "ཨབྷྱ་སིངྒ་ག་དུས་ཡིན་ཡང་ཁོང་ཁྲོ་ལང་པོ་དང་།",
    "རང་ཉིད་ཀྱི་ཕ་མ་ཁྲིར་མངའ་གསོལ་མ་བྱུང་བར་ཕ་མ་དང་མཉམ་དུ་འདུག་ཅིང་།",
    "ུ་ཀློབའི་ཕྱག་དཔེ་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ཡང་དེར་འདུག་དེར་ཅནྡྲ་བྱཱཀརྞའི་འགྲེལ་པ་ཡང་མཐོང་བྱུང་།",
    "ད་འཕྲལ་དུ་ས་སྐྱ་བཞག་ནས་འགྲོ་ཐབས་མི་འདུག་ང་ལ་པར་ཆས་དང་སྤྱིན་ཤོག་གཉིས་ཀ་ཡོད།",
    "འོན་ཀྱང་ཁོང་ཁོང་ཁྲོ་ལངས་སྐྱེན་པོ་ཡོད་པས་རང་གཤིས་ག་དུས་འགྱུར་བ་འགྲོ་མིན་ངེས་གཏན་མེད།",
    "མི་གཞན་དག་དང་དགའ་པོའི་ངང་ཐུག་འཕྲད་གནང་མཁན་ཞིག་འདུག་འོན་ཀྱང་ཁོང་རང་ཉིད་ཀྱི་ཚོར་བ་མི་ངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "དེར་འབྱོར་དུས་ཡུལ་མི་ཚོས་ཞིང་ཁ་རྨོས་བཞིན་འདུག་ཞིང་ཁའི་ནང་གྲོ་དང་ནས་ལྗང་ཁུ་སྐྱེས་ཤིང་།",
    "རྒྱུག་ཆུ་དེ་ཤུགས་ཆེན་པོ་འབབ་ཀྱི་འདུགས་ཆ་འགའ་ཤས་ལ་གོམ་པ་བརྒྱབ་ནས་ཆུ་བོ་བརྒལ་དགོས་བྱུང་།",
    "རི་ལ་འཛེགས་རྒྱུ་དཀའ་ལས་ཁག་པོ་དང་འགྲོ་ལམ་དོག་པོ་འདུག་དང་པོ་ངོ་ལ་བརྒལ་བ་དང་།",
    "ཐུར་ལ་མར་བབས་སྐབས་རྒྱང་ཐག་རིང་ཙམ་བར་འགྲོ་ལམ་ཆ་ཚང་རྡིབ་སྐྱོན་ཤོར་འདུག་པས་དྲེལ་གྱིས་དོ་བོ་ཁུར་ནས་འགྲོ་རྒྱུར་དཀའ་ལས་ཡོད་སྟབས།",
    "དེའི་འགྲམ་ལ་ཁང་པ་གཞན་ཞིག་ཀྱང་འདུག་དེ་སྒོ་བརྒྱབ་པ་དང་།",
    "འོན་ཀྱང་དཔེ་དེབ་བྲིས་མ་དེ་ཚོ་ཚང་མ་བོད་ཡིག་ནང་བྲིས་འདུག་ངས་སྒམ་གཅིག་ཁ་ཕྱེས་པ་ཡིན།",
    "ངས་ས་སྐྱ་ནས་བླངས་པའི་འདྲ་པར་ཚང་མ་ཏེཇ་རཏྣ་ཡིས་བཀྲུས་འདུག་རྣལ་འབྱོར་སྤྱོད་པའི་སའི་འདྲ་པར་གསུམ་པོ་གསལ་པོ་མི་འདུག་འོན་ཀྱང་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ཆ་ཚང་མ་ཐོབ་བར་དུ་ང་བོད་ནས་ལོག་མི་ནུས།",
    "མི་དེ་གཉིས་ཀ་ལ་བོད་ཀྱི་གྲི་ཆུང་འདུག་དེ་ནས་གོམ་པ་མགྱོགས་སུ་བཏང་ནས་ནག་ཁུང་མ་ཆགས་གོང་གཞིས་ཀ་རྩེ་ལ་འབྱོར་བྱུང་།",
    "པར་འཁྲུ་ཐུབ་ཡག་མི་འདུག་གང་ཡིན་ཟེར་ངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "ཀ་ལི་ཀ་ཏཱ་ནས་ཉོས་པའི་པར་རྩའི་ལྕགས་ཤོག་རྣམས་བེད་མེད་དུ་གྱུར་འདུགཏེཇ་རཏྣ་ཡིས་པར་རྩའི་ལྕགས་ཤོག་རྙིང་པ་ལས་པར་འགའ་ཤས་ལེན་ཐུབ་པ་བྱུང་།",
    "ཆུ་ཤིང་ཤས་ཡུལ་མི་ཚོས་ང་ལ་དངུལ་གཡར་རྒྱུ་གྲ་སྒྲིག་འདུག་འོན་ཀྱང་ངས་དངུལ་ཕྱིར་སློག་པར་དཀའ་ངལ་འཕྲད་དོགས་ཀྱིས་དངུལ་མང་པོ་གཡར་མ་ནུས།",
    "དེའི་ནང་བེ་རོ་ཙ་ན་དང་།",
    "ཇཱ་ཡསི་ཝཱལ་ལགས་ཀྱིས་དེའི་སྐོར་གསར་གནས་མཉམ་སྦྲེལ་ཁང་ལ་གནས་ཚུལ་མཁོ་སྤྲོད་བྱས་ཏེ་རྒྱ་གར་གྱི་ཚགས་ཤོག་ནང་སྤེལ་འདུག་ངས་རྒྱལ་རྩེ་ནས་པར་ལས་དང་འབྲེལ་བའི་དགོས་མཁོའི་རྒྱུ་ཆའི་སྐོར་ཏར་འཕྲིན་དང་ཡི་གེ་བཏང་བ་ཡིན།",
    "ལམ་བར་ག་དུས་ཡིན་ཡང་ཉེན་ཁ་འཕྲད་སྲིད་པ་ལ་ཐེ་ཚོམ་མེད།",
    "འོན་ཀྱང་བོད་ནང་ལག་གཡོག་དང་རྟ་འཚོལ་སྒྲུབ་བྱེད་རྒྱུ་ལས་སླ་པོ་མི་འདུགངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "ཕྱོགས་གཞན་ནས་ཏེཇ་རཏྣས་དེར་འགྲོ་འདོད་བྱེད་ཀྱི་མི་འདུག་ཁོང་མེད་པར་པར་ལེན་ཐུབ་རྒྱུ་ཁག་པོ་ཆགས་ཡོད།",
    "ལ་དེ་ཆུང་ཆུང་ཡིན་ཀྱང་ཉེན་ཁ་ཆེན་པོ་འདུག་བོད་ནང་འགྲུལ་བསྐྱོད་སྔོན་མའི་སྐབས་ངས་རི་དེ་བརྒལ་བ་ཡིན།",
    "ཉི་མ་ད་དུང་ཡང་ཤར་མི་འདུག་གཡག་ནག་པོ་ག་སགར་རྩྭ་ཁར་འཚོ་བཞིན་པ་དང་།",
    "སྒང་ནས་བལྟས་ན་རྩྭ་ཐང་རྒྱང་ཐག་རིང་པོའི་བར་ཁྱབ་ཡོད་པ་ལྟ་བུ་འདུག་ཀྱང་འོག་ལ་རྩྭ་སེར་ཤུར་ཤུར་ཆགས་ཟིན་འདུག་དེར་གུ་ཡངས་པའི་རི་ལུང་དང་གནམ་འོག་ལུག་སྟོང་ཕྲག་མང་པོ་རྩྭ་ཁར་འཚོ་བཞིན་པ་མཐོང་བྱུང་།",
    "སྤྱིར་ཕྱག་དཔེ་དེ་ཆ་ཚང་འདུག་ཀྱང་དེའི་ནང་ཉན་ཐོས་ཀྱི་ས་དང་།",
    "ངའི་སྐབས་འགར་ལྕམ་སྐུ་ཞབས་ལ་ཁ་ལད་དང་སྦྲགས་ད་ཁྱེད་རང་ཟླ་བ་མང་པོའི་རིང་སྒོམ་རྒྱག་དགོས་དོན་མེད།",
    "ཕྱི་ལོ་༡༩༣༦བསྡད་ཀྱི་འདུག་དགུན་དུས་སུ་ས་ཆ་གཅིག་ལ་ཟླ་བ་གཉིས་རིང་སྡོད་པ་ལས་དེ་མིན་རྩྭ་ཁ་བཟང་སར་གཡག་དང་།",
    "ཕྱིར་ལེན་དུ་བསྐྱོད་སྐབས་ཁང་པའི་སྒོ་བརྒྱབ་འདུག་ངས་འཇམ་དབྱངས་ཁང་པའི་ཐོག་ཁར་བཏང་བ་ཡིན།",
    "ངས་བཙུན་མ་དེ་ལ་ཁ་ལག་བཟོ་བར་བསྐུལ་ནས་ང་རང་སྨྱུག་མའི་ལོ་མ་གཏུབ་ཏུ་ཕྱིན་པ་ཡིན།",
    "ནོར་བུ་དང་ཚེ་རིང་ཡང་ངལ་དུབ་སངས་འདུག་མདུན་གྱི་བགྲོད་ལམ་སྐྱིད་ཉམས་ལྡན་ཞིང་ས་ཆ་མང་པོ་ལས་ཆུ་ཕྲན་འབབ་པ་དང་།",
    "སྦྲག་ཁང་བརྒྱུད་དེ་ངོས་ལ་ཡི་གེ་ཁ་ཤས་འབྱོར་འདུག་འོན་ཀྱང་ཡི་གེ་མང་པོ་ཞིག་ཕྱིར་སློག་བྱས་ཡོད་ཤས་ཆེ།",
    "སྐབས་དེ་དུས་ང་རང་མི་སྐྱོ་བོའི་ཐབས་རྩོད་ནང་མ་ཞུགས་ཤིང་ཐག་རིང་དུ་སྡོད་རྒྱུར་འབད་བརྩོད་ཤུགས་ཆེ་བྱས་པ་ཡིན།",
    "ཕྱི་ཟླ་༡༡ ཚེས་སྟོན་འཚོགས་རྒྱུ་ཡིན་འདུག་ང་ཡང་དེར་ཚོགས་ཞུགས་བྱས་པ་ཡིན།",
    "ཁོང་རྣམས་ལ་ད་ཆ་གཞུང་འགའ་ཤས་བསྐྱར་གསོ་ཐུབ་པ་བྱུང་བ་དེ་གནས་ཚུལ་ཤིན་ཏུ་བཟང་པོ་ཡིན་འདུག་པཎྜིཏ་སུཁ་ལཱལ་ལགས་ལྟ་གྲུབ་སྨྲ་བ་ཞིག་ཡིན་པ་མ་ཟད་རིག་པའི་གཞུང་ལུགས་གཞན་མང་པོ་ལ་མཁྱེན་རྒྱ་ཡོད་མཁན་ཞིག་ཡིན།",
    "ཌོག་ཊར་ཧས་ནེན་ལྕེ་རྩའི་རྨེན་བུ་གཤག་བཅོས་ཀྱིས་རྩ་མེད་གཏོང་དགོས་པའི་སློབ་སྟོན་གནང་བྱུང་ཡང་ལྕེ་རྩའི་རྨེན་བུའི་ན་ཟུག་ལྷིང་འཇགས་མ་བྱུང་བར་གཤག་བཅོས་གཏོང་ཐུབ་ཐབས་མི་འདུག་དེར་བརྟེན་ལྷིང་འཇགས་མ་བྱུང་བར་པཊ་ནཱ་ལ་མི་སྡོད་ཀ་མེད་བྱུང་།",
    "མག་ཧི་ཡུལ་སྐད་ནང་སྙན་རྩོམ་དང་གཞས་མང་པོ་བྲིས་འདུག་གཞས་ཚིག་ནང་ཞིང་པ་ཚོ་ལ་སོ་སོའི་ཁེ་ཕན་ཆེད་འོས་བསྡུའི་ནང་ཆ་ཤས་ལེན་དགོས་སྐོར་སྐུལ་ཡོད།",
    "ཌོག་ཊར་ཅར་བྷསི་ཀིས་ང་ཨུ་རུ་སུ་མཉམ་འབྲེལ་རྒྱལ་ཁབ་ལ་མགྲོན་འབོད་ཆེད་ཐབས་ཤེས་གནང་བཞིན་འདུག་ཕྱི་ཟླ་༧ པའི་སྔོན་ལ་རྒྱ་གར་ནས་ཐོན་དགོས་ཚེ་ངས་ཡུ་རོབ་ཏུ་ངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "ཋ་ཀུར་མངྒལ་ཅནྡ་དེར་འདུག་ངས་འབད་བརྩོན་མང་པོ་བྱས་ཏེ་ཨུ་རུ་སུ་མཉམ་འབྲེལ་རྒྱལ་ཁབ་ཀྱི་འགྲུལ་སྐོར་ཆེད་ག་ས་ག་ནས་ཧིན་སྒོར་བདུན་བརྒྱ་བསགས་པ་དང་།",
    "སྐབས་དེ་དུས་སེའུའི་ཤིང་འབྲས་སྨིན་འདུག་ཉིན་གཅིག་ངེད་གཉིས་ལྡུམ་རའི་ནང་ཤིང་འབྲས་ཁ་ཤས་བཟའ་རུ་ཕྱིན་པ་ཡིན།",
    "སྣང་བརྙན་གཞན་ཡང་མང་པོ་འདུག་འོན་ཀྱང་ལག་ཤེས་མཁས་པའི་ངོས་ནས་བལྟས་ན་སྐུ་འདྲ་དེ་ཚོ་དེ་ཙམ་ཡག་པོ་མི་འདུག་གུཔ་ཏཱའི་དུས་རབས་སུ་རྒྱ་གར་རྒྱལ་ཡོངས་ནང་སྐུ་འདྲ་ཆེས་ཕུལ་དུ་བྱུང་བ་ངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "རོ་ཊང་ལ་ག་དུས་སྒོ་འབྱེད་རྒྱུ་དང་།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་དེ་དག་ཚང་མ་ཉིན་གུང་བྱུང་འདུགཆུ་ཚོད་ཁ་ཤས་ཀྱི་སྔོན་ཚུད་ནས་ཡུལ་མི་ཚོས་ཉེན་ཁ་དེའི་སྐོར་ཤེས་མ་ཐག་བྲོས་ཏེ་སོ་སོའི་ཚེ་སྲོག་སྐྱོབ་ཐུབ་པ་བྱུང་འདུག་ཁང་པ་ཚང་མ་བྱེ་མའི་འོག་ཐིམ་ནས་མཐོང་སར་མི་འདུགཀོ་ལང་ལ་ཕྱི་ཟླ་༥ ཚེས་༢༦ ནས་ཕྱི་ཟླ་༦ ཚེས་༦ བར་བསྡད་པ་ཡིན།",
    "མདུན་དུ་རྡོ་ཆེན་པོ་མང་པོ་འདུག་འོན་ཏེ་ལག་པས་གཡུག་ཐུབ་ཐབས་བྲལ།",
    "ལྕོག་མཁར་མཐོན་པོ་དེ་འདྲ་ད་ལྟའང་མཐོང་རྒྱུ་འདུགམཁར་གྱི་ནང་ལ་ལྷ་ཁང་ཞིག་འདུག་དེའི་ནང་ལི་ལས་གྲུབ་པའི་རྒྱ་གར་གྱི་སྐུ་འདྲ་ཁ་ཤས་མཐོང་བྱུང་།",
    "རིའི་སྒང་དུ་མེ་ལི་གཅིག་ལས་ཉུང་ཙམ་གྱི་ས་བར་གངས་མཐོང་རྒྱུ་འདུག་ཆུ་ཚོད་༢་༣ ནང་ང་ལ་དེར་འབྱོར་བ་དང་།",
    "ང་རང་དེ་དག་ལ་དབྱིངས་མེད།",
    "ཇོརཇ་ཡིས་བོད་ཡིག་ཚིག་མཛོད་རྒྱས་པ་ཞིག་ཕྱོགས་བསྒྲིགས་ཞུས་འདུག་ངའི་བོད་ཡིག་དང་སཾསྐྲྀཏ་ཤན་སྦྱར་གྱི་ཚིག་མཛོད་ནང་ཚིག་གསར་པ་མང་པོ་ཡོད།",
    "ཁྱེད་ཡོང་དགོས་ཀྱི་འདུག་ཅེས་བཀོད་འདུག་ངོས་ཀྱི་བོད་ནང་སྐོར་སྐྱོད་གསུམ་པ།",
    "ཇཱ་ཡསི་ཝཱལ་ལགས་ཀྱིས་དེའི་སྐོར་དྲི་ཞིབ་ཚར་མང་པོ་གནང་ཚུལ་དེ་ཐོས་ནས་ཁོང་དགའ་པོ་བྱུང་འདུག་ཕྱི་ཟླ་༧ཚེས་༨ ཉིན་ང་ལ་ལ་དྭགས་ནས་ཡི་གེ་ཞིག་འབྱོར་བྱུང་།",
    "ཉིན་རྗེས་མ་སྟེ་ཕྱི་ཟླ་༧ ཚེས་༩ཉིན་སྦོཡོ་དསན་ཏེ་ནས་ཡི་གེ་གཅིག་འབྱོར་བའི་ནང་དེར་ཡོང་རྒྱུའི་མགྲོན་བརྡ་བསྐུར་འདུག་ད་ངོས་རང་རྒྱལ་ཁབ་བཞི་སྟེ་ཨུ་རུ་སུ་དང་།",
    "ཚོགས་ང་རང་སྦ་ནཱ་རས་སུ་སློབ་ཕྲུག་ཡིན་པའི་སྐབས་པཎྜིཏ་རཱམ་ཨ་ཝ་ཏཱར་ཤརྨཱ་དང་ཐུག་ཅིང་།",
    "ང་བོད་ལ་ཐེངས་དང་པོ་ཐོན་པའི་ལོ་སྟེ་ཕྱི་ལོ་༤༡༩༢༩ ཟླ་༤ ཚེས་༣ཉིན་ཁོང་འདས་གྲོངས་སུ་ཕྱིན་འདུག་ཁོང་ནི་ཕྱི་ལོ་༡༨༧༧ ལོར་འཁྲུངས་པ་ཞིག་དང་།",
    "ཉིན་རྗེས་མ་སྟེ་ཕྱི་ཟླ་༨ ཚེས་༥ཉིན་གྱི་ཞོགས་པ་ཆུ་ཚོད་༥ པ་མ་ཟིན་ཙམ་ལ་ང་རང་དེར་འབྱོར་བྱུང་།",
    "ཨ་ཙི།",
    "པརག་ནས་ད་དུང་དངུལ་འགའ་ཤས་གོ་སྒྲིག་གནང་འདུག་པ་དང་།",
    "ཁོང་གཉིས་ནི་པཎྜིཏ་ཨིནྡྲ་ཡིས་ང་ལ་སྡོད་གནས་སོགས་མཁོ་སྤྲོད་བྱེད་ཆེད་དུ་བཏང་འདུག་ང་ཨརྱ་ས་མཱ་ཇ་ལ་ཕྱིན་པ་ཡིན།",
    "ཀོ་ཝེ་ཊ་ལ་བྱུང་བའི་ས་ཡོམ་གྱི་གཏོར་སྐྱོན་རྣམས་ཉམས་བཟོ་བྱས་ཟིན་འདུག་ཚོང་ཁང་མང་པོ་བཟོ་བཅོས་ཟིན་འདུག་ཀྱང་རྒྱལ་ས་བཅོས་བཞིན་འདུག་ཉེ་འཁོར་ལ་མེ་ཏོག་ལྡུམ་རྭ་ཡང་མང་པོ་ཡོད།",
    "ང་དང་མཉམ་དུ་མེ་འཁོར་ནང་ཨི་རཱན་ལ་ཡུལ་སྐོར་སྤྲོ་འཆམ་དུ་འགྲོ་བཞིན་པ་སར་དཱར་རཱམ་སིངྒ་དང་མི་གཞན་ཞིག་ཀྱང་འདུགམེ་འཁོར་གྱིས་མི་སྐྱེལ་འདྲེན་བྱེད་པ་ཙམ་དུ་མ་ཟད་ལམ་དབར་དུ་མེ་འཁོར་གྱི་ལས་རྩོལ་བ་ཚོའི་གླ་འབབ་དང་།",
    "རྐྱེན་ངན་དགེ་གྲོགས་ཟེར་བ་དོན་ལ་གནས་པ་འདུག་སྙམ་པ་བྱུང་།",
    "འོན་ཀྱང་ངོས་ཀྱི་མཐོང་སྣང་དུ་འཕགས་བོད་ཀྱི་མཁས་གྲུབ་ཕལ་ཆེར་དེ་འདྲའི་ཐུགས་ཕམ་མ་བྱུང་བ་མེད་པ་ལྟ་བུ་ཞིག་འདུག་སྟེ།",
    "ཞེས་སྡུག་སྐད་ཆེན་པོ་སྐྱོན་དགོས་བྱུང་འདུག་མཁས་པ་རྣམས་ལ་རྒྱུན་དུ་གཞན་གྱིས་བརྙས་བཅོས་དང་།",
    "ཡང་ན་ཁོ་རང་ལས་སྙན་ངག་རྩོམ་པའི་རིག་རྩལ་དེ་ཕྱིར་བཞེས་གནང་རྒྱུ་དང་།",
    "དེ་ལྟར་མ་གནང་ན་ཁུ་དཱ་ནི་ཆེས་མ་དྲང་བ་ཞིག་གོ་ཞེས་བསྟིང་ཚིག་བརྗོད་འདུག་པ་དང་།",
    "ཞེས་སྡུག་སྐད་ལྷང་ལྷང་སྐྱོན་འདུག་པ་ནོ་བལ་ཞེས་བྱ་བའི་བྱ་དགའ་དེས་ཀྱང་སྙན་ངག་མཁན་དེ་མ་ཚིམས་པར་སྣང་སྟེ།",
    "དེའི་ནང་ནས་ཀྱང་ཚིགས་བཅད་ཀྱི་རྩོམ་འགྲོས་ཧ་ཅང་ལེགས་པ་ཞིག་འདུག་སྟེ།",
    "ཆུ་བོ་གངྒཱ་ཞེས་པ་གང་འདྲ་ཞིག་འདུག་དྲིས་པར་ཟམ་པའི་སྒང་ནས་མར་བལྟས་ན་ཆུ་བོའི་བབས་ཕྱོགས་གང་དུ་ཡིན་མིན་མི་ཤེས་པ་ཞིག་འདུག་སོགས་བྱིས་པ་ངོ་མཚར་བསྐྱེད་པའི་གཏམ་དུ་མ་ཐོས་ཤིང་།",
    "ཞེས་པའི་ཤློཀ་གཉིས་འདུག་པ་ཧ་ཅང་ཡིད་ལ་འཐད་པས་ལན་འགའ་བཀླགས་པ་དང་།",
    "ཁོ་བོའི་ཡོངས་འཛིན་དམ་པ་དེས་ཀྱང་གནས་ཡིག་འདི་ཧ་ཅང་ཡག་པོ་འདུག་ཅེས་མཉེས་མཉེས་མཛད་པ་ད་ལྟའང་དྲན།",
    "ཤོག་ལྡེབས་བཞི་བརྒྱ་ལྷག་ཙམ་ཞིག་ཡོད་འདུག་སྟེ།",
    "ནང་གཙོ་ཆེ་བོད་དུ་བཞུགས་པའི་ལེགས་སྦྱར་གྱི་རྒྱ་དཔེ་རིན་ཐང་བྲལ་བ་དེ་རྣམས་ཀྱི་དཀར་ཆག་བཀོད་འདུག་པར་བརྟེན་འདི་གའི་གཙུག་ལག་སློབ་ཁང་ནས་དཔར་འགྲེམས་བྱེད་རྒྱུ་འོས་འཚམས་ཡིན་ཚུལ་སྐུ་ངོ་ངག་དོན་གྱིས་གསུངས་པ་དེ་བཞིན་ཐུགས་ཤིན་ཏུ་མད་པ་དང་།",
    "གནས་ཚུལ་ཧ་ཅང་གལ་ཆེ་མང་པོ་འདུག་པ་མ་ཟད།",
    "སྐབས་དེར་ཁོ་རང་དགུང་ལོ་སོ་གཉིས་སོན་པས་འཁྲུངས་ལོ་རབ་བྱུང་བཅོ་ལྔ་པའི་ཆུ་སྟག་ཕྱི་ལོ་༡༩༢ ཡིན་པ་བཅས་གསལ་བར་གྲུབ་པས།",
    "གཞུང་འདིའི་ནང་བོད་དུ་བཞུགས་པའི་རྒྱ་དཔེའི་དཀར་ཆག་བཀོད་གནང་མཛད་པ་དེ་དག་དུས་ཡུན་ཐུང་ངུའི་ནང་བྲེལ་འཚབ་ཀྱིས་བྲིས་པས་ཡིན་ནམ་གང་ལྟར་དཔྱད་དགོས་པ་འགའ་ཞིག་འདུག་ཅིང་།",
    "གཏམ་རྒྱུད་གསེར་ཐང་ཤོག་གྲངས་༡༥ཞེས་བཀོད་འདུག་ཀྱང་།",
    "གཏམ་རྒྱུད་གསེར་ཐང་ཤོག་གྲངས་༡༥ཞེས་གསལ་བ་དེར་རཱཧུལ་གྱི་ཐོའི་ནང་ཆ་མ་ཚང་ཞེས་བྲིས་འདུག་ཀྱང་།",
    "ཙཏུརཱངྒསཱདྷན་ཡན་ལག་བཞིའི་སྒྲུབ་ཐབས་ཀྱི་འགྲེལ་པ་སློབ་དཔོན་སམནྟདབྷདྲས་མཛད་པ་གཏམ་རྒྱུད་གསེར་ཐང་ཤོག་གྲངས་༡༦ཞེས་བཀོད་འདུག་པ་འདི་ཡང་།",
    "དཔེ་འདིའི་སྔ་ལོགས་ཉིད་དུ་ཀུམཱརཙནྡྲས་མཛད་པའི་བཛྲབྷིརབཏནྟཔཉྫིཀཱ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་རྒྱུད་ཀྱི་དཀའ་འགྲེལ་རཱཧུལའི་དཔེ་ཐོར་འཁོད་འདུག་པ་དེ་འདིར་མི་གསལ་བས་དཔེ་གཉིས་མཉམ་བསྲེས་ཀྱིས་ནོར་བར་སྣང་།",
    "ལྷག་མ་གསུམ་མཛད་བྱང་མེད་པར་གསལ་འདུག་ཀྱང་།",
    "གཉིས་མེད་ཀྱི་སེམས་དཔྱོད་པའི་རབ་བྱེད་ཅེས་པ་དེ་རཱཧུལ་གྱི་ཐོར་རཏྣཀཱིརྟིའི་མཛད་པ་བྱས་འདུག་ཀྱང་།",
    "ཡན་ལག་ཅན་མེད་པ་ཡང་རཱཧུལའི་དཔེ་ཐོར་རཏྣཀཱིརྟིས་མཛད་པར་བྱས་འདུག་ཀྱང་།",
    "ལྷག་པར་དུ་རྒྱ་གར་དང་ལི་ཡུལ་སོགས་ལ་ག་དུས་ཕེབས་མིན་སོགས་ཤེས་ཐབས་བྲལ་བར་གྱུར།",
    "རྭ་བ་སྟོད་པས་རྟགས་གསལ་འཕེན་གྱི་འདུག།",
    "ཁྲི་དེ་གསང་ཕུའི་གླིང་སྐོར་མཐའ་ན་རྡོ་རྩིག་ལས་གྲུབ་པ་ཞིག་འདུག།",
    "སྟོང་པ་དེ་ཡང་རང་རིག་པའི་ཡེ་ཤེས་ཉིད་དུ་དང་།",
    "བློ་དེ་སྤངས་ཀྱང་དགོས་དུས་སུ་མངོན་དུ་བྱེད་པར་བཞེད་པར་གསུངས་འདུག་པཎ་ཆེན་ཤཱཀྱ་མཆོག་ལྡན་གྱིས་མཛད།",
    "གློ་ཀ་སྟོང་ཕྲག་བཅུ་གཉིས་དང་བརྒྱ་ཕྲག་བཞི་དང་དྲུག་ཅུ་རྩ་གསུམ་ཡོད་པར་གསུངས་འདུག་ན།",
    "བཀའ་བསྟན་ཐམས་ཅད་ལོ་ཆེན་འདིའི་བཀའ་དྲིན་ལས་བྱུང་ཚུལ་ཞིག་འཆད་འདུག་པས།",
    "རང་ཉིད་གཅིག་བུ་བདེ་བར་འདུག་པའི་ཀུན་སློང་དང་།",
    "བེམ་པོ་དང་རང་རིག་ལ་དམིགས་རྐྱེན་མེད་པའི་ཕྱིར་རོ།",
    "རིགས་ཀྱི་སྒོ་ནས་ཕྱེ་བ་ཡིན་པས་ནང་བལྟས་ལ་རྫས་དང་སྐད་ཅིག་མ་ཇི་སྙེད་ཡོད་ཀྱང་རང་རིག་ཏུ་གཅིག་པའི་ཕྱིར་ཏེ།",
    "རྟོག་པ་རྣམས་ཀྱང་རང་རིག་ཡིན་ཏེ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རང་ཡུལ་མདུན་ན་འདུག་པ་བཞིན་དུ་གསལ་བར་མཐོང་སྟེ།",
    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་རིག་པ་ཕྱི་མ་སྐྱེད་པར་གྲུབ་པས།",
    "གཏན་ཚིགས་ཡང་དག་ལ་ངོ་བོའི་སྒོ་ནས་དབྱེ་ན་འབྲས་བུའི་རྟགས་ཡང་དག་དང་རང་བཞིན་གྱི་རྟགས་ཡང་དག་དང་།",
    "རྗེས་དཔག་དང་རང་དོན་རྗེས་དཔག་གཉིས་དོན་གཅིག་ཡིན་ལ།",
    "གཞན་ལུགས་དགག་པ་དང་རང་ལུགས་བཞག་པ་དང་།",
    "ད་ནི་འབྲས་བུ་དང་རང་བཞིན་ལ་དངོས་སུ་གནས་པས་འབྲེལ་བ་རྟོགས་པའི་ནུས་པ་ཁོ་ནས་གཅིག་རྟོགས་པ་ན།",
    "འདི་ག་ཙམ་ཞིག་ལ་གོ་རྒྱུ་འདུག་གོ།",
    "རང་བྱུང་རང་ཤར་རང་གཞན་དགའ་སྟོན་ཡིན།",
    "བརྟན་པ་སྦ་སྟེགས་སྟན་ལ་འདུག།",
    "བདུད་ལ་སོགས་པས་མི་ཕྱེད་པའི་བསམ་པ་བརྟན་པའི་སྦ་སྟེགས་ཏེ་རྩྭ་ལ་སོགས་པ་ཟློརྣལ་འབྱོར་དང་རྗེས་སུ་མཐུན་པའི་སྟན་ལེགས་པ་ལ་འདུག་པ་དང་།",
    "དེ་ཡང་རང་ཉིད་གཅིག་པུས་ཁྱད་པར་བའི་སེམས་ཀྱི་སྟོབས་ཆེན་པོ་དང་ལྡན་པའི་སེམས་བསྐྱེད་མི་ཡི་རྟེན་ལས་རྙེད་པ་གང་ཡིན་པའི་ལམ་དེ་འདྲ་ལྷ་དང་ཀླུ་སོགས་ཀྱིས་ཀྱང་རྙེད་པ་མིན་པར་གསུངས་པ་དང་།",
    "ལོ་ཟླ་ཞག་དུས་གར་གྱི་རྣམ་འགྱུར་བཞིན",
    "ད་ལྟའི་སྐབས་སུ་ལོ་དགུ་བཅུ་ནང་ཐུབ་པའང་སྲིད་མཐར་འདུག།",
    "འགྲོ་བའི་རིགས་དུད་འགྲོ་ལ་སོགས་པ་འདི་དག་དུས་ལ་ངེས་པ་མེད་པར་འཆི་བ་དང་།",
    "ལོ་ཟླ་ཞག་དུས་སོགས་ཀྱི་རིམ་པས་འགྱུར་བ་དང་མཐར་འཆི་ངེས་པ་ལྟ་བུ་རགས་པ་ཕྱིའི་མི་རྟག་པ་དང་།",
    "འདུག་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་སྐྱེས་པའི་བྱ་བ་ཡང་འཆི་བ་ཉིད་ཡིན་གྱི།",
    "འགྲོ་འདུག་དང་ཉལ་བ་དང་བཟའ་བཏུང་དང་ཉི་མ་དང་གྲིབ་མ་བསྟེན་པ་སོགས་ཀྱང་ཇི་ཙམ་རིང་དུ་བསྟེན་པ་དེ་ཙམ་དུ་བདེ་བ་ཇེ་འཕེལ་དུ་འགྲོ་དགོས་པ་ལ།",
    "གང་ལྟར་ཡང་རང་རྒྱུ་ལས་ཉོན་ལས་སྐྱེས་པ།",
    "ལག་མཐིལ་སྤུ་ཉག་ཞིག་འདུག་པ།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་ཐིབས་པོར་འདུག་པ་ཡི།",
    "བདུན་ཕྲག་སུམ་ཅུ་དྲུག་པ་ལ་མའི་མངལ་ན་འདུག་མི་འདོད་པར་འགྱུར།",
    "ལུས་སེམས་གང་ལ་བལྟས་ཀྱང་ཇེ་རྒུད་དུ་འདུག་པས།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "བསྒྲོད་མིན་འགྲོ་བར་འདོད་པ་ཡིས།",
    "ཚོར་བ་བཞིན་དུ་འདུག་པ་ཅི་འདྲ།",
    "རྫོགས་ཆེན་གྱི་རྒྱུད་དུ་ཡོངས་གྲགས་སུ་ངོ་བོ་སྟོང་རང་བཞིན་གསལ་ཞེས་གསུངས་པ་གཉིས་མི་འགལ་ཏེ།",
    "རང་ཤར་རང་སྣང་རང་གསལ་ཡེ་ལ།",
    "རང་བཞིན་གསལ་བ་རང་ལ་ཡོད་པའི་ཡོན་ཏན་གྱིས་རང་སྣང་རང་གདངས་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུར་སྣང་བ་སྟེ།",
    "ཁྱད་པར་ཕ་ནི་ཐབས་སྣང་ཕྱོགས་ཀྱི་མཚོན་བྱེད་ཡིན་པསའདིར་ཡང་རང་བཞིན་གསལ་བ་དང་།",
    "དེའི་རང་མདངས་རང་བཞིན་གསལ་བའི་སྣང་ཆ་འགགས་པ་མེད་པའི་བདག་ཉིད་འཁྲུལ་སྣང་རང་ངོར་སངས་པའམ།",
    "ཅེས་གསུངས་པ་ལྟར་ངོ་བོ་སྟོང་ཞིང་རང་བཞིན་གསལ་བ།",
    "བྱས་ཙ་ན་སློང་དེ་ཙམ་འོང་བ་ཅི་ཡིན་བྱས།",
    "ཟག་མེད་ཀྱི་བདེ་བ་ལྟ་ཅི་སྨོས་ཟག་བཅས་ཀྱི་བདེ་བ་ཡང་མི་འདུག།",
    "སླར་སྡུག་བསྔལ་བསྐྱེད་པ་ལྟར་འགྱུར་བའི་སྡུག་བསྔལ་ལས་མ་འདས་པས་བདེ་བ་རྣམ་དག་ཅིག་གཏན་ནས་མི་འདུག་སྙམ་དུ་བདེ་བས་ཕོངས་ཚུལ་བསམ་ལ།",
    "རང་རང་བདེ་བར་གནས་དེར་དགའ་བ་བསྒོམ།",
    "དབུས་ན་བསྐལ་པ་ཞིག་དུས་ཀྱང་མི་འཇིགས་པ་རྡོ་རྗེའི་གདན།",
    "དེ་ཡང་རང་ཅག་འཛམ་བུའི་གླིང་ལ་ལྟོས་ནས་ལྷོར་སོགས་སུ་བཞག་པ་སྟེ།",
    "གླང་པོ་གཞན་གྱིས་དེའི་རྫི་ཚོར་བ་ཙམ་གྱིས་ཀྱང་མདུན་དུ་འདུག་པར་མི་ནུས་པ།",
    "ནང་རང་ལུས་ཀྱི་བཀོད་པ་ལའང་དེ་ཚང་བར་གསལ་བཏབ་སྟེ་འབུལ་བ་ལ",
    "ནང་རང་ལུས་ཀྱི་ཆ་ཤས།",
    "ཕྱིས་ནས་སྐྱོན་ཅུང་ཟད་མཐོང་ནས་སྨོད་ཅིང་གཅིག་པུར་འདུག་ནའང་སྐྱོན་ལ་སེམས་པ་དང་།",
    "དེས་ན་ཡི་དམ་བརྡའི་མཚོན་བྱེད་དུ་འདུག།",
    "ཞིང་རང་མཚན་པ་ཞིག་ཏུ་གོ་བར་མི་བྱའོ།",
