    "མཉམ་པར་གཞག་ལ་བརྩོན་བྱ་ཞིང་།",
    "སྐྱེ་བོ་མང་པོ་དང་འགྲོགས་པ་སྤངས་ཏེ་ལུས་དབེན་པར་གནས་པ་དང་།",
    "བྱས་པ་ཐམས་ཅད་དོན་མེད་སྡུག་བསྔལ་རྒྱུ།",
    "ཅི་ལ་བསམས་ཀྱང་ཕན་པར་མི་འགྱུར་བས།",
    "མཁའ་བཞིན་དྲི་མ་མེད་པར་འགྱུར།",
    "ཡིད་མཉམ་པར་གཞག་པ་ལས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟར།",
    "གང་པོས་ཞུས་པར་ཡང་།",
    "སེམས་ལྡན་རང་ཉིད་ཀྱང་མི་རྟག་པར་གྱུར་པ་སུ་ཞིག་བུ་དང་ཆུང་མ་ལ་སོགས་པའི་མཛའ་བཤེས་མི་རྟག་ཅིང་མི་བརྟན་པ་རྣམས་ལ༵་ཡང་དག་པར་ཆགས་པར་བྱེད་པ་ཡོ༵ད་དེ་དེ་ནི་རིགས་པ་མ་ཡིན་ནོ།",
    "མི་དགའ་བས་སེམས་འཁྲུགས་ན་ཡིད་ཀྱང་ནང་དུ་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་འཇོག་ཅིང་གནས་པར་མི་འགྱུར་ལ༵་གལ་ཏེ་སྡུག་ཅིང་ཡིད་དུ་འོང་བ་མཐོང་ཡང་དེ་ལ་ཆགས་པ་མ་སྤངས་ན་ངོམས་ཤིང་ཚིམ་པར་མི་འགྱུར་བ༵ས་སྔར་བཞིན་དུ་ཆགས་པ་དང་སྲེད་པས་སེམས་ཡོངས་སུ་གདུང་བར་འགྱུ༵ར་ཏེ།",
    "ངེས་པར་ངན་འགྲོར་འགྲོ་བར་འགྱུར་ཞི༵ང་།",
    "མཐུན་པར་སྤྱད་ན་རང་ཉིད་ངན་འགྲོར་ལྟུང་ཞིང་།",
    "མི་མཐུན་པར་སྤྱད་ན་གཞན་དང་ཁྲོ་བར་འགྱུར་བའི་ཕྱིར་བྱིས་པ་བསྟེན་པས་ནམ་ཡང་ཅི་ཞིག་བྱ་སྟེ་དགོས་པ་མེད་དོ།",
    "རང་གཞན་ལ་ཡུན་དུ་ཕན་པར་འགྱུར་བ་བླང་དོར་གྱི་ཚུལ་ཕྱིན་ཅི་མ་ལོག་པ་སྨྲས་ན་ནི་ཁྲོ་བར་བྱེ༵ད་ཅིང་།",
    "བདག་ཀྱང་ཕན་པར་འགྱུར་བ་དེ་ལས་ནན་གྱིས་ཟློག་པར་བྱེ༵ད་ལ།",
    "ཡོན་ཏན་བརྗོད་ཅིང་བསྟོད་ན་དྲེ༵གས་པར་འགྱུར་བ་དང་།",
    "དུས་ནམ་ཞིག་གང་ཟག་བྱིས་པ་བསྟེན་པ་ལས་ཕན་པར་འགྱུར་བ་ཅི་ཞིག་ཐོ༵བ་སྟེ་མི་ཐོབ་པ་ཉིད་དོ།",
    "དེས་ཀྱང་བདག་དོན་མ་བྱས་ལ༵།",
    "གཅིག་པུ་དབེན་པར་གནས་པར་བྱ༵།",
    "ཡུན་ཧ་ཅང་འདྲིས་ཆེན་པོ་ཉིད་དུའང་མི་འགྱུར་བ༵ར་ཆགས་སྡང་དང་བྲལ་བའི་སྒོ་ནས་ཐ་མལ་བ་ཙམ་གྱིས་ལེགས་པར་གནས་པར་བྱ༵འོ།",
    "འབྲས་བུ་རྣམ་པར་སྨིན་པའི་དུས་ན་སྟོང་འགྱུར་དུ༵་འཕེལ་བའི་སྡུག་བསྔལ་ཉིད་དུ་འགྱུར་ཞིང་སྡ༵ང་ངོ།",
    "བློའི་འཇུག་པ་བརྟན་པར་གྱིས་ཏེ་རབ་ཏུ་རྟོ༵གས་ཤིག་གལ་ཏེ་ཚེ་འདིར་ལོངས་སྤྱོད་རྙེད་པ་དག་ནི་མང་པོ་བྱུང་བར་གྱུར་ཅི༵ང་།",
    "མཁས་རྣམས་བྱིས་པ་བསྟེན་པར་ཡོངས་མི་བྱེད།",
    "དེ་ཉིད་བསྟེན་པར་གདམས་པའོ།",
    "ནགས་ཁྲོད་ན་རི་དྭགས་དང་བྱ་རྣམ་པ་སྣ་ཚོགས་པ་དག་ད༵ང་ཤིང་ལྗོན་པ་རྣམས་ནི་གཞན་ལ་སྨོད་པའི་ཚིག་མི་སྙན་པ་བརྗོད་པར་མི་བྱེ༵ད་ཅིང་།",
    "གསུམ་པ་བསྒྲུབ་པར་སླ་བ་ཉེར་མཁོའི་ཡོན་ཏན་བསམ་པ་ནི།",
    "ཆོམ་རྐུན་པ་ཀུན་ལ་མི་མཁོ་བ་ཕྱག་དར་ཁྲོད་ལ་སོགས་པའི་གོས་ཙམ་འཆང་ཞི༵ང་ལུས་འདི་གོས་དང་རྩིག་པ་ལ་སོགས་པས་བསྒྲིབས་ཏེ་སྦ་བར་མ་བྱས་ཀྱ༵ང་།",
    "གནོད་པ་ལ་སོགས་པས་འཇིགས་པ་མེད་པར་གནས་པར་དུས་ནམ་ཞིག་ན་འགྱུ༵ར་སྙམ་དུ་སྨོན་པའོ།",
    "འཁྲུལ་བའི་སྣང་པ་ལ་ལུས་འདི་ནི་གཅིག་པུར་བྱུང་བའོ་སྙམ་དུ་སེམས་ན་ཡ༵ང་དང་པོར་ལྷན་ཅིག་ཏུ་སྐྱེས་བའི་ཤ་དང་རུས་པ་ལ་སོགས་པ་དག༵་མཐར་ཤི་བ་ན་ཞིག་སྟེ་སོ་སོ་ཐ་དད་དུ་འགྱེས་པར་འགྱུར་ན༵་གཉེན་དང་བཤེས་ལ་སོགས་པ་མཛའ་བ་གཞན་རྣམས་དང་འགྱེས་པར་འགྱུར་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོ༵ས་སྙམ་དུ་འབྲལ་བ་རྗེས་སུ་དྲན་པ་དང་།",
    "ཆགས་པའི་ཡུལ་གྱིས་གཉེན་བཤེས་མེད་ཅིང་ཁྲོ་བའི་ཡུལ་གྱི་མཁོན་པའང་མེད་པར་བྱས་ན༵ས།",
    "ཚངས་སྤྱོད་ལེགས་པར་སྤྱད་པ་དང་།",
    "ལམ་ནི་ལེགས་པར་གོམས་པ་ཡིས།",
    "གཉིས་པ་དེ་ཉིད་བསྟེན་པར་གདམས་པ་ནི།",
    "རྟག་ཏུ་དབེན་དང་ནགས་ཁྲོད་བསྟེན་པར་གྱིས།",
    "དེ་ལྟར་ལུས་དབེན་པར་གནས་པས་འཇིག་རྟེན་གྱི་འདུ་འཛི་སྤངས་ནས།",
    "འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་ཕ་རོལ་ཏུ༵་འདོད་པའི་ཡོན་ཏན་ལྔ་བོ་རྣམས་ལ་ལྷག་པར་ཆགས་ཤིང་བསྟེན་པ་ནི་ཕུང་ཁྲོལ་ཉེས་པ་སྣ་ཚོགས་སྐྱེ༵ད་པར་བྱེད་པ་སྟེ།",
    "མི་གཙང་བར་དྲན་པས་ཆགས་པ་སྤང་བའོ།",
    "ཆགས་ཡུལ་དེ་གོས་དང་པགས་པ་ལ་སོགས་པས་མ་གཡོགས་པར་དུར་ཁྲོད་དུ་བོར་བ་ན་ཡང་ཅིས་མི་འདོ༵ད་དེ་འདོད་ཆགས་སྐྱེ་བར་རིགས་སོ།",
    "འོན་ཏེ་མི་གཙང་བའི་རང་བཞིན་ཅན་གྱི་ཀེང་རུས་དེ་ལ་དགོས་པ་མེད་དོ་ཞེ་ན་ནི༵་པགས་པ་ལ་སོགས་པས་གཡོགས་པ་ལ་ནི་ཅིའི་ཕྱིར་འཁྱུ༵ད་ཅིང་ཆགས་པར་བྱེད་དེ་དེ་ལའང་ཆགས་པར་མི་རིགས་ཏེ་མི་གཙང་བའི་རང་བཞིན་ཅན་དུ་མཚུངས་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་མི་གཙང་བ་དྲན་པས་ཆགས་པ་སྤང་བ་ལ།",
    "འོན་ཏེ་མི་གཙང་བ་ཉིད་ལ་ཆགས་སོ་ཞེ་ན།",
    "དེ་འདོད་པར་རིགས་སོ།",
    "རང་ཉིད་ཀྱི་ལུས་མི་གཙང་བའི་རང་བཞིན་ཉིད་ཡིན་པ༵ར་མངོན་སུམ་དུ་གྱུར་ཀྱང་རྟོགས་པར་མི་འགྱུར་བ་འདི་ནི་ངོ་མཚར་ཆེ༵་སྟེ་ཤིན་ཏུ་རྨོངས་པའོ།",
    "དེ་ལ་ཆགས་པ་སྤངས་ནས་ནི༵་མི་གཙང་བ་ལ་ཞེན་པའི་སེམས་ཀྱིས་ནི༵་མི་གཙང་བ་མང་པོས་གང་བའི་གཟེབ་སམ་སྣོད་དུ་གྱུར་པའི་ལུས་ལ་ཅིའི་ཕྱིར་དག༵འ་སྟེ་དགའ་ཞིང་ཆགས་པ་ནི་མི་རིགས་སོ།",
    "གསུམ་པ་དེ་ཡིས་གཞན་ཡང་བཙོག་པར་བྱེད་ཚུལ་ནི།",
    "སཱ་ལུའི་འབྲས་ཆན་བཟང་པོ་དག་གམ་སྔོ་ངད་ཞིམ་པོའི་ཚོད་མའང་རུ༵ང་ལན་ཅིག་ཁར་བཅུག་ནས་སླར་ཕྱིར་ཕྱུང་སྟེ་བོར་བ་ཡི༵ས་ས་གཞི་གཙང་མ་ལ་གོས་ན་ཡང་ངན་སྐྱུགས་ཀྱིས་སྦགས་པའོ་ཞེས་མི་གཙང་ཞིང་བཙོག་པར་འགྱུ༵ར་བ་ཡིན་ན།",
    "བཞི་པ་གཞན་ལའང་བལྟས་ཏེ་རྣམ་པར་དཔྱད་ཚུལ་ནི།",
    "ལུས་གང་ལས་པགས་པའི་ཁ་ཕྱེ་ན༵་ཁྲག་དང་ནང་ཁྲོལ་དང་ཕྱི་ས་ལ་སོགས་པ་མཐོང་ནས་འཇིགས་པ་ཆེན་པོ་སྐྱེ་བར་འགྱུར་བ༵ར་ཤེས་ཀྱང་ཇི་ལྟར་ལུས་དེ་ཉིད་ལ༵་འཇིགས་པར་མི་བྱེད་པར་ཕྱིར་ཞིང་ངོམས་པ་མེད་པའི་དགའ་བ་སྐྱེ་བར་འགྱུ༵ར་བ་ནི་ཤིན་ཏུ་འཁྲུལ་བའོ།",
    "ནང་མི་གཙང་ཡང་ཕྱི་དྲི་ཞིམ་པ་ལ་ཆགས་སོ་ཞེ་ན་ལུས་ལ་བསྐུས་པའི་དྲི་ཞིམ་པར་སྣང་བ་དེ་ཡ༵ང་ཙན་དན་དང་གླ་རྩི་ལ་སོགས་པའི་ཡིན་གྱི་གཞན་ལུས་ལས་བྱུང་བ་ནི་མི༵ན་ན་གཞན་ཙན་དན་ལ་སོགས་པ་ཉིད་ཀྱི་དྲི་དེས་གཞན་ལུས་མི་གཙང་བ་དག་ལ༵་ཅི་ཡི་ཕྱིར་ན་ཆགས་པར་བྱེ༵ད་དེ་ཆགས་པ་ནི་མི་རིགས་སོ།",
    "གལ་ཏེ་ལེགས་པར་བརྟགས་ན་རང་བཞིན་གྱི་དྲི་ང་ཞིང་མི་གཙང་བ་ཡིན་པ༵ས་ལུས་འདི་ལ་མ་ཆགས་པ་ན་ལེགས་པ་མིན་ན༵མ་སྟེ་ཤིན་ཏུ་ལེགས་ལ་དེ་ལྟ་ན་ཡང་འཇིག་རྟེན་ན་གཙང་བའི་དོན་མེད་པ་ལ་སྲེད་ཅིང་ཆགས་པ་ད༵ག་ཅི་སྟེ་ལུས་མི་གཙང་བའི་དངོས་པོ་དེ་ལ་ཙན་དན་ལ་སོགས་པའི་དྲི་ཞིམ་པོ་སྐུ༵ད་དེ་དེ་ལྟར་བྱེད་པ་ནི་དྲི་བཟང་པོ་ཆུད་གསོན་པའོ།",
    "འོན་ཏེ་དྲི་ཞིམ་པར་སྣང་བ་ནི༵།",
    "ཤི་བའི་རོ་རྣམ་པར་འཐོར་བའི་རུས་གོང་འགའ་ཞིག་མཐོང་ནས་ནི༵་གནས་དུར་ཁྲོད་དུ་སླེབ་པ་ན་ནི་མི་སྡུག་པའི་འདུ་ཤེས་ཀྱིས་ཡིད་འབྱུང་ཞིང་མི་དགའ་བར་བྱེད་ན༵།",
    "བརྒྱད་པ་འདི་དང་ཕྱི་མར་གནོད་པར་འགྱུར་ཚུལ་ནི།",
    "གལ་ཏེ་གཞོན་པའི་དུས་སུ་ནོར་སོག་པར་བྱེད་ན་ཡང་དེ་ཡིས་ཚེ་ཡོངས་སུ་གཏུགས་ཤིང་ཟད་པར་གྱུར་ན༵་རྒས་ནས་འདོད་པ་ལ་ལོངས་སྤྱོད་པའི་བདེ་བས་ཅི་ཞིག་བྱ༵་སྟེ།",
    "སྤྱད་ལོང་མེད་ཅིང་སྤྱད་པར་ཡང་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འདོད་ཡོན་ལ་ཆགས་པ་དང་ལྡན་པའི་ངན་པ་ཁ་ཅིག་ནི༵་ཉིན་པར་རངས་པོ་ཞིང་རྨོ་བ་དང་།",
    "རྩྭ་ཐུ་བ་དང་ཤིང་ལེན་པ་ལ་སོགས་པའི་ལས་ཁུར་གྱིས་ཡོངས་སུ་དུབ་ཅིང་ངལ་བར་བྱས་ཏེ།",
    "དམག་མི་ལ་སོགས་པ་འདོད་ཡོན་ལ་ཆགས་པས་བསླུས་པའི་གླེན་པ་གཏི་མུག་ཅན་ད༵ག་ཡོ་བྱད་ཀྱིས་འཚོ་བར་འདོད་པས་འཚོ་བ་བསྒྲུབ་པར་བྱའོ་ཞེ༵ས་བསམས་ནས།",
    "དེ་ལྟར་འདོད་པ་ཆུང་རྣམས་མ་ལགས་ཏེ།",
    "དེ་ལས་མནར་མེད་རྣམས་ཀྱི་འགྲོ་བ་ཤིན་ཏུ་འཇིགས་པར་འགྲོ་མི་འགྱུར།",
    "དགའ་བའི་ཁྱད་པར་རོ།",
    "གཉིས་པ་ཁྱད་པར་ལ་གཉིས་ལས།",
    "རབ་མཆོག་ལགས་པར་ལྷ་མིའི་སྟོན་པས་གསུངས།",
    "ཀུན་ཏུ་ཆོག་མཁྱེན་མཛོད་ཅིག་ཆོག་ཤེས་ན།",
    "ནོར་མི་བདོག་ཀྱང་ཡང་དག་འབྱོར་བ་ལགས།",
    "དེའང་བདག་གཞན་གཉིས་ཀ་ལ་བདེ་བས་ཕན་འདོགས་པ་དང་སྡུག་བསྔལ་གྱིས་གནོད་པ་བྱེད་པར་མཉམ་པས་ན༵།",
    "མཉམ་པར་བསྒོམས་པའི་ཕན་ཡོན་ནོ།",
    "མཉམ་པར་མི་བསྲུང་སྟེ་བདག་གཞན་གྱི་སྡུག་བསྔལ་གྱིས་ཕན་ཚུན་མི་གནོན་པའི་ཕྱིར་རོ་སྙམ་ན།",
    "བདག་ཉིད་གཅིག་པུའི་བདེ་བ་བསྒྲུབ་པར་འདོད་ཀྱི་གཞན་གྱི་ནི་མ་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ལྟ་བུར་འཛིན་པ༵འི་རྣམ་པར་རྟོག་པ་དེ་ནི་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་སྟེ༵།",
    "ཡང་ན་ལུས་ལ་བདག་གཅིག་ཏུ་འཛིན་པའི་བློ་དེ་ནི་སྤང་བར་བྱ་བ་ཡིན་ཏེ་མི་རིགས་པའི་ཕྱིར་དང་བདག་དང་གཞན་གྱི་མི་རིགས་པ་གང་ཡིན་པ་དེ་ཡང་ཅི་ནུས་པར་ནི་སྤང་བར་བྱ་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "གླང་པོ་ཆེ་དང་རྟ་བ་དང་རྐང་ཐང་དུ་མ་འདུས་པ་ལ་དམག་ཅེས་བཏགས་པ་ལ་སོགས་པ་བཞིན་དུ་བརྫུ༵ན་པ་ཡིན་གྱི་གཅིག་ཏུ་བདེན་པར་གྲུབ་པ་མེད་དེ་རྫས་དུ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་དོན་དམ་པར་སྡུག་བསྔལ་མྱོང་པ་པོའི་བདག་པོ་གཅིག་པུ་གྲུབ་པ་མེད་པར་ནི༵་རང་གཞན་ཐམས་ཅད་ལ་བྱེ་བྲག་མེད་པ་ཉི༵ད་ཡིན་ལ།",
    "དོན་དམ་པར་བདག་མེད་ཀྱང་ཀུན་རྫོབ་ཙམ་དུ་རྒྱང་འཕེན་པ་ལ་སོགས་པ་ཐམས་ཅད་སྡུག་བསྔལ་མྱོང་བར་མི་འདོད་པའི་སྒོ་ནས་བཟློག་པ་ལ་འཇུག་པའི་ཕྱིར་རོ།",
    "ཡང་སྡུག་བསྔལ་ཐམས་ཅད་བཟློག་པར་བྱ་བ་ཡིན་ན།",
    "བརྩེ་བ་དང་ལྡན་པའི་གང་ཟག་དམ་པས་དོན་ཆེན་པོ་དང་ལྡན་པའི་སྡུག་བསྔལ་དེ༵་རང་དང་གཞན་མང་པོ་ལ་ཕན་དོན་དུ་འབད་པས་བསྐྱེད་པར་བྱ་བ་ཉི༵ད་ཡིན་ནོ།",
    "སྐུ་ལས་ངོ་མཚར་བའི་ལྟས་དུ་མ་བྱུང་བས་རྒྱལ་པོ་འགྱོད་པས་གདུངས་ནས་གསོལ་བ་བཏབ་པར་ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལས་གསུངས་པ་ལྟར་རོ།",
    "དེའང་སྔར་བདག་ཡོན་ཏན་དང་ལྡན་པར་བཟུང་ནས་ཆགས་པ་དང་།",
    "གོམས་པས་བརྗེ་བར་ནུས་པ་དེ་བས་ན་ཇི་ལྟར་ཆུང་ངུའམ་ཐ་ན༵་གནོད་པའི་ཁྱད་པར་ཚིག་མི་སྙན་པ་ཙམ་ལས་ཀྱང་བདག་ཉིད་སྲུང་བ༵ར་བྱེད་པ་དེ་བཞིན་དུ་ཞེས་པའམ།",
    "བདག་ཉིད་འབའ་ཞིག་གཟུགས་དང་རིགས་དང་འཁོར་དང་ལོངས་སྤྱོད་ལ་སོགས་པས་མཐོ་བར་འདོད་པ་དེ༵་ནི་ཕྱི་མ་ལ་ངན་འགྲོ་དང་རིགས་ངན་པ་དང་གླེན་པ་ལ་སོགས་པར་སྐྱེ་བར་འགྱུར་ཞིང་།",
    "རང་ལ་འདོད་པ་དེ་ཉིད་གཞན་ལ་སྤོ་བར་བྱས་ཏེ་ཕ་རོལ་པོ་མཐོ་བར་འདོད་ན༵་བདེ་འགྲོ་དང་བཀུར་སྟི་དང་རིམ་གྲོ་ཕུན་སུམ་ཚོགས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "ཐུབ་པ་ཐུགས་རྗེ་ཆེན་པོ་དང་ལྡན་པ་རྣམས་གཞན་གྱི་དོན་འབའ་ཞིག་མཛད་པ༵ས་དོན་གཉིས་ཕུན་སུམ་ཚོགས་པ་གྲུབ་ནས་བདེ་བ་ཆེན་པོ་ལ་ལོངས་སྤྱོད་པ་འདི་གཉིས་ཀྱི་ནི་ཁྱད་པར་ལྟོ༵ས་ལ་བདག་གཞན་བརྗེ་བ་ལ་འབད་པར་གྱིས་ཤིག་ཅེས་པའོ།",
    "དགྲ་དང་དུག་སྦྲུལ་ལ་སོགས་པའི་འཇིགས་པ་ཐམས་ཅད་དང་སྐྱེ་རྒ་ན་འཆི་ལ་སོགས་པའི་སྡུག་བསྔལ་གང་ཇི་སྙེད་ཡོད་པར་གྱུར་པ༵་དེ་དག་ཀུན་རྩ་བ་བདག་ཏུ་འཛིན་པ་ལས་བྱུང་བར་གྱུར་པ་ཡིན་ན༵།",
    "བདག་ཉིད་གཅེས་འཛིན་སྤངས་ནས་གཞན་གྱི་དོན་ལ་ལྟོས་པ་མེད་པར་བཏང་བར་བྱ་བ་ད༵ང་།",
    "མཐའ་གཅིག་ཏུ་བདེན་པར་གྲུབ་པ་ནི་མེད་དེ།",
    "གཞན་ཡང་བདག་རྙིང་པ་འདི་ཡི་ཡོན་ཏན་ག༵ང་ཡིན་པ་རྣམས་གང་ཟག་སུས་ཀྱང་ཐོས་པར་མི་འགྱུར་བར་གསང་བར་བྱ༵འོ།",
    "བདག་འདི་ཡི་ཡོན་ཏན་གྱི་ཁྱད་པར་རྣམས་ཅི་ནས་ཀྱ༵ང་གང་ཟག་འགས་ཀྱང་མི་ཤེས་པ་དེ་ལྟར་སྦ་བ་ལ་འབད་པར་གྱི༵ས་ཤིག་ཅེས་པའོ།",
    "གསུམ་པ་བསྡུས་ཏེ་བསྒྲུབ་པར་གདམས་པ་ནི།",
    "དཔེར་ན་རྒྱལ་པོ་ང་ལ་ནུས་གླིང་བཞིའི་བདག་པོ་དང་བརྒྱ་བྱིན་གྱི་སྟན་བྱེད་ཐོབ་ཀྱང་མ་ཚིམ་པར་ལྷུང་བ་བཞིན་ནོ།",
    "ད་ལྟ་གསོན་ནམ་ཐ་མར་ཡང་ན་ཤི་ཡང་བླ༵འི་ཡིད་བདག་ལ་ལུས་མི་གཙང་བའི་འཁྲུལ་འཁོར་འདིས་དགོས་པ་ཅི་ཞིག་བྱ༵་སྟེ།",
    "ཡིད་གང་ཞིག་ཡུན་རིང་པོར་ལུས་འདི་བདེ་བར་འདོད་པ་ལ་འདྲིས་པར་གྱུར་པ༵ས་ལུས་དེ་དང་ཡིད་བདག་བཤེས་སུ་འགྲོགས་པས་ཕན་གདགས་པར་བྱ་བ་ཡིན་ནོ་ཞེ་ན༵།",
    "ཏིང་ངེ་འཛིན་གྱི་འགལ་ཟླ་གཉིད་དང་རྨུགས་པ་དང་རྒོད་པ་དང་འགྱོད་པ་ལ་སོགས་པ་བཟློག་ཅིང་སྤང་པ་ལ་འབད་པར་བྱ༵འོ།",
    "གཉིས་པ་རིགས་པས་བསྟན་པར་བྱེད་ཚུལ་ནི།",
    "ཀུན་རྫོབ་དྲང་བའི་དོན་དགོངས་པ་ཅན་གྱི་ཚུལ་ལ་རབ་ཏུ་རྣམ་པར་ངེས་པའི་ཤེས་རབ་རྣམ་དག་ལ་བརྟེན་ནས།",
    "བྱེད་ལས་གནས་སྐབས་སུ་གཞན་གྱི་ཐེ་ཚོམ་མཐའ་དག་གཅོད་པས་འདོད་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་དང་།",
    "རྣམ་པར་མི་རྟོགས་ཡེ་ཤེས་ལྡན།",
    "ཤེས་བྱ་ཇི་ལྟ་བ་དང་ཇི་སྙེད་པའི་དོན་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་ངོ་བོའི་དོན་དང་།",
    "མཁས་པས་ཡང་དག་སྒྲུབ་པར་བྱེད།",
    "གཉིས་པ་ཁྱད་པར་གྱི་དབྱེ་བ་ལ།",
    "རང་བཞིན་ཀུན་རྫོབ་ཡིན་པར་རྟོགས།",
    "ཀུན་རྫོབ་ཀྱི་ནི་དབྱེ་བ་བྱས།",
    "བདེན་པ་གཉིས་པོ་གཅིག་ཡིན་ན་བྱིས་པ་རྣམས་ཀྱིས་ཀྱང་དོན་དམ་མངོན་སུམ་དུ་མཐོང་པར་འགྱུར་བ་ལ་སོགས་པའི་སྐྱོན་ཡོད་ཅིང་།",
    "འཇིག་རྟེན་མཁྱེན་པས་གཞན་ལ་མ་གསན་པར།",
    "བདེན་པ་གཅིག་ནི་རྟག་པ་ལགས་སོ།",
    "ཤེས་པར་བྱ་བ་ཡང་ཀུན་རྫོབ་དང་དོན་དམ་པ་འདི་དག་ཏུ་ཟད་དོ་ཞེས་པ་ལྟར་རོ།",
    "ལྔ་པ་མིང་དོན་ནི་འཇུག་པར།",
    "ཡོད་པ་ལ་ཡང་ཡོད་པར།",
    "མེད་པ་ལ་ཡང་མེད་པར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་ཞེས་པ་དང་།",
    "ཡོད་པ་ཡི་ནི་དམ་པར་འདོད།",
    "དམིགས་པ་ཡི་ནི་དམ་པར་འདོད།",
    "དོན་དམ་པའི་ཡོན་ཏན་རྣམས་གདོད་མ་ནས་ལྷུན་གྱིས་གྲུབ་པས་གཞག་པར་བྱ་བའང་ཅི་ཡང་མེད་པ་ཡུལ་མཐའ་གཉིས་དང་བྲལ་བ་ཡང་དག་པའི་དོན་ལ།",
    "ཡུལ་ཅན་དོན་དམ་པ་ཤེས་པའི་ཤེས་རབ་ཡང་དག་པས་བལྟས་ཤིང་མཉམ་པར་བཞག་པ་ལས།",
    "གཞག་པར་བྱ་བ་ཅི་ཡང་མེད།",
    "ཡང་དག་མཐོང་ནས་རྣམ་པར་གྲོལ།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཅེས་པ་ལྟར་རྣམ་པར་དཔྱད་ན།",
    "གཅིག་དང་དུ་མ་ལ་སོགས་པར་བདེན་པས་སྟོང་བའི་ཕྱིར་རོ།",
    "གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་རྣམས་ཡོད་པར་གསུངས་པ་དང་མི་འགལ་ལམ་སྙམ་ན།"
  ]
