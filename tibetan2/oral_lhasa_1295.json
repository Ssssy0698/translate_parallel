    "ཇི་ལྟར་བསམ་པའི་དོན་རྣམས་འགྲུབ་པར་མཛོད།",
    "ཡོངས་སུ་རྫོགས་པར་བགྱི་བའི་དོན་སླད་དུ།",
    "མ་འབྱོར་པ་དང་སོགས་ཀྱིས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "ཅེས་སོགས་བསྔོ་སྨོན་བཀྲ་ཤིས་རྒྱས་པར་བྱའོ།",
    "སྣོད་གཙང་མ་ཞིག་ཏུ་ཆང་བུ་གསུམ་བཞག་ལ་ཆབ་ཀྱིས་བྲན་ཏེ།",
    "དེ་ནས་གོང་དུ་བཤམས་པའི་ཆང་བུ་འབྲུ་གསུམ་བརྗོད་པས་བདུད་རྩིར་བྱིན་གྱིས་བརླབས་པར་བསམས་ལ་ཨོཾ་ཨཱ་ཧཱུྃ་ལན་གསུམ་བརྗོད།",
    "ལྷག་པར་གནས་བཅས་ཤ་ཟའི་མཁའ་འགྲོ་མ།",
    "ཡོངས་སུ་རྫོགས་པར་བགྱི་བའི་དོན་སླད་དུ།",
    "མི་ཐམས་ཅད་གུས་པར་འགྱུར་ཞིང་།",
    "ཐ་ན་ཁྱི་ལ་སོགས་པས་ཀྱང་བྱམས་པར་བྱེད་པ་དང་།",
    "ཆང་བུ་ལ་བརྟེན་ནས་སྒྲུབ་པ་འདི་རྒྱུན་དུ་མ་ཆག་པར་བགྱིས་ན་འཆི་བ་བསླུ་བའི་མཆོག་ཀྱང་ཡིན་པར་གསུངས་སོ།",
    "དུས་གསུམ་མཁྱེན་པའི་བཤེས་གཉེན།",
    "སྣོད་གཞན་ཞིག་ཏུ་ལ་གྱི་བར་གྱི་ཐུན་གཏོར་གསོ་ཆས་ཀྱི་ཆང་བུ་ལག་གཡོན་གྱིས་བཟོས་པ་མང་དུ་བཅུག་ལ་གཞིག་གཏོར་མའི་རྒྱབ་ཏུ་མཎྜལ་ནས་ཀྱི་ཚོམ་བུ་ལྔའམ་བཅུ་བཀོད་པ་ལ་རོ་རས་སམ་ཤིང་ཤུན་སོགས་ལ་བྲིས་པའི་དབྱུ་གུ་མ་མཆེད་གསུམ་གྱི་། བྲིས་སྐུ་རབ་གནས་ཅན་བཞུགས་སུ་གསོལ།",
    "སྭ་བྷཱ་ཝའི་སྔགས་ཀྱིས་སྟོང་པར་སྦྱངས།",
    "སྐུ་ཆེ་ཞིང་ཡན་ལག་རགས་པ་ཞབས་གཡས་བསྐུམ་གཡོན་བརྐྱང་བའི་སྟབས་ཀྱིས་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པ།",
    "གདན་འོད་ཟེར་གྱི་རྣམ་པར་གྱུར་ནས་རང་ལ་ཐིམ་ཞེས་བརྗོད།",
    "བསྙེན་པའི་སྐབས་སུ་སྔགས་གསུམ་པོ་འདི་ལྷན་ཅིག་ཏུ་ཞག་ཉེར་གཅིག་བཟླ་བའམ་ཡང་ན་སྐུ་གསུང་ཐུགས་ཀྱི་སྔགས་གསུམ་པོ་སོ་སོར་བྱས་ལ་ཞག་བདུན་བདུན་དུ་ངག་བཅད་དེ་བཟླ་བར་བྱའོ།",
    "དེ་ལྟ་བུའི་ཞག་ཉེར་གཅིག་ཏུ་བྱས་པ་འདི་ནི་བསྙེན་པ་རབ་ཀྱི་དུས་ཀྱི་ཚད་ཡིན་ལ།",
    "ལྷག་པར་གནས་བཅས་ཤ་ཟའི་མཁའ་འགྲོ་མ།",
    "འདོད་ཡོན་ཅི་འདོད་རྩོལ་ལ་བསྟོད་པར་བགྱི།",
    "ཇི་ལྟར་བསམ་པའི་དོན་རྣམས་གྲུབ་པར་མཛོད།",
    "ཡོངས་སུ་རྫོགས་པར་བགྱི་བའི་དོན་སླད་དུ།",
    "མ་འབྱོར་པ་དང་སོགས་ཀྱིས་ནོངས་པ་བཟོད་པར་གསོལ་ཏེ་ནོར་ལྷ་མཆེད་གསུམ་གྱི་བྲིས་སྐུ་ལ་བརྟན་བཞུགས་བྱས་ལ།",
    "དེ་ལྟར་ཉམས་ལེན་ལ་བརྩོན་པར་བྱས་པས།",
    "ནོར་འཕྲོག་པ་སོགས་རྨིས་ན་བར་ཆད་འོང་བའི་རྟགས་ཡིན་པས་ཡི་དམ་གྱི་བཟླས་བསྒོམ་སོགས་དགེ་སྦྱོར་ལ་འབད་པར་བྱའོ།",
    "ཡང་དྲིལ་ལ་ཉི་མ་གསུམ་པོ་དེའི་བར་ཁྲི་ཕྲག་གཅིག་རྫོགས་པར་། བཟླའོ།",
    "ཨོཾ་ཨཾ་པ་སོགས་སྔགས་བཟླས་ལ་བསྒྲུབ་བྱ་དམིགས་ཡུལ་དེ་ཡིད་གཟུགས་ཀྱི་རྣམ་པས་འཁོར་ལོ་ལ་ཐིམ་པར་ཡང་ཡང་བསམ་ཞིང་།",
    "བདེ་གཤེགས་བསྟན་པ་རྒྱས་པར་ཤོག།",
    "ཙཀྲ་གོས་གསར་པ་ལ་སྤོས་ཀྱང་རུང་གསུངས།",
    "ཟས་ཟ་ཁ་སུ་རཱ་པ་མ་ཆག་པར་བྱ།",
    "ཐ་ན་བྱིས་པ་ཆུང་དུ་དང་ཁྱི་ལ་སོགས་པས་ཀྱང་བྱམས་པར་འགྱུར་བ་སོགས་བརྗོད་ཀྱིས་མི་ལང་ངོ།",
    "ཁྱད་པར་ནོར་ལྷ་དབྱུ་གུ་མ་མཆེད་གསུམ་གྱི་བདེན་པ་དང་།",
    "སྒྲུབ་པ་པོའི་འཁོར་གཡོག་ལ་གནོད་པར་བྱེད་པའི་བགེགས་ཀྱི་རིགས་རྣམས་རྟེན་འདི་ཉིད་ལ་ཐིམ་པར་གྱུར་ཅིག་ཅེས་དང་།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་ཡང་ཡང་དུ་བརྗོད་པས་དགུག་གཞུག་བྱས་ལ།",
    "རྐང་པ་ཕྱོགས་སུ་གཉིས་ཡོད་པར་བྱས་པའི་མགོའི་ཕྱོགས་ཀྱི་ཤོག་བུའི་མཐའ་ཕྱི་དང་།",
    "དེ་ཡང་ཞི་བ་གཙོ་བོར་བྱེད་ན་དམར་པོ་ནང་ལ་བྱས་ཏེ་ཕྲེད་ལ་། བསྡམ།",
    "སུ་པྲ་ཏིཥྛ་བརྗོད་པས་རབ་གནས་དང་བཀྲ་ཤིས་རྒྱས་པར་བྱ་བ་དམ་པ་གོང་མའི་ཕྱག་ལེན་དུ་སྣང་བས་མ་ཆད་པ་གལ་ཆེ་བ་ལགས།",
    "ལེགས་པར་བསྡུས་ནས་ཚར་དུ་དངར་བ་འདི།",
    "མིང་སྟོང་ཙམ་གྱིས་ཆོག་པར་འཛིན་རྣམས་ལ།",
    "ཚུལ་འདི་འཛམ་གླིང་འགྲོ་བའི་ལེགས་བྱས་ཀུན།",
    "ཁྱད་པར་མེད་པ་བླུན་པོ་འགའ་ཡིས་འཛིན།",
    "མཁའ་འགྲོའི་ཚོགས་ཀྱིས་བཟོད་པར་མཛད་ནས་ཀྱང་།",
    "འགྲོ་ཀུན་བདེ་སྐྱིད་ཕུན་སུམ་ཚོགས་པར་ཤོག།",
    "སྐྱབས་ཡུལ་རྣམས་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམ་པར་བསམ།",
    "གཡོན་གྱི་དང་པོ་ན་སའི་ལྷ་སེར་པོ།",
    "གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པ།",
    "མགྲིན་པར་གསུང་རྡོ་རྗེ་མ།",
    "ཞར་བྱུང་ལུས་དཀྱིལ་རྐྱང་པ་ཉམས་སུ་ལེན་ཚུལ་བཅས་བཞུགསསོ།",
    "གཉིས་སུ་མེད་པར་ཐིམ་པའི་སོགས་ཀྱིས་ལུས་དཀྱིལ་བསྐྱེད།",
    "བསྔོ་སྨོན་ཇི་ལྟར་རིགས་པར་བྱ།",
    "ཆུ་གཉིས་སྔོན་འགྲོའི་ཉེར་སྤྱོད་ལ་སོགས་པ་གཙང་ཞིང་བཀོད་པ་མཛེས་པར་བཤམ།",
    "རྡོ་རྗེ་དྲིལ་བུ་དང་ནང་མཆོད་ལ་སོགས་པ་ཉེ་བར་མཁོ་བའི་ཡོ་བྱད་རྣམས་ཀྱང་མ་ཚང་བ་མེད་པར་བཤམས་། ལ།",
    "ཨོཾ་དང་རྡོ་རྗེ་ལྟེ་བའི་ཧཱུྃ་ལ་ཕོག་པས་བདུད་རྩིའི་རྒྱུན་འཛག་ཡང་ཧཱུྃ་ལས་འོད་ཟེར་ཕྱོགས་བཅུར་འཕྲོས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀ་ནས་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་རྣམས་ཧེ་རུ་ཀ་ཕྱག་གཉིས་པའི་རྣམ་པར་བྱོན་ཏེ་རྡོ་རྗེ་ལྟེ་བའི་ཧཱུྃ་ལ་ཐིམ་པས་རྡོ་རྗེ་ལྗིད་དང་ལྡན་པར་གྱུར་རྡོ་རྗེ་ཉི་མ་ཨོཾ་དང་བཅས་པ་ཐོད་པའི་ནང་དུ་ལྷུང་བ་འོད་དུ་ཞུ་ནས་སྔར་གྱི་བདུད་རྩི་རྣམས་དང་གཉིས་སུ་མེད་པར་གྱུར་ཏེ་ཁ་དོག་དང་དྲི་དང་རོ་དང་ནུས་པ་ཕུན་སུམ་ཚོགས་པའི་བདུད་རྩིའི་རྒྱ་མཚོ་ཆེན་པོར་གྱུར།",
    "གཡོན་གྱི་དང་པོ་ན་སའི་ལྷ་སེར་པོ།",
    "གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པ།",
    "སྐམ་པོ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པ།",
    "ཞབས་གཡོན་བརྐྱངས་པའི་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་སྟབས་ཀྱིས་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པ།",
