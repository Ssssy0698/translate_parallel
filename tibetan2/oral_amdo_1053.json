    "ལམ་བུའི་ཁུག་སོ་ན་ང་ཚོས་སེམས་ཁོང་ནས་ཁྱེད་ལ་ཉེན་ཁ་ཆེ་བའི་ལམ་ཁར་ཡོལ་སོང་ཟེར་བཞིན་ཡོད་ལ།",
    "འདི་དག་ཚང་མ་ཕུ་བོ་ཁྱེད་ཀྱིས་ཐོས་ཡོད་པ་ང་ཚོ་ལ་ཡིད་ཆེས་བརྟན་པོ་ཡོད་ལ།",
    "འཆམ་མཐུན་ཅན་གྱི་ཁམས་པའི་ཕོ་རྒོད་ཞིག་གི་སྣང་བརྙན་དེ་འཇིག་རྟེན་གསར་པ་ཞིག་ཏུ་སྔར་བས་གོང་དུ་འཕེལ་བར་གྱིས་ཤིག།",
    "དེ་རིང་གཅིག་འཆི་གཅིག་གསོན་གྱི་གནས་སུ་གྱུར་སོང་།",
    "ནུབ་ཕྱོགས་དག་ཞིང་གི་བདེ་དཔལ་མྱོང་བཞིན་མཆིས།",
    "ལང་ཚོའི་མཛེས་སྡུག་ངོམ་པའི་སྐལ་བཟང་བྱུང་།",
    "ས་ལ་ལྷུང་བའི་གླུ་དབྱངས་ཤིགའཕུར་ལྡིང་གི་སྡུག་དབྱངས་ཀྱིས་ཀྱང་།",
    "མེ་ཏོག་གི་ཆར་པ་རྣམ་པར་བཀྲ།",
    "ང་ཚོ་ཕྱུག་དུས་ཁོ་རང་ཕེབས་སོང་།",
    "དེ་འདྲའི་གོ་སྐབས་ཤིག་གི་ཁྲོད་དུ་མི་སེར་དཀྱུས་མ་ཞིག་ཁོང་དང་ཐུག་རྗེས་རང་ཉིད་ཀྱི་འཚོ་བ་དང་ཚོང་ལས་ལ་གནམ་ས་ལྟ་བུའི་འགྱུར་ལྡོག་བྱུང་།",
    "ཨ་མེ་རི་ཀའི་ནམ་༤",
    "བློ་མཐུན་པི་ཧྲི་ཞང་གི་མཚན་དེ་ཐོག་མར་ཐོས་དུས།",
    "དེ་འདྲའི་སྤྱིར་བཏང་གི་ཨང་གྲངས་ཀྱིས་ང་ཚོར་ཧ་ལས་པའི་ཚོར་སྣང་སྟེར།",
    "དེ་ནི་ཏང་གི་ལས་མི་ཞིག་གི་འཚོ་བ་དང་ལས་ཀའི་རྗེས་ཤུལ་ངོ་མ་དེ་ཡིན་ནམ།",
    "ཆེས་མཐའ་མའི་སེམས་ཀྱི་ཉི་ཟླའི་ཞིང་ཁམས་དེ་ཁོང་དང་དེ་འདྲའི་འབྲེལ་བ་ཟབ་མོ་ཆགས་སམ།",
    "དེ་འདྲའི་དྲི་བ་དང་བསམ་ཚུལ་མང་པོ་ང་ཚོས་ཕན་ཚུན་བར་ཡང་ཡང་བཏོན་ཞིང་ང་ཚོའི་བློ་སྒོ་གསར་པ་ཞིག་འབྱེད་པ་དང་མཚུངས་ཤིང་དེའི་སྒོ་ཁ་བརྒྱུད་ནས་གསེར་འོད་དྲོན་མོ་ཞིག་ནང་དུ་ཐོན་པ་དང་འདྲ།",
    "ཇུས་འགོད་སྤྱིའི་འགན་ཁུར་བྱེད་པའི་ང་ཚོའི་ཧྲེ་ཀྲང་ཧོ་ཧཱས་སྐད་ཆ་དེ་དག་ཐོས་སྐབས་སེམས་སུ་འཆར་དོན་ཞིག་བྱུང་སྟེ།",
    "གལ་ཏེ་ཁྱོད་ཚོ་ལ་རེ་དོགས་དེ་འདྲ་ཡོད་པ་ཡིན་ན་ང་ཚོས་ཁོང་གི་སྐོར་གྱི་ཆེད་བྲིས་རིང་མོ་ཞིག་བསྐྲུན་ནས་རེ་དོགས་དེ་དག་སེལ་བར་བྱེད་ཆོག་ཅེས་བཤད།",
    "ང་ཚོས་དེ་ལྟར་ཐོས་སྐབས་གཅིག་ནས་དགའ་སྣང་སྐྱེས་ལ་གཅིག་ཤོས་ནས་ཅོའོ་ཡུས་ལོའུ་དང་ཧ་ཅང་མཚུངས་པའི་དབུ་ཁྲིད་འདིའི་སྐོར་ཤེས་པར་རེ་སྒུག་དང་སྤྲོ་བ་བརྟས།",
    "ང་ཚོས་འབད་བརྩོན་བྱས་མཐར་སྔོན་ཆད་པི་ཧྲི་ཞང་དང་ལས་རོགས་ཡིན་པའི་དགེན་ཝ་ཤུལ་ཕུན་ཚོགས་ལགས་ངོ་ཤེས་བྱུང་།",
    "རྩོམ་རིག་སྒྱུ་རྩལ་ལས་རིགས་མཉམ་འབྲེལ་ལྷན་ཚོགས་ཀྱི་ཀྲུའུ་ཞི་དགེན་སྐལ་བཟང་འགྱུར་མེད་རེད།",
    "ཁོང་དང་མཉམ་དུ་ཆེད་རྩོམ་རིང་པོ་འདི་གསར་རྩོམ་བྱེད་པའི་འདོད་མོས་ཡོད་ཟེར།",
    "གཏམ་བཟང་དེ་ནི་ཡུན་རིང་སྐོམ་པས་མནར་བར་བཏུང་ཆུ་ཐོབ་པ་ཇི་བཞིན་ང་ཚོ་ཚང་མར་དགའ་སྣང་རབ་ཏུ་རྒྱས།",
    "ཀྲུང་ཞའོ་ལུང་སོགས་ཀྱིས་རྒྱབ་སྐྱོར་ཆེན་པོ་བྱས་པ་དང་ཉིན་གཉིས་ཀྱི་རིང་ལ་ང་ཚོར་འདྲ་པར་མང་པོ་མཁོ་སྤྲོད་བྱས།",
    "ཆེད་འབྲི་རིང་མོ་འདི་གཟའ་འཁོར་གཅིག་གི་ནང་ཡིག་སྒྱུར་ཚར་བའི་རེ་བ་དང་བཅས་གང་ཐུབ་གང་འཇོན་ངང་བསྒྱུར་ཡོད་ཅིང་ནོར་འཁྲུལ་མང་པོ་ཡོད་སྲིད་པས་ཀློག་པ་པོ་རྣམས་ལ་བཟོད་གསོལ་ཞུ།",
    "སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ནས་བཀྲམ།",
    "གཏིང་ཟབ་གངས་རིའི་བུ་ཕྲུག་སྒོས་གཞི་རིམ་ལ་བསྐྱོད་པར་རྒྱུན་འཁྱོངས་བྱས།",
    "ཁོང་གིས་ས་ཡོམ་རྗེས་ཀྱི་ལོ་གཅིག་གི་རིང་ལ།",
    "ནུས་ཤུགས་གང་ཡོད་ཀྱིས་གནོད་ཐེབས་མང་ཚོགས་དང་བསྐྱར་འཛུགས་ལ་རོགས་སྐྱོར་བྱས།",
    "ལེ་དབར་ཁྲི་ཁ་ཤས་ལ་བསྐྱོད་ཡོད་པ་རེད།",
    "མང་ཚོགས་རིག་རྩལ་འཁྲབ་སྟོན་གྱི་བྱ་འགུལ་སྤེལ་གནས་ཚང་མར་དར་དམར་ཆུང་ཆུང་གི་རྟགས་བཀོད་ཡོད།",
    "ན་མོ་གུ་རུ།",
    "ཐུན་མོང་དང་།",
    "ཐུན་མོང་མ་ཡིན་པའོ།",
    "གཉིས་པ་ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོ་ནི་རང་བབས་གསུམ་གྱི་སྟེང་དུ་འཇོག་པ་སྟེ།",
    "ལག་པ་གཉིས་མཉམ་བཞག་གི་ཕྱག་རྒྱ་བཅས།",
    "མིག་གི་བལྟ་སྟངས་དང་བཅས་པ་འདི་སྒོམ་མཉམ་པའི་བསྒོམ་འདོད་ཀྱི་རྟོག་པ་དང་བྲལ་ཏེ་མ་བཅོས་པར་འཇོག་པ་ནི་སེམས་རང་བབས་སོ།",
    "དེའི་ངོ་བོ་ལ་ཅེ་རེ་བལྟས་ནས་གསལ་སྟོང་འཛིན་མེད་དུ་ཆམ་སོངས་པ་དང་།",
    "དེའི་བསྟན་ཚད་ནི་ལུས་ངག་གི་བྱ་བས་མི་འཕྲོག་པའོ།",
    "མོས་གུས་དུང་པ་བྱས་ལ་གསོལ་བ་འདེབས་པ་དང་།",
    "ཡེངས་རྒྱུ་སྐད་གཅིག་ཙམ་ཡང་མེད་པར་ཉིན་མཚན་སྤྱོད་ལམ་ཐམས་ཅད་རྟོག་མེད་ཀྱི་ངང་དུ་ཁོར་མོར་གནས་པའོ།",
    "དེས་ཀླུའི་བུ་མོ་རྒྱ་མཚོ་ལ།",
    "བརྒྱུད་ཚུལ་གཞན་ཡང་མང་དུ་ཡོད་མོད་ཀྱི།",
    "འདིར་ནི་བདག་ཅག་ལྟ་བུ་མཐོང་བ་ཆུང་བ་དག་གིས་ཇི་ལྟར་ཐོས་པ་ཉིད་བྲིས་པ་ཙམ་མོ།",
