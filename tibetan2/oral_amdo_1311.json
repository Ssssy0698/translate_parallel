    "ཉན་ཐོས་ཀྱི་ཐར་བ་བདེན་པར་མ་གྲུབ་པ་དེའི་ཐོབ་བྱའི་གཙོ་བོ་ཡིན་པ་ལྟར་ཉོན་མོངས་བདེན་པར་མ་གྲུབ་བ་དེའི་སྤང་བྱའི་གཙོ་བོ་ཡིན་བྱས་ཆོག་གམ་མི་ཆོག་ལགས།",
    "བཞི་བའི་ཉོན་མོངས་མངོན་དུ་གྱུར་སྟོབས་ཀྱིས་སྤེལ་སྒོམ་ཟག་བཅས་ལས་ཉམས་པ་མེད་པས།",
    "ཝརྣམ་མཁྱེན་དམིགས་ཡུལ་དུ་བྱེད་པའི་བསམ་བྱུང་དང་སྒོམ་བྱུང་གི་ངོ་བོར་གྱུར་པའི་ཐེག་ཆེན་སེམས་བསྐྱེད་ཀྱི་དམིགས་ཡུལ་གཉིས་འདྲའམ་མི་འདྲ།",
    "བསམ་བྱུང་དང་སྒོམ་བྱུང་གི་སེམས་བསྐྱེད་གཉིས་ཀྱི་དམིགས་ཡུལ་འདྲ་ལ།",
    "རང་གི་རྫས་རྒྱུན་སློབ་པའི་དོན་དམ་སེམས་བསྐྱེད་ཡོད་པས་ཁྱབ་མ་ཁྱབ།",
    "དེས་སྐད་ཅིག་རེ་རེ་ལ་བདག་ལྟའི་བག་ཆགས་འཇོག་པའི་ཕྱིར།",
    "ཡ་འཇུག་ཤེས་སུ་གྱུར་པའི་མ་འདྲེས་པའི་མ་རིག་པ་མཐོང་སྤང་ཉོན་མོངས་ཁོ་ནར་དབུ་སེམས་ཀུན་གྱིས་འདོད་པ་ཨེ་ཡིན་པ་དང་།",
    "སེམས་ཙམ་བས་མཐོང་སྤང་དགོས་ཞེས་པ་དོན་གསང་ལ་བརྟེན་ཅིང་ཐལ་རང་གིས་མཛོད་ལ་བརྟེན་པས་མི་དགོས་སོ།",
    "རིགས་ཆད་པའི་ཉོན་མོངས་རྒྱུད་ཐ་དད་པའི་མཐོང་སྒོམ་གྱི་བར་ཆད་མེད་ལམ་གྱི་སྟོབས་ཀྱིས་སྤངས་པས་འཇོག་གོ།",
    "སྔོ་འཛིན་མིག་ཤེས་ཀྱི་ཐུན་མོང་དམུ་དགེ་ཐུབ་བསྟན་རྒྱ་མཚོ་སོགས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ཕྱི་རོལ་གྱི་རྡུལ་ཚོགས་ཙམ་མིན་པར་ནང་གི་སེམས་ཀྱི་ནུས་པ་སྨིན་པ་ལས་བྱུང་བས་དེ་ལྟར་གསུངས་ཀྱི་ནུས་པ་ལྡན་མིན་ལ་དེ་འཇོག་ཟེར་བ་མིན་ནོ།",
    "ཡོད་ན་ཉོན་མོངས་ཅན་ཡིན་མིན་སོགས་ཇི་ལྟར་ལགས།",
    "ཉོན་མོངས་ཅན་ཡིན་པའི་ཕྱིར།",
    "ལས་ནི་བྱ་བ་དེ་བྱས་སོ་སྙམ་པ་ལྟ་བུའི་ཀུན་སློང་གི་བསམ་དོན་རྫོགས་པའི་སྐབས་ཀྱི་དེ་མཐུན་གྱི་ལས་ལ་བྱེད་པས།",
    "ལུས་ངག་གི་ལས་བྱ་བ་དེ་གྲུབ་པའི་སྐབས་ལ་འཇོག་པས་དེ་ལ་སེམས་པའི་ལས་མེད་དེ།",
    "འཕེན་བྱེད་ངེས་པའི་ལས་གསུམ་པོ་རང་རང་གི་རྣམ་སྨིན་མྱོང་བའི་མགོ་རྩོམ་པ་ནས་མཇུག་མ་རྫོགས་ཀྱི་བར་དུ་རྣམ་སྨིན་མཚུངས་ལྡན་དང་མཚུངས་ལྡན་མ་ཡིན་པ་ཆད་རྒྱུ་ཡོད་མེད་སོགས་ཇི་ལྟར་ལགས།",
    "ངེས་པའི་ལས་གསུམ་གང་གི་ཡང་རྣམ་སྨིན་མྱོང་བའི་འགོ་བརྩམས་ནས་བར་སྐབས་སུ་ཆད་པ་ཡོད་དེ།",
    "དེས་ན་གོང་མའི་རྟེན་ཅན་གྱི་ཕྱིར་མི་འོང་གི་སྐྱེ་བ་འཕེན་བྱེད་ཀྱི་ལས་གོང་མའི་རྟེན་ལ་བསགས་ནས་ཚེ་འདིར་རྣམ་སྨིན་མྱོང་བའི་འགོ་བརྩམས་ཀྱང་ཕྱི་མར་མིར་སྐྱེས་ཏེ་སླར་དེའི་དམུ་དགེ་ཐུབ་བསྟན་རྒྱ་མཚོ་སོགས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "བདུན་པ་ཚོར་བ་གྲུབ་པའི་གང་ཟག་གི་རྒྱུད་ཀྱི་འཕངས་འབྲས་ཀྱི་ཚོར་བ་ལ་བདུན་པ་ཚོར་བས་ཁྱབ་པའི་ཕྱིར།",
    "གི་ཕ་བུད་མེད་དུ་མཚན་གྱུར་པ་ཅིག་བསད་པའི་ལས་དེ་སྐྱེས་པ་དང་བུད་མེད་བསད་པའི་ལས་གཉིས་ཀྱི་གང་ཡིན།",
    "གལ་ཏེ་བསད་པའི་ཚེ་བསད་བྱ་བུད་མེད་ཡིན་ཀྱང་དེ་བུད་མེད་བསད་པའི་ལས་མིན་བྱས་ཨེ་ཆོག་ཆོག་ན་དགེ་སློབ་ཕ་དགེ་སློང་མར་མཚན་གྱུར་པ་ཅིག་བསད་པའི་ལས་དང་།",
    "འོན་ཀྱང་ཕར་གྱུར་པའི་སྐྱེས་པ་དང་བུད་མེད་གང་ཡང་བསད་པའི་ལས་མིན་ཟེར་དགོས་སོ།",
    "ཁམས་གསུམ་གྱི་བག་ཆགས་བསྒོ་གཞི་གཅིག་ཏུ་ཐལ་བ་སོགས་སོ།",
    "དེ་རེ་རེ་ལ་ཡུལ་དང་ཡུལ་ཅན་རྣམ་ཀུན་མཆོག་ལྡན་གྱི་ཐ་སྙད་ཡོད་མེད་དང་།",
    "ཡིན་ན་ཚད་འབྲས་ལ་རྣམ་པར་བཞག་འཇོག་གི་རྒྱུ་འབྲས་མི་དགོས་པར་འགྱུར་ན་དེ་ཇི་ལྟར་ལགས།",
    "ཉིའཕགས་པའི་མཉམ་བཞག་ཡེ་ཤེས་ལ་སོ་སོ་རང་རིག་གི་ཡེ་ཤེས་མི་འཐད་པར་ཐལ།",
    "སྐབས་འདིའི་ཕྱོགས་སྔའི་ལུགས་ལ་འཕགས་པའི་མཉམ་བཞག་ཡེ་ཤེས་ཀྱི་སྣང་ཡུལ་སོགས་ལ་བདག་མེད་ཕྲ་མོ་ཡོད་མེད་ཇི་ལྟར་ལགས།",
    "འཕགས་པ་རྣམས་ཀྱི་སོ་སོ་རང་གིས་རིག་པར་བྱ་བའི་དོན་དམ་པའི་དངོས་པོ་ནི་གདོན་མི་ཟ་བར་ཡོད་དོ།",
    "དྲངས་མ་ཐག་པ་ལྟར་འོག་ཏུ་ཡེ་ཤེས་རང་རིག་གི་དོགས་གཅོད་མཛད་དགོས་བྱུང་བ་ཡིན་ལ་ཞེས་དང་།",
    "ཡང་ཁོ་ན་རེ།",
    "དེའི་དགོངས་པར་མཛད་དེ་རྣམ་འགྲེལ་ཊཱིཀ་ཆེན་ལས་ཀྱང་སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་ཞེས་བརྗོད་པ་གང་ཡིན་པ་ཤེས་པ་རྣམས་ཀྱི་མྱོང་བ་གསལ་རིག་གི་ཆ་ཞེས་པ་ནས་འདི་དང་ཤེས་པའི་འཛིན་རྣམ་ལ་ཁྱད་པར་མེད་དོ་ཞེས་དང་།",
    "ཡོངས་གྲུབ་ཀྱི་མཚན་ཉིད་རང་གི་མྱོང་བྱར་གྱུར་པའི་ཤེས་པའི་གནས་ལུགས་གང་ཞིག་གཉིས་སྣང་དང་བྲལ་བའི་གསལ་རིག་ཅེས་བྱའོ་ཞེས་གསུངས་ཏེ།",
    "ཡོངས་གྲུབ་མྱོང་བ་གསལ་རིག་གི་ཆ་ལ་བཞག་པ་ནི་མཉམ་བཞག་ཟག་མེད་ཀྱི་ཚེ་ཕྱི་རོལ་གྱི་ཡུལ་སྣང་མཐའ་དག་འགགས་ནས་ཡེ་ཤེས་དེ་ལ་ཐིམ་པ་ལྟར་སྣང་བས་ཡིན་ནམ་སྙམ་སྟེ།",
    "སྤྱན་རས་གཟིགས་བརྟུལ་ཞུགས་ཀྱིས་སེམས་དམུ་དགེ་ཐུབ་བསྟན་རྒྱ་མཚོ་སོགས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ལུང་འདི་དག་ལ་གོ་རྒྱུ་ཕྲ་མོ་ཞིག་འདུག་གོ།",
    "རྣམ་འགྲེལ་ཊཱིཀ་ཆེན་དུ་ཡུལ་ཙམ་ཡིན་ཀྱང་གཟུང་དོན་མ་ཡིན་པ་གཟུང་དོན་དུ་ཐལ་བ་འཕེན་པ་འཇོག་པར་གསུངས་པས་གཉིས་ཀ་ཁས་ལེན་བྱས་ཨེ་ཆོག་ལགས།",
    "ཡུལ་མ་ཡིན་པ་གཟུང་དོན་དུ་ཐལ་བ་འཕངས་པ་ཡིན་ལ།",
    "ཁྱོད་ལ་དེའི་རྣམ་པ་ཤར་བའི་ཕྱིར།",
    "ཁྱབ་ན་བསམ་གཏན་གཉིས་པ་སོགས་ཀྱི་ཉེར་བསྡོགས་མཚན་ཉིད་སོ་རིག་གི་ངོ་བོར་གྱུར་པའི་འདོད་སེམས་དེ་རྟོག་དཔྱོད་དང་མཚུངས་ལྡན་དུ་སོང་ན།",
    "ནིབསམ་གཏན་དང་པོའི་སྙོམས་འཇུག་ཉོན་མོངས་ཅན་གྱི་གྲོགས་སུ་གྱུར་པའི་སྲེད་ལྟ་ང་རྒྱལ་མ་རིག་པ་བཞི་བོ་དེ་བསམ་གཏན་དང་པོའི་སྙོམས་འཇུག་ཉོན་མོངས་ཅན་ཨེ་ཡིན།",
    "ཡིན་ན་བསམ་གཏན་དང་པོའི་སྙོམས་འཇུག་ཉོན་མོངས་ཅན་གྱི་སྲེད་པའི་རྫས་རྒྱུན་སྔ་མར་གྱུར་པའི་བསམ་གཏན་དང་པོའི་སྙོམས་འཇུག་དག་པ་བ་སོགས་ཡོད་དགོས་པས།",
    "དེ་ཁམས་གོང་གི་རྟེན་ལ་སྦྱོར་བྱུང་གི་བསམ་གཏན་དང་པོའི་དངོས་གཞི་གསར་དུ་ཐོབ་པ་ཡོད་མེད་དང་།",
    "ཁྱོད་བར་དུ་བརྒྱུད་བོར་ནས་འཇུག་པར་བྱེད་པའི་ཞེས་དང་།",
    "འདིར་ཡང་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་བྱེད་ལ་སྙོམས་པར་འཇུག་པའི་སྒྲས་བསྟན་པ་ཡིན་བྱས་ཨེ་ཆོགཆོག་ན་བར་དུ་བརྒྱུད་བོར་ཞེས་པ་ནི་གང་ཡང་བར་དུ་མ་བཅུག་པའི་ཡར་སོང་གི་སྙོམས་འཇུག་དགུའི་རྗེས་དེ་མ་ཐག་ཏུ་འགོག་པ་དང་སྤེལ་བའི་སྤེལ་གཞིའི་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་ཚེ་བར་དུ་བརྒྱད་བོར་བ་ལ་བྱས་ན་ཨེ་ཆོག་ཆོག་ན་གང་ཡང་བར་དུ་མ་བཅུག་པའི་ཡར་སོང་གི་མཐའི་འགོག་པ་ལས་ལངས་ནས་བསམ་གཟུགས་བརྒྱད་ལ་ལུགས་མི་མཐུན་དུ་སྙོམས་པར་འཇུག་རིགས་པ་ལས་མ་ཞུགས་པར་ཡར་སོང་འགོག་པ་དང་སྤེལ་བའི་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་པས་ན།",
    "དེར་ཐལ།",
    "རང་གི་སྔོན་དུ་བསམ་གཟུགས་དགུ་བོར་རྗེས་སུ་བཞི་བོར་ནས་འགོག་པ་ལ་འཇུག་བྱེད་ཀྱི་བསམ་གཏན་ཡིན་པའི་ཕྱིར།",
    "དེ་འདྲའི་བསམ་གཏན་བཞི་བ་དེའི་སྔ་རོལ་དེ་མ་ཐག་གི་འགོག་པའི་སྔོན་དུ་བོར་རྒྱུ་ལྔ།",
    "བར་དུ་བརྒྱད་བོར་བ་ནི་སྦྱོར་བ་ལུགས་ལྡོག་གི་བསམ་གཏན་དང་པོའི་རྗེས་སུ་ཁོ་རང་གི་བསམ་གཏན་དང་པོ་ལ་ཞུགས་པས་དེའི་བར་དུ་གཉིས་པ་ནས་འགོག་པའི་བར་བརྒྱད་བོར་བ་ཡིན་ཏེ།",
    "ཁོ་རང་གི་རྗེས་སུ་བོར་བའི་དོན་མིན་ཏེ།",
    "ཁྱོད་བར་དུ་བརྒྱད་བོར་ནས་འཇུག་པར་བྱེད་པའི་ཏིང་ངེ་འཛིན་ཡིན་པའི་ཕྱིར།",
    "ཁྱོད་མཐར་གནས་སྙོམས་འཇུག་དགུའི་རྗེས་དེ་མ་ཐག་ཏུ་བརྒྱད་བོར་ནས་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་པའི་ཐོད་རྒལ་གྱི་ཏིང་ངེ་འཛིན་ཡིན་པའི་ཕྱིར།",
    "ཞེས་ཁོ་རང་བརྒྱད་བོར་ནས་དང་པོ་སོགས་ལ་འཇུག་པར་གསུངས་ཀྱི་ཁྱོད་ཀྱི་མཐར་གནས་སྙོམས་འཇུག་དགུའི་རྗེས་ཞེས་མ་གསུངས་པའི་ཕྱིར་དང་།",
    "ཁོ་རང་གི་མཐའི་འགོག་པ་དང་འགོག་པ་སྤེལ་བའི་ཡར་སོང་གི་དང་པོའི་བར་ན་བོར་རྒྱུ་བརྒྱད་མེད་པའི་ཕྱིར་རོ།",
    "གང་ཡང་བར་དུ་མ་བཅུག་པའི་ཡར་སོང་གི་སྙོམས་འཇུག་དགུ་ཞུགས་ནས་བོར་བ་ལ་བྱས་ཆོག་གམ་སྙམ་སྟེ།",
    "མ་ཞུགས་པར་བོར་བའི་བོར་རྒྱུ་རྣམས་ལ་སྤྱི་ཙམ་ལས་རྒྱུད་གཅིག་ཐ་དད་གང་གི་རྒྱུད་ལ་བཞག་ཏུ་མི་རུང་ངོ།",
    "འབྱུང་འགྱུར་གྱི་སྒྲ་རྩོད་གཞིར་བཟུང་ཚེ་ཕ་རོལ་བོ་ལ་མི་འགྲུབ་པས་གང་གི་ཡང་ཁྱད་པར་མ་སྦྱར་བའི་སྒྲ་སྤྱི་ཙམ་འཛིན་དགོས་ཞེས་ལེགས་ལྡན་རང་ཉིད་ཀྱིས་འདོད་བཞིན་དུ།",
    "དོན་མིག་སོགས་བདག་ལས་མི་སྐྱེ་བར་སྒྲུབ་ཚེ་མིང་ལ་མིག་སོགས་སྤྱི་ཙམ་འཛིན་པ་ལྟར་སྣང་ཡང་དོན་ལ་རང་མཚན་གྱིས་གྲུབ་པའི་མིག་སོགས་འཛིན་པ་ཁོ་ན་ཡིན་པས་ཁྱེད་ཉིད་ཀྱི་དཔེ་དང་དོན་མི་མཐུན་ཞེས་བྱས་ན་གཞུང་གི་དགོངས་པ་རྣལ་མར་འགྲོ་མི་འགྲོ་ཇི་ལྟར་ཡིན།",
    "སྐབས་འདི་ལ་གོ་བ་ཅུང་ཟད་ཀྱང་མི་ཆགས་པས་གོ་སླ་བའི་ཐབས་མཆོག་རྒྱས་པར་གནང་རྒྱུ་ཅིས་ཀྱང་ཐུགས་རྗེས་གཟིགས།",
    "དེ་ཡོད་པར་ཐལ།",
    "དངོས་སྨྲ་ནང་ཕན་ཚུན་དང་ཐལ་འགྱུར་བ་ནང་ཕན་ཚུན་རྩོད་ཚེ་ཡོད་པའི་ཕྱིར་ན་མ་ཁྱབ་ཟེར་དགོས་ཏེ།",
    "ལེགས་ལྡན་གྱིས་ཀུན་རྫོབ་དང་དོན་དམ་སོགས་རང་རང་གི་འདོད་པའི་ཁྱད་པར་མ་སྦྱར་བར་རྒོལ་ཕྱི་རྒོལ་གཉིས་ཀའི་ཐུན་མོང་སྤྱི་ཙམ་འཛིན་དགོས་ཏེ།",
    "རང་མཚན་གྱི་ཁྱད་པར་དོར་ནས་འཛིན་ཚུལ་མེད་པར་ཁྱོད་རང་འདོད་པའི་ཕྱིར་ཏེ།",
    "འབྱུང་འགྱུར་དང་ནམ་མཁའི་ཡོན་ཏན་ལྟ་བུའི་ཁྱད་པར་དོར་ནས་འཛིན་ལུགས་ཡོད་ཀྱང་རང་མཚན་གྱི་ཁྱད་པར་དོར་ནས་འཆར་ཚུལ་མེད་པར་ཁྱོད་ཀྱང་འདོད་པའི་ཕྱིར་གསུངས་པ་ཡིན་ནོ།",
    "གཉིས་བདེན་གྲུབ་ཏུ་སྣང་བ་ལྟར་གྲུབ་པར་འཛིན་པའི་བདེན་འཛིན་འཇོག་གི་དེ་གཉིས་བདེན་གྲུབ་ཏུ་འཛིན་ཙམ་མི་འཇོག་སྟེ།",
    "གཟུགས་ལྟ་བུ་གཅིག་གི་བདེན་འཛིན་ལའང་གཟུགས་རང་གི་ངོ་བོས་གྲུབ་ཙམ་དུ་འཛིན་པ་དང་སྣང་བ་ལྟར་གྲུབ་པར་འཛིན་པ་གཉིས་ལས་ཕྱི་མ་ཁོ་ན་འཇོག་དགོས་པའི་ཕྱིར།",
    "འཇིག་རྟེན་རང་དགའ་བ་མ་ཡིན་པའི་གང་ཟག་གི་རྒྱུད་ལ་འཇིག་རྟེན་ཤེས་ངོར་ཡང་དག་འཇོག་བྱེད་ཀྱི་བདེན་འཛིན་མེད་པར་འགྱུར་ན་དེ་ཇི་ལྟར་ཡིན་པ་དང་།",
    "འཇིག་རྟེན་རང་དགའ་བའི་ཤེས་པ་ནི་དེ་ཁོ་ན་ཉིད་ལ་བློ་ཁ་མ་ཕྱོགས་པའི་གང་ཟག་གི་རྒྱུད་ཀྱི་ཤེས་པ་ལ་བྱེད་པ་ཡང་ལོག་གི་མཚན་ཉིད་སོགས་ཀྱིས་ཤེས་སོ།",
    "དེ་བཞིན་དུ་ཐལ་འགྱུར་བའི་ལུགས་ལའང་འཇིག་རྟེན་ཤེས་ངོའི་ཡུལ་ལོག་པ་ཡིན་གྱི་ཡུལ་ཅན་ལོག་པ་མིན་ཏེ།",
    "ཁྱོད་འདིའི་འཇིག་རྟེན་ཤེས་ངོའི་ཡུལ་ཅན་ལོག་པ་ཡིན་པའི་ཕྱིར།",
    "དགྲ་བཅོམ་པ་དང་དག་སའི་སློབ་པ་འཕགས་པའི་རྗེས་ཐོབ་ཡེ་ཤེས་ཀྱི་ངོར་ཀུན་རྫོབ་བདེན་པ་མ་ཡིན་པར་ཐལ།",
    "དེ་ལ་དགོངས་ནས་འོག་ཏུ་བྱས་པ་ལ་ཁོ་ན་རེ།",
    "གཟུགས་སོགས་ལྔ་འཇིག་རྟེན་ཤེས་ངོ་ལ་ལྟོས་ཏེ་ཡང་དག་ཡིན་པར་ཐལ།",
    "ཀུན་རྫོབ་བདེན་པ་མ་ཡིན་པར་ཐལ།",
    "འཇིག་རྟེན་རང་དགའ་བའི་ཤེས་ངོར་ཡང་ལོག་གཉིས་འཇོག་གི་འཇིག་རྟེན་ཤེས་ངོར་མི་འཇོག་ཅེས་པ་གཞུང་གི་དགོངས་པ་མཐར་ཐུག་ཡིན་ཞེས་ཟེར་རིགས་སོ།",
    "ཡང་དེ་དག་འཇིག་རྟེན་པའི་ཤེས་ངོར་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "བུམ་པ་འཇིག་རྟེན་ཤེས་ངོ་ལ་ལྟོས་ཏེ་ཡང་དག་ཀུན་རྫོབ་ཏུ་བཞག་ཀྱང་སྐྱོན་མེད་པར་ཐལ།",
    "འདོད་བྱས་པ་ལ་ཁོ་ན་རེ།",
    "འཇིག་རྟེན་ཤེས་ངོ་ལ་ལྟོས་ཏེ་ཀུན་རྫོབ་ཡིན་པར་ཐལ།",
    "ཅེས་སྟོང་ཐུན་གྱི་དོན་བློ་གཅིག་གི་ངོར་ཡང་དག་དང་ཀུན་རྫོབ་གཉིས་ཀ་མིན་པ་ལ་བྱས་ནས་དེའི་ངོར་ཡང་དག་ཀུན་རྫོབ་ཡིན་ཞེས་པ།",
    "དེས་ནི་འགའ་ཞིག་གིས།",
    "ཞེས་གསུངས་པ་གང་ཞིག་བློ་དེ་དག་གི་འཛིན་སྟངས་ཀྱི་ངོ་ལ་མ་སྦྱར་ན་ལྟོས་ཚུལ་མེད་པའི་ཕྱིར་དང་།",
    "སྔར་གྱི་ལུང་དེ་དག་གིས་འཇོག་བྱེད་བདེན་འཛིན་གྱིས་དེ་དག་ཡང་དག་ཏུ་བཞག་པ་ལ་འཇིག་རྟེན་པའི་ཤེས་པས་གནོད་པ་མེད་པར་གསུངས་ཀྱི།",
    "དེས་ན་ལུང་དེ་དག་གི་དོན་ནི།",
    "གཟུགས་བརྙན་སོགས་སྣང་བ་ལྟར་གྲུབ་པས་འཛིན་པའི་བློ་བདེན་འཛིན་མིན་པས་ཡང་དག་འཇོག་བྱེད་བདེན་འཛིན་ལ་བྱེད་ན་གཟུགས་བརྙན་ཡང་དག་ཏུ་ཐལ་བའི་སྐྱོན་མེད་དེ།",
    "གཟུགས་དང་དེ་བདེན་གྲུབ་གཉིས་འཇོག་བྱེད་གཅིག་གིས་ཡང་དག་ཏུ་བཞག་ཆོག་གོ།",
    "ཞིམིར་གྱུར་པའི་བཅས་ལྡན་དགེ་སློང་གི་རྒྱུད་ཀྱི་ཐེག་ཆེན་སེམས་བསྐྱེད་ཀྱི་གཏན་གྱི་བག་ཆགས་བསྒོ་གཞི་ལ་མི་དང་དགེ་སློང་སོགས་ཡོད་མེད།",
    "གྲུབ་མཐར་ཆེན་མོ་ལས།",
    "འིམིའི་ཡུལ་གྱི་ས་སྟེང་ནས་བབས་པའི་ཆུ་ཀླུང་ནས་བླང་བའི་རླན་གཤེར་ཕོར་གང་བོ་གཅིག་གི་སྟེང་དུ་ལས་ཅན་གྱི་ལྷ་མི་ཡི་དྭགས་གསུམ་དུས་མཉམ་དུ་འོང་བའི་ཚེ།",
    "རེས་ལུས་ཀྱི་དམུ་དགེ་ཐུབ་བསྟན་རྒྱ་མཚོ་སོགས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "གཅིག་ཆར་ཐོབ་གཞི་ལ་མཐོང་ཐོབ་པའི་རྒྱུད་ཀྱི་སྐྱེ་འགྱུར་མ་འོངས་པའི་ཉོན་མོངས་འཇོག་སྟེ།",
    "ཀུམི་སློབ་པའི་སེམས་ཀྱི་དེ་མ་ཐག་འབྲས་ལ་ཁམས་གསུམ་གྱི་ཉོན་མོངས་དམུ་དགེ་ཐུབ་བསྟན་རྒྱ་མཚོ་སོགས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ཁུསྐབས་འདིའི་མངལ་དུ་འཇུག་པ་སོགས་ཤེས་པའི་བློ་ལ་ཉོན་མོངས་ཅན་འཇོག་མི་འཇོག་དང་།",
    "སྐྱེ་སེམས་ཉོན་མོངས་ཅན་གྱིས་ཤེས་ཀྱང་མ་རྟོགས་ཟེར་དགོས་ལ།",
    "གུལྷོ་གླིང་དབུས་མའི་དབུས་ཀྱི་ས་ཆར་དབྱར་ཉི་ལྡོག་གི་དུས་ཚོད་བྱུང་མ་ཐག་པའི་ཉིན་ཞག་དེའི་ཐོག་མར་འཆར་བའི་དུས་སྦྱོར་ལ་རྒྱའི་དུས་སྦྱོར་ཡིན་པས་ཁྱབ་པ་ཨེ་ཡོད་དང་།",
    "ཉིན་ཞག་གང་ལ་དབྱར་ཉི་ལྡོག་གི་དུས་ཚོད་གསར་དུ་བྱུང་ཚེ་ཉིན་ཞག་དེའི་ཉི་ཕྱེད་ཁོ་ནར་འབྱུང་མི་འབྱུང་ཇི་ལྟར་ལགས།",
    "ང་རང་ཚོའི་ས་ཆ་འདིར་མིན་ནོ།",
    "ཇུའདོད་པའི་སྡུག་བསྔལ་མཐོང་སྤང་གི་ལོག་ལྟ་སོགས་རང་ས་ལ་དམིགས་པའི་ཆ་ནས་སྐལ་བ་མཉམ་པའི་ཀུན་འགྲོ་དང་།",
    "གཞན་ཡང་འདོད་པའི་སྡུག་བསྔལ་མཐོང་སྤང་གི་ལོག་ལྟ་སོགས་རང་ས་ལ་དམིགས་ཙམ་གྱིས་ཁམས་སྐལ་མཉམ་ལ་དམིགས་པར་འཇོག་ལ།",
    "བསམ་གཏན་དང་པོའི་ས་བའི་སྡུག་བསྔལ་མཐོང་སྤང་གི་ལོག་ལྟ་སོགས་རང་ས་ལ་དམིགས་ཙམ་གྱིས་ཁམས་སྐལ་མཉམ་ལ་དམིགས་པར་མི་འཇོག་པ་ནི་འདོད་ཁམས་ལ་ནང་གསེས་ཀྱིས་ཕྱེ་བའི་ས་ཐ་དད་པའི་གནས་མེད་ལ།",
    "བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་སྐྱེ་བ་ལ་མངོན་དུ་གྱུར་པ་ཡིན་མི་སྲིད་དུ་ཐལ།",
    "ན་མི་སྐྱེ་བས་རང་རང་གི་ལོ་གྲངས་ཚང་དགོས་པ་འདིས་ཤེས་ཞེས་པ་ཡིན་གྱི།",
    "འགའ་ཞིག་གིས་ཁྱིམ་སོ་བཟུང་བ་ལོ་བཅུ་གཉིས་པ་ལ་མའི་སྡོམ་པ་སྐྱེ་ཚེ་མཚན་འགྱུར་ན་ཕའི་སྡོམ་པ་སྐྱེ་བར་འགྱུར་རོ།",
    "དེས་ན་ལོ་ཡི་སྟེ་ལོ་ཉི་ཤུ་མ་ལོན་པར་རང་གིས་ཤེས་བཞིན་དུ་དགེ་སློང་ཕའི་སྡོམ་པ་སྐྱེ་བ་ཡོད་པས་དེ་ཕའི་སྡོམ་བ་སྐྱེ་བའི་བར་ཆད་ཡིན་མིན་ཞིབ་ཆ་འདིས་ཤེས་སོ།",
    "མུགང་ཟག་གཅིག་ལ་ཐུན་མོང་གི་ཕམ་པ་བཞི་གཅིག་ཆར་བྱུང་བ་ཡོད་མེད་དང་།",
    "མའི་དབྱེན་གྱི་ལྷག་མ་སྤོ་དགའ་མོས་དགེ་སློང་མ་རྣམས་དང་འཐབ་གྲོལ་བྱེད་པ་ལས་བཅས་པའི་ཕྱིར་དང་།",
    "དགེ་སློང་གིས་ཚེས་ལ་མར་རྙེད་ལ་དེ་ཚེས་གཉིས་ལ་གཞན་ཞིག་ཀྱང་རྙེད་པར་གྱུར་ན་དེས་སྔ་མ་ཤོས་བཟའ་བར་བྱ་ཞིང་ཕྱི་མ་ཤོས་བཏང་བར་བྱ་བའམ་རུང་བར་བྱ་བའམ་གཞན་ལ་བྱིན་པར་བྱའོ།",
    "འགའ་ཞིག་གིས།",
    "ཛུཟླ་འཇོག་གི་སྤང་ལྟུང་ལ་ཁ་སྐོང་ལ་རེ་བ་ཡན་ལག་ཏུ་དགོས་ཀྱང་གོས་འཆང་སྤང་ལ་ཁ་སྐོང་ལ་མི་རེ་བ་ཡན་ལག་ཏུ་ལྡན་མི་ལྡན་གཉིས་ཡོད་བྱས་ཆོག་གམ་མི་ཆོག་གཞན་ཡང་ནག་འབྱམ་དཀར་འབྱམ་སོགས་ཀྱི་འཇོག་ཚུལ་ཇི་ལྟར་ཡིན་པ་དང་།",
    "ཟླ་འཇོག་ལ་རེ་བ་དགོས།",
    "འཆང་སྤང་ལ་ཁ་སྐོང་གི་རེ་བ་མེད་པ་དགོས་པ་རྩ་བར་གསལ།",
    "དཀར་འབྱམ་སོགས་ལྕི་ཡང་གིས་བཏགས་པ་འདྲ་ཡང་གསལ་བོ་མ་མཐོང་ངོ།",
    "མཚོ་ཊཱིཀ་ཏུ་ནག་འབྱམ་ཆེན་མོ་རང་ལུགས་སུ་གསུངས་ཀྱང་།",
    "འཁྲུ་བ་ལ་སོགས་པ་ནི་དགེ་སློང་གིའོ།",
    "དགེ་སློང་གི་གོས་འཁྲུ་བ་སོགས་བྱས་ན་བྱུང་ངོ།",
    "ཟུཉིན་ཞག་གཅིག་ལ་གནས་ཁང་གཅིག་ཏུ་མཐུན་པའི་གསོ་སྦྱོང་མང་བོ་བྱ་དགོས་པ་འབྱུང་ཚེ་གནས་ལ་བློ་མཐུན་གཅིག་གིས་ཆོག་གམ་གསོ་སྦྱོང་རེ་ལ་བློ་མཐུན་གྱི་ལས་རེ་བྱ་དགོས་པ་གང་ཡིན་པ་ལགས།",
    "སྔོན་མེད་འཕྲིན་ལས་བཟང་པོའི་མངའ་ཐང་གིས།",
    "བུ་ཉའི་ལུགས་ལ་སྲོལ་འབྱེད་ལ་དེ་ལྟར་གང་ཟག་དགོས་པ་འོག་གི་བཅུ་བའི་སྲིབ་ཏུ་གསལ་ལོ།",
    "གང་ཟག་གི་བདག་ཕྲ་རགས་ཅི་རིགས་ཀྱི་སྟོང་བ་མེད་པར་སྐུར་བ་འདེབས་པའི་རྟོག་པའི་རྟོག་པ་༢།",
    "གཉིས་ཐལ་འགྱུར་བའི་གཞུང་ཡིན།",
    "མཐའ་མི་འཆོལ་བ་ལ་སྣེ་ཐིག་གི་རྒྱ།",
    "གླེགས་བམ་མི་འཁྲུགས་པ་ལ་གདོང་ཡིག་གི་རྒྱུ་དེའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་ལུགས་ལ་དེའི་སྔོན་དུ་གསུངས་ཡིན་ནོ།",
    "འགྲེལ་བ་དོན་གསལ་ལ་བམ་པོ་ལྔ་ཡོད་བམ་པོ་རེ་ལ་ཤོ་ལོ་ཀ་སུམ་བརྒྱ་རེ་བྱས་པ་ཡིན།",
    "རྩ་བའི་དབུ་བྱམས་པས་མ་མཛད་ན་དེའི་དབུར་རྒྱ་གར་སྐད་དུ་མེད་པར་ཐལ།",
    "དགོས་སོགས་བཞིའི་འབྲེལ་བ་ལ་བཞིའི་ནང་གི་གནས་སྐབས་ཀྱི་དགོས་པ་དང་མཐར་ཐུག་གི་དགོས་པ་གཉིས་འཇོག་ཀྱང་འབྲེལ་བ་ཤུགས་ལ་བསྟན་གསུངས་པ་འབྲེལ་བ་རང་ལྡོག་དང་བཞིའི་ནང་གི་འབྲེལ་བ་རྒྱུ་འབྲས་ལ་བྱེད་དོ་གསུངས།",
    "བརྗོད་བྱ་བརྗོད་བྱེད་ཀྱི་གྲངས་སེམས་པའི་ཐོས་བྱུང་གི་རྗེས་སུ་དཔྱོད་པའི་སེམས་དེ་ལ་བརྗོད་བྱ་བརྗོད་བྱེད་ལ་སྦྱར་བའི་སེམས་བཞི་རེ་ཡོད།",
    "དེ་ལྟར་བསམ་པས་བསམ་བྱུང་གི་རྣམ་པར་དཔྱོད་པའི་སེམས་ཀྱི་ཡུལ་གྱི་མཚན་མ་ཡང་ཡང་ངེས་པར་འཛིན་པའི་བསམ་བྱུང་གི་སེམས།",
    "བསྭཱ་ཟིན་ལྟར་རང་རེས་ཡུམ་གསུམ་གནོད་འཇོམས་འདི་དབྱིག་གཉེན་གྱི་མིན་ཏེ།",
    "ས་ལའི་ཕོ་ཉ་ཞེས་པ་དབྱངས་ཅན་མ་གསང་སྒྲུབ་དམར་མོས་རྗེས་སུ་བཟུང་བའི་ཞེས་ཨ་རྒྱས་གསུངས་སོ།",
    "དེར་གྱུར་བའི་འདོད་ལྷ་དང་ངན་སོང་བ་སོགས་དཔྱད་ན་ལམ་སྒྲོན་དངོས་བསྟན་གཙོ་བོ་ལ་དགོངས་སོ།",
    "གིས་དགྲ་བཅོམ་བསྡུས་གསུངས་སོ།",
    "ཀློང་དག་པ་ཡི་འོག་ཏུ་མ་སོང་བ།",
    "ཆུ་གནས་སྲོག་ཆགས་ཕྲ་མོའི་ཉེར་སྤྱད་འགྱུར།",
    "རྒྱ་མཚོར་སོང་བར་གྱུར་ན་ཐམས་ཅད་ཀྱང་།",
    "དེ་ལྟར་ན་རགས་པའི་མི་རྟག་པ་རྟོགས་པའི་ཕྱི་རོལ་བ་དང་ཅོ་ནང་གིས་དེ་ཁས་མི་ལེན་པར་འགྱུར་བས་དཔྱད།",
    "ཕར་ཟིན་དུ་རིགས་ངེས་གསུམ་རེ་རེ་དང་རྒྱུད་གཅིག་པའི་ལམ་དུ་མ་ཞུགས་པའི་སྐྱེས་བུ་ཕུང་གསུམ་པ་ཡོད་པ་ལྟ་བུར་གསུངས་པ་ལྟར་རོ།",
    "ཆུང་འབྲིང་ཐུན་མོང་གི་ལམ་གྱི་མཚན་ཉིད་དེ་སྐྱེས་བུ་གསུམ་གའི་ཐུན་མོང་གི་ལམ་གྱི་མཚན་ཉིད་ཀྱང་ཡིན་ནོ་གསུངས།",
    "ཆེ་འབྲིང་ཐུན་མོང་གི་ལམ་དེ་ལ་རྣམ་མཁྱེན་ཡོད་ཀྱང་རྣམ་མཁྱེན་ཡིན་ན་ཆེ་འབྲིང་ཐུན་མོང་གི་ལམ་མ་ཡིན་པས་ཁྱབ་པོ་༣༢།",
    "འབྲིང་གི་རྒྱུད་ཀྱི་མི་རྟག་སོགས་བཅུ་དྲུག་རྟོགས་པའི་བློ་དང་ཉན་ཐོས་ལམ་རྣམས་ལྟ་བུའོ།",
    "དེ་གསུམ་ལ་འཆི་བ་མི་རྟག་པ་དང་ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་དང་།",
    "ཆུང་འབྲིང་ཐུན་མོང་གི་ལམ་ཡིན་ན་སྐྱེས་བུ་གསུམ་ཀའི་ཐུན་མོང་གི་ལམ་ཡིན་པས་ཁྱབ།",
    "ཆེ་འབྲིང་ཐུན་མོང་གི་ལམ་གྱི་མཚན་ཉིད་ལ་ཙམ་སྒྲ་སྦྱར་བ་མི་འཐད་དོ།",
    "དེས་ཆེ་འབྲིང་ཐུན་མོང་བ་ལའང་འདྲའོ།",
    "ཆེ་འབྲིང་ཐུན་མོང་བའི་ལམ་གྱི་མཚན་ཉིད་དུ་རང་ཉིད་ལ་ཐོག་མར་ཞུགས་དགོས་པའི་བསམ་པ་དེ།",
    "ཞེས་སྦྱར་༢༨ དགོས་ཏེ་གཞན་དུ་ན་བསྡུས་དོན་ལས་སྦྱོར་སྒོམ་སྔོན་སོང་མིན་ཕྱིར་ཡོན་ཏན་མིན་ཞེས་པ་དང་འགལ་ལོ།",
    "འགྲེལ་བ་གང་ཡིན་གྱི་སྔོན་འཇུག་གི་གཞུང་རྣམས་ལ་ཡང་ཤེས་དགོས་སོ།",
    "དགོས་དོན་གཅིག་དུ་བྲལ་ནི་དེ་ཐོབ་ནས་རེ་ཞིག་སོགས་དང་།",
    "དེ་ཐུན་མོང་བའི་ལུགས་ལ་མཛད་པ་བཅུ་གཉིས་རིམ་ཅན་དུ་བསྟན་པའི་ཕྱིར།",
    "རྒྱལ་བུ་གཞོན་ནུ་དོན་གྲུབ་དེ་རྒྱ་ཆེར་རོལ་བ་ལས་སོ་སོའི་སྐྱེ་བོ་ཡིན་ཡང་ང་མི་འཆི་ཞེས་པའི་དངོས་བསྟན་གྱི་སོ་སྐྱེས་མ་ཡིན་པར་ཐལ།",
