    "དོན་ཡོད་གྲུབ་པ་རྣམ་པར་རྒྱལ།",
    "བྱང་ཕྱོགས་སུ་ནི་ཡང་དག་བཞུགས།",
    "ཅེས་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བ་ནས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ལ་གནས་སོ་ཞེས་བྱ་བའི་བར་དུ་གང་གསུངས་པ་དེ་སྟོན་པར་བཞེད་པས།",
    "འདིས་ནི་སེམས་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་སྟོན་པའི་དཀྱིལ་འཁོར་དུ་འཇུག་པ་ལ་སོགས་པ་ལ་ངེས་པ་ནི་ཡེ་ཤེས་སོ།",
    "ཐོགས་པ་མེད་པར་སྟོན་པ་ཡིན་པར་ཤེས་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་རང་ཉིད་ཀྱི་རྒྱུད་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་རྣམ་པར་སྣང་མཛད་དང་།",
    "ཐ་མི་དད་པར་བདག་ཉིད་ཀྱིས་མཛད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀ་ན་སེམས་དཔའི་རྡོ་རྗེའི་ཚུལ་གྱིས་བཞུགས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལས་བྱུང་བ་ནི་སེམས་དཔའ་རྡོ་རྗེ་སྟེ་ཐུགས་ལས་བྱུང་ནས་སེམས་དཔའི་རྡོ་རྗེའི་རྣམ་པར་གྱུར་པའོ།",
    "དེའི་བྱིན་གྱི་རླབས་ཚོནི་བརྟན་པར་བྱ་བའི་ཕྱིར་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་སོགས་པ་སྤྲུལ་པའི་དོན་དུ་བརྟན་པར་བྱ་བའི་ཕྱིར་རྡོ་རྗེ་ལྟར་མི་ཕྱེད་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་སྙོམས་པར་ཞུགས་ནས་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་སོགས་པའི་གཟུགས་ཀྱི་རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པར་འཕྲུལ་པ་ལྟ་བུ་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་དེ་ཅི་ཞིག་མཛད་ཅེ་ན།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཕྱོགས་ཕྱོགས་སུ་འཁོད་དོ་ཞེས་བྱ་བ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཕྱོགས་དང་མཚམས་རྣམས་ན་ལྷའི་གནས་རྣམས་ཡོད་པ་ལ་གནས་པའོ།",
    "དེ་རྣམས་ཀྱང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་ཞུགས་ཏེ།",
    "ཞེས་ལུང་ལས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བྱེན་གྱི་རླབས་༡ཀྱིས་ཀྱང་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་དུ་ཀུན་ནས་མཉམ་པར་འཇུག་པར་འགྲོ་བའི་རྡོ་རྗེའི་གཟུགས་ཀྱིས་ཁྱབ་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "གང་ལ་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་དང་མཉམ་པར་འཇུག་པའི་ཚད་ཡོད་པ་དེ་ནི།",
    "ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཀྱི་ཚད་དང་མཉམ་པར་འཇུག་པའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀ་ནས་ཕྱུང་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་གཉིས་སུ་གནས་སོ།",
    "གཟུགས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་སྣང་བས་ཁྱབ་པར་བྱེད་པའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ལ་གནས་ནས་ཆེད་དུ་བརྗོད་པ་འདིས་ཆེད་དུ་བརྗོད་དོ་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་གྱི་སེམས་མཁྱེན་པ་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོ་མངོན་སུམ་དུ་བྱས་པའོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་མཉེས་པར་མཛད་པ་དང་ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱང་ཡིན་ལ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ནི་དཔལ་རྡོ་རྗེ་སེམས་དཔས་ངེས་པར་སྦྱར་བའོ།",
    "ཆོ་འཕྲུལ་ནི་མཐུ་ཡང་དག་པར་སྟོན་པ་སྟེ།",
    "དེ་གྲུབ་པར་བྱེད་པ་ལ་ཐུགས་རྩེ་གཅིག་པའོ།",
    "དངོས་པོར་འཛིན་པས་བསྐྱོད་པར་མི་ནུས་པ་ནི་༡ཤིན་ཏུ་བརྟན་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལས་གཞན་པ་དགའ་བ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུ་མའི་ཚུལ་གྱིས་བཞུད་པ་དང་བྱོན་པར་སྟོན་པ་ནི་ཐུགས་ལ་ཞུགས་པ་ཡིན་ནོ།",
    "དེ་ནི་བརྟན་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔོན་གྱི་འཕེན་པའི་ཤུགས་ཀྱི་མཐུས་གདུལ་བྱས་བདག་གཟུགས་ཀྱི་སྒུར་མཐོང་བ་ཡིན་ནོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀ་ནས་སོ།",
    "བཀའ་ནོད་ཅིང་བཞུགས་པར་༡གྱུར་ཏོ་ཞེས་བྱ་བ་ནི།",
    "གང་ཡང་༢ཞལ་དུ་མ་མངའ་བ་དེར་ནི་ཁྱད་པར་ཉིད་དུ་གསུང་བར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་ན་གནས་པའི་རྡོ་རྗེ་རྩེ་ལྔ་པའི་རྣམ་པ་དེ་ཉིད།་",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་དམ་ཚིག་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་པ་སྤྱིན་པའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་རྣམ་པར་སེམས་རྩེ་གཅིག་པ་ཉིད་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཏིང་ངེ་འཛིན་ཏོ།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བའོ།",
    "བཅོས་མའི་ཁྲོ་བོ་ཡང་དག་པར་སྟོན་པ་ནི་ཐབས་ཆེན་པོ་སྟེ།",
    "ཐབས་ཆེན་པོའི་ཡེ་ཤེས་ཀྱི་དམ་ཚིག་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་གདུག་པ་ཐམས་ཅད་ཚར་གཅོད་པར་སྤྱོར་བས་སྟོབས་སོ།",
    "རྣམ་པར་གྲོལ་བ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་འཁོར་ལོ་ནི་རྡོ་རྗེ་དབྱིངས་ཀྱི་དུམ་བུར་གསུངས་པའི་དཀྱིལ་འཁོར་རྣམས་ཏེ།",
    "འཁོར་ལོ་ནི་དཀྱིལ་འཁོར་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
