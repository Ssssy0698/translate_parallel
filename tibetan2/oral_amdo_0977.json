    "ཡང་གདན་རབས་འགའ་སོང་བ་ནས།",
    "རྗེ་བཙུན་མསྐྲོལ་ནས་དངོས་སུ་ཞལ་གཟིགས་ཤིང་།",
    "དུང་ན་གང་གིས་རྒྱས་འདེབས་པ་ཡིན།",
    "སྐབས་སུ་བབ་པ་སྒོམ་རུང་གི་གང་དྲན་སྒོམ་མི་རུང་།",
    "ཞེས་མོས།",
    "གཤེད་ཆེན་མོན་པ་བདུད་རྣམ་བཞི་བཞིར་བཅས།",
    "༤བསྡུར་འབྲས་རེའུ་མིག་༤༡༢༤༤ རང་བཞིན་གྱི་དོ་ཧ་མཛོད་ཀྱི་གླུའི་ལྟ་བ་ཞེས་བྱ་བ།",
    "བསྡུར་འབྲས་རེའུ་མིག་༦བསྡུར་མཆན།",
    "༨ བསྡུར་འབྲས་རེའུ་མིག་༨༡༢༤༦ ལས་ཀྱི་གཏུམ་མོའི་དོ་ཧ་མཛོད་ཀྱི་གླུ་ཞེས་བྱ་བ།",
    "༡བསྡུར་འབྲས་རེའུ་མིག་༡༡༢༤༧ ལྟ་སྒོམ་སྤྱོད་པ་འབྲས་བུའི་དོ་ཧའི་གླུ་ཞེས་བྱ་བ།",
    "༡༤བསྡུར་འབྲས་རེའུ་མིག་༡༤༡༢༤༨ དོ་ཧ་མཛོད་ཀྱི་དེ་ཉིད་ཀྱི་གླུ་ཞེས་བྱ་བ།",
    "༡༥སློབ་དཔོན་ཀ་ན་རི་ནས་བརྒྱུད་པ་ཐ་ཀ་ནས་མཛདབསྡུར་མཆན་༡༦བསྡུར་འབྲས་རེའུ་མིག་༡༦༡༢༤༩ སྤྱོད་པའི་དོ་ཧ་མཛོད་ཀྱི་གླུ་ཞེས་བྱ་བ།",
    "༡༨ བསྡུར་འབྲས་རེའུ་མིག་༡༨༡༢༥ ལྷན་ཅིག་སྐྱེས་དགའི་དོ་ཧ་མཛོད་ཀྱི་གླུའི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢བསྡུར་འབྲས་རེའུ་མིག་༢༡༢༥༡ བདེ་གཤེགས་ཀྱི་ལྟ་བའི་གླུ་ཞེས་བྱ་བ།",
    "༢༥ བསྡུར་འབྲས་རེའུ་མིག་༢༥དཔྱིད་ཀྱི་ཐིག་ལེ་དོ་ཧ་མཛོད་ཀྱི་གླུ་ཞེས་བྱ་བ།",
    "༢༧བསྡུར་འབྲས་རེའུ་མིག་༢༧༡༢༥༤ རྡོ་རྗེ་བཞིའི་གླུ་ཞེས་བྱ་བ།",
    "བསྡུར་འབྲས་རེའུ་མིག་༢༩བསྡུར་མཆན།",
    "༣༡བསྡུར་འབྲས་རེའུ་མིག་༣༡༡༢༥༦ ས་ར་ཧ་པའི་གླུ།",
    "༣༢བསྡུར་འབྲས་རེའུ་མིག་༣༣བསྡུར་མཆན།",
    "༣༧བསྡུར་འབྲས་རེའུ་མིག་༣༧༣༨ཀ་ན་པའི་གླུ།",
    "༣༩བསྡུར་འབྲས་རེའུ་མིག་༣༩༤༡༢༦ རྡོ་རྗེའི་གླུ་ཞེས་བྱ་བ།",
    "བསྡུར་འབྲས་རེའུ་མིག་༤༥བསྡུར་མཆན་༤༥༡༢༦༣ གཎྜ་རིའི་གླུ།",
    "༤༧བསྡུར་འབྲས་རེའུ་མིག་༤༧༡༢༦༤ མ་ཏི་ཙི་ཏྲིའི་གླུ།",
    "༤༩བསྡུར་འབྲས་རེའུ་མིག་༤༩༡༢༦༥ གླུ།",
    "དེབ་ཉེར་བདུན་པའི་དཀར་ཆག་བསྡུར་འབྲས་རེའུ་མིག་༥༡བསྡུར་མཆན།",
    "བསྡུར་འབྲས་རེའུ་མིག་༥༣བསྡུར་མཆན།",
    "༥༥བསྡུར་འབྲས་རེའུ་མིག་༥༥༥༦༡༢༦༨ ནཱ་རོ་པཎྜི་ཏའི་གླུ།",
    "༥༧བསྡུར་འབྲས་རེའུ་མིག་༥༧༥༨༡༢༦༩ ལཱུ་ཡི་པའི་གླུ།",
    "༥༩བསྡུར་འབྲས་རེའུ་མིག་༥༩༡༢༧ ཌོམྦིའི་གླུ།",
    "༦༡བསྡུར་འབྲས་རེའུ་མིག་༦༡༦༢༡༢༧༡ བི་རཱུ་པའི་གླུ།",
    "༦༣བསྡུར་འབྲས་རེའུ་མིག་༦༣༡༢༧༢ ལྭ་བ་པའི་གླུ།",
    "༦༧བསྡུར་འབྲས་རེའུ་མིག་༦༧༦༨༡༢༧༤ རྣལ་འབྱོར་པྲ་ས་རའི་གླུབསྡུར་མཆན།",
    "༦༩ བསྡུར་འབྲས་རེའུ་མིག་༦༩༧༡༢༧༥ ཀླུ་སྒྲུབ་ཀྱི་གླུ།",
    "༧༣བསྡུར་འབྲས་རེའུ་མིག་༧༣༧༤༡༢༧༧ ཐིག་ལེ་བཅུ་དྲུག་གི་ཉམས་ལེན་ཞེས་བྱ་བ།",
    "༨༡སློབ་དཔོན་ཙོ་ར་གྷིས་མཛདབསྡུར་འབྲས་རེའུ་མིག་༨༤བསྡུར་མཆན།",
    "༨༦བསྡུར་འབྲས་རེའུ་མིག་༨༦༡༢༨༢ རྣལ་འབྱོར་བཞིའི་ཉམས་ལེན་གྱི་ཐབས་ཞེས་བྱ་བ།",
    "༨༩བསྡུཪ་འབྲས་རེའུ་མིག་༨༩ཐབས་དང་ཤེས་རབ་གཏན་ལ་ཕབ་པའི་བསྡུས་པ་ཞེས་བྱ་བ།",
    "༩༣བསྡུར་འབྲས་རེའུ་མིག་༩༣༡༢༨༤ རང་བཞིན་གྲུབ་པ་མེད་པའི་གཞིའི་མན་ངག་ཅེས་བྱ་བ།",
    "༡༡༣སློབ་དཔོན་ཏེ་ལོ་པས་མཛདབསྡུར་འབྲས་རེའུ་མིག་༡༡༥བསྡུར་མཆན།",
    "༡༡༧བསྡུཪ་འབྲས་རེའུ་མིག་༡༡༧སེམས་ལ་གྲོས་འདེབས་པ་ཞེས་བྱ་བ།",
    "༡༡༨༡༢༨༩སློབ་དཔོན་ཨ་ཛོ་ཀིས་མཛདབསྡུར་འབྲས་རེའུ་མིག་༡༢བསྡུར་མཆན།",
    "༡༢༥བསྡུར་འབྲས་རེའུ་མིག་༡༢༥༡༢༩༢ ཡི་གེ་གཉིས་པའི་མན་ངག་ཅེས་བྱ་བ།",
    "༡༣བསྡུར་འབྲས་རེའུ་མིག་༡༣༡༢༩༤ འཛག་པ་གཅོད་པའི་མན་ངག་ཅེས་བྱ་བ།",
    "༡༣༣བསྡུར་འབྲས་རེའུ་མིག་༡༣༣༡༢༩༥ མུ་སྟེགས་ཀྱི་གཏུམ་མོ་ཞེས་བྱ་བ།",
    "༡༣༥བསྡུར་འབྲས་རེའུ་མིག་༡༣༥༡༢༩༦ གསེར་འགྱུར་གྱི་རྩི་ཞེས་བྱ་བ།",
    "༡༤༡བསྡུར་འབྲས་རེའུ་མིག་༡༤༡ལྷ་ཀུན་གྱི་རྫོགས་པའི་ལམ་ཞེས་བྱ་བ།",
    "༡༤༤བསྡུར་འབྲས་རེའུ་མིག་༡༤༤༡༢༩༩ ཉི་ཟླ་བཅིང་བའི་ཐབས་ཞེས་བྱ་བ།",
    "༡༥༤ བསྡུར་འབྲས་རེའུ་མིག་༡༥༤༡༣༣ རང་བཞིན་གྲུབ་པ་ཞེས་བྱ་བ།",
    "༡༥༧བསྡུཪ་འབྲས་རེའུ་མིག་༡༥༧༡༣༤ ལྷན་ཅིག་སྐྱེས་པའི་གདམས་པ་ཞེས་བྱ་བ།",
    "༡༦༤བསྡུར་འབྲས་རེའུ་མིག་༡༦༤༡༣༦ ཨ་ཕྲེང་ཀ་ཕྲེང་གི་སྔགས་ཀྱི་རིམ་པ་ཞེས་བྱ་བ།",
    "༡༧༨བསྡུར་འབྲས་རེའུ་མིག་༡༧༨སེམས་ཉིད་ཀྱི་དེ་ཉིད་བཅིང་བ་ཞེས་བྱ་བ།",
    "༡༨བསྡུར་འབྲས་རེའུ་མིག་༡༨༡༣༡༡ གཏུམ་མོའི་ཐིག་ལེ་བཀྲམ་པ་ཞེས་བྱ་བ།",
    "༡༨༤སློབ་དཔོན་ནི་ཀུ་ནིས་མཛདབསྡུར་འབྲས་རེའུ་མིག་༡༨༥བསྡུར་མཆན།",
    "༡༨༧བསྡུར་འབྲས་རེའུ་མིག་༡༨༧༡༣༡༤ རང་རིག་ཡེ་ཤེས་ཀྱི་ལྟ་བའི་ཉམས་ལེན་ཞེས་བྱ་བ།",
    "བསྡུར་འབྲས་རེའུ་མིག་༡༨༩བསྡུར་མཆན།",
    "༡༩༢བསྡུར་འབྲས་རེའུ་མིག་༡༩༣༡༣༡༦ ཕྱི་ནང་གི་དུག་སེལ་གྱི་རིམ་པ་ཞེས་བྱ་བ།",
    "༡༩༦བསྡུར་འབྲས་རེའུ་མིག་༡༩༦༡༣༡༧ གཡུང་དྲུང་འཁྱིལ་པ་གསུམ་གྱི་ཞལ་གདམས་ཀྱི་ཉམས་ལེན་༡༩༧ཞེས་བྱ་བ།",
    "༡༩༩བསྡུར་འབྲས་རེའུ་མིག་༡༩༩དེབ་ཉེར་བདུན་པའི་དཀར་ཆག་༡༢༡༣༡༨ ལྷན་ཅིག་སྐྱེས་པའི་རང་བཞིན་ཞེས་བྱ་བ།",
    "༢༨བསྡུར་འབྲས་རེའུ་མིག་༢༨༡༣༢༢ ཚེ་སྒྲུབ་པའི་གདམས་ངག་ཅེས་བྱ་བ།",
    "བསྡུར་འབྲས་རེའུ་མིག་༢༡༩བསྡུར་མཆན།",
    "༢༢༡བསྡུར་འབྲས་རེའུ་མིག་༢༢༡༡༣༢༦ ཕྱི་ནང་བདུད་རྩིའི་བཅུད་ལེན་ཞེས་བྱ་བ།",
    "༢༢༥བསྡུར་འབྲས་རེའུ་མིག་༢༢༥༡༣༢༧ དོ་ཧ་སྤྱོད་པའི་གླུའི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༢༧བསྡུར་འབྲས་རེའུ་མིག་༢༢༧༡༣༢༨ སྟོང་པ་ཉིད་ཀྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༢༩བསྡུར་འབྲས་རེའུ་མིག་༢༢༩༡༣༢༩ བདེ་སྡུག་གཉིས་བྲལ་གྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༣༢བསྡུར་འབྲས་རེའུ་མིག་༢༣༢༡༣༣ འབྲེལ་མེད་ཀྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༤༦བསྡུཪ་འབྲས་རེའུ་མིག་༢༤༧༡༣༣༡ ཞེན་མེད་ཀྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༥༡བསྡུར་འབྲས་རེའུ་མིག་༢༥༡༡༣༣༣ སེམས་ཉིད་རིན་ཆེན་གྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༥༤བསྡུར་འབྲས་རེའུ་མིག་༢༥༤༡༣༣༤ དེ་ཉིད་བརྒྱད་ཀྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༥༦བསྡུར་འབྲས་རེའུ་མིག་༢༥༦༡༣༣༥ སེམས་ཉིད་ཀྱི་རྟོག་པ་འཇོམས་པའི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༦༢བསྡུར་འབྲས་རེའུ་མིག་༢༦༢༡༣༣༧ སེམས་ཙམ་གྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༦༧བསྡུར་འབྲས་རེའུ་མིག་༢༦༧༡༣༣༩ འབྲེལ་མེད་ཀྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༦༩བསྡུར་འབྲས་རེའུ་མིག་༢༦༩༡༣༤ དེ་བཞིན་ཉིད་ཀྱི་ལྟ་བ་ཞེས་བྱ་བ།",
    "༢༧༡བསྡུཪ་འབྲས་རེའུ་མིག་༢༧༡༡༣༤༡ ཕྱག་རྒྱ་ཆེན་པོ་བརྡའི་བརྒྱུད་པ།",
    "༢༧༢དཔལ་འབྲས་ཕུང་རང་བྱུང་གི་རྩར་འཇམ་དཔལ་གྱིས་གསུངས་པ།",
    "༢༧༣རི་བོ་བྱ་རྐང་དུ་སྤྱན་རས་གཟིགས་ཀྱིས་གསུངས་པ།",
    "༢༧༩ཨུ་རྒྱན་ཚནྡོ་ལའི་གླིང་དུ་དཔལ་རང་བྱུང་གི་རྒྱལ་མོས་གསུངས་པ།",
    "༢༨༡ལྷོ་ཕྱོགས་ཀཱ་མ་རཱུ་རུ་ལྷ་མོ་མཱ་རི་ཙྩེས་གསུངས་པ།",
    "བསྡུར་མཆན་༣༦བསྡུར་འབྲས་རེའུ་མིག་༣༨༡༣༤༣ དཔལ་རྡོ་རྗེ་མཁའ་འགྲོ་མའི་མགུར་ཞེས་བྱ་བ།",
    "༣༡༦བསྡུར་འབྲས་རེའུ་མིག་༩༣༡༧༡༣༤༤ རྡོ་རྗེ་མཁའ་འགྲོ་མའི་བརྡའི་མགུར་ཞེས་བྱ་བ།",
    "༣༢༤བསྡུཪ་འབྲས་རེའུ་མིག་༣༢༥༡༣༤༥ ཐུགས་ཀྱི་གསང་བ་གླུར་བླངས་པ་ཞེས་བྱ་བ།",
    "༣༢༦མཁའ་འགྲོ་མས་ཡི་གེར་བཏབ་སྟེ་གསང་མཛོད་ན་གནས་པ་ལསདབྱིངས་ཀྱི་གཙོ་མོ་རྣམས་ཀྱིས་བཀའ་བགྲོས་ནས་རྗེ་དམ་པ་རྒྱ་གར་ལ་གནང་ཞ་མ་ལོ་ཙཱ་བས་ལེགས་པར་བསྒྱུརབསྡུར་མཆན།",
    "ཡེ་ཤེས་རྣམ་པར་གཟིགས་པའི་དུམ་བུ་མཁའ་འགྲོ་མ་སུ་ཁ་ཕ་ལས་བསྡུས་པ།",
    "༣༦༤བསྡུར་འབྲས་རེའུ་མིག་༣༦༦༡༣༤༨ མཁའ་འགྲོ་མ་རྡོ་རྗེ་གསང་བའི་གླུ་ཞེས་བྱ་བ།",
    "༣༧༡མཁའ་འགྲོ་མའི་གསང་མཛོད་ན་གནས་པ་ལས་དབྱིངས་ཀྱི་གཙོ་མོ་རྣམས་ཀྱིས་བཀའ་བགྲོས་ནས།",
    "༣༧༨བསྡུར་འབྲས་རེའུ་མིག་༣༧༨༡༣༥ སེམས་ཀྱི་གསང་བ་ཟབ་དོན་བརྡའི་གླུར་བླངས་པ་ཞེས་བྱ་བ།",
    "༥༩བསྡུར་འབྲས་རེའུ་མིག་༥༩༡༡༣༥༢ ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་སུམ་ཅུ་རྩ་ལྔའི་རྟོགས་པ་བརྗོད་པ་༣༩༢མཁའ་འགྲོ་མའི་གསང་མཛོད་ན་གནས་པ་ལས།",
    "དབྱིངས་ཀྱི་གཙོ་མོ་རྣམས་ཀྱིས་བཀའ་བགྲོས་ནས་རྗེ་དམ་པ་རྒྱ་གར་ལ་གནང་བ་ཞ་མ་འོལོ་ཙཱ་བས་བསྒྱུརབསྡུར་མཆན།",
    "༣༩༨བསྡུར་འབྲས་རེའུ་མིག་༣༩༩༡༣༥༣ མཁའ་འགྲོ་མའི་འབྱམ་གླུ་ཞེས་བྱ་བ།",
    "གཉུག་མ་རང་གི་ངོ་བོ་གཟིགས་པ་ཞེས་བྱ་བའི་ལེའུ།",
    "༤༧༨བསྡུར་འབྲས་རེའུ་མིག་༤༨༢༡༣༥༦ ཕྱག་རྒྱ་ཆེན་པོ་གསེར་ཕྲེང་ཞེས་བྱ་བ།",
    "༥༥ བསྡུར་འབྲས་རེའུ་མིག་༥༧༡༣༥༧ ཤེས་རབ་ཀྱི་ཕྲིན་ཡིག་ཅེས་བྱ་བ།",
    "༥༡༨བསྡུར་འབྲས་རེའུ་མིག་༥༡༩༡༣༥༨ རྣལ་འབྱོར་པའི་རྟོག་པའི་གེགས་སེལ་བ་ཞེས་བྱ་བ།",
    "༥༢༣བསྡུར་འབྲས་རེའུ་མིག་༥༢༣༡༣༥༩ དུག་ལྔ་སྦས་པའི་ལམ་མཆོག་ཏུ་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞེས་བྱ་བ།",
    "༥༣༢བསྡུར་འབྲས་རེའུ་མིག་༥༣༣༡༣༦ རྣལ་འབྱོར་གྱི་མཚན་ཉིད་བདེན་པ།",
    "༥༣༨བསྡུར་འབྲས་རེའུ་མིག་༥༣༨༡༣༦༡ ཤེས་རབ་བརྩམ་པ་དུས་ཀྱི་གཏམ་ཞེས་བྱ་བ།",
    "༥༤༡བསྡུར་འབྲས་རེའུ་མིག་༥༤༡༡༣༦༢ ཏིང་ངེ་འཛིན་ཚོགས་ཀྱི་ལེའུ་༥༤༢སློབ་དཔོན་མཁས་པ་ཆེན་པོ་དཔལ་མར་མེ་མཛད་ཡེ་ཤེས་ཀྱི་ཞལ་སྔ་ནས་མཛད།",
    "བསྡུར་འབྲས་རེའུ་མིག་༥༤༤བསྡུར་མཆན།",
    "༥༥༥བསྡུར་འབྲས་རེའུ་མིག་༥༥༥༡༣༦༥ དཔལ་འཆིང་བ་རྣམ་གྲོལ་གྱི་བསྟན་བཅོས།",
    "༥༦༢བསྡུར་འབྲས་རེའུ་མིག་༥༦༢༡༣༦༦ ལྟ་སྤྱོད་རྣམ་དག་གི་མན་ངག་ཅེས་བྱ་བ།",
    "༥༦༥ཁ་ཆེའི་རིགས་ལས་བལ་ཡུལ་དུ་སྐུ་འཁྲུངས་པའི་པཎྜི་ཏ་ཆེན་པོ་དཔལ་ལྔ་རིག་པའི་མཆོག་བུདྡྷ་ཤྲཱི་ཛྙཱ་ནའི་ཞལ་སྔ་ནས་གསུངསམཁས་པ་ཆེན་པོ་དེ་ཉིད་ཀྱི་སྤྱན་སྔར་ལོ་ཙཱ་བ་བྱམས་པའི་དཔལ་གྱིས་བསྒྱུརབསྡུར་མཆན།",
    "༥༦༦བསྡུར་འབྲས་རེའུ་མིག་༥༦༦༡༣༦༨ འཆིང་བ་རྣམ་གྲོལ་གྱི་མན་ངག་ཅེས་བྱ་བ།",
    "༥༦༨བསྡུར་འབྲས་རེའུ་མིག་༥༦༨༡༣༦༩ གྲུབ་པ་དམ་པའི་ལམ་ངེས་པ།",
    "༥༧༤བསྡུར་འབྲས་རེའུ་མིག་༥༧༤༡༣༧༡ དཔལ་རྣལ་འབྱོར་བདུན་གྱི་ལམ་རྣམ་པར་ངེས་པ།",
    "༦༡༩བསྡུར་འབྲས་རེའུ་མིག་༦༡༩༡༣༧༧ བཞི་པའི་དོན་རྣམ་པར་ངེས་པའི་མན་ངག་ཅེས་བྱ་བ།",
    "༦༨༩བསྡུར་འབྲས་རེའུ་མིག་༦༨༩༡༣༨༣ ཡན་ལག་གི་ཉེས་པ་བདུན་པ།",
    "༦༩༦བསྡུར་འབྲས་རེའུ་མིག་༦༩༦༡༣༨༦ ཡན་ལག་གི་དམ་ཚིག་ཅེས་བྱ་བ།",
    "དམ་ཚིག་དང་མི་ལྡན་པའི་རིག་མ་བསྟེན་པའི་ཡན་ལག་གི་ཉེས་པ།",
    "ཚོགས་ཀྱི་འཁོར་ལོར་རྩོད་པའི་ཡན་ལག་གི་ཉེས་པ།",
    "ཉན་ཐོས་ནང་དུ་ཞག་བདུན་གནས་པའི་ཡན་ལག་གི་ཉེས་པ།",
    "བསྙེན་སོགས་དག་པར་མ་བྱས་པར་དཀྱིལ་འཁོར་ལས་ལ་འཇུག་པའི་ཡན་ལག་གི་ཉེས་པ།",
    "སྡོམ་པ་གཉིས་ཀྱི་བཅས་པ་ལས་དགོས་པ་མེད་པར་འདའ་བའི་ཡན་ལག་གི་ཉེས་པ།",
    "བུད་མེད་ཤེས་རབ་རང་བཞིན་ཅན་ལ་སྨོད་པར་བྱེད་པའི་དམ་ཚིག་ཉམས་པའི་ཚད་བསྟན་པ།",
    "༧༢༥ཡན་ལག་གི་དམ་ཚིག་ཉམས་པའི་ཚད་བསྟན་པ།",
