    "ལར་ཕྱིནང་གི་སྲིན་བུ་སྤངས་པ་ཙམ་ན་ངན་སོང་གསུམ་དུ་མི་འགྲོ་བའི་གདེང་འཐོབ།",
    "འདི་པས་ནང་གི་རྩ་ལ་ལྷར་བྱེད་པས་སོ།",
    "དེ་བཞིན་དུ་ལོ་ཀའི་ཁམས་ཀྱི་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་ཐམས་ཅད་བསྡུས་ལ་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་རྡོ་རྗེ་མར་བྱས་ལ།",
    "རང་གི་སྤྱི་བོར་སྣ་ཚོགས་རྡོ་རྗེ་བསམ་སྟེ་དཔྲལ་བ་དང་ལྟག་པ་གཉིས་རྣ་ལྟག་གཉིས་ཏེ་བཞི་སྣ་ཚོགས་རྡོ་རྗེའི་རྭ་བཞིའོ།",
    "དེའང་འདི་རྣམས་ཐམས་ཅད་དེ་ལྟརབསམ་དངོས་སུ་གསལ་ནའང་ལེགས་མི་གསལ་ནའང་མོས་པ་བྱས་པས་ཆོག་གསུང་།",
    "སེན་མོ་མེ་རི་འབར་བར་བསམ།",
    "དེ་ནས་རྟེན་གཞལ་ཡས་ཁང་གསལ་གདབ་པ་ལ་ལུས་ཀྱི་དཀྱིལ་འཁོར་ཕན་ཚུན་དང་ཡན་མན་དུ་འདོམ་རེ་རེ་མཉམ་སྟེ་མི་མཉམ་པ་མེད་པས་གྲུ་བཞིའོ།",
    "མིག་པཉྩ་རེ་ཁཱ།",
    "ཕྱི་རོལ་གྱི་རྩ་དྲུག་ཅུ་རྩ་བཞི་ལས་འཁོར་གྱི་ལྷ་མོ་ཚུལ་དེ་ལྟ་བུ་དྲུག་ཅུ་རྩ་བཞིས་བསྐོར་བའོ།",
    "རྩ་ནང་གི་བྱང་སེམས་བྱིན་གྱིས་བརླབས་པས་རྣམ་པ་བདེ་བའོ།",
    "འཁོར་གྱི་ལྷ་མོ་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་བསྐོར་བ་ཐམས་ཅད་ཀྱང་རུས་པའི་རྒྱན་ཆ་ལྔ་དང་ལྡན་པ།",
    "འཁོར་གྱི་ལྷ་མོ་ཚུལ་དེ་ལྟ་བུ་བརྒྱད་ཀྱིས་བསྐོར་བ་ཐམས་ཅད་ཀྱང་རུས་པའི་རྒྱན་ཆ་ལྔ་དང་ལྡན་པ།",
    "འཁོར་གྱི་ལྷ་མོ་དེ་ལྟ་བུའི་ཚུལ་བཅུ་དྲུག་གིས་བསྐོར་བ་ཐམས་ཅད་ཀྱང་རུས་པའི་རྒྱན་ལྔ་དང་ལྡན་པ།",
    "ལམ་མོ། ། ལྟ་བ་ངོ་བོ་ཉིད་ལ་གསུམ་སྟེ།",
    "དེ་རེ་རེ་ལའང་གསུམ་གསུམ་སྟེ།",
    "དེ་ལ་དང་པོ་མཉམ་གཞག་གི་གསུམ་ལས་སྣང་ཕྱོགས་ནི་དང་པོ་ལུས་ཆགས་༣། པའི་རྟེན་ལྟེ་བ་ཡིན་པས།",
    "དེ་ལྟར་གནས་པའི་འཕྲོ་ལ་ཅི་ཞིག་ལྟར་ན་ལྷའི་སྤྱན་ལྟ་བུ་ལ་ཤེས་པ་གནས་པ་མེད་པར་སྟོང་ཕྱལ་སོང་ན།",
    "ཟུང་འཇུག་གི་ངོ་བོ་ཉིད་སྤྱན་ལྟ་བུ་དེ་ལ་ཡང་མཛོད་མ་སེམས་མི་གནས་པར་འོད་ཟེར་རམ་རྭའམ་མགོ་བོ་མང་པོའམ་དུ་བ་ལ་སོགས་པ་གཅིག་གི་སྣང་བ་བྱུང་ན།",
    "དེ་གསུམ་ནི་མཉམ་གཞག་གི་ངོ་བོ་ཉིད་གསུམ་ཤུགས་ཀྱིས་སྐྱེ་བ་ཡིན་ནོ།",
    "གཉིས་པ་རྗེས་སྤྱོད་ཀྱི་གསུམ་ནི་དེ་ལ་སྣང་ཕྱོགས་ནི་མཉམ་གཞག་བཏང་ནས་རྗེས་ལྟ་བ་སྐྱོང་བ་ལ་མེ་ཏོག་༣། ལ་སོགས་པའི་དངོས་པོ་གང་རུང་ཞིག་གམ་ཆུ་སྒྲའམ་གང་ཡང་རུང་བ་ལ་སོགས་པའི་སྒྲའམ་དྲིའམ་རོའམ་རེག་བྱ་གང་ཡང་རུང་བ་ཞིག་ལ་གཏད་ནས་ཤེས་པ་གློད་ནས་བཞག་པས།",
    "དེ་ལ་སྣང་བ་བསྣོམ་བྱ་ལྔ་མ་ཤརབར་ཐེབས་དགོས་ཀྱི་ཤར་ནས་གར་སྤྱིན་གྱི་ཕུང་པོ་ལ་རེག་པ་ལྟར་སོང་ནས་དེ་ལས་མི་ཐར་གསུང་།",
    "དཔེར་ན་རྒྱ་ལ་ཡོད་པའི་རི་མོ་དེ་རྒྱ་རང་ལ་ཡོད་པས་རྒྱའི་བྱ་བ་བྱེད་མི་ནུས་པ།",
    "དེ་ལས་འོད་ཀྱི་གོང་བུ་རེ་ཆད་ནས།",
    "རིག་པ་འཛིན་པའི་མཆོག་གི་སིདྡྷི་ཐོབ་པར་འགྱུར་རོ།",
    "དེས་འདོད་ལྷ་རིགས་དྲུག་གི་སྒོ་ཁེགས།",
    "སྟེང་འོག་གི་ཡི་གེ་བཞི་པོ་དེ་བཞི་ཀ་མགོ་སྟེང་འོག་གང་དུ་བལྟ་བར་དམིགས་པ་གང་གསལ་དུ་བསྒོམ་མོ།",
    "ལྟ་བ་རང་བྱུང་གི་ཡེ་ཤེས་བཞི་དེའང་ཏིང་ངེ་འཛིན་རང་གི་ངོ་བོ་སྦྱོར་ལམ་དྲོད་ཀྱི་ཡེ་ཤེས་ཤིན་ཏུ་གསལ་བ།",
    "ཨཱ་ལི་༉ཀཱ་ལི་ལྔ་བཅུ་ལ་བརྟེན་པའི་གཏུམ་མོ་ལྔ་བཅུ།",
    "དེ་ཐམས་ཅད་ཨ་ཐུང་བརྗོད་པའི་ཨར་འདུས་པས་དེ་ལ་བརྟེན་པའི་གཏུམ་མོའང་བདུན་བཅུ་རྩ་ལྔའོ།",
    "བསྲུབ་ཤིང་གི་འཁོར་ལོ།",
    "ལག་པ་གཉིས་པུས་མོ་ལ་འཁྱུད་པས་བསམ་གཏན་གྱི་ཡན་ལག་དགུ་ཚང་བར་བྱས་ལ།",
    "གཏུམ་མོའི་སྦྱོར་བ་དག་ལ་གཅེས།",
    "ཐོག་ནི་ཐོག་དང་འདྲ་མཛོད་མ་བར་གསང་གནས་ནས་ཡར་ལ་ཧཾ་གི་འབེན་ལ་འཕེན་པས་སོ།",
    "བརླའི་ནང་གཉིས་གཞུའི་ཐལ་བ།",
    "པུས་མོ་གཉིས་མཆོག་མ།",
    "བྱང་སེམས་ཧཾ་གི་༢། འབེན་ལ་བརྡེག།",
    "དེའང་མུ་ཏིག་གི་རྡོག་མ་ལྟར་ཏིག་ཏིག་འཛག་པ་དང་།",
    "དེས་འཕྲལ་དུ་ཡེ་ཤེས་འཆར་བར་འགྱུར་ཞེས་པ་བདེ་བའམ་གསལ་བ་ལ་སོགས་པ་རང་བྱུང་གི་ཡེ་ཤེས་བཞི་ལ་སོགས་པའི་ཉམས་སྐྱེའོ།",
    "དེས་མགོ་དང་དཔུང་པ་གཡོན་པ་དང་མགོ་འབྱར་བ་དང་རྐང་པ་གཡོན་པ་རེངས་ནས་འགྲོ་མི་ཤེས་པ་ལ་སོགས་པ་འབྱུང་སྟེ།",
    "ཆུ་ཤིང་གི་སྡོང་པོ་ལྟར་དྲང་བ།",
    "ཁ་ཟས་བཅུད་ཅན་དང་སྤྱོད་ལམ་གྲང་བའི་ལྕག་གིས་བསྐུལ།",
    "བུད་མེད་ཡིན་ན་རྩ་མཛེས་པའི་སྤྱི་བོར་གསུང་།",
    "བཞི་ལ་བརྟེན་ན་ལུས་ཐམས་ཅད་ལ་རང་བྱུང་གི་ཡེ་ཤེས་ཁྱབ་པར་སྐྱེའོ།",
    "གཏུམ་མོའི་སྦྱོར་བ་དག་ལ་གཅེས།",
    "དེས་རང་བྱུང་གི་ཡེ་ཤེས་བཞི་ལ་སོགས་པའི་ཉམས་སྐྱེ་ཞིང་།",
    "དེ་ལྟེ་བའི་ཨཾ་ལ་ཕོག་པས་ཨཾ་ལས་མེ་ཤིན་ཏུ་ཆ་ཕྲ་བ་སྐྲའི་རྩེ་མོ་བརྒྱ་སྟོང་གི་ཆའི་ཚད་ཙམ་འབར་ནས་ཧཱུཾ་ལ་ཕོག་པས་བྱང་སེམས་ཤིན་ཏུ་ཕྲ་བ་འབབ་སྟེ།",
    "མིག་ཅུང་ཟད་ཕྱེ་ལ་ཤེས་པ་འཛིན་མེད་དུ་གཞག་དེའི་དུས་སུ་རང་བྱུང་གི་ཡེ་ཤེས་ལ་སོགས་པའི་ཉམས་སྐྱེའམ་བལྟ།",
    "ལུས་ལ་ན་ཚའམ་སེམས་ལ་ཉོན་མོངས་པ་ལ་སོགས་པ་བྱུང་བ།",
    "དེ་ནས་རྐང་མཐིལ་གཉིས་གཅིག་གི་སྟེང་དུ་གཅིག་བཞག་བྱས་པས་རཾ་ལས་མེ་ཤིན་ཏུ་ཆ་ཕྲ་བ་འབར་ལོང་བུའི་རྩ་ནས་སོག་སྦུབས་ནས་མེ་སྟག་ཞུགས་པ་བཞིན་དུ་བརླའི་རྩ་བོ་ཆེ་ནས་ཞུགས།",
    "མེ་དེའི་རྩེ་མོ་ལ་མེའི་ཐིག་ལེ་སྲན་མ་ཙམ་ཞིག་བསམ་དེའི་སོར་བཞི་ཙམ་གྱི་སྟེང་དུ་རིལ་མ་ཙམ་ཞིག་བསམ་ལ་དེ་གཉིས་འཐབ་པས་མེ་སྟག་གིས་ལུས་ཁོང་སྟོང་དེའི་སྤྱི་གཙུག་མན་ཆད་དུ་འཕྲོ་བར་བསམ། ། དེ་བརྟན་ཞིང་བོགས་དབྱུང་བའི་ཕྱིར་ཙཀྲའི་དམིགས་པ་ནི་མེ་དེ་གསང་གཞུང་ཌྜཱགནས་ནས་ལྟེ་བའི་བར་དུ་ལྕགས་ཐུར་ལྟར་མཁྲང་ཐང་ངེ་བར་བསམ་ལ་དེའི་སྟེང་ན་ཐིག་ལེ་གཉིས་འཐབ་པ་དེའི་སྟེང་ན་ཙཀྲ་རྩིབས་བཞི་པ།",
    "སྔར་བརྒྱད་དང་བཅོ་བརྒྱད་དོ། ། ལམ་དེས་ལྟ་བ་རང་བྱུང་གི་ཡེ་ཤེས་བཞི་སྐྱེ་སྟེ།",
    "ཉོན་མོངས་པ་རང་བྱུང་གི་ས་མ་ཏི།",
    "རྣམ་པར་རྟོག་པ་རང་བྱུང་གི་ས་མ་ཏི།",
    "སྣེལ་ཞི་རང་བྱུང་གི་ས་མ་ཏི་གསལ་ཞིང་ཡང་ལ་རང་བྱུང་གི་ཡེ་ཤེས་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ནོ།",
    "ཉོན་མོངས་པའི་རྣམ་པ་འཇོམས་པ་མཐོང་བ་སྟེ།",
    "ཞེ་སྡང་གི་མེ་གསོད།",
    "གཏི་མུག་གི་མུན་པ་སེལ།",
