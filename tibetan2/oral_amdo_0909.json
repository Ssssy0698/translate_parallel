    "ཡང་དེ་ཙམ་ན་མཐོང་སྤང་གི་ཉོན་མོངས་པ་མ་ལུས་པར་སྤངས།",
    "སྤང་བྱ་ཉོན་མོངས་པ་སྟོབས་ཆུང་།",
    "དེ་དག་གིས་ལམ་གྱིས་བསྡུས་པའི་འབྲས་བུ་བཞི་ཚན་བཞི་བསྟན་ཏེ།",
    "ལས་འཕྲོ་ཅན་རང་གི་ངང་གིས་ཁམས་འདུ་བ་དང་།",
    "དེས་གཏུམ་མོའི་མེ་ཕྱོགས་མེད་དུ་འབར་ཏེ་ལུས་ལ་དྲོད་འོང་།",
    "དེ་བཞིན་དུ་མོས་གུས་བྱས་པ་དང་བརྩོན་འགྲུས་བརྩམས་པ་ལ་ཡང་བདུན་བདུན་ཏེ་ཉི་ཤུ་རྩ་གཅིག་ཏུ་འགྱུར་རོ།",
    "མོས་གུས་དང་ལས་འཕྲོ་སད་པའི་གཉིས་གཉིས་ལྟ་བུའོ།",
    "དེ་ལ་དང་པོ་རེ་རེ་ས་མ་ཏི་རིང་བའི་རྒྱུ།",
    "ལས་འཕྲོ་སད་པའམ་བརྩོན་འགྲུས་སམ་མོས་གུས་ལྟ་བུ།",
    "བར་དུ་ལྔ་ལྔ་ཏིང་ངེ་འཛིན་རང་གི་ངོ་བོ།",
    "ཤེས་པ་བདེ་གསལ་དུ་གནས་པ་སྟེ་དུག་གིས་བརྒྱལ་ལམ་ཆང་གིས་བཟི་བ་ལྟ་བུའོ།",
    "ཕོ་མོ་གཉིས་འབྲིང་ཡིན་ཏེ་ཏིང་ངེ་འཛིན་ཤུགས་འབྲིང་དུ་འོང་བས་སོ།",
    "རེས་འདིའི་གོང་དུ་ཉམས་སུ་བླང་བའི་མན་ངག་བདུན་གསུང་། ཡང་།",
    "རེངས་པའི་སྐྱོན།",
    "རེངས་ན་དམུ་ཆུ་ལ་སོགས་པ་དང་སྐྲན་དུ་འགྱུར།",
    "རེངས་ན་རོ་སྨད་བཤལ་ཞིང་མི་ཐེག་དྲི་ཆེན་དྲི་ཆུ་ལ་སོགས་པ་སྡོམ།",
    "རེངས་ན་ལྐོག་འབྲས་ལ་སོགས་པར་འགྱུར།",
    "རེངས་ན་ཡན་ལག་འཁུམས་ཤིང་སྒུར་པོ་ལ་སོགས་པར་འགྱུར།",
    "རེངས་ན་ལོང་བ་ལ་སོགས་པར་འགྱུར།",
    "རེངས་ན་འོན་པ་ལ་སོགས་པར་འགྱུར།",
    "རེངས་ན་དྲི་མི་ཚོར་བ་ལ་སོགས་པར་འགྱུར།",
    "རེངས་ན་ལྐུགས་པ་ལ་སོགས་པར་འགྱུར་བཅོས་པའི་ཐབས་སྔ་མ་བཞིན་ཏེ་བདུན་ནོ།",
    "ལས་རེག་བྱ་རབ་འབྲིང་གསུམ་རིག་པར་བྱེད་ཐ་མལ་པའི་གནས་ལུགས།",
    "ཞག་བདུན་ཚུན་ཆད་ཟུག་དེ་ལས་འདས་ཏེ་རེངས་ན་པགས་པ་འགོག་ཅིང་ཟ་འཕྲུག་ལ་སོགས་པར་འགྱུར།",
    "ནང་གི་ཌཱ་ཀི་རྩ་ཚོགས་ཀྱི་ལོངས་སྤྱོད་ཀྱིས་ཚིམ་པར་བྱས་པས་ལུས་ལ་བདེ་བ་སྐྱེ།",
    "འཇུག་པ་རེ་རེ་ལ་ཡང་ཕྱིར་ལྡང་བ་དང་ནང་དུ་འཇུག་པ་དང་ཅུང་ཟད་ཙམ་གནས་པ་དང་དེ་རྣམས་བསྡོམས་པ་ལ་དབུགས་གཅིག་ཅེས་བྱ་སྟེ་བཞིའོ།",
    "དེ་ནས་ནང་དུ་གསུམ་མམ་ལྔའམ་བདུན་ནམ་ཀ་ས་། བཅུ་གཅིག་སོགས་ཕྱིར་རེ་རེ་རྒྱུས་ཞེས་དྲན་པར་བྱས་ཏེ་ཐུན་ནམ་ཉི་མ་གཉིས་པ་ནས་གྲངས་ཁ་ཡར་བ་དེ་བས་མང་བ་ལ་བསླབས་ཏེ་མཐར་སྟོང་ལ་སོགས་པ་ནང་དུ་གནས་པའི་དབུགས་ནང་དུ་ཞི་ནས་ཕྱིར་མི་ལྡང་བ་འབྱུང་གསུང་སྟེ།",
    "སྣ་གཡས་པ་རས་ལྡོའམ་སོར་མོས་བཀག་ལ་ཅུང་ཟད་ནང་དུ་རྔུབས་ལ་དེ་ནས་ཕྱིར་རྒྱུ་ན་ར་ར་འབུད་ཤུགས་ཟད་པ་དང་ནང་དུ་འཁོར་དུ་མི་གཞུག་སྟེ།",
    "སྣ་གཉིས་ཀ་ནས་ཤུགས་བསྐྱེད་དེ་བུས་ལ་བཏང་ལ་ནང་དུ་འཁོར་དུ་མི་གཞུག་སྟེ་དེ་ནས་མ་ཐུབ་པ་དང་གཏང་ལ་ཡང་ཕྱིར་བུད་དེ་དམིགས་པ་ནི་དང་པོ་སྨིན་མཚམས་སུ་གཏད་དེ་ནས་མཛོད་འདོམ་གང་ཙམ་གྱི་ས་དང་དཔག་ཚད་ལ་སོགས་པ་ཇེ་རིང་ཇེ་རིང་ལ་གཏད་དེ་ཉམས་སུ་བླངས་པའི་མན་ངག་གོ།",
    "དེ་ལ་དམིགས་པ་ནི་ཨ་སྒོ་ང་དང་བཅས་པ་དེ་ཇེ་ཆེ་ཇེ་ཆེ་ལ་རང་གི་ལུས་ཀྱང་ཇེ་ཆེ་ཇེ་ཆེ་ལ་སྟོང་གསུམ་ཁྱབ་པ་ཙམ་དུ་བསམ་སྟེ་ས་གཞི་ལྟར་རྒྱ་ཆེ་བ་བསྐྱེད་པའོ།",
    "རེས་འགའ་རང་གི་ཤེས་པ་སྤྱི་གཙུག་ནས་སྟེང་ན་ཡར་རྒྱངས་ཇེ་མཐོ་ལ་འོག་མིན་ན་ཡར་སླེབ་པ་ཙམ་དུ་ནམ་མཁའ་ལ་འཕངས་གཏོད་ལ་གཏང་།",
    "རེས་བཀུག་ནས་འོང་།",
    "རེས་རིང་ནར་གྱིས་འགྲོ།",
    "རེས་ཐུང་ཀུམ་པ་ལ་དམིགས་པ་གཏད་དོ།",
    "དེས་ཕན་ཡོན་ནི་བདེ་སྟོང་གི་ཏིང་ངེ་འཛིན་མཆོག་ཏུ་གྱུར་པ་ཐམས་ཅད་སྐྱེའོ།",
    "དེ་ཐམས་ཅད་ལ་བསམ་གཏན་གྱི་ཡན་ལག་དགུ་ཚང་བར་བྱ་བ་ནས་རྗེས་ལྟ་བ་བསྐྱང་བའི་བར་རེ་རེ་ལའང་ཚང་བར་དགོས་སོ།",
    "དེས་སེམས་བྱིན་གྱིས་བརླབས་པས་སེམས་ནང་དུ་གནས་པས་ན་དེ་ལ་བརྟེན་ནས་སེམས་ནང་དུ་གནས་ཞེས་པ་ཤེས་པ་བདེ་སྟོང་སོགས་སུ་སིང་གིས་གནས་པ་གར་སྤྱིན་གྱི་ཕུང་པོ་ལ་རེག་པའམ།",
    "ཕྱི་ནང་གི་སྲིན་བུ་སྤོང་བར་ནུས།",
    "སྐུའི་མཉེན་ལྕུག་རྡོ་རོང་གི་གསེབ་ཏུ་བསྡད་ཀྱང་རུང་།",
    "རྐང་ལག་གི་མཐེ་བོང་རེ་རེའི་ཁ་ལ་ཉིན་མཚན་མེད་པར་བསྡད་ཀྱང་མི་ན་སྟེ་སྐའི་མཉེན་ལྕུག་འཆར་བའོ།",
    "མཐོང་སྣང་ནང་གི་སེམས་ཉམས།",
    "༞། གསུམ་གསུམ་ཞེས་པ་དྲོད་གསུམ་གྱི་བྱེ་བྲག་གིས་དགུར་འགྱུར་ཏེ།",
    "དེ་ལས་རྣམ་རྟོག་སྔོན་དུ་སོང་བའི་གསུམ་ནི།",
    "རྣམ་རྟོག་སྔོན་དུ་སོང་བ་ལྟར་ཞེས་པ་སྟེ།",
    "རང་གི་ལུས་ཤིང་སྡོང་དང་ཤིང་བྲག་ལ་སོགས་པ་དེ་རྣམས་སུ་སོང་ན་ལུས་ཉམས་སོ།",
    "ཐམས་ཅད་ཁྱགས་པར་སོང་བ་དང་གོང་མ་དེ་དག་རྨི་ལམ་དུ་བྱུང་ན་རྨི་ཉམས།",
    "ཁམས་གསུམ་ཀུན་ཏུ་སྣང་ངོ་ཞེས་པ་ཁམས་གསུམ་གྱི་སྣང་བ་ཉེ་བར་ནུབ་ནས་ཉམས་དགུ་པོ་དེ་དག་གི་སྣང་བ་འབྱུང་སྟེ།",
    "ལུས་ཉམས་སུའང་རང་གི་བ་སྤུའི་བུ་ག་རེ་རེར་ཡང་ནམ་མཁའ་དེ་རྣམས་མཐོང་བ་འབྱུང་ངོ།",
    "རྨི་ཉམས་སུའང་རྩིག་པ་ལ་སོགས་པ་སྣང་བའི་དངོས་པོ་གང་ལ་ཡང་ཐོགས་པ་མེད་པར་ཕར་ཐལ་ཚུར་ཐལ་འགྲོ་བ་རྨི་ཐམས་ཅད་སྟོང་པ་འབའ་ཞིག་ཏུ་སོང་བ་རྨིའོ།",
    "དེ་དག་སྐྱེས་པ་དང་ཤེས་རབ་ཀྱི་ཨ་དང་ཟུང་འཇུག་གི་ཧཱུཾ་དུ་ཐིམ་ནས་བདག་གཞན་ཐམས་ཅད་སྟོང་པར་ཕྱ་ལ་ལ་འགྲོ་བ་དང་དེ་དག་ཐམས་ཅད་ཟུང་འཇུག་ཏུ་གྱུར་པའི་ཉམས་སྐྱེའོ།",
    "མེ་གོས་དཀར་མོ།",
    "སྐུའི་མཉེན་ལྕུག་རྡོ་རོང་གི་གསེབ་ཏུ་བསྡད་དམ་༣།",
    "རྐང་པའི་མཐེ་བོང་ངམ་ལག་པའི་མཐེ་བོང་རེ་རེ་བཙུགས་ནས་ཀྱང་ཉིན་མཚན་མེད་པར་སྡོད་ནུས།",
    "ལུས་ཉམས་སུའང་རིགས་ལྔར་སོང་བ་འབྱུང་ངོ།",
    "ག་པུར་ཞེས་པ་ཕ་ལས་ཐོབ་པའི་ས་བོན་གྱིས་རུས་མ་པ་དང་སོ་དང་སེན་མོ་ལ་སོགས་པ་བསྐྱེད་ནས་ནུས་པའི་མཐུ་སྨིན་མཚམས་ཀྱི་འཁོར་ལོར་རྫོགས་ནས་གནས་ཏེ།",
    "དེ་ནས་བདུད་རྩིའི་འགྲོས་ཐིམ་ནས་དྭངས་མ་མཆོག་ཏུ་འགྱུར་རོ། ། ད་ནི་རྩ་ཡི་གེས་ལམ་ཁྲིད་པ་ལ་གཞུང་ཚོམ་བུ་བཅད་ན་གསུམ་སྟེ།",
    "ལུས་ཉམས་སུ་ཡང་རང་རི་དང་བྲག་ཆེན་པོར་སོང་བ་འབྱུང་།",
    "ཞེ་སྡང་གི་བག་ཆགས་སམ་ས་བོན་ཀུན་གཞི་ལ་ཡོད་པའི་རྟེན་རྩ་དབུས་ཀྱི་ཧཱུཾ་ཡིག་གཏི་མུག་གི་ཡིག་ང་རྒྱལ་དང་སེར་སྣའི་ཨཾ་ཡིག་འདོད་ཆགས་ཀྱི་ཛྭ་ཡིག་ཕྲག་དོག་གི་རྩ་ཁཾ་ཡིག་གནས་ཏེ།",
    "མཐོང་སྣང་ངམ་རྨི་ཉམས་སུ་ཉོན་མོངས་པ་རྣམ་པར་འཇོམས་པ་མཐོང་སྟེ་ཞེ་སྡང་གི་མེ་སོད་ཟེར་ནས་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་མི་ཐམས་ཅད་ཀྱིས་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་མེ་འབར་བ་གསོད་པ་མཐོང་བའམ་རྨི་བ་འབྱུང་།",
    "ཉོན་མོངས་པའི་རྣམ་པ་འཇོམས་པ་སྟེ་མཐོང་སྣང་དང་རྨི་ཉམས་སུ་ཡང་འདོད་ཆགས་ཀྱི་དུག་བཅོམ་ཟེར་ནས་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་མི་ཐམས་ཅད་ཀྱིས་དུག་ཕྱེ་མར་བྱེད་པ་དང་།",
    "རང་འདྲེར་སོང་བ་དང་འདྲེ་མང་པོ་མཐོང་བ་དང་རྨི་ལམ་དུ་ཡང་དེ་ལྟ་བུ་འབྱུང་ངོ།",
    "དེ་ཡང་སེམས་ལ་གང་གི་བག་ཆགས་གནས་པ་དེའི་ས་བོན་ནམ་རྟེན་རེ་རེ་ལུས་ལ་གནས་ཏེ་གཟུགས་མཐོང་བའི་བག་ཆགས་ཀྱི་ས་བོན་ནམ་རྟེན་མིག་ལ་གནས།",
    "དེ་བཞིན་དུ་རིགས་དྲུག་གི་བག་ཆགས་སེམས་ལ་གནས་པའི་རྟེན་ཨ་ཡིག་ལ་སོགས་པ་དྲུག་ཡོད་པ་ལ་སོགས་པ་སྟེ།",
    "ལྟེ་བར་རྩ་གསུམ་འདུས་པའི་མདུད་པ་འདྲེས་ནས་ནང་གཅིག་ཏུ་མཛོད་ཡོད་པས་དེའང་ལྟེ་བ་ཡན་ཆད་ཀྱི་གཡས་ཀྱི་རྩ་གཉིས་ལྟེ་བ་མན་ཆད་དུ་གཡོན་དུ་སོང་གཡོན་གྱི་རྩ་གཉིས་གཡས་སུ་སོང་བའི་སྟོད་གཡས་སྨད་གཡོན།",
    "གཡོན་གྱི་གཅིག་གིས་ཟླ་བ་བྱང་སེམས་འཕེན་པར་བྱེད།",
    "གཅིག་མདུན་དུ་སོང་མ་བས་གླ་རྩི་དྲི་ཆུ་འཕེན་པར་བྱེད་འཛིན་པར་བྱེད་དོ།",
    "གཡས་ན་གཉིས་ཡོད་པའི་གཅིག་གིས་རཀྟ་ཉི་མ་འཕེན་པར་བྱེད་འཛིན་པར་བྱེད།",
    "རྒྱབ་ཏུ་སོང་བས་བཞི་མཉམ་དྲི་ཆེན་འཕེན་པར་བྱེད་འཛིན་པར་བྱེད་པའོ།",
    "ཉོན་མོངས་ལྔའི་ཡི་གེའི་དབྱེ་བ།",
    "དེ་དག་གིས་རིགས་དྲུག་ཏུའང་སྐྱེ་བར་བྱེད་དེ་བསྒོམས་པའི་སྟོབས་ཀྱིས་དེ་དག་གི་ཉམས་འབྱུང་ཞིང་ལམ་གོང་ནས་གོང་དུ་འགྲོ་བར་བྱེད་དོ།",
    "ཧཱུཾ་གི་སྟེང་ན་དུད་འགྲོའི་ས་བོན་དུ་ཡིག་དུད་ཀ་འདི་གཉིས་ཀྱང་རྩ་གཡས་གཡོན་གྱི་མདུད་པ་ཡིན་གསུང་།",
    "ཕྱི་དབྱིབས་ཀྱི་ཨའི་འོག་ན་རྩ་གཡས་གཡོན་གཉིས་ཀྱི་མདུད་པ་ཀྵ་ཡིག་དམར་ནག་མགོ་ཐུར་ལ་བལྟས་པ་ཞིག་གནས་པ་དེ་ཡང་བསྒོམས་པའི་སྟོབས་ཀྱིས་སྐྱེས་པ་ལ་དམར་ནག་བུད་མེད་ལ་ལྗང་གུར་འགྱུར་རོ་གསུང་ངོ།",
    "ཕྱི་དབྱིབས་ཀྱི་ཨ་དེ་ནི་མཁའ་འགྲོ་མ་དང་ཤ་ཟ་མོ་དང་འབྱུང་མོ་དང་སྲིན་མོ་ལ་མ་སོགས་པ་སྲིད་པ་མོ་རྒྱུད་ཐམས་ཅད་ཀྱི་གནས་ཡིན་གསུང་སྟེ་དེས་ན་ཁམས་སྦྱངས་ཤིང་རྩ་ཡིག་ལ་སོགས་པ་དག་པའི་སྟོབས་ཀྱིས་ཕྱིའི་གདོན་ཐམས་ཅད་རང་བཞིན་གྱིས་དག་ནས་འགྲོའོ།",
    "དྲུག་པ་ཉོན་མོངས་པ་ལྔའི་ཡི་གེར་དབྱེ་བ་ནི།",
    "དྲི་ཆེན་གྱི་དྭངས་མ་དེ་གཞན་གར་འདུས་ཀྱང་རང་རང་གི་ཉམས་ལས་གཏི་མུག་མི་སྐྱེའོ།",
    "སྤྱིར་ཨ་དགུ་ཡང་གནས་ཏེ་དེ་དྲུག་གི་སྟེང་དུ་བརྗོད་པའི་ཨ་ཕྱི་རོལ་གྱི་ཨ་མཐར་ཐུག་གི་ཨ་དང་དགུའོ།",
    "ལྟེ་བར་དང་པོར་ཆགས་པའི་རིགས་དྲུག་གི་ཡི་གེ་ཞེས་སོ།",
    "འདས་པའི་ལམ་ནས་བྷ་གའི་དཀྱིལ་འཁོར་དུ་རིགས་དྲུག་གི་ས་བོན་མཐོང་།",
    "ངག་བྱིན་གྱིས་བརླབས་ན་ངག་རིགས་དྲུག་གི་སྐད་སྨྲ་བ་རྣམས་འབྱུང་སྟེ།",
    "རྨི་ལམ་དང་གསུམ་མོ།",
    "ངག་བྱིན་གྱིས་བརླབས་ན་ལེགས་པར་སྦྱར་བའི་སྐད་ལ་སོགས་པ་འདོད་ཁམས་ཀྱི་ལྷ་རིགས་དྲུག་གི་སྐད་བརྗོད་པ་འབྱུང་སྟེ།",
    "སྔགས་ངག་ལ་འཆར་བ་སྟེ་གནས་སྦྱོང་དང་པོ་གསུམ་མོ།",
    "མཐོང་སྣང་གི་གསུམ་ལ་དུད་འགྲོ་ཕལ་བའི་གནས་ཕྱིའི་རྒྱ་མཚོ་ཆེན་པོ་དང་།",
    "ངོ་བོ་ཟུང་འཇུག་གི་ཉམས་ཀྱང་རིམ་པ་ཡིན་མིན་དུ་སྐྱེ་བས་དྲོད་བྱུང་རྒྱལ་དུ་བསྐྱང་།",
    "རྣལ་འབྱོར་ལམ་པ་ལ་དེ་དག་བྱུང་བས་རིགས་དྲུག་གི་བག་ཆགས་བྱང་ཞིང་ལམ་དུ་འགྱུར།",
    "དེ་དག་ཅི་རིགས་པར་འབྱོངས་ན་ཕྱི་ནང་གི་སྲིན་བུ་ཡང་སྤངས་པར་ནུས།",
    "ངན་སོང་གསུམ་མཛོད་དུ་མི་སྐྱེ་བའི་གདེང་ཐོབ།",
    "དེ་དག་གིས་ནི་འདོད་ཁམས་ཀྱི་ཉམས་ཅི་རིགས་ཙམ་བསྟན་ཏོ།",
    "དེ་དག་གིས་ནི་གཟུགས་ཁམས་ཀྱི་ཉམས་ཅི་རིགས་ཙམ་བསྟན་ཏོ།",
    "ཧཱུཾ་ལས་གསལ་ཞིང་ཡང་ལ་རང་བྱུང་གི་ཡེ་ཤེས་ཆེན་པོ་ནམ་མཁའ་ཤིན་ཏུ་དྲི་མ་མེད་ཅེས་པ་སྟེ།"
  ]
}