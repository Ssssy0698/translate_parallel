    "ཐ་མལ་པའི་ཉོན་མོངས་པ་དང་ཁྱད་པར་དབྱེ་བ་དཀའ་བ་དང་།",
    "ཉོན་མོངས་པས་ནི་རབ་ཉོན་མོངས།",
    "ལུས་བདེ་སྟོང་ཟུང་འཇུག་གི་ས་མ་ཏི་སྐྱེ་སྟེ་འདྲེ་ཞིང་སྐྱེའོ།",
    "དེ་ལ་བྱུང་རྒྱལ་དུ་གཏང་བས་སྟོང་གསལ་མཆོག་གི་ས་མ་ཏི་སྐྱེ་སྟེ་འདྲེ་ཞིང་སྐྱེའོ།",
    "སྐྱོན་མེད་ནི་ཟུང་འཇུག་གི་ཧཱུྃ་དུ་རླང་སེམས་མཉམ་པར་འདུས་པས་ཤེས་པ་གསལ་སྟོང་གསལ་སིང་བ་སྐྱེ་སྟེ་དཔེར་ན་ནམ་མཁའ་དྲི་མ་དང་བྲལ་ཞིང་མཐའ་དབུས་མེད་པ་ལྟ་བུ་སྐྱེའོ།",
    "རྫོགས་པ་ནི་དེ་ཐམས་ཅད་རང་གིས་བརྗོད་ཤེས་པའོ།",
    "ཚིག་གི་མཆོག་གྲུབ།",
    "དེའང་འཆི་བའི་ཚེ་རང་གི་ལུས་ཀྱི་ཡུལ་ཉི་ཤུ་རྩ་བཞི་ལ་སོགས་པ་ན་ཐིག་ལེ་གནས་ཚད་ཙམ་ཕྲོགས་ནས་རྩ་གཡས་གཡོན་གཉིས་སུ་འདུས་ཏེ།",
    "བདག་བཟའ་བསྲུང་གི་དམཚིག་སུམ་ཅུའམ་ཉི་ཤུ་རྩ་གཉིས་བསྲུང་བ་དེ་ཕྱག་རྒྱ་ཡང་བསྲུང་བའོ།",
    "རི་མོ་ཅན།",
    "རི་དྭགས་ཀྱི་རོ་སྨད་དེ་སྨད་ཀྱི་ཤ་ཤིན་ཏུ་རྒྱས་ཤིང་ཚང་ར་ཟླུམ་པ་རི་དྭགས་ཀྱི་སྐེད་པ་སྟེ་ཤིན་ཏུ་ཕྲ་བ་མཛུབ་མོ་གཉིས་ཀྱིས་འཁྱུད་པའོ།",
    "རི་དྭགས་ཀྱི་འགྲོས་ཏེ་རེངས་ཀྱང་རྒྱུག་མི་ཤེས་ཏེ་དལ་ནས་འགྲོ་བའོ།",
    "ལྟེ་བའི་ནང་ན་དུང་གཡས་སུ་འཁྱིལ་བའི་རི་མོ་ཡོད་པ།",
    "རི་མོ་ཅན་མ་ནི།",
    "གསང་རྩ་གསུམ་ཀས་ཕན་ཐོགས་པའི་རྟགས་སུ་ལྟེ་བའི་སྟེང་ན་རི་མོ་འགྲེང་བུ་གསུམ་ཡོད་པ།",
    "བཀྲ་ཤིས་པའི་བརྡར་མུར་གོང་གི་མཐའ་གཉིས་ན་དར་ཐོད་ལྟ་བུའི་རི་མོ་རྩ་བ་གཅིག་ལ་རྩེ་མོ་གསུམ་དུ་གྱེས་པ་རེ་ཡོད་པ།",
    "བཀྲ་ཤིས་པའི་ཡན་ལག་མང་བའི་བརྡར་ཚིགས་ཀྱི་ཚོགས་རིང་ཞིང་དམར་ལ་རྐང་ལག་ཐམས་ཅད་ཕུག་རོན་གྱི་རྐང་པ་ལྟར་དམར་བ་རི་མོ་མང་བ་དེ་ལྟ་བུ་ཁྱད་པར་དུ་བསྔགས་སོ།",
    "ལུང་གཞན་ལ་གྲགས་པའི་བུ་མོ་བ་ལང་ཅན་མ་ཞེས་པ་ནི་འདིའི་སྣ་ཚོགས་ཅན་མ་ཞེས་བྱ་གླང་པོ་ཅན་མ་ཞེས་བྱའོ།",
    "རང་གི་བྱང་སེམས་འཕུར་ནུས་པའོ།",
    "མཐར་མི་ཉམས་པར་བྱ་བ་དྲུག་གིས་བསྲུང་བའོ།",
    "དེ་ནས་བདེ་བ་ཆུང་ན་རྟེན་ཡོངས་སུ་དག་པ་དང་བདག་གཉིས་རྟ་བོང་གི་འཁྲིག་པའི་གཏམ་ལ་སོགས་པ་ཆགས་པའི་གཏམ་སྣ་ཚོགས་བྱས་པས་འདོད་ཆགས་ཀྱི་མེ་སྦར།",
    "དེའི་དུས་སུ་དྲི་ལ་སོགས་པ་ལ་མི་སྣོམ་མོ།",
    "དེ་ནས་སྐྲ་ལ་རེག་དེ་ནས་སྨིན་མཚམས་དང་ནུ་མ་དང་དཀུ་གཡས་གཡོན་དང་རྐང་མཐིལ་ལ་སོགས་པར་རེག་ཅིང་འདོད་ཆགས་ཀྱི་མེ་སྦར་བས་ཐིག་ལེ་དབབ།",
    "དེ་ནས་ལུས་ངག་མཉམ་པ་ལ་སོགས་པ་གསུམ་བྱས་ལ་དངོས་སམ་ཡིད་ཀྱིས་རྡོ་རྗེ་དང་པདྨ་ཁ་སྦྱར་ཏེ་རེག་ཙམ་བྱས་པས་འདོད་ཆགས་ཀྱི་མེ་འབར།",
    "རེས་དྲི་ཆེན་དང་དྲི་ཆུ་ལ་སོགས་པ་ཡང་མི་ཐོན་རེས་མི་སྡོམ་པ།",
    "ཁ་དོག་སྣ་ཚོགས་པ་བྱ་ཀོ་ཀ་ལི་ཀའི་ཞེས་པ་ཕུག་རོན་གྱི་སྐེའམ་རྒྱ་མཚོ་ནང་གི་ཉི་མའི་གཟུགས་སམ་ཉི་མ་འཆར་ཀའི་དཀྱིལ་འཁོར་གྱི་འོད་དམ་རྫུ་སྐྱའི་ཁར་ཟིལ་པ་ཆགས་པའམ་རྨ་བྱའི་མཐའི་མཇུག་སྒྲོའི་འོད་ལྟ་བུ་ཁ་དོག་སྣ་ཚོགས་སུ་གྱུར་པས་ན་ཐིག་ལེ་གཉིས་ཁ་སྦྱོར།",
    "ཁ་སྦྱོར་བཞི་འཛོམ་པ་བཞི་མ་བུ་བཞི་འཛོམ་པས་བདེ་བ་དང་སྟོང་པ་ཟུང་དུ་ཆུད་ཅིང་བདེ་བ་ངོས་གཟུང་ཐམས་ཅད་དང་བྲལ་བ་ཉིན་མོའམ་མཚན་མོའམ་ལོའམ་ཟླ་བར་བདེ་བས་བརྒྱལ་བ་འོང་ཡང་སྲིད།",
    "གདོང་པ་ཀུན་ཡང་ཁྲག་བཞིན་དུ་སོང་ནས་དུད་འགྲོ་མོ་ཆགས་ལ་སོགས་པ་ལ་ཡང་འཛིན་པ་སྙམ་བྱེད་པ་བྱུང་ན་ཞེན་པ་གོ་གཉིས།",
    "གསང་ཐུབ་པར་བྱས་ཏེ་ཉམས་སུ་མི་གཞུག་དེའི་དུས་སུ་འགྱུར་བ་རྣམ་པ་དྲུག་གིས་བསྲུང་བ་ནི་ལུས་ཀྱི་འགྱུར་བ་བཞི་ནི་རྒྱ་མཚོ་རི་རབ་ལ་བསྐམ་པ་སྟེ་གསུས་པ་སྒལ་པ་ལ་སྦྱར།",
    "རོ་འཛིན་ནི་ལྕེ་སྟེ་དེ་རང་གི་གནས་རྐན་ལ་སྦྱར།",
    "སྐེད་པ་ན་ཧཱུཾ་ཡོད་པ་དེ་དཔྱངས་ཐག་གིས་དབྱང་རྫིའུ་འདྲེན་པ་ལྟར་ན་ར་ར་དྲང་།",
    "གཏུན་ཤིང་གི་འཁོར་ལོ་བསྐོར།",
    "བུ་ཆུང་གི་སྤྱོད་ལམ་བྱས་པས་ལུས་ཐམས་ཅད་ལ་ཁྱབ་པར་བྱའོ།",
    "གཉིས་པ་ནི་རྐང་ལག་བཞི་ཀ་རེ་མོས་གཡབ་ཅིང་བརྐྱང་།",
    "པུས་མོ་གཡས་གཡོན་བསྣོལ་མར་དགབ།",
    "བུད་པ་གསུམ་དང་། རྔུབ་པ་གསུམ།",
    "རང་གི་པུས་མོ་གྲུ་མོ་ཁུད་དུ་བཅུག་ལ་པུས་མོ་གཉིས་ལ་བསྣོལ་མར་དགབ།",
    "ཟས་བཅུད་ཅན་གྱི་ལྕག་གིས་བསྐུལ་དགོས་པས་མདུན་དུ་ཟས་བཅུད་ཅན་ཚགས་བྱས་ལ་ད་ལྟ་ནསད་ལྟར་བཟའ།",
    "དེ་ནས་མདུན་དུ་ཡང་སྣའི་དབུགས་ལན་གསུམ་མར་བུད་རྔུབ།",
    "དེ་ནས་གཡོན་དང་གཡས་སུ་ཡང་མར་ལན་གསུམ་གསུམ་བུད་རྔུབ་བོ།",
    "ལག་པ་གཡས་གཡོན་གྱི་གུང་མཛུབ་གཉིས་རེས་མོས་ཀྱིས་ཁར་བཅུག་པ་ལ་ཁ་ནས་མི་ཕྱི་ན་ཙམ་དུ་གཞིབ།",
    "མིག་གཉིས་སྟེང་དུ་བགྲད་དེ་དེ་རྣམས་དུས་གཅིག་ཏུ་བྱས་པས་གཟུང་སྟེ་ལུས་ཀྱི་འགྱུར་བ་གསུམ་མོ།",
    "ངག་ཏུ་ཧ་ཧལ་ཞེས་དྲག་ཏུ་བརྗོད་པས་གཟུང་སྟེ་ངག་གི་འགྱུར་བའོ།",
    "ངག་གི་གཅིག་དང་།",
    "གླང་ཆེན་ཧིང་དང་སྟག་མོའི་ངུར།",
    "མཛུབ་མོ་གཉིས་ཀྱིས་མིག་གཉིས་མནན།",
    "གུང་མོ་གཉིས་ཀྱིས་སྣ་བུག་གཉིས་བཅར།",
    "གཟུང་བ་ལ་མི་མཁས་ན་བདེ་བ་སྐྱེ་ལོང་མེད་པར་བཟློག་པར་སོང་ནས་བདེ་བ་ཡུན་ཐུང་།",
    "རང་གི་ངོ་བོ་ལ་ལྟོས་པའི་དགའ་བ་བཞི་སྟེ་བཅུ་དྲུག་ཏུ་ཡང་འགྱུར་རོ།",
    "གཟུགས་ནས་རེག་པའི་བར་དུ་ནང་གི་འདོད་ཡོན་ལྔ་ལ་སློབ་པའི་དུས་སུ་ཉམས་ཅི་སྐྱེས་དགའ་བ།",
    "བཞི་པ་རང་གི་ངོ་བོ་ལ་ལྟོས་པའི་དགའ་བ་བཞི་ནི།",
    "དང་པོར་རེག་པར་འདོད་པ་མཛོད་དང་། གཉིས་པ་བདེ་བར་འདོད་པ་དང་།",
    "དེ་ནས་ཁམས་དྭངས་མ་ཐམས་ཅད་མར་སོང་ནས་གཡོན་རྐྱང་མའི་སྣར་འདུ།",
    "ལམ་རྡོ་རྗེ་རྦ་རླབས་གསུམ་དུ་རེངས་པ།",
    "དེ་ནས་ངག་འདྲེན་པ་ཞི་དྲག་གི་རྦ་རླབས་བསྒོམ།",
    "བུ་མོ་པདྨ་ཅན་མཚན་དང་མི་ལྡན་པ་མ་ཡིན་ཏེ་མཚན་དང་ལྡན།",
    "འོད་ཟེར་ཁ་དོག་སྣ་ཚོགས་དང་བཅས་པ་རྒྱ་མཚོ་ནང་གི་ཉི་མའམ།",
    "བྱ་ཀོ་ཀ་ལི་ཀ་ཞེས་པ་ཕུག་རོན་གྱི་མགྲིན་པ་ལྟ་བུར་གྱུར་ཏེ་ཡབ་ཀྱི་རྩ་གཡས་རོ་མ་ནས་སོང་ལྟེ་བའི་ཙཀྲར་བྱོན།",
    "འཛིན་པའི་རྦ་རླབས་རེངས་པ།",
    "གཟུང་འཛིན་གཉིས་ཀའི་རྦ་རླབས་རེངས་པ།",
    "གཡོན་དུ་གཟུང་བའི་རྦ་རླབས་རེངས་པས་མི་རྟོག་པས་གྲོགས་བྱས་པའི་བདེ་བ་སྐྱེ།",
    "དེ་དག་གི་དུས་སུ་ཡང་ཉམས་བདེ་སྟོང་ཉིན་མཚན་མེད་པར་སྐྱེ་བར་ཡང་སྲིད།",
    "ཡང་ལྟེ་བར་བརྟན་ཙམ་ན་རང་གི་ལུས་ཙམ་བདེ་སྟོང་དུ་རྟོགས་པ་འབྱུང་།",
    "དེས་ཐུན་ཚད་འཛིན་པ་ནི་མིན་ཏེ་ཐུན་གཅིག་ལ་དེ་ལྟ་བུ་གཅིག་གམ་གཉིས་སམ་བདུན་ནམ་བརྒྱད་ལ་སོགས་པ་ཁམས་སམ་ཡིད་འཇུག་ཡུལ་གྱི་བྱེ་བྲག་གིས་ཅི་རིགས་པ་བྱ།",
    "བསམ་གཏན་གཞུང་གྱི་ཡན་ལག་དགུ་དང་ལྡན་པས་ཧིཀ་གིས་དྲང་ཞིང་ཀ་ཧིཀ་གིས་ངལ་གསོ།",
    "ནང་གི་ཡི་གེ་ལ་གོམས་པར་བྱ་བའོ།",
    "དེའང་ཐུན་བཞི་ངེས་པས་ཞག་བདུན་དུ་གོམས་པར་བྱ་ཟེར་བ་ནི་གདམས་ངག་གི་བཀའ་སྲོལ་ཡིན་གྱི་ཕྱི་ནང་ཡི་གེ་གཉིས་ཀ་ལག་པའི་རི་མོ་ལྟར་ཤིན་ཏུ་གསལ་བར་མ་བྱུང་གི་བར་དུ་གོམས་པར་བྱའོ།",
    "དེ་ནས་བདེ་མཆོག་གི་རྣལ་འབྱོར་པ་ཡིན་ན་གོ་ཆ་རྣམ་གཉིས་བསམ།",
    "དེ་ཙམ་ན་སེམས་གཅིག་གིས་རྟེན་གཉིས་འཛིན་ནུས་པའི་དུས་ཞེས་བྱའོ།",
    "གཞན་གྱི་རྟེན་བདག་གི་རྟེན་དུ་བྱས་པ་དེས་འགྲོ་བ་མང་པོའི་དོན་བྱ་རྟེན་རྙིང་པ་དེ་ལ་དྲིན་ལན་བསབ་པའི་ཕྱིར་སྦྱང་བའམ་རྒྱ་མཚོ་ཆེན་པོར་དོར་བར་བྱའོ།",
    "སྐྱེ་གནས་ལས་ཀྱང་མངལ་སྐྱེས་སུ་འདོད་ན་རྒྱལ་རིགས་སམ་བྲམ་ཟེའི་རིགས་ཀྱི་བཙུན་མོའི་མངལ་དེ་ཡིད་ཀྱི་ཡུལ་དུ་བྱས་ལ་དེར་འཕང་།",
    "རྟོགས་ལྡན་གཅིག་ལ་མོས་གུས་ཀྱིས།",
    "འདིར་ལམ་འབྲིང་པོ་དམ་ཚིག་གི་ཚོགས་བསྟན་པ་ལ་བཞི་སྟེ།",
    "རྗེས་སྤྱོད་ཀྱི་དམ་ཚིག་ཏིང་ངེ་འཛིན་རང་གི་ངོ་བོ།",
    "དེ་ནས་དེ་རྣམས་རི་ལུ་བྱས་ལ་སྔར་ལྟར་ཞག་བདུན་དུ་བསྒྲུབ་པ་ནི་རི་ལུ་ལ་བསྒྲུབ་པ་སྟེ་དེ་ལྟ་བུ་ཚགས་བྱས་ལ་རབ་ཀྱིས་ཐུན་རེ་རེ་ལ་རེ་རེ་བཟའ།",
    "མ་གྲུབ་ན་ཐོ་རངས་ཀྱི་ཐུན་རེ་ལ་བཟའ།",
    "དེ་མ་གྲུབ་ན་ཟླ་བ་རེའི་མར་ངོའི་ཉི་ཤུ་དགུ་ལ་རེ་རེ་བཟའ།",
    "བསྲུང་བའི་དམ་ཚིག་ཐོག་མར་ཁས་བླངས་པ་རྩ་བ་དང་ཡན་ལག་གི་དམ་ཚིག་ཉི་ཤུ་རྩ་གཉིས་སོ།",
    "རྗེས་སྤྱོད་ཀྱི་དམ་ཚིག་རང་བྱུང་གི་ཡེ་ཤེས།",
    "ཏིང་ངེ་འཛིན་སྐྱེ་བའི་རྒྱུ་ལ་ནན་ཏན་བྱེད་པའི་ལམ་བཞི་དགོས་པས་མཉམ་གཞག་གི་དམ་ཚིག་བསྲུང་དགོས།",
    "དང་པོ་ནི་མཉམ་གཞག་གི་དམ་ཚིག་ལམ་བཞི་ཇི་ལྟ་བ་བཞིན་དུ་བླངས།",
    "སློབ་དཔོན་འདིས་དམ་ཚིག་དང་སྡོམ་པ་ནི་མིང་གི་རྣམ་གྲངས་སུ་བཞེད་གསུང་།",
    "ཁྱད་པར་དུ་མཉམ་གཞག་གི་དམ་ཚིག་ཉམས་ན་ཡེ་ཤེས་ཌཱ་ཀི་ལོངས་སྐུ་མཉེས་དགོས་ལ།",
    "རྗེས་སྤྱོད་ཀྱི་དམ་ཚིག་ཉམས་ན་མ་མོ་ཌཱ་ཀི་སྟེ་སྤྲལ་སྐྲ་མཉེས་དགོས་ཏེ་དེ་ལ་བསམ་གཏན་ཚད་དུ་བསྐྱལ་ཏེ།",
    "བསམ་གཏན་ཚད་དུ་བསྐྱལ་བ་ནི་ཉམས་སྐྱོན་ཅན་བརྒྱད་སྤངས་པའི་སྐྱོན་མེད་གསུམ་སྐྱེས་པ་སྟེ་དེ་ཙམ་ན་རྩ་གནས་ཐམས་ཅད་ཁམས་དྭངས་མས་གང་བས་མ་མོ་ཌཱ་ཀི་སྤྲལ་སྐྱམཉེས་པར་འགྲོ་གསུང་ངོ།",
    "དེ་ལ་ཤ་ཁྲག་གི་གཏོར་མ་དང་ཚོགས་ཀྱི་ལོངས་སྤྱོད་ཀྱིས་མཉེས་ཏེ།",
    "དཔའ་བོ་དཔའ་མོ་གླུ་གར་གྱིས་ཚིམ་པར་བྱ།",
    "དེས་དམ་ཚིག་ཕྲ་རགས་ཐམས་ཅད་བཤགས་པར་ཡང་འགྲོ་ཉམས་མྱོང་གི་བསྐྱེད་འདོན་པར་འགྲོ་སྟེ་ཚོགས་ཀྱི་ལོངས་སྤྱོད་ཀྱིས་ནང་གི་ཌཱ་ཀི་རྩ་རྣམས་མཉེས་ནས་ཏིང་ངེ་འཛིན་སྐྱེ་བས་སོ།",
    "ཧྲིལ་གྱིས་བསྡུས་ན་ཌཱ་ཀི་མ་ལྔ་རང་ཡང་རྣལ་འབྱོར་པ་རང་ལ་ཚང་བས་རང་གི་ཏིང་ངེ་འཛིན་ཚུལ་བཞིན་བསྒོམས་པས་ཉམས་སྐྱེས་ན་ཌཱ་ཀི་ལྔ་ཆར་མཉེས་པར་འགྲོ་རཏྣ་གསུང་ངོ།",
    "དེ་ཁོ་ནའི་པཱུ་ཙ་ཕག་མོ་ལ་སོགས་པ་རང་གི་ལྷ་གང་ཡིན་གྱི་ཡུམ་གྱིས་མཆོད།",
    "གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པས་མེ་ཏོག་གི་ཆར་ལ་སོགས་པ་འབེབས།",
    "སེར་སྣ་དང་ཚོར་བའི་ཕུང་པོ་དག་རིན་འབྱུང་དང་མཉམ་ཉིད་ཀྱི་ཡེ་ཤེས་སུ་བྱིན་གྱིས་བརླབས་པའོ།",
    "རྡོ་རྗེ་འདི་ནི་ཁྱོད་ཀྱིས་ལོང་།",
    "ཉོན་མོངས་པ་ཕྲག་དོག་གི་དྲི་མ་མཛོད་དག་འདུ་བྱེད་ཀྱི་ཕུང་པོ་གནས་གྱུར་པས་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་དང་དོན་གྲུབ་ཏུ་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཉོན་མོངས་པ་དང་ཕུང་པོ་མཐའ་དག་དག་རིགས་དྲུག་པ་དང་དབྱིངས་དང་ཡེ་ཤེས་དབྱེར་མེད་པར་བྱིན་གྱིས་བརླབས་སོ།",
    "འཁོར་ལྷ་མོ་བརྒྱད་ལ་ཡང་མི་བསྐྱོད་པས་དབུ་བརྒྱན་པར་བསམ།",
    "དེའང་མགྲིན་པ་ནས་བཟུང་སྟེ་ལུས་ཐམས་ཅད་ལ་ཁྱབ་པས་གསལ་སྟོང་ཟུང་འཇུག་གི་ཏིང་ངེ་འཛིན་སྐྱེ་ཞིང་།",
    "བདག་ཐུགས་རྡོ་རྗེ་མི་བསྐྱོད་པ་ལྟ་བུ་ཡིན་ན་མི་བསྐྱོད་པའི་ཡུམ་ལས་ཡུམ་མཱ་མ་ཀཱི་གཅིག་བྱེ་ནས་བདག་གི་ཡུམ་མཱ་མ་ཀཱི་ལ་ཐིམ་སྟེ།",
    "དགའ་སྟེར་གནས་སྟེར་ལྷ་མོ་འདི།",
    "བཞི་པ་ལམ་ལ་སོགས་པ་རྒྱུ་དུས་སུ་གང་ཐོབ་པ་དེ་འདིར་ཡང་ཐོབ་པར་མོས་པ་བྱའོ།",
    "དྲི་མ་བཞི་དག་པར་མོས་པ་བྱའོ།",
    "གསུམ་པ་ནི་རང་གིས་བསྒོམས་པས་ཉམས་མྱོང་སྐྱེས་པའོ།",
    "དེའང་དཔེར་ན་རྡོ་རྗེ་གདན་དུ་འགྲོ་བ་ལ་ལམ་རྒྱུས་ཅན་གཅིག་གིས་འདི་སྐད་བྱ་བ་ནས་འདི་སྐད་བྱ་བའི་བར་དུ་འཇིགས་པ་ཡོད་པས་སྐྱེལ་མ་དགོས།",
    "གཏི་མུག་ཡེ་ཤེས་བྱོལ་སོང་ཉིད།",
    "དེ་ལ་སྤྱིར་གཞུང་གདམས་ངག་གི་གོ་བ་ནི་འགོས་ཁུག་པས་ཚིག་ཉུང་ངུས་དོན་རྒྱས་པར་གོ་བས་ན་གདམས་ངག་སྟེ།",
    "སློབ་དཔོན་མཛོད་འདིས་རྡོ་རྗེ་ཚིག་རྐང་གི་གཞུང་དུ་བཀོད་པའི་གདམས་ངག་དྲུག་ལས།",
    "དེའང་རྒྱུ་དང་རང་གི་ངོ་བོ་དང་འབྲས་བུ་དང་བྲལ་བ་ཡིས་དཔྱད་ན་སྤྲོས་པའི་མཐའ་བཞི་དང་བྲལ་བའི་ཕྱིར་རང་བཞིན་མེད་པར་གཏན་ལ་ཕེབས་ཏེ།",
    "དེའི་མིང་གི་རྣམ་གྲངས་དོན་རང་གི་མཚན་ཉིད་རང་གིས་ཉམས་སུ་མྱོང་བ་མེད་ཀྱང་འདི་ལྟ་བུ་ཞིག་ཡིན་སྙམ་ནས་མོས་པ་བྱས་པས་མོས་པའམ་གོ་ཡུལ་དུ་བྱེད་པའི་ལྟ་བ་ཞེས་བྱའོ།",
    "དེ་ཐམས་ཅད་ལ་རང་རང་ལ་ལུང་རེ་རེ་དང་རིགས་པ་རེ་རེ་གཟུང་ནས་ངའི་འདི་ཁོ་ན་ལྟར་ཡིན་ཟེར་བས་ན་སོ་སོའི་གཞུང་ལུགས་ལ་ཞེ་འདོད་ཀྱི་ལྟ་བ་ཞེས་བྱ་སྟེ།",
    "དེའང་སྒྲུབ་པ་པོ་ལ་འཆིང་བྱེད་གཉིས་ལས་མ་རིག་པའི་དུག་གི་གཉེན་པོར་ཐོས་བསམ་གྱིས་སྒྲོ་འདོགས་ཆོད་པའི་ལྟ་བ་དེས་འགྲོ་མཛོད་ཡང་རྣམ་པར་རྟོག་པའི་རྩོལ་བའི་དུག་ད་ལྟ་དགའ་དང་མི་དགའ་བའི་རྣམ་པར་རྟོག་པ་རྒྱུན་ཆགས་ཀྱི་གཉེན་པོར་མི་འགྲོ་སྟེ།",
    "ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས།",
    "ཉོན་མོངས་རྣམ་པར་འཇོམས་པར་ཤེས་བྱས་ལ།",
    "དེ་ཉིད་ལ་མིང་གི་རྣམ་གྲངས་ཡིད་འདག་པའི་རྣམ་རྟོག་ཅེས་ཀྱང་བྱའོ།",
    "ཉོན་མོངས་པ་ལ་སོགས་པ་སེམས་ཉམས་སམ།",
    "དེ་ཡང་མིག་གིས་ལྷ་ཁང་ངམ་འབག་གམ་རྒྱ་རྟའམ་སེང་གེ་ལ་སོགས་པ་བལྟ་བ་ནས་གཟུང་སྟེ།",
    "ལུས་ཀྱིས་རེག་བྱ་འཇམ་པོ་མ་ལ་རེག་པའི་བར་དུ་ཡུལ་ལྔ་སྐྱེ་མེད་སྟོང་པར་ཤེས་པར་བྱས་ལ་ཐ་མལ་དུ་ལོངས་སྤྱད་པས་ཤེས་པ་ཡུལ་གྱིས་ཚིམ་ནས་ཡུལ་དེ་ཉིད་ཀྱི་སྟེང་དུ་ཤེས་པ་ལྷན་གྱིས་གནས་པའམ།",
    "དེ་རིང་ལྟ་བུ་འབག་གམ་རྒྱ་རྟ་ལ་བལྟས་པ་ཡོད་ན་དེ་ལྟ་བུ་དེ་ཡིད་ཀྱི་ཡུལ་དུཨཱ་། བྱུང་ནས་དེ་ལ་ཤེས་པ་གནས་ནའང་གཞན་ཐམས་ཅད་འཕྲོ་བར་བྱེད་པ་ལ་རྣམ་རྟོག་སྔོན་དུ་སོང་བའི་དྲོད་ཅེས་པ་ཞི་གནས་དང་པོར་བཞེད་དོ།",
    "དེ་ཡང་མིག་ངོ་མཚར་ཅན་གྱི་ལྟད་མོ་སྣ་ཚོགས་ལྟ་བ་ནས་རེག་བྱའི་བར་དུ་ཡུལ་སྣ་ཚོགས་ཀྱི་བདུད་རྩི་བསྟེན་པས་ཡུལ་ཡེ་ནས་དག་པ་རྟོག་མེད་དེ་ལ་ཤེས་པ་རྟོག་མེད་དུ་ཐིམ་ནསགང་ལ་བལྟས་ཀྱང་བདེ་སྟོང་དུ་སྐྱེ་སྟེ།",
    "དེ་བས་ན་ཡུལ་སྐྱེ་མེད་སྟོང་པར་ལ་དོར་ཞིང་ཤེས་པ་ཡུལ་སྟེང་དུ་གནས་པ་དེ་ཡང་ཏིང་ངེ་འཛིན་ཡིན་པར་ངོ་ཤེས་པར་བྱས་ལ་བྱུང་རྒྱལ་དུ་བཏང་བས་ཏིང་ངེ་འཛིན་རྣམ་རྟོག་སྔོན་དུ་སོང་བའི་དྲོད་དུ་འགྱུར་ཞིང་དེས་དུག་ཐོན་པར་འགྱུར་རོ།",
    "མཛོད་ལྟ་བའི་གསུམ་བསྟན་ཏོ། ། དེ་ལྟར་ལྟ་བའི་གསུམ་གྱིས་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པའི་གཉེན་པོ་ཞི་གནས་དང་པོའི་རོ་རྙེད་ནས།",
    "ཙཎྜ་ལཱི་ལ་བརྟེན་ནས་རང་བྱུང་སྐྱེ་བ་ལ་ཉོན་མོངས་རྣམ་རྟོག་སྣྲེལ་ཞི་གསུམ་སྐྱོན་ཅན་ཏེ།",
    "དེ་རྣམས་ཐ་མལ་པའི་ཉོན་མོངས་པ་དང་ཁྱད་པར་དབྱེ་བར་དཀའ་བས་ན་དེ་ཉིད་སྤང་བྱའི་གཉེན་པོར་མི་འགྱུར་བས་སོ།",
    "སྐྱོན་ཅན་བརྒྱད་པོ་དེ་བྱུང་ན་ལྷག་མཐོང་གི་དུག་ཡིན་པས་དེ་འབྱིན་པ་ནི།",
    "རང་བྱུང་ལ་རང་བྱུང་གི་ཡེ་ཤེས་ཆེན་པོ་གསལ་སྟོང་ཟུང་འཇུག་འགལ་འདུས་སྐྱོན་མེད།",
    "སྐྱོན་སེལ་བར་བྱེད་པ་གཉིས་ཏེ་གསུམ་མོ།",
    "རང་གི་ཞག་གསུམ་བཞིའི་གོང་ནས་ཤ་རུལ་སུམས་ལ་སོགས་པ་རྩུབ་པའི་ཟས་མ་ཟོས་པའི་དྲི་ཆེན་སྔ་དྲོ་གཏང་ལ་བདུན་ཉིན་ཁུག་ཏུ་བསྐམ་ཏེ་ཉི་མ་གཅིག་གིས་མ་བསྐམ་ན་ནུས་པ་ཤོར་བ་ཡིན་གསུང་།",
    "གཡས་ཀྱི་གཅིག་རྒྱབ་ཏུ་སོང་བས་བཞི་མཉམ་འཕེན་ཞིང་འཛིན་པར་བྱེད་པའི་རྩའོ།",
    "གཅིག་གཡོན་དུ་སོང་བས་ག་བུར་འཕེན་ཞིང་འཛིན་པར་བྱེད་པའི་རྩའོ།",
    "གཡོན་གྱི་གཅིག་མདུན་དུ་སོང་བས་གླ་རྩི་འཕེན་ཞིང་འཛིན་པར་བྱེད་པའི་རྩའོ།",
    "གཅིག་གཡས་སུ་སོང་བས་རཀྟ་སིཧྥ་འཕེན་ཞིང་འཛིན་པར་བྱེད་པའི་རྩའོ།",
    "མི་གཡོ་བ་གཉིས་ཏེ་གསང་གནས་ན་མ་ལས་ཐོབ་པའི་རཀྟ་གནས་པ་དེ་འདོད་ཆགས་སྐྱེས་པའམ་འགྲོ་ལས་པའམ་སྙོམས་འཇུག་གི་དུས་སུ་བག་ཙམ་གཡོ་སྟེ།",
    "ཕ་ལས་ཐོབ་པའི་ཆས་རུས་པ་དང་རྐང་དང་སེན་མོ་རྣམས་བསྐྱེད་ནས།",
    "ལག་པ་གཉིས་ཀ་ལ་ལག་མགོ་དང་འབྲེལ་བ་གྲུ་མོ་དང་འབྲེལ་བ་དཔུང་པ་དང་འབྲེལ་བས་ཏེ་གསུམ་གསུམ་དྲུག་རྐང་པ་གཉིས་ལ་ཡང་དེ་བཞིན་དུ་དྲུག་སྟེ་བཅུ་གཉིས་གནས་པ་ལ་དེ་ཐམས་ཅད་འཁོར་ལོ་རྩིབས་སུམ་ཅུ་སོ་གཅིག་པ་རེ་རེ་གནས་ཏེ།",
    "ས་ཐོག་མཐའ་ལ་རེ་རེ་གསུམ་པ་བཅུས་བར་གྱི་རྩ་མདུད་དྲལ་བས་ལ་དོར་ཞེས་པ་སྟེ།",
    "དེ་བཞིན་དུ་ས་བཅུ་གཉིས་པ་ལ་མདུད་པ་གཅིག་དྲལ་ཏེ་དེ་ལ་དོར་ཏེ་དེ་བས་ན་ས་ཐོག་མཐའ་ལ་རེ་རེ་ཞེས་སོ།",
    "ཚིག་གི་བརྒྱུད་པ།",
    "གདམས་ངག་གི་སརྒ་མ་ལོག་པ།",
    "མོས་གུས་ཀྱིས་བསམ་པ་ཚིམ་པར་ནུས་པའོ།",
    "ཕྱི་ནང་གི་སྲིན་བུ་སྤང་བར་གཞུང་ནུས་བརྗེད་སྐྱེན་དྲན་སྐྱེན།",
    "མོས་གུས་ཀྱིས་བསམ་པ་ཚིམ་པར་ནུས་པ་ནི།",
    "དེ་ལ་གཞུང་ཚོམ་བུ་གཅད་ན་བདུན་ཏེ།",
    "དེ་འབྲས་བུ་མངོན་སུམ་དུ་གྱུར་པ་ནི་ངོ་བོ་ཉིད་ཀྱི་སྐུ་ཤིན་ཏུ་རྣམ་དག་གི་སྐུར་འགྱུར་བའོ།",
    "དེ་གསུམ་ལ་དྲོད་གསུམ་གྱི་བྱེ་བྲག་གིས་དགུར་ཡང་འགྱུར་རོ།",
    "དེའང་ས་བཅུ་གཅིག་པོ་དེ་ལ་ས་རེ་རེ་ལ་ཕྱི་རྟགས་ཐིག་ལེ་ལ་འཆར་བ་མི་བསླུ།",
    "རྣལ་འབྱོར་པ་ཐུན་མོང་དུ་བསྲུང་བ་བཅུ་བཞི་སྟེ་འཇིག་རྟེན་པའི་ལམ་མན་ཆད་དུ་བསྲུང་བ་སུམ་ཅུ་ཐམ་པས་བསྲུང་བ་ཡིན་ནོ།",
    "མོས་པའམ་འཇུག་པས་ཐབས་ཀྱིཕྱོགས་སུ་ལྷུང་བ་དང་།",
    "དང་པོ་ནི་བསྐྱེད་པའི་རིམ་པ་དང་དེའི་ཆ་ལག་བཟླས་པ་དང་གཏོར་མ་སྦྱིན་སྲེག་ལ་སོགས་པ་ལ་མོས་ཤིང་ཞུགས་པའོ།",
    "མོས་པའམ་འཇུག་པས་ལྷུང་བ་ཙམ་དང་།",
    "དེ་ནས་བསམ་གཏན་གྱི་ཡན་ལག་དགུ་སྔོན་དུ་སོང་བས་ཉམས་རྒྱུད་ལ་སྐྱེས་པ་དང་ཚིག་གི་སྒྲོ་འདོགས་བཅད་ནས།",
    "དམ་བཅའ་བརྟན་པོ་མ་མཛད་པར་བདག་ཅག་རྣམས་ཀྱི་དོན་དུ་འདི་ཀུན་རང་དུ་བཞུགས་ལ་དགེ་སྦྱོར་མཛད་པར་ཞུ་ཟེར་འདུ་ཤེས་བསྒྱུར་ནས་བར་ཆད་བྱེད་ན་དེ་ལ་ཟང་ཟིང་གི་སྦྱིན་པ་སྔོན་དུ་འགྲོ་བའི་དད་པ་བརྟན་པོས་བསྲུངབ་ནི།",
    "དེ་རྣམས་ལ་ཟང་ཟིང་གི་སྦྱིན་པ་ཕྲ་མོ་བྱིན་ལ་ཁྱེད་རྣམས་ཀྱང་ངས་བློས་མི་འདོར་ཏེ་དོན་བྱེད་བྱས་ཏེ་བློ་ལ་རང་གི་དད་པ་བརྟན་པོས་མི་འགྱུར་བར་བྱས་ལ་བསྲུང་།",
    "མི་ནུས་དེ་ལ་ཚིག་གིས་སྦྱངས།",
    "ནང་གི་བདུད་དོ།",
    "དམན་པ་དང་མཆོག་གི་སིདྡྷི་སྒྲབ་པའི་གྲོགས་བྱེད་ལ།",
    "ཁོ་རང་གིས་དེ་ལྟར་མ་ནུས་ན་གཞན་ལྷ་འདྲེ་ཆེན་པོ་དང་དབྱེན་བྱེད་དེ།",
    "དེ་བསྲུང་བ་ནི་རྡོ་རྗེའི་རྭ་བ་དང་གུར་དང་བླ་རེ་དང་མདའི་དྲྭ་བ་དང་མེ་རི་ལ་སོགས་པ་བསྲུང་བའི་འཁོར་ལོ།",
    "ད་ནི་སེམས་ཅུང་ཟད་བརྟན་པའི་དུས་སུ་བདུད་སྟོབས་འཕེལ་བ་སྟེ་ནང་གི་བདུད་ཀྱིས་ས་མ་ཏི་འཕྲོག་པ་ལ་སོགས་པའི་བར་ཆད་བྱེད་དེ།",
    "སྔགས་ཟློས་ཀྱིས་ཀྱང་མི་ཐུབ་སྟེ་ཐབས་གཅིག་ཙམ་ཞིག་གིས་དེ་ལས་བསྲུང་བ་ནི།",
    "དེ་ཡང་སྔར་ཁམས་འདུས་པ་དང་པོ་ལ་ནི་ས་མ་ཏི་མ་བརྟན་པས་དེ་རྣམས་མི་སྐྱེ་ལ་འདིར་ནི་ཁམས་འདུས་པ་བར་པར་སོང་བས་ཏིང་ངེ་འཛིན་བརྟན་པས་དེ་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་སྐྱེ་བས་དེ་བསྲུངགཞུང་བའོ།",
    "དེ་དག་གིས་ནི་ཁམས་འདུས་པ་བར་པ་ལ་ནང་གི་བདུད་ཀྱིས་ཏིང་ངེ་འཛིན་འཕྲོག་པའི་བར་ཆད་ལས་བསྲུང་བ་སྟེ་ཐབས་ཀྱི་ཕྱོགས་སུ་ལྷུང་བའི་རྣལ་འབྱོར་པ་ལ་ཤེས་རབ་ཀྱི་བསྲུང་བ་དགོས་པའི་དུས་ཞེས་བྱའོ།",
    "ད་ནི་ཁམས་འདུས་པ་ཐ་མར་སོང་བས་མཉེན་ལྕུག་བཞི་ཡང་རིམ་གྱིས་འཆར་ཏེ།",
    "ཕྱིའི་དབྱིབས་ཀྱི་ཨ་སྲིད་པ་མོ་རྒྱུད་ཀྱི་གནས་དེར་འདུས་ན་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་བུད་མེད་དང་ཌཱ་ཀི་མ་ཐམས་ཅད་ཀྱིས་ཆོ་ངེས་འདེབས་པ་དང་ཀུ་ཅོའི་སྒྲ་ཆེན་པོ་འདོན་པ་དང་ངུ་བ་ལ་སོགས་པ་དང་།",
    "ཕྱིའི་བདུད་དང་ནང་གི་བདུད་ཀྱི་གོ་བ་ནི་སྔ་མ་དང་འདྲའོ།",
    "ཡུལ་ཆེ་གེ་མོ་ན་བུ་མོ་པདྨ་ཅན་ཆེ་གེ་མོ་ཞེས་བྱ་བ་ཡོད་པས་དེ་ལོངས་ལ་མཆོག་གི་སིདྡྷི་མངོན་དུ་གྱིས་ཞེས་པ་ལ་སོགས་པ་ལུང་སྟོན་དུ་བྱུངན་ཁམས་འདུས་པ་ཐ་མ་ལ་མ་མོ་མཁའ་འགྲོས་དངོས་སུ་ལུང་སྟོན་པ་ཡིན་པས།",
    "སྔགས་ཀྱི་ལད་མོ་ཡང་མི་ཟློས་ལུང་ཡང་མི་སྟོན་དེ་ཡང་མེད་ནས་སོང་ན་ཁམས་འདུས་པ་བར་པར་ཐོས་སྣང་བརྟན་པ་ཡིན་ཏེ།",
    "དེ་རང་ཡང་རེས་འབྱུང་རེས་མི་འབྱུང་ན་ཁམས་འདུས་པ་བར་པ་ལ་མཐོང་སྣང་བརྟན་པ་ཡིན་པས་ཏིང་ངེ་འཛིན་དུ་ངོ་ཤེས་པར་བྱས་ལ་བྱུང་རྒྱལ་དུ་གཏང་ངོ།",
    "ད་ནི་ནང་གི་བདུད་ཀྱི་བར་ཆད་ནི།",
    "ཡན་ལག་གི་བརྡ་དང་ངག་གི་བརྡའོ།",
    "ཡན་ལག་གི་བརྡ་དང་ལུས་བརྡ་གཉིས་སུ་འོང་བ་ནི་འདི་ཤིན་ཏུ་གལ་ཆེ་བས་གཅེས་སྤྲས་སུ་བྱ་བའི་དོན་དུ་གང་རུང་གཅིག་ནུབ་ཀྱང་གཅིག་ཐེབ་ཆག་ཏུ་བྱས་པ་ཡིན་གྱི་ད་ལྟར་གང་རུང་ཞིག་གིས་ཆོག་གསུང་ངོ།",
    "ལྔ་བསྡུས་རྩེ་མོ་མནན་པ་དང་།",
    "མཐེབ་སྲིན་ཨེ་ལ་རེག་བྱེད་ཅིང་།",
    "མཛུབ་མོ་ནམ་མཁའ་མཚོན་པའོ།",
    "ནང་གི་བདུད་ཕྲ་མོ་ཡིན་ན་དེ་རང་ལ་ཡང་རྡུགས་པ་ཡང་སྲིད།",
    "དེ་ཙམ་ལ་རྡུགས་ན་བགེགས་ཕྲ་མོ་ཡིན།",
    "གསུམ་པའི་བརྡ་ལག་པ་གཡས་པའི་ཁུ་ཚུར་གྱི་ནང་དུ་གཡོན་པའི་མཛུབ་མོ་བསྒྲེངས་པ་བཅུག་ལ་གོང་ལྟར་བསྟན་ཅིང་འདི་ཅི་ཡིན་ཞེས་ཡིད་ཀྱིས་དྲི།",
    "དེ་ལ་རྡུགས་ན་བགེགས་ཕྲ་མོ་ཡིན།",
    "བཞི་པའི་བརྡ་གཡོན་པའི་མཛུབ་མོསམདུན་གྱི་ནམ་མཁའ་ལ་བསྐོར་ཞིང་འདི་ཅི་ཡིན་ཡིད་ཀྱིས་དྲི་དེ་ལ་རྡུགས་ན་བགེགས་ཡིན།",
    "ཡན་ལག་གི་བརྡ་ནི།",
    "སོར་མོ་ལྔ་པོ་བཀྲམ་སྟེ་བསྟན།",
    "མཛུབ་མོ་ནམ་མཁའ་མཚོན་པའོ།",
    "ངག་གི་བརྡ་ནི།",
    "རྣམ་བཞིར་ཤེས་བྱས་ནས་ཞེས་པ་རེ་རེ་ལ་ཡང་ཡི་གེ་བཞི་བཞིའོ།",
    "བར་ཆད་ནི་ནང་གི་བདུད་ཀྱི་བར་ཆད་དོ།",
    "དེ་དག་གིས་ནི་ཐབས་ཤེས་རབ་ཀྱི་ཕྱོགས་སུ་ལྷུང་བའི་རྣལ་འབྱོར་པ་ལ་བར་ཆད་བཞི་བཞི་ལ་བསྲུང་བ་བརྒྱད་བརྒྱད་བཅུ་དྲུག་ཏུ་བསྟན་ཏོ།",
    "ད་ནི་རྣལ་འབྱོར་པ་ཐུན་མོང་དུ་བསྲུང་བ་བཅུ་བཞི་བསྟན་པ།",
    "རྣལ་འབྱོར་པ་ལ་ཡུལ་སྣང་སྟོང་ཟུང་འཇུག་ཤེས་པ་གསལ་སྟོང་ཟུང་འཇུག་ལུས་བདེ་། སྟོང་ཟུང་འཇུག་གི་ཏིང་ངེ་འཛིན་སྐྱེ་ཡང་འཇིག་རྟེན་པའི་ལམ་མན་ཆད་དུ་བར་ཆད་དང་མ་བྲལ་བས་བསྲུང་བ་དགོས།",
    "དེ་ལ་གྲིབ་མ་ནི་དྲུག་སྟེ་དམ་ཚིག་གི་གྲིབ་མ་དང་།",
    "རིགས་སམ་རུས་སམ་དམ་ཚིག་གི་འབྲེལ་པ་མ་ཡིན་པའི་རོ་ལ་འཇུ་བའམ་བཞག་པའི་སར་བསྡད་པ་ལས་འོང་བས་དེ་རྣམས་ལས་བུ་ཆུང་སྲེའུའམ་མགོ་ཆག་༣། ཚབས་པོ་ཆེ་ལྟར་ཤིན་ཏུ་འཛེམས་པར་བྱའོ།",
    "ཡང་གྲིབ་མ་དྲུག་པོ་རེ་རེ་ལ་ཡང་ཆེ་འབྲིང་གསུམ་གསུམ་སྟེ་བཅོ་བརྒྱད་དུའང་འགྱུར་གསུང་།",
    "དེ་ཡང་དེ་རིང་ལྟ་བུ་མཉམ་གཞག་གི་ཉམས་ལ་འོང་བ་དང་།",
    "དོ་ནུབ་རྨི་ལམ་དུ་འོང་བ་མཐུན་པར་བྱུང་ན་བཟང་པོར་སོང་བ་ཡིན་གསུང་སྟེ།",
    "དང་པོ་དམ་ཚིག་གི་གྲིབ་མས་གོས་པའམ་འགོས་ན་རང་གོས་ནག་པོ་གྱོན་པའམ་ལུས་ལ་མི་གཙང་བ་ལ་སོགས་པས་གོས་པའམ་འདམ་གྱིས་བྱུགས་པའམ་ལུས་ལ་འབུ་ཞུགས་པ་ལ་སོགས་པ་འབྱུང་།",
    "གསུམ་པ་ལ་རང་གི་གྲོགས་དམ་པ་གཅིག་གི་ལུས་ལ་མི་གཙང་བའམ་འདམ་རྫབ་འབུ་ལ་སོགས་པ་གོས་ནས་དེ་བདག་ལའང་འགོ་ཞིང་འོང་།",
    "བཞི་པ་ལ་མིས་ཟས་བྱིན་པ་ལ་ཟས་ཕྱེད་ཐལ་བའམ་མེ་འབར་བའམ་འབུ་ལ་སོགས་པར་སོང་ནས་བཟར་མི་བཏུབ་པ་འབྱུང་ངོ།",
    "འབྲིང་གིས་ལུས་སེམས་སྡུག་བསྔལ་བསྐྱེད་ཅིང་ཏིང་ངེ་འཛིན་འཕྲོག་པར་བྱེད།",
    "འབྲིང་ཚོགས་ཀྱིས་སེལ་ཏེ།",
    "དེ་ལ་རྗེ་འཁོར་ལོ་བདེ་མཆོག་གི་རྣལ་འབྱོར་པ་ཡིན་ན་ཡར་ངོ་མར་ངོའི་ཚེས་བཅུ་གཉིས་སམ།",
    "དེ་གཉིས་ཀྱི་བར་དུ་འབྲུ་ལྔ་ལས་ས་བོན་ཧཱུྃ་དེ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པར་བསམ།",
    "བདག་གི་ཞལ་ནས་སྔགས་ཀྱི་འོད་ཟེར་གཟུངས་ཐག་ལ་འཁྲིལ་ནས་སོང་།",
    "བུམ་པའི་ནང་དུ་བླུགས་པས་མི་བསྐྱོད་པ་ཡབ་ཡུམ་ལ་ཕོག་པས་དེ་ཞུ་ནས་བུམ་ཆུ་ལ་ཐིམ་པ་ལས་གཞན་གྱི་ལུགས་ཀྱིས་ཆུ་ཉིད་མི་བསྐྱོད་པའི་རང་བཞིན་དུ་བསམ་པ་ཡིན་པ་ལས་འདིར་ཆུའི་རྡུལ་ཕྲ་རབ་ཐམས་ཅད་མི་བསྐྱོད་པ་ཕྲ་མོ་ཡིན་གསུང་ངོ།",
    "གདོན་གྱི་གྲིབ་མ་འབྲིང་ལ་སྔར་གྱི་རྫས་བཞིའི་དོད་དུ་རྒྱས་པའི་སྦྱིན་སྲེག་གི་ཐལ་བས་། བྱ།",
    "དེ་ཡང་རྡོ་རྗེ་སྤན་གྲོགས་ལ་སོགས་པ་ལ་མཎྜལ་རེ་བྱས་ལ་བདག་ལ་གྲིབ་འདི་ལྟ་བུ་ཞིག་བྱུང་བས་འདི་བསལ་བའི་དོན་དུ་སཱཙྪ་གདབ་པར་ཞུ་བྱས་ལ།",
    "ངག་གི་སྨྲེ་བཤགས་ཀྱིས་སེལ་ཏེ།",
    "གྲོགས་ཚངས་པར་མཚུངས་པར་སྤྱོད་པ་རྣམས་བསགས་ལ་དེ་རྣམས་ལ་མཎྜལ་རེ་ཕུལ་ལ་བདག་ལ་གྲིབ་འདི་ལྟ་བུ་ཞིག་བྱུང་བས་འདི་བསལ་བའི་དོན་དུ་ཡི་གེ་བརྒྱ་པ་འདོན་པར་ཞུ་ཞེས་གསོལ་བ་བཏབ་སྟེ་བཏོན་པས་ཀྱང་སེལ་ལོ།",
    "གཉིས་པ་ལ་གཉིས་ལས་གདོན་གྱིས་འཛག་པ་ནི་རྨི་ལམ་དུ་བུད་མེད་དང་འཕྲད་པའམ་ཁྱིས་བདས་པའམ་གཡང་ལ་ལྷང་བ་རྨིས་པས་རྨི་ལམ་དུ་ཚོར་བར་འཛག་པ་སྟེ།",
    "གཉིས་པ་བག་ཆགས་ཀྱིས་རྨི་ལམ་དུ་འཛག་པ་ནི་སྔར་གྱི་རྩེ་བ་ལ་སོགས་པའི་བུད་མེད་ལ་སོགས་པ་དང་རྩེས་པར་རྨིས་པས་རྨི་ལམ་དུ་འཛག་པ་དང་དེ་ཡང་ཚོར་བར་འཛག་པའོ།",
    "དེས་བསྲུང་བར་མ་ནུས་ན་ལམ་བསྡུས་པའི་ལུས་ངག་གི་འགྱུར་བ་༣། གསུམ་དང་གཅིག་གིས།",
    "དེས་ཀྱང་བསྲུང་བར་མ་ནུས་ན་དུད་འགྲོའི་འགྱུར་བ་བཞིས་བསྲུང་སྟེ་འདིའི་བསྲུང་ཐབས་བཞི་པ་དང་ཐུན་མོང་དུའང་འོང་ངོ།",
    "ཡུངས་ཀར་བསྲེགས་པའི་ཐལ་བ།",
    "དེ་ཡང་ལྕགས་ཀོང་བསྲེགས་པའི་ནང་དུ་ཡུངས་ཀར་མཉེ་སྟེ་སྣུམ་ལྡོག་གིས་སོང་བ་དང་གུ་གུལ་བླུགས་ཏེ་ཞུ་བ་དང་ཕོག་ནས་ཚ་བའི་ངད་ཡལ་བ་དང་མིའི་ཀླད་པ་པདྨའི་རཀྟ་གཉིས་བླུགས་ལ་རི་ལུ་སྲན་མ་ཆུང་རིགས་ཙམ་དུ་བྱས་ལ་དེ་རང་གི་ལག་མཐིལ་དུ་རང་གི་མཆིལ་མའམ་ཆང་དང་སྦྱར་ཏེ་མཛུབ་མོ་ལ་བསྐུས་ལ་དང་པོ་གསང་གནས་ནས་བསྐུ།",
    "དེ་ནས་ལྟེ་བ་ནས་མཛུབ་མོ་གཉིས་ཀྱིས་དྲངས་ནས་རྒྱབ་ཏུ་སྤྲད་དོ།",
    "དེས་ཀྱང་བསྲུང་བར་མ་ནུས་ན་བྱ་བའི་རྒྱུད་དང་ཐུན་མོང་བས་བསྲུང་བ་ནི།",
    "ལེ་བརྒནནམ་རྒྱ་སྐྱེགས་ཀྱི་རྩིའམ་གུར་གུམ་དུ་བཙོས་ལ་མདུད་པ་གཉིས་བསྐོར་བ་བདུན་བྱས་ཏེ་ཧཱུཾ་བདུན་ཡིན་ཡང་གསུང་མོས་ཀྱང་གསུང་།",
    "འདིས་ནི་སྒྲུབ་གཞུང་པ་པོ་དག་གི།",
    "བག་ཆགས་ཀྱིས་འཛག་པ་ལ་གང་ལ་ཆགས་པའི་བུད་མེད་དེའི་དྲི་མ་ཕུར་མ་བྱས་ལ་སྐེའམ་མཆན་ཁུང་ངམ་ག་ཤར་བཏགས་པས་བསྲུང་ངོ།",
    "གོས་ལ་ཡང་གཏུམ་མོ།",
    "གསུམ་ཆར་མ་རྙེད་ན་པི་པི་ལིང་གི་གམ་ཕྱེ་ལྟོ་སྟོང་ལ་གཏང་།",
    "དེས་མ་ཞི་ན་ལངས་ཏེ་གྲུ་མོས་སླེབས་པའི་ས་གཡས་གཡོན་གཉིས་ཆར་དུ་ཁྲམ་བྱས་ལ་༥། དེར་སྦྲ་རྡོག་ཆུང་ངུ་ལྔ་ལྔའམ་བདུན་གདབ།",
    "བཞི་པ་ནི་འགྱུར་བ་རྣམ་དྲུག་གིས་བསྲུང་ངོ།",
    "དེ་ཉིད་འཇུག་པ་སེལ་བ་སོགས་ཉམས་བཅོ་ལྔ་པོ་གང་རུང་ཞིག་གིས་སེལ་བས་སྤང་སླའོ།",
    "དེ་ཙམ་ན་ཐིག་ལེ་གཅིག་གི་ནང་དུ་ཡང་ལོངས་སྐུའི་ཞིང་ཁམས་རབ་བཀྲམ་ལ་སོགས་པ་མཐོང་བ་འབྱུང་།",
    "ཁམས་འདུས་པ་ཐ་མ་ལ་ཤིན་ཏུ་ངེས་པ་གསལ་སྣང་དུ་འཆར་བས་ལམ་ཁྲིད་དེ་མིག་གིས་གཟུགས་ཉེ་རིང་མེད་པར་མཐོང་བ་ལ་སོགས་པ་རྗེས་སུ་དྲན་པ་དྲུག་འབྱུང་ངོ།",
    "ལྟེ་བར་ཡི་གེའི་ཕྱི་མོ་བརྒྱད་དང་ཨཱ་ལི་ཀཱ་ལི་མཐོང་ནས།",
    "དཔེར་ན་རང་གི་མཛུབ་མོའི་རྩེ་མོ་ལ་དུག་སྦྲལ་གྱི་དབྱིབས་སྒོམ་ནས་བྱང་སེམས་དྲང་ན་དེ་ཁོ་ན་ལྟར་འགྱུར་རོ།",
    "དབྱིབས་ཐིམ་པས་ཨ་ཧཾ་མི་ཐི་ཟུང་འཇུག་སྟོབས་བཞི་ཐིམ་པས་བདུད་བཞི་ཟིལ་གྱིས་གནོན་པ་ཧཱྃ་གི་སྟོབས་ལྟ་བུར་འགྱུར་རོ། ། ད་ནི་ལུང་སྒོ་བསྟན་ནས་ལམ་བགྲོད་ལུགས་གཉིས་ནི།",
    "ལས་འཕྲོ་དང་མོས་གུས་ཀྱང་ཚོགས་ལམ་དུ་འགྲོ་སྟེ།",
    "སྦྱོར་ལམ་ལ་རྣམ་རྟོག་སྔོན་དུ་སོང་བ་ལ་སོགས་པའི་དྲོད་གསུམ།",
    "སེམས་ལ་འཆར་བའི་མཐོང་ལམ་མོ།",
    "དེ་ནས་རྟགས་སུམ་ཕྲག་བཅུ་གཅིག་གིས་སྒོམ་ལམ་མོ།",
    "ཡན་ལག་གི་དོན་བསྟན་པ་ལ་གཉིས།",
    "གཞུང་ཚོམ་བུ་བཅད་པ་དང་།",
    "རེ་དོགས་དང་བྲལ་བའི་ལམ་དང་།",
    "དྲན་པ་ཉེར་གཞག་གི་ལམ་བསྟན་པ་དང་།",
    "དེ་རྣམས་ཀྱི་ཡན་ལག་གི་དོན་རིམ་གྱིས་བརྗོད་ན་ཚོགས་ལམ་ཞེས་པ་ལ་སོགས་པ་ཚོགས་ལམ་བཞི་སྟེ།",
    "དགའ་བ་གསུམ་པོ་ཡང་ཚོགས་ལམ་གྱི་ཁོངས་སུ་གཏོགས་ནས་སོ།",
    "ལས་འཕྲོ་སད་པས་ཏིང་ངེ་འཛིན་སྐྱེ་ན་ལས་འཕྲོ་ཚོགས་ལམ་དུ་སོང་བ་སྟེ།",
    "མྱ་ངན་དྲག་པོ་བྱས་པའམ་རྟའམ་གཡང་ས་ལ་ལྷུང་བའི་སྡུག་བསྔལ་དྲག་པོ་སྐྱེས་པའམ་ལྟད་མོ་ལ་སོགས་པའི་ཡུལ་གཟུགས་སྡུག་པའམ་སྒྲ་སྙན་པ་ལ་སོགས་པས་རྐྱེན་བྱས་ནསཏིང་ངེ་འཛིན་སྐྱེ་བའམ།",
    "སྦྱོར་ལམ་དྲོད་ཀྱི་ཡེ་ཤེས་མ་སྐྱེས་ན་བརྩོན་འགྲུས་བརྩམས་ཀྱང་ཚོགས་ལམ་རང་རྐྱང་དུ་སོང་བ་ཡིན་གསུང་།",
    "མོས་གུས།",
    "ཚོགས་ལམ་དེས་སྦྱོར་ལམ་དྲོད་ཀྱི་ཡེ་ཤེས་སྐྱེས་པ་ན་དྲོད་གསུམ་ལ་ཆེ་འབྲིང་གསུམ་གྱི་བྱེ་བྲག་གིས་ཁམས་འདུས་པ་གསུམ་ལ་རིམ་གྱིས་འཇུག་པ་སྟེ་དེའང་ཁམས་འདུས་པ་དང་པོ་ལ་དྲོད་སྐྱེས་ཚད་ཆུང་ངུ།",
    "དེའང་རྣམ་རྟོག་སྔོན་དུ་སོང་བའི་དྲོད་ནི་སྐྱེ་སླ་བས་ཆུང་ངུ།",
    "སྒྲབ་པ་པོ་ཉིད་ཉོན་མི་མོངས།",
    "ཉམས་མྱོང་གི་ངོས་ནས་ལྟ་བ་ཞེས་བྱ་ཡོན་ཏན་གྱི་ངོས་ནས་འབྲས་བུ་བཞིར་བཞག་པ་ལས་དྲོད་ཉམས་རིམ་གྱིས་བརྟན་པ་ལས་འབྲས་བུ་བཞིར་བཞག་པ་ནི།",
