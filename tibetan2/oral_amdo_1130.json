    "འོག་ཤོད་ཀྱི་སྐུ་ཆེ་བ་བདུན་ལ་ནང་རྟེན་རེ་གཉིས་ལས་འདྲ་མཚུངས་ཆ་མཉམ་དུ་ཕུལ་བ་དང་།",
    "ལམ་སྔགས་སོགས་གླེགས་བམ་ཆེ་གྲས་འབུལ་འོས་མེད་པསུ་བབ་བསྟུད་བགྱིས་པ་ལས་གཞན་རྟེན་སྣ་རེ་གཉིས་མ་གཏོགས་ཐམས་ཅད་ཁྱད་པར་མེད་པ་བྱས་ནས་ཕུལ་ཡོད་དོ་ཅེས་གོ་བར་བྱ་བའི་ཆེད་དུའོ།",
    "ཀློང་བརྡོལ་ཕྱག་དཔར་ཐུགས་རྗེ་ཆེན་པོ་ཕྱག་སྟོང་སྤྱན་སྟོང་གི་སྐུ།",
    "ལྷ་ཁང་ནང་གི་རྩིག་ངོས་ལ་ཞིང་བའི་བུ་མོ་ལེགས་སྐྱེས་མ་ལ་སོགས་པས་བཀྲ་ཤིས་པའི་རྫས་འབུལ་བ་དང་།",
    "ལྷ་ཁང་གི་ཕྱི་རོལ་ཏུ་རྒྱལ་ཆེན་བཞི་དང་།",
    "མ་ག་དྷ་བཟང་མོའི་བྱུང་བ་དང་།",
    "ལྷ་ཁང་གི་ཀླད་ཐོག་འོག་གཉིས་ལ་ཟངས་སེར་གྱི་རྒྱུ་ཡིཔས།",
    "གདོང་ལ་ཁའི་བྱིངས་འདྲེན་བློ་གྲོས་ངོ་གཡོག་ནས་རྔོན་པ་ལ་མ་ལྟོས་པར་ཐིག་པ་ཁུར་ལེན་གྱིས་ལྷ་ཁང་གི་སྟེང་ཤོད་ཐམས་ཅད་ལ་གསེར་ཚོན་གཟབ་འབུལ་ཞུས་ཏེ་ལེགས་འགྲུབ་བྱུང་།",
    "སྒོའི་ཀླད་དུ་ཀུན་གཟིགས་མ་ཧཱ་པཎྜི་ཏ་རྗེ་འཇིགས་མེད་རིགས་པའི་བློ་གྲོས་ཀྱི་ཞལ་སྔ་ནས་ཀྱིས།",
    "ས་རྒྱ་མཚོའི་ཆར་འངེབས་སྦྱོར་དངོས་རྗེས་གསུམ་གྱི་སྒོ་ནས་རྟེན་དང་བརྟེན་པ་མཐའ་དག་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་དངོས་དང་གཉིས་སུ་མེད་པར་སྐྲུན་པའི་གསུང་ཚོག་རྣམ་པར་དག་པ་བཀའ་དྲིན་གྱི་ཁུར་དུ་བཞིསཔ་ལ།",
    "ཕྲན་བུ་ནས་གཏང་རག་གི་དངོས་འབུལ།",
    "ཅེས་སྨོན་ཚིག་བྱིན་ཅན་བཏགས་ཏེ་སྐུ་བདུན་པོ་རེ་རེའི་ཕྱག་ཏུ་འབུལ་སྒྲོན་ཞུས་སོ།",
    "འཛུགས་སྒང་གྲོལ་གསུམ་གྱི་སྟོན་མོ།",
    "དེ་དག་གི་འགྲོ་ཆ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་བཞེངས་པས་གཟུགས་དང་ལང་ཚོའི་དཔལ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་ཞིང་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་སྲིད་ལ་སོགས་པ་འཐོབ་པ་སོགས་གནས་སྐབས་དང་།",
    "དད་པའི་སྟོབས་མཆོག་ཏུ་མ་གྱུར་ཀྱང་ཞིང་གི་མཐུས་ཕན་ཡོན་དཔག་ཏུ་མེད་པ་འབྱུང་སྟེ།",
    "རྩེད་མོ་དག་དང་སད་པར་བྱེད་པ་ཡིས།",
    "རྩིག་ངོས་སེན་མོའམ་ཤིང་བུས་གཟུགས་བྲིས་པ།",
    "ལ་ལས་གངྒཱའི་ཀླུང་གི་བྱེ་སྙེད་ཞིང་ཁམས་ན།",
    "གང་གིས་ཤེས་རབ་ཕ་རོལ་ཕྱིན་འདི་ཡིག་བྲིས་ཏེ།",
    "བྱིས་པའི་རྩེད་མོར་དེ་དང་དེ་དག་ཏུ།",
    "གང་གིས་རྒྱལ་བ་དེ་ཕྱིར་མཆོད་རྟེན་དག།",
    "དེའི་ཕྱིར་དཔུང་བཟང་གིས་ཞུས་པ་ལས།",
    "གང་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིན་པར་འགྱུར་འཆང་བར་འགྱུར་ཀློག་པར་འགྱུར་ཀུན་ཆུབ་པར་བྱེད་པར་འགྱུར་རབ་ཏུ་འདོན་པར་འགྱུར་སྟོན་པར་འགྱུར་ལུང་འབོགས་པར་འགྱུར་ཁ་ཏོན་བྱེད་པར་འགྱུར་ཞིང་།",
    "གཙུག་ལག་ཁང་བྱ་བ་ལ་སོགས་པ་ལ་གཞན་མོས་པར་བྱ་བ་སྔོན་དུ་གཏོང་ཞིང་བདག་གིས་གཞན་ལ་བྱིན་པས་ཤིང་ནྱ་གྲོ་དྷ་ལྟར་ཆུ་ཞེང་གབ་པ་དང་།",
    "གང་དང་ལྡན་ན་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དད་པ་དང་ལྡན་པ་རྒྱུ་བའམ།",
    "ང་ཉིད་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་ནས་ཉོན་མོང་ས་པཐ་ས་ཅད་སྤངས་ཏེ་དཀྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་སོ།",
    "རོལ་མོའི་གནས་ཀྱི་ཉམས་དགའ་བར།",
    "བཙུན་མོའི་འཁོར་དང་རོལ་བྱེད་པ།",
    "གཙུག་ལག་ཁང་གི་དོན་དུ་ནི།",
    "ཚིག་གིས་རབ་ཏུ་བསྐུལ་བ་དང་།",
    "ཕྱིན་ཅི་ལོག་གི་རི་བཅོམ་ནས།",
    "གཙུག་ལག་ཁང་གི་གང་ཞིག་བྱེད།",
    "རིན་ཆེན་མཆོག་གི་རང་བཞིན་གྱི།",
    "ཞེས་གཙུག་ལག་ཁང་བྱས་པ་ལ་གནས་སྐབས་དང་མཐར་ཐུག་གི་ཕན་ཡོན་མང་དུ་གསུངས་པ་དང་།",
    "གཡོས་མལ་བྱེད་པའི་ཁང་ཕྲན་ཙཨ་བཞེངས་པའི་ཚད་དུ་གོམ་པ་བདུན་བརྒྱུབ་ནའར་ངན་སོང་དུ་མི་འགྲོ་ཞིང་ལྷའི་ལུས་འཐོབ་བོ།",
    "ཞེས་གཙུག་ལག་ཁང་བཞེངས་པ་ལ་ཟང་ཟིང་གི་འབྲེལ་ལྟ་ཞོག་ལུས་ངག་གིས་འབྲེལ་ཕྲ་མོ་ཐོགས་པ་དང་།",
    "བདག་གི་ལུས་དང་ལོངས་སྤྱོད་དང་།",
    "མཆོད་རྟེན་དེ་ལ་གང་གིས་ཐལ་མོ་སྦྱོར།",
    "ཡོངས་སུ་ཚང་བའམ་ཐལ་མོ་ཡ་གཅིག་གམ།",
    "གང་གིས་རིང་བསྲེལ་གནས་པ་དེ་དག་ལ།",
    "རི་མོ་དང་སྐུ་གཟུགས་བྱེད་དུ་གཞུག་པ་དང་།",
    "ཁྱོད་ནི་མི་བདེན་པ་ཡི་ཚིཔ།་",
    "གངས་ཀྱི་རི་བོའི་རྩེ་མོ་ལ།",
    "མྱུར་དུ་རེག་པ་ཉིད་གྱུར་ཅིག།",
    "དཔལ་ལྡན་བྱ་ཁྱུང་ཐེག་ཆེན་ཡོན་ཏན་དར་རྒྱས་གླིང་གི་རྟེན་གྱི་གཙོ་བོ།",
    "ལེགས་བྱས་འདིའི་བྱེད་པོ་དགོན་གཞུང་གི་ལས་ཤག་ལྷན་རྒྱས་ནས་སྐྱེས་དང་བཅས་ནན་སྐུལ་ཡང་ཡང་བྱས་པའི་གཡར་ཁྲལ་དུ།",
    "སྦྲང་ཆར་ཐོག་གི་སྙན་ངག་དང་དཔྱད་རྩོམ་ཕུད།",
    "ད་དུང་རང་གི་ལྟ་ཚུལ་ཁ་ཤས་ཀྱང་མཉམ་དུ་ཞུ་ན།",
    "དེ་མིན་བསྒྱུར་རྩོམ་ཉུང་འགོད་བྱ་རྒྱུ་དང་ལྷག་པར་དུ་སྙན་ངག་གི་འབྲི་སྲོལ་ཛ་ཛོར་དེ་དག་བསྐྱུར་མི་དགོས་པར་སྙམ།",
    "ལང་ཚོའི་འཛུམ་དཀར་བཞད་པའི་ག་ན་ནུ་ཡི།",
    "མཛེས་མཛེས་ལང་ཚོ་དར་བའི་ན་གཞོན་ཚོགས།",
    "མཉེས་པར་བྱེད་པའི་སྙན་རྩོམ་མེ་ཏོག་གིས།",
    "ཆར་བཞིན་འཇོ་བའི་རེ་བ་ཡོངས་སུ་སྐོང་།",
    "ཀྱེ་ཀྱེ་སྦྲང་ཆར་ཁང་གི་མཛའ་བོ་ཀུན།",
    "ཕུགས་བསམ་གྱི་ལང་ཚོ།",
    "ཕུགས་བསམ་འདུན་མའི་རེ་ཁཱ་རིང་ནས་འབར།",
