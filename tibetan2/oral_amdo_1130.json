    "ཇོ་རུ་ལ་རྒོད་མ་མ་བུ་གཉིས་ཡོད་པ་སྔ་མོ་ནས་རི་ལ་བཏང་ཟིན་པ་སླར་ཡང་པཙལ་ནང་རྟེའུ་དེ་ཁ་ལོ་བཏུལ།",
    "སྒ་ཆས་སོགས་གཞན་ནས་བཙལ་ཏེ་གླིང་གི་རྟ་རྒྱུག་ལ་ཞུགས།",
    "རྟེའུ་རྐྱང་ཕྲུག་གྱི་ལིང་ཡིན་པར་བརྟེན་རྟ་རྒྱུག་གི་རྒྱལ་ཁ་ཐོབ།",
    "དེ་ནས་བཟུང་གེ་སར་དེ་གཉོམ་ཆུང་གི་ཕ་མ་དང་བཙན་པོའི་གཉའ་གནོན།",
    "དུས་དེར་ཕྱི་ཕྱོགས་ཀྱི་མི་རིགས་དང་རྒྱལ་ཕྲན་དག་གིས་བོད་གཅིག་གྱུར་མིན་པའི་གོ་སྐབས་ལ་བརྟེན་ནས་བོད་ལ་བརྙས་གཙེ་ཨ་ས་དང་བཙན་འཛུལ་བྱས་པ་དང་།",
    "བོད་མི་རེའི་ཁ་ན་སྒྲུང་རེ་ཡོད་ཅེས་པའི་གཏམ་དཔེ་ལྟར་བོད་གངས་ཅན་དུ་སྐྱེས་པའི་མི་ཞིག་ཡིན་ཕྱིན་གེ་སར་མི་ཤེས་མཁན་གཅིག་ཀྱང་མེད་ལ།",
    "གེ་སར་རྒྱལ་བོའི་སྒྲུང་དཔེ་ལ་མཚོན་ན་དེ་ནི་རྩོམ་མཁན་རེ་འགའ་ཞིག་གིས་ཕྱོགས་རེ་བའི་ལྟ་ཚུལ་ལྟར་བཙུམས་པ་མ་ཡིན་པར་ངལ་རྩོལ་མི་དམངས་ཀྱིས་གེ་སར་གྱི་རླབས་ཆེན་མཛད་རྗེས་གཞིར་བཟུང་ནས་དེའི་རང་བཞིན་དྲང་བོར་བརྗོད་པ་དང་།",
    "བློ་རབ་འབྲིང་ཐ་གསུམ་སུ་ཞིག་གིས་བཀླགས་ཀྱང་རང་རང་སོ་སོའི་མོས་པ་དང་མཐུན་པའི་རོ་ཁྱད་པར་བ་རེ་མྱོང་རྒྱུ་ཡོད་པ་ནི་རྒྱལ་ཁབ་ཕྱི་ནང་གི་ཀློག་པ་པོ་དང་ཉན་པ་པོ་རྣམས་ཀྱིས་མཁྱེན་གསལ་ལྟར་རེད།",
    "གེ་སར་དང་གེ་སར་གྱི་སྒྲུང་ལ་ཞིབ་འཇུག་བྱེད་རྒྱུ་དེའང་རང་རེ་བོད་གངས་ཅན་གཅིག་པུ་དང་ཡང་ན་རང་རེའི་རྒྱལ་ཁབ་གཅིག་པུའི་རིག་རྩལ་ཐད་ཀྱི་བྱ་བ་རྐྱང་རྐྱང་ཞིག་མ་ཡིན་པར།",
    "དེ་ལྟར་ཚིག་གི་སྤྲོས་པ་ལ་ཅུང་ཟད་ཞུགས་ནས།",
    "རེ་ཞིག་སྐབས་སུ་མ་བབས་པའོ།",
    "གེ་སར་མགོ་ལོག་ཏུ་འཁྲུངས་པའི་ལུང་གི་སྒྲུབ་བྱེད།",
    "ད་ལྟ་ས་འདི་ཕལ་ཆེར་མགོ་ལོག་གིས་བཟུང་།",
    "གེ་སར་གྱི་དུས་ཧོར་དམག་གིས་རི་ཀླུང་གང་ཟེར་བའི་ཨབ་ཕྱི་དུག་ཐང་བརྒྱུད་ཨ་ལག་ཤ་མི་ཆ་གན་ཁུ་ཐུལ་དུ་དཔོན་པོ་ཁག་གི་རྔ་མོང་སྐྱེལ་མི་བརྒྱ་སྐོར་ལ་ཐུགས་རྗེ་ཆེན་པོའི་རྗེས་གནང་བསྐུར།",
    "གེ་སར་གྱི་མཛོ་འདོགས་ས་ཡིན་ཟེར་བའི་རི་དེའུ་ཞིག་གི་ཉེ་འགྲམ་སྤང་སྔོན་པོ་ལ་བྲག་དཀར་བོ་སྲོག་ཆགས་ཀྱི་རྣམ་པ་འབུར་དུ་དོད་པའི་ས་འཛིན་མཛོ་ཁྲ་ལྡིངས་སུ་སླེབས་ཞེས་དང་།",
    "ད་ལྟ་མགོ་ལོག་གིས་བཟུང་ཡོད་པའི་རྨ་ཡུལ་འདི་ནི་སྔར་ཁྲ་མོ་གླིང་གི་ཡུལ་ཡིན་པར་བཤད།",
    "དེ་ཡང་གླིང་གི་མི་རྒྱུད་ནི།",
    "བོད་མིའུ་ལྡོང་དྲུག་གི་ནང་ཚན་ལས།",
    "སྨུག་པོ་ལྡོང་གི་རིགས་རྒྱུད་རེད།",
    "ཡང་གླིང་གི་སེང་བློན་ཟེར་བས་རྒྱ་བཟའ་ལྷ་སྐྱིད་སྒྲོལ་མ་དང་།",
    "འགག་མོ་འདྲེ་མོ་རེད་ཟེར་ཞིང་།",
    "ཡང་མཚོ་སྐྱ་རེངས་དང་སྔོ་རེངས་གཉིས་ཀྱི་བར་དུ་འབྲུག་མོའི་གསེས་མཁར་དང་།",
    "གླིང་དཀར་སྟོད་ཟེར་བ་ནི་གླིང་གིས་བཟུང་བའི་ས་ཡིན་པས།",
    "ལུང་གི་སྒྲུབ་བྱེད་མི་འགྱུར་བའི་གཟེར་བཏབ་ཟིན་ཏོ།",
    "དེ་དང་ཤིན་ཏུ་ཉེ་བའི་ས་ན་མཁའ་རེའི་ཕུག་པ་ཞེས་པའི་དགོན་ཤུལ་རྙིང་བ་ཞིག་ཡོད་པ་དེ་གེ་སར་གྱི་སྒྲུབ་ཕུག་ཡིན་ཟེར།",
    "མང་ཚོགས་ཀྱི་ངག་རྒྱུན་དུ་རྨ་ཆུ་གཡས་ནས་འབབ་ས།",
    "གནའ་སྔ་མོ་དེ་དང་ཉེ་བའི་རྨ་ཆུའི་འགྲམ་དུ་གནའ་རབས་ཀྱི་ཤིང་གྲུ་མཚར་བོ་ཞིག་ཡོད་པ་ཁྲོ་ཐུང་གི་གྲུ་ཡིན་ཟེར་མོད།",
    "ཕངས་པ་ལ་མ་ཇག་གིས་མེ་ལ་བསྲེགས་སོང་ཟེར།",
    "མང་ཚོགས་ཀྱི་ངག་རྒྱུན་དུ།",
    "སེང་ལྕམ་འབྲུག་མོའི་རྩེ་ས།",
    "གང་ལྟར་སྔར་གྱང་ལྷག་གི་ཤུལ་མཐོང་རྒྱུ་ཡོད་ཟེར་ཡང་།",
    "རྨ་སྲིབ་ཀྱི་རྨ་ཆུ་ར་གླིང་གོར་ཟེར་བའི་ཐང་ན་ཡོད་ལ་གོང་གི་རྒྱུ་ཚའི་མཁར་ཤུལ་ནས་ཤར་ཕྱོགས་སུ་སྤྱི་ལེ་བརྒྱ་ཕྲག་ལ་ཉེ་བ་ཞིག་བགྲོད་པའི་ས་ན་ཡོད་ཟེར།",
    "མཚོ་སྐྱ་རེངས་དང་སྔོ་རེངས་བར་ན་འབྲུག་མོའི་གསེས་མཁར་དང་།",
    "འབྲུག་མོའི་ཆུ་ཁུར་སའི་རྡོ།",
    "དཔལ་མོ་ཨ་སྟག་ལྷ་མོའི་མཁར།",
    "སྤྱི་དཔོན་གྱི་མཁར་ཡོད་ས་ནས་ནུབ་ཕྱོགས་སུ་སྤྱི་ལེ་བཅུ་ཕྲག་དུ་མ་སོང་མཚམས་ན་ཁང་ལུང་ཟེར་བའི་ལུང་ཆེན་ཞིག་ཡོད།",
    "དེའི་སྦུབས་ན་རྡོ་མཁར་གྲུ་བཞི་ཆེན་པོ་ཞིག་གི་ཤུལ་དང་།",
    "ཕྱུགས་ཀྱི་ཐེ་གེ་རུས་ཚིགས་བར་གྱི་རུས་པ་ཞིག་སྤུངས་པའི་ཤུལ་སོགས་དངོས་སུ་ཡོད་པ་ནི་བྱང་རི་ཤའི་རྔོན་པ་ཨ་སྟག་ལྷ་མོའི་མཁར་ཤུལ་ཡིན་ཟེར།",
    "མི་རྣམས་ཀྱིས་ཀླུ་མོའི་ཨ་སྟག་ཀླུ་མོ་ཡང་ཟེར་ཤ་མཁར་ཞེས་འབོད་བཞིན་ཡོད།",
    "ད་ལྟ་མགོ་ལོག་གི་ས་ཁོངས་ན་ཡོད་པའི་གླིང་སྒྲུང་དང་མཐུན་པའི་རི་ཆུ་མཚོ་གསུམ་གྱི་མིང་ངོ་མ།",
    "གེ་སར་སྐུ་གཤེགས་དུས་ཀྱང་ཨ་མྱེས་རྨ་ཆེན་གྱི་ཐུགས་ཀ་ཡིད་བཞིན་འཁོར་ལོ་ནས་འཇའ་ལུས་སྤུ་དེངས་ཟེར།",
    "རྨ་ཡུལ་མཐོང་བ་ཀུན་སྨོན་ཞེས་གླིང་གི་ཆགས་ཡུལ་གཙོ་བོ་རྨ་ཆུའི་རྒྱུད་ཡིན་ལ།",
    "དེ་དག་རེ་རེ་ལ་གླིང་སྒྲུང་ལས་བྱུང་བའི་ངག་རྒྱུན་དང་།",
    "དེ་ཡང་རེ་རེ་ནས་བགྲང་ན་འདི་ལྟ་སྟེ།",
    "མུན་མོའི་གསེར་ཏེས་མཐོན་པོ།",
    "མཚོ་སྐྱ་རེངས་དང་སྔོ་རེངས།",
    "གཞན་ཡང་གླིང་གི་རྟ་རྒྱུག་རྒྱལ་འཇོག་བྱེད་སའི་ཨ་བཞིའི་དེའུ།",
    "ཧོར་གླིང་གཡུལ་འགྱེད་སོགས་མང་བོ་ལས་བྱུང་བའི་ཐོག་ལའི་ལ་རྒྱུད་རིང་མོ།",
    "རྨ་ཕུ་དྲུག་དར་ལུང་ཕྱུག་མོ།",
    "མཁར་ཤུལ་ཚོ་བ་སོགས་ཚོ་ཆེན་དང་ཚོ་ཕྲན་མང་བོ་ཞིག་ཡོད་པ་ལས།",
    "སྐབས་དེའི་དམག་གི་རུ་དར་དང་།",
    "འོན་ཀྱང་མགོ་ལོག་ལྟ་བུའི་ཚོ་ཆེན་ཚོ་ཆེན་བྱས་ནས་ཡོད་པ་མ་རེད།",
    "མགོ་ལོག་གི་ལུགས་སྲོལ་གོམས་གཤིས་ལས་གླིང་གི་མི་རྒྱུད་ཡིན་པ་དཔོག་ཐུབ།",
    "དགྲ་ཡོད་ན་མདུང་མོ་མཉམ་འཛིན།",
    "འདིའི་སྟེང་ནས་གླིང་དམག་གི་ལུགས་སྲོལ་དེ་མཚོན་ཐུབ།",
    "ག་ཞན་ཡང་དགྲ་ཟླ་དང་གཡུལ་འགྱེད་དུས་དཔའ་བོ་ཁེར་རྒྱུག་གི་སྲོལ་རྒྱུན་དེའང་མ་ཉམས་པར་ཡོད།",
    "སྤྱིར་མགོ་ལོག་གི་གོས་དང་རྒྱན་ཆ།",
    "རྟ་རྒྱུག་དང་རྩེད་མོ།",
    "ཐ་ན་བྱིས་པ་རྩེ་ལུགས་ཡན་ཆད་ཀྱི་ནང་དུ་གླིང་གི་སྲོལ་རྒྱུན་མ་ཉམས་པར་ཡོད་པ་བགྲང་གིས་མི་ལང་ལ།",
    "ཡང་དཔྱིད་ཀྱི་དཔལ་ཡོས་ལེགས་པར་བསུས་པའི་ཁྲུང་ཁྲུང་གི་ཁྱུ་ཐོག་མར་སླེབས་པ་ན།",
    "དཔལ་ལྡན་འཁོར་ལོ་སྡོམ་པ་དང་རྗེ་བཙུན་རྡོ་རྗེ་ཕག་མོའི་གནས་ཁྱད་པར་ཅན་གྱི་ཉེ་འདབས་ཡིན་པ་དང་བཞི།",
    "ལོག་པར་སྨྲ་བའི་སྨག་རུམ་མཐའ་དག་གཏིང་ནས་བཅིལ་ཏེ་ཉིན་མོར་བྱེད་ཅིང་།",
    "གཞིས་ཀྱི་མཆོད་ཁང་དུ་དཔལ་ལྡན་དམག་ཟོར་རྒྱལ་མོ་མ་སྤྱི་སྲུང་མར་བསྟེན།",
    "དུས་ཕྱིས་སུ་ཁྱིམ་ཚང་འདིས་རེབ་གོང་གི་ཨ་ལགས་རྒྱལ་བོ་རྒྱལ་སྲས་སྟོབས་ལྡན་དཔའ་བོ།",
    "རྒྱ་བོད་སོག་གང་གིས་མཐོང་ཡང་འགྲམ་ཆུ་མི་ལྡང་བ་ནི་ཧ་ཅང་དཀོན།",
    "དགོན་གཞུང་དང་གྲོང་བ་ཚང་མས་དུས་རྒྱུན་དུ་སྐྱིད་སྡུག་གི་བློ་བཀོད་འདྲི་ས་ཞིག་ཏུ་གྱུར།",
    "སྤྱི་ལོ་ལོར་ཁོང་གིས་གཞུང་བཀའ་པོད་ལྔའི་དམ་བཅའ་བཞག་ནས་མཁས་པའི་མཚན་སྙན་གྱི་བ་དན་དགུང་ལ་ཕྱུར།",
    "དེའི་ཕྱི་ལོར་མ་པུ་ཧྥང་གིས་གདན་འདྲེན་ཞུས་པ་ལྟར།",
    "བོད་རབ་བྱུང་བཅུ་དྲུག་པའི་ལྕགས་མོ་ཡོས་ཀྱི་ལོ་སྟེ།",
    "ཡར་རྒྱས་མ་བྱུང་བ་ལ་ངོས་ཟིན་ཟབ་མོ་ཞིག་ཡོད་པས།",
    "པེ་ཅིན་དུ་བཞུགས་པའི་རིང་ལ་བློ་མཐུན་མའོ་ཙེ་ཏུང་དང་ལིའུ་ཧྲའོ་ཆི་སོགས་ཀྲུང་དབྱང་གི་གཙོ་འཛིན་ཚོས་ཐེངས་གསུམ་ལ་མཇལ་འཕྲད་གནང་།",
    "བོད་རབ་བྱུང་བཅུ་དྲུག་པའི་ཆུ་ཕོ་འབྲུག་གི་ལོ་སྟེ།",
    "བོད་རབ་བྱུང་བཅུ་དྲུག་པའི་ཆུ་མོ་སྦྲུལ་གྱི་ལོ་སྟེ།",
    "ཏུང་ཚོན་རོས་མཛེས་ཤིང་ལྟ་ན་སྡུག་པའི་ཧཱ་ཞི་ལས་ཧྲ་སོགས་ཀྱི་གློག་བརྙན་བཅུ་དྲུག་ལ་བོད་སྐད་ཀྱི་སྒྲ་སྦྱར་བར་མ་ཟད།",
    "བོད་རིགས་མང་ཚོགས་ཀྱིས་ཐེངས་དང་བོར་བོད་སྐད་གློག་བརྙན་ལྟ་ཐུབ་པ་དང་།",
    "ཆི་པེ་ཧྲི་ཡི་སྐད་གྲགས་ལྡན་པའི་རི་མོ་དང་ཡིག་འབྲིའི་ཡོ་བྱད་སྤུས་ལེགས་ཀྱི་བྱ་དགའ་གནང་།",
    "དེ་དག་གིས་དམ་པ་འདི་ལ་སྐུལ་སློང་ཧ་ཅང་ཆེན་པོ་ཐོབ།",
    "དམ་པ་འདི་དང་ཡིག་སྒྱུར་ཚན་ཆུང་གི་བློ་མཐུན་གཞན་པ་རྣམས་ཀྱིས་དཀའ་ངལ་མང་བོ་ཁྱད་དུ་བསད་ནས།",
    "སྤྱི་ལོ་ལོར་དམ་པ་འདི་ཏང་གི་དབུ་ཁྲིད་ཀྱི་འོག་ཏུ།",
    "མཛད་གཟིགས་སྟེགས་བུའི་ཐོག་ཏུ་འཛེགས།",
    "སྤྱི་ལོ་ལོར་དམ་པ་འདི་ལ་པཎ་ཤེས་ཚོགས་ཁག་ཅེས་མ་ཉེས་ཁ་གཡོག་གི་ཉེས་སྐྱོན་གྱི་ཐག་པས་དྲུད་པ་དང་།",
    "ཏང་གི་སྐབས་བཅུ་གཅིག་པའི་ཐེངས་གསུམ་པའི་གྲོས་ཚོགས་ནས་བཟུང་སྟེ།",
    "ཁོང་གིས་སླར་ཡང་བྱ་བ་བསྒྲུབ་མགོ་བརྩམས་རྗེས།",
    "བློ་གྲོས་བཟང་བོས་བསྟན་པའི་དེ་ཉིད་གཟིགས།",
    "ལུང་གི་ཡོན་ཏན་རབ་གསལ་ཉི་མའི་སྤུན།",
    "གང་གི་ལེགས་གསུང་རིགས་ཚུལ་དུང་གི་སྒྲས།",
    "མ་རུངས་ཞིང་བཅུའི་སྲོག་གི་བདུད་པོ་ཆེ།",
    "སྨིན་གྲོལ་གྱི་གདམས་པ་དཔག་ཏུ་མེད་པ་སྤྱན་དྲངས་ནས་བོད་ཡུལ་དུ་འཆད་ཉན་རྣམ་དག་གིས་གཏན་ལ་ཕབ་པ་ལས་བཀའ་བརྒྱུད་ཀྱི་སྲོལ་དར་ཞིང་།",
    "འཁོར་ལྔ་ཁྲི་ལྔ་སྟོང་ལྔ་བརྒྱ་ཉེར་ལྔ་འདུསདུས་ཀིག་ལ་དགེ་སློང་འབུམ་ཕྲག་གི་ཚུལ་ཤིངལེན་པ་བྱུང་ཞེས་གྲགས།",
    "མ་ཅིག་ལབ་ཀྱི་སྒྲོན་མ་ལས་མོ་གཅོད་དར།",
    "བསྟན་འཛིན་ཉི་མའི་འོད་སྣང་གིས།",
    "འཛུམ་རྒྱུ་གྲོལ་བའི་ལང་ཚོ་ངོམ།",
    "སྟོན་པའི་མཛད་ཆེན་རེ་རེའི་སྐབས་སུ་བཞེངས་པ་ཡོངས་གྲགས་ཀྱི་མཆོད་རྟེན་བརྒྱུད་སོགས་ཐུགས་རྟེན་དཔག་ཏུ་མེད་པ་ནོར་འཛིན་གྱི་ཁྱོན་མཛེས་པར་བྱས་པ་དང་།",
    "ཚངས་པའི་གནས་ཀྱི་སྐྱེད་ཚལ་གསུམ་དུ་རྒྱལ་བོ་ཟས་གཙང་གིས་དེ་གསུམ་གྱི་ཀུན་དགའ་ར་བ་དང་།",
    "སྟོན་པ་མྱ་ངན་ལས་འདས་པའི་འོག་ཏུ་ཡང་མ་ག་དྷའི་བྲམ་ཟེ་མོ་ཛསའི་བུ་གསུམ་གྱི་ཆེ་བ་རྒྱལ་བས་ལྟ་རཱ་ཎ་སཱིར་སྟོན་པའི་སྐུ་གཟུགས་ཀྱི་ལྷ་ཁང་བཞེངས་པ་དང་།",
    "མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱིས་ལྷ་མོ་ཙན་ཀའི་དངོས་གྲུབ་ལ་བརྟེན་ནས་ནཱ་ལེནྡྲར་ལྷ་ཁང་བརྒྱ་རྩ་བརྒྱད་དང་།",
    "སློབ་དཔོན་འཕགས་པ་ལྷས་རིའི་ལྷ་དང་ཤིང་གི་ལྷ་ལས་ཡོ་བྱད་བླངས་ཏེ་ཡུལ་དབུས་སུ་ལྷ་ཁང་ཉེར་བཞི་དང་།",
    "ཨུ་རྒྱན་གསུམ་དུ་ལྷ་ཁང་ཉེར་ལྔ་རེ་དང་།",
    "སློབ་དཔོན་ཙནྡྲ་གོ་མིས་དྷ་ན་ཤྲཱིའི་གླིང་དུ་སྤྱན་རས་གཟི་ས་ང་སྒྲོལ་མའི་ལྷ་ཁང་བརྒྱ་ཕྲག་རེ་དང་།",
    "ཇོ་བོ་ཨ་ཏི་ཤས་བལ་ཡུལ་དུ་ཐང་བྷ་ཧ་རའི་གཙུག་ལག་ཁང་བཞེངས་པ་སོགས་པཎ་གྲུབ་རྒྱལ་བློན་བསྟན་ལ་སྲི་ཞུ་བྱེད་པ་རིམ་པར་བྱོན་པ་ཐམས་ཅད་ཀྱི་ནང་ན་གཙུག་ལག་ཁང་རེ་མ་བཞེངས་པ་མེད་པ་ལྟ་བུར་ཡོད་དོ།",
    "བོད་གངས་ཅན་གྱི་ལྗོངས་འདིར་ཡང་བསྟན་པ་སྔ་དར་གྱི་དུས་སུ་རྒྱལ་བོ་སྲོང་བཙན་དང་བལ་བཟའ་ཁྲི་བཙུན་གཉིས་ཀྱི་འོ་ཐང་གི་མཚོར་ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་ད་ང་།",
    "སོ་བཙན་དང་རྒྱུ་བཟས་ར་མོ་ཆེར་ར་མོ་ཆེའི་གཙུག་ལག་ཁང་དང་།",
    "ཀླུ་མེས་ཀྱིས་ལ་མོ་ཆག་དེའུ་དང་།",
    "བང་གྲེ་ཞབས་ཙམ་རེ་ཡིན་ཡང་པཞེངས་ཅི་ཐུབ་བྱེད་པ་ལ་ཐུགས་མོས་ཆེ་སྟབས་བཀའ་གདམས་པ་རྣམས་ཀྱིས་གཙུག་ལག་ཁང་ཆེ་ཕྲ་བཞེངས་པ་གྲངས་ཀྱིས་མི་ཟིན་པ་དང་།",
    "ལོ་ཆེན་རིན་ཆེན་བཟང་བོས་མངའ་རིས་མཐོ་ལྡིང་གི་གཙུག་ལག་ཁང་རྟེན་དང་བརྟེནུཔར་བཅས་པ་སོགས་གཙུག་ལག་ཁང་བརྒྱ་རྩ་བརྒྱད་དང་མཆོད་རྟེན་སྟོང་ཕྲག་བརྒལ་བ་བཞེངས་པ་དང་།",
    "རྒྱལ་ཚབ་དང་འདུལ་འཛིན་གཉིས་ལག་གི་བླར་བསྐོས་ནས་དགེ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་གི་འདུ་ཁང་སྒྲུབ་མཚོར་ལྷ་ཁང་བློས་བསླངས་དང་བཅསུ་པ།",
    "མཁས་གྲུབ་ཐམས་ཅད་མཁྱེན་པས་རྒྱལ་རྩེའི་མཆོད་རྟེན་ཆེན་མོ་དྲི་གཙང་ཁང་ཅན་དང་།",
    "བྱམས་སྐུ་མཐོ་ཚད་སྤྱི་ཁྲུ་ཉེར་དྲུག་དང་ཚོན་དོ་བ།",
    "བཞི་སྟོང་ཉིས་བརྒྱ་བརྒྱད་ཅུ་ཐམ་པ་བཅས་ཀྱི་འགྲོ་ཆ་ཕུལ་ཏེ་བྱམས་སྐུ་ཆེན་མོ་བཞེངས་པ་དང་།",
    "གུང་ཐང་འཇམ་པའི་དབྱངས་ཀྱིས་མཆོད་རྟེན་མཐོང་གྲོལ་ཆེན་མོ་བཞེངས་པ་སོགས་ལྷོ་རྒྱུད་དུ་གཙུག་ལག་ཁང་དང་རྟེན་གསུམ་བཞེངས་པ་བསམ་བརྗོད་ཀྱི་ཡུལ་ལས་འདས་སོ།",
    "ལྷ་ཁང་ཆེན་མོར་གྲགས་པ་རྒྱལ་བ་རིགས་ལྔ་དང་རྡོ་རྗེ་ཕག་མོའི་ལྷ་ཁང་།",
    "འདུ་ཁང་ཆེན་མོ།",
    "སྔོན་རྒྱ་གར་དུ་སྟོན་པ་དངོས་སུ་བཞུགས་དུས་བཀའ་ཡི་གེར་བཀོད་པ་རྣམས་རྒྱལ་བློན་དང་ཁྱིམ་བདག་དད་ཅན་རྣམས་ཀྱིས་མཚན་མོ་སྒྲོན་མེའི་འོད་ཚུན་ཆད་ལ་བརྟེན་ནས་ལྟ་ཀློག་བྱེད་ཀྱང་།",
    "རྒྱལ་པོསྲོང་བཙན་ནས་གླང་དར་བྱེས་བསྟན་བ་སྲུངས་བར་ལོཉིས་བརྒྱའི་རིང་ལ་ལོ་ཙཱ་བའི་ཐོག་མ་ཐོན་མི་སཾ་བྷོ་ཊ་ནས་ནམ་མཁའ་སྐྱུང་གི་བར་ལོ་ཙཱ་བ་ང་གཅིག་བྱུང་བ་དང་།",
    "རྒྱ་ནག་གི་སྐད།",
    "ཞང་ཞུང་གི་སྐད།",
    "སླར་ཡང་སོག་ཡུལ་ནས་འཇམ་དགག་གིས་སྣག་ཤོག་སོགས་ཆ་རྐྱེན་གང་དགོས་བསྐུར་ནས།",
    "ཞྭ་ལུའི་གཙུག་ལག་ཁང་གི་བཀའ་བསྟན།",
    "དུས་འཁོར་གྲྭ་ཚང་གི་འདུ་ཁང་སོགས་མང་བོ་བཞེངས་ཤིང་།",
    "བདེ་ལྡན་ཞིང་གི་སྙེམས་པ་འཕྲོག་བྱེད་པའི།",
    "ལག་གི་བླས་འགྲོ་བ་དང་འོང་བ་དང་ལྡན་པའི་གཞིར་གཙུག་ལག་ཁང་རབ་ཏུ་གནས་པར་བྱའོ།",
    "དེ་ལས་བྱང་གི་ཕྱོགས་སུ་བགྲོད་པ་ན།",
    "ཤིང་རྟའི་དབྱིབས་འདྲ་འཛམ་གླིང་གི།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཚད་ལ་སོགས་པ་ཆེས་མི་མཐུན་པ་གཉིས་གསུངས་པ་དེ་གསུང་བ་པོ་གཅིག་གི་ཚིག་ཡིན་ཞིང་གཉིས་པོ་གང་ཡང་དགོངས་པ་ཅན་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "རང་ཚིག་ཏ་། འགལ་བའི་ཉེས་པས་རེག་པས་དཔྱད་གསུཡ་གྱིས་དག་པ་རྟགས་མ་གྲུབ་བོ་སྙམ་ན།",
    "འཇིག་རྟེན་གྱི་ཁམས་གཅིག་གི་གོ་ས་ན་འཇིག་རྟེན་གྱི་ཁམས་དོན་གཞན་གཉིས་གནས་པ་ཡིན་ན་ནི་ཐོགས་བཅས་ཀྱི་དངོས་པོ་མ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "འོ་ན་ཇི་ལྟར་སའམ་བྲག་གི་ཕུག་ཕྱོཔ་ས་བཞིའི་ངོས་སུ་ཀླུ་རེ་རེ།་",
    "མི་གཅིག་གི་གོ་སར་མི་གྲངས་མེད་དེ་སྙེད་ཅིག་དོག་པ་མེད་ཀྱང་མ་འདྲེས་པར་གནས་པའི་མི་དེ་དག་ཐོགས་མེད་ཡིན་ནམ་ཅི།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་པའི་རྫུ་འཕྲུལ་སྤྱི་སྟོབས་ཀྱི་སུ་དེར་འགྱུར་བ་ཇི་ལྟ་བ་བཞི་དུ་སེམས་ཅཔ་རྣམས་ཀྱི་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་ལས་ཀྱི་ནུས་པས་ཀྱང་འཔིག་རྟེན་གྱི་ཁམས་གཅིག་གི་སར་འཇིག་རྟེན་གྱི་བམས་མཚན་ཉིད་ཡི་ཐུན་པ་ཐ་དད་པ་གཉིས་མ་འདྲེས་པར་གནས་པ་ཅི་ནས་ཀྱང་འགལ་བ་མེད་དོ།",
    "ཡང་རྣལ་འབྱོར་པའི་རྫུ་འཕྲུལ་གྱི་མཐུས་ཇི་ལྟར་བྱ་བར་ནུས་པ་བཞིན་ལས་ཀྱིས་བྱ་བར་མི་ནུས་ན་འོག་གི་རྒྱུ་ཚོ་ཆེན་པོའི་སྟེང་དུ་ས་ཆེན་པོ་རི་བོ་དག་དང་བཅས་པ་འདི་ཙམ་ཞིག་བཞག་པ་དག་ཅུང་སྨད་ཀྱང་ཆུ་ནང་དུ་ཕྱིང་བར་མི་འགྱུར་ཞིང་གྲུ་ལ་སོགས་པ་བཞིན་གཡོ་བར་ཡང་མི་འགྱུར་བའི་རྒྱུ་བ་ང་ཞིག་ཡིན།",
    "ཡང་འཇིག་རྟེན་གྱི་ཁམས་གཅིག་གི་གོ་ས་ན་༤གསབལ་ཡ་བ་། ཚད་སོགས་མི་མཐུན་པའི་འཇིག་རྟེན་གཉིས་གནས་ཀྱང་།",
    "ལས་རིགས་མཐུན་བསགས་པ་རྣམས་ལ་ལས་ཇི་ལྟར་བསགས་པ་དང་མཐུན་པའི་འཇིག་རྟེན་གྱི་ཁམས་དེའི་ཆ་ཤས་དག་སྣང་གི་ཅིག་ཤོས་མི་སྣང་སྟེ།",
    "དེར་ན་བརླན་ཞིང་གཤེར་བ་ཕོར་བ་གང་གི་པ།",
    "མི་ལ་ཆུ་སྣང་གི་རྣག་ཁྲག་མི་སྣང་བ་བཞིན་ནོ།",
    "རྒྱལ་བསྟན་སྤྱི་དང་ཁྱད་པར་འཇམ་མགོན་རང་བསྟན་རྫོགས་ལྡན་བཞིན་དུ་དར་ཞིང་རྒྱས་པའི་ཡུལ་འདི་ལ་གསེར་ལྡན་ཆུ་བོ་དལ་གྱིས་འབབ་པའི་ཕྱོགས་ལས་ལྷོ་བྱང་གི་རྒྱུད་གཉིས་སུ་གྲགས་པའི་བྱང་རྒྱུད་སའི་ཐིག་ལེ།",
    "སྤྱི་ལོ་ཆིག་སྟོང་སུམ་བརྒྱ་དང་དགུའི་ལོར་ས་སྐྱ་ནས་ཆད་པའི་རིགས་རེབ་གོང་ཤ་སྦྲང་དུ་འཁྲུངས་པར་ཀུན་གཟིགས་འཇམ་པའི་དབྱངོས་ཨ་བྷུའི་ཞབས་བཞེད།",
    "དགུ་རོང་བརྒྱུད་སྣང་རའི་གསེར་ཁང་གི་གཞི་འདིར་བྱོན།",
    "ཀུན་རིག་རྩེ་མོ།",
    "དེར་མ་ཟད་སྒྲུབ་ཁང་ལྟག་གི་རྒྱབ་རིའི་ངོས་ཀྱིརྡོ་དང་རྡེའུའི་སྟེང་ལ་ཡང་རང་བྱོན་ཡིག་འབྲུ་གསལ་བོ་བབས་པ་ད་ལྟ་ཡང་མང་དུ་རྙེད་རྒྱུ་ཡོད།",
    "ཞེས་འཇམ་དབྱངས་མཚོད་པའི་རོལ་མོར་གསུངས་པ་ནི་རང་བཞིན་བརྗོད་པ་ཁོ་ནའོ།",
    "ཞེས་རྗེ་རང་གི་རྟོགས་པ་རང་གིས་བརྗོད་པ་དང་།",
    "གསུངས་པ་བདེན་པར་སྨྲ་བའི་དྲང་སྲོང་གི་གཏམ་ཡིན་ནོ།",
    "བྱ་ཁྱུང་ཨ་ར་པ་ཙའིསྒྲུབ་ཁང་འཇམ་དབྱངས་སྤྲུལ་བའི་ལྡིང་ཁང་གི་ཤུལ་འདི་ཉིད་ཡིན་པས་གནས་འདི་ནི་མཉན་ཡོད་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་དང་ཁྱད་པར་མེད་དོ།",
    "ཁྱོམ་ཚང་ཉག་ཁར་ཐབ་བསུ་རྒྱུས་བསྒྲིགས་ཐོག་ཞབས་སོར་འཁོད་དེ་ལྷོད་བཞུགས་བསྐྱངས།་",
    "ཕྱིར་འབྱོར་བསྟུན་ཚིབས་བསྐྱོད་ནས་ཚ་བུག་གཞུང་ལམ་ཚང་གི་རང་འཐག་རྩོར་སྡོང་ར་ཆུང་ཆུང་ཡོད་པར་ངལ་གསོ་རྒྱུན་རིང་མཛད་བཞིན་རང་འཐག་ལ་གཟིགས་རྟོག་བསྐྱངས་ནས་ཆུ་གཏོང་བར་མཛད།",
    "ཡང་ལོ་ཁྱུད་གཅིག་གི་རྒྱུན་ཇའི་འཐེབ་ལ་རྒྱ་དངུལ་སྲང་སུམ་རྒྱ་དང་ཉི་ཤུ་བཅས་བསྩལ།",
    "བྱ་ཁྱུང་དགོན་བ་གཞུང་གིས་མཎྜལ་སྐུ་གསུང་ཐུགས་རྟེན།",
    "རྒྱ་དངུལ་རྡོ་ཚད་བཅུ་ཕྲག་གི་གཏང་རག་ལེགས་འབུལ་གྱི་མཆོད་སྤྲིན་སྤྲོས་ཏེ།",
    "ས་རྣམས་བདག་གིར་བཞེས་ཤིང་ཚོགས་དམངས་ལ་དགའ་ལྷ་དང་།",
    "ཡིག་དྲུག་གོང་ས་རང་གི་བརྟན་གསོལ།",
    "དེ་ནས་ལྷ་ཁང་ཆེན་མོར་གཟིགས་མཇལ་དུ་ཕེབས།",
    "རྩ་ཆེའི་རྟེན་གཙོ་རྡོ་རྗེ་ཕག་མོའི་སྐུ་བརྙན་གྱི་ཞལ་ཁེབ་སྒྲིབ་ཡོལ་བསལ་ནས་མེ་ཏོག་གཏོར།",
    "ཆ་བ་། ཇི་སྲིད་དགོན་འདི་ནམ་གནས་བར་༧ སྐུ་མདུན་མཆོག་ལ་སྐུ་སྐལ་ལྔ་བཅུ་རེ་འབུལ་རྒྱུའི་ཁས་ལེན་ཞུ་བར།",
    "མེ་ཏོག་གི་སྡོང་བོ་ཞིག་ཡོད་པ་ལའང་དུས་མིན་སྔ་ནུར་གྱི་ཚུལ་དུ་མེ་ཏོག་རྒྱུ་ཆེར་ཤར་བ་བཅས་ངོ་མཚར་བའི་ལྟས་དུ་མ་བྱུང་ངོ་ཞེས་ཐོས་སོ།",
    "འདུ་ཁང་ཆེན་མོའི་སྟེང་ནས་དར་འབོད་དང་།",
    "ཕྱིས་མི་བསྲུན་པ་དག་གིས་ཚོན་རིས་བཏབ་ནས་མི་སྣང་བར་བྱས།",
    "སྔོན་གྱི་སྒྲུབ་ཁང་གི་རྩིག་པ་མ་སྒུལ་བར་རང་སོར་བཞག་ནས་མཆོད་རྟེན་བསྐྱོད།",
    "མས་བདེ་ཡངས་རི་པོ་ཆེས་རྡོ་རྗེ་སློབ་དཔོན་མཛད་ནས་རྒྱུད་གྲྭའི་དགེ་སློང་བཅུ་ཕྲག་གཅིག་གིས་རབ་གནས་དགེ་ལེགས་ཆར་འབེབས་བ།",
    "ནོར་བུ་འབར་བ་ཆ་བཅས་གནང་འབྱོར་བྱུང་པ་ལྷ་ཁང་ཕྱི་མའི་ཀླད་དུ་བསྟད་དེ་མིག་གི་བདུད་རྩི་ལྟ་བུར་ལེགས་པར་གྲུབ་ནས་ལོ་ངོ་ཞེ་བརྒྱད་འདས་པའི་ཞེ་དགུ་བ།",
    "མཐོང་ཐོས་དྲན་རེག་གི་འགྲོ་བ་ཀུན་ལ་ཕན་བདེའིའདོད་དགུ་ཅི་ཡང་སྩོལ་པའི་མུར་བརྟན་པར་བཞུགས་པ་ལགས་སོ།",
    "སྒྱུ་ལུས་འོད་གསལ་ཕྲ་མོའི་རྣལ་འབྱོར་གཉིས།",
    "གང་གི་རིང་ལུགས་ལྟ་སྒོམ་སྤྱོད་པའི་དབྱིག།",
    "གངས་ཅན་འཛིན་མའི་ཁྱོན་ལ་བརྡལ་བ་ལས།",
    "བློ་བཟང་རིང་ལུགས་འཛིན་ལ་རེ།",
    "སིང་སྐྱུར་ལ་བཏབ་པའི་ཕྱེ་བཞིན་ཁ་ལ་ཡམ་མེ་བར་སོང་།",
    "རྩ་བ་རང་ཅག་འཕུང་ལ་སྦྱོར་བའི་རྒྱུ་ཆ་རང་གིས་བསྒྲུབས་ཤིང་།",
    "ཞེས་པ་ལྟར་ལེ་ལན་གཞན་ལ་འགེལ་ས་མེད་པར་རང་གིས་ལས་ངན་བསགས་པའི་འབྲས་བུ་རང་གིས་མྱོང་བ་སྟེ།",
    "འདུ་ཁང་ཆེན་མོ།",
    "ལྷ་ཁང་ཆེན་མོ།",
    "གྲྭ་ཤག་ཆེ་ཆུང་ཉིས་བརྒྱ་ལྔ་བཅུ་ལྷག་བཅས་ལོ་ངོ་དྲུག་བརྒྱ་དང་བརྒྱད་ཀྱི་རིང་གི་རྩ་ཆེའི་སྐུ་གསུང་ཐུགས་རྟེན་ཡོ་བྱད་མཆོད་ཆ་སོགས་སྟོར་བཅོམ་ཚབས་ཆེན་ཐེབས་ཀྱང་།",
    "འདུ་ཁང་ཆེན་མོ།",
    "ལྷ་ཁང་ཆེན་མོ།",
    "འོན་ཀྱང་སྤྱི་ལོ་ཆིག་སྟོང་དགུ་བརྒྱ་རེ་བརྒྱད་ལོར།",
    "ཀྲུང་ཧྭམི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་ད་ལྟའི་ག་རས་ར། ། རྣམ་འདྲེན་དམ་པ་དག་གི་བ་ཀའ་དྲིན་རྐྱ་བསྒྲིལ་བ་ལས།",
    "ཁྱད་པར་བྱ་ཁྱུང་དགོན་འདི་ཉིད་དུ་རྗེ་བདག་ཉིད་ཆེན་པོ་སྐུ་ན་ཕྲ་མོའི་དུས་སྟན་ཆགས་ཤིང་།",
    "ཞེས་གསུངས་པ་ལྟར་ས་ཁུར་རྟ་ལ་མི་འབབ་ན་སུ་ལ་འབབ་ཟེར་བ་བཞིན་རང་ཚོད་ཀྱིས་སྤྱི་བྱེའི་དོན་ཆེན་པོ་ལ་བསམས་ནས།",
    "ཕྲན་བུས་ལོ་མང་བོའི་སྔོན་ནས་ཡང་ཡང་གླེང་མོལ་གྱིས་སྐུལ་མ་བཏབ་པ་ལྟར།",
    "གླེ་ཐུང་གི་དགེ་སློང་བསམ་གཏན་རྒྱ་མཚོ།",
