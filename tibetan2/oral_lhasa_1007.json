    "ཞི་བའི་ལས་ཀྱི་དགང་གཟར་གྱི་དབྱིབས་ནི་ཟླུམ་པོར་བྱས་པ་སྟེ།",
    "ལྷ་ལ་དབུལ་བར་བྱ་བའི་ཕྱིར་ཇི་ལྟར་རིགས་པར་བློས་རྣམ་པར་ཕྱེ་ཞེས་པ་ལ།",
    "བཞི་པ་ལ་སོགས་པ་ལས་བཞི་གང་ལྟར་བྱེད་པ་ལ་གཟར་བུ་གང་ལྟར་རིགས་པ་བཞིན་དུ་དེའི་དུས་སུ་བློས་རྣམ་པར་ཕྱེ་ནས་བྱེ་བྲག་ཏུ་བྱས་ཏེ།",
    "ལས་ཀྱི་རྗེས་སུ་མཐུན་པར་སྦྱར།",
    "ཞེས་པ་ནི་ལས་བཞི་གང་བྱེད་པ་དང་རྗེས་སུ་མཐུན་པར་བྱའོ།",
    "བསམ་རྒྱུད་རྣམས་ཏེ་ལས་རྣམ་བཞིའི་བྱེ་བྲག་ཇི་ལྟ་བ་བཞིན་དུ་རྗེས་སུ་མཐུན་པར་བྱའོ།",
    "ཉའི་ཉིན་པར་མགོ་གཟུགས་སོ།",
    "ཡང་ན་ཞེས་པའི་སྒྲས་ནི་རྣམ་པ་བཞིན་དུ་སྟོན་པར་བྱེད་པ་སྟེ།",
    "རྡོ་རྗེ་རིགས་ཀྱི་ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པ།",
    "བདག་མི་གཉིས་པར་གྱུར་པའི་རྣལ་འབྱོར་མངོན་དུ་བྱའོ་ཞེའོ།",
    "ལུགས་སུ་བྱས་པ་དང་།",
    "རྡོ་རྗེ་བསྲུང་བ་བརྟན་བྱས་ནས།",
    "རྡོ་རྗེ་བཅིང་བ་བསྡམ་པར་བྱ།",
    "རྡོ་རྗེ་བསྲུང་བ་བརྟན་བྱས་ཏེ།",
    "རྡོ་རྗེ་བཅིང་བ་བསྡམ་པར་བྱ།",
    "དེ་ལྟར་བྱས་པའི་རྗེས་ལ་ལག་པ་གཉིས་རྡོ་རྗེ་བཅིང་བ་བསྡམས་ལ།",
    "སྔགས་དེ་བརྗོད་པས་རྡོ་རྗེ་མེ་ཉིད་མི་ཏའི་མེ་གཟུགས་སུ་དམིགས་ནས་དེའི་ཆ་ལུགས་སུ་དམིགས་པར་བྱའོ།",
    "མེ་ཏོག་ལ་སོགས་པ་རིམ་པར་བྱིན་ལ།",
    "ཞེས་གསུངས་པའི་ཡམ་ཤིང་ངམ།",
    "དེའི་འོག་ཏུ་རྡོ་རྗེ་སེམས་མས་བཟླས་བརྗོད་བྱས་པའི་མཆོད་ཡོན་གྱི་སྣོད་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "ཇི་ལྟར་བྱས་པས་ཡུད་ཙམ་ཅིག་དྲན་པའི་ལུམ་་དུ་བྱས་ནས་ཞེས་པ་ནི།",
    "ཕྱིར་དོར་ཀ་ནས་ཡང་བཟླས་ལ་མེ་ཏོག་དེ་མེའི་ནང་དུ་དོར་ནས་དེར་བཞུགས་སུ་གསོལ་ནས་ཡེ་ཤེས་སེམས་དཔའ་དེ་མེའི་ནང་ན་པདྨའི་ནང་ན་བཞུགས་པར་བསམས་ནས།",
    "ཆོ་ག་འདི་ཡང་བྱ་སྟེ་ཞེས་པ་ནིདེ་ལྟར་སྦྱིན་སྲེག་བྱེད་པའི་ཚེ་ཆོ་ག་འདི་ཡང་ཡིད་ལ་བསམ་པར་བྱ་སྟེ།",
    "ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་མཉམ་པར་གཞག་པར་སྦྱིན་སྲེག་བྱེད་ན་ཞེས་པ་ནི།",
    "ལག་པ་གཡོན་པ་ཁྲོ་བོའི་ཁུ་ཚུར་དུ་བྱས་ཏེ་ཞེས་པ་ནི་། ལག་པ་གཡོན་པ་ཁུ་ཚུར་བཅངས་ཏེ།",
    "ལས་ཀྱི་རྗེས་སུ་མཐུན་པར་ཞེས་པ་ནི།",
    "ཟླུམ་ཞིང་རྣམ་པར་མི་འཕྲོ་བ།",
    "དེ་དག་སོ་སོའི་ཁྱད་པར་གྱི་ཆོ་ག་ཞེས་པ་ནི།",
    "ཇི་ཙམ་འདོད་པར་བྱ་སྟེ་ཞེས་པ་སློབ་དཔོན་ནས་སྒྲུབ་པ་པོ་བདག་ཉིད་ཀྱིས་ཆེ་ཆུང་ཇི་ཙམ་འདོད་པའི་ཚད་དུ་བྱ་བ་སྟེ།",
    "ཐབ་དེ་དང་དབྱིབས་མི་མཐུན་པར་སྟོན་པའི་བྱེ་བྲག་ཁྱད་པར་རོ།",
    "ཐབ་ཀྱི་དབྱིབས་རྡོ་རྗེ་ལྟར་བྱས་ལ་ནང་དུ་ལྕགས་ཀྱུས་མཚན་པའོ།",
    "དེའི་ལྷག་མ་ནི་སྦྱིན་སྲེག་དེ་མ་བྱས་པའི་སྔོན་རོལ་དུ་དང་པོའི་དུས་སུ་བྱ་བའི་ཆོ་ག་དང་།",
    "བྱས་ཟིན་པའི་ཆོ་ག་དང་བྱ་བའི་ཆོ་ག་ནི་ལྷག་མ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ལས་སུ་རུང་བར་བྱས་ནས་བདག་དང་མི་གཉིས་པར་གྱུར་པའི་ཡེ་ཤེས་སེམས་དཔའ་ཞེས་པ་བདག་དང་གང་བསྒྲུབ་༧པའི་ཡེ་ཤེས་སེམས་དཔའ་སོ་སོ་མ་ཡིན་ཐ་མི་དད་དེ།",
    "ཕྱག་རྒྱ་ལོག་པར་བཅིངས་པ་ལ་སོགས་པའོ།",
    "ཕྱིས་སྒྲུབ་པ་ཆེན་པོའི་བྱེད་པའི་དུས་ཉིན་ནི་སྦྱིན་སྲེག་བྱས་པའི་ཆོ་གའོ།",
    "བསྲེག་པར་བྱ་བའི་རྫས་ཡོད་ན་ཡང་ཞེས་པ་ནི།",
    "ཐབ་ཏུ་བཞུགས་སྭཱསུ་གསོལ་བའི་རྡོ་རྗེ་མེའི་གཟུགས་ཀྱང་སྔར་བསྒོམས་པ་བཞིན་དུ་སླར་གསལ་བར་དྲན་པར་བྱས་ལ།",
    "ཚིག་དང་ཡི་གེའི་རྣམ་པའི་༩གླེགས་བམ་དུ་བྱས་པ་ཡིན་ལ།",
    "ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "སྒྲུབ་ཐབས་ཀྱང་དེའི་ལྷ་རྣམས་ཀྱི་སྒྲུབ་ཐབས་སུ་བྱས་པའོ།",
    "ཕྱོགས་གཅིག་ཏུ་བྱས་པའོ།"
  ]
}