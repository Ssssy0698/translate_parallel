    "གཞན་གྱིས་གནོད་པ་བྱས་པ་དེ་སྔར་རང་གིས་ཁོ་ལ་གནོད་པ་བསྐྱལ་བའི་ལེ་ལན་ཡིན་ཅིང་།",
    "ཁོང་ཁྲོ་སྐད་ཅིག་མ་རེས་ཀྱང་བསྐལ་པ་མང་པོར་བསགས་པའི་གཞི་གསུམ་གྱི་དགེ་རྩ་རྣམས་འཇོམས་པར་འདུག་པས།",
    "བདག་གིས་ཁོང་ཁྲོའི་བསམ་པ་ཡིད་ཀྱི་དགུ་ལའང་མི་བྱ་ཨང་སྙམ་གནོད་པ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པ་དང་།",
    "ཉོན་མོངས་གདུང་བའི་དཀའ་ཐུབ་ཀུན་གྱི་ཕུལ།",
    "ཤེས་རབ་ཟབ་མོའི་དེ་ཉིད་བལྟ་བའི་མིག།",
    "གཞན་དོན་བསྒྲུབ་པའི་ཐབས་ཟབ་མོ་འདི་རྣམས་ལ་ཅི་ནས་ཀྱང་བསླབ་པར་བྱ་ལ།",
    "དམིགས་པ་ལས་མི་གཡོ་བར་རྩེ་གཅིག་ཏུ་གནས་པའི་ཞི་གནས་མེད་པར་བདེན་མེད་རྟོགས་༢༣བ་པའི་ཤེས་རབ་ཙམ་གྱིས་ཇི་ཙམ་དཔྱད་ཀྱང་ཉོན་མོངས་བཟློག་མི་ནུས་ཏེ།",
    "ཇི་ཙམ་དཔྱད་ཀྱང་ཉོན་མོངས་མི་བཟློག་པས།",
    "དེ་ལྟར་རྟོགས་ནས་ཐབས་ཤེས་ཡ་བྲལ་བའི་ལམ་ཕྱོགས་རེ་བས་ཚིམ་པ་༢༤བ་མེད་པ་ཐབས་འབད་དགོས་ཏེ།",
    "དེ་ལྟར་རྟོགས་ནས་ཕྱོགས་རེའི་ལམ་གྱིས་ནི།",
    "ལམ་མཆོག་གཉིས་ཀར་དགོས་པའི་ཐུན་མོང་ལམ།",
    "རང་གི་ཡིད་ལ་གོམས་པར་བྱ་ཕྱིར་དང་།",
    "ཐར་འདོད་ཁྱོད་ཀྱང་དེ་བཞིན་འདེབས་འཚལ་ལོ།",
    "ཁྱོད་གསུང་ཉན་ཅིང་སྒོ་གསུམ་བྱ་བ་ཀུན།",
    "ཁྱོད་མཉེས་འབའ་ཞིག་བསྒྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "ལུགས་འདི་ལ་ཤིན་ཏུ་མོས་ཤིང་དོན་དུ་གཉེར་བ།",
    "རབ་འབྱམས་ཞིང་གི་རྒྱལ་བ་ཐམས་ཅད་ཀྱིས།",
    "ཡོངས་འཛིན་བཟང་པོ་གང་གི་སྤྱི་བོས་མཆོད།",
    "བདག་གིས་དུས་གསུམ་བསགས་པའི་དགེ་ཚོགས་དང་།",
    "གང་གི་མཁྱེན་པའི་རྒྱ་མཚོ་མ་ལུས་པ།",
    "མཁས་རློམ་བྱེ་བས་དཔག་པར་མི་ནུས་མོད།",
    "གྲུབ་པའི་མཆོག་བརྙེས་འཛམ་གླིང་གཙུག་གི་རྒྱན།",
    "མཉམ་མེད་ཟླ་འོད་གཞོན་ནུ་གང་གི་དྲུང་།",
    "འགྲོ་བའི་འདྲེན་པ་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "ཡན་ལག་དྲུག་ཅུའི་གསུང་གིས་ལེགས་འདོམས་པས།",
    "ཁྱོད་སྐུའི་དཔག་བསམ་ལྗོན་པ་རབ་རྒྱས་ཤིང་།",
    "མཆོག་དང་ཐུན་མོངས་དངོས་གྲུབ་ཀུན་སྩོལ་བའི།",
    "དགོས་འདོད་རེ་བ་སྐོང་ལ་གསོལ་བ་འདེབས།",
    "འགྲན་བྲལ་མཐུ་སྟོབས་དཔུང་ཚོགས་ཡན་ལག་བཞིས།",
    "མཚུངས་མེད་འཁོར་ལོས་སྒྱུར་བ་ཁྱོད་ལ་འདུད།",
    "ཐུགས་རྗེའི་ཆར་གྱིས་ལུས་ཅན་ནོར་འཛིན་ཁྱོན།",
    "སྐྱབས་གནས་ཀུན་འདུས་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "བདག་གིས་ཚོགས་གཉིས་བསགས་པའི་དགེ་ཚོགས་ཀྱིས།",
    "མ་ལུས་པའི་རྒྱལ་ཕྲན་མཐའ་དག་གི་ཡན་ལག་མཆོག་གི་ཅོད་པན་གྱི་རྒྱན་དུ་ཞབས་སེན་རྣམ་པར་འགོད་པའི་རྒྱ་ནག་གོང་མ་རྒྱལ་པོའི་གདུང་རིགས་དྲི་མ་མེད་པ་མཁྱེན་སྤྱན་ནམ་མཁའ་ལྟར་ཡངས་པའི་རྣལ་འབྱོར་སྤྱོད་པ་དོན་གྲུབ་བཀྲ་ཤིས་ཀྱིས།",
    "རིན་ཆེན་སྣ་ཚོགས་པའི་མེ་ཏོག་གི་སྐྱེས་དང་བཅས་ཏེ།",
    "ས་མོ་ཡོས་ལོ་སྣྲོན་ཟླ་བའི་དགའ་བ་གཉིས་པའི་ཚེས་ལ་སྦྱར་བའོ།",
    "དཔལ་ཐུགས་རྗེའི་བདག་ཉིད་སྤྱན་རས་གཟིགས།",
    "རྐྱེན་ཕྱི་ནང་གི་བར་ཆད་ཞི་བར་མཛོད།",
    "མཚན་ལྡན་ལུས་ཀྱི་ན་ཚོད་ཕྲ་མོ་ནས།",
    "ཅེས་རང་གིས་རང་ལ་བསྟོད་པ་མི་འོས་པ་འདུག་ཀྱང་།",
    "ཕུལ་བྱུང་རྣམ་དཔྱོད་གཞན་ཕན་མཆོག་གི་རྗེ།",
    "འདུན་ལྡན་རྒྱུ་སྐར་ཚོགས་ཀྱི་རེ་སྐོང་བ།",
    "གྲུབ་རིགས་རྒྱ་མཚོའི་ཁྱོན་ལས་ལེགས་འཁྲུངས་ཤིང་།",
    "མཁྱེན་པའི་སྤྱན་ཡངས་ནམ་མཁའི་ཁྱོན་ལས་བརྒལ།",
    "གསང་སྔགས་ཟབ་མོའི་ལམ་བཟང་སྟོན་མཁས་པའི།",
    "ཟབ་མོའི་ལམ་གྱི་འཇུག་པ་བརྟན་མཛད་ནས།",
    "སོ་སོའི་ཞལ་ཡིག་ཏུ་འདི་ལྟར་དུ་ཤོ་ལོ་ཀ་རེ་རེ་བྱས་ནས་ཡོད་པ་ལགས།",
    "ཁྱོད་ཀྱི་རང་བཞིན་ངག་གི་ཡུལ་འདས་མོད།",
    "ཁྱོད་སྐུ་ཨིནྡ་རྙིལ་ལྟར་རབ་སྔོ་བའི།",
    "རབ་རྟོག་གི་རྒྱན།",
    "ཟབ་མོའི་ངང་ལས་གཡོ་བ་ཉིད་མིན་ཡང་།",
    "གང་དུ་འཛིན་དེས་གཡོ་མེད་རི་མོར་བགྱིད།",
    "ནང་དུ་ཉོན་མོངས་བུད་ཤིང་ཀུན་བསྲེགས་པའི།",
    "བདེ་གཤེགས་ལྔ་ཡི་ཅོད་པན་བདེ་འབྱུང་གི།",
    "ཉེས་པའི་དགྲ་ལས་རབ་ཏུ་རྒྱལ་བ་ཁྱོད།",
    "རྒྱལ་ཐབས་ཀུན་གྱི་རྩེ་མོར་སོན་པ་ཁྱོད།",
    "རྩེ་མོ་ནས་ལྷུང་ཆག་དུམ་འཐོར་བ་འདྲའི།",
    "རྒྱན་དྲུག་རྒྱན་གྱིས་མཆོག་གི་སྐུ་ལ་སྤྲས།",
    "ཞབས་གཉིས་སེམས་དཔའི་དཀྱིལ་མོ་ཀྲུང་གིས་བཞུགས།",
    "ལང་ཚོའི་གཟུགས་ཅན།",
    "ནུ་འབུར་ཟུང་གི་འབྲས་བུའི་ཁུར་གྱིས་དུད།",
    "དྲི་མེད་ཆུ་སྐྱེས་ཡོངས་རྒྱས་རེག་པས་ཀྱང་།",
    "ཡོངས་དག་ལྷ་མོ་གཟུགས་ཅན།",
    "ཁྱོད་ལ་རྟག་ཏུ་འདུད།",
    "བདེ་ཆེན་ཡེ་ཤེས་བསྐལ་པའི་མེ་དཔུང་གིས།",
    "མངྒ་ལཾ། ། དཔལ་ལྡན་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་དྲག་པོའི་སྦྱིན་སྲེག་གི་ལས་མཐའ་སྲིད་གསུམ་ཟ་བའི་སྲེག་ཁང་འབར་བ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོའི་ཕྲིན་ལས་དྲག་པོའི་སྦྱིན་སྲེག་གི་ལས་མཐའ་སྲིད་གསུམ་ཟ་བའི་སྲེག་ཁང་འབར་བ།",
    "འདིར་དྲག་པོའི་སྦྱིན་སྲེག་གིས་དགྲ་གསད་པའི་ཆོ་ག་ལ་བཞི།",
    "གང་གིས་བྱེད་པ་པོ་དང་གང་ལ་བྱ་བའི་ཡུལ་གྱི་ཁྱད་པར།",
    "ཐམས་ཅད་སྦྱིན་སྲེག་དག་གིས་སྐོང་།",
    "སྦྱིན་སྲེག་གི་ནི་བསྔགས་པ་མཛད།",
