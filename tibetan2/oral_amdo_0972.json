    "གནོད་པར་བྱ་བ་ནི་ཕུང་པོ་ལྔ་ཀ་སྟེ་ལག་པ་ལ་སོགས་པའི་འདུས་ཏེ་རེག་པ་དང་།",
    "དེ་ལྔ་ནི་དངོས་དང་བཏགས་པ་ཐུན་མོང་བའོ།",
    "ཕྱི་རོལ་དུ་བལྟས་པ་སོགས་དྲུག་ནི་འོག་ཏུ་འཆད་པ་ལྟར་ཚོར་བ་སོགས་དང་ཐུན་མོང་གི་དབྱེ་བ་སྟེ།",
    "གསུམ་པ་ལ་མིག་གི་ཡུལ་ནི་འདི་ནི་འདི་ནའོ།",
    "ཕ་གི་ནི་ཕ་གི་ནའོ་ཞེས་པ་ཕ་རོལ་པོ་ལ་བསྟན་དུ་ཡོད་པའོ།",
    "བཞི་པ་བསྟན་མེད་ནི་བསྟན་ཡོད་ལས་བཟློག་པ་སྟེ་མིག་གི་ཡུལ་མ་ཡིན་པ་དང་བསྟན་ཡོད་ཀྱི་ངོ་བོ་དང་བྲལ་བ་སོགས་ཞེས་སྦྱོར་རོ།",
    "ལྔ་པ་ཐོགས་བཅས་ཀྱི་མཚན་ཉིད་ལ་གསུམ་ལས་དངོས་བཏགས་ཐུན་མོང་དུ་བསྟན་པ་ནི།",
    "ཐམས་ཅད་དུ་མ་སོང་བ་ནི་ཐོགས་རྡུག་དང་བཅས་པའོ།",
    "ཐོགས་པ་དང་ཞེས་ཏེ་དངོས་བཏགས་ཐུན་མོང་པས་བསྟན་མེད་གང་ཡིན་དང་།",
    "རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ཏེ་ངོ་བོར་གྱུར་པའི་ཟག་པ་དང་ལྷན་ཅིག་འཇུག་པས་སོ།",
    "རྗེས་སུ་མཐུན་པ་ནི་ངེས་འབྱེད་ཆ་མཐུན་ལས་གཞན་པའི་ཉོན་མོངས་པའི་ས་བོན་ཅན་ཡིན་ཅིང་།",
    "འདིས་དེ་ནི་ཉོན་མོངས་པའི་ས་བོན་དང་ལྡན་ཡང་ཟག་མེད་དུ་གཞག་པའི་དོན་དུ་སྟེ།",
    "ཚེ་སྔ་རབས་ཀྱི་ཉོན་མོངས་ལས་བྱུང་བས་སོ་ ཉེ་བར་ལེན་པའི་ཞེས་པ་ཟག་པའི་སྒོ་དང་པོས་འདུ་བྱེད་ཕུང་པོའི་ཕྱོགས་གཅིག་རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་ཟག་བཅས་ཏེ།",
    "འཐབ་པ་མེད་པ་ནི་འཐབ་བཅས་ལས་བཟློག་པ་སྟེ་འཐབ་པའི་རྒྱུ་བྱེད་པའི་ལྡོག་པ་ནས་འཐབ་པར་བཞག་པའི་དུག་གསུམ་དང་སྒོ་དྲུག་གིས་མ་འབྲེལ་བའོ།",
    "དེ་སྒྲུབ་པ་ནི་དེ་རྣམས་ལམ་གྱི་བདེན་པས་བསྡུས་པའི་ཕྱིར་དགོངས་གཞི་མེད་པར་འདུས་བྱས་མ་ཡིན་པར་བརྗོད་མི་ནུས་པ་དེ་ནི་ལས་ཟག་བཅས་དང་ཉོན་མོངས་པས་ཞེས་དང་།",
    "སྐྱེ་འགག་མེད་པའི་དོན་གང་གིས་འདུས་བྱས་སུ་གྱུར་པ་དེས་ཞེས་དང་།",
    "ཁམས་གསུམ་པར་གཏོགས་པ་དེའི་སྲེད་པས་བདག་གིར་བྱས་པ་དང་།",
    "རྒྱས་ལས་བྱུང་བ་ནང་གི་ལྔ།",
    "སྐྱེ་བའི་སྲིད་པ་ཉོན་མོངས་ཅན།",
    "གཞན་རྣམས་གསུམ་མོ་གཟུགས་མེད་གསུམ།",
    "རང་མཚན་དང་སྤྱིའི་མཚན་ཉིད་དུ་མའི་ཐུན་མོང་བ་དུས་གསུམ་ཐམས་ཅད་པའི་ཡུལ་སོ་སོ་མིན་པར་ཐམས་ཅད་འཛིན་པ་ཡིད་ཤེས་སོ།",
    "ཞེས་པ་ལྟ་བུ་ཡུལ་ཀུན་ཀྱང་བདག་གི་ངོ་བོར་འདོད་པ་སྤོང་བའོ།",
    "ཉོན་མོངས་ཅན་གྱི་མཚན་ཉིད་ལ་གཉིས་ལས།",
    "ཡིད་དེ་དང་མཚུངས་ལྡན་གྱི་ཉོན་མོངས་བཞི་པོ་སོགས་དང་།",
    "གཟུགས་དང་གཟུགས་མེད་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་ཡང་ཏིང་ངེ་འཛིན་གྱིས་རྩེ་བཅིལ་བས་སོ།",
    "མཚན་ཉིད་ཀྱི་རྣམ་པ་འདི་རྣམས་ཀྱང་ཕན་ཚུན་ལ་ལྟོས་པ་རེ་རེས་ཀྱང་མཚོན་ནུས་ཀྱང་ཤེས་རབ་བསྐྱེད་པའི་ཆེད་དུ་བཀོད་པའོ།",
    "རྒྱུས་རང་གི་འབྲས་བུ་བསྐྱེད་ཟིན་པ་དང་འབྲས་བུ་མྱོང་ནས་ཞིག་པའོ།",
    "རང་གི་མཚན་ཉིད་དེ་འཇོག་བྱེད་ཀྱི་རྫས་མེད་པ་དང་།",
    "རང་གི་མཚན་ཉིད་དེ་རང་བཞིན་མ་ཐོབ་ཅིང་མ་གྲུབ་པ་དང་།",
    "ཉོན་མོངས་པ་དང་རྣམ་བྱང་མི་གནས་ཏེ་བྱེད་པ་མ་ཐོབ་པ་དང་།",
    "རྒྱུ་ཡོད་ཅིང་འབྲས་བུའི་རང་གི་མཚན་ཉིད་མེད་པ་དང་།",
    "དེའི་སྐབས་ཀྱི་ཉོན་མོངས་དང་རྣམ་བྱང་གིས་སེམས་དེ་ལྟར་བྱེད་ནུས་པ་དང་།",
    "འོ་ན་དངོས་པོ་ཀུན་གྱི་རང་གི་མཚན་ཉིད་ཀྱང་རྟོག་པའི་ཡུལ་མ་ཡིན་པས་བརྗོད་དུ་མེད་དོ་ཞེ་ན།",
    "བདེན་མོད།",
    "དད་སོགས་མཚུངས་ལྡན་དང་བཅས་པ་དེས་ཀུན་ནས་བསླངས་ཞིང་བསྐྱེད་པའི་ལུས་ངག་གི་ལས་རྣམ་རིག་དང་དེ་མིན་དག་གོ།",
    "དོན་མཐུན་པ་ནི་ཡིན་ཞེས་བྱ།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་ནི་བདག་མེད་པ་མངོན་སུམ་དུ་བྱས་པའི་ཕྱིར་སྤངས་པ་ཡིན་ལ།",
    "དེའི་དོན་བསྡུས་པ་ནི་རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་པ་གཏུགས་པར་སྤོང་བའོ།",
    "དེ་རྣམས་ཉོན་མོངས་ཉེ་བར་ཞི་བའོ།",
    "འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ནི་སྙོམ་འཇུག་གི་སྒྲིབ་པ་ཞི་བའམ་ཉོན་མོངས་པའི་རྒྱུ་ཞི་བའོ།",
    "ཉེས་སྤྱོད་ཀུན་ནས་སློང་བྱེད་ཀྱི་ཉོན་མོངས་དང་ཉེ་བའི་ཉོན་མོངས་དང་མཚུངས་ལྡན་རྣམས་འབྲེལ་པས་དང་།",
    "དང་པོ་ལ་ཉོན་ཡིད་དང་མཚུངས་ལྡན་དང་གཟུགས་དང་གཟུགས་མེད་ཀྱི་མ་གཏོགས་པ་ནི་ལུང་མ་བསྟན་ཡིན་པས་སོ་ དེ་ལས་གཞན་པའི་རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་ལུས་སོགས་ཀྱི་ཉེས་སྤྱོད་ཀུན་ནས་སློང་ནུས་འདོད་ཁམས་ཀྱི་ཀུན་བརྟགས་དང་ལྷན་སྐྱེས་ལས་ཉེས་སྤྱོད་ཀུན་ནས་སློང་ནུས་ཏེ།",
    "ལུས་ངག་གི་ལས་ནི་སྲོག་གཅོད་དང་བརྫུན་སོགས་ཏེ་འདིར་ཡིད་ཀྱི་ལས་མི་སྨོས་པ་ནི་འབྲེལ་པ་ཁོ་ནས་སེམས་པ་དགེ་མི་དགེ་གྲུབ་པའི་ཕྱིར་རོ་ཞེའོ།",
    "ཆགས་དང་དྲེ་མོའི་གཏམ་ལ་དགའ།",
    "ཊཱི་ཀཱར་ནི་སོ་སོར་བརྩིས་ཏེ་རང་གིས་དཔྱད་པས་ཤེས་སོ།",
    "ཉོན་མོངས་ཅན་ནི་ལོངས་སྤྱོད་སྤྱད་པའི་སྒོ་ནས་དགྲ་ལ་གནོད་པ་བྱ་སྙམ་པ་སོགས་སོ།",
    "ཁམས་གོང་མའི་རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་ནི་བསྒྲིབས་པའི་ལུམ་མ་བསྟན་ཏེ།",
    "འདུས་མ་བྱས་སྨོས་པ་ནི་རིགས་པའི་རྣམ་གཞག་སྟེ་སོ་སོར་བརྟགས་འགོག་དང་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ནི་གཉིས་མིན་དུ་བརྗོད་མི་ནུས་སོ་ཞེའོ།",
    "མཐོང་སྤང་སོགས་སྤང་བྱ་ཡིན་མིན་གསུམ་གྱི་དང་པོ་ཀུན་ནས་ཉོན་མོངས་གསུམ་སྟེ།",
    "ཐེ་ཚོམ་ཉོན་མོངས་ཅན་ཡང་ཀུན་བརྟགས་ཁོ་ནའོ།",
    "མཐོང་བས་སྤང་བྱ་ལྟ་བ་ཉོན་མོངས་ཅན་ཀུན་བརྟགས་སོགས་ལས་བཟློག་པ་སྟེ།",
    "ལྟ་བ་ཉོན་མོངས་ཅན་ལྷན་སྐྱེས་དང་དེ་ལ་གནས་པའམ་དེའི་གནས་དང་།",
    "ཉོན་མོངས་ཅན་མིན་མཐོང་སྤང་མིན།",
    "གཞུང་ལུགས་བཟང་པོ་དེས་ན་ཁྱོད།",
    "འདི་ཡོད་ན་ནི་འདི་འབྱུང་ཞེས་རྒྱུའི་འདུན་པ་བཀའ་སྩལ་བའི་རྒྱུ་སྟེ་རྐྱེན་ཚོགས་པ་ཡོད་ན་འབྲས་བུ་འབྱུང་གི་འབྲས་བུ་འདི་བསྐྱེད་པར་བྱ་སྙམ་པའི་བློའི་གཡོ་བ་རྐྱེན་ལ་མེད་པའི་ཕྱིར་རོ།",
    "མ་རིག་པའི་རྐྱེན་གྱིས་འདུ་བྱེད་ཅེས་སོགས་བཀའ་སྩལ་བའི་རྒྱུ་སྟེ་རྐྱེན་ཅི་རུང་བས་འབྲས་བུ་ཀུན་མི་འབྱུང་གི་སོ་སོར་ངེས་པ་ལས་སྐྱེ་བའོ།",
    "དེ་རེག་པ་སྐྱེ་བའི་རྟེན་བྱེད་ན་རེག་པའི་སྐྱེ་མཆེད་དྲུག་ཏུ་བསྡུ་བར་གསུངས་སོ།",
    "དོན་གསང་དུ་ཡང་སྔ་མ་ཁུངས་སུ་བྱས་ཏེ་རྨོངས་པ་ནི་འདིར་མཐོང་བས་སྤང་བར་བྱ་བའི་མ་རིག་པའོ་ཞེས་གསུངས་པས་མཐོང་སྤང་སྟེ་ཡང་སྲིད་འཕེན་པའི་ཉོན་མོངས་ཡིན་པས་སོ།",
    "འཕགས་པ་ལ་གྲོགས་མཐོང་སྤང་གི་མ་རིག་པ་མེད་པས་སོ་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་འདི་གཉི་ག་ཡིན་ལ་བྱིས་པའི་གཉི་ག་ཇི་རིགས་པས་ཡང་སྲིད་འཕེན་ཅིང་འཕགས་པའི་སྒོ་སྤང་དེས་མི་འཕེན་པ་ནི་སྒོམ་སྤང་གི་མ་རིག་པ་ལ་འཕེན་པས་ཁྱབ་པ་མེད་པས་ཏེ་ཏིལ་མར་བསྐུས་པའི་ས་བོན་གྱིས་མྱུ་གུ་མི་སྐྱེད་པ་དང་འདྲའོ་སྙམ་མོ།",
    "འདི་རྣམས་ཀྱིས་ནི་ཟག་མེད་ཀྱིས་རྣམ་སྨིན་འཕེན་པར་ཐལ་བར་འགྱུར་བའང་སྤངས་སོ།",
    "གོང་མ་གཉིས་ན་བཅུ་གཉིས་པོའི་ཕྱོགས་རེ་ཡོད་ཅིང་གོང་མ་ན་རྒ་བ་ཅི་ལྟར་ཡོད་ཅེ་ན།",
    "དེ་ཡང་ཚེ་སྔ་མའི་ཉོན་མོངས་པ་ཀུན་མ་རིག་པ་སྟེ།",
    "མ་རིག་སྔོན་གྱི་ཉོན་མོངས་སྐབས།",
    "རེག་པ་བདེ་སྡུག་ལ་སོགས་ཀྱི།",
    "ཡན་ལག་རེ་ལ་ཕུང་པོ་ལྔ་ཆར་ཡོད་ན་ཅིས་མ་རིག་པ་སོགས་སུ་བརྗོད་ཅེ་ན།",
    "ཉོན་མོངས་གསུམ་མོ་ལས་གཉིས་སོ།",
    "འདིར་ནི་མངལ་སྐྱེས་ཀྱི་སྲིད་པ་གཅིག་གི་མགོ་བརྩམས་ནས་མཇུག་རྫོགས་ཀྱི་བར་རྒྱུ་འབྲས་ཚར་གཅིག་སྟེ།"
  ]
}