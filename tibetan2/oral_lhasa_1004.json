    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཁོ་ནས་བསྟན་ལ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཚུལ་འདི་ཉིད་ཀྱིས་སྐུ་ཕྱག་རྒྱ་ཡང་འདི་བཞིན་དུ་བསྟན་པ་ཡིན་ཏེ།",
    "མཐོ་རིས་ལྷ་རྣམས་ཀྱི་གན་དུ་གཤེགས་ནས་གསང་སྔགས་ཀྱི་རྒྱུད་ཆེན་པོ་སྟོན་པར་མཛད་ཅིང་དེའི་དཀྱིལ་འཁོར་ཆེན་པོའི་བདག་པོར་བཞུགས་ནས།",
    "དཀྱིལ་འཁོར་གྱི་དོན་ཡོངས་སུ་འཆད་པར་མཛད་ན།",
    "དེ་ལྟ་ན་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱང་ཐ་དད་པར་འགྱུར་ཏེ།",
    "མི་མཉམ་པའི་རྣམ་པར་དབྱེ་བ་གསུངས་པའི་དོན་ཡང་དེ་ལྟར་མ་ཡིན་ཞིང་རྣམ་པ་གཞན་དུ་འགྲུབ་པའི་རྒྱུར་གྱུར་ན།",
    "ཆ་ལུགས་མི་མཐུན་པར་སྟོན་པས་རང་བཞིན་གཞན་དུ་འགྱུར་བ་མེད་དེ།",
    "ཇི་ལྟར་དཔེར་ན་ཤེས་རབ་ཀྱི་རང་བཞིན་༤གྱིས་བསྒྱུར་བ་བཞིན་པས་ཇི་ལྟར་བསྟན་པ་ལ་འགལ་བ་མེད་པར་ཤེས་པར་བྱའོ།",
    "ཨོཾ་ཡ་བཏྟ་ཐཱ་ག་ཏ་ཤྱ་ཐཱ་ཨཱ་ཧཱུཾ་ཞེས་བྱ་བའི་སྔགས་འདི་བརྗོད་པའི་དོན་ནི་འབྲས་བུའི་དོན་སྡུད་པར་བྱེད་པ་སྟེ།",
    "འདིས་ཀྱང་འོག་མ་འདི་ལྟར་གྲུབ་པར་བྱེད་ཅེས་པའོ།",
    "གསུང་དང་ཐུགས་རྣམས་སྡུད་པར་བལྟའོ་ཞེས་བྱ་བ་འདི་ཁོ་ནའོ།",
    "རྒྱུད་འགའ་ནས་གསུངས་པར་མ་ཟད་ཀྱི་རྒྱུད་མང་པོ་དག་ལས་དོན་མཐུན་པར་གསུངས་ཏེ།",
    "གནས་ངན་ལེན་པས་གྲོལ་ཞིང་གཉེན་པོས་སྒྲིབ་པའི་རྣམ་པར་རྟོག་པ་བསལ་བས་ན།",
    "རྣམ་པར་རྟོག་པ་སྤངས་པའི་ཞེས་བྱའོ།",
    "ས་དང་ཕ་རོལ་ཕྱིན་པ་ལ་སོགས་པ་རྣམ་པར་དཀར་བའི་ཕྱོགས་ཡོན་ཏན་གྱི་ཆ་རྫོགས་པས་ན།",
    "ཚོགས་རྣམ་པ་གཉིས་རྫོགས་པས་སྟུག་པོར་གྱུར་པ་ལས་བྱུང་བས་དེ་ཉིད་ཀྱི་དཀྱིལ་ན་ཟླ་བ་ཡོངས་སུ་གང་བ་ལྟར་གནས་པར་མཐོང་བས།",
    "ས་དང་ས་མིན་ཤིན་ཏུ་མཁྱེན།",
    "དེ་ལྟ་བུའི་ཡོན་ཏན་གྱི་རྣམ་པར་རྫོགས་པའི་ཟླ་བའི་སྟེང་དུ་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཐུགས་ཀྱི་མཚན་མ་རྡོ་རྗེ་གནས་པར་བརྟགས་པ་ལ་ནི།",
    "ཞེས་བྱའོ་། རྩེ་ལྔ་པའི་རྡོ་རྗེ་གནས་པར་བརྟགས་པ་ལ་ནི།",
    "མ་སྐྱེས་མ་བྱས་པ་དག་སྟེ།",
    "དངོས་དང་དངོས་མེད་རྣམ་པར་སྤངས།",
    "མཚོན་ཆ་ལ་སོགས་པས་གཅད་པར་མི་ནུས་ཤིང་མུ་སྟེགས་ལ་སོགས་པའི་ལྟ་བ་ངན་པས་མི་ཤིགས་ཤིང་མེས་ཚིག་པར་མི་ནུས་པས་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གང་གསུངས་པ་ཞེས་པ་ནི།",
    "ལྔ་པ་སྐུ་ཕྱག་རྒྱ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་པའི་མཚན་ཉིད་དུ་གནས་པར་གྱུར་པ་ནི་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་སོ་ཞེས་ཟེར་ན།",
    "ཕྱིས་བསྟན་པར་རིགས་པར་མངོན་ཏེ།",
    "དེ་ལ་ལན་བཏབ་པདེ་ལྟར་ཡིན་གྱིས་ཀྱང་རྣམ་པར་དབྱེ་བ་བརྩམས་པ་ཡང་འགལ་བ་མེད་དོ།",
    "དེ་བས་ན་འདི་ལྟར་བསྟན་པ་ཡང་འགལ་བ་མེད་པར་དགོངས་པའོ་ཞེས་ཟེར་རོ།",
    "དེ་ལས་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་རྡོ་རྗེ་རྩེ་ལྔ་པར་གྱུར་པ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པ་ནི་འབྲས་བུ་ཡེ་ཤེས་ཞེས་བྱ་སྟེ།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པའི་ཏིང་ངེ་འཛིན་ཤིན་ཏུ་བསྒོམས་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུད་ལས་ཀྱང་དེའི་གཏན་ཚིགས་གསུངས་པ།",
    "དེ་ལྟར་སེམས་བརྟག་པའི་རིམ་པ་མངོན་དུ་བྱས་ན།",
    "དེ་ལྟར་བྱས་ནས་ཡང་དེའི་ཀྲི་རྟིང་ཐོགས་སུ་འདི་ལྟར་བྱ་སྟེ།",
    "རྒྱུད་༥༤ཀྱང་རྒྱུད་ལས་འདི་སྐད་དུ་གསུངས་ཏེ།",
    "ལྷའི་སྐུར་གནས་པའི་ངོ་བོ་སྟོན་པར་མཛད་པས་ན།",
    "ཉིད་ཀྱིས་བསྡམས་ནས་བསྟན་པར་འགྱུར།",
    "བཛྲ་ཧཱུཾ་ཞེས་པ་ནི་ཇི་ལྟར་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་རྡོ་རྗེ་དབྱིངས་ཉིད་སྐུ་འགྱུར་བ་བསྟན་པའི་ཕྱིར།",
    "བྱིན་གྱིས་བརླབ་པའི་སྔགས་གསུངས་པའི་སྣ་ལ་སྨོས་པ་དེ་བརྗོད་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཞེས་པ་ནི།",
    "རྩ་བའི་རྒྱུད་ཆེན་པོ་དེ་ཁོ་ན་ཉིད་བསྡུས་པ་ཉིད་ལས་གསུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་ཕྱག་རྒྱ་ཆེན་པོར་སྣང་བ་སྦས་ནས།",
    "དེ་བཅིང་བའི་ཐབས་ནི་འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "སྔགས་འདི་ཡང་དེ་དང་སྦྱར་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ཡང་རྩ་བའི་རྒྱུད་ལས་གསུངས་པ།",
    "སེང་གེའི་གདན་ཁྲི་ལ་བཞུགས་ཤིང་།",
    "རྒྱུདའི་༥༤༤འདོད་པ་དག་འདི་ལྟ་བུའི་ཚུལ་འཛིན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་ཀྱང་གླེང་ངོ།",
    "རབ་ཏུ་གནས་པར་བསམས་ནས་ནི།",
    "དཔྲལ་བའི་གནས་དེ་ནི་བརྟན་པར་གནས་པར་བརྟག་པའོ།",
    "རྡོ་རྗེ་རིན་ཆེན་ཞེས་བྱས་ནས།",
    "ཞེས་པ་ནི་བཛྲ་རཏྣ་ཞེས་བརྗོད་པར་བྱའོ།",
    "རྡོ་རྗེ་བཅིངས་པ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་སྟེ།",
    "ད་ནི་ཏིང་ངེ་འཛིན་གྱི་དོན་གསུངས་ཏེ།",
    "ཡང་དག་པའི་ཏིང་ངེ་འཛིན་གྱི་དོན་ངེས་པར་གཏན་ལ་འབེབས་པའི་བསམ་གཏན་ལ་གནས་པར་བྱ་དགོངས་པའི་ཕྱིར་ན་ཏིང་ངེ་འཛིན་བསྟན་ཏོ།",
    "ཡང་ཡུད་ཙམ་གྱིས་མི་འགྲུབ་པར་གསུངས་པས་ན་ཡུན་ཐུང་བ་དགག་པའོ།",
    "དེ་ལྟར་ཡང་རྩ་བའི་རྒྱུད་ཆེན་པོ་དཔལ་དེ་ཁོ་ན་ཉིད་བསྡུས་པ་ལས་འདི་སྐད་དུ་གསུངས་ཏེ།",
    "པའི་རིམ་གྱིས་ཚོགས་རྣམ་པ་གཉིས་རྫོགས་པར་བྱས་ནས།",
    "ཕྱག་རྒྱ་རྣམ་པ་བཞི་དང་ལྡན་པར་བྱ་བ་ལ་ནི་མཉམ་གཞག་ཅེས་བྱ་བཅིངས་པ་དང་བསམས་པའི་རིམ་པས་དེའི་ངང་ལ་གནས་པར་བྱའོ།",
    "ཞེས་པ་ནི་བདག་ཉིད་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་སྔགས་དང་རིག་པ་བཟླས་ནས་དེ་ལྟར་གནས་པར་བྱ་བ་སྟེ།",
    "དེས་མྱུར་དུ་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "བ་འགྲུབ་པར་བསྟན་པའོ།",
    "རྫུ་འཕྲུལ་གྱི་སྟོབས་ཀྱིས་དེ་ལྟར་འགྲུབ་པར་ཟད་ཀྱི་གཞན་རྣམས་ཀྱིས་དེ་ལྟར་ནུས་པ་དང་།",
    "ངེལྟར་ཡང་རྩ་བའི་རྒྱུད་ལས་གསུངས་པ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པར་བྱ་བའོ།",
    "ཞེས་གསུངས་སོ།",
    "བྱིན་གྱི་བརླབས་པ་ནི་ཤར་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ཐུགས་ཀྱི་བདག་ཉིད་བདེ་བར་གཤེགས་པའི་སྲས་ཀྱི་གཙོ་བོར་བྱིན་གྱིས་རློབ་པར་མཛད་པ་སྟེ།",
    "དཔེར་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་སྲས་མཚན་དང་ལྡན་པར་གྱུར་པ་ལྟ་བུའོ།",
    "ཏིང་ངེ་འཛིན་ནི་ནུབ་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཐུགས་ཀྱི་བདག་ཉིད་དུ་བྱིན་གྱིས་རློབ་པར་མཛད་པའི་ཏིང་ངེ་འཛིན་དང་ལྡན་པར་མཛད་པ་སྟེ།",
    "ཆ་ལུགས་དང་ཚུལ་དེ་ལྟ་བུ་དང་ལྡན་པ་དེ་ཁོ་ན་ལ་ལྡན་པར་ཤེས་པར་བྱའོ།",
    "སེམས་དཔའ་ཆེན་པོ་གཞན་རྣམས་ཀྱི་ཡང་གསུངས་པ།",
    "རྡོ་རྗེ་ལེགས་པ་ལ་སོགས་པ་སེམས་དཔའ་ཆེན་པོ་བཅུ་དྲུག་པོ་གཞན་རྣམས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོའི་མཚན་ཉིད་ནི་འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "སེམས་རྟོགས་པ་ལ་སོགས་པའི་སྔར་གསུངས་པའི་ཚུལ་གྱིས་ཇི་ལྟར་བྲིས་པའི་ཚུལ་བཞིན་དུ་ཞེས་ཏེ།",
    "སེམས་དཔའ་དེ་དག་སོ་སོའི་ཆ་ལུགས་གཞུང་དང་མཐུན་པ་བཞིན་དུ་ཇི་ལྟར་བཟོ་བོ་མཁས་པས་གཟུགས་བྲིས་པའི་ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་མཚན་མའི་ཕྱག་རྒྱ་དང་ལྡན་པ་ཞེས་པ་ནི་སོ་སོའི་ཕྱག་མཚན་དང་ལྡན་པར་བསྒོམས་ན།",
    "སོགས་པའི་སྒྲས་ནི་སེམས་དཔའ་ཆེན་པོ་བཅུ་དྲུག་རྣམས་སྡུད་པར་བྱེད་པའོ།",
    "དབབ་པ་ལ་སོགས་པའི་རིམ་པ་གོང་དུ་རྒྱས་པར་བསྟན་ཟིན་ན།",
    "རང་བཞིན་མེད་པའི་དོན་མངོན་དུ་བྱས་ལ།",
    "དེ་ཡང་ཞི་གནས་ཀྱི་མཐུས་སྤངས་ཏེ་ཞེས་པ་དེ་ལྟར་དམིགས་པ་དེ་ཡང་བསམ་གཏན་ལ་འཇོག་པའི་དུས་སུ་འཕྲལ་དུ་ཤེས་རབ་ཀྱིས་འབིགས་པར་བྱ་བའི་རྟོག་པ་གཞུག་པ་མ་ཡིན་གྱི་སྔ་ནས་གནས་ལ་ཕེབས་པར་བྱས་ནས་བསམ་གཏན་ལ་གནས་པའི་དུས་སུ་མི་དམིགས་པ་ཉིད་ཀྱི་ངང་དུ་སྨོས་པས་སྤང་བར་བྱས་ལ་ནམ་མཁའ་དང་དབྱེར་མེད་པར་ཤིན་ཏུ་བརྟན་པར་བྱའོ་ཞེས་སྟོན་ཏོ།",
    "ཏིང་ངེ་འཛིན་རྩེ་གཅིག་པས་བསམ་གཏན་དུ་བྱ་བ་ལ་དེ་སྐད་བརྗོད་ཅེས་གསུངས་སོ།",
    "འོ་ན་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་དེའི་ངང་ལ་ཐད་ཀར་གནས་པར་བྱ་བ་ཡིན་ནམ་ཞེ་ན།",
    "ཇི་ལྟར་མའི་བདེ་བ་བུ་ལ་སྟོབ་པར་བྱེད་པ་བཞིན་དུ།",
    "དེ་དྲན་པའི་ལམ་མངོན་དུ་བྱས་པ་ནི་གསལ་བར་དམིགས་པའོ།",
    "དེ་དང་རྗེས་སུ་མཐུན་པར་ཞེས་པ་ནི།",
    "འདྲིས་པར་བྱ་དགོས་ཞེས་པའི་དོན་ཏོ།",
    "དེ་བསྟན་པས་སེམས་དཔའ་ཕྱི་མ་རྣམས་ཀྱང་མཚོན་པར་བྱེད་དེ།",
    "འདིར་རྒྱས་པར་བསྟན་པ་ནི་འོག་ནས་གདོད་སྟོན་དགོས་པས།",
    "དུ་མར་བལྡབས་ན་མངས་པར་འགྱུར་བས་ན།",
    "བརྗོད་པར་བྱ་བ་ཡང་ཇི་ལྟ་བུ་ཞིག་ཅེ་ན།",
    "རིགས་མི་གཅིག་པའི་རིམ་པས་ཆ་ལུགས་མི་མཐུན་པར་བསྟན་པ་སྟེ།",
    "འོག་ནས་ལྷ་བསམ་པ་རྒྱས་པར་འཆད་པ་ལས་བལྟས་ལ་རིག་པར་བྱའོ།",
    "༥༤ཡང་མཚོན་པར་བྱེད་པས་ལྷག་མ་དག་བསམ་གཏན་དུ་བྱེད་ན་ཡང་དེ་བཞིན་དུ་བརྟག་པར་བྱའོ།",
    "མཉམ་པར་གཞག་པས་ཏིང་ངེ་འཛིན།",
    "ཞེས་པ་ནི་དེ་མི་གཡོ་ཞིང་བརྟན་པ་དེ་ཉིད་བྱིང་རྨུགས་ལ་སོགས་པའི་སྐྱོན་དང་བྲལ་བས་མཉམ་པར་གཞག་པ་ཁོ་ན་ལ་གནས་པ་ནི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལྟར་ཏིང་ངེ་འཛིན་ངེས་པར་གྱུར་པ་ལས།",
    "ཤེས་ལྔའི་རང་བཞིན་རྡོ་རྗེ་རྩེ་ལྔ་པར་སྣང་བ་ལ་ནི་རྡོ་རྗེར་འགྱུར་ཞེས་བྱའོ།",
    "རྡོ་རྗེ་སེམས་ན་དཔར་ཡང་འགྱུར་རོ།",
    "ཞེས་བྱའོ་འོ་ན་སེམས་དཔར་བྱིན་གྱིས་བརླབས་པའི་རྣལ་འབྱོར་གྱིས་རྡོ་རྗེ་སེམས་དཔར་འགྱུར་བར་བྱའོ་ཞེས་གསུངས་པ་དེའི་རྣམ་པ་རྒྱུད་ཀྱི་དོན་ལ་འཇུག་པའི་འགྲེལ་བཤད།",
    "༡༤༥༥ཇི་ལྟ་བུར་ཤེས་པར་བྱ་ཞེ་ན།",
    "དེ་ལ་སེམས་དཔར་བྱིན་གྱིས་བརླབས་པའི་རྣལ་འབྱོར་ནི་འདི་ལྟ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་སྟེ།",
    "དེས་ཀྱང་བདག་ལ་ཁྱབ་པའི་ངོ་བོ་བས་ན་དབྱེར་མེད་པར་བསྟན་པའོ།",
    "དེ་གཉིས་ཐ་མི་དད་པར་བཅིང་ངོ།",
    "དེ་བས་ནི་དེའི་དོན་དུ་གསུངས་པ།",
    "བདག་དང་མི་གཉིས་པར་གྱུར་པའི་ཕྱག་རྒྱའི་གཟུགས་དེ་ལ་ཞེས་པ་ནི།",
    "རྒྱུདའི་༥༤གཟུགས་དེ་ལ་དེ་བཞིན་གཤེགས་པའི་ཚོགས་སྤྱན་དྲངས་ནས་གཞུག་པར་བྱ་བ་སྟེ།",
    "དེ་བདག་དང་དབྱེར་མེད་པས་ན་མི་གཉིས་པར་གྱུར་པ་སྟེ།",
    "གོང་དུ་ཏིང་ངེ་འཛིན་གྱིས་འགྲུབ་པར་གསུངས་ནའདིར་ངག་ཏུ་བརྗོད་པར་སྟོན་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "གོང་དུ་ཏིང་ངེ་འཛིན་གྱིས་འགྲུབ་པར་གསུངས་པ་དང་།",
    "དེའི་རིགས་ཀྱི་ཇི་སེམས་དཔའ་ཆེན་པོ་རྣམས་སྒྲུབ་པར་བྱེད་པ་ལ་བྱེ་བྲག་ཏུ་ཕྱེ་བའི་ཚིག་སྟེ།",
    "སྨྲ་བརྗོད་དུ་བཅས་པ་ཚོགས་པའི་སྒོ་ནས་འདི་བཞིན་དུ་འགྲུབ་པར་བསྟན་ཏོ།",
    "དེའི་སེམས་དཔའ་རྣམས་ནི་ཕྲིན་ལས་ལ་གཙོར་གྱུར་པས་དེའི་བསམ་གཏན་ལ་ནི་སྔགས་བརྗོད་པར་བྱ་བས་འགྲུབ་པར་གསུངས་ཏེ།",
    "དེ་ལ་སྔགས་བརྗོད་པ་ནི་ངག་ཏུ་བཟླས་པར་མ་ཟད།",
    "འཕྲོ་བར་བྱེད་པས་གཞན་འཇོམས་པར་བྱེད་པའི་མཚན་ཉིད་ཅན་པས་རྡོ་རྗེའི་མེ་ལྕེ་དང་།",
    "ལྷག་པར་རམ་ལྷག་པར་གསལ་བར་བརྟག་གོ་ཞེས་པའི་དོན་ཏོ།",
    "རྩ་བའི་རྒྱུད་ཆེན་པོ་ཉིད་ལས་ཀྱང་ཕྱག་རྒྱ་ཆེན་པོ་དམ་ཚིག་སེམས་དཔའ་རྗེས་སུ་དྲན་པར་བྱས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་རྡོ་རྗེ་ལ་སོགས་པར་བསྟན་པ་སྟེ།",
    "དེ་ཡང་གོང་དུ་གསུངས་པའི་སེམས་མ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "དོན་དེ་གནས་སྐབས་གཞན་དུ་སྟོན་པར་བྱེད་པའི་ཚིག་གོ།",
    "འདིར་སྦྱར་བར་རིགས་པར་སློབ་དཔོན་སྔ་རབས་ཀྱི་མཁས་པ་རྣམས་འཆད་དོ།",
    "དེ་གཉིས་དབྱེར་མེད་པར་སྟོན་པའི་ཚིག་གོ།",
    "ཨོཾ་ས་མ་ཡ་སརྦ་ཨདྷི་ཏིཥྛི་མཱཾ་ཞེས་བྱ་བ་འདི་བརྗོད་པས་དེ་བཞིན་དུ་གྱུར་པར་དམིགས་སོ།",
    "བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ཡན་མ་འོངས་པའི་ལག་རྣམས་ཀྱང་ཡོངས་སུ་རྫོགས་པར་བྱས་པར་གྱུར་ལ།",
    "འོ་ན་ད་ལྟར་དང་མ་འོངས་པ་གཉིས་ཀའི་དོན་དང་མཚུངས་པར་འཇུག་པ་ལ་ཐབས་མི་མཐུན་པར་སྟོན་པ་ཅིའི་ཕྱིར།",
    "འདི་གཉིས་གང་ལྟར་བྱས་ཀྱང་འགལ་བ་མེད་ལ།",
    "གྲུབ་པར་གྱུར་ཟིན་པའི་བྱེ་བྲག་ལས་དགོངས་ནས་འདི་ལྟར་བསྟན་ཏོ།",
    "འོ་ན་འདིར་འདི་ལྟར་བྱིན་གྱིས་བརླབས་པ་ལ་ཡོན་ཏན་ནམ་དགོངས་པའི་རྣམ་པ་ཇི་ལྟ་བུ་དག་ཡོད་པར་འགྱུར་ཞེ་ན།",
    "སྨྲས་པ་བདག་རང་ལྷའི་རྣལ་འབྱོར་དུ་བྱ་བ་འདི་ཡང་དངོས་གྲུབ་ཀྱི་རྒྱུའི་གཙོ་བོ་ཡིན་པར་རིག་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་སྨོས་ཏེ།",
    "དངོས་གྲུབ་གང་སྒྲུབ་ཀྱང་གཙོ་བོར་ཕྱག་རྒྱ་ཆེན་པོའི་སྦྱོར་བ་གོམས་པས་ཐོབ་པར་འགྱུར་བས།",
    "དེ་ལྟར་དངོས་གྲུབ་བསྒྲུབ་པའི་རྒྱུའི་གཙོ་བོ་འདི་ལྟར་བྱ་བ་འདི་ཁོ་ན་ཡིན་པར་རིག་པར་བྱ་ཞེས་པའི་དོན་ཏོ།",
    "ཡོངས་སུ་དག་པར་འགྱུར་བའི་སྔགས་པ་ཞེས་པ་ནི།",
    "བསམ་གཏན་དང་མི་མཐུན་པར་གྱུར་པའི་རྣམ་པར་རྟོག་པ་དང་།",
    "དེ་བས་ན་བགེགས་ཀྱི་ཚོགས་ཤིན་ཏུ་རྒྱང་རིང་དུ་སྤངས་ཏེ་ཞེས་ཎཱརྣམ་པར་རྟོག་པ་དང་།",
    "བྱས་པའི་ལས་ཡོངས་སུ་རྫོགས་པའོ།",
    "ཕྱི་རོལ་གྱི་གཙང་སྦྲ་དང་དཀའ་ཐུབ་དང་སྡོམ་པ་དང་།",
    "རིང་པོ་མི་ཐོགས་པར་མྱུར་བ་ཉིད་དུ་ཕྱག་རྒྱ་ཆེན་པོའི་ཁོ་ན་ཉིད་ལྷའི་རྣལ་འབྱོར་དུ་འགྲུབ་པར་འགྱུར་རོ་སྟོན་ཏོ།",
    "སེམས་མཉམ་པར་གཞག་པ་དང་འགལ་ཏེ་ཞེས་པ་ནི།",
    "སྡོམ་པས་ཡིད་མི་བདེ་བས་སེམས་མཉམ་པར་མི་བཏུབ་ན།",
    "དེ་བས་ན་ཡུན་རིང་ཞིག་ན་ཞེས་པ་ནི་དཀའ་བ་སྤྱད་པས་ནི་གྲུབ་པ་ཞིག་ཐོབ་ན་ཡང་ཡུན་རིང་པོ་ཞིག་འགྱངས་༣པའི་འོག་ཏུ་ཐོབ་པར་འགྱུར་བའམ།",
    "ཡང་ན་མི་ཐོབ་པར་འགྱུར་རོ་ཞེས་པ་ནི།",
    "སྒོ་གསུམ་གྱི་ལས་མ་དག་པ་སྤྱོད་པར་འགྱུར་བ་ནི།",
    "ང་ནི་སྦྱོར་བའི་རྒྱུད་རྣམས་ལས་གསུངས་པའི་གོས་དང་ཡོ་བྱད་ཀྱིས་འཚོ་བ་སྟེདེ་ཡང་འདོད་ཆགས་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་བཞིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བྱ་བའི་རྒྱུད་ལས་གསུངས་པ་ལྟར།",
    "གནས་གཅིག་ཏུ་ཆད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཇི་ལྟར་བདག་གནས་གང་དུ་དད་ཅིང་བདེ་བ་དེར་དེ་བཞིན་དུ་བསམ་གཏན་ཇི་ལྟར་གནས་ཡིད་དུ་འོང་ཞིང་མཚན་དང་ལྡན་པ་དེར་གནས་པར་བྱ་བའམ།",
    "དེ་བཞིན་དུ་བསྒྲུབ་པའི་རྣལ་འབྱོར་ལ་གནས་པར་བྱའོ།",
    "ཐམས་ཅད་ཀུན་བྱས་ཀུན་ཟོས་ཀྱང་།",
    "འགྲུབ་འགྱུར་ཉེས་པར་མི་འགྱུར་ན།",
    "རྣལ་འབྱོར་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་གོམས་པར་བྱེད་པའི་འབྲས་བུ་བསྟན་པ་སྟེ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་གོ་འཕང་ཆེན་པོ་དེ་ཡང་འགྲུབ་པར་དཀའ་བ་མ་ཡིན་ན།",
    "རྒྱུདའི་ཡིན་པར་སྟོན་ཏོ།",
    "རྣལ་འབྱོར་གྱི་བསམ་གཏན་བསྒོམས་པས་སྡུག་བསྔལ་ཐམས་ཅད་ཟད་པར་བྱེད་ཅིང་།",
    "ཞེས་གསུངས་ཏེ།",
    "ལ་གནས་པར་བྱེད་པ་ལ་ནི།",
    "དེ་ལྟར་ཡང་རྒྱུད་ལས་གསུངས་པ།",
    "དེ་ལས་ལངས་པའི་ངང་ལས་བྱུང་བའི་ཟླ་བ་དང་རྡོ་རྗེ་ལ་སོགས་པ་ལས་ཕྱག་རྒྱ་ཆེན་པོ་འགྲུབ་པར་བྱེད་པའོ།",
    "ལྷ་གང་ལ་དམིགས་པ་དེའི་ཕྱག་རྒྱ་ཆེན་པོར་གྱུར་པར་དམིགས་པ་ལ་ནི།",
    "མྱུར་དུ་འགྲུབ་པར་འགྱུར་ཞེས་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་ཡོན་ཏན་གཅིག་ཏུ་འདུས་པར་བསྟན་པ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་ཏེ།",
    "ལྷའི་རྗེས་སུ་མཐུན་པར་བསྒྲུབས་ལ་ཞེས་པ་ནི།",
    "ཕྱག་མཚན་ནི་ཇི་ལྟ་བ་བཞིན་དེའི་རྗེས་སུ་མཐུན་པར་བདག་ཉིད་བསྒྲུབས་ལ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དམ་ཤཱཀྱ་ཐུབ་པའི་གཟུགས་གསེར་གྱི་ཁ་དོག་ཅན་ཤིན་ཏུ་མཛེས་པ་ལ་མཚན་དང་དཔེ་བྱད་ཀྱིས་བརྒྱན་པ་ལས་ཕྱག་རྒྱ་དང་བཅས་པ་འོད་ཀྱི་དཀྱིལ་འཁོར་འཇའ་ཚོན་སྣ་ལྔའི་ནང་ནས་སེང་གེའི་གདན་ལ་བཞུགས་པ་ཞིག་མངོན་དུ་བྱུང་ནས་བཞུགས་པར་དམིགས་སོ།",
    "འོག་མ་ལ་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
