    "གཞུང་རྟའི་སྟོད་ཀྱི་ལོ་མའི་ངར་བའི་རྟིང་བ་ཤུབས་ལྟ་བུ་དེས་གཞུང་རྟ་བཏུམས་འདུག་ལོ་མའི་ཐོག་ཤོས་ནི་ལྕེ་དབྱིབས་ལྟ་བུ་ཡིན།",
    "འཇམ་པོའམ་སྡོམ་རྒྱུ་ལྟ་བུའི་སྤུ་དཀར་པོ་ཐར་ཐོར་དུ་སྐྱེས་འདུགམཐའ་ཁའི་མེ་ཏོག་ལྕེ་དབྱིབས་ཅན།",
    "ངར་རྟེན་ལྕེའི་དབྱིབས་ལྟ་བུའི་རིང་ཚད་ལ་ཧ་ལམ་ཧོ་སྨིས་ཡོད་པ་དེ་ལོ་མའི་ངར་བར་འབྱར་འདུག་མེ་ཏོག་རྔོག་དབྱིབས་ཆུན་པོ་ཕྲ་ཞིང་རིང་བ་མཆན་ཁུང་ནས་སྐྱེས།",
    "ཟེ་འབྲུའི་ཀ་བ་ཐུང་ཞིང་མགོ་གཉིས་སུ་གྱེས་འདུག་འབྲས་བུ་རྭ་ཅོ་རིང་པོ་རལ་གྲི་ལྟ་བུར་གླིང་ཤུར་བཞི་ཡོད།",
    "སྒྲིག་ཚུལ་དམ་ཞིང་མཐུག་པོའམ་ཅུང་བསེགས་འདུག་རིང་ཚད་ལ་ཧོ་སྨིས་ནསབར་དང་ཞེང་ལ་ཧོ་སྨིས་ཡོད།",
    "ཟེ་འབྲུའི་ཀ་བ་སྦུ་གུ་ལྟ་བུ་གསུམ་ནི་མར་ཕྱང་འདུག་ཟེ་འབྲུའི་མགོ་གསུམ་ཡོད་པ་པིར་སྨྱུག་ལྟ་བུ་ཡིན།",
    "གཡོགས་འདུག་གཞུང་རྟ་ས་ཉལ་ཅན་མིན།",
    "ལོགས་ངོས་ཀྱི་ལོ་མ་ཅུང་འཚུབ་ཅིང་མང་ལ་ཕྱི་རུ་བརྐྱངས་འདུག་དབྱིབས་འཇོང་ཟླུམ་དང་།",
    "ཕྲ་ཞིང་མཉེན་ལ་མར་ཕྱུང་ནས་འདུག་རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་དང་ཞེང་ལ་ཧོ་སྨིས་ཙམ་ཡོད།",
    "འབྲས་བུ་གྲུ་གུ་སྟོང་བ་དེ་སྔར་བཞིན་སྡོང་བོའི་ཐོག་ཏུ་ལུས་འདུག་ཟླ་ལྔ་བར་མེ་ཏོག་བཞད།",
    "གྲལ་ཕྱི་མ་རལ་གྲི་ལྟ་བུ་ཡིན་ལ་སྡོམ་རྒྱ་ལྟ་བུའི་སྤུ་དཀར་དང་སྤུ་མཉེན་ནག་པོ་ཐར་ཐོར་དུ་སྐྱེས་འདུག།",
    "རྟིང་བར་རྩད་ཕྲན་མང་པོ་ཚོམ་བུ་བྱས་ནས་སྐྱེས་འདུག་གཞུང་རྟ་དྲང་པོར་སྐྱེས་པ་དང་།",
    "ཟེ་འབྲུ་ཕོ་ལྔ་ཡོད་པ་དེ་མེ་ཏོག་སྦུབས་མའི་སྨད་དུ་སྐྱེས་ཤིང་ནང་ལ་སྦས་འདུག་ཟེ་འབྲུའི་ངར་བ་སྐུད་པ་ལྟ་བུ་ཡིན་པ་དང་།",
    "སྐོགས་ཤུན་གྱི་ཉག་ཁ་ཟབ་ཅིང་རྟིང་བར་སླེབས་འདུག་གྱེས་པའི་འདབ་མ་སྒོང་དབྱིབས་ཟླུམ་པོ་ཅན་བཞི་ཡོད།",
    "ལྕེའི་དབྱིབས་ཅན་གཅིག་ཡོད་པ་བརྐྱངས་ཤིང་བསེགས་ནས་འདུགརིང་ཚད་ལ་ཧོ་སྨིས་ནས་བར་ཡོད།",
    "ཟེ་འབྲུའི་ཀ་བ་གསུམ་ཡོད་པ་མར་གུག་འདུག་ཟེ་འབྲུའི་མགོ་ནི་མགོ་དབྱིབས་ལྟ་བུ་ཡིན།",
    "མཐོ་ཚད་ལ་ལིས་རྩད་རྐེད་ལ་ལོ་མའི་ངར་བ་སྐམ་པོ་སྨུག་དུསསྨིས་ནས་བར་ཡོད།",
    "སྤུ་མཉེན་དཀར་པོ་རིང་པོ་སྐྱེས་འདུག་རྟིང་བར་སྐྱེས་པའི་ལོ་མ་འཇོང་ཟླུམ།",
    "རྩོད་གཞུང་ཕྲ་ཞིང་རིང་ལ་འཕྲེད་དུ་སྐྱེས་འདུག་གཞུང་རྟ་བསེགས་ནས་ཡར་སྐྱེས་ཤིང་ཡལ་ག་མེད།",
    "ནང་ངོས་ལྗང་གུར་རྡོག་པོ་ཆུང་ཆུང་ལྟར་འབུར་འདུག་ཕྱི་ངོས་ལྗང་སྐྱ་ཡིན་ཞིང་།",
    "ངོས་གཉིས་ལ་སྤུ་མཉེན་ཐུང་ཐུང་ཐར་ཐོར་དུ་སྐྱེས་འདུག་རྟིང་བར་སྐྱེས་པའི་ལོ་མར་ངར་བ་ཕྲ་ཞིང་ཞན་པ་རིང་པོ་ཡོད།",
    "མེ་ཏོག་བཞད་རྗེས་གཞུ་ལྟར་གུག་འདུག་ཟེ་འབྲུ་ཕོ་ནི་ཅུང་ཟད་གུག་གུག་ཡིན།",
    "ངར་བའི་རིང་ཚད་ལ་ལིས་ལོ་མ་བར་ཡོད་པ་དང་བ་སྤུ་ལང་ལོང་དུ་སྐྱེས་འདུག་སྨིས་ནསསྒོང་དབྱིབས་སམ་ཟླུམ་རིང་སྒོང་དབྱིབས་ལྟ་བུ་ཡིན།",
    "རིང་ཚད་ལ་ཧ་ལམ་ལིས་སྨིས་ཡོད་པ་མར་བྱུང་འདུག་ཅིང་བ་སྤུ་ལང་ལོང་དུ་སྐྱེས་ཡོད།",
    "འབྲས་བུ་ཏིལ་གང་མ་ཟླུམ་པོའི་མགོ་གས་འདུག་ས་བོན་ཁམ་སྨུག་དང་ཟླུམ་ལེབ་ཆ་མི་མཉམ་པ་ཡིན།",
    "མཆུ་ཏོ་ཅུང་ཕྱི་ལ་ལོག་འདུག་འདབ་ཐུམ་སྒོང་དབྱིབས་རིང་པོ་ནང་ལ་གུག་ཡོད།",
    "ཟེ་འབྲུའི་ཀ་བར་སྤུ་མང་ཞིང་སྨད་ཕྱོགས་སུ་ལྷན་དུ་འདྲེས་འདུག་ཅིང་།",
    "ཡ་མཆུ་ལྟག་ཕྱོགས་སུ་བརྐྱངས་འདུགལིས་སྨིས་ནསབར་ཡོད།",
    "འབྲས་བུ་སྐམ་པོར་མ་སྨིན་པ་བ་སྤུ་རྩུབ་པོས་གཡོགས་འདུག་ཟླ་ཙར་༢ བརྒྱད་པར་མེ་ཏོག་བཞད།",
    "སྐོགས་ཤུན་ནི་སྦུ་གུའི་དབྱིབས་སྦུབས་མ་ལྟ་བུས་མངལ་ཁང་ལ་བསྐོར་ནས་འདུག་ཟེ་འབྲུ་ཕོ་གཅིག་ཡོད་པ་དང་ངར་བ་ཧ་ཅང་ཐུང་།",
    "རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་ཡོད་ཅིང་སྤུ་མཉེན་རིང་པོས་གཡོགས་འདུག་མེ་ཏོག་ཐར་ཐོར་དུ་སྐྱེས་ཤིང་ཡུ་བ་ཡོད།",
    "སྤུ་མཉེན་རིང་པོས་ཐར་ཐོར་དུ་གཡོགས་འདུག་མེ་ཏོག་ཁམ་སྨུག་ནས་སྔོན་པོ་ཡིན།",
    "གཞུང་རྟ་དྲང་པོར་སྐྱེས་ཤིང་སྡོང་བུ་ཡོངས་ལ་སྤུ་མཉེན་རིང་པོས་གཡོགས་འདུག་ལོ་མ་བྱ་སྒྲོ་དབྱིབས་ཀྱི་སྦྲགས་མ་ཆ་མི་མཉམ་པ་ཡིན།",
    "ཟེ་འབྲུའི་ཀ་བ་ཕྱིར་མངོན་ཞིང་ཁ་གྱེས་འདུག་ཟེ་འབྲུའི་མགོ་ནི་མགོའི་དབྱིབས་དང་།",
    "འབྲས་བུ་སྐམ་པོ་འབིག་དབྱིབས་གོ་ལྡོག་ཅན་དེ་སྐམ་ཞིང་མཁྲེགས་པོ་དང་ལྕགས་ཀྱུ་ལྟ་བུའི་ཚེར་མ་ཡོད་པའི་སྐོགས་ཤུན་ནང་དུ་སྦས་འདུག་ཟླ་དྲུག་པ་ནས་བརྒྱད་པར་མེ་ཏོག་བཞད་ཅིང་།",
    "གཞུང་རྟ་དྲང་པོར་སྐྱེས་ཤིང་རྒྱུན་དུ་སྤུངས་ནས་ཚོམ་བུར་སྐྱེས་འདུག་རྟིང་བར་ལོ་མའི་ངར་བ་སྐམ་པོས་གཡོགས།",
    "ཟེ་འབྲུའི་མགོ་ལ་གས་ཁ་གཉིས་ཡོད་པ་དེ་ཕྱིར་གུག་འདུགའབྲས་བུ་ཏིལ་གང་མ་ཟླུམ་རིང་དང་།",
    "རྟིང་བར་ལོ་མའི་ངར་བ་སྐམ་པོས་གཡོགས་འདུག་ལོ་མ་མང་ཤོས་རྟིང་བ་ནས་སྐྱེས་ཏེ་ཚོམ་བུར་འདུས་ཤིང་།",
    "ནང་ངོས་ཀྱི་རྩ་རིས་ཀོང་ཀོང་ཡིན་པ་དང་ཕྱི་ངོས་ཀྱི་རྩ་རིས་འབུར་འདུག་ངོས་གཉིས་ལ་ཉ་ཁྲབ་ལྟ་བུའི་བ་སྤུ་དཀར་པོས་གཡོགས།",
    "སྨད་ཕྱོགས་རྡོ་ཟེགས་ནང་དུ་ཟུག་ཡོད་པའམ་ས་ངོས་སུ་ཉལ་འདུག་སྟོད་ཕྱོགས་བསེགས་པའམ་དྲང་པོར་གྱེན་དུ་སྐྱེས་ཤིང་།",
    "མངལ་ཁང་ལ་སྤུ་མཉེན་སེར་པོས་གཡོགས་འདུག་ཟླ་དྲུག་པ་བདུན་པར་མེ་ཏོག་བཞད།",
    "ཁ་ཕྱོགས་ལྡོག་ནས་བྱ་སྒྲོའི་དབྱིབས་ལྟར་གྱེས་འདུག་གྱེས་འདབ་ནི་ཟླུམ་རིང་འཇོང་ཟླུམ་ཡིན།",
    "ཐོག་ཏུ་བ་སྤུ་ཐར་ཐོར་དུ་སྐྱེས་འདུག་གཞུང་རྟར་སྐྱེས་པའི་ལོ་མ་ཆུང་ཞིང་ངར་བ་ཕལ་ཆེར་མེད།",
    "ལྕུག་ཕྲན་ལྗང་ནག་ཡིན་ལ་སྤུ་མཉེན་དང་རྨེན་སྤུ་ཐར་ཐོར་དུ་སྐྱེས་འདུག་ལོ་མ་ཆ་མཉམ་དུ་སྐྱེས་ཤིང་ངར་བ་ཐུང་ཐུང་ཡོད་པ་དང་སྒོང་ཟླུམ་ལྟ་བུ་ཡིན།",
    "ཉག་ཆུང་ལྔ་གྲལ་འགྲིག་པོ་འདུག་མེ་ཏོག་སྦུབས་མའི་ཕྱི་ངོས་འཇམ་པོ་ཡིན་ལ།",
    "ངར་བའི་རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་ཡོད་ཅིང་ཐོག་ཏུ་རྨེན་སྤུ་སྨུག་པོས་གཡོགས་འདུག་གཉིས་སུ་གྱེས་པའི་གདུགས་ཕབ་ཆུན་པོ་ཡིན།",
    "ཟེ་འབྲུའི་ངར་བ་གྱེས་ཤིང་མེ་ཏོག་ལ་འབྱར་འདུག་མངལ་ཁང་གཉིས་ཡོད་ཅིང་བ་སྤུ་རིང་པོས་གཡོགས།",
    "འབྲས་བུའི་ལྟེ་གནས་ཅུང་འབུར་འདུག་ཟླ་དགུ་བ་ནས་བཅུ་བར་འབྲས་བུ་སྨིན།",
    "མངལ་ཁང་ལ་བ་སྤུ་སེར་པོས་གཡོགས་འདུག་ཟླ་བདུན་ས་ཚ་བར་བརལྕག་༤ སམཔ་བརྒྱད་པར་མེ་ཏོག་བཞད།",
    "རྩ་རིས་སྦལ་ལག་ལྟ་བུ་དེའི་ཐོག་ངོས་སུ་འབུར་འདུག་ངར་བའི་རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་ཡོད།",
    "སྤུ་མཉེན་དང་རྨེན་བུས་གཡོགས་འདུག་འབྲས་བུ་ཏིལ་གང་མ་ཀ་ཟླུམ་རིང་པོ་ལྟ་བུའི་རིང་ཚད་ལ་ལིས་སྨིས་ནས་༩ བར་ཡོད།",
    "མེ་ཏོག་འདབ་མ་བཞི་ཡོད་པ་རྣམས་རིམ་པ་གཉིས་སྐྱེས་འདུག་འདབ་མའི་རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་ཡོད།",
    "མེ་ཏོག་ཆིག་རྐྱང་དུ་སྐྱེས་པའམ་ས་ཡང་ན་མེ་ཏོག་ཆུན་པོ་རྔོག་དབྱིབས་སུ་བསྒྲིགས་ཏེ་ལོ་མའི་མཆན་ཁུང་ནས་སྐྱེས་འདུག་མེ་ཏོག་སྐོགས་ཤུན་ཅོང་ལྟ་བུ་ཉག་ག་ལྔར་གྱེས་ཤིང་གྱེས་པའི་འདབ་མ་ནི་རལ་གྲི་དང་འདྲ།",
    "ལོ་མའི་ངར་རྟེན་གཉིས་ཡོད་པ་ཕན་ཚུན་འབྲེལ་འདུག་ཧ་ལམ་ལིས་སྨིས་ཡོད།",
    "གཞུང་རྟ་བསེགས་ནས་གྱེན་དུ་སྐྱེས་པ་དང་རྟིང་བ་ནས་ཡལ་ག་མང་པོ་སྐྱེས་འདུག་གཞུང་རྟའི་རྟིང་བ་དང་སྨད་ནས་སྐྱེས་པའི་ལོ་མར་ངར་བ་ཡོད་པ་དང་།",
    "མེ་ཏོག་དཀར་པོ་དང་གློ་ཁ་ཡིན་ཞིང་ཆུང་ལ་ཚོམ་བུར་སྐྱེས་འདུགསྐོགས་ཤུན་འཇོང་དབྱིབས་དང་ཟླུམ་རིང་ཅན་བཞི་ཡོད་པའི་རིང་ཚད་ལ་ཧོ་སྨིས་ནས་བར་ཡོད་པ་དང་།",
    "མེ་ཏོག་ཆུན་པོ་རྔོག་དབྱིབས་ཅན་སྡོང་བུའི་རྩེ་མགོར་སྐྱེས་ཤིང་སྤྱིར་བཏང་དུ་མར་གུག་ནས་ཕྱུང་འདུག་ཟེ་འབྲུའི་ཟེགས་རྡུལ་དམར་པོ་ཡིན་ཞིང་ཚངས་ཐིག་ལ་ཧ་ལམ་ཧོ་སྨིས་ཙམ་ཡོད།",
    "གྲ་ཚེར་ལྟ་བུའི་འདབ་སྤུ་གཉིས་ཡོད་པ་དེའི་ཐོག་ཏུ་ཚེར་སྤུ་གོ་ལྡོག་ཅན་གྱིས་གཡོགས་འདུག་ཟླ་དྲུག་པ་ནས་དགུ་བར་མེ་ཏོག་བཞད་ཅིང་འབྲས་བུ་སྨིནསྐྱེ་ས་ནི་མཚོ་ངོས་ལས་སྨིས་ནས་མཐོ་བའི་ཆུ་འགྲམ་དང་ན་ཐང་ཡིན།",
    "སྤུངས་ནས་སྐྱེས་འདུག་རྩ་བ་ལྟ་བུའི་གཞུང་རྟ་ཕྲ་ཞིང་རིང་བས་ཉལ་ནས་སྐྱེས་པ་དང་།",
    "ཕྱི་ནང་ངོས་གཉིས་སུ་སྤུ་མཉེན་དཀར་པོ་སྐྱེས་འདུག་ལོ་མའི་ངར་བར་བ་སྤུ་ཡོད་པ་དང་རིང་ཚད་ལ་ཧོ་སྨིས་ནསབར་ཡོད།",
    "མེ་ཏོག་བཅུ་ནས་བཅོ་ལྔ་བར་ཡོད་པ་ཚོམ་བུར་སྐྱེས་འདུག་སྐོགས་ཤུན་ཅོང་ལྟ་བུའི་ཐོག་ན་སྤུ་མཉེན་ཡོད།",
    "ཐར་ཐོར་དུ་སྐྱེས་འདུག་གཞུང་རྟ་དྲང་པོར་སྐྱེས་ཤིང་ཡལ་ག་མེད།",
    "མཐའ་ཁ་ཆུ་གཉེར་ལྟ་བུ་ཡིན་ཞིང་ཕྱིར་སློག་འདུག་མེ་ཏོག་དམར་ཟ་བ་སྨུག་གྱེན་དུ་ལངས་ཤིང་།",
    "གྱེན་དུ་ལངས་འདུག་ཟེ་འབྲུའི་ངར་བ་ཆ་གཉིས་ཡོད་པ་དེ་ཚང་མར་བ་སྤུ་ཡོད།",
    "ཟེ་འབྲུ་ཕོ་ནང་དུ་བཏུམས་འདུག་ཟེ་འབྲུའི་ངར་བ་དར་སྐུད་འཇམ་པོ་དང་འདྲ་ཞིང་བ་སྤུ་མེད།",
    "ཟེ་འབྲུའི་ཀ་བ་གཉིས་ཕན་ཚུན་གྱེས་ནས་སྐྱེས་འདུག་པ་དང་ཟེ་འབྲུ་ཕོ་ལས་ཅུང་ཟད་ཐུང་།",
    "རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་ཡོད་ཀྱང་ས་ལ་ཉལ་ནས་སྐྱེས་འདུག་པས་ཕར་བལྟས་པ་ན་མཐོ་དམའ་ཁྲུ་ཙི་གང་ཙམ་ལས་མེད།",
    "རྩ་བ་གཙོ་སྤུས་གཡོགས་ཡོད་ཅིང་དྲི་ངན་རབ་ཏུ་བྲོ་བ་ཞིག་ཡིནབོ་ཀ་བ་ཟླུམ་པོ་ལྟ་བུ་དྲང་པོར་ཐུར་དུ་བསྲིངས་འདུག་གཞུང་རྟ་སྦོམ་པོ་དྲང་པོར་གྱེན་དུ་སྐྱེས་པ་དང་།",
    "མེ་ཏོག་ཆུན་པོ་གདུགས་དབྱིབས་གསོར་འབིག་ལྟ་བུ་སྡོང་བུའི་རྩེར་སྐྱེས་འདུག་མེ་ཏོག་སྔོན་པོ་ཡིན་ཞིང་ཚངས་ཐིག་ལ་ལིས་སྨིས་ཡིན།",
    "ཟེ་འབྲུའི་ཀ་བ་ལྔ་ཡོད་པ་དང་ཀ་མགོ་དབྱུག་དབྱིབས་ཡིན་ཞིང་ཕལ་ཆེར་སོ་སོར་གྱེས་ནས་སྐྱེས་འདུག་འབྲས་བུ་ཏིལ་གང་མ་གྲུ་གུ་ལྟ་བུ་དེ་འདབ་མ་ལྔར་གས་ཡོད་པ་དང་།",
    "ཐོག་ལ་བ་སྤུ་ཁམ་སེར་གྱིས་གཡོགས་འདུག་མེ་ཏོག་ཆིག་རྐྱང་དུ་སྐྱེས་འདུག་མེ་ཏོག་ཡུ་བ་ཕྲ་བོ་ལོ་མའི་མཆན་འོག་ནས་སྐྱེས་ཤིང་འཁྲིལ་བ་དང་ལིས་སྨིས་ཙམ་རིང་།",
    "མེ་ཏོག་ཆུན་པོ་རྔོག་དབྱིབས་ཅན་སྡོང་བུའི་རྩེར་སྐྱེས་འདུག་མེ་ཏོག་ཕྱེ་ལེབ་ལྟ་བུ་སྨུག་པོ་ཡིན།",
    "ལོ་མ་སྒྲོ་དབྱིབས་སྦྲགས་མ་ཆ་གྲངས་ཅན་ཆ་མཉམ་དུ་སྐྱེས་འདུག་ལོ་མ་རྩེ་རྟིང་ཟླུམ་པོ་ཅན་བཅུ་ནས་བཅུ་བཞི་བར་ཡོད་པ་ཚང་མ་རིང་ཐུང་ཕལ་ཆེར་འདྲ་ཞིང་།",
    "མེ་ཏོག་ཆུན་པོ་མགོ་བོའི་དབྱིབས་ཅན་སྡོང་བུའི་མགོར་ཆིག་རྐྱང་དུ་སྐྱེས་འདུག་ཚངས་ཐིག་ནི་ལིས་སྨིསནས",
    "འདབ་ཐུམ་ལྕེའི་དབྱིབས་རལ་གྲི་ལྟ་བུའམ་ཡང་ན་ཟླུམ་རིང་ཅན་གྲལ་མང་དུ་བསྒྲིགས་འདུག་རིང་ཚད་ལ་ཧོ་སྨིས་ནས་བར་ཡོད་པ་དང་།",
    "ལོ་མ་རྟིང་བ་ནས་སྐྱེས་འདུག་ལོ་མ་བྱ་སྒོང་ལྟ་བུའམ་འཇོང་འཇོང་ཡིན་ཞིང་རྒྱུ་བ་ཀོ་བ་དང་འདྲ།",
    "རྩ་བ་ལྟ་བུའི་གཞུང་རྟ་སྦོམ་པོ་ས་ལ་ཉལ་ནས་སྐྱེས་འདུག་རྩ་བ་ཅུང་སྦོམ་ཞིང་མང་ལ་ཚོམ་བུར་སྐྱེས་ཡོད།",
    "གཞུང་རྟ་དྲང་པོར་བསགསསྐྱེས་འདུག་པ་དང་སྨད་དུ་འཇམ་པོ་ཡིན།",
    "དེས་གཞུང་རྟ་བཏུམས་འདུག་མེ་ཏོག་ཆུན་པོ་མགོའི་དབྱིབས་ཅན་ནབཔམང་པོ་དེ་རྔོག་དབྱིབས་སུ་ཆགས།",
    "སྤྱིའི་ལྕག་མ་ཅུང་ཐུང་བ་དང་འབྲས་བུ་ཆགས་དུས་མར་ཕྱུང་འདུག་སྤྱིའི་འདབ་ཐུམ་སྦུ་གུ་ལྟ་བུའི་རྟིང་བ་ཟླུམ་པོ་དང་།",
    "ལོ་མ་སྒྲོ་དབྱིབས་སྦྲགས་མ་ཚོམ་བུར་སྐྱེས་འདུག་ལོ་མ་ལས་ངར་བ་ཐུང་།",
    "ལོ་མ་ལྕེའི་དབྱིབས་ཅན་ཆ་མཉམ་དུ་སྐྱེས་རིང་ཚད་ལ་ལིས་སྨིས་པའམ་ཡང་ན་འཁོར་ནས་སྐྱེས་འདུག་དང་ཞེང་ལ་ཧོ་སྨིས་ནས་བར་ཡོད།",
    "མེ་ཏོག་ཆུན་པོ་རྣམས་གཞུང་རྟ་སྨད་ཀྱི་ལོ་མའི་མཆན་ཁུང་ནས་སྐྱེས་པ་དང་མར་གུག་འདུག་རིང་ཚད་ལ་ལིས་སྨིས་ཙམ་ཡོད།",
    "རྩ་བ་ལྟ་བུའི་གཞུང་རྟ་རིང་པོར་ལོ་མའི་ངར་རྟེན་སྐམ་པོས་གཡོགས་འདུགགཞུང་རྟ་དམར་སྨུག་ཅན་དྲང་པོར་སྐྱེས།",
    "མེ་ཏོག་ཆུན་པོ་མགོ་བོ་ཅན་ཁེར་རྐྱང་དུ་སྡོང་བུའི་རྩེར་ཆགས་ནས་མགོ་མར་ཕྱང་འདུག་དེའི་ཚངས་ཐིག་ལ་ལིས་སྨིས་༣ ནསགས་བར་ཡོད།",
    "ཟེ་འབྲུའི་ཀ་མགོ་ཕྱིར་ལོག་འདུག།",
    "ལོ་མ་པད་མ་ལྟར་ཚོམ་བུར་སྐྱེས་འདུག་པ་དང་།",
    "ཟེ་འབྲུ་ཕོ་ལྔ་ཡོད་པ་མེ་ཏོག་སྦུ་གུའི་སྟོད་ལ་ཀྱིས་༧༢ ཀཚ་ཀལ་བ་ཆསྐྱེས་འདུག་འབྲས་བུ་ཏིལ་གང་མ་ཀ་བ་ཟླུམ་པོ་དང་འདྲ།",
    "སྡོང་ཤུན་དུ་སེར་ཀ་གས་འདུག་ལོ་མ་དབྱིབས་བྱ་སྒོང་གོ་ལྡོག་རལ་གྲི་ལྟ་བུ་ཆ་མཉམ་དུ་སྐྱེས་པ་དང་།",
    "ཟེ་འབྲུའི་ཀ་བ་སྦུ་གུ་ཐུང་ཐུང་ལྟ་བུ་མར་གུག་འདུག་འབྲས་བུ་སྐམ་པོ་བྱ་སྒོང་དང་འདྲ།",
    "སྐོགས་ཤུན་ཟུར་གསུམ་དབྱིབས་བྱ་སྒོང་ལྟ་བུ་ལྔ་ཡོད་པ་རྣམས་མེ་ཏོག་བཞད་དུས་དྲང་པོར་ལངས་འདུག་དེའི་ཕྱི་ངོས་དང་མཐའ་ཁར་རྨེན་སྤུ་ཡོད།",
    "ཟེ་འབྲུའི་ཀ་བ་མགོ་ནས་སྐྱེས་འདུག་ཟླ་བདུན་པ་བརྒྱུད་པར་མེ་ཏོག་བཞད།",
    "རྟིང་བར་ལོ་མ་པད་མ་ལྟར་མང་པོ་སྐྱེས་འདུག་ལོ་འདབ་ཁེམ་བུ་ལྟ་བུའི་རྩེ་རྟུལ་བོ་དང་མཐའ་མཉམ་པ།",
    "མང་ཤོས་ནི་ལོ་མའི་ཡུ་བ་དང་འབྲེལ་འདུག་མེ་ཏོག་ངང་སེར་ཁེར་རྐྱང་ཡིན་ཞིང་འདབ་ཐུམ་མེད།",
    "མེ་ཏོག་ཆུན་པོ་གདུགས་ཕབ་དབྱིབས་ཅན་སྡོང་མགོར་སྐྱེས་པའམ་ཡང་ན་ལོ་མའི་མཆན་ཁུང་ནས་སྐྱེས་འདུག་མེ་ཏོག་ཡུ་བ་སྦོམ་པོར་གླིང་ཟུར་ཡོད།",
    "མར་ཅུང་ཟད་གུག་འདུག་ཟླ་བརྒྱད་པ་ནས་བཅུ་བའི་བར་མེ་ཏོག་བཞད་པ་དང་འབྲས་བུ་སྨིན།",
    "ལོ་མའི་ལྕག་མར་གླིང་ཤུར་ཡོད་པ་དང་བ་སྤུ་དཀར་ནག་བསྲེས་ནས་སྐྱེས་འདུག་ལོ་མའི་ངར་རྟེན་སྒོང་དབྱིབས་རལ་གྲི་ལྟ་བུ་རྣམས་ཀྱི་རྟིང་བ་འབྲེལ་འདུག་པ་ལས་ལོ་མའི་ངར་བ་དང་སོ་སོར་གྱེས་འདུག་ལོ་མ་ཆུང་བ་ཟླུམ་པོའམ་རལ་གྲི་ལྟ་བུ་བཅུ་གསུམ་ནས་སོ་གཅིག་བར་ཡོད།",
    "ངོས་གཉིས་ཀར་བ་སྤུ་དཀར་པོ་ཉལ་ནས་སྐྱེས་འདུག་མེ་ཏོག་ཆུན་པོ་རྔོག་དབྱིབས་ཅན་ལ་མེ་ཏོག་མང་།",
    "ཐོག་ཏུ་བ་སྤུ་དཀར་ནག་བསྲེས་ནས་སྐྱེས་འདུག་ཟེ་འབྲུ་ཀ་མགོ་མགོ་བོ་དང་འདྲ།",
    "ལོ་མའི་ལྕག་མར་བ་སྤུ་ཐར་ཐོར་སྐྱེས་འདུག་ཕྱི་ངོས་ནས་བ་སྤུ་མཐུག་པོར་སྐྱེས་པའི་ལོ་མའི་ངར་རྟེན་གྱི་རྟིང་བ་ཕན་ཚུན་འབྲེལ་འདུག་པ་ལས་སྟོད་ཙམ་དུ་ཅུང་སོ་སོར་བྲོལ་འདུག་ལོ་མ་ཆུང་བ་སྒོང་དབྱིབས་འཇོང་ཟླུམ་ལྟ་བུ་ཉེར་གཅིག་ནས་སོ་གཅིག་བར་ཡོད་པ་དང་།",
    "མེ་ཏོག་ཆུན་པོ་རྔོག་དབྱིབས་ཅན་གྱི་རིང་ཚད་ལ་ལིས་སྨིས་ནསབར་དང་མེ་ཏོག་བཅོ་ལྔ་ནས་ཉི་ཤུ་བར་ཡོད་པ་དེ་རྣམས་མཉམ་དུ་འདུས་འདུག་སྤྱིའི་མེ་ཏོག་སྨྱུག་མའི་རིང་ཚད་ལ་ལིས་སྨིས་ནས་བར་ཡོད་པ་དང་།",
