    "དེ་ནས་ཆངས་བཟུང་སྟོང་པའི་ནང་དུ་རང་འདུག་པར་བསམས་ནས།",
    "བདག་ཉིད་མི་གཡོ་བའི་ང་རྒྱལ་གྱིས་འགྲོ་འདུག་ཐམས་ཅད་བྱེད་པར་བསམས་ལ་འགྲོའོ།",
    "འཇིག་དུས་བསྐལ་པའི་མེ་ལྟར་འབར།",
    "སླར་ཁྱེད་རང་རྣམས་ཀྱིས་ཉམས་སུ་ལེན་པའི་ཚུལ་ནི།",
    "འཇོག་ཙ་ན་རང་དང་བུམ་པའི་ཆུ་གཉིས་བསྲེས་ལ་འཐུང་བ་དང་།",
    "གནས་དབེན་པར་བསམ་གཏན་གྱི་སྤྱོད་ལམ་དང་ལྡན་པས་འདུག་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "བདེ་བའི་གདན་ལ་བསམ་གཏན་གྱི་སྤྱོད་ལམ་དང་ལྡན་པས་འདུག་སྟེ།",
    "ཁྱེད་རང་རྣམས་ལ་ཕོག་པས་རྣམ་སྨིན་གྱི་ལུས་སྦྱངས་ཏེ་འོད་གསལ་སྟོང་པ་ཉིད་ཀྱི་ངང་ལས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་མཎྜལ་འབུལ་ཞིང་གསོལ་བ་འདེབས་པ་རྣམས་ཡིན་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ཟླ་བའི་དཀྱིལ་འཁོར་དུ་གྱུར་པར་བསྒོམས་ཏེ་པད་ཀོར་སྔོན་འགྲོའི་འཁྱུད་རྒྱ་དང་བཅས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པ་ཙམ་གྱིས་སྡིག་སྒྲིབ་བག་ཆགས་དང་བཅས་པ་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུ་ཆེན་པོར་གྱུར་པ་ལ་སློབ་དཔོན་གྱིས་ཨོཾ་སྭ་བྷཱ་ཝ་ནས་ཤུདྡྷོཧཾ།",
    "སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་ཀྱི་གོ་སར།",
    "ཡེ་ཤེས་པ་སྤྱན་དྲངས་ཁྱེད་རང་རྣམས་ལ་ཛ་ཧཱུྃ་བཾ་ཧོ་ཧྲཱི།",
    "ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "དེ་རྣམས་ཀྱི་སྒོ་ནས་ཁྲོ་བོ་རྡོ་རྗེ་ཤུགས་ཀྱི་སྐུ་གསུང་ཐུགས་ཡེ་ཤེས་དང་བཅས་པའི་རྗེས་གནང་རང་ཉིད་ལྷར་སྒོམ་ཞིང་ནུས་ལྡན་དུ་བྱ་བའི་རིམ་པ་གྲུབ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཚངས་བུག་ནས་ཞུགས།",
    "མཐར་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཐིམ་པས།",
    "དེ་ཙམ་མ་ལྕོགས་ནའང་རང་ཉིད་རྡོ་རྗེ་ཤུགས་སུ་བསྒོམས་ནས་སྔགས་བཟླས་པ་ཙམ་གྱིས་ཐོག་བསྲུང་བར་ནུས་ལ།",
    "སྔོན་མ་ཅན་གྱི་ཞེས་པའང་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་པོ་ཁམས་དང་སྐྱེ་མཆེད།",
    "དེའི་སྟེང་དུ་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཕྲོ་དཀར་པོའི་འཕྲོ་འདུ་ལས།",
    "ཁྱེད་རང་རྣམས་སྣ་ཚོགས་ཡུམ་དུ་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "མཇུག་མ་ཞབས་འོག་ཏུ་མནན་ནས་ཙོག་པུའི་འདུག་སྟངས་ཀྱི་བཞུགས་པའོ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཐུགས་ཀའི་ས་བོན་ཀྵིཾ་སྔགས་ཕྲེང་དང་བཅས་པ་ལ་ཐིམ།",
    "དཔོན་རིགས་འགའ་ཤས་གསོན་སྦས་བྱེད་ཀྱི་འདུག་ཟེར་བ་སོགས་དཀྲོག་གཏམ་སྣ་ཚོགས་ཤོད་ཀྱི་ཡོད་པ་དང་།",
    "ས་གནས་ཀྱི་འགོ་གཙོ་དང་ཁྱིམ་ཚང་གཅིག་ལྟར་བྱེད་འདུག་པ་མ་ཟད།",
    "མ་གཞི་ང་རང་ཡང་གདན་ས་ཆེན་པོ་འགྲིམས་ནས་ཡོང་བ་ཞིག་ཡིན།",
    "མི་སུས་ཀྱང་ལྷ་རི་འགོར་སྡོད་འདོད་བྱེད་ཀྱི་མི་འདུག་ཅེས་ཟེར།",
    "འབྱོར་མེད་སྤྲང་པོ་མང་བའི་དཔེ་ལྟར་ཧ་ཅང་ཐབས་སྐྱོ་མཐར་སོན་པའི་དུས་སུ་སླེབས་འདུག་བཞི་པ།",
    "འོན་ཀྱང་རང་སྲོག་དང་།",
    "ཤེས་བྱུང་ག་དུས་ཤེས་བྱུང་ངམ་མདང་ནུབ་ཤེས་བྱུང་དེ་གོང་ཤེས་མ་བྱུང་ངམ་དྲིས་པར།",
    "དགེ་སྟག་ཨུ་ཡོན་གྱིས་ང་རང་དཀའ་ལས་ཁག་པོ་བྱུང་།",
    "མའོ་ཀྲུའུ་ཞིས་ང་རང་ཆེད་དུ་མངགས་གཏོང་གནང་བའི་རླབས་ཆེན་གྱི་དགོངས་དོན་ལ་བརྟེན་པ་དང་།",
    "མི་དམངས་ཀྱི་ཁེ་ཕན་བདེ་རྩར་བསམ་ནས་ང་རང་བླ་རྒན་མི་རོ་རྟར་བསྐྱོན་གྱིས་འདིར་མེས་རྒྱལ་གོང་བུ་གཅིག་གྱུར་གྱི་བྱ་བཞག་ཆེན་པོ་མངོན་འགྱུར་བྱེད་རྒྱུར་བོད་ཞི་བས་བཅིངས་འགྲོལ་ཐོབ་རྒྱུའི་དོན་དུ་ཡོང་བ་དང་།",
    "སྐད་ཆ་ཤོད་རྒྱུ་དེའི་སྔ་ཉིན་ང་རང་ལ་འབྲེལ་བ་གནང་བྱུང་།",
    "ང་རང་ལ་བཟང་གོས་སེར་པོ་སྒྲིལ་ཁ་བཅས་སྐུ་ཡོན་གནང་སྦྱིན་སྩལ་བྱུང་།",
    "སོ་དམག་ཁག་གཅིག་འབོམ་ལར་སླེབས་འདུག་ཅིང་།",
    "ཤེས་རབ་རྒྱ་མཚོས་ཁོང་ལ་ཡི་གེ་བཏང་མྱོང་བ་དང་ཁོང་རང་ཤེས་རབ་རྒྱ་མཚོའི་དགེ་ཕྲུག་ཡིན་ཞེས་གསུངས།",
    "ཕྱིར་ལོག་སྐབས་ཕྱི་དྲོའི་ཆུ་ཚོད་བཞི་དང་ཕྱེད་ཀ་ཟིན་འདུག་ང་ཕོད་ཕེབས་ནས་གསུངས་དོན།",
    "ཕྱི་དྲོར་ཞོལ་ཁང་སྲས་ཀྱི་གཟིམ་ཤག་ཏུ་ཕྱིན་པས་ཁོང་ཏ་སེ་བསྐྱོན་གྱི་འདུག་ཏོག་ཙམ་བསྡད་ནས་ལོག་པ་ཡིན།",
    "ཕྱིར་ལོག་སྐབས་བཞུ་མར་སྤར་འདུག་ཟླ་ཚེས་ཉིན།",
    "གངས་ཀྱི་མཐུག་ཚད་ནི་ཚུན་སུམ་ཅུ་ནས་བདུན་ཅུ་བར་ཟིན་འདུག་ལ་དེའི་ནུབ་ལྡེབས་ནི་གཟར་པོ་ཡིན་བ་དང་།",
    "དེ་མིན་ཆད་པ་དང་སྒལ་རྨ་བཟོས་པ་ནི་དེ་བས་ཀྱང་མི་ཉུང་བ་ཞིག་བྱུང་འདུག་མདུན་དུ་སྐྱོད་པའི་ལམ་བར་མི་གཉིས་ཤི་བ་དང་།",
    "འགྱེད་གཏོང་སྟངས་དེ་སེ་ར་དགོན་དང་ཕལ་ཆེར་འདྲ་པོ་འདུག་འབྲས་སྤུངས་དགོན་གྱི་འགྱེད་གཏོང་ས་ཁག་གཉིས་སུ་དབྱེ་ཡོད།",
    "ས་པའི་འབྲུ་རིགས་ཁལ་ལྔ་སྟོང་ཡོད་པ་ནས་རུལ་སུངས་སུ་ཕྱིན་པ་ཕུད་ན་ཕལ་ཆེར་ཁལ་ཉིས་སྟོང་སུམ་སྟོང་ཙམ་ཡོད་འདུག་ཅེས་གསུངས།",
    "སྒོ་རྭ་ཆུང་ཆུང་ཡིན་ཡང་ང་མི་གཅིག་ལ་ཉལ་ཁང་ཁང་མིག་གཅིག་དེ་དཔེ་ཁང་ཡང་བྱས་ན་ལྡང་ངེས་འདུག་ཟླ་ཚེས་ཉིན།",
    "རང་འོག་རང་འདོམས་ལ་བརྙས་བཏགས་ནམ་ཡང་མི་ཆོག་ཅེས་ཞལ་གསལ་ཡོད་སྐད་འདུག་གོ་ཐོས་ལྟར་ན་མི་གསོད་ངན་སྐུལ་བྱེད་པོ་དྲུང་ཆེ་བྱང་སྒོ་བར་སླད་ཕྱིན་དྲུང་ཆེའི་གོ་གནས་ནས་ཚེར་བསྙེགས་མི་ཆོག་པའི་ཁར་དངུལ་ཉེས་ཚེ་འགེལ་དང་།",
    "སྩལ་སྐད་འདུག་པར་རུས་ཁུས་འཕུལ་ཏེ་གཏོང་།",
    "བོད་ཀྱི་མདའ་དཔོན་བཀྲ་ཤིས་དར་རྒྱས་རྡོ་ཕྲ་བཀྲས་གླིང་པ་ཡིན་སྐད་གཉིས་ཆེད་མངགས་བསྐོ་གཞག་དང་འབྲེལ་བཏང་འདུག་ཀྱང་།",
    "རྗེས་སུ་ཤིང་འབྲུག་དམག་འཁྲུག་སྐབས་ས་བབ་རྒྱུས་ཡོད་བྱེད་མི་ཞབས་དྲུང་ས་ཧེབ་ཅེས་རྒྱལ་ཚོང་མི་ངན་ཀུན་ཏུ་གྲགས་པ་ཞིག་ཏུ་གྱུར་འདུག་ཕྱོགས་མཚུངས་གོང་གསལ་ཕྱི་རྒྱལ་གྱི་གསང་ཉུལ་དེ་ཕ་ལྷའི་ལྕམ་དང་མཉམ་དུ་རྒྱལ་རྩེ་བརྒྱུད་མར་ལམ་ཡར་འབྲོག་བསམ་སྡིང་སོགས་གནས་མཇལ་དང་སྤྲུགས་ལྷ་སར་འབྱོར་ཞིང་།",
    "རྩིས་དཔོན་ལྕང་ལོ་ཅན་པ་ཡང་རྟ་ཟེག་པ་ཞིག་བཞོན་ཏེ་ཕག་རིར་ཤད་བསྐྱོད་བྱས་པའི་གནས་ཚུལ་བྱུང་འདུག་སྐབས་དེར་འདི་སྐོར་དམངས་ཁྲོད་དུ་གཞས་ཤིག་ཀྱང་བཏང་སྐད།",
    "དེ་སྐབས་རང་ཕྱོགས་འགོ་དམག་རྣམས་ཀྱིས་འཆི་གསོན་འགག་རྩའི་སྐབས་དེར་འཇིགས་ཞུམ་སྤུ་ཙམ་མེད་པར་འགོ་དམག་ཚང་མའི་ལག་ཏུ་གྲི་ཁྱེར་ནས་གཞོག་གཅིག་གཞོག་གཉིས་ཞེས་ཐེ་ཚོམ་མེད་པར་དུས་གཅིག་ཏུ་མཆོངས་ཏེ་ལག་འཛིང་རང་ལ་གཏུགས་པས་དགྲ་དམག་སུམ་ཅུ་སྐོར་བསད་རྨས་བཏང་བ་དང་།",
    "ད་དུང་དབྱིན་འགོག་རྒྱལ་སྐྱོབ་ཀྱི་དཔའ་བོ་དཔེ་བཟང་མང་པོ་བྱུང་འདུག་པ་དཔེར་ན།",
    "ཞེས་སོགས་བྲིས་ཡོད་འདུག་དེ་ནས་དབྱིན་ཇིའི་འགོ་དམག་ཚོས་བོད་མི་དམངས་ཀྱི་སྤྱོད་ཚུལ་ངན་ཞིང་།",
    "མཧཱ་ར་ཛར་ལྟོས་མེད་ཞུས་པ་མིན་འདུག་ཁྱེད་ནས་རྒྱལ་ཁག་ཕན་ཚུན་འཁྲུག་པ་ཞི་ཐབས་དང་སྐྱེ་འགྲོ་མང་པོ་བདེ་སྐྱིད་ལ་གནས་ཐབས་བཟང་པོའི་བློ་གྲོས་ཅན་གྱི་དགེ་སྐྱོན་རྣམས་གོ་བ་ཙམ་གྱིས་སེམས་ཤིན་ཏུ་བདེ།",
    "གནམ་རུའི་རྟ་དམག་རྣམས་ལ་འབྲོང་རྩེར་ཁ་རྩྭ་གཏོང་ཡུལ་མེད་སྟབས་གནས་གསར་བརྒྱུད་བཅས་སུ་ཁ་གྲམ་གྱི་བསྡད་འདུག་པ་འགོ་བྱེད་ཆེད་འབོད་ཀྱིས་རྒྱལ་རྩེར་སང་ཉིན་རང་ཐོན་དགོས་སོགས་བཀའ་དོན་བཀོད་པ་ངེས་ནན་བཤད།",
    "གཞན་ཡང་འཕར་ཕར་སྤྲོད་ཚུར་ལེན་གྱི་ཡིག་རིགས་ཁག་བཅས་མེར་བསྲེགས་ཤག་བཤག་དབྲལ་གྱི་ལྷུ་ཚང་མིན་སོགས་ཅི་རིགས་འདུག་པ་བཅས་གོང་ཞུས་ལ་ཧེ་བག་བགས་རིས་རིགས་གཏན་ནས་མེད་ཞུ་རྒྱུར་གཞིས་སྡོད་གཉེར་ལས་འཛིན་དང་།",
    "གཞུང་སྒོའི་སྒོ་ར་བ་བཅས་རང་རང་ལས་གནས་སུ་སྔོན་དུ་བཏང་།",
    "ལ་དཀར་བུ་མཐུ་སྟོབས་རྣམ་རྒྱལ་ལ་དེ་ལམ་རྒྱ་དཔོན་བུ་དོན་རྣམ་ལ་མངགས་ཆེ་བྱས་པ་ནང་བཞིན་གྱི་གནས་ཚུལ་ཡི་གེ་གཅིག་བཅས་ང་རང་ལ་བཟོ་དགོས་གསུངས་པ་ལྟར་དེ་དོན་བཟོས་ནས་བསྐུར་བ་ཡིན།",
    "ང་རང་གྲྭ་བཞི་ཡས་མས་སུ་འབྱོར་ཚོད་ལ་ཞལ་ངོ་དགེ་གཡོག་དང་།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཁ་བ་ལྷབ་ལྷུབ་ཏུ་བབས་འདུག་ཀྱང་།",
    "དེ་ལན་དུ་ང་རང་ཆེད་མངགས་ཀྲུང་དབྱང་ལ་བོད་འདི་ཀྲུང་གོས་རང་གཟུགས་རང་བདག་ཡོད་པའི་བརྒྱུད་སྐུལ་སྙན་སེང་ཞུ་རྒྱུའི་དོན་ཆེན་དེ་བཞག་ནས་ཚོང་འཁོས་ལ་མགོ་འཁོར་ནས་སྡོད་ཐབས་རྩ་བ་ནས་མེད་ངེས་ཡིན།",
    "ང་རང་ཡང་འདི་ཕྱོགས་གཏོང་ལུགས་གཏོང་སྟངས།",
    "ཁྱེད་རང་དགོངས་པ་ཡག་པ་བཞེས།",
    "པཱ་ལགས་ཀྱིས་སློབ་སྦྱོང་ལོ་བཅུ་ཙམ་གནང་རིང་རང་ཡུལ་དུ་འཁོར་ཞག་ལ་ཐེངས་གཅིག་ཕེབས་པ་ཕུད།",
    "ཐིག་ལེན་འཕྲུལ་འཁོར་སྒྲིགས་གཤོམ་སོགས་གང་སར་པཱ་ལགས་རང་ཉིད་ངོ་ཕེབས་ཀྱིས་བཀོད་པ་གཏོང་གནང་དགོས་ཀྱི་འདུག་གང་ལགས་ཤེ་ན།",
    "གསོལ་ཆས་དུས་ཐོག་ཏུ་མེད་པ་དང་ངལ་གསོ་གནང་ཁོམ་མེད་པའང་ཡང་ཡང་བྱུང་འདུག་མཐོར་ལོར་དོག་བདེར་ཆུ་ཤུགས་གློག་ཁང་ལེགས་གྲུབ་ཟིན་པ་དང་།",
    "གཉིས་པ་ནི་བོད་ལྗོངས་ལ་བཙུགས་པ་དེ་ཡིན་ཚོད་འདུག་དེ་སྔ་བོད་ཀྱི་དངུལ་ལོར་པར་འདེབས་སོགས་ལག་ཤུགས་ཀྱིས་བྱེད་དགོས་པ་དེ་དག་དོག་བདེ་ཆུ་ཤུགས་གློག་འདོན་ཁང་ལེགས་གྲུབ་ཟིན་རྗེས་གྲྭ་བཞི་གློག་འཕྲུལ་ཁང་གསར་རྒྱག་དང་འབྲེལ་དོག་བདེ་ནས་གྲྭ་བཞིར་གློག་བཏང་སྟེ་དངུལ་ལོར་པར་འདེབས་དང་དེ་མིན་གྲྭ་བཞིར་གཅུས་གཟེར་སོགས་ལེ་ལག་ཙག་ཙིག་བཟོ་བ་དང་།",
    "ད་དུང་པཱ་ལགས་ཀྱིས་གྲྭ་བཞིར་རྫས་མདེལ་བཟོ་བའི་ཚོད་ལྟའང་གནང་འདུག་རྫས་ནི་ཚད་ལྡན་བཟོ་གནང་ཐུབ་ཡོད་རུང་།",
    "ཚང་མས་གློག་བཞུ་ནི་ས་བཞུ་ལྟ་བུའི་སྣུམ་དང་ཕུ་ཡང་ཡང་རྫོགས་པ་སོགས་རྙོག་གྲ་མེད་པ་དང་སྦྲང་མ་རྣམས་འོད་ལ་ལྕེབས་ནས་ཤི་བ་སོགས་མི་དགོས་པའི་དགེ་མཚན་ཆེ་ལ་བཞུ་འོད་ཀྱང་ཧ་ཅང་གསལ་པོ་འདུག་ཅེས་ཟེར་བ་དང་།",
    "དེ་བཞིན་ང་རང་ལོ་དྲུག་ཙམ་ལ་སླེབས་དུས་པཱ་ལགས་ཀྱིས་ང་ལ་དབྱིན་ཇིའི་དབྱངས་གསལ་གྱི་ཡི་གེ་སློབ་འགོ་འཛུགས་གནང་དང་།",
    "ང་རང་དུས་ལ་མཛོད་གོས་སེར་པོ་གྱོན་རྒྱུ་བྱུང་རི་བོ་ཟས་ཀྱང་མི་འགྲངས།",
    "རྩེ་མགྲོན་རྡོ་རྗེ་ཕུན་ཚོགས་གཉིས་སུ་སླེབས་འདུག་ཅིང་།",
    "ང་རང་དང་རྡོ་རྗེ་ཕུན་ཚོགས་གཉིས་ཀྱིས་ཡིག་རིགས་གང་ཡོད་བསྔོག་འདོན་བྱས་པར་ཧོར་ཚོའི་ཞིབ་གཞུང་ཤོག་སྒྲིལ་ཆེན་པོ་སུམ་ཅུ་ཙམ་འདུག་པ་དེ་དག་དང་།",
    "ང་རང་དང་རྡོ་རྗེ་ཕུན་ཚོགས་ཀྱིས་ཡི་གེ་བལྟ་ཀློག་བྱེད་མུར་རྡོ་རྗེ་ཕུན་ཚོགས་ཀྱིས་ང་ལ་ལག་བརྡ་དང་།",
    "ཤོག་བུ་མཐའ་བཞི་གཙང་དྲས་བརྒྱབ་པ་གཅིག་དང་དམ་ཕྲུག་བསྣམ་ཕེབས་ཟེར་བ་ང་རང་ནས་ཤོག་བུ་གཙང་དྲས་བརྒྱབ་པ་དང་།",
    "ང་དགོངས་སེལ་ཞུ་དགོས་པ་གང་ཡང་བྱས་མེད་ཅེས་ལན་འདེབས་གནང་འདུག་རྭ་སྒྲེང་རྒྱལ་པོ་སྔར་བས་དགོངས་པ་ཚོམ་ཆེ་རུ་ཡོད་འགྲོ།",
    "བཞེས་ཞོག་གསོལ་ཐབ་ཀྱི་བོད་ལབ་དང་ཞོག་ཁོག་བཅས་གང་དགོས་པད་གྲོང་གཞིས་ཀར་སྐུལ་ཐམ་བཏང་འཕྲལ་ལམ་སེང་དབྱར་དགུན་སྟོན་དཔྱིད་ག་དུས་མིན་རུང་ཆིབས་རྭའི་རྩིས་སྤྲོད་རྟ་དྲེལ་གཅིག་ལ་བཀལ་ནས་འབུལ་མིའི་བཞོན་རྟ་ནོར་གླིང་རྒྱལ་སྒོའི་ནང་བཞོན་ཏེ་རྩེ་གསོལ་ཐབ་བར་ཡོང་ཆོག་གསོལ་ཐབ་ནས་དེར་ཇ་རྩམ་སྤྲོད་དགོས།",
    "རྒྱུན་དུ་རྟ་སྦང་རང་བདག་ཆོག་པ་བཅས།",
    "དཀར་ཐུག་མིང་འདུག་བཅས་ཀྱང་གཉེར་པ་སྐུ་གཞོན་གྱིས་གཏོང་དགོས།",
    "རྟ་བཏགས་ཤུལ་དུ་བང་ལྕི་མང་པོ་འདུག་པ་ལས།",
    "ཆ་སྒམ་སོགས་བཤག་གཏོར་བཏང་སྟེ་དངོས་རིགས་གང་ཐོབ་བཅོམ་འཁྱེར་བྱེད་བཞིན་འདུག་འགོ་དམག་ལ་གང་སར་འཚང་འཛུལ་བརྐུ་བཅོམ་མི་ཆོག་པའི་བཀོད་བརྡ་བཏང་བར་སུས་ཀྱང་བརྩི་མཁན་མེད་ཁར།",
    "དེའི་དུས་བཙན་རྒྱལ་དབྱིན་ཇིས་བོད་ལ་བཙན་འཛུལ་གྱི་འགོ་ཚུགས་པ་སོགས་ཆབ་སྲིད་གནས་ཚུལ་གྱིས་རྐྱེན་པས་སྲིད་སྐྱོང་ལས་འཁུར་བློ་དགོངས་ཞུ་གནང་དགོས་བྱུང་འདུག།",
    "ཚོ་དྲུག་ཅེས་པའི་འབོད་སྲོལ་ནི་ནག་ཚང་ཨ་ཇོ་དཔལ་ལྡན་ཞེས་པའི་སྐབས་བྱུང་བ་ལས།",
    "ཨ་ཇོ་ཞེས་པའི་མི་གཅིག་དང་།",
    "ལས་བྱ་ཨ་ཇོ་ཞེས་པའི་མི་གཅིག་སྤོ་བོ་ཞེས་པའི་མི་བཞི་བཅས་ལས་གྲུབ་པ་དེ་དག་རིམ་པ་གཅིག་མཚུངས་མི་དྲུག་ལ་འགོ་ལྷན་དྲུག་སྦྲེལ་ཞེས་པ་ཞིག་རྩ་འཛུགས་བྱས་པ་དང་།",
    "དེ་རྗེས་འགོ་པ་ཨ་ཇོ།",
    "ལྷག་པར་རིམ་བྱུང་དཔོན་རིགས་ནང་སྙན་གྲགས་ཆེ་ཤོས་ནག་ཚང་ཨ་ཇོ་དཔའ་ལ་དཔལ་བཟང་རབ་བརྟན་ཟེར་བ་ཞིག་བྱུང་འདུག་ཅིང་།",
    "ང་རང་བཅས་ཀྱིས་འགན་འཁུར་བྱ་རྒྱུ།",
    "ང་རང་བཅས་ཀྱིས་འགན་འཁུར་བྱ་རྒྱུ།",
    "གོ་ཐོས་སུ་དོ་ནུབ་ཟིང་ཆ་ལངས་རྒྱུའི་སྐད་ཆ་འདུག་པས་དུས་ཐོག་ཏུ་གཉིད་ཉལ་མ་ཐུབ་པར་བཞུ་འོད་འོག་ཆུ་ཚོད་བར་དེབ་ཀློག་སྟེ་བསྡད་པ་ཡིན།",
    "ང་གཉིས་ཀྱི་སྡོད་ས་ཧ་ཅང་མཐོ་པོ་བཟོས་འདུག་ཅིང་།",
    "མཇལ་ཁ་ཞུ་མཁན་ཧ་ཅང་མང་པོ་འདུག་ཆུ་ཚོད་པའི་ཐོག་གཞི་ནས་ཕྱིར་ལོག་ཡོང་བ་ཡིན།",
    "འོལ་ཚོད་བྱེད་དཀའ་ཙམ་འདུག་ལྕམ་མདར་གཙོ་བོ་ཞིང་ལས་འཚམས་པ།",
    "བེའུ་ཉིན་མཚན་ག་དུས་སྐྱེས་ན་དེ་འཕྲལ་འཁྱག་ཤི་མི་ཐེབས་པ་དང་།",
    "གལ་ཏེ་ལྕི་ནང་ཉི་སྐམ་གཏོང་རྒྱུར་དོ་སྣང་མ་བྱས་ན་ཕྱུར་བ་དུས་ཐོག་དུས་ཚིགས་ནང་མར་དང་ཕྱུར་བ་གསོག་རྒྱུར་དོ་སྣང་དང་དམ་འཛིན་བྱེད་དགོས་ཤིང་།",
    "ཤོད་དྲུང་ས་མཁར་བ་གཉིས་བཅས་སྐྱོབ་གསོ་དོ་དམ་པར་བསྐོ་གཞག་དང་འབྲེལ་སྐྱོབ་གསོ་འབྲུ་རུའུ་ཁལ་ཁྲི་བརྒྱད་ཙམ་གནང་རྒྱུའི་དྲུང་རྩིས་གཉིས་ལ་ཟུར་དུ་ནང་མངགས་ཡོད་འདུག་པ་དང་།",
    "བོད་ཞི་བས་བཅིངས་འགྲོལ་ཐོབ་སྟེ་ང་རང་ལས་ཞོར་དུ་རྒྱལ་གཅེས་གཞོན་ནུ་མཐུན་གྲོགས་ཚོགས་པའི་ནང་ཞུགས་ནས་སློབ་སྦྱོང་དང་།",
    "དངོས་རིགས་སོགས་འཕྲོག་བཅོམ་ཅི་ཆེ་བྱེད་པའི་འབིར་གྲགས་ཁྱབ་དུས་ང་རང་ལ་མེ་མདའ་རིང་ཐུང་དང་།",
    "མེ་མདའ་འཁྱེར་བའི་རྟ་པ་བདུན་སྔ་དྲོའི་ཆུ་ཚོད་དགུ་ཙམ་ལ་ང་རང་སྡོད་གནས་ལྷ་གསོལ་གཞིས་ཁང་ནང་འཛུལ་ཡོང་སྟེ་སྒོ་ཁར་ཁམས་པ་གཉིས་དང་།",
