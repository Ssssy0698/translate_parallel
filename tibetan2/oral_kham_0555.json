    "དོན་དམ་པར་ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་མེད་པའི་དོན་ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་ཉིད་མཐའ་བཞིར་དཔྱད་ན་མི་རྙེད་པ་ལ་བྱས་འདུག་པའི་ཕྱིར།",
    "འདིའང་བརྟགས་ན་མི་རུང་སྟེ་དོན་རྣམས་ལ་སྔ་ཕྱིའི་དབུས་ན་འདུག་པས་ཁྱབ་ཅིང་སྣང་བ་ལ་ད་ལྟར་བས་ཁྱབ་ལ།",
    "ཁྱབ་པའི་སྒོ་ནས་ནི་དངོས་པོ་ཙམ་ཡང་རང་བཞིན་མེད་པར་གྲུབ་སྟེ།",
    "ཕ་རོལ་མ་དད་ན་མི་ཉན་པས་དེའི་དོན་མི་འགྲུབ་ཅིང་རང་ལ་སྨོད་པས་ཕ་རོལ་ཉམས་པའི་དོན་མ་ཡིན་པ་ཐོབ་པའི་ཕྱིར་ཏེ།",
    "སེམས་ཙམ་པ་དང་རང་རྒྱུད་པ་དག།",
    "རང་ཉིད་ཀྱི་སྐུ་གཅིག་གམ་བ་སྤུའི་ཁུང་བུ་གཅིག་ལའང་རང་གཞན་གྱི་དུས་གསུམ་གྱི་སྤྱོད་པ་དང་འཁོར་འདས་ཀྱི་སྣང་བ་མ་ལུས་པ་སྟོན་པ་སྟེ།",
    "ལྷར་བཅས་འགྲོ་རྣམས་རང་རང་ལས་མཐུན་པའི།",
    "ཀུན་གཞི་དང་རང་རིག་མི་འདོད་པས་ཕྱི་དོན་ཁས་ལེན་པའི་ཚུལ།",
    "དེའི་ཚེ་རྗེ་འདི་ཉིད་ཀྱི་ཐུགས་རྒྱུད་ལ་ཞང་ཐང་སག་པ་ནས་བརྒྱུད་པའི་ཡོད་མིན་མེད་མིན་གྱི་ལྟ་བ་དེ་ཡོད་པས་དེ་སྐད་དུ་གསུངས་པ་ཡིན་པར་འདུག་ཅེས་བྲིས་སྣང་ངོ།",
    "ཐ་སྙད་བཏགས་པའི་དོན་བཙལ་བའི་ཚེ་ན་མི་རྙེད་ཅེས་པའི་སྒྲ་ཙམ་སྨྲས་ཀྱང་དོན་ལ་བཙལ་ནསརྙེད་པར་བྱས་འདུག་སྟེ།",
    "མུ་སྟེགས་གཞན་དང་རང་ཉིད་ཀྱིའང་།",
    "སྨྲས་ཀྱང་རང་བཟོ་མིན་པ་ལུང་དང་མཐུན་པ་ཁྱེད་ལ་མེད་དོ།",
    "རང་རང་རྩ་བའི་སྔགས་བརྗོད་པས་།",
    "ཨ་ཙི་ཏེ་ཨ་པ་ར་ཙི་ཏ།",
    "སྐུ་ལུས་ལ་མར་མེ་སྟོང་བཙུགས་པ་སོགས་ལུས་ལོངས་སྤྱོད་ཐམས་ཅད་གཏོང་བར་མཛད་འདུག།",
    "ལ་རག་ལས་པས་བཤེས་གཉེན་བསྟེན་ཚུལ་མ་འཆུགས་པ་ཅིག་མི་བྱེད་པའི་ཐབས་རང་མི་འདུག་ཨང་།",
    "སྐྱོན་ཡོད་པ་ལྟར་སྣང་ཡང་ང་རང་སྣང་བ་མ་དག་པ་ཡིན།",
    "ཀྱི་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་པས་སྡུག་བསྔལ་བའི་རང་བཞིན་མ་གཏོགས་བདེ་བའི་རང་བཞིན་ཅུང་ཟད་ཀྱང་མི་འདུག་གོལྷ་མིན་ནི་ལུས་བཅད་དྲལ་སོགས་ཀྱི་སྡུག་བསྔལ་ཤིན་ཏུ་རྩུབ་ལས་མ་འདས།",
    "ཞེས་གསུངས་གདའའོ།",
    "ཙམ་དུ་གདའ་ནའང་།",
    "རང་ཉིད་ཚེ་རབས་ཐོག་མ་མེད་པ་ནས་ལས་ཉོན་གྱི་སྒྲིབ་པས་ཧ་ཅང་སྦགས་ཆེས་པའི་མཐུས་མེད་བཞིན་དུ་སྣང་བར་འདུག།",
    "ཡེ་ནས་མི་འགྲུབ་ཅིང་མི་རུང་བ་ཞིག་འདུག་ན།",
    "གཡས་གཡོན་དུ་གྲལ་ཆིག་སྦྲེངས་བྱས་པའི་ཚོགས་ཚོགས་པའི་རྣམ་པ་ལྟ་བུ་སོགས་ཕྱག་ལེན་མང་དུ་འདུག་པ་རྣམས་གསང་སྔགས་ཀྱི་ཤན་ཤོར་བས་ལུགས་སྲོལ་འདི་གའི་ཕྱག་ལེན་དང་ཅུང་ཟད་མི་མཐུན་པར་གདའ།",
    "ཡང་བྲོས་པས་ལྕགས་ཀྱིས་ཁོང་པའི་ནང་དུ་སླེབ་པ་ན་སྒོ་དབྱེར་མེད་དུ་འགྲིག་སྟེ་ཕྱོགས་ཀུན་ནས་མེ་འབར་ཏེ་བསྲེགས་པས་དེ་འབྲོས་ས་ཡང་མི་འདུག་སྙམ་ནས་ངུ་འབོད་ལྷང་ལྷང་བ་ལམ་རིམ་འཇམ་དཔལ་ཞལ་ལུང་།",
    "བརྣབ་སེམས་ནི་གཞི་གཞན་གྱི་ནོར་ལ་དེར་འདུ་ཤེས་ཤིང་རང་ནོར་ལ་ཆགས་སེམས་དང་གསོག་སེམས།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "དེ་བཞིན་དུ་ལུས་ཀྱི་མཐུ་ཉམས་པས་ལྡང་འདུག་ཚུལ་བཞིན་དུ་མི་འོང་།",
    "བདག་ཏུ་ལྟ་བུའི་གཞོན་ནུ་ཞིག་གནས་སྐབས་འདི་འདྲར་གྱུར་འདུག་གོ་བསམ་པའི་ཚུལ་གྱིས་བསྒོམ་གསུང་།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ་ ཤིན་ཏུ་སྐོམ་པས་གསུངས་པའང་ཆུ་ཞིག་རྙེད་ན་དགའ་མགུར་འཐུང་།",
    "མི་འདོན་ངལ་བར་འདུག་རྣམས་གདོན་གྱིས་བརླམས།",
    "དགའ་བར་འདུག་ན་སྨད་པ་ལ་མི་དགའ་བ་ཤུགས་ཀྱིས་འོང་བས།",
    "དེ་ལྟར་བསྒོམས་པས་ཀྱང་རང་ལ་བསྟོད་སྨད་བྱས་པ་མགོ་སྙོམས་པ་བྱུང་ནའང་།",
    "ད་དུང་དགྲ་ལ་ཕུན་སུམ་ཚོགས་པ་འདུག་པ་མི་བཟོད་པའི་བློ་ཐོལ་གྱི་ཤར་བྱུང་ན།",
    "རང་སྡུག་བསྔལ་ཐོག་ཏུ་བབས་པ་འདི་མི་བཟོད་པར་འདུག་སྙམ་ན།",
    "ཅེས་མགོ་དང་མིག་ལ་སོགས་པ་གཏོང་པ་ལ་ཚོད་མའི་ཚ་བ་འདྲེན་པ་ཙམ་གྱི་བློ་སྐྱེ་བའི་ཚེ་གཏོང་བ་ཡིན་པས་དཀའ་བ་མི་འདུག་སྙམ་པའི་སྤྲོ་བ་ཆེན་པོ་བསམ།",
    "ཞེས་སྐབས་སུ་བབ་ཅིང་རང་ཉིད་དམིགས་པ་གཅིག་ལ་གཏོད་པའི་ཡུལ་ནི་སྤྱིར་བཏང་ལ་སྐུ་གཟུགས་ལྟ་བུ་འོས་ཤིང་།",
    "གསལ་ཆའི་ངར་ཚ་ཧད་ཀྱི་ཤོར་ནས་དྭངས་ཆ་ཙམ་ལས་མི་འདུག་ན་བྱིང་བ་རགས་པར་ངོ་ཤེས་པར་བྱེད།",
    "དེ་ཡང་རང་ཅག་རྣམས་ཀྱིས་རྒྱུད་ལ་གཉིད་ལོག་པ་དང་མ་ལོག་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་ངའོ་སྙམ་པའི་བློ་དམ་སྒྲིང་སྒྲིང་པ་ཞིག་ཡོད་ཀྱང་།",
    "ཞེས་སྐྱེ་བ་སྔོན་མའི་ང་དང་རྗེས་མའི་ང་རང་བཞིན་གྱིས་ཐ་དད་པ་ཡིན་ན་གཏན་ནས་འབྲེལ་མེད་པའི་ཐ་དད་པ་ཡིན་པས།",
    "ད་ང་དང་ཕུང་པོ་ལྔ་ཐ་དད་པ་ལས་འོས་མི་འདུག་སྙམ་པ་ན།",
    "ཤེས་བཞིན་གྱིས་ངར་འཛིན་པའི་རྟོག་པ་བཅད་མ་བཅད་ཀྱི་བྱ་ར་བྱེད་ཅིང་ང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཚུལ་ལ་གསལ་འདེབས་དགོས་པ་བྱུང་ན་ཅུང་ཟད་དཔྱད་པའི་སྒོ་ནས་ཚུལ་དེ་ལྟར་དུ་གྲུབ་པ་མེད་སྙམ་དུ་མཉམ་པར་བཞག།",
    "རྟ་གླང་རང་བཞིན་གྱིས་གྲུབ་པ་རིགས་པས་འགོག་པའི་ཚེ་དེ་ལྟ་བུའི་ཐ་སྙད་པའི་ཤེས་ངོ་དེར་རྟ་གླང་ཡང་དག་པར་འཛིན་པའི་ཤེས་པ་དེ་འཁྲུལ་ཤེས་ཡིན་པ་སྒྱུ་མའི་རྟ་གླང་དང་མཚུངས་ཤིང་།",
    "རྟ་གླང་རང་བཞིན་གྱིས་མ་གྲུབ་པར་བསམས་ཏེ།",
    "བདག་རང་བཞིན་མེད་པར་རྟོགས་པ་ན་དེའི་གདགས་གཞིའི་ཕུང་པོ་ལྔ་ཡང་རང་བཞིན་གྱིས་ཡོད་པར་འཛིན་ལམ་རིམ་འཇམ་དཔལ་ཞལ་ལུང་།",
    "དེ་གཞན་གྱིས་སྤྱོད་དུ་འཇུག་པ་ལ་ཡང་རང་ཉིད་ཀྱིས་ལམ་རིམ་འཇམ་དཔལ་ཞལ་ལུང་།",
    "ལག་ལེན་དམར་འཁྲིད་དུ་གསལ་བར་ཡི་གེར་འདྲི་བ་གཅིག་ཏུ་བསྟན་པའི་རྒྱུན་ལ་མི་ཕན་པར་འདུག་ནའང་།",
    "འདི་བདག་ལ་ཕན་པ་ཞིག་ཡོད་བར་གོར་མ་ཆག་སྙམ་དུ་ཚམ་ཚོམ་མེད་པར་འཇུག་པའམ་ཡེ་ནས་མི་འགྲུབ་ཅིང་མི་རུང་བ་ཞིག་འདུག་ན།",
    "རང་ཉིད་བདེ་བའི་སྟན་ལ་བག་མེད་པའི་འདུག་ཚུལ་མིན་པའི་སྐྱིལ་ཀྲུང་ངམ་སྐྱིལ་ཀྲུང་ཕྱེད་པ་སོགས་སྤྱོད་ལམ་གང་ཡང་རུང་བས་འཁོད་དེ།",
    "ཚང་འདུག་ན་ཡིད་དགའ་བ་ལྷང་བ་ཞིག་མ་སྐྱེས་ཀྱི་བར་དུ་བསྒོམ་དགོས་པ་ཡིན་ཏེ།",
    "དལ་འབྱོར་གྱི་མི་ལུས་ནི་གྱང་ལོགས་ལ་ཆགས་པའི་སྲན་མ་དང་ཚུལ་མཚུངས་པར་འདུག་གོ་སྙམ་ནས་དཔེ་དོན་རྒྱུད་ཐོག་ཏུ་འཕྲོད་ངེས་ཤིག་སྦྱར་ཏེ་བསྒོམ།",
    "ད་ལྟ་རང་ལས་རྒན་པ་མང་པོ་ཞིག་འདུག་པས།",
    "ཕྱོགས་ཀུན་ནས་མེ་འབར་སྟེ་བསྲེགས་པས་ད་བྲོས་ས་ཡང་མི་འདུག་སྙམ་ནས་ངུ་འབོད་ལྷང་ལྷང་བ་བྱེད་དོ།",
    "གསར་དུ་མི་གསོག་པ་ཞིག་ངེས་པར་དགོས་འདུག་ཀྱང་།",
    "འཁོར་ལོས་བསྒྱུར་རྒྱལ་སོགས་ཀྱི་ལུས་རྟེན་གྲངས་མེད་པ་ཞིག་བླངས་འདུག་ཀྱང་།",
    "ཡིད་མཐུན་གྱི་གནས་སུ་བདེ་བའི་སྟན་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དམ་སྤྱོད་ལམ་གང་བདེར་གནས་ནས།",
    "ཞིང་རྣམས་ཀྱང་རང་ཉིད་ལ་དགྱེས་པའི་ཚུལ་དང་།",
    "དལ་འབྱོར་དོན་ཆེ་རྙེད་དཀའི་རྟོགས་པ་ཁྱད་པར་ཅན་རྒྱུད་ལ་མ་སྐྱེས་པས་ལན་པར་འདུག་པས།",
    "དེས་ན་འདི་ལྟ་བུའི་ངན་འགྲོའི་སྡུག་བསྔལ་བཟོད་གླགས་མི་འདུག་པས་རྙེད་པར་དཀའ་ཞིང་རྙེད་ན་དོན་ཆེ་བའི་དལ་འབྱོར་ཚང་བའི་རྟེན་ཐོབ་པའི་དུས་འདིར།",
    "དེས་ན་སྡུག་བསྔལ་ཐམས་ཅད་ཀྱི་རྩ་བ་མཐར་གཏུགས་ན་མ་རིག་པར་འདུག་པས།",
    "ཁྱད་པར་བསྲུངས་ན་ཕན་ཡོན་ཆེ་ཞིང་མ་བསྲུངས་ན་ཉེས་དམིགས་ཤིན་ཏུ་ཆེ་བར་འདུག་པས།",
    "ཚེ་འདིར་ཡང་མ་བུ་ཕན་ཚུན་ངོ་མི་ཤེས་པ་དུ་མ་འདུག་པས་སོ་སྙམ་དུ་བསམ།",
    "འདི་ལ་ཟག་མེད་ཀྱི་བདེ་བ་ག་ཡོད་ ཟག་བཅས་ཀྱི་བདེ་བ་ཙམ་ཡང་མི་འདུག་ད་ལྟ་བདེ་བ་རློམ་པ་འདི་དག་སྡུག་བསྔལ་དུ་འགྱུར་ནས་འགྲོ།",
    "ཡང་དག་པའི་བདེ་བ་ཞིག་གཏན་ནས་མི་འདུག་དེ་ནས་འདི་ཉིད་བདེ་བ་དང་བདེ་བའི་རྒྱུ་ཐམས་ཅད་དང་ལྡན་ན་ཅི་མ་རུང་།",
    "དེར་སྐྱེས་ན་ཡུན་རིང་ཤུགས་དྲག་པའི་སྡུག་བསྔལ་སྣ་ཚོགས་པ་ཞིག་མྱོང་དགོས་པ་འདུག་དེས་ན་འདི་དག་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་ཐམས་ཅད་དང་བྲལ་ན་ཅི་མ་རུང་།",
    "འགྱུར་བའི་སྡུག་བསྔལ་གཉིས་ཀྱིས་གདུངས་ནས་བདེ་བའི་སྐབས་ཅུང་ཟད་ཀྱང་མི་འདུག།",
    "སྡུགབསྔལ་སྣ་ཚོགས་ཤིག་མྱོང་བར་འདུག།",
    "གཞན་གཅེས་པར་འཛིན་པ་ནི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་སུ་འདུག་པས།",
    "དེ་ཡང་རང་གཅེས་འཛིན་ཁོང་ན་གནས་ཕྱིན་ཆད་གཞན་གཅེས་འཛིན་གསར་དུ་མི་སྐྱེ་ཞིང་།",
    "སྐྱེས་ཀྱང་རྒྱུན་འཐུད་མི་ཐུབ་པར་འདུག་པས།",
    "དེ་ཡང་ད་ལྟ་ནི་བདག་ལ་དེ་ལྟ་བུའི་ནུས་པ་མི་འདུག།",
    "དེས་ན་རང་ཉམས་ལ་དཔགས་ཏེ་རིག་པ་འཕང་འདི་ཙམ་ཞིག་བསྟོད་ན་རྒོད་པ་སྐྱེ་བར་འདུག་སྙམ་པ་ལས་ཅུང་ཟད་གློད།",
    "འདི་ཙམ་དུ་བཞག་ན་བྱིང་བ་སྐྱེ་བར་འདུག་སྙམ་པ་ལས་ཅུང་ཟད་འཕང་བསྟོད་ན་རན་པར་འགྱུར་བས།",
    "ཞེས་ཐ་དད་དུ་ངོས་འཛིན་རྒྱུ་དགོས་པ་ལས་དེ་ལྟར་མི་འདུག་པས།",
    "དེའི་ཚེ་ངེས་ངོར་ང་རང་བཞིན་མེད་པར་ངེས་པའི་ངེས་ཤེས་ངམ་སྤྲིང་ངེ་བ་དང་།",
    "ལུས་དེ་འདིའོ་ཞེས་བསྟན་རྒྱུ་དགོས་པ་ལས་དེ་ལྟར་མི་འདུག་པས།",
    "ལོ་དེ་འདིའོ་ཞེས་བསྟན་རྒྱུ་དགོས་པ་ལས་དེ་ལྟར་མི་འདུག་པས།",
    "དེ་ལྟ་བུའི་ལོ་གཏན་མི་འདུག་སྙམ་དུ་ངེས་ཤེས་དྲངས་ནས་སྔར་ལྟར་བསྐྱང་བར་བྱའོ།",
    "སྟེན་བདེ་བ་ལ་ལུས་འདུག་ལུགས་བརྒྱུད་དམ་སྤྱོད་ལམ་གང་བདེར་གནས་ནས།",
    "སྟན་བདེ་བ་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དམ་སྤྱོད་ལམ་གང་བདེར་གནས་ནས་ཞེས་པའི་སྟན་བདེ་བ་ལ་ལུས་འདུག་ལུགས་བརྒྱད་བྱེད་ཚུལ་ལ་རྒྱལ་བ་དབེན་ས་པ་ཆེན་པོས།",
    "ཚོགས་ཞིང་རྣམས་ཀྱང་རང་ཉིད་ལ་དགྱེས་པའི་ཚུལ་དང་།",
    "ད་དུང་སྡུག་བསྔལ་གྱི་གཏིང་དང་མཐའ་རྟོགས་དཀའ་བ་འདུག།",
    "དུད་འགྲོའི་སྐྱེ་གནས་ན་ཡང་གདའ།",
    "སྲོག་གཅོད་ཀྱི་རྒྱལ་པོར་འདུག་སྙམ་དུ་ཕྱིར་ལོག་པ་དང་ རྒྱལ་པོས་སླར་བཀུག་ནས་མཇལ་བས།",
    "མར་པས་རྗེ་བཙུན་མིད་ལའི་ལས་སྒྲིབ་སྦྱོང་ཕྱིར་དུ་མར་པའི་སྐུ་མཁར་དགུ་ཐོག་མ་གྲངས་དེ་ཙམ་ཞིག་ཁོང་རང་གཅིག་པུས་སྐུ་རྒྱབ་ལ་སྒལ་པ་བྱུང་བྱུང་ལས་བྱེད་དུ་བཅུག།",
    "འོན་ཀྱང་རང་ལ་ངན་པ་ལས་མེད་པའམ།",
    "རྗེ་བཙུན་མིད་ལས་ཀྱང་མར་པའི་སྐུ་མཁར་དགུ་ཐོག་མ་གྲངས་དེ་ཙམ་ཞིག་ཁོང་རང་གཅིག་པུས་བསྒྲུབས་ཤིང་།",
    "ཐ་ན་བཞོན་མ་འཇོ་བའི་འཕོང་སྟེགས་ཚུན་ཆད་ཀྱིས་མི་དལ་བར་བསྙེན་བཀུར་བྱས་པས་དོན་ཐམས་ཅད་གྲུབ་པར་གདའ།",
    "དལ་འབྱོར་དོན་ཆེ་རྙེད་དཀའི་རྟོགས་པ་ཁྱད་པར་ཅན་མ་སྐྱེས་པས་ལན་པར་འདུག་པས།",
    "ལས་འབྲས་ལ་ཡིད་ཆེས་ཀྱི་དད་པ་མ་སྐྱེས་པས་ལན་པར་འདུག་པས།",
    "དེ་རིང་རང་ཡང་འཆི་ཉེན་ཡོད་པས་འཆི་གྲབས་ཤིག་བྱ་དགོས་པར་འདུག།",
    "མིའི་མེ་ལས་བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་བདུན་འགྱུར་གྱིས་ཚ།",
    "དེས་ན་འདི་ལྟ་བུའི་ངན་འགྲོའི་སྡུག་བསྔལ་བཟོད་གླགས་མི་འདུག་པས།",
    "སྟོབས་ཉམས་པས་འགྲོ་འཆག་ཉལ་འདུག་དཀའ་བ་དང་།",
    "ཤེས་པ་དུ་མ་འདུག་པས་སོ།",
    "ད་ལྟ་བདག་དང་འདི་གཉིས་གང་ཡང་འབྲེལ་མེད་འདྲ་འདྲ་ཞིག་འདུག་ཀྱང་།",
    "ད་ལྟ་བདེ་བར་རློམས་པ་འདི་དག་ཀྱང་སྡུག་བསྔལ་དུ་འགྱུར་ནས་འགྲོ་བར་འདུག།",
    "ཚེ་འདིར་ཡང་ངལ་ཞིང་དུབ་པས་སྡུག་བསྔལ་བར་བྱེད་པར་མ་གཏོགས་ཡང་དག་པའི་བདེ་བ་ཞིག་གཏན་ནས་མི་འདུག།",
    "དེར་སྐྱེས་ན་ནི་ཡུན་རིང་ལ་ཤུགས་དྲག་པའི་སྡུག་བསྔལ་སྣ་ཚོགས་ཤིག་མྱོང་དགོས་པར་འདུག།",
    "འགྱུར་བའི་སྡུག་བསྔལ་གཉིས་ཀྱིས་གདུངས་ནས་བདེ་བའི་བློ་ཅུང་ཟད་ཀྱང་མི་འདུག།",
    "དེར་སྐྱེས་ན་ནི་ཡུན་རིང་ལ་ཤུགས་དྲག་པའི་སྡུག་བསྔལ་སྣ་ཚོགས་མྱོང་དགོས་པ་འདུག།",
    "གཞན་གཅེས་པར་འཛིན་པ་ནི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་སུ་འདུག་པས་གཞན་གཅེས་འཛིན་མ་སྐྱེས་པ་གསར་དུ་སྐྱེད།",
    "སྐྱེས་ཀྱང་རྒྱུན་འཐུད་མི་ཐུབ་པར་འདུག་པས་རང་གཅེས་པར་བཟུངས་ནས་གཞན་ཡལ་བར་འདོར་བའི་བློ་མི་སྐྱེད་པར་རང་ཡལ་བར་ལམ་རིམ་དམར་ཁྲིད་མྱུར་ལམ།",
    "སེམས་ཀྱི་འཇོག་ས་དེ་ན་གདའ།",
    "དེས་ན་རང་ཉམས་ལ་དཔགས་ཏེ་རིག་པ་འཕང་འདི་ཙམ་ཞིག་བསྟོད་ན་རྒོད་པ་སྐྱེ་བར་འདུག་སྙམ་པ་ལས་ཅུང་ཟད་གློད།",
    "རིག་པ་འཕང་འདི་ཙམ་ཞིག་གློད་ན་བྱིང་བ་སྐྱེ་བར་འདུག་སྙམ་པ་མས་ཅུ་ཟད་འཕང་བསྟོད་དེ་རན་པར་བྱས།",
    "ཐ་དད་དུ་གྲུབ་ན་སྤྱིར་ཐ་དད་ཙམ་ལ་འབྲེལ་མེད་ཐ་དད་ཡིན་མི་དགོས་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དད་ཡིན་ན་འབྲེལ་བ་གཏན་ནས་མེད་པའི་ཐ་དད་ཡིན་དགོས་ཏེ་ འཇུག་པ་ལས།",
    "དེ་ལྟར་དཔྱད་པ་བྱས་པའི་མཐར་ལས་དང་པོ་པ་རྣམས་ལ་ངའམ་བདག་ཕུང་པོའི་སྟེང་ན་དོན་སྟེང་ནས་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མི་འདུག་པས་ང་རིལ་པོ་མི་འདུག་སྙམ་པའི་སྐྲག་དངང་སྐྱེ་བ་ཞིག་དགོས་ཤིང་།",
    "དེའི་ཚེ་ངེས་ངོར་ང་རང་བཞིན་མེད་པར་ངེས་པའི་ངེས་ཤེས་དམ་སྦྲིང་ངེ་བ་དང་།",
    "དེ་ལྟར་བཟུང་བའི་ལུས་གཏན་ནས་མི་འདུག་སྙམ་དུ་ངེས་ཤེས་དྲངས་ན་སྔར་ལྟར་སྐྱོང་བར་བྱེད་དོ།",
    "དེ་ལྟ་བུའི་ལོ་དེ་གཏན་མི་འདུག་སྙམ་དུ་སྔར་ངེས་ཤེས་དྲངས་ནས་སྐྱོང་བར་བྱེད་དོ།",
    "སྦྱོར་བ་ལ་ཡང་རང་ལྟོས་གཞན་ལྟོས་ལམ་རིམ་ལེགས་གསུངས་ཉིང་།",
    "ལུས་ངག་སྦྱིན་ལ་འདུག་དུས་ཀྱི་སེམས་པ།",
    "འདི་ཙམ་བསྟོད་ན་རྒོད་པ་སྐྱེ་བར་འདུག།",
    "འདི་ཙམ་བཞག་ན་བྱིང་བ་སྐྱེ་བར་འདུག།",
    "ཤེས་བཞིན་མཐུ་ཆུང་བ་ཡི་སྐྱོན་འདུག་ན།",
    "མུན་པ་ལྟར་འདུག་དམིགས་རྟེན་འཛིན་མི་དགའ།",
    "གཉིས་ཀའང་རང་བཞིན་གྱིས་གྲུབ་འཛིན་སྟངས་ཅན།",
    "ང་རང་བཞིན་མེད་པར་གཏན་ལ་དབབ་པ་དང་ ང་ཡི་བ་རང་བཞིན་མེད་པར་གཏན་ལ་དབབ་པ་དང་།",
    "གཞན་ཡང་བདག་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་གཅིག་འཇིག་འདོད་ན།",
    "དེ་ལྟར་དཔྱད་ཚེ་བདག་ཕུང་རང་བཞིན་གྱིས།",
    "བདག་ལའང་རང་བཞིན་གཅིག་གམ་ཐ་དད་མེད།",
    "གང་ལ་བརྟེན་པ་དེ་དང་རང་བཞིན་གྱིས།",
    "འདིས་ཀྱང་རང་བཞིན་མེད་པར་བདེ་བླག་འགྲུབ།",
    "སྒྲུབ་སྒྲུབ་བསྙེན་གྱི་དབྱེ་བ་མི་འདུག་ཀྱང་གསང་སྔགས་སྤྱི་འགྲེ་ཐོག་མར་གཞིའི་བསྙེན་བྱ་ཚུལ་ནི།",
    "ཆུང་བ་ཡིན་ཡང་རང་རིགས་ཀྱི།",
    "བསླུ་བྲིད་མཁན་དེ་གང་དུ་འདུག་རི་དྭགས་ཀྱིས་སྨྲས་པ།",
    "དེ་ནས་མྱུར་འཕུར་གྱིས་ཐག་རིང་པོར་བལྟས་ཀྱང་འཇིགས་པའི་རྒྱུ་གང་ཡང་མི་འདུག་གོ།",
    "དལ་བུས་འགྲོ་ལ་སོགས་པ་ནི་རྒུད་པ་ཐམས་ཅད་ལས་གྲོལ་ཞིང་རང་གནས་སུ་ཕྱིན་ནས་ཇི་ལྟར་བདེ་བར་གནས་སོ།",
    "ད་དུང་སྦར་ཤ་བརྒྱབ་ཀྱིན་འདུག།",
    "ཝ་ངན་དེས་ང་ལ་མགོ་སྐོར་བཏང་འདུག།",
    "མིག་གཞན་གཉིས་གཉིད་ཁུག་དུས་ཀྱང་ཕྱེས་ཡོད་པ་མ་ཟད།",
    "སྔར་བཞིན་སྲོག་ཆགས་ཀུན་གྱིས་སྲིན་པོ་བསད་བཞག་འདུག་ཅེས་སྐད་སྙན་སྒྲོག་པ་ཐོས་པས་ཧ་ཅང་དགའ་སྟེ་བླུན་པོའི་བུ་ཁུར་ཏེ་ཁོ་གཉིས་བྲག་ཁུང་ཁར་སླེབས་ཚེ།",
