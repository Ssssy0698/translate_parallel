    "ལས་ཀ་གང་ཞིག་ཡིན་ཡང་རང་ཉིད་ཀྱིས་དེ་ལ་བརྩི་མཐོང་བྱེད་དགོས།",
    "ཡིད་ལའང་མ་ཤར་བའི་ཁོ་དོན་དག་ཅིག་ཡོད་པ་ནི་བཀོད་འདོམས་པས་ཁོ་རང་གཡོན་ཕྱོགས་སུ་འགྲོ་རུ་བཅུག་པས།",
    "ཁོ་ཚོས་མི་གཞན་ལ་མཉམ་འཇོག་མི་བྱེད་ལ་མི་གཞན་དང་རང་ཉིད་ཀྱི་བར་ཁྱད་ལའང་དོ་སྣང་སྤུ་ཙམ་ཡང་མི་བྱེད་པས་ཁོ་ཚོས་ཡར་རྒྱས་ཀྱི་ལམ་སྣེ་རྡོག་པས་གནོན་དཀའ།",
    "ཞེས་བྲིས་འདུག་པ་མཐོང་བྱུང་།",
    "ཡ་མཚར་བ་ཞིག་ལ་དེའི་རིན་གོང་ནི་སྒོར་༡༢བྲིས་འདུགདེ་ནས་མི་དེས་བྱ་འཚོང་མཁན་ལ་འདྲི་རྒྱུར་ནེ་ཙོ་འདིས་སྐད་རིགས་བརྒྱད་འཆད་ཤེས་པ་ཡིན་ནམ།",
    "མལ་ཐུལ་འཚོང་མཁན་གྱི་མི་དེས་ཡང་མལ་ཐུལ་ཞིག་གྱོན་དགོས་འདུག་ཅེས་ལྟོགས་ཞོར་དུ་ཡང་མལ་ཐུལ་གཅིག་གྱོན།",
    "ང་ལ་དེའི་ཐབས་ལམ་ཞིག་མི་འདུག་ཅེས་བཤད།",
    "ཁྱེར་འོང་ནས་མཱ་ཐི་ལ་ཐེངས་གཅིག་བསྟན་པས་ཁོ་རང་སྐད་ཆ་ཅི་ཡང་མེད་པར་ཧད་དེ་ལུས་པར་བྱས།",
    "དེ་ནི་རྗེས་ཕྱོགས་ཀྱི་འཚོ་བའི་ཁྲོད་དུ་རང་ཉིད་ལ་གཞན་གྱིས་རོགས་སྐྱོར་ཐོབ་པ་དང་རང་ཉིད་ཀྱི་མིག་རྒྱ་ཇེ་ཆེར་གཏོང་ཆེད་དེ་ཕྱོགས་ཡོངས་ནས་འཕེལ་རྒྱས་སུ་འགྲོ་བའི་ཆེད་དུ་ཡིན།",
    "ང་རང་ཕུལ་ཏུ་བྱུང་བའི་མི་སྣ་དང་འགྲོགས་ནས་རང་ཉིད་འཕེལ་རྒྱས་སུ་གཏོང་དགོས།",
    "དེ་ཚོས་རང་ཉིད་ཀྱིས་ངོ་ཤེས་པ་དང་རང་ཉིད་ངོ་ཤེས་མཁན་སོགས་ཅི་ཙམ་མང་ན་དེ་ཙམ་གྱིས་རང་ཉིད་ཀྱི་བྱ་བཞག་ལ་གོ་སྐབས་ལེགས་པོ་ཇེ་མང་ཡིན་པ་ངོས་ཟིན་གྱིན་ཡོད།",
    "འཁྲབ་ཁྲིད་པ་གྲགས་ཅན་དུ་མ་ནང་དུ་འདུ་བའི་མི་མང་པོས་ཁོ་རང་འཁྲབ་སྟོན་པ་གྲགས་ཅན་ཞིག་ཏུ་འགྱུར་འགྲོ་བ་ཡིད་ལའང་ཤར་མྱོང་མེད།",
    "ལམ་ཐག་ཅུང་རིང་དུ་ཕྱིན་རྗེས་ཁོ་རང་སུན་གྲགས་པས།",
    "ངས་བཟོད་ཐབས་མི་འདུག་ད་ནི་དངོས་གནས་ཉེན་ཞུ་བྱེད་དགོས་པ་འདྲ།",
    "ཞེས་བྲིས་འདུག་པ་ལས།",
    "ཐོམ་དུང་གཅིག་ཀྱང་བྲིས་མི་འདུགདེ་ལས་ལེགས་འགྲུབ་བྱུང་མཁན་གྱི་མིས་རང་ཉིད་ལ་བསྟེན་པ་དང་རང་སྟོབས་ནི་མི་ཚེའི་ཁྲོད་ཀྱི་ཆེས་གལ་ཆེ་བ་དེ་ཡིན་པ་རྟོགས་ཡོད་པ་ཤེས་ཐུབ།",
    "ཐོག་མར་རང་ཉིད་དང་རང་ཉིད་ཀྱི་ལེགས་ཆ་ལ་ཡིད་ཆེས་བྱེད་དགོས།",
    "འབག་བཟོའི་ལག་རྩལ་བསླབས་ཏེ་མཐར་ཁོ་རང་འབག་བཟོ་བ་གྲགས་ཅན་ཞིག་ཏུ་གྱུར།",
    "ང་རང་ཤུགས་དྲག་པོས་བབ་ཆགས་ཀྱི་འཚོ་བ་ལ་ཁ་ཕྱོགས་ཀྱིན་ཡོད་པར་མ་ཟད།",
    "ཁྲོམ་རའི་ཁོད་ཡངས་དང་སྣ་མང་རང་བཞིན་གྱིས་བློ་རིག་སྐྱེན་པོ་ཡོད་པའི་ཚོང་བདག་ཅིག་བཙིར་གནོན་གྱི་དཀའ་ངལ་ཁྲོད་སུན་སྣང་སྐྱེས་མི་དགོས་པར།",
    "འདུག་པའམ་ཉལ་བན་ཡང་རུང་སྟེ།",
    "དེ་ནི་འདི་ལྟར་སྡོང་པོ་ལས་མཚན་མ་འདི་ལྟ་བུ་དག་སྔར་གདའ་བའི་སླད་དུའོ།",
    "དེར་འགྲོའམ་འདུག་པ་དག།",
    "དེ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷའི་ནང་ན་འདུག་པ་ལས་འཛམ་བུའི་གླིང་འདིར་འགྲོའོ་སྙམ་དུ་སེམས་ཤིང་ཤཱ་རིའི་བུ་འདབ་ཆགས་བྱ་དེ་འདབ་མ་མ་སྐྱེས་པའམ་འདབ་མ་བྱེ་བར་གྱུར་པའམ་འདབ་མ་བཅད་པར་གྱུར་ལ།",
    "རབ་འབྱོར་འདི་ཇི་སྙམ་དུ་སེམས་ཅི་སྐྱེས་བུ་དེ་དེའི་གཞི་ལས་དགའ་བ་དང་མགུ་བ་དང་རངས་པ་དང་ཡིད་བདེ་བ་ཆེར་སྐྱེའམ།",
    "རབ་འབྱོར་འདི་ལྟ་སྟེ་དཔེར་ན་འདབ་ཆགས་བྱ་ནི་ནམ་མཁའ་བར་སྣང་ལ་རྒྱུ་ཡང་ས་ལ་མི་ལྟུང་ཞིང་གནས་ཅི་ལ་ཡང་མི་རྟེན་པར་འདུག་སྟེ་ནམ་མཁའ་བར་སྣང་ཉིད་ལ་གནས་ཀྱང་དེ་ལ་ཡང་མི་རྟེན་མི་གནས་སོ།",
    "ཀུན་དགའ་བོ་དེའི་ཚེ་བདུད་སྡིག་ཅན་དགའ་མགུ་ཡི་རངས་པར་འགྱུར་ཞིང་རབ་ཏུ་དགའ་བ་དང་རངས་པ་དང་ཡིད་བདེ་བ་སྐྱེ་སྟེ་ཀུན་ཏུ་ཚིམ་པ་སྐྱེ་ཞིང་སེམས་ཚིམ་པར་འགྱུར་ལ་རབ་ཏུ་དགའ་བ་སྐྱེ་བཅུ་གསུམ་བར་འགྱུར་རོ།",
    "ཞེ་སྡང་བསྐྱེད་ནས་སོ་སོར་བཤགས་པར་མི་བྱེད་ཕྱིས་སྡོམ་པ་མི་འཛིན་ཁོན་དུ་འཛིན་ཅིང་ཁོན་དུ་བཟུང་ནས་འདུག་ན།",
    "དེ་དགའ་བ་དང་རངས་པ་དེ་དང་ལྡན་པས་ཏ་ལ་བདུན་ཙམ་དུ་ནམ་མཁའ་ལ་འཕགས་ནས་ཏ་ལ་བདུན་ཙམ་ན་འདུག་སྟེ།",
    "དེ་ལྟར་བདག་ཉིད་ཆེན་པོ་དེ་ལུས་བཙོང་བའི་ཕྱིར་གྲོང་བར་དུ་འདུག་ནས།",
    "ཀྱེ་མ་བདག་ནི་སྐལ་བ་དམན་པ་ཞིག་གོ་སྙམ་དུ་གྱི་ནུ་པ་ན་གྱི་སྤྱི་སྤྱི་ཚ་། སེམས་ཤིང་མཆི་མ་བླགས་ནས་འདུག་གོ།",
    "བྲམ་ཟེའི་ཁྱེའུའི་ཆ་བྱད་དུ་སྤྲུལ་ནས་དེའི་མདུན་དུ་འདུག་སྟེ་འདི་ཉེར་དགུ་སྐད་ཅེས་སྨྲས་སོ།",
    "མིག་ཨུཏྤལ་སྔོན་པོ་ལྟ་བུ་སྐྲ་མཐོན་མཐིང་དུ་འདུག་ཅིང་ནུ་མ་རབ་ཏུ་རྒྱས་པ།",
    "དེ་ད་ལྟ་གང་ན་འདུག།",
    "ཕྱོགས་འདིར་རང་རང་མགུལ་པ་བྲེགས་པ་བཞིན།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "རྒྱུན་དུ་སྐྱིད་པོར་འདུག་པ་དང་ཁ་ཟས་སྐྱ་བ་ཟ་བ།",
    "སྤྱོད་ལམ་དལ་བར་འདུག་དང་སྐྱིད་པོར་འདུག་པ་སྤང་རྒྱུ།",
    "སྤྱོད་ལམ་དལ་བར་འདུག་དང་སྐྱིད་པོར་འདུག་པ་སྤང་རྒྱུ།",
    "རྩོལ་མེད་དལ་བར་འདུག་པ་སོགས་སྤང་བར་བྱ་དགོས་པ་ཡིན།",
    "རྩོལ་མེད་དལ་བར་འདུག་པ།",
