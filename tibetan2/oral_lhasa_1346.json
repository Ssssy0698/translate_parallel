    "སྤུ་གྲིའི་ལས་ལ་ག་རྒ་ག་ལ་སོགས་ཐུབ་པས་ངེས་པར་བཤད།",
    "ཞེས་པ་དག་ཀྱང་ཐུབ་པ་རྣམས་ཀྱིས་ལྔ་པར་འགྱུར་བ་ཉིད་དུ་སྒྲོགས་པར་བྱེད།",
    "རིགས་ལྡན་གསུམ་སྟེ་རྣམས་པར་སྤང་བར་བྱ།",
    "ཐམས་ཅད་ཉིད་ནི་བསྒྲུབ་པར་བྱ།",
    "དུས་རྣམས་རིམ་པས་གཟའ་རྣམས་ཀྱི་ནི་བདག་པོ་རྣམས་སུ་རྣམ་པར་བཤད།",
    "རྣམ་པར་བསྣུན་དང་དགའ་བ་ཞེས་བྱ་དང་།",
    "རྣམ་པར་བསྣུན་ལ་དགུ་དང་ཟུག་རྔུར་ལྔ།",
    "ཉི་མ་ཟླ་བ་ཕན་ཚུན་ལྟ་ལྟུང་སྒོ་གཏན་གཅིག་པར་ཨེ་ཀཱ་རྒལ།",
    "ལུས་ནི་རྣམ་པར་འགྱུར་བྱེད་ཁྲོ་ལྡན་དྲག་པོའི་མི།",
    "༣ བ་བ་ཞེས་པར་རྒྱས་ལས་བརྟན་དང་དགེ།",
    "༥ རྩ་རྒྱུད་གདོང་ལ་ལྔ་སྟེ་མགྲིན་པར་དེ་བཞིན་གཅིག།",
    "བྲང་ལ་བཅུ་གཅིག་སྐེད་པ་ལ་ནི་ངེས་པར་བཞི།",
    "བ་ལང་བྲམ་ཟེ་རྒྱལ་པོ་མཚུན་ལས་རྐང་བཞི་པར།",
    "ལྷ་མིན་བཅོམ་པས་དར་བའི་ལྷ་ནི་གང་ཚེ་བྱེད་པའི་རབ་མཐར་ངེས་པར་ལྡན་པའོ།",
    "འཇིག་རྟེན་རྣམས་ཀྱི་ཐ་སྙད་ལས་ནི་གཞན་ཡང་ཤེས་པར་བྱས་ནས་རབ་ཏུ་འབད་པ་ཡིས།",
    "ཡིད་འོང་ཞི་དང་བརྟན་པར་ཕན།",
    "སྒྲོན་དང་ཆུ་ལྷ་སྨིན་དྲུག་སྐར་རྣམས་སྲིན་པོའི་ཚོགས།",
    "མི་དང་ལྷ་ཡང་སྲིན་པོ་དང་བཅས་འཁོན་པར་བཤད།",
    "ཆང་སྦྱོར་བ་ལ་མཆོག་ཏུ་བསྔགས་པར་བཤད།",
    "རྣམ་པར་བསྒྲུབ་པ་ཐུབ་པ་རྣམས་ཀྱིས་ངེས་པར་བསྟན།",
    "འབྲས་ཡོས་དང་པོར་ཟ་བ་རྣམ་པར་བརྗོད།",
    "ས་སྐྱོང་རྣམས་ཀྱི་ལྔ་པར་བཤད།",
    "སྤུ་གྲིའི་ལས་བྱས་ཚངས་པའི་ལོ་དང་ལྡན་ན་ཡང་།",
    "སྐར་མའི་ཉིན་པར་འགོག་མེད་མར་སྤྱོད་ཅིང་།",
    "འོག་པགས་འཆིང་བ་འགྲོལ་བར་ངེས་པར་བཤད།",
    "རིག་པ་བརྩམས་པ་འགྲུབ་པར་གནས་པ་ཡིན།",
    "ངེས་པར་ནམ་ཡང་ཐོབ་པར་མི་འགྱུར་རོ།",
    "ལས་ཀུན་བསྒྲུབ་པར་མཁས་པ་རྣམས་ཀྱིས་བཤད།",
    "དང་པོར་གཤོལ་འདྲེན་པ་ནི་བསྒྲུབ་པར་བྱ།",
    "༤༤ ཕུར་སོགས་མགོ་བོར་གསུམ་དང་མགྲིན་པར་གསུམ་སྟེ་ལྟོ་བར་སྐར་མ་བཅུ་གཉིས་འགྱུར།",
    "མཇུག་མར་བཞི་སྟེ་དེ་ནས་ཕྱི་རོལ་སྐར་མ་ལྔ་ནི་རྣམ་པར་གནས་པ་སྟེ།",
    "མི་དེ་འཆི་བ་ཉིད་ནི་ཐོབ་པར་འགྱུར།",
    "དེ་ཡི་སྲོག་ནི་འབད་པས་སྐྱོབ་པར་འགྱུར།",
    "གར་བརྩམ་བྱ་ཞེས་སྔོན་གྱི་སློབ་དཔོན་གསུངས།",
    "རྣམ་པར་ལྟ་ལ་དགེ་སྦྱིན་སྐར་མའོ།",
    "མཛའ་བོ་ཕན་ཚུན་གཉིས་ཀ་ངེས་པར་སྦྱར།",
    "སླར་ཡང་ཐུབ་པས་ལྷག་མ་མཉམ་པར་གསུངས།",
    "ངེས་པར་འདིར་ནི་ཡང་ཡང་བརྩི་བར་བྱ།",
    "ཉེ་བར་རྙེད་འགྱུར་ཞར་བ་ལ་ནི་རྙེད་པར་བསྟན།",
    "བསྒྲུབ་པར་བྱ་བ་དེ་བཞིན་མ།",
    "༧ གཞན་གྱིས་བྱས་པའི་སྐྱོན་རྣམས་རྒྱལ་གྱིས་འཇོམས་པར་བྱེད།",
    "རྒྱལ་ལ་ལས་བྱས་པ་ནི་འགྲུབ་པར་འགྱུར།",
    "སྐར་མ་འགལ་དང་མི་མཐུན་པར་གྱུར་ཀྱང་།",
    "དོན་རྣམས་མཐའ་དག་ངེས་པར་འགྲུབ་པར་བྱེད།",
    "སོ་སྟེ་བློ་ལྡན་རྣམས་ཀྱིས་རིམ་པར་སྐར་མའི་གྲངས་སུ་བརྗོད།",
    "བྷཾ་གུའི་བུ་ཡི་ཉིན་པར་མཚུན་དང་ཚངས་པ་ཕུར་བུར་སྲིན་པོ་ཆུ་དག་དང་།",
    "ལྔ་གསུམ་གྲོངས་ནི་དབྱུག་པ་ཞེས་བྱ་བཅུ་དགུ་པ་ནི་འབར་བ་ཞེས་པར་རབ་ཏུ་གནས།",
    "ཉི་མར་རིམ་བཞིན་ཐ་སྐར་ནས་བགྲོད་འོད་དཀར་ཅན་དང་ཡང་དག་ལྡན་པར་གྱུར་པ་ན།",
    "བདག་ལ་ཕན་འདོད་ཕན་པའི་བྱ་བ་བློ་མ་སྙནས་ས་ག་  ཡས་རྒྱསསྔ་པ་བ་བ་ས་སམཉ་ནས་ལ་མཁའ་ལས་ཐབས་ས་གས་པ་ལ་མ་ལྡན་རྣམས་ཀྱིས་དེར་ནི་ངེས་པར་མི་བྱའོ།",
    "ཚེས་དེར་བརྩམས་ཀུན་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "སྦྱོར་དེ་ཐུབ་པ་རྣམས་ཀྱིས་འཇིག་པར་བཤད།",
    "བྲམ་ཟེའི་ཚོགས་ལ་དལ་མས་ཕན་ཞིང་འདྲེས་མ་ཞེས་བྱས་ཕྱུགས་རྣམས་དང་།",
    "ཉི་མ་བྱང་དང་ལྷོ་ཡི་ཕྱོགས་སུ་བགྲོད་པར་འགྱུར།",
    "འབྲས་བུ་དེ་ལྟར་མི་ཡིས་ཐོབ་པར་འགྱུར།",
    "གལ་ཏེ་གནོད་པར་མི་བྱེད་དེ་ཚེ་འགྲུབ།",
    "གལ་ཏེ་གཟའ་ལྷས་འབིགས་པར་མི་བྱེད་ནའོ།",
    "འབིགས་པར་མི་བྱེད་ཉི་མའི་བུས་ཀྱང་ངོ།",
    "དེ་བཞིན་འདིར་ནི་གཟའ་ཡི་གནོད་ལྡན་པར།",
    "༡༢ ནོར་སོན་པ་འམ་ཟད་པར་སོན།",
    "༡༣ གཟའ་ཡི་རྒྱལ་པོ་མི་མཉམ་མིན་པར་གནས་པ་ན།",
    "དུས་མིན་སྤྱོད་དང་རི་དྭགས་བཤོར་ལ་གྲོགས་བཅས་པར།",
    "མེ་བཞིར་གནས་ཚེ་ཕྱིར་ཟློག་བྱེད་པར་བཤད།",
    "ཁྲུས་ཀྱིས་ངན་སྤོང་བུས་བྱས་སྡུག་བསྔལ་ཀུན།",
    "འཇིག་པར་བྱེད་པ་འདིར་ནི་ཐེ་ཚོམ་མེད།",
    "སྤེན་པ་མི་མཉམ་པར་གནས་ཁྲུས་ཀྱིས་ནི།",
    "ལྡོང་རོས་དག་ནི་བཞག་བྱས་ནས།",
    "མི་དགེའི་གཟའ་འཇོམས་པ་ནི་ངེས་པར་འགྱུར།",
    "རིམ་པར་ཉི་སོགས་གཟའ་ཡི་དཀྱིལ་འཁོར་རྣམས་ཀྱི་སྦྱིན་སྲེག་ཡམ་ཤིང་དུ།",
    "གཡུལ་དུ་ས་ཡི་བུ་སྟེ་ངན་སྤོང་བུ་ནི་ཆས་པར་སྟོབས་དང་ལྡན།",
    "ལས་རྣམས་ཀུན་ལ་ཟླ་བ་སྟོབས་ལྡན་མཁས་པ་རྣམས་ཀྱིས་ངེས་པར་བརྗོད།",
    "༢ སྤྱོད་ཡུལ་ལ་ནི་དགུ་དང་གཉིས་པར་སོན།",
    "ལྷག་པས་འཕེལ་ཞིང་རྒྱས་པར་འདོད་པ་ཡིན།",
    "ཡིད་འོང་ནུས་པ་ལྡན་པར་ཡོད་པ་ལས།",
    "མིང་མཐུན་དེ་འབྲས་ངེས་པར་བསམ་བྱ་ཞེས།",
    "རྒྱས་པའི་ལས་ནི་བརྩམ་པར་བྱ།",
    "སྲང་ཤར་དུས་སུ་འགྲུབ་པར་འགྱུར།",
    "བུམ་པ་ཤར་ཚེ་བསྒྲུབ་པར་བྱ།",
    "ཞབས་འདྲེང་རྣམས་ཀྱིས་རྗེ་བོ་བསྟེན་པར་བྱ།",
    "རིག་པ་མཚོན་སྦྱོར་ལྷག་པ་བཅུ་པར་ས་ཡི་བུ།",
    "ངེས་པ་མེད་པར་མཁས་པ་བྱེད།",
    "རང་བཞིན་ཉིད་དུ་སྒྲུབ་པར་ལ་སྡིག་ཅན་གནས་ནའང་དྲག་པོ་ཉིད།",
    "ཡོད་ན་ཁྲོས་པའི་ལས་རྣམས་གྲུབ་པར་བྱེད།",
    "༢༥ དུས་སྦྱོར་ཆས་དང་བུ་ཡི་ཁྱིམ་ལྡན་པར།",
    "དགའ་མ་ལ་ནི་རབ་དགའ་བརྩམ་པར་བྱ།",
    "བརྒྱད་པ་བརྟན་པར་གཟའ་རྣམས་མི་གནས་ཤིང་།",
    "བཞི་པར་གནས་ཚེ་རོ་བཅུད་ཡང་དག་སྡུད་བྱེད་པས།",
    "བསྟེན་པ་ལ་སོགས་ལས་རྣམས་འགྲུབ་པར་རབ་ཏུ་བཤད།",
    "བཟོ་ཡི་རིག་པ་བརྩམ་པར་བསྔགས།",
    "མཁས་པས་ཟློས་གར་བརྩམ་པར་འདོད།",
    "གཟའ་མཆོག་རྣམས་ནི་ངེས་པར་སྟོབས་ལྡན་དུས།",
    "ཚེ་ལ་ལེགས་པར་ཕན་བྱེད་སྦྱོར་བ་སྟེ།",
    "སློབ་དཔོན་རྣམས་ཀྱིས་ཆང་སྦྱོར་གྲུབ་པར་བསྟན།",
    "ས་འོག་རོ་ལངས་འགྲུབ་པར་འགྱུར།",
    "ཨུ་པ་ཙ་ཤར་ལགས་མཐོང་ཚེ།",
    "རང་བཞིན་རང་བཞིན་ཡུལ་རྣམས་སུ་ནི་ཆགས་པར་བྱེད་པ་གང་།",
    "ལྷག་མའི་གནས་སུམ་དེ་བཞིན་བརྟག་པར་བྱ།",
    "ཟླ་བ་དྲུག་གམ་ཡང་ན་བརྒྱད་པར་དེ་བདག་ནུས་པ་སྒྲུབ་པའི་ཆོ་ག་ལ།",
    "བྱིས་པ་སྐྱེས་པའི་ལས་ནི་ངེས་པར་བརྗོད།",
    "ཕུར་བུ་པ་སངས་བཞི་པར་གནས་པ་ན།",
    "ཟླ་བ་དྲུག་པར་ཆུང་མའི་ཟས་ཟ་ཏེ།",
    "ལྷག་པར་ཤེས་ལྡན་པ་སངས་ལོངས་སྤྱོད་ཕུར་བུར་ཚེ་རིང་ངོ།",
    "༢ ཚེར་ཅན་མཐའ་ན་ལགས་༣༡༧དང་ཕྱི་མ་ཟུར་གསུམ་སོན།",
    "གང་དེ་དགུ་པར་དེ་འབྲས་སྦྱིན་བྱེད་དེ།",
    "དྲུག་པར་ཟླ་བ་དགེ་མིན་བརྒྱད་པར་ནི།",
    "སྤུ་གྲིའི་སྐར་མར་རང་རིག་ཆོ་གས་གཙུག་ཕུད་འདྲེག་པར་ཐུབ་པས་བཤད།",
    "ཉི་མ་བོར་བའི་ཕུར་སངས་ལྷག་པར་བྱ་སྟེ་ཉི་མར་རིམས་ཀྱིས་འདེབས།",
    "འོད་དཀར་ཅན་ལ་ལུས་ཟད་པ་དང་ངེས་པར་འཇོམས་པ་ཉིད་ཅེས་བྱ།",
    "འཕྲོག་བྱེད་ནམ་གྱུར་རྣ་བ་འབིགས་པར་བྱ།",
    "རིག་བྱེད་ཆོ་ག་དྲན་པའི་ལས་རྣམས་དམན་པར་འགྱུར་བ་ཡིན།",
    "རིག་པས་བདེ་བའི་དོན་ལྡན་པ་སངས་ཟླ་བུ་བསམ་གཏན་བྱེད་པར་རབ་ཏུ་གནས།",
    "ཁྲོ་བ་ཉིད་འགྱུར་ས་སྐྱེས་ཆ་ལ་སྡིག་ཅན་ངན་པར་འགྱུར།",
    "བྲམ་ཟེའི་གང་ཟག་མེ་ནི་འདས་པར་འགྱུར།",
    "འབར་ཞིང་སྣང་བའི་མེ་དང་འགྲོགས་པར་འགྱུར།",
    "ཡང་ན་དམའ་བའི་ཁྱིམ་སོན་ཕམ་པར་འགྱུར།",
    "མཁས་པ་རྣམས་ཀྱིས་བཞད་གད་བྱེད་པར་འགྱུར།",
    "བཅུ་པར་ས་ཡི་བུ་འམ་ཡང་ན་བདུན་པ་ལ།",
    "བྲམ་ཟེ་མེ་སྐྱེས་པ་ནི་ངེས་པར་ཐོབ་པར་འགྱུར།",
    "དགྲ་སྐར་ནུབ་པར་གྱུར་ཅིང་རྣ་བར་སོན།",
    "༢ ཨུ་པ་ཙ་དང་བརྟན་པར་སྐྱེས་སྐར་དང་།",
    "ལེགས་མིན་ཚེར་མ་སྤངས་པར་གྱུར་ན་དགེ།",
    "འཆིར་གནས་ཚེ་ཐུང་གསུམ་དང་འགྲོ་བ་དགྲར་གནས་བདེ་བ་ནོར་དང་ལྡན་པར་བྱེད།",
    "བགྲོད་པ་བརྟག་མི་དགོས་པར་སྐྱེ་བ་ལ།",
    "རིགས་དང་མཚུངས་པའི་རྙེད་པ་ཐོབ་པར་བཤད།",
    "དེ་ཚེ་འགྲོ་བྱེད་དགྲ་ནི་ཟད་པར་འགྱུར།",
    "བོར་བར་དེ་ཚེ་འགྲོན་པོ་རྣམ་པར་རྒྱལ།",
    "དགྲ་ཡི་སྐྱེ་བོས་ཟིལ་མནན་ལྡོག་པར་འགྱུར།",
    "ཕྱོགས་བཞི་རྣམས་ཀྱི་སྐར་མ་ཡིན་པར་འདིར་འདོད་དེ།",
    "མི་འདོད་པ་ཞེས་སྨད་པ་མིན་པར་བཤད།",
    "ཉིན་མཚན་ཐེ་ཚོམ་མེད་པར་འགྲོ་བར་བྱ།",
    "རྙེད་མིན་ཡང་ཡང་ངེས་པར་བསྒྲུབ་པར་བྱ།",
    "མཐུན་པར།",
    "པ་སངས་རྙོག་ཅིང་ནུབ་པར་གྱུར་པའི་ཚེ།",
    "འཐག་པར་བྱེད་ཕྱིར་ཆས་པ་ཡིན་ན་ཡང་།",
    "མཐུན་པར་འགྱུར་ཞེས་བློ་ལྡན་རྣམས་ཀྱིས་བཤད།",
    "གཟའ་གཞན་རྣམས་ཀྱིས་སྐྱོབ་པར་ནུས་མ་ཡིན།",
    "དགྲ་ཡི་གནས་སུ་ངེས་པར་འགྲོ་བར་བྱ།",
    "འགྲོ་བར་བྱེད་ན་དུག་ཟོས་པ་དང་ངེས་པར་མཚུངས་པ་ཉིད།",
    "༢༥ལུས་མཛོད་གཞུ་ཅན་འཇུག་པར་བྱེད་པ་ནི།",
    "དུས་སྦྱོར་ལས་ནི་བཅུ་གཉིས་བརྟག་པར་བྱ།",
    "བཅུ་པར་སྤེན་པ་སྤངས་ནས་འགྲོ་བ་གང་།",
    "ངན་སྤོང་བུ་ནི་ནུབ་པ་སྤང་བྱས་ཏེ།",
    "མཁའ་རྒྱུ་རྣམས་ཀྱིས་ངེས་པར་སྦྱིན་ནུས་འགྱུར།",
    "ལྷག་མའི་སྐྱེ་བོ་ཡུད་ཙམ་གྱིས་ནི་ནུས་པར་ལྡན།",
    "ངེས་པར་ཐ་མའི་དུས་ཐོང་འགྱུར།",
    "༣༦དུས་སྦྱོར་ཉི་མ་བདུན་པར་བླ།",
    "འཕྲལ་དུ་དགའ་བ་འཇོམས་པར་བྱེད།",
    "ལྟ་དུས་སྦྱོར་ཕུར་བུ་དྲུག་པར་ཉི།",
    "རྣམ་མང་ཉམས་པར་བྱེད་པ་ཡིན།",
    "༤༡ས་སྐྱོང་སྦྱོར་བ་གང་ཞིག་སྐྱེས་པར་བཤད།",
    "དགྲ་ལས་རྣམ་རྒྱལ་ས་གཞི་འཛིན་པར་བྱེད།",
    "སྦྱོར་དང་ལྷག་སྦྱོར་ཀུན་གྱིས་ངེས་པར་རོ།",
    "༤༤དགྲ་ཡི་ཡུལ་ལས་རྣམ་པར་རྒྱལ་འདོད་གང་།",
    "ཡིད་ནི་རྣམ་པར་དག་འདོད་དེ།",
    "མེ་ལ་བསྲེགས་ཤིང་ལྷ་ལ་ཕྱག་བྱས་ནས།",
    "རྒྱལ་བའི་དོན་དུ་རྣམ་རྒྱལ་བསྐྱོད་པར་བྱ།",
    "བཟང་པོ་མང་པོ་རབ་ཏུ་སྦྱར་བྱས་ཏེ།",
    "༥༥མི་འོས་པ་འདིར་ངེས་པར་གསལ་བར་སྟེ།",
    "འགྲོ་བའི་དོན་ནི་རྫོགས་པར་ཐོས་འདོད་པས།",
    "འབྲས་བུ་ངེས་པར་གྲུབ་ཅེས་རབ་ཏུ་བསྟན།",
    "ཉི་མ་བདུན་པར་ངེས་པར་ངོ་མཚར་དང་།",
    "གཡོན་པ་རྣམས་ལ་འགྲོ་བ་ངེས་པར་དགེ།",
    "མཐོང་ན་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "མ་རྫོགས་པར་ནི་འགྲོ་མི་བྱ།",
    "དམག་དཔུང་ཡིད་ནི་རབ་དགའ་ཤིས་པའི་དུས་སུ་རང་ཁྱིམ་འཇུག་པར་བྱ།",
    "པ་སངས་ཕུར་བུ་ནུབ་པར་གྱུར་པ་ལ་ཡང་མིན།",
    "དཀར་ཕྱོགས་ཉི་མ་སྔོན་མ་གསུམ་ལ་བྱིས་པ་ལྷག་པར་འགྱུར།",
    "ཁྱབ་འཇུག་བློ་ལྡན་རྩ་ནི་བཞི་པར་འགྱུར།",
    "དེར་གནས་སྐར་མ་སྣར་མའང་འབིགས་པར་བྱེད།",
    "སྐར་མ་གཟའ་ཡིས་ངེས་པར་འབིགས་ཤེས་བྱ།",
    "ཕྱི་ནས་བདུན་པར་ཟླ་བའི་བུ་དང་དགུ་ལ་རཱ་ཧུ་དཀར་པོ་ལྔ་པ་སྟེ།",
    "༡༢དྲུག་དང་བརྒྱད་པར་བུ་ནི་ཉམས་ཤིང་འཆི།",
    "དགུ་དང་ལྔ་པར་ལག་པ་འཛིན་བྱེད་ན།",
    "ངེས་པར་འཇིག་རྟེན་སྒྲུབ་པར་རབ་ཏུ་གྲགས།",
    "གཉེན་གྱིས་མཆོད་ཅིང་བུ་ལྡན་སྡང་བའི་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ།",
    "དོན་གྲུབ་འབྱོར་པ་ལྡན་ཞིང་ནོར་ལྡན་ལུས་ལ་སོགས་པར་རིམ་པ་བཞིན།",
    "ཤིས་བརྗོད་ཉན་གྱི་མདུན་ན་འདོན་གང་ངེས་པར་གནས་པའི་འབྲས་བུའོ།",
    "མཆོད་མིན་འབུམ་ཕྲག་ངེས་པར་ཞི་བར་བྱེད།",
    "ཟླ་བ་ཕུར་བུ་ཉི་མ་བྲལ་བས་ཕན་པར་འགྱུར་མ་ཡིན།",
    "གཞུ་ལ་ལྷག་པར་ལ་ལར་མེད་བྱེད་བརྗོད།",
    "ལཱ་ཌ་པྲ་ཡའི་གནས་ནི་ནུས་པར་བརྟེན།",
    "ཁྱིམ་དང་ཁྱིམ་དུ་གནས་པར་རྣམ་པར་བརྗོད།",
    "ནོར་གྱིས་བགོས་པས་ཟད་པ་ཤེས་པར་འགྱུར།",
    "གསུམ་གྱིས་བགོས་པས་རིམ་པར་ཆ་ཤས་ནི།",
