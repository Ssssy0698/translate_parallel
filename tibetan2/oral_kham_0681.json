    "སྡུག་བསྔལ་གྱི་རང་བཞིན་ཤེས་ཙ་ན།",
    "ན་ཚ་ཡི་རང་བཞིན་ཤེས་ཙ་ན།",
    "འཆི་བ་ཡི་རང་བཞིན་ཤེས་ཙ་ན།",
    "སྐྱོན་ཡོན་གྱི་མཚང་འདི་རིག་ཙ་ན།",
    "སྤྱན་མིག་ཚུམ་ཚུམ་འདུག་ཚད་ལ་བྱང་སེམས་ཟེར་བ་མིན།",
    "སྨ་ར་ཕུད་ཕུད་འདུག་ཚད་ལ་སྔགས་པ་ཟེར་བ་མིན།",
    "གཉུག་མ་རྒྱུན་ཆད་མི་འདུག་ན་རྟོགས་ལྡན་ཟེར་བ་ཡིན།",
    "སྡིག་ཟས་འདུག་ཚད་སྟེར་བ་ལ་ཡོན་བདག་ཟེར་བ་མིན།",
    "རྣམ་རྟོག་ངོ་བོ་སྐྱེ་མེད་དུ་འདུག་པ་འདི་དགའོ།",
    "ཚོགས་འཁོར་གཅིག་འདུག་པའི་གྲལ་དུ།",
    "བདག་ལས་གཞན་སྐྱེས་ཕངས་ཤིང་རང་ལས་གཞན།",
    "ཤུགས་འབྱུང་རང་ཉམས་ཀྱི་དབྱངས་རྟ།",
    "ང་རང་མགོ་ཐོན་ཙམ་མ་གཏོགས་པ།",
    "མི་མང་པོའི་ཁྲོད་དུ་འདུག་པའི་ཚེ།",
    "དྲན་པའི་རྭ་བར་བཅུག་ཙ་ན།",
    "འདུག་ཀྱང་མཁོས་དཀའ་ནུས་མ་ཐོན།",
    "འདིར་སྣང་སྒྲུབ་ནས་མགུ་འདུག་ཀྱང་།",
    "རང་རང་ཚེ་ཡང་ཅི་ཙམ་མི་ཤེས་པས།",
    "དེ་ནས་ལོངས་སྤྱོད་འབྱོར་པས་ཕྱུག་དུས་འདིར།",
    "དུ་མའི་མིང་འདུག་དུ་མའི་དཔེ་ཡང་ཡོད།",
    "འདུས་པའི་ཐ་མ་སོ་སོར་འབྲལ་ཙ་ན།",
    "བརྩེགས་པའི་མཐའ་མ་ཞིག་རལ་བྱུང་ཙ་ན།",
    "ང་ནི་མི་རྟག་འཆི་བ་ཡོང་འདུག་པས།",
    "རང་རིག་དྲན་པས་སྐྱོང་ཞིང་རང་ངོ་གཟུང་།",
    "སྡོད་པ་འདི་ལ་ཆོག་ཤེས་མི་འདུག་པས།"
  ]
