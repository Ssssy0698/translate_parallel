    "གྲུ་བཞི་དང་སྒོ་བཞི་དང་རྟ་བབས་བཞི་དང་ཡང་དག་པར་ལྡན་པ་དང་།",
    "གསལ་བྱེད་དེ་རྣམས་དང་དབྱངས་ཡིག་རྣམས་དཀར་པོ་མགོ་གྱེན་དུ་འགྲེང་བ་རྣམས་ཀྱིས་སྔོན་བཞིན་དུ་བཀུག་ལ་དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུ་རྣམས་རྣམ་པར་བསྒོམས་ཏེ།",
    "དེའི་སྟེང་དུ་ཧཱུྃ་ཡིག་རྣམས་དཀར་པོ་ཡོངས་སུ་གྱུར་པ་ལས་རྡོ་རྗེ་དམར་པོ་རྩེ་ལྔ་པའི་ལྟེ་བའི་དབུས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་ཧཱུྃ་ཡིག་རྣམ་པར་བསྒོམས་ལ།",
    "དེའི་བརྗོད་པར་བྱ་བ་དང་།",
    "རྗོད་པར་བྱེད་པ་སྟོང་པ་ཉིད་དུ་སོ་སོར་རྟོག་པ་ནི་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་སོ།",
    "དེ་ལས་སྤྲོས་པའི་རྡོ་རྗེ་སེམས་དཔའི་ཚོགས་རྣམས་ཀྱིས་འགྲོ་བ་ཐམས་ཅད་རྡོ་རྗེ་འཛིན་པར་བྱས་ནས་སླར་དེ་ཉིད་དུ་རབ་ཏུ་ཞུགས་ལ།",
    "དེ་ནས་གཙོ་བོ་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་སྔ་མ་བཞིན་དུ་བཀུག་སྟེ།",
    "སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་དང་།",
    "ལཱཾ་མཱཾ་པཱཾ་ཏཱཾ་ཞེས་བྱས་པས་སྤྱན་མ་དང་།",
    "བྷྲཱུཾ་ཨཱཾ་ཛྲཱྀཾ་ཁཾ་ཧཱུྃ་ཞེས་བྱ་བ་འདིས་རྣམ་པར་སྣང་མཛད་དང་།",
    "ཞལ་དུ་ཞུགས་ནས་ཞུ་བར་གྱུར་པ་རྡོ་རྗེའི་ལམ་ན་པདྨར་བཅས་པར་བལྟས་ལ་འོད་ཀྱི་གོང་བུ་དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཧོ་ཡིག་དམར་པོ་གཉིས་ཀྱི་བར་དུ་དེ་ཁོ་ན་ཉིད་གསུམ་བལྟ་བར་བྱའོ།",
    "ཤེས་རབ་གཉིས་ཀྱང་གདན་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་འོད་དཔག་ཏུ་མེད་པར་གསལ་ཏེ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "རབ་དགའི་སྤྱོད་པ་ཀུན་ཏུ་བཟང་པོས་བདག་ལ་དགྱེས་པར་མཛོད།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "ཡོན་ཏན་རིན་ཆེན་མང་པོའི་གཏེར་གྱུར་བདག་ལ་དགྱེས་པར་མཛོད།",
    "རིགས་དཔག་ཏུ་མེད་པ་སྤྲོས་པས་འགྲོ་བའི་དོན་བྱེད་པར་རྩོམ་པ་རལ་གྲི་ནག་པོ་དང་།",
    "དཔྲལ་བའི་དབུས་སུ་ཟླ་བ་ལ་ཥྐཾ་ཡིག་ལྗང་གུ་དང་རལ་གྲི་ནག་པོ་ཡོངས་སུ་གྱུར་པ་ལས་དོན་ཡོད་གྲུབ་པ་བཞིན་དུ་སྒྲིབ་པ་རྣམ་པར་སེལ་བའོ།",
    "ཧཱུྃ་ཡིག་ནག་པོ་དང་པི་ཝང་ཡོངས་སུ་གྱུར་པ་ལས་སྒྲ་རྣམ་པར་དག་པ་མི་བསྐྱོད་པའི་རང་བཞིན་སྒྲ་རྡོ་རྗེ་མ་པི་ཝང་འཛིན་པའོ།",
    "བཾ་ཡིག་སེར་པོ་དང་དྲི་ཆུས་བཀང་བའི་དུང་ཕོར་ཡོངས་སུ་གྱུར་པ་ལས་དྲི་རྣམ་པར་དག་པ་རིན་ཆེན་འབྱུང་ལྡན་གྱི་རང་བཞིན་དྲི་རྡོ་རྗེ་མ་དྲི་ཆུས་བཀང་བའི་དུང་ཕོར་འཛིན་པའོ།",
    "ཧོ་ཡིག་དམར་པོ་དང་རོའི་སྣོད་ཡོངས་སུ་གྱུར་པ་ལས་རོ་རྣམ་པར་དག་པ་སྣང་བ་མཐའ་ཡས་ཀྱི་རང་བཞིན་རོ་རྡོ་རྗེ་མ་རོས་བཀང་བའི་སྣོད་དཀར་པོ་འཛིན་པའོ།",
    "དེ་བཞིན་དུ་ལཾ་ཡིག་དཀར་པོ་དང་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་ཡོངས་སུ་གྱུར་པ་ལས་སའི་ཁམས་རྣམ་པར་སྣང་མཛད་ཀྱི་རང་བཞིན་སྤྱན་མ་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་འཛིན་པའོ།",
    "མཾ་ཡིག་ནག་པོ་དང་ཨུཏྤལ་དམར་པོ་ཡོངས་སུ་གྱུར་པ་ལས་ཆུའི་ཁམས་རྣམ་པར་དག་པ་མི་བསྐྱོད་པའི་རང་བཞིན་མཱ་མ་ཀཱི་ཨུཏྤལ་དམར་པོ་འཛིན་པའོ།",
    "དེ་བཞིན་དུ་བྷྲཱུཾ་ཡིག་དཀར་པོ་དང་འཁོར་ལོ་ཡོངས་སུ་གྱུར་པ་ལས་གཟུགས་ཀྱི་ཕུང་པོ་རྣམ་པར་དག་པ་རྣམ་པར་སྣང་མཛད་འཁོར་ལོ་དཀར་པོ་རྩིབས་བརྒྱད་པ་འཛིན་པའོ།",
    "ཛྲཱྀཾ་ཡིག་དམར་པོ་དང་པདྨ་ཡོངས་སུ་གྱུར་པ་ལས་འདུ་ཤེས་ཀྱི་ཕུང་པོ་རྣམ་པར་དག་པ་འོད་དཔག་ཏུ་མེད་པ་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་འཛིན་པའོ།",
    "ཁཾ་ཡིག་ལྗང་གུ་དང་རལ་གྲི་ཡོངས་སུ་གྱུར་པ་ལས་འདུ་བྱེད་ཀྱི་ཕུང་པོ་རྣམ་པར་དག་པ་དོན་ཡོད་གྲུབ་པ་རལ་གྲི་ནག་པོ་འཛིན་པའོ།",
    "ཧཱུྃ་ཡིག་ནག་པོ་དང་རྡོ་རྗེ་ཡོངས་སུ་གྱུར་པ་ལས་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་རྣམ་པར་དག་པ་མི་བསྐྱོད་པ་རྡོ་རྗེ་ནག་པོ་འཛིན་པའོ།",
    "ཆུང་ངུའི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་དང་།",
    "གདོད་མ་ནས་གྲུབ་པའི་ཐུགས་རྡོ་རྗེ་རྣམས་ཀྱང་མདུན་དུ་སྤྱན་དྲངས་ལ་གནས་པར་བལྟས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་བཞུགས་པའི་དེ་མ་ཐག་ཏུ།",
    "དེ་ནས་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ཕྱག་མཚན་གྱི་ས་བོན་ལས་འོད་ཟེར་རྣམ་པར་སྤྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཡང་དག་པར་བསྐུལ་ཏེ།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་ནུ་མ་གཉིས་ཀྱི་སྟེང་ནས་ནུ་མ་གཉིས་ཀྱི་བར་མཐར་ཐུག་པར་མི་བསྐྱོད་པའི་རྡུལ་ཕྲ་རབ་ཀྱི་རང་བཞིན་བལྟ་བར་བྱའོ།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་པདྨའི་སྟེང་ནས་ལྟེ་བའི་མཐར་ཐུག་པར་རིན་ཆེན་འབྱུང་ལྡན་གྱི་རྡུལ་ཕྲ་རབ་ཀྱི་རང་བཞིན་དུ་བལྟ་བར་བྱའོ།",
