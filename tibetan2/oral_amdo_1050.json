    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཀུཎྞ་ལི་ཧ་ན་ཧ་ན་ཧཱུཾ་ཕགས།",
    "ལས་རུང་གི་བསྙེན་པ་སྔོན་དུ་བཏང་ནས།",
    "དེ་ནས་སྔགས་དཀྱིལ་ཨ་མྲྀ་ཏས་བསངས།",
    "པདྨ་དང་ཨུཏྤལ་ལ་སོགས་པའི་མེ་ཏོག་གིས་བརྒྱན་པ།",
    "སྤུར་ལོང་གི་ཟེའུ་འབྲུ་དང་ལྡན་པ།",
    "དཔག་ཚད་དུ་མའི་ཁྱོན་ཅན་རི་རབ་ཀྱི་དབུས་བརྡོལ་ནས་བྱུང་ཞིང་།",
    "སྟེང་དུ་བླ་རེ་ཡང་སྐད་ཅིག་གིས་བྱུང་བར་གྱུར།",
    "དེའི་སྟེང་ན་གནས་པའི་གསེར་གྱི་སྐ་རགས་བཞིའི་ཕྱི་ངོས་སུ་ཆུ་སྲིན་གྱི་ཁ་ནས་མུ་ཏིག་གི་དོ་ཤལ་དང་དོ་ཤལ་ཕྱེད་པ་འཕྱང་བ།",
    "ཕྱིའི་སྟེང་གི་ཟུར་བཞི་ལ་གདུགས་བཞིས་བརྒྱན་པ།",
    "གཞལ་ཡས་ཁང་གི་ནང་གི་སྟེང་དང་འོག་གི་ས་གཞི་ཐམས་ཅད་ཤར་སྔོ།",
    "དེའི་དབུས་སུ་པདྨ་འདབ་མ་རིམ་པ་གསུམ་དང་ལྡན་པའི་དབུས་ཀྱི་ལྟེ་བ་དང་འདབ་མ་བརྒྱད་ལ་སེང་ཁྲིའི་སྟེང་དུ་སྣ་ཚོགས་པདྨ་མ་དང་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེ།",
    "དེའི་ཕྱི་རིམ་གྱི་པད་འདབ་ཉེར་གཉིས་ཀྱི་གཡས་གྲལ་རྣམས་ལ་བྲག་རིའི་གདན་དང་གཡོན་གྲལ་བཅུ་གཉིས་ལ་ཟ་འོག་གི་གདན།",
    "སྒོ་བཞིར་སྣ་ཚོགས་པདྨ་དང་ཉི་མའི་གདན་རེ་རེ།",
    "གཡོན་མཉམ་གཞག་གི་ཕྱག་རྒྱའི་སྟེང་ན་བདུད་རྩིས་གང་བའི་ལྷུང་བཟེད་བསྣམས་པ།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་རབ་ཏུ་འབར་བའི་དབུས་ན་ཞབས་རྡོ་རྗེ་དཀྱིལ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "བྱམས་པ་སེར་པོ་གཡས་ཀླུ་ཤིང་གི་མེ་ཏོག་སྡོང་པོ་དང་བཅས་པ་རིལ་བ་སྤྱི་བླུགས་ཀྱིས་མཚན་པ།",
    "བྱང་གི་པད་འདབ་བཞི་ལ་རིམ་པ་བཞིན་དུ་བསམ་པ་ལེགས་པར་སེམས་པ་དཀར་པོ་གཡས་བདུད་རྩིའི་བུམ་པ།",
    "འཇམ་དཔལ་མ་གཏོགས་པའི་ལྔ་པོ་རྣམས་གཡས་པས་རང་རང་གི་ཕྱག་མཚན་ཐུགས་ཀར་འཛིན་ཅིང་།",
    "འོད་ཀྱི་ཕུང་པོའི་དབུས་ན་ཞབས་སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "སའི་ལྷ་མོ་སེར་མོ་ཕག་ལ་ཞོན་པ་གཡས་བུམ་པ་ཐུགས་ཀར་འཛིན་པ།",
    "སྨྲ་འཛིན་དམར་སྐྱ་གཡས་སྟ་རེ།",
    "རེ་རེ་ལ་ཡང་འཁོར་གནོད་སྦྱིན་བདུན་འབུམ་བདུན་འབུམ་གྱིས་བསྐོར་བའོ།",
    "ཤར་ནུབ་ཀྱི་ཚངས་ཐིག་གི་སྟེང་དུ་པད་འདབ་རེ་རེ་དང་ལྷོ་བྱང་གི་ཚངས་ཐིག་གིས་བཅད་པའི་མཚམས་ལ་པད་འདབ་ལྔ་རེ་ཡོད་པས།",
    "རང་རང་གི་སྲས་དང་བཙུན་མོ་གཡོག་འཁོར་དང་བཅས་པའོ།",
    "ཧཱུཾ་གིས་མཚན་པར་གྱུར།",
    "འོག་ཏུ་གཏོར་མ་འབུལ་བའི་ཆེད་དུ་ཡིན་ཡང་ཆོ་ག་སོ་སོ་བ་ཡིན་པས་འདིར་བྲིས་པ་ལྟར་བྱས་ན་འགྲེལ་པའི་དགོངས་པ་དང་མཐུན་ཅིང་ངོས་གཙང་ངམ་སྙམ་མོ།",
    "ཨཉྙཾ་གནས་སུ་པཱཧཱུཾ་སོགས་སྦྱར་ཏེ་ཆུ་གཉིས་ཉེར་སྤྱོད་རོལ་མོ་དང་བཅས་པ་འབུལ།",
    "མོས་བློས་དཀྱིལ་འཁོར་ལྷ་ལ་བདག་འབུལ་གྱི།",
    "གསེར་གྱི་འཁོར་ལོ་ནོར་བུ་བཙུན་མོ་དང་།",
    "གདུགས་དང་རྒྱལ་མཚན་བ་དན་བླ་རེ་དང་།",
    "ཕྱི་དང་ནང་གི་བར་ཆད་བཟློག།",
    "ཉེ་རེག་བྱས་ཏེ་ལས་སྔགས་བཟླས་བཞིན་ནང་དུ་འོངས་ནས།",
    "རང་ཉིད་སྐད་ཅིག་གིས་ཧཱུཾ་མཛད་སྔོན་པོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་འཆིང་ཞིང་གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "རྡོ་རྗེ་ཤུགས་ཀྱི་འཇུག་པས་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཐོགས་པ་མེད་པར་ཞུགས་པར་གྱུར་པར་མོས་ལ།",
    "སྒེག་པའི་ཕྱག་གིས་བཅོམ་ལྡན་འདས་ལ་འཁྲིལ།",
    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་ནུདྷ་ར་བོ་དྷི་ཨ་ལཾ་ཀཱ་ར་ཝཔྟ་པཱུ་ཛ་མེ་གྷ་ས་མུ་ཏྲ་སྥ་ར་ཎ་ས་མ་ཡེ་ཧཱུཾ་གིས་སྨད་གཡོགས་དང་།",
    "ཨོཾ་བཛྲ་རཀྵ་ཧཾ་གིས་སྟོད་གཡོགས་དང་།",
    "ཨོཾ་ཙཀྵུ་བནྡྷ་ཝཱ་ར་མ་ན་ཡེ་ཧཱུཾ་གིས་མིག་དར་རྣམས་བཅིངས།",
    "ཀྱེ་ཁྱོད་སུ་ཡིན་ཅི་ལ་དགའ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རློབ་པར་གྱུར་གྱི།",
    "ཁྱོད་ཀྱི་ཀྱང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གསང་བའི་དཀྱིལ་འཁོར་འདི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པ་རྣམས་ལ་སྨྲ་བར་མི་བྱ་ཞིང་།",
    "ཞེས་བརྗོད་པས་དངོས་སུ་དཀྱིལ་འཁོར་གྱི་ཡོལ་བ་བསལ་ཅིང་བསྒོམ་དོན་ལ་དཀྱིལ་འཁོར་གྱི་སྒོ་བཞི་རང་ཤག་གི་ཕྱེ།",
    "ཨཱ་ཁཾ་བཱི་ར་ཧཱུཾ་གིས་དཀྱིལ་འཁོར་གྱི་ནང་དུ་འཁྲིད་པར་བསམ།",
    "ཨོཾ་ན་མོ་ན་མ་ཧཱུྃ་སྭཱཧཱ།",
    "རིགས་ནི་གང་གི་སྣོད་དུ་འགྱུར།",
    "དེ་འདྲ་དཀྱིལ་འཁོར་དུ་གྱུར་ཅིག་ཅེས་ལན་གསུམ་གྱིས་བདེན་པའི་སྟོབས་བརྗོད་པ་སྟེ་གདོང་གཡོགས་དང་བཅས་འཇུག་པའི་སྐོར་ཕལ་ཆེར་སོང་ངོ་།",
    "མིག་གཉིས་ལ་ཨོཾ་འོད་ཟེར་འབར་བ་རེ་རེ་བསམས་ལ།",
    "ཨོཾ་རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
    "དམ་ཚིག་མཆོག་ཏུ་ཁྱོད་འགྱུར་རོ་།",
    "ནང་གི་པད་འདབ་ཉེར་གཉིས་ཀྱི་གཡས་གྲལ་བཅུ་ལ་གཡས་སྐོར་གྱི་ཚུལ་དུ་ཚངས་པ་དང་།",
    "སའི་ལྷ་མོ་སྟེ་ཕྱོགས་སྐྱོང་བ་བཅུ་དང་།",
    "དེའི་ནང་གི་པད་འདབ་བཅུ་དྲུག་གི་ཤར་དུ་འཇམ་དཔལ།",
