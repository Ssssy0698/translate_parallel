    "ཁྱོན་པོད་ལྔ་ཁྲི་ལྷག་འགྲེམ་སྤེལ་བྱས།",
    "ཚོགས་པ་འདིའི་ཚོགས་གཙོ་མང་མོས་ཀྱིས་མཆོག་སྤྲུལ་འདིའི་རབ་དང་རིམ་པའི་མཛད་རྗེས་ལ་ཡིད་མགུར་ཐེབས་ཏེ་བདམ་ཐོན་བྱུང་བ་ཡིན།",
    "ང་ཚོ་ལ་མཐུན་རྐྱེན་མི་འགྲིག་པ་བསྟུད་མར་བྱུང་བས་ཀློག་པ་པོའི་དགོངས་པ་མཐུན་མིན་ཅི་རིགས་སུ་ངེས་ན་ཁྱེད་ཀྱི་སྤྱན་བསྟར་བ་ནས་དགོངས་ཚུལ་ཐོན་དང་།",
    "ཞེས་ཇོ་ནང་དཔེ་སྒྲིག་ཚན་ཆུང་གིས།",
    "སྐབས་སྐབས་སུ་ཏིང་ངེ་འཛིན་གྱི་ངང་དུ་ཡུན་རིང་གནས་པ་དང་དག་པའི་གཟིགས་སྣང་འབྱམས་ཀླས་པ་རང་ཆས་སུ་ཡོད།",
    "ཁོང་གིས་སློབ་བུ་འདི་ཉིད་བསྟན་འཛིན་གྱི་སྐྱེས་བུ་དམ་པར་གཟིགས་ནས་བརྩེ་བས་རྗེས་སུ་བཟུང་།",
    "བས་རྒྱུད་རྒྱལ་དུས་ཀྱི་འཁོར་ལོའི་རྫོགས་རིམ་རྡོ་རྗེའི་རྣལ་འབྱོར་སྦྱོར་བ་ཡན་ལག་དྲུག་གི་ཟབ་ཁྲིད་ལེགས་པར་གསན།",
    "གྲྭ་ཚང་འདུ་ཁང་སྟེང་གི་སྒྲུབ་གྲྭ་གོང་མ་སྦྱོར་དྲུག་ལོ་གཅིག་ཅན་དང་།",
    "དུས་འཁོར་ལྷན་སྐྱེས་ཀྱི་ཁྲིད་ཡིག་དུས་འཁོར་རྫོགས་རིམ་སྦྱོར་དྲུག་གི་སྤྱི་དོན།",
    "བདག་ཉིད་ཆེན་པོ་གང་གི་གསུང་ལས་འཁྲུངས་བའི་ཞལ་སློབ་ཡང་།",
    "བློས་བཏང་གི་བྱ་བྲལ་བ་སོགས་བསྟན་པའི་རྩ་ལག་ཏུ་གྱུར་པའི་སྐྱེས་ཆེན་གྲངས་ལས་འདས།་",
    "ཞེས་མགོན་པོ་གང་གི་སློབ་འབངས་ཐ་ཤལ་བ་ཀུན་དགའ་ཤེས་རབ་གསལ་བྱེད་ཀྱིས་བྲིས་པའོ།",
    "གསང་སྔགས་བརྟུལ་ཞུགས་མཆོག་གིས་སྒེག་བཞིན་དུ།",
    "མཛེས་སྡུག་གཟི་འོད་སྟོང་གིས་བརྗིད་པ་ཅན།",
    "གང་གི་གཡས་གཡོན་ཐུགས་ཀྱི་གཟུངས་མ་མཆོག།",
    "མན་དཱ་ར་བ་མཛེས་སྡུག་སྒེག་མོའི་ཚུལ།",
    "ངོ་མཚར་ཡིད་འཛིན་བདེ་ཆེན་འདྲེན་པ་མོ།",
    "གང་གི་གནས་གསུམ་ཡི་གེ་གསུམ་གྱིས་མཚན།",
    "དཔའ་བོ་ཧེ་རུ་ཀ་ཁྱོད་དགྱེས་ཕྱིར་མཆོད།",
    "རང་བྱུང་ཡེ་ཤེས་དག་ཆེན་མཆོག་གི་གཤིས།",
    "གཟུང་འཛིན་ཅན་ངོར་ཐབས་ལམ་ཅོག་བཞག་གིས།",
    "མོས་པ་དང་འཚམས་མཛད་བཟང་སྣང་བ་ཡིས།",
    "འཕོ་འགྱུར་སྤྲོས་པ་ཡེ་ནས་མི་སྲིད་མོད།",
    "དོན་དམ་ངེས་པ་མཆོག་གི་པད་འབྱུང་སྟེ།",
    "རང་གི་སྒོ་གསུམ་ཉིད་དུ་ལེགས་ཐིམ་པས།",
    "འབད་མེད་ཟང་ཐལ་རྒྱ་ཡན་དགོངས་གྲོལ་ཤོག།",
    "པི་ཝཾ་གླིང་བུ་རོལ་མོའི་ཁྱད་པར་རིགས།",
    "ཞོ་བིལ་གི་དུར་ལི་ཡུངས་རྣམས་ཀྱིས་མཆོད།",
    "འཁོར་ལོ་ནོར་བུ་བཙུན་མོ་བློན་དམག་དཔོན།",
    "རལ་གྲི་ཁང་བཟང་པགས་པ་སྐྱེད་མོས་ཚལ།",
    "རྡོ་རྗེ་སྒེག་མོས་མཛེས་པའི་གཟུགས་ངོམས་ཤིང་།",
    "རྡོ་རྗེ་ཕྲེང་མོས་མུ་ཏིག་དོ་ཤལ་སྒྲིག།",
    "རྡོ་རྗེ་རེག་བྱ་མ་ཡིས་ན་བཟའ་སྟོབ།",
    "གང་གི་གསང་གསུམ་རོལ་པ་བདེ་ཆེན་རྒྱན།",
    "ཐད་ཀར་མངོན་གྱུར་ཟང་ཐལ་རྗེན་ཆར་བ།",
    "བླ་སྒྲུབ་ཁོག་བཞིན་སོང་ནས་མཐར།",
    "ཞལ་གཅིག་ཕྱག་བཞི་རྩ་ཕྱག་ཐལ་མོ་སྦྱར།",
    "ལྷ་མོའི་མཚན་ཉིད་རྒྱན་ཆས་ཀུན་རྫོགས་ཤིང་།",
    "མཆོག་གི་སྤྲུལ་པའི་བདག་རྐྱེན་ཉིད་དུ་གསལ།",
    "ངེས་པ་མཆོག་གི་པད་འབྱུང་༴",
    "ངེས་པ་མཆོག་གི་སེམས་དཔའ་༴",
    "མཉམ་བཞག་ཡངས་པ་གཅིག་གི་བཞག་ཐབས་ཀྱིས།",
    "ཐུགས་ཡིད་རོ་མཉམ་ཡིད་ཆེས་དད་མོས་ཀྱིས།",
    "ཞབས་ཟུང་སྐྱིལ་ཀྲུང་གིས་བཞུགས་མཚན་དཔེ་འབར།",
    "གང་གི་གཡས་གཡོན་མཚར་སྡུག་སྒེག་མོའི་གཟུགས།",
    "མ་མཱ་ཀི་དང་གོས་དཀར་ལྷ་མོའི་ཚུལ།",
    "ཨ་མི་དྷེ་ཝ་བྷ་བ་༴",
    "ངེས་པ་མཆོག་གི་པད་འབྱུང་༴",
    "གང་གི་ཐུགས་སྲོག་སྔགས་གདངས་རིག་པའི་གཤིས།",
    "ཨོཾ་ཨ་མི་དྷེ་ཝ་ཧྲཱི་ཞེས་པ་ཅི་ནུས་བཟླས་རྗེས།",
    "ཚེ་འདས་རིགས་དྲུག་གང་དུ་སོང་གྱུར་པ།",
    "དེ་དག་གིས་ནི་ཚེ་འདས་ཐར་ལམ་གྱི།",
    "ཨོཾ་བཛྲ་གུ་རུ་ཀྲོ་དྷ་ཨ་མུ་ཀ་མ་ར་ཡ་ཕཊ།",
    "གསང་བ་སྔགས་ཀྱི་རིག་སྔགས་ཟབ་མོ་ཡིས།",
    "ཉོན་མོངས་དྲི་མ་འཁྲུད་པའི་དག་བྱེད་ཀྱིས།",
    "རིང་མིན་གྲོལ་བ་མཆོག་ལ་མྱུར་རེག་སྟེ།",
    "གདུལ་བྱའི་མོས་ངོར་འཚམ་པའི་བཀོད་བཟང་གིས།",
    "ཐུན་མོང་དང་ནི་ཐུན་མོང་མ་ཡིན་པའི།",
    "གུ་རུའི་སྤྲུལ་པ་རྒྱལ་པོ་རེ་རེའི་ཚུལ།",
    "རང་རང་ལ་འོས་ཐུན་མོང་ལམ་བཟང་པོས།",
    "གྲོལ་བ་མཆོག་ལ་མྱུར་རེག་སྐལ་བཟང་ཤོག།",
    "དཔལ་ལྡན་གསང་བ་ཟབ་མོའི་མཛོད་ཀུན་འཛིན།",
    "གསང་ཆེན་སྔ་འགྱུར་ཟབ་མོ་གཏེར་གྱི་མཛོད།",
    "ༀཨཱརྱ་ལོ་ཀི་ཤྭ་ར་ཨ་མི་དྷེ་ཝ་བྷ་བ་མཆན།",
    "པི་ཝཾ་གླིང་བུ་རོལ་མོའི་ཁྱད་པར་རིགས།",
    "སྤྱན་གཟིགས་ཇོ་ནང་དཔེ་ཚོགས།",
    "ཞོ་བུལ་གི་དུར་ལི་ཡུངས་རྣམས་ཀྱིས་མཆོད།",
    "འཁོར་ལོ་ནོར་བུ་བཙུན་མོ་བློན་དམག་དཔོན།",
    "རལ་གྲི་ཁང་བཟང་པགས་པ་སྐྱེད་མོས་ཚལ།",
    "རྡོ་རྗེ་སྒེག་མོས་མཛེས་པའི་གཟུགས་ངོམ་ཤིང་།",
    "རྡོ་རྗེ་ཕྲེང་མོས་མུ་ཏིག་དོ་ཤལ་བསྒྲིག།",
    "རྡོ་རྗེ་རེག་བྱ་མ་ཡིས་ན་བཟའ་སྟོབ།",
    "གང་གི་གསང་གསུམ་རོལ་བ་བདེ་ཆེན་རྒྱན།",
    "ཐད་ཀར་མངོན་གྱུར་ཟང་ཐལ་རྗེན་ཆར་བ།",
    "གཟུང་འཛིན་ཅན་ངོར་ཐབས་ལམ་ཅོག་བཞག་གིས།",
    "མོས་པ་དང་འཚམས་མཛད་བཟང་སྣང་བ་ཡིས།",
    "འཕོ་འགྱུར་སྤྲོས་པ་ཡེ་ནས་མི་སྲིད་མོད།",
    "སྣ་ཚོགས་སྤྲུལ་པས་འགྲོ་འདྲེན་མཆོག་གི་ཕུལ།",
    "རིག་སྟོང་ཟང་ཐལ་ངང་ནས་གསུང་སྒྲོག་བྱ།",
    "མ་ཏིས་སྨྲས་པ་ལྟར་བསྐུལ་བ་པོ་རང་གིས་ཡི་གེ་བགྱིས་པ་དགེ།",
    "གང་གཱའི་ཀླུང་གི་རྡུལ་སྙེད་ལས་འདས་པ།",
    "བདུད་དང་ཉོན་མོངས་ཤེས་བྱ་སྙོམས་འཇུག་གི།",
    "ཁྱོད་ཀྱིས་རྣམ་དག་ཚོགས་གཉིས་ལེགས་བསྒྲུབ་པའི།",
    "བདག་གིར་མ་བཟུང་མཆོད་རྫས་བཟང་དགུ་རྣམས།",
    "ཁྱོད་ཀྱི་སྐུ་ཇོ་ནང་དཔེ་ཚོགས།",
    "ཁྱོད་ཀྱིས་ཡང་དག་ལམ་ལ་དགོད་དུ་གསོལ།",
    "རང་གིས་ནང་ནས་ཉམས་པར་བྱེད་པར་རྣམས།",
    "འདིར་གང་ཉིད་སྒྲུབ་པའི་ཐབས་ལ་བསྟེན་པའི་སྒོ་ནས་ཚེ་གཡང་ཚོགས་གསུམ་བྱེད་ཐབས་ལ།",
    "གང་གི་དགོངས་ཆེན་དབྱིངས་ནས་ཐུགས་རྗེའི་འཕྲུལ།",
    "གང་གི་ཐུགས་ལས་སྤྲོས་པས་འོད་ཟེར་གྱིས།",
    "དེ་དག་གི་ནི་ཐུགས་རྒྱུད་ཀྱིས་བསྡུས་ཤིང་།",
    "གྲུབ་པའི་རྒྱལ་མོ་འཕགས་པའི་གནས་བརྟན་ཚོགས།",
    "གཞན་ཡང་ནང་བཅུད་སྐྱེ་འགྲོ་གང་དག་གི།",
    "ལེགས་བཅོས་སྲོག་གི་དངོས་པོར་ཀུན་བསྡུས་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "སྒྲུབ་པོ་གཞོམ་བྲལ་རྡོ་རྗེའི་ཚེ་ཐོབ་སྟེ་ སྲིད་གསུམ་དཔུང་གི་རྒོལ་ཡང་གནོད་བྲལ་གྱུར།",
    "ལྔ་པ་ཡེ་ཤེས་ཆེན་པོ་ལྔ་ཡི་རྒྱ་ དྲུག་པ་ཕ་རོལ་ཕྱིན་པ་དྲུག་གི་རྒྱ།",
    "བླ་ཚེ་སྲོག་གི་དངོས་པོ་རྡོ་རྗེ་ལྟར།",
    "རབ་བརྟན་རྐྱེན་ངན་གང་གིས་མི་གཞིག་པར།",
    "དངོས་གྲུབ་དབྱིག་གི་འཕེལ་སྟོབས་མི་དམན་པར།",
    "དུས་སུ་ཇི་བཞིན་རེ་སྐོང་མཛད་པར་གྱུར།",
    "གང་གི་ཐུགས་ལས་སྤྲོས་པའི་འོད་ཟེར་ཀྱིས།",
    "སྣོད་བཅུད་ལ་བསྟིམ་གཡང་གི་བཅུད་ཆགས་ཏེ།",
    "ལ་སོགས་ནོར་ལྷའི་རིགས་གྱུར་གང་དག་གི།",
    "དེ་ལྟར་གུ་རུ་ནོར་སྟེར་མཆོག་གི་མཐུས།",
    "གང་གི་སྐུ་གསུང་ཐུགས་ཀྱི་མཐུ་བྱིན་གྱིས།",
    "བཀྲ་ཤིས་གཡང་གི་སྒོ་མོ་རབ་བརྟན་ཞིང་།",
    "རྟག་ཚུད་རྐྱེན་ངན་གང་གིས་ཚུགས་མིན་པར།",
    "རཾ་ཡཾཁཾ་གིས་དྲི་མ་བསྲེགས་གཏོར་བཀྲུས།",
    "ཡི་དམ་ཞི་ཁྲོ་རབ་འབྱམས་མ་སྲིང་གི།",
    "གསང་གསུམ་ལྷ་ཤར་དག་སྣང་ལྟད་མོར་ངོམ།",
    "ཅེས་པས་མཐར་དབྱུང་ཚོགས་མཆོད་བླ་སྒྲུབ་དང་མ་འབྲེལ་བའི་སྐབས་སུ་ནི།",
    "ཞེས་གུ་རུའི་བླ་སྒྲུབ་དང་འབྲེལ་བའི་ཚེ་གཡང་སྒྲུབ་ཅིང་ཚོགས་མཆོད་བྱེད་པའི་ཚུལ་ཉེར་མཁོ་འགྲོ་ཕན་སྤེལ་བྱེད་ཅེས་བྱ་བ་འདི་ཡང་དོན་གཉེར་ཅན་འགའི་ངོར།",
    "རྔ་ཡབ་གླིང་གི་མངའ་བདག་དགྱེས་བཞུགས་དྲུང་།",
    "ས་ལ་སྤྱོད་པའི་ཞིང་མཆོག་ཉིད་དུ་མོས།",
    "རང་གི་སྤྱི་བོར་འཇའ་གུར་འཁྱིལ་བའི་ཀློང་།",
    "བར་གྱི་གདན་ལ་འཕགས་མཆོག་སྤྱན་རས་གཟིགས།",
    "འཕོ་འགྱུར་མེད་པ་དགོངས་ཀློང་གཅིག་གི་ངང་།",
    "མཁའ་མཉམ་འགྲོ་བའི་རེ་སྐོང་རྒྱལ་སྲས་ཚུལ།",
    "སོར་མོའི་འཕྲུལ་ལས་རྐོ་བྱེད་ལ་མཁས་ལྷག་བསམ་བློ་ལྡན་པ་ དེ་སོགས་མཐུ་བཟང་དཔལ་ཡོན་ལ་བརྟེན་ལེགས་བྱས་འདིར་གྲུབ་དགེས།",
    "སློབ་ཚོགས་བསྟན་འཛིན་སྦྱིན་བདག་གིས་མཚོན་འགྲོ་ཀུན་གཏན་བདེར་ཤོག།",
    "སློབ་དཔོན་རྡོ་རྗེ་སྐུ་བརྙེས་པད་འབྱུང་གི་རྣམ་པར་ཐར་བ།"
  ]
}