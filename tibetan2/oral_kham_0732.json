    "ཡོད་ཟེར་བ་དེ་ལ་རྟོག་དཔྱོད་ཞུགས་ཙ་ན་དེ་ཡང་སྒྲ་ཇི་བཞིན་མ་ཡིན་པའི་མཚང་རིག་ནས་རྣམ་པ་ཀུན་ཏུ་དེ་ཀ་འཚོལ་བ་དང་།",
    "བེ་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "ལོ་བདུན་གྱི་བར་ས་ཁྱིམ་དང་འདུ་འཛིའི་ཐེམ་པ་མི་གདའ་བ་དང་གཅིག།",
    "ལས་དང་པོ་པ་ལ་ཤིན་ཏུ་ཕན་པར་གདའ།",
    "ཁུ་ཚུར་ཙམ་གྱི་ཡོན་ཏན་ལྷུན་པོར་འགྲན་པ་བཞིན།",
    "གེགས་ཆེན་དེ་རང་ལ་ཚང་ནས་གདའ།",
    "སྐྱེས་པའང་རང་སར་སྤོང་བར་བྱེད།",
    "རྣམ་པའི་གཞུང་ལུགས་ལ་སྨྲ་བསམ་བརྗོད་མེད་གཉིད་འཐུག་པོ་དང་གཅིག་པའི་ཕྱོགས་ཕུལ་བཀོད་པའང་འདུག།",
    "དྲན་པས་ཀྱང་མ་བཟུང་རང་བབ་ཀྱི་རིག་པ།",
    "སྐྱིད་སྡུག་གཉིས་ལ་འདམ་ཀ་ད་རུང་འདུག།",
    "ཡེངས་མ་ལམ་གྱི་ཆོམ་རྐུན་ད་རུང་འདུག།",
    "འཆི་བར་འཇིགས་པ་མེད་ཚེ་མཐོང་ཙ་ན།",
    "མི་ཚེ་ཕལ་ཆེར་སྟོང་པར་ཟད་འདུག།",
    "དེང་སང་འགྲོ་བའི་ཐོག་དུ་བབས་འདུག།",
    "མདང་ཉ་མགོ་གྲུ་ཡིན་ཟེར་བ་ཞིག་ཏུ་ཞུགས་ནས་གཙང་པོའི་དཀྱིལ་དུ་སླེབས་ཙ་ན།",
    "ལྟོས་དང་རིག་འཛིན་དགའ་རབ་རྡོ་རྗེ་ནམ་མཁའ་ལ་ཕེབས་འདུག་ཟེར།",
    "བལྟས་ཙ་ན་ཉིད་ཧེ་རུ་ཀ་པའི་ཆས་སུ་བྱས་ནས་སྣང་།",
    "དགེ་སློང་རྡོ་རྗེ་འཛིན་པ་ལ་སོགས་པ་དེ་ཚོའི་དོག་འཚངས་བྱེད་དགོས་པ་མི་འདུག་སྟེ།",
    "ཁྱེད་རང་ཡིན་མ་ཡིན་གཞིག་འབྲེལ་གནང་བ་ཞུཀུན་རྫོབ་ཉན་ཐོས་ཀྱི་སྡོམ་པ་ལ་ལུས་ངག་ཡིད་གསུམ་གྱི་སྒོ་ནས་ཉེས་སྤྱོད་སྡོམ་པ་གཞིར་བཞག་ནས།",
    "ཁྱེད་ཀྱི་ལྟར་ན་འདི་གཉིས་ཁ་ཕྲལ་བ་ལ་ཡང་དོགས་པ་སྐྱེ་ཉེན་གདའ།",
    "ཞེས་པ་དེར་འདུག་གོ།",
    "ཚེ་འདིའི་སྣང་བར་རང་སར་ལྡོག་ནུས་པའི་ས་དེར་རང་ཉིད་གཅིག་པུར་འདུག།",
    "ཆར་ཞོད་ཤིན་ཏུ་ཆེ་བས་ཕུག་པའི་ཕྱི་ནང་ལ་སྐམ་རློན་མི་འདུག་པས་འགག་སྟོངས་དེར་གྲོང་པའི་སྐྱེ་བོ་ཞིག་ལ་སླེའུ་དཀར་པོ་ཞིག་གཡར་བ་ཉིན་མཚན་མེད་པའི་གོས་སུ་བྱས།",
    "རྗེ་གྲུབ་ཐོབ་གོང་མའི་ཤུལ་ལམ་དུ་འདུག་གོ།",
    "འདི་གསུམ་བསྒྲུབ་ན་སྤྲང་པོས་ཀྱང་འགྲུབ་ཚོད་ན་གདའ་སྟེ།",
    "འདི་གསུམ་བསྒྲུབ་ན་སྤྲང་པོས་ཀྱང་འགྲུབ་ཚོད་ན་གདའ་སྟེ།",
    "འདི་གསུམ་བསྒྲུབ་ན་སྤྲང་པོས་ཀྱང་འགྲུབ་ཚོད་ན་གདའ་སྟེ།",
    "འདི་གསུམ་བསྒྲུབ་ན་སྤྲང་པོས་ཀྱང་འགྲུབ་ཚོད་ན་གདའ་སྟེ།",
    "འདི་གསུམ་བསྒྲུབ་ན་སྤྲང་པོས་ཀྱང་འགྲུབ་ཚོད་ན་གདའ་སྟེ།",
    "འདི་གསུམ་བསྒྲུབ་ན་སྤྲང་པོས་ཀྱང་འགྲུབ་ཚོད་ན་གདའ་སྟེ།",
    "བདག་ཐོལ་བྱུང་རང་གྲོལ་རྣལ་འབྱོར་པས།",
    "དེར་ལྷན་སྐྱེས་ཌཱཀྐིའི་བརྡ་སྟོན་ལྟར་མེ་ཏོག་ཕུག་པར་འདུག་གནས་བཟོས་ཤིང་།",
    "བུ་ང་རང་ཡང་སྣང་སེམས་གཞི་གྲོལ་ཀློང་།",
    "བུ་ང་རང་ཡང་མཐའ་གྲོལ་ཀློང་ཡངས་ངང་།",
    "བུ་ང་རང་ཡང་སྣང་སེམས་བསྲེ་བའི་ཕྱིར།",
    "བུ་ང་རང་ཡང་མཐའ་བརྒྱད་སྤྲོས་བྲལ་ངང་།",
    "བུ་ང་རང་ཡང་གཉུག་མའི་བརྟུལ་ཞུགས་དང་།",
    "བུ་ང་རང་ཡང་རྣམ་རྟོག་ལུ་གུ་རྒྱུད།",
    "བུ་ང་རང་ཡང་དགོངས་ཀློང་ཡངས་པའི་ངོགས།",
    "བུ་ང་རང་ཡང་མ་བཅོས་གཉུག་མའི་གྲོང་།",
    "སང་གནངས་ལས་མ་འགྱངས་པར་ཕེབ་དགོས་ཟེར་གཙུག་སྐྲའི་ལན་བུ་ལ་ཤོག་ཚར་ཞིག་འདུག་པ་བསྟན་བྱུང་བ་བཀླགས་པས།",
    "ཟེར་བ་འདུག།",
    "ཕྱོགས་དེར་གཏན་དུ་མི་ཆགས་པའི་བརྡ་སྟོན་ཙམ་དུ་འདུག།",
    "དེ་ལྟ་ནའང་རང་ཉིད་ལ་དག་པའི་སྣང་བ་ཆེས་དཀའ་བ་དག་མ་རངས་པ་དང་ངག་ཚིག་བརླང་པོས་ཕ་རོལ་གྱི་དོ་ཟླར་བལྟ་བ་ལ།",
    "ཐ་མལ་གྱི་རིག་པ་བསྐུངས་ནས་འདུག།",
    "བྱས་ནས་བྲག་ཕུག་འགག་ཏུ་བྲོ་བརྡུངས་པས་ཁོང་རྣམས་ཀྱི་ཞེ་སྡང་རང་སར་ཞི་ཐུབ་པ་བྱུང་ངོ།",
    "ཁམས་གསུམ་ལུས་ཅན་ཕ་མ་རུ་འདུག་པས།",
    "མི་འདུག་སྙམ་པས་རྒྱས་འདེབས་ཡུལ་ལ་ཤོར།",
    "ཧ་ཧ་ཧ་ཞེས་འདར་ཉལ་སྤྲད་ནས་འདུག་པའི་ཚེ།",
    "དེར་གཉིད་དེ་སད་ཙ་ན་སེམས་ལ་སྐྱོ་ཤས་ཤིན་ཏུ་ཆེ་བ་ཞིག་ལངས།",
    "གཞན་སྣང་ཟིལ་གྱིས་གནོན་པའི་གསུང་གང་ཡང་འབྱོན་གྱིན་འདུག་གོ།",
    "རང་རང་སོ་སོའི་མཐོང་སྣང་ཡིན།",
    "དྲན་རིག་སྤྲོས་བྲལ་དབྱིངས་ལ་བཞག་ཙ་ན།",
    "སྐྱིད་སྡུག་རྨི་ལམ་སྒྱུ་མར་ཞེན་ད་དགོས་པ་མི་འདུག།",
    "དབུ་དཀར་རྒན་པོའི་འཚོ་རྩིས་སྒུག་ལོང་ནི་མི་གདའ།",
    "སེང་གེ་གངས་ལ་ཟིན་པས་མཐོང་ས་ན་མི་འདུག།",
    "ཧ་ཅང་རང་ཐུགས་གཏུམ་མ་དྲག་གམ་ཟེར།",
    "དཔོན་མཇལ་གོ་ཚོད་པ་ཞིག་དེ་ན་གདའ།",
    "མི་འདུན་སྟབས་མཁས་པ་ཞིག་དེ་ན་གདའ།",
    "གསེར་གྱི་ཡང་ཞུན་ཞིག་དེ་ན་གདའ།",
    "རྒྱལ་ཐབས་སྤྱི་བླུགས་ཤིག་དེ་ན་གདའ།",
    "འགྲན་གྱི་དོ་མེད་ཅིག་དེ་ན་གདའ།",
    "རྫུ་འཕྲུལ་ཤུགས་ལྡན་ཞིག་དེ་ན་གདའ།",
    "རྒྱལ་འགོང་ཚར་གཅོད་ཅིག་དེ་ན་གདའ།",
    "དགྲ་འཇིགས་གོ་ཆོད་པ་ཞིག་དེ་ན་གདའ།",
    "དཔྱད་ཤིན་ཏུ་བཟོད་པ་ཞིག་དེ་ན་གདའ།",
    "མི་དལ་འབྱོར་དོན་ལྡན་ཞིག་དེ་ན་གདའ།",
    "མི་སེམས་བསྐྱེད་ཅན་ཞིག་དེ་ན་གདའ།",
    "ད་འདི་ལ་གཞན་ཐབས་ནི་མི་འདུག་བཏང་སྙོམས་སུ་བཞག་ན་སེམས་བསྐྱེད་ཀྱི་ཁས་བླངས་འཆོར།",
    "དམན་པས་སྐུར་པ་བཏབ་ཀྱི་དོགས་པ་ལ་སོགས་སྡུག་བསྔལ་ཁོ་ན་ལས་མི་འདུག།",
    "ཟེར་གྱི་འདུག་པས་གྲྭ་བ་ཞེ་སྡང་ལངས།",
    "དེ་འདྲ་མི་མཛད་པ་ཞུ་ཟེར་ཀྱི་ཡོད་ཙ་ན།",
    "བསོད་སྙོམས་ཙམ་བྱེད་ཀྱང་བྱེའུ་དང་ཁྲ་ཐུག་པ་ལྟ་བུའི་སྒྱུ་གཤེད་ཀྱིས་བླངས་ནས་ཁྱིམ་པ་སུན་འབྱིན་ཁོ་ན་ལྷུར་བྱེད་པ་འདི་ལའང་བཅོམ་ལྡན་འདས་ཐུགས་བློ་བདེ་པོ་ཡོད་སྐད་མི་འདུག།",
    "ངོ་ཤེས་འདྲིས་མེད་ཀྱི་ལུང་པ་ཚོར་ནི་སྙན་པ་འུར་ལངས་པ་ཞིག་འདུག་པ་དེ་འདྲ་ཅི་ཞིག་གམ་སྙམ་པ་ཁོ་ན་བྱུང་བས།",
    "ང་རང་ལས་འགངས་ཆེ་བ་དང་།",
    "དཔེར་ན་རྨ་བྱས་དུག་ཟོས་པ་དང་གཞན་གྱིས་ཟོས་པ་ལ་ཁྱད་པར་ཅི་འདྲ་འདུག།",
    "བསམ་གྱིས་མི་ཁྱབ་པའི་དོན་བསམས་ཙ་ན་ཀུན་ཏུ་རྟོག་པ་ཨོཾ་ཨཱ་ཧཱུྃ།",
    "ལུས་དྲེས་མས་བསྡམ་ཚེ་ཕན་པ་ཞིག་མི་འདུག།",
