    "དགའ་བཞི་བའི་མི་རབས་ཀྱི་བྱུང་བ་བརྗོད་པ་སོ་སོའི་ནང་དུ་ཡང་གསལ་བ་གཅིག་མཐུན་འདུག་པ་དང་།",
    "དད་རྟེན་དུ་ཕྱག་ཕྲེང་ཞིག་དང་རྫོངས་པའི་གནང་སྐྱེས་གྱ་ནོམ་པ་བསྩལ་ཅེས་གསལ་འདུག་སྒྲིག་པ་པོའི་མཆན།",
    "ན་མ་མཆིས་པ་ཞུས་ཏེ་དབུའི་མཆོད་གནས་སུ་ཁ་ཙམ་མ་ཡིན་པར་དོན་གྱིས་བཀུར་བས་མཆོག་དམན་ཀུན་གྱིས་བསྔགས་པའི་ཡུལ་བླ་ན་མེད་པ་ཞིག་འདུག་ཀྱང་།",
    "སུའི་ཤིང་བྱང་ངོ་མ་ཐོན་ཚེ་དེ་རིགས་སྐུ་སྐྱེ་འཁྲུལ་མེད་ཡིན་འདུག་པ།",
    "རྒྱ་ཁྱབ་ཡོངས་ནས་ལེགས་འབུལ་ཞུ་མིའི་མི་སྣ་དག་ཀྱང་འབྱོར་ཞེས་ལོ་སྔ་ཕྱི་འདྲེས་འདྲ་ཞིག་གསལ་འདུག།",
    "ིཅེས་འཁོད་འདུག་ཀྱི།",
    "སྔར་རྒྱུན་རྒྱལ་བའི་ཕྱག་རོགས་མཛད་དེ་ཆབ་སྲིད་ཀྱི་ཐུགས་འགན་བཞེས་ཞེས་ཡིག་རིགས་གང་ལ་གསལ་སོགས་མེད་པར་བྲིས་འདུག།",
    "བཀའ་བློན་གུང་རང་གཉའ་ནང་དུ་འཕྲུལ་ཐོན་བྱེད་པ་དང་།",
    "རིམ་བཞིན་སྒང་རོང་གཉིས་ནས་གཞིས་རྩེ་བརྒྱུད་ཤེལ་དཀར་དུ་བོད་དམག་དང་ཟླ་སྒྲིལ་གྱིས་གཉའ་སྐྱིད་རོང་གསུམ་ལ་གོར་དམག་དང་འཐབ་འཛིངས་ཕྲན་བུ་བྱས་པར་གོར་དམག་ཕམ་ཉེས་ཆེན་པོ་གཏོང་ཐུབ་སྟེ་ཕྱིར་བྲོས་བྱས་པའི་རྗེས་དེད་ཀྱིས་རྒྱ་བོད་ཀྱི་དམག་སྣེ་བལ་པོའི་ས་ཐོག་ཏུ་སླེབས་འདུག་ཅེས་བྲིས་འདུག་གོང་གསལ་ལྟར་ན་ཀྲུང་ཐང་ཕུ་ཁང་ཨན་ཡར་ལམ་བྱང་འགྲིམས་བརྒྱུད་ཤར་རྒྱག་དམག་སར་བསྐྱོད་པ་ལྟ་བུ་དང་།",
    "ཞེས་འཁོད་འདུག་ཅིང་།",
    "རྒྱ་དམག་ཕོན་འབོར་ཆེ་ལ་ཁྱི་སྤྱང་ཁ་རིས་གཅིག་གྱུར་ལ་བརྟེན་འཇིགས་ཟིལ་མ་བཟོད་པས་དངོས་ཐོན་བྱུང་མི་འདུག་ཀྱང་།",
    "པའུ་ཨམ་པས་པཎ་ཆེན་ཨེར་ཏེ་ནི་བཀྲ་ཤིས་ལྷུན་པོ་ནས་འཁྲིད་འདུག་པ་ཨེར་ཏེ་ནི་སྐུ་ན་ཕྲ་བས་ཉེས་པ་མེད།",
    "གོར་ཥ་རྒྱལ་པོར་སྐྱབས་བཅོལ་བ་དགའ་བ་འདུག་པས་ངེས་པར་གྱིས་ཞེས་པའི་སྦྱར་ཡིག་མང་པོ་ཐོན་པའི་ཁར།",
    "ཞེས་སོགས་བྲིས་འདུག་ཀྱང་ཡིག་ལམ་གང་ལ་བརྟེན་པ་སོགས་མི་གསལ།",
    "རྩེ་དྲུང་གྲས་སྒོ་མང་ངག་བཟོད་པ་ཟེར་བ་ཞིག་ཡོད་འདུག་པ་དེ་མིན་ནམ་ཞེས་ལབ་མི་མང་ཚུལ་ཟེར་བ་བཅས་མི་དེ་གར་ཡིད་དོགས་ཡོད་མེད་གསུངས་པར།",
    "དེའི་ངོ་བཤུས་རྒྱ་ཡིག་ཐོག་ཕབ་པ་བཅས་འདུག་པ་རྒྱ་ཡིག་དེ་བཞིན་སྦྱར་ལྕི་ཕོགས་བཙོང་སོགས་རྒྱའི་དཔོན་ཆུང་ཁག་དང་།",
    "གོང་མ་ཆེན་པོའི་གསེར་སྙན་དུ་དྭངས་པའི་ཞུ་ཐོ་འདིར་གསལ་གྱི་མི་ཚང་མ་འགུགས་སྦྱང་རྩེད་གཅོད་བསྐྱངས་དགོས་བྱུང་ཚེ་མཐོ་རྒྱལ་པོ་ནས་དམའ་སྤྲང་པོའི་བར་ལ་ལབ་གླེང་མ་འཁོད་པ་མི་འདུག་རུང་།",
    "ཕྱིར་ཕེབས་སུ་ཁོ་པ་ཚོའི་ཞུ་ཐོ་ནང་གསལ་ཚང་མར་ར་སྤྲོད་ཙམ་བྱེད་མ་བཅུག་ན་སླར་གོང་མ་ཆེན་པོའི་གསེར་སྙན་དུ་དྭངས་ཚེ་འཁྱམས་སྐྱུར་སླ་བཅོས་འཁུར་མེད་བྱས་འདྲའི་དགོངས་ཕྱོགས་བྱུང་དོགས་འདུག་རུང་སྤྱི་བྱིངས་ལ་ཞོད་འཇགས་ཆེ་བའི་ཐབས་ཚུལ་གང་དྲག་བྱས་ཆོག་པ་བྱ་རྒྱུ་བློ་གཡེང་མ་དགོས་ཞེས་བསྩལ་ཅིང་།",
    "གཞན་ཡང་འོས་མིན་འདི་བྱས་གང་ཡང་མ་འཁོད་འདུག་ཅེས་དང་།",
    "དེ་ལ་ཁོ་རང་གཟུགས་བབ་ཞན་ཁར་ད་ལྟ་ཏོག་དང་གོ་གནས་མེད་པ་སོགས་བབ་འོས་མ་ཆེ་ཚུལ་དང་།",
    "བོད་དུ་འབྱོར་བསྟུན་ཨམ་བན་རིམ་པའི་ངག་བཀོད་དང་ལེན་བྱས་འདུག་པ་མ་ཟད།",
    "གོར་ཥ་རྒྱལ་པོར་སྐྱབས་འཚོལ་བ་དགའ་བར་འདུག་པས་ངེས་པ་གྱིས།",
    "རྡོ་རིང་དང་དགའ་ཤར་གཉིས་ནས་ཚེའུ་ཨམ་པར་གསེར་དངུལ་འབུལ་ལེན་བྱ་རྒྱུ་བྱུང་མིན་ཐད་བྱེད་པོ་ཁོ་རང་ནས་ཁུངས་སྐྱེལ་ཞུ་རྒྱུ་ཡོད་ན་ལས།",
    "ད་ལམ་ཚེའུ་ཨམ་པའི་ཞུ་གསལ་ལྟར་ན་ཁོ་པས་འོས་མིན་གྱི་བྱ་བ་མང་དག་བྱས་ཚུལ་འཁོད་འདུག་པ་འདི་དོན་ཚང་མ་མ་བདེན་རུང་།",
    "མཁན་བླ་བཀའ་བློན་མདའ་དཔོན་སོགས་ཐམས་ཅད་ཀྱིས་ཀྱང་རང་རང་སོ་སོའི་ལས་སྐལ་ལ་འབད་བརྩོན།",
    "ཅེས་འཁོད་འདུག།",
    "རྒྱ་བོད་ལེགས་ལམ་ཆེ་བའི་གསུང་ཕྱོགས་ཇི་དགེ་ཁྱེད་རང་ནས་དགོངས་བཞེས་གནང་དགོས་ཞུས་པར།",
    "ཆུང་སྲིད་ཁག་གསུམ་པོ་ལྷ་ལྡན་ཉེ་འཁོར་ཞིག་ཏུ་སྔོན་ཆུག་གདན་ཞུ་མཛད་ཅེས་འཁོད་འདུག་པ་མ་ཟད།",
    "གསེར་བུམ་དཀྲུག་འདོན་དངོས་གཞིའི་མཛད་སྒོ་དེ་ཞིབ་ཙམ་མ་དྲངས་ན་འགྲིག་ཐབས་མི་འདུག་པས།",
    "ཞེས་འཁོད་འདུགསྐབས་དེར་དངོས་སུ་བཞུགས་ཡོད་པའི་རྒྱ་བོད་བླ་དཔོན་ཆེ་རྒུ་གྲངས་མང་དེ་ལྟ་བུའི་མཚན་དང་།",
    "ཤིང་སྟག་ཤིང་ཡོས་བར་ཁྲི་ལོ་བཅུ་གཅིག་བསྐྱངས་ཞེས་འཁོད་འདུག་ཅིང་།",
    "མཎྜལ་རྟེན་གསུམ་ཕུལ་གཞེས་སྲིད་སྐྱོང་ཆེ་འདོན་མཛད་སྒོའི་སྐོར་ཞིབ་ཙམ་འཁོད་འདུག།",
    "ལྷ་གསོལ་བཅས་སུ་འཁྲུངས་པའི་ཆུང་སྲིད་རྣམས་འགྱངས་མིན་ལྷ་ལྡན་ཕྱོགས་སུ་གདན་ཞུས་ཀྱིས་བརྟག་དཔྱད་ཞིབ་ཆ་མཛད་ཐོག་གསེར་བུམ་དུ་བརྟག་དཔྱད་མཛད་རྒྱུར་ཆུང་སྲིད་དེ་རྣམས་ཀྱིས་འཐུས་པ་འདུག་དགོངས་པར་བྱུང་ཚེ་དེ་དོན་གནས་ཚུལ་དང་བཅས་སྔོན་གྱི་དེབ་གསལ་ལྟར་གཟའ་ཚེས་ལེགས་པ་ཞིག་ལ་གསེར་བུམ་བརྟག་དཔྱད་ཞུས་ཆོག་པ་ཞེས།",
