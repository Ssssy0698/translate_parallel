    "ཁྱོད་གསུང་ཀུན་དང་འཚམ་པར་འཇུག།",
    "བརྩི་བཞག་སོགས་ལུང་རིགས་ཀྱི་རྒྱུགས་ཞིབ་བཞེས་མཛད་དེ་ཚར་གཅོད་རྗེས་འཛིན་གྱི་སྒོ་ནས་ཚུལ་མཐུན་རྣམས་ལ་གཟེངས་བསྟོད་དང་བབ་བསྟུན་གྱིས་ཟང་ཟིང་གི་བདག་རྐྱེན་མང་དུ་སྩལ།",
    "སོ་ཕག་གི་ཁྲེལ་བོ་ནི་མེད།",
    "འཇམ་མགོན་རྒྱལ་བ་གཉིས་པ་སླར་བྱོན་ཀྱང་དེ་ཕན་ཆོད་དུ་གསུང་ཐབས་མེད་པ་ལྟ་བུའི་གཞུང་ཆེན་མོ་སྤྱིའི་ཁོག་སྒྲིག་ལུགས།",
    "ལ་ལས་ལམ་རིམ་ཆེན་མོ་བརྒྱ་ཚར་འདོན་རྒྱུའི་དམ་བཅའ་ཕུལ་པ་དང་།",
    "འགའ་ཞིག་ལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་གཞི་བསྙེན་ཆེན་མོའི་ཁྲིད་དང་།",
    "བྲམ་ཟེ་ཕུར་བུ་དང་བོ་དོང་ལུགས་ཀྱི་དབྱངས་ཅན་མ་དཀར་མོ་གཉིས།",
    "འཆི་མེད་རྡོ་རྗེ་ལྷ་མོ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "རེབ་གོང་རྩེ་ཁོག་ཧོར་དཔོན་པོ་བ་རྒྱུ་སོགས་ཧོར་ཚོ་བཞིའི་བླ་དཔོན་དམངས་ཚོགས་ཡོངས་ནས་གདན་དྲངས་པ་ལྟར།",
    "བླ་དཔོན་བན་སྔགས་སོགས་དམངས་ཚོགས་སྟོང་ཕྲག་ལྷག་གིས་རྟ་བསུ་དང་།",
    "བླ་དཔོན་དམངས་ཚོགས་ཐུན་མོང་ནས་བསྙེན་བཀུར་གྱ་ནོམ་པ་ཞུས་པའི་ཐོག་འདུན་པ་ཆིག་སྒྲིལ་གྱིས་གསོལ་བ་རྩེ་གཅིག་ཏུ་བཏབ་པར།",
    "གཞི་བྱེས་ཀྱི་སེར་སྐྱ་ཕོ་མོ་ཉིས་ཁྲི་ལྷག་ཙམ་འདུས་པ་ལ།",
    "རྡུལ་ཚོན་འཚོ་བ་བཅུ་གཉིས་ཀྱི་བླ་དཔོན་སེར་སྐྱ་ཡོངས་ཀྱི་འདོད་མོས་ལྟར།",
    "དེ་ནས་དཔྱི་ས་དང་སོ་ནག་མགར་རྩེ་སོགས་ཀྱིས་ཀྱང་རང་རང་གི་ཡུལ་ཕྱོགས་སུ་གདན་དྲངས་པ་ལྟར་སོ་སོ་ནས་བསུ་བཀོད་རྒྱ་ཆེན་པོ་དང་བཅས་སོ་སོའི་ཕྱོགས་སུ་རིམ་གྱིས་བྱོན་ཏེ།",
    "མོས་པའི་རྗེས་སུ་འཇུག་པའི་གསུང་གི་བདུད་རྩི་དྲི་མ་མེད་པས་ཡིད་ཀྱི་རེ་བ་ཡོངས་སུ་བསྐངས་ཤིང་།",
    "གྲོང་སོགས་སུ་དེའི་ཉོན་མོངས་རྣམས།",
    "རྒྱུན་གཅོད་རྒྱལ་བའི་ཉོན་མོངས་མེད།",
    "ཚིགས་སྔ་མ་དགེ་ཚུལ་གྱི་སྡོམ་པ་བློ་བཟང་འཇམ་དབྱངས་ཐུབ་བསྟན་རྒྱ་མཚོ་ཞེས་མིང་གི་ཅོད་གནང་སྟེ།",
    "ཐུགས་བརྩེ་བའི་ཉམས་ཀྱི་འཛུམ་བཞད་དང་བཅས་ཕྱག་སོར་པད་མོའི་འདབ་སྟོང་ཕྲན་གྱི་སྤྱི་བོར་བཞག་སྟེ།",
    "ཕྲན་བྱིས་པ་བསམ་མེད་དུ་སོང་རྐྱེན་སེམས་ལ་སྐྲག་སྣང་སྐྱེས་པ་ཙམ་མ་གཏོགས།",
    "གསུང་གི་བདུད་རྩི་རྣ་བའི་བུ་གར་མ་སོང་།",
    "སྒྲོལ་དཀར་འོད་ཟེར་དྲུག་སྦྲགས་ཐུན་མོང་མ་ཡིན་པ།",
    "ལྷ་མོ་དམག་ཟོར་མ་རྣམས་ཀྱི་རྗེས་གནང་དང་།",
    "སྐབས་དེར་མཱ་པུ་ཧྥང་གིས་བཀག་འགོག་བྱས་ཏེ་གནང་བ་མ་ཐོབ་པའི་རྐྱེན།",
    "དེ་ནས་གཉན་ཐོག་བཀྲ་ཤིས་དར་རྒྱས་གླིང་གི་སྐྱ་སེར་ཐུན་མོང་ནས་གདན་དྲངས་པ་རྟར་གཉན་ཐོག་དགོན་དུ་བྱོན།",
    "ལྕམ་སྲིང་གི་རྗེས་གནང་།",
    "ཀླུ་སྒྲུབ་ཀྱི་ལྟ་བ་ལ་མི་མོས་མཁན་འདྲས་དེ་འདྲ་ཟེར་སྲིད།",
    "ཁོང་གིས་ཀྱང་།",
    "ཧོར་ནག་དང་ཆུ་མ་སོགས་ཀྱི་དམངས་ཚོགས་ཡོངས་ཀྱི་རེ་བ་ལྟར།",
    "ཉིད་ཀྱི་དབུ་ལོ་བུབས་གཅིགཕྱག་ཕྲེང་གཅིག་ན་བཟའ་བྱིན་རྟེན་འགངས་ཆེན་མང་བོ་སོགས་རིང་བསྲེལ་རྣམ་བཞིས་གང་བའི་གསང་བདག་འཁོར་ཆེན་ཀྱི་སྐུ་བརྙན་ཕྱག་ཁྲུ་གང་གི་ཚད་ཅན་ཞིག་གནང་བ་དང་འབྲེལ་འཁོར་ཆེན་གྱི་སྐུ་འབུམ་བཅུ་ཕྲག་གཅིག་བླུག་སྟེ།",
    "དེའི་ཚེ་བུམ་ནང་གི་བུམ་ཆུ་འཕེལ་ཏེ་བུམ་པའི་ཕྱི་རོལ་དང་མཆོད་ཁྲིའི་སྟེང་བླུད་པ་དང་།",
    "ངེས་པར་དུ་ཁྱོད་དང་འཕྲད་ཐུབ།",
    "ཨ་མྱེས་དཔལ་རྒྱལ་གྱིས།",
    "དེ་ཡང་ཆོག་ཁྱོད་ལ་དད་པའི་ཨ་ལོང་ཡོད་ན།"
  ]
