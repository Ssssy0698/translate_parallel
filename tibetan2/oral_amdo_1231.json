    "ཐུབ་པ་ཉོན་མོངས་དག་གཟིགས་ཀྱི།",
    "ཉོན་མོངས་དང་འབྲེལ་གང་ཟག་མིན།",
    "མཐར་ཐུག་གི་བདེ་བ་ལ་འགོད་པའི་གཞན་དོན་འབའ་ཞིག་ལྷུར་ལེན་པ་ནི།",
    "རྟ་མགྲིན་དང་ལྷ་མོའི་རྗེས་གནང་།",
    "རང་བསྟན་ལང་ཚོ་རྫོགས་ལ་མངོན་ཆགས་ནས།",
    "མོས་པའི་དབྱངས་ལྡན་བྲུ་མ་རས།",
    "ཁྱོད་ཡོན་པད་མའི་དགའ་ཚལ་དུ།",
    "བསྟོད་བསྔགས་སྙན་པའི་རོལ་མོ་འཁྲོལ།",
    "ཕྱོགས་ཀྱི་བུ་མོའི་འགྲམ་ཆགས་པས།",
    "གངས་ཅན་མཐའ་དབུས་ནོར་འཛིན་ཁྱོན་ཀུན་ཁྱབ།",
    "གཞན་ལུང་ཕྲན་འགའ་རེ་སྩལ།",
    "གཙུག་ལག་ཁང་གི་དབུས་ཀྱི་ཐོག་བརྩེགས་སྟེང་མའི་དབུས་ཀྱི་གྲྭ་མིག་ཏུ་རྒྱལ་བ་བྱམས་པའི་སྐུ་བརྙན་ཞིག་བཞུགས་པ་ལ།",
    "འདུ་ཁང་སྒོ་ཆེན་གྱི་དབུས་ནས་སྙན་དར་རིང་མོ་ཞིག་རྒྱུངས་ཏེ་འཕངས་པ་རྒྱལ་བ་བྱམས་པའི་སྙན་གཡས་པའི་ཐད་ཀྱི་དབུ་རྒྱུན་གྱི་སྟེང་དུ་ཕོག་སྟེ་སྙན་དར་ཅོད་པན་གྱི་ཚུལ་དུ་ལེགས་པར་དཔྱངས་པ་ལ།",
    "བཀུར་གཟོ་རྒྱུ་ཆེན་པོས་བསྙེན་བཀུར་ཞབས་ཏོག་ཕུན་སུམ་ཚོགས་པ་ཞུས་པའི་ཐོག་བླ་དཔོན་སྤྱི་འབངས་ཐུན་མོང་ནས་གསོལ་བ་བཏབ་པར་བརྟེན།",
    "གཞི་བྱེས་ཀྱི་སེར་སྐྱ་ཕོ་མོ་ཁྲི་ཕྲག་ལྷག་འདུས་པར།",
    "བླ་སློབ་ཐམས་ཅད་ཀྱིས་ཚོགས་ཀྱི་འཁོར་ལོ་ལ་རོལ་ཅིང་ཚོགས་པ་ཐམས་ཅད་གསང་ཆེན་རྡོ་རྗེ་རིགས་གཅིག་ཏུ།",
    "རག་གི་དངོས་འབུལ་གྱི་རྣམ་གྲངས་བསྟར་བ་རྗེ་ཉིད་ནས་བསྔོ་སྨོན་རྣམ་པར་དག་པས་མཚམས་སྦྱར་གནང་རྗེས།",
    "དེ་ནས་ཨ་རིག་བཙན་དགུས་གཙོ་བྱས་ཨ་རིག་དུད་ཁྱིམ་བརྒྱད་བརྒྱ་ལྷག་ཡོད་པ་ཐམས་ཅད་ཀྱིས་རེ་འདོད་ཞུས་པ་ལྟར།",
    "སོ་སོའི་མོས་འདོད་བཞིན་གཡང་འབོད།",
    "གཟུངས་སྔགས་ཟབ་མོ་སྣ་ཚོགས་ཀྱི་ལྗགས་ལུང་དང་།",
    "མཐོང་ཐོས་དྲན་རེག་གི་སྒོ་ནས་ཐམས་ཅད་སྨིན་གྲོལ་གྱི་ལམ་ལ་བཀོད་པ་དང་།",
    "དེ་དག་སོ་སོས་ཀྱང་ཕུ་དུད་བསམ་གྱིས་མི་ཁྱབ་པའི་ཞབས་ཏོག་དང་བསྙེན་བཀུར་རང་ནུས་དང་བསྟུན་པ་ཞུས་པའི་འབྲེལ་ཐོགས་ཐམས་ཅད་དོན་ལྡན་དུ་བྱས་ཏེ་སྐྱེ་དགུ་ཡོངས་ཀྱི་རེ་བའི་འབྲས་བུ་སྨིན་པར་མཛད།",
    "རྗེས་མར་ཁྱོད་རང་བྱུང་ཕྱོགས་ཤམྦྷ་ལར་སྐྱེ་ངེས་ཡིན་ཞེས།",
    "བརྩེ་གཟིགས་ཆེན་པོའི་ངང་སྡུག་བསྔལ་ལས་དབུགས་དབྱུང་བའི་གསུང་ཚངས་པའི་དབྱངས་ལྟ་བུ་སྩལ།",
    "མི་རིང་བར་ཁོ་བོ་འདས་རྗེས་སུ་རྗེ་ཉིད་སྐུ་དངོས་ཕེབས་ཀྱིས་ངན་སོང་དགུག་བྲལ་གྱི་ཆོ་ག་དང་འབྲེལ།",
    "བསྟན་པ་དང་འགྲོ་བའི་དོན་རླབས་པོ་ཆེ་མཐའ་དག་ཐུགས་བཞེས་དང་ཐུགས་སྨོན་ཇི་ལྟ་བ་བཞིན་དུ་འགྲུབ་པ་ཀུན་གྱི་ཐུན་སྣང་དུ་གྱུར་པ་འདི་དག་ནི་ཉེ་བར་མཚོན་པ་ཙམ་མོ།",
    "བདེ་མཆོག་གི་སྔགས་བཏུའི་རྗེས་གནང་།",
    "ངེད་ཀྱི་བཞོན་རྟ་ཤི་སོང་བ་རྨིས་པས་ངེད་ལ་ཅུང་ཟད་མི་ལེགས་པའི་ཚུལ་གསུངས་པརཞབས་འབྲང་བ་རྣམས་ཀྱིས་ཞབས་བརྟན་དང་རིམ་གྲོ་ཅི་འདྲ་ཞིག་གིས་མཚན་ལྟས་ངན་པ་བཟློག་པའི་ཐབས་ཤིག་ངེས་པར་གནང་དགོས་ཞེས་ནན་ཞུ་མཛད་ཀྱང་།",
    "དེ་དུས་བླ་བྲང་ཕྱོགས་སུ་བསྡད་ཡོད་པ་དེར་འབོད་པ་བཏང་སྟེ་མྱུར་མོར་འདིར་འོང་དུ་འཇུག་དགོསཁོ་རང་འདིར་ཡོང་ཁར་ཡ་རྫིའི་མཁར་དམར་ན་བཞུགས་པའི་ཐུགས་རྗེ་ཆེན་པོ།",
    "རྟེན་རེ་རེ་ཐུགས་སྨོན་དང་བཅས་དབུ་གཏུག་ཡུན་རིང་ཙམ་གནང་རྗེས།",
    "མཇུག་ཏུ་བདེ་མཆོག་གི་ཤིས་བརྗོད་རྒྱས་པ་བཅས་གནང་།",
    "མེ་ཏོག་གི་འདབ་མའི་དབྱིབས་ཅན་གྱི་ཁ་ཆར་འདྲེས་མ་ཞིག་ཡུད་ཙམ་བབས་རྗེས།",
    "སྤྲིན་གསེབ་ནས་ཉི་མའི་འོད་ཟེར་དང་བཅས་འཇའ་ཚོན་སྣ་ལྔའི་རི་མོ་ཉིས་རིམ་ཞིག་གནས་རིའི་རྩེ་ནས་དམིགས་བརྩེ་མའི་རིའི་སྒང་དུ་ཟུག་པ་ཀུན་གྱིས་མཐོང་བས།",
    "ཉེ་སྔོན་རྗེ་ཉིད་དམིགས་བརྩེ་མའི་སྒང་དུ་བཞུགས་སའི་ཐད་ཀྱི་གནས་རིའི་བྲག་ངོས་ལ་རྗེ་ཉིད་ཀྱི་སྐུ་ཤིན་ཏུ་གསལ་བོ་ན་བཟའི་ཁ་དོག་དང་བཅས་པ་གསལ་བོར་ལྷ་བཟོ་མཁས་པས་རི་མོ་བྲིས་པ་ལྟ་བུ་ཞིག་བབས་འདུག་ཅེས་ཐམས་ཅད་ཀྱིས་མགྲིན་གཅིག་ཏུ་གླེང་བཞིན་པ་ཐོས་པས།",
    "བསྟན་པ་ཉམས་གསོ་རེ་བྱུང་ན།",
    "ཁོ་ཚོའི་སེམས་ལ་དྲན་པ་རེ་བྱུང་ཚེ་གནས་འདིར་སླར་ཡང་།",
    "གང་ལ་རང་གི་ཤེས་རབ་མེད།",
    "གནས་སྒོའི་མདུན་དུ་བདེ་མཆོག་གི་ཚོགས་འཁོར་རྒྱས་པ་ཤིས་བརྗོད་དང་བཅས་ཏེ་གསུངས།",
    "རྗེ་རང་གི་སྐུ་བརྙན་རང་བྱོན་གྱི་ཐད་དུ་ཕེབས་པར།",
    "ཁྱོད་ཚོས་སྒྲོ་འདོགས་སྣ་ཚོགས་ཀྱིས་ངའི་གཟུགས་བརྙན་བྲག་དངོས་སུ་བབས་ཡོད་ཟེར་བ་དེ་རྫུན་རེད།",
    "ཅེས་ཁེངས་སྐྱུང་གི་གསུང་འགའ་ཕེབས་རྗེས་སུ།",
    "གང་ལ་མོས་པ་གཙོ་བྱས་ན།",
    "རེབ་གོང་ཕྱོགས་ནས་ཀྱང་རོང་བོ་དགོན་ཆེན་གཙོས།",
    "རེབ་གོང་རི་ཁྲོད་པ་ཡོངས་རྫོགས་ནས་སེང་གདོང་དུང་ཕྱུར་སོགས་ཞབས་རིམ་གཏོས་ཆེན་སྒྲུབ།",
    "རོང་བོའི་གྲྭ་ཚང་གིས་པུ་ཏྲའི་བསྐང་གསོལ་ཁྲི་སོགས་བཏང་བར།",
    "རྗེ་ཉིད་ཁོ་ནར་རེ་ན་བདག་ཅག་ལ་སོགས་པའི་ཞབས་འབྲང་བ་རྣམས་དང་ལྟོས་འཆའ་བའི་འགྲོ་བ་འདི་དག་ངལ་བ་དོན་མེད་དུ་གྱུར་ཏེ་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོའི་ནང་དུ་ལྷུང་བར་འགྱུར་བ་དང་།",
    "ཞེས་ཁྱོད་ཀྱིས་ནན་ཞུ་གྱིས་ཤིག་ཅེས་ཟེར་ནས།",
    "ཁོ་རང་གར་སོང་ཆ་མེད་དུ་གྱུར།",
