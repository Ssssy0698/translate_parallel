    "སྦྲུལ་གྱི་གཟུགས་བྲིས་ནས་ལག་པས་ཟས་གང་ལ་རེག་པ་དེ་དུག་ཏུ་འགྱུར་རོ།",
    "ཤུ་ད་ག་དངའུརྒྱ་སྤོས་སུ་རི་ལུ་བྱས་ཏེ་ཟོས་ན་དུག་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་འཐུངས་ཀྱང་དུག་གིས་ཚུགས་པར་མི་འགྱུར་རོ།",
    "སྦལ་པ་མགོ་གཉིས་པ་དང་སྦྲུལ་མགོ་གཉིས་པའི་ཞག་གི་ནང་དུ་བ་རུ་ར་བསྐོལ་བའི་ཁུ་བ་དང་ཆ་སྙོམས་༡པ་ལག་པར་བྱུགས་ནས་ཟས་གང་ཡང་རུང་བ་༡བྱིན་པ་དེས་དུག་ཞི་བར་འགྱུར་རོ།",
    "བསྐྲད་ཀྱང་འབྱེར་བརབྱེད་དོ་། རྟ་རྨིག་གི་སྦལ་པར་སྦྲུལ་གྱི་མགོ་དང་ཁྱི་སྨྱོན་པའི་ལྕེ་བཅུག་ནས་དགྲ་བོའི་སྒོར་སྦས་ན་བསྐྲད་པར་འགྱུར་ར་རོ།",
    "མགྲིན་རིངས་ཀྱི་རུས་པ་ནི་རྔ་མོང་གི་རུས་པའོ།",
    "ལྷའི་མིག་གི་མངོན་ཤེས་སྐྱེད་པའི་སྦྱོར་བ་ནི།་",
    "བ་སེར་མོའི་འོ་མ་དང་གི་ཝང་ཡོད་པའི་མིག་དང་སྦྱར་ཏེ།",
    "ཆུ་སྦྲུལ་གྱི་ཁྲག་གིས་ཁ་བཀང་སྟེ་ཆུའི་ནང་དུ་ཞུགས་ན་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་ཆུས་གཤེར་བར་མི་འགྱུར་རོ།",
    "སྐྱེ་གཉིས་ཏེ་ཁུ་བྱུག་དང་བྱི་ལ་༡དང་སྤྲེའུ་དང་ཁྲ་དང་འུག་པ་དང་སྲ་༢མོའི་སྤུ་རྣམས་ཕྱེ་༢མར་བྱས་ཏེ།",
    "སྤྱང་ཀིའི་མཇུག་མ་དང་བྱ་རོག་གི་གཤོག་པ་གཡས་པའི་སྒྲོ་མལ་སྟན་གྱི་འོག་ཏུ་བཅུག་ནས་བཞག་ན་ཡུན་རིང་པོ་མི་ཐོགས་པར་གདོན་གྱིས་ཟིན་པར་འགྱུར་རོ།",
    "གསེར་ཤིང་གི་འབྲས་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གོ་སླའོ།",
    "གསེར་ཤིང་གི་འབྲས་བུ་ལ་སོགས་པའི་སྒྲས་ནི་མ་དུ་ལུང་ག་ད་ང་ཕུག་རོན་དང་རྨ་བྱ་དང་ཁྱིམ་བྱའི་ཤ་རྣམས་བསྡུའོ།",
    "ཡང་སྐྲོད་པ་གསུངས་པ་ནི་མར་ནག་གིས་ལག་པ་བྱུགས་༐",
    "ལ་པི་ཙུ་མར་ད་ཞེས་བྱ་བ་ནི་མ་པའི་ཤིང་གི་བྱེ་བྲག་དང་ཁྭའི་ཚང་གི་ཤིང་ལ་བྱུགས་ཏེ་དུར་ཁྲོད་ཀྱི་སོལ་བ་ལ་བསྲེགས་ནས་ཐལ་བས་གང་གི་བཟའ་བཏུང་ལ་སྦྱར་བའམ།",
    "གཅེར་བུའི་སྐྲ་གསེར་ཤིང་གི་མེ་མདག་དུ་བ་མེད་པ་ལ་བསྲེགས་པའི་ཐལ་བར་༡སྐྱེས་པ་དང་བུད་མེད་ཀྱི་མལ་སྟན་གྱི་འོག་ཏུ་མ་ཚོར་བར་བཅུག་ན་དབྱེ་བར་འགྱུར་རོ།",
    "ཅི་སྟེ་འགུགས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཁྱི་མོ་ནག་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གོ་སླའོ།",
    "བུད་མེད་དང་སྐྱེས་པའི་མིང་ཅན་ནི་སྐྱེས་པ་དང་བུད་མེད་ཀྱི་ཐོད་པར་ཨ་མྲ་ལ་སོགས་པ་བསྐྱེད་པའོ།",
    "བིན་ནུ་ཀནྟ་ནི་ཁྱབ་འཇུག་གི་སྤོས་ས་སོ།",
    "རང་གི་ཁྲག་ནི་སྲིན་ལག་གཡོན་པའི་འི་འོ།",
    "རོ་ཙ་ནི་གི་ཝང་སེར་པོའོ།",
    "ཁྱབ་འཇུག་གི་འཁོར་ལོ་ནི་གྲེས་མའི་མེ་ཏོག་སྔོན་པོའོ།",
    "ལྷམ་བུ་ཆུ་གཤེར་ནི་སྲོག་ཆགས་ཕྲ་མོ་དམར་པོའོ།",
    "པིཋྞུ་ཀནྡ་ནི་ཁྱབ་འཇུག་གི་སྤོས་ས་སོ།",
    "ནན་ཏ་ཀི་ཏ་ནི་ལྷའི་སྲིན་བུའོ་། ཀུ་ད་ར་ཙ་ནི་ཐལ་ཀ་རྡོ་རྗེའོ།",
    "སརྫརས་ནི་རྒྱ་ཤུག་གི་ཐང་ཆུའོ།",
    "ཤ་ཆེན་གྱི་ཞག་ལ་སོགས་པ་ནི་འདི་རྣམས་བྱ་རྒོད་ཀྱི་པགས་པར་ཟླ་བ་དྲུག་གཏུམས་༢ནས་བྱ་རྒོད་ཀྱི་རྐང་གི་སྦུ་གུར་བཅུག་སྟེ་མིརུས་ཀྱི་ཕྱེ་མས་མིག་ལ་བྱུགས་ན་གཏེར་ཤེས་པར་འགྱུར་རོ།",
    "གང་གིས་སྒྲུབ་པ་པོ་འགྲུབ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་དྲོན་མོའི་གཞི་ལ་ཡང་དང་ཡང་དུ་མཉེས་ནས་ཞེས་བྱ་བ་ནི་སྟེང་གི་༐",
    "ལྕགས་ཕྱེ་ནི་ཟེ་སྨུག་གི་ཕྱེའོ་༤། བ་ཀུ་ལ་ནི་མེ་ཏོག་ལེ་བརྒན་ན་ནོ།",
    "ཀུན་དུ་རུ་ནི་སྙོམས་འཇུག་གི་བརྡའོ།",
    "དུས་དྲུག་ཏུ་གང་བཟའ་སྙམ་ན་མཚན་ཕྱེད་ནི་རང་བྱུང་གི་མེ་ཏོག་ག་གོ།",
    "ཉིན་ཕྱེད་རང་གི་ཁྲག་ག་གོ།",
    "སྲོད་ལ་རྐང་གི་ཞག་བཟའ་བའོ།",
    "སྲོད་ལ་རྐང་གིས་བསྣན་པ་དང་།",
    "ཕྱེད་ན་རང་བྱུང་གི་མེ་ཏོག་གིས་བསྣན་པ་བཟའ་བ་ནི་ནང་གི་བཅུད་ལེན་ཞེས་བྱ་བའོ།",
    "གང་གིས་རྟག་ཏུ་མཉམ་འཇོག་པ་ནི།་",
    "བསྐྱེད་རྫོགས་ཀྱི་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་ནས་ཡིད་བདེ་བའི་སེམས་རྩེ་གཅིག་པས་ནང་གི་བཅུད་ལེན་བསྟེན་ན་འབྲས་བུ་རྒ་བ་དང་འཆི་བ་ལ་སོགས་པ་ལས་གྲོལ་བར་འགྱུར་རོ།",
    "ཉིན་མོའི་དུས་གསུམ་དུ་བདུད་རྩི་ཆ་དྲུག་པོ་དུས་གང་དང་གང་ཡིན་པ་དེ་དང་དེར་བསྣན་ནས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་བཟའ་ཞིང་ལས་བྱ་བ་ཡིན་ནོ།",
    "འབྲས་བུ་གསུམ་དང་ཡུང་བ་ནག་པོ་ད་ང་རང་སྐྱུར་དང་ཏ་ལ་རྣམས་ཀྱིས་ཆ་རེ་རེ་བསྐྱེད་",
    "མཆོད་བྱེད་ནི་མིང་གི་རྣམ་གྲངས་ཙིཏི་ཞེས་བྱ་བ་དང་།",
    "མཚན་མོ་སྤྱོད་ནི་ཡུང་བའོ།",
    "ལྡུམ་བུ་རེ་རལ་༡དང་།",
    "ན་ཁ་༡ཞེས་པ་ཆུ་སྲིན་གྱི་སེ་ན་མོ་རྣམས་དང་བཅས་པའི་བདུག་པས་དུག་འཇོམས་པར་བྱེད་ལ་གཡན་པ་དང་ལུད་པ་དང་ཤུ་བ་དང་ཡན་ལག་གི་དུག་ཐམས་ཅད་འཇོམས་པར་བྱེད་དོ།",
    "རློན་པས་དེ་ལྟར་འགྱུར་མོད་ཀྱི།",
    "དི་ད་ག་གི་སྦྱིན་སྲེག་བརྩམ་པར་བྱའོ།",
    "བྱང་དུ་ཁ་བལྟས་ཏེ་དུས་གསུམ་དུ་གྲངས་སྟོང་གི་སྦྱིན་སྲེག་བྱས་ན་ཉི་མ་བདུན་རྫོགས་པའི་འོག་ཏུ་སྦྱིན་བདག་ཆེན་པོར་འགྱུར་ར་རོ།་།",
    "ནཱ་ག་གེ་སར་ལ་སོགས་པའི་རྫས་བསགས་ལ་གུ་གུལ་གྱི་ཤིང་གི་མེ་སྦར་ནས་འདོད་པའི་མེ་ལྷ་དང་།",
    "ཀིམ་ཀའི་འབྲས་བུ་ནག་པོ་ལ་སོགས་ཏེ་བསྲེག་རྫས་དང་རོའི་ཤིང་གི་མེ་སྦར་ལ་དྲག་པོའི་མ་ལྷ་དང་གཤིན་རྗེ་ི་གཤེད་ལ་སོགས་པ་བཞུགས་སུ་གསོལ་ལ།",
    "ཁ་ནུབ་ཏུ་བལྟས་ཏེ་གང་གི་མིང་ནས་བཟུང་སྟེ་སྦྱིན་སྲེག་བྱས་ན་ཉི་མ་བདུན་གྱིས་འཆི་བར་འགྱུར་རོ།",
    "གཤིན་རྗེ་སྟེ་འཆི་བདག་གིས་འཁྲིད་པར་འགྱུར་རོ།",
    "ལས་ཀྱི་ཁྱད་པར་གསུངས་པ་ནི་བསྐྲོད་པར་འདོད་ན་མངོན་སྤྱོད་ཀྱི་ཐབ་ཏུ་ཡུངས་ཀར་ལ་སོགས་པའི་རྫས་རྣམས་དང་མངོན་སྤྱོད་ཀྱི་མེ་ལྷ་དང་གཤིན་རྗེ་ལ་སོགས་པ་བསམས་ནས་བསྲེགས་ན་སྐྲོད་པར་འགྱུར་རོ་། ཡང་ན་བྱ་རོག་གི་ཤ་དང་ཞེས་པ་ནི་བསྐྲོད་༡པ་གཉིས་པ་བསྟན་པ་ཡིན་ཏེ།",
    "གང་གི་མིང་ནས་སྨོས་ཏེ་བསྲེགས་ན་བཅིང་བར་འགྱུར་རོ།",
    "རྒྱས་པའི་ཁྱད་པར་གཉིས་པ་ནི་དེའི་ཐབ་ཏུ་ལྷ་ལ་ཅེ་སྤྱང་གི་ཤ་བརྒྱ་རྩ་བརྒྱད་བསྲེགས་ན་ཟླ་བ་གསུམ་གྱིས་ཕྱུག་པོར་འགྱུར་རོ།",
    "བསད་པའི་ཁྱད་པར་ནི་མངོན་སྤྱོད་ཀྱི་ཐབ་ཏུ་དེའི་ལྷ་ལ་བྱ་རོག་གི་སྒྲོ་རྩ་བའི་མར་གྱིས་བྱུགས་ཏེ་རྒྱའི་ལང་ཏང་གི་མེ་ལ་བསྲེགས་ན་བསྐྲད་པའམ་འཆི་བར་འགྱུར་རོ།",
    "ལྷ་ལ་བྱ་རོག་གི་ཤ་འབའ་ཞིག་༡ལན་སྟོང་དུ་བསྲེགས་པས་རྡོ་རྗེ་སེམས་དཔའ་ཡིན་ཡང་ཉི་མ་གསུམ་གྱིས་འབྲོས་པར་འགྱུར་རོ།",
    "བསྐྲད་པ་ལྔ་པ་ནི་བྱ་རོག་གི་ཤ་དང་བྱིན་ལག་གི་ཤ་དང་ད་དུ་རའི་མེ་ལ་བསྲེགས་ན་དེ་དང་འདྲའོ།",
    "ཞེས་པ་ནི་གསུང་གི་དཔའ་བོའི་ཡིག་༡འབྲུ་བཏུ་བའོ།",
    "རྫ་ཇའི་དབྱིབས་ཀྱི་རེ་མིག་ལ་ཡི་གེ་བཞི་བཅུ་༐",
    "གཞལ་ཡས་ཁང་གི་ད་བུས་སུ་རེ་མིག་བཞི་བཅུ་རྩ་དགུའི་དཀྱིལ་འཁོར་དབྱངས་དང་གསལ་བྱེད་ཀྱི་ཕྱི་མོ་དགོད་པའོ།",
    "མིང་གིས་བཏུ་བ་དང་།",
    "ཡན་ལག་གི་སྔགས་བཏུ་བ་དང་།",
    "གསུམ་པ་གོས་དཀར་མོའི་སྔགས་ནི་གཉིས་པའི་དང་པོ་ཀའོ།",
    "བདེ་མཆོག་གི་རྩ་བའི་སྔགས་ཅིའི་ཕྱིར་དོན་ཡོད་གྲུབ་པའི་སྔགས་སུ་འགྱུར་ཞེ་ན།",
    "དང་པོར་རྣམ་པར་སྣང་མཛད་ནི་ཨོཾ་མོ།",
    "སྟོང་པས་མནན་པ་ནི་ཨཾ་མོ།",
    "ཧཱུཾ་འོད་དམར་པོ་དང་ལྡན་པའི་མཐར་སྭཱ་ཧཱ་དང་བཅས་པའི་འབུམ་བཟླས་ན་ལྷ་མ་ཡིན་གྱི་བུ་མོ་ཐིག་ལེ་མཆོག་ལ་སོགས་པ་ཡང་འགུགས་པར་བྱེད་དོ།",
    "ཡི་གེ་ཧཱུཾ་གི་རྗེས་ལ་མཐར་སྭཱ་ཧཱ་དང་༢བཅས་པས་འབུམ་བཟླས་ན་ལྷ་དང་མིར་བཅས་པ་གསོད་པར་བྱེད་དོ།",
    "དང་པོར་གཏི་མུག་གི་རིགས་ནི་ཨོཾ་མོ།",
    "མེ་དང་ཞེས་བྱ་བ་ནི་ཨོཾ་དང་སྦྱར་བས་ཧྲཾ་༤མོ་།",
    "རིག་བྱེད་རྣམས་ཀྱི་དང་པོ་ནི་ཨོཾ་མོ།",
    "པའི་མཆོག་གི་བྱ་བ་དེ་ཉིད་ཚོགས་འཁོར་གྱི་དཀྱིལ་འཁོར་ལྟར་༡རྟོགས་པར་བྱའོ།",
    "དེའི་དབུས་ཀྱི་ལྟེ་བ་ལ་༢ལྔ་པའི་དང་པོ་ཏ་ལ་ཟླ་བ་ཕྱེད་པ་དང་ཐིག་ལེ་སྟེ་ཨཾ་གིས་མཚན་པའི་ཆེ་གེ་མོ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་དང་སྤེལ་བར་བྱའོ།",
    "གསུམ་པ་ཨུཏྤ་ལ་ལྔའི་སྟེང་དུ་འཁོར་ལོ་རྩིབས་དྲུག་པ་བྲིས་ལ་དབུས་ཀྱི་ལྟེ་བ་ལ་ཆེ་གེ་མོ་བ་ཤཾ་ཀུ་རུ་ཧོ།",
    "ལྔ་པ་པདྨ་ལྟ་བུའི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་ལ་ཆེ་གེ་མོ་ཞེས་བྱ་བ་བྲིས་ཏེ།",
    "དབུས་སུ་ཆེ་གེ་མོ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་ཡུང་བའི་ཁུ་བས་བྲིས་ཏེ་ལེགས་པར་ཁ་ཐུར་དུ་བཞག་ན་འཆིང་བར་འགྱུར་ར་རོ།",
    "༡དྲུག་པ་འཁོར་ལོ་དེ་ཉིད་ལ་ཧཱུཾ་ཆེ་གེ་མོ་ཧཱུཾ་ཕཊ་ཅེས་བྱ་བ་དང་སྤེལ་ཏེ་རྩིབས་བརྒྱད་ལ་བཀོད་ལ་ཐོད་པ་ལ་མི་རུས་ཀྱི་སྨྱུ་གུས་དུག་དང་ཁྲག་དང་སྐྱེ་ཚེ་དང་བཅས་པས་བྲིས་ལ་དུར་ཁྲོད་དུ་སྦས་པས་འཆི་བར་འགྱུར་རོ།",
    "བདུན་པ་འཁོར་ལོ་དེ་ཉིད་ལ་ཆེ་གེ་མོ་ཨོཾ་ཞེས་པ་དང་སྤེལ་ཏེ་གྲོ་ག་ལ་གུར་གུམ་གྱིས་བྲིས་ན་བརྒྱལ་བར་འགྱུར་ར་རོ་། བརྒྱད་པ་ནི་འཁོར་ལོ་དེ་ཉིད་ལ་ཆེ་གེ་མོ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་དང་སྤེལ་ཏེ་བྲིས་ན་བསྲུང་བར་འགྱུར་རོ།",
    "བཅུ་པ་ནི་འཁོར་ལོ་དེ་ཉིད་ལ་དབུས་སུ་ཡི་གེ་ཨ་ཆེན་པོ་གཅིག་གི་ནང་དུ་ཆེ་གེ་མོ་ཧོ་ཞེས་པ་བྲིས་ཏེ་དེའི་ཕྱོགས་བཞིར་ཧཱུཾ་བཞི་དང་།",
    "དབུས་སུ་ཧྲཱི་ཆེ་གེ་མོ་ཞེས་བྱ་བ་བྲིས་ཏེ།",
    "སེན་རྩིའམ་༤གི་ཝང་གིས་གྲོ་ག་ལ་བྲིས་ཏེ་འཁོར་ལོ་གཅིག་རང་གིས་བཅངས་ཤིང་།་",
    "སརྦ་མོ་ཧ་ཞེས་པ་ལ་སོགས་པའོ།",
    "འཁོར་ཁོ་བཅུ་གཅིག་པོ་དེ་ཐམས་ཅད་མཐར་ཨུཏྤལ་དང་པོ་བཞིན་དུ་བརྒྱན་པ་ནི་ཐུན་མོང་མ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དབུས་སུ་ཆེ་གེ་མོ་ཧྲཱི་ཞེས་གི་ཝང་གིས་བྲིས་ན་སྐལ་བ་བཟང་པོར་འགྱུར་རོ།",
    "བཅུ་བཞི་པ་ལ་པདྨ་འདབ་བརྒྱད་པའི་དབུས་སུ་ཨོཾ་བྲིས་ལ་ཕྱི་རོལ་དུ་རི་མོ་ཟླུམ་པོས་བསྐོར་ལ་དེའི་ཕྱི་རོལ་དུ་རྡོ་རྗེ་རྩེ་གསུམ་པ་བརྒྱད་ཀྱིས་བསྐོར་བ་གུར་ཀུམ་གྱིས་བྲིས་ནས་དཔུང་བར་བཏགས་ན་བསྲུང་བར་འགྱུར་རོ།",
    "བཅུ་དྲུག་པ་ལ་ཨེའི་༢དཀྱིལ་འཁོར་སུམ་བརྩེགས་བྲིས་པ་ཟུར་གསུམ་ལ་ཨོཾ་ག་ཧཱུཾ་ཟུར་གཉིས་པ་ཧཱུཾ་ག་ཧཱུཾ་གསུམ་པར་ཧཱུཾ་ག་ཕཊ་འོག་གི་གྲུ་གསུམ་དུ་ཧཱུཾ་ག་ཧཱུཾ་ཏྲི་དང་དབུས་སུ་ཧཱུཾ་ག་ཧཱཱུུུཾ་ཞེས་བྱ་བས་དུག་དང་ཁྲག་ལ་སོགས་པས་བུད་མེད་ཀྱི་སྨད་གཤམ་ལ་བྲིས་ལ་ཁྲོ་བོ་སྟོབས་པོ་ཆེའི་སྔགས་ཀྱིས་ཕྱི་རོལ་ནས་བསྐོར་བ་བྲིས་ན་དགྲ་བོ་ཐམས་ཅད་བཅོམ་པར་འགྱུར་རོ།",
    "ནུབ་ཏུ་ཨོཾ་མོ་ཧ་མོ་ཧ་ནི་སྭཱ་ཧཱ།",
    "དེའི་དབུས་སུ་ཡི་གེ་མཱཾ་ཆེན་པོ་དེའི་དབུས་སུ་ཆེ་གེ་མོ་རཀྵ་ཞེས་བྱ་བས་བསྲུང་བར་འགྱུར་རོ།",
    "ཉི་ཤུ་པ་ནི་འཁྲུལ་འཁོར་གྱི་རྟེན་སྐྱེས་བུའི་གཟུགསཀ་༢སྐྲ་གྲོལ་བ་ལ་རྣ་ཆ་གཉིས་ལ་སྣ་ཚོགས་རྡོ་རྗེ་ཧཾ་གིས་མཚན་པ།",
    "སྤྱི་གཙུག་གི་ནོར་བུ་ལ་ཧཾ་གིས་མཚན་པའི་རྡོ་རྗེ་རྩེ་གསུམ་པ།",
    "ཉི་ཤུ་གཅིག་པའི་རི་རབ་ཀྱི་རྩེ་མོར་རྡོ་རྗེ་རྩེ་གསུམ་པ་རྒྱ་གྲམ་བྲིས་ལ་རི་རབ་ཀྱི་ཟུར་བརྒྱད་དུ་ཧཱུཾ་ནི་ཧཱུཾ་བརྒྱད་བྲིས་ལ་བར་དུ་ཨ་ལ་༡དང་།་",
    "དེའི་དབུས་སུ་རི་མོ་ཟླུམ་པོས་བསྐོར་བ་བྲིས་ལ།་",
    "ཉི་ཤུ་རྩ་བཞི་པ་ནི་བྷ་ག་ལིངྒས་མཚན་པ་བྲིས་ལ་དབུས་སུ་མིང་གི་ཡི་གེ་ཧྲཱི་དཀར་པོས་བསྐོར་བ་བྲིས་ན་གང་འདོད་པའི་བུ་མོ་འགུགས་པར་འགྱུར་རོ།",
    "དབུས་སུ་ཟླ་བ་གང་བ་ལ་༡ཆེ་གེ་མོས་བུ་རྙེད་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་དང་།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་ལྟེ་བ་ལ་༢ཨོཾ་མ་ཎི་ངྷ་རི་མ་ཧཱ་པྲ་ཏི་ས་རེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་༢སྭཱ་ཧཱ།",
    "འཁོར་ལོ་རྩིབས་བརྒྱད་པའི་ཕྱི་རོལ་གྱི་ཟླ་བ་ལ་ཨོཾ་ཨ་མྲྀ་ཏ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་ཀྱིས་བསྐོར་བར་བྱ་སྟེ།",
    "དེ་ཡང་རྒྱལ་གྱི་ཉིན་པར་གུར་ཀུམ་དང་གི་ཝང་གིས་གྲོ་ག་ལ་བྲིས་ཏེ་བཅིངས་ན་བུ་རྙེད་པར་འགྱུར་རོ།",
    "ཉི་ཤུ་རྩ་དྲུག་པ་ནི་འཁོར་ལོ་ལ་བུམ་པའི་གཟུགས་བྲིས་ལ་དེའི་མགྲིན་པ་ལ་ཡི་བྷ་ཡ་ངྷ་ཡ་ཏ་ཡ་མུ་ཡ་ཙ་ཡ་ཏ་ཡ་ཞེས་བྱ་བའི་སྔགས་ཀྱི་ཡི་གེ་བསྒོམས་ནས་བསད་པའི་རས་ལ་བྱ་རོག་གི་ཁྲག་གིས་རྒྱལ་པོའི་ཁྱིམ་དུ་བྲིས་ནས་བྱ་རོག་གསོན་མའི་སྐེར་བཏགས་ནས་བྱང་ནུབ་ཏུ་སྤུར་ན་མྱུར་དུ་སྐྲོད་པར་འགྱུར་རོ།",
    "ཉི་ཤུ་རྩ་བདུན་པ་ནི་ཉི་མའི་ད་ཀྱིལ་འཁོར་གྱི་དབུས་སུ་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་བྲིས་ལ་རྩིབས་ལ་ཧཱུཾ་བརྒྱད་བཀོད་ནས་ད་བུས་སུ་ཡང་ཉི་མའི་དཀྱིལ་འཁོར་ལ་རྡོ་རྗེའི་ལྟེ་བ་༤ཆེ་གེ་མོ་རཀྵ་ཞེས་བྱ་བ་གུར་ཀུམ་ད་ང་གི་ཝང་གིས་གྲོ་ག་ལ་བྲིས་ན་རྣལ་འབྱོར་པ་དེ་ལ་ཐམས་ཅད་བསྲུང་བར་འགྱུར་རོ།",
    "ཉི་ཤུ་རྩ་བརྒྱད་པ་ནི་བདེ་མཆོག་གི་རོ་མཉམ་གྱི་འཁོར་ལོ་བཞིན་དུ་འདབ་མ་ཉེར་བཞི་པ་བྲིས་ལ།",
    "ཉི་ཤུ་རྩ་དགུ་པ་ནི་རྡོ་རྗེ་དང་པདྨ་ས་བསྐོར་བའི་དབུས་སུ་རྫ་རྔ་ལྟ་བུའི་འཁོར་ལོ་བྲིས་ལ་དེའི་ཕྱི་རོལ་དུ་སྐུ་གསུང་ཐུགས་ཀྱི་འཁོར་ལོ་ཡི་གེ་དང་བཅས་པས་བསྐོར་ནས་རྫ་རྔའི་རེའུ་མིག་བཞི་བཅུ་དགུ་ལ་ཨོཾ་ནས་ཕཊ་ཀྱི་བར་དུ་ཉི་ཤུ་དགུ་པ་བཀོད་ནས་དབུས་ཀྱི་རེའུ་མིག་སྟོང་པ་གཅིག་ལ།་",
    "ལས་བཅུ་གཉིས་གང་ཡང་རུང་བའི་སྔགས་དང་སྤེལ་བའི་མིང་༡ཆེ་གེ་མོ་ཤཱནྟིཾ་ཀུ་རུ་སྭཱ་ཧཱ་ཞེས་པ་ནས་ཆེ་གེ་མོ་མཱ་ར་ཡ་ཕཊ་ཅེས་པའི་སྔགས་ཀྱི་༢ཆོ་ག་མཐོང་བས་བྲིས་པས་འཁྲུལ་འཁོར་གྱི་མཐུས་དགྲ་ཐམས་ཅད་གདུལ་བ་དང་བྱ་བ་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "རེ་རེ་རུ་ནི་ཡང་དག་གནས་ནི་ཡི་གེ་དྲུག་དཔའ་བོ་དྲུག་གི་སྔགས་ས་སོར་གནས་པའོ།",
    "རྡོ་རྗེ་ཕག་མོར་ལྡན་པ་ཡི།",
    "གི་གོ་ཆས་༡བསྲུང་སྟེ་རྡོ་རྗེ་ར་བ་རྣམས་ཕྱོགས་ཕྱོགས་སུ་བཀོད་ལ་ཁྲོ་བོ་མཆེ་བ་གཙིགས་ཤིང་བཞིན་འགྱུར་བས་ཁྱབ་པས་ཁྲོ་བོ་བཅུ་པོ་སྤྲོས་ལ་ཕྱོགས་སྐྱོང་བཅུ་བསྡིགས་ཤིང་ཕུར་བུས་བཏབ་ལ།",
    "སུམ་ཅུ་རྩ་གཅིག་པའི་ཟངས་ཀྱི་འདབ་མ་ལ་སྒོ་མེད་པའི་འཁོར་ལོ་རིམ་པ་གཉིས་པ་ལྟར་དཔའ་བོ་དང་དཔའ་མོའི་སྔགས་བཀོད་ནས་རྒྱལ་གྱི་ཉིན་པར་འཁོར་ལོ་ལ་ཡོན་ཆབ་ཀྱི་ཆུས་གང་བར་བྱས་ཏེ་ཆུའི་ནང་དུ་བཞག་ལ་དུས་གསུམ་དུ་མཆོད་ན་དགྲ་རྣམས་འཆི་བར་འགྱུར་རོ།",
    "སྒོ་བཞི་པ་༤འདོད་ཡོན་གྱི་ལྷ་མོའི་ཁ་ཁྱེར་རྟ་བབས་ཀྱི་གནས་སུ་རྡོ་རྗེས་མཚན་པ་སྒོ་བཞིར་ཤར་དུ་ཐོ་བ་༐",
    "དེའི་དབུས་སུ་པདྨ་བཅུ་པར་ལྟེ་བར་སྔགས་ཀྱི་མཆོག་ཨོཾ་པྲ་སནྟ་རེ་ཞེས་པ་ལ་སོགས་རྭི་པའི་སྔགས་བཀོད་ལ་འདབ་མ་བཅུ་ལ་སྡང་བ་ཟློག་པར་བྱེད་པའི་སྔགས་ཨོཾ་སརྦ་རྨོ་ཧ་ཞེས་པ་ལ་སོགས་པ་དགོད་པར་བྱའོ།",
    "དབུས་སུ་ཆེ་གེ་མོ་སྟཾ་བྷ་ཡ་ལ་སོགས་པ་བྲི་བར་བྱའོ།",
    "རབ་གནས་ཀྱི་ཆོ་ག་དང་ཕྲིན་ལས་ཀྱི་བཟླས་པ་དང་སྦྱིན་སྲེག་གི་ཆོ་ག་ད་ག་བསྟན་དུ་གསོལ་ཞེས་ཞུས་པ་ཡིན་ནོ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་གསུམ་གྱིས་བྱིན་གྱིས་བརླབས་ནས་རྡོ་རྗེ་འཛིན་པའི་རིག་མ་དང་འཁྱུད་པའི་ཕྱག་གིས་པདྨའི་གར་བསྐོར་ལ།",
    "རང་གིས་ལུས་ལས་ཁྲོ་བོའི་ཚོགས་ཕྱུང་༐",
    "སའི་ལྷ་མོ་ཡང་བསྐྲད་དེ་སྙམ་ན།་",
    "དེ་ལྟར་ས་བཟུང་ནས་སའི་ལྷ་མོ་སྤྱན་དྲངས་ནས་ཞེས་སྨོས་ཏེ།",
    "སའི་ལྷ་མོ་སྤྱན་དྲངས་ལ་དཔང་དུ་གསོལ་ཏེ།",
    "དེ་ལ་སྤྱན་དྲངས་པའི་སྔགས་ནི་ཨོཾ་ཨེ་ཧྱེ་ཧི་མ་ཧཱ་དེ་བཱི་པྲྀ་ཐི་བི་ལོ་ཀ་མ་ཧཱ་ཏ་རེ་ཞེས་བྱའོ།",
    "ཞབས་བསིལ་དང་ཡོན་ཆབ་དབུལ་བའི་སྔགས་ནི་ཨོཾ་ས་ཏྲ་རཏྣ་སཾ་པུ་རེ་ཞེས་བྱ་བ་ནས་སྭཱ་ཧཱའི་བར་དུའོ།",
    "སྔགས་འདིས་ལྷག་པར་གནས་པ་ལ་སོགས་པ་བྱས་ཏེ་ཞེས་པ་ནི་སའི་ལྷ་མོ་ལྷག་པར་གནས་པ་དང་།",
    "རྒྱས་པ་ལ་ནི་གར་མཁན་དང་རྒྱལ་རིགས་མ་གོས་དཀར་མོའི་བདག་ཉིད་ཁ་དོག་སེར་མོ་དེ་རྣམས་བཅུག་ལ་སྙིམ་པས་མེ་ཏོག་གཏོར་བར་བྱའོ།",
    "དེ་ལྟར་རིགས་ཀྱི་ད་བྱེ་བས་ཕྱེ་བའི་ཡེ་ཤེས་ལས་སྐྱེས་པའི་ལྷ་མོའམ།",
    "གསང་ཆེན་བྷ་གའི་དཀྱིལ་འཁོར་ལ་ཡང་བཅུ་དྲུག་གི་ཐིག་བཏབ་པར་ཤེས་པར་བྱ་སྟེ།",
    "ཤིན་ཏུ་དམ་ཚིག་དང་ལྡན་པའི་ཕྱག་རྒྱ་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་གྱི་གདན་དུ་གྱུར་པ་དེ་བཞིན་དུ་ནང་གི་མེ་ཐབ་ལ་སོགས་པ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་བསྒྲུབ་པ་ནི་སྦྱིན་སྲེག་གི་འཁྲུལ་འཁོར་གྱིས་སོ།",
    "དེ་ལྟར་སྦྱིན་སྲེག་གི་ཐབས་འབྲས་བུ་དང་བ་ཅས་པ་བརྗོད་ནས།",
    "ཧོམ་ཁུང་གི་ནི་ད་བུས་དག་ཏུ།",
    "གྲུ་མོ་པུས་མོའི་བར་དུ་བཞག།",
    "སྔགས་ནི་ཨོཾ་ཆེ་གེ་མོ་༡ཤཱནྟིཾ་ཀུ་རུ་ཞེས་པ་སྭཱ་ཧཱའི་མཐའ་དང་ལྡན་པར་བྱའོ།",
    "སྦྱིན་སྲེག་གི་༡ཆོ་ག་སྨྱུང་བར་གནས་པར་བྱ་བའམ་སྙམ་ན།",
    "དེ་ལྟར་སྦྱིན་སྲེག་གི་ཆོ་ག་བསྟན་ནས།",
    "འཁོར་ལོ་རབ་ཏུ་བསྐྱེད་པའི་སྒྲུབ་པ་༡བྱའོ་སྙམ་དུ་དགོངས་པའི་ཡེ་ཤེས་རྡོ་རྗེ་ལྟར་མི་ཕྱེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་ཕྱི་དང་ནང་གི་ལས་ཀྱི་འཁོར་ལོ་བསྒྲུབ་པའི་ལྷ་བསྐྱེད་པའི་སྦྱོར་བའི་མན་ངག་༢ཐམས་ཅད་ལས་བསྡུས་ནས་གསུངས་པ་ཡིན་ནོ།",
    "ལྷ་མོ་སྒྲོལ་མ་བདག་ཆེན་མོ།",
    "གལ་ཏེ་འདོད་པའི་གཟུགས་ཅན་མ་ནི་བོང་བུའི་གདོང་པ་ལ་མི་མོས་ན་རིགས་ཀྱི་བདག་པོ་དོན་ཡོད་གྲུབ་པའི་ཞལ་དུ་བྱ་བ་ཡིན་ནོ།",
    "ཞབས་གཡས་རྣམས་ཀྱིས་མི་དང་མ་ཧེ་ཞེས་པ་ལ་སོགས་པ་ནི་སྟེང་གི་ཕྱོགས་སྐྱོང་བ་བརྒྱད་མནན་པའོ།་།",
    "ལྷོ་རུ་མདུང་གིས་ཕུག་པ།",
    "བ་སྤུའི་བུ་ག་ནས་ཁྲོ་བོའི་ཚོགས་དུ་མ་སྤྲོས་ནས་བསྒྲུབ་བྱའི་སྲུང་མ་དང་ལུས་ཟུངས་ཀྱི་དྭངས་མ་དྲངས་པར་བསམ་མོ།",
    "འུག་པ་དང་ཁྲའི་གཤཾོག་པ་ལ་དགྲ་བོ་གཉིས་ཀྱི་མིང་བྲིས་ནས་བྲམ་ཟེ་དང་དགེ་སྦྱོང་གི་སྐྲས་དཀྲིས་ཏེ་༐",
    "བཅུ་དགུ་པ་ཐོག་བཟློག་པ་ནི་ནམ་མཁའི་དབུས་སུ་དཔལ་མཆོག་དང་པོ་ཞལ་གསུམ་ཕྱག་བཞི་ཞབས་བཞི་པ་གོ་རཱི་ལ་སོགས་པ་ལྷ་མོ་བཞིས་བསྐོར་བ།",
    "པྲ་མོ་ཆུ་སྲིན་རྒྱལ་མཚན།་",
    "གཅི་བའི་ནང་དུ་བཅུག་ན་ཉི་ཟླ་རེངས་པར་འགྱུར་ར་རོ།",
    "སྟ་རེའི་གཟུགས་བྱས་ལ་སྔགས་བྱེ་བ་བཟླས་ལ་རང་གི་དཔྲལ་བར་ཐིག་ལེ་བྱས་ན་གང་ལ་ཕྱག་བྱས་པ་དེ་འགས་པར་འགྱུར་རོ།",
    "ཨ་ཕུ་༡ཆོ་ག་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གོ་སླའོ།",
    "ཡང་དག་ཆོ་ག་གང་གིས་ནི།",
    "ཧཱུཾ་གིས་སྲད་བུ་བསྒྲིལ་བ་ཡིན།",
    "ཞེས་པ་ཚིགས་བཅད་གཅིག་གིས་ཞུས་པ་ཡིན་ན་ནོ།",
    "སྤྱི་གཙུག་གི་ཐིག་ལེ་གནས་པའི་རྣམ་པར་ཤེས་པ་ཧིག་གི་ལྕགས་ཀྱུས་དྲངས་ནས་སྤྱི་གཙུག་གི་གནས་སུ་འདྲེན་པར་བྱའོ།",
    "གནས་གང་ལ་ནི་གང་གིས་གནས།",
    "ས་བོན་ནི་ཡི་གེ་བཞག་ནས་དྲག་པོའི་སྒྲའི་ཡི་གེ་ཧིག་གིས་འཕེན་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཉིན་རེ་བྲམ་ཟེ་གསོད་པ་དང་།",
    "ཡི་གེ་ཧཱུཾ་གི་རང་བཞིན་བསྒོམས་ལ།",
    "འཆི་བ་མེད་པ་ནི་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་དང་བྲལ་བ་ཡིན་ན་ནོ།",
    "མཆོག་གི་དངོས་གྲུབ་ཅེས་བྱའོ།་",
    "ཐབས་གང་གིས་དེ་ལྟར་འགྱུར་སྙམ་ན།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་སེམས་ནི་གང་ཟག་གི་བདག་མེད་པར་རྟོགས་ནས་རང་གི་དོན་དུ་རྟོག་མེད་བསྒོམས་པ་ཡིན་ཏེ།",
    "མཆོག་གི་དངོས་གྲུབ་༡གྲོལ་བའི་འབྲས་བུ་ཐོབ་པར་འགྱུར་ར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་གྱི་སྔགས་རྡོ་རྗེ་དྲིལ་བུ་ལ་ཐུག་གི་བར་དུ་གསུངས་པ་དང་།",
    "སྤྱན་ལ་སོགས་པ་ནས་དྲི་མ་ལ་ཐུག་གི་བར་དུ་ཐབས་དང་ཤེས་རབ་ཀྱི་འཁོར་ལོའི་སྔགས་གསུངས་པ་ཡིན་ནོ།",
    "འཁོར་ལོ་བདེ་མཆོག་གི་སྔགས་གསུངས་པ་དང་།",
