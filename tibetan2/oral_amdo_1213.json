    "དེ་ལྟར་བུམ་པ་རྣམས་ཀྱི་ནང་དུ་འོག་གི་སྒྲུབ་ཐབས་ཀྱི་རིམ་པ་ལྟར་གཟུགས་བཅུག་སྟེ་འབྲུ་སྣ་ཚོགས་ཀྱིས་ལེགས་པར་བཀང་ལ་རྫ་འདམ་སོགས་ཀྱིས་ཁ་བཅད་ལ་དེ་དག་སྟེགས་ཀྱི་ཁར་གཞི་གཙང་མ་ལ་པདྨ་འདབ་བརྒྱད་ལྟེ་བ་དང་བཅས་པར་བུམ་པ་དགུ་གོ་རིམ་བཞིན་བཀོད་པ་འམ།",
    "བུམ་པ་གཅིག་ལས་མེད་ན་དེ་བསྟུན་གྱིས་གཅིག་གི་ལྟེ་བར་བཀོད།",
    "རང་ཉིད་སྐད་ཅིག་གིས་ཁྲོ་བོ་འཇིག་རྟེན་གསུམ་རྒྱལ་གྱི་སྐུར་བསྒྱུར་ནས་བགེགས་གཏོར་སྤྱི་འགྲོ་ལྟར་གཏོང་ངོ།",
    "ན་མོ་གུ་རུ་བྷུན་མོ་ཏ་ཐཱ་ག་ཏཱ་བྷ་ག་ཝན་ནཱ་ག་རཱ་ཛེ་ཤུ་རེ་ཨོཾ་བཛྲ་པུཥྛ་པྲ་ཏཱི་ཙྪ་ཨཱ་ཧཱུྃ་ནས།",
    "ཧཱུྃ་གི་བར་གྱིས་མཆོད་ཅིང་།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་པ་གཡས་ཀླུ་ཤིང་གི་མགོ་ལྕོགས་མེ་ཏོག་དང་བཅས་པ་དང་།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་ཤིང་གཙོ་བོ་ལ་བལྟ་པ།",
    "སོགས་ཟློག་གཅིག་གིས་བསྟོད་པ།",
    "གཙོ་བོའི་ཐུགས་ཀར་ཟླ་གདན་གྱི་སྟེང་དུ་ཧཱུཾ་ཡིག་གི་མཐའ་སྐོར་དུ།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བའི་ཚིགས་པར་མ་རྣམས་བཅག་ལ་དཔྲལ་བར་བཞག་སྟེ།",
    "ཐལ་མོ་སྦྱར་བའི་ཁ་གྱེན་དུ་ཕྱེ་ཏེ་མཐེ་འོང་བསྣོལ་ལ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཀུཎྜ་ལི་ཧ་ན་ཧ་ན་ཧཱུཾ་ཕཊ་ཅེས་དང་།",
    "གཡས་ཁུ་ཚུར་བཅངས་པའི་མཛུམ་མོ་བསྒྲེང་།",
    "སོར་མོ་ནང་དུ་བསྣོལ་བའི་རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་གཉིས་བཤིབས་ཏེ་བསྒྲེངས་ལ།",
    "ས་མནྟི་བུདྷ་ནཾ།",
    "ཞེས་པས་མགོན་ཐམས་ཅད་ཀྱིས་དམ་ཚིག་གི་བདག་ལ་འགོ་ཞིང་ཕན་པ་དང་བདེ་བའི་འཕྲིན་ལས་འབའ་ཞིག་སྒྲུབ་པར་བསམ་ཏེ།",
    "བསྡུ་ན་ཀུན་རིག་གི་ཆ་གསུམ་ནང་ལྟར་སྔགས་རྒྱུས་ལན་གསུམ་བྱིན་གྱིས་བརླབས་ཀྱང་རུང་ངོ།",
    "ཞེས་ཐལ་མོ་སྦྱར་ལ་གསོལ་བ་གདབ་པོ།",
    "དེའི་མདུན་དུ་ཡུམ་ཀླུ་མོ་ནོར་བུའི་ཅོད་པཎ་ཅན་སྦྲུལ་མགོའི་གདེངས་ཀ་ལྔ་དང་ལྡན་པ་ཕྱག་གཉིས་ནོར་བུ་དང་པདྨ་འཛིན་པས་ཐལ་མོ་སྦྱོར་ནས་ཡབ་ལ་འདུད་པ།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུཾ་གིས་མཚན་པར་གྱུར།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས་པས་རྒྱ་མཚོ་ཆེན་པོའི་ཀློང་ནས་ཀླུའི་རྒྱལ་བོ་འཁོར་དང་བཅས་པ་སྤྱན་དྲངས།",
    "བཾ་ཧོརང་རང་གི་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཞེས་སོགས་ཆུ་གཉིས་སྔོན་དུ་འགྲོ་བའི་ཉེར་སྤྱོད་ཀྱི་བར་རོལ་མོ་བཅས་མཆོད།",
    "ན་མོ་བཛྲ་དྷཱ་ར་ཡེ།",
    "ནང་གསེས་ཀྱིས་ཆེ་ཕྲན་དགུ་རེ་གདབ།",
    "ཁྱིམ་ཟླ་གསུམ་རེའི་ཞག་དང་གྲངས་མཉམ་ཞིང་།",
    "མཐའི་རེ་མིག་ཀུན་བསྡོམས་པ་ནི་ཁྱིམ་ཞག་སུམ་བརྒྱ་དྲུག་ཅུ་དང་མཚུངས་སོ།",
    "ནག་རྩིས་འདི་ལུགས་ཀྱི་བརྒྱུད་པ་དགུན་ར་བ་བུ་མོའི་ཁྱིམ་ནས་བརྩམས་ཏེ།",
    "ཐོག་མར་ཤར་ལྷོ་ནས་གཡས་བསྐོར་དུ་ཁྱིམ་ཞག་རེ་ལ་ཆ་ཆུང་རེ་སྤྱོད་ཅིང་།",
    "སྔགས་རིམ་ཆེན་མོ་ལས།",
    "དེའི་ཕྱོགས་བཞི་བོ་རེ་རེར་ཡང་ཟླ་བ་གསུམ་གྱི་ཞག་གྲངས་དང་མཐུན་པར་རེ་མིག་དགུ་བཅུ་རེ་བྱའོ།",
    "སྟོན་ཟླར་བརྒྱད་པའི་ཚེས་གཅིག་ལ་མགོ་བྱང་ཤར་འཚམས་ཀྱི་རེའུ་མིག་ཏུ་བཞག་ནས་མཇུག་རྩེ་ལྷོ་ནུབ་ཀྱི་རེའུ་མིག་ཏུ་བཞག་སྟེ་ཁ་ལྷོར་བལྟས་ནས་གནས་སོ།",
    "དེ་ནས་ཞག་རེ་སོང་བ་ན་མགོས་ལྷོ་ངོས་སུ་རེའུ་མིག་རེ་དང་མཇུག་རྩེས་བྱང་ངོས་སུ་རེའུ་མིག་རེ་བགྲོད་ནས་གཡས་བསྐོར་གྱིས་འཕོའོ།",
    "ཟླ་བ་གསུམ་ལ་ཕྱོགས་རེའི་རེའུ་མིག་དགུ་བཅུ་རེ་བགྲོད་པས།",
    "ལོ་གཅིག་ལ་ཕྱོགས་བཞིའི་རེའུ་མིག་དགུ་བཅུ་བ་ཕྲག་བཞི་ག་འཁོར་ལོ།",
    "མཐོ་རེས་རེའུ་མིག་དགུ་རེ་ནོན་པས་ཕྱོགས་དང་མཚམས་གང་དུ་གནས་པའི་ཚེ་ཡང་རེའུ་མིག་དགུ་བཅུ་རེ་ནོན་ནོ།",
    "ལུས་ཀྱི་ཞེང་གིས་ནི་སའི་རེའུ་མིག་གི་ཆ་དགུ་ཁྱབ་པར་ཉལ་ཞིང་གསང་གནས་ནི་ཕྱོགས་མཚམས་གང་ལ་གནས་པའི་ཚེ་ནའང་དེའི་དབུས་སུ་བཞག་ནས་གནས་ཏེ།",
    "རྒྱས་ཀྱི་ལུས་ཀྱིས་ནོན་པའི་ས་ནས་མདུན་དུ་རེའུ་མིག་ཕྱེད་དང་བཅུ་བཞིའི་བར་བརྐོར་མི་རུང་བས།",
    "མཚམས་དེ་ནས་ལྷོར་རེའུ་མིག་ཕྱེད་དང་ལྔ་ནི་དང་པོར་བརྐོ་བའི་ས་དམིགས་སོ།",
    "མཆན་གྱི་ཐད་དུ་རེའུ་མིག་དགུ་སྤངས་པར་བརྐོ་བའི་ལུགས་སོ།",
    "གཞི་བདག་གི་གཏོར་མ་ཡང་བཤམས།",
    "སྟོང་བའི་ངང་ལས་རང་གི་མདུན་དུ་ས་བདག་ལྟོ་འཕྱེ་ཆེན་པོ་སྟོད་མི་ལ་སྨད་སྦྲུལ་མཇུག་ཅན",
    "ཕྱག་གཉིས་ཐལ་མོ་སྦྱར་བ།",
    "གཡོན་བརྐྱང་གིས་བཞུགས་པར་གྱུར།",
    "ཡུམ་ཀླུ་མོ་སོར་བདུན་པའམ་དྲུག་པ་གདེངས་ཀ་ལྔ་ལྡན།",
    "ནོར་བུ་བཅས་ཕྱག་ཐལ་མོ་སྦྱར་ཏེ་ཡབ་ལ་གཟིགས་པ།",
    "བ་དམར་དང་ར་དཀར་གྱི་འོ་མ་དང་གྷི་ཝང་གིས་བྱུགས།",
    "ཡི་དམ་གང་རུང་གི་བདག་བསྐྱེད་རྒྱས་བསྡུས་ཅི་རིགས་བྱས་ནས།",
