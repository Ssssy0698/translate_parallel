    "དུག་ཞི་བར་འདོད་ན་ཐབས་དེར་ཙན་དན་གྱི་ཤིང་ལ་མེ་སྦར་ལ་པིང་ཏ་ཀ་རའི་མེ་ཏོག་གི་སྦྱིན་སྲེག་བྱའོ།",
    "འདུན་པ་བསྒྱུར་ཞིང་རྩ་བའི་སྔགས་བཟླས་པ་ཁོ་ནས་ཇི་ལྟར་བསམ་པ་བཞིན་འགྲུབ་མོད་ཀྱི།",
    "ནུས་པ་མ་སྨིན་པ་དག་གི་ཕྲལ་དུ་འདོད་པ་གྲུབ་པར་མ་གྱུར་ན་མན་ངག་གཞན་ཐུག་ཕྲད་དུ་སྦྱོར་བ་བསྟན་པར་བྱ་སྟེ།",
    "རང་གི་ཐུགས་ཀའི་འོད་ཟེར་ལྕགས་ཀྱུའམ།",
    "ཨོཾ་ཀུ་རུ་ཀུལླེ་ཆེ་གེ་མོ་ཨཱ་ཀརྵ་ཡ་ཧྲཱི་ཧཱུྃ་སྭཱ་ཧཱ།",
    "རང་གི་ལྟེ་བའི་ཧཱུཾ་དམར་པོ་ལས་འོད་དམར་པོ་སྟེང་དུ་འཕྲོས་པས་བསྐུལ་བས།",
    "སླར་ཡང་ནྲྀ་ཡིག་དང་མེ་ཏོག་གི་འདབ་མ་རྣམས་ཀྱི་བཅུད་དང་བཅས་རིངས་པར་རྔུབ་པས་ཁོའི་པདྨ་རྙིང་ཞིང་མི་གསལ་བར་གྱུར་ཏེ།",
    "ༀཀུ་རུ་ཀུལླེ་ཧྲཱི་ཧཱུཾ་ཆེ་གེ་མོ་མེ་བ་ཤ་མ་ནཱ་ཡ་ཧོ་སྭཱ་ཧཱ།",
    "ༀཀུ་རུ་ཀུལླེ་ཧྲཱི་ཧཱུཾ་ཆེ་གེ་མོ་ཤཱིནྟཾ་ཀུ་རུ་སྭཱ་ཧཱ་ཞེས་བཟླས་པས་ཞི་བར་བྱེད་ལ།",
    "ༀཀུ་རུ་ཀུལླེ་ཧྲཱི་ཧཱུྃ་ཆེ་གེ་མོ་པུཏྲིཾ་ཀུ་རུ་ཨོཾ་སྭཱ་ཧཱ།",
    "རྐང་མཐིལ་འགུལ་ན་རིང་ན་གནས་པ་ཡིན་པས་དེ་ལྟར་ཉི་མ་རེ་བཞིན་བརྟགས་པས་གཏེར་རྙེད་པར་འགྱུར་རོ།",
    "བུད་མེད་སྐལ་བ་དང་ལྡན་པར་བྱ་བའི་ཕྱིར་འདབ་མ་བདུན་པའི་ཨུཏྤལ།",
    "བདག་པོ་བུད་མེད་བྲན་དུ་འགྱུར།",
    "འགྲོན་བུ་དེ་སྣོད་དུ་བཅུག་པའི་ནང་དུ་སྦ་བར་བྱས་ན་ཉིན་རེ་ཀརྴ་པ་ཎ་རེ་རྙེད་པར་འགྱུར་རོ།",
    "བྲམ་ཟེ་ཚངས་པ་མོ་དང་མ་ག་པི་ལིང་ག་ཏ་ སྦྲང་དང་བཅས་པ་བཟའ་བར་བྱ།",
    "ཛཱ་ཏི་ཙནྡྲ་གཏུམ་མོ་ལི་དག་དང་།",
    "གང་དང་གང་དུ་གནས་པ་དེར་གསོ་སྦྱོང་ལ་གནས་པས་འོ་མར་མཉེས་ནས་འཐུང་ན་སྐྲ་དཀར་དང་གཉེར་མ་རེངས་པར་བྱེད་དོ།",
    "བཅུད་ལེན་སྒྲུབ་པའི་རྒྱུད་རེ་",
    "སོ་ཕག་དུ་བ་ཆང་དང་རྩབ་མོ་དང་།",
    "ཟངས་སྣོད་བུད་མེད་འོ་མ་དང་མཉེས་ནས།",
    "མགོ་བོར་བཅིངས་པས་ཞག་གཅིག་པའི་རིམས་མེད་པར་བྱེད་དོ་ གསེར་ཤིང་ད་དྷུ་ར་གི་རྩ་བ་མགོར་བཅིང་ན་ཉིན་བཞི་པའི་རིམ་མེད་པར་བྱེད་དོ།",
    "བྱིས་པ་ནུ་ཞོ་སྐྱུགས་པ་ན་རྨ་བྱའི་སྒྲོ་བསྲེགས་པའི་ཐལ་བས་མགུལ་བ་བཅིངས་པར་བྱས་ན་སོས་སོ།",
    "ཨུཏྤལ་གྱི་སྡོང་བུའི་ཕྱི་ཤུན་གྱི་ཁུ་བ་འོ་མས་བཀྲུས་ཏེ་འཐུང་བས་བུད་མེད་གང་ཞིག་རང་གི་ལས་ཀྱིས་མངལ་རླུགས་པའང་རྣལ་དུ་གནས་པར་བྱེད་དོ།",
    "ཡང་མ་ག་པི་ལིང་ཏ་ཡི་འབྲས་བུ་ལྔ་ཙམ་ཁོང་དུ་བཏང་ནས་འོ་མ་འཐུང་ན་བུད་མེད་དེ་ལ་སྔགས་ཀྱི་མཐུས་བདེ་བར་བཙའ་བར་བྱེད་དོ།",
    "ཤུ་དག་གི་འབྲས་བུ་བཏགས་ནས་འོ་མར་བསྲེས་ཏེ་བཙུན་མོ་གསོ་སྦྱོང་དང་ལྡན་པས་འཐུང་ན།",
    "ཆང་གི་ས་བོན་བྱེད་པར་སྤྲེའུའི་མི་གཙང་བ་བཅུག་ན།",
    "ཁྱི་མོའི་འོ་མ་བསྲུབ་པའི་མར་གྱིས་བསྐུས་པའི་ར་ལྤགས་ཀྱི་ལྷམ་གྱོན་ན་ཆུ་ཡི་སྟེང་དུ་འགྲོ་བར་བྱེད་དོ།",
    "ཐོག་གིས་བཅག་པའི་ཤིང་བཅུག་ན།",
    "ནི་ཙུ་ལ་དང་གི་མི་ཀླད་དམ་རི་ཀར་ཎིའི་ཆུས།",
    "ཤིང་སྒྲོག་ལྕགས་སྒྲོག་ཁྲི་མོན་གཡུལ་ངོ་རུ།",
    "རིག་སྔགས་ཨུཏྤལ་དམར་པོའི་རྒྱན་གཅིག་གིས།",
    "ཁེངས་པའི་རུ་མཚོན་ཅིག་ཆར་བསྙིལ་ནས་སུ་ རྒྱལ་ཐབས་རང་གིར་བྱེད་པའི་ངོ་མཚར་མཐུ།",
    "མ་ལུས་སྐྱེ་རྒུའི་རེ་བ་སྐོངས་གྱུར་ཅིག།",
    "གང་དུ་བ་བྱུང་དང་དྲི་བཟང་གིས་བྱུགས་པའི་མཎྜལ་གྱི་སྟེང་རྗེ་བཙུན་མའི་རས་བྲིས་བཀྲམ།",
    "བདག་གི་རྣལ་འབྱོར་གྲུབ་ནས།",
    "ཨོཾ་ཨ་མྲྀ་ཏེ་ཧཱུྃ་ཕཊ་ཀྱིས་བསངས།",
    "ན་མ་སརྦ་བུདྡྷ་བོ་དྷི་ས་ཏྭ་བྷྱོ",
    "ན་མོ།",
    "གདུགས་དང་རྒྱལ་མཚན་བ་དན་བླ་རེ་འཕན།",
    "སིལ་སྙན་རོལ་མོ་གླུ་དབྱངས་བསྟོད་པའི་ཚིག།",
    "རྡོ་རྗེའི་ལྷ་མོ་བཅུ་དྲུག་ལ་སོགས་པ།",
    "ཕན་བདེའི་གཏེར་ཆེན་ཁྱོད་ཀྱི་ཞབས་པད་ལ།",
    "ཁྱད་པར་ལྷ་རྫས་ཀྱི་བུ་མོ་དང་ཁྱེའུ་སོགས་རང་གིས་དངོས་གྲུབ་གང་འདོད་པའི་རྣམ་པ་དེ་ལྟ་བུ་ནན་ཏན་དུ་འབུལ་བར་བསམ་ལ།",
    "ཞེས་རབ་བྱུང་བཅོ་ལྔ་པའི་ས་གླང་མགོ་ཟླའི་ཚེས་བཅུ་དྲུག་རེས་གཟའ་བཀྲ་ཤིས་པཱ་རྒྱུ་སྐར་གྲུབ་པའི་རྒྱལ་མོ་བརྩེ་བའི་དུས་བཟང་པོར་སྒྲུབ་ཁང་བདུད་ལས་རྣམ་རྒྱལ་དུ་འཇམ་དཔལ་དགྱེས་པའི་རྡོ་རྗེའམ་པདྨ་བཞད་པ་རྩལ་ཞེས་པའི་བློའི་མེ་ཆུ་གཏེར་ནས་བྱུང་སྟེ་ཐུན་མཚམས་སུ་ཡི་གེར་བྲིས་པ་མདྒ་ལཾ།",
    "བདེ་ཆེན་དགའ་བ་སྐྱེད་པའི་དཔལ་མོ་ནི།",
    "དྲན་པས་ཡིད་ཀྱི་གདུང་སེལ་ཁྱོད་ལ་འདུད།",
    "བཅུ་དྲུག་ལང་ཚོ་མཛེས་པའི་རྣམ་འགྱུར་ཅན།",
    "ས་གསུམ་བརྟན་པ་འཕྲོག་བྱེད་ཁྱོད་ལ་འདུད།",
    "གློག་ལྟར་གཡོ་བའི་སྤྱན་གྱིས་རྣམ་གཟིགས་ནས།",
    "མགོན་མཛད་དཔའ་མོའི་དམ་བཅའ་མི་བསྙེལ་བའི།",
    "རིན་ཆེན་གཞུ་མཆོག་བསྣམས་པ་ཁྱོད་ལ་འདུད།",
    "ཡིད་ལ་རེ་བའི་དཔལ་རྣམས་མ་ལུས་པ།",
    "བཞད་པ་བརྒྱད་ལྡན་གསུང་གིས་ས་གསུམ་གཡོ།",
    "ལེགས་འཁྲུངས་རྒྱལ་ཀུན་ཕྲིན་ལས་ལྷ་མོ་ནི།",
    "གང་གིས་ཁྱོད་ཞབས་དྲན་པའི་མོད་ཉིད་ལ།",
    "ཁྱོད་ཀྱི་རིག་སྔགས་ལྕགས་ཀྱུ་རྣོན་པོ་གང་།",
    "ཁྱོད་ནི་ཕོངས་པ་ཀུན་ལས་སྒྲོལ་བའི་གཉེན།",
    "ཉམས་ཐག་ཚོགས་ཀྱིས་ཁྱོད་ལ་གསོལ་བཏབ་ན།",
    "མྱུར་བའི་ཚུལ་གྱིས་བདག་གིས་སྐྱོབ་བོ་ཞེས།",
    "བདེན་གསུང་རྡོ་རྗེའི་ཚིག་གིས་སྒྲོལ་མའི་མཚན།",
    "བདེན་པའི་གསུང་གིས་བསྔགས་པ་དོན་ཡོད་མཛོད།",
    "ཅེས་རིག་བྱེད་མའི་བསྟོད་པ་དཔལ་ལྡན་ས་གསུམ་དགའ་བའི་དགའ་སྟོན་ཞེས་བྱ་བ་མི་ཕམ་རྣམ་པར་རྒྱལ་བས་རབ་ཚེས་ལྕགས་ཡོས་དབོ་ཟླའི་ཚེས་བཅུ་དགུར་སྒྲུབ་ཁང་བདུད་ལས་རྣམ་རྒྱལ་དུ་ཤར་མར་བྲིས་པ་དགེ་ལེགས་རྒྱ་ཆེར་འཕེལ་ལོ། ། རྟོག་པ་ལས་གསུངས་པའི་ལྷ་མོ་འོད་ཟེར་ཅན་གྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་དགུའི་དཔལ་འབར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྲས་བཅས་རྒྱལ་བའི་ཕྲིན་ལས་ཕོ་ཉ་མོ།",
    "ཡེ་ཤེས་སྒྱུ་མའི་སྐུ་ཅན་ལྷ་མོ་འདི།",
    "གང་གིས་བསྒྲུབ་པས་འཇིགས་པ་ཀུན་སེལ་ཞིང་།",
    "དེ་ཚེ་ལྷ་མོ་འདི་དང་འཇམ་པའི་དབྱངས།",
    "འགྲུབ་ཅིས་རྡོ་རྗེ་འཆང་གིས་རྒྱུད་ལས་བསྔགས།",
    "ལྷ་མོ་འདི་ཡི་མཚན་ཙམ་འཛིན་པ་ཡང་།",
    "དངོས་གྲུབ་འདོད་པས་རས་སམ་ཤིང་གི་ངོས།",
    "གནས་པའི་ལྷ་མོ་རྒྱན་རྣམས་ཀུན་ལྡན་ཞིང་།",
    "མྱ་ངན་མེད་པའི་འོད་ཟེར་ཅན་དེ་རི་མོ་མཁན་གཟོ་སྦྱོང་ལ་གནས་པས།",
    "ལས་ཉི་མའམ་ཨ་མཚན་མོ།",
    "པོའི་རྭ་བ་ཟླུམ་པོ་རྩེ་མོ་མཆོད་རྟེན་གྱི་རྣམ་པ་ཅན་ཅིས་ཀྱང་མི་ཤིགས་པའི་རང་བཞིན་དུ་གྱུར།",
    "རང་གི་ཐུགས་ཀར་ཟླ་བའི་སྟེང་དུ་མཱཾ་ལས་མྱ་ངན་མེད་པའི་ཤིང་གི་ཡལ་ག་མེ་ཏོག་དང་བཅས་པ་ལ་ཟླ་བ་ཊཱཾ་དང་བཅས་པས་མཚན་པ་དེ་ཡོངས་སུ་གྱུར་པ་ལས་འོད་ཟེར་ཅན་སེར་མོ་སྙེམ་པའི་ལུས་ཅན་རྒྱན་ཀུན་དང་ལྡན་པ་ཕྱག་གཡས་ན་ཁབ་དང་གཡོན་པས་སྐུད་པ་བསྣམ་པ།",
    "ཞབས་གཉིས་མཉམ་པར་བཞེངས་པ་ཅན་དུ་བསམ་ལ་རང་གི་སྣ་བུག་གཡས་ནས་སྤྲོས་ཏེ་མདུན་དུ་ཟླ་བའི་གདན་ལ་བཞུགས་ཉིན་མོ་ཉི་མ་ནང་།",
    "རང་དང་ཕག་ལས་འོད་བྱུང་བས་ཕག་འཇིགས་སུ་རུང་བ་དཔག་ཏུ་མེད་པས་འོབས་ཀྱི་ནང་གི་གནོད་བྱེད་ཀུན་ཟོས།",
    "གཞོན་ནུའི་ཚོགས་ལ་སྟོན་མོ་བྱས་ཏེ།",
    "ལྔ་པར་མར་མེའི་རྩེ་མོ་འཕེལ་ཞིང་དྲི་བཟང་པོ་འཐུལ་བ་འབྱུང་ངོ།",
    "ཁྲི་གཅིག་བཟླས་པས་སྟོང་ཕྲག་གི་ཚེ་འཕེལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་བདག་གི་རྣལ་འབྱོར་ལ་འཇུག་པའི་ཕྱིར་དུ།",
    "སྲས་བཅས་རྒྱལ་བ་ལྷ་མོ་འོད་ཟེར་ཅན།",
    "ན་མ་སརྦ་བུདྡྷ་བོ་འོད་ཟེར་ཅན་མའི་སྒྲུབ་ཐབས།",
    "ཚུར་འདུས་ཡོངས་གྱུར་བདག་ཉིད་སྐད་ཅིག་གིས།",
    "གཡོན་པས་མྱ་ངན་མེད་པའི་ཤིང་གི་ནི།",
    "ལང་ཚོ་དར་ལ་བབ་ཅིང་མཛེས་པའི་སྐུ།",
    "སྐབས་དང་སྐབས་སུ་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅང་ཞིང་བསྒོམ་བཟླས་ལ་འབད་པར་བྱའོ།",
    "དེ་ལ་ཕྱག་རྒྱ་གང་ཞེ་ན་ཐལ་མོ་སྦྱར་བར་བྱས་པའམ།",
    "མཐེབ་ཆེན་ཅུང་ཟད་བཀུག་སྟེ་སྲིན་ལག་གཉིསཀྱི་རྩེ་མོར་རེག།",
    "གུང་མོ་གཉིས་ཕན་ཚུན་རྩེ་སྦྱར་ལ།",
    "བརྐྱང་བའི་རྒྱབ་ཏུ་མཛུབ་མོ་གཉིས་འཁྲིལ་བའི་ཚུལ་དུ་སྦྱར་ཏེ་ཟླུམ་པོའི་རྣམ་པར་བྱས།",
    "ཕྱག་རྒྱ་མཆོག་གི་གཙོ་བོ་འདི།",
    "ཕག་གི་ཚོགས་འཕྲོས་པས་གདུག་པ་ཅན་ཚར་བཅད་པ་ལ་སོགས་པའི་དམིགས་པ་གང་འདོད་བྱའོ།",
    "ཐུན་མཐར་དཀར་གཏོར་ཨ་མྲྀ་ཏས་བསང་།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གིས་བྱིན་གྱིས་བརླབ།",
    "རང་གི་ཐུགས་ཀའི་འོད་ཀྱིས་རྣམ་པར་སྣང་མཛད་ཀྱིས་དབུ་བརྒྱན་པའི་འོད་ཟེར་ཅན་འཁོར་དང་བཅས་པ་བཛྲ་ས་མཱ་ཛ",
    "ཨོཾ་མཱ་རཱི་ཙེ་དེ་བཱི་ས་པ་རི་ཝ་རེ་བྷྱ",
    "རི་བོ་དང་དུར་ཁྲོད་མཚོ་དང་རྫིང་བུ་ཤིང་ནྱ་གྲོ་དྷའི་དྲུང་དང་སྐྱེད་མོའི་ཚལ་དང་ལྷ་ཁང་དང་རིང་སྲེལ་དང་བཅས་པའི་མཆོད་རྟེན་གྱི་དྲུང་།",
    "ཞི་བ་རལ་པའི་ཅོད་པཎ་ཅན་རྒྱན་ཀུན་དང་ལྡན་པ་པདྨ་དང་སེང་གེའི་ཁྲི་ལ་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་ཤིང་ཏིང་ངེ་འཛིན་ལ་སྙོམ་པར་ཞུགས་པ་དེའི་ཐུགས་ཀར་ཟླ་བའི་སྟེང་དུ་མཱཾ་ལས་མྱ་ངན་མེད་པའི་ཤིང་ལ་ཟླ་བ་ལ་མི་ཕམ་བཀའ་འབུམ།",
    "མཚན་མོ་ཟླ་བ་ལ་ཞབས་གཡོན་བརྐྱང་བའི་ཕྱེད་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "འོད་ཟེར་ཅན་མའི་སྒྲུབ་ཐབསཤིང་རྟ་དེའི་སྟེང་ན་མདུན་དུ་བརྟ་ལི་དམར་མོ་ཞལ་གཅིག་ཕྱག་བཞི།",
    "གཡས་བརྐྱང་གིས་བཞུགས་ཤིང་དགུག་པའི་ལས་མཛད་པ།",
    "གཡས་སུ་བ་དཱ་ལི་སེར་མོ་གཡས་གཉིས་མྱ་ངན་མེད་པའི་ཡལ་ག་དང་ཁབ་སྐུད།",
    "གཡོན་གཉིས་ཞགས་པ་དང་རྡོ་རྗེ་བསྣམ་པ་གཡས་བརྐྱང་གིས་བཞུགས་ཤིང་གདུག་པ་ཅན་གྱི་ཁ་མིག་བཙེམ་ནས་འཆིང་བའི་ལས་མཛད་པ།",
    "རྒྱབ་ཏུ་བར་ལི་སེར་མོ་གཡས་གཉིས་རྡོ་རྗེ་དང་ཁབ།",
    "གཡོན་གཉིས་ཞགས་པ་དང་མྱ་ངན་མེད་པའི་ཡལ་ག་འཛིན་པ་གཡས་བརྐྱང་གིས་བཞུགས་ཤིང་གདུག་པ་ཅན་མནན་ཞིང་རེངས་པའི་ལས་མཛད་པ།",
    "གཡོན་དུ་བཱ་རཱ་ཧཱ་མུ་ཁི་དམར་མོ་ཉི་མ་འཆར་ཁའི་འོད་འབར་བ་གཡས་གཉིས་མདའ་དང་རྡོ་རྗེ།",
    "དེ་ལྟར་ལྷ་མོ་བཞི་པོ་ཀུན་ཀྱང་ཕག་གི་ཞལ་ཅན།",
    "ཁྱད་པར་དུ་ཕྱོགས་བཅུ་ན་གནས་པའི་གདུག་པ་ཅན་སྡང་ཞིང་འཚེ་བའི་རིགས་སུ་གྱུར་པ་ཐམས་ཅད་སྤྲུལ་པའི་ཕོ་ཉ་དང་ཕག་པའི་གཟུགས་འཇིགས་སུ་རུང་བ་སྣ་ཚོགས་པས་གང་ལ་གང་འོས་པར་དགུག་པ་དང་བཅིང་བ་དང་མནན་པ་དང་རེངས་པ་དང་རྨོངས་པ་དང་བསྐྲད་པ་དང་བསད་པ་ལ་སོགས་པའི་ལས་ཀྱིས་དཔའ་བཀོད་ཟིལ་གྱིས་མནན་ཚར་ར་",
    "མོ་ཧ་ཡ་མོ་ཧ་ཡ་ཧྲཱི་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ",
    "མངོན་སྤྱོད་ལ་ནག་མོ་ཕྱག་བཞི་པ་གཡས་ན་རལ་གྲི་དང་ཐོ་བ།",
    "རེངས་པར་སེར་མོ་ཕྱག་དྲུག་པ་འོད་ཟེར་ཅན་མའི་སྒྲུབ་ཐབས།",
    "ཞེས་དང་རྒྱས་པར་དེ་བཞིན་དུ་ཙེ་ཡི་ཐ་མར་ཨ་མུ་ཀ་པུཀྴི་ཀུ་རུ་ཨཾ།",
    "བསད་པ་ལ་ཨ་མུ་ཀ་མཱ་ར་ཡ་ཕཊ་ཞེས་པ་ལ་སོགས་པའི་དབྱེ་བ་ཤེས་པར་བྱ་སྟེ་ཨ་མུ་ཀ་ཞེས་པ་དམིགས་བྱའི་མིང་སྤེལ་བའི་དོན་དུའོ།",
    "རང་གི་ཁྲག་དང་རུས་པ་དང་དུག་དང་སྐེ་ཚེའི་སྲེག་བླུག་སྟོང་གིས་དགྲ་བོ་འཆིའོ།",
    "འོ་མའི་སྦྱིན་སྲེག་སྟོང་གིས་ཞི་བར་བྱེད་པར་འགྱུར་རོ། ། གང་ཞིག་དགུག་པའི་ལས་བརྩམ་པར་འདོད་པས།",
    "དྲི་བཟང་གིས་བྱུགས་པའི་མཎྜལ་ལ་ཐང་སྐུ་བཀྲམ་ཞིང་དེའི་མདུན་དུ་འདུག་ལ་རང་གི་ཐུགས་ཀ་ནས་ལས་བྱེད་ཀྱི་ལྷ་མོ་དམར་མོ་ཉི་མའི་དཀྱིལ་འཁོར་ལ་གཡས་བརྐྱང་བས་གནས་པ་ལྕགས་ཀྱུ་དང་ཞགས་པ་ཐོགས་པ་འཕྲོས་ནས།",
    "ཨོཾ་མཱ་རཱི་ཙེ་བརྟུ་ལི་བ་དཱ་ལི་བ་རཱ་ལི་བཱ་རཱ་ཧཱ་མུ་ཁི་ཆེ་གེ་མོ་ཨཱ་ཀརྵ་ཡ་ཛ་སྭཱ་ཧྭ་འོད་ཟེར་ཅན་མའི་སྒྲུབ་ཐབས།",
    "གི་ཝཾ་དང་།",
    "ཤིང་མྱ་ངན་མེད་པའི་མེ་ཏོག་གི་ཁུ་བ་སྐར་མ་རྒྱལ་ལ་བླངས་ཏེ་པདྨ་འདབ་མ་བརྒྱད་པ་ལ།",
    "དཔག་ཚད་སྟོང་ནས་ཀྱང་འགུག་སྟེ་བུ་མོ་དགུག་པའི་མཆོག་གོ།",
    "གི་ཝཾ་གིས་གྲོ་ག་ལ་བསྒྲུབ་བྱའི་གཟུགས་བྲིས།",
    "གཞན་ཡང་གནོད་སྦྱིན་མོ་འགུག་པ་སོགས་རྟོག་པ་ལས་ཤེས་པར་བྱའོ།",
    "དམིགས་བྱ་སྐྲ་གྲོལ་ཞིང་ཆགས་པས་མྱོས་ནས་འདར་བཞིན་པ་རང་གི་རྐང་པའི་དྲུང་དུ་འདུད་པར་བསམ་ལ་ༀམཱ་རཱི་ཙྩེ་བརྞཱ་ལི་བ་དཱ་ལི་བ་རཱ་ལ་བཱ་རཱ་ཧུ་མུ་ཁི་རྒྱེ་མོ་མེ་བ་ཤ་མ་ན་ཡ་ཧོ་སྭཱ་ཧཱ།",
    "མྱུར་དུ་འགུག་པའི་ཕྱིར་སྐེ་ཚེ་བྱུགས་ལ་སེང་ལྡེང་གི་མེ་ལ་གདུང་བར་བྱས་ན་སྐྱེས་བུའམ་བུད་མེད་རྣམས་ཅི་ལྟར་འདོད་པ་བཞིན་འགུག་པར་འགྱུར་རོ།",
    "གི་ཝཾ་རྣམས་སྐར་མ་རྒྱལ་ལ་ཕག་གི་སོས་གཞིབ་པ་དཔྲལ་བར་ཐིག་ལེ་བྱས་པས།",
    "ཕག་གི་ཚོགས་ཀྱིས་གདུག་པ་རྣམས་ཟ་ཞིང་ར་བའི་ཚུལ་གྱིས་བསྲུང་བར་གྱུར་པའི་དམིགས་པ་དང་བཅས།",
    "གོང་གི་སྔགས་ཀྱི་སརྦ་དུཥྚ་ནཱཾ་ཞེས་པའི་རྗེས་སུ་གྲནྠི་བནྡྷ་མི་སྭཱ་ཧཱ།",
    "ཞེས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ལ་གོས་ཀྱི་མཐའམ་བུ་མོས་བཀལ་བའི་སྲུང་སྐུད་ལ་མདུད་པ་བོར་བར་བྱའོ།",
    "དེ་ཡང་རང་གི་ཆེད་དུ་མདུད་པ་བདུན་བོར།",
    "གཡོག་སོགས་གང་སྲུང་འདོད་པ་དེ་དང་དེ་དག་གི་མིང་བཟུང་ལ་སོ་སོར་མདུད་པ་རེ་རེ་གྲངས་བཞིན་བོར་བར་བྱ།",
    "ཨོཾ་ལྷ་མོ་འོད་ཟེར་ཅན་བདག་འཇིགས་པ་ཎྱེ་མོ་འདི་ལས་སྐྱོབ་ཅིག་བརྗོད་ཅིང་སྔགས་བཟླ་བཞིན་སང་པས་འཇིགས་པ་ཆེན་པོ་ཅི་ལྟ་བུའི་ཁྲོད་དུ་ཡང་ཉམ་ང་བ་མེད་པར་བདེ་བར་འགྲོ་བར་འགྱུར་རོ།",
    "འཇིགས་པ་གྲོལ་ནས་མདུད་པ་རྣམས་རང་གིས་དཀྲོལ་བར་བྱའོ།",
    "ཕག་ཁྲག་དང་གི་ཝཾ་བྱུགས་སྔགས་དང་བཅས་ཏེ་གང་གི་མིང་བཟུང་ཞིང་དེ་སྲུང་བའི་འོད་ཟེར་ཅན་མའི་སྒྲུབ་ཐབས།",
    "དེ་གོས་ཀྱི་མཐའམ་ལག་པར་བཟུང་ནས་རྣ་བར་ཕག་གི་མཆེ་བ་བཅུག་ནས་སོང་ན་མིའམ་གཅན་གཟན་གཏུམ་པོ་ལ་སོགས་པ་འཚེ་བ་ཀུན་གྱི་བལྟར་མེད་གཟུང་དུ་མེད་པ་སོགས་སུ་འགྱུར་རོ།",
    "འཇིགས་པ་གྲོལ་ནས་མདུད་པ་རང་གིས་དཀྲོལ་བར་བྱའོ།",
    "གཞན་ཡང་ཁམ་སྐྱོང་གཉིས་ལ་མཱཾ་མིག་གི་བསྐོར་བའི་དབུས་སུ་བསྒྲུབ་ཕ་རོལ་རེངས་པར་བྱ་བའི་ཡུལ།",
    "བྱའི་མིང་སྤེལ་བྱས་ལ་ཁམ་སྐྱོང་ཐལ་བས་བཀང་སྐུད་པ་སེར་པོས་དཀྲི།",
    "སྐྲག་པ་ཀུན་ལས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ། ། ཕྱུགས་ལ་ཅེ་སྤྱང་གིས་ཉེར་འཚེ་ཞི་བར་འདོད་པས།",
    "གནག་གི་གནས་ཀྱི་སྒོ་ལ་སྔགས་བྲི་རྒྱལ་མཚན་དཀར་པོའི་རྩེ་ལ་བཙུགས།",
    "ཙན་དན་དཀར་པོ་དང་གུར་གུམ་གི་ཝཾ་གིས་ཁྱུ་མཆོག་གི་གཙོ་བོ་རྒན་པ་དང་ཕྱུགས་རྫིའི་མིང་སྤེལ་བ་བྱང་བུར་བྲིས།",
    "ཡང་བ་ཡིག་གིས་བསྐོར།",
    "ཡང་ཙེ་ཡིག་གིས་བསྐོར།",
    "དེའི་ཕྱི་རོལ་མཱཾ་གིས་བསྐོར་བ་བྲིས་ལ།",
    "ཁྱུ་མཆོག་གི་ར་དང་།",
    "ཕྱུགས་ཀྱི་སྒོར་སེང་ལྡེང་གི་ཕུར་པ་སོར་བརྒྱད་པ་ཚོན་སྐུད་ལྔས་དཀྲིས་པར་སྔགས་འདི་ལན་བདུན་བཏབ།",
    "དེས་ཅེ་སྤྱང་གི་གནོད་པ་ཞིའོ།",
    "དབེན་ཞིང་གཙང་མའི་གནས་སུ་ལོ་བཅུ་གཉིས་ལོན་པའི་ཕོ་མོ་མིག་ཡངས་ཤིང་བོང་རིང་བ་དང་ལྡན་པ་ཁྲུས་བྱས་ལ་གོས་དཀར་པོ་བོག།",
    "དེ་ནས་ང་ལང་གི་ལྕི་བའི་མཎྜལ་བྱས་ལ་དེར་གུ་གུལ་གྱི་བདུག་སྤོས་ལ་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ཏེ་བཏབ།",
    "ཉི་མ་འཆར་ཁའི་ཚེ་གཞོན་ནུ་མ་ཁྲུས་བྱས་གོས་དཀར་པོ་བོག་མེ་ཏོག་གིས་བརྒྱན་ཙན་དན་དཀར་པོས་ཡན་ལག་ཐམས་ཅད་བྱུགས་པ་བ་ཡི་ལྕི་བའི་དཀྱིལ་འཁོར་ལ་བཞག་གུ་གུལ་བདུག།",
    "སྔགས་འདི་ཁྲི་གཅིག་བཟླས་ཏེ་བསྟན་པར་བྱའོ། ། གང་ཞིག་གསོད་པ་དང་འབྱེད་པ་དང་རེངས་བའི་སྦྱོར་བ་བྱེད་པར་འདོད་པས།",
    "རང་ཉིད་འོད་ཟེར་ཅན་མ་ཕག་གི་ཞལ་གསུམ་ཁྲོས་པ།",
    "གཡོན་ན་གཞུ་དང་ཞགས་པ་མྱ་ངན་མེད་པའི་ཤིང་གི་ཡལ་ག་དང་སྐུད་པ་བསྣམས་པ།",
    "དུར་ཁྲོད་ཐལ་ཁ་རྣམས་ཀྱི་ཕ་རོལ་གྱི་གཟུགས་བརྙན་བྱས་ལ།",
    "ཆེ་གེ་མོ་སོད་ཅིག་མ་ར་ཡ།",
    "ཡང་ན་གཡུལ་ངོ་ལ་མངོན་དུ་བལྟས་ཏེ་མི་རུས་ཀྱི་ཕྱེ་མའམ་མི་ཚིལ་དང་བཅས་པའི་སྦྱིན་སྲེག་སྔགས་འདིས་བྱས་ན་དགྲའི་དཔུང་ཚོགས་དེ་མ་ཐག་ཏུ་རེངས་པར་བྱེད་དོ།",
    "ཨོཾ་མཱ་རཱི་ཙྪཾ་ཧཱུཾ་ཆེ་གེ་མོ་སོད་ཅིག་ཧཱུཾ།",
    "མི་རུས་ཀྱི་ཕྱེ་མ་དང་དུར་ཁྲོད་ཀྱི་ཐལ་བ་ཆུ་བོའི་ངོགས་གཉིས་ཀྱི་ས་རྐང་རྗེས་ཀྱི་ས་རྣམས་ལས་བསྒྲུབ་བྱའི་གཟུགས་བརྙན་བྱས་ལ།",
    "ཨོཾ་མཱ་རཱི་ཙྩེ་ཆེ་གེ་མོ་རིམས་ཀྱིས་ཛྭ་ར་ཡ་གྲྀ་སྣ་གྲྀ་ཧཱུཾ།",
    "ཡང་ན་ཐོད་པར་གོང་གི་རྫས་ཀྱིས་མིང་བྲིས་ལ།",
    "མེའི་ནང་དུ་ཡང་བཅུག་ལ་མཱཾ་གིས་བསྐོར་བ་བྱས་ལ།",
    "ཁྲོས་པས་སེང་ལྡེང་གི་མེ་ལ་བདུག།",
    "དུར་ཁྲོད་ཀྱི་ཐལ་བ་ཆུ་ཀླུང་ངོགས་གཉིས་ཀྱི་ས་དང་རྐང་རྗེས་ཀྱི་ས་རྣམས་ལས།",
    "ཨོཾ་མཱ་རཱི་ཛྱེ་སྒོ་མོ་དང་སྒོ་མོ་ཕྱེ་ཤིག་བི་དྭེ་ཥཾ་ཀྲུ་རུ།",
    "ཤཱི་གྷཾ་ག་མི་ནི་ཆེ་གེ་མོ་སྐྲོད་ཅིག་ཨུཙྪཱཊ་ཡ།",
    "སྔགས་འདི་བྱ་རོག་གི་གཤོག་པ་ལ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ནས་དགྲ་བོའི་ཁྱིམ་དུ་འབད་པས་སྦྲ་ཞིང་།",
    "དབྱུག་པའི་སྟེང་གི་རྩེ་མོར་རྡོ་རྗེ་རྩེ་གསུམ་པ་དང་འོག་རྩེར་རྡོ་རྗེ་རྩེ་གཅིག་པ་བྱའོ།",
    "ཕ་རོལ་སྒོ་གསུམ་འཆིང་ཞིང་ཀུན་ནས་རྨོངས་པར་བསམ་མོ།",
    "ཕ་རོལ་རྨོངས་པར་བྱེད་པའི་ཆོ་ག་དམ་པའོ། ཕ་རོལ་གྱི་དཔུང་རེངས་པར་བྱེད་ན།",
    "འོ་མ་དང་ཞོ་མར་དུ་སྨྱུག་པའི་དུར་བ་ཉག་མ་རེ་རེས་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱ་སྟེ་དེས་ནི་ལས་ཐམས་ཅད་ནུས་པར་འགྱུར་རོ།",
    "འདི་ནི་རེངས་པར་བྱེད་པའི་སྔགས་ཏེ་རེངས་པའི་ལས་ཐམས་ཅད་ལ་སྦྱར་བར་བྱའོ།",
    "ཕྱི་ནས་རྒྱལ་པོ་དང་མདུན་འདོན་གྱི་མིང་གྲོ་གའམ་རས་ལ་གུར་གུམ་མམ་གི་ཝཾ་གིས་སྔགས་དང་སྤེལ་ཏེ་རཀྵ་སྦྱར་བྲིས།",
    "དེའི་ཕྱི་རོལ་དུ་བ་ཡིག་གིས་ཡོངས་སུ་བསྐོར་བའི་འཁོར་ལོ་བྲིས་ལ།",
    "བསྒྲུབ་བྱ་གང་གི་སྤྱི་གཙུག་སམ་མགུལ་ལམ་དཔུང་པར་བཏགས་ན་ལས་ཐམས་ཅད་ལ་རང་ཉིད་སྲུང་བར་བྱེད་དོ།",
    "ལ་གནས་པར་བསྒོམ་ལ་རེངས་པར་བྱེད་པའི་སྔགས་བརྗོད་དོ།",
    "རང་གི་ཕག་པའི་བསྐོར་བའི་ནང་དུ་བསྒོམ་ན་དེ་མ་ཐག་ཕ་རོལ་གྱི་དཔུངས་ཚོགས་ལས་རྒྱལ་བར་འགྱུར་རོ།",
    "རིའི་རྩེ་མོའི་སའམ།",
    "ཡང་པ་དེ་དང་འབྲས་སཱ་ལུའི་ཁུ་བ་ཡུང་བའི་ཁུ་བ་དང་ལྡན་པས་ཕག་གི་གཟུགས་བྱས་ལ་དེའི་ཁ་རུ་གཟུགས་བརྙན་དེ་ཁ་ཐུར་དུ་བསྟན་ལ་བཅུག།",
    "ཕག་པ་དེ་ཁམ་སྐྱོང་ཁ་སྦྱར་ནང་དུ་བཅུག་ལ་སོང་སྟེ་དགྲའི་དཔུང་ལ་མངོན་དུ་བལྟས་པས་བཞག་པར་བྱའོ།",
    "སེང་ལྡེང་གི་ཕུར་པ་སོར་བརྒྱད་པ་སྔགས་བཏབ་པས་བཏབ་ལ་དེར་ས་བརྐོས་ཏེ་སྔགས་བཟླས་བཞིན་སྦས།",
    "སྔགས་སྟོང་ཕྲག་བརྒྱད་རྡོ་རྗེ་ཁྲོ་བོའི་ང་རྒྱལ་གྱི་སྟོབས་དང་ལྡན་པས་བཟླས་ན་དགྲའི་དཔུངས་ཇི་ལྟ་བུ་ཡང་ངེས་པར་རེངས་བར་འགྱུར་རོ། ། དེ་ནས་ཆར་དབབ་པའི་ལས་བརྗོད་པར་བྱ་སྟེ།",
    "ཨོཾ་མཱ་རཱི་ཙྪཾ་བི་སུ་ལ་བ་རེ་ནཱ་གེ་ནཱ་ག་ཧྲྀ་དཱ་ཡ་བ་དྷ་ཛྭ་ལ་ཛྭ་ལ་སརྦ་ནཱ་ག་ཧྲྀ་ད་ཡཾ།",
    "མ་ཧཱ་ནཱ་ག་ཏེ་ཛ་བ་རེ་སྭཱ་ཧཱ།",
    "ཕྱག་བརྒྱད་ལ་ཀླུའི་རིགས་ཀུན་རྒྱན་དུ་འཆང་བར་མཛད་པ་སྦྲུལ་མགོའི་གདེངས་ཀ་ཕྱོགས་ཀུན་ཏུ་གཡོ་བའི་ཁ་ནས་སྤྲིན་དང་གློག་གི་ཚོགས་འཕྲོ་བ་ཀླུ་དེ་དག་ཁ་ཐུར་དུ་བལྟས་ཏེ་ཆུ་སྐྱུགས་པ་དང་།",
    "རྒྱ་སྐྱེགས་རྣམས་བུ་རམ་གྱི་ཆུས་རྒྱ་ཤུག་གི་རྡོ་རྗེ་མཆུ་ལས།",
    "༡ དཀྲིས་ཏེ་རྒྱལ་གསུམ་ལ་འོད་ཟེར་ཅན་གྱི་སྐུའི་མདུན་གསང་བའི་གནས་སུ་མཆོག་གི་ཁར་བཅུག་ནས་སྔགས་བཟླས་པས་རྟགས་ཐོབ་པའི་ཚེ་ས་སྟེང་ན་ནོར་གྱི་དྲུག་ཆ་ལེན་ཞིང་བུད་དེ་དག་རྒྱལ་མཚན་གྱི་རྩེ་ལས་མ་གྲོལ་བ་སྲིད་དུ་ཆར་འབེབ་པར་བྱེད་དོ།",
    "བལ་པོ་སེའུའི་ཤིང་གི་ལྕུག་མའང་གསུངས།",
    "ཀླུ་གང་གི་མིང་བཟུང་བར་བྱས་པའི་ཀླུ་དེ་འཁྲུགས་ནས་རང་གི་གནས་ལ་མི་དགའ་བས་ཕྱིར་མི་འགྲོ་བར་ར་",
    "དེ་ནས་ཡུངས་གར་རེ་རེ་ལ་སྟོང་རྩ་བརྒྱད་བཟླ་ཞིང་ཀླུ་དེ་ལ་གདབ་པར་བྱ།",
    "མི་རོའི་ཞག་དང་བུད་མེད་ཀྱི་སྣ་དུར་ཁྲོད་ཐལ་བ།",
    "ཤིང་ཏ་ལ་དང་བཅས་པའི་གི་ཝཾ་དང་མ།",
    "ཅོ་པཎ་རལ་བའི་རྩེ་མོར་མངོན་མཆོད་བཞིན།",
