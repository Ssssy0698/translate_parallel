    "ཡན་ལག་རྣམས་ཀྱང་རྟོགས་པར་བྱ།",
    "བཅུ་གཅིག་པ་ཁྱད་པར་གཟུགས་ཅན་ནི།",
    "ཀུན་དགའི་དཔྱིད་དུ་མི་ནུབ་བརྟན་པར་བྱས།",
    "ཤར་གྱི་སྤོ་མཐོན་ཕྲག་པར་མི་འཛེག་ཅིང་།",
    "རབ་དཀར་གཉིས་སྐྱེས་ཚོགས་རྣམས་གནས་པར་འོས།",
    "འདོད་སྟེར་དབྱངས་ཅན་བུང་བས་བརྩེ་བཞིན་པར།",
    "བཞུགས་དེའི་སྒྲིབ་བྱེད་དྲི་མའང་འབྱིན་པར་ནུས།",
    "བསྒྲལ་བར་བྱས་སོ་འགྲོ་བ་མ་ལུས་ཀུན།",
    "གཞན་དུ་ཐར་མེད་རྣམ་པར་བསྡམས་པར་གྱུར།",
    "རྣམ་པར་མྱོས་པའི་གནུབས་རིགས་རྡོ་རྗེ་འཛིན།",
    "བཅོམ་ཞིང་བསྟན་འགྲོའི་ཕན་བདེ་རྒྱས་པར་བྱས།",
    "དྲེགས་ལྡན་ཚོགས་ཀྱིས་གུས་པས་ཕྱག་བྱས་པ།",
    "འགའ་ཞིག་དབེན་པར་དོན་སྒོམ་ཀུན་ལས་འཕགས།",
    "མང་དུ་ཐོས་དོན་བསམ་པས་ངེས་བྱས་པའི།",
    "འགྲོ་བ་ཀུན་ལ་ཕན་པར་མཛད་པ་རྫུན།",
    "དཔག་པར་དཀའ་སྟེ་འབྱུང་ལུས་སྙིགས་མའི་ལྷག།",
    "དྲང་སྲོང་ཆེན་པོ་བཟོད་པར་སྨྲ་བ་དེས།",
    "ནགས་དེར་གཤེགས་པར་བཞེད་ན་དེ་བཞིན་མཛོད།",
    "འོན་ཀྱང་ཞིང་འདིའི་མགོན་དུ་རྟག་བཞུགས་ཤིག།",
    "སྒྲིལ་བར་བཞེད་ན་དུབ་པར་མ་གྱུར་ཅིག།",
    "གཤེགས་པར་བཞེད་ན་མྱུར་བ་ཉིད་དུ་བྱོན།",
    "བསྟུན་ནས་གཤེགས་ཞེས་འཇེབས་པར་གསོལ་སེམས་ཀྱང་།",
    "འཛིན་པར་འོས་ཞེས་དམ་པ་ཀུན་གྱིས་བསྔགས།",
    "ད་ཀོ་མ་གཤེགས་བཞུགས་ནའང་ཉམ་ཆུང་བདག།",
    "མཁྱེན་གཉིས་ལྡན་པའི་མགོན་འདི་བཞུགས་བཞིན་དུ།",
    "ངོམས་པ་མེད་པར་ཆུ་ཕྲན་སྡུད་ལ་ལྟོས།",
    "སྦྱིན་པ་པོ་ཞེས་བསྟོད་པར་མི་བྱེད་དེ།",
    "ལེན་པར་བསམས་ནས་དེ་བར་སྤྱོད་ཕྱིར་རོ།",
    "དེའི་སྒྲུབ་བྱེད་ཀྱི་རྟགས་ནུས་པ་ཅན་གཞན་ཞིག་འགོད་པར་བྱེད་པ་སྟེ།",
    "ངེས་པ་ལ་ནི་སུ་ཡིས་འགོང་པར་ནུས།",
    "གཉིས་པ་ཁྱད་པར་ལ་གནས་དོན་གཞན་བཀོད་པ་ནི།",
    "ཀུན་ཏུ་མཛེས་པར་བྱེད་པ་མ་ཡིན་ནམ།",
    "སེམས་མེད་བླུན་པར་གྱུར་ཀྱང་ཕན་བདེའི་ཆར།",
    "འབེབས་པར་ནུས་པ་ཡིད་བཞིན་ནོར་མིན་ནམ།",
    "ཉི་མས་ཉམས་པར་བྱེད་ན་ཐབས་ཅི་ཡོད།",
    "དམུས་ལོང་ལྕེབས་པར་བྱེད་ནའང་འོས་མིན་ནམ།",
    "སླར་ཡང་མི་མཚུངས་པའི་ཁྱད་པར་འགའ་ཞིག་བསྟན་པར་བྱེད་པ་སྟེ།",
    "མི་གཙང་འདམ་གྱིས་གེགས་བྱེད་ནོར་བུ་འདིས།",
    "ཉེ་རིང་མེད་པར་ཀུན་ལ་ཕན་འདོགས་ཀྱང་།",
    "བསྐུལ་བ་མེད་པར་རྐང་དྲུག་གླུ་དབྱངས་ཀྱིས།",
    "མ་བཀུག་ན་ཡང་རྣམ་པར་དུད་པའི་ལུས།",
    "མ་བརྒྱན་པར་ཡང་མཛེས་སྡུག་ངོ་མཚར་གྱིས།",
    "སྤྲིན་བྲལ་མཁའ་ལ་རྣམ་པར་རྒྱུ་བ་འདི།",
    "རི་དྭགས་གཟུགས་ཀྱི་མཚན་མས་རྣམ་པར་བརྒྱན།",
    "གདུག་པའི་སྦྲུལ་གྱིས་རྣམ་པར་མ་དཀྲིས་ཤིང་།",
    "ཟླ་གཞོན་འཆར་ཀའི་འོད་ཀྱིས་མཚོན་མ་ལགས།",
    "རྒྱུ་སྐར་བདག་པོའི་དཀྱིལ་འཁོར་མིན་པར་ངེས།",
    "ཟོལ་ལ་བརྟེན་ཏེ་བག་ཕབ་བཞུགས་སམ་ཅི།",
    "མཐིང་ཞུན་མདངས་ཅན་ལྷག་པར་འཕེལ་བ་འདི།",
    "བསྐྱེངས་ཏེ་ནམ་མཁའི་གནས་སུ་འཁོད་པར་ངེས།",
    "སྐྱེད་བྱེད་དམ་ཤེས་བྱེད་ཀྱི་རྒྱུ་ལས་འབྲས་བུའམ་བསྒྲུབ་བྱ་འགྲུབ་པར་སྟོན་པ་སྟེ།",
    "རྒྱལ་སྲས་རྣམས་ཀྱིས་ལེགས་པར་བཀྲལ་རྣམས་དང་།",
    "མེ་ཏོག་གཞུ་ཅན་རྣ་བའི་དུག་ཏུ་བྱས།",
    "ཚིག་དོན་མ་ངེས་བརྩོན་པས་མ་གོམས་པར།",
    "མགྲིན་པའི་ལྡིང་ཁང་དབུས་སུ་ཕེབས་པ་དང་།",
    "ཀུན་མཁྱེན་ཁྱེད་ལ་རིགས་ཤིང་འོས་པ་ཉིད།",
    "གྲགས་པའི་ཁྲི་ལ་ཞབས་ཟུང་བསྟི་བྱས་ནས།",
    "ད་དུང་ལན་གཅིག་མིན་པར་བསྟན་དུ་གསོལ།",
    "ར་རོའི་ངན་སྐྱུག་སྐྱུག་དང་ལྷན་ཅིག་པར།",
    "མི་གཙང་ཕྱི་སས་གང་བའི་དོ་ར་ན།",
    "རང་རིག་དམར་སེར་གོས་ཀྱིས་སྒྲིབ་པར་མཛོད།",
    "རྣམ་པར་བརྒལ་བའི་གོ་འཕང་ཀུན་གྱི་མཆོག།",
    "དཀའ་བ་མེད་པར་རྙེད་འདི་ཨེ་མ་མཚར།",
    "རྟོག་གེའི་གཡང་སར་འཕྱན་རྣམས་མ་འཇིགས་པར།",
    "འདོད་དོན་དངོས་སུ་མ་བརྗོད་པར་དེ་འགྲུབ་པའི་ཆེད་དུ་ཚིག་སྦྱོར་གྱི་རྣམ་པ་གཞན་གྱི་སྒོ་ནས་བརྗོད་པ་སྟེ།",
    "ཆར་ཟིམ་བདུད་རྩིའི་རྒྱུན་བཟང་བབ་པར་གྱུར།",
    "ཚིག་སྦྱོར་གཅིག་ཉིད་ལ་བརྗོད་བྱའི་དོན་ཐ་དད་ཡོད་པར་སྟོན་པ་སྟེ།",
    "འདབ་མ་རྣམ་པར་རྒྱས་ཤིང་མུན་པའི་སྐབས།",
    "དབྱར་དུས་རྣམ་པར་རྒྱས་པའི་ཉལ་འགྲོ་མས།",
    "སྐྱེ་བོ་འདི་དག་ཐུར་དུ་འཁྲིད་པར་བྱེད།",
    "མངོན་རྟོགས་བསླབ་གསུམ་རྒྱུད་ལ་བསྟེན་པར་བྱས།",
    "ཆུ་ལྷའི་ཕང་པར་དལ་གྱིས་ཞུགས་པ་ཡིས།",
    "སྲེད་ལྡན་ཆགས་པ་དྲག་ཏུ་རྒྱས་པར་གྱུར།",
    "ཉེར་ལྔ་པ་ཁྱད་པར་བརྗོད་པའི་རྒྱན་གྱི་མཚན་ཉིད།",
    "རྒྱུ་འགའ་ཞིག་ཁྱད་པར་འཕགས་པ་བསྟན་པའི་ཕྱིར།",
    "འབྲས་བུ་སྐྱེད་ནུས་པར་སྟོན་པ་སྟེ།",
    "དང་པོ་ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "ཇི་ཙམ་འཕངས་ཀྱང་བརྫི་བར་ནུས་མ་ལགས།",
    "གཉིས་པ་རིགས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "གསུམ་པ་བྱ་བ་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "ཡིད་འོང་གླུ་དང་གར་གྱིས་མ་བསུས་པར།",
    "བཞི་པ་རྫས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "རི་སུལ་དབེན་པར་བསམ་གཏན་ལ་བརྩོན་པས།",
    "འདི་གསུམ་ལྷན་ཅིག་རྣམ་པར་འཕེལ་བར་འགྱུར།",
    "འགྲོ་ལ་ཕངས་པ་མེད་པར་སྦྱིན་མཛད་ནས།",
    "སྲིད་དང་རྣམ་པར་གྲོལ་བ་རྣམ་གསུམ་གྱི།",
