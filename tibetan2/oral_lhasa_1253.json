    "མཛེས་ལྡན་གདོང་པར་དཔལ་སྟེར་བ་སྟེ་ཀུ་མུད།",
    "ཟླ་བའི་མཛེས་པ་དག་ཀྱང་འཕྲོག་པར་བྱེད།",
    "འདབ་ལྡན་པདྨའི་ཚོགས་རྣམས་བཞད་པར་བྱེད།",
    "ཡང་དག་ཤེས་བྱའི་སྣང་རྒྱས་པར་གྱུར་རོ།",
    "བཞིན་རས་ཅན་གང་འདི་བཞུགས་ལ།",
    "དྲི་མེད་ཀུན་གསལ་ཡངས་པར་ལེགས་རྒྱུ་བའི།",
    "རབ་ཏུ་བཞད་བྱས་མཚན་དུས་ཟུམ་པར་གྱུར།",
    "ག་ཞར་བྱས་ནས་གོམ་སྟབས་འདོར་བ་ཡི།",
    "ཡིད་རབ་ཕྲོགས་ཏེ་དགའ་བས་ཚིམ་པར་གྱུར།",
    "བདག་ལྟའི་བློ་དམན་གྱིས་ཇི་བཞིན་པ་ཅི་ལ་རྟོགས་ལགས་རུང་།",
    "ནམ་མཁའ་ལའང་ཁ་ཞེས་མངོན་གསུངས་ཏེ།",
    "མཁའ་འགྲོའང་འདིར་ཉི་མ་ཡིན་པས་ཟློས་པར་དགོངས་ན་ནས་མ་བསྒྱུར་བ་འདྲ་སྟེ།",
    "དེ་རྣམས་འདྲ་འདུས་རིང་པོ་བྱས་པས།",
    "ཧྭ་ཕྱི་མར་ང་རོ་སྦྱར་བ་ཡིག་ནོར་རམ་སྒྲའི་སྦྱོར་བ་ཁྱད་པར་བས་བསྒྲུབས་པ་གང་ཡིན་མ་ངེས་ལགས།",
    "ཁ་ནི་ཡི་གེ་གཅིག་པར།",
    "ཀ་ཞེས་པ་འགྲོ་བའི་དོན་ཅན་འཇུག་པར་བསྒྱུར་བའམ།",
    "ཡང་ན་ཀ་བདེ་བའམ་ཚངས་པ་སོགས་ལའང་འཇུག་པས་གངྒཱའི་ཆུར་བཀྲུས་པས་ཚངས་པ་སྟེ་དག་པའི་དོན་ཡིན་ཀྱང་འཇོམས་པའི་སྒྲ་དང་ཟློས་པས་འཁྲུ་བའི་དོན་གྱིས་ཁྲུས་ལ་འཇུག་པར་འགྱུར་རམ་སྙམ་སྟེ།",
    "བཞུགས་ལ་བློ་གྲོས་སྤོབས་པའི་སྒོ་ཕྱེ་ཞིག།",
    "འཇིག་རྟེན་ཁེངས་པར་པུས་ནུབ་ཙམ་ཕབ་ནས།",
    "འཛུམ་པར་བྱས་ནས་སྙན་པའི་ཚིག་འདི་སྨྲས།",
    "རྣམ་པར་རྒྱལ་བའི་འདུན་ས་ཆེར་སྤྱོད་པའི།",
    "སྤུད་པར་བྱས་པའི་འཁྲི་ཤིང་གཞོན་ནུ་ནི།",
    "རྒྱུད་སྟོང་ལྡན་པའི་པི་ཝང་སྙན་པར་འཁྲོལ།",
    "འདབ་ལྡན་པདྨ་གཞོན་ནུས་རབ་མཛེས་པར།",
    "རབ་སྙན་རྒྱུད་མང་སྒྲ་དབྱངས་སྙན་པར་འཁྲོལ།",
    "ཀུན་གསལ་མཛེས་མའི་བཞིན་རས་ངོས་ཡངས་པར།",
    "ལྷ་ལམ་ཡངས་པར་ཆུ་འཛིན་ཕྲེང་འཁྲིགས་ཤིང་།",
    "བློ་གྲོས་རིགས་པར་ལྡན་པའི་སྐྱེས་བུ་རྣམས།",
    "ཤེས་བྱ་ཅུང་ཟད་ཤེས་པར་གྱུར་པ་གང་།",
    "གཉིས་སྐྱེས་རྒྱལ་པོའི་ཁེངས་པ་ཕྲོགས་པར་བྱས།",
    "གཅིག་མིན་ལན་གྲངས་མང་པོར་སྐྱུག་པར་བྱེད།",
    "དབེན་པར་ཉལ་བའི་རྐང་དྲུག་གཉིད་སད་ནས།",
    "རྒྱུད་སྟོང་ལྡན་པར་ཡང་ནས་ཡང་དུ་བསྒྱུར།",
    "འདབ་ལྡན་པདྨ་གེ་སར་རྣམ་པར་བཞད།",
    "དགའ་བའི་དཔལ་གྱིས་ཚིམ་པར་བྱེད་པས་ཀྱང་།",
    "རྨོངས་བདག་གུས་པའི་ཡིད་ཀྱིས་ཕྱག་བྱས་སོ།",
    "འདབ་ལྡན་ཆུ་སྐྱེས་ཟུམ་པར་མི་བྱེད་པས།",
    "ཞལ་གྱི་དཀྱིལ་འཁོར་མཚུངས་ལས་ཁྱད་པར་འཕགས།",
    "གསུམ་པོ་འདི་དག་ཕན་ཚུན་རྣམ་པར་འགལ།",
    "རྒྱུད་སྟོང་སྙན་པར་འཁྲོལ་བས་དྲི་ཟའི་གླུ།",
    "རྐང་དྲུག་ལྟར་གནག་ཟུར་མིག་རྣམ་པར་གཡོ།",
    "ཞལ་གྱི་པདྨའི་འདབ་མ་རབ་བཞད་པར།",
    "ཤེས་འདོད་ལྡན་པའི་ཚོགས་རྣམས་ངོམས་པར་གྱུར།",
    "བསྐྱོད་པར་མཛད་པའི་བྱ་བ་རྩོམ་པ་ཡང་།",
    "བློ་གྲོས་ཤེས་རབ་སྣང་བ་རྒྱས་པར་བྱེད།",
    "འགྲོ་དོན་སྤྱོད་ལ་བར་དུ་བརྩོན་པར་མཛད།",
    "མི་འགྱུར་སྒྲིབ་པར་བྱེད་པ་འདི་ཅི་ཞིག།",
    "འདབ་ལྡན་ཀུ་མུ་དཱ་ཡི་ཁྱད་པར་ཡང་།",
    "ཡོན་ཏན་དེ་དག་རྣམས་ཀྱིས་བརྒྱན་པར་གྱུར།",
    "དབྱངས་ཅན་ཞལ་བཟང་ལྟ་བ་འགོག་པར་བྱེད།",
    "བྱུགས་པ་མིན་པར་ཞལ་གྱི་མཆུ་སྒྲོས་དམར།",
    "བཞུ་བའི་ཁུ་བ་ཕྱིར་གྱིས་བྱུགས་པར་ངེས།",
    "ཀུན་གྱི་ཡིད་འཕྲོག་རྣམ་པར་བཀྲ་གྱུར་པའི།",
    "ནུབ་ཕྱོགས་ཆུ་ལྷའི་ཕང་དུ་བཞུགས་པ་བཞིན།",
    "ཤིན་ཏུ་འཇིགས་ནས་ཀླད་པ་འགེམས་པར་བྱེད།",
    "ཆེས་ཆེར་དམན་པས་ཞན་པར་གྱུར་པ་ཡང་།",
    "སྣང་གླུ་བླངས་པས་རིང་པོ་མ་ཐོགས་པར།",
    "ཡིད་འོང་ཆུ་སྐྱེས་པད་གདན་རྒྱས་པར་གྱུར།",
    "དད་པའི་འདབ་གཤོག་རྣམ་པར་གཡོ་ལྡན་པས།",
    "ཏིང་འཛིན་ཉེར་ཞིར་མཉམ་པར་མ་བཞག་ལ།",
    "རིག་པའི་གནས་ལ་སྦྱངས་པར་མ་བྱས་པས།",
    "ཡིད་བདེའི་དཔལ་གྱི་ཚིམས་པ་ཐོབ་པར་གྱུར།",
    "འབྲས་བུ་དག་ནི་ཡོད་པར་འགྱུར་མ་ཡིན།",
    "རྨད་བྱུང་བློ་གྲོས་རྒྱས་པར་མཛད་པ་ན།",
    "ལྷན་ཅིག་བློ་གྲོས་དག་ཀྱང་རྒྱས་པར་གྱུར།",
    "ཡན་ལག་ལྔ་པའི་ཀུན་ད་ཟུམ་པར་གྱུར།",
    "མ་ལུས་སྐེམས་པར་བྱེད་གང་ཨེ་མ་མཚར།",
    "མཉམ་པར་བཞག་ལ་གཡོ་བ་མི་མངའ་བར།",
    "འགྲོ་དོན་འབད་པ་མེད་པར་མཛད་འདི་ཅི།",
    "རྟག་པར་སྙན་པའི་གླུ་དབྱངས་ལེན་བྱེད་ཅིང་།",
    "རྨེག་མེད་བརླག་པར་བྱེད་ཅེས་བདུད་ཀྱི་ཚོགས།",
    "སྤངས་ན་འདི་ཡིས་འཇོམས་པར་བྱེད་མི་འགྱུར།",
    "གང་དེས་ཞལ་བཟང་མཛེས་པ་བསྟན་པར་གྱུར།",
    "དོན་གྱིས་བདུད་གནས་མུན་པར་བྱེད་པའི་ཕྱིར།",
    "དབྱངས་ཅན་གྱིས་ནི་བློ་གྲོས་རྒྱས་པར་བྱེད།",
    "ཁྱད་པར་བརྗོད་པའི་རྒྱན་ལས།",
    "ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ།",
    "རིགས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ།",
    "བྱ་བ་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ།",
    "རྣོ་དབལ་མཆེ་བ་གཙིགས་པར་མ་བྱས་ཤིང་།",
    "མ་ལུས་འཇོམས་པར་བྱེད་གང་ཨེ་མ་མཚར།",
    "རྫས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ།",
    "རྣོ་དབལ་མཚོན་ཆ་དག་ཀྱང་ཡོད་མིན་པར།",
    "ངལ་མེད་བདེན་པར་གནས་པའི་རི་དྭགས་ཚོགས།",
