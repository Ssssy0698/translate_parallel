    "དེ་དག་ལ་གསོལ་བ་བཏབ་པས་གང་དག་དངོས་སུ་མཇལ་བ་དང་ཁྱད་མེད་པར་གསུངས།",
    "ཨོ་རྒྱན་ཡབ་ཡུམ་གྱིས་ཚེ་ཡི་སྒྲུབ་པ་གནང་།",
    "ཞེས་གསུངས་པ་ལྟར་ཚེ་དཔག་མེད་ཀྱི་གནས་ཡིན།",
    "རང་བྱོན་དང་བཀོད་པ་སོགས་ཕུན་སུམ་ཚོགས་པར་བཞུགས་སོ།",
    "ཉི་ཤུ་རྩ་བཞིའི་དཔའ་བོ་མཁའ་འགྲོ་བཞུགས",
    "བཅོམ་ལྡན་རྒྱལ་བ་རིགས་ལྔ་བྲག་ལ་རང་བྱོན་དུ་བཞུགས།",
    "ཞེས་གསུངས་པ་ལྟར་སེང་གདོང་མཁའ་འགྲོའི་གནས་ཀྱང་ཡིན་ནོ།",
    "དྲང་སྲོང་སོགས་ཀྱང་འདིར་འབྱོན་བཞུགས་མཛད་པར་གྲགས་སོ།",
    "ལྷོ་ཕྱོགས་སུ་སྲ་ཕུའི་མགོན་ལྷ་དཀར་པོ་དང་རྗོད་ཀྱི་རྒྱང་ལྷ་སྨུག་པོ་གཉིས་ཡིན་པར་གྲགས།",
    "དང་པོ་སྲ་ཕུའི་མགོན་ལྷ་དཀར་པོ་ནི་གནས་འདིའི་ལྷོ་ཕྱོགས་ཁམས་སྟོད་ཤོད་ཆེན་བཅོ་བརྒྱད་ཅེས་གྲགས་པ་ལས་རྒྱལ་ཤོད་བན་སྒར་གྱི་ལུང་པར་གནས་ཤིང་།",
    "བསིལ་ལྡན་ཁ་བ་དཀར་པོས་གཡོག་པའི་རྡུལ་བརྩེགས་ལ་ཡན་ལག་བརྒྱད་ལྡན་གྱི་མཚོ་དང་མཚེའུ་མང་པོས་བསྐོར་བ་བཀོད་པ་ཁྱད་པར་དུ་འཕགས་པ་འདིར།",
    "ཨོ་རྒྱན་ཆེན་པོས་བྱིན་གྱིས་བརླབས་པའི་གནས་བྲག་དཀར་ཤེལ་གྱི་བ་གམ་བརྩེགས་འདྲ་རི་བོ་མཆོག་རབ་ཀྱི་གཟུགས་ལྟར་བཀོད་པ་ཁྱད་པར་དུ་འཕགས་ཤིང་།",
    "གནས་ཀྱི་བཀོད་པ་མཚན་ཉིད་སོགས་མ་ཚང་བ་མེད་པ་ལྷ་སྔགས་རང་བྱོན་སོགས་ཀྱང་དཔག་མེད་བཞུགས་པའི་གནས་ཏེ།",
    "དེ་ནི་ས་ཡི་ཆགས་ལུགས་དང་གནས་ཀྱི་མཚན་ཉིད་སོགས་རྒྱ་གར་གྱི་དུར་ཁྲོད་བསིལ་བ་ཚལ་གྱི་བཀོད་པ་ལྟར་དུ་ཡོད་པར་གྲགས།",
    "ཁམས་ཤག་ནུས་པ་ཇེ་ཆེར་འགྲོ",
    "ཞེས་སོགས་གསུངས་པ་དང་།",
    "ཞེས་སོགས་གསུངས་ནས་ལན་གཅིག་མིན་པར་ཡང་ཡང་བསྔགས་པའི་གནས་ཁྱད་པར་དུ་མས་འཕགས་པ་ཡིན་ཕྱིར་མཆོག་ཐུན་གྱི་དངོས་གྲུབ་ངེས་པར་འབྱུང་སྟེ།",
    "སྒྲུབ་པ་བྱས་ན་མཁའ་འགྲོས་དངོས་གྲུབ་སྩོལ",
    "རྣམ་པར་འཇོམ་པའི་གཟུངས་བཟླས་ཤིང་བཀྲུས་ན་མནན་གཏད་སེལ་གསུམ་གྱི་གནོད་པ་སེལ",
    "སྨེ་བ་བརྩེགས་པའི་སྔགས་བཟླས་ཤིང་བཀྲུས་ན་ཟས་གོས་གནས་དང་འཁོན་ཡུགས་དམ་གྲིབ་ལ་སོགས་མི་གཙང་བའི་གྲིབ་ཐམས་ཅད་སེལ",
    "སྐུ་རྗེས་དང་ཕྱག་ཞབས་ཀྱི་རྗེས་སོགས་མ་འོངས་པའི་རྟེན་སྐལ་དུ་བཞག་པས་གསོལ་བ་བཏབ་ན་ཡིད་ལ་འདོད་པའི་དངོས་གྲུབ་འཐོབ་པར་གསུངས་པ་དང་།",
    "གནས་འདིར་སྒྲུབ་པ་བྱས་ན་པདྨ་ང་དང་མཉམ་ཞེས་དང་།",
    "ཚེ་སྒྲུབ་བྱས་ན་ཚེ་ཡི་རིག་འཛིན་འཐོབ",
    "ནོར་སྒྲུབ་བྱས་ན་ནོར་གྱི་དངོས་གྲུབ་འབྱུང་",
    "ཁྱད་པར་སྤྲེའུ་ཟླ་བའི་ཚེས་བཅུ་ལ",
    "ཞེས་གསུངས་པ་བཞིན་དུ་དགོས་ཏེ།",
    "དེ་དག་སོགས་རྟེན་བཞེངས་ཞིབ་རྒྱས་གནང་།",
    "རྡོ་རྗེ་ཕུར་པའི་རྡོ་སྐུ་དེ་ནི་གཏེར་ཆེན་ཉིད་ཀྱི་ཕྱག་བཟོ་ཡང་ཡིན་པར་གྲགས།",
    "དེའི་སྟེང་དུ་ཉི་གྲགས་ཡབ་སྲས་གཙོས་པའི་བླ་བྲང་ཆེ་ཁག་བཅུ་གསུམ་ལ་སོགས་པས་རིམ་པར་བཞེངས་པ་སྐུ་གསུང་ཐུགས་རྟེན་ཕོན་ཆེན་དང་།",
    "གནས་དགོན་ཟུང་དུ་འབྲེལ་ནས་འཕེལ་ཞིང་རྒྱས་པ་དང་ཁྱད་པར་ཉི་དབོན་རྡོ་རྗེ་འཆང་ནས་དབུ་རྩེའི་མཚན་བརྒྱད་ལྷ་ཁང་དང་ཕྱོགས་ཀྱི་རི་ཁྲོད་རྟེན་བརྟེན་པར་བཅས་པ་སླར་གསོ་གནང་།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་གོང་དུ་བསྟན་པ་ལྟར་འཕེལ་རྒྱས་བྱུང་བ་ཡིན།",
    "ཁྱད་པར་སྐབས་སུ་བབ་པ་འདིར་ནི་ཨོ་རྒྱན་ཆེན་པོས།",
    "གནས་འདིའི་དབུ་རྩེར་ཕེབས་ནས་བུམ་གཏེར་སྦ་བ་དང་བསང་བརྔན་ཚོགས་འཁོར་སོགས་མཛད།",
    "ཁོ་བོ་ཡང་བསུས་ཏེ་བོད་དུ་ཆིབ་བསྐྱོད་གནང་།",
    "དེ་ནས་མེ་བྱི་ཟླ་བ་དྲུག་པ་སྔོན་མར་དེ་སྔོན་ཁོ་བོས་རྒྱུ་སྦྱོར་བ་བྱས་ཏེ་སོག་མཁར་དུ་རིག་གསུམ་མགོན་པོ་བཞེངས་པ་དགེ་སློང་ངེས་དོན་གྱིས་གཙོ་འགན་བཞེས་ཏེ་སོག་རོང་པ་རྣམས་ཀྱིས་དབུ་རྩེར་གདན་དྲངས་ལྷ་ཁང་སྔར་ལྟར་བཞེངས་ནས་བཞུགས་སུ་གསོལ།",
    "གདན་ས་གོང་མ་སྔར་ལས་ལྷག་པ་ལྟ་བུར་ལེགས་པར་གྲུབ་པའོའདིར་སྔར་གྱི་རྟེན་གསུམ་དང་བསྡུར་ན་བརྒྱ་ཆ་གཅིག་ལས་མེད་པ་ལྟ་བུ་ད་ལྟ་དངོས་སུ་མཇལ་རྒྱུ་ཡོད་པ་རགས་རིམ་འདི་བཞིན་ཏེཡིན་ཀྱང་།",
    "གཏེར་རྫས་ཀྱི་སྐོར་ལ་རྒྱ་གར་རྩ་མཆོག་དྲུང་ནས་གཏེར་དུ་བཞེས་པའི་ཀླུ་གསེར་དམར་ལས་གྲུབ་པ་སྒྲུབ་ཀྱི་ཐུགས་དམ་རྟེན་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེགནམ་ལྕགས་ཕྲ་མེན་ལས་གྲུབ་པའི་རྡོ་རྗེ་སོགས་དང་དེ་ཛམ་ལའི་སྐུ།",
    "ཁྱད་པར་ཅན་གྱི་ཕུར་པ་ཞལ་གསུམ་ཕྱག་དྲུག་རྟ་མགོ་ཅན།",
    "ལྷ་སྲས་མུ་ཁྲི་བཙན་པོའི་དབུ་ཐོད།",
    "ཤག་རོང་དགོན།",
