    "ཁྱེད་ལ་བདེ་ལེགས་མཛད་པར་འགྱུར།",
    "ཁྱེད་ལ་བདེ་ལེགས་མཛད་པར་འགྱུར།",
    "ཁྱེད་ལ་བདེ་ལེགས་མཛད་པར་གྱུར།",
    "འཕགས་པའི་བདེན་པ་རྣམ་གསུངས་པ།",
    "ཐུབ་པའི་སྙན་པ་གང་བྱུང་དེ་ ཁྱེད་ལ་བདེ་ལེགས་མཛད་པར་འགྱུར།",
    "ཁྱེད་ལ་བདེ་ལེགས་མཛད་པར་འགྱུར།",
    "བ་། ཨཱ་ནནྡ་ཀཱིརྟིའི་དོན་དུ་དཔའ་བོའི་འཁོར་ལོ་བྲིས་པ་བཞུགས། ། པཉྩ་པརྦ་ཏ་བི་ཀྲི་ཌ་མཉྫུ་གྷོ་ཥཱ་པཱ་ད་སྟུ་བྷྱཾ།",
    "འོད་ཟེར་དྲྭ་བས་ཞིང་ཀུན་ཁྱབ་མཛད་པར།",
    "རང་ཡང་མདུན་དུ་དམིགས་པར་བྱས་ནས་དེས།",
    "ལུང་དང་མི་འགལ་བར་བསམས་པར་ཟད་ཀྱི།",
    "ཨཱརྻ་ས་ཨཱ་ནནྡ་ཀཱིརྟིའི་དོན་དུ་དཔའ་བོའི་འཁོར་ལོ་ཉིད་བྲིས་པའོ། གུ་རུས་དཔར་རྩ་སྤེལ་བའོ།",
    "དབེན་ཞིང་ཉམས་དགའ་བའི་སྒྲུབ་ཁང་དུ་མཚམས་དམ་པར་བཅད་ལ་སྟེགས་བུའི་དབུས་སུ་མཎྜལ་ལ་སིནྡྷུ་ར་ཆང་དང་སྦྱར་བས་བྱུགས།",
    "གུ་གུལ་གྱིས་བདུག་སྲུང་བའི་འཁོར་ལོ་བརྟན་པར་བསྒོམ།",
    "ཁྲུས་གསོལ་རྒྱས་པར་བྱ།",
