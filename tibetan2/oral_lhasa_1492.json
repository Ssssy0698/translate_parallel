    "ལས་དང་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལ་སོགས་པ་སྟོན་པའོ།་",
    "སྐད་ལ་སོགས་པའི་བྱེ་བྲག་ཐ་དད་པར་བྱུང་བའོ།",
    "སེམས་ཀྱི་བདེ་སྡུག་མེདབ་མ་སྙོམས་པར་བྱེད་དོ།",
    "མ་དག་པ་སྣོད་བཅུད་ཀྱི་ཁྱད་པར་བསྟན་པ་ནི།",
    "གལ་ཏེ་སྣོད་དྲི་མ་ཅན་གཅིག་དུ་ཟས་ལ་སོགས་པ་གཙང་མ་བླུགས་ཀྱབདྲིམས་འགོས་པ་བཞིན་ནོ།",
    "གཏད་པས་སའི་ལས་དག་པར་བྱེད།",
    "ཡེ་ཤེས་དག་པ་དང་མ་དག་པའི་རྐྱེན་གྱིས་བྱས་སོ།",
    "ད་ནི་ནང་དོན་གཉིས་པ་སྐུ་དང་ཡེ་ཤེས་ཀྱི་བཞུགས་ཚུལ་བསྟན་པ་ནི།",
    "ཚོགས་པ་ནི་སྤྲུལ་པའི་སྐུའི་མཁྱེན་པའི་རྩལ་དུ་བཞུགས་སོ།",
    "བསྐྱེད་པར་བྱེད་པ་ཉིད་དང་ལྔ་དང་།",
    "རིག་པ་ཚད་ཕེབས་དང་།",
    "བསྐྱོད་པར་བྱེད་པ་དང་།",
    "མ་ཞེས་པ་བསྐྱེད་པར་བྱེད་པའི་མ་སྟེ།",
    "གསེས་ཤིང་ལུས་བསྐྱེད་པར་བྱེད་པ་ལྟར།",
    "རྐྱང་ལྕེམས་ལུས་བསྐྱེད་པས་ཀུན་དྷར་མས་ཡིད་བསྐྱེད་པར་བྱེད་པའོ།",
    "ཀུན་དྷརགས་སྐུ་རྣམས་བསྐྱེད་པར་བྱེད་དོ།",
    "སྒྲོན་མ་ཐམས་ཅད་ཀྱི་སྐུལ་སྦྱང་པར་བྱེད་དོ།",
    "དོན་དམ་པ་བསྐྱེད་པར་བྱེད་ལ།",
    "རྩ་འདབ་བཅུ་དྲུག་དུ་འཆག་པའི་བྱས་སོ།",
    "ཐིག་ལེས་འཕེན་པའི་ལས་བྱས་པས་སྒྲོན་མ་ནམ་མཁའ་ལ་གསལ་བའོ།",
    "རྣལ་འབྱོར་པའི་ལུས་སེམས་རྒྱས་པར་བྱེད་པ་སྟེ།",
    "འདི་དག་རྣམས་དུས་བཟང་པོ་ལ་ཁྲུས་བྱས་ཏེ།",
    "འབྲུ་མར་གྱི་སྐུ་མཉེ་བྱས་ལ།",
    "དྲག་པར་མཉེས་ན་ལུས་ལ་མེ་དྲོད་འབར་ངེས་གོ།",
    "ཐིག་ལེ་དམིག་དུ་དགུག་པར་བྱའོ།",
    "རང་གེ་རྐྱང་པར་འདོད་ཎྞཾཔས་སྙུག་མའི་སྦུབས་དང་འདྲ་སྟེ་སྟོང་པའ་ཡོད་པའོ།",
    "སེན་པར་སྦྱར་བའི་ཐིག་ལེ་གདབ་པར་བྱའོ།",
    "ལམ་གྱིས་ནི་རྩ་བཟུང་བ་དང་སེམས་དགུག་པ་གནང་།",
    "ནང་དོན་བཅུར་བྱས་ནས་བསྟན་ནོ།",
    "ད་ནི་ལུས་རྣམ་པར་བཞག་པ་བདུན་པ་ཡེ་ཤེས་ཀྱིས་འཆར་བའིགེའི་དྲིས་ལན་རྒྱས་བར་བསྟན་པ་ལ།",
    "དབྱིབས་ལ་སོགས་པ་རྣམས་འཛིན་པར་བྱེད་པ་དྲང་།",
    "དེ་ཡང་ས་ཀིད་རྣམ་པར་དག་པའི་ཡུལ་གྱི་སྣང་བ་འོད་ལྔ་དང་།",
    "རྒྱང་ཞགས་ཞེས་གཟུགས་ཀྱང་རིང་པོ་ནས་འཆིང་བར་བྱེད་པའོཞགམ་ཞེས་དེས་བཅིངས་པས་གཟུགས་ལ་བརྟེན་ནས་མཆོད་ཉིད་གཏན་ལ་འབེབས་པར་བྱེད་པའོ།",
    "ཞེས་ནང་དོན་དྲུག་བརྒྱང་ཞགས་ཆུའི་སྒྲོན་མ་རྒྱས་པར་བསྟན་ནས།",
    "བསྒྲལ་ནས་མྱ་ངན་ལས་འདུས་པའི་སྣང་བ་སྟོན་པར་བྱེད་པའོ།",
    "གཟི་མདངས་ཐིག་ལེ་དང་ཟེར་རྣམས་བསྐྱེད་པར་བྱེད་འོ།",
    "འབེབས་པར་བྱེད་པའོ།",
    "ད་ནི་ནང་དོན་དགུ་པ་དབྱིངས་རྣམ་པར་དག་པའི་སྒྲོན་མ་བསྟན་པ་ནིདེ་ཡངཡངསེཤིང་གསལ་ལ།",
    "རིག་པའི་གཞི་འཛིན་པར་བྱེད་པས་ན་དབྱིངས་སོ།",
    "དབྱིངས་རྣམ་པར་དག་པའི་སྒྲོན་མ་མངོན་གསུམ་དུ་གཟིར་བ་ལས་སྨིན་པ་ཀྱེ།",
    "ཞེས་ནང་དོན་དགུ་པ་དབྱིངས་རྣམ་པར་དག་པའི་སྒྲོན་མབསྟན་ནས།་།",
    "དེ་ཀེད་ལས་ལུས་ཐམས་ཅད་དུ་མ་འགུལ་པར་གནས་པ་ལས།",
    "ཁྲུས་དག་པར་བྱས་ལ།་",
    "སྒྲོན་མས་འོད་ཀྱི་སྣང་བ་སྟོན་པར་བྱེད་དོ།",
    "རྣལ་འབྱོར་པས་འཁྲིད་པར་བྱ་ཞིང་སྦྱང་བའི་འཕེལ་ལ་གཏད་པས།་",
    "དེ་ཡང་ལེགས་པར་སྟེང་འོག་དུ་དང་།",
    "ནམ་མཁའ་ཚོག་ལ་ཡང་བསླབ་པར་བྱའོ།",
    "དེ་ཉིད་ལས་བརྟེན་ནས་ཤེས་ཀྱི་སྣང་བ་མཆེད་པར་བྱེད་པའོ།",
    "དེ་རྣམ་པར་དག་པའི་མཚན་ཉིད་ནི།",
    "དབྱིངས་རྣམ་པར་དག་པའི་སྒྲོན་མ་ལ་བརྟེན་ནས་འཁྲུལ་པའི་སྣང་བ་གག་པོའབྱེད་པའོ།",
    "ཞེསཞང་དོན་བདུན་པ་དབྱིངས་རྣམ་པར་དག་བའི་སྒྲོན་མའི་མཚན་ཉིད་དངོས་བསྟན་ནས།",
    "རང་བཞིན་རྣམ་པར་དག་པའི་ཐིག་ལེ་འདུན་པ་དང་།",
    "དབྱིངས་རྣམ་པར་དག་པའི་སྒྲོན་མའི་ནང་དུ།",
    "འདི་ཉིད་དུས་དག་པར་འགྱུར་ཏེ།",
    "ཡིད་ཀྱི་འཕྲོ་འདུའི་རྩ་བ་གཅད་རུང་ནང་དུ་བཞག་པར་བྱའོ།",
    "མིག་ཕྱི་རོལ་གྱི་གཟུགས་ལ་བསླབ་པར་བྱའོ།",
    "ད་ནི་ནང་དོན་དྲུག་པ་མཚོན་པའི་དོན་རྒྱས་པར་དབྱེ་བ་དང་བཅས་ཏེ་བསྟན་པ་ནི་ཕབམཆོན་པ་གསུམ་སྟེ།",
    "རྒྱུད་ནི་ང་དོན་བདུན་པ་བརྗོད་པའི་དོན་རྒྱས་པར་དབྱེབ་དང་བཅས་པ་བསྟན་པ་ནི།",
    "ཞེས་ལུས་རྣམ་པར་བཞག་པ་བཅུ་པ་སྒྲོན་མ་དེ་ཉིད་འཆའ་བའ་བྱེད་བའི་ཕུལ་བསྟནཔ་ལ་བཅའ་བྱས་ནས་བསྟན་ནོ།་།",
    "ད་ནི་ལུས་རྣམ་པར་བཞག་པ་བཅུ་གཅིག་པ་སྒྲོན་མའིཏྟེན་།་བསྟན་པ་ལ་ནང་དོན་བཅུས་བསྟན་པའི་དང་པོ།",
    "དབྱིངས་རྣམ་པར་དག་པའི་སྒྲོན་མ་དང་།",
    "རྣམ་པར་དག་པ་ལ་བརྟེན་པའོ།",
