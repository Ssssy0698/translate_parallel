    "དེབ་འདིའི་བསྐྱར་པར་འགྲོ་སོང་གི་ཐད་ལ།",
    "ཡནལག་གི་དོན་བརྗོད་པར་བྱའོ།",
    "ཉོན་མོངས་པ་རྣམསདང་ཤེས་བྱའི་སྒྲིབ་པ་སྔར་ཞེས་བྱ་བར་ཚིག་རྣམ་པར་སྦྱར་བར་བྱ་སྟེ།",
    "འདི་ལྟར་འདོད་ཆགས་ལ་སོགས་བཉོན་མོངས་པ་རྣམས་ནི་བདགཏུ་ལྟ་བ་ལས་བྱུང་ངོ་ཞེས་སྣས་སོ།",
    "ཉོན་མོངས་པ་དང་ཤེས་༣ བྱའི་སྒྲིབ་བསྡངསཔ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་བ་སྨོས་སོ།",
    "འདོད་ཆགས་ལ་སོགས་པཉོནམོངས་པ་རྣམས་སྤང་བ་ནི་ཐརཔ་ཐོབ་པར་བྱ་བའི་ཕྱིར་རོ།",
    "འའཇུག་ལ་རེས་འགའ་མི་འཇུག་པ་དེ་ནི་རྒྱུག་ཞན་ལ་བལྟོས་པའི་ཕྱི་ཆགས་པ་ཞེས་བྱའོ།",
    "ཙམ་མོ་ དེའི་འབྲས་བུ་ནིས་རབཏུདགའ་བ་ལསོགས་པའོ།",
    "དེ་ལས་ནི་ཚིག་གི་དོན་འདི་འབྱུང་སྟེ།",
    "གྱུར་པའི་རང་གི་ངོ་བོ་བསྟན་པའི་ཕྱིར་གཞན་དུགྱུར་པ་སྟེ།",
    "གང་གི་ཚེ་དྷཱུའི་སྐད་ཅིག་འགག་ལ།",
    "དེ་ལྟར་གྱུར་པའི་རང་གི་ངོ་བོ་བསྟན་ནས།",
    "དེ་བཞིན་དུ་གཟུགསལ་སོགས་པར་རྣམ་པར་རྟོག་པས་བག་ཆགས་གང་སྐྱེད་པ་དོ་ཡང་གང་གི་ཚེ་ཡོངས་སུ་བརྟགས་པར་གྱུར་པ་དེའི་ཚེ།",
    "གཞན་དུ་ན་ནིངས་པ་མེད་པས་ཐམསཅད་ལ་ཐམས་ཅད་གདགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་མི་ཕྱིང་ཐལ་ཆེས་བྱ་བའི་སྐྱོན་དུ་ར་ཏ་དེ་ནས་ཀུན་རྫོབ་ཏུ་གཞི་ཅི་ཞིག་ཅིག་ཁས་བླང་བར་བྱའོ།",
    "དེའི་ཚེ་ཆ་ཤས་རེ་རེ་ནས་བསལན།",
    "གང་གི་ཕྱིར་དེ་ལྟར་བསགས་པ་ན་ཆ་ཤས་འདུས་པ་ཙམ་ལསགུད་ན་ཡོད་པ་མ་ཡིན་པར་ཡང་བསགས་པའི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་འདི་མྱོང་སྟེ།",
    "རྡུལ་ཕྲ་རབ་རེ་དེ་རྡུལ་ཕྲ་རབ་གཞན་ལ་མི་བལྟོས་པའི་དབད་པོའི་ཡུལ་དུ་མི་འགྱུར་གྱི།",
    "དེ་སྐད་སྨྲ་བ་དེ་དག་གི་གཞུང་ལྟར་ན་ཡང་རྡུལ་ཕྲ་རབ་རྣམས་ཉམས་སུའོང་ནས་རྡུལ་ཕྲ་ཪབ་རྣམས་བལྟོས་པ་དད་བཅས་པ་དང་མི་བལྟོས་པའི་དུས་ན་ཡད་དགས་པའི་མཚན་ཉིད་དུའགྱུར་བར་དང་བཞིན་བྱེ་བྲག་དུ་གྱུར་པ་མེད་དོ།",
    "ཕྲ་མོའི་རྣམ་པ་ནི་དགས་པའི་རྣམ་པ་ཤེས་པའི་ཡུལ་དུ་མི་རུང་སྟེ་ཧཅད་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་རྡུལ་ཕྲ་རབ་རྣམས་ཀྱི་ཚུ་རོལ་དང་ཕ་རོལ་དང་དགུང་གི་ཆ་ཤས་ཁས་མི་ལེན་ན་ནི།",
    "དེ་སྐད་ན་རེ་ཞིག་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་རྣམས་ཀྱི་ཡུལ་བཀག་གོ།",
    "འོངས་པ་དེ་དག་ནི་རང་གི་རྣམ་པའི་རྣམ་པར་ཤེསཔ་སྐྱེད་པ་མ་ཡིན་ཏེ།",
    "དལྟ་ཀྱི་སྐོར་བ་ལ་སོགས་པ་དག་ཀྱང་རང་གི་རྣམ་པའི་རྣམ་པར་ཞེས་པ་མི་སྐྱེད་དེ།",
    "གང་གི་ཆོ་རབ་ལ་སོགས་པ་སྐྱེས་པའི་ཆེནན་རྣམ་པར་ཤེས་པ་ཡང་དེའི་རྣམ་པར་སྐྱེས་པ་ཉིད་དོ།",
    "གཞན་དག་ན་རེཞེས་བྱ་བལ་སོགས་པའོ།",
    "ཅི་འདི་ལ་མེའི་སྤྱིའམ་འོན་ཏེ་མེའི་རང་གི་མཚན་ཉིད་ཉེབ་རའདོགས་ཤེས་བསྟན་པར་འགྱུར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་སྣས་སོ།",
    "རྣོ་བ་ཉིད་དང་སེར་བ་ཉིད་ནི་རིགས་ཆེ་ཞིང་མེད་ན་མོད་དེ།",
    "འདི་ལྟར་ཉེ་བརགདགས་པའིག་ཞ་དེ་ལྟ་བུ་རྣམ་པ་གཉིས་ཀ་ཡང་རིགས་ལ་མི་འཐད་པསདེའི་ཕྱིར་བྲམ་ཟེའི་ཁྱེའུལ་རགིས་ཉ་བར་འདོགས་པ་མི་སྲིད་པར་གནས་སོ།་",
    "མོའི་རྫས་ཀྱང་བྲམ་ཟེའི་ཁྱེའུལ་ཉེ་བར་། འདོགས་མི་སྲིད་དོ།",
    "འདི་ལྟར་བྱེ་བྲག་གང་ཡིནཔ་དེ་དག་ནི་རང་གི་གནས་དང་འབྲེལ་བ་ཡིན་གྱི།",
    "དེ་ལྟར་གྱུང་འནི་ཧེ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "འདི་ལྟར་དངོས་ཀྱི་རང་གི་ངོ་བོ་གད་ཡིན་པ་དོན་ཤེས་། པ་ཐམས་ཅད་དང་བརྗོད་པ་ཐམས་ཅད་ཀྱི་ཡུལ་ལས་འདས་པའི་ཕྱིར་རོ།",
    "རང་གི་དོ་བོ་ནིམི་རྟོགས་སོ་ཞེས་འདི་ནི་ཕ་རོལ་གྱི་གྲུབ་པའི་མཐའ།",
    "གཙོ་བའི་སྒྲ་ནི་འདིར་བྱེ་བྲག་གི་གཞིར་བརྗོད་པ་ཡིན་པརྫས་ལ་སོགས་པའོ།",
    "རང་གི་དོ་བོ་ནིམི་རྟོགས་སོ་ཞེས་འདི་ནི་ཕ་རོལ་གྱི་གྲུབ་པའིམཐའོ།",
    "གཙོ་བོའི་སྒྲ་ནི་འདི་བྱེ་བྲག་གི་གཞིར་བརྗོད་པ་ཡིན་པལྟས་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཤེས་པ་དང་།",
    "ཚིག་གང་གིས་བསྟན་ཞེས་དྲིས་པ་དན་དེའི་ཕྱིར་གྱུར་པ་དེ་ཡང་རྣམ་པགསུམསྟེ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "གཞན་དག་ནི་སྔ་མོནས་ཡོད་པའི་བག་ཆགས་ཀྱང་ཡོངས་སུ་རྟས་པར་བྱེད་ལ་སྔོན་མེད་པ་དག་ཀྱང་སྐྱེད་དོ་སྙམ་དུ་སེམས་སོ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡོད་དེ་གཉིས་ནི་རང་དང་མཐུན་པའི་འབྲས་བུ་ཅ་དྲུག་བསྒྲུབ་པའི་ཕྱིར།",
    "དེ་བས་ན་བྱེ་བྲག་བསྟན་པའི་དོན་དུ་རད་གི་མང་གིས་གྱུར་པ་གསུམ་པོ་བསྟན་པའ་ཕྱིར།",
    "དེ་ལྟར་ཀུན་གཞི་རྣམཔར་ཤེས་པ་ནི་ནང་གིཉེ་བར་ལེནཔ་སྣང་བ་དང་།",
    "ནང་གིཉེ་བར་ལེནཔ་དེ་ཇི་ལྟ་བུ་སྙམ་པ་ལ།",
    "དེལ་ནང་གིཉེ་བར་ལེནཔ་ནི་ཞེས་བྱབ་ལསོགསཔ་སྨྲས་སོ།",
    "དེ་ལས་ཚིག་གི་དོན་འདི་འབྱུད་སྟེ།",
    "དེ་ལས་ཚིག་གི་དོན་འདི་འབྱང་སྟེ།",
    "འདི་ནི་རྣམ་པར་ཤེས་པར་སྨྲབ་གཞན་དག་གིཞེས་བྱ་བལ་སོགས་པ་སྨྲས་སོ།",
    "རེག་པཞེས་པ་འདི་གང་ཡིན་སྙམ་པལ།",
    "དེ་ལ་རེག་པ་ཞིཞེས་བྱ་བ་ལོ་སོགས་པ་སྨྲས་ཏེ།",
    "འགྱུར་བ་བདེ་བ་ལ་སོགས་པ་མྱོང་བར་འགྱུར་བའི་རྣམ་པ་དེ་ཡོངས་སུ་གཅོད་པ་གང་ཡིན་པ་དེ་རེག་པའོ།",
    "རེག་པ་ནི་ཡུལ་གྱི་འགྱུར་བ་བདེ་བ་ལ་སོགས་པ་མྱོང་བར་འགྱུར་བ་ཡོངས་སུ་གཅོད་པ་སྟེ།",
    "ལས་དེ་ཡང་ལུང་གིས་བསྟན་། པའི་ཕྱིན།",
    "དམིགས་པ་ལ་གང་གིས་སེམས་མངོན་དུ་ཕྱོགས་པར་བྱེད་པ་དེ་ཡིད་ལ་བྱེདཔ་ཞེས་བྱ་སྟེ།",
    "འོནཏེ་འགའཞིགགི་ལས་ཡིན་ཞེན།",
    "དེ་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་འཇུག་པ་ནིམ་ཡིནཏེ།",
    "གང་གིས་ཡུལ་ཡིད་དུ་འོང་བ་ལ་སོགས་པ་མྱོང་བར་བྱེད་པ་དེ་ནི་ཚོར་བ་ཞེས་བྱབའི་༦ཐ་ཚིག་གོ།",
    "དེའི་ཕྱིར་བདེ་བ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གསུམ་དུ་འགྱུར་རོ།",
    "ལས་གང་གི་འབྲས་བུ་གང་ཡིན་པ་དེ་བསྟན་པའི་ཕྱིར།",
    "བདེབ་ཡངམ་ཡིན་པར་འདོད་པ་དེ་དགགི་གཞུང་ལྟར་ན་གཉིས་ཀའི་ཞེས་ནི་རྗོད་པར་མི་བྱའོ།",
    "དེ་ནི་འདི་སྐད་དུ་སྔོན་པོ་དང་སེར་པོལ་སོགས་བརྣམ་བོར་བཞག་པའི་རྒྱུ་གང་གིས་འཛིན་པ་དེ་ནི་འདུཤེས་སོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "འབྲས་བུའི་སྒོ་ནས་༦༣ འདིའི་རང་གི་ངོ་བོ་བསྟན་པའི་ཕྱིར།",
    "འདི་ལྟར་བདེ་བ་དང་སྡུག་བསྔལ་དགགི་དམིགས་པ་དང་རྣམ་པ་ནི་གསལ་བ་ཡིནལ།",
    "རེག་པལ་སོགས་པའང་དེ་བཞིན་ནོ་ཞེས་བྱབ་སྨྲས་སོ།",
    "རེག་པ་ལ་སོགས་པ་སྦྱར་བའི་ཕྱིར།",
    "ཅིའི་ཕྱིར་རེག་ཁལ་སོགས་པ་ཡང་ཀུནགཞི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་སྙམ་པལ།",
    "དེ་བས་ན་མི་འཇིགས་པ་མ་ཡིན་པའི་རང་གི་ངོ་བོར་འཇུག་གོ་ཞེས།",
    "རྒྱུན་གྱི་རང་གི་ངོ་བོ་བསྟན་བའི་ཕྱིར།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་བབསོ་ད་ནབ་ས་མ་ཡི་ནཔ་དང་མི་གཡོ་བའི་ལས་ཀྱི་བག་ཆགས་དང་ལྡན་པ་ཡང་རེག་པལ་སོགས་པ་བསྡུས་ནས།",
    "དེའི་ཚེ་དེ་ཉོན་མོངས་པའི་ས་བོན་གྱི་གཞི་ཉིད་དང་བྲལ་བར་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་གིས་དུས་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལྡོག་པ་དེ་ཉིད་ཀྱི་དུས་ན་དགྲ་བཅོམ་བ་ཞེས་བྱ་སྟེ།",
    "ཇི་ལྟར་མིགགི་རྣམ་པར་ཤེས་པལ་སོགས་པའ་གཞས་དང་དམིགས་པ་གྲགས་པ་དེ་བཞིན་དུ།",
    "དེའི་ཕྱིར་ཉོན་མོངས་པརྩན་གྱི་ཡིད་ཀུན་གཞི་རྣམ་པར་ཞེས་ལ་གནས་བཅས་ནས་འབྱུང་ཞེས་བྱའོ།",
    "འདི་ལྟར་ཉོན་མོངས་པ་ཅན་གྱི་ཡིང་ཅི་འཇིག་ཚོགསལལྟ་བ་ལ་སོགས་པ་ར་མཚུངས་པར་ལྡན་པ་སྟེ།"
  ]
}