    "དུས་རིང་དུ་ཡང་རྒྱལ་པོ་བྱེད་པར་འགྱུར་རོ།",
    "སྙན་པར་སྨྲས་པའི་རྒྱུ་དང་རྐྱེན་གྱིས་ལུས་ཞིག་པར་གྱུར་ནས་ཤི་བའི་འོག་ཏུ་འཐབ་བྲལ་གྱི་ལྷ་རྣམས་ཀྱི་མངའ་བདག་ཏུ་འགྱུར་རོ།",
    "བདེན་པའི་འོད་ཟེར་གྱིས་ཀུན་ན་ས་སྣང་བར་བྱས་པའི་ཕྱིར་རོ།",
    "ངམ་གྲོག་༡༢ཐམས་ཅད་དུ་རབ་ཏུ་ཞུགས་ན་མཆོག་ཏུ་སྐྱིད་༡༢པར་འགྱུར་རོ།",
    "རྨི་ལམ་ངན་པ་ཡང་འཇིག་པར་བྱེད་དོ།",
    "བདེན་པར་སྨྲ་བ་དེ་ཉིད་ཀྱི་གནས་སྐབས་དེར་ཡང་མཆོག་ཏུ་རྗེས་སུ་འཇུག་པ་དང་སླར་ཡང་ལེགས་པར་ལངས་ན་ས་འགྲོའོ།",
    "འདིའི་ཡིད་ལ་བསམས་༢པ་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ།",
    "ད་ལ་བུས་ཀྱང་རིམས་ན་ད་༤དེ་དག་རྣམས་ལེགས་པར་ཞི་བ་སྐྱེད་པར་འགྱུར་ཏེ།",
    "འཕེན་པར་བྱེད་དོ།",
    "རྣམ་པར་མ་གཙེས་པའི་སྐྱེས་བུ་རྣམས་ཀྱིས་ཀྱང་ནོར་ཆེན་པོའི་སྦས་དང་སྦས་པ་ཡང་རྒྱལ་པོ་ལ་སྟོན་པར་བྱེད་དོ་༩།",
    "བདེན་པར་སྨྲ་བ་ཞེས་ཟེར་ནས་ཐམས་ཅད་ལས་མི་གཡོ་བ་༡༢བཞིན་དུའོ།",
    "ཐམས་ཅད་ལས་ཀྱང་གཡོ་བ་མེད་པར་འགྱུར་རོ།",
    "གྲོགས་པོས་འཁྲིད་༡༡པར་མི་བྱེད་ད་དོ། ༐",
    "གྲོགས་པོ་མ་ཡིན་པས་འཁྲིད་པར་མི་བྱེད་ད་དོ།",
    "༡༢རྣམ་པར་གཡོ་བར་མི་བྱེད་དོ།",
    "དུ་བསམ་པར་བྱེད་པ་ན་ཡིད་ཁྲོ་བ་དང་ད་གའ་བ་ཡ་ཡ་པོས་མི་ཁྲིད་དོ།",
    "ཆུ་མེད་པར་ཡང་བདེན་པའི་རང་བཞིན་གྱིས་མཆོག་ཏུ་གཙང་བའི་བདེན་པའི་འཇུག་ངོས་སུ་འཁྲུ་བ་རྣམས་ནི་མཆོག་ཏུ་གཙང་བར་འགྱུར་རོ།",
    "གོས་མེད་པར་གྱུར་ཡང་མཆོག་ཏུ་ད་ཀར་༦བ་མ་བཏ་གས་པ་བདེན་པའི་གོས་མཆོག་ཏུ་རྒྱ་ཆེ་བ་སྐད་ཅིག་མ་ཡིན་པར་རྟག་ཏུ་ལེགས་པར་གྱོན་པར་འགྱུར་རོ།",
    "གྱུར་པ་ཞེས་བྱས་སོ།",
    "ཚེ་རིང་བར་གྱུར་༡༡འཕེན་པར་བྱེད་པའི་ལས་རྣམས་ཀྱང་འཕེན་པར་བྱེད་དོ།",
    "ཇི་སྲིད་དུ་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་སང་ས་རྒྱས་ཀྱི་ཡེ་ཤེས་ཀྱི་ལས་འཕེན་པར་བྱེད་ན་འཐབ་བྲལ་གྱི་མངའ་བདག་ལ་ལྟ་སྨོས་ཀྱང་ཅི་༡༢ད་གོས།",
    "རྒྱལ་པོ་འདི་ནི་བློ་བརྟན་པར་གྱུར་པ་སྟེ།",
    "གང་ཡང་རྒྱལ་པོས་རྣམ་པར་དཔྱད་༦ནས་ནོར་གཞིས་རྣམས་འཕེལ་བ་དང་འགྲིབ་པར་བྱེད་པའི་༐",
    "ལེགས་པར་རབ་ཏུ་བརྟགས་ནས་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཅི་ད་གའ་བའི་རྒྱལ་པོ་བརྫུན་༡དུ་སྨྲ་བ་དེ་ལ་འདོད་ཆགས་དང་བྲལ་བར་གྱུར་ནས་ཀྱང་རྒྱལ་པོ་གཞན་ཡང་ཉེ་བར་འཇོག་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་སྐྱོན་དེ་དག་རྣམས་གོ་བར་བྱས་ལ་བརྫུན་༢༢དུ་སྨྲ་བར་མི་བྱའོ།",
    "བརྫུན་༡༢དུ་སྨྲ་བ་ནི་འཇིག་རྟེན་འདིར་ཕན་པ་མ་ཡིན་ལ་འཇིག་རྟེན་ཕ་རོལ་ཏུ་ཡང་མ་ཡིན་ནོ་། དེའི་ཕྱིར་ན་མཐོང་བའི་ཚེ་ལ་ཡང་སྐྱོན་གྱི་རྣམ་པ་མང་པོ་དེ་དག་རྣམས་གོ་བར་བྱས་ལ་བརྫུན་༡༨དུ་སྨྲ་བར་མི་བྱའོ།",
    "གང་ཡང་རྒྱལ་པོ་གཅིག་ཏུ་རྟག་པ་ཁོ་ནར་བདེན་པ་སྨྲ་བར་གྱུར་པ་དེས་ནི་སྐྱེ་དགུ་༢༢བསྒོས་ནས་ངེས་པར་༐",
    "བར་བྱེད་པ་༡རྟག་ཏུ་དུལ་བར་གྱུར་པ་དེ་ནི་ནམ་ཡང་ནོར་གཞིས་རྣམས་ལ་ཀློ་བུར་དུ་འཕེལ་བ་དང་འགྲིབ་པར་མིབྱེད་དོ།",
    "རྒྱལ་པོ་དེ་ཡང་བློ་བརྟན་པར་འགྱུར་བ་དང་འགྱུར་བ་མེད་པའི་བློ་དང་བློ་གཅིག་ཏུ་ངེས་པ་དང་བདེ་བ་སྟེར་བར་བྱེད་པས་༦ལུས་ཞིག་ནས།",
    "མིའི་ཁྱད་པར་ཤེས་པར་བྱ་བར་གྱུར་པ་དེ་ཡང་ཤེས་པ་ཆེན་པོ་ཡིན་ཏེ།",
    "པོ་མིའིཁྱད་པར་རིག་པར་གྱུར་པ་དེ་ནི་ས་གཞི་ཐམས་ཅད་ཀྱི་སྣོད་དུ་འགྱུར་རོ།",
    "གཞན་རྣམས་ཀྱིས་མི་ཐུབ་པར་ཡང་༡༢འགྱུར་རོ།",
    "འདིའི་ལས་ཀྱི་མཐའ་དག་ཡང་ཡོངས་སུ་ཉམས་པར་མི་འགྱུར་རོ།",
    "བྱས་པ་ཆུད་གཟོན་པ་མ་ཡིན།",
    "ལོག་པར་ལྟ་བ་ཅན་མ་ཡིན། ༐",
    "རྒྱལ་པོས་རྣམ་པ་ཇི་ལྟ་བུ་རྣམས་འཛིན་པར་བྱེད་ན་འདི་ལྟ་སྟེ།",
    "བདེན་པར་སྨྲ་བ་དང་།",
    "ཡིད་དག་པར་བྱེད་པ་པོ་མེད་པར་སྨྲ་བ་མ་ཡིན་པ་དང་།",
    "གདུལ་བར་མི་ཐུབ་པར་ཡང་འགྱུར་རོ།",
    "ནོར་དང་ལྡན་པར་ཡང་འགྱུར་རོ།",
    "དེའི་ལུས་ཞིག་པར་གྱུར་ན་ས་ཀྱང་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་འཐབ་བྲལ་གྱི་ལྷ་རྣམས་ཀྱི་མངའ་བདག་ཏུ་འགྱུར་ཏེ།",
    "དེས་མིའི་ཁྱད་པར་རིག་པར་འགྱུར་རོ།",
    "ཡུལ་ཇི་སྲིད་དུ་སྟོབས་དང་ལྡན་པར་གྱུར་ནས་རྒུད་པ་ཟིལ་གྱིས་༩གནོན་པར་བྱེད་དོ།",
    "དེ་དེའི་རྒྱུར་ལྟ་བ་ལ་ཆེད་ཆེར་བྱེད་པའི་རྒྱལ་པོ་རྫས་དང་ལྡན་པར་འགྱུར་རོ།",
    "ནོར་གྱི་ཐབས་ཀྱིས་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ།",
    "དེ་ལ་ཡོན་ཏན་དེ་དག་རྣམས་སྲིད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྒྱལ་པོས་རྟག་ཏུ་ངེས་པར་ལེགས་པར་སྟོན་པར་༐",
    "བློ་ཤིན་ཏུ་རྣམ་པར་ཆགས་པ་དང་ལྡན་པར་མི་འགྱུར་རོ།",
    "བློ་རྩེ་གཅིག་པར་འགྱུར་རོ་། དོན་ངེས་པར་ལྡན་༡པ་དང་དོན་ངེས་པ་དང་ལྡན་པར་གྱུར་ནས་ལེགས་པར་རྣམ་པར་དཔྱད་པའི་དོན་དག་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ལ་ལེགས་པར་རྣམ་པར་དཔྱད་ནས་བྱེད་པ་༐",
    "པོ་འདིའི་ལེགས་པར་དོན་རྣམས་༡༨སྨིན་པར་འགྱུར་རོ།",
    "ལེགས་པར་འགྲུབ་པར་དུས་ཡུན་རིང་པོ་མ་ཡིན་པ་ན་འགྱུར་ཞིང་དུས་སྔ་བར་འཕགས་པ་དམ་པའི་ཚོས་དྲན་པ་ཉེ་བར་གཞག་པ།",
    "༥ ༣རྫོགས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "བག་དང་ལྡན་པར་འགྱུར་རོ།",
    "གྱུར་པས་༢ལེགས་པར་སེམས་པ་པོ་དེའི་རང་བཞིན་གྱིས་ཡིད་བྱུང་བར་མི་འགྱུར་རོ།",
    "ནོར་དང་ལྡན་པར་ཡང་འགྱུར་རོ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་རྒྱལ་པོའིནོར་གན་ས་པ་ཉིད་ཀྱིས་ནོར་དང་ལྡན་པའི་དཔལ་ཀུན་ཏུ་གནས་པས་དཔལ་དང་ལྡན་པར་གྱུར་ནས་སྦྱིན་པ་གཏོང་བར་ཡང་བྱེད་དོ།",
    "དེ་ལུས་ཞིག་པར་གྱུར་ན་ས་ཤི་བའི་འོག་ཏུ་དེའི་རྒྱུ་དང་རྐྱེན་གྱིས་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་འཐབ་བྲལ་བའི་ལྷ་རྣམས་ཀྱི་མངའ་བདག་ཏུ་འགྱུར་རོ།",
    "ལེ་ལོ་མེད་པར་གྱུར་པའི་རྒྱལ་པོ་ནི་བརྩོན་འགྲུས་བརྟན་པར་གྱུར་པའི་རིགས་པས་བརྩམ་ས་པའི་ཕྱིར་ན་ལས་ཐམས་ཅད་ཀྱང་༐",
    "ངེས་པར་རྫོགས་པར་བྱེད་ཅིང་སྒྲུབ་པར་བྱེད་ད་དོ།",
    "ཐུབ་པར་མི་ནུས་པར་འགྱུར་བ་དང་ཐམས་ཅད་དུ་རང་བཞིན་གྱིས་དགའ་ཞིངརྗེས་སུ་ཆ་གས་པ་དང་གཅེས་པའི་བློར་འགྱུར་རོ།",
    "གྱུར་པའི་༨རྒྱལ་པོ་ཡང་བརྩོན་འགྲུས་བརྟན་པ་དང་ལྡན་ཞིང་ཕ་རོལ་གནོན་པར་གྱུར་པ་ནི་ལས་རྣམས་གང་ཁོ་ན་རྩོམ་པར་བྱེད་པ་དེ་དག་ཉིད་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་དོ།",
    "ལེ་ལོ་མེད་པར་གྱུར་པ་དག་ནི་རིགས་པས་ཡུལ་དང་དུས་རྣམས་ལ་ལེགས་པར་འདྲེ་བར་གན་ས་པའི་ཕྱིར་ན་ལེ་༥ བཀའའགྱུར།",
    "ཏྒ་༧བ་༧ེ་ལོ་མེད་པ་དག་ནི་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཇི་སྲིད་དུ་མྱ་ངན་ལས་འདས་པའི་མཐར་ཐུག་པར་ད་གོས་༢པ་རྣམས་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ།",
    "དེ་ཇི་ལྟར་འཇིག་རྟེན་པའི་དོན་བྱེད་པར་འགྱུར་བའི་དོན་དེ་ཡང་ཕུན་སུམ་ཚོགས་པར་འགྱུར་བ་དང་།",
    "གྲོགས་པོ་བརྟན་པའོ་། རྒྱལ་པོ་གྲོགས་པོ་བརྟན་པོར་གྱུར་པ་ནི་ཤིན་ཏུ་ལེགས་པར་མཐོང་བར་བྱེད་པས་རྒྱལ་སྲིད་དུས་རིང་དུ་ལོངས་སྦྱོད་པར་བྱེད་དོ།",
    "ཤིང་བཞིན་དུ་གང་དག་ཆེས་མང་དུ་ལེགས་པར་རབ་ཏུ་གནས་པས་གཡོ་བར་མི་འགྱུར་ཞིང་ངན་པ་རྣམས་ཀྱིས་ཀྱང་མི་གཡོ་བ།",
    "ཤིན་ཏུ་གྲོགས་པོ་བརྟན་པར་གྱུར་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལ་ཡང་འཇིག་རྟེན་པའི་ཡོན་ཏན་བཅུ་གསུམ་དང་ལྡན་པར་འགྱུར་བ་རྣམས་འདི་ལྟ་སྟེ།",
    "༥ ༥༧ ༧གང་དུ་འདི་ལ་བུག་རྡོ་ལ་བྱུང་བར་གྱུར་པ་ན་དེའི་ཚེ་འདིས་རབ་ཏུ་འགེབས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གྲོགས་པོ་གང་ཡིན་པའི་གྲོགས་པོ་གཞན་ཡང་དེའི་གྲོགས་པོར་འགྱུར་ཏེ་དེས་ཀྱང་ངའི་གྲོགས་པོ་འདིའི་གྲོགས་པོ་ཡིན་ཞེས་བྱས་ན་ས་དེ་དང་ལྷན་ཅིག་ཏུ་མཛའ་བར་འགྱུར་རོ།",
    "ཁྱིམ་ན་ནོར་གྱི་རིགས་གང་དག་ཡོད་པ་འདི་ལ་ཤེས་པར་༢བྱེད་ད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་དང་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་ཀྱང་སྟེན་པར་བྱེད་དོ།",
    "འདི་༤ཡང་ཇི་ལྟ་ཇི་ལྟར་དོན་གྱི་རིགས་རྣམས་ལ་བཟོད་པར་འགྱུར་བ་དེ་ལྟར་བྱེད་དོ།",
    "ཐམས་ཅད་ནས་ཁྲོས་པ་སྐྱེས་པར་གྱུར་༧ཀྱང་རྣམ་པར་འགྱུར་བར་མི་འགྱུར་རོ།",
    "གང་འདིའི་ཁྱིམ་ན་ཡོད་པར་གྱུར་པ་དེ་དག་ཀྱང་ད་བང་པོ་ལ་གནོད་པ་མེད་པར་དོན་དུ་གཉེར་བར་བྱེད་པ་དང་།",
    "གང་ཡང་ཅུང་ཟད་ཁྱིམ་ན་ཡོད་པ་དེ་ཐམས་ཅད་གྲོགས་པོ་ལ་རྗོད་པར་བྱེད་དོ།",
    "ཅི་ཡང་མང་པོ་༢དང་ལྡན་པར་གྱུར་པ་མི་རྫི་བ་ལ་ལྟ་ཅི་སྨོས་དེའི་ཕྱིར་རབ་ཏུ་བརྩོན་པས་རྒྱལ་པོས་སྨྱུག་མའི་གྲོགས་པོ་བྱའོ།",
    "གྱུར་པས་༢དོན་སྒྲུབ་པར་བྱེད་པའོ།",
    "དེ་འགོག་པར་བྱེད་པ་དང་།",
    "གྲོགས་པོ་ངན་པ་ལས་རབ་ཏུ་ཟློག་༥པར་བྱེད་དོ།",
    "ལས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་ལེགས་པར་སྟོན་པར་བྱེད་དོ།",
    "ལམ་ངན་པར་ཞུགས་པར་གྱུར་པ་ལམ་ལ་རབ་ཏུ་འགོད་པར་བྱེད་ད་དོ།",
    "ཐབས་མ་ཡིན་པ་ཐམས་ཅད་ལས་ཀྱང་སྐྱོབ་པར་འགྱུར་རོ།",
    "གཞན་ཡང་གྲོགས་པོ་མ་ཡིན་པ་བདེ་ལེགས་སུ་འགྱུར་བར་མི་བྱེད་པ་༢ཀུན་ཏུ་བསྟེན་༤པར་མི་བྱའོ་༥།",
    "དཔེར་ན་སྐྱེ་བོ་ཐམས་ཅད་སླུ་བར་བྱེད་པ་འབའ་ཞིག་པ་ཤིན་ཏུ་ལམ་ལོག་པ་སྟོན་པར་བྱེད་པ་དང་བསམ་པ་ངན་པ་སེམས་པར་བྱེད་པ་ཉེ་བར་སྟེན་པར་བྱེད་པ་ཡང་༦དེས་ནི་དོན་མ་ཡིན་པ་ཆེན་པོ་དང་ཀུན་ཏུ་སྦྱོར་རོ།",
    "རླག་༧པར་བྱེད་པའི་རྩ་བ་དེ་ཡང་རྣམ་པ་གཉིས་ཡིན་ཏེ།",
    "འགྱུར་བ་༡༧པོ་རྐུན་མ་དེ་དག་རྣམས་ལ་ལེགས་པར་ཕྲད་པར་བྱ་བ་དང་ཀུན་བརྗོད་པར་ཡང་སླ་བར་སྦྱིན་པར་མི་བྱ་ན།",
    "ལྷན་ཅིག་ཏུ་འགྲོགས་པར་བྱ་བ་ལྟ་སྨོས་ཀྱང་ཅི་༡༧ད་གོས།",
    "དེ་དག་དང་ལྷན་ཅིག་པར་གྱུར་པ་ནི་དེས་ཤིན་ཏུ་བར་ཡང་སྤང་བར་བྱའོ།",
    "སྒྱུ་ཅན་ལ་རྗེས་སུ་བསྟེན་པར་མི་བྱའོ།",
    "ཀི་བ་༧ ༨ཧྲལ་ཅན་ལ་བསྟེན་པར་མི་བྱའོ།",
    "དེ་དེ་ཉིད་ཀྱིས་བག་ཆ་གས་ཀྱིས་བསྒོས་པར་གྱུར་པ་ནི་༡ལུས་ཞི་ག་ནས་ཀྱང་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་༢འཐབ་བྲལ་གྱི་ལྷ་རྣམས་ཀྱི་མངའ་བདག་རྒྱུ་རྐྱེན་དེས་བྱེད་པར་འགྱུར་རོ།",
    "ཁྲོ་བ་དང་རྒོད་པ་ཆེས་སྡོམ་པར་བྱེད་པའོ།",
    "ཁྲོ་བ་སྡོམ་པར་བྱེད་པའི་རྒྱལ་པོ་དེ་དག་ནི་མ་བསམས་པར་བྱ་བ་རྣམས་བྱེད་པར་མི་འགྱུར་རོ།",
    "བྲན་ལ་ཀླ་ོ་བུར་དུ་རྡེག་པར་མི་བྱེད་དོ།",
    "ལོ་བུར་དུ་འཕེལ་བ་དང་འགྲིབ་པ་དག་སྐྱེད་པར་མི་བྱེད་ད་དོ།",
    "སྐྱེས་བུ་དམ་པ་མ་ཡིན་པ་དག་རྗེས་སུ་འཛིན་པར་མི་བྱེད་དོ་༡༢། དེ་ནི་བློ་བརྟན་པར་འགྱུར་རོ།",
    "དེ་ལྟར་རྒྱལ་པོ་དེ་ཁྲོ་བ་དང་རྒོད་པའི་ཚན་ཀ་སྡོམ་པར་བྱེད་པ་ཉིད་ནི་འཇིག་རྟེན་པའི་དོན་ལ་ཡང་རབ་ཏུ་བསྔགས་པར་འགྱུར་རོ།",
    "ཁྲོ་བ་སྡོམ་པར་བྱེད་པ་དེས་ནི།",
    "གསུས་༧པ་འགེངས་པར་བྱེད་པ་ལ་ཤིན་ཏུ་ཕྱོགས་པར་འགྱུར་རོ།",
    "དེ་རང་བཞིན་གྱིས་ཉེ་བར་ཆ་གས་པར་གྱུར་ནས་ཕྱུགས་བཞིན་དུ་བློ་གཅིག་ཏུ་འགྱུར་རོ།",
    "ཟས་དང་སྐོམ་གཉིས་ལས་མ་གཏོགས་པ་དོན་གཞན་རྣམས་ལ་དེའི་བློ་འཇུག་པར་མི་འགྱུར་རོ།",
    "ཡུལ་འཁོར་རྗེས་སུ་སྒྲུབ་པར་མི་བྱེད་ད་དོ།",
    "ཡུལ་ལྗོངས་ཀྱི་དོན་དག་དཔྱོད་པར་མི་བྱེད་དོ།",
    "རང་བཞིན་ལེགས་པར་བསྒོ་བར་མི་བྱེད་ད་དོ།",
    "དེ་རྟག་པར་ཡང་དོན་རྣམས་ལས་ཉམས་པར་འགྱུར་༡༢རོ།",
    "དེ་ཡོངས་སུ་ཉམས་པ་ལས་ཀྱང་འབྱོར་བ་དམན་པར་འགྱུར་ལ་དེས་ཀྱང་ཟས་དང་སྐོམ་མིང་མེད་པར་འགྱུར་རོ།",
    "སྲེད་༡པའི་རྣམ་པར་གཡེང་བ་དེས་འཇིག་རྟེན་པའི་དོན་རྣམས་ཀྱི་ཡང་བར་དུ་གཅོད་པར་བྱེད་པར་༢འགྱུར་བ་ཡིན་པ་དང་།",
    "ཟས་དང་སྐོམ་ཉེ་བར་སྟེན་པར་གྱུར་པས་ཇི་ལྟར་འཇིག་རྟེན་ལས་འདས་པ་རྣམས་ལ་ཡང་རྣམ་པར་གཤེ་བར་གྱུར་པ་ཡིན་ནོ།",
    "ལུས་སུ་གཏོགས་པའི་དྲན་པ་དག་མེད་པར་འགྱུར་རོ།",
    "ཟས་དང་སྐོམ་ལ་གུས་༥པར་འགྱུར་བ་ལས་མ་གཏོགས་པ་འདི་དག་དོན་གཞན་རྣམས་འགའཞིག་ལ་ཡང་བློ་ལས་སུ་རུང་བར་མི་འགྱུར་རོ།",
    "ཡང་དག་པའི་ལམ་རྣམས་སྤྱོད་པར་བྱེད་དོ།",
    "ཟས་དང་སྐོམ་དང་ལྡན་པའི་ལུས་ནི་ཡང་དག་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཟས་སམ་སྐོམ་མམ་༢ལུས་ལ་འཇུག་པར་བྱེད་པ་དེའི་ཚེ་འགྲངས་༤པ་ཙམ་དང་ཕན་པ་ཙམ་ཞིག་གོམས་པར་བྱས་པས་དེ་ལྟར་འདིའི་ཡིད་ལས་སུ་རུང་བ་དང་སེམས་མཉམ་པར་གཞག་པར་ཡང་འགྱུར་རོ།",
    "འདི་ལྟ་སྟེ་ལེགས་པར་སྤྱོད་༨པར་བྱ་བ་རྣམས་སེམས་པར་བྱེད་པའོ།",
    "འོན་ཀྱང་སྐྱོན་རྣམས་རབ་ཏུ་གཞོམ་པར་བྱ་ཞིང་དེས་ལེགས་པར་བསམ་པར་༡བྱ་བ་རྣམས་བསམ་པར་བྱའོ།",
    "ཡིད་ལ་ཡང་གཞག་པར་བྱའོ།",
    "རྣམ་པར་༡༡འཇུག་པར་བྱེད་པ་༡༢ཡིན་པར་བརྗོད་པར་བྱའོ།",
    "ངན་པར་བསམ་པ་༢སེམས་པར་བྱེད་པ་དེ་དག་རྣམས་ཀྱིས་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཐམས་ཅད་ཀྱིས་གནས་སྐབས་ཐམས་ཅད་དུ་དོན་ཐམས་ཅད་ལེགས་པར་བསམས་ལ་བྱའོ།",
    "འཇིག་རྟེན་ལས་༡༢འད་ས་པའི་ཡང་སྟེ་ཕན་པའི་དོན་གང་བྱེད་པར་གྱུར་པ་དང་།",
    "གཞན་དག་རྣམས་ཀྱང་བྱེད་པར་གྱུར་པ་ན་དུས་རིང་པོས་ཀྱང་བྱ་བར་མི་ནུས་པའོ།",
    "དེ་དག་ལ་མི་བཟོད་པར་འགྱུར་རོ།",
    "དོན་ཐག་རིང་བར་གྱུར་པའི་སྐྱོན་གྱིས་བསྒྲུབ་བྱར་གྱུར་པ་རྣམས་ཡང་བསྒྲུབ་བྱ་༡༧མ་ཡིན་པར་བྱས་ནས་ཆུ་ད་གཟོན་པར་བྱེད་ད་དོ།",
    "དེ་བཞིན་དུ་དོན་གཞན་དག་དུ་མ་རྣམས་ཀྱང་མྱུར་བར་མ་བྱས་པས་དུས་གཞན་དུ་ཤིན་ཏུ་ཡང་བཟོད་པར་མི་ནུས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ངེས་པར་ལེགས་པའི་༡༧ལམ་ཅུང་ཟད་ཙམ་ཡང་མེད་དེ་༡༨།",
    "ཀུན་ནས་འཇོམས་པར་བྱེད་ད་དོ།",
    "རབ་ཏུ་འཇོམས་པར་བྱེད་ད་དོ།",
    "དེས་སྐྱོན་དེ་དག་རྣམས་ཀུན་ན་ས་བཅོམ་པར་གྱུར་པས་མཐར་ཐུག་པར་བདེ་བར་འགྱུར་རོ།",
    "སྐྱེས་བུ་འཇིག་རྟེན་པའི་༤འམ་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་ལ་ཡང་གནས་ནས་ཀུན་ཏུ་སྐྱེས་པའི་སྐྱོན་རྣམས་འཇོམས་པར་བྱེད་དོ།",
    "དེས་སྔོན་བྱས་པའི་ལེགས་པར་བྱས་པའི་ལས་དེ་ཉིད་ཀྱི་རྒྱུ་དང་རྐྱེན་རྣམས་ལས་ཡིན་ནོ།",
    "རྒྱལ་པོ་དོན་དང་ཡང་དག་པར་ལྡན་པར་འགྱུར་ཏེ་ཇི་ལྟ་བུའི་དོན་གྱིས་ཞེ་༡ན།",
    "དེ་ལས་ཡོན་ཏ་ན་གཉིས་པ་དང་ཡང་དག་པར་ལྡན་པ་ཕུན་སུམ་ཚོགས་པར་འགྱུར་བ་ནི་རྒྱལ་པོ་སྙན་གྲགས་དང་ཡང་དག་པར་ལྡན་པར་འགྱུར་རོ།",
    "ལེགས་པརལྡན་པར་འགྱུར་རོ།",
    "སྐྱེ་དགུ་༢རྣམས་བསྐྱངས་པར་གྱུར་པ་ལས་ལུས་ཞིག་པར་གྱུར་ནས་ཤི་བའི་འོག་ཏུ་མཐོ་རིས་བདེ་འགྲོའི་འཇིག་རྟེན་འཐབ་བྲལ་གྱི་ལྷ་རྣམས་ཀྱི་བདག་པོར་འགྱུར་རོ།",
    "དེ་མ་ལུས་པ་རྣམས་ཀྱིས་ཀྱང་མཆོག་ཏུ་བདེ་བའི་རྣམ་༢པར་སྨིན་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ལུས་ཀྱི་རྣམས་ནི་སྲོག་གཅོད་པ་དང་མ་བྱིན་པར་ལེན་པ་དང་༤འདོད་པ་ལོག་པར་གཡེམ་པ་སྤོང་བའོ།",
    "ཡིད་ཀྱི་རྣམས་ནི་བརྣབ་སེམས་དང་གནོད་སེམས་དང་ལོག་པར་ལྟ་བ་རྣམས་ས་སོ།",
    "དེ་དག་རྒྱལ་པོ་འདི་རང་ཉིད་ཀྱིས་འཛིན་པར་ནུས་པ་དང་།",
    "འདིའི་ཡུལ་དུ་དུས་སུ་ལོ་ཏོག་རྣམས་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ།",
    "འདིའི་ཡུལ་དུ་ཡང་དུས་སུ་ཟླ་བ་དང་ཉི་མ་དག་རབ་ཏུ་འོད་འབྱིན་པར་བྱེད་པ་དང་།",
    "དགོས་པ་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་འགྱུར་བ་དང་ཡུལ་ལྗོངས་རྣམས་ཕུན་སུམ་ཚོགས་པར་ཡང་འགྱུར་རོ།",
    "སྲོག་གཅོད་པ་རྣམ་པར་སྤངས་པས་ནི་དམན་པ་དང་བར་མ་དང་ཁྱད་པར་དུ་འཕགས་པའི་ལྷ་རྣམས་ཚེ་རིང་བར་འགྱུར་རོ།",
    "གཞན་ཡང་དེ་ཁོ་ན་བཞིན་དུ་ལྷའི་རིས་དྲུག་ཏུ་མ་བྱིན་པར་ལེན་པ་རྣམ་པར་སྤངས་པས་ནི་ནོར་བརྟན་༥པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ལུས་ཀྱིས་ལེགས་པར་སྤྱོད་པ་རྣམས་བསྲུངས་ཤིང་བསྟེན་ལ་བསྒོམས་ལ་ལན་མང་དུ་བྱས་པས་ནི་ལྷ་རྣམས་ཀྱི་ནང་དུ་སྐྱེ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པ་བདེ་བ་དང་ལྡན་པ་གཉིས་པར་༐",
    "ངག་ལེགས་པར་བསྡམས་པ་རྣམས་ཀྱང་བཞིའོ།"
  ]
}