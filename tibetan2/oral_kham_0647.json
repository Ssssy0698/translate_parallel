    "ཤེས་རབ་ཁྱད་དུ་འཕགས་པའི་རླབས་ཆེན་གྱི་སྙན་ངག་པ་མང་པོ་ཞིག་དུས་རབས་ཕྱི་མ་ཕྱི་མས་དཀར་འདོན་དང་འོས་འཚམ་གྱི་གདེང་འཇོག་བྱས་པ་ལས།",
    "ཚིག་སྦྱོར་མཚར་བོ་སྤེལ་ཞིང་རང་ཉིད་མཚར་དུ་གཟུང་བ་ཁོ་ནས་ལོ་ཟླའི་འཕྲང་རིམ་བརྟོལ་ག་ལ་ཐུབ།",
    "རང་ཉིད་རང་གཤིས་དང་རང་ཚུགས།",
    "རྐྱང་རྒོད་ཀློག་དུས།",
    "རྐྱང་རྒོད་ཀློག་དུས།",
    "རྒོད་གཤིས་དང་རང་གཤིས་རྨང་ནས་ཟད་ཅིང་བྲན་གཤིས་ཀྱིས་ཀུན་ནས་བཅིངས་པའི་ད་ལྟ།",
    "རང་གཤིས་དང་རང་ཚུགས།",
    "རྐྱང་རྒོད་ཀྱིས་ང་ལ་བྱིན་པ་ནི་ཞེད་སྣང་དང་སེམས་ཁྲལ་འབའ་ཞིག་ཡིན། རྐྱང་རྒོད་ཀློག་དུས།",
    "སྤྱིའི་ཆ་ནས་དགའ་འོས་པའི་སྣང་ཚུལ་ཞིག་འདུག་ཀྱང་།",
    "ང་རང་དུས་ནམ་ཡང་ཁེར་རྐྱང་དུ་འདུག་པར་སྤྲོའོ་ཞེས་ཐ་ཚིག་བསྒྲགས་མྱོང་བ་དང་།",
    "དེང་སྐབས་བོད་ཀྱི་སྙན་ངག་གསར་བའི་རྩོམ་སྟེགས་སྟེང་དུ་ནོར་འཁྲུལ་ཅན་གྱི་ལྟ་ཚུལ་ཞིག་འདུག་པ་ནི།",
    "ཞོར་ནས་ངས་གླེང་བའི་སྣང་ཚུལ་ཡོད་ཚད་ཀྱང་རང་ཉིད་ཀྱི་བསམ་ཚུལ་རང་ག་བ་ཞིག་བརྒྱུད་སྒྲོག་བྱས་པ་ཙམ་ལས་ཅི་ཡང་མ་ཡིན་ལ།",
    "ཁོ་ཚོའི་སེམས་ཁོང་དུ་ཡུན་རིང་ལ་བརྣག་པའི་གདུང་ཡུས་དེ་ཡང་ཤར་མར་བཞུར་གྱིན་གདའ།",
    "དེ་ཡང་རང་གཤིས་མངོན་གསལ་ཅན་གྱི་སྙན་ངག་པ་སུ་ཞིག་ཡིན་རུང་།",
    "དེ་ནི་ཁོ་རང་ཆུང་དུས་ནས་བཟུང་ཞིང་གྲོང་དུ་ནར་སོན་པའི་སྟབས་ཀྱིས་ཡིན་ལ།",
    "བདེ་སྐྱིད་ཀྱི་ཞིང་གྲོང་དང་དབྱར་སྡོང་སོགས་ལ་ལྷད་མེད་ཀྱི་བརྩེ་བ་ཞིག་འདུག་པ་ནི་རྒྱུན་ལྡན་ཞིག་ཡིན་པ་ལས།",
    "རྩོམ་པ་པོ་རང་ཉིད་མཐོ་སའི་གསེར་ཁྲི་ཞིག་ལ་ཧོར་འདུག་ཅིག་བྱས་ཏེ།",
    "ང་ལྷ་སར་ཐེངས་གཅིག་ལོག་པ་ནི་ཕ་ཡུལ་དང་ཁ་འབྲལ་བ་དང་འདྲ་ཞེས་པའི་ཚིག་རྐང་འདི་ལ་ཅུང་མཐོ་བའི་སྤྱི་སྡོམ་དང་དཔེ་མཚོན་རང་ཚུབཞིན་ལྡན་འདུག་སྙམ།",
    "དེ་ལྟ་བུའི་ཚོར་འདུ་ཤུགས་དྲག་ནི་བོད་མི་སུ་ཞིག་ཡིན་རུང་བག་ཆགས་ཀྱིས་བཏབ་ཅིང་རང་རྒྱུད་བརླམས་ནས་ཡོད་པ་ཡིན་པས།",
    "རྩོམ་པ་པོའི་རྒྱུད་ཀྱི་འབྲི་མཁན་མང་པོ་མི་འདུག་སྙམ།",
    "སྐྱིད་ལུག་ལེ་ལོའི་ཁྲོད་ནས་གཉིད་འདུག་ག་ལ་རུང་།",
    "ཁོ་རང་ད་དུང་ཡིད་ཚིམ་པ་མེད་པར་བག་ཡོད་ངང་སོ་ལྟའི་ཚུལ་གྱིས་འགྲོ་ཞིང་།",
    "སྤྱང་ཀི་དང་འབྲེལ་བ་ནི་རི་དྭགས་དང་རང་བྱུང་ཁམས།",
    "སྤྱང་ཀི་རང་གྲག་དུས་ད་གཟོད་འཚོ་ཞིང་གནས་ལ།",
    "དེའི་ཕྱིར་གླུ་ཚིག་གང་འདྲ་ཡིན་ཡང་རང་ཉིད་འཚོ་གནས་བྱེད་པའི་ཡུལ་སྟེ།",
    "གཞུང་དྲང་ལྷག་བསམ་ཆེ་བའི་ཡུལ་མི་ཚོས་མགྲོན་པོ་འཛུམ་གྱིས་བསུས་ཤིང་རང་མིར་བརྩིས་ནའང་།",
    "ཟླ་འོད་ཀྱིས་ང་རང་ཕ་མཐར་སྐྱེལ་བའི་དུས་སུའང་ཞེས་པ་དང་།",
    "བོད་མི་བྱིངས་ཉོབ་ཅིང་རང་དོན་ཉི་ཚེ་བ་ཞིག་ལ་འདུར་བའི་རྣམ་པ་ལས་བྱུང་བ་དང་།",
    "འོན་ཀྱང་སྤྱིའི་ཆ་ནས་ད་དུང་ཚིགས་བཅད་གསར་བའི་དགེ་མཚན་འདོན་ལུགས་ལ་རང་རྟོགས་ཅན་གྱི་ངེས་ཤེས་གསལ་བོ་རྙེད་མི་འདུག་སྙམ།",
    "འདིའི་ཆ་ནས་སྙན་ངག་པ་སེང་རྡོར་ལ་དགེ་མཚན་ཅུང་ཟད་འདུག་སྙམ།",
    "ཕྱོགས་གཞན་ཞིག་ནས་སྙན་ངག་པ་ནི་མ་གཞི་ནས་བསམ་ཡན་རྒོད་ཅིང་རང་གཤིས་ཡོད་པ་ཞིག་ཡིན་པ་ལ་ཀུན་གྱིས་དེ་འདྲའི་རིགས་འདྲའི་སྙན་ངག་སྤེལ་བ་ལ་ཡ་མཚན་པ་ཅི་ལ་མེད།",
    "འཇིག་རྟེན་ཀུན་ལ་རང་ཉིད་ཀྱི་སྙན་ངག་ཀློག་པའི་སྐུལ་མ་མཛད་འདུག་བོད་མཁས་པས།",
    "དལ་བར་འདུག་པར་མི་རིགས་སོ།",
    "རང་ཉིད་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ་ལས་བྱུང་བའི་སེམས་ཀྱི་ཉིང་ཁུ་ལྟ་བུ་ཞིག་ཡིན་པར་སེམས།",
    "ཡོད་ཚད་སྔོ་ཞིང་བསང་བའི་ནམ་མཁའ་དང་དྲོ་ཞིང་འཇམ་པའི་ཉི་འོད་ལྟར་ཇེ་ལེགས་ཇེ་བཟང་དུ་འགྲོ་མགོ་བརྩམས་པའི་དུས་ཚིགས་ཤིག་ཡིན་འདུག་འོ་ན་དེ་འདྲའི་དུས་སྐབས་འདི་ལ་སྙན་ངག་གསར་བ་འདི་རླབས་ལྟར་འཕྱུར་དགོས་དོན་ནི།",
    "བོད་ཀྱི་སྙན་ངག་གསར་བ་ལ་མི་གསལ་རབ་རིབ་ཀྱི་བརྗོད་བྱ་བྱུང་བའི་མགོ་ཚུགས་པའང་ཡིན་འདུག་སྙམ།",
    "འདི་ལྟར་ཡོད་ཚད་སྨུག་ལོང་ཁྲོད་སྐྱ་ཐིང་ངེར་ཡོད་པའི་སེམས་ཁམས་འདི་ནི་བོད་ཀྱི་སྙན་ངག་པ་འབོད་སྐུལ་ལས་བརྒལ་བའི་སྔོན་འགྲོའམ་བོད་ཀྱི་སྙན་ངག་གསར་བ་དེ་མི་གཤིས་ཀྱི་རྙོག་འཛིང་རང་བཞིན་དང་ཐག་ཇེ་ཉེར་འགྲོ་བཞིན་པའི་རྟགས་མཚན་ཞིག་ཀྱང་ཡིན་པར་སེམས།",
    "ཁེར་རྐྱང་འདི་ལ་གོ་བོ་ལེན་སྟངས་མང་པོ་ཞིག་ཡོད་པར་འདུག་སྟེ།",
    "ཁོ་རང་སྟོང་བའི་ཁམས་སུ་སྤུར་ཅིང་། མཚོ་ངོས་སུ་འཕྱོ་བའི་གྲུ་གཟིངས་ཆུང་ཆུང་། འཇིག་རྟེན་ཕ་མཐའི་ངོགས་སུ། ཐོགས་མེད་དལ་བུར་གཡོ།",
    "འཚོ་བ་ཞེས་གཞན་ནས་གླེང་རྒྱུ་ཞིག་རྙེད་དཀའ་འདུག་ཞེས་པ་ལྟར།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བལྟས་ན་སྡུག་བསྔལ་གྱིས་འཚོ་བར་བྲོ་བ་ཞིག་དང་བཀྲག་མདངས་ཤིག་བསྣན་འདུག་པས།",
    "འགལ་འདུ་དེ་དག་ནི་སྡུག་བསྔལ་གྱི་འབྱུང་ཁུངས་ཡིན་པ་སོགས་ནི་ནུབ་ཕྱོགས་མཁས་པའི་ཟེར་སྒྲོས་ཡིན་འདུག་ལོ་རབས་དགུ་བཅུ་བའི་བོད་ཀྱི་སྙན་ངག་པ་རྣམས་ལ་མཚོན་ན།",
    "གླུ་ཡི་འབྲུ་དྲུག་ས་ནས་སྨིན། གླུ་ཡི་ཉི་ཞགས་མཁའ་པའི་རྣོ་སྦྲེང་འདར་བར་བྱས་པའི་སྒྲ་དབྱངས་ཤིག་ཏུ་འདུག་སྟེ།",
    "ཁོ་ཚོའི་སྙན་ངག་ལ་ངོ་ཚ་དགོས་དོན་གང་ཡང་མི་འདུག་གང་ཐུབ་ཀྱིས་མི་རྣམས་ཀྱི་ནང་སེམས་ཁམས་ཀྱི་འཇིག་རྟེན་མཚོན་པར་ཁམས་དང་ཉེ་བར་བཅར་ཞིང་།",
    "དེ་ལྟར་འཇིག་རྟེན་ཧྲིལ་པོ་གཡོ་སྒྱུ་དང་ཁྲམ་པ་ཡིས་བཀང་འདུག་པས།",
    "དོན་དངོས་སུ་ཧ་ཅང་ཉམ་ཆུང་དུ་འདུག་དེ་འདྲ་མ་ཡིན་ཏེ།",
    "ཆང་ནི་ཁོ་ཚོའི་ཡུན་རིང་ཉར་བའི་སེམས་ཀྱི་འཇིག་རྟེན་ཕྱིར་འདོན་པའི་རྐྱེན་ཞིག་ཏུ་གྱུར་འདུག་བཟི་ལུམ་གྱི་རྣམ་པས་བྲིས་པའི་སྙན་ངག་ཧ་ཅང་མང་སྟེ།",
    "བརྗོད་བྱ་ལ་ཁྱད་པར་ཆེན་པོ་མི་འདུག་ཟེར་ཞིང་།",
    "འདུག་པས་ན་དེ་དོན་གཟབ་པར་འོས་སོ།",
    "མི་དང་རང་བྱུང་བར་གྱི་འགལ་འབྲེལ།",
    "ཅུང་རྙོག་འཛིང་དང་འགྲེལ་དཀའ་བ་ཞིག་ཏུ་འདུག་པས།",
    "རྟེན་དང་རང་བཞིན་ཉིད་དང་ནི།",
