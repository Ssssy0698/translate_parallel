    "ཁ་ལྷོར་ཕྱོགས་ལ་རུས་སྦལ་རྔམས་པའི་འདུག་སྟངས་དང་གདུག་ཅིང་གཏུམ་པའི་སེམས་དང་ལྡན་པས་འཁོད་པ་རྣམས་ཁྱད་པར་དང་།",
    "དེས་ན་རལ་གྲིའི་སོས་ནི་རང་ལ་རང་ཇི་ལྟར་མི་གཅོད་པ་དེ་བཞིན་དུ་ཡིད་ཀྱིས་ཀྱང་རང་ལ་རང་མི་མཐོང་ངོ།",
    "གནས་སྐབས་དང་རང་བཞིན་བདག་གཅིག་པས་སྔ་མ་འགག་ལ་ཕྱི་མ་གསར་དུ་སྐྱེ་བའི་ཕྱིར།",
    "གལ་ཏེ་གནས་སྐབས་སྒྲ་ཤེས་དང་གཟུགས་ཤེས་སོགས་ཐ་དད་ཀྱང་རང་བཞིན་གཅིག་སྟེ་ཤེས་པ་ཙམ་ཉིད་དུ་ལྡོག་པ་མཚུངས་བའི་ཕྱིར་ཞེ་ན།",
    "མུར་འདུག་ཀུན་གྱིསམཐོང་གྱུར་ཅིང་།",
    "ཉམས་དང་རང་རྒྱལ་དང་།",
    "ཉན་ཐོས་རྣམས་དངམུར་འདུག་གཞན།",
    "རྣམ་པར་བསྒོམས་ཞིང་གདའ།",
    "གན་གཅིག་འདུག་དཀྱིཔ་དེད་དཔོན་གྱིས་བཅོམ་ལྡན་འདས་ལ་འདིསྐད་ཅེས་གསོལ་ཏོ།",
    "སྔགས་འདོན་ཅིང་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུའདུག་གོ།",
    "བྲམ་ཟེ་རྒྱ་མཚོའི་རྡུལ་གྱི་མ་དུན་དུ་འདུག་ནས་འདིས་དཅེས་སྒྲསསོ།",
    "དེནས་རྒྱལ་བུ་གཞོན་ནུ་གུ་ཁྱུད་བཅོམ་ལྡན་འདས་ཀྱིསྙན་སྔར་འདུག་ནས་འདི་སྐད་ཅེས་གསོལ་ཏེ།",
    "རིགས་ཀྱི་བུ་ནས་བྱམཟེའི་ཁྱེའུ་སྟོབསཆེན་ཤུགས་འཆང་དེ་ཡ་དབཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གསོལ་བ།",
    "རྡོ་རྗེའི་གདན་ལ་འདུག་པར་བྱབ་དང་།",
    "ཡིན་ནའང་གང་འདྲ་ཞིག་དགའ་བ་འདུག་གམ།",
    "དེའི་ལན་དུ་གང་ཞིག་གནང་ན་ཡང་མ་འགྲིགས་པ་མི་འདུག་འོན་ཀྱང་གློ་དམག་སྒར་གྱི་སྐོར་ཡིན་ན།",
    "དེའང་རང་ཉིད་དང་ཐད་ཀའི་ལས་དོན་འབྲེལ་ཡོད་རྣམས་བྲིས་ཡོད།",
    "འོན་ཀྱང་རང་འདོད་མ་ཁེངས་པ་དང་།",
    "ནོར་འཁྲུལ་ཡིན་པ་ཁས་ལེན་ཞུ་ས་གོང་ས་མཆོག་ལ་ཞུས་པས་མ་འཐུས་ན་ཁོ་རང་ལ་དུས་ནམ་ཡང་ངོས་ལེན་དང་།",
    "ལབ་གཞི་སྣ་ཚོགས་ཀྱི་གནས་བྲིས་མང་པོ་འབྱོར་བཞིན་འདུག་པ་མ་ཟད།",
    "འགལ་རྐྱེན་སྣ་ཚོགས་བྱུང་འདུག་ཟེར་བའི་ཐད་ལ།",
    "ལབ་གཞི་སྣ་ཚོགས་ཀྱི་གནས་བྲིས་མང་པོ་འབྱོར་བཞིན་འདུག་པ་མ་ཟད།",
    "ཡག་པོ་བྱེད་མཁན་ཐམས་ཅད་ཁོང་རང་ཉིད་ཡིན་པ་དང་།",
    "བཀའ་བློན་ཁྲི་པ་ཟམ་གདོང་ཁོང་རང་ཉིད་བཀའ་ཤག་ཏུ་སླེབས་ཚར་ཙམ་ཡིན་ནའང་ཁོང་རང་ཉིད་ཀྱི་བྱས་པ་ཞིག་མེད་ན།",
    "བྱེད་དགོས་དོན་ཡང་མེད་པ་ཤེས་གསལ་ལོས་ཡིན།",
    "སླད་ཕྱིན་ཀྱང་ཉམ་ཆུང་འདུག་མཁས་ཀྱི་ཐོག་ནས་གནས་གང་ཐུབ་བྱ་རྒྱུ་ལས།",
    "དེའི་ཐད་ལའང་རང་ཡིད་རང་ལ་མི་ཆེས་པ་ལྟ་བུ་དང་།",
    "ཕ་རོལ་དགྲ་བོའི་བེད་སྤོད་ཇི་ལྟར་གཏོང་གཞི་ངན་པའི་ཕུགས་འདུག་བཟོ་མཁན་བཀའ་བློན་ཁྲི་པ་ཡིན་པ་དངོས་སུ་གསལ་པོར་བསྟན་པ་དང་བཞི།",
    "རྫུན་ལས་ག་དུས་གནང་མྱོང་བ་ཡིན་ནམ།",
    "ག་དུས་ཤིག་བདེན་པ་དང་།",
    "རྨ་སྲས་ཡག་ར་སྟག་རྩེ་རྣམས་ཀྱིས་དང་པོའི་ཆར་ངོས་ལེན་བྱས་ཏེ་རྟགས་མཚན་འདྲ་མིན་བསྟན་འདུག་འོན་ཀྱང་ཡུལ་ལྷའི་དབུ་འཕང་མི་ཡིས་སྟོད་དགོས་ཀྱང་།",
    "ས་ཆ་དེར་ད་ལྟའི་ཆར་ས་འོག་ན་གསེར་གྱི་མི་རྟ་རང་འགྲིགས་བྱས་པ་ཞིག་འདུག་ཅེས་རྒྱ་དམར་གྱིས་གསེར་གྱི་མི་རྟ་ཡོད་ས་ནས་བསྔོག་པའི་སྐབས།",
    "རྒྱ་དམར་གྱིས་གཏེར་ཁ་བསྔོག་འདོན་བྱེད་པའི་སྐབས་ཡུལ་ལྷ་དེའི་ནང་གསེར་གྱི་རྟ་ཞིག་ཡོད་པ་ཡིན་འདུག་རྒྱ་དམར་གྱི་དེ་ལ་དམིགས་ཏེ་བསྔོག་སྐབས་བར་མཚམས་ཤིག་ཏུ་གསེར་གྱི་རྟ་དེ་རི་བོ་དེའི་མདུན་ཕྱོགས་སུ་འགྲོ་ཚར་བ་མཐོང་།",
    "བློ་འཚབ་སྐྱེ་གཞི་ཞིག་ཏུ་གྱུར་འདུག་ཅེས་སོགས་གསུང་པ་དང་།",
    "ང་རང་ཡང་སེམས་ཧ་ཅང་སྐྱོ་པོ་བྱུང་ནས་མིག་ཆུ་ཕྲན་བུ་ཤོར་བྱུང་།",
    "ང་རང་ཟླ་གཅིག་རིང་ཚེ་ལྷ་ཁག་ཁ་ཤས་ཀྱི་ཚེ་སྒྲུབ་ལ་བསྡད་པ་ཡིན།",
    "བསྐྱར་དུ་ཞུ་དགོས་མི་འདུག་ཀྱང་།",
    "ཕྱི་ལོ་༢༢ ཟླ་༥ ཚེས་བཟང་པོར་གཞིས་སྡོད་བོད་མི་ཡོངས་ཀྱིས་གུས་པ་ཆེན་པོས་ཕུལ་བའི་ཞུ་ཡིག་ཏུ་ཞེས་འཁོད་འདུགགཞིས་སྡོད་བོད་མིས་ཕུལ་བའི་ཞུ་སྙན་གྱི་འབྲུ་དོན་འདི་དག་བདེན་པ་དང་།",
    "སྲིད་འཛིན་སྟོན་འཁོར་ཉིན་གཉིས་བཞུགས་རིང་རང་གཞུང་བཀའ་ཤག་དང་།",
    "སྐུ་ཚབ་རྣམ་པར་ཕེབས་འདོད་ཡོད་མེད་སོགས་ཞུ་ས་བྱུང་མི་འདུག་ང་ཕོད་དང་།",
    "སྒེར་མི་མང་བར་གྱི་འབྲེལ་བ་ནི་སྒེར་རིམ་པའི་རྣམ་པ་གསལ་པོ་ཐོན་པ་ཞིག་དགོས་ཀྱི་འདུག་ཁ་ཤས་ཀྱིས་གོང་ས་མཆོག་ལ་རྒྱ་ནག་དང་འབྲེལ་བ་བྱེད་འཆར་ཡོད་ཅེས་ཞུ་སྐབས།",
    "གོང་ས་མཆོག་ནས་དེ་ཡག་པོ་འདུག་མ་གཏོགས།",
    "བཀོད་མངགས་གནང་རིགས་ཡོད་བཟོ་མི་འདུག་པ་མ་ཟད།",
    "ཕྲན་རང་བཀའ་ཤག་ཏུ་ཡོད་སྐབས་ཐོག་མའི་ཆར་ཁོང་ཉིད་གཟུགས་གཞི་ཡང་བདེ་ཐང་རང་མི་འདུག་པས།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནས་དེ་རིང་རང་ཅག་བོད་ལོའི་གནམ་ལོ་གསར་ཚེས་ཉིན་ས་གནས་འདི་གའི་སེར་སྐྱ་མི་མང་དང་།",
    "རབ་བྱུང་བཅུ་བདུན་པའི་ཆུ་ལུག་ཟླ་༡ ཚེས་༧ ཕྱི་ལོ་༢༣ ཟླ་༣ ཚེས་༡ ལ་ཞེས་སྩལ་འདུག་ཅིང་།",
    "འོན་ཀྱང་དངོས་སུ་བྱེད་སར་སླེབས་དུས་བོད་དང་བོད་མིའི་བདེན་དོན་ལ་ནུས་པ་འདོན་ཡུལ་མི་འདུག་པ་མ་ཟད།",
    "ཕྱི་ལོ་༢༣ ཟླ་༩ ཚེས་༣ ལ་ཞེས་བཀའ་སྩལ་འདུག་དེབ་ཉི་ཤུ་པ།",
    "དབུས་གཙང་བཅས་བོད་ཆོལ་ཁ་གསུམ་གྱི་ཁྱབ་ཁོངས་ཡོངས་ལ་གོ་དགོས་པ་ཡིན་ཞེས་འཁོད་འདུག་པ་བཅས།",
    "ཁམས་རྟའུ་ཉི་ཚོ་དགོན་གྱི་གྲྭ་ཉི་མ་གྲགས་པ་འདི་ལོ་ཟླ་༡ ཚེས་༣ ཉིན་བཙོན་འཇུག་བྱས་འོག་ནས་ལུས་གཟུགས་གཅོང་ཅན་བཟོས་པས་འདས་གྲོངས་སུ་གྱུར་འདུག་ཁོང་ཉིད་རྟའུ་རང་ནས་ཡིན་པ་དང་།",
    "ཕྱི་ལོ་༢༤ ཟླ་༢ ཚེས་༢༢ ཉིན་ལྷ་སར་རྒྱལ་གཅེས་པ་ཚེ་སྨོན་གླིང་ཟླ་བ་ལགས་ཟེར་བ་འདས་གྲོངས་སུ་གྱུར་འདུག་ཁོང་ཉིད་༡༩༥༩ ལོའི་ཟིང་འཁྲུག་ཁོངས་སུ་ཚུད་པ་དང་།",
    "མཐར་ཕྱི་ལོ་༢༤ ཟླ་༦ ཚེས་༢༥ ཉིན་སྐུ་ཚེ་མ་ཟིན་པའི་གནས་ཚུལ་སེམས་སྐྱོ་བའི་རང་བཞིན་དུ་གྱུར་འདུག་དམ་པ་གང་ཉིད་རྒྱུན་རིང་བསྙུན་ནས་ཡོད་པར།",
    "ཕྲན་ནས་ཁོ་རང་ལས་གསང་རྒྱ་ཆེ་ཙམ་བྱེད་ཀྱི་ཡོད་པ་མ་ཚད།",
    "བོད་ལྗོངས་ནི་དེ་བས་ཡར་རྒྱས་གནམ་ས་བླ་འོག་བསྒྱུར་པ་ལྟར་བྱུང་ཡོད་ཅེས་ཟེར་འདུག་བོད་ཆོལ་ཁ་གསུམ་གཅིག་ཏུ་བསྒྲིལ་བ་ཡོང་དགོས་མེད་ན།",
    "ཡི་གེ་ཇི་འདྲ་ཞིག་འདུག་ཅེས་དྲིས་པར།",
    "དོན་དངོས་གསང་གནས་དམ་པོ་རྩ་འཛིན་བྱས་འདུག་གནང་སྟངས་གང་ལ་དཔྱད་ཀྱང་།",
    "རྔམ་སྟོན་ཁྲོམ་བསྐོར་སོགས་དུས་བསྟུན་སྲུང་བརྩི་ཞུས་འདུག་པ་བཅས།",
    "འདིའི་ཐད་དགོས་གལ་བོད་ལ་ཡར་རྒྱས་ཀྱི་མཚོན་བྱེད་དུ་ངོས་འཛིན་མཛད་འདུག་ཅིང་།",
    "བྱུང་རབས་ཀྱི་ནང་ཟུབ་ཏུ་མེད་པའི་ནག་ཐིག་ཤིག་ཆགས་ཡོད་ཅེས་བཀོད་འདུག་གསུང་ཕྱོགས་འདིའི་ཐད་དངོས་དོན་གསལ་དུ་གཏོང་ན།",
    "ཡོད་པའི་གོ་དོན་གསལ་པོ་འདུག་སི་ཊས་སི་སྦག་གྲོས་འཆར་དུ་བོད་ཆོལ་ཁ་གསུམ་གཅིག་ཏུ་གྱུར་པའི་རང་སྲིད་རང་འཛིན་དགོས་ཞེས་འཁོད་པ་ལས།",
    "འགལ་བ་དེ་ཚོ་སེལ་བའི་མཐུན་རྐྱེན་ཇི་དགོས་ཤེས་རྟོགས་ཡོང་བར་ཕན་ཐོགས་བྱུང་འདུག་སྐབས་དེར་འབྲེལ་ཡོད་རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་མི་སྣར་ངེད་རང་རྒྱ་ནག་ཏུ་ལྷ་སྐོར་གནས་མཇལ་ཞིག་ཡོང་འདོད་ཡོད་པ་བསྐྱར་ནན་གསལ་བརྗོད་བྱས་ཡོད་ཅིང་།",
    "སྐུ་ཚབ་རྣམ་པའི་ངོ་བོ་ངོས་འཛིན་བྱེད་སྟངས་གང་ལ་བརྟག་ཀྱང་རང་མགོ་རང་བསྐོར་ཆགས་ཤོར་མི་ཉན་པའི་དགོངས་བཞེད་གནང་གལ་ཆེ་བ་མཐོང་།",
    "འཆམ་མཐུན་གྱི་ལམ་ནས་ཡོང་དགོས་པ་དངོས་པོའི་གཤིས་ལུགས་ཡིན་པ་ཚང་མས་ངོས་འཛིན་ཐུབ་པ་དགོས་ཀྱི་འདུག་ཅེས་ནན་བརྗོད་བྱེད་རྒྱུ་ཡིན་ཞེས་བཀོད་འདུག་པ་འདིའི་ཐད།",
    "བོད་མི་མང་སྤྱི་འཐུས་ལྷན་ཚོགས་ཀྱིས་༢༦ ཟླ་༣ ཚེས་༡ ལ་ཞེས་བཀོད་འདུག་པ་ནི།",
    "དགྲ་དང་རང་ཕྱོགས་རང་བཞིན་གྱི་འཐབ་རྩོད་ཡིན་པ་དང་།",
    "འགྲོ་ཆུས་ངན་པས་འདུག་ཆུས་ཕུང་ཟེར་བའི་དཔེ་ལྟར།",
    "འོན་ཀྱང་ཁྱེད་རང་སྤྱོད་ཚུལ་དེ་ལྟ་བུར་ཕྲན་ནས་ལན་འདེབས་མ་དེབ་ཉི་ཤུ་པ།",
    "ཆེས་གདུག་རྩུབ་ཅན་གྱི་ཚིག་ངན་མི་སྤྲོད་དང་མི་འཚམས་པའི་རིགས་བེད་སྤྱོད་བྱས་འདུག་པ་དེ་ནི།",
    "ད་དུང་མུ་མཐུད་དེ་འདི་ལྟར་གསུང་འདུག་པ་སྟེ།",
    "ད་དུང་མུ་མཐུད་འདི་འདྲ་གསུངས་འདུག་སེམས་ཀྱི་ཁ་བྲལ་ནི་ཁ་བྲལ་ཆེ་ཤོས་དེ་ཡིན་པས་ཁ་བྲལ་འགོག་རྒོལ་གྱི་མིང་ཐོག་ནས་ཁ་བྲལ་གྱི་བྱ་སྤྱོད་སྤེལ་བ་ནི།",
    "རྒྱལ་ཁབ་དང་མི་རིགས་ལ་ཕུགས་གནོད་ཅན་གྱི་ནོར་འཁྲུལ་ཚབས་ཆེ་ཞིག་ཡིན་པར་ངོས་འཛིན་ཐུབ་པ་དགོས་ཞེས་ནན་བརྗོད་བྱེད་རྒྱུ་ཡིན་ཞེས་གསུངས་འདུག་འདིའི་ཐད་ལ།",
    "རང་རང་བསྒོ་སྐལ་ཞུ་སྒོར་གཡོ་ཟོལ་མེད་པར་ལྷག་བསམ་འཁུར་བརྩོན་ཆེ་བསྐྱེད་བྱ་རྒྱུའི་དམ་བཅའ་འཇོག་རྒྱུ་ནི།",
    "དེའི་ནང་སྐུ་ཚེའི་སྟོད་ལ་དག་སྣང་བྱུང་བ་མང་པོ་ཞིག་འཁོད་འདུག་ལ།",
    "སྐབས་དེ་དང་དེའི་དུས་སུ་དག་སྣང་གང་བྱུང་བ་ཁག་ཀྱང་འཁོད་འདུག་དངོས་གནས་བྱས་ན།",
    "སྟག་ཕུ་པདྨ་བཛྲ་བསམ་གྱིས་མི་ཁྱབ་པའི་སྐྱེས་བུ་དམ་པ་ཞིག་ཡིན་པ་ཧ་ཅང་གསལ་པོ་འདུག་བར་སྐབས་ཡོངས་གྲགས་ལྟ་བུར་བརྗོད་བཞིན་པའི་དོལ་རྒྱལ་གྱི་སྲོག་གཏད་ཀྱི་སྐོར་འདི།",
    "སྔར་རྒྱ་གར་འཕགས་པའི་ཡུལ་དུ་བསྟན་པ་ཉམས་གུད་ཕྱིན་པའི་རྒྱུ་རྐྱེན་རྒྱ་གར་མཁས་པ་འདི་འདྲས་ཞིབ་འཇུག་བྱེད་སྐབས་རྒྱུ་རྐྱེན་གསུམ་ཡོངས་བསྒྲགས་བརྗོད་ཀྱི་འདུག་རྒྱུ་རྐྱེན་གཅིག་ནི།",
    "དེར་གཞིགས་ནས་དཀའ་ངལ་དང་ལེན་གྱི་འདུན་པ་མཐོང་སྐབས་ངོས་རང་ད་དུང་མུ་མཐུད་གསོན་པོར་མ་བསྡད་པར་འགྲིགས་ཐབས་མི་འདུག་བསམ་པ་དྲན་ནས་རྟག་ཏུ་རིང་འཚོའི་སེམས་བསྐྱེད་དང་།",
    "ཉེས་བརྡུང་ཕོག་སྟེ་དཀའ་ངལ་འཕྲད་པའི་གནས་ཚུལ་བྱུང་ན་ངོས་རང་སྐྱིད་པོ་གཏན་ནས་མི་འདུག་ཅེས་བཀའ་སྩལ་བ་དང་།",
    "རྣམ་འགྱུར་ལ་བལྟས་ན་ཕལ་ཆེར་བཀའ་འབྲེལ་ཡིན་བཟོ་ལྟ་བུའི་རྣམ་པ་ཡང་བསྟན་གྱི་འདུག་ཕྲན་ནས་ཁོང་ལ་ཞུས་དོན།",
    "ལྷག་པར་དུ་བོད་རྒྱ་གཉིས་ལ་མེད་དུ་མི་རུང་བའི་མ་འོངས་པའི་མདུན་ལམ་ཞིག་ཡིན་ཞེས་གསུང་འདུག་པ་འདི་ནི་དངོས་ལྡན་ཞིག་ཡིན།",
