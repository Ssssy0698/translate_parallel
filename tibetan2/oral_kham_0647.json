    "སེང་གཡབ་ལ་མེ་ཏོག་རྐང་སྒོར་གྱི་དབུས་འཁྲུངས་རབས་བཅུ་གསུམ་གྱི་སྣང་བརྙན་གོས་ལྷན་ཐབས་ལས་གྲུབ་པ་བཅས་བཀོད་ལེགས་བསྒྲུབ་འདུག་པར་ཤིས་པ་བརྗོད་པའི་མེ་ཏོག་གཏོར།",
    "གླང་ལོར་པ་ནམ་དུ་ཡུམ་གྱི་ལྷུམས་སུ་ཞུགས་པ་ལ་དགོངས་པར་འདུག་ཅེས་གླེང་།",
    "བེ་ཧུ་ལྷ་མཁར་བསྟན་རྒྱལ་ཆུ་ནག་རྒན་ནས་བཟུང་འབྲི་རྒོད་ལ་བར་གྱི་གྲྭ་སྒྲིག་པ་ཡིན་འདུག་པར་ཐོན་ཕྱག་དངོས་སྐྱེས་ཀྱང་གནང་།",
    "ཉ་མཚོ་བ་སོགས་མཇལ་བ་སེར་སྐྱ་སྟོང་ཕྲག་མང་པོ་བསྒུགས་ནས་འདུག་པར་བཅག་མལ་མཛད།",
    "ཚེས་ཉེར་གསུམ་གྱི་ཉིན་གྲམ་དཀར་གྱི་ཆུ་ཐོན་པའི་ཐང་ཆེན་བརྒྱུད་བགྲོད་པས་རྨ་ཆེན་སྤོམ་རའི་གངས་རི་མཐོང་བའི་རི་ཐང་མཚམས་ཤིག་ན་ལབ་ཙེ་མཆོར་པོ་ཟེར་བ་ཞིག་འདུག་པར་དར་གྱི་ཅོད་པན་བསྟར་ཏེ་རྨ་ཆེན་སྤོམ་ར་ལ་གསོལ་མཆོད་ཕུལ་ཞིང་འཕྲིན་ལས་བཅོལ་བ་མཛད།",
    "ཁོང་རང་ནས་ཀྱང་ཞབས་ཏོག་བསྙེན་བཀུར་གཟབ་སྟེ་དངོས་འབུལ་སྤམ་མཐོ་བ་བསྟར་ཞིང་དགའ་ལྡན་ལྷ་བརྒྱ་མ་དང་།",
    "དར་གྱི་ཆུན་འཕྱང་དང་ལྡན་པའི་སྒོ་རྣམས་རིམ་གྱིས་བགྲོད་དེ་མཁར་གྱི་དབུས་སུ་བཟོ་བཀོད་ཕུན་སུམ་ཚོགས་པའི་ཁང་པ་གསར་བསྐྲུན་མཛད་འདུག་པར་ཞབས་ཟུང་བཀོད།",
    "རྣམ་འཇོམས་དང་གདུགས་ཤེར་ཚར་མང་བཅས་ཞག་བརྒྱད་ཁོངས་སུ་དང་བ་ཆེན་པོས་བསྒྲུབས་པ་མཛད་འདུག།",
    "ཕེབས་ལམ་ཤིན་ཏུ་བདེ་ཞིང་ཁ་བ་ཡང་ཆེ་བ་མ་བྱུང་འདུག།",
    "འཇམ་དབྱངས་གོང་མ་ཆེན་པོའི་བཀའ་དྲིན་ཡིན་ངེས་ཞེས་ངོ་མཚར་དང་བསྔགས་བརྗོད་མཛད་འདུག་ཅེས་ཐོས་པས་ངེད་ཀྱི་སེམས་ཤིན་ཏུ་དགའ་ཞིང་བློ་བདེ་བའི་གནས་སུ་གྱུར།",
    "ཁྱེད་གཉིས་ཀྱིས་མཚོན་ཟླ་བོ་རྣམས་འབྲུམ་པ་མ་ཐར་འདུག་པར་ད་སྔ་ཕན་སྟབས་མ་འགྲིག།",
    "དེ་ལྟར་ན་འབྲུམ་པ་འདེབས་པའི་ཚེ་ཁྱེད་རང་འགྲོ་དགོས་གསུང་བར་བརྟེན་བདག་ཀྱང་ཕེབས་སྐྱེལ་དང་སྦྲགས་འགྲོ་རྒྱུ་བྱས།",
    "རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཁང་།",
    "དེའི་ཕྱི་ཉིན་ཐོར་གོད་པེའི་ལིས་ཞུས་ངོར་ཁོང་རང་ཡུམ་སྲས་དང་།",
    "མདའ་དཔོན་ལྕང་ལོ་ཅན་པ་བཅས་ཕྱིན་ཏེ་དཔུང་འཇུག་བྱེད་རྒྱུའི་གནས་ཚུལ་བྱུང་བར་འཁྲུག་ལོང་རང་སར་ཞི་བའི་ཐུགས་དམ་སྐྱབས་འཇུག་གནང་།",
    "ཁོ་རང་གཉིས་ལ་ཐོན་ཕྱག་གནང་སྐྱེས་ཀྱང་ཕུལ།",
    "ཙི་ནའི་ཁྲོམ་ཆེན་པོ་འདུག་པར་འགའ་ཞིག་ནི་ལག་ཏུ་མེ་ཏོག་དང་སྤོས་སོགས་ཐོགས།",
    "ཁྱེད་གཉིས་མ་ཕྱིན་ཚེ་བྱིངས་རྣམས་ཀྱང་གཏོང་ཐབས་མི་འདུག་པས་ཁྱེད་གཉིས་ཅི་ནས་ཀྱང་འགྲོ་དགོས།",
    "ཞབས་ཕྱི་རྣམས་ལ་ཡང་སོག་གུར་རས་གུར་སོགས་ཕུན་སུམ་ཚོགས་པ་བཤམས་འདུག་པར་ཞབས་ཟུང་བཀོད།",
    "པཎ་ཆེན་ཨེར་ཏེ་ནི་སྐུ་འབུམ་ནས་ཆིབས་བསྒྱུར་ཏེ་རྒྱལ་ཁབ་ཆེན་པོར་ཞལ་ཕྱོགས་པར་སྐུ་དྭངས་ཤིང་དཔྱིད་ཟླ་ཐ་མའི་ཚེས་བཅུ་ལ་སྐུ་འབུམ་དགོན་ནས་ཐོན་ཏེ་བགྲོད་བདེ་བཞིན་པར་ཕེབས་ཀྱི་ཡོད་འདུག་པ་ནི་ངེད་སེམས་ལ་དགའ་སྤྲོ་ཤིན་ཏུ་ཆེ་བ་བྱུང་།",
    "དཔའ་རིས་མཇལ་བ་ཁྲི་ཕྲག་བརྒལ་བ་འདུས་པས་ཀྱང་རང་འབྱོར་དང་བསྟུན་པའི་དངོས་འབུལ་བསྟར་ཞིང་།",
    "སྐབས་འདིར་གོང་མ་ཆེན་པོར་བདག་ཉིད་མཁར་སྔོན་དུ་འབྱོར་བསྟུན་ཐུགས་རྗེ་མུ་མཐའ་མེད་པའི་བཀའ་ཡི་གསེར་ཡིག་རྨད་དུ་བྱུང་བ་དང་གོང་མ་ཆེན་པོའི་གསེར་གྱི་སྐུ་ལ་བསྟེན་པའི་ཕེབས་བྱམས་སོགས་གོང་གསལ་མི་དྲག་ཆེད་མངགས་གདོང་སྩལ་འདུག་པ་དང་ལྷན་ཅིག་ཏུ་ཏའི་ཀར་ལྷ་སྲས་དྲུག་པ་དང་ལྕང་སྐྱ་ཧུ་ཐོག་ཐུ་ཕེབས་བསུར་གཏོང་རྒྱུ་ཡིན་ཚུལ་ཕེབས་པའི་ཞུ་ལན་རྟེན་གྱ་ནོམ་པ་དང་བཅས་འབུལ་བ་མཛད།",
    "དེ་ནས་གསེར་ཡིག་སྩལ་འདུག་པ་ལྷ་སྲས་ཆེན་པོས་བོད་སྐད་དུ་ཀློག་པ་མཛད་པར།",
    "སྐབས་དེར་བདག་ལ་ཡང་ཁྱེད་རང་ལམ་གྱི་དཀའ་ཚེགས་ལ་མ་ལྟོས་བར་ཨ་ལག་ཤ་བར་དུ་འོངས་ཏེ་ལྷག་བསམ་དཀར་བས་ཁུར་བླངས་ཀྱི་སྒོ་ནས་ཕྱག་མཛོད།",
    "ནགས་ཚལ་དུ་མ་འཁྲིགས་པའི་ས་ཆ་དང་སའི་ཧན་ཏ་པ་ཟེར་བའི་ལ་ཁ་ཤས་བརྒྱུད་དེ་ཕེབས་པར་ལའི་སྟེང་དུ་གོང་ནས་བརྩིགས་པའི་ལབ་ཙེ་ཆེན་པོ་ཞིག་འདུག་པར་སྙན་ཤལ་དང་བཅས་འཕྲིན་བཅོལ་མཛད།",
    "གོ་གོ་གེ་ཐེར་ཞེས་པ་ཕེབས་སྐབས་དགོངས་མྱུར་ནས་བཟུང་ཆར་དྲག་པོ་བབས་པས་དེ་ཀའི་ཆུ་ཆེན་པོ་ལ་ཟམ་པ་གསར་འཛུགས་མཛད་འདུག་པ་ཆུས་ཁྱེར་བས་བཅག་མལ་གཅིག་གནང་།",
    "གཟིམས་ཆུང་ནང་མའི་འགག་དེར་འཁོར་ཚོགས་མདུན་ན་འདོན་རྒྱལ་ཕྲན་གྲངས་མེད་པས་བསྐོར་ཏེ་བཞུགས་འདུག་པར་མཆོད་ཡོན་རྣམ་གཉིས་ཐོག་མར་གསེར་ཞལ་འཛོམ་འཕྲལ་རྗེ་ཉིད་ནས་འཇམ་པའི་དབྱངས་གོང་མ་བདག་པོ་ཆེན་པོར་ནང་མཛོད་ཁ་བཏགས།",
    "ཕྱོགས་འདིའི་སྐྱེ་བོ་མཆོག་དམན་ཐམས་ཅད་དགའ་སྤྲོ་ཆེན་པོ་བྱེད་འདུག་ཚུལ་སོགས་ཐུགས་མཆོག་ཏུ་དགྱེས་པའི་བཀའ་ཞིབ་ཏུ་ཕེབས་པར།",
    "ཆིབས་བསུ་བ་བཅས་འདུག་པ་རྣམས་དང་ཆབས་ཅིག་རིམ་གྱིས་ཕེབས་པ་ན།",
    "འདི་རང་ཚེ་སྔོན་མའི་བག་ཆགས་བཟང་པོས་པཎ་ཆེན་ཨེར་ཏེ་ནི་ལ་དད་པ་ཆེ་ཞིང་མཇལ་འདོད་ཤིན་ཏུ་ཆེ་བ་འདུག་པ་ད་ལམ་ངེད་ནས་ཨ་ཀི་རྣམས་དང་མཉམ་དུ་པཎ་ཆེན་ཨེར་ཏེ་ནིའི་མཇལ་ཁར་བཏང་བ་ཡིན་པས།",
    "ལུས་ལ་ས་ཆུ་མི་འཕྲོད་པའི་ཉམས་སོགས་གཏན་ནས་མེད་པར་ལུས་སེམས་ཤིན་ཏུ་བདེ་ཞིང་དགའ་སྤྲོ་བསམ་གྱིས་མི་ཁྱབ་པ་འདུག་ཅེས་ཞུ་བ་གནང་བར་གོང་ནས་ངེས་པར་ལེགས།",
    "དད་པ་དང་དགའ་སྤྲོ་ཆེན་པོ་བྱེད་ཀྱིན་འདུག།",
    "སྐྱབས་མགོན་ཆེན་པོའི་ཐུགས་རྗེས་སྐྱོན་ཡོང་བསམ་པ་གཏན་ནས་མི་འདུག།",
    "མཚམས་ཤིག་ནས་དེ་དག་ལས་འགའ་ཞིག་ས་ལ་འདུག་པ་དང་།",
    "དེ་ན་ཐོག་སོ་དོ་ཙམ་ཡོད་པའི་ཅོང་ཆེན་པོ་ཞིག་འདུག་པར།",
    "ཁོང་རང་ལ་སློག་ཆ་མི་དམན་པ་དང་།",
    "འཇམ་དབྱངས་གོང་མ་བདག་པོ་ཆེན་པོ་ཞེ་ཧོར་ནས་ཏོང་ལིང་དུ་ཕེབས་གྲུབ་འདུག་པར།",
    "མགྱོགས་བྱམས་ལ་འདུག་པའི་སྐྱེ་བོའི་རྒྱུ་འགྲུལ་བ་མང་པོ་དང་།",
    "ཆུ་བོ་དེ་དང་འདབ་ཆགས་པར་འཕགས་ཡུལ་གྱི་ཨ་ཙརྱ་རྣམས་ཀྱི་འདུག་གནས་ཨུ་ཐཱ་ཟི་ཞེས་པ།",
    "ཁོ་རང་ལ་ཡང་དགེ་ཐེབས་སྩལ།",
    "དེ་ཉིན་ཧུང་ཝང་ནས་ཞུས་ངོར་ཁོ་རང་དང་དགེ་སློང་འོད་ཟེར་ཅན་ཉི་ཤུ་སྐོར་ལ་ཚེ་དཔག་མེད་ཀྱི་རྗེས་གནང་སྩལ།",
    "ཁོ་རང་རྣམས་ནས་ཞུས་ངོར་སྒྲོལ་དཀར་ཡིད་བཞིན་འཁོར་ལོའི་རྗེས་གནང་དང་དམིགས་བརྩེ་མ།",
    "ནང་བློན་ཨེ་ཕུ་བདེ་ལེགས་གུང་ནས་ཞུས་ངོར་ཁོང་རང་གཅིག་པུ་ལ་འཇིགས་བྱེད་རིམ་གཉིས་ཀྱི་དམར་ཁྲིད་སྩལ།",
    "བབས་ལྕིའི་ན་ཟུག་གང་ཡང་མི་འདུག།",
    "ན་ཟུག་ནི་གང་ཡང་མི་འདུག་ཅེས་ཕེབས་ཤིང་།",
    "གསོལ་ཆས་ཐུགས་ཁམས་ལ་མི་འགྲོ་བ་དེ་གང་ཡིན་ཞུས་པར་གཟུགས་གཞི་མི་བདེ་བའི་རིགས་གང་ཡང་མི་འདུག།",
    "ཕྱག་རྩ་འཇམ་པོ་རང་ཡིན་འདུག།",
    "ཞེ་མེར་གྱི་ཉམས་དེ་ད་དུང་དེ་འདྲ་ཞིག་ཀ་འདུག་ཀྱང་།",
    "སྐུ་བརྙན་བཅས་འབུལ་རྒྱུ་གནང་སྟེ་ཅུང་ཟད་ན་བ་འདི་ལ་སྐྱོན་གང་ཡང་མེད་པས་གོང་མ་ཆེན་པོར་ངེད་གཟུགས་གཞི་མི་བདེ་བའི་ཉམས་འདུག་ཚུལ་གཏན་ནས་མ་ཞུ་ཞེས་གསུངས།",
    "ཁོང་རྣམས་ནས་སྐུ་ཅུང་ཟད་མི་དྭངས་པའི་ཚུལ་བཞེས་འདུག་ཟེར་ནས་ངེད་ཚོ་བློ་མ་བདེ།",
    "སྐུ་འཁྲུགས་དང་སྐུ་མཚལ་རྒྱས་པའི་ཉམས་ལས་སྙུན་གཞི་བབས་ལྕི་བའི་ངོ་ཕྱག་རྩ་དང་ཆབ་རྟགས་གཉིས་ཀར་མི་འདུག་ཞུ་བ་ལྟར།",
    "གསོལ་ཆས་མཆོད་བཞེད་མེད་པ་ཙམ་ལས་སྐུའི་གཟི་མདངས་སོགས་ལ་དཔགས་ན་སྙུན་གཞི་བབས་ལྕིའི་ཉམས་རང་མི་འདུག་ཀྱང་།",
    "ཚེས་ཉེར་བརྒྱད་ཀྱི་ཐོ་རངས་གསོལ་དཔོན་ནས་སྐུ་ཁམས་ཅི་འདྲ་འདུག་ཞུས་པར།",
    "གལ་སྲིད་ཡིན་པར་ཤར་ཚེ་མན་ངག་དང་ལག་ལེན་གང་ཅིར་གོམས་འདྲིས་ཆེ་བའི་ཨེམ་ཆི་མཁས་པ་ཞིག་ས་ཕྱོགས་གང་ན་ཡོད་ཀྱང་འབོད་དགོས་ཞུས་པར་ཕྱག་རྩ་དང་ཆབ་ལ་གསལ་པོ་མི་འདུག་རུང་།",
    "སྐུ་གཟུགས་ཀྱི་བབས་ལ་གཞིགས་ན་འབྲུམ་པ་རང་མིན་པའི་ངེས་པ་མི་འདུག།",
    "ཕྱག་རྩ་ལ་བལྟས་ན་སྙུན་བབས་ཆེ་བའི་རྟགས་གང་ཡང་མི་འདུག།",
    "ཁྱེད་རང་རྣམས་ཐུགས་བློ་མི་བདེ་བའི་རིགས་གཏན་ནས་གནང་མི་དགོས།",
    "ངེད་གཟུགས་གཞི་ཅུང་ཟད་མ་བདེ་ཡང་ཡིད་མི་བདེ་བ་སོགས་གང་ཡང་མི་འདུག་པས་སྐྱོན་གང་ཡང་མི་ཡོང་ཞེས་ཕེབས།",
    "ཟུག་རྔུ་ལ་སོགས་པ་གང་ཡང་མི་འདུག་ཀྱང་།",
    "རྒྱལ་སྲས་དྲུག་པ་བཅས་བྱུང་བར་ཨེམ་ཆི་གཉིས་ནས་ཕྱག་རྩ་ཕུལ་བར་ཕྱག་རྩའི་བབས་བསྟར་ཆགས་རང་ཡིན་འདུག།",
    "གཟུགས་གཞིར་མི་བདེ་བའི་སྐྱོན་ཆེར་མི་འདུག་པས་འཇམ་པའི་དབྱངས་གོང་མ་ཆེན་པོ་ཐུགས་གཡེང་བའི་རིགས་གཏན་ནས་མི་གནང་བ་དགོས་ཚུལ་སོགས་ནན་གྱིས་ཞུ་དགོས་ཕེབས།",
    "ཨེམ་ཆི་རྣམས་ནས་ཕྱག་རྩ་སྔ་མ་ལྟར་ལས་འགྱུར་ལྡོག་མི་འདུག་ཅེས་ཞུས།",
    "ཁོ་ཚོ་མི་གཞི་དང་རང་གཤིས།",
