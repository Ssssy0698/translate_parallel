    "བསྟན་པ་རིན་ཆེན་མཆོག་གིས་མ་ཁྱབ་པའམ།",
    "བུས་བཙུགས་ཐལ་མོ་སྦྱར་བ་ཡིས།",
    "འདི་ཀའི་འདུན་པ་ཡོངས་ལ་དབུས་བརྒྱུད་འཇམ་དཔལ་ཞལ་ལུང་གི་ཁྲིད་དང་།",
    "ཨ་རོལ་སྐུ་གོང་མའི་ཕྱག་དྲིལ།",
    "དབྱེར་མེད་རྡོ་རྗེ་གྲགས་པའི་བཀའ་ལུང་གིས།",
    "དཔལ་པོད་ཀྱི་གླེགས་བམ་བྲིས་མ་བྱིན་ལྡན་དང་བཅས་ཟང་ཟིང་གི་དངོས་འབུལ་རྒྱ་ཆེར་ཕུལ།",
    "དེའི་རྗེས་ཆོག་གི་ལུང་དང་བཅས་པ་ཡོངས་སུ་རྫོགས་པའི་བཀའ་དྲིན་སྩལ།",
    "གྲོ་ཚང་དུ་གནས་གཟིགས་ལ་བྱོན།",
    "ལྷ་མོ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "ནང་གཉེར་བ་ཐམས་ཅད་ཀྱིས་འདུན་པ་གཅིག་སྒྲིལ་སྒོས་ད་རེབ་ཡབ་སྲས་རྣམ་པའི་ཐུགས་བསྐྱེད་དུས་བབ་ཀྱིས་འདི་བཞིན་རྗེ་འདི་ཉིད་ཀྱི་ཕྱག་ཏུ་འཕྲོད་པ་ཡིན་པས་སླད་ཕྱིན་སྐུ་དོན་གྱི་ཕྱོགས་གང་ཐད་དང་།",
    "ལྡན་གྱི་སྐྱེ་བོ་ཕོ་མོ་བགྲང་གིས་མི་ལང་བ་དག་གིས།",
    "འདུ་གང་གི་རྨང་ལེགས་པར་བཏིང་ཟིན་པའི་སྟེང་།",
    "ལོ་འདིར་འདུ་ཁང་ཆེན་མོའི་བརྩིགས་པ་ལེགས་པར་གྲུབ་ནས་ཤིང་གི་ལག་རྩལ་ལ་མཁས་པའི་བཟོ་བ་རྣམས་ཀྱིས་འབད་རྩོལ་བྱེད་བཞིན་པ་དང་།",
    "དད་པ་དང་གཏོང་བའི་ཡོན་ཏན་གྱི་ལང་ཚོ་རབ་ཏུ་དར་བའི་བླ་དཔོན་སྦྱིན་པའི་བདག་པོ་འཁོར་དང་བཅས་པ་གདན་འཛོམས་པར།",
    "གནས་བདག་རྣམས་ལ་གཏང་རག་གི་མཆོད་གཏོར་བསང་གསུམ་གང་རྒྱས་གནང་།",
    "དེའི་ཚེ་དཀར་ཕྱོགས་ལ་དགའ་བའི་ལྷ་རྣམས་རབ་ཏུ་དགའ་བས་ནམ་མཁའི་རྔ་གསང་སྒྲོགས་པ་དང་མེ་ཏོག་གི་འདབ་མའི་དབྱིབས་ཅན་གྱི་ཁ་ཆར་འབེབས་པ།",
    "གནས་རིའི་རྩེ་ནས་འཇའ་ཚོན་སྣ་ལྔ་ཉིས་བརྩེགས་འདུ་ཁང་གི་ཐད་དུ་གཞུ་དབྱིབས་ལྟར་ཟུག་པ་སོགས་ངོ་མཚར་རྨད་དུ་བྱུང་བའི་ལྟས་ཁྱད་པར་ཅན་དེར་འདུས་ཀྱི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱིས་མངོན་སུམ་དུ་མཐོང་བས་དགའ་དད་ཀྱི་རྦ་རླབས་ཆེས་ཆེར་འཁྲིགས།",
    "ཤིས་པ་བརྗོད་པའི་ཚིགས་སུ་བཅད་པ་སོགས་གསུངས་བཞིན་ཕྱོགས་ཐམས་ཅད་དུ་བཀྲ་ཤིས་པའི་མེ་ཏོག་གི་ཆར་ཕབ།",
    "བུད་མེད་རྣམས་ཀྱི་ལང་ཚོ་བཞིན།",
    "རེ་རེ་ལ་ལྷ་དར།",
    "ཉེར་མཁོའི་ཞལ་ཐང་འགའ་རེ།",
    "གཞན་ཡང་རྒྱལ་མོ་ཚ་བ་རོང་དུ་རྒྱལ་ཁག་གསུམ་དུ་གྱེས་པའི་ཡ་གྱལ།",
    "དེའི་ཞལ་བཤུས་སྐྱབས་རྗེ་ཁྲི་རྒན་རྡོ་རྗེ་འཆང་ནས་ཀིརྟིའི་བླ་བྲང་ལ་གཡར་བ་དེ་མ་ཕྱི་བྱས་ཏེ་རྟོགས་བརྗོད་དཔག་བསམ་འཁྲི་ཤིང་གི་ཞལ་ཐང་བརྒྱ་དང་དགུ་སོགས་བཞེངས་པའི་མགོ་བརྩམས་པར།",
    "གསེར་སོགས་རྒྱུ་སོང་གི་རིམ་པ་མཐའ་དག་ཕངས་མེད་དུ་སྩལ་ཏེ་བྱ་བ་ལས་ཀྱི་འཁོར་ལོ་སྐྲུན་པའི་བཟོ་གྲྭ་བཙུགས་སོ།",
    "རྗེ་འདི་ཉིད་ཐུགས་ཧ་ཅང་ཞིབ་ཚགས་ཆེ་བས་ལན་བཅུ་ལྷག་རེ་འབྲི་བསུབ་བྱས་ཏེ་ཡང་ཡང་མ་བྲིས་པར་ཁོང་གི་ཐུགས་ལ་མི་འབབ་པ་དང་།",
    "འདུ་ཁང་གསར་བ་རྗེས་མའི་སྒོ་ཆེན་དུ་བཞུགས་རྒྱུའི་རྒྱལ་ཆེན་ཡུལ་འཁོར་སྐྱོང་གི་སྐྱ་ཐིག་འདེབས་སྐབས།",
    "རྗེས་སུ་ཁོང་རྡོ་རྗེ་འཆང་རང་ཉིད་ཀྱིས་ཕྱག་གིས་ཐིག་རིས་བཏབ་པ་དེ་ལྟར་དུ་བཞེངས་པས་ཞལ་རས་དང་སྐུ་ཉམས་ཧ་ལས་པ་བྱུང་སྟེ་གསོན་ཉམས་ལྡན་པ་ལྟ་བུའི་རང་བྱོན་དུ་གྱུར་པ་དང་།",
    "གསེར་བྲིས་ཐེན་ཚུལ་ཐམས་ཅད་རྗེ་རང་གི་སྐུ་གམ་དུ་བྱས་པ་དང་།",
    "དེ་ལྟར་དུ་རྡོ་རྗེ་འཆང་རང་གི་གཟིམ་ཆུང་སོ་སོ་དང་།",
    "ལྷག་པར་དུ་སྐྱེས་རབས་དཔག་བསམ་འཁྲི་ཤིང་གི་ཞལ་ཐང་ཡོངས་རྫོགས་སྔ་རྗེས་སུ།",
    "བཟོ་བོ་འདི་ཁོ་ནས་ཚར་གསུམ་བཞེངས་པ་ཕྱིས་སུ་ཁོ་བོ་ལ་སྐུ་ཞབས་ཆེ་བ་ཚང་གི་ལྷ་བཟོ་ཞེས་ཕྱོགས་ཡོངས་སུ་གྲགས་སོ།",
    "ཡི་གེ་བཞི་བའི་བསད་ཟློག་གི་ཁྲིད།",
    "སྟག་ཕུའི་གསུང་ནང་མ་བཀའ་རྒྱ་མ་སོགས་ཀྱི་ལྗགས་ལུང་ལེགས་པར་གསན་ཅིང་བཀའ་དྲིན་གཏང་རག་གི་དངོས་འབུལ་རྒྱ་ཆེན་ཕུལ།",
    "དེ་ནས་སྐྱབས་མཆོག་ཁྲི་རྒན་རྡོ་རྗེ་འཆང་གི་གསུང་བཀོད་ལྟར།",
    "སྟག་ཕུའི་གཟིགས་སྣང་བཅུ་གསུམ་སོ་སོའི་རྩ་བའི་སྒྲུབ་ཐབས་བཀའ་རྒྱ་མའི་སྐོར་སོགས་ཀྱི་བཀླག་ལུང་རྫོགས་པར་ཕུལ་བས་ཐུགས་མཉེས་པའི་རྩེར་སོན།",
    "མོས་པ་རྣམ་པར་འཕེལ་བྱེད་པ།",
    "ཁྲོས་ནག་གི་ཆོ་ག་རྒྱས་པ་དང་འབྲེལ་ལུས་སྦྱིན།",
    "བསྒྲུབ་བྱ་དུ་མར་དགེ་ཚུལ་སློང་གི་བསླབ་པ་ཕོག་དེ་ནས་གཉན་ཐོག་དགོན་གྲོང་གིས་གདན་དྲངས་པ་ལྟར་བསུ་བ་སེར་སྦྲེང་གི་མཆོད་བཀུར་དང་བཅས་གཉན་ཐོག་བཀྲ་ཤིས་དར་རྒྱས་གླིང་དུ་ཕྱགས་ཕབ།",
    "གཞན་ཡང་ཐེག་ཆེན་གསོ་སྦྱོང་གི་སྡོམ་ལུང་དང་།",
    "བཅུ་ཕྲག་ལྷག་དགེ་ཚུལ་སློང་གི་བསླབ་པའི་གཞི་ལ་བཀོད་དེ་སླར་རོང་བོ་དགོན་ཆེན་དུ་བྱོན།",
    "སྔ་ལོ་ནས་སྐྱབས་མཆོག་ཁྲི་རྒན་རྡོ་རྗེ་འཆང་གི་ཞལ་སློབ་དྲག་ཞན་མང་བོ་དང་ཁྱད་པར་དུ་ཡབ་སྲས་རྣམ་གཉིས་ལ་དད་གུས་ཀྱི་ལང་ཚོ་དར་ལ་བབ་པ་འདམ་བུ་བྲག་དཀར་སྤྲུལ་བའི་སྐུ་སྣང་མཛད་རྡོ་རྗེ་ནས།",
