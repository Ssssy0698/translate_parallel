    "འདི་རུ་མ་འདུག་འུ་ཅག་རྩོད་པ་འོང་།",
    "འདྲེན་སྟོན་པདྨ་ལས་འབྲེལ་ཁོ་རང་དྲན།",
    "དེའི་ཚེ་ཡང་རང་ཉིད་ཀྱིས་གཏན་ཚིགས་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "སོགས་པའི་སྒྲས་ནི་རང་བཞིན་ཏེ་མ་འདྲེས་པའི་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པའི་རང་བཞིན་དང་ཕན་ཚུན་དང་རང་བཞིན་ལས་ཐ་དད་པའི་སྐྱེས་བུ་གཟུང་ངོ།",
    "རྒྱུ་དང་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་བཞིན་དུ་གཏན་ཚིགས་ལ་སོགས་པ་འདིར་ཡང་རང་བཞིན་བཟུང་བ་ཁོ་ནའོ།",
    "ཅི་སྟེ་སྒྲ་རྣམས་ནི་རྟག་པའི་ཕྱིར་དུས་ཐམས་ཅད་དུ་གནས་པས་དོན་དང་ལྷན་ཅིག་དུས་ཐ་དད་པ་མ་ཡིན་ལ།",
    "ཁ་ཅིག་དུས་གཞན་དུ་དཔུང་རྒྱན་མཚར་པོ་ཅན་གྱི་སྒྲ་དེ་ལ་མཛེས་པའི་ཅོད་པན་ཅན་གྱི་མཆོག་སྦྱིན་རྟོགས་པ་ནི་མ་ཡིན་ནོ།",
    "མ་མཐོང་བ་ཡང་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བའོ།",
    "དེ་ལ་ལྡོག་པ་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བའི་ལྐོག་ཏུ་གྱུར་པ་ལྡོག་པ་ཡང་མ་ཡིན་ནོ།",
    "གཞན་ཡང་རང་བཞིན་གཉིས་པ་མེད་པའི་ཕྱིར་གཅིག་ཉིད་ཡོད་པའི་ཕྱིར་འགྲོ་བ་ཐམས་ཅད་དངོས་པོ་གཅིག་ཏུ་འགྱུར་བས་གཅིག་དུ་མའི་རྣམ་པ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་དམ་བཅའ་བ་ཉམས་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་དང་རང་བཞིན་མེད་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་གཅིག་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་འགལ་བ་དེ་ཉིད་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "གང་ཟག་དང་རྒྱུན་རང་བཞིན་མེད་པ་དེ་བཞིན་དུ་བྱ་བ་ཡང་རང་བཞིན་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་དུས་དཔག་ཏུ་མེད་པར་འགྱུར་བ་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "འཁྲུལ་པ་ཞེས་བྱ་བ་ནི་ཉམས་སུ་མྱོང་བ་ཇི་ལྟ་བ་བཞིན་དུ་སོ་སོར་ངེས་པའི་ཡུལ་དང་དུས་དང་རང་བཞིན་ལ་སོགས་པའི་ཁྱད་པར་གྱི་ངོ་བོས་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "འདི་སྙམ་དུ་དཔེར་ན་ད་ལྟར་བྱུང་བའི་སེམས་ཀྱི་སྐད་ཅིག་འདས་པ་དང་མ་འོངས་པའི་སེམས་ཀྱི་སྐད་ཅིག་དག་དུས་ཀྱིས་བྱས་པའི་བར་མེད་པ་ཉིད་ཡོད་ཅིང་།",
    "ཐམས་ཅད་ཀྱི་རང་རང་སོ་སོར་རིག་པའི་ཕྱིར་རོ།",
    "གང་དང་རང་རིག་པ་ཡིན་པ་དེ་དང་དེ་ནི་ཤེས་པ་ལས་དོན་གཞན་དུ་གྱུར་བའི་ཡུལ་ཅན་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་དུ་ཡོད་པའི་ཕྱིར་བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་སྒྲ་ཐ་དད་པ་དང་མི་རྟག་པར་གྲུབ་པའི་ཕྱིར་དེ་ཇི་ལྟར།",
    "བློ་གསལ་བ་དང་གཞན་པ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་བ་དེ་བཞིན་དུ་སྒྲ་ཡང་རང་ལས་རང་བཞིན་ཐ་དད་པ་མེད་ན་ཡང་གསལ་བར་བྱེད་པའི་སྒྲ་ཙམ་ཐ་དད་པའི་ཕྱིར་རིང་པོ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སྐྱོན་མེད་དོ།",
    "འདི་ལྟར་དེ་དག་རིགས་ཀྱི་ཁྱད་པར་ཐ་དད་མ་ཡིན་ཡང་རང་ལས་རིམ་པ་ཡོད་པ་མ་ཡིན་ཏེ་ཆ་ཤས་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱིས་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་འོད་མ་ལ་སོགས་པ་དྲུང་པ་ལས་བྱུང་བ་གང་ཡིན་པ་དེ་འདིར་འཁྲུལ་པའི་ཡུལ་ཉིད་དུ་བལྟ་བར་བྱའི་གང་གཙུབ་ཤིང་གཙུབས་པའི་སྐྱེས་བུས་བྱས་པ་དེ་ལ་སྐྱེས་བུས་མ་བྱས་པ་མི་སྲིད་པའི་ཕྱིར་དེས་གཏན་ཚིགས་འཁྲུལ་པ་མ་ཡིན་ནོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "སྐྱེས་བུས་མ་བྱས་པ་དག་ལ་ཡང་རང་བཞིན་གྱིས་ལོག་པའི་དོན་ཤེས་པའི་རྒྱུ་ཉིད་སྲིད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུའི་འདོད་པ་ཡང་རང་དགའ་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཉེ་བ་དང་བསྐལ་པ་དག་དུས་མཚུངས་པར་འཛིན་པའོ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་གྱིས་དམིགས་པར་འགྱུར་བའམ།",
    "དེ་ལྟ་ཡིན་དང་འཇིག་པ་འདི་གཉིས་ཀྱང་རང་བཞིན་མེད་པ་ཡིན་ན།",
    "དེ་ཡང་རང་ཉིད་ལས་གནས་པའི་ཕྱིར་ཐུག་པ་མེད་པ་གང་ལས་ཡིན།",
    "དེ་ལ་ཡང་ཉེས་པ་མེད་པ་ནི་ཡོན་ཏན་དག་ལ་ཡོངས་སུ་ཤེས་ལ་དེ་ལྟ་ན་ཡང་དེ་ལྟ་བུ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པར་གཞག་པ་ཐམས་ཅད་ཉམས་པ་ཐུག་པ་མེད་པའི་གནས་སྐབས་དེ་ཉིད་སོན་འདུག་པ་ཡིན་ནོ།",
    "དེ་དག་དུས་ཕྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འདི་ལ་ཡུལ་དང་དུས་དང་རང་བཞིན་དང་གནས་སྐབས་ཇི་ལྟ་བ་བཞིན་དུ་སྣང་བ་ཡོད་པ་མ་ཡིན་ལ།",
    "རང་ལས་གྲུབ་པ་ཡིན་ན་ཡང་རང་ཉིད་གསལ་བའི་བདག་ཉིད་ཀྱིས་སམ།",
    "འདི་ལྟར་མི་དམིགས་པ་ཡང་དངོས་པོ་མེད་པའི་བདག་ཉིད་ཡིན་པར་ཇི་ལྟར་གྲུབ་ཅེས་དེ་ལ་ཡང་རང་ངམ་གཞན་ལས་ཞེས་བྱ་བའི་བསམ་པ་འདི་འཇུག་པ་ཉིད་དོ།",
    "རྟག་པའི་ཕྱིར་དང་རང་བཞིན་དུ་བྱ་བར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་སྐྱོན་གྱི་གནས་སྐབས་སོ་ན་འདུག་པ་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ལྟ་བས་ན་ཐེ་ཚོམ་ཟ་བ་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་པས་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ཐ་དད་པར་རིག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་རང་ཉིད་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་ཁས་བླངས་པར་འགྱུར་རོ།",
    "དེ་ཡང་རང་བཞིན་དང་།",
    "གཉིས་ཀ་ཡང་རང་བཞིན་གྱིས་བསྐལ་པས་མི་དམིགས་པར་སྲིད་པའི་ཕྱིར་རོ།",
    "སྐྱོན་རྣམས་རང་བཞིན་མ་ཡིན་པ་ཉིད་ཡིན་ན་ཡང་ཟད་པའི་ཐབས་མི་སྲིད་པའི་ཕྱིར་མི་འདུག་པའམ་སྟེ།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་དང་ཤེས་བྱ་ཉིད་ཡོད་པ་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལྡོག་པ་ཡིན་ནོ་ཞེས་ཁྱེད་ཀྱི་ཁས་ལེན་པ་དེ་ལྟ་ན་ནི་ཡོད་པ་ལ་སོགས་པ་ཉེ་བ་ལས་སྔར་འདིའི་མེད་པ་ཉིད་དང་རང་རིག་པས་ཀྱང་ཤེས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཅེས་ཁས་བླངས་པར་འགྱུར་ལ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བའི་དོན་མཐོང་བར་ཁས་ལེན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྟོག་པ་ཡང་རང་བཞིན་གྱིས་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ལ་མངོན་དུ་འགྱུར་ན་འཁྲུལ་པར་འགྱུར་རོ་ཞེ་ན།",
    "རང་རང་ལ་གྲགས་ཤིང་གྲུབ་པའི་སྣང་ཚུལ་སྣ་ཚོགས་ཡོད་པའི་རང་ངོའི་སྣང་བ་དེ་དག་ཐད་ཀརང་སར་སྤོསྤྲོས་བྲལ་དུ་གཏན་ལ་འབེབས་པ་ཡིན་གྱིགྱི།",
    "ཡང་རང་རྒྱུ་དང་སྦྱོར་ཡང་རུང་སྟེ།",
    "རིལ་པོ་གཅིག་མིན་ཀྱང་རུང་རང་བཞིན་ནམ་རྒྱུད་ལྟབུ་གཅིག་ཡིན་པས་གནས་སྐབས་ཐ་དད་ནའང་རྟག་པ་ཡིན་པཅི་འགལ་སྙམ་དུསེམས་པ་སྟེ།",
    "འདིལ་འགྲེལ་ལུགས་སྣ་ཚོགས་མཛད་འདུག་ཀྱང་གཞུང་དོན་མ་ནོརབ་འདི་ཁོ་ནའོ།",
    "སོ་སོར་བརྟགས་པའི་སྟོབས་ཀྱིས་ཁེགས་པ་མིན་ལང་རང་བཞིན་གྱི་རྐྱེན་མ་ཚང་བས་གངསྐྱེས་མིན་པ་ལ་དེམ་སྐྱེས་པའི་ཆ་ངེག་ལ་དངོས་པོ་དེ་སྐྱེ་བའི་གེགས་བྱེད་པའི་འདུས་མ་བྱས་སོ་སོར་བརྟགས་མིན་ཞེས་རྫས་སུ་རློམ་པ་དང་།",
    "དངོས་མེད་པོ་རང་རང་རྐྱ་ཐུབ་པར་གཞིར་བཞག་ལ་དགག་སྒྲུབ་མིབྱེདཔར་བསྟན་ན་དོན་དམ་པར་མ་ཐུབ་པ་ལྟ་ཅི་སྨོས།",
    "དེལ་བློས་དམིགས་ནས་བདག་དང་སྐྱེས་བུ་ལ་སོགས་པའི་རྣམ་གྲངས་ཀྱིས་བརྗོད་ཅིང་རང་རྒྱུད་དུགཏོགས་པ་གང་ཡིན་པ་དེ་ལ།",
    "མ་ཡིན་པར་བརྗོད་པཞེས་གཟུང་འཛིན་གྲངས་མཉམ་འགོག་པའི་རིགས་པབསྟན་འདུག་པ་འདིས་གཟུང་འཛིན་གྲངས་མཉམ་འདོད་ཚུལག་ཞན་གྱི་ལུགས་དགག་པའི་ཤུགས་ཀྱིས།",
    "དེལ་སྐབས་འདིར་བལ་ཆེར་རྟོག་པ་དང་རྟོག་མེད་ཀྱི་བྱེདཔ་འདྲེས་ཏེ་ཚུལ་བཞིན་སྨྲ་བ་དཀོན་པར་འདུག་ནའང་།",
    "དེ་ཕྱིར་དྲན་པ་ནི་འདས་པའི་ཡུལ་ཅན་ཁོ་ན་ཡིན་པས་མདུནན་འདུག་པའི་དངོས་པོ་ལའང་ཤིན་ཏུགསཝ་བརམི་རྟོག་སྟེད་ལྟ་བའི་ཡུལ་ཅན་མིན་པའི་ཕྱིར་རོ།",
    "ཡུལ་ཁ་བོས་ཀྱང་རང་འཛིན་མིག་ཤེས་ལ་སྔོ་སེར་སོགས།",
    "རང་འགྲེལ་ན་ཕྱོགས་སྔས་བརྗོད་པའི་ཤ་ལོཀ་གཉིས་བཀོད་འདུག་པའང་དེ་ཡིན་ནོ།",
    "རྟོག་དང་རྟོག་མེད་ཀྱི་བྱེདཅིག་དུས་ཅིག་ཅར་རིགས་མཐུན་པའི་ཤེས་པ་དུ་མ་སྐྱེ་བར་འདོད་པ་ནི་ཐ་སྙད་དུའང་མི་འཐདལ།",
    "གཞན་དུ་ངོ་བོ་མེད་པ་ཙམ་ལ་ཟུང་ནས་གཏོལ་མེད་དུ་འདུག་པ་གང་དག་མཐར་རང་ལའང་མཚུངས་པའི་འག་ཆོང་ལཱུ་བ་རྣམས་ནིཕུ།",
    "ཡུལ་ཅན་གྱི་ཤེས་པས་ཀྱང་རང་སྟོབས་ཀྱི་ཡུལ་དེ་ལ་མེད་པའི་དངོས་པོ་དེཤེས་པར་བྱར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའང་རྟའི་རཱཅོ་ལ་ཁོ་རང་སྣངབའིཤེས་པ་བསྐྱེད་པའི་ནུས་པ་མེདཔས།",
    "རྣམ་པ་སྣ་ཆོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པ་ཞིག་ཡིན་ནོ།",
    "དེའང་རང་མིན་པ་བསལ་བའི་ཚུལ་གྱིས་དེའི་པར་བྱ་བ་རྣམ་བཅད་དང་།",
    "དེ་ལྟར་ཀུན་རྫོབ་ཅེས་པ་རྣམ་བཅད་ཀྱི་སྒོ་ནས་བསྟན་པའི་། མཚན་ཉིད་གསུམ་ལྡནཐ་སྙད་པའི་ཚདམའི་ངོར་བསྐུ་མེད་བསྙོན་མེད་དུ་སྣང་ཡང་རང་བཞིན་བདེན་པར་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མེད་པ།",
    "འདུས་པའི་ཇུས་ནའང་རང་བཞིན་གྱིས་མྱངན་ལས་འདས་པ་སྟེ་ངོ་བོ་མེད་པའི་སླདབུའོ།",
    "དོན་དུ་ངོ་བོ་ཟུང་འཇུག་འབྲལ་མི་ཤེས་པའི་ཡེ་ཤེས་ཀྱི་སྐུ་ཡིན་ནོདེའང་རང་འགྲེལ་ལས།",
    "སླར་ཡང་རང་འགྲེལ་དང་དཀའ་འགྲེལ་གཉིས་ལའང་བལྟ་བརབྱས་ན་ལེགས་སོ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "འདི་འདྲའི་ལུགས་དེ་བསྟན་སུན་འབྱིན་དང་རང་ཕྱོགས་ཕུང་བྱེད་དང་།",
    "གཞན་སྟོང་པ་རྣམས་ཀྱིས་ཀྱང་ཧ་ཅང་སྤྲོས་པས་ཆོ་གཔར་འདུགགོ།",
    "དེ་ནས་ཕྱི་དོན་དུ་གྱུར་པའི་གཟུགས་དང་། བེར་བོ་སོགས་མེད་ཅེས་ཤེས་བྱ་ཀུན་ལ་སྦྱང་ཤེསན་ཐེགས་འདུག་པས།",
    "འདི་རྣམས་དོགས་པའི་གནས་སུ་འདུག་པས་ད་ལྟར་བཅད་པའང་དོན་ཡོད་དོ།",
    "འབྲས་བུའི་སྐ་བས་ལ་དཔྱད་དགོས་པ་མི་འདུག་གོ།",
    "ཕྱོགསཙམ་རྟོགས་པ་ཉན་ཐོས་དང་རང་རྒྱལ་བགཉིས།",
    "དེ་ལའང་རང་བཞིན་རྒྱུར་ལྟབས།",
    "འདི་རྣམས་ཀྱང་རང་བཞིན་དང་གནས་སྐབས་ཀྱི་བྱེ་བྲག་ད་དོ།",
    "ཟུར་དངལངས་ཏེ་འདུག་ལ་ལང་། བརྐྱང་བསྐུམ་རྐང་ལག་འཁྱུད་སྟབས་ཀྱིས།",
    "ལྷ་ཡི་འདུག་སྟངས་འདི་བཞི་ལ།",
    "གསལ་ཉམས་སྐྱེད་པར་བྱེད་པ་ཡི་། ལྷ་མིན་འདུག་སྟངས་རྣམ་བཞི་ནི།",
    "འཕྲེད་དམ་གན་རྐྱལ་དུའདུགལ།",
    "འཇིགས་པ་རིག་མ་ཙོག་པུར་འདུག།",
    "ཕྱིར་བགྲད་ཚུལ་གྱིས་འདུག་པར་བྱ།",
    "མི་ཡི་འདུག་སྟངས་རྣམ་བཞི་ནི།",
    "འདི་སྐབས་ཡུམ་གྱི་འདུག་སྦྱངས་རྣམས།",
    "དུད་འགྲོའི་འདུག་སྟངས་རྣམ་བཞིན།",
    "ཡང་ནཐབས་ནི་འགྲེང་སྟེ་འདུག།",
