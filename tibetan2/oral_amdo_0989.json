    "ཛིསྐད་དུ་དགེ་སློང་དག་མིག་ནི་ནང་གི་སྐྱེ་མཆེད་དེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་རྟེན་ཡིན་ནོ་ཞེས་བྱ་པའི་ཐཚིག་སྟེ།",
    "ཏུ་སྨྲ་བ་དག་གི་བསམ་པ་ནི་དབྱིབས་སུ་ཡོད་ལ་ཁ་རྡེག་ཏུ་མེད་པ་ཡང་ཡོད་དེ།",
    "མིག་གི་ཡུལ་རིང་བ་ལ་སོགས་པའི་ཕྱོགས་ལུས་ཀྱི་རྣམ་པར་རིག་བྱེད་ཀྱི་དེ་པེ་ཉིད་དོ།",
    "མཉམ་པར་བཞག་པའི་ནི་གཡེང་བ་དང་སེམསུ་མེད་པའི་རྗེས་སུ་འབྲེལ་བ་མེད་པས་དེ་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་མ་ཡིན་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཉམས་པཡིན་ནོ།",
    "གཅིག་གཅིག་གིས་དེ་དག་ལ་སྒྲ་ད་ངེབརྟགས་ནས་ཁྱབ་འཇུག་བཤེས་ལ་ནི་ནོར་ཡོད་དོཞེས་སྨྲས་པ་དང་།",
    "ཁྱེད་ཀྱི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་མོད།",
    "དེ་ལྟ་བརྒྱུད་འོག་བསན་སློབ་དཔོན་གྱི་བཞེད་པ་ལྟར་ཁོ་བོ་ཅག་གི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་མཚན་ཉིད་འདི་བཞག་སླའོ།",
    "ཅིའི་ཕྱིར་གཟུགས་སུ་རུང་ཞེན་ལག་པའི་འདུས་ཏེ་རེག་པས་རིག་ན་ཡང་གཟུགས་སུ་རུང་ངོ་ཞེས་རྒྱས་པར་གསུངས་པ་ལྟ་བུའོདེ་ཡང་གཟུགས་སུ་རུང་ཞེས་བྱ་བ་ནི་གནོད་པ་བྱར་རུང་ཞེས་བྱ་བའི་ཐཚིག་གོ།",
    "མཆན་འགྲེལ་སྐྱེ་མཆེད་རྣམ་པར་བཞག་པ་ནི་སྐྱེ་མཆེད་བཅུ་སྟེ་ཡིག་གི་སྐྱེ་མཆེད་དང་གཟུགས་ཀྱི་སྐྱེམཆེད་ནས་ལུས་ཀྱི་སྐྱེམཆེད་དང་རེག་བྱའི་སྐྱེ་མཆེད་ཀྱི་བར་ཡིནནོ།",
    "དེ་ཡང་དབྱེན་ོར་པའི་ཚོགས་དྲུག་སྟེ་མིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོ་ད་བ་སྐུས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་ངའི་བར།",
    "དག་གི་ངོ་བོ་ཉིད་ཀྱིས་ཏེ།",
    "བསྡུ་བའི་དངོས་པོ་བཞིས་འཁོར་རྣམས་བསྡུས་པ་ལྟ་བུ་གཞན་གྱིས་གཞན་བསྟུས་ས་བྱ་བ་གང་ཡིན་པ་དེ་ནི་རེ་འགའ་བ་ཡིན་པའི་ཕྱིར་བརྡར་བཏགས་པ་ཡིན་པ་ཤེས་པར་བྱའོ།",
    "བུད་པ་དང་སྐྱེ་མཆེད་དང་ཁམསརྣམས་ཡིན་ནོ།",
    "ཡང་ཅིའི་ཕྱིར་བཙེམ་ལྡན་འདས་ཀྱིས་བུད་པེ་ལ་སོགས་པའི་སྒོ་ནས་སྟོན་པ་རྣམ་བ་གསུམ་རྩོམ་པར་མཛད་ཅེ་ན།",
    "གདུལ་བྱ་རྣམས་ཀྱི་མོས་པ་གསུམ་དང་དབད་ཕོ་ཀྱཤས་གསུམ་དང་འདོད་པ་རྣམ་པ་གསུམ་གྱི་ཕྱིར་ཏེ།",
    "སེམས་ཀྱང་ཉོན་མོངས་ཅན་དུ་བྱས་པས་སོ།",
    "མིག་ལ་སོགས་པའི་ཁམས་དང་སྐྱེ་མཆེད་དྲུག་གི་གོ་རིམ་ནི་ད་ལྟ་བའི་དོན་ཡིན་པའི་ཕྱི་དང་པོ་གཟུགས་སོགས་ལ་སྨོས་སོ།",
    "པཚིག་ལྟེ་མིག་གི་ཡུལ་ནི་གཟུགས་ཀྱི་སྐྱེ་མཆེད་དང་།",
    "རང་གི་མཚན་ཉིད་ལ་ལེགས་པར་དཔྱད་དེ།",
    "ལྷག་མ་རྣམས་ནི་འདུ་བྱེད་ཀྱི་བུད་པོས་བསྡུས་སོ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེདམིན་ཀྱི་སྐྱེ་མཆེད་དུ་བར་འགྲོ་བའི་ཡིད་དང་ཚོད་ཀྱི་སྐྱེ་མཆེད་དག་གིས་བསྡུས་སོ།",
    "དཞིཉིན་མོ་སྣང་བ་དང་མཚན་མོ་མུན་པ་དག་ཡིན་ལ།",
    "རང་གི་གཞུང་ལུགས་ནི་རྣམ་འོ་ན་ཅི་ཞེ་ན་སྒོ་དང་སྐར་ཁུང་དང་ཁ་རངན་པ་སོགས་པའི་བུ་ག་ནམམཁའི་ཁམས་ཞེས་བྱལརིག་པར་བྱའམ་ཞེ་ན།",
    "གང་དག་ཁམས་བདེ་བརྒྱད་བསྟན་པ་དེ་དག་ལས་བསྟན་དུ་ཡོད་པ་དག་ལས་ཁམས་བཞི་ནི་རེག་བྱའི་ཁམས་ཀྱི་ནང་དུ་འདུསསོ།",
    "མས་ནི་དུ་ཐོགས་པ་མེད་པ་རྣམས་ནི་དུ་ཞེ་ན་རང་གི་ཡུལ་དུ་གཞན་སྐྱེ།",
    "སྲིད་པའི་རྩེ་མོའི་བར་གྱི་དང་།",
    "ཕྱི་རོལ་གྱི་ནི་གཟུགས་དང་དྲི་དང་རོ་པོ་ལྷདང་རེག་བྱའི་ཁམས་བཞི་པོ་ཡིན་ལདང་རེག་བྱའི་ཁམས་བཞི་པོ་ཡིན་ལ།",
    "དེ་བཞིན་ལག་པའི་པོ་དེ་དག་ཉིད་སྲེག་པར་བྱེད་པ་ཡང་ཡིན་ལ་གཞལ་བར་བྱ་བའང་གཞནཁ་ཅིག་ན་རེ་ཁམས་པའི་པོ་དེ་དག་ཉིད་སྲེག་པར་བྱེད་པ་ཡང་ཡིན་ལ་གཞལ་བར་བྱ་བའང་ཡིན་ནོ་ཞེས་བརྗོད་དོ།",
    "ཁ་ཅིག་ན་རེ་མོའི་ཁམས་ཁོ་ན་སྲེག་པར་བྱེད་པ་ཡིན་ལ།",
    "དེ་དངའཚུངས་པ་ཞེས་བྱ་བ་འདི་ཅི་ཞིག་ཅེ་ན་མིག་ལསོགས་པ་གང་ཞིག་རང་གི་ལས་ལ་བཀགས་པ་མི་བྱེད་པའོ།",
    "མིག་གིས་མ་ཡིན་ཏེ་གཟུགས་བཞིན་ནོ།",
    "འདོད་པའི་ཁམས་དང་བསམ་གཏན་དང་པོར་སྐྱེ་བ་ལྟ་བུས་རང་གིས་པ་ཡང་ཡིན་ནོ།",
    "ཡང་ཁམས་བཅོ་བརྒྱད་ལས་གང་ཞིག་གང་གིས་རྣམ་པར་ཤེས་བར་བྱ་བ་ཡིན་ཞེ་ན།",
    "བྱེ་བྲག་འདི་ནི་མོའི་ཞེས་ང་ལྟ་བུ་དང་།",
    "རིམ་པ་བཞིན་སྲོག་དང་ཚོར་བ་རྣམས་དང་ནི།",
    "ད་པ་ལ་སོགས་པ་རྣམས་ནི་སེམས་ལས་བྱུང་བ་དག་གི་ནང་ནས་འཆད་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་འདོད་ཆགས་དང་བྲལ་བ་ཞིག་གིས་འཐོབ་ན་ནི་དེ་དགུས་འཐོབ་སྟེ།",
    "ཉོན་མོངས་ཅན་དང་ལྡན་སྟེ།",
    "ཐུགས་དང་དྲི་དང་རོ་དང་རེག་བྱ་རྣམས་སོ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བརྣམས་ཀྱི་བྱེ་བྲག་ནིཁྲུ་བས་དེ་ནི་རེ་ཞིག་རྒྱུན་རྣམས་ལ་ཡང་ཡོངས་སུ་བཅད་པར་དགའ་ན་སྐད་ཅིག་མ་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "ལོག་པར་མོས་པ་དང་།",
    "ལོག་པར་མོས་པ་རྣམས་ནི་ས་མང་བོ་ཡིན་པའི་ཕྱིག།",
    "དྲན་པ་ཉོན་མོངས་པ་ཅན་ཁོན་བརྗེད་ངས་པ་ཡིན་ལ།",
    "ཏིང་འཛིན་ཉོན་མོངས་པ་ཅན་ཁོ་ནརྣམ་པར་གཡེང་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུལ་སོགས་པ་ཡིནནོ།",
