    "གཙང་དམེ་འཛིན་པའི་ཀུན་རྟོག་མ་གྲུབ་ཀྱང་།",
    "མ་ལུས་བསྐང་ཞིང་བཤགས་པའི་ཐབས་ཀྱི་མཆོག།",
    "བྱིན་བརླབས་མཆོག་སྩོལ་དམ་གཙང་བྱམས་གསུམ་བསང་།",
    "མི་གཙང་ཕུད་ཉམས་ལྷག་མར་གྱུར་ལ་སོགས།",
    "མ་འཁོར་སྤྲུལ་པར་བཅས་པ་འདིར་གཤེགས་ཤིག།",
    "མ་ཚོགས་ཐུགས་དམ་བསྐང་ངོ་དགྱེས་པར་རོལ།",
    "མ་དག་སྡིག་ལྟུང་ཉེས་བྱས་ཚོགས་མཐའ་དག།",
    "མ་ཐོགས་ལས་བཞི་ལྷུན་གྱིས་གྲུབ་པར་མཛོད།",
    "བདེ་སྟོང་ལྷུན་གྲུབ་ཀུན་ཁྱབ་འདུས་མ་བྱས།",
    "གར་བཞུགས་གནས་ནས་སྐད་གཅིག་མྱུར་དུ་བྱོན།",
    "འཁོར་འདས་རོ་མཉམ་གཙང་རྨེའི་རྟོག་ཚོགས་བྲལ།",
    "ནམ་ཡང་མི་གཏོང་རྟག་ཏུ་བསྒྲུབ་ལགས་ན།",
    "འབད་རྩོལ་མེད་པར་མྱུར་དུ་འགྲུབ་པར་མཛོད།",
    "རྟག་ཏུ་བདེ་བའི་དཔལ་ལ་སྤྱོད་པར་མཛོད།",
    "ལས་བཞིའི་ཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པར་མཛོད།",
    "ཅེས་ཀ་ཐོག་རྡོ་རྗེ་གདན་ཀྱི་བསྟན་སྲུང་ཡོངས་རྫོགས་ཀྱི་མཆོད་གསོལ་འཆི་མེད་ལྷ་ཡི་རྔ་སྒྲ་ཞེས་བྱ་བ་འདི་ཉིད་དཔལ་ཀ་ཐོག་པའི་བཀའ་འབངས་རིག་པ་འཛིན་པ་དགེ་རྩེ་འགྱུར་མེད་བསྟན་པའི་རྣམ་རྒྱལ་དཔལ་བཟང་པོས་རང་ལོ་ཉེར་དྲུག་པར་གདན་ས་ཆེན་པོ་དེ་ཉིད་དུ་བསྟན་སྲུང་དགྱེས་པའི་མཚན་མ་དང་བཅས་གང་ཤར་སྐད་ཅིག་མར་བྲིས་པ་སརྦ་ཛ་ཡནྟུ།",
    "ས་མ་ཡཱ། ཁྲོ་འབར་གྱི་གསོལ་བསྡུས་བཞུགས།",
    "འདིར་གཤེགས་བརྒྱན་པའི་མཆོད་གཏོར་བཞེས།",
    "ཞེས་པའང་དགེ་རྩེ་འགྱུར་མེད་བསྟན་པ་རྣམ་རྒྱལ་པས་རང་ལོ་ཉེར་ལྔ་པར་རོ། ། ཀློང་གསལ་རྣམ་སྲས་གསོལ་བསྡུས་བཞུགས།",
    "འདིར་གཤེགས་འདོད་ཡོན་ལྔ་ཡི་མཆོད་གཏོར་བཞེས།",
    "རྣལ་འབྱོར་བསམ་དོན་ཡིད་བཞིན་འགྲུབ་པར་མཛོད།",
    "ས་པཱ་རི་ཝ་ར་ཨི་དཾ་བ་ལིངྐ་ཁཱ་ཧི། ཀློང་གསལ་སྟག་མདའ་གསོལ་བསྡུས་བཞུགས།",
    "འདོད་ཡོན་མཆོད་སྤྲིན་བཞེས་མཛོད་ལ།",
    "བཞི་པ་བཞུགས་གསོལ་ནི།",
    "བཀའ་སྡོད་དམ་ཅན་རྒྱ་མཚོ་བཞུགས་སུ་གསོལ།",
    "དམ་བཅས་ཁས་བླངས་དམ་ཚིག་དྲན་པར་མཛོད།",
    "ཀུན་མཁྱེན་དམ་གཙང་བྱམས་གསུམ།",
    "དམ་ཚིག་གཅེས་པར་འཛིན་པའི་རིག་འཛིན་གྱིས།",
    "ཤག་རུ་རག་རུཾ་ནཱ་གེ་ཙིཏྟ་ཏྲཾ་མ་མ་ཡོ་ཟ་གྲྀ་ཧ་ཧེ་ཀེ་ཤ་ལ་ཛ་ཛ",
    "མཉེས་པ་ཆེན་པོས་དགྱེས་པར་མཛོད་ལ།",
    "སྔར་བྱས་ལེགས་པའི་ལས་ཀྱི་གཏང་རག་དང་།",
    "འབུལ་ན་དགྱེས་པ་ཆེན་པོས་བཞེས་ནས་ཀྱང་།",
    "ལས་བཞིའི་ཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པར་མཛོད།",
    "ཅ་ཅོ་སྙན་པའི་རྔ་ཟླུམ་སྒྲོགས་ལགས་ན།",
    "ལ་འུར་ཕྱག་རྒྱ་གར་ཙམ་མ་ཡིན་པར།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྲིན་ལས་མཛོད",
    "ལོག་པར་ལྟ་བའི་དགྲ་བགེགས་མེད་པར་མཛོད",
    "ཚུལ་བཞིན་བསྒྲུབ་པར་བྱེད་པའི་གང་ཟག་ལ།",
    "མ་ཡི་བུ་ལྟར་སྐྱོང་བ་ཞལ་བཞེས་པའི།",
    "གསུམ་པ་བཤགས་པ་ནི།",
    "ཅེས་དང་ཡི་གེ་བརྒྱ་པས་བཤགས།",
    "འདིར་ནི་རྟེན་དང་སོགས་ཀྱིས་བརྟན་བཞུགས།",
    "ཕུན་ཚོགས་འདོད་དགུའི་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "ཅེས་དང་གཞན་ཡང་བཀྲ་ཤིས་བསྔོ་སྨོན་གྱི་མཐའ་བརྒྱན་པར་བྱའོ།",
    "གཡོག་འཁོར་དང་བཅས་འདིར་གཤེགས་དགྱེས་པར་བཞུགས།",
    "གཉིས་མེད་རང་གྲོལ་ངང་ནས་འབུལ་ལགས་ན།",
    "ལས་བཞིའི་ཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པར་མཛོད།",
    "འཁོན་སྦྱོང་ཉམས་པ་བཤགས་སོ་འཁྲུགས་པ་བསྡུམ།",
    "གཞི་བྱས་ཀུན་ཏུ་སྲུངས་སྐྱོབ་བྱ་ར་མཛོད། ། ཁྲོ་བཙན་རྡོ་རྗེ་གཡུ་རྒྱལ་གྱི་གསོལ་མཆོད་བཞུགས།",
    "མ་ཐོགས་མྱུར་དུ་འདིར་བྱོན་གདན་ལ་བཞུགས།",
    "བཅོལ་བའི་ཕྲིན་ལས་ཐོགས་མེད་འགྲུབ་པར་མཛོད།",
    "བསམ་དོན་ལྷུན་གྲུབ་ཕྲིན་ལས་རྒྱས་པར་མཛོད།",
    "ཅེས་པའང་དགེ་རྩེ་པས་སོ། ། ཡུལ་ལྷ་མཆོད་ཐབས་ཕན་བདེ་ཀུན་ནས་རྒྱས་པའི་ཆུ་གཏེར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྔགས་ཀྱིས་ཕམ་རྒྱལ་མེད་པར་བྱས།",
    "ཕྲིན་ལས་ཐོགས་པ་མེད་པར་མཛོད།",
    "འབྱུང་པོ་ས་སྲིན་ཀླུ་སྲིན་གདུག་ཅིང་གཏུམ་པའི་སེམས་དང་ལྡན་པ་ཐམས་ཅད་ལ་ཕམ་རྒྱལ་མེད་པར་འབུལ་ལོ།",
    "ཁྱད་པར་དུ་ཡུལ་ཕྱོགས་འདི་ཉིད་ཀྱི་གཞི་བདག་ཡུལ་བདག་རི་བདག་གནས་བདག་ཟོ་དོར་གཉུག་མར་གནས་པ་ཅི་མཆིས་པ་ཐམས་ཅད་ལ་གསོལ་ལོ།",
    "དགྱེས་པ་ཆེན་པོས་ཚིམ་པར་གྱིས་ལ།",
    "ཁྱད་པར་དུ་རྣལ་འབྱོར་པ་བདག་ཅག་དཔོན་སློབ་འཁོར་དང་བཅས་པ།",
    "མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "གདོན་དང་བགེགས་རྣམས་མེད་པར་མཛོད།",
    "བྱ་བྱེད་ངན་པ་མེད་པར་མཛོད།",
    "ཕྲིན་ལས་བཅོལ་བས་འདོད་དོན་འགྲུབ་པར་ཐེ་ཚོམ་མེད་དོ།",
    "ཞེས་པས་རང་གནས་སུ་གཤེགས་པར་བསམ་ཞིང་།",
    "བསྔོ་སྨོན་གྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "དགེའོ། ། ལོ་ཏོག་ལ་ཕན་པའི་མན་ངག་ཉེར་མཁོ་ཆར་འབེབས་བདུད་རྩིའི་བུམ་ཆུང་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ཀར་བུར་སྦྲང་དང་སྦྱར་ནས་གཙང་མར་ནམ་མཁའ་མི་མཐོང་བར་ཞིབ་བཏུལ་བགྱིས་པ།",
    "གླ་རྩི་དང་ཤ་ཁྲག་གུ་གུལ་སོགས་ཀླུའི་མི་འདོད་པའི་རྫས་ཀྱི་གཏན་ནས་མ་གོས་པར་བྱས་ནས།",
    "ཞབས་སྐྱིལ་ཀྲུང་དུ་བཞུགས་ཤིང་།",
    "ཤ་ཆང་སྒོག་གསུམ་སོགས་མི་གཙང་བའི་བཟའ་བཏུང་ལ་འཛེམ།",
