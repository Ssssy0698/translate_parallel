    "གནས་གཅིག་ན་འདུག་ཅིང་ཉན་པའོ།",
    "འོང་བ་དང་འགྲོ་བ་དང་གནས་པ་མེད་ཅེས་བྱ་བ་ནི་སྐྱེ་བ་དང་འགག་པ་དང་འདུག་པ་མེད་པ་སྟེ།",
    "ཚུལ་བཞིན་དེ་ངོ་བོ་ཉིད་ཀྱིས་དག་པས་ནམས་ཀྱང་རང་བཞིན་གཞན་དུ་མི་འགྱུར་བ་ལ་བྱའོ།",
    "ཕུང་པོའི་མཚན་ཉིད་དང་རང་བཞིན་གང་ཡིན་པ་རྟོགས་པའོ།",
    "ཕུང་པོ་ལྔ་ཡང་རང་བཞིན་མེད་པས་མ་འོངས་པའི་དུས་ཀྱི་ཚེ་དང་མཚམས་སྦྱོར་བ་མེད་པའོ།",
    "སྐྱེ་བ་ཐམས་ཅད་སྐྱེ་བ་མེད་ཅིང་མི་སྐྱེ་བའི་མཚན་ཉིད་ཀྱི་འགོག་པ་གང་ཡིན་པ་དེ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་མེད་པར་ཤེས་པ་ནི་མི་སྐྱེ་བའི་མཚན་ཉིད་མི་འགོག་པ་ཞེས་བྱའོ།",
    "ཕྱིས་ཀྱང་བདག་ཉིད་འདུག་གོ་སྙམ་དུ་སེམས་པ་ནི་རྟག་པར་འདུ་ཤེས་པའོ།",
    "ལུས་ལྷོད་པར་གྱུར་པ་ན་ལྡང་བ་དང་འདུག་པ་ལ་ལུས་ལྕི་བའོ།",
    "འདུག་པ་ཐོབ་པ་ནི་ཡུལ་ལ་དམིགས་པའི་ཚེ་སེམས་རྩེ་གཅིག་པ་ལ་གནས་པ་ཐོབ་པ་སྟེ།",
    "རྒྱུ་དང་རང་བཞིན་བསྟན་པའི་ཕྱིར།",
    "གང་ཐག་ཉེ་བ་ན་འདུག་པའི་གཟུགས་ཐམས་ཅད་དོ།",
    "ཞི་གནས་ལ་རབ་ཏུ་གནས་པས་གཙེ་བ་མེད་ཅེས་བྱ་བ་ནི་ཏིང་ངེ་འཛིན་སེམས་རྩེ་གཅིག་པའི་མཚན་ཉིད་ལ་ལེགས་པར་འདུག་པས་ཏིང་ངེ་འཛིན་དང་མི་མཐུན་པའི་ཕྱོགས་ཕྱིན་ཅི་ལོག་ཏུ་རྟོག་ཅིང་དཔྱོད་པ་ལ་སོགས་པའི་སྐྱོན་མེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ཉིད་དུ་འདུག་གོ་ཞེས་བྱ་བ་ཡན་ཆད་ཀྱིས་ཐམས་ཅད་གཟུགས་སུ་འཛུད་པ་བསྟན་ཏོ།",
    "ཡང་ན་དང་པོར་རྒྱུ་དང་རྐྱེན་བར་དུ་མི་འདུག་པར་ཤེས་པ་ནི་སྐད་ཅིག་མའི་རང་བཞིན་ནམ་དངོས་པོ་མེད་པའི་ཕྱིར་མཐའ་གཉིས་ཀྱི་བར་ན་ཡང་མི་གནས་པར་ཤེས་པའོ།",
    "ཕུང་པོ་རྣམས་ལ་སྒྱུ་མར་ཤེས་པ་ནི་ཇི་ལྟར་སྒྱུ་མ་རྒྱུ་རྐྱེན་གྱིས་སྐྱེད་པས་སྣང་ཡང་རང་བཞིན་མེད་པ་བཞིན་དུ།",
    "དངོས་པོ་མེད་པ་ནི་ད་ལྟར་གྱི་དུས་ན་ཡང་རང་བཞིན་མེད་པའོ།",
    "འདོད་ཆགས་སྤྱོད་པ་རྣམས་ཀྱི་ཚུལ་དང་རང་བཞིན་ནམ་རྣམ་པར་དབྱེ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལེན་པ་གསུམ་ཆར་ཡང་རང་བཞིན་མེད་པར་ཤེས་པ་ནི་དོན་ཏོ།",
    "མི་གནས་པ་ནི་ཅུང་ཟད་ཀྱང་འདུག་པའི་མཐུ་མེད་པ་སྟེ་དེ་བས་ན་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ནང་ན་ཡང་མི་འདུག་ཕྱི་རོལ་ན་ཡང་མི་འཕྲོས།",
    "ཇི་ལྟར་རྨི་ལམ་ན་དངོས་པོ་རྣམ་པ་སྣ་ཚོགས་སྣང་བ་ཡང་རང་བཞིན་སྟོང་པ་དེ་བཞིན་དུ།",
    "སེམས་ལ་གཟུང་བ་དང་འཛིན་པ་ལ་སོགས་པ་རྣམ་པ་དུ་མར་སྣང་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "གཟོད་མ་ནས་ཡོངས་སུ་མ་གྲུབ་ཅེས་བྱ་བ་ནི་ཇི་ལྟར་མིག་ཡོར་ཕྱིས་བརྟགས་ཏེ་རང་བཞིན་མེད་པ་ལྟར་དང་པོ་སྣང་བའི་དུས་ན་ཡང་རང་བཞིན་མེད་པ་ཡིན་ནོ།",
    "སྐྱུ་རུ་རའི་འབྲུ་འདུག་པ་བཞིན་དུ་མཐོང་ཞེས་བྱ་བ་ཡན་ཆད་ཀྱིས་བསྟན་ཏོ།",
    "འདོད་པའི་ཁམས་བདུད་ཀྱི་སྤྱོད་ཡུལ་ན་འདུག་ཀྱང་འདོད་པ་དང་།",
    "རྟག་ཏུ་འདུག་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "འདུག་པ་སུ་ཡིན།",
    "སེམས་ཀྱི་རྒྱུད་ལ་ས་བོན་བརྟས་པ་དེ་ཡང་ཡུན་ཇི་སྲིད་ཅིག་ཏུ་འདུག་ཅེ་ན།",
    "ཇི་ལྟར་ཐོག་མར་ནུར་ནུར་པོར་འདུག་གོ།",
    "བཙས་ཕྱིན་ཆད་འདུག་པ་ནི་རབ་ཏུ་བྱུང་བ་ཡིན་ནོ།",
    "འདུག་པ་ན་ལུས་མདུན་དུ་གུག་པའི་ཕྱིར་རོ།",
    "འབྱོར་པ་དང་ལྡན་པ་ཡིད་བདེ་བ་མང་བ་ཁོ་ན་དག་དུས་བྱེད་པ་དམིགས་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་ལངས་ཏེ་འགྲོ་བ་དང་འདུག་སྟེ་ཟ་བ་ལྟ་བུའོ།",
    "ཉེ་བ་ཡིན་པའི་ཕྱིར་དང་ཞེས་བྱ་བ་ནི་མཆོག་ཡིན་པའི་ཕྱིར་དང་གཙོ་བོ་ཡིན་པའི་ཕྱིར་གཞན་དག་པས་སྤྱན་སྔ་ན་འདུག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྟག་ཏུ་འདུག་པ་ཡིན་པའི་ཕྱིར་དང་ཞེས་བྱ་བ་ནི་སྐྱེས་པ་དང་རབ་ཏུ་བྱུང་བ་སྐལ་བ་མཉམ་པ་ཡིན་པའི་ཕྱིར་དེ་དག་རྟག་ཏུ་རྗེས་སུ་འབྲང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཇི་སྲིད་དུ་རྒྱུན་གྱིས་རྒྱུ་གནས་པར་འདུག་པ་དེ་སྲིད་དུ་རྒྱུན་ཁོ་ནས་འབྲས་བུ་གནས་པ་ཡིན་ནོ།",
    "ནང་ལ་ཚུལ་བཞིན་མ་ཡིན་པར་ཇི་ལྟ་བུ་ཞིག་ཏུ་འདུག་པ་གང་ཡིན།",
    "དེ་སེམས་དེ་བསྟན་ཅིང་བསྒོམས་ལན་མང་དུ་བྱས་པས་དམན་པར་འདུག་འདུག་པ་ལས་གོང་དུ་འཕོའོ།",
    "དེའི་སེམས་བསྟེན་ཅིང་བསྒོམས་ལན་མང་དུ་བྱས་པ་དམན་པར་འདུག་ཅིང་དམན་པར་ཤིན་ཏུ་འདུག་པ་ལས་གོང་དུ་ཤིན་ཏུ་འཕོའོ།",
    "སྟན་ལ་འདུག་པ་དང་།",
    "ཁྲིའུའི་སྟེང་ན་མི་འདུག་པ་ལ་ཁྲིའུ་རུ་ཉེ་པར་བཏགས་ནས་འདི་སྐད་དུ་ཁྲིའུ་སྨྲའོ་ཞེས་བྱ་བ་དང་།",
    "འདུས་པ་ཞེས་བྱ་བ་ནི་གསུམ་པོ་རྣམས་རྒྱུ་དང་འབྲས་བུར་འདུག་པ་ཙམ་ཡིན་ནོ།",
    "འདུག་པ་ན་ལུས་མདུན་དུ་གུག་པའི་ཕྱིར་རོ།",
    "མ་རིག་པས་ནི་བདེན་པ་མཐོང་བའི་ཡུལ་བཀག་སྟེ་འདུག་པ་ཡིན་ཏེ།",
    "མཉམ་དུ་འདུག་པར་ཡང་འགྱུར་རོ།",
    "སྔོན་གྱི་མཐར་ཡང་མ་ཡིན་དབུས་སུ་ཡང་སྲེད་པ་དང་ལེན་པ་གཉིས་ནི་མ་རིག་པ་དང་ལྷན་ཅིག་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སྲེད་པ་དང་ལེན་པའི་ཡན་ལག་ནི་སྲེད་པར་བྱེད་པའི་ལས་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྲེད་པའི་རྐྱེན་གྱིས་བྱུང་བའི་ལེན་པས་རྣམ་པར་ཤེས་པའི་རྒྱུན་ལ་བག་ཆགས་སུ་འདུག་པའི་ལས་རྣམས་སྲིད་པར་གྱུར་པར་བྱེད་དོ།",
