    "རང་རང་སྔགས་ཀྱིས་ཅི་རིགས་པར།",
    "ལྷན་ཅིག་འདུག་ཀྱང་ཅིས་མ་ཚུགས།",
    "བདག་ནི་གང་ཡིན་འགྲོ་བ་ཁྱེད་རྣམས་དེ་ཡིན་ཏེ།",
    "ལས་དང་རང་བཞིན་གྱིས་ལྟ་བ་ཕུན་སུམ་ཚོགས་པར་ཡོངས་སུ་བསྟན་པ་ཡིན་ཏེ།",
    "འདི་ལ་རིག་པ་ཅི་ཡོང་ཙ་ན",
    "དེ་ཡང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་བཅསཾ་པ་ཡིན་ཏེ།",
    "༡༤༦ སི་དང་ཉན་ཐོས་དང་རང་སངསརྒྱས་ཀྱིས་ལས་འཨ་བར་འདོད་པ་དང་།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "བ་དང་ད་ལྟའི་གནམ་ལོ་ཟླ་ཞག་དུས་གང་ཤར་དང་འཐབ།",
    "ཕལ་ཆེན་ཀློག་ཅིང་དུར་གྱི་འདུག་ས་སྤོ།",
    "ཁདེ་མིན་གཞན་རྣམས་ཆེས་མཆན་རྙིང་ཞིག་ཡིན་འདུག་པས་རྩོམ་པ་པོ་རང་ཉིད་ཡིན་ནམ་སྙམ།",
    "གཅིག་སྲོག་ཐ་ཆུང་བཞིའི་བྱི་ཕག་ལ་སྟག་ཡོས་གཉིས་ཀྱིས་འཛིན་པ་ཁོ་རང་ལ་གང་ཉེར་དྲི།",
    "ཡུལ་མི་སྡུག་ཀྱང་རང་ལ་གོད་ཁ་མེད།",
    "རང་ཐོག་བྱེ་བྲལ་རང་ལ་ངན་ཟེར་ཡང་ས་ནང་ཆུ་ནང་རང་ཐོག་འབྲིང་དུ་འདོད་པའོ་།",
    "ས་རྡོ་ཤིང་བུ་གང་རུང་རང་མཐོ་ཐེག་ཚད་ཟེར་བའང་འདུག་གང་།",
