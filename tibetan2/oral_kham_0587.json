    "དེ་ཡང་རང་གྱི་ས་པ་཈ྱིད་ཡྱིན་གྱི་ཟག་མེད་དང་།",
    "རང་རང་གྱི་ལས་ཀྱིས་མཚམས་བཅད་པའྱི་ཕྱྱིར་དང་།",
    "བར་མཚམས་ཐམས་ཅད་མུན་པར་འདུག།",
    "རྱིའྱི་རྒྱལ་པོ་རྱི་རབ་ནྱི་དཔག་ཚད་བརྒྱད་ཁྱི་ནྱི་འོག་ཏུ་གསེར་གྱི་ས་གཞྱི་ལ་ཐུག་པར་འདུག་གོ།",
    "ལོར་བགོད་ལ་཈ྱི་མ་ལྡོག་དུས་སུ་གྱིང་ལས་དཔག་ཚད་དྲུག་དང་གཅྱིག་གྱི་བཅོ་བརྒྱད་ཆ་གཅྱིག་གྱིས་གྱིང་ལས་཈ྱི་མ་ཕྱྱིར་རྒྱ་མཚོའྱི་སེང་དུ་ཡོལ་ནས་འོད་ཟེར་ཕལ་ཆེར་རྒྱ་མཚོར་ཕོག་པས་རྒྱ་མཚོ་དང་རྒྱ་མཚོ་ལས་འབབ་པའྱི་ཆུ་རྣམས་དོ་ཞྱིང་ཆུ་ལ་སེས་པའྱི་ཤྱིང་སོགས་སེའོ།",
    "དེ་ནས་རྱིམ་གྱིས་སྣང་བ་དང་རངས་པ་སྣང་བ་དང་མར་གྱི་ངོ་མཆྱིམས་ཆེ་བ་འཇམ་པའྱི་དབྱངས། ༣༣༣",
    "ལ་མྱིན་ན་ཡང་རང་བཞྱིན་གྱིས་ལ་ཡྱི།",
    "གང་ཕམ་ཡང་རང་རང་གྱི་གོང་དུ་གོས་ནས་སོ་བཅད་པས་ཐུབ་ཀང་སྐྲག་པ་འབྱུང་ངོ་དེའྱི་ཚེ་ལ་མ་ཡྱིན་རྣམས་རྒྱལ་ན་གོང་ཁེར་བལྟ་ན་སྡུག་གྱི་ནང་དུ་འདེད་པར་བྱེད་དོ།་",
    "རང་རང་གྱི་གནས་ནས་གནས་འོག་མའྱི་གནས་ཀྱི་བར་ཐག་ཇྱི་སྱིད་པ་དེ་རང་གྱི་གནས་དེ་ནས་དེའྱི་གོང་མའྱི་གནས་སུའང་དེ་སྱིད་དེ།",
    "ཁྲུ་ནྱི་ཐམས་ཅད་དུ་འོག་ནས་འཆད་པའྱི་ཕྲ་རབ་རྡུལ་ལ་སོགས་པ་བསགས་པའྱི་ཚད་དང་ལྡན་པ་ཡྱིན་གྱི་རང་རང་གྱི་ཁྲུ་ནྱི་མ་ཡྱིན་ནོ།",
    "དེ་དག་ཀང་རང་གྱི་ཁྲུ་ཚད་ཕྱེད་དང་བཞྱི་པ་སེ་ལུས་ཤྱིན་ཏུ་ཆེ་བའོ།",
    "འཆགས་པ་དང་འཇྱིག་པ་དང་ཞྱིག་ནས་འདུག་པ་སོངས་པའྱི་བསྐལ་པ་དག་ནྱི་གནས་པ་དང་དུས་མ་཈མ་ཁོ་ན་སེ་ཐམས་ཅད་ལ་བར་བསྐལ་཈ྱི་ཤུ་཈ྱི་ཤུ་ཡོད་དོ།",
    "བདུན་པས་ནྱི་ཐམས་ཅད་མེ་ལེ་གཅྱིག་ཏུ་འབར་ཏེ་མེ་དེ་ཡང་རང་ཞྱི་བར་འགྱུར་རོ།",
    "ལན་ཅྱིག་ཏུ་འདུག་པ་དང་།",
    "བསན་བཅོས་ལས་ལུས་དང་ལྡན་ལ་ལུས་ཀྱི་ལས་དང་མྱི་ལྡན་པ་ནྱི་སོ་ངའྱི་ནང་ན་འདུག་པའྱི་མེར་མེར་པོ་ལ་སོགས་པའོ།",
    "ཤན་པ་ལ་སོགས་པའང་རང་གྱི་ཕ་མ་ལ་སོགས་པ་གསོད་པར་མྱི་འདོད་པའྱི་ཕྱྱིར་དང་།",
    "རང་རང་གྱི་ཡན་ལག་ཐམས་ཅད་དང་།",
    "དེ་བཤགས་ནས་དགེ་སློང་ཐམས་ཅད་ལས་གཞོན་རབས་སུ་འདུག་པ་སོགས་ཆད་པའྱི་ལས་ཀྱི་བསླབ་པ་རྣམས་བྱྱིན་པས་སོར་ཆུད་པ་སེ་དགེ་སློང་དགའ་བ་ཅན་བཞྱིན་ནོ།",
    "དེ་དག་གཞན་བྱེད་དུ་བཅུག་པས་ཀང་རང་཈ྱིད་ལའང་ལས་ཀྱི་ལམ་དུ་འགྱུར་བའྱི་ཕྱྱིར་དང་།",
    "བོར་བས་དེ་ཚེ་འདུག་པ་ནྱི།",
    "དེ་དག་ཀང་རང་གྱི་ཆུང་མ་ཡྱིན་ཡང་འདོད་ལོག་ཏུ་འགྱུར་ན་གཞན་ལ་ལྟ་ཅྱི་སྨྲོས་པའྱི་ཕྱྱིར་རོ།",
    "དེ་དག་དང་རང་སོབས་དང་གཞན་སོབས་ཀྱིས་཈མས་པ་ནྱི་ས་མ་ཁོ་ནའྱི་རྣམ་གངས་ཡྱིན་པའྱི་ཕྱྱིར་རོ།",
    "དེ་དག་ཀང་རང་རྒྱུད་ལ་སྨྱིན་པ་རྣམ་སྨྱིན་དང་།",
    "གང་ཟག་གྱི་སོ་ནས་གཞན་ལ་བསན་པར་སྐྲ་ཞྱིང་རང་གྱིས་ཐ་སད་གདགས་སླ་བའྱི་ཕྱྱིར་རོ།",
    "དཔེར་ན་མ་ཁྱིའུའྱི་འོག་ན་འདུག་པ་བསད་པ་དང་།",
    "དེ་དག་ནྱི་རང་རང་གྱི་ཕུན་སུམ་ཚོགས་པའྱི་ཕ་རོལ་ཏུ་ཕྱྱིན་པས་ན་ཕ་རོལ་ཏུ་ཕྱྱིན་པ་ཞེས་བྱའོ།",
    "མཁས་པས་གུས་དང་རང་ལག་ནས།",
    "གང་རང་གྱི་དངོས་པོ་བདག་཈ྱིད་ཀྱིས་སྦྱྱིན་པ་དེ་ནྱི་གཏོང་བ་པོའང་ཡྱིན་ལ་སྦྱྱིན་བདག་ཀང་ཡྱིན་ནོ་ཞེས་སྦྱྱིན་བདག་དང་གཏོང་བ་པོ་ལ་མུ་བཞྱིར་འགྱུར་བར་གསུངས་སོ།",
    "ཤྱིང་དྲུང་ན་འདུག་ཀང་རུང་སེ།",
    "དེ་ཡང་རང་གྱི་ཕུང་པོ་ལ་བདག་ཏུ་ལྟ་བ་དང་དེ་རྟག་ཆད་དུ་ལྟ་བ་ནྱི་འཇྱིག་ཚོགས་ལ་ལྟ་བ་དང་མཐར་འཛིན་པར་ལྟ་བ་ཡྱིན་པ་ན་འོག་མ་དང་གོང་མ་དག་རྒྱུད་དང་ཕུང་པོ་ཐ་དད་པའྱི་ཕྱྱིར་རོ།",
    "འགོག་པ་ལ་དམྱིགས་པའྱི་ལོག་ལྟ་ལ་སོགས་པ་ནྱི་རང་རང་གྱི་ས་པའྱི་ག་཈ེན་པོ་འགོག་པ་ཁོ་ན་ལ་དམྱིགས་པ་ཡྱིན་ཏེ།",
    "ཀུན་འགོ་མ་ཡྱིན་པ་རྣམས་ནྱི་རང་རང་གྱི་རྱིས་སུ་གཏོགས་པ་ལ་རྒྱས་པར་འགྱུར་གྱི་རྱིས་གཞན་ལ་ནྱི་མ་ཡྱིན་ནོ།",
    "ཕྲ་རྒྱས་ལ་ཀུན་འགོ་དང་ཀུན་འགོ་མ་ཡྱིན་པ་ག་཈ྱིས་ལས་དང་པོ་ལའང་རང་གྱི་ཁམས་དང་ས་སྐལ་བ་མ་཈མ་པ་དང་མྱི་མ་཈མ་པ་ག་཈ྱིས་སོ།",
    "དེ་ལ་ཀུན་འགོ་རྣམས་ནྱི་ཡུལ་སང་བྱ་རྱིས་ལྔ་ཆར་ལ་དམྱིགས་པ་ཡྱིན་ལ་ཀུན་འགོ་མ་ཡྱིན་པ་ནྱི་རང་རང་གྱི་རྱིས་ཁོ་ན་ལ་དམྱིགས་སོ།",
    "ཁམས་འོག་མ་ག་཈ྱིས་ཀྱི་ཀུན་འགོ་བཅོ་བརྒྱད་དེ་཈ྱི་ཤུ་ར་བཞྱི་ནྱི་དམྱིགས་ཡུལ་ཟག་བཅས་ཟག་མེད་དང་རང་ས་དང་གོང་ས་ལ་ལྟོས་ནས་ཅྱི་རྱིགས་དམྱིགས་པ་དང་མཚུངས་ལྡན་གྱིས་རྒྱས་འགྱུར་ག་཈ྱིས་ཀ་ཅྱི་རྱིགས་པ་དང་།",
    "བྱེ་བག་ཏུ་སྨྲ་བ་རྣམས་ནྱི་དུས་དེ་དག་འདུས་བྱས་ཀྱི་མཚན་཈ྱིད་སེ་སོགས་བཞྱི་དང་ལྡན་པའྱི་ཕྱྱིར་རྟག་པར་ནྱི་མྱི་འདོད་ཀྱི་འདས་པ་ལ་སོགས་པའྱི་དུས་རྣམས་རང་རང་གྱི་དུས་ཀུན་ཏུ་རས་སུ་ཡོད་པར་ནྱི་གསལ་བར་དམ་འཆའོ།",
    "གང་དག་དུས་གསུམ་རས་སུ་ཡོད་པར་འདོད་པའྱི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དེ་དག་ཀང་དབྱེ་ན་རྣམ་པ་བཞྱི་ཡྱིན་ཏེ།",
    "དེ་ཡང་དྲུག་དགུ་བཅུ་གཅྱིག་ཡུལ་ལོ་དེ་ལ་རང་རང་གྱིས་གགས་པ་ཞེས་བྱ་བའང་འགོག་ལམ་མཐོང་སང་ཟག་བཅས་ལ་དམྱིགས་པ་འདོད་ཆགས་ལ་སོགས་པ་དང་མཚུངས་ལྡན་གྱི་ཡྱིན་གྱི།",
    "དེ་ཡང་རང་རྒྱུད་ཀྱི་བདེ་སྡུག་ལ་ནྱི་དམྱིགས་པ་དང་མཚུངས་ལྡན་ག་཈ྱིས་ཀས་རྒྱས་ལ་གཞན་རྒྱུད་ཀྱི་ལ་ནྱི་དམྱིགས་པའྱི་སོ་ནས་སོ།",
    "རང་བཞྱིན་དུ་མྱི་འདུག་པ་཈ྱིད་དང་།",
    "ལག་མཐྱིལ་སྤུ་཈ག་གཅྱིག་འདུག་པ།",
    "ས་མ་དག་ནྱི་རང་རང་གྱི་ག་཈ེན་པོར་རོ།",
    "དེ་ལ་བགང་བ་ནྱི་འདུ་བྱ་བ་མེད་པར་ལུས་སེམས་རྣལ་དུ་འདུག་སེ་དབུགས་རྔུབ་པ་དང་འགྱུར་བ་དག་ལ་སེམས་གཏད་ནས་གཅྱིག་ནས་བཅུའྱི་བར་དུ་ཡྱིད་ཀྱིས་བགང་བའོ།",
    "ཡང་ན་ནང་གྱི་ལུས་ལ་སོགས་པ་ནྱི་རྱིམ་པ་ལྟར་རང་གྱི་ནང་གྱི་སེ་མཆེད་གཟུགས་ཅན་དང་རང་གྱི་ཕྱྱིའྱི་སེ་མཆེད་གཟུགས་ཅན་དང་།",
    "གཞན་རྒྱུད་ཀྱི་ནང་གྱི་སེ་མཆེད་གཟུགས་ཅན་དང་རང་གྱི་ནང་གྱི་སེ་མཆེད་གཟུགས་ཅན་གྱི་ཚོགས་པ་ན་ཡོད་པའྱི་ཕྱྱིའྱི་སེ་མཆེད་རྣམས་ཡྱིན་ལ།",
    "དེ་ལ་དང་པོ་གསུམ་ནྱི་རང་རང་གྱི་དམྱིགས་པ་ལུས་ལ་སོགས་པ་སོ་སོ་ལ་དམྱིགས་པས་མ་འདེས་པ་ལ་དམྱིགས་པ་ཡྱིན་ལ།",
    "འཕགས་པ་ནྱི་སློབ་པ་ཅུང་ཟད་གཏོང་ཡང་ཐམས་ཅད་གཏོང་བ་མྱི་སྱིད་དེ་འཕགས་པ་མ་཈མ་པར་མ་བཞག་ཀང་སློབ་པའྱི་བསམ་པ་མྱི་འདོར་བའྱི་སོ་ནས་དེར་བརོད་དེ་མགོན་པོ་ལམ་ན་འདུག་པ་བཞྱིན་ནོ་ཡང་སློབ་པ་གསུམ་གྱི་ཐོབ་པ་དང་ཡང་ལྡན་པའྱི་ཕྱྱིར་རོ།",
    "བར་པ་བཞྱི་ནྱི་རང་རང་གྱི་རྱིགས་ལས་཈མས་པར་འགྱུར་གྱི་དང་པོ་ནྱི་རང་གྱི་རྱིགས་ལས་཈མས་པ་མ་ཡྱིན་ཏེ།",
    "དེ་ཡང་རང་སོབས་ཀྱིས་མྱི་ཤེས་པ་ལ་བསམས་གྱི།",
    "རང་རང་བདེན་པ་བཞྱི་ཤེས་དང་།",
    "བདེན་པ་བཞྱི་ཤེས་པ་ནྱི་རང་རང་གྱི་བདེན་པའྱི་རྣམ་པ་ཅན་དུ་འཇུག་པས་རྣམ་པ་བཞྱི་བཞྱི་པ་ཡྱིན་ནོ།",
    "མཐོང་བའྱི་ལམ་ལ་ནྱི་བཟོད་པ་བརྒྱད་དང་ཤེས་པ་བདུན་པོ་ཇྱི་ལྟར་སེས་པ་རྣམས་རང་རང་གྱི་རྱིགས་འད་བ་མ་འོངས་པ་འཐོབ་པར་འགྱུར་ཏེ།",
    "རང་རང་གྱི་རྱིགས་ཀྱི་སྐལ་མ་཈མ་གྱི་རྒྱུ་རྒྱས་པའྱི་ཕྱྱིར་རོ།",
    "གང་དག་གཟུགས་མེད་ནས་ཤྱི་འཕོས་པ་མ་ཡྱིན་པ་དེ་དག་ནྱི་སླ་བའྱི་ཕྱྱིར་དང་རང་གྱི་རྒྱུད་ལ་བརྟེན་ནས་སེད་པར་བྱེད་དོ།",
    "བསམ་གཏན་དང་པོའི་འབས་བུ་སྤྲུལ་སེམས་ནྱི་འདོད་པ་དང་བསམ་གཏན་དང་པོའི་ས་པའྱི་ག་཈ྱིས་ཡྱིན་པ་ནས་བསམ་གཏན་ག་཈ྱིས་པའྱི་འབས་བུ་ས་འོག་མ་པ་ག་཈ྱིས་དང་རང་གྱི་ས་པ་སེ་གསུམ་དང་།",
    "གསུམ་པའྱི་ས་འོག་མ་པ་གསུམ་དང་རང་གྱི་ས་པ་སེ་བཞྱི་དང་།",
    "བཞྱི་པའྱི་ས་འོག་མ་པ་བཞྱི་དང་རང་གྱི་ས་པ་དང་ལྔ་ཡྱིན་པའྱི་བར་དུ་རྱིམ་པ་བཞྱིན་དུ་ཤེས་པར་བྱའོ།",
    "དེས་ན་སྤྲུལ་སེམས་ཁོ་ན་ལས་འདོད་པའྱི་སེམས་ལྟ་བུས་ལྡང་བ་ནྱི་མྱི་སྱིད་དེ་བྱ་འཕུར་བ་དང་འབབ་པ་ངེས་པར་འདབ་མ་ལ་བརྟེན་པ་བཞྱིན་ནོ་སྤྲུལ་པ་ཐམས་ཅད་ཀང་རང་རང་གྱི་ས་པའྱི་སྤྲུལ་པའྱི་སེམས་ཀྱིས་རང་སའྱི་སྤྲུལ་པ་སྤྲུལ་པར་བྱེད་ཀྱི་ས་གཞན་པའྱི་སྤྲུལ་སེམས་ཀྱིས་ནྱི་ས་གཞན་གྱི་སྤྲུལ་པ་སྤྲུལ་པ་མྱི་བྱེད་དོ་ཞེས་སྱིར་བཏང་ནས་དམྱིགས་བསལ་བསམ་གཏན་ག་཈ྱིས་པ་ཡན་ཆད་པ་དག་གྱི་སྤྲུལ་པ་ངག་སྨྲར་འཇུག་པ་ནྱི་རང་ས་ནས་རྟོག་དཔྱོད་མེད་ཅྱིང་ངག་སྨྲ་བ་ཀུན་སློང་རྟོག་དཔྱོད་ལ་ངེས་པར་ལྟོས་པས་ས་འོག་མ་བསམ་གཏན་དང་པོའི་ས་པའྱི་སྨྲ་སེམས་ཁོ་ནས་སྨྲར་འཇུག་ལ།",
    "དེ་བཞྱིན་དུ་ཚེ་དང་ལྡན་པ་ཤཱ་རྱིའྱི་བུ་དཔེར་ན་འདམ་བུའྱི་ཤོག་ག་཈ྱིས་གནམ་དུ་བསྒྲེང་སེ་ཕན་ཚུན་བརྟེན་ཅྱིང་འདུག་པ་དེ་ལ་འགའ་ཞྱིག་གྱིས་གཅྱིག་བོར་ན་ཅྱིག་ཤོས་འགེལ་བར་འགྱུར་ལ།",
    "ཡང་ན་དེ་དག་དམན་ཡང་རང་ས་ན་མེད་པའྱི་ཕྱྱིར་ལྟ་བ་ལ་སོགས་པ་ལ་དགོས་པ་ཡོད་པས་མངོན་དུ་བྱེད་དོ་ཞེས་ཤེས་པར་བྱའོ།",
    "སེད་པ་དང་བཅས་པ་རོ་མྱང་བ་དང་མཚུངས་པར་ལྡན་པའྱི་སོམས་འཇུག་རྣམས་ནྱི་རང་རང་གྱི་ས་པའྱི་སྱིད་པ་ཟག་བཅས་ཀྱི་ཕུང་པོའི་དངོས་པོ་ཁོ་ན་ལ་དམྱིགས་པ་ཡྱིན་གྱི།",
    "ས་གང་གྱི་སེད་པ་གང་ཡྱིན་པ་དེ་ནྱི་ས་དེ་ཁོ་ན་ལ་རྒྱས་པར་འགྱུར་བས་གོང་འོག་རང་རང་གྱི་སེད་པས་ཡོངས་སུ་བཅད་པའྱི་ཕྱྱིར་ས་གོང་མ་ལའང་དམྱིགས་པ་མ་ཡྱིན་ནོ།",
    "དེ་཈ྱིད་ཀྱི་ཕྱྱིར་གནས་གཞན་གསུམ་གསུམ་པ་རྣམས་དང་བརྒྱད་པོ་དག་ལྟག་འོག་ཏུ་འདུག་ཀང་ས་གཅྱིག་པ་཈ྱིད་དུ་འགྲུབ་བོ་ཞེས་རྒྱལ་པོའི་སས་འཆད་དོ།",
    "འོ་ན་ལུང་མེད་པས་བསམ་གཏན་གཟུགས་མེད་དག་ཁམས་གོང་མ་ག་཈ྱིས་སུ་རང་རང་གྱི་གོང་མ་གོང་མ་ཇྱི་ལྟར་སེ་ཞེ་ན།",
