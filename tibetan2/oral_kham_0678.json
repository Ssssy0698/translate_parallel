    "ང་རང་ཕན་ཚུན་དུ་བསྐྱོད་སྐབས་རྒྱ་མི་ཐེངས་ཁ་ཤས་ཐུག་འཕྲད་བྱུང་བ་དང་།",
    "ཡང་རྒྱས་སྤྲོས་ཆེན་པོ་བྱས་ན་ཡག་པོ་མི་འདུག་ལྷ་ཁང་དང་།",
    "ཁག་ནི་ཁག་མི་འདུག་རྫུན་དང་།",
    "དེ་རྣམས་ངོས་ནས་ཤོད་དགོས་དོན་མི་འདུག་ཀྱང་།",
    "ད་ནི་བཀའ་དྲིན་གང་ཡང་དགོས་པ་མི་འདུགཕ་",
    "ཕན་ཚུན་ཁ་གཏད་གདོང་གཏུགས་བྱས་ཏེ་བསྡད་པ་ཡིན་ཚེ་ཉེན་ཁ་ག་དུས་ཡིན་ཀྱང་ཡོད།",
    "མས་རང་བཙན་ཤོད་ཀྱི་འདུག་ཅེས་བརྗོད་བྱུང་།",
    "དེ་གལ་འགངས་ཆེ་ལ་ཛ་དྲག་ཆེན་པོ་འདུག་རིམ་པས་བོད་ནང་བོད་པ་གྲངས་ཉུང་དང་།",
    "སློབ་ཕྲུག་འཚར་ལོངས་ཡོང་མཁན་དེ་རིགས་ཀྱང་ཧ་ལས་པའི་སེམས་ཤུགས་ཆེན་པོ་འདུག་ཁ་སང་བོད་ནས་ཚུར་བྲོས་བྱོལ་དུ་ཡོང་བ་རང་ལོ་བཅུ་ཡིན་ཟེར་མཁན་ཕྲུ་གུ་ཞིག་དྷ་རམ་ས་ལར་ཐུག་བྱུང་།",
    "དེ་འདྲའི་མཐོང་ཚུལ་བྱུང་ཡོད་འདུག་འདི་སྐོར་གནས་ཚུལ་ཤེས་པ་བྱེད་དགོས།",
    "གལ་ཆེ་ས་ཞིག་ལ་ཐུག་དུས་བོད་སྤྱི་བསམ་པ་ཞིག་ཚང་མར་ཡོད།",
    "འཛམ་གླིང་ཐོག་དུས་རབས་བཅུ་དགུ་པའི་ནང་དང་།",
    "ངའི་སར་ཡོང་སྟེ་མིག་ཆུ་བཏང་ནས་ང་རང་རྒྱ་མི་ཡིན།",
    "སེམས་ཤུགས་ཡོད་མཁན་མང་པོ་འདུག་ཡིན་ནའང་བྱེད་སྟངས་འདི་མུར་ཕྱིན་ན་སོ་སོར་གྱོང་རག་རྒྱུའི་ཉེན་ཁ་ཡོད།",
    "དེ་ཁྱེད་རང་ཚང་མའི་སེམས་ལ་ངེས་པ་བྱས།",
    "བོད་ནས་ཡོང་མཁན་ནང་བརྒྱ་ཆ་དགུ་བཅུ་གོ་དགུ་བརྒལ་བ་དངོས་གནས་ཡག་པོ་འདུག་སེམས་ཤུགས་དང་ལྷག་བསམ་ཆེན་པོ་འདུག་ཅེས་ངོས་ནས་རྟག་ཏུ་བརྗོད་ཀྱི་ཡོད།",
    "དམག་མི་ཡོངས་རྫོགས་བསམ་བློ་གཅིག་སྒྲིལ་ཡོད་བཟོ་མི་འདུག་དཔེར་ན།",
    "ཁོ་པོ་ཚོ་འུ་ཐུག་དུས་ཧམ་རྫུན་མཚམས་ཚོད་མེད་པ་ཤོད་ཀྱི་ཡོད།",
    "དེ་ནི་དཔེ་མི་སྲིད་པའི་ཧམ་པ་དང་།",
    "ལོ་ཉི་ཤུའི་རྗེས་བོད་ཡར་རྒྱས་ཕྱིན་པའི་མཚམས་ལ་བོད་པས་རྒྱ་མིར་ཚུར་རོགས་རམ་བྱེད་དགོས་ཞེས་དེ་འདྲ་ཤོད་ཀྱི་འདུག་དེ་ནས་ཉིན་ཞིག་ཅོག་ཙེ་རིང་པོ་ཞིག་སྒྲིག་པའི་ཕར་ཕྱོགས་སུ་མའོ་ཙེ་ཏུང་དང་།",
    "ཁམས་པས་རྙོག་དྲ་ཤོད་ཀྱི་འདུག་ཟེར་མཁན་ཡོད།",
    "བསམ་བློར་སྐྱོན་འདུག་ཅེས་ནག་ཁྲ་འཛུགས་ཀྱི་ཡོད།",
    "དེ་རྗེས་བསམ་འཆར་ཤོད་ཀྱི་ཡིན་ཞེས་ཟེར་དགོས་གྲབས་ཆགས་ཀྱི་འདུག་ཅེས་བརྗོད་བྱུང་།",
    "བསམ་བློར་ལོག་སྤྱོད་པའི་ཀླད་སྐྱོན་འདུག་ཅེས་ལམ་སེང་ནག་ཉེས་ཕོག་རྒྱུའི་ཉེན་ཁ་ཡོད།",
    "དེ་ནི་ལྷོད་ཡངས་ཀྱིས་ནོར་འཁྲུག་བྱུང་འདུག་དགོངས་དག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "བར་ལམ་པེ་ཅིང་ལ་ཡོད་པའི་བོད་པ་ཞིག་ཐུག་དུས་བརྗོད་པར།",
    "བོད་པས་རྒྱུས་མངའ་ལམ་སྟོན་བྱས་པར་རྒྱ་མིའི་ངོས་ནས་ཀྱང་རང་ཤེད་མ་བྱས་པར་ཉན་ཤེས་གོ་ཤེས་བྱས།",
    "བོད་མི་རྣམས་ཀྱི་སེམས་ནང་རང་ཉིད་རྒྱ་མི་ཡིན་བསམ་པ་རྩ་བ་ནས་མེད།",
    "བར་ལམ་ལས་བྱེད་རྒས་ཡོལ་ལ་བཏང་བ་གང་འཚམ་ཡོད་པ་དེ་དག་ཁ་ཤས་ཀྱིས་བློ་གཡེང་བྱེད་ཀྱི་ཡོད་བཟོ་འདུག་བློ་གཡེང་རྩ་བ་ནས་བྱེད་མི་དགོས།",
    "ཁྱེད་རང་གསར་པ་འབྱོར་བ་ཚོས་ཀྱང་གཟབ་གཟབ་བྱེད་དགོས།",
    "ཁྱེད་རང་བོད་ནང་སྡོད་མཁན་ཚོས་ཕྱི་ལ་གང་འདྲ་ཡོད་མེད་ཤེས་མ་ཐུབ་པ་དང་།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བསམ་བློ་གཏོང་སྐབས་མི་གོ་གང་ལ་གང་འཚམ་ཆོད་ཡོད་བསམས་ནས་སྤྲོ་བ་འཕེལ་གྱི་འདུག་གཙོ་ཆེ་ཤོས་བོད་ནང་རྒྱ་མིས་བཙན་འཛུལ་བྱས་པ་ནས་བཟུང་དུས་ད་ལྟ་བར་དུ་དངོས་གནས་གཏོར་བཤིག་དང་།",
    "ཁ་ཤས་ཀྱིས་ས་ཡ་ཉི་ཤུ་སླེབས་པ་བརྗོད་ཀྱི་འདུག་གང་ལྟར་ཡུལ་མི་ས་ཡ་གསུམ་ཡོད་སར་རྒྱ་མི་ས་ཡ་བཅོ་ལྔ་ལས་བརྒལ་བ་ཞིག་སླེབས་ཡོད།",
    "ཉུང་ཉུང་ཡིན་པས་གནས་སྐབས་སྐྱེ་སྒོ་མ་བཀག་པར་བཞག་ན་འོས་པོ་འདུག་ཀྱང་།",
    "ད་ལྟ་ཉུང་ཤས་ཡོད་པ་དེ་རིགས་ཀྱིས་བར་ལམ་བྲིས་པའི་རྩོམ་དེབ་འདྲ་མིན་མང་པོ་ཐོན་པ་དེ་དག་ལ་ལྟ་དུས་དངོས་གནས་བསམ་བློ་མང་པོ་བཏང་སྟེ་ཧུར་ཐག་བྱས་འདུག་མངོན་གསལ་དོད་པོའི་སྐད་ཆ་ཤོད་ས་མེད་ཀྱང་།",
    "དེ་ལྟར་བྱས་ཏེ་ཉམས་མྱོང་རིམ་པས་གསོག་ཐུབ་པ་ཞིག་བྱུང་ན་ཡག་པོ་འདུག་གང་ལྟར་དངོས་ཡོད་གནས་ཚུལ་ལ་ང་རང་ལོ་དྲུག་ཅུར་ཉེ་ཞིང་།",
    "ཉེན་ཁ་མི་འདུག་གམ།",
    "ད་དུང་དེ་ལ་ས་ཕག་རྩིག་ཟེར་བའི་མིང་གསར་པ་ཞིག་ཀྱང་བཏགས་འདུག་མ་ཅང་བརྒྱབ་སྟེ་བསྡད་ན་ཡག་པོ་མེད།",
    "ཕར་ཕྱོགས་རྒྱ་མི་ལའང་ངོ་ཚ་བ་མི་འདུག་གམ།",
    "དཔེར་ན་ང་རང་ལ་ཆ་བཞག་ན།",
    "ཕྱོགས་གཉིས་ནས་ཞེད་སྣང་ལྟ་བུ་བྱེད་ཀྱི་འདུག་ཛ་",
