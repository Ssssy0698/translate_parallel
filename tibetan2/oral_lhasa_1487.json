    "རྒྱས་པའི་སྦྱིན་སྲེག་ལ་བརྩོན་པར་བྱ་སྟེ།",
    "ཞེས་ཀྱང་ཨ་བྷ་ཡ་གསུང་ངོ། དོན་དམ་པར་ནི།",
    "བདེ་བ་དང་སྟོང་པ་ཉིད་ཀྱི་ཡེ་ཤེས་འཕེལ་བར་འགྱུར་བ་ངེས་པའི་དོན་གྱི་སྦྱིན་སྲེག་ལ་བརྩོན་པར་བྱའོ།",
    "ཤ་ཟ་ལ་སོགས་པ་ཡང་གཅོད་པར་འགྱུར་རོ།",
    "ལས་ཐམས་ཅད་པའི་གཏོར་མའི་རིམ་༧ པའི་ཆོ་གས་ཤེས་རབ་མཐར་བྱེད་ཀྱི་སྔགས་བྲིས་པའི་སྲུང་བའི་འཁོར་ལོ་གསུངས་པས་བཅིང་བར་བྱའོ།",
    "དེའི་ཚེ་བསྒྲུབ་བྱ་ཡིསོས་པར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཚེ་དཔག་ཏུ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ཉིད་བསྟན་ཏེ།",
    "ཞེས་པ་ནི་ཞི་བའི་ཕྲིན་ཅི་ལས་འགྲུབ་པར་བྱེད་པའོ།",
    "ཡང་ན་རྟ་མགྲིན་དང་ལྡན་པའི་རྣལ་འབྱོར་པས་བསྒྲུབ་བྱའི་མགོ་བོ་ལ་སོགས་པར་ཀུ་རུ་ཀུལླེའི་སྔགས་བཀོད་ལ་དེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་ཚོགས་ཀྱིས་ནང་ནས་དུག་བཀུག་ཅིང་འོག་ཏུ་སོན་པར་བསྒོམས་ཏེ།",
    "དེ་གཙོ་བོ་ཡིན་པས་དོན་ཡོད་གྲུབ་པ་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ་། དོན་ཡོད་དམ་ཚིག་ཅེས་བྱ་བ་ལ་སོགས་པས་དོན་ཡོད་གྲུབ་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ཉིད་དུ་བསྟན་ཏོ།",
    "བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་དབྱེ་བས་སྔགས་ནི་རྣམ་པ་གཉིས་ཏེ།་",
    "དེ་ལ་རྗོད་པར་བྱེད་པ་ཙམ་གྱིས་སྔགས་ནི་དངོས་གྲུབ་སྟེར་བར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རང་བཞིན་རྟོགས་པར་མི་འགྱུར་བས་ཁ་སྐད་བཞིན་ནོ།",
    "སྔགས་ཀྱི་བརྗོད་པར་བྱ་བ་ཡོངས་སུ་ཤེས་ན་དེ་ཡིས་ལྷའི་དེ་ཁོ་ན་ཉིད་རྟོགས་པས་སྔགས་རྣམས་དངོས་གྲུབ་སྟེར་བར་འགྱུར་རོ།",
    "སྒྱེད་པུས་ནི་དུར་ཁྲོད་ལ་སོགས་པའི་རྟེན་བྱས་ནས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཆར་འབེབས་པའི་ཆོ་ག་མཛད་པ་སྟོབས་པོ་ཆེའི་ཏིང་ངེ་འཛིན་དང་སྙོམས་པར་ཞུགས་པ་བསྟན་ཏོ།",
    "དེ་ཞི་བར་བྱས་ནས་ཆར་གྱི་རྒྱུན་ནི་ཆར་གྱི་ཚོགས་སོ།",
    "འབེབས་པ་ནི་འབབ་པར་འགྱུར་བའོ་། འདིར་རིམ་པ་འདི་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཆར་འབེབས་པའི་ཆོ་ག་བསྟན་ཏེ།",
    "ཁ་སྦྱར་བྱས་ཏེ་ཞེས་པ་ནི་འཁྲུལ་འཁོར་གཉིས་སྦྱར་ནས་སོ།",
    "དེ་ལྟར་བྱས་ན་ཀླུ་ནི་འཇོག་པོ་ལ་སོགས་པའོ།",
    "ཆར་འབེབས་པར་འགྱུར་རོ་ཞེས་པ་ནི་ཆར་ཆེན་པོ་འབབ་པར་འགྱུར་རོ།",
    "ཀུན་དུ་ངེས་པར་སྒྲོགས་པའོ་ཞེས་པ་ནི་ནམ་མཁའ་མ་ལུས་ཁྱབ་པའོ།",
    "རྡོ་རྗེའི་སྒྲ་ནི་མི་ཕྱེད་པའི་ཧ་ཧ་དགོད་པ་གང་ལ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ་ཞེས་བྱ་བ་འདིས་ནི་འདོད་པའི་རྒྱལ་པོའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ཉིད་བསྟན་ཏོ།",
    "དེ་འཆིང་བར་བྱེད་པས་ན་འགུགས་པར་བྱེད་པ་སྟེ་བཅིངས་པའི་དོན་བསྟན་ཏོ།",
    "སྔགས་ཀྱི་བདག་ཉིད་ཅན་ཞེས་པ་ནི་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པ་དབྱེར་མེད་པས་ཁྲོ་བོ་ནི་སྔགས་ཀྱི་བདག་ཉིད་ཅེས་བྱའོ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོ་རྗེས་སུ་དྲན་པར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "རྒྱལ་པོ་ལ་སོགས་པའི་བསྒྲུབ་བྱ་རྣམ་པར་ཤེས་པ་བཀུག་ལ་དེར་བཅུག་སྟེ་རྡོ་རྗེ་འཆང་།",
    "བགེགས་རྣམས་ལོང་བར་བྱེད་པའོ་ཞེས་པ་ནི་འཇིགས་པ་ཆེན་པོས་མིག་ལོང་བ་སྐྱེད་པར་བྱེད་པས་སོ།",
    "དེའི་ཚེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ནུས་པ་འགུགས་པར་འགྱུར་རོ།",
    "མདུན་དུ་ཕྱིན་པ་བསམ་པར་བྱའོ་ཞེས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་དགུག་པར་བྱའོ་ཞེས་བསྟན་ཏོ།",
    "ལན་གྲངས་ལྔ་བཅུ་བརྗོད་ནས་ཞེས་པ་ནི་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཀྱིས་རྣམ་པ་གཉིས་སུ་བྱས་ནས་བརྒྱར་འགྱུར་རོ།",
    "དེའི་ཚེ་འགུགས་པར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "རྣམ་པ་གཉིས་ཀྱིས་བཟླས་པ་བྱས་ནས་དགུག་པར་བྱའོ་། འདིར་སྔགས་ཀྱི་སྐུ་དང་།",
    "དེ་སྤོང་བས་གང་སྒྲུབ་པར་བྱེད་པ་དེ་འཇིག་པ་ནི་དངོས་གྲུབ་ཐོབ་པར་མི་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "ལྔ་པོ་རྣམས་ཀྱི་རྟེན་དུ་གྱུར་པའི་ཕྱིར་ཞེས་པ་ནི་དེ་རྣམས་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གནས་སྐབས་ཐམས་ཅད་དུ་དམིགས་པར་བྱའོ་ཞེས་པ་ནི་སྤྱོད་ལམ་བཞི་ལ་དེ་ཉིད་༧བསྟེན་པར་བྱ་བའི་རིགས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་དོན་ཡོད་གྲུབ་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ཉིད་དུ་བསྟན་ཏོ།",
    "གནས་སྐབས་ཀྱི་ཁྱད་པར་ལ་ཞེས་པ་ནི་སེམས་རྩེ་གཅིག་པ་ཉིད་ལ་བཞུགས་ནས་སོ།",
    "འཆད་པར་འགྱུར་བ་ཞེས་བྱ་བ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་དོན་ཡོད་གྲུབ་པའི་རང་བཞིན་གྱི་རལ་བ་གཅིག་མའི་སྔགས་བསྟན་ཏོ།",
    "སྔགས་ཀྱི་བདག་ཉིད་ཅན་ཞེས་པ་ནི་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་དབྱེར་མེད་པས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་འོད་དཔག་ཏུ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ེཉིད་དུ་བསྟན་ཏོ།",
    "རྐུན་མ་ལ་སོགས་པས་བྱས་པ་ཞེས་པ་ནི་གླང་པོ་ལ་སོགས་པས་བྱས་པའི་འཇིགས་པ་བརྒྱད་དམ་བཅུའོ།",
    "འཇིགས་པར་མཛད་པ་ནི་རྨོངས་པར་མཛད་པའོ།",
    "འདོད་ཆགས་རྣམ་པར་དག་པ་ནི་བཅོམ་ལྡན་འདས་འོད་དཔག་ཏུ་མེད་པའི་རང་བཞིན་ཡིན་པས་སོ།",
    "སྔགས་ཀྱི་མཐུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཁོ་ན་ཉིད་ལ་འཇུག་པས་འབད་རྩོལ་མེད་པས་སྔགས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གསད་པར་བྱ་བ་ཞེས་པ་ནི་ངེས་པར་གཟུང་བ་དང་བཅས་པའི་ཚིག་སྟེ་གསད་པར་བྱ་བ་ཁོ་ནའོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པས་ལས་འདི་བྱེད་པས་ན་ཟུང་དུ་འཇུག་པའི་ཏིང་ངེ་འཛིན་གྱི་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་རྣལ་འབྱོར་པས་ཐོབ་པར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "ཕ་རོལ་འཚེ་བས་ཇི་ལྟར་འགྲུབ་པར་འགྱུར་རོ་ཞེས་རྟོག་པར་མི་བྱ་སྟེ།",
    "གསད་པར་བྱ་བ་དེ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་འཚེ་བར་བྱེད་པ་རྣམས་ཀྱིའོ།",
    "སྔ་མ་བཞིན་དུ་གཟུགས་བརྙན་མནན་ཞིང་གདུག་པ་རྣམས་གསད་པར་བྱའོ་ཞེས་བསྟན་ཏོ།",
    "གཟུགས་ཅན་མ་ཡིན་པའི་ནམ་མཁའ་ཡང་ཞེས་པ་ནི་གལ་ཏེ་གདུག་པ་ཡིན་ན་དེའི་ཚེ་དེ་ཡང་གསོད་པར་འགྱུར་རོ།",
    "གཟུགས་ཅན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་པ་ནི་དེ་ཉིད་ཕུལ་དུ་བྱུང་བ་སྟེ་ཁྱད་པར་དང་ལྡན་པའི་ཚིག་གོ།",
    "བསམ་གཏན་གྱི་ཆེ་བ་ཉིད་ནི་ཏིང་ངེ་འཛིན་གྱི་མཐུ་གསལ་བར་བྱས་སོ།",
    "དུར་ཁྲོད་ནི་ཐམས་ཅད་སྡུད་པར་བྱེད་པས་ན་མཐུན་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནས་རྣམ་པར་འཇིག་པར་འགྱུར་རོ་ཞེས་པའི་བར་དུ་ནི།",
    "གདུག་པའི་དངོས་པོར་གྱུར་ཅིང་བདག་ཉིད་ངན་པར་སོན་པའོ།",
    "དགག་པར་བྱ་བ་ཞེས་པ་ནི་གསོད་པར་བྱ་བ་ཉིད་ཐོབ་པའོ།",
    "དེ་རྣམས་ཀྱི་ནི་བསྒྲུབ་བྱ་རྣམས་ཀྱིའོ་། ལུས་ལ་སོགས་པ་མི་གཡོ་བར་བྱས་པ་ཞེས་པ་ནི་ལུས་དང་ངག་དང་སེམས་ཕུར་བུས་འདེབས་པར་བྱེད་པའོ།",
    "དེ་སྐད་ཅེས་བྱ་བ་ལ་སོགས་པས་མཆོག་དང་འབྲིང་དང་ཐ་མའི་བསྒྲུབ་བྱའི་ལུས་ལ་སོགས་པ་ཕུར་བུས་གདབ་པར་བྱེད་པའི་ཏིང་ངེ་འཛིན་བསྟན་ཏོ།",
    "རྡོ་རྗེ་དང་པདྨའི་ནང་ནས་ཕྱི་རོལ་དུ་བྱུང་བའི་ཉི་མའི་དཀྱིལ་འཁོར་ལ་གནས་ནས་བཀའ་ཉན་པར་བསམས་ཏེ།",
    "དེའི་འོག་ཏུ་དབུས་ཀྱི་གཙོ་བོའི་ངོ་བོའི་བདག་ཉིད་ཀྱིས་གནོད་མཛེས་ལ་སྔགས་འདིས་བཀའ་སྦྱིན་པར་བྱ་སྟེ།",
    "ཅེས་བྱ་བ་འདིས་ཕྱོགས་བཅུ་ལ་གནས་པའི་བརྒྱ་བྱིན་ལ་སོགས་པ་དགུག་པར་བྱ་བའི་ཕྱིར་བཀའ་སྦྱིན་པར་བྱའོ།",
    "ཤར་ལ་སོགས་པའི་ཕྱོགས་སུ་འགོད་པར་བྱེད་པར་བསམ་པར་བྱའོ།",
    "དེ་ནས་གནོད་མཛེས་ཀྱི་རྒྱལ་པོས་རྡོ་རྗེ་ཕུར་བུ་དེ་རྣམས་མགོ་བོ་ནས་བརྩམས་ཏེ་རྐང་པའི་དཀྱིལ་གྱི་བར་དུ་གདབ་པར་བྱེད་པར་བསམ་པར་བྱའོ།",
    "ཨོཾ་གྷ་གྷ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་ཀྱིས་ཕུར་བུས་གདབ་པ་དང་བརྡུང་བ་བྱས་ཏེ།",
    "ས་འོག་བདུན་གྱི་བར་དུ་སོན་པར་བསམ་པར་བྱའོ།",
    "རྡོ་རྗེ་དང་པདྨ་མཉམ་པར་སྦྱོར་བ་དང་ཞེས་བྱ་བ་ནས་བརྩམས་ནས་ལྡང་བར་འགྱུར་རོ་ཞེས་པའི་བར་དུ་ནི་ཞེ་སྡང་རྡོ་རྗེའི་རྣལ་འབྱོར་པས་མཱ་མ་ཀཱིའི་རང་བཞིན་གྱི་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་མདུན་དུ་བསྒོམས་ལ་རྗེས་སུ་ཆགས་པ་ལ་སོགས་པ་སྔོན་དུ་འགྲོ་བས་འཁྱུད་པར་བྱས་ཏེ།",
    "འརྡོ་རྗེ་དང་པདྨ་ིསྙོམས་པར་ཞུགས་པར་བྱས་ཏེ།",
    "རྩེ་ལྔ་པའི་རྡོ་རྗེའི་རྣམ་པའི་གསང་བའི་རྡོ་རྗེས་མགོ་བོ་ནས་རྐང་པའི་མཐའི་བར་དུ་ཕུར་བུས་གདབ་པར་བསྒོམས་ནས་དེའི་ཚེ་ལུས་ཕུར་བུས་གདབ་པར་གནས་ནས་སྤོ་བའམ་འཆི་བར་འགྱུར་རོ།",
    "འདིར་རྡོ་རྗེ་དང་པདྨ་སྙོམས་པར་ཞུགས་པའི་དུས་སུ་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཨོ་ཚིནྡྷ་ཚིནྡྷ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྔགས་གསུམ་བརྗོད་པར་བྱའོ།",
    "། ཕ་མ་དྲན་པའི་ཞལ་གདམས་བཞུགས།",
    "རིན་ཆེན་རྡོ་རྗེ་བཅས་ཀྱིས་འདེམ་སྒྲིག་བྱས།",
    "རིན་ཆེན་རྡོ་རྗེ་བཅས་ཀྱིས་འདེམ་སྒྲིག་བྱས།",
    "རིགས་ལམ་རྣམ་པར་ཕྱེད་པའི་རྣམ་དཔྱོད་དང་།",
    "གཞུང་ལུགས་གདམས་པར་ཤར་བའི་ཉམས་ལེན་དང་།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "གངས་ཅན་བོད་ཀྱི་མཁས་པ་སྔ་མ་རྣམས་ཀྱིས་རྩིས་ཆེན་མཛད་པར་མ་ཟད།",
    "སྒྲ་དོན་རྒྱན་གྱི་ཡལ་འདབ་རྣམ་པར་བཀྲ།",
    "ཁྱད་པར་དུ་བཟོ་རིག་གམ།",
    "བལྟ་བར་བྱ་བ་དང་མཉན་པར་བྱ་བ་གཉིས་ཡོད་པར་གསུངས།",
    "གྲངས་ཉུང་མི་རིགས་ཀྱི་སྐད་དང་ཡི་གེའི་པར་སྐྲུན་ཆེད་དངུལ་རོགས་སྐྱོར་ལས་གཞི་བཅས་རྒྱལ་ཁབ་རིམ་པའི་ལས་གཞི་གཉིས་ཀྱི་གྲས་སུ་ཚུད་པར་གྱུར་པས།",
    "མཛེས་དཔྱོད་ལྟ་ཚུལ་སོགས་ཀྱི་སྟེང་ནས་ཀྱང་ཁྱད་པར་ཕྱེ་དགོས་པར་འདོད།",
    "དེ་རྣམས་ནི་སྲོལ་རྒྱུན་གྱི་རྩོམ་སྲོལ་རྒྱུན་འཛིན་བྱས་ཡོད་པར་མ་ཟད།",
    "འགའ་ཞིག་ནི་དམིགས་བསལ་གྱི་རྩོམ་ལུས་སྣ་ཚོགས་ལ་དམིགས་ནས་ཅི་ནུས་ཀྱིས་ཆ་ཚང་བར་བྱས་ཡོད།",
    "སྤྱིར་ཤིང་པར་དང་བྲིས་མ་མང་པོ་ཞིག་ལག་སོན་བྱུང་ཡང་དཔར་མི་གསལ་བ་དང་།",
    "དེ་དུས་གླེགས་བམ་འདི་དག་ཏུ་མ་ཚུད་པའི་ངག་རིག་གྲགས་ཅན་རྣམས་བདམས་ཆོག་པར་འདོད་དོ།",
    "འའདིས་ཀྱང་ཀུན་ལ་ཕན་ཐོགས་པར་སྨོན་པ་དང་བཅས་འདིར་སྨྲས་པ།",
    "ཅེས་སྤྱི་ལོ་ལོའི་ཟླ་པར་སྒྲིག་པ་པོས་ཕུལ་བའོ།",
    "དཀར་ཆགཀུན་མཁྱེན་འཇིགས་མེད་གླིང་པ།",
