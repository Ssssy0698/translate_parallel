    "རང་རང་དཔུང་གྲལ་ངོས་འཛིན་གྱིས་སྔར་བཞིན་རུ་ཁ་སྤྲོད་ཡོད་ཐོག་ནས་མཚོན་གུར་བཀྲོལ་ཞིང་།",
    "སྐབས་གོང་རིམ་ནས་རུ་སྟེང་བཀའ་སྒྱུར་སོགས་ཡོད་ཚེ་ཉན་ཆེད་ཡིན་ཚོད་འདུག་ཀྱང་།",
    "ཐོག་མར་༡༩༥༩ ལོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་ཆིབས་ཞབས་སུ་སྐུ་སྲུང་འགོ་དམག་མི་གྲངས་༡༢༦ ཡོད་པ་ནས་ད་ལྟ་འདས་གསོན་གཉིས་བརྩིས་མི་གྲངས་༩༧ གྱི་མིང་དྲན་པས་ཟིན་གྱི་འདུག་ཅིང་།",
    "དམག་བསྟན་སྲུང་དྭང་དམག་ཡུལ་དམག་བསྡོམས་པས་དམག་གྲངས་༢༥ ཙམ་ཧ་གོ་དོན་གསལ་ཐོག་ཚེ་སྲོག་ཤོར་འདུག་བོད་དམག་དང་།",
    "སླར་ཡང་དཔའ་སྟོབས་སེམས་ཤུགས་བསྐྱེད་གཞིའི་སྣོན་མར་གྱུར་ཏེ་རང་དམག་ཁག་གཅིག་སྒོ་སྲུང་དུ་བཞག་ནས་ཡང་སྟེང་དུ་བསྐྱོད་སྐབས་བོད་དམག་ཁག་གཅིག་དེར་སླེབས་འབྱོར་ཟིན་འདུག་པ་རྣམས་དང་དཔུང་གཤིབས་རྒྱ་དམག་རུ་བསྒྲིགས་ཏེ་ཡོང་བཞིན་པའི་ཐོག་མདེའུ་གྲངས་༨༤ བརྒྱབ་པར་རྒྱ་དམག་ཇི་ཙམ་གསོད་ཐུབ་ཡོད་མེད་མ་ངེས།",
    "ཕར་ཕྱོགས་རྒྱ་དམག་སྟོང་ཕྲག་བརྒལ་བས་གཅིག་མཇུག་གཉིས་མཐུད་བར་མཚམས་སོ་སོ་ནས་མེ་མདར་རྩེ་གྲི་བསྒར་ཏེ་མདེའུ་བཅུ་ཆག་ཁ་མདེལ་སྤྲད་དེ་བོད་དམག་ལྷག་འཕྲོས་༡༤ སྟེང་ཟམ་མ་ཆད་པར་རྒྱག་བཞིན་འདུག་ཀྱང་བློ་སྟོབས་ཞུམ་མེད་ངང་།",
    "ར་ལུག་སོགས་དེད་ཉར་བྱ་གཡབ་ཕུབ་སྟེ་བསྡད་འདུག་པ་ཁོ་ཚོའི་སར་ཚོུད་༨ ཙམ་ལ་འབྱོར།",
    "དེ་སྐབས་ཕྲན་ཚོ་ལམ་ནོར་གྱུར་པར་ཡུལ་མི་ཚོས་ལྷོ་བྲག་སྲས་མཁར་དགུ་ཐོག་ཐག་ཉེ་ཡོད་ཚུལ་ཟེར་གྱི་འདུག་ཀྱང་མགྱོགས་ལམ་འདེམས་བསྐྱོད་བྱེད་ཐབས་བྲལ་ཞིང་།",
    "གུས་པ་ཟླ་བ་ཚེ་རིང་རང་ཉིད་ལ་མཚོན་ན།",
    "ཕྱག་སྒམ་མཆོད་གཤོམ་ནང་གསེར་ཚགས་བརྒྱབ་པའི་དངུལ་གྱི་ཕྲ་མན་ཕྲ་བཀྱགས་སོགས་འགངས་ཚེའི་དངོས་པོ་མང་པོ་བཞག་འདུག་ཀྱང་འདོད་རྔམ་ཧམ་འཁྱེར་མ་བྱས།",
    "ཕྲན་ཚོ་རུ་དཔོན་ལགས་སར་འཕྲལ་དུ་ཡོང་དགོས་ཞེས་ལན་བསྐུར་འདུག་པ་ལམ་སང་ཐོན་ཏེ་ཉིན་གཉིས་རྗེས་འབྱོར་བ་ངོ་བཅར་ཞུས།",
    "དེ་དུས་རྒྱ་གར་དཔོན་རིགས་ཚོས་ཀྱང་ལམ་བཟོའི་ལས་དོན་འདི་བཞིན་སྔ་འཕྲོས་ཁྱེད་རང་བོད་མི་ཚོའི་འཚོ་ངལ་སེལ་ཐབས་དང་།",
    "བྲག་ཕུག་ལ་ཆུ་འཁྱིལ་བའི་ནང་བྱ་ངང་པ་སེར་པོ་གང་ཙམ་གནས་འདུག་པ་མ་ཟད།",
    "དེ་བས་ངོ་མཚར་ཆེ་བ་ཞིག་ལ་རྡོའི་བུམ་པ་རང་བྱོན་ཞིག་ནང་ཚེ་རིལ་དང་ཚེ་ཆང་བཅས་ཀྱང་མཇལ་རྒྱུ་འདུགགློ་རྒྱལ་པོར་མཚོན་ན།",
    "ཁོང་རང་གློ་ལ་འགྲོ་མི་དགོས་པ་བདེ་སྲུང་བཀའ་བློན་ལས་རོགས་སུ་བསྐོ་གཞག་གནང་།",
    "འོན་ཀྱང་རྒན་ཡེ་ཤེས་ཁོ་རང་སྤྱི་རྒྱུ་སྒེར་ཟོས་བྱ་རྒྱུར་དགའ་པོ་ཡིན་ཁར་རིམ་པས་ཡུལ་ཞེན་ཁོག་བཅངས་ངོ་དགའ་རྒྱབ་མདུན་སྤྲེལ་ལད་ཤོད་མཁན་རིགས་ལ་ཧ་ཅང་དགའ་པོ་གནང་རྒྱུ་འགོ་ཚུགས།",
    "ཁོ་པ་བོད་ལ་བསྐྱོད་རྗེས་རྡ་སར་ཐེངས་ཁ་ཤས་སླེབས་འབྱོར་རྒྱ་གར་མི་སེར་གསར་པ་རྡ་སྟེང་རྡོར་གླིང་ཟ་ཁང་དང་ལས་འགན་དམིགས་ཡུལ་གཅིག་གྱུར་གྱི་མཐུན་གྲོགས་ཉེ་ཤོས་ཤིག་ཡིན་འདུག་པར་བརྟེན།",
    "འོན་ཀྱང་རང་ཉིད་ལ་མཚོན་ན་ཕྱག་དངུལ་དེ་ཁོངས་ནས་སྒོར་རྡོག་གཅིག་ཀྱང་གསོལ་རས་ཞུས་མེད་པ་མ་ཟད།",
    "ལྷ་ས་བ་བློ་བཟང་དོན་གྲུབ་ཀྱི་རྐང་པར་མེས་རྨས་སྐྱོན་འཚབ་ཆེ་ཙམ་བྱུང་འདུག་པར་སྒོར་༡༢།",
    "ཕྱིན་འདུག་པ་ཐབས་ཤེས་བྱ་རྒྱུར་བསྡད་ཡོད་པ་བཅས་དགེ་སྐུལ་ཞལ་འདེབས་བྱུང་གཞུང་དང་།",
    "དེ་བཞིན་གློ་སྒྲིག་འཛུགས་དམག་ཞབས་ཞུས་པའི་ནང་མི་བུ་ཕྲུག་རྣམས་ལ་དོ་བདག་འཚོ་གནས་ཡོད་མིན་ལ་མ་ལྟོས་པར་རང་རང་ལས་ཁུར་ཞུ་ཡུན་ལ་གཞིགས་པའི་ཕྱག་འཁྱེར་དང་།",
    "ད་ཆ་མེ་མདའ་རྒྱོབས་ལ་གསོད་ཤོག་ཅེས་འཇིགས་ཞུམ་མེད་པར་བྲང་ཁོག་བསྟན་པ་སོགས་བྱས་འདུག་པར་རྒྱ་མིས།",
    "མིན་ནམ་བསམ་པ་འདུག་གང་ཡིན་ཞུས་ན།",
    "རྐུབ་སྟེགས་སྟོང་པ་ཞིག་ཡོད་ལུགས་གསུངས་འདུག་ཀྱང་།",
    "བློ་ཁོག་ཆེན་པོ་བཅས་འདུག་པས་ངས་ཀྱང་ཁོ་རང་ལ་ཡིད་ཆེས་བློས་འགེལ་བྱེད་ཀྱི་ཡོད་ཟེར་བྱུང་།",
    "ད་དུང་རང་རིགས་སློབ་ཕྲུག་གཞོན་སྐྱེས་ཚོར་རྒས་པོས་འབོད་སྐུལ་ཞུ་རྒྱུར།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "རང་རང་ངོ་བོས་སྟོང་པ་ཉིད།",
    "སེམས་བྱུང་ལ་བྱེ་བྲག་སྨྲ་བས་ཡུལ་གྱི་རྣམ་པ་མེད་ཅིང་རང་རིག་མེད་པར་འདོད་ལ།",
    "ཞེས་གསུང་པ་གདའོ།",
    "ཡང་མཉམ་པར་བཞག་དུས།",
    "འདི་སྣང་བ་གདའ་བ།",
    "ལྟ་ང་རང་ཡང་སྐྱིད་པོ་ཡིན་སྙམ་པ་བྱུང་བའི་ཚེ།",
    "ང་སྐྱིད་པ་དང་བདེ་བ་དེ་ལ་དགའ་ཞིང་འདོད་པའི་སྣང་བ་གཅིག་འདུག་སྟེ།",
    "པ་འདུག་སྟེ།",
    "འགག་པ་ན་ཡང་གང་དུ་ཡང་མི་འགག་བར་དུ་གནས་པ་ན་ཡང་ལུས་ཀྱི་སྤྱི་བོའི་གཙུག་ནས་རྐང་པའི་བར་གང་དུ་ཡང་གནས་པ་མི་འདུག་ཁ་དོག་དང་དབྱིབས་ལ་སོགས་པའི་ངོ་བོ་ཅིར་ཡང་མ་གྲུབ་འདུག་དེ་ལྟར་བརྟགས་པ་ན།",
    "ང་ཡི་སྡུག་བསྔལ་འདི་ལ་མི་འདོད་ཅིང་བྲལ་ན་དགའ་བའི་སྣང་བ་གཅིག་འདུག་སྟེ།",
    "ད་ལྟ་སྡུག་གོ་སྙམ་པ་འདུག་སྟེ།",
    "དེ་ལ་སྡུག་རྒྱུ་ཅི་ཡང་མི་འདུག་གོ།",
    "ཁ་དོག་དང་དབྱིབས་ཀྱི་ངོ་བོ་ཅིར་ཡང་མ་གྲུབ་འདུག་པས་སྡུག་རྒྱུ་ཅི་ཡང་མི་འདུག་པ་ལ།",
    "ཆུས་འཁྱེར་བའི་སྡུག་བསྔལ་བྱུང་བ་བཞིན་དུ་འཁྲུལ་པའི་སྣང་བ་ལ་བདེན་པར་བཟུང་བས་ལན་པར་འདུག་ད་ནི་སེམས་ཀྱི་ངོ་བོ་སྐྱེ་མེད་དུ་ཤེས་པར་བྱས་ནས།",
