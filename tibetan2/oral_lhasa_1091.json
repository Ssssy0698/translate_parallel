    "དཔུང་རྒྱན་ལ་སོགས་པའི་རྡོ་རྗེ་སེམས་དཔའི་རྒྱན་གྱིས་བདག་ཉིད་བརྒྱན་པར་བྱས་ལ་རྡོ་རྗེ་སེམས་དཔའི་ཆ་ལུགས་སུ་བདག་ཉིད་བསྐྱེད་ལ།",
    "དེ་ལྟར་ན་ཟླ་བ་ཕྱེད་ཀྱི་སྦྱོར་བས་དེ་བཞིན་གཤེགས་པའི་རིགས་མཉེས་པར་འགྱུར་རོ།",
    "ཁྲོས་པར་གྱུར་པའི་རྣལ་འབྱོར་ཆེན་པོ་དང་ལྡན་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་།",
    "སྲོད་ཀྱི་དུས་སུ་ཁྲུས་བྱས་ཏེ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ཁྲོ་བོས་བསད་པ་དེ་ལྟ་བུ་ཟླ་བ་ཕྱེད་ཙམ་ཀྱི་སྦྱོར་བས་རྡོ་རྗེའི་རིགས་ལྷམཉེས་པར་བྱེད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡི་གེ་ཏྲི་རྣམ་པར་བསམས་ཏེ།",
    "སྟོང་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "པདྨའི་རིགས་དང་རྗེས་སུ་མཐུན་པའི་ཅོད་པན་ལ་སོགས་པའི་རྒྱན་ཐམས་ཅད་ཀྱིས་བདག་ཉིད་བརྒྱན་པར་བྱས་ལ།",
    "དེ་ལྟ་བུའི་སྦྱོར་བ་འདིས་ཞག་བདུན་ནི་༢པདྨའི་རིགས་རྗེས་སུ་མཉེས་པར་འགྱུར་རོ།",
    "ནམ་མཁའ་ཐམས་ཅད་མཉམ་པའི་ཏིང་ངེ་འཛིན་གྱི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་སྤངས་ཏེ།",
    "ཞེས་གསུངས་སོ།",
    "ནོར་བུའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ་དེ་བཞིན་གཤེགས་པ་དང་ནོར་བུའི་རིགས་ཀྱིས་ནམ་མཁའི་ཁམས་གང་བར་བསམ་པར་བྱའོ།",
    "རིམ་པ་འདི་ཉིད་ཀྱིས་ཞག་བརྒྱད་བཟླས་པ་དེ་ལྟ་བུས་ནོར་བུའི་རིགས་རྗེས་སུ་མཉེས་པར་འགྱུར་རོ།",
    "ནོར་བུའི་རིགས་དང་མཐུན་པའི་རྒྱན་རྔུཐམས་ཅད་ཀྱིས་བདག་ཉིད་བརྒྱན་པར་བྱས་ནས་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་པར་བྱའོ།",
    "དགའ་བ་སྐྱེད་ངཔར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་ངོ་བོ་རྡོ་རྗེ་སེམས་དཔའ་དེ་ལ་བརྙས་པར་མི་བྱ་སྟེ།",
    "ཅིའི་ཕྱིར་བརྙས་པར་མི་བྱ་ཞེ་ན།",
    "དེ་ལྟར་རྣམ་པར་རྗོ་དག་པ་དེ་སྦྱིན་པའོ།",
    "འདི་ལྟར་རྣམ་པར་དག་པའི་སྦྱོར་བ་དང་ལྡན་པ་ལ་སྨད་པྱིཔར་མི་བྱ་བ་དེ་བཞིན་དུ་བདེ་བ་སྦྱིན་པ་ལ་ཡང་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པའི་རྣལ་འབྱོར་བྱས་ལ།",
    "བཅོམ་ལྡན་འདས་འདོད་པ་སེམས་དཔའ་ནི་ཞེས་གསུངས་པའི་ཕྱིར་དེ་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་རང་བཞིན་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་བསྟན་པ་ནི་བསྒོམས་ལྐུཔའོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་ལ་སོགས་པ་རྣམས་ལ་མཚན་ཐོག་ཐག་བསྒོམས་ན་ངེས་པར་འགྲུབ་པར་འགྱུར་རོ།་",
    "འཇིག་རྟེན་རྒྱང་ཕན་ལ་སོགས་པའི་བསྟན་བཅོས་ལ་རབ་ཏུ་འཇོག་པར་བྱེད་པ་དང་།",
    "པདྨའི་རིགས་ནི་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་སྟེ།",
    "ཐམས་ཅད་དག་པར་བསྒོམས་ན་ནི།",
    "དེ་ལྟར་འདོད་ཆགས་རྣམ་པར་དག་པ་པདྨའི་འདབ་མ་ཁ་འབྱེད་ཅིང་བསྒོམས་པས་ཅི་ཞིག་བྱེད་ཅེ་ན།",
    "ངེ་ནས་བསྒྲུབ་པའི་ཆོ་གས་མཚན་ཐོག་ཐག་བསྒོམས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་སྔ་མ་བཞིན་དུ་མཚན་ཐོག་ཐག་བསྒོམས་ན་ནོར་བུའི་རིགས་ཀྱི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གསང་བའི་ལས་ཀྱི་དངོས་གྲུབ་ཀྱི་རྒྱུད་གསུངས་སོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་རྒྱུད་ནི་ཕྱག་ན་རྡོ་རྗེས་གསུངས་པའོ།",
    "དངོས་གྲུབ་ཐོབ་པར་འགྱུར་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཕྱིས་སྔོན་དུ་བསྙེན་པ་བྱས་ནས་བསྒྲུབ་པྱ་པ་བྱས་ན་ཙོངེས་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "རས་རིས་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་གསད་། པར་བྱ་བ་ལ་བསྡུ་བ་ལ་སོགས་པའི་ཆོ་གས་མདུན་དུ་གཞག་པ་སྣརྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པའི་སྦྱོར་བ་བྱས་ནས་ཡིད་ཀྱིས་གསད་ཀེ་པར་བྱའོ།",
    "དེ་ཡི་སྲོག་ནི་འཇིག་པར་འགྱུར།",
    "དེ་ལྟར་ན་རྒྱུད་དེ་དང་དེ་རྣམས་ལ་བསད་པའི་ཆོ་ག་གཞན་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "རྡོ་རྗེ་དེས་བསྒྲུབ་པར་བྱ་བ་ལ་བསྣུན་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྲོ་བོའི་གནས་པས་བསྙེམས་པ་དང་བཅས་པས་རྡོ་རྗེ་གསོར་ཞིང་བསྒྲུབ་པར་བྱ་བའི་སྟེང་དུ་ཡིད་ཀྱིས་འཕངས་པས་བསྐལ་པའི་མེ་དང་མཚུངས་པའི་རྡོ་རྗེ་ལྷུང་བས་བསྒྲུབ་པར་བྱ་བ་ལ་བསྣུན་པར་བསམ་ཟིཔར་བྱའོ།",
    "པར་བསྣུན་ཞིང་གསོད་པར་འགྱུར་རོ།",
    "བསད་ན་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།་།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟ་བུའི་སྦྱོར་བ་འདིས་བསྒྲུབ་པར་བྱ་བའི་ལྷ་སྣང་བ་མེད་པར་བྱས་ཤིང་དངོས་པོར་འཛིན་པ་མེད་པར་བྱས་པའོ།",
    "སྒྲུབ་ཕྱཔོས་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་གྱི་དངོས་གྲུབ་ཐོབ་པས་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་མྱུར་དུ་འགྲུབ་པར་འགྱུར་རོ།",
    "ད་ནི་རྡོ་རྗེའི་རིགས་གསུངས་པ་ནི།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་བསྒྲུབ་པར་བྱ་བའི་ལྷའི་སྟེང་དུ་ཡི་གེ་ཧཱུཾ་ལས་རྡོ་རྗེ་འབར་བ་ལྷུང་བས་དེས་བསད་པར་གྱུར་པར་བསམ་པར་བྱའོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལོག་པར་ལྟ་བ་བསྐྱེད་པས་ན་ཤེསྔགས་དང་།",
    "ལྷ་རྣམས་དང་སྔགས་ཀྱི་དངོས་གྲུབ་རྣམས་དོན་མེད་པས་འཇིག་རྟེན་པ་ལ་གནོད་པར་བྱེད་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེ་ལྟར་དངོས་གྲུབ་མི་ཐོབ་པའི་རྒྱུར་ཤེས་ནས་སྔ་མ་བཞིན་དུ་བསྒྲུབ་པར་པྱབྱ་བའི་ལྷ་སྤྱན་དྲངས་ཏེ།་",
    "པར་བྱའོ།",
