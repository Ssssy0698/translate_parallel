    "བསྒྲུབས་ན་ཐམས་ཅད་འགྲུབ་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་གཟུངས་ཀྱི་དངོས་གྲུབ་ཐམས་ཅད་བསྒྲུབ་པར་བྱའོ།",
    "མགུ་ནས་མྱུར་དུ་འགྲུབ་པར་འགྱུར།",
    "གཟུངས་ཀྱི་དངོས་གྲུབ་ཐམས་ཅད་འགྲུབ་པར་བྱ་སྙམ་ན།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་རིག་པ་ཟློས་ཤིང་བསྒྲུབ་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་མཁས་པས་ཡང་དག་པར་ཕྱིན་ཅི་མ་ལོག་པར་བྲི་བར་བྱའོ།",
    "ཁྲོ་བོ་རྡོ་རྗེ་ཆགས་པ་ལ་སོགས་པ་ལྷག་མ་རྣམས་ཀྱི་དཀྱིལ་འཁོར་ནི་རྡོ་རྗེ་ཆགས་པ་ལ་སོགས་པའི་དཀྱིལ་འཁོར་གྱི་རྗེས་སུ་འབྲང་བར་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་དཀྱིལ་འཁོར་གཞན་ཐམས་ཅད་ཀྱང་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པའི་སྒྲུབ་པའི་དཀྱིལ་འཁོར་ཛིས་ནས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་ཆོ་གས་ཞུགས་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "གནང་བ་མནོས་ནས་གཟུངས་ཀྱི་རིག་པ་སྣཇི་ལྟ་བ་བཞིན་དུ་ཟློས་ཤིང་།",
    "ཕྱག་རྒྱ་རྣམས་བཅིངས་ཏེ་ཇི་སྲིད་དུ་མཚན་མ་ཐོབ་པར་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་བསྒོམ་འུཔར་བྱའོ།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་པདྨ་འབེེབས་པའི་མཐར་ཐུག་པའི་པདྨའི་རིགས་ཐམས་ཅད་ཀྱི་དཀྱིལ་འཁོར་ཡང་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "ཅེས་བྱ་བ་ནི་དེ་སྔ་མ་བཞིན་དུ་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་དེ་བསྒྲུབ་༤པའི་གནང་བ་ནོས་ཏེ།",
    "གཟུངས་ཀྱི་རིག་པ་ཟློས་ཤིང་བསྒྲུབ་གྱེཔར་བྱའོ།",
    "དཀྱིལ་འཁོར་ལེགས་པར་བྲིས་ནས་ནི།",
    "རིན་ཆེན་ལྟ་བའི་དཀྱིལ་འཁོར་དུ་སྔ་མའི་རྗེས་སུ་འབྲངས་་ནས་རིན་ཆེན་འབེེབས་པའི་མཐར་ཐུག་པའི་ནོར་བུའི་རཱིརིགས་ཀྱི་དཀྱིལ་འཁོར་རྣམས་ཤེས་པར་བྱའོ།",
    "གཟུངས་སྒྲུབ་པའི་གནང་བ་ནོད་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཕན་ཡོན་གསུངས་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་བསྒྲུབ་པར་བྱ་ཞེ་ན།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་རྟག་ཏུ་རྣལ་འབྱོར་པ་བདག་ཉིད་ཀྱིས་འགྲུབ་པར་འགྱུར་རོ།",
    "ད་ནི་སྒྲུབ་ནཔ་དང་པོས་མ་གྲུབ་ན་སྒྲུབ་པ་གཉིས་པ་ལ་ཡང་དེ་ཁོ་ན་ཉིད་བསྐུལ་བས་ཡང་དག་པར་བསྐུལ་ལ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་ཀྱི་ཕྱག་རྒྱ་ཐམས་ཅད་གསང་བའི་དངོས་གྲུབ་ཀྱི་རྒྱུད་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཁྱད་པར་ཅི་ལྟ་བུ་ཞིག་ཅེ་ན།་",
    "ཡིད་བདེ་བའི་ངོ་བོ་རྒྱུན་མི་འཆད་པར་བདེ་བ་སྟེར་བའོ།",
    "བསྐུལ་ཞིང་བསྒྲུབ་པར་བྱ་སྟེ།",
    "དེ་ཁོ་ན་ཉིད་བསྐུལ་བས་ཡང་དག་པར་བསྐུལ་ཏེ་དེས་བསྒྲུབ་པར་བྱའོ།",
    "སྔོན་དུ་བསྙེན་པ་བྱས་ཏེ།",
    "ཡང་རྡོ་རྗེ་སེམས་དཔའི་རྣལ་འབྱོར་བྱས་ནས།",
    "དེ་བདག་རང་ཡིན་པ་ནི་རྣལ་འབྱོར་པས་ང་རྒྱལ་བསྐྱེད་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྒྲུབ་པ་པོའི་ལུས་དང་ཆུ་དང་འོ་མ་བཞིན་དུ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པས་ཅི་ཞིག་མྱུར་དུ་འགྲུབ་པར་འགྱུར་ཞེས་བྱའོ།",
    "དེ་ཉིད་བསྐུལ་བ་ནི་ཡང་དག་པར་བསྐུལ་བའོ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་རྣལ་འབྱོར་པས་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་རྣལ་འབྱོར་བྱས་ལ་ཕྱག་བཞི་བྱས་ཏེ།",
    "ཇི་སྲིད་དུ་མཚན་མ་ཐོབ་པར་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་པར་བྱའོ།",
    "པར་བྱའོ།",
    "དེ་ནས་དེའི་རྗེས་ལ་མངོན་སུམ་དུ་འོངས་ནས་སྒྲུབ་པ་པོ་དང་ལྷན་ཅིག་ཏུ་མཉམ་པར་སྤྱོར་བ་བྱས་ཏེ།",
    "སྒྲུབ་པ་པོའི་ལུས་ལ་འཇུག་པར་བྱའོ།་།",
    "ཞེས་བརྗོད་པར་བྱའོ།",
    "བསྒུལ་བར་གྱུར་པས་མྱུར་དུ་རྗེས་སུ་ཆགས་པས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཕྱག་བཞི་བྱས་པའི་མཐར་ཐུག་པའི་ཆོ་ག་རྗེས་སུ་སྤྱད་ལ།",
    "འཇུག་པ་ལ་སོགས་པ་ཆོ་ག་རྗེས་སུ་སྤྱད་དེ་བསྒྲུབ་པར་བྱའོ།",
    "དེའི་རྗེས་ལ་དེས་ཀྱེརྗེས་སུ་ཆགས་པའི་སྒྲུབ་པ་པོས་ལྷན་ཅིག་མཉམ་པར་སྦྱོར་བར་བྱའོ།",
    "དེ་ནས་མངོན་སུམ་དུ་འོངས་ནས་སྒྲུབ་པ་པོ་དང་ལྷན་བྱུག་མཉམ་པར་སྦྱོར་བར་བྱས་པས་སྒྲུབ་པ་པོའི་ལུས་ལ་ཞུགས་པར་འགྱུར་རོ།",
    "དེའི་རྗེས་ལ་དེ་ཇེའོངས་ནས་སྒྲུབ་པ་པོའི་ལུས་ལ་ཞུགས་པར་གྱུར་ཏེ།",
    "སཏྠ་ཀསྠཱ་ནི་ནོར་བུའི་རིགས་ཀྱི་གཟུངས་རྣམས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པའི་ལས་དེ་རྣམས་སྒྲུབ་པར་བྱེད་པའོ།",
    "རྟག་ཏུ་སྐྱེ་བའམ་དེ་བཞིན་གཤེགས་པ་རྣམས་སྐྱེ་བ་མེད་པར་ཞུགས་པས་ན་ཨ་དྷེ་བཛྲ་ནི་བཅད་དུ་མེད་ཅིང་དབྱེར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུའི་དེ་ཁོ་ན་ཉིད་བསྐུལ་བས་རྗེས་སུ་ཆགས་པས་འགྲུབ་པར་འགྱུར་ཞེས་བྱའོ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "དེས་གལ་ཏེ་དངོས་གྲུབ་ཀྱི་མཚན་མ་ཐོབ་པར་མ་གྱུར་ན།",
    "དེའི་རྗེས་ལ་དེ་འོངས་ནས་སྒྲུབ་པ་པོ་དང་ལྷན་ཅིག་མཉམ་པར་སྦྱོར་བ་བྱས་ཏེ།",
    "དེ་སྟོན་པར་བྱེད་པའི་རྒྱུད་དེ།",
    "དེ་ལྟའི་ཉེས་པར་མ་གྱུར་ཅིག་སྙམ་པས།",
    "མཆོད་རྟེན་ལ་སོགས་པའི་གཟུགས་ཀྱིས་བཞུགས་པའོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་དེ་བསྒོམས་ན་མྱུར་དུ་འགྲུབ་པར་འགྱུར་ཀྱི་གཞན་དུ་མ་ཡིན་ནོ།",
    "ཅེས་བྱ་བ་ནི་འདོད་པར་བྱ་བ་ཡིན་པས་ན་འདོད་པ་སྟེ།",
    "གཞན་ཡང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་གཟུགས་གང་ཡིན་པ་དེ་དག་རང་བཞིན་གྱིས་གདོད་མ་ནས་མ་སྐྱེས་པས།་",
    "མི་དམིགས་པའི་ཐུགས་རྗེ་ཆེན་པོ་མངོན་སུམ་དུ་བྱས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཆད་པ་ལ་སོགས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་ལྟ་བ་ངེས་བྱས་ཏེ་༧།",
    "བདག་ལ་ནི་མུ་སྟེགས་ཅན་གྱི་ལྟ་བ་ཅན་གྱིས་བྱས་པའི་བདག་ཉིད་ཁོ་ན་བདེན་པ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་ཞེས་ངེས་པར་སེམས་པ་༢༧ནི།",
    "དེ་ལྟར་ཤེས་ནས་འགྲུབ་པར་འགྱུར།",
    "མི་གཙང་ཞེས་ནི་ཅིའི་ཕྱིར་བརྗོད།",
    "ཁམས་གསུམ་པའི་རྣམ་པ་ནི་ཟུཡང་དག་པ་ལྟམ་ཡིན་པའི་ཀུན་དུ་རྟོག་པ་ནི་དོན་དམ་པར་ན་མ་སྐྱེས་པ་སྟེ།",
    "རྟག་ཏུ་ལེགས་པར་བསགས་པར་བྱ།",
    "ནོར་བུ་ཆེན་པོའི་རིགས་ཀྱི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་རྣལ་འབྱོར་བསྒོམས་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "ཕུལ་ན་མྱུར་དུ་འགྲུབ་པར་འགྱུར།",
    "མཉམ་པར་སྦྱོར་བར་བསྒོམས་པ་ལས་བྱུང་བའི་དགའ་བས་ངལ་ཞིང་སྐྱོ་ན་དེའི་བདེ་བ་དེས་ངལ་ཞིང་སྐྱོ་བའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མྱུར་དུ་འགྲུབ་པར་འགྱུར་རོ།",
    "སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ལ།",
    "སྐྱོ་བར་གྱུར་ན་ཕྱག་བཞི་བྱས་ལ་དེ་ནས་ངལ་བསོ་བར་བྱའོ།",
    "དེ་ལྟར་ཡང་དང་ཡང་དུ་བསྒོམས་ནས་ཡང་དང་ཡང་དུ་བསྒོམ་ཞིང་ཕྱག་བྱ་སྟེ་བསྙེན་པ་སྔོན་༢དུ་འགྲོ་བས་བསྒྲུབ་པར་བྱའོ།",
    "དེ་དང་འཁྱུད་པར་གྱུར་པའི་བདེ་བ་དེ།",
    "ཕུལ་ནས་དེ་ནི་འགྲུབ་པར་འགྱུར།",
    "དེ་ལྟ་བུའི་བདེ་བ་དེ་ཕུལ་ན་དེ་འགྲུབ་པར་འགྱུར་རོ།",
    "སྡུག་པའི་གདོང་དུ་བལྟས་ཤིང་ངེས་པར་བསམས་ལ།",
    "དེའི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་གཟུངས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་པ་ནི་ལས་ཀྱི་ཕྱག་རྒྱ་འཛིན་པར་གྱུར་པའོ།",
    "ཡོད་ན་ཕྱི་རོལ་གྱི་རྒྱན་ཀུན་གྱེས་རྣམ་བྱེཔར་བརྒྱན་པའོ།",
    "སྔ་མ་བཞིན་དུ་ནོར་བུ་ཆེན་པོའི་རིགས་ཀྱི་རྣལ་འབྱོར་བྱས་ནས།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔ་མ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེ་ལྟར་བདག་ཉིད་ཡང་དག་པར་མཆོད་ལ།"
  ]
}