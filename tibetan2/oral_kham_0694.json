    "དེ་ལྟར་རྟག་ཏུ་བྱས་ན་ནི་རྡོ་རྗེ་གསུམ་དབྱེར་མི་ཕྱེད་པའི་རྡོ་རྗེ་འཆང་ལས་སྐྱེས་པ་སྟེ་དེ་ལས་བྱུང་ཤིང་སྤྲུལ་པ་ཞིག་ཡིན་ནའང་རང་ཉིད་འཇིགས་ཤིང་སྐྲག་ནས་བགེགས་བྱེད་པར་མི་ནུས་ཤིང་བཟློག་སྟེ་དཀྱིལ་འཁོར་ཁྲི་བསྒྲུབ་རྫོགས་པར་བྱིན་གྱིས་རློབ་པར་མཛད་དོ། གསུམ་པ་ནི།",
    "དེ་ཡང་རང་ཉིད།",
    "ཁྱུར་མིད་གནས་འདུག་རིག་པ་རྣམས།",
    "སྤར་སྨེ་དར་གུད་ཟླ་ཞག་དུས།",
    "རང་རང་ལོ་གྲངས་གང་ཡིན་བགྲང་།",
    "ཕྱ་ལོན་རང་རང་ཕྱོགས་ནས་འབྱེད།",
    "གྲོགས་ཡིན་ཞག་དུས་རྐྱང་འདེད་བྱ།",
    "དེའི་དུས་སུ་ས་བརྐོ་རྡོ་སློག་ཤིང་གཅོད་ཆུ་འདྲེན་ཟམ་ཁང་རང་ཐག་སོགས་ལ་འཛེམ།",
    "རང་རང་སོ་སོའི་སྐར་ཁྱིམ་ནང་།",
    "གྲོགས་དང་མ་བུ་དགྲ་གྲོགས་རང་རང་ནང་འཕྲད་འཕྲོད་ཚུལ་གྱི་སྦྱོར་བ་སོགས།",
    "འཇིག་རྟེན་མིག་དུས་ལ་དགའ།",
    "སྒྲུབས་དང་ཆུ་སྟོད་ཀྱི་བར་ན་གཉན་རྒན་དེ་བས་བསགས་པའི་སྐར་མ་འདུག་གོས་མགོ་མཇུག་བསྒྱུར།",
    "ཁྲུམས་སྟོད་དང་ཁྲུམས་སྨད་བར་ན་སའི་ཀླུ་རྡོ་ཡོད་འདུག་ཞིང་ལ་གཉན་རྡོ་གཟུག་པར་བཟང་།",
    "ཁྲུམས་སྨད་དང་ནམ་གྲུའི་བར་ན་གཤིན་སྒོ་རབ་ཆད་ཀྱི་སྐར་མ་འདུག་ཅི་བྱེད་པར་བཟང་།",
    "མཇུག་རིང་བཅས་ལ་རང་རང་སོ་སོའི་འགྲོས་མྱུར་དལ་གྱི་ཁྱད་པར་ཡོད་པ།",
    "རྒྱབ་ཏུ་འདུག་པ་དེ་ལས་ལྡོག།",
    "ད་བར་སུས་ཀྱང་དཔེ་སྐྲུན་མ་ཐུབ་པར་རིམ་འགྱངས་སུ་ལུས་འདུག་པར་བརྟེན།",
    "རྣམ་ཀུན་མཆོག་ལྡན་ཟུང་འཇུག་དུས་འཁོར་ལོའི།",
    "ཟུང་འཇུག་དུས་ཀྱི་འཁོར་ལོ་ཐོབ་བྱའི་གཙོ།",
    "རང་རང་ཉམས་ཀྱིས་མངོན་སུམ་ཇི་བཞིན་སྟོན།",
    "བེེ་རོ་ཙ་ནའི་ཕྱག་དཔེའི་ཆ་ཤས།",
    "དབེན་ཞིང་ཉམས་དགའ་བའི་སྒྲུབ་པའི་བསྟི་གནས་ཡིན་པས་དོན་མེད་འཇིག་རྟེན་གྱི་རྣམ་གཡེང་ཟར་ཟིར་མང་པོ་དང་ཚེ་འདི་དོན་དུ་གཉེར་བའི་སྐྱེ་བོ་མང་པོའི་འདུ་ཚོ་གོས་ལ་དགོས་པ་མི་འདུག་ཀྱང་།",
    "ནོར་བཟང་སླར་ཡང་རང་ཡུལ་སླེབས།",
    "མ་གནོད་འོན་ཀྱང་རང་ལུས་བྱིན།",
    "རང་རང་སྐབས་དང་སྦྱར་བའི་འདོད་གསོལ་ཅན།",
    "རྣམ་འདྲེན་འཕྲིན་ལས་རྒྱུན་འཇུག་དུས་༦༩ན་ཐབས་པ།",
    "བ་ལྷུར་ལེན་པ་དཀོན་པ་འདྲ་ཞིག་འདུག་ཀྱང་།",
    "ཡལ་འདབ་སུམ་ཅུ་རྩ་དྲུག་པའི་རྒྱ་སྐད་ཙ་ཏུ་ར་སོགས་རྐང་པ་གཅིག་བོད་སྐད་དུ་མ་བསྒྱུར་འདུག་བ།",
    "ཞེས་སོགས་གློ་ཀ་གཉིས་ལ་སྐད་ཤན་སྦྱར་ཡོད་པའི་གླེགས་བམ་རྣམས་སྒོ་མཐུན་པར་རྒྱ་སྐད་མི་འདུག་པས།",
    "པ་སྨི་སོགས་ཚིག་རྐང་གཉིས་ཀྱི་སྐད་དོད་འདུག་པ་སྐད་ཤན་སྦྱར་ཡོད་པའི་གླེགས་བམ་ཚོར་བོད་སྐད་དུ་མ་བསྒྱུར་བར་ས་སྟོང་བཞག་འདུག་ཅིང་།",
    "ཐམས་ཅད་མཁྱེན་པ་བཙོང་ཁ་པ་ཆེན་པོའི་ཕྱག་དཔེ་སྐད་ཤན་སྦྱར་མེད་པ་དེར་ཡང་ཚིག་རྐང་གཉིས་པོ་དེ་མི་འདུག་བས།",
    "འབྲས་བཟང་རོ་བརྒྱ་གདའ་བའི་གཡང་ཆགས་པའི།",
    "རྩོད་པའི་ཡི་གེ་རྣམས་པར་དུ་འཁོད་འདུག་ནའང་།",
    "རྣམ་རྒྱལ་ཚེ་རིང་རང་ལོ་ཞེ་གཉིསཐོག།",
    "བེེ་རོ་ཙ་ན་རྣམས་ཀྱི་འབུར་སྐུ་གསར་བསྐྲུན།",
    "རྒྱབ་ཏུ་གཤིས་གས་ཡོད་འདུག་པར་མེ་སྤྲེ་ལོ་མཇལ་བར་མི་གནོད་པའི་དངུལ་སྲང་བཞི་བཅུའི་ཐུམས་ཕུལ།",
    "བཀུར་སྟི་གྱ་ནོམ་པ་མཛད་པ་རྣམསདཀར་ཆག་ཏུ་ཐེབས་ན་སླད་ནས་ཀྱང་བཟང་པོའི་མིག་ལྟོས་ཀྱི་རྒྱུར་འགྲོ་བ་འདུག་པས་རྩོམ་པར་སྐུལ་ཞིག་ཅེས་སྣང་སྲིད་དྲེགས་པའི་སྡོད་པོན་རྒྱལ་པོ་ཆེན་པོ་ལི་བྱིན་ཧ་ར་དང་།",
    "རང་བདེར་གཞོལ་མིན་འགྲོ་ཀུན་ལ་བསྔོས་དགེའི།",
    "སྐལ་ག་དུས་ཀྱི་དམུ་ཐག་ལམ་བཤེགས་བཤུལ།",
    "ཆ་ཙེའི་འོག་ཏུ་གྲུམཅོསེར་པོ་འཇག་མ་བརྒྱག་པ་སྔ་དུས་ཀྱི་སྲོལ་ལ་འདུག་ཅིང་བབས་ཆགས་པ་ཙམ་ཡོང་།",
    "འདི་ལས་གདན་འདིང་དགོ་མི་དགོས་ཀྱི་སྐབས་དབྱེ་གོང་སྣེའུ་སྡོང་པའི་མཚན་དོན་བར་འགྲོའི་དུས་བཞིའི་ཟོལ་མེད་འདུག་སྲམ་གདན།",
    "ཞེས་སོགས་སྦྱར་རྒྱུ་ཡིན་འདུག་ཅིང་།",
    "དགག་བྱ་དེ་ལྟར་ངོས་བཟུང་སྟེ་འགོག་ཚུལ་དེ་བཞིན་དུ་བྱས་པས་སེམས་ལ་སྒྲིབ་པ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དོ།",
    "སྐྱོན་གྱི་རིགས་ཀྱང་རང་བཞིན་གྱིས་མེད་དོ།",
    "དེ་ཡང་རང་རྒྱུད་པ་མན་ཆད་ཀྱིས།",
    "དུས་ངེས་པ་སོགས་ཀྱི་རྣམ་བཞག་མཛད་འདུག་པ་འདི་དག་གཞན་ལུགས་ལ་གོམས་འདྲིས་ཆེ་བའི་ཉམས་མྱོང་གསུངས་པ་ཡིན་ཚོད་ལས།",
    "ཚུལ་འདི་ཡུལ་དུས་འགའ་ཞིག་དང་བསྟུན་ན་འདོན་པ་དང་བྱེད་སྒོ་ཉུང་བར་འདུག་པས་ཐུགས་བདེ་བར་ཡོད་བཟོ་མི་འདུག་ཀྱང་།",
    "འགྲེལ་མཛད་པའི་གཞུང་སོགས་དམིགས་བསལ་དུ་ཕྱོགས་འདིར་ཡོད་བཟོ་མི་འདུག་པས་བཀའ་གཡར་ཞུས་པ་མངོན་ནོ།",
    "འོན་ཀྱང་གདགས་གཞིའི་མགོ་བཏགས་པ་ང་རང་ཉིད་ཡིན་ཞེས་སུས་ཀྱང་སྨྲ་མི་ནུས་སོ།",
    "ཚུར་གདགས་གཞིའི་སྟེང་དུ་གྲུབ་པ་རྡུལ་ཙམ་ཡང་མེད་པ་གསལ་པོར་རྟོགས་ནུས་པ་འདུག་གོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ལ་ཐིག་དང་།",
    "བོན་ཐམས་ཅད་རང་བཞིན་གྱིས་གྲུབ་པས་སྟོང་ཞིང་རང་བཞིན་གྱིས་སྟོང་པའི་བོན་རྣམས་རང་འཛིན་གྱི་ཤེས་པ་དང་བདག་ཉིད་གཅིག་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེས་ན་རྟགས་གཞན་གསུམ་གྱི་བསྒྲུབ་བྱ་གྲུབ་པའི་ཚེ་ནའང་རང་བཞིན་གྱིས་སྐྱེ་མེད་དུ་མ་རྟོགས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་མཚན་ཉིད་གསུམ་གྱི་འཇོག་ཚུལ་རྣམས་མི་འདྲའོ།",
    "འགྱུར་ཚུལ་བསྒྲུབས་འདུག་ཀྱང་།",
    "ད་དུང་དེ་བཞིན་དུ་རང་ལ་ཚུར་ཁ་ཕྱོགས་ནས་ང་འཛིན་པའི་ཞེན་འཛིན་དེ་ལ་ཕྱི་བལྟས་བྱས་པའི་ང་རང་ངོས་ནས་གྲུབ་པའི་འཆར་ཚུལ་ཡང་དེ་དང་འདྲའོ།",
    "དོན་དམ་པ་རང་མཚན་དང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཁྱད་པར་བྱེད་དོ།་",
    "ལྟ་བ་པོ་རང་ལ་ངོ་བོ་དང་རང་བཞིན་དང་གནས་ཚུལ་ལ་ཡོད་པ་ལྟར་སྣང་བ་ཤར།",
    "འདུག་ཚུལ་ལ་མེད་པར་དཔེ་ཡི་སྒོ་ནས་ཤེས་པར་བྱ་བ་དང་།",
    "གནས་ལུགས་ཡིན་པ་ལས་གཞན་དུ་ངོ་བོ་དང་རང་བཞིན་གང་ཡང་ཡོད་པར་མི་སེམས་སོ།",
    "འདུག་ཚུལ་ལ་མེད་པར་དཔེ་ཡི་སྒོ་ནས་ཤེས་པར་བྱ་བ་དང་།",
    "ཁྱེད་རང་འཁྲུལ་པའི་རྣམ་རྟོག་སྟེ།",
    "བརྡ་དང་ཐ་སྙད་བཏགས་པ་ཙམ་དེ་ཡང་རང་མཚན་དང་རང་ངོས་ནས་མ་གྲུབ་པ་ཁས་ལེན་ནོ།",
    "དུས་ཚིག་ཐིམ་པ་དང་འགྲོ་འདུག་སོགས་མི་དགག་པར་དབྱེ་ཞིང་བཀྲོལ་བའོ།",
    "ཞེས་འབྱུང་རྒྱུ་ཡིན་འདུག་ཀྱང་།",
    "འགྲོ་འདུག་ཉལ་བ་མི་བྱ་ཤིན་ཏུ་སྤང་།",
    "དབེན་པར་འདུག་ཀྱང་འགྲོ་ཉལ་ཐམས་ཅད་དུ།",
    "མི་མང་འདུས་སར་དཔུང་པ་གཡོགས་ལ་འདུག།",
    "སྐྲ་བྲེག་དུས་སུ་སྟོད་གཅེར་བུ་མི་བྱ་བར་སྐྲ་བཟེད།",
    "སོ་སོའི་སྟན་མ་བཏིང་བར་གྲལ་དུ་མི་འདུག་ཟས་ཕུད་འཐོར་བ་དང་འཐུང་བ་སོགས་སུ་མཐེབ་འཛུབ་སྒྲས་དུས་གཅིག་ཏུ་བྱ།",
    "འདུག་ཚེ་བླ་རྟེན་རྒྱབ་ཕྱོགས་ཁྲོས་བཞིན་དང་།",
    "གཤིབས་བརྐྱང་ཁྱི་ཚུགས་གཉིད་ཅིང་འདུག་སོགས་སྤང་།",
    "སྒུལ་བཞིན་སོས་གཅོད་ཉལ་ལངས་འདུག་ས་སྤོ།",
    "ཚོགས་སུ་སྡོམ་པ་མ་བླངས་པར་གྲལ་ལ་འདུག་ས་མེད་པ་དང་།",
    "གཞིས་ཀ་རིན་སྤུངས་པ་ལྟ་བུས་ཡོན་བདག་བྱེད་པར་འདུག་ཀྱང་མི་དགོས་གསུངས།",
    "གཉེན་སྲིད་ཀྱི་བར་འདུག་གྲོང་ཡུལ་དུ་རྩོད་འཛིང་ལ་ཐེ་བྱུས།",
    "འཇིག་རྟེན་ཕྱིར་དང་རང་གཡེང་བ།",
    "འཇིག་གནས་ཚེ་དང་རང་བཞིན་གྲངས་རྒྱུན་མེད།",
    "སྤྱི་དང་རང་མཚན་མ་འདྲེས་མཁྱེན་པའི་ཆ།",
    "སྲིད་མཐའི་བར་དུ་ཡུན་རིང་གནས་གྱུར་ཅིག་དུས་རྒྱལ་ཀུན་འདུས་མཉམ་མེད་ཤེས་རབ་རྒྱལ།",
    "རབ་ཏུ་བསྔགས་པའི་གནས་སུ་ཁ་བལྟས་ཏེ་འདུག་ལ་ཞེས་པའི་གོང་མཆན་དུ།",
    "སྟན་བདེ་བ་ལ་ཁ་ནུབ་ཏུ་བལྟས་ཏེ་འདུག་ནས་ཞེས་གསུངས་པའི་ཕྱིར།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "ཀུན་སྤྱོད་ཀྱི་ཏ་ཐཱ་ག་ཏའི་འགྲེལ་པ་ཡང་རང་ལུགས་སོ།",
    "ཤིང་ཏོག་ལ་སོགས་པ་འཚོ་བ་དག་པ་ཡིན་པ་ལ་དེ་དབྱར་དང་སྟོན་འོང་ཡང་དགུན་སྨད་དང་དཔྱིད་མི་འོང་པར་འདུག།",
    "དེ་ཡུལ་ལ་ལ་ན་ཡོད་ཀྱང་ལ་ལ་ན་མེད་པས་དེས་ཀྱང་མི་འཚོ་བར་འདུག།",
    "དེའི་ཚེ་བྷ་ག་ལའི་ཡུལ་པ་རྣམས་ལ་སྔར་གྱི་རྒྱལ་པོའི་ཀ་ཡ་ཏ་པ་དེ་ད་ལྟ་གྲུབ་པ་ཐོབ་ནས་འདུག་གོ་བྱ་བར་གྲགས་པས།",
    "དེས་རྒྱལ་པོའི་ཁྲིའི་རྩར་ཕྱིན་ཙ་ན།",
    "ལུས་ལ་ཉའི་དྲི་ཤིན་ཏུ་མི་ཞིམ་པ་མནམ་པ་ཞིག་འདུག་པ་མཐོང་བས།",
    "རྒྱལ་པོ་སྲང་དུ་གཤེགས་སུ་མི་འདོད་པར་གདའ།",
    "ཇི་ལྟར་འདུག་པ་བསལ་བར་བྱས་པ་སྟེ།",
    "རྟོགས་པ་སྐྱེས་ནས་ལུས་འོད་ཀྱིས་བསྐོར་ནས་འདུག་པ་གཞན་གྱིས་མཐོང་ནས།",
    "དེས་ཐུག་ཆང་ས་འོག་ཏུ་བཅུག་འདུག་པ་སླངས་པས་མ་སྟེར་ཏེ།",
    "ཆུ་འཛག་པ་དེ་ཡང་ཐུག་ཆང་དུ་འདུག་གོ།",
    "དེར་འདི་ནུས་པ་ཐོན་པ་ཞིག་འདུག་པས་ཏི་ལོ་པ་ཡིན་ནམ་སྙམ་པ་དང་།",
    "ནཱ་རོ་པས་ད་དུང་གསོལ་བར་འདུག་སྙམ་སྟེ།",
    "ཕྱོགས་རྣམས་སྟོང་ཞིང་རང་ཡང་རྣམ་པར་བྲལ།",
    "ཧ་ཧ་ཧི་ཧི་ཟེར་ཞིང་གཏོར་མ་ལག་པར་བཟུང་སྟེ་ལོག་ནས་བྱུང་བ་ལ་བལྟས་པས་ཁ་ན་ཕྱི་བའི་ཤ་འདུག་པ་ཕྱུང་བས་ཞིའོ།",
    "ལོ་ཀ་བའི་གཏོར་མ་ནམ་མཁའ་ལ་འཕར་ཞིང་འདུག་པས།",
    "ཇོ་བོའི་གམ་ན་བལ་པོ་བོད་སྐད་མཁན་ཡོད་འདི་སྐད་ཟེར་ཞིང་འདུག་བྱས་པས།",
    "རྟེན་གནས་ཉལ་ལྡང་ཁྲུས་བྱས་སྟན་ལ་འདུག།",
    "ཞེས་གསུངས་འདུག་གོ།",
    "སྔགས་ཚན་འོག་མས་སེམས་ཀྱང་རང་བཞིན་མེད་པའི་སྟོང་པ་ཅིར་ཡང་མི་འཛིན་པར་བསྟན་ལ།",
    "དེ་ཡང་རང་བཞིན་མེད་པ་ཕྱི་དབུགས་ཆད་པའི་སྐབས་སོ།",
    "ཡང་རང་ལུགས་གཅིག་ལ་ཟླ་གཅིག་ཁོ་ན་ལ་སྐྱེད་དེ་རྩ་རྒྱུད་ལས།",
    "འདུག་སྟངས་རྒྱན་ཆ་དང་ནི་གདན།",
    "འདུག་དང་ལྡང་བ་ཉིད་དང་ནི།",
    "ལུས་ཡན་མན་ཕན་ཚུན་འདོམ་གང་གྲུ་བཞི་པར་འདུག་པ་ནི་གཞལ་ཡས་ཁང་གྲུ་བཞི་སོགས་མངོན་རྟོགས་བཞིན་ལ།",
    "རྒྱུད་དོན་དུའང་འདུག་པས་དེ་ལྟར་བྱའོ།",
    "དེ་དག་དབྱེར་མི་ཕྱེད་ཅིང་ཐ་མི་དད་པ་དེ་ཡང་རང་བཞིན་གྱིས་དབྱེར་མི་ཕྱེད་པ་ཡིན་ལ།",
    "དེ་དག་ཀྱང་རང་བཞིན་སྟོང་པ།",
