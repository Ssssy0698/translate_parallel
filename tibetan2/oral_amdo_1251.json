    "ཀྲཱི་ཡ་པས་བདག་གི་དེ་ཁོ་ན་ཉིད་ཡོད་མེད་སྣང་སྟོང་གི་མཐའ་བཞི་དང་བྲལ་བའི་ཡེ་ཤེས་འོད་གསལ་བར་སྒྲོ་འདོགས་པའོ།",
    "དཔེར་ན་བུད་ཤིང་ཟད་པའི་མེ་བཞིན་མེད་པར་བལྟས་ན་སྐུར་འདེབས་སོ།",
    "དོན་དམ་བདག་གི་དེ་ཁོ་ན་ཉིད་བལྟ་བ་གཉིས་མེད་པར་བལྟ་ན་སྐུར་འདེབས་པའོ།",
    "དེ་ཉིད་གཞི་ལམ་འབྲས་གསུམ་གང་རུང་གི་ལྡོག་ཆ་དང་ངོ་བོ་གཅིག་ལ་ལྡོག་པ་ཐ་དད་སྟེ་དཔེར་ན་ཆུ་དང་ཆུ་ཟླ་ལྟ་བུ་སྟེ་ངོ་བོ་ཆུ་ཡིན་པ་གཅིག་ལ་ལྡོག་པ་ཐ་དད་པའོ་མ་བསྟུན་ན་རང་བཞིན་དང་གནས་ལུགས་ལས་མིང་གི་ཐ་སྙད་གང་ཡང་མི་འཇུག་དེ་གསུམ་དང་བསྟུན་ན་དྲི་མ་ཅུང་ཟད་ཀྱང་མ་སྤངས་པའི་གནས་སྐབས་ལ་གཞི།",
    "གཞི་ཡེ་ཤེས་སུམ་ལྡན་ནང་གསལ་ཤིན་ཏུ་ཕྲ་ཞིང་རྟོགས་པར་དཀའ་བའི་གཞོན་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "དེ་ཉིད་དངུལ་ཆུའི་སྦྱོར་བ་ལ་མཁས་པ་ཞིག་གིས་གནས་སྐབས་ལྔའི་ལྕགས་འདར།",
    "སྦྱོར་བ་མི་ཤེས་ཞིག་གིས་བྱས་ན་གསེར་དུ་མི་འགྱུར་བའི་ཐོག་དངུལ་ཆུ་ཡང་ཆུད་ཟོས་སུ་འགྲོ་བ་བཞིན།",
    "གདམས་ངག་སྟེང་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "དང་འོག་གི་སྒོ།",
    "སྟེང་སྒོ་འཁོར་ལོ་དྲུག་ལ་བརྟེན་ནས་འབར་འཛག་གི་སྦྱོར་བས་སོགས་ཏེ།",
    "རྩ་འཁོར་གྱི་ཕྱོགས་བཞིར་རྩ་རེ་རེ་སྟེ་བཞི།",
    "དེ་རེ་རེ་རྩེ་ལ་གཉིས་གཉིས་རེ་སྟེ་བརྒྱད།",
    "དེའི་འོག་ཏུ་སྦར་བྱ་གཏུམ་མོ་ཨ་ཤད་མེའི་འཁོར་ལོ་གྲུ་གསུམ་ཡི་གེ་རམ་གྱིས་མཚན་པ།",
    "ཕྱག་རྒྱ་རབ་ལྷ་མོ་འབྲིང་ཀླུ་མོ་རིགས་ཐ་མ་མིའི་བུ་མོ་ཡིན་གྱི་རིགས་ངན་པ་ཟེར་བ་མིན་ངན་མོ།",
    "སྐད་ཅིག་ལ་བདེ་བ་ཆེན་པོ་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་དང་ཤེས་རབ་སྟོང་པ་ཉིད་ཟུང་དུ་འཇུག་པའི་བདེ་སྟོང་གི་ཡེ་ཤེས་བཙན་ཐབས་སུ་སྐྱེས་པས་ས་ལམ་ག་གཅིག་ཆོད་དུ་རྫོགས་པའི་ཐབས་ལམ་ཅིག་ཅར་བ་སྟེ།",
    "ཡེ་ཤེས་བཞིའམ་ལྔ་རྫོགས་པའི་སེམས་ཉིད་རང་བྱུང་གི་དཀྱིལ་འཁོར་ལ།",
    "རྟོགས་གོམ་གཉིས་འབྲས་བུ་སྨིན་པར་བྱེད་པའི་ནུས་མཐུ་ཅན་དུ་གྱུར་པ་གང་གི་ཚེ་འགྱུར་བ།",
    "གང་གི་དམིགས་མེད་མི་ཤེས་པ།",
    "ཐམས་ཅད་གསུང་གི་ཕྱག་རྒྱའི་མཆོག།",
    "ཅེས་པས་ལོངས་སྐུ་དགོངས་པ་གསུང་གི་གསང་བ་གཅིག་ལ་ཡང་གསུང་གི་དཀྱིལ་འཁོར་ཡན་ལག་དྲུག་ཅུ།",
    "ཀ་ལ་པིངྐ་འབྲུག་གི་སྒྲ།",
    "རེ་རེ་ལའང་ཡན་ལག་ནི།",
    "བསམ་གྱིས་མི་ཁྱབ་པས་ཞིང་ཁམས་ཀུན་ཏུ་ཁྱབ་ཅིང་རང་གི་སྐད་དུ་བརྡ་སྤྲོད་པའི་སྒྲ་དང་མིང་སོ་སོར་གྲགས་ཅིང་གྲགས་པ་དེ་ཐམས་ཅད་ཀྱང་ཟབ་པ་དང་རྒྱ་ཆེ་བ་ལས་མི་འདའ་བའོ།",
    "འདིས་ཚིག་དངོས་བསྟན་དུ་བརྗོད་ཚིག་གི་གསུང་འདི་ལྟར་བསྟན་ཀྱང་དོན་དུ།",
    "གསུངས་པ་ཉིད་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "གཏན་ཚིག་གིས་ཀྱང་རྒྱལ་བའོ།",
    "ལོངས་སྐུས་འཁོར་ས་བཅུའི་བྱང་སེམས་ལ་སོགས་པ་སྨིན་པ་རྒྱ་མཚོ་ལ་དགོངས་པ་བརྡའི་གསུང་གིས་བརྡ་སྤྲོད་པ་དང་།",
    "རྡོ་རྗེའི་སྐུས་སྐུ་གསུམ་དབྱེར་མེད་རྡོ་རྗེའི་འཁོར་ལ་རྡོ་རྗེའི་གསུང་གིས་བརྡ་སྤྲོད་པ་དང་།",
    "ལེའུ་བདུན་པའི་གོང་གི་འཕྲོས་ལས།",
    "ལྔ་སོ་སོའི་གསུང་གི་རྣམ་གྲངས་བསྟན།",
    "སྐུ་ལྔ་དེ་དག་གི་གསུང་ལྔ་དང་ཚུལ་མཐུན་པའི་བརྡ་དོན་ཏེ།",
    "དབྱེར་མེད་རྡོ་རྗེའི་གསུང་གི་མཚོན་པ་སྒྲ་དོན་མོས་པ་དང་མཐུན་པ་གདུལ་བྱར་སྣ་ཚོགས་གསལ་བ་ཉིད་ནའང་མི་དམིགས་པས་གསུང་གི་རང་བཞིན་དབྱེར་མི་ཕྱེད་པས་དེ་བཞིན་ཉིས་ལས་མ་གཡོས་ཀྱང་རྒྱལ་བའི་ཐུགས་རྗེ་གདུལ་བྱའི་མོས་པ་ལ་རང་སྣང་བ་བྲག་ཆ་ལྟ་བུ་གྲགས་སྟོང་དབྱེར་མེད་བྲག་ཆ་ལྟ་བུ་དང་།",
    "ཚིག་རེས་དོན་རེ་མཚོན་པ་ཚིག་གི་གསུང་དང་།",
    "ཚིག་གཅིག་གིས་དོན་སྣ་ཚོགས་སྟོན་པ་ཚངས་པའི་དབྱངས་ཀྱི་གསུང་གཉིས་སོ་ཚངས་པའི་དབྱངས་ཀྱི་སྒྲ་ལྟ་བུ་སྟེ།",
    "དེ་ལྟར་མོད་ཀྱང་བསྡུ་ན་གཏན་ཚིག་གཉིས།",
    "བཞི་རྗེས་སྐུ་བཞིའི་གཏན་ཚིགས་ཀྱི་རྗེས་སུ་མི་དཔྱད་གཅིག་སྤྲུལ་དསྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "སྒྲ་མཐུན་དོན་དཔག་གི་གཏན་ཚིགས་གཉིས་ལས།",
    "ཀྱིས་མཚོན་དུ་མེད་པའི་ཡི་གེ་ཨ་མཚོན་དུ་མེད་པའི་ཡི་གེ་ཡིན་ཀྱང་ཀུན་རྫོབ་ཏུ་ལྷ་སྐུ་ཡེ་ཤེས་ཀྱི་སྣང་བ་མཚོན་བྱེད་ཀ་ལ་སོགས་བཞི་བཅུ་རྩ་གཉིས་ཉིད་མཚོན་བྱེད་ཡི་གེ་དུ་མར་སྣང་བའི་མཚོན་པའི་ཕྱིར།",
    "སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས། གསུམ་པ་མཉམ་པ་བཞིའི་གཏན་ཚིགས་ནི།",
    "བདག་ཏུ་འཛིན་པའི་ཤེས་པ་བདག་གིར་རྟོག་པ་ཕུང་ལྔ།",
    "ཀུན་རྫོབ་ཏུ་མི་བསླུ་བས་སྒྱུ་མ་ཙམ་དུ་མཉམ་པ་ཐུན་མོང་དང་།",
    "མྱུ་གུ་བདག་ལས་ཀྱང་མི་སྐྱེ་གཞན་ལས་ཀྱང་མི་སྐྱེ་བ་བདག་གཞན་གཉིས་ཀ་ལས་མི་སྐྱེ་བདག་གཞན་གཉིས་ཀ་མ་ཡིན་པའི་རྒྱུད་མེད་པ་ལ་མི་སྐྱེ་བ་སྟེ་མཐའ་བཞིའི་སྤྲོས་པ་ཆོད་པ་རྣམ་གྲངས་མ་ཡིན་པའི་དོན་དམ་དེ་གཉིས་ཀ་སྐྱེ་མེད་དུ་མཉམ་པ་ནི་རྒྱུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལའང་ཡོད་པའི་ཕྱིར་ཐུན་མོང་གི་མཉམ་པ་གཉིས་སོ།",
    "ཡང་དག་པར་མ་གྲུབ་སྟེ་འདོད་ཆགས་རང་རང་གི་ངོ་བོས་སྟོང་པའི་ཕྱིར་དཔེར་ན་ཐག་ཁྲར་སྦྲུལ་སྣང་གཤིས་ལ་མ་གྲུབ་བཞིན་ནོ།",
    "དོན་རང་གི་མཚན་ཉིད་རང་རིག་མངོན་སུམ་དུ་རྟོགས་པའི་དམིགས་པའི་ཡུལ་དང་བྲལ་བ།",
    "སྣོད་བཅུད་དག་མཉམ་ཆེན་པོར་སྐུ་དང་ཡེ་ཤེས་ཀྱི་དཀྱིལ་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "འཁོར་དུ་རྟོགས་པ་རྒྱུའི་ཐེག་ཆེན་ལ་མེད་པའི་སྔགས་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་ལྟ་བ་ཡིན་ལ།",
    "གསང་སྔགས་འཛིན་པ་ནི་དེ་དག་གི་དགོངས་སྤྱོད་དང་མཉམ་པར་གསུངས་པས་འཕགས་པའོ།",
    "མོས་སྒོམ་དང་ངེས་རྫོགས་གཉིས་ལས།",
    "ཚོགས་ལམ་མོས་སྒོམ་ནི།",
    "ང་རྒྱལ་བརྟན་པ་ཚུལ་བཞིན་དུ་སྒོམ་མི་ཤེས་པས་ཕྱོགས་མཚོན་ཙམ་དུ་སྒོམ་ཡིད་བྱེད་ཙམ་བྱ་བ་ཐུན་གཅིག་ལ་སྲུང་འཁོར་ནས་བཟུང་ཆོ་གའི་བྱ་བ་ཚར་རེ་རྫོགས་པ་ཡིན།",
    "ལས་དང་པོ་པ་ཕལ་སེམས་མཉམ་པར་བཞག་པའི་དུས་སུ་གནས་པ་དང་པོ་རི་གཟར་གྱི་འབབ་ཆུ་ལྟར་སེམས་སྐད་ཅིག་ཀྱང་མི་གནས་པར་རྣམ་རྟོག་སྔར་བས་རྒོད་ཅིང་མང་དུ་སོང་བ་ལྟ་བུ་དེ།",
    "དེ་ཡང་མང་དུ་སོང་བ་མ་ཡིན་ཏེ།",
    "རྣམ་རྟོག་འཕྲོ་མུས་ནས་ཡུད་ཙམ་རེ་སྐབས་སྐབས་སུ་མཉམ་དགེ་རྩེ་འགྱུར་མེད་བསྟན་པ་རྣམ་རྒྱལ་གྱི་གསུང་འབུམ།",
    "དཔེ་རྒན་པོས་བྱིས་པའི་རྩེད་མོ་ལ་ལད་མོ་བྱེད་མི་ནུས་པ་རྒན་པོའི་སྤྱོད་པ་ལྟ་བུ་སྟེ།",
    "ཕལ་ཆེར་གྱི་དུས་སུ་རྟོག་མེད་དུ་གནས་པ་ལས་རེས་འགའ་བའི་དུས་སུ་རྟོག་པ་ཡུད་ཙམ་རེ་འབྱུང་སྟེ།",
    "གོམས་པའི་ཉམས་སམ་རྣམ་རྟོག་གི་ཐང་ཆད་པའི་ཉམས་ཞེས་བྱ་གསུངས།",
    "བརྟན་པའི་ཉམས་སམ་རྣམ་རྟོག་གིས་བསྐྱོད་དུ་ཡོད་པའི་ཉམས་ཞེས་བྱའོ།",
    "གནས་པ་ལ་རྐྱེན་གང་གིས་ཀྱང་གནོད་མི་ནུས་པར་མ་ཟད་སླར་ལ་བོགས་འབྱིན་ཞིང་།",
    "ཤི་བའམ་འཆི་སྲིད་ནི་ཤི་བ་ལུས་ཀྱི་འབྲེལ་ཆད་པས་རིག་པ་རྒྱལ་བ་ལྟར་ཧད་ཀྱིས་སོང་སྟེ་ཕྱི་ནང་གི་རྟོགས་པ་ཐམས་ཅད་གཉིས་སུ་མེད་པར་སྤྲོས་མེད་ནམ་མཁའ་ལྟ་བུ་དོན་དམ་བདེན་པ་སྟེ།",
    "ལམ་གྱི་སྒྲུབ་གཞི་བདེ་གཤེགས་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "འཁྲུལ་རྟོག་གིས་མྱོས་པས་ལས་སུ་མི་རུང་བ་འདི་ཉིད།",
    "གདམས་ངག་གི་ཤེས་རབ་ཀྱི་སྟོབས་ཀྱིས་མཉམ་པར་བཞག་པས་བཏུལ་ནས་སུ།་",
    "ཡུལ་གྱི་སྒྲ་ཐིམ་པའི་རྟགས་རང་གི་ལུས་ཀྱི་སྒྲ་མི་ཚོར་བ་རྣམས་སོ།",
    "ལུས་ཀྱི་དྲི་ཐིམ་རྟགས་རང་གི་ལུས་དྲོད་མི་ཚོར།",
    "དེ་ལྟར་ཕྲ་རགས་ཉེར་ལྔ་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "གཞན་གྱི་ཕུན་ཚོགས་ལ་སེམས་འཁྲུགས་པ་ཕྲག་དོག་སྟེ་མཚན་ཉིད་སུམ་ཅུ་རྩ་གསུམ་མོ།",
    "ཡིད་འོང་གི་ཕྱོགས་ལ་སེམས་སྙོག་པ།",
    "རང་གི་ཉེས་པ་སྦེད་པའི་གཡོ་ནི།",
    "གཏི་མུག་གི་རྟོག་པ་རྨོངས་པ་སོགས་བདུན་འགགས།",
    "གཏི་མུག་གི་རྟོག་པ་བདུན་ནི།",
    "རེ་ཞིག་གཟུང་འཛིན་གྱི་སྣང་བ་དང་སྣང་བ་གསུམ་ཡང་འགགས་པས་ཕྱི་རྟགས་སུ་སྟོན་ཁའི་རྐྱེན་བྲལ་གྱི་ནམ་མཁའ་གཡའ་དག་པ་ལྟ་བུ་དང་།",
    "ནང་རྟགས་སུ་རྣམ་པར་མི་རྟོག་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "ལེའུ་བཅུ་བདུན་པ་ལྟར་ཚིག་གིས་གསལ་གདབ།",
    "ལྷ་ཚོགས་རྣམས་ལས་ཐབས་ཤེས་གཉིས་སུ་མེད་པའི་འོད་ཟེར་སྤྲོས་པས་བདག་གི་ལུས་རྟོག་སྦྱངས་ཏེ།",
    "རྒྱལ་བ་སྲས་དང་བཙུན་མོར་བཅས་པ་རང་འཆར་བ་ནི།",
    "གང་གིས་གང་ལ་གསོལ་བཏབ་པས།",
    "རྫོགས་རིམ་སྐབས་ཞི་ལྷག་ཟུང་འཇུག་གི་འོད་གསལ་གྱི་ངང་དུ་མཉམ་པར་བཞག་པའི་ཁྱད་ཡིན་སྙམ།",
    "འཇིགས་མེད་ཀུན་བཟང་ཕྱག་རྒྱའི་མཆོག་ཞེས་པའི་བར་གྱིས་འོག་གི་ཕྱག་རྒྱ་རགས་པ་ལྷ་སྐུ་སྤྲོས་བཅས་ཀྱང་བསྟན།",
    "ཕ་མའི་ཁུ་ཁྲག་གི་དབུས་སུ་ཞུགས་པ་ལས།",
    "ཕ་མ་གཉིས་ཀྱིས་རེག་པ་སྲ་བ་དེ་ཉམས་སུ་མྱོང་བས་ས་ཁམས་གྲུབ།",
    "ཁྱབ་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "དེ་ནས་ཞག་རེ་ལ་རྩ་གཉིས་བརྒྱ་རེ་ཆགས་པས་དབུ་རྐྱང་རོ་གསུམ་གྱི་རིགས་ལས།",
    "དང་པོ་གཞལ་ཡས་ཁང་གི་དབུས་སུ་གདན་ཉི་མས་རྡུལ་ཟླ་བས་ཁུ་དགེ་རྩེ་འགྱུར་མེད་བསྟན་པ་རྣམ་རྒྱལ་གྱི་གསུང་འབུམ།",
    "སོ་སོའི་ཕྱག་མཚན་གྱིས་ཁུ་རྡུལ་སེམས་གསུམ་འདྲེས་པ་ཕ་མའི་འདུ་འཕྲོད་ཀྱི་རེག་པ་སྲ་བ་སོགས་ཁམས་ལྔ་ཉམས་སུ་མྱོང་བ་རིགས་སོ་སོའི་ས་བོན་ཕྱག་མཚན་དུ་གྱུར་པས་ཐུགས་ཕྱག་མཚན་གྱི་ཆོ་ག་མཚོན།",
    "ཕྱག་མཚན་གྱིས་ཁུ་ཁྲག་གི་དབུས་སུ་ཞུགས་པ།",
    "དེ་གཉིས་ཀྱི་བར་དུ་ཡབ་ཡུམ་གྱི་ཕྱག་མཚན་ལ་རང་རང་གི་ས་བོན་གྱིས་མཚན་པ་སོར་རྟོགས་ཡེ་ཤེས།",
    "སྣང་སྔ་འགྱུར་ཀ་ཐོག་བཅུ་ཕྲག་རིག་མཛོད་ཆེན་མོའི་དཔེ་ཚོགས།",
    "བའི་ཆ་ལ་གཟུགས་སྐུ་གཉིས་ཟུང་འཇུག་གི་ལྷ་སྐུར་སྣང་བའི་གཞི་ད་ལྟ་ནས་བཏིང་བས་ལམ་གོང་མའི་དུས་སུ་ཟུང་འཇུག་ལྷ་སྐུར་སྨིན་པར་བྱེད་པའི་གྲོགས་སུ་དུ་འགྲོ།",
    "བྱ་བྱེད་གཉིས་ཀུན་ཏུ་བཟང་པོ་དང་ཀུན་ཏུ་བཟང་མོ།",
    "སྒོ་བ་ཡབ་ཡུམ་བརྒྱད་དང་བཅོ་བརྒྱད་ནི་རིགས་གཅིག་གིས་གཙོ་བོར་བྱེད་པས་ན་ཚོམ་བུ་གཅིག་པ་དང་།",
    "གསང་རྡོ་རྗེ་སྣང་མཐའ་ཡབ་ཡུམ་ཆ་ལྔ་ཡ་བཅུ་བཅས་ལ་རང་རང་གི་རིགས་ཆུང་གིས་བསྐོར་བས་སུམ་ཅུ་ལ་ཁྲོ་བོ་ཕྱོགས་མཚམས་བརྒྱད་བཅུ་ལས་ཧཱུྃ་ཀ་ར་སྟེང་འོག་སྟོབས་པོ་ཆེ་གི་ཁྲོ་བོ་སྤངས་པས་ཡབ་ཡུམ་བཅུ་དྲུག་བསྣན་པས་གཙོ་བོ་རིགས་གསུམ་གྱིས་བྱས་པའི་ལྷ་ཞེ་དྲུག་ནི་ཚོམ་བུ་གསུམ་པ།",
    "ཚོམ་བུ་གསུམ་པར་དེའི་སྟེང་དུ་ཤར་ནུབ་ཏུ་བུདྡྷ་དང་པདྨ་ཁྲག་འཐུང་ཡབ་ཡུམ་གཉིས་རིགས་ཆུང་བཅས་བསྣན་པས་གོ་བརྒྱད།",
    "ལྕེ་གཡས་སུ་སྤྱན་གཟིགས།",
    "རྐང་ལག་གི་མཐིལ་ལག་མཐིལ་གཡས་སུ་གཤིན་རྗེ།",
    "ཡུམ་གྱི་དབུ་གཙུག་ཏུ་ཀུན་ཏུ་བཟང་མོ།",
    "གཡོན་གྱིས་ཆ་ལ་ནང་སེམས་བཞིའི་ཡུམ་གནས་དེ་རྣམས་སུ་དེ་དག་གི་ཡུམ་རྣམས་བསྒོམ།",
    "ལྟེ་བར་བྱོལ་སོང་།",
    "དེ་རྣམས་ལ་སྐུའི་ཐུགས་ཀར་རང་འདྲའི་ཤེས་རབ་ཀྱི་སྐུའི་ནང་དུ་གནས་པ་དང་སྐུ་ཕྲ་མོ་ཡིན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ལྷའོ་ལྷ་ཡེ་ཤེས་སེམས་དཔའ་དབུ་རྒྱན་སོགས་མེད་པ་བཞི་བཅུ།་",
    "གོང་གི་འཕྲོས་སུ།",
    "དེ་ལྟར་བསྟན་པའི་གཙོ་མཆོག་གི།",
    "སེམས་དཔའ་བརྒྱད་སྒོ་བ་བཞི་སྟོང་ཕྲག་བཅུ་གཉིས་ཐུབ་པ་སྟོང་ཕྲག་དྲུག་གི་སྟོང་ཕྲག་ཉི་ཤུ་རྩ་བཞིའི་ལྷ་འོད་རབ་ཏུ་འཕྲོ་ཞིང་གཟི་བརྗིད་འབར་བའི་དོན་ཡིན་འོད་འཕྲོ་འབར།",
    "གོང་གི་འཕྲོ་ལས།",
