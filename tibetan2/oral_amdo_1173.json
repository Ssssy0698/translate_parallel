    "ལ་ལ་ཉོན་མོངས་པ་སྤྱོད་པས་གྲོལ་བར་བསྟན་པའང་ལེགས་སོ།",
    "ཟབ་མོ་ལྟར་ན་ཡབ་ཡུམ་གཉིས་སུ་མེད་པའི་བདེ་བ་དང་།",
    "སོགས་ཀྱི་སྒྲས་ཉོན་མོངས་པ་ལྷག་མ་བཞི་ཡང་དེ་བཞིན་དུ་གནས་སུ་དག་ཅིང་ཡང་དག་པའི་ང་རྒྱལ་ཆེན་པོ་ལ་སོགས་པར་འགྲུབ་སྟེ།",
    "གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གིས་སོ།",
    "གང་གི་སྒོ་ནས་བསྟོད་ཅེ་ན།",
    "ངག་གིས་དོན་དང་ལྡན་པའི་ཡོན་ཏན་བརྗོད་པ་དང་།",
    "སྒོ་གསུམ་མི་གཉིས་པར་འདུད་པའི་ཚིག་གིས་བསྔགས་པ་བརྗོད་དེ།",
    "མྱ་ངན་ལས་འདས་པའི་མཐར་འགྱུར་བའི་སྒྲིབ་པ་མེད་ཅིང་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པའི་དྲི་མ་ཡང་མེད་པས་མཚན་མར་ལྟ་བའི་དངོས་པོ་དང་བྲལ་ཞིང་།",
    "ཕོ་མོར་རྟོག་པའི་ཞེན་ཆགས་རྣམ་པར་དག་པས་གཏི་མུག་ཞེ་སྡང་ང་རྒྱལ་ཕྲག་དོག་ཉེ་བར་ཞི་ཞིང་རྣམ་པར་རྟོག་པ་སྤྲོས་པ་སྤང་བའི་མཚན་ཉིད་ཅན་ཡང་དག་པའི་འདོད་ཆགས་ཆེན་པོ་ལ་སོགས་པ་གཉིས་སུ་མེད་པའི་བདེ་བ་ཆེན་པོས་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་བདེ་བ་ལ་ལོངས་སྤྱོད་ཅིང་།",
    "རང་གི་མཚན་ཉིད་མ་འདྲེས་པ་བཅོས་པར་མཁྱེན་ཅིང་དེ་ལ་ཆགས་སྡང་མཚན་མར་འཛིན་པ་མེད་པ་དང་།",
    "གང་དག་གཟུགས་དང་ཚོར་བ་འདུ་ཤེས་འདུ་བྱེད་བཅས་པ་དང་།",
    "བཏང་སྙོམས་གསུམ་སོ་སོར་མ་ཕྱེ་ཞིང་གཅིག་གི་ངོ་བོར་བསྡུས་ནས།",
    "ཉོན་མོངས་པ་རྣམ་པ་གསུམ་གྱི་གནས་དང་སྒོར་གྱུར་པའི་སྒོ་གསུམ་གནས་སུ་དག་པ་སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་རྣམ་པ་གསུམ་གྱི་རང་བཞིན་དུ་གྱུར་པ་སྟེ།",
    "གཏི་མུག་གི་བཟླས་པ་ལ་སོགས་པ་མཉེས་པའི་ཐབས་རྣམ་པ་སྣ་ཚོགས་པས་མཉེས་པ་བསྐྱེད་ན།",
    "གཉི་ག་ལ་སྒྲིབ་ཅིང་གཞན་གྱིས་གཞིག་ཅིང་སྤང་བར་དཀའ་བས་རྡོ་རྗེ་བཞིན་དུ་སྲ་ཞིང་གཅིག་གི་ངོ་བོར་གཅིག་དབྱེར་མེད་པའི་མཚན་ཉིད་ཅན་ཏེ།",
    "ཉོན་མོངས་པ་གཞན་ལ་སྒྲིབ་པ་བགེགས་མཐར་བྱེད་པའོ།",
    "ཁྲོ་མོ་རྣམས་ཅིའི་ཕྱིར་མ་སྨོས་ཤེ་ན།",
    "གང་ཞིག་གིས་ནི་དངོས་གྲུབ་དམ་པའི་ཐབས་སུ་སྦྱོར་བྱེད་པ།",
    "ད་ནི་གསུམ་པ་འབྲིང་གི་དངོས་པོ་བསྟན་པའི་ཕྱིར་ན།",
    "གང་ཞིག་གིས་ནི་སྒྲུབ་པའི་རྡོ་རྗེ་བཞི་ཡིས་སྒྲུབ་བྱེད་པ།",
    "རྣལ་འབྱོར་པ་གང་ཡང་རུང་བ་གང་ཞིག་ཐུན་མོང་གི་སྒྲུབ་པའི་རྡོ་རྗེ་ཆོ་ག་རྣམ་པ་བཞི་ཡིས་རང་གི་འདོད་པའི་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་འདོད་པ་དག་འདི་ལ་རབ་མཆོག་མེད་པའི་ཞེས་བྱ་བ་རྒྱུད་འདི་ལ་རབ་བམ་མཆོག་གི་དངོས་གྲུབ་ནི་སྒྲུབ་པར་བྱེད་པའི་བློ་དང་མི་ལྡན་པ་མེད་ཅེས་བྱ།",
    "ད་ནི་བཞི་པ་འབྲིང་གི་གཉིས་པ་ལ་བསྟན་པའི་ཕྱིར་ན།",
    "གང་གིས་གསང་བ་འདུས་པའི་རྒྱུད་འདི་ཉན་པ་དང་།",
    "བདག་གིས་གླེགས་བམ་ཡི་གེར་འདྲི་བ་དང་།",
    "རྣལ་འབྱོར་པ་གང་ཡང་རུང་བ་གང་ཞིག་གིས་ཞི་བའི་ལས་དང་།",
    "གང་གིས་རྟག་ཏུ་ལྟ་བར་བྱེད་དང་རིག་དང་དྲན་བྱེད་དང་།",
    "རྣལ་འབྱོར་པ་གང་ཡང་རུང་བ་གང་ཞིག་གིས་རྒྱུད་འདི་ལ་མིག་གིས་ལྟ་བར་བྱེད་པ་དང་།",
    "ལག་པས་གླེགས་བམ་ལ་རེག་པར་བྱེད་པ་དང་།",
    "རྒོལ་བ་མ་ན་རེ།",
    "རྒྱུད་ཀྱིས་ཀྱང་ལྷ་མཚོན་པར་བྱེད་པ་ལ་ལྷའི་དཀྱིལ་འཁོར་རང་བཞིན་ཉིད་ཀྱི་རྣམ་པར་སྣང་བས་གཅིག་གི་རང་བཞིན་དུ་གཅིག་དབྱེར་མེད་པར་གནས་པའི་ཕྱིར་ན་ལྷ་ལ་བསྟོད་པ་ཉིད་ཀྱིས་རྒྱུད་ལ་བསྟོད་པ་ཡིན་པར་འགྱུར་ལ་གཉིས་སུ་ན་རྒྱུད་བསྒྲུབ་ཅིང་དང་དུ་ལེན་པའི་སྒྲུབ་པ་པོ་རྣམས་ལ་བསྟོད་པ་ཉིད་རྒྱུད་ཀྱི་ཡོན་ཏན་བརྗོད་ཅིང་བསྟོད་པ་ཡིན་ནོ།",
    "གསང་བ་ཐམས་ཅད་སྟོན་པ་རྡོ་རྗེའི་བྱིན་གྱིས་རླབས་ཞེས་བྱ་བའི་ལེའུ་བཅོ་བརྒྱད་པའོ་ཞེས་བྱ་བ་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་གསང་བ་ལ་སོགས་པ་རང་བཞིན་དང་གབ་པ་དང་སྦས་པ་དང་མི་བསྟན་པའི་སྒོ་ནས་མི་རྟོགས་པ་དང་མི་ཤེས་པ་ཐམས་ཅད་ལ་བྱ་མོད་ཀྱི་གནས་སྐབས་འདིར་ནི་ཞུས་ཚིག་ལྔ་བཅུ་རྩ་དྲུག་པོ་ཐམས་ཅད་མ་ནོར་བར་སྟོན་པ་ཁོ་ན་ལ་བྱ་སྟེ།",
    "ལམ་འདིར་འཇུག་མོས་རྣམས་ལ་དགོས་ཆེད་སྐྱོན་མེད་འཐད་བསམ་ཡང་།",
    "གཏམ་འདི་ནི་བདག་གིས་དངོས་སུ་ཐོས་པ་ཡིན་གྱི།",
    "མོས་པ་སྣ་ཚོགས་བསམ་པ་ཐ་དད་པའི།",
    "དུས་གཅིག་ན་ཞེས་བྱ་བ་ནི་དུས་གཅིག་གི་ཚེ་ཁོ་ན་ཐོས་སོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "ཉོན་མོངས་པའི་བདུད་ལ་སོགས་པ་བཅོམ་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་ཤེས་རབ་ལ་རག་ལས།",
    "ཉོན་མོངས་པའི་བདུད་དེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྣམས་ནི་གཞན་དག་གི་སྤྱོད་ཡུལ་མ་ཡིན་པས་ན་གསང་བའོ།",
    "དེ་རྣམས་དང་ལྷན་ཅིག་བདག་གིས་ཐོས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་མོད་ཀྱི།",
    "དེ་རྣམས་རེ་རེ་ཉིད་རང་རང་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་ཀྱི་བདག་པོར་གྱུར་པས།",
    "དེ་ལ་གཉིས་སུ་མེད་པའི་རྡོ་རྗེ་གང་གིས་གཟུགས་ལ་ཡང་དག་པར་བལྟ་ཞིང་སོ་སོར་ཤེས་པ་དེ་ནི་དམ་ཚིག་རྡོ་རྗེ་སྟེ།",
    "དེ་བཞིན་དུ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པའི་སྒྲས་ཀྱང་ཉེ་བར་དགོད་པ་ལྔས་ཕྱག་ན་རྡོ་རྗེ་ལ་སོགས་པའི་དམ་ཚིག་གི་ཁྱད་པར་ཡིན་པའམ།",
    "འདི་དག་གིས་ནི།",
    "བརྟག་པ་འདི་ནི་ཉོན་མོངས་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དཀྱིལ་འཁོར་པ་ཉིད་ཀྱིས་ནི་མ་ཡིན་ཏེ་རྒྱུད་ལས་རང་གི་མཚན་མ་དང་།",
    "ཏིང་ངེ་འཛིན་གྱི་རང་གི་ངོ་བོ་གདོན་པ་བསྟན་པ་མེད་པའི་ཕྱིར་རོ།",
    "གོས་དཀར་མོ་དང་།",
    "ལྷ་མོ་བཞི་རིམ་བཞིན་དུ་གསུངས་པ་ཡིན་ནོ།",
    "ཡང་ན་ནང་གི་ནམ་མཁའི་ངོ་བོ་གང་ཡིན་ལ་རྡོ་རྗེ་སྟེ།",
    "དེའི་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་གྱིས་སེམས་སུ་གང་གིས་ཁྲིད་པའི་ཏིང་ངེ་འཛིན་དེ་ལ་རྡོ་རྗེ་འཆང་བ་ལྟ་བུར་སྙོམས་པར་ཞུགས་པའོ།",
    "འདོད་ཆགས་ཅན་ཕལ་ཆེར་ནི་བུད་མེད་ཀུན་དགའ་བ་ཉིད་དང་པོར་བྱེད་པ་ཡིན་ལ།",
    "བསྒྲུབ་པར་བྱ་བའི་རང་གི་རིག་པར་ཞུགས་སོ་ཞེས་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་ནས་མི་བསྐྱོད་པ་ལ་སོགས་པ་ཡང་རང་རང་གི་རིགས་དང་རྗེས་སུ་མཐུན་པར་མཱ་མ་ཀཱི་ལ་སོགས་པ་ལྟ་བུར་ཅི་རིགས་པར་བྱུང་ནས་ཞུགས་སོ་ཞེས་མཐུན་པར་ཤེས་པར་བྱའོ།",
    "འདིར་ཡང་རེག་བྱ་ལས་སྐྱེས་པ་ཉིད་བདེ་བ་ཆེན་པོ་གཙོ་བོ་སྟེ།",
    "ཇི་ལྟར་ན་རྒྱལ་བ་རྣམས་ལྷ་མོའི་གཟུགས་འཛིན་པས་ཕྱུང་ངོ་ཞེས་བྱ་བ་བྱུང་བ་ཙམ་གསུངས་ན་དེ་རྣམས་ནི་རང་གི་རིགས་པར་ཞུགས་པ་ཇི་ལྟར་གསུངས།",
    "དེ་ནི་བདེན་མོད་ཀྱི་འོན་ཀྱང་ཞུགས་པར་གྱུར་ཏོ་ཞེས་སྔར་གསུངས་པ་དེ་འདིར་ཡང་རྗེས་སུ་སྦྱར་བར་བྱ་སྟེ།",
    "ཕྱི་རོལ་ཏུ་གནས་པའི་བུད་མེད་ཀྱི་གཟུགས་ཀྱི་ཚོགས་མཆོག་ཏུ་བདེ་བའི་རྒྱུར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "ལྷ་མོའི་གཟུགས་རྣམས་འཁྱུད་པའི་རང་གི་རིགས་པའི་ནང་དུ་ཞུགས་པར་ཤུགས་ཀྱིས་ཤེས་པར་བྱའོ།",
    "ལྷ་མོ་དགུ་ནི་སྤྲོས་ནས་སུ།",
    "བཙུན་མོའི་བྷ་ག་ལ་ཞེས་བྱ་བ་ནི་བཙུན་མོ་དང་ཡང་དག་པར་འདུས་པའི་བྷ་ག་ལ་སྟེ།",
    "ལྷའི་རང་གི་ངོ་བོ་ཙམ་དུ་ངེས་པར་སྣང་བ་བསམ་པར་བྱ་བའི་འཁོར་ལོའི་ཉེ་བར་ལེན་པ་ཡིན་ནོ།",
    "སྐད་ཅིག་མ་རེ་རེའི་སྦྱོར་བ་ལ་གནས་པའི་རྟག་པར་གྱུར་པ་ཡིན་ཏེ་ཞར་ལ་འོངས་པས་ཆོག་གོ།",
    "གསོལ་བ་གདབ་པ་གཉིས་པའི་ཚིག་གི་དོན་ནི་དེ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་པ་ནི་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་དབྱངས་ལ་སོགས་པར་སྣང་བ་ཡང་དག་པར་རིག་པ་མཐར་ཐུག་པས་འབྲས་བུའི་ཚུལ་རྡོ་རྗེ་འཆང་བའི་ཡུལ་སོ་སོར་སྣང་བ་དང་བྲལ་བས་གང་གིས་བྱེད་པའི་ཏིང་ངེ་འཛིན་དེ་ནི་མི་ཕྱེད་པས་ན་རྡོ་རྗེ་སྟེ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "ཕྱེད་པའི་ཚིག་གི་དོན་ནི་ངེས་པ་མེད་པ་ཡིན་པས་ན།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པར་གྱུར་པ་ལ་ལར་རྣམ་པ་ལ་སོགས་པར་ངེས་པར་སྣང་བའི་ཚུལ་རང་གི་སེམས་སོ་སོར་རྟོག་པ་ཡི་གེ་ཨ་ནི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་རྒྱུ་སྟེ།",
    "སྟོང་པ་ཉིད་ཀྱི་རྒྱུར་གྱུར་པ་ཉིད་ཀྱིས་རང་གི་ངོ་བོ་བསྟན་པར་མི་ནུས་པའི་ཕྱིར།",
    "གྲོལ་བ་ཉིད་དུ་ཐལ་བར་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་ནི་རེ་རེ་ཞིང་ཡེ་ཤེས་ལྔའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རྡོ་རྗེའོ།",
    "གང་གིས་ཤེ་ན།",
    "ཉིད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་ལས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་མེད་ཀྱང་ཡོངས་སུ་གྱུར་པའི་བྱེ་བྲག་གིས་བསྟན་པའོ།",
    "དེ་ཉིད་དཔག་ཏུ་མེད་པའི་སྤྲུལ་པའི་གཟུགས་ཀྱི་ཐབས་ཀྱི་མཆོག་གི་འཇུག་པའི་མཛད་པས་ཁྱབ་པའི་ཕྱིར་ཏེ།",
    "ད་ནི་ལྷ་མོ་རྣམས་ཀྱི་གདོན་པ་བསྟན་པའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕུན་སུམ་ཚོགས་པའི་མཆོག་གི་རྒྱུར་གྱུར་པའི་བཙུན་མོའི་མཆོག་ནི་མཱ་མ་ཀཱི་སྟེ་དེ་ཕྱུང་ངོ་ཞེས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་དེ་དེའི་བཙུན་མོའི་མཆོག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་སྔ་མ་དང་འདྲའོ།",
    "དེ་ཉིད་ཀྱིས་ན་མོ་ཧ་ར་ཏི་ཞེས་པས་ལྷ་མོ་སྤྱན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ནོ།",
    "ཡང་ན་གང་དག་ཉིད་ཀྱིས་འགྲོ་བ་རྣམས་ཀྱི་དོན་བྱའི་གཞན་དག་གིས་ནི་མ་ཡིན་ནོ་ཞེས་ཕྲག་དོག་རྣམ་པར་དག་པའི་ངོ་བོ་རྣམ་པ་ཐམས་ཅད་དུ་བྱ་བ་སྒྲུབ་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཉིད་ནི་བཙུན་མོའི་མཆོག་ཡིན་པའམ།",
    "དེ་རྣམས་ཀྱི་བཙུན་མོའི་མཆོག་སྟེ་དེའི་བདག་ཉིད་ཅན་གྱི་ཕུན་སུམ་ཚོགས་པའོ།",
    "དཀྱིལ་འཁོར་གྱི་གནས་ཀྱི་ས་ལ་སོགས་པ་རྣམ་པར་དག་པའི་བཙུན་མོ་ཉིད་དུ་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པར་དག་པ་དང་འགལ་བར་ཐལ་བར་འགྱུར་རོ།",
    "དེའི་རང་གི་ངོ་བོ་ཉིད་གནས་པའི་རྒྱུའོ།",
    "དེ་ཉིད་ཀྱིས་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རང་གི་རིགས་ཀྱི་བདག་པོ་ནི་མི་བསྐྱོད་པ་སྟེ།",
    "དངོས་པོ་ཕྱུང་བའི་ཕྱིན་ཅི་ལོག་གི་བག་ཆགས་བཅོམ་པ་དང་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་དང་མ་བྱུང་བའི་དེ་ཁོ་ན་ཉིད་ཀྱི་བག་ཆགས་བསྐྱེད་པ་དང་གནས་པར་བྱ་བའི་ཕྱིར་བརྩོན་འགྲུས་རྣམ་པ་བཞི་སྟེ།",
    "དེའི་དཀྱིལ་འཁོར་ནི་གསུང་གི་དཀྱིལ་འཁོར་རོ།",
    "གསུང་གི་དཀྱིལ་འཁོར་དང་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་དེ་རྣམས་མཉེས་པར་བྱེད་པའི་ཕྱིར་ཐུན་མོང་གི་དམ་ཚིག་སེམས་དཔའ་ནི་བགེགས་མཐར་བྱེད་དོ།",
    "ཅིག་ཤོས་དག་ཀྱང་རང་རང་གི་དཀྱིལ་འཁོར་མཉེས་པར་བྱེད་པའི་ཕྱིར་དམ་ཚིག་སེམས་དཔར་འགྱུར་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་དད་པས་བཀུག་ལ་དད་པ་དང་ལྡན་པ་ནི་བརྩོན་འགྲུས་རྩོམ་མོ།",
    "དེ་ལྟར་ན་བཞི་པོ་ནི་དམ་ཚིག་གི་སེམས་དཔའ་ཡིན་ནོ།",
    "དངོས་པོ་འདི་རྣམས་ཞེས་བྱ་བ་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་གྱི་དངོས་པོ་རྣམས་སོ།",
    "དེ་ལྟ་ན་ནི་མེད་པའི་སྟོང་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཉིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གཟོད་ནས་དག་པ་ཞེས་བྱ་བ་ནི་བྱ་བ་སྒྲུབ་པའི་ཡེ་ཤེས་ཀྱི་རང་གི་ངོ་བོས་གདོད་མ་ཉིད་ནས་དག་པ་ཡིན་གྱི་ད་ལྟར་ནི་མ་ཡིན་ནོ།",
    "སྣའི་རྩེ་མོ་ཞེས་བྱ་བ་ནི་ལྷ་མོའི་གསང་བའི་ཆུ་སྐྱེས་ཀྱི་སྣ་རྩེའོ།",
    "ཡང་ན་རང་གི་མཚན་མ་ཕྲ་མོ་ནི།",
    "ཚིགས་སུ་བཅད་པ་གསུམ་པས་ནི་གསུང་གི་དཀྱིལ་འཁོར་སྤྲུལ་པར་གསོལ་བ་བཏབ་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་གཟུགས་ཅན་ནོ།",
    "གང་འདི་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་རྣམ་པར་དག་པ་གསུམ་དང་ལྡན་པས་སྐུ་ལ་སོགས་པའི་རང་གི་ངོ་བོ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "བརྟག་པ་ལ་སོགས་རང་གི་དངོས།",
    "དེ་མཐོང་བས་ཐོས་པ་དང་མི་ལྡན་པ་རྣམས་གལ་ཏེ་མི་ཤེས་པར་འགྱུར་བ་སྲིད་པས་ན་ངན་འགྲོར་འགྲོ་བར་ཐལ་བར་འགྱུར།",
    "དེ་རྣམས་རང་གི་གདན་ལ་ཅི་ལྟ་བ་བཞིན་དུ་བྲི་བར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "བུད་མེད་རབ་ཏུ་མདངས་བཟང་བ།",
    "ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་ལས་གྲོལ་བས།",
    "པད་ནང་དང་གི་ས་བོན་འོད་རྣམས་ཀྱིས།",
    "དེ་ཡང་གང་གི་ཕྱིར་ལུས་ལ་སོགས་པ་དམིགས་པ་ན།",
    "ད་ནི་ཕྲ་མོའི་རྣལ་འབྱོར་ཁ་བསྐང་བའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དང་པོར་གྱུར་པས་རྡོ་རྗེ་འཛིན་པ་ཕྲ་མོའི་སྦྱོར་བ་ཡང་དག་པར་བརྩམ་པར་བྱའོ།",
    "སྣའི་རྩེ་མོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "འདིའི་འོག་མ་རྣམས་ལ་ཡང་ས་བོན་དགོད་པ་རང་གི་ཇི་ལྟ་བ་བཞིན་དུ་སྦྱར་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་འདྲེས་པ་ལ་སོགས་པ་བསྒོམས་པའི་རྗེས་ཐོགས་ལ་ས་བོན་ཡོངས་སུ་གྱུར་པ་ལས་རང་གི་ལྷ་གདོན་པར་བྱའོ།",
    "ཨུཏྤལ་མཐིང་གའི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བདག་པོའི་ལྷའི་མཚན་མ་ལ་ཕྲ་མོའི་རྣལ་འབྱོར་བྱའོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "རང་གི་མཚན་མ་ཕྲ་མོ་ནི།",
    "སློང་མོ་ཟ་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བརྟུལ་ཞུགས་ཀྱི་ཚུལ་གྱིས་སློང་མོ་དགག་པ་སྟོན་ཏོ།",
    "རང་གི་རིགས་ཞེས་བྱ་བ་ནི་སྔ་མ་ཡང་ཤེས་པར་བྱའོ།",
    "དག་པའི་སེམས་དཔའ་རང་གི་ལྷའི།",
    "སྔར་མཐོང་བའི་དོན་ལ་ཕྲ་མོའི་རྣལ་འབྱོར་གྱི་གནས་སྐབས་སུ་མཚན་མ་རྣམ་པ་ལྔ་བྱུང་ནས།",
    "ཡི་གེ་ཧཱུཾ་གིས་རྡོ་རྗེ་པདྨ་འདབ་མ་བརྒྱད་པར་གྲུབ་པ་ལ་བརྟག་པར་བྱའོ།",
    "རང་གི་ཁུ་བའི་ཐིགས་པ་ཡིས།",
    "རང་གི་ཁུ་བ་དག་དབྱུང་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "དམ་ཚིག་ནི་རང་གི་སོ་སོར་སྣང་བའོ།",
    "གང་གཞན་ཕྲ་མོ་ཞེས་བྱ་བ་ནི་རིག་པ་འཛིན་པ་དང་མི་སྣང་བ་ལ་སོགས་པའི་དངོས་གྲུབ་རྣམས་སོ།",
    "ཆོ་ག་ཤེས་པས་ཞེས་བྱ་བ་ནི་ལྷ་མོ་བསྐྱེད་པའི་ཡན་ལག་བཞི་ལ་སོགས་པའི་ཆོ་ག་ཤེས་པའོ།",
    "བདག་གི་བ་སྤུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཨུཏྤལ་ཞེས་བྱ་བ་ནི་ཐབས་ཀྱི་ཆ་རྣམ་པ་ལྔའོ།",
    "ལྷ་མོ་དགུ་དང་ནམ་མཁའི་དབྱིངས།",
    "དེའི་དབུས་སུ་བདག་གི་ལུས་དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་དུའོ།",
    "པདྨ་འི་ནང་གི་ས་བོན་འོད་རྣམས་ཀྱིས།",
    "དེ་ལྟར་ན་འདི་ནི་ཞེ་སྡང་གི་རིགས་ཀྱི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "གཏི་མུག་ལ་སོགས་པའི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་འདི་ནི་ཞེ་སྡང་གི་རིགས་ཀྱི་རྣལ་འབྱོར་པ་རྣམས་ལ་ཡང་དགག་པ་མེད་པ་ཡིན་ནོ།",
    "ནམ་མཁའ་གསུང་ཞེས་བྱ་བ་ནི་གསུང་གི་རང་བཞིན་གྱི་དམིགས་སུ་མེད་པའི་ཡེ་ཤེས་སོ།",
    "ཚིག་རྩུབ་མོ་སྨྲ་བ་ལ་སོགས་པའི་རྣམ་པར་དག་པ་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "སོགས་པའི་སྒྲ་ལ་སོགས་པ་འདི་དག་གིས་ནི་སྟོང་པ་ཉིད་དུ་རྩོད་པ་ལ་སོགས་པ་བཟུང་སྟེ།",
    "དེ་ལྟར་ན་འདིས་ནི་ངག་གི་ལས་རྣམ་བཞི་རྣམ་པར་དག་པ་གསུངས་ནས་སེམས་རྣམ་པར་དག་པ་ནི་ལུས་དང་ངག་གི་ལས་ཡིན་ལ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་རྡོ་རྗེ་ནི་གདོན་མི་ཟ་བར་གྲུབ་པའོ།",
    "རྟེན་དང་བརྟེན་པ་པོར་གྱུར་པས་མཉམ་པ་ཉིད་དུ་གྱུར་པ་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གསུང་གི་སྒོ་ནས་ཀྱང་སྔགས་རྣམ་པར་དག་པ་གསུང་ས་པ་ནི་ཚིག་གི་ལམ་ངེས་པར་བརྗོད་པ་ཞེས་བྱ་སྟེ།",
    "ཚིག་གི་ཉེ་བར་དགོད་པས་གསུངས་པའོ།",
    "སྔགས་འདི་ལྷ་མོ་དང་རྡོ་རྗེ་ཅན་གྱི་རྣལ་འབྱོར་པས་བཟླས་ན།",
    "རང་གི་གཟུགས་སུ་ཞེས་བྱ་བ་ནི་ཡི་གེ་ཧཱུཾ་ཡོངས་སུ་གྱུར་པའི་རྡོ་རྗེའི་གཟུགས་དང་གཅིག་ཏུ་བྱས་པའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གསུངས་པའི་ཐུན་མོང་གི་བསྙེན་པའི་དོན་དུ་པདྨ་འི་ནང་དུ་དཀྱིལ་འཁོར་སྤྲུལ་པ་གསུངས་པ་ནི་རང་གི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རང་སྔགས་ཀྱིས་ཞེས་བྱ་བ་ནི་བདག་པོའི་ས་བོན་ཉིད་ཀྱིས་རང་གི་དཀྱིལ་འཁོར་སྤྲུལ་པ་ཡིན་གྱི་ལྷ་རྣམས་ཀྱི་སོ་སོའི་ས་བོན་གྱིས་ནི་མ་ཡིན་ཏེ།",
    "ཐ་མི་དད་པར་ཉེ་བར་བཟུང་བ་ལ་ཐ་དད་པར་ཐལ་བར་འགྱུར་ཞིང་སྔགས་གཅིག་བཟླས་པས་ཐམས་ཅད་ཀྱི་སྔགས་བཟླས་པར་མི་འགྱུར་བའི་ཉེས་པར་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་དཀྱིལ་འཁོར་པ་ཡི་གཟུགས་བསམས་ལ།",
    "རང་སྔགས་སྐྱེས་བུ་ཞེས་བྱ་བ་ནི་རང་གི་ས་བོན་གྱིས་བདག་ཉིད་ཅན་གྱི་སྐྱེས་བུ་བསམས་ལ།",
    "གནས་བཞི་རྣམས་སུ་ཞེས་གསུངས་པ་ནི་ལྷ་མོའི་ལྟེ་བ་དང་།",
    "འདི་དག་གིས་ནི་ཕྱག་རྒྱ་བཞི་གསུངས་པ་ཡིན་ནོ།",
    "ཕྲ་མོའི་དཀྱིལ་འཁོར་རྣམས་ནི་ཞེས་བྱ་བ་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་ཡེ་ཤེས་སེམས་དཔའི་དཀྱིལ་འཁོར་དུ་བསམ་པའོ།",
    "དབུས་སུ་བསམ་པར་བྱ་བ་ནི་རང་རང་གི་ས་བོན་གྱི་ཡི་གེ་སྟེ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གྱུར་པའི་ཚིག་བསམ་པར་བྱའོ།",
    "རྗེས་སུ་མཐུན་པའི་ས་བོན་ཡོངས་སུ་གྱུར་པའི་མཚན་མ་ཕྲ་མོ་བསྟན་པའི་ཕྱིར་གསུངས་པ་ནི་རྡོ་རྗེ་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འདི་དག་ཀྱང་མཆོག་གི་བསྙེན་པ་ཉིད་ཡིན་ནོ།",
    "དངོས་གྲུབ་ཕྲ་མོའི་ཁྱད་པར་ལས་དུམ་བུ་བསྟན་པའི་ཕྱིར་དབེན་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེར་རང་གི་སྔགས་ཀྱི་དམ་ཚིག་ནི་རྣམ་པར་སྣང་མཛད་དེ་དེ་སྐྱེད་པའི་ཆོ་གས་བསྐྱེད་ལ།",
    "སྔར་ཡོངས་སུ་རྫོགས་པ་ནི་ཏིང་ངེ་འཛིན་གསུམ་གྱི་རྣལ་འབྱོར་པ་གང་གི་མཚན་མས་ཀྱང་ཕྱིས་ཉེ་བར་སྒྲུབ་པ་ལ་སོགས་པ་དང་བྲལ་བའི་ཕྱག་རྒྱ་གཅིག་དང་ལྡན་པའི་ལྷ་ཉིད་གཅིག་པུ་སྙོམས་པར་འཇུག་པ་མ་ཡིན་པའི་ཆོ་ག་བཞིན་དུ་བསྒོམས་པ་ལས་སྐུ་རྡོ་རྗེ་བརྟག་པ་ལས་ཇི་སྐད་དུ་གསུངས་པའི་ཕན་ཡོན་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེར་སྔགས་ཀྱི་སྐྱེས་བུ་འོད་དཔག་ཏུ་མེད་པ་ཆོ་ག་བཞིན་དུ་བསྐྱེད་ལ་དེའི་ངག་གི་ལམ་སྟེ།",
    "རང་སྔགས་ཞེས་བྱ་བ་རང་གི་ས་བོན་ཡོངས་སུ་གྱུར་པའི་འཁོར་ལོ་གནས་ལྔའི་སྦྱོར་བས་བསམ་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འདིའི་འོག་མ་རྣམས་ལ་ཡང་ཕྲ་མོའི་མི་བསྐྱོད་པ་ལ་སོགས་པ་ལ་སྦྱར་བར་བྱའོ།",
    "འགོག་པའི་རྡོ་རྗེ་ཡེ་ཤེས་ཞེས་བྱ་བ་ནི་མི་གཡོ་བའི་དམ་ཚིག་གི་ཡེ་ཤེས་སོ།",
    "རང་གི་ས་བོན་ལས་བསྐྱེད་པ།",
    "འཁོར་ལོའི་དངོས་གྲུབ་གསུངས་པ་ནི་འཇམ་པའི་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རང་གི་སྔགས་ཀྱིས་ཞེས་བྱ་བ་ནི་འཁོར་ལོ་ཅན་གྱི་ལྷའི་སྔགས་དང་།",
    "འཁོར་ལོ་ཆེན་པོའི་རིགས་ཞེས་བྱ་བ་ནི་འཁོར་ལོའི་རིགས་ཀྱི་རྒྱུད་དང་ལྡན་པའི་ལྷ་རྣམས་ཀྱང་འདི་བཞིན་དུ་བསྒོམས་ལ་མཚན་མ་འདི་བསྐྱེད་ཅིང་དེ་འཛིན་པ་ལ་སོགས་པས་ཡེ་ཤེས་མཆོག་སྟེ་མཆོག་གི་ཡེ་ཤེས་ཀྱི་སྒྲུབ་པ་ཡིན་ནོ།",
    "དེ་ལྟ་མོད་ཀྱི་རྣམ་པར་སྣང་མཛད་ནི་ཉེ་བར་མཚོན་པའི་དོན་ཙམ་དུ་གསུངས་པ་ཡིན་ཏེ་རྣམ་པར་སྣང་མཛད་གཙོ་བོར་གྱུར་པའི་འཁོར་ལོ་ཆེན་པོ་བསམས་ལ།",
    "དགུག་པའི་ལྕགས་ཀྱུ་དང་ལྡན་པའི་རྒྱལ་བ་དེ་དག་གིས་གནས་བསམས་ནས་དགུག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་སྟོན་ཏོ།",
    "གཞན་དག་གིས་ཀྱང་འགྱུར་རོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་རྡོ་རྗེ་པདྨོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དབུ་རྒྱན་ལ་རང་གི་རིགས་ཀྱི་བདག་པོ་འཆང་བའི་སྐུ་རྡོ་རྗེར་བདག་ཉིད་རྣམ་པར་བསྒོམས་ལ་ཚིམ་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ལྕེ་རྣམ་པར་དག་པ་གསུངས་པ་ནི་རྡོ་རྗེའི་སྦྱོར་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ལྕེའི་གནས་སུ་ཟླ་བ་ལ་གནས་པའི་ཡི་གེ་ཧཱུཾ་ཡོངས་སུ་གྱུར་པས་ཧཱུཾ་གིས་བྱིན་གྱིས་བརླབས་པའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་བསམས་ཏེ།",
    "དེའི་ནང་དུ་དམ་ཚིག་གི་བཟའ་བར་བྱ་བའི་རྫས་གཞག་པར་བྱའོ་ཞེས་ཤེས་པར་བྱའོ།",
    "གྲུབ་པ་ནི་མུ་སྟེགས་པའི་རྒྱུད་གཞན་དག་གི་མན་ངག་གིས་གྲུབ་པ་ལས་གཙོ་བོར་གྱུར་པའོ།",
    "རང་སྔགས་ཀྱི་རྡོ་རྗེ་ཅན་གྱི་བདག་པོའི་གཟུགས་ཕྱག་རྒྱ་ཆེན་པོ་རང་གི་དབུ་རྒྱན་ལ་བསམས་ན་ཡེ་ཤེས་རྡོ་རྗེ་སྟེ་རྣལ་འབྱོར་པས་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་རིགས་ཀྱི་གཙོས་བརྒྱན་ཅོད་པན་གྱུར།",
    "དེ་ཉིད་གང་གི་ཡུལ་ཡིན་པ་དེ་ལ་ནི་འདི་སྐད་ཅེས་བྱའོ།",
    "རྫོགས་ནས་ཞེས་བྱ་བ་ནི་སྔགས་བརྗོད་པའི་མཐར་སྐུ་ལ་སོགས་པ་དེ་རྣམས་རང་རང་གི་གནས་རྣམས་སུ་བསྡུ་བར་བསམ་པར་བྱའོ།",
    "གསུང་གི་བཟླས་པ་གསུངས་པ་ནི།",
    "རང་གི་རྡོ་རྗེའི་དཀྱིལ་འཁོར་གྲགས།",
    "ཞེས་བྱ་བ་ནི་འདོད་པའི་དོན་གྱིས་ཉོན་མོངས་པར་གྱུར་ཅིང་མྱོས་པར་གྱུར་པའོ།",
    "མ་ནིང་དག་གི་གནས་ཞེས་བྱ་བ་ནི་སྐྱེས་པ་དང་བུད་མེད་དག་གི་གནས་སྐབས་དང་བྲལ་བའི་ཡེ་ཤེས་ཀྱི་གནས་སོ།",
    "ཞེ་སྡང་གནས་ཞེས་བྱ་བ་ལ་འདིའི་དོན་ནི་ཁྲོས་པའི་གནས་སྐབས་སུ་ཞེ་སྡང་གི་ངོ་བོ་ཉིད་ལས་སྐྱེས་པ་སྟེ་མི་བསྐྱོད་པའི་རིགས་ལས་སྐྱེས་པ་ནི་མ་ཡིན་ནོ།",
    "སྐུ་གསུམ་རྡོ་རྗེའི་བྱེ་བྲག་གིས།",
    "སྤྱན་ཡང་སྤྲོ་བའི་དུས་སུ་རང་གི་དཀྱིལ་འཁོར་གྱི་བདག་པོ་དང་ལྡན་པར་སྤྲོ་བར་བྱེད་དེ།",
    "ད་ནི་ལས་རྣམ་པ་བཞི་བསྟན་པའི་ཕྱིར་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་སྒྲུབ་པ་རེ་ཞིག་བསྟན་པའི་ཕྱིར།",
    "ཁ་བཞི་པ་ཞེས་བྱ་བ་ནི་མདུང་རྩེ་མོ་གཅིག་ལ་རྩེ་མོ་བཞིས་བསྐོར་བར་གནས་པའི་ཁ་བཞི་པར་འགྱུར་བ་ལ་བྱའི་སྣ་ཚོགས་རྡོ་རྗེ་ཡིན་པར་གཟུང་བར་མི་བྱའོ།",
    "དེ་ལས་གཞན་དག་པས་ཀྱང་རང་རང་གི་མཚན་མ་ཡོངས་སུ་གྱུར་པ་ཉིད་ལས་བྱུང་བ་ཡིན་ནོ།",
    "རང་གི་འདོད་པའི་ལྷའི་ཡོན་ཏན་ནམ།",
    "རང་གི་སྔགས་ཀྱིས་ཡི་གེའི་གནས་ཀྱི་རྡོ་རྗེའི་ནང་དུ་ཆུད་པ་སྤྲོ་བ་ལ་སོགས་པའི་ཚུལ་གྱིས་བསམས་ལ་དེ་དང་གཅིག་པར་ང་རྒྱལ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡི་གེ་ཧཱུཾ་ཡོངས་སུ་གྱུར་པའི་ཕུར་བུ་སྟོད་རྩེ་མོ་ལྔ་དང་ལྡན་པ་འོག་རྩེ་གཅིག་པ་སོར་བརྒྱད་པའི་ཚད་དུ་བསམས་ལ།",
    "བར་སྣང་ལ་རྡོ་རྗེ་རྩེ་མོ་ལྔ་པ་དེ་བཞིན་གཤེགས་པ་ལྔའི་བདག་ཉིད་ཅན།",
    "ཞི་བའི་ལས་ཀྱི་དབྱེ་བ་གསུངས་པ་ནི་མདངས་བཟང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ཟླ་བ་ལ་གནས་པའི་རྣམ་པར་སྣང་མཛད་དང་ལྷ་མོ་རྡོ་རྗེ་ཅན་ཨོཾ་ཨཱ་ཛི་ན་ཛིཀ་ཆེ་གེ་མོ་ཤཱནྟིཾ་ཀུ་རུ་ཧཱུཾ་ཞེས་བྱ་བའི་སྔགས་ཟློས་པའམ་གདོན་པའི་སྔགས་ལ་གནས་པའམ།",
    "རང་གི་ས་བོན་གྱི་ཡི་གེ་གཅིག་ཏུ་ཟློས་པར་བསམས་ལ།",
    "སྤྱན་གྱི་རྣམ་པར་སྤྲོས་པ་རྣམས་ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནེ་སརྦྦཱ་རྠ་སཱ་དྷ་ནི་ཆེ་གེ་མོའི་ཤཱནྟིཾ་ཀུ་རུ་སྭཱ་ཧཱ་ཞེས་བྱ་བའི་སྔགས་ཟློས་པ་རྣམས་ཀྱིས་སམ།",
    "རང་གི་ས་བོན་ཟློས་པ་རྣམས་ཀྱིས་ནམ་མཁའི་ཁམས་གང་བ་བསམ་པར་བྱའོ།",
    "དེ་ནས་དེ་རྣམས་ཡང་དག་པར་བསྡུས་ནས་སྤྱན་ལ་སོགས་པ་བདུད་རྩིར་གྱུར་པའི་འོད་ཟེར་གྱི་གོང་བུའི་གཟུགས་ཀྱིས་ནང་གི་ཡན་ལག་ཚིམ་ཞིང་རྒྱས་པར་བྱ་བའི་ཕྱིར་དབབ་པར་བྱའོ།",
    "ཨོཾ་ཨཱ་ཨཱ་རོ་ལྀཀ་ཆེ་གེ་མོའི་པུཥྚིཾ་ཀུ་རུ་ཧཱུཾ་ཞེས་བྱ་བའི་སྔགས་ཟློས་པའི་ལྷའི་འཁོར་ལོ་དང་ལྡན་པ་བསམས་ལ་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ཟླ་བ་ལ་རྒྱས་པ་དོན་དུ་གཉེར་བ་གཞག་པར་བྱའོ།",
    "གོས་དཀར་མོ་ལ་སོགས་པ་སྤྲོས་པ།",
    "སྤེལ་བའི་རང་རང་གི་དབྱུག་པའི་སྔགས་ཟློས་ཤིང་།",
    "འདི་དག་གིས་ནི་སྒྲའི་བདག་ཉིད་ཅན་གྱི་སྔགས་སྤྱན་གཉིས་ཐ་མི་དད་པར་གསུངས་པ་ཡིན་ནོ།",
    "ཤི་བ་སོས་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་སྤྱན་གྱི་སྦྱོར་བ་ཆོ་ག་བཞིན་དུ་བྱས་ལ་རང་གི་སྔགས་དང་བསྒྲུབ་པར་བྱ་བའི་མིང་དང་སྤེལ་ཞིང་ཡི་གེ་གསུམ་གྱི་ནང་དུ་ཆུད་པར་བཟླས་ལ།",
    "མོ་ཧ་ར་ཏི་ཞེས་བྱ་བའི་སྔགས་བཀོད་ནས།",
    "སྔགས་ཀྱི་འོད་ཟེར་རྣམས་ཀྱིས་ལུས་དེ་མི་སྣང་བར་བྱས་ལ་བསྒྲུབ་པར་བྱ་བ་དེའི་མིང་གི་ཡི་གེ་དང་པོ་ལས་བསྐྱེད་པ་སྤྱན་ལྟ་བུར་ཡོངས་སུ་གྱུར་པར་བསམས་ལ།",
    "གལ་ཏེ་རོ་ལངས་ལ་སོགས་པ་བསྒྲུབ་པ་ལ་ནི་རང་གི་ལྷའི་སྦྱོར་བ་དང་ཇི་ལྟ་བ་བཞིན་དུ་ལྡན་པས།",
    "རང་གི་མགོ་ལ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པའི་ཡི་གེ་ཧཱུཾ་ལས་བྱུང་བའི་རྡོ་རྗེ་བསྒྲེང་ནས་གནས་པ་མགོ་བོར་བསམས་ལ།",
    "དེ་ཡང་ཇི་ལྟར་གདན་སེར་པོ་ལ་སོགས་པའི་གོས་དཀར་མོའི་སྦྱོར་བ་བྱས་ལ།",
    "བུད་མེད་ནི་པདྨར་ཡང་དག་པར་བསྐུལ་ལ།",
    "ཡེ་ཤེས་ཀྱི་ལྷ་མོའི་པདྨའི་ལམ་ནས་ཞུགས་པར་གྱུར་པར་བསམས་ལ་བཟླས་བརྗོད་བྱའོ།",
    "རང་གི་རྐང་པའི་དྲུང་དུ་འབབ་པར་གྱུར་པར་བསམ་མོ།",
    "བུད་མེད་ཀྱི་པདྨ་ཕུག་ལ་ལྷག་མ་རྣམས་ནི་སྔ་མ་བཞིན་དུ་བྱའོ་ཞེས་ཁྱད་པར་དུ་བྱ་བ་དག་དཔག་པར་བྱའོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་བུད་མེད་ཀྱི་ཐོད་པ་བླངས་ལ།",
