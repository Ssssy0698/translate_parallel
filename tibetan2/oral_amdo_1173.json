    "ཆེ་གེ་མོའི་ཀཱ་ཡ་བཱཀ་ཙིཏྟ་ཞེས་བྱ་བ་འདི་ལྟར་ཡང་སྤེལ་བར་བྱའོ།",
    "དེ་ལྟ་བུའི་སྦྱོར་བ་ནི་བགེགས་མཐར་བྱེད་དམ་གཞན་དག་གི་སྦྱོར་བ་བྱས་ལ།",
    "སེང་ལྡེང་ངམ་ལྕགས་ལས་བྱས་པའི་ཕུར་བུ་སྟོད་བགེགས་ཀྱི་དགྲའི་གཟུགས་སྨད་རྩེ་མོ་ཅན་གྱི་གཟུགས་སུ་བསམས་ལ།",
    "འདི་དག་གིས་ནི་རེ་ཞིག་ལྷ་རྣམས་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ལྷ་འཇིག་རྟེན་ལས་འདས་པའི་ཕུར་བུས་གདབ་པར་བྱ་བ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་སྐུའི་རྣམ་པར་འཕྲུལ་བ་ལ།",
    "རེ་ཞིག་མི་བསྐྱོད་པའི་རིགས་ཀྱི་ཆོ་ག་གསུངས་པ་ནི་སྨེ་ཤ་ཅན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་ལྟར་བྱས་པའི་དཀྱིལ་འཁོར་དུ་གཞལ་ཡས་ཁང་དུ་མོས་པར་བྱའོ།",
    "དམ་ཚིག་གི་དཀྱིལ་འཁོར་ལ་སོགས་པ་འདི་དག་ནི་རིགས་གསུམ་ཆར་ལ་ཡང་སྦྱར་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་མི་བསྐྱོད་པ་ལ་སྨེ་ཤ་ཅན་གྱི་བུ་མོ་དང་སྦྱར་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་རིགས་ལ་སྨེ་ཤ་ཅན་གྱི་བུ་མོ་དང་སྦྱོར་རོ།",
    "སྦྱོར་བའི་ཆོ་ག་ཞེས་བྱ་བ་ནི་གཙོ་བླག་མཁན་གྱི་བུ་མོ་ཕང་པར་བཞག་པ་ལ་སོགས་པའོ།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་ལྷ་མོ་བཅུ་འབྲས་བུར་གྱུར་པ།",
    "སྨེ་ཤ་ཅན་གྱི་བུ་མོ་ལ་སོགས་པ་མེད་དུ་ཟིན་ཀྱང་གཞན་དག་གཟུང་བ་ལ་འགལ་བ་མེད་པར་གསུངས་པ་ནི།",
    "དེ་ལྟ་བུའི་མཆོག་གི་སེམས་ཀྱིས་ཉི་མ་མ་ནུབ་པ་ནས་སྒྲུབ་པ་ཀུན་དུ་བརྩམས་ནས།",
    "བི་ཀྲྀ་ཏཱ་ནན་བུ་མོ་ཆེ་གེ་མོ་སྟཾ་བྷ་ཡ་ཧཱུཾ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "དེས་ན་དེ་རེངས་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོའི་ཉིན་ཞག་གང་ཡང་རུང་བ་ལ་གཤིན་རྗེ་གཤེད་ཀྱི་རྣལ་འབྱོར་པས་དུར་ཁྲོད་ཀྱི་སོལ་བ་ལ་བཟླས་བརྗོད་སྟོང་རྩ་བརྒྱད་བྱས་པས་བདག་ཆེ་གེ་མོ་སྩོལ་ཅིག་ཅེས་བྱ་བའི་བསྐུལ་བའི་ཚིག་དང་བཅས་པའི་སྔགས་སྲིན་པོ་ལ་སོགས་པའི་མིང་དང་བཅས་པ་བྲིས་ནས།",
    "མགུལ་པར་རི་མོ་བྲིས་ན།",
    "མདུན་དུ་ལྷག་པར་མོས་པའི་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་བསྣུན་ན་ངེས་པར་བཅོམ་པར་འགྱུར་རོ།",
    "ཧཱུཾ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཁྲོ་བོའི་རྣལ་འབྱོར་པས་རང་གི་ལག་པར་འོད་ཟེར་གྱི་ཚོགས་འཕྲོ་བའི་རྡོ་རྗེ་ཧཱུཾ་ལས་བྱུང་བ།",
    "ཧཱུཾ་དང་བཅས་པ་རྩེ་མོ་ལྔ་པ་རྡོ་རྗེ་འབར་བ་བསྒོམས་ལ།",
    "ཧཱུཾ་ལས་བྱུང་བའི་སྟ་རེ་བསམས་ནས།",
    "ཡི་གེ་ཧཱུཾ་གིས་བྱིན་གྱིས་བརླབས་པ་བྲིས་ལ།",
    "པདྨ་དང་རྡོ་རྗེ་དག་གི་རྣམ་པར་དག་པ་གསུངས་པ་ནི་པདྨོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "སྨེ་ཤ་ཅན་ལ་སོགས་པའི་བུ་མོའམ་རང་གི་རིགས་གང་ཡང་རུང་བ་ལ་པདྨར་རྡོ་རྗེ་ཞུགས་པས་རབ་ཏུ་རྒྱས་པར་བྱས་ལ།",
    "དེ་སྐད་དུ་ཧཱུྃ་གིས་པདྨ་འདབ་བརྒྱད་རྣམ་པར་སྤྲུལ་ཞེས་བྱ་བ་དང་།",
    "ཧཱུཾ་གིས་རྡོ་རྗེ་ལས་བྱུང་དྲི་མེད་པའི།",
    "ཆོ་ག་བཞིན་ཞེས་བྱ་བ་ནི་བསྐྱེད་པ་ལ་སོགས་པའི་རིམ་གྱིས་སྦྱངས་པའི་རང་གི་རིགས་ཀྱི་བུ་མོ་མཚན་ཉིད་དང་ལྡན་པ་རྙེད་ན།",
    "རང་གི་རིགས་ཀྱི་བུ་མོ་དང་སྙོམས་པར་ཞུགས་པའི་འཁོར་ལོ་ཅན་ཏེ།",
    "རང་རང་གི་རིགས་ཀྱི་བདག་པོ་རྣམས་གཞག་པར་བྱའོ།",
    "ཁྲོ་བོ་བཅུ་པོ་རྣམས་ལ་རང་རང་གི་བདག་པོ་དེ་ཉིད་གཞག་པར་བྱའོ།",
    "རིག་པའི་རྒྱལ་མོ་ནི་རིག་འཛིན་མ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་ཇི་ལྟར་ལྷག་པར་མོས་པས་ཨཱ་ལས་བྱུང་བའི་འོད་དཔག་ཏུ་མེད་པར་སྣོད་བསམས་ལ།",
    "དེ་ནས་བབས་པའི་རང་གི་ལྕེ་ལ་ཡི་གེ་ཨཱ་དམར་པོ་རྣམ་པར་འཕྲོ་བ་བསམས་ལ།",
    "ད་ནི་ཅུང་ཟད་ཡེ་ཤེས་བབས་པས་བུ་མོ་དང་ཁྱེའུ་ལོ་བཅུ་གཉིས་པ་དཀྱིལ་འཁོར་གྱི་ཁང་བུར་བཅུག་ནས།",
    "བུ་མོ་ལོ་གྲངས་བཅུ་གཉིས་མའམ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "འདི་རྣམས་དང་ལྷན་ཅིག་པ་ཉིད་ཀྱིས་ཅི་རིགས་པར་དེར་སྤྱོར་བ་རེ་རེ་དང་རིམ་བཞིན་དུ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཆེ་གེ་མོ་རཀྵ་སེ་གྲ་ཧ་ཡ་ཞེས་བྱ་བའི་བསྐུལ་ཚིག་དང་བཅས་པར་སྔགས་བཟླས་པར་བྱའོ།",
    "རང་གི་ལུས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྐུ།",
    "ཡང་ན་བདག་གི་སྔགས་རྒྱལ་གྱིས།",
    "རང་གི་ངོ་བོ་བཟློག་པ་མིན།",
    "ནམ་མཁའ་ལ་ཡང་བ་ནི་ཐམས་ཅད་དུ་སོང་བའོ་ཞེས་བྱ་བ་ལས་གོས་པ་གཟུང་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "རང་གི་སྐུ་ཡི་དཀྱིལ་འཁོར་གནས།",
    "ད་ནི་ལྷ་གཞན་དག་གི་དཀྱིལ་འཁོར་དག་ཀྱང་བསྒྲེས་ནས་བསྟན་པའི་ཕྱིར་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་གང་གི་གཟུགས་བྲིས་པ་དཀྱིལ་འཁོར་དེ་ཉིད་ཀྱི་ཡིན་པར་འགྱུར་རོ།",
    "ཁྱེའུ་དང་བུ་མོ་ལ་སྔགས་ཀྱི་ལྷ་རྣམ་པར་སྣང་མཛད་དང་སྤྱན་ཕབ་སྟེ།",
    "སྒོ་སྲུང་གསུམ་པོ་གཞན་དག་གིས་ཀྱང་གཞུག་པ་དང་།",
    "དེ་ནི་རང་གི་འཁོར་ལོ་གསལ་བསྒོམས་ཏེ།",
    "ལས་དང་པོ་པའི་རྣལ་འབྱོར་པས་ཐིག་གདབ་པའི་ཆོ་ག་གསུངས་པ་ནི་ཐིག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རང་བྲིས་པ་ནི་རང་རང་གི་མཚན་མས་མཚན་པ་དང་།",
    "ཨ་མྲ་ལ་སོགས་འདབ་མར་ལྡན།",
    "སྦྱིན་སྲེག་གི་ཆོ་ག་གསུངས་པ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་ཇི་ལྟར་ལྷག་པར་མོས་པར་བྱས་པའི་ཏིང་ངེ་འཛིན་གྱིས་སོ།",
    "དམ་ཚིག་གི་མཆོག་རྣམས་ནི་ཞེས་བྱ་བ་ནི་སྤྱན་ལ་སོགས་པས་སོ།",
    "དགོད་པར་བྱ་ཞེས་བྱ་བ་ནི་ཡི་གེ་གསུམ་མོ།",
    "དེ་ཡང་རང་གི་སྦྱོར་བ་ལ།",
    "སྡུག་བསྔལ་དྲག་པོ་འབྱིན་པའི་མདུང་རྩེ་ཆེན་པོ་ལ་སོགས་པས་དྲག་ཤུལ་གྱི་མངག་གཞུག་པ་དེ་ཇི་ལྟར་ལྷག་པར་མོས་པ་ལྟ་བུར་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་ཕྱིར།",
    "དམ་ཚིག་བཞི་པོ་ཡང་ཐུན་མོང་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་དམ་ཚིག་བསྐུལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "མདའ་ལ་དབུ་རྒྱན་གྱི་རྩེ་མོར་ཞུགས་པའི་ཁུ་ཚུར་བཟུང་ལ།",
    "ཨོཾ་གྱིས་བྱིན་གྱིས་བརླབས་པའི་མིག་གིས་དཀྱིལ་འཁོར་དེ་བསྟན་པར་བྱའོ།",
    "གནོད་སྦྱིན་མོ་སྒྲུབ་པའི་ཆོ་ག་གསུངས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "ལས་གསུམ་རྡོ་རྗེའི་བྱེ་བྲག་གིས།",
    "ལས་གསུམ་རྡོ་རྗེའི་བྱེ་བྲག་གིས།",
    "མི་བསྐྱོད་པ་དག་གི་རྣལ་འབྱོར་པའི་ཡང་གསུངས་པ་ནི།",
    "འདོད་ཆགས་རྡོ་རྗེའི་ཀྱོ་བ་མོ།",
    "འཇམ་པའི་རྡོ་རྗེ་ལ་སོགས་པའི་རྣལ་འབྱོར་པས་ཀྱང་ཇི་ལྟར་མོས་པ་བཞིན་དུ་རིག་པའི་བརྟུལ་ཞུགས་འདི་བྱའོ་ཞེས་གསུངས་པ་ནི།",
    "དཀྱིལ་འཁོར་གསུམ་མོ།",
    "དེ་ལྟར་ཚིགས་སུ་བཅད་པ་རེ་རེས་དེ་བཞིན་གཤེགས་པ་ལྔའི་བདག་ཉིད་བསྟན་ནས་འདི་དག་ནི་སྟོན་པའི་སྤྲོས་པ་མེད་པས་སྐབས་སུ་གསུངས་པ་ཡིན་ནོ།",
    "གསུང་རྡོ་རྗེ་དང་ཐུགས་རྡོ་རྗེ་དག་གི་ཡང་སོ་སོའི་དམ་ཚིག་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་འོག་ཏུ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པར་མོས་པ་ལས་དེའི་དོན་སྒྲུབ་པར་གྱུར་པའི་སྐུ་རྡོ་རྗེ་ཉིད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོའི་བདག་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་ཁྱབ་འཇུག་གི་དམ་ཚིག་ལ་ཡང་ཞེ་སྡང་གི་རིགས་ཀྱི་རྒྱུད་དང་ལྡན་པ་ཡི་གེ་ཧཱུྃ་ལས་བྱུང་བར་བལྟ་བར་བྱའོ།",
    "གནོད་སྦྱིན་མོ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་གསུངས་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཤ་དང་ཁྲག་ཟ་བའི་རང་བཞིན་ཅན་ནི་ཕལ་ཆེར་གནོད་སྦྱིན་མོ་ཡིན་ཏེ།",
    "ཚིག་གི་ལས་ཞེས་བྱ་བ་ནི།",
    "སྤྱད་ཅེས་བྱ་བ་ནི་ཕྱིའི་བུད་མེད་རང་སྣང་བའི་རིག་མའི་བདག་ཉིད་དུ་བྱས་ལ་གསལ་བར་སྣང་བའི་བདག་ཉིད་ཐུན་བཞིར་སྤྱད་པར་བྱའོ།",
    "ཕྱི་རོལ་རྡོ་རྗེ་ནི་རྡོ་རྗེ་འཛིན་པ་ལྟ་བུར་རང་གི་ཁ་ཟས་ལ་བསམ་པར་བྱའོ།",
    "རང་གི་རང་བཞིན་ལས་མི་འགྱུར་བས་ན་མི་འགྱུར་བའི་གནས་སོ།",
    "འདི་ཉིད་ནི་ཕྱིན་ཅི་ལོག་གི་ཚུལ་གྱིས་མ་སྐྱེས་པའོ།",
    "ཚངས་པ་ལ་སོགས་པ་སྐད་ཅིག་མ་དེ་ལ་འཁྲུལ་པ་འདིར་འགྱུར་མོད་ཀྱི།",
    "རྡོ་རྗེ་འཛིན་པས་གསུངས་པ་ནི་རང་གི་སྐུ་དང་གསུང་དང་ཐུགས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དབུ་ལ་རང་གི་རྡོ་རྗེ་མི་བསྐྱོད་པ་འཛིན་པ་སྟེ།",
    "ཐམས་ཅད་རིགས་ཀྱི་བྱེ་བྲག་གིས།",
    "འོད་ཟེར་ལྔའི་འོད་དང་ལྡན་པའི་རང་གི་ལྕེ་རྣམ་པར་འགྱུར་བ་བསྒོམས་ལ་བསྒྲུབ་པར་བྱ་བའི་ཁྲག་ལ་སོགས་པ་ཧཱུཾ་ཧྲཱི་ཁཾ་ཞེས་བྱ་བའི་སྔགས་ཀྱིས་ཕབ་ལ་ཐོད་པ་ལས་བཏུང་བར་བྱའོ།",
    "དམ་ཚིག་གི་བཟའ་བའི་རྫས་གསལ་བར་བྱ་བ་ནི་བཟའ་བའམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རང་གི་ཁར་དྲངས་ཏེ་སྤྱད་ལ།",
    "དེས་རང་གི་ལུས་ལ་གནས་པའི་ལྷའི་འཁོར་ལོ་དང་།",
    "དམ་ཚིག་འཛིན་པ་ཞེས་བྱ་བ་ནི་རྒྱུད་ལས་གསུངས་པའི་དམ་ཚིག་གི་སྤྱོད་པ་དང་དེ་ཁོ་ན་ཉིད་ཤེས་པར་བྱས་པའོ།",
    "ཕྱི་རོལ་དུ་ལྟ་བ་ལ་ཞེན་པའི་མཆོད་རྟེན་གྱི་ལས་ལ་སོགས་པ་དགག་པ་གསུངས་པ་ནི་མཆོད་རྟེན་དག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "དུག་གིས་ཁྱབ་པའི་ལུས་ལ་གནས་པའི་དུག་ལ་འོད་ཟེར་གཞུག་ཅིང་ཕྱིར་འབྱིན་པས་བྱབ་ཅིང་བསལ་བར་བྱའོ།",
    "སྙོམས་པར་ཞུགས་པ་དང་ལྡན་པའི་རང་གི་ལྷའི་རྣལ་འབྱོར་དང་ལྡན་པས།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་བཀའ་སྩལ་པ་ནི་ཡི་གེ་ནི་ཐུན་མོང་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཡི་གེའི་ཚིག་འདི་ནི་ཐུན་མོང་ཉིད་ཡིན་ཏེ།",
    "དེ་བས་ན་སྤྱན་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ཀྱིས་ནི་གླུའི་སྒྲ་ཡིས་བསྐུལ་བར་བྱས་པར་བསམ་ཞེས་སྨོས་པ་ཡིན་ནོ།",
    "གཡོ་བའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་སྐུའི་དཀྱིལ་འཁོར་དུ་རང་རང་གི་ངོ་བོ་ཐ་མི་དད་པར་གནས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་པོ་ཐམས་ཅད་ཀྱིས་ཞེས་བྱ་བ་ནི་རང་གི་ལུས་ལ་སོགས་པ་རྩེ་གཅིག་པ་སྟེ།",
    "ཐོས་པ་ནི་གསུང་གི་རྣམ་པས་སོ།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སྐུ་རྡོ་རྗེའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ནི་སྐུ་རྡོ་རྗེ་ཉིད་ལ་རྣམ་པར་གནས་ལ་སྡུད་པ་ན་ཡང་རང་གི་སྐུ་རྡོ་རྗེ་ཉིད་ལ་རབ་ཏུ་འཇུག་གི་གཞན་དུ་ནི་མ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རང་རང་གི་ལུས་དང་ངག་ཡིད་རྡོ་རྗེ་རྣམས་ཀྱིས་སོ།",
    "ལུས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་རྡོ་རྗེ་འཆང་གི་བདག་ཉིད་ཡིན་པར་རྟོགས་ཤིང་མངོན་དུ་བྱས་ནས་ཅང་མི་སྨྲ་བར་གྱུར་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བཅུ་གཉིས་པ་ལས་ནི་ཐུན་མོང་གི་དངོས་གྲུབ་གསུངས་སོ།",
    "གལ་ཏེ་རྒྱུད་འདི་ལས་གཞན་དག་སྟོན་པ་དེ་དག་ཀྱང་གསུམ་པོ་འདི་དག་གི་ནང་དུ་འདུས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་རིགས་གསུམ་ཞེས་བསྟན་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་སྟེང་དང་འོག་གི་ཆས་རྒྱུ་དང་འབྲས་བུ་རྣམ་པར་དག་པའི་གཟུགས་ཅན་ནི་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་དེ་འཆང་བར་མཛད་པས་ནི་རྡོ་རྗེ་འཛིན་པའོ།",
    "དེ་ཡང་ཚོར་བ་པོས་རང་རིག་པས་ངེས་པར་ཚོར་བ་ཡིན་པས་ན།",
    "གཉིས་པོ་དེ་དག་གི་འཇིག་པའི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "དེ་རྣམ་པར་དག་པས་ཐམས་ཅད་བདག་མཉམ་མོ་ཞེས་བྱ་བའི་ང་རྒྱལ་གྱི་ངོ་བོ་ཉིད་ཀྱིས་མཉམ་པའི་བདག་ཉིད་ཅན་ནི་རིན་ཆེན་འབྱུང་ལྡན་ནོ།",
    "གཞན་དག་གིས་ནི་མ་ཡིན་ནོ་ཞེས་ནན་ཏན་བྱེད་པས་དྲངས་པའི་བདག་ཉིད་ཅན་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "མོ་ཧ་ཞེས་ནི་གང་ལ་བགྱི།",
    "གང་གི་མཚན་ཉིད་ངོ་བོ་ཉིད་གཉིས་སུ་མེད་པ་ལ་ཞེན་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཅན་དེ་ཉིད་ནི་འདོད་ཆགས་སོ།",
    "འདི་དག་ནི་མོ་ཧ་ར་ཏི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལྷ་མོ་བཞིའི་སྔགས་ཀྱི་དོན་གསུངས་པ་ཡིན་ནོ།",
    "བཙུན་མོའི་མཆོག་ཕུན་སུམ་ཚོགས་པའོ་ཞེས་གསུངས་པའི་སྒྲའི་དོན་ཕུན་སུམ་ཚོགས་པ་ཇི་ལྟར་ལགས་ཞེས་ཞུས་པ་འདིའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་བུད་མེད་བདེ་མཆོག་ཕུན་སུམ་ཚོགས་པའོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མོ་ཧ་ར་ཏི་ལ་སོགས་པ་འདི་དག་ནི་བདེ་མཆོག་གི་རྒྱུར་གྱུར་པས་ན་བདེ་མཆོག་སྟེ།",
    "གང་གི་ཕྱིར་ཕྱིན་ཅི་ལོག་ནི་གཤིན་རྗེ་ཞེས་བྱ་ལ་དེའི་མཐའ་རྣམ་པར་འཇིག་པར་བྱེད་པའོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "གཏི་མུག་ཅེས་བྱ་བ་ནི་ཐམས་ཅད་དུ་སོང་བའི་ང་རྒྱལ་གྱི་བདག་ཉིད་ཅན་གྱི་གཏི་མུག་ཆེན་པོའོ།",
    "དེ་ཉིད་ཀྱིས་ན་ཉོན་མོངས་མཐར་བྱེད་དེ།",
    "འཛིན་པ་པོའི་བདག་ཉིད་ཀྱི་རྒྱུར་གྱུར་པའི་ཉོན་མོངས་པ་གཞན་གྱིས་མི་ཐུབ་པས་ན་དེ་འགོག་པར་མཛད་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་འོད་དཔག་ཏུ་མེད་པ་དེ་ནི་ཕྱིན་ཅི་ལོག་གི་ཆགས་པ་དང་འདྲེས་པའི་དོགས་པ་སེལ་བའི་མཆོག་ཡིན་པས།",
    "ངག་གི་ངོ་བོ་འགོག་པར་མཛད་པའོ།",
    "ཉོན་མོངས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཉོན་མོངས་པ་དང་ལས་ཀྱི་སྒྲིབ་པ་མ་ལུས་པ་ཟད་པར་བྱེད་ནུས་པའི་ཡེ་ཤེས་ཉིད་བྱ་བ་ཐམས་ཅད་བྱེད་པས་བགེགས་མཐར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ཉོན་མོངས་རྡོ་རྗེ་ཉིད་སྒྲིབ་པ་ཡིན་ལ་དེ་རྣམ་པར་དག་པ་ནི་གཉིས་སུ་མེད་པར་ལྷག་པར་མོས་པ་ལས་ཐམས་ཅད་རྣམ་པར་དག་པར་གྱུར་ལ།",
    "ངག་གི་ལས་རྣམས་ཅི་ཡང་རུང་བ་དག།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་ལྷ་མོ་དྲུག་པ་དེ་དག་ཉིད་ཀྱི་འབྱིན་པའི་སྔགས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་ཉིད་དངོས་པོ་ཐམས་ཅད་ངོ་བོ་ཉིད་དུ་མོས་པ་སྟེ།",
    "དེ་འོག་ཧཱུྃ་གིས་རྡོ་རྗེར་བྱས་པའི་ས།",
    "དེ་ལ་འདོད་ཆགས་ལ་དེའི་རང་བཞིན་འོད་དཔག་ཏུ་མེད་པའི་ངོ་བོ་ཉིད་བསམ་མོ།",
    "རེ་རེའི་ཞེ་སྡང་ལ་སོགས་པའི་ལས་བསྟན་པར་བྱ་བའི་ཕྱིར་ཞེ་སྡང་འཁོར་ལོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐམས་ཅད་ཞེ་སྡང་གི་རང་བཞིན་དུ་བསམས་ཏེ་སྤྲོ་བ་ལ་སོགས་པ་རྣམས་བྱེད་པར་བསྒྲུབ་པར་བྱ་བ་གཞིག་པ་ལ་སོགས་པ་བྱའོ།",
    "ཞེ་སྡང་གི་རྣལ་འབྱོར་པའི་ལས་བསྟན་ནས།",
    "གཏི་མུག་གི་རྣལ་འབྱོར་པའི་ལས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྔ་མ་བཞིན་དུ་གཏི་མུག་གི་འཁོར་ལོ་ཐམས་ཅད་བསྐྱེད་ལ་བཟླས་པ་ལ་སོགས་པ་བྱ་སྟེ།",
    "ལྷ་མོའི་རྣམ་པ་ལ་སོགས་པ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་དཀྱིལ་འཁོར་དུ་གསུངས་སོ།",
    "པདྨ་རྣམ་པ་ལྔར་ཞེས་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའི་པདྨ་ལ་སོགས་པ་མེ་ཏོག་གི་དོན་ཞུས་པ་དེའི་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་ལྷ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རིགས་ཀྱི་རིམ་གྱིས་ཞེས་བྱ་བ་ནི་རང་གི་རིགས་ཀྱི་ཕྱག་རྒྱས་བཏབ་པའི་འབྱིན་པར་བསྟན་ཏོ།",
    "ཡེ་ཤེས་སེམས་དཔའ་གང་རེག་པ་ཞེས་བྱ་བ་ནི།",
    "དངོས་གྲུབ་ཐུན་མོང་ཇི་ལྟ་བུ།",
    "དེ་ལ་བསྙེན་པ་ལ་སོགས་པའི་དབྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཐུན་མོང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐུན་མོང་གི་བསྙེན་པ་རྣམ་པ་གཉིས་དང་།",
    "མཆོག་གི་བསྙེན་པ་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་ལ་ཐུན་མོང་གི་བསྙེན་པ་གཅིག་ནི་རྡོ་རྗེ་རྣམ་པ་བཞིའོ།",
    "ད་ནི་ཐུན་མོང་གི་བསྙེན་པ་དང་འབྲེལ་བ་རྡོ་རྗེ་བཞི་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཆོག་གི་ཡེ་ཤེས་བདུད་རྩིའི་ཉིད།",
    "ཅེས་བྱ་བ་ནི་ཡེ་ཤེས་ཀྱི་བདུད་རྩིས་མཆོག་གི་བསྙེན་པ་འདི་བྱས་ནས་ཐུན་མོང་གི་བསྙེན་པ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐུན་མོང་གི་སྒྲུབ་པ་གཉིས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་སྦྱོར་བ་དྲུག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྒྲུབ་པ་ཞེས་བྱ་བ་ནི་དངོས་གྲུབ་མཆོག་གི་ཡན་ལག་དྲུག་གི་སྦྱོར་བ་བྱས་ནས་སྒྲུབ་པ་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡན་ལག་དྲུག་གི་སྦྱོར་བ་དེ་གང་ཡིན་ཞེ་ན།",
    "དེ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཉིད་ཙམ་དུ་གནས་པ་ལས་གང་འདོད་པ་ལས་སྡུད་པའི་ངོ་བོ་ཉིད་དེ་ནི་སོ་སོར་སྡུད་པའོ།",
    "རྟོག་པ་ལ་སོགས་པ་དེ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་རང་གི་སེམས་ཏེ་ཡེ་ཤེས་དང་ཤེས་བྱའི་རྣམ་པར་དབྱེ་བ་ཟད་པའི་ངོ་བོ་ཉིད་ནི།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་ལ་གནས་པ་ན་དེར་གལ་ཏེ་སྐྱོ་བར་གྱུར་ན།",
    "རང་གི་མཚན་མའི་གཟུགས་ཀྱིས་ཞེས་པ་ལྷའི་རང་བཞིན་གྱིས་གོང་བུའི་ཚུལ་གྱིས་རང་གི་རྡོ་རྗེ་ལས་བྱུང་སྟེ།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་ལ་རང་གི་ས་བོན་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀ་ན་གནས་པའི་མཚན་མའི་ལྟེ་བ་བསམས་ལ།",
    "ས་བོན་དེ་ལ་ཐིག་ལེ་ཡོད་པར་སྲོག་གི་ངོ་བོ་ཉིད་ལ་སེམས་གཞག་པར་བྱའོ།"
  ]
}