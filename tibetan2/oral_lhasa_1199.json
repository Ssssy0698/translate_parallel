    "དུ་བ་ལ་ཡོད་པའི་ཁྱད་པར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་འཛིན་པ་ནི་དེས་བསྐྱེད་པར་བྱ་བའི་ཁྱད་པར་འཛིན་པའོ།",
    "རྟགས་ཀྱི་ཁྱད་པར་ནི།",
    "རྟགས་ཁྱད་པར་ཅན་ཏེ།",
    "སྤྱི་གང་དག་ལ་དེའི་ཁྱད་པར་བྱེ་བྲག་ཡོད་པ་དེ་དག་ནི་རྟགས་ཀྱི་ཁྱད་པར་གྱི་བྱེ་བྲག་ཅན་ནོ།",
    "གལ་ཏེ་དེས་བསྐྱེད་པའི་ཁྱད་པར་འཛིན་པ་དང་རྟགས་ཀྱི་ཁྱད་པར་གྱི་བྱེ་བྲག་ཅན་བྱི་སྤྱི་འཛིན་ན་རྗེས་སུ་དཔག་པར་འདོད་དོ།",
    "ཁྱད་པར་ཅན་མ་ཡིན་པའི་སྤྱི་བརྗོད་པར་འདོད་ན་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཁྱད་པར་ཅན་མ་ཡིན་པའི་རྫས་ཉིད་ལ་སོགས་པ་སྤྱི་དག་བརྗོད་པར་འདོད་པ་དེའི་ཚེ།",
    "འཁྲུལ་པའི་ཕྱིར་རྗེས་སུ་དཔག་པར་མི་འདོད་དོ།",
    "འདི་ལྟར་མེའི་ཁྱད་པར་མེད་པར་ཡང་ཁྱད་པར་ཅན་མ་ཡིན་པའི་དུ་བ་འབྱུང་ལ།",
    "མེ་མེད་པར་ཡང་ཁྱད་པར་ཅན་མ་ཡིན་པའི་རྫས་ཉིད་ལ་སོགས་པ་འབྱུང་ངོ།",
    "འབྲས་བུ་ལས་རྒྱུ་རྗེས་སུ་དཔག་པར་རྣམ་པར་གནས་སོ།",
    "གལ་ཏེ་དུ་བ་མེས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་མ་ཡིན་པར་གྱུར་ན།",
    "དེས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་མ་ཡིན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཅི་དུ་བ་མེས་བསྐྱེད་པར་བྱ་བ་ཡིན་པས་མེ་ལས་འབྱུང་སྟེ།",
    "འདི་ལྟར་དུ་བ་ཡང་མེས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཀྱི་དྷིའབྲས་བུ་ཡིན་ལ།",
    "མེ་ཡང་དུ་བ་སྐྱེད་པར་བྱེད་པའི་ངོ་བོ་ཉིད་ཀྱི་རྒྱུར་འདོད་དོ།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་ནི།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་དག་གོ།",
    "དེ་དག་ནི་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་དག་ཀྱང་ཡིན་ལ།",
    "ངོ་བོ་ཉིད་དག་ཀྱང་ཡིན་པས་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པའི་ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་ཅན་གྱི་རྒྱུ་དང་འབྲས་བུ་དག་གོ།",
    "དེས་ན་ཅི་ཞིག་གྲུབ་པར་འགྱུར་ཞེ་ན།",
    "དེའི་ཚེ་དུ་བ་མེ་ལ་སོགས་པའི་ཚོགས་པས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་མ་ཡིན་པས།",
    "དེས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་མ་ཡིན་པ་ནི་མ་ཡིན་ཏེ།",
    "དུ་བ་ནི་མེ་མ་ཡིན་པས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ནོ།",
    "མེ་ལ་སོགས་པའི་ཚོགས་པ་དེས་ཀྱང་དུ་བ་དེ་ལྟ་བུ་དེ་བསྐྱེད་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་དུ་བ་སྐྱེད་པར་འགྱུར།",
    "ཇི་ལྟར་ཆུ་ལ་སོགས་པས་དུ་བ་སྐྱེད་པར་མི་བྱེད་པ་དེ་བཞིན་དུ་འདིས་ཀྱང་སྐྱེད་པར་མི་བྱེད་དོ།",
    "དུ་བ་ནི་མེས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་ལ།",
    "གཞན་གྱིས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་ན།",
    "དུ་བ་ནི་མེས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་ལ།",
    "བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་པར་འགྱུར་བར་འོས་པ་མ་ཡིན་ནོ།",
    "དེ་དང་དེ་མ་ཡིན་པས་བསྐྱེད་པར་བྱ་བ་སྟེ།",
    "དེ་ཇི་ལྟར་དེ་དང་དེ་མ་ཡིན་པས་བསྐྱེད་པར་བྱ་བའི་ངོ་བོ་ཉིད་དུ་འགྱུར་གལ་ཏེ་དེ་དང་དེ་མ་ཡིན་པས་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་ངོ་བོ་ཉིད་གཅིག་པ་ཡིན་པར་གྱུར་ན་ཉེས་པ་ཅི་ཡོད་ཅེ་ན།",
    "དུ་བ་དང་དུ་བ་མ་ཡིན་པར་བསྐྱེད་པའི་ངོ་བོ་ཉིད་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དུ་བ་མ་ཡིན་པར་བསྐྱེད་པའི་ངོ་བོ་ཉིད་ལས་བྱུང་ན་ནི།",
    "གལ་ཏེ་དུ་བ་དང་དུ་བ་མ་ཡིན་པར་བསྐྱེད་པའི་ངོ་བོ་ཉིད་ལས་སྐྱེས་པ་ཡིན་དུ་ཆུག་ཀྱང་།",
    "རྒྱུའི་ངོ་བོ་ཉིད་ཀྱིས་བྱས་པ་ཡིན་ནོ།",
    "དེ་ལ་འདི་སྙམ་དུ་འབྲས་བུ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་ནི་རྒྱུའི་ངོ་བོ་ཉིད་ཀྱིས་བྱས་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "ཡུལ་དང་དུས་དང་རྣམ་པ་སོ་སོར་ངེས་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟར་ན་དུ་བ་སྐྱེད་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་མེ་ལ་སོགས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གང་ཞིག་དུ་བ་སྐྱེད་པར་བྱེད་པ་དེ་ནི་མེ་ལ་སོགས་པའི་ཚོགས་པའི་ཁྱད་པར་ཡིན་ལསྐེ།",
    "དུ་བ་ཡང་མེ་ལ་སོགས་པའི་ཁྱད་པར་ལས་བྱུང་བ་གང་ཡིན་པ་དེ་ཁོ་ན་ཡིན་པར་བལྟའོ།",
    "འདི་ལྟར་འཇིག་རྟེན་ན་གང་ཞིག་ཚ་བར་བྱེད་པ་དང་འཚེད་པར་བྱེད་པ་དང་།",
    "དུ་བ་སྐྱེད་པར་བྱེད་པ་དེ་ནི་མེ་ཡིན་པར་གྲགས་ལ།",
    "གང་ཞིག་མེས་བསྐྱེད་ཅིང་མིག་དག་ནས་མཆི་མ་འཛག་པར་བྱེད་པ་དང་།",
    "གྲེ་བ་ལ་གནོད་པར་བྱེད་པ་རྗོནི་དུ་བ་ཡིན་པར་གྲགས་སོ།",
    "ཤེས་པར་བྱ་བ་དང་།",
    "ཤེས་པར་བྱེད་པ་བསམ་པ་ལ་དུ་བ་ལ་སོགས་པ་འབྲས་བུ་ལ་མེ་ལ་སོགས་པ་རྒྱུས་ཁྱབ་པ་གྲུབ་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་འབྲས་བུ་ལ་རྒྱུས་ཁྱབ་པ་གྲུབ་པར་འགྱུར།",
    "ནུས་པ་དག་རྣམ་པར་སྨིན་པ་ཐ་དད་པ་ཡོད་པ་ཁོ་ནའོ།",
    "དངོས་པོ་རྣམས་ཀྱི་རྣམ་པར་མཚུངས་པ་ཁོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འདི་ལྟར་ལ་ལ་ལ་ནི་མེ་ཏོག་ལས་ཐ་དད་པར་མཐོང་སྟེ།",
    "ལྟོས་སྣེཔར་བྱ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "འབྲས་བུ་ཐ་དད་ལ་ཐ་དད་པ་མ་ཡིན་ན་ཐ་དད་པ་མ་ཡིན་པར་གདོན་མི་ཟ་བར་ཁས་བླང་རྗོདགོས་སོ།",
    "གཏན་ཚིགས་གཞན་བསྒྲུབ་པར་བྱ་བ་དག་ལ་སྒྲུབ་པ་ཉེ་བར་སྦྱོར་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྒོས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་དག་ལ་སྒྲུབ་པ་རྣམས་ཀྱི་སྦྱོར་བ་སོ་སོར་ངེས་པ།",
    "འགའ་ཞིག་འགའ་སྒྲུབ་པར་བྱེད་པ་གཟུང་བར་རིགས་ཀྱི་གཞན་ནི་མ་ཡིན་ནོ།",
    "སཱ་སྟིལུ་དང་ནས་ཀྱི་ས་བོན་དེ་དག་ནི་སཱ་ལུ་དང་ནས་ཀྱི་མྱུ་གུ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱིས་ཐ་དད་པར་རྣམ་པར་གནས་པའི་ཕྱིར་རོ།",
    "དེའི་ཚེ་མེ་ཁོ་ན་དུ་བ་སྐྱེད་པར་ནུས་སོ་ཞེས་བྱ་བའི་ནུས་པ་འདིར་མི་འགྱུར་རོ།",
    "དེ་སྐྱེད་པར་ནུས་པར་མཚུངས་ན་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གལ་ཏེ་བརྒྱ་བྱིན་གྱི་སྤྱི་བོ་ལ་ཡང་དུ་བ་སྐྱེད་པར་ནུས་པ་ཡོད་ན་ནི།",
    "དེའི་ཕྱིར་ལེགས་པར་རྣམ་པར་ཕྱེ་བའི་འབྲས་བུས་ནི།",
    "འདི་ལྟར་འཇིག་རྟེན་ནི་དུ་བ་འདིའི་སྐད་ཅིག་མ་དང་པོ་ནི་འདིའོ་ཕྱི་མ་ནི་འདིའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དངོས་པོ་རྣམས་ཀྱི་སྐད་ཅིག་མ་རྣམ་པར་དབྱེ་བ་ནི་མི་ཤེས་སོ།",
    "འདི་ལྟར་འདི་ན་དུ་བའི་སྐད་ཅིག་མ་སྣང་བ་གང་ཡིན་པ་འདི་ནི་མེ་ལས་བརྒྱུད་དེ་བྱུང་བ་ཡིན་ནོ་སྙམ་དུ་རྗེས་སུ་དཔོག་པར་བྱེད་པ་ལ།",
    "དངོས་པོ་མེད་པར་ཐ་སྙད་གདགས་པ་བསྒྲུབ་པར་བྱ་བའི་གཏན་ཚིགས་ཏེ།",
    "འམ་ཞེས་བྱ་བའི་སྒྲ་ནི་གང་དུ་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "གང་དུ་ཐ་དད་པ་མ་ཡིན་པ་དེར་ནི་མེད་པར་ཐ་སྙད་གདགས་པའི་གཏན་ཚིགས་ཡིན་ནོ་ཞེས་རྣམ་པར་རྟོག་པ་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དམིགས་པ་ནི་དམིགས་པར་བྱེད་པ་སྟེ།",
    "ཤེས་པར་བྱེད་པའི་མངོན་སུམ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཤེས་པར་བྱ་བ་ཡིན་པས།",
    "ངོ་བོའི་རྐྱེན་སྤེད་ཀྱང་ངོ་བོ་གཙོ་ཆེར་བསྟན་པར་རུང་བ་ཉིད་དེ།་",
    "བརྗོད་པར་འདོད་པའི་དམིགས་པ་ལས་གཞན་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བརྗོད་པར་འདོད་པ་བུམ་པ་འཛིན་པར་བྱེད་པའི་དམིགས་པ་གང་ཡིན་པ་དེ་ལས་བུམ་པས་དེ་དབེན་པའི་ས་གཞི་འཛིན་པར་བྱེད་པའི་དམིགས་པ་འདི་གཞན་ཡིན་པའི་ཕྱིར་མི་དམིགས་པ་ཞེས་བྱ་སྟེསྐེ།",
    "མ་ཡིན་པར་འཇུག་པས།",
    "དཔེར་ན་བཟར་རུང་བ་ལས་གཞན་བཟར་མི་རུང་བ་མི་གཙང་བ་ལ་སོགས་པ་ལྟ་བུ་དང་།",
    "མ་ཡིན་པར་འཇུག་པ་ནི་མ་ཡིན་པར་འཇུག་པ་སྟེ།",
    "དགག་པར་བྱ་བའི་དོན་མ་ཡིན་པ་བོར་ནས་དོན་ཁྱད་པར་ཅན་ལ་འཇུག་པ་གང་ཡིན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "མ་ཡིན་པར་འཇུག་པ་དེ་ལྟ་བུ་དེས་འདིར་དགག་པ་རབ་ཏུ་སྦྱར་བ་ཡིན་ནོ།",
    "དགག་པ་ནི་དོན་གྱིས་གོ་བ་དེ་ལྟ་བུ་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "བརྗོད་པར་འདོད་པའི་དམིགས་པ་ལས་གཞན་པའི་དམིགས་པ་ཡིན་པས་བསྒྲུབ་༧པ་ནི་གཙོ་བོ་ཉིད་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་དམིགས་པ་གཞན་ཡོད་པར་བསྒྲུབ་༢་པའི་ཤུགས་ཁོ་ནས་བརྗོད་པར་འདོད་པའི་དམིགས་པ་དགག་པའི་ཀྱེཤེས་པར་འགྱུར་རོ།",
    "དེ་ལས་བཟློག་པ་ནི་མེད་པར་དགག་པ་ཡིན་པར་བལྟ་བར་བྱ་སྟེ་དེར་ནི་དགག་པ་གཙོ་བོ་ཉིད་ཡིན་ནོ།",
    "དེ་ལས་གཞན་པ་བུམ་པས་དབེེན་པའི་ཕྱོགས་དམིགས་པ་བསྐྱེད་༥པར་རུང་བ་གང་ཡིན་པ་དེ་ཉིད།",
    "ཚུལ་གོང་མ་དང་མཐུན་པར་བསྒྲེ་བའི་ཕྱིར།",
    "མ་ཡིན་པར་འཇུག་པས་བཟར་མི་རུང་བ་དང་།",
    "ཇི་ལྟར་མི་དམིགས་པ་ཉིད་མ་ཡིན་པར་འཇུག་པས།",
    "བུམ་པས་དབེེན་པའི་ཕྱོགས་ཁོ་ན་ཡིན་པར་རབ་ཏུ་བརྟག་ལ།",
    "ཁྱད་པར་མེད་པར་གཞན་གྱི་སྒྲར་བརྗོད་པར་བྱ་བ་ཐམས་ཅད་ཁོ་ན་ནི་མ་ཡིན་ནོ་ཞེ་ན།"
  ]
}