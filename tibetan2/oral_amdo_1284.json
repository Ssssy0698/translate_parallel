    "ཉོན་མོངས་རྨོངས་བདག་རྣམས་ཀྱིས་འཕགས་ལ་སྐུར་བ་དང་།",
    "གོས་གཙང་ཚོན་གྱིས་རྣམ་འགྱུར་སྣུམ་གྱིས་གོས་པ་མིན།",
    "བློ་། དམན་ཕྱིར་དང་དཀར་མོས་བྲལ་ཕྱིར་ལོག་པའི་ང་རྒྱལ་ལ་བརྟེན་ཕྱིར།",
    "ཐབས་དང་གཅིག་གིས་ཉམས་པའི་རྒྱུ།",
    "དེ་ལ་ཐོས་པ་དང་བསམས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཕིགས་པར་དཀའ་བའི་ཕྱིར་ནས་བརྗོད་དུ་མེད་པའི་རང་བཞིན་སོ་སོ་རང་གིས་རིག་པར་བྱ་བའི་དོན་རྡོ་རྗེ་ལྟ་བུར་རིག་པར་བྱའོ།",
    "ཡི་གེ་གང་དག་གིས་རྟོགས་པའི་དོན་རྣམ་པ་བདུན་པོ་འདི་དག་སྟོན་པར་བྱེད་གསལ་བར་བྱེད་པ་དེ་ནི་ཡི་གེ་ཞེས་བྱའོ།",
    "དེ་ནི་མིག་གིས་བལྟ་བར་མི་ནུས་སོ།",
    "ཤཱ་རིའི་བུ་དོན་འདི་ནི་རེ་ཞིག་ཉན་ཐོས་དང་།",
    "བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་དག་གིས་ལྟ་ཅི་སྨོས་ཏེ།",
    "རྣམས་པར་རྟོག་པར་མི་མཛད་མོད་ཀྱི།",
    "བསྟན་བཅོས་འདི་མཐའ་དག་གི་ལུས་ལ་སུ་རིག་པར་བྱའོ།",
    "རྡོ་རྗེའི་གནས་བདུན་པོ་འདི་དག་ལས་རང་གི་མཚན་ཉིད་བསྟན་པ་དང་།",
    "འདི་དག་གི་འབྲེལ་པ་གང་ཞེ་ན།",
    "རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "སོ་སོ་རང་གིས་རྟོགས་བྱའི་ཕྱིར།",
    "སྡུག་། བསྔལ་ཉོན་མོངས་སྤོང་ཕྱིར་རོ།",
    "རང་བྱུང་གི་ཡེ་ཤེས་ཀྱིས་རྟོགས་པར་བྱའོ་ཕྱིར།",
    "རལ་གྲི་དང་རྡོ་རྗེའི་དཔེས་ནི་གོ་རིམས་ཇི་ལྟ་བར་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་དང་ཐུགས་རྗེ་འདི་གཉིས་ཉིད་གཞན་གྱི་སྡུག་བསྔལ་དང་ཉོན་མོངས་པའི་རྩ་བ་འཇོམས་པར་ནུས་པར་བསྟན་ཏོ།",
    "ཉོན་མོངས་པའི་རྩ་བ་ནི་གང་ཅི་ཡང་རུང་བ་འཇིག།",
    "ལྟ་བ་དང་ཐེ་ཚོམ་གྱིས་བསྡུས་པ་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་ནི་འཇིག་རྟེན་པའི་རྟོགས་པས་ཤེས་པར་དཀའ་བ་དང་།",
    "འདིས་ནི་རེ་ཞིག་དེ་བཞིན་གཤེགས་པའི་འདུས་མ་བྱས་པའི་མཚན་ཉིད་དོ་ཞེས་བསྟན་ཏོ།",
    "རེག་ཏུ་། མེད་པ།",
    "དེ་ལ་སོགས་པ་ནི་ཉེ་བར་ཞི་བའི་ཚིག་གི་རབ་ཏུ་དབྱེ་བ་བསྟན་པའོ།",
    "འདིས་ནི་རང་གི་མཛད་པ་དག་ལས་རྣམ་པར་རྟོག་པ་དང་།",
    "བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པས་མ་དག་པའོ།",
    "དེ་ལ་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་དྲུག་པོ་དེ་དག་ཉིད་ལས་གོ་རིམས་ཇི་ལྟ་བར་འདུས་མ་བྱས་པ་ལ་སོགས་པ་དང་པོ་གསུམ་དང་ལྡན་པ་ནི་རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་ཡིན་ལ་ཡེ་ཤེས་ལ་སོགས་པ་ལྷག་མ་གསུམ་དང་ལྡན་པ་ནི་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའོ།",
    "བརྟག་པར་མི་ནུས་ངེས་ཚིག་དང་བྲལ་སོ་སོ་རང་གིས་རིག་ཞི་བ།",
    "གང་ཞིག་གང་གིས་ཆགས་བྲལ་བ།",
    "ལམ་གྱི་བདེན་པ་དག་གིས་བསྡུས།",
    "གསུམ་པོ་གང་དག་གིས་ཤེ་ན་མེད་པ་དང་།",
    "གང་ལ་སེམས་དང་ཡིད་དང་རྣམ་པར་ཤེས་པ་མི་འཇུག་པ་དེ་ལ་ནི་ཀུན་དུ་རྟོག་པ་གང་གིས་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པར་འགྱུར་བ་ཀུན་དུ་རྟོག་བ་འགའ་ཡང་མེད་དོ།",
    "ཉོན་མོངས་པའི་སྦུབས་ཐམས་ཅད་ལས་གྲོལ་བ།",
    "གཏི་མུག་རྣམས་ལས་གང་ཡང་རུང་བའི་ཉོན་མོངས་པ་ཀུན་དུ་སྤྱོད་པར་འགྱུར་རོ།",
    "བྱིས་པ་རྣམས་ཀྱིས་ཉོན་མོངས་པ་དང་ལས་དང་སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པའི་རྣམ་པ་འདི་ཐམས་ཅད་ཀྱང་ཁམས་གཅིག་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་མ་ཤེས་པས་རབ་ཏུ་འཇུག་གོ།",
    "སེམས་དེ་རང་བཞིན་འོད་གསལ་བས་ན་ཉོན་མོངས་ངོ་བོ་མེད་གཟིགས་པས།",
    "ཇི་བཞིན་ཇི་སྙེད་ནང་གི་ནི།",
