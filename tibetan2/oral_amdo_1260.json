    "དོན་དམ་པའི་ཤེས་རབ་ཀྱི་སྦྱོར་བ་འདི་ལ་ཐ་དད་པ་མེད་མོད་ཀྱི།",
    "རང་གི་ཁ་ནས་གཞན་གྱི་ཁར།",
    "དེ་བརྟན་པར་བྱ་བའི་ཕྱིར་རང་གི་ཁ་ནས་གཞན་གྱི་ཁར་བསྒོམས་ནས་ཞེས་བྱ་བ་གསུངས་པ་སྟེ།",
    "དེ་བས་ན་རང་གི་ཁ་ནི་རང་འཇུག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་མཚན་ཉིད་བདག་འཇུག་པ་ཞེས་བྱ་བར་རང་གི་ཁ་ནས་གི་ལྷ་ལ་སོགས་པས་སྣང་བའི་རྣམ་པར་རྟོག་པ་ཡང་ཡི་གེ་ཨ་ལས་འཇུག་པ་ཉིད་ཀྱིས་མེད་པར་བྱ་བར་བསྟན་པའི་ཕྱིར་གཞན་གྱི་ཁ་ཞེས་གསུངས་སོ།",
    "གཞན་དག་གི་ཁ་བས་ན་གཞན་གྱི་ཁ་སྟེ།",
    "ཕྱག་རྒྱ་དང་གསང་སྔགས་དང་རིག་སྔགས་རྣམས་བསྒྲུབ་པའི་ཤེས་། རབ་ཀྱི་ལུང་ལ་ནི་ཏིང་ངེ་འཛིན་གྱི་ཚིག་གི་ཁྱད་པར་སྨོས་པས་གཅིག་ཏུ་དམིགས་པའི་སྒོ་ནས།",
    "ཕྱག་རྒྱ་བསྒྲུབ་པའི་ཤེས་རབ་ཀྱི་ལུང་གིས་ཚིགས་བཅད་འདི་ལ་ཡང་དེས་པར་འབིགས་པར་ཚིག་གི་བྱེ་བྲག་སྨོས་པས་དོན་དམ་པར་དམིགས་པ་ལ་མོས་པ་རྩེ་གཅིག་པའི་མཚན་ཉིད་ཀྱི་ཁྱད་པར་བསྟན་པའོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་རིམ་གྱིས་བདག་དང་གཞན་དང་བཟླས་བརྗོད་བྱ་བའི་ཡི་གེ་རྣམས་བདག་མེད་པར་མོས་པར་བྱ་སྟེ།",
    "གསང་སྔགས་བསྒྲུབ་པའི་ཤེས་རབ་ཀྱི་ལུང་གི་ཚིགས་བཅད་ལ་དབྱངས་ཀྱི་རྗེས་སུ་འགྲོ་བའི་ཚིག་གི་བྱེ་བྲག་ལས་གསང་སྔགས་བསྒྲུབ་པའི་ཤེས་རབ་ཀྱི་དོན་ནི་འདི་ལྟར་ཤེས་པར་བྱའོ།",
    "འདི་ལྟ་སྟེ་བདག་དང་ལྷ་གཉིས་བདག་མེད་པར་མོས་པ་ལྔར་བྱས་ཏེ།",
    "མཚན་མ་མེད་པའི་ཏིང་རེ་འཛིན་གྱི་བཟླས་བརྗོད་འདི་ཡང་གཞན་དག་ལས་དོན་ཆེར་བསྟན་ཏེ།",
    "རྡོ་རྗེ་མོའི་རྒྱུད་ལས་ནི་རིམ་པ་བཞིན་དུ་ཡང་དོན་དམ་པའི་ཤེས་རབ་ཀྱི་མན་ངག་དག་སྣང་སྟེ།",
    "ཇི་ལྟར་བསམས་པ་འདི་དག་ཐམས་ཅད་བདག་མེད་པར་མོས་པར་བྱ་སྟེ།",
    "རང་གི་ལུས་ནི་བདག་མེད་པར།",
    "དེ་ཡང་བདག་མེད་པར་བསམ་མོ།",
    "ངོ་བོ་ཉིད་མེད་པར་མོས་པས་བཟླས་བརྗོད་བྱའོ།",
    "གཟུགས་ནི་རེ་ཞིག་མ་སྐྱེས་ཏེ།",
    "ལས་ཀྱི་ཕྱག་རྒྱའི་ནི་རྡོ་རྗེ་ཁུ་ཚུར་སེམས་དཔའ་ཆེན་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ཐམས་ཅད་ནི་རྡོ་རྗེ་བཅིངས་པ་ལས་སོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ནི་རྡོ་རྗེ་ལ་སོགས་པ་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པ་ལས་སོ།",
    "དེ་ཡང་བདག་མེད་པར་མོས་པ་ལས་སོ།",
    "དེ་ཡང་རྡོ་རྗེ་ཐལ་མོ་ལས་སོ།",
    "རྡོ་རྗེ་ཐལ་མོ་ཡང་རྣམ་པར་སྨིན་པའི་ལུས་སུ་མོས་པ་སྟེ།",
    "མཛུབ་མོའི་རྩེ་མོ་གཉིས་ཀྱིས་ནི།",
    "དེ་ནས་ཐལ་མོ་མཉམ་པར་བརྡབ་པའི་སྦྱོར་བས་ཉིང་པོ་འདི་བརྗོད་ཅིང་མཉེས་པར་བྱའོ།",
    "ཐལ་མོ་མཉམ་པར་བརྡབ་པའི་ཕྱག་རྒྱ་ཡང་།",
    "ལག་པ་ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བ་ལས་སྨད་ཕྱེ་ལ།",
    "མགོ་མི་དབྱེ་བས་ཐལ་མོ་མཉམ་པར་བརྡབ་པའི་ཚུལ་དུ་བྱའོ།",
    "རྡོ་རྗེ་སེམས་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ནས།",
    "གཙྪ་དྷྭ་ན་བུད་ྡྷབྱི་ཤ་ཡན།",
    "དེ་དག་གི་ཁྱད་པར་གྱི་ཆོ་ག་ནི་དེའི་རྣལ་འབྱོར་བྱེད་པ་རྣམས་ཀྱིས་རྒྱུད་ཉིད་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ནས་བདག་དང་བདག་གི་གནས་དང་ཁང་པ་དང་ཡུལ་ལ་སོགས་པ་དངོས་པོ་ཇི་ལྟར་གནས་པ་རྣམས་སྒྱུ་མ་ལ་སོགས་པར་སྣང་བ་བཞིན་དུ་སྣང་བར་ཡང་དག་པར་བརྟག་སྟེ།",
    "རང་གི་རིགས་དང་མཐུན་པར་བསྲུང་བའི་སྦྱོར་བས་བཟླས་བརྗོད་ལ་སོགས་པའི་ཚེ།",
    "དགོས་པའི་ཡོ་བྱད་རྣམས་བསྲུང་བའི་ནན་ཏན་བྱས་ཏེ་ལངས་ལ་རྟག་ཏུ་རང་གི་ལྷའི་དམ་ཚིགས་སེམས་དཔའི་ང་རྒྱལ་ཉིད་དུ་གནས་པར་བྱའོ།",
    "སྤྱོད་ལམ་ཐམས་ཅད་དུ་རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའ་བདག་ཏུ་བརྟག་པ་ལ་འབད་པ་ཉིད་དུ་བྱའོ།",
    "རང་གི་ལྷ་འམ།",
    "ནམ་ཕྱེད་ཀྱི་དུས་སུ་དུས་རེ་རེར་བརྒྱ་རྩ་བརྒྱད་དུ་བཟླས་བརྗོད་དུ་བྱ་བས་དུས་བཞིར་ཇི་སྐད་དུ་གསུངས་པའི་སྔོན་དུ་བསྙེན་པ་རྫོགས་ཀྱི་བར་དུ་སྔོན་དུ་བསྙེན་པ་བྱའོ།",
    "དེ་ལ་རེ་ཞིག་དངོས་གྲུབ་མཆོག་བསྒྲུབ་པར་འདོད་པས་རང་གི་ལྷའི་རི་མོའི་སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར་སྔ་མ་བཞིན་དུ་དུས་བཞིར་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བྱེད་པའི་རྣལ་འབྱོར་གྱིས་ཟླ་བ་བཞིར་ཡང་བཟླས་བརྗོད་བྱའོ།",
    "དེ་བཞིན་དུ་རང་གི་རིགས་དང་རྗེས་སུ་མཐུན་པའི་ལུས་དང་ངག་དང་ཡིད་དང་།"
  ]
}