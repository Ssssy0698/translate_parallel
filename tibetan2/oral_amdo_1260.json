    "རབ་ཏུ་དགའ་བ་ཁྱོད་ཅེས་སྨྲས།",
    "རང་གི་རིགས་ཀྱང་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་ཇི་ལྟར་འདོད་པའི་ཏིང་ངེ་འཛིན་རྣམས་དང་ལས་རྣམས་བསྒྲུབ་པ་ལ་ཡང་རིམ་པ་འདི་ཐམས་ཅད་སྦྱར་བར་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཐ་མར་དེ་བཞིན་དུ་རི་མོའི་སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་དེ་ཉིད་བཅིངས་ཏེ་མཚན་ཐོག་ཐག་ཏུ་བཟླས་བརྗོད་བྱའོ།",
    "རི་མོའི་སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར།",
    "ཇི་ལྟར་བཅིངས་པ་མི་དགྲོལ་བར་རྡོ་རྗེའི་ཚིག་གིས་བཟླས་བརྗོད་འབུམ་བྱའོ།",
    "ཇི་ལྟར་བྱིན་གྱིས་བརླབས་པའི་རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོའི་གཟུགས་སུ་བདག་མངོན་དུ་བྱས་ཏེ།",
    "རང་གི་ལྷའི་གཟུགས་རྣམས་ཀྱིས་ནམ་མཁའི་དཀྱིལ་འཁོར་མཐའ་དག་རབ་ཏུ་གང་བར་བྱའོ།",
    "འདི་རྣམས་ཐམས་ཅད་ནི་བདག་གི་རྣམ་པར་རྟོག་པ་ལས་བྱུང་བ་སྟེ།",
    "ཇི་ལྟར་རྣམ་པར་བརྟགས་པ་དེ་བཞིན་དུ་སོ་སོར་སྣང་བར་འགྱུར་མོད་ཀྱི།",
    "རིགས་པ་དང་ལུང་དང་འགལ་བས་འདི་རྣམས་ཀྱི་ངོ་བོ་ཉིད་ནི་གང་ཡང་དོན་དམ་པར་ངོ་བོ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་དུ་བསམ་མོ།",
    "དེ་བཞིན་དུ་བདག་ཏུ་། གྱུར་པའི་རང་གི་ཕྱག་རྒྱའི་སེམས་དཔར་དམིགས་པར་བྱའོ།",
    "སེམས་དཔའི་རྣལ་འབྱོར་གྱིས་བསྒོམ་མོ།",
    "རིམ་པ་ནི་འདིས་བསྒོམ་ཞིང་ཇི་སྲིད་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ཀྱི་མཚན་མ་བྱུང་གི་བར་དུ་གོམས་པར་བྱའོ།",
    "རང་གི་ཕྱག་རྒྱ་སེམས་དཔར་བདག།",
    "དངོས་གྲུབ་དུས་ན་རང་གི་གཟུགས།",
    "ནུབ་གཅིག་དེ་བཞིན་དུ་ཏིང་ངེ་འཛིན་ལ་གནས་ན་རང་གི་ལྷ་བྱོན་ནས།",
    "རང་གི་ཕྱག་རྒྱ་ཆེན་པོའི་གཟུགས་སུ་གྲུབ་པ་དེ་ལ་སྩོལ་ཏོ།",
    "དེས་ན་བདག་གིས་འདི་བྱའོ།",
    "དེ་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྒྲུབ་པ་ལ་ནི་རང་གི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "སྔ་མ་བཞིན་དུ་བདག་རང་གི་ལྷའི་སེམས་དཔར་བྱས་པའི་ལྕེ་ལ་རྡོ་རྗེ་རྩེ་ལྔ་པ་བསྒོམ་མོ།",
    "རང་གི་ལྷའི་ལས་ཀྱི་ཕྱག་། རྒྱ་སྒྲུབ་པའི་ཁྱད་པར་ཡང་།",
    "དེ་བཞིན་དུ་རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔར་ང་རྒྱལ་བྱས་ཏེ།",
    "རང་གི་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "གཞན་དུ་རྣམ་པར་བརྟགས་པ་ཙམ་མོ།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་དངོས་གྲུབ་མཆོག་གི་རྒྱུད་ཀྱི་སྐབས་སུ་ཕྱག་རྒྱ་ཐམས་ཅད་བསྒྲུབ་པ་ནི།",
    "རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་ཡེ་ཤེས་དབབ་པའི་མཐའི་བར་དུ་མངོན་དུ་བྱས་ཏེ།",
    "ཤེས་པར་བྱ་བའི་གཟུགས་ཀྱི་དངོས་པོ་དེ་ལ་སྣང་བ་དང་བཅས་པའི་མིག་གི་དངོས་པོས་སོ་སོར་སྣང་བའི་རྣམ་པར་རྟོག་པ་འཇུག་པར་བྱའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་བཏང་།",
    "བདག་རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོར་ཆོ་ག་བཞིན་དུ་བྱས་ནས།",
    "གང་གི་སེམས་ཡོངས་སུ་ཤེས་པར་འདོད་པ་དེར་རབ་ཏུ་ཐག་རིང་པོ་ན་གནས་ཀྱང་མདུན་ན་གནས་པ་བཞིན་དུ་མོས་པ་བྱ་སྟེ།",
    "གང་གི་ཕྱིར་བསམ་གཏན་པ་རྣམས་ཀྱི་ཡུལ་ནི་བསམ་གྱིས་མི་ཁྱབ་བས་འདིར་མི་རིགས་པས་མི་བརྟག་གོ།",
    "མི་གནས་པའི་དངོས་པོ་ལ་ཡང་ལོ་དུ་མར་འདུག་ཏུ་རུང་བར་བྱ་བའི་ལ་སོགས་པ་རྫུ་འཕྲུལ་གྱི་བྱི་བྲག་དེ་ལྟ་བུར་འདོད་པའི་རྣལ་འབྱོར་པས་སྔ་མ་བཞིན་དུ་རང་གི་ལྷའི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གངས་དང་ཟླ་བ་དང་འོ་མ་བཞིན་དུ་དཀར་བར་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཏིང་ངེ་འཛིན་སྣང་བདེའི་ཚེ་རབ་ཏུ་དངས་ཤིང་ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་དང་བྲལ་བར་ཤེས་པར་བྱའོ།",
    "རང་གི་ལུས་དེ་ཇི་ལྟར་ཤེས།",
    "འདིར་ནི་རྣལ་འབྱོར་པ་རྣམས་དགའ་བར་བྱ་བའི་ཕྱིར་དེ་རྣམས་ལས་ཅུང་ཟད་ཙམ་ཞིག་བདག་གིས་བཏུས་པར་རིག་པར་བྱའོ།",
    "རང་གི་རིགས་དང་མཐུན་པའི་རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་ཇི་ལྟར་བྱས་པའི་བདག་ཏུ་གྱུར་པར་མངོན་དུ་བྱ་སྟེ།",
    "ཇི་ལྟར་འདོད་པའི་རིགས་གཞན་དང་རྗེས་སུ་མཐུན་པའི་སྐྱིལ་མོ་ཀྲུང་ལ་སོགས་པར་འདུག་པའི་རིགས་གཞན་གྱི་སོ་སོར་ངེས་པའི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་སྦྱོར་པ་དེས།",
    "གང་ཡང་རུང་བའི་སྐྱིལ་མོ་ཀྲུང་།",
    "རྒྱལ་བའི་རིགས་ལ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་དུ་བྱའོ་ཞེས་གཞན་དག་ལས་གསུངས་སོ།",
    "རང་གི་རྐང་གཡས་རྩེ་མོ་ནི།",
    "འདི་ནི་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་།",
    "རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་འདུག་ལ།",
    "དེ་ཡིས་བུད་མེད་ལ་བལྟས་ན།",
    "བུད་མེད་ཅེས་བྱ་བ་ནི་འདིར་རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པར་ཤེས་པར་བྱའོ།",
    "མིག་གི་རྫི་མ་འདྲེན་པ་ནི།",
    "རིག་སྔགས་རྣམས་ཀྱི་ཚིག་གི་བྱེ་བྲག་ཆོ་ག་བཞིན་དུ་ཇི་ལྟར་བརྗོད་པའི་མཚན་ཉིད་ཀྱང་།",
    "དེ་ལ་འོག་ནས་བྱུང་བའི་མཚན་ཉིད་ཏིང་ངེ་འཛིན་གྱི་ཚིག་གི་རང་བཞིན་ནི་མཚན་མ་དང་བཅས་པའོ།",
    "ཚིག་ཏུ་བརྗོད་པ་ནི་རིགས་བཞིའི་བྱེ་བྲག་གི་ཚིག་རྣམ་པ་བཞི་སྟེ།",
    "རང་གི་སེམས་དཔའི་ཏིང་འཛིན་གྱིས།",
    "དེ་ལྟར་ན་དེ་བཞིན་གཤེགས་པ་ཡང་ཚིག་གིས་བསྐུལ་བ་ཉིད་ཀྱིས་རྡོ་རྗེའི་ཚིག་དང་འབྲེལ་པར་བྱས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་དགའ་བའི་ཚིག་གིས་ནི།",
