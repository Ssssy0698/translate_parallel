    "མུ་སྟེགས་ཀྱི་འཇུག་གནས་སུཡང་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་རྐྱེན་དེ་ལྟ་བུ་མེད་པར་སྣམསྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་འཇུག་པ་དངའདུག་པར་མི་བྱ་སྟེ།",
    "འཁོད་ན་འདུག་པདང་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོདཀྱང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེར་འདུག་པར་མི་བྱའོ་ཞེས་བྱབའི་དོན་ཏོ།",
    "འདིར་གཞུང་ནི་བཙུན་བ་ཀུན་དུ་རྒྱུའི་འདུགགནས་སུ་སྣམ་སྦར་མ་མཆིས་པར་མ་ཆིར་རུང་ངམ།",
    "ལ་བ་སྤུ་ཕྱིར་བསྟནཏེ་གྱོན་ལ་འདུག་པརབྱ་ཞིང་ཉལ་བར་ཡང་བྱའོ།",
    "རྐང་པདང་བཅས་པའི་སྟན་ལའདུག་པ་ལ་གནས་མ་ལ་རྐྱང་པ་མི་འགྲུབ་པའོ།",
    "ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོལྤགས་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དངཉལ་བར་ཡང་བྱ་བ་སྨོས་སོ།",
    "དུས་སུ་རུང་བའིནང་ན་འདུག་པའི་འཚོ་བའི་བར་དུ་བཅང་བ་ལ་དུས་སུ་རུང་བཉིད་དང་།",
    "མུ་སྟེགསཅན་གྱི་འདུག་གནས་དང་།",
    "གླེང་གཞི་རྣམས་ལས་དེ་སྤངབ་འདུག་པ་ཞེས་བྱ་བ་དང་པོར་བྱས་ནས་དགེ་སློང་མའི་ཞེས་བྱབའི་མཐར་ཐུག་པར་གསུངས་པ་ཡིན་ནོ།",
    "བམ་ལའདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་སྟན་གཞན་མེད་པའོ།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོཞེས་བྱ་བ་དང་།",
    "སྤྱོད་ལམ་མཛེསཔས་ཟན་གྱི་ཆེད་དུ་འདུག་པར་བྱའོ།",
    "གཞན་གྱིས་མགྲོན་དུ་བོསནས་འདུག་པ་ལ་དེས་གནང་ན།",
    "གཞན་གྱིས་བྱིན་པ་ན་དེའི་ཁོངས་སུགཏོགས་པ་དང་འདྲའོ་ཞེས་བྱ་བ་ནི་གང་ཞིག་གཞན་གྱིས་མགྲོན་དུབོས་ན་ནི་འདུག་པ་ལསྦྱིན་བདག་དེས་གནང་ན་སྦྱིན་བདག་གཞན་གྱིས་སྦྱིན་བའོ།",
    "འདིར་ཉེ་དུརྣམས་ལ་ལག་པ་བསྙལ་དུ་བཅུག་པ་འདིར་གཞུང་ནི་ཕྱོགས་དབེན་པརའདུག་སྟེ།",
    "ཟས་ཀྱི་ཕྱིར་འདུག་པས་འདི་འམ་འདི་ནས་བྱིན་ཅེསའདྲིམ་མཁན་ལ་བསྒོ་བར་མི་བྱའོ།",
    "དཀྱིལ་དུ་འདུག་པར་བྱའོ།",
    "དེ་དང་འབྲེལ་བའི་དོན་ལས་གཞན་པས་དེའིདྲུང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ལག་དརགཉིས་ཀྱང་བཀྲུ་བར་བྱའོ་ཞེས་བྱ་བ་ནི་ལག་པ་གཉིས་བཀྲུ་པཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་ཡང་འདུག་པར་མི་བྱའོ་ཞེས་བླུགསསོ་ཞེས་བྱ་བ་ལ།",
    "ལྟོ་འཛག་པས་ནི་མདུན་དག་ཏུ་ཕྱི་བ་ཙམ་བྱསཏེ་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "དེ་ལས་གཞན་བས་ནི་ཆུ་ཡོད་ནའཐོར་འཐུང་མ་བྱས་པར་ཡང་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "བདེ་འགྲོར་འགྲོ་བ་དང་རང་བཞིན་དུ་གནསཔའི་རྗེསསུ་མཐུན་བ་ཉིད་ལས་སོ།",
    "གངདུ་བྱེ་བྲག་གང་དང་ལྷན་ཅིག་བའི་འདུག་པ་ལ་རྗེས་སུ་མ་ཞུགསཔ་ཉིད་ཅེས་བྱ་བ་དེ་དང་པོར་བསྟན་པའི་ཕྱིར།",
    "དེ་བརྩམས་པ་འགྲོ་བའིསེམས་ཀྱིས་བཏང་བ་ནི་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ་ཞེས་བྱ་བནི་འདུག་པ་ཞེས་བྱ་བའི་སྤྱོད་ལམ་དེ་བརྩམས་ཤིང་སྔར་འདུགཔར་གྱུར་པ་གཞན་དུ་འགྲོ་བའི་སེམས་ཀྱིས་བཏང་བ་ནི་སྤྱོད་ལམལས་ཉམས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་གང་ཟག་ལ་ལྷུང་བཟེད་ལསོགསཔ་བྱིན་གྱིས་བྲླབ་པའི་ཚིག་དེ་ཡང་རང་བཞིན་དང་བྲལ་བ་ཉིདལ་ཉམས་པར་འགྱུར་རོ།",
    "ལྷག་བོར་ཡང་མདུན་དུརྩོག་པུར་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་གང་ཟག་ལ་ཡངངོ་ཞེས་བྱ་བ་སྨོས་པས་སོ།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བའི་གང་ཟག་དེ་ཕ་གུའི་སྟེང་དུརྟིང་པ་ཉིད་ཀྱིས་འདུག་ཏུ་གཞུག་གོ།",
    "རྒན་པའི་མཐའལོགས་སུ་ཙོག་པུར་འདུག་སྟེ་བྲྗོད་པར་བྱའོ།",
    "འགྲེངས་ཏེ་འདུག་པ་རྣམས་ཀྱིས་དུས་སུའོ།",
    "གསོ་སྦྱོང་དངདགག་དབྱེ་དག་བྱིན་གྱིས་བྲླབ་པའི་ཕྱིར་ཙོག་པུར་འདུག་སྟེ་བྱབར་གསུངས་པས་དེ་གཉིས་ཀ་ཡང་འདུག་སྟེ་བྱའོ།",
    "གང་དུ་མི་འདུག་པ་རྣམས་ཀྱིས་གནས་པར་རིགས་པཡིན་ཏེ་འདུག་པ་རྣམས་ཀྱིས་ནི་མ་ཡིན་ནོ།",
    "འདུག་པའམ་མིགནས་པ་རྣམས་ཀྱིས་དེར་ཡང་ནུས་པ་དེ་ལྟ་བུར་གྱུར་པ་ཉིད་ལ་བྱབ་བྱེད་པ་འགྲོ་བ་བཞིན་དུ་དོར་བར་མི་རིགས་པ་དེ་བས་ན།",
    "དེ་ལྟབུའི་ངོ་བོའི་རྐྱེན་རྣམས་ལ་གང་ལ་འགྲོ་བ་ཉིད་ལ་བྱ་བ་ཉིདའདུག་པ་ལ་ཡང་དེའི་རྫས་བྱིན་གྱིས་བྲླབ་པ་དང་།",
    "བཏང་བ་དགནི་འདུག་པ་ལ་ཡང་རིག་པར་བྱའོ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ་ཞེས་བྱ་བ་ནིགསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་འདུག་པ་ཉིད་ཀྱིས་བྱའི་སྤྱོདལམ་གཞན་གྱིས་ནི་མི་བྱའོ།",
    "འདུག་པའིགནས་ཐམས་ཅད་ལ་རྒན་རིམས་སུ་བསྐོ་བ་རིགས་པ་ཉིད་ཡིན་ནོ།",
    "འདུན་པ་ལ་སོགས་པལེན་པ་དེས་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགསཔའི་བསླབ་པའི་གཞི་བཅའ་བར་མཛད་དེ།",
    "མཚམས་གཞན་སྨོས་པ་ཉིད་ཀྱི་ཕྱིར་ནམ་མཁའ་ལ་འདུག་པར་མིབྱའོ་ཞེས་བྱ་བ་ལ་ཅིའི་ཕྱིར་སྨོས།",
    "དེའི་ཕྱིར་རང་བཞིན་དུ་གནསབ་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "རང་བཞིན་དུ་གནས་པམཚམས་ཀྱི་ནང་ན་འདུག་པ་ལའོ་ཞེས་གསུངས་པ་དེ་འདིར་ལུང་ཡིནནོ།",
    "ཁྱིམ་པ་ཡང་དག་པར་སྡོམ་པ་ཡང་རང་བཞིན་ཏྡུ་གནསཔ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "གནས་སྐབས་ཇི་ལྟར་འདུགཔ་ལ་བྱ་ཞེ་ན།",
    "འདིར་གཞུང་ནི་མི་གནས་པརའདུག་པར་མི་བྱའོ་ཞེས་གསུངས་པ་དེའི་དོན་ཅི་ལགས།",
    "ཡིད་དུའཐད་པའི་སེམས་ཉེ་བར་གནས་པ་ཡོད་པ་དེ་ལ་གནས་དེར་འདུག་པརབྱའོ་ཞེས་གསུངས་པའི་གཞུང་གནང་བ་ཡིན་ནོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "བྲྗོད་པའི་ཡན་ལག་མེད་ན་དེའི་སེམས་མ་ཡིན་པ་ཉིད་འཆབ་པ་མཡིན་ནོ་ཞེས་བྱ་བ་ནི་བྲྗོད་པའི་རང་བཞིན་དུ་གྱུར་བ་དང་རངབཞིན་དུ་གནས་པ་དང་།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལསགཞན་ལ་འདུག་པར་ཡང་ངོ་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་པར་ཡང་མིབྱ་ན་སྟན་གཅིག་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་གཉིསའདུག་པ་ནི་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་སྟནཆེས་དམའ་བ་ལ་འདུག་པར་བྱའི་མཉམ་པ་འམ་ཤིན་ཏུ་མཐོ་བ་ལའདུག་པར་མི་བྱའོ།",
    "དེ་གཡོགས་མ་གཅིག་ཏུ་མལ་མི་བཤམ་པདང་ཡོངས་སུགནས་པ་དག་མགུ་བར་བྱ་བ་སྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རངབཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "འདུགཔ་ལ་ཐ་མར་འོས་པའི་ཆོ་ག་འདི་ཡིན་ཏེ།",
    "གསོ་སྦྱོང་དང་དགག་དབྱེ་གཞག་པར་ཞེས་བྱ་བནི་གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོསྦྱོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཕྱོགས་ཅིག་ཤོས་སུ་ཡང་རང་འགྲོ་བར་མི་བྱའོ།",
    "ཕྱོགས་གཉིས་པར་ཡང་རང་འགྲོབར་མི་བྱ་ལ་མངག་པ་གཏང་བར་མི་བྱ་བར་ལུས་ཀྱིས་ཀྱང་བསྔམཔར་བྱ།",
    "ཉེས་རྩོམ་བྱེད་དུ་མི་འདུག་པ་དང་།",
    "ཅིག་འགྲོ་བ་དང་འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆགཔ་དང་གཏམ་འདྲེ་བ་དང་ཕེབས་པར་སྨྲ་བ་ཡང་ངོ་ཞེས་བྱ་བཡང་།",
    "སྤྱོད་ལམ་ཞེས་སྨོས་པ་ནི་འགྲོ་བ་དང་འགྲེལ་བ་དང་འདུག་པདང་ཉལ་བས་བྱས་པས་གླེང་བ་བསྡུས་སོ།",
    "དགེ་སློང་ཤི་རི་ཀ་ཉིད་ཀྱིས་རྒན་པའིམཐར་འདུག་སྟེ།",
    "འདུག་པ་ཞེས་བྱ་བའི་སྒྲ་ལས་ཁྱིམ་གྱི་ནང་ན་འདུགཔ་ཞེས་བྱ་བ་དང་སྦྱར་ཏེ་ཁྱིམ་པའི་ཁྱིམ་ན་འདུག་པ་ཞེས་བྱབའི་དོན་ཏོ།",
    "ཁྱིམགཞན་ན་འདུག་པ་ལ་ཡང་མ་གཏོགས་པར་མི་རིགས་ཏེ།",
    "ཁྱིམ་གཞན་ན་འདུག་པའོ།",
    "འདུག་པ་དངཉལ་བ་ན་འདུག་པའི་འོ་ཞེས་བྱ་བ་ནི་བསྟེན་པར་བྱའོ།",
    "གང་དུའདུག་པའི་སྤྱོད་ལམ་བསྟེནཔར་བྱ་ཞེ་ན།",
    "རྗེས་སུ་གནང་བ་ལ་མི་ལྟོས་པཉིད་ཀྱིས་རང་འདུག་པར་བྱའོ།",
    "གསར་བུས་རྗེས་སུ་གནང་བ་ལ་ལྟོསཏེ་འདུག་པར་བྱ་བ་བསྟན་པའི་ཕྱིར་གསར་བུས་ནི་བསྒོ་ནའོ་ཞེསབྱ་བ་སྨོས་ཏེ་ལུངའབོགས་པར་བྱེད་པས་བསྒོ་ཞིང་རྗེས་སུ་གནང་ན་འདུག་པར་བྱའོ།",
    "འདུག་པ་བསྟེན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མནོད་པར་བྱ་བ་མང་བ་ཉིད་ཡིན་ན་ཞུ་བར་བྱའོ་ཞེས་བྱ་བ་ནིལུང་མནོད་པར་བྱབའི་གཞུང་མང་བ་ཉིད་ཡིན་ན་འདུག་པའི་ཕྱིར་ལུང་འབོགས་པརབྱེད་པ་ལ་ཞུ་བར་བྱའོ།",
    "མང་དུ་ནོད་ན་སློབ་དཔོན་ལ་ཞུས་ཏེ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་ནསལུང་མནོད་པར་བྱའོ།",
    "ཇི་སྟེ་ཉུང་དུ་ནོད་ན་ནི་ཙོག་བུས་འདུགསྟེའོ་ཞེསགསུངས་པ་ཡིན་ནོ།",
    "ཐོས་པའི་ཉེན་ཀོར་མ་གཏོགས་པ་སྣང་བའི་ཉེནཀོར་དུ་འདུག་སྟེ་ཁ་ཏོན་བྱའོ་ཞེས་བྱ་བ་ནི་མཐོང་བའི་ཉེན་ཀོརདུ་གནས་ནས་སོ།",
    "གསུམལས་ལྷག་པ་དང་པོ་དང་ལྷན་ཅིག་ཁྲི་ལ་འཛེགས་པ་བསྟེན་པར་མིབྱའོ་ཞེས་བྱ་བ་ནི་གང་ཟག་གསུམ་ལས་ལྷག་པ་མང་པོ་དང་ལྷནཅིག་ཏུ་ཁྲི་གཅིག་གེ་སྟེང་དུ་འཛེགས་པ་དང་འདུག་པ་དང་ཉལ་བརམི་བྱའོ།",
    "མི་བྱའོ་ཞེས་བྱ་བ་ནི་གཅིག་ཁོ་ན་དེ་ལ་འདུག་པརབྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལོ་གསུམ་ལས་ལྷགཔས་བར་དུ་ཆོད་པ་དང་ལྷན་ཅིག་སྟན་ལ་འདུག་པར་མི་བྱའོ་ཞེསབྱ་བ་ནི་ལོ་གསུམ་ལས་ལྷག་པའི་དུས་བསྙེན་པར་རྫོགས་པའི་བར་དུགྱུར་པས་བསྙེན་པརརྫོགས་པའི་དུས་གཞན་གྱིས་བར་དུ་ཆོད་པ་ཉིད་དེ་དང་ལྷན་ཅིགསྟན་ཐམས་ཅད་ལ་འཛེག་པ་ཉིད་བསྟེན་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་ཡངརུང་བར་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསྙེན་པར་མ་རྫོགས་པདང་ཡང་མི་བྱའོ་ཞེས་བྱ་བ་ནི་བསྙེན་པར་མ་རྫོགས་པ་དངགང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མིབྱའོ།",
    "དེ་དག་གང་དང་གང་དུ་ཡངརུང་སྟན་གཅིག་ལའདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་དང་མི་བྱའོ་ཞེསབྱ་བ་ནི་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "དེ་ལ་རྒན་རིམས་སུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པ་དེ་ལ་རྒནརིམས་སུ་མི་བྱའོ།",
    "འདུགཔ་ལ་ཉེ་བར་མཁོ་བའི་སྟན་ལ་སོགས་པ་རྣམས་ལ་ཇི་ལྟར་འོངས་པཉིད་ཀྱིས་ལོངས་སྤྱད་པ་སྟེ།",
    "དེས་དེའི་ཕྱིར་སྒོར་འདུག་པར་མི་བྱའོ་ཞེསབྱ་བ་ལ།",
    "སྣང་གཡེལ་ཅན་དུ་མི་བྱའོ་ཞེས་བྱབ་ནི་འདུག་པར་ཏེ།",
    "གོས་མེད་པ་ཅན་གྱིས་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པར་མི་བྱའོཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཐར་གྱིས་གནས་བའི་སྙོམས་བར་འཇུག་པ་དགུ་བོ་དག་རྣམ་པན་བྱེ་སྟེ་ཤད་གེ་རྣམ་པར་འགྱིངས་པའི་ཏིད་དེ་འཛིན་ལ་སྙོམས་པར་འདུག་གོ།",
    "མྱུ་གུ་ཞིག་པ་རང་དུས་ན་ཁོ་རང་ཞིག་པ་མིན་ཡང་།",
