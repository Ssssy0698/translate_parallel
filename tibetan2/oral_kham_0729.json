    "ཞོ་ཁའི་ཐང་དུ་འདིར་ལྷ་ཁང་ཞིག་འོང་བར་འདུག་དེའི་རབ་གནས་ལ་སླེབ་པ་ཡིན་གསུང་བ་དང་།",
    "འགའ་ཞིག་ཁོ་བོ་ས་གཅིག་ཏུ་བསྡད་ན་ལེགས་བསམ་པ་འདུག་སྟེ་ཁོ་བོ་རྒྱལ་ཁམས་ཐམས་ཅད་དུ་འགྲོ་དགོས་པ་ཡིན།",
    "ཁྱེད་རང་རྣམས་ཀྱང་འུ་ལག་མ་ཞོན་གསུངས།",
    "ཁྱད་པར་རྒྱལ་བུ་ཆེན་པོས་བནྡྷེས་གོང་མ་ལ་ཕྱག་མི་དགོས་པར་བཀུར་བ་ལ་ཕྱིས་རྒྱལ་རྒྱུད་དང་མི་ཆེན་གྱིས་བནྡྷེའི་ཕྱག་བླངས་འདུག་རྒྱལ་ཁམས་མི་བདེ་བ་དེས་ལན།",
    "གོང་མ་ཡབ་སྲས་སྤྱན་ཆབ་བཏོན་ནས་བཞུགས་པའི་ཞུ་བ་བྱེད་ཅིང་འདུག་འདི་ལྟ་བུའི་དུས་སུ་བོད་དམ་དེར་བྱོན་ནས་ཅི་མཛད།",
    "རྫ་ཨ་བན་གངས་ཀྱི་ཞོལ་དུ་བསྙུང་བ་ན་ཡང་ཁྱེད་རང་རྣམས་སེམས་ཁྲལ་མི་འཚལ།",
    "ཨིནྡྲ་བྷུ་ཏི་ཉིད་ཡིན་ཞིང་འཁོར་ལོ་སྡོམ་པར་ངེས་པས་ཨོ་རྒྱན་སོགས་ལག་ན་འདུག་པ་ལྟ་བུ་ཡིན་པའི་ཚུལ་རྒྱ་ཆེར་གསུངས་སོ།",
    "ཡབ་ཀྱི་རྨི་ལམ་དུའང་དཀྱིལ་འཁོར་རབ་ཏུ་བཀྲ་པའི་དབུས་སུ་བུམ་པ་བཟང་པོ་འདུག་པ་ལ་ཕྱག་མཆོད་བྱས་གསོལ་བ་བཏབ་པ་རྨིས།",
    "གླང་ལོའི་ཟླ་བ་དང་པོའི་ཡར་ཚེས་ཀྱི་སྔ་དྲོ་ཞིག་དྲུང་ན་ཡོད་པ་རྣམས་ཡེངས་པའི་བར་ལ་ཇི་ལྟར་བཞེངས་མ་མཐོང་བ་ལ་ཕར་ཆམ་ཚུར་ཆམ་མཛད་ནས་བཞད་ཅིང་འདུག་པ་ལ་གོག་མ་དགོས་པར་འབྱོན་ཐུབ་པ་ལགས་།",
    "ཇ་ཞལ་ཁོང་རང་བཞེངས་ནས་མཛད་ཅིང་དཔོན་སློབ་ཀུན་ལ་ཆབ་ཚ་གནང་།",
    "དེ་ནས་གོང་མའི་མདུན་དུ་རྩེད་སྣ་རྣམས་མུས་ཀྱིས་ཡོང་འདུགའབྱོན་དུས་གོང་མ་མཆོད་ཡོན་སྒོ་དབུས་མ་ལ་བྱོན་ངེད་རྣམས་གཡོན་ལ་འགྲོ་བ་བཅོལ།",
    "རྒྱ་བན་སྟོང་ཙམ་གྱིས་ཉེས་པ་བྱས་པའི་དོན་ལ་བཙོན་དུ་བཟུང་ནས་ཤི་བའི་ཉེན་འདུག་པ་ཞལ་ཏ་བཛད་དེ་སྲོག་བསྐྱབས།",
    "སྔར་དྲུང་རང་བྱུང་བའི་དུས་ནས་ཚལ་པས་ཕུལ་བའི་གཡོར་པོ་དོལ་གྱི་མཆོད་གཞིས་རྣམས་རྗེ་ཉིད་ཀྱི་ཅ།",
    "རིང་པོར་མ་ཐོགས་པར་གཞན་དོན་རྒྱ་ཆེན་པོ་གཞན་ཞིག་ཡོང་བར་འདུག་གསུངས་ནས་མཐའ་མའི་མཛད་པ་ལུང་དུ་བསྟན།",
    "ཀུན་མཁྱེན་རོང་པོས་ལུང་པ་འདིའི་ཕུ་ན་གཞན་མི་ཟེར་བ་མང་པོ་ཟེར་བ་ཞིག་ཡོད་འདུག་པ་ལྟར་འགྲོ་གསུངས་ནས་བྱོན་ཏེ་མཇལ།",
    "འདུག་དགོངས་ནས་མཇལ་དུ་བྱོན་པས་སྟན་ལས་བཞེངས་ནས་གོམ་པ་དུ་མས་བསུས།",
    "འདི་ཀུན་མཁྱེན་རོང་པོས་གསན་པས་མཚུར་ཕུ་བ་ལ་མི་མེད་པར་འདུག་ཞུ་བ་གླུས་བསྐུལ་བྱས་ན་བཞེངས་པར་འདུག་པ་ལ་གསུང་སྐད།",
    "འཆི་བ་དྲན་པ་མི་འདུག་པ།",
    "དད་གུས་བྱེད་པ་མི་འདུག་པ།",
    "ཉམས་ལེན་བྱེད་པ་མི་འདུག་པ།",
    "དམ་ཚིག་རྩི་མི་མི་འདུག་པ།",
    "གསོལ་བ་འདེབས་པ་མི་འདུག་པ།",
    "ལྟ་རྟོག་བྱེད་མི་མི་འདུག་པ།",
    "དགག་སྒྲུབ་བྱེད་པས་གང་འདུག་པ།",
    "སྟོང་ལོག་བྱེད་མཁན་མང་འདུག་པ།",
    "ན་མ་ཚར་བར་ཡུལ་གཞན་མི་སྤོ་འདུག།",
    "ཐུབ་པ་ལོངས་སྐུའི་ཆ་ལུགས་འདུག་པ་མཐོང་།",
    "ཕྱིས་སྐུ་བལྟམས་པའི་ས་དེར་ཉི་ཟླ་ཟུང་ཞིག་འདུག་པ་དང་གསེར་སྦྲམ་རྙེད་པ་སོགས་གཉི་ག་ལ་རྨིས་ཏེ་རྔོད་དུ་བྱོན་རྨི་ལམ་དུ་བྱུང་བའི་གནས་དེ་སྤྱི་མདའི་མཁར་ཡིན་པར་ཤེས་ནས་དེར་བཞུགས།",
    "སྤྱི་ལྷ་ལ་སོགས་པའི་ནགས་རི་དང་སྤང་རི་དབྱིབས་སྣ་ཚོགས་པས་འབངས་འདུག་པ་ལྟར་བསྐོར་བ།",
    "དྲུང་འཇམ་དབྱངས་ཆེན་པོ་ལ་ཞུས་པས་ཡབ་ཡུམ་གྱི་མིང་འཁྲུངས་པའི་ཡུལ་རྣམས་རྨི་ལམ་དང་མཐུན་པར་འདུག་གསུངས་ནས་གོའི་ཐི་རྣམ་པ་གཉིས་ཀྱིས་རྩོད་མེད་དུ་ཐུགས་ཐག་བཅད།",
    "དྲུང་གོང་མ་རྣམས་ཀྱིས་ཟླ་བ་འདི་ལ་གསུང་འདི་བྱོན་སོགས་འདུག་གྲུབ་རྟགས་མང་དུ་བསྟན་འདུག་པ།",
    "མི་ཤེས་འཕྲང་ངན་འདི་འདྲ་ལ་ཐུགས་སྒྲིམས་ཞུས་པས་སློབ་དཔོན་པདྨ་ང་རང་ཡིན་པས་ཆོག་འཕྲང་ངན་ཡང་སྐྱོན་མི་འོང་གསུངས།",
    "ཟླ་གཅིག་ཚུན་ལ་འབུལ་བ་དངོས་ཅན་ཅི་འོང་མཁྱེན་ཞིང་འདི་འདྲ་ཞིག་འོང་བར་འདུག་པ་འདི་ལྟར་གྱིས་སོགས་གསུང་བ་རྣམས་ཐོག་ཏུ་བབ།",
    "ཡང་ཇ་སྐོལ་ལུང་པའི་ཕུ་ནས་ཇ་མང་པོ་འོང་བ་ཡོད་གསུངས་ཙ་ན་ཕྱི་ནང་གར་དབོན་དབུ་གསར་དང་མི་ཉག་བློ་གྲོས་བཟང་པོ་སོགས་ཀྱིས་བ་སོའི་ཐམ་ག་དང་ཇ་གོས་དར་དཔག་མེད་ཕུལ།",
    "མི་ཉག་བྱུང་མ་ཐག་བློ་གྲོས་བཟང་པོ་རྒས་འདུག་གསུངས་ནས་གསོལ་རས་གནང་།",
    "ཅེས་རྔམ་རྔམ་གཙིགས་གཙིགས་མཛད་པ་ན་དུས་མཁྱེན་དང་རྡོ་རྗེ་འཆང་ཤིན་ཏུ་མཉེས་པར་འདུག་གསུངས།",
    "ནང་དམེ་དང་འཁྲུག་རྩོད་མཐའ་ཡས་པ་འདུག་པ་རྣམས་ཞལ་ཏ་གནང་སྦྱིན་གྱིས་བསྡུམས།",
    "ཨོ་རྒྱན་དེ་སྤྲུལ་པའི་ཞིང་རང་དུ་ཡོད།",
    "ས་དམར་དུ་ཐུགས་རྗེ་ཆེན་པོར་མཐོང་བའི་མཛོད་པུ་ནས་འོད་ཟེར་ཉི་མ་ལྟ་བུ་བྱུང་བ་ཁོང་རང་ལ་ཐིམ་པས་ཉམས་རྟོགས་བཟང་དུ་སྐྱེས་ཏེ་དད་པའི་ཕུལ་དུ་གྱུར།",
    "དྲུང་ཞྭ་དམར་བས་ཀྱང་གནས་འདི་ལྟ་བུ་བཏང་སྟོམས་སུ་འཇོག་པ་མི་འོང་བས་འདིའི་ཁག་ང་རང་ཁོ་ནས་བྱེད་ཟེར་བ་ཞུས།",
    "ཕར་གནང་བའི་བཀའ་ཤོག་དངོས་མ་མཐོང་ན་ཡང་དེའི་ཞུ་ལན་དངོས་མཐོང་བ་ན་འདི་ལྟར་ཕེབས་པ་ཅེས་འདུག་པས་དོན་དེར་སྣང་ཞིང་ད་དུང་ཡང་དང་ཡང་དུ་གསོལ་བ་ལ་ཡང་བཀའ་ནན་དེ་བས་ཀྱང་ཆེར་གནང་བས་ཁ་ཅིག་ལེགས་སོ་ཕུལ་ཞིང་དད་པ་བླ་ལྷག་པར་སྐྱེས།",
    "ཀོང་པོ་དེ་སྔར་མ་བཅོས་པ་ཞིག་ཡོད་པ་ཡིན་ད་འགྱུར་འདུག་མི་འགྲོ་གསུངས།",
    "བེེ་རོ་ཙ་ནི་མགོན་པོ་དང་རྟ་མགྲིན་གྱི་སྔགས་ཐུང་སྟེ་རབ་ཀྱིས་ཛུང་ཕྱུར་བཞི།",
    "མི་ཆེན་གྱི་གྲལ་གྱི་ཚུལ་མ་གཏོགས་སྡོད་ལུགས་གང་བྱུང་དརྔ་ལག་པ་འགྲམས་པ་ལ་བསྟེན་པ་སོགས་མྱ་ངན་གྱི་འདུག་སྟངས་མི་བྱེད།",
    "ཀོང་པོའི་ནས་རིགས་སུ་འདུག་ནས་ཕྱིས་གོང་མ་ལ་ཡང་ཕུལ་ཞིང་གཞན་ལ་བཀྱེ།",
    "ཁོང་རང་ཡང་གཙུག་ཕུད་ཕུལ་ཞིང་བསྟན་པ་འཛུགས་པར་ཞུས།",
    "སྔོན་གྱི་ལུང་བསྟན་དུ་མ་ཡོད་འདུག་པ་བཞིན་བཀྲ་ཤིས་ལྐོག་ཕྲེང་ནས་སློབ་དཔོན་པདྨས་སྦས་པའི་ཚེ་ཆུ་ཚེ་རིལ་སོགས་འདོན་པར་གནང་སྟེ་ཐོན་ནས་གཏེར་ཚབ་ཀྱང་བཞག་དེའི་ཚེ་སློབ་དཔོན་པདྨ་མཁའ་འགྲོ་མ་བཞིས་བསྐོར་ནས་གདམས་པ་དང་ལུང་བསྟན་མང་དུ་གསུངས།",
    "ཁོང་རང་ར་རྔ་སོགས་ན་མཚམསཙལ་བཞུགས།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པ་དེ་གཞན་དང་རང་མི་འདྲ།",
    "བརྟན་བཞུགས་ཀྱི་བཞུགས་སྟན་འདུག་གོ་ཅོག་ཐིང་གསུངས་ནས་བཏིང་པས་བརྒྱད་བཅུ་གྱ་བཞི་བྱུང་ཟེར་ཏེ་ཕྱིས་གྱ་བཞི་ལ་མྱ་ངན་ལས་འདས།",
    "ནང་དོན་གྱི་འགྲེལ་པ་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བ་མཛད་དེ་རྗེ་ན་རིམ་བརྒྱད་པའང་ནང་དོན་གྱི་འགྲེལ་པ་འདི་ཁོ་ན་ལེགས་པར་འདུག་གསུང་།",
    "རྒྱ་གར་གྱི་རི་བོ་པོ་ཏ་ལ་དང་སུ་ཀ་ར་ཏིར་འབྱོན་དགོས་པའི་ལུང་བསྟན་འདུག་པས་རྒྱ་གར་དུ་བྱོན།",
    "ཁྲོམ་དེའི་ཁྲོད་ན་མི་ངུ་བ་སུ་ཡང་མི་འདུག་ང་ལས་མགོ་མཁྲེགས་པའི་མི་མེད།",
    "དེ་ནས་ད་ནི་རྗེ་ཐམས་ཅད་མཁྱེན་པ་མཇལ་དགོས་པར་འདུག་གསུངས་ནས་སྒར་ཆེན་གཙང་ནས་སྐྱི་ཤོད་དུ་ཕེབས་ཚེ་སྐུ་ཅུང་ཟད་བསྙུན་བཞིན་མཇལ་དུ་བྱོན།",
    "ལྕགས་ཕྲེང་ཞིག་ཡོད་པ་གོང་བུ་གཅིག་ཏུ་ཞུ་ཡང་ཁོང་རང་ལ་ལུས་ཅུང་ཟད་འཕར་བ་ཙམ་ལས་མ་བྱུང་སྐད།",
    "རི་རྒྱན་དྲུག་དང་བཅས་ཏེ་གར་བྱེད་ཅིང་འདུག་པའི་རྒྱབ་རི་འཇའ་གུར་དང་མྱོ།་",
    "དབུ་དུམ་པ་གསེར་ཇིས་མཇའ་ཏེ་སྐུ་ལ་དྲི་བཟང་པོ་རྒྱུན་དུ་བྲོ་བ་ལ་ངསྣམས་ཏེ་གཙུག་ཏོར་དང་མཛོད་སྤུ་མ་གཏོགས་མཚན་ཐམས་ཅད་རྫོགས་པར་འདུག་ཟེར་ནས་རི་བོ་ཆེར་སྙན་པ་བསྒྲགས་སོ།",
    "འདིས་ཆོག་པ་ཡིན་པར་འདུག་ཅེས་གསུང་བ་སོགས་དཔྱོད་ལྡན་ཐམས་ཅད་ནི་སོམ་ཉི་ཙམ་ཡང་མི་བྱེད་པར་སྣང་ངོ།",
    "ཐུགས་ཞན་ལ་ཐ་འཁོབ་གདུལ་བྱ་ཆེ་བར་དགོངས་པར་འདུག་འདི་ཀུརྨ་པ་མིན་རྫོ་བ་ཨང་གསུངས།",
    "འདི་པ་གོག་འདུག་བྱས།",
    "ང་ནི་དྲུང་གོང་མའི་མཛད་པ་དང་དྲུང་འདིའི་མཛད་པ་ལ་ཁྱད་པར་མི་འདུག་བསམ་གསུངས།",
    "ང་སུ་ཡིན་པ་འདུག་གུར་དང་བཀོད་པ་སྔར་དང་ཨེ་འདྲ་དོ།་",
    "ཁྱེད་ཀྱིས་ཀྱང་དབུ་སྐྲ་རིང་པོ་བཞག་འདུག་ཐོ་ཅོ་མ་བྱེད།",
    "ད་དུང་ངས་མི་རྫོགས་འདུག་གསུངས།",
    "ཁྱེད་སྒར་པ་དཔོན་སློབ་སུས་ཀྱང་གྲོས་མི་ཤེས་འདུག་ངས་ངོས་འཛིན།་",
    "དྲུང་པ་སྙེ་བོ་གོའི་ཤྲི་ལའང་འདི་མཛད་མི་འདུག་ལྷ་དང་ཞེས་ཡང་ཡང་གསུངས།",
    "བེེ་རོ་ཙ་ནའི་གནས་སྒོ་ཕྱེ།",
    "ངས་རྗེའི་དྲུང་དུ་བསྙེན་རྫོགས་ཕུལ་ཟིན་ནས་ཀོང་པོ་ད་ལའི་རི་རྩེར་ང་རང་བློ་བདེ་བར་བསྡད་པ་རྨིས།",
    "ངས་སཱ་ཚ་བཏབ་པས་སཱ་ཚ་རྣམས་ལས་འོད་ཟེར་རབ་ཏུ་འཕྲོ་བ་བྱུང་སྟེ་བསྟན་པ་ལ་བྱ་བ་ཆེན་པོ་མཛད་པར་འདུག་གསུང་།",
    "འབྲས་ཡུལ་འཇམ་གསར་བ་དེ་ཡོན་ཏན་རང་མི་ཆེ་པར་འདུག་སྟེ་བཙུན་པ་རང་ཡིན་ངེས་ཤིག་འདུག་གསུང་བ་དང་།",
    "ཁ་ཅིག་ནི་གང་ལའང་ཞེན་པ་མི་རུང་བར་འདུག་སྙམ་ནས་རྒྱུད་དྲང་པོར་འགྱུར།",
    "བྲག་གསུམ་དུ་ང་རང་རྒན་པོ་གདན་འདྲེན་ལ་ཡོང་།",
    "སྐུ་ལུས་ཤེལ་ལྟར་མི་སྒྲིབ་པ་དང་བྱ་རྒོད་ལ་བསད་གསོ་དང་སྡིགས་མཛུབ་ཀྱིས་གངས་རི་གཡོ་ནུས་པའི་རྫུ་འཕྲུལ་བསྟན་ཏེ་ཁྱེད་བོད་ཀྱི་གྲུབ་ཐོབ་སླ་བར་འདུག་གསུངས།",
    "ཕྱག་མཛོད་སོགས་སྔར་ཉམས་ཟིན་མ་གཏོགས་མ་ཉམས་པར་མཛད་དེ་དཔོན་ས་ཁོང་རང་བྱོན་ནམ་གཙང་པ་བྱོན་ནམ་སུ་བྱོན་ལ་རྩིས་སྤྲོད་པར་དགོངས་ཀྱང་།",
    "ཁོང་རང་སྐུ་ཆས་བསྒྱུར་དཔོན་ཆེན་གནང་།",
    "དེའི་རྒྱུར་དམིགས་པའི་གནང་སྦྱིན་ཡང་མཛད་པར་འདུག་རྒྱལ་ཆེན་སྐུ་རབ་པས་སྤྱན་དྲངས་ཏེ་འབུལ་ཞབས་མཛད།",
    "འབྲི་ཁུང་ཟུར་པ་ཁོང་རང་ཇི་སྐད་གསུང་བའི་མཇལ་ཚུལ་གྱིས་ཐུགས་ཚིམ་པར་མཛད།",
    "རྒྱལ་མཁར་རྩེ་ལ་བསྐོར་འདུག་ཟེར་བའི་ཚེ་མི་གནང་བ་ཞུ།",
    "སོ་སོ་ནས་ཡོན་ཏན་སྦེད་པ་འབའ་ཞིག་ཏུ་འདུག་པ་དང་།",
    "རྗེ་འཕྲིན་ལས་པའི་ཊཱིཀ་དེས་དོན་མི་ལྷོངས་པར་འདུག་པས་དེ་ལ་མཆན་བུ་གྱིས་གསུངས་ཏེ་གསོལ་བའི་དུས་མ་གཏོགས་ཞབས་ཕྱིར་བསྡད་དེ་གསུང་བསྒྲུབས།",
    "ཞབས་བཞེངས་མི་ཐུབ་པའི་རྣམ་པར་འདུག་པའང་ཉིན་སྐྱེད་བྱུང་སྟེ་ཟླ་གཅིག་ཙམ་ནས་འབྱོན་པ་བྱུང་ཞིང་གནས་ཀྱི་བརླན་བཤེར་དེ་སྐུ་ལ་མི་འཕྲོད་པར་གོ་ནས་རིམ་པས་སྤྱན་དྲངས།",
    "ཕྱིས་སྐུ་རིམ་ཞུས་པ་ན་ངེད་རང་སྐུ་རིམ་ཆེན་པོ་ཅིག་བྱེད་དགོས་པར་འདུག་པས་སྐུ་རིམ་ཡིན་ཟེར་ནས་ཡོ་བྱད་ཐར་ཐོར་དུ་གཏོང་བ་དེ་མ་བྱེད་གསུངས་ཤིང་རིམ་པས་གོང་ལ་དང་རྣམ་རྒྱལ་དུ་ཕེབས།",
    "གཙོ་བོར་འབྲི་གདན་གཉིས་སུ་སྔར་ནས་གནང་བའི་རྒྱུན་འདུག་པ་ལྟར་དང་།",
    "སྔོན་རྗེ་དེ་བཞིན་གཤེགས་པའི་དགོངས་རྫོགས་ཀྱི་ཁྲུ་མ་མཚུར་ཕུ་ན་འདུག་པ་དང་།",
    "སྟན་མཐོན་པོ་དགོས་ཞེས་བརྩེག་པ་སོགས་ལ་ཁོང་རང་རྣམས་ཀྱི་བསམ་པ་བཞིན་མཛད་ཀྱི།",
    "ཡུལ་དུ་བྱོན་པས་རིགས་ཉམས་ཟེར་ནས་མེ་ལ་བསྲེགས་པས་ཟིལ་པ་ཕྲོམ་མེ་འདུག་ནས་ཡུལ་དེ་བཏུལ་བས་པདྨ་བཛྲའི་མཚོ་སྐྱེས་རྡོ་རྗེར་གྲཊ་སོ།",
    "ཇ་དེ་ལ་ཕྱག་བཅུག་མནམས་ནས་བཟང་པོ་ཅིག་འདུག་ཐོན་པར་སྐོལ།",
    "འཇིགས་དུས་བསྣོལ་བའི་ཚུལ་ཡང་མི་མཐུན་འདུག།",
    "སློབ་དཔོན་གྱིས་གཡས་འཇིགས་བྱེད་དང་གཡོན་དུས་མཚན་མནན་པ་ཞིག་འཆད་ཅིང་འདུག་འོན་ཡང་འཇིག་རྟེན་མགོན་པོའི་བཀའ་འབུམ་གྱི་ལུང་ཞིག་ཉན་པ་དེ་སེམས་ལ་ཕན་པ་ཞིག་བྱུང་།",
    "ལྟ་བ་དང་སྐྱེད་རྫོགས་ཀྱང་ང་རང་ལ་གསལ་སྣང་སྐྱེས་པ་དང་གྲུབ་ཆེན་རྣམས་དང་མཐུན་པར་འདུག་གསུངས་སྐད།",
    "སྔོན་རྗེ་འཇིག་རྟེན་མགོན་པོས་གདན་རབས་བཅུ་གསུམ་པ་ལ་ང་རང་ཡོང་ཞེས་དང་།",
    "གྱེར་ལྷ་ཁང་དུ་ཕེབས་དུས་མི་ལ་ཉེ་གནས་གོ་ཆོད་བྱུང་འདུག་སྟེ་གསུངས་པས།",
    "ཁྲི་སྐོར་ཐམས་ཅད་ལ་ཁ་དས་ཁྱབ་པར་བྱེད་པར་འདུག་ལ།",
    "དྭགས་པོ་སྙི་སྒོམ་དེ་བྱ་རྒོད་ལ་སྒོམ་ཐེབས་པར་གྲགས་འདུག་ང་།",
    "ཉམས་མྱོང་རྣམས་ཕུལ་པས་ཐབས་ལམ་གྱི་ཡོན་ཏན་བཟང་པོ་སྐྱེས་འདུག་སྟེ།",
    "ལྟ་བ་ལ་ཐག་ཆོད་ཅིག་དགོས་པ་འདུག་གསུངས་ཏེ་ཕྱག་རྒྱ་ཆེན་པོ་གནང་ནས་ལྟ་བའི་སྒྲོ་འདོགས་ཆོད།",
    "སྐ་རགས་ཀྱི་གསེར་དང་དར་ཡུག་དྲུག་པོ་ཟད་ཙ་ན་གདམས་ངག་ཚར་བར་བྱའོ་ཞེས་གསུངས་པས་སྐྱེངས་པ་ཅིག་བྱུང་།",
    "ཁ་སང་ཁྱེད་ལ་འབུལ་བ་སྐྱེལ་མི་མི་འདུག་ཟེར་ནས་ངེད་རྣམས་ཡོང་བ་ཡིན།",
    "ད་ལྟ་ཆུ་འབའ་ཞིག་དུ་གདའ་ན་ཡུལ་ནམ་འབྱུང་ཞུས་པས་རྨོངྒལ་གྱི་བུ་དང་རྣམ་ཐོས་སྲས་གཉིས་ལ་ཁྱེད་གཉིས་ཀྱིས་ཆུ་དྲོལ་ཞིག་གསུངས་ཏེ་རྣམ་སྲས་ཀྱིས་བེ་ཅོན་གྱིས་རིའི་མུ་ཁྱུད་དྲལ།",
    "འཇམ་དཔལ་གྱིས་དགེ་སློང་བེེ་རོ་ཙ་ནར་སྤྲུལ་ཏེ་བྱིས་པ་ཕྱུགས་རྫི་འཇོས་དང་མུ་ལེ་ལ་དང་པོར་ལི་སྐད་དང་ལི་ཡིག་བསླབས་ཏེ་ཀུན་ལ་དར།",
    "ལྷོ་ཕྱོགས་སུ་གདན་ཁྲི་ཆེན་པོ་བཤམས་ནས་རྒྱལ་པོ་བློན་པོའི་འཁོར་དང་བཅས་པ་འདུག་གོ།",
    "ཡི་གེ་ཁ་གཅིག་ན་དེ་ནས་ཧན་གྱི་རྒྱལ་རབས་ཉི་ཤུ་རྩ་བཞི་པ་ཧན་ཧིན་ཏི་ཟེར་བ་འདུག་ཀྱང་འདི་དག་པར་སེམས།",
    "དེའི་དུས་སྔོན་མེད་པའི་སྐར་མ་ཞིག་ཤར་བས་རྩིས་པ་རྣམས་ཀྱིས་མཁར་འདིར་རྒྱལ་སྲིད་འཕྲོག་པའི་མི་ཅིག་སྐྱེས་འདུག་བྱས་པ་དང་།",
    "གཞན་སུས་ཀྱང་མ་མཐོང་བར་འདུག་དེར་ཐེ་ཚོམ་མེད་པར་ཕྱིན་པས་དབྱར་སྟོད་ཅིག་མཚུར་ཕུར་མཇལ།",
    "གདུང་ཆེན་པོ་ཞིག་བསྟན་ནས་ཤིང་ཅིར་འདུག་ཟེར་བ་ན་རྒྱ་མཚོའི་ཉ་ཆེན་གྱི་རྨང་ང་ཡིན་གསུངས་པས་མངོན་ཤེས་འདུག་ཟེར།",
    "ས་སྐྱ་པ་རྣམས་གར་ཡང་ཕྱིན་པའི་ནོར་ཉམས་ཆེན་པོ་འདུག་ཟེར།",
    "རྒྱལ་པོས་བློན་པོ་དང་མཆོད་གནས་རྣམས་ལ་ཁྱེད་ཚོ་ཁོ་ཟོག་པོ་ཡིན་ཟེར་བ་ནོར་ཅི་ལའང་འདོད་པ་མི་འདུག་དེ་ཟོག་པོ་ཡིན་ནམ།",
    "ག་མེད་ཁོས་ཤེས་པར་འདུག་ས་འདིར་པག་ཤི་བཟང་པོ་ཞིག་འཁུགས་པ་ལ་ལུང་ཤོར་ནའང་ཁོ་ལ་ནོར་ནི་མི་དགོས་པར་འདུག་ཁྱེད་ཚོས་ཐབས་མཁས་ཀྱིས་ཟས་བཟང་པོ་བྱིན་ནས་བསྟེན་པ་ཡིན་པ་ལ་ཞེས་མཛད་པ་བརྡུགས་པའི་གསུང་མཛད།",
    "སེ་ཆེན་ཡོན་མཆོད་བཞིན་རྒྱལ་ཁམས་ཀྱི་བྱ་བ་ཐམས་ཅད་ཁྱེད་རང་ཡོན་མཆོད་ཀྱིས་མཛོད་ཞུས་པས་ངེད་ལ་གོང་མའི་སྐུ་རིམ་ཙམ་མ་གཏོགས་འཇིག་རྟེན་གྱི་དགོས་ཆེད་མེད།",
    "དེ་གོང་དུ་འཕེལ་བས་མཐོ་བཞིར་ལོངས་ཚེ་འཕགས་པ་རྡོ་རྗེ་གདན་དུ་དངོས་སུ་བྱོན་ནས་ཞིག་གསོ་མཛད་ཅེས་རྒྱ་གར་ན་གྲགས་པར་སྣང་ལ་ད་ལྟ་མཐོ་གསུམ་ལྷག་ཙམ་འདུག་སྐད།",
    "དེ་ནས་བཟུང་སྟེ་ཁྲིད་པས་ཁོ་རང་ནི་ནང་པར་མ་ཞུགས་པས་རྒྱལ་པོས་ལྕེ་བཅད་དེ་ལྷ་ཁང་ཞིག་ཏུ་བཙོན་དུ་བཅུག་གཞན་ཐམས་ཅད་ནང་པར་ཞུགས།",
    "ཤིང་སྲིན་བུས་ཟོས་པའི་རྗེས་ཡི་གེར་ཡོད་པ་ལ་རྡོར་གཅོད་དང་སྡུད་པ་ཚང་བར་འདུག་པ་ལ་མཆོད།",
    "ས་བཅུའི་བྱང་སེམས་ལའང་ཉེ་རིང་འདི་འདྲ་སྣའདུག་བསམས་ནས་འཕགས་པ་ཉེ་རིང་མ་མཛད་ཞུས་པས་གསུང་འཕྲོ་ཆད།",
    "ཡིད་མི་འཆེས་ན་གཞན་ལ་སྟོན་གསུངས་ཏེ་རྗེ་བཙུན་ཕྲག་པར་བཞུགས་ནས་ངའི་ཕྲག་ན་ཅི་འདུག་ཅེས་ཚོང་འདུས་སུ་བསྟན་པས་གཞན་སུས་ཀྱང་མ་མཐོང་།",
    "རྩ་བ་སུན་འབྱིན་གྱི་འགྲེལ་པ་འདི་ལུང་རིགས་ཀྱིས་ཚར་བཅད་ལ་ཁོ་རང་གསུབ་ཏུ་གཞུག་དགོས་གསུངས་ནས་འབྱོན་པར་བརྩམས།",
    "བརྩོད་པར་བྱའོ་ཞེས་བྲིས་པས་བསྡད་འདུག་པ་དང་བརྩོད་པས་ལན་གསུམ་དུ་སློབ་དཔོན་རྒྱལ་ཡང་བསྟན་པ་ལ་འཇུག་དུ་མ་བཏུབ།",
    "གསུམ་པ་ཚིག་ཟུར་གྱི་ནུས་པ་དང་འཕྲོས་པའི་དོན་རྣམས་མ་བྱུང་འདུག་རུང་དངོས་བསྟན་ཙམ་བྱུང་འདུག་འོན་ཀྱང་ངའི་རིཊ་པ་འདི་གཞན་གྱིས་ཇི་ལྟ་བ་མི་ཤེས་པར་འདུག་ཅེས།",
    "འདི་ན་རོ་པ་པཎྜི་ཏ་མཛད་པའི་དུས་ཡིན་པར་འདུག་སཱ་དྷུ་བུ་དྲ་ནི་ལེགས་པའི་སྲས་ཞེས་བྱ་སྟེ་མཚན་དངོས་ཤྲཱི་དྷ་ར་དཔལ་འཛིན་ནོ།",
    "ཡི་དམ་གྱིས་བྱོན་པར་འདུག་སྟེ་མ་ཤེས་པར་འདུག་གསུངས།",
    "ཆུ་སྐྱོགས་ལ་སོགས་པ་རྣམས་དབྱིབས་ཐ་དད་པར་འཛིན་ཙ་ན།",
    "བྱ་བའི་ཆུ་རྒྱུས་སུ་འདུག་པའི་ཕྱིར་རོ།",
    "འོ་གའབྲོང་པའི་ཁམས་འདིར་གཅུགས་མེད་པར་ཡང་འདུག་ལ་སྙོམས་པར་ཞུགས་པ་ལ་ཡོད་པར་འགྱུར་ཏེ།",
    "དཔེར་ན་དུས་དང་རང་བཞིན་དང་མཐུ་དང་ལྡན་པས་དུང་།",
    "དེདག་ལས་བཏོན་ནས་འདུག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི།"
  ]
}