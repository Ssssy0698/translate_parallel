    "ཀློག་མཁན་ཞིག་ལ་མཚོན་ན་རོལ་མྱོང་གི་བར་སྟོང་བརྗོད་དུ་མེད་པ་ཞིག་སྦྱིན་ཏེ།",
    "ཐོས་བྱུང་ངམ་ཞེས་ཕ་རོལ་བོར་ངག་རང་སེམས་སྤྲོ་སྐྱིད་ཀྱིས་སིམ་པའི་སེམས་ངོ་དེ་ང་ཚོས་སྙན་མོས་དྲིས་པ་ལས།",
    "ངང་གིས་རྟོགས་ཐུབ།",
    "དེ་ལྟ་བུའི་སེམས་ཁམས་ལས་ཐོན་པའི་བརྗོད་བྱའི་སྒྱུ་རྩལ་དུ་ང་ཚོས་མཐོང་བ་ནི་མངོན་ཆུང་གི་དྲིན་གཟོའི་སྣང་བརྙན་ཞིག་ཡིན།",
    "བདག་མོ་ཞི་འཇམ་ཞིག་གི་སྣང་བརྙན་ཡང་མཐོང་ཐུབ།",
    "བདག་གི་མཁའ་དབྱིངས་མཐོན་པོར་འདེགས་པའི་ཀ་བ་ཇི་བཞིན།",
    "ངས་དགུན་དུས་ཧྲིལ་བོ་ཞིག་གི་བསམ་གཞིག་ཁྲོད་ནས་ཁྱོད་ཀྱི་གཏན་ཚིགས་ཚོར།",
    "ངས་རྒྱུ་སྐར་འཁྲིགས་པའི་མཚན་ལྗོངས་ཤིག་གི་མཛུབ་རྩེ་ནས་ཁྱོད་ཀྱི་འཛུམ་མདངས་རྙེད།",
    "བགྲང་བྱ་ཁྲི་ཕྲག་གི་སྦས་སྐུང་ཟབ་མོ་ཁྱོད་ཀྱི་རྫ་སྲུབས་ནས་འཕྱུར་ཞིང་།",
    "དཔའ་བོའི་གཡུལ་འཁྲུག་གི་མཛད་རྗེས་ཟླུམ་པོ་ཁྱོད་ཀྱིཔང་ནས་བཞུར།",
    "ཁ་དཀར་རྐྱང་གིས་བང་རྩལ་འགྲན་སའི་སྤང་ལྗོངས་ནེམ་མོ།",
    "ཁྱོད་ཀྱི་རྟོགས་བརྗོད་དང་རེ་སྨོན་ཡོད་ཚད།",
    "རྨ་ཀླུང་རིང་མོའི་རོལ་དབྱངས་ཀྱིས་ཁྱེར་ཏེ།",
    "ཁྱོད་ཡོད་པ་ནས་བཟུང་།",
    "ངའི་མིག་གི་མཁའ་དབྱིངས་སུ་བཀྲ་བའི་མེ་ཏོག་དཀར་པོ།",
    "ཁྱོད་མཐོང་བས་བདག་གི་ཕུགས་བསམ་གྱི་འཇིག་རྟེན་ནི་ལྗང་ཞིང་སྣུམ་པར་གྱུར།",
    "བདག་གི་ཚེ་སྲོག་གི་བཞུར་རྒྱུན་དྭངས་མོ་ཡ།",
    "ངས་ནམ་ཡང་ཁྱོད་ལ་སྙན་ངག་གི་བདེན་དཔང་བརྗོད།",
    "ངས་ནམ་ཡང་ཁྱོད་ཉིད་དབུ་ཐོད་ཀྱི་ཞྭ་བཞིན་བཀུར།",
    "ཁྱོད་ཉིད་ནམ་ཡང་ཁོ་མོའི་ཡིད་ཀྱི་སྐྱེད་ཚལ་དུ་བརྟན་པོར་བཞུགས་རོགས།",
    "དཔྱད་པ་རྨ་ཆེན་གངས་རི་ནི་སྙན་ངག་གི་འཇིག་རྟེན་ཞིག་དང་།",
    "གཟུངས་ཕྱུག་སྐྱིད་ཀྱིས་སེམས་རྒྱ་ཡངས་པོའི་སྨྱུག་འོག་ལས་ང་ཚོར་གནས་རི་དེར་ཕྱོགས་གཞན་ཞིག་ནས་རོལ་མྱོང་བྱེད་པའི་ཐབས་ལམ་བསྟན་བྱུང་།",
    "བདག་གི་མཁའ་དབྱིངས་མཐོན་པོར་འདེགས་པའི་ཀ་བ་ཇི་བཞིན།",
    "ངས་རྒྱུ་སྐར་འཁྲིགས་པའི་མཚན་ལྗོངས་ཤིག་གི་མཛུབ་རྩེ་ནས་ཁྱོད་ཀྱི་འཛུམ་མདངས་རྙེད་ཅེས་མོ་རང་ཉིད་ཀྱིས་དངོས་སུ་གནས་རི་དེར་ཡུལ་སྐོར་བྱེད་པ་དང་མིག་གི་སྤྱོད་བྱར་མ་གྱུར་ཀྱང་།",
    "དེར་ཡུན་རིང་སྨོན་པ་དང་བརྗོད་འདུན་ཞིག་གི་རྟེན་གཞིར་བསླངས་ཡོད་ཕྱིར།",
    "སྐབས་འདིར་རང་ཚོར་དུ་གནས་རི་ཞིག་གི་ཡུལ་བཀོད་ལ་ཡིད་སྤྲུལ་ལས་བྱུང་བའི་སྤྲོ་སྣང་ཙམ་དུ་མ་བསྒྱུར་པར།",
    "རང་སེམས་ཀྱི་སྤོབས་པ་ཞིག་གི་སྔོན་འགྲོ་རུ་བསྒྲིགས་པས་སྙན་ངག་ལ་ཡིད་ཡུལ་ཆེན་པོ་ཞིག་གིས་རམ་འདེགས་ཐོབ་པས།",
    "ཀློག་མཁན་གྱི་ཐོག་མའི་ཚོར་སྣང་དུའང་ཡུལ་བཀོད་ཅིག་གི་བརྗིད་སྣང་ཞིག་དང་།",
    "བགྲང་བྱ་ཁྲི་ཕྲག་གི་སྦས་སྐུང་ཟབ་མོ་ཁྱོད་ཀྱི་རྫ་སྲུབས་སོ་ལྟ་དང་གཟབ་ཉན།",
    "ཁ་བའི་དར་རྒུད་ཀྱི་རྨ་ཁ་ང་ཡི་རུས་གཏིང་ནས་རིམ་བཞིན་འཕག་སྤྱིར་ཡུལ་ལྗོངས་ཤིག་ལ་བརྟེན་ནས་རང་གི་ཚོར་འདུ་བརྗོད་པའི་སྙན་རྩོམ་མང་ཆེ་བ་ཞིག་ཐོག་མར་ལྗོངས་དེའི་ཡུལ་བཀོད་ཀྱི་རྣམ་པ་དང་གནས་ཡུལ་སོགས་བརྗོད་པ་བརྒྱུད་དེ།",
    "རང་གི་ཚོར་འདུ་ཅི་རིགས་ཕྱིར་མཚོན་པ་ཞིག་ཡིན་ཀྱང་།",
    "སྙན་རྩོམ་འདི་དེ་ལས་ལྡོག་སྟེ་རང་གི་རྟོག་སྣང་ཁྲོད་བསླངས་པའི་གནས་རི་དེ་ལ།",
    "རང་སེམས་ཀྱི་བརྗོད་འདུན་ནམ་ཕུགས་རེ་དེས་རྨ་ཆེན་གངས་རི་རང་གི་སེམས་སྟོབས་ཤིག་ལས་ས་བཅུ་པའི་ཐིལ་ཤུགས་བྱུང་བས།",
    "ང་ཚོས་མཐོང་བ་ནི་གཏན་ཆགས་ཀྱི་གངས་རི་ཞིག་མིན་པར།",
    "རང་སྦྱོང་གི་ལམ་བུ་ཙམ་བརྒྱུད་ནས་འོངས་པའི་སྙན་ངག་མཁན་དེར་འདི་ལྟ་བུའི་སྒྱུ་རྩལ་གྱི་ཚོར་བ་ལྡན་པ་ལ་ང་ཚོས་ཡི་རང་ཅིས་མི་བྱེད།",
    "དེང་གི་བརྡ་འཕྲིན་གྱི་དུས་རབས་སུ་འཚོ་བ་རོལ་བའི་མི་རིགས་དང་རིགས་རྒྱུད་གང་ཡིན་ཀྱང་།",
    "ཁག་ཅིག་གམ་སྲོག་གི་ཉེན་ཁའི་སྔོན་དུ།",
    "རྩོམ་མཁན་གྱིས་མཐོང་སྣང་དེ་ལྟ་བུའི་སྒོ་ནས་རང་གི་འདོད་འདུན་དེའང་མངོན་གསལ་དོད་པོར་གངས་རི་ཞིག་གི་བསྡུས་བརྗོད་ལས་ཕྱིར་མཚོན་བྱས་འདུག་རྨ་ཆེན་གངས་རི།",
    "ཁྱོད་ཉིད་ནམ་ཡང་ཁོ་མོའི་ཡིད་ཀྱི་སྐྱེད་ཚལ་དུ་བརྟན་པོར་བཞུགས་རོགས།",
    "མེས་པོའི་བརྒྱུད་རིམ་ཞིག་གི་རྒྱུས་ལོན་ལས་བྱུང་བའི་ཤེས་དད་ཅིག་དང་།",
    "ཡང་བརྗོད་སྟངས་འདི་ལ་ཕྱོགས་གཞན་ཞིག་ནས་བསམ་བློ་རེ་བཏང་ན།",
    "རང་འདུན་ཐད་ཀར་དུ་བརྗོད་པ་ཐལ་དྲགས་པས་རང་བབ་དང་མི་འཚམ་པའི་འུད་ཀྱི་ཆ་ཅུང་ཤས་ཆེ་བས།",
    "ད་དུང་རྩོམ་མཁན་རང་ལ་སྒྱུ་རྩལ་གྱི་རང་གཤིས་གཏན་འཇགས་མིན་པའི་གཉོམ་ཆའང་མངོན་གསལ་དུ་མཐོང་སླ་བ་ཡིན་མོད།",
    "མཐོ་སྒང་གི་དར་ལྕོགཚེ་བརྟན་རྒྱལ།",
    "ང་ཚོས་ས་ཆེན་གྱི་ཐོང་ག་ནས།",
    "ཕྱིས་འབྱུང་འཇིག་རྟེན་ཞིག་གི་ལམ་སྣེ་གཏད།",
    "མི་རབས་ཤིག་གི་སེམས་ཤུགས་དང་ལང་ཚོ།",
    "ང་ཚོས་ལང་ཚོ་དང་ཚེ་སྲོག་གི་རིན་ཐང་ཕུལ་ཏེ།",
    "མཛེས་སྡུག་གི་ལང་ཚོ་བསྟན།",
    "ང་ཚོས་ཟུངས་ཁྲག་དང་རྔུལ་ཆུ་བཏོན་པའི་ཉིན་མཚན་ནང་།",
    "ང་ཚོས་སྐྱེས་ཆེན་ཚོ་དཔེ་རུ་དྲངས་ནས།",
    "བྱིས་པ་ཚོར་སེམས་ཤུགས་དང་ལ་རྒྱ་བསྐྱེད་དུ་བཅུགང་ཚོ་འདི་ལྟར་ན་རྒས་ཏེ།",
    "དཀའ་སྡུག་གི་འགྲུལ་བཞུད་ལས་ཅི་ཡང་མ་ཐོབ་ཀྱང་།",
    "ང་ཚོ་ཕམ་མེད་འགྱོད་མེད་དུ།",
    "བོད་རང་ལ་མཚོན་ན་འདིའི་ཐད་ཀྱི་འབྲས་བུ་ནི་གཞན་གྱི་དོ་ཟླར་མི་ཡོང་བ་ཞིག་ཡིན་མོད།",
    "མེས་པོ་གོང་མ་དག་གིས་བསྟོད་ཡུལ་གྱི་ཕྱི་ནང་གསང་གསུམ་ལ་རང་བློས་ཐེག་ཚོད་དུ་སྤྱིར་བཏང་གི་ཀློག་མཁན་དག་ལ་མཚོན་ན།",
    "དེང་རབས་པ་མང་བོ་ཞིག་གི་བློར་མ་ཤོང་བས།",
    "ང་ཚོའི་སྣང་ངོར་བསྟོད་ཡུལ་དེར་ལྷའི་འདུ་ཤེས་ལས་རང་མཉམ་གྱི་གང་ཟག་ཅིག་མིན་པའི་རྣམ་རྟོག་སྐྱེས་ལ།",
    "དེར་བརྟེན་རང་རང་གི་རྟོག་སྣང་དུ་འུད་ཀྱི་ཆ་མང་བ་དང་བདེན་པའི་སྣང་བ་འབྱུང་ཐབས་བྲལ་པསརྩོམ་རིག་ངོས་ཐད་ནས་སྒྱུ་རྩལ་གྱི་ཟིལ་ཤུགས་མེད་པར་སྙམ་པ་ཡིན་ངེས།",
    "མཐོ་སྒང་གི་དར་ལྕོག་ཅེས་པའི་སྙན་རྩོམ་འདི་རྒྱུན་ལྡན་འཚོ་བའི་དངོས་གཞི་ལས་མགོ་བརྩམས་ཏེ།",
    "འདུན་མ་ཞིག་གམ་དོན་དམ་གྱི་འགན་འཁྲི་ཞིག་གིས་རྐངབའི་རྟེན་ནི་ས་ཆེན་གྱི་ཐོང་ག་ཡིན་པའི་སྤོབས་པ་དེ་ཕྱིས་འབྱུང་འཇིག་རྟེན་ཞིག་གི་དར་རྒུད་ལ་དཀྲིས།",
