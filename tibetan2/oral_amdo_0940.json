    "ངས་མཐའ་མཇུག་གི་རེ་སྨོན་གང་ཡང་ཞུ་མི་སྤོབས།",
    "ཡིན་ནའང་གསལ་ལྷང་ངེར་ཁྱེད་ཕེབས་སོང་།",
    "ཁྱེད་ཀྱིས་ས་གཞི་འདིར་བརྩེ་བྱམས་ཀྱི་འཛུམ་མདངས་གསར་བ་ཞིག་བསྣན་སོང་།",
    "ཁྱེད་ཉིད་འཕུར་བའི་གཤོག་སྒྲོའི་སྟེང་ལོ་ངོ་དུ་མའི་ཟླ་འོད་དང་རྒྱུ་སྐར་བརྩེགས་ཡོད་པ་རེད་ཨང་།",
    "རི་རབ་གཙང་པོ་ཁྲི་ཕྲག་གི་མུ་མཐའ་ལས་བརྒལ་ཏེ།",
    "བདག་གི་བརྩེ་གཤིན་གྱི་ཆུ་འཛིནཡིན་ནའང་ཁྱེད་ཀྱིས་འགྲོས་རིམ་གྱི་སྲབ་ཁ་ཡང་དུ་བཀག་སྟེཕྱི་མིག་ལིང་ལིང་གིས་གང་ལ་ལྟ།",
    "སྐོམ་གདུང་གི་རི་ཚོགས་འདི།",
    "ད་དུངའཁྱག་གྲང་གི་སེམས་པ་འདི་ཡོད་ཚད་ཀྱིས་ཁྱེད་ལ་རེ་སྒུག་བྱས་ཡོད་ལགསཁྱེད་ཕེབས་ཤིག།",
    "ཡིད་ཡུལ་གྱི་ཚོད་འཛིན་དང་ལྷད་མེད་ཀྱི་ཚོར་འདུ་གཉིས་སྙན་ངག་གི་སྒྱུ་རྩལ་ཁྲོད་དུས་ནམ་ཡང་མཚེས་སུ་གནས་པ་ཞིག་ཡིན།",
    "སྙན་རྩོམ་འདི་ཐོག་མར་བཀླགས་མ་ཐག་སྣང་བ་ཞིག་ལ་ཆེས་སྤྱིར་བཏང་གི་རང་བཞིན་བརྗོད་པ་ཞིག་ཏུ་འཁྲུལ་མོད།",
    "ཞིབ་ཏུ་བསམ་བློ་རེ་བཏང་ན་དགེ་སློབ་ཕན་ཚུན་གྱི་བརྩེ་དུངས་དང་ཕན་ཚུན་སྐུལ་སློང་གི་ཚོར་འདུ་དེ།",
    "འདིར་བཀོད་པའི་ཚིག་སྦྱོར་ལྟར་དྭངས་གསལ་ཤེལ་གོང་གི་རང་བཞིན་ཉིད་དུ་མཆིས་ལ།",
    "མི་རིགས་དར་སྤེལ་དང་བརྩེ་དུངས་གཞན་ཞིག་གི་ཀློང་དུ་དྲངས་ཡོད་པས་ན།",
    "ཀློག་མཁན་ལའང་བསམ་གཞིག་བྱེད་སའི་བར་སྟོང་ཕྱེས་ཡོད་པ་རེད།",
    "རང་སེམས་ཀྱི་འདོད་བློ་དེར་ཕྱི་ཡུལ་གྱི་རྟེན་གཞི་ཞིག་བདམས་ཐོག་འོས་ཤིང་འཚམས་པའི་ཡིད་ཡུལ་གྱི་ཚོད་འཛིན་ལས་ང་ཚོའི་སྣང་བ་དེ་ཡང་མཐོང་རྒྱ་ཡངས་པའི་གནས་གཞི་ཞིག་ཏུ་འདྲེན་ཐུབ་པར་མ་ཟད།",
    "མི་ཡུལ་གྱི་ཆེས་དག་གཙང་གི་བརྩེ་དྲོད་ལས་བྱུང་བར་བརྟེན།",
    "ཁྱེད་ཀྱིས་ས་གཞི་འདིར་བརྩེ་བྱམས་ཀྱི་འཛུམ་མདངས་གསར་བ་ཞིག་བསྣན་སོང་ཞེས་དུས་ཀྱི་བགྲོད་པ་ལས་བདེན་དཔང་ཐོབ་པའི་རིན་ཐང་ཞིག་ལ་ཁས་ལེན་དང་།",
    "དེའི་ནུས་པར་ཡིད་ཆེས་ལས་ཐོན་པའི་འབྱུང་འགྱུར་ལ་རེ་བཞག་གིས་ཁེངས་པའི་སྨོན་འདུན་ཡིན།",
    "སྣང་བརྙན་ཅན་གྱི་དཔེ་འཇལ་མཚར་བོའི་སྒོ་ནས་རང་སེམས་ཀྱི་ཚོར་ཤེས་ཤིག་ལས་ཀློག་མཁན་རེ་རེའི་མྱོང་གོམས་ལ་བསྟར་པས།",
    "སུ་ཡིན་རུང་བདེན་སྣང་ཁྲོད་རང་རྟོག་ལས་ཐོན་པའི་མཛེས་པ་རེ་རེ་བཞིན་མྱོང་ཐུབ་བོ།",
    "རི་རབ་གཙང་པོ་ཁྲི་ཕྲག་གི་མུ་མཐའ་ལས་བརྒལ་ཏེ།",
    "ཕན་ཚུན་ཡིད་ཆེས་དང་ཕན་ཚུན་གཉིས་ཀའི་སྐྱོན་ཡོན་རང་རང་གི་ཡིད་སེམས་སུ་བཅལ་ཚར་རྐྱེན།",
    "རྒྱང་བཞུད་ཀྱི་ལྟ་གོན་མཛད་ཅིང་རང་གིས་རང་ལ་ཡིད་ཆེས་ལས་བྱུང་བའི་སྤོབས་གདེང་ཞིག་དང་།",
    "ལོ་ངོ་སྟོང་ཕྲག་གི་རྨ་ཁས་ཁྱེད་ཀྱི་དག་གཙང་གི་སེམས་པ་འགོག་མི་ནུས།",
    "ཚོར་ཤེས་ལ་སིམ་པའི་ཤེས་རྟོགས་ལས་བྱུང་བའི་ཚོར་འདུ་ཞིག་ཏུ་བསྟར་འདུག་དེར་བརྟེན་རེ་བཞག་དང་སྨོན་འདུན།",
    "ཀྱི་མཐོ་ཚད་ཅིག་ལས་ཀློག་མཁན་ལ་གནང་བ་ནི་དུངས་སེམས་རྣལ་མ་ཞིག་གི་རང་གཟུགས་ཡིན།",
    "ཡུལ་བཀོད་ཀྱི་སྒྲིག་སྟངས་ལྟར་སྣང་བའི་ཚོར་འདུ་གཉིས་ནི་སྒྱུ་རྩལ་གྱི་བར་སྟོང་ཞིག་ཏུ་ཕན་ཚུན་ལ་རམ་འདེགས་ཀྱི་བྱེད་ནུས་ཐོན་ཡོད་པར་མ་ཟདབརྗོད་དོན་དེ་ཡང་མི་སྒེར་གྱི་རང་སྣང་ལས་བརྒལ་ཏེ་ཁྱབ་ཆེ་ས་ཞིག་ནས་དཔངས་རྒྱ་ཞིག་དང་ཟབ་ཚད་ཅིག་གི་དཔང་བོར་གྱུར།",
    "ཡིད་ཡུལ་གྱི་བཀོད་སྒྲིག་ལེགས་པས་བརྗོད་བྱའི་བསྟན་དོན་དེའང་ཀློག་མཁན་གྱིས་མྱོང་རོལ་ཁྲོད་མཐོང་ཐོས་མྱོང་གསུམ་གང་རུང་ལ་ཉམས་སྣང་ཐད་ནས་རེ་རེར་བྱེ་བྲག་པ་རེ་ཐོབ་སྐལ་ལྡན་པས།",
    "ངས་ཁྱེད་ཀྱི་མདུན་དུ་པུས་མོ་ས་ལ་བཙུགས།",
    "མི་ལོ་ཉི་ཤུའི་ལང་ཚོ་དང་ཡིད་སེམས་ཡོད་ཚད་བློས་བཏང་བའི་མཛད་རྗེས་ཡོད་མྱོང་།",
    "ད་ལྟ་ལེ་བར་སྟོང་ཕྲག་གི་བར་ཐག་གོམ་པས་བསུབས་ནས་འོངས་དུས།",
    "སྐབས་འདིའི་འདུ་འཛོམས་ལ་ཤུགས་རིང་གི་ཡུས་འཇོག་དོན་མེད།",
    "ངས་རེ་སྒུག་གི་མེ་ཏོག་མཐོ་རུ་བཏེགས་ཏེ་བརྩེ་དུངས་ཀྱི་འོད་སྣང་རེ་སྐབས།",
    "ཁྱོད་ནི་གློག་ཤུགས་ཐེབས་པ་བཞིན་མྱུར་མྱུར་དུ་གྱེས་དོན་ཅི།",
    "འཕྱ་ཁྲེལ་གྱི་མཛུབ་མོས་མི་སྡིགས་རོགས།",
    "ངས་ད་གཟོད་མདང་དགོང་གི་རྨི་ལམ་དེ།",
    "མེ་ཏོག་གི་འདབ་མས་ཁེངས་པའི་དཔྱིད་དུས་ཀྱི་རེ་སྨོན་ཞིག་ཡིན་པ་ཚོར།",
    "སྐབས་འདིར་པུས་མོ་ལ་ན་ཟུག་ཅུང་ཙམ་བྱུང་སྟེ།",
    "ངས་ངོ་མ་ལང་ཚོ་དང་ཡིད་སེམས་ཡོད་ཚད་གཏོང་དགོས།",
    "ལོའི་སྦྲང་ཆར་དེབ་གཉིས་པ་ལས་བདམས་དཔྱད་པ་བདེན་ཏེ་ཞེས་དྲི་བ་ཞིག་གི་ལན་དུ་གནང་བའི་བདེན་ཁ་བརྩེ་དུངས་དེར་བློས་གཏོང་གི་སེམས་པ་སྙན་རྩོམ་འདི་གླེང་བསླངས་མ་བཞིན།",
    "རྩོམ་མཁན་གྱི་རང་གཤིས་དེའང་ང་ཚོས་ཕྱོགས་གཞན་ཞིག་ནས་རྟོག་འཆར་ཁྲོད་རྙེད་ཐུབ།",
    "སྙན་རྩོམ་ཞིག་གི་སྒྱུ་རྩལ་གྱི་མཐོ་དམན་དེ་ཚད་ངེས་ཅན་ཞིག་ཏུ་རྩོམ་མཁན་གྱིས་སྐད་ཆའི་བཀོད་སྒྲིག་དང་བཀོལ་སྤྱོད་ཀྱི་ནུས་པར་རག་ལས་པ་ཡིན།",
    "སྤྱིར་ཕན་ཚུན་བར་གྱི་བརྩེ་དུངས་བརྗོད་པའི་སྙན་ངག་ནི་བགྲང་གིས་མི་ལང་མོད།",
    "ངས་ཁྱེད་ཀྱི་མདུན་དུ་པུས་མོ་ས་ལ་བཙུགས་ཞེས་ཕོ་མོ་བར་གྱི་བརྩེ་དུངས་ཤིག་གི་ཐད་ནས་བལྟས་ན།",
    "བོད་མི་སྤྱིའི་སེམས་ཁམས་དང་མཛེས་དཔྱོད་ཀྱི་གོམས་གཤིས་ལས་འདའ་བ་ཞིག་ཏུ་སྣང་མོད།",
    "སྙན་རྩོམ་དེ་ལས་རྩོམ་མཁན་རང་ཉིད་བོད་མིའི་མཛེས་དཔྱོད་ཁྲོད་ཀྱི་སྒམ་པོ་ཞིག་དང་རེ་ཞིག་འགལ་བར་སྙམ་པའི་མྱོང་ཚོར་དེ་ལས་གཞན།",
    "སྒྱུ་རྩལ་མཐའ་དག་དགོངས་པ་ཅན་དུ་ངེས་པས་མྱོང་རོལ་དང་གོ་ལོན་གྱི་ཚད་ནི་ཀློག་མཁན་རང་རང་གི་མྱོང་སྟོབས་ལ་རག་ལས་ཕྱིར།",
    "ང་ཚོས་མཐའ་གཅིག་ཏུ་སྡོམ་ཚིག་ཅིག་ལ་རེ་དགོས་དོན་གཏན་ནས་མེད།",
    "རང་གི་རྟོག་པ་ལས་གང་དགར་སྒྱུ་རྩལ་གྱི་ཡུལ་ཁམས་ཤིག་ཏུ་བཞག་ཆོག་པ་ཡིན།",
    "རྩོམ་མཁན་གྱིས་བརྗོད་བྱའི་སྔོན་འགྲོ་དེ་ལྟ་བུ་ཞིག་བསྐྲུན་ཐོག་ང་ཚོ་ལ་སྤྱི་མཚན་འབའ་ཞིག་གིས་བསླུ་བྲིད་འོག་རིམ་བཞིན་ཕན་ཚུན་འགལ་རྐྱེན་གྱི་རྒྱུ་ཏིལ་འབྲུ་ཙམ་ཡང་མ་བསྟན་ཅིང་།",
    "མི་ལོ་ཉི་ཤུའི་ལང་ཚོ་དང་ལེ་བར་སྟོང་ཕྲག་ཅེས་མི་ཚེ་ཞིག་ལ་མཚོན་ན་གལ་ཆེ་བའི་དུས་རིམ་ཞིག་བློས་བཏང་དང་བར་ཐག་གི་ངལ་བར་མི་འཛེམ་པའི་ཞེན་ཆགས་ཤིག་ལས་སླར་ཡང་སྤྱི་མཚན་རང་བཞིན་དུ་ང་ཚོར་བརྩེ་དུངས་ཤིག་གི་ལྗིད་ཚད་དེ་རང་རང་གི་མྱོང་རོལ་གྱི་ནུས་སྟོབས་ལས་འཇལ་དུ་བཅུག་ནུས་མེད་ཀྱི་ལག་པ་འདིར་བརྩེ་བྱམས་ཀྱི་དྲོད་འཇམ་ཇི་འདྲའི་མཁོ་ཨང་།",
    "བསྡུས་བརྗོད་དང་དཔེ་གབ་འཇལ་གྱི་བརྗོད་སྟངས་སམ་ལག་ཐབས་ལས་ངེས་བསྟན་གྱི་བརྗོད་བྱ་ཞིག་ལ་ལག་སྙོབ་བམ་ང་ཚོར་གནས་ལུགས་ཤིག་རྟོགས་པ་ལས་ཐོན་པའི་རིག་རྟོག་གི་དགའ་སྣང་མེད་མོད།",
    "ཀློག་མཁན་རང་རང་ལ་གནང་བའི་རྟོག་འཆར་གྱི་བར་སྟོང་དེ་རང་རང་གི་ནུས་སྟོབས་སུ་གང་དགར་རྒྱ་བསྐྱེད་པའམ་གུ་དོག་པོར་བཟོ་ཐུབ་པ་ཞིག་ཡིན།",
    "ངས་རེ་སྒུག་གི་མེ་ཏོག་མཐོ་རུ་བཏེགས་ཏེ་བརྩེ་དུངས་ཀྱི་འོད་སྣང་རེ་སྐབས།",
    "ང་ཚོ་འཚོ་སྡོད་ཀྱི་མི་ཡུལ་འདིར་སྙན་རྩོམ་འདི་ལས་དྲངས་པའི་བརྩེ་དུངས་དང་བརྩེ་དུངས་དེ་ལྟ་བུ་སྲུང་སྐྱོབ་བྱེད་པ་ནི་འགྲོ་བ་མིའི་མཐར་ཐུག་གི་མཛེས་སྡུག་ཅིག་མིན་ནམ།",
    "ངས་ད་གཟོད་མདང་དགུང་གི་རྨི་ལམ་དེ།",
    "ཞེས་གོང་གི་གླེང་སྐྱོས་ཁེངས་པའི་སྤྱོད་ཚུལ་ལམ་སྣང་བརྙན་དེ་ཅུང་ལྷོད་ཤ་ལྡན་པར་སྒྱུ་རྩལ་གྱི་གནས་བབ་ཤིག་ཏུ་སྐྱེལ་སླད།",
    "ཕར་ལྟོས་ཚོད་ལ་སྤྱིར་བཏང་གི་ཚིག་ཙམ་དུ་མངོན་ཡང་།",
    "ཆར་ཟིམ་ཟིམ་ཞིག་ཞེས་མཛེས་སྡུག་གི་ཕྱི་ཚུལ་ཞིག་བསྐྲུན་ཐོག་རང་སེམས་ཀྱི་རྟ་ཁ་དེའང་བག་ལྷོད་པོར་མྱོང་མཁན་གྱི་རྟོག་འགྱུའི་ཁྲོད་ཚད་དང་རན་པར་བཀག་པས།",
    "མ་གཞི་རྨི་ལམ་ཞིག་རེད་སྙམ་པའི་དབུགས་དབྱུང་བར་བྱས་པའི་མྱོང་སྣང་དེའང་རང་བྱུང་ཉིད་དུ་བསྩལ་བྱུང་།",
    "བརྩེ་དུངས་དེའི་ཆེད་དུ་བློས་བཏང་ཡོད་ཚད་ཀྱི་འབྲས་བུའི་རྒྱུ་དེ་སྒྱུ་འཕྲུལ་གྱི་རྨི་ལམ་མིན་པའི་སེམས་འདུན་དེ་ཀློག་མཁན་གྱི་མྱོང་རོལ་གྱི་མཁའ་དབྱིངས་སུ་ཉི་མའི་ཀློང་ན་འབབ་པའི་ཆར་བ་ཟིམ་ཟིམ་ལྟ་བུར་དུས་དང་རྣམ་པ་ཀུན་ཏུ་ཚེ་སྲོག་ཅིག་གི་སྲོག་རྟེན་དུ་གྱུར་པའི་ཆུ་ཐིགས་བཞིན།",
    "རེ་རེའི་ཡིད་སེམས་ཀྱི་སྤང་ཐང་དུ་བརྩེ་དུངས་ཀྱི་མྱུ་གུ་མི་འབུ་ག་ལ་སྲིད།",
    "མགྲིན་ཁོག་ཏུ་ཡང་ཡང་འདྲིལ་ཏེ་སོང་།",
    "མིག་འདྲིས་སུ་སོང་བའི་ལག་སོར་དེས།་",
    "ཟུངས་ཁྲག་གི་རླབས་རྒྱུན་ཡང་མོ་ཞིག་འཁྱོམ་པ་ཚོར།",
    "ཕྱི་མིག་གི་བརྗོད་བྱ་སུས་ཀྱང་རྟོགས་དཀའ་བས།",
    "བོད་ཀྱི་ཉེ་བར་བརྩམས་པའི་ཕོ་མོ་བར་གྱི་བརྩེ་དུངས་བརྗོད་པའི་སྙན་ངག་མང་བོ་ཞིག་རང་འདུན་ཐད་ཀར་དུ་བརྗོད་པར་དགའ་ལ།",
    "རང་སྣང་གི་ཅི་བྱེད་ཆ་མ་འཚལ་བའི་ཚོར་འདུ་དེ་ཕྱི་ཚུལ་གྱི་རྣམ་པ་ཙམ་དུ་མ་བསྒྱུར་པར།",
    "འདི་རུ་རྒས་འཁོགས་ཀྱི་དཔེ་འཇལ་དང་དལ་བྲེལ་མེད་པའི་སྐྱིད་ལུག་གི་ཐ་སྙད་མེད་པར།",
    "ང་ཚོའི་རྟོག་འགྱུ་ཁྲོད་ཚོར་འདུ་དེ་ལྟ་བུ་རོལ་མྱོང་བྱ་ཐུབ་པ་ལས་གཞན།",
    "ཁོའི་ཆ་མ་འཚལ་བའི་རྣམ་འགྱུར་དེ་ཡང་མཐོང་ཐུབ་པའི་ཡུལ་ཁམས་ཤིག་བསྐྲུན་འདུག་མིག་འདྲིས་སུ་སོང་བའི་ལག་སོར་དེས།",
    "སྒྱུ་རྩལ་གྱིས་རིགས་འདེད་ཁྲོད་ང་ཚོས་ཀྱང་སྐབས་དེའི་ཕན་ཚུན་གྱི་སེམས་འགྱུ་དེ་རང་རང་གི་མྱོང་བ་ལས་རྟོག་བཟོ་བྱེད་ཐུབ་པར་སྐལ་གླགས་གནང་།",
    "ཕན་ཚུན་གྱི་རྣམ་འགྱུར་དང་མངོན་ཆུང་གི་སེམས་འགྱུ་ལས།",
    "གཉིས་ཀའི་བར་གྱི་བྱུང་ནས་འདས་པའི་ལྷད་མེད་ཀྱི་བརྩེ་དུངས་ཤིག་གི་བརྒྱུད་རིམ་དེའང་སླར་དྲན་རྟོག་བྱ་ཐུབ་པའི་སྣང་བ་སྟེརསྤྱིར་སྐད་ཅིག་མའི་ཚོར་རྟོག་ནི་ཡི་གེའི་ལམ་ནས་འཛིན་དཀའ་ཞིང་།",
    "ཕྱི་མིག་གི་བརྗོད་བྱ་སུས་ཀྱང་རྟོགས་དཀའ་བས།",
    "རང་རང་གི་མྱོང་སྣང་ལས་སྐད་ཅིག་མའི་རྣམ་པ་དེ་སྒྱུ་རྩལ་གྱི་ཡུལ་ཁམས་ཆེན་པོ་ཞིག་ཏུ་རྟོག་བཟོ་མུ་མེད་ཀྱི་ལས་ལ་བྲེལ་བ་ལས་ཐབས་གཞན་རྙེད་དཀའ་བ་ཡིན།",
    "སྙན་རྩོམ་འདི་ལས་ང་ཚོས་སྐད་ཅིག་མའི་སེམས་འགྱུ་གཉིས་ཀྱི་རང་གཟུགས་རེ་བློས་བསླང་བྱེད་ཐུབ་པར་མ་ཟད།",
    "ན་ཆུང་མ་ཞིག་གི་མཛེས་སྣང་ཞིག་ཀྱང་རྟོག་བཟོ་བྱེད་ཐུབ་པ་ཡིན།",
    "ཕྱི་ཚུལ་གྱི་རྣམ་འགྱུར་མཐོང་བ་ལས་གཞན་ཤ་ཆད་ཀྱང་རུས་འབྲེལ་བའི་བརྩེ་དུངས་ཤིག་གི་རོ་བྲོའང་མྱོང་ཐུབ།",
    "སྐབས་འདིར་ང་ཚོས་འུད་བསྟོད་ཙམ་དུ་སྙན་ངག་གི་མཚོན་སྟོབས་ཞེས་པ་དང་ཐབས་རྩལ་ཞེས་པར་གོ་བ་གཞན་ཞིག་བླང་ཆོག་པ་ཡིན་ཞེས་སྨྲ་མི་ཕོད་དམ།",
    "བསྐྱར་ཟློས་ཀྱི་འཚོ་བའི་ཁྲོད་ནས་ང་ཚོའི་རྨི་ལམ་ལ་ཚི་དྲེག་ཆགས།",
    "འོ་དྲི་དང་ལྕི་འདམ་ཁྲོད་དུ་ང་ཚོའི་ལང་ཚོར་མཚར་སྡུག་ཉམས།",
    "ཡོད་ཚད་ཁེར་རྐྱང་གི་སེམས་པར་རློམ་མི་དགོས་ཏེ།",
    "རེད་ལགས།",
    "ཉེ་བའི་དུས་སུའང་རྒྱ་ཆེ་བའི་གཞི་རིམ་དུ་ད་དུང་བུད་མེད་གང་མང་ཞིག་ཤིན་ཏུ་ཉམ་ཆུང་གི་གནས་སུ་བཅར་འདུག་ང་ཚོའི་རྒྱུན་ལྡན་གྱི་འཚོ་དངོས་དང་རང་རང་གི་དྲིན་ཆེན་མ་ཡི་སྟེང་དུའང་བུད་མེད་དག་ལ་གོ་གནས་ག་འདྲ་ཡོད་པ་ནི་གསལ་བོར་མཐོང་ཐུབ།",
    "ཕོ་མོ་འདྲ་མཉམ་གྱི་དུས་རབས་སུ་བསླེབས་ཕྱིར་འདི་ལྟ་བུའི་རྒོལ་གཏམ་ཐོས་པ་ནི་མི་རིགས་ཡོར་ཐོན་གྱི་དན་རྟགས་ཤིག་ཅི་མ་ཡིན།",
    "དེང་གི་དུས་འདིར་བསླེབས་རག་བར་དུའང་མ་ཅིག་ལབ་སྒྲོན་དང་རྒྱལ་ཡུམ་ཁྲི་མ་ལོབ།",
    "མཁའ་འགྲོ་ཡེ་ཤེས་མཚོ་རྒྱལ་སོགས་རེ་འགའ་ལས་མཛུབ་མོས་བགྲང་དཀའ་བ་ཡིན།",
    "འཆི་མེད་ནི་སྙན་ངག་གི་ལམ་དུ་ཞུགས་མ་ཐག་ནས་རྒོལ་སེམས་ཀྱི་འདུ་ཤེས་དྲག་པོ་ལྡན་པ་ཞིག་སྟེ།",
    "རང་བཀུར་རང་གཅེས་ཀྱི་འདུ་ཤེས་ཀྱང་རུས་རྐང་དུ་སིམ་འདུག་འདུ་ཤེས་དེ་ལྟ་བུའི་འོག་མོའི་སྡུག་བསྔལ་གྱི་གོ་རྟོགས་དང་དེར་བཟུང་བའི་རྣམ་འགྱུར།",
    "ཚེ་སྲོག་ལ་འཆང་བའི་ལྟ་སྟངས་སོགས་ནི་དེང་གི་གངས་ཅན་སྐྱེས་མ་དག་གི་ཐུན་མོང་གི་འདོད་བློ་ཞིག་ཏུ་འཁུམས་པས།",
    "མོས་སྙན་རྩོམ་གྱི་བརྗོད་བྱ་དེའང་ལྟོས་བཅས་སུ་མང་བོ་ཞིག་གི་མགྲིན་ཚབ་ཏུ་བཞག་ནའང་འགལ་བ་མེད།",
    "སྙན་རྩོམ་འདིའི་ཟུར་བཀོད་ཁ་བྱང་ལས་ཀྱང་ང་ཚོས་མོའི་སེམས་རྒྱ་མཐོང་ཐུབ་པར་མ་ཟད།",
    "མོའི་རྒོལ་སེམས་དེའང་ངེས་གཏན་གྱི་གཏད་གཞི་གང་ཡིན་པ་བསོ་ལྟ་དང་གཟབ་ཉན།",
    "རང་གི་མོས་འདུན་དང་གསར་གཏོད་ཀྱི་སྤོབས་སེམས་དེའང་གཅིག་བསྡུས་རང་བཞིན་དུ་བསྟན་ཡོད་པར་སྙམ།",
    "མོའི་བུད་མེད་ཀྱི་གཤིས་ཀ་ལས་བསྟར་བའི་ཞིབ་ཆ་ལྡན་པའི་ཚོར་ཤེས་དེས།",
    "དེ་དག་རང་སེམས་ཀྱི་འགྱུ་སྟངས་རིགས་ཤིག་གི་མཚོན་བྱེད་དུ་ཕུད་པ་ལས་གཞན།",
    "འབྱུང་འོས་པར་སྙམ་པའི་སྒྱུ་རྩལ་གྱི་བདེན་སྣང་དེའང་ངང་གིས་སྦྱིན་ཐུབ་པར་བཟོས་འདུག་ཀྱེ།",
    "དུས་རབས་འདི་ལ་གཏམ་རྒྱུད་གསར་ཞིག་འབུལ་ཞེས་དཔའ་མོའི་གད་རྒྱངས་ལྟ་བུའི་ཚིག་ཤུགས་སུ་སྤོབས་སེམས་ཀྱི་དཔུང་ཤུགས་ལྡན་པར་མ་ཟད།",
    "རྒོལ་སེམས་དང་མོས་འདུན་ནི་དུས་རབས་ཤིག་གི་བགོ་སྐལ་དུ་གྱུར་ཅིང་།",
    "དེར་བརྟེན་ང་ཚོས་མོའི་སྤོབས་པའི་འབྱུང་ཁུངས་ལ་ངོས་ཟིན་ཐོབ་པ་ལས་གཞན།",
    "དུས་རབས་ཤིག་གིས་སྙན་ངག་པ་ཞིག་དང་ལྷག་པར་དུ་རང་གཤིས་ལ་བཅིངས་འགྲོལ་ཐོབ་པའི་བོད་ཀྱི་བུད་མེད་སྙན་ངག་པ་ཞིག་ལ་གནང་བའི་འགན་ཁུར་དེའང་ཚོར་ཐུབ་ལ།",
    "མོ་ནི་འདུན་པ་དེའི་ཆེད་བློས་གཏོང་མཁན་ཁེར་རྐྱང་ཞིག་མིན་ལ།",
    "མོ་ལྟ་བུའི་དཔུང་ཚོགས་ཤིག་དུས་རབས་ཀྱི་འགྲོས་དང་བསྟུན་ནས་རེ་འདུན་འབུམ་ཕྲག་གིས་ཁེངས་པའི་ལམ་ཆེན་ཞིག་ཏུ་གོམ་འགྲོས་གསར་བའི་འདེགས་འཇོག་ལ་བྲེལ་བའི་ཉམས་སྣང་ཡང་སྦྱིན་འོང་།",
    "སྤྱིར་སྙན་ངག་ནི་དུས་རབས་རང་བཞིན་གྱི་ཕྱིར་མཚོན་ཡིན་ཞེས་པར་ཡང་སྐབས་འདིར་བདེན་སྣང་རེ་རྙེད་ཐུབ་མོད།",
    "སྙན་རྩོམ་འདིས་རང་ཚོར་ཐད་ཀར་དུ་བརྗོད་དྲགས་པས།",
    "ཁ་གཡང་གི་ཤན་ཅུང་ཆེ་བས་སྒྱུ་རྩལ་གྱི་ཡུལ་ཁམས་ལ་ཚད་བཀག་ཐེབས་ཤིང་།",
    "དཔེ་འཇལ་ལ་ལར་རྒས་འཁོགས་ཀྱི་རྣམ་པ་ཤར་པས་རྩོམ་སྤྱིའི་བརྗོད་བྱ་སྡོམ་ཚིག་གི་རང་བཞིན་ཅུང་ཆེ་བར་སྙམ།",
    "ལྟ་བ་འདི་རིགས་ང་རང་གི་གུ་དོག་པོའི་རྣམ་རྟོག་ཅིག་ཡིན་པར་སྨོན།",
    "སོར་ཚད་ཀྱིས་བཅད་པའི་རྩམ་རྡོག་རེ་རེ་དང་སྐྱོ་ངལ་མང་བོ་ཅིག་ཅར་ལྡོད་ཀྱིན།",
    "ཁྱོད་རང་བཙལ་བའི་སེམས་པ་ཆུང་ཆུང་དེ་ཡང་ནུབ་ཁའི་ཉི་འོད་དང་ལྷན་དུ་རྒས།",
    "དྲི་བཞོན་གྱི་ལག་ཟུང་སྙི་མོས།",
    "ལྡེམ་ལ་འཁྱུག་པའི་འཇོ་སྒེག་གི་གཤོག་འགྱུར་འཇམ་པོའམ།",
    "ཐིག་ཐིག་གི་རྡོག་སྒྲ་རྩུབ་མོ་དེས།",
    "ངའི་དྭངས་གཙང་གི་ལྷིང་འཇགས་ཁྱེར་ནས་གང་དུ་བགྲོད།",
    "ངའི་ཉིན་མཚན་གྱི་རྣམ་གཞག་ལྷག་མེད་དུ་བཤིག་པའི་ཉེས་པ་སུ་ཞིག་གིས་ཤེས།",
    "སུ་ལའང་མ་ཕོག་པའི་བདག་གི་མིག་འོད་ཐོག་མ།",
    "སྐར་མ་དང་རྩི་ཤིང་བཞིན་འདར་བའི་ལག་ཟུང་ཁྱོད་ལ་བསྲིངས་ཏེ་སྒུག།",
    "བརྩེ་མདངས་ཟབ་མོས་རྒྱང་རིང་ནས་རྒྱང་རིང་དུ་ཁྲིད་ཅིང་།",
    "ཕྱིར་འོང་སའི་ལམ་ལ་གདུག་རྩུབ་ཀྱི་རྣོ་དབལ་ཇི་འདྲ་མང་བོ་ཞིག་འཚང་ཡོད་པ་ཁྱོད་ཀྱིས་ག་ལ་རྟོགས།",
    "ཁོ་བོའི་ཞགས་པའི་སྣེ་མོ་ལ་ཅི་ཡང་འདྲོགས་པའི་ཁྱོད་རང་།",
    "སྐྱ་རེངས་ཀྱི་ཐུ་འོག་ལས་ཤོར་བའི་ཉི་ཟེར་དང་མཉམ་དུ་སླེབས་ན་ཡང་།",
    "མུ་ཏིག་བཞིན་འཚེར་བའི་སེམས་པ་དམར་པོ་ཞིག་ཐལ་བར་བསྲེག་ལ་ཉེ་ཨང་།",
    "ཁོ་བོའི་ལུས་ཟུངས་ལྷག་མེད་དུ་གཞིབ་པའི་གདུང་ཡུས་དེ་ཁྱོད་ལ་བརྗོད་ཐབས་བྲལ།",
    "བདག་ལ་བསྐྱུར་བའི་འཛུམ་དཀར་གྱི་ཁུགས་པ་རེ་རེར།",
    "ཁྱོད་རང་སྐྱེས་པའི་སྐར་ཆ་རེ་ཡང་བདག་གིས་ཡོངས་སུ་ཤེས།",
    "བདག་གི་ཅི་ཡང་མི་རྟོགས་པའི་ཁྱེད་ཀྱིས།",
    "དལ་འཇམ་གྱིས་བཞུར་པའི་དགུ་ཆུ་སྔོན་མོའི་གཡས་ལོགས་སུ།",
    "སུ་ཞིག་མཐོང་བའི་ཉམ་ཆུང་གི་ངོ་གདོང་ལ་ཡང་བསྐྱར་ལྟོས་དང་།",
    "ངས་ཐག་རིང་ནས་དཀའ་སྤྱད་ཀྱི་ལོ་ཟླ་རེ་རེ་རྡོག་པས་གནོན་ཀྱིན།",
    "བཟོད་དཀའ་བའི་མི་ཁ་དང་དམོད་མོའི་ཁྲེས་པོ་ལྕི་མོ་ཞིག་ཁུར་ནས་འོང་།",
    "རྦ་རླབས་བཞིན་འཕྱོ་བའི་མི་ཚོགས་ཀྱི་བང་རིམ་ནས་ཁྱོད་རང་ཟིན་དུས།",
    "ངས་མཐའ་མཇུག་གི་རེ་བ་གཞན་ཅི་ཡང་མི་ཞུ་སྟེ།",
    "ནམ་རྒྱུན་ཁྱོད་ལ་བཏེགས་པའི་ལག་ཟུང་གི་ཁྱོར་བའི་ནང་དུ།",
    "འཇིག་རྟེན་གྱི་ལྔ་ལམ་དུ་སུ་ཞིག་གི་རྡོག་སྒྲ་ཁད་ཀྱིས་ཚོར་འོང་སྲིདདེ་ནི་ཁོ་བོའི་དྲན་གདུང་དང་མཆི་མས་གྱེར་བའི་སྙན་ངག་༡དམར་པོ་ཞིགམཇུག་སྒྲིལ་བའི་མཉམ་སྒྲོཊ་རོལ་དབྱངས་ཡིན་པ་ཤེས་པར་གྱིས།",
    "སྙན་རྩོམ་འདི་ལྗང་བུའི་གཡའ་ཤིང་གི་ལོ་མ་ལྟར་ན་ཆུང་གཉིས་ཀྱི་ཐོག་མའི་བརྩེ་དུངས་ཤིག་གི་སེམས་འགྱུ་བརྗོད་པ་ལྟ་བུ་དང་།",
    "རང་གི་ཡིད་སེམས་ཀྱི་བག་ཏུ་ཡུན་རིང་ཉལ་བའི་འདོད་བརྩེ་ཞིག་དང་དེ་མངོན་འགྱུར་བྱེད་ཐབས་བྲལ་པའི་མནར་སྡུག་ཅིག་ལས་ཐོན་པའི་སེམས་ངལ་རིགས་ཤིག་གི་རང་བཞིན་བརྗོད་པ་ཡིན་པར་སྙམ།",
    "སྡུག་གིས་བཅངས་པའི་སེམས་པ་དེ་རྒྱུན་ལྡན་གྱི་འཚོ་བའི་སྤྱོད་སྟངས་ཤིག་དང་ནུབ་ཁའི་ཉི་འོད་སོགས་ངེས་གཏན་གྱི་ཡིད་བརྙན་དུ་མ་དང་།",
    "མོའི་མཛེས་སྣང་དེ་རང་སེམས་ཀྱིས་རྟོག་བཟོ་བྱས་པ་བརྒྱུད་ནས་འུ་ཐུག་པའི་དྲན་གདུང་ཞིག་དང་བཟོད་མེད་ཀྱི་སྡུག་བསྔལ་དེའང་མངོན་སུམ་བཞིན་དུ་ཕྱིར་མཚོན་བྱས།",
    "རྩོམ་མཁན་གྱིས་ཀྱང་སྡུག་བསྔལ་དེ་ལྟ་བུ་འབྱུང་རྐྱེན་གྱི་གཞི་བསྟན་ཐོག་མོར་འཆང་བའི་དྲན་གདུང་དེ་དུས་བཞིའི་འཁྱག་རོམ་ཞེས་དཔེ་འཇལ་དུ་ང་ཚོའི་ཚོར་རེག་གི་ལས་སུ་གྲུབ་པའི་དངོས་པོའི་ཟབ་ཚད་ཅིག་གི་རིམ་པ་ལས་རང་སེམས་ཀྱི་རེ་སྨོན་གཞན་ཞིག་ཕྱི་ལུས་ཀྱི་རྣམ་པར་སྦྱར་པས།",
    "ཀློག་མཁན་ལ་ཚོར་རྟོག་གི་གོ་སྐབས་ཤིག་ཀྱང་བསྟབས་ཡོད་པར་སྙམ།",
    "མོས་ཁོ་རང་ལ་སེམས་ངོ་མ་བསྟན་ལ་སྟོན་ཐབས་ཀྱང་བྲལ་མོད།",
    "མོ་གར་འགྲོ་འདི་འོང་གི་རྗེས་སུ་བསྙེགས་ཏེ་ཡང་ཡང་ཞུ་བ་དང་འདོད་བློ་བསྟན་མོད།",
    "ཁོའི་ཐོབ་སྐལ་ནི་སྒྲོལ་དཀར་མཚོ་ཞེས་འུ་ཐུག་ཉམ་ཆུང་གི་ཨུ་ཤུའི་སྒྲ་ཙམ་ཡིན།",
    "དང་བསྡུར་ན་དེར་ཐུན་མོང་མ་ཡིན་པའི་ཟིལ་ཤུགས་ལྡན་ན།",
    "མོར་འཆང་བའི་ལྐོག་གྱུར་གྱི་བརྩེ་དུངས་དེ་དང་བསམ་མེད་ཚོར་མེད་དུ་ཁོས་མོའི་ཆེད་དུ་རང་སྲོག་ཀྱང་བློས་གཏོང་ཕོད་པའི་སྡུག་བསྔལ་ལམ་དྲན་གདུང་།",
    "ཡང་ན་རེ་སྨོན་རིགས་ཤིག་གི་མཇུག་འབྲས་དེའང་ང་ཚོས་ཁྲོན་པའི་ཟླ་བ་བཞིན་གསལ་ལྷང་ངེར་མཐོང་ཐུབ་མོད།",
    "རང་གི་ཚོར་འདུ་དེ་རིགས་དཔེ་འཇལ་མང་བོས་བཟློས་དྲགས་པས་སྒྱུ་རྩལ་གྱི་བར་སྟོང་དེར་དགོས་མེད་ཀྱི་སྙིགས་རོས་ཁེངས་པའི་སྣང་བ་སྦྱིན་པ་ལས་གཞན།",
    "བརྩེ་དུངས་དེའི་ཟབ་ཚད་ཀྱང་རྩོམ་མཁན་རང་གིས་ཀློག་མཁན་དག་ལ་ཚད་འཇལ་ནས་སྦྱིན་ཚར་བས།",
    "དེང་གི་ཁ་ཤགས་མང་ཤས་ལྟར་ཚད་ལས་འདས་པའི་འུད་བསྟོད་དང་བསམ་བློའི་ཟབ་ཚད་དང་བྲལ་བའི་མཚང་འབྱིན་བཞིན་ཅུང་སུན་སྣང་རེ་སྟེར་བའི་རྣམ་རྟོག་སྦྱིན།",
    "སྤྱིར་སྙན་ངག་ནི་སྐད་ཆའི་སྒྱུ་རྩལ་ཞིག་ཡིན་མོད།",
    "སྒྱུ་རྩལ་དེ་འགྲུབ་པ་ལ་སྐད་ཆ་ནི་རྩོམ་མཁན་གྱི་བསམ་བློ་དང་ཚོར་འདུ་སོགས་སེམས་བྱུང་ཅི་རིགས་མཚོན་བྱེད་ཀྱི་བརྡ་རྟགས་ཡིན།",
    "དེ་བས་མཐར་གཏུགས་ན་སྙན་ངག་ཅིག་གི་སྒྱུ་བོད་ཀྱི་སྙན་ངག་གསར་བ་བདམས་དཔྱད།",
    "རྩལ་གྱི་གྲུབ་ལུགས་སུ་སྐད་ཆའི་བཀོད་སྒྲིག་གིས་གོ་གནས་གལ་ཆེན་ཟིན་ཡོད།",
    "གི་ལམ་དུ་ཞུགས་དགོས་ཕྱིར།",
    "འགལ་མེད་ལྷུན་གྲུབ་ཏུ་རྫོགས་པར་སྦྱོར་བ་ནི་ཕྱོགས་གཉིས་ཀར་བྱང་ཆ་ཡོད་པ་ཞིག་མིན་ཕྱིན་དཀའ་ཁག་ཤིན་ཏུ་མང་མོད།",
    "བུད་མེད་ཚོ།",
    "བུད་མེད་ཚོ་མཐོ་སྒང་གི་ཉི་འོད་བཞིན་ཕྱོགས་མེད་བཀྲ།",
