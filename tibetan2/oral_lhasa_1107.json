    "དེའི་ཉམས་ལེན་བརྡའ་ཐབས་ངོ་སྤྲོད་དུ་མས་དོན་གྱི་ཡེ་ཤེས་སུ་ངོ་སྤྲོད་དེ་ཁྲེགས་ཆོད་དང་ཐོད་རྒལ་གྱི་ཉམས་ལེན་མཐར་བསྲུང་མ་རྣམས་བཀུག་ནས་ཕོ་ཉ་བཀའ་སྡོད་དུ་གཏད་པས་རང་ཉིད་ཀྱང་ཆེ་བཙན་འགྲན་བྲལ་གྱི་དཔའ་གདེངས་ལྷག་པར་ཆེ་བ་བྱུང་།",
    "མ་ར་ཏི་ཀའི་བྲག་ཕུག་ཡིན་སྙམ་པའི་བྲག་རི་སྣུམ་ཞག་ལྷག་པར་ཆེ་ཞིང་ལྗོན་ཤིང་རྩྭ་ལྗང་མེ་ཏོག་སོགས་ཀྱིས་སྤུད་པའི་ངོགས་སུ་ཆུ་གཙང་སྙན་པའི་སྒྲ་ཚོ་། འབྱིན་ཞིང་འབབ་པ།",
    "གནས་འདི་ཁྱད་པར་འཕགས་པར་མ་བརྒྱ་རླུཟད་བདུད་རྩི་འདིའི་ནུས་པས་འཇའ་ལུས་འཕོ་མེད་འགྲུབ་པའང་སྲིད།",
    "ཚེ་སྒྲུབ་ཀྱི་བུམ་པ་འདིར་ཡང་བླུགས་དགོས་བྱས་པས།",
    "ཚོགས་དང་བསྐང་བཤགས་སོགས་ལ་འབད་པ་བཏོན་ན་གཉིས་ཀ་ངོ་ཤེས་པ་ལ་དཀའ་ཚེགས་མེད་ཟེར།",
    "མཐུན་རྐྱེན་དངོས་གྲུབ་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཅེས་གསུངས་པ་དང་།",
    "མཐར་དེར་ཡལ་རྩོལ་མེད་ཀྱི་དགེ་སྦྱོར་འཕེལ་ཆེ་ཨེ་མ་ཧོ། ཡང་གཅིག་ཨ་ཙ་ར་ལུས་བོངས་ཆེ་བ་སྔོ་ནག་རལ་པ་སེར་པོ་རྙིང་པར་སླེབ་པ་རི་དྭགས་པགས་པའི་སྟོད་གཡོགས་དང་དར་གྱིས་སྨད་དཀྲིས་པ་གཡས་ཚེ་དུང་གཡོནནོར་སྣ་ཚོགས།",
    "འདུས་པའི་འབེལ་གཏམ་མང་བྱས་མཐར།",
    "མ་སླེབ་བར་དུ་འདི་ན་བཞུགས།",
    "ཆུན་པོ་སྟར་ཞིང་ཞིབ་པར་སྨྲས།",
    "ཁྱད་པར་འཕགས་པའི་གནས་ཡུལ་ན་། ཕུན་སུམ་ཚོགས་པའི་ས་བོན་ལ།",
    "ཞེས་གསུངས་པའི་མཐར་སྤུ་གྲི་རྣོན་པོས་སྐུ་ལུས་འདྲལ་བར་མཛད་པ་ལས་འོད་ཟེར་སྤོས་དུད་ལྟ་བུས་གནས་ཁང་ཁྱབ་པར་འཁྲིགས་པའི་དབུས་ན།",
    "ཞེས་པ་ནི་རྟེན་ལ་བརྟེན་པ་བཞུགས་པའོ།",
    "འབབ་པའི་ཆུ་ཀླུང་ཟླ་ཞུན་ལྟར་ དཀར་བར་ཁྲུས་བྱས་ན་རི་མ།",
    "ཙཱ་རི་དག་པ་ཤེལ་རིའི་ཤར་ལྷོའི་ཆུ་བོ་འོ་མ་ལྟར་དཀར་བ་ལ་ཁྲུས་བྱས་པ་དང་མི་ཐམས་ཅད་འོ་མས་གང་བ་དངོས་གྲུབ་ཡིན་ལོ་གཅིག་ཚུན་སྟེར་ཟེར་བ་དང་།",
    "མཇལ་བས་ཁྱད་པར་མཆོད་རྟེན་ཆེ།",
    "ཐུགས་རྗེའི་བདག་ཉིད་བཞུགས་པའི་མཐར།",
    "ཁྱད་པར་ཨ་ཙ་ར་གཞོན་ནུ།",
    "གཞོན་ནུ་མཛེས་བཞུགས་འདི་སྐད་དོ།",
    "བསལ་ནས་བསྐང་བཤགས་རིམ་གྲོ་སྒྲུབས།",
    "གཅེས་པར་བཟུང་བའི་རང་གཟུགས་ཀྱང་།",
    "ཞེས་པར་གྲག་གོ་ཕག་ལོ་ཟླ་བ་བཅུ་པ་ཡི།",
    "གཞན་དུ་འབྲོས་པར་བརྩམས་པ་ལས།",
    "ཚར་དུ་དངར་ཞིང་ཁྱད་པར་དུ།",
    "འདི་ན་དུག་སེར་འབེབས་པར་བྱེད།",
    "ཕན་པར་སྨྲ་བའི་གཏམ་ཆ་ཀུན།",
    "ཞེས་སོགས་འགའ་ཞིག་མཆིས་ཏེ་ད་ལྟ་མི་དྲན་ནོ། ཤིང་ཕག་མཆོད་སྡོང་ཆེན་པོའི་རབ་གནས་དང་ཆེ་བཙན་ཁང་དུ་བཞུགས་སྐབས་ཀྱི་མནལ་ལམ་སྐོར།",
    "མགོ་ལ་དར་དམར་པོའི་ཐོད་བཅིངས་པའི་སྐུ་མཚམས་སྦལ་གཟུགས་ཀྱིས་བསྡམས་པའི་སྦྲུལ་མགོ་གདེངས་ཀའི་རྣམ་པར་ཡོད་པ།",
    "རྟག་ཏུ་ཕན་པར་སྨྲ་བའི་མཛའ་བཤེས་ལ།",
    "བཟང་པོའི་ལམ་སྲོལ་འཛིན་ལ་བརྩོན་པར་གཅེས།",
    "བརྗོད་ཀྱང་དོན་དང་ལྡན་པར་ཅི་ཞིག་འགྱུར།",
    "རིག་པ་འཛིན་པ་འགྱུར་མེད་རྡོ་རྗེའི་འཁྲུལ་སྣང་རྫུན་རིས་ཆུ་ཟླའི་རོལ་རྩེད་ལས་དུམ་བུ་གཉིས་པ་བཞུགས་སོ།",
    "བྱང་བརྒྱུད་ཀྱི་བཅོ་བརྒྱད་ཉིན་འབྲི་ཁུང་མཐིལ་གྱི་གནས་མཇལ་བྱས་ནས་བཅུ་དགུར་ཆུ་ཚན་ཁར་འབྱོར།",
    "དེས་ན་མ་དྲིས་པར་ཐག་གཅོད་པ་ཡིན་ཟེར་ནས།",
    "ཇི་ལྟར་བྱུང་ཞུས་པར།",
    "དཆ་ཡང་ཆབ་སྲིད་མངའ་ཐང་ལེགས་ཚོགས་ཅ་འཕེལ་བའི་ཐབས་གནང་དགོས་སོགས་ལབས་པར་དེ་བཞིན་བྱེད་དེ།",
    "དེ་ལྟར་གསུངས།",
    "བསམ་པར་དགོས་དུས་ཅི་དྲག་གང་དྲག་བྱེད།",
    "དགེ་སློང་ལགས་ཀྱིས་འཁོར་ལོའི་བཅའ་གཞི་དང་།",
    "ཡང་ཨ་ཙ་ར་ལྔ་ཤར་མར་འོངས་ནས་ད་ལམ་རང་ཕེབས་དགོས་ཟེར་བ་ལ།",
    "ཡིད་མི་བདེ་བའི་སྣང་བ་འཆར་བའང་བྱུང་གསུངས། ཡང་ཟླ་བ་ལྔ་པའི་ཚེས་བཅོ་བརྒྱད་ཀྱི་ནུབ།",
    "དར་ཞིག་ཕྲག་པར་བཀལ་ནས་བུག་པ་ཞིག་ཏུ་ཕྱིན་པ་ན།",
    "དེར་ཀུན་དགའ་ལགས་ལ་འདི་འདྲ་གང་ཡིན་ནམ་ཞེས་དྲིས་པར།",
    "གུང་དུ་ས་ཁྲི་མཐོ་བའི་ཁར་གཟར་དང་གོས་ཕྲུག་དམར་པོའི་འབོལ་བཏིང་བའི་སྟེང་དུ་ངེད་རང་བསྡད།",
    "དེར་གཟིམས་ཆུང་དུ་ཕྱིན་པར་གོང་ཞབས་གོང་མ་སྔར་གྱི་རྣམ་འགྱུར་ཇི་ལྟ་བ་བཞིན་ལས་ཤིན་ཏུ་དགྱེས་ཉམས་ཆེ་བས།",
    "འདི་དང་འདིའོ་ཞེས་ལན་ལྷག་པར་སྩལ་བས་དོགས་པ་སངས་པའི་རྨི་ལམ་ངོ་མཚར་བ་རྨིས། ཡང་ཟླ་བ་བཅུ་པའི་ཚེས་བཅུ་གཉིས་ཀྱི་གླུ་བཅོ་བརྒྱད།",
    "༧གོང་ཞབས་འཕྱོང་རྒྱས་ནས་སྨིན་གྲོལ་གླིང་དུ་ཕེབས་རྒྱུ་ཡིན་པ་སྔ་གྲོན་ཆུག་པས་སླེབ་དགོས་པའི་ལན་དང་།",
    "མི་གཙང་བའི་རྫབ་ལྗན་ལྗིན་གྱིས་གང་བའི་ལམ་དང་རྒྱ་སྲང་ལྟ་བུའི་དཀྱིལ་ན་ལྷ་ཁང་འཁོགས་ཉམས་ཆེ་བ།",
    "བོད་ཀྱི་བསྲུང་མ་རྣམས་ལ་གསོལ་མཆོད་དང་དམ་བསྒྲག་བྱས་ན་ཕན་ཡོང་ཟེར་བ་དང་།",
    "སྐུ་རིམ་གྱིས་ཁྱད་པར་འོང་བ་གཞིར་བཅས་རུང་།",
    "ས་ངེད་རང་གཟིམས་ཆུང་ནང་དུ་སླེབ་པར།",
