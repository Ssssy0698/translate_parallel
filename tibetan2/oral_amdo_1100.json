    "དྲང་སྲོང་རྣམས་ཀྱང་ཡིད་ཁྲོ་བའི་མེས་བསྲེགས་ནས་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པ་རྒྱལ་པོ་དང་བཅས་པ་ཡང་སྐད་ཅིག་ཏུ་དམོད་པའི་མེའི་བུད་ཤིང་དུ་བྱེད་དོ།",
    "རང་གི་འཁོར་དང་ཡུལ་ཟིལ་གྱིས་མནན་ནས་མཆོག་ཏུ་དཔའ་བས་ན་རྒྱལ་པོའོ།",
    "ནི་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་གྱི་དོན་ཡིན་ཏེ།",
    "གཞན་ལ་ནི་མི་འགྲུབ་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་རང་གི་ངོ་བོ་ཡང་མི་འཐོབ་པོ།",
    "རྒྱུ་གང་གི་ཕྱིར་ཐོབ་ཅིང་རྙེད་ནས་ས་སོ།",
    "དེ་དག་གིས་བྱས་པའི་ལས་ནི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ལས་ཏེ།",
    "འདི་ནི་དེ་དག་གིའམ་དེ་དག་ལ་ཕན་པའོ་ཞེས་བྱ་བར་ཤེས་ནས་ཏེ་ཤེས་པར་བྱས་ན་ས་༥ས་སོ།",
    "རྐུ་བ་ནི་མཐུའམ་འཇབ་བུས་གཞན་གྱི་ནོར་རང་གིར་བྱེད་པའོ།",
    "ལོག་དང་ཕྲ་མ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ངག་གི་ཉེས་པ་སྤོང་བ་སྟོན་ཏེ།",
    "རང་གི་ལག་ནས་དུས་སུ་གཞན་ལ་གནོད་མེད་པར།",
    "སེམས་པའི་ཁྱད་པར་གང་གིས་སྦྱིན་པ་དང་།",
    "སྒྲུབ་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་ས་སོ།",
    "ལན་དུ་ཕན་འདོགས་སུ་རེ་བ་སྤངས་པའོ།",
    "དེ་དག་གི་མཚན་ཉིད་གསལ་བ་ནི་ཤིན་ཏུ་གསལ་ཞིང་ཐིབས་༢པོ་མ་ཡིན་པའོ།",
    "གང་གིས་༢འདི་ཆེན་པོ་ཉིད་ཡིན་ཞེ་ན།",
    "གནག་གི་ལམ་ལྟ་བུའི་ལམ་གོལ་བ་དག་ཏུའོ།",
    "དཔེར་ན་གནག་གི་ཁྱུ་ནས་གནག་གཙོ་བོ་ལ་མ་གོལ་བ་གང་དུ་འགྲོ་བ་དེར་གཞན་དག་ཀྱང་རུང་བ་དང་ཡང་བ་ཡོངས་སུ་མི་ཤེས་པས་འགྲོ་བར་བྱེད་པ་དེ་བཞིན་དུ་མུ་སྟེགས་ཅན་ཕྱུགས་འདི་དག་ཀྱང་།",
    "དཔེར་ན་བྱ་རོག་གི་ནག་པོ་དང་།",
    "རྩྭ་ད་ང་ཤིང་གིས་གང་ཞིང་སྐྱེས་བུ་དམ་པས་སྤངས་པའི་ཡུལ་ལ་ནི་འབྲོག་ཅེས་བྱའོ།",
    "གྲངས་དང་ཚད་དག་གིས་མཐའ་མི་ཟིན་པས་མཐའ་ཡས་པའོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ནི་ལུས་དང་སེམས་ཀྱི་རྒྱུད་ཉོན་མོངས་པར་བྱེད་པས་ན་ཉོན་མོངས་ཞེས་བྱའོ།",
    "དེ་དག་གི་ལུས་འཁྱུད་པ་ནི་འཁྱུད་༢པའི་ལུས་ཏེ།",
    "ཇི་༧ཙམ་དུ་འདིས་གཞན་གྱི་སྲོག་གཅོད་༨པ་དེ་ཙམ་དུ་གཞན་དག་གིས་སྲོག་གཅོད་པར་འགྱུར་རོ།",
    "གང་གིས་དེའི་ཆུང་མ་རང་གིར་བྱས་པ་དེ་ལ་མི་མཐུན་པར་སྤྱོད་པས་ན་དགྲ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ངག་གི་སྟོན་ཏེ།",
    "གང་གིས་དེར་འགྱུར་ཞེ་ན་བརྫུན་དུ་སྨྲ་༐",
    "བ་སྟེ་༡འདུ་ཤེས་གཞན་དུ་བསྒྱུར་བའི་ཚིག་གིས་༢དོན་གོ་བ་ལ་བརྫུན་སྨྲ་བས་སོ།",
    "ཕྲ་མས་ནི་གཞན་དབྱེ་བའི་ཕྱིར་ཉོན་མོངས་པ་ཅན་གྱི་ཚིག་སྨྲ་བས་ཏེ།",
    "དེ་ཙམ་ནི་ངག་གི་ཉེས་པའི་འབྲས་བུ་ཡིན་ན་ནོ།",
    "བརྣབ་སེམས་ཡིད་ལ་རེ་བ་འཇོམས།",
    "གང་གིས་དེར་འགྱུར་ཞེ་ན།",
    "གི་གསོད་༢པ་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱི་བྱ་བ་བདེ་བ་མ་ཡིན་པའི་དོན་ཏམ་༢།",
    "གཟུགས་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་རྣམས་ཀྱིས་འཇིག་རྟེན་ཆགས་པར་འགྱུར་བས་ན་ཆགས་པ་སྟེ།",
    "དེ་དག་གིས་བསྐྱེད་པ་ནི་དེས་བསྐྱེད་པའོ།",
    "དེ་བཞིན་དུ་ཞེ་སྡང་གིས་༡ཟིལ་གྱིས་ནོན་པ་དང་།",
    "གཏི་མུག་གིས་༢ཟིལ་གྱིས་ནོན་པ་ཡང་དེ་དང་འདྲའོ།",
    "ཞེ་སྡང་གི་གཉེན་པོ་བྱམས་པ་ནི་ཞེ་སྡང་མེད་པའོ།",
    "གཏི་མུག་གི་གཉེན་པོ་ཤེས་པ་ནི་གཏི་མུག་མེད་པ་སྟེ།",
    "ཡང་དང་ཡང་དུ་སྐྱེ་བའི་བྱེ་བྲག་གིས་སྐྱེ་བ་ཀུན་དུ་བདེ་བ་ད་ག་ཅེས་མང་པོའི་ཚིག་སྨོས་ས་སོ།",
    "ལྡོག་པ་དང་འཇུག་པའི་བྱེ་བྲག་གིས་འདི་ནི་རྣམ་༦པ་གཉིས་སོ།",
    "སྣང་བ་ནི་མཐོང་བ་སྟེ་ཡེ་ཤེས་ཟབ་མོས་མཐོང་བ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཡོད་ཅེས་བྱ་བའི་སྒྲ་ནི་ཚིག་གི་ཕྲད་ཡིན་ཏེ།",
    "ང་ཡིར་འཛིན་པས་ནི་འདི་ན་བདག་གི་ནོར་ལ་སོགས་པ་ཡོད་པ་མ་ཡིན་ལ།",
    "མོད་ཀྱི་ཞེས་བྱ་བ་ནི་སྲིད་པའོ།",
    "ལས་ད་ང་སྐྱེ་བའི་མཚན་ཉིད་རྣམ་པ་དེ་གསུམ་མོ།",
    "འདི་ལ་ལམ་རྣམ་པ་གསུམ་ཡོད་པས་ན་ལམ་གསུམ་མ་མོ།",
    "རང་གི་བདག་ཉིད་ལ་བྱེད་པ་འགལ་བའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མོ་གཤམ་གྱི་བུ་བཞིན་ན་ནོ།",
    "གཏི་མུག་ནི་ཕྱིན་ཅི་ལོག་གི་ཤེས་པའོ།",
    "ཕྱིན་ཅི་ལོག་གི་ཤེས་པ་ཡང་ངར་འཛིན་པའི་རྣམ་པ་ཅན་ན་ནོ།",
    "རྒྱུ་དང་འབྲས་བུ་ནི་རྒྱུ་དང་འབྲས་བུ་དག་སྟེ་དེ་དག་གི་སྐྱེ་བའོ།",
    "ཁྱོད་ཅེས་བྱ་བ་ནི་ཁྱོད་ད་དེ།",
    "འཛིན་པ་ནི་རེག་པ་སྟེ་དེ་དག་གིས་མ་རེག་ཅིང་ཡུལ་དུ་མ་བྱས་པའོ།",
    "ལོག་པར་ལྟ་བ་ནི་ཕྱིན་ཅི་ལོག་གི་ཤེས་པའོ།",
    "རེ་ཞིག་ཕུང་པོའི་༢ིལྷག་མ་མེད་པ་གང་ཡིན་པ་དེ་ལ་ནི་དངོས་པོ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཤིན་ཏུ་མི་སྲིད་ད་དོ།",
    "མཚན་མ་ནི་བུད་མེད་ལ་སོགས་པ་སྟེ་དེ་དག་༢ཏུ་བརྗོད་པ་དང་ཤེས་པའི་རྒྱུ་ཡིན་ནོ།",
    "ཇི་ལྟར་སྨིག་རྒྱུ་ཆུ་འི་རྣམ་པས་སྟོང་པ་དེ་བཞིན་དུ་འཇིག་རྟེན་འདི་ཡང་གང་དང་གང་གི་རྣམ་པར་སྣང་བ་དེས་ཐམས་ཅད་སྟོང་ངོ།",
    "དེའི་ཕྱིར་བདག་གི་རང་བཞིན་མ་ཡིན་ལ།",
