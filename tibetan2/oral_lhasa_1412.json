    "ཅེས་ལན་གསུམ་བཀའ་བསྐྱོན་པར་མཛད་ནས།",
    "དེའི་ནངས་པར་རྒྱུད་རྐྱང་ཞིག་བལྟས་པས་ཀྱང་གོ་བ་བཟང་པོ་བྱུང་།",
    "དམ་ཚིག་གཙང་བའི་སྟབས་ཡིན་ནམ།",
    "དེ་ནས་བསམ་སྡིངས་ན་ཡོད་པའི་དུས་ཤིག་བཀའ་བབས་བརྒྱུད་འདེབས་བཀོད་པའི་པཎ་གྲུབ་སོ་དྲུག་པོ་དེ་སྟེང་ཁང་ན་བཞུགས།",
    "བར་ཁང་ན་ཤཱནྟི་གུཔྟ་བཞུགས།",
    "སྟེང་ཁང་པ་ཀུན་གྱི་ཞགས་སྐྱུགས་གནང་བ་ཀུན་ཤཱན་ཏི་གུཔྟས་གསོལ།",
    "འཆང་པ་དང་གོ་བ་ཙམ་པོས་མི་ཕན་གསུངས།",
    "ལོ་སྔ་མ་ལ་སྟག་ལུང་དུ་ངའི་སྒྲུབ་ཐབས་འབྲི་བར་ཆད་མ་བྱས་སམ།",
    "ད་ཙ་རི་ལ་འགྲོ་གསུངས།",
    "བདག་ལ་གནང་བ་ཕལ་ཆེར་འཐུངས།",
    "སེམས་དཔའ་གསུམ་བརྩེགས་ཀྱི་རྣམ་པ་སོགས་མཐོང་སྣང་ཁྱད་པར་ཅན་བྱུང་།",
    "བརྗོད་བྲལ་འདི་ལ་ཅི་ཞིག་བརྟེན་པར་བྱ་ཟེར་བ་དེ་ཕྱོགས་མཐུན་ཙམ་བྱུང་ངོ།",
    "རྣམ་པར་གཙེས་པའི་ཚེ་ན་གྲུབ་པའི་མགོན།",
    "འབད་རྩོལ་མེད་པར་ཐོས་པ་ཙམ་གྱིས་ཆུབ།",
    "སྒྲུབ་ཐབས་དུ་མ་ལོ་བདུན་ལོན་ཚེ་གསུངས།",
    "མཐའ་དག་རྒྱུད་ཀྱི་གླེགས་བམ་རྣམ་པར་གྱུར།",
    "རང་ལུས་ལྷ་སྐུའི་གསལ་སྣང་ཆེར་བརྟན་ཞིང་།",
    "རྐྱེན་ཁར་མ་ལུས་པར་སེམས་ཉིད་ཀྱི་གནས་ལུགས་གཅེར་མཐོང་ཞིག་ཡོང་འདོད་པའི་སྐབས།",
    "ལོ་འགའ་ཤས་ཤིག་ལ་འཆར་སྒོ་བྱུང་བ་རྣམས་སྡོམ་དུ་བྱས་པ་ནི་འདི་ལྟར།",
    "ལྷ་སྐུ་མཧཱ་སུ་ཁ་ནམ།",
    "མི་ཤིགས་ཕོ་ཉ་འགྲོ་འོང་བྱེད་པར་སྟོན།",
    "དེ་འོག་འབྲས་བུ་རྣམ་པར་སྨིན།",
    "བརྟན་པར་གྱུར་པ་བི་མ་ར།",
    "རྩིབས་བཞིའི་འཁོར་ལོ་རྣམ་པར་འཁོར།",
    "བནྡྷུའི་སྦྲང་རྩི་འཐུངས་པས་དཎྜིའི་བུ་ག་རྣམ་པར་ཕྱེ།",
    "བ་སྤུའི་སྒོ་ལ་རྣམ་པར་གནས།",
    "དྲུག་པར་བསྒྲགས་ཏེ་ངོ་མཚར་རྨད།",
    "ངོ་མཚར་སྒྱུ་མའི་རོལ་རྩེད་གང་འདིས་སྲིད་གསུམ་ཡེ་ཤེས་འཁོར་ལོས་སྒྱུར་བར་བྱས།",
    "རྣམ་པར་གསལ་ཞིང་རབ་ཏུ་དྭངས།",
    "ཕྱོགས་ཀུན་དཔའ་བོ་མཐའ་དག་རིག་བཅས་རྣམ་འགྱུར་དུ་མས་སྒེག་འཆང་གང་ཞིག་ཨ་ནུས་སད་ཀཱ་རྣམ་པར་སྤེལ་ལས་བི་རཱ་ག།",
    "རྗེ་བཙུན་ཐམས་ཅད་མཁྱེན་པ་ཆེན་པོ།",
    "དེའི་བརྒྱུད་པ་རིམ་པར་བྱོན་པའི་བསྟི་གནས།",
    "འོད་ཟེར་དེས་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཁྱབ་པར་གྱུར་ཏེ།",
    "མི་གཞན་མ་རྣམས་ཀྱིས་ནི་བརྗོད་མ་ཤེས་པར།",
    "ཡུམ་སྐུ་རིམས་དང་བརྟན་བཞུགས་གང་དྲག་གྱིས་ཟེར།",
    "འདི་ཡི་ཞལ་འབྱེད་པར་བྱེད་པ་ལ།",
    "བཙས་སྟོན་ཀྱང་དེའི་ཉིན་ཤིན་དུ་རྒྱས་པར་མཛད་དོ།",
    "བྱ་བྱེའུ་རྣམས་ཀྱང་སྐད་ཀྱི་རྣམ་འགྱུར་སྙན་པར་སྒྲོགས་ཞིང་།",
    "བསྙེན་པར་རྫོགས་སྐབས་སེ་འབྲུ་སྨིན།",
    "ང་ལྷ་ས་བསམ་ཡས་བསྐོར་བར་ཡོང་བ་ཡིན་ཏེ།",
    "ཁྱེད་ཀྱི་སྲས་མཇལ་དགོས་ཟེར་བས་སྐུ་གཅེས་པས་མཇལ་ཁ་མ་གནང་བས།",
    "དཀའ་སྤྱད་གཅིག་ཀྱང་མ་དགོས་པར་རང་ཤེས་སུ་མཁྱེན་པ་དང་།",
    "མི་རྣམས་ཀྱི་མཚན་མགྱོགས་བཅོས་སུ་བྱས་ནས།",
    "ང་ལ་དེ་སྐད་མ་ཟེར་ཞིག་གསུངས་ནས།",
    "མཚན་ནས་བོས་པ་ལ་མི་མཉེས་ཞིང་གསུངས་ལན་ཀྱང་མི་མཛད་པ་བྱུང་།",
    "དེ་རྣམས་ལ་ཐོགས་པ་མེད་པར་སྐུ་ཚེ་སྔོན་གྱི་གནས་ཚུལ་དང་།",
    "གསུངས་ནས་ཕྱག་མཛུབ་ཀྱི་སྟོན་པ་སོགས་མཛད་པ་དང་།"
