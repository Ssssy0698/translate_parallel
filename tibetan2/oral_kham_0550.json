    "རྒྱབ་ན་འདུག་པ་ལ་ནི་མཇིང་པ་བསྒྱུར་ཏེ་མི་ལྟ།",
    "ཐག་རིང་པོ་ནི་འདུག་པ་ལ་བསྒྲིམས་ཏེ་མི་ལྟ།",
    "ཐག་ཉེ་བ་ན་འདུག་པ་ལ་བསྒྲིམས་པ་མེད་པར་ཡང་མི་ལྟའི།",
    "ཇི་ལྟར་འདུག་པའི་སྤྱོད་ལམ་དང་།",
    "འདམ་བུ་ཁོང་སྟོང་དུ་འདུག་ལ་ཚེར་མ་མང་ཞིང་དེ་དག་ཉིད་རབ་ཏུ་སྡུག་པའི་ཕྱིར་སྔར་བསྟན་ཏེ།",
    "གཟུགས་ལ་སོགས་པའི་དེ་བཞིན་ཉིད་ཀྱི་བདག་ཉིད་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཁོ་ནའོ།",
    "དེ་བས་ན་སྟོང་པ་ཉིད་དང་གཟུགས་ལ་སོགས་པ་ལ་ཐ་དད་པ་མེད་པར་གཟུགས་ཀྱང་རང་བཞིན་མ་ཡིན་ལ།",
    "འདི་ལྟར་གཟུགས་ཀྱི་ཡོངས་སུ་གཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་སླད་དུ་གཟུགས་མ་ལགས་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བ་ཞེས་བྱའོ།",
    "འདུག་པ་དང་།",
    "གསུམ་ཞེས་བྱ་བའི་གྲངས་ཀྱི་བྱེ་བྲག་ཡོད་པ་མ་ཡིན་ཏེ་དེ་བས་ན་མི་སྐྱེ་བ་ལ་བྱེ་བྲག་མེད་པའི་ཕྱིར་ཡོངས་སུ་གྲུབ་པའི་ཚེ་གཟུགས་ལ་སོགས་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གཅིག་ཏུ་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་མི་སྨྲ་བར་འདུག་པས་ཆོག་ན་དེ་ལྟར་ན་ནི་དཀའ་བ་མ་ཡིན་པར་འགྱུར་ན།",
    "བཅོམ་ལྡན་འདས་ཡིད་ལ་བགྱི་བ་དེ་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་དང་བྲལ་བ་སྟེ་ཞེས་བྱ་བ་ནི་ཉི་ཤུ་པའོ།",
    "གཡས་གཡོས་སུ་འདུག་སྟེ་བལྟས་ཀྱང་ཞབས་ཀྱི་མཐིལ་སྣང་ཞིང་འགྲོས་སྡུག་གོ།",
    "རྫི་མ་གཉིས་གནས་པའི་སྐབས་སྣུམ་ཞིང་མཐིང་ཀར་འདུག་པ།",
    "ནང་སྟོང་པ་ཉིད་ལ་སོགས་པ་སྟོང་པ་ཉིད་བཅུ་དྲུག་པོ་དག་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཡིན་པར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དེ་ཡང་སྔོན་གྱི་མཐར་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པས་དུས་གསུམ་ཅར་དུ་ཡང་སྟོང་པ་ཉིད་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "འདིས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་བརྗོད་པ་ཡིན་ནོ།",
    "རྩོད་པའི་གནས་སུ་གྱུར་པའི་ཤེས་པ་ཡང་རང་རིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་འགལ་བ་དམིགས་པའོ།",
    "རྟོགས་པའི་རང་བཞིན་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་འོད་གསལ་བ།",
    "འཁོད་པ་ནི་འདུག་པའི་ཕྱིར་རོ།",
    "འདུས་ནི་འདུག་པ་དང་འདུས་པ་དག་གོ།",
    "ཤིང་གཞན་བཞིན་དུ་ཡང་རང་དགར་བགྲང་བ་མ་ཡིན་ནོ།",
    "ད་ནི་སྦྱིན་པ་ལ་སོགས་པ་བྱེད་པ་པོ་ལས་ཀྱང་རང་ཉིད་ཀྱིས་ཀློག་པར་བྱེད་པ་དང་།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ལུག་ལྟར་ལྐུགས་པའི་རང་བཞིན་ཅན་ནི་གཞན་གྱིས་ལེགས་པར་སྨྲས་པ་མི་ཉན་པའི་ཕྱིར་དང་རང་ཉིད་ཀྱིས་ཀྱང་ལེགས་པར་སྨྲ་བ་མི་བརྗོད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཅི་ཡང་མེད་པར་འདུག་ཅིག།",
    "དེ་ལ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེ་ཡང་རང་ལ་རག་མ་ལུས་པའི་སེམས་ཀྱི་འཇུག་པ་དེ་ནི་གཉིད་དོ།",
    "གསལ་བར་བགྱིད་པ་ནི་འོད་གསལ་བ་སྟེ་དྲི་མ་དང་བཅས་པའི་གནས་སྐབས་ལ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་ཕྱིར་ཞེས་གསུངས་པ་ནི་རྣམ་པར་དག་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "གང་ཞིག་དུས་རིང་པོར་རོལ་པ་ལ་དགའ་བ་ཐོབ་པ་མ་ཡིན་པ་དེ་རྣམས་ནི་རྟག་པ་སྟེ།",
    "དོན་འཆད་པར་འདོད་ཅིང་རང་ཉིད་ཀྱིས་དྲི་བར་བྱེད་པ་ནི་ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གནས་ཅི་ལ་ཡང་མི་བརྟེན་པར་འདུག་སྟེ་ཞེས་བྱ་བས་རབ་ཏུ་གནས་པར་དགག་པའོ།",
    "བརྟེན་ནས་ཞེས་བྱ་བ་ནི་འདུག་པར་བྱས་ནས་སོ།",
    "སྟན་གཅིག་ལ་འདུག་ནས་ཅི་སྲིད་ཡོངས་སུ་ལོངས་སྤྱད་པར་བྱ་བ་དེ་སྲིད་དུ་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་སྟན་དེ་ལས་ལངས་ཤིང་ཡོངས་སུ་ལོངས་སྤྱོད་པ་མ་ཡིན་ནོ།",
    "གང་དག་དུས་རིང་པོར་འདོད་པ་རྣམས་ལ་མི་ཆགས་པ་དེ་རྣམས་དེ་ཉིད་དུ་རྟག་པའོ།",
    "རྟོགས་པར་བྱེད་པ་ནི་དྲན་པ་ཉེ་བར་གནས་པ་ཉིད་ཀྱིས་གཞུང་དང་དོན་དེ་དག་དུས་ཐམས་ཅད་དུ་འདིའི་བློ་ལ་གནས་པར་འགྱུར་བའོ།",
    "དངོས་པོ་གཅིག་ཉིད་དང་རང་བཞིན་གཅིག་ཉིད་དང་ཡེ་ཤེས་གང་ལ་ཁེངས་པ་ཡོད་པ་མ་ཡིན་ཏེ་འོན་ཀྱང་དངོས་པོ་ཐམས་ཅད་གདོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་ལ་སོགས་པ་དོན་དམ་པ་པའི་ངོ་བོ་ཐམས་ཅད་ཀྱིས་ཤེས་པ་མ་ཡིན་ཞེས་བྱ་བའི་དགོངས་པའོ།",
    "དེ་ལྟར་འདུག་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཐོས་པ་བྱེད་པའི་སྟན་ལས་མ་ལངས་པའོ།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱི་རྗེས་སུ་སློབ་པ་གདུལ་བྱ་རྣམས་ཀྱིས་ཀྱང་གནས་པ་མཆོག་གསུམ་གྱིས་གནས་པར་བྱ་བ་ཡིན་གྱི་འཇིམ་གོང་བཞིན་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བསྟན་ཏོ།",
    "དཔེར་ན་འགྲོ་བ་ཀུན་དང་སློབ་པ་དང་མི་སློབ་པ་དང་རང་རྒྱལ་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་བཞིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གདན་བཤམས་པའི་ཕྱོགས་ཀྱི་ཉེ་འཁོར་དུ་འདུག་པར་འོས་པའི་གནས་ལས་ཕྱི་རོལ་ན་འདུག་པའི་ཕྱིར་ཡུལ་ལས་འདས་པའོ།",
    "མི་འདུད་རབ་ཏུ་མི་འདུད་ཁེངས་པར་མ་ཡིན་གུས་པར་མ་ཡིན་པར་མི་གནས་པར་འདུག་སྟེ།",
    "དུས་ཐམས་ཅད་དུ་དེ་བཞིན་དུ་འདུག་པས་ན།",
    "དམིགས་པ་གང་ལ་གནས་ཤིང་འདུག་ཅི་ལ་གནས་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེའི་ཚེ་ཅི་ལ་གནས་ཏེ་ཞེས་བྱ་བ་ནི་དམིགས་པ་གང་ལ་སེམས་འདུག་ཅེས་བྱ་བའོ།",
    "དུས་ཐམས་ཅད་དུ་དེ་བཞིན་དུ་འདུག་པའི་ཕྱིར་དང་འདུས་མ་བྱས་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་དག་པའི་མཐའ་བརྩོན་པར་བགྱིས་ན་ཞེས་བྱ་བ་འདིས་ནི་རྡོ་རྗེའི་གདན་ལ་འདུག་པ་ལ་སོགས་པ་ཕྱིན་ཅི་ལོག་ཡིན་པར་བསྟན་ཏེ།",
    "དགོས་པ་ལ་ལའི་ཕྱིར་སོན་པར་གྱུར་པ་ལ་ཞེས་བྱ་བ་ནི་གྲོང་ལ་སོགས་པའི་ནང་དུ་ཡུན་རིང་དུ་མི་འདུག་པ་དང་།",
    "འདི་གཉིས་ལྷན་ཅིག་ཏུ་འདུག་པར་རྣམ་པ་མང་དུ་བསྟན་པའི་ཕྱིར་རོ།",
    "སྦྱོར་བའི་ཚུལ་ལ་གུས་པས་རྟག་ཏུ་བསྟེན་ཅིང་འདུག་ཤིག་དང་ཇི་ལྟ་ཇི་ལྟར་ཡང་དག་པར་བླངས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཡང་དག་པར་བླངས་ཏེ་འདུག་ཤིག་དང་།",
    "དེས་ནི་ཞི་གནས་དང་ལྷག་མཐོང་དང་དེ་གཉི་གའི་གགས་སུ་གྱུར་པ་ཡོངས་སུ་སྤོངས་ལ་འདུག་ཤིག་པར་བསྟན་ཏོ།",
    "འདུག་པ་དེ་ལྟ་དེ་ལྟར་ཏིང་ངེ་འཛིན་འདིའི་ཡོན་ཏན་མཐོང་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལ་ཇི་ལྟ་ཇི་ལྟར་ཞེས་བྱ་བ་ནི་ལན་མང་དུ་བྱེད་པ་བསྟན་པ་ཡིན་ཏེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བ་དང་།",
    "གནས་པ་ནི་འདུག་པ་སྟེ།",
    "བཞུགས་པ་ནི་འདུག་པའོ།",
    "དེ་ལྟར་འདུག་པ་དེ་ཡང་དེ་དག་བདག་མེད་པ་གཉིས་སྟོན་པའི་བདག་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉན་པའི་འོས་སུ་གྱུར་པ་ཡིན་ནོ།",
    "སྒོར་འདུག་པ་བདེན་ནམ་ཞེས་བྱ་བའི་བར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་འཇམ་དཔལ་དབྱངས་ལ་འདྲི་བའོ།",
    "མུན་རུམ་གྱི་ནང་ན་བུམ་པ་ལ་སོགས་པ་འདུག་པ་བཞིན་ནམ།",
    "གནས་པ་ཞེས་བྱ་བ་ནི་འདུག་པ་སྟེ།",
    "དེ་ལ་དམིགས་ཤིང་འདུག་ཅེས་བྱ་བའི་བར་དུ་ཡིན་ནོ།",
    "སྤྱིའམ་བློ་ལ་གཟུགས་བརྙན་དུ་འདུག་པ་ཞིག་ཡིན་གྲང་།",
    "དུས་ཐམས་ཅད་དུ་ཆ་ཤས་དང་བཅས་པར་འདུག་པ་ཡིན་ནོ།",
    "ཡོན་ཏན་གང་དག་ཡིན་པ་གཉེན་པོ་གོམས་པ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པར་འགྱུར་བ་སྟེ།",
    "སྒྲའི་དོན་མེད་དུ་ཟིན་ཀྱང་རང་བཞིན་ལ་གོ་འགལ་བ་ཅི་ཡོད་ཅེ་ན།",
    "ཞི་བ་འདི་གཉིས་ཀྱི་ནང་ན་ཤིན་ཏུ་ཞི་བར་འདུག་པ་ཡིན་ནོ་ཞེས་བྱ་བས་ནི་འདི་ཞི་བ་ཉིད་དུ་ངེས་པ་དང་།",
    "འདུག་གོ་ཞེས་བདག་རྣམ་པར་རྟོག་པར་གྱུར་ན།",
    "ཕྱི་མའི་མཐར་འདུག་པ་མ་ཡིན་ན་སྔོན་གྱི་མཐའ་ནས་མ་ཡིན་ཞེས་བྱ་བ་དེ་རིགས་པ་མ་ཡིན་ནམ།",
    "མ་བགྱིས་པ་ནས་མ་འགགས་པའི་བར་ནི་མཉམ་པ་ཉིད་དུ་འདུག་པ་ཡིན་ཏེ།",
    "བར་དུ་ཞེས་སྨོས་པས་ཐོག་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལ་སོགས་པའི་རྣམ་པ་རྣམས་གཟུང་ངོ།",
    "རྟག་པར་དུས་ཐམས་ཅད་དུ་འདུག་པའི་ངོ་བོ་ལ་བྱེད་པ་མེད་དོ་ཞེས་སྦྱར་རོ།",
    "གཞན་ཡང་རུང་བ་དེ་བཞིན་གཤེགས་པ་དེ་བཞུགས་པ་དེར་དགའ་བ་དང་གུས་པ་བསྐྱེད་ནས་ཕྱོགས་དེར་མངོན་དུ་བལྟས་ཏེ་འདུག་པར་བྱའོ།",
    "འོན་ཀྱང་དེ་དག་ལ་འདི་སྐད་ཅེས་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོངས་སུ་བསྒྲགས་པ་འདི་ཡང་དག་པར་ཟུང་ལ་འདུག་ཅིག་དང་ཞེས་བྱ་སྟེ།",
    "ཡང་ན་ཡིད་མ་གཏོད་ཅིག་ཅེས་བྱ་བ་ནི་མཉན་ཏོ་སྙམ་དུ་དེ་ལྟར་མ་འདུག་ཅིག་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "ཤམ་ཐབས་ཞེས་བྱ་བ་ནི་ཁྱིམ་དུ་འདུག་པ་དང་མཐུན་པའི་གོས་མནབས་པ་སྟེ།",
    "འདུག་ཅེས་བྱ་བ་ནི་སྟན་ལ་འདུག་པའོ།",
    "གཞན་དུ་ན་ནི་འདུག་གོ་ཞེས་བྱ་བ་དེ་ཙམ་ཁོ་ནས་གཉིས་ཀ་སྨོས་པར་འགྱུར་རོ།",
    "དེ་དག་དུས་མཉམ་པ་ཙམ་གྱིས་ཀྱང་ཐོབ་པར་བྱ་བ་དང་།",
    "རྣམ་པར་རྟོག་པ་དེ་ཡང་རང་བཞིན་གྱིས་འཁྲུལ་པ་ཡིན་པས་དེས་སྒྲོ་བཏགས་པའི་རྣམ་པ་དེ་ཡང་བརྫུན་པ་ཉིད་དོ།",
    "ཤེས་རབ་ལ་འཇུག་པ་ནི་ཕུང་པོ་ལྔ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་བལྟའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་ཉིད་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་བལྟའོ་ཞེས་པ་ལ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ་ཞེས་པ་ནི་ཕུང་པོ་ལྔ་པོ་དེ་དག་ནི་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དོ།",
    "དེ་ཡང་བཏགས་པས་སྒྱུ་མ་དང་རྨི་ལམ་དང་འདྲ་ལ་རང་བྱུང་རང་ཞི་བ་ཡིན་ཡང་།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ལྟའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཁྱིམ་མུན་ནག་ཡུན་རིང་པོར་འདུག་པ་ལ།",
    "དེ་ལྟར་རང་རང་དང་མཐུན་པའི་སྡུད་པ་པོས་ནི་བསྟན་པ་ཡང་དག་པར་བསྲུང་བའི་དོན་དུ།",
    "དེ་ཉིད་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་རྟོགས་པའི་ཕྱིར་མཚན་མ་མེད་པ་ཉིད་རྟོགས་པ་ནི།",
    "རང་རང་རྟོག་པ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "འགྲེང་བ་ཞེས་བྱ་བའི་རྩའི་རིགས་ལྟེ་བ་ནས་བྱུང་ནས་ནམ་མཁའི་བར་དུ་འཕགས་ཏེ་འདུག་པ་དང་།",
    "བླ་བ་སྒྲ་ཅན་གྱིས་བྲིན་ཅེས་སྨྲས་པ་གང་ཡིན་པ་དེ་ནི་ཟླ་བ་འདི་མངོན་སུམ་དུ་འདུག་པ་མ་ཡིན་ནམ།",
    "འཇིག་ཀྱོག་བྱེད་ལ་ཕར་བྲོས་ཚུར་བྲོས་ཤིང་འདུག་ཏུ་མི་བཏུབ་བོ།",
    "དེ་ནས་འདུན་པ་མིག་མཆིམས་གང་ཞིང་དབུགས་རིང་པོའི་ཤུགས་ནར་གྱིས་ཕྱུང་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཁང་བཟངས་ནོ་ནི་འདུག་པས་མཐོང་།",
    "རྒྱལ་པོས་འདུག་ནས་དགྱེས་པ་དང་།",
    "ཀྱེ་མའོ་ས་ཕྱོགས་འདི་ནི་དགའ་དགའ་ལྟར་འདུག་པ།",
    "གསེ་གུ་ཅན་འདུག་ངོགས་བདེ་ཞིང་མཐའ་རྒྱ་ཆེ་ལ་གསིང་མ་སྔོན་པོ་དང་།",
    "ཤིང་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་དགའ་དགའ་ལྟར་འདུག་པ་ཞིག་སྟེ།",
    "སློབ་དཔོན་སའི་དབུས་སུ་འདུག་ལ།",
    "དེ་ནས་རང་དཀྱིལ་འཁོར་གྱི་ཤར་འཇིག་རྟེན་པའི་ལྷོ་ཕྱོགས་སུ་འདུག་སྟེ།",
    "ཞོན་པ་བཅུ་དྲུག་དུས་དང་ནི།",
    "གཞན་ཡང་རང་འགྲོ་ཕྱོགས་ཀྱི་རྐུན་མ་རང་ལ་གནོད་པ་ཐམས་ཅད་བྲིས་ལ་གཞུག་གོ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་རྗེས་གནང་བཅས།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པའི་གསུང་འབུམ་ཐོར་བུ་ལས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་མངོན་རྟོགས་རྗེས་གནང་དང་བཅས་པ།",
    "བྷྱོ་རྒྱ་གར་ཡུལ་ན་བཞུགས་ཙ་ན།",
    "གཏང་རག་དུས་སུ་མ་ཐོངས་མཐོལ་ལོ་༝༝།",
    "བདག་ཅག་དུས་འདིར་ཚེ་རིང་ཞིང་།",
    "དེ་ཡང་རྡོ་རྗེ་འཆང་རང་ཉིད་ཀྱིས་རྒྱུད་ལས་རྒྱས་པར་གསུངས་ཤིང་།",
    "ཧ་ཧ་ཊ་ཊ་ཞེས་བཞད་གང་ཞིག་དུས་ཀུན་དུ་ནི་ཤིན་ཏུ་རབ་ཏུ་འཇིགས་མཛད་པ།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རང་རང་གནས་སུ་འགྲོ་བར་གྱིས།",
    "གཏང་རག་དུས་སུ་མ་བགྱིས་མཐོལ་ལོ་བཤགས།",
    "རང་རང་འཁོར་ཚོགས་དང་བཅས་གནས་འདིར་སྤྱོན།",
    "རང་རང་དགྱེས་པ་བསྐྱེད་ཕྱིར་དམ་རྫས་སོགས།",
    "མངྒ་ལཾ། ། རྗེ་ཐམས་ཅད་མཁྱེན་པའི་གསུང་འབུམ་ཐོར་བུ་ལས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་མངོན་རྟོགས་རྗེས་གནང་དང་བཅས་པ་བཞུགས་སོ།",
    "རྩིབས་དྲུག་ལ་ཨོཾ་ཨ་ར་པ་ཙ་ན་ཞེས་པའི་ཡི་གེ་དྲུག་པ་ཁ་དོག་དམར་སེར་གྱིས་བསྐོར་བ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་མངོན་རྟོགས་རྗེས་གནང་དང་བཅས་འདི་ནི།",
    "དེ་མཐུན་གྱི་བྱེད་པ་ཅན་དམ་པ་རྣམས་ཀྱི་ཐུགས་རྗེའི་༢བ་ཡུལ་ཁོ་ནར་འདུག་པ་དང་།",
    "རང་རང་གདགས་གཞིའི་སྟེང་དུ་འདི་དང་འདི།",
    "རང་རང་བློ་དང་འཚམ་པར་བསྐྱངས་པ་ལས།",
    "དེ་བས་ཁྱེད་རང་ཐུགས་དམ་མཛོད།",
    "འདི་ནས་༧༧བ་རྒྱལ་གྱི་འགྲོ་བཞུད་དང་བསྟུན་པར་དེ་ཚོར་སློབ་དགོས་པའི་ནན་སྐྱེད་ཆེ་བར་འདུག་པ།",
    "ད་ལོ་དེ་ཕྱོགས་སུ་སླེབ་པའི་སྒོ་མི་འོང་བ་འདུག་པས་དགོངས་ཡུལ་བཞུགས་པ་ཞུ་ཞིང་།",
    "དྲུང་ནས་དྭགས་པོ་བའི་མནལ་ལྟས་ཀྱི་ཆ་སོགས་དེ་བཞིན་ཡིན་འདུག་པ།",
    "པར་མཁན་པ་ལ་བཀའ་བཀོད་དེ་བཞིན་གནང་འདུག་པའང་བཀའ་དྲིན་བསྐྱངས།",
    "དུས་བབ་ཀྱི་མཛད་པ་བདུད་རྩིའི་འོད་ཀྱིས་མཛེས་པར་བཞུགས་ཡོད་འདུག་པ་ལེགས།",
    "འཚོ་སྐྱོང་སྐུ་རིམ་སོགས་ཅི་ཡང་མཛད་འདུག་ནའང་གནས་སྐབས་ལྔ་པར་གྱུར་པ་ཞིག་བྱུང་འདུག་པ།",
    "ལམ་བཤན་པོ་ཡོང་བར་འདུག་ལགས།",
    "རང་རང་ཡེ་ཤེས་འཁོར་ལོ་དག།",
    "གྲྭ་བུ་སློབ་གུས་ཞེན་ཆེ་བ་འགའ་ཞིག་དང་སླར་དེ་ཕྱོགས་ལ་ལྡབ་པའི་ཆད་དོན་ཡང་འདུག་པ་༡༩བ་ནས་སྔར་གྱི་འཕྲོད་ལན་རྣམས་དང་སྦྲགས་དེ་ཕྱོགས་ལ་དོང་བ།",
    "དིང་སང་ཁམས་ལུས་སྙོམས་ཤིང་སྐྱི་འཕང་གྱི་བྲེལ་བ་རྣམས་ལ་ཅ་གས་ཐོན་པར་ཡོད་འདུག་པ་ལེགས།",
    "སྔར་ཡང་རིམ་གྲོ་ཡང་དག་མཛད་འདུག་པ་བཞིན་དུ་མུས་འཐུད་ཞུ་ཞིང་།",
    "རང་རང་སྐད་དུ་རྒྱུ་དང་འབྲས་བུ་ཡི།",
    "རང་རང་སྐུ་ཡི་རྟེན་ལ་བརྟན་བཞུགས་ནས།",
    "རང་རང་འཁོར་གྱི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར།",
    "གསལ་བ་དེ་སྨིན་ཅིང་བརྡོལ་བ་ལས་འཇིག་རྟེན་གྱི་མེས་པོ་ཚངས་པ་ཆེན་པོ་པདྨའི་མངལ་ནས་བྱུང་བ་པདྨ་ལ་འདུག་པ་གདོང་བཞི་པ་ཞིག་བྱུང་སྟེ་དེས་འཇིག་རྟེན་ཐམས་ཅད་སྤྲུལ་པར་གྱུར།",
    "དཔྱིད་ཟླ་གསུམ་ལ་ཐུག་དུས་ཟས་སྤར་ར་སྣེ་གསུམ་ཐོ་མི་ཐུག་པ་ཡང་གང་མང་མང་ཡོད།",
    "དུ་བལྟས་པས་ཟུར་དེ་ན་ཁྱི་མགོ་ཞིག་འདུག་དེའི་སོ་ཞིག་ཕྱུངས་པ་དར་གྱིས་དྲིལ་ཏེ་ཁྱེར་འོངས་ནས་མ་ལ་བྱིན།",
    "ནས་རྒན་བཙོས་ནས་ཆང་བསྙལ་ཏེ་བསྒུག་འདུག་ཟེར་བས།",
    "ནོར་བུའི་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པའི་ལོ་འདབ་མཛེས་པ་དང་རང་བྱུང་བཅུད་དུ་སྨིན་པའི་མེ་ཏོག་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ་ཕྱོགས་ཀུན་ཏུ་རྒྱས་པས་ཤར་ལྷོ་ནུབ་བྱང་མཚམས་དང་བཅས་པའི་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཁྱབ།",
    "འབངས་ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "མདུན་དུ་གང་རང་ལ་སྡང་བར་བྱེད་པའི་དགྲ།",
    "རང་རང་སོ་སོའི་འདོད་པ་ལྟར་བདེ་བ་དང་སྐྱིད་པ་ཁོ་ན་བྱུང་ན་ཅི་མ་རུང་སྙམ་དུ་འབྲེལ་བ་བཞི་ལྡན་གྱི་སྒོ་ནས་ཡང་དང་ཡང་དུ་བསྒོམ་ཞིང་།",
    "གཞན་གནོད་བྱས་པའི་ལས་དེ་དག་ལ་བརྟེན་ནས་ལོངས་སྤྱོད་འགྲུབ་པ་ནི་སུ་ཡང་མི་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་དག་ལ་སྡུག་བསྔལ་ཡོད་སྙམ་པའི་སྣང་བ་ཙམ་ཡང་མི་བྱེད་པར་འདུག་པ་འདི།",
    "ཤི་ཤ་དང་གསོན་ཁྲག་གཉིས་བསྲེས་ནས་སྔར་བསད་པ་དེའི་ནང་ལྟོ་གཡོས་ནས་ཟ་ཕོད་པ་འདི་ལས་ཀྱི་སྲིན་པོ་དངོས་སུ་འདུག་ད་ལེགས་པར་བསམ་ན་དུད་འགྲོ་དེ་དག་རྣམས་ཀྱི་སྡུག་བསྔལ་ལ་བལྟས་ནས།",
    "ཨ་ཙ་ར་མིག་ཕོར་ཁོག་ཙམ་བསྒྲད་པ་ལྔ་གཟིམ་ཁང་དུ་འདུག་པ།",
    "འབྲོམ་སྟོན་པས་པུ་ཏོ་བ་ཁོང་ཅི་མཛད་ཀྱིན་གདའ་གསུངས་པས།",
    "རང་གཞན་གྱི་ཡོ་བྱད་མང་པོས་རྟེན་གསུམ་འབའ་ཞིག་བཞེངས་ཤིང་གདའ་ཞུས་པས་སྔར་བཞིན་གསུངས།",
    "ཁོང་སྒོམ་འབའ་ཞིག་མཛད་ཀྱིན་གདའ་ཞུས་པས།",
    "དབུ་བཏུམས་ཏེ་བཤུམ་པ་འབའ་ཞིག་མཛད་ཅིང་གདའ་ཞུས་པས།",
    "དེ་བྲམ་ཟེ་སྒྲ་མཁན་རྣམས་ཀྱིས་བརྟགས་པས་མུ་སྟེགས་ངན་པ་རྣམས་ཀྱི་ཀླད་པ་འགེམས་ཞེས་བྱ་བའི་སྒྲར་འདུག་གོ།",
    "དེ་ཡིད་མི་ཆེས་ན་ང་རང་ཕྲག་པར་ཐོགས་ལ་མི་ཐམས་ཅད་ལ་སྟོན་དང་ཤེས་འོང་གསུངས།",
    "ཚོང་འདུས་སུ་ཕྱིན་ནས་མི་ཐམས་ཅད་ལ་ངའི་ཕྲག་པ་ན་ཅི་འདུག་གསུངས་པས།",
    "ཐམས་ཅད་ཀྱིས་ཅི་ཡང་མི་འདུག་ཟེར།",
    "དེ་དག་ཀྱང་རང་ཉིད་ཀྱི་མ་ཡིན་པར་གོམས་ནས་ད་ལྟའི་མ་དང་ཁྱད་མེད་བྱུང་བའི་དུས་སུ།",
    "སྐྱ་བ་འཛིན་པ་གཉིས་ཀ་མི་ཤེས་པར་འདུག་པས།",
    "སྔོན་སྦྲང་བོ་ཞིག་རྒྱ་སྒོའི་འགགས་སུ་ཉལ་ནས་རྒྱལ་པོ་འདི་མགོ་ཆད་ནས་ཤི་སྟེ་ང་རང་རྒྱལ་བོ་བྱས་ན་ཇི་མ་རུང་སྙམ་པ་ཡང་དང་ཡང་དུ་བློ་ལ་སྐྱེས།",
    "ད་ནི་སེམས་ཁོ་རང་ལམ་ལ་བཞག་ནས་མ་ནོར་མ་འཁྲུལ་བའི་ལམ་བཟང་ལ་བསྒྱུར་རྒྱུ་གལ་ཆེ།",
    "ཁྱེད་རང་ཅི་ལྟར་འདོད་པ་དེ་གཞན་རྣམས་ཀྱང་དེ་ལྟར་འདོད་པ་ཡིན་པས་དེ་དང་སྦྱོར་ཅིག་གསུངས།",
    "གསུངས་པ་འདི་དག་ཟ་ཉལ་འགྲོ་འདུག་སོགས་སྤྱོད་ལམ་ཐམས་ཅད་དུ་ཚིག་བློ་ལ་བྱང་ནས་མཚམས་མཚམས་སུ་བཏོན་ན་སྐྱེ་སླ་བ་ཡིན།",
    "ངེད་གཉིས་ཀས་དྲངས་ཀྱང་མི་འདྲོང་བར་སྡུག་བསྔལ་བར་མཚུངས་པར་འདུག་པ་ལ།",
    "དེ་ཡང་རང་སྟོབས་རྙེད་ནས་ཇེ་བརྟན་དུ་འགྲོ་ཞིང་ས་ཐོབ་ཕན་ཆད་སེམས་བསྐྱེད་པ་དེ་ཚོ་རབས་ཐམས་ཅད་དུ་ཉམས་པ་མེད་པར་མངོན་དུ་འགྱུར་རོ།",
    "བུ་ཁོང་སླར་འོང་ནས་ཡང་མ་ལ་ངའི་རིགས་དེ་མ་ཡིན་པར་འདུག་རིགས་དངོས་གང་ཡིན་དྲིས་པས།",
    "རང་ནོར་བུ་ལོན་པའི་རིགས་ཡིན་པར་འདུག་པས།",
    "མི་ནག་པོ་མིག་དམར་ལྗིག་གེ་བ་ལག་ན་ལྕགས་ཀྱི་དབྱུག་པ་རིང་པོ་ཐོགས་པ་ཞིག་འདུག་པ་ལ་མཁར་འདིའི་ནང་ན་ཅི་ཡོད་པ་ཡིན་དྲིས་པས།",
    "ཉེས་པ་བྱུང་ཟེར་བ་དེ་འདི་ཡིན་པར་འདུག་དགོངས་བཞིན་མཁར་དེའི་ནང་དུ་ཕྱིན་པས།",
    "ཟེར་བ་ཞིག་འདུག་པས།",
    "བྱ་བ་གཅིག་གདའ།",
    "མི་དེ་ཐུགས་རྗེ་ཆེན་པོ་ཡིན་པར་འདུག་དུས་དེ་ནས་བཟུང་སྟེ་གནས་ལུགས་ཀྱི་དགོངས་པ་མ་བཅོས་པ་ཇི་ལྟ་བ་བཞིན་ཐུགས་ལ་འཁྲུངས་ཏེ།",
    "ད་དུང་ཡང་རྒྱལ་པོ་དྲན་པ་མ་ཉམས་པར་འདུག་པས།",
    "གཞན་དོན་བྱེད་པའི་དུས་རང་དོན་གྱི་འཁྲི་བ་ཟད་ཙ་ན་ཡིན།",
    "སོར་ཐར་གྱི་སྲུང་སྡོམ་དག་པ་གཅིག་པུས་གར་ཡང་མི་ཕྱིན་པར་འདུག་གསུངས།",
    "དེ་ལྟ་བུ་ཞིག་མ་འགྲུབ་བར་འདུག་ཐབས་མི་འདུག་སྙམ་པ་དང་།",
    "རང་རང་ནས་ཀྱང་ང་དེ་དང་དེ་ལྟ་བུ་ཡིན་པས་གང་ཡང་མི་དགོས་སྙམ་པ་འདུག་སྟེ།",
    "རང་ལ་ཡང་འོ་བརྒྱལ་བར་འདུག་པས་ངེད་འཁོར་རྣམས་ཀྱིས་བྱེད་པར་ཞུ་ཞུས་པས།",
    "ནོར་མེད་ཙ་ན་དགྲ་དང་བྲལ།",
    "གཉེན་པོའི་མཆོག་གང་ཡང་རང་བཞིན་མེད་པར་ཤེས་པ་ཡིན།",
    "ཁྱེད་ལྟ་བུའི་མཁས་པ་བོད་ན་བཞུགས་བཞིན་དུ་ཁོ་བོ་བོད་དུ་འོང་མི་དགོས་པར་འདུག་གསུངས།",
    "ང་བོད་དུ་འོང་དགོས་པར་འདུག་གསུངས།",
    "ཕྱིན་དྲུག་ལམ་ལ་བསླབས་ཀྱང་རང་འདོད་བཅས།",
    "ལས་ཀྱི་སྒྲིབ་པ་ལའང་རང་བཞིན་དང་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་གཉིས་ཡོད།",
    "གཞན་མའི་ལུགས་ལ་ཧཱུྃ་ཡིག་དེ་ལས་འོད་ཟེར་སྤྲོ་བསྡུས་དོན་གཉིས་བྱས་པ་སོགས་ཡོད་ཀྱང་རང་ལུགས་ལ་མེད།",
    "གཞན་རྩ་བའི་དམ་ཚིག་ཉམས་པ་དག་དང་གཏམ་བསྲེ་ཞིང་འདྲེས་པ་དང་འགྲོ་འདུག་སོགས་སྤྱོད་ལམ་གྱིས་འབྲེལ་བ།",
    "ཕན་པ་ཙམ་བྱུང་བས་མི་ཆོག་དུས་གཏན་གྱི་ཕན་པ་ཞིག་དགོས་ཏེ།",
    "གཞན་དུ་གསར་རྙིང་གང་ལ་ཡང་རང་རང་སོ་སོའི་ལུགས་ཀྱི་མཎྜལ་འབུལ་ཐབས་དུ་མ་ཡོད་ཅིང་།",
    "ཁོ་བོས་དངོས་གྲུབ་སྦྱིན་མི་ནུས་པར་འདུག་ཟེར།",
    "བོད་པྲེ་ཏ་པུ་རིའི་རྒྱལ་ཁམས་དངོས་སུ་འདུག་བོད་ཡུལ་ན་ཞིང་དག་པ་ཞིག་ལ་ནས་བྲེ་གང་སྦྱིན་པར་བཏང་བའི་སྦྱིན་འབྲས་ལ་ལོངས་སྐྱོད་མཁན་མི་འདུག་ཅེས་གསུངས།",
    "གང་ལགས་ཞུམ་པས་ནོར་སྒྲུབ་བྱས་ཀྱང་རང་ལ་སྔོན་གྱི་སྦྱིན་འབྲས་མེད་ན་འོང་བ་ཡང་དཀའ་ཞིང་།",
    "རྣལ་འབྱོར་བས་གཅོད་སྐོར་རྒྱ་ཆེན་པོ་ཤེས་ན་ཡོན་ཏན་དཔག་ཏུ་མེད་པ་ཡོད་ལ་ཅུང་ཟད་ཙམ་ཤེས་པས་ཀྱང་རང་གཞན་ལ་ཕན་ཐོགས་པ་ཡིན་ནོ།",
    "ཟག་མེད་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་འདོད་རྒྱུ་ཡིད་བཞིན་གྱི་སྤྲིན་འཕྲོ་བའི་རོལ་པ་དང་རང་བཞིན་དུ་གྱུར་པར་བསམ།",
    "ཨང་རང་ཉིད་དམིགས་པ་ལ་གོམས་པོ་མེད་ན།",
    "གཅོད་པ་ཙམ་པོ་དེས་ལྷ་འདྲེ་འདུལ་ཐུབ་བར་རློམ་པ་འདུག་ཀྱང་།",
    "དེ་ཙ་ན་ལྷ་འདྲེ་དང་ཡི་དྭགས་རྣམ་ཀྱིས་ཀྱང་དེའི་རྒྱུས་ལོན་ཏེ།",
