    "མགོན་པོ་གྲངས་མེད་བསྐལ་བའི་བར་དུ་མྱ་ངན་མི་འདའ་བཞུགས་གསོལ་ཞིང་།",
    "ཁྱད་པར་ཡང་མཁྱེན་རབ་དང་ཐུགས་རྗེའི་ཡོན་ཏན་དཔག་ཏུ་མེད་པས།",
    "ཟླ་བའི་གཙང་པོ།",
    "མདང་ནུབ་ཀྱི་ལྷ་སྒྲུང་།",
    "ཞར་བཀོད་གཉིས་ཁ་པར་ལ་ཉན་རྗེས།",
    "གངས་བུ་དགའ་སྐྱེད་ཀྱི་སྙན་རྩོམ་པ་སངས་ལགས་དང་དེའི་ཕྲན་དཔྱད།",
    "བྱམས་བརྩེ་བསྐལ་བར་རིང་དུ་གོམས་པས་མཁྱེན་རབ་དཀྱིལ་འཁོར་ཡོངས་སུ་བཟླུམས།",
    "ཤེས་རབ་ཅང་ཤེས་བང་རྩལ་རྒོད་པོ་བསགས་སྦྱང་སྲབ་ཀྱིས་མ་ཟིན་པར།",
    "ལྷ་ས་ལྷ་ཆེན་རལ་བའི་མུ་ཁྱུད་བརྡོལ་ནས་ཤེས་བྱའི་གངྒཱ་ཀློང་དུ་འཕྱོ།",
    "ངོ་མཚར་དམ་པའི་རྣམ་པར་ཐར།",
    "ས་སྟེང་འདི་ན་མཛེས་པར་བཞད།",
    "མཁྱེན་རབ་སྤྲིན་དཀར་བརྩེགས་པའི་ཁྲིར།",
    "མགོན་མེད་ཉམ་ཐག་དབུགས་དབྱུང་མཛད་པར་ཤོག།",
    "ཡང་དག་ལྟ་བའི་ལམ་སྣ་ཟིན་པར་ཤོག།",
    "ཡིད་འོང་སྣོད་ཀྱི་བཀོད་པ་ཕུན་ཚོགས་པར།",
    "རབ་བྱུང་བཅོ་ལྔའི་བགྲང་བྱ་ང་བརྒྱད་པར།",
    "མཁྱེན་རབ་སྣང་བ་ཀློང་དུ་རྡོལ་བར་གྱུར།",
    "དབུགས་དབྱུང་གནང་བའི་རྩེ་དགའ་རྫོགས་ཡོད་མིན།",
    "ཆིབས་བསྒྱུར་གནང་ཞིང་པཎ་ཆེན་དགུ་བའི་མདུན།",
    "གནང་སྟེ་མ་འོངས་པ་ན་རྒྱུད་ཆེན་འདིའི།",
    "ཅེས་པའི་ལུང་བསྟན་གནང་ཞིང་བླང་དོར་གྱི།",
    "ཁྱད་པར་རོང་བོ་རྒྱུད་གྲྭའི་སྔགས་ཆེན་པ།",
    "བློ་སྦྱོང་ལམ་གྱི་རིམ་པར་ཕྱོགས་མེད་སྦྱངས།",
    "ལུང་དང་ཁྲིད་ཀྱི་གདམས་པ་ཡང་དག་བཞེས།",
    "ཁྱད་པར་ཡི་དམ་འཇིགས་མཛད་རྡོ་རྗེ་ཡི།",
    "ཉམས་རྟོགས་རྒྱ་མཚོའི་ཀློང་དུ་སིམ་བྱས་པས།",
    "འདུ་ཁང་གསར་བའི་རྨང་འདིང་གྲྭ་ཤག་སོགས།",
    "གདུང་འབོད་དྲག་པོས་རལ་བ་ཉིད་དུ་བྱས།",
    "བློ་གྲོས་མཁྱེན་བཟང་ཟླ་ཤེལ་འཛུམ་པའི་གར།",
    "ན་རྒ་འཆི་བ་དང་བྲལ་རྟག་བཞུགས་མ།",
    "དཔལ་ལྡན་མདང་ནུབ་ཀྱི་ལྷ་སྒྲུང་།",
    "རིའི་བོང་བུ་ཡིན་པར་གྲགས་ཀྱང་དོན་དུ་ཁྱིམ་དུ་གསོས་ཡོད།",
    "སྙན་ངག་འདི་ནི་ལོར་པར་དུ་བསྐྲུན་པའི་ཁོའི་སྙན་ངག་གཅེས་དེབ་ལས་བདམས་པ་ཡིན་ལ།",
    "པཱ་ན་ཧྥུའུ་བཱ་ཡི་སྙན་རྩོམ་ལ་ཧྥ་རན་སའི་ཡི་གེའི་ཁྲོད་ཀྱི་ཁ་སྐད་ཀྱི་མཛེས་ཉམས་དང་བབ་ཆགས་སོར་བཞག་བྱས་ཡོད་པ་ལས།",
    "རྡུལ་ཕྲན་བྱེ་བའི་ཟུངས་བཅུད་གཞིབས་པར་ཉེར་སྡོག་རྩོམ་པའི་མགོ་ལྕོག་ལྡེམ།",
    "སྐོམ་གདུང་དྲེགས་པའི་ཚ་བ་འཇོམས་པར་ཟེགས་མའི་རླབས་ཀྱི་གུར་ཁང་ཕུབ།",
    "སྲིད་གསུམ་འདར་བའི་ངར་སྒྲ་སྒྲོག་པར་ཉམས་མེད་སྤོབས་པའི་འདུ་འགོད་འཁྲིགས།",
    "རྣམ་དཔྱོད་རྩལ་གྱི་འཁྱུག་འགྲོས་རྫོགས་པར་འཆད་རྩོད་རྩོམ་པའི་རླབས་རིས་སློང་།",
    "སྐོམ་གདུང་སེལ་ཕྱིར་ཉལ་འགྲོའི་གཞུང་ལ་ཕངས་སེམས་མེད་པར་རིང་དུ་ཕོབས།",
    "དབྱར་གྱི་སྒྲ་སྙན་རྒྱུད་སྐུད་དྲུག་འགྱུར་ལྷོད་ཀྱིས་དཀྲོལ་བའི་གཡུ་འབྲུག་ལགས།",
    "སྐལ་ལྡན་བུང་བས་ཀུན་ནས་སྐོར་བའི་བཤེས་གཉེན་སེམས་ཀྱི་ཉི་མ་ལགས།",
    "ཇ་ཡུན་ཙམ་གྱི་ངལ་གསོ་མེད་པར་གནག་ཁྱུའི་རྗེས་ན་འདུར་ཞིང་རྒྱུག།",
    "དག་པ་གཉིས་ལྡན་འདུས་མ་བྱས་ཀྱི་སྐུ།",
    "མཁྱེན་བརྩེའི་དར་གྱིས་བྱི་དོར་བྱས་པའི་དཔལ།",
    "མཁྱེན་པའི་རང་གཟུགས་རྗེ་བཙུན་འཇམ་དཔལ་དབྱངས།",
    "འཕགས་ཡུལ་ནོར་འཛིན་མ་ལུས་ཁྱབ་བྱས་པའི།",
    "རི་མཐོ་ས་གཙང་འབབ་ཆུ་དྭངས་ཤིང་བསིལ།",
    "བཞུགས་པའི་རྟེན་དང་བརྟེན་པའི་དཀྱིལ་འཁོར་ནི།",
    "དཔལ་ལྡན་པ་སངས་ལགས།",
    "ཡིད་བྱེད་ཀྱང་སྣང་བརྙན་རང་བཞིན་སྒོས་འབུར་དུ་ཐོན་པར་བྱས།",
    "རང་སེམས་ཀྱི་འདོད་འདུན་དེ་ལྷག་པར་དུ་འབུར་བརྐོས་ཇི་བཞིན་ཀློག་མཁན་གྱི་སྤྱན་སྔར་རང་གཤིས་ཅན་དུ་མཚོན་པར་བྱས་ཤིང་།",
    "དྲི་བའི་ཚུལ་དུ་དམག་ལྭ་ལྗང་སེར་གྱོན་པའི་པ་སངས་ལགས་ཞེས་ཁ་མཚར་ལྟ་བུའི་ཚིག་སྦྱོར་ལས་གླུ་མའི་ཉམས་སྣང་དེ་ཡང་གསོན་ཤུགས་དང་ལྡན་པར་སྤྱི་ཡོངས་ནས་རྫོགས་པར་བཞེངས་བསྐྲུན་མཛད་བྱུང་།",
    "གལ་ཏེ་ནང་དོན་གསར་བ་དང་བསམ་བློ་གསར་བ་ཞིག་དགོས་པར་འདོད་ཚེ།",
    "ཁ་གཏོད་ཡུལ་བཅས་ཕྱོགས་གང་ཐད་ནས་སྲོལ་རྒྱུན་སྙན་ངག་ལ་གཏོར་བཤིག་དང་བཅིངས་གྲོལ་བྱས་པ་དེ་ཡིས་དུས་རབས་ཉི་ཤུ་བའི་ལོ་རབས་བརྒྱད་ཅུ་བའི་བོད་ལ་བསམ་བློ་གསར་བ་དང་།",
    "འདིར་ཕྲན་གྱིས་བོད་ཀྱི་རྩོམ་པ་པོ་རྣམས་ལ་ལེགས་སྐྱེས་ཤིག་འབུལ་རྒྱུ་ཡོད་པ་ནི་ཨུ་རི་སིའི་རྩོམ་རིག་སྨྲ་བ་པོ་དང་བསམ་བློ་པ་པེ་ལིན་སི་ཁིས་ལགས་ཀྱི་གསུང་དུམ་བུ་ཞིག་སྟེ།",
    "སྡང་བྱེད་དགྲ་བོའི་ཀླད་པ་འགེམས་པར་བྱེད།",
    "ར་སྐྱེས་ཁམ་ནག་སྟེང་དུ་རོལ་སྟབས་བཞུགས།",
    "བཞུགས་པའི་གནས་མཆོག་མཱ་ལ་ཡཱ་སོགས་དང་།",
    "ལངྐ་པུ་རི་བཞུགས་གནས་མ་ངེས་སོགས།",
    "ཁྱད་པར་འོ་ཡུག་ཤུག་པའི་ལུང་སོགས་དང་།",
    "རྟག་ཏུ་བཞུགས་གནས་གནམ་ལྕགས་ཕང་བུ་ནས།",
    "། སྲིད་ཞིའི་མགྲོན་ལ་གཏོར་མ་གཏོང་ཚུལ་ཤིན་ཏུ་བསྡུས་པ་བཞུགས་སོ།",
    "དེ་བཞིན་དུ་བཅུའི་བར་བྱས་པས་ཨ་ཀཱ་རོ་བརྒྱ་དང་གཟན་རིལ་གྱི་གྲངས་སྟོང་འགྲོ།",
