    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་བདག་གིས་འགྲོ་བ་ལ་ཕན་པ་རྟག་ཏུ་བྱའོ་སྙམ་པ་དང་།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་སྐྱེས་བུ་ཆེན་པོའི་མཚན་དང་དཔེ་བྱད་བཟང་པོ་དང་།",
    "དེ་ཡང་གང་གིས་ཇི་ལྟར་མཐོང་།",
    "བཅོམ་ལྡན་ཞེས་ཏེ་འདིའི་དོན་ཅི་ཞེ་ན་ཞེས་པ་ཚིག་སྔ་མ་གཉིས་ཀྱིས་བདག་གི་བ་དང་བདག་བཀག་ཅིང་དགག་བྱ་ཡང་དེར་ཟད་པས་ཚིག་གསུམ་པ་ལ་དགོངས་པ་ཅི་ཞེ་ན།",
    "ནང་གི་དངོས་པོ་རང་གི་ལུས་འདི་ནི་ང་མིན་ཏེ་ནང་གི་དངོས་པོ་འདི་ནི་ང་དང་འབྲེལ་བའི་བདག་མིན་ཞེས་དགོངས་པ་སྟེ།",
    "དེ་ལྟར་ཕྱི་ལ་བདག་གི་བའི་རྣམ་པ་གཅིག་པུ་དང་ནང་བ་བདག་དང་བདག་གི་བ་གཉིས་ཀའི་རྣམ་པ་བཀག་གོ།",
    "ནང་གི་ལུས་ནི་སེམས་ཀྱིས་ཟིན་ཏེ་སེམས་དང་གྲུབ་པ་མ་ཐོབ་པ་ལ་ཐོབ་པ་དང་བདེ་བ་ཐོབ་པའི་རྗེས་སུ་འཇུག་པ་གཅིག་པའི་གཟུགས་ཡིན་པས་སོ།",
    "ཡང་ན་དེ་ཡང་རྩ་བའི་དམ་བཅའི་སྒྲུབ་བྱེད་དུ་སྦྱར་རོ་ སེམས་འགྱུར་ན་ལུས་དེ་འགྱུར་བའི་ཕྱིར་ནི་བདེ་སྡུག་དང་ཆགས་སོགས་ཀྱི་སྐབས་སུ་སྟེ་སྐད་ཅིག་རེ་ལ་འགྱུར་བའི་སེམས་ཀྱི་རྗེས་སུ་འགྱུར་བ་ལ་སྐད་ཅིག་པས་ཁྱབ་པོ།",
    "སྐྱེས་ནས་ཀྱང་འཇིག་བྱེད་ཀྱི་རྐྱེན་ལ་མ་ལྟོས་པས་ན་རང་གི་ངང་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "གིས་འཇིག་པའི་ཕྱིར་རྣམ་འགྲེལ་ངེས་དག་ཏུ།",
    "རང་གི་ངོ་བོས་རྗེས་འབྲེལ་ཉིད།",
    "གསུམ་པ་གཟུགས་དྲི་རེག་བྱ་ཡང་བ་ཅན་གྱི་དུ་བ་དང་དྲི་མེད་པའི་ཆུ་ལྟ་བུ་དང་།",
    "དྲུག་གིས་ཅིག་ཆར་སྦྱར་བ་ན།",
    "དབུས་ཀྱི་ཕྲ་རྡུལ་དེ་ནི་ཆ་དྲུག་དང་བཅས་པར་ཐལ་ཏེ།",
    "ཕྱོགས་ཐ་དད་དྲུག་གི་རྡུལ་གྱིས་ཅིག་ཅར་སྦྱར་བའི་ཕྱིར་རོ།",
    "རྡུལ་ཕྲན་བདུན་འདུས་ཀྱི་གོང་བུ་དེ་ནི་རྡུལ་ཕྲན་གཅིག་དང་ཆེ་ཆུང་ཁྱད་མེད་དུ་ཐལ་ཏེ།",
    "རྡུལ་ཕྲན་གཅིག་གི་གོ་སར་ཆུད་པའི་ཕྱིར་རོ།",
    "དུ་ཁ་སོགས་ལས་རེ་ཤིག་འདའ་བར་ངེས་པ་བྱས་པ་དང་གཏན་དུ་མ་ཡིན་པས་སོ།",
    "བསྡུ་བར་སློབ་པ་གཞི་མཐོང་བ་དེ་སྒོང་སྐྱེས་དང་དྲོད་གཤེར་སྐྱེས་དང་སྒྲ་མི་སྙན་དང་འདུ་ཤེས་མེད་པ་པ་དང་ཟ་མ་དང་མ་ནིང་དང་བུད་མེད་དང་མཚན་མེད་དང་མཚན་གཉིས་པ་སོགས་ལས་སོ་སོར་བརྟགས་མིན་གྱི་འགོག་པ་ཐོབ་པར་གསུངས་སོ།",
    "དུ་ཁ་མ་ཡིན་པ་ནི་ཉོན་མོངས་དང་ལས་ཟག་བཅས་ཀྱིས་མ་བསྐྱེད་པས་སོ།",
    "ལུང་གིས་སྒྲུབ་པ་ནི།",
    "བདུད་སུན་འབྱིན་བྱེད་རང་གི་ལུས་ཁོ་ནས་མནར་མེད་པར་ལྟུང་ངོ་ཞེས་པ་ཅི་ལྟར་ཞེ་ན།",
    "བར་ན་ཁྱོད་ཀྱི་གནས་ཀྱང་ཡོད་མིན་ཞིང་།",
    "འགྲུབ་པའོ་ཞེས་ཏེ་ཕྱིའི་ཁུ་ཁྲག་དང་དྲོད་གཤེར་ལས་མ་བྱུང་གི་རྫུས་ཏེ་སེམས་ལས་བྱུང་བས་ན་ཡིད་འབྱུང་ངོ་ཞེས་ཀྱང་མཛོད་འགྲེལ་དུའོ།",
    "ཡང་དེ་མི་གཡོ་བའི་ལས་མ་ཡིན་པར་ཐལ་ལོ་ཞེ་ན།",
    "ཞེས་ཏེ་མངོན་ཤེས་ཀྱིས་མཐོང་གི་ལྷའི་མིག་སྐྱེས་ཐོབ་ཀྱིས་མི་མཐོང་ངོ།",
    "མིན་ཏེ་དེ་ནི་བལྟར་མི་རུང་བལྟར་རེག་ཏུའང་མི་ནུས་པས་དང་ལས་ལ་རག་ལུས་པས་སོ།",
    "ཡུམ་གྱི་རྨི་ལམ་དུ་གླང་པོ་ཆེའི་ཕྲུ་གུ་དཀར་པོ་ཞུགས་པར་གཟིགས་པ་ནི་མཚན་མ་ཙམ་སྟེ།",
    "དེ་ཡང་གླང་པོ་ཆེ་སྐར་ཁུང་ནས་ལུས་བྱུང་བ་རྔ་མ་ཐོགས་པ་མཐོང་བ་ནི་རྒྱལ་བ་ཤཱཀྱ་ཏོག་གི་ཉན་ཐོས་རྣམས་ཁྱིམ་དུ་ཉེ་དུ་བོར་ནས་རབ་ཏུ་བྱུང་ཡང་གཙུག་ལག་ཁང་ལ་ཁྱིམ་ཀྱི་འདུ་ཤེས་ཀྱིས་ཆགས་པའི་མཚན་མ་སྟེ།",
    "ཙན་དན་ཤིང་གི་རིན་ཐང་དུ་འཚོང་བ་ནི་མུ་སྟེགས་ཀྱི་གཞུང་དང་ཐུབ་པའི་བཀའ་སྙོམས་པའི་དང་།",
    "རང་གི་སྐྱེ་བའི་གནས་སུ་ཐོགས་ཏེ་དེ་དག་གིས་ན་ལྕགས་ཀྱི་ཐུ་ལུམ་འབར་བ་གཤེགས་པའི་ནང་དུ་བྱུང་བའི་སྲིན་བུ་དམིགས་ཞེས་གྲག་གོ།",
    "སྐྲ་སྤུ་སེན་མོ་ལ་སོགས་དང་།",
    "བཞིས་བདུན་ཕྲག་བརྒྱད་པ་ལ་སོར་མོ་ཉི་ཤུ་འགྲུབ་པར་གསུངས་རྐང་ལག་འགྱུས་པ་དང་མཁྲེགས་པ་དང་བུ་ག་དགུ་དང་ནང་ཁྲོལ་དང་བཀྲེས་སྐོམ་དང་ཆུ་རྒྱུས་དང་རྩ་འབྱུང་ངོ།",
    "དྲུག་གིས་མིག་སོགས་ཀྱི་གནས་དོད་པ་དང་མིག་སོགས་བཞི་དང་ཞིང་གསལ་བ་དང་བཞིས་རུས་པ་སྦོམ་ཕྲ་ཉེར་གཅིག་པ་ན་ཤ་སྐྱེ་བར་གསུངས་དང་ཁྲག་དང་ལྤགས་པ་དང་སྐྲ་དང་དེ་གསུམ་གསལ་བའོ།",
    "མོ་ནི་མའི་སྒལ་ཚིག་ལ་བརྟེན་ཏེ་བྲང་ལ་ཁ་ལྟ་ཞིང་གློ་གཡོན་ན་དང་།",
    "རང་གི་ལས་དང་མས་ལན་ཚ་དང་སྐོམ་མང་དུ་བསྟེན་པས་བ་སྤུ་དང་སྐྲ་ངན་པ་དང་།",
    "གལ་ཏེ་ལས་དང་མའི་བྱ་བས་མངལ་དུ་འཆི་སྲིད་དོ་ བདེ་བར་བཙས་ན་རིམ་གྱིས་བསྐྱེད་དེ་ཉོན་མོངས་པ་ཀུན་ཏུ་སྤྱོད་ཅིང་ལས་ཇི་རིགས་སུ་གསོག་གོ།",
    "འཕེལ་ནས་ལས་དང་ཉོན་མོངས་ཀྱིས།",
    "རང་གི་མཚན་ཉིད་དང་།",
    "གཙོ་བོར་ཞེས་ཏེ་སྲེད་པ་ནི་ཀུན་འབྱུང་གི་གཙོ་བོ་ཡིན་པ་ལ་དགོངས་པའོ་ཞེས་པའི་དོན་ཏོ།",
    "དགའ་བ་ཡིད་བདེ་ཉོན་མོངས་ཅན་དང་འདོད་ཆགས་དང་ལྡན་པ་ནི་ཡུལ་ཐོབ་པ་ལའོ།",
    "གཙོ་བོའི་དོན་ཉིད་ནི་ཐམས་ཅད་དུ་འགྲོ་བ་ཡིན་པས་ན་དེ་སྨོས་པས་ཀུན་འབྱུང་གི་བདེན་པ་ལྷག་མའི་དངོས་པོ་འགྲུབ་པའི་ཕྱིར་དེ་ཁོ་ན་བཀའ་བསྩལ་པའོ།",
    "གནས་སྐབས་ལ་ནི་དུ་ཁའི་དུ་ཁའི་སྐབས་ཐོབ་པ་ལ་འབྲལ་བར་དང་མ་ཐོབ་པ་ལ་མི་ཕྲད་པར་སྲེད་ཅིང་འགྱུར་བའི་ལ་མི་འབྲལ་བ་དང་ཐོབ་པར་སྲེད་ལ་འདུ་བྱེད་ཀྱི་ལ་གཏི་མུག་གི་སྒོ་ནས་སྲེད་དོ།",
    "ཁྱད་པར་དུ་ཀུན་གཞི་ནི་ཉོན་མོངས་ཅན་གྱི་ས་བོན་གྱིས་ཕྱེ་བ་དང་ཚོར་བ་བཏང་སྙོམས་ཀྱིས་ཕྱེ་བས་འདུ་བྱེད་ཀྱི་དུ་ཁའི་སྐབས་ཏེ་དེ་ལ་བདག་ཏུ་རྨོངས་པའི་སྒོ་ནས་བདག་ལ་སྲེད་པའོ།",
    "པའི་སྲེད་པ་དག་གིས་སོ།",
    "ཤེས་བྱའི་དངོས་པོ་ཉོན་མོངས་པ་དེ་ཤེས་བྱའི་དོན་གྲངས་སོགས་བཅུས་གཏན་ལ་དབབ་པའོ།",
    "བདག་དང་བདག་གི་རྟག་ཆད་དང་།",
    "ཕྱི་ཅི་ལོག་དོན་ཇི་ལྟ་བ་མ་ཡིན་པའི་ཡུལ་ཅན་གྱིས་དང་མཛེས་པ་མེད་པ་ངོ་ཚ་མེད་པ་དང་ཁྲེལ་མེད་ཀྱིས་མ་ཞི་བ་སྟེ་དེ་རྣམས་གཅིག་ནས་དྲུག་གི་བར་ཇི་རིགས་པས་སོ།",
    "མ་རིག་ཅེས་ཏེ་བོར་བའི་ལྷག་མས་ནི་རང་གི་ས་པ་ཁོ་ན་ལ་ང་དམིགས་སོ།",
    "བསྡུ་བར་ས་འོག་མ་པ་རྣམས་ཀྱིས་གོང་མའི་ཉོན་མོངས་ལ་མི་དམིགས་ཀྱི་གཞི་ལ་དམིགས་པར་གསུངས་སོ།",
    "ཞིབ་མོར་ན་དེས་ཀྱང་འོག་མ་ལ་དམིགས་སྲིད་དེ།",
    "བསྡུ་བར་གཞན་གྱི་ཡུལ་ལ་དམིགས་པའི་ཐད་དུ་ས་འོག་མ་ནི་ས་གོང་མའི་ཉོན་མོངས་པ་རྣམས་ཀྱི་སྟེ་ཞེས་སོགས་གསུངས་སོ།",
    "འགོག་པ་ཞེས་ཏེ་འགོག་ལམ་ནི་མཉམ་བཞག་དང་རྗེས་ཐོབ་ཀྱི་ཡེ་ཤེས་ཀྱིས་སོ་སོ་རང་གིས་རིག་བྱ་ཡིན་པས་སོ།",
    "དེ་རྣམས་ཅི་ལྟར་དེ་དག་གི་རྣམ་པ་ཅན་ཡིན་ཞེ་ན།",
    "ཉོན་མོངས་དེའི་དམིགས་པ་ནི་ཉོན་མོངས་དང་མཚུངས་ལྡན་གྱི་སེམས་དེས་རྟོག་པ་སྒྲོ་བཏགས་པ་སྟེ་བརྟགས་པ་ཞེས་བརྗོད་པར་བྱ་རྒྱུ་ལ་རྟོག་པའོ་ཞེས་པ་ནི་རྟོག་བྱེད་ལས་བརྟགས་པ་གུད་ན་མེད་པས་སོ།",
    "མཚུངས་ལྡན་ལ་གཉིས་ལས་རྩ་བའི་ཉོན་མོངས་ཀྱི་ནི།",
    "མ་འདྲེས་པ་ནི་འདིར་དེ་དེ་ལས་གཞན་པ་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པས་ཀུན་ནས་མ་དཀྲིས་པའོ།",
    "མི་མཐུན་པ་མེད་པ་རྣམས་ཉོན་མོངས་པ་བཞིན་དུའོ།",
    "མི་མཐུན་པ་དག་མ་ཡིན་ཏེ་འདོད་ཆགས་ཀྱི་ཆར་གཏོགས་རྣམས་ཞེ་སྡང་གི་ཆར་གཏོགས་དང་མ་ཡིན་པ་ལྟ་བུའོ།",
    "རྨུགས་པ་སོགས་ནི་ཉོན་མོངས་པ་ཀུན་དང་ལྡན་ཏེ་ལས་སུ་མི་རུང་བ་ཉིད་སོགས་མེད་པར་ཉོན་མོངས་མི་སྲིད་པས་སོ།",
    "ཕྱིན་ཅི་ལོག་གིས་སེམས་ཉེ་བར་ཉོན་མོངས་པར་བྱེད་པས་ཉེ་བའི་ཉོན་མོངས་པའོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དུ་གྱུར་པས་དྲི་མའོ།",
    "རབ་ཏུ་མ་ཞི་བ་དང་རིང་དུ་སོང་བས་ཟུག་རྔུའོ།",
    "བདག་གི་བཤེས་ལ་གནོད་པ་བྱས་སོ་བྱེད་དོ་བྱེད་པར་འགྱུར་རོ།",
    "ཅུང་ཟད་སྙམ་པ་ནི་འདུད་པའི་ང་རྒྱལ་ཞེས་བྱ་བའང་སྟེ་ཁྱད་ཇི་ལྟར་ཡོད་པ་ལྟར་མི་འཛིན་པས་སམ་མཆོག་གི་ཚོགས་ཀྱི་ནང་ན་བདག་དམའ་གཞན་ན་ཐ་གིའོ་སྙམ་དུ་ཁེངས་པས་ང་རྒྱལ་ལོ།",
    "ང་དང་ང་ཡིར་འཛིན་པ་བདག་དང་བདག་གི་བའི་རྣམ་པ་ཅན་གྱི་འཇིག་ཚོགས་ལྟ་བ་སྟེ་ཡོངས་སུ་མི་ཤེས་པ་ནི་སྐྱོན་མ་མཐོང་བས་མི་སྤོང་པའོ།",
    "གང་ཞིག་གང་གིས་ཆགས་བྲལ་བ།",
    "བག་ལ་ཉལ་ཉོན་མོངས་པའི་ས་བོན་ལ་གསུམ་ལས་དབྱེ་བ་ནི་བདུན་ཏེ་འདོད་པ་ལ་ཞེས་སོ།",
    "ཁམས་གོང་མ་དག་སྲིད་པ་སྟེ་འདོད་ཡོན་ལ་མི་སྤྱོད་ཀྱི་བདག་གི་དངོས་པོ་གཙོ་བས་སོ།",
    "ཉེ་བའི་ཉོན་མོངས་པ་གསུམ་ལས་ཉོན་མོངས་པ་རགས་ཕྲ་ལ་དེར་གཞག་པ་ནི་ཉོན་མོངས་པ་གང་ཡིན་ཞེས་ཏེ།",
    "སེམས་ཉེ་བར་ཉོན་མོངས་པར་བྱེད་པས་སོ།",
    "ཉོན་མོངས་ལ་ཉེ་བར་བརྟེན་ཏེ་བཏགས་པས་ན་ཉེ་བའི་ཉོན་མོངས་ཉིད་ཡིན་པ་ནི་རྩ་བའི་ཉོན་མོངས་རྣམས་བོར་བའི་སེམས་བྱུང་ཉོན་མོངས་པ་ཅན་ཁྲོ་བ་སོགས་སོ།",
    "ཉེ་བའི་ཉོན་མོངས་ཀྱི་དོན་སྟོན་པ་ལ་གཉིས་ཀྱི་དངོས་ནི་དུག་གསུམ་དེས་ཞེས་ཏེ་མཐོང་ལམ་གྱིས་ཆག་བྲལ་དང་སྒོམ་ལམ་གྱིས་གྲོལ་བར་མི་འགྱུར་ཏེ་དེ་དག་ལ་སྒྲིབ་བྱེད་མ་སྤངས་པའི་ཕྱིར་ཉེ་ཉོན་དུ་བརྗོད་དོ།",
    "དེ་ལ་ལུང་དགོད་པ་ནི་བཅོམ་ལྡན་ཞེས་ཏེ་ཀུན་ནས་ཉོན་མོངས་ནི་ཉེ་བའི་ཉོན་མོངས་དང་དོན་གཅིག་གོ་ཞེའོ།",
    "ཞུམ་མམ་ཞུམ་དུ་དོགས་པའི་དུས་སུ་རབ་ཏུ་འཛིན་པ་བརྩོན་འགྲུས་དང་ལྷག་མཐོང་གི་རྒྱུ་དགའ་བར་བྱ་བ་ཡིད་ལ་བྱེད་པ་སོགས་ལ་རྒོད་འགྱོད་དེ་ཕྱི་རོལ་དུ་གཡེང་བར་བྱེད་པས་སོ།",
    "གཞན་དང་བདག་གི་ཕུན་ཚོགས་ལ་སྡང་ཆགས་ཀྱིས་ཡང་ཡང་དུ་སེམས་གཡོ་བས་སོ།",
    "ཀུན་ནས་ཉོན་མོངས་དང་མཐུན་པའི་ཆ་ནས་གཞག་པའི་ཆུ་བོ་ལ་འདོད་ཁམས་ཀྱི་ལྟ་རྨོངས་བོར་བའི་རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་དང་ནི་འདོད་པའི་ཆུ་བོ་སྟེ་གོང་མ་དག་གི་ནི་སྲིད་པའི་འོ།",
    "ཡང་ན་དེ་ལྔ་ནི་ཀུན་ཏུ་སྤྱོད་པ་དང་དང་དུ་ལེན་པ་དང་ཟིལ་གྱིས་ནོན་པ་དང་དེས་མི་འཛེམ་པས་དང་དེ་ལ་ཀུན་ཏུ་དགའ་བ་དང་རིམ་བཞིན་ཏེ་དེ་རེ་རེའི་ཡང་རྒྱུས་ཞེས་སོ།",
    "ཕྱི་མ་དག་ནི་ལྟ་བ་མི་མཐུན་ན་རང་གི་ལྟ་བར་སྒྱུར་བར་དགའ་བ་དང་།",
    "འོ་བརྒྱལ་མེད་པའི་ཡང་ཡོད་མོད།",
    "རབ་བྱུང་གི་རྩོད་པའི་རྩ་བ་ཕྱེ་སྟེ་སྦྱར་བ་ནི་བར་པ་གཉིས་ཀྱིས་མུ་སྟེགས་རྣམས་རྩོད་དེ་དེ་ལ་འདོད་པ་དུ་མར་གྱུར་པས་སོ།",
    "ཅི་ཡང་ནི་འདི་ནི་ཅི་ཡང་དང་བཅས་པའོ་ཞེས་སྨྲ་བ་ལྟར་ནོར་ཡིན་ལ་དེ་རང་གི་བར་བྱེད་པའི་རྒྱུ་དུག་གསུམ་དེ་རྣམས་སོ།",
    "ས་དང་བསྡུ་བར་གསུངས་པ་ལྟར་རྩ་བར་འཇོག་པའི་རྒྱུ་ནི་ཟང་ཟིང་ངན་པ་ཅེས་ཏེ་རིམ་པས་ལོངས་སྤྱོད་འདོད་པ་རྣམས་ཆགས་པས་དང་གཞན་གྱི་གནོད་པ་མི་བཟོད་པ་རྣམས་ཞེ་སྡང་གིས་དང་ལྟ་ལོག་ཅན་མཆོད་སྦྱིན་པ་སོགས་གཏི་མུག་གིས་ཉེས་སྤྱད་སྤྱོད་པས་རྩ་བའོ།",
    "ཟག་པ་ལ་འདོད་པའི་ཁམས་སུ་ཟག་པ་བ་ནི་མ་རིག་པ་བོར་བའི་རང་སའི་ཉོན་མོངས་སོ།",
    "ཉོན་མོངས་ཀུན་དཀྲིས་བཅས་འདོད་པའི།",
    "དེར་འཇོག་པའི་རྒྱུ་ནི་སེམས་འཕྲོ་བར་སྐྱེ་མཆེད་དྲུག་གི་རྨ་ནས་འཛག་པས་ན་རྒྱུད་ཡུལ་རྣམས་ལ་ཟག་པར་བྱེད་པའི་དོན་གྱིས་ཏེ།",
    "མཉམ་གཞག་གི་གནས་སྐབས་ཉིད་ན་རོ་མྱང་ཅན་སོགས་ཀྱིས་ནང་དུ་བལྟས་ཏེ་ཟག་པ་དང་འདོད་སྲིད་ཀྱི་ཟག་པ་དེ་གཉིས་ཞེས་སོ།",
    "བུད་མེད་དེ་སྔོ་བསངས་སོ།",
    "མངོན་རྟགས་སུ་འཛིན་པ་ནི་སྐྱེས་པ་དང་བུད་མེད་ཀྱི་ལག་པ་དང་ནུ་མ་སོགས་ལ་དགའ་བྱར་འདུ་ཤེས་པ་སོགས་ཏེ།",
    "ལྟ་བ་གསུམ་ཤེས་བྱ་ལ་སྒྲོ་འདོགས་དང་སྐུར་འདེབས་ཇི་རིགས་པས་ཏེ་ཆད་ལྟ་དང་ལོག་ལྟའི་ཕྱོགས་གཅིག་གིས་སྐུར་པ་འདེབས་པས་ཞེའོ།",
    "མ་རིག་པ་ནི་ཐམས་ཅད་ལ་སྟེ་ཡང་དག་པའི་དོན་འགེབས་པས་རྟོག་པ་ངན་པ་ཀུན་གྱི་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་རོ་ གཉིས་པ་སྤྱིའི་ལོག་ཞུགས་ནི་བཅུ་པོ་ཐམས་ཅད་དུ་ཁ་དང་ཀུན་འབྱུང་ལ་བཅུ་པོ་གཉིས་དེ་དག་གི་རྒྱུ་དང་དེ་གཉིས་ཀྱང་བཅུ་པོའི་གཞིའི་གནས་ཀྱིས་ཏེ་དེ་ལྟར་ཡིན་པས་ལོག་པར་སྒྲུབ་པའམ་དེ་ལྟར་འཛིན་པས་ལོག་པར་རྟོག་པའོ།",
    "དེ་ནི་རགས་པས་ཏེ་ཕྲ་མོར་ན་བདེ་བ་དང་ཕྲད་ཅིང་མི་འབྲལ་བ་དང་དུ་ཁ་མི་ཕྲད་ཅིང་བྲལ་བར་སྲེད་པ་ལ་དེ་ལས་བཟློག་པ་བྱུང་བ་ན་དུ་ཁ་དང་ཡིད་མི་བདེ་དང་ལྡན་ཞེས་བསྡུ་བར་རོ།",
    "ཕྲ་མོར་ན་དགྲ་དུ་ཁ་བ་ན་བདེ་བ་དང་ཡིད་བདེ་དང་ལྡན་ཞེས་བསྡུ་བར་རོ།",
    "ཕྲ་མོར་ན་དེ་དང་ཁེངས་པའི་ང་རྒྱལ་མི་ལྡན་ཡང་འདུད་པའི་ང་རྒྱལ་ལྡན་ཞེས་བསྡུ་བར་རོ།",
    "ང་རྒྱལ་ཇི་ལྟ་བར་ལྟ་བར་བཞིའང་སྟེ་ཕྲ་མོར་ན་བདེ་བ་དང་ལྡན་པའི་ཕུང་པོ་ལ་བདག་དང་བདག་གི་བ་དང་རྟག་པར་ལྟ་ན་ཡིད་བདེ་དང་དུ་ཁ་ཅན་གྱི་ཕུང་པོ་ལ་ལྟ་ན་ཡིད་མི་བདེ་དང་བཏང་སྙོམས་ལ་ལྟ་ན་བཏང་སྙོམས་དང་ལྡན་ཞིང་ཆད་ལྟ་དེ་ལས་བཟློག་པ་སྟེ་མཆོག་འཛིན་གཉིས་ལྟ་བ་དེ་རྣམས་མཆོག་ཏུ་འཛིན་པ་ལས་དེ་དེ་བཞིན་དུ་མཚུངས་ལྡན་ཇི་རིགས་པར་རོ་ཞེས་བསྡུ་བར་རོ།",
    "ཕྲ་མོར་ན་རང་ལ་རྙེད་བཀུར་སོགས་མེད་ཅིང་ངན་འགྲོ་ལ་ངེས་པ་ཅན་རྣམས་ལ་གཞན་གྱིས་ཐེ་ཚོམ་སྐྱེད་པ་ནི་ཡིད་བདེ་དང་ལྡན་ཞེས་བསྡུ་བར་རོ།",
    "ཐ་མལ་པ་ཞེས་པ་ཉོན་མོངས་པ་ཀུན་ཇེ་ཆུང་དུ་སོང་སྟེ་རྒྱུན་ཆད་ཁ་ཀར་མཉམ་སྙོམས་སུ་གྱུར་ནས་འགག་པའི་ཕྱིར་རོ།",
    "ཁམས་གང་ན་གཞི་ཕྱོགས་རེ་དང་ཀུན་ལ་འཇུག་ཚུལ་ནི་འདོད་ཆགས་ཞེས་ཏེ་ཡིད་དུ་འོང་མི་འོང་ལ་འཇུག་པ་དང་རིགས་སོགས་གང་རུང་གིས་ཁེངས་པའི་ཕྱིར་རོ།",
    "དབྱེ་བ་ནི་འདོད་པའི་ཁམས་ན་ཞེས་ཏེ་སྡུག་བསྔལ་ལ་འཇིག་ལྟས་བདག་དང་བདག་གི་བ་དང་།",
    "དམིགས་པའི་སྒོ་ནས་རང་གི་ས།",
    "རང་གིར་མ་བྱས་གཉེན་པོའི་ཕྱིར།",
    "འོ་ན་གཟུགས་མེད་ན་ལུས་ངག་གི་སྤྱོད་པ་མེད་ཅིང་དེས་ན་དེ་ལ་དག་གྲོལ་དུ་འཛིན་པ་མེད་པས་བརྒྱ་རྩ་བརྒྱད་དུ་འགྱུར་རོ་ཞེ་ན།",
    "ཚེ་དང་ལྡན་པ་བྲན་ཅན་ཁོ་བོས་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་འདི་རྣམས་ལ་བདག་གམ་བདག་གི་བར་མ་མཐོང་མོད་ཀྱི།",
    "གོང་མར་དག་ན་ཁོང་ཁྲོ་མ་གཏོགས་པ་ལྔ་རེ་སྟེ།",
    "དེ་རྣམས་ལ་ས་དང་ཆེ་འབྲིང་དགུས་ཕྱེ་ན་ཁོང་ཁྲོ་དགུ་དང་ལྔ་ལ་བརྒྱད་ཅུ་རྩ་གཅིག་རེ་སྟེ་བཞི་བརྒྱ་བཅུ་བཞིའོ།",
    "ངོ་བོ་ཉིད་ནི་སེམས་ཀུན་ནས་ཉོན་མོངས་ཤིང་རབ་ཏུ་མ་ཞི་བའོ།",
    "ཉེས་དམིགས་ནི་རང་དང་གཞན་དང་གཉིས་ཀ་ལ་གནོད་པ་དང་ཚེ་འདི་དང་ཕྱི་མའི་ཁ་ན་མ་ཐོ་བ་སྐྱེད་པ་དང་དེ་ལས་སྐྱེས་པའི་སྡུག་བསྔལ་དག་མྱོང་བ་སྟེ་དེ་དག་གིས་སུན་འབྱིན་པའི་གཉེན་པོ་གསུངས་སོ།",
    "གསུངས་པ་ནི་མ་ཕྱེད་པ་སྟེ་ཡུལ་ལ་ལྟོས་པའི་འགལ་བ་ཚ་རེག་གྲང་རེག་ལྟ་བུ་ལ་དེ་ལྟར་ཡིན་ཡང་།",
    "དེ་ལ་གནོད་པ་མི་བྱེད་ཀྱང་མཐོང་སྤང་འགགས་རྗེས་སུ་མཐོང་ལམ་སྐྱེས་པས་སྤང་གཉེན་ཡིན་ན་བུམ་པའི་ཤུལ་དུ་སྣམ་བུ་བཞག་ན་དེ་དག་སྤང་གཉེན་དུ་ཐལ་ཞེས་སྐྱབས་གསུང་བ་ནི་མི་འདྲ་སྟེ་ལམ་གྱིས་སྤང་བྱ་རྒྱུད་དེ་ལ་སླར་མི་སྐྱེ་ངེས་པར་བྱེད་ཅིང་བུམ་སྣམ་ལ་དེ་མེད་པས་སོ།",
    "དེས་སྐྱེད་ལུས་དང་ངག་གི་ལས།",
    "ལས་ལྔ་ལ་དམིགས་པ་ནི་མིག་གིས་གཟུགས་ལྟ་བ་སོགས་སོ།",
    "ཡང་ན་རང་གི་མཚན་ཉིད་ཀྱི་བྱེད་པ་གཟུགས་སུ་རུང་བ་སོགས་སོ།",
    "གང་གིས་སྲོག་གཅོད་སོགས་སྤོང་བའི་སེམས་པ་དང་མ་ཆགས་པ་དང་བྱམས་པ་དང་ཡང་དག་ལྟ་བ་དང་ལྷན་ཅིག་པའི་སེམས་པའོ་ཞེའོ།",
    "འདི་རྣམས་ནི་སོ་སོར་བརྟགས་མིན་གྱི་འགོག་པར་གྱུར་པ་སྒྲ་མི་སྙན་པའི་ལྟ་བུ་མིན་གྱི་རང་རང་གི་གཞི་ཉེ་ཡང་གཉེན་པོས་སྤོང་བའོ།",
    "སྦྱོར་བ་ནི་ལས་དེ་བྱ་བའི་ཆེད་དུ་རང་གིའམ་གཞན་ལ་བཅོལ་བའི་ལུས་ངག་ཡིད་ཀྱིས་རྩོམ་པའོ།",
    "ཉོན་མོངས་པ་ནི་གཞུང་ཉིད་དུ་འཆད་དོ།",
    "མེ་དང་རེག་པས་འཚིག་པ་བཞིན་ཞེས་ཟེར་བ་ནི་གཅེར་བུ་པ་སྐྲ་འབལ་བས་དུ་ཁ་སྐྱེད་པ་དང་གསུངས་ཏེ་མ་ཞུ་བས་ཤི་ན་ཟས་སྟེར་བ་པོ་ལ་དང་།",
    "མཐུ་དང་འཇབ་བུས་བདག་གིར་བྱེད།",
    "ཞེས་གཞི་དང་སྦྱོར་བ་སྟེ་བགྲོད་བྱ་མིན་པ་རང་གི་ཆུང་མ་དང་སྨད་འཚོང་མ་གླ་བྱིན་པ་ལས་གཞན་གཞན་གྱི་ཆུང་མ་ཆུང་གཉེན་བྱས་པ་སོགས་དང་གཞན་གྱིས་གླ་སྔར་བྱིན་པའི་སྨད་འཚོང་མ་དང་མ་དང་བུ་མོ་སོགས་དང་ཕ་དང་མའི་བདུན་བརྒྱུད་ཚུན་ཆད་དང་།",
    "ཉོན་མོངས་ཅན་གྱི་སེམས་ཀྱི་ཚིག།",
    "ཅེས་གཞི་དང་བསམ་པ་དང་ཉོན་མོངས་དང་སྦྱོར་བ་སྟེ།",
    "ཉོན་མོངས་ཅན་ཀུན་ཚིག་ཁྱལ་ཉིད།",
    "ཁ་ཅིག་རྫུན་སོགས་ལས་གཞན་པའི་ཉོན་མོངས་ཅན་གྱི་ཚིག་ཅེས་སྨྲ་སྟེ།",
    "གཞན་ནི་དེ་ལས་གཞན་ཉོན་མོངས།",
    "ཞེས་པ་དེའི་ལྟ་བར་གྱུར་པའི་ཕྱི་རོལ་པའི་གཞུང་འཆད་པ་སོགས་དང་འཐབ་མོ་དང་འདུ་འཛིའི་གཏམ་སོགས་སོ།",
    "གཞན་མེད་དེ་ལས་མ་ཟད་བར་དུ་མི་འཆི་བས་དང་རྫས་དང་བུད་མེད་བཟུང་བ་མེད་པས་དང་།",
    "ཞེས་པ་ཉོན་མོངས་པའི་སེམས་ཀྱི་གླུ་ལེན་པས་སོ།",
    "མི་ཚངས་པར་སྤྱོད་པ་ནི་བུད་མེད་བཟུང་སྟེ་ཤིང་གི་རྩར་ཁྲིད་པས་བགྲོད་བྱ་ཡིན་ན་ཤིང་གིས་སྒྲིབ་ཅིང་བགྲོད་བྱ་མིན་ན་མི་སྒྲིབ་པས་ཉལ་པོ་མི་བྱེད་དོ།",
    "དེར་ནན་གྱིས་ཁྲིད་པ་སྲོག་གི་ཆེད་དུའང་མི་གསད་དོ་ཞེས་ངེས་པ་བྱས་པ་ལ་ནི་མི་འགྱུར་ཏེ་དོན་གཅིག་པ་མེད་པའོ།",
    "སྲོག་གཅོད་སོགས་ངག་གིས་བྱེད་པ་གཞན་ལ་བསྒོ་བ་དང་ཡིད་ཙམ་གྱིས་བྱེད་པ་དྲང་སྲོང་ཁྲོས་པ་དང་ནུས་པས་རྫས་འགུགས་པ་སོགས་རྒྱ་ཆེར་རོ།",
    "ཞེས་ཀྱང་སྟེ་རྫོགས་པ་ནི་ཇི་ཙམ་གྱིས་ངན་སོང་ངམ་མཐོ་རིས་སུ་འགྲོ་བའོ།",
    "ཉོན་མོངས་རབ་དང་དྲག་པོ་དང་།",
    "དེ་དག་སྡུག་བསྔལ་ཆེ་བ་འབྲིང་གི་དང་ཆུང་བ་ཆུང་ངུའི་ཡིན་པས་མི་འགལ་ལོ།",
    "བྱེ་བྲག་ཏུ་ནི་དྲན་པ་ཉེར་བཞག་གི་ཚིག་ལེའུར་བྱས་པར།",
    "འདིར་ནི་ལུས་ཅན་རྣམས་དག་གི།",
    "ལུས་དང་ངག་ཡིད་ཉོན་མོངས་བྱེད།",
    "གང་གིས་ལྷ་དང་བྲམ་ཟེ་དང་།",
    "མེད་པར་ལྟ་བ་གང་ཞིག་གིས།",
    "གཞན་རྣམས་ལ་ནི་ཉོན་མོངས་བྱེད།",
    "དགེ་སློང་གི་ལོ་དྲི་བར།",
    "བརྣབ་སེམས་ཡིད་ལ་རེ་བ་འཇོམས།",
    "འདོད་ལོག་གིས་རྡུལ་གྱིས་འཁྲིགས་པ་དང་།",
    "འབྲིང་གིས་འདོད་ཁམས་ཀྱི་ལྷ་དང་ཆུང་ངུས་མི་རྣམས་སུ་སྐྱེ་བར་གསུངས་སོ།",
    "དེ་དག་ལ་མུ་བཞི་སྟེ་སྐྱ་རིས་ཀྱི་གཟུགས་བཟང་ངན་དང་ཚོན་བཟང་ངན་བཞིན་ནོ།",
    "ལས་བྱ་རྫོགས་ཀྱི་སྐད་ཅིག་གཅིག་གིས་ལུས་སྐྱེ་བ་གཅིག་ཁོ་ན་འཕེན་པར་བྱེད་པ་སྤྱོད་འཇུག་ཏུ།",
    "གཅིག་གིས་སྐྱེ་བ་གཅིག་འཕེན་ཏེ།",
    "དོང་ཙེ་གཅིག་གིས་ཕྱུག་པོ་འདི་བྱུང་ཞེས་སྨྲ་བ་ལྟ་བུར་སྨྲའོ།",
    "བུད་མེད་ནི་གཏུན་སོགས་དང་འདྲའོ་ཟེར་བ་ལྟ་བུ་དང་།",
    "བརྫུན་སོགས་ལ་ཇི་རིགས་པ་སྔ་མ་ལྟར་ཏེ་ཀུན་ལ་འདི་ལ་སྐྱོན་ཅི་ཡང་མེད་དོ་ཞེས་ལྟ་བ་ནི་གཏི་མུག་གིས་སོ།",
    "དེ་ལྟ་བུའི་ཐུན་མོང་བ་སྟེ་འབྲས་བུ་ཐུན་མོང་བ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེའོ།",
    "དེ་ཉིད་གསལ་བར་བྱེད་པ་འདི་ལྟར་གཞན་དང་ཕན་ཚུན་དུ་ལྟ་བ་དང་སྨྲ་བ་དང་ཐ་ནའང་ཐོས་པ་སོགས་མི་སྤྱོད་པ་མོད་པ་རྙེད་སླ་བ་མ་ཡིན་གྱི་དཀོན་ཏེ་གཟུགས་མེད་པ་འགའ་ལ་སྲིད་དོ།",
    "གཉེན་པོ་ནི་འཕགས་པའི་ལམ་མོ་ཞེའོ།",
    "སེམས་གཅིག་གིས་ནི་གྲོལ་ལ་ལྟོས།",
    "རང་རང་གི་རྩ་བ་གསུམ་ཅར་དང་ལྡན་མི་ལྡན་དང་།",
    "རང་རང་གི་མི་མཐུན་པས་རེ་ཤིག་དང་གཏན་དུ་དང་།་",
    "གཉིས་པ་ནི་ཡང་དག་འདོད་པ་ཞེས་ཏེ་རང་བཞིན་གྱི་ངང་གིས་སྟོབས་དང་ལྡན་པ་ནི་ཉོན་མོངས་དང་ཉེ་བའི་ཉོན་མོངས་དང་ལས་ལམ་གྱི་འཁོར་མང་བས་སོ།",
    "སྐྱེ་བོ་མང་པོ་ནི་རང་གིས་ཀྱང་བྱས་གཞན་ཡང་བྱེད་དུ་འཇུག་པའོ།",
    "དང་པོ་ནི་བཅོམ་ལྡན་གྱིས་སྐྱེ་བོ་གང་ཞིག་འདི་སྐད་དུ་སྐྱེས་པ་དང་བུད་མེད་འདི་ཚོར་བ་ཇི་ལྟ་ཇི་ལྟ་དང་ལྡན་པས་ལས་བྱེད་ཅིང་གསོག་པའི་ཚོར་བ་དེ་ལྟར་རྣམ་སྨིན་མྱོང་ན་ཉོན་མོངས་དྲག་པོ་ཅན་གྱིས་སོ་སོར་བརྟགས་ཏེ་ཉོན་མོངས་བསལ་ཡང་དྲན་པ་ཉམས་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "གཉིས་ཀ་མ་ཡིན་པ་ཕྱོགས་གཅིག་གིས་ཕན་འདོགས་པ་དང་གནོད་པ་ལ་ཞུགས་པའོ།",
    "ལྷ་ལའང་མི་རྣམས་ལ་གསུམ་མོ།",
    "ཞེས་ཏེ་དེ་ལ་ཟ་མ་སོགས་ལ་ནི་གདུལ་བར་དེ་ལྟ་བུ་བསལ་བར་གསུངས་པས་དང་རང་བཞིན་གྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པས་སྒྲིབ་པ་དང་སོ་སོར་རྟོག་པ་མི་བཟོད་པ་དང་རྟེན་གཉིས་ཀའི་ཉོན་མོངས་ཤེས་ཆེ་བ་དང་དང་ངོ་ཚ་དང་ཁྲེལ་ཡོད་ཤས་ཆུང་བའོ།",
    "སྒྲ་མི་སྙན་པ་ལ་ལེན་པ་དང་ཏིང་ངེ་འཛིན་མེད་པས་དང་ངན་སོང་རྣམས་ལ་ངོ་ཚ་དང་ཁྲེལ་ཡོད་མེད་པས་སྡོམ་པ་མེད་དོ།",
    "རྒྱལ་སྲས་འཕགས་པས་ངན་འགྲོར་སྐྱེ་བ་བསྟན་པ་ལ་སྡོམ་པ་ཡོད་ཀྱང་དེ་ངན་སོང་མཚན་ཉིད་པ་མིན་ནོ།",
    "དགེ་སློང་གི་སྡོམ་པ་ཕམ་པ་བཞི་དང་།",
    "གཞི་བསྡུས་ཀྱི་ཉེས་བྱས་སོགས་ལུས་ངག་གི་ལས་སྤང་བྱ་ཀུན་སྤོང་བ་བླངས་པ་དང་།",
    "དགེ་སློང་མ་དེ་ལྟ་བུ་བུད་མེད་ལ་སྐྱེས་པའོ།",
    "དགེ་སློང་མ་ནི་བུད་མེད་ཉོན་མོངས་མང་བས་རིམ་གྱིས་དགེ་སློང་མ་བྱ་བའི་ཆེད་དུ་དགེ་ཚུལ་མའི་སྤང་བྱའི་སྟེང་དུ།",
    "སྐྱེས་པ་ལ་ནི་རེག་པ་དང་།",
    "དགེ་ཚུལ་མ་དེ་བུད་མེད་ལ་སྐྱེས་པའོ།",
    "ཆང་གི་བཏུང་བ་རྣམས་ལས་ལྡོག།",
    "ཞེས་ཏེ་གཞན་གྱི་ཆུང་མ་སུན་འབྱིན་ཅིང་ངན་སོང་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་དང་ཁྱིམ་པས་བསྡམ་སླ་བས་དང་།",
    "ངག་གི་བཞི་ལས་བརྫུན་སྤོང་བ་ཉིད་འཇོག་པའང་རྒྱུ་གསུམ་པོ་དེ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "བརྫུན་དུ་ཐལ་བར་འགྱུར་ཕྱིར་ཡང་།",
    "ཆང་འཐུང་བ་ནི་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བའི་མཚན་ཉིད་སེམས་ཉོན་མོངས་པ་ཅན་ཁོ་ནས་སྤྱོད་པ་མེད་པའི་ཕྱིར་བཅས་པའོ་ཞེས་ཏེ་བརྒལ་ལན་རྒྱས་པར་མཛོད་འགྲེལ་དུའོ།",
    "གར་སོགས་ཕྲེང་སོགས་རབ་བྱུང་གི་ཚུལ་དང་མི་མཐུན་པས་གཉིས་སུ་བཅས་ཏེ་ཁྱིམ་པའི་ཚུལ་དང་མི་མཐུན་པ་མིན་པས་གཅིག་ཏུའོ།",
    "གསེར་དངུལ་ལེན་པ་ནི་འདོད་པ་བསོད་སྙོམས་ཀྱི་མཐའ་གསོག་འཇོག་གི་གཙོ་བོ་དང་རྩ་བ་ཡིན་པས་སོ།",
    "གསུམ་ལ་སྐྱབས་སུ་སོང་བ་ཡིན།",
    "སྐྱབས་སུ་སོང་བ་མ་ཡིན་ནོ།",
    "ལོག་པར་མོས་པའི་སྒྲིབ་པ་ཀུན་ཟད་པ་འཐོབ་པ་དང་།",
    "གཉིས་པ་ནི་བསྡུ་བར་ཁྱིམ་པའི་སྡོམ་པ་རང་གིས་ཀྱང་ལེན་ཅིང་།",
    "མཚམས་མེད་བྱས་པ་རང་རྟགས་རང་གིས་བླངས་པའི་མཁན་བུས་དགྲ་བཅོམ་ཐོབ་པ་གསུངས་པས།",
    "བསྙེན་གནས་ནི་གནས་འཇོག་གིས་ཞུས་པར་དགེ་སློང་ངམ་བྲམ་ཟེ་ཤེས་པ་གཅིག་གི་གན་དུ་སོང་སྟེ་ཞེས་དང་།",
    "ཅི་སྟེ་རབ་ཏུ་བྱུང་བ་སླ་བས་འཚོ་བར་བྱ་ཞིང་ཇི་ལྟར་དགེ་སློང་འདི་རྣམས་ཚངས་སྤྱོད་སྤྱོད་པ་ལྟར་ཇི་སྲིད་འཚོ་བར་དུ་སྤྱད་པར་བྱའོ་སྙམ་པས་ལེན་ན་བསམ་པ་ནི་མ་ཉམས་མོད་གཅིག་ཏུ་དག་པའང་མིན་ནོ།",
    "ཞེས་ཏེ་རང་རང་གི་ཆོ་གས་བླངས་པས་འཐོབ་བོ།",
    "སློབ་དཔོན་རོག་སོགས་སྡོམ་པ་སྔ་མ་ཕྱི་མར་གནས་གྱུར་པའོ་ཞེས་གསུངས་སྟེ་དེ་ལ་དགེ་སློང་གིས་དགེ་ཚུལ་དུ་གཟུང་དུ་གསོལ་ཅེས་པས་དགེ་ཚུལ་དུ་འགྱུར་བ་ལྟ་བུ་ན་སྨད་དུ་མེད་པའི་ཉེས་པ་ཡོད་ཅེས་གསུང་བ་ནི་ཕྱིར་ཡང་གནས་འགྱུར་ཞེས་པས་ལན་ཐེབས་སོ།",
    "འོན་ཀྱང་འདི་ལ་རིགས་པ་མཚུངས་པས་དགེ་སློང་གིས་རྒྱལ་སྲས་ཀྱི་སྡོམ་པ་བླངས་པ་ལ་རྒྱལ་སྲས་ཀྱི་རྩ་ལྟུང་ཐུན་མོང་མིན་པ་བྱུང་བ་ན་དགེ་སློང་གི་སྡོམ་པ་གཏོང་དགོས་ཏེ་དེ་ཡང་མི་གཏོང་སྟེ།",
    "སློབ་དཔོན་དབྱིག་གཉེན་ཞབས་ན་རེ།",
    "ཉོན་མོངས་པ་བཅོམ་པའི་དང་།",
    "དེ་སྟོན་པས་དགེ་སློང་གི་ལོངས་སྤྱོད་ཀུན་ལས་བསྐར་ཏེ།",
    "ཕྲག་དོག་ཅན་ནི་གཞན་གྱིས་བུད་མེད་ལ་ལོངས་སྤྱོད་པ་མཐོང་སྟེ་ཕྲག་དོག་སྐྱེས་པས་སྐྱེས་པར་འགྱུར་བའོ།",
    "དེ་གསུམ་ནི་སྤོང་དང་ཕྱོགས་གཅིག་གི་དང་།",
    "ས་འཕོས་ཉམས་པ་དག་གིས་གཏོང་།",
    "ཡང་སྒོམ་བྱུང་གི་སྡོམ་པ་གཉིས་སྤོང་བའི་སྡོམ་པ་ཞེས་པར་ཡང་འགྱུར་ཏེ།",
    "ཕག་གིས་འཚོ་བ་སོགས་ཀྱང་དེ་དང་འདྲའོ།",
    "ཁྱོད་ནི་གང་ལ་གཏོང་སེམས་མེད།",
    "ལུས་དང་ངག་གི་ལས་ཡིན་པས་དང་།",
    "སྡོམ་མིན་ལ་མི་གནས་པའི་གང་ཟག་གི་ཡིད་དང་།",
    "ཐལ་ལྕག་རྡེག་པ་སོགས་ཐམས་ཅད་ཡིན་པར་བསྡུ་བར་གསུངས་སོ།",
    "རབ་དང་ཉོན་མོངས་ཤུགས་ལྡན་པར།",
    "དགེ་སློང་ར་གསོད་པ་སོགས་ལ་ཉོན་མོངས་ཀྱི་ཤུགས་ཡོད་ཀྱི་བར་དུ་ལྡན་ནོ།",
    "ཉོན་མོངས་པ་ཅན་གཟུགས་མིན་ནི།",
    "ཁ་ཅིག་ཟེར་ཏེ་གང་གི་ཕྱིར།",
    "དེའི་མཚན་གཞི་མཚམས་མེད་པ་ལྔ་ལ་དོན་དྲུག་གི་དང་པོ་དངོས་པོ་ནི།",
    "སྐྱེས་པ་བུད་མེད་ཁོ་ན་ལ་སྟེ།",
    "རྟ་ཅང་ཤེས་གདོང་གཡོགས་ནས་མ་ལ་རྒལ་དུ་བཅུག་པ་ཕྱིས་ཤེས་པས་རང་གི་ཕོ་མཚན་བཅད་པ་ལྟ་བུའོ་ཞེས་སྨྲའོ།",
    "མ་དང་ཕ་མཚན་གྱུར་པའི་སྐྱེས་པ་དང་བུད་མེད་བསད་ཀྱང་འགྱུར་ཞིང་།",
    "བུད་མེད་འགས་ནུར་ནུར་པོ་གཞན་གྱི་མངལ་དུ་བླུགས་ཏེ་སྨིན་ཅིང་བཙས་ན་སྔ་མ་བསད་པས་འགྱུར་བ་ཕྱི་མའང་བྱ་བ་ཞུ་བའི་གནས་སོ།",
    "གང་གི་ཟླ་མཚན་ལས་བྱུང་མ།",
    "དང་པོ་མཐའ་སྐྱོན་ཟུང་གཅིག་གི།",
    "ལས་ཀྱི་དབྱེན་ནི་བསྟན་པ་གནས་པ་ན་མཚམས་གཅིག་གི་ནང་དུ་མི་མཐུན་པས་ལས་བརྒྱ་རྩ་གཅིག་གང་རུང་བྱེད་པ་སྟེ།",
    "དེས་ན་གཅིག་ངག་གི་ལས་དང་གསུམ་སྲོག་གཅོད་དང་གཅིག་སྲོག་གཅོད་ཀྱི་སྦྱོར་བའོ།",
    "ནང་པའི་བྱིས་པ་བསྟན་པ་ལ་ཕྱི་ལོག་ཏུ་ལྟ་བ་རང་གི་ལྟ་བ་ལ་ཞེན་པ་ལོག་པར་ངེས་པའི་དང་།",
    "གཡོ་དང་ཞེ་སྡང་འདོད་ཆགས་ཅེས་པའི་ལུས་ངག་གི་ལས་སོ་ཞེས་ཀྱང་ངོ།",
    "གང་གིས་སྦྱིན་བྱེད་དེ་སྦྱིན་པ་ མཆོད་དང་ཕན་གདགས་འདོད་པ་ཡིས།",
    "འཇིགས་པ་དང་ལན་ལ་རེ་བ་དང་ཆགས་པ་སོགས་ཀྱིས་སྟེར་བ་མིན་པའོ།",
    "རང་གི་ལུས་ཀྱི་གནོད་པའི་གཞི་དང་ཕོངས་པའི་གཞི་སྟོན་པ་དག་དང་།",
    "འགྲོན་བོས་བདག་གིར་མི་བྱེད་དང་།",
    "ཕུན་ཚོགས་དེ་དག་གིས་རྒྱས་པས་ཞུས་པར་མ་དག་པའི་སྦྱིན་པ་སུམ་བཅུ་རྩ་གཉིས་བཀའ་བསྩལ་ལ་སེལ་ལོ།"
  ]
}