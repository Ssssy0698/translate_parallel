    "མ་ཡིན་ཏེ་རང་རང་གི་དབྱིབས་ཀྱིས་ཁྱད་པར་དུ་བྱས་པ་འཛིན་ནོ་ཞེས་བྲྗོད་དོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་དུ་མར་འཛིན་ཕྱིར་གཟུགས་ཀྱི་རིགས་གཅིག་ལ་ཡང་དབྱིབས་ཐ་དད་ཀྱི་སྒོ་ནས་དུ་མར་འཛིན་པར་བྱེད་པ་ཡིན་གྱི་དབྱིབས་གཅིག་གི་རྗེས་སུ་ཞུགས་ནས་འཛིན་པ་ནི་མ་མཐོང་ངོ།",
    "སྔོན་གྱི་སེར་སྐྱ་པའི་ལུགས་ལ་འདས་པར་སྨྲ་བ་གྲངས་ཅན་ཕུང་བར་བྱེད་པའི་མི་རྔུམ་པ་ན་རེ་སྒྲའི་མཚན་ཉིད་གསུམ་པ་ལས་ཐ་མི་དད་པ་མ་ཡིན་ཏེ།",
    "རེ་རེའི་ངོ་བོར་ཐམས་ཅད་ནི།",
    "བདེ་བ་དང་སྡུག་བསྔལ་དང་གཏི་མུག་དང་སྒྲ་དང་རེག་བྱ་དང་བྱ་བ་དག་གིས་ཐ་དད་ཀྱི་རིགས་ལས་ཐ་དད་པའི་གཙོ་བོ་རྡུལ་ཕྲ་རབ་ཐམས་ཅད་དུ་སོང་བ་ཡོད་དོ་ཞེས་བྲྗོད་པར་བྱའོ།",
    "གཅིག་དེའི་ངོ་བོར་གང་གིས་འགྲོ།",
    "འབྲས་བུ་གཅིག་གི་ངོ་བོར་འགྱུར།",
    "གལ་ཏེ་རྣ་བས་སྒྲ་ཉན་པ་ལ་སོགས་པའི་བློ་ནི་བདེ་བ་ལ་སོགས་པ་ལ་མི་ལྟོས་པར་གཞན་ལས་ཁྱད་པར་དུ་གྱུར་པ་འདི་ལ་འཇུག་པར་བྱེད་དེ་དེ་ཉིད་ཁོ་ནས་གཅིག་གི་རང་བཞིན་རོ།",
    "རེག་བྱ་ལ་སོགས་པ་རྣམས་ལ་ཡང་མཚུངས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་རེ་རེའི་དངོས་པོ་ལ།",
    "རིགས་ཀྱི་བྱེ་བྲག་གཅིག་གི་རང་བཞིན་ཙམ་གྱི་རྒྱུ་ལས་འབྲས་བུ་སྐྱེ་བར་བརྟགས་པ་སྟེ།",
    "དེ་ལྟ་ན་ནི་རིགས་མི་མཐུན་གྱི་འབྲས་བུ་མི་རྩོམ་མོ་ཞེས་མཛེས་པར་འགྱུར་གྱི།",
    "མ་ཡིན་མིན་ཏེ་གང་གིས་བྲྗོད།",
    "དེ་མིག་གི་བློ་དང་ཕྲད་ནས་དོན་མེད་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རྒྱུ་བ་ལས།",
    "བློའི་སྐྱེ་བ་ལས་གཞན་དུ་མ་མཐོང་བ་གང་ལས་བློ་སྐྱེ་བར་གྲུབ་པ་དེ་མངོན་སུམ་མོ་ཞེས་འདོད་དོ།",
    "དེ་ལ་བྲྗོད་པ་དེ་ལ་ཡང་ཇི་ལྟ་བ་བཞིན་དུ་བྲྗོད་པའི་བདག་ལ་སོགས་པ་དང་སྦྱོར་བ་དང་འདུ་བྱེད་པ་དང་བཅས་པ་དག་བོར་ནས་བློ་ལ་རྒྱུ་གཞན་ནི་མེད་ན་གང་གིས་མངོན་སུམ་ཉིད་ཀྱི་ཐ་སྙད་དུ་བྱས།",
    "ཚོགས་པ་དེ་དག་གིས་མངོན་སུམ་དུ་སྐྱེད་པར་བྱེད་པ་ཉིད་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར།",
    "རང་གི་སྣང་བའི་ཤེས་པ་སྐྱེས་པ་དེའི་བདག་སོ་སོར་རིག་པར་བྱེད་དེ་ཤེས་པའི་རང་གི་ཆ་ཤས་བཞིན་ནོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་གང་ལས་བློ་སྐྱེས་པ་དེ་མངོན་སུམ་ཡིན་པར་ནི་མི་རིགས་སོ།་།",
    "བློའི་སྐྱེ་བ་ཉིད་ཀྱི་ཕྱི་རོལ་གྱི་དོན་ལ་མངོན་སུམ་མོ་ཞེས་ཐོས་ཏེ།",
    "འཕྲོ་འདུ་རང་གི་རྒྱུ་ལས་ཏེ།",
    "དེ་ལྟར་ན་གཞན་དག་གིས་འདོད་པའི་མངོན་སུམ་ནི་བསྒྲུབ་པར་དཀའོ།",
    "རང་གི་དོན་དང་།",
    "འཆད་པར་འགྱུར་བའི་མཚན་ཉིད་གསུམ་པའི་རྟགས་ལས་རྗེས་སུ་དཔག་པར་བྱ་བའི་དོན་མཐོང་བ་དེ་ནི་རང་གི་དོན་རྗེས་སུ་དཔག་གོ།",
    "དེའི་རྣམ་པ་དང་བྱེ་བྲག་གི་སྒོ་ནས་སོ།",
    "རང་གི་ངོ་བོ་ཡང་ཐ་དད་པ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་བསྟན་བྱ་ཡིན།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་ནི་རང་གི་ངོ་བོ་བཞིན་དུ་གཟུང་བར་བྱ་བ་ཡང་ཐ་དད་པ་ཡིན་ནོ།",
    "དཔེར་ན་གཟུགས་ལས་རེག་བྱ་བཞིན་ནོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེ་ན།་",
    "སྔོན་མཐོང་བ་ཞུགས་པའི་རྒྱུ་ལས་རེག་བྱ་རྗེས་སུ་དཔོག་པ་སྟེ།",
    "འདི་ལྟར་གཟུགས་དེ་ཉིད་མངོན་སུམ་གྱི་རྣམ་པ་དང་བྲལ་ནས་གཟུགས་ཀྱི་སྤྱི་ལ་རེག་བྱའི་སྤྱིའི་རྗེས་སུ་དཔོག་པ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་བྲྗོད་པ་ཡིན།་།",
    "འདི་ལྟར་མིག་གི་རྣམ་པར་ཤེས་པས་མཐོང་བར་འགྱུར་བའི་དོན་ལ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་སྔོན་པོ་ཇི་ལྟ་བར་ཤེས་སོ།",
    "གང་གི་ཕྱིར་མིག་གི་རྣམ་པར་ཤེས་པས་སྔོན་པོ་མ་ཡིན་པ་ལས་ལོག་པའི་དོན་ཉམས་སུ་མྱོང་བ་ལ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཐོབ་པར་ནུས་སོ་ཞེས་ཐ་སྙད་དུ་བྱེད་པ་ལ་ཡིད་གྱི་རྣམ་པ་གཉིས་པོ་ཞེས་བྲྗོད་དོ།",
    "རང་གི་མཚན་ཉིད་བསྟན་བྱ་མིན།",
    "དེ་སྐད་དུ་ཡང་རེག་བྱ་ནི་རེག་བྱ་མཐོང་བ་རྣམས་ཀྱི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པས་བྲྗོད་དོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་རེག་བྱ་ལ་སོགས་པའི་ཡོན་ཏན་ཉིད་ཀྱི་རྟེན་ཉིད་ཀྱི་ཕྱིར་མཚོན་པའི་ཕྱིར་རམ།",
    "གང་གི་ཕྱིར་རྫས་ཉིད་ཙམ་གྱི་སྤྱི་དེ་ལ་རེག་བྱ་ལ་སོགས་པ་རྣམས་ཀྱི་རྟེན་རྫས་ཉིད་དུ་མཚོན་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་སྐད་དུ་ཡང་རེག་བྱ་ནི་མཐོང་བ་རྣམས་ཀྱི་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་བྲྗོད་དོ་ཞ་ན།",
    "ཡོན་ཏན་གྱི་བྱེ་བྲག་དང་འབྲེལ་པ་ལས་ཡོན་ཏན་གྱི་སྤྱི་བོར་ནས་ཡོན་ཏན་གྱི་བྱེ་བྲག་གིས་རྫས་ཀྱི་བྱེ་བྲག་རྗེས་སུ་དཔོག་པར་བྱེད་ལ།",
    "རེག་ན་ཡོད་པར་ནི་གྲུབ་པ་མེད་དོ།",
    "ཡིད་ཀྱི་ཡོན་ཏན་རྗེས་སུ་དཔོག་པའི་ཕྱིར་རེག་བྱ་ལྡོག་པར་གྲུབ་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་མཐོང་བ་རྣམས་ལས་མཐོང་བའི་ཕྱིར་དང་།",
    "མ་མཐོང་བ་རྣམས་ལས་མ་མཐོང་བའི་ཕྱིར་རེག་བྱ་ནི་མཐོང་བ་རྣམས་ཁོ་ནའོ།",
    "དེ་རྣམས་ནི་དུ་མ་ཡིན་པའི་ཕྱིར་འདི་གང་གི་ཡིན་ཞེས་ཐེ་ཚོམ་དུ་ནི་འགྱུར་རོ།",
    "ཡིད་ཆེས་ཚིག་གི་སྒྲུབ་བྱེད་ཀྱིས།",
