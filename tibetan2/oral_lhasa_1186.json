    "སྦྱོར་བས་ནི་མཉམ་པར་འཁྱུད་པའོ།",
    "ཨཱ་ལི་ཡེ་ཤེས་རབ་ཏུ་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "ལྟེ་བ་ལ་སོགས་གནས་ལ་ཡོད་པའི་འཁོར་ལོའི་ཆུ་སྐྱེས་རྒྱས་རྣམ་པར་རྒྱས་པས།",
    "འཁོར་ལོ་དྲུག་པར་མ་རྒྱས་པའི་ཕྱིས་ནས་རྩའི་འཛག་པ།",
    "ཞེས་དེ་ཉིད་རྡོ་རྗེ་འཛིན་པས་གཉིས་སུ་མེད་པའི་དོན་གྱི་གསུངས་སོ།",
    "དེ་ནས་སྤྲུལ་པའི་འཁོར་ལོའི་གནས་ལ་སོགས་ཞེས་བྱ་བ་ལ་རྡོ་རྗེ་སློབ་དཔོན་གྱི་ཞལ་ནས་རྒྱས་པར་བཤད།",
    "དོན་གྱིས་གཏན་ལ་ཕབ་པར་བྱེད།",
    "དེ་རུ་ཡང་ཤེས་པ་ཙམ་གྱིས་ཡིད་ཤེས་པར་མི་བྱེད་དོ།",
    "དྲང་བའི་དོན་གྱིས་གཏན་ལ་ཕབ་པར་བྱེད།",
    "བོ་ལ་ཀཀྐོ་ལ་འཇུག་པར།",
    "ཆུ་ནི་རྡོ་རྗེ་ལས་བྱུང་བའི་ས་བོན་ཆུའི་ནང་དུ་ནི་པདྨ་ལས་བྱུང་བའི་ཀུན་དུ་དམར་བའི་རང་བཞིན་དེའི་ཕྱིར་དེ་ལས་ས་བོན་ལས་བྱུང་བའི་རྒྱུ་ཞེས་ཉིད་རྡོ་རྗེ་འཛིན་པས་གསུངས་སོ།",
    "རྡོ་རྗེ་སློབ་དཔོན་གྱི་ཞལ་སྔ་ནས་ཀྱིས་གསུངས་སོ།",
    "བད་ག་མེད་ཅེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་ཀྱི་ངོ་བོར་ངེས་པར་བསྟན།",
    "སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ལ་རྣམ་པར་མི་རྟོག་པ་ཉིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རྟག་ཏུ་བདག་ཉིད་པའི་སྲོག་ཆེན་པོ་ཞེས་བྱ་བ་ལ་དོན་ནི་འདི་ལྟར་གསུངས་༢སྲིད་པ་བར་མ་དོ་ལ་རྟག་ཏུ་ཡོད་དོ།",
    "གནས་ལྔའི་བཞུགས་ཞེས་བྱ་བ་ལ།",
    "ནམ་མཁའ་ནམ་མཁར་ཐིམ་ཞེས་བྱ་བ་ལ་འདི་ལྟར་གསུངས་ཏེ།",
    "སྲོག་ལ་རྟེན་དུ་ཤེས་པར་བྱ།",
    "ལྗིན་པར་ངོ་ཚ་མེད་པ་དང་།",
    "ཡེ་ཤེས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ།",
    "བདག་མེད་མའི་རང་བཞིན་ཡིན་ཡང་ལུས་ལ་བརྟེན་ནས་འགྲོ་བ་ལ་སོགས་པའི་དོན་བྱེད་དོ་། ཇི་ལྟར་རྒྱ་མཚོ་ཆེན་པོ་ལ་རྟེན་བྱས་ནས།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་སྟེང་དང་།",
    "ཀུན་རྫོབ་དང་དོན་དམ་པའི་དངོས་༢ཞེས་བྱ་བ་བཅོམ་ལྡན་འདས་ཀྱིས་རྡོ་རྗེ་སློབ་དཔོན་གྱི་ཞལ་སྔ་ནས་སྒྲ་ཇི་བཞིན་དུ་གསུངས་ས་སོ།",
    "ཞེས་བྱ་བ་ལ་བསྐྱེད་པའི་རིམ་པའི་ཕྱོགས་སུ་ལྷའི་རྣམ་པར་བྱིན་གྱིས་བརླབས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་རྫོགས་པའི་རིམ་པའི་སྐབས་སུ་བརྡར་བྱས་ས་སོ།",
    "ཐབས་ནི་ཉི་མ་ཡིན་པར་འགྱུར་རོ་༢ཞེས་བྱ་བ་ལ་དེ་ནི་ཐབས་དོན་གསལ་བར་བྱས་ས་སོ།",
    "ཡང་ན་ཁོང་དུ་ཆུད་པར་བྱེད་དོ།",
    "སྲིད་པ་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ།",
    "གང་ཞིག་རྣམ་པར་རྟོག་པ་མེད་པ་དང་ཆ་མེད་པ་དེ་ནི་རབ་དང་མཆོག་གོ།"
  ]
}