    "འཕྲད་མི་འོས་པའི་འགལ་རྐྱེན་སྣ་ཚོགས་དང་འཕྲད་འདུག་པས།",
    "འཛུམ་དཀར་གྱི་ལེར་མཉམ་འཛོམས་བྱུང་འདུག་པའི་སྣང་ཚུལ་འདི་མཐོང་བས།",
    "དུས་རབས་དང་འཛམ་གླིང་རང་བཞིན་ལ་འཕེལ་རྒྱས་སུ་འགྲོ་བཞིན་ཡོད།",
    "ངས་མི་རིགས་ཡར་རྒྱས་ཀྱི་བཀག་རྡོ་བྱས་མ་བྱས་དེ་ལས་ཀྱང་རང་སེམས་ན་གསལ་གྱི་ལེར་ཡོད་པས།",
    "གནས་འདིར་བསམ་མི་ཕོད་པའི་ཐན་པ་སྐྱ་བོ་ཞིག་སླེབ་ཀྱིན་གདའ།",
    "ཐ་སྙད་ངུཕྱི་དོན་མེད་ཅིང་རང་རིག་བཞེད་པ་སོགས་ཀྱི་༤་ནས་རྣལ་འབྱོར་སྤྱོད་པའི་དབུར་རང་རྒྱུད་པར་གྲགས་པའི་སྲོལ་ཕྱེ་བར་མཛད་ལ།",
    "ཕུང་ཕོལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ཤེས་སོགས་གསུངས་པ་སྒྲ་ཇི་བཞིན་དུ་གཟུང་མི་ཐུབ་པས་དྲང་དོན་དུ་འཇོག་ལ།",
    "དོན་དམ་པར་དང་རང་བཞིན་གྱིས་གྲུབ་པ་སོགས་གང་ང་དགག་བྱ་སྦྱར་བ་ལ་ཁྱད་མེད་དོ།",
    "ཡུམ་གྱི་འི་རྡོ་ལས་ནི་ཕུང་པོ་ལྔ་ཆར་ཡང་རང་བཞིན་གྱིས་གྲུབ་པས་སྟོང་པར་གསུངས་ཤིང་།",
    "རང་རང་འགོགཚུལ་བསྟན་པ་དང་འདྲའོ།",
    "མ་བསྐྱར་བའི་ཤེལ་གོང་རང་དྭངས་པའི་དྭངས་ཆ་ཞེག་དང་གཉིས་ཅིག་ཅར་དུ་སྐྱེ་བ་བཞིན་ནོ་ཞེས་འདོད་དོ།",
    "རྟེན་ཏེ་འཇིག་རྟེན་ཀྱི་ཐ་སྙད་ཀྱི་དབངངུ་ཡིན་ན་ནི་དེལྟ་ན་ཡང་རང་རིག་པའི་རྒྱུཅ་ན་གྱི་དྲན་པ་མི་སྲིད་པ་ཉིད་དོ།",
    "ཡང་རྟགས་འདི་བསླབ་བཏུས་སུ་གསུངས་སོཞེས་ལན་གྱི་སྐབས་གསུངས་འདུག་ལ།",
    "དེའང་རང་རྒྱུད་པ་ལྟར་ན་དགག་བྱའི་བདག་གཉིས་ལཕྲ་རགས་ཀྱི་ཁྱད་པར་ཡོད་ལ་དེའི་ཕྱིར་བདག་འཛིན་གཉིས་ལའང་ཕྲ་རགས་ཀྱི་ཁྱད་པར་ལོདཅིང་།",
    "ལལ་གསོ་ག་དུས་ཀྱི་གང་ཟག་དེ་རྣམ་སྨིན་མྱོང་དུས་ཀྱི་ངའམ་གང་ཟག་དེ་ཡིན་ནར་མིན།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་པོད་མིན་པའི།",
    "དངོས་པོ་དུས་གཉེས་པའི་འཇིག་པ་དང་དངོས་པོ་དུས་གཉིས་པར་ཞིག་པ་རྣམས་ལ་དངོས་པོར་འཇོག་མི་འཇོག་དང་རང་རྒྱུས་བསྐྱེད་མི་བསྐྱེདལ་གོམཚུངས་བྱས་ནས་གནོད་པ་སྟོན་ཏེ།",
    "སྦྲུལཆེལ་ཅིང་འདུག་པར་མ་བྱེད་པར།",
    "དེ་ཙམ་ལའང་སྐྱོན་དེ་འདུག་ན།",
    "དེ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར།",
    "ཆེས་ཐམསཅངརྒྱ་ཀྱི་གནས་ལུགས་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་དགག་བྱ་དང་བྲལ་བའི་ཆ་ནས་ཡིན་ལ།",
    "དེའང་མེ་ཏོག་མང་དུ་བབས་པས་དཔྱལ་བཀྲམ་པ་ལྟ་བུ་འདུག་པ་དང་ལྷ་དེ་བབས་པའི་མཐུས་བྱུང་བར་རྟོགས་ནས་དཔྱལ་ཞེས་བརྗོད་དོ།",
    "རི་བོ་གངས་ཅན་བཞིན་དུ་ལྷམ་མེར་གདའ།",
    "ང་རང་ཡང་ལྷོ་བལ་དུ་ཕྱིན་ཆོག་སྙམ།",
    "དེ་ཙམ་གཤེགས་ཙ་ན།",
    "ཚ་ལམ་གཅིག་ཙམ་དུ་སླེབས་ཙ་ན་པོ་ཏི་ལུས་པ་དྲན་སོས།",
    "བོད་ཀྱི་དཔེས་ཕན་མི་ཐོགས་སྙམ་ཙ་ན།",
    "ལེན་དུ་བྱོན་པས་རྔོན་པས་རི་དྭགས་བཤོར་བའི་ཕྱིར་ནགས་ལ་མེ་བཅུག་ནས་འདུག་པས།",
    "པོ་ཏི་ཡང་ཚིག་ཡོད་སྙམ་ཙ་ན།",
    "མཐོང་ནས་གམ་དུ་གཏུགས་ཙ་ན།",
    "གླང་རྒན་དར་གྱིས་གཡོགས་གདའོ།",
    "བདེ་མཆོག་དུས་འཁོར་ལ་སོགས་པའི་རྒྱུད་འགྲེལ་མང་པོ་གསན་ཞིང་།",
    "དེ་ནས་གདུལ་བྱ་མ་གཏོགས་སྐུ་སྐྱེ་བ་མི་ལེན་གསུངས་པར་གདའ།",
    "འདི་ལ་ངེད་རང་དཔྱལ་པའི་མི་སྤྱད་རྣམས་ཀྱང་ཚང་འདུག་ཅིང་།",
    "དྲུང་གདན་ས་པའི་སྲས་ཡིན་ངེས་སུ་འདུག་པས།",
    "ནམ་མཁའ་སྤྲིན་མེད་དུ་དག་པ་ལ་འཇའ་འོད་ཀྱི་བཀོད་པ་འདོད་ཁམས་ཀྱི་ལྷའི་མཆོད་རྫས་ཀྱི་བཀོད་པ་བས་ཀྱང་ཁྱད་པར་འཕགས་པ་ལྟ་བུ་མེ་ཏོག་འདབ་མ་གསུམ་པ་དང་ལྔ་པ་དང་བརྒྱད་པ་ལ་སོགས་ནི་ཁ་དོག་ཕལ་ཆེར་དཀར་པོ་དང་སྣ་ཚོགས་དང་དམར་སེར་ལྗང་ཁུར་འདུག་པ་དབྱིབས་ཚད་ཕུབ་ཙམ་དང་ཁུ་འཕངས་ཙམ་གྱི་ནམ་མཁའ་གང་བ་ནི་མི་ཀུན་གྱི་མཐུན་སྣང་དུ་གྲུབ་པ་བྱུང་ངོ།",
    "འཇིག་རྟེན་ན་ལྷས་སྦྱིན་བདེ་བར་ཉལ་ལོ་འདུག་གོ་འགྲོའོ་ཞེས་པའི་ཐ་སྙད་ཡོད་པ་དེའི་ཕྱིར་བདེ་བ་ཡང་ཡོད་པ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་པ་ཆུང་ངུ་རྩོམ་པའང་བདེ་བ་ཅི་ཞིག་ཡོད་ལ་སྡུག་བསྔལ་འགག་ནའང་བདེ་བ་ཅི་ཡོད་དེ་སྡུག་བསྔལ་ཙམ་ཞིག་ཁོ་ན་སྐྱེ་ཞིང་འགག་པའི་ཕྱིར་གནས་སྐབས་གཉིས་ཀར་ཡང་རང་བཞིན་གྱིས་བདེ་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གཞན་ཡང་རང་རང་འཚོ་བའི་ཐབས་སོ་ཅོག་ཐམསཅད་ལ་ཡང་།",
    "རང་དང་མཉམ་པ་དང་རང་ལས་ཁྱདཔར་དུ་འཕགས་པ་ཡི།",
    "དོན་འགའ་ལའང་རང་བཞིན་མ་གྲུབ་པས་དོན་གང་དང་ལྷན་ཅིག་ཏུ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་གང་ཞིག་དུས་ཐམས་ཅད་ཡོད་པ་ཉིད་དུ་སྨྲ་བའི་ཕྱིར་དེ་ལ་སླར་ཡང་བརྒལ་ཞིང་བརྟག་པ།",
    "དངོས་པོ་འགའ་ཡང་རང་བཞིན་བརྟག་པར་མི་ནུས་ཏེ་རྣམ་པ་དེ་ལྟ་བུའི་དངོས་པོ་རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "དེ་ནི་གསུམ་ཆར་ལའང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ།",
    "མ་ཡིན་པས་དེས་ན་གཏན་ཚིགས་དེ་ཡང་རང་བཞིན་མེད་པ་ཡིན་ནོ།",
    "དཔེར་ན་ཉི་མ་ནི་སྒྲ་གཅན་ཞེས་པའི་གཟའ་དང་བྲལ་ནས་ལྷང་ངེར་འདུག་པ་དང་།",
    "རང་རང་བསྐྱེད་པའི་ཡུམ་དུ་གྱུར་པ་ཤེས་རབ་དམ་པ་འདི་ལ་ཐུགས་ཀྱིས་དགོངས་པ་ཉིད་དུ་མཛད་པ་ཡིན་ནོ།",
    "དགུ་བཅོམ་པའི་དེ་བཞིན་ཉིད་དང་རང་རྒྱལ་གྱི་དེ་བཞིན་ཉིད་དང་།",
    "སུ་ལ་བསྟན་ཀྱང་གོ་བར་མི་འདུག་པས།",
    "དེ་ཡང་རང་བཞིན་མེད་པར་རབ་ཏུ་ཤེས་པའི་སྒོ་ནས་ཚུལ་དེ་ལ་ཡོངས་སུ་སྐྱོ་བའི་ཡིད་ནི་རྡུལ་ཙམ་སྐྱེད་པར་མི་བྱེད་དོ།",
    "དཔེར་ན་དགེ་སློང་རྫུ་འཕྲུལ་གྱི་སྟོབས་མཆོག་དང་ལྡན་པ་ཞིག་ནམ་མཁར་གནས་ཏེ་དུས་ཅིག་ཆར་ཆོ་འཕྲུལ་སྣ་ཚོགས་རྣམ་པར་འཕྲུལ་པ་འགྲོ་བ་དང་འཆག་པ་དང་ནི་ཉལ་བ་དང་འདུག་པ་སྣ་ཚོགས་སུ་སྟོན་ཀྱང་དེ་ལ་ནི་བྱ་བ་སྣ་ཚོགས་པ་དེས་མསེམས་སྐྱོ་བ་མེད་ཅིང་དེ་ཡི་ཡོན་ཏན་རིན་ཆེན་སྡུད་པའི་འགྲེལ་པ་རྒྱལ་བའི་ཡུམ་གྱི་དགོངས་དོན་ལ་ཕྱིན་ཅི་མ་ལོག་པར་འཇུག་པའི་ལེགས་བཤད།",
    "བསླབ་ཀྱང་རང་དོན་དུ་ཆགས་པ་མེད་པ།",
    "ཉན་ཐོས་དགུ་བཅོམ་དང་རང་རྒྱལ་ཉིད་ཀྱི་ས་ལ་འདོད་པ་སྐྱེད་ན།",
    "སྣང་ཡང་རང་བཞིན་མེད་པར་ཤེས་བྱེད་ཀྱི་དཔེ་ནི།",
    "དེ་ཡང་མཁྱེན་པ་གསུམ་པོས་ཀྱང་རང་ཡུལ་དེ་དག་ཐམས་ཅད་སྐྱེ་མེད་མཉམ་པར་ཤེས་པ་ལ་འདྲ་ཞིང་ཁྱད་མེད་ཀྱང་།",
    "ཡང་གཞན་དོན་དུ་ཐེག་གསུམ་གྱིས་ངེས་པར་འབྱུང་ཡང་རང་དོན་དུ་དེའི་འབྲས་བུ་མངོན་སུམ་མི་བྱེད་པ་དང་བདུན་ཡིན་ལ།",
    "བཟོད་ཆུང་རང་བདེན་བཞི་ཤེས་སྤང་མངོན་བྱེད་བརྟེན་པ་ལ་གནས་ནས་གཞན་དེ་ལ་འགོད་བསྔགས་མཐུན་པར་བྱེད་པ་དང་།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་དྲན་པ་དང་ཤེས་བཞིན་རབ་ཏུ་ལྡན་པ་སྟེ་ཇི་ལྟར་ན་གཉའ་ཤིང་གང་ཙམ་ལྟ་བ་སོགས་ཀྱིས་མཚོན་པའོ་༩།",
    "བསླབ་ཀྱང་རང་དོན་དུ་ཆགས་པ་མེད་པ་དང་།",
    "སྐད་ཅིག་ཙམ་ཡང་རང་དོན་ཡིད་བྱེད་བློ།",
    "དེ་དང་དེར་འགྲོ་བའམ་འཆག་པའམ་འདུག་པའམ་ཉལ་བ་ན་ཡང་རུང་སྟེ།",
    "རབ་ཏུ་འདོན་བ་དང་སྟོན་པ་དང་ཉེ་བར་སྟོན་བ་དང་ལུང་འབོགས་པ་དང་ཁ་ཏོན་བྱེད་པས་གཡུལ་འགྱེད་བའི་ཚེ་གཡུལ་དུ་ཐོག་མར་ཞུགས་པར་གྱུར་ན་དེ་གཡུལ་དུ་འཇུག་གམ་གཡུལ་དུ་ཞུགས་སམ་གཡུལ་ལས་འདས་སམ་གཡུལ་གྱི་ནང་དུ་འགྲོའམ་འགྲེང་ངམ་འདུག་ཀྱང་རུང་སྟེ།",
    "བརྩོན་པས་དེ་ལ་འཛིན་དུ་འདུག་པ་དང་ཡང་དག་པར་སྟོན་པ་དང་ཡང་དག་པར་འགོད་པ་དང་ཡང་དག་པར་གཟེངས་སྟོད་པ་དང་ཡང་དག་པར་རབ་ཏུ་དགའ་བར་བྱེད་པ་དང་།",
    "དེ་ནི་འདི་ལྟར་སྡོང་པོ་ལས་མཚན་མ་འདི་ལྟ་བུ་དག་སྔར་གདའ་བའི་སླད་དུའོ།",
    "དེར་འགྲོའམ་འདུག་པ་དང་།",
    "དེ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷའི་ནང་ན་འདུག་པ་ལས་འཛམ་བུའི་གླིང་འདིར་འགྲོའོ་སྙམ་དུ་སེམས་ཤིང་ཤཱ་རིའི་བུ་འདབ་ཆགས་བྱ་དེ་འདབ་མ་མ་སྐྱེས་པའམ་འདབ་མ་བྱི་བར་གྱུར་པའམ་འདབ་མ་བཅད་པར་གྱུར་ལ།",
    "རབ་འབྱོར་འདི་ལྟ་སྟེ་དཔེར་ན་འདབ་ཆགས་བྱ་ནི་ནམ་མཁའ་བར་སྣང་ལ་རྒྱུ་ཡང་ས་ལ་མི་ལྟུང་ཞིང་གནས་ཅི་ལ་ཡང་མི་རྟེན་པར་འདུག་སྟེ་ནམ་མཁའ་བར་སྣང་ཉིད་ལ་གནས་ཀྱང་དེ་ལ་ཡང་མི་རྟེན་མི་གནས་སོ།",
    "གཞན་དག་ལ་ནི་དབེན་པར་གནས་པ་མེད་དོ་སྙམ་ན་ཀུན་དགའ་བོ་དེའི་ཚེ་བདུད་སྡིག་ཅན་དགའ་མགུ་ཡི་རངས་པར་འགྱུར་ཞིང་རབ་ཏུ་དགའ་བ་དང་རངས་པར་དང་ཡིད་བདེ་བསྐེད་སྟེ།",
    "ཉིད་དུ་ངུ་ཞིང་ཆོ་ངེས་འདིབས་ཏེ་དེ་མྱ་ངན་བྱེད་ལ་སྨྲེ་ཤིང་འདུག་སྟེ།",
    "དེ་དགའ་བ་དང་རངས་པ་དེ་དང་ལྡན་པས་ཏ་ལ་བདུན་ཙམ་དུ་ནམ་མཁའ་ལ་འཕགས་ནས་ཏ་ལ་བདུན་ཙམ་ན་འདུག་སྟེ།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "ཡང་ན་རང་རང་སྒོས་བཤལ་ལྟག་པ་སྤྱད།",
    "སྦྱོར་བ་གཞན་ལ་གཏོང་དང་རང་གར་གཏོང་།",
    "མཁྲིས་ཤས་འདུག་ན་བ་ཡི་འོ་མ་མར།",
    "ལྕེ་སྙིལ་མཆུ་དཀར་འགྲོ་འདུག་གསུས་པ་ལྡོག།",
    "འོག་ཏུ་རང་རང་སྐབས་སུ་འཆད་ལ་སྤྲོ།",
    "རླན་སྟེང་ཁ་ཡེང་མ་ཡིན་དབེན་པར་འདུག།",
    "རང་རང་གང་ཡིན་རིགས་མདའ་སྦྱར་བས་རྟོགས།",
    "བསིལ་གཏར་གཉེན་པོས་ཚད་གཉའ་ཆོག་དུས་སུ།",
    "རིམས་རྒྱས་འཁྲུགས་རྒྱས་རང་རང་ལེའུ་གསལ།",
    "ལུས་ངག་ཡིད་གསུམ་ལྷོད་ལ་ལྷག་པར་འདུག།",
    "འགྲོ་འདུག་ལང་ཉལ་ལུས་ངག་རྩོལ་བ་སྤང་།",
    "སྤྱོད་ལམ་བསིལ་གནས་དལ་འདུག་གཉིད་འཐིབ་སྤང་།",
    "སྤྱོད་ལམ་བསིལ་སར་ཉིན་གཉིད་སྤང་ལ་འདུག།",
    "དེ་རྗེས་རང་རང་རྩ་འམ་གང་རྒྱས་གཏར།",
    "དཀར་པོ་འབྱར་བག་ཅན་ལུ་གཉིད་ལོག་དུས།",
    "སྤྱོད་ལམ་མེ་ཉི་མ་ཕོག་དྲོ་གནས་འདུག།",
    "རང་རང་ཁ་བསྒྱུར་བསྣན་པ་མཆོག་ཏུ་བསྔགས།",
    "རིག་པས་དཔྱད་ལ་རང་རང་གཉེན་པོ་སྤྲད།",
    "ཉལ་འདུག་མི་ཤེས་ལུས་རྡུལ་མཆིན་རྩ་འབུར།",
    "ཀུན་ཀྱང་དྲི་ང་རང་གཞན་གཉིས་ཀས་ཚོར།",
    "ཆུ་བཙག་ས་བོན་འཛག་དུས་ཆུ་ཁ་ཚ།",
    "རང་རང་ཡུལ་གྱི་འདྲེ་གདོན་དགོས་པ་དང་།",
    "སྨྲ་བ་བཅད་ལ་དལ་འདུག་བདེ་བ་སྟེར།",
    "ཕྲན་ཚེགས་འགྲངས་ངོམས་འདུག་རྗེས་དྲག་ཤུལ་འབྱུང་།",
    "རང་རང་ལེའུར་གྲོལ་བས་འདིར་མ་སྤྲོས།",
    "རྣམ་ལྔར་གསུངས་ཀྱང་རང་རང་ལེའུར་ཤེས།",
    "ཉིན་པར་གཉིད་ལོག་སྐྱིད་པར་འདུག་པ་དང་།",
    "རང་རང་གཉེན་པོ་གཙོར་སྐྱེད་བཅོས་དགོས་པ།",
    "མུ་གུལ་ག་དུས་གྲང་བོང་ཁྲག་ཕྱེ་མ་དབུལ།",
    "རང་རང་སྐབས་ཐོག་བརྩིས་པའི་རིག་པས་དཔྱད།",
    "ཁྱེད་རང་ལྷོག་འགོང་ཁོག་རུལ་ཡིན།",
    "ཕོ་ལོང་སྦོ་འཁྲོག་རང་རང་སྟེང་དུ་སྐྲངས།",
    "སྤྱོད་ལམ་དལ་འདུག་ཆུ་བརྒལ་རླན་སྟེང་འདུག།",
    "བཞི་སྟེ་རྒྱུ་རྐྱེན་སྟན་སྲབ་ཙོག་པུར་འདུག།",
    "རང་རང་གཉེན་པོ་བསྣན་ལ་ཆུ་སྐོལ་དབུལ།",
    "ཞུགས་དང་འབྱར་དང་གསེབ་ཏུ་འདུག་པ་དང་།",
    "གཞན་ཡང་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "ཉལ་དང་ཙོག་འདུག་གཏམ་མི་སྨྲ་ལ་བསྡད།",
    "ཡར་ངོའི་ཚེས་པ་གཅིག་དུས་རང་ཉིད་ནི།",
    "དྲི་མེད་མཚོ་གླིང་པདྨའི་སྦུབས་ལྷུང་རང་བྱུང་མཚན་དཔེས་སྤྲས།",
    "དེ་འོག་ནས་བདག་ཅག་སྐྱེས་འདུག་ལགས་ཤིང་།",
    "སྐྱེས་ནས་མིང་རྡོ་རྗེ་ཕུན་ཚོགས་ཟེར་བ་བཏགས་ཡོད་འདུག་ཅིང་།",
    "དེང་སང་རྒན་པོ་རྣམས་ཀྱིས་ཀྱང་འདི་ཁོ་ཆུང་དུས་ཀྱི་ཁྲི་ཡིན་ཟེར་སྐད་འདུག།",
    "ངན་སྤྱོད་སྣ་ཚོགས་པའི་སྤྱོད་པའང་མང་པོ་བྱེད་པ་ཞིག་ཡོད་འདུག་ལགས་ཤིང་།",
    "འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "དཀར་ཤཱཀྱ་གྲགས་སོགས་ཀྱིས་བསྒྲིགས་པ་ཅུང་ཟད་མི་འདྲ་ཙམ་དུ་མ་འདུག་ཀྱང་།",
    "ས་དེ་མ་ཡིན་པའི་དགོན་གཤམ་ཀྱི་གཡུལ་ཁ་ན་སྒར་དེ་འདུག།",
    "སྐྲ་སིལ་བུ་ལྟག་པར་ལྕང་ལོ་བྱས་ཤིང་མུ་ཏིག་མང་པོས་མགོ་ལུས་ཐམས་ཅད་བརྒྱན་པ་ཞིག་འདུག།",
    "མདའ་དར་ཆེ་བ་ཞིག་ཀྱང་འདུག།",
    "སླར་ཡང་རང་ལོ་བཅུ་དགུའི་དུས་སུ་ལེགས་སྦྱར་སཾ་སྐྲྀ་ཏའི་སྐད་དུ་བི་ཀཱ་རི།",
    "སྟོད་སྨད་ཀུན་གྱི་སྦྱིན་བདག་རྣམས་ནས་བྱུང་བའི་དཀོར་ཆེན་འདི་བཟའ་སྐལ་གྱིས་ཐོས་བསམ་ལ་སྦྱངས་སྟོབས་ཀྱི་སྤྲོས་པ་དང་བྲལ་བ་འདི་ཡོང་རྒྱུ་ཡིན་ཚོད་འདུག།",
    "ད་དུང་དེ་ལྷག་ཅིག་འདུག་བསམས་ཀྱང་བཟླས་པའི་སྐབས་སུ་གཞན་རྟགས་ནི་བཟང་ངན་གང་ཡང་མ་བྱུང་རུང་།",
    "མཆུ་ཤིན་ཏུ་ཆེ་བས་སྔགས་འདྲེན་མི་ཐུབ་པ་ཞིག་འདུག་པས།",
    "ཉེ་རིགས་རྣམས་ཀྱིས་ཀྱང་རང་རང་སེམས་ཐོན་གྱི་གྲོ་གསོས་བསྐུར་བྱུང་བར་རིམ་གྱིས་དེ་ཉིན་གཞིས་རྩེ་དགྲ་འདུལ་སྒང་དུ་ཁམས་པ་བསྟན་པ་དར་རྒྱས་དང་ཀླུ་འཕེལ་གྱི་ཁྱིམ་དུ་བསྡད།",
    "བྱམས་པའི་ལྷ་ཁང་ཞིག་འདུག་པ་མཇལ།",
    "མི་ཉག་ནས་བོན་པོ་རབ་འབྱམས་བཟང་བ་ཞིག་འདུག་པར་གནས་གཡར་བྱས།",
    "དགོན་དེ་ན་ཚོགས་པ་ཐམས་ཅད་ཆུ་ལེན་ཕེབས་པར་དབུ་ཞྭ་ཕྲག་པར་བཀལ་ནས་ཕེབས་འགྲོ་འདུག་པས་ཅི་ལགས་ཞུས་པས།",
    "བླ་བྲང་དེས་ཞབས་ཏོག་གཟབས་ཤིང་ཐམས་ཅད་ཀྱིས་ཡར་ལམ་ཤོག་ཅེས་ནན་གྱིས་གསུང་འདུག།",
    "མང་ཇ་ཞིག་བསྐོལ་ཏེ་གནས་མཇལ་ཞིབ་པར་བྱས་པས་རྡོ་ལ་རང་བྱོན་མང་པོ་འདུག།",
    "ཕྱིའི་ཁྱམས་ཀྱི་པེ་ཧར་དང་ཙིའུ་དམར་གྱི་རྟེན་གཞན་ཡང་འཇིག་རྟེན་དྲེགས་པ་ཁ་ཤས་ཀྱིས་བསྐོར་བ་འདུག་པར་ཕྲིན་ལས་དྲག་ཏུ་བཅོལ།",
    "དེར་འདུག་པའི་ཚེ་རྩུབ་འགྱུར་ནི་ཅི་ཡང་མ་བྱུང་།",
    "དེ་སྐབས་ཇོང་གར་གྱིས་ཉམས་ཆག་བྱུང་བར་གྲྭ་ཚང་རྣམས་ཀྱིས་གཙུག་ལག་ཁང་སོགས་ཉམས་གསོའི་འགོ་ཚུགས་སྐབས་སུ་འདུག་ཅིང་།",
    "དེའི་ཕུ་ན་མཆོད་རྟེན་བཀྲ་ཤིས་འོད་འབར་བྱ་བ་ཞིག་འདུག་པ་ནི་མཇལ་མ་ཐུབ།",
    "དེ་ནུབ་དེར་བསྡད་པས་དེ་མཚམས་ནས་རྩམ་པའང་ཟད་ཡོད་པར་ཡུལ་དེར་ཡང་ཡང་དྲིས་རུང་བལ་ཊཾ་གཅིག་ལའང་འཚོང་མཁན་མི་འདུག།",
    "ངེད་རང་རང་དོན་དུ་འོང་བར་དཀའ་རུང་འོས་ཅི་ཡོད།",
    "དེང་སང་གནམ་རྒྱན་མ་གཏོགས་མི་འདུག།",
    "ངེད་རང་རྣམས་ཀྱི་རྒྱབ་ནས་གཞན་ནི་སུ་ཡང་འོང་མི་འདུག་པས་ངེད་རང་གསུམ་ཡང་དགོད་ཤོར་བ་ཞིག་བྱུང་བས།",
    "གཙུག་ལག་ཁང་དེའི་བཀོད་པ་དང་སྒོ་བཏོད་ལུགས་ཇི་ལྟ་བ་བཞིན་དུ་ལྷ་ས་ཡང་དེ་ལས་དཔེ་བླངས་འདུག།",
    "དེའི་ཕྱི་ནས་ཀྱང་ས་འབུམ་ཆེ་བ་ཞིག་འདུག་པ་དང་།",
    "སློབ་དཔོན་གྱི་སྒྲུབ་ཕུང་ཞིག་འདུག་པ་ལ་སྟག་ཆེན་འབུམ་པ་ཟེར་འདུག།",
    "དེ་ནའང་ཁྱི་རྒོད་པོ་མང་པོ་འདུག་པ་ལེགས་པར་བཀག།",
    "དེར་འདུག་པའི་སྐབས་དེར་རྡོ་རྗེ་བྲག་པའི་འབུམ་ཞིག་འཁྱར་བ་ཕྱག་ཏུ་འབྱོར་འདུག་པ་ཚར་གཅིག་སྒྲོག་དགོས་ཀྱི་བཀའ་ཕེབས་པར་ཚར་གཅིག་བསྒྲགས།",
    "དེ་ཕྱིན་ངོར་གསར་ཞུ་སྲོལ་འདུག།",
    "དེ་སྐབས་སྦྱིན་བདག་རྣམས་ལ་མགྲོན་ཆང་ཞིག་མཛད་སྲོལ་འདུག་པར་ངེད་དཔོན་གཡོག་རྣམས་ལའང་ཞབས་ཏོག་དང་ནང་མཆོད་ཀ་པཱ་ལའི་ནང་དུ་རྒྱས་པར་བསྩལ་ཞིང་།",
    "སྤེ་རོང་དུ་མ་རྒན་གྱིས་བོས་ཏེ་དགའ་སྟོན་བཟང་ཞིང་སྐྱིད་པར་གདའ།",
    "ཨ་ཇོ་རྡོ་རྗེ་སྲི་ཐར།",
    "གལ་ཏེ་ང་ངེས་མེད་མ་འཚམས་པར་གྱུར་ཚེ་སྐུ་འདའ་ཁར་ཁྱེད་རྣམས་ཀྱིས་ཚབ་ཚུབ་མ་བྱེད་པར་རང་བབས་སུ་ཇི་ལྟར་འདུག་ཀྱང་ཞོག།",
    "ཉེ་ན་ཞག་ལྔ་རིང་ན་ཞག་བདུན་དུ་ཐུགས་དམ་འདུག་པའང་སྲིད།",
    "ཅུང་ཟད་གཡས་ཕྱོགས་སུ་འགྱིངས་ནས་སྤྱན་གཉིས་ཟིམ་བུར་མཛད་ཅིང་སྐུའི་མདངས་ནི་དུས་རྒྱུན་ལས་མི་ཞན་པར་འདུག་པ།",
    "ནམ་མཁའ་བྱིང་ཆགས་པ་སོགས་འདུག་པ་ནི་ཀུན་གྱིས་མཐོང་བ་བྱུང་ངོ།",
    "སྒར་ཆེན་པོ་ཞིག་ན་ངེད་རང་ཁྲི་ཐོག་ཞིག་ལ་སླེབས་འདུག།",
    "དབུས་ན་གཙུག་ལག་ཁང་དམར་པོ་སྒོ་ལྷོ་ལ་བསྟན་ཅིང་སྣུམ་བག་ཅན་ཞིག་དང་བཅས་པའི་དགོན་ཆེ་བ་གཅིག་འདུག།",
    "རིམ་གྱིས་བསྐོར་ནས་འོང་བས་སྒོར་སླེབས་དུས་གཉིད་སད་འདུག་པས།",
    "གཙུག་ལག་ཁང་རྨིས་པའི་ས་ཆ་དེ་ནི་སྔོན་ཚེ་ཐར་མང་པོ་ཡོད་པའི་ར་བ་ཆེན་པོ་ཞིག་འདུག།",
    "དགེ་སློང་བགྲེས་པོ་དེ་དཔལ་གུར་གྱི་མགོན་པོའི་རྣམ་འཕྲུལ་རང་དུ་ལྟ་བ་འདུག་ཅིང་།",
    "འབོལ་གདན་སུམ་བརྩེགས་ཀྱི་སྟེང་ན་ཞབས་དྲུང་རིན་ཆེན་མི་འགྱུར་རྒྱལ་མཚན་འདི་བཞུགས་འདུག།",
    "རང་ཉིད་ནི་དབེན་པ་རི་ཁྲོད་ཞིག་བསམས་ཀྱང་ལག་ཏུ་ལོངས་པ་ནི་མི་འོང་འདུག།",
    "རིམ་གྱིས་ཡངས་པ་ཅན་དུ་འབྱོར་གདན་ས་དེ་ཉིད་རྒྱལ་བ་ཞྭ་དམར་བའི་གནས་འགྲན་བྲལ་ཞིག་འདུག་པཪ་རྟེན་མཇལ་ཞིབ་པར་བྱས།",
    "དཔོན་སློབ་དང་ཀུན་དགའ་རྒྱལ་མཚན་གཉིས་ལ་ལོ་གསུམ་ནས་ཡར་སླེབས་ན་མ་དང་ཐུག་པ་འདུག་ཟེར་བ་བྱས།",
    "སྟེང་ན་གདུགས་སེར་པོ་ཞིག་བསྐོར་གྱིན་འོང་བར་དེའི་སྔོན་ནས་རྨིས་ངེས་འདུག་པས།",
    "རང་ཉིད་ལ་མཐོང་གྲོལ་གྱི་ཁྲོམས་ཚོགས་འབུལ་བ་འོང་བ་ལ་དེ་སྐབས་ཀྱི་འབུལ་བ་རྒྱ་ཆེ་བའི་དཔེ་ཞིག་བྱེད་ཀྱིན་འདུག།",
    "ལྷག་པར་ས་དེར་རྩྭ་མི་སྐྱེ་བ་ལོ་གཉིས་ཙམ་བྱུང་འདུག་རུང་།",
    "རྟ་དྲེའུ་རྣམས་ནི་མ་ཎི་འདོན་པ་བདེན་ན་དུང་ཕྱུར་ཞིག་འགྲོ་སྙམ་པ་འདུག།",
    "སྔར་ནས་ཨ་གྲོང་རོང་པ་ཟེར་བའི་ཡོན་བདག་ཧ་ཅང་ཕྱུག་པོ་མེད་ཀྱང་དྲིན་ཆེན་དུ་འདུག།",
    "དེའི་ཉེ་ལོག་ན་མཚོ་ཆེན་པོ་ཡོད་པ་ཞིག་འདུག།",
    "ཁང་པ་མང་པོའི་སྒོ་ཡང་ཕྱེས་ཏེ་བསྟན་བྱུང་བར་གཞན་འགངས་ཆེ་བ་ནི་མི་འདུག།",
    "ཁྱི་ལོར་ཇ་ཉུང་ཤས་འདུག་པ་ཀླུ་ལྡིང་དུ་འབུལ་སྐྱེལ་བཏང་།",
    "ཕྱི་ཉིན་ཟིལ་ལ་བརྒལ་ཏེ་འོང་བས་ལ་ཚུར་ནང་དུ་སླེབས་པའི་ལམ་དེར་འབྲོག་པ་དུད་ཀ་ལྔ་འདུག་པར།",
    "ཞལ་བཞི་པའི་རྗེས་གནང་ཞིག་ཀྱང་བྱས་པས་དེའི་སྔ་ཉིན་ཁོང་རང་ལ་ཡང་རྨི་ལམ་བཟང་ངེས་པ་ཞིག་བྱུང་གསུང་ཞིང་།",
    "ངེད་ལ་ཡང་དད་པ་ཆེ་ཆེ་འདྲ་མཛད་འདུག།",
    "ངེད་ཀྱི་རྟ་དྲེའུ་བཞི་དུས་གཅིག་ཏུ་སྤྱང་ཀིས་བསད་འདུག་པར།",
    "སོ་སོས་འབུལ་བ་བཟབས་པར་གདའ།",
    "འདི་ལོའི་སྟོན་ཁར་ཡར་སླེབས་དགོས་ཟེར་འདུག།",
    "སྒ་བབ་ཤུ་གུ་ལ་རྩར་འདུག་པའི་རྗེས་ཟིན་ཏེ་རིམ་གྱིས་བཏེགས་ནས་འུ་ཡུག་འབེས་པོ་ན་ཁར་སླེབས།",
    "དེ་ཉིན་ཟླ་བ་བརྒྱད་པའི་ཉེར་ལྔ་ཡིན་འདུག་པ་དང་།",
    "འདི་ཁུངས་ཐུབ་ཨེ་འདུག་ཁྱེད་རང་ས་སྐྱ་པའི་ལུགས་ཡིན་ཟེར།",
    "ནུབ་གཅིག་རྨི་ལམ་དུ་ཁམས་དགེ་རྒྱས་སུ་སླེབས་འདུག་པར།",
    "འོ་མ་བཟང་པོ་ཟོ་ལག་གང་དྲངས་ནས་དགའ་དགའ་བྱེད་འདུག།",
    "ཨམ་གཙིགས་བསྡམས་པ་འདུག་པས་མི་འགྲོ་བསམ་པ་ཤར་ཚེ།",
    "དཔོན་སློབ་ཀྱིས་ཨ་ཙི་ཁམས་ལ་ཕེབས་པ་མི་དགའ་ཟེར་འདུག།",
    "ཞེས་ཕེབས་འདུག་པར་དེ་ཉིན་ཞབས་ཕྱི་འགྲུབ་མི་འགྲུབ་ཀྱི་བཀའ་ལན་ཡང་ཅི་ལ་ཞུ།",
    "དེ་མཚམས་ཆུ་གླང་ཟླ་བ་བརྒྱད་པའི་ཚེས་བརྒྱད་ལ་གཟའ་སྐཪ་བཟང་པོ་འདུག་པས་བླ་བྲང་དུ་འོང་རྩིས་བགྱིས་པར།",
    "དེ་འཕྲལ་དེ་ཉིན་ནས་གཞུང་སའི་སྐུ་ཚབ་པས་ནི་རྩིས་སྤྲོད་སྐབས་ཐུགས་འགན་བཞེས་པའི་ཕྱག་སྲོལ་མི་འདུག་ལ།",
    "ལར་རྩིས་སྤྲོད་འདི་ལ་སྔར་ནས་ཕྱག་སྲོལ་མང་པོ་ཞིག་བྱུང་འདུག་ཀྱང་།",
    "གང་ལྟར་ཡང་རང་གཞན་ཀུན་གྱི་བསམ་པ་རྫོགས་པ་ནི་མ་བྱུང་ཞིང་།",
    "གཞིས་འདུག་དང་འགྲོ་མི་ཐམས་ཅད་ཀྱི་ནང་ནས་ཕེབས་པ་མི་ལེགས་ཟེར་རུང་།",
    "དེ་གར་ཡར་ལུང་གནས་གསར་ལྷ་དཔོན་མཆོག་ཕེབས་འདུག་པ་དང་མཇལ།",
    "དེ་སྐོར་གདན་ས་ནས་ཀྱང་མང་བསྐོལ་སོགས་འབབ་ལུགས་སྔར་རྒྱུན་བླ་བྲང་ཪང་དུ་ཡིན་རུང་སྣ་ཚོགས་ཞིག་མཛད་འདུག་པར།",
    "ལྷག་པར་མར་མེ་དཀར་གསལ་བརྒྱ་ཕྲག་སྤར་འདུག་པས་དེ་མཇལ་མ་ཐག་པར་གསོལ་བ་བཏབ།",
    "ད་དུང་སྐྱེ་བ་ལྔ་བརྒྱ་ལེན་དགོས་ཟེར་འདུག་ཅིང་།",
    "ད་ལྟའི་ཨེ་ཝཾ་གྱི་གཟིམས་ཆུང་རང་ན་བཀྲམ་ཡོད་ཅིང་།",
    "ཞལ་གྱི་གོར་རྒྱན་གྱི་མཐའ་ནས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་མཐའི་འོད་ལྟར་མང་པོས་བསྐོར་བས་ཡ་མཚན་པར་འདུག།",
    "ལས་མགོན་དང་སྤྱི་གཏོར་གཉིས་ལ་ནི་དེ་འདྲ་མེད་འདུག་ཅིང་།",
    "རྗེས་ནས་གུར་ཞལ་གྱི་བསྐང་གཏོར་གཉིས་ལའང་དེ་འདྲ་མང་པོ་འདུག་པས་རྗེས་སུའང་བཟང་པོ་མ་གཏོགས་ངན་རྟགས་ནི་ཅི་ཡང་མ་བྱུང་།",
    "སྙན་དར་བསལ་ཏེ་སྒོ་ཕྱེ་བའི་ནང་ན་དཀར་མེ་ཆུང་ངུ་གསལ་ལ་དྭངས་པ་ཞིག་འདུག་པ་འདི་སྤར་ནས་ལོ་མང་།",
    "འདི་ལྟ་བུའི་འོ་བརྒྱལ་བ་ཅི་ལྟར་དྲག་སྙམ་སྟེ་ཞལ་རྡུལ་སྤྲུགས་བསམ་པས་རྡུལ་ཆེ་བ་མེད་པ་ཞིག་འདུག།",
    "ངེད་རང་བཀྲ་ཤིས་ལྷུན་པོའི་གཟིམས་ཆུང་ཉི་འོད་འཁྱིལ་དུ་སླེབས་འདུག།",
    "སྐྱབས་མགོན་དམ་པ་མཆོག་སྤྲུལ་བློ་བཟང་ཡེ་ཤེས་དེ་ཉིད་ཞིང་དུ་ཕེབས་པའི་ཞག་ཁ་ཤས་ནས་ནུབ་གཅིག་བཀྲ་ཤིས་ལྷུན་པོར་སླེབས་འདུག་པར་དངུལ་གདུང་རྙིང་པ་ཡིན་སྙམ་པ་གཟིམས་ཆུང་ཡང་ཡིན་སྙམ་པ་ཞིག་ན་པཎ་ཆེན་ཉིད་ཁྲི་མཐོན་པོར་བཞུགས་ནས་བདག་ལ་ང་མྱ་ངན་ལས་འདའ་བ་ཡིན་གསུང་།",
    "གལ་ཏེ་ཞུ་ནུས་ན་བསྟན་ཕན་ཆེན་པོ་འོང་ངེས་ཡིན་འདུག་པར་དོན་ལ་ཡང་དེ་ལྟར་བྱུང་།",
    "དེར་ཕྱུགས་ལུག་མང་པོའང་འདུག།",
    "རང་དང་མཉམ་པ་རྣམས་ལའང་སོ་སོའི་ཐུགས་འདོད་དང་བསྟུན་པ་ཞུས་ཀྱང་ཧ་ཅང་དགོངས་པ་འཚེངས་པ་ནི་མི་འོང་འདུག་པས་རང་གཞན་གཉིས་འཕུང་དུ་འགྲོ་ཞིང་།",
    "ལུང་པ་དོག་ཅིང་ནགས་ཚལ་གྱིས་ཁྱབ་པ་ཞིག་ལམ་མེར་མཐོང་བ་འདུག།",
    "སྤང་རི་གངས་རི་ཆེ་བ་མང་པོ་ཡང་འདུག་པར་ངེད་ཀྱིས་ལུང་པ་འདི་གང་ཡིན།",
    "ཁོང་ཅག་དཔོན་གཡོག་རྣམས་ཀྱིས་ག་ཡ་དྷ་རའི་བུམ་པ་དེ་ཡང་ཞལ་ཕྱེ་འདུག་པས་བུམ་ཆུ་ཤིན་ཏུ་མཐོ་བ་ཞིག་འདུག་པར།",
    "ཚོགས་པ་བྱིང་ལའང་རབ་ཏུ་བྱུང་བ་དང་བསྙེན་པར་རྫོགས་པ་སྒྲུབ་པ་བཞི་བརྒྱ་དང་སུམ་ཅུ་སྐོར་གདའ།",
    "ཟླ་བ་དྲུག་པ་ནས་བརྒྱད་པའི་བར་དུ་འབྲུམ་པ་ངོར་ནང་དུ་མཆེད་རུང་དགོན་ཡུལ་ཐམས་ཅད་དུ་རང་རང་ལས་ཅི་བབ་ཙམ་མ་གཏོགས་ཕྱི་རོལ་དུ་འདོན་པའི་སྣེར་གཅོད་སོགས་ནི་མ་བྱུང་ཞིང་།",
    "དེ་ག་ཐམས་ཅད་གྲོས་མཐུན་གྱི་སྒོ་ནས་བབ་འོས་སུ་འདུག་ལ་ཁྲི་རྩིས་སྤྲོད་ནས་མགྱོགས་པར་ཁམས་སུ་འགྲོ་བའི་གྲབས་ཡུལ་གྱིས།",
    "རིམ་གྱིས་ལྗགས་བསྙེན་གྲུབ་ཐོག་ཀླུ་ལྡིང་རང་ནས་ལུགས་གཉིས་ཁུར་ལེན་དགོས་པ་སོགས་བཀའ་འགྲོས་ཀྱི་ཐོག།",
    "བཟོ་རིགས་ལས་ཚན་གྱིས་གཙོས་ཨར་པོ་བ་མི་སུམ་བརྒྱ་སྐོར་འདུག་པར་ལྷ་ཁང་དུ་ཕེབས་པ་ཇི་ལྟར་ལེགས་ཀྱི་བཀའ་འདྲི་བྱུང་བར།",
