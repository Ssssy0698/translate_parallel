    "འདི་འདྲའི་དོན་དག་གལ་ཆེན་གྱི་ཐད་དུ་ཤེས་རྒྱ་ཅན་གྱི་གཞོན་ནུ་ཚོས་རང་བློས་གང་འདོད་དང་རང་མགོ་རང་རྒྱལ་གཏན་ནས་མི་བགྱིད་པར།",
    "གཉེན་སློང་ཡུལ་གྱིས་གཉེན་ཚང་ལ་ཁྱིམ་གཉིས་ཀྱི་ཆ་རྐྱེན་དང་མཐུན་པའི་བླང་བྱ་འདོན་པའི་སྲོལ་འདུག་པ་སྟེ།",
    "ཨ་ཞང་ཚང་ཁྱིམ་དུ་ཕེབས་ནས་གཉེན་སྟོན་བཤམས་སྐབས།",
    "དཀྲུགས་ཤིང་ཕུར་ནས་ཇ་མཆོད་འབུལ་བའི་ཆོ་ག་ཞིག་ཀྱང་འདུག་སྟེ།",
    "ཞེ་ཆགས་རུང་འདུག་ས་གང་ན་ཡོད།",
    "ཞེ་ཆགས་རུང་འདུག་ས་གང་ན་ཡོད།",
    "འོན་ཏེ་རྭ་གཞུ་ཡིན་པ་སུས་ཀྱང་ཁས་ལེན་བཞིན་འདུག་རྭ་གཞུ་དེ་སྨྱུག་གཞུ་དང་སྐྱེར་གཞུར་མི་མཐུན་པ་དེ་ནི།",
    "ཕལ་ཆེར་ཚིག་རྐང་བཞི་དང་དྲུག་བརྒྱད་བཅུ་མང་པོ་འདུག་དཔེར་ན།",
    "གླུ་ལེན་གྱི་ནང་དོན་དང་འགྲོ་རིམ་ཐམས་ཅད་སྔར་དང་མཚུངས་ན་ཡང་སྐུ་མགྲོན་རྣམས་ལམ་ལ་འགྲོ་སྐབས་སྐྱེལ་མ་རྒྱ་ཆེན་པོ་བྱེད་བཞིན་འདུག་དེར་ཡང་གཞི་བའི་ཕོ་གསར་རྣམས་ཀྱི་ལག་ཏུ་ཆང་དཀར་འབྲུག་རྒྱན་བཟུང་སྟེ།",
    "ཁ་བཀར་དཀའ་བའི་སྣང་ཚུལ་ངོ་མ་ཞིག་ཤར་འདུག་དེ་ནས་སྐུ་མགྲོན་རྣམས་ཕལ་ཆེར་རྒྱང་ཕྲག་གཅིག་ཙམ་ལ་སླེབས་པའི་སྐབས་སུ།",
    "འོན་ཏེ་གནའ་ནས་ད་ལྟའི་བར་རྒྱུན་མ་ཆད་པའམ་མ་ཉམས་པར་གནས་འདུག་པ་ནི་ཆབ་འགག་ཡུལ་གྱི་ལབ་ཙེ་ཆབ་རིལ་ལྟ་བུ་ཉུང་ཙམ་ལགས།",
    "མེད་པ་གསར་དུ་བཟོ་བཞིན་འདུག་ཉིན་དེར་ལབ་ཙེ་བསྟོད་པ་ལས་གཞན་གོས་ཀྱི་བཟང་ངན་དང་སྲམ་གྱི་ཆེ་ཆུང་།",
    "ཅུང་རིང་བར་ཡོད་པའི་མི་རྣམས་ཀྱིས་རྟ་དང་དྲེལ་བཅས་ལ་ཞོན་ནས་ཡོང་བཞིན་འདུགཕྱོགས་བཞི་མཚམས་བརྒྱད་ནས་ཡོང་བའི་སྐྱེས་པ་རྒན་དར་གཞོན་གསུམ་ཕལ་ཆེར་འདུས་པས་ན།",
    "ལ་གཞས་སོགས་མང་པོ་མེད་ཚེ་རྒྱལ་ཁ་མི་ལོན་ཞིང་དགའ་རྟགས་ཨང་དང་པོ་ཡང་ལོན་པའི་དཔེ་མི་སྲིད།",
    "གླུ་ཚིག་མང་པོ་བློར་འཛིན་བཞིན་འདུག་ཁྱད་པར་དུ་ལ་གཞས་ཀྱི་དྲི་བ་དང་དྲིས་ལན་སྐོར་གྱི་ཚིག་འབྲུ་མང་པོ་སྦྱངས་པ་བྱེད་ཀྱིན་ཡོད།",
    "སྐེད་འཁོར་གསུམ་ཅན་གྱི་ཕོ་གསར་ཚོར་ཁ་ཏ་འདི་འདྲ་ཞིག་གནང་འདུག་ངས་ཕོ་གསར་རྣམས་ལ་ཁ་ཏ་བྱེད།",
    "འདི་ནས་ཡུན་རིང་འདུག་ཁོམ་མེད།",
    "མྱུར་དུ་ལམ་ལ་སྐྱོད་པའི་ཚུལ་ནི་འདི་ལྟར་བྲིས་འདུག་རྟ་འདོ་བའི་གོང་ལ་ཞོན་ནས།",
    "ང་འབེལ་གར་མི་འདུག་འགྲོ་རྒྱུ་ཡིན།",
    "སྐབས་དེར་ཁོ་རང་ལོ་རྒན་དྲུག་ཅུར་བསླེབས་ཡོད་ཀྱང་།",
    "ཁོ་རང་གཞོན་པའི་དུས་ནས་ངལ་རྩོལ་ལ་དགའ་བས་རྒན་པའི་དུས་སུའང་ལུས་ལ་ན་བ་མེད་པར་བདེ་ཐང་ཡིན།",
    "ད་ལྟ་ཁོང་རང་མཚོ་སྔོན་རྩོམ་པ་པོ་མཐུན་ཚོགས་ཀྱི་ཚོགས་མི་དང་ཀྲུང་གོའི་གྲངས་ཉུང་མི་རིགས་རྩོམ་པ་པོ་མཐུན་ཚོགས་ཀྱི་ཚོགས་མི་བཅས་ཡིན་ལ།",
    "ཨ་ཙི།",
    "དུས་དེ་ཙ་ན།",
    "ཁྱེད་རང་ཐུགས་མི་འཁྲུག་པར་མཁྱེན།",
    "འབུལ་བ་ངས་ཕྱིར་མ་སློག་པར་བུ་ཡིས་ཕྱིར་སློག་འདུག་པས།",
    "མགར་བའི་ཆུང་མའི་སེམས་སུ་སློབ་དཔོན་གྱི་ཆུང་མ་སྐལ་བཟང་སྒྲོལ་མའི་སྐད་ཆ་ནི་བདེན་པར་འདུག་ཡིན་ཀྱང་བུ་ཐོས་པ་དགའ་རབ་ཏུ་བྱུང་ཚེ་སློབ་དཔོན་གྱི་ཁྱིམ་ཤུལ་སུས་འཛིན",
    "གློ་གྲི་འདི་ཨ་ཇོ་ཐོས་པ་དགས་ང་ལ་བྱིན་པ་ཡིན།",
    "ཁོ་ཚོའི་ངོ་གནག་ཚུལ་ལ་བལྟས་ན་ཕལ་ཆེར་ད་ནངས་ཆབ་མཆོད་མ་ཕུལ་བས་ཁྲོས་འདུག་སྙམ་ནས་འཕྲལ་མར་དུང་ཕོར་བསྒྲིགས་ཤིང་ཆབ་མཆོད་བླུགས།",
    "ན་ནིང་དབུས་སུ་ཕྱིན་པའི་ངའི་བུ་སློབ་འོད་ལྡན་གྱིས་ཁོང་ཙི་ནའི་སྐུ་ཚབ་དང་ཆབས་ཅིག་དབུས་སུ་ཕེབས་འདུག་ཟེར།",
    "རྒྱ་གར་དུ་སྐྲ་སེར་སྤྲེའུའི་རིགས་ཀྱིས་ཁེངས་འདུག་ཟེར།",
    "འུ་གཉིས་ཁ་བརྡར་མགོ་འཁོར་ནས་ཆང་འཐུང་བ་མ་གཏོགས་ཟས་ཟ་རྒྱུའང་བརྗེད་འདུག་སྔོན་ལ་མགར་བས་ལུག་ཤ་ཞིག་བཞེས་དང་དྲིས་ལན་ག་ལེར་གདབ་ཆོག་ཅེས་སྨྲས།",
    "རྒྱལ་ཁམས་མ་འགྲིམ་པའི་སྐྱོན་སློབ་དཔོན་ལའང་ཡོད་ཚོད་འདུག་ཆུ་དང་མེ་འཕྲད་ན་བཟང་ལས་ངན་ག་ལ་ཡིན།",
    "སྐྱིད་མེད་ཀྱང་རང་ཁ་སོས་ནས་ཡོད་པར།",
    "གྱན་ཐང་ངོས་སུ་རིགས་ལྡན་དྲག་པོའི་འཁོར་ལོས་ལྷ་དམག་དྲངས་ཏེ་ཀླ་ཀློའི་དམག་དཔུང་འཇོམས་པ་བྲིས་འདུག་ལ།",
    "བྱིས་པ་བཀྲེས་ལྟོགས་ཀྱིས་མནར་འདུག་པས་མཇུག་མཐར་ཐོས་པ་དགས་ཁོ་མནན་ནས་འགུལ་དུ་མ་བཅུག་བྱིས་པ་འུ་ཐུག་སྟེ།",
    "ལོ་གཉིས་ལྷག་ལ་གྲག་འགུལ་མ་བྱུང་བར་ཡུལ་མི་ཚོ་བློ་བདེ་བག་ཕེབས་སུ་གནས་ཙ་ན།",
    "ཁོ་ཚོའི་བློ་ངོར་མ་ཤར་པ་ནི་སྐབས་དེ་ཙ་ན་ཐོས་པ་དགའ་ཁང་པའི་རྩིག་ཤིང་རྒྱབ་ལོགས་སུ་ཡིབ་སྟེ།",
    "རིགས་ལྡན་རྒྱལ་པོར་སྒྲོགས་ཤིག་འདུག་ཟེར།",
    "དུས་དེ་ཙ་ན།",
    "ས་རུ་ཟགས་པའི་ལོ་མ་ལྗང་སེར་གྱི་སྟེང་དུ་ཁྲག་ཐིགས་དམར་པོ་ཆལ་ལེ་ཆོལ་ལེར་འཐོར་འདུག་ཐོས་པ་དགས་ཁྲག་ཐིགས་མཐོང་བས་གཞི་ནས་འཇིགས་སྐྲག་སྐྱེས།",
    "ཚ་བོ་དགྲ་ལྷ་ཐར་འདི་སྐུ་ཡ་རབས་ལ་སྤྱོད་པ་མ་རབས་ཤིག་འདུག་པས།",
    "ངས་ཚ་བོའི་རྩལ་ཤུགས་ཀྱི་ཉམས་ཚོད་ཅིག་ལེན་འདོད་འདུག་ཟེར་ཞིང་།",
    "ཁྱུང་ཐར་གྱིས་ཀྱང་རང་ནུས་ཡོད་རྒུས་ཡ་ལན་སྤྲད་དེ་ཁྲོག་སྒྲ་དང་སྡིག་སྒྲའི་ཁྲོད་ནས་བུ་ཡུག་འཚུབ་འཚུབ་བྱས་ཤིང་།",
    "གནུབས་པཎ་ཆེན་ལ་ཚ་བོ་གཤིས་དྲང་ཞིག་ཡོད་འདུག་ཟེར།",
    "ཙི་ནའི་ཤོར་དམག་དེས་ཀྱང་དུས་འགྱུར་ཆེན་པོ་ཞིག་སྟོན་གྱིན་འདུག་དེར་མ་ཟད།",
    "སློབ་དཔོན་གྱི་ཚ་བོ་འདི་གཤིས་ཀ་འཚུབ་ལི་ཡིན་པར་མ་ཟད་ཨུ་ཚུགས་ཅན་ཞིག་ཀྱང་འདུག་དགྲ་གཅིག་ཡོད་ན་མང་རབས་དང་གྲོགས་བརྒྱ་ཡོད་ན་ཉུང་རབས་ཀྱི་དཔེ་ལྟར།",
    "ད་དུང་ཁོའི་རོགས་པ་ཞིག་ནགས་གསེབ་ཏུ་ཡིབ་འདུག།",
    "ད་དུང་ཁོའི་རོགས་པ་ཞིག་ནགས་གསེབ་ཏུ་སྐུང་འདུག་ཅེས་མཚན་ནུབ་དེའི་མཐོང་ཐོས་མ་ལུས་ཞིབ་ཏུ་བརྗོད་པར།",
    "དུས་དེ་ཙ་ན།",
    "འབྲེལ་འདྲིས་ཅན་གྱི་མིའི་འཆི་བ་མ་མཐོང་ཚེ་གཞན་ཅི་ཙམ་ཤི་ནའང་རང་ཉིད་དང་འབྲེལ་བ་མེད་པ་ལྟར་གནས།"
  ]
