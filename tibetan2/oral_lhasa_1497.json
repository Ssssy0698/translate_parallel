    "ཐུགས་རྗེ་ཆེན་པོས་དབུལ་ཕོངས་ཚིམ་པར་གྱིས།",
    "དེ་ལྟར་བྱས་ན་ཀུན་ཏུ་བདེ་བར་འགྱུར།",
    "མི་གཙང་འཛེ་གླད་ཁྱི་ཤ་སྣག་ཁྲག་ལ།",
    "མི་གཙང་ཁྲོད་དུ་ལྭ་བ་གོན་པ་ལ།",
    "ལན་མ་ཐེབས་པར་སྲས་ལ་གང་དགོས་གནང་།",
    "ཐོག་དེ་དབྱིངས་ནས་འབབ་ཏུ་མ་འདོད་པར།",
    "ལེགས་པར་བརྒྱུད་ཅིང་དིང་སང་བྷང་ག་ལར།",
    "འདི་ནི་མ་ཆགས་དཀའ་བ་སྤྱད་པར་འདོད།",
    "ངེས་པར་འཆིང་བ་འདི་ལས་དབྲལ་དུ་གསོལ།",
    "ངེས་པར་གཉེན་པོ་བཙན་ཆོད་བྱེད་པའི་དུས།",
    "རྒྱལ་བུ་དམ་པ་ནགས་སུ་བཞུགས་བཞུགས་འདྲ།",
    "དགའ་བར་འདུས་པ་འབྲལ་བར་ཕོད་ལགས་སམ།",
    "ལྷག་པར་ཡབ་ཀྱི་ཞལ་ནས་འདི་སྐད་གསུང་།",
    "ད་ནི་ནགས་ཁྲོད་བསྟེན་ལོ་ཇི་ལྟར་ལགས།",
    "དེ་ནས་རྒྱལ་བུས་ནངས་པར་ཐོ་རངས་ནས།",
    "བསྟན་པའི་མངའ་བདག་དོན་གྲུབ་གཉིས་པ་ལགས།",
    "སྲིད་པའི་སྐྱོན་གྱིས་གོས་པར་མ་གྱུར་ཀྱང་།",
    "ཡེ་ཤེས་གསང་བའི་རྡོ་རྗེ་མ་ལགས་སམ།",
    "ལས་ཅན་བརྟགས་ཤིང་བཅུད་ཀྱིས་སྨིན་པར་མཛོད།",
    "ཚེ་འདིའི་སྤྲོས་པ་མཐའ་དག་ཆོད་པར་མཛོད།",
    "ཤེས་རབ་རྟོགས་པ་ནང་དུ་རྒྱས་པར་མཛོད།",
    "འཕྲིན་ལས་བཟང་པོས་ཕྱོགས་མཐར་ཁྱབ་པར་མཛོད།",
    "གདུལ་བྱ་ཡོངས་ལ་ཕྱོགས་རིས་མེད་པར་མཛོད།",
    "སྒོ་གསུམ་ཐུབ་པ་ཆེན་པོར་བསྟན་པར་མཛོད།",
    "གཉེན་པོ་མི་གཡོ་མགོན་པོར་ཚུགས་པར་མཛོད།",
    "བསླབ་པ་གསུམ་གྱིས་ཉིན་མཚན་ཕྱུག་པར་མཛོད།",
    "གསང་སྔགས་ལྷུན་གྱིས་གྲུབ་པར་མཆིས་སོ་ཨང་།",
    "དམ་ཉམས་ཕྱོགས་སུ་མ་བསྙེན་བརླག་པར་གྱིས།",
    "འཆལ་བ་ཕྱོགས་སུ་མ་བསྙེན་བརླག་པར་གྱིས།",
    "མནར་མེད་གསོ་རུ་མེད་པར་ཁོ་བོ་སྨྲ།",
    "དེ་ལྟར་བྱས་ན་ནག་པོ་དམ་ལ་ཐོགས།",
    "གཙོ་བོ་མི་གཡོ་མགོན་པོས་འདི་སྐད་གསུངས།",
    "དེ་དག་ཀུན་ལ་མཆོད་གཏོར་རྒྱ་ཆེན་གནང་།",
    "ནམ་གུང་ཏིང་འཛིན་གཅིག་ལ་མཉམ་པར་བཞག།",
    "ཐོ་རངས་གཙང་སྦྲ་ཁྲུས་ཀྱི་རྣམ་པར་མཛད།",
    "གཙང་སྦྲའི་ཚུལ་གྱིས་གསང་སྔགས་ཉམས་སུ་བཞེས།",
    "མི་སྨྲ་དབེན་པར་དཀྱིལ་འཁོར་ནང་ན་གསལ།",
    "གཙང་སྦྲ་ཐོ་བའི་ཡན་ལག་བདུན་པ་ཡིས།",
    "མ་གཙང་བུ་གཙང་སྤྱོད་པ་གཙང་བ་དང་།",
    "གནས་གཙང་གྲོགས་གཙང་ས་རྣམས་ཤིན་ཏུ་གཙང་།",
    "ཞིང་ཁམས་གཙང་མར་མེ་ཏོག་སྦུབས་ནས་འཁྲུངས།",
    "འདི་ནི་གཙང་མ་ལྷའི་བདེན་ཚིག་ཡིན།",
    "དི་པཾ་ཀ་རའི་འཕྲིན་ལས་མ་ལགས་སམ།",
    "བོད་དུ་འབྱོན་པར་ཡི་དམ་ཆེན་པོ་བཅས།",
    "དོས་བྱས་ཐབས་ཀྱིས་མེ་ཏྲིའི་གནས་སུ་འདོར།",
    "འགྱུར་བ་མེད་པར་འབྱོན་པ་གལ་ཆེ་ལགས།",
    "དཔོན་གཡོག་སུམ་ཅུ་རྩ་ལྔ་འབྱོན་པར་ཞུ།",
    "བཟོད་པར་བཞེས་ཤིང་བརྩེ་བར་མཛད་དུ་གསོལ།",
    "བསམ་པ་བཟང་པོ་འདི་ཡིས་རྐྱེན་བྱས་ནས།",
    "ཀུན་བཟང་སྟུག་པོ་བཀོད་པའི་ནགས་ཁྲོད་དབེན་པར་བཀོད་པ་ལེགས་པར་རྫོགས་སོ།",
    "ཆུ་སྲིན་ཉ་མིད་ཆེན་པོར་བྱས་སྟེ།",
    "ཉ་མིད་ཆེན་པོས་འདི་ལྟར་མདུན་ནས་འཇིགས་པར་བྱས།",
    "དིང་སང་འདི་ན་བར་ཆོད་ལྷགས་ཀྱང་མི་སྐྱོབ་པར།",
    "དབེན་པར་དབྱིངས་ན་བཞུགས་པ་ཐུགས་རྗེ་ཇི་ལྟར་ཆུང་།",
    "ཞེས་གསོལ་བ་ཁྱད་པར་ཅན་འདེབས་པ་ཁོ་བོས་ལེགས་པར་ཐོས་པ་དང་།",
    "རི་རབ་ཚལ་བར་བཤགས་ཏེ་འོག་གསེར་གྱི་ས་གཞིའི་སྟེང་ཐུག་པར་མཚམས་ཕྱེ་སྟེ།",
    "རླབས་དང་འོད་དང་སྒྲ་ཐམས་ཅད་ཞི་ནས་རྫིང་ཆེན་པོ་ཡང་རྣལ་དུ་ཕེབས།",
    "ཁོ་བོ་ཡང་བཅོམ་ལྡན་འདས་གཤིན་རྗེ་གཤེད་ཀྱི་བསྐྱེད་རིམ་མ་བཤིག་པར་རྫིངས་ཀྱི་ཁ་ཁྱེར་ལས་འཇའ་ལི་བྱས་ནས།",
    "རྟག་ཏུ་ཁྱེད་ཀྱིས་སྟོངས་པར་བྱས།",
    "གཅིག་སྲིན་ཡུལ་ལང་ཀར་བརྒྱབ་པར།",
    "བདག་ཅག་ཐམས་ཅད་ཚིམ་པར་བྱས།",
    "འཆུག་པ་མེད་པར་བསྐྱབ་ཏུ་གསོལ།",
    "ཞག་ཉི་ཤུ་རྩ་གཅིག་ཏུ་གར་ཡང་ཕྱིན་པར་མ་ནུས།",
    "ཟླ་བ་ཕྱེད་དང་གཉིས་ཀྱི་བར་དུ་ཉིན་མཚན་མེད་པར་རྒྱ་མཚོར་ཞུགས་ཏེ་ཕྱིན་པས།",
    "ཐམས་ཅད་མཐུན་པར་ཞུ་བ་ཕུལ་བ་ནི།",
    "སྐྱེ་རྒུའི་ཉེར་མཁོ་ཐམས་ཅད་སྤྲུལ་པར་བྱེད།",
    "རྟེན་གསུམ་ཐམས་ཅད་རབ་ཏུ་གནས་པར་མཛོད།",
    "སྡོམ་ལྡན་ཐམས་ཅད་བསྲུང་སྡོམ་མཁས་པར་མཛོད།",
    "སྔགས་པ་ཐམས་ཅད་དམ་ཚིག་གཙང་བར་མཛོད།",
    "ཡོན་རྣམས་ཐམས་ཅད་བསྔོ་བས་བརྟན་པར་མཛོད།",
    "བརྒྱུད་པ་གང་ལའང་དམ་ཉམས་མེད་པར་མཛོད།",
    "ལྟ་བ་ཀུན་ལ་གཡང་ས་མེད་པར་མཛོད།",
    "བསྒོམ་བསྒྲུབ་ཀུན་ལ་གོལ་པ་མེད་པར་མཛོད།",
    "གསུང་དེ་ཐོས་ནས་ཤིན་ཏུ་ཚིམ་པར་གྱུར།",
    "བསྙེལ་བ་མེད་པར་ཐུགས་ཀྱིས་འཛིན་པ་དང་།",
    "རྟག་པར་ཐུགས་དགོངས་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "དྷརྨ་རཀྵི་ཏ་ཡིས་ལན་གསུངས་པ།",
    "བག་ཕེབས་རི་དྭགས་རྒྱུ་བའི་ཡུལ་དུ་རྒྱུག།",
    "རྒྱུག་རྒྱུག་ཐམས་ཅད་མཁྱེན་པ་མྱུར་དུ་རྒྱུག།",
    "གཡོ་བ་མེད་པར་བསྐྱང་བསྐུམ་བསྒྲད་ཅིང་རྒྱུག།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཚོགས་གཉིས་དཔལ་ལས་རྒྱལ་བ་གཉིས་པར་གྱུར།",
    "བྱམས་པས་ཕྱོགས་རིས་མེད་པར་ཁྱབ་པར་བསྒོམས།",
    "གནས་ལུགས་གཉིས་སུ་མེད་པར་གློད་ལ་བསྒོམས།",
    "གསང་སྔགས་ནང་དུ་བསྟེན་པས་དམ་ཚིག་གཙང་།",
    "ཤེས་བྱ་ཀུན་རིག་མཁྱེན་བརྩེའི་ཕ་རོལ་ཕྱིན།",
    "དམ་པ་གཞན་ལས་ཁྱད་པར་འཕགས་པ་ལགས།",
    "ཁྱེད་ཀྱི་ཐུགས་རྗེ་ཆེན་པོས་བསྐུལ་བ་ལགས།",
    "ལྷ་སྐུའི་སྣང་བས་རྡོ་རྗེའི་ཤུགས་ཀྱིས་བསྒྲོད།",
    "ཡིད་ནི་མཁྱེན་བརྩེའི་མངའ་བདག་དབྱིངས་སུ་དྲོངས།",
    "མི་ཤེས་གཏི་མུག་ཐམས་ཅད་འཇིག་པར་འགྱུར།",
    "ཀུན་གྱིས་ལས་འབྲས་ཐམས་ཅད་ཕྱེད་པར་འགྱུར།",
    "དེ་ལྟར་མད་ལགས་ཤིན་ཏུ་ངོ་མཚར་ཆེ།",
    "ནུས་པ་གང་ཡོད་ལྷོད་པར་མ་བྱ་སྟེ།",
    "འགྲོ་དོན་ཕུན་སུམ་ཚོགས་པར་བྱིན་གྱིས་རློབས།",
    "དམ་ཚིག་གཙང་ཞིང་འགྲོ་དོན་འཕེལ་བར་ཤོག།",
    "ཉན་ཐོས་ངན་པའི་རྒབ་ཏུ་འཁྲིས་པར་ཉེ།",
    "མངོན་ཤེས་མེད་པར་སུའང་སྡིག་མ་བསག།"
  ]
}