    "བྱང་སེམས་མོས་སྤྱོད་པ་དང་།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་དང་ཐག་ཉེ་ཞིང་འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པ་དེ་ནི་ཟག་པ་མེད་པ་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "སྨྲས་པ་མོས་པས་སྤྱོད་པའི་ས་ལ་ནི་དང་པོ་རྣམ་པར་གཞག་གོ།",
    "གཟུགས་ལ་དེ་ལས་ཕོ་མོའི་དང་སྡུག་བསྔལ་དང་ཡིད་མི་བདེ་མེད་པས་བཅུ་དང་།",
    "བདག་དང་བདག་གི་བ་ཡང་ཁམས་གསུམ་ཆར་ན་ཡོད་དོ།",
    "ཁ་ཅིག་ཡུལ་མི་འགོག་པར་ཡུལ་ཅན་ལ་ཞེན་པ་ཙམ་འགོག་པར་འདོད་ཀྱང་བདག་དང་བདག་གི་བ་ལ་ནི་ཞེན་པ་ཡིན་ལ།",
    "མཐོང་ལམ་ཐོབ་པ་ན་ངན་སོང་བའི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་སྤངས་པར་གསུངས་པས་སོ།",
    "འདི་སྙམ་དུ་བདག་ནི་ཕྱིར་མི་ལྡོག་པའམ་ཕྱིར་མི་ལྡོག་པ་མ་ཡིན་ནོ་སྙམ་ཡང་མི་བྱེད་དེ་ཐེ་ཚོམ་ཡང་མི་སྐྱེ་ཞིང་རང་གི་ས་ལ་དོགས་པ་མེད་དོ།",
    "རང་གི་ས་ལ་དོགས་མེད་རྟག་ཏུ་རི་རབ་འདྲ།",
    "ས་གསུམ་ནི་ཡང་ན་བྲལ་བ་དང་བྲལ་བའི་ཐོབ་པ་དང་རྣམ་མཁྱེན་ཐུན་མོང་མ་ཡིན་པ་གསུམ་མོ།",
    "འདིར་ཕྱིར་མི་ལྡོག་གི་རྟགས་སུ་འགྲོ་རྒྱུ་གང་ཞེ་ན།",
    "རྣལ་འབྱོར་པ་འཕགས་པ་རྣམས་ཀྱི་ལུས་ངག་གི་ཐ་སྙད་ནི་རྣམ་པ་ཐམས་ཅད་དུ་མཉམ་གཞག་གི་རྟོགས་པ་དང་མཐུན་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དཔུང་བཟང་གིས་ཞུས་པ་ལས།་",
    "གང་གི་རང་བཞིན་ཆགས་སྡང་དང་བྲལ་ཡང་།",
    "མཐོང་ལམ་པའི་མཉམ་གཞག་ནི་ཇི་ལྟར་ན་གང་ཟག་གཞན་ངོར་མཐོང་ལམ་པ་ཕྱིར་མི་ལྡོག་ཏུ་ཡིད་ཆེས་པར་བྱེད་པའི་མཚན་ཉིད་དམ་རྟགས་དག་ཡིན་ཏེ་མ་ཡིན་པར་ཐལ།",
    "རྣལ་འབྱོར་པ་འཕགས་པའི་རྒྱུད་ཀྱི་ཤེས་བཟོད་ཀྱི་སྐད་ཅིག་མ་རྣམས་རྣལ་འབྱོར་པ་སོ་སོ་རང་གིས་རིག་གི་གཞན་གྱིས་མི་རིག་པས་སོ།་།",
    "མཐོང་ལམ་སྐད་ཅིག་མ་བཅུ་དྲུག་མཐོང་ལམ་པ་ཕྱིར་མི་ལྡོག་གི་མཚན་ཉིད་ཡིན་ནོ་ཞེས་དོན་བསྡུས་ནས་དེའི་རྗེས་ལ་ཇི་ལྟར་རྣལ་འབྱོར་པའི་རྒྱུད་ལ་ཡོད་པ་སོ་སོ་རང་གིས་རིག་པའི་སྐད་ཅིག་མ་རྣམས་གཞན་དག་ཡིད་ཆེས་པར་བྱེད་པའི་མཚན་ཉིད་དག་ཡིན་ཞེ་ན།",
    "ཕྱིར་མི་ལྡོག་གི་རྟགས་ཉིད་འཆད་དམ་ཞེ་ན།",
    "གཉིས་པས་ཟབ་པ་རང་གི་ངོ་བོ་དང་།",
    "བྱང་ཆེན་ཕྱིན་དྲུག་ལ་སྤྱོད་པའི་ཚེ་གང་ལ་གནས་ཤིང་དྲན་ཉེ་བཞི་ཡོངས་སུ་རྫོགས་པར་བགྱིད་པ་དང་ནས་རྣམ་མཁྱེན་གྱི་བར་དུ་ཡོངས་སུ་རྫོགས་པར་བགྱིད་པའི་གནས་ཟབ་མོ་ཟབ་མོ་རྣམས་ལེགས་པར་བསྟན་དུ་གསོལ།",
    "ཟབ་མོ་ཞེས་བྱ་བ་འདི་ནི་སྟོང་པ་ཉིད་ཀྱི་ཚིག་བླ་དྭགས་སོ།",
    "མཐོང་ལམ་ནི་ཟབ་པ་དང་རྒྱ་ཆེ་བ་གཉིས་ཀ་ཡིན་ལ་སྒོམ་ལམ་ནི་གཙོ་བོར་ཤེས་སྒྲིབ་ཀྱི་གཉེན་པོར་ཟབ་མོའི་རང་བཞིན་དུ་གྱུར་པ་སྟེ་འདི་ཆེས་གོམས་པས་ས་བརྒྱད་པའི་ཚེ་ཞི་བ་ལས་སློང་བར་མཛད་དོ་ཞེས་འཆད་དོ།",
    "སྒོམ་ལམ་དེ་ནི་རྒྱུན་ཆགས་ཡིན་པའི་ཕྱིར་ན་སྔ་མ་རྣམས་ཕྱི་མས་ཡུལ་དུ་བྱེད་པས་མི་འགལ་ཞེས་འོག་གི་དེ་ནི་རྒྱུན་ཆགས་ཞེས་པ་འདིར་བླངས་ནས་འཆད་དོ།",
    "དེས་ན་ཡང་དང་ཡང་ཞེས་པ་རྒྱུན་ལྡན་དུ་བསྟན་ལ་སེམས་འཇལ་ངེས་རྟོག་གིས་སྒོམ་ལམ་གྱི་ངོ་བོ་བསྟན་ཏེ།",
    "བྱང་ཆེན་ཡུམ་ལས་ཇི་ལྟར་གསུངས་པ་བཞིན་བདག་གིས་འདི་ལྟར་གནས་པར་བྱའོ།",
    "ཡུམ་ལས་ཇི་ལྟར་ཉེ་བར་གནས་པ་བཞིན་བདག་གིས་འདི་ལྟར་བསླབ་པར་བྱའོ།",
    "ཉི་སྣང་གིས་སྤང་བྱ་ལ་ཡང་གཞུང་དེ་འདོན་པ་སྤོའོ།",
    "གང་གི་སྒོ་ནས་རྣམ་རྟོག་གི་གཉེན་པོ་བྱེད་ན།",
    "སྒོམ་སྤང་རྣམ་པར་རྟོག་པའི་རྩ་བའི་དབྱེ་བ་ཆེ་འབྲིང་ཆུང་ངུ་རྣམས་རེ་རེ་ཞིང་ཆེ་འབྲིང་ཆུང་ངུའི་བྱེ་བྲག་གིས་ཐ་དད་པ་དགུ་ཡོད་པའི་ཕྱིར་སྤང་བྱ་དེ་དག་གི་གཉེན་པོ་སྒོམ་ལམ་ཆུང་འབྲིང་ཆེན་པོ་རྣམས་ཀྱང་རེ་རེ་ཞིང་ཆུང་འབྲིང་ཆེན་པོའི་བྱེ་བྲག་གིས་ཐ་དད་པ་དགུ་ཡོད་པའི་ཕྱིར་ཏེ་དེ་ལྟར་ནའོ།",
    "དཔེར་ན་རྡེའུ་ནི་འཛུབ་མོ་རེས་ཀྱང་འདོར་ནུས་ལ་རི་ལ་ནི་དེ་ལྟ་མིན་པ་བཞིན་ཞེ་ན།",
    "སྒོམ་ལམ་གྱི་བྱེ་བྲག་དབྱེ་བ་ནི་གྲངས་རྣམ་པ་དགུ་ལས་མང་བ་མ་ཡིན་ནམ་སྟེ་ཡིན་པར་ཐལ།",
    "བྱང་ཡེས་ལུགས་གཉིས་ཀ་མཛད་ཅིང་དེ་ཡང་བདག་ཉིད་ཆེན་པོ་དང་ཁྱུང་གི་བཞེད་པ་ཕྱི་མ་དང་འབྲེའི་བཞེད་པ་སྔ་མར་གྲགས་ཤིང་དཔལ་ལྡན་ཆ་པ་རིགས་རལ་ཡང་ཕྱི་མ་བཞེད་དོ།",
    "འགྲེལ་བ་གཉིས་ལྟར་ན་དེ་ཉིད་གཞུང་གི་དོན་ཡིན་ཏེ།",
    "འདི་སློབ་དཔོན་གྱིས་དགོངས་མོད་འོན་ཀྱང་རྫས་ཐ་དད་གསུམ་སྐྱེ་བ་བཀག་པ་ནི།",
    "གྲངས་མེད་སོགས་ལྡོག་པ་ཐ་དད་པ་ཡིན་ན་གྲངས་མེད་ལྟ་བུ་གཅིག་གིས་བསྟན་པས་ཆོག་མོད་ཅིའི་ཕྱིར་གསུམ་གྱིས་བསྟན་ཞེ་ན།",
    "སྤང་གཉེན་ལ་བོར་ཐོབ་ཅུང་ཟད་ཀྱང་མི་བྱེད་པས་ཏེ་མི་བྱེད་ན་སྒོམ་སྤང་གི་གཉེན་པོར་ཉེ་བར་དགོད་པར་མི་བྱ་བ་དེ་ཁོ་ན་འོ་ཞེ་ན།",
    "སྣང་ཚོད་དུ་ཉམས་འཕེལ་བྱེད་པར་བསྟན།་",
    "གང་གིས་ན།",
    "གང་གིས་ན་དོན་དམ་པར་ཉམས་འཕེལ་གྱི་ཁྱད་པར་བྱར་མེད་པའི་དེ་བཞིན་ཉིད་ཀྱི་མཚན་ཉིད་ཅན་གྱི་སྒོམ་ལམ་འདིས་སོ།",
    "ཀུན་རྫོབ་དེའི་ཚེ་སྤང་གཉེན་ཉམས་འཕེལ་སྦྱར་བ་ཡོད་པ་ཉིད་ཡིན་པའི་ཕྱིར་སྒོམ་ལམ་སྒོམ་སྤང་དགུའི་གཉེན་པོར་མི་དགོད་པར་ཐལ་བའི་ཉེས་པ་མེད་དོ་ཞེས་སྔར་བདེན་གཉིས་ཀྱིས་ལན་བཏབ་པའི་དོན་བསྡུས་སོ།",
    "ཐལ་བ་དགོད་པ་དང་།",
    "དེའི་སྐད་ཅིག་རེ་རེ་བའམ་དུ་མས་བསྐྱེད་བརྟག་གྲང་།",
    "གཞན་ཡང་སྔ་མ་གཅིག་པུས་སྐྱེད་ན་ཕྱི་མ་རྣམས་དོན་མེད་པར་ཐལ་ལོ།",
    "དེ་མེད་པར་ཡང་དེ་ལ་རེག་པར་ནུས་མ་ཡིན།",
    "གཉིས་པ་ནི་སེམས་བསྐྱེད་སྔ་ཕྱི་རེ་རེས་མི་འཐོབ་ཀྱང་རིམ་གྱིས་འཐོབ་པའི་དཔེ་དོན་དེ་མི་འགལ་བར་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "དེ་གཉིས་ཀྱི་རང་རང་གི་རིགས་འདྲ་སྔ་མའི་ཉེར་ལེན་དང་ལག་པའི་རྩོལ་བ་སོགས་ཀྱི་ལྷན་ཅིག་བྱེད་རྐྱེན་གྱི་རྒྱུས་དེ་གཉིས་ཕན་ཚུན་གྱི་སྒོ་ནས་དུས་མཉམ་དུ་ཕྲད་པ་བསྐྱེད་པས་ཏེ་བསྐྱེད་པ་ཙམ་བྱས་ཀྱི་སྲེག་པའི་ནུས་པ་ཁྱད་པར་ཅན་དུ་མ་བྱས་པའི་ཕྱིར་ཞེས་པ་ནི་རྟགས་སོ།",
    "སྐད་ཅིག་དང་པོ་མེད་པར་འབྱུང་ན་རྟག་ཏུ་སྟེ་ཡུལ་དུས་རང་བཞིན་ཐམས་ཅད་དུ་ཡོད་པ་དང་སོགས་པས་གཏན་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དངོས་པོ་རྣམས་ནི་རེས་འགའ་ཞིག།",
    "དེ་ལྟར་ཐལ་བ་ལས་རེས་འགའ་བར་མཐོང་བའི་ཕྱིར་རྒྱུ་ཡོད་ལ་དེ་ཡང་སྐད་ཅིག་དང་པོའོ།",
    "གང་གི་ངོ་བོར་ན་མ་བརྟགས་གཅིག་པུར་ཉམས་དགའ་བ་ཀུན་རྫོབ་པ་ཉིད་དུའོ།",
    "གང་གི་ཚེ་སྡོང་བུ་སྲེག་པ་ལ་མཐུ་ཕུལ་དུ་ཕྱིན་པ་དང་ལྡན་པའི་ནུས་པ་ཁྱད་པར་ཅན་གྱི་སྐད་ཅིག་གཉིས་པ་དང་སོགས་པས་གསུམ་པ་སོགས་ཡོད་ན་སྟེ་ཡོད་པ་དེའི་ཚེའོ།",
    "ནུས་ལྡན་དུ་གང་གིས་བྱས་ན།",
    "དཔེར་ན་མེས་བསྲེག་ལ་ཆུས་མིན་པ་ཅི་ཞེས་འདྲི་བ་ལ་དེ་རང་རང་གི་རྒྱུ་ལས་དེ་ལྟར་སྐྱེས་པས་སོ་ཞེས་སྨྲས་པ་ན་རང་རྒྱུ་ལས་དེ་ལྟར་སྐྱེ་བ་ཅི་ཞེས་རྒོལ་བ་དང་མཚུངས་ཏེ།",
    "གལ་ཏེ་སྒྲོན་མེ་ཕྱི་མ་སྐྱེས་པའི་ཚེ་སྔ་མ་རྣམས་མི་གནས་པས་གཉིས་པ་སོགས་དང་དང་པོ་རྣམས་ཟླ་མེད་ཀྱི་རེ་རེ་བར་མཚུངས་པའི་ཕྱིར་ཕྱི་མ་རྣམས་ཀྱིས་ཀྱང་མི་ནུས་ཤེས་ན།",
    "ཟབ་མོ་བརྒྱད་མཚོན་ཚུལ་ལ།",
    "ཁ་ཅིག་ན་རེ་ཟབ་མོ་དང་པོ་མཚོན་པ་ལ་བརྒྱད་ཀྱི་མིང་བཏགས་ཏེ་དཔེར་ན་དབྱུག་ཐོགས་གཅིག་དང་སྐྱེས་བུ་བརྒྱད་འགྲོ་བ་ན་ཕྱི་མ་རྣམས་ལ་དབྱུག་པ་མེད་ཀྱང་དབྱུག་ཐོགས་འགྲོ་ཞེས་པ་བཞིན་ནོ་ཞེས་ཟེར་བ་ནི་མི་འཐད་དེ།",
    "ཟབ་མོ་བརྒྱད་ཀྱང་བདེན་གཉིས་ཀྱི་སྒོ་ནས་ཟབ་པ་ཡིན་ལ།",
    "གསུམ་པ་ལ་གཉིས་ཟབ་མོའི་ངོ་བོ།",
    "སྒོམ་ལམ་པ་ཕྱིར་མི་ལྡོག་གི་རྟགས་ཡིན་ཏེ།",
    "མཐའ་བཅད་པ་དང་ཚིག་གི་དོན་ནོ།",
    "འདི་ལྟ་སྟེ་ཀུན་ནས་ཉོན་མོངས་པའི་རྣམ་པར་རྟོག་པ་སྤང་བར་བྱ་བ་དང་།",
    "སོགས་པས་ལས་འབྲས་དོན་དམ་དུ་ཐལ་བ་དང་།",
    "ཚེ་དང་ལྡན་པ་རབ་འབྱོར་བྱང་ཆེན་གྱིས་རྨི་ལམ་དུ་ལས་གང་གི་བྱས་པའི་ལས་དེ་ལ་གསོག་པའམ་འབྲི་བར་འགྱུར་བ་ཡོད་དམ།",
    "དེ་ལ་སོགས་པ་ནི་རང་གི་ངོ་བོས་གསོག་པའོ།",
    "དེ་དག་གིས་ནི་ལས་དང་དེའི་འབྲས་བུའི་འབྲེལ་པ་རྣམས་ཀུན་རྫོབ་ཏུ་བརྡའ་ལས་བྱུང་བ་ཙམ་དུ་བསྟན་ཏོ།",
    "ཉིན་པར་སྲོག་བཅད་པ་དང་རྨི་ལམ་ན་སྲོག་བཅད་པ་དེ་ལ་འདི་སྙམ་དུ་དེ་བདག་གིས་བསོད་དོ་བདག་གིས་བསད་པ་ལེགས་སོ་ཞེས་སད་དེ་རྣམ་པར་རྟོག་ན་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ལས་དེ་ལ་ཁྱོད་ཇི་སྐད་ཟེར།",
    "ལས་དེ་ལ་ཁྱོད་ཇི་སྐད་སྨྲ་ཞེས་བྱ་བ་ནི་ཡང་དག་པ་དང་ཡང་དག་པ་མ་ཡིན་པའི་རང་བཞིན་ཡོངས་སུ་དྲིས་པས་གཉེན་པོ་འགལ་བ་ཡིན་ཀྱང་རྣམ་པར་རྟོག་པ་རྗེས་སུ་འཇུག་པར་ཐལ་བས་དེ་དོན་དམ་པ་ཉིད་དུ་ཡང་དག་པར་སྟོན་པའི་དོན་གྱིས་དེ་ལྟར་བརྩད་པ་ཡིན་ནོ།",
    "དོན་ནི་གོང་དུ་རྗེས་ཤེས་ཀྱིས་གསོས་པས་རྨི་ལམ་གྱི་ལས་བྲི་འཕེལ་ཡོད་པར་བསྟན་པ་ལ་འཕྲོས་ནས་ཉིན་པར་སྲོག་བཅད་པ་ཡང་དག་པའི་ལས་དང་རྨི་ལམ་དུ་སྲོག་བཅད་པ་ཡང་དག་མིན་པའི་ལས་ལ་ཁྱེད་ཅི་ཟེར་ཞེས་དྲིས་པས།",
    "ཤུགས་ལ་རྨི་ལམ་གྱི་ལས་ལ་གཉེན་པོ་འགལ་བ་སྟེ་རིགས་པ་ཡང་དག་གིས་གནོད་ཀྱང་དེ་དོན་དམ་དུ་ཡོད་པར་ཐལ།",
    "གསོས་ན་ལས་ཡོད་པར་བསྟན་པ་ལ་སླར་རང་གིས་དེ་ལྟར་རྩོད་པ་མ་འབྲེལ་ཞེ་ན།",
    "ཁྱོད་ཅི་ཟེར་ཞེས་བྱ་བ་ནི་བདེན་པ་དང་བདེན་པ་མ་ཡིན་པ་དྲིས་པ་ཡིན་ཏེ།",
    "སྔར་རྣམ་རྟོག་གིས་གསོས་འདེབས་ཡོད་པས་ལས་གསོག་འབྲི་ཡོད་པར་བསྟན་པ་དེའི་ལས་འབྲས་ཀྱི་འབྲེལ་བ་དོན་དམ་པ་ཉིད་དུ་སྟེ་ཇི་ལྟ་བ་བཞིན་བསྟན་པའི་ཕྱིར་ཡིན་ནོ།",
    "རྣམས་ཀྱིས་ནི་འདི་མ་ཐོན་པར་དེ་བཞིན་གཤེགས་པ་ལ་ལས་གསོག་པ་ཡོད་པར་ཐལ་བའི་རྩོད་ལན་འབའ་ཞིག་བྱེད་པ་ནི།",
    "བརྒྱད་སྟོང་པར་ནི་རྗེས་ཀྱི་ཡི་རང་གིས་གསོས་ན་རྨི་ལམ་གྱི་དགེ་སྡིག་ལ་སོགས་ཉེར་གསོག་ཡོད་པར་རབ་འབྱོར་གྱིས་སྨྲས་པ་ན།",
