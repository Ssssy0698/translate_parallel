    "དང་པོ་དགུ་གཞི་ཤེས་ཐ་མ་གཉིས་ལམ་ཤེས་དང་རྣམ་མཁྱེན་གྱི་བྱེད་པར་སྔོན་གྱི་མཁས་པ་དག་བཞེད་པ་ནི་ཉི་སྣང་གི་དགོངས་པ་རྒྱན་སྣང་དུ་བླངས་པ་ལྟར་ཡིན་པས་ལེགས་སོ།",
    "ཞེས་སོགས་ཀྱིས་གཟུགས་སོགས་ཀྱི་ཕ་རོལ་སྐྱེའགག་གི་དངོས་པོ་མེད་པ་དེ་ནི་ཀུན་རྫོབ་པའི་གཟུགས་སོགས་མ་ཡིན་པ་དང་དོན་དམ་པར་ན།",
    "མ་རིག་པའི་མུན་པ་ཟད་པ་ནི་སྲེད་པ་ལ་སོགས་པ་ཟད་པའི་ནང་དུ་འདུ་བས་ན་གླིང་གི་བྱེད་པ་ཉིད་ཡིན་ལ་ལོགས་ཤིག་ཏུ་བྱས་པ་ནི་ཡེ་ཤེས་ཀྱི་སྣང་བ་བཞི་ནི་མི་ཤེས་པ་ཟད་པ་ལ་གཙོ་བོ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བལྟ་བར་བྱའོ།",
    "གླིང་སྔ་མའི་ནང་དུ་འདུས་པས་གླིང་གི་བྱེད་པར་འཇོག་པ་དང་།",
    "རྟེན་གང་ཡིན་པ་དང་གང་གི་རྟེན་ཡིན་ན།",
    "བྱེད་མཚན་བཅུ་གཅིག་གིས་གཞན་དོན་ཕུན་ཚོགས་སྐྱེད་ནུས་སུ་ཤེས་པར་བྱས་པའི་སྦྱོར་བ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་གང་ཞེ་ན།",
    "ཉོན་མོངས་ཀྱིས་དབེན་པ་སོགས་བཅུ་དྲུག་གོ།",
    "སྦྱོར་བའི་ངོ་བོ་ཉིད་བཅུ་དྲུག་གི་བདག་ཉིད་ཀྱིས་སྦྱོར་བ་གསུམ་གྱི་ངོ་བོ་ཉིད་མཚོན་བྱེད་དོན་གཞན་ཡོད་པའི་མཚོན་བྱའམ་མཚན་གཞི་ལྟ་བུར་མཚོན་པས་ནའོ།",
    "ངོ་བོ་ཉིད་བཅུ་དྲུག་གིས་མཁྱེན་གསུམ་གྱི་སྦྱོར་བའི་ངོ་བོ་རང་ལས་གཞན་པའི་མཚན་ཉིད་མེད་ཀྱང་དེ་དང་ལྡན་པའི་མཚོན་བྱའམ་མཚན་གཞི་བཞིན་དུ་མཚོན་པས་དེ་ལྟར་ནའོ།",
    "དེ་ཡང་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པའི་ངོབོ་མངོན་གྱུར་བས་སྟོང་པ་ཉིད་ཀྱིས་ན་ཉོན་མོངས་ཀྱིས་ཏེ།",
    "བྱང་ཆེན་གང་ཡུམ་ཟབ་མོ་འདི་ལ་མོས་པར་འགྱུར་བ་དེ་དག་ནི་འདོད་ཆགས་དང་འདོད་ཆགས་མེད་པས་རྣམ་པར་དབེན་པའི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "བྱང་ཆེན་རྣམ་མཁྱེན་ལ་གཞོལ་བའི་བསམ་པས་ཡུམ་ཟབ་མོ་འདི་ལ་བརྟག་པར་བྱའོ།",
    "འཇིག་རྟེན་མངོན་ཞེན་ཅན་གྱི་སྒྲུབ་པའི་འཛིན་པ་སྟེ་འདི་ནི་བདག་ཉིད་གཟུང་བར་བྱའོ་ཞེས་ཡོངས་གཅོད་དུ་ཞེན་པ་དང་སོགས་པས་འདི་ནི་གཟུང་བྱ་མིན་ཞེས་རྣམ་བཅད་དུ་ཞེན་པ་ལས་བཟློག་སྟེ་གཟུགས་ནས་རྣམ་མཁྱེན་གྱི་བར་ཞེན་ནས་གཟུང་མི་གཟུང་གི་མཐའ་བྲལ་དུ་བསྟན་པའམ་རྟོགས་པ་ནི་མི་མཐུན་པ་སྟེ།",
    "ཇི་ལྟར་དེ་བཞིན་གཤེགས་པའི་དེ་བཞིན་ཉིད་མ་འོངས་པ་མ་སོང་བ་བཞིན་དུ་གནས་བརྟན་རབ་འབྱོར་གྱི་དེ་བཞིན་ཉིད་ཀྱང་མ་འོངས་མ་སོང་བ་སྟེ།",
    "དེ་ལ་གཟུགས་དང་གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ་གང་གི་ཚེ་གཟུགས་ཉིད་མི་དམིགས་པ་དེའི་ཚེ་གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་དམིགས་པར་ལྟ་ག་ལ་འགྱུར།",
    "སྤྱི་དང་ཡན་ལག་གི་དོན་ནོ།",
    "ཞེས་དང་ཀླུ་ཉི་ཁྲི་གཅིག་སྟོང་གིས་ཐེག་ཆེན་དུ་སེམས་བསྐྱེད་པར་གསུངས་པ་དང་།",
    "ཐོས་བསམས་ལས་བྱུང་ལས་གསུམ་མོ།",
    "དེས་ན་ངེས་འབྱུང་གི་བསམ་པས་བསླང་བའི་དགེ་རྩ་སྣ་རེ་ཙམ་རྒྱུད་ལ་སྐྱེས་ན་ཡང་ཚོགས་ཀྱི་ལམ་ཕྱོགས་རེ་ཐོབ་པ་ཡིན་ནོ།",
    "དེ་དག་དང་དེ་དག་ལས་གཞན་དང་དེ་དག་གི་དེ་བཞིན་ཉིད་དང་།",
    "ཉི་སྣང་གི་དགོངས་པས་ཐེག་ཆེན་ལ་བཞེད་དེ།་",
    "གང་ཟག་དེའི་སྒོམ་རིམ་མོ།",
    "གང་གི་ན།",
    "དེར་ནི་མཉམ་གཞག་གི་རྟོགས་པ་གཙོ་བོར་བྱས་པའི་དམིགས་རྣམ་ཡིན་ལ།",
    "དེ་ནས་སེམས་གསུམ་ནི་དྲོད་འབྲིང་གི་རྣམ་པ་སྟེ།",
    "སྲིང་མོའི།",
    "བུ་མོའི།",
    "གཉེན་དང་སྣག་གི་གཉེན་མཚམས་ཀྱི་སེམས་བསྐྱེད་པར་བྱའོ།",
    "སེམས་རེ་རེ་ཞིང་བསྐྱེད་པ་དང་།",
    "གཉིས་པ་རྩེ་མོར་གྱུར་པ་ལ་གསུམ་ལས།",
    "གཞན་ཡང་སྲོག་གཅོད་པ་ལས་ལྡོག་པ་དེ་དག་གི་ལེགས་པ་བརྗོད་ཅིང་མཐུན་པས་དགའ་བར་བྱ་སྟེ།",
    "སྦྱིན་སོགས་ཕྱིན་དྲུག་ལ་གནས་ནས་གང་ཟག་གཞན་སྦྱིན་སོགས་ལ་གནས་པ་དེ་དག་ལ་ནི་འགོད་སོགས་སྔར་བཞིན་འབྲིང་གི་རྣམ་པ་སྟེ།",
    "གཞན་བདེ་སྡུག་གི་རྒྱུ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་འཛིན་པ་སྤོང་འདོད་པའི་ཕྱིར་ཏེ།",
    "བདག་ཉིད་རྒྱུད་སོགས་ཀྱི་འབྲས་བུ་ཤེས་ཀྱང་མངོན་དུ་མི་བྱེད་པ་ལ་གནས་ནས་གཞན་དེ་ལ་སྔར་ལྟར་འགོད་སོགས་ནི་འབྲིང་གི་རྣམ་པ་སྟེ།་",
    "དེ་གཉིས་ནི་འོག་གི་སོགས་སྒྲས་བསྡུས་པའོ།",
    "རང་ཉིད་སེམས་དཔའི་མངོན་ཤེས་བསྐྱེད་པ་ལ་གནས་ནས་གཞན་དེ་ལ་སྔར་ལྟར་ནི་འབྲིང་གི་རྣམ་པ་སྟེ།",
    "བདག་གིས་ཀྱང་བྱང་སེམས་ཀྱི་མངོན་ཤེས་བསྐྱེད་པར་བྱ།",
    "རྣམ་པ་ནས་འདི་ལ་སྟེ་འདིར་ཆགས་སྡང་གི་རིས་སུ་ཆད་པ་མེད་པ་མཉམ་པའི་སེམས་དང་།",
    "སྐྱེས་པ་དང་བུད་མེད་རང་ལས་རྒན་པ་རྣམས་ལ་ཕ་མ་དང་།",
    "རང་དང་མཉམ་པ་ལ་སྤུན་དང་སྲིང་མོ་དང་།",
    "རང་བས་གཞོན་པ་ལ་བུ་དང་བུ་མོ་དང་ཕན་འདོགས་པའི་བཤེས་དང་།",
    "རྩེ་མོར་གྱུར་པ་ལ་འགོད་བྱེད་བྱང་སེམས་རང་དང་དགོད་བྱ་གདུལ་བྱ་གཞན་གྱི་དབྱེ་བས་དམིགས་པ་དང་རྣམ་པ་དག་ཇི་ལྟ་བ་དེ་བཞིན་དུ་བཟོད་པ་ལ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "མཐུན་པ་ཉིད་ཀྱི་རྣམ་པ་རྣམས་ཀྱིས་རྩེ་མོར་གྱུར་པ་ལ་རང་དང་གཞན་གྱི་རྟེན་གྱི་དབྱེ་བས་ད་མིགས་པ་དང་རྣམ་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་དམིགས་པ་ནི་བཟོད་པ་ཞེས་པའོ།",
    "དེ་ལྟར་ན་གངས་ཅན་པ་རྣམས་ཀྱིས་བདག་ཉིད་ཆེན་པོ་འདིའི་བཞེད་པ་རང་གིས་མ་གོ་བའི་བློ་ཡི་དྲི་མ་གཞན་ལ་འགེལ་བའོ།",
    "དགེ་སྡིག་ལས་ལྡོག་འཇུག་གཉིས་རྩེ་མོ་ཆུང་འབྲིང་དང་།",
    "འགྲེལ་པ་འདིར་ཆུང་འབྲིང་གསུམ་དང་སྦྱོར་བ་ལྷུར་མ་བླངས་པར་རྩ་ཚིག་གིས་ཟིན་ཚོད་བཀྲལ་ནས་བཞི་པོ་སྤྱི་ཙམ་ལ་སྦྱར་བ་དང་།",
    "མངོན་རྟོགས་དང་པོ་དྲུག་པོ་རེ་རེར་དངོས་ཤུགས་ཅི་རིགས་པར་སྦྱོར་མཐོང་སྒོམ་གསུམ་ལན་གསུམ་གསུམ་བསྟན་པ་རྣམས་ཟློས་ཏེ་བརྗོད་བྱ་ཁྱད་མེད་ཡང་ཡངབསྟན་པས་ཤེ་ན།",
    "དེས་ན་ལམ་གྱི་མིང་གིས་གསུངས་པའི་དོན་དེ་བསྟན་པ་ལྟར་ཡིན་མིན་དཔྱོད་པ་སྟེ།",
    "རྣམ་ཀུན་མངོན་རྫོགས་དང་སོགས་པས་རྩེ་མོ་དང་མཐར་གྱིས་པའི་མངོན་རྟོགས་གསུམ་གྱི་སྐབས་སུ་ལམ་གསུམ་གྱི་སྒྲས་གསུངས་པའི་དོན་གསུམ་ནི་བསྟན་པ་ལྟར་གྱི་ངེས་ཆ་སོགས་དངོས་མིན་ཀྱང་ངེས་ཆ་དང་སོགས་པས་མཐོང་སྒོམ་གྱི་ཐ་སྙད་དམ་མིང་ཙམ་དུ་གསུངས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "འོ་ན་མིང་དེ་དག་གིས་གདགས་པའི་གཞི།",
    "དེ་ལྟར་ན་སྦྱོར་བ་གསུམ་དུ་ལམ་གསུམ་གྱི་སྒྲས་གསུངས་པའི་དགོངས་གཞི་རང་གི་སྐབས་ཀྱི་སྦྱོར་བ་དེ་རྣམས་ཡིན་པས་དག་ས་གསུམ་རྣམ་ཀུན་སོགས་མཚན་ཉིད་པ་ཡིན་ཞིང་སྒྲས་ཟིན་ཚོད་ཀྱི་ལམ་གསུམ་བཏགས་པ་བའོ།",
    "རྩེ་མོའི་ལམ་རྣམས་ས་བརྒྱད་པ་ནས་འཇོག་སྟེ།",
    "དེ་ནི་ས་བཅུ་པའི་བར་གྱིས་ཐོབ་པར་གཞག་གོ་ཞེས་ཏེ་མཐར་གྱིས་པ་འདི་ནི་རྩེ་མོ་གང་ནས་གཞག་པ་དེའི་ཕྱི་ལོགས་ནས་གཟུང་ངོ།",
    "དེ་དག་གི་ངེས་ཆ་བཞི་ཤེས་པ་དང་ཤེས་པ་དེ་སྔོན་དུ་འགྲོ་བའི་འབྲས་བུ་འཇིག་རྟེན་ལས་འདས་པ་སྟེ་ཉན་ཐོས་སོགས་ཀྱིས་མ་རྟོགས་པའི་མཐོང་སྒོམ་དེ་དག་རྟོགས་པ་ནི་ཤེས་པ་ཡིན་ཏེ།",
    "ཆགས་སོགས་ཉོན་མོངས་ཀྱིས་སྟོང་བ་ཆུང་འབྲིང་ཆེ་གསུམ་ཅིག་ཅར་ཏེ་ཤེས་པ་གཅིག་ལ་སྐྱེ་བ་བསལ་བའི་ཕྱིར་ངེས་ཆ་སོགས་གསུམ་གྱིས་བསྟན་ཏེ།",
    "གསུམ་པ་ཤེར་འབྱུང་གི་ལུགས་ནི་མཁྱེན་གསུམ་དུ་ངེས་ཆ་སོགས་བརྗོད་ཟིན་པས་འདིར་ཡང་དེ་དག་བསྟན་པས་ཅི་བྱ།",
    "རིམ་པ་དེ་ཡང་རང་གི་ངོ་བོ་ཟག་མེད་ཀྱི་སྒོ་ནས་ཐ་དད་མེད་པས་དེ་དག་ཐ་དད་པར་ཤེས་པར་བྱ་བའི་ཕྱིར་ངེས་ཆ་ལ་སོགས་པ་གསུམ་དུ་བསྟན་ཏོ།",
    "དེས་ན་ལུང་དེ་དག་གིས་རྣམ་མཁྱེན་ཐོབ་བྱར་བསྟན་ནས་དེ་ཐོབ་པའི་ཐབས་རྣམས་ཀྱིས་མཚམས་དང་ཐོབ་པའི་དུས་ཀྱི་སྒོ་ནས་མངོན་རྟོགས་བདུན་གྱི་སྐྱེ་རིམ་བསྟན་ཏོ།",
    "ཁ་ཅིག་ན་རེ་རྒྱན་སྣང་དུ།",
    "ཞེས་བྱ་བ་ནི་ཁ་ཅིག་གིའོ་ཞེས་དང་།",
    "ས་བཅུ་པ་ལ་ཤིན་ཏུ་རྨོངས་པ་གཉིས་དང་དེའི་གནས་ངན་ལེན་སྤོང་བར་གསུངས་པས་དེ་དང་འབྲེལ་བ་རྩེ་མོའི་མངོན་རྟོགས་ལ་བག་ལ་ཉལ་སྤངས་པས་དེའི་འབྲས་བུ་གཟུང་འཛིན་གྱི་རྟོག་པ་རྣམས་ལྡོག་པའི་ཕྱིར་གཏན་ནས་སྤོང་ལ་ས་གཞན་དུ་ནི་རེས་འགའ་བའི་སྤོང་བ་ཡིན་པས་ཉེས་པ་མེད་པ་སྔོན་གྱི་སློབ་དཔོན་རྣམས་བཞེད་པར་གསུངས་པའི་ཕྱིར།",
    "ཁྱད་པར་དུ་འགྲེལ་ཆུང་འདིར་རང་གི་བཞེད་པ་ཉིད་འགོད་པ་དང་།",
    "སྔར་གྱི་དེ་དང་དེའི་མིང་གིས་བཏགས་པའི་གནས་སྐབས་སུ་མཛད་པ་ནི་སློབ་དཔོན་འདིའི་ཐུགས་རྩེ་གཏད་ས་རུ་སྣང་ཞིང་མངོན་རྟོགས་ཐ་མ་གཉིས་ནི་རིམ་པ་ལྟར་སློབ་ལམ་གྱི་རྣལ་འབྱོར་མཐར་ཐུག་པ་དང་བྱ་བ་ཆད་པའི་སྐབས་ཡིན་པས་སྔ་མ་ལས་ཕྱི་མ་ཁྱད་པར་ཅན་དུ་འགྲོ་བའི་ལམ་གྱི་རིམ་པ་མེད་པ་ལ་དགོངས་ནས་དེ་གསུམ་གྱི་ཟློས་སྤོང་མ་བྱས་སོ།",
    "དེ་གནོད་བྱེད་དུ་སོང་མ་སོང་བརྟག་པའོ།",
    "དེ་ཡང་དེ་ལྔ་རེ་རེ་ལ་སྦྱོར་དངོས་རྗེས་གསུམ་དུ་ཡོད་པའི་དངོས་གཞི་ལ་ཆུང་འབྲིང་ཆེན་པོ་ཤིན་ཏུ་ཆེ་བ་བཞི་བཞི་དང་།",
    "དེ་རེ་རེ་ལ་ཆུང་སོགས་གསུམ་གསུམ་སྟེ་བཅུ་གཉིས་སྦྱོར་མཇུག་གཉིས་དང་བཅུ་བཞི་སྟེ་བསྡོམས་པས་བདུན་ཅུའོ།",
    "རྩེ་མོའི་སྐབས་སུ་བསྟན་པའི་ཐར་ཆ་ཆུང་འབྲིང་གསུམ་པ་སྦྱོར་ལམ་བཅུ་གཉིས།",
    "མཐོང་ལམ་གྱི་སྦྱོར་བ་གཟུང་རྟོག་གི་གཉེན་པོ་གཉིས་དང་དངོས་གཞི་འཛིན་རྟོག་གི་གཉེན་པོ་གཉིས་སྟེ་བཞི།",
    "སྒོམ་ལམ་གྱི་སྦྱོར་བ་གཟུང་རྟོག་གི་གཉེན་པོ་གཉིས་དང་།",
    "དངོས་གཞི་འཛིན་རྟོག་གི་གཉེན་པོ་ཆེ་འབྲིང་དགུ་སྟེ་སུམ་ཅུས་བཏགས་ལ།་",
