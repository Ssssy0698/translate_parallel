    "འདིར་སྣང་གི་ཟས་ནོར་སོགས་ལ་བློ་ཞུགས་པའི་སྒྲུབ་འདུན་བྱུང་ན་བར་ཆད་དུ་ཤེས་པའི་སྒོ་ནས་ཞེན་པ་བཏང་།",
    "ནང་གི་གེགས་ནི།",
    "ལུས་སྦྱངས་དང་དྲང་སྲོང་གི་གསོ་དཔྱད་ལ་སོགས་པའི་བཅོས་བྱ་བའམ།",
    "ཡང་རྣམ་རྟོག་གི་གེགས་ཉོན་མོངས་པ་ལྔའི་རྟོག་པ་རྣམས་བྱུང་རྒྱལ་དུ་ཤོར་བ་དང་།",
    "དགེ་སྦྱོར་གྱི་ཡོན་ཏན་ཉམས་རྟོགས་ཕྲན་བུ་རེ་སྐྱེས་ཀྱང་།",
    "ལོ་ཟླ་རེར་སྒྲུབ་པ་བྱས་ནས་ཡོན་ཏན་ཞིག་ཨེ་ཡོང་རེ་བ་དེ་འདྲ་ལ་ནི།",
    "དེ་འདྲ་འདོད་ཐག་ཉེ་ལ་བརྩོན་འགྲུས་ཞན་པ་འདིར་སྣང་བློས་མི་ཐེངས་པ་ཞིག་མི་བྱེད་པར་སྒྲུབ་པ་སྙུགས་བསྲིང་ལ་བརྩོན་འགྲུས་ཆེ་བ་ཚེ་བློས་བཏང་ཞིག་གི་ཉམས་ལེན་ལ་འབད་དགོས་པ་ཡིན།",
    "འཁོར་འདས་ལ་བཟང་ངན་མེད་པ་མངོན་དུ་མ་གྱུར་གྱི་བར་དུ་ཞེན་འཛིན་གྱི་བདུད་རེ་རེ་ཡོད་འདུག་པ་སྟེ་དེས་ན་འཁོར་འདས་ཀྱི་རྩ་བ་འདུ་འཛི་འདིར་འདུག་པས།",
    "སྣང་བ་ལ་བརྟག་དཔྱད་འཛིན་པ་མེད་པ་དེ་ངོས་ནས་གང་ལྟར་གནས་ཇི་ལྟར་ཤར་ཅི་འདྲ་ཞིག་སྣང་ཡང་རང་ངོ་རང་ཤེས་དང་མ་བྲལ་བར་མ་ཡེངས་པའི་དྲན་པ་བསྟེན་པ་གལ་ཆེ་བ་དེ་ནི་སྒོམ་གྱི་རྩ་བ་ཡིན་མོད་དེ།",
    "བཟང་རྟོག་གི་བློ་ཡིས་མ་བཅོས་ཤིང་།",
    "ངན་རྟོག་གི་དྲི་མས་མ་གོས་པར།",
    "དེ་ལྟར་སེམས་ཉིད་ལྷན་སྐྱེས་ཀྱི་རང་ངོ་འཕྲོད་པ་དེས་ན་སྤངས་གཉེན་གཅིག་ཏུ་འདྲེས་ཏེ་རང་མདངས་སྣ་ཚོགས་རྟོག་པ་གང་ཤར་ཡང་གསལ་སྟོང་གི་ངོ་བོར་ཤར་ཤར་བ་དེའང་གཞི་མེད་རྩ་བྲལ་དུ་འཆར་ཞིང་གཞི་མེད་རྩ་བྲལ་དུ་གྲོལ་བས་རྣམ་རྟོག་རང་ལ་སྒོམ་གྱི་དངོས་གཞི་འོང་ཞིང་གཤིས་མདངས་ཀྱི་རྩིས་གདབ་མ་དགོས་པ་ཞིག་ཡོང་སྟེ།",
    "དེ་ལ་སྒོམ་ཆེན་པ་འགའ་ཞིག་གིས་ནི།",
    "ཚོགས་དྲུག་གི་སྣང་བ་ཕྲ་རགས་ཐམས་ཅད་འགགས་པའི་ཤེས་པ་རྟོག་མེད་ཁོ་ན་ལ་སྒོམ་དུ་འཛིན་ཏེ།",
    "འགའ་ཞིག་གིས་ནི་དྲན་རིག་གིས་མ་ཟིན་པའི་གཏི་མུག་ལུང་མ་བསྟན་ལ་སྒོམ་བརྟན་པོར་རློམ་པ་དེ་ནི་བླུན་སྒོམ་རྨོངས་པར་གོལ།",
    "འགའ་ཞིག་གིས་སེམས་གསལ་སིང་ངེ་བ་དང་།",
    "ཁ་ཅིག་གིས་ནི།",
    "སེམས་ཀྱི་གནས་ལུགས་གོ་རྟོག་གི་ཡུལ་ལས་འདས་པས་བློ་རྟོག་གིས་རྟོགས་པའི་གོ་དོན་ཞིག་ཡིད་ལ་བྱེད་ཅིང་སེམས་ནའང་ཅུང་ཟད་ཡེངས།",
    "བློ་རྟོག་གིས་ཤེས་ཤིང་རིག་པའི་དོན་ཞིག་ཡིད་ལ་བྱེད་ཀྱང་དོན་ཐོག་ནས་ཅུང་ཟད་ཡེངས།",
    "སེམས་དོན་བསམ་གཞིག་གི་ཡུལ་མིན་པས།",
    "བློ་རྟོག་གིས་བསམ་གཞིག་བྱས་ཤིང་དཔྱད་པས་སྟོང་པ་དང་སྐྱེ་མེད་སོགས་ཡིད་ལ་བྱེད་ཀྱང་དོན་ཐོག་ནས་ཅུང་ཟད་ཡེངས།",
    "སེམས་དོན་དམིགས་གཏད་ཀྱི་ཡུལ་མིན་པས་བློ་རྟོག་གིས་ཆེད་དུ་དམིགས་པ་གཏད་པས་བདེ་གསལ་མི་རྟོག་པ་ལ་སོགས་ཀྱི་སྣང་བ་ལ་སེམས་གཏད་ཀྱང་དོན་ཐོག་ནས་ཅུང་ཟད་ཡེངས།",
    "དོན་འཕྲལ་དུ་མཉམ་བཞག་རྐྱེན་མེད་དགྲ་མེད་རང་ལ་སྡོད་དུས་དགའ་མོ་ཡོད་ནའང་དེ་ནས་སྣང་ཐོག་དང་མ་བསྲེས་ན་མིག་ཡུལ་དུ་སྣང་བའི་ཚོགས་ལེགས་མི་ལེགས་ཏེ།",
    "ལེགས་ཉེས་ཆགས་སྡང་གི་འཛིན་པ་ཤོར་ཡོང་བ་ཡིན།",
    "དེ་ཤོར་ན་མི་ཉན་ཞིང་དེར་ཡང་འགའ་རེ་ལ་ནི།",
    "མིག་གི་ཡུལ་དུ་གཟུགས་སྣ་ཚོགས་ལེགས་ཉེས་ཅི་ལྟར་སྣང་ཡང་།",
    "གལ་སྲིད་ཡུལ་ལྔ་དེར་ཡང་ལེགས་ཉེས་ཆགས་སྡང་གི་རྣམ་རྟོག་ཤར་ན་ནི་རྣམ་རྟོག་དེའང་ངོས་བཟུང་སྟེ་རང་ངོ་སྐྱོང་དགོས།",
    "སྤྱིར་གྱིས་རང་གི་མི་ཚེ་འདིར་དུས་ཐམས་ཅད་དུ་ཆགས་སྡང་གི་འཁོར་ལོ་ཡིན་པར་མ་ཟད།",
    "ཁྱད་པར་རང་རེ་གཤིས་ངན་པའི་རིགས་ཁ་ཅིག་འདི་ནི་དུས་ཐམས་ཅད་དུ་ཞེ་སྡང་ཁོང་ཁྲོ་གདུག་སེམས་དམོད་མོ་རང་གི་རང་བཞིན་ཏེ།",
    "རང་རེ་ཞེ་སྡང་སོགས་དུག་ལྔའི་རྣམ་རྟོག་འདིར་གོམས་འདྲིས་ཆེ།",
    "དེ་ལ་ཞེ་སྡང་དམོད་མོ་ས་ཟད་ཡུལ་ཤོར་ཟེར་བ་དང་།",
    "དེ་མིན་ད་ལྟའང་རང་ལ་གལ་ཆེ་བའི་ཉེར་མཁོ་ཟས་ནོར་མཐུན་རྐྱེན་གྱི་རིགས་ལའང་དོན་མེད་ཀྱང་ཞེ་སྡང་གསོག་ཅིང་དམོད་མོ་བྱེད་པ་སྟེ།",
    "འདི་རིགས་ལ་བསམ་ན་རང་རེ་རྣམས་ཀྱི་སེམས་འདིར་མི་གནོད་པ་ཅིའང་མེད་ལ།",
    "ཕྱི་ནང་ཐམས་ཅད་ཞེ་སྡང་གདུག་རྩུབ་ཀྱི་རང་བཞིན་སྨྲ་བ་ཐམས་ཅད་ངན་སྨྲས་ཚིག་རྩུབ་དམོད་མོའི་རང་བཞིན་བྱེད་པ་ནི།",
    "དེར་མ་ཟད་སྣང་བ་དགྲར་ལངས་ཞེས་པ་སྣང་བར་ཞེ་སྡང་ཕྲན་བུ་རེ་སྐྱེས་ཀྱང་དེ་ལ་རྣམ་སྨིན་ཡོད་པ་ནི།",
    "རང་ལག་མགོ་ན་བ་དེ་བཞིན་སྣང་བ་ལ་ཞེ་སྡང་དམོད་མོ་བྱས་པས་སྣང་བ་ལ་མི་གནོད་དེ།",
    "ནམ་ཕྱེད་ཡོལ་ཙམ་ནས་མགར་བ་གཅིག་གིས་ཐོ་བ་ཏོག་པ་ཞིག་བྱས་པ་དེ་ནས་བཟུང་ཐམས་ཅད་ལངས་ཏེ་ཐོ་བའི་སྒྲ་ཆེན་པོ་མང་པོ་དེ་ལ་ཐུགས་མ་བདེ་ནས་དང་པོ་ཞེ་སྡང་གི་རྣམ་པར་ལངས་ཀྱང་སྐད་ཅིག་མ་དེ་ལ་ཞེ་སྡང་གི་རྟོག་པ་ངོས་བཟུང་རྩད་བཅད་ཐོ་བའི་སྒྲ་ཐོག་ཏུ་མཉམ་པར་བཞག་མཛད་པས།",
    "དཔེ་དེ་བཞིན་ངེད་རང་གིས་མཉམ་བཞག་སྐྱོང་དུས་ཀྱང་དེ་ལ་གནོད་པའི་མི་ལ་སོགས་པས་འགྲོ་འདུག་ལས་ཀ་མང་པོ།",
    "ཡུལ་སྣང་དང་ཁྱད་པར་ཞེ་སྡང་གི་རྣམ་རྟོག་གིས་བློ་ཡུལ་མ་བདེ་ན་མ་བདེ་བ་དེ་ངོས་བཟུང་རང་ངོ་དེ་ཉིད་ཤེས་བཞིན་མ་བཅོས་པར་སྐྱོང་ཤེས་དགོས་ཏེ།",
    "སྣང་བ་འདི་ཐམས་ཅད་རང་གི་སེམས་ཡིན།",
    "ཆུ་ནང་གི་ཟླ་བ་ལྟ་བུ་ཡིན་པས་འཛིན་པ་མེད་པར་ཕྱེད་དེ་ཞོག།",
    "ངེད་རང་འགའ་རེར་སེམས་གནས་ཐོག་ཏུ་སྐྱོང་བདེ་ཙམ་ཞིག་ཡོད་ན་དེ་ནས་རྣམ་རྟོག་འཕྲོ་རྒོད་མང་དུ་བྱུང་ན་མི་བདེ་བའི་སྣང་བ་དང་།",
    "དང་པོ་དཔེ་སྣ་ཚོགས་ཞུས་མོད།",
    "གང་བྱུང་གིས་ཆོག་ཤེས་དང་།",
    "གང་གིས་སྐྱེ་བོ་འཆིང་འགྱུར་བ།",
    "དེ་འཕྲལ་དུ་ཉམས་རྟོགས་སྐྱེས་ནས་སྒྲིབ་པ་དག་པས་ཡིན་བཞིན་ངོ་ཤེས་ཙམ་མ་གཏོགས་གཞན་རྟོགས་པས་སླར་གསལ་སྟོང་དབྱེར་མེད་དུ་སོང་བ་མིན།",
    "འོན་ཀྱང་རང་རེ་ད་ལྟ་ལས་ངན་བག་ཆགས་ཀྱིས་བསྒྲིབས་ནས་ངོ་མ་ཤེས་པ་ཡིན་པར་འདུག་མ་གཏོགས།",
    "རྣམ་རྟོག་གི་རང་བཞིན་ཤེས་གྱུར་ན།",
    "དེ་ནས་རང་གིས་ཀྱང་སྒོམ་ལེགས་པར་སྐྱེས་བསམ་ཞིང་ང་རྒྱལ་རློམ་སེམས་ཀྱང་ཡོང་ཉེན་ཡོད།",
    "དེ་བས་ངའི་གཏུམ་མོ་ཉམས་སུ་ལོངས་ཞེས་གསུངས་ཤིང་།",
    "ད་གཟོད་རྟོགས་པའི་ཡེ་ཤེས་གཞི་ནས་འཆར་ཞིང་དེ་དུས་མི་རྒན་ང་ལའང་ད་ལྟའི་མོས་གུས་འདི་མིན་པ་ཞིག་འཆར་གསུངས་པ་དེ་ཚོ་ངེས་པར་བྱས་ནས།",
    "རང་ངོ་སྐྱོང་ཞིང་སླར་མོས་གུས་སོགས་ལ་ནན་ཏན་བྱེད་དགོས་ཏེ།",
    "ལྟ་སྤྱོད་ལོག་པར་འགྲོ་བ་ཞིག་ཡོང་ཚོད་རེད།",
    "བཀའ་བརྒྱུད་གོང་མ་ཐམས་ཅད་ཀྱིས་ནག་པོ་ཁ་འབྱམས་ཀྱི་ལྟ་བ་ཞེས་གསུངས་པ་དེ་འདྲར་མ་སོང་བའི་ངེད་རང་གིས་ཡིན་ལུགས་ཡིན་བཞིན་འདི་ལྟར་ཉམས་སུ་ལེན་ཏེ།",
    "རྗེ་རྒྱལ་མཚན་དཔལ་བཟང་གིས།",
