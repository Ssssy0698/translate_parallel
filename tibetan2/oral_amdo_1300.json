    "གང་གི་ཚེ་རྟོག་པ་དང་དཔྱོད་པ་དང་བྲལ་བ་དེའི་ཚེ་བསམ་གཏན་དང་པོའི་སྲེད་པ་དང་བྲལ་བར་གྱུར་ནས་དགའ་བ་དང་བདེ་བ་དང་ནང་ཡོངས་སུ་དྭངས་པ་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་གཉིས་པ་ཞེས་བྱའོ།",
    "གང་གི་ཚེ་བསམ་གཏན་གཉིས་པའི་སྲེད་པ་དང་བྲལ་བར་གྱུར་ཏེ།",
    "གང་གི་ཚེ་བསམ་གཏན་གསུམ་པའི་སྲེད་པ་དང་བྲལ་ཏེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁམས་གསུམ་པོ་འདི་དག་ནི་སེམས་ཙམ་མོ།",
    "ཞེས་གསུངས་པས་ངེད་རང་གིས་དེར་བསམ།",
    "སྤྱིར་རང་རེས་སེམས་འདི་ཀ་མ་ཡེངས་པའི་གཞི་བཟུང་ནས་གང་ཤར་ཐམས་ཅད་ཁོ་རང་གི་རང་མདངས་སམ་སྤྲུལ་པར་ཐག་བཅད།",
    "ཧ་རེ་ལོང་དུ་སོང་འདུག་པ།",
    "འཁྲུལ་པ་ཡང་འཁྲུལ་ཉིང་འཁྲུལ་ཆེན་པོར་འབྱམས་པ་ཡིན་མོད།",
    "གཞི་དེ་ལྟར་གནས་པ་དེས་ན་འཕྲལ་དུ་ངེད་རང་གི་སེམས་གནས་ཀྱང་ཆོག་འགྱུས་ཀྱང་ཆོག་རིག་ཀྱང་ཆོག་གསལ་ཡང་ཆོག་དྲན་ཀྱང་ཆོག་ཡག་ཀྱང་ཆོག་ཐམས་ཅད་སེམས་ཀྱི་རོལ་པ་ལས་མི་འདའ་བས་དེ་ལྟར་གོ་བས་སྐྱོང་ལུགས་རང་སེམས་ཀྱི་གཤིས་གསལ་མི་གསལ།",
    "སེམས་གསལ་སྟོང་བདེ་མོ་གནས་གནས་ཤིག་ཏུ་མི་རེ་བར་སེམས་ཀྱི་རང་ངོ་མ་ཡེངས་ཙམ་འདི་ཀ་སྒོམ་གྱི་ངོ་ཐི་བཅོལ་ལ་བཞག།",
    "མ་ཡེངས་ཙམ་དེ་ཀར་ཐལ་ལེར་གང་ཤར་གྱི་རྣམ་རྟོག་ངོས་བཟུང་ལ་རང་ངོ་དེ་ཐོག་ཏུ་བཞག།",
    "འོ་ན་སྐྱེ་མེད་དུ་ངེས་པ་ཁོ་ནས་ཆོག་མོད།",
    "དེ་གང་ལ་ཟེར་ན་རང་གི་སེམས་ཀྱི་ངོ་བོ་ལ་ཟེར།",
    "ཡོད་པ་མ་ཡིན་ཏེ་ངོས་གཟུང་རྒྱུ་སྐྲའི་རྩེ་མོ་བརྒྱར་གཤག་པ་ཙམ་ཡང་མེད།",
    "རང་རིག་རང་གསལ་གྱི་ངོ་བོ་མཐོང་ངོ་ཤེས་ན་གཤིས་ཅིར་ཡང་མ་གྲུབ་པ་ཞེས་བློ་འདས་ཀྱི་ངོ་བོ་མདངས་གང་དུའང་མི་འགགས་པ་ཞེས་སྣ་ཚོགས་རང་ཤར་དུ་ཡོད་པ་དེ་དག་ཀྱང་ཟུང་འཇུག་ཀློང་དུ་གནས་ཤར་ཐིམ་པ་དེ་ལྟར་སོང་བའོ།",
    "འདི་དག་རེ་རེ་ལའང་ཡེ་ཤོར་དང་འཕྲལ་ཤོར་གཉིས་སུ་དབྱེ་བས་ཤོར་ས་བཞི་འདིར་ནང་ཚན་དུ་དབྱེ་ན་བརྒྱད་དོ།",
    "དགེ་སྡིག་གི་རྒྱུ་འབྲས་ཆེད་དུ་གསོད་པའམ།",
    "དེའི་ཚུལ་གཞན་ལའང་འཆད་ཤེས་ཀྱང་སེམས་རྒྱུད་དང་མ་འདྲེས་པས་དེ་ཉིད་གཞན་ཞིག་ན་ཡོད་པ་ལྟར་སོང་ནས།",
    "གནས་ལུགས་དེ་ཉིད་རང་གི་རིག་ཐོག་ཏུ་ངོ་མ་འཕྲོད་ཅིང་ཉམས་མྱོང་གི་ཐོག་ཏུ་མ་ཁེལ་བས་བློ་སྲ་ཁྲིག་གེར་སྡོད་པ་དེའོ།",
    "དེ་ནི་རེ་དང་དོགས་པའི་གཉེན་པོས་འཆིང་མི་དགོས།",
    "དེ་མིན་པ་ཞིག་གམ་དེ་བས་ལྷག་པ་ཞིག་ཡོད་དུ་རེ་ནས་ཐ་མལ་གྱི་ཤེས་པས་བློ་མི་ཚིམས་པར་གཞན་དུ་འཚོལ་བའམ།",
    "དེ་འདྲར་མ་སོང་བར་ཞེ་འདོད་ཀྱི་བཟོ་འཕྲོ་བཅད་པས་ཆ་མེད་དུ་ཡེངས་མ་ཤོར་བའི་གནས་ལུགས་རང་གཤིས་དེ་ལ་བློས་སྒོམ་གྱི་ལྷན་པོ་གདབ་མི་དགོས་ཏེ།",
    "དེར་ནི་ཆེད་དུ་ཉོན་མོངས་དང་རྣམ་རྟོག་སྤངས་ནས་མི་བསྒོམ།",
    "ཉོན་མོངས་ཡེ་ཤེས་ཆེན་པོ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་རྐྱེན་སྣང་གི་འཆར་སྒོ་སོགས་གང་ཤར་ཐམས་ཅད་རང་ངོ་ཤེས་པའི་ཡང་དག་གི་དྲན་པ་བསྟེན་མི་ཤེས་པར།",
    "ད་ནི་རང་གི་འདུས་མ་བྱས་ཟབ་མོ་སྟོང་པ་ཉིད་ཀྱི་དོན་བསྒོམས་པས་འཁོར་གསུམ་ཡང་དག་གི་དབྱིངས་ལ་འཇུག་པར་བྱེད་བསམ་པ་དང་།",
    "འཁོར་གསུམ་ཡང་དག་གི་ཤེས་རབ་ཀྱིས་ཟིན་ན་རང་བཞིན་མ་གྲུབ་པར་བྱས་ཀྱང་རུང་སྟེ།",
    "གང་གིས་དེ་ཉིད་མངོན་རྟོགས་ན།",
    "ངོས་ཟིན་ཐོག་གི་ངོ་བོ་མ་བརྗེད་པར་སྐྱོང་དགོས་ཏེ།",
    "སྔོན་དུ་ཡེངས་ནས་མ་ཉན་སླར་བསྒོམ་དགོས་སྙམ་དུ་རྣམ་རྟོག་གི་འཕྲོ་སྒོམ་གྱིས་གཅོད་པ་ལྟ་བུ་ནི་བློ་ཆུང་རྒྱས་འདེབས་སུ་ཤོར་བའོ།",
    "སྒོམ་དང་སྒོམ་མིན་དུམ་བུར་མི་གཅོད་པར་གང་བྱུང་གི་སྒོམ་གོ་བཅད་ནས་བསྐྱང་དགོས་ཏེ།",
    "མཐོང་དང་ཐོས་དང་དྲན་དང་རེག་པ་དང་།",
    "སེམས་སུ་ཤེས་ན་གཅིག་གིས་ལས་མི་བསྐྱེད།",
    "བདག་འཛིན་དངོས་སུ་ཞི་ཐབས་བདག་མེད་བསྒོམ་དགོས་ཟེར་བའི་སྒོམ་སྒྲུབ་པ་འགའ་ཞིག་གིས་ཀྱང་།",
    "ནང་དུ་བདག་འཛིན་དང་ཕྱི་རོལ་དུ་བདག་གི་བའི་འཛིན་པ་ཟད་ན།",
    "བདག་དང་བདག་གིར་གཉིས་ཟད་ན།",
    "ལས་དང་ཉོན་མོངས་ཟད་པས་ཐར།",
    "དེ་དག་གི་ཚུལ་རྣམས་ཞིབ་ཏུ་བློ་ལ་ངེས་པར་བྱས་ལ།",
    "རྣལ་འབྱོར་བཞི་ལ་སོགས་པ་སོ་སོའི་གནས་སྐབས་སུ་རང་རང་གི་དགེ་སྦྱོར་དེའི་ཐོག་ནས་མ་ཡེངས་ཙམ་གྱི་ཐོག་ཏུ་འཛིན་པ་མ་ཞུགས་པ་ཞིག་རྣམ་པ་ཀུན་ཏུ་གལ་ཆེ་བ་ཤེས་པར་གྱིས་ཤིག།",
    "གཞན་མཚན་མར་འཛིན་པར་གཉེན་པོ་ཡང་དག་གི་དྲན་པ་བསྟེན།",
    "དེའང་ཉམས་སུ་ལེན་པའི་གང་ཟག་གི་བློ་རིགས་སྤྱིར་བཏང་ལ་གསུངས་ཀྱིས།",
    "ཡ་བྲལ་བ་དང་རེ་རེའི་མཐར་ལྷུང་བའི་ལྟ་སྒོམ་སྤྱོད་པ་ཕྱོགས་ཞེན་ཅན་ཐམས་ཅད་སྤངས་དགོས་པར་གསུངས་སོ།",
    "བསྒོམས་ཀྱང་བོགས་མེད་ན་དངོས་པོ་ལ་མཚན་མར་ཞེན་ནས་ཐབས་རྐྱང་པར་སོང་བའི་རྟགས་ཡིན་པས།",
    "ཡེངས་མེད་མཉམ་བཞག་གི་དྲན་པ་བསྟེན།",
    "གཏུམ་མོ་སོགས་བསྒོམས་ནས་བདེ་བའི་རྣལ་འབྱོར་དང་།",
    "ང་བདག་གི་མགོ་བོ་གནོན།",
    "བློ་ཉེས་ན་འདི་ཕྱི་ཚེ་རབས་ཀུན་ཏུ་མི་ཡོང་བར་འདུག་པས་དེ་འདྲར་མ་སོང་བར་རེམ་དགོས་པའོ།",
    "མོས་གུས་སྒོམ་གྱི་མགོ་བོ།",
    "ཞེན་ལོག་མོས་གུས་དྲན་པ་གསུམ་ལ་དྲིལ་བ་གལ་དུ་ཆེ་བ་ལས།",
    "མོས་གུས་སྒོམ་གྱི་མགོ་བོ་ནི།",
    "དཀར་གང་གི་ཚོད་མ་བཞིན་དུ་ཤེས་རྒྱུད་ལ་མི་ཕན་པས།",
    "མོས་གུས་ཀྱིས་གྲོལ་བ་ཤ་སྟག་ཡིན་ཏེ།",
    "རྣམ་རྟོག་དང་ཉོན་མོངས་མ་གྲོལ་བ་གྲོལ་བར་བྱེད་པའང་ཡིན་པས་ནན་ཏན་བསྐྱེད་པར་བྱའོ།",
    "བདག་གིས་དེ་སྐད་འདོམས་པར་བྱེད།",
    "ཉོན་མོངས་པ་ལ་དགའ་བའི་སེམས་སེལ་བ་དང་།",
    "རྗེ་ཕག་མོ་གྲུ་པས།",
    "བདུད་བཞིའི་རྐུན་མས་བསྐོར་རེ་རན།",
    "རྟོགས་པའི་ངོ་བོ་བརྟན་ནས་བརྗེད་པ་མེད་པའི་དྲན་པ་ཡུག་གཅིག་ལྟ་བུ་འོང་ན་དེར་ནི་དྲན་པ་ཞེས་ཆེད་དུ་བློས་བསྒོམ་མི་དགོས་མོད།",
    "སྒོམ་གྱི་བོགས་འདོན་མོས་གུས་ལ་འཆོལ།",
    "དང་པོ་སྒོམ་གྱི་བོགས་འདོན་མོས་གུས་ལ་འཆོལ་གསུངས་པ་དེ་ཉིད།",
    "རང་གིས་དེ་ལ་མོས་གུས་ཚུད།",
    "མོས་གུས་དེའང་།",
    "མོས་གུས་རྩེ་གཅིག་པས་གསོལ་བ་ལེགས་པར་འདེབས།",
    "རང་གི་སེམས་དང་གཉིས་མེད་དུ་མཉམ་པར་བཞག་སྟེ་ཉམས་ལེན་གྱི་ངོ་བོ་སྐྱོང་།",
    "དེ་ཡང་སྤྱིར་དྲན་ཚད་ཐུགས་སུ་འཁྱེར་པའི་མོས་གུས་ཟེར་བ་ཡོད་ཀྱང་དེ་སེམས་ཀྱི་ངོ་བོ་མ་འཕྲོད་པ་ཚོས་ཆེད་དུ་བློས་སྒོམ།",
    "ཁྱབ་གདལ་ཆེན་པོའི་མོས་གུས་འབྱོངས་ཞེས་བྱ་བའི་ལེགས་པོ་ཞིག་འོང་བ་ཡིན།",
    "དེ་བས་ང་རང་གི་རྦད་ལ་འདི་ལྟར་ཡིན།",
    "དམ་པས་དེ་བཞིན་གཤེགས་པ་རྒྱ་མཚོ་ལྟ་བུའི་ཞལ་གཟིགས་སམ་ཞུས་པར།",
    "མཐོང་ན་དགའ་བསམ་པ་དེ་ཀ་རང་གིས་མ་མཐོང་བ་ཡིན་གསུངས་པ་དེ་ལྟར་ཡོང་བ་ཡིན་འདུག།",
    "མོས་གུས་དག་པ་རབ་འབྱམས་དེ་ལས་འགལ་འགྲོ།",
    "དེའང་ཉམས་རྟོགས་མ་ཤར་བ་ཚོས་ནི་ད་དུང་ཉམས་རྟོགས་འཆར་དུ་རེ་བས་ནམ་ཡང་དྲན་པའི་འདུན་པ་རྩེ་གཅིག་དང་མི་འབྲལ་བར་བྱེད་དགོས།",
    "དོན་དུ་སེམས་བདེ་བ་དང་མི་བདེ་བ་གཉིས་ཀ་རང་གི་ཉམས་ཙམ་དུ་ཐག་བཅད།",
    "སྡུག་ན་སྡུག་པ་དེ་རང་གི་རང་ངོ་དྲན་པས་བཟུང་ནས་གང་ཤར་དེ་ཀ་རང་ངོ་རང་ཤེས་སུ་བསྐྱངས་ན་དེ་ནས་རྩུབ་ཉམས་ཀྱིས་གནོད་མི་འཁྱོལ།",
    "གེགས་དང་གོལ་ཤོར་ཡོན་ཏན་དུ་འཆར་ནས་བོགས་རེ་རེ་ཐོན་ཡོང་བས།",
    "རང་གི་དྲན་པ་འབད་པས་བསྐྱངས་ན་དེ་ནས་ནམ་ཞིག་རང་གི་སྒྲིབ་པ་དག་པ་དང་།",
    "སྒོམ་གཞན་དུ་མེད་པར་རང་གི་སེམས་སུ་ཐག་ཆོད།",
    "རང་གི་སེམས་ཀྱང་རྣམ་རྟོག་ཐམས་ཅད་དྲན་པར་འདྲེས་པས་སྤང་བྱ་གཉེན་པོར་ཤར།",
    "སྣང་བ་ཡུལ་རྐྱེན་དང་འདྲེས་པའི་ཟུང་འཇུག་རྟོགས་པའི་སྒོམ་ཆེན་གཤའ་མ་སྟེ་ཡང་དག་གི་དྲན་པར་འགྲོ་བ་ཡིན་པས་དེ་ལྟར་ངེད་རང་སྒོམ་ཆེན་རྣམས་ཀྱིས་གོ་བ་དང་ཉན་ཤེས་པར་བྱས་ནས་ཉམས་སུ་ལེན་དགོས་པར་འདུག་གོ།",
    "དྲན་པ་གང་གིས་བདུད་ཀྱིས་སྐབས་མི་རྙེད་པ་དང་།",
    "དྲན་པ་གང་གིས་ལམ་ལོག་པར་མི་འགྱུར་བ་དང་།",
    "དེ་ལྟར་བྱས་ན་ཕན་ཡོན་དཔག་མེད་ཡོད་པར་འདུག་པ་སེམས་བསྐྱེད་སྤྱིའི་ཕན་ཡོན་དང་འདྲ་མོད།",
    "ལར་རྒྱལ་བ་གོང་མ་རྣམས་ཀྱི་གསུང་འགའ་རེར།",
    "དེ་ལྟ་བུའི་བཏང་ལེན་ནི་རང་ལ་རྐྱེན་ངན་བྱུང་དུས་ཙམ་མིན་པའི་དུས་ནམ་ཡང་ཉིན་རེར་ཐང་མང་པོའམ་ཐ་ན་གཉིས་གསུམ་སོགས་དམ་བཅའ་ལྟ་བུ་བྱས་ནས་གཏོང་ལེན་དམིགས་པ་བསམ་པ་རྣམ་དག་དེ་ལྟར་བསྒོམ།",
    "རྩེད་མོའི་ཆེད་དུའང་མི་བྱེད།",
    "སྐྱེ་བོ་རྨོངས་པས་རང་གི་བདེ་དོན་གཉེར།",
    "དེ་ཡང་རྒྱལ་བ་གོང་མ་རྣམས་འགའ་རེ་ཕར་འགྲོ་དོན་དུ་ཕེབས་པ་དང་།",
    "དེ་དུས་ནས་རང་གི་དགེ་སྦྱོར་རང་ངོ་རང་ཚོ་འཛིན་པ་གལ་ཆེ།",
    "དེང་མོས་གུས་གདུང་ཤུགས་བྱུང་ན་དང་པོ་ཁོ་རང་ཇི་ཙམ་བྱུང་བ་བསྐྱེད།",
    "དེ་ནས་མོས་གུས་གདུང་ཤུགས་དེ་ཀ་རང་ངོ་རང་ཤེས་སུ་འཇོག་པ་ཡིན་པས།",
    "འཕྲལ་དུ་མོས་གུས་ཆེ་ལ་རྟིང་གདོང་པ་ཆུང་ན་མཐར་དམ་ཉམས་སུ་འཆོར་ཉེན་ཡོད།",
    "རྐྱེན་ལ་ངེས་པ་མེད་ཕལ་ཆེར་ཆང་གིས་བྱས་པ་མང་།",
    "ཞེས་དཔལ་ཕག་མོ་གྲུ་པས་གསུངས་སོ།",
    "རང་གིས་རང་ལ་བསམས་ཀྱང་མ་ཁྲེལ་བ་ཞིག་བྱེད་དགོས་ཤིང་།",
    "མི་ཐ་མལ་པ་ལས་འཇིགས་ཙམ་ཞིག་དང་མང་ཙམ་ཞིག་གིས་སྒྲིབ་མེད་ས་ལེར་གཟིགས་ཅི་བྱས་ཐ་ལེར་མཁྱེན་འགྲོ་བས།",
    "དེ་ཁོ་ན་ཉིད་གནས་ལུགས་ཀྱི་སྟེང་དུ་རྐྱེན་གང་གིས་ཀྱང་གཡོ་བ་མེད་པར་ཆུ་བོའི་རྒྱུན་གྱི་རྣལ་འབྱོར་ཞེས་གསུངས་འདུག་པ་དེ་ལྟར་འབད་དགོས་རྒྱུ་ཡིན་པར་འདུག།",
    "དེ་ཡང་སྤོམ་མེ་ཡོ་རེ།",
    "སྒོམ་སྐྱེས་བདག་པོ་མེད་པར་འཇོག་པ་དེ་འདྲར་སོང་ན་གྱོང་ཆེ་སྟེ།",
    "ངེད་རང་གི་རྟོགས་ལྡན་རྙིང་པ་འདི་ཚོ་ནི་སྒོམ་ལ་ཡར་སྐྱེད་ཀྱི་སྐད་ཆ་ཁྱེར་ཡོང་རྒྱུ་ཆེན་པོ་རང་མི་འདུག་པས་བེམ་པོ་རྙིང་དུ་སོང་བ་འདྲ་ཞིག་ཡིན་པ་འདྲ།",
    "ད་རེས་འདི་ལྟར་བརྩོན་འགྲུས་བྱེད་དེ་དགེ་སྦྱོར་ངོ་བོ་ན་འདི་ཙམ་འཕར་བ་ཞིག་བྱེད་བསམ་པ་དགོས་གསུངས་པ་དེ་བཞིན་ངེད་རང་གིས་ཀྱང་ལོ་ཟླ་བ་སོང་བཞིན་སྟོང་ཟད་ཇེ་སྡུག་ཏུ་མི་གཏོང་བར་ཕྱི་རུ་ལོ་ཟླ་སོང་བཞིན་དེ་ཚོད་ཀྱིས་ནང་དུ་རང་གི་རྟོགས་པ་ཡར་སྐྱེད་འོང་བ་ལ་རང་ཡིད་ཆེས་བློ་ཚིམས།",
    "ལྔ་པ་སྐྱེ་མེད་ཟང་ཐལ་དུ་ལ་བཟླ་བ་དངོས།",
    "རང་གི་སེམས་སྐྱེ་འགགས་གནས་གསུམ་དང་དུས་གསུམ་ལ་སོགས་པའི་སྤྲོས་པ་བཅད་དེ།",
    "མཉམ་མེད་དྭགས་པོའི་གབ་པ་མངོན་ཕྱུང་གི་མན་ངག་ལ་སོགས་པའི་དགོངས་པ་ཡིན།",
    "རྟོག་པ་འགྱུ་ཐོག་ཏུ་དྲན་པས་ནམ་ཟིན་འགྱུ་བ་སྟོང་གསལ་སྟོང་འགྱུར་འཆར་ལ་ཚོགས་དྲུག་གི་ཡུལ་སྣང་གི་ཐོག་ཏུ་དྲན་པས་ནམ་ཟིན་སྣང་བ་སྟོང་སྣང་དུ་ས་ལེར་འཆར་བ་སྟེ།",
    "རང་གི་རིག་ཐོག་ཏུ་ཉམས་མྱོང་ངེས་ཤེས་དང་བཅས་པའི་རྐང་མི་ཚུགས་ཤིང་།",
    "སྐལ་ལྡན་ལས་འཕྲོ་ཅན་དག་རང་སེམས་དང་རང་སྣང་སློབ་དཔོན་དུ་ཤར་ཏེ་ཉམས་མྱོང་གི་ཞེན་འཛིན་རང་དག་ལ་སོང་ནས་གྲོལ་བ་ཐོབ་པར་འགྱུར་ཡང་།",
    "ཕལ་ཆེར་རང་གི་ཉམས་མྱོང་ལ་བཟང་རྟོག་ངེས་ཤེས་ཀྱི་འཛིན་པ་ཆེར་སོང་ནས།",
    "དངོས་པོ་དང་དངོས་མེད་སྣང་བ་དང་སྟོང་པ་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་གང་གིའང་ངོ་བོ་ཉིད་དུ་མ་སྐྱེས་པ།",
    "དེའི་རྣམ་པ་གསལ་བཞིན་པའི་ངང་ནས་ངོ་བོ་ལ་འཛིན་མེད་ཡེངས་མེད་ཅེ་རེ་ལྟ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པའི་རྣམ་པར་རྟོག་པ་རྣམ་གྲངས་མང་པོ་ཞིག་ལ་ལྟ།",
    "རེས་རྟོག་པ་དགག་རེས་མང་དུ་སྤྲོ།",
    "རེས་རྟོག་པའི་རྒྱུན་རྐྱང་དེད་བྱ་བ་སོགས་སྣ་ཚོགས་པ་བྱས་ནས་སོ་སོའི་ངོ་བོར་ལྟ་བར་བྱས་ཏེ་སྒྲོ་འདོགས་བཅད།",
    "དེ་དག་གི་ངོ་བོ་དང་སེམས་ཀྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་ལྟ་བ་རྣམས་དམིགས་པ་སོ་སོར་ཕྲལ་ཏེ་ཞག་འགར་སྒྲོ་འདོགས་གཅོད་དོ།",
    "ཁྱོད་ཀྱིས་རྩ་བ་སྟོང་པ་ཉིད་དང་ལྷན་ཅིག་བྱོས།",
    "དེ་ཉིད་འཕྲལ་མར་ཉམས་མྱོང་གི་ཐོག་ཏུ་རྣལ་འབྱོར་མངོན་སུམ་ཚུལ་གྱིས་སྒྲོ་འདོགས་གཅོད་དགོས་པས།",
    "དེའང་འདས་པའི་སེམས་གར་སོང་།",
    "ནམ་མཁའ་ལྟར་དུས་ཐམས་ཅད་པར་ཟང་ཐལ་ཉག་གཅིག་ཏུ་བློ་ཐག་ཆོད་དགོས་སོ།",
    "བདག་གཞན་གཉིས་སྣང་གི་ཤེས་པ་ཐམས་ཅད་ཀྱང་མིང་སོ་སོ་དང་བློས་སོ་སོར་བརྟགས་པ་ཙམ་ལས་རྒྱུད་ཐ་མི་དད་པར་ངོ་བོ་ཅིར་ཡང་མ་གྲུབ་ཀྱང་རྐྱེན་གྱིས་ཅིར་ཡང་འཆར་བའི་སེམས་ཉིད་སྒྱུ་མ་ལྟ་བུ།",
    "རེ་དོགས་མེད་པའི་མཐར་ཐུག་པ་ནི་རྡོ་རྗེ་སེམས།",
    "འཐོབ་བྱའི་འབྲས་བུ་སྟོར་བས་རེ་དོགས་ཀུན་ལས་གྲོལ།",
    "ལྔ་པ་སྐྱེ་མེད་ཟང་ཐལ་དུ་ལ་བཟླ་བ་དངོས་ནི།",
    "སེམས་དུམ་རེ་ཡེངས་པའི་ཚེ་དེ་ལ་སེམས་ཁྲལ་དང་སྐྱོན་དུ་ལྟ་བ་དང་བརྟག་གཞིག་ཀྱང་མི་བྱ།",
    "ཟླ་མེད་གཅིག་པུ་ཟང་ཐལ།",
    "དེ་ལ་ནི་སྐྱོ་སངས་ཅི་རིགས་བྱ་ཞིང་ཡིད་ཀྱི་འཆར་སྒོའང་རེ་ཞིག་ཅི་བདེར་བཏང་ལ་ངལ་བསོས་ཏེ་བྱའོ།",
    "མྱོང་བ་སྐྱོན་མེད་སྐྱེས་ན་དེ་ལ་ཞག་འགའི་བར་འབྱམས་སུ་བཅུག་ཅིང་སྐབས་རེ་ཙམ་སྒོམ་མིན་པའི་སེམས་དང་གནས་སྐབས་འདུག་གམ་ལྟ།",
    "སྒོམ་མིན་པ་དེ་དག་གི་ངོ་བོ་དང་རང་བཞིན་ལ་སླར་བརྟག་སྟེ་དེ་དག་གི་གནས་ལུགས་རིག་པར་བྱ་སྟེ།",
    "རེ་དང་དོགས་པའི་བསམ་པ་ཟད་གྱུར་པས།",
    "རེ་དང་དོགས་པའི་བློ་མེད་ཞེན་པ་ཀུན་ལས་གྲོལ།",
    "འབྲས་བུ་ཅི་ཡང་མ་མཐོང་རེ་དོགས་ཞི།",
    "མཉམ་རྗེས་རེས་མོར་མེད་པས་ཐུན་མཚམས་བྲལ།",
    "དེ་མཚན་མོ་ལའང་བསྲེ་བར་བྱ་སྟེ།",
    "རྗེ་ཞང་གིས།",
    "འདི་བྱའི་ཏིག་ཏིག་མི་བདོག་གི།",
    "འོན་ཀྱང་རྗེས་ཤེས་དུམ་རེ་ཡེངས་ཤོར་ནའང་།",
    "རྗེས་ཐོབ་ཀྱི་དྲན་པས་ནམ་ཟིན་དེ་དག་གི་གནས་ལུགས་རིག་པས་རྗེས་ཆོད་པ་དང་།",
    "གཉིད་དྲན་མེད་དུ་སོང་ཞིང་རྨི་ལམ་འཁྲུལ་པར་ཤར་ཡང་།",
    "གཉིད་སད་མ་ཐག་ཏུ་དེ་དག་གི་གནས་ལུགས་རིག་པས་ཆོག་པ་དང་།",
    "དྲན་པས་མ་ཟིན་ཀྱང་རྣམ་རྟོག་གིས་གནོད་པ་དང་།",
    "བློ་ཡིས་བཟུང་མོད་དོན་ལ་ཐོབ་ཤོར་མེད།",
    "དེ་ལྟར་ལ་བཟླའི་དོན་དེ་དག་ལ་ངེས་ཤེས་སྐྱེས་ན་གཞན་མཚན་བཅས་དང་ཡིད་བྱེད་གང་ཡང་མི་བྱ་བར་ཞག་ལྔ་རེ་ཙམ་ལ་ལ་བཟླའི་ངང་ལ་འབྱམས་སུ་བཅུག།",
    "ཡང་ཞག་རེ་ཙམ་ཅི་བདེར་ངལ་བསོ།",
    "ཡང་ཞག་བདུན་རེ་དང་བཅུ་རེ་ཙམ་དུ།",
    "ལ་བཟླ་རེ་དང་ངལ་བསོ་རེ་སྤེལ་ནས།",
    "འཆར་ཚུལ་ནི་སྦྱངས་པ་ཆེ་ཆུང་གི་ཁྱད་པར་ལ་བརྟེན་ནས་གཅིག་ཏུ་མ་ངེས་པར་འཆར་རོ།",
    "སྒོམ་རང་རང་གི་ངོ་བོ་གང་ཡང་མ་གྲུབ་པར་རང་བཞིན་སྟོང་པ་ཉིད་དེ་ཀའི་ངང་དུ་ཡེངས་མེད་དུ་སྐྱོང་དགོས་ཏེ།",
    "དེ་ནས་རྐྱེན་ནམ་རང་གི་ཁམས་ཀྱིས་བྱས་པའི་མཐོ་དམན་སྣང་བ་བྱུང་ན།",
    "རང་སྣང་སྣ་ཚོགས་གང་ཤར་ལ་ཆེད་དུ་བཟོ་མེད་རང་བྱུང་གི་རྩལ་ལ་རང་ངོར་བལྟ་བའི་འཛིན་མེད་རང་གྲོལ་དུ་བཏང་དགོས་པ་ཡིན།",
    "རང་རེས་སེམས་ཀྱི་ངོ་བོ་གཤའ་མ་མཐོང་ན་དེས་རྩལ་སྦྱོང་རྒྱུ་ཆེར་མེད་ལ།",
    "ངོ་བོ་རྣམ་དག་ཏུ་མ་རྟོགས་པས་ཇི་ལྟར་རིགས་པའི་རྟོགས་པ་ཤར་བ་དེ་གོམས་པར་བསྐྱངས་པས་ན་རིམ་གྱིས་ངེས་ཤེས་སྐྱེ་ཞིང་དྲི་མ་དག་པའི་ཡོན་ཏན་འཆར་མོད།",
    "རྣམ་རྟོག་ཕྲ་མོ་ཡོད་པའི་རྟགས།",
    "ཞེས་བག་ལ་ཉལ་གྱི་འཁྲུལ་པ་ཕྲ་མོ་ཡོད་པར་ཞལ་གྱིས་བཞེས་ཤིང་།",
    "བདག་གནམ་མཚོ་སེ་མོ་དོ་ལ་སྡོད་སྐབས་རྗེས་ཤེས་མི་སྐྱེ་བར་འདུག་བསམ་ཀྱང་ཕྱིས་གཞན་གྱི་སྤྱོད་ངན་མཐོང་བས་རྗེས་ཤེས་སྐྱེས་བྱུང་ཞེས་གསུངས་པར།",
    "དེ་ལྟར་ཤིན་ཏུ་ཡིན་པས་ངེད་རང་དྲན་པ་རྒྱུན་ཆད་མེད་པའི་རྩོལ་མེད་ཡང་དག་གི་དྲན་པ་རྐྱེན་དང་འགྲེ་བ་ལྟ་བུ་བྱུང་ཡང་ངོ་བོ་མ་བརྗེད་པར་ཁུ་འཕྲིག་ཇི་ལྟར་འདུག་ལེགས་པར་བརྟགས་ནས་འདུག་ན་རིག་པའི་རྩལ་ཕྱུངས་ཤིང་མདངས་ཀྱི་གཟོ་རྒྱ་ལ་གཟབ།",
    "དེ་ལ་དཔེར་ན་བཟའ་བཏུང་ཚོགས་འཁོར་དང་འགྲོ་འདུག་བསྐོར་བར་ཤེས་པའི་གདམས་པ་ལྟར།",
    "དེ་བཞིན་རིགས་པས་བསྐྲུན་ལ་འགྲེས་མོད།",
    "གོས་གྱོན་ན་བག་ཡོད་རྣམ་དག་གི་གོས་གྱོན་སྙམ་པ་དང་།",
    "དེ་མི་འགྲུབ་སྙམ་པའི་སྒྱིད་ལུག་གི་བསམ་པ་མི་གཏོང་བར་དེ་ལྟར་བྱའོ་འགྲུབ་པར་གྱུར་ཅིག་སྙམ་པ་དང་།",
    "ཡོན་ཏན་ཀུན་རང་གིས་བྱས་པས་ཆོག།",
    "འགའ་ཞིག་གིས་ནི་མ་ཤེས།",
    "ཉམས་མྱོང་གིས་ཀྱང་མི་ཆོག།",
    "སློབ་དཔོན་གྱིས་གསུངས་པ་དང་རང་གི་ཁར་འབྱིན་ཤེས་པ་དེ་རྣམས་ལ་ཚིག་བྱ་བ་ཡིན།",
    "དེས་ཉོན་མོངས་པའི་མགོ་ཡང་མི་ནོན།"
  ]
