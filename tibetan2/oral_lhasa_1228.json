    "གང་དུ་དེ་དག་ཏིང་ངེ་འཛིན་གྱི་སྒྲ་ཁོ་ནར་གསུངས་པ་དེར་ནི་དེ་དག་བསྒོམས་པ་ལས་བྱུང་བ་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པ་ཉིད་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "དང་པོ་གསུམ་མིའི་རྟེན་ལ་སྐྱེ་བར་གསུངས་སོ།",
    "དང་པོ་འདི་ལ་འདོད་པ་ལ་ཆགས་པ་དང་བྲལ་ཞིང་གཟུགས་ལ་འདོད་ཆགས་དང་མ་བྲལ་བ་གསུངས་པ་ནི་སྔ་མ་ངེས་ཀྱང་།",
    "ཕྱི་མ་འདི་ངེས་པར་མི་བཞེད་ཀྱི་མ་བྲལ་བས་ཀྱང་སྒོམ་ནུས་ཞེས་པའི་དོན་ནོ།",
    "ལུང་འདིས་ཉན་ཐོས་ཡིན་ན་བསམ་གཏན་དང་པོ་གཉིས་ཁོ་ན་ལ་བརྟེན་པར་འདོད་པ་ཡང་བཀག་གོ།",
    "ཕྱི་མ་ལ་གཟུགས་མེད་ཐོབ་ན་གཟུགས་ཀྱི་འདུ་ཤེས་གཞིག་སླ་བ་ལ་དགོངས་ནས་གཟུགས་མེད་ལ་བརྟེན་པར་གསུངས་ཀྱི་དེ་ལ་བརྟེན་དགོས་པ་ནི་མིན་ཏེ།",
    "གཟུགས་མེད་ཀྱི་དངོས་གཞི་ལ་གཟུགས་ཡུལ་དུ་མི་བྱེད་པར་དུ་མ་ཞིག་གསུངས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གཟུགས་མེད་ཐོབ་པས་བྲལ་ཡང་མངོན་དུ་མི་བྱེད་པར་གཟུགས་ཀྱི་འདུ་ཤེས་གཞག་དགོས་པ་དང་།",
    "གཟུགས་ཀྱི་འདོད་ཆགས་དང་ནི་བྲལ་ལ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ནི་མངོན་དུ་མི་བྱེད་ལ་དེའི་འདུ་ཤེས་དང་ནི་ལྡན་ཏེ།",
    "དེ་ལ་ཁ་དོག་བཟང་བ་ནི་གཅིག་ཏུ་མཛེས་པར་སྣང་བའོ།",
    "ནང་ལྟ་བ་པོ་རང་ལ་གཟུགས་ཅན་ཡིན་པར་འདུ་ཤེས་ནས་ཆེ་ཆུང་བཟང་ངན་རྣམས་ལ་དེ་ལས་ཆེ་བའམ་ཆུང་བ་སོགས་སུ་མཐའ་གཅིག་ཏུ་མ་ངེས་པར་བལྟ་བའོ།",
    "རང་ལ་གཟུགས་ཀྱི་འདུ་ཤེས་རྣམ་པར་མ་བཤིག་པ་སྟེ་དེ་བཞག་པའི་ཕྱིར་རོ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་ལ་སོགས་པ་སྒྲུབ་པའི་ཕྱིར་རོ་ཞེས་པ་ལྟར་རོ།",
    "ཅིའི་ཕྱིར་གཟུགས་ཅན་མ་ཡིན་པ་ཞེས་བྱ་ན་རང་ལ་མིང་བཞིའམ་ནམ་མཁར་འདུ་ཤེས་ཏེ་གཟུགས་ཀྱི་འདུ་ཤེས་རྣམ་པར་བཤིག་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་འདི་ན་ཁ་ཅིག་བཏང་སྙོམས་དང་དྲན་པ་ཡོངས་སུ་བྱང་བ་ཐོབ་པར་གྱུར་ལ།",
    "སྔ་མ་གཉིས་ལྟར་བསྒོམས་པ་ལ་བརྟེན་ནས་སྡུག་མི་སྡུག་ཐམས་ཅད་ལ་མཐར་གཅིག་ཏུ་སོ་སོར་འཛིན་པ་མེད་པར་ཐམས་ཅད་ཀྱང་སྡུག་པའམ་སྤྲུལ་འདོད་པའི་རྣམ་པར་རོ་གཅིག་པའི་འདུ་ཤེས་འཐོབ་སྟེ།",
    "འདི་གཉིས་ཀྱིས་གཟུགས་ཅན་དང་གཟུགས་མེད་ཀྱི་སྒྲིབ་པ་སྤངས་པའི་གནས་གྱུར་རྫོགས་པར་མངོན་དུ་བྱེད་པས་སོ།",
    "གསུམ་པ་གང་ལ་སྙོམས་པར་ཞུགས་ན།",
    "ཀུན་དཀྲིས་མངོན་གྱུར་བ་བྲལ་བར་མཐུན་པར་གནས་པའི་ལམ་གྱི་རང་བཞིན་ལ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པའི་དངོས་གཞི་བཞི་ཡོད་དེ།",
    "གང་ན་བསམ་གཏན་བཞི་ནས་འགོག་པའི་སྙོམས་པར་འཇུག་པ་དག་སྟེ་དེ་དགུའོ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གྱིས་ཐོབ་པའི་ཕྱིར་རོ།",
    "འགོག་པ་ནི་འདས་ལམ་གྱིས་ངེས་པར་འཐོབ་དགོས་པས་དེའོ་སྙམ་དུ་དགོངས་སོ།",
    "ཁམས་གང་དུ་སྙོམས་པར་འཇུག་པའོ།",
    "མི་སློབ་པ་གཉིས་ཀའི་ཆ་ལས་རྣམ་པར་གྲོལ་བ་ཡང་སྙོམས་པར་འཇུག་གོ།",
    "དེ་ནི་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་དབྱིངས་ལ་འགོག་པར་བཞེད་པས་མིང་མཚུངས་ཀྱང་དོན་མི་འདྲའོ།",
    "ཚོར་འདུ་སོགས་ཀྱི་རྒྱུ་བ་རགས་པ་མི་དབེན་པར་མཐོང་ནས་དེས་ཞི་བར་གནས་པའི་འདུ་ཤེས་སྔོན་དུ་བཏང་བའི་ཡིད་ལ་བྱེད་པས་སོ།",
    "ཚོགས་དྲུག་དང་ཉོན་ཡིད་དེ་བདུན་འཁོར་དང་བཅས་པ་འགོག་སྟེ་འདི་ལ་ཉོན་ཡིད་མ་བཀག་ན་འདུ་ཤེས་མེད་པའི་སྙོམས་འཇུག་དང་འདི་གཉིས་ལ་ཞི་མ་ཞིའི་ཁྱད་པར་མེད་པར་འགྱུར་བས་སོ།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་ཙམ་ཉེ་བར་ཞི་བར་ཟད་ཀྱི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉེ་བར་ཞི་བ་ནི་མ་ཡིན་ནོ།",
    "དེ་ཡང་བཏགས་པའི་ཡོད་པ་ཡིན་གྱི་རྫས་སུ་ནི་མ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཞེས་པ་ལྟར་འདོད་པ་ནི་ཁྱད་པར་རོ།",
    "སྐུ་མཆེད་ཀྱི་དགོངས་པ་མིན་པར་བསྟན།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་སེམས་མེད་པ་ཡིན་པ་དེ་ལ་སྐྱོན་དེ་ཡོད་ཀྱི་ཁོ་བོའི་ལྟར་ན།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་སེམས་དང་བཅས་པ་ཉིད་དོ་ཞེས་སྨྲ་པ་ལྟ་བུའོ།",
    "རྣམ་པར་ཤེས་པ་ལུས་དང་མ་བྲལ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ཁྱེར་ཏེ་འོང་བར་བྱེད་དོ།",
    "དེ་དག་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་གང་ཡིན་པར་འདོད།",
    "ཇི་ལྟར་ན་དེའི་ཚེ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡོད་ཀྱང་གསུམ་ཡང་དག་པར་འདུས་པ་མ་ཡིན།་",
    "ཞེས་སོགས་ཀྱིས་འདི་ལ་ཞུགས་པའི་ཚེ་ཡིད་ཤེས་དགེ་མི་དགེ་ལུང་མ་བསྟན་ཡོད་པ་རྒྱས་པར་བཀག་ནས།",
    "དོན་ཇི་ལྟ་བ་བཞིན་དུ་མ་རྟོགས་པས་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལ་སོགས་པའི་གནས་སྐབས་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་སེམས་དང་བཅས་པར་རྟོག་པ་ནི་གཟུ་ལུམ་དུ་སེམས་པ་ཡིན་ནོ་ཞེས་སོ།",
    "སྙོམས་པར་འཇུག་པ་རྣམ་གཉིས་དང་།",
    "ཅིའི་ཕྱིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མེད་ན་སེམས་མེད་པའི་སྙོམས་པར་འཇུག་པ་མི་སྲིད་ཅེ་ན།",
    "འདི་ལྟར་འདུ་ཤེས་མེད་པ་ལ་སྙོམས་པར་འཇུག་པའམ།",
    "འགོག་པ་ལ་སྙོམས་པར་འཇུག་པའི་རྣམ་པར་ཤེས་པ་ལུས་དང་བྲལ་བ་ཁོ་ནར་འགྱུར་ཞིང་མ་བྲལ་བར་མི་འགྱུར་བས་དེའི་ཕྱིར་ཤི་བ་ཁོ་ནར་འགྱུར་བ་ཞིག་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་སྐད་དུ་དེའི་རྣམ་པར་ཤེས་པ་ནི་ལུས་དང་བྲལ་བ་མ་ཡིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ་ཞེས་ཀུན་གཞི་མེད་ན་ཉོན་ཡིད་ཀྱང་མེད་པས་སྙོམས་འཇུག་གཉིས་ལ་ཞུགས་པ་ན་ཤི་བར་འགྱུར་ལ་ཞེས་གསུངས་པ་མི་རིགས་པར་འགྱུར་ཏེ།",
    "ཐེག་བསྡུས་དང་ཀུན་བཏུས་ཀྱི་འགྲེལ་བར་རྟོག་དཔྱོད་ཉེ་བར་ཞི་བས་མི་རྟོག་ཡེ་ཤེས་སུ་འཇོག་ན་འདུ་ཤེས་ཚོར་འགོག་ཀྱང་དེར་འགྱུར་རོ་ཞེས་བསལ་བ་བྱས་པ་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་ཟག་པ་མེད་པར་བརྗོད་པར་བྱ་སྟེ།",
    "མཚུངས་པར་ལྡན་པ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "སེམས་སེམས་བྱུང་དང་མཚུངས་པར་མི་ལྡན་པར་གསུངས་སོ།",
    "དེ་ལས་རྗེས་ལས་ཐོབ་པར་ཞེས་པ་ནི་མཉམ་རྗེས་གཉིས་ཀྱི་རྗེས་ཐོབ་ཡེ་ཤེས་མ་ཡིན་གྱི།",
    "སློབ་པ་དང་མི་སློབ་པའི་མཚུངས་ལྡན་གྱི་ལམ་མིན་པར་གསུངས་པས་ལྡན་མིན་ཟག་མེད་དོ།",
    "མཉམ་པར་མ་བཞག་པའི་སེམས་བཞིན་ནོ།",
    "སྙོམས་འཇུག་ཏུ་གསུངས་པའི་དགོངས་པ་ནི།",
    "ཇི་ལྟར་ན་སེམས་མེད་པ་སྙོམས་པར་འཇུག་པ་ཉིད་ཡིན་ཞེ་ན།",
    "ཡང་ན་སྙོམས་པར་འཇུག་པའི་སེམས་ཀྱིས་དེ་ལ་སྙོམས་པར་འཇུག་ཅིང་ཐོབ་པར་འགྱུར་བས་ན་སྙོམས་པར་འཛུག་པ་ཡིན་ནོ།",
    "ཡང་ཅི་སྙོམས་པར་འཇུག་པ་འདི་དག་རྫས་སུ་ཡོད་དམ་འོན་ཏེ་བཏགས་པར་ཡོད་ཅེ་ན།",
    "སྙོམས་པར་འཇུག་པའི་སེམས་དེ་ཁོ་ན་དེ་ལ་གེགས་བྱེད་པའི་ཕྱིར་རོ།",
    "མི་འཇུག་པ་ཙམ་དེ་ཡང་སྔོན་མ་བྱུང་བ་དང་ཕྱིས་ལངས་པ་ལ་མེད་པ་ཡིན་པས་སྙོམས་པར་འཇུག་པ་འདི་ནི་འདུས་བྱས་སུ་གདགས་སོ།",
    "སྙོམས་པར་འཇུག་པ་ཡང་གཞན་དོན་ཡིན་པས་དང་།",
    "ཞེས་གསུངས་པས་སོ།་།",
    "དགག་གཞི་ཡོད་མེད་ཀྱི་ཁྱད་པར་རོ།",
    "གཟུགས་མེད་ཆེས་ཞི་བ་ཡིན་ལ་འདི་ལ་འཇུག་ན་མ་ཞི་བ་ཞི་བར་བྱ་བའི་ཕྱིར་འཇུག་དགོས་པས་དེ་ན་འདི་མངོན་དུ་མི་བྱེད་པར་གསུངས་པ་ནི་རགས་པ་ཙམ་གྱི་རྣམ་གཞག་ཡིན་ལ།",
    "ཞིབ་པར་དཔྱད་ན་དེར་ཡང་སེམས་ཀྱི་རྒྱུ་བ་རགས་པ་ཡོད་པས་དེར་འཇུག་པ་རང་ལུགས་སོ།",
    "དེས་ན་འདི་མི་ཤེས་པར་སྣང་ངོ་ཞེས་འབྲེ་གསུང་བར་གྲགས་སོ།",
    "འོན་ཀྱང་འདི་ཙམ་ཞིག་དགོངས་པར་སྣང་སྟེ།",
    "རྒྱས་པར་བཤད།",
    "རྣམ་མཁྱེན་གྱི་རྣམ་པ་སོ་དགུ་ནི་ཤིན་ཏུ་ཕུལ་དུ་བྱུང་བ་སྟེ།",
    "གལ་ཏེ་རྣམ་མཁྱེན་དེ་གཅིག་པུ་ཡིན་ན་དབྱེ་བ་མི་འཐད་སྙམ་ན།",
    "ལས་དེའི་རྣམ་པར་སྨིན་པ་དམན་པ་དང་ཁྱད་པར་བ་རྣམས་དང་།",
    "དེ་མི་དམིགས་པའི་རྣམ་པར་བྱང་བ་སེང་གེ་རྣམ་བསྒྱིངས་སམ་ཐོད་རྒལ་དུ་འཇུག་པའམ་ལྡང་བ་དང་།",
    "མཁྱེན་པའི་སྟོབས་ཀྱི་རྣམ་པ་ཞེས་ཀུན་གྱི་མཐར་རོ།",
    "འདིར་རྒྱུ་དེ་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་བས་བདག་བདེ་བ་ཐོབ་པ་དང་།",
    "ཀྱེ་མ་བདག་ཟག་པ་ཟད་དོ་ཞེས་དམ་བཅས་ན་དེ་ལ་ཟག་པ་འདི་རྣམས་ཡོངས་སུ་ཟད་པར་མ་གྱུར་ཏོ།",
    "ངས་འཕགས་པ་ངེས་པར་འབྱིན་པའི་ལམ་དེ་བྱེད་པའི་སྡུག་བསྔལ་ཡང་དག་པར་ཟད་པའི་དོན་དུ་ངེས་པར་འབྱིན་པ་བསྟན་པ་གང་ཡིན་པ་དེ་བསྒྲུབས་ན་སྡུག་བསྔལ་ཡང་དག་པར་ཟད་པའི་དོན་དུ་ངེས་པར་འབྱིན་པར་མི་འགྱུར་བ་དེ་ལྟ་བུའི་གནས་མེད་དེ།",
    "འདིར་ཡང་ང་ལ་དེ་ཡང་དག་པར་བསྒྲུབས་ཀྱང་སྡུག་བསྔལ་ཡང་དག་པར་ཟད་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བར་དགེ་སྦྱོང་སོགས་སོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པའི་རྣམ་པ་བཞིའོ།",
    "དེ་དག་ཀྱང་ཡུལ་བཞི་ལ་ཆགས་ཐོགས་མེད་པའི་ཕྱིར་སོ་སོ་ཡང་དག་པར་རིག་པའོ།",
    "སྙོམས་པར་ཞུགས་རུང་མ་ཞུགས་རུང་དུས་ཐམས་ཅད་དུ་ཐུགས་མཉམ་པར་མ་བཞག་པ་མི་མངའ་བ་དང་།",
    "འདས་པ་ནས་ད་ལྟར་བྱུང་བ་ནི་བར་གྱི་ཤེས་བྱ་ཐམས་ཅད་ལ་བཞེད་པ་ཙམ་གྱིས་མཁྱེན་པས་མ་ཆགས་ཤིང་།",
    "སྲིད་པ་ཐ་མ་པས་ཤེས་བྱ་ཐམས་ཅད་མངོན་དུ་བྱས་པའི་ཡེ་ཤེས་སོ།",
    "ནམ་མཁའ་འཇིག་པར་འགྱུར་བ་མེད།",
    "མཁྱེན་གསུམ་གྱི་རྣམ་པ་དེ་ལ་ཐམས་ཅད་ཤེས་པ་ཉིད་ཀྱི་དོན་རྣམ་ཉེར་བདུན་རྟོགས་པའི་ཤེས་རྣམ་ནི།",
    "ཁོ་ན་ཞེས་པ་ནི་ཟག་བཅས་སུ་འཇོག་ཚུལ་དེས་ཟག་མེད་མེད་པར་སྟོན་པའོ།",
    "རྣམ་མཁྱེན་གྱི་དོན་རྣམ་བརྒྱ་དང་བཅུ་རྟོགས་པའི་ཤེས་རྣམ་ནི་ཡང་དག་པར་སོགས་སོ།",
    "འོན་ཀྱང་དོན་རྣམ་ཉེར་བདུན་དང་སོ་དྲུག་རྟོགས་པའི་ཤེས་རྣམ་ནི་རྣམ་མཁྱེན་གྱི་དོན་རྣམ་སོ་བདུན་དང་སོ་བཞིར་འགྱུར་བས་དེ་གཉིས་ཀྱི་ཡང་ཟག་པ་ཡོད་མེད་ཀྱི་དོན་བསྡུར་འགྱུར་རོ།",
    "མཁྱེན་གསུམ་དུ་བསྟན་པའི་སྦྱོར་བ་རྣམས་ཐོས་བསམ་གྱི་ཡུལ་དུ་གྱུར་པས་མཆོག་མ་ཡིན་ལ།",
    "པ་པོ་མེད་པར་བརྗོད་མི་ནུས་པས་སོ།",
    "ཀྱང་ནི་སྦྱོར་བ་མེད་པར་རྣམ་པ་སྒོམ་མི་ནུས་པར་མ་ཟད་སྦྱོར་བ་པོ་མེད་ན་ཡང་སྦྱོར་བ་བརྗོད་མི་ནུས་པའོ།",
    "སྤྱིར་ཞེས་པ་སྦྱོར་བ་པོ་ཐམས་ཅད་ལ་དེ་ཡོད་པར་སྟོན་པའོ།",
    "རྣམ་པ་བརྒྱ་དོན་གསུམ་གྱི་མཚན་ཉིད་ཅན་ཏེ་བརྗོད་བྱ་ཅན་གྱི་ཡུམ་འདིའི་གཞུང་ཉན་པ་དང་འཛིན་པ་དང་དེའི་དོན་མི་བརྗེད་པ་དང་མཚན་ཉིད་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའི་སྣོད་བཞི་ཡིན་པར་རོ།",
    "ཇི་ལྟར་ན་བྱང་ཆེན་ཡུམ་ལ་གནས་པ་དང་སྦྱོར་བ་ལགས་ཞེས་བརྒྱ་བྱིན་གྱིས་དེ་བཞིན་གཤེགས་པ་ལ་དྲིས་པའི་ལན་དུ་གསུངས་སོ།",
    "གཟུགས་ལ་སྦྱོར་བར་མི་བྱེད་པ་དེའི་ཚེ་གཟུགས་ལ་རྣལ་འབྱོར་དུ་བྱེད་པ་ཡིན་ནོ་ཞེས་རྣམ་མཁྱེན་གྱི་བར་ལ་དེ་ལྟར་རོ།",
    "གཟུགས་སོགས་དེའི་དེ་བཞིན་ཉིད་ཟབ་པར་རྟོགས་པའི་ཕྱིར་གཞི་ཤེས་ཀྱི་ཟབ་པའི་སྦྱོར་བ་སྟེ།",
    "གཞི་ལམ་རྣམ་པའི་སྐྱེ་མེད་གསུམ་ལ་མི་སྐྲག་པ་སྐྱེ་དཀའ་སླའི་ཁྱད་པར་གྱིས་ཡིན་ལ།",
    "མཁྱེན་གསུམ་རིམ་པ་ལྟར་ཐ་མལ་པའི་བློ་ལས་ཟབ་པ་དང་།",
    "ཀུན་དུ་སྐྲག་པར་འགྱུར།",
    "ཀུན་དུ་སྐྲག་པས་ཟིན་པར་འགྱུར་དུ་མཆི་བས་སོ།",
    "ཀུན་དུ་སྐྲག་པར་མི་འགྱུར།",
    "ཡུམ་གྱི་རྟོགས་པ་རང་ལབྱུང་བ་དེ་འཛིན་པ་སོགས་ཀྱིས་ཕྱིར་མི་ལྡོག་པར་བྱེད་པའི་སྦྱོར་བ་ནི།",
    "ཕྱིར་མི་ལྡོག་པར་འགྱུར་བ་ལགས་སོ།",
    "བྱང་ཚེ་ནམ་གཟུགས་ཀྱི་འཕེལ་བ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "གཟུགས་སོགས་ལ་བསམ་གྱིས་མི་ཁྱབ་པར་མི་མཐོང་བ་མི་རློམ་པའི་སྦྱོར་བ་ནི།",
    "ཚོར་བ་འདུ་ཤེས་འདུ་བྱེད་རྣམ་པར་ཤེས་པ་བསམ་གྱིས་མི་ཁྱབ་ཅེས་བྱ་བར་འདུ་ཤེས་པ་མེད་ན་ཡུམ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པར་འགྱུར་རོ།",
    "གཟུགས་སོགས་དང་དེའི་མཚན་མ་དང་དེའི་ངོ་བོར་མི་ཞེན་པ་ནི་རྣམ་པར་མི་རྟོག་པའི་སྦྱོར་བ་སྟེ།",
    "བྱང་ཚེ་གཟུགས་སུ་མི་རྟོག་རྣམ་པར་མི་རྟོག།",
    "གཟུགས་ཀྱི་མཚན་མར་དང་གཟུགས་ཀྱི་རང་བཞིན་དུ་མི་རྟོག་རྣམ་པར་མི་རྟོག་ཅེས་སོ།",
    "ཁྱད་པར་དཔྱད་པའོ།",
    "གཟུགས་སོགས་ལ་མི་གནས་པ་སྟེ་ཞེན་ནས་གནས་བྱར་མི་བདེན་པར་རྟོགས་པའི་དོན་དེའི་མིང་ནི་དང་པོའོ།",
    "དེ་ལྟར་ལྔ་གསུངས་པ་ནི་ཡུལ་དང་ཡུལ་ཅན་དུ་མ་ཞེན་པར་བྱས་ཏེ་སྐྱེ་མེད་གསུམ་བསྒོམས་ན་ཟབ་པ་སོགས་གསུམ་རྟོགས་པའི་སྦྱོར་བ་རྣམས་སྐྱེའོ་ཞེས་བསྟན་པའི་ཕྱིར་ཏེ།",
    "སྦྱོར་བ་ཞེས་ཕྱི་མ་རྣམས་ཀྱི་མཐར་སྦྱར་ཞིང་སོགས་ནི་མཐའི་གསལ་བྱེད་ཡིན་པས་ཐམས་ཅད་ལ་ཤེས་པར་བྱའོ།",
    "ཡུམ་ཐོས་ནས་ཡང་དག་པར་འཛིན་པ་དང་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའི་བར་ནི་ཕྱིར་མི་ལྡོག་པ་ཉིད་དང་།",
    "ཡེ་ཤེས་རྣམ་པར་སྨིན་པ་བཞིན།",
    "སོགས་པས་ཁམས་གསུམ་ལ་སོགས་པར་མི་དམིགས་པ་དང་།",
    "བསམ་གྱིས་མི་ཁྱབ་པའི་རྣམ་པར་དང་།",
    "འདི་གཟུགས་ཀྱི་ངོ་བོ་ཞེས་མཚན་གཞིར་མི་རྟོག་རྣམ་པར་མི་རྟོག་པའོ།",
    "དེ་ལྟར་གཞན་དོན་བྱེད་པ་འཕེལ་འགྲིབ་མེད་པར་རྟོགས་པ།",
    "རྣམ་ཀུན་དོན་ཡོད་ཤེས་པར་བྱ།",
    "ཞེས་ས་བརྒྱད་པ་ཡན་རྣམ་པ་ཐམས་ཅད་དུ་གཞན་དོན་དུ་འགྱུར་བར་གསུངས་ཤིང་།",
    "འདི་ནི་སྦྱོར་བ་བཅུ་བཞིའི་རྒྱུར་གསུངས་སོ།",
    "དེས་ན་སྦྱོར་ལམ་དུ་བཞག་པ་བཞི་ལ་ལུང་བསྟན་མ་ཐོབ་ཅིང་དེ་ལ་ཉེ་བར་གསུངས་པས་ས་བརྒྱད་པ་ནས་དེ་དག་འཇོག་པ་མི་འཐད་ལ།",
    "དེ་ནས་གཞན་གྱི་དོན་བྱེད་ཅིང་འཕེལ་བ་མེད་པ་དང་འགྲིབ་པ་མེད་པར་འགྱུར་རོ།",
    "གཟུགས་བསམ་གྱིས་མི་ཁྱབ་པ་ལ་སོགས་པའི་ཁྱད་པར་ལ་འདུ་ཤེས་ཐམས་ཅད་སྤངས་པའི་ཕྱིར་རྣམ་པར་མི་རྟོག་པ་ནི།",
    "འོན་ཀྱང་དང་པོ་ལྔ་དྲུག་པའི་གོང་དུ་སྐྱེས་པར་མི་བཟུང་སྟེ།",
    "སྔ་མ་རྣམས་རང་བཞིན་ལྔ་གནས་སྐབས་བཅུ་བཞི་དེ་གཉིས་ཀྱི་རྒྱུ་ཉི་ཤུ་པར་འཇོག་པ་ཡང་བརྟགས་ན་མི་འཐད་དེ།",
    "སྦྱོར་བ་དང་པོ་ལྔའི་གནས་སྐབས་ཡིན་ན་དྲུག་པར་འགའ་ཏེ།",
    "དེ་ནི་ཡང་དག་མ་ཡིན་པའི་སྦྱོར་བར་གསུངས་པ་དང་ཡུམ་ལ་སྐྲག་པ་སྐྱེ་བས་སོ།",
    "ཡོན་ཏན་མཐོང་བ་སྟེ་ཤེས་པ་སྔོན་དུ་བཏང་ན་དེའི་རྒྱུ་སྦྱོར་བ་རྣམས་ལ་ཤིན་ཏུ་གོམས་པར་བྱེད་པས་སོ།",
    "བདུད་ཀྱི་མཐུ་བཅོམ་པ་དང་སོགས་པས་ངེས་པར་འཐོབ་པའི་ཡོན་ཏན་གྱི་བར་རོ།",
    "བཞི་སྦྱོར་ལམ་དེ་ནས་བཅུ་ས་བཅུ་ལ་འཇོག་པར་འདོད་པ་ནི་བཅུ་བཞིའི་གྲངས་སྒྲིག་པ་ཙམ་ཤེས་པ་ལ་ཐེ་ཚོམ་མི་སྣང་ངོ།",
    "རྗེས་སུ་བསླབ་པར་བྱ་བས་སྦྱོར་བའི་ཡོན་ཏན་ཏེ་དེ་ལ་ནི་བཅུ་བཞི་ཡིན་ནོ།",
    "འདི་ལ་ཁ་ཅིག་དང་པོ་གཉིས་པ་གསུམ་པ་བཞི་པ་བཅུ་གསུམ་པ་གཉིས་ལ་ཁྱད་པར་མེད་པས་རྒྱུ་འབྲས་སུ་རིགས་བྱིན་གྱིས་སྦྱར་བ་མི་འཐད་པར་བྱས་ནས་མིང་དོན་དང་སྔ་མ་རྣམས་གང་ཟག་དང་ཕྱི་མ་རྣམས་སྦྱོར་བའི་འབྲས་ལྡོག་ཏུ་འདོད་ལ།",
    "ཁ་ཅིག་སྔ་མ་འབྲས་བུ་དང་ཕྱི་མ་རྣམས་རྒྱུར་བྱས་ནས་རྒྱུ་འབྲས་ཀྱི་ཡོན་ཏན་བཅུ་བཞིར་སོ་སོར་བྱེད་པ་གཉིས་ཀ་ཡང་མི་འཐད་དེ།",
    "འགྲེལ་པར་སྔ་མ་བཅུ་བཞི་ཉིད་ཀྱི་མཐར་ཡོན་ཏན་སྦྱར་བས་འོག་མ་རྣམས་ཀྱང་ཡོན་ཏན་དུ་བྱས་ན་ཡོན་ཏན་བཅུ་བཞིར་མ་ངེས་པར་འགྱུར་ལ་འདོད་ན།",
    "དེ་ནས་བྱང་ཕྱོགས་ཀྱི་རྒྱུད་དུ་དར་བར་གསུངས་པ་དང་།",
    "ལྷོ་བྱང་ནི་རྡོ་རྗེ་གདན་ལ་ལྟོས་ནས་འཇོག་པར་འདོད་དོ།",
    "ཁ་ཅིག་དེ་བཞིན་གཤེགས་པ་འདས་ནས་མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱིས་ལྷོ་ཕྱོགས་ནས་ཡུམ་དར་བར་བྱས་པས་དང་པོར་དེར་དང་།",
    "དེ་ནས་རྒྱ་གར་ཤར་ཕྱོགས་དང་དེ་ནས་རྒྱ་དང་བོད་ལ་སོགས་པར་དར་བའོ་ཞེས་འདོད་དོ།",
    "ལྔ་བརྒྱ་ཐ་མ་ཞེས་པ་ནི་བསྟན་པ་ལོ་ལྔ་སྟོང་གནས་པ་ལ་ཕྱེད་ཕྱེད་དུ་བྱས་པས་ལྔ་བརྒྱ་པ་ཕྲག་བཅུའོ།",
    "སྤྱིར་ལོ་ལྔ་སྟོང་མཐུན་ནོ་ཞེས་རང་ལུགས་དང་གཞན་ལུགས་གཉིས་བྱས་སོ།",
    "ཚེ་བརྗེས་ཀྱང་ཡུམ་ངེས་པར་འཐོབ་པ་ཞེས་བྱ་བའི་ཡོན་ཏན་གྱི་བར་རྣམས་ཏེའོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ལས་རྣམ་མཁྱེན་གྱི་གཏམ་བརྗོད་པ་རྙེད་པ་དང་།",
    "ཡང་ནི་ཡོན་ཏན་ལ་བྲོད་པ་བསྐྱེད་ནས་སྒོམ་དགོས་པར་མ་ཟད་པའོ།",
    "སྦྱོར་བའི་སྐྱོན་ནི་བཅུ་ཚན་བཞི་དང་དྲུག་ཏུ་བཅས་པ་ངེས་པར་རྟོགས་པར་བྱའོ།",
    "སྦྱོར་བའི་ལམ་ལ་རྣམ་པར་བཞག་སྟེ།",
    "དེ་ལྟར་ན་ཡོན་ཏན་ནི་རིམ་གྱིས་ལམ་གོང་མ་གོང་མ་ལ་ལྡན་ལ་སྐྱོན་ནི་ལམ་འོག་མ་འོག་མ་ལ་ལྡན་པར་རིག་པར་བྱའོ་ཞེས་པ་ལྟར་ཚོགས་ལམ་དང་སྦྱོར་ལམ་གཙོ་ཆེ་ལ།",
    "དེ་ལ་བདུད་ཀྱི་ལས་ཞེས་བྱ་བ་ཡང་ཁ་ཅིག་ནི་བདུད་ཉིད་ཀྱིས་བར་ཆད་བྱས་པའོ།",
    "དང་སྦྱར་ཞིང་རིག་པར་བྱའོ།",
    "ཡུམ་ཤེས་པར་རུང་བའི་ཤེས་པ་སུན་འབྱིན་པས་སྦྱོར་བའི་སྐྱོན་ཏེ།",
    "སྔོན་དང་ཕྱི་མཐའ་མ་བརྟགས་པར་ཡུམ་ཤེས་པའི་སྤོབས་པ་ཧ་ཅང་མྱུར་བ་སྐྱེ་ཞིང་དེས་རློམ་པ་སྟེ།",
    "གཉེན་བཤེས་སོགས་ལ་སེམས་རྣམ་པར་གཡེང་བ་བདག་གཞན་ལ་བརྟེན་ནས་དགའ་བར་བྱ་བའི་ཡུལ་ལ་ཕན་ཚུན་ཆགས་པ་ཡུམ་འདིའི་རོ་མི་མྱོང་ངོ་ཞེས་སྟན་ལས་ལངས་ནས་གུད་དུ་འགྲོ་བའི་སེམས་ཀྱི་གནས་ངན་ལེན་ཏེ་དེའི་གཡེང་བ་དང་།",
    "བྱང་སེམས་ཀྱི་སྐྱོན་མེད་པར་མ་ཞུགས་པ་ལུང་མི་སྟོན་པས་ལུང་མ་བསྟན་པ་ན་བདག་ལུང་མ་བསྟན་ཏོ།",
    "འདིར་ཡི་གེ་དང་ཡི་གེར་འདྲི་བའི་ཁྱད་པར་ནི་བྲིས་ཟིན་མ་ཟིན་ནོ།",
    "ཡང་ན་འདི་ཡང་ཐེག་ཆེན་འདོར་བའི་རྒྱུར་བྱས་ནས་བརྒྱད་དུ་བྱའོ།",
    "དག་ནི་གཉིས་ཚིག་སྟེ་འོག་མར་ཡང་དེ་གསུམ་ཤེས་པར་བྱའོ།",
    "ཡང་གཉིས་ཀར་འགྱུར་བས་གོ་རིམ་ངེས་པར་བསྟན་པའི་ཆེད་དོ།",
    "སྡུད་པར་ཡང་།",
    "བདུད་བཞིས་ཐུབ་པར་དཀའ་ཞིང་བསྐྱོད་པར་མི་ནུས་ཏེ།",
    "དེ་ལ་རང་རྒྱུད་ལ་སྦྱོར་བ་སྐྱེས་པ་ཤེས་པར་བྱེད་པ་ན་མཁྱེན་གསུམ་དང་།",
    "བ་མཚོན་པར་བྱེད་དོ།",
    "བྱ་བའི་ཁྱད་པར་ཡོད་ན་འབྲས་བུའི་ཁྱད་པར་འགྲུབ་པའི་ཕྱིར་དེས་ཀྱང་སྦྱོར་བ་མཚོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཞེས་བྱེད་པའམ་བྱ་བའི་ཁྱད་པར་རྒྱུར་ཡོད་པའི་འབྲས་བུ་ཁྱད་པར་བས་མཚོན་པ་ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་ཀྱི་དོན་དུ་འཆད་དེ་ཇི་ལྟར་མཚོན་ཚུལ་ནི་མ་བསྟན་ཏོ།",
    "དེ་ལ་བརྟེན་ནས་འཇིག་རྟེན་འཇིག་མེད་དུ་མཁྱེན་པའི་ཕྱིར་ཡུམ་འདིས་དེ་བཞིན་གཤེགས་པ་སྐྱེད་པ་དང་དེ་བཞིན་གཤེགས་པ་ལ་འཇིག་རྟེན་སྟོན་པའོ་ཞེས་གསུངས་པས་སོ།",
    "སྟོབས་བཅུ་སྐྱེད་པ་དང་འཇིག་རྟེན་འཇིག་མེད་དུ་མཁྱེན་པ་དེ་ལ་བརྟེན་པར་གསུངས་པ་ནི་མཚན་ཉིད་དོ།",
    "མཚན་ཉིད་ཕྱི་མ་གསུམ་གྱི་མཚོན་ཚུལ་ནི་རང་ལུགས་ཀྱི་སྐབས་སུ་འཆད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མཁྱེན་གསུམ་གྱི་སྦྱོར་བ་ལ་འདོད་ན་ཡང་མི་འཐད་དེ།",
    "མཚན་ཉིད་ཀྱིས་སྦྱོར་བ་སྐྱེས་པ་ཤེས་པར་བྱེད་པར་ཁས་བླངས་པ་དང་འགལ་ལ།",
    "དེ་ནམ་ཡོད་པར་གྲུབ་པ་ན་སྦྱོར་བ་སྐྱེས་པར་གྲུབ་པས་དེ་ལ་སྦྱོར་བ་སྐྱེས་པར་དཔགས་པ་དོན་མེད་དོ།",
    "དེས་ན་འདིའི་འཁྲུལ་གཞི་ནི་ཤེས་ཁྱད་བྱེད་པ་གསུམ་པོ་ཤེས་བྱེད་དང་མཚན་ཉིད་ཐ་མ་ཤེས་པར་བྱ་རྒྱུར་བསྟན་པས་བྱས་སོ།",
    "ཤེས་མཚན་ལ་མཁྱེན་གསུམ་དུ་འདིར་གསུངས་པ་ནི།",
    "ཁྱད་མཚན་ལ་སློབ་དཔོན་གྱི་གཞི་ཤེས་མ་གསུངས་པས་མཁྱེན་གསུམ་དུ་བྱེད་པ་ནོར་རོ།",
    "ཐ་མའི་མཚོན་ཚུལ་ལ་མཚན་ཉིད་དང་ལྡན་པ་བཞིན་དུ་མཚོན་པར་བྱེད་ཅེས་དོན་གཞན་མེད་ཀྱང་ཡོད་པ་ལྟར་མཚོན་པར་བྱེད་པ་དེ་ལ་དམིགས་ཀྱིས་བཀར་ནས་གསུངས་པ་ཡང་མི་རིགས་ཏེ།",
    "འཁྲུལ་པ་འདི་དག་ཀྱང་འདིའི་མཚན་མཚོན་དེ་དག་རྣམ་པར་བཞག་འཇོག་མཚན་ཉིད་པར་བཟུང་བས་ནོངས་སོ།",
    "ཁྱད་པར་གྱི་མཚོན་ཚུལ་ལོ།",
    "དངོས་པོ་གཅིག་ལ་ཡང་ལོག་ས་ལ་ལྟོས་ནས་ལྡོག་པ་དུ་མ་དང་ལྡན་པའི་ལྡོག་ཆ་ནི་རྣམ་པར་དབྱེ་བའི་མཚན་ཉིད།",
    "འདིར་ནི་རང་བཞིན་གྱི་མཚན་ཉིད་གཟུང་ངོ་དེ་ཡང་མཚོན་པར་བྱེད་པའི་མཚན་ཉིད་ནི་ཤེས་པ་དང་ཁྱད་པར་དང་བྱེད་པ་རྣམས་ཏེ།",
