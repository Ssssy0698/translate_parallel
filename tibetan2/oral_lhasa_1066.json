    "དྲི་མ་མཐའ་དག་དྲུངས་ནས་འབྱིན་པར་ཤོག།",
    "གང་ཡང་བདག་བློ་྾ མ་རྙེད་ཡོངས་སུ་྾ ལྷག་པ་དང་ནི་བདག་ལ་དངོས་གྲུབ་྾ ཅེས་སོགས་ཀྱིས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "མདུན་བསྐྱེད་ཀྱི་སྤྱན་དྲངས་པའི་ཡེ་ཤེས་པ་རྣམས་བསྒྲུབ་གཞིའི་དཀྱིལ་འཁོར་འདི་ཉིད་ལ་བརྟན་པར་བཞུགས་ནས།",
    "ཞེས་རས་བྲིས་ལ་བརྟན་བཞུགས་བྱ།",
    "ཤེས་པར་གྱིས་ལ་ཡིད་དགའ་སྐྱེད་ཅིག་དང་།",
    "ལེགས་པར་འབྱེད་པ་མཁས་པའི་ཡོན་ཏན་ཏེ་།",
    "ཕན་ཚུན་བསྲེ་ཞིང་ཆོ་གའི་འགྲོས་མེད་པར།",
    "མཐུན་རྐྱེན་རྣམ་པར་དག་པའི་འབྱོར་པ་ཡིས།",
    "དཔར་དུ་བསྒྲུབ་པའི་དགེ་ཚོགས་རྒྱ་མཚོའི་མཐུས།",
    "སྤྲོ་ན་བུམ་པ་དང་མདུན་བསྐྱེད་བསྒྲུབ་སྟེ་བདག་འཇུག་བླང་ན་ཕུན་སུམ་ཚོགས་པར་འགྱུར།",
    "དེ་ལས་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་རྒྱུན་བབས་པས་བུམ་པའི་ཆུ་དང་རོ་གཅིག་ཏུ་གྱུར་པར་བསམས་ལ།",
    "འོག་ཏུ་དགོས་པའི་ཡོ་བྱེད་རྣམས་ཚོགས་པར་བྱས་ལ།",
    "ཚེ་འདས་ཀྱི་སྡིག་སྒྲིབ་བག་ཆགས་དང་བཅས་པ་སྦྱངས་པར་གྱུར།",
    "མགྲིན་པར་ཨཱ་དམར་པོ།",
    "ཐུགས་ཀར་ཧཱུཾ་སྔོན་པོས་མཚན་པར་གྱུར།",
    "རྣམ་པ་རཾ་ལས་སྐྱེས་པའི་ཡེ་ཤེས་ཀྱི་མེ་འབར་བས་ཚེ་འདས་ཀྱི་སྡིག་སྒྲིབ་དང་བྱང་བུ་ལྷན་ཅིག་སྲེག་པར་བསམ་ལ།",
    "གསོན་ཅིག་དགོངས་ཤིག་དོན་ལ་འགྲུབ་པར་ཤོག།",
    "ཞེས་འཁོར་གསུམ་མི་དམིགས་པའི་རྒྱས་བཏབ་པར་བྱའོ།",
    "ཁམས་དང་སྐྱེ་མཆེད་ཡུལ་དང་ཡན་ལག་རྣམས་དང་དབྱེར་མི་ཕྱེད་པར་གྱུར།",
    "ཚེ་བའི་ཆེ་མཆོག་སོགས་ཀྱིས་ཤིས་པ་བརྗོད་པར་བྱ།",
    "དཔར་དུ་བསྒྲུབས་པའི་དགེ་ཚོགས་རྒྱ་མཚོའི་མཐུས།",
    "རྣམ་མཁྱེན་རྒྱལ་བའི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "རྡོ་རྗེ་གསུམ་གྱིས་སའི་ཉེས་སྐྱོན་ཐམས་ཅད་སྦྱངས་པར་གྱུར་པར་བསམས་པ་ཀུན་རྫོབ་ཀྱི་དག་པ་དང་།",
    "སའི་ཉེས་སྐྱོན་ཐམས་ཅད་རང་བཞིན་གྱིས་གྲུབ་པས་སྟོང་པའི་སྟོང་པ་ཉིད་དུ་གྱུར་པར་བསམ་པ་དོན་དམ་པའི་སྦྱང་བ་བྱ་ས་གཞི་རང་བཞིན་གྱིས་དཀར་བའམ།",
    "ས་དཀར་པོས་བྱུགས་པའི་སྟེགས་བུ་སྐྱུང་ནུལ་ལེགས་པར་བྱས་ལ།",
    "མདུན་དུ་མེ་ཡོལ་དཀར་རྩིས་བྱུགས་པར་ཝཾ་ཡིག་བྲིས་པ་བཞག་ཐབ་ཀྱི་གཡས་ངོས་སུ་སྟེགས་བུ་མཆོད་གདན་དཀར་པོ་བཏིང་བ་ལ།",
    "ཤིང་མཉམ་པར་བཅད་པའི་རྩ་རྩེ་གཉིས་སྦྲང་རྩི་དང་འོ་མ་དང་མར་དུ་བསྟུགས་པ་ལ་དྲིའི་ཆུས་བྲན་པ།",
    "ཞོ་ཟན་འབྲས་དཀར་རླངས་ཚོས་བྱས་པ་མངར་གསུམ་དང་ཞོས་སྦགས་པ།",
    "ཁྱད་པར་གྱི་རྫས་ནི།",
    "ཐབ་ཀྱི་གཡས་དང་ཉེ་བར་ཕད་དཀར་འདབ་བརྒྱད་བྲིས་པར་དགར་གཟར་བླུགས་ཁ་སྦྱར་བ།",
    "མཆོད་སྦྱིན་གྱི་བྱ་བ་ལ་སོགས་པ་སྒྱུ་མ་ལྟ་བུར་ཤེས་པ་སོགས་ཟབ་གསལ་དབྱེར་མེད་པའི་རྣལ་འབྱོར་དང་མི་འབྲལ་བར་བྱས་ལ།",
    "རྫས་སྤྱི་རྣམས་བཀྲུས་པར་བསམས་ལ།",
    "ཨོཾ་བཛྲ་སཏྭ་ཨཱ་ཞེས་པ་ལན་བདུན་གྱིས་བྱིན་བརླབས་བྱས་ཏེ།",
    "ཨོཾ་ཀུ་ཤ་འདི་ནི་གཙང་ཞིང་དགེ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་བགེགས་ཐམས་ཅད་ཞི་བ་དང་བཀྲ་ཤིས་པར་མཛད་དུ་གསོལ།",
    "དྭངས་ཤིང་ཐོགས་པ་མེད་པར་གྱུར།",
    "སྲེག་བླུགས་ཞལ་ཟས་བཞེས་སླད་དུ།་",
    "འདིར་ནི་ཡང་དག་བསྙེན་པར་མཛོད།",
    "ཊ་ཀྐི་ཧཱུཾ་ཛཐབ་ཀྱི་ཁ་ཁྱེར་གྱི་མེ་མཚམས་ཀྱི་ཀུ་ཤའི་གདན་ལ་བཞུགས་པར་གྱུར་པར་བསམ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།་",
    "དེ་བཞིན་དུ་པྲོ་ཀྵ་ཎཾ་གྱི་གནས་སུ་ཨཉྩ་མ་ཎཾ་སྦྱར་ཏེ་ལགཔ་ཁུ་ཚུར་བཅངས་པའི་མཐེབ་མཛུབ་ཀྱིས་སྣོད་གསུམ་པ་ནས་མེ་ཏོག་དང་བཅས་པའི་ཆུ་བླངས་ནས་བཟེད་ཞལ་གསུམ་པར་རང་ལ་ཕྱོགས་པར་ཞལ་ཆུ་ཕུལ་ཏེ་ཁུ་ཚུར་ཁ་འོག་ཏུ་བསྟན་ནས་མཐེའུ་ཆུང་ནས་རིམ་གྱིས་དགྲོལ་བ་ཞལ་བསིལ་བ་དང་།",
    "བདག་མདུན་གྱི་ཆོ་གའི་སྐབས་སུའང་བཤམ་བརླབ་དབུལ་གསུམ་ག་མཆོད་ཡོན་སྔོན་དུ་འགྲོ་བའང་དེ་བཞིན་ཡིན་ལགས་སོ།",
    "འཛིན་བྱེད་མེ་ལྷ་ཉིད་ལ་རྣམ་པར་འདུད།",
    "རིག་སྔགས་གསུངས་ཤིང་བགྲང་ཕྲེང་འཛིན།",
    "ཉེས་པའི་སྐྱོན་བྲལ་ཚངས་པར་སྤྱོད།",
    "དགང་བླུགས་ཀྱི་ཁ་ལ་ཧཱུཾ་ཡིག་འོད་ཟེར་དང་བཅས་པས་མཚན་པར་གྱུར་པར་བསམ།",
    "ཁྱད་པར་དུ་འདོད་དོན་ཕུན་སུམ་ཚོགས་པ་ལ་བར་དུ་གཅོད་པ་ཐམས་ཅད་ཤིནྟཾ་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "བདག་ཅག་དཔོན་སློབ་ནས་ཁྱད་པར་དུ་གཟི་བརྗིད་ཕུན་སུམ་ཚོགས་པ་ལ་བར་དུ་གཅོད་པ་ཐམས་ཅད་ཤིནྟཾ་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "བདག་ཅག་དཔོན་སློབ་ནས་ཁྱད་པར་དུ་འབྱོར་བ་ཕུན་སུམ་ཚོགས་པ་ལ་སོགས་ཀྱིས་མར་ཁུ།",
    "བདག་ཅག་ནས་ཁྱད་པར་དུ་བདེ་བ་མཆོག་ལ་སོགས་ཀྱིས་ཞོ་ཟན།",
    "བདག་ཅག་ནས་ཁྱད་པར་དུ་བསྲུང་བ་མཆོག་ལ་བར་དུ་གཅོད་པ་དང་གྲིབ་དང་མི་གཙང་བ་ཐམས་ཅད་ཤིནྣཾ་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "བདག་ཅག་ནས་ཁྱད་པར་དུ་བགེགས་ཐམས་ཅད་ཤིནྟཾ་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "བདག་ཅག་ནས་ཁྱད་པར་དུ་ནོར་དང་འབྲུ་རྒྱས་པ་ལ་སོགས་ཀྱིས་སོ་བ།",
    "བདག་ཅག་ནས་ཁྱད་པར་དུ་མྱུར་བའི་ཤུགས་ཕུན་སུམ་ཚོགས་པ་ལ་སོགས་ཀྱིས་ནས།",
    "བདག་ཅག་ནས་ཁྱད་པར་དུ་སྟོབས་རྒྱས་པ་ལ་སོགས་ཀྱིས་སྲན་མ།",
    "སློབ་དཔོན་དང་ཐབ་དང་སྒྲུབ་གྲོགས་དང་བཅས་པ་ལ་བསྐོར་བ་གསུམ་བྱས་ཏེ།",
