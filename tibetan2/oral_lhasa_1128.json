    "དེ་ནས་སོ་སོ་ལ་གདན་ཕུལ་ཏེ་༡ཇི་ལྟ་བར་བཞུགས་པ་ལ་ཞལ་ཟས་ལ་སོགས་པ་དང་ཡིད་ལས་བྱུང་བའི་འབྱོར་པ་ལྷ་རྫས་ཀྱི་དྲི་དང་མེ་ཏོག་དང་བདུག་པ་དང་སྒྲོན་མེ་དང་གོས་དང་གདུགས་དང་བ་དན་ལ་སོགས་པ་ཇི་ལྟར་འབྱོར་པ་དབུལ་བར་བྱ་སྟེ།",
    "སྦྱིན་པའི་བདག་པོས་ཆུ་ཚོད་བདུན་པའི་དོན་དུ་གཟུང་༡ལགས།",
    "སྟན་ཕུལ་བ་ལ་བདག་རྗེས་སུ་གཟུང་༢བའི་སླད་དུ་བཞུགས་སུ་གསུ་གསོལ།",
    "ཇི་ལྟ་བར་བཞུགས་པ་ལ་ཞལ་ཟས་ལ་སོགས་པ་ཡིད་དང་མཐུན་པའི་ལྷ་རྫས་ཀྱི་དྲི་དང་མེ་ཏོག་ད་ང་བདུག་པ་དང་སྒྲོན་མེ་དང་གོས་དང་གདུགས་དང་བ་དན་དང་རྒྱལ་མཚན་དང་དྲིལ་བུ་ལ་སོགས་པ་ཇི་ལྟར་འབྱོར་པ་ཚིག་འདིས་དབུལ་བར་བྱའོ།",
    "བཞེས་པ་ཡོངས་སུ་རྫོགས་པ་ན་ཞལ་བསིལ་དང་།",
    "དེ་ཡང་དགོངས་ཆེན་བཟོད་པར་གསོལ།",
    "སྟོན་པའི་བསྟན་པ་སྐྱོང་མཛད་རི་མཆོག་གླིང་དང་ནིངྒི་ཛ་ལར་༥བཞུགས།",
    "ཐོབ་ནས་ཉེས་པའི་དགྲ་རྣམས་ཕམ་བྱས་ཏེ།",
    "སྲིད་པའི་མཚོ་ལས་འགྲོ་བ་འདོན་པར་ཤོག།",
    "འགྲོ་བས་ཀུན་མཁྱེན་ཐོབ་བྱའི་ཕྱིཕྱིར།",
    "སླར་ཡང་འབྱོན་པར་མཛད་དུ་གསོལ།",
    "ུ་པེ་སྣར་ལ་གནསུ་བརྟན་ཕྱག་མཆོད་ཞ་ལུ་ལོ་ཙཱ་བའི་འགྱུར་བཞུགས་སོ།",
    "པདྨ་འི་རྩ་ལག་ལྟར་དྲི་མ་མེད་པར་མཛོད་ལ།",
    "གང་ལ་གུས་པར་ཅུང་ཟད་ཙམ་ཞིག་བྱིན་ཡང་སྦྱིན་པ་འཕེལ་འགྱུར་༡༧ལ།",
    "བྱིན་ནས་དགའ་བྱས་སེམས་ཀྱི་ཏིང་འཛིན་ཤིན་ཏུ་ཆེན་པོའི་འབྲས་བུ་ཡིན།",
    "དེ་ཡང་ངེས་པར་སྦྱིན་པ་ཉིད་ཀྱི་འབྲས་བུ་རོ་བྲོ་མང་པོ་ཡིན།",
    "དེ་རྒྱུ་ཡིད་ཀྱི་༧ཏིང་ངེ་འཛིན་གྱིས་བསྐྱེད་པའི་སྦྱིན་པར་ཐུབ་པས་གསུངས།",
    "གསེར་གྱི་པདྨ་འི་རྡུལ་གྱི་བྱེ་མས་དམར་བྲིས་མཚོར་༩ནི་ཁྲུས་བྱས་ཏེ།",
    "ཚོགས་བསགས་འབྲས་དེ་སྦྱིན་པའི་ཆེ་བ་ཉིད་ཅེས་ཟས་གཙང་སྲས་པོས་གསུངས།",
    "ཡང་དག་པར་སྤོང་བ་དང་།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པའི་ཤིང་ལྗོན་པས་མཛེས་པར་༢བྱས་པ།",
    "ཡོངས་སུ་ཤེས་པས་བསྒོམས་པས་དྲན་པ་ཉེ་བར་གནས་པ་ཡང་དག་པའི་ཡེ་ཤེས་མཐོང་བས་ལོག་པར་ལྟ་བའི་རབ་རིབ་བསལ་བ།",
    "སྟོབས་བཅུ་མངའ་བས་གསུངས་པའི་ཚིགས་སུ་བ་ཅད་པ་ད་ང་།",
    "སྐྱེ་བོ་ངན་པས་རྙེད་པར་དཀའ་བ་སེར་སྣ་ཅན་གྱི་ཡིད་འཇོམས་པ་སྒྲུབ་པ་༐",
    "ཁ་ན་མ་ཐོ་བ་མེད་པར་ཞུགས་༢པ།",
    "སྐྱེ་བོ་མཁས་པ་རྣམས་ནི་སད་པར་བྱ་ཕྱིར་ཤར་གྱུར་པ།",
    "སྐྱེ་དགུ་རྣམས་ལ་ཁ་ན་མ་ཐོ་བ་༡༡མེད་པ་སྟོན་པར་༡༧མཛད་པ།",
    "ཡུལ་དང་ལྗོངས་དུ་མ་ལ་ཕན་གདགས་པར་རྩོལ་བ་མཛད་པ་ཡང་དག་པའི་དྲན་པ་དང་།",
    "ལྔའི་ཕྱིར་སྐད་ཅིག་༢ཡང་དག་པར་སོ་སོར་རྟོག་པའི་ཡིད་ལ་བྱེད་པ་བསྐྱེད་པ།",
    "ཡིད་ཀྱི་༢འཇུག་པ་དྲན་པ་ཉེ་བར་གནས་པར་རྒྱུ་བ།",
    "འཇིག་རྟེན་ཕ་རོལ་དུ་བདེ་བ་ཐོབ་པར་བྱེད་པ།",
    "གཞིབས་༡པ་ལ་སོགས་པ་ཞལ་ཟས་བཤམ་༢པར་བྱ་བ་རྣམ་པ་སྣ་ཚོགས་ཞལ་ཟས་ཁྱད་པར་ཅན་གྱིས་སྤྱན་འདྲེན་ཏོ།",
    "མཚོ་ངོགས་རྨ་བྱ་དགར་བཅས་རྒྱགས་པར་༢༢གནས།",
    "རྨ་བྱ་རྒྱགས་སྒྲས་རི་སུལ་སྙན་པར་༡གྲགས།",
    "ལྷུན་པོ་མཐོ་བའི་རི་ལ་ཐུབ་པ་གང་དག་རབ་ཏུ་ཞི་བའི་ཐུགས་ཀྱིས་བཞུགས།",
    "བརྟེན་པ་གང་དག་བཞུགས་པར་གྱུར་པ་དེ་དག་དང་།",
    "རྒྱལ་ཁྱུང་༢གནས་པ་ན་གང་དག་བཞུགས་པ་དང་།",
    "ཡང་༤དག་ཐུགས་མངའ་ཐུབ་པ་བཞུགས་དགུ་དང་།",
    "འཆར་བའི་རི་སྟེངས་༦གང་དག་བཞུགས་པ་དང་།",
    "འབིགས་བྱེད་རྨ་བྱ་རྒྱགས་གནས་པ་ན་བཞུགས་དགུ་དང་།",
    "ཀོ་ལྤགས་ལྡན་པ་གཙང་མའི་ཆུ་ཡིས་༩ངོགས་ཀྱི་རྡོ་བ་མང་པོ་བཀྲུས་གྱུར་ཅིང་།",
    "ཡོངས་འདུས་རི་རྩེ་ཕྲག་ན་གཅིག་པུ་༡༨སྲེད་དང་བྲལ་བ་གང་དག་བཞུགས་པ་དང་།",
    "གང་དག་ཤིང་༡༨དང་འཁྲི་ཤིང་རྣམ་པ་མང་པོ་འདབ་ཆགས་པར་༢༢གནས་པ།",
    "ཁོག་པས་༢རྣམ་པར་སྤྲས་པ་ཉེ་བར་འབུལ་བ་དང་ལྡན་པ་༤།",
    "གངས་རི་ཏི་སེ་ལ་ནི་བློ་གཙང་གང་ད་ག་ཞལ་ཏོན་༡༧མཛད་ཅིང་བཞུགས་པ་དང་།",
    "རི་བོ་མན་ད་ར་ལ་ཉིན་ཕྱེད་ཚུན་ཆད་བཞུགས་བཞུགས་ཤིང་།",
    "ཉི་མ་ཕྱེད་པར་གྱུར་ནས་གང་དག་གཞན་དུ་བཞུགས་པའི་ཕྱིཕྱིར།",
    "ངང་པའི་ཚོགས་ཅན་ཤིན་ཏུ་གཙང་བ་དྲག་འབབ་ཆར་གྱི་ཆུ་ཡིས་རི་འགབ་༡༨བཀྲུས་གྱུར་ཅིང་།",
    "གང་དག་མུན་བསལ་ཁྱད་པར་ཅན་གྱི་བློས་༢།",
    "གཟི་རྡོ་ནགས་རྣམས་མི་སྤོང་བཞུགས་པ་དང་།",
    "རྣམ་པར་རྒྱལ་བའི་གྲོང་དང་།",
    "སྙོམས་པར་ཞུགས་པ་དང་།",
    "ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པས་འཇུག་པ་དག་པའི་དགྲ་བཅོམ་པ་རྣམས་བཞུགས་བཞུགས་པ།",
    "འཚོག་ཆས་༡༧རྣམས་ཀྱིས་ལེགས་པར་བྱས་པས་མཐའ་མཐའ་ན་༢༢ཆུའི་གནས་ཡོད་པ་ལ་ཉེ་བར་སྤྱོད་པས་ཉམས་དགའ་བ།",
    "ཚེའི་ལྷག་མ་གནས་པར་མཛད་པ་རྣམས་དང་།",
    "སེར་༢༢བུས་ན་བཟའ་གཡོ་བ་གང་དག་ཉི་མའི་གུང་ལ་བཞུགས་པ་དང་།",
    "རྨང་རྡོ་དང་རྩིག་ངོས་ཤག་ཤིག་ཏུ་གྱུར་པའི་མཚམས་སུ་༡༧བ་རྒྱ་ཆགས་༐",
    "འུག་པ་མང་པོ་སྒྲ་འབྱིན་ཅིང་གླུ་ལེན་པ་ལྟ་བུ་ཡོད་པའི་གྲོང་སྟོང་སུས་ཀྱང་ཏིང་ངེ་འཛིན་མ་བྱས་པ་རྣམས་ན།",
    "སྣོད་གྱུར་བདག་༥ཉིད་ཐུགས་ལྡན་གཙང་མའི་ལྷུང་བཟེད་ཕྱག་བསྣམས་ཤིང་།",
    "གཎྜཱི་བརྡུངས་༧པའི་སྒྲ་སྙན་སྐད་གསང་གྲགས་པར་གྱུར་པའི་ཚེ།",
    "རྒྱུན་མི་འཆད་པར་ཏིང་ངེ་འཛིན་དང་།",
    "དེ་ད་ག་དགྱེས་པར་མཛོད་ལ་སྦྱིན་བདག་ཕན་པར་བཞེད་པས་སང་འདིར་སྤྱོན།",
    "རྒྱུན་མི་འཆད་པར་བསྲུང་བ་དང་།",
    "བསྐྱང་བ་ལ་བརྩོན་པར་མཛོད་ཅིག།",
    "རྒྱ་མཚོ་རྒྱས་པར་གནས་པ་དེ་སྲིད་ལྷ་དང་ལྷ་མིན་ཕྱག་བྱས་པའི།",
    "བདེ་བར་གཤེགས་ཀྱི་བསྟན་པ་ཐོགས་པ་མེད་པར་༡གནས་པར་ཤོག།",
    "པེ་སྣར་པར།",
    "༩པེ་པར།",
    "༡༨པེ་སྣར་པར།",
    "༩པེ་སྣར་ཟས་༡པེ་སྣར་པར།",
    "༡༧པེ་སྣར་རྣམ་པར་རྒྱལ་པའི་གྲོང་ད་ང་།",
    "ཀྱང་གར་གྱི་རྗེ་ཞེས་བྱ་བའི་ཚོང་དཔོན་གྱི་བུ་རུ་མགོ་བོའི་རི་བོ་ལ་གཙུག་ལག་ཁང་མཛད་ནས་འཕགས་པ་ཉེར་སྦས་རབ་ཏུ་ཕྱུང་ཞིང་བསྙེན་པར་རྫོགས་ནས་དགྲ་བཅོམ་པར་གྱུར་ཏེ།",
    "ཕུག་སྲིད་དུ་ཁྲུ་བཅོ་བརྒྱད་པ་རྒྱར་ཁྲུ་བཅུ་གཉིས་པར་གནས་ན་ས།",
    "མྱ་ངན་མེད་ཅེས་བྱ་བའི་རྒྱལ་པོ་ཉིད་ཤི་ནས་ཁ་ཆེར་ལེགས་མཐོང་བྱུང་སྟེ་མ་དང་ཕ་ད་ག་ལས་དེ་ལ་སེང་གེ་ཞེས་བྱ་བའི་མིང་དུ་གྲུབ་པ་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་སྟེ་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་ས་སོ།",
    "ཡུལ་ཀོ་ཤཱམྦཱིར་ནུབ་པར་འགྱུར་བ་ལྟ་ཞིག་ན།",
    "སློབ་དཔོན་སྟོན་པ་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་བསྟན་པ་ལོ་ཉིས་སྟོང་ནས་འཇིག་པར་ལུང་བསྟན་ན།",
    "ལི་ཡུལ་འདི་ལ་སོགས་པ་ཡུལ་གཞན་གྱི་བསྟན་པ་ཇི་སྲིད་དུ་གནས་པར་འགྱུར།",
    "བདེ་བར་གཤེགས་པའི་བསྟན་པ་ཡུན་རིང་དུ་གན་ས་པར་བྱ་བའི་ཕྱིར་ཐེ་ཚོམ་དྲིས་པ་ལེགས་ཀྱིས།",
    "ལེགས་པར་ཉོན་ལ་ཡིད་ལ་ཟུང་༤ཤིག་དང་།",
    "ལི་ཡུལ་ལ་སོགས་པའི་བསྟན་པ་ཇི་སྲིད་དུ་གནས་པར་འགྱུར།",
    "ཡུལ་ཡང་རྒྱལ་པོས་ཕན་ཚུན་རྟོད་ཅིང་འཕྲོག་༦པར་འགྱུར་རོ།",
    "དེ་ཕྱིན་ཆད་ནི་ཡུལ་ཡང་ཉིན་གཅིག་བཞིན་དུ་ཉམས་པར་འགྱུར།",
    "ཆོལ་གྱི་༢ལོངས་སྤྱོད་ཀྱང་སོགས་པར་བྱེད་པར་འགྱུར་རོ།",
    "ཁྱིམ་པས་བསླབ་པར་བྱ་བའི་བཟོ་དང་།",
    "དེའི་ཚེ་ལི་ཡུལ་ལ་སོགས་པར་རྒྱལ་པོ་དང་།",
    "གནས་ཀྱིས་ཕོངས་༦པར་འགྱུར་ར་རོ།",
    "ལྡུམ་ར་ལ་སོགས་པ་ཡོ་བྱད་རྣམས་ཀྱང་བཙན་ཐབ་༧སུ་འཕྲོག་པར་བྱེད།",
    "བཅོམ་ལྡན་འདས་ཀྱི་༧བྱས་པ་གཟོ་བ་ཐམས་ཅད་ཀྱང་གཙུག་ལག་ཁང་དེར་འདུས་ཏེ་གཅིག་ལ་གཅིག་ལྟ་༨ཞིང་འདི་སྐད་དུ་བདེ་བར་གཤེགས་པའི་བསྟན་པ་ནི་ཡུན་རིང་པོར་༩མི་གནས་སོ།",
    "ཡུལ་འདི་ཡང་སྟོངས་པར་འགྱུར་རོ་ཞེས་མྱ་ངན་བྱེད་ཅིང་ངུ་བར་འགྱུར་ར་རོ།",
    "དེའི་ཚེ་དགེ་སློང་དེ་དག་འདི་སྙམ་དུ་ཡུལ་འདིར་ནི་འཚོ་བ་མི་འབྱོར་༡ན་འདི་བོར་ཏེ་ཡུལ་གཞན་དུ་འགྲོ་བར་བྱའོ་སྙམ་དུ་སེམས་མཐུན་པར་གྱུར་པ་གང་དུ་འདོད་པར་བྱ་ཞེས་གྲོས་བྱས་ཏེ།",
    "དེའི་ཚེ་ལི་ཡུལ་ན་གནས་པའི་ཀླུ་ཐམས་ཅད་འདི་སྙམ་དུ་བདེ་བར་གཤེགས་པའི་བསྟན་པ་ནི་རྨེགས་༡༧མེད་པར་འགྱུར་༡༡ལ་ཐུག་གོ་སྙམ་དུ་མྱ་ང་ན་བྱེད་ཅིང་བསྟན་པ་གནས་པར་༐",
    "དེའི་ཚེ་མི་རྒན་རྒོན་རྣམས་ནི་བསླབ་པ་འཛིན་པར་བྱེད།",
    "ལྟ་བཞིན་པར་༢མེ་སྐར་གྱི་ལམ་དུ་ཞུགས་ཏ་འགྲོ་བར་འགྱུར་རོ།",
    "གཟོ་༦བོ་དང་གནང་ཆེན་རྣམས་དྲུང་དུ་བོས་ཏེ་ངུས་ནས་འདི་སྐད་ཅེས།",
    "དྲང་བར་༨ཅི་གནང་ཞེས་གསོལ་པས་རྒྱལ་པོས་ཀྱང་གནང་བར་འགྱུར་ཏེ།",
    "དེའི་ཚེ་བོད་ཡུལ་གྱི་༩རྒྱལ་པོ་དང་བློན་པོ་རྣམས་ཀྱིས་དགེ་སློང་དེ་དག་མཐོང་ནས་དད་པ་ཆེན་པོ་སྐྱེ་ཞིང་གཙུག་ལག་ཁང་ཆེན་པོ་བདུ་ན་ཡང་བརྩིག་༡པར་འགྱུར་རོ།",
    "རྫས་ལྷག་མ་འདི་རྣམས་ཀྱང་ཡུལ་འདིར་མི་གཞག་༦ཅིང་ས་མཚམས་འདས་ཏེ་བསྐྲད་པར་བྱའོ་ཞེས་གྲོས་བྱས་ནས་དགེ་སློང་གཅིག་ཀྱང་བོད་ཡུལ་དུ་གནས་སུ་མི་གནང་ངོ་ཞེས་ཀློ་བུར་དུ་བསྒོ་བར་འགྱུར་རོ།",
    "བྱས་ནས་ལྷན་ཅིག་ཏུ་༢འགྲོ་བར་འགྱུར་རོ།",
    "སྐྱེ་བོ་དང་རྩོད་པའི་དུས་དེའི་ཚེ་རྒྱ་ཡུལ་གྱི་དགེ་སློང་རྣམས་ཀྱང་ཤིན་ཏུ་སྡུག་བསྔལ་བས་གཟིར་ནས་ཡུལ་གན་དྷ་རར་འགྲོ་བར་འགྱུར་རོ་། དེ་ལྟར་དོང་བ་དང་དགེ་སློང་དེ་དག་ཐམས་ཅད་ཡུལ་གན་དྷ་རར་འགྲོ་བའི་ལམ་ཀར་ཕྲད་པར་འགྱུར་ར་རོ།",
    "ནོར་ཕྱུགས་དག་ཕྲོགས་ཏེ་དགེ་སློང་དག་ཀྱང་གསོད་པར་འགྱུར་ར་རོ།",
    "བདག་ནི་དེའི་ཤུལ་དུ་བཞུད་པར་མི་དགའ་ཞིང་མཆིས་ས་སོ།",
    "རྣག་ཁྲག་ཀྱང་༢འཛག་པར་འགྱུར་རོ།",
    "མཚོ་དེ་ཡང་སྐམས་པར་འགྱུར་ཏེ།",
    "དེ་དག་༤ཐམས་ཅད་ཀྱིས་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཐོབ་པར་འགྱུར་རོ།",
    "ཕྱོགས་གཉིས་སུ་ཆད་པར་འགྱུར་ར་རོ།",
    "དྲུ་གུ་རུས་སྣ་ཚོགས་དུ་མིའི་༧རྒྱལ་པོ་ནི་དྲུ་༨གུས་བྱེད་པར་འགྱུར་ར་རོ།",
    "གཞན་ཡང་དག་པའི་ལྟ་བ་འཛིན་པའི་ཡུལ་ཐམས་ཅད་བཅོམ་ནས་མི་མང་པོ་ཁ་བཏགས་༡༧ནས་གྲོང་ལ་སོགས་པ་ཡང་སྟོངས་པར་འགྱུར་རོ།",
    "དེ་ནས་རྒྱལ་པོ་དེ་གསུམ་འདུས་ནས་ཡུལ་དབུས་སུ་དམག་དྲངས་ཞེས་གྲོས་བྱེད་པར་འགྱུར་ར་རོ།",
    "རྒྱལ་པོ་དད་པ་མེད་པ་དེ་གསུམ་དམག་དང་བཅས་ཏེ་གཏན་མེད་པར་བརླག་པར་འགྱུར་ར་རོ།",
    "དགེ་སློང་ཤིར་ཤ་ཀ་ཤིན་ཏུ་སྐྱེངས་པར་༩འགྱུར་ར་རོ།",
    "ད་ཁྱེད་གཉིས་ནོངས་པས་འཇིག་རྟེན་འདི་སྟོངས་པར་གྱུར་ཏོ་ཞེས་སྨྲ་བར་འགྱུར་ར་རོ།",
    "རྒུན་དང་སྦྲང་རྩི་ཐམས་ཅད་ཀྱང་ནུབ་པར་འགྱུར་ར་རོ།",
    "དེ་ནས་ནས་དང་གྲོ་དང་འབྲས་ཐམས་ཅད་ནུབ་པར་འགྱུར་ཏེ།",
    "ཚོན་བཟང་པོ་དང་རོ་ཞིམ་པོ་རྣམས་ཀྱང་ནུབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་རྣམས་ཀྱང་ཀླུའི་གནས་སུ་འཁྱེར་བར་འགྱུར་ར་རོ།",
    "༩པེ་སྣར་གྱུར་པར།",
    "༡༧པེ་སྣར་བྱས་པའི།",
    "༧པེ་སྣར་འཇིགས་པར་འགྱུར།",
    "༨པེ་སྣར་བཏག་༩པེ་སྣར་འདུས་པར།",
    "སང་གྷ་བརྦྷ་ན་ཞེས་བྱ་བའི་དགྲ་བཅོམ་པ་ཞིག་བཞུགས་ཏེ།",
    "མཆོད་རྟེན་བཞུགས་པ་རྣམས་དུས་ཇི་ཙམ་ཞིག་ན་ན་ནུ་བ།",
    "ཧོར་ལ་སོགས་པ་དགྲ་ཕལ་ཆེར་གཡོས་ནས་རྩོད་ཅིང་འཁྲུག་པར་འོང་སྟེ།",
    "ཉིས་བརྒྱ་ལྔ་བཅུ་ནི་རབ་ཏུ་བྱུང་བའི་ཚུལ་དུ་བཞུགས་ཉིས་བརྒྱ་ལྔ་བཅུ་ནི་ཁྱིམ་པའི་ནང་དུ་སྐྱེ་བ་བླང་ས་ཏེ་བཞུགས།",
    "དྲང་བར་༡༧ཅི་གནང་ཞེས་གསོལ་ནས་གནང་སྟེ།",
    "ནོར་ཕྱུགས་རྣམས་ད་ཀོན་མཆོག་གསུམ་ལ་མ་གུམ་པར་འབུལ་ལོ་ཞེས་གསོལ་ཏེ་ཕུལ་ལ་ལོ།",
    "བློན་པོ་དང་ཞང་བློན་ལས་ཀྱང་མང་དུ་གུམ་པས་བན་དེ་འདི་ཀུན་ཡང་རྒྱལ་ཁམས་སུ་མི་གཞག་༢པར་བསྐྲད་པའི་རིགས་ཞེས་གསོལ་བ་ལས་རྒྱལ་པོས་འདི་བསྐྲད་པའི་རིགས་སམ་མི་རིགས་ད་དུང་ཞིབ་ཏུ་དཔྱོད་ཅིག་ཅེས་བསྒོ་བ་ལས་བློན་པོ་རྣམས་བན་དེ་བསྐྲད་པར་ཁ་འདུས་ནས་རྒྱལ་པོ་ལ་གསོལ་ཏེ།",
    "རྒྱལ་ཁམས་སུ་བན་དེ་རིལ་གྱིས་མི་གནས་པར་གྲོས་ཆད་ནས་ཀུན་བསྐྲད་པ་ལས་གདོང་དམར་གྱི་དགེ་སློང་ཁྲོས་ཏེ།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་དེས་༡རི་གར་འཛེག་པའི་ལམ་ཞིག་སྣང་བར་བྱས།",
    "ལྡན་པར་གྱུར་ནས་༨ལོ་ཕྱེད་ལོན་པ་དང་།",
    "ཀོ་ཤཱམྦཱིའི་ཡུལ་དུ་དྲངས་པས་ཀོ་ཤཱམྦཱིའི་རྒྱལ་པོས་དམ་ག་སུམ་འབུམ་རྒྱལ་པོ་དང་བཅས་ཏེ་གཅིག་ཀྱང་མ་ལུས་པར་བྱས་སོ།",
    "ལི་ཡུལ་མཚོར་གྱུར་པར་གཤེགས་ནས་ད་ལྟར་ཆུ་བོ་ཤེལ་ཆབ་མགོ་མའི་འགྲམ་ན་ཆབ་ཀྱི་སྟེང་པདྨ་འི་གདན་ལ་བཞུགས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པས་ཀྱང་ལི་ཡུལ་མཚོར་གྱུར་པ་འོད་ཟེར་གྱིས་ཁྱབ་པར་མཛད་ནས་འོད་ཟེར་དེ་དག་ལས་ཆུའི་ཁར་པདྨ་སུམ་བརྒྱ་དྲུག་ཅུ་རྩ་གསུམ་བྱུང་།",
    "ལྷ་ཀླུ་ལ་སོགས་པ་ལ་དུས་ཐམས་ཅད་དུ་སྲུངས་ཤིག་པར་དེ་བཞིན་གཤེགས་པས་གཏད་ད་དོ།",
    "མགོན་པོ་དང་ལྷ་ཀླུ་རྣམས་ག་ལ་བཞུགས་བཞུགས་པའི་གནས་དང་།",
    "མི་ཐ་མལ་པ་མ་ལགས་པས་རྒྱལ་པོ་ཡབ་སྐུ་ཚེ་མ་འཕོས་པར་རྒྱལ་པོ་བགྱིད་པར་འགྱུར་ཞེས་བགྱིས་པ་དང་།",
    "ས་ཚོལ་དུ་མཆི་བར་ཅི་གནང་ཞེས་གསོལ་བ་ལ་བ་ལས།",
    "འབངས་སྟོད་རིམས་འདྲེས་པར་བཀོད་ནས་ཡུལ་བཙུགས་མཁར་བརྩིགས་ཏེ།",
    "རྒྱ་གར་དང་རྒྱ་ཕྲད་པའི་ཡུལ་ནི་ལི་ལགས་ཏེ།",
    "དྷ་རྨ་༡༧ཨ་ཤོ་ཀས་སྤྱིར་རྒྱལ་པོ་དགུང་ལོ་ལྔ་བཅུ་རྩ་ལྔ་བགྱིས་པ་ལས་རྒྱལ་པོར་ཞུགས་ནས་དགུང་ལོ་སུམ་ཅུ་ལགས་པའི་འོག་ཏུ་རྒྱལ་བུ་ས་ནུ་བཙས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་ཤཱ་༦རི་རམ་སུ་ལ་བཞུགས་པ་རྣམས་ཀྱི་༧གཙུག་ལག་ཁང་དང་།",
    "གཙུག་ལག་ཁང་བརྩིགས་པ་ལགས་ནས།",
    "རྒྱལ་པོས་གཎྜཱི་༢བརྡུངས་པ་དང་དགུང་བདུན་གྱི་བར་དུ་གཎྜཱི་༤དེའི་སྒྲ་མ་ཆད་པར་བྱུང་སྟེ།",
    "འཆག་ཅིག་༡༧གཤེགས་པར་མཐོང་ནས་མཚམས་མེད་པ་ལྔ་བྱང་ངོ་ཞེས་མཆི་བ་ཡང་ད་ལྟར་བཞུགས་གཙུག་ལག་ཁང་དེའི་སྲུང་མར་ཞལ་གྱིས་བཞེས་པ་ཡང་།",
    "ལྷ་ནམ་མཁའི་སྤྱན་དང་ནོར་བུ་བཟང་པོ་ཞེས་བགྱི་བ་ལགས་ཏེ།",
    "འགུམ་༢ཏིར་གྱི་གཙུག་ལག་ཁང་འདི་གཉིས་བཞུགས་པའི་དོག་ས་ཡང་དུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པ་རིམ་གྱིས་འབྱུང་ངོ་འཚལ་གྱི་ཞབས་༐",
    "མཆོད་རྟེན་བཞུགས་སོ་འཚལ་གྱི་ནང་ན་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་དང་།",
    "རང་སང་ས་རྒྱས་ཀྱི་སྐུ་གདུང་བཞུགས་པས་གཉན་ཞིང་བྱིན་ཆེ་རབ་སྟེ།",
    "ལི་ཡུལ་གྱི་གཙུག་ལག་ཁང་བཞུགས་སོ་འཚལ་གྱི་ནང་ན་གཅོ་བོར་བགྱི་བ་ལགས།",
    "སྲིན་བུ་ཕལ་ཆེར་བཀུམ་པའི་དངོས་སྡིག་བཤགས་སྦྱང་བགྱིས་ནས་པོ་ཏརྱ་ད་ང་།",
    "རཏྣ་ཤུ་ར་༡༨གཉིས་སྲུང་མར་ཞལ་གྱིས་བཞེས་པ་ལགས་ཏེ།",
    "ཞིང་བསླབ་ནས་༥བསྒོམས་པས་འཕགས་པ་དགྲ་བཅོམ་པར་གྱུར་ཏེ།",
    "ཕུ་བོ་ལགས་པར་ནི་ངོ་མ་འཚལ་ཏེ།",
    "ཕུ་བོ་དགེ་སློང་དྷ་རྨཱ་ནནྡས་༡༧བྱིན་གྱིས་བརླབས་ནས་ཕུ་བོ་ལགས་པར་གདོང་ངོ་འཚལ་ཏེ།",
    "གཉིས་སུ་ན་ང་འཕགས་པ་ད་གྲ་བཅོམ་པར་གྱུར་པས།",
    "རི་ཀྵ་ཏ་ཨ་ཤོ་ཀ་ཞེས་བྱ་བ་འདི་བྱིན་གྱིས་བརླབས་ཏེ་འདི་ན་བཞུགས་བཞུགས།",
    "རྒྱལ་པོ་བི་ཛ་ཡ་དྷ་རྨ་༢དད་པ་སྐྱེས་ནས་སླན་ཆད་གསོད་རྐྱེན་མི་བགྱིད་པར་དམ་བཅས།",
    "ད་༨ལྟར་གཙུག་ལག་ཁང་འདིའི་ནང་ན་བཞུགས།",
    "འུ་ཐེན་ན་འབྲོ་༡༡ཏིར་གཏོགས་པར་གཙུག་ལག་ཁང་བརྒྱད་དང་།",
