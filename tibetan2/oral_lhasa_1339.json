    "ཀླུ་རྣམས་རབ་ཏུ་འགུགས་པར་བསམ།",
    "ལོག་པར་བྱེད་པའི་མུ་སྟེགས་དང་།",
    "ཇི་ལྟར་མནན་ཞིང་བརླག་པར་བགྱི།",
    "ཡབ་ཡུམ་གཉིས་སུ་མེད་པར་སྟོན།",
    "རིམ་བཞིན་དགོད་ཅིང་ངེས་པར་བཞག།",
    "མ་ལུས་པར་ནི་དགོད་པར་བྱ།",
    "ལས་ཀྱི་ལྷ་སྟེ་ཧེ་རུ་ཀ།",
    "མ་ལུས་པར་ནི་གསད་པར་བྱ།",
    "སྲིན་པོ་རྣམས་ནི་དགུག་པར་བྱ།",
    "གསང་སྔགས་འདི་དག་བརྗོད་པར་བྱ།",
    "རྔམ་པའི་ཚུལ་གྱིས་དགུག་པར་བྱ།",
    "ཁྲག་དང་རུས་པ་ལས་བྱས་པའི།",
    "གང་དགུག་པ་ཡི་གཟུགས་བྱས་ནས།",
    "མི་རུས་སེང་ལྡེང་ལྕགས་ལས་བྱས།",
    "སྡང་མིག་ཁྲོ་ཞིང་འཇིགས་པར་བལྟ།",
    "རྙིང་རོལ་དམག་ཚོགས་འཇོམས་པར་བསམས།",
    "གསང་སྔགས་འདི་དག་བརྗོད་པར་བྱ།",
    "ཡི་དྭགས་རྣམ་པར་དགུག་པར་བྱ།",
    "མ་ལུས་པར་ནི་ཁུགས་པར་འགྱུར།",
    "དེ་ལྟར་སྦྱོར་བ་ཆེར་བྱས་ན།",
    "དངོས་གྲུབ་རྣམ་གསུམ་ཐོབ་པར་འགྱུར།",
    "རྡོ་རྗེའི་གླུ་ནི་བླངས་བྱས་ཏེ།",
    "ཆ་ལུགས་འཛུམ་པར་བྱས་ནས་ནི།",
    "དེ་ཡི་སྦྱོར་བ་བྱས་གྱུར་ན།",
    "ནེའུ་ནི་ཝ་དང་རྣམ་པར་འཇིགས།",
    "ལྷ་རྣམས་རིམ་པར་དགོད་པར་བྱ།",
    "སོ་སོའི་གནས་སུ་དགོད་པར་བྱ།",
    "བདག་ཉིད་བདུད་རྩི་འཁྱིལ་པར་བསྒོམ།",
    "དེ་ཡི་གསང་སྔགས་བརྗོད་པར་བྱ།",
    "ཤ་རྣམས་གཙང་སྨེ་མེད་པར་བཟའ།",
    "འཁོར་ལོ་རྩིབས་བརྒྱད་མཛེས་པར་བྱ།",
    "མ་རུངས་པ་རྣམས་དགུག་པར་བྱ།",
    "ནྲྀ་ཞེས་བྱ་བས་དབབ་པར་བྱ།"
  ]
