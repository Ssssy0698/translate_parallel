    "དེ་ཡང་ཐུགས་རེའཱི་ངོ་བོ་཈ཱིད་དོ།",
    "ཀླུ་བཞཱིན་ཁོད་ལ་ཐུགས་རེ་ཡཱིས།",
    "དེ་རྣམས་ལ་རེས་སུ་ཕན་གདགས་པའཱི་ཕྱཱིར་བྱམས་པའཱི་ཞགས་པས་དངས་པའོ།",
    "ཐོས་པའཱི་རེས་ལ་སཱིན་པ་ལ་སོགས་པའཱི་ཕ་རོལ་ཏུ་ཕྱཱིན་པ་རྣམས་བསྒྲུབ་པར་བྱ་དགོས་པས།",
    "ལུས་ཤཱིན་ཏུ་སངས་པས་ནཱི་བདེ་བ་ལ་རེག་པར་འགྱུར་རོ།",
    "བདེ་བ་ལ་རེག་པས་ནཱི་སེམས་རེ་གཅཱིག་པར་འགྱུར་ཏེ།",
    "རེ་གཅཱིག་པའཱི་སེམས་ཀཱིས་ནཱི་ཡང་དག་པའཱི་ལྟ་བ་བཞཱིན་དུ་ཤེས་པར་འགྱུར་ཏེ།",
    "ཡང་ན་སེམས་དཔའ་བཅུ་གཅཱིག་པ་ནཱི་ཏཱིང་ངེ་འཛིན་གཱི་རེས་ལ་ཐོབ་པའཱི་ཡེ་ཤེས་ཀཱི་ངོ་བོ་཈ཱིད་དོ།",
    "དེ་བས་ན་དེའཱི་རེས་ལ་ལས་ཀཱི་སེམས་དཔའ་རྣམས་བསན་ཏོ།",
    "དེ་དག་ཐམས་ཅད་ཀཱི་སྐུ་དང་གསུང་དང་ཐུགས་རོ་རེ་གཅཱིག་ཏུ་བསྡུས་པར་གྱུར་ན་ལས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་གཱི་གཞན་དུ་མ་ཡཱིན་པའཱི་མཚན་཈ཱིད་དོ།",
    "དེ་དག་ནཱི་གཙོ་བོར་གྱུར་པ་ཡཱིན་པའཱི་ཕྱཱིར་རཱིགས་ཀཱི་ལྷ་མོ་ཆེན་མོ་཈ཱིད་དུ་རྣམ་པར་གཞག་གོ།",
    "སོ་སྲུང་རྣམས་ནཱི་ཐུགས་རེ་དང་།",
    "དེའཱི་ཕྱཱིར་རོ་རེ་སེ་གོལ་ཞེས་པའོ།",
    "རོ་རེ་སེམས་མའཱི་ཕྱག་རྒྱ་བཅཱིངས་ལ།",
    "རོ་རེ་གར་གཱི་སོར་བ་བྱས་ནས་ལག་པ་གཡས་པའཱི་མཁཱིག་མ་གཡོན་པའཱི་སེང་དུ་བཀན་ཏེ་བཞག།",
    "ལག་པ་ག་཈ཱིས་ཀའཱི་གུང་མོ་དང་མཐེ་བོང་ག་཈ཱིས་ཀཱིས་སེ་གོལ་བརེབས་ཤཱིང་།",
    "མཛུབ་མོ་ལྕགས་ཀྱུའཱི་ཚུལ་དུ་གཞག་པ་འདཱི་ནཱི་རོ་རེ་སེ་གོལ་གཱི་ཕྱག་རྒྱ་སེ།",
    "འདཱི་ནཱི་རོ་རེ་བསྡུ་པའཱིབའཱི་བྱཱིན་གཱི་རླབས་ཏེ།",
    "རོ་རེ་བསྡུ་པའཱིབའཱི་རྒྱལ་པོའི་ཏཱིང་ངེ་འཛིན་གཱི་ལས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་བསྐུལ་བའཱི་རེས་ཐོགས་཈ཱིད་ལའོ།",
    "འཇཱིག་རེན་གཱི་ཁམས་ཐམས་ཅད་ཅེས་བྱ་བ་ནཱི་སོང་གསུམ་གཱི་སོང་ཆེན་པོ་ཡོངས་སུ་གཟུང་ལ་འཇཱིག་རེན་གཱི་ཁམས་དེ་རྣམས་ཀཱི་རབ་འབྱམ་ནཱི་རྒྱུན་ཆགས་པའོ།",
    "བཅོམ་ལྡན་འདས་ཀཱི་ཁང་བུ་བརེགས་པ་རེ་མོ་རོ་རེ་དང་ནོར་བུ་དང་རཱིན་པོ་ཆེ་ལས་བྱས་པ་གང་ན་བ་དེར་གཤེགས་པ་སེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "འཇཱིག་རེན་གཱི་ཁམས་ཐམས་ཅད་ཀཱི་རྡུལ་ཕ་རབ་དང་མ་཈མ་པའཱི་དེ་བཞཱིན་གཤེགས་པ་རྣམས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལ་ཞུགས་སུ་ཟཱིན་ཀང་།",
    "གང་མཱི་རྣམས་མཐུ་མཱི་ཐོབ་ཅཱིང་རཱི་རབ་ཀཱི་རེ་མོར་འགྲོ་མཱི་ནུས་པ་དེ་རྣམས་ཀཱི་དོན་ད་དུང་མ་མཛད་དེ།",
    "དེ་བས་ན་བཅོམ་ལྡན་འདས་ཕྱག་ན་རོ་རེ་ལ་གསོལ་བ་གདབ་པའཱི་ཕྱཱིར།",
    "རོ་རེ་འདཱི་ཁམས་དང་རྒྱུ་བ་ཡཱིན་པས་ན་རོ་རེ་དབྱཱིངས་ཏེ།",
    "རོ་རེ་དབྱཱིངས་སོས་པ་ནཱི་འཇཱིག་རེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བ་ལ་ལྟོས་པའོ།",
    "རོ་རེ་འཛིན་པ་གཞན་དག་ཀང་ཡོད་པས་དེ་རྣམས་ལས་དགའ་བར་བྱ་བའཱི་ཕྱཱིར།",
    "བཅོམ་ལྡན་འདས་ཀུན་དུ་བཟང་པོ་ནཱི་རོ་རེ་ཆེན་པོ་འཛིན་པ་ཞེས་བྱ་སེ།",
    "ཐམས་ཅད་མཁེན་པའཱི་ཡེ་ཤེས་ཀཱི་རོ་རེ་ཆེན་པོ་འཛིན་པས་ན་རོ་རེ་ཆེན་པོ་འཛིན་པའོ།",
    "ཚིགས་སུ་བཅད་པ་རེ་རེ་ཞཱིང་ཡང་མཚན་བདུན་བདུན་ཡོད་དོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སོ་ནས་ཐུན་མོང་གཱི་མཚན་ཏེ་གསུམ།",
    "དེ་ལྟར་ཚིགས་སུ་བཅད་པ་རེ་རེ་ཞཱིང་ཡང་དོན་བདུན་པོ་ནཱི་མཚན་འདོགས་པའཱི་རྒྱུ་ཡཱིན་པར་ཤེས་པར་བྱའོ།",
    "རོ་རེ་སེམས་དཔའ་ཞེས་བྱ་བ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་ཞེས་བྱ་བ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་རྣམས་ཀཱི་ཐོག་མ་ཡཱིན་པས་ན་རོ་རེ་དང་པོ་སེ།",
    "རོ་རེ་རྒྱལ་པོ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་ལྕགས་ཀྱུ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་མཆོག་ནཱི་རོ་རེ་རྣམས་ཀཱི་དམ་པ་ཡཱིན་པས་ན་རོ་རེ་མཆོག་སེ་སྤྲོ་བའཱི་སོ་ནས་སོ།",
    "ལྕགས་ཀྱུའཱི་ཕྱག་རྒྱས་འགུགས་པས་ན་རོ་རེ་འགུགས་པ་སེ།",
    "རོ་རེ་ཆགས་པ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་མདའ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ཆེ་ནཱི་སྤྲོ་བའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ལེགས་པ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་མགུ་བ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་མཆོག་ནཱི་དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་རོ་རེ་རྣམས་ངོ་བོ་཈ཱིད་གཅཱིག་ཏུ་བྱེད་པའཱི་དོན་གཱིས་ན་རོ་རེ་མཆོག་གོ།",
    "རོ་རེ་རཱིན་ཆེན་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་ནཱི་དེ་བཞཱིན་གཤེགས་པ་རྣམས་སོ།",
    "དེ་རྣམས་ཀཱི་དོན་ཡཱིན་པས་ན་རོ་རེའཱི་དོན་ཏེ།",
    "རོ་རེ་ལྟ་བུའཱི་ཐུགས་ཀཱིས་ནམ་མཁའ་ལས་བྱུང་བ་ཡཱིན་པའཱི་ཕྱཱིར་རོ་རེ་ནམ་མཁའོ།",
    "རོ་རེ་རྣམས་ཀཱིས་ཕྱུག་པ་ནཱི་རོ་རེས་ཕྱུག་པ་སེ།",
    "རོ་རེ་གཟཱི་བརཱིད་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་཈ཱི་མ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེའཱི་འོད་ཟེར་ནཱི་ལས་ཀཱི་ཁད་པར་གཱི་སོ་ནས་ཏེ།",
    "རོ་རེ་དཔལ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་རྒྱལ་མཚན་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ཆེན་པོ་ནཱི་སྤྲོ་བའཱི་སོ་ནས་སོ།",
    "རོ་རེ་བཞད་མོ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་འཛུམ་པ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་སོན་ནཱི་རོ་རེ་རྣམས་སོན་པས་ན་རོ་རེ་སོན་ཏེ།",
    "རོ་རེ་ཐུགས་སུ་ཆུད་པའཱི་འཛུམ་པ་སོན་པའཱི་ཕྱཱིར་རོ།",
    "རོ་རེ་པདྨོ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་སན་ནཱི་རོ་རེ་ལྟ་བའཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་རྣོ་བ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་རལ་གྲཱི་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་རྒྱུ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་འཁོར་ལོ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ལས་བྱུང་བ་ནཱི་རོ་རེ་ལྟ་བུའཱི་ཏཱིང་ངེ་འཛིན་ལས་སེས་པའཱི་ཕྱཱིར་རོ།",
    "རོ་རེ་གསུང་པབ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་ཟོས་པའཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་མཆོག་གྲུབ་པ་ནཱི་མཆོག་རྣམས་སཱིན་པར་བྱེད་པས་ན་རོ་རེ་མཆོག་གྲུབ་པའོ།",
    "རོ་རེ་ལས་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "དེ་རྣམས་ཀཱི་བཀའ་བཞཱིན་བྱེད་པས་ན་རབ་རོ་རེའཱི་བཀའོ།",
    "ལས་ཀཱི་རོ་རེ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ངེས་པ་ནཱི་ཕྱག་རྒྱ་ཆེན་པོའི་སོ་ནས་སོ།",
    "རོ་རེ་བསྲུང་བ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་གོ་ཆ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་གནོད་སཱིན་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་མཆེ་བ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་རྣམས་ཀཱི་མཱི་བཟད་པ་ནཱི་རོ་རེ་མཱི་བཟད་པ་སེ།",
    "རོ་རེ་མཚམས་སོར་བ་ནཱི་སྔགས་ཀཱི་སོ་ནས་སོ།",
    "རོ་རེ་འཆཱིང་བ་ནཱི་ཕྱག་རྒྱའཱི་སོ་ནས་སོ།",
    "རོ་རེ་ཁུ་ཚུར་ནཱི་ཕྱག་རྒྱ་ཆེན་པོའི་སོ་ནས་སོ།",
    "རོ་རེ་འཆང་ཆེན་པོ་ལ་ཞེས་བྱ་བ་ནཱི་བཅོམ་ལྡན་འདས་ཀུན་དུ་བཟང་པོའོ།",
    "རག་ཏུ་ཞེས་བྱ་བ་ནཱི་཈ཱིན་རེ་ཞཱིང་ངོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་ཤཱིན་ཏུ་རྣམ་པར་དག་ཅཱིང་ཡོངས་སུ་རོགས་པའཱི་སོང་པ་཈ཱིད་ཆེན་པོའི་རོ་རེ་འཛིན་པར་མཛད་པས་ན་རོ་རེ་ཆེན་པོ་འཛིན་པའོ།",
    "དཀཱིལ་འཁོར་གང་སོང་པ་཈ཱིད་ཀཱི་ཡེ་ཤེས་ཀཱི་རོ་རེའཱི་དབྱཱིངས་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་དེའཱི་རེས་ཐོགས་ལའོ།",
    "རོ་རེ་དབྱཱིངས་དང་འད་བས་ན་ཞེས་བྱ་བ་སེ།",
    "རོ་རེ་དབྱཱིངས་དང་མཚུངས་སོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "རོ་རེ་དབྱཱིངས་ཞེས་བགཱི་བར་གྲགས།",
    "རོ་རེ་དབྱཱིངས་ཞེས་བྱའོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་བརྐོས་ལ་ཕུབ་མ་དང་ཐལ་བ་དང་རུས་པ་དང་།",
    "ཕྱཱིས་འགྱུར་བའཱི་ཚུལ་ལ་བརེན་ནས་དཀཱིལ་འཁོར་གཱི་ས་ལ་ཡང་དཀཱིལ་འཁོར་ཞེས་བྱ་བའཱི་སྒྲར་གསུངས་ཏེ།",
    "སེམས་དཔའ་ཆེན་པོ་ནཱི་འདཱིར་བཅོམ་ལྡན་འདས་རོ་རེ་སེམས་དཔའོ།",
    "སོང་པ་཈ཱིད་དུ་རོ་གཅཱིག་པར་ཡང་བདག་཈ཱིད་ལྷག་པར་མོས་པར་བྱའོ།",
    "བྱཱིས་པ་དང་གཞོན་ནུ་མ་ལ་སོགས་པའཱི་རཱིམ་གཱིས་བདག་཈ཱིད་ལང་ཚོ་ལ་གནས་པར་ལྷག་པར་མོས་ཤཱིང་བཟོའི་གནས་བསན་པ་དང་།",
    "བཙུན་མོའི་འཁོར་གཱི་ནང་ན་གནས་པ་དང་།",
    "དཀའ་བ་སོད་པ་བྱས་པར་ལྷག་པར་མོས་པར་བྱས་ཏེ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མཱིན་སེ་མཆེད་རྣམས་ལ་རཱིམ་པ་བཞཱིན་དུ་སོམས་པར་འཇུག་པར་ལྷག་པར་མོས་པར་བྱའོ།",
    "བསམ་གཏན་དང་པོའི་རེས་ལ་བསམ་གཏན་ཁད་པར་ཅན་དང་།",
    "དེ་ལྟར་ཇཱི་སྐད་དུ་བསན་པའཱི་སོམས་པར་འཇུག་པ་ནཱི་ལམ་ལ་གོམས་པར་བྱ་བའཱི་ཕྱཱིར་ཐ་ན་ཚིག་ཙམ་དུ་ཡང་རེས་སུ་དན་པར་བྱའོ།",
    "དེ་ནས་དེ་བཞཱིན་གཤེགས་པ་རྣམས་ཀཱིས་བསྐོར་བཞཱིན་དུ་རཱི་རབ་ཀཱི་རེ་མོར་བབས་ཏེ།",
    "ཏཱིང་ངེ་འཛིན་ཡོངས་སུ་བཟུང་བས་རོ་རེ་སེམས་དཔར་བདག་཈ཱིད་བསོམ་ཞཱིང་དཀཱིལ་འཁོར་གཱི་ལས་བྱའོ།",
    "བདག་཈ཱིད་རོ་རེ་སེམས་དཔའཱི་སྐུར་བསམ་མོ།",
    "དེ་ནས་རོ་རེ་སེམས་དཔའཱི་གཟུགས་སུ་བསོམ་ཞཱིང་བྱཱིན་གཱིས་བརླབ་པ་ལ་སོགས་པ་བྱས་ནས།",
    "དེ་ལྟར་རོ་རེ་སེམས་དཔའཱི་ཏཱིང་ངེ་འཛིན་བསེད་ནས།",
    "དེ་ཡང་རོ་རེ་སེམས་དཔའཱི་སྐུར་བདག་཈ཱིད་བསམ་མོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "རོ་རེ་སེམས་དཔའཱི་ཞེས་བརོད་ནས།",
    "བགེགས་དང་ལོག་འདེན་དེ་རྣམས་ཀང་གནས་དེ་ནས་འབྱེར་བར་གྱུར་པར་ལྷག་པར་མོས་པར་བྱའོ།",
    "བསྐོར་བ་ནཱི་དཀཱིལ་འཁོར་གཱི་སའཱི་སེང་བསྐོར་ཞཱིང་རོ་རེ་སེམས་དཔའཱི་ཞབས་ཀཱི་མཐཱིལ་ནས་བརམས་ཏེ།",
    "དེ་རཱི་རབ་ཀཱི་སེང་དུ་ལྷག་པར་མོས་པར་བྱའོ།",
    "རོ་རེ་བཅཱིང་བ་ཡང་བཅཱིངས་ལ་ཕྱེ་སེ།",
    "གཡོན་པའཱི་རོ་རེ་ཁུ་ཚུར་ས་ཟུར་དུ་འཇོག་པ་ནཱི་བསཱིངས་པ་ཞེས་བྱ་སེ།",
    "གང་ལག་པ་ས་ཟུར་ལ་འཇོག་ཅཱིང་འདུག་པ་ནཱི་ཁེངས་པ་ཞེས་འཇཱིག་རེན་ན་གྲགས་པ་ཡཱིན་ནོ།",
    "རོ་རེ་སེམས་དཔའ་ཞེས་བརོད་ནས།",
    "ས་གཟུང་བའཱི་རེས་ལ་དེ་ན་བགེགས་དང་ལོག་འདེན་གང་དག་ཡོད་པར་དོགས་ན་བགེགས་དང་ལོག་འདེན་ཐམས་ཅད་ལ་ཕུར་བུས་གདབ་པར་བྱ་སེ།",
    "དཀཱིལ་འཁོར་ནཱི་ཁང་པ་བརེགས་མའཱི་རང་བཞཱིན་ཡཱིན་པའཱི་ཕྱཱིར་རོ།",
    "གཞན་དག་ན་རེ་ཀ་བའཱི་ཐཱིག་཈ཱིད་ལ་ཐཱིག་བཞཱི་ཞེས་ཟེར་རོ།",
    "རཱི་མོ་ག་཈ཱིས་ཕད་པ་ལ་མཚམས་ཞེས་བྱའོ།",
    "རོ་རེ་རཱིན་ཆེན་སྤྲས་པར་ནཱི།",
    "རོ་རེ་རཱིན་པོ་ཆེ་཈ཱིད་ཡཱིན་པས་ན་རོ་རེ་རཱིན་ཆེན་ནོ།",
    "ལ་ལ་ནཱི་རོ་རེ་དང་རཱིན་པོ་ཆེ་ནཱི་རོ་རེ་རཱིན་ཆེན་ནོ་ཞེས་འཆད་དེ།",
    "རོ་རེ་ནཱི་དཀཱིལ་འཁོར་གཱི་སོ་ཁྱུད་དང་མཚམས་རྣམས་སུའོ།",
    "རཱིན་པོ་ཆེ་ནཱི་ཚོན་གཱི་རཱི་མོའི་མཐའ་མར་རཱིན་པོ་ཆེའཱི་ཕེང་བས་ངོས་བཞཱི་ཆར་དུ་ཡང་སྤྲས་པ་སེ།",
    "རོ་རེ་ཐཱིག་གཱིས་ཡོངས་སུ་བསྐོར་བར་བྱ་བ་སེ།",
    "ནས་འབྲས་འད་བའཱི་རོ་རེས་རྒྱུན་ཆགས་སུ་བསྐོར་ཏེ་བྲཱིས་པའཱི་ཐཱིག་ནཱི་རོ་རེའཱི་ཐཱིག་གོ།",
    "ཀ་བ་བརྒྱད་ཀཱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སོ་རེ་རེའཱི་ཐད་ཀར་ཡང་ཀ་བ་ག་཈ཱིས་ག་཈ཱིས་ཏེ།",
    "མཐའ་གཅཱིག་ནཱི་རོ་རེའཱི་ཐཱིག་ལ་བརེན་ལ།",
    "མཐའ་གཅཱིག་ནཱི་དཀཱིལ་འཁོར་གཱི་ལྟེ་བ་ལ་བརེན་ཏོ།",
    "རྒྱུད་འདཱིར་རོ་རེ་ལྟ་བུའཱི་བསམ་པས་དངོས་པོ་ཐམས་ཅད་སྤྲུལ་པས་ན་མཱིང་ཐམས་ཅད་རོ་རེས་མཚན་པ་ཡཱིན་ཏེ།",
    "དེའཱི་ཕྱཱིར་རོ་རེ་ཀ་བ་ཞེས་གསུངས་སོ།",
    "ཡང་གཞན་དག་ནཱི་འདཱི་སྐད་དངོས་པོ་ཐམས་ཅད་རོ་རེས་མཚན་པས་ན་རོ་རེས་མཚན་པའཱི་ཀ་བ་ལ་ནཱི་རོ་རེའཱི་ཀ་བ་ཞེས་ཟེར་རོ།",
    "རོ་རེ་ཀ་བའཱི་མདུན་གཱི་གནས་སུ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
