    "སེམས་དཔའ་རོ་རེ་མའཱི་ཕྱག་རྒྱ་བཅཱིངས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "འོན་ཀང་བཅོམ་ལྡན་འདས་ཀཱིས་རེས་སུ་གནང་བས་དེ་ལ་བསན་པར་བྱ་དགོས་ཏེ།",
    "དེ་ལྟ་བུའཱི་རོ་རེ་ཡེ་ཤེས་བསེད་པར་བྱས་ཞེས་བྱ་བ་ལ།",
    "རོ་རེ་ཡེ་ཤེས་ནཱི་རོ་རེ་དབབ་པ་སེ།",
    "རོ་རེ་དབྱཱིངས་ཀཱི་དཀཱིལ་འཁོར་ཆེན་པོ་མ་མཐོང་བ་སེ།",
    "དམ་ཚིག་཈མས་པར་གྱུར་ཏ་རེ་ཞེས་བྱ་བ་ནཱི་གང་འདཱི་མནའ་ཆུ་བླུད་པ་ལ་སོགས་པས་དམ་ཚིག་ཅན་དུ་བྱས་ཤཱིང་།",
    "གཞན་དུ་ངན་སོང་དུ་འགྲོ་བའོ།",
    "རོ་རེ་སེམས་དཔའ་཈ཱིད་ནཱི་དེང་།",
    "དེ་ལ་དེའཱི་ཚེ་རོ་རེ་སེམས་དཔའ་རང་཈ཱིད་སཱིང་ལ་གནས་པར་གྱུར་པ་ཡཱིན་ནོ།",
    "མཱི་བདེ་བ་མ་སྤངས་པས་ཞེས་བྱ་བ་ལ་སོགས་པས་སོབ་དཔོན་གཱིས་བསྒྲུབ་པའཱི་དམ་ཚིག་བསོས་ནས་མནའཱི་སཱིང་པོའི་རེས་ལ།",
    "དེའཱི་འོག་ཏུ་རོ་རེ་སེམས་དཔའ་དབབ་པོ།",
    "ཡེ་ཤེས་དབབ་པའཱི་ཕྱཱིར་སེམས་དཔའ་རོ་རེ་མའཱི་ཕྱག་རྒྱ་རོ་རེ་སོབ་མའཱི་སཱིང་གར་བཞག་ལ་སཱིང་པོ་བརོད་པར་བྱའོ།",
    "མཛུབ་མོ་ལྕགས་ཀྱུར་བྱས་ཏེ།",
    "ལག་པ་གཡས་པ་ལ་གནས་པའཱི་སེམས་དཔའ་རོ་རེ་མའཱི་ཕྱག་རྒྱ་ཕྱེད་ཡཱིན་ཡང་སེམས་དཔའ་རོ་རེ་མ་ཞེས་བྱ་སེ།",
    "ལྕགས་ཀྱུ་དེས་དང་ཞཱིང་གཡས་པའཱི་གུང་མོ་ལ་དལ་བར་བྱའོ།",
    "རོ་རེའཱི་ཚིག་ནཱི་སྒྲ་སྤངས་པའོ།",
    "འདཱིའཱི་སེམས་བརན་པར་འགྱུར་ཞེས་བྱ་བ་ནཱི་རོགས་པ་མ་ཐོབ་ཅཱིང་ཚེ་གཞན་དུ་བརེས་སུ་ཟཱིན་ཀང་།",
    "རོ་རེ་སེམས་དཔས་ཡོངས་སུ་གཟུང་བ་ཡཱིན་པའཱི་ཕྱཱིར་རོ།",
    "ཅཱི་ནས་ཀང་ཚོགས་ཡོངས་སུ་རོགས་པར་འགྱུར་བའཱི་ཡོན་ཏན་རྣམས་འཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནཱི་བབས་པའཱི་རེས་ཐོགས་ལའོ།",
    "ཕྱག་རྒྱ་དེ་ཞེས་བྱ་བ་ནཱི་སེམས་དཔའཱི་རོ་རེ་མའཱི་ཕྱག་རྒྱའོ།",
    "མ་ཧཱ་བ་ལ་ཞེས་བྱ་བ་ནཱི་ལྷ་ལ་རེ་སར་བོད་པའོ།",
    "རཱིམ་བཞཱིན་དུ་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ལྕགས་ཀྱུ་ནས་བརམས་ཏེ།",
    "རོ་རེ་སེམས་དཔའ་ཡང་འདཱིའཱི་སཱིང་ག་ན་གནས་སོ་ཞེས་བྱ་བ་ནཱི་འདཱི་སྐད་སོན་ཏེ།",
    "རོ་རེའཱི་རཱིགས་ལ་ནཱི་རོ་རེའཱི་ཕེང་བའོ།",
    "དེར་ཟ་བའཱི་དཀཱིལ་འཁོར་དེ་བསམ་མོ།",
    "དེ་ནས་དེ་བཞཱིན་གཤེགས་པའཱི་རཱིགས་ལ་དེའཱི་སེང་དུ་ཡེ་ཤེས་ཀཱི་རོ་རེ་བསམ་པར་བྱའོ།",
    "དེ་ནས་རོ་རེ་སེམས་དཔའཱི་སྐུར་བསམ་མོ།",
    "དེ་བཞཱིན་དུ་རོ་རེའཱི་རཱིགས་ལ་སོགས་པ་ལ་ཡང་སེམས་དཔའ་གང་དང་གང་གཱི་ཕྱག་རྒྱ་གང་དང་གང་ཡཱིན་པ་དེ་དང་དེ་ལས་བསེད་དེ།",
    "མ་མཐོང་བ་ནཱི་འཇཱིག་རེན་ཕ་རོལ་གཱིས་ཏེ།",
    "དེ་ལ་རེ་ཞཱིག་མཐོང་བ་སེ།",
    "རོ་རེ་དབྱཱིབས་ནཱི་གཏེར་གནས་པ།",
    "དེའཱི་སེང་དུ་རོ་རེའཱི་གཟུགས་ཡོངས་སུ་བསོམ་པར་བྱའོ།",
    "རོ་རེའཱི་དབྱཱིབས་གཅཱིག་བྲཱིས་ནས་ཀང་།",
    "གང་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རོ་རེའཱི་དབྱཱིབས་བསོམ་པ་ན་རྣལ་འབྱོར་གཱི་སོབས་སམ།",
    "རོ་རེའཱི་རྫུ་འཕྲུལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "རོ་རེ་དབབ་པ་བྱས་ནས་ནཱི།",
    "ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཕ་མོ་བསོམས་པས་བརན་པར་གྱུར་པ་ལ་བྱའོ།",
    "དེ་སེས་པ་དང་ཆུ་ལ་རོ་རེའཱི་དབྱཱིབས་འད་བར་བསོམས་ལ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནཱི་རོ་རེ་ཕ་མོ་དབབ་པ་སོན་པའོ།",
    "བདག་གཱི་ལུས་ཇཱི་སྲཱིད་ཆ་ཤས་སུ་གྱུར་པ་དེ་སྲཱིད་ཀཱི་བར་དུ་རྣམ་པར་གཞཱིག་ཅཱིང་རྡུལ་ཕ་རབ་ལས་ཆ་དྲུག་ཏུ་རྣམ་པར་བརགས་པས་བསོམ་མོ།",
    "དེའཱི་དབུས་སུ་བདག་཈ཱིད་འདུག་པར་བསམ་མོ།",
    "དེ་ནས་རོ་རེ་ཁུ་ཚུར་བཅཱིངས་ལ།",
    "རོ་རེ་དབབ་པ་ཞེས་བྱ་བ་ནཱི་སྔ་མ་བཞཱིན་ཏེ།",
    "རོ་རེ་ཡཱིན་པར་བདག་བསོམས་ནས།",
    "ཞེས་བྱ་བ་ནཱི་བདག་ནཱི་རོ་རེ་སེམས་དཔའོ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "རོ་རེ་རཱིག་འཛིན་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རོ་རེས་཈ེ་བར་མཚོན་པའཱི་རཱིག་འཛིན་ནཱི་རོ་རེ་རཱིག་འཛིན་ནོ།",
    "ཡང་ན་རོ་རེའཱི་ཕྱག་རྒྱ་གྲུབ་པའཱི་རཱིག་འཛིན་ཡཱིན་པས་ན་རོ་རེ་རཱིག་འཛིན་ནོ།",
    "གང་གཱིས་དངོས་གྲུབ་ཕྱཱིན་ཅཱི་མ་ལོག་པར་འགྲུབ་པར་གྱུར་པ་དེའཱི་ཡེ་ཤེས་ནཱི་རོ་རེ་རཱིག་འཛིན་གཱི་དངོས་གྲུབ་གྲུབ་པའཱི་ཕྱག་རྒྱའཱི་ཡེ་ཤེས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གང་སུ་ཡང་རུང་བ་ཚུལ་འདཱི་ལྟ་བུས་རོ་རེ་རཱིག་པ་འཛིན་པ་཈ཱིད་འདོད་ན།",
    "ས་ཕྱོགས་དབེན་པར་སཱིལ་མོ་ཀྲུང་བཅས་ཏེ།",
    "ཇཱི་སྲཱིད་དུ་རེག་པའཱི་མཚན་མ་བྱུང་གཱི་བར་དུ་བསོམ་པར་བྱའོ།",
    "ལག་ན་རོ་རེ་ལ་སོགས་པ་ཕྱག་རྒྱ་ཡོད་པར་རབ་ཏུ་བསོམ་ཞཱིང་།",
    "དེ་ལྟ་བུས་ནཱི་རོ་རེ་རཱིག་འཛིན་ལ་སོགས་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "རོ་རེ་ཐམས་ཅད་པའཱི་ཏཱིང་ངེ་འཛིན་གཱིས་ཟ་བའཱི་དཀཱིལ་འཁོར་གཱི་དབུས་སུ་འདུག་ལ་ལས་ཀཱི་རོ་རེ་ལག་ན་གནས་པར་བསོམ་མོ།",
    "དེ་ཡང་རོ་རེ་ཡང་ཡཱིན་ལ་ཐམས་ཅད་ཀང་ཡཱིན་པས་རོ་རེ་ཐམས་ཅད་དོ།"
  ]
}