    "ཨོྃ་ལོ་ཙ་ནེ་བ་སུ་དེ་སྭཱ་ཧཱ།",
    "ཐབ་དང་འདུག་སྟངས་ལ་སོགས་པའི་ཆོ་གས་གྲུབ་པར་འགྱུར་བ་ཇི་སྲིད་ཉིད་དུའོ།",
    "དེ་བཞིན་དུ་བྱང་དུ་ར་པ་ཙ་ནཱ་ཡ་ཏི་ན་མ་ཞེས་པ་སྟེ་བཛྲ་ཏཱི་ཀྵྞ་ལ་སོགས་པ་ཡི་གེ་རྣམས་སོ།",
    "གལ་ཏེ་འཆད་པར་འགྱུར་བའི་འདུག་སྟངས་བཅིངས་ནས་ཐུན་ཚོད་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱེད་པར་མི་ནུས་ན་དེའི་ཚེ་ཐུན་ཕྱེད་གཅིག་སྦྱིན་སྲེག་བྱས་ནས་བསྒྲུབ་པར་བྱ་སྟེ་གཉི་ག་གསུངས་སོ།",
    "ད་ནི་ཞི་བ་ཞེས་པ་ལ་སོགས་པས་ཞི་བ་ལ་སོགས་པའི་ལས་སྒྲུབ་པའི་དོན་དུ་འདུག་སྟངས་རྣམས་གསུངས་ཏེ།",
    "འདིར་ཞི་བ་ལ་སོགས་པ་ལ་རིམ་པས་འདུག་སྟངས་རྣམས་སུ་འགྱུར་རོ།",
    "རྒྱས་པ་ལ་རྡོ་རྗེའི་འདུག་སྟངས་ནི་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དང་གཡོན་པ་ཡང་བརླ་གཡས་པའི་སྟེང་དུ་སྟེ་ཐད་ཀར་གན་རྐྱལ་གྱིས་སོ་ཞེས་པ་ནི་རྡོ་རྗེ་འདུག་སྟངས་སོ།",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ།",
    "དེ་དག་ཀུན་ལ་གསོལ་བ་བཏབ་ནས་སེང་ལྡེང་རང་བཞིན་སྲ་བའི་ཕུར་བུ་རྣམས་ཀྱིས་ས་ལ་གདབ་སྟེ་འཆད་པར་འགྱུར་བའི་རིམ་པས་སོ་ཞེས་པ་ནི་གསོལ་བ་གདབ་པའི་ངེས་པའོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ཨོྃ་བེ་རོ་ཙ་ནཱ་ཡ་ན་མ།",
    "ཨོྃ་ལོ་ཙ་ནཱ་ཡེ་ན་མ།",
    "ལྔ་པ་ནི་ཟར་མ་དང་བར་ཊཱི་དང་བརྞྞཱ་དང་ཀུ་ལ་ན་ཐ་དང་ཙ་ན་ཀ་ནག་པོ་སྟེ་ལེ་ཚེ་སྦྱར་བའི་ཆས་འབྲུ་ལྔ་ཇི་ལྟར་རྙེད་པ་གཟུང་བར་བྱའོ།",
    "ཁུ་ཚུར་གྱིས་མཐེ་བོ་བསྡམས་པ་དག་བརླ་གཡས་པ་དང་གཡོན་པའི་སྟེང་དུ་རྡོ་རྗེའི་འདུག་སྟངས་ལ་གནས་པ་ནི་རྡོ་རྗེའི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "མངོན་དུ་ཕྱོགས་པ་སྟོན་པར་གྱུར་ན་འདུག་ཅིག་ཅེས་བརྗོད་པའོ།",
    "སླར་ཡང་རང་བཞིན་རྣམས་ཀྱིས་རྣམ་པ་མང་པོར་རིག་པར་བྱའོ་ཞེས་པ་ནི་ལྟ་སྟངས་ཀྱི་བརྡའི་ངེས་པའོ།",
    "ཕྱེད་དང་གཅིག་དུས་རི་བོང་ཅན།",
    "དེ་བཞིན་དུ་གཡོན་གྱི་གདོང་པ་གང་ཡིན་པ་དེ་ནི་གཡས་ཀྱི་སྟེ་དེའི་ཁ་དོག་ཉིད་ཀྱང་རང་འོད་ཅེས་པར་མི་འགྱུར་རོ།",
    "འདི་དག་དུས་ཀུན་རྣལ་འབྱོར་རྣམས་ལ་བདེ་མཉམ་འབྲས་བུ་སྟེར།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱི་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "དེ་བཞིན་དུ་བཟའ་བར་བྱ་བ་དང་བཟའ་བར་བྱ་བ་མ་ཡིན་པ་བྱེད་ཅིང་རང་དང་གཞན་གྱི་གཟུགས་ཡོངས་སུ་སྒྱུར་བར་བྱེད་དོ།",
    "དེ་ལ་དེ་ནས་དཔལ་ལྡན་རྡོ་རྗེ་འཆང་ཞེས་པ་ལ་སོགས་པ་ནས་ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག་ཅེས་པའི་མཐར་ཐུག་པ་ནི་གསོལ་བ་འདེབས་པའི་ཚིགས་སུ་བཅད་པ་བཅུ་དྲུག་གོ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཞེས་པ་ནི་འཁོར་ལོ་གསུམ་གྱི་སྡོམ་པའི་མཁའ་འགྲོ་མ་རྣམས་ཏེ་དེ་རྣམས་རིགས་ལྡན་མའི་སྦྱོར་བ་ལ་ཐུན་མཚམས་ཀྱི་དབྱེ་བ་དང་།",
    "དེ་ལྟར་རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྒྱུ་བ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ་ཞེས་པ་ནི་ངེས་པའོ།",
    "གང་ཞིག་ནུས་མ་བྷ་ག་ཞེས་བྱ་དེ་ནི་རྣམ་གསུམ་བགྲོད་ལྡན་ཡི་གེ་གསུམ་དང་རང་བཞིན་གསུམ།",
    "ཁ་ཏོན་དུ་བྱེད་ཅིང་སེམས་ཤིང་ཡིད་ལ་བྱེད་པ་གཅིག་འཐབ་པའི་ནང་ན་འདུག་ལ།",
    "ཞར་ལ་བྱེ་བྲག་དུས་གསུམ་ལ་སྦྱར་ནས་མ་བཅིངས་མ་གྲོལ་བར་བསྟན་པའོ།",
    "བྱེ་བྲག་དུས་གསུམ་ལ་སྦྱར་ནས་བཅིངས་གྲོལ་མེད་པར་བསྟན་པ་ནི།",
    "ཉི་ཁྲི་ལ་འདུག་ཀྱང་འབུམ་རྣམས་ལ་འཆད་པར་སྣང་ངོ།",
    "འགྲིབ་པའམ་གང་བར་མི་གདའོ།",
    "དེ་ནས་འདོད་པ་ན་སྤྱོད་པ་ནས་འཕེལ་བར་མི་གདའ་འོ་ཞེས་པས་བསྟན་པ་འདི་ལ་ཡང་གཉིས་ཏེ།",
    "ལེ་བརྒྱད་མ་ལ་ཚང་བར་ཡོད་ཅིང་གཞན་རྣམས་ལ་ཚང་བར་མི་འདུག་གོ།",
    "མིག་ལམ་དུ་མི་གདའ་འོ་ཞེས་པའི་བར་རོ།",
    "མཚན་མར་འཛིན་པ་ཅུང་ཟད་ཙམ་གྱིས་ཀྱང་རང་གཞན་གྱི་དོན་རྫོགས་པར་མི་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "དེ་ནི་རྟག་པ་ཡང་རང་བཞིན་གྱིས་སྟོང་ངོ།",
    "སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ་དང་།",
    "གཉིས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་བསྟན་པ་ནི་གཉིས་ཏེ།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གང་མཉམ་པར་བཞག་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་ངོ།",
    "མི་འགྲིབ་པར་འདུག་པ་སྟེ་ཞེས་པའི་བར་རོ།",
    "དེར་བཞུགས་རིང་རྒྱགས་ཀྱང་རང་ཉིད་ཀྱིས་རྩོལ་སྒྲུབ་བྱས་པས་ཀུན་གྱིས་བསྔགས་པའི་གནས་སུ་གྱུར།",
    "ཕྱིས་གདུང་རྟེན་ལས་རིང་བསྲེལ་འཁྲུངས་པ་སོགས་ངོ་མཚར་བ་ཅི་ཡང་བྱུང་འདུག།",
    "རིག་སྟོང་རང་ཚུགས་ཟིན་པར་བྱིན་གྱིས་རློབས།",
    "རབ་ཏུ་དམའ་བའི་ས་ལ་འདུག།",
    "དེ་ཡང་རང་འབྱོར་ལྔ་ནི།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "རང་ཉིད་སེང་གེའི་ཁྲིར་འདུག་པ་དང་།",
    "དེ་རིང་རང་བརྩོན་འགྲུས་བསྐྱེད་ནས་བྱེད་དགོས་པ་ཡིན།",
    "རི་ཁྲོད་ནས་མཚམས་ཐོན་ཙ་ན་དགེ་སྦྱོར་ལ་བོགས་སམ།",
    "དེ་མི་ཡོང་དུ་ཁོ་ལ་བརྩོན་འགྲུས་ཆེ་བ་རང་ཞིག་འདུག་པ་ཡིན་ཟེར་ཐམས་ཅད་ཀྱིས་རང་ལ་སྨོན་གཏོང་བ་ཞིག་དགོས་པ་ཡིན་གསུངས།",
    "ཁྱེད་རང་རྣམས་ཀྱང་སྔོན་འགྲོའི་ས་བཅད་དང་རྩ་ཚིག་སྡུག་ཤོས་ཀྱིས་དྲག་ཤོས་མི་བྱེད་པའི་ཁག་མི་ཐེག།",
    "གཞན་ནི་བལྟ་བྱ་ལྟ་བྱེད་གཉིས་འཛིན་གྱི་དྲི་མ་དག་ནས་ལྟ་མཁན་ནམ་ངོ་ཤེས་མཁན་ཁོ་རང་ཡུལ་མེད་དུ་མཐའ་བྲལ་སེམས་ཉིད་ཕྱག་རྒྱ་ཆེན་པོར་རྟོགས་དགོས་སོ།",
    "དུས་རྣམས་ཀུན་འགྲོ་འདུག་ཟ་ཉལ་ལྷ་སྒོམ་སྔགས་བཟླས།",
    "ས་ལམ་གྱི་རིམ་པ་སོགས་མ་ཤེས་ཀྱང་རིག་པ་རང་ངོ་ཤེས་ཤིང་རང་སོ་ཚུགས་པ་ལ་རིམ་གྱིས་གོམས་ཤིང་བརྟན་པ་ཐོབ་སྟེ།",
    "སེམས་ནང་དུ་མ་ལུས་པར་སེམས་ཁོ་རང་ཤར་བ་མ་གཏོགས་གཞན་མ་ཡིན་པས།",
    "ཡང་དྲན་པ་ཧྲིག་ཧྲིག་ཅིག་ཏུ་སྒྲིལ་བ་ནི་འཇུར་སྒོམ་ཞེས་བྱ་སྟེ་ལྷོད་ཆ་དང་རང་བབས་སྐྱོང་མ་ཤེས་པས་ཅུང་ཟད་མི་འོང་ཞིང་སྒོམ་སྐྱོན་དང་གེགས་མང་ངོ།",
    "འཐོབ་བྱ་ཡེ་ཤེས་སོགས་ཐམས་ཅད་སེམས་ཁོ་རང་གཅིག་པུ་ལམ་དུ་ལྷོངས་མ་ལྷོངས་མ་གོ་བར།",
    "སེམས་ཉིད་སྟོང་སང་ངེ་འདུག་གམ།",
    "དྲན་པ་སྒོམ་གྱི་དངོས་གཞི་ཡིན་པས་འགྲོ་འདུག་ཟ་ཉལ་སྨྲ་བརྗོད་ནམ་གྱི་ཚེ་ནའང་དྲན་པ་མ་ཡེངས་པ་ལ་བརྩིས་ཅན་དུ་བྱ།",
    "བཏང་སྙོམས་སུ་མ་ལུས་པར་སེམས་ཀྱི་ངོ་བོ་འདི་འདྲ་ཞིག་འདུག་བྱ་རྒྱུའམ།",
