    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དུམ་བུར་གསུངས་པའི་དངོས་གྲུབ་ཐམས་ཅད་བསྡུས་པར་གྱུར་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ལྡུདང་པོ་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་ཉིད་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ལས་ཀྱི་དཀྱིལ་འཁོར་ཉིད་དུ་གསུངས་པ་ཉིད་གཟུང་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "ཡང་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ལས་ཀྱི་དཀྱིལ་འཁོར་ལ་ལྟོས་སྒོ་པས་ན།",
    "དེའི་༦་བྱིན་གྱིས་བརླབས་པའི་བརྟན་པར་གྱུར་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་མིང་དེ་སྐད་ཅེས་བྱ་བ་དེ་ལ་སྙོམས་པར་ཞུགས་ཤིང་མངོན་སུམ་དུ་༧མཛད་པའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་སྤྲུལ་པ་ལ་རྨྱེབརྟན་པར་བྱེད་པའི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་ནས།",
    "རིག་པ་དམ་པ་འདི་གསུངས་སོ།",
    "དཀྱིལ་འཁོར་ཀྱི་བདག་པོ་ལྔས་སོ་སོར་རིག་པ་གསུངས་ནས་གཅིག་ཏུ་གྱུར་ནས་བསྐྱེད་པ་ཡིན་ནོ།",
    "ལས་ཀྱི་ཧཱུཾ་མཛད་རྣམས་དགོད་པར་བྱའོ།་།",
    "དཔེར་ན་རྣམ་པར་སྣང་མཛད་ཀྱི་རིག་༥པ་གསུངས་ནས་ཐམས་ཅད་གཅིག་ཏུ་གྱུར་ཏེ།",
    "ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལྔ་པོ་༡གསུངས་པ་ཡིན་ནོ།",
    "ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་ལས་ཀྱི་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལྔ་པོ་ཤེས་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་བཞིན་དུ།",
    "ཉེ་བའི་ཁྱམས་ཉུསྤངས་པའི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་བཞིན་དུ་བྲི་བར་བྱའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོར་གསུངས་པའི་ཚུལ་གྱིས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རྣམ་པར་སྣང་མཛད།",
    "ཨོཾ་སཛེེ་ཏ་ཐཱ་ག་ཏ་བཛྲ་ས་མ་ཡ་ཧཱུཾ་ཞེས་བརྗོད་ནས་གཞག་པར་བྱའོ།",
    "དེ་ནས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་སྦྱོར་བས་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་རྗེས་སུ་སྤྱད་ལ་ཇི་ལྟ་བ་བཞིན་བསྡུ་བར་བྱའོ།",
    "དེ་ནས་མཚན་བརྒྱ་རྩ་བརྒྱད་པས་བསྟོད་པ་བྱས་ལ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་འདིར་ཡང་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་གྱིས་སྤྱན་དྲངས་པ་ལ་སོགས་པའི་ཆོ་ག་རྒྱས་པར་ཀྞིབྱའོ།",
    "ཇི་ལྟར་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱིས་བགེགས་བསྐྲད་ནས་ཕྱོགས་བཅིང་བ་ལ་སོགས་པ་བྱས་ནས།",
    "ཁྲོ་བོ་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་སྒོ་བཅད་ལ་ཁྲོ་བོ་རྡོ་རྗེ་སྲུང་བས་སྲུང་ཕྱེབ་ཐམས་ཅད་ཡང་དག་པར་བསྲུངས་ཁྱེལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དུ་བྱས་ནས།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་ཕྱག་རྒྱ་བཞིས་མདུང་རྩེ་གསུམ་པ་རྡོ་རྗེའི་ཕྱག་རྒྱས་མནན་པ་ལ་སོགས་པ་ཕྱག་རྒྱ་བཞིས་རྒྱས་གདབ་པར་བྱའོ།",
    "གྲུབ་པ་ཡང་ནི་ཐོབ་པར་འགྱུར།",
    "གྲུབ་པ་ཡང་ནི་ཐོབ་པར་འགྱུར།",
    "བཅོམ་ལྡན་འདས་ལས་ཀྱི་ཧཱུཾ་ལྷ་༧མཛད་དུ་བྱས་ལ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྦྱོར་བ་བྱའོ།",
    "དངོས་གྲུབ་ཐོབ་པར་འགྱུར་ཏེ།",
    "རིགས་ལྔ་བསྒོམས་པ་དེ་༡བསླབ་པར་བྱའོ།",
    "ཡིད་དུ་འོང་བ་དེས་ཤིན་ཏུ་གྲུབ་པ་ཐོབ་པར་འགྱུར་ཞེས་བྱ་བའོ།",
    "དེ་ལ་རྣམ་པར་སྣང་མཛད་དང་།",
    "འདོད་པར་བྱས་པས་ན་འདོད་པ་སྟེ།",
    "སྐལ་བ་དང་ལྡན་པར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་ཚུལ་གྱིས།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པའི་སྤྱོར་བས་ཇི་སྐད་གསུངས་པའི་རྣལ་འབྱོར་ཆེན་པོ་བྱས་ལ།",
    "ཧཱུཾ་ཞེས་བྱ་བས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོར་སྤྲུལ་ཏེ།",
    "ཨོཾ་སཏྠ་ཏ་ཐཱ་ག་ཏ་ས་མ་ཡེ་ཧཱུཾ་ཞེས་བྱ་བས་ཁྱརྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ལ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོར་སྤྲུལ་ལ།",
    "བདག་ཉིད་རྣམ་པར་སྣང་མཛད་དུ་གྱུར་པར་བྱའོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་བདག་ཉིད་ཀྱིས་སྤྲུལ་པར་བྱའོ།",
    "ཨོཾ་སྭ་བྷཱ་བ་ཤུརྙོལྷཧཾ་གེཞེས་རང་བཞིན་གྱིས་རྣམ་པར་དག་པར་བསྒོམས་ལ།",
    "བདག་ཉིད་གཟུགས་བརྙན་དང་མཚུངས་པར་བསམ་པར་བྱའོ།",
    "དེ་ནས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་རང་བཞིན་ནི་ང་ཉིད་ཡིན་ནོ་ཞེས་ང་རྒྱལ་བསྐྱེད་ལ་འདི་སྐད་ཅེས་ལན་གསུམ་བརྗོད་དོ།",
    "ཁྲོ་བོའི་བཟླས་བརྗོད་བྱས་ལ།",
