    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པ་ལས་ཐམས་ཅད་ལ་ཐོགས་པ་མེད་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "ད་ནི་ཕྱག་རྒྱ་ཆེན་པོ་བསྒྲུབ་པ་གསུངས་པ་ནི།",
    "དེའི་ཡེ་ཤེས་བསླབ་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་ལེགས་པར་ཞུགས་ནས་ནི།",
    "ལས་རྣམས་ཀུན་ནི་བྱེད་པར་འགྱུར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པའི་དཀྱིལ་འཁོར་རྣམས་སུ་དངོས་གྲུབ་ཏུ་འགྱུར་བ་དེ་བཞིན་དུ་འདིར་ཡང་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ད་ནི་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེས་ངརྟོག་པའི་རྒྱལ་པོ་ཡུན་རིང་དུ་གནས་པར་བྱ་བའི་ཕྱིར།",
    "བྱིན་ཀྱིས་བརླབས་པར་གསོལ་བ་འདེབས་པའོ།",
    "དཀའ་བ་མེད་ཅིང་བརྟུལ་ཞུགས་མེད་པར་དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་བགྱི་བའི་སླད་དུའོ་ཞེས་བྱ་བས།",
    "དེ་ལྟར་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེས་གསོལ་བ་བཏབ་པར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་རྟོག་པའི་རྒྱལ་པོ་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར།་",
    "དེའི་རྟོག་པའི་ཆོ་ག་ནི་དཀྱིལ་འཁོར་ཆེན་པོ་ལ་སོགས་པ་སྟོན་པར་བྱེད་པའི་སྒྲའི་༩སྣཚོགས་སོ།",
    "ཁྲོ་བོའི་སྤྲུལ་པར་རབ་གྲགས་པ།",
    "རྟོག་པའི་རྒྱལ་པོ་འདི་གསུངས་སོ།",
    "འཇིག་རྟེན་གསུམ་གྱི་དཀྱིལ་འཁོར་ཆེན་པོ་གསུངས་པ་ནི།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་དང་པོ་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་རྫོགས་པར་བྱས་ནས།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་རྣམ་པར་སྣང་མཛད་དང་།",
    "མཁྱེན་བཞིན་དུ་ཞེས་བྱ་བ་ནི།",
    "རྒྱུ་ཅིའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བཀའ་སྩལ་པར་མཛད་སྙམ་དུ་བསམས་པའོ།",
    "དེའི་རྣམ་པར་ཤེས་པ་དགུག་པ་ནི།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་བཀའ་དང་།",
    "དེ་ནས་ལྷ་ཆེན་པོའི་ལུས་དེ་ཐམས་ཅད་ནས་ཐམས་ཅད་དུ་རྣམ་པར་ཤེས་པ་མེད་པ་ལ་སོགས་བྱེ་པར་གྱུར་ཏོ་ཞེས་བྱའོ།",
    "གསང་བའི་ལྕགས་ཀྱུ་བསྡམས་བྱས་ཏེ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་རྡོ་རྗེ་རྒྱལ་པོའི་གནས་སུ་བསྟན་ཟིན་ཏོ།",
    "དེ་དག་བརྟན་པར་བྱས་ལ།",
    "ཐ་མ་མཉམ་དུ་བརྐྱང་བྱས་ལ།",
    "སྲོག་ནི་ཕྱིར་ཡང་ཐོབ་པར་འགྱུར།",
    "རྡོ་རྗེ་བསླང་བའི་ཕྱག་རྒྱས་བསླང་བར་བྱའོ་ཞེས་ཤེས་པར་བྱའོ།",
    "སྤྲུལ་པའི་ལུས་རྣམ་པར་ཤེས་པ་དང་བཅས་པ་བརྟན་པར་མཛད་དོ།",
    "རྡོ་རྗེ་བཅིང་བ་དམ་བྱས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་དབྱིངས་སུ་གསུངས་པའི་རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྟོགས་པར་མཛད་དོ།",
    "གསུངས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གནང་བ་ནོད་པ་དང་གནས་ཀྱི་ངེས་པའི་དོན་དུ་དེ་ལྟར་གསོལ་བ་འདེབས་པར་བྱེད་པ་ཡིན་ནོ།་།",
    "བདག་ཉིད་སྲུང་བ་བྱས་ལ་འཇིག་རྟེན་པའི་འཁོར་ལོ་ཐམས་ཅད་ལ་བཀའ་བསྒོ་བ་བྱའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་འཇིག་རྟེན་པའི་འཁོར་ལོ་དེ་དག་འཚེ་བར་བྱེད་པར་འགྱུར་རོ།",
    "ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་༡་དེ་བཞིན་གཤེགས་པའི་༡༡གཙུག་ཏོར་རྣམས་ལས་དངོས་སུའོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་སྣང་བར་བྱས་ནས་ཡང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཙུག་ཏོར་ནས་འདི་བྱུང་ངོ་ཞེས་བྱ་བ་ནི་ངེས་པར་ཕྱུང་བའོ།",
    "སེམས་དཔའི་རྔུགཙུག་ཏོར་གྱིས་བདག་ཉིད་སྲུང་བ་བྱས་ལ།",
    "དེ་ནས་བསྡུ་བ་བྱས་ལ་བྱིན་གྱིས་བརླབས་པ་ནས་བརྩམས་པ་ནི།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་གདབ་པར་བྱའོ།",
    "ཚོན་སྣ་ལྔའི་སྐུད་པ་ཕུར་བུ་ལ་ཉིས་ལྡབ་ཉུཏུ་བྱས་ལ་བཏགས།་",
    "ཞེས་བྱ་བ་ནི་འཁོར་ལོ་བྱས་ནས་ཕྱོགས་དང་མཚམས་ཀྱི་ཐིག་གདབ་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གསུམ་པ་ལ་ཐིག་སྐུད་སུམ་འགྱུར་གྱིས་ཐིག་གདབ་པར་བྱའོ།",
    "གལ་ཏེ་དཀྱིལ་འཁོར་ཐམས་ཅད་ལ་ཁྲུ་བཅུ་གཉིས་ཀྱི་ཚད་ཡོད་ན་དེ་ལས་ཁྲུ་དེའི་ཚད་ཀྱི་ཐིག་སྐུད་ཀྱིས་དབུས་མའི་ཐིག་གདབ་པར་བྱའོ།",
    "ཐོག་མར་ཇི་ལྟར་བརྩམ་པར་བྱ་བ་ཡིན་ཞེ་ན།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས།",
    "དེ་ལྟར་ཉེ་བར་མཚོན་པའི་ཚིག་བསྟན་ནས་ད་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་བྲི་བར་བྱའོ་ཞེས་རྣམ་པར་འགྲེལ་པ་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཤར་ཕྱོགས་ལ་སོགས་པར་༢བྲི་བར་བྱ་སྟེ།"
  ]
}