    "ཐུབ་པ་མཆོག་གིས་ཉེས་པའི་སྤྱོད་པ་སྤངས།",
    "རྩུབ་པའི་རེག་པ་དང་བྲལ་འཇམ་པའི་སྐུ།",
    "ཤིན་ཏུ་དག་གོ་ཉོན་མོངས་ཤེས་བྱའི་སྒྲིབ།",
    "བྱམས་བརྩེའི་ཐུགས་ཀྱིས་འགྲོ་ལ་ཉེ་བར་གཟིགས།",
    "བདེན་གཉིས་གནས་ཚུལ་མ་ལུས་ཇི་བཞིན་གཟིགས།",
    "ཐོགས་མེད་གཟིགས་པའི་སྤྱན་གཉིས་རྣམ་པར་དག།",
    "དུས་གསུམ་ཤེས་བྱ་ཇི་བཞིན་གཟིགས་པ་ཅན།",
    "ལང་ཚོ་གསལ་བའི་གཞོན་ཤ་ཅན་ཉིད་དང་།",
    "བཅུ་གཅིག་པ་དོན་གཅིག་གི་གསལ་བྱེད་ནི།",
    "གཟིགས་པ་རབ་རིབ་མེད་པས་དག་པ་ཉིད།",
    "ལས་དང་ཉོན་མོངས་དྲི་མས་མ་སྦགས་ཤིང་།",
    "ལྟེ་བའི་རི་མོ་གཡས་སུ་འཁྱིལ་བ་ནི།",
    "ཁྱོད་ཐུགས་དྲི་མས་རྟག་ཏུ་མ་གོས་པས།",
    "བརྒྱད་པ་རྗེས་གནང་གིས་འགོག་པ་ནི།",
    "འཚོ་ཞིང་གཞེས་པ་ཡིད་འཕྲོག་སྐྱེད་མོས་ཚལ།",
    "ཕྲ་མོའི་གནས་ལུགས་ཇི་བཞིན་གཟིགས་པ་ལས།",
    "མགོན་ཁྱོད་གནས་གཞན་འབྱོན་ནམ་མ་ཡིན་ཀྱང་།",
    "ཕྱག་རིས་རིང་དུ་བཀྲ་བའི་བཅོམ་ལྡན་ཁྱོད།",
    "བཅུ་གཉིས་པ་རྩུབ་མོས་འགོག་པ་ནི།",
    "སྐལ་ངན་གཏི་མུག་ཅན་གྱི་ལེགས་སྐར་ཁྱོད།",
    "ཤིན་ཏུ་དམར་འཛུམ་མཆུ་སྒྲོས་མཛེས་པ་ཁྱོད།",
    "མི་སྨྲ་ཚལ་དུ་གཤེགས་ཞེས་བརྗོད་འདོད་མོད།",
    "མགོན་ཁྱོད་ཞི་བའི་བདེ་བ་ལ་སྦྱོར་ཀྱང་།",
    "ཐེག་གསུམ་རིགས་ཅན་རེ་བསྐོང་ངམ་མིན།",
    "ཐབས་ལ་མཁས་པའི་གསུང་གི་དམ་པ་སྩོལ།",
    "སྐྱོན་གྱིས་བསྐུར་བའི་ལྷས་བྱིན་ཁྱོད་ཉིད་ཀྱི།",
    "ཉོན་མོངས་དྲི་མ་མེད་པའི་མཆེ་བ་དཀར།",
    "སྐད་ཅིག་ཉིད་ལ་འགྱུར་ལྡོག་རང་གི་གཤིས།",
    "ལས་ཅན་འགའ་ལ་ཚ་བའི་རེག་པ་སྟེར།",
    "འབྱུང་འགྱུར་དངོས་རྣམས་རིང་ནས་རྗེས་སུ་གཟིགས།",
    "དང་པོ་གཅིག་གི་ལྡོག་པ་ཅན་ནི།",
    "ཉོན་མོངས་སྡུག་༡༧བ་པའི་རྐྱེན་རྣམས་ཇི་བཞིན་གཟིགས།",
    "འོན་ཀྱང་མ་དག་ཞིང་གི་གདུལ་བྱའི་གཉེན།",
    "གང་གི་ཕྱག་ཟུང་རིང་ཞིང་རབ་ཏུ་རྒྱས།",
    "ཕ་རོལ་དཔུང་གི་གཡུལ་ལས་རྣམ་པར་རྒྱལ།",
    "གསལ་མོད་རྨོངས་པའི་སྒྲིབ་པ་མ་སྤངས་པས།",
    "རྒྱལ་བའི་སྲས་རྣམས་ཁྱོད་ཀྱིས་དོ་ཟླ་མིན།",
    "འོག་མིན་ཞིང་གི་མགོན་པོ་ལྔ་ལྡན་སྐུ།",
    "རྣམ་འདྲེན་ཁྱོད་ནི་ཁྱད་པར་དེ་དག་དང་།",
    "འགྲོ་བ་ཡོངས་ཀྱི་ཕན་བདེའི་རེ་བ་སྐོང་།",
    "ཕྱི་རོལ་གྱི་སྒྱུ་ཅུང་ཟད་ཀྱིས་འབྲས་བུ་རང་གི་ངོ་བོ་ཉིད་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
    "ནང་གི་རྒྱུ་ཅུང་ཟད་དང་བཅས་པའི་འབྲས་བུ་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
    "འབྲས་བུ་རང་གི་ངོ་བོ་ཉིད་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
    "རྡོ་རྗེ་འཆང་དངོས་བདག་གི་མངོན་དུ་ཐོབ།",
    "སྙན་ཚིག་སྨྲ་བའི་ངག་གི་དཔལ་སྟེར་ཞིང་།",
    "བཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱན་ལ་བཞི་ཡོད་པའི།",
    "བཟང་པོའི་ཚིག་གི་ཡིད་དུ་འཐད་པའི་གསུང་།",
    "རྗེས་སུ་འགྲོ་བ་ཐུབ་པའི་གསུང་མཆོག་གི།",
    "ཉོན་མོངས་བག་ཆགས་མ་ལུས་ཀུན་སྤངས་པའི།",
    "བཅུ་གཉིས་པ་རབ་རྟོག་གི་རྒྱན་ལ་གསུམ་ཡོད་པའི།",
    "གང་གི་གསུང་དབྱངས་སྙན་ཞིང་འཇེབས་པ་ནི།",
    "སྙན་པའི་གསུང་གི་ཀུན་ནས་དགའ་བ་བསྐྱེད།",
    "འདོད་ཆགས་ལ་སོགས་ཉོན་མོངས་ཚོགས་རྣམས་འཇོམས།",
    "བསིལ་བའི་རེག་པ་མ་ལུས་ཉམས་པར་བྱེད།",
    "མི་སྲུན་ཉག་ཕྲན་བདག་པོའི་དཔུང་ཚོགས་བཅོམ།",
    "ཁྱོད་གསུང་སྙན་པས་སེམས་ཀྱང་ཚིམ་པར་བྱེད།",
    "གསུང་མཆོག་འདི་ནི་འབྲུག་གི་སྒྲ་མ་ཡིན།",
    "ཟབ་མོའི་དབྱངས་ཀྱིས་ཐེག་གསུམ་གདུལ་བྱ་ལ།",
    "བཅུ་བཞི་པ་ཕྲ་མོའི་རྒྱན་ལ་གཉིས་ཡོད་པའི།",
    "དང་པོ་ཟུར་གྱི་ཕྲ་མོ་ནི།",
    "གཉིས་པ་རྣམ་པའི་ཕྲ་མོ་ནི།",
    "མེ་ཏོག་མདའ་ཅན་དཔུང་གི་མཚོན་ཆ་ཡང་།",
    "རྣམ་འདྲེན་ཁྱོད་ཀྱི་གསུང་དབྱངས་རྒྱ་ཆེ་ཞིང་།",
    "ཟབ་མོའི་གསུང་དབྱངས་འབྲུག་སྒྲའི་ངག་གི་དཔལ།",
    "གང་གི་གསུང་དབྱངས་སྙན་ཞིང་འཇམ་པ་ཡིས།",
    "ཡན་ལག་བཞི་པའི་དཔུང་ཚོགས་མ་བཤམ་ཞིང་།",
    "དྲང་སྲོང་མཆོག་གིས་གདུལ་དཀའི་སྣོད་མིན་འགའ།",
    "བདུན་པ་རྨད་བྱུང་གི་ཉམས་རྒྱན་ནི།",
    "བརྒྱད་པ་འཇིགས་རུང་གི་ཉམས་རྒྱན་ནི།",
    "སྲིད་དང་ཞི་བའི་ཕུན་ཚོགས་གཡང་གི་དཔལ།",
    "བྱམས་བརྩེའི་ཐུགས་ཀྱི་གཟིགས་པ་རྣམ་པ་ལྔས།",
    "གསོ་སྦྱོང་ལོ་གནས་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཡི།",
    "ཟབ་མོའི་གསུང་དབྱངས་སྐྱོ་མེད་རབ་དགའ་བའི།",
    "མགོན་པོ་ཁྱོད་ཀྱི་གསུང་གི་རང་བཞིན་ནི།",
    "མཁར་ཉལ་ཚོགས་ཀྱི་ལེགས་བྱས་དཔུང་གི་མཐུ།",
    "རྟག་ཏུ་མི་འགྱུར་ངག་གི་མཆོག་སྦྱིན་པ།",
    "འཇམ་དཔལ་དབྱངས་ཉིད་དྲི་ཟའི་བུ་མོ་མིན།",
    "དུས་གསུམ་གཟིགས་པ་མངའ་བའི་གསུང་ལ་སྟེ།",
    "ཕྱོགས་ཀྱི་འཁོར་ལོའི་ཁྱོན་ཀུན་ཡོངས་སུ་ཁྱབ།",
    "ཁྱོད་གསུང་རྣམ་པ་ཀུན་གྱི་མཆོག་དང་ལྡན།",
    "སྙན་ཞིང་ཡིད་དགར་འོང་མོད་རྔ་སྒྲ་མིན།",
    "རྣམ་འདྲེན་ཁྱོད་ཀྱི་ཡན་ལག་དྲུག་ཅུའི་གསུང་།",
    "རྣོ་ངར་རྩུབ་པའི་རེག་པ་དང་བྲལ་ཡང་།",
    "ཉོན་མོངས་དུག་གསུམ་སྲིད་པའི་སྡུག་བསྔལ་དང་།",
    "བདུད་ཀྱི་དཔུང་ཚོགས་མ་ལུས་འཇོམས་པར་བྱེད།",
    "ཡོངས་སུ་རྫོགས་པ་འོག་མིན་ཞིང་གི་མགོན།",
    "རིང་མོ་ཞིག་ནས་ཚངས་པའི་གནས་བཞི་ལ།",
    "མན་ངག་ཟབ་མོའི་རྣལ་༢༣ན་འབྱོར་མ་བསྟེན་ཀྱང་།",
    "དཔུང་ཚོགས་ཡན་ལག་བཞི་དང་མི་ལྡན་ཀྱང་།",
    "སྒྱུ་འཕྲུལ་ཟབ་མོས་ངོ་མཚར་ཅིར་ཡང་བསྐྱེད།",
    "ཉོན་མོངས་གདུང་བའི་ངལ་བ་མ་ལུས་སེལ།",
    "གཉིས་པ་གཞི་གཅིག་གི་བྱེད་པ་འགལ་བའི་རྒྱན་ནི།",
    "ཐུབ་པ་མཆོག་གི་ངུར་སྨྲིག་རྣམ་གསུམ་དང་།",
    "ལྔ་པ་གཞི་གཅིག་གི་ལས་འགལ་པའི་རྒྱན་ནི།",
    "འཚེ་བ་མིན་ཡང་མུ་སྟེགས་མཐའ་དག་གི།",
    "རྣམ་འགྱུར་སྟོང་གི་རྩེ་དགའ་ཀུན་ཏུ་སྟོན།",
    "ཐུགས་ཀྱི་དགོངས་པ་ཁྱོད་ལ་ཇི་ལྟར་མངའ།",
    "སུམ་ཅུ་པ་ངེས་བསྟན་གྱི་རྒྱན་ལ་གཉིས་ཡོད་པའི་དང་པོ་མཆོག་གི་ངེས་བསྟན་གྱི་རྒྱན་ནི།",
    "མི་བཟད་གྲང་བའི་ཚོགས་ཀྱི་རེག་པ་ལས།"
  ]
}