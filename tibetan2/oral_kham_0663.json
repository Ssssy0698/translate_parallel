    "བསྲུང་བྱའི་གནས་སུ་འདུག་ན་སྲུངས།",
    "བསྒྲལ་བྱའི་གནས་སུ་འདུག་ན་སྒྲོལ་ཞེས་ཕྲིན་ལས་འཆོལ་རིགས་སོ།",
    "སྡིག་སྒྲིབ་ཀྱང་རང་སར་གྲོལ་བའི་གནས་ལུགས་མཐོང་བ་དང་།",
    "ཁོ་རང་བཏུང་པའི་ཉེས་པར་མ་ཟད་ཀྱིས།",
    "གཞན་དང་རང་ཉིད་ཉམས་པར་མི་འགྱུར་སླད།",
    "ཇི་ལྟར་བལྟམས་པ་ནས་ཤྲཱི་ཡེ་ཧཱུྃ་ཞེས་བརྗོད་ཅིང་རང་ལྷའི།",
    "བཛྲ་ཝརྞཱ་ནཱི་ཡེ་ནི་རྡོ་རྗེའི་རིགས་ཅན་མ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་མ།",
    "གནས་དབེན་པར་མཚམས་སུ་འདུག་པའི་ནུབ་དང་པོར།",
    "གོས་འདུག་ན་འགྱོད་པ་དྲག་པོས་བཤགས་བསྡམས་དང་།",
    "དེའང་རང་གཞན་གྱི་ལུས་ལོངས་སྤྱོད་འདས་པ་མི་འབུལ།",
    "འདུག་གནས་གཅིག་ལྷག་པོར་མ་བྱས་པ།",
    "ཞབས་གཡས་བརྐྱང་མ་ཡིན་པར་ཙོག་པུར་བཞུགས་པ་ལྟ་བུ་བྱས་འདུག་པཎ་ཆེན་གོང་མའི་གསུང་དུ་ཆོ་ག་གསུམ་བསྐྱེད་དང་།",
    "ཞེས་བདེ་མཆོག་འདོན་གྱི་འདུག་བདག་འཇུག་ཆག་མེད་བྱེད་ནའང་རྟ་ཐོག་ནས་བཏོན་ཆོག་པ་དེ་དང་འདྲ།",
    "དེ་ནས་རང་ཉིད་ཤར་སྒོའི་ཐད་ནས་དཀྱིལ་འཁོར་ལ་ཕྱོགས་ཏེ་འདུག་མདུན་དུ་ནང་མཆོད།",
    "བཟླས་པའི་མཐའི་ཡིག་བརྒྱ་མཆོད་བསྟོད་ཀྱི་རྗེས་སུ་བྱུང་ཡང་དེང་སང་སྡོན་དུ་བྱེད་སྲོལ་འདུག་དཀྱིལ་ཆོག་རིན་ཕྲེང་ལས།",
    "དེ་ནས་རང་ཤར་སྒོའི་ཕྱི་རོལ་སྔར་གྱི་གནས་སུ་འདུག་པར་བསམ་ལ།",
    "རིན་ཆེན་མེ་མེ་བསྣམས་པ་ཀར་ལུགས་ཀྱི་ཕྱག་མཚན་ལ་འདུག་ཀྱང་།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་ནས།",
    "མགྲིན་པ་ཡུད་ཙམ་བཀུག་ལུས་ཀྱི་འདུག་སྟངས་ལེགས་པོ་བྱུང་ན་ལུས་དྲང་བས་རྩ།",
    "ཞི་ཁྲོ་ཐམས་ཅད་སྤྱན་དྲངས་ནས་བསྟིམ་པ་ཡིན་པར་འདུག་ཛ་ཞེས་དམ་ཚིག་པ་དང་ཉེ་བར་ཕེབས།",
    "ཧམ་པས་ཅི་བྱེད་ཅེས་ཁ་རོག་བསྡད་ན་སྔོན་ཡང་རང་བསྡད་པས་མ་སྐྱེས་པས་ད་དུང་མི་སྐྱེ།",
    "ས་བཅུའི་བྱང་སེམས་ཀྱི་ཉམས་ལེན་ལྟ་བུ་སོ་སྐྱེ་སུས་ཀྱང་མི་ནུས་པས་ང་འདྲ་ཡོང་བ་མི་འདུག་ཅེས་བཞག་ན་མི་ཡོང་བས་ད་ལྟ་དལ་འབྱོར་ཐོབ།",
    "ཕྱི་ན་དགྲ་མེད་ཀྱང་རང་སེམས་དགྲར་ལངས་ནས་སྡུག་བསྔལ་སྣ་ཚོགས་བསྐྱེད།",
    "རང་ལའང་མཚོན་གྱིས་བསྣུན་པ་བྱས་ན་མ་ཁོ་རང་ལན་ནམ།",
    "བློས་གཏང་རང་ཤུགས་ལ་འབྱོང་དགོས།",
    "བྱིང་ཟོན་བྱས་ཀྱང་རང་ཤུགས་ཀྱིས་ཏིང་འཛིན་སྐྱོན་མེད་ཡོང་བས་གང་ལྟར་ཐོག་མར་ཞི་གནས་ཀྱིས་སེམས་ལས་རུང་བ་ཞིག་བྱས་ནས་ལྷག་མཐོང་སྒྲུབ་ན་ནང་དུ་སེམས་གནས་པའི་སྟོབས་ཀྱིས་དགེ་རྩ་གང་བྱས་མཐུ་ཆེ།",
    "འཇིག་རྟེན་ན་རྒྱལ་བོ་གདན་ལ་འདུག་ཀྱང་སྤྱན་གྱིས་ཟང་ཁ་ཟེར་བ་ལྟར།",
    "འདི་ཙམ་དམའ་ན་བྱིང་བ་སྐྱེ་བར་འདུག་སྙམ་པ་ལས་མཐོ།",
    "འདི་ཙམ་མཐོ་ན་རྒོད་པ་སྐྱེ་བར་འདུག་སྙམ་པ་ལས་དམའ་བར་བྱས་ནས་གྲིམ་ལྷོད་ཀྱི་མཚམས་མྱོང་སྟེང་ནས་བྱེད་དགོས་པར་གསུངས།",
    "ལྷས་བྱིན་ཁྱིམ་ན་འདུག་ཅེས་མ་ཚིམ་པར།",
    "ཁྱིམ་དུ་ལུས་ཀྱི་བྱིང་གང་ན་འདུག་བརྟགས་པ་བྱས་ནས་འཛིན་ལུགས་མེད།"
  ]
}