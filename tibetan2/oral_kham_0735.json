    "༡༢༧དགོད་ཅིང་འདུག་པར་མི་བྱའོ།",
    "ངོ་མི་ལྟ་ཞིང་སེམས་ས་ཕྱོགས་ལ་གཏད་དེ་འདུག་པར་འགྱུར།",
    "གང་ལ་འདི་ན་འདུག་པ་འདི་ལྟ་བུ་སུ་ཞིག་དེ་ལ་རྗེས་སུ་ལྟ་བར་འགྱུར།",
    "དད་པ་དང་རངས་པར་བྱེད་ཅིང་དེ་དག་ལ་ཕན་འདོགས་པ་དང་།",
    "བྱེད་ཅིང་འདུག་པར་འགྱུར་ཏེ།",
    "ཐམས་ཅད་དུ་ནི་འདུག་པར་འགྱུར།",
    "ཚེ་དང་རང་སྲོག་བཏང་བཞིན་ནོ།",
    "གནས་ན་འདུག་པའང་རྙེད་མི་འགྱུར།",
    "འཁོར་གྱི་ནང་ན་འདུག་པ་ན་འདི་དག་ནི་ངར་འཛིན་པ་ལ་གནས་པ།",
    "དཔེར་ན་རིའི་རྒྱལ་པོ་རི་རབ་ཀྱི་མདུན་ན་ཡུངས་འབྲུ་གཅིག་ིའདུག་པ་བཞིན་དུ་སྦྱིན་པའི་ཚོགས་དང་།",
    "ཤེས་རབ་དེའི་རྣམ་པ་ནི་ཇི་ལྟ་བུར་ིའདུག་ཅེ་ན།",
    "ཐོས་པ་ཡང་རྣམ་པ་ཇི་ལྟ་བུ་ཇི་ལྟར་འདུག་ཅེ་ན།",
    "ཇི་ལྟར་ལོང་བའི་མདུན་ན་འདུག་པ་དང་།",
    "དམིགས་པ་དང་རང་བཞིན་གྱིས་ཐོས་པ་རྒྱ་ཆེན་པོར་གྱུར་པ་དང་།",
    "འོད་སྲུངས་འདི་ལྟ་སྟེ་དཔེར་ན་བྱ་ཀ་ལ་པིང་ཀའི་ཕྲུ་གུ་སྒོ་ངའི་སྦུབས་ན་འདུག་པ་མིག་མ་བྱེ་བ་ཡང་།་",
    "རིག་པའི་སྒོ་ངའི་སྦུབས་ན་འདུག་པ།",
    "སྟན་ལ་འདུག་མི་འདོད་ན་ཡང་དགེ་སློང་དག་ལ་འཚོལ་བར་བྱེད་དེ།",
    "ཁྱིམ་གྱི་གནས་ན་འདུག་པ་དང་།",
    "བྱིས་པ་གང་ལ་ཆགས་འདུག་པ།",
    "དགེ་སློང་དག་གཞན་ཡང་རྒྱལ་པོ་དམའ་བ་ན་འདུག་པ་གནས་མཐོན་པོར་འཇོག་པ་དེའི་ཚེ།",
    "བུ་དང་ཆུང་མ་དང་སྐྱིད་དེ་བར་འདུག་པའི་རིགས་ཀྱི་བུ་མིའི་བྲན་དུ་སྦྱིན་པར་མི་བྱེད་དོ།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་འདི་རྣམས་པེ་སྣར་ལ་སླར་ཡང་བསྐྱར་ཟློས་སུ་འཁོད་འདུག་༧ པེ་སྣར་འཕང་བར།",
    "དེ་ཡང་རང་བཞིན་མེད་པར་བསྒོམ།",
    "ཅི་ཕྱིར་བདག་ཡིད་བདེ་བར་འདུག།",
    "དེ་ལྟར་སྟོན་པས་གསུངས་ཏེ་འཇིག་དུས་ཀྱི།",
    "དེ་ལ་རང་ལ་མངོན་དུ་ཕྱོགས་ཤིང་ཙོག་ཙོག་པོར་ིའདུག་སྟེ།",
    "ཞེས་བྱ་བས་ལན་གསུམ་དུ་ཕྱག་བྱས་ལ་འདུག་སྟེ།",
    "རྩོལ་བ་དེ་ཡང་རང་རྒྱལ་གྱིས།",
    "བི་རོ་ཙ་ན་པྲ་བྷ་རཱ་ཛཱ་ཡ།",
    "༤༦༩ ཡི་། ནུབ་བྱང་རང་གནས་མངོན་འཕགས་ཀྱི།",
    "འཇིགས་བཅས་རིམ་མིན་ཕྱོགས་མིན་འགྲོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་ཞེས་བྱ་བ་ནས་ཅིའི་སླད་དུ་འཇིག་རྟེན་ན་དབུལ་པོ་དག་གདའ་༧ལགས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཤེད་བུ་མ་ཡིན་པ་ནི་ནང་ན་འདུག་པའི་ཤེད་བུ་ལྟ་བུ་མེད་པའི་ཕྱིར་རོ།་།",
    "༢ ལྷག་པར་ཞེན་ནས་འདུག་པ་དེ་ནི་ཚོར་བའི་རྐྱེན་གྱིས་སྲེད་པ་ཞེས་བྱའོ།",
    "རྩ་བའི་རབ་དབྱེ་རྒྱུ་དང་རང་།",
    "དེ་དག་ནི་ཀུན་ཏུ་བརྟགས་པ་ཡིན་པས་དུས་གསུམ་དུ་ཡང་རང་བཞིན་མེད་པར་རིག་པར་བྱའོ།",
    "ཡང་རང་བཞིན་གྱིས་རུས་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "དེ་དག་ནི་ཀུན་ཏུ་བརྟགས་པ་ཡིན་པས་དུས་གསུམ་དུ་ཡང་རང་བཞིན་མེད་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "པ་བརྩེགས་པ་ཆེན་པོ་བྱས་ནས་འདུག་གོ།",
    "ཅིའི་ཕྱིར་རང་བཞིན་གྱི་གསུང་དང་རང་བཞིན་གྱི་སྐུས་བྱིན་གྱིས་མ་བརླབས་ཤེ་ན།་",
    "དངོས་པོ་ཡང་ཡོངས་སུ་གཟུང་བ་དང་རང་བཞིན་ནོ།",
    "དཔེར་ན་གསེར་གྱི་ས་ལེ་སྦྲམ་དེ་ཉིད་མགར་བ་མཁས་པའི་ལག་ན་བསྲེལ་ན་སྲང་གྲངས་ཀྱི་ཚད་བཞིན་དུ་འདུག་གོ།",
    "འདུག་གམ།",
    "བདུད་ཀྱི་ཡུལ་ན་འདུག་པར་སྣང་བ་ཡང་ཡིན་ཞེས་གསུངས་པའོ།",
    "མུ་སྟེགས་ཅན་གྱི་གནས་ཐམས་ཅད་ན་འདུག་པ་༧ཡང་སྣང་ལ།",
    "བད་ཁཆུ་ལ་ཟླ་བ་ཁོང་ལ་ག་དུས་ལྟར་པ་དེ་ལྟར་ཆེ་བ་ཉིད་ཀྱི་ཁྱད་པར་གྱིས་ས་འདིའི་རྣམ་པར་གཞག་པ་བསྟན་ནས།",
    "སྣར་འདུག་པར།",
    "དེའང་རང་དོན་དང་གཞན་དོན་ཕུན་སུམ་ཚོགས་པ་གཉིས་ལས།",
    "རྒྱར་འདོམ་ཕྱེད་བརྒྱད་ཡོད་པ་ཞིག་འདུག་པ་ལ་གྱད་རྣམས་འདི་སྙམ་དུ།",
    "སྐྱོན་བྲལ་ཡོན་ཏན་ལྡན་པ་འདི་ནི་སྟོང་གསུམ་གྱི་འབྱོར་བས་མཆོད་ཀྱང་རང་ཉིད་ལ་སྒྲིབ་པར་མི་འགྱུར་བས།",
    "ངོ་བོ་འདི་ལྟར་འདུག་ཅེས་བརྗོད་བྲལ་བའི།",
    "ལྷང་ལྷང་དུར་དུར་རྟག་ཏུ་སྐྱེ་ཞིང་འདུག།",
    "དེ་ལ་བསྐོར་བྱང་སྒྲིབ་གཉིས་བྱང་ཆོག་འདུག།",
    "དེ་ལ་ནང་ཁྲུས་སྡིག་སྒྲིབ་དག་ཆོག་འདུག།",
    "དེ་ལ་གང་བཏུང་འཇའ་ལུས་གྲུབ་ཆོག་འདུག།",
    "དེ་ལ་གང་མཇལ་ཚ་གདུང་འཇིགས་སྐྱོབ་འདུག།",
    "དེ་ལ་གང་སྒོམ་རྫུས་ཏེ་སྐྱེས་ཆོག་འདུག།",
    "དེ་ལ་གང་དག་དབུལ་ཕོངས་སེལ་ཆོག་འདུག།",
    "དེ་ལ་གང་མཇལ་འཇིགས་པ་བརྒྱད་སྐྱོབ་འདུག།",
    "དེ་ལ་གང་འབྲེལ་བདེ་ཆེན་ཐོབ་ཆོག་འདུག།",
    "དེ་ལ་གང་མཇལ་རྒོལ་བའི་གཡུལ་རྒྱལ་འདུག།",
    "དེ་ལ་གང་མཇལ་ཐར་ལམ་བགྲོད་ཆོག་འདུག།",
    "དེ་ལ་གང་མཇལ་བདེ་ཆེན་མཆོག་སྐྱེལ་འདུག།",
    "དེ་ལ་གང་མཇལ་དབུལ་ཕོངས་སེལ་ཆོག་འདུག།",
    "འདི་ནས་བསྒྲིག་རྒྱུག་དུས་ནས་གྲྭ་ཆས་ཚང་།",
    "དགོངས་པ་ལས་ཕྱི་རོལ་ཏུ་གྱུར་གདའ་ལགས་ཞུས་པས།",
