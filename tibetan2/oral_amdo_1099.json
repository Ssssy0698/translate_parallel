    "གང་གིས་ངེས་པར་གང་འདོད་དེས་དེ་འཐོབ་པར་འགྱུར།",
    "རྟག་ན་འདི་ནི་ཐམས་ཅད་དུ་ནི་སོང་བར་གྲུབ།",
    "དེར་ནི་བདག་གིས་ཁྱེད་ཀྱི་གནས་ནི་བྱེད་འདོད་དེ་། སྡིག་མེད་གནས་མཆོག་དམ་པ་དེ་ནི་བསྙེན་པར་མཛོད།",
    "གཞལ་ཡས་ཁང་གི་ལོགས་སམ་རྣམ་དབེན་ནགས་སུ་སྟེ་༡།",
    "དེ་ནས་གཏོང་བར་ལྷག་པར་མོས་པ་འདི་ཡིས་ནི།",
    "ཁྱོད་ཀྱི་སེམས་དཔའ་གཏོང་ལ་ལྷག་པར་མོས་པ་སྟེ།",
    "གང་གིས་གང་ཞིག་སྦྱིན་པ་དེ་ཡིས་དེ་ཉེར་འཐོབ་༢།",
    "དམ་པ་རྣམས་ཀྱི་རྗེས་སུ་སོང་བ་ལམ་འདི་ཡི་ཡིན།",
    "གང་གིས་དམ་པ་རྣམས་ལ་གནས་ནི་སྦྱིན་བྱེད་པ།",
    "ཁྱོད་ཀྱི་སྦྱིན་པ་འདི་ནི་ཆགས་པ་མེད་པ་ཡིན།",
    "དེ་ཕྱིར་ལེགས་སོ་ཁྱོད་ནི་སྲེད་པ་དེ་ལྟར་གྱུར།",
    "ཉེ་རྒྱལ་དང་ནི་ལྷན་ཅིག་དུས་སུ་སོང་བར་གྱུར།",
    "སོང་ནས་དེ་ན་ཀོ་ཤཱམ་༡རྒྱལ་པོའི་ཁབ་དང་ནི།",
    "གཙུག་ལག་ཁང་གི་ས་ལ་སོ་སོར་ཡང་དག་རྒྱུས།",
    "ཁྱོད་ཀྱིས་༢གལ་ཏེ་དོན་གྱིས་ཀུན་ནས་བཀྲམ་ན་ཡང་།",
    "ས་ནི་བདག་གིས་སྦྱིན་པ་མ་ཡིན་ཞེས་སྨྲས་ས་སོ།",
    "ཉེ་རྒྱལ་གྱིས་ནི་ངེས་པར་གཟིགས་པར་བྱ་བའི་དོན་ལྡན་པ་ར།",
    "རང་གི་ནོར་དང་སྟོབས་ཀྱི་དང་ནི་ལྟ་བ་ཡི་༩ཡང་ང་ངོ།",
    "རང་གི་གྲོང་གི་གནས་ལ་མཐའ་རུ་བསྙེན་པའོ།",
    "བདག་ཏུ་སོང་བའི་སྣ་ཚོགས་དཔལ་ལ་བརྟགས་ནས་ནི།",
    "མཐོང་ནས་བདག་གི་ཉམ་ཐག་སྟོབས་ལྡན་མཆོག་ཏུ་གྱུར།",
    "སྡུག་པའི་རྣམ་འགྱུར་རི་མོར་སོང་བ་ཇི་ལྟ་བར།",
    "དགའ་བ་ཡོད་པ་མ་ཡིན་འདི་ལ་དགའ་བ་ཐལ།",
    "དེས་ནི་སློང་མོ་ཟ་ཞིང་ས་ནི་རྫོགས་ལ་མིན།",
    "ཉི་མའི་ཤིང་རྟ་ཕྱག་གིས་རེག་པར་མཛད་ནས་ནི།",
    "རྒྱལ་པོ་མཆོག་གི་བདུད་རྩི་དེ་ནི་བཞེས་མཛོད་ཅིག།",
    "ཐམས་ཅད་བོར་ནས་ལས་ད་ང་ལྷན་ཅིག་ཁྱོད་ཀྱི་ནི།",
    "ལུས་དང་ངག་གི་ལས་འདི་རྣམ་པར་དག་པ་དང་།",
    "དེ་ནི་བདག་གི་དོན་ཡིན་གཞན་དོན་མ་ཡིན་ན་ནོ།",
    "རྩེ་མོ་འདས་ནས་ལྷ་ནས་ལྷ་ཡང་ལྷུང་བ་སྟེ་། ཀྱེ་མ་མིར་གྱུར་སྨོས་ཅི་བློ་གཏད་བྱེད་པ་སུ།",
    "དགའ་བཞིན་ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་གགོལ་ཏོ།",
    "དགའ་བའི་གཉེན་འདུན་ད་གའ་བ་ཁྱོད་ཀྱིས་བོར་བ་རྣམས།",
    "ཁྱོད་ནི་འཁོར་ལོས་སྒྱུར་བར་གལ་ཏེ་གྱུར་ན་ན་ནི།",
    "བད་ག་གི་དགའ་བ་དེ་ལྟར་འགྱུར་བ་མ་ཡིན་ཞིང་།",
    "གང་གི་རྫུ་འཕྲུལ་འདི་དང་རྣམ་རྒྱས་༢བློ་གྲོས་དང་།",
    "དུ་མ་རྣམས་ཀྱིས་རབ་ཏུ་འབྱུང་ཕྱིར་རེ་འདོད་བྱས།",
    "འཆར་ཀས་ལམ་དེ་ཉིད་ལ་རབ་ཏུ་སོང་བ་སྟེ།",
    "མཆོག་གི་བདུད་རྩི་༢རྒྱུན་ནི་རབ་ཏུ་ཐོབ་བྱས་ནས།",
    "ཞེས་ནི་དོན་ཐོས་ཁང་པ་རྣམས་སུ་མི་མོ་རྣམོ་རྣམས།",
    "བུད་མེད་དེ་རྣམས་མིག་ནས་མཆི་མ་ཕྱུང་བ་སྟེ།",
    "འོག་ཏུ་ཞལ་གཟིགས་གཤེགས་པ་དེ་ནི་མཐོང་གྱུར་ན་ས་། བརྩེ་བ་དང་ནི་གུས་པ་རྣམ་༨པར་སྟོན་པ་སྟེ།",
    "གང་གིས་བསྙེན་པར་འོས་ཤིང་མགྱོགས་འགྲོ་འོས་པ་སྟེ།",
    "དེས་ནི་ས་ཡི་གཉའ་ཤིང་གང་ཙམ་གཟིགས་ཤིང་གཤེགས།",
    "བུ་བྱིས་རྣམས་དང་མོ་བཙུན་མཛངས་མ་རྣམས་དང་ནི་༦།",
    "གང་གིས་༧ཇོ་བོའི་རབ་ཏུ་སྤྱོད་པ་འདི་ཐོས་ཤིང་།",
    "ཡོན་ཏན་དེ་རྣམས་དག་གིས་འདི་ནི་མཛེས་པ་སྟེ།",
    "དམ་པ་རྣམས་དང་སྦྲེལ་མཛོད་རི་མོ་ཁོད་མཛོད་ཅིག།",
    "གང་གི་༢འབྲས་བུ་འདི་ནི་ཞི་བ་སྐྱོང་བ་ནི།",
    "མུན་པ་སྣང་བ་ལ་ནི་གནས་པ་བདག་གི་ལུགི་ལུགས།",
    "དཀར་པོ་དཀར་པོར་མཆོག་ཏུ་འགྲོ་བ་བདག་གི་ལུགི་ལུགས།",
    "བདེ་བར་༢འཕམ་བྱེད་ཀྱིས་ནི་ཕྱག་གིས་མངོན་བསྲུངས་པའི།",
    "སོང་ནས་དེ་ནས་བཀུར་སྟི་བྱས་ཏེ་ཐུབ་པ་ལ།",
    "དེ་ཕྱིར་འདི་དང་ཆེ་གེ་མོར་ནི་མགོན་གྱུར་ཞིང་།",
    "སྐྱེ་བོ་ལེགས་པའི་རྟེན་ལས་གཞན་མིན་བདག་གི་ནགི་ནགས་། ༐ག་དྷ་འི་༡སྲས་པོ་ཐུབ་པ་ཆེན་པོ་རབ་ཐོབ་ནས།",
    "ཁྱོད་ཀྱི་ཉེ་བ་ལས་༢ནི་དོན་གང་ཡིན་པ་རྣམས།",
    "ལེགས་པ་ཁྱོད་ཀྱི་ངེས་པའི་ལྟ་བའི་ལྟ་བ་ལས།",
    "དོན་དང་འདོད་པ་དག་གི་ཆགས་པ་མཁྱེན་ནས་ས་སུ།",
    "ཁྱོད་ཀྱི་སྤྱོད་པ་འདི་ནི་ལེགས་པ་རྣམས་ལ་མིན།",
    "དེས་ན་ཁྱོད་ལ་འདིར་ནི་ཅུང་ཟད་སྨྲ་འདོད་ད་དེ།",
    "དེ་ནི་༩ཤེས་པར་གྱིས་ཤིག་བདག་གི་ལྟ་བ་ནི།",
    "ཁྱོད་ལ་དཔེར་བསྟན་ཞི་བ་བདག་གིས་དེ་སྨྲས་ཏེ།",
    "གང་གིས་འབྲས་བུ་ལེགས་མིན་གང་དེ་བྱ་བ་མིན།",
    "སྣ་ཚོགས་རྟེན་གྱི་སྡུག་བསྔལ་དག་གི་རྩ་བ་སྟེ།་།",
    "ནགས་སམ་ཁྱིམ་ན་གནས་པ་དག་གི་ཞི་བ་ནི།",
    "གང་གིས་སྒྲུབ་པ་ཡོད་པ་དེ་ཡིས་༦ཡོད་པའོ།",
    "གང་གིས་ཡོད་པ་དེ་ནི་དེ་ལ་སྒྲོལ་བ་ཡོད།",
    "དེ་ལྟར་ཡུལ་ལ་མཆོག་ཏུ་སོང་བའི་རྒྱལ་པོ་དེ་ཡིས་ནི།",
    "དྲང་སྲོང་གིས་ནི་རྫུ་འཕྲུལ་ཆེད་དུ་སྡུག་པས་གནས་པ་བྱས།",
    "བཀུར་སྟི་ངེས་པ་མཆོག་གི་ད་པལ་གྱིས་ཡོངས་སུ་སྤངས་པར་གྱུར།",
    "ཡོན་ཏན་གཟིགས་པས་མི་སྐྱོང་ནི་༨།",
    "འཚོ་བྱེད་ཨ་མྲའི་ནགས་ཚལ་དུ།",
    "བྲམ་ཟེ་ཞི་བར་འགྲོ་རྣམས་དེས་། རྡོ་བའི་རི་བོར་ཕྲ་མོ་ཡི།",
    "དངོས་སུ་ནོར་སྦྱིན་མཐོང་བ་མོ།",
    "བཙུད་ཕྱེད་རྩེ་མོ་ཉིད་དང་ནི།",
    "ག་ཡར་དྲང་སྲོང་གིས་བསྟན་ཏོ།",
    "དྲང་སྲོང་མཆོག་གི་གཙུག་ལག་ཁང་།",
    "རྟག་པར་དྲི་ལྡན་ཁ་ལ་རེག།",
    "ཉོན་མོངས་དུལ་བར་དེ་བཞིན་ན་ནོ།",
    "བུའི་བུ་མོས་འཇུག་བུ་དག་དང་།",
    "བསྟན་པ་མཆོག་གིས་བསྟན་པའོ།",
    "བུད་མེད་སྒུར་མཆོག་སོགས་རྣམས་དང་།",
    "ཁྲག་གིས་གཤེར་བའི་མགོ་བོ་སྣ་ལྗགས་དྲག་པོ་ཡིས།",
    "གསུམ་དུ་རབ་དགའི་ཆང་གིས་འཐོར་མའི་དྲི་ལྡན་ཞིང་།",
    "རུལ་བའི་ཁྲག་ད་ང་ཞག་གི་དྲི་ཡིས་བསྒོས་རྣམས་ཀྱིས།",
    "རང་གི་སྲོག་ལ་ཐེ་ཚོམ་ཡང་དག་མ་བསམས་ཤིང་།",
    "ལང་ཚོ་མ་རྣམས་ལག་པ་གཡོ་ཞིང་ངུ་བ་སྟེ།",
    "པོའི་གླང་༡པོ་ཆེས་ཀྱང་རེག་པ་རུ།",
    "ཐུབ་པས་རྣ་བའི་ཏ་༥ལ་གཡོ་མེད་ལ་གཟིགས་ཤིང་།",
    "ཆང་ནི་སྤངས་ཤིང་ཡང་དག་རིག་པར་སོང་བ་སྟེ།",
    "ནང་དུ་སོང་བའི་བདེ་བ་དམ་པ་ཐོབ་པར་གྱུར།",
    "ལྡིང་ཁང་ལ་གནས་བུད་མེད་གཞན་རྣམས་དེ་ལ་ནི།",
    "སྐྱེ་བོ་དད་པ་མེད་པ་དབུས་ནས་སོང་བ་སྟེ།",
    "དབུས་གནས་༧ཁྱད་པར་ལས་ནི་དང་བར་རབ་སོང་ཞིང་།",
    "དད་པ་རྣམས་ཀྱང་གང་དེ་བསྟན་༨པར་ཉེ་བར་སོང་།",
    "ཉོན་མོངས་རྩོད་ལྡན་དུས་ནི་ངེས་པར་ལོག་པ་ན།",
    "མི་སྐྱོང་སྟེ་ན་རྒུ་བ་གཉིས་སྐྱེས་དྲང་སྲོང་གི།",
    "ལྷ་རྣམས་ཀྱིས་དེར་རང་གི་ནོར།",
    "ཉེ་བར་ལེན་པ་རབ་གཟིགས་ནས།",
    "ཇི་ལྟར་རྙེད་གྲུ་དེ་དང་དེས་། སྐྱེ་བོ་རྣམས་ནི་སྒྲོལ་བ་གཟིགས།",
    "དེ་རྣམས་གཟིགས་ནས་ཐུགས་མཛད་ད་དོ།",
    "བད་ག་གི་གྲུ་མེད་རབ་ཏུ་འགྲོ།",
    "སྐད་ཅིག་གིས་ནི་ཕ་རོལ་གྱུར་༡༧།",
    "དེར་ནི་མཚན་མོ་གཅིག་ཕུལ་ནས་༨།",
    "དེ་ནས་ཨ་མྲ་སྐྱོང་བའི་༩ས།",
    "ཨ་མྲ་སྐྱོང་མ་རེས་༡༡མའི་གཙོ།",
    "མཆོག་ཏུ་དགའ་བས་རབ་ཏུ་སོང་།",
    "ཕྲ་བའི་གོས་དཀར་འཛིན་པ་མོ།",
    "རིགས་ཀྱི་མོ་བཙུན་གདུང་བ་མོ།",
    "ཨ་མྲ་སྐྱོང་མ་འདི་མངོན་༢འོངས།",
