    "བདག་གིས་མ་མཐོང་བར་དེ་ནུབ་པར་འགྲོ་མ་ཡིན།",
    "དུས་མ་ཡིན་ཞེས་མཆི་མའི་གདོང་གིས་སྨྲས་པའོ།",
    "ད་པལ་སྟུག་༧དགེ་ལེགས་མཛོད་ལ་མངོན་དུ་སོང་བ་སྟེ།",
    "བསིལ་བའི་ཆུ་ནི་ཚན་༧མོ་བཞིན་དུ་རིམ་གྱིས་ནི།",
    "འཇིག་རྟེན་དག་གི་ནུབ་པར་འགྲོ་བ་ཤེས་ནས་ས་སུ།",
    "སྔོན་དུ་རེ་ཞིག་བད་ག་ནི་མཐར་ཐུག་ལ་འགྲོའོ།",
    "ཕྲ་མོའི་༥ཕྲ་མོར་བྱེད་པ་བཞིན།",
    "དེ་ནས་དེ་ཕྱིར་གདུང་གི་འདུ་བྱེད་ཆོ་ག་ནི།",
    "རང་གི་གཡོ་བའི་སེམས་ལས་འཇིགས་པ་ཇི་ལྟ་བར།",
    "གང་གིས་༢སྦྲང་རྩི་དང་ནི་ཡང་དག་རྟོག་པ་མེད།",
    "རྣལ་འབྱོར་རིམ་ལས་ཉིན་མོ་མཐའ་དག་ཕུལ་ནས་དང་།",
    "མཚན་མོའི་དང་པོའི་ཐུན་དང་ཅིག་ཤོས་དག་ཀྱང་སྟེ།",
    "མཚན་མོ་མཐའ་དག་ལ་ནི་གཉིད་པར་འོས་པ་སུ།",
    "ཉོན་མོངས་དགྲ་བོ་དང་མཚུང་ས་འཇོམས་པ་པོ་རྣམས་ནི།",
    "ངོ་ཚ་རྒྱན་ཉིད་དང་ནི་མཆོག་གི་གོས་ཡིན་ཞིང་།",
    "ངོ་ཚ་ལམ་ལས་འཁྱོག་༢པ་རྣམས་ཀྱི་ལྕགས་ཀྱུས་ཏེ།",
    "གང་གི་བཟོད་པ་དེ་ཡིས་༡༡སྟོབས་དང་བརྟན་པ་སྟེ།",
    "གང་རྣམས་ཕ་རོལ་རྣམས་ལས་རྩུབ་མོ་མི་བཟོད་པ།",
    "ཡོངས་སུ་བསིལ་བའི་ཆུ་ལས་ཀློག་གི་མེ་བཞིན་དུ།",
    "མཛེས་པའི་སྐྲ་ནི་རྒྱང་རིང་མགོ་ལ་རེག་ནས་དང་།",
    "སློང་མོ་ཟ་བས་བདག་ཉིད་ཡོངས་སུ་རྟོག་༤པ་པ་པོ།",
    "གང་ཕྱིར་འདི་ལས་འཁྱོག་པོ་ཉིད་ནི་བསྙེན་མི་བྱ།",
    "བརྒྱ་བྱིན་ལ་སོགས་ལྷ་རྣམས་ཀྱིས་ཀྱང་རེ་འདོད་བྱེད།",
    "རང་གི་སྐྱེ་བོ་ལ་འམ་སྐྱེ་ལ་ཆགས་པ་སྤངས།",
    "དེ་ཕྱིར་ལུས་ལ་སོང་བའི་དྲན་པ་སྤང་མི་བྱ།",
    "འཇིག་རྟེན་དག་གི་སྐྱེ་དང་འགོད་༡པ་ཤེས་པ་སྟེ།",
    "ཉོན་མོངས་ལྗོན་ཤིང་འཇོམས་བྱེད་མཚོན་ཆ་རྣོན་པོ་ཡིན།",
    "གང་གི་༢ཤེས་རབ་རང་བཞིན་ལྟ་བྱེད་མིག་ཡོད་པ།",
    "དེ་ནི་བད་ག་གིས་བྱས་ཤིང་དང་ནི་རབ་བསྡམས་པ།",
    "བསྟན་པ་རྣམས་ལ་འདི་ནི་གང་གི་༡འདོད་པ་ཡོད།",
    "གློག་གི་འོད་ཀྱིས་༡ལམ་བཞིན་ཡང་དག་མཐོང་བར་གྱུར།",
    "གང་གི་དོན་གྱི་ལྷག་མ་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "གང་རྣམས་མཁར་དང་ས་ན་བད་ག་གི་གདུལ་བྱ་རྣམས།",
    "ཁྱེད་ཅག་མ་སྨྲ་འདི་ནི་བདག་གི་ཕྱི་མའི་ཚིཚིག།",
    "དེ་ནས་བསམ་གཏན་རིག་པ་རྣམས་ཀྱི་མཆོག་གིས་ནི།",
    "འཛིན་པ་འཛིན་པ་རྣམས་ཀྱི་རྩེ་མོ་རྣམས་ལྷུང་ཞིང་༨།",
    "རང་གིས་༤མེ་ཏོག་མཛེས་པ་འཇུག་པ་དུས་མིན་ལ།",
    "ནང་དུ་སོང་བའི་ཀུན་ནས་གདུང་བ་རྣམས།",
    "རང་གནས་གྱུར་ཞིང་རྣམ་པར་འགྱུར་བ་མ་སོང་སྟེ།",
    "དེ་ནས་རྡོ་རྗེ་རྩེ་མོ་བཅོམ་པའི་རི་བོ་བོ་བཞིན།",
    "ནོག་གིས་རྣམ་པར་ད་མན་པའི་དབྱིབས་ཅན་ཁྱུ་མཆོག་བཞིན།",
    "ཉིན་མོར་བྱེད་པས་རབ་ཏུ་ད་མན་པའི་ན་མ་མཁའ་བཞིན།",
    "བ་མོས་བསྲེགས་པའི་པདྨ་དང་ལྡན་རྫིང་བུ་བཞིན།",
    "ལྷ་ན་གནས་པ་ཆེན་པོ་གཞན་ཞིག་གིས་སྨྲས་པའོ་༢།",
    "དེ་ནས་མཆོག་གི་དྲང་སྲོང་དང་མཚུངས་དྲང་སྲོང་གཞན།",
    "དེ་ལྟར་འགྲོ་བ་མེད་ཅིང་སོང་བ་མེད་པ་སྟེ།",
    "ཤེས་རབ་རྣམ་པར་དག་ཅིང་མཆོག་གི་སྤྱན་མངའ་བ།",
    "ཐུན་མོང་ལས་ནི་གང་དུ་དེ་བཞིན་གཤེག་ས་པ་ཡང་།",
    "ཕུང་པོ་གསུམ་དང་བདག་ཉིད་གཅིག་ལ་ཉོན་མོངས་ཀྱི་༩།",
    "མགྱོགས་འགྲོ་རྟ་བཞིན་དུ་ནི་རྣམ་རྒྱལ་ལམ་སོང་བ།",
    "གང་ཞིག་འོད་ཟེར་མཆོག་གིས་༡༧རྣམ་པར་གསལ་བ་དང་།",
    "ཁྱད་པར་འཕགས་པའི་བློ་ཡིས་རྣམ་པར་གསལ་བར་གྱུར་། གང་གིས་སྐྱེ་དགུ་རྣམས་ནི་དགེ་ལེགས་ལ་བཅུག་སྟེ།",
    "གང་གིས་མཁྱེན་ཞིང་སྨོད་པས་འོ་དོད་མ་བོས་ཤིང་།",
    "གང་གིས་སྔར་མ་བྱིན་པའི་སྦྱིན་པ་༐",
    "ཁྱབ་བདག་ཡེ་ཤེས་ནོར་ཅན་དེ་ཡང་སྲོག་སོང་ང་ངོ།",
    "གསུམ་གཟིགས་སྤྱོད་པ་གསུམ་ནི་ཟད་བྱེད་སྤྱན་གསུམ་པ།",
    "གང་གི་༡ཞི་བའི་ཆེད་དུ་ལམ་ནི་གསལ་མཛད་ད་དེ།",
    "ཉོན་མོངས་ལྗོན་ཤིང་རབ་ཏུ་ཆ་གས་པ་བ་ཅད་པ་སྟེ།",
    "གསུང་གི་བདུད་རྩིས་འཇིག་རྟེན་ཤིན་ཏུ་ཚིམ་མཛད་ཅི་ང་།",
    "དགེ་ལེགས་དོན་དུ་གཉེར་རྣམས་ཕྲ་མོ་རྟོགས་སུ་བཅུག།",
    "སྨད་ཀྱང་རང་གི་ཐུགས་ནི་བསྐྱོད་པ་མ་ཡིན་ཞིང་།",
    "འཇིག་རྟེན་དག་གི་ལྟ་བྱེད་བཅོམ་ནས་འཇིག་རྟེན་གྱི་༡། ལྟ་བྱེད་ཉེ་བར་ཕྲོགས་༢ནས་འགྲོས་སུ་འདི་གཤེགས་ས་སོ།",
    "གང་གིས་༢མཆོག་ཏུ་ཞི་བའི་ལམ་ནི་བརྙེས་༤པ་སྟེ།",
    "གང་གིས་སྐྱེ་བ་དུ་མ་རྣམས་ཀྱང་དྲན་པ་སྟེ།",
    "ཡེ་ཤེས་ཀྱིས་ནི་ཉོན་མོངས་ཐམས་ཅད་རྣམ་༢སྤངས་ནས།",
    "ཤེས་པ་མེད་པར་གཞོལ་བའི་འཇིག་རྟེན་དག་གི་ནི།",
    "ཇི་ལྟར་ཉིན་མོར་བྱེད་པ་འོད་ཟེར་མེད་པ་དང་།"
  ]
}