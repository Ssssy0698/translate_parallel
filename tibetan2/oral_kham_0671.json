    "གཉིད་ལོག་དུས་ན་བདེ་སྡུག་ཀྱང་།",
    "སྐུ་གསུམ་མ་སྤང་རང་ལ་གནས།",
    "ཅི་ལྟར་བྱས་ཀྱང་རང་ཤར་རང་གྲོལ་གྱི་དབྱིངས་ལ་ཡུལ་དང་ཡུལ་ཅན་དུ་གྲུབ་པ་མེད་དེ།",
    "དཔེར་ན་རྫ་འབའ་ཞིག་འདུག་པ་ལ་རྫ་ཀླུང་ཟེར།",
    "ཆུ་འབའ་ཞིག་འདུག་པ་ལ་ཆུ་ཀླུང་ཟེར།",
    "བྱེ་མ་འབའ་ཞིག་འདུག་པ་ལ་བྱེ་ཀླུང་ཟེར་བའམ།",
    "གསེར་འབའ་ཞིག་འདུག་པ་ལ་གསེར་གླིང་ཟེར་བ་ལྟར།",
    "གཞན་གྱི་སྐྱོན་ཞུགས་པ་ཅུང་ཟད་ཀྱང་མེད་པས་ན་གོལ་ས་དང་རང་ས་དབྱེར་མེད་པའོ།",
    "བོགས་ཤུགས་ལས་བྱུང་ནའང་རང་མ་བྱུང་ནའང་རང་།",
    "མ་བསྒོམས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ཀྱི་ཀློང་།",
    "འདུག་ན་བོན་ཉིད།",
    "དེའི་ཚེ་དེ་མ་ཡིན་པ་དང་གཉིས་ཀ་དང་གཉིས་མེད་གང་ཡང་ཤར་ལ་གང་ཤར་ཡང་རང་བྱུང་ཡེ་ཤེས་ཡེ་གྲོལ་དག་པ་ཆེན་པོ་ལས་མ་གཡོས་སོ།",
    "དེ་དག་རང་སྣང་རང་རྩལ་རང་དུ་ཐག་ཆད་གདེང་ཐོབ་པའི་སྤྱོད་པ་ཡིན་གྱི།",
    "སྤང་བྱ་སྤང་བྱེད་གཉིས་ཀ་རང་ཤར་བས་མ་སྤང་རང་གྲོལ་ཡིན་ནོ།",
    "ཅི་ལྟར་ཡིན་ཡང་རང་ཤར་རང་གྲོལ་ལས་མ་འདས་པས་མཐར་ལྷུང་བའི་དོགས་པ་མེད་དོ།",
    "ངང་རང་བཞིན་བདག་ཉིད་གསུམ་གྱི་གཏན་ཚིགས་ཀྱིས།",
    "སྔ་འཕྱི་ཐོག་མཐའ་མེད་པར་རྟོགས་རུང་མ་རྟོགས་རུང་འཁོར་འདས་ཀྱི་བོན་ཐམས་ཅད་གྲོལ་ནས་འདུག་པས།",
    "སྲིན་པོ་འབར་བ་རང་མཐོང་ཡང་རང་སྣང་ལས་མི་གཞན་པར་ཐག་ཆོད་ནས།",
    "ཇི་ལྟར་བྱས་ཀྱང་རང་ཤར་རང་གྲོལ་གྱི་ཀློང་ལས་མ་འདས་པས་གོལ་ས་དང་ལྟུང་ས་མེད་དོ།",
    "ཐོད་རྒལ་གྱིས་གཟུགས་ཕུང་རང་སྣང་རང་འོད་དུ་ལྷག་ནས་ཕུང་གཞན་རང་སར་དག་སྟེ།",
    "ཡུལ་སྣང་རང་སྣང་འོད་གསལ་དུ་མ་གྲོལ་ཏེ།",
    "རང་ལས་འབྱུང་ཞིང་རང་ལ་སྣང་།",
    "རྐེད་པ་བསྲང་ལ་ཙོག་འདུག་བྱ་སྟེ།",
    "རྐང་མཐིལ་ས་ལ་ཕབ་པའི་འདུག་སྟངས་འདི་ནི་གཞན་ལུགས་ནས་ཀྱང་བཀག་པར་མ་ཟད།",
    "གཞན་ལུགས་སུ་འདུག་པས་དོར་ཞིག།",
    "རྐང་མཐིལ་གཉིས་ས་ལ་གཏད་དེ་ཙོག་བུར་འདུག་ལ།",
    "པུས་བྲང་སྤྲད་ལ་ཙོག་བུར་འདུག་ཅིང་ལག་པ་གཉིས་སྐྱིད་པའི་ཕྱི་ནས་ནང་དུ་དྲངས་ལ།",
    "བོན་སྐུ་སེང་གེའི་འདུག་སྟངས་དང་།",
    "ལོངས་སྐུ་གླང་པོ་ཆེའི་འདུག་སྟངས།",
    "ལུས་འདུག་སྟངས་ཀྱིས་མ་གཅུན་ན་ལུས་ཀྱི་རྩ་འདབ་ན་ཡེ་ཤེས་ཀྱི་རང་གདངས་ཡོད་པ་མི་སློང་ལ།",
    "ཐ་མལ་བ་ལྟར་འདུག་པས་ཡེ་ཤེས་དངོས་སུ་འཆར་མི་སྲིད་ལ།",
    "ཤར་དུས་ཐ་མལ་དུ་འདུག་ན་མི་འཕེལ་བའི་སྟེང་དུ་སླར་འགྲིབ་པར་འགྱུར་རོ།",
