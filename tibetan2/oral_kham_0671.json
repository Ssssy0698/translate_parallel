    "དེ་ནས་ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་མཛོད།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་དུ་ཞུགས་པས་སྤྲོ་བའི་ཚུལ་གྱིས་ཆེད་དུ་བརྗོད་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་ནས་མིག་དར་གྱི་འོག་ནས་དཀྱིལ་འཁོར་ཉྙོགྱི་ཐད་ཀྱི་བར་སྣང་ལ་ལྟོས་ལ་ཁ་དོག་ཇི་ལྟར་འདུག་པ་སྨོས་ཤིག་ཅེས་སྣང་བ་བརྟག་དཀར་པོར་འདུག་ན་ཞི་བ་སོགས་ལས་སོ་སོ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་ལ་ལྟ་བཞིན་དུ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཕྱག་ན་རྡོ་རྗེའི་ཕྱག་ན་འདུག།",
    "ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཐབས་སམ་ཤེས་རབ་དང་།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་མཛོད།",
    "འོ་ན་སྐུ་འདི་བདེན་པར་འདུག་གམ།",
    "འོ་ན་སྐུ་འདི་མི་བདེན་པར་འདུག་གམ།",
    "ལག་པ་འདི་ལ་སྒྲ་འདུག་གམ་མི་འདུག་གསུམ།",
    "མི་འདུག་ན་འདི་ཅི་ཡིན།",
    "གཉན་འོད་སྲུང་མགོན་པོས་ངག་སྣ་བསྲིངས་ནས་རྔོག་པའི་གསུང་སྒྲོས་ཅི་རིགས་པ་བསྲེས་འདུག་ནའང་།",
    "བརྒྱུད་ཁུངས་བཟང་ཞིང་བརྒྱུད་ཐག་ཉེ་ལ་བརྒྱུད་པ་མ་ཆད་པ་རྩོད་མེད་དུ་འདུག་པས།",
    "འདི་ནི་གྲུབ་པའི་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ན་རཀྵི་ཏ་སྟེ་རྣམ་སྣང་སྲུང་བ་ཞེས་གྲགས་པ་དེ་ཉིད་། ཀྱིས།",
    "མལ་སྟན་འདུག་དང་སྔོན་འགྲོ་དང་།",
    "ཉལ་དང་འདུག་པར་མི་བྱའོ།",
    "གུས་པ་ཡིས་ནི་འདུག་པར་བྱ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་། གོས་སོགས་ཚུལ་ནི་བསྡོམས་པ་དང་།",
    "དེ་ལྟར་མཛད་པས་གཉིད་སད་ཙམ་ན་རྒྱ་མཚོའི་ཕར་འགྲམ་ན་བསྐྱལ་ནས་བླའདུག་སྟེ།",
    "སྟང་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "དང་པོ་ནི་རབ་ཏུ་དྭང་བས་བཏུད་དེ་སྟན་ལས་ལྡང་བ་དང་གུས་པ་ཡི་ནི་ཚུལ་དང་བཅས་པས་འདུག་པར་བྱའོ་ཞེས་སྤྱིར་བཏང་ནས།",
    "དེ་ལྟར་མ་བྱེད་པར་འདུག་ཅིག་ཅེས་བཟློག་པར་བྱ་སྟེ།",
    "བདེན་ན་ཁྱེད་རང་ཉིད་ཀྱིས་མ་ཤེས་ཏེ།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བསམ་ཙ་ན་ཞེས་སོགས་སོ།",
    "ཐོས་བསམ་ལ་མེད་ཐབས་མི་གདའ་སྟེ།",
    "དེ་གང་ན་འདུག་ཀྱང་ཐེ་ལེ་ལེ།",
    "འགྱུར་བའི་སྡུག་བསྔལ་བསམས་ཙ་ན།",
    "མི་ཕྱུག་པོ་སྤྲང་པོར་འགྲོ་ཡིན་འདུག།",
    "ཁ་དྲག་པོ་ཞན་པོར་འགྲོ་ཡིན་འདུག།",
    "མི་མང་པོ་གཅིག་ཏུ་འགྲོ་ཡིན་འདུག།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བསམས་ཙ་ན།",
    "དེ་ལྟར་ཚེ་འདི་ལ་ཞེན་པ་ལ་ཉེས་པ་དེ་ལྟར་འདུག་ཀྱང་།",
    "ཁམས་གསུམ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས་མ་འདས་པར་འདུག་པས།",
    "དེ་ལ་ཤེས་རབ་དགོས་པས་རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱི་སྒྲུབ་པ་གྱིས་གསུངས་ནས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་ལུང་གནང་ཞིང་།",
    "བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པ།",
    "ཆུའི་རྒྱལ་ཁམས་ཆེན་པོ་འདུག་སྙམ་ནས་ཕྱིན་པ་དང་།",
    "དེའང་རང་དོན་མ་རྫོགས་ཤིང་གཞན་དོན་རྒྱ་ཆེན་པོ་མི་ནུས་ལ།",
    "སྒྲའི་ཀླག་ཅོར་སོགས་བསམ་གཏན་གྱི་ཚེར་མ་མེད་པར་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "བདག་ཇི་ལྟར་འདུག་ཀྱང་ཞེས་པ་ནས།",
    "གནས་པ་དང་པོ་རི་གཟར་གྱིས་འབབ་ཆུ་ལྟ་བུ་རྣམ་རྟོག་གཅིག་རྗེས་ལ་གཅིག་རྒྱུན་མི་ཆད་པས་སྒོམ་ཆེན་བློ་ཆུང་དག་སྒོམ་མི་སྐྱེ་བར་འདུག་སྙམ་ཞིང་སྐྱིད་ལུག་པ་འབྱུང་སྟེ།",
    "བདེན་པར་གྲུབ་པ་སྐད་ཅིག་ཀྱང་མི་འདུག་སྙམ་དུ་ཐག་རྦད་ཀྱིས་བཅད་དེ།",
    "དེ་ལྟར་འབད་པས་ཕྱི་རོལ་ཡུལ་སྣང་འདི་དག་སེམས་ཀྱི་འཁྲུལ་འཁོར་ཙམ་ལས་ཕྱི་རོལ་ན་བདེན་པར་མི་འདུག་སྙམ་པའི་དོན་ལ་ཡིད་ཆེས་ཀྱི་གསལ་སྣང་ཅུང་ཟད་ཐོན་པ་འབྱུང་སྟེ་རྒྱན་ལས།",
    "དེ་ལྟར་བདག་མ་བུ་གཉིས་ཚེ་རབས་གྲངས་མེད་པར་མ་མང་དུ་བགྱིས་ཀྱང་སྐྱེ་འཆི་འཕོས་པས་ཁོ་རང་མ་ཡིན་པར་མ་ཤེས།",
    "འགྲོ་དང་འདུག་དང་ཉལ་དང་ཟ།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་འདུག་སྟངས་དང་།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སྐད་ཅིག་དང་པོ་ལ་སྣང་བའི་ཡེ་ཤེས་མངོན་དུ་གྱུར་ཅིང་རང་བཞིན་སུམ་ཅུ་རྩ་གསུམ་འགག་སྐད་ཅིག་གཉིས་པ་ལ་སྣང་བ་མཆེད་པའི་ཡེ་ཤེས་འཆར།",
    "གནས་དབེན་པར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ལྟར་མཉམ་བཞག་སྒྱུ་མ་ལ་བརྟེན་པ་ཐོབ་ཅིང་རང་ས་ཟིན་པར་བྱས་ནས།",
    "བླང་དོར་དུ་འདུན་པ་འདུག་ན་གཉེན་པོས་ཚར་གཅད་དོ།",
    "དེས་བསྟོད་སྨད་དུ་མ་བྱེད་དུ་གཞུག་དགའ་མི་དགའི་བླང་དོར་འདུག་མི་འདུག་བལྟས་ལ།",
    "བསྒོམས་པས་བླང་དོར་དུ་འདུག་པའི་ཡུལ་བརྫུན་པ།",
    "ཁྱད་པར་འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས་སྤྱོད་ལམ་ཅི་བྱེད་ཀྱང་རྨི་ལམ་རྨི་བ་ཡིན་པར་འདུག་འགྲོ་བ་འདི་རྨི་ལམ་མ་ཡིན་པར་འདུག་འཆག་པ་རྨི་ལམ་ཡིན་པར་འདུག་སྙམ་པ་ལ་སོགས་པའི་དྲན་འདུན་ཐུར་ཐུར་བ་རྒྱུན་ཆགས་སུ་བྱའོ།",
    "མདང་སྲིད་གུང་ལ་རྨི་ལམ་འདི་དང་འདི་ལྟ་བུ་རྨིས་ཀྱང་བཅོ་ལྔ་རྨི་ལམ་དུ་ངོ་མ་ཤེས་པར་འདུག་སྙམ་དུ་ཕྱི་བལྟས་བྱ་ཞིང་སྒྱུ་མར་བསྒོམ།",
    "སྨིན་མཚམས་སུ་ཐིག་ལེ་དམར་པོ་ཙ་ན་ཀའི་འབྲུ་ཚད་ཙམ་ལ་སེམས་གཏད་དེ་ཅི་ནས་ཀྱང་རྨི་ལམ་ལ་རྨི་ལམ་དུ་ངོ་ཤེས་པར་བྱའོ།",
    "རྨི་ལམ་ལྟ་བུར་ངོ་མ་ཤེས་པར་འདུག་ད་ནི་རྨི་ལམ་དུ་ངོ་ཤེས་པར་བྱ་སྙམ་པའི་འདུན་པ་གཏང་།",
    "ཕྱི་དྲོའི་དུས་ནས་ང་རྨི་ལམ་རྨི་ཡིན་འདུག་འདི་རྨི་ལམ་ཡིན་པར་འདུག་སྙམ་པའི་དྲན་པ་རྒྱུན་ཆགས་དྲག་ཏུ་གཟུང་།",
    "དབུགས་འཇམ་ལ་བདེ་སྡུར་པ་ལ་སོགས་མེད་ཅིང་བྱད་ཀྱི་ཤ་མ་ཞིག་པར་འདུག་ན་ཟིན་པའི་རྟགས་དེ་ལས་ལྡོག་ན་མ་ཟིན་པར་ཤེས་པར་བྱས་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སོགས།",
    "ཁྱེད་རང་རྣམས་སྔོན་ཆད་དཔལ་ཆེན་པོ་ཀརྨ་ཧེ་རུ་ཀའི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པའམ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་ནམ་མཁའི་ཁ་དོག་ལ་བརྟེན་ནས་དངོས་གྲུབ་ཀྱི་ལྟས་བརྟགས་དགོས་པས།",
    "རིགས་བརྟག་པའི་ཕྱིར་དུ་མེ་ཏོག་འབུལ་བ་ལ་ཁྱེད་རང་རྣམས་གྲལ་རིམ་བཞིན་བཞེངས་ནས།",
