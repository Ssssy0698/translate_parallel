    "མཚན་འདི་ཉན་པས་སྒྲ་དབྱངས་ཐམས་ཅད་ཀྱི་སྨྲ་བ་དང་ལྡན་པར་འགྱུར།",
    "མི་ལྡོག་པ་གང་ལགས་ཞུས་པའི་ལན་དུ་བཀའ་སྩལ་པ།",
    "འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་མཆོག་རབ་དམ་པར་འདོད་པས།",
    "དེ་བཞིན་གཤེགས་པ་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གྱུར་པའི་མཚན་ཉན་པར་བྱ།",
    "མཚན་འདི་ཐོས་ན་ཕྱིར་མི་ལྡོག་ཅིང་སྐྱེ་བོ་ཐམས་ཅད་ལ་སྡུག་པ་དང་འདུ་བ་དང་ཚིག་འཛིན་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ལེགས་པར་འཇུག་པ་ཞེས་བྱ་བ་ན།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཚངས་པར་སྤྱོད་པས་བརྒྱན་པ་ན།",
    "བདུན་ཐོབ་པར་འགྱུར་རོ།",
    "ཤིན་ཏུ་རྣམ་པར་ཕྱེ་བའི་འཇིག་རྟེན་གྱི་ཁམས་ན།",
    "ནུབ་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་ཡུལ་ཕེབས་པ་ཞེས་བྱ་བ་ན།",
    "དེ་དག་སྔོན་གྱི་རྒྱལ་བ་ལ་བྱ་བ་བྱས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་འཛིན་པ་དེ་དག་འཇིགས་པ་དང་གཤིས་ངན་དུ་འཆི་བ་དང་ཆོམ་རྐུན་དུག་དང་ཆུ་དང་མཚོན་གྱིས་མི་འཇིགས་པར་ཡིད་ཆེས་སོ།",
    "ཤར་ཕྱོགས་འཇིག་རྟེན་གྱི་ཁམས་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཚོགས་ཞེས་བྱ་བ་ན།",
    "འཇིག་རྟེན་པའི་བྱ་བ་རྩོམ་ན་འཕེལ་བ་ཉིད་དུ་འགྱུར་གྱི་འགྲིབ་པར་མི་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་མཚན་འབུམ།",
    "སྲོད་ལ་ཉལ་ན་དང་ལྡང་བ་ནའང་བསམ་པར་བྱ།",
    "འཇིག་རྟེན་གྱི་བྱ་བ་གང་ཅི་ཡང་རུང་བརྩོམ་པ་ནའང་མཚན་འདི་དག་བསམས་ནས་དེའི་འོག་ཏུ་བརྩམས་ན་དེར་ཡང་ཁྱེད་ལ་འཕེལ་བ་ཉིད་དུ་འགྱུར་གྱི་འགྲིབ་པ་ནི་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "ཟིལ་གྱིས་མི་ནོན་པ་དང་ཞི་བ་དང་ཡོངས་སུ་གདུང་ཁ་མེད་པ་དང་འཇིགས་པ་མེད་པར་ཡོངས་སུ་བརྗོད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤི་འཕོས་ནས་ཀྱང་སྒྲིབ་པ་མེད་པའི་གཟུངས་ཞེས་བྱ་བ་འཐོབ་པར་འགྱུར་རོ།",
    "འདིའི་མཚན་བཟུང་ན་ཤི་འཕོས་ནས་ཉི་མའི་དཀྱིལ་འཁོར་འོད་ཀྱིས་མཐའ་ཀླས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་འཐོབ་པར་འགྱུར།",
    "ཤི་འཕོས་ནས་ཀྱང་མཚན་སུམ་ཅུ་རྩ་གཉིས་འཐོབ་པར་འགྱུར་རོ།",
    "ཤི་འཕོས་ནས་ཤུགས་བརྒྱ་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་འཐོབ་པར་འགྱུར་རོ།",
    "མངལ་དུ་མི་སྐྱེ་ཞིང་གཟུངས་རྣམས་ཐོབ་པར་འགྱུར་རོ།",
    "མི་ཟད་པའི་ཟ་མ་ཏོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་འཐོབ་པར་འགྱུར་རོ།",
    "དེའི་མཚན་བཟུང་ན་ཤི་འཕོས་ནས་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཐོབ་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་དུ་མདངས་ལྟ་བུ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཐོབ་པར་འགྱུར་ཞིང་།",
    "པའི་སྤོབས་པ་ཕུན་སུམ་ཚོགས་པ་འཐོབ་པར་འགྱུར་རོ།",
    "རྣམ་པར་གྲོལ་བ་དང་།",
    "རྣམ་གྲོལ་ཡེ་ཤེས་མཐོང་བའི་ཕུང་པོ་དཔག་ཏུ་མེད་པ་ཡོངས་སུ་དག་པར་བྱེད་དོ།",
    "ས་ནས་ས་ཐོབ་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་མཆོག་ཐོབ་པར་འགྱུར་རོ།",
    "གཉེན་གྱི་སྟོབས་དང་རྒྱལ་སྲིད་དང་སྤོབས་པ་མི་བུལ་བ་ཐོབ་པར་འགྱུར་རོ།",
    "བྱང་སེམས་རྡུལ་མེད་རྣམ་གནོན་དེའི་མཚན་འཛིན་པར་བྱེད་པ་དེ་དག་སྲིད་པར་སྐྱེས་བ་ན་ཚེ་རབས་དྲན་པ་དང་།",
    "དེ་དག་སྲིད་པར་སྐྱེས་པ་ན་ཚེ་རབས་དྲན་པ་དང་།",
    "ཏིང་འཛིན་དེ་དག་ལས་ཀྱང་རྣམ་པར་མི་ཉམས་པ་དང་།",
    "ཤར་ཕྱོགས་འཇིག་རྟེན་གྱི་ཁམས་རྣམ་པར་བཀྲ་བ་ཞེས་བྱ་བ་ན།",
    "མཚན་དང་ལྡན་པར་མི་སྤྲོ་བ་དེ་ལྟ་བུའི་ཚིག་དང་མཚན་འབུམ།",
    "མ་ཐོས་ཤིང་ལུང་མ་ཕོག་པར་བྱེ་བ་ཁྲག་ཁྲིག་གྲངས་མེད་པར་སྤྲོ་བར་མི་འགྱུར་བ་དེ་ལྟ་བུའི་ཚིག་དང་སྤོབས་པ་མི་བཟློག་པར་འགྱུར་རོ།",
    "དེའི་མཚན་བཟུང་བས་སྲིད་པར་ཚེ་རབས་དྲན་པ་དང་།",
    "སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་ལུས་ལེགས་པར་བརྒྱན་པར་འགྱུར་བ་དང་།",
    "ནུབ་ཕྱོགས་འཇིག་རྟེན་གྱི་ཁམས་ལེགས་པར་རྣམ་པར་ཕྱེ་བ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བ་ན།",
    "ཤི་འཕོས་ནས་སྐྱེས་པའི་དངོས་པོ་འཐོབ་པར་འགྱུར་རོ།",
    "མཚན་འདི་འཛིན་པ་དེ་དག་མིར་གྱུར་པ་ལེགས་པར་རྙེད་པ་དང་།",
    "ཟས་ལེགས་པར་སྤྱད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམ་པར་སྣང་མཛད་དང་།",
    "སེང་གེ་ལ་སོགས་པ་གདུག་པ་དེ་དག་ཀྱང་བྱམས་པ་ལ་གནས་ཤིང་འཇིགས་པ་མེད་པར་ཞི་བའི་གནས་ལ་གནས་པ་ནི་དྲུག་པ་དང་།",
    "གང་བསྐལ་པ་ཆེན་པོ་ཟད་པའི་ཚེ་འཛམ་བུའི་གླིང་ཀུན་ཏུ་འབར་ཞིང་རབ་ཏུ་འབར་བས་འཁྲུགས་པར་འགྱུར་ཏེ།",
    "དཔལ་དང་གཟི་བརྗིད་འབར་བ་ཉི་ཟླ་ལས་ལྷག་པའི་འོད་ཟེར་གྱི་དྲྭ་བ་རྣམས་ཀྱིས་བརྒྱན་པར་གྱུར་ནས།",
    "ཁ་དོག་དང་དྲི་རོར་ལྡན་པའི་ཟས་ཀྱིས་ལུས་ཚིམ་པར་བྱས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་དེའི་མཚན་ཐོས་པ་ནི་ཤིན་ཏུ་རྙེད་པར་དཀའོ།",
    "ཚངས་པར་སྤྱོད་པ་རྣམ་པར་དག་པ་དང་།",
    "མཆོག་ཏུ་རྣམ་པར་རྒྱལ་བའི་རྒྱལ་པོ་དང་།",
    "ཚངས་པ་རྣམ་པར་དག་པའི་རྒྱལ་པོ་དང་།",
    "གཤེགས་རྣམ་པར་སྣང་མཛད་གངས་ཆེན་མཚོ།",
