    "དེ་ནས་སྔ་མ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཏྲ་ཞེས་བྱ་བ་ནི་བརྗོད་པར་བྱའོ།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་གཉིས་བྱས་ལ།",
    "ཀྱི་རྣམ་པར་སྣང་མཛད་ནས་བརྩམས་ནས།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་པདྨའི་རིགས་ཀྱི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་སྤྲུལ་པའི་ཕྱིར།",
    "རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་སྤྲུལ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལ་ཕུལ་ལོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་ཕུལ་ལོ་ཞེས་ཤེས་པར་བྱའོ།",
    "པདྨའི་རིགས་ཀྱི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་༢དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལྔ་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་བསྡུ་བ་དང་བྱིན་གྱིས་བརླབ་ཀྱིཔ་ལ་སོགས་པ་ནི་པདྨའི་རིགས་ཀྱི་ཕྱག་རྒྱ་བཞི་པའི་ལས་ཀྱི་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལྔ་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་གསུངས་སོ།",
    "དགུག་པ་དང་པོར་བྱས་པ་གང་ཡིན་པ་ཉིད་ནི་དགུག་པ་ལ་སོགས་པའི་ཆོ་ག་རྒྱས་པ་བྱའོ།",
