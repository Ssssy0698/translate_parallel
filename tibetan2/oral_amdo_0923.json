    "བདག་གི་མཆོད་གཏོར་ཡིད་འོང་ཕུལ་བའི་མཐུས།",
    "དགྲ་བགེགས་ཨ་མུ་ཀ་མཱ་ར་ཡ་ཕཊ།",
    "ཁྱོད་ལ་གཉེར་དུ་གཏད་པའི་ཡུལ་ལྗོངས་འདིའི།",
    "བདག་གི་བཅོལ་བའི་ལས་རྣམས་སྒྲུབ་མཛོད་ལ།",
    "འཕྲིན་ལས་སྒྲུབ་མཛད་མཁའ་འགྲོ་སྲུང་ཚོགས་བཅས།",
    "ཐོག་མར་ཕྱི་ནང་གི་མཆོད་གཏོར་དང་།",
    "སྐད་ཅིག་དཀྲོང་བསྐྱེད་གང་རུང་གིས་ལྷར་བསྒོམ།",
    "གཞི་བདག་གི་སྤྱན་འདྲེན་ནི།",
    "བསྟན་པ་སྐྱོང་མཛད་དཔལ་ལྡན་དྲག་མོ་རྒྱལ།",
    "སྤྱན་གཟིགས་དཔག་ཡས་འཆི་མེད་༡༩ན་ལམ་གང་བར།",
    "རྡོ་རྗེའི་རི་མོ་སྤྱི་བོར་མ་བོར་བའི།",
    "བསྟན་སྲུང་ཆེན་མོར་ཚུལ་བཞིན་༡༩བ་བསྟོད་པ་ཡིས།",
    "རྨོངས་དང་བག་མེད་ཉོན་མོངས་གདོན་བརླམས་ལས།",
    "ཉེར་མཆོད་རོལ་མོ་འདོད་ཡོན་བཀྲ་ཤིས་ཀྱི།",
    "བཀྲ་ཤིས་ལྷུན་ཆགས་རིའི་གཞི་བདག་གི་གསོལ་མཆོད་དང་།",
    "ཚིག་གི་གཟེགས་མ་རེས་ཀྱང་དུག་གསུམ་གྱི།",
    "འཛམ་གླིང་ཡངས་པའི་ཁྱོན་ལ་འཚེ་མེད་ཞི་བའི་ལམ་སྟོན།",
    "སྤྱིའི་དེབ་ཕྲེང་རེ་དགུ་པ།",
    "ཡོན་ཏན་རང་བཞིན་དགེ་འོས་བདག་གིས་ནི།",
    "དེ་བཞིན་བདག་གི་སྙན་ངག་འདི་ངན་ཡང་།",
    "ཁྱོད་ཀྱི་ཐུགས་སུ་ལྟ་ཡང་ཆུད་མོད་ཀྱི།",
    "རྡོ་ཐལ་ལས་བགྱིས་དགུང་ཟླའི་འོད་ཀྱི་ནི།",
    "སྐྱེས་པ་བུད་མེད་དག་ལ་སྩོལ་བར་བགྱིད།",
    "རིགས་དང་གཟུགས་དང་ཐོས་པ་ལང་ཚོ་དང་།",
    "ཁྱོད་ཀྱིས་ཁྲོ་བའི་གོ་སྐབས་དབྱེ་མི་བགྱི།",
    "འདི་ཡིས་བདག་གི་ནོར་ཕྲོགས་གྱུར་ཏོ་ཞེས།",
    "རི་མོ་བྲིས་པ་དེ་འདྲ་རིག་པར་བགྱི།",
    "དེའི་ནང་ཉོན་མོངས་ཅན་ལ་དང་པོ་ནི།",
    "མི་ནི་ཨ་མྲའི་འབྲས་བཞིན་མ་སྨིན་ལ།",
    "ན་ཚོད་མཐུན་པར་མ་དང་བུ་མོ་དང་།",
    "སྲིང་མོའི་འདུ་ཤེས་བསྐྱེད་བགྱི་ཆགས་གྱུར་ན།",
    "དེ་དག་སྤང་བགྱི་དེ་ཡི་ལྕགས་སྒྲོག་གིས།",
    "བུད་མེད་གཞོན་ནུའི་ལུས་ནི་ལོགས་ཤིག་ཏུ།",
    "པགས་པས་གཡོགས་དང་རྒྱན་ཡང་ལོགས་ཤིག་གཟིགས།",
    "དོན་དམ་གཟིགས་པར་བགྱི་སླད་དངོས་རྣམས་ལ།",
    "བདག་གི་ཡིད་ཡུལ་མིན་པར་མགོ་སྙོམས་མཛོད།",
    "ཁྱོད་ཀྱིས་བྲམ་ཟེ་དགེ་སློང་ལྷ་དང་ནི།",
    "མགྲོན་དང་ཡབ་ཡུམ་དག་དང་བཙུན་མོ་དང་།",
    "དེ་ཡི་མོད་ལ་མཚོན་བཞིན་མི་གཅོད་ཀྱང་།",
    "ཆང་དང་མཚན་མོ་རྒྱུ་བ་ངན་སོང་བ།",
    "ཁྱིམ་ཐབ་བརྙས་བགྱིད་རྗེ་མོ་ལྟ་བུ་དང་།",
    "སྲིང་མོ་ལྟ་བུར་རྗེས་མཐུན་གང་ཡིན་དང་།",
    "མ་བཞིན་ཕན་པར་འདོད་དང་བྲན་མོ་བཞིན།",
    "མཚན་མོའི་ཐུན་གྱི་སྟད་སྨད་བཟླས་ནས་ནི།",
    "ཏིང་འཛིན་ཤེས་རབ་མོས་མཆོག་ལྔ་ཉིད་དེ།",
    "ལས་ནི་བདག་གིར་བྱས་ལས་མ་འདས་ཞེས།",
    "ལུས་མཐའ་ཐལ་བ་མཐའ་སྐམ་མཐར་འདྲུལ་ཞིང་།",
    "མི་མཆོག་ཁྱོད་ཀྱི་ཐུགས་ནི་དབྱུང་བར་མཛོད།",
    "འཁོར་ལོ་ཆེན་པོ་བཞི་ནི་ཁྱོད་ལ་མངའ།",
    "རེ་རེས་རྒྱ་མཚོ་བཞི་བས་ལྷག་པ་ཡི།",
    "རེ་རེའི་བདག་ཉིད་རུས་པའི་ཕུང་པོ་ནི།",
    "མཐོ་རིས་བུ་མོའི་ནུ་མ་རྐེད་པ་ལ།",
    "རེག་པའི་བདེ་བ་ཡུན་རིང་མྱོང་ནས་སླར།",
    "རེག་པ་ཤིན་ཏུ་མི་བཟད་བསྟེན་འཚལ་ལོ།",
    "རྐང་པའི་རེག་པས་ནེམ་པར་བདེ་བཟོད་པ།",
    "མཐོ་རིས་བུ་མོས་འབྲོངས་ཤིང་དགའ་བ་དང་།",
    "དལ་གྱིས་འབབ་པ་ལྷ་ཡི་བུ་མོ་ནི།",
    "མནར་མེད་མེ་ཡི་བུད་ཤིང་གྱུར་པ་ཡི།",
    "རང་གི་ལག་པ་བརྐྱང་བའང་མི་མཐོང་འགྱུར།",
    "ཕྱེ་མ་ཞིབ་མོ་བཞིན་དུ་ཕྱེད་མར་རློག།",
    "སྟ་རེ་མི་བཟད་སོ་རྣོན་རྣམས་ཀྱིས་བཤགས།",
    "སེན་མོ་མི་བཟད་ལྡན་པའི་ཁྭ་རྣམས་འཐོག།",
    "རེག་ན་མི་བཟད་རྨ་སྲོལ་ཆེར་འབྱིན་པས།",
    "སྡིག་ཅན་དབུགས་འབྱུང་འགགས་པ་ཙམ་ཞིག་གི།",
    "ལུས་ངག་ཡིད་ཀྱི་ཉེས་སྤྱད་ཁྱོད་ཀྱིས་ནི།",
    "ལྗོན་ཤིང་འབྲས་བུ་མེད་གྱུར་འདི་དག་གིས།",
    "མཐོ་རིས་ན་ཡང་བདེ་ཆེད་དེ་དག་གི།",
    "རེག་པ་ལས་ནི་ཚོར་བ་ཀུན་འབྱུང་སྟེ།",
    "གསུང་གི་མཛོད་ཀྱི་གཅེས་པ་ཟབ་མོ་སྟེ།",
    "གང་གིས་འདི་ནི་ཡང་དག་མཐོང་བ་དེས།",
    "ཤེས་པས་ཉོན་མོངས་ཆུ་བོ་ལས་བརྒལ་གྱི།",
    "ཉོན་མོངས་རག་ལས་སོ་སོའི་སྐྱེ་བོར་བས།",
    "ཁྱོད་ཀྱིས་ཐུགས་དུལ་མཛོད་ཅིག་བཅོམ་ལྡན་གྱིས།",
    "ཁྱོད་ལ་དེ་སྐད་གདམས་པ་གང་ལགས་དེ།",
    "བས་པར་དགེ་སློང་གིས་ཀྱང་བགྱི་བ་དཀའ།",
    "༡༢༣། དཔལ་འཁོར་ལོ་བདེ་མཆོག་དྭགས་པོ་སྙན་བརྒྱུད་ལུགས་ཀྱི་སྒྲུབ་ཐབས་བདེ་ཆེན་དྲྭ་བ་བཞུགས་སོ། ༡༢༤། ན་མོ་གུ་རུ་ཤྲཱི་ཙཀྲ་སམྦ་ར་ཡ།",
    "རང་ཉིད་སྐད་ཅིག་གིས་དཔལ་འཁོར་ལོ་བདེ་མཆོག་སྔོན་པོ་ཞལ་གཅིག་ཕྱག་གཉིས་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པ་ཡུམ་རྡོ་རྗེ་ཕག་མོ་དམར་མོ་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་དང་མཉམ་པར་སྦྱོར་བའི་སྐུར་གྱུར།",
    "ཤར་ལྷོར་ཨོཾ་ལས་བ་ལང་གི་ཤ་ལ་གོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀ་ནས་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་བཀུག་སྟེ་དམ་ཚིག་གི་བདུད་རྩི་དང་གཉིས་སུ་མེད་པའི་བདུད་རྩིའི་རྒྱ་མཚོ་ཆེན་པོར་གྱུར།",
    "ཧཱུྃ་ཡིག་གི་ཚོགས་དཔག་ཏུ་མེད་པ་འོད་དུ་ཞུ་བ་ལས་བྱུང་བའི་ལྷ་རྫས་ལས་གྲུབ་པའི་རྡོ་རྗེའི་མཆོད་ཡོན།",
    "ཤབྡའི་བར་གྱིས་མཆོད་ནས་ཐལ་མོ་ཁ་ཕྱེ་བ་གཏོར་འབུལ་གྱི་ཕྱག་རྒྱ་དང་བཅས་ཏེ།",
    "གསང་སྔགས་ཟབ་མོའི་ཆོ་ག་ལ།",
    "དེའི་ཆེད་དུ་རྡོ་རྗེའི་རྣལ་འབྱོར་ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱིའོ།",
    "ཕྱི་ལུས་ཀྱི་སྡིག་སྒྲིབ་ནང་སེམས་ཀྱི་སྡིག་སྒྲིབ་ཉེས་ལྟུང་དྲི་མའི་ཚོགས་ཐམས་ཅད་རྐང་མཐིལ་སོར་མོ་རྒྱུད་དུ་ནག་ནུར་གྱིས་དོན་པས།",
    "རང་ཉིད་བདེ་མཆོག་ལྷན་ཅིག་སྐྱེས་པ་ཡབ་ཡུམ་གྱི་སྐུར་གསལ་བའི་ཐུགས་ཀའི་ས་བོན་གྱི་འོད་ཀྱི་སྣང་བས་མདུན་གྱི་ནམ་མཁར་གཞལ་ཡས་ཁང་གི་ནང་དུ་དཔལ་འཁོར་ལོ་སྡོམ་པའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་བདེ་བ་ཆེན་པོའི་རང་བཞིན་ཅན།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་གུ་རུ་དེ་བ་ཌཱ་ཀི་ནཱི་ཛཱ་ལ་སམྦ་ར་མཎྜལ་སརྦ་ཝཱི་ར་ཡོ་གི་ནཱི་བཛྲ་ཨཱརྒྷཾ་པྲ་ཏཱིཙྪ་ཧཱུྃ་སྭཱ་ཧཱ།",
    "པཉྩ་ཨ་མྲྀ་ཏས་ནང་མཆོད།",
    "མ་ཏཾ་གི་སྦྱར་བས་གསང་མཆོད་འབུལ།",
    "གྲོལ་བ་བདག་གིས་བསྒྲུབ་པར་བགྱིད།",
    "ན་མོ་གུ་རུ་བཛྲ་ཌཱ་ཀི་ནཱི་ཡེ།",
    "ཕྲིན་ལས་མངའ་བདག་དཔལ་ལྡན་ལྷ་མོའི་ཚོགས།",
    "རྩ་འཁོར་ལོ་བཞིར་བྱང་སེམས་ཀྱིས་ཁྱབ་པས་བདེ་སྟོང་གི་ཡེ་ཤེས་སྐྱེས།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་བ་ཧཱུྃ་གིས་མཚན་པ།",
    "དེའི་དབུས་སུ་པྃ་ལས་སྣ་ཚོགས་པདྨ་འདབ་མ་མཐའ་ཡས་པའི་ལྟེ་བར་ཧཱུྃ་ལས་སྣ་ཚོགས་རྡོ་རྗེ་རྩེ་མོ་བཅུ་གཉིས་པ།",
    "བྱང་གི་རྭ་ལྗང་བ།",
    "དེའི་དབུས་སུ་ཧཱུྃ་གིས་མཚན་པ།",
    "དེ་ཐམས་ཅད་ཀྱང་གུར་བླ་རེ་ར་བ་དྲྭ་བ་ས་གཞི་དང་བཅས་པ།",
    "དེའི་ཕྱིར་མེ་རི་དམར་ནག་གི་གུར་ཁང་གཡོན་སྐོར་དུ་འཁྱིལ་ཞིང་འཚུབས་པ།",
    "དེའི་སྟེང་གི་ཕྱི་རོལ་དུ་ཤར་བུ་དང་མདའ་ཡབ་ཀྱིས་བསྐོར་བ།",
    "མཚམས་བཞིའི་པད་འདབ་སྔོན་པོ་ཅན་གྱི་མཐར་གྲི་གུག་གི་ར་བས་བསྐོར་བ།",
    "དེའི་ཕྱི་རོལ་གྱི་ཕྱོགས་བཞིའི་པད་འདབ་ཀྱི་སྟེང་དུ་ཉི་མའི་དཀྱིལ་འཁོར་རེ་རེའི་དབུས་སུ་འཇིགས་བྱེད་དང་དུས་མཚན་མ་རེ་རེའི་སྟེང་དུ་ཡབ་ཀྱི་ས་བོན་ཧཱུྃ་ཡིག་ལས་ཧེ་རུ་ཀ་རིགས་བཞིའི་ས་བོན་འཕྲོས་པ་ནི།",
    "ཞལ་རེ་རེ་ལ་སྤྱན་གསུམ་གསུམ་དང་ལྡན་པ།",
    "བྲམ་ཟེ་མོའི་ཚངས་སྐུད་ཀྱིས་རལ་པའི་ཐོར་ཅོག་བང་རིམ་གསུམ་དུ་བཅིངས་པའི་མགོ་ལ་སྣ་ཚོགས་རྡོ་རྗེས་མཚན་པ།",
    "ཐོར་ཅོག་གི་རྩེ་མོར་རུས་པའི་འཁོར་ལོ་རྩིབས་བརྒྱད་པའི་ལྟེ་བར་རུས་པའི་རྡོ་རྗེ་རྩེ་ལྔ་པའི་ཏོག་གིས་མཚན་པ་རྡོ་རྗེ་སེམས་དཔའི་ཡན་ལག།",
    "ཐལ་བ་ཧེ་རུ་ཀའི་ཡན་ལག་སྟེ་ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "གཡོན་པས་ཐོད་པ་ཁྲག་གིས་གང་བ་བསྣམས་ནས་ཡབ་ཀྱི་མགུལ་ནས་འཁྱུད་པ།",
    "ཐལ་བ་སྤངས་པའི་ཕྱག་༡༣༧",
    "ནུབ་བྱང་གི་བུམ་པ་གླ་རྩིས་གང་བ།",
    "ཁར་ཨ་ལས་ཡེ་ཤེས་ཀྱི་ཀ་པཱ་ལ་དཔྲལ་བ་དབུས་སུ་བསྟན་པ་ཟག་པ་མེད་པའི་བདུད་རྩིས་གང་བ་རེ་རེ་གནས་པའོ།",
    "མགྲིན་པར་པྃ་ལས་མེའི་ཁམས་འགུགས་བྱེད་མ་དམར་མོ་གཡས་གཉིས་པདྨ་དང་གྲི་གུག་འཛིན་པ།",
    "གསང་བར་ཁྃ་ལས་ནམ་མཁའི་ཁམས་པདྨ་དྲྭ་བ་ཅན་དམར་མོ་གྲི་གུག་༡༣༩",
    "སྤྱི་གཙུག་ཏུ་ཧོ་ལས་ཡེ་ཤེས་ཀྱི་ཁམས་རྡོ་རྗེ་སྙེམས་མ་སྔོན་མོ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པའོ།",
    "མཚམས་བཞིར་སྔོ་བའི་མཐར་གྲི་གུག་གི་ར་བ་དང་།",
    "དེའི་ཕྱིར་དམ་ཚིག་གི་འཁོར་ལོར་སྣ་ཚོགས་པདྨ་འདབ་མ་བརྒྱད་པའི་མཐར་སྣ་ཚོགས་རྡོ་རྗེའི་ར་བ་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ།",
    "ཤར་ནས་གཡོན་སྐོར་དུ་མཱྃ་ལཱྃ་པཱྃ་ཏཱྃ་བཞི་ཡོངས་སུ་གྱུར་པ་ལས་ཤར་དུ་མཁའ་འགྲོ་མ་སྔོན་མོ།",
    "ནུབ་ཏུ་ཁཎྜ་རོ་ཧཱི་མ་དམར་མོ།",
    "ལྷོར་གཟུགས་ཅན་མ་སེར་མོ།",
    "རློན་པ་ལྔ་བཅུ་རྩ་གཅིག་གིས་དོ་ཤལ་བྱས་པ།",
    "ནུབ་བྱང་གི་བུམ་པ་གླ་རྩིས་གང་བ།",
    "དེ་རྣམས་ཀྱི་ཁར་ཐོད་པ་བདུད་རྩིས་གང་བ་དཔྲལ་བ་དབུས་སུ་བསྟན་པ་རེ་རེ་སྟེ་བདེ་བ་ཆེན་པོའི་འཁོར་ལོའོ།",
    "གཙོ་བོ་ཧེ་རུ་ཀའི་སྤྱི་བོ་ལ་སོགས་པའི་གནས་རྣམས་དང་ཐུགས་ཀར་ཐུགས་གསུང་སྐུའི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་རེ་རེ་གནས་པའི་རྩིབས་ཀྱི་སྟེང་དུ་ཐུགས་ཀའི་ཧཱུྃ་ལས་སྤྲོས་པའི་པཱུ་ཛ་ཨོ་ཨ།",
    "དེ་རྣམས་ཡོངས་སུ་གྱུར་པ་ལས་ཐུགས་ཀའི་ཐུགས་ཀྱི་འཁོར་ལོའི་ཤར་རྩིབས་དང་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ཕྱིའི་ཧེ་རུ་ཀའི་སྤྱི་བོ་པཱུ་ལླི་ར་མ་ལ་ཡར་དཔའ་བོ་ཐོད་པའི་དུམ་བུ་དང་དཔའ་མོ་རབ་གཏུམ་མ།",
    "བྱང་གི་རྩིབས་དང་སྤྱི་གཙུག་ཛཱ་ལནྡྷ་རར་དཔའ་བོ་ཀེང་རུས་ཆེན་པོ་དང་དཔའ་མོ་གཏུམ་མིག་མ།",
    "ནུབ་རྩིབས་དང་རྣ་བ་གཡས་པ་ཨོ་ཌི་ཡཱ་ནར་དཔའ་བོ་ཀཾ་ཀ་ལ་དང་དཔའ་མོ་འོད་ལྡན་མ།",
    "ལྷོ་རྩིབས་དང་ལྟག་པ་ཨ་བུ་ཏར་དཔའ་བོ་མཆེ་བ་རྣམ་གཙིགས་དང་དཔའ་མོ་སྣ་ཆེན་མ།",
    "ཤར་ལྷོའི་རྩིབས་དང་རྣ་བ་གཡོན་པ་གོ་དཱ་ཝ་རར་དཔའ་བོ་ལྷ་དགྲ་དང་དཔའ་མོ་བློ་གྲོས་མ།",
    "ལྷོ་ནུབ་དང་སྨིན་དབུས་ར་མེ་ཤ་རར་དཔའ་བོ་སྣང་བ་དཔག་མེད་དང་དཔའ་མོ་མིའུ་ཐུང་མ།",
    "དེའི་ཕྱིའི་གསུང་གི་འཁོར་ལོའི་ཤར་རྩིབས་དང་མཆན་ཁུང་གཉིས་ཀ་མ་རཱུ་པར་དཔའ་བོ་མྱུ་གུ་ཅན་དང་དཔའ་མོ་ས་སྲུང་མ།",
    "བྱང་རྩིབས་དང་ནུ་མ་གཉིས་ཨོ་ཏྲར་དཔའ་བོ་རྡོ་རྗེ་རལ་པ་ཅན་དང་དཔའ་མོ་འཇིགས་བྱེད་ཆེན་མོ།",
    "ལྷོའི་རྩིབས་དང་སྣ་རྩེ་ཀོ་ས་ལར་དཔའ་བོ་རྡོ་རྗེ་ཧཱུྃ་མཛད་དང་དཔའ་མོ་ཆང་འཐུང་མ།",
    "མེ་མཚམས་དང་ཁ་ཀ་ལིང་ཀར་དཔའ་བོ་རབ་ཏུ་བཟང་པོ་དང་དཔའ་མོ་སྔོ་བསངས་ལྷ་མོ།",
    "བདེན་བྲལ་དང་མགྲིན་པ་ལམྦ་ཀར་དཔའ་བོ་རྡོ་རྗེ་བཟང་པོ་དང་དཔའ་མོ་རབ་ཏུ་བཟང་མོ།",
    "དེའི་ཕྱིར་སྐུའི་འཁོར་ལོའི་ཤར་རྩིབས་དང་མཚན་མ་པྲེ་ཏ་པུ་རིར་དཔའ་བོ་སྟོབས་པོ་ཆེ་དང་དཔའ་མོ་འཁོར་ལོའི་ཤུགས་ཅན་མ།",
    "ནུབ་རྩིབས་དང་བརླ་གཉིས་སོ་རཱཥྚར་དཔའ་བོ་རྟ་མགྲིན་དང་དཔའ་མོ་ཆད་འཚོང་མ།",
    "མེ་དང་སོར་མོ་བཅུ་དྲུག་ན་ག་རར་དཔའ་བོ་ཧེ་རུ་ཀ་དང་དཔའ་མོ་རབ་ཏུ་གཏུམ་མོ།",
    "རལ་པའི་ཐོར་ཅོག་གྱེན་དུ་བཅིངས་པ་ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "དཔའ་མོ་ཐམས་ཅད་ཀྱང་ཞལ་གཅིག་ཕྱག་གཉིས་སྤྱན་གསུམ་མཆེ་བ་བཞི་གཙིགས་པ།",
    "གཡོན་པས་ཐོད་པ་ཁྲག་གིས་བཀང་བ་བསྣམས་ནས་རང་རང་གི་ཡབ་ལ་འཁྱུད་པ།",
    "ཤར་ཕྱོགས་དང་ཁ་མདུང་གིས་འབིགས་པའི་དུར་ཁྲོད་དུ་ཁྭ་གདོང་མ་སྔོན་མོ།",
    "རྣག་གི་དྲིའི་དུར་ཁྲོད་དུ་ཁྱི་གདོང་མ་དམར་མོ།",
    "བདེན་བྲལ་དང་རྣ་བ་གཡོན་སྦྲུལ་གྱིས་བཟུང་བའི་དུར་ཁྲོད་དུ་གཤིན་རྗེ་ཕོ་ཉ་མོ་གཡས་སེར་གཡོན་དམར་བ།",
    "ཕྱི་ནང་གི་ཧེ་རུ་ཀ་དྲུག་དང་།",
    "ཕྱི་ནང་གི་ཡུམ་བཅུ།",
    "ནང་གི་དཔའ་མོ་ཉེར་བཞི།",
    "སྒོ་མཚམས་མ་བརྒྱད་བཅས་ཀྱི་ལྟེ་བར་རྡོ་རྗེ་ཕག་མོའི་ངོ་བོ་ཨོཾ་བྃ་དམར་མོ།",
    "ཁ་ལ་རྨོངས་བྱེད་མའི་ངོ་བོ་ཧྲཱི་མོཾ་དཀར་མོ།",
    "མགོ་བོར་སྐྱོད་བྱེད་མའི་ངོ་བོ་ཧྲེཾ་ཧྲཱིཾ་སེར་མོ།",
    "སྨིན་མཚམས་སུ་གཏུམ་མོའི་༡༤༤",
    "ངོ་བོ་ཕཊ་ཕཊ་དུད་ཀ་སྟེ་གོ་ཆའི་དཔའ་མོ་དྲུག།",
    "ཕྱི་ནང་གི་ལྷ་ཐམས་ཅད་ཀྱི་སྤྱི་བོར་ཟླ་བའི་སྟེང་དུ་ཨོཾ་ལས་སྐུ་རྡོ་རྗེ་དཀར་པོ་འཁོར་ལོ་དང་དྲིལ་བུ་འཛིན་པ།",
    "ན་མ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཤྲཱི་ཙཀྲ་སམྦར་སརྦ་བཱིར་ཡོ་གི་ནཱི་ཡེ།",
    "གི་ལྷ་རྒྱལ་བ་རིགས་ལྔ་འཁོར་དང་བཅས་པ་སྤྱན་དྲངས།",
    "ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་ཕྱི་ནང་གི་གཙོ་བོ་དང་ཕྱི་ནང་གི་མཁའ་འགྲོ་མ་གཉིས་དང་ཐུགས་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་ལ་མི་བསྐྱོད་པ་དང་།",
    "ཕྱི་ནང་གི་གཙོ་བོའི་ཡུམ་དང་བུདྡྷ་ཧེ་རུ་ཀ་དང་སྐུ་འཁོར་གྱི་ལྷ་རྣམས་ལ་རྣམ་པར་སྣང་མཛད་དང་།",
    "ཀརྨ་ཧེ་རུ་ཀ་དང་ཕྱི་ནང་གི་ལཱ་མ་གཉིས་དང་སྒོ་མཚམས་མ་བརྒྱད་ལ་དོན་ཡོད་གྲུབ་པ་དང་།",
    "པདྨ་ཧེ་རུ་ཀ་དང་ཕྱི་ནང་གི་ཁཎྜ་རོ་ཧི་དང་གསུང་འཁོར་གྱི་ལྷ་རྣམས་ལ་འོད་དཔག་མེད་དང་།",
    "རཏྣ་ཧེ་རུ་ཀ་དང་ཕྱི་ནང་གི་གཟུགས་ཅན་མ་རྣམས་ལ་རིན་ཆེན་འབྱུང་ལྡན་རྣམས་ཀྱིས་དབུར་བརྒྱན་པར་གྱུར།",
    "ཨོཾ་ན་མོ་བྷ་ག་ཝ་ཏེ་ཝཱི་རེ་ཤཱ་ཡ།",
    "ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ་བཛྲ་ཝརྞ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་ཤྲཱི་བུདྡྷ་ཧེ་ཧེ་རུ་རུ་ཀཾ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ཨ་མི་ཏ་བྷཱ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་སུ་བཱི་རེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "དམ་ཚིག་གི་དཀྱིལ་འཁོར་ཏེ་སྒོ་མཚམས་མ་བརྒྱད་དོ།",
    "རང་གི་ཐུགས་ཀ་ནས་སྤྲོས་པའི་ལྷ་མོའི་ཚོགས་ཀྱིས་བདག་ལ་མཆོད་ཅིང་བསྟོད་པར་བསམས་ལ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཤྲཱི་ཙཀྲ་སམྦ་ར་སརྦ་བི་ར་ཡོ་གི་ནཱི་བཛྲ་ཨཱརྒྷཾ་པྲ་ཏཱིཙྪ་སྭཱ་ཧཱ།",
    "ཞེས་རེ་རེ་བཞིན་བཅུག་པས་རིག་མ་བཅུ་དྲུག་གིས་མཆོད།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཤྲཱི་ཙཀྲ་སམྦ་ར་སརྦ་བཱི་ར་ཡོ་གི་ནཱི་ས་པ་རི་ཝཱ་ར་ཨོཾ་ཨཱ་ཧཱུྃ།",
    "རང་གི་ཐུགས་ཀའི་འོད་ཀྱིས་ཕོག་པས་སྣོད་བཅུད་ཐམས་ཅད་འོད་དུ་ཞུ་ནས་གཞལ་ཡས་ཁང་ལ་ཐིམ།",
    "ཅེས་མོས་ལ་ཅི་གནས་སུ་མཉམ་པར་བཞག།",
    "ཞེས་བརྗོད་ལ་གོ་ཆ་དང་གནས་གསུམ་བསྲུང་བའི་མོས་པ་བྱ།",
    "བཙུན་མོའི་ཤུ་ཀྲ་ལེན་འགྱུར་ཤོག།",
    "གསང་སྔགས་ཟབ་མོ་རྒྱུད་ནས་བསྔགས་པ་ཡི།",
    "རྣལ་འབྱོར་ཟབ་མོ་མཐའ་རུ་ཕྱིན་ནས་ཀྱང་།",
    "པོད་༣༥༨འོན་རྒོད་དུ་སོང་བའི་སྐུ་རྣམས་ཀྱི་འདོད་གསོལ། ། འོན་རྒོད་དུ་སོང་བའི་སྐུ་རྣམས་ཀྱི་འདོད་གསོལ་བཞུགས་སོ།",
    "ཁྱད་པར་བདག་ལ་ལྟོས་བཅས་དུས་གསུམ་ཐམས་ཅད་ལ་གནས་སྐབས་མཐར་ཐུག་གི་རེ་སྨོན་མ་ལུས་པ་སྩལ་དུ་གསོལ།",
    "ནག་མོ་གནོད་སྦྱིན།",
    "སྲིང་མོ་དྲེགས་པ་རྒྱུད་གསུམ།",
    "འོན་རྒོད་དུ་སོང་བའི་སྐུ་རྣམས་ཀྱི་འདོད་གསོལ།",
    "ཡོན་ཏན་གསུམ་ལའང་ས་ལུ་དང་ནས་ཀྱི་ས་བོན་སོགས་དེ་དང་དེའི་བདག་ཉིད་དེས་གནས་སྐབས་ཐ་དད་པའང་ཡོད་པས་དེའི་ཕྱིར་ཕན་ཚུན་ས་ལུ་དང་ནས་ཀྱི་ས་བོན་སོགས་ཀྱི་བདག་ཉིད་གཅིག་གཅིག་གི་འབྲས་བུ་བསྐྱེད་པའི་བྱ་བ་མེད་ཅེ་ན།",
    "ས་ལུ་མི་བྱེད་པར་ཐལ།",
    "གཙོ་བོ་དེ་ས་ལུའི་ས་བོན་ནས་ཀྱི་མྱུ་གུ་མ་བསྐྱེད་པའི་བདག་ཉིད་དུ་གྱུར་པ་ཉིད་དུས་གཞན་དུ་ཡོངས་སུ་འགྱུར་ནས་མྱུ་གུ་བྱེད་པ་པོར་འགྱུར་བ་ལ་ནུས་པ་ཉེ་བར་སྦྱོར་བའི་ཕྱིར་བྱེད་དང་མི་བྱེད་འགལ་བར་ཐལ་བ་འདོད་ཅེ་ན།",
    "རྣམ་དབྱེ་ཐ་དད་མེད་པའི་རྟག་པ་གཅིག་མིན་པར་ཐལ།",
    "ཤིན་ཏུ་ཐ་དད་ནས་སྤྱི་གཅིག་གི་བདག་ཉིད་དུ་མི་འགྱུར།",
    "གལ་ཏེ་སྤྱི་དང་ཁྱད་པར་ནུས་པ་དང་གནས་སྐབས་ཡིན་པས་རྣམ་པ་འགའ་ཞིག་གིས་ཐ་དད་དུ་འདོད་ཅེ་ན།",
    "སྤྱི་དང་ཁྱད་པར་དེ་དག་གི་ནང་ནས་གསལ་བ་འདི་ནི་ཁྱད་པར་ཡིན་ལ།",
    "ནུས་པ་རྟག་པ་དང་གསལ་བ་མི་རྟག་པའི་བདག་ཉིད་ཀྱི་རང་བཞིན་ཐ་དད་ཡིན་པ་གང་གིས་སོ།",
    "ཐལ་བ་དེ་ལྟར་འདོད་ནའང་།",
    "སྤྱི་དང་ཁྱད་པར་ཅན་དང་ཁྱད་པར་སྤྱི་ཅན་དུ་མ་འགྱུར་བར་ཐལ།",
    "སྤྱི་རང་མཚན་ལས་ཐ་དད་དང་ཐ་དད་མེད་པ་ཞེས་དཔྱད་པར་མི་རིགས་ཀྱི་དོན་བྱེད་པ་དེའི་རྟེན་བ་ལང་གི་ཁྱད་པར་རང་མཚན་ལ་རྫས་ཀྱི་སྒོ་ནས་ཁྱད་པར་ཐ་དད་པའམ།",
    "ལྡོག་པའི་སྒོ་ནས་ཁྱད་པར་ཐ་དད་མེད་པ་ཡིན་ཞེས་དཔྱད་པར་བྱ་བར་རིགས་ཏེ་རྨོ་སོགས་ཀྱི་དོན་བྱེད་པའི་བ་ལང་རང་མཚན་གྱི་བདག་ཉིད་གང་གི་མདུན་དུ་དམིགས་པར་བྱས་ནས་འཇུག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྨོ་སོགས་ཀྱི་དོན་བྱེད་པ་དེའི་རྟེན་ཁྱད་པར་རང་མཚན་ཁོ་ན་རང་གི་ངོ་བོས་ནང་ཕན་ཚུན་ཤིན་ཏུ་བདག་ཉིད་ཐ་དད་ཅིང་བ་ལང་ཉིད་དང་རྫས་ཉིད་ལ་སོགས་པར་ལྡོག་པ་མཚུངས་པ་ཉིད་དག་ནི་རྟོག་ངོར་ཡོད་པ་ཉིད་ཀྱི་ཕྱིར་དེ་ཙམ་གྱིས་ཐ་དད་དང་ཐ་དད་མེད་པའི་སྤྱོད་པ་ཡོངས་སུ་རྫོགས་པ་ཡིན་ནོ།",
    "ཇི་སྐད་དུ་ན་རྫ་མོ་འདི་ཞོར་འགྱུར་ཏེ།",
    "རང་བཞིན་གཅིག་མིན་པར་ཐལ།",
    "དེ་རྔ་མོ་ཡིན་ལ་ཞོ་མིན་པའི་ཁྱད་པར་བསལ་བར་ཐལ།",
    "ཞོ་ཡང་ཡིན་ལ་རྔ་མོ་ཡང་ཡིན་པའི་ཕྱིར་ཏེ།",
    "རྔ་ཞོ་སོགས་དངོས་པོ་ཐམས་ཅད་རང་གཞན་གཉིས་ཀའི་ངོ་བོར་ཐུན་མོང་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་རྔ་མོ་འཐུང་བ་ལ་མི་རྒྱུག་སྟེ་རྒྱུག་པར་རིག་པར་ཐལ།",
    "ཞོ་ནི་འོ་མ་ལས་གྱུར་པ་རྔ་མོ་ལ་མེད་པའི་ཁྱད་པར་ཅན་ཡིན་པ་གང་གིས་ཏེ་དེའི་ཁྱད་པར་གྱིས་རྔ་མོ་སྤངས་ནས་ཞོ་འཐུང་བ་ལ་འཇུག་པར་འགྱུར་ཞེ་ན།",
    "རྔ་ཞོ་གཉིས་ཀའི་ངོ་བོ་མིན་པར་ཞོ་དེ་རྔ་མོ་ལས་རང་བཞིན་གཞན་ཡིན་པར་ཐལ།",
    "དེ་ཉིད་ཞོ་ཡིན་ཞིང་གཞན་རྔ་མོ་ལ་མེད་པའི་ཕྱིར།",
    "དོན་སོ་སོར་ངེས་པའི་བློ་སྒྲ་ཐ་དད་དོན་མཐུན་འཇུག་པར་མི་འགྱུར་བར་ཐལ།",
    "རྔ་མོ་ནི་ཞོར་མི་འགྱུར་ཞིང་ཞོར་འགྱུར་ཞེས་ཐ་དད་གཅིག་ཏུ་སྨྲ་བ་དེ་ནི་རིགས་མི་སྲིད་པར་འགྱུར།",
    "དེའི་མིང་གིས་དེའི་ངོ་བོ་སྒྲུབ་པའི་སྒོ་ནས་བརྗོད་དམ་སེལ་བས་བརྗོད་ཅེས་དཔྱད་པར་བྱ་དགོས་ཀྱི་དོགས་པ་སྐྱེ་བའི་གནས་ཉིད་མ་ཡིན་ཏེ་ངོ་བོར་མེད་པའི་ཕྱིར།",
    "གྲངས་ཅན་ན་རེ།",
    "མི་རྟག་པ་དེ་ཙམ་རང་གི་ཁྱབ་བྱེད་དུ་ངེས་པའི་རྟགས་ཡང་དག་ཡིན་པའི་ཕྱིར་རོ།",
    "གཙོ་བོ་ཡོད་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཏུ་མེད་པར་ཐལ།",
    "གཙོ་བོ་དངོས་པོར་ཡོད་པ་ལ་འཁྲུལ་པ་ཅན་དུ་ཐལ།",
    "གཙོ་བོར་དངོས་པོར་སྒྲུབ་པ་ལ་འགལ་བའི་གཏན་ཚིགས་སུ་ཐལ།",
    "གཙོ་བོ་དངོས་པོ་ཡོད་པ་དེ་ཇི་ལྟར་བསྒྲུབ་བྱ་སྐྱོན་མེད་དུ་འགྱུར་བ་མིན་པར་ཐལ།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་གྲུབ་ཏུ་ཆུག་མོད་སྐད་ཅིག་མར་ནི་མི་འགྲུབ་བོ་ཞེ་ན།",
    "རང་གྲུབ་ཙམ་གྱིས་འཇིག་པ་ནི་རང་གི་ངོ་བོས་རྗེས་སུ་འབྲེལ་བ་སྟེ་རང་བཞིན་གྱིས་འཇིག་པར་ངེས་ཏེ།",
    "རང་གི་རྒྱུ་ལས་རྒྱུ་དོན་གཞན་ལ་ལྟོས་པ་མེད་པར་འཇིག་པ་དེ་ཁྱོད་ཀྱི་རང་བཞིན་དུ་བྱུང་བའི་ཕྱིར་ནའོ།",
    "ངེས་པར་འཇིག་པར་འགྱུར་བར་མཐོང་བ་མེད་པར་ཐལ།",
    "གང་གི་ཕྱིར་ན་རང་གྲུབ་ཙམ་གྱིས་མི་འཇིག།",
    "དེ་ལ་བུམ་པ་འཇིག་པས་ཁྱབ་པ་འཁྲུལ་པ་ཉིད་དུ་ཐལ།",
    "རང་གི་འབྲས་བུར་འདོད་པའི་འཇིག་པ་དེ་ཁྱོད་ལ་ལྟོས་པར་ངེས་པ་མིན་པར་ཐལ།",
    "ཐ་དད་ན་བུམ་པ་འཇིག་པར་མ་བྱས་པར་ཐལ་ལོ།",
    "ཡང་གིས་འཇིག་པ་དངོས་མེད་ཡིན་པར་འདོད་པ་ལྟར་ན།",
    "བུམ་པའི་འཇིག་པ་བསྐྱེད་པར་མི་འཐད་པར་ཐལ།",
    "རང་གྲུབ་ཙམ་གྱི་ངོ་བོ་ཉིད་ཀྱིས་སྐད་ཅིག་གིས་འཇིག་པར་འགྱུར།",
    "བསྐལ་དོན་ལུང་ལ་བརྟེན་པའི་ཡིད་ཆེས་རྗེས་དཔག་གིས་མ་དམིགས་པས་མེད་ངེས་སུ་མི་འགྲུབ་པར་ཐལ།",
    "བསྐལ་དོན་གྱི་འབྲས་བུ་དམིགས་པའི་རྟགས་ལ་བརྟེན་པ་ཅན་གྱི་རྗེས་དཔག་གི་བསྐལ་དོན་གཞལ་བྱར་མེད་དེ།",
    "ཤེས་བྱེད་རྟགས་ཀྱི་སྒོ་ནས་རྗེས་དཔག་གིས་མི་ཤེས་པ་སྟེ།",
    "ཡོད་ན་སྣང་རུང་གི་བུམ་པའི་དངོས་པོ་མ་དམིགས་པ་ལས་བུམ་མེད་ཀྱི་གཞི་ལ་སྣང་རུང་བུམ་པའི་དངོས་པོ་མེད་པར་རྟོགས་པར་འགྱུར་ཏེ།",
    "དེས་གྲང་རེག་དེ་ཡོད་པ་ལ་གནོད་པར་བྱེད་པའི་ཚུལ་གྱིས་གྲང་རེག་དང་ལྷན་ཅིག་མི་གནས་པའི་འགལ་བར་ངེས་པའི་ཕྱིར་རོ།",
    "སློབ་དཔོན་ཕྱོགས་གླང་གིས་གཙོ་བོ་ལ་སོགས་པ་ནི་ཡོད་པ་མིན་ཏེ།",
    "ཇི་ལྟར་ན་དངོས་པོ་དངོས་མེད་དེ་གཉིས་ཀའི་རྣམ་རྟོག་གི་བག་ཆགས་ལས་བྱུང་བའི་ཡོད་པ་དང་མེད་པ་དང་དེ་གཉིས་ཀ་ལ་བརྟེན་པའི་སྒྲ་དོན་གསུམ་སྟེ།",
    "ཁྱོད་གཙོ་བོའི་སྒྲ་དོན་དངོས་པོའི་ཉེར་ལེན་ཅན་དུ་མེད་པར་སྒྲུབ་དགོས་ཀྱི་ཕྱིར་རྒོལ་གྱི་བློ་ངོར་མ་དམིགས་པའི་རྟགས་ཀྱི་བསྒྲུབ་བྱ་མིན་པར་ཐལ།",
    "དེ་ལ་དོན་བྱེད་པ་དོན་གཉེར་གྱིས་བརྟགས་པས་ཅི་ཞིག་བྱ་སྟེ་དཔྱད་བྱའི་རང་མཚན་མ་ཡིན་པར་ཐལ།",
    "ལུང་གིས་མ་ཁྱབ་པའི་ཤེས་བྱ་མེད་པས་དེ་ལོག་པས་ཇི་ལྟར་མེད་ངེས་གོ་བྱེད་མིན་ཞེ་ན།",
    "ངག་སྔ་ཕྱི་རྣམས་བླང་དོར་བཏང་སྙོམས་སུ་བྱ་བ་ལྟ་བུའི་དོན་གཅིག་ལ་བསྡུར་བཏུབ་པས་ཚིག་གི་དོན་ཕན་ཚུན་འབྲེལ་ཆགས་པས་འབྲེལ་བ་དང་ནི་སྐྱེས་བུའི་འདོད་བྱའི་འབྲས་བུ་དང་རྗེས་སུ་མཐུན་པའི་ཐབས་ནུས་པ་ཅན་སྟོན་པ་དང་སྐྱེས་བུའི་དོན་མངོན་མཐོ་ངེས་ལེགས་ནི་བརྗོད་པར་བྱེད་པ་ལ་དཔྱད་པ་གསུམ་གྱིས་ཡོངས་སུ་དག་པའི་ངག་ཡིན་པ་གཅིག་ཤིན་ཏུ་ལྐོག་གྱུར་གྱི་དོན་ལ་མི་སླུ་བའི་དེ་ལས་གཞན་པའི་ངག་ནི་དེ་ལ་སླུ་བའི་ཕྱིར་རོ།",
    "སྐྱེས་བུའི་དོན་གྱི་ནུས་པ་མེད་པ་བྱ་རོག་གི་སོ་བརྟགས་པ་ལྟ་བུ་ལུང་ཡང་དག་ཡིན་པ་གཅོད་དོ།",
    "ཇི་ལྟར་མངོན་སུམ་དང་དངོས་པོ་སྟོབས་ཞུགས་རྗེས་དཔག་གི་ཡུལ་ལ་མི་སླུ་བ་དེ་ལྟར་ཤིན་ཏུ་ལྐོག་གྱུར་ལའང་མི་སླུ་བར་སྤྱི་ལས་ཏེ་མཚུངས་ཏེ།",
    "དཔེར་ན་མངོན་སུམ་རྗེས་དཔག་གི་ཡུལ་ལུང་ལས་རྟོགས་པ་ལྟ་བུའོ།",
    "དེས་བྱས་པའི་ཚིག་ནི་རང་གིས་བསྟན་པ་ཇི་ལྟ་བ་བཞིན་གྱི་བརྗོད་བྱའི་དོན་ལ་མི་སླུ་བ་ཉིད་དུ་རྒོལ་བ་གཞན་གྱིས་རབ་ཏུ་ཤེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་སྐྱེས་བུ་ཕུལ་དུ་བྱུང་བ་དེ་སྐྱེས་བུས་ངེས་པར་ཤེས་པར་ནུས་ན་དེས་བྱས་པའི་ལུང་བརྗོད་བྱའི་དོན་ལ་མི་བསླུ་བའི་དོན་འདི་ཁོ་བོ་ཅག་འདོད་པ་ཁོ་ན་ཡིན་གྱི་དེ་ལྟ་བུ་སྤོང་བར་མི་བྱེད་མོད།",
    "ཉེས་པ་བསྐྱེད་པའི་ཕྱིར་འབད་རྩོལ་ཡོད་དུ་ཟིན་ཡང་འཚེ་བ་མེད་སོགས་གསུམ་ལས་ཕྱིན་ཅི་ལོག་འཚེ་བ་ཅན་དང་ཕྱིན་ཅི་ལོག་གི་དོན་ཅན་སེམས་ཀྱི་རང་བཞིན་མ་ཡིན་པའི་ཉེས་པ་དག་གིས་རྒྱུན་མི་བཟློགས་ཏེ་སྤང་བྱ་ལ་ཡོན་ཏན་མཐོང་བའམ་གཉེན་པོ་ལ་སྐྱོན་མཐོང་བ་མི་སྲིད་པས་དེ་དང་ལྡན་པའི་སྐྱེས་བུའི་བློ་ནི་ཉེས་པ་བསྐྱེད་པའི་རྩོལ་བ་དོར་ནས་གཉེན་པོ་དེའི་ཕྱོགས་འཛིན་པས་གཉེན་པོ་ཁོ་ན་ལ་འབད་རྩོལ་བྱེད་པའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་གིས་འཇིག་པ་དུ་མ་ཚོགས་པ་ལ་རྟག་གཅིག་ཏུ་ལྟ་བ་ལས་སྐྱེ་བ་ཡིན་ཏེ།",
    "བདག་དང་བདག་གིར་ཞེན་པ་ལས་བྱུང་བའི་ཕྱིར།",
    "འཇིག་ལྟ་དེ་མ་རིག་པ་ཡིན་པས་ན་འགལ་བ་མེད་དོ་ སྐྱེ་བའི་གོ་རིམ་ཡང་ཐོག་མེད་ནས་གོམས་པ་ལས་བདག་གིར་ལྟ་བ་སྐྱེ་ཞིང་།",
    "དེས་བདག་དང་བདག་གིར་ཞེན་པའི་ཡུལ་དེ་ལ་བདག་གི་བ་དེར་ཆགས་པ་སྐྱེ་ལ།",
    "བདག་དང་བདག་གིར་ཆགས་པ་དེ་ལས་བདག་དང་བདག་གི་བའི་མི་མཐུན་ཕྱོགས་ལ་ཞེ་སྡང་ལ་སོགས་པས་ང་རྒྱལ་དང་ཐེ་ཚོམ་འབྱུང་ངོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ནི་མ་རིག་པའི་རྒྱུ་ཅན་ཡིན་ཞེས་སོ།",
    "བདེན་པའི་དོན་ཅན་དུ་ཐལ།",
    "ལོག་པའི་དོན་ཅན་ཅིའི་ཕྱིར་མིན་ཏེ་ཡིན་པར་ཐལ།",
    "དང་པོ་ལ་གཉིས་ཀྱི་དང་པོ་བརྡ་ལ་ལྟོས་པས་ལོག་པ་སྟོན་པར་ཐལ་བ་ནི།",
    "སྐྱེས་བུས་བྱས་པ་མིན་དུ་ཆུག་ན་ཡང་དོན་ཕྱིན་ཅི་ལོག་སྟོན་པ་ཉིད་དུ་སྲིད་པར་ཐལ།",
    "དེས་དོན་གོ་ཞིང་ཤེས་པར་བྱེད་པ་དག་གི་རྒྱུ་བརྡ་ནི་སྐྱེས་བུས་བྱས་པ་ལ་བརྟེན་པའི་ཕྱིར།",
    "གཉིས་པ་སྒྲ་དོན་ངོ་བོ་ཉིད་ཀྱིས་འབྲེལ་བ་དགག་པ་ལ་གཉིས་ཀྱི་དང་པོ་ཧ་ཅང་ཐལ་བས་དགག་པ་ནི།",
    "འདོད་པ་དང་འགལ་བའི་དོན་གསལ་བར་བྱེད་པ་ཡིན་སྲིད་པར་ཐལ།",
    "རང་བཞིན་འབྲེལ་བ་ཡང་ཡོད་པ་དེ་རྣམ་པར་བཞག་པའི་ཕྱིར་གཏན་ཚིགས་བརྗོད་དགོས་པར་ཐལ།",
    "ཕན་ཚུན་གཅིག་གཅིག་གི་ངོ་བོ་མིན་པས་བདག་མི་གཅིག་ཅིང་རྟག་པའི་ཕྱིར་བརྗོད་འདོད་དང་ཕྱི་རོལ་གྱི་དོན་གང་དང་ཡང་དེ་བྱུང་དུ་མ་འབྲེལ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་བརྟེན་པའི་འབྲེལ་བ་ལ་རྟག་པ་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "སྐྱེས་བུའི་བློ་ཡིས་ལེགས་པར་བཞག་པར་བྱས་པར་ཐལ།",
    "ཐལ་བ་སྔ་མ་འདོད་ན་སྒྲ་དོན་སྔ་མ་ཞིག་པའི་ཚེ་ན་འབྲེལ་བའང་ཞིག་པས་དོན་སྔར་མེད་ལ་འབྲེལ་བ་མེད་པས་དེ་མི་གོ་བར་འགྱུར་རོ།",
    "གསལ་བྱེད་གསལ་སོགས་རང་གི་ཕན་འདོགས་པའི་དོན་ཅི་བྱས་ཏེ་མ་བྱས་པའི་ཕྱིར་ཏེ།",
