    "དམ་ཚིག་གི་ཁུ་ཚུར་གྱིས་གཟུང་བའི་རྡོ་རྗེ་རྩེ་ལྔ་པའི་ཕྱག་རྒྱ་ཉིད་འདིར་བཅིངས་པའི་དབྱིབས་ཡིན་ནོ།",
    "གང་གི་ཕྱིར།",
    "དེ་དག་གི་ཕྱིར་ནི་རྒྱུར་ཏེ།",
    "རྡོ་རྗེ་འབེབས་པའི་ཕྱག་རྒྱ་བཅིངས་ནས་བཛྲ་མུཥྚི་ཞེས་བྱ་བས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "རྡོ་རྗེ་འབེེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "དེ་ནས་བཛྲ་མུཥྚི་ཞེས་བྱ་བས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "དེ་བས་ན་བདག་གི་རྡོ་རྗེ་ཁུ་ཚུར་བཅིངས་པའི་༤ཚུལ་འདི་ནི་ཆེ་ཞིང་བརྟན་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནས་རྡོ་རྗེ་འབེེབས་པའི་མཐར་ཐུག་པའི་བར་གྱི་རེ་རེ་ཞིང་ཡང་༥གྱུར་ཏོ་ཞེས་བྱ་བ་བསྟན་པའི་ཕྱིར།",
    "རང་གི་ཐུགས་ཀ་ནས་བྱུང་བ་ནི་ཕྱུང་བར་གྱུར་པའོ།",
    "དེའི་སྟེང་གི་རྡོ་རྗེ་རྩེ་ལྔ་པ་ནི་སེམས་དཔའི་རྡོ་རྗེའོ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་པས་རྩེ་མོ་མཚན་པའི་ཡིད་བཞིན་གྱི་ནོར་བུ་ནི་རྡོ་རྗེ་རིན་ཆེན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རང་གི་ཕྱག་རྒྱ་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཅེས་བྱ་བ་སྟེ་གང་གི་ཕྱིར་འདོད་ཆགས་ཏེ་ཞེན་པའི་མཚན་ཉིད་ཡིན་ཡང་དྲི་མ་ཐམས་ཅད་དང་བྲལ་བས་ཤིན་ཏུ་དྲི་མ་མེད་པ་ཡིན་པ་འདི་ནི་ངོ་མཚར་ཆེའོ།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་གདོན་མི་ཟ་བར་གྲུབ་པས་རང་གི་ཕྱག་རྒྱ་འདི་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ལ་ཕྱག་རྒྱས་༥བཏབ་སྟེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྤྱི་བོར་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རྡོ་རྗེ་རྩེ་མོ་བཅུ་གཉིས་པའི་ལས་ཀྱི་རྡོ་རྗེ་བསྐྱེད་པ་ནི་རྒྱས་བཏབ་པའོ།",
    "ཐམས་ཅད་དུ་རྩེ་མོ་བལྟས་པ་ཞེས་བྱ་བ་ནི།",
    "རྡོ་རྗེ་རྩེ་གསུམ་པའི་རྩེ་མོ་རེ་རེ་ཞིང་ཕྱོགས་བཞི་ཆར་དུ་ཁ་བལྟས་པར་གནས་པའི་ཕྱིར་རོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྷ་མོ་ཆེན་མོ་འདི་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་ཀྱི་ལྷ་མོ་ཞེས་བྱ་བ་ནི།",
    "དེའི་ལྷ་མོ་ཡང་ཡིན་ལ་ཆེན་པོ་ཡང་ཡིན་པས་ན་ལྷ་མོ་ཆེན་མོ་སྟེ།",
    "དེའི་བཙུན་མོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་ལྷ་མོ་ཆེན་མོ་རྡོ་རྗེ་སྒེག་མོས་ཆེད་དུ་བརྗོད་པ་འདི་༤།",
    "རང་གི་དངོས་པོ་ཐམས་ཅད་རྡོ་རྗེ་སེམས་དཔའ་དང་འདྲ་ཞིང་ཞེས་བྱ་བ་ནི་བདག་ཉིད་ཀྱི་དངོས་པོ་ཐམས་ཅད་ཕལ་ཆེར་རྡོ་རྗེ་སེམས་དཔའ་དང་འདྲ་ཞིང་རྗེས་སུ་མཐུན་པ་ཁྱེགང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "གཟུགས་སྣ་ཚོགས་པ་ནི་ཡན་ལག་གི་དབྱིབས་རྣམས་སོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལྷ་མོ་ཞེས་བྱ་བ་ནི་བསྡུས་སྣཔའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྷ་མོ་ཆེན་མོ་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་ཀྱི་ལྷ་མོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་ཐམས་ཅད་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ལྷ་མོ་ཆེན་མོ་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེའི་ལྷ་མོ་ཆེན་མོ་ནི་བཙུན་མོའི་དོན་ཏེ།",
    "སྔ་མ་བཞིན་དུ་བལྟ་བར་བྱས་ཏེ་ལྷ་མོ་ཆེན་མོ་དེ་བྱུང་བའོ།",
    "ལྷ་མོ་ཆེན་མོས་ཆེད་དུ་བརྗོད་པ་འདི་ཆེད་དུ་བརྗོད་དོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་ལྷ་མོ་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་ཀྱི་ལྷ་མོ་ཆེན་མོ་ཞེས་བྱ་བ་ནི་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་༨ ཐམས་ཅད་བསྐྱེད་པ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདེ་བ་དང་ཡིད་བདེ་བ་བླ་ན་མེད་པའི་རྒྱུན་གང་ཡིན་པ་དེའི་དམ་ཚིག་ནི་དེའི་རང་བཞིན་ཏེ་སྒེག་མོའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་གྱིས་ཚིགས་སུ་བཅད་པ་ཇི་སྐད་དུ་གསུངས་པ་བཞིན་ཡང་དག་པར་གླུར་་བྱེལེན་པའི་གླུ་ནི་ལྷ་མོ་རྡོ་རྗེ་གྲུ་མའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གཡོག་མོའི་གཙོ་མོ་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཡོག་མོའི་གཙོ་བོ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ངོ་བོའོརྨྱེ།",
    "ཇི་ལྟར་འཇིག་རྟེན་ན་རྔུགྲགས་པའི་གཡོག་མོས་གང་ལ་བརྟེན་པའི་དཔོན་པོ་དེའི་འཇིག་རྟེན་པའི་བདེ་བ་དང་ཡིད་བདེ་བ་བསྐྱེད་པ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་ཀྱང་།",
    "ལྷ་མོ་རྡོ་རྗེ་བདུག་ཟུཔ་མའི་ལུས་སུ་གྱུར་ཏེ་ཆེད་དུ་བརྗོད་པ་འདི་ཧཱུཾཆེད་དུ་བརྗོད་ཅེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གསོལ་ཀ་ཙུམ་འདི་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་འདི་ཡང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་སྒེག་མོ་ལ་སོགས་པའི་བཙུན་མོའི་དབུས་ན་བཞུགས་པའི་ཡང་དག་པའི་ལྟ་བའི་རལ་གྲི་ཐོགས་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་མེ་ཏོག་གི་ལྷ་མོར་གྱུར་ནས་ཆེད་དུ་བརྗོད་པ་འདི་ཅིཆེད་དུ་བརྗོད་དོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མེ་ཏོག་གི་ཁང་པ་བརྩེགས་པ་༦ལ་སོགས་པའི་ཚུལ་ལོ།",
    "རྡོ་རྗེ་མེ་ཏོག་གི་ལྷ་མོའི་སྐུར་གྱུར་ནས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་མེ་ཏོག་གི་ཆར་འབེེབས་པས་ཉེ་བར་མཚོན་པའི་ལྷ་མོའི་སྐུའོ།",
    "དེའི་དོན་ནི་འདི་ཡིན་ཏེ་ཐ་མི་དད་པར་གྱུར་པ་དག་བྱེགིས།་",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཕོ་ཉ་མོ་འདི་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ལྷ་མོ་རྡོ་རྗེ་སྣང་བ་ཞེས་བྱ་བའི་སྐུར་གྱུར་ནས་ཆེད་དུ་བརྗོད་པ་འདི་ཆེད་དུ་བརྗོད་དོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ལྷ་མོ་རྡོ་རྗེ་སྣང་བ་ཞེས་བྱ་བའི་སྐུར་གྱུར་ནས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་སྣང་བས་ཉེ་བར་མཚོན་པའི་ལྷ་མོའི་སྐུར་གྱུར་པའོ།",
    "གདུལ་བྱ་རྣམས་ཀྱིས་བདག་ལས་ཐ་དད་པར་མཐོང་གི།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གདོན་མི་ཟ་བར་བྱེ་༧གྲུབ་པས་བྲན་མོ་འདི་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བྲན་མོ་ཞེས་བྱ་བ་ནི།",
    "ལྷ་མོ་རྡོ་རྗེ་དྲི་ཞེས་བྱ་བའི་སྐུར་གྱུར་ནས་ཆེད་དུ་བརྗོད་པ་འདི་ཆེད་དུ་བརྗོད་དོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ལྷ་མོ་རྡོ་རྗེ་དྲི་ཞིམ་ཞེས་བྱ་བའི་སྐུར་གྱུར་ནས་ཞེས་བྱ་བ་ནི་དྲིས་ཉེ་བར་མཚོན་པའོ།",
    "ཁོ་མོ་ནི་འདི་ལྟ་བུ་མ་ཡིན་ནོ།",
    "འདི་དག་ནི་ཇི་སྐད་དུ་གསུངས་པའི་གཡོག་མོ་ལ་སོགས་པའི་ཚུལ་དུ་གྱུར་པས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཕྱག་རྒྱའི་ཚོགས་ཐམས་ཅད་ཀྱི་བདག་པོ་འདི་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དམ་ཚིག་གི་ལྕགས་ཀྱུ་༡ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱང་ཡིན་ལ་དམ་ཚིག་གི་ལྕགས་ཀྱུ་ཡང་ཡིན་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ལྕགས་ཀྱུ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དམ་ཚིག་གིས་སྤྱན་འདྲེན་ཅིང་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནི་ཤར་ལ་སོགས་པ་སྒོར་ཉེ་བར་མཛད་ཅིང་༢།",
    "གང་གིས་དེ་རྣམས་དང་ཐ་དད་པའི་ཚུལ་དུ་སྤྱན་དྲངས་པ་འདི་ནི་ངོ་མཚར་ཆེའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་༦གསོལ་ཀ་བ་འདི་རང་གི་ཐུགས་ཀ་ནས་ཕྱུང་ངོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཅེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་རང་གི་སྒོ་ནས་འཇུག་པར་མཛད་ཅིང་ཆེད་དུ་བརྗོད་པ་འདི་ཆེད་དུ་བརྗོད་པར་འགྱུར་རོ།",
    "བདག་གིས་སླར་ཡང་དྲང་བར་བྱ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ལྕགས་སྒྲོག་ཅེས་བྱ་བ་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་དི་འདའ་བར་མི་བྱའོ།",
    "དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ལྕགས་སྒྲོག་སེམས་དཔའ་ཆེན་པོའི་དམ་ཚིག་ལས་བྱུང་བ་རྡོ་རྗེ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རང་གི་རྣལ་འབྱོར་གྱི་གནས་ན་བཞུགས་པ་རྣམས་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་བསམ་གཏན་གྱི་ཕོ་ཉ་འདིས་ཐག་རིང་ན་གནས་པའི་དངོས་པོ་ཐམས་ཅད་གཟིགས་པས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་ནི་འདའ་བར་མི་བྱ་བའི་བསྡམས་པའི་ཕྱག་རྒྱ་ནི་ལྕགས་སྒོག་གི་ཕྱག་རྒྱའོ།",
    "ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་ལྕགས་སྒོག་གི་ཕྱག་རྒྱས་ཉེ་བར་མཚོན་པའི་ཕྱིར།",
    "ཉོན་མོངས་པ་བག་ཆགས་དང་བཅས་པ་སྤངས་པས་འཆིང་བ་ལས་གོལ་བ་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་།",
    "དེ་རྣམས་དང་ཐ་དད་པ་ལྟ་བུ་དེ་རྣམས་བདག་གིས་བཅིངས་པར་ཤེས་པ་འདི་ནི་ངོ་མཚར་ཆེའོ།",
    "གདུལ་བྱས་༢དེ་ལྟར་མཐོང་གི་བདག་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་ཚོགས་སུ་གྱུར་ནས་ཞེས་བྱ་བ་ལ།",
    "རྣོན་པོས་དེ་རྣམས་ཀྱི་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་བཅད།",
    "སྒེག་མོ་ལ་སོགས་པ་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་སྦྱིན་པ་དང་།",
    "རེ་རེ་ཞིང་ཡང་བསྐྱེད་པ་དང་།",
    "དེ་ནས་རང་གི་གནས་སུ་ཞུགས་ཏེ་ཆེད་དུ་བརྗོད་པ་དང་།",
    "རྡོ་རྗེ་འབེེབས་པའི་བར་གྱི་གཞུང་གིས་ནི།",
