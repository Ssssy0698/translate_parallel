    "དེ་བཞིན་དུ་ལག་པ་ས་ལ་རེག་པར་བྱས་ནས་རྡོ་རྗེ་སེམས་དཔའ་དང་།",
    "སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་དུ་འདུག་སྟེ།",
    "ཚུལ་འདིས་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་དུ་འདུག་པ་ལས་ལངས་ནས་ཡོངས་སུ་བསྐོར་བར་བྱའོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་ཀྱིས་བཛྲ་སཏྭ་ཞེས་ཟློས་ཤིང་བདག་ཉིད་ཀྱང་བྱེན་གྱིས་བརླབས་ལ།",
    "ཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་ཆེན་མོ་མ་བཀྲོལ་བས་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་བཤིག་ལ་ལངས་ཏེ།",
    "རྐང་མཐིལ་གྱིས་ཡོངས་སུ་བཟུང་ཆོབས་ས་བཞི་༥བརྟན་པ་ནས་བརྩམས་ཏེ་རི་རབ་ཀྱི་སྟེང་གི་བར་དུ་རྡོ་རྗེའི་རང་བཞིན་དུ་བྱེད་ཅིང་།",
    "དེ་ནས་ཉི་མ་འཆར་བའི་དུས་སུ་དཀྱིལ་འཁོར་དེ་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་ཀྱིས་ནམ་མཁར་བཞག་ལ་ཐིག་གིས་ཐིག་གདབ་པར་བྱའོ།",
    "ཚད་དང་ལྡན་པ་ཞེས་བྱ་བ་ནི་དཀྱིལ་འཁོར་ཁྲུ་དྲུག་པ་ལ་སྦོམས་སུ་མཐེའུ་ཆུང་གི་ཚད་ལ་ཆུར་དཀྱིལ་འཁོར་ཉིས་འགྱུར་གྱི་ཚད་ཀྱིས་སོ།",
    "མཛེས་པའི་ཐིག་གིས་ཞེས་བྱ་བ་ནི་ཚོན་སྣ་ལྔ་པོས་ལྟ་ན་སྙུག་པའི་ཐིག་གིས་ཐིག་གདབ་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཤར་དང་ནུབ་དང་བྱང་དང་ལྷོའི་ངོས་ཀྱི་རི་མོས་ཟུར་བཞིར་བྱས་པའི་ཕྱིར་གྲུ་བཞིའོ།",
    "སྒོ་བཞི་དང་ཞེས་བྱ་བ་ནི་ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་གི་ངོས་ཀྱི་དབུས་སུ་རེ་རེ་ཞིང་སྒོ་བཏོད་རི་༡པ་ཡོད་དེ་དེས་ན་སྒོ་བཞིའོ།",
    "དེ་རྣམས་ཀྱི་མཚམས་ནི་རི་མོ་གཉིས་ཕྲད་པའི་ཚུལ་ཏེ།",
    "རྡོ་རྗེ་ཐིག་གིས་ཡོངས་བསྐོར་༤བར།",
    "ཞེས་བྱ་བ་ནི་ཕྱོགས་ཀྱི་ཆ་རེ་རེ་ཞིང་རྩིག་པ་ལ་བརྟེན་པའི་རྡོ་རྗེ་ཀ་བ་གཉིས་གཉིས་ཡོད་པ་དེའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཀ་བ་རྣམས་ཀྱི་མཆོག་སྟེ་གནས་དམ་པ་ཡིན་པས་ན་རྡོ་རྗེ་ཀ་བའི་མཆོག་གི་གནས་སུའོ།",
    "རྡོ་རྗེ་ཀ་བའི་མཆོག་གི་གནས་དེ་རྣམས་སུ།",
    "ཡང་རེ་རེ་ཞིང་ཟླ་བའི་དཀྱིལ་འཁོར་ལྔ་ལྔ་ཡོད་པའི་རྡོ་རྗེ་རི་མོས་ཡོངས་སུ་བསྐོར་བར་ཐིག་བཏབ་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྡོ་རྗེ་རྩེ་མོ་ལས་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཆ་བགོ་བ་མཛད་པ་ཡིན་པས་ཐེ་ཚོམ་མི་བྱའོ།",
    "རྡོ་རྗེ་ཐིག་གིས་ཡོངས་བསྐོར་བར།",
    "ཡང་ཐིག་གི་ཆོ་ག་གསལ་བར་བྱས་ཏེ།",
    "བུ་མོ་གཙང་མས་བཀལ་བའི་སྲད་བུ།",
    "ཧཱུཾ་ཊྭཱཾ་སྠཱ་ཨ་དུཨཱ་ཞེས་བྱ་བའི་རང་གི་ས་བོན་གྱིས་མི་བསྐྱོད་པ་ལ་སོགས་པ་སྲད་བུ་ལ་བཀོད་དེ།",
    "མིག་གི་རྫི་མ་འདྲེན་པ་ནི།",
    "དེ་ནས་མི་བསྐྱོད་པ་ལ་སོགས་པ་རང་རང་གི་ས་བོན་གྱི་འོད་ཀྱིས་སྲད་བུ་བཏང་བ་འབར་བའི་ལྟ་བས་བཀུག་ལ།",
    "རང་གི་ལག་ན་གནས་པའི་སྲད་བུ་བཀང་ནས།་",
    "མེ་ཏོག་གིས་ཀུན་ནས་མཛེས་པར་བྱས་ནས་བར་སྣང་ན་བཞུགས་པའི་རིགས་ཐམས་ཅད་ལ་མཆོད་ཡོན་ཕུལ་ཏེ།",
    "དེ་ལ་རེ་ཞིག་ཚོན་ཁ་དོག་དཀར་པོ་དྲི་ཞིམ་པ་ལ།",
    "སྒྲུབ་པའི་གྲོགས་མཆོག་གི་ལག་པར་ཐིག་གཏད་ལ།",
    "དེ་ཉིད་དུ་འདུག་ལ་ཤར་དུ་བལྟས་ཏེ་བྱང་གི་ཐིག་གདབ་པར་བྱའོ།་།",
    "དེ་ལྟར་ན་ཕྱིའི་དཀྱིལ་འཁོར་དང་ནང་གི་དཀྱིལ་འཁོར་ཀུན་དུ་ཐིག་བཏབ་ནས་བྱང་དུ་བལྟས་ཏེ་ཤར་གྱི་ཀ་བའི་ཐིག་གདབ་བོ།",
    "ཤར་དུ་བལྟས་ཏེ་བྱང་གི་ཀ་བའི་ཐིག་གདབ་བོ།",
    "ཛ་ཛ་ཛ་ཞེས་བྱ་བ་ཛ་གསུམ་གྱིས་བྱེ་སྒྲུབ་པའི་གྲོགས་ཏྲེམཆོག་གིས་ཐིག་དྲང་བར་བྱའོ།",
    "ནང་གི་དཀྱིལ་འཁོར་ནི་ཕྱིའི་དཀྱིལ་འཁོར་གྱི་ཕྱེད་ཀྱི་ཚད་ལ་སྒོ་བཞི་པ་ཟུར་བཞི་པ་ཁ་ཁྱེར་གྱིས་ཡོངས་སུ་བསྐོར་བའི་ཀ་བ་བརྒྱད་དང་ལྡན་པར་ལེགས་པར་ཐིག་བཏབ་ནས་སེང་ལྡེང་གི་ཕུར་བུ་སྨད་རྡོ་རྗེ་རྩེ་གཅིག་པ་ལྟ་བུ།",
    "དེ་ལ་བརྟོད་༧པའི་སྲད་བུས་ནང་གི་དཀྱིལ་འཁོར་གྱི་ཕྱི་རིམ་དུ།",
    "རྡོ་རྗེ་ཤུགས་ཀྱིས་སོང་ནས་ནི།",
    "ཡིད་ཀྱིས་རི་མོ་བཏེག་ནས་ནི།",
    "རྡོ་རྗེ་ལྷ་མོ་རྣམས་ཀྱང་གཞག།",
    "ཅེས་བྱ་བ་ནི་ནང་གི་དཀྱིལ་འཁོར་གྱི་མཚམས་མེའི་ཕྱོགས་ནས་བརྩམས་ཏེ།",
    "སྒེག་མོ་དང་།",
    "ཞེས་བྱ་བ་ནི་ཀུན་གྱི་ཞེས་བྱ་བའི་ཚིག་གིས་ཕྱི་དང་ནང་ཐམས་ཅད་ཀྱི་ཤར་ཕྱོགས་ཀྱི་སྒོར་རྡོ་རྗེ་ལྕགས་ཀྱུ།",
    "སེང་གེའི་གདན་ལ་པདྨ་དང་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་ན་པྱརྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ་ཉི་མའི་འོད་མངའ་བ།",
    "ཞལ་དང་པོ་ཤར་དུ་གཟིགས་པའོ།་།",
    "ནམ་མཁའ་ལྡིང་གི་ཁྲི་ལ་པདྨ་དང་ཟླ་བའི་སྟེང་ན་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "རྡོ་རྗེ་ལས་མ་༥ནི་སྣ་ཚོགས་རྡོ་རྗེ་རྩེ་མོ་བཅུ་གཉིས་པ་ཁ་དོག་ལྔ་པ་སྟེ།",
    "ཕྱག་གཡས་པ་ཁ་ཊྭཱཾ་བྱེགའི་ཕྱག་རྒྱར་བཞག་པའི་གུང་མོ་ལ་དང་པོའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་རང་གི་ཐུགས་ཀར་བསྟོད་པའི་ཚུལ་ཀྱིས་བསྣམས་པའོ།",
    "ཕྱག་གཡས་པས་དེའི་འདབ་མ་རང་གི་ཐུགས་ཀར་འབྱེད་པའོ།",
    "རྡོ་རྗེ་རྣོན་པོ་ནམ་མཁའ་ལྟར་སྔོ་བསངས་ཕྱག་གཡོན་གྱིས་རང་གི་ཐུགས་ཀར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གླེགས་བམ་བསྣམས་པ།",
    "ཕྱག་གཡས་ཀྱི་གུང་མོ་ལ་སྣ་ཚོགས་རྡོ་རྗེ་རང་གི་ཐུགས་ཀར་བསྟོད་པའི་ཚུལ་གྱིས་བསྣམས་པའོ།",
    "དམ་ཚིག་གི་ཁུ་ཚུར་གྱིས་བཙིར་ལྐུཞིང་བཞུགས་པའོ།་།",
    "ཕྱག་གཡས་ཀྱིས་མེ་ཏོག་གི་ཆར་འབེབས་པར་མཛད་པའོ།",
    "ཞི་བའི་གཟིགས་སྟངས་དང་།",
    "ཕྱོཡ་པ་རི་བཱ་རེ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་ནི་བསྐལ་པ་བཟང་པོ་རྣམས་ཀྱི་སྤྱིའི་རིག་པ་ཡིན་ནོ།",
    "བླངས་ལ་རང་གི་མགོ་ལ་བཅིང་བར་བྱའོ།",
    "རྡོ་རྗེ་ཞགས་པའི་ལས་ཀྱི་ཕྱག་རྒྱས་༧རང་རང་གི་སྒོ་ནས་རང་རང་གི་གནས་སུ་གཞུག་༩པར་བྱའོ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་གི་ལས་ཀྱི་ཕྱག་རྒྱས་ཉུ།",
    "ལས་ཆེན་མཆོག་གི་ཕྱག་རྒྱ་ཡིས།",
    "ལས་ཆེ་མཆོག་ཀྱང་ཡིན་ལ་ཕྱག་རྒྱ་ཡང་ཡིན་པས་ལས་ཆེ་ཇེམཆོག་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་རྩེ་མོ་ལ་སོགས་པ་ལས་གསུངས་པ་ལེགས་པར་དྲངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་༧སྣང་མཛད་ལ་སོགས་པ་རེ་རེ་ཞིང་སོ་སོར་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་གསུངས་ལ་༨།",
    "དམ་ཚིག་མཆོག་གི་ཕྱག་རྒྱ་དང་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་བལྟ་བར་༢བྱས་ནས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་འབེེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་བཛྲ་ཨཱ་བེ་ཤ་དྲྀ་ཤྱ་ཛ་ཧཱུཾ་བཾ་ཧོ་ས་མ་ཡ་སྟེ་ས་མ་ཡ་སྟེ་ཨ་ཧཾ་བཛྲ་ཨ་༦བེ་ཤ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཕྱག་རྒྱ་ཆེན་པོས་གཞག་པར་བགྱི་ཞེས་བྱ་བ་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ཡང་དག་པར་བསྒྲུབས་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱས་།",
    "སེམས་དཔའ་ཆེན་པོ་དེ་བསྒོམ་མོ།",
