    "རིགས་དབྱེ་དེ་ཡི་ཁྱད་པར་ནི།་།",
    "དེས་ན་ཐ་དད་རྣམ་པར་གནས།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ཤེས་པ་འདི་གཉིས་ནི་དངོས་ལས་མ་སྐྱེས་པའི་ཕྱིར་དེར་སྣང་བ་ཉིད་མ་ཡིན་ཡང་དེ་ལས་སྐྱེས་པའི་ཕྱིར་དེར་འཁྲུལ་པ་མེད་པ་དག་ཡིན་ཏེ།",
    "མེད་པར་ངེས་པའི་འབྲས་བུ་ཅན་མ་དམིགས་མེད་པའི་ཐ་སྙད་འཇུག་པའི་འབྲས་བུ་ཅན་གྱི་མི་དམིགས་པ་ནི་དེ་ལ་མི་འཁྲུལ་པ་ཡིན་ཏེ།",
    "མི་དམིགས་པའི་རྟགས་ཀྱིས་མེད་པ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན།",
    "དམིགས་པ་མེད་པ་ཡང་མི་དམིགས་པ་གཞན་གྱིས་བསྒྲུབ་པར་བྱ་དགོས་པས་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར།",
    "མི་རྟོགས་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་དམིགས་པ་མེད་པ་མི་དམིགས་པ་མེད་པར་འགྱུར་ན་ནི།",
    "དེ་བཞིན་དུ་ཡོད་པ་མེད་པར་ཡང་འགྱུར་བས་མི་དམིགས་པ་དོན་མེད་དོ།",
    "སྒྲ་དང་ཐ་སྙད་དག་རྟོགས་པའམ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་དཔེ་མ་གྲུབ་པར་རྒོལ་བ་ཡང་བསལ་བ་ཡིན་ཏེ།",
    "མི་དམིགས་པ་ནི་དམིགས་པ་ལོག་པ་ཡིན་ན་ཇི་ལྟར་དངོས་པོ་མེད་པ་ཡིན་དམིགས་པ་ལོག་པས་དངོས་པོ་མེད་པར་ཡང་ཇི་ལྟར་འགྱུར་ཏེ།",
    "རྒྱུ་གཞན་ཚང་བ་ན་དམིགས་པར་རུང་བའི་རང་བཞིན་ཡོད་པ་ནི་དེ་ལ་མི་འཁྲུལ་བའི་ཕྱིར་དམིགས་པ་ནི་ཡོད་པ་ཡིན་པར་བྲྗོད་དོ།",
    "ཚོགས་པ་ཡོངས་སུ་འགྱུར་བ་ལ་ལྟོས་པའི་ཕྱིར་འཁྲུལ་པར་འགྱུར་ཞེ་ན།་",
    "འབྲས་བུའི་དུས་ན་མེད་པར་རྟོགས་པའི་ཕྱིར་ཏེ།",
    "དམིགས་པ་ན་དེ་མི་དམིགས་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "མཐུ་དང་ལྡན་པས་བྱིན་གྱིས་བྲླབས་པའི་ཕྱིར་ཡོད་ཀྱང་དམིགས་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "གཉི་ག་གཞན་དུ་འགྱུར་བ་མེད་པར་བྱིན་གྱིས་བྲླབས་པ་ཉིད་མི་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་འདུས་བྱས་ན་ནི་མི་དམིགས་པར་འགྱུར་ཏེ།",
    "དེས་ཀྱང་ཡུལ་ཅན་སྒྲུབ་པར་བྱེད་དོ།",
    "དེ་ལ་ཡང་ཐ་སྙད་དེའི་མཚན་ཅན་ཡིན་པར་གྲུབ་ཀྱང་དེའི་རྒྱུ་ཡོད་པའི་སྒོ་ནས་ཀྱང་མི་དམིགས་པས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "འདི་ནི་འོག་ཏུ་འཆད་པར་འགྱུར་རོ།",
    "མི་འགལ་བ་ནི་ལྷན་ཅིག་ཡོད་པར་འགལ་བ་མེད་པས་འགོག་པ་མ་ཡིན་ནོ།་།",
    "འགལ་བ་ཡང་མི་དམིགས་པ་མེད་པར་འགལ་བ་མི་རྟོགས་ཏེ།",
    "དེ་ལ་ཡང་གཅིག་དམིགས་པས་གཞན་མི་དམིགས་པར་བྲྗོད་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་དམིགས་པ་མ་བཀག་པ་ཅན་མེད་པར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "གཅིག་བཀག་པས་གཞན་མེད་པར་བསྒྲུབ་པ་ལ་མི་དམིགས་པ་གྲུབ་ཉིད་དེ་དགག་པ་ནི་མི་དམིགས་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "དོན་གཞན་དགག་པ་བསྒྲུབ་པར་བྱ་བ་དེ་ལ་ཡང་རྒྱུ་དང་འབྲས་བུ་དག་གམ།",
    "དེ་ལ་གཉི་ག་མ་ཡིན་པ་ནི་འབྲེལ་པ་མེད་པའི་ཕྱིར་དེ་མེད་པའི་ཕྱིར་མེད་པས་གཞན་མེད་པར་མི་རིགས་སོ།",
    "འབྲས་བུ་མི་དམིགས་ཀྱང་རྒྱུ་ནི་གདོན་མི་ཟ་བར་དེ་དང་ལྡན་པ་ཡིན་པའི་ཕྱིར་དེ་མེད་པར་ག་ལ་འགྱུར།",
    "རྒྱུའི་རྫས་སྤྱི་ལ་བསམས་ནས་འབྲས་བུ་མི་དམིགས་པ་གོ་བར་བྱེད་པ་མ་ཡིན་པར་བྲྗོད་དེ།",
    "དེའི་ངོ་བོ་ཁྱབ་པའི་འབྲས་བུ་མེད་པས་ནི་མེད་པར་ཡང་ཡིན་ནོ།",
    "མེད་པ་དང་ཐ་སྙད་སྒྲུབ་པའི་མ་དམིགས་པ་འདི་ཐམས་ཅད་ལ་ཡང་བལྟར་རུང་བའི་བདག་ཉིད་ཁོ་ནའི་དེ་དག་དང་དེ་འགལ་བ་དག་དམིགས་པའི་རྒྱུ་གཞན་ཉེ་བ་ལས་མ་གྲུབ་པ་དང་གྲུབ་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "དངོས་པོ་མེད་པར་རྟོགས་པར་འགྱུར།",
    "གལ་ཏེ་འགལ་བའི་འབྲས་བུ་དམིགས་པས་ཀྱང་མེད་པར་གྲུབ་ན།",
    "གང་ལས་དེ་མེད་པར་གོ་བར་འགྱུར་བ་རྒྱུ་རྣམས་ནི་འབྲས་བུ་རྩོམ་པར་མ་ངེས་པས་ན་གྲང་བ་བཟློག་པའི་མེ་གདོན་མི་ཟ་བར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "ཐ་མའི་གནས་སྐབས་ཀྱི་ཁྱད་པར་ལ་འཁྲུལ་བ་མེད་དོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་རྟོགས་པ་ན་མཐའི་སྐད་ཅིག་བར་ཆད་མེད་པའི་ཕྱིར།",
    "དུས་ལ་སོགས་པ་ལྟོས་པར་འདོད།",
    "མེད་པར་ངེས་པ་ཡོད་མ་ཡིན།",
    "བསྟན་བཅོས་འཇུག་པ་ནི་སྐྱེས་བུའི་དོན་སྒྲུབ་པར་བྱེད་པའི་ཐབས་འགའ་ཞིག་ལ་བརྟེན་ནས་འཇུག་པ་ཡིན་ཏེ།",
    "སྐབས་དེར་ཡང་དོན་མང་པོ་དག་གདོན་མི་ཟ་བར་བསྟན་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཡུལ་དང་དུས་ཀྱིས་ཆོད་པ་སྐབས་སུ་ཉེ་བར་མཁོ་བ་མེད་པའི་རྫས་ཀྱི་ཁྱད་པར་ལྟ་བུ་སྟེ།",
    "རང་བཞིན་གྱི་ཁྱད་པར་དག་སྤོང་བར་བྱེད་པ་དཔེར་ན་སེམས་འདོད་ཆགས་དང་བྲལ་བའམ།",
    "ལྷའི་ཁྱད་པར་དག་མེད་པའམ།",
    "རྒྱུ་རྣམས་ནི་འབྲས་བུ་བསྐྱེད་པའི་ངེས་པ་མེད་པའི་ཕྱིར་ཤེས་པར་བྱེད་པ་མ་གྲུབ་པ་ཡིན་ཡང་དེ་ཙམ་གྱིས་དེ་མེད་པར་ངེས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་དག་ནི་སྨྲ་བ་པོའི་བྲྗོད་པར་འདོད་པས་འཇུག་པའི་ཕྱིར་དེ་ལ་འཁྲུལ་པ་མེད་པས་དེ་ཉིད་ཀྱིས་གོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཁྱད་པར་ཅན་དེ་ཉིད།",
    "ཤེས་པར་ནུས་ན་དོན་འདི་འདོད།",
    "རྟོག་པ་སྔོན་དུ་གཏོང་བ་ཅན་ལུང་ངམ་ལུང་མ་ཡིན་པ་ཚོལ་བ་ཐམས་ཅད་ནི་འཇུག་པར་འདོད་པས་ཡིན་གྱི་ཞེན་པས་ནི་མ་ཡིན་ནོ།་།",
    "དེ་སྐྱེས་བུ་བརྟགས་ནས་འཇུག་ན་ནི་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟ་བུ་ནི་ཤེས་པར་མི་ནུས་པའི་ཕྱིར།",
    "དེས་ན་འདི་རྟགས་འཚོལ་བའི་ཕྱིར་ཇི་ལྟར་ངེས་པ་མེད་པར་རྟོགས་པར་བྱེད།",
    "གལ་ཏེ་བྱེད་པ་པོ་ཤེས་པར་དཀའ་བའི་ཕྱིར་སྐྱེས་བུ་ལ་བརྟེན་པའི་ཚིག་ནི་ལུང་མ་ཡིན་གྱི།",
    "སྐྱེས་བུས་མ་བྱས་པ་ནི་ཕྱིན་ཅི་མ་ལོག་པ་ཡིན་ནོ་ཞེ་ན།",
    "དམིགས་པར་རུང་བ་དང་མི་རུང་བའི་བདག་ཉིད་ཐོབ་པ་དང་གཏོང་བ་དག་ནི་རང་བཞིན་སྐྱེས་བ་དང་ཉམས་པ་མེད་ན་མེད་པའི་ཕྱིར་རོ།"
  ]
}