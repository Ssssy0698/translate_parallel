    "སྒྲ་དང་རྟགས་མེད་པར་དེ་རང་ཉིད་ཇི་ཞིག་ལྟར་ཡང་དྲན་པར་མི་འགྱུར་རམ་ཅི།",
    "དེའི་ཕྱིར་འདི་དག་འགའ་ཞིག་ཏུ་མ་གྲུབ་པ་འགའ་ཞིག་ཏུ་སྒྲུབ་པའམ་འགོག་པར་མི་བྱེད་པའི་ཕྱིར།",
    "ཇི་ལྟར་འགའ་ཞིག་སྒྲུབ་པར་བྱེད་པ་ཡིན།",
    "དེ་ལྟར་རྟོགས་པར་བྱ་བའི་གཞི་ནི་དེ་ཉིད་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་གཞན་མེད་པའི་ཕྱིར་དང་།",
    "དེ་བཞིན་དུ་དམིགས་པར་རིགས་པ་མི་དམིགས་ན་ཡང་མེད་དོ་ཞེས་བྲྗོད་དེ།",
    "སྐྱེད་པར་བྱེད་པ་བྲྗོད་པ་ལ་ཕ་ཉིད་བཞིན་ནོ།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པར་བྲྗོད་པ་ལ་ཕ་ཉིད་མ་ཡིན་པ་བཞིན་ནོ།་།",
    "གཞན་བློ་རྟོགས་པར་བྱེད་ཕྱིར་དང་།",
    "འགའ་ཞིག་འགོག་པར་བྱེད་ཕྱིར་ཡང་།",
    "གཞན་ཁོང་དུ་ཆུད་པར་བྱ་བའི་དོན་དུ་བསྟན་བཅོས་ཀྱང་བྱེད་ལ།",
    "རྗེས་སུ་དཔག་པ་དེ་སྤངས་ན་འཇུག་པ་འབྲས་བུ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་གྲུབ་ཀྱང་བློའི་རྣམ་པར་བརྟགས་པ་ལ་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ།",
    "ལོག་པ་ལས་མངོན་སུམ་ཉིད་ཀྱིས་དངོས་པོ་མེད་པར་ངེས་པ་ཡིན་ནོ་ཞེ་ན་དེ་མེད་པ་ཡང་ཡིན་ལ་དེས་རྟོགས་སོ།",
    "གཞན་ལས་བྱུང་བའམ་མ་བྱུང་བའི་ཡོད་པ་དེ་ནི་དེ་ལ་ངེས་པར་མི་སླུ་བ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "ཤེས་པ་ཡིན་ནོ་ཞེ་ན་ཇི་ལྟར་གཞན་ཡོད་ན་འབྲེལ་པ་མེད་པ་གཞན་ངེས་པར་ཡོད་པར་འགྱུར་བ་མཐོང་བའི་ཕྱིར་ཡོད་པར་འགྲུབ་བོ་ཞེ་ན།",
    "དེའི་ཕྱིར་ཤེས་པ་ཡོད་པ་ལས་དོན་ཡོད་པར་འདོད་པས་ཤེས་པ་དེ་དང་འབྲེལ་བར་བྲྗོད་པར་བྱ་བ་ཡིན་ལ།",
    "དེའི་སྟོབས་ཀྱིས་སྐྱེས་པའི་རྣམ་པར་ཤེས་པ་ཡང་དོན་གཞན་གྱི་རྗེས་སུ་འབྲང་བ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ཅན་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "དོན་གྱི་ནུས་པ་ཉེ་བ་ལ་ལྟོས་པ་མེད་པར་རྣམ་པར་རྟོག་པའི་བག་ཆགས་ཀྱིས་ཀུན་ནས་བསླངས་པ་ལས།",
    "སོ་སོར་འཛིན་པར་བྱེད་དོ།",
    "དོན་དེ་ཆོད་པར་འགྱུར་བ་ཡིན།",
    "ཉེར་སྦྱོར་ཁྱད་པར་བྱེད་པའི་ཕྱིར།",
    "བདག་ཉིད་ཐ་དད་པ་མེད་པས་ནུས་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་གཅིག་ཉིད་གཅིག་ལ་བྱེད་པ་དང་མི་བྱེད་པར་ནི་མི་འགྱུར་རོ།",
    "དྲན་པས་སད་པར་བྱེད་པ་ལ་སྦྱོར་བའི་ཕྱིར་བློ་ནི་ཕན་པ་མེད་པ་དེ་ཡོད་པ་ལ་མི་ལྟོས་པ་ཉིད་དོ།",
    "དོན་གྱི་ཉེ་བར་སྦྱོར་བས་བློ་སྐྱེད་པར་བྱེད་ན་ནི་བྲྗོད་པ་དྲན་པའི་བར་ཆད་མེད་པའི་ཕྱིར་མངོན་སུམ་རྟོགས་པ་མེད་པར་གྲུབ་པ་ཡིན་ནོ།་།",
    "ཁྱད་པར་དང་ནི་ཁྱད་པར་ཅན།",
    "གཟུང་སྟེ་དེ་ལྟར་བསྡོམས་བྱས་ན།",
    "དོན་དང་འབྲེལ་པ་དང་རྗོད་པར་བྱེད་པའི་གཙུག་ལག་རྣམས་མི་ཤེས་ན་མི་འགྱུར་བའི་ཕྱིར་གཞན་དུ་ནི་མ་ཡིན་ནོ།་།",
    "གང་ལ་ཐ་དད་པར་རྟོགས་པ་ཡོད་པ་དེ་ལ་ཡང་འཛིན་པ་ནི།",
    "གཞན་ཡང་འདི་ཁྱད་པར་ལ་སོགས་པའི་རྟོགས་པས་བསླང་བ་ཡིན་ན་ཚོགས་པ་ཚང་བ་ཅན་གྱི་འཇུག་པ་ཡང་འདོད་པས་ལྡོག་པར་འགྱུར་ཏེ།",
    "དེ་ལས་གཞན་པའི་རྣམ་པར་རྟོགས་པ་བཞིན་ནོ།",
    "རྣམ་པར་རྟོགས་པ་རྣམས་ནི་སོ་སོར་བརྟགས་པས་བཟློག་པར་ནུས་པ་ཡིན་གྱི།",
    "འདི་དོན་ཉེ་བ་ལས་མི་ལྟོས་པར་ཡང་འགྱུར་ཏེ།",
    "པར་རིགས་པ་མ་ཡིན་ནོ།",
    "སྒྲ་ཡི་ཁྱད་པར་ཇི་ལྟར་དྲན།",
    "རྗོད་པར་བྱེད་པའི་ཁྱད་པར་དྲན་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "མཐོང་བའི་སྒྲ་དྲན་པར་འགྱུར་བ་ཡིན་ཏེ་མེ་དང་དུ་བ་བཞིན་ནོ།",
    "འདིས་སྒྲ་མེད་པར་དོན་མི་མཐོང་ཞིང་མ་མཐོང་ན་ཡང་སྒྲའི་ཁྱད་པར་མི་དྲན་ལ་མ་དྲན་ན་སྦྱོར་བར་མི་བྱེད་དོ།",
    "མ་སྦྱར་ན་རྟོགས་པར་མི་འགྱུར་བའི་ཕྱིར་འགྲོ་བ་མ་ལུས་པ་ལོང་བ་ཉིད་དུ་འགྱུར་རོ།",
    "བྲྗོད་པའི་སྣང་བ་མེད་པའི་སྣང་བ་ནི་སྲོག་ཆགས་ཐམས་ཅད་ཀྱི་མངོན་སུམ་ཉིད་ཡིན་པའི་ཕྱིར་འདི་ལ་སྒྲུབ་པར་བྱེད་པ་གཞན་གྱིས་ཅི་ཞིག་བྱ།",
    "ཅུང་ཟད་རྣམ་པར་རྟོག་པ་ན།་།",
    "དེའི་ཕྱིར་རྣམ་པར་རྟོག་པ་འདི་དག་མངོན་སུམ་ཡིན་ན་ཇི་ལྟར་རྣམ་པར་རྟོག་པ་བསྡུས་པའི་མཐོང་བ་ལ་རྟོགས་པར་མི་འགྱུར་ཞེས་བྱ།",
    "ཉིད་ཀྱི་རྣམ་བར་རྟོག་པ་ནི་མེད་པར་འགྱུར་རོ།",
    "དེ་ཡང་ལྐོག་ཏུ་འགྱུར་བའི་ཕྱིར་དེ་ལས་ཕན་པ་དང་གནོད་པར་མི་འགྱུར་ཏེ།",
    "འདི་དག་མངོན་སུམ་གྱིས་ཤེས་པ་མ་ཡིན་ན་བདག་ཉིད་ལ་རྟོགས་པར་ཡང་ཇི་ལྟར་འགྱུར།",
    "དོན་མ་ཤེས་པར་བློ་མི་འགྲུབ་པས་ན་དེ་ཤེས་པ་ནི་རྗེས་སུ་དཔག་པ་ལས་ཁོང་དུ་ཆུད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དོན་ཤེས་པ་ཞེས་བྱ་བ་བློའི་སྒྲུབ་པར་བྱེད་པ་ནི་རྟོགས་པ་ཡིན་ལ་བློ་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་བསྔགས་པར་འོས་པའི་ཤེས་རབ་ཅན་ལྷ་རྣམས་དགའ་བར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་བར་དུ་མ་ཆོད་པའི་ཤེས་པའི་རྒྱུར་གྱུར་པ་རྣམ་པར་ཤེས་པ་སྔ་མ་ཉིད་ཡིན་པར་རིག་སྟེ།",
    "དེ་ཡུལ་གཞན་ལ་སེམས་གཏད་ཅིང་ནུས་པ་ཉམས་པར་གྱུར་ན་གཞན་ལ་ཤེས་པ་མི་སྐྱེ་བའི་ཕྱིར་རོ།",
    "དེའི་ཁྱད་པར་ཅན་དེ་ཡང་མ་གྲུབ་བོ།",
    "བློས་མ་བསྐྱེད་ན་ཇི་ལྟར་བློའི་གོ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དངོས་པོ་མེད་ཀྱང་སྒྲ་ལས་བྱུང་བའི་སྣང་བ་མི་ཉམས་པས་མེད་པའི་དོན་སྣང་བ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་སྒྲ་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ནི་དངོས་པོའི་ཡུལ་ཅན་མ་ཡིན་ནོ།",
    "སྒྲ་སྦྱར་བ་ཡང་དོན་རྟོགས་པར་བྱ་བའི་ཕྱིར་ཡིན་ན།",
    "འདི་ལྟར་གཅིག་ཏུ་མཐོང་བའི་ཁྱད་པར་ནི།",
    "གང་ལས་སྒྲ་འཇུག་པར་འགྱུར་བ་གསལ་བའི་བདག་ཉིད་རྣམས་ལས་ཐ་དད་པའི་རྗེས་སུ་འགྲོ་བའི་དོན་ནི་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "བློ་དང་སྒྲ་རྗེས་སུ་འགྲོ་བའི་མི་རྟེན་པའི་ཁྱད་པར་འདི་སྤྱི་མཐོང་བའི་སྟོབས།",
    "གང་ལས་གང་ལ་སྒྲ་དང་བློ་འཇུག་པ་དེ་མ་རྟོགས་པར་ནི་དེ་དེ་ལྟར་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "ཐམས་ཅད་ཁྱད་པར་ཡུལ་ཅན་ཉིད།",
    "འདིའོ་ཞེས་བྱ་བར་ངེས་ན་ནི་བདེ་བ་དང་སྡུག་བསྔལ་གྱི་སྒྲུབ་པར་བྱེད་པ་དག་ཐོབ་པ་དང་སྤོང་བའི་དོན་དུ་འཇུག་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "འཛིན་པར་བྱེད་པའི་ཡིད་ཀྱང་ངོ།",
    "འཇོག་པར་ནུས་པའི་རྒྱུ་ཉིད་ལ།",
    "མཐོང་བའི་འདུ་བྱེད་མ་ཉམས་པའི་གཟུང་བ་འཛིན་པ་ནི་དྲན་པ་ལས་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "བྱ་བ་རྫོགས་པའི་ལས་ལ་ཁྱད་པར་དུ་བྱེད་པ་མ་ཡིན་པ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ཡང་སྒྲུབ་པར་བྱེད་པའི་ཚུལ་ལས་འདས་པ་ཡིན་ནོ།",
    "གཞན་གྱི་ཁྱད་པར་དུ་བྱ་བ་མེད་པ་ནི་ལྟོས་པར་མི་འཐད་པའི་ཕྱིར་དང་།",
    "ཁྱད་པར་དུ་བྱ་བ་ཉིད་ཡིན་ན་ནི་གཞན་ཉིད་ཡིན་ནོ།",
    "བདེ་བ་ལ་སོགས་པ་རྣམས་ཀྱི་བདག་ཉིད་རིག་པ་ལ་ནི་རྣམ་པར་རྟོག་པ་སྲིད་པ་མ་ཡིན་ཏེ།",
    "འདི་དག་ལ་འདི་རྗོད་པར་བྱེད་པ་སྦྱོར་བ་ནི་མ་ཡིན་ཏེ།",
    "བྲྗོད་པར་གཟོ་བ་ན་ཡུལ།",
    "འོན་ཀྱང་དོན་གཅིག་ལ་འདུ་བ་ཅན་གྱི་ཤེས་པས་རིག་པར་བྱ་བ་ཡིན་ནོ།་།",
    "དེ་ལ་བདེ་བ་ལ་སོགས་པ་ཡུལ་མེད་པར་ནི་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "ཡིད་ལ་བྱེད་པ་མེད་པར་ཡང་མ་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ལ་ཡང་རྒྱུའི་ཚོགས་པ་འདི་དག་ཙམ་ཁོ་ནར་ཟད་དོ།",
    "འདུས་བྱས་པ་ལ་ངེས་པ་ཡིན་ནོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "འདུས་བྱས་པ་ཞེས་བྱ་བ་ཡང་རྣམ་པར་ཤེས་པའི་རྒྱུར་རུང་བའི་རྣམ་པར་ཤེས་པ་སྔ་མ་ཉིད་ཡིན་པར་ཁོ་བོས་རྟོགས་ཏེ།",
    "ཕྱིར་རོལ་ཁྱད་པར་མེད་ན་ཡང་།",
    "གོམས་པས་ཁྱད་པར་འགྱུར་བའི་ཕྱིར།",
    "སྔོན་པོ་ལ་སོགས་པའི་སྣང་བའི་ཁྱད་པར་བཞིན་ནོ།",
    "དེའི་ཁྱད་པར་ལ་མི་ལྟོས་པར་གོམས་པའི་ཁྱད་པར་དང་རྗེས་སུ་འབྲེལ་བ་དེ་དག་ནི་བློ་ཉིད་ཡིན་ཏེ།",
    "འདིའི་བདག་ཉིད་འདི་འཇོག་པར་བྱེད་པ་གཞན་ཡིན་པར་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ཁྱད་པར་མེད་ཁྱད་པར་དུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དང་ལྡན་པ་ནི་ཁྱད་པར་དུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དང་ལྡན་པ་ནི་བློ་ཡིན་གྱི་མྱོང་བ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདི་གཉིས་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "ཁྱད་པར་ཡོད་ན་ཡང་བྲྗོད་དགོས་སོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་ཤིན་ཏུ་དང་བ་ལ་སོགས་པའི་ཁྱད་པར་གཞན་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཡུལ་རྣམ་པར་འཇོག་པ་ཡང་མྱོང་བར་མཐར་ཐུག་པའི་ཕྱིར་སེམས་པ་མེད་པ་དེས་དོན་རྣམ་པར་འཇོག་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "སྒྲ་ལ་སོགས་པའི་བདེ་བ་ཁྱད་པར་མེད་ཀྱང་བློའི་བདེ་བ་ཁྱད་པར་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ཡང་ཚིག་ཙམ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་སེམས་པ་ཡོད་པ་ལས་གཞན་ཁྱད་པར་ཅན་གྱི་བློ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདི་ནི་དགའ་བ་དང་ཞུམ་པ་ལ་སོགས་པ་རྣམ་པར་འགྱུར།",
    "རྣམ་པ་དུ་མར་གཅིག་ཏུ་མྱོང་བ་ཉིད་ཡིན་པར་མཐོང་སྟེ།",
    "དེ་ལ་མིང་ནི་ཇི་ལྟར་འདོད་པར་བྱེད་ལ་རག་གོ།་།",
    "མྱོང་བ་ནི་མངོན་སུམ་མ་ཡིན་ལ་བློའི་རྣམ་པར་འགྱུར་བ་ནི་མངོན་སུམ་ཡིན་ནོ་ཞེ་ན།",
    "ཡུལ་ཡོད་པ་ལས་ཡུལ་ལ་ལོངས་སྤྱོད་པར་ཡང་འགྱུར་རོ།",
    "དེའི་ལོངས་སྤྱོད་པ་ནི་མངོན་སུམ་མ་ཡིན་པས་ཁྱད་པར་མ་གྲུབ་པའི་ཕྱིར།་",
    "ཡོད་ཀྱང་མེད་པ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སེམས་པ་དང་ནི་ཞེན་པ་དག་ཐ་དད་ཀྱང་འདྲེས་པས་རྣམ་པར་བསླད་པ་ལ་བྱེ་བྲག་ཏུ་རྟོགས་པར་མི་འགྱུར་ཏེ་ལྕགས་ཀྱི་གོང་བུ་དང་མེ་བཞིན་ཏེ།",
    "དོན་དམིགས་པ་ཐམས་ཅད་ལ་འདྲེས་པར་དོགས་པར་གཅིག་ཏུ་ངེས་པ་མེད་པའི་ཕྱིར་དང་།",
    "བདེ་བ་དང་སྔོན་པོ་ལ་སོགས་པ་རྣམ་པ་ཐ་དད་པར་དམིགས་པ་དག་ཀྱང་ཐ་དད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "ཨཨེ་མའོ་ཐ་དད་པ་དང་ཐ་དད་པ་མ་ཡིན་པ་དེ་དག་རྒྱུ་ཅི་ལ་བརྟེན་ནས་རྣམ་པར་འཇོག།",
    "འགྲུབ་པར་འགྱུར་དེ་སྒྲུབ་བྱེད་མིན།",
    "རང་བཞིན་ཐ་དད་པའི་རྫས་དག་འདྲེས་པའི་ཕྱིར་རྣམ་པར་མ་ཕྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "འདི་ལྟར་མི་སྡུག་པ་དང་ཟད་པར་ས་ལ་སོགས་པ་ཡང་དག་པ་མ་ཡིན་པའི་ཡུལ་ཅན་ལ་ཡང་བསྒོམས་པའི་སྟོབས་ཀྱིས་གསལ་བར་སྣང་བ་དང་རྣམ་པར་རྟོག་པ་མེད་པར་གྲུབ་པར་འདོད་པ་ཡིན་ནོ།",
    "བསྒོམས་པའི་སྟོབས་ཀྱིས་གསལ་བར་སྣང་བ་ཡིན་དུ་ཟིན་ཀྱང་རྟོག་པ་མེད་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "རྣམ་པར་བསླད་པའི་བློ་ཡང་རུང་སྟེ་བྲྗོད་པ་དང་འདྲེས་པའི་ཤེས་པ་ཐམས་ཅད་ལ་ནི་དོན་གསལ་བ་ཉིད་ལྡོག་པའི་ཕྱིར་རོ།",
    "དེས་ན་རྣམ་པར་རྟོག་པ་ཅན་འདི་ནི་གསལ་བར་སྣང་བར་འོས་པ་མ་ཡིན་ནོ།",
    "དེ་འདྲའི་དོན་ལྡན་མི་དྲན་པར།",
    "གཉིད་ཀྱིས་བསླད་པ་རྣམས་ལ་ཡང་ཉམས་སུ་མྱོང་བ་དྲན་པའི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་ནི་འབྱུང་ལ།",
    "དེའི་ཕྱིར་བསླད་པའམ་གཞན་གྱིས་ཀྱང་རྣམ་པར་རྟོག་པ་ནི་གསལ་བར་བྱེད་པ་མ་ཡིན་གྱི།",
    "བར་སྣང་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་ཡིན་ནོ།་།",
    "འོ་ན་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་གསལ་བར་སྣང་བའི་རྨི་ལམ་གྱི་ཤེས་པ་མངོན་སུམ་དུ་འགྱུར་རོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "རྣམ་པར་གཉིས་སུ་བྲྗོད་དོ།་།",
    "རྣམ་པར་རྟོག་པ་ནི་དེ་ལྟ་མ་ཡིན་ཏེ།་",
    "འདི་ཡང་སླུ་བའི་ཕྱིར་དངོས་པོ་དང་མཐུན་པར་སྣང་བ་མ་ཡིན་པས་མངོན་སུམ་ལྟར་སྣང་བའོ།",
    "རབ་རིབ་ཀྱིས་མཚོན་པའི་བསླད་པ་མངོན་སུམ་ལྟར་སྣང་བར་གསུངས་སོ།",
    "གཞན་དུ་ཡང་མིག་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་རྣམས་ཟླ་བ་གཉིས་དང་སྔོན་པོ་ལ་སོགས་པར་སྣང་བའི་རྣམ་པར་ཤེས་པའི་རྒྱུ་ཉིད་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "གང་ལས་བར་ཆད་མེད་པར་གཞལ་བྱ་རྟོགས་པ་འདིའི་དེ་ཉིད་འགྲུབ་པའོ།",
    "དེ་ཁྱད་པར་མེད་ན་ཡང་དེའི་ཁྱད་པར་ཡང་མི་འགྲུབ་བོ།",
    "དེའི་ཕྱིར་འདིའི་བདག་ཉིད་ཀྱི་བྱེ་བྲག་གང་ལས་འདིའི་རྟོགས་པ་ནི་འདི་ཡིན་ནོ་ཞེས་འདིའི་ལས་ལ་ངེས་པ་འདིར་འགྱུར་བ་དེ་ནི་སྒྲུབ་པར་བྱེད་པ།",
    "དོན་གྱིས་བྱས་པའི་ཉམས་སུ་མྱང་བའི་བྱེ་བྲག་གང་ལས་རྟོགས་པ་འདིར་འགྱུར་བ་ཡིན་གྱི།",
    "དེ་ནི་འདིའོ་ཞེས་བསྟན་པར་ནུས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདིའི་བདག་ཉིད་ངེས་པར་རྟོགས་པ་མེད་པས་འདི་ནི་འདིའི་ཡིན་གྱི་འདིའི་མ་ཡིན་ནོ་ཞེས་དངོས་པོ་རྣམ་པར་འཇོག་པར་བྱེད་པ་ནི་ལེགས་པར་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་གཞན་ཡིན་ན།",
    "ཁྱད་པར་གྱི་ཤེས་པ་ཡང་སྤངས་པ་ཡིན་ནོ།",
    "བྱེད་པ་པོ་ཁྱད་པར་ཅན་དུ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "བྱེད་པ་པོ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བ་ལ་ཉེ་བར་སྦྱོར་ཡང་ཐ་མའི་བྱེ་བྲག་ཏུ་བྱེད་པ་པོ་འདི་ཉིད་སྒྲུབ་པར་བྱེད་པ་དམ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ཁྱད་པར་གྱི་ཤེས་པ་ཡང་ཡུལ་གྱི་ཁྱད་པར་དུ་མ་བྱས་ན་ཁྱད་པར་གྱི་ཤེས་པ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རྣམ་པར་གཞག་པ་མི་འགྲུབ་པའི་ཕྱིར་དང་།",
    "བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་དག་ཡུལ་ཐ་དད་པ་འགལ་བའི་ཡང་ཕྱིར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཤེས་པའི་ཆ་དག་ནི་རྣམ་པར་གཞག་པ་ལ་བརྟེན་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་དངོས་པོ་ཡིན་ནོ།",
    "དངོས་པོ་ཐ་དད་པ་མེད་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་དག་གཅིག་པས་འགལ་ལོ་ཞེ་ན།",
    "ཁོ་བོ་ཅག་ཀྱང་ཚུལ་འདི་ཉིད་རྗེས་སུ་རྟོགས་པར་འདོད།",
    "འདི་བལྟས་པ་འམ་མཉན་ནོ་ཞེས་མཐོང་བའམ་ཐོས་པ་དག་ལས་གང་ལ་ངེས་པའི་ཤེས་པར་འགྱུར་བ་དེ་དག་ནི་དེའི་ཉམས་སུ་མྱོང་བ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་སྣང་བ་རགས་པའི་རྣམ་པར་ནི་རྡུལ་ཕྲ་རབ་སོ་སོ་བ་རྣམས་ལ་མེད་པའི་ཕྱིར་རོ།",
    "ཡང་ན་ནི་འགའ་ཡང་མ་བསྒྲིབས་པའི་ཕྱིར་མ་ཚང་བ་མེད་པར་མཐོང་བར་འགྱུར་རོ།",
    "གཅིག་ཁ་བསྒྱུར་ན་ཡང་ཐམས་ཅད་ཁ་བསྒྱུར་བའམ་མ་བསྒྱུར་བར་རྟོགས་པར་འགྱུར་རོ།",
    "འདིའི་མངོན་སུམ་དུ་སོ་སོར་རིག་པར་བྱ་བ་ཉིད་ཀྱང་དེའི་བདག་ཉིད་ཁོ་ནའོ།",
    "མཚན་ཉིད་རྣམ་པར་བསླད་པ་ཅན།",
    "དེ་ལྟར་འདི་ནི་གཞག་བྱས་པ།",
    "འདོད་པ་དང་མི་འདོད་པའི་ཡུལ་སོ་སོར་རིག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དོན་གྱི་ངོ་བོ་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་འཇོག་པ་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པ་ནི་དུ་མར་རྣམ་པར་རིག་པ་སྟེ།",
    "དེ་ལ་ཡང་འཆི་ལྟས་ལ་སོགས་ཚེ་མཚམས་སྦྱོར་བ་མེད་པར་མཐོང་བའི་ཕྱིར་དང་།་",
    "འདིའི་སྒྲུབ་པར་བྱེད་པ་ནི་ཡུལ་གྱི་རྣམ་པ་ཉིད་ཡིན་ཏེ།",
    "དོན་གནས་པ་ནི་རང་རིག་པའི་རང་བཞིན་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་རང་རིག་པ་ཡིན་ཡང་འབྲས་བུ་ལས་འདི་ནི་དོན་རིག་པ་ཡིན་པར་བལྟའོ།",
    "དོན་དངོས་མེད་པར་སྣང་ཅན་དེ།",
    "འདི་ལ་རྣམ་པར་གཞག་པ་འདི་ནི་ཇི་ལྟར་སྣང་བ་བཞིན་ཡིན་གྱི་དེ་ཁོ་ན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་ནི་མ་ཡིན་ནོ།",
    "ཡུལ་གྱི་རྣམ་པ་འགའ་ཞིག་དང་ནང་དུ་ཡོངས་སུ་གཅོད་པ་ནི་རང་རིག་པའི་རང་བཞིན་དུ་སྐྱེ་བ་ན་མཚོན་པར་འགྱུར་རོ།",
    "བློ་བདག་རྣམ་པར་དབྱེར་མེད་ཀྱང་།",
    "ཇི་ལྟར་སྣང་བ་བཞིན་དུ་བྱས།",
    "ཐ་དད་མེད་པར་ངེས་པར་འགྱུར།",
