    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཁམ་རན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་བྱིས་པ་ཁྱེའུ་དང་མུ་ཏོ་བ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "བསླབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ཁམ་རན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ཁམ་རན་པ་མ་ཡིན་པར་ཟ་བའོ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁམ་རན་པར་མ་ཡིན་པ་དང་།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཁམ་མ་གཟས་པར་ཁ་མི་གདང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁམ་མ་གཟས་པར་ཁ་མི་གདང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་བ་ནི་ཁམ་མ་གཟས་པར་ཁ་གདངས་བའོ།",
    "དེ་ལ་ཁམ་མ་གཟས་པར་ཁ་མེ་གདང་བཞེས་བྱ་བ་ནི་ཇི་སྲིད་དུ་ཁམ་ཁའི་སྒོར་ཉེ་བར་མ་འོངས་བ་དེ་སྲིད་དུ་ཁའི་སྒོ་གདང་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་བར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁམ་མ་གཟས་པར་ཁ་གདངས་བ་དང་ཟས་ཉིད་དོ།",
    "ཁ་ཁམ་ཀྱིས་བཀང་སྟེ་མི་སྨྲ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཉེས་པ་ནི་ཁམ་མ་གཟས་པར་ཁ་གདངས་པའོ།",
    "དེ་ལ་ཁམ་མ་གཟས་པར་ཁ་མི་གདང་བ་ཞེས་བྱ་བ་ནི་ཇི་སྲིད་དུ་ཁམ་ཁའི་སྒོར་ཉེ་བར་མ་འོངས་པ་དེ་སྲིད་དུ་ཁའི་སྒོ་གདང་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁམ་མ་གཟས་པར་ཁ་གདངས་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྕེ་ཕྱུར་སྟེ་ཟས་མི་བཟའ་བར་བསླབ་པར་བྱ་བའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ཙུག་ཙུག་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "སངས་བཅོམ་ལྡན་འདས་མཉན་ཡོད་ན་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་བ་ན་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཙུག་ཙུག་མི་བྱ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་ཙུག་ཙུག་ཟེར་བ་དང་ཁ་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "བལྕག་བལྕག་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེས་ཚོད་མ་ཏེ་པོར་སྐུར་བ་དག་སྟེ་གོན་བྱས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་བལྕག་བལྕག་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་བལྕག་བལྕག་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཧུ་ཧུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཧུ་ཧུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་ཧུ་ཧུ་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཕུ་ཕུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཕུ་ཕུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་ཕུ་ཕུ་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་བསྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྕེ་ཕྱུང་སྟེ་ཟས་མི་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཚེ་དང་ལྡན་པ་དག་མ་བཅས་པར་མིད་ན་མི་རུང་བས་དེ་བལྟའོ།",
    "དེ་དག་སྨོད་པར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལྕེ་ཕྱུང་སྟེ་ཟས་མི་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
