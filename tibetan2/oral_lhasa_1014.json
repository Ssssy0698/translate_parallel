    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྷུང་བཟེད་མི་བྱོག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེ་དག་སྨོད་པར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ལྷུང་བཟེད་མི་བྱོག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ན་བཞུགས་སོ།",
    "ལག་པ་སྤྲུག་པར་བྱེད་པས་དགེ་སློང་རྣམས་ལ་ལག་པའི་ཆུ་ཕོག་ནས་དེ་དག་སྨོད་པར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལག་པ་མི་སྤྲུག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལག་པ་མི་སྤྲུག་པ་ཞེས་བྱ་བ་ནི་ལག་པ་ལ་ཟས་ཆགས་པ་སྤྲུག་པར་མི་བྱ་བ་དང་།",
    "ཡང་ན་ལག་པ་ལ་ཟས་ཆགས་པ་ལྕེའི་སྟེང་དུ་སྤྲུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྷུང་བཟེད་མི་བསྐྱམས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལྷུང་བཟེད་མི་བསྐྱམས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལྷུང་བཟེད་མི་བསྐྱམས་པ་ཞེས་བྱ་བ་ནི་ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ལ་སོགས་པ་བླུགས་ཏེ་བསྐྱམ་པར་མི་བྱ་བ་དང་།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "དགའ་བོ་ཉེ་དགའ་མཆོད་རྟེན་འདི་ནི་ངན་འགྲོ་རྫོགས་པར་བྱེད་པ་རྫོགས་བྱེད་ཀྱི་མཆོད་རྟེན་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "དགའ་བོ་ཉེ་དགའ་ངན་འགྲོ་རྫོགས་པར་བྱེད་པ་རྫོགས་བྱེད་ཀྱི་མཆོད་རྟེན་རྡིབ་པོ་ཞེས་ཟེར་བ་ཁྱིམ་བདག་དེས་ཐོས་ནས་དེས་སྨྲས་པ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་མན་ཆད་འདི་ཡན་ཆད་ཐམས་ཅད་ནི་གྲོང་དང་གཙུག་ལག་ཁང་ལ་སོགས་པ་གནས་སྐབས་ཐམས་ཅད་དུ་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བ་དེའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "འགྲེང་པར་བྱེད་ལ་སོགས་པ་ལྔ།",
    "ཞེས་གསུངས་པ་ལ།",
    "བསླབ་པ་འདི་དང་འོག་མ་གསུམ་ནི་ཉེས་རྩོམ་མི་བྱ་བར་བསླབ་པར་བྱ་བ་སྟེ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལག་པ་ཟས་དང་འབགས་པས་ཆུ་སྣོད་ལ་མི་གཟུང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "གཙང་སྦྲ་མེད་པ་ཡིན་ནོ་ཞེས་ཅོ་འདྲི་བར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ལག་པ་ཟས་དང་འབགས་པས་ཆུ་སྣོད་ལ་མི་གཟུང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་གཙང་སྦྲ་མེད་པའི་ཉེས་ཙམ་མི་བྱ་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "དེ་ལྟར་གནོད་པར་བྱེད་པའི་ཉེས་རྩོམ་མི་བྱ་བར་བསླབ་པར་བྱ་བའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "གང་དུ་སྐྱེ་བར་འགྱུར་བ་ནི་མ་ཤེས་ཀྱི་ཁྱེད་ཅག་ནི་འདི་ལ་ལྷག་པར་ཆགས་པར་བྱས་ནས་ཡི་དགས་ལ་བ་ཅན་གྱི་ནང་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་དུ་དབོ་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ས་གཞི་མ་རུང་བར་འགྱུར་བའི་ཉེས་རྩོམ་མི་བྱ་བ་བསླབ་པར་བྱའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་ལྟུང་པ་རྣམ་པར་གཞག་པ་ནི།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "དེའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "ཞེས་གསུངས་པའི་བསླབ་པ།",
    "འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་མི་གཞག་པར་བསླབ་པར་བྱ།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་ལྷུང་བཟེད་གཞག་པར་བསླབ་པར་བྱའོ།",
    "འགྲེང་སྟེ་ལྷུང་བཟེད་མི་བཀྲུ་བར་བསླབ་པར་བྱ།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་ལྷུང་བཟེད་བཀྲུ་བར་བསླབ་པར་བྱའོ།",
    "འབབ་ཆུ་དྲག་པོའི་རྒྱུན་ལས་བཟློག་སྟེ་ལྷུང་བཟེད་ཀྱིས་ཆུ་མི་བཅུ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ཀྱི་ལྷག་མ་བླུགས་ཏེ་མི་དོར་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འདི་ལྟ་བུ་མི་གཙང་བས་བཀྲུ་བ་ནི་མི་རུང་ངོ་ཞེས་ཟེར་བའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "མི་དོར་བར་བསླབ་པར་བྱའོ།",
    "དེ་ལ་ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ཀྱི་ལྷག་མ་བླུགས་ཏེ་མི་དོར་བ་ཞེས་བྱ་བ་ནི་ཤིང་ཐོག་ལ་སོགས་པ་ཕྱེད་ཕྱེད་ཟོས་པ་ངན་པར་གྱུར་པ་ལྷུང་བཟེད་ཀྱིས་མི་དོར་བར་བསླབ་པར་བྱའོ།",
    "འོག་ནས་འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་མི་གཞག་པར་བྱ་བ་ལ་སོགས་པ་དགུ་བྱུང་བ་དག་ནི་འདིའི་སྤྲོས་པ་ཡིན་གྱི་རྣམ་པ་གཞན་བསྟན་པ་ནི་མ་ཡིན་ནོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་མི་གཞག་པར་བསླབ་པར་བྱ་བ་དང་།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་ལྷུང་བཟེད་གཞག་པར་བསླབ་པར་བྱ་བ་དང་།",
    "འགྲེང་སྟེ་ལྷུང་བཟེད་མི་བཀྲུ་བར་བསླབ་པར་བྱ་བ་དང་།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་ལྷུང་བཟེད་བཀྲུ་བར་བསླབ་པར་བྱ་བ་དང་།",
    "འབབ་ཆུ་དྲག་པོའི་རྒྱུན་ལས་བཟློག་སྟེ་ལྷུང་བཟེད་ཀྱིས་ཆུ་མི་བཅུ་བར་བསླབ་པར་བྱ་བ་དགུའི་གླེང་གཞི་ནི།",
    "དགེ་སློང་དག་འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་འཇོག་པར་བྱེད་ནས།",
    "དཀན་གཟར་པོར་ལྷུང་བཟེད་འཇོག་པར་བྱེད་ནས།",
    "འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་མི་གཞག་པར་བསླབ་པར་བྱའོ།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་ལྷུང་བཟེད་གཞག་པར་བསླབ་པར་བྱ།",
    "འགྲེང་སྟེ་ལྷུང་བཟེད་མི་བཀྲུ་བར་བསླབ་པར་བྱ།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་ལྷུང་བཟེད་བཀྲུ་བར་བསླབ་པར་བྱ།",
    "འབབ་ཆུ་དྲག་པོའི་རྒྱུན་ལས་བཟློག་སྟེ་ལྷུང་བཟེད་ཀྱིས་ཆུ་མི་བཅུ་བར་བསླབ་པར་བྱ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལྷུང་བཟེད་ཀྱིས་ཉེས་པ་དེ་དག་མི་བྱ་བར་ལྷུང་བཟེད་མིག་བཞིན་དུ་ཡོངས་སུ་བསྐྱང་བ་དང་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ཀྱི་ལྷག་མ་བླུགས་ཏེ་མི་དོར་བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་མན་ཆད།",
    "དེའི་སྤྲོས་པ་དག་ཡིན་པར་སྦྱར་རོ།",
    "ངན་པ་ནི་དམའ་བ་ཉིད་ཡིན་ལ་བཟང་པོ་ནི་མཐོན་པོ་ཉིད་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "འདིའི་སྤྲོས་པ་དག་ཡིན་པར་སྦྱར་རོ།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱ།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱ་གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོ་བར་མི་འཛེག་པར་བསླབ་པར་བྱ་བའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ན་བཞུགས་སོ།",
    "འཕགས་པ་དག་སྟོན་པའི་ཉན་ཐོས་ནི་ངོ་ཚ་དང་ལྡན་པ་ལགས་ན།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན།",
    "བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེ་ནས་བཙོ་བླག་མཁན་དེ་ནང་པར་སྔར་ལངས་ཏེ་གོས་བཀྲུ་བར་བརྩམས་པ་དང་།",
    "ཇི་ཙམ་ནས་མི་གཙང་བའི་དྲི་བྲོ་ནས།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱ་བ་ཡང་དེ་བཞིན་ནོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "བྱས་ཟིན་པ་ཡང་མི་དོར་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "བྱས་པ་འདོར་བ་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ལྡུམ་ཐམས་ཅད་མ་རུང་བར་བྱས་སོ།",
    "མི་གཙང་བའི་དྲི་ཡིས་དེར་ཝ་དག་འདུས་ནས།",
    "ཇི་ཙམ་ན་ལྡུམ་ཐམས་ཅད་མི་གཙང་བས་གཏོར་ཞིང་།",
    "རླུགས་པ་མི་དོར་བར་བསླབ་པར་བྱ་བ་ཡང་དེ་བཞིན་ནོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "བྱས་པ་མི་དོར་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འདི་ཇི་ལྟར་འོང་བའི་སྟངས་ལས་ནི་འདིས་བདག་ཟན་གཅོད་པར་བྱེད་དོ་སྙམ་དུ་རིག་ནས།",
    "ཤིང་ལ་མི་གང་ཙམ་དུ་འཛེག་པར་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་འཛེག་པར་མ་གནང་བས།",
    "གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེགས་པའོ།",
    "དེ་ལ་གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་རྒྱུ་ནི་མི་མཛེས་པར་སྣང་བ་དང་།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "དེ་དག་ནི་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་ཞེས་བྱ་བ་ནས།",
    "གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དང་གོ་རིམས་བཞིན་དུ་སྦྱར་རོ།",
    "ད་ནི་རྩོད་པ་ཞི་བར་བྱ་བ་གདོན་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གང་ཚུལ་ཤིང་མང་པོ་སྦྱིན་པར་འོས་པ་ལ་ཚུལ་ཤིང་མང་པོ་སྦྱིན་ནོ།",
    "དེའི་ངོ་བོ་ཉིད་ཚོལ་དུ་གཞུག་པར་འོས་པ་ལ་དེའི་ངོ་བོ་ཉིད་ཚོལ་བ་སྦྱིན་ནོ།",
    "རྩྭ་བཀྲམ་པར་འོས་པ་ལ་རྩྭ་བཀྲམ་པ་ལྟ་བུ་སྦྱིན་ནོ།",
    "ངེས་པར་འཛིན་པ་ལ་སྦྱོར་བ་ཉིད་སྦྱིན་པ་དང་།",
    "ལས་ལ་མཐུན་པ་སྦྱིན་དུ་གཞུག་པས་ཅི་རིགས་པར་ཞི་བར་བྱ་བ་བསྟན་ཏོ།",
    "དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་སྒྲུབ་པ་དང་།",
    "དེའི་ངོ་བོ་ཉིད་ཚོལ་དུ་གཞུག་པས་ངེས་པར་འཛིན་པ་ལ་སྦྱར་བ་ཉིད་སྦྱིན་པས་ཞི་བར་བྱའོ།",
    "ངེས་པར་འཛིན་པ་ལ་སྦྱར་བ་ཉིད་སྦྱིན་པའི་རིམ་གྱིས་ལས་ལ་མཐུན་པ་སྦྱིན་དུ་གཞུག་པས་ཞི་བར་བྱའོ།",
    "ཚུལ་ཤིང་མང་པོ་སྦྱིན་པར་འོས་པ་ནི།",
    "ཚུལ་ཤིང་མང་པོ་སྦྱིན་པར་འོས་པ་ནི།",
    "དེའི་ངོ་བོ་ཉིད་ཚོལ་དུ་གཞུག་པར་འོས་པ་ནི།",
    "དེ་ལ་ནི་དེའི་ངོ་བོ་ཉིད་བཙལ་བ་སྦྱིན་པས་ངེས་པར་འཛིན་པ་ལ་སྦྱར་བ་ཉིད་སྦྱིན་པས་ཞི་བར་བྱའོ།",
    "ངེས་པར་འཛིན་པ་ལ་སྦྱར་བ་ཉིད་སྦྱིན་པའི་རིམ་གྱིས་ལས་ལ་མཐུན་པ་སྦྱིན་དུ་གཞུག་པས་ཞི་བར་བྱ་བ་སྟེ།",
    "ཞི་བ་ཐམས་ཅད་ནི་བྱ་བའི་ཕྱིར་རྩོད་པར་འཇུག་གོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་ཞི་བར་བྱའོ་ཞེས་བྱ་བ་ནི་རྩོད་པའི་གཞིར་སྤྱིར་བསྟན་པ་ཡིན་ཏེ།",
    "རྣམ་པར་ཞི་བར་བྱའོ་ཞེས་བྱ་བ་ནི་ཆུང་ངུ་དང་།",
    "སྟོན་པའི་བསྟན་པའི་གནས་སྐབས་ཀྱི་གོ་རིམས་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "འདི་ལ་ཚེ་དང་ལྡན་པ་དག་ཡོངས་སུ་དག་ན་འདི་ལྟར་ཅང་མི་སྨྲ་བས་དེ་དེ་བཞིན་དུ་འཛིན་ཏོ་ཞེས་བྱ་བ་ནི་རྩོད་པ་ཞི་བར་བྱ་བ་རྣམ་པར་གཞག་པ་བསྒྲག་པར་བྱ་བ་ཡིན་ཏེ།",
    "ད་ནི་རྩོད་པའི་གཞི་ཞུ་བ་དང་བཅས་པའི་སྐབས་བརྗོད་པར་བྱ་སྟེ།",
    "རྩོད་པའི་འགྱེད་པ་བྱུང་བ་གང་ཡིན་པ་དེ་འགྱེད་པའི་ཕྱིར་རྩོད་པ་ཞེས་བྱ་བའོ་ཞེས་གསུངས་ཤེ་ན།",
    "བྱ་བའི་རྒྱུ་ལས་རྩོད་པ་ནི་བྱ་བའི་ཕྱིར་རྩོད་པའོ་ཞེས་གསུངས་པ་ལས།",
    "དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་སྒྲུབ་པ་དང་།",
    "དེ་ལ་དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་སྒྲུབ་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དེ་ལ་ལོག་པར་སྒྲུབ་པ་ཞེས་བྱ་བ་ནི་མ་ངེས་པ་ཉིད་དེ།",
    "དེ་ལྟར་དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་སྒྲུབ་པ་དེས་དངོས་པོའི་རྣམ་པ་ལ་དཔྱོད་པ་དག་ཀྱང་བསྡུས་ཏེ།",
    "སྦྱིན་པར་བྱ་བ་དང་།",
    "སྦྱིན་པར་མི་བྱ་བ་ཉིད་དང་།",
    "བྱ་བ་མ་ཡིན་པ་འདི་ནི་བྱས་ཤེ་འམ།",
    "སྦྱིན་པར་བྱ་བ་ནི་མ་བྱིན་ལ།",
    "སྦྱིན་པར་མི་བྱ་བ་འདི་ནི་བྱིན་ཞེའམ།",
    "དེ་ལྟར་དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་སྒྲུབ་པ་དང་།",
    "འགྱེད་པའི་ཕྱིར་རྩོད་པ་ཞེས་བྱ་བ་ནི་དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་སྒྲུབ་པ་དང་།",
    "དོགས་པའི་སྒོ་ནས་དྲན་པར་བྱའོ།",
    "རྒྱུད་གཅིག་ཏུ་བྱ་བས་ཕྱིར་བཅོས་པར་བྱ་བའོ།",
    "ཕེབས་པར་སྨྲ་བ་དང་།",
    "རྟག་ཏུ་ལྷན་ཅིག་གནས་པར་བྱ་བ་དང་།",
    "དེས་དེ་ལྟར་གླེངས་ཤིང་དྲན་པར་བྱས་པ་ན།",
    "སྐབས་འབྱེད་པར་མི་བྱེད་ན།",
    "གནས་འདི་ནས་མ་ཞུས་པར་འགྲོ་བར་མི་བྱའོ།",
    "ཁོ་བོ་ལ་ཚེ་དང་ལྡན་པ་ལ་བརྗོད་པར་བྱ་བའི་ཕྱིར་བསྔགས་པ་ཡོད་དོ་ཞེས་བརྗོད་པ་དང་བཅས་པ་ཉིད་དུ་བྱའོ།",
    "དེས་སྐབས་འབྱེད་པར་མི་བྱེད་ན་མི་གདམས་པ་ཉིད་དུ་བྱ་སྟེ།",
    "དེ་ལ་གདམས་ངག་དང་རྗེས་སུ་བསྟན་པས་ཕན་གདགས་པར་མི་བྱའོ།",
    "དེས་ཀྱང་སྐབས་མི་འབྱེད་ན་དེ་ལ་གཏམ་འདྲེ་བ་ལ་སོགས་པ་ཡང་བཟློག་པར་བྱ་སྟེ།",
    "ཕེབ་པར་སྨྲ་བ་དང་།",
    "རྟག་ཏུ་ལྷན་ཅིག་གནས་པར་བྱ་བའི་ཐ་སྙད་ཀྱི་ཚིག་སྦྱིན་པར་ཡང་མི་བྱའོ།",
    "དེ་ལྟ་ན་ཡང་སྐབས་འབྱེད་པར་མི་བྱེད་ན་དེ་ལ་གསོ་སྦྱོང་གཞག་པར་བྱ་བ་སྟེ།",
    "དེ་ལྟ་ན་ཡང་སྐབས་འབྱེད་པར་མི་བྱེད་ན།",
    "དེ་ལ་དགག་དབྱེ་གཞག་པར་བྱ་སྟེ།",
    "དགག་དབྱེའི་དུས་སུ་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་དེའི་དགག་དབྱེ་བཞག་པར་བྱའོ།",
