    "ཚོད་མ་དང་མཉམ་པར་མ་ཡིན་པ་དང་།",
    "ལྷུང་བཟེད་ལ་ལྟ་བ་དང་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་བ་དང་།",
    "བཟའ་བ་དང་བཅའ་བའི་སྟེང་དུ་ལྷུང་བཟེད་མི་གཟུང་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ཟས་ལེགས་པར་མི་ལེན་པའོ།",
    "དེ་ལ་ལེགས་པར་ཟས་བླང་བར་ཞེས་བྱ་བ་ནི་གྲོང་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་གཞན་དུ་ཡང་རུང་བ་སྟེ།",
    "ལེགས་པར་ཟས་ཀྱི་བྱིན་ལེན་བླང་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལེགས་པར་མི་ལེན་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "མུ་དང་ཁ་ད་ཆད་དུ་མ་ཡིན་པར་ཟས་བླང་བར་བྱ་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁྱེད་ཅག་ནི་འདི་ལ་ལྷག་པར་ཆགས་པར་བྱས་ནས།",
    "མུ་དང་ཁ་ད་ཆད་དུ་མ་ཡིན་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དོ།",
    "ཅི་ནས་ཀྱང་མུ་དང་ཁ་ད་ཆད་དུ་གང་བར་འགྱུར་བ་དེ་ལྟར་མ་ཡིན་པར་ཟས་བླང་བར་བྱ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པར་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཚོད་མ་དང་མཉམ་པ་མ་ཡིན་པར་ཁ་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁྱེད་ཅག་ནི་འདི་ལས་ལྷག་པར་ཆགས་པར་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཚོད་མ་དང་མཉམ་པ་མ་ཡིན་པས་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ཚོད་མ་དང་མཉམ་པར་ཟས་ལེན་པའོ།",
    "འབྲུས་ལེགས་པར་དགོས་པའི་ཚད་ལས་མ་ལྷག་པ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཚོད་མ་དང་མཉམ་པར་ལེན་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "མཐར་ཆགས་སུ་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "མཐར་ཆགས་སུ་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་མཐར་ཆགས་མ་ཡིན་པར་ཟས་ལེན་པའོ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་མཐར་ཆགས་པ་མ་ཡིན་པར་ལེན་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྷུང་བཟེད་ལ་བལྟ་ཞིང་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེས་ཞལ་ཟས་བསོད་པ་སྟ་གོན་བྱས་ནས་དེས་དང་པོར་ཟན་བྲིམ་པར་བརྩམས་པ་དང་།",
    "ལྷུང་བཟེད་ལ་བལྟ་ཞིང་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་བལྟ་ཞིང་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་ཅིའི་སླད་དུ་བཅའ་བ་དང་བཟའ་བ་མ་མཆིས་པར་ལྷུང་བཟེད་བཟེད་དེ་གཞེས་པར་མཛད།",
    "འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་མཛད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "བསླབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་བཟེད་པའོ།",
    "དེ་ལ་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་བ་ཞེས་བྱ་བ་ནི་ཇི་སྲིད་དུ་བཟའ་བ་དང་བཅའ་བ་མངོན་སུམ་དུ་མ་འོངས་པ་དེ་སྲིད་དུ་ལྷུང་བཟེད་མི་བཟེད་པ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་བཟེད་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཚོད་མས་འབྲས་ཆན་མི་དགབ་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
