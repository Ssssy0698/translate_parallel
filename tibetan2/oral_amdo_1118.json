    "ནང་གི་བློན་པོ་མོན་བུ་པུ་ཏྲ་བརྒྱ",
    "ཁྱོད་ནི་དམ་ལས་འདས་ན་ཇི་ལྟར་ཡོང་",
    "རང་གི་དགྲ་དང་དགའ་འདུན་བྱས་ནས་འགྲུལ",
    "ཉམ་ང་བག་ཚ་རེ་དོགས་དམ་ལས་འདས",
    "རང་གི་ལུས་སྲོག་ཁ་རྗེར་བཟློག་ཙ་ན",
    "སྲོག་ལ་ཧུར་ཐུམས་འགག་གི་སྤོས་གྲིར་འཆི",
    "དམོད་བཅོལ་མི་བྱེད་ཟུག་འཕྲོ་བཅད་ནས་འཇོག",
    "རང་གི་འཁོར་དུ་ཉེས་སྤྱོད་མང་པོ་འབྱུང་",
    "རེས་འགའ་ངུ་ཞིང་བྲང་བརྡུང་འོ་དོད་འབོད",
    "མ་དང་སྲིང་མོ་ཞང་པོ་ཚ་བོའམ",
    "བུ་སྲིང་མོ་རྣམས་བདག་བྱེད་ཁྱོ་བོ་གསོད",
    "སྒྲུབ་ཁང་འདྲེ་ཅན་སོང་ནས་བཀྲ་མི་ཤིས",
    "སྔགས་པ་དར་བབ་གཅིག་གི་ཆ་ལུགས་བྱསམོག་རེ་རྟ་ཞོན་སླར་བབས་ཁྲིད་ནས་བྱུང་",
    "ཞྭ་མོ་སྐྱ་ལྷེབ་ཕུད་ནས་འདི་སྐད་ཟེར",
    "ཕ་ནི་སྲིན་པོ་མ་ནི་ཀླུ་མོ་ཡིན",
    "སློབ་དཔོན་ཞལ་ནས་དྲང་སྲོང་འོད་འཕྲོ་ཁྱོད",
    "སྤྱིར་ན་གཟའ་བ་ཕོ་མོ་དུ་ཡོད་པ",
    "ཞེས་གསུངས་སྨུག་ནག་འོད་ཟེར་འཕྲོ་ན་རེ",
    "ང་ཡི་ལུས་ལ་རེག་དུག་མཐོང་བའི་དུག",
    "མགོ་ལུས་མེད་པར་མིག་གི་གང་བ་ནི",
    "ཕོ་གཟའ་མོ་གཟའ་དུ་ཡོད་ཅེས་པ་ན",
    "གདུག་ཅན་ཕོ་གཟའ་བརྒྱད་ཡོད་མོ་གཟའ་བཞི",
    "བྱང་སེམས་ཕོ་གཟའ་གསུམ་དང་མོ་གཟའ་གསུམ",
    "བཅོ་ལྔར་ལྟད་མོ་བལྟས་པས་ཟླ་འོད་འགྲིབ",
    "ཡུམ་ནི་ཀླུ་མོ་འདོད་ཆགས་ཆུ་ཡི་དུག",
    "ཁྱོད་ཀྱི་དུག་ཕོག་ཇི་ལྟར་ཡོང་ཞེས་གསུངས",
    "ཁ་ལྐུགས་སྤུ་སྐྱུག་བྱོལ་སོང་སྐད་ཀྱང་འདོན",
    "ཡན་ལག་མཉེན་དང་རེངས་དང་སྟོབས་ཆུང་ཡོང་",
    "མང་ཡུལ་གུང་ཐང་ལ་ཀར་སྔ་འགྲོས་བཏང་བ། དེ་ནས་བསམ་ཡས་དབུ་རྩེ་ཆེན་མོར་བྱོན",
    "མོས་གུས་ཅན་གྱིས་རང་དོན་འགྲུབ་པ་ཡིན",
    "གར་འཁྱོག་མི་ཤེས་བྲང་འོག་བསམ་གཞིག་ཐོང་",
    "ཞག་ནི་གཅིག་སོང་གཉིས་སོང་མི་ཚེ་སོང་",
    "ཨ་རེ་འགྱོད་དེ་བག་ཙམ་འཕྱིས་པ་འདྲ",
    "དོང་མོ་བསྐམས་པའི་ཡུར་བ་བཞིན་དུ་ནི",
    "བོད་ཀྱི་ཕོ་ལུས་མོ་ལུས་ཐོབ་ཚད་རྣམས",
    "པད་འབྱུང་ང་ལ་མོས་གུས་བྱེད་པ་རྣམས",
    "ངུ་འབོད་ཆུང་ངུར་གནོད་པའི་སྡུག་བསྔལ་ལ་ཕུར་རྒྱངས་ཤིང་རྟ་ཁྲབ་དང་ཁྲབ་རེ་༢༡༦བ་དང་",
    "མདུང་ཐུང་སྟེའུ་སྟ་རེ་སོག་ལེས་འཇིག",
    "མཁྲེགས་དང་རེངས་དང་ཡན་ལག་འདར་བའོ",
    "ཉི་ཚེར་ཉིན་རེ་ལན་རེ་འཆི་བ་དང་",
    "ཉེ་འཁོར་དམྱལ་ཁམས་བཅོ་བརྒྱད་བར་མཚམས་རེར",
    "ཐལ་ཚན་ཆུ་བོ་རབ་མེད་ནང་དུ་ནི",
    "དེ་དག་ཐུན་མོང་སྤྱི་ཡི་དམྱལ་ཁམས་བརྒྱད",
    "མཚན་མོ་རྒྱུ་བ་མི་འགའ་ཞིག་གིས་མཐོང་",
    "ཡི་དྭགས་ནང་གི་སྒྲིབ་པ་ཅན་ཞེས་པ",
    "ཟས་ཟོས་ཁྲོ་ཆུ་ཁོལ་མར་སོང་ནས་ནི",
    "རང་གཟུགས་མི་མཐོང་ཉིང་ཤ་ཉིང་གིས་ཟ",
    "གཅིག་ལ་གཅིག་གིས་གཤེད་མའི་སྡུག་བསྔལ་ཡོད",
    "གཅིག་ལ་གཅིག་གིས་ཟ་བའི་སྡུག་བསྔལ་ཡོད"
  ]
