    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་ལྟ་ན་མུན་པའང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉིས་ཀ་སྒྲིབ་པར་བྱེད་པར་འགྱུར་བར་ཐེ་ཚོམ་མེད་པའི་ཕྱིར།",
    "དེའི་དུས་སུ་ཡོད་མེད་གཉིས་ཀ་ཡིན་པ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མ་ཡིན་ཞེས་གོང་དུ་ཡོད་དམ་མེད་པའི་དོན་ལ་ཡང་ཞེས་པའི་སྐབས་སུ་བསྟན་ཟིན་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "ཉིན་མཚན་རང་རང་སོ་སོའི་མཐའ་འདས་པ་ན་ཉིན་མཚན་སོ་སོ་དང་སྔ་དྲོ་ཕྱི་དྲོ་སོ་སོའི་མཐའ་འདས་པའི་ཚེ་རང་རང་སོ་སོ་རྫོགས་ནས་མི་སྡོད་པའི་ཕྱིར་རོ།",
    "དེ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིས་མེད་ཅིང་ཐ་སྙད་དུ་ཡོད་པར་མཚུངས་པའི་ཕྱིར།",
    "འོན་ཀྱང་བུམ་པའི་སྟེང་ན་གཞན་ནམ་ཐ་དད་དང་རང་ངམ་གཅིག་ཡིན་པ་ནི་ཡོད་པར་འདོད་དགོས་སོ།",
    "གལ་ཏེ་འདུས་པ་ཡོད་པས་ཕྲད་པ་དང་ལྟ་བ་སོགས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ་སྙམ་ན་དེ་ནི་མི་འཐད་དེ།",
    "དེས་ན་རང་བཞིན་ཡོད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་ཅེས་བྱའོ།",
    "འདིར་རྣམ་པར་དཔྱད་པ་ན་དངོས་པོ་གང་ཡང་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ན་དེའི་ཚེ་གཞན་གྱི་དངོས་པོ་རང་བཞིན་གྱིས་ག་ལ་ཡོད་དེ།",
    "ཕུང་པོ་དང་གང་ཟག་གང་ཡང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར།",
    "ཉེ་བར་ལེན་པ་དང་བཅས་གང་ཡང་རང་བཞིན་གྱིས་འཆིང་བ་མེད་པའི་ཕྱིར།",
    "ལས་རྣམས་ལས་ཀྱང་རང་རང་དང་རིགས་མཐུན་ཁོ་ན་སྐྱེ་ཞིང་རིགས་མི་མཐུན་པ་མི་སྐྱེ་བའི་སྐྱོན་དུ་འགྱུར་བས་ལྷ་གང་ཡིན་ལྷ་དང་མི་གང་ཡིན་མི་ཁོ་ནར་སྐྱེ་ཞིང་།",
    "དབྱེ་བ་དང་རང་བཞིན།",
    "ལས་དང་རང་བཞིན་མེད་པས་རྟག་ཆད་སྤོང་ཚུལ།",
    "དེའི་ཕྱིར་ལས་ཀྱི་བྱེད་པ་པོ་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "བདག་དེ་ཕུང་པོ་དང་རང་བཞིན་གྱིས་གཅིག་གམ་ཐ་དད་གང་ཡིན་སྙམ་དུ་བརྟག་པར་བྱ་སྟེ།",
    "བདག་ཕུང་པོ་སྤྱི་ཙམ་དང་རང་བཞིན་གཅིག་ཡིན་ན།",
    "ཡང་འགའ་ཞིག་ཏུ་བདག་དང་བདག་མེད་པ་འགའ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དོ་ཞེས་ཀྱང་བསྟན་ཏེ།",
    "དུས་དེ་གཉིས་རང་བཞིན་གྱིས་གྲུབ་ན་དེ་གཉིས་འདས་པ་ལ་བལྟོས་པ་ཡང་རང་བཞིན་གྱིས་ཡོད་པར་འགྱུར་ལ།",
    "དངོས་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མིན་ན་དེ་ལ་བཏགས་པའི་དུས་ལྟ་རང་བཞིན་གྱིས་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "འབྲས་བུ་དང་རྒྱུ་འགགས་པ་རང་བཞིན་གྱིས་གྲུབ་ན་དེ་རྒྱུ་ལ་བརྟེན་པ་ཡང་རང་བཞིན་གྱིས་ཡོད་དགོས་ལ།",
    "རང་ལུགས་ལ་ནི་རྒྱུས་འབྲས་བུ་མ་མཐོང་བར་སྐྱེད་ཀྱང་རང་བཞིན་གྱིས་མི་སྐྱེད་པས་མི་འགལ་ལོ།",
    "རྒྱུ་འབྲས་ད་ལྟར་བ་གཉིས་ལ་ཐ་སྙད་དུ་ཕྲད་པའི་ཆ་སྔ་ཕྱི་བ་ཡོང་ཀྱང་རང་བཞིན་གྱིས་ཕྲད་པ་མེད་པའི་ཕྱིར།",
    "འབྲས་བུ་མ་སྐྱེས་པའི་མ་འོངས་པ་ནི་རྒྱུ་སྐྱེས་པ་ད་ལྟར་བ་དང་མ་སྐྱེས་པ་མ་འོངས་པ་དང་འདས་པ་གཉིས་དང་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་ནི་ནམ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "རྒྱུས་འབྲས་བུ་རང་བཞིན་གྱིས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ན་རྒྱུ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་འཐད་པར་མི་འགྱུར་ལ།",
    "གང་ཞིག་དུས་གསུམ་དུ་རང་བཞིན་གྱིས་ཡོད་པ་དེ་ནི་ཇི་ལྟར་ན་རང་བཞིན་གྱིས་ཡོད་པར་འགྱུར་ཏེ།",
    "གང་ཞིག་ཉེ་བར་བླངས་པ་གཟུགས་ཚོར་སོགས་ལྔ་པོ་དེ་ཡང་རང་བཞིན་ལས་ཏེ་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གཞུང་འདི་རྣམས་ཀྱིས་བརྟེན་ནས་བཏགས་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་འགལ་བ་འབད་པས་བསྒྲུབས་སོ།",
    "མི་རྟག་པར་འཛིན་པའི་ཤེས་པ་རང་བཞིན་གྱིས་གྲུབ་ན་ཡུལ་མི་རྟག་པ་ཡང་རང་བཞིན་གྱིས་གྲུབ་དགོས་ཏེ།",
    "གང་བཟུང་བའི་ལས་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིས་ཉེ་བར་ཞི་བ་སྟེ་མ་སྐྱེས་ལ་དེའི་ཕྱིར་འཛིན་པ་ཙམ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་རྟེན་གང་ལ་ཕྱིན་ཅི་ལོག་རང་བཞིན་གྱིས་ཡོད་སྲིད་ཅེས་བདག་ཉིད་ཀྱིས་ནི་གཟུང་པོར་གནས་པའི་བློས་རྣམ་པར་དཔྱོད་ཅིག་དང་རང་བཞིན་གྱིས་མེད་པར་ངེས་ནུས་སོ།",
    "དེས་ན་ཕྱིན་ལོག་དེ་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར་ཕྱིན་ཅི་ལོག་པ་ཅན་གྱི་གང་ཟག་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་ག་ལ་ཡོད་དེ་མེད་དོ།",
    "གལ་ཏེ་བདག་དང་གཙང་བ་དང་རྟག་པ་དང་བདེ་བ་རང་བཞིན་གྱིས་མེད་ན་ནི་བདག་མེད་པ་དང་མི་གཙང་བ་དང་མི་རྟག་པ་དང་སྡུག་བསྔལ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "སོངས་ཤིག་འདུག་ཅིག་ཟོ་ཤིག་ཅེས་བྱ་བ་ལ་སོགས་པའི་འཇིག་རྟེན་པ་ཡི་ཐ་སྙད་ནི་ཀུན་ལའང་གནོད་པ་བྱེད་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་གྲུབ་པར་འདོད་ན་མི་འཐད་དེ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ལ་གནོད་པ་བྱེད་ན་མི་འཐད་དེ།",
    "དངོས་པོ་གཞན་དུ་གྱུར་པ་ལ་དངོས་མེད་དུ་སྨྲ་བའི་ཕྱིར་དང་རང་བཞིན་གྱིས་ཡོད་པ་གཞན་དུ་འགྱུར་བ་མི་རིགས་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་མེད་དོ་ཞེས་པར་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་ཅིང་།",
    "ཡང་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཉིད་བདག་དང་རང་བཞིན་གྱིས་གཅིག་ཉིད་མ་ཡིན་ཏེ།",
    "རྟག་མི་རྟག་གཉིས་ཀ་སོ་སོ་བ་ཡང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར་རོ།",
