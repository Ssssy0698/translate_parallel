    "སྐྱེ་བ་སྐྱེད་མོས་ཚལ་དུ་འགྲོ་བ་ལྟ་བུར་མཐོང་བའི་ཕྱིར་རྒུད་པའི་དུས་ན་སྡུག་བསྔལ་གྱིས་མི་འཇིགས་ན།",
    "གཞན་ཡང་རང་གི་ཡོན་ཏན་གྱིས་རྒྱན་དང་།",
    "གཞན་ལ་ཕན་འདོགས་པས་དགའ་བའི་སྟོན་མོ་དང་།",
    "བསམས་བཞིན་དུ་སྐྱེ་བའི་སྐྱེད་མོས་ཚལ་གྱིས་དང་།",
    "གང་གི་ཕྱིར་ན་འདི་སྡུག་བསྔལ་གྱིས་འཇིགས་པའམ་སེམས་ལྡོག་པར་འགྱུར།",
    "སློབ་དཔོན་བརྩེ་ཆེན་རྟག་ཏུ་བསྟེན་པའི་བདག་ཕ་རོལ་སྡུག་བསྔལ་དག་གིས་སེམས་གདུང་བ།",
    "འདི་ལྟར་དེ་ནི་བདག་དང་གཞན་གྱི་འཆིང་བ་རྣམ་པ་སྣ་ཚོགས་ཉོན་མོངས་པ་དང་ལས་དང་སྐྱེ་བའི་ངོ་བོ་དག་གིས་ཤིན་ཏུ་བཅིངས་པ་ཡིན་ནོ།",
    "རང་གི་དོན་གང་གཞན་གྱི་དོན་གང་ཡིན།",
    "གཞན་དང་བདག་མཉམ་པའི་སེམས་ཉིད་བརྡ་ལས་བྱུང་བའི་སེམས་བསྐྱེད་པ་རྙེད་པའི་ཆོ་མོས་པའི་སྒོ་ནས་སམ།",
    "ཀུན་བརྗོད་པའི་ཆོ་འཕྲུལ་དག་གིས་ལེགས་པར་སྟོན་པ་དང་།",
    "མི་འགྱིང་བ་དང་བདག་གི་མེད་ལ་མཁས།",
    "བཟོད་དུལ་ཤིན་ཏུ་རིང་སོང་མི་བཟད་པ།",
    "མི་མཐུན་པ་མི་བྱེད་པས་བདག་གི་བ་མེད་པར་འཇུག་པ་སྟེ།",
    "རིགས་སུ་སྐྱེས་པ་ལ་སོགས་པ་ཤིན་ཏུ་རིང་དུ་སོང་བའི་སྒྲུབ་པ་ཡིན་ནོ།",
    "རིང་དུ་མ་སོང་བའི་སྒྲུབ་པས་ནི།",
    "ཞི་དགའ་རང་གི་ལེན་པར་རབ་ཞི་ལ།",
    "ཕྱིན་ཅི་ལོག་གི་བདེ་བ་གཡོ་བ་ནི་གཟུགས་དང་གཟུགས་དང་གཟུགས་མེད་པའི་སྲིད་པའི་དགའ་བ་རྣམས་མི་རྟག་པ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "ལེན་པ་དག་ནི་ཉོན་མོངས་པ་རྣམས་སུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ལྟ་དེ་ལྟར་རིགས་ཤིང་མཐུན་ཚིག་གིས།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་དག་འགག་པ་དང་སྐྱེ་བ་དང་དེ་བཞིན་གནས་པའི་ཕྱིར་འབྲི་བར་ཡང་མི་འགྱུར།",
    "རང་བཞིན་གྱིས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཕྱིར།",
    "རེ་ཞིག་བདག་ཏུ་ལྟ་བ་ཉིད་ནི་བདག་གི་མཚན་ཉིད་མ་ཡིན་ནོ།",
    "དེ་ཉོན་མོངས་པའི་གནས་ངན་ལེན་གྱིས་རབ་ཏུ་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "འདི་གཉིས་ལས་གཞན་པའི་བདག་གི་མཚན་ཉིད་ཀྱང་མི་དམིགས་ཏེ།",
    "རྟག་ཏུ་ཀུན་ནས་མཉམ་པར་སོང་བ་ཡིས།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྟོབས་ཀྱིས་དུས་ཀུན་དུ་མཉམ་པ་ཉིད་དུ་སོང་བས་དེ་ལ་བརྟེན་པའི་ཉེས་པའི་ཚོགས་རིང་དུ་རྗེས་སུ་ཞུགས་པ།",
    "དེ་གང་ལ་མཉམ་ཉིད་དུ་སོང་ཞེ་ན།",
    "གཞན་། དག་གི་སྐྱེ་བ་ཤེས་པ་ནི།",
    "ཡིད་ལ་བྱེད་པ་གང་དག་གིས་མཐུ་དེ་ཡང་དག་པར་འགྲུབ་པ་དེ་སྟོན་ཏོ།",
    "གང་གིས་འཕགས་དང་ལྷ་དང་ཚངས་པ་ཡི།",
    "བདག་ཉིད་ཀྱིས་འཕགས་པ་ལ་སོགས་པའི་བདེ་བར་གནས་པ་མཚུངས་པ་མེད་པ་མཆོག་དང་འཇིག་རྟེན་གྱི་ཁམས་གཞན་དག་དུ་སོང་སྟེ།",
    "ལས་རྣམ་པ་དྲུག་གི་དོན་ལས་བརྩམས་ནས་ཚིགས་སུ་བཅད་པ་བཞི་སྟེ།",
    "ངན་སོང་བ་དག་མཐོ་རིས་འགྲོ་བར་བྱེད།",
    "ངན་སོང་དུ་སྐྱེས་པ་རྣམས་དང་པ་བསྐྱེད་ནས་མཐོ་རིས་སུ་སྐྱེ་བར་བྱེད་པ་དང་།",
    "ལས་དང་སྐྱེ་དང་མཆོག་གི་སྤྲུལ་པ་ཡིས།",
    "ཏིང་ངེ་འཛིན་དཔག་ཏུ་མེད་པའི་རབ་ཏུ་དབྱེ་བ་དག་གིས་སོ།",
    "རབ་ཏུ་ཞི་བ་ནི་ཉོན་མོངས་པ་རྣམས་སོ།",
    "མི་འཕྲོགས་པ་ནི་བདུད་དང་ཕས་ཀྱི་རྒོལ་བ་དག་གིས་སོ།",
    "དགའ་བ་ཡོངས་སུ་སྨིན་པའི་མཚན་ཉིད་ཡིན་པར་རིག་པར་། བྱ་སྟེ་རྒྱུ་གང་གིས་ཡོངས་སུ་སྨིན་པར་འགྱུར་ཞེ་ན།",
    "ཤིན་ཏུ་སྡོམ་ཞིང་ཉོན་མོངས་རྟོག་པ་སྤོང་།",
    "རྒྱལ་བའི་སྲས་ཀྱིས་ཉོན་མོངས་བསལ་བའི་ཕྱིར།",
    "ཉོན་མོངས་པ་ཅན་གྱི་རྣམ་པར་རྟོགས་པ་སྤོང་བ་ནི་རང་བཞིན་ནོ།",
    "དྲན་པས་ཐོས་པ་དང་བསམས་པ་དང་བསྒོམས་པ་བྱས་ནས་རིང་མོ་ཞིག་ལོན་པ་དང་སྨྲས་ནས་རིང་མོ་ཞིག་ལོན་པ་མི་བརྗེད་པ་དང་།",
    "ཇི་ལྟར་རྨ་དང་ཟས་ལ་དེ་དག་གི།",
    "ཉོན་མོངས་པ་དང་བྲལ་བར་སྨིན་པར་བྱེད་པ་ནི་བྲལ་བར་སྨིན་པར་བྱེད་པའོ།",
    "རང་གི་ལུས་དང་ལོངས་སྤྱོད་ཐམས་ཅད་སྦྱིན་པ་དང་།",
    "ཐབས་རིག་གནོད་བྱེད་བཟོད་པ་དེ་དག་གིས།",
    "ཕ་རོལ་སེམས་དགེ་གཅིག་གིས་ཕྱིར་ཡང་ནི།",
    "མཆོག་གི་བསྟན་ལ་གཞན་དག་འདུན་བྱེད་ཅིང་།",
    "རྣམ་པ་ཆུང་དང་མཆོག་དང་འབྲིང་དག་གིས།",
    "ཉོན་མོངས་པ་དང་།",
    "དེ་དག་གིས་དེ་བསྟན་པར་བྱ་བ་ཡང་མ་ཡིན་ཏེ།",
    "རྟག་ཏུ་ཉོན་མོངས་ཚོགས་ཀུན་དང་།",
    "ངན་སོང་དང་ནི་ཐབས་མིན་དང་།",
    "སེམས་འཁྲུགས་པ་རྣམས་ཀྱིས་ནི་རང་གི་སེམས་ཐོབ་པོ།",
    "ངན་སོང་རྣམ་མང་སྡུག་བསྔལ་ཐབས་མིན་སོང་བ་རྣམས།",
    "སྐྱེ་དང་འཆི་དང་ཉོན་མོངས་ངན་སོང་ཀུན་ལས་སྲུང་།",
    "གསུམ་པ་འདིས་ནི་གང་གིས་ན་སྐྱབས་དེ་ཉིད་དཔེ་མེད་ཅིང་མཆོག་ཉིད་ཀྱིས་བླ་ན་མེད་པ་ཡིན་པ་དེ་དོན་དེ་ཉིད་ཀྱིས་སྟོན་ཏོ།",
    "བཞི་པ་འདིས་ནི་རྒྱུ་གང་དག་གིས་སྐྱབས་དེ་དེ་ལྟར་བླ་ན་མེད་པ་ཡིན་པ་དེ་སྟོན་ཏེ།",
    "གང་གི་དོན་དུ་ཞེས་བྱ་བ་ནི།",
    "གནས་ཡོངས་སུ་གྱུར་པ་ལ་ཚིགས་སུ་བཅད་པ་དྲུག་པ་སྟེ་གང་ལ་ཉོན་མོངས་ཤེས་བྱའི་སྒྲིབ་པའི་ས་བོན་དུས་རིང་རྟག་ལྡན་པ།",
