    "ཤེས་ནས་དེ་གཉིས་ཡང་དག་པར།་།",
    "ལུས་ནི་ཡང་དག་རིག་པར་མཛོད།",
    "འཇིག་རྟེན་བདག་མེད་པར་མཐོང་ན།",
    "ཆགས་པ་རྣམས་ལས་རྣམ་པར་གྲོལ།",
    "མི་བདེན་པར་མཐོང་འཆིང་བ་སྟེ།",
    "བདེན་པར་མཐོང་བ་རྣམ་པར་གྲོལ།",
    "ལས་ཀྱི་འབྲས་བུ་མེད་པར་འགྱུར།",
    "ལས་ཀྱི་བྱ་བ་མེད་པར་འགྱུར།",
    "ལས་རྣམས་མ་བྱས་པ་ལས་ནི།",
    "གལ་ཏེ་འདི་ཡི་བྱེད་པར་འགྱུར།",
    "རྣམ་པར་འགྱུར་བ་སྐྱེ་མིན་ཞིང་།",
    "གང་རྣམས་ཀྱིས་འདི་བྱས་མིན་ལ།",
    "བརྟེན་ནས་རྣམ་པར་ཤེས་པ་རྣམ་དྲུག་འཆར་བ་སྟེ།",
    "གང་ལས་དྲན་དང་བློ་དང་ལས་ཀྱི་འཇུག་པར་ཡིན།",
    "འགྱུར་མེད་འཆི་བ་མེད་པའི་གོ་འཕང་ཐོབ་པར་གྱུར།",
    "སྐྱེ་བོ་ཆེན་པོ་རྣམས་ཀྱི་མིག་རྣམས་ཕྲོགས་པར་གྱུར།",
    "བུ་རམ་ཤིང་པའི་རིགས་སུ་རབ་འཁྲུངས་ཐམས་ཅད་མཁྱེན།",
    "སྨྲས་པ་མཁྱེན་པའི་མཆོག་གྱུར་ཐུབ་པ་ཆེན་པོའི་གསུང་།",
    "ཉུང་ངུ་ཅུང་ཟད་ཙམ་ཞིག་ངེས་པར་རྟོགས་པར་མཛོད།",
    "བཅོམ་ལྡན་གྱིས་གསུངས་ཤིང་།",
    "གང་ཞིག་དེ་དག་རྣམས་ཀྱིས་ངེས་པར་འགོག་པ་དང་།",
    "ཡང་དག་འགོག་པ་དེ་ཡི་ཐབས་གང་གསུངས་པའོ།",
    "དགེ་ཞིང་རྣམ་པར་དག་པར་ངེས་པར་གྱུར་པའོ།",
    "ཞིང་ཤེས་པ་ནི་ངེས་པར་དེ་ཡིས་སྔོན་རིག་ཅིང་།",
    "རྒྱུ་ལས་འདི་རྣམས་རབ་ཏུ་འཇུག་པར་ཐོས་ནས་ནི།",
    "འོད་ཀྱི་རྣམ་པར་ཉམས་པར་གཏན་ཚིགས་ཤེས་བྱ་ཅི།",
    "ཐོས་ནས་ཉིད་ཀྱི་ཡང་དག་མིག་ནི་སྐྱེས་པར་གྱུར།",
    "ཤེས་པས་སྟོན་ལ་རྣམ་པར་གཡོ་མིན་བསམ་ལྡན་དག།",
    "བཅོམ་ལྡན་དྲང་སྲོང་ཆེན་པོས་དགེ་སློང་རྣམས་ལ་གསུངས།",
    "གཉིས་ལ་དེ་བཞིན་གཤེགས་པས་འདི་སྐད་ཅེས་གསུངས་ཏེ།",
    "དུས་ཀྱིས་དེ་གཉིས་ཀྱིས་ནི་ངེས་ལེགས་ཐོབ་པར་གྱུར།",
    "གཉིས་སྐྱེས་སྐོམ་པ་སྐྱེས་ཤིང་ཉེ་བར་འོངས་པར་ནི།",
    "མཁྱེན་ནས་བསམ་པ་རྣམ་དག་ཐར་འདོད་དེ་ལ་ནི།",
    "དེ་བཞིན་གཤེགས་པས་ལེགས་པར་འོངས་ཞེས་བཀའ་སྩལ་ཏེ།",
    "གསུང་འདི་ཡིས་ནི་ངལ་བ་རྣམ་པར་སོས་བཞིན་ཏེ།",
    "ངེས་པར་ལེགས་པར་རྟོགས་པའི་ཆེད་དུ་གནས་པ་སྟེ།",
    "མི་གཙང་བདེན་པ་མ་ཡིན་དེ་རྣམས་དེས་ཤེས་ནས།",
    "འདོད་ཆགས་ཤེས་བྱའི་ཡུལ་དེ་སྤངས་པར་གྱུར་པའོ།",
    "དེ་བཞིན་དུ་ནི་བྱམས་པར་གྱུར་པའི་སེམས་ཀྱིས་དེས།",
    "བཤེས་དང་བཤེས་མིན་རྣམས་སུ་ཁྱད་པར་མེད་པ་སྟེ།",
    "འབྱུང་པོ་ཀུན་ལ་རྗེས་སུ་བརྩེ་བ་བྱས་པ་ཡིས།",
    "སེམས་ཀྱིས་གཡོ་ཞིང་སྐྱོད་པར་བྱེད་པ་ཤེས་ནས་ནི།",
    "བརྟན་པའི་བརྟེན་ལས་རྒོད་པ་རྣམ་པར་སྤངས་པ་སྟེ།",
    "ཞི་ཞིང་རྫིང་བུ་གང་བ་བཞིན་དུ་གནས་པར་གྱུར།",
    "ང་རྒྱལ་རྣམ་པར་སྤངས་ནས་ཡོད་མ་ཡིན་ཞེས་རྟོགས།",
    "བཅུ་པོ་འདི་དག་མཐའ་དག་རྣམས་ཀྱིས་རྣམ་པར་གྲོལ་གྱུར་ཅིང་།",
    "བྱ་བ་ཀུན་བྱས་རང་བཞིན་གནས་ཏེ་གནས་པར་གྱུར།",
    "གསུམ་ནི་ཆུད་ཟོས་གྱུར་ཅིང་གསུམ་ནི་ལྷག་པར་ཐོབ་པ་ཡི།",
    "ཉན་ཐོས་ཆེན་པོ་རབ་ཏུ་གཤེགས་པར་མཛད་པའི་ལེའུ་སྟེ་བཅུ་བདུན་པའོ།",
    "དེ་ཡིས་དེར་ནི་ཐུབ་པ་བཞུགས་པ་ཐོས་པ་སྟེ།",
    "རྣམ་དག་སེམས་པ་དེས་ནི་རབ་སླེབ་ིརབ་མཁྱེན་ནས།",
    "རབ་ཏུ་ཕྱག་བྱས་པ་ལ་བདེ་བར་གཤེགས་པས་ིབསྟན།",
    "ངེས་པར་ལེགས་པའི་མགྲོན་འདི་ིརབ་ཏུ་ལོང་མཛོད་ཅིག།",
    "རྣམ་དབེན་ལས་སྐྱེས་ཤི་བའི་བདེན་པ་བསྙེན་པར་མཛོད།",
    "རྣམ་པར་ཉེ་བར་ཞི་ལས་སྡུག་བསྔལ་ཞི་བ་དང་།",
    "མཐའ་དག་རབ་ཏུ་ཚིག་པར་ཡོངས་སུ་རྟོགས་ཅིབཞིན་དུ།",
    "སྲིད་དང་སྲིད་མིན་རྣམས་སུ་སྨོན་པ་མེད་པར་གྱིས།",
    "སྒྱུ་མ་དང་མཚངས་འཇིག་རྟེན་འདི་ནི་ཤེས་བྱས་ནས།",
    "རྟོག་པ་མེད་ཅིང་ཞི་ལ་བདེན་ཞིང་ཆགས་མེད་པར་། སེམས་ནི་སྙོམས་ཤིང་མཚན་མ་མེད་པ་བསྙེན་པར་གྱིས།",
    "ཆགས་པ་རྣམ་པར་བསལ་ནས་ཁྱད་པར་འཕགས་པར་གཤེགས།",
    "གལ་ཏེ་འདི་མི་བསྐྱེད་ལ་དགོངས་པར་གྱུར་ན་ནི།",
    "གལ་ཏེ་འདི་ཡིས་འཇུག་ལ་འདོད་པར་གྱུར་ན་ནི།",
    "འབྱུང་པོ་རྣམས་ནི་འཇིག་རྟེན་ན་དེས་བྱས་པ་ཉིད།",
    "ལས་འབྲས་མེད་པར་འགྱུར་ཞིང་ལུང་ནི་བྱས་མིན་ལ་། ལས་ཀྱི་སྦྱོར་བ་རྣམས་ནི་དེ་ཡི་རྟེན་ཡིན་ན།",
    "རྣམ་པར་འགལ་བ་རྣམ་པ་དུ་མ་མཐོང་བ་སྟེ།",
    "སླར་ཡང་རབ་ཏུ་ཆགས་པར་འགྱུར་བ་ཉིད་ཡིན་ནོ།",
    "འབྲས་མི་རྫོགས་པར་བྱེད་པ་པོ་ནི་གཅིག་པ་ཉིད།",
    "ཐམས་ཅད་ལས་ནི་ཐམས་ཅད་རྒྱུན་མི་འཆད་པར་འགྱུར།",
    "རྟག་པའི་རྒྱུ་ལས་ཁྱད་པར་འགྱུར་བ་མ་ཡིན་ཕྱིརི།",
    "དེ་ཕྱིར་རྟོགས་པར་བྱ་བ་རྒྱུ་ནི་གཞན་ཉིད་དོ།",
    "ནུས་པར་གྱུར་པའི་སྦྱོར་ལ་ཤིན་ཏུ་མཐར་ཐུག་པའི།",
    "དེ་ཕྱིར་རང་བཞིན་གྱིས་ནི་སྐྱེད་པར་རིགས་མ་ཡིན།",
    "སེམས་དང་རྣམ་པར་བྲལ་བའི་རྒྱུ་རྣམས་དག་ལས་ནི།",
    "གང་ཕྱིར་སྐྱེ་དགུ་རྣམས་ཀྱི་མཐའ་ནི་བྱས་མིན་ཏེ།",
    "དེ་ཕྱིར་འཇིག་རྟེན་རྒྱུན་ཆད་མེད་པར་སྐྱེ་བར་འགྱུར།",
    "གང་ཞིག་ཡོན་ཏན་རྣམས་ཀྱི་གཅིག་དང་དུ་མས་བྱས།"
  ]
}