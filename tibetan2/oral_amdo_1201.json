    "གལ་ཏེ་དངོས་པོ་ལ་མེད་ན་ནི་བརྟག་པ་དེ་དག་རིགས་ན་ཁྱོད་ཀྱིའང་གསལ་བ་དང་ནུས་པ་མཚུངས་པར་འགྱུར་རོ།",
    "གང་ཞིག་ཚིག་གི་བརྗོད་པ་འདི།",
    "ཚིག་གི་བརྗོད་པ་ལ་དོན་མེད་དུ་ཟིན་ཀྱང་ཁ་ཡར་བ་ལ་ནུས་པ་མེད་པའི་ཕྱིར་ལུང་ལས་ཇི་ལྟར་གཞག་པ་ངག་ལས་རྣམ་པར་འཇོག་པར་བྱེད་དེ།",
    "དེའི་ཕྱིར་ཚིག་གི་དོན་གཟུང་བར་བྱ་བའི་ཐབས་ངག་གི་དོན་དུ་སྣང་བ་དང་པོའི་མ་གོམས་པའི་སྒྲའི་དོན་དང་འབྲེལ་པ་ཡིན་ཏེ།",
    "གང་དག་སོ་སོར་སྣང་བའི་དོན་རྣམས་ལ་ཕྱིའི་དོན་རལུང་ནིགཞན་ནམ་དེ་དང་འབྲེལ་པ་བོར་ནས་ངག་གི་དོན་དུ་རྟོགས་པར་བྱེད་པ་དེ་དག་གི་ལྟར་ན་ཡང་དེ་ནི་རྣམ་པར་རྟོག་པ་ཙམ་ཡིན་ནོ།",
    "རང་གི་རྐྱེན་དང་རྗེས་འབྲེལ་བས།",
    "དེ་དང་ཁྱད་པར་ལས་ཀྱི་མེད་པ་དག་བཞིན་ཕྱི་རོལ་གྱི་དོན་མེད་ཀྱང་རང་གི་རྐྱེན་དང་རྗེས་སུ་འབྲེལ་པས་རྣམ་པར་རྟོག་པ་སྣ་ཚོགས་པ་སྐྱེད་པར་བྱེད་དོ།",
    "འབྲེལ་པར་ཤེས་པའི་ངག་གི་དོན།",
    "དཔེར་ན་གྲོང་གི་ཕག་པ་བཟའ་བྱ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཁ་དོག་གི་ཁྱད་པར་ལ་ཁྲ་བོ་དང་།",
    "དཔེར་ན་ལུས་ཀྱི་ལས་ཀྱིས་བདག་གི་ལས་ཆད་པར་བྱེད་པ་ལྟ་བུའོ།",
    "ཇི་སྐད་དུ་ཕྱོགས་གྲུབ་པའི་སྒྲུབ་བྱེད་ཡིན་བཞིན་དུ་ཡང་གྲུབ་པ་ལྟར་སྣང་བར་འདོད་ཅེས་བརྗོད་པ་དེ་དག་གི་སྒྲུབ་བྱེད་མ་ཡིན་པ་གཞན་ཉིད་དོ་ཞེས་ཕྱོགས་གྲུབ་པ་དགག་པའི་ཕྱིར་མ་ཚང་བ་ཉིད་ལ་སོགས་པ་གྲུབ་པའི་སྐྱོན་བརྗོད་དོ།",
    "གང་གི་ཕྱིར་འདིས་ཕྱོགས་སྔ་མ་གྲུབ་པོ་ཞེས་བརྗོད་པ་འདི་ལ་ལན་དུ་ཚང་བ་ལ་སོགས་པ་བརྗོད་པར་རིགས་སོ།",
    "གྲུབ་པ་དང་ཕྲད་ན་ནི་བསྒྲུབ་བྱ་གྲུབ་ཟིན་ནས་འདི་གང་གི་གཏན་ཚིགས་ཡིན།",
    "གལ་ཏེ་གཏན་ཚིགས་བསྒྲུབ་བྱ་ལས་སྔར་སྒྲུབ་པར་བྱེད་ན་ནི་བསྒྲུབ་བྱའམ་མ་གྲུབ་ན་འདི་གང་གི་གཏན་ཚིགས་ཡིན།",
    "གླང་གི་རྭ་གཡས་གཡོན་བཞིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་ལྟར་ན་རེ་ཞིག་དང་བློའི་གཏན་ཚིགས་དག་ལ་བསྒྲུབ་པར་བྱ་བའི་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་གསུམ་མ་ཚང་བ་ལྟར་སྣང་བ་ཡིན་ནོ།",
    "གང་གི་ཚེ་དོན་གཏན་ཚིགས་ཡིན་པ་དེའི་ཚེ་ནི་ཚིག་ལས་ཡིན་པ་མ་བཀག་པའི་ཕྱིར་དེ་དོན་ལ་མ་གྲུབ་ལྟར་སྣང་བ་ཉིད་དེ།",
    "རིགས་སུ་ཆུད་མོད་ཀྱང་སེལ་བར་བྱེད་པའི་རང་བཞིན་གྱིས་སུན་འབྱིན་དུ་འགྱུར་རོ།",
    "བསྒྲུབ་བྱ་མེད་པར་ཐལ་བར་འགྱུར།",
    "སྨྲ་པོའི་ངག་གིས་སྒྲུབ་པར་བྱེད།",
    "གཞན་ལ་ནི་སྨྲ་བ་པོའི་ཚིག་གིས་དོན་སྒྲུབ་པ་ལ་སྨྲ་བ་ལས་སྔར་སྒྲོ་བཏགས་ནས།",
    "དེ་སྟེ་དེ་ཉིད་རྟག་པ་ལ་ཡང་མེད་དོ་ཞེ་ན་ནི་ཐུན་མོང་མ་ཡིན་པ་ཡིན་པའི་ཕྱིར།",
    "དེའི་དོན་སོ་སོར་ངེས་པ་ཉིད་ཀྱི་རྗེས་སུ་དཔག་པ་མེད་པ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུ་དག་གི།",
    "ཐུན་མོང་ལྟར་སྣང་རྣམ་པ་གཉིས།",
    "དེས་ཐུན་མོང་གི་མ་ངེས་པ་ལྟར་སྣང་བའོ།",
    "དེ་བཞིན་དུ་མ་ཡིན་ནོ་ཞེས་ཕྱོགས་ཕྱི་མ་ཇི་ལྟ་བ་བཞིན་དུ་ཕྱོགས་སྔ་མ་ཡང་ཡིན་པས་མཚུངས་པ་ཉིད་དུ་ཐལ་མཇུག་བསྡུ་བར་བྱའོ།",
    "ཕྱིན་ཅི་ལོག་གི་ངེས་པ་བ་ཉིད་ནི་ཕྱོགས་གཅིག་ཏུ་ངེས་པ་དངོས་པོའི་གཏན་ཚིགས་སུ་འདོད་པ་ཡིན་ཡང་",
    "ལཕྱོགས་སྔ་མ་ལ་ནི་ཁོ་བོ་ཅག་གིས་སྦྱོར་བ་བཞིན་ཕྱོགས་གཅིག་ཏུ་ངེས་པར་བསྟན་ལྟར་སྣང་བར་བརྗོད་དོ།",
    "འཁྲུལ་པ་ཅན་གྱི་བྱེ་བྲག་གིས།",
    "འདི་ལ་ཡང་འཁྲུལ་པ་ཅན་དང་ཐུན་མོང་མ་ཡིན་པ་དེ་བཞིན་དུ་རྟག་པའམ་སུན་འབྱིན་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་ཕྱོགས་ལ་མ་གྲུབ་པ་བཞིན་གཞན་ལ་མ་གྲུབ་པ་བསྟན་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པར་འགྱུར་རོ།",
    "སུན་འབྱིན་པ་ལ་ནི་ཐུན་མོང་ངམ་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པ་ལྟར་སྣང་བའོ།",
    "གལ་ཏེ་བསྲེག་པར་བྱ་བ་དང་བསྡོངས་པའི་བརྩལ་མ་ཐག་ཏུ་བྱུང་བ་ཉིད་བརྗོད་ན་ནི་མངོན་སུམ་འབའ་ཞིག་པ་མིག་གི་གཟུང་བྱ་མ་ཡིན་པ་ཉིད་དང་རྫས་ཉིད་ལ་སོགས་པས་མ་ངེས་པ་ཡིན་ནོ།",
    "ཐལ་བར་འགྱུར་ཕྱིར་བྱེ་བྲག་མེད།",
    "ཟླ་བོ་མཉན་བྱ་མ་ཡིན་པའི་ཕྱིར་མེད་བཞིན་དུ་གང་དུ་གང་གིས་ན་བསྒྲུབ་བྱའི་ཞེས་གོ་བར་བྱ།",
    "བྱེ་བྲག་མེད་ཅེས་བྱ་བ་ནི་བྱེ་བྲག་མེད་པར་ཐལ་བའོ།",
    "འདི་ལ་ཡང་བྱེ་བྲག་མེད་པར་ཐལ་བར་འགྱུར་བས་ན་བུམ་པ་བཞིན་སྒྲའི་བྱེ་བྲག་ཉིད་རབ་ཏུ་སྟོན་པ་ཡིན་པའི་ཕྱིར་རྣམ་རྟོག་མཚུངས་པ་ལས་ཁྱད་པར་ཆེན་པོ་ཡོད་པ་མ་ཡིན་ནོ།",
    "བྱེ་བྲག་མེད་པར་མཚུངས་པ་སྔ་མ་ལས་ཐ་དད་དུ་བྱ་བའི་དོན་དུ་ཡང་གི་སྒྲ་སྨོས་སོ།",
    "དེ་ལྟར་འདིར་མཉན་བྱ་ཉིད་ལ་གནོད་པ་ནི་མཐོང་གི།",
    "ཇི་ལྟར་རྡུལ་གཉིས་པ་ནི་རྡུལ་གཅིག་སྔོན་དུ་སོང་བ་ཡིན་ཏེ།",
    "ཁྱབ་པ་མེད་པའི་ཕྱིར་ནགས་ཀྱི་ཤིང་ནུབ་མོ་ཉལ་བ་ལས་སེམས་པ་དང་ལྡན་པ་བཞིན་ནོ་ཞེས་སོ།",
    "གཏན་ཚིགས་ཀྱིས་ནི་མ་ཁྱོབ་ཀྱང་།",
    "ཇི་ལྟར་སྦྲུལ་ལ་སོགས་པ་ལ་ཡོད་པའི་མཚན་མོ་ཉལ་བས་ན་ནགས་ན་གནས་པ་སེམས་པ་དང་བཅས་པར་བསྒྲུབ་པ་བཞིན་ནོ།",
    "ཐལ་འགྱུར་མཚུངས་པར་འདོད་པ་ཡང་།",
