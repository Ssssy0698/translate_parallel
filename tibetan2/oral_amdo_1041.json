    "ན་ཙེ་བྷཱ་ག་དྷན་དྲོ་ཧཱཏ་ཀ་ལི་རེ་བ་པྲ་ཛཱ་ཡ་ཏེ།",
    "དེ་ལ་བྱིན་ནས་ཁྱིམ་གཞན་སོང་།",
    "ཉིན་མོར་བྱེད་ལ་འོད་ཟེར་བཞིན།",
    "མེ་སྐྱེས་ཅན་སོང་མི་བདག་གིས།",
    "མ་རེག་ཆུང་མ་ཁྱོ་ཅན་བཞིན།",
    "ཨ་མྲྀ་ཏཱ་ད་པི་དུ་པྲཱ་པ་སོ་ཛ་ནྱ་ཤ་ར་ལོ་ཛ་ན།",
    "མཚན་མོ་བདེ་བར་ཉལ་བྱེད་པ།",
    "ད་ནི་མི་བདག་ཞེ་སྡང་གིས།",
    "དེ་སྲས་སྐྱོན་སྐྱེད་མཚན་མོ་ནི།",
    "ཡ་ཐཱ་ཡ་ཐཱ་བི་བར་ྡྷནྟེ་གྲཱིཥྨོཥྨཱ་བི་བའི་དཔལ་གྱི་ལང་ཚོ་སོང་།",
    "ཀེཾ་བིཏྟེ་རྡུརྣི་མིཏྟེ་ཀ་ལི་ཀ་ལ་ཧ་མོ་ཧ་ལོ་བྷཱ་ནུ་བྲྀཏྟེ་ཀིཾ་བྷོ་གེརྦི་པ་ཡོ་གེརྦྱ་ས་ན་ཤ་ཏ་པ་ཏ་ནཱ་བྷྱཱ་པ་སཾ་སཀྟ་རོ་གེ།",
    "རྩོད་དང་འཐབ་མོ་རྨོངས་དང་ཆགས་པ་ཆེན་པོ་རྗེས་སུ་འབྲང་བའི་ལྟས་ངན་ནོར་གྱིས་ཅི།",
    "དུ་ཁཾ་མོ་ཧཱ་ཡ་མཱུརྑཱ་ཎཱཾ་བི་བི་ན།",
    "བདེ་གཤེགས་གནས་སུ་རབ་ཏུ་སོང་།",
    "དཔལ་གྱི་ལྕགས་སྒྲོག་གིས་མི་ཁུགས།",
    "ཡཱ་ཏེ་དུ་ས་ཧ་མོ་ཧ་དྷཱུ་མ་མ་ལི་ནེ་བྷོ་གཱ་ནུ་རཱ་གཱ་ན་ལེ་སནྟོ་ཥཱ་མྲྀ་ཏ་ནིར་ྫྷརེ་ཎ་མ་ན་སི་པྲཱ་པྟ་ཤ་ནེ་ཤཱེ་ཏ་ཏཱཾ།",
    "བཏུང་བས་མྱོས་ཤིང་རབ་རྒྱུག་རྣམ་པར་གཡོ་རྒྱུན་ན་ཆུང་གཡོ་བའི་སྨིན་འཁྱོག་ཅན།",
    "སྐད་ཅིག་འགྲོགས་པའི་དཔལ་མོ་ཤ་མ་བ་ཏཱཾ་ཀུརྦནྟི་བི་གྷྣཾ་ཤྲི་ཡ།",
    "སཱ་པྲཱ་པྱ་སརྦ་ཤ་མ་ཏཱ་མ་ས་མ་པྲ་ཀཱ་ཤ་ནིརླླ་ཀྵམོ་ཀྵག་མ་ནཱ་ཡ་མུ་འདི་དག་ཞི་ལྡན་རྣམས་ཀྱི་བགེགས་ནི་བྱེད་མ་ཡིན།",
    "དགེ་སློང་གིས་དྲིས་བཅོམ་ལྡན་གྱིས།",
    "ཤསྟཱ་ཐ་ས་མྱཀྶཾ་བུད་ྡྷོ་བི་པ་ཤྱཱི་ནཱ་མ་ཏཱཾ་པུ་རཱིཾ།",
    "ས་སྐྱོང་ལ་རོས་ས་བདག་གིས།",
    "དྲི་མེད་གོས་དང་སྤོས་འཕྲེང་ཁྲུས་དང་དཔག་བསམ་ཤིང་གི་འབྲས་བུ་རྣམས་དག་གིས།",
    "ཀུན་དགའ་བོ་ཞེས་བྱ་བ་རེག་ན་བདེ་བའི་འོད་ལྡན་དགེ་སློང་གིས།",
    "ཤིན་ཏུ་འབད་པས་གང་ཞིག་ཡུན་རིང་ཡོངས་སྒྱུར་སྲུལ་པོར་གྱུར་མོད་ཀྱང་།",
    "སྐྱེས་པ་བུད་མེད་དག་ཀྱང་འཛིན་པ་རྣམ་ཉམས་རེག་པར་ཞུགས་བྱས་ཤིང་།",
    "རཱ་གོངྒཱ་ར་སྥཱ་ཊི་ཀ་ཤ་ཀ་ལཾ་མེ་གྷམམ་ྦྷོ་དྷི་པཱ་ཐ་པུཥྤ་མོ་དསྟི་ལ་ཀ་མི་བཱ་ཤ་ནེ་འགྲོགས་ལ་ལྟུང་གྱུར་པ།",
    "གཅིག་ཏུ་གྱུར་ཅིང་ངེས་པ་འགའ་ལས་ས་བོན་དག་གིས་དངོས་པོར་གྱུར།",
    "པཱུརྞིཾ་མཱ་སེརྣ་བ་བྷི་ར་ཐ་བཱ་བརྟ་ཀརྨ་ཀྲ་མོ་པོ་ཀླེ་ཤཾ་བྷུཀྟེ་ཀི་མ་པི་བི་ཁ་མི་དུ་ཁ་སཾ་ཛྙཱ་པྲ་པནྣ།",
    "སྡུག་བསྔལ་འདུ་ཤེས་རབ་ལྡན་ཅི་ཡང་རུང་བའི་མི་བཟད་ཉོན་མོངས་སྤྱོད།",
    "སྱུ་ཏེ་རནྟརྦི་བི་ཥ་ཡ་སྭཱ་ད་སཾ་བཱ་ད་བྷེ་དེརྦྱཱསྟ་སུཔྟེརྦི་ཥ་པ་ཨི་བ་བྱཀྟ་ཏཾ་ཏུ་མིན་ཞིང་མིག་གིས་མིན།",
    "སྐྱེ་བར་གོམས་པའི་གདུང་པས་བསྐྱེད་པའི་ཉོན་མོངས་གནས་པའི་རོལ་པ་དེས།",
    "མཱུ་ཌྷསོ་ཐ་པྲ་ཀྲྀ་ཏི་པ་ཙི་བེ་རེནྡྲི་ཡེརྡཏྟ་སཾ་ཛྙ་སྟ་ནྱཱ་ལཱ་པཱ་ཀྲྀ་ཏི་པ་རེ་མ་མ་སྤཪྴ་ནེརྦིཏྟི་དྷཱ་ཏྲཱིཾ།",
    "ནུ་མའི་དོན་དུ་བརྗོད་ཅིང་ཡོངས་སུ་མཉེ་བའི་རེག་པས་མ་མ་རིག།",
    "མལ་སྟན་གོས་རྣམས་ལག་པས་བསྐྱོད་པའི་འདར་བྱེད་དག་གིས་མནན་པ་དང་།",
    "པཱི་ཏོ་དྭནྟེཤྪུ་རི་ཏ་པ་ད་ན་པྲོཙྪ་ལཏ་ཀྵཱི་ར་སྟུ་རེ་རུཏྟཱ་ནོ་རསྟ་ལ་ནི་པ་ཏི་ཏེ་རུ་ཀྵི་ཏོ་ལ་ཀྵྱ་ཏེ་སོ།",
    "རྟག་ཏུ་ངུ་ཞིང་ཚིག་དང་བྲལ་བས་ལུས་ཀྱི་ཉོན་མོངས་བརྒྱུད་མ་ནི།",
    "གན་རྐྱལ་བྲང་གི་དབུས་སུ་ལྷུང་བས་མཚན་པས་བྲན་པར་གྱུར་པ་འདི།",
    "སྒྱུ་མའི་བུད་དྷཱ་སྨ་ར་ཎ་ཧ་ར་ཎ་པྲོ་ཌྷཀེ་ལཱི་བི་ལཱ་སེ་ཧ་པེ་ནེ་བལྥུ་རེ་ཏ་རུ་ཙི་ནཱ་ནིར་ྦྷཱ་ར་བྱཱཔྟ་ཀཱ་ཡ།",
    "སོ་ཐ་པྲཱཔྟེ་ལི་པི་པ་རི་ཙ་ཡེ་ཧེ་ལ་ཡཱ་དཏྟ་ཧ་སྟེ་སཾ་སཱ་རེསྨིནྣ་བི་ཙ་ལ་ཏ་ཡཱ་བན་ྡྷལེ་ཁྱ་ཀྲི་ཡཱ་སུ།",
    "རང་བརྟཾ་ནི་ཛ་མི་བ་ལ་ཁ་ན་དཱིར་ྒྷམོ་ཀཱ་ར་མཱ་དོ་བརྒེ་བར་ྒྷེ་བི་ར་ཏི་མ་ཏིཾ་བྷོ་ག་སརྒེ་ནི་བིཥྚ།",
    "པྲཱཔྟ་པྲཛྙཱ་ཀ་ཐ་མ་པིཾ་ག་ལདྦཱ་ལ་བྷཱ་བ་པྲ་མོ་ཧ་ཀ་མོཏྶུ་ཀྱཱ་ཏ་པུ་ན་ར་པི་པ་རི་ཡོ་བ་ནེ་ནཥྚ་སཾ་ཛྙ།",
    "གི་སྐྱེ་བའི་འཁོར་མོ་རིང་དུ་འབྲི་བཞིན་ཨོཾ་ཡིག་ལ་སོགས་པ།",
    "སླད་ནས་ཀྱང་ནི་ལང་ཚོ་དར་ལ་འདོད་པས་རབ་བསླང་འདུ་ཤེས་ཉམས།",
    "ནིསྶཱ་རེ་ཥུ་བྱ་པ་ན་བི་ལ་སད་མེ་གྷསོ་དཱ་མི་ནཱི་ནཱཾ་བ་དྷྭ་ཏྱ་སྠཱཾ་སྠི་ར་ཏ་ར་དྷི་ཡ་ཡོ་ཥི་ཏཱཾ་བི་བྷྲ་མེ་ཥུ།",
    "པཱ་ཏྲི་ཀུརྦྦན་སྡུག་བསྔལ་མཛེས་པའི་སྤྲིན་གློག་བུད་མེད་རྣམས་ཀྱི་རྩེ་དགའ་རོལ་པ་དག།",
    "བུད་མེད་རྣམས་ཀྱི་ཚིག་ལ་རྣ་བ་ལུས་ནི་གཡོ་མེད་འཁྱུད་པ་ལ།",
    "ཁ་ཡི་ཆང་གི་དྲི་ལ་སྣ་དང་དེ་ཡི་རོ་ལ་མྱོང་བྱེད་དང་།",
    "ཨ་སྱཱ་དྷཱ་རེ་བི་ཥ་ཡ་ཛ་ལ་དྷོ་མཛྫ་ཏེ་སཛྫ་ཏཤྩ་བྷྲཥྚ་སྱ་པྲ་ཏི་ཧ་ཏེ་ག་ཏེ་ཀུཉྫ་ར་སྱེ་བ་ཀམྦེ།",
    "ཉིན་ཞག་དག་ནི་ཉུང་ཞིག་གནས་པའི་ལང་ཚོས་ལོང་བར་བྱས་གྱུར་ཅིང་།",
    "བྱིང་ཞིང་མཐའ་ལ་བ་ག་ཏི་ར་ཧི་ཏཱ་ཛཱ་ཡ་ཏེ་མོ་ཧ་མཱུརྩྩ་ནཱི་ཏ་སྱཱ་ན་ྡྷྱཾ་ཀ་ཏི་པ་ཡ་དི་ན་སྠཱ་ཡི་ནཱ་ཡོ་བ་ནེ་ན།",
    "ཡཱ་བཏ་ཁ་ལཾ་བྷྲ་མ་ཏི་ཙ་ལ་ཏི་པྲི་ཡ་ཏེ་ཛྲྀཾ་བྷཏེ་སོ་སྨེ་རཾ་སྨེ་རཾ་བ་ད་ཏིཾ་ད་ནཱ་ལིམ་གི་ཏེ་རཾ་ག་བྷཾ་གེ།",
    "འདོད་པས་འཁྱུད་པའི་ལུས་ནི་འཁྱོག་པས་འཛུམ་ཞིང་འཛུམ་ཞིང་སྨྲ་བྱེད་པ།",
    "ཀཱ་ལེ་ཀཱ་ལེ་ཀྵཎ་ཀ་ལ་ན་ཡ་མོ་ཧི་ནི་དྲཱ་བ་སེ་ན་པྲཱཔྟཾ་ནཱསྨིན་བ་སུ་ཥི་སུ་ཥི་སུ་ཀྲྀ་ཏ་ནི་བ་དཏྟཾ་ན་། དུས་ཀྱིས་རབ་འཕངས་གསོད་རྟགས་མེ་ཏོག་འཕྲེང་།",
    "ཨི་རྠཾ་ཙོ་རེ་རི་བ་ས་མུ་ཥི་ཏ་ཤྩིནྟ་ཡ་ཏྱེ་བ་དུ་ཁཱ་ཏ་སཾ་མཱུ་ཌྷཱ་ནཱ་མ་ནུ་ཤ་ཡ་ཕ་ལ་པཱ་བ་སཱ་ད་པྲ་མཱ་ད།",
    "ལས་ངན་གྱིས་ཐོབ་ནོར་དང་མཚུངས་པས་ལང་ཚོ་རྨི་ལམ་དུ་རྟག་པ།",
    "བུད་མེད་འཇོ་སྒེག་སོས་ཀའི་མེ་ཏོག་འཁྲི་ཤིང་སོང་བ་དེ་ཡི་ཚེ།",
    "བདག་གི་ཚེ་བཏང་སློང་བ་རྣམས་ལ་ཡང་དག་འོས་པའི་སྦྱིན་མ་བཏང་།",
    "གསེར་གྱི་ལྗོན་པའི་འོད་འཕྲོག་ཡིད་འཕྲོག་ལང་ཚོའི་དཔལ་ནི་གང་ན་སྟེ།",
    "ན་ཆུང་འདི་དག་མིག་གིས་རིང་ནས་ཡོངས་སྤོང་ཟུར་ན་ཞེན་གྱུར་པ།",
    "གཱ་ཏྲོཏྶཱ་ཧེ་པྲ་ཧ་ར་ཏི་མ་རུན་ནེ་བ་མོ་ཧ་པྲ་རོ་ཧེ་ཀྵཱི་ཎ་སྱེ་ཡཾ་ཤ་ཡ་ན་ཤ་ར་ཎ་སྱཱ་པི་ཏྲྀཥྞཱ་ཀྵཡཱ་མེ།",
    "མལ་སྟན་ལ་བརྐྱངས་ཟད་པར་གྱུར་ཀྱང་བདག་གི་སྲེད་པ་ཟད་མ་ཡིན།",
    "ལྐུགས་གྱུར་རང་གི་སྐྱེ་བོ་དང་བྲལ་སེམས་ཤིང་ནུས་པ་ཆད་པ་ལས།",
    "ཡཱ་བཛྫནྨ་ནྱ་པི་པུ་ན་ར་ཙོ་སྣེ་ཧ་མོ་ཧཱ་ནུ་བན་ྡྷེསྟེསྟེ་རནྟ་ཀྲྀ་ཏ་པ་རི་ཙ་ཡསྟནྨ་ཡཱི་བྷཱ་པ་མེ་ཏི།",
    "དུ་ཁཾ་དུ་ས་ཧ་པཱ་པ་ཀརྨྨ་ཛ་ནི་ཏཾ་ཀུམ་ྦྷི་ས་ཧ་པྲཱནྟ་རེ་བྷཱུཀྟྭ་རོ་ར་བ་ཀཱ་ལ་སཱུ་ཏྲ་སྙེད་གཞན་ཡང་བསམས་བྱས་པ།",
    "དགའ་བོ་སོང་བར་གྱུར་ཏེ་སྔོན།",
    "ངེས་འབྱུང་གཏམ་དང་གྲོས་དག་གིས།",
    "ཁྱོད་ཀྱི་ཉེ་གནས་སུ་གྱུར་ནས།",
    "རེ་པ་ཀ་ར་ཎེསྟཱ་བཏ་བྷཀྵྱཱ་པ་རི་ཙ་རཱ་མྱ་ཧཾ།",
