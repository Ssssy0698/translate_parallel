    "རང་རང་ཟླ་བསྟུན་གསོ་སྦྱོང་དེར་མཐུན་ནོ།",
    "ཁོ་རང་བྱུང་ནས་ཆགས་བསྐལ་མང་ན་བཅུ་བདུན་ལས་མེད་ལ།",
    "སྡོམ་འདིར་བཀོད་མི་འདུག་ལ།",
    "ཞེས་གསུངས་འདུག་གོ།",
    "འདོད་པའི་སྡུག་བསྔལ་མཐོང་སྤང་རང་ས་ལ་དམིགས་པའི་སྐལ་བ་མཉམ་པའི་ཁམས་ཀུན་འགྲོ་ལྟ་བ་དང་བོ་གཉིས་དང་།",
    "ལམ་ཤེས་ཀུན་རྫོབ་ཤེས་པ་དང་རང་དང་ལྔ་ཡིན་ལམ་ཤེས་ནི།",
    "བསམ་གཏན་དང་བོའི་འབྲས་བུར་གྱུར་པའི་སྤྲུལ་སེམས་ལ་འདོད་པ་དང་རང་སས་བསྡུས་པའི་སྤྲུལ་སེམས་གཉིས།",
    "བསམ་གཏན་གཉིས་པ་ལ་འོག་ས་གཉིས་དང་རང་སས་བསྡུས་པའི་སྤྲུལ་སེམས་གསུམ།",
    "བསམ་གཏན་གསུམ་པ་ལ་འོག་ས་གསུམ་དང་རང་སས་བསྡུས་པའི་སྤྲུལ་སེམས་གཅིག་སྟེ་བཞི།",
    "བསམ་གཏན་བཞི་བ་ལ་འོག་ས་བཞི་དང་རང་སས་བསྡུས་པའི་སྤྲུལ་སེམས་གཅིག་སྟེ་ལྔ་ཡོད་པའི་བར་རིམ་བཞིན་སྦྱོར་བའི་ཕྱིར།",
    "འོག་མར་དམིགས་ཕྱིར་གསུངས་ཀྱང་རང་གོང་འོག།",
    "རྗེས་ཤེས་ཕྱོགས་ཀྱི་ལམ་ཀུན་དམིགས་གསུང་དཔྱདབདེན་པ་གཞན་གསུམ་གོང་དང་རང་ཁོ་ན།",
    "དང་རང་བཞིན་གྱིས་གྲུབ་པར་བརྟག་པར་མི་ནུས་པས་སྤྲོས་པའི་མཐའ་བཞི་དང་བྲལ་བའོ།",
    "ཇི་ལྟ་བ་དེ་ཡང་རང་བཞིན་གྱིས་ཡོངས་སུ་དག་པའི་ཕྱིར།",
    "མགོན་མེད་འདུག་གནས་སུ་ནི་འདུག་གྱུར་ལ།",
    "ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་ཡང་དེར་མ་གྲུབ་བོ།",
    "མ་ཡིག་ཏུ་སྔོན་མའི་ཚིག་རྐང་བརྒྱད་དང་དེའི་འགྲེལ་བ་ཆད་འདུག་ཇི་ལྟར་དཔྱར་གྱི་དུས་ན་སྤྲིན་གྱིས་ཆར་བཟུང་ཞིང་དེ་ལ་བརྟེན་ནས་བབ་པས་ལོ་ཏོག་ཕུན་སུམ་ཚོགས་པའི་རྒྱུར་འགྱུར་ཞིང་ཆུའི་ཕུང་བོ་འབད་པ་མེད་པར་ས་ལ་རྒྱུན་དུ་འབེབས་པ་ལྟར་རོ།",
    "ཁྱེད་རང་དཀའ་ངལ་ཆེ་བའི་རྙོག་དྲའི་རིགས་ལ་དགའ་བོ་ཡོད་པ་ངས་ཤེས།",
    "སྐུ་ཞབས་ལེས་སི་འཁྲེ་སྒྲི་མགྱོགས་མྱུར་ཏུ་ངེད་གཉིས་ལ་ཐུག་དགོས་འདུག་པ་དང་།",
    "ཁང་པ་དེ་སྲང་ལམ་ཁ་ཁུ་སིམ་པོ་ཞིག་ལ་འདུག་ཡིན་ན་འང་ཁང་པ་དེ་ལོན་དྲོན་གྱི་བྲེལ་འཚུབ་ལྟེ་གནས་ལས་བར་ཐག་རིང་པོ་མི་འདུགཞོགས་པ་དེར་ས་ཆ་དེ་རུ་མི་ཚོགས་མང་པོ་ཡར་ལངས་ནས་ཕྱིལོག་ཏུ་འཚང་ཁ་ཤིག་ཤིག་བྱེད་བཞིན་འདུག་པ་དང་ལེས་སི་འཁྲེ་སྒྲི་ཡིས་ངེད་གཉིས་དེར་བསྒུགས་འདུག་ཁོང་ཧ་ཅང་ངོ་གནག་ནས་འདུགཁང་པ་དེའི་མདུན་སྒོའི་ཕྱི་རོལ་ཏུ་ཁྲག་ཧ་ཅང་མང་པོ་ཡོད་པ་ང་ལ་དོ་སྣང་བྱུང་།",
    "འོག་ཁང་ནང་དུ་མི་སུ་ཞིག་ཀྱང་མི་འདུག་འོན་ཀྱང་ཁང་པའི་སྒེའུ་ཁུང་ཕྱེས་འདུག་པ་དང་།",
    "ངའི་ནེ་ཕོ་ལེན་གྱི་འདྲ་སྐུ་ནང་དུ་མི་འདུག་དེར་བརྟེན་ངས་ཁང་པའི་མདུན་སྒོ་ཕྱེས་ནས་ཉེན་རྟོག་པ་ལ་སྐད་གཏོང་དུ་ཕྱིན་པ་ཡིན།",
    "དེ་དུས་ཆུ་ཚོད་འཕྱི་བོ་ཆགས་འདུག་དེར་བརྟེན་ངེད་གཉིས་མགྱོགས་པོ་བྱས་ནས་བྷ་ཁིར་སྲང་ལམ་ལ་ལོག་ཡོང་བ་ཡིན།",
    "སྐུ་ཞབས་ཧོལ་མི་སི་ཁྱེད་རང་གསང་ཞིབ་པ་སྤྱང་གྲུང་འཛོམས་པ་ཞིག་ཡིན་པ་ངས་ཤེས།",
    "ལེས་སི་འཁྲེ་སྒྲི་ཡིས་ཡིན་དང་ཡིན་ང་རྟག་པར་ཁྱེད་རང་ལ་མཇལ་འཕྲད་བྱེད་རྒྱུར་དགའ་བོ་ཡོད།",
    "ང་ཁྱེད་རང་དང་མཇལ་བར་དགའ་བོ་བྱུང་།",
    "ངས་བསྒུག་ཐུབ་པ་མི་འདུག་ང་མག་སྤར་ལན་ཡིན།",
    "ལེས་སི་འཁྲེ་སྒྲི་ཡིས་སྐུ་ཞབས་མག་སྤར་ལན་ལ་ཁ་ཕྱོགས་ནས་འདིར་ཉེན་རྟོག་པ་གཉིས་ཀྱིས་ཕྱི་ལོག་ནས་ཁྱེད་རང་བསྒུགས་ནས་བསྡད་ཡོད།",
    "ངས་ཁོང་ལ་ཁྱེད་རང་ལ་ང་རོགས་པར་དགོས་པ་འདུག་གམ་ཞེས་དྲིས་པ་ཡིན།",
    "ངས་ཁོང་ལ་ཁྱེད་རང་བྷི་ལེ་ཁི་ཧེ་ཐི་ལ་ཕྱིན་མེད་དམ་ཞེས་དྲིས་པ་ཡིན།",
    "ཁང་མཐིལ་དུ་མི་གཉིས་ཀྱི་རྐང་རྗེས་དང་ནང་དུ་ཁྲག་ཏོག་ཙམ་འདུགངས་མདུན་ཅོག་ཐོག་ཏུ་ཡོད་པའི་ཤོག་ལྷེ་རྣམས་ལ་བལྟས་པ་ཡིན།",
    "ཝ་ཟིན་ཁྱེད་རང་ང་མཉམ་དུ་འགྲོ་ཐུབ་པ་འདུག་གམ།",
    "ཨོལ་སྒྲེ་ཁིར་དང་མག་སྤར་ལན་གཉིས་ཀྱིས་ཤོག་ལྷེ་ཚོའི་ཐོག་ཏུ་ལས་ཀ་བྱས་སྐབས་ཁོ་གཉིས་ཀྱིས་ལ་ཆ་དམར་པོ་མང་པོ་བེད་སྤྱོད་བཏང་འདུག་ཁོང་གཉིས་ཀྱི་དེ་ཤོག་ཆག་ཁ་རྒྱག་པ་ལ་བེད་སྤྱོད་བྱས་འདུག་ཅེས་དང་།",
    "ངས་ཀྱང་ང་ཡང་སྐྱིད་པོ་འདུག་ཅེས་ལན་བཏབ་པ་ཡིན།",
    "ངས་ལས་ཀ་ཡག་པོ་བྱེད་ཐུབ་པ་མི་འདུགཁོ་མི་ལོ་ཆུང་ཆུང་ཡག་པོ་ཞིག་ཡིན།",
    "ཁྱེད་རང་འདིར་ཡོང་བ་ལ་ང་དགའ་བོ་བྱུང་སྐུ་ཞབས་ཧོལ་མི་སི།",
    "སྐུ་ཞབས་ཧོལ་མི་སི་ཁྱེད་རང་ཡང་དེ་ཚོ་ལ་དགའ་བོ་ཡོད་པ་ངས་མཐོང་ཐུབ་པ་འདུག་འདི་ཚོ་དམིགས་བསལ་གྱི་ཐ་མག་ཅིག་ཡིན།",
    "གཅིག་བྱས་ན་ཉིན་གུང་ཟ་མ་རྗེས་ལ་ང་ལ་དྲི་བ་ཞིག་ཁྱེད་རང་ལ་ཡོད།",
    "ཁྱེད་རང་ལ་ག་བ་ནས་གནས་ཚུལ་དེ་རག་བྱུང་།",
    "དེར་ས་ཆ་གཅིག་མ་གཏོགས་ཁང་མཐིལ་ཚང་མ་དེབ་ཀྱིས་གཡོགས་འདུགངའི་སེམས་ལ་གཅིག་བྱས་ན་དེར་གསང་བའི་ས་ཆ་ཞིག་འདུག་བསམ་བྱུང་།",
    "ཞི་མི་དེ་ང་ལས་རྒྱ་ཐང་རིང་པོར་སྡོད་ཀྱིན་འདུགངའི་ཕུ་ལོས་ཁྲོ་ངའི་ཐག་ཉེ་སར་ཡོང་རྒྱུའི་འདོད་པ་མི་འདུགངས་ཁོ་དམ་པོ་བྱས་ཏེ་བཟུང་ནས་ཡར་བླངས་པ་ཡིན།",
    "ཞལ་འདམ་དེ་ད་དུང་ཆ་ཚང་རློན་པ་བྱས་ནས་འདུགང་ཧང་སངས་ནས་རྩིག་གྱང་རྗེས་མ་དེ་ལ་མི་རྣམས་ཀྱིས་འཚང་ཁ་བྱས་ནས་ལྟ་བཞིན་པ་ལ་བལྟས་པ་ཡིན།",
