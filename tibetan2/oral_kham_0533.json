    "སྔར་གྱི་ཡིག་རྙིང་དཀར་ཆག་ཏུ་དེ་ལྟར་འཁོད་འདུག་པས་དགོས་པ་ཞིག་ཡོད་ཤས་ཆེ་སྙམ་དེ་ནང་ལྟར་བཀོད་པ་ཡིན་ནོ།",
    "དྲི་བའི་ཚུལ་དུ་ཞུས་པར་དགག་པའི་རིམ་པ་འགའ་ཞིག་གནང་འདུག་པ་ལས།",
    "དེ་ཡང་སློབ་དཔོན་པདྨའི་གསུང་ལ་ཁ་གཡར་བའི་ལུང་བསྟན་ཡིན་ཚུལ་ཚིག་དམ་དུམ་ཁ་ཤས་ཡོད་འདུག་པའི་ནང་ནས་སྔོན་ཆད་མིག་ལམ་དུ་སོན་པར།",
    "རིས་མེད་མཁས་གྲུབ་གཞན་གྱི་གསན་གཇིགས་ཀྱི་ཡུལ་དུའང་གྱུར་མི་འདུག་པས་དེའི་ཁུངས་ཚད་ལྡན་མེད་པ་ནི་དེ་གས་གྲུབ་ཅིང་།",
    "བི་རོ་ཙ་ནའི་སྐྱེ་བ་ཞིག།",
    "དེ་ལ་བརྟེན་ནས་ཉི་ཟླ་བབས་པ་སོགས་ཀྱི་ངན་ལྟས་བྱུང་ཚུལ་ལབ་ན་རྒྱབ་སྐྱོར་དུ་ཨེ་འགྲོ་སྙམ་པ་ཡིན་འདུག་ཀྱང་།",
    "སྔར་ཇོ་བོ་ས་འོག་ཏུ་སྦས་པའི་དུས་སུའང་རབ་གནས་ཉམས་ནས་ཉི་ཟླ་མར་བབས་སྙམ་པའི་དོགས་པ་ནི་ཁྱི་རྒན་རྒྱ་བོ་ལ་ཡང་མ་བྱུང་འདུག་པས་སོ།",
    "དེ་ཡང་གྲངས་ངེས་འདོགས་ཁ་བོ་བྱས་ན་བདེན་པར་འཛིན་ཨེ་ཡོང་བསམས་པ་ཡིན་འདུག་ཀྱང་།",
    "ཁོ་རང་དང་རིགས་མཐུན་བྱུང་ན་མ་ག།",
    "མཚམས་མེད་ལྔ་དང་ཉེ་བའི་མཚམས་མེད་ལྔ་བྱས་ཀྱང་ཉི་ཟླ་མགོར་བབས་ཡོང་སྙམ་པ་ནི་སུ་ལའང་མི་འདུག་ན།",
    "པདྨ་གླིང་པ་གཉིས་ལ་ཁག་བྱུང་བ་ལྟར་ཕལ་ཆེར་མིན་ནམ་དགོངས་པ་ཞིག་ཀྱང་བྱུང་འདུག་རུང་།",
    "པདྨ་གླིང་པ་ལ་ངོ་འདྲ་གཉིས་བྱུང་ཚུལ་ཞིག་ཀྱང་འདུག་པ་ལྟར་ན་འདྲ་མིན་དེས་མ་བྱས་པའི་ངེས་པ་ནི་ག་ལ་མཆིས་ཀྱང་།",
    "ཤཱཀ་མཆོག་པ་དེ་རྗེ་ཐམས་ཅད་མཁྱེན་པ་ལ་མ་གུས་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "གཞུང་ལུགས་ལ་སྦྱངས་པ་མཛད་ཅིང་མཁས་པའི་ཁུར་ཆེ་ཙམ་བཞེས་པ་ཞིག་ཡིན་འདུག་ན།",
    "རང་རང་རིགས་མཐུན་མགྲིན་པ་བཟང་བོའི་ཁྱུར།",
    "ཁ་སང་ནུབ་སྔོན་མ་ལ་བུམ་པ་ཆུས་བཀང་བསྟེར་རྩིས་བྱེད་པའང་འདིའི་ལྟས་སུ་འདུག་དགོངས་པ་བྱུང་ཞེས་གསུངས་ཏེ།",
    "བཞེངས་ནས་བསྐོར་བ་འགའ་ཡར་ཞིག་མཛད་ནས་བཞུགས་གདན་ལ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་ཏེ།",
    "དེའི་སྟོབས་ཀྱིས་བར་ཆད་ཀྱི་མཚན་མ་དེའང་མྱུར་དུ་ཞི་འགྲོ་བ་ཞིག་འདུག་ཅེས་གསུང་ངོ།",
    "སྐབས་སྐབས་ཤིག་ལེགས་པར་གོ་བ་ལ་རག་ལས་པར་འདུགའདིར་རྗེ་རྟོགས་ལྡན་པར་མནལ་ལྟས་བྱུང་ཚུལ་སྐོར།",
    "མཆོད་རྟེན་གྱི་གོ་ས་གཅིག་འདུག་པ་དེར་གསོལ་བྱས་པས་ད་ལྟ་མཆོད་རྟེན་མི་འདུག་པ་ཟེར།",
    "གཞན་མང་པོ་ལ་གསོལ་བྱས་པས་བཅོས་དགོས་པར་འདུག་པས་མི་གསོལ་ཟེར།",
    "བདེ་མཆོག་སྟེ་གཙོ་བོ་གསུམ་ཡང་རང་བྱོན་ལྟ་བུར་བྱོན་ཞིང་།",
    "གྲོགས་ཁྱད་པར་ཅན་མཛད་པ་ཡིན་པར་འདུག་ཅེས་གསུངས།",
    "དབྱངས་ཀྱི་ང་རོ་དང་བཅས་ན་ཤིན་ཏུ་དགྱེས་པར་འདུག་པས་འདི་བཞིན་བྱེད་པ་ཡིན་གསུངས་ནས།",
    "རྐང་རྟེན་བཅས་པའི་ཁྲི་ལ་རབ་འདུག་ཅིང་།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "དམའ་བའི་སྟན་ལ་འདུག་པ་དང་།",
    "འཆད་པར་མཛད་པ་འདུག་སྟེ།",
    "ཞེས་ཟེར་བ་འདུག་ཅེས་བྱུང་སྟེ།",
    "སྣ་ཚོགས་ཚོན་དང་ཕྲད་པའི་ཤེལ་བཞིན་གྲངས་མེད་གདུལ་བྱའི་རང་རང་སྐད་དང་མཐུན་པར་ནི།",
    "གང་ཟག་གཅིག་ལ་སྔགས་དང་མཚན་ཉིད་ཀྱི་ཐོས་བསམ་གཞི་མཐུན་དུ་འདུག་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "གྲུབ་ཐོབ་ཡིན་པའི་རྟགས་སུ་འདུག་ཟེར་བ་དང་།",
    "མཁས་གྲུབ་ཡིན་པའི་རྟགས་སུ་འདུག་ཟེར་བ་བྱུང་ཡང་བློ་ཆུང་བ་དང་།",
    "དེ་ཕྱིར་འདྲེན་པ་འདིས་ཀྱང་རང་གཞན་ཀྱི།",
    "ལུགས་དེ་ཉིད་གཞིར་བྱས་པ་ལའང་རང་ཚིག་འགལ་བའི་ཉེས་པ་མན་གཅིག་མ་ཡིན་པར་འབབ་པ་དག་མཐོང་བ་ལགས་ན།",
    "ཡང་རང་ཚིག་དངོས་ཤུགས་འགལ་བ་དང་།",
    "པཎ་ཆེན་གྱིས་ནི་དཔྱད་གཞི་ཙམ་དུ་མཛད་པ་ཡིན་པ་མས་སྐྱོན་ཅན་གྱི་དགག་པ་མཛད་པ་མི་འདུག་གཞན་དགག་ཚིག་བྱེད་པ་དུ་མ་ནི།",
    "དེ་ནི་ང་རང་ལ་སྔ་ཕྱིའི་བར་ཆད་ཆེས་པ་དང་།",
    "ཞེས་པའི་ཚིགས་བཅད་གཅིག་བྲིས་པའི་དཔེ་ཞིག་བཞུགས་འདུག་པ་ལ་བསམས་ན་བཟོ་རིག་རྣམ་དག་མཁྱེན་པའི་རྟགས་དང་།",
    "ཞེས་སོགས་ཞུ་ཡིག་རྒྱས་བསྡུས་གཉིས་ཕུལ་འདུག་པ་ལ་བསམས་ན་ཡང་།",
    "ཁོང་ལ་ཡང་ཉམས་མྱོང་དང་གོ་བ་བཟང་པོ་ཞིག་འདུག་སྟེ།",
    "ཞེས་མགུར་ཞིག་གསུངས་འདུག་པ་དང་།",
    "དེ་ཉིད་ཀྱིས་འཇམ་དབྱངས་བཀྲ་ཤིས་དཔལ་བཟང་ལ་གསུངས་ཚུལ་ཁོང་ནས་ང་རང་ལ་གསུངས་བྱུང་བ་དང་།",
    "སྡོམ་པའི་སྲུང་སྡོམ་སོགས་ལ་མ་འབད་པར་དང་པོ་ཉིད་ནས་ཀུན་རྟོག་བཟང་ངན་ཐམས་ཅད་བཀག་ནས་དམིགས་པ་གང་ཡང་ཡིད་ལ་མི་བྱེད་པའི་ཙོམ་འཇོག་བྱས་པ་ཁོ་ན་ལས་མཆོག་ཏུ་གྱུར་པ་མེད་འདུག་སྙམ་དུ་སེམས་པ་མང་ལ།",
    "མི་གསལ་བའི་བྱིང་བ་དང་བྲལ་བ་ཞིག་དགོས་པས་ན་དྲན་ཤེས་བཞིན་གྱི་བྱ་ར་དང་མ་བྲལ་བ་ཞིག་ངེས་པར་དགོས་རྒྱུ་ཡིན་འདུག་པ་ལས།",
    "རྒྱ་ཧོར་གྱི་ཡུལ་གྲུ་རྣམས་སུའང་གདན་ས་པ་ཆེན་པོ་རྣམས་ཀྱི་རྗེས་སུ་ཞུགས་པའི་དགེ་དགོན་མ་ཙམ་ཡོད་འདུག་པ་ལས།",
    "གཟན་ཤམ་སྟོད་འགག་སོགས་རབ་ཏུ་བྱུང་བའི་རྟགས་ཆ་ལུགས་ཙམ་ལ་ངེས་པར་སྐྱབས་བཅོལ་བ་མང་དུ་འདུག་པ་དེ་གང་ཞིག་ཡིན།",
    "དེས་ན་ཁྱེད་རང་ཡང་མཛེས་སེ་ཁབ་ཏུ་བཞེས།",
    "སྐྱེས་མཆོག་མར་པ་ལོ་ཙཱ་ཁོང་ནི་འགྲོ་བའི་དོན་དུ་ཡུམ་བཞེས་འདུག་དེ་ལྟ་བུའི་ཡོན་ཏན་དང་ནུས་པ་བདག་ལ་མེད་པས།",
    "དེ་ཕྱིན་ཆད་འདུག་བའི་བཅས་མཚམས་ཕྲ་ཞིང་ཕྲ་བ་ཐ་ན་རུང་ཆུ་འདེབས་པ་ཚུན་ཆད་མ་ཉམས་པ་བ་ཕྱག་ལེན་དུ་བསྟར་ཞིང་།",
    "ཐོ་ལས་བྱས་པར་འཛིན་ཞིང་འདམས་པ་བྱུང་འདུག་ལ།",
    "གཟི་བརྗིད་ཀྱི་ཟིལ་ཤིན་ཏུ་ཆེ་བར་འོང་བ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "བཅས་དང་རང་བཞིན་ཉེས་པས་ཆ་ཙམ་ཡང་།",
    "མྱུར་དུ་འཚང་རྒྱ་བའི་ཐབས་སུ་འགྱུར་བར་འདུག་སྟེ།",
    "སྤྲོ་སྣང་རྣམ་དག་འཆར་གྱིན་འདུག་ཅེས་དང་།",
    "འདུག་གོ།",
    "ཡང་རང་ཉིད་ལ་ཕྱོགས་འབུལ་བྱེད་མི་དུ་མ་གོང་འོག་ནས་བྱུང་བ་དང་།",
    "ང་རང་རྣམས་ཀྱིས་བྱས་པ་ཡིན་ལ།",
    "གཞན་གྱི་དགེ་དང་མི་དགེའི་ཡུལ་ཅི་ཞིག་མངོན་དུ་གྱུར་ཀྱང་བདེ་སྟོང་སྒྱུ་མ་ལྟ་བུའི་བློས་མ་ཟིན་པ་ནི་མི་འོང་འདུག་ཅེས་གསུངས་པ་དང་།",
    "གྲུབ་ཆེན་ཕལ་ཆེ་བ་དག་མཐུན་པ་ཉིད་དུ་ཡིད་ལ་བརྣགས་ཏེ་འདུག་གོ།",
    "བདག་ཅག་བཏང་སྙོམས་འདུག་པ་མི་རིགས་ཞེས།",
    "ཕྱག་རྒྱ་བ་གཉིས་ཀ་ལ་མ་བྱུང་འདུག་སྙམ་དུ་རྗེའི་སྐུ་ཆེ་བའི་ཡོན་ཏན་དྲན་ནས་དད་པ་ཆེན་པོ་བསམ་གྱིས་མི་ཁྱབ་པ་འཁྲུངས།",
