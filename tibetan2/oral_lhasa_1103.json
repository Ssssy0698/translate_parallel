    "གསད་གྱི་རིགས་བཞིན་ཤེས་པར་བྱ།",
    "ལ་ལ་གཅིག་ཏུ་ཉེས་པར་སྤྱོད་ངེས་ཡོད།",
    "གཅིགཏུ་ཉེས་པར་སྤྱོད་པ་དང་།",
    "དེ་དག་ཐཔར་རྣམ་པ་གཉིས་མཆོག་ཕུན་སུམ་ཚོགས་འགྱུར་གང་ཡིན་དེ།",
    "བ་དང་རྒྱས་པའི་ཆེབ་ཡིན་པར་རིག་པར་བྱའོ།",
    "མཆོག་ཅེས་བྱབ་ནི་ཁྱད་པར་དུ་འཕགས་པའོ།",
    "སའདུན་ལ་ནི་ལྷག་པའི་བསམ་པ་རྣམ་པར་དག་པའོ།",
    "ས་བརྒྱད་པ་ལ་སོགས་པ་ནི་རྣམ་པར་སྦྱིན་པའོ།",
    "དེ་ལརྣམ་པར་གཏན་ལ་དབབ་པ་ནི་འདི་ཡིན་ཏེ།",
    "རྟག་ཏུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གོམས་པ་ནི་ངེས་པར་འབྱུར་བའོ་ སནི་མཐར་ཐུག་པ་ཡིན་ཏེ།",
    "གཞན་གྱིས་བསྟན་ཞིང་གཞན་གྱི་རྣམ་པར་རིག་བྱེད་ལས་སེམས་བསྐྱེད་པ་གང་ཡིན་པ་དེ་ནི་ཡང་དག་པར་བླངས་པ་བརྡ་ལས་བྱུང་བཞེས་བྱའོ།",
    "དོན་དམ་པའི་སེམས་བསྐྱེད་པར་ཚིགས་སུ་བཅད་པ་བདུན་ཏོ།",
    "སྐྱེས་ཕྱིརདེ་ནི་དམ་པར་འདོད།",
    "དེ་ཡི་རབའགའ་ཁྱད་པར་འཕགས།",
    "༦ སྤྲོ་ཁར་ཁོང་དུ་ཆུད་པར་བྱ།",
    "བསམ་པ་དག་པར་ཤེས་པར་བྱ།",
    "དོན་དམ་པ་པའི་སེམས་བསྐྱེད་པས་། དེ་ཉིད་ལ་དོན་རྣམ་པ་དྲུག་ཏུ་རིག་པར་བྱ་སྟེ།",
    "དེལ་སྐྱེ་བ་ནི་ས་བོན་དང་མ་དང་མངལ་དང་མ་མའི་བྱེ་བྲག་ལས་རིག་པར་བྱའོ།",
    "སཇི་ལྟར་རྣམ་པར་བཞག་པ་བཞིན་ཡིད་ལ་བྱེད་པས་སོ།",
    "རྟོག་པ་ཉིད་དུ་ཞེས་པ་དེ་ཉིད་ལ་ཡང་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་རོ།",
    "ལྷག་པའི་བསམ་པནི་ཁྱད་པར་རྟོགས་པའི་བསམ་པའོ།",
    "གདུལ་བའི་ལོ་ཞིག་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "སོ་སོ་ཡངདག་པརརིག་པ་དང་ལྡན་པནི།",
    "སེམས་བསྐྱེད་པ་བསྔགས་པར་ཚིགས་སུ་བཅད་པ།",
    "དེའི་ཕྱིར་འདི་ངན་འགྲོས་འཇིགས་པར་མི་འགྱར་རོ།",
    "དེའི་ཕྱིར་འདི་བྱ་བ་མང་པོས་ཡོངས་སུ་སྐྱོ་བས་ཀྱང་འཇིགས་པརམི་འགྱུར་རོ།",
    "མི་བྱེད་པའི་སྡོམ་པ་ཐོབ་པར་། ཚིགས་སུ་བཅད་པ།",
    "སེམསཅན་ཡུལ་བད་འདོར་བར་དགག་པར་ཚིགས་སུ་བཅད་པ།",
    "རྒྱལ་སྲས་རྣམས་ཀྱི་སྒྲུབ་པ་ཡིན་པར་འདོད།",
    "དེ་ལ་གཉི་གཁྱད་པར་མེད་དོ།",
    "གཞན་གྱི་དོནཁྱད་པར་དུ་བྱ་བར་ཚིགས་སུ་བཅད་པ།",
    "ཤིནཏུ་བརྩེ་བ་མེད་པར་རབ་ཏུ་འཇུག་མ་ཡིན།",
    "ལེག་ས་པར་སྟོན་དང་མགུ་བྱེད་འཇུག་བདར།",
