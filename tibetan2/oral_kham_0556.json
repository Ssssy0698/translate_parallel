    "མ་འགགས་པ་ཐབས་དང་རང་བཞིན་མེད་པ་ཤེས་རབ་ཉིད་གྱི་ངང་ལ་གནས་ཤིང་།",
    "སྦྱོར་བ་ལལས་བྱུང་བའི་མངོན་ཤེས་འགྲོ་དྲུག་དུས་གནས་དེ་དག་ཐམས་ཅད་སྣང་།",
    "མིའི་རྒྱུ་ནས་བདུད་རྩི་ལྔའི་ཚོམ་བུ་བརྒྱད་པ་སྐེ་རག་ཏུ་འདོད་པའང་འདུག་གོ།",
    "ལོག་འཚོ་ལ་སོགས་པའི་གཞན་ལ་གནོད་པ་མེད་པར་རང་རང་བཞིན་གྱི་གྱིས་རྩོལ་བཀྲོལ་མེད་དུ་འགྲུབ།",
    "རྒྱ་ཆེ་ཆུང་ལ་སོགས་པ་ཁྱད་པར་འདུག་གོ།",
    "ཞུས་ན་དམ་པ་ཀུན་དགའ་གྲགས་ཀྱི་ཡིག་རྙིང་རང་མི་དགོས་འདྲ།",
    "མ་གཞི་རང་ནས་ཞེས་ཕལ་སྐད་ལ་གྲགས་པ་ལྟར་གནོད་པའི་གཞི་ལ་རང་ཡིན་པས་ཚིག་སྡུད་བྱས་ནས་བྱེད་མ་ཁ་ཁ་སོགས་ཡིན་ཀྱང་འགྲེང་བུ་མེད་པའི་བྱད་མ་བྲིས་པ་མང་བས་བྱད་དང་སྦྱོར་རྩུབ་ལྟ་བུ་ལའང་འཇུག་གང་ཡང་མི་ཤེས་པ་རྣམས་དེས་ལ་ཞིབ་ལྟ་མི་བྱེད་པར་བྱེ་མ་ཁ་ཁ་ཟེར་མཁན་ཡང་འདུག་པས།",
    "སྒང་དུང་རང་རྡོ་རྗེ་ཐུགས་ཀ་དྲིལ་བུ་རྒྱུན་ཆགས།",
    "གཞུང་རང་ན་རྒྱས་པར་བདུད་རྩི་ལྔ་མཆོད།",
    "ཉེར་དྲུག་ལ་ནག་པོ་མཆོད་རྟེན་ལས་བསྐང་གསར་མེད་པའི་ཉེར་དྲུག་དུས་གཏོར་ཡིན།",
    "གྲི་གུག་བྷནྡྷ་གཞན་གྱིས་བཟུང་ཕོད་པ་རྗེས་ཞེས་ད་ལྟ་གཞུ་ཤུབས་གཉིས་རྒྱབ་ཏུ་ཐུང་ངུར་སྡུད་པ་ཞིག་འདུག་དྲག་ལས་ཀྱི་གཞུང་རྣམས་སུ་ཐུ་བ་གཡས་བརྫེས་གཡོན་པ་བརྗེས་བྱ་ནས་ཞེས་པ་ལྟར་ན་དེ་ལྟར་དགོས་རྒྱུ་ཡིན་འདྲ།",
    "མའི་ལྟོར་བུ་དཀྲིས་ཤིང་འདུག་པའི་གནས་ནི་མངལ་ཏེ།",
    "ཡུལ་གཅིག་ན་ལྷན་ཅིག་ཏུ་རྒྱུར་བྱས་པའི་གཟུགས་གཉིས་འདུག་པ་མེད་པའིཕྱིར་རོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "མངལ་གྱི་གནས་སྐབས་ནནུར་ནུར་པོར་འདུག་པ་ལ་སོགས་པའི་ཚོན་བར་མ་དོར་འཆི་བདག་ལ་ཡོངས་སུ་རྫོགས་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྤྱི་མཚན་དང་རང་མཚན་གྱི་དོན་དེ་དང་དེ་དྲག་གོ་བར་བྱེད་པ་ལ་བ་ལང་དང་རྟ་ཞེའམ།",
    "མཁས་རྣམས་དྲི་ནི་རྗེ་ཕྱོགས་མིན་འགྲོ་སྟེ།",
    "ཡི་དྭགས་རྣམས་ཀྱི་ལུསནི་རོ་གྱུར་ཏེ་འདུག་གོ།",
    "དེའི་ཚོ་འཇིག་རྟེན་འདི་ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་གྱུར་འདུག་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཡིན་ལ་གང་བར་གྱི་བསྐལ་པ་ཉི་ཤར་འཇིག་པར་འགྱུར་བ་དེ་ལ་ནི་ཞུགས་པ་ཡིན་ནོ།",
    "དེའི་ཚོའཇིག་རྟེན་འདི་ཞིག་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤར་འདུག་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཞེས་བྱ་ལ།་",
    "ཆགས་ནས་བུར་གྱི་བསྐལ་པ་ཉིཤུར་འདུག་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་འོངས་པ་ཡིན་ནོ།",
    "ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "ཞིག་ནས་སྟོང་པར་འདུག་པ་དེའི་ཚོ་ཡར་སྐྱེ་བ་དང་མར་འགྲིབ་པ་ནི་མི་འཇུག་ཏུ་ཟིན་ཀྱང་དུས་ནི་མཉམ་པར་ཡོངས་ས་བརྩི་བ་ཡིནནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་འཕགས་པའི་ལམདང་ལྡན་པ་ཡང་འཕགས་པའི་ལམ་ལ་གནས་པ་ཡིན་པས་ཐ་མལ་པར་འདུག་པའི་འཕགས་པ་དག་ཀྱང་ད་ལྟར་གྱི་ཟག་པ་མེད་པའི་སྡོམ་པ་དང་ལྡན་པར་འགྱུར་དུ་འོང་ངོ།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "མི་སྨྲ་བར་འདུག་པ་ཙམ་གྱིས་ཐུབཔར་ལྟ་བ་རྣམས་དང་ལུས་ཀྱི་དྲི་མ་ཚམེད་པར་བྱེད་པ་ཙམ་གྱིས་འདག་པར་ལྟ་བ་རྣམས་ལྟ་བ་དེ་དང་འབྲལ་བའི་ཆེད་ཡིན་ནོ།",
    "བགྲོད་མིན་འགྲོག་འདོད་པ་ཡིས།",
    "བྱེ་ནས་དུས་ཇི་སྲིད་ཅིག་ཏུ་འདུགཅེ་ན།",
    "ཕྲ་རྒྱས་དེ་དང་ལྷན་ཅིག་འདུག་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་དུ་མི་འདུག་པ་ཉིད་དང་།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཀྱང་འདི་སྐདིཅས་དེ་བཞིན་གཤེགས་པ་བཞུགས་བཞིན་དུ་བདག་ལ་འདྲི་བར་༤སམས་སུམ་ཞེས་སྨྲས་སོ།",
    "ས་ཇི་བཞིན་དུ་རང་རང་དང་།",
    "དབྱིབས་དང་ཁ་དོག་གསན་རྒྱུ་འདུག་གམ།",
    "རྡོ་ལས་ལོགས་སུའཇིག་རྟེན་ན་མི་སྲིད་པ་ཅི་ཞིག་ཡོད་གང་འདྲ་འདུག་ཟེར།",
    "དེ་བཞིན་དུ་ཐ་མ་འགགས་ནས་མེད་དུ་ནི་འགྲོ་བར་འདུག་དེ་གར་འགྲོ།",
    "དབྱིབས་གཟུགས་ཁ་དོག་འདུག་གམ།",
    "བལྟ་བྱེད་ཀྱི་སེམས་དེ་འདུག་གམ།",
    "སྣང་ཚུལ་མི་མཚུངས་པར་འདུག་སྟེ།",
    "རྗེ་སྐྱེས་བྱེད་ཡབ་ཡུབ་ཞལ་སྦྱོར་རྣམས་རང་རང་སྙོམས་པར་འཇུག་པ་དང་།",
    "ཡུམ་རྣམས་ལ་གཡོན་འཁོར་ལྟ་བུར་འདུག་ཀྱང་མཐའ་གཅིག་ཏུ་ངེས་པ་མེདཔས་རང་གཞུང་གང་ཡིན་གྱི་དགོངས་པ་གཙོ་བོར་བཏོན་དགོས་ལ།",
    "སྣང་སྟོང་རང་གྲོལ་རྟོགས་པའི་རྒྱ་བསྐྱེད་དོ།",
    "བཅུ་གཉིས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་ལུས་ཚུགས་དྲང་པོར་འདུག།",
    "རང་རང་མདུན་དུ་རང་རང་བཤོས་བུ་བཞག།",
    "ཕྱོགས་ནི་ལྷོ་ཡི་ཕྱོགས་ན་འདུག།",
    "ཕྱོགས་ནི་ལྷོ་ནུབ་ཕྱོགས་ན་འདུག།",
    "བཞུགས་པའི་ཕྱོགས་ནི་ནུབ་ཏུ་འདུག།",
    "ཕྱོགས་ནི་ནུབ་བྱང་མཚམས་ན་འདུག།",
    "བཞུགས་པའི་ཕྱོགས་ནི་བྱང་ན་འདུག།",
    "ལོ་ཟླ་ཞག་དུས་ཀུན་ལ་འཁོར།",
    "རང་རང་ལོ་པའི་ལྷ་དང་དཔལ།",
    "རང་རང་ལོ་པའི་ལྷ་ཡིན་རྟགས།",
    "རང་རང་ལོ་པའི་ལྷ་མཛོད་ཅིག།",
    "ཡོས་ཀྱི་ཟླ་བ་དང་ཞག་དུས་ཀྱི་སྐག་སྒྱུར་ཅིག།",
    "སྦྲུལ་གྱི་ཟླ་བ་དང་ཞག་དུས་ཀྱི་སྐག་སྒྱུར་ཅིག།",
    "རྟའི་ཟླ་བ་དང་ཞག་དུས་ཀྱི་སྐག་སྒྱུར་ཅིག།",
    "སྤྲེལ་གྱི་ཟླ་བ་དང་ཞག་དུས་ཀྱི་སྐག་སྒྱུར་ཅིག།",
