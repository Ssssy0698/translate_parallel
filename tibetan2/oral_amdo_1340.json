    "རེས་འགའ་གདུགས་བདུན་བརྒྱ་དང་ཌ་མ་རུ་བདུན་པ་རྒྱར་འཕེལ་བའི་ཆོ་འཕྲུལ་ཅན།",
    "སྣང་དང་མི་སྣང་བའི་འཁོར་གྲུབ་པ་དང་རིག་འཛིན་གྱི་རྣལ་འབྱོར་ཕོ་མོ་དཔག་ཏུ་མེད་པའི་འཁོར་ལོའི་འདུ་བར་རྟག་ཏུ་སྤྱོད་པ།",
    "ཞབས་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "དེ་ནི་རྟོགས་ན་རང་བཞིན་རང་གི་སེམས།",
    "དར་གྱི་ཨང་རག་གསོལ་བའམ་སྟག་ལྤགས་ཀྱི་སྨད་དཀྲིས་ཅན་མི་ལྤགས་ཀྱི་སྟོད་གཡོགས་མཛད་པའི་རྐང་ལག་གཉིས་ཕྱག་གིས་བཟུང་ཏེ་ཕན་ཚུན་དུ་བརྒྱངས་པའམ་ཕྱག་གཡས་ཀྱི་མི་ལྤགས་བརྒྱངས་ཤིང་།",
    "མདུན་དུ་གསང་ཡུམ་མཁའ་འགྲོ་མ་མི་མོའི་རྣམ་པ་མཚར་སྡུག་ཕུན་སུམ་ཚོགས་པས་བདུད་རྩི་འབུལ་བ།",
    "འཁོར་ལོས་བསྒྱུར་རྒྱལ་དཔུང་ཚོགས་རྣམས་ཀྱིས་ནི།",
    "ལྕེ་སྤྱང་གི་རོ་ཕྲག་པར་བཀལ་བ།",
    "ལེགས་སྦྱངས་རི་མོ་མཁན་དག་གིས།",
    "མདུན་དུ་རིག་མ་ཞིག་གི་རྣལ་འབྱོར་མ་ཏིལ་མཁན་མོའི་རྣམ་པས་ཏིལ་ལུགས་པའི་བྱ་བ་ལ་བརྩོན་པས།",
    "སྐུ་ཤ་དཀར་དམར་ལང་ཚོ་རྒྱས་པའི་ཉམས་ལྡན།",
    "ཞབས་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "སྐུའི་མདུན་ངོས་སུ་ཕག་གི་ཤ་དང་མྱོས་བྱེད་ཀྱི་བུམ་པ་བཅས་པ།",
    "གཡོན་ཕྱེད་ཀྲུང་གིས་བཞུགས་པ།",
    "ཞེས་སོ། ཉེར་དྲུག་པ་ཨ་ཛོ་གི་པ་སྟེ་སྦྱོར་བྲལ་ཞེས་པའི་སློབ་དཔོན་ནི།",
    "ཕྱག་མཉམ་བཞག་གི་ཕྱག་རྒྱ་དང་།",
    "ཞབས་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "མཐར་སྐོར་བཙུན་མོ་བློན་འབངས་ཀྱིས་བསྐོར་ཞིང་།",
    "ཕྱག་མཉམ་བཞག་གིས་ཕྱག་རྒྱས་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་བཞིན་པ།",
    "རིག་མ་བཟང་མོས་ཆུ་ཡི་རྒྱུན་ལུགས་པ།",
    "སྦྲེའུ་བྱིས་པ་ཆུ་ཡི་རི་མོ་འདྲ་ན་རྟོགས་པ་ཡིན།",
    "གཉིས་འཛིན་མ་རིག་དུག་དག་གིས།",
    "ཤིང་ཕུར་དང་སྟ་རེ་བསྣམས་ནས་ཤིང་གཅོད་པའི་ཚུལ་གྱིས་འཁྲུལ་པའི་དྲྭ་བ་གཅོད་པའི་བརྡའ་སྟོན་པ།",
    "སྐུ་ཡི་གཡོན་ཕྱོགས་ནས་མཚར་སྡུག་ཕུན་སུམ་ཚོགས་པའི་བཙུན་མོས་འཁྱུད་པས།",
    "ཞབས་སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ།",
    "བདག་གིས་མ་རྟོགས་བར་དུ་རོ་ལ་ཁྱད་པར་ཆེ།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་མ་མིའི་བུ་མོའི་ཚུལ་བཟུང་བའི་བཙུན་མོ་མཚར་སྡུག་ཕུན་སུམ་ཚོགས་པ་ལྔ་བརྒྱས།",
    "ཕྱི་ནང་ཀུན་ཏུ་སྤྱོད་པ་དག་གིས་འཚང་མི་རྒྱ།",
    "ཕྱག་གཉིས་ཀྱིས་ཏོག་རྩེ་བསྣམས་ཏེ་ཞིང་ཐ་རེངས་བརྐོ་བའི་ཚུལ་གྱིས།",
    "རང་རྒྱུད་རེངས་པ་འདུལ་དགོས་པའི་བརྡའ་མཛད་པ།",
    "ཞབས་གཉིས་སྐྱིལ་ཀྲུང་གིས་དུར་ཁྲོད་ཀྱི་ས་གཞི་ལ་བཞུགས་ཤིང་།",
    "དུར་ཁྲོད་ཀྱི་མི་རོ་ལ་གཟིགས་པ།",
    "ཉམས་མྱོང་གོམས་པའི་ཐབས་དག་གིས།",
    "ཞབས་གར་སྟབས་ཀྱིས་བཞེངས་ཞིང་པདྨའི་རྫིང་བུའི་འགྲམ་ན་འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་ལྷ་ཁང་ལ་བསྙེན་བཀུར་མཛད་པ།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "ཞེས་སོ། ང་གསུམ་པ་ཛོ་གི་པ་ནི།",
    "བརྒྱན་པའི་དབུས་སུ་གྲུབ་ཆེན་ཛོ་གི་པ་རྣལ་འབྱོར་གྱི་ཆ་བྱད་སྐུ་སྔོ་སངས་གཅེར་བུ།",
    "འཁར་བ་ཐོགས་ཤིང་ཡོ་བྱད་རྣམས་ཕྲག་དབྱུག་གི་རྩེར་བཏགས་ཤིང་།",
    "མར་མེའི་རྩེ་མོ་ལྟ་བུ་ཡིས།",
    "ཕྱག་གིས་ཏིང་ཤག་བསྣམས་ཏེ་རྡུང་བའི་ཚུལ་གྱིས།",
    "གླིང་བུ་འབུད་པ་སོགས་འབུད་དཀྲོལ་གྱི་བྱ་བ་བྱེད་པ་ལ་བརྩོན་པ་རྣམས་ཀྱིས་བསྐོར་བ།",
    "སྣུམ་འཁུར་གཅིག་གི་ཕྱེད་ཞལ་དུ་གསོལ་བའི་རྣམ་པ།",
    "ཞེས་སོ། རེ་གཅིག་པ་གྲུབ་ཆེན་བྷིཀྵན་པ་ནི།",
    "ཞེས་སོ། རེ་གཉིས་པ་གྲུབ་ཆེན་དྷི་ལི་པ་ནི།",
    "མདུན་དུ་མར་ནག་གི་སྣོད་ཆེན་པོ་མང་དུ་བཤམས་ཏེ་འཚོང་བའི་ཚུལ་དང་ཁ་ཟས་སྣ་ཚོགས་བཤམས་པ།",
    "ཞེས་སོ། རེ་གསུམ་པ་ཀུམྦྷ་རི་པ་ནི།",
    "ཞེས་སོ། རེ་བཞི་པ་གྲུབ་ཆེན་ཙརྤ་རི་པ་ཙ་པ་རི་པའམ་ཙརྦ་རི་པའམ་ཇ་ཝ་རི་ནི།",
    "སྐྱེས་པ་བུད་མེད་མཐའ་ཡས་པ་དོན་ཆེན་པོ་ལ་ཡུད་ཀྱིས་འགོད་པ།",
    "རང་གིས་རྟོགས་ལས་གཞན་མེད་དེ།",
    "ཞེས་སོ། རེ་ལྔ་པ་རྣལ་འབྱོར་མ་མ་ཎི་བྷ་དྲཱ་ནི།",
    "འོག་གི་ས་གཞིར་ཆུ་བུམ་ཆག་པ་ལ་གཟིགས་པའི་རྣམ་པ།",
    "ཅེས་སོ། རེ་དྲུག་པ་རྣལ་འབྱོར་མ་མེ་ཁ་ལཱ་ནི།",
    "གཞོན་མཛེས་ལང་ཚོ་རྒྱས་ཤིང་དབུ་སྐྲ་གསིལ་བུར་གྲོལ་བ།",
    "ཞེས་སོ། རེ་བདུན་པ་རྣལ་འབྱོར་མ་ཀ་ན་ཁ་ལཱ་ནི།",
    "གཡོན་པས་རང་གི་དབུ་བཅད་དེ་འཛིན་པ་ཕག་མོ་དབུ་གཅད་མའི་ཚུལ་ལྟར།",
    "རང་གི་སེམས་ཀྱི་གྲུ་བཏང་ནས།",
    "ཞེས་སོ། རེ་བརྒྱད་པ་ཀ་ལ་ཀ་ལ་པ་ནི།",
    "ཞེས་སོ། རེ་དགུ་པ་ཀནྟ་ལི་པ་ནི།",
    "གོས་ཕུ་དུང་ཅན་གསོལ་ཞིང་དབུ་ལ་རས་ཀྱི་ཐོད་བཅིངས་སོགས་ཁྱིམ་བདག་གི་ཆ་བྱད།",
    "སྤྱན་ནམ་མཁའ་ལ་གཟིགས་པ།",
    "མདུན་དུ་བུད་མེད་བཟང་མོའི་རོ་བཞག་པའི་ཐོད་པ་བྲེགས་ཏེ་ཕྱག་ཏུ་བསྣམས་པ།",
