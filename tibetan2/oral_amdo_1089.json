    "འབྲེལ་བ་ནི་ཤིང་ཞེས་པའི་སྒྲ་ལ་བརྟེན་ནས་ཡལ་ག་ལོ་འདབ་དང་ལྡན་པའི་རིགས་གནས་དེ་ཤིང་དུ་གོ་བ་དེ་བྱུང་གི་འབྲེལ་བ་ཡོད་པ་༧ཆུས་ཤིང་བསྐྱེད་པ་དེ་བྱུང་གི་འབྲེལ་བ་བྱུང་བ་དང་འདྲའོ།",
    "རང་གི་རྒྱུ་རྐྱེན་རྣམས་ཀྱིས་བསྐྱེད་པའི་འབྲས་བུ་ནས་འབྲུ་ལྟ་བུའོ།",
    "མིང་གི་རྣམ་གྲངས་ཅན་རྟ་དང་གོར་བུ་དང་ཆིབས་པ་ཞེས་པ་རྣམ་གྲངས་ཡིན་པ་ལྟ་བུ་གསུངས་ཏེ་རགས་པའི་དཔྱད་ཚུལ་ལོ།",
    "ཡང་དག་ཅེས་གང་གི་དྲི་མེད་ཤེལ་དཀར་ལྟ་བུ་དང་།",
    "གསལ་རིག་གི་ཤེས་པ་ནི།",
    "ཡུལ་གྱི་སྐྱེ་མཆེད་གཟུགས་སྒྲ་དྲི་རོ་རེག་བོན་སོགས་ཤེས་པས་ལོངས་སུ་སྤྱད་བྱ་རྫས་ནོར་ལྟ་བུའོ།",
    "གཞན་གྲུབ་ཅེས་རྒྱུད་ཐ་དད་པའི་གང་ཟག་གིས་ཆུ་འདོད་དེ་བསླངས་བའི་ཚེ།",
    "དང་པོ་རང་གི་དགག་བྱ་བཅད་ཤུལ་དུ་དོན་གཞན་མི་འཕེན་པ།",
    "གང་ཟག་གི་སྐད་ཀྱི་བྲག་ཆ་གོ་བ་ལ་བརྟེན་ནས་གང་ཟག་ཡོད་པར་རྟོགས་པའི་བློ་ལྟ་བུའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ།",
    "གངས་འཚུབ་སོགས་བཞིན་ཉོན་མོངས་པའི་ཡིད་ཀྱིས་བདག་ཏུ་བཟུང་ཞིང་ཉོན་མོངས་དུག་ལྔ་སྣ་ཚོགས་བསྐྱེད་དེ་བག་ཆགས་བསགས་པའོ།",
    "རང་གི་གྲོགས་ཞི་གནས་དང་འབྲེལ་ཏེ་བསྒྲུབ་པའི་ལམ་རྫོགས་རིམ་གྱི་རྒྱུ་རུ་འགྱུར་དགོས་པ་ཞིག་དང་།",
    "བསྙེན་སྒྲུབ་ཡན་ལག་བཞིའི་ཆིང་གིས་སྔགས་ཀྱི་ལམ་བསྒྲུབ་པའི་ཚུལ་བསྡམས་ཏེ་འཆད་ལུགས་ཡོད་ལ།",
    "སྟོན་མོ་བྱེད་པའི་ཡོན་བདག་ལྟ་བུ་དང་།",
    "སྟོན་མོའི་དུས་ཀྱི་སྐུ་མགྲོན་ལྟ་བུ་དང་།",
    "བྱ་ཡི་སྒྲོ་ཕྲན་ཕྲ་མོ་ལྟ་བུའོ།",
    "དོན་བྱེ་བྲག་གི་ལེའུ་སྟེ་དགུ་པའོ།",
    "དེ་ནི་རྣམ་རིག་གི་ཚོགས་ལས་འདས་པའོ།",
    "ཐེག་ཆེན་གྱི་གནས་ལུགས་ནི་སྒྲ་དང་རྟོག་པའི་ཡུལ་ལས་འདས་པས་བརྗོད་དུ་མེད་པར་འདོད་པས་ཁྱོད་ཀྱི་འདོད་པ་ལས་ཁྱད་པར་འཕགས།",
    "ཁོ་ན་རེ།",
    "ངས་ཀྱང་སྒྲ་རྟོག་གི་ཡུལ་ལས་འདས་པས་བརྗོད་མེད་སྨྲས།",
    "དོན་དུ་སྟོང་པའི་རང་སྒྲ་དང་སྟོང་པའི་རྩལ་དུ་ཤར་བ་ཙམ་མོ།",
    "ཐེག་ཆུང་གི་ལྟ་བ་སྤྲོས་པའི་མཐའ་བརྒྱད་དང་བྲལ་བ་དེ་རྟོགས་པའི་ཤེས་རབ་ཅིག་ཡོད་པ་ཁྱོད་ཀྱིས་ཁས་ལེན་དགོས།",
    "༧ དེ་ལྟར་ན་ཐེག་ཆེན་རང་གི་ལྟ་བ་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "འདི་ཞེས་བློ་དང་རིག་པ་གང་གིས་ཡུལ་དུ་བྱས་ཏེ་འདི་དང་འདིའོ་ཞེས་སྨྲ་བ་མི་ནུས་ཏེ།",
    "ལྟ་བ་ཇི་བཞིན་ཉིད་དེ་བློ་དང་རིག་པ་གང་གི་ཡུལ་ལས་འདས་པའི་ཕྱིར།",
    "དེས་ན་ལྟ་བ་ཇི་བཞིན་ཉིད་དེ་བརྗོད་འདོད་ཀུན་སློང་གིས་བསླངས་ཏེ་ཡོད་ཅེས་དང་མེད་ཅེས་དང་ཡིན་ཞེས་དང་མིན་ཞེས་དང་།",
    "སྨྲ་བ་མི་ནུས་ཏེ་བརྗོད་འདོད་ཀུན་སློང་གིས་བཟུང་མི་ནུས་པས་བསམ་མི་ནུས།",
    "༧ གང་ཤར་རང་གིས་སྟོང་པས་མ་ལུས་རྫོགས་པ་ཆེ།",
    "དངོས་པོའི་གནས་ལུགས་མ་རྟོགས་ཏེ་རང་གི་འདོད་པའི་ཕྱོགས་ལྟ་དང་མ་མཐུན་ནས་དགག་པའི་རིགས་ལ་ལན་བདེ་བར་གཤེགས་པའི་ལུང་དང་རིགས་པའི་རྣམ་བཞག་གི་རྒྱབ་རྟེན་བྲག་རི་ལྟ་བུ་ཡོད་པས་ཉམ་མི་ངའོ།",
    "སེམས་ཉིད་ཀྱི་ངོ་བོ་ལ་རྣམ་རྟོག་གིས་གོས་པ་མེད།",
    "༧ གཞི་གསལ་སྟོང་ཟུང་འཇུག་གི་གནས་ལུགས་དེ་ལ་ཡོན་ཏན་རྫོགས་ཞེས་པའི་རྫོགས་ཚུལ་ཇི་ཡིན་སྙམ་ན།",
    "དང་པོ་གཞི་ལྷུན་གྲུབ་རང་གི་ངོ་བོ་ནི།",
    "དེ་ལ་བསམ་ངོ་ལྷུན་གྲུབ་རང་གི་ངོ་བོ་ནི།",
    "གསུམ་པ་མཐུན་སྣང་ལྷུན་གྲུབ་རང་གི་ངོ་བོ་ནི།",
    "རྒོལ་ཕྱི་རྒོལ་གཉིས་ལས་ཐུན་མོང་དུ་གྲུབ་པའི་བོན་ཅན་ཀ་པ་ལི་ལྟ་བུ་ཞིག་གཞིར་བཞག་པའི་དུས་ན།",
    "དེ་ལྟར་མ་སོང་བའི་གཉིས་ཀས་ཀ་པ་ལི་ལྟ་བུ་ཡེ་རེར་མཐུན་པར་སྣང་བ་ལ་ཟེར་རོ།",
    "གཉིས་སྣང་གི་དངོས་ཚོགས་སྣང་སྲིད་བརྟན་གཡོ་ཐམས་ཅད་ཀྱི་རང་བཞིན་གཉིས་མེད་ཐིག་ལེ་ཉག་གཅིག་ལས་མ་འདས་ཏེ།",
    "ཀུན་གཞི་སྟེ་ཇི་བཞིན་ཉིད་ལ་འཁོར་འདས་ལས་སོགས་གང་གིས་ཀྱང་ཆ་མ་ཕྱེས་པར་མཉམ་པའོ།",
    "འདི་ཞེས་བློ་ཡིས་བཟུང་བ་མེད་པས་བརྗོད་འདོད་ཀུན་སློང་གིས་ཀུན་ནས་བསླངས་པའི་མིང་ལ་གཟའ་གཏད་མེད་ཅེས་འཛིན་སྟངས་ཀྱི་ཡུལ་ལས་འདས་སོ།",
    "འདི་ཞེས་བརྗོད་དུ་མེད་ཅེས་སྒྲ་རྟོག་གི་ཡུལ་དུ་བྱེད་པ་མེད་པས།",
    "གཉིས་པ་མངོན་སུམ་དང་རྗེས་དཔག་གི་བོན་ཅན་དང་བོན་ཉིད་ཀྱི་དོན་གཞལ་བྱ་དང་འཇལ་ཚུལ་བསྟན་པ་ལ།",
    "རེག་བྱའི་སྐྱེ་མཆེད་དོ།",
    "རེག་འཛིན་ཡིད་མངོན་སོགས་དང་།",
    "མཚན་མའི་ངོས་བཟུང་མེད་པ་ཐུགས་ཉིད་ཟབ་མོའི་དོན།",
    "སྣོད་བཅུད་ཀྱིས་བསྡུས་པའི་བོན་རྣམས་ལ་གནས་ཚུལ་དང་སྣང་ཚུལ་གཉིས་རེ་ཡོད་ལ།",
    "ཐུགས་ཉིད་ཟབ་མོའི་བོན་ཞེས་པ་རང་འབྱུང་ཡེ་ཤེས་དེ་མཚན་མ་ཞེས་སྒྲ་དང་རྟོག་པའི་ཡུལ་ལས་འདས་པས་དེ་རྣམས་ཀྱིས་ངོས་བཟུང་མེད་པའོ།",
    "སྣང་ཚུལ་དེ་ནི་རྣལ་འབྱོར་རང་གི་སྣང་ཚུལ་ལས་རྒྱུད་ཐ་དད་པའི་བློ་རྟོག་གི་སྤྱོད་ཡུལ་མ་ཡིན་པའོ།",
    "སྣོད་བཅུད་ཐུན་མོང་གི་སྣང་ཚུལ་འདི་ལ་མ་དག་པའི་སྣང་ཚུལ་ཡང་ཡིན་ཏེ།",
    "འདི་ལ་མ་རིག་པས་བསླད་པ་ཞུགས་པས་རིགས་མཐུན་འགྲོ་བ་ཐུན་མོང་གི་སྤྱོད་ཡུལ་ཡིན་ནོ།",
    "༧ གཉིས་པ་རྗེས་དཔག་གི་གཞལ་བྱ་བསྟན་པ་ལ།",
    "ཞེས་པ་རྗེས་དཔག་གི་གཞལ་བྱ་ལྐོག་གྱུར་ལ།",
    "སྡིག་བཅུ་སྤྱད་པས་ངན་འགྲོར་འགྲོ་བ་སོགས་དཔྱད་གསུམ་དག་པའི་ལུང་གི་རྟགས་ལས་རྟོགས་དགོས་པ་རྣམས་སོ།",
    "ཞེས་པས་རྟགས་ཡང་དག་གིས་ཡིད་དཔྱོད་དང་ཐེ་ཚོམ་དང་ལོག་རྟོག་རྣམས་བསལ་ཞིང་།",
    "རང་གི་བསྒྲུབ་བྱ་ཇི་བཞིན་གཏན་ལ་འབེབ་པ་དང་།",
    "རྒོལ་བ་རང་གིས་རྟོགས་པའི་དོན།",
    "༧ ས་ལམ་འབྲས་བུ་ཐེག་རྒྱུད་དམན་མཆོག་གིས།",
    "དེ་ལྟར་རྗེས་དཔག་གིས་བསྒྲུབ་བྱའི་དོན།",
    "དེ་ལྟར་རྗེས་དཔག་གིས་གཏན་ལ་འབེབ་ཀྱང་།",
    "༧ ས་ཕྱོགས་གང་གི་བསྒྲུབ་བྱའི་རྗེས་འགྲོ་ལྡོག་པ་ལ།",
    "སྐལ་ལྡན་སྦྱངས་པ་སྔོན་སོང་བ་ལ་ལྟོས་ཏེ་གནས་ལུགས་གཅིག་ཆར་དུ་རྟོགས་པར་འདོད་པ་དང་།",
    "གོམས་པ་ཚད་རྫོགས་པ་སོགས་ལ་ལྟོས་ཏེ་བརྩོན་འགྲུས་ཀྱི་ཉེར་ལེན་ལ་ལྟོས་མི་དགོས་པར་ངང་གིས་གོམས་པ་འཕེལ་བའོ།",
    "༧བཀའ་ལུང་རིག་པ་ལས་བྱུང་བྱེ་བྲག་གི།",
    "བཀའ་དང་ལུང་གི་བརྗོད་དོན་བསླུ་མེད་དུ་རྟོགས་པའི་རིག་པའོ།",
    "བླང་བྱ་ནི་རང་རང་གི་མཐུན་པའི་ཕྱོགས་དང་།",
    "ལུང་གིས་བསྟན་པའི་ཚུལ།",
    "གནས་ལུགས་གཉིས་རེ་ཡོད་པ།",
    "གནས་སྐབས་དང་མཐར་ཐུག་གཉིས་རེ་ལས།",
    "རང་རང་གི་རྒྱུ་ལས་སྐྱེས་པའི་དངོས་པོའོ།",
    "བརྩད་པ་ཁྱོད་ཀྱིས་སྤང་བྱའི་སྒྲིབ་པ་དུག་ལྔ་དང་།",
    "བདེན་གྲུབ་ཀྱི་དངོས་པོ་གཞན་ཞིག་གིས་གཞན་སྤོང་བ་ཡང་མི་ནུས་ལ།",
    "སྲིན་འབུས་བལ་བསྐྱེད་རང་གིས་རང་བཅིངས་འདྲ།",
    "གོང་གི་དགག་པ་བྱས་པའི་ཕྱོགས་སྔ་དྲང་སྲོང་པའི་ནང་གསེས་བདེན་མེད་རང་བཞིན་གྱིས་གྲུབ་པར་ཁས་ལེན་པའི་ཕྱོགས་འགའ་དང་།",
    "དངོས་སྨྲ་དྲང་སྲོང་གི་མིང་ཅན་འགའ་ལ་ཡིན་སྲིད་པ་དང་།",
    "འདིར་བསྟན་གྱི་དྲང་སྲོང་གིས་རིགས་པས་སྒྲིབ་གཉིས་བསལ་བ་དང་།",
    "རང་གི་ལན་ཅི་ལྟར་བྱེད་ཅེ་ན།",
    "དེ་བཞིན་ཉིད་དང་ཀུན་སྣང་གི་ཐབས་ཙམ་ལ་བརྟེན་ནས་འབྲས་བུ་སྐུ་གསུམ་འགྲུབ་པས།",
    "བྱེད་པ་པོ་ཞིག་གིས་བཀྲོལ་ནས་གྲོལ་བ་ཡིན་ན།",
    "བདག་འཛིན་གྱིས་ཇི་ལྟར་བཟུང་བ་བཞིན་དམིགས་པ་གཅིག་ལ་དམིགས་ནས་འཛིན་སྟངས་དངོས་འགལ་དུ་སོང་བའི་ཚུལ་གྱིས་བཀྲོལ་བ་ལ།",
    "ཁྱོད་ཀྱིས་རྩོལ་བ་བྱས་པ་དང་།",
    "ཁྱོད་ཀྱིས་བརྟགས་པ་དེ་རྣམས་གང་ཡང་མ་ཡིན་ན།",
    "སྐྱེ་བོ་ཐ་མལ་ལུང་མ་བསྟན་པ་ཅི་ལ་འགྱུར་ཏེ་ཁྱོད་ཀྱིས་བརྩད་པ་དེ་ཡིས་ཕྱོགས་སྔའི་མཐའ་མ་ཆོད་པའི་ཕྱིར་རོ།",
    "དོན་གྱི་འདོད་ཚུལ་ནི་བློ་འདས་ཀྱི་དོན་དེ་སྣང་སྲིད་ཀྱི་བཀོད་པ་གང་གིས་བཀྲོལ་ཏེ་གྲོལ་བ་མིན་པའི་ཕྱིར་རོ།",
    "གཅིག་གིས་གཟུགས་མེད་མཐོང་ན་ཀུན་གྱིས་མཐོང་བར་རིགས།",
    "ཆུ་བུར་མིག་གིས་སྟོང་གཟུགས་སམ་གཟུགས་མེད་མཐོང་བའམ་བལྟ་བར་འདོད་པ་བཅས་དམ་བཅས་པ་ལ།",
    "མོས་དང་གདུང་དང་སྡང་བའི་ཡུལ་རྣམས་ལ།",
    "མོས་པའི་དད་པ་དང་གདུང་བའི་དབྱངས་དང་བཅས་ཏེ་མཆོད་འབུལ་ཚོགས་བསགས་པ་ལ་དོན་ཡོད་དེ།",
    "དཔྱད་གསུམ་གྱིས་དག་པའི་ལུང་གི་དོན་ཡིན་པའི་ཕྱིར།",
    "རང་གི་བསྟན་བྱའི་དོན་ལ་མི་བསླུ་སྟེ།",
    "༧ ཆུ་བུར་མིག་གིས་སྟོང་གཟུགས་མི་མཐོང་སྟེ།",
    "ཞེས་ཆུ་བུར་མིག་གིས་སྟོང་གཟུགས་མི་མཐོང་ཡང་།",
    "གལ་ཏེ་གང་ཟག་གཅིག་གིས་གང་མཐོང་དང་གང་མྱོང་གཞན་དང་གཞན་གྱིས་མྱོང་བའི་ངེས་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དུ་གང་ཟག་རང་རང་གི་སེམས་རྒྱུད་ཀྱི་གནས་ལུགས་མཐའ་བཞི་རྒྱ་གྲོལ་རང་རིག་ཡེ་ཤེས་ལ་རང་རྒྱུད་ཀྱིས་བསྡུས་པའི་རྟོག་པའི་བོན་ཅན་དག་དང་མ་དག་པའི་སྐྱོན་གང་གིས་ཀྱང་གོས་པ་མེད་པས་དབེན་པའོ།",
    "གནས་ལུགས་རང་འབྱུང་ཡེ་ཤེས་ལ་བློ་རྟོག་གིས་གཅིག་དང་ཐ་དད་སོ་སོ་འཛིན་པའི་མཐའ་ལས་འདས་པ་ཡིན་ཏེ།",
    "འགའ་ཞིག་གིས་རང་འབྱུང་ཡེ་ཤེས་བློ་ཡིས་མ་བཞག་པས་བདེན་པར་གྲུབ་པ་འདོད་མོད་ཀྱང་།",
    "རིག་པ་ཞེས་གནས་ལུགས་རང་འབྱུང་ཡེ་ཤེས་རང་གིས་རང་རིག་ཅེས་ཐ་སྙད་བཏགས་པ་མ་གཏོགས་གདགས་བྱ་དང་འདོགས་བྱེད་ཀྱི་ཐ་སྙད་མེད་དོ།",
    "གལ་ཏེ་འགའ་ཞིག་གིས་རིག་པ་ནི་ད་ལྟའི་རིག་པ་སྐད་ཅིག་མ་ཞེས་གྲགས་ཏེ་ད་ལྟའི་རིག་པ་ཤེས་པ་སྐད་ཅིག་མའི་བདག་ཉིད་ཅན་ལ་མཛུབ་མོ་བཙུགས་པ་ཡིན་ན་ནི་ཤེས་པ་ལས་གཞན་མེད།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་ཕྲ་རགས་རྣམས་ལེགས་པའི་སྟོབས་ཏེ་ལམ་ལྔ་ལ་བརྟེན་ནས་སྤངས་ཤིང་ཟག་པ་མེད་པའི་ཕུང་པོ་ཐོབ་པའོ།",
    "གསལ་བ་རང་འབྱུང་དང་ས་ཡི་ལྷ་མོ་ཡབ་ཡུམ།",
    "བྱེ་བྲག་དངོས་མེད་དང་མེ་ཡི་ལྷ་མོ་ཡབ་ཡུམ།",
    "དགའ་བ་དོན་གྲུབ་དང་ཆུ་ཡི་ལྷ་མོ་ཡབ་ཡུམ།",
    "ཡབ་ཡུམ་དེ་རྣམས་ལས་སྤྲོས་པའི་འཁོར་དང་ཡང་འཁོར་དབལ་མོ་གཟེ་མ་ལས་མཁན་ཕོ་ཉ་སྤྲུལ་པ་བསམ་གྱིས་མི་ཁྱབ་པ་དང་།",
    "དེ་ཡི་གསལ་ཆའི་ཡོན་ཏན་འཆར་རུང་གི་གཞི་ལ་རྫོགས་སྐུ།",
    "དེ་རེ་རེའི་ནང་གསེས་ཀྱི་ཡེ་ཤེས་རེ་རེ་ལ་ཡེ་ཤེས་ལྔ་ལྔར་དབྱེ་བ།",
    "འབྲས་བུའི་ཡེ་ཤེས་རེ་རེས་ཀྱང་།",
    "མཁྱེན་པའི་ཡེ་ཤེས་གཅིག་གིས་ཀྱང་།",
    "ད་ཡོད་རྣམས་དང་མི་བྲལ་བའི་གཞི་ནི་སྐྱོན་དང་ཡོན་ཏན་གང་གི་ཕྱོགས་སུ་གནས་པ་མིན་ནོ།",
    "འདི་ནི་ཐ་སྙད་ཚིག་གི་ཡུལ་ལས་འདས་པའོ།",
    "འདི་ནི་སྒྲ་རྟོག་གི་ཡུལ་ལས་ཡེ་ནས་འདས་སོ།",
    "ཐམས་ཅད་ཐིག་ལེ་ཉག་གཅིག་གི་བདག་ཉིད་ཡིན་པས་སོ།",
    "འདི་ནི་རང་རིག་དང་རང་རྟོགས་ཆེན་པོ་ཞེས་རང་གིས་རང་མཐོང་བ་ལས་གཞན་ཡུལ་དང་ཡུལ་ཅན་མེད་པའོ།",
    "ཡེ་གཞི་འདི་ལ་སྒྲ་དང་རྟོག་པ་གང་གིས་ཀྱང་ཡུལ་དུ་བྱེད་དེ་ལོངས་སུ་སྤྱོད་པ་ནི་དུས་གང་དུ་མེད་པས་སྒྲ་རྟོག་གང་གིས་མ་གོས་པས་རྣམ་པར་དག་པའོ།",
    "གོམས་པ་དེ་ཡང་གཤིས་ཀྱི་གནས་ལུགས་རང་གིས་རང་རིག་ཚུལ་ཡུལ་དང་ཡུལ་ཅན་མེད་པ་དེ་ལ་གོམས་པ་ཡིན་པས་གཞན་དང་མི་མཚུངས་སོ།",
    "ཞེས་པ་གང་གིས་གང་ལ་གསུངས་པ་ནི།",
    "ཡང་ཡུལ་མོ་རྒྱ་ཆེས་ན་མཐའ་མ་དབུས་སུ་དྲིལ།",
    "བཙུན་མོ་ཕྱོགས་ཆེ་ན་མྱུར་དུ་མཐར་སྤྱུགས།",
    "དེ་ནས་མེ་ཉག་ནེ་རྒྱུང་གིས།",
    "དེ་ནས་རྟག་གཟིགས་ཟ་རང་མེ་འབར་གྱིས།",
    "ཡིད་བཞིན་གྱི་བུ་མོ་རྒྱན་མ་ལོག་པར་རྫོངས།",
    "༧ གེ་སར་ངམ་པ་ལྕེ་རིང་གིས་སྲིད་གཤེན་པ་རྣམས་ལ་གསུངས་པ།",
    "ཊིབླ་ཡིད་སེམས་དང་གསུམ་པོ་དེ་གང་ཟག་གཅིག་གི་ཤེས་རྒྱུད་དུ་ངོ་སྤྲོད།",
    "དམག་གི་དཔུང་འདོད་ན་ཟས་ཀྱི་ཤོམས་བསྐྱེད།",
    "༧ ཕ་རོལ་པོས་རང་ལ་གནོད་པ་མི་འཇུག་པར་རང་ཉིད་ཡི་དམ་གྱི་ལྷ་མགོན་གཙོ་བོ་དང་དབལ་མོ་གཟེ་མ་གྱད་མོ་ཐམས་ཅད་བྲན་དང་འབངས་ལུས་ཀྱི་གོ་ཁྲབ་བཞིན་བཀོན་པ་ནི་རྟོགས་པས་བདག་བསྒྲལ་བའི་དོན་དུ་འགྲེལ་ལས་གསུངས།",
    "ལྗོན་ཤིང་གི་རྩ་བ་མ་འགྲུས་ན་ཡལ་ག་ཕྱོགས་སྙོམས།",
    "གཡུང་དྲུང་གི་ཟུར་དོད་ན་ལྟ་བའི་ཡུལ་གསལ།",
    "༧ ངག་གིས་སྨྲ་བ་བཅད་དེ་བརྗོད་མེད་དུ་གནས་ན་བདེ་བར་གཤེགས་པའི་ལུང་གི་དོན་རྟོགས།",
    "༧ གླང་ཆེན་སྨྱོན་པ་སྟེ་གཏི་མུག་གི་རང་བཞིན་ཡེ་ཤེས་སུ་རྟོགས་ན་རྨོངས་བླུན་མུན་པ་ལྟ་བུས་མི་ནོན་ཏེ་ཡེ་ཤེས་གསལ་བར་འཆར་རོ།",
    "མན་ངག་གི་གནས་གདམས་པའི་ལེའུ་བསྟན་པ།",
    "བཅུ་བཞི་པ་མན་ངག་གི་གནས་གདམས་པའི་ལེའུ་ལ་གཉིས་ཏེ།",
    "མན་ངག་གི་གནས་གདམས་པ་དང་།",
    "རང་གི་རྒྱུད་ལ་ཤར་བའི་རིག་པ་རྣམས་ཀྱི་ཉིང་བཅུད་བསྡུས་ཏེ་ཟུར་དུ་ཕྱུངས་ནས།",
    "དེ་རྗེས་མཁས་གྲུབ་རྣམས་རང་རང་གི་སྒྲུབ་གནས་སོ་སོའི་གནས་སུ་གཤེགས་སོ།",
    "མན་ངག་གི་གནས་གདམས་པའི་ལེའུ་སྟེ།",
    "མཐར་རྗེས་མཇུག་གི་དོན།",
    "ཕྱི་མ་དུས་རབས་བརྒྱད་པ་ཁྲི་སྲོང་གི་དུས་སུ་སྦས་པ་གཉིས་ལས་འདི་སྔ་མའི་དུས་སུ་སྦས་པར་ངེས་ཏེ།",
    "ཞང་ཞུང་གི་རྒྱལ་ས་དང་རྒྱལ་པོ་རྣམས་བཞུགས་པའི་སྐབས་སུ་བརྩམས་པ་དང་།",
    "བོད་ཡུལ་གཙང་གི་ས་གནས་འཇེད་དར་ལྡིང་པ་རྨ་སྟོན་སྲིད་འཛིན་ལ་གནང་བ་ལགས་སོ།",
    "དགོངས་བཞེད་ཟབ་མོ་གསེར་གྱི་འཁོར་ལོ་ཆེ།",
    "རྒྱལ་ཀུན་གསུང་གི་ལྷ་མཆོག་སྨྲ་བའི་སེང་།",
    "གཤེན་བསྟན་པད་ཚལ་ཉིན་མོར་བྱེད་པའི་དཔལ།",
    "ཁྱོད་ཉིད་ངེས་པས་སྐྱེ་དགུའི་གཙུག་རྒྱན་དུ།",
    "སྣང་ཞིག་མི་རྒྱབ་ནམ་མཁའ་བློ་ལྡན་གྱིས་ཁོང་གི་རྨི་ལམ་དུ་རབ་བྱུང་གི་ཆས་ཅན་ཞིག་གིས།",
    "ཞིག་བྲིས་ཞེས་བཀའ་བབས་པར་བརྟེན་སློབ་ཟུར་༧ཡོངས་འཛིན་བསྟན་འཛིན་ཡེ་ཤེས་སམ་མཚོ་བྱུང་དགའ་བའི་བློ་གྲོས་ཀྱིས་དད་མོས་དང་བཅས་རྔ་ཡུལ་སྣང་དགོན་བཀྲ་ཤིས་གཡུང་དྲུང་གླིང་དུ་སྦྱར་བའོ།",
    "མཐའ་ཀླས་གདུལ་བྱའི་མོས་ཁམས་ཆུ་སྣོད་དུ།",
    "གངས་ཅན་མཁས་པ་ཡོངས་ཀྱི་གཙུག་རྒྱན་ལ་ཞབས་སྟེགས་བྱེད་པའི་༧གོང་ས་༧ཡོངས་འཛིན་མཆོག་གི་ཞབས་ཟུང་གསེར་གྱི་འཁོར་ལོ་རྩིབས་སྟོང་འོད་བརྒྱ་འབར་བ་མི་འཇིགས་གདོང་ལྔས་བཏེགས་པའི་ཁྲིའི་དྲུང་དུ།",
    "སྟོབས་བཅུ་མངའ་བ་མཐའ་དག་གི་སྤྱི་གཟུགས།",
    "ཐུན་མོང་བའི་སྣང་ངོར།",
    "རྒྱལ་བ་གཉིས་པ་མཉམ་མེད་ཆེན་པོའི་རང་ལུགས་དྲི་མ་མེད་པ་འཆད་རྩོད་རྩོམ་གསུམ་གྱི་དར་ཆེན་འཛམ་གླིང་འཛིན་མའི་ཁྱོན་ལ་འཕྱར་བཞིན་བཞུགས་པ་ལ།",
    "ཁྱབ་འཇུག་གི་འཇུག་པ་བཅུ་ཡང་བྱིས་པའི་ཟློས་གར་ལ་འགོད་བཞིན།",
    "རེ་ཞིག་གདུལ་བྱ་གཞན་དུ་གཟིགས་ནས།",
    "གདུལ་བྱ་གཞན་དུ་གཟིགས་ཤིང་བཤོལ་ནའང་།",
    "ཐུགས་ལ་སྐྱོ་ངལ་གྱི་རྣམ་པས་མ་རེག་པར།",
    "རྣམས་སྨིན་གྲོལ་ཟབ་མོའི་ལམ་ལ་བཀོད་ཅིང་།",
    "སླར་ཡང་གདུལ་བྱ་རྐང་འཐུང་གི་ཚལ་ལ་ལོག་ལྟའི་བ་མོས་ཉེ་བར་གདུང་བ་ལ།",
    "ཞབས་ཀྱི་པད་མོ་ལ་མགོ་བོས་གཏུགས་ཤིང་།",
    "ཐ་མ་ཟང་ཟིང་གི་སྒོ་ནས་ཐུགས་བཟུང་ཞེས་པས།",
    "བདག་ཅག་གདུལ་བྱའི་དད་མོས།",
    "བྱེ་བྲག་གངས་ཅན་བསྟན་འགྲོའི་རྩ་ལག་ཁྱད་པར་ཞྭ་དཀར་འགྲོ་བའི་ཕན་བདེ་མཐའ་དག་གི་རྩ་བ།",
    "སྐུ་འཚོ་བགྲང་བྱ་ཁྲི་ཕྲག་ནས་ཁྲི་ཕྲག་གི་བར་དུ་བརྟན་ཅིང་།",
    "ཚེ་སྲོག་གི་དབུགས་རྒྱུན་རིང་དུ་གཏོང་དགོས་པ་ནི་རང་རེའི་མེས་པོ་རྣམ་པས།",
