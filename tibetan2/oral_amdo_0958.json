    "ཁྱོད་སོང་ནས་མོ་ལ་བལྟས་རྗེས་རེམ་པ་ལྡུམ་རར་ཤོག་ཟེར།",
    "རང་གི་ཨ་མ་བཅས་ཚང་མ་ཞུསནས་མི་ཚོགས་རྩེ་དགས་རོལ་བའི་ལྡུམ་རར་སོང་ངོ།",
    "དེ་ནས་ཁ་རོག་ཁ་མི་གྲག་པར་ཕུག་ཁང་དུ་སོང་ནས་ལྟ་དུས།",
    "པོ་གཡུ་ཡང་མོ་ལ་འཚམས་འདྲི་བྱེད་ཞོར་མདུན་གྱི་རྐུབ་སྟེགས་ཐོག་བསྡད།",
    "ངོ་མ་དེ་འདྲ་ག་ལ་མོའི་ན་ཚོད་ཀྱང་ཆུང་བས་ཡུན་རིང་བོ་མི་འགོར་ཡིན།",
    "དྲག་ཐུབ་པའི་རེ་བ་མེད་པ་ང་རང་གིས་ཚོར་ཡོད་ཟེར།",
    "ང་རང་ཁྱོད་ཀྱི་ཕེབས་རོགས་ཞུ་མ་ཐུབ་པར་དགོངས་དག་གནོང་།",
    "གཙང་ཆབ་དྭངས་མོ་རྡོ་སྔོན་སྤུབས་ནས་དབྱུང་།",
    "བཙུགས་ནགས་སྟུག་པོ་དཔལ་གྱི་རི་མོ་ཤར།",
    "རྒྱུན་ལྕེས་ལྡུམ་རའི་མཛེས་ལྗོངས་ལ་ཡིད་མོས་བཞིན་གོམ་པ་དལ་བུས་བསྐྱོད་ཅིང་ཉམས་དགའ་ཞིང་བསྟོད་ར་བྱེད་པའི་སྐབས།",
    "རྒྱུན་ལྕེའི་མདུན་ནས་བསུ་བཞིན་ཨ་སྲུ་ཁྱེད་ཀྱི་སྐུ་བདེ་མོ་ཡིན་ནམ་ཞེས་འཚམས་ཞུ་ཕུལ།",
    "རྒྱུན་ལྕེ་ནི་རིག་པ་གསལ་ཞིང་སྤྱང་གྲུང་འཛོམས་པའི་བུད་མེད་ཅིག་ཡིན་ཕྱིར།",
    "ཁྱོད་དང་ཁ་བརྡ་བྱེད་ཁོམ་མེད།",
    "རྒྱུན་བུར་དགའ་སྤྲོའི་མེ་ལྕེ་རྣམ་པར་འབར་ནས་བཟོད་མི་ཐུབ་པར་གྱུརལྕེས་ཁྱོད་མྱུར་མོར་བཞུགས་གྲལ་དུ་སོང་ནས་སྡོད།",
    "རྒྱུན་ཅ་རུས་ཐག་རིང་པོར་སོང་བའི་ལྕེས་ཀྱང་གོམ་པ་དལ་མོ་སྤོས་ནས་སོང་རྗེས་མོའི་ཁོག་ཏུ་བསམ་དོན་འདི་ནི་གནའ་མིའི་གཏམ་དཔེར།",
    "ང་ཚོ་ལ་ལྷ་ལྕམ་ཁྱེན་འབོད་པར་མངགས་པ་ཡིན་ཞེས་ཞུས།",
    "བྲན་མོ་ཆུང་ཆུང་ཞིག་གིས་ལྷ་ལྕམ་རྣམས་ཐོག་ཁང་དུ་བཞུགས་ཡོད།",
    "སང་ཉིན་ཁྱོད་འདིར་ཁྱིམ་སྤོར་ནས་ཁྱེད་གྲལ་དུ་བཞུགས།",
    "ཉི་མ་ད་རུང་སྔ་གི་ཟེར།",
    "ཁོང་རྣམ་པ་ཚོ་གང་ལ་ཕེབས་སོང་ཞེས་དྲིས་དུས།",
    "གམ་དུ་ཡོད་པའི་རྒན་མོ་ཞིག་གིས་ཁོང་རྣམ་པས་ད་སོ་མ་རོལ་མོ་བ་ཁྲིད་ནས་མཉེས་གཤིན་བསིལ་ཁང་དུ་བདུད་རྩི་བཞེས་པར་ཕེབས་སོང་ཟེར།་",
    "སྟོན་མོ་བཞོས་ཚར་ནས་ལྕོམ་ར་ནས་ཕྱིར་བུད་དེ།",
    "མི་ལ་སེམས་སྡུག་པའི་གནས་སུ་འཕེན་ནོ་ཞེས་གསུང་བཞིན་སེམས་སྡུག་ནས་མུ་མཐུད་དུ་རྒྱུན་ལྕེ་ལ་གསུང་རྒྱུར་ཁྱོད་མ་བུ་གཉིས་ཀ་ཕན་ཚུན་བཟང་ས་ཡིན་ཏེ།",
    "གདོང་གི་མདངས་ཉམས་ཤིང་ཕུར་བོའི་ཤ་ནི་རིད་ཅིང་སྐམ་པར་གྱུར།",
    "མོ་ཆིན་ཁེ་ཁྱེན་གྱི་གམ་དུ་བསྡད་ནས།",
    "ད་སྐབས་དགུན་ཉི་ལྡོག་གི་སྐབས་སུ་འགྱུར་བ་ཆེན་པོ་མ་བྱུང་།",
    "སང་ཉིན་ཡང་གོ་རེ་དེ་བསྐྱལ་ཡོང་།",
    "ད་ང་ཁྱོད་ཀྱི་སྒྱུག་མོའི་གམ་དུ་སོང་ནས་ཞལ་མཇལ་བའི་རྗེས།",
    "ཡང་ཡེ་དང་ཨ་ཡེ་གཉིས་ལ་འཚམས་འདྲི་རེ་ཞུས་ཤིག་ཅེས་གཏམ་བཅོལ།",
    "དེ་ནས་མོ་ལྷ་ལྕམ་ཡོའུ་ཧྲིའི་སྐུ་གམ་དུ་སོང་ནས་བསྡད།",
    "རྒྱུན་ལྕེས་ཚིག་དེ་ཐོས་ནས་དར་ཅིག་ལ་མགོ་བོ་མར་སྒུར་ནས་ཞུ་རྒྱུར་དེ་ཡིན་ཞེས་ཞུ་རྒྱུ་དཀའ་མོ་རེད།",
    "གང་ལྟར་ཀྱང་ཁྱེད་རྣམ་པས་མོ་ཕྱི་མའི་ལྔ་ལམ་དུ་འགྲོ་བའི་གྲ་སྒྲིག་ལེགས་པར་བསྒྲུབ་དགོས།་",
    "གང་ལྟར་ཀྱང་དེ་དོན་དལ་མོར་སྒྲུབ་ཀྱིན་ཡོད་ཅེས་གསུངས།",
    "ཡོའུ་ཧྲིས་ཁྱོད་ཕར་སོང་ནས་ཨ་ཡེའི་རྣམ་འགྱུར་ལ་བལྟས་ནས་དལ་མོར་ཞུ།",
    "མེས་མོ་ཁྱེད་ཐུགས་བདེ་མོར་བཞུགས་དང་།",
    "ལྷ་ལྕམ་ཝང་ཧྥུ་རིན་དང་མཇལ་བའི་རྗེས་རང་གི་གཟིམ་ཁང་དུ་ཡོང་དུས།",
    "རྒྱུན་ལྕེས་སྐད་ཆ་དེ་ཐོས་ནས་སྣ་རྒོད་ཅིག་བྱས་ནས་བྱོལ་སོང་དེ་འཆི་བའི་ཚད་ལ་སླེབས་འདུག་ཁོ་འདིར་འོངས་ནས་ཅི་བྱེད་པར་བལྟ་ཆོག་ཟེར།",
    "ཁྲུང་ཁྲུང་དཀར་མོའི་ཤ་ཟ་འདོད་དང་མཚུངས་ཏེ།",
    "དེ་འདྲའི་རེ་བ་ངན་པ་ཡིད་ལ་འཆར་རམ།",
    "སུན་པོའི་མདུད་པ་འགྲོལ་བ་ན་ཅི་མ་རུང་ཞེས་རེ་བ་བྱེད་ཀྱིན་ཡོད་ཟེར།",
    "ཅ་རུས་ཀྱིས་ཚིག་དེ་ཐོས་ནས་འཛུམ་དམུལ་བཞིན་ང་ནི་ཉིན་བཞིན་ཁོམ་འདུག་དུག་ཉིན་རེར་འདིར་འོངས་ནས་སྲུ་མོའི་གདུངས་པའི་མདུད་པ་འགྲོལ་ན་མི་བཟང་ངམ་ཟེར།",
    "སྐྲུན་ལྕེས་ཧེ་ཧེ་ཞེས་རྒོད་ཀྱིན་ཁྱེད་ཀྱིས་ངའི་མགོ་གཡོག་གིན་འདུག་དུག་ཁྱེད་ངའི་གམ་དུ་འོང་འདོད་ག་ལ་ཡོད་ཟེར་བས།་",
    "གཞན་གྱི་འདུན་པ་རྟོགས་གཉིས་མཛེས་སྡུག་ལང་ཚོ་ལྡན་ཚུལ་ལ་བལྟས་ནས་ཐུབ་མཁན་ཞིག་ཡིན་བསམས་ཀྱང་ཡིན་པ་ནི་གཞན་གྱི་དྲན་ཚུལ་གཏན་ནས་མི་ཚོར་བའི་གླེན་པ་ཤ་སྟག་ཡིན་པ་ངའི་ཡིད་ལ་མ་ཤར་ཟེར།",
    "དེ་དུས་རྒྱུན་ལྕེས་སྐད་འགོ་དམའ་མོ་བྱས་ནས་གུས་བཀུར་གནང་དང་།",
    "རྒྱུན་ལྕེས་འཛུམ་དམུལ་བཞིན་ད་ཁྱོད་ཕྱིར་ཕེབས་རན་འདུག་ཅེས་བཤད།",
    "རིང་མོའི་ནང་ཤོག་ག་སྲུ་མོ་ང་བསྒུགས་ནས་འདུག་ཅེས་བཤད།",
    "འདོད་དོན་འགྲུབ་པར་བསམ་ནས་དགོངས་པ་ཞུས་སྟེ་རང་གི་ཁྱིམ་དུ་ལོགདེ་ནས་ཉིན་རིང་མོ་དེ་མུན་རུབ་དཀའ་བ་ཞིག་བྱུང་།",
    "ཡུན་རིང་བོ་ཞིག་གི་རིང་ལ་མི་གཅིག་ཀྱང་མ་ཡོང་།",
    "ཕར་ཨ་ཡེ་རྒན་མོ་ཞིག་འོངས་ནས་ལངས་མ་ཐག།",
    "ཕྱི་རོལ་ཏུ་སོང་ནས་ཆང་ཏུ་སོང་ནས་མཚན་གང་བོར་ཁྱིམ་དུ་མ་ལོག་པསཡང་ན་སྨད་ཚོང་མའི་ཁྱིམ་དུ་སོང་ནས་རྩེ་འཐུང་བའམ་ཤོ་འཕེན་པ་དང་།",
    "ས་ལག་མཐིལ་ནས་རྔུལ་ཆུ་ཐོན་བཞིན་ཁྱིམ་དུ་ལོག་རུས་ཡང་དངངས་སྐྲག་གི་ཆེའུ་བཅུ་གཉིས་བ།",
    "ཁ་སང་ཅི་ལ་རང་འདོད་ལྟར་སོང་།",
    "ཅ་རུས་ཁྱིམ་དུ་སོང་ནས་མུན་རུབ་བར་བསྒུགས་པ་ན།",
    "མནན་ཡོད་པའི་མི་དེ་སུ་རེད་ཅེ་ན།",
    "ཨ་ཡེས་གནས་ཚུལ་དེ་ཐོས་འཕྲལ་འཚིག་པ་ཐོས་ནས་བརྒྱལ་སོང་།",
    "སང་ཉིན་ངས་ཁྱོད་ལ་བཀའ་དྲིན་མི་ཉུང་བ་ཞུ་ཟེར།",
    "འོན་ཀྱང་ཁྱོད་ཀྱིས་ང་ལ་བཀའ་དྲིན་ཞུ་བའི་དངུལ་ཅི་ཙམ་སྟེར་རྒྱུ་ཡིན།",
    "ང་སྔོན་དུ་སོང་ནས་མི་ཡོད་མེད་ལ་ལྟ་ཡག་བྱས་ནས་ཁྱོད་འཁྲིད་པར་འོང་།",
    "ཡུད་ཙམ་ཞིག་འགོར་ན་གཡོག་མོ་རྣམས་ནན་ཅིན་ནས་འབྱོར་བའི་དངོས་རྫས་འཇོག་པར་འོང་།",
    "རྡོ་སྐས་ཆེན་པོ་ཞིག་གི་འོག་ལག་པས་ནོམ་ཉུག་བྱས་ནས་ཀོང་ཀོང་དེ་སྦེད་ས་བཟང་བོ་ཞིག་རེད།",
    "ལ་འཚོལ་བར་སོང་།",
    "དེ་ཙམ་ལས་མེད་ཅེས་གསུང་གིན་འདུག་ཅེས་ལན་དང་སྦྲག་མི་མངགས།",
    "དེ་ནས་ལྷ་ལྕམ་ཝང་ཧྥུ་རིན་ལ་ཕར་ཚུར་པ་ཉིས་ཀ་ནས་བཙལ་ནས་ཀུན་བསྡོམས་པས་སྲང་དོ་ཚད་ནས་བསྐྱལ་སོང་ཞེས་ཞུ།",
    "ཅ་ཚང་གི་སྤུན་མཆེད་རྣམས་མྱ་ངན་ཞུ་བར་འོངས།",
    "རིགས་རྒྱུད་དུ་བཏོགས་པའི་མི་རྣམས་རང་རང་གི་འབྱོར་བ་དང་བསྟུན་ནས་དངུལ་སྲང་གང་དོའམ་གསུམ་བཞི་རེ་ཕུལ།",
    "སྣང་ལ་མ་ངེས་པའི་ངང་འདྲི་རྒྱུར་ཁྱོད་ལ་རེ་འདུན་ཅི་ཞིག་ཡོད་པ་ང་ལ་བཅོལ་ཆོག་ཟེར།",
    "ཁྱོད་ལ་རིན་ཆེན་སྐེ་རགས་བཅིངས་ཤིང་།",
    "འབྱུང་འགྱུར་ཉམས་རྒུད་དུ་སོང་བའི་དུས།",
    "འོན་ཀྱང་དེ་ཡང་དར་ཅིག་གི་དཔལ་ཡོན་དང་།",
    "གལ་ཏེ་སྔ་མོ་ནས་གཞུག་དོན་མི་བསམ་པར་རྗེས་མར་འགྱོད་ན་མི་ཕན་ནོ་ཟེར།",
    "ཐོག་ནས་རྔུལ་ཆུ་ཁྲོམ་ཁྲོམ་བྱུང་སྟེ་དར་ཅིག་ལ་ཅི་ཡིན་འདི་ཡིན་མ་ཤེསདེ་ནས་མྱུར་མོར་མལ་ནས་ལངས་ཏེ་གོན་པ་གོན་ནས་ལྷ་ལྕམ་ཝང་ཧྥུ་རིན་བཞུགས་སར་སོང་མཚམས་དེར།",
    "ཁྲག་རྩའི་རྒྱུ་ལམ་འཁྱིལ་བའི་རྐྱེན་ཡིན་ཟེར་བཞིན་ཡར་ལངས་ནས་ན་བཟའ་བརྗེས་ནས་ཅ་ཡུམ་གྱི་སྐུ་མདུན་དུ་སོང་།",
    "དེ་ནས་ལྷ་ལྕམ་ཡོའུ་ཧྲི་དང་མཇལ་པར་སོང་དུས།",
    "ད་ནི་ཚེ་ཕྱི་མའི་ལྔ་ལམ་དུ་སོང་ངོ།",
    "འདིར་འཚོགས་ཀུན་ཀྱིས་མི་ནི་གཤེགས་སོང་བས།",
    "ད་ནི་འདས་མཇུག་གི་འདུན་ཇི་ལྟར་བསྒྲུབ་རྒྱུར་གྲོས་མོལ་གནང་རྒྱུ་གལ་ཆེ་ཞེས་ཁ་ཏ་བྱས།",
    "མི་ལོ་ཁྲི་ཕྲག་གཅིག་གི་རིང་ལ་རོ་རུལ་མི་འགྱུར།",
    "ད་དམ་འཐུམ་བརྒྱབ་ནས་ངེད་ཚང་གི་ཚོང་ཁང་དུ་ཉར་ཚགས་བྱས་ཡོད།་",
    "ད་ནི་རིན་ཐང་གི་སྐད་ཆ་མ་བཤད།",
    "ཅ་བྲིན་གྱིས་མྱུར་མོར་ནང་བློན་ཆེན་མོ་ཁྱེད་ཀྱིས་གསུངས་པ་ཧ་ཅང་བདེན་པ་རེད་ཅེས་ཞུས་པས།",
    "ཟེར་བའི་དཔོན་ཆེན་དེའི་གཅུང་གསུམ་པས་དངུལ་དཀར་སྲང་ཆིག་སྟོང་ལྔ་བརྒྱ་ངའི་ཁྱིམ་དུ་བསྐྱལ་ནས་གོ་གནས་དེ་སློང་གིན་འདུག་ངེད་གཉིས་ཀ་ངོ་ཤེས་རྙིང་བ་ཡིན་ཚུལ་ཁྱོད་ཀྱིས་ཤེས་མོད།་",
    "ཁོའི་ཨ་མྱེས་ཀྱི་ཞལ་ངོ་ལ་བལྟས་ནས་ཁོགས་མ་ཐུབ་པར་ཅ་ལེ་ཅོ་ལེ་བྱས་ནས་ཁས་བླངས།",
    "ཏའེ་ཆོན་གྱིས་གཟིགས་པ་ན།",
    "དེ་ནས་ཏའེ་ཆོན་ཕྱིར་ལོག་རྒྱུའི་དགོངས་པ་ཞུ་བར་ཅ་བྲིན་གྱིས་འགོག་ཐབས་མེད་པར་གཟིམ་ཤག་གི་ཆབ་སྒོ་བར་སྐྱེལ་མ་བྱས།",
    "ཡང་ཀྲུང་ཅིན་ཧུ་ཡི་ཆོ་ལོ་ཡོད་པའི་ཧྲི་ཏིན་བྱ་བའི་བཙུན་མོ་དང་རང་གི་ཚ་མོ་ཧྲི་ཞང་ཡུན་མཉམ་དུ་འོང་བའི་འུར་སྒྲ་སྒྲོག་པ་ཐོས་ནས།",
    "སྒོ་ཡི་གཞོགས་གཉིས་སུ་རོལ་མོ་འབུད་དཀྲོལ་བྱེད་པའི་རོལ་ཁང་གསར་དུ་བསྐྲུན་ཏེ།",
    "གལ་ཏེ་དཔོན་རིགས་ཆེ་ཁག་གི་བཀས་བཀོད་རྗེ་མོ་རྣམས་ཕར་སྐྱེལ་ཚུར་ཏསུ་བཀུར་བསྟི་སྣེ་ལེན་ཡག་པོ་ཞུ་མ་ཐུབ་ཕྱིན།",
    "ཅད་བདེ་བླག་ཏུ་གྲུབ་སོང་མོད།",
    "བློ་ཁེལ་བར་བདག་གིས་འགན་ལེན་བྱེད་ཆོག་ཟེར།",
    "ཅ་བྲིན་གྱིས་འཕྲལ་མར་སུ་རེད་ཅེས་དྲིས།",
    "ཟེར་བཞིན་པོ་གཡུ་ཁྲིད་ནས་མི་མང་བཞུགས་པའི་གྲལ་ནས་ཐོན་ཏེ་མགྲོན་ཁང་གོང་མར་སོང་།་",
    "དེ་རིང་ངལ་བ་ཅུང་གསོས་ན་འགྲིག་མོད།",
    "ཁྱིམ་དེ་ད་བལྟས་བལྟས་རིག་རིག་གིས་ཁྱིམ་ཚང་མི་ཉན་པར་འགྱུར་བས།",
    "ཟླ་བ་གཅིག་གི་རིང་ལ་སྲིང་མོ་ཆེ་བ་ཁྱེད་འདི་ཀར་ཕེབས་ནས།",
    "བདག་གི་སེམས་བདེ་བར་འགྱུར་ཞེས་ཞུས།",
    "ལྷ་ལྕམ་ཝང་རྒྱུ་རིན་གྱིས་མྱུར་མོར་མོ་ནི་བུ་མོ་ཆུང་བ་ཡིན་ཕྱིར།",
    "དེ་འདྲའི་བྱ་བ་བསྒྲུབས་མ་མྱོང་ཞིང་མིག་གིས་ཀྱང་རིག་མ་མྱོང་ལ།",
    "སྲིང་མོ་ཆུང་དུས་ནས་རྩེ་ད་གའ་ལྡན་ཞིང་སྨྲ་མཁས་པ་ཞིག་ལས།",
    "ང་རང་གིས་ཉིན་འགའ་ཡི་རིང་ལ་བསམ་བློ་བཏང་ནས།",
    "སྲིང་མོ་ཆེ་བ་ལས་གཞན་བློ་བཀོད་ག་ཉིས་ལྡན་གྱི་མི་མ་རྙེད་ཀྱི།",
    "གང་ལྟར་ཀྱང་སྲིང་མོ་ཁྱེད་རང་ལ་དཀའ་ལས་གཏོད་དགོས་བྱུང་སོང་།",
    "གལ་ཏེ་ཉིན་རེ་བཞིན་ཕར་ཕྱོགས་ནས་ཚུར་ཕེབས་ན་ལྷག་ཏུ་སྐུ་ངལ་འོ་བརྒྱལ་ཆེ།",
    "ཕར་ཕྱོགས་ཀྱང་ང་མེད་ན་མི་ཆོག་ཉིན་རེ་བཞིན་དུ་འདིར་ཡོང་ན་ཆོག་ཅེས་ཟེར།",
    "ཡང་ཁ་བརྡ་ཡུད་ཙམ་ཞིག་ལ་ལབ་ནས་ད་གཟོད་བུད་སོང་ངོ།",
    "ལྷ་ལྕམ་ཝང་ཧྥུ་རིན་གྱིས་རྒྱུན་ལྕེ་ལ་དེ་རིང་ཁྱོད་འདིར་འདུག་རྒྱུའམ་ཕྱིར་ལོག་རྒྱུ་ཞེས་དྲིས་དུས།",
    "ཚང་མས་ཀྱང་དེ་བདེན་པ་རེད་ཟེར།",
    "དེའི་གྲས་ཀྱི་མི་ཞིག་གིས་རྒོད་ཀྱིན་ན་རེ།",
    "མི་ཉི་ཤུ་ཐམ་པ་འདི་ལ་ཚན་ཁག་གཉིས་སུ་ཕྱེ་ནས་རེས་མོས་བཞིན་གཉེན་ཉེ་དུ་འོངས་པ་རྣམས་ལ་གསོལ་ཇ་འདྲེན་རྒྱུ་ལས།",
    "མི་སུ་ཞིག་གིས་ཁང་པ་གང་བདག་བྱེད་ན།",
    "ལས་ཚན་གང་དང་མི་སུ་ཞིག་གིས་སྒྲིག་ལམ་དཀྲུགས་ན་མི་དེ་དང་ཞིབ་རྩིས་རྒྱག་རྒྱུ་ཡིན།",
    "ཁྱོད་ཚོའི་ཕར་ཁའི་གཟིམ་ཁང་དུའང་དུས་ཚོད་འཁོར་ལོ་ཡོད་ཕྱིར།",
    "ཉིན་རེའི་དུས་ཚོད་ལྔ་དང་སྐར་མ་སུམ་ཅུའི་ཐོག་ངས་འདིར་ཞོགས་པའི་ཚང་རྩིས་རྒྱག་རྒྱུ་ཡིན།",
    "དོན་དག་ཞུ་མི་ཐམས་ཅད་དུས་ཚོད་བཅུ་གཅིག་དང་སྐར་མ་སུམ་ཅུའི་ཐོག་ཤོག་ཕྱི་དྲོ་དུས་ཚོད་ལྔ་བའི་ཐོག་གཤེགས་པོར་འདོད་ཡོན་བསྡོས་ནས་མཆོད་ཤོག་བསྲེག་དེའི་རྗེས་སུ་ང་རང་གིས་ཁང་པ་སོ་སོ་དང་ས་ཆ་ཀུན་ཏུ་སོང་ནས་ཞིབ་ལྟ་ཐེངས་གཅིག་བྱས་ཏེ་ཚུར་ཡོང་ནས་མཚན་མོར་ཐུན་པ་སྡོད་མཁན་ལ་ལྡེ་མིག་སྤྲོད་རྒྱུ་ཡིན།",
    "ཟིམ་ཤག་འདི་ཀའི་སྐུ་ཞབས་ཀྱིས་ཁྱོད་ཚོ་ལ་བདག་རྐྱེན་གནང་ངེས་རེད་ཅེས་གསུངས།",
    "མི་གང་ཞིག་གིས་ཅ་ལག་དང་དག་བླངས་ཡོད་ཅེས་ཕོ་ཡིག་གི་ངོར་ཧ་ཅང་གསལ་པོར་བཀོད་ཡོད།",
    "སྔར་བཞིན་ལས་ཀ་ཡང་མོ་བཙལ་ནས།",
    "ལྕི་མོ་ལས་མི་འདོད་པའི་གནས་ཚུལ་དེ་མ་བྱུང་ལ།",
    "རྐུས་ཁྱེར་བྱས་པའི་གནས་ཚུལ་ཡང་མ་ལྷག་ཏུ་ཕར་འགྲོ་ཚུར་འོང་གི་འགྲུལ་བ་རྣམས་ཞི་འཇམ་དུ་གྱུར་པ་བྱུང་།",
    "ལྐོག་སྦེད་རྐུས་ཁྱེར་གྱི་ཉེས་སྐྱོན་དག་གིས་དབེན་པར་གྱུར་ཏོ།",
    "ཉིན་རེར་དུས་ཚོད་ལྟར་ཕེབས་པ་དང་།",
    "འགྲུལ་བ་སྐྱེས་དམན་རྣམས་ཡོང་ན་ཡང་མོ་རང་གིས་བསུ་སྐྱེལ་མི་བྱེད་དོ།",
    "སྟག་གི་དུས་ཏེ་དུས་ཚོད་ལྔ་བའི་ཐོག་གཟིམ་མལ་ནས་བཞེངས་ཏེ་ཞལ་ཁྲུས་བྱས་པ་དང་།",
    "ཡོས་ཀྱི་དུས་ཏེ་དུས་ཚོད་བདུན་དང་སྐར་མ་སུམ་ཅུར་སླེབས་འདུག་ལེ་ཝང་གི་ཆུང་མ་དང་འཁོར་རྣམས་ཁྲིད་འོངས་ནས་སྒོ་ཁར་མོ་ལ་བསྒུགས་འདུག་རྒྱུན་ལྕེ་ཁང་ཆེན་ནས་བུད་དེ་ཤིང་རྟར་བཞུགས།",
    "རྒྱུན་ལྕེས་གོམ་པ་དལ་མོར་སྤོ་བཞིན།",
    "གཉེན་ཚན་འཚོགས་པའི་གྲལ་ནས་བུད་དེ།",
    "རང་གི་བཞུགས་སར་ཕེབས་སོ།",
    "བྲན་མོ་དེ་དངངས་སྐྲག་སྐྱེས་ནས་ཡོང་།",
    "ཞེན་གྱི་ཆུང་མ་ལ་ཁྱོད་ཡོང་དོན་ཅི་ཡིན་ཞེས་དྲིས།",
    "མོ་དེ་བུད་སོང་།",
    "པོ་ག་ཡུས་ང་ཚོས་ཟ་མ་ཟོས་ཚར་རོ་ཟེར།",
    "རང་ཤག་ཏུ་ཨ་ཕྱེ་རྨོ་རྨོ་དང་ལྷན་དུ་ཟ་མ་ཟོས་ནས་འོངས་པ་ཡིན་ཟེར་ནས་བསྡད།",
    "དེ་རིང་ཁྱོད་ལེན་པར་ཡོང་དགོས་མོད་ད་རེག་ཏུ་མ་ཡོང་བས་ངས་ཁྱོད་ཀྱིས་བརྗེད་སོང་བ་ཡིན་ནམ་སྙམ།",
    "གལ་ཏེ་བརྗེད་སོང་བ་ན་ཁྱོད་རང་གིས་ལེའུ་བཅུ་བཞི་བ།",
    "ད་ཅུང་ཟད་འགོར་བ་ན་ལེན་མི་ཐུབ་པར་འགྱུར་ཞེས་ཟེར་ནས་ཁ་འགྲིག་རྟགས་བྱང་བླངས་ནས་སོང་ངོ།",
    "ད་ནི་ངས་ཁྱོད་ལ་འདྲི་རྒྱུ་ཞིག་ཡོད་དེ།",
    "དུས་ལ་བབ་ན་རང་གིས་འགྲུབ་འོང་ཟེར།",
    "ཁྱོད་སེམས་བདེ་མོར་སྟོད་དང་།",
    "ཁྱོད་ཀྱིས་འདི་འདྲའི་གླེན་རྟགས་མ་སྟོན་ཟེར།",
    "མི་ཞིག་གིས་སུའུ་ཀྲུའུ་ས་ཆར་སོང་བའི་ཀྲའོ་འར་ལོག་འོངས་ཞེས་ཞུས།",
    "རྒྱུན་ལྕེས་མྱུར་མོར་ནང་དུ་ཤོག་ཅེས་གསུངས།",
    "ཀྲའོ་ལེར་ཡོང་ནས་པུས་མོ་ས་ལ་བཙུགས་ཏེ་འཚམས་འདྲི་ཞུས།",
    "ནས་ཅ་ཡུམ་ཁོང་གི་མཛུབ་སྟོན་གང་ཡོད་ལ་ཉན་པ་སོགས་ཀྱི་དོན་དུ་འོངས་པ་ཡིན།",
    "ཕྱོགས་ག་ཅིག་ནས་ལམ་བར་གྱི་བདེ་སྡུག་ཞིབ་མོར་དྲིས།",
    "གལ་ཏེ་དེ་བཞིན་དུ་མ་བྱས་པ་ང་རང་གིས་ཚོར་ན་ཁྱོད་ཀྱི་རྐང་པ་གཅོག་རྒྱུ་ཞེས་བཅོལ་གཏམ་གནང་དུས།",
    "ཀྲའོ་ལེར་འཛུམ་དམུལ་བཞིན་རེ་རེ་ཁས་བླངས་ནས་སོང་ངོ།",
    "དེ་དུས་ནམ་གུང་གཟུར་ནས་ཐུན་བཞི་བར་སླེབས་འདུག་མོ་གཟིམས་ནས་ཅང་མ་འགོར་བར་སྐྱ་ཤ་སེ་ནམ་ལངས།",
    "ཞི་ཨན་ཇུན་ཝང་གི་བཙུན་མོའི་འཁྲུངས་སྐར་རན་ཡོད་ཕྱིར།",
    "རང་གི་སྤུན་མཆེད་ཝང་རིན་བཟའ་ཚང་ཀུན་པོ་ལྷོ་ཕྱོགས་ཀྱི་ཕ་ཡུལ་དུ་ཕེབས་རན་པས་ཕ་མ་ལ་འཕྲིན་ཡིག་འབྲི་དགོས་པ་དང་འཚམས་རྟགས་ཚོགས་སྒྲིག་བྱེད་དགོས་པར་མ་ཟད།",
    "བྲེལ་བ་ཆེ་ནའང་མོ་ཆུང་དུས་ནས་སྤོབས་པ་ཆེ་ཞིང་།",
    "གཟུགས་ལང་ཚོ་མཛེས་ཤིང་།",
    "མེ་འོད་འཕྲོ་བའི་འོག་མོས་ཕར་འགྲོ་ཚུར་འོངས་པའི་སྐུ་མགྲོན་རྣམས་ལ་བསུ་སྐྱེལ་བྱས་ཤིང་།",
    "བུ་མོ་པོ་ཀྲུའུ་ན་ཆུང་བུ་མོའི་གུས་ཚུལ་གྱིས་མདུན་ནས་པུར་འདྲེན་པའི་ལམ་སྟོན་ཅིང་མྱ་ངན་གྱི་མཆི་མས་གདོང་པད་བཀྲུས་བཞིན་སོང་ངོ།",
    "ཞི་ཨན་རྫུན་ཝང་གི་ཚ་བོ།",
    "རོལ་མོ་དཀྲོལ་མཁན་དང་བཅས་པའི་བསྟར་ཕྲེང་ས་ལེ་བར་བཞི་ལྔ་ཙམ་བསྒྲིགས་འདུགམདུན་དུ་ཅུང་ཟད་རེ་སོང་ན།",
    "ག་ཉིས་པ་ནི་ནན་ཨན་ཇུན་ཝང་ཚང་གི་ཡིན།",
    "ཁོང་གི་བ་ཟུགས་ནི་མཛེས་ཤིང་སྡུག་པ།",
    "ལང་ཚོ་དར་ལ་བབ་པ།",
    "སེམས་སུ་ངེད་ཅིག་གི་མེས་པོ་གོང་མ་གོང་མའི་རིང་ནས་བཟང་ས་བ་རྒྱན་སསྐྱིད་སྡུག་མཉམ་མྱོང་།",
    "དབྱར་མཚོ་བརྡོལ་བ་ལས་ཐོན་པའི་གཡུ་འབྲུག་ཟུང་གིས་དཔྲལ་མཚམས་བརྒྱན་པ།",
    "མུ་ཏིག་གི་ཕྲ་བརྒྱན་པའི་དངུལ་གྱི་སྐ་རགས་བཅིངས་ལ།",
    "ཁོང་གིས་འཛུམ་དམུལ་བཞིན་མཛེས་ཆ་ཀུན་ནས་འཛོམས་ཤིང་།",
    "ཝང་གི་ཕྱག་ཏུ་ཕུལ་བས།",
    "ཁོང་གིས་ཕྱག་ཏུ་བཟུང་ནས་ཞིབ་མོར་གཟིགས།",
    "པོ་གཡུས་རེ་རེ་བཞིན་ལན་གླན་ནོ།",
    "ཚིག་གི་གོ་རིམ་མི་འཁྱོལ་བ་ཞིག་ཡིན་པ་མཐོང་ནས།",
    "དགུང་ལོ་བགྲེམའི་ཡུམ་ཆེན་གྱིས་ཧ་ཅང་གཅེས་འོས་ངེས་རེད།",
    "འོན་ཀྱང་ང་ཚོའི་ན་ཚའི་ཚོ་ཆུང་བའི་མི་ལ་འདོད་པ་བཞིན་བསྐྱུར་མི་ཉན།",
    "དེ་རིང་ཁྱོད་ལ་དགའ་བའི་འཚམས་རྟགས་བྱིན་ཞེས་གསུང་དུས།",
    "ཅ་ཕྲིན་སོགས་མི་སྐོར་ཅིག་གིས་ཆིབས་པ་བཅིབས་ནས་ཕེབས་སོ།",
    "ཁྱོད་ནི་རིགས་རུས་མཐོ་ཞིང་།",
    "ན་ཆུང་བུ་མོ་བཞིན་མཛེས་པའི་མི་ཡིན་པས།",
    "དེ་གཉིས་ལྷ་ལྕམ་ག་ཉིས་ཀྱི་གམ་དུ་སོང་ནས་ཕྱིར་ལོག་སྟེ་ཞུ་རྒྱུར་ལྕམ་གཉིས་ཀྱིས་འབབ་མི་དགོས།",
    "ཨ་ནི་ཁྱེད་རང་གི་འདོད་པ་དང་བསྟུན་ཞེས་གསུངས་ཞེས་ཡར་ཞུ་འབུལ།",
    "སྐབས་དེར་ཆིན་ཀྲུང་རྟར་ཞོན་ནས་ཨ་ཕའི་ཁྱོགས་བྱམས་བཅར་ཏེ་བསྐྱོད་བཞིན་ཡོད།",
    "གྲོང་བའི་བུད་མེད་དང་།",
    "ལོ་བཅུ་བདུན་བཅོ་བརྒྱད་ལོན་པའི་གྲོབ་བའི་བུ་མོ་ཞིག་འོངས་ནས་འཁོར་ལོ་བཅག་མ་གཏོང་ཟེར།",
    "པོ་གཡུས་གྲུ་མོས་ཕུད་རྒྱག་བྱས་ཏེ་ད་མུ་ཅོར་སྨྲས་ན།",
    "བུ་མོ་འདིས་འཁྱུག་པོར་སྐུད་པ་འཁེལ་བས་ངེས་པར་ལྟད་མོ་ཞིག་འདུག་གོམཚམས་དེར་ཕར་ཕྱོགས་ནས་རྒན་མོ་ཞིག་གིས་བུ་མོ།",
    "བུ་མོ་དེ་མ་ཐག་རྒན་མོའི་གམ་དུ་སོང་ངོ།",
    "དེ་ནས་འཁོར་རྣམས་ཀྱིས་གསོལ་ཇ་དང་གོ་རེ་སིལ་ཏོག་དྲངས་པ་རྒྱུན་ལྕེ་སོགས་ཀྱིས་བཞེས་རྗེས།",
    "འཁོར་རྣམས་ཀྱིས་སྡུད་གསོག་བྱས་ནས་ཤིང་རྟའི་ཐོག་བུད་དེ་ལམ་དུ་ཆས་སོ།",
    "དེ་གའི་བུད་མེད་ཚོ་ཡོང་ནས་བཀའ་དྲིན་ཞུ་དུས།",
    "བདུག་སྤོས་སྣང་གསལ་གྱི་མཆོད་བག་མའི་པུར་འདུ་ཁང་ཆེན་མོའི་ཟུར་ཁང་དུ་བཞག་སྤྲིན་བཤམས་ཏེ།",
    "ཡང་ན་ཇོ་མོ་དགོན་དུ་སོང་ནས་བསྡད་པ་ཅི་རིགས་ཡོད།"
  ]
}