    "བུམ་སྒྲུབ་ཆེན་མོའི་ཐོག་མའི་ཁྲི་འཛིན་སྐབས་སུ་ཡོངས་འཛིན་མཁན་མིང་ཡོན་ཏན་མགོན་པོས་སྨྲས་པ་ཚེ་རབས་ཀུན་ཏུ་སྐྱབས་མགོན་མཆོག་གིས་དགྱེས་བཞིན་རྗེས་སུ་འཛིན་པར་གྱུར་ཅིག།",
    "སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་དུ་བསྐྲུན་ནས་བཀྲམ།",
    "བྃ་ཡིག་ནང་གི་རྡོ་རྗེ་བཙུན་མོའི་མཆོག།",
    "རེ་རེ་རེ་རེ་འཕེལ་བ་གོམས་པའི་མཐུས།",
    "བདེ་བ་མཆོག་གིས་བདག་རྒྱུད་ཚིམ་པར་མཛོད།",
    "སྤྲུལ་པའི་འཁོར་ལོའི་ལས་ཀྱི་གཏུམ་མོ་དང་།",
    "བདེ་ཆེན་འཁོར་ལོའི་འོད་ཀྱི་གཏུམ་མོ་གཉིས།",
    "རྡོ་རྗེ་བཙུན་མོ་ཉི་མ་འབུམ་གྱི་གཟིས།",
    "བདེ་སྟོང་མཆོག་གི་དཔལ་ལ་རོལ་པར་མཛོད།",
    "ཉུལ་བས་གང་གི་མཛོད་སྤུར་འཁྱིལ་རིས་ཅན།",
    "ནང་གི་ཕག་མོས་གཟུང་འཛིན་འཁྲིལ་ཞིང་བཅོམ།",
    "མཆོག་གི་དྷཱུ་ཏཱིར་ཞུགས་པའི་གར་མཁན་མ།",
    "ཤེས་རབ་ཕག་མོའི་པདྨར་རྡོ་རྗེ་རོལ་མཛད་པའི།",
    "བཀྲ་ཤིས་གང་ཞིག་གསང་ཆེན་ཟབ་མོའི་དོན་སྟོན་པ།",
    "བཀྲ་ཤིས་གང་ཞིག་ཞིང་སྐྱོང་མ་མོའི་ཚོགས་རྣམས་ཀྱིས།",
    "བསྒྱུར་མཛད་གྲངས་མེད་མཁའ་འགྲོའི་གཙོ་མོ་མཆོག།",
    "ཧེ་རུ་ཀ་དཔལ་གསུང་གི་བདེན་པ་དང་།",
    "བདག་གི་ལྷག་བསམ་དག་པའི་བདེན་པ་ཡིས།",
    "གྲངས་མེད་མཁའ་འགྲོའི་གཙོ་མོ་རྗེ་བཙུན་མ།",
    "ཁྱོད་སྐུ་པདྨ་རཱ་གའི་ལྷུན་པོ་ལ།",
    "ཁྱོད་ཀྱིས་གསང་བའི་མན་ངག་ལེགས་ཐོབ་ནས།",
    "འོན་ཀྱང་བདག་བློ་ཉོན་མོངས་ཚན་ཆེས་པས།",
    "ཅེས་རྗེ་བཙུན་རྡོ་རྗེ་བཙུན་མོ་ལ་གདུང་ཤུགས་ཀྱིས་གསོལ་བ་འདེབས་པ་འདི་ཡང་།",
    "མངྒ་ལཾ། ། རྗེ་བཙུན་ནཱ་རོ་མཁའ་སྤྱོད་མའི་ཞིང་གི་བཀོད་པ་དང་མཐུན་པར་བསྟོད་པ་མཁའ་སྤྱོད་བགྲོད་པའི་ཐེམ་སྐས་ཞེས་བྱ་བ་བཞུགས་སོ། ། ཨོཾ་སྭ་སྟི།",
    "འདི་ནས་སྟེང་གི་ཕྱོགས་སུ་རབ་བགྲོད་པར།",
    "རྡོ་རྗེའི་ཏོག་གིས་མཛེས་དེར་གསོལ་བ་འདེབས།",
    "བདག་གི་ཡི་དམ་རྡོ་རྗེ་རྣལ་འབྱོར་མར།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་སྤྱན་གསུམ་གྱེན་དུ་གཟིགས།",
    "གཡོན་གྱི་གྲུ་མོར་ཁ་ཊྭཱཾ་ག་ཡིས་མཛེས།",
    "གཞལ་མེད་ཁང་གི་སྟེང་གི་བ་གམ་ནང་།",
    "གཞལ་མེད་ཁང་གི་འཁྱམས་སོགས་ཕྱོགས་ཀུན་ཏུ།",
    "དེ་ལྟར་བདག་གིས་ཚེ་རབས་ཐམས་ཅད་དུ།",
    "རྡོ་རྗེ་བཙུན་མོས་ཉེ་བར་བསྐྱང་དུ་གསོལ།",
    "འཛུམ་པའི་བཞིན་དང་གླུ་དབྱངས་རོལ་མོའི་སྒྲས།",
    "སླར་ཡང་ཐམས་ཅད་ལ་ནང་མཆོད་ཆུ་ཆང་གིས་བྲན་ལས་ཀྱི་རྡོ་རྗེས་ཕྱག་གསུམ་བཙལ་ལ།",
    "ཨོཾ་ཨོཾ་ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གིས་ནང་མཆོད་ཕུལ།",
    "བདག་གི་ཚོགས་ཀྱི་ཁྱད་པར་འདི།",
    "དེ་ནས་ལས་ཀྱི་རྡོ་རྗེས་ལག་པ་གཉིས་པདྨའི་ཕྱག་རྒྱ་ལས་སྲིན་ལག་གཡས་ཀྱིས་སྟེང་གི་བ་ལ་འཛིན་པས་རྡོ་རྗེ་སློབ་དཔོན་ནས་རིམ་བཞིན་མ་དཱ་ན་འགྲིམ་ཚར་བ་དང་།",
    "འདི་དག་གི་སྐབས་སུ་སྣོད་དང་མི་ལྡན་པའི་སྐྱེ་བོས་དབེན་པར་བྱས་ལ།",
    "དེ་ཡང་ཚོགས་ཀྱི་སྐབས་སུ་ཤ་ལ་བ་ལ་དང་།",
    "ལས་ཀྱི་རྡོ་རྗེས་སྣོད་གཅིག་ཏུ་མས་རིམ་གྱིས་ཚོགས་ལྷག་བསྡུས་པ་མཚན་མོ་ཡིན་ན་གྲིབ་གནོན་གྱི་གདོན་བསྲུང་བའི་ཕྱིར་དཔལ་འབར་དང་བཅས་རྡོ་རྗེ་སློབ་དཔོན་གྱི་མདུན་དུ་སྟེགས་ཀྱི་སྟེང་དུ་བཞག་ཆུ་གཙང་དང་སློབ་དཔོན་གྱིས་ཆང་གི་ཁ་ཕྲུ་འབར་བའི་ཕྱག་རྒྱའི་བར་ནས་གཏོར་ཞིང་།",
    "ཌཱ་དྲིལ་དང་རོལ་མོའི་སྒྲ་རྒྱ་ཆེར་བྱ་ཞིང་།",
    "ཡང་ཚོགས་པ་མང་པོ་མེད་ཅིང་ལས་སློབ་ཀྱི་འོས་སུ་གྱུར་པ་མེད་ན་ལས་སློབ་ཀྱི་ངག་འདོན་རྣམས་དོར་ལ་གཞན་ཚིག་བཅད་ལྷུག་ཐམས་ཅད་རང་གིས་བརྗོད་ལ་དམིགས་པ་དང་མ་བྲལ་བར་བྱ་བ་ཉིད་དོ།",
    "དེ་ཡང་རྗེ་བཙུན་མ་འདི་ཉིད་ཀྱི་ཚོགས་མཆོད་མཛད་པ་འགའ་ཞིག་གིས་ནི་ཡོད་པའི་སྒོ་བོར་ནས་མེད་པའི་སྲང་འཆག་པ་ལྟར་རང་གི་ཡི་གེ་བཞག་ནས་རྙིང་མའི་ཡི་གེ་ལ་དཔེ་བླངས་ནས་མཛད་པ་ཡང་ཕན་ཚུན་འདྲེས་པའི་ཕྱག་ལེན་མ་ལེགས་པར་མཐོང་ཞིང་།",
    "འགའ་ཞིག་གིས་ནི་སྣ་ཚོགས་བསྲེས།",
    "འགའ་ཞིག་གིས་ནི་བྱ་འདོད་ཀྱང་ལག་ལེན་གྱི་འབྲང་ལ་རྡུགས་པར་མཐོང་ནས་གོང་སྨོས་ཀྱི་བསྟན་བཅོས་དེ་རྣམས་ཀྱི་དགོངས་དོན་དང་།",
    "འདི་དག་གི་གོ་རྒྱུ་དང་མཐའ་དཔྱོད་དང་ལག་ལེན་རྒྱས་པར་གོང་མའི་ཡི་གེ་དེ་རྣམས་ལས་རྟོགས་པར་བྱའོ།",
    "མངྒ་ལཾ། ། རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་ཚོགས་མཆོད་ཟབ་དོན་ཉིང་ཁུ་ཞེས་བྱ་བ་བཞུགས་སོ། ། ན་མོ་གུ་རུ་བཛྲ་ཝཱ་ར་ཧཱི།",
    "ན་མོ་གུ་རུ་བུདྡྷ་དྷྭ་ཛ་ཡེ།",
    "ལག་ཏུ་བླང་བ་ནི་མན་ངག་གི་སྐབས་སུ་ཤེས་པར་བྱའོ།",
    "ཐུན་གྱི་ཐོག་མཐའ་འམ་ཐུན་རེའམ།",
    "ཞག་རེའམ་ཟླ་བ་རེ་ལ་རེ་རེ་བསྟེན་ལ།",
    "ཐ་ནའང་ལོ་རེའི་དཔྱིད་ཟླ་འབྲིང་པོར་ཚེས་གཅིག་གམ་བཅོ་ལྔ་ལ་རེ་རེ་བསྟེན་ནོ།",
    "ཤ་ཆེན་དམ་ཚིག་མཆོག་གིས་ནི།",
    "དཔལ་ལྡན་རྩེ་མོ་ཞབས་ཀྱིས།",
    "དང་པོ་ལ་གང་ཟག་གི་སྒོ་ནས་དཔའ་བོ་དང་དཔའ་མོ་གཉིས་ཀ་འཚོགས་ན་ཚོགས་ཀྱི་འཁོར་ལོ།",
    "དཔའ་བོ་འབའ་ཞིག་ཚོགས་ན་དཔའ་བོའི་སྟོན་མོ།",
    "དཔའ་མོ་འབའ་ཞིག་ཚོགས་ན་དཔའ་མོའི་སྟོན་མོ་སྟེ།",
