    "དོན་ལོགས་ནས་རྙེད་པར་ཅང་གདའ་འམ།",
    "བཅོམ་ལྡན་འདས་ཀྱང་སྐུ་དྲང་པོར་བསྲངས་ཏེ་དྲན་པ་མངོན་དུ་བཞག་གསུངས་པ་མ་གཏོགས་ལུས་སྒུར་ཏེ་དང་འགྲེང་སྟེ་དྲན་པ་མངོན་དུ་བཞག་ཟེར་བ་མི་འདུག་གོ།",
    "སེམས་འདས་མ་འོངས་ཀྱི་གཟུང་འཛིན་འཕྲོ་འདུ་ཐམས་ཅད་དང་བྲལ་བར་དམིགས་རྟེན་ལ་ཙེ་ནེ་བཞག་དེ་ལྟ་བུའི་ཤེས་པ་རང་ངོ་ཤེས་ཤིང་རང་བཞིན་རྣམ་དག་དེ་ལ།",
    "སེམས་རང་ངོ་ཤེས་ཤིང་རང་གསལ་འཛིན་པ་མེད་པ་དེ་ལ་རྒྱ་བོད་ཀྱི་མཁས་ཤིང་གྲུབ་པ་ཕལ་ཆེར་གྱིས།",
    "སྐུ་གསུམ་གྱི་རང་ཞལ་སྟོན་གྱི་གདའ་སྟེ།",
    "དཔེར་ན་ཆུ་ཞིག་འདུག་ན།",
    "ཁྱི་ལེ་འདུག་ཀྱང་ཆུ།",
    "འཁྱགས་པོར་འདུག་ཀྱང་ཆུ་ལས་མ་འདས།",
    "ཙེ་ནེ་བཞག་ཙ་ན་ལྷན་ནེ་སྡོད་པ།",
    "ཤིག་བཤེགས་ཙ་ན་ལྷོད་གྲོལ་བ་ཞིག་འོང་།",
    "ཅེར་བལྟས་ཙ་ན་ལྷག་མཐོང་བ་ཞིག་འོང་།",
    "ཤེས་པ་སྤྲོས་བྲལ་དུ་ལྷན་བཞག་ཙ་ན་རྟོག་པ་རང་འགགས་སུ་འགགས་ནས་གསལ་སྟོང་རྟོག་མེད་དུ་བཞག་ཚད་འགྲོ་བ་ཞིག་བྱུང་ན་ཉམས་མྱོང་སྐྱེས་པ་ཟེར།",
    "ངས་ཤེས་པ་སྤྲོས་བྲལ་དུ་བཞག་ཙ་ན་རྟོག་པ་རང་འགགས་སུ་འགགས་ནས།",
    "སེམས་ཀྱི་ངོ་བོ་ལ་བལྟས་ན་ཡོད་མེད་ཡིན་མིན་སྐྱེ་ས་འདུག་གནས་གང་ཡང་མ་མཐོང་ན་སུས་སུ་ལ་དགའ་མི་དགའ་བྱེད་སྙམ་སྟེ།",
    "ཡུལ་རྗེས་མི་འབྲེང་རང་སོར་ཞོག།",
    "ངལ་དུབ་ཀྱི་ལས་དང་འགྲོ་འདུག་སོགས་ལ་བརྟེན་ནས་བྱིང་རྨུགས་འཐིབ་གསུམ་ལྡང་སྟེ།",
    "འཐིབ་པ་ནི་སྒོམ་ལ་རིག་པ་གཏད་མཉམ་པར་བཞག་ཙ་ན།",
    "རྒོད་ན་འགོལ་སར་འདུག་ལྟ་སྟངས་སྨད།",
    "འདི་ཀུན་རང་བྱུང་རང་ཞིར་འགྱུར།",
    "ཡང་ཡང་རང་ལ་བསྟིམ་འདི་བསྒོམ་མ་སྐྱེས་པ་བསྐྱེད་པར་བྱེད་པ་ཡང་ཡིན།",
    "རྩུབ་ཉམས་ཀྱི་རྣམ་པས་སྒོམ་ལ་འདུན་པ་གཏད་ཙ་ན་བསྐྱང་མི་བདེ་བ་ཚིག་པ་ཟ་བ།",
    "རྣམ་པར་རྟོག་པ་ཁོ་རང་ལ་སྒོམ་གྱི་ངོ་ཐི་བྱེད།",
    "རྣམ་རྟོག་ཁོ་རང་གང་འགྱུ་འགྱུ་བཅུག་ནས།",
    "ཁོ་རང་རི་མཐོ་བ་ཐམས་ཅད་མཐོང་ས་ཞིག་ཏུ་འགྲོ་ནས།",
    "ཁོ་རང་ཡང་དལ་བ་ཐབས་མཁས་པ་ཡིན་ལ།",
    "བཀག་པས་ཁེགས་པར་མི་འདུག་དིང་རི་བ།",
    "སེམས་སྟོང་པ་ཉིད་ཀྱི་དཔེ་ནམ་མཁའ་ཁོ་ན་ལ་མཛད་འདུག་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་སེམས་གསལ་བའི་དཔེ་ཉི་ཟླ་ལ་བྱས་འདུག་ཀྱང་།",
    "རྣམ་རྟོག་ཁོ་ནའི་སྣོན་པར་འདུག་ད་ནི་བདེ་གསལ་མི་རྟོག་པ་ལ་སོགས་པའི་རྩོལ་བ་མེད་པར་ཀློད་ཀྱིན་བཞག་མེད་མེད་པོ་སྟོང་སྟོང་པོ་གང་ལ་ཡང་དམིགས་པར་མི་བྱའོ།",
    "དང་པོ་འཕྲོ་ཙུག་འདུག་ཀྱང་གོམས་པས་རྟོག་པ་ཇེ་ཉུང་།",
    "དེ་ལྟར་སྔར་གྱི་གཉེན་པོ་ཐམས་ཅད་རྣམ་རྟོག་སྐྱེས་འདུག་པས།",
    "བདེ་བ་ཆེན་པོའི་ངང་ནས་ཟས་གོས་ལ་སོགས་པའི་ཡིད་གཡོ་བ་དང་བྲལ་ནས་ཉིན་མཚན་འདྲེས་ཏེ་ཉིན་ཞག་གསུམ་བཞི་ལ་མཉམ་བཞག་གཅིག་ཏུ་འདུག་པས་ཆོག་པ་ཁ་སྦྱོར་ཡན་ལག་བདུན་ལྡན་གྱི་བདེ་བའོ་སྙམ་པ་འོང་།",
    "ཁོ་རང་ངོ་ཤེས་ཙམ་དུ་བྱས་ནས་ལྷོད་ཀྱིས་ཀློད་དེ།",
    "ང་རྒྱལ་དང་སེར་སྣ་ལ་སོགས་པ་གང་རང་ཐོག་ཏུ་ཀློད་པས་བདག་གཞན་མཐོ་དམན་གྱི་རྟོག་པ་ཐམས་ཅད་རང་གསལ་དུ་ཤར་བས།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "རྟོག་པའི་གྲལ་རིམ་ཞིག་པས་ཅི་སྣང་གང་ཤར་ཐམས་ཅད་རིག་པ་ཁོ་རང་ཤར།",
    "ཁོ་རང་གྲོལ།",
    "ཁ་དོག་སོགས་ཅི་ལྟར་འདུག་གནས་ས་དང་བརྟེན་ས་གང་ལ་བརྟེན།",
    "ངོས་གཟུང་དང་རྣམ་འགྱུར་ཇི་ལྟར་འདུག་རྣམས་རིམ་པས་བརྟག་ཅིང་དཔྱད་པར་བྱ་སྟེ།",
    "མི་དང་དུད་འགྲོའི་བྱེ་བྲག་ལ་སོགས་པའི་དབྱིབས་སུ་འདུག་གམ་བལྟ།",
    "ངོས་གཟུང་དང་རྣམ་འགྱུར་ལ་སེམས་སྟོང་པར་ངོས་གཟུང་རྒྱུའམ་དེའི་རྣམ་པ་ཅན་དུ་འདུག་གམ།",
    "གསལ་བའི་ངོས་གཟུང་དང་དེའི་རྣམ་པ་ཅན་དུ་འདུག་བརྟག་སྟོང་པར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་དང་བར་སྣང་ལྟ་བུའི་སྟོང་པ་ཇི་ལྟར་འདུག་བརྟག་གསལ་ན་ཉི་ཟླའམ་མར་མེ་ལས་འོད་འཕྲོ་བ་ལྟ་བུར་གསལ་བ་དང་།",
    "འོད་དང་ཁ་དོག་མེད་པའི་རང་གསལ་དུ་འདུག་པ་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟགས་ཤིང་དཔྱད།",
    "ངོས་གཟུང་དང་རྣམ་འགྱུར་ཇི་ལྟར་འདུག་གཟུང་འཛིན་གྱིས་བསྡུས་པའི་ཕྱི་ནང་ཐམས་ཅད་དུ་དཔྱོད་པར་གསུངས་ཤིང་།",
    "མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "ངོས་འཛིན་མཁན་གྱི་རིག་པ་ཁོ་རང་ཡང་རང་སྟོང་དུ་ཤར་བས་ནང་སྟོང་པ་ཉིད།",
    "དེ་གཉིས་ཀྱི་རྣམ་པ་དང་ངོ་བོ་ལ་སོ་སོར་བརྟགས་ནས་མཐར་དེ་གཉིས་ལ་ངོ་བོ་བཟང་ངན་སོགས་ཀྱི་ཁྱད་པར་ཅི་འདུག་ལ་སོགས་པ་བརྟག་པར་བྱའོ།",
    "ཐོག་མར་དེའི་བྱུང་གནས་འགྲོ་གསུམ་གོང་བཞིན་དུ་བརྟག་དེ་ནས་གཟུགས་སྣང་དང་སེམས་ཐ་དད་དུ་འདུག་གམ་གཅིག་ཏུ་འདུག་ཐ་དད་ན་དེ་གཉིས་ཕན་ཚུན་ནམ་ཕྱི་ནང་ངམ་སྟེང་འོག་སོགས་སུ་འདུག་བརྟག་དེ་ལྟར་འདུག་ན་རང་རྐྱ་ཐུབ་པའི་ངོ་བོ་གཉིས་སོ་སོར་གྲུབ་པ་འདུག་གམ།",
    "གནས་འགྱུ་གང་བྱུང་ཡང་དགག་སྒྲུབ་དང་སྤང་བླང་མི་དགོས་པར་ཐག་ཆོད་དེ་སེམས་གནས་ན་གནས་ཐོག་འགྱུ་ན་འགྱུ་ཐོག་དེ་ཀ་རང་སེམས་གསལ་སྟོང་རང་རིག་རང་གསལ་རང་ཤར་རང་གྲོལ་དུ་ངེས་ཤེས་སྐྱེ་དགོས་པ་ཡིན་ནོ།",
    "ཕྲ་རགས་དེ་གཉིས་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་ཡང་ཡང་བལྟ།",
    "དེ་ལ་སྒྲོ་འདོགས་ཆོད་ན་དེ་དག་དང་སེམས་གནས་དུས་ཀྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "རྟོག་པ་དང་སྣང་བའི་འཆར་སྒོ་ཅི་ཤར་ཡང་དེ་དག་བཀག་པ་དང་འགག་མི་དགོས་པར་རྣམ་པ་གསལ་བཞིན་དུ་ངོ་བོ་ངོས་གཟུང་མེད་པ་གསལ་སྟོང་སྣང་སྟོང་རང་རིག་ཉག་གཅིག་བློ་ཐག་ཆོད་པ་ཞིག་དགོས་ཏེ།",
    "དེ་གཉིས་ལ་ཕན་ཚུན་ནམ་ཕྱི་ནང་ལྟ་བུའི་གཉིས་སྣང་འདུག་ན་སྒྲོ་འདོགས་མ་ཆོད་པས་སླར་ཡང་ལེགས་པར་བརྟག་སྟེ།",
    "དེ་བཞིན་དུ་དུས་གསུམ་གྱི་ཤེས་པ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ་སྟེ།",
    "ད་ལྟ་བའི་སེམས་ཇི་ལྟ་བུ་འདུག་བལྟས་པས་དུས་གསུམ་གྱི་སེམས་སྐྱེ་འགག་གནས་གསུམ་ལྟ་བུར་མཐོང་ན་སྐབས་དོན་ལ་འཕྲིག་མ་ཚུད་པས་སླར་ཡང་ལེགས་པར་བརྟག་སྟེ།",
    "རང་བྱུང་རང་གྲོལ།",
    "ཐ་མལ་གྱི་སེམས་གང་འདུག་ཅི་བྱུང་ཅི་ཤར་དེ་ཀ་སྒོམ་གྱི་རང་བཞིན་སྟོང་པའི་རྣམ་འགྱུར།",
    "ཟ་སྣོམ་འཁྱམ་དང་འགྲོ་དང་འདུག་པ་དང་།",
    "རང་བྱུང་རང་ཞི་ཆུ་ཡི་རྦ་རླབས་འདྲ།",
    "གལ་ཏེ་དྲན་ཡེངས་ལ་ཐོབ་ཤོར་གྱི་ཁུ་འཕྲིག་ཆེན་པོ་འདུག་ན་ད་དུང་སེམས་ཀྱི་རང་བཞིན་དང་གནས་ལུགས་རྒྱུན་མི་འཆད་པའི་ཚུལ་མ་རྟོགས་པས་ལ་བཟླ་ཅུང་ཟད་སྔས་པ་ཡིན་ཏེ།",
    "ལམ་གཞན་དང་བརྒྱུད་པ་གཞན་ལས་ཆེས་ཆེར་ཟབ་པ་ཡིན་ནོ། གསུམ་པ་རྗེས་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་གཟུང་ཞིང་རང་ངོ་སྤྲད་པ།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་གཟུང་ཞིང་རང་ངོ་སྤྲད་པ་ནི།",
    "འགྱུ་ཐོག་དེར་གནས་པའི་རང་སོ་ཚུགས་པ་གཅིག་འདུག་ན།",
    "སྒོམ་ཐུན་མཚམས་སུ་གཟུང་རྒྱུ་ཡང་མི་གདའོ།",
    "བཀག་པས་ཁེགས་པར་མི་འདུག་དིང་རི་བ།",
    "རྣམ་རྟོག་ནི་ལྕགས་ཀྱི་སྤར་བུ་དགུ་ཕུགས་སུ་བཅུག་ཀྱང་འདུག་པ་མིན།",
    "ལྷོད་དེ་ཤིག་གེར་བཞག་པས་སྦྲུལ་གྱི་མདུད་པ་བཞིན་དུ་རང་ཤར་རང་གྲོལ་དུ་འགྲོ་བས་རྟོག་པ་ལ་སྐྱོན་དུ་མི་བལྟ་བར་ཁོ་རང་སྟེང་དུ་ཀློད་པ་ཁོ་ན་ཟབ་པའོ།",
    "དེ་ལ་བདེན་འཛིན་སྤངས་ནས་ངོ་ཤེས་ཙམ་དུ་བྱས་ནས་ཀློད་པས་ས་ལམ་ཐམས་ཅད་ཁོ་རང་ལ་ཚང་བས།",
    "སྐུ་དང་མཛད་པ་ཕྲིན་ལས་ཡེ་ཤེས་ཐམས་ཅད་ཁོ་རང་ལ་རང་ཆས་སུ་ཡོད་པ་ཡིན་ཏེ།",
    "གཞན་རྣམ་རྟོག་དང་སྣང་བའི་འཆར་སྒོ་འདིས་སེམས་འདི་མ་རུངས་པར་བྱེད་པར་འདུག་སྙམ་ནས།",
    "ཐོ་ཅོའི་རྩིང་ཧྲལ་ཡང་རྫུན་པོར་གདའ།",
    "ཀ་བློ་གཏད་ཅིག་འདུག་གམ་མི་འདུག་སོམས།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "ཕ་ཁྱེད་རང་ལྟ་བུར་གྱིས་རློབས།",
    "དེའི་ཡུལ་ཅན་གྱི་བློ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་དང་བྲལ་བའི་རྣམ་པ་ཅན་དུ་ཆུ་ལ་ཆུ་བཞག་པ་ལྟར་དུ་ཞུཊ་པ་དེའི་ཚེ་ཡུལ་དེའི་རྣམ་པ་སྟོན་པ་སྟེ་འཛིན་པ་ལ་དེ་ཁོ་ན་ཉིད་རྟོགས་པར་འཇོག་པར་བྱ་སྟེ།",
    "ཤོག་ཟེར་གཅིག་འདུག་གོ།",
    "རི་གཟར་གྱིས་རྦབ་དང་འདྲ་སྟེ་ཟིན་པ་དཀའ་བའི་ཀ་འདྲ་འདུག་ལྟོས་ཤིག་གསུང་།",
    "དེ་རུ་རྨི་ལམ་དང་ཉམས་སྣང་མ་ཡིན་པར་ཤུག་པ་སྡོང་པོ་ཐོ་བརྩེགས་ཡལ་ག་དང་ལོ་འདབ་འབྲས་བུ་སྨིན་པའི་ཤིན་ཏུ་སྐྱེས་ཤིང་གཅིག་འདུག་པའི།",
    "སྤྲང་རང་འདྲའི་བཙུན་གཟུགས་འཁྱམས་པོ་རྣམས།",
    "སེང་ཆེན་རི་ཁྲོད་འདུག་པའི་ཉམས་ལེན་སྦྱངས་སྐབས།",
    "དུས་ད་ལྟའི་ཐོག་ལ་འོང་བར་འདུག།",
    "གཞའ་འོད་གུར་ཕུབ་ལྟ་བུ་ཕྱི་ནང་གསང་གསུམ་འདུག་དཀྱིལ་དུ་སྐྱབས་མགོན་དེ་ཉིད་ཞལ་ལྷང་ངེ་མཐོང་།",
    "སྐྱབས་མགོན་དེ་ཉིད་ཤོག་གསུངས་པའི་མི་གཅིག་བཏང་འདུག་སྐུ་མདུན་ཞལ་མཇལ་སྣང་ལ།",
    "གཡུང་དྲུང་གླིང་འགྲོ་དགོས་ཟེར་བྱུང་དེ་གཉིད་སད་འདུག་པའི།",
    "ནམ་ཡང་ལང་འདུག་དེ་འདྲ་འཁྲུལ་སྣང་གང་ཡིན་བསམ།",
    "འདུག་པ་ཕོ་ཡི་བརླ་སྟེང་དུ།་།",
    "དེ་ལྟར་བསྒྲེངས་འདོད་ཀྱི་ས་མ་ཀུན་སློང་ཡང་བདག་ལ་མི་འདུག་སྟེ།",
    "དེ་ལྟར་སྙེག་དགོས་དོན་ཡང་མི་འདུག་བསམ་པ་དེ་ཡིན།",
    "རྡོ་ཡི་མཆོད་ཀོང་རང་བྱོན།",
    "ད་འདུག་ཡང་འདུག་ཟེར་བ་ཡང་སྣང་།",
    "ལྷ་ལུང་དཔལ་རྡོར་དང་བོད་ཀྱི་མཁས་པ་མི་གསུམ་གྱི་༦བཞུགས་གནས་སུ་ད་ལྟ་ཡང་མཇལ་བ་དང་བལྟ་སྐོར་བ་རྒྱུན་མི་ཆད་པར་འགྲོ་འོང་བྱེད་ཀྱིན་འདུག་ཙལས་དུ་ཙཱ",
    "ཞབས་དཀར་ཚོགས་དྲུག་རང་གྲོལ་དང་ཤར་སྐལ་ལྡན་རྒྱ་མཚོའི་སྒྲུབ་ཕུགཏཾ་ཨོ་རྒྱན་པདྨའི་སྒྲུབ་ཕུག་དཀ་ས་བཨོ་རྒྱན་རྡོ་རྗེའི་ཕུག་ལམ་དང་རང་འབྱོན་མང་ངོ།",
    "ལོ་པཎ་རྣམས་ཀྱི་ཞབས་རྗེས་དང་རང་བྱོན་མང་།",
    "བ་ནལ་ཉིན་ཕ་དམ་པ་དང་ལོ་ཙཱ་བ་བེ་རོ་ས་ཆཙ་ན།",
