    "པ་སངས་ལྟ་བུར་དཀར་བའི་གཡང་མོ་ལུག།",
    "ཟ་མཁན་སྟག་གི་མཆེ་བས་རང་ཤ་ཟ།",
    "ཞྭ་དཀར་ཝ་མོས་གཡོ་སྒྱུའི་ཟློས་གར་འཁྲབ།",
    "བ་མོའི་རྐང་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "ཏ་ཟིག་ཡུལ་དུ་གངས་ཅན་མེ་ཏོག་འཛུམ།",
    "ཉ་མོ་ཉ་རྒྱུའི་དྲ་ལས་མི་ཐར་ཀྱང་།",
    "ཇ་ཆང་གསེར་སྐྱེམས་གཏོར་མ་ཁོ་ནར་རེ།",
    "ཨོལ་མདུད་ཅན་གྱི་མགྲིན་པར་རེ་བ་མེད།",
    "ཧ་ཅང་ཀུ་རེ་རྩེད་འཇོའི་དགོད་གཏམ་འདི།",
    "ཟླ་བྲལ་ཚིག་གི་རྒྱན་དུ་མ་སོང་ཡང་།",
    "ཟླ་ཟེར་རྩོམ་སྒྲིག་ཁང་གི་འདོད་མོས་བཞིན།",
    "སྨྲ་བ་ངག་གི་བདུད་རྩི་གསར་བའི་བཅུད།",
    "སྙན་འཕྲིན་དབྱངས་ཀྱི་རྒྱལ་མོ་དགྱེས་པའི་གླུ།",
    "གངས་རིའི་རྩེ་ལ་བཀོད་པའི་རི་མོའི་གཟུགས།",
    "འཛམ་བུ་ཁྱོན་ཀུན་མཛེས་པའི་རྒྱན་དུ་བརྗིད།",
    "མོ་ཡིག་གཅིག་པོ་སྐུ་གསུང་ཐུགས་གསུམ་གྱི་མཚོན་དོན་དུ་འགྲོ་བ་དང་།",
    "ལྷ་རང་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་སྔགས་ཀྱི་ས་བོན་དང་།",
    "གཟུངས་སྔགས་ལ་ལ་ཚིག་བསྒྱུར་ལྟ་བུའི་ཡི་གེ་རེ་རེ་ནས་ཐད་བསྒྱུར་དུ་མི་འགྲོ་བས།",
    "མཚོན་བྱེད་ལྟ་བུར་སོང་བ་མང་བའི་རྐྱེན།",
    "ཏྲིག་ཐུམ་གྱི་ཡི་གེ་ནི་སྔགས་ཡིག་མིན་དེ་ནི་གཏེར་ཡིག་ཡིན་ཆོམ་རྐུན་ཐམས་ཅད་ཀྱི་ལུས་ཆིངས་ཤིག་སྟེ་རེངས་པར་གྱིས་ཤིག་ཅེས་སོ།",
    "བྷནྡྷ་ནི་འཆིང་བའི་སྐད་དུ་སོང་བས་གཅན་གཟན་ཁྲོ་བོའི་ཞེས་པའི་ཚིག་མེད།",
    "འདི་གཉིས་དོན་གྱིས་ཐོབ་ན་མ་གཏོགས་ཚིག་གི་སྐད་དོད་མེད།",
    "བི་ཥ་དུག་གི་མིང་།",
    "དུག་གིས་གཡོ་བའམ་སྲོག་འཕྲོག་པ་ཐམས་ཅད་ལས་སྲུངས་ཤིག་ཅེས་པ་སྟེ་སྭཱ་ཧཱ་ནི་གཞི།",
    "ཀུ་རུ་མཛོད་ཅིག་འཕགས་མ་སྒྲོལ་མས་བཀྲ་ཤིས་དངོས་གྲུབ་ཐམས་ཅད་སྩོལ་ཅིག་འདི་དག་གི་ཡི་གེ་ནི་ཚིག་བསྒྱུར་དུ་མི་འོང་བས་དོན་གྱིས་ཐོབ་པ་ཡིན།",
    "ངེད་ལ་དཔེ་ཀློག་གི་གོ་སྐབས་ཞིབ་མོ་མ་བྱུང་བས་ཡིད་ཚོད་ཀྱིས་རགས་ཙམ་བྲིས་པས།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ཞིང་འགྲེམ་སྤེལ་བྱས།",
    "སྦྲག་སྲིད་ཁར་སྲིད་མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་སྐུལ་འོད་པར་སྒྲིག་ཁང་ནས་པར་བསྒྲིགས།",
    "ཁྱབ་བདག་པ་པདྨ་སྐལ་བཟང་གིས་གསུངས།",
    "ཁྱབ་བདག་པ་༧པདྨ་སྐལ་བཟང་གིས་གསུངས།",
    "ལྕགས་ཕོ་སྟག་གི་ལོའི་རྩི་ཤིང་མེ་ཏོག་གི་འཛུམ་ཞལ་གསར་དུ་ངོམ་ཞིང་སྙན་འགྱུར་དཔྱིད་ཀྱི་རྒྱལ་མོས་གླུ་སྒྲ་སྒྲོག་བཞིན་པའི་དུསབཟང་གི་སྐབས་ཤིག་ཏུ།",
    "གང་དག་ཕྱོགས་བཅུ་སྟོང་གི་འཇིག་རྟེན་ན།",
    "བདག་གིས་སྦྱིན་གྱིས་དད་ཅིང་གུས་པས་ཉོན།",
    "བོད་རབ་བྱུང་བཅུ་བདུན་པའི་ས་མོ་གླང་གི་ལོ་ཕར་འདས་ནས་ལྕགས་ཕོ་སྟག་གི་ལོ་ཚུར་ཚེས་པས་མ་ཚད་དཔྱིད་ཀྱི་རྗེས་དབྱར་ཐོན་པ་ཡིན་ཞིང་།",
    "སྤྱིར་བཏང་གི་མི་ཚེའི་དུས་ཚོད་དེ་སྐད་ཅིག་མ་གཅིག་བས་རིང་བ་ཡིན་ཡང་འདི་ཕྱིར་རང་གཞན་གཉིས་ཕན་གྱི་དགེ་ཕྱོགས་སྒྲུབ་ལོང་གི་ལས་ལོང་བཅའ་ལོང་བསམ་ལོང་དྲན་ལོང་ཞིག་མ་གཏད་པའི་ཐད་ནས་སྐད་ཅིག་སྐར་མའི་དུས་ཚོད་དང་མི་ལུས་ཙམ་པོ་བ་ཞིག་གི་མི་ཚེའི་དུས་ཚོད་གཉིས་འདྲ་སོང་བ་ཡིན་ནོ།",
    "ཡུན་རིང་གི་འདང་རྒྱག་མ་བྱས་ན་སྐྱེ་བ་འདི་ལ་ད་ཡང་བསྐྱར་དུ་སྐྱེ་མི་དགོས་པས་དེ་ཕར་ཞོག་རྒས་པ་ཟེར་རྒྱུའི་ཤི་ན་དགའ་འོ་སྙམ་པའི་སྡུག་བསྔལ།",
    "ཤི་ནས་ངན་སོང་གསུམ་དུ་སྐྱེས་སོང་ན་ཇི་ལྟར་བྱེད།",
    "ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་དེ་ཚོའི་ནང་གི་སྣེ་གཅིག་ཆུ་ཚོད་སྐར་མ་ཁ་ཤས་ལ་མྱོང་དགོས་ན་བཟོད་ཐབས་མེད་མོད་ཀྱང་བཟོད་ཐབས་མི་འདུག་ཟེར་ས་མེད་ཅིང་།",
    "ངན་སོང་ལ་ཨེ་འགྲོ་མི་འགྲོ་མེད་པར་འགྲོ་ངེས་ཅན་ཞིག་ཡིན་ཏེ།",
    "ང་ལ་གདམས་ངག་ཁྱད་པར་ཅན་གྱི་མན་ངག་གི་ཞལ་ཤེས་ཡོད་པ་མ་ཡིན་ལ།",
    "གཞན་ལ་གཅེས་ཟེར་ན་དཀའ་མོ་ཞིག་རེད་མ་གཏོགས་རང་ལ་གཅེས་ལོས་ཤེས།",
    "རང་དོན་བསྒྲུབས་ནས་ཤི་བ་ལ་མ་ཐུག་གི་བར་དུ་རྒྱུག་བཞིན་པ་འདི་རང་དོན་སྒྲུབ་པ་ཡིན་ཞིང་།",
    "རྨི་ལམ་འཚུབ་མོ་ཞིག་མདང་རྨིས་ཡོང་ན་དེ་རིང་ཟློག་པ་རྒྱག་བཞིན་ཡོད་སྙམ་ན།",
    "རང་དོན་འབྲིང་ཞིག་ཨེ་འགྲུབ་བསམ་ན་ཕྱི་མར་ངན་སོང་ལ་མི་ལྷང་བར་བདེ་འགྲོ་ལྷ་མིའི་གོ་འཕང་འཐོབ་ཐབསབྱེད་དགོས་ལ།",
    "དེ་བཞིན་དུ་བཅས་དང་རང་བཞིན་གྱི་ཉེས་པ་སྣ་རེས་མི་འདོད་པ་སྣ་རེ་བསྐྱེད་ནས་དེ་ལྟ་བུའི་སྒོ་ནས་ཐ་མར་སྡུག་བསྔལ་གྱི་ནང་དུ་ཚུད་པ་ཡིན་ནོ།",
    "དམ་ཚིག་སྡོམ་པ་འགལ་ཉམས་སོང་བ་བས་མདང་དགོང་རྨི་ལམ་འཁྲུགས་པ་དང་ད་ནངས་ཟོམ་སྟོང་གཏུགས་པ་རྩ་ཆེན་རྩི་མཁན་དུ་གྱུར་སོང་བ་དང་།",
    "དེ་ལྟར་ཡིན་ཕྱིར་དགེ་སློང་ཚུལ་ལྡན་ཞིག་བས་ཀྱང་སྐྱ་སེར་གཉིས་གོ་ཆོད་མཁན་ཞིག་གིས་དགའ་རྒྱུ་དང་།",
    "བློ་ལྡོག་རྣམ་བཞིས་རང་གི་བློ་སྦྱངས་ན།",
    "འབད་པ་བརྒྱ་ཕྲག་གིས་དོན་གཉེར་བྱེད་རྒྱུ་དེ་ཐར་ལམ་གྱི་སྣེ་མོ་ཞིག་ཨེ་ཟིན་བསམ་པའི་དམིགས་འདུན་གྱི་གཙོ་བོ་ཡིན་ནོ།",
    "ཚེ་འདི་ལ་མངོན་ཞེན་ཆེ་རྒྱུ་ཤུགས་དྲག་ན་མི་རྟག་པ་དང་ངན་སོང་ངན་འགྲོའི་ཉེས་དམིགས་བསྒོམ་རྒྱུ་གཙོ་བོར་བྱེད་དགོས།",
    "རང་འདོད་ཡིད་བྱེད་ཀྱི་སྒྲོག་གིས་བཅིངས་འདུག་བསམ་ན་སྨོན་སེམས་རྒྱུ་དང་བཅས་པ་ལ་བསླབ་པ་དེ་ལྟར་བྱེད་དགོས་སོ།",
    "སྲིན་མོའི་གླིང་།",
    "ཡང་མཚམས་རེར་རང་ཉིད་ཀྱི་བུ་རྒྱུད་བྱས་པ།",
    "མཚམས་རེར་གཉེན་དང་གྲོགས་པོ།",
    "རང་ཉིད་ཀྱི་དོན་དུ་འདི་དག་གིས་ལུས་སྲོག་ལོངས་སྤྱོད་དང་བཅས་པ་བཏང་བའི་གྲངས་ཀ་ཡང་རྩི་ཚོད་ཅི་ཡོད་དེ་མེད་དོ།",
    "གོས་སྣེ་གསུམ་གྱི་སྟོན་པའི་ན་བཟའ་དེ་རང་གི་ལུས་ལ་གོན་ན་དེའི་རྟགས་ཆ་ལུགས་འཆང་བའི་མི་དེས་དེའི་བྱ་བ་དེ་འགྲུབ་དགོས་སོ།",
    "ལས་ཀ་དེ་རྣམས་ཀྱི་ནང་ནས་བུད་བཏང་བས་ན་རབ་བྱུང་ཞེས་བརྗོད་པ་དང་།",
    "ཐུབ་པའི་གསུང་གི་ཆོ་འཕྲུལ་དེ་སྒྲ་གཅིག་དོན་མང་ལ་འཇུག་པ།",
    "གདུལ་བྱ་འགའ་རེ་ལ་སྒྲ་ཚིག་དང་ཡི་གེས་སྟོན་པ།",
    "དང་སྐྱེས་བུ་ཆུང་ངུ་དང་ཐུན་མོང་བའི་ལམ་ཡིན་ཞིང་།",
    "དེ་ལས་ཀྱང་རང་རེ་ཐེག་ཆེན་གྱི་གདུལབྱར་གྱུར་པའི་གང་ཟག་ལ་སྐྱེས་བུ་ཆེན་པོའི་ལམ་དེ་ཡང་རྒྱུ་དང་འབྲས་བུའི་ཐེག་ཆེན་རྣམ་པ་གཉིས།",
    "རང་རེའི་དུས་རྒྱུན་གྱི་ཁ་སྐད་ལྟར་དུ་བྱས་ན་ལས་བྱང་ཆུང་བ་འདི་ཉིད་འཆད་ཉན་བགྱི་བའི་སྐབས་ཡིན་ནོ།",
    "ཐབས་ལམ་བདེ་ཆེན་གྱི་ཁྲིད་ལ་སོགས་པ་འགའ་རེ་ལུང་ཨ་ནུ་ཡོ་གའི་ཉམས་ལེན་དང་གཙོ་བོར་མཐུན་ཤས་ཆེ་བ་ཡིན་ཞིང་།",
    "དེའི་སྟེང་དུ་སྒྱུ་འཕྲུལ་རྒྱ་མཚོ་དང་ཐལ་བ་གཉིས།",
    "རྒྱ་མཚོ་དང་ཐལ་བ་གཉིས་ཀ་གང་ཡིན་ཟེར་ན།",
    "ཐལ་བ་ནི་ཐབས་ལམ་གཙོ་བོར་བསྟན་པ་སྟེ་དེ་དག་ཐམས་ཅད་ཡིན་ནོ།",
    "ཆུང་ཐོབ་ཆུང་གིས་འཚེངས་ཡོད་ཀྱང་།",
    "ཐོས་པ་ཙམ་གྱིས་ངན་སོང་གི་སྐྱེ་སྒོ་གཅོད་པ།",
    "ཁྱབ་གདལ་དུ་སྤེལ་ཉེས་སོང་ན་གདུལ་བྱ་བློ་ཆུང་སྐལ་དམན་ལོག་ལྟ་ཅན་གྱིས་བློ་ལ་མི་ཤོང་ནས་སྐུར་འདེབས་བྱས་ན་ངན་སོང་དུ་འཕེན་པས་དེ་ལྟ་བུའི་གང་ཟག་ལ་རླང་ཕྱོགས་སུའང་སྒྲོག་མི་ཉནཞིང་།",
    "གུ་རུའི་གཏེར་ལུང་གི་ཁ་བྱང་གི་ནང་དུ།",
    "ལས་བྱང་གི་འཆད་ཁྲིད་ཀྱི་རྒྱུན་ཟེར་རྒྱུ་ཞིག་ཁ་ཁར་ཐོབ་མ་མྱོང་ལ།",
    "སྔོན་ཆད་འདི་འདྲས་ཁྲིད་རྒྱུའི་ཕྱག་སྲོལ་ཡོད་མེད་མི་ཤེས་མོད།",
    "དེས་ན་ལས་བྱང་གི་ཐོག་ནས་བསྐྱེད་རྫོགས་ཀྱི་ལམ་ལ་མོས་པ་ཅན་དང་།",
    "ད་རེས་བསྙེན་སྒྲུབ་ཀྱི་དགོས་མཁོ།",
    "ཁྱད་པར་དུ་སྔགས་ལ་མོས་པའི་གང་ཟག་ལས་དང་པོ་པ་དང་།",
    "གསོན་པོ་གཟེར་རིལ་ལེར་ཡོད་པའི་དབུགས་ཕར་འཕེན་ཚུར་འཕེན་ལ་འཆི་ཁའི་འཇིགས་སྐྲག་གིས་མནར་བཞིན་ཡོད་པ་རྣམས་ལ་མགོ་མི་གཡོག་པའི་ཆེད་དང་།",
    "ལས་བྱང་ཆེ་ཆུང་གཉིས་ཀ་ཚིག་གི་རྒྱས་བསྡུས་ཙམ་མ་གཏོགས་བསྐྱེད་རྫོགས་ཀྱི་དོན་གྱི་འགྲོས་གཅིག་ཡིན་ནོ། ཀ་",
    "གསུང་མི་ཟད་སྒྲ་ཚིག་གི་རྣམ་པས་ཉན་དུ་མི་བཏུབ་པའི་བརྗོད་མེད་བརྗོད་བྲལ་སྐྱེ་བ་མེད་པའི་གསུང་།",
    "ལམ་བསྐྱེད་རྫོགས་གཉིས་སུ་མེད་པ་སྤང་བླང་རེ་དོགས་ལས་འདའ་བར་བྱེད་པ།",
    "འགྲོ་བ་གང་གིས་འདིའི་སྒྲ་ཙམ་ཞིག་རྣ་བས་འདུས་ཏེ་རེག་པའི་ཚོར་བ་ཙམ་གྱིས་ཀྱང་ཨོ་རྒྱན་ཆེན་པོས།",
    "ས་ཆ་འགའ་རེས་འདིའི་གླེགས་བམ་ལ་ཞི་ཁྲོ་ཞེས་དཀྱིལ་འཁོར་གྱི་ལྷའི་ཆ་ནས་མཚན་བཏགས་ལ།",
    "འདི་ན་ཡོད་པའི་ལྷ་ཁང་གང་པོ་ལ་མི་རེ་ལ་མིང་རེ་མེད་ན་བོས་ནས་གོ་བརྡ་འཕྲོད་ཐབས་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "ང་དང་ཁྱོད་ཅེས་པ་ཙམ་ཞིག་མེད་ན་བླང་དོར་གྱི་གནས་བསྟན་མི་ནུས་པར་མ་ཟད་བྱ་བ་ཐམས་ཅད་ལོང་བསྙབས་སུ་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་ཡང་ཡེ་ཤེས་ཀྱིས་བསྐུལ་བའི་གཙོ་བོ་གཅིག་གི་ཆོ་འཕྲུལ་ཡིན་པས་རང་ལས་ཤར་བའི་ལྷ་ཚོགས་དཀྱིལ་འཁོར་གཅིག་ཏུ་འདུས་པས་ན་ཞི་ཁྲོ་འདུས་པ་སྟེ།",
    "རང་གི་རང་རིག་ཡེ་ཤེས་ནི།",
    "ཕྱི་རབས་མོས་པའི་བུ་ལ་ཆེད་དུ་བསྩལ་བའི་བཀའ་རྟགས་མི་ཉམས་པའི་བརྡ་རུ་བདག་འདྲ་གསུངས་ཏེ་སྐུ་དངོས་ཀྱི་བདག་རྐྱེན་ལས་བྱུང་བའི་ཁྱད་པར་མཚོན་པའི་ཆེད་དུ་མཚན་ཁོལ་འདོན་མཛད་དེ་པདྨ་འབྱུང་གནས་ཞེས་གསུང་རྒྱུ་འདིས་སྟོན་པ་ཕུན་སུམ་ཚོགས་པ་བསྟན་ལ།",
    "བློ་དམན་ཡིན་ན་འཁོར་ཕུན་སུམ་ཚོགས་པའི་མཚན་ཉིད་ཇི་ལྟར་ཚང་སྙམ་པའི་དོགས་པ་སྐྱེ་སྲིད་མོད།",
    "དེ་མ་ཐག་ཏུ་བློ་དམན་ཞེས་འབྱུང་རྒྱུ་འདི་ཉན་རང་གི་གདུལ་བྱའི་རིགས་ཅན་ལྟ་བུའི་བློ་ཆུང་ངམ་སྔགས་ཀྱི་གདུལ་བྱར་མ་གྱུར་བའི་བློ་དམན་ལ་གསུངས་པ་མ་ཡིན་ལ།",
    "ཉིངདགོས་བརྗོད་བྱ་གཉིས་ཀ་ངོ་བོ་བདག་གཅིག་གི་འབྲེལ་བར་དེ་ལྟར་དུ་གྲུབ་པ་ཡིན་ནོ།",
    "འདིའི་ཚིག་རྐང་གསུམ་གྱིས་རྒྱུད་འབྱུང་གི་གླེང་གཞི་ཡང་དེ་ལྟར་དུ་གོ་ཐུབ་བོ།",
    "སྔོན་འགྲོ་དངོས་གཞི་རྗེས་གསུམ་མོ",
    "དེའི་ནང་གི་སྔོན་འགྲོའི་ཆིངས་བསྟན་པ་ནི།",
    "དེ་སྔགས་ནང་པ་ཡོ་ག་རྣམ་གསུམ་ཐུན་མོང་གི་བཞེད་པ་ཡིན་ཞིང་།",
    "ང་ཉིད་ལྷ་མ་ཡིན་པ་ཞིག་ལྷའི་ང་རྒྱར་བཟུང་བས་དེས་འབྲས་བུ་འབྱིན་མི་ནུས་མོད།",
    "ལུང་གིས་ཇི་ལྟར་གསུངས་ཡོད་ཅེ་ན།",
    "ཀུན་རྫོབ་སྒྱུ་མ་ལྟ་བུར་སྣང་བའི་སྐབས་སུ་སྣང་ཚུལ་ཕྱོགས་རེ་བལ་ངེས་པ་མེད་ལ།",
    "དེ་ལྟར་ལུང་རིགས་པ་གཉིས་ཀས་བསྒྲུབས་ན་མན་ངག་གི་ཐད་ནས་ལུང་དོན་རིགས་པས་དཔྱད།",
    "དེ་ཉིད་མངོན་སུམ་དུ་གཟིགས་པའི་མཁྱེན་གཉིས་ཡེ་ཤེས་མངོན་དུ་གྱུར་པ་རྣམས་ལ་གསུངས་པ་ཡིན་ནོ།",
    "ཀུན་རྫོབ་རང་གི་གནས་ཚུལ་ཞིག་ཡོད་རྒྱུ་དེ་ཉིད་ངེས་རྒྱུ་གལ་ཆེའོ།",
    "དྲུག་གི་སྣང་བ་འདྲ་དང་མི་འདྲ་ཤར་བའི་མ་དག་པའི་སྐབས་དང་།",
    "སྒྲིབ་པ་ཐམས་ཅད་ཟད་ནས་འབྲས་བུ་ཤིན་ཏུ་དག་པའི་སྐབས་གཉིས་ཀ་སེམས་རང་གི་སྣང་ཚུལ་ཙམ་ལས་གཞན་དུ་མེད་ཀྱང་དེ་ཐམས་ཅད་ཀྱི་གཞིར་གྱུར་པའི་སེམས་དེ་བདག་གཉིས་ཀྱིས་སྟོང་ཞིང་འོད་གསལ་བ་སྣ་ཚོགས་སྣང་བའི་འཆར་སྒོ་མ་འགགས་ནས་སྣང་བ་ཞིག་ཡིན་ལ།",
    "སེམས་རང་གི་གནས་ཚུལ་ངོ་མ་དང་མཐུན་པར་ལམ་སྦྱངས་ནས་རང་སྣང་འཁྲུལ་བའི་ཆ་ཐམས་ཅད་ལོག་སོང་དུས་དག་པའི་སྣང་བ་སྐྱོན་མེད་ཉིད་སྣང་བ་ཡིན་ནོ།",
    "དོན་བྱེད་ནུས་མི་ནུས་ཀྱི་ཐད་ནས་བསམ་བློ་བཏང་ན་ལས་དག་པ་ཞིག་ལ་ནི་གང་གིས་ཡིན་ན་ཡང་དོན་བྱེད་ནུས་པ་ཡིན་ཞིང་།",
    "གང་དུ་འཕྲོ་ན་ཕྱོགས་བཅུར་འཕྲོས་ནས་ལོག་རྟོག་མ་རིག་པ་ཉོན་མོངས་རྒྱ་འབྲས་དང་བཅས་པའི་བགེགས་མིང་མེད་དུ་བསྐྲད་པ།",
    "ལྟ་བ་རྣམ་དག་གི་རྩ་བ་ཞིག་ཟིན་པ་ལ་ཕན་ཐོགས་ཡོད་རྒྱུ་རེད་སྙམ་པ་ཡིན་ཞིང་།",
    "ཉོན་མོངས་མ་རིག་རྒྱུ་ལས་བྱུང་",
    "ལུས་སེམས་གཉིས་ཀ་དང་འབྲེལ་བའི་ངག་གི་བཟླས་བརྗོད་ལ་སོགས་པ་སྨྲ་བ་ངག་གི་སྒོ་ལ་ཡང་བར་ཆད་བྱེད་རྒྱུ་དེ་ལྟ་བུ་དང་།",
    "འཁྲུལ་སྣང་གཟུང་འཛིན་ཅན་དུ་ཤར་ནས་ཕན་གནོད་ལྷ་འདྲེའི་ཀུན་རྟོག་དེ་གཞི་མེད་དུ་ཤར་བ་ཉིད་ནི་ཉོན་མོངས་མ་རིག་རྒྱུ་ལས་བྱང་ཞེས་གསུངས་ཤིང་།",
    "དེས་ན་འདིའི་གཞན་ཇི་ལྟ་བུ་ཞིག་ལ་གོ་ན་ཁྱོད་ངེད་ཚང་ལ་མ་འདུག་ཕར་ཀ་ཚང་ལ་བུད་སོང་ལྟ་བུའི་གཞན་དེ་མ་ཡིན་ཞིང་།",
    "རྨོངས་རེངས་དབྱེ་དང་བསྐྲད་པ།",
    "རིམ་པ་དྲུག་གི་ཚུལ་དུ་བསྐོར",
    "སྲུང་བའི་ར་གུར་རིམ་པ་དྲུག་གིས་ཕྱི་ནང་དུ་བསྐོར་ནས་སྤྲུལ་བའི་ཁྲོ་ཆུང་གི་ཚོགས་དཔག་ཏུ་མེད་པ་དང་།",
    "འབར་བའི་མཚོན་ཆ་སྣ་ཚོགས་ཀྱིས་རབ་ཏུ་གང་ནས་བར་ཆད་གང་གིས་ཀྱང་ཚུགས་པའི་སྐབས་དང་གནས་མེད་པའི་མཚམས་བཅད་དོ་ཞེས་གསུངས་པའོ།",
    "གཅིག་ན་འདི་ལྟ་བུའི་དམིགས་པའི་རིགས་ལ་ཨ་འཐས་མཚན་མ་ཅན་དུ་བཟུང་སྟེ་གཅིག་སྒོམ་བཞིན་པའི་སྐབས་སུ་ཡང་དེ་བསྐར་ནསགཞན་པ་ཞིག་བསྒོམ་དགོས་རྒྱུ་རེད་དྲན་པའི་མི་བདེ་བར་བསམ་པའི་གུ་དོགས་མི་དགོས་ཤིང་།",
    "རྡོ་རྗེ་རིན་ཆེན་པདྨ་དང་ཞེས་པ་ལ་སོགས་པ་ནི་རྡོ་རྗེའི་གུར་ཁང་གི་ཕྱི་རོལ་ན་རིན་ཆེན་འབར་བའི་གུར་ཁང་།",
    "ཡེ་གྲོལ་ཆེན་པོའི་ཀློང་ན་སྣང་གྲག་ཐམས་ཅད་རྒྱས་འདེབས་པའི་ལྟ་བའི་གདེང་གིས་ཟིན་པ་དེ་ཡིན་ཞིང་།",
    "ཨ་ལས་བྱུང་བའི་དབྱིངས་ཀྱི་དྲིལ་བུ་གྲག་པ་གསུང་གི་དམ་ཚིག་དང་དམ་ཚིག་གསུམ་དྲན་པའི་ངང་ནས་ལག་པ་གཡས་པས་རྡོ་རྗེ་གསོར་ཞིང་གཡོན་པས་དྲིལ་བུ་དཀྲོལ་ཡོང་དུས་འགྲོ་ཀུན་མ་རིག་པའི་གཉིད་ལས་སད་པར་བསམ་དགོས་སོ།",
    "དེ་ཡང་ཐབས་དང་ཤེས་རབ་མཆོག་གིས་ཡོངས་ཟིན་ན།",
    "རྩེ་མོ་གཅིག་པ་ནས་རྩེ་མོ་སྟོང་གི་བར་ཡོད་ཚུལ་ཡང་གསུངས་ཡོད་དོ།",
    "གང་ལྟར་ཡང་ཡོངས་ཁྱབ་ལ་རྩེ་ལྔ་རྩེ་དགུ་གཉིས་ཀ་གྲགས་ཆེ་བས་རྩེ་ལྔ་བ་དེ་ཉིད་ལ་དམ་ཚིག་གི་རྡོ་རྗེ་ཟེར་ལ།",
    "དེ་བཞིན་དུ་དྲིལ་བུའི་རྩེ་རྡོར་ལ་ཡང་རྭ་མང་ཉུང་གིས་དམ་ཚིག་གི་དྲིལ་བུ་དང་།",
    "ཆངས་པ་ནི་ལག་པའི་སྤར་མོ་ཡིན་པས་ལག་པའི་སྤར་མོས་གཟུང་ས་ལ་ཆངས་གཟུང་ཞེས་ཟེར་རོ།",
    "སྣེ་གཉིས་ཀྱི་རྭ་རེའི་རིང་ཐུང་གི་ཆ་རེ་རེ་ལ་ཆ་གཉིས་ཏེ་ཆ་གསུམ།",
    "འོག་གི་རྭ་ལྔ་དེ་དབྱིངས་ཕྱུག་ཡུམ་ལྔ།",
    "སྟེང་གི་པད་འདབ་བརྒྱད་དེ་སེམས་དཔའ་ཡབ་བརྒྱད།",
    "འོག་གི་པད་འདབ་བརྒྱད་དེ་སེམས་མ་ཡུམ་བརྒྱད་སོགས་ཀྱི་རང་བཞིན་ཡིན་པར་དག་དྲན་བྱ་དགོས་སོ།",
    "འཁར་བ་ནི་ང་ཚོའི་ཁ་སྐད་ལ་འཁར་ར་ཞེས་པ་དེ་ཡིན་པ་དང་།",
    "སྟེང་གི་ཆ་གཉིས་པོའི་ཞབས་མ་ཤེས་རབ་ཞལ་བུམ་གདན་དང་བཅས་པ་དང་།"
  ]
}