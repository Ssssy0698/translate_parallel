    "ཕྱོགས་གཅིག་ན་སྐྱེད་མོས་ཚལ་གྱི་དབུས་ན།",
    "སྟོན་པའི་སྐུ་མདུན་དུ་ལྷ་མོ་རྒྱན་གྱིས་བརྒྱན་པ་ཞིག་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་དགྲ་བཅོམ་པ་ཞིག་གི་ཞུ་བ་འབུལ་བའི་ཚུལ་བྱ།",
    "དེ་ནས་ཡང་སྟེང་གི་ནམ་མཁའ་ལ་ལྷ་གནས་གཞན་རྣམས་འབྲི་སྟེ།",
    "ཡང་དེ་དག་གི་སྟེང་གི་ནམ་མཁའ་ལ།",
    "བུད་མེད་དེས་ཁས་ལེན་སྤོང་པའི་ཚུལ།",
    "གཞོན་ནུ་གཅིག་སྐེད་པ་ནས་སྣོད་གཅིག་གི་ནང་ནས་གསེར་དངུལ་མང་པོ་གཞན་ལ་གཏོང་བའི་ཚུལ་དང་།",
    "བུད་མེད་གཞོན་ནུ་ཞིག་གིས་སྣོད་གཅིག་ཏུ་དྲི་བཟང་ལྡུགས་པར་བྱེད་ཅིང་།",
    "ཁྱིམ་བདག་གཅིག་གི་ཁྱིམ་དུ་གཅེར་བུ་པ་མང་པོ་ལ་ཁ་ཟས་གཡོས་པའི་འགྲམ་ནས་མི་གཅིག་གི་བཞད་གད་བྱེད་པའི་རྣམ་པ་དང་།",
    "ཡང་ཁང་པ་གཅིག་གི་ནང་ན་མི་མང་པོ་ཟས་སྣ་ཚོགས་སྦྱོར་ཞིང་།",
    "ལྷ་འགའ་ཞིག་གིས་ལྡོག་པའི་ཚུལ་དང་།",
    "ལྷ་ཞིག་གིས་ལྡོག་པའི་ཚུལ་དང་།",
    "ཁང་བཟང་གི་རྩེ་ནས།",
    "ཁྱིམ་བདག་ཕོ་མོ་གཉིས་གཡོག་དང་བཅས་པས།",
    "བླུགས་པའི་ཚེ་ཁ་དོག་དཀར་པོར་སོང་བ་འབྲི།",
    "མེ་ཏོག་གི་ཆར་འབབ་པ་སོགས་འབྲི་སྟེ།",
    "དེ་ནས་མི་མ་ཡིན་གྱི་ཁང་པ་ཤ་ཁྲག་རུས་པ་ཐོད་པ་ཐོ་རེ་བ་གཅིག་གི་སྒོ་རྩར།",
    "གངས་ཅན་སོགས་ལ་པུས་མོ་བཙུགས་ཏེ་འགྲོ་བ་དང་།",
    "དེའི་བང་རིམ་དང་རྩེ་མོ་རྣམས་སུ་དེ་རྒྱུགས་པ་དང་།",
    "རི་རབ་གྱི་རྩེ་མོའི་ཕྱོགས་གཅིག་ན་ལྷ་དང་གནོད་སྦྱིན་ཁྲོ་བོ་འགའ་ཞིག་གི་དེ་བཟུང་ཞིང་ཕྱིར་སློག་པ་དང་།",
    "རྣམ་ཐོས་སྲས་བཞུགས་པའི་དྲུང་དུ་གནོད་སྦྱིན་མོ་དེ་ཞུ་བ་བྱེད་པ་དང་།",
    "སྐྱེ་བོ་མང་པོ་ཚོགས་པ་ལ་ནམ་མཁའ་ནས་ལྷ་གཅིག་གིས་གཏམ་སྨྲ་བ་དང་།",
    "ཡུལ་ཕྲ་མོ་མང་པོས་བར་ཆོད་པ།",
    "དེའི་གཡས་གཡོན་དུ་བློན་པོ་འགའ་རེ་དང་།",
    "མདུན་ནས་ཚོང་པ་འགའ་རེའི་སྐྱེས་འབུལ་བ་དང་།",
    "བཀའ་ཡིག་གི་སྒྲོམ་བུ་གཏོད་པ་དང་།",
    "རྒྱལ་པོ་དེའི་དཔུང་ཚོགས་ཡན་ལག་བཞི་དང་།",
    "པདྨའི་ལྟེ་བ་ལ་རྒྱལ་པོ་རེ་རེ།",
    "དབུས་ཀྱི་གཙུག་ལག་ཁང་དེའི་གཡོན་གྱི་ཕྱོགས་སུ་ཁང་བཟང་གཅིག་གི་ནང་དུ།",
    "རྒྱལ་པོ་གཅིག་གིས་ཞུ་བ་འབུལ་བའི་ཚུལ་འབྲིའོ།",
    "ཡང་ཁྱིམ་བདག་དེས་ཁྱིམ་གཅིག་གི་རྩར་འདོད་ཡོན་སྣ་ཚོགས་བཤམས།",
    "ཤིང་སྡོང་གཅིག་གི་ཕྱོགས་གཅིག་ནས་བྲམ་ཟེ་དྲང་སྲོང་རྣམས་ཀྱི་སྣོད་སོ་སོ་ནས་ཆུ་འཛེད་ཅིང་།",
    "ཕྱོགས་གཅིག་ནས་དེ་དག་གིས་ཤིང་ལ་གཏམ་སྨྲ་བའི་ཚུལ་བྱ།",
    "ཤིང་གི་གཡས་གཡོན་གཉིས་ནས་དྲང་སྲོང་རྣམས་གཏམ་སྨྲ་བའི་ཚུལ་བྱ།",
    "ཁང་བཟང་གི་ནང་ཁྱིམ་བདག་དེ་དང་།",
    "ཡང་གཙུག་ལག་ཁང་གཅིག་གི་ནང་དུ་བཅོམ་ལྡན་འདས་ལ་ཞུ་བ་ཞུ་ཞིང་།",
    "ཡུལ་ལྗོངས་ཕར་ཕྱོགས་དེར་དེ་གཉིས་ཀྱི་ཁ་ལྟ་བྱེད་ཅིང་སྐྱེད་མོས་ཚལ་ཞིག་གི་དབུས་སུ་གཙུག་ལག་ཁང་རྩིག་པ་དང་།",
    "གཙུག་ལག་ཁང་གི་ཁང་བཟང་གི་ནང་ན།",
    "དེ་གཉིས་ཆར་གྱི་སྟེང་གི་ནམ་མཁའ་ནས།",
    "ལྷ་རྣམས་ཀྱི་མེ་ཏོག་གི་ཆར་འབེབས་པ་འབྲི།",
    "ཡང་ཁང་བཟང་གཞན་ཞིག་གི་ཕྱོགས་གཅིག་ཏུ།",
    "གཡོག་མོ་རྒུར་མོ་ཞིག་ལངས་ཏེ་ཚིག་བརྗོད་པའི་ཚུལ་དང་།",
    "བུད་མེད་གཅིག་དང་།",
    "ཉེ་སྐོར་ཕྱོགས་གཅིག་ན་བུད་མེད་ལུས་སྦོམ་པ།",
    "སྐྱེད་མོས་ཚལ་གཅིག་ན་བྲམ་ཟེ་གཅིག་དང་བུད་མེད་གཞོན་ནུ་གཅིག་འདུག་པ་ལ་མི་མང་པོས་སྐོར་བ་དང་།",
    "གཅིག་གི་འོག་ཏུ་བཙུན་མོ་ཆུང་བ།",
    "གཅིག་ཚུར་ལོག་ནས་རྒྱལ་པོ་རང་གི་དྲུང་དུ་ལྷུང་བ་དང་།",
    "རྒྱལ་པོས་ཐལ་མོ་སྦྱར་ཞིང་བཟོད་པ་གསོལ་བའི་ཚུལ་འབྲི།",
    "ལྷ་མོའི་གཟུགས་ཅན་ཤིན་ཏུ་མང་པོས་ཁྱབ་པ།",
    "ལྷ་མོ་དང་ནོར་བུས་གང་བ།",
    "ལྷ་མོ་ཞིག་འབྲིའོ།",
    "ཕྱི་ལ་དམག་མི་ཐོ་རེ་བ་ཡོད་པ།",
    "བུ་མོ་དང་རྒྱལ་པོ་དང་།",
    "ལུས་སྲང་ཐལ་མོ་སྦྱར་ལུས་ལས་འོད་འཕྲོ་བ་འབྲི།",
    "ཡང་གཙུག་ལག་ཁང་གཞན་གཅིག་གི་མདུན་ན།",
    "ཁྱིམ་གྱི་བུད་མེད་རྣམས་བུད་མེད་ཀྱི་མཆོག་འབའ་ཞིག་འབྲིའོ།",
    "དེ་ནི་རྒྱལ་པོའི་བུ་མོ་མུ་ཏིག་ཅན་བདེན་པ་ལ་བཀོད་པ་སྟེ།",
    "ཡུལ་ལྗོངས་ཆུང་ངུ་འགའ་རེ་བྱ།",
    "ཡང་ཁྱིམ་བདག་ཕོ་མོ་གཟི་བརྗིད་ཆེ་བའི་མདུན་ན།",
    "བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་གཅིག་གིས་ཞུ་བ་ཞུ་བ་དང་།",
    "ཕྱོགས་གཅིག་ནས་བུ་མོ་དེ་ཤིང་རྟར་བཞུགས་ནས་ཡུལ་ཕར་ཕྱོགས་དེ་ལ་གཏད་ནས་འགྲོ་ཚུལ་དང་།",
    "དགེ་སློང་རེ་རེས་ཚུལ་ཤིང་འགྲེམས་པའི་ཚུལ་དང་།",
    "གྲོང་གི་ཁང་བཟང་དུ་ཁྱིམ་བདག་གི་བུ་ཁྱུ་མཆོག་ཅེས་བྱ་བས།",
    "བུ་མོ་དེས་དེ་གཉིས་ལ་གཏམ་སྨྲ་བ་དང་།",
    "བུ་མོ་དེས་ཡུལ་ལྗོངས་ཚུར་ཕྱོགས་དེ་ལ་གདོང་ཕྱོགས་དེ་ཐལ་མོ་སྦྱར་བ་དང་།",
    "ཤིང་དང་བྱ་དང་མེ་ཏོག་གི་རྒྱན་པའི་བྲག་རིའི་རྩེ་མོ་ལ།",
    "གླང་པོ་ཆེ་ཐལ་ཀར་མཆེ་བ་དྲུག་པ་ལ་ཆིབས་པའི་དགེ་སློང་དང་།",
    "བྱ་ཁྱུང་གིས་དྲངས་པའི་ཤིང་རྟ་ལ་གནས་པའི་དགེ་སློང་དང་།",
    "སྐུ་མདུན་ནས་ཟུར་ཕུད་ལྔ་པ་སོགས་དྲི་ཟ་རྣམས་ཀྱི་རོལ་མོ་བརྡུང་པ།",
    "བུ་མོ་དེས་དེ་དག་སྟོན་པའི་ཚུལ་དང་།",
