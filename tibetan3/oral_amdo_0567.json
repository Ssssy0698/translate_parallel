    "ཛམ་གླིང་ཤིང་རྟ་འཁོར་ལོ་གཉིས་པ་ལྟ་བུ་ངོས་གསུམ་ལཉིས་སྟོང་རེ་དང་གཅིག་ལ་སྟོང་ཕྲག་ཕྱེདདང་བཞི།",
    "གཟུགས་མེད་བཞིས་སྲིདཔའི་རྩེ་མོར་ཐུག།",
    "ཁ་བ་ཆགས་པ་བོད་ཀྱི་རྒྱལ་ཁམས་ན་སྲིན་མོ་གན་རྐྱལ་འགྱེལ་འདྲ་ངམ་གྲོག་ཚེ།",
    "ལེ་ལོ་ཅན་ཞིག་གིས་ནི་སོག་འཇོག་བྱས།",
    "ཆམཉམ་ཞིང་བགོས་རང་གི་སྐལ་བ་ཆད།",
    "ཀུན་གྱིས་ཅུང་ཟད་ཙམ་རེ་བྱིན་པ་ཡིས།",
    "གཅིག་གི་སྐལ་པ་གཅིག་ཤོས་ཀྱིས་བརྐུས་པས།",
    "དེ་བཞིན་ཡར་འདེད་ལྷ་བདུན་ཞེས་ཟེར་མོད།",
    "ཞིང་གི་ལས་ཀྱིས་འཚོ་བ་རྨངས་རིག་སྟེ།",
    "ཝཱར་ཎ་སུར་བརྒྱ་ཕྲག་གཅིག་གི་མཐར།",
    "དེ་ཚེ་གཡོན་ཅན་པདྨའི་རྩ་ལག་གིས།",
    "རྒྱལ་པོས་རང་གི་ཕུ་བོ་ཡིན་པ་དང་།",
    "གོད་ཆས་རང་གིས་མ་ཉེས་པའི།",
    "ཁྱོད་ཀྱིས་རིགས་རྒྱུད་འཇོག་པར་ནུས་སམ་དྲིས།",
    "བཙུན་མོ་ཤི་ནས་རྒྱལ་པོ་གཞན་ཞིག་གི།",
    "སྣ་ཚོགས་ནསློང་འདུལ་རྣམས་སྲིང་མོ་གཉེན་བཅས་གངས་རི་དང་ཉེ་བ།",
    "དྲང་སོང་སེར་སྐྱའི་གནས་དང་ཉེ་བར་སྦྱགས།",
    "ལང་ཚོ་རྒྱུགས་ཆེས་འདོད་པས་ཉེན་པ་ཡིས།",
    "སྲིངམོ་དག་དང་ལྷན་ཅིག་འགྲོགས་པར་གྱིས།",
    "དེ་ལས་ཁྱེའུ་བུ་མོ་མང་དུ་འཕེལ།",
    "ང་ནི་རེ་ཞིག་སྐུ་རྒྱབ་བསྙུན་པ་བསལ།",
    "ཁྱོད་ཀྱིས་སྟོན་ཞེས་བསྒོས་ནས་གཟིམས་པར་བསྟན།",
    "རྫུ་འཕྲུལ་ལྡན་མཆོག་མོངྒལ་བུ་ཡིས་ནི།",
    "འཕགས་སྐྱེས་པོ་ཡི་སྲས་གསུམ་སྲིང་མོར་བཅས།",
    "ད་ལྟ་ཡ་ཐོག་རིང་མོའི་མཇུག་ཡིན་སྟེ།",
    "དེ་ནས་མཐོང་ཚད་གཅིག་གིས་གཅིག་གསོད་པ།",
    "གནས་བརྟན་བཅུ་དྲུག་གིས་ནི་སྟོན་པའི་བཀའི།",
    "གནས་བརྟེན་དེ་དག་གིས་མ་ཤེས་པའམ་མ་མཐོང་པའམ་གཙུག་གི་ལམ་ནི་སྟོང་ཕྲག་བཅུ་དྲུག་དང་རི་བོ་གཉའ་ཤིང་འཛིན་ལ་གནས་སོནགས་ན་གནས་ནི་སྟོང་ཕྲག་བཅུ་བཞི་དང་ལུས་འཕགས་ཀྱི་རི་ལའོ།",
    "མི་ཕམ་པ་ནི་སྟོང་ཕྲག་བཅོ་ལྔ་དང་བྱ་རྒོད་ཕུང་པོའི་རེ་ལའོ།",
    "མཆོད་རྟེན་དེ་ཡངབ་ནས་འོག་གི་གསེར་གྱི་ས་གཞི་གང་ཡིན་པ་དེ་ལ་གནས་སོ།",
    "བྱ་གགའཕུར་སྟབས་ཆོད་པར་གྱོང་གིས་ཁྱབ།",
    "སོ་སོའི་གླིང་གི་མི་རྣམས་ཀུན་གྱིས་ཐོས།",
    "མེ་དེ་རང་ཞི་ཐལ་བའང་མ་ལུས་པ།",
    "འཇིག་རྟེན་བཞག་པར་མོངྒལ་བུ་ཡིས་བཤད།",
    "རྟོག་དཔྱོད་མེ་འདྲ་ནང་གི་བསམ་གཏན་སྐྱོན།",
    "བདེ་བ་ཡོད་པའི་ཞིང་ཁམས་ཀྱི་བསྐལ་པ་དེ་ནི་དེ་བཞིན་གཤེགས་པ་རྡོ་རྗེ་རབ་འཇོམས་ཀྱཁང་དུར་མིག་གིས་མཚན་ཙིཉིན་ཞག་གཅིག་གོ།",
    "འཕགས་མཆོག་རྣམས་ཀྱི་གཟིགས་ཡུལ་ལྟད་མོར་ཆེ།",
    "རལ་མོ་ཐམས་ཅད་དུས་གཅིག་དཀྲོལ་ཅིག་གསུང་།",
    "རོལ་མོའི་སྒྲ་ཡི་ནང་ན་མཆོག་ཅི་ས།",
    "ཀུན་ཀྱང་དུང་གི་སྒྲ་ཡིས་ཟིལ་མནན་གསོལ།",
    "ཟས་གཙང་བཙུན་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཞེས།",
    "ཡུམ་ལ་གནོད་པ་མེད་ཅིང་ནག་ནོག་གིས།",
    "བྲནམོ་རྒན་མོའི་རྣམ་པས་བླངས་པའི་ཚེ།",
    "གསེར་གྱི་པདྨ་འདབ་སྟོང་པ་རེ་བྱུང་།",
    "བདག་མོ་ཆེན་མོ་སྒྱུ་འཕྲུལ་སོགས།",
    "དྲང་སྲོང་ཉོན་མོངས་མེད་ཀྱིས་ཕྱག་བྱས་སྟེ།",
    "རང་གི་སྣག་ཚ་བྲམ་ཟེ་མེས་བྱིན་ལག།",
    "མཛུབ་མོ་གཅིག་གིས་གསེར་གཞོང་བཟུང་བ་ནི།",
    "གླང་ཆེན་སྟོང་གི་སྟོབས་ཅན་ཞེས་མཚན་བཏགས།",
    "ཞབས་ལ་གཏུགས་ཅིང་བསྟོད་ནས་སོང་བར་གྱུར།",
    "དེ་ནས་བུད་མེད་རྣམས་ཀྱི་དོནམཛད་ཕྱིར།",
    "ལག་ན་བེ་ཅོན་བུ་མོ་གྲགས་འཛིན་མ།",
    "ཤཱཀྱ་དུས་ལེགས་བུ་མོ་རི་དགས་སྐྱེས།",
    "སྦལ་པའི་དགེ་སློང་གཟིགས་པའི་རྐྱེན་དང་ནི།",
    "བཙུན་མོས་སྒྱུར་བའི་རོལ་མོའི་སྒྲ་དབྱངས་ལས།",
    "བུད་མེད་འགྲོག་པའི་ཐ་མ་འདི་ཡིན་ཞེས།",
    "ཁྱོད་ཀྱི་བསམ་པ་རྫོགས་པར་གྱུར་ཅིག་ཞེས།",
    "ལྷོ་ཡུལ་ན་ཡང་དུས་སྟོན་རེ་རེ་ཡོད།",
    "འདི་ནི་དེ་ཡི་སྐྱེད་མོས་ཚལ་དུ་འགྱུར།",
    "དེ་མཐུས་སྔོན་མོ་འབྱོར་པ་རྒྱས་པ་ཡིན།",
    "རྐང་པ་གཅིག་གིས་འགྲེད་སོགས་སྣ་ཚོགས་པའི།",
    "རྒྱུ་ཤུག་འབྲུ་རེ་སཱ་ལུ་འབྲུ་རེ་དང་།",
    "ཐུན་མོང་སྣང་ངོར་ཤིན་ཏུ་རིད་པའི་སྐུ་གྲོང་གི་བྱིས་པའིརྩེད་མོའི་གནས་སུ་གྱུར།",
    "ངལ་དུབ་མཐའ་ཡིས་གྲོལ་བར་མ་གཟིགས་ནས།",
    "དེ་ཚེ་གྲོང་པའི་བུ་མོ་དགའམོ་དང་།"
  ]
}