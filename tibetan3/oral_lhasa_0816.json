    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་ས་དང་ལམ་དུ་སྟོན་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ནི་ས་དང་ལམ་དུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ནི་གནས་དང་འབྲས་བུར་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ནི་དོན་མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ཏུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་ལུས་ལ་སྨྲ་བའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་ལུས་ལ་སྨྲ་བའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་ལུས་ལ་སྨྲ་བའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་ལུས་ལ་སྨྲ་བའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་ལུས་ལ་སྨྲ་བའོ།",
