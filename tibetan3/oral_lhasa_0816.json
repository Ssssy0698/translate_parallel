    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "སྣ་ཡི་རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱིས་རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
