    "གཉིས་པ་ལས་ཀྱང་ཚིག་འབྲུ་བཟང་མིན་ཞེས་བྱ་བ་འདི་ལས་བཟློག་པ་ནི་ལེགས་པར་གསུངས་པའོ།",
    "དོན་བཟང་མིན་ཞེས་བྱ་བ་འདི་ལས་བཟློག་པ་ནི་ལེགས་པར་བསྟན་པའོ།",
    "དེ་ལྟར་ན་བཟློག་ན་རྣམ་པར་གྲོལ་བའི་ཐབས་ཡིན་ནོ།",
    "ལྷ་དང་མིའི་བར་དག་ལ་ཡང་དག་པར་ཤིན་ཏུ་བསྟན་ཞེས་བྱ་བ་གང་ཡིན་པ་དེ་ཡིན་པའོ།",
    "ལྷ་དང་མིས་ཡང་དག་པར་བཟུང་བ་ཉིད་དང་།",
    "སློབ་དཔོན་གྱི་དཔེ་མཁྱུད་མེད་པར་རྒྱུན་དུ་བསྟན་པ་ཉིད་ཀྱིས་ཏེ།",
    "ལྷག་མ་འདི་གསུམ་ནི་གོ་རིམས་བཞིན་དུ་ལྷ་དང་མིའི་བར་དག་ལ་ཡང་དག་པར་ཤིན་ཏུ་བསྟན་པ་ལས་རིག་པར་བྱའོ།",
    "ཇི་ལྟར་ཞེ་ན་ལྷ་དང་མིས་ཡང་དག་པར་བཟུང་བ་ཉིད་ནི་ལྷ་དང་མིའི་བར་དག་ལ་ཞེས་བྱ་བ་ལས་རིག་པར་བྱ་སྟེ།",
    "ཡང་དག་པར་ཤིན་ཏུ་བསྟན་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་འོས་པའི་གདུལ་བྱ་ལ་བསྟན་པ་ཉིད་ནི་ཡང་དག་པར་བསྟན་པ་ལས་རིག་པར་བྱའོ།",
    "སློབ་དཔོན་གྱི་དཔེ་མཁྱུད་མེད་པར་རྒྱུན་དུ་བསྟན་པ་ཉིད་ནི་ཤིན་ཏུ་བསྟན་པ་ལས་རིག་པར་བྱའོ།",
    "དེ་ཉིད་དོན་ནི་ལེགས་གསུངས་ཕྱིར།",
    "དེ་ཉིད་དོན་ནི་ལེགས་གསུངས་ཕྱིར་ནི་ལེགས་པར་གསུངས་པའོ།",
    "མ་ལུས་པར་ནི་བསྟན་ཕྱིར་རོ་ནི་ཙཡང་དག་པར་ཤིན་ཏུ་བསྟན་པའོ།",
    "མཐུན་པར་ཞུགས་པ།",
    "གནས་པར་བྱ་བ་ནི་རྟེན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་སྒྲུབ་རྒྱ་པ་ལས་བརྩམས་ནས་ལེགས་པར་ཞུགས་པ་ཉིད་དུ་སྟོན་པ་ནི་དྲང་པོར་ཞུགས་པ་པྱཞེས་བྱ་བའི་ཚིག་འདིས་སོ།",
    "ཐ་མི་དད་པར་སྒྲུབ་པ་ལས་བརྩམས་ནས་ལེགས་པར་ཞུགས་པ་ཉིད་དུ་སྟོན་པ་ནི་མཐུན་པར་ཞུགས་པ་ཞེས་བྱ་བའི་ཚིག་འདིས་སོ།",
    "དགེ་སྦྱོང་མ་ཡིན་པར་དགེ་སྦྱོང་དུ་ཁས་འཆེ་སྤུབ།",
    "དེའི་ཕྱིར་དགེ་སྦྱོང་མ་ཡིན་པར་དགེ་སྤྱོང་དུ་ཁས་འཆེ་བའོ།",
    "འཁྲིག་པ་སྤོང་པ་ཁས་འཆེ་སྐྱེབའི་ཕྱིར་ནི་ཚངས་པར་སྤྱོད་པ་ཅན་མ་ཡིན་པར་ཚངས་པར་སྤྱོད་པ་ཅན་དུ་ཁས་འཆེ་བ་སྟེ།",
    "ལོག་པར་འཚོ་བའི་སྐྱོན་ནི་བོང་བུ་ལྟར་ཀུན་དུ་སྤྱོད་པ་ནས།",
    "ཚངས་པར་སྤྱོད་པ་ཅན་མ་ཡིན་པར་ཚངས་པར་སྤྱོད་པ་ཅན་དུ་ཁས་འཆེ་བ་ཞེས་བྱ་བའི་ཚིག་འདིའི་བར་གྱིས་ཡོངས་སུ་བསྟན་ཏོ།",
    "འདོད་པ་ལ་རྣམ་པར་རྟོག་པ་བྱུང་བ་དང་དུ་ལེན་པར་བྱེདཁྱེ།",
    "གནོད་སེམས་ལ་རྣམ་པར་རྟོག་པ་བྱུང་བ་དང་དུ་ལེན་པར་བྱེད་པ་ནས།",
    "གནས་པ་ནི་ནམ་ཀྱི་ཆ་སྟོད་ལ་སོགས་པ་དག་ཏུ་སྤྱོད་ལམ་ལ་ཀྱེ་རྣམ་པར་རྟོག་པའོ།",
    "ལེགས་པར་རྙེད་པ་དག་ནི་ཅི་དག་ཡོད་ན།",
    "འཁྲུགས་པ་ཅན་ཉིད་ཀྱིས་སྐྱེ་དགུ་གནས་པར་སྟོན་ཏོ།",
    "སྡུག་བསྔལ་ལ་སོགས་པ་ཅན་དང་གོ་རིམས་བཞིན་དུ་རིག་པར་བྱ་སྟེ།",
    "ཇི་ལྟར་བྱས་པས་ཤེ་ན།",
    "ལ་ལ་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "ཡོངས་སུ་གདུང་བ་དང་བཅས་པར་གནས་པ་དང་།",
    "ཡང་དག་པར་བླངས་པ་ཉིད་རྒྱུ་ཡིན་པས་དེའི་རྒྱུས་སོ།་།",
    "སྲོག་གཅོད་པ་ཀུན་དུ་བསྟེན་ཅིང་བསྒོམས་ལ་ལན་མང་དུ་བྱས་པས།",
    "བསྒོམས་པ་ལན་མང་དུ་བྱས་པས་ཞེས་བྱ་བ་ནི་བསྩགས་པ་ཉིད་དུ་སྟོན་ཏོ།",
    "ཇི་ལྟར་བྱས་པས་ཤེ་ན།",
    "དེ་ལ་བརྩོན་པ་དུདང་ཕྱིར་ཞིང་བྱེད་པ་གཉིས་ཀྱིས་བསམ་པ་དང་སྤྱོར་བས་དེ་རྒྱས་པར་བྱེད་པའི་ཕྱིར་ཏེ་བརྩོན་པའི་བྱེད་པས་ནི་བསམ་པས་ཏེ་འདུན་པས་དེ་བརྟས་པར་བྱེད་པའི་ཕྱིར་ལས་དེ་བརྟས་བུཔར་བྱེད་པའི་ཕྱིར་བསྒོམས་ལ་ཞེས་བྱ་བས་ནི་བསྩགས་པ་ཉིད་དུ་སྟོན་ཏོ།",
    "ཕྱིར་ཞིང་བྱེད་པས་ནི་སྤྱོར་བས་དེ་བརྟས་པར་བྱེད་པའི་ཕྱིར་ཡན་ལག་མང་དུ་བྱས་པས་ཞེས་བྱ་བ་བསྩགས་པ་ཉིད་དུ་སྟོན་ཏོ།",
    "ཡང་དང་ཡང་དུ་བྱེད་པ་དང་ལྗོགེའདུན་པར་བྱེད་པས་ནི་བསྩགས་ལྷོསྟེཔ་ཡིན་པར་སྟོན་ཏོ་ཞེས་བྱ་བར་གནས་སོ།",
    "ཁ་ཅིག་ལ་ནི་བྱས་པར་ཡང་འགྱུར་ཏེ།",
    "སྐལ་བ་ཆུང་བའི་ཕྱིར་ལས་དེ་རྣམ་པར་སྨིན་པ་ངེས་པར་འགྱུར་ཏེ།",
    "ཞིང་དང་སེམས་པའི་རྗོཁྱད་པར་ལས་ཀྱང་ཁ་ཅིག་ལས་བྱས་པ་ཡང་རྣམ་པར་མིན་པ་ཡང་ངེས་པར་འགྱུར་རོ།",
    "ལས་གང་ཡིན་པ་དེ་ནི་བྱས་པ་དང་བསགས་པ་ཞེས་བྱ་བས་སོ།",
    "འཕེལ་བ་དང་ལྡན་པར་ཡང་སྟོན་ཏོརྗོ།",
    "མི་སྡུག་པ་དེ་ལ་སྐྱེ་བ་དང་ལྡན་པར་སྟོན་པ་ནི་མི་སྡུག་པ་ཀུན་དུ་བསྟེན་ཅིང་ཞེས་བྱ་བའི་ཚིག་འདིས་སོ།",
    "གནས་པ་དང་ལྡན་པར་སྟོན་པ་བསྒོམས་ལ་ཞེས་བྱ་བ་འདིས་ཏེ།",
    "འཕེལ་བ་དང་ལྡན་པར་སྟོན་པ་ནི་ལན་མང་དུ་བྱས་པས་ཞེས་བྱ་བའི་ཚིག་འདིས་སོ།",
    "གྲུབ་པའི་གནས་སྐབས་ཀྱང་ཡིན་པར་སྟོན་ཏེ།",
    "མི་སྡུག་པ་ཀུན་དུ་བསྟེན་ཅིང་བསྒོམས་ལ་ལན་མང་དུ་བྱས་པས་ནི་འབྲས་བུ་ཆེན་པོར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ།",
    "གཞན་ཡང་རྣལ་འབྱོར་སྤྱོད་པ་རྣམ་པ་གསུམ་གྱི་གནས་སྐབས་ཡིན་པར་སྟོན་ཏེ།",
    "བསྒོམས་པ་ནི་ཡོངས་སུ་སྦྱང་བ་བྱས་པའི་གནས་སྐབས་ནའོ།",
    "ལན་མང་དུ་བྱས་པ་ནི་ཡིད་ལ་བྱེད་པ་ལས་འདས་པའི་གནས་སྐབས་ནའོ།",
