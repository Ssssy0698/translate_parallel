    "གསད་པར་སྦྱོར་བ་ཉིད་ཀྱིས་ནི་ལག་པ་ཁྲག་དམར་བ་ཞེས་བྱ་བ་འདིས་སོ།",
    "རྣམ་གྲངས་གཞན་ཡང་སྲོག་གཅོད་པ་དང་ཞེས་བྱ་བ་ནི་དྲག་ཤུལ་ཅན་ཉིད་ཀྱིས་ནི་ཤན་པ་ལ་སོགས་པའི་སྲོག་གཅོད་པ་ཉིད་ཁྱད་པར་དུ་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་བསྟན་པ་གང་ཡིན་པ་དེ་ཡིན་ཏེ།",
    "དེར་གཏན་དུ་བ་ཉིད་ཀྱིས་སྟོན་པར་བྱེད་དེ།",
    "ཇི་ལྟར་བྱས་པས་ཤེ་ན།",
    "སྲོག་གཅོད་པ་མི་སྤོང་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཚིག་འདིས་ནི་དེར་གཏན་དུ་བ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལུས་དྲག་ཤུལ་ཅན་ཉིད་ནི་ལག་པ་ཁྲག་དམར་ཞེས་བྱ་བའི་ཚིག་འདིས་རིག་པར་བྱའོ།",
    "ཕལ་ཆེར་རྣམ་པར་སྨིན་པར་མི་འགྱུར་བའི་ཕྱིར་འབྲས་བུ་མེད་པའོ་ཞེས་བྱ་བ་ནི་གཉིད་ལོག་པ་ན་སྲོག་གཅོད་པ་ལ་སོགས་པ་ལ་ཞུགས་པ་ན་ཚེ་གཞན་གྱི་ལས་དང་།",
    "བྱིས་པ་ནི་ཉེས་པར་བསམས་པ་སེམས་པ་ལ་སོགས་པས་སོ་ཞེས་བྱ་བ་ནི་དགེ་སློང་དག་བྱིས་པ་ནི་ཉེས་པར་བསམས་པ་སེམས་པ་ཡིན།",
    "ཉེས་པར་སྨྲ་བ་སྨྲ་བ་ཡིན།",
    "མི་འདྲའོ་སྙམ་དུ་རློན་པར་བྱེད།",
    "དམན་པ་མ་ཡིན་ནོ་སྙམ་དུ་རློམ་པར་བྱེད་དེ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་སྐྱེ་བ་དང་།",
    "གཟུགས་མི་བརྟན་པ་ནས་རྣམ་པར་ཤེས་པ་མི་བརྟན་པའི་བར་དང་།",
    "གཉིས་པས་ཏེ་མི་བརྟན་པ་ཞེས་བྱ་བ་འདིས་ནི་ཡུན་རིང་པོ་ནས་འཇིག་པ་འགོག་པར་བྱེད་པ་ཡིན་ནོ།",
    "གསུམ་པས་ཏེ་ཡིད་བརྟེན་དུ་མི་རུང་བ་ཞེས་བྱ་བ་འདིས་ནི་དུས་ངེས་པར་འཇིག་པ་འགོག་པར་བྱེད་པ་ཡིན་ནོ།",
    "དུས་མ་ཡིན་པར་འཆི་བ་སྲིད་པའི་ཕྱིར་ན་མི་བརྟན་པ།",
    "ཡིད་བརྟན་དུ་མི་རུང་བ་གཉིས་ཀྱི་རྒྱུན་འཇིག་པའི་མི་རྟག་པ་ཉིད་སྟོན་པར་བྱེད་དོ།",
    "ཡང་དག་པར་དེ་བཞིན་དུ་གནས་པར་འགྱུར་བའི་གཟུགས་དེ་ལྟ་བུ་འགའ་ཡོད་དམ།",
    "རྣམ་པར་ཤེས་པ་གང་རྟག་པ་དང་།",
    "འཇིགས་པ་ལྔ་པོ་དག་ལས་འཚོ་བ་མེད་པའི་འཇིགས་པ་སྤང་བའི་ཕྱིར་བཀྲེན་པ་མ་ཡིན་པར་བྱེའཚོ་བའོ།",
    "ཕོངས་པ་ཉིད་དུ་རིག་པར་བྱའོ།",
    "ཟག་པ་རྣམས་ཟད་པར་བྱ་བའི་ཕྱིར་ཡང་དག་པར་ལེགས་པར་མཉམ་པར་མི་འཇོག་སྐྱོཔ་ཡིན་ནོ།",
    "ལྷུན་གྱིས་གྲུབ་པར་མི་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དཀར་པོའི་ཕྱོགས་ནི་དེ་ལས་བཟློག་པས་རྗོརིག་པར་བྱའོ་ཞེས་བྱ་བ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "སེམས་རྒྱུད་གཅིག་པར་གྱུར་པ་རྟོགས་སྤྱོཔ་ནི་མི་གཡོ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་རྟག་ཏུ་བག་ཡོད་པས་བསྲུང་བར་བྱ་བ་ཉིད་མ་ཡིན་པ་ནི་ཞི་བ་ལ་སོགས་པའི་རྒྱུས་རིག་པར་བྱའོ།",
    "དེ་དེ་ལྟར་ན་སེམས་མཉམ་པར་གཞག་པ་ཡོངས་སུ་དག་པ་དང་།",
    "སྐལ་བ་ཡོད་ཅིང་ཞེས་བྱ་བའི་ཚིག་འདི་ནི་ནུས་པ་ཡིན་ཞེས་བྱ་བའི་ཚིག་གཞན་གྱིས་རྣམ་པར་འཆད་དོ།",
    "གཡོ་བ་མེད་པའི་ཕྱིར་ཚིག་གཉིས་ཀྱིས་གནས་པ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ལྟ་བུ་ཡིན་པ་མཚན་ཉིད་དང་བཅས་པར་རབ་ཏུ་བསྟན་པ་ཡིན་ཏེ།",
    "གཉིས་ཀྱིས་ནི་ཏིང་ངེ་འཛིན་གྲུབ་པ་ཉིད་མཚན་ཉིད་དང་བཅས་པར་རབ་ཏུ་བསྟན་པ་ཡིན་ཏེ།",
    "ཇི་ལྟར་བྱས་པས་ཤེ་ན།"
  ]
}