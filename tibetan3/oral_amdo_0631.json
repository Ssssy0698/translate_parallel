    "ཞེས་པས་རིགས་མ་སད་པ་དང་རེ་ཞིག་ཆད་པ་བསྟན་ལ།",
    "མོས་པ་དང་ནི་བཟོད་པ་དང་།",
    "དག་རྒྱུ་ལ་དག་འབྲས་ཀྱི་མིང་གིས་བཏགས་པའོ།",
    "ས་ལམ་གོང་འོག་གི་དབྱེ་བས་མིང་འདོགས་ཐ་དད་དུ་བཞག་པ་ནི་བུམ་པ་གཅིག་ཉིད་ཀྱང་བཅུད་གང་བླུགས་ཀྱི་དུས་སུ་མིང་འགྱུར་བ་བཞིན་ཏེ།",
    "ནམ་མཁའ་ཀུན་ཏུ་རྗེས་སོང་ལྟར།",
    "དྲི་མ་བསྲབས་པ་ཉན་རང་གི་དགྲ་བཅོམ་པ་ཡོན་ཏན་འཕགས་པ་དང་།",
    "དེ་བཞིན་ཉོན་མོངས་དང་འདྲེས་པས།",
    "སྦུན་པའི་ནང་གི་འབྲས་བུ་ལྟ་བུའི་དཔེ་དོན་དང་།",
    "འདམ་རྫབ་ཀྱི་ནང་གི་གསེར་ལྟ་བུའི་དཔེ་དོན་དང་།",
    "ས་འོག་གི་གཏེར་ལྟ་བུའི་དཔེ་དོན་དང་།",
    "ཤུན་པའི་ནང་གི་ལྗོན་ཤིང་གི་མྱུ་གུ་ལྟ་བུའི་དཔེ་དོན་དང་།",
    "གོས་རུལ་གྱི་ནང་གི་ནོར་བུའི་གཟུགས་ལྟ་བུའི་དཔེ་དོན་དང་།",
    "བུད་མེད་ངན་པའི་མངལ་ན་མི་བདག་གནས་པ་ལྟ་བུའི་དཔེ་དོན་དང་།",
    "མཚན་སྟོང་གིས་འབར་དེ་བཞིན་གཤེགས་པ་ནི།",
    "ཉེ་བའི་ཉོན་མོངས་སྦུབས་དབྱེ་བྱེ་བ་མཐའ་ལས་འདས།",
    "ཆགས་སོགས་ཉོན་མོངས་དགུ་པོ་འདི།",
    "དཔེ་དགུ་དག་གིས་ཡང་དག་བསྟན།",
    "དྲི་འདི་དག་གིས་བྱིས་རྣམས་དང་།",
    "གསེར་གྱི་དཔེ་གཅིག་གིས་བསྟན་ཏོ།",
    "ལམ་སྦྱངས་ནས་དྲི་མ་བུད་སྟོབས་ཀྱིས་སྐུ་གསུམ་བསྐྱེད་པ་ལྟར་སྣང་བའི་ཆ་ནས་རིགས་ཀྱི་རང་བཞིན་ཞེས་བྱ་སྟེ།",
    "བྲལ་འབྲས་དེ་བཞིན་གཤེགས་པའི་སོ་སོ་རང་གི་རིག་པའི་ཡེ་ཤེས་སོ།",
    "གཏེར་དང་ཤིང་གི་དཔེ་བརྗོད་ཟིན་ཏོ།",
    "དེ་ལྟ་བུའི་ཁམས་དོན་དམ་གྱི་ངོ་བོ་དེ་ཐེག་ཆེན་གྱི་ཚོགས་ལམ་དང་སྦྱོར་ལམ་གྱི་གནས་སྐབས་སུ་ཡོད་ངེས་སྙམ་དུ་ཡིད་དཔྱོད་ཀྱི་མོས་པ་ལས་མངོན་སུམ་དུ་མི་མཐོང་ངོ།",
    "ས་དང་པོ་ནས་ཕྱོགས་རེ་མཐོང་ལ།",
    "བཙས་པའི་ཁྱིམ་ནས་བུ་ཆུང་གིས།",
    "ཤེས་བྱ་མཐའ་མེད་མཁའ་དབྱིངས་ཁྱབ་པ་དེ་དག་གིས་ཀུན་མཐོང་།",
    "ཡང་དག་པའི་མཐའ་རང་བཞིན་རྣམ་དག་གི་ཁམས་ནི་འདུས་མ་བྱས་པ་ནམ་མཁའ་ལྟ་བུ་ལ།",
    "དེའང་ཉོན་མོངས་པ་ལ་ཚུལ་བཞིན་མ་ཡིན་པའི་ཡིད་ལ་བྱེད་པས་སྡུག་བསྔལ་བ་ནི་སྤྲིན་དང་འདྲ་ལ།",
    "ཉོན་མོངས་པ་དང་ལས་ཀྱིས་བསྐྱེད་པའི་ཕུང་པོ་རྣམས་ནི་སྒྱུ་མ་དང་སྤྲུལ་རིགས་ཀྱི་རྣམ་གཞག་རྒྱ་བོད་མཁས་པའི་བཞེད་སྲོལ།",
    "ཉོན་མོངས་ལས་དང་རྣམ་སྨིན་དོན།",
    "ཉོན་མོངས་ལས་ཀྱི་རྣམ་པར་སྨིན།",
    "ལུང་གིས་སྒྲུབ་ཚུལ་ནི།",
    "སེམས་འདི་སངས་རྒྱ་རུང་གི་རྒྱུ་ཙམ་དུ་གྲུབ་ཀྱང་།",
    "ཡང་དེ་བཞིན་གཤེགས་པ་མི་རྟག་གོ་ཞེས་བྱ་བའི་ཚིག་སྨྲ་བས་ནི་ཤིང་གི་ཕུང་པོ་འབར་བ་འདི་ལ་ལྕེས་ཀུན་ནས་རེག་པར་བྱས་ཏེ་ཤི་ཡང་སླའི་ཚིག་དེ་ནི་མཉན་པར་མི་བྱའོ།",
    "རང་བྱུང་གི་ཡེ་ཤེས་མ་ཡིན་པ་དང་།",
    "རང་གི་ངོ་བོས་འཇིག་པས་བསླུ་བ་ཅན་དང་།",
    "ཐུན་མོང་ཚུར་རོལ་མཐོང་བ་ལ་བརྟེན་པའི་རིགས་པ་ཙམ་གྱིས་གཞལ་ནས་ཡེ་ཤེས་འདུས་མ་བྱས་པ་མི་སྲིད་དེ་ཤེས་པ་དང་རྟག་པའི་གཞི་མཐུན་མི་སྲིད་པས་སོ་སྙམ་པ་ནི།",
    "གང་གི་ཕྱིར་དེ་རྒྱས་འགྱུར་གྱི་རིགས་མེད་པ་དག་ལ་མེད་པའི་ཕྱིར་རོ།",
    "གཞུང་དེ་ལ་ཞིབ་མོར་དཔྱད་ན་གསུམ་ཡོད་དེ།",
    "འདི་གཉིས་ནི་རང་བཞིན་འབྲས་བུ་ལམ་གསུམ་ལས་ངོ་བོ་ཤིན་ཏུ་ཐ་དད་མོད་ཀྱི།",
    "ལྷ་མོ་དཔལ་ཕྲེང་གིས་ཞུས་པ།",
    "བཙས་པའི་ཁྱིམ་གནས་བུ་ཆུང་གི།",
    "ཞེས་སོགས་ཀྱི་ལུང་གིས་བསྟན་པ་དེ་ཉིད་ཀྱིས་མི་ལོ་བཅུ་གཉིས་སུ་འཕགས་པ་བྱམས་པ་བསྒྲུབས་པས་གྲུབ་ནས་རྗེས་སུ་བཟུང་སྟེ་དགའ་ལྡན་དུ་མི་ལོ་ལྔ་བཅུའི་ཡུན་ལ་བཞུགས།",
    "དེ་དག་གི་རྗེས་འབྲང་བློ་གྲོས་མཚུངས་མེད་དང་།",
    "ཞེས་གསལ་ཡང་རྒྱུན་མིན་ནམ་སྙམ་མོ།",
    "འཕྲིན་ལས་ཏེ་གསུམ་མོ།",
    "དང་པོའི་ངེས་དོན་གང་ཟག་གི་བདག་མེད་པ་ཇི་ལྟར་འདུ་ན།",
    "རིགས་ཏེ་རང་གི་མཚན་ཉིད་གསུམ་དང་།",
    "ཞེས་གསལ་ཡང་རིགས་མིན་ནམ་སྙམ་མོ།",
    "རྒྱན་སྟུག་དཔལ་ཕྲེང་གིས་ཞུས་པ།",
    "སློབ་དཔོན་ཕྱ་བ་ནི་དོན་དམ་བདེན་པ་ནི་དངོས་པོ་རྣམས་བདེན་པས་སྟོང་པའི་མེད་དགག་དེ་ཉིད་ཡིན་ཞིང་སྒྲ་རྟོག་གི་ཞེན་པའི་ཡུལ་དུའང་རུང་བར་བཞེད།",
    "དེ་ལ་མིང་གི་བརྡ་དང་དཔེ་སྣ་ཚོགས་ཀྱིས་བསྟན་ཏེ།",
    "ཞེས་པ་ལྟར་གཞན་སྟོང་གི་རིགས་པས་དཔྱོད་ཅིང་།",
    "བོད་འདིར་གྲུབ་ཆེན་ཡུ་མོས་གསལ་སྒྲོན་སྐོར་བཞི་མཛད་པ་ནས་བརྗོད་སྲོལ་དེ་བྱུང་ལ།",
    "ཞེས་གསལ་ཡང་རིགས་མིན་ནམ་སྙམ་མོ།",
    "ཀྱི་དོན་དབྱིངས་འགྱུར་བ་མེད་པ་ལ་དགོངས་ཤིང་དེ་ཉིད་སྤྲོས་མཚན་ལས་གྲོལ་ཞིང་སྒྲ་རྟོག་གི་ཡུལ་ལས་འདས་པ་དང་།",
    "དེ་ཉིད་རིག་པས་དཔྱད་བཟོད་ཡིན་པས་དཔྱད་པ་རང་གིས་འཁྲུལ་ཏེ་དུས་ཀྱི་འཁོར་ལོ་ལས་གསུངས་པའི་རྣམ་ཀུན་མཆོག་ལྡན་གྱི་སྟོང་པའི་གཟུགས་བརྙན་ལ་ཕྱག་རྒྱ་ཆེན་མོ་བརྗོད་པ་སོགས་དང་མཚུངས་པ་གསུངས་སོ།",
    "ཁམས་དེ་ལ་རྒྱུའི་ཡོན་ཏན་མོས་པ་སོགས་དང་།",
