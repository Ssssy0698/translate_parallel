    "དེ་དག་ཉོན་མོངས་བྱེ་བ་མང་བ་སྟེ།",
    "ཉོན་མོངས་དབུས་ན་དེ་བཞིན་གཤེགས་འདུག་མཐོང་།",
    "མི་ཞིག་ལམ་དུ་རབ་ཏུ་རྒྱུ་བའི་ཚེ་མི་དེའི་རྒྱན་ཆ་སོགས་སུ་གྱུར་པའི་གསེར་གྱི་ངོ་བོ་འགྱུར་བ་མེད་པ་དེ་ཉིད་ལྗན་ལྗིན་རུལ་པའི་གནས་སུ་ལྷུང་བར་གྱུར་ཀྱང་གསེར་རང་གི་ངོ་བོ་ངན་པར་མི་འགྱུར་བས་སྔོན་དུ་ཇི་ལྟར་ཡོད་པ་དེ་བཞིན་དུ་མི་གཙང་བའི་གནས་དེར་ལོ་བརྒྱ་ཕྲག་མང་པོ་གནས་པ་ན་ལྷའི་མིག་རྣམ་པར་དག་པ་དང་ལྡན་པའི་ལྷ་རྣམས་ཀྱིས་དེ་མཐོང་ནས་མི་རྣམས་ལ་འདི་ན་ཡོད་པའི་གསེར་དེ་སྦྱངས་ནས་རིན་ཆེན་གྱིས་སྒྲུབ་པར་བྱ་བ་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་ལ་སོགས་པ་གྱིས་ཤིག་ཅེས་སྨྲས་པས་མི་རྣམས་ཀྱིས་དེ་ཉིད་སྦྱངས་པ་ན་གསེར་དེ་མངོན་དུ་གྱུར་པ་བཞིན་ནོ།",
    "ང་ནི་ཁྱོད་ཀྱི་ཡིན་ཞེས་དེ་མི་སྨྲ།",
    "ཇི་ལྟར་ཨ་མྲ་ལ་སོགས་ཤིང་འབྲས་ལ།",
    "ལྷ་ཡི་མིག་གིས་དེ་ནི་མཐོང་ནས་སུ།",
    "མི་མོ་གཟུགས་ངན་ཞིང་དབུལ་ལ་མགོན་མེད་པའི་ཁྱིམ་གྱི་འདུག་གནས་སུ་འདུག་པར་གྱུར་པ་དེས་རང་གི་ལྟོ་བ་ན་འཁོར་ལོས་སྒྱུར་རྒྱལ་དུ་འགྱུར་རུང་གི་བུ་མངལ་གྱི་དྲི་མས་བསྒྲིབས་ནས་ཡོད་པ་མ་ཤེས་ཀྱང་དེ་ཉིད་མངལ་ནས་བཙས་ཏེ་མངལ་གྱི་དྲི་མ་དང་བྲལ་བ་ན་རིམ་གྱི་འཁོར་ལོས་བསྒྱར་བའི་རྒྱལ་པོར་གྱུར་པའི་ཚེ་བུད་མེད་དེ་ཉིད་དབུལ་བའི་སྡུག་བསྔལ་ཐམས་ཅད་སེལ་ཞིང་དེའི་མགོན་དུ་གྱུར་པ་བཞིན་ནོ།",
    "ཇི་ལྟར་བུད་མེད་མགོན་མེད་གྱུར་པ་ཞིག།",
    "རེ་ཞིག་དུས་ན་དེ་ནི་དེར་སྦྲུམ་གྱུར།",
    "ཇི་ལྟར་ནང་གི་གསེར་ཞུན་གཟུགས་རྒྱས་པ།",
    "པདྨའི་སྦུབས་ལ་སོགས་པའི་སྒྲིབ་བྱེད་དགུ་པོ་དེ་དང་འདོད་ཆགས་ཀྱི་བག་ལ་ཉལ་ལ་སོགས་པའི་ཉོན་མོངས་པའི་དྲི་མ་དགུ་པོ་རྣམས་དོན་དེ་དང་དེ་མཐོང་བ་ལ་སྒྲིབ་བྱེད་ཙམ་དུ་མཚུངས་ཀྱང་བསྒྲིབ་ཚུལ་མི་འདྲ་སྟེ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་ཀྱིས་སེམས་དམིགས་པ་དང་མཚུངས་ལྡན་གང་རུང་དུ་བྱས་པའི་སྒོ་ནས་སེམས་ཀྱི་སྣང་གནས་ཐ་དད་དུ་བྱེད་ཅིང་སེམས་ཀྱི་གནས་ཚོད་ནི་ཡུལ་འཛིན་པ་ཡིན་ལ།",
    "དེ་དག་གིས་ནི་སྒྲིབ་བྱེད་ཀྱི་དྲི་མ་བསལ་ནས་བསྒྲིབ་བྱའི་དོན་མངོན་དུ་འགྱུར་ཚུལ་རྣམས་གསལ་བར་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལ་དུག་གསུམ་གྱི་བག་ལ་ཉལ་གསུམ་ནི་འཇིག་རྟེན་པའི་འདོད་ཆགས་དང་བྲལ་བའི་རྒྱུད་ལ་ཡོད་པའི་ཉོན་མོངས་པ་ས་གང་དུ་འཕངས་པའི་ལས་ཀྱི་རྣམ་སྨིན་ས་གཞན་དུ་མི་གཡོ་བས་མི་གཡོ་བའི་འདུ་བྱེད་ལ་སོགས་པའི་རྒྱུ་གཟུགས་དང་།",
    "འཇིག་རྟེན་པའི་ཞི་རགས་ཀྱི་རྣམ་པ་ཅན་གྱི་ལམ་གྱིས་སྤོང་མི་ནུས་པར་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་ཀྱིས་གཞོམ་པར་བྱ་བ་སྲིད་རྩེའི་སས་བསྡུས་ཀྱི་ཉོན་མོངས་པ་རྣམས།",
    "གཏི་མུག་གི་བག་ལ་ཉལ་དུ་འཇོག་པ་ཡིན་ཏེ།",
    "ཞེ་སྡང་གི་བག་ལ་ཉལ་ནི་སྲོག་ཆགས་སྦྲང་མ་དང་འདྲ་སྟེ།",
    "ས་དང་པོ་རབ་ཏུ་དགའ་བ་ནས་བདུན་པ་རིང་དུ་སོང་བའི་བར་གྱི་མ་དག་ས་བདུན་ལ་བརྟེན་པའི་སྤང་བྱ་ནི།",
    "མའི་མངལ་ན་གནས་པའི་འཁོར་ལོས་སྒྱུར་རྒྱལ་དུ་འགྱུར་རུང་གི་བུ་བཙས་ཏེ་ཕྱི་རོལ་ཏུ་བྱུང་བ་དང་འདྲ་ལ་བུ་དེ་མའི་མངལ་སྦུབས་ཀྱི་དྲི་མ་དང་བྲལ་བ་ན་སྔོན་དུས་ཀྱི་སྲིད་པའི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་དེ་བཞིན་དུ།",
    "སའི་བླུགས་གོང་དེ་ཉིད་བསལ་བ་ན་དེའི་ནང་གི་གསེར་ལས་བྱས་པའི་རྒྱལ་བའི་སྐུ་གཟུགས་མངོན་དུ་གྱུར་པ་དེ་བཞིན་དུ།",
    "དེ་རྣམས་གང་ཟག་གང་གི་རྒྱུད་ལ་མ་དག་པར་ཡོད་ཅེ་ན།",
    "དྲི་འདི་དག་གི་བྱིས་རྣམས་དང་།",
    "དེ་ལ་འདི་དག་ཟག་པ་མེད་པའི་དབྱིངས་སུ་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་ཉོན་མོངས་པ་བཞི་དང་།"
  ]
}