    "ཅིག་ཤོས་ཀྱི་ཤེས་པ་རང་གི་ཆ་ལ་དམིགས་པ་མ་ཡིན་ཏེ།",
    "འདོད་པ་གྲུབ་པའི་ཕྱིར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཐ་དད་པ་གང་གི་སྒྲུབ་བྱེད་ཡིན་པ་དེ་རྗེས་སུ་དཔག་པ་ཡིན་པའམ་ཐ་དད་པའི་སྒྲུབ་བྱེད་ཀྱི་མངོན་སུམ་ཡིན་ཏེ།",
    "རྣམ་པ་དག་ཁྱོད་མི་འདོད་པ།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཏེ་སྔ་མས་མ་བཟུང་བ་ནི་སྔ་ནས་ཡོད་པའོ།",
    "དེ་ཉིད་དམིགས་པ་མེད་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་མེད་པ་ཉིད་ལས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀིང་ཤུ་ཀའི་ཕུང་པོ་ནི་དུ་བ་མི་བྱེད་ཀྱང་རང་གི་བྱ་བ་བྱེད་པས་ཡོད་པ་ཁོ་ན་ཡིན་གྱི་རྨི་ལམ་གྱི་མཐའ་ཅན་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "ཕྱི་རོལ་གྱི་ཉེ་བར་ལེན་པ་ཅན་གྱི་མིག་ལ་སོགས་པ་ལ་ཡང་ཡོད་པས་རང་གི་རྟོགས་པའི་ཁྱད་པར་ཡིན་པའི་ཕྱིར།",
    "རང་གི་རྟོགས་པ་ཉིད་དོན་ཉིད་ལ་འགལ་བའི་འབྲས་བུ་ཡིན་པར་བསྟན་པ་ནི།",
    "མ་ཡིན་ཏེ་ནང་གི་བྱེད་པ་ལ་རག་ལས་པར་ཞེས་བྱ་བ་སྟེ།",
    "འོན་ཏེ་ཕ་རོལ་དག་གིས་ཀྱང་ཞེས་བྱ་བའོ།",
    "གོམས་པའི་བྱེ་བྲག་གིས་ཞེས་བྱ་བའོ།",
    "འབྲེལ་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཕྱིས་ཀྱི་ནི་མཚན་མོ་ནི་མ་རིག་པའི་མཚན་མའོ།",
    "ཉིན་མོ་ནི་འོད་གསལ་བའི་རང་བཞིན་གྱི་སེམས་ཙམ་ཉིད་གང་གི་ཡིན་པ་དེ་ཡང་དེ་ཡིན་ལ།",
    "སྒྲ་ནི་མཉན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་ངོ་བོའི་ཡུལ་ལ་ཞེས་བྱ་བ་ནི་མི་གསལ་བ་ལའོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་ཤེས་པའི་རང་གི་ངོ་བོ་ལའོ།",
    "མངོན་སུམ་ཉིད་ཅེས་བྱ་བ་ནི་རང་གི་རིག་པའི་ངོ་བོའོ།",
    "དེའི་ཕྱིར་རྗེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་རང་གི་ངོ་བོ་མ་ཡིན་པ་ལ་དམིགས་པ་ཡིད་ཀྱིས་ཕྱི་རོལ་མ་ཡིན་པ་ཉིད་རིག་པ་ཡིན་ནོ།",
    "རང་གི་ཕྱོགས་ཀྱང་འགྲུབ་མི་འགྱུར།",
    "དེ་དག་གིས་ནི་མ་ངེས་འགྱུར།",
    "ཞེས་ཟེར་བ་ཅི་གལ་ཏེ་དམིགས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སད་པའི་བློ་དམིགས་པ་དང་བཅས་པ་ཉིད་ཡིན་ན་ཅིག་ཤོས་དམིགས་པ་དང་བཅས་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བཞིན་དུ་འདི་ཡང་དེ་ལྟར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ཆ་ལ་ངེས་པ་གནོད་པར་བྱེད་པའི་མངོན་སུམ་གྱིས་རྗེས་སུ་གཟུང་བའི་ཤེས་པ་དམིགས་པ་དང་བཅས་པ་ཉིད་ཡིན་ནོ།",
    "ཐལ་ཆེས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "མ་ཚང་ལ་སོགས་ཐལ་བར་འགྱུར།",
    "ཐ་སྙད་ཀྱི་ངོ་བོའི་བློ་ཡང་བདག་ཅག་གི་ནི་ཡུལ་ལ་དམིགས་པ་ཉིད་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "ཁོ་བོ་ཅག་གི་ཡང་མི་བསླུ་བ་ལས་དེ་ལྟ་བུའི་ཐ་སྙད་ཡིན་གྱི་དམིགས་པ་ཉིད་ལས་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་མངོན་སུམ་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འབྲས་བུའམ་རྒྱུ་ཡང་མཐོང་ནས་ངེས་པ་ནི་མ་གོམས་པ་ན་རང་གི་རྒྱུའི་ནུས་པ་ཉིད་ཀྱིས་དེ་ལྟར་ངེས་པའི་རྒྱུ་དེའི་བག་ཆགས་དང་གོམས་པས་ཀྱང་ངེས་པ་ཁོ་ན་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཅི་ལས་ཤེ་ན་རང་གི་ངོ་བོ་ཙམ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་ཡང་རང་གིས་ཞེས་བྱ་བ་ནི་ངོ་བོར་མི་རྟོགས་པས་གཞན་ལས་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "བ་སྤུ་ལྡང་བ་ལ་སོགས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་རིག་པའི་ཁོངས་སུ་གཏོགས་པ་ལས་ཀྱང་བ་སྤུ་ལྡང་བ་ལ་སོགས་པ་ནི་རང་གི་བདེ་བ་མེད་ཀྱང་ཡོད་པའི་ཕྱིར།",
    "རྟགས་དང་དུས་དག་ཐ་མི་དད་པ་དང་ཐ་དད་པ་དག་གིས་གཉི་གའི་བདག་གཅིག་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "གཅིག་གི་ཚེ་ཉིད་དུས་ཐ་མི་དད་པ་ཉིད་ཡིན་ཡང་མངོན་སུམ་ཉིད་ཡིན་ཏེ།",
    "གལ་ཏེ་ཐུང་མོང་བཞིན་དུ་ཞེས་བྱ་སྟེ།",
    "རང་གི་སྣང་བ་ཉིད་ནི་ཉན་པ་པོའིའོ།",
    "ཐུན་མོང་བ་ཉིད་ཀྱི་ཉན་པ་པོའི་ཚིག་ལ་སོགས་པའི་རྟོགས་པ་ནི་སྨྲ་བ་པོ་ཡིར་ཡང་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་ཉན་པ་པོའི་ཤེས་པ་སྔོན་དུ་འགྲོ་བའི་ཚིག་ལས་སྨྲ་བ་པོ་ཤེས་པ་སྔོན་དུ་འགྲོ་བའི་ཚིག་ལ་དེ་ལས་ཀྱང་འདིའི་ཡིན་པར་ཟེར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཤེས་པ་ཉིད་ཡིན་པས་ཞེས་བྱ་བ་ནི་རིག་པར་བྱ་བ་མ་ཡིན་པའི་སྔོན་པོ་ལ་སོགས་པ་རིག་པར་བྱེད་པ་བཞིན་དུ་རྣམ་པ་གང་གི་ཡིན་དེ་བློ་ཡིན་ལ།",
    "ཁྱོད་ལ་དཔེ་ནི་འགའ་ཡང་མེད།",
    "དེ་དག་གི་ཕྱོགས་ལ་གནོད་འགྱུར།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྗེས་སུ་དཔག་པ་འདི་ལས་སྣང་བ་དྲན་པ་དག་གི་དངོས་པོའི་ངེས་པ་རྟོགས་པའི་བདག་ཉིད་ཀྱི་སྔོན་པོ་ལ་ཡིན་གྱི་རྟོགས་པ་མ་ཡིན་པའི་བདག་ཉིད་ལ་ནི་མ་ཡིན་ཏེ།",
    "སྔོན་པོ་བདག་གིས་རིག་གི་ཞེས་བྱ་བ་ཡང་ལས་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ་ཅི་ནས་ཀྱང་སྣང་བ་ཁོ་ན་ཡིན་ནོ།",
    "རང་གི་ཕྱོགས་ཀྱང་འགྲུབ་མི་འགྱུར།",
    "མ་སོན་ཏམ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སོང་པའི་རྗེས་སུ་འབྲེངས་པའོ།",
    "ཡུལ་དེ་སྐྱེ་བའི་གནས་སྤྱི་ལ་སོགས་པ་གང་གི་ཡིན་པ་དེའོ།",
    "དེ་ཉིད་ནི་སྔར་ཡང་སྒྲ་དང་རྟོགས་པ་དག་ལས་ལྡོག་པའི་ཡུལ་ཅན་ཉིད་ཀྱིས་དམིགས་པ་མེད་པའི་ཕྱིར་གཉི་ག་ལ་ཡང་རང་གི་ཚིག་གིས་གནོད་པ་ཡིན་པར་མི་རིགས་པར་བསྟན་པ་ནི།",
    "མངོན་སུམ་གྱི་བློའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་བདག་ཉིད་ལ་གནས་པའི་རང་གི་ངོ་བོ་རིག་པའི་བྱེད་པ་ནི་ཡུལ་གཞན་ལ་མ་ཡིན་ཏེ།",
    "བྱེད་པའི་ཡུལ་གཞན་རང་གི་ངོ་བོའི་ཡུལ་ཡིན་པ་ཉིད་ཀྱིས་ཕྱི་རོལ་མེད་ཀྱང་དངོས་པོ་ལ་སོགས་པ་ཡོད་པ་ལ་འགལ་བ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་ངོ་བོས་ཞེས་བྱ་བ་སྟེ།",
    "སེམས་པ་ཅན་མ་ཡིན་པ་རྣམས་ནི་ནུས་པ་མེད་པའི་ཕྱིར་འདི་རྣམས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གིས་ཞེས་བྱ་བའོ།",
    "སྐྱེས་བུ་རེ་རེ་ཞིང་ཤེས་པ་ཐ་དད་པས་དེའི་བདག་ཉིད་ཀྱི་སྔོན་པོ་ནི་ཉེ་བ་དང་ཅིག་ཤོས་དག་ལ་གཅིག་གི་ངོ་བོར་སྣང་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དག་གིས་ཀྱང་ཞེས་བྱ་བའོ།",
    "དེས་ཞེས་བྱ་བ་ནི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་ངོ་བོ་ཉིད་ནི་ཞེས་བྱ་བ་སྟེ།",
    "སྐྱི་ཉིད་ནི་སྒྲ་དང་དོན་དག་གིའོ།",
    "དེ་ལྟ་ཡང་ནི་དམིགས་པ་མེད་པ་ཉིད་དེ་དུས་གཞན་གྱི་ཚེ་དམིགས་པ་མེད་པ་ཉིད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་ཞིག་གི་རྣམ་པར་ཅན་ནི་བཟུང་བ་སྔོན་པོའི་རྣམ་པ་ཅན་ནོ།",
    "ཐམས་ཅད་དུ་ཞེས་བྱ་བ་ནི་ཟླ་བ་གཅིག་ཏུ་གཏོགས་པའི་ཚེ་ཡང་ཟླ་བ་གཉིས་ཀྱི་ཤེས་པའི་དམིགས་པ་མེད་པའི་རྒྱུ་ཉིད་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁམས་གསུམ་པ་ནི་སེམས་ཙམ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གནས་སྐབས་ལ་སོགས་པ་ལ་མ་ལྟོས་པ་ཁོ་ནར་འོན་ཏེ་གང་གི་རྣམ་པའི་བློ་ཞེས་བྱ་བ་ལ་སོགས་པས་བརྟགས་པ་ཡིན་ནོ།",
    "ནམ་མཁའ་ཞེས་བྱ་བ་ནི་སྐྱོན་གྱི་སྟོབས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཐལ་ཆེས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "འཇིག་རྟེན་པ་ནི་རང་གི་དོན་བྱེད་པ་ཡིན་ལ།",
    "དེ་ལ་ཡང་ཞེས་བྱ་བ་ནི་ཟླ་བ་གཅིག་གི་ཤེས་པ་ལ་སྟེ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འཁྲུལ་པའི་ཆག་གིས་ཀྱང་མ་ངེས་པ་བསྟན་པ་ནི།",
    "དམིགས་པ་མེད་པ་ནི་དགོན་དུང་གི་ཆུའི་ཤེས་པ་ལྟ་བུའོ།",
    "མི་སྣང་བའི་འོད་ཟེར་གྱིས་གདུངས་པའི་དགོན་དུང་གི་བག་ཆགས་ཡིན་ཏེ།",
    "ཐམས་ཅད་རང་གི་ངོ་བོ་ལ་ཞེས་བྱ་བ་སྟེ།",
    "སྨིག་རྒྱུ་ལ་ཆུའི་ཤེས་པ་ལ་ཡང་རེས་འགའ་ཁུང་བུའི་དང་།",
    "ཆུ་བོའི་ཆུ་དང་ཕྲད་ན་དེ་དམིགས་པ་དང་བཅས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གནོད་བྱེད་ཀྱི་འཁྲུལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྒྱུ་དང་གནོད་བྱེད་དག་གིས་ཡོད་པ་དང་མེད་པའི་བདག་ཉིད་གཅིག་ཏུ་བྱེད་པ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་དེ་མེད་ཅེས་བྱ་བའོ།",
    "ཐམས་ཅད་ཀྱི་ཚེ་ཞེས་བྱ་བ་ནི་རེས་འགའ་བ་མ་ཡིན་པ་སྟེ།",
    "ཁྱད་པར་གྱི་ཁྱད་པར་ལ་ཡང་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱོད་ལ་ཡང་འགྱུར་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "རང་གི་ངོ་བོས་གཞན་གྱིས་རྗེས་སུ་ཆགས་པས་བྱས་པའི་ཁྱད་པར་མེད་པ་ཅུང་ཟད་ཀྱང་མེད་པར་བསྟན་པ་ནི།",
    "དེ་ལྟ་བུ་ཉིད་དུ་ཞེས་བྱ་བ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཁྱོད་ཀྱི་རྟོགས་ནུས་ཇི་ལྟར་ཡིན།",
    "དེས་ཞེས་བྱ་བ་ནི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རེས་འགའ་པའི་ཁྱད་པར་ཅན་གྱི་རྣམ་པའི་རྟོགས་པ་དེའི་ཞེས་བྱ་བའི་ཁས་བླངས་པའི་རྟོགས་པའོ།",
    "རྟོགས་པ་ནི་ཤེས་པ་ཡིན་ནོ་ཁྱོད་ཀྱིས་ཀྱང་རྟོགས་པ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཁས་བླངས་པས་གྲུབ་པ་ནི་མངོན་སུམ་མ་ཡིན་ན་གང་གིས་དེ་བཀག་པ་ན་དེས་གནོད་པར་འགྱུར་དེའི་ཕྱིར་མི་རིགས་སོ།",
    "དེ་དག་གི་ཕྱོགས་ལ་གནོད་འགྱུར།",
    "འཁྲུལ་པ་དང་ཅིག་ཤོས་དག་གིས་གནོད་པར་བྱ་བ་ལ་སོགས་པའི་ངོ་བོར་འདོད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "རྒྱུ་དང་ལྡན་པ་ཉིད་ཀྱིས་འཁྲུལ་པ་ནི་མ་ཡིན་གྱི་འོན་ཀྱང་དེ་རྒྱུ་དང་ལྡན་པ་ནི་ཡིན་ཏེ།",
    "འཁྲུལ་པ་ཡོད་མོད་ཅེས་བྱ་བ་ནི་གནས་སྐབས་ལས་སོ།",
    "ཐལ་ཆེས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "ཁས་བླངས་པ་ཙམ་ལས་ནི་འཁྲུལ་པ་ཉིད་མ་ཡིན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་བཞིན་གང་གིས་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་གྱིས་མ་ངེས་པས་རང་གི་ངོ་བོ་སྟེ།",
    "དེ་བརྫུན་ཉིད་དུ་ཐལ་འགྱུར་ན།",
    "གང་གི་ཚེ་ཉ་ཕྱིས་སུ་འགྱུར་ཞེ་ན།",
    "བཟློག་པ་དང་ཅིག་ཤོས་དག་ཀྱང་རིག་ཡིན་ན་སྔ་མས་ཅི་ཞིག་འཐོབ་པ་ཡིན་ན་གང་གིས་ངེས་པ་མེད་པར་འགྱུར།",
    "གང་གི་ཕྱིར་སྔོན་བོ་ནི་སེར་པོ་རིག་ན་མེད་པར་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "བཟློག་རིག་དེ་སྟེ་དེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཕྱོགས་ཀྱང་ངག་གི་དོན་ཡིན་པར།",
    "ཇི་ལྟར་ཁྱོད་ནི་རྟོགས་པར་འདོད།",
    "ཁྱོད་ནི་ཀླན་ཀ་ཚོལ་བ་ཡིན།",
    "རྟོག་བྱེད་དངོས་པོར་ཐལ་བར་འགྱུར།",
    "བདེན་པར་སྣང་བ་ཞེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
