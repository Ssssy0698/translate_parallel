    "དོན་གྱིསགོ་བས་ཤེས་པར་བྱ་བ་ཡིན་པས་སོ།",
    "འོན་ཏེ་མ་གྲུབ་པ་ན་དང་པོ་ལ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ་། གལ་ཏེ་དོན་གྲུབ་ན་དོན་གྱིས་གོ་བ་གྲུབ་པ་ཡིན་གྱི་དོན་མྱོང་བ་གྲུབ་པ་ནི་མ་ཡིན་ཏེ་དེ་ནི་གྲུབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་དོགས་ན་དོན་གྲུབ་པ་དེ་གང་ཡིན་ཞེས་བྱ་བའོ།",
    "༦༡༥དོན་ཐམས་ཅད་སྐྱེ་བ་ཡིན་པའི་ཕྱིར་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་དོན་གྱིསགོ་བས་ཐམས་ཅད་ཤེས་པས་འགྲུབ་པར་འགྱུར་རོ།",
    "རྣ་བ་ལ་སོགས་པའི་འཇུག་པ་ཞེས་བྱ་བ་ནི་རྣ་བ་ལ་སོགས་པ་རྣམས་ཀྱི་ཡུལ་ལ་མངོན་དུ་ཕྱོགས་པའི་ཁྱད་པར་ཡང་རྣ་བ་ལ་སོགས་པའི་འཇུག་པ་ཞེས་བརྗོད་དེ།",
    "གང་དུ་ཡང་ཤེས་པ་དང་འབྲེལ་པར་མི་ོགྲུབ་པོ་ཞེས་པ་ནི་ཐམས་ཅད་ཀྱི་ཚེ་ལྐོག་ཏུགྱུར་པའི་ཕྱིར་རོ།",
    "ཤེས་པ་ཤེས་པར་བྱ་བ་མ་ཡིན་ན།",
    "དེའི་ངོ་བོར་ཞེས་བྱ་བ་ཡན་ལག་ཅན་གྱི་རྣམ་པར་རྟོག་པས་འཇུག་པའི་ཕྱིར་རོ།",
    "མ་གྲུབ་པས་ནི་ཞེས་གསུངས་སོ།",
    "བསྒྲུབ་པར་བྱ་བ་འགྱུར་བ་ཞིག་ན།",
    "གཉི་ག་ནི་སྒྲོ་འདོགས་པ་དང་རྣམ་པར་རྟོག་པའོ།",
    "དེར་ཞེས་བྱ་བ་ནི་སྒྲོ་འདོགས་པ་དང་རྣམ་པར་རྟོག་པ་དེར་རོ།",
    "དེ་དག་༤ཉིད་ཅེས་བྱ་བ་ནི་སྒྲོ་འདོགས་པ་དང་རྣམ་པར་རྟོག་པ་དག་གོ།",
    "མངོན་སུམ་ལས་ཉམས་པར་འགྱུར་ཏེ་མངོན་སུམ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པས་ནི་འབྲེལ་བ་འཛིན་པ་ལ་ལྟོས་པར་བྱ་བ་ཡིན་གྱི།",
    "ཡན་ལག་ཅན་གྱི་རྣམ་པར་རྟོག་པ་གོ་ཇི་ལྟར་ཉམས་སུ་མྱོང་བ་དྲན་པ་ལ་ལྟོས་ཏེ།",
    "མངོན་སུམ་མ་ཡིན་པར་སྒྲུབ་པའི་ནུས་པ་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་ན་དེ་བཞིན་དུ་ཞེས་གསུངས་སོ།",
    "རྟོགས་པའི་གཟུགས་ལ་སོགས་པ་ལ་ལྟོས་པར་མ་གྱུར་པ་རོ་ལ་སོགས་པ་ིདག་གོ།",
    "དེས་ན་ཡན་ལག་ཅན་ཐ་དད་པར་ཇི་ལྟར་འགྲུབ་སྙམ་དུ་དོགས་པ་བསུ་ནས་ཕ་རོལ་པོ་ཉིད་ཀྱིས་སྨྲས་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "དེ་དག་ཅེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པ་རྣམས་ཡན་ལག་ཅན་དེ་ལས་ཐ་དད་པར་རོ།",
    "འདུ་བའི་འབྲེལ་པའི་སྟོབས་ཀྱིས་མ་འགྱེས་པ་ཡིན་ནོ་ཞེས་གཞན་གྱི་དོགས་པ་བསུ་ནས་དེ་ཡང་ཞེས་གསུངས་སོ།",
    "གཟུགས་ལ་སོགས་པ་འདི་ལ་ནི་རང་བཞིན་ཡིན་པར་ཡང་སྲིད་དེ་སྐྱེ་བ་ཡོད་པའི་ཕྱིར་རོ།",
    "བརྟགས་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་དཔྱད་ནས་སོ།",
    "རྒྱུ་དེས་ན་དེ་ལས་གཞན་ཉིད་ལ་ཞེས་བྱ་བ་ཁྱད་པར་གྱི་རྣམ་པར་གཅད་༤པ་ལས།",
    "དེའི་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་རྗེས་སུ་དཔག་པའི་དོན་ཏོ།",
    "རྟོག་པ་དང་བྲལ་བ་སྨོས་པ་དེ་མ་ཐག་པ་ཁོ་ནར་རབ་རིབ་བཅས་༧ཞེས་སྨོས་པས་ཐོབ་པར་བྱ་བ་མ་འཁྲུལ་པར་དོན་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡིན་ནོ་ཞེ་ན།",
    "འབྲེལ་པ་དེ་ནི་མེད་པ་ལ་ཡང་འགྱུར་བའི་ཕྱིར་ཁྱད་པར་མེད་དོ།",
    "གལ་ཏེ་དུས་གཞན་དུ་མ་འཁྲུལ་པ་སྨོས་པར་བྱ་བ་ཡིན་ན།",
    "ཕ་རོལ་དག་ནི་ཞེས་གསུངས་སོ།",
    "ཡང་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྤྱི་དང་ཁྱད་པར་དག་རྣམ་པ་གཞན་གྱི་སྒོ་ནསགནོད་བྱ་གནོད་བྱེད་དུ་བསྟན་ཏོ།",
    "གནོད་པར་བྱེད་པ་རབ་རིབ་བཅས།",
    "རིག་བྱེད་ལ་ནི་ཞེས་གསུངས་སོ།",
    "འགོག་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ་། རྟོག་པར་བྱེད་པའི་སྐྱེས་བུ་ལ་རིག་བྱེད་ཀྱི་དོན་དེ་ཉིད་རྣམ་པ་གཞན་དུ་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་མཐོང་བ་ཡིན་ནོ།",
    "དེ་ལྟ་བུའམ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རིག་པ་དེ་ལྟ་བུའོ།",
    "རྣམ་པ་གཞན་གྱིས་ཞེས་པ་ནི་དེའི་རྣམ་པ་ཅན་མ་ཡིན་པར་རོ།",
    "གང་ལས་ཞེས་བྱས་པ་ནི་དོན་ལས་སོ།",
    "རྣམ་པར་རྟོགཔ་ནི་ིརྣམ་པར་ཤེས་པའིའོ།",
    "རྡུལ་ཕྲ་རབ་དག་ཀྱང་དེ་བཞིན་དུ་རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པའི་ཡུལ་མ་ཡིན་ནོ།",
    "དེས་ན་གལ་ཏེ་བུམ་པ་ལ་སོགས་པར་རྣམ་པར་རྟོག་པའི་ཡིད་ལ་ལྟོས་ནས་བརྒྱུད་པའི་རྒྱུ་ཡང་ཡུལ་ཉིད་ཡིན་ན།",
    "འདི་ནི་རྣམ་པ་གཞན་ཁོ་ནས་ཡུལ་མེད་པར་འགྲུབ་པོ་ཞེས་དགོངས་པའོ།",
    "ཟླ་བ་གཉིས་ཀྱི་ཤེས་པ་ནི་བརྒྱུད་ནས་རྣམ་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རྣམ་པར་འགྱུར་བའི་ཕྱིར་ཡིད་ཡིན་པས་ཐུག་པ་མེད་དོ།",
    "ཟླ་བ་གཉིས་ལ་སོགས་པའི་ཞེས་གསུངས་སོ།",
    "མིག་རབ་རིབ་ཅན་གྱིས་བསྒྲིབས་ཏེ་རང་བཞིན་གཞན་དུ་རྣམ་པར་འགྱུར་བ་དང་ལྡན་པར་གྱུར་པ་ེན་ཡང་ནག་པོ་ལ་སོགས་པའི་རང་བཞིན་ཡོད་པ་ཁོ་ནའོ།",
    "དཔེ་ཅི་ལྟར་འགྱུར་བསྒྲུབ་བྱས་སྟོང་པའི་ཕྱིར་རོ་ཞེས་དགོངས་པའོ།",
    "དེ་ཡང་ན་ཡོད་པ་དང་ཞེས་བྱ་བའོ་། ནག་པོ་ལ་སོགས་པར་སྣང་བ་ཉིད་ཀྱང་ངོ།",
    "དེ་ལྟ་ཡིན་དང་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་ཡིན་ནའོ།",
    "གཞན་དག་ཡིད་ཡིན་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་དང་བཅསཔ་དང་ིའདོད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་ཤེས་སྙམ་ན།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་མ་ཡིན་ན་འདི་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་མི་འགྱུར་རོ་ཞེས་དགོངས་པའོ།",
    "གལ་ཏེ་གོམས་པས་སྐྱེད་པ་སྒྲུབ་པ་ེལ་སོགས་པ་འཁྲུལ་པ་ཡང་རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་ལ།",
    "སྦྲུལ་དུ་འཁྲུལ་པའི་ཡིད་རྣམ་པར་རྟོག་པ་དང་བཅས་པ་དང་ཆུ་ལ་སོགས་པ་འཁྲུལ་པ་གང་ཡིན་ཞེ་ན།",
    "འདི་ལ་བརྗོད་པ་ནི་ཕན་འདོགས་པར་བྱེད་པ་དང་།",
    "གནོད་པར་བྱེད་པར་སྣང་བ་ནི་རྣམ་པར་རྟོག་པའི་རང་བཞིན་དེས་ཀྱང་༤འཁྲུལ་པ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "སློབ་དཔོན་གྱིས་མངོན་སུམ་ལྟར་སྣང་བ་རྣམ་པ་གཉིས་ཉིད་བསྟན་ཏོ་ཞེས་བྱ་བར་ཇི་ལྟར་ཤེས་སྙམ་ནའོ་ཞེས་བྱ་བས་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་རྣམ་པ་གཉིས་སུ་མི་བཞེད་ནས་ཞེས་ལོགས་ཤིག་ཏུ་གཅོད་པར་སྟོན་པ་ནི།",
    "ཡིད་གཉིས་ཡིན་པར་བཞེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ན་དོན་སྨོས་པ་ཉིད་དེ་གསལ་བའི་ཕྱིར་འཁྲུལ་པ་ནི་ཡིད་ཀྱི་ཡུལ་ཅན་ཁོ་ནར་རྣམ་པར་གནས་སོ་ཞེས་དགོངས་པའོ།",
    "གཞན་མངོན་སུམ་མ་ཡིན་པར་འདོད་པ་ལ་ཡང་ཡོད་པ་ཡིན་ཏེ།",
    "དེས་ན་དེ་ནི་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ནི་བརྗོད་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "གཞན་ནི་ཞེས་བྱ་བ་ནི་ཞེན་པའི་བདག་ཉིད་ནི་མངོན་སུམ་མ་ཡིན་ནོ་ཞེས་རྣམ་པ་དེ་ལྟར་རྣམ་པར་གཅད་པར་བྱ་བ་ཉིད་དུ་འཐད་དོ། ། ཅུང་ཟད་ནི་ཞེས་བྱ་བ་ནི་ཞེན་པའི་བདག་ཉིད་ཅེས་བྱ་བ་འདིའོ།",
    "ངོ་བོ་བརྗོད་པ་ལ་ཡང་མ་འཁྲུལ་པ་ཉིད་བརྗོད་པར་རིགས་སོ།",
    "འདི་ལ་སུན་འབྱིན་པ་གཞན་ཡང་བརྗོད་པའི་དོན་དུ་རྣམ་པར་རྟོག་པ་གཉིས་བྱེད་པ་ནི།",
    "དོན་གཞན་བསྒྲུབ་པའི་དོན་དུ་ངོ་བོ་བརྗོད་པ་ཡིན་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་གཉིས་པའོ།",
    "དེའི་ཚེ་ཡོད་པ་དང་ཕྲད་པའི་ཤེས་པ་ནི་མངོན་སུམ་ཡིན་ནོ་ཞེས་བྱ་བ་ཉིད་བརྗོད་པར་བྱ་བར་འགྱུར་གྱི།",
    "དེ་ལྟ་ཡིན་དང་དོན་གང་ཞིག་རྣམ་པར་གནས་པ་སྟེ་བརྗོད་པ་ནི་ཡོད་པའི་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པ་འགོད་པ་ནི་ཅི་སྟེ་ཞེས་བྱ་བའོ།",
    "འཕྲོག་པར་མི་ནུས་སོ།",
    "གང་ཞིག་སྣང་བའི་རྣམ་པར་རིག་པ་དེ་ནི་དེ་ལས་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "འདི་སློབ་དཔོན་གྱིས་ཇི་ལྟར་གསུངས་ཞེས་བྱ་བ་ནི་ཕྱོགས་སྔ་མའོ།",
    "རྣམ་པར་དཔྱོད་པ་སྟོན་པ་ནི་དོན་དེ་ལས་ཞེས་བྱ་བའོ།",
    "དེ་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི་རྡུལ་ཕྲ་རབ་དག་ཉིད་ཅེས་བྱ་བའོ།",
    "རྡུལ་ཕྲ་རབ་དག་ཉིད་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
    "ད་ནི་ཕྱེད་སྔ་མ་རྣམ་པར་འགྲེལ་པ་ནི་ཅི་སྟེ་ཞེས་བྱ་བའོ།",
    "ཚོགས་པར་སྣང་བའི་དངོས་པོ་ནི་ཕྱི་རོལ་གྱི་དོན་མ་ཡིན་པ་ནི་དེས་ན་དེ་ཅི་ལྟར་དེས་སྐྱེད་ིཔ་ཡིན་ཡིན་དུ་ཆུག་པ་དེ་ལྟ་ན་ཡང་འཁྲུལ་པའི་ཤེས་པས་མ་ངེས་པ་ཉིད་དོ།",
    "འོན་ཏེ་ཤེས་པ་གཞན་གྱིས་སྔར་ཡོད་པ་འཛིན་ན་དེའི་ཚེ་ཤེས་པ་དེ་ཡང་མངོན་སུམ་ཡིན་པར་བརྗོད་པར་བྱ་བ་ཡིན་ལ།",
    "དེས་ན་ཤེས་པ་དེ་ནི་གང་ཡིན་པ་དེ་ཡང་གཞན་གྱིས་ཡོད་པར་ཤེས་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེས་ན་ཕན་ཚུན་བརྟེན་པར་མི་འགྱུར་རོ་སྙམ་ན།",
    "མངོན་སུམ་དང་ནི་ཞེས་གསུངས་སོ།",
    "ཤེས་པ་མེད་པར་མཚོན་མ་ཡིན།",
    "འཇུག་པར་འདོད་པས་ཞེས་བྱ་བའོ།",
    "རྣ་བ་ལ་སོགས་པའི་འཇུག་པ་མ་ཤེས་པར་མཚན་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་གང་ལས་ཤེ་ན།",
    "མ་རྟོགས་པར་ཅི་ལྟར་ཞེས་བྱ་བའོ།",
    "མཚན་ཉིད་ནི་འཇུག་པར་བྱེད་པ་ཡིན་པར་བརྗོད་པར་བྱས་པ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "རྣ་བ་ལ་སོགས་པ་ནི་འཇུག་པ་འཛིན་པར་བྱེད་པའི་མངོན་སུམ་ཡང་ངོ།",
    "རྣམ་པར་གཞག་ེཔར་བྱ་བ་འདོད་པའི་དོན་གང་ཡིན་པ་དེ་བཞིན་དུའོ།",
    "༢ བཞག་པ་བཞིན་དུ་རྣམ་པར་གཞགཔར་འོས་པ་ཡང་རྣམ་པར་མི་གཞག་པར་འགྱུར་རོ།",
    "ོརྣམ་པར་བཞག་པ་དང་རྣམ་པར་མ་བཞག་པའི་དོན་དག་ལ་ཡོད་པ་ཙམ་ལས་མ་རྟོགས་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པ་གཅོད་པར་བྱེད་པའི་ལས་སོ།",
    "དེའི་ཚེ་དེའི་ཁྱད་པར་ཅན་གྱི་དོན་དེ་ཡང་ངས་མ་ཤེས་པ་ཁོ་ནར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་དེ་ཡང་དོན་དེའི་རྟོགས་པར་བྱེད་པ་པོའི་བདག་མི་ཤེས་ཇི་ལྟར་ལོངས་སྤྱོད་པ་ཤེས་དེ་ལྟར་ཞེས་བྱ་བ་ནི།",
    "བདེ་བ་ལ་སོགས་པ་ཞེས་གསུངས་སོ།",
    "བློས་ཞེན་པར་བྱ་བའི་དོན་སྐྱེས་བུས་སེམས་པར་བྱེད་པ་དེས་ན།",
    "ཁྱད་པར་མེད་པ་ཉིད་བརྗོད་པ་ནི།",
    "ཕ་རོལ་པོ་ཁྱད་པར་སྟོན་པ་ནི་དེའི་ཚེ་ཞེས་བྱ་བའོ།",
    "རིག་པར་བྱེད་པར་བརྗོད་ན།",
    "ཡུན་རིང་པོ་མ་ཡིན་པའི་དོན་གྱི་རྣམ་པར་རྟོགས་སོ།",
    "གལ་ཏེ་བློ་མེད་ན་དེའི་དོན་གྱི་རྣམ་པ་མ་བསྟབས་པའི་ཕྱིར་ན་ཉེ་བར་གནས་པ་ཉིད་དུ་མ་ིརྟོགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདི་ལ་བརྗོད་པ་ནི་བདག་ཁྱབ་པར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་བློས་དོན་གྱི་རྣམ་པ་སྟོབས་ན་དེའི་ཚེ་ཡུལ་ཐག་རིང་པོ་ཞེས་བྱ་བར་རྟོགས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "མི་༢ཟླ་རྩ་ཁ་ཐབས་གཞན་དུ་འཕོས་པ་ཁོ་ན་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "དེས་ན་བློ་ནི་གདོན་མི་ཟ་བ་ཁོ་ནར་ཤེས་གཞན་གདོན་མི་ཟ་བ་ཁོ་ནར་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "དེའི་ཚེ་འཕོས་པའི་དོན་ཅི་ཡིན་དེའི་རྣམ་པ་ཅན་གྱི་བློ་སྐྱེ་བའི་སྒོ་ནས་རྣམ་པར་འགྱུར་བ་ཉིད་འཕོས་པའི་དོན་ཡིན་གྱི་གཞན་ནི་མེད་དོ་ཞེས་དགོངས་པའོ།",
    "༦༣༧ཁོ་ན་སྟེ་དེས་ན་རྣམ་པར་འགྱུར་བ་ཉིད་དེར་འཕོས་པའི་དོན་དུ་བརྗོད་པར་བྱ་བ་ཡིན་ན་། འདིར་ཡང་ཞེས་བྱ་བ་ནི་ཕ་རོལ་པོའིའོ།",
    "དེ་ལ་ཡང་རྣམ་པར་འགྱུར་བ་ཅི་ཡང་མེད་ལ།",
    "དེ་བཞིན་དུ་སྐྱེས་བུ་ལ་རྣམ་པར་འགྱུར་བ་མེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ཉིད་ཀྱང་འཁྲུལ་པར་འགྱུར་ཞེ་ན།",
    "འདི་བསྟན་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཾདེས་ན་དེ་ཐ་དད་པ་ལས་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པ་རྣམ་པར་གནས་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཕ་རོལ་གྱི་བསམ་༦པའོ།",
    "དོན་སོ་སོར་ངེས་པ་རྣམ་པར་འཇོག་པར་བྱེད་པ་མ་ཡིན་པའི་མཚན་ཉིད་ཀྱི་སྐྱོན་དེ་ཉིད་དུ་འགྱུར་རོ།",
    "རིག་པར་བྱེད་པ་ཉིད་དུ་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ཤེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཡང་ན་གང་དུ་སྣང་བ་ལ་སོགས་པ་ཡོད་པ་དེརམིག་ལ་སོགས་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་དུ་སྣང་བ་ཤེས་པར་བྱེད་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ལན་འདེབས་པ་ནི།",
    "རྣམ་པ་ལས་སྒྲུབ་པར་བྱེད་པ་གཞན་ཡིན་ན།",
    "དེ་ལྟར་རྣམ་པར་རྟོག་པ་གསུམ་ལས་དང་པོ་ལ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་མངོན་དུ་བྱེད་པར་གྲངས་པར་ཡིན་ཏེ།",
    "དོན་དེ་ཞེས་བྱ་བ་ནི་ཤེས་པ་མངོན་དུ་བྱས་པ་ན་གཞན་མངོན་དུ་བྱས་པར་ནི་མི་འགྱུར་རོ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པའི་སུན་འབྱིན་པ་ཁ་སྐོང་དང་བཅས་ཏེ།",
    "བདེ་བ་ལ་སོགས་པའི་ཞེས་གསུངས་སོ།",
    "དེའི་ཁྱད་པར་ལས་ཞེས་བྱ་བ་ནི་བདེ་བ་ལ་སོགས་པའི་རྣམ་པའི་ཁྱད་པར་ལས་སོ།",
    "སྔོན་པོ་ལ་ཞེས་གསུངས་སོ།",
    "མཚུངས་པར་ཞེས་བྱ་བ་ནི་མི་མཐུན་པ་ཉིད་དུའོ།",
    "སྐྱེས་བུའི་ཞེས་གསུངས་སོ།",
    "རྒྱུ་དེས་ན་ཤེས་པ་དེ་སྔོན་པོ་ལས་ཐ་དད་པར་གཞག་ེཔ་ཡིན་ནོ།",
    "དེ་ཡང་ཞེས་བྱ་བ་ནི་ཐ་དད་པ་དང་བྱེད་པ་དང་བཅས་པར་རྣམ་པར་འཇུག་པའི་རིགས་པ་ཡང་ངོ།",
    "ཐོག་མེད་ཅེས་གསུངས་སོ།",
    "ཀུན་གྱིས་དམིགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་ནི་ཞེས་བྱ་བ་སོ་སོར་ངེས་པའི་དོན་རྣམ་པར་གནས་པ་ལའོ།",
    "བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ཙམ་ནི་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ནོ།",
    "ངེས་པ་ིན་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་དེ་ནི་ཡོད་ཀྱང་དེ་ལ་ཞེས་བྱེད་པ་པོ་དེ་རྣམས་ཀྱི་ནང་ནས་གང་ཞིག་བྱ་བ་ལ་ཆོད་པ་མེད་པ་དེ་ཉིད་སྒྲུབ་པར་བྱེད་པ་དམ་པ་སྟེ་བྱེད་པ་ཡིན་ནོ།",
    "མ་ཐོབ་ན་ཞེས་བྱ་བ་ནི་མི་ལྡན་ན་དེའི་ཚེ་དེའི་རྣམ་པ་ཅན་གྱི་ཞེས་བྱ་བ་ཡུལ་ཐག་རིང་བ་ལ་སོགས་པར་གནས་པའི་དོན་རྣམ་པར་མི་གནས་སོ།",
    "དེ་དང་བར་མ་ཆོད་པ་ཞེས་བྱ་བ་ནི་རྣམ་པ་དང་བར་མ་ཆོད་པར་འགྱུར་བའོ",
    "ཞེས་བྱ་བ་དོན་ཡོངས་སུ་གཅོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཤེས་པ་དེའི་རྣམ་པའི་ཁྱད་པར་གང་ཡིན་པ་དེ་ལས་མྱོང་བའི་ཡུལ་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་རྣམ་པ་ངེས་པས་གྲུབ་ན་ནི་དེའི་ཚེ་དོན་དེ་ཉིད་དོན་རྣམ་པར་འཇོག་པ་ཡིན་ཏེ།",
    "དོན་གནས་པ་གྲུབ་ཟིན་པ་ལ་ཉམས་པ་མེད་པས་ཅི་ཞིག་རྒྱས་པར་བྱེད།",
    "རྣམ་པར་གནས་པ་ལ་མཁོ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་གྲུབ་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་ངེས་པ་གྲུབ་ནའོ།",
    "གལ་ཏེ་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་ཁྱད་པར་རྟོགས་པ་ཡོད་པ་ཉིད།",
    "སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་ཁྱད་པར་ཡོད་ནའོ།",
    "དེ་ལས་བཟློག་པར་ཞེས་བྱ་བ་ནི་ཁ་དོག་དང་དབྱིབས་ཀྱི་བདག་ཉིད་ལས་བཟློག་པར་རོ།",
    "ཉམས་སུ་མྱོང་བ་ཞེས་གསུངས་སོ།",
    "འོ་ན་གསལ་བཞིན་པ་ནི་ཤེས་པ་ཡིན་པའི་ཕྱིར་༧དོན་ཞེས་བྱ་བ་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཞེས་གསུངས་ཏེ།",
    "ཤེས་པའི་རང་བཞིན་ནི་༧མ་ཡིན་ནོ་སྙམ་ན་གལ་ཏེ་ཞེས་གསུངས་སོ།",
    "དོན་ནི་ཞེས་གསུངས་སོ།",
    "སད་པར་མཐོང་བའི་རྣམ་པའོ།",
    "བག་ཆགས་ཀྱི་ཞེས་གསུངས་སོ།",
    "འདི་ལ་བརྗོད་པ་ནི་ཐ་མི་དད་པར་ཞེས་བྱ་བའོ་། དེ་ནི་ཞེས་བྱ་བ་ཐ་མི་དད་པར་དམིགས་པའོ།",
    "རྣམ་པ་ལས་འདས་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པ་ལ་མིལྟོས་པར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "༦༤༥བྱ་བ་ནི་ཁྱད་པར་གྱི་བློ་བཞིན་ནོ།",
    "དེ་དག་ཀྱང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ལ་སོགས་པའི་ཤེས་པ་ཡང་ངོ།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་ཅན་མ་རྟོགས་པར་ཇི་ལྟར་མི་འཛིན་སྙམ་ན།",
    "དེའི་རང་བཞིན་ལ་ཞེས་གསུངས་སོ།",
    "ཁྱད་པར་ཅན་ལ་བརྟེན་པའི་རང་བཞིན་གང་ཡིན་པ་དེ་མ་བཟུང་བར་ཁྱད་པར་འཛིན་པར་ཅིར་འགྱུར།",
    "ཁྱད་པར་མ་བཟུང་བར་ནི་དེ་ལ་བརྟེན་པ་ཉིད་འཛིན་པ་མི་སྲིད་ལ་ཁྱད་པར་ཅན་གྱི་བློས་མི་འཛིན་ནོ་ཞེས་དགོས་པའོ།",
    "དེའི་རྣམ་པ་ཞེས་བྱ་བ་ཁྱད་པར་ཅན་ལ་བརྟེན་པའི་རང་བཞིན་འཛིན་ན་ཡང་ངོ།",
    "དེ་ཉིད་ཀྱི་ཚེ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་བློའི་དུས་ཉིད་དུའོ།",
    "དེ་འཛིན་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི།",
    "ཁྱད་པར་འཛིན་པར་བྱེད་པའི་བློ་གང་ཡིན་པ་དེས་བསྐྱེད་པའི་འཛིན་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་གཟུང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "དེའི་དུས་སུ་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་འཛིན་པའི་དུས་སུ་ཡང་ངོ།",
    "ཤེས་པ་སྔ་མ་དང་ཕྱི་མ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དཀར་པོ་ལ་སོགས་པ་དང་ལྡན་པར་འགྱུར་བའི་བུམ་པ་དང་འབྲེལ་པ་ཡིན་ན།",
    "དེས་ན་ཇི་ལྟར་འབྱོར་པའི་འདུ་བའི་འབྲེལ་པ་ལས་གཟུགས་རྟོགས་པར་འགྱུར་རོ།",
    "གསལ་བ་ཉིད་བརྗོད་པར་༤ནི་ཇི་ལྟར་ཞེས་བྱ་བའོ།",
    "མི་འཛིན་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི་དབྱིབས་ཙམ་ཡང་འཛིན་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟ་བུར་གྱུར་པར་ཞེས་བྱ་བ་ནི་ལ་ལར་ནི་འགྱུར་ལ་ིལར་ནི་མ་ཡིན་པའོ་ཞེས་བྱ་བར་རོ།",
    "དབྱིབས་རྟོགས་པ་ན་༧ཁ་དོག་ཀྱང་རྟོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་དགོངས་པའོ།",
    "རྟོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་མུན་པར་རོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་སྣང་བ་ལ་མུན་པར་རྟོགས་༤པ་ནིའོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་རྣམ་པར་གནས་པ་ནའོ།",
    "སོ་སོར་རིག་ཅེས་བྱ་བ་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི་གལ་ཏེ་སོ་སོར་ཞེས་བྱ་བའོ།",
    "རྐང་པ་དང་པོ་འཆད་པར་བཞེད་པས་གྲུབ་པའི་མཐའ་པས་གསུངས་པ་ནི།",
    "བདེན་པའི་བུམ་པ་ལ་སོགས་པར་འདོད་པ་ལ་ཡང་ཉམས་སུ་མྱོང་བར་བྱ་བ་མེད་བཞིན་དུ་དེ་ལྟར་འགྱུར་བ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "འོན་ཀྱང་ཉམས་སུ་མྱོང་བ་འདི་ཕྱི་རོལ་གྱི་དོན་གྱི་ཡིན་ནོ་ཞེས་དོན་དང་ལྷན་ཅིག་འབྲེལ་པར་ནི་མཐོང་བ་མེད་དོ།",
    "ཇི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེས་ན་ཇི་ལྟར་མངོན་སུམ་མེད་པར་རྗེས་སུ་དཔག་པ་རྡུལ་ཕྲ་རབ་ཀྱི་སྒྲུབ་བྱེད་དུ་འགྱུར།",
    "འོན་ཀྱང་འདི་ལ་ཉེས་པ་ལྷག་པར་བརྗོད་པར་བྱ་བ་ཡིན་ནོ་ཞེས་སྡུད་པས་གཞན་ཡང་ཞེས་སྨོས་པར་ཟད་དོ།",
    "བུམ་པ་ལ་སོགས་པ་རིགས་མཐུན་པའི་དོན་ཡང་ཕན་ཚུན་རིགས་པར་འགྱུར་ལ་དེ་བཞིན་དུ་རྒྱུད་ཐ་དད་པ་ལ་ཡོད་པའི་སྔོན་པོའི་ཡུལ་ཅན་གྱི་མྱོང་བ་རྣམས་ཀྱང་ངོ་།",
    "སྔོན་པོར་སྣང་བའི་ཤེས་པ་དེའི་ཡུལ་ནི་དང་པོར་སྐྱེས་པའི་སྔོན་པོ་ཉམས་སུ་མྱོང་བ་ཡིན་པར་འགྱུར་རོ།",
    "ཡང་ཇི་ལྟར་འདི་ལ་ལན་བཏབ་པ་སྙམ་ན་བར་དུ་ཞེས་གསུངས་སོ།",
    "༦༥༡རྣམ་པར་རྟོག་པ་རྣམས་ེགང་ཞིག་གོམས་པ་ལས་དེ་མ་ཐག་ཏུ་གསལ་བའི་རྣམ་པ་ཅན་སྐྱེད་པར་བྱེད་པ་དེ་ཡུལ་དུ་འགྱུར་རོ།",
    "ཞེས་འཆད་པར་འགྱུར་བ་དང་འབྲེལ་ཏོ།",
    "ཇི་ལྟར་ངེས་པ་ལས་དོན་རྣམ་པར་གནས་ཤེ་ན།",
    "དེ་ལྟ་ན་ཡང་ཇི་ལྟར་ངེས་པ་ལས་དོན་རྣམ་པར་གནས་ཤེ་ན།",
    "དོན་ཉམས་སུ་མྱོང་བ་ཞེས་གསུངས་སོ།",
    "མངོན་སུམ་དེ་ལས་གཞན་པའི་རྣམ་པར་རྟོག་པ་དེ་བས་ཞན་པའི་དོན་དེ་མཐོང་ངོ་ཞེས་བྱ་བ་འདི་ནི་གཟུ་ལུམས་ཡིན་ནོ་། དེ་དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་དོན་ཉམས་སུ་མྱོང་བ་ནི་མ་ཡིན་གྱི།",
    "བདག་ལ་སོགས་པར་ངེས་པ་བཞིན་ནོ།",
    "གལ་ཏེ་བལྟ་བའི་ཤེས་པ་རྣམ་པར་འབྱེད་པར་མི་བྱེད་ན།",
    "སླར་བཟློག་པ་རྣམ་པར་བརྗོད་པ་ནི་དོན་ལ་ཞེས་བྱ་བའོ། ། གཞན་གྱིས་རྣམ་པ་འདི་ལྟ་བུའི་འདྲི་བ་ནི་ཞེས་སྨྲས་སོ།",
    "དརྐང་པ་གཉིས་པ་འཆད་པར་ནི་འདིས་ཞེས་བྱ་བའོ།",
    "འོ་ན་ཇི་ལྟར་མངོན་སུམ་གྱིས་རིག་པར་བྱ་བ་ཉིད་ཡིན་སྙམ་དུ་དོགས་པ་བསུ་ནས་ཕྱེད་ཕྱི་མ་འཆད་པ་ནི།",
    "ཤེས་པ་ལྐོག་ཏུ་གྱུར་པ་གང་ཡིན་པ་དེ་ཉིད་ཀྱིས་ཉམས་སུ་མྱོང་བ་གང་ཡིན་པ་ཉིད་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "མངོན་དུ་བྱེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "ཁྱེད་ནི་རྣམ་པར་ཤེས་པར་སྨྲ་བ་ཡིན་ན།",
    "སྣ་ཚོགས་པའི་རྣམ་པ་མྱོང་བའི་རྒྱུའི་ཕྱིར་མེད་པར་མི་འཐད་དོ།",
    "གང་ཞིག་ཅེས་གསུངས་སོ།",
    "རྣམ་འགྲེལ་ལ་འཇུག་པར་བྱེད་པ་ནི་ཇི་ལྟར་ཞེས་བྱ་བའོ།",
    "མི་གསལ་བའི་ཕྱི་རོལ་ཡང་མིག་དང་སྒྲོན་མ་ལ་སོགས་པ་ལས་གསལ་བའི་རང་བཞིན་དུ་སྐྱེ་བའི་ཕྱིར་སྒྲོན་མས་གསལ་བར་བྱེད་དོ་ཞེས་བརྗོད་པ་ཇི་ལྟ་བ་བཞིན་དུ་མིག་ལས་ཀྱང་ཤེས་པ་གསལ་བའི་རང་བཞིན་ཉིད་སྐྱེ་བ་ཡིན་ནོ་ཞེས་འདོད་པར་བྱའི།",
    "དོན་དམ་པར་ནི་གཞན་གྱིས་གསལ་བ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "༢ཌ་གཉིས་ཡིན་ལ་གཞན་པ་དག་ལ་ནི་ཤེས་པར་བྱ་བ་ཤེས་པ་ལ་ནི་ཡང་ནའོ།",
    "འོན་ཏེ་རང་བཞིན་དང་༤ཡང་འགལ་བར་འགྱུར་ན་དེའི་ཚེ་འདི་ནི་ཐམས་ཅད་སྙམ་པར་དེ་འཇིགས་པར་བྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་འགལ་བ་མེད་ན་འོ་ན་རལ་གྲིའི་སོ་ཡང་བདག་ཉིད་ཀྱིས་གཅོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེའི་ཚེ་འཐད་པར་འགྱུར་གྱི་ཞེས་བྱ་བ་རང་ཉིད་གསལ་བ་སུན་འབྱིན་པའོ།",
    "དོན་དེ་མ་ཐག་གསལ་བ་ནི་དེས་དོན་གཞན་གསལ་ལོ་ཞེས་བྱ་བའི་བརྗོད་པར་མི་འགྱུར་རོ།",
    "གསལ་བྱེད་ཅེས་བྱ་བ་ནི་གསལ་བྱེད་དུ་འདོད་པ་ེིནི་ཤེས་པ་དག་གསལ་བ་ཉིད་དུ་ཁྱད་པར་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་།",
    "དེ་ལས་ནི་དོན་ལ་རིམ་གྱིས་རྟོགས་པ་རྟོགས་པ་ཉིད་ཁྱད་པར་ཡོད་པའོ།",
    "གསལ་བའི་རང་བཞན་ཉིད་དུ་སྐྱེས་པར་ཅི་སྟེ་ང་མི་འདོད་ན།",
    "རྣམ་པ་ཐམས་ཅད་དུ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ཀྱི་ཚེ་རིག་པར་རོ།",
    "དེས་ན་རིག་པར་བྱ་བ་ནི་ལྐོག་ཏུ་གྱུར་པ་ཡང་འཐད་པ་ཡང་འཐད་པ་ཡིན་ནོ།",
    "ཤེས་བྱ་དག་ཁྱད་པར་འགའ་ཡང་མེད་པར་འགྱུར་རོ།",
    "དེས་ན་ཕྱི་རོལ་གྱི་དངོས་པོ་རིག་པར་བྱ་བ་མ་ཡིན་པ་ཡང་༤སྤོང་བ་ཁོ་ནའོ་ཞེ་ན།",
    "རིག་བྱ་མིན་ལ་ཞེས་བྱ་བ་ནི་རིག་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་རྟོགས་སོ་ཞེ་ན།",
    "བརྗོད་པ་རིག་པར་བྱ་བ་ཉིད་མེད་ན་རིག་པ་ཉིད་དུ་ཇི་ལྟར་འགྱུར།",
    "ཡང་ན་མངོན་སུམ་གྱིས་རྟོགས་པར་བྱ་བ་ཉིད་འབའ་ཞིག་ཡོད་དོ་ཞེས་བྱ་བའི་ཕྱོགས་ལ་ཡང་ཉེས་པ་མེད་དོ་ཞེས་སྟོན་པ་ནི།",
    "མ་རྟོགས་པ་ཞེས་གསུངས་སོ།",
    "རང་བཞིན་ཐ་དད་པར་ཅི་ལྟར་འགྱུར་ཏེ།",
    "ཡང་ཇི་ལྟར་ཐ་དད་པར་མི་འཐད་སྙམ་ན།",
    "རྟོགས་པའི་ཞེས་གསུངས་སོ།",
    "དེས་ན་རྟོགས་པའི་དབྱེ་བས་ཐ་དད་པར་འགྱུར་དགོས་སོ།",
    "འདི་ལ་བརྗོད་པ་ནི་ཤེས་པ་ལས་དོན་གཞན་ཡོད་པར་ག་ལ་འགྱུར།",
    "ཤེས་པ་དེ་ལས་གཞན་པར་ག་ལ་འགྱུར་ཏེ།",
    "༦༥༩དང་དོན་ཐ་དད་པར་སོ་སོར་རྟོགས་སོ་ཞེ་ན།",
    "དེས་ན་ཇི་ལྟར་རྗེས་སུ་དཔག་པར་འགྱུར།",
    "ཁྱབ་པར་བྱེད་པའི་དོན་མེད་པར་ཁྱབ་པར་བྱ་བའི་ཤེས་པ་ཡོད་པར་ཇི་ལྟར་༤འདི་ལ་བརྗོད་པ་ནི་མ་རྟོགས་པའོ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དེའི་དུས་བར་མ་རྟོགས་ན་འོ་ན་སྔར་ཁྱབ་པར་བྱེད་པ་ཉིད་དུ་ཇི་ལྟར་རྟོགས་ཡུལ་དང་དུས་རང་བཞིན་ཁྱབ་པའི་ཕྱིར།",
    "ཁྱབ་པར་བྱེད་པ་ཉིད་དུ་འགྱུར་བ་ཡིན་ནོ།",
    "གལ་ཏེ་དེའི་དུས་མ་རྟོགས་ན་དེའི་ཚེ་ཇི་ལྟར་ཁྱེད་ཁྱབ་པར་བྱེད་པ་ཉིད་དུ་འགྱུར།",
    "དེ་ལས་ཁྱབ་པར་བྱེད་པ་ཉིད་དུ་ཇི་ལྟར་རྟོགས་དེས་ན་སྔར་ཡང་རྟོགས་པ་ཙམ་ཁོ་ན་ཡིན་གྱི།",
    "དེ་ལྟར་ན་ཡང་དེའི་དོན་གྱིས་ཁྱབ་ེཔར་ཇི་ལྟར་འགྱུར།",
    "༢ ཎྜབྱ་བ་ནི་ངོ་ཤེས་པའི་སྟོབས་ཀྱིས་རྣམ་པར་རིག་པ་ཙམ་བཟློག་པ་ཉིད་སྟོན་པའོ།",
    "དེ་ཉིད་བརྗོད་པ་ནི་གལ་ཏེ་མྱོང་བ་མིན་ཞེས་བྱ་བ་ནི་བར་ན་ཡོད་པ་ཞེས་བྱ་བའི་སྔར་གྱི་མཐོང་བ་དང་ཕྱིས་ཀྱི་མཐོང་བ་གཉིས་ཀྱི་དབུས་ན་ཡོད་པའི་མ་རྟོགས་པ་གང་ཡིན་པ་༤མེད་པར་རོ།",
    "འོན་ཏེ་ཞེས་བྱ་བས་དོགས་པ་བསུ་ནས་སྤྱི་ཉིད་ཅེས་གསུངས་ཏེ།",
    "ངོ་ཤེས་དེ་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "འོན་ཏེ་ངོ་ཤེས་པར་དམིགས་པ་ཉིད་དུ་ནི་མཐོང་བ་ཁོ་ནའོ་སྙམ་ན།",
    "གལ་ཏེ་ཉམས་ན་ཞེས་བྱ་བ་ནི་འདས་པ་ལ་མངོན་སུམ་ཉིད་མེད་པར་རྣམ་པར་ཤེས་པ་ཉིད་ལས་ཉམས་པར་འགྱུར་ན།",
    "དེའི་ཚེ་འདས་པའི་དོན་ཡང་ད་ལྟར་གྱི་དུས་སུ་དོན་ཉིད་ལས་ཉམས་པར་འགྱུར་རོ།",
    "ཊདེའི་རྣམ་པ་ཅན་གྱི་ཤེས་པ་གང་ཡིན་པ་དེའི་སྐྱེད་པར་བྱེད་པ་ཡིན་ན།",
    "རྣམ་པར་ཤེས་པ་ནི་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་ལུས་ཅན་ཉིད་མ་ཡིན་ནོ།",
    "ཕྱི་རོལ་ཁྱད་པར་མེད་ཀྱང་བསྒོམས་པའི་ཁྱད་པར་གྱིས་ཤེས་པ་གསལ་བ་ལ་སོགས་པའི་ཁྱད་པར་དུ་གྱུར་པའི་རྒྱུའི་ཕྱིར།",
    "མེད་པར་རིག་པ་ནི་གཞོན་ནུ་མ་ལེན་པ་རྣམས་ཀྱིའོ།",
    "མེད་པར་སྣང་བ་ནི་རིགས་པ་ཅན་ལ་སོགས་པ་༦༦༢།",
    "འོན་ཏེ་བག་ཆགས་ལ་བརྟེན་ནས་འགའ་ཞིག་ཁོ་ན་དམིགས་ཀྱི་ཐམས་ཅད་ནི་མ་ཡིན་ནོ་ཞེས་བརྗོད་ན་དེ་ལ་བརྗོད་པ་ནི་བག་ཆགས་ཀྱི་སྟོབས་ནི་རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་ཡང་མཚུངས་ཏེ།",
    "དེས་ན་རྣམ་པར་ཤེས",
    "ཕྱིན་ཅི་ལོག་ཏུ་སྣང་བའི་ཕྱོགས་ལ་ཡང་མཚུངས་པར་སྟོན་པ་ནི་ཕྱིན་ཅི་ལོག་ཏུ་ཞེས་བྱ་བའོ།",
    "སྐྱེད་བྱེད་མེད་པར་བག་ཆགས་དེ་ག་ལས་ཡིན།",
    "བག་ཆགས་དེ་ནི་དེའི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་ཕྱི་མ་སྐྱེད་པར་བྱེད་པ་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོ་ན་རང་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཅིག་ཅར་འཇུག་པར་འགྱུར་རོ་ཞེ་ན་སད་བྱེད་ཅེས་སྨོས་སོ།",
    "མི་འདོད་པར་སྣང་བར་ཤེས་པ་གང་ལ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ལས་ནི་རྣམ་པར་ཤེས་པ་སྔ་མ་ལས་སོ།",
    "དེ་མ་ཐག་པའི་རྐྱེན་གྱིས་ནི་རྨི་ལམ་ལ་སོགས་པ་སྔ་ན་མེད་པར་སྐྱེད་པ་མ་ཡིན་པ་དེས་ན།",
    "འདི་ལ་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ་ ། དེའི་རྣམ་པར་རྟོག་པ་གཞན་ཉིད་སྐྱེ་བ་ཞེས་བྱ་བ་འདི་ཉིད་དོན་ཡིན་གྱི།",
    "དེ་ཉིད་ཀྱིས་ནི་ཉམས་སུ་མྱོང་བའིའོ་། འདི་ཁོ་ན་ལྟར་དམིགས་པ་ཞེས་བྱ་བ་ནི་རྨི་ལམ་དུ་མཐོང་བ་དང་སད་པར་མཐོང་བའི་ཤེས་པ་དག་གོ།",
    "ཐོག་མ་མེད་པའི་ཞེས་གསུངས་སོ།",
    "༢ བག་ཆགས་ཐ་དད་པར་བྱེད་པ་ལ་ཡང་ཉེས་པ་ན་དེ་ལ་ཞེས་བྱ་བ་སྟེ།",
    "གཟུང་བ་ཐ་དད་པར་ནི་སྐྱེད་པར་མི་འགྱུར་རོ།",
    "དྲན་པ་ཙམ་ཉིད་ཀྱི་གཟུང་བའི་རྣམ་པར་བསྐྱེད་པར་ནི་མ་མཐོང་ངོ།",
    "དེའི་འདོད་པ་ཅན་གྱི་འདོད་ལྡན་མ་གོམས་པས་མངོན་དུ་བྱས་པ་ཅི་སྟེ་མི་འཐོབ་སྙམ་ན།",
    "གཞན་ཉིད་ཡིན་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་ལྟ་མ་ཡིན་ན་སྔོན་པོའི་རྣམ་པ་ལ་ཡང་སེར་པོའི་རྣམ་པ་ཉིད་སྔོན་པོའི་རྣམ་པ་ཉིད་དུ་སྣང་བའི་ཕྱིར་དངོས་པོ་འགའ་ཡང་རྣམ་པར་གནས་པ་མེད་པར་འགྱུར་རོ།",
    "ཡུལ་དང་དུས་གཞན་༧ མ་ཡིན་པའི་ཕྱིར་གསུངས་སོ།",
    "ཡུལ་དང་བརྟེན་པ་དེ་གཉིས་དམིགས་ན་ཤེས་པ་དམིགས་པ་མེད་པར་ཇི་ལྟར་འགྱུར།",
    "ཇི་ལྟར་ཟླ་བ་གཉིས་པ་ལ་སོགས་པ་ལོག་པར་སྣང་བ་དེ་བཞིན་དུ་བདེན་པའི་ཀ་བ་ལ་སོགས་པའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཐམས་ཅད་འགྱུར་བའི་ཕྱིར་རོ།",
    "གནོད་པར་བྱེད་པའི་ཤེས་པ་ཞེས་བྱ་བ་བདེན་པའི་ཀ་བ་ལ་སོགས་པའི་ཡུལ་ཅན་ལ་གནོད་བྱེད་མེད་པའི་ཕྱིར་ལོག་པར་སྣང་བ་ཉིད་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདི་ལ་བརྗོད་པ་ནི་གནོད་པར་བྱེད་པའི་ཞེས་བྱ་བའོ།",
    "ཐམས་ཅད་ལོག་པར་སྣང་བ་ཁོ་ན་ཡིན་ན་ནི།",
    "གནོད་མེད་པར་ཡང་ལོག་པར་སྣང་བ་ཁོ་ནའོ།",
    "དེ་ལྟ་ན་ཡང་དེ་ངེད་ིལས་དོན་རྣམ་པར་གནས་པར་ཇི་ལྟར་འགྱུར།",
    "འོ་ན་ལྷན་ཅིག་པ་གཉིས་པོ་ཉིད་བསྒོ་བར་བྱེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཕན་ཚུན་ཞེས་གསུངས་སོ།",
    "དེ་ནི་ཞེས་གསུངས་སོ།",
    "བཟློག་པ་སྒྲུབ་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་༤བསྒོ་བྱེད་མེད་པར་བསྒྲུབ་པ་ལ་འདི་བསྟན་ན་འགལ་བ་ཡིན་ནོ།",
    "གཟུང་བའི་རྣམ་པ་དང་བྲལ་བ་འཛིན་པར་བྱེད་པའི་ཁྱད་པར་གཞན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་དེའི་སྐྱེད་པར་བྱེད་པ་ནི་བག་ཆགས་ཁོ་ན་ཡིན་གྱི།",
    "འཇིག་པ་སྔ་མས་ཞེས་གསུངས་སོ།",
    "བརྟེན་པའི་ཞེས་གསུངས་སོ།",
    "འོན་ཏེ་ཡང་བརྟེན་པ་མི་སྐྱེ་བ་དེ་ལྟ་ན་ནི་ཡངསྐྱེ་བའི་བག་ཆགས་དང་འབྲེལ་པའི་ཕྱིར་བསྒོས་པར་འགྱུར་རོ་ཞེ་ན།",
    "བརྟན་པར་གནས་པ་སྔ་མ་ལས།",
    "ཞེས་གསུངས་སོ།",
    "སྔ་མ་འདྲ་དང་ཞེས་གསུངས་ཏེ།"
  ]
