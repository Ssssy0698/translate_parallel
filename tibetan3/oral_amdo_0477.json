    "ལྷོ་ནུབ་ཏུ་དོན་ཡོད་ཞགས་པ་མཐིང་གི་ཞགས་པ།",
    "གཡས་བརྐྱང་གིས་པད་ཉི་ལ་བཞེངས་པ།",
    "ཞབས་གཡས་བསྐུམ་གཡོན་བརྐྱང་གིས་པད་དཀར་དང་ཉི་གདན་ལ་བཞེངས་པ།",
    "ཕྱག་བཅུ་གཉིས་ཀྱི་གཡས་དྲུག་གིས་རྡོ་རྗེ།",
    "གཡོན་དྲུག་གིས་ཁ་ཊཾ།",
    "གཡོན་བཞིས་ཐོད་པ་ཁྲག་གིས་གང་བ།",
    "༢༩རྣམ་སྣང་མངོན་བྱང་གི་དཀྱིལ་འཁོར་གྱི་ལྷ་གཙོ་བསྡུས།",
    "ཕྱིའི་བྱ་བ་དང་ནང་གི་རྣལ་འབྱོར་ཆ་མཉམ་དུ་སྤྱོད་པའི་རྒྱུད་ལས།",
    "ཕྱག་གཉིས་མཉམ་བཞག་ཞབས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་གདན་པད་སྡོང་འདབ་རྒྱས།",
    "དེའི་གཡས་སུ་ཡུམ་ནམ་མཁའི་སྤྱན་མ་སེར་མོ།",
    "གཙོ་བོའི་གཡོན་ཕྱོགས་སུ་སྤྱན་རས་གཟིགས་དཀར་པོ་འོད་དཔག་མེད་པའི་དབུ་རྒྱན་ཅན།",
    "བྲག་གི་སྟེང་ན་ཁྲོ་བ་དང་བཅས་པས་འདུག་པ།",
    "གཡོན་དུ་ངན་སོང་ཐམས་ཅད་སྤོང་བ་དཀར་པོ་ཕྱག་གཉིས་ངན་སོང་ནས་འདྲེན་པའི་ཚུལ་མཛད་པ།",
    "ཐམས་ཅད་ཀྱང་པདྨ་དཀར་པོ་ཤ་སྟག་གི་གདན་ལ་འཁོད་པའོ།",
    "ནང་གི་ཏིང་ངེ་འཛིན་གཙོ་བོར་བཏོན་པའི་རྣལ་འབྱོར་གྱི་རྒྱུད་ལ།",
    "དབུས་སུ་རྣམ་སྣང་དཀར་པོ་ཞལ་བཞི་པ་ཞི་བས་གཟིགས་པ།",
    "གཡས་སུ་རིན་ཆེན་རྡོ་རྗེ་མའི་ངོ་བོ་ཡིད་བཞིན་ནོར་བུའི་རྩེ་མོར་དང་པོའི་རྡོ་རྗེ་ལྔས་མཚན་པ།",
    "གཡོན་དུ་རྡོ་རྗེ་ལས་མའི་ངོ་བོ་སྣ་ཚོགས་རྡོ་རྗེ་རྩེ་མོ་བཅུ་གཉིས་པ་ལྟེ་བ་དཀར།",
    "གཡས་སུ་རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ་ཕྱག་གཡས་པའི་སོར་མོ་དབུས་མའི་རྩེ་མོ་ལ་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཐུགས་ཀར་གཏོད་པའི་ཚུལ་གྱིས་འཛིན་ཅིང་།",
    "གཡོན་དུ་དེ་མཚུངས་གཅིག་བྱང་དུ་མཁའ་ལྡིང་གི་གདན་ལ་དོན་གྲུབ་ལྗང་གུ་སྐྱབས་སྦྱིན་ཕྱག་རྒྱུས་སྣ་ཚོགས་རྡོ་རྗེ་བསྣམས་པ།",
    "ཞི་བའི་གཟིགས་སྟངས་ཉི་མའི་རྒྱབ་ཡོལ་སོགས་རྣམ་སྣང་དང་འདྲ།",
    "༣༡རྡོ་རྗེ་རྩེ་མོའི་དཀྱིལ་འཁོར་དགུའི་ལྷ་གཙོ་བསྡུས།",
    "རྡོར་སྐྱིལ་གྱིས་པད་ཟླ་རྟ་མཆོག་གི་ཁྲི་ལ་བཞུགས་པ།",
    "སྐྱིལ་ཀྲུང་པད་ཟླ་མཁའ་ལྡིང་གི་ཁྲི་ལ་བཞུགས་པ།",
    "པདྨ་ལ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "གཡས་པའི་མཐེབ་མཛུབ་ཀྱིས་ཐུགས་ཀར་ཁ་འབྱེད་པ་ལ་གཟིགས་པའི་ཚུལ།",
    "ཕྱག་གཉིས་ཐུགས་ཀར་དམ་ཚིག་གི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རྡོ་རྗེ་འཚིར་བ།",
    "ཕྱག་བཞི་ཡིས་རལ་གྲི་རེ་རེ་བསྣམས་པ།",
    "པུས་མོ་ཕྱག་ངར་ཕྲག་པ་སོགས་སྔོན་པོ།",
    "ལྷའི་གོས་དང་ཕྱེད་བས་བརྒྱན་ཅིང་ཁྲོ་འཛུམ་ཅན་འོད་ཕྲེང་གི་དབུས་ན་གནས་པ།",
    "འབར་ཕྲེང་གི་དབུས་ན་སེམས་སྐྱིལ་གྱིས་པད་ཉི་ལ་བཞུགས་པའོ།",
    "དེའི་མདུན་ཟུར་དུ་སྲིང་མོ་བཞི་ནི།",
    "གསོད་མ་ནག་མོ་རལ་གྲི་དང་ཕུབ་ཐོགས་པ།",
    "གྲུབ་པ་མོ་དཀར་མོ་གྲི་རིང་ཐོགས་པ།",
    "དཀའ་བ་མོ་དམར་མོ་མདའ་གཞུ་འཛིན་པ།",
    "ཕྱག་རྒྱ་བཞི་ཀ་ཟླ་བའི་སྟེང་དུ་འོད་ཕྲེང་གི་དབུས་ན་གནས་པ།",
    "བྱང་དུ་མཁའ་ལྡིང་གི་ཁྲི་ལ་ལས་ཀྱི་ཧཱུྃ་མཛད་ཞལ་དང་བྱིན་པ་མན་ཆད་དཀར་པོ།",
    "ཁྱུ་མཆོག་ལ་ཞོན་ཅིང་ཡུམ་ཨུ་མ་སེར་མོ་གཡས་རྡོ་རྗེ་རྩེ་གསུམ།",
    "ཡུམ་རྡོ་རྗེ་འཇུ་བ་མོ་དཀར་མོ་རལ་གྲི་འཛིན་པས་གཡོན་ནས་རོལ་པ།",
    "བྱང་ཤར་དུ་དྲན་རྡོ་རྗེ་ལྕགས་ཀྱུ་སྔོན་པོ་ཕག་གི་གདོང་པ་ཅན།",
    "བྲན་མོ་རྡོ་རྗེ་ཁ་སྔོན་པོ་གཡས་རྡོ་རྗེ་རྩེ་གསུམ།",
    "པད་ཟླ་ལ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "༣༥ངན་སོང་སྦྱོང་དཀྱིལ་བཅུ་གཉིས་ཀྱི་གཙོ་ལྷ།",
    "ཡོ་ག་འཕྲོས་པའི་རྒྱུད་དུ་གྲགས་པ་ངན་སོང་སྦྱོང་རྒྱུད་བརྟགས་པ་ལས་གསུངས་པའི་སྦྱོང་དཀྱིལ་བཅུ་གཉིས་ཀྱི་གཙོ་བོ་བསྡུས་པ་ནི།",
    "ཕྱག་གཉིས་མཉམ་བཞག་གི་ཕྱག་རྒྱས་རྡོ་རྗེ་དཀར་པོ་རྩེ་ལྔ་པ་བསྣམས་པ།",
    "གདན་གླང་པོ་རྟ་མཆོག་རྨ་བྱ་མཁའ་ལྡིང་གི་ཁྲི་དང་།",
    "གཤེགས་པ་ལྔ་ཀ་ཞི་བའི་གཟིགས་སྟངས་ཅན།",
    "པད་ཟླ་ལ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཤར་ལྷོར་སྤྱན་མ་དཀར་མོ་གཡས་འཁོར་ལོ།",
    "ནུབ་བྱང་དུ་གོས་དཀར་མོ་དམར་མོ་གཡས་པདྨ།",
    "པད་ཟླ་ལ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "སྟེང་དབུས་སུ་གཙོ་བོ་འཇམ་དཔལ་ཡེ་ཤེས་སེམས་དཔའ་དཀར་པོ་ཞལ་དྲུག་གི་རྩ་ཞལ་སྔོསྟེང་ཞལ་གཉིས་བརྩེགས་དཀར།",
    "གཡོན་པས་སྔོན་པོའི་སྡོང་བུ་འཛིན་ཅིང་མེ་ཏོག་སྙན་གྱི་ཐད་ཀར་ཁ་བྱེ་བའི་སྟེང་ན་གླེགས་བམ་རེ་རེས་མཚན་པ།",
    "གཙོ་འཁོར་དེ་དག་གི་ཤར་མདུན་དུ་མི་བསྐྱོད་པ་སྔོན་པོ་ས་གནོན་མཉམ་བཞག་ལྷོ་རིན་འབྱུང་སེར་པོ་མཆོག་སྦྱིན་མཉམ་བཞག་ནུབ་ཏུ་འོད་དཔག་མེད་དམར་པོ་མཉམ་བཞག་བྱང་དུ་དོན་གྲུབ་ལྗང་གུ་སྐྱབས་སྦྱིན་མཉམ་བཞག་གླེང་ཆེན་རྟ་མཆོག་རྨ་བྱ་མཁའ་ལྡིང་གི་ཁྲི་ཅན།",
    "རིགས་བཞི་ཕྱི་མ་རྣམས་ཀྱི་གཡས་གཡོན་དུ་ཨུཏྤལ་ལ་གནས་པའི་རལ་གྲི་དང་པུསྟི་རེ་རེ་བྲི།",
    "ཤར་ལྷོར་སེམས་མ་རྡོ་རྗེ་མ་དཀར་མོ་གཡས་རྡོ་རྗེ་ཐུགས་ཀར་འཛིན་པ།",
    "མཚམས་སུ་འབྲས་ཤིང་གི་ལྗོན་པ་སྣ་ཚོགས་ལ་འབྲས་བུའི་འཁུར་གྱིས་ལྕི་བ།",
    "རང་བྱུང་གི་རི་དྭགས་དང་སྲོག་ཆགས་རིགས་ཀྱིས་གང་དགར་ལོངས་སྤྱོད་པ།",
    "སྒྲོལ་ལྷ་ཉེར་གཅིག་གི་དང་པོ་མྱུར་མ་དཔའ་མོ་ནི།",
    "གཡོན་པས་ཐུགས་ཀར་ཧཱུཾ་གི་ཚྭ་ཚྭ་འཕྲོ་བའི་ཕུར་བུ་བསྣམས་ཏེ།",
    "ཞལ་ནས་ཊཏ་དང་ཕཊ་ཀྱི་སྒྲ་སྒྲོགས་པས་ཕ་རོལ་གྱི་རྒོལ་བའི་ཚོགས་དཔུང་དང་བཅས་པ་ཐལ་བ་བརླག་པའོ།",
    "གཞན་མི་རྒྱལ་བའི་དཔའ་མོ་ནི།",
    "གཡོན་ཐུགས་ཀར་རྡོ་རྗེས་ཉོན་མོངས་པའི་བདུད་བཞི་དང་།",
    "རང་གི་སྐུའི་འོད་ཀྱིས་འཇིགས་པ་ཐམས་ཅད་སེལ་བར་མཛད་པའོ།",
    "གཡོན་གཏུན་ཤིང་གིས་མཚན་པའི་ཨུཏྤལ་གྱི་ཡུ་བ་ཐུགས་ཀར་འཛིན་པ།",
    "སྔགས་དང་བདེན་ཚིག་གྲུབ་པས་བྱད་མའི་ངག་གི་ནུས་པ་དང་མཐུ་སྟོབས་ཐམས་ཅད་རྩད་ནས་བཤིག་པའོ།",
    "ཐུགས་ཀའི་ཧཱུཾ་གི་ས་བོན་འཁྲུགས་པས་སྟོང་གསུམ་ཕ་རོལ་ན་གནས་པའི་གཟུགས་ཅན་གཟུགས་མེད་ཐམས་ཅད་ཀྱི་དགྲ་རྐུན་བཤན་པ་ཐམས་ཅད་ཀྱང་དྲག་ཤུལ་སྟོབས་ཀྱིས་མནན་པའོ།",
    "དུག་སེལ་རྨ་བྱ་ཆེན་མོ་ནི།",
    "གཡོན་བཀྲ་ཤིས་ཀྱི་རྫས་རྟགས་གསེར་ཉ་ཟུང་གིས་མཚན་པའི་ཨུཏྤལ་གྱི་ཡུ་བ་ཐུགས་ཀར་འཛིན་པ།",
    "གདོན་དང་གནོད་སྦྱིན་ཚོགས་རྣམས་ཀྱིས་བླ་ཚེ་བརྐུས་པ་རྣམས་སྐད་ཅིག་གཅིག་གིས་དགུག་པར་མཛད་པ་བཅས་ཉེར་གཅིག་བཞུགས་པའོ།",
    "དེ་ཐམས་ཅད་ཀྱང་བཅུ་དྲུག་ལང་ཚོ་སྨིན་པའི་ལྷ་མོའི་བཞིན་མཛེས་ཤིང་སྒེག་པ།",
    "ལུས་ཕྲ་མའི་མཛེས་པའི་མཚན་མ་བཅོ་བརྒྱད་དང་བུད་མེད་ཀྱི་ཡོན་ཏན་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་ཕྱུག་ཅིང་།"
  ]
