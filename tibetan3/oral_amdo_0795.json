    "གནའ་བོའི་རྡོ་རིང་ཡི་གེ་སོགས་ལ་ཞིབ་འཇུག་གནང་དང་གནང་བཞིན་ཡོད་པས་དེང་གི་ཆར་སྙན་གྲགས་ཀྱི་བ་དན་ཕྱོགས་བཞིར་ཁྱབ་བཞིན་ཡོད།",
    "དེང་སྐབས་ང་ཚོས་ཤེས་ཚོར་བྱུང་བའི་རྡོ་རིང་མང་པོ་ཞིག་ཡོད་པ་དེ་དག་ལ་ང་ཚོས་ཚོད་དཔག་ཅིག་བྱ་དུས།",
    "རྡོ་རིང་དང་རྡོ་ལ་བརྐོས་པའི་ཡི་གེ་ཁྱོན་བསྡོམས་ཧ་ལམ་ཉི་ཤུ་རྩ་བཞི་ཙམ་འདུག་ཉི་ཤུ་རྩ་བཞི་དེའི་ནང་ལ་གཙོ་བོ་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ཀྱི་རྡོ་རིང་དང་རྡོའི་ཡི་གེ་ཉི་ཤུ་རྩ་གཅིག་དང་བསྟན་པ་ཕྱི་དར་སྐབས་ཀྱི་རྡོ་རིང་གི་ཡི་གེ་གསུམ་ཙམ་ཡོད།",
    "དེ་དག་གི་དུས་ཚོད་ལ་དབྱེ་བ་ཕྱེ་ཚེ།",
    "རྡོ་རིང་སོ་སོའི་བྱུང་བ་དང་ད་ལྟ་བོད་ལ་ཡོད་པའི་རྡོ་རིང་ནང་ནས་སྔ་ཤོས་དེ་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེའུ་བཙན་དུས་ཀྱི་རྡོ་རིང་རེད།",
    "དེར་བརྟེན་ཁྲི་སྲོང་ལྡེའུ་བཙན་ལས་སྔ་བའི་བོད་ཡིག་གི་རྡོ་རིང་ཞིག་ད་ཕན་བོད་ནས་རྙེད་མེད།",
    "ཁྲི་སྲོང་ལྡེའུ་བཙན་སྐུ་དུས་སུ་བཞེངས་པའི་རྡོ་རིང་ལ་ཁྱོན་བཞི་ཡོད་པ་རེད།",
    "བཙན་པོའི་དུས་ཀྱི་རྡོ་རིང་ཉི་ཤུ་རྩ་གཅིག་ཡོད་པ་རེད་ཟེར་བ་དེའི་ནང་ནས་ཁྲི་སྲོང་ལྡེའུ་བཙན་དུས་ཀྱི་བཞི་ཡོད་པ་རེད།",
    "ང་ཚོས་རྡོ་རིང་དེ་ཚོར་རགས་རྩིས་ཤིག་བྱས་པ་ཡིན་ན།",
    "ད་ལྟ་ང་ཚོས་གཏན་འཁེལ་བའི་རྡོ་རིང་དགུ་ཙམ་ཞིག་ཡོད་པ་རེད།",
    "ཡི་གེ་གསུམ་པོ་དེའི་ནང་གི་གཅིག་ནི་ཉེ་ཆར་གསར་དུ་རྙེད་པ་རེད།",
    "ཡི་གེའི་ནང་དོན་བཅས་ལ་བལྟས་ཚེ་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ཀྱི་ཡིན་པ་ང་ཚོས་གཏན་འཁེལ་བ་རེད།",
    "བསྟན་པ་ཕྱི་དར་སྐབས་ཀྱི་རྡོ་རིང་སྣ་ཁ་གསུམ་ཙམ་ཞིག་ཡོད་པ་རེད།",
    "དེའི་ནང་གི་གཅིག་ནི་བསམ་ཡས་གཙུག་ལག་ཁང་གི་རྡོ་རིང་དང་།",
    "གཅིག་ནི་ལྷ་ས་ཞོལ་གྱི་རྡོ་རིང་ཕྱི་མ་ཟེར་བ་དེ་རེད།",
    "ཞོལ་གྱི་རྡོ་རིང་དེ་ནི་བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་གི་མཛད་པ་བཀོད་པའི་རྡོ་རིང་རེད་ཅེས་ལབ་ན་འགྲིག་གི་རེད།",
    "རྡོ་རིང་དེ་ད་ཕན་ཆད་ལ་ངོ་སྤྲོད་བྱེད་མཁན་གཅིག་མ་གཏོགས་བྱུང་ཡོད་པ་མ་རེད།",
    "རྡོ་རིང་དེའི་སྟེང་གི་ཡི་གེ་དེ་ཡང་གསལ་བོ་དེ་ཙམ་མེད།",
    "ཡིན་ན་ཡང་དེ་ཁྲི་སྲོང་ལྡེའུ་བཙན་སྐུ་དུས་ཀྱི་ཡིན་པ་གཏན་འཁེལ་རེད།",
    "གང་ཡིན་ཟེར་ན་རྡོ་རིང་དེའི་སྒང་ལ་བཙན་པོ་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་སྐུ་རིང་ལ་ཞེས་གསལ་པོར་བཀོད་ཡོད་ལ་དེར་ཀོང་པོ་རྡོ་རིང་ཞེས་ཟེར་གྱི་ཡོད་པ་རེད།",
    "བཞི་པ་དེ་འཕྱོངས་རྒྱས་ཟམ་ཁའི་རྡོ་རིང་རེད།",
    "དེའི་ནང་དོན་ལ་གཙོ་བོ་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་མཛད་པ་བཀོད་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་ཞིབ་འཇུག་པ་ཁ་ཅིག་གིས་དེ་ཁྲི་སྲོང་ལྡེའུ་བཙན་སྐུ་དུས་ཀྱི་ཨེ་ཡིན་ཟེར།",
    "དེ་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་སྲས་ཁྲི་ལྡེ་སྲོང་བཙན་གྱིས་ཁོ་རང་གི་ཡབ་ཀྱི་མཛད་པ་འགོད་ཆེད་བརྐོས་པའི་ཁྲི་ལྡེ་སྲོང་བཙན་དུས་ཀྱི་རྡོ་རིང་མིན་ནམ་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེ་དག་བསྡོམས་པའི་དགུ་རེད།",
    "དགུའི་ནང་ནས་ཡོངས་སུ་སྐད་གྲགས་ཆེ་བ་དེ་དག་གང་རེད་ཟེར་ན།",
    "གཅིག་ནི་ལྷ་སའི་ཉེ་འཁོར་གྱི་ལྷོ་ངོས་ནོར་བུ་གླིང་གའི་ཁ་སྤྲོད་དུ་ར་མ་སྒང་ཟེར་བའི་གྲོང་ཚོ་ཞིག་ཡོད་པ་རེད།",
    "དེང་སང་ཡིན་ན་མེ་འཁོར་འབབ་ཚུགས་ཀྱི་གྲོང་ཚོ་དེར་འཁེལ་གྱི་ཡོད།",
    "དེ་རུ་སྐར་ཆུང་རྡོ་རྗེ་དབྱིངས་ཀྱི་གཙུག་ལག་ཁང་གི་རྡོ་རིང་ཞིག་ཡོད་པ་རེད།",
    "ད་དུང་གཅིག་ག་རེ་ཡོད་པ་རེད་ཟེར་ན།",
    "ཀོང་པོའི་རྒྱུད་ལ་ཀོང་པོ་གཡུང་དྲུང་འཛིན་ཟེར་ས་དེར་བྲག་བརྐོས་ཡི་གེ་ཞིག་ཡོད་པ་རེད།",
    "དེའི་གཡས་གཡོན་ལ་ནང་དོན་གཅིག་པ་ཡིན་པའི་བྲག་བརྐོས་ཡི་གེ་གཉིས་ཡོད་པ་རེད།",
    "དེ་ང་ཚོས་བྲག་བརྐོས་ཡི་གེ་གཅིག་ལ་ཆ་བཞག་ན་འགྲིག་གི་ཡོད་པ་རེད།",
    "ད་དུང་ཁྲི་རལ་པ་ཅན་གྱི་སྐབས་སུ་བཞེངས་པ་ལས་ད་ལྟ་ལྷག་བསྡད་པའི་རྡོ་བརྐོས་ཡི་གེ་ལྔ་ཡོད་པ་རེད།",
    "ལྔའི་ནང་ནས་གཅིག་ནི་ཁྲི་ལྡེ་ཁོ་རང་གི་ཡབ་ཀྱི་བང་སོའི་མདུན་ལ་བརྐོས་བཞག་པའི་ཁྲི་སྲོང་བཙན་གྱི་བང་སོའི་རྡོ་རིང་སྟེ།",
    "ད་ལྟ་ལྷོ་ཁའི་འཕྱོངས་རྒྱས་ཁོངས་ལ་ཡོད་པ་རེད།",
    "རྡོ་རིང་དེ་བཙུགས་པའི་དུས་ཚོད་དེ་ཁྲི་རལ་པ་ཅན་གྱི་ཁོངས་ལ་འཇོག་དགོས་པ་ལྟ་བུ་ཞིག་རེད།",
    "གཉིས་པ་དེ་གཙུག་ལག་ཁང་མདུན་གྱི་ཐང་བོད་མནའ་འབྲེལ་རྡོ་རིང་ཟེར་བ་དེ་རེད།",
    "གསུམ་པ་དེ་མཚུར་ཕུའི་རྡོ་རིང་ཟེར་བ་ཞིག་ཡོད་པ་རེད།",
    "ལྔ་བ་དེ་མངའ་རིས་སྟོད་ཀྱི་པུ་ཧྲེང་ལ་རྡོ་རིང་ཞིག་ཡོད་པ་རེད།",
    "དེ་ལ་མང་ཆེ་བས་སྤྱན་རས་གཟིགས་ཀྱི་རྡོ་རིང་ཟེར་གྱི་ཡོད།",
    "དེ་དག་ཁྲི་རལ་བ་ཅན་གྱི་དུས་ཀྱི་རྡོ་རིང་ལྔ་རེད།",
    "དེ་མིན་དུས་ངེས་གཏན་མེད་པའི་རྡོ་རིང་ཡི་གེ་གཉིས་ཡོད་པ་རེད།",
    "ཡིན་ནའང་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ཀྱི་ཡིན་པ་གླེང་མེད་རེད།",
    "གཉིས་པ་དེ་ལྷ་སའི་ཉེ་འཁོར་གྱི་བྲག་ཡེར་བའི་ལྷ་ཁང་ཞིག་གི་ནང་ནས་རྙེད་པའི་རྡོ་ལ་བརྐོས་པའི་ཡི་གེ་རེད།",
    "དེ་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ཀྱི་ཡིན་པ་གླེང་མེད་རེད།",
    "ཡིན་ན་ཡང་དུས་ཚོད་ལ་ངེས་གཏན་མེད་ཀྱང་སྤྱིར་བཏང་བྱས་པ་ཡིན་ན་བཙན་པོ་ཁྲི་གཙུག་ལྡེ་བཙན་སྟེ་ཏེ་ཁྲི་རལ་བ་ཅན་གྱི་སྐུ་དུས་ལ་བཞག་པ་ཡིན་ན་མ་འཚམ་པ་མེད་པའི་རྡོ་རིང་ཞིག་རེད།",
    "ཡི་གེ་དེ་ལ་དཔྱད་པ་བཏང་དུས་བཙན་པོའི་སྐབས་ཀྱི་ཡིན་པ་གཏན་ཁེལ་བ་རེད།",
    "གོང་དུ་ཞུས་པ་དེ་དག་ནི་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ཀྱི་རྡོ་རིང་དང་བྲག་བརྐོས་ཡི་གེ་ཤ་སྟག་རེད།",
    "གཅིག་ནི་འཕན་ཡུལ་སྟོད་རྒྱལ་ལྷ་ཁང་གི་རྡོ་རིང་རེད།",
    "དེའི་ཡབ་ཕུ་དེར་ར་ཙ་དགོན་གྱི་རྡོ་རིང་ཟེར་བ་ཞིག་ཡོད་པ་རེད།",
    "ཡི་གེ་དེ་གསུམ་བསྟན་པ་ཕྱི་དར་སྐབས་ལ་བྱུང་བ་ཞིག་རེད།",
    "བོད་གནའ་རབས་ཀྱི་རྡོ་རིང་དང་རྡོ་བརྐོས་ཀྱི་གནས་ཚུལ་སྤྱིར་བཏང་དེ་འདྲ་ཙམ་ཞིག་རེད།",
    "ང་ཚོས་ཤེས་ཚོར་བྱུང་བའི་རྡོ་རིང་དང་དུས་རབས་ཉི་ཤུའི་ལོ་རབས་བརྒྱད་ཅུའི་རྗེས་ལ་གསར་རྙེད་བྱུང་བའི་རྡོ་རིང་གང་འདྲ་ཡོད་དམ།",
    "ངས་གོང་དུ་ཞུས་པའི་རྡོ་རིང་དང་རྡོ་བརྐོས་ཡི་གེ་ཉི་ཤུ་རྩ་གཅིག་གི་ནང་ནས་དུས་རབས་ཉི་ཤུའི་ལོ་རབས་བརྒྱད་ཅུའི་གོང་ལ་རྒྱལ་ཁབ་ཕྱི་ནང་གི་མཁས་པས་ཤེས་ཚོར་བྱུང་བའི་རྡོ་རིང་བཅུ་ལྷག་ཙམ་ལས་ཡོད་པ་མ་རེད།",
    "དཔྱད་པ་བྱེད་སའི་རྡོ་རིང་དང་རྡོ་བརྐོས་ཡི་གེ་དེ་ཡང་བཅུ་ལྷག་ལས་ཡོད་པ་མ་རེད།",
    "དེ་ནས་ལྷོ་ཁའི་རྒྱུད་ལ་བསམ་ཡས་གཙུག་ལག་ཁང་གི་རྡོ་རིང་དང་ཁྲི་ལྡེ་སྲོང་བཙན་བང་སོའི་མདུན་གྱི་རྡོ་རིང་།",
    "ཀོང་པོ་གཡུང་དྲུང་འཛིན་གྱི་རྡོ་བརྐོས་སོགས་ལོ་རབས་ཉི་ཤུའི་དུས་རབས་བརྒྱད་ཅུའི་གོང་ལ་བོད་རིག་པའི་ཞིབ་འཇུག་བྱེད་མཁན་དང་རྒྱལ་ཁབ་ཕྱི་ནང་གི་བོད་རིག་པར་ཞིབ་འཇུག་བྱེད་མཁན་ཚོས་ཤེས་ཚོར་བྱུང་བའི་རྡོ་རིང་དང་རྡོ་བརྐོས་ཡི་གེ་རེད།",
    "དེ་ནི་སྔ་མོའི་ཡིག་ཐོག་ལ་གཏན་ནས་མ་འཁོད་པ་ཞིག་རེད།",
    "དེའི་ནང་ནས་ཁ་ཅིག་ས་ཆ་དེའི་མང་ཚོགས་རྣམས་ཀྱིས་སྔ་ས་ནས་ཡོད་པ་ཤེས་ཚོར་ཡོད་པ་ཞིག་ལ་ཡིག་ཐོག་ཏུ་ངོ་སྤྲོད་མ་བྱས་པ་ཞིག་རེད།",
    "དེའི་སྐོར་ངས་ནི་སྤྱི་ལོ་ལོའི་བོད་ལྗོངས་ཞིབ་འཇུག་གི་རྒྱ་ཡིག་དང་།",
    "བོད་རིག་པའི་ཞིབ་འཇུག་པ་ཁག་ཅིག་གིས་རྡོ་རིང་ཡི་གེ་ལ་དོ་སྣང་ཆེན་པོ་བྱས་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་ལས་ཀ་དེ་གསར་གཏོད་རང་བཞིན་ལྡན་པའི་ལས་ཀ་རེད།",
    "དེར་བརྟེན་སྐབས་དེར་གཙོ་བོ་ཞིབ་འཇུག་བྱ་ཡུལ་གྱི་རྡོ་རིང་གཉིས་རེད།",
    "རྡོ་རིང་གཅིག་དེ་གཙུག་ལག་ཁང་གི་མདུན་གྱི་ཐང་བོད་གནའ་འབྲེལ་རྡོ་རིང་ལ་ཞིབ་འཇུག་བྱས་པ་དང་།",
    "གཉིས་པ་དེ་ཞོལ་རྡོ་རིང་ཕྱི་མ་དེ་རེད།",
    "རྡོ་རིང་དེ་གཉིས་ལ་འཁོད་པའི་ནང་དོན་མང་པོ་ཞིག་སྤུ་རྒྱལ་བཙན་པོའི་དུས་སྐབས་ཀྱི་བོད་དང་ཐང་རྒྱལ་རབས་བར་གྱི་འབྲེལ་བ་དེ་རེད།",
    "མཁས་པ་གཅིག་ནི་དབྱིན་ཇིའི་མི་རི་ཅལ་སོན་རེད།",
    "བྱས་ཙང་དེས་དཔོན་རིགས་བྱས་པའི་ནང་ལ་ཞོར་དུ་བོད་ས་གནས་ཁག་ཏུ་བསྐྱོད་དེ་རྡོ་རིང་ཡི་གེ་ངོ་བཤུས་དང་ཞིབ་འཇུག་བྱེད་པའི་གོ་སྐབས་ཤིག་ཐོབ་ཡོད་པ་རེད།",
    "བྱས་ཙང་རི་ཅལ་སོན་གྱིས་ལོ་དང་ལོ་སོགས་ལ་རྡོ་རིང་སྐོར་གྱི་དཔྱད་པ་བྱས་ཏེ་དབྱིན་ཇིའི་ཐོག་ནས་ཞིབ་ཕྲ་ཞིག་ངོ་སྤྲོད་བྱས་པའི་དཔེ་དེབ་སྔ་ཕྱི་བསྡོམས་པས་གཉིས་པར་སྐྲུན་བྱས་ཡོད་པ་རེད།",
    "འདི་གཉིས་བར་ལ་དབྱེ་བ་ག་རེ་ཡོད་པ་རེད་ཟེར་ན་ལོ་ལ་པར་སྐྲུན་བྱས་པའི་དཔེ་དེབ་དེ་ཞིབ་འཇུག་ཐོག་གི་བྱ་བ་ཡག་པོ་ཞིག་རེད་ཟེར་དགོས་རེད།",
    "དེ་མིན་ཁོང་གིས་ལོར་པར་སྐྲུན་བྱས་པའི་དེབ་དེའི་ནང་ལ་དེའི་བར་གྱི་ལོ་ངོ་སུམ་ཅུ་ལྷག་ཙམ་ནང་གི་མཁས་པ་མང་པོས་རྡོ་རིང་དང་རྡོའི་ཡི་གེ་ལ་དཔྱད་པ་བྱས་པའི་འབྲས་བུ་དེ་ཚུར་བླངས་ནས།",
    "རང་གི་སྔར་ཡང་དག་ལྟ་བ་རྒྱུན་འཁྱོངས་དང་ཡང་མ་དག་པའི་ལྟ་བ་ལེགས་བཅོས་བྱས་ནས།",
    "གོང་གི་དཔྱད་པ་བྱས་པ་དེ་དག་ལ་ཕྱི་མིག་ཅིག་བལྟ་དུས་དོན་དག་ཁ་ཤས་ཐོག་ལ་ད་དུང་མུ་མཐུད་དུ་གྲོས་མོལ་བྱེད་དགོས་པ་དང་བགྲོ་གླེང་བྱེད་དགོས་པའི་གནས་ཚུལ་མང་པོ་ཡོད་པ་རེད།",
    "བྱས་ཙང་ང་ཚོས་དེང་སང་དེ་ལ་གཡུང་དྲུང་འཛིན་གྱི་བྲག་བརྐོས་ཡི་གེ་ཞེས་བརྗོད་ཀྱི་ཡོད།",
    "དེར་དེ་མོའི་བྲག་བརྐོས་ཡི་གེ་ཟེར་བ་ལ་ཁག་ཡོད་པ་མ་རེད།",
    "ག་རེ་རེད་ཟེར་ན་བྲག་བརྐོས་ཡི་གེ་ཡོད་ས་འདི་སྐབས་དེར་དེ་མོ་ཆུས་ཟེར་བའི་ས་ཁོངས་ནང་ཡིན་པའི་རྟགས་རེད།",
    "འོན་ཀྱང་མིང་བཏགས་སྟངས་དེ་འཚམས་པོ་བྱུང་ཡོད་པ་མ་རེད།",
    "དེའི་ཐོག་ལ་བསྟན་པ་ཕྱི་དར་གོང་གི་རྡོ་རིང་ཡི་གེ་བསྣན་པའི་བཅུ་ཙམ་ལས་ཡོད་པ་མ་རེད།",
    "དེ་མིན་ལོའི་ནང་གསར་དུ་འཁོད་པའི་རྡོ་རིང་ཁག་ཅིག་དེའི་ནང་དུ་ཚུད་ཡོད་པ་མ་རེད།",
    "རླངས་ཀྱི་པོ་ཏི་བསེ་རུའི་ནང་ལ་ལར་སྐྱེས་པའི་མིས་རང་གི་སྐྱེ་རྒྱུད་མ་ཤེས་ན།",
    "ནགས་ནང་གི་སྤྲེའུ་དང་འདྲ།",
    "དེས་མ་ཚད་དེ་དག་གི་ནང་དོན་མང་པོ་ཞིག་རྡོ་ལ་བརྐོས་ནས་ཕ་ཚ་བུ་རྒྱུད་ནས་རྡོ་བརྐོས་ཀྱི་ཡི་གེའི་ནང་དོན་ལ་བརྩི་འཇོག་བྱེད་དགོས་རྒྱུ་གཅིག་དང་།",
    "དེར་བརྟེན་རྡོ་རིང་གི་ཡི་གེ་ལ་བལྟ་སྟངས་ཀྱང་དེ་ལྟར་ཡིན།",
    "གསུམ་པ་འདི་ནི་དམིགས་བསལ་གྱི་མཁས་པ་ཞིག་ལ་ཞུ་ཆོག་གི་ཡོད་རེད།",
    "ང་ཚོས་ཁོང་གི་གསུང་འབུམ་ནང་ནས་མངའ་རིས་ཀྱི་རྒྱལ་རབས་སྐོར་ཏེ།",
    "ཁོང་གི་གསུང་འབུམ་ནང་ལ་འཕྱོངས་རྒྱས་ཟམ་ཁར་ཡོད་པའི་རྡོ་རིང་ཡི་གེ་ཆ་ཚང་ཞིག་བཀོད་ཡོད་པ་མ་ཟད།",
    "དེ་ནི་གལ་ཧ་ཅང་ཆེན་པོ་རེད།",
    "གལ་སྲིད་ཁོང་གིས་རྡོ་རིང་དེའི་ཡི་གེ་ཆ་ཚང་ཞིག་བཤུས་མེད་ན་ད་ཆ་ང་ཚོར་རྡོ་རིང་དེའི་ཡི་གེ་མཇལ་ཐབས་མེད་པ་མ་ཟད།",
    "ཡི་གེ་མང་པོ་འབྲི་སུབ་ལ་ཕྱིན་ནས་མཐོང་དཀའ་བོ་ཆགས་འདུག་དེར་བརྟེན་ཧ་ཅང་གི་བཀའ་དྲིན་ཆེན་པོ་རེད་ཅེས་བརྗོད་ཆོག་པ་རེད།",
    "ཉེ་ཆར་ངའི་ལག་པར་གཙུག་ལག་ཁང་མདུན་གྱི་ཐང་བོད་མནའ་འབྲེལ་གྱི་རྡོ་རིང་གི་འབྲི་བཤུས་བྱས་པའི་ཡི་གེ་ཞིག་འབྱོར་བྱུང་།",
    "བློ་ཕངས་བ་ཞིག་ལ་ཡི་གེ་འདི་ཇི་མ་ཇི་བཞིན་བཤུས་མེད་པ་དཔེར་ན་རྡོ་རིང་ནང་འཁོད་པའི་གི་གུ་ལོག་པ་དང་དེའི་རིགས་བཤུ་མཁན་གྱིས་ཆ་ཚང་དོར་ནས་བཤུས་པའི་སྐབས་ཀྱི་ཡི་གེའི་འགྲོ་སྟངས་གཞིར་བཟུང་བཟོ་བཅོས་བརྒྱབ་པ་ཞིག་འདུག་དེའི་ཐོག་ནས་དོན་གང་མཚོན་གྱི་ཡོད་དམ་ཞེ་ན་རྡོ་རིང་ཐོག་ལ་དེ་མིན་གྱི་དོ་སྣང་བྱེད་མཁན་ཡོད་པ་ཤེས་ཐུབ།",
    "རྡོ་རིང་དང་རྡོ་བརྐོས་ཡི་གེ་དེའི་ཕན་ནུས་ག་རེ་ཡོད་པ་རེད་ཟེར་ན།",
    "དེ་བཞིན་ང་ཚོ་བོད་ཀྱི་ཡིག་ཚགས་དེ་དུས་རབས་གཉིས་ལ་ཕྱེ་དགོས་རེད།",
    "གནའ་རབས་ཀྱི་ཡིག་རྙིང་ཞེས་པ་དེ་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ཀྱི་ཡིག་རྙིང་རེད།",
    "དེའི་ནང་ལ་ད་ལྟ་ཡོད་པའི་ཡིག་རྙིང་སྣ་ཁ་བཞི་ཙམ་ཞིག་ཡོད་པ་རེད།",
    "གཅིག་ནི་བོད་ཀྱི་རྡོ་རིང་དང་དྲིལ་བུའི་ཡི་གེ་རེད།",
    "གཉིས་ནི་ཏུན་ཧོང་གི་གཏེར་ཡིག་རེད།",
    "བཞི་བ་ནི་ཤིན་ཅང་ལི་ཡུལ་ནས་ཐོན་པའི་ཁྲམ་ཡིག་བཅས་རིགས་བཞི་ཙམ་ཞིག་ཡོད་པ་རེད།",
    "དང་པོ་རྡོ་རིང་གི་ཡི་གེ་གྲངས་འབོར་ཆེན་པོ་ཞིག་མ་ཡིན་པར་རྡོ་རིང་ཉི་ཤུ་ལྷག་ཙམ་ལས་མེད།",
    "དེར་བརྟེན་སྲོང་བཙན་དུས་ལ་ར་ས་གཙུག་ལག་ཁང་བཞེངས་པ་འདི་གཏན་འཁེལ་ཡིན་པ་དེ་རྡོ་རིང་ཡི་གེའི་ཐོག་ནས་དཔང་རྟགས་ཡོང་གི་ཡོད།",
    "ཐང་རྒྱལ་རབས་སྐབས་གཉའ་དཀར་པོ་གཉའ་ནག་པོ་ཟེར་བ་དང་ཉའོ་མིན་དང་པེ་མིན་ཟེར་བ་དེ་ད་ལྟ་མི་རིགས་པེ་རིགས་དང་དབྱི་རིགས་ཟེར་བའི་མེས་པོ་ཡིན་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེར་བརྟེན་ཁོང་གི་སྐུ་ཚེ་ཧྲིལ་བོའི་མཛད་པ་དེ་དག་གཉའ་ལ་དམག་དྲངས་པ་དང་ཁམས་རྒྱུད་ལ་མཛད་པ་མང་པོ་ཞིག་སྤེལ་བ་དེ་ཚོ་ཡིད་བརྟན་འཕེར་བའི་ཡིག་ཚགས་གཞན་དག་ནང་ལ་འཁོད་པ་དང་གཅིག་མཚུངས་ཡིན་པ་ར་སྤྲོད་ཐུབ།",
    "ཀོང་གར་པོ་རྒྱལ་པོ་ཞེས་པ་འདི་བཙན་པོའི་རྒྱལ་རྒྱུད་ཅིག་རེད།",
    "སྟོད་ཀྱི་སྟེང་གཉིས་ཞེས་བརྗོད་སྐབས་གྲི་གུམ་བཙན་པོ་དེ་རྒྱལ་རབས་ཨང་བརྒྱད་པར་བརྩི་ཡི་ཡོད་པ་རེད།",
    "སྤྱི་ལོ་ལོར་ཏུན་ཧོང་ནས་བོད་ཀྱི་ཡིག་རྙིང་ཕོན་ཆེན་ཞིག་རྙེད་པ་རེད།",
    "འོ་ན་བདུན་པ་ཡིན་ཟེར་བ་དེ་ར་སྤྲོད་གང་ནས་ཐུབ་ཀྱི་ཡོད་པ་རེད་ཟེར་ན།",
    "དེ་ཏུན་ཧོང་ཡིག་རྙིང་གཅིག་པོ་ལ་ཆ་བཞག་ན་ཡོང་གི་མ་རེད།",
    "དེ་དང་ཏུན་ཧོང་གི་ཡིག་རྙིང་དེ་ཏག་ཏག་གཅིག་པ་ཡིན་པ་ར་སྤྲོད་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "ཁོང་གི་མཛད་པའི་སྐོར་གླེང་སྐབས་བསྟན་པ་ཕྱི་དར་རྗེས་ཀྱི་རྒྱལ་རབས་ནང་དུ་སྐད་ཆ་འདི་འདྲ་ཞིག་ཡོད་པ་སྟེ།",
    "ཡར་ནུབ་ལ་ཆ་བཞག་པ་ཡིན་ན་སྐབས་དེར་སྟག་གཟིག་དང་ས་འབྲེལ་ཐུབ་ཀྱི་ཡོད་པ།",
    "སྟག་གཟིག་ཟེར་བ་དེ་གནའ་སྔ་མོའི་ནུབ་ཕྱོགས་ནས་ཨེ་ཤ་གླིང་དབུས་ན་ཡོད་པའི་རྒྱ་སྐད་ནང་གི་ཏ་ཧྲི་ཟེར་བ་དེ་ཡིན་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེང་སང་བྱས་ན་དབྱི་ལང་གི་མེས་པོ་ཡིན་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་དེ་གཉིས་རིགས་ལོགས་དགར་རེད།",
    "དེ་བོད་ཡིག་གཞན་དག་ལ་འཁོད་ཡོད་པ་མ་རེད།",
    "ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་སྐུ་དུས་ལ་ཡར་སྟག་གཟིག་དང་མར་ལུང་ཤན་ཟེར་ན་དེང་སང་ལུང་ཧྲན་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ཧྲན་ཞི་དང་ཀན་སུའུ་དེ་དག་གི་ས་བབས་རྒྱུད་མན་ཆད་ཆབ་འོག་ཏུ་བསྡུས་ཏེ་ཆབ་སྲིད་ནི་ལྷོ་བྱང་ཤར་ནུབ་མཐར་སླེབས་པར་བྱའོ་ཟེར་བའི་སྐད་ཆ་དེ་འདྲ་ཡོད་པ་རེད།",
    "དེ་བཞིན་ལྷ་སའི་གཙུག་ལག་ཁང་མདུན་གྱི་རྡོ་རིང་དེའི་ཐོག་ནས་ག་རེ་ཧ་གོ་ཐུབ་ཀྱི་རེད་ཟེར་ན།",
    "གཙུག་ལག་ཁང་མདུན་གྱི་རྡོ་རིང་གི་ཡི་གེ་དེ་སྤྱི་ལོ་ལོའི་ནང་ལ་བྲིས་པ་ཞིག་རེད།",
    "རྡོ་རིང་དེ་དངོས་སུ་བསླང་ཡས་དེ་སྤྱི་ལོ་ལོར་བསླངས་པ་རེད།",
    "འོ་ན་ལྡན་མ་བྲག་རྩའི་ཡི་གེ་དེ་ལས་ང་ཚོས་ཤེས་རྟོགས་ག་རེ་བྱུང་ཡོད་ཟེར་ན།",
    "རྒྱ་ཡིག་ནང་ལ་དེ་འདྲ་ཞིག་འཁོད་ཡོད་པ་རེད།",
    "ས་ྤྱི་ལོ་ལོ་ལ་བོད་དམག་སྐབས་དེའི་ཐང་གི་རྒྱལ་ས་ཁྲང་ཨན་ལ་སླེབས་ནས་གོང་མ་སན་ཀྲོའུ་ལ་བྲོས་བྱོལ་དུ་ཕྱིན་པ་རྒྱ་ཡིག་ཡིག་ཚང་ནང་ལ་འཁོད་ཡོད་པ་རེད།",
    "བོད་ཡིག་གི་ཡིག་ཚགས་གཞན་ནང་ལ་དེའི་སྐོར་ཞིབ་ཕྲ་འཁོད་ཡོད་པ་མ་རེད།",
    "རྩེ་ཞོལ་གྱི་རྡོ་རིང་ཡི་གེའི་ཐོག་གི་ནང་དོན་གཙོ་བོ་ག་རེ་རེད་ཟེར་ན།",
    "སྐབས་དེའི་བོད་ཀྱི་དམག་དཔོན་ཆེན་མོ་ངན་ལམ་སྟག་སྒྲ་ཀླུ་ཁོང་གི་བྱས་པ་བཀོད་ཡོད་ལ།",
    "མ་ཟད་ཡི་གེ་དེའི་ནང་ལ་ངན་ལམ་སྟག་སྒྲ་ཀླུ་གོང་གིས་དམག་ཁྲིད་ནས་རྒྱའི་མཐིལ་དུ་ཕྱིན་ཏེ་ཅིན་ཧྲི་རྒྱལ་ས་དེ་བླངས་པ་སོགས་དང་།",
    "གཅིག་མགར་སྟོང་བཙན་གྱིས་བཞེངས་པ་རེད་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེས་ག་རེ་མཚོན་གྱི་ཡོད་པ་རེད་ཟེར་ན།",
    "ད་ལྟ་དེའི་འཁྲིས་ལ་ཡོད་པའི་ལྷ་ཁང་དེར་ཀོང་ཇོ་ལྷ་ཁང་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེར་བརྟེན་ཨ་ཅེ་རྒྱ་བཟའ་བོད་ལ་ཕེབས་པའི་ལམ་བར་དུ་བློན་པོ་མགར་སྟོང་བཙན་གྱིས་ས་ཆ་དེ་ལ་ཡུལ་སྲུང་བྱས་ནས་ཨ་ཅེ་རྒྱ་བཟའ་བསྒུག་བསྡད་པ་རེད་ཟེར།",
    "འོན་ཀྱང་སྐད་ཆ་དེ་དེང་སང་གི་སྐད་ཆ་མ་རེད།",
    "འོན་ཀྱང་གོང་གི་རྡོ་རིང་དེ་དག་ལ་བརྟེན་ནས་ནོར་བ་དེར་ལེགས་བཅོས་ཐུབ་ཀྱི་ཡོད།",
    "དེ་ཁྲི་ལྡེ་སྲོང་བཙན་སྐུ་དུས་ལ་བཞེངས་པ་རེད།",
    "འུན་ཤིང་ཀོང་ཇོ་བོད་ལ་ཕེབས་དུས་སྤྱི་ལོ་ལོ་ལ་ཁེལ་ཡོད་པ་རེད།",
    "ཁྱི་ལོ་དེ་ཚོད་དཔག་བྱས་ན་སྤྱི་ལོ་ལོ་ལ་རེད།",
    "དེ་ཡིན་ན་བཙན་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་གྱིས་བཞེངས་པ་རེད།",
    "ཕྱིས་སུ་དེ་འཕེལ་རྒྱས་གང་འདྲ་ཞིག་བྱུང་མིན་སོགས་ལ་ནུས་པ་ཆེན་པོ་ལྡན་པ་དེ་འདྲ་རེད།",
    "རིགས་གཅིག་ཡིན་ན་བྲིས་གཟུགས་རེད།",
    "སྤུ་རྒྱལ་བཙན་པོའི་སྐབས་ཀྱི་ཡི་གེ་ཡིན་ན་ཡང་བརྡ་སྦྱོར་རིམ་བཞིན་འཕེལ་བ་དང་བསྟུན་ནས་ངོ་བོ་ཅུང་ཟད་འགྱུར་ཡོད་པ་རེད།",
    "གང་ཡིན་ཟེར་ན་ང་ཚོས་བསྟན་པ་ཕྱི་དར་སྐབས་ཀྱི་ཡིག་རྙིང་དེ་ཚོར་དཔྱད་པ་བྱེད་དུས་གི་གུ་ལོག་པ་དོར་བ་སོགས་ཀྱི་སྣང་ཚུལ་འགའ་ཞིག་མཐོང་རྒྱུ་ཡོད་པ་རེད།",
    "ཁྲི་ལྡེ་སྲོང་བཙན་དང་ཁྲི་རལ་པ་ཅན་གྱི་ངོས་འཛིན་ཐད་ལ་ནོར་འཁྲུལ་ཅུང་ཙམ་བྱུང་ཡོད་པ་རེད།",
    "དེ་གཉིས་མི་གཅིག་ཡིན་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་ཁ་ཅིག་གིས་ཁྲི་སྲོང་ལྡེའུ་བཙན་སྐུ་དུས་ཡིན་ཞེས་ཤོད་མཁན་ཡོད་པ་རེད།",
    "དེ་ནས་རིན་ཐང་གཞན་ཞིག་ནི་རྡོ་བརྐོས་ཀྱི་ཡི་གེ་སྟེ་རྡོ་ལ་བརྐོས་པའི་ཡི་གེ་རེད།",
    "ཉེ་བའི་སྲས་ཆེན་བརྒྱད་ཡོད་པ་ལྟ་བུ་རེད།",
    "སྐུ་བརྙན་དང་ཕྱོགས་མཚུངས་རྡོའི་གཡས་གཡོན་ལ་སྤྲིན་དཀར་གྱི་རི་མོ་དང་།",
    "དེ་དུས་ཀོང་པོའི་གླང་དཀར་གྱི་ཁྲི་སྲོང་ལྡེའུ་བཙན་སྐུ་དུས་ཀྱི་རྡོ་རིང་ཅེས་ཞེས་པར་བལྟ་སྐབས་རྡོ་རིང་འདིའི་འོག་གི་ཞབས་རར་གླང་ཆེན་ཞིག་བྲིས་འདུག་དེ་བཞིན་དུ་ཞ་ལྷ་ཁང་གི་རྡོ་རིང་ལ་ཆ་བཞག་ན།",
    "དེའི་རིགས་ལས་ང་ཚོས་ག་རེ་ཧ་གོ་ཐུབ་ཀྱི་རེད་ཟེར་ན་སྤུ་རྒྱལ་བཙན་པོའི་དུས་སམ་ཡང་ན་ལོ་ངོ་ཆིག་སྟོང་ལྷག་ཙམ་གོང་གི་བོད་ཀྱི་རྡོ་བརྐོས་བཟོ་རྩལ་གྱི་ལག་རྩལ་གང་འདྲ་ཞིག་ཡོད་མིན་ལ་དཔྱད་པ་བྱེད་རྒྱུར་རིན་ཐང་ཧ་ཅང་གི་ཆེན་པོ་ཡོད་པ་རེད།",
    "སྐུ་བཞེངས་མཁན་གྱི་བཟོ་བོའི་མིང་ཡོད་པ་རེད།",
    "མིང་གི་ཐོག་ལ་ཆ་བཞག་ན།",
    "རྒྱ་མི་རིགས་ཀྱི་མིང་ཡོད་ཅིང་མང་ཆེ་བ་བོད་མི་རིགས་ཀྱི་མིང་རེད།",
    "བྱས་ཙང་དེའི་རྡོ་བརྐོས་བཟོ་རྩལ་གྱི་རིག་པ་དེར་ཡི་གེ་ཙམ་མ་ཡིན་པའི་སྐུའི་གཟུགས་བརྙན་གྱི་འབྲི་སྟངས་ལ་ཡང་གལ་ཆེའི་དཔྱད་གཞིའི་རིན་ཐང་ལྡན་ཡོད་པ་རེད།",
    "ཞོར་དུ་གླེང་དགོས་པ་ཞིག་ལ་ད་ལྟ་བོད་དུ་རྙེད་པའི་སྔ་མོའི་རྡོ་བརྐོས་ཀྱི་ཡི་གེ་མང་ཆེ་བའི་སྐུ་བརྙན་གཙོ་བོ་དེ་རྣམ་པར་སྣང་མཛད་རེད།",
    "བྱས་ཙང་དེ་ཡ་མཚན་སྐྱེ་དགོས་པ་ཞིག་རེད།",
    "སྤྱིར་བཏང་བྱས་ན་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་བརྙན་འདི་སྤུ་རྒྱལ་བཙན་པོའི་དུས་ལ་འབྲི་བ་དང་བཞེངས་བ་སོགས་དར་སོ་ཧ་ཅང་ཆེན་པོ་བྱུང་ཡོད་པ་རེད།",
    "འོན་ཀྱང་དེའི་སྐོར་ལ་ང་ཚོས་དམའ་ས་ནས་དཔྱད་པ་འདི་འདྲ་ཞིག་བྱེད་ཐུབ་ཀྱི་རེད།",
    "ད་ལྟ་རྡོ་རིང་གི་ཐོག་ལ་འཁོད་པའི་ཡི་གེ་ཚང་མ་དབུ་ཆེན་ཡིན་པ་དེ་ནི་གླེང་མེད་ཡིན།",
    "གནས་ཚུལ་འདི་འདྲ་ཞིག་ཡོད་པ་རེད།",
    "རྡོ་རིང་ཁག་དང་ཏུན་ཧོང་ཤོག་དྲིལ་ཁག་གི་བར་ལ་འབྲེལ་བ་གང་འདྲ་ཡོད་དམ།",
    "རྡོ་རིང་དང་ཏུན་ཧོང་ཡི་གེའི་བར་གྱི་འབྲེལ་བ་དེ་གང་འདྲ་རེད་ཟེར་ན།",
    "དང་ཐོག་རྡོ་རིང་གི་ཡི་གེ་དང་ཏུན་ཧོང་གི་ཡི་གེའི་ཐོག་ལ་མཐུན་པའི་ཆ་མང་པོ་ཞིག་ཡོད་པ་རེད།",
    "མཐུན་པའི་ཆ་དང་པོ་དེ་ག་རེ་རེད་ཅེ་ན།",
    "ཏུན་ཧོང་གི་ཡི་གེ་ནི་ལོ་ངོ་ཆིག་སྟོང་གོང་གི་ཡིག་རྙིང་རེད།",
    "གནའ་རབས་ཀྱི་རྡོ་རིང་ཡི་གེ་འདི་དག་ཀྱང་ལོ་ངོ་ཆིག་སྟོང་གོང་གི་རེད།",
    "ཏུན་ཧོང་ཡིག་རྙིང་ནང་དུ་འཁོད་པའི་རྒྱལ་རབས་དང་རྡོ་རིང་ནང་ལ་འཁོད་པའི་རྒྱལ་རབས་མང་པོ་ཞིག་ཕན་ཚུན་ར་སྤྲོད་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་བསྟན་པ་ཕྱི་དར་སྐབས་ཀྱི་བོད་ཀྱི་རྒྱལ་རབས་མང་ཆེ་བར་མི་རབས་བརྒྱད་པ་ཡིན་ཞེས་བརྗོད་ཡོད་པ་རེད།",
    "གསུམ་པ་ཡི་གེའི་བརྡ་སྤྲོད་རིག་པའི་ཐོག་ནས་ཏུན་ཧོང་གི་ཡིག་རྙིང་དང་བཙན་པོའི་སྐབས་ཀྱི་རྡོ་རིང་གི་ཡི་གེ་འདི་ལོ་ཆིག་སྟོང་གོང་གི་བཙན་པོའི་དུས་ཀྱི་ཡི་གེ་ཡིན་དུས།",
    "ཏུན་ཧོང་གི་ཡི་གེ་ནི་རིགས་གཉིས་རེད།",
    "རྡོ་རིང་དང་རྡོ་བརྐོས་ཡི་གེ་འདི་ཏུན་ཧོང་ཡིག་རྙིང་དང་འདྲ་མཚུངས་ཆེན་པོ་ཡོད་པ་རེད།",
    "རྡོ་རིང་གི་གཙོ་བོའི་བརྗོད་པ་རིགས་གསུམ་རེད།",
    "སྲིད་དང་འབྲེལ་བ་ཡོད་པ་དེ་གང་འདྲ་ཞིག་རེད་ཟེར་ན།",
    "གཙིགས་ཡིག་གཞིར་བཟུང་གིས་ལས་དོན་བྱེད་དགོས་པ་དེ་འདྲ་ཞིག་མཚོན་གྱི་ཡོད།",
    "ཀོང་དཀར་པོའི་ས་ཆའི་ཐོག་གི་བྲན་ཁྱིམ་དང་།",
    "ཞྭ་ལྷ་ཁང་གི་རྡོ་རིང་གཉིས་ལ་ཆ་བཞག་ན་ཡང་།",
    "དེ་བཙུགས་པའི་རྗེས་ལ་འཐབ་རྩོད་མེད་པ་རེད་དམ་ཟེར་ན།",
    "འཐབ་རྩོད་མེད་པ་མ་ཡིན་ཏེ་སྐབས་དེར་བོད་རང་གི་ས་སྐྱེས་རྡོ་སྐྱེས་ཡིན་པའི་བོན་པོ་དང་བོན་ལ་དད་པ་བྱེད་མཁན་གྱི་བློན་པོ་དང་ནང་པའི་དབར་འགལ་བ་ཤུགས་ཆེན་བྱུང་།",
    "ནང་དོན་གསུམ་པ་དེ་ག་རེ་རེད་ཟེར་ན།",
    "འོ་ན་རྡོ་རིང་ཕལ་མོ་ཆེའི་རྟིང་གདན་ལ་རུས་སྦལ་བྱས་ཡོད་པ་དེའི་ནང་དོན་ག་རེ་ཡིན་ནམ།",
    "སྤྱིར་ན་རྡོ་རིང་གི་རྟིང་གདན་ལ་རུས་སྦལ་གཅིག་པུ་མིན་པར་གླང་ཆེན།",
    "དུས་ནས་དུས་སུ་གནས་དགོས་ངེས་ཡིན་པ་དེ་འདྲ་ཞིག་གི་མཚོན་རྟགས་རེད།",
    "རྡོ་རིང་ཁག་ཅིག་ལ་བོད་པ་རང་གི་གཡུང་དྲུང་རྒྱབ་པ་དེ་དོན་དག་གཅིག་རེད་བསམ་གྱི་འདུག་དཔེར་ན།",
    "ཞྭ་ལྷ་ཁང་གི་རྡོ་རིང་དེ་གཉིས་འོག་ལ་གཡུང་དྲུང་ཡིན་ཞིང་།",
    "དེ་བཞིན་གཡུང་དྲུང་དེ་ཡང་སྲ་ཞིང་བརྟན་པའི་དོན་ཡིན་པས་ན་དེ་གཉིས་དོན་དག་གཅིག་པ་རེད་བསམ་གྱི་འདུག།",
    "རྡོ་རིང་གཅིག་ནི་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་བང་སོའི་མདུན་གྱི་རྡོ་རིང་དེ་རེད།",
    "གཞན་གཅིག་ནི་འཕྱོངས་རྒྱས་ཟམ་ཁའི་རྡོ་རིང་རེད།",
    "ཨ་མེ་རི་ཁར་ཡོད་པའི་ཀྲུང་གོའི་མི་རྒྱུད་ལིས་ཧྥུང་ཀོས་གཉིས་ཀྱིས་དཔྱད་པ་བྱས་པ་རེད།",
    "དང་ཐོག་རྡོ་རིང་དེའི་ཐོག་གི་ཡི་གེ་གསལ་པོ་ཡོད་ཀྱང་ད་ཆ་རྩ་བའི་ཆ་ནས་ཡལ་ཏེ་ང་ཚོས་མཇལ་ཐབས་མི་འདུག་སྤྱི་ལོ་ཆིག་སྟོང་དགུ་བརྒྱ་བཞི་ཅུ་ཞེ་གྲངས་ཀྱི་ལོ་ལ་ལྷ་སར་བསྡད་པའི་དབྱིན་ཇིའི་མི་རི་ཅལ་སེན་གྱིས་དེའི་ཐོག་གི་ཡི་གེ་གསལ་བ་ཁ་ཤས་ཤིག་བཤུས་ཡོད་ཀྱང་ཆ་ཚང་པོ་ཡོད་པ་མ་རེད།",
    "དེ་རྗེས་ལོའི་རྗེས་ལ་ཡི་གེ་དེ་འགྲེམ་སྤེལ་བྱས་པས་རྒྱལ་ཁབ་ཕྱི་ནང་ལ་ཞིབ་འཇུག་བྱེད་མཁན་བྱུང་བ་རེད།",
    "གཙོ་བོ་ཕྱི་རྒྱལ་ལ་ཞིབ་འཇུག་བྱེད་མཁན་དབྱིན་ཇིའི་མི་རི་ཅལ་སེན་དང་ཀྲུང་གོའི་མི་རྒྱུད་ཀྱི་ལིའི་ཧྥང་ཀོས་གཉིས་ཙམ་རེད།",
    "བོད་ཀྱི་རྒྱལ་རྒྱུད་ཀྱི་ཁུངས་དེ་རྒྱ་གར་སོགས་སུ་གཏུགས་ཡོད་མོད།",
    "འོན་ཀྱང་བོད་ཀྱི་རྡོ་རིང་ཁག་དང་ཏུན་ཧོང་ཡིག་རྙིང་ཁག་ཏུ་གསལ་བ་ནི་ཕྱྭ་རྗེ་ཡབ་བླ་བདལ་དྲུག་གི་སྲས།",
    "ཁྲི་བར་ལ་བདུན་ཚིགས་ཞེས་སུ་བཀོད་འདུག་པས་དེའི་ཐད་ལ་དགོངས་བཞེད་ག་རེ་ཡོད་དམ།",
    "དེ་ནི་ང་ཚོའི་རྡོ་རིང་དུ་གསལ་བའི་གཉའ་ཁྲི་བཙན་པོ་དེ་གནམ་རིམ་པ་བཅུ་གསུམ་སྟེང་གི་ཕྱྭ་རྗེ་ཡབ་ལྷ་བདལ་དྲུག་དེ་ལ་སྲས་ཁྲི་བར་བདུན་ཚིགས་ཟེར་བ་ཞིག་ཡོད།",
    "ད་ལྟ་བོད་ཀྱི་རྒྱལ་པོའི་རྩ་བའི་རྒྱལ་རྒྱུད་དེ་སྤོ་བོའི་ཡུལ་གྱི་བུ་ཕྲུག་ཞིག་ཅིག་ལ་སྐྱེས་ཤིང་དམིགས་བསལ་ཅན་གྱི་རྟགས་མཚན་མང་པོ་བྱུང་ཡོད་པའི་ཚུལ་རྣམས་རིམ་བཞིན་ཡུལ་ཡར་ལུང་དུ་སླེབས་ནས་མཐར་བོད་མི་ཚོས་སྐྱེས་བུ་དེ་ཉིད་གཉའ་བར་ཁུར་ནས་བོད་ཀྱི་རྒྱལ་པོ་དང་པོ་གཉའ་ཁྲི་བཙན་པོར་བསྐོས་པ་ཡིན་ཞེས་པ་དེ་རེད།",
    "འདིའི་ནང་གི་ཕྱྭ་ཟེར་བ་འདི་ཡབ་ཀྱི་རུས་རྒྱུད་བོད་ཀྱི་གནའ་བོའི་རུས་གྲགས་ཅན་ཞིག་ཡིན།",
    "ང་ཚོས་ཧ་གོ་བ་ནི་ཁྲི་བར་བདུན་ཚིགས་ཟེར་བ་དེའི་ཡུམ་གྱི་རུས་རྨུ་དང་ཡབ་ཀྱི་རུས་ཕྱྭ་རེད།",
    "ཡབ་རུས་ཕྱྭ་དང་རྨུ་འདི་བོད་ཀྱི་གནའ་སྔ་མོའི་གྲགས་ཅན་གྱི་གདུང་རུས་ཡིན་པ་ནི་གླེང་མེད་རེད།",
    "བོད་ཀྱི་རྒྱལ་པོ་གཉའ་ཁྲི་བཙན་པོའི་མེས་པོ་དེ་ཡབ་ཀྱི་རུས་པ་དེ་ཕྱྭ་རེད།",
    "ཡུམ་གྱི་རུས་རྨུ་རེད།",
    "བོན་གྱི་སྟོན་པ་གཤེན་རབས་མི་བོ་ཆེའི་ཡུམ་གྱི་རུས་ཕྱྭ་རེད།",
    "ཡབ་དེའི་རུས་རྨུ་རེད།",
    "ང་ཚོའི་རྡོ་རིང་ཡི་གེའི་ནང་ལྷ་འཕྲུལ་གྱི་བཙན་པོ་ཞེས་བརྗོད་ཡོད་པ་རེད།",
    "དོན་དམ་པར་མིའི་རིགས་ཀྱི་རིག་པའི་ཐོག་ནས་བལྟས་ན་ལྷ་ཞེས་པ་འདི་རུས་རྩ་ཆེན་ཞིག་གི་མིང་ཡིན་པ་དང་།",
