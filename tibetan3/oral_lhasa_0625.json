    "ད་ཕྱིན་ཆད་རྒྱུད་འདི་འཆད་ཉན་བར་མ་ཆད་པར་ཕྱོགས་བཅུ་མུན་སེལ་བློ་ལ་ཟིན་པ་གྱིས་ཞེས་བཀའ་ནན་ཏན་བསྩལ།",
    "མགུར་སོགས་འདི་དང་འདི་བྲིས་དང་ཡི་གེ་འབྲི་བ་དང་རྩོམ་པ་གཉིས་ཀ་ལ་ཕན་ཞེས་རྒྱུན་པར་བསྐུལ་ཏེ་འབྲེལ་ཡོད་མེད་སྣ་ཚོགས་དང་།",
    "ཕུར་བསྙེན་ལོ་གཅིག་གྲུབ་ནས་སྦྱིན་བསྲེག་བཅས་གྲུབ་པར་བྱས།",
    "གཡས་མེད་བོར་ནས་ཕེབས་པ་འདི་ཅི་ཞིག།",
    "དེ་རིང་སྟོང་པར་བཞག་པ་དེ་ཅི་ལགས།",
    "བཀའ་དྲིན་ཅན་ཞེས་འབོད་པ་དེ་ལགས་ཀྱང་།",
    "མི་མངོན་དབྱིངས་ཕེབས་དུས་སྐབས་དེ་ཅི་འདྲ།",
    "བག་ཕེབས་གུ་ཡངས་རྣལ་འབྱོར་དེ་ཀུན་གྱིས།",
    "རྗེ་ཁྱེད་ཕྱོགས་བཅུའི་ཞིང་རྣམས་ཀུན་བཞུགས་ཏེ།",
    "ཇི་ལྟར་བཞུགས་སྙམ་བསམ་མནོ་ཞིག་བཏང་བས།",
    "ཕྱོགས་བཅུ་མུན་སེལ་ལ་དཔེ་བལྟས་ཅུང་ཟད་བྱས།",
    "སྤྱིར་གནས་དེར་སྔ་སོར་རྒྱལ་བ་འབྲི་གུང་པའི་སློབ་བརྒྱུད་མང་པོ་ཞིག་བཞུགས་ཤུལ་ཡིན་འདྲ།",
    "སྒྲུབ་བཏུས་སུ་བཞུགས་པའི་ཀུ་རུ་ཀུལླེ་ལྷ་ལྔའི་རྗེས་གནང་ཡང་ཞུས།",
    "འདི་ཉིད་བཞུགས་པའི་རི་ཁྲོད་ཀྱི་མདུན་བྲག་རི་མཐོན་པོ་ཞིག་ཡོད་པ་ལ་བྱ་རྒོད་ཀྱི་ལྡིང་བསྐོར་བྱེད་པས།",
    "ཐུགས་ཡེངས་འཁྲུལ་བྲལ་ཀྱང་དབེན་གནས་དེར་བཞུགས་ནས།",
    "བག་ཕེབས་ཏེ་བཞུགས་པའི་གནས་ཚུལ་དེ་དྲན་བྱུང་།",
    "རྗེ་མི་ལ་རས་པ་ལྟ་བུ་ཞིག་སེམས་ལགས།",
    "གནས་རྒྱལ་ཁམས་ངེས་མེད་ཕ་གཞིས་སུ་བྱས་ནས།",
    "མཐོ་མཛེས་ཁང་པར་ཕ་མ་གཉིས་བཞུགས་མཛོད།",
    "དབེན་རི་མི་སྙོགས་ཀ་མེད་དུ་བྱུང་ལགས།",
    "དེ་ནས་རིང་པོ་མ་ལོན་པར་མེ་ཡོས་རང་ལོ་བཅོ་བརྒྱད་སྟེང་།",
    "ཉི་ཟླ་གཉིས་ལ་ཐོས་བསམ་ཡང་ཡང་བྱས་པ་དང་།",
    "ཚེ་སྒྲུབ་པ་སྙོམས་པར་བྱིན་གྱིས་རློབས།",
    "བྱ་རི་དྭགས་བག་ཕེབས་སྐད་སྙན་སྒྲོག།",
    "བྲག་རྡོ་རྗེའི་ཐེམ་སྐས་མཛེས་པར་བཀྲ།",
    "མདུན་ཆུ་གཙང་ལྷ་ཡི་ཡོན་ཆབ་སྟོབ།",
    "བག་ཕེབས་ཏེ་གནས་པས་བློ་སེམས་བདེ།",
    "དེ་ལྟར་བརྩོན་འགྲུས་ལྷོད་མེད་དུ་བྱས་ཀྱང་།",
    "ཀུན་མཁྱེན་ཆེན་པོ་འཇིགས་མེད་གླིང་པ་དཔལ་གྱི་རིར་སྒྲུབ་པ་ལ་བཞུགས་སྐབས་དམ་བཅའ་བདུན་མཛད་པའི་རྗེས་སུ་ཅི་ནུས་བསླབ།",
    "བསམ་ཡས་མཆིམས་ཕུ་རུ་བཞུགས་སྐབས་ཨོག་དཀར་གྱིས་བྱ་ཝང་བསད་པ་དང་།",
    "འཇམ་དཔལ་སྨྲ་སེང་བཟླས་སྒོམ་རྟག་པར་བྱེད་ཀྱི་ཡོད་ཀྱང་འདི་སྐོར་བཟླས་དམིགས་ལ་ཡིད་རྩེས་གཅིག་ཏུ་གཏོད་པས་ཡིན་སྙམ།",
    "རྒྱན་བྱི་དོར་མཛེས་པའི་རྒྱུ་ལགས་ཀྱང་།",
    "དཔེ་རི་དྭགས་རྨས་མ་བཞིན་བསྡད་ནས།",
    "རི་སྟོང་པའི་བྲག་རིའི་དྲུང་བཞུགས་ཏེ།",
    "ཤིང་ལྗོན་བཟང་བྱས་པའི་གྲིབ་བསིལ་དུ།",
    "ཚེ་འདི་སྣང་བྱ་སྤྱོད་འཁྲུལ་པར་མཐོང་།",
    "རྐྱེན་བར་ཆད་མེད་པར་བྱིན་གྱིས་རློབས།",
    "ཡང་ནགས་ཚལ་ཉམས་དགའ་ཞིང་སྤང་ལྗོངས་ཡོད་པ་ཞིག་ཏུ་བསམ་གཏན་གྱི་སྤྱིལ་བུ་ལ་བརྟེན་ནས་ཀྱང་ལོ་ཤས་བསྡད།",
    "དེའི་ཚེ་རང་ཁྱིམ་གྱི་གཡོག་པོ་སོགས་ཁ་ཤས་ཀྱིས་སྤྱིར་མི་དཔོན་གྱི་སྲས་ཕ་མ་ཕྱུག་པོའི་གཅེས་ཕྲུག་དེ་སྔ་སྐྱིད་པོ་ཁོ་ན་ལས་མ་བྱུང་བ་འདི་བྲག་ཕུག་དང་རི་ཁྲོད་འདི་ལྟར་བཞུགས་ཚུགས་པ་ངོ་མཚར་ཆེ།",
    "མི་ཚེའི་ལྷག་མ་ཇི་ཡོད་དབེན་པར་སྒྲུབ་པ་ཁོ་ན་བྱེད།",
    "ཡང་ཏིག་ཡིད་བཞིན་ནོར་བུའི་གླེགས་བམ་འབྲལ་སྤང་བྱས་ནས་འདི་ཁོ་ན་ལ་བློ་གཏད་དེ་མི་ཚེ་རིལ་པོ་ད་ལྟའི་བར་ཉམས་སུ་བླངས་ནས་ཉམས་རྟོགས་ཀྱི་གདེངས་སྐྱེས་པ་མེད་ཀྱང་།",
    "རང་དགོན་ནས་ཐོག་རོལ་སོགས་བཀུར་བཟོས་རྒྱ་ཆེར་གནང་།",
    "ཀོང་སྤྲུལ་སོགས་ཀྱིས་ཕེབས་བསུ་རིང་ཐུང་གསུམ།",
    "སྒོ་འདག་སྦྱར་བྱས།",
    "སེམས་མྱ་ངན་བྱས་པས་ཅི་ལ་ཕན།",
    "ཚེ་ཕྱི་མའི་གཏན་ཆུས་ཟིན་པར་ཤོག།",
    "རང་བྲག་རི་ཆེས་མཐོན་པོ་འབར་ལྷ་རྩེ་རྒྱལ་ཞེས་པའི་རི་མགུལ་བྲག་ཕུག་ཅིག་ཏུ་བསྡད་ཡོད་པ་དེར་འབྱོར་སྐབས་འཇའ་ཚོན་ཤར་བ་སོགས་མཚན་ལྟས་ལེགས་པ་བྱུང་།",
    "སུན་ཟློག་བརྟན་བཞུགས།",
    "བཞེས་འབྲས་གནང་།",
    "སྨྱུག་གུ་དང་བཅས་གནང་།",
    "གདན་ས་རྩེ་ཤོད་ཐམས་ཅད་ལ་རབ་གནས་བཅས་རྒྱས་པ་གནང་།",
    "ཚིག་དོན་མཛོད་ཀྱི་ལུང་འབུལ་དགོས་གསུངས་པའང་བཀའ་བཞིན་ཕུལ།",
    "གཡག་ཕྱར་སྒྲོལ་མའི་གཏེར་གཞུང་མཁྱེན་བརྩེའི་ཕྱག་བྲིས་དངོས།",
    "ཤེས་རབ་མ་ལ་ཡང་བཀའ་བསླབ་དང་རྫོགས་ཆེན་གྱི་ཁྲིད་ཟབ་བསྡུས་ཤིག་གནང་།",
    "ལྕེ་བཙུན་ཆེན་པོ་བི་མ་ལའི་ཟབ་ཏིག་ལ་ཁྲིད་ཅིག་དགོས་གསུངས་པའང་བྲིས།",
    "མཁྱེན་བརྩེའི་གསང་ལམ་བཅས་ཟབ་ཁྲིད་ཀྱི་ལུང་དང་།",
    "སྐབས་དེར་རྡོ་ཁྱི་སྤྱང་སོགས་མགོ་ཡི་དབྱིབས་ཡོད་པ་ཞིག་ཁུར་ཤོག་གསུངས།",
    "ཕྲན་ནས་ཇི་ལྟར་རྙེད་པ་ཞིག་ཕུལ་བས་གནས་འདབས་སུ་མནན་པ་གྱིས་གསུངས།",
    "ཁྱུང་སྤྲུལ་པདྨ་ལགས་དང་གུས་སོགས་ལ་ཡིད་བཞིན་མཛོད་རྩ་འགྲེལ།",
