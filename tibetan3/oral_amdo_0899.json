    "སྙན་ངག་གི་འགྲེལ་བ་དང་དཔེ་བརྗོད་རྒྱས་པ་གཞན་ཞིག་འབྲི་འདུན་གྱིས།",
    "གཞན་ཕན་འོད་ཟེར་སྟོང་གིས་ས་གཞི་ཁྱབ།",
    "འགྲན་བྲལ་སློབ་དཔོན་ཆེན་པོ་ཉིན་མོའི་མགོན།",
    "ཚིག་རྐང་གསུམ་པས་གཞན་ལ་ཕན་གདགས་པ་ནི་འོད་ཟེར་སྟོང་གི་གཟུགས་སུ་བཀོད་པས་གཟུགས་ཅན་གྱི་རྒྱན་དང་།",
    "ཉིན་མོའི་མགོན་ནི་ཉི་མའི་མངོན་བརྗོད་དོ།",
    "སྐྱེ་བོ་གཞན་ལ་ཕན་པའི་འོད་ཟེར་སྟོང་ཕྲག་འབར་བས་ས་ཆེན་ཁྱབ་པའི་འགྲན་ཟླ་དང་བྲལ་བའི་སློབ་དཔོན་འདི་ནི་ཉིན་མོའི་མགོན་པོ་ཉི་མ་ལྟ་བུའོ།",
    "རྐང་བ་བཞི་བས་གྲོགས་པོ་འདི་དཔག་བསམ་ཤིང་རེད་དོ།",
    "གཅོང་རོང་ཤུར་མོའི་ཁྲོ་གཉེར་ཀུན་ནས་བསྡུས།",
    "ས་ཆེན་ཁྱོད་ནི་འཇིགས་རུང་གཤིན་རྗེ་འདྲ།",
    "རི་བོ་འབའ་འབུར་གྱི་སྡང་མིག་གིས་ལྟ་ཞིང་།",
    "གཅོང་རོང་ཤུར་མོའི་ཁྲོ་གཉེར་ཀུན་ནས་བསྡུས་ཏེ་སྐབས་འགར་ཁྲོས་ནས་ཡོམ་ཡོམ་འདར་བར་བྱེད་པའི་ས་ཆེན་ཁྱོད་ནི་འཇིགས་སུ་རུང་བའི་གཤིན་རྗེ་དང་འདྲའོ།",
    "གཉིས་པས་གེ་སེར་སོ་ཕྲེང་གི་གཟུགས་སུ་བཀོད་པ་དང་རབ་བཏགས་དང་འདྲེས།",
    "འོད་དཀར་ལ་བདུད་རྩིའི་འོད་ཟེར་ཞེས་ཚིག་གི་ཉམས་བཏོད་དེ།",
    "རྩི་ནི་དེའི་གཉེན་པོ་ཡིན་ལ་ཚ་བས་གདུངས་པའི་ཚེ་ན་མཚན་མོ་ཟླ་བའི་འོད་ཟེར་ཤར་བའི་ཚེ་བསིལ་བའི་སྣང་བ་འབྱུང་སྟབས།",
    "སྙན་ངག་མཁན་དག་གིས།",
    "ཟླ་བས་བདུད་རྩི་སྤྲོ་བ་ཞེས་ཚིག་གི་རྒྱན་དུ་འཇོག་ལ།",
    "ཉི་ཟླ་ནོར་བའི་རྣ་ཆ་རེས་ཀྱིས་འདོགས།",
    "ཀུན་གསལ་སྒེག་མོ་འདི་ནི་མཛེས་པ་ལ།",
    "ཉི་ཟླ་ནོར་བུའི་རྣ་ཆ་དག་ནི་རེས་མོས་ཀྱི་ཚུལ་དུ་འདོགས་པར་བྱེད་ལ།",
    "རྒྱུ་སྐར་ནོར་བུའི་དོ་ཤལ་གྱིས་སྐུ་ལ་བརྒྱན་པའི་ཀུན་གསལ་སྒེག་མོ་འདི་ཨེ་མ་མཛེས་པ་ལ།",
    "སྒེག་མོ་ནི།",
    "ང་ནི་ལང་ཚོ་དར་ལ་བབ་པའི་མཛེས་པ་དང་ལྡན་ནོ་སྙམ་པའི་ཁེངས་པ་དང་ལྡན་པའི་བུད་མེད་ཡིན་ལ།",
    "ང་ནི་གཟུགས་ལང་ཚོ་ཅན་ནོ་སྙམ་པའི་ང་རྒྱལ་གྱི་རྣམ་འགྱུར་ཕྱིར་ཐོན་པའི་ཉམས་ལ་སྒེག་ཉམས་ཟེར་རོ།",
    "སྤྲིན་ནག་གི་ཡོལ་བ་ཞེས་པའི་གི་སྒྲ་འབྲེལ་སྒྲ་ཡིན་ལ་དེ་བསྡུས་པས་བསྡུས་པ་གཟུགས་ཅན་གྱི་རྒྱན་ཟེར་རོ།",
    "སེར་ཞགས་འཕེན་ཞེས་སེར་བ་ཞགས་པའི་གཟུགས་སུ་བཀོད་དེ་ཚིག་གི་ཉམས་བཏོད་པའོ།",
    "མཁའ་དབྱིངས་དྭངས་མོའི་ཉི་ཟེར་དང་།",
    "རྐང་གཉིས་དག་གི་ཡིད་དུ་འོང་།",
    "ཆུ་ཕྲན་སྔོན་མོ་འདུས་པའི་ཆབ་ཀྱི་རྒྱུན།",
    "སྐྱེལ་ཞིང་འདྲེན་ལ་རྟ་མཆོག་སྔོན་མོ་འདྲ།",
    "འདིའི་རྐང་བ་ཕྱི་མ་གཉིས་ལ་འདྲ་ཞེས་པ་རེ་རེ་ཡོད་པ་ནི་མཚུངས་པ་གསལ་བྱེད་ཡིན་པས།",
    "ཆུ་ཕྲན་སྔོན་མོ་དུ་མ་འདུས་པའི་ཆབ་ཀྱི་རྒྱུན་བབ་ཆགས་ཤིང་དལ་གྱིས་འབབ་པའི་ཆུ་བོ་ཆེན་པོ་འདི་ནི།",
    "སྐྱེལ་འདྲེན་གྱི་ཆེད་དུ་རྟ་མཆོག་སྔོན་མོ་དང་འདྲའོ།",
    "གཞན་ཡང་དོན་དེ་ཚིག་ལྷུག་གི་སྒོ་ནས་དེ་ལས་རྒྱས་ཙམ་བརྗོད་ན།",
    "བློ་ཡི་སྒོ་མོ་འབུམ་ཕྲག་ཡོངས་ཕྱེས་ཏེ།",
    "བློ་ཡི་སྒོ་མོ་འབུམ་ཕྱེས་ཏེ།",
    "ཉིན་མོར་རྒྱུ་བའི་ནམ་མཁའི་ནོར་བུ་མིན།",
    "མཚན་མོར་རྒྱུ་བའི་རི་བོང་ཅན་ཡང་མིན།",
    "འཕྲུལ་གྱིས་བསྐྱེད་པའི་གློག་གི་སྒྲོན་མ་ཡིས།",
    "འཕྲུལ་གློག་གི་འོད་ཤིན་ཏུ་གསལ་བའི་ཚེ།",
    "དམངས་ཀྱི་རེ་བ་སྐོང་བྱེད་ཀྱི།",
    "འདིར་བློ་ལ་འཆར་དཀའ་བའི་དོན་ལ་ཚིག་གི་ཉམས་བཏོད་པས་ཚིག་རྒྱན་དུ་གྱུར་པའོ།",
    "མེ་ཤུགས་གཅིག་གིས་འཐེན་པ་བྱ་ལྟར་མྱུར།",
    "མེ་འཁོར་འདི་ཡིས་སྐྱེ་འགྲོའི་རེ་བ་བསྒྲུབ།",
    "འདི་ནི་བྱ་བ་རང་བཞིན་བརྗོད་པའི་རྒྱན་ཡིན་མོད།",
    "རྟ་མཆོག་སྟོང་གི་འགྲོས་བཟང་བཞིན།",
    "གནམ་ལྕགས་ཐོག་གི་དཔའ་རྩལ་ངོམ།",
    "ཞེས་པའི་ངོམ་དེ་མཚུངས་པ་གསལ་བྱེད་ཀྱི་སྒྲ་ཡིན་པས་དཔེ་རྒྱན་རེད་སྙམ་མོ།",
    "སོར་མོ་ཉི་ཤུ་བཞི་ལ་ཁྲུ།",
    "ཆུ་རྡུལ་བདུན་གྱི་ཚད་ལ་རི་བོང་གི་རྡུལ་དང་།",
    "རི་བོང་གི་རྡུལ་བདུན་གྱི་ཚད་ལ་ལུག་རྡུལ་དང་།",
    "ནས་བདུན་ལ་སོ་མོ་གང་ཟེར།",
    "སོར་མོ་ཉི་ཤུ་རྩ་བཞི་ལ་ཁྲུ་གང་ཟེར།",
    "མིང་གི་ཆུང་མཐའ་ནི་ཡི་གེ་གཅིག་ཡིན་ཏེ།",
    "སྐྱེས་བུ་སྟོབས་ལྡན་ཞིག་གིས་སེ་གོལ་གཅིག་གཏོགས་པའི་ཡུན་ལ་ཆ་དྲུག་ཅུ་རྩ་ལྔ་ཕྱེས་པའི་ཆ་གཅིག་ལ་ཐུང་མཐའི་སྐད་ཅིག་མ་ཟེར།",
    "རྒྱང་རིང་བ་ལ་དཔག་ཚད་སོགས་ཚིག་གི་རྒྱན་དུ་སྦྱོར་བ་ལ་གྲངས་སོགས་ཇི་བཞིན་ཡོད་དགོས་པའི་ངེས་པ་མེད་དོ།",
    "རྟ་མཆོག་སྟོང་གི་སྟོབས་ལས་དྲངས་མཚུངས་ལ།",
    "འདི་དཔེ་རྒྱན་གྱི་ནང་གི་རྣམ་འགྱུར་གྱི་དཔེ་ཞེས་པ་ཡིན།",
    "སྲིད་པའི་ཁམས་ན་བཟོ་ལས་མང་མོད་ཀྱང་།",
    "འདི་ནི་དཔེ་རྒྱན་གྱི་ནང་གི་ཟླ་བོ་དངོས་པོའི་དཔེ་ཡིན།",
    "བདེ་སྐྱིད་པད་མོའི་འདབ་བརྒྱ་ཀུན་ནས་བཞད།",
    "ས་ལ་དཔུང་གི་འཇིགས་ཟིལ་མ་ངོམ་ཞིང་།",
    "མིག་གཉིས་མིག་སྐྱག་གིས་གཡོགས་མིག་ཆུ་བཞུར།",
    "མྱ་ངན་གདོང་གི་ཁ་ནས་སྨྲེ་སྔགས་འདོན།",
