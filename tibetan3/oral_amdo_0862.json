    "ག་ང་ལ་ཐུན་མོང་མོ་ཡིན་པའི་ཕྱིར་ཅེས་བྱ་བ་དེས་འཇིག་རྟེན་གྱི་རྗོད་པའི་སྒྲས་རྗོད་པ་ནི་རྗེས་དཔག་མེད་པར་དགོངས་ཏེ་རྗེས་དཔག་གི་ཡུལ་དངོས་པོ་། ཡིན་ལ་འདིའི་ཡུལ་སྒྲོ་བཏགས་ཡིན་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་སོ།",
    "གཞན་དོན་གྱི་མཚན་ཉིད་ནི་རང་གིས་མཐོང་བའི་རྟགས་གཞན་ལ་སྟོན་པའི་ངག་གོ།",
    "མ་ཡིན་ཏེ་ཁུ་ཚུལ་དང་ཐལ་ལྕག་དང་།",
    "ཐུན་མོང་དུ་རྣམ་གཏོད་པ་དང་བཅུ་དྲུག་གོ་ཞེས་ཟེར་རོ།",
    "དེས་ན་མི་མཐུན་ཕྱོགས་ཁས་བླངས་པས་ཚར་གཅད་མོ་ཡིན་གྱི་སྒྲུབ་པའབྱེད་པའི་ཡན་ལག་མ་ཡིན་པ་རྗོད་པས་ཚར་ཅད་ཡིནནོ།",
    "གལ་ཏེ་དམ་བཙའ་ཁར་མ་ཕྱིང་ཡང་ཞེ་འདོད་དང་རྟགས་འགལ་ན་འགལ་བར་འགྱུར་བ་མ་ཡིན་ནམཁྱེནཡིན་མོད་ཀྱི་འོན་ཀྱད་དམ་བཅའི་སྒོ་ནས་མ་ཡིན་གྱི་རྟགས་འགལ་བས་ཚར་བཅད་ཡིན་ནོ།",
    "དེ་ལྟར་ཡང་ཚར་གཅོད་དོ་ཞེ་ན་ཧ་ཅང་ཐལ་ཏེ་ཕྱོགས་བཀག་པ་ལ་མ་སྒྲ་ན་མི་སྨྲ་ཞེས་བྱ་བ་དང་འབྲོས་ན་འབྲོས་པ་ལསོགས་པ་ཚར་བཅད་གཞན་ཡང་ཐོབ་པའི་ཕྱིར་འོ།",
    "དེ་ལྟ་ན་འབྲེལ་མེད་ཀྱི་དག་ཀྱང་དོན་དང་བྲལ་བ་ལས་ལོག་སུ་བརྗོད་དོགས་ལ་དེ་ལྟར་ཕྱེ་ན་ཧ་ཅང་ཐལ་ལེ།",
    "འདིའང་སྒྲུབ་པའི་ངག་ངེས་པ་ཅན་དུ་ཁས་པལེན་པ་ཁོའི་ཅག་གི་ཕྱོགས་ལ་སྐྱོན་ཡིན་གྱི།",
    "ཤེས་པ་ལསོགས་པའི་ཚའ་གཙད་གཞན་ཡང་དགོས་པས་ཧ་ཅང་ཐལ་ལོ།",
    "དེའང་མཁས་པ་རྣམས་ཀྱི་གཙུག་གི་ནོར་བུ་ཕྱོགས་ཀྱི་གླང་པོས་མུ་སྟེགས་བྱེད་ཀྱི་ལྷག་ཆོད་ན།",
    "མིག་གི་གཟུང་བྱ་ལསོགས་པའི། ། སྒོནུས་མི་རྟག་པར་འགྱུར་གྱི།",
    "གཏན་ཚིགས་ལེན་པ་ཐལ་འགྱུར་མཚུངས།",
    "ད་ངག་གིས་མཚོན་ནུས།",
    "གཉིས་པ་རང་གི་ལུགས་ལ་གཉིས་ལས་དང་པོ་མམཁས་པ་ལ་སྦྱར་བའི་ཚུལ་ནི།",
    "རྒྱུ་ངོ་གཉིས་པ་སུན་འབྱིན་ལ་འང་གཉིས་ཏེ་ཡང་དག་གི་མཚན་ཉིད་སྐྱོན་ལ་སྐྱོན་དུ་བརྗོད་པས་སྐྱོན་ཅན་གོ་བ།",
    "གཏན་ཚིགས་དང་སྒྲུབ་བྱའི་སྐྱོན་གསུམ་མོ།",
    "ངོ་བོའི་སྒོ་ནས་དབྱ་མངོན་དང་བློ་དང་སྒྲ་སྐྱོན་ཅན་གསུམ་མོ།",
    "བརྗོད་ཚུལ་གྱི་སྒོ་ནས་དབྱེ་ན་ལམ་དང་ཐལ་བར་བརྗོད།",
    "དེ་དག་གི་བྱ་བ་མཐའ་ཡས་པས་མ་ཕྱེ་སྟེ།",
    "བརྗོད་ཚུལ་གྱི་སྒོ་ནས་དབྱེ་ན་བརྗོད་པའི་ཚུལ་ལའང་རྒྱུད་དང་ཐལ་འགྱུར་གཉིས་ཡིན་འང་རྒྱུད་བཤད།",
    "ཕྱོགས་སུ་མ་བརྗོད་ན་ཟླཐལ་འགྱུར་བཞི་ལས་བཅུ་བཞི་ཞེས།",
    "བོད་རྣམས་ནི་སྤྱིར་ཐལ་པོ་བཀོང་ཆེད་ཀྱི་དབྱེ་བ་ལ་བཞིར་འདོད་དེ།",
    "ཐལ་བའི་རྟགས་དང་ཁྱབ་པ་གཉིས་ཀ་མ་གྲུབ་པ་དང་།",
    "གཉིས་པ་སྒྲ་བརྟག་པའི་ཕྱིར་མ་བྱས་པར་ཐལ་ཅེས་བརྗོད་ན།",
    "གསུམ་པ་སྒྲ་གཞལ་བྱ་ཡིན་པའི་ཕྱིར་རྟོག་པར་ཐལ་ཅེས་བརྗོད་པ་ན།",
    "གཉིས་པ་སྒྲ་མིག་གི་བཟུང་བྱ་དང་།",
    "དེ་ལ་རྟག་པས་ཁྱབ་པར་སྨྲ་བ་ལ་མིག་གི་བཟུང་བྱའི་ཕྱིར་རྟག་པ་བྲལ་བ་བརྗོད་པ་ལྟ་བུ་སྟེ།",
    "གཉིས་ཀ་མེད་ན་བསལ་པ་ཡེ་མེད་དེ་སྐབས་། གསུམམོ།",
    "རྟག་པར་ཐལ་བརྗོད་པ་ལྟ་བུ་སྟེ་དམ་བཅའ་ལ་བསལ་པ་ཡོདམེད་གསུམ་པོ་སྟེ། མ་ལྟར་རོ་ཞི་པ་ནི་སྒྲ་རྟག་པར་སྨྲ་བ་ལ་རྟག་པའི་ཕྱིར་མ་བྱས་པར་ཐལ་བ་བརྗོད་པ་ལྟ་བུ་སྟེ།",
    "ཐལ་བ་བཅུ་བཞི་པོ་ལ་རྟགས་དང་།",
    "གཞི་ཉིད་མ་གྲུབ་པས་དམ་བཅའ་ལ་ཇི་ལྟར་སེལ་ཞེས་ཟེར་བ་ལ་ཁ་ཅིག་ན་རེ་གཞི་དེ་ཉིད་། ལ་འཇུག་པ་དངོས་གསལ་མེད་ཀྱང་གཞན་ལ་འཇུག་པའི་ཤུགས་བསལ་ཡོད་དེ།",
    "དེ་བཞིན་དུ་སྤྱི་ཅིག་གསལ་བ་དུ་མ་དང་འབྲེལ་པར་ཡོད་ཅེས་ཟེར་བ་དང་ཉམཁའི་ཡོན་ཏན་གྱིས་རྟག་པར་ཡོད་ཅེས་ཟེར་བའི་ཐལ་བ་དང་དབསལ་པའང་ཤེས་པར་བྱའོ་ཞེས་ཟེར་རོ།",
    "ཐལ་འགྱུར་ལའང་ཅི་སྟེ་མི་མཚུངས་ཡང་རྟགས་དང་ཁྱབ་པ་གཉིས་ཀ་མ་གྲུབ་པའང་འབྱེད་རང་རྒྱུད་ལ་ཡང་དག་ལྟར་སྣང་གཉིས་སུ་ངེས་པས་གཞན་གྱིས་ཅི་བྱ་ཅེན་ས།",
    "ཡང་རྟགས་མ་གྲུབ་ལ་ཁྱབ་པ་གྲུབ་པ་ལསོགས་པར་འབྱེད་ན་ལྷ་ཆོད་ཀྱི་དབྱེ་བ་ལྟར་ཅང་ཐལ་ཏེ།",
    "དེས་ན་ཐལ་འགྱུར་བཅུ་བཞིམིན།",
    "རྟགས་ཀྱང་མ་གྲུབ་པ་མ་གྲུབ་པ་ཡིན་མོད།",
    "ཐལ་བ་ཡང་དག་གི་མཚན་ཉིད་ཉི་དཁས་བླངས་ཀྱི་རྟགས་ལསཾམ་འདོད་པའི་བསྒྲུབ་བྱ་འཕེན་པའོ།",
    "དེ་དག་གི་དབྱེ་བ་དཔེར་བརྗོད་པའོ།",
    "དངོས་སུ་ཐལ་བ་ཡངས་པས་བཟློག་ན་ཚུལ་གསུམ་ཚང་བའོ།",
    "ཐལ་བའི་ཁྱབ་པས་རང་རྒྱུད་ཀྱི།",
    "གཉིས་པ་སྒྲུབ་བྱེད་མི་འཕེན་པའི་ཐལ་འགྱུར་གྱི་མཚན་ཉིད་ནི་ཡང་དག་ཐལ་བ་བཟློག་མི་འཕེན།",
    "སུན་འབྱིན་པའི་ཙཐལ་འགྱུར་བཟློག་པ་མི་འཕེན་པའོ།",
    "གསུམ་པ་དེ་དག་གི་དབྱེ་བ་དཔེར་བརྗོད་ན་གཉིས་ལས་དང་པོ་སྒྲུབ་བྱེད་འཕེན་པ་དང་།",
    "ས་ཕྱོགས་ན་བུམ་པ་མ་དམིགས་པའི་ཕྱིར་མེད་པར་ཐལ་ཅེས་པ་རང་བཞིན་མི་དམིགས་པ་དང་།",
    "སྣོག་ལྐོག་ཤལ་དང་མི་ལྡན་པས་བ་གླང་མ་ཡིན་པར་ཤལ་ཞེས་པ་ཀླུ་ཕྱིན་མི་དམིགས་པའི་བྱེ་བྲག་གསུམ་ལ་སྒྲུབ་བྱེད་ལེན་པ་གི་བདུན་མི་རུང་སྟེ།",
