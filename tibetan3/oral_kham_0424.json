    "གང་ཡང་རང་རྒྱལ་བ་རྣམ་པ་གཉིས་ལ་བསེ་རུ་ལྟར་གཅིག་པུར་སྤྱོད་པ་དང་།",
    "མང་པོ་ཉེ་བར་འདུག་པ་ལ།",
    "ནང་བསྟན་གཞུང་ལུགས་ཀྱི་གསེང་བར་དག་ན་ཐྐོར་ཞྱིང་གར་བའྱི་ལམ་ཡྱིག་དེ་རྣམས་ཁུ་བསྡུ་བྱས་ནས་ལམ་རྱིམ་ཞེས་ཟུར་གསལ་གྱི་ག་ེགས་བམ་ཞྱིག་བསྐྲུན་འདུག་པ་ནྱི།",
    "ཁྐོང་གསྐོན་པའྱི་རྱིང་ལ་གཞན་ཕན་གྱི་བྱ་བ་དང་རང་གྱི་ཉམས་ལེན་རྣམས་ཡག་ཐག་ཆྐོད་བྱས་ཡྐོད།",
    "དེ་ནས་དེ་རྱིང་འདྱིར་རྒྱ་ཡྱི་དགེ་སླྐོང་དང་རབ་བྱུང་མའམ་བཙུན་མ་དགའ་རབ་འབྐོར་ཆེན་ཞྱིག་འདུག་ཅྱིང་།",
    "ཉྱི་ཤུ་རྩ་བདུན་འདུག་ཞུས།",
    "བདེ་བ་འདྐོད་པ་དང་སྡུག་བསྔལ་མྱི་འདྐོད་པ་ཡང་རང་གྱི་ངང་གྱིས་ཡྐོང་བས།",
    "ང་ལ་རྐོག་དྲྭ་དང་འགལ་རྐེན་བཟྐོ་གྱི་འདུག་སྙམ་པའྱི་ཐྐོག་ནས་ཁྐོ་ལ་མྱི་དགའ་བའྱི་བྐོ་ཞྱིག་བསྐྱེད་པའྱི་རྐེན་བྱས་ཏེ།",
    "དེ་ཀུན་ནས་སླྐོང་བྱེད་ཀྱི་ཉྐོན་མྐོངས་གཅྱིག་བཅས་བསམ་བྐོའྱི་ནང་ལ་ཡྐོང་སྟངས་རྱིམ་པ་གཉྱིས་འདུག་ཡང་སྐོ་སྐོའྱི་འདྐོད་པའྱི་དྐོན་ཞྱིག་ཡྱིན་ན།",
    "བྐོ་གཅྱིག་གྱིས་ཡག་པྐོ་མྱི་འདུག་ཅེས་སང་བ་བྱས་ཏེ་རྒྱབ་ཀྱིས་ཕྐོགས་ནས་ཕར་བསྐད་པས།",
    "སྡུག་བསྔལ་སངས་པའྱི་བྲལ་བ་ཞྱིག་མངྐོན་དུ་བྱ་སྙམ་པའྱི་བྐོ་སྐྱེ་ཡྱི་འདུག་དེ་འདྲ་དེ་ཇྱི་ལྟར་འཐྐོབ་དགྐོས་སམ་ཞེ་ན།",
    "འགལ་ཟླ་དེ་བསྒྲུབ་ཐུབ་འདུག་མྱི་འདུག་ལ་བསམ་བྐོ་བཏང་བ་ན།",
    "ཚིག་འདྱིའྱི་རྒྱ་སད་དུ་ཕུང་པྐོ་ལྔ་བྐོ་དེ་དག་ཀང་ཞེས་པའྱི་ཀང་སྒ་ཞྱིག་འདུག་གམ་མྱི་འདུག་ཀང་སྒ་མྱི་འདུག་ཞུས་པར།",
    "ཀང་སྒ་མྱི་འདུག་གམ།",
    "ཕུང་པྐོ་ལྔ་བྐོ་དེ་དག་ཀང་རང་བཞྱིན་གྱིས་སྟྐོང་པར་རྣམ་པར་ཟེར་བ་ཞྱིག་མྱི་འདུག་གམ།",
    "ཀ་བ་འདྱི་སད་ཅྱིག་སད་ཅྱིག་གྱིས་འགྱུར་བསད་པ་ཞྱིག་མཐྐོང་གྱི་འདུག་པས།",
    "རྒྱ་ཆེ་བའྱི་ལམ་གྱི་རྱིམ་པའྱི་སྐོར་དེ་ཧ་ཅང་རྒྱས་པྐོ་འདུག་སྟབས།",
    "སེམས་ཀྱི་ཕྱིན་ཅྱི་ལྐོག་གྱི་རྐོག་པ་ལ་ཁ་གཏད་གཅྐོག་པར་ཚིག་དེ་ཧ་ཅང་ནུས་ཤུགས་ཆེན་པྐོ་འདུག་པས།",
    "ཐ་སྙད་དུའང་རང་མཚན་ཞལ་གྱིས་མྱི་བཞེས་པའྱི་ཀླུ་སྒྲུབ་ཀྱི་རྒྱུན་འཛིན་རྱིགས་གཅྱིག་བཅས་རྱིགས་གཉྱིས་ཡྐོད་པའྱི་ནང་ནས།",
    "དེ་ཚེ་དེའྱི་དུས་ན་ནཱ་ལེནྜ་ནྱི་རྒྱ་གར་གྱི་ཤེས་ཡྐོན་གྱི་བསྟྱི་གནས་ཤྱིག་ཡྱིན་ཚོད་འདུག་ནཱ་ལེནྜའྱི་མཁས་པས་ལེགས་སྦྱར་གྱི་གཞུང་རྣམས་སཾ་སྐྱི་ཏའྱི་ནང་རྩྐོམ་པར་མཛད་མཁན་གྱི་ཀླུ་སྒྲུབ་ལ་སྐོགས་པ་དེ་དག་ནཱ་ལེནྜའྱི་མཁས་པ་ཤ་སྟག་ཆགས་འདུག་པར་མ་ཟད།",
    "བཱྱི་ཀ་མ་ལ་ཤྱི་ལའྱི་སླྐོབ་སྦྱྐོང་གནང་སའྱི་གཞུང་རྣམས་ཀང་ནཱ་ལེནྜའྱི་མཁས་པས་བརྩམས་པའྱི་གཞུང་རང་ཆགས་ཡྐོད།",
    "རང་རང་གྱི་སྟྐོན་པ་ལ་སྐུ་ཡྱི་སྐོ་ནས་བསྟྐོད་པ་དང་།",
    "དེ་བཞྱིན་དུ་སྐོ་སྐོའྱི་ཁྱིམས་སྲུང་བ་རྣམས་ཆྐོས་ལུགས་ཚང་མར་འདུག་པས།",
    "དེ་ལྟ་བུའྱི་རྱིགས་གཅྱིག་ཀང་ཡྐོང་ག་ྱི་འདུག་ཡང་དཔེར་ན་ས་རཱ་ཧས་མཛད་པའྱི་དྐོ་ཧ་ལ།",
    "ངས་དེ་ཙམ་ཤེས་ཀྱི་མེད་ཀང་རང་གྱི་ཉམས་མྐོང་ལ་བལྟས་ན།",
    "ཆྐོས་ཚན་གཞན་ཁ་ཤས་ཀང་ཡྐོད་ཚོད་འདུག་ཀང་གཙོ་བྐོ་ལམ་སྒྐོན་ཡྱིན་སྟབས།",
    "རང་དྐོན་ལ་སྐོན་ལམ་གཅྱིག་པུ་མྱིན་པར་ཆ་ཚང་རྡྐོག་རྡྐོག་ལྟ་བུ་ཞྱིག་དགྐོས་ཀྱི་འདུག་ཀང་།",
    "བསམ་བྐོ་དེ་ཙམ་མྱི་གཏྐོང་བར་ཙོག་གེར་སྐོད་པ་ལྟ་བུ་ཞྱིག་ལ་སྐོམ་ཟེར་གྱི་འདུག་པ་དེ་ནྱི་སྐོམ་རྱིགས་གཅྱིག་ཡྱིན།",
    "ཁྱིམས་བཏང་ནས་བཅྐོ་ཐུབ་མྱི་འདུག་སྔ་མྐོའྱི་སུའུ་ལེན་ཨུ་རུ་སུ།",
    "ཕན་ཐྐོགས་གང་ཡང་བྱུང་མྱི་འདུག་རྒྱ་ནག་ལ་ཆ་བཞག་ཀང་ལེ་ཉྱིན་དང་མར་ཁེ་སྱིའྱི་རྱིང་ལུགས་ཀྲུའུ་ཡྱི།",
    "བྐོ་དང་ལྡན་པ་ཞེས་པའྱི་རྣམ་དཔྐོད་མེད་ན་དཔད་པ་བྱེད་མྱི་ཐུབ་པས་རྣམ་དཔྐོད་དགྐོས་ཀྱི་འདུག་པ་ལྟར།",
    "ནམ་རྒྱུན་ཁྱེད་ཚོས་འདྐོན་པའྱི་སྐོན་ལམ་དེ་ཡང་ཀུན་སླྐོང་བཅྐོས་རྒྱུར་ཧ་ཅང་འགྱིག་འདུག་དུག་གསུམ་ཉྐོན་མྐོངས་སེལ་བར་ཤྐོག།",
    "བྐོད་སད་ནང་ཡྐོད་པ་ཞྱིག་གསར་དུ་བསྒྱུར་ནས་ལས་ཀ་བྱ་དགྐོས་དྐོན་མྱི་འདུག་འྐོན་ཀང་དམྱིགས་བསལ་ཁ་ཤས་ཡྐོང་སྱིད།",
    "ནམ་རྒྱུན་ཁྱེད་ཚོས་འདྐོན་པའྱི་སྐོན་ལམ་དེ་ཧ་ཅང་ཡག་པྐོ་འདུག་པར་ཀུན་སླྐོང་བཅྐོས་ཚུལ་ཡང་ཚང་འདུག་ཕྐོགས་གཅྱིག་ནས་ཁྱེད་ཚོས་འདྱིར་གདངས་འཐེན་དུས་མྱི་སུས་ཉན་ཡང་།",
    "དེ་ཡག་པྐོ་མྱི་འདུག་གམ།",
    "ཁྱེད་ཚོ་ཐའེ་ཝན་གྱི་ནང་ལ་དབུལ་ཕྱུག་གྱི་ཁྱད་པར་ཏྐོག་ཙམ་ཉུང་བ་ཡྐོད་ཚོད་འདུག་ཀང་།",
    "དབུལ་ཕྱུག་གྱི་ཁྱད་པར་ཧ་ཅང་ཆེན་པྐོ་འདུག་དེ་བཞྱིན་དུ་ར་ཤྱི་ཡའྱི་ནང་ལ་ཆ་བཞག་ཀང་།",
    "དབུལ་ཕྱུག་གྱི་ཁྱད་པར་ཧ་ཅང་ཆེན་པྐོ་འདུག་ལ།",
    "སྤྱིར་བཏང་གྱི་དུད་འགྐོ་ར་ལུག་དང་ཕག་པ་ཅྱི་ཙམ་གསྐོད་ཀྱི་འདུག་དེ་བཞྱིན་ཉ་ལ་སྐོག་གྱི་འདུ་ཤེས་ཙམ་ཡང་མེད་པའྱི་རྐེན་གྱིས་ཁྐོར་ཡུག་ལའང་སྐྱྐོན་བྱེད་ཀྱི་ཡྐོད་པས།",
    "མྱི་ཚང་མ་སྐྱྐོ་བྐོ་ཡྐོང་བར་ཤྐོག་ཅེས་སྐོན་ལམ་བརྒྱབ་ན་ཅྱི་འདྲ་ཞྱིག་འདུག་དེ་ཡང་ལྐུགས་རགས་ཡྱིན་པས།",
    "ཡྱིན་ན་ཡང་ཡེ་ཤུའྱི་ཆྐོས་པ་རྱིགས་ཁ་ཤས་ཀྱིས་སྟྐོང་པ་ཉྱིད་ཀྱི་ལྟ་བ་ལ་དྐོ་སྣང་བྱེད་ཀྱི་འདུག་མྐོད།",
    "༡༩ཞེས་གསུངས་འདུག་ཅྱིང་།",
    "སྐོ་སྐོའྱི་ཆྐོས་དར་སེལ་བྱས་ཀང་ཁྱད་པར་དེ་ཙམ་མྱི་འདུག་མྐོད།",
    "དེ་བཞྱིན་དུ་ཀྲུང་གྐོ་ཏཱ་ལུའུ་ལའང་དེ་འདྲ་ཡྐོད་ཚོད་འདུག་ར་ཤྱི་ཡའྱི་ནང་ལ་ཡང་དེ་འདྲ་ཡྐོང་གྱི་འདུག་པས་དེ་ཚོར་གཟབ་གཟབ་བྱ་དགྐོས།",
    "ར་བ་མང་པྐོ་ཡྐོད་མེད་ཀྱིས་བརྩྱི་ཡྱི་ཡྐོད་ཚོད་འདུག་དངྐོས་གནས་མཚན་ཉྱིད་ཚང་བའྱི་བ་མ་དབྱུག་གུ་བསྣམས་ནས་ཕེབས་མཁན་ཚོར་དེ་ཙམ་དྐོ་སྣང་བྱེད་ཀྱི་མེད།",
    "ཞེས་པ་ཞྱིག་འདུག་པ་ནྱི་རྒྱ་སད་ཀྱི་ཚིག་དེ་ཚུར་བསྒྱུར་བ་ཡྱིན་པས།",
    "ཚིག་དེའྱི་གྐོ་བ་ལ་འཁྲུག་ཉེན་ཆེན་པྐོ་འདུག་ར་བ་དད་པ་སྦྱངས་ཏེ་བསམ་དང་སྦྱྩོར་བས་བསྟེན་ཚུལ།",
    "བྐོད་ལ་བ་མའྱི་རྣལ་འབྱྐོར་ཞེས་ཟུར་གསལ་ཞྱིག་མཛད་འདུག་བ་མའྱི་རྣལ་འབྱྐོར་ཞེས་པ་བ་མའྱི་སྐུ་སྐོམ།",
    "དགྐོང་མྐོ་ཉལ་ཁར་ཞྐོགས་པ་སྐོན་ལམ་བརྒྱབ་པ་བཞྱིན་བྱུང་འདུག་མྱི་འདུག་བསམ་བྐོ་བཏང་སྟེ།",
    "སྡུག་པྐོ་ཞྱིག་བྱུང་ན་དངྐོས་གནས་ངས་ནྐོར་འཁྲུལ་བྱས་འདུག་པས་ངས་བཤགས་ཀྱི་ཡྱིན་བསམ་ཞྱིང་།",
    "གཡྐོ་བ་མེད་པའྱི་བསམ་གཏན་སྐོམ་པ་སྐོགས་ཡྐོད་ཚོད་འདུག་མཁན་ཆེན་ཞྱི་བ་འཚོས་དབུ་འཁྱིད་དེ་ལྐོ་ཙཱ་བ་བནེ་ཡེ་ཤེས་སེ་སྐོགས་བཞུགས་ཏེ་བསྟན་བཅྐོས་བསྒྱུར་ས་ལ་སྒ་སྒྱུར་ལྐོ་པཎ་གྱིང་ཞེས།",
    "ཁྐོང་ཁྐོ་དང་ཞེ་སང་ཡང་རང་གྱི་ངང་གྱིས་སྐྱེ་བ་དང་།",
    "སབས་འདྱིར་ཆྐོས་ལ་སྐྱྐོན་དུ་བལྟས་ནས་ཆྐོས་སྐོང་མཁན་དེ་དང་ཆྐོས་ཉམས་སུ་ལེན་མཁན་གཉྱིས་ལས་བསམ་བྐོའྱི་ནང་ལ་སུ་སྐྱྱིད་པྐོ་ཤུགས་ཆེ་བ་འདུག་ཚད་བསྡུར་བྱས་ན།",
    "གཞན་དྐོན་ཉྱི་ཚེ་བ་དང་རང་དྐོན་གྱི་སངས་རྐོགས་ཉྱི་ཚེ་བ་ཙམ་ལས་ཡྐོང་གྱི་མེད་ཀང་།",
    "རང་ཕྐོགས་ཀྱི་བདེ་སྡུག་དེ་རག་པ་བརན་པ་ལྟ་བུ་ཞྱིག་ཏུ་བསམ་བྐོ་ལ་འཁྐོར་བའྱི་རྐེན་གྱིས་རང་གཞན་ཕུང་ལ་སྦྱྐོར་བའྱི་ལས་མང་པྐོ་ཞྱིག་གསྐོག་གྱི་ཡྐོད་པ་ཧ་ཅང་གསལ་བྐོ་འདུག་ལྐོ་རྒྱུས་ནང་ལ་ཡྐོད་པའྱི་རང་གཞན་ཕུང་ལ་སྦྱྐོར་མཁན་གྱི་མྱི་དེ་དག་གྱི་བསམ་བྐོའྱི་ནང་ལ།",
    "རྩ་བའྱི་གསལ་རྱིག་གྱི་སེམས་དེའྱི་རྱིགས་འདྲའྱི་རྒྱུན་གནས་པ་ལ་འགལ་རྐེན་ནམ་འགལ་ཟླ་གཞན་མྱི་འདུག་པས།",
    "ཆྐོས་པའྱི་ནང་ནས་མགྐོ་ལྐོག་བཙལ་མཁན་འདུག་ཅེ་ན།",
    "ཁ་ཆེ་ཚོ་ལ་ཡང་ཧ་ཅང་ཕན་ཐྐོགས་ཆེན་པྐོ་ཡྐོད་ཚོད་འདུག་ཅེས་ཟེར་གྱི་འདུག་སྤྱིར་བཏང་ཁ་ཆེ་མང་པྐོ་ཞྱིག་གྱི་བསམ་བྐོའྱི་ནང་ལ་ནང་པའྱི་ཆྐོས་དེ་ཆྐོས་མྱིན་པར་ངྐོས་འཛིན་བྱེད་ཀྱི་ཡྐོད།",
    "ཌ་ལ་ཕྱིན་པའྱི་སབས་སུ་ངྐོ་རྒྐོལ་བྱེད་མཁན་གྱི་ཡེ་ཤུའྱི་ཆྐོས་པ་མྱི་ཁ་ཤས་ཤ་ྱིག་འདུག་ཡྱི་གེ་ཞྱིག་འཁྱེར་ནས་ཏཱ་ལའྱི་བ་མ་སེར་ལ་ངྐོ་རྒྐོལ་གང་ཡང་མེད།",
    "སྱི་ཝྱི་ཊྱིན་ལ་ཕྱིན་པའྱི་སབས་སུ་ངྐོ་རྒྐོལ་བྱེད་མཁན་མྱི་གཅྱིག་འདུག་ཁྐོས་ང་ལ་ངྐོ་རྒྐོལ་བྱེད་ཀྱི་ཡྐོད་ཀང་ངས་ཤེས་མ་སྐོང་།",
    "མུར་རྐོག་བསྐོངས་ནས་ཁུ་ཚུར་བཅངས་ཏེ་སང་མྱིག་ལྟ་ཡྱི་འདུག་པས།",
    "ཁྐོ་བྐོད་ཀྱི་རྒྱལ་རྩེ་ལ་ཡང་ཕྱིན་འདུག་དེར་ལྷ་ཁང་ཞྱིག་གྱི་ནང་ལ་ཕྱིན་པར་ལྷ་ཧ་ཅང་རྱིག་པྐོ་མཆེ་བ་གཙིགས་ཤྱིང་།",
    "རྒྱུ་ངན་པ་ཞྱིག་གྱིས་བསྐྱེད་པའྱི་འབྲས་བུ་དེ་ཡང་རང་ཤུགས་ཀྱིས་ངན་པ་ཆགས་ཡྐོད།",
    "དེ་ཡང་རང་གཅྱིག་བུའྱི་ཆེད་དུ་བསམ་པ་མྱིན་པར།",
    "འགག་ལ་ཐུག་དུས་ཕན་ཐྐོགས་པའྱི་ཆྐོས་ཤྱིག་བྱ་དགྐོས་པ་གལ་ཆེན་པྐོ་ཡྱིན།",
    "ལུང་པ་ཡར་རྒྱས་ལའང་གནྐོད་ཀྱི་འདུག་རང་བདེ་དྐོན་གཉེར་གྱིས་ཚེ་མང་པྐོར་སྐོད་རྒྱུར་ཁང་པ་རྒྱག་པ་དང་།",
    "དུར་མཆྐོད་བྱས་ཏེ་དྲན་གསྐོ་བྱེད་ཀྱི་འདུག་པས།",
    "ཁ་ཆག་སྣ་རལ་ཧ་ཅང་མང་པྐོྐོ་ཡྐོང་གྱི་འདུག་པས།",
    "དཀྐོན་མཆྐོག་གྱིས་དྲང་མྐོ་གནང་གྱི་མྱི་འདུག་ཟེར།",
    "དེ་དག་རྐོག་དྲྭ་ཧ་ཅང་ཚ་པྐོ་འདུག་འུ་ཐུག་པའྱི་ལན་ལྟ་བུ་ཞྱིག་ཡྱིན་ཡང་།",
    "སྐྱེ་བ་སྔ་ཕྱི་ཁས་བངས་ན་བྐོ་བདེ་བ་འདུག་ཟེར།",
    "ཉེ་ཆར་ཕྲུ་གུ་ལྐོ་གསུམ་ཅན་པ་ཞྱིག་འདུག་ཕྲུ་གུ་དེའྱི་སྐྱེ་བ་སྔ་མ་རླངས་འཁྐོར་ཁ་ལྐོ་བ་ཞྱིག་ཡྱིན་པ་དང་།",
    "རླངས་འཁྐོར་བརྡབས་ནས་གྐོངས་པ་ཧ་ཅང་གསལ་བྐོ་དྲན་གྱི་འདུག་ཚན་རྱིག་པ་ཞྱིག་ས་ཆ་གང་སར་ཕྱིན་ནས་སྐྱེ་བ་སྔ་མ་དྲན་མཁན་ལ་ཞྱིབ་འཇུག་བྱས་ཏེ།",
    "ད་དུང་ཁ་ཤས་ཀྱིས་དང་དྐོད་བྱེད་ཀྱི་འདུག་འདྱི་ལྟར་བྱས་ན།",
    "ལས་འདྱི་དང་འདྱི་ལྟ་བུ་བསགས་ན་ཉེན་ཁ་འདྱི་དང་འདྱི་ལྟ་བུ་འདུག་སྙམ་པའྱི་བསམ་བྐོ་ཞྱིག་འཁྐོར་བ་ཡྱིན་ན།",
    "བཟྐོད་ཐུབ་མྱི་འདུག་སྙམ་པ་ཞྱིག་བསམ་བྐོའྱི་ནང་ལ་ཤུགས་ཆེན་པྐོ་ཞྱིག་སླེབས་ན།",
    "ཆགས་སང་སྐྱེ་བའྱི་བྐོ་ངྐོར་སྣང་བ་བཞྱིན་བཟང་ངན་ཚུགས་ཐུབ་པར་མེད་པ་ཧ་ཅང་གསལ་བྐོ་འདུགདེ་ལྟ་བུའྱི་སྐོ་ནས་བསམ་བྐོ་བཏང་བ་ན།",
    "རྐེན་ངན་ཅྱི་འདྲ་ཞྱིག་དང་འཕད་ཀང་དེ་ལས་ཡྱིན་པས་བཅྐོས་སུ་མྱི་འདུག་བསམ་ན།",
    "ཉམས་ལེན་བྱས་ན་དངྐོས་གནས་མྱི་ཚེ་འདྱིའྱི་ནང་ལ་སྐྱྱིད་པའྱི་སྐྱྱིད་མག་ྐོ་ཚུགས་པ་ལྟ་བུའྱི་ཁ་ཡྐོད་ལག་ཡྐོད་ཀྱི་ཕན་ཐྐོགས་ཧ་ཅང་ཆེན་པྐོ་འདུག་པས།",
    "༧༢ཞེས་གསུངས་པ་ལྟར་གྱི་ཡྐོན་ཏན་ཤེས་པ་ལ་དམྱིགས་བསལ་ཞུ་དགྐོས་པ་མྱི་འདུག་ཅྱིང་།",
    "ཆྱི་ལྱིའན་ཟེར་བའྱི་ཚན་རྱིག་པ་སད་གགས་ཆེན་པྐོ་ཞྱིག་འདུག་ཁྐོས་ཁྐོ་རང་ཚན་རྱིག་པ་ཞྱིག་ཡྱིན་པའྱི་ཆ་ནས།",
    "མྱི་ཁ་ཤས་ཀྱིས་དེའྱི་རྱིགས་ཧ་ཅང་རྩ་ཆེན་པྐོར་བརྩྱི་ཡྱི་འདུག་པ་ནྱི་ནྐོར་འཁྲུལ་ཡྱིན།",
    "དགེ་སྱིག་གྱི་ལས་ཅྱི་ཞྱིག་ཡྱིན་ཀང་རང་ག་ྱིས་བསགས་ཟྱིན་པ་ཡྱིན་ན།",
    "ཞེས་བ་མ་ཧ་ཅང་རྩ་ཆེན་པྐོར་བརྩྱི་བ་དེ་མུ་སྟེགས་པའྱི་ནང་ལའང་ཤུགས་ཆེན་པྐོ་འདུག་པར་མ་ཟད།",
    "དངྐོས་གནས་ཚེ་བྐོས་བཏང་སྟེ་དཀའ་ལས་རྒྱག་བའྱི་མུ་སྟེགས་པའྱི་ཉམས་ལེན་པ་ཧ་ལས་པ་དེ་འདྲ་འདུག་དེ་ཚོར་ཡང་བཤེས་གཉེན་བསྟེན་ཚུལ་ཡྐོད་པར་མ་ཟད།",
    "འཆྱི་བ་མྱི་རག་པ་བསམ་ནས་ཚེ་འདྱི་བྐོས་བཏང་སྟེ་ཧ་ལས་པའྱི་སྒྲུབ་པ་ལ་དཀའ་སྤད་སྙྱིང་རུས་བྱེད་མཁན་ཡང་འདུག་མྐོད།",
    "ནང་པའྱི་ཚན་རྱིག་གྱི་སེ་ཚན་ལས་ཕྱིའྱི་དངྐོས་ཁམས་རྱིག་གནས་ཀྱི་སྐོར་ལ་རྱིག་གསར་གྱི་ཚན་རྱིག་ནས་ཚུར་ལེན་རྒྱུ་ཧ་ཅང་མང་པྐོ་འདུག་ཅྱིང་གལ་ཡང་ཆེན་པྐོ་འདུག་ནང་པའྱི་ཞེན་ཁྐོག་ཡྐོད་མཁན་ཞྱིག་གྱིས།",
    "མྱི་འདྐོད་པའྱི་བྐོ་སྐྱེས་པའྱི་མཚམས་སུ་རྒྱུ་རྐེན་གང་གྱིས་བྱས་འདུག་བརྩད་བཅད།",
    "སྐྱེས་པའྱི་ཉྱི་མ་དང་པྐོ་རང་ལ་མགྐོ་རྱིང་བསླྐོགས་ཏེ་ཉེས་རྡེག་གཟེད་ཀྱི་འདུགཟྱི་ལྱིང་ལ་ཤྱིང་མངར་ཞེས་པའྱི་ཤྱིང་རྐོ་མངར་བ་ཞྱིག་ཡྐོད།",
    "ང་སྐྱེས་མ་ཐག་ཀང་སྤད་འདུག་པར།",
    "ང་རང་སྐྱེས་མ་ཐག་ཆུ་ཧ་ཅང་མང་པྐོ་འཐུང་བ་དེ།",
    "ནམ་རྒྱུན་འགྐོ་འཆག་ཉལ་འདུག་གྱི་སྤྐོད་ལམ་དང་།",
    "ནམ་རྒྱུན་ང་ལ་ཡྱིད་དུ་འྐོང་བར་སྣང་གྱི་འདུག་ཟེར་བ་བཞྱིན།",
    "འདྱི་ཡང་རང་གྱི་དམྱིགས་པ་ལ་ཞེན་ཅྱིང་ཆགས་ནས་དམྱིགས་པ་དེ་དང་དབྲལ་དཀའ་ཞྱིང་ཡུལ་དེ་ལ་ཐྱིམ་པ་ལྟར།",
    "ཤྱིང་འཚམ་པ་ཞྱིག་མཐྐོང་གྱི་འདུག་འདྐོད་པ་ནྱི།",
    "སྤྱིར་བཏང་ཐེ་ཚོམ་ལའང་ཉྐོན་མྐོངས་ཅན་ཡྱིན་པས་ཁྱབ་པ་མྱི་འདུག་པར།",
    "ཕུང་པྐོ་བྐོ་ཡུལ་དུ་ཤར་ནས་ང་ཞེས་ང་དྐོན་སྟེང་དུ་དང་རང་བཞྱིན་གྱིས་གྲུབ་པར་སྣང་ཞྱིང་།",
    "ཕུང་པྐོ་བདེན་འཛིན་དེ་ཉྱིད་ཉྐོན་མྐོངས་ལ་འཇྐོག་འྐོན་ཀང་རང་རྒྱུད་པ་མན་ཆད་ཀྱིས་ཆྐོས་ཀྱི་བདག་འཛིན་དེ་ཉྐོན་སྒྱིབ་ལ་འཇྐོག་མ་ཤེས་པར་ཤེས་སྒྱིབ་ལ་བཞག་པས་ན།",
    "འཕལ་དུ་ཡྱིན་ནའང་རང་སེམས་འཁྲུག་སྟེ་མྱི་སྐྱྱིད་པར་བྱེད་པ་དང་ཆབས་ཅྱིག་སེམས་འཁྲུག་ཡྐོང་བ་ན་ཡྱིན་ལུགས་འཇལ་བའྱི་བྐོའྱི་ནུས་པ་ཉམས་འགྐོ་བ་ཧ་ཅང་གསལ་ཏེ།",
    "དེ་དགྐོས་ཀྱི་འདུག་སྙམ་དུ་མཐྐོང་བ་ཡྱིན་པས།",
    "སྤྐོད་འཇུག་གྱི་ཚིག་འདྱི་ཧ་ཅང་ནན་པྐོ་ཞྱིག་འདུག་ཞེ་སང་སེད་སྐོགས་དག་རྣམས་ནྱི།",
    "གྐོ་རྱིམ་དེ་ཧ་ཅང་ཡག་པྐོ་ཞྱིག་གསུངས་འདུག་ཐྐོག་མར་ཡྱིད་ལ་བྱེད་པ་ཡྱིན་ནམ་གྐོ་རྱིམ་ཡྐོད་མེད་མྱི་ཤེས་ཀང་།",
    "ཀུན་འབྱུང་རང་ག་བ་ཡྱིན་པས་འཁྐོར་བའྱི་འཁྐོར་ལྐོ་བསྐོར་བ་ཡྱིན་ནྐོ།",
    "དེ་དང་རང་གྱི་སྐྱེ་གནས་ཀང་མཐྐོང་ངྐོ།",
    "རྒྱ་ཡྱི་དགྐོན་པ་དང་གཙུག་ལག་ཁང་རྣམས་ཀྱི་སྐོ་ཕྐོར་གྱི་འྐོག་ལ་སྱིད་པའྱི་འཁྐོར་ལྐོ་ཆ་ལྔ་བ་འབྲྱི་བའྱི་ལུགས་སྐོལ་འདུག་གམ།",
    "ཕ་མའྱི་ཁུ་ཁག་འདུས་པའྱི་སབས་ལ་ཉྱིང་མཚམས་སྦྱར་བ་ལ་ངེས་པ་དམྱིགས་བསལ་མྱི་འདུག་དེང་སང་དངྐོས་སུ་ཤེལ་དམ་གྱི་ནང་དུའང་ཉྱིང་མཚམས་སྦྱར་བ་ཡྐོང་གྱི་ཡྐོད།",
    "ལུས་མཛེས་པྐོ་ལས་སེམས་མཛེས་པ་གལ་ཆེ་བར་འདུག་ལུས་ཧ་ཅང་མཛེས་པྐོ་ཡྐོད་ཀང་བསམ་པ་སྡུག་ཅག་ཡྐོད་ན།",
    "འཛམ་བུའྱི་གྱིང་འདྱིའྱི་སང་ལ་ལུས་མཛེས་པྐོ་བཟྐོ་བར་འག་ྐོ་སྐོང་ཧ་ཅང་གཏྐོང་གྱི་འདུག་ཀང་།",
    "གྐོ་ལྐོག་མང་པྐོ་ཞྱིག་བཙལ་གྱི་འདུག་དེང་སང་འཛམ་བུའྱི་གྱིང་གྱི་གནས་ཚུལ་མང་པྐོ་ཞྱིག་ལ་དེའྱི་སྐྱྐོན་ཡྐོད།",
    "དེ་རྐེན་མང་པྐོ་ཞྱིག་ལ་ལྟྐོས་ཡྐོད་པ་མ་ཤེས་པས་ཧ་ཅང་རྐོག་དྲྭ་འདུག་དེའྱི་ཆ་ནས་ཡྱིན་ཡང་གཞན་ཕན་གྱི་བསམ་པ་དེ་ཧ་ཅང་ཕན་ཐྐོགས་ཡྐོད།",
    "རྒྱུས་འདུག་པ་ལྟར་ང་རང་ཡང་སལ་བ་བཟང་པྐོ་ཡྱིན་དྲན་ཡྐོད།",
    "དྐོན་ཡྐོན་བ་མས་བཀའ་གདམས་གྐོང་མའྱི་གསུང་སྒྐོས་ཤྱིག་བསྒྱིགས་འདུག་པའྱི་མཇུག་བྱང་དུ།",
    "བསམ་བྐོའྱི་ནང་ལ་ཚོར་བ་ཞྱིག་སླེབས་ཡྐོང་གྱི་འདུག་དེ་ལྟ་བུའྱི་སྐོ་ནས་མ་ཡྱི་དྲྱིན་དྲན་པ་ཞྱིག་དགྐོས་པར་མ་ཟད།",
    "མགྐོན་མེད་ཡྱིན་པ་མཐྐོང་དུས་སེམས་ལ་མྱི་བཟྐོད་པ་ཞྱིག་ཡྐོང་རྒྱུ་འདུག་པར་བསམ་བྐོ་བཏང་ནས་བྐོ་སྦྱང་བ་དང་།",
    "ཕྐོགས་མང་པྐོ་ཞྱིག་ནས་སྐོ་སྐོའྱི་དཀའ་ངལ་དེ་དེ་ཙམ་མངྐོན་གསལ་མེད་པ་ལྟ་བུ་ཆགས་ཐུབ་པས་ཧ་ཅང་ཕན་གྱི་འདུག་མྱིག་གྱིས་མྱི་མཐྐོང་བའྱི་ཚེ་རབས་ནས་ཚེ་རབས་གཏན་དུ་སྐྱྱིད་པ་ཡྐོང་བའྱི་སྐྱྱིད་མགྐོ་ཚུགས་པ་ཡྱིན།",
    "ཁང་པ་བརྩྱིགས་ཚར་བ་དང་དེའྱི་ནང་ལ་སྐོད་མཁན་རྣམས་ཀྱིས་ཡར་ནས་ཅྱིག་འགྱིག་མྱི་འདུག་མར་ནས་ཅྱིག་འགྱིག་མྱི་འདུག་ཅེས་གཤེ་གཤེ་དྲག་པྐོ་གཏང་བས།",
    "ལས་གཡྐོག་དེ་རྣམས་ཧ་ཅང་སྐྱྐོ་བྐོ་འདུག་ཅྱི་བྱ་དགྐོས་སམ།",
    "སེམས་སྐྱྐོ་ཡང་བྱ་ཐབས་གང་ཡང་མྱི་འདུག་ཟས།",
    "དག་བྐོས་གནྐོད་སེམས་ཀྱིས་ཀུན་ནས་བསླངས་ཏེ་རང་ལ་གནྐོད་པ་བསྐྱལ་ཙ་ན་དག་བྐོ་ཆགས་པ་ཡྱིན།",
    "འབུ་ཞྱིག་ལ་སྐྱེས་པའྱི་སབས་སུ་ཡང་རང་གཅེས་པར་འཛིན་པའྱི་བྐོ་དེས་རང་ག་ྱི་ངང་ག་ྱིས་རང་ལ་བདེ་བ་ཞྱིག་བྱུང་ན་བསམ་པར་མ་ཟད་གང་ཐུབ་འབད་བརྩྐོན་བྱེད་ཅྱིང་།",
    "ལྷ་ལ་སྐྱེས་པའྱི་གནས་སབས་སུ་ཡང་རང་གཅེས་པར་འཛིན་པ་དེས་རང་སྐྱྱིད་པྐོ་ཞྱིག་བྱུང་ན་བསམ་པའྱི་འབད་བརྩྐོན་བྱེད་པ་ལ།",
    "ནས་དུས་ད་ལྟའྱི་བར་དུ་རང་ལ་བདེ་བ་ཞྱིག་བྱུང་ན་བསམ་པའྱི་འདྐོད་པ་དེས་འདྱི་བྱས་དང་འདྱི་མ་བྱས་མེད་པར་འབད་བརྩྐོན་ཡྐོད་རྒུ་རྩལ་སྤྲུགས་བྱས་ཡྐོད་ཀང་ད་ལྟ་ཡང་ཁ་སྟབས་འདྱི་ལས་མྱི་འདུག་ཅྱིང་།",
    "གལ་སྱིད་ཐབས་ཤེས་དེ་བྱས་ནས་མ་འགྲུབ་ཀང་ཉེས་པ་གང་ཡང་མྱི་འདུག་བཞད་མྐོ་བཞད།",
    "ག་ལེར་འདྱི་མ་གཏྐོགས་འགྐོ་ས་གཞན་མྱི་འདུག་སྙམ་པ་ཞྱིག་བྐོ་ལ་སླེབས་རྒྱུ་ཡྐོད་པར་མ་ཟད།",
    "འདྱི་མ་གཏྐོགས་འགྐོ་ས་མྱི་འདུག་སྙམ་པ་ཞྱིག་བྐོ་ལ་འཆར་གྱི་འདུག་དེས་འཕལ་དུ་ཐད་ཀར་ཆགས་སང་ག་ྱི་ཉྐོན་མྐོངས་རྱིགས་མག་ྐོ་གནྐོན་མྱི་ཐུབ་ཀང་།",
    "དྐོན་གྐོ་ཆྐོད་སྐོང་སྙམ་པའྱི་ཡྱིད་ཚིམས་པ་ཞྱིག་ཡྐོང་རྒྱུ་འདུག་པས།",
    "མྱི་རག་པ་བསམ་བྐོར་འཁྐོར་བ་ན་མང་པྐོ་ཞྱིག་ལ་དེས་ཤུགས་རྐེན་ཐེབས་ཡྐོང་གྱི་འདུག་པས།",
    "ཙོག་ཙོག་ཏུ་འདུག་ཐུབ་ན་དེ་ལྟར་དང་རྐང་པ་བདེ་པྐོ་མེད་ན་ནྱི་ཁྱད་གང་ཡང་མེད།",
    "གཞན་དྐོན་མྱི་འདྐོད་པའྱི་ཞྱི་བ་ཕྐོགས་གཅྱིག་པའྱི་འཇྱིགས་པ་བཅས་དེ་གཉྱིས་ཀ་ལས་གྐོལ་བ་དེ་ཡང་རང་གཅྱིག་པུ་མ་ཡྱིན་པར།",
    "༡༥༣ འདྱི་ལ་དམྱིགས་བསལ་ཞུ་རྒྱུ་ཅྱི་ཡང་མྱི་འདུག་ཚོགས་གསྐོག་པ་ནྱི་གྐོང་བཞྱིན་དང་།",
    "མདྐོ་སེ་དཀྐོན་ཅྐོག་བརྩེགས་པ་དང་འཇམ་དཔལ་ཞྱིང་བཀྐོད་ཀྱི་མདྐོ་རྒྱ་ནག་སད་དུ་འདུག་གམ།",
    "༡༧༤ བྱམས་པ་མག་ྐོན་པྐོའྱི་མདྐོ་སེ་རྒྱན་གྱི་ནང་ལ་ཧ་ཅང་གསལ་བྐོ་དང་ཞྱིབ་ཚགས་པྐོ་འདུག་བྱམས་ཆྐོས་སེ་ལྔ་ཆ་ཚང་རྒྱ་ཡྱིག་ནང་ལ་ཡྐོད་པ་ལྟར།",
    "ཡྐོང་རྒྱུ་གང་ཡང་མྱི་འདུག་པ་ནྱི་ཧ་ཅང་མྱི་འྐོས་པ་ཡྱིན།",
    "འགྐོ་བ་མྱིའྱི་བརྩེ་བས་ཀུན་ནས་བསླངས་པའྱི་ཕན་སེམས་ཧ་ཅང་ཤུགས་ཆེན་པྐོ་འདུག་མཚོ་སྐྱྐོམ་ཚོ་ན་མའྱི།",
    "གཏྐོང་སའྱི་གཏང་ཡུལ་དེ་ལའང་རང་གྱི་ལུས་དགྐོས་མཁྐོ་ཆེན་པྐོ་ཆགས་ཡྐོད་ན།",
    "རང་གྱི་ལུས་འཚོ་བའྱི་ཐྐོག་ནས་ཆྐོས་ཉམས་ལེན་བྱ་རྒྱུ་ལས་རང་ག་ྱི་ལུས་སྦྱྱིན་པ་བཏང་ན་དག་ྐོས་པ་ཆེན་པྐོ་ཞྱིག་ཡྐོང་ཐུབ་ཀྱི་འདུག་ན་ལུས་དངྐོས་སུ་གཏྐོང་བ་ཡྱིན།",
    "ལེགས་པ་ཅྱི་ཡྐོད་པ་རྣམས་ང་རང་གྱིས་བདག་ག་ྱིར་བྱེད་པ་དང་།",
    "རྒྱ་ནག་སམ་ས་ཆེན་མྐོའྱི་ནང་ལ་ཡང་སྐྱྐོ་བྐོའྱི་གནས་སྟངས་འདྲ་མྱིན་ཧ་ཅང་མང་པྐོ་ཡྐོང་གྱི་འདུག་དེ་རྣམས་ཀྱི་དཀའ་ངལ་སེལ་བའྱི་ཐབས་ཤེས་བྱེད་པར་འཚོ་བས་ཕྐོངས་པ་ལ་ཟས་དང་སྐོམ།",
    "ང་ཐའེ་ཝན་ལ་ཐེངས་གཉྱིས་པར་ཕྱིན་པའྱི་སབས་ཐའེ་ཝན་གྱི་ས་ཆ་ཁུག་ཀ་ྐོག་ནས་ཡྐོང་བའྱི་ཡུལ་པ་ཁ་ཤས་ཤ་ྱིག་ལ་ཐུག་པར་ཧ་ཅང་སྐྱྐོ་བྐོ་འདུག་ལྟྐོ་གྐོས་ཀྱི་གནས་སྟངས་སྐྱྐོ་མདྐོག་ཁ་བར་མ་ཟད།",
    "ཁྱྐོད་ཀྱི་རྱིག་པ་ཧ་ཅང་ཡག་པྐོ་འདུག་ཅེས་དང་།",
    "ཁྱྐོད་རང་སླྐོབ་སྦྱྐོང་ཧ་ཅང་ཡག་པྐོ་འདུག་ཟེར་བ་སྐོགས་གང་ཐུབ་ཅྱི་ཐུབ་ཀྱིས་སྐོབས་པ་བསྐྱེད་ཐབས་བྱས་ན་ཡག་པྐོ་ཡྐོད།",
    "མདྐོར་ན་ཚིག་ངན་མང་པྐོ་ལབ་ན་ཕ་རྐོལ་པྐོ་དེ་ཧ་ཅང་མྱི་སྐྱྱིད་པ་ཡྐོང་བས་ཡག་པྐོ་མྱི་འདུག་ཚན་རྱིག་པ་སྐོ་ལགས་ཤྱིག་ཡྐོད།",
    "ཉེ་ཆར་ཡང་དེབ་ཅྱིག་བྲྱིས་འདུག་ཅྱིང་ང་ལ་གཅྱིག་སྤད་སྐོང་།",
    "ངས་ཀང་ཇྐོ་བྐོའྱི་སད་སྒྱུར་དང་ཞབས་ཞུ་བྱས་ཏེ་སྐོམ་ལྐོང་ཡྐོང་གྱི་མྱི་འདུག་ཅེས་གསུངས་ཏེ།",
    "འྐོན་ཀང་ངས་ཟུར་དུ་སྐོམ་བརྒྱབ་ནས་སྐོད་པ་ལས་བ་མའྱི་དྲུང་དུ་ཞབས་ཞུ་ཞུས་ནས་བསད་ན་རླབས་ཆེ་བ་མཐྐོང་གྱི་འདུག་ཅེས་གསུངས་པར།",
    "ངས་ད་ལྟའྱི་བར་ཞབས་ཞུ་ཞུས་ནས་བསད་པ་དེ་ག་རང་འགྱིག་འདུག་པས།",
    "སྐོམ་པའྱི་ཚུལ་ཁྱིམས་ཀྱི་གཙོ་བྐོ་ཡང་རང་བཞྱིན་གྱི་ཁ་ན་མ་ཐྐོ་བ་རྣམས་སྐོང་བ་ཡྱིན་ལ།",
    "༡༨༩ཞེས་པ་ལམ་རྱིམ་དུ་འགག་མཚོ་སྔྐོན་པར་མའྱི་གསུང་འབུམ་ཁྐོད་ཀྱི་ལམ་རྱིམ་འབྲྱིང་དུ་ཡང་འགག་ཅེས་བྲྱིས་འདུག་རྩྐོམ་སྒྱིག་པས།",
    "ཕ་རྐོལ་པྐོའྱི་སེམས་ཀང་ཚུལ་མྱིན་ཡྱིད་བྱེད་ཀྱི་རྣམ་རྐོག་གྱིས་བརྒྱ་ཆ་བརྒྱ་ཐམ་པ་སྒྐོ་བཏགས་པའྱི་རྐེན་གྱིས་ང་རང་ཧ་ཅང་མྱི་འྐོས་པ་ཞྱིག་ཏུ་མཐྐོང་སྟེ།",
    "རྒྱུད་ལ་འབྱུང་རུང་ཙམ་ལ་བསམ་བྐོ་བཏང་ན་རྒྱ་ཆེ་དྲགས་འདུག་སྐོ་སྐོས་ཨུ་ཚུགས་བརྒྱབ་སྟེ་ཉམས་ལེན་བྱེད་ཀྱི་ཡྱིན་སྙམ་དུ་སེམས་ཐག་བཅད་དེ།",
    "ཚད་གཟུང་དུ་མེད་པར་གསྐོག་དགྐོས་པར་གསུངས་འདུག་དེ་ལྟ་བུའྱི་ཚོགས་མཐའ་ཡས་པ་དེ་ཇྱི་ལྟར་རྐོགས་ཀྱི་ཡྐོད་དམ་ཞེ་ན།",
    "དམྱིགས་པ་ལ་གཡེང་བའྱི་སྐྱྐོན་ལྐོག་ནས་རང་རང་གྱི་དམྱིགས་པ་གང་ཡྱིན་ལ་གཞན་དུ་མྱི་གཡེང་བར་འཇུག་པས།",
    "ལུས་ཀྱི་འདུག་སྟངས་ཡག་པྐོ་བྱས་ནས་ལུས་འདྲྐོང་པྐོ་བྱུང་ན་རྩ་འདྲྐོང་བ་དང་།",
    "ལུས་ཀྱི་འདུག་སྟངས་དེ་གལ་ཆེན་པྐོར་གསུངས་པ་ལྟར།",
    "དེའྱི་ནང་གྱི་དངྐོས་པྐོ་རྡྐོག་རྡྐོག་དེ་ལ་བསམ་བྐོ་བཏང་ན་ཞེད་སྣང་སྐྱེ་བ་ཞྱིག་མྱི་འདུག་གམ།",
    "འབུས་གཞྱིགས་པ་བཅས་མཐར་རུས་པ་སྐྱ་སེང་ངེར་ཡྐོད་པའྱི་བར་དུ་འདུག་པ་ནྱི་ཧ་ཅང་ཡག་པྐོ་འདུག་དེ་ལྟ་བུའྱི་སྐོ་ནས་ཕྱི་དང་ནང་གྱི་མྱི་སྡུག་པ་སྐོམ་དགྐོས།",
    "ངས་ཅྱི་ཡང་ཤེས་ཀྱི་མྱི་འདུག་དྲན་ཏེ་ང་རྒྱལ་གྱི་གཉེན་པྐོ་བྱ་ཐུབ།",
    "འགྐོ་འཆག་ཉལ་འདུག་སྐོགས་སྤྐོད་ལམ་གང་གྱི་སབས་སུ་ཡང་།",
    "དེ་ཡང་བྐོས་གསར་དུ་བསྐྱེད་པ་དང་རང་བཞྱིན་གྱིས་བཞུགས་པ་གསལ་འདེབས་པ་གཉྱིས་ལས།",
    "སེམས་འཐྐོམ་མེར་འདུག་པའྱི་སབས་སུ་ངལ་གསྐོ་ཡག་པྐོ་རྒྱག་གྱི་ཡྐོད།",
    "བྱྱིང་རྒྐོད་སླེབས་འདུག་གམ་མྱི་འདུག་ཤེས་བཞྱིན་གྱིས་བལྟ་དགྐོས།",
    "གྱི་ངྐོས་ནས་ཡྐོད་པར་འཇྐོག་དགྐོས་ཙ་ན།",
    "སྐྱེ་འགག་སྐོགས་རང་རང་གྱི་གཤྱིས་ལུགས་སུ་གྲུབ་མེད་པར།",
    "མ་དག་པའྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་རྣམས་ཀང་རང་ཉྱིད་རང་ག་ྱི་གཤྱིས་སུ་དང་གནས་ལུགས་སུ་གྲུབ་མེད་པས།",
    "༢༥༢རྐོན་བཞྱིའྱི་རྣམ་གཞག་དེ་ཐྐོགས་མེད་ཀྱི་གཞུང་དུ་རྒྱས་པར་འདུག་གང་ཟག་ལ་མྱི་རྐོན་ཆྐོས་ལ་རྐོན།",
    "ཐ་སྙད་དུའང་རང་མཚན་ཞལ་གྱིས་མྱི་བཞེས་པར་ཆྐོས་ཐམས་ཅད་མྱིང་ཙམ་བཏགས་ཙམ་དུ་གསུངས་ཤྱིང་།",
    "རང་གྱི་མཚན་ཉྱིད་ཀྱིས་མ་གྲུབ་པ་ཞེས་པའྱི་ཚིག་ཙམ་འདུག་ཀང་།",
    "དེའྱི་གཉེན་པྐོ་ལ་ཁག་མང་པྐོ་ཞྱིག་འདུག་ཀང་གཙོ་ཆེ་བ་ནྱི་སུན་འབྱྱིན་པའྱི་གཉེན་པྐོ་དང་།",
    "ཀུན་བཏུས་ཀྱི་ནང་ལ་ཡང་གཉེན་པྐོ་ཧ་ཅང་མང་པྐོ་ཞྱིག་གསུངས་འདུག་ད་ལྟ་འབྲེལ་བ་ཡྐོད་པ་ནྱི་སུན་འབྱྱིན་པའྱི་གཉེན་པྐོ་ཡྱིན།",
    "ཕུང་སྐོགས་ཀྱིས་མཚོན་པའྱི་ཆྐོས་རྣམས་རང་བཞྱིན་གྱིས་གྲུབ་པ་དེ་ཆྐོས་ཀྱི་བདག་ཏུ་གསུངས་ཙ་ན།",
    "སྣང་ཙམ་དེས་མ་ཚིམས་པར་རང་རང་གྱི་ངྐོ་བྐོའམ་རང་བཞྱིན།",
    "ཐག་ཁ་ལ་སྦྲུལ་འདུག་བསམ་པའྱི་བྐོ་དེའྱི་ངྐོར།",
    "ཐག་ཁ་འཁྱྱིལ་བ་ལ་དེར་སྦྲུལ་ཞྱིག་འདུག་སྙམ་དུ་དྲན་གྱི་ཡྐོད་ཀང་།",
    "ཕུང་སྐོགས་བྐོ་ཡུལ་དུ་ཤར་བའྱི་ཐྐོག་ནས་ང་སྙམ་པའྱི་བྐོ་སྐྱེ་ཡྱི་འདུག་པ་དང་།",
    "༢༥༧ང་ཙམ་དང་གང་ཟག་དེ་བཏགས་ཡྐོད་ཡྱིན་ཡང་རང་མཚན་བཞེད་མཁན་རྣམས་ཀྱིས་ཐ་སྙད་གང་དུ་གདགས་སའྱི་གཞྱི་རས་ཡྐོད་ཅྱིག་དག་ྐོས་ཞེས།",
    "ང་དེ་ལུས་ཀྱི་སྟེང་ནས་ཡྐོད་པ་ལྟ་བུ་ཞྱིག་ཤར་གྱི་འདུག་རྒྱ་མྱི་དང་བྐོད་པ།",
    "བཏགས་ཡྐོད་ཙམ་མ་གཏྐོགས་འགྐོ་ས་མྱི་འདུག་དཔེར་ན།",
    "གང་ཟག་དེ་ལུས་སེམས་གཉྱིས་ཀྱི་ནང་ནས་ཤེས་པ་མ་གཏྐོགས་འག་ྐོ་ས་མྱི་འདུག་ཅེས་བག་ཆགས་བསྐོ་གཞྱིར་བསམ་བྐོ་བཏང་སྟེ།",
    "དགྐོངས་པ་རབ་གསལ་དུ་དམྱིགས་རྣམ་ཅན་གྱི་ཉྐོན་མྐོངས་ཞེས་གསུངས་འདུག་དམྱིགས་རྣམ་ཅན་གྱི་ཉྐོན་མྐོངས་ཀྱི་ག་ྐོ་བ་དཔྱིས་ཕྱིན་པར་མྱི་ཤེས་ཀང་།",
    "ཕྱིན་ཅྱི་ལྐོག་གྱི་བྐོ་ནྐོར་འདུག་བསམ་པ་ཙམ་གྱིས་མྱི་ཡྐོང་བར་མ་ཟད།",
    "ཕུང་པྐོ་བྐོ་ཡུལ་དུ་ཤར་ནས་ང་ཞྱིག་བྐོ་ལ་ཤར་ཡྐོང་གྱི་འདུག་པས།",
    "ཀང་སྒ་མྱི་འདུག་ཟེར།",
    "གཟུགས་ཅན་གྱི་དངྐོས་པྐོ་ཞྱིག་ཡྱིན་ཕྱིན་ཆད་ལ་རང་རང་གྱི་གྐོ་ས་གནྐོན་པའྱི་ཚུལ་གྱིས་ཡྐོད་དགྐོས།",
    "ང་རང་བཞྱིན་མེད་པར་གཏན་ལ་དབབ་པ།",
    "ང་རང་བཞྱིན་མེད་པར་གཏན་ལ་དབབ་པ་ལ།",
    "བདག་དེ་ཕུང་པྐོ་དང་གཅྱིག་ཏུ་ཡྐོད་ན་སྐྱྐོན་འདྱི་འདྲ་འདུག་ཅྱིང་།",
    "གང་ཟག་གམ་བདག་རང་བཞྱིན་མེད་པར་ངེས་ཡྐོང་བ་ན་ང་ཡྱི་བ་ཡང་རང་བཞྱིན་མེད་པ་བདེ་བག་ཏུ་ཤེས་ཐུབ་པ་ཡྱིན།",
    "འདྱིར་ཐ་སྙད་དུའང་རང་མཚན་ཞལ་གྱིས་མྱི་བཞེས་པས།",
    "ཡྱིད་བྐོས་ཨ་ང་ལ་ཚུགས་ཐུབ་པ་ཞྱིག་སྣང་གྱི་འདུག་སྟེ།",
    "དེའྱི་མཇུག་ཏུ་དེས་ན་མྱུ་གུ་ལ་སྐོགས་པ་ཕྱི་དང་ཞེས་མྱུ་གུ་དང་རང་རང་གྱི་ས་བྐོན་ལ་སྐོགས་པ་དང་།",
    "ལམ་སྤྱིའྱི་བསྡུ་བར་དམྱིགས་བསལ་གང་ཡང་མྱི་འདུག་སྔྐོན་ལ་མག་ྐོ་བཤེས་གཉེན་བསྟེན་ཚུལ་ནས་བཟུང་སྟེ་ལྷག་མཐྐོང་གྱི་བར་གྱི་ལམ་རྣམས་ཡྐོངས་སུ་རྐོགས་པ་བྐོ་ལ་ཤར་བ་ཞྱིག་དང་ག་ྐོ་བ་ཆགས་པར་བྱས་ཏེ་བསམ་བྐོ་བཏང་ཡྐོང་བ་ན།",
    "ཉྱི་ཧྐོང་ལ་ཡང་དེ་འདྲ་འདུག་བྐོད་གངས་ཅན་གྱི་ལྐོངས་ལ་རྒྱུད་སེ་འྐོག་མ་གསུམ་གྱི་སང་ལ་རྣལ་འབྱྐོར་བ་མེད་བསྣན་ནས་རྒྱུད་སེའྱི་ལྷ་ཚོགས་ཧ་ཅང་མང་པྐོ་ཡྐོད།",
    "ཀླུ་བྱང་གྱི་བསྐྱེད་ཆྐོག་ཉྱི་ཤུ་པའྱི་ནང་ལ་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པའྱི་བསྐྱེད་ཆྐོག་དེ་ལུང་འདྲེན་བྱ་དག་ྐོས་ངེས་ཀང་རྩ་ནས་དྲངས་མྱི་འདུག་པར་མ་ཟད་མྱི་མཐུན་པའང་འདུག་ཟེར།",
    "སལ་ལྡན་ལས་འཕྐོ་ཅན་ཡྱིན་ན་སྐོམ་མྱི་དགྐོས་པར་འཚང་རྒྱ་བ་ཡྐོད་ཙ་ན།",
    "ཕལ་ཆེར་ང་སལ་ལྡན་ལས་འཕྐོ་ཅན་ཡྱིན་པ་ཐག་ཆྐོད་འདུག་སྙམ་ནས།",
    "སམས་རྒྱུད་ཀྱི་དོན་སྣང་བ་གསུམ་དང་རང་བཞིན་རྣམས་བསྟན་པ།",
    "རྗེ་ཙོང་ཁ་པ་ཆེན་པོའི་རིམ་ལྔ་གསལ་སྒྲོན་འདིར་ནི་འདུས་པ་འཕགས་ལུགས་ཀྱི་མན་ངག་ལ་གཙོ་བོར་བརྟེན་པ་གཞུང་རང་ཉིད་ལས་ཤིན་ཏུ་གསལ་བར་བྱུང་།",
    "འཕགས་སྐོར་གྱི་འདུས་པའི་ལུགས་ཤིན་ཏུ་ཉམས་འདུག་པ་ལེགས་པར་སོས་ནས་ཡུན་རིང་དུ་མི་ཉམས་པར་གནས་པར་གྱུར་ཅིག་སྙམ་པའི་བསམ་པ་དག་པས་བགྱིས་སོ།",
    "དེ་དག་སོ་སོའི་མན་ངག་སོགས་ནི་རྒྱས་པར་རིམ་ལྔ་གསལ་སྒྲོན་གྱི་གཞུང་རང་ཉིད་ལས་མཁྱེན་རྒྱུ་ལ།",
    "༨ཞི་བ་སྟེ་སེམས་རྣལ་དུ་འདུག་པའི་དལ་བ།",
    "དེ་ཡང་རང་བཞིན་ཏེ་སྣང་བ་གསུམ་གྱི་མཚན་ཉིད་ཅེས་པའི་དོན་ཡིན་པར་གསུངས།",
    "མཚོན་ཚུལ་ཡང་རང་བཞིན་དེ་རྣམས་ཀྱི་སྒོ་ནས་སྣང་བ་གསུམ་རྗེས་སུ་དཔག་པར་བྱ་བར་གསུངས་ལ།",
    "སེམས་རྣལ་དུ་འདུག་པའི་ཞི་བ།",
    "སྤྱིར་སེམས་ཁམས་རིག་པའི་གནས་ལུགས་རྟོགས་པ་ལའང་གལ་ཆེ་བའི་གནས་སུ་འདུག་པས་འདིར་ཁོ་བོས་ཅུང་ཟད་དཔྱད་དེ་སྤྲོས་ཡོད།",
    "བཅད་དང་སྒྲོམ་ཇི་ལྟ་བ་ཞིན་དུ་བཀོད་དེ་བཀྲལ་འདུག་པ་སོགས་ཀྱིས།",
    "པཎ་ཆེན་གྱི་གཞུང་འདི་མཆོག་ཏུ་གྱུར་པ་ཞིག་ཏུ་འདུག་ལ།",
    "དེའི་ཕྱིར་ལུགས་འདི་ལ་ཐོག་མར་རྡོ་རྗེ་འཆང་ལྟ་བུའི་དཔའ་བོ་གཅིག་ལ་ཁྲིད་ནས་དེ་ལ་གསལ་སྣང་བརྟན་པ་ན་དེ་ནས་སྒྲུབ་ཐབས་ལྷག་མ་ལ་འཁྲིད་པའི་ཕྱག་ལེན་འདུག་པ་བཞིན་བྱེད་ན་མ་གཏོགས་པ།",
    "བློ་གྲོས་ཀྱི་ནུས་པ་ཤིན་ཏུ་ཞེན་པའི་སྐབས་སུ་འདུག་པས།",
    "དེ་ཡང་རང་རྒྱུད་ལ་བདེ་བ་དེ་མེད་པར་གཞན་རྒྱུད་ཀྱི་བདེ་བ་ལ་དམིགས་ནས་བྱེད་པ་མིན་པས།",
    "ཞེས་འོང་རྒྱུར་འདུག་ཀྱང་འགྱུར་ཅུང་མ་བདེའོ།",
    "ནོར་བུ་ནས་ཕྱིར་མ་འཕོས་ན་རང་ལོག་བྱེད་པ་འདྲ་ཁ་ཅིག་འདུག་ཀྱང་།",
    "དེ་རྣམས་རང་རང་རྟག་ཏུ་བྱིན་གྱིས་བརླབས།",
    "སྐལ་ལྡན་གྲགས་པས་གསུངས་ཏེ་ད་ལྟར་འགྱུར་བ་ལ་མེད་ཀྱང་འཕྲོ་ལས་འདུག་པས་མི་འགལ་ལོ།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་ནས།",
    "ཨཱ་འི་ངོ་བོས་ཀྱང་རང་རྒྱུད་དག་པར་བྱེད་པར་ཞལ་ལུང་ལས་གསུངས་ཤིང་།",
    "བསྡུས་ནས་སླར་ཡང་རང་བཞིན་གྱིས།",
    "རྒྱུད་ཀྱི་དོན་སྣང་བ་གསུམ་དང་རང་བཞིན་རྣམས་བསྟན་པ་དང་།",
    "རྒྱུད་ཀྱི་དོན་སྣང་བ་གསུམ་དང་རང་བཞིན་རྣམས་བསྟན་པ།",
    "བཞི་པ་རྒྱུད་ཀྱི་དོན་སྣང་བ་གསུམ་དང་རང་བཞིན་རྣམས་བསྟན་པ་ལ་གསུམ།",
    "སྣང་བ་དང་རང་བཞིན་གྱི་རྟོག་པ་གཉིས་སུ་ཁ་ཚོན་ཆོད་མི་དགོས་པས།",
    "༦སྔ་མ་རྣམས་སེམས་རྣལ་དུ་འདུག་པའི་དལ་བ་ལ་འཆད་དོ།",
    "སྣང་བ་དང་རང་བཞིན་གཉིས་ནི་ཆེས་ཤིན་ཏུ་མི་མཐུན་པའི་ཕྱིར་རོ།",
    "ད་ལྟ་འདུག་པའི་འཕགས་པ་ལྷའི་གཞུང་གང་ནའང་མི་སྣང་ངོ།",
    "དེ་དག་ལ་རྟགས་དང་རྟགས་ཅན་འཆར་ལུགས་རྣམས་ཀྱང་མི་མཐུན་པ་དུ་མ་ཞིག་འདུག་སྟེ་མ་བྲིས་སོ།",
    "ཡོན་ཏན་གྱི་ཁྱད་པར་འཆར་ཚུལ་མང་དུ་འདུག་པ་བཞིན་དུ།",
    "སེམས་རྣམ་པར་དབེན་པའི་མཐར་ཐུག་པ་ཡང་རང་བཞིན་གྱི་སྣང་བ་ཙམ་ཡོངས་སུ་ཤེས་པ་ཙམ་དུ་ཟད་པས།",
    "ཡེ་ཤེས་ཙམ་ལས་ལྷའི་སྐུར་སྐྱེ་བ་ཅིག་དགོས་པ་འདུག་པ་ལ།",
    "འདིར་སོ་སྐྱེ་རྣམས་ཀྱིས་མི་མཐོང་༤༩ཞེས་གསུངས་པ་ནི་ཁོ་རང་ལས་གཞན་པ་ཡིན་ལ།",
    "ཆགས་སྡང་འདུག་མི་འདུག་བརྟག་དེ་མི་འདུག་པ་དང་མདུན་དུ་ཕྱུང་སྟེ།",
    "ཡང་བསྟོད་སྨད་བྱས་ལ་ཆགས་སྡང་འདུག་མི་འདུག་བལྟ།",
    "དེ་མི་འདུག་པ་དང་རང་ལ་བསྟིམས་ནས།",
    "རྗེས་ཀྱི་སྐབས་སུ་གཟུགས་བརྙན་ལ་དགའ་མི་དགའ་འདུག་མི་འདུག་རྟོག་པ་སོགས་ཀྱིས་བདེན་ཞེན་འགོག་པ་འགངས་ཆུང་ངོ།",
    "ཉིན་པར་ད་ལྟར་གྱི་སྣང་བ་རྣམས་རྨི་ལམ་ཡིན་པར་འདུག་སྙམ་པ་དང་།",
    "གླལ་དང་འཁྲིག་དུས་སྐད་ཅིག་ཙམ།",
    "དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཚུལ་གྱིས་འདུག་ནས་འཁོར་སྐྱེད་པ་ན།",
    "འཕགས་སྐོར་གྱི་འདུས་པའི་ལུགས་ཤིན་ཏུ་ཉམས་འདུག་པ་ལེགས་པར་སོས་ནས་ཡུན་རིང་དུ་མི་ཉམས་པར་གནས་པར་གྱུར་ཅིག་སྙམ་པའི་བསམ་པ་དག་པས་བགྱིས་སོ།",
    "ཞེས་སོགས་ཚིག་རྐང་གཉིས་པོ་དེ་མི་འདུག་པས་དཔྱད་དགོས་སོ།",
    "སློབ་དཔོན་འཇོ་སྒེག་དུས་གསུམངུའི་རྡོ་རྗེ་སློབ་དཔོན་ལ།",
    "ཉན་ཐོས་དང་རངསངསརྒྱསརྣམསུཏྟེ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུགབའམ།",
    "ང་བས་ཁྱེད་ཤེས་རབ་ཆེ་བར་འདུག་པས་འཇམ་དཔལ་རང་དུ་གདའ་འོ་གསུངས་པས་འཇམ་གསར་མར་གྲགས།",
    "གདའ་སྟེ།",
    "འདིས་ཆུ་བཅིང་བའི་རིག་པ་ཤེས་པར་འདུག་པས།",
    "འདིར་མི་ཤོང་བ་འདུག་པས་མ་འོངས་ཟེར་བ་ལ།",
    "ཁོང་རང་མུ་སྟེགས་པའི་ལུགས་ཀྱི་རབ་གནས་ཉམས་པ་ཡིན་པས།",
    "ཐམས་ཅད་ཧན་གདལ་བས་ཁོང་རང་རྣམས་གར་རྒྱུ་ཆ་མེད་དུ་གྱུར།",
    "འདི་ངེས་པར་གནམ་ནས་བབས་པར་འདུག་པས་ངེད་རང་རྣམས་ཀྱི་དཔོན་དུ་གདན་འདྲེན་ཟེར།",
    "ཁོང་རང་རྣམས་ཀྱིས་གཉའ་བ་ལ་བཏེགས་ནས་སྤྱན་དྲངས་པས།",
    "ཐུགས་ཐུག་གེ་བ་དེ་ཤེས་ནས་རྒྱལ་པོ་བཀྲོང་མཁན་ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་བྱ་བའི་འབྱུང་པོ་འདི་ཡིན་པ་འདུག་སྟེ།",
    "དེའང་ཁང་པ་གསུམ་ཐོག་གཅིག་ན་རྗེ་འབྲོག་མི་བཞུགས་འདུག་པ་ལ།",
    "ལག་པ་ནག་པོ་འཕངས་ལ་ཁོབ་ལ་རྒྱུགས་བྱ་བར་འགྲོ་ཡིན་འདུག་པས།",
    "དེས་ན་ཁྱེད་རང་ལ་གཏམ་ངན་འོང་།",
    "དེ་ལ་མི་འཇིགས་ན་ཁྱེད་རང་གཅིག་པུས་བསྒྱུར་བས་འོང་གསུངས་པས་འགོས་ཀྱིས་འགྱུར་མཛད་ཅུང་མ་ནུས་པར་སྣང་གསུངས།",
    "དེར་རྫི་ཅོམ་མེ་ནི་བྱུང་གདའ་གསུངས།",
    "འུ་ཅག་ལ་བླའི་མཆོད་གནས་ཞིག་དགོས་པར་འདུག་པས་སུ་འཐད་དགོངས་པ་ན།",
    "ཁོང་རང་གསུམ་པོས་ཕྱག་འདོན་མཛད་ནས་བསྙེན་བཀུར་འབུལ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་མཛད།",
    "དེ་ནས་ལེང་ཡང་དེ་ན་ཡོད་འདུག་པས་ཁོང་རྣམས་ལྷན་ཅིག་ཏུ་རིམ་གྱིས་བལ་པོར་བྱོན།",
    "རྒྱལ་པོ་ཙ་ན་ཀ་ཞེས་བྱ་བས་ལོ་གསུམ་གྱི་བར་གསོལ་བ་བཏབ་ནས།",
    "ཁྱེད་རང་ཡང་དེར་གཏོད་ལ་ཤོག་གསུངས།",
    "ཧ་ཅང་གྲགས་པའི་རྣམ་པས་ནུབ་ཕྱོགས་ཀྱི་རྒྱལ་པོ་བྷོ་ཛནྟ་ཧ་ར་ལ་སོགས་པའི་རྒྱལ་པོ་བཅོ་ལྔའི་དམག་དཔག་ཏུ་མེད་པ་ཉིན་ལམ་ལྔའི་ས་ན་སླེབས་ཡོད་པར་འདུག་རྒྱལ་པོ་འདི་གཡོ་སྐྱ་ཁྲམ་གསུམ་ཆེ་བས་ལན།",
    "ཙ་ན་ཀས་གྲུབ་ཆེན་དཔའ་བོ་རྡོ་རྗེའི་མཚན་ནས་སྐད་ཆེན་པོས་ཐེང་གསུམ་བོས་པའི་རྗེས་སུ་གྱད་དེ་ལ།",
    "ཙ་ན་ཀ་འཁོར་དང་བཅས་པ་གཡུལ་ལས་རྒྱལ་ཞིང་།",
    "འདི་པ་ཅིར་གདའ་གསུང་བསྟན་པས།",
    "ཐམས་ཅད་ཁ་མཐུན་པར་འདི་པ་གསེར་དུ་གདའ།",
    "གསེར་གྱི་ནང་ནས་ཀྱང་བཟང་ཐག་ཆོད་པ་འདི་ལྟ་བུ་གདའ་ཞུས་པས།",
    "སྐུ་གདུང་བསྒུལ་བས་དྲོད་མ་ཉམས་པར་བཞུགས་འདུག་པ་ལ།",
    "དེ་དག་རྐུན་མས་ཁྱེར་གྱིས་དོགས་ནས་དེའི་དབུས་སུ་ཁོང་རང་གཟིམས།",
    "དུས་མཚུངས་ཀྱི་སྐྱེ་བོ་དྲག་ཞན་ཕལ་ཆེ་བས་བསྟེན་ཅིང་འདུད་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཁོང་རང་རྒྱལ་པོས་མ་བཏང་པར་འབུལ་མི་བརྫངས་ཏེ།",
    "ག་ཡ་ངྷ་རའི་ཐུགས་དམ་ཀྱེ་རྡོར་གྱི་བྲིས་སྐྲ་ཞིག་ཡོད་པའང་ཁོང་ལ་སྐྱེས་ལན་དུ་བསྐར་བར་གདའ་གསུངས།",
    "གཙོ་བོར་ཐུགས་དམ་ལ་དྲིལ་བ་ཞིག་བྱུང་བར་གདའ་གསུངས།",
    "ཐམས་ཅད་མཐུན་སྣང་དུ་གྲུབ་པའི་འགྲན་ཟླ་ཐམས་ཅད་དང་བྲལ་བ་ནི་འབྲོག་མི་ལོ་ཙཱ་བར་གདའ་སྟེ།",
    "དེ་ནི་ཁྱེད་རང་ཐག་ཉེ་བས་རྒྱས་ཆེའམ་ཟེར་བ་ལ།",
    "གཡོག་པོ་མདའ་གཞུ་ཐོགས་པ་ལྔ་ཁྲིད་ཁོང་རང་རྟ་བཟང་པོ་གཅིག་ལ་ཞོན།",
    "ཞལ་འཕྲོས་འདྲའང་བྱེད་དགོས་པར་གདའ་ཨྰ།",
    "ཨ་ཇོའང་ཡིན་པ་ཞིག་བདོག་པས་དེ་ལ་ཞུས་ནས་མ་བྱས་པར།",
    "དེར་ཨ་ཇོ་རྒྱལ་ལེ་ལ་ཞུ་ཡིག་བསྐུར་ཏེ་དགོངས་པ་ལེན་དུ་བཏང་བས་རྗེ་བཙུན་གཅེན་གྱིས།",
    "ཁྱེད་རང་ལ་བར་ཆད་ཀྱི་ལྟས་ཅུང་ཟད་གདའ་བས་དེ་བཟློག་པའི་ཐབས་ལ་འབད་པ་མཛོད་གསུངས་ནས་བཀའ་ཁྲོལ།",
    "དེ་འཁོར་ནས་འོངས་པ་ན་ཁོང་བྱིས་པའི་ཁྲོད་ན་རྩེ་ཞིང་བཞུགས་འདུག་པས།",
    "འདི་ངེད་ལ་དགོས་པ་གདའ་གསུངས་ནས་ཁྱེར།",
    "ཁོང་རང་མི་དེ་ཙམ་དུས་གཅིག་ཏུ་བསད་པས་ཐུགས་སྐྱོ་སྟེ།",
    "ཁྱེད་དག་གཞོག་སློང་བྱེད་པར་འདུག་སྟེ།",
    "ཁྱེད་རང་ཡུལ་དུ་མི་འགྲོ་བར་བསྡད་པས་ཆོག་གསུངས་པ་ལ།",
    "ཁོང་རང་ཡང་ཐུགས་ཅུང་ཟད་ཆད་དེ།",
    "ངའི་སྣོད་བརྟགས་པར་འདུག་པ་ལ་ངས་དེ་མ་གོ་བས་ཅུང་ཟད་ལན།",
    "ཁྱེད་རང་རྣམས་གདམས་ངག་ཞུས་ན་ངའི་དཀའ་སྤྱད་ཙམ་མི་དགོས་པར་གདམས་ངག་གནང་བར་འདུག་བྱ་བ་ལ་སོགས་པའི་ཞལ་ཆེམས་བཞག་ནས་མྱ་ངན་ལས་འདས།",
    "ཁོང་རང་རི་ལ་གཡག་འཚོ་རུ་བྱོན་པས།",
    "དེ་ནས་ཕ་ཚད་ཕྱིན་པ་ན་གཞོན་པ་འདྲ་སྤང་རྐོ་ཡིན་འདུག་པའི་ཙར་བྱོན་ནས།",
    "དེའི་ནང་ནས་ཀྱང་མང་མཁར་མུ་གུ་ལུང་བྱ་བའི་ཐད་ཡིན་པར་གདའ།",
    "ཁོང་རང་ལ་ཤིན་ཏུ་བརྩེ་བའི་ཞང་པོ་སྟོན་ཆུང་དར་ཡེ་བྱ་བ་ཞིག་ཡོད་པ་དེའི་རྩར་བྱོན་ནས།",
    "གྲོས་ཁམ་པོ་ཆེ་འདྲའང་འདྲི་རྒྱུ་འདུག་པས་དོ་ནུབ་འགོལ་ས་ཞིག་ཏུ་འབྱོན་བྱས་པས།",
    "བདག་སེམས་ལ་བརྗོད་མི་ཤེས་པ་ཞིག་གདའ་ཞུས་པས།",
    "དེ་པ་ད་དུང་སྡོད་འདུག་གམ་གསུངས།",
    "བསྡད་གདའ།",
    "ད་ལྟའང་ལུས་མ་སྤངས་པར་ཏི་སེ་ན་བཞུགས་པར་གདའ་གསུངས།",
    "ཁོང་རང་འཁོར་གསུམ་སོགས་ཁྱེར་ཏེ་བྱོན་པས་སིལ་མ་ལ་ཁར་ལ་སྟོད་པའི་ཚོང་པ་མང་པོ་ལོག་འགྲོ་བ་དང་ཕྲད་ནས་བསྡོངས་ཏེ་བྱོན་པས།",
    "ཆང་བུམ་གཅིག་རྣམས་སྐུ་སྐལ་ལ་འདུག་པས།",
    "བླ་ཆེན་གྱི་ཞལ་ནས་སྔར་གྱི་དེས་ཁོ་འགྲངས་པའི་ཚན་མིན་པར་འདུག་པས།",
    "བླ་ཆེན་གྱིས་གྱད་བྲན་དུ་བཀོལ་འདུག་ཟེར་ཁྲོམ་ཐོག་ཆོད།",
    "ཆབ་ཆེན་ཞིག་འདུག་པ་དེར་གསོལ་བ་གཡོས་ནས་དྲོངས།",
    "ཁྱེད་རང་རྣམས་ཀྱང་ལེགས་པ་ཡིན་ཏེ་ཞེས་གསུངས།",
    "དེར་ཁོང་རང་སྐྱ་མཆེད་ཀྱང་ཤིན་ཏུ་དད་ནས་བསྙེན་བཀུར་ཕྲན་ཚེགས་མཛད་པ་ན།",
    "ཕྱག་རྒྱ་དེ་རྩད་བཅད་པས་མ་གཅིག་ཞྭ་མར་འདུག་ནས།",
    "བསླངས་པས་ཁོང་རང་ཡང་དགེས་བཞིན་དུ་བྱོན་ཏེ།",
    "ཁོང་འགྲོ་གྲབས་སུ་གདའ།",
    "བརྒྱུད་པ་འདིའི་སྲོལ་གྱིས་ཕར་གནང་བའི་སྲོལ་ནི་མི་འདུག་ཁྱེད་སྐུ་མཆེད་ཀྱིས་གྲོས་ཐོབ་གསུང་བ་ན།",
    "ཁྱེད་ཐུགས་ལའང་ཤིན་ཏུ་དགེས་པར་གདའ་བས།",
    "ཕན་པར་གདའ་ཞུས་པས།",
    "མ་གཅིག་གཟིམས་མལ་ན་སྒོག་པ་སྤར་གང་ཙམ་དང་བཅས་བཞུགས་འདུག་སྒོག་པ་སུས་ཕུལ་ཞུས་པས།",
    "མཇལ་ཁ་ཙམ་གནང་ནའང་རྟ་བཟང་པོ་སོགས་ནོར་མང་དུ་འབུལ་བ་གདའ་བས་མཇལ་ཙམ་འཐད་ཞུས་པས།",
    "བདག་སྒྲོལ་བར་ཞུ་ཟེར་བའི་མི་མང་པོ་འདུག་པས།",
    "མི་ཤི་གསོན་མི་འཕྲད་ཟེར་བ་མི་བདེན་པར་འདུག་འཕྲད་པའི་དུས་བྱུང་བ་ཡིན་གསུངས།",
    "ཕྱག་རྟེན་སྟབས་བདེ་བ་ཞིག་ཀྱང་མི་འདུག་པས་ཞུ་མི་ཐུབ་པ་འདྲ་གསུངས་པས།",
    "ལ་ལས་ཡུད་ཙམ་དེ་ལ་ཤེས་པར་འདུག་གསུངས་པ་དང་།",
    "ཁོང་དཔོན་སློབ་འགའ་འཇིགས་བྱེད་ཀྱི་སྔགས་བཏུ་མཛད་ཀྱིན་འདུག་པ་ཡེ་མགོ་མ་ཐོན་པ་ན།",
    "འདི་སྐད་མཛད་ན་འོང་བར་གདའ་ཞུས་པས།",
    "མལ་ལོ་ཚོགས་དབུ་ཞིག་ལ་བྱོན་འདུག་པ་ལ་ཕྲིན་བྱས་པས།",
    "འབུལ་བ་ཞིག་ཡོད་པར་གདའ་ཞུས་པས།",
    "ཡོ་ག་མཛད་ཅིང་གཏམ་ཆལ་ཆོལ་མང་པོ་མཛད་ཀྱིན་བཞུགས་འདུག་པ་ལ།",
    "ཁྱེད་རང་བྱོན་གསུངས།",
    "དོ་ནུབ་ཕྱིས་པས་གར་ཡང་མི་སླེབ་པར་གདའ་བས་གནས་ཚང་ཞིག་ཞུ་ཞུས་པས།",
    "གསུང་ངག་དགོས་ཟེར་བར་འདུག་གསུངས།",
    "ཡིན་པ་གདའ་ན་ཁྲིད་ཤོག་གསུངས།",
    "རྗེ་མཁར་ཆུང་བའི་གདམས་ངག་ཀྱང་མི་ཐོབ་པ་ཞིག་འོང་བར་འདུག་པ་དེ་མཁྱེན་པར་གདའ་ཞུས་པས།",
    "ཕ་དེ་འདས་ནས་འདུག་པས་འོད་མཆོག་རང་ལ་གནང་།",
    "དེར་རྗེ་བཙུན་གྱིས་དོ་ནུབ་མི་ཉུང་ཞིང་དམ་ཚིག་གཙང་བར་འདུག་པས་རྫུ་འཕྲུལ་ཞིག་སྟོན་གསུངས་པས་དེ་འདྲ་མི་གསུང་བར་ཞུ་ཟེར་ཙབ་ཙོབ་ལངས།",
    "ད་ལྟར་ཡང་བཞུགས་པའི་རིགས་སུ་གདའ་ཞིང་།",
    "ཆུ་འདི་གྲང་ན་དགའ་སྟེ་སྙམ་ཙ་ན།",
    "ཁོང་མ་ཧཱ་བཛྲ་དྷ་ར་གསང་བ་འདུས་པའི་དཀྱིལ་འཁོར་དུ་འདུག་དེ་ལ་ཕྱག་མ་བཙལ་བས་འོང་ངམ་གསུང་སྐད།",
    "རྗེ་བཙུན་གྱི་བཀའ་ལུང་རྣམས་ཧོར་སྐད་དུ་བསྒྱུར་ནས་འཆད་ཀྱིན་འདུག་དེའང་ཧོར་གྱི་ལྷ་གནམ་ཐེལ་དཀར་པོས་རྗེ་བཙུན་ལ་ཧོར་གྱི་ཡུལ་དུ་འབྱོན་དགོས་པའི་ཞུ་བ་མང་པོ་འབུལ་གྱིན་འདུག་པ་ལ།",
    "དེར་རྗེ་བཙུན་གྱི་ཞལ་ནས་ཆང་འདྲ་མེད་དམ་གསུངས་པ་ལ་ཐོད་པ་ཕྱེད་ཙམ་འདུག་པ་ཕུལ་བས།",
    "དགེ་སློང་ཀུན་བློ་ནི་ཁོང་རང་ཐུགས་དམ་འཕེལ་པོ་མ་གཏོགས་བརྒྱུད་པ་འཛིན་པ་མ་བྱུང་གསུངས།",
    "ཤར་ཆེན་པ་ལ་རྗེ་དཔལ་ལྡན་པས་སྒྲུབ་པ་ལུང་སྦྱིན་གྱི་དུས་ལོ་བཅོ་བརྒྱད་ཀྱི་བཀའ་རྒྱ་མཛད་གདའ་བ།",
    "ཉ་དབོན་ཡང་མ་ཏིའི་ལུགས་སུ་ཡོད་འདུག་པས།",
    "བརྒྱུད་པ་ཡོད་པ་ཁོ་ན་ཡིན་པས་དྲག་པའི་ཁུངས་སུ་གདའ་གསུངས།",
    "དམ་ཚིག་ཀྱང་རང་བསྲུང་དུ་འགྱུར་ལ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "འདུག་སྟངས་པུས་བཙུགས་སུ་གསུངས་ཀྱང་།",
    "ཤེས་ནི་མི་ཤེས་པར་འདུག་པས།",
    "དེ་གང་ན་འདུག་ཀྱང་ཐེ་ལེ་ལེ།",
    "རང་རང་སོ་སོའི་ཚེ།",
    "སྐྱེས་ན་དེ་འདྲའི་སྡུག་བསྔལ་ལ་བཟོད་ཐབས་མི་འདུག་ཅིང་།",
    "གང་ལྟར་ཡང་སྐྱབས་ཡུལ་དང་རང་སེམས་འདྲེས་པའི་བརྗོད་མེད་ཀྱི་ངང་དུ་ཅི་ཙམ་གནས་ཀྱི་བར་དུ་གཞག་རྣམ་རྟོག་ཅིག་ཐོལ་གྱིས་སྐྱེས་པ་ན།",
    "དེ་བཟོད་པའི་ཐབས་ནི་མི་འདུག་མི་བཟོད་བཞིན་དུ་དེར་མི་སྐྱེ་བའི་གདེང་ནི་ཅིའང་མེད་པའི་ཁར།",
    "ངེས་པར་སྐྱེ་ཐག་ཆོད་འདུག་སྐྱེས་ན་དེ་འདྲའི་སྡུག་བསྔལ་བཟོད་པའི་བླག་དང་།",
    "བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས་ཡི་མུག་ཅིང་ག་ཆད་ལ་ཅི་བྱ་ཟད་པ་ན།",
    "ཐུར་ལ་ཆགས་སེམས་དང་འཇིགས་སེམས་ཀྱིས་འགྲིལ་གྱིན་མཆོངས་ཀྱིན་མགྱོགས་པར་ཕྱིན་པས་ལྕགས་ཀྱི་ཚེར་མ་ཐམས་ཅད་ཁ་གྱེན་ལ་ཕྱོགས་པས་ལུས་ཐམས་ཅད་ཕུག་རྩ་བར་སླེབས་ཙ་ན་གྲོགས་ལ་སོགས་པའི་རྗེས་ཙམ་ཡང་མེད།",
    "བྱ་རྒོད་ཕུང་པོ་ནས་ཕར་ཙམ་གྱི་བར་སྣང་སྟོང་པ་ལ་མི་དབྱིབས་ལུས་ཚད་ཁང་པ་གཉིས་ཙམ་བྱས་པ་ལ།",
    "ལུས་ཀྱི་ཕྱི་ནང་ཐམས་ཅད་མེ་འབར་བའི་སྡུག་བསྔལ་མྱོང་བ་ཞིག་འདུག་དེ་བཤན་པ་ཕྱུགས་མང་པོ་གསོད་པ་དེར་སྐྱེསཔ་དང་།",
    "དེ་ནས་ཚུར་ཙམ་གྱི་བར་སྣང་ལ་མིའི་རྣམ་པ་ལུས་བོང་ཆེ་བ་ཞིག་ལ་འབྲས་བུ་རིའི་གཏོས་ཙམ་ཐུར་དུ་འཕྱང་བ།",
    "ལུས་དང་འབྲས་བུའི་བར་ཤའི་ཐག་པ་རྟ་རྔ་ཙམ་གྱིས་སྦྲེལ་ནས་སྡུག་བསྔལ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་འདུག་པ་ནི་རྟ་བོང་སོགས་ཕྱུགས་ལ་བྱ་གཅོད་བྱས་པའི་རྣམ་པར་སྨིན་པ་དེ་ལྟར་མྱོང་བསྟེ་གསུམ།",
    "གླ་རྣམས་དུས་ལ་མ་བླངས་པར་ལན་ཅིག་རྩིས་བྱས་པས་མང་པོ་བྱུང་འདུག་པ་ཐམས་ཅད་ཁོང་ལ་ཕུལ།",
    "དེ་དག་ཀྱང་བཟོད་པའི་བླག་མི་འདུག་པས་ཅིས་ཀྱང་དེར་མ་སྐྱེས་པ་ཞིག་བྱ་ཨཱ་། དགོས་པར་འདུག་པ་སོགས་གོང་བཞིན་བསམ་པར་བྱའོ།",
    "ཟན་གྱི་རི་བོ་ཆེན་པོ་འདུག་པ་མཐོང་།",
    "སྡུག་བསྔལ་དེ་ཙམ་སྤྱད་ནས་ཕྱིན་པས་འཁྲིས་སུ་སླེབས་ཙ་ན་སའམ་དཀར་གོང་ལྟ་བུའི་ཕུང་པོར་གྱུར་ནས་ཟན་ལ་སོགས་པ་བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས་ངུ་ཞིང་འགྲེ་ལྡོག་པ་དང་།",
    "སྔར་ཕན་ཆད་གང་ལ་འདུག་པ་དེར་འདོད་ཡོན་ལ་ཡེངས་ནས་ལྷོད་དེ་གནས་པ་ལ།",
    "སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་དང་བྲལ་ན་དགའ་བ་ལ་འདི་དེ་ལས་ལྡོག་འདུག་པས།",
    "སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་ལ་ལོངས་སྤྱོད་ཀྱིན་འདུག་པས།",
    "དེ་བས་ཀྱང་ཆེས་ལྷག་པའི་བྱང་སེམས་རྣམས་ལའང་རང་དོན་དུ་སྤངས་རྟོགས་ཀྱི་ཡོན་ཏན་མ་རྫོགས།",
    "དེ་ལྟར་བཞག་པའི་ཚེ་ན་སེམས་དང་མེ་ཏོག་འདྲེས་པ་ཆམ་མེ་ཤིག་གེ་འདུག་ན་རང་སོ་བཟུང་པ་ཞེས་བྱ་སྟེ།",
    "དེས་མཚོན་པའི་ཡོན་ཏན་གྱི་ཚོགས་བསམ་པའི་ཡུལ་ལས་འདས་པར་མངའ་བ་འདུག་པས་ན།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་རོལ་པས་འདུག་སྟེ།",
    "འདུག་ས་འདི་ཉིད་དུ་ཐོབ་པར་༴",
    "མེད་ན་ནི་བེམ་པོ་དང་ཁྱད་མེད་དུ་འདུག་པ་ལས།",
    "ད་ལྟ་གྱ་གྱུ་ཧྲིག་ཧྲིག་འདུག་པ་འདི་ཡིན།",
    "དེང་སང་ལོ་མང་པོ་རི་ལ་བསྡད་དཔེ་མེད་ཀྱི་ཐུགས་དམ་པར་བྱེད་པ་ཚོ་ཡུལ་དུ་སླེབས་ཙ་ན།",
    "རྫི་ཆོམ་མེ་བའི་ངང་ལ་འགྲོ་ཡིན་གདའ་བ་འདི་རྣམས་སྣང་བ་སེམས་སུ་ངོ་མ་འཕྲོད་པའི་སྐྱོན་དུ་གདའ་རྗེ་ས་པཎ་གྱིས།",
    "འོན་ཀྱང་འདི་འདྲའི་ཚོད་ན་ཅུང་མི་ཟབ་པར་གདའ་གསུངས།",
    "དེས་ན་སྣང་གསུམ་གྱི་སྐབས་ཀྱི་ཞི་ལྷག་དེ་ལེགས་པོ་ལོས་ཡིན་ནའང་།",
    "དགྲ་ལ་ཞེ་སྡང་སྐྱེས་ན་ང་རང་འཁྲུལ་པ་ཡིན།",
    "འདུག་བཟའ་བཏུང་སོགས་ཐམས་ཅད་ལ།",
    "འཁྲིས་ན་ཡོད་པ་རྣམས་ཀྱིས་མེད་པ་ལ་མེད་པར་ཤེས་ནས་ཇི་ཙམ་སྨྲས་ཀྱང་མི་ཉན་པར་ཁོ་རང་འཁྲུལ་པ་དང་འཇིགས་པས་གད་མཆོངས་གཡང་མཆོངས་དུ་མ་བྱེད།",
    "འདི་ཞེས་བརྗོད་མ་ཤེས་པས་བརྗོད་བྲལ་དུ་འདུག་སྙམ་ཐག་གཅད་དོ།",
    "ཤར་ཙམ་ནས་སྐྱེ་འགག་དང་བྲལ་བའི་སྟོང་པ་ཉིད་གང་དུའང་མ་གྲུབ་པར་འདུག་སྙམ་དུ་གོང་ལྟར་བསམ་ཞིང་ཉམས་སུ་ལེན་པར་བྱེད།",
    "སྔ་མ་ཁོ་རང་འབར་བཞིན་དུ་གནས་པའོ།",
    "གཡའ་བ་དེ་ཚུལ་འདི་ལྟར་འདུག་ཅེས་བརྗོད་མི་ཤེས་པ་ལྟ་བུའོ།",
    "གང་ཟག་དེའི་བློ་ཡུལ་དུ་ཟླ་བ་དེ་འདི་འདྲ་ཞིག་ཡོད་པར་འདུག་སྙམ་དུ་དོན་སྤྱིའི་རྣམ་པར་འཆར་བ་བཞིན།",
    "སེམས་ཀུན་གཞི་ཁོ་རང་ངོ་མ་ཤེས་པའི་ཚེ།",
    "དེ་དག་ཀྱང་སོ་སོའི་སྣང་ངོ་ཙམ་དུ་འདུག་ངོ་བོ་ཟུང་འཇུག་ལས་མ་འདས་པར་འདུག་སྙམ་དུ་ངེས་ཤེས་སྐྱེ་བ་ཡིན་གསུངས།",
    "བསྒོམ་བྱའི་དོན་ལ་ཐོས་བསམ་གྱིས་སྒྲོ་འདོགས་གཅོད་པ་ཙམ་ཞིག་བྱས་པའི་ཚེ་ཡིན་པར་འདུག་སྙམ་པའི་གོ་ཡུལ་ལམ་མེ་བ་ལས་རྒྱུད་ལ་མ་སྐྱེས་པ།",
    "གསལ་ཐེབས་པ་ན་དེ་དང་རང་སེམས་དབྱེར་མེད་དུ་བསྲེས་ནས་ཆམ་མེར་འཇོག་གསལ་ན་གསལ་ཏེ་འཕྲོ་གཅད།",
    "ཡང་སྔར་བཞིན་ཞི་གནས་དང་འདྲེས་ནས་རྟོག་མེད་དུ་ཆད་དེ་གནས་ཀྱིན་འདུག་ན་སྤོ་མི་དགོས།",
    "ཟླ་བ་འབུམ་ཕྲག་དུས་གཅིག་ཏུ་ཤར་བ་ལྟ་བུ།",
    "མདུན་གྱི་ལྷ་དང་རང་སེམས་བསྲེས་ནས་བརྗོད་མེད་དུ་ཆམ་ཆམ་འཇོག་དེ་ལྟ་བུ་ལ་སོགས་པས་གོམས་སུ་འཇུག་སྟེ།",
    "ད་ང་ཤི་འདུག་སྙམ་དུ་སྡུག་བསྔལ་བསམ་གྱིས་མི་ཁྱབ་པ་འབྱུང་།",
    "གཉིས་པ་སྦྱང་བ་དེ་ལྟར་རྨི་ལམ་བཟུང་བས་རྨི་ལམ་གྱི་སྐབས་སུ་འདི་ལྟར་རྨི་ལམ་གྱི་སྣང་བར་འདུག་སྙམ་པ་ཤར་བའི་ཚེ།",
    "བདག་རྒྱུད་བྱིན་གྱིས་བརླབ་པར་གསོལ་བ་འདེབས་ཤིང་རང་ལ་བསྟིམ།",
    "ད་ཅིས་ཀྱང་བྱོན་པ་དྲག་མི་འབྱོན་ན་ང་ནི་ཕྱག་ཕྱི་ལ་སྡོད་མི་ནུས་པར་འདུག་ཟེར་ནན་གྱིས་བསྐུལ་བས་ས་སྐྱར་ཕེབས།",
    "ཅིས་ཀྱང་འོང་བ་ཡིན་པར་གདའ་གསུངས་ནས།",
    "སླར་སྐྱེད་ཚལ་དུ་བྱོན་ནས་སྔར་རྒྱུན་བཞིན་ཚོགས་ལ་ཕེབས་ཀྱིན་ཡོད་ཙ་ན།",
    "དྲུང་པ་འདིས་བསྟན་པ་ལ་ཕན་པར་འདུག་པས་བསྒྲག་དགོས་གསུངས་པའང་ཕྱིས་བསྟན་པའི་སྲོག་ཤིང་ཆེན་པོར་འགྱུར་བའི་ལུང་བསྟན་དུ་གདའ།",
    "དེའི་ཚུལ་འཇམ་དབྱངས་མཁྱེན་བརྩེ་ལ་ཞུས་པས་ཁ་སྦྱོར་ཡན་ལག་བདུན་ཐོབ་པའི་ལྟས་སུ་འདུག་གསུངས།",
    "དེ་ནུབ་མནལ་ལམ་དུ་ཀྱེེ་རྡོ་རྗེའི་ཐུགས་ཀར་སློབ་དཔོན་ཆེན་པོ་བཞུགས་འདུག་པ་གསལ་བར་ཤར་བས།",
    "ཞིབ་ཆ་སླར་འབུལ་གསུངས་པ་ལས་གཞན་ཅིའང་མ་གསུངས་པའང་དེར་གདའ།",
    "མནལ་སད་ཙ་ན་བསྙུང་གཞི་ཐམས་ཅད་སྦྲུལ་ཤུན་བརྗེས་པ་ལྟར་དྭངས་འདུག་ཐུགས་ལ་རྨི་ལམ་རང་ཡིན་ནམ།"
  ]
}