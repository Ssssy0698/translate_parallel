    "དུས་མ་ཡིན་པར་ཁྲིའམ་ཁྲིའུ་འམ་རྩྭ་བཏིང་བའམ་ལོ་མ་བཏིང་བ་ལ་གློས་འབེབས་པར་མི་བྱེད་པའོ།",
    "སྐད་གསང་མཐོན་པོས་གསུངས་པ་ལ་ཟེར།",
    "ཡུལ་དེ་དག་ཇི་ལྟར་ཡིན་བ་ལ་ངེས་པ་རྙེད་ནས་མི་མཐུན་བ་མེད་པར་འཛིན་ཅིང་ཡང་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "འཇིག་རྟེན་ཡོང་གྲགས་ལ་རྩོལ་བ་ཆེན་པོ་བྱས་ཞེས་པའི་རྩོལ་བ་དེ་དང་བརྩོན་འགྲུས་གཉིས་ལ་མུ་བཞི་ཡོད།",
    "ཁྱད་པར་དུ་འཕགས་པའི་བརྩོན་འགྲུས་གང་ཡིན་པ་དེ་ནི་རྟག་ཏུ་བརྟེན་བར་གྱིས།",
    "རྟག་ཏུ་བརྩོན་འགྲུས་རྩོམ་ལ་གནས་པར་བྱེད།",
    "འདི་ནི་ང་ཡིས་དེ་དག་བསྐུལ་བྱས་ཡིན།",
    "བརྩོན་འགྲུས་ཀྱིས་ནི་སྲིད་པའི་ཕུན་ཚོགས་རྣམས་ཀྱང་འཐོབ་པར་བྱེད།",
    "བརྩོན་འགྲུས་ལྡན་པ་ཞིག་ལ་ཐོབ་བྱ་འདི་མི་ཐོབ་པར་བྱ་བ་གཅིག་ཀྱང་མེད།",
    "སྤྱོད་ལམ་ཐམས་ཅད་དོན་དང་ལྡན་པར་འགྱུར།",
    "ཞེས་ཕན་ཡོན་དེ་ལྟར་གསུངས།",
    "བརྩོན་འགྲུས་ལྡན་པ་ལོངས་སྤྱོད་ཀྱིས་ཀྱང་ཕམ་པ་མེད་གསུངས།",
    "མེ་ཏོག་ཨུཏ་པ་ལ་བཞིན་རྣམ་པར་འཕེལ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "བྱང་སེམས་རྣམས་བརྩོན་འགྲུས་རྩོམ་བ་ན་སྦྱོར་བའི་སྔ་རོལ་ནས་སེམས་ཀྱི་སྤྲོ་བ་སྔོན་དུ་འགྲོ་བའི་བསམ་པའི་གོ་ཆ་འདི་ལྟ་བུ་གྱོན་པར་བྱེད་དེ།",
    "ཅེས་གསུངས་བའང་གོ་ཆའི་བརྩོན་འགྲུས་སོ།",
    "ཉེ་ལམ་ལ་ཞུགས་པ་སྐད་བྱས་ཀྱང་།",
    "དེ་ཡང་མཁས་གྲུབ་ཆེན་པོ་ཞི་བ་ལྷའི་གཞུང་ཉིད་གོ་སླ་ཞིང་སྐྱོང་བདེ་ལ་ཡོངས་སུ་རྫོགས་བར་མཐོང་བས་དེའི་ལུགས་བརྗོད་པར་བྱའོ།",
    "ཞི་བ་ལྷའི་བརྩོན་འགྲུས་ཀྱི་ལེའུའི་དོན་ཆ་ཚང་འདིར་གསུངས་ལ།",
    "བརྩོན་འགྲུས་ཧ་ཅང་གཟབ་གཟབ་བྱས་ནས་གསུངས་པ་གང་ཡིན་བརྟག།",
    "ཁ་ཅིག་རྐང་བ་དང་བོ་གཉིས་ཀྱིས་རྣམ་བ་ཇི་ལྟར་དུ་སྐྱེ་བ་བསྟན་པར་འདོད་དོ།",
    "ཚེ་འདིའི་དོན་ཆེན་བོ་ཉམས་པར་བྱེད་པ་དང་ཕྱི་མར་དོན་མ་ཡིན་པ་སྡུག་བསྔལ་དུ་མ་བསྐྱེད་བའི་གནས་སུ་མཐོང་ནས་བསྒོམས་ལ་དགག་བར་བྱ་སྟེ།",
    "སྒྱིད་ལུག་པར་ནི་མི་བྱ་སྟེ།",
    "བདེན་བ་གསུང་བས་བདེན་འདི་གསུངས།",
    "བདག་ལ་སྨོད་པ་མི་རུང་སྐྱེས་བུ་དར་བ་ཞུམ་བར་བགྱིད་བ་ལགས།",
    "སྐྱོན་སྒོ་མཐའ་ཡས་བ་ནས་དགག་དགོས་བར་ལེགས་པར་གོ་ནས་དེ་ནས་རང་སྟེང་དུ་བལྟས་པ་ན་ཞུམ་པ་སྐྱེ་བ་ཡིན་གྱི།",
    "ཡོན་ཏན་མཐའ་ཡས་པ་སྒྲུབ་པའི་ཚུལ་ཅི་ཡང་མི་ཤེས་པར།",
    "ལམ་གྱི་མགོ་མཇུག་རགས་རིམ་ཙམ་ཞིག་བསྒྲིགས་པས་ལུས་ཚང་བ་ཙམ་བསྟེན་བ་ན་ཡང་དེ་ཙམ་དགོས་ན་སུས་ནུས་ཟེར་བ་ལེགས་པར་སྤོང་བར་སྣང་བའི་ཕྱིར་རོ།",
    "དཔག་ཏུ་མེད་པ་རྣམ་པ་བཞིའི་སྒོ་ནས་ཚོགས་བདེ་བླག་ཏུ་རྫོགས་པ་ཡོད་གསུངས།",
    "ཐུབ་པ་ཞིག་ཡོད་ན་ཡང་བཀའ་དྲིན་ཅན་གྱི་ཇོ་བོ་རྗེས་ལམ་གྱི་རིམ་པ་སྒྲིག་ཚུལ་དེ་ཧ་ཅང་ལས་སླ་པོ་བྱས་ནས་བསྒྲིགས་ཡོད་པས།",
    "འོན་ཀྱང་མགོ་ཀ་ཁ་ནས་བཟུང་རིམ་གྱིས་བསླབས་ན་རྗེས་སུ་ཡི་གེ་འབྲི་ཀློག་ལ་དཀའ་ཚེགས་མེད་པར་འགྱུར་བ་བཞིན་བློ་གོམས་པའི་རྗེས་སུ་བྱེད་པ་ཡིན་པས་སྐྱོན་མེད།",
    "ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་མཁན་དཔེར་ན།",
    "གསང་སྔགས་རྒྱུད་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་དཔལ་གསང་བ་འདུས་པ་འདི་ལྟ་བུ་ཉམས་བཞེས་གནང་བའི་ཕྱག་སྲོལ་རྨད་དུ་བྱུང་བ།",
    "དུས་ད་ལྟ་ཡིན་ན་ཡང་ཉམས་པ་མེད་པར་གནས་ཡོད།",
    "དངོས་འབྲེལ་བྱས་ན་ནང་པ་ནང་ཚགས་ཀྱི་འབྲེལ་བ་ཆེ་དགོས་པ་ཡིན།",
    "བོད་བ་ནང་ཚགས་ལ་མཚོན་ན་ཡང་དབུས་གཙང་།",
    "དབུས་གཙང་ནས་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "ཡིན་ན་ཡང་གཙང་པ་ཚོས་ཤུགས་བརྒྱབ་ནས་ཁ་ཤས་བྱུང་ཡོད།",
    "དེ་དག་རིས་མེད་གནང་མཁན་ཤ་སྟག་ཡིན།",
    "དེ་ནས་ཁམས་ལ་མཚོན་ན་རྙིང་མ་དང་ས་སྐྱ་དང་བཀའ་བརྒྱུད་དེ་འདྲ་མང་པོའི་ནང་རིས་མེད་གནང་མཁན་མང་།",
    "ཐམས་ཅད་མཁྱེན་པ་རྒྱལ་མཆོག་བསྐལ་བཟང་རྒྱ་མཚོ་ལ་མཚོན་ན་དགེ་ལུགས་རྐྱང་རྐྱང་བྱས་པ་མ་གཏོགས་དེ་འདྲའི་རིས་མེད་གནང་མེད་ལ་གནང་ཁོམ་ཡང་མ་བྱུང་བ་ཡིན་ལས་ཆེ།",
    "དཔྱད་པ་བྱས་པའི་སྟེང་ནས་ཕན་ཚུན་ངོ་འཕྲོད་པ་བྱུང་ན་ཤེས་ནས་དད་པ་ཐོབ་པ་ཞིག་ཡོང་བ་ཡིན།",
    "ཅེས་གསུངས་པ་བཞིན་དགོངས་པ་ལེན་ཐུབ་ན་དགེ་ལུགས་པ་སྐྱེས་བུ་ཆེན་པོའི་ལམ་གྱི་རིམ་པའི་བཀའ་ཁྲིད།",
    "འདི་ལྟར་ལོག་པར་རྟོག་པབ་དང་།",
    "འདི་ལ་རྟག་ཏུ་འབད་པར་བྱ།",
    "དེ་ཤིན་ཏུ་དཀའ་བས་མི་ནུས་སོ་སྙམ་དུ་ཞུམ་པར་མི་བྱ་སྟེ།",
    "དུས་དབག་ཏུ་མེད་པར་གནས་པ་ལ་དམིགས་ནས་ཚོགས་མཐའ་ཡས་བ་བསྒྲུབ་བར་བྱའོ་སྙམ་ནས་སྡོམ་བ་བཟུང་བ་ན།",
    "སྡུག་བསྔལ་དག་ལས་དྲངས་བྱས་ཏེ།",
    "བོར་མི་ཐོགས་པར།",
    "དགོས་པའི་དོན་སྒྲུབ་མཁས་ལ་བརྟེན་བྱས་ན།",
    "དེ་བས་འཇིགས་ཤིང་མི་དགའ་མ་བྱེད་པར།",
