    "འདི་ལྟར་བདག་ཅེས་བྱ་བའི་གང་ཡིན་པ་དེ་བདག་གི་ཞེས་བྱ་ན།",
    "དེ་ལྟ་བས་ན་བདག་གི་ཡང་མི་འཐད་དོ།",
    "དེ་ལྟར་ཕྱི་དང་ནང་ལ་བདག་དང་བདག་གིར་མི་ལྟ་བ་དེ་ནི་དེ་ཁོ་ན་མཐོང་བ་ཡིན་ཏེ།",
    "བདག་དང་བདག་གི་ཞི་བའི་ཕྱིར།",
    "གང་གིས་དེ་ལྟར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་བ་ན་ངར་འཛིན་པ་དང་ང་ཡིར་འཛིན་པ་མེད་པར་འགྱུར་རོ།",
    "དེ་ཉིད་བདག་ཡིན་པས་དེ་ཡོད་པའི་ཕྱིར་བདག་དང་བདག་གི་ཡང་ངེས་པ་ཁོ་ནར་ཡོད་པ་ཡིན་ནོ།",
    "གང་གིས་མཐོང་བས་མི་མཐོང་ངོ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་ཚེ་དང་ལྡན་པ་འདིའི་མིང་ནི་འདི་ཞེས་རུས་ནི་འདི་ཞེས་བྱ་ཞེས་བྱ་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་ལེན་པ་མ་གཏོགས་པར་གང་ཟག་གི་མིང་དང་རུས་དག་མེད་དོ་ཞེས་གསུངས་སོ།",
    "ང་ཡིར་འཛིན་པ་མེད་པར་གང་གིས་མཐོང་བ་ལོག་པར་ལྟ་བ་བློ་གྲོས་ཀྱི་མིག་ཉམས་པ་དེས་ནི་དེ་ཁོ་ན་མི་མཐོང་བ་ཉིད་དོ།",
    "བདག་དང་བདག་གི་ཟད་གྱུར་ན།",
    "བདག་གི་ཞེས་བྱ་བར་དེ་དག་ལ་ལོག་པར་འཛིན་པ་ཟད་པར་གྱུར་ན་ཉེ་བར་ལེན་པར་བྱེད་པ་གང་ཡིན་པ་དེ་མེད་ཅིང་ཉེ་བར་བླང་བར་བྱ་བ་གང་ཡིན་པ་དེ་ཡང་མེད་པས།",
    "ལས་དང་ཉོན་མོངས་ཟད་པས་ཐར།",
    "ལས་དང་ཉོན་མོངས་རྣམ་རྟོག་ལས།",
    "ལས་དང་ཉོན་མོངས་པ་དེ་དག་ཀྱང་ཡང་དག་པ་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པ་ལས་བྱུང་བ་ཡིན་གྱི་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་ནི་ཚུལ་བཞིན་མ་ཡིན་པར་རྣམ་པར་རྟོག་པ་ལས་བྱུང་བ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཉོན་མོངས་པ་རྣམས་ནི་རྣམ་པར་རྟོག་པ་ལས་བྱུང་ངོ།",
    "དེ་ལྟ་བས་ན་ལས་དང་ཉོན་མོངས་པ་དག་ནི་ཡང་དག་པ་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པའི་རྒྱུ་ལས་བྱུང་བ་ཡིན་ནོ།",
    "གང་གིས་བཅིངས་པ་དང་ཐར་བ་དག་སྟོན་པར་བྱེད་པའི་བདག་ཅེས་བྱ་བ་དེ་ནི་འགའ་ཞིག་ཡོད་དོ།",
    "སྲིད་པའི་བདེ་བ་ལ་ཆགས་པ་དེ་དག་གི་བདག་ཏུ་ལྟ་བ་བཟློག་པའི་ཕྱིར་བདག་མེད་དོ།",
    "རང་གི་རྟོག་གེའི་རྗེས་སུ་འབྲང་བ་བདག་མེད་ན་འདི་དག་ཐམས་ཅད་མི་འཐད་དོ།",
    "ཞེས་སྐྲག་པ་ཁ་ཅིག་གིས་བདག་གོ་ཞེས་ཀྱང་བཏགས་སོ།",
    "དེ་བཞིན་དུ་བློ་གྲོས་རྣམ་པར་རྨོངས་པ་མེད་པ་དག་གིས་འཇིག་རྟེན་ན་ཕུང་པོར་བྱེད་པ།",
    "ལས་དང་འགྲོ་བ་ལྐོག་ཏུ་གྱུར་པ་གཞན་དག་གིས་བདག་མེད་དོ་ཞེས་ཀྱང་བསྟན་ཏོ།",
    "གང་གི་ཕྱིར་དངོས་པོ་རྣམས་སྟོང་པར་མཐོང་ན།",
    "གང་གི་ཕྱིར་དེའི་སེམས་ཀྱི་སྤྱོད་ཡུལ་གཟུགས་ལ་སོགས་པ་དག་ལོག་པར་གྱུར་པ་དེའི་ཕྱིར་བརྗོད་པར་བྱ་བ་ལྡོག་པར་འགྱུར་ཏེ།",
    "ཁྱོད་ནི་སྟོང་པ་ཉིད་ཀྱི་དོན་རྣམ་པར་མི་ཤེས་ནས་དེ་གཉིས་འདྲའོ་སྙམ་དུ་སེམས་སོ།",
    "སོ་སོར་བརྟགས་ནས་བཏང་སྙོམས་བྱེད་པ་གང་ཡིན་པ་དེ་གཉིས་བཏང་སྙོམས་བྱེད་པར་ནི་འདྲ་མོད་ཀྱི་སོ་སོར་མ་བརྟགས་པར་བཏང་སྙོམས་བྱེད་པ་ནི་མ་རིག་པའི་ཀུན་ཏུ་སྦྱོར་བ་དང་ལྡན་པར་བསྟན་ལ།",
    "སྐྱོན་དེ་དག་གིས་གོས་པར་འགྱུར་རོ།",
    "ཁྱོད་ཉིད་མཐོང་ན་འཆིང་འགྱུར་ཏེ།",
    "ཁྱོད་ཉིད་མཐོང་ན་གྲོལ་འགྱུར་ཏེ།",
    "གཞན་ཡང་ཁྱོད་མཁས་པར་རློམ་པ་ཉིད་ཀྱི་བློ་སྔོན་དུ་བཏང་སྟེ་ལྟ་བ་སེམས་པར་མཚུངས་ཤིང་ཁོ་བོ་ལ་རྒོལ་བར་བྱེད་ཀྱི།",
    "ཁོ་བོ་ནི་དངོས་པོ་རྣམས་རི་བོང་གི་རྭ་བཞིན་དུ་མེད་པ་ཉིད་དུ་མཐོང་ལ་ཚིག་གི་སྐྱོན་རྣམས་ཡོངས་སུ་སྤང་བའི་ཕྱིར་ཡོད་པ་ཉིད་ཀྱང་མ་ཡིན་ལ་མེད་པ་ཉིད་ཀྱང་མ་ཡིན་ནོ་ཞེས་མི་སྨྲའི།",
    "ཁྱོད་ནི་ནོར་བུ་དོ་ཟན་ཨན་ད་རྙིལ་གྱི་རིན་ཐང་དུ་འཚོང་བ་ན།",
    "ཡིད་ལ་བསམས་པ་དང་མཐུན་པའི་འབྲས་བུ་ཡང་མ་ཐོབ་ལ་རང་གི་བློ་ཡང་བར་ཡང་བསྟན་པ་བཞིན་དུ་གྱུར་ཏོ།",
    "ཅི་ཁྱོད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་བ་ལ་ཡང་རྩོམ་པ་ཡོད་པར་ལྟའམ།",
    "གང་གི་ཚེ།",
    "ཁྱོད་ནི་འཇིགས་པ་སྐྱེ་བར་འགྱུར།",
    "དེའི་ཕྱིར་གང་གི་ཚེ་འཇིག་རྟེན་གྱི་ཐ་སྙད་བྱ་བ་དེའི་ཚེ་ན་གང་འཇིག་རྟེན་ལ་ཡང་དག་པ་ཉིད་དུ་གྲགས་པ།",
    "ཅིག་ཤོས་ཀྱིས་སྨྲས་པ་ཁྱོད་ཀྱིས་ལོག་པར་བཟུང་སྟེ།",
    "དེས་གཅིག་ལ་ནི་ཁྱོད་ཟེར་བ་བདེན་ནོ།",
    "འདི་དག་ནི་རྩིག་པ་ལ་བརྟེན་པའི་རི་མོ་བྲིས་པའོ།",
    "ཞེས་བྱ་བ་དེ་ལྟར་ཤེས་མོད་ཀྱི།",
    "ཞེས་སྨྲས་པ་ལ་བརྫུན་གྱི་ཚིག་གི་སྐྱོན་ཅན་དུ་མ་གྱུར་པ་དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་སྟོང་པར་གཟིགས་ཀྱང་།",
    "མུ་སྟེགས་བྱེད་ཐམས་ཅད་དང་ཐུན་མོང་མ་ཡིན་པ་དོན་དམ་པ་གསལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "ཡང་ན་འདི་ནི་དོན་གཞན་ཏེ་ཁ་ཅིག་ན་རེ་ཐམས་ཅད་ཡོད་པ་ཉིད་ལས་སྐྱེའོ།",
    "གཞན་དག་ན་རེ་རྒྱུ་ལ་འབྲས་བུ་སྔ་ན་མེད་པ་དག་ལས་སྐྱེའོ།",
    "ཁ་ཅིག་ན་རེ་ཡོད་པ་དང་མེད་པ་ལས་སྐྱེའོ།",
    "ལུང་མེད་པར་བདག་གི་མངོན་སུམ་དུ་འགྱུར་ཞིང་།",
    "དེ་ལ་གང་གི་ཕྱིར་རྣམ་པར་རྟོག་པ་མེད་པ་དེའི་ཕྱིར་སྤྲོས་པ་རྣམས་ཀྱིས་མ་སྤྲོས་པའོ།",
    "གང་གི་ཕྱིར་ཞི་བ་དེའི་ཕྱིར་དོན་ཐ་དད་པ་མ་ཡིན་པ་སྟེ།",
    "དེ་ནི་རེ་ཞིག་དེ་ཉིད་མིན།",
    "འདི་ལྟར་གང་ལ་བརྟེན་ཏེ་གང་བྱུང་བ་དེ་ནི་རེ་ཞིག་དེ་ཉིད་མ་ཡིན་ནོ།",
    "དེ་ལྟར་གང་གི་ཕྱིར་གང་ལ་བརྟེན་ཏེ་གང་བྱུང་བ་དེ་དེ་ཉིད་ཀྱང་མ་ཡིན་ལ་དེ་ལས་གཞན་པའང་མ་ཡིན་པ་དེའི་ཕྱིར་ཆད་པ་ཡང་མ་ཡིན་ལ་རྟག་པ་ཡང་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ས་བོན་ཉིད་མྱུ་གུ་མ་ཡིན་པ་དེའི་ཕྱིར་ས་བོན་རྟག་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ས་བོན་ལ་མྱུ་གུ་གཞན་མ་ཡིན་པ་དེའི་ཕྱིར་ས་བོན་ཆད་པ་མ་ཡིན་ཏེ།",
    "འདི་ལ་ཁྱོད་ཀྱིས་བྱེད་པ་པོ་ལས་བརྟག་པའི་ཞར་ལ་འོངས་པ་དེ་གའི་རིགས་པ་རྗེས་སུ་བསྟན་པས་ཁོ་བོའི་ཡིད་ཀྱིས་དག་ལ་དངོས་པོ་ཡོད་པ་དང་མེད་པར་ལྟ་བའི་ཤིང་བརྟན་པོ་ཆེན་པོ་ཡུན་རིང་པོ་ནས་རབ་ཏུ་གནས་པའི་རྩ་བ་ཡང་ལེགས་པར་འགུལ་གྱི།",
    "འདི་ལ་རེ་ཞིག་གལ་ཏེ་མ་འོངས་པའི་དུས་སུ་གྱུར་ནས་རིམ་གྱིས་ད་ལྟར་དུ་འགྱུར་ཞིང་།",
    "དཔེར་ན་ཙེ་ཏྲ་གྲོང་དུ་ཕྱིན་ན་ཡང་ཙེ་ཏྲ་ཉིད་ཡིན་ལ་གྲོང་ནས་ཐལ་ན་ཡང་ཙེ་ཏྲ་ཉིད་ཡིན་ཏེ།",
    "ཕྱིན་པ་དང་ཐལ་བ་གསུམ་ཉིད་དུ་དབྱེར་མེད་པ་བཞིན་ནོ།",
    "དེ་ལ་རེ་ཞིག་གལ་ཏེ་དུས་གསུམ་དུ་ལྟོས་ནས་རབ་ཏུ་འགྲུབ་པར་སེམས་ན།",
    "གང་གི་ཚེ་ད་ལྟར་བྱུང་བ་དང་མ་འོངས་པ་དག་འདས་པ་ལ་ལྟོས་ནས་འགྲུབ་བོ་ཞེས་སྨྲས་པ་དེའི་ཚེ་ཇི་ལྟར་དེ་གཉིས་འདས་པ་ན་ཡོད་པར་འགྱུར།",
    "གང་གི་ཕྱིར་དེ་ལ་ལྟོས་ནས་འགྲུབ་བོ་ཞེས་སྨྲས་པ་དེ་ཁོ་ནའི་ཕྱིར་དེ་གཉིས་དེ་ན་ཡོད་པར་ཐལ་བར་འགྱུར་རོ།",
    "འདི་ལྟར་གསུམ་ཆར་ཡང་ཚོགས་པར་གྱུར་ན་ལྟོས་པར་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་རེ་ཞིག་ད་ལྟར་བྱུང་བ་དང་མ་འོངས་པ་དག་འདས་པ་ལ་ལྟོས་ནས་རབ་ཏུ་འགྲུབ་པར་མི་འཐད་དོ།",
    "དེ་ལྟར་གང་གི་ཕྱིར་ད་ལྟར་བྱུང་བ་དང་མ་འོངས་པ་གཉིས་འདས་པའི་དུས་ན་ཡོད་པ་མ་ཡིན་པས་ལྟོས་པར་མི་འཐད་ལ།",
    "མཚན་མོ་དང་ཉིན་མོ་དང་ཟླ་བ་ཕྱེད་དང་།",
    "ཟླ་བ་དང་དུས་ཚིགས་དང་ནུར་བ་དང་ལོ་ལ་སོགས་པ་དག་གི་ཚད་དང་ལྡན་པར་རབ་ཏུ་གྲུབ་པས་དེ་ལ་ལྟོས་པས་ཅི་ཞིག་བྱ།",
    "དུས་ལ་ནི་གང་གི་ཚད་ལས་གཟུང་བར་བྱ་བ་རིལ་པོ་ངེས་པར་གནས་པ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཉིན་མོ་ལ་སོགས་པ་དག་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "དངོས་པོ་མ་གཏོགས་པར་ཁྱོད་ཀྱི་དུས་རང་ལས་རབ་ཏུ་གྲུབ་ཅིང་ངེས་པར་གནས་པ་འཐད་པར་ག་ལ་འགྱུར།",
    "ཙེ་ཏྲ་དང་གུབ་ཏ་གཉིས་རང་གིས་སྔ་མ་དང་ཕྱི་མར་ཐ་དད་པ་མ་ཡིན་པ་ལས་དུས་སྔ་ཕྱི་ལས་སྔ་མ་དང་ཕྱི་མ་ཉིད་དུ་གྱུར་ལ།",
    "དེའི་ཕྱིར་གལ་ཏེ་དུས་དངོས་པོ་ལ་བརྟེན་ནས་རབ་ཏུ་འགྲུབ་པར་སེམས་ན་དངོས་པོ་དེ་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་པས་ཁྱོད་ཀྱི་དུས་ལྟ་ཡོད་པར་ག་ལ་འགྱུར།",
    "གང་གི་ཚེ་སྔར།",
    "དེ་དག་ལ་སོགས་པ་བརྗོད་པ་དག་མི་འཐད་དོ་ཞེས་བྱ་བ་དེ་ནི་ཁྱོད་ཀྱིས་ཅུང་ཟད་ཅིག་སྨྲས་སུ་ཟད་ཀྱི།",
    "དུས་དང་ཚོགས་པ་ཉིད་ལས་འབྲས་བུ་འགྲུབ་པའི་ཕྱིར་ཏེ།",
    "ཐུག་པ་མེད་པར་ཐལ་བར་ཡང་འགྱུར་ཏེ།",
    "རྒྱུ་སྤུན་དག་ལས་ཀྱང་སྣམ་བུ་ཉིད་འབྱུང་གི།",
    "ཁྱོད་ཀྱིས་འདི་ལྟར་རྒྱུ་དང་རྐྱེན་དག་ངེས་སོ་ཞེས་བྱ་བར་ངེས་པའི་གཏན་ཚིགས་མ་བསྟན་ཏོ།",
    "དེ་ལྟ་བས་ན་ངེས་པའི་གཏན་ཚིགས་མེད་པས་རྒྱུ་དང་རྐྱེན་དག་རྒྱུ་དང་རྐྱེན་མ་ཡིན་པ་རྣམས་དང་མཚུངས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ངེས་པའི་གཏན་ཚིགས་མེད་པས་རྒྱུ་དང་རྐྱེན་དག་རྒྱུ་དང་རྐྱེན་མ་ཡིན་པ་རྣམས་དང་མཚུངས་པར་ཐལ་བར་འགྱུར་བ་ཉིད་དོ།",
    "མངོན་སུམ་ལ་གཏན་ཚིགས་ཀྱི་ཚིག་གི་དོན་མེད་དེ།",
    "གང་གི་ཚེ་མངོན་སུམ་ཉིད་དུ་ནས་ཀྱི་ས་བོན་ལས་ནས་ཀྱི་མྱུ་གུ་ཉིད་སྐྱེའི་འབྲས་ཀྱི་མྱུ་གུ་མི་སྐྱེ་བ་དེའི་ཚེ་གཏན་ཚིགས་གཞན་བཙལ་ཅི་དགོས།",
    "འབྲས་བུ་ནི་རྒྱུ་དང་ཚོགས་པ་དག་དང་ལྷན་ཅིག་སྐྱེ་སྟེ་མར་མེ་དང་འོད་བཞིན་པ།",
    "དུས་གཅིག་པར་ནི་ཐལ་བར་འགྱུར།",
    "ཡང་སྐྱེ་བར་ནི་ཐལ་བར་འགྱུར།",
    "དེ་ལྟ་ན་ཡང་སྔོན་སྐྱེས་པའི་རྒྱུ་ཉིད་ཀྱང་སྐྱེ་བར་ཐལ་བར་འགྱུར་རོ།",
    "ཅི་ཁྱོད་ལམ་དུ་ཞུགས་བཞིན་དུ་ལམ་འདྲིའམ།",
    "ཁྱོད་དངོས་པོ་ཡོངས་སུ་འགྱུར་བ་འབྲས་བུ་ཞེས་བྱའོ་ཞེས་ཟེར་བཞིན་དུ་རང་གི་ཚིག་གི་དོན་ཁོང་དུ་མ་ཆུད་དོ།",
    "དེའི་ཕྱིར་ཁྱོད་ཚེགས་ཆེ་བས་ཆོག་གི་འདུག་ཤིག་དང་།",
    "ད་ཁོ་བོ་ཉིད་ཀྱིས་ཁྱོད་ཀྱིས་བསྟན་པའི་ལྟ་བ་རྒྱུ་དང་འབྲས་བུར་འབྲེལ་པར་རྣམ་པར་རྟོག་པ་དག་ཏུ་བསྟན་པར་བྱས།",
    "ཁྱོད་ཡིད་བསྡུས་ལ་དེ་དག་ཉོན་ཅིག།",
    "གལ་ཏེ་རེ་ཞིག་རྒྱུ་རྣམ་པ་ཐམས་ཅད་དུ་འགགས་པ་ནུབ་པར་གྱུར་པས་འབྲས་བུ་སྐྱེས་པ་སྐྱེད་པར་བྱེད་པར་རྟོག་ན།",
    "དེའི་ཕྱིར་གང་གི་ཚེ་འབྲས་བུ་སྐྱེས་པ་ཉིད་དང་རྒྱུར་འབྲེལ་པ་ཡིན་གྱི་མ་སྐྱེས་པ་དང་ནི་མ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱི་འབྲས་བུ་གང་ཞིག་རྒྱུས་སྐྱེད་པར་བྱེད་པ་དེ་སྨྲོས་ཤིག།",
    "གང་གི་ཚེ་འབྲས་བུ་མ་སྐྱེས་པའི་ཕྱིར་མེད་པ་ལ་འབྲས་བུ་ཞེས་བྱ་བ་ཉིད་ཀྱང་མེད་པ་དེའི་ཚེ་རྒྱུས་འབྲས་བུ་སྐྱེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་དེ་ཇི་ལྟར་འཐད་པར་འགྱུར།",
    "ཅི་སྟེ་ཡང་མེད་ཀྱང་དེ་ལ་དེ་སྐད་ཅེས་སྐྱེད་པར་བྱེད་པའི་མཐུ་ཉིད་ཡོད་པར་གྱུར་ན་ནི་དེས་རི་བོང་གི་རྭ་ཡང་བསྐྱེད་པར་འགྱུར་བར་ཐེ་ཚོམ་མེད་དོ།",
    "གལ་ཏེ་རེ་ཞིག་མཐོང་བས་སྐྱེད་པར་འགྱུར་ན།",
    "འདས་པ་དང་མ་འོངས་པ་དག་གི་འབྲས་བུ་དང་རྒྱུ་དག་མེད་པའི་ཕྱིར་རོ།",
    "འདས་པ་དང་མ་འོངས་པ་དག་གི་འབྲས་བུ་དང་རྒྱུ་དག་མེད་པའི་ཕྱིར་རོ།",
    "འདས་པ་དང་མ་འོངས་པ་དག་གི་རྒྱུ་དག་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་རེ་ཞིག་གལ་ཏེ་འབྲས་བུའི་བདག་ཉིད་ཀྱིས་སྟོང་པའི་རྒྱུས་འབྲས་བུ་སྐྱེད་པར་བྱེད་པར་རྟོག་ན་དེ་ནི་དེ་ཇི་ལྟར་ཡང་མི་འཐད་དོ།",
    "གང་གི་ཚེ་འབྲས་བུ་ཡོད་པ་ཉིད་ཡིན་ན་དེ་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པ་མ་ཡིན་པ།",
    "འབྲས་བུ་ངོ་བོ་ཉིད་ཀྱིས་མི་སྟོང་པ་རང་གི་བདག་ཉིད་ཀྱིས་ངེས་པར་གནས་པ་གང་ཡིན་པ་དེ་ནི་སྐྱེ་བར་མི་འགྱུར་འགག་པར་ཡང་མི་འགྱུར་ཏེ།",
    "རང་གི་བདག་ཉིད་ཀྱིས་ངེས་པར་གནས་པའི་ཕྱིར་རོ།",
    "རྟག་པའི་ཕྱིར་ཁྱོད་ཀྱི་དེ་ནི་མ་འགགས་པ་དང་མ་སྐྱེས་པར་ཡང་འགྱུར་རོ།",
    "མ་སྐྱེས་པ་ཡང་ཐལ་བར་འགྱུར།",
    "དེ་ལྟ་བས་ན་འབྲས་བུ་དེ་སྟོང་པར་ཡོངས་སུ་རྟོགས་ན་ཡང་མེད་པའི་ཕྱིར་མ་འགགས་པ་དང་མ་སྐྱེས་པར་ཡང་ཐལ་བར་འགྱུར་བས།",
    "རྒྱུ་གང་གིས་ཀྱང་འབྲས་བུ་སྐྱེད་པར་མི་བྱེད་ན།",
    "འབྲས་བུ་གང་གི་ཡིན་པར་འགྱུར།",
    "རྒྱུ་རྣམས་དང་ནི་རྐྱེན་དག་གི།",
    "བདག་གིས་བདག་ཉིད་མི་སྐྱེད་ན།",
    "རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱི་ཚོགས་པ་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་ཞེས་བྱ་བར་བརྟག་པ་གང་ཡིན་པ་དེས་རེ་ཞིག་བདག་གིས་བདག་ཉིད་སྐྱེད་པར་མི་བྱེད་དེ།",
    "དེ་ལྟར་གང་གི་ཕྱིར་ཚོགས་པ་དེ་བདག་ཉིད་མ་སྐྱེས་ཤིང་རབ་ཏུ་མ་གྲུབ་པ་དེའི་ཕྱིར་ཚོགས་པས་བྱས་པའི་འབྲས་བུ་མེད་དོ།",
    "ཡོད་ན་རེ་ཞིག་རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱི་ཚོགས་པ་ཡོད་དེ་དེ་ཡོད་པས་འབྲས་བུ་ཡང་ཡོད་པར་འགྱུར་རོ།",
    "ཅི་ཁྱོད་གྲོང་སྟོད་དུ་མཁར་ལྡན་འབེབས་སམ།",
    "ཁྱོད་འབྲས་བུ་ཡོད་པ་མ་ཡིན་ན་ཚོགས་པ་ཡོད་པར་འདོད་ཀོ།",
    "འབྲས་བུ་སྐྱེད་པ་ཉིད་ཚོགས་པ་ཞེས་བྱ་ན་འབྲས་བུ་དེ་ཉིད་ཀྱང་གང་གི་ཚེ་ཇི་ལྟར་ཡང་མི་འཐད་པ་དེའི་ཚེ་འབྲས་བུ་ཡོད་པ་མ་ཡིན་ན་རྐྱེན་གྱི་ཚོགས་པ་ཡོད་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་དུས་དང་ཚོགས་པ་ཉིད་ཀྱི་འབྲས་བུ་འགྲུབ་པའི་ཕྱིར་དུས་ནི་ཡོད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་གང་སྨྲས་པ།",
    "གལ་ཏེ་དུས་ཀྱང་མེད་རྒྱུ་དང་འབྲས་བུ་དང་ཚོགས་པ་ཡང་མེད་ན་གཞན་ཅི་ཞིག་ཡོད་དེ།",
    "མ་ཡིན་ཏེ་ཇི་ལྟར་ཁྱོད་དུས་ལ་སོགས་པ་དག་ངོ་བོ་ཉིད་ལས་ཡོད་པར་ཡོངས་སུ་རྟོག་པར་བྱེད་པ་དེ་ལྟར་མི་འཐད་པར་ཟད་ཀྱི།",
    "གང་གི་ཚེ།",
    "གང་གི་ཚེ་གཉི་ག་ལྟར་ཡང་མི་འཐད་པ་དེའི་ཚེ་དེ་དག་གི་རྒྱུ་ཅན་གྱི་དུས་ལ་སོགས་པ་དག་ཇི་ལྟར་ཡོད་པར་གྱུར།",
    "གང་གི་ཚེ་འགའ་ཞིག་བྱུང་ན་འཇིག་པར་འགྱུར་གྱི་གཞི་མེད་པར་འཇིག་པར་མི་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་ན་དོན་དེ་གཉིས་ཕན་ཚུན་མི་མཐུན་པ་དག་ཡིན་པ་དེའི་ཚེ་དེ་གཉིས་གཅིག་ལ་ལྷན་ཅིག་ཡོད་པར་མི་འཐད་དེ།",
    "གང་གི་ཚེ་དངོས་པོ་ཐམས་ཅད་མི་རྟག་པ་ཉིད་ཀྱིས་མི་རྟག་པ་དང་རྗེས་སུ་འབྲེལ་པ་དེའི་ཚེ་དངོས་པོ་རྣམས་ལ་མི་རྟག་པ་ཉིད་ནམ་ཡང་མེད་པ་མ་ཡིན་པ་ཉིད་དོ།",
    "དེ་ལྟར་ན་ཡང་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བས་དེ་ཡང་མི་འདོད་དོ།",
    "གང་གི་ཚེ་དོན་དེ་གཉིས་ཕན་ཚུན་མི་མཐུན་པ་དག་ཡིན་པ་དེའི་ཚེ་དེ་གཉིས་གཅིག་ལ་ལྷན་ཅིག་ཡོད་པ་མི་འཐད་དེ།",
    "ཕན་ཚུན་ལྷན་ཅིག་མ་ཡིན་པར་གྲུབ་པ་ཡོད་པ་མ་ཡིན་པ་དེ་དག་དང་རྣམ་པ་གཞན་གང་གིས་འགྲུབ་པ་ཡོད་པར་སེམས།",
    "རྗེས་སུ་འབྲེལ་པ་ཡིན་པས་དངོས་པོ་འགའ་ཡང་རང་གི་གནས་ན་སྐད་ཅིག་ཙམ་ཡང་མི་སྡོད་པའི་ཕྱིར་རོ།",
    "ཅི་ཁྱོད་ཤིང་བི་དུ་ལའི་ཤིང་ཏོག་དག་འདོད་དམ།",
    "གང་གི་ཕྱིར།",
    "འདི་ལྟར་ངོ་བོ་ཉིད་ཡོད་པ་མ་ཡིན་པ་ལ་དེ་དག་གང་གིས་ཡོད་པར་འགྱུར།",
    "ངོ་བོ་ཉིད་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་གང་གི་འདིའོ་ཞེས་ཐ་སྙད་གདགས་པ་ཉིད་ཀྱང་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་ཅི་ཞིག་འབྱུང་ངོ་ཞེའམ།",
    "མཐོང་ངོ་སྙམ་དུ་ཁྱོད་སེམས་ན།",
    "དེ་ལ་རེ་ཞིག་དངོས་པོ་དངོས་པོ་ལས་སྐྱེ་བ་མེད་དེ།",
    "དེ་ལ་འདི་སྙམ་དུ་ཤིང་ཏོག་གི་དངོས་པོ་ཤིང་ལྗོན་པའི་དངོས་པོ་ལས་སྐྱེ་བར་སེམས་ན།",
    "དེ་ལྟར་རེ་ཞིག་དངོས་པོ་དངོས་པོ་ལས་སྐྱེ་བ་མེད་དོ།",
    "ཅི་སྟེ་ཅི་ཡང་མེད་པ་ཅི་ཡང་མེད་པ་ལས་སྐྱེ་བར་འགྱུར་ན་ནི་དེ་ལྟ་ན་རི་བོང་གི་རྭ་ཡང་རྟའི་རྭ་ལས་སྐྱེ་བར་འགྱུར་རོ།",
    "རེ་ཞིག་དངོས་པོ་ནི་བདག་ལས་སྐྱེ་བ་མེད་དེ།",
    "རང་གི་བདག་ཉིད་ཀྱིས་ཡོད་པ་ལ་ནི་ཡང་སྐྱེ་བར་བརྟག་པ་དོན་མེད་པ་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་དང་།",
    "ཐུག་པ་མེད་པར་ཐལ་བའི་སྐྱོན་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "རང་གི་བདག་ཉིད་ཀྱིས་མེད་པ་ལ་ནི་བདག་ལས་ཞེས་བྱ་བའི་ཚིག་ཀྱང་མི་འཐད་པའི་ཕྱིར་ཏེ།",
    "ཇི་སྐད་བསྟན་པའི་སྐྱོན་གཉི་གར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཡོད་པ་མ་ཡིན་ན་གང་གི་དངོས་པོ་མེད་པར་འགྱུར།",
    "ཐལ་བར་འགྱུར་ཏེ་དངོས་དེ་ནི།",
    "གང་གི་ཕྱིར་དངོས་པོ་དེ་ཡོད་པར་ཁས་བླངས་ན་རྟག་པ་དང་ཆད་པར་ལྟ་བར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་གལ་ཏེ་དངོས་པོ་དེ་རྟག་ན་ནི་རྟག་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་ལ།",
    "འོན་ཏེ་མི་རྟག་ན་ནི་ཆད་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བས་དེ་ཡང་མི་འདོད་དེ་སྐྱོན་ཆེ་བའི་ཕྱིར་རོ།",
    "རྟག་པར་ལྟ་བར་ཐལ་བར་ཡང་མི་འགྱུར་ལ།",
    "ཆད་པར་ལྟ་བར་ཐལ་བར་ཡང་མི་འགྱུར་ཏེ།",
    "ཁྱོད་གཞུང་ལུགས་གསལ་བར་མི་ཤེས་པས་དེ་ལྟར་སེམས་པར་ཟད་དོ།",
    "རྟག་པ་དང་ཆད་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་ན།",
    "དངོས་པོར་ལྟ་བ་ཡོད་ན་ཡང་སྲིད་པ་འཐད་པས་དེའི་ཕྱིར་རྟག་པ་དང་ཆད་པར་ལྟ་བའི་སྐྱོན་དུ་ཐལ་བར་མི་འགྱུར་རོ།",
    "འབྲས་བུ་རྒྱུ་ཡི་འབྱུང་འཇིག་གི།",
    "དེ་ལ་གང་གི་ཕྱིར་རྒྱུ་འཇིག་པར་འགྱུར་བ་དེའི་ཕྱིར་རྟག་པའི་སྐྱོན་དུ་ཐལ་བར་མི་འགྱུར་ལ།",
    "དེའི་ཕྱིར་དེ་ལྟར་དངོས་པོ་ཡོད་པར་ཁས་བླངས་ཀྱང་སྲིད་པ་ཡོད་པའི་ཕྱིར་རྟག་པ་དང་ཆད་པའི་སྐྱོན་དུ་ཐལ་བར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་འབྲས་བུའི་འབྱུང་འཇིག་གི།",
    "རྒྱུ་ནི་ཆད་པར་ཐལ་བར་འགྱུར།",
    "དེ་ལྟ་ན་ཡང་ཁྱོད་ལ་ཆད་པ་ཁོ་ནར་ཐལ་བར་འགྱུར་ཏེ།",
    "རྒྱུ་ཆད་པ་ཁོ་ནར་ཐལ་བར་འགྱུར་རོ།",
    "ཁྱོད་ཀྱིས་ཀྱང་།",
    "དེ་ནི་རེ་ཞིག་དེ་ཉིད་མིན།",
    "ཁོ་བོས་དེ་སྐད་སྨྲ་མོད་ཀྱི་ཁྱོད་ཀྱིས་དེའི་རྟེན་གྱི་དེ་ཁོ་ན་ཁོང་དུ་མ་ཆུད་དེ།",
    "དེ་ལྟ་ན་ཡང་གང་གི་ཚེ་གཞན་འགགས་པ་ལ་གཞན་སྐྱེས་པ་དེའི་ཚེ་ཇི་ལྟར་གཞན་ཉིད་དུ་མི་འགྱུར།",
    "ཁོ་བོ་ཅག་ལ་ནི་དངོས་པོ་ལ་བརྟེན་ནས་གདགས་པ་ངོ་བོ་ཉིད་སྟོང་པ་སྒྱུ་མ་དང་སྨིག་རྒྱུ་དང་གཟུགས་བརྙན་ལྟ་བུ་རྣམས་ལ་དངོས་པོ་དེ་གང་གིར་འགྱུར་ཏེ་དངོས་པོ་དེ་གང་ལས་གཞན་དུ་འགྱུར་ཏེ་དེ་ཉིད་དང་གཞན་ཉིད་དུ་འགྱུར་བ་མེད་དོ།",
    "དེ་ལྟ་བས་ན་དངོས་པོར་ལྟ་བ་ཡོད་ན་རྒྱུ་འགགས་པ་ཡང་སྐྱེ་བ་མེད་པའི་ཕྱིར་རྒྱུན་ཆད་པ་ཁོ་ནར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལ་རྟག་པ་ཁོ་ནའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་རོ།",
    "མྱ་ངན་ལས་འདས་པའི་དུས་ན་དགྲ་བཅོམ་པའི་སྲིད་པའི་རྒྱུན་རབ་ཏུ་ཞི་བའི་ཕྱིར་ཆད་པ་ཁོ་ནའི་སྐྱོན་དུ་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་སྲིད་པའི་རྒྱུན་དེ་ཡོད་པར་རྟོག་ན་ཡང་རྟག་པ་དང་ཆད་པ་ཁོ་ནའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་རོ།",
    "རེ་ཞིག་སྲིད་པའི་རྒྱུན་ནི་རབ་ཏུ་གྲུབ་བོ།",
    "ཁྱོད་ཀྱི་སྲིད་པའི་རྒྱུན་ཡོད་ན་རྟག་པ་དང་ཆད་པའི་སྐྱོན་དུ་ཐལ་བར་མི་འགྱུར་རོ་ཞེས་གང་སྨྲས་པ་དེ་ཉིད་ཀྱང་ཁོ་བོས་སྲིད་པའི་རྒྱུན་ཡོད་ཀྱང་རྟག་པ་དང་ཆད་པ་ཁོ་ནའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་རོ་ཞེས་རབ་ཏུ་བསྟན་ཟིན་ཏོ།",
    "རེ་ཞིག་སྲིད་པའི་རྒྱུན་ནི་རབ་ཏུ་གྲུབ་པོ་ཞེས་གང་སྨྲས་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "ད་ལྟར་གྱི་སྲིད་པའི་མཇུག་གི་སེམས་ནི་སྲིད་པ་ཐ་མའོ།",
    "དེ་ལ་རེ་ཞིག་སྲིད་པ་ཐ་མ་འགགས་པ་ནི་སྲིད་པ་དང་པོ་དང་ཉིང་མཚམས་སྦྱོར་བ་མེད་དེ།",
    "དེ་ནི་མི་འདོད་དེ་སྐྱོན་དུ་མར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྲིད་པ་གཉིས་སུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "སྲིད་པ་ཐ་མ་འགགས་པ་དང་མ་འགགས་པ་སྲིད་པ་དང་པོ་དང་ཉིང་མཚམས་སྦྱོར་བ་མེད་མོད་ཀྱི་འོན་ཀྱང་འགག་བཞིན་པ་ཉིང་མཚམས་སྦྱོར་རོ།",
    "སྐྱེ་བཞིན་པ་ཡང་ཕྱེད་སྐྱེས་པའི་ཕྱིར་དེ་གཉིས་སྲིད་པ་གཉིས་སུ་ཐལ་བའི་སྐྱོན་དུ་འགྱུར་ཏེ།",
    "ཡོད་ན་རེ་ཞིག་སྲིད་པ་དང་པོའི་སྐྱེ་བ་ནི་ཡོད་དེ།",
    "ལྷན་ཅིག་སྦྱོར་བའང་ཞེས་བྱ་བའི་འང་གི་སྒྲ་ནི་སྲིད་པ་ཐ་མ་འགགས་པ་དང་མ་འགགས་པ་ཡང་བསྡུ་བའི་དོན་ཏོ།",
    "རེ་ཞིག་ཕུང་པོ་རྣམས་ཉིད་དེ་བཞིན་གཤེགས་པ་མ་ཡིན་ཏེ།",
    "གཞན་ཉིད་ཡིན་ན་གཟུང་དུ་ཡོད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "རྟེན་དང་བརྟེན་པ་གཞན་མ་ཡིན་པའི་ཕྱིར་མི་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁྱོད་ཀྱིས་གང་གིས་སྲིད་པའི་རྒྱུན་ཡོད་པར་ཡོངས་སུ་བརྟགས་པའི་དེ་བཞིན་གཤེགས་པ་དེ་གང་ཞིག་ཡིན་པ་སྨྲོས་ཤིག།",
    "ཅིའི་ཕྱིར་ཁྱོད་ཁོ་བོ་ལ་རྟག་པའམ་མི་རྟག་པར་ཐལ་བར་འགྱུར་བའི་སྐྱོན་འདོགས་པར་བྱེད།",
    "ཅི་ཁྱོད་ལེགས་པར་སྦྱར་བའི་ཕྱེད་ཀྱིས་གར་བྱེད་དམ།",
    "ཁྱོད་བརྟེན་ནས་དེ་བཞིན་གཤེགས་པ་གདགས་པར་ཡང་སྨྲ་ལ།",
    "གང་གི་ཕྱིར་དེ་ངོ་བོ་ཉིད་མེད་པ་དེའི་ཕྱིར་ཉེ་བར་ལེན་པས་གང་གདགས་པར་བྱ་བ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་གང་ཞིག་རང་གི་བདག་ཉིད་མེད་པ་དེ་ཉིད་ཉེ་བར་ལེན་པ་གཞན་དུ་གྱུར་པས་གདགས་པར་བྱ་ན་ཇི་ལྟར་དེ་བཞིན་གཤེགས་པར་འགྱུར།",
    "གལ་ཏེ་དེ་རང་གི་བདག་ཉིད་མེད་པར་ཉེ་བར་ལེན་པ་ལ་བརྟེན་ནས་བདག་ཉིད་ཡོད་པར་འགྱུར་ན་ནི།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འོ་ན་ངོ་བོ་ཉིད་དང་གཞན་གྱི་དངོས་པོ་དག་མ་གཏོགས་པར་དེ་བཞིན་གཤེགས་པ་དེ་གང་ཡིན་པ་དང་གང་གིས་གདགས་པར་བྱ་བ་དེ་སྨྲོས་ཤིག།",
    "ཁྱོད་བརྟེན་ནས་གདགས་པར་བྱ་བའི་དོན་རྣམ་པར་མི་ཤེས་པར་མི་རིགས་པ་མང་པོ་དེ་སྙེད་ཅིག་སྨྲ་སྟེ།",
    "ཁྱོད་ནི་མ་ཡིན་པ་ལྟ་ཞིག།",
    "ཁྱོད་ཀྱིས་གང་དག་ལ་དེ་བཞིན་གཤེགས་པ་ཡོད་པ་ཉིད་དུ་ཡོངས་སུ་བརྟགས་པའི་ཕུང་པོ་རྣམས་ནི་ཉེ་བར་ལེན་པ་ཉིད་དུ་མི་འཐད་དོ།",
    "དེ་ལྟར་སྔ་ཕྱི་མེད་ན་ཁྱོད་ཀྱི་ཕུང་པོ་རྣམས་ཇི་ལྟར་ཉེ་བར་བླང་བ་ཡིན་པ་དང་།",
    "ཁྱོད་ཀྱིས་ཡོངས་སུ་བརྟགས་པའི་དེ་བཞིན་གཤེགས་པ་དེ་ཇི་ལྟར་ཉེ་བར་ལེན་པ་པོ་ཡིན་པ་དེ་སྨྲོས་ཤིག།",
    "རེ་ཞིག་དེ་ཉིད་དུ་མི་བརྗོད་དེ་བྱེད་པ་པོའི་ཚིག་ཐ་དད་པའི་ཕྱིར་རོ།",
    "ཅི་ཁྱོད་མཛའ་བཤེས་ཀྱི་བློས་དགྲ་བོ་དཔང་དུ་ལེན་ཏམ།",
    "ཁྱོད་གང་ཁོ་ནས་ཉེ་བར་ལེན་པ་པོ་དང་ཉེ་བར་བླངས་པ་དག་རབ་ཏུ་འགྲུབ་པར་མི་འཐད་པ་དེ་ཁོ་ནས་དེ་དག་རབ་ཏུ་བསྒྲུབ་པའི་ཕྱིར་རྩོམ་པར་བྱེད་ཀོ།",
    "དེ་བཞིན་གཤེགས་པ་གང་ཉེ་བར་ལེན་པ་གང་གིས་གདགས་པར་བྱ་བ་དེ་ཉིད་ལ་རྣམ་པ་ལྔས་བཙལ་ན་དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉེ་བར་ལེན་པ་ལ་མེད་ན་ཇི་ལྟར་དེ་བཞིན་གཤེགས་པ་ཡོད་དོ་ཞེས་བརྗོད་པར་བྱ།",
    "དེའི་ཕྱིར་རེ་ཞིག་ཉེ་བར་ལེན་པ་ནི་ཡོད་དོ།",
    "ཅི་ཁྱོད་ཆུ་བོ་ཤུགས་དྲག་པོས་ཁྱེར་བ་ན་རྩ་དྲུངས་ཕྱུང་ལ་འཇུའམ།",
    "ཁྱོད་ཉེ་བར་བླངས་པས་ཉེ་བར་ལེན་པ་པོ་རབ་ཏུ་བསྒྲུབ་པར་འདོད་ཀོ།",
    "གང་གི་ཚེ།",
    "དེ་ནི་རེ་ཞིག་ཡོད་དེ་གལ་ཏེ་བདག་གི་དངོས་པོ་ལས་ཡོད་པ་མ་ཡིན་ཡང་གཞན་གྱི་དངོས་པོ་ལས་ཡོད་དོ།",
    "བདག་གི་དངོས་ལས་གང་མེད་པ།",
    "དེ་བཞིན་དངོས་ལས་ཡོད་རེ་སྐན།",
    "ཉེ་བར་ལེན་པ་གང་བདག་གི་དངོས་པོ་ལས་མེད་པ་དེ་གཞན་གྱི་དངོས་པོ་ལས་ཡོད་པར་འགྱུར་རེ་སྐན།",
    "གང་གི་ཚེ་བདག་གི་དངོས་པོ་འགའ་ཞིག་ཡོད་ན་ཉེ་བར་ལེན་པ་ནི་བདག་གི་དངོས་པོ་ལས་ཡོད་པ་མ་ཡིན་པས།",
    "མངོན་སུམ་དུ་དམིགས་པ་ཞེས་གང་སྨྲས་པ་དེ་ཡང་རང་གི་སེམས་ཀུན་ཏུ་རྨོངས་པའི་སྐྱོན་གྱིས་སྒྱུ་མ་དང་རྨི་ལམ་མཐོང་བ་བཞིན་དུ་མཐོང་བ་ཡིན་གྱི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དབུ་བ་རྡོས་པ་དང་ཆུའི་ཆུ་བུར་དང་སྨིག་རྒྱུ་དང་ཆུ་ཤིང་གི་ཕུང་པོ་དང་སྒྱུ་མའི་དཔེ་དག་བཀའ་སྩལ་ཅིང་།",
    "གང་གི་ཕྱིར་དེ་དག་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར།",
    "དེ་ལྟར་གང་གི་ཕྱིར་ཉེ་བར་ལེན་པ་ངོ་བོ་ཉིད་ལས་ཀྱང་ཡོད་པ་མ་ཡིན་ལ་གཞན་གྱི་དངོས་པོ་ལས་ཀྱང་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་ཉེ་བར་ལེན་པ་སྟོང་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཉེ་བར་ལེན་པ་པོ་ཡང་རྣམ་པ་ཀུན་གྱིས་ཡོངས་སུ་བརྟགས་ན་ངོ་བོ་ཉིད་ལས་ཀྱང་ཡོད་པ་མ་ཡིན་ལ་གཞན་གྱི་དངོས་པོ་ལས་ཀྱང་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་ཉེ་བར་ལེན་པ་པོ་ཡང་སྟོང་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཁྱོད་དབུ་བརྡོས་པ་དང་།",
    "དེ་ལྟ་བས་ན་རེ་ཞིག་རང་གི་ཕྱོགས་ལ་ཆགས་པ་ཐོང་ལ་ཅི་གང་བརྟེན་ནས་ཡོད་པར་འདོགས་པ་དང་།",
    "གལ་ཏེ་དེ་ལྟར་དེ་དག་ཐམས་ཅད་སྟོང་ངོ་ཞེས་ཀྱང་བརྗོད་པར་མི་བྱ་བ་ཡིན་ན་འོ་ན་ཁྱོད་བག་ཚ་བ་མེད་པར་གསང་བསྟོད་དེ།",
    "གང་གི་ཕྱིར་ཕུང་པོ་རྣམས་ལ་བརྟེན་ནས་གདགས་པར་བྱ་བ་ཡིན་པ་དེའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་མེད་དོ་ཞེས་ཀྱང་བརྗོད་པར་མི་བྱ་སྟེ།",
    "དེའི་ཕྱིར་དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་ཡོད་པ་ཉིད་དང་མེད་པ་ཉིད་ཀྱི་ཕྱོགས་དང་བྲལ་བ་ཚེ་འདི་ཉིད་ལ་བརྟེན་པ་ལས་དེ་བཞིན་གཤེགས་པ་དམིགས་སུ་མེད་པ་ལ་གཏི་མུག་གིས་ཀུན་ནས་དཀྲིས་པའི་སེམས་དང་ལྡན་པ་དེ་ཁོ་ན་མཐོང་བ་ལྐོག་ཏུ་གྱུར་པ།",
