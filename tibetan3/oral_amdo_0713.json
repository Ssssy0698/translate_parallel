    "བུད་མེད་ཀྱིས་གཉིས་པོ་དེ་བྱས་པ་དང་།",
    "སྙི་བའི་བསམ་པས་བུད་མེད་ཀྱི་ལུས་ལ་རེག་པ་ནི་རེག་པའི་བྱེ་བྲག་ཉམས་སུ་མྱོང་འདོད་པ་ཞེས་བྱའོ།",
    "དུད་འགྲོ་མོ་ལ་ཆགས་སེམས་ཀྱིས་རེག་པ་ནི་ཉེས་བྱས་སོ།",
    "འཁྲིག་དོན་བུད་མེད་མདུན་དུ་འཁྲིག་ཚིག་སྨྲས།",
    "འཆར་ཀ་ནག་པོས་བུད་མེད་ཀྱི་ཚོགས་པར་མི་རུང་བའི་འཁྲིག་ཚིག་སྨྲས་པ་དང་།",
    "སྔར་ཁྱིམ་བདག་གི་གནས་སུ་དྭ་དང་རྒྱན་པོ་དང་ནལ་གྱི་བུས་ཀྱང་མ་སྨྲས་པ་སྨྲས་སོ།",
    "འདི་ལ་གཞིའི་ཡན་ལག་བུད་མེད་ལེགས་པ་དང་ཉེས་པར་སྨྲས་པ་ཤེས་པ་ལ།",
    "གལ་ཏེ་དབུས་འགྱུར་འཆང་དུ་སྐྱེས་པའི་དགེ་སློང་ཞིག་གིས་ཀོ་ས་ལར་ཆུ་སྣོད་ཀྱི་བསམ་པས་ཀུན་དི་ཀ་བརྙའོ་ཞེས་བརྗོད་པ།",
    "བུད་མེད་མདུན་དུ།",
    "འཁྲིག་པའི་ཚིག་གི་དོན་གོ་བར་བྱེད་པའི་སྒྲ་ནི་གཉིས་ཏེ།",
    "སྲུ་ཁྱོད་ཀྱི་རྨའི་སྒོ་གསུམ་པོ་དག་དོད་པ།",
    "ལེགས་པར་གྱུར་བ་ཡིན་མོད་ཅེས་བསྔགས་པ་བརྗོད་པ་དང་།",
    "བུད་མེད་དང་སྐྱེས་པ་དེ་དང་དེ་བྱེད་པ་དག་དགའ་བ་ཡིན་ནོ།",
    "བུད་མེད་གང་སྐྱེས་པ་དེ་དང་དེ་བྱེད་པ་ལ་དགའ་བར་འགྱུར་བ་ཡིན་ལ།",
    "སྲུ་བདག་གིས་ཀྱང་ཁྱོད་ལ་དེ་དང་དེ་བྱས་ན་ཁོ་བོ་ལ་དགའ་བར་འགྱུར་རམ་ཞེས་དྲི་བ་དང་།",
    "ཁོ་བོ་ནི་ཁྱོད་ལ་དགའ་བ་དང་།",
    "ཡིད་དུ་འོང་བ་བདེན་ན་ཁྱོད་ཇི་ལྟ་ཞེས་བརྗོད་པ་དང་།",
    "ཁོ་བོ་དང་ཁྱོད་ལྷན་ཅིག་དེ་དང་དེ་བྱེད་པ་ཞིག་ཡིན་ན་ཞེས་བརྗོད་པ་སྨོན་པ་དང་།",
    "ཁྱོད་ལ་བོང་བུ་དག་དེ་ལྟར་བྱེད་པར་གྱུར་ཅིག་ཅེས་སམ།",
    "བུད་མེད་ཀྱིས་བསྔགས་པ་ལ་སོགས་པ་དེ་དག་བྱེད་པ་ན་རྣམ་པ་དེ་དག་ཉིད་ཀྱིས་ལན་འདེབས་པ་ཕྱིར་སྨྲ་བ་བསྒྲུབ་པ་སྟེ།",
    "སྲུ་ཁོ་བོ་ལ་ནས་བྱིན་ཅིག་སྲུ་ཁྱོད་ལ་ཅི་མཐོང་བ་དེ་བྱིན་ཅིག་སྲུ་ཁྱོད་ཀྱི་མདུན་ན་མོ་གང་ཡིན་པ་དེ་བྱིན་ཅིགསྲུ་ཁྱོད་ཀྱི་ཡིད་དུ་གང་འོང་བ་གང་ཡིན་པ་བྱིན་ཅིག་ཅི་ལ་དགའ་བ་བྱིན་ཅིག་དེས་ཚུར་ལ་སྨྲས་པ།",
    "ཁྱོད་ཅི་ལ་དགའ་ཞེས་ཟེར་བ་ལ།",
    "སྲུ་ཁྱོད་ལ་ཁོ་བོ་དགའ་འོ་ཞེས་བྱ་བ་དང་།",
    "བཟའ་བ་བྱིན་ཅིག་ཁྱོད་ཉིད་དེ་དག་ཡིན་ནོ་ཞེས་སྨྲས་པ་དག་གོ།",
    "རྟེན་རུང་བུད་མེད་འདུན་པ་བདག་ཉིད་དང་།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་ནག་པོས་བུད་མེད་ཀྱི་ཚོགས་སར།",
    "འདི་ལ་གཞིའི་ཡན་ལག་བརྟེན་དུ་རུང་བའི་བུད་མེད་དང་མ་ནིང་མོ།",
    "རང་ཉིད་ཀྱིས་བདག་གིར་བྱས་པ་གང་རུང་ངོ།",
    "བརྟེན་རུང་བུད་མེད་འདུན་པ།",
    "དགེ་སློང་གིས་སྲུ་དེ་དེ་བཞིན་ནོ།",
    "འཕྲིན་གྱིས་བུད་མེད་སྐྱེས་སྤྲད་ཕྲད་ནའོ།",
    "མཉན་ཡོད་ན་རི་དྭགས་འཛིན་གྱི་བུ་ནག་པོ་ཞེས་བྱ་བ་ཞིག་ལ་བུ་མོ་སྦྱིན་བྱ་ཡོད་པ་རྣམས་ཁྱེད་ཀྱིས་ཁྱིམ་ཆེ་གེ་མོ་ཞིག་ཤེས་སམ།",
    "བསྒྲུབ་ཕོད་པ་བུ་མོ་ལ་ཟས་གོས་སྦྱིན་ནུས་པ་དང་།",
    "ཡིན་ཟེར་ན་བུ་མོ་སྟེར།",
    "དེ་ནས་བུ་མོ་སློང་བ་རྣམས་ཀྱང་།",
    "དེ་ལ་ཁྱིམ་ཆེ་གེ་མོ་ཤེས་སམ།",
    "དེའི་བུ་མོ་དེ་མཁས་པ་ཡིན་ནམ་ཞེས་པ་ལ་སོགས་དྲི།",
    "འདི་ལ་གཞིའི་ཡན་ལག་སྤྲད་བྱ་བརྟེན་པར་བཟོད་པའི་བུད་མེད་དང་སྐྱེས་པ་སྨྲ་བའི་ཡུལ་མ་འཁྲུལ་བ།",
    "འཕྲིན་སྐྱེལ་བ་ལ་ཞུགས་པ་གང་རུང་མཐར་ཐུག་གི་ཡན་ལག་དེ་གཉིས་ཕྲད་པ་སྟེ།",
    "སྔར་མི་མཐུན་པའི་སྐྱེས་པ་དང་བུད་མེད་སྤྱད་དུ་བཟོད་པ་དགོས་ཏེ།",
    "གལ་ཏེ་བུ་བུ་མོ་བྱུང་ན་ཞེས་བྱས་ཟིན་པས་དང་།",
    "གལ་ཏེ་ཁྱིམ་པ་ཞིག་བཙུན་པ་ཁྱོད་ཀྱི་ཁྱིམ་པ་ཆེ་གེ་མོ་ལ་འདི་སྐད་ཅེས།",
    "མཛའ་ན་མོའམ།",
    "འཕྲིན་སྔ་མ་སྤྲད་པའི་དུས་སུ་སྔ་མ་ཤོས་ཀྱིས་ཐོས་པ་ན་འཕྲིན་ཚུར་མ་བསྐྱལ་ཡང་སྔ་མ་ལ་བརྗོད་པར་སོང་བས་སྔ་མ་དང་འདྲའོ།"
  ]
}