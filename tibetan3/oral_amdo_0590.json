    "དེར་མ་ཟད་ཨས་ནི་ཨེ་ཡིག་གིས་མཚོན་པའི་དོན་ཤེས་རབ་སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོ་དང་།",
    "ཐས་ནི་ཝ་ཡིག་གིས་མཚོན་པའི་ཐབས་རྣམ་པ་ཐམས་ཅད་པའི་འཇམ་དཔལ་ཡེ་ཤེས་སེམས་དཔའ་དང་།",
    "དེ་དག་གཉིས་སུ་མེད་པའི་ཕྱིར་ནོར་བུའི་རྩེ་མོའི་མཐར་གནས་པའི་ཁུ་བ་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་ཨེཝཾ་གྱི་སྒྲའི་བརྗོད་བྱ་ལ་ཨཐ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ཉིད་རྡོ་རྗེ་བཙུན་མོ་ཡི།",
    "རྒྱུད་གཞན་དུ་ནི་བདག་གིས་བཤད།",
    "དེ་གཉིས་ཕ་མའི་ཁུ་ཁྲག་གི་དབུས་སུ་ཞུགས་པ་ལས་མིའི་ལུས་སུ་གྲུབ་པ་ཡིན་ཞིང་།",
    "ཨས་ནི་སྲོག་རྩོལ་ཡན་ཆད་ཀྱི་སྐབས་ནས་རོ་རྐྱང་གི་རྒྱུ་བ་དྷཱཏཱིར་བཀག་པའི་སྟོབས་ཀྱིས་ལྟེ་བའི་དྷཱཏཱིའི་ནང་གི་གཏུམ་མོ་ཁྱད་པར་ཅན་འབར་བ་མཚོན་ཞིང་།",
    "འདྲེན་བྱེད་རྟགས་ཀྱི་ཨེཝཾ་ནང་གི་རྩ་འཁོར་ཁ་སྦྱོར་གྱི་ཚུལ་དུ་ཡོད་པ་རྣམས་དང་ལྟེ་བའི་གཏུམ་མོ་དང་།",
    "དེ་ལ་བརྟེན་ནས་དྲངས་པའི་བདེ་སྟོང་གི་ཡེ་ཤེས་དང་།",
    "གཉིས་པ་ཡན་ལག་གི་དོན་ཡང་དབྱེ་བར་བྱ་སྟེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སྔགས་དོན་རྣམ་གཟིགས་ལས།",
    "ཡང་དག་པ་མ་ཡིན་པའི་གཉིས་སྣང་གི་ཀུན་རྟོག་དང་།",
    "དེ་རང་གི་ངོ་བོར་འཆང་ཞིང་ཕྱི་རོལ་ཏུ་དེ་མཚོན་པར་བྱེད་པའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཕྱག་མཚན་དུ་འཆང་བའི་གསང་བའི་བདག་པོ་ནི་རྒྱུད་འདིའི་སྡུད་པ་པོའོ།",
    "རྡོ་རྗེ་འཆང་བདག་གིས་ཞེས་པའི་དོན་དང་།",
    "རང་གི་ཚོགས་ལྡན་ཉན་པོའང་ང་།",
    "སྔགས་དོན་རྣམ་གཟིགས།",
    "བཅོམ་ལྡན་འདས་འཇམ་དཔལ་ཡེ་ཤེས་སེམས་དཔའི་དོན་དམ་པའི་མཚན་ཡང་དག་པར་བརྗོད་པ་གང་ཡིན་པ་དེ་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཆང་གིས་གསོལ་བ་འདེབས་པ་ཡིན་ནོ།",
    "རང་གི་ཚོགས་ལྡན་ཉན་པ་ང་།",
    "རྣལ་འབྱོར་བླ་ན་མེད་པའི་ཡང་དངོས་གནས་པའི་ཕྱག་རྒྱ་ཆེན་མོ་ལ་བརྟེན་ནས་བདེ་ཆེན་འདྲེན་མི་ནུས་པ་རྣམས་ཀྱིས་ཉམས་སུ་མྱོང་བའི་ཚུལ་གྱིས་རྟོགས་པར་དཀའ་བས་གསང་བ་ཡིན་ལ།",
    "པདྨ་དཀར་པོ་དང་པདྨ་ནི་ཨེ་ཡིག་གིས་མཚོན་པའི་དོན་དང་།",
    "སྤྱན་དང་ཞལ་ནི་ཝཾ་ཡིག་གིས་མཚོན་པའི་དོན་ཏེ།",
    "དེ་བཞིན་དུ་པདྨ་རབ་ཏུ་རྒྱས་པ་ཕྱག་རྒྱ་ཆེན་མོའི་ཆུ་སྐྱེས་ལ་མཆོག་ཏུ་མི་འགྱུར་བའི་ཡེ་ཤེས་ཀྱི་ཞལ་བཞུགས་པའི་དོན་ཏེ།",
    "ཐོས་པ་ནི་རྟོགས་པས་ཏེ་དེ་ཉིད་བདག་གི་སྟེ་ང་ཉིད་ཀྱིས་སོ།",
    "དེ་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་བཙུན་མོའི་བྷག་ལ་ཞེས་བྱ་བ་ལ་སྐུ་དང་གསུང་དང་ཐུགས་ནི་ལུས་ངག་སེམས་ཀྱི་བྱ་བ་རྣམས་སོ།",
    "འདུས་པ་དང་དགྱེས་རྡོར་སོགས་སུ་འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་སོགས་གསུངས་པའི་དོན་ནི།",
    "ཨེ་ཡིག་གིས་མཚོན་པའི་དོན་ནི།",
    "ཝཾ་ཡིག་གིས་མཚོན་པའི་དོན་བདེ་བ་ནི།",
    "བདག་གིས་ཞེས་པ་ནི་ཉིད་ཀྱི་དོན་དང་།",
    "བྷག་རྣམས་ནི་གཙུག་ཏོར་སོགས་འཁོར་ལོ་དྲུག་གི་རྩའི་པདྨ་རྣམས་དང་དེ་ལ་བཞུགས་པ་ནི་འགྲོ་བ་དང་འོང་བའི་དབྱེ་བས་རིམ་པ་བཞིན།",
    "ཡོན་ཏན་གཅིག་དང་གཉིས་དང་གསུམ་དང་བཞི་དང་ལྔའི་བྱེ་བྲག་གིས་སྤྱི་བོའི་གཙུག་ཏོར་དང་དཔྲལ་བ་དང་།",
    "བདག་གིས་ནི་བདག་ཉིད་ཀྱིས་སོ།",
    "ཝཾ་ཡིག་གིས་མཚོན་པའི་དོན་ལའང་མི་འགྱུར་བའི་བདེ་ཆེན་དང་སྟོང་གཟུགས་གཉིས་ཀ་ཡོད་པ་ཡིན་ནོ།",
    "རང་གི་ལག་གིས་རྡོ་རྗེ་མཆོག།",
    "རང་གི་ལག་ནི་རོ་རྐྱང་གཉིས།",
    "འོ་ན་སྡུད་པ་པོ་དེ་དག་གི་ཁྱད་པར་ཇི་ལྟ་བུ་སྙམ་ན།",
    "ཞེས་པའི་བར་དེ་དག་གི་ཁྱད་པར་དུ་སྦྱར་ཏེ་གོ་སླའོ།",
    "དེ་རྣལ་འབྱོར་ཡན་ལག་དྲུག་གི་ཐབས་ཀྱིས་མི་གཡོ་བར་བྱས་ཏེ་མི་འགྱུར་བའི་བདེ་ཆེན་དྲངས་ཏེ།",
    "དེ་ཡང་རང་ཉིད་ཀྱིས་མངོན་དུ་བྱས་པས་རང་གི་ལག་གི་རྡོ་རྗེ་ཞེས་བྱ་ཞིང་།",
    "ཉོན་མོངས་རྣམ་དག་གདུལ་དཀའ་འདུལ།",
    "དེ་རྣམས་ཀྱི་ཕྱག་མཚན་རྡོ་རྗེ་རྩེ་མོ་རབ་ཏུ་འོད་འཕྲོ་བ་རང་གི་ལག་གིས་གསོར་བར་བྱེད་པའོ་ཞེས་འཆད་དེ།",
    "ཕྱི་ནང་གི་གདུལ་བར་དཀའ་བ་འཇོམས་པས་དཔའ་བྱད་ཅན།",
    "རྡོ་རྗེ་ནི་རང་གི་ལུས་དང་།",
    "རྩེ་མོ་ནི་སྤྱི་བོའི་ཧཾ་ཡིག་ཡིན་ལ།",
    "ལུགས་འབྱུང་ལྡོག་ཏུ་དགའ་བ་བཞི་འདྲེན་ཞིང་རང་གི་ལག་པ་ནི་སོར་སྡུད་སོགས་ཡན་ལག་དྲུག་དང་།",
    "བྱང་སེམས་སྤྱི་བོ་ནས་ནོར་བུའི་ལྟེ་བར་འོངས་ཏེ་ལུགས་འབྱུང་གི་ལྷན་སྐྱེས་དྲངས་ཤིང་།",
    "སླར་སྔར་འོངས་པ་དེ་བཞིན་དུ་ནོར་བུའི་ལྟེ་བ་ནས་གཙུག་ཏོར་གྱི་འཁོར་ལོར་གཤེགས་ཏེ་ལུགས་ལྡོག་གི་ལྷན་སྐྱེས་དྲངས་པ་ནི་དེ་བཞིན་གཤེགས་པ་དང་།",
    "ཐལ་མོ་སྦྱར་བ་སྟེ་སྲོག་རྩོལ་གྱི་སྟོབས་ཀྱིས་སྲོག་ཐུང་གཉིས་བསྲེས་པའི་དོན་དང་།",
    "སྤྱན་སྔར་འདུག་པས་ཏེ་ཏིང་ངེ་འཛིན་གྱི་ཡན་ལག་གི་རྗེས་སུ་འགྲོ་བས་གསོལ་བ་སྟེ་མི་འགྱུར་བའི་བདེ་ཆེན་ཉམས་སུ་མྱོང་བའོ།",
    "ཆ་ཞེས་པ་ནི་མགྲིན་པར་གསུང་གི་ཐིག་ལེ་རྨི་ལམ་སྐྱེད་པར་བྱེད་པའོ།",
    "ཡེ་ཤེས་ཀྱི་ཁམས་ཀྱི་རང་བཞིན་པའི་རྡོ་རྗེ་བཙུན་མོའི་བྷག་ལ་བཞུགས་སོ་ཞེས་བྱའོ།",
    "ཇི་ལྟར་འོག་གི་ཆར་གཤེགས་པ་དེ་བཞིན་དུ་རྡོ་རྗེ་ནོར་བུ་ནས་གསང་བའི་པདྨ་ཡེ་ཤེས་ཀྱི་ཁམས་དང་།",
    "སྤྱི་གཙུག་ཏུ་ཚེས་བཅུ་དྲུག་གི་ཆ་དང་ལྡན་པའི་རང་བཞིན་གྱིས་གཤེགས་སོ།",
    "སྤྱི་གཙུག་ནས་ནག་པོའི་ཚེས་གཅིག་ལ་སོགས་པའི་དབྱེ་བས་གནམ་སྟོང་གི་མཐའ་བཅུ་དྲུག་ཆ་དང་ལྡན་པའི་ཟླ་བའི་ཆ་འཇོམས་པའི་དབྱེ་བས་གསང་བའི་པདྨར་གཤེགས་སོ་ཞེས།",
    "རང་གི་ལུས་ལ་གནས་པའི་ཕུང་པོ་ལྔ་དང་།",
