    "ངེས་དོན་དང་དྲང་དོན་གྱི་རྡོ་རྗེ་འཛིན་པའི་ལག་ན་རྡོ་རྗེ་བདུད་དང་ཉོན་མོངས་པ་ཐམས་ཅད་བཅོམ་པས་སྟོབས་པོ་ཆེ།",
    "སླར་གསུངས་པ་ནི་བྱང་སེམས་སླར་སྤྱི་གཙུག་གི་འཁོར་ལོ་ལ་གཤེགས་པའི་དོན་ནོ།",
    "རི་རབ་གསེར་གྱི་ལོགས་ལ་གང་གནས་པ་གང་གི་རང་བཞིན་བོར་ནས་གསེར་དུ་སྣང་།",
    "མོའི་གནས།",
    "དེ་ལྟར་ན་རྩ་ཆེན་དྲུག་ལ་བརྟེན་ནས་འཁོར་ལོ་དྲུག་གི་ལྟེ་བར་བདེ་ཆེན་ཉམས་སུ་མྱོང་བའི་རྣམ་དག་མཚོན་པའི་ཕྱིར་དུ་ལེའུ་གཉིས་པ་ལ་བློཀ་དྲུག་ཡིན་ཏེ།",
    "སྤྱི་གཙུག་ལ་སོགས་པའི་འཁོར་ལོ་དྲུག་གི་རྩའི་དབུས་ཀྱི་ལྟེ་བར་ནམ་མཁའི་བདེ་བ་ཉམས་སུ་མྱོང་བ་གསལ་བར་བྱེད་པའི་ཚིགས་སུ་བཅད་པ་དྲུག་མནན་ནོ།",
    "འཁོར་ལོ་དྲུག་གི་ལྟེ་བར་རབ་བཀུག་སྟེ།",
    "ཡན་ལག་དྲུག་གི་མཚོན་ཆས་བཅོམ་པ་ལས།",
    "རྒྱལ་བ་དྲུག་གི་གནས་ལ་འདོད་རྒུར་སྤྱོད།",
    "ཉན་པར་བརྩོན་པ་ནི་དེ་ཉིད་སྒྲུབ་པའི་རྣལ་འབྱོར་ཡིན་ལ་བདེ་བ་ཆེན་པོའི་དཔལ་དང་ལྡན་ཞིང་དེ་དང་སྟོང་པ་ཉིད་རོ་གཅིག་པའི་རྡོ་རྗེ་རང་གི་ངོ་བོར་འཆང་བ་ལེགས་སོ་སྟེ་ཉོན་མོངས་པའི་གཉེན་པོའི་ཡེ་ཤེས་འཆང་བ་དང་།",
    "ཁྱོད་ཉན་པར་འདོད་པ་དང་བརྩོན་འགྲུས་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ་དེའི་ཕྱིར་ཁྱོད་ལ་ལེགས་པར་བསྟན་པར་བྱ་ཡིས་ཁྱོད་ནི་མ་ཡེངས་པར་རྩེ་གཅིག་པའི་ཡིད་ཀྱིས་ཉོན་ཅིག་ཅེས་པ་སྟེ།",
    "ཕྱག་ན་རྡོ་རྗེ་ཐུགས་ཡེངས་པ་དང་བྲལ་ཡང་ཕྱིས་འབྱུང་གི་གདུལ་བྱ་རྣམས་ལ་གདམས་པའོ།",
    "དེ་ལ་ཞུས་ཤིང་གང་གིས་ལན་སྩལ་བའི།",
    "ད་ནི་རིགས་ཀྱི་དབྱེ་བ་བརྗོད་པར་བྱ་སྟེ་རིགས་ལ་གང་གིས་གཟིགས་པ་དང་།",
    "གོང་དུ་གསུངས་པའི་རིགས་དེ་རྣམས་ལས་གང་ལ་གང་གིས་གཟིགས་ཤེ་ན།",
    "ཆེར་གཟིགས་ཏེ་ཞེས་པས་འགྲེལ་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པས་རིགས་དེ་རྣམས་ལས་རིགས་དྲུག་པ་ཉིད་མཆོག་ཏུ་གཟིགས་པར་སྟོན་པའི་ཕྱིར་རོ།",
    "རིགས་གསུམ་ལ་རྣམ་པར་གཟིགས་པ་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་དབྱེ་བས་རིགས་གསུམ་ཡིན་ལ།",
    "མཆོག་གི་རིགས་ནི་དྲུག་པ་རྡོ་རྗེ་འཆང་སྟེ་དེ་དང་བཅས་པའི་རིགས་དྲུག་གོ།",
    "ཞེས་པས་རིགས་དྲུག་པོ་རེ་རེར་ཡང་ལྔ་ལྔར་ཕྱེ་བས་སུམ་ཅུ་ལ་ནི་འཇིག་རྟེན་པའི་རིགས་ཞེས་བྱ་ལ།",
    "དྲུག་ཅུ་པོ་དེ་རྣམས་ལ་ཕ་ལས་ཐོབ་པའི་རིགས་གསུམ་དང་མ་ལས་ཐོབ་པའི་རིགས་གསུམ་སྟེ་དྲུག་གིས་ཕྱེ་བས་སུམ་བརྒྱ་དྲུག་ཅུའོ།",
    "དེ་ལྟར་རིགས་ཀྱི་དབྱེ་བ་མང་ཡང་རིགས་དྲུག་པ་ཉིད་རིགས་ཐམས་ཅད་ཀྱི་གཙུག་ཏོར་ཆེན་པོར་གཟིགས་སོ་ཞེས་བྱ་བའི་དོན་ནོ།",
    "ད་ནི་སྔགས་དྲུག་གི་རིགས་རྣམས་གསུངས་པ་ཞེས་པ་ནས་༡ ༢ ༣ པ་བོད་པར།",
    "༩ དབྱེ་བ་ལྔ་རྣམས་དག་གིས་བོད་པར།",
    "གང་ལ་གཟིགས་ན་ངེས་དོན་གྱི་རིགས་དྲུག་ལ་གཟིགས།",
    "རང་གི་བདག་ཉིད་རྣམ་པ་ཐམས་ཅད་པའི་སྟོང་གཟུགས་དང་དངོས་པོ་གཅིག་ཏུ་སྦྱོར་བའི་རྣམ་པ་དེ་ལྟ་བུར་གཟིགས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་ལྟེ་བའི་རྩ་འཁོར་གྱི་དབུས་སུ་རྣམ་པར་སྣང་མཛད་ནི་དྷཱཏཱིའི་ནང་གི་ས་བོན་གྱི་ཐིག་ལེ་དང་།",
    "རྣམ་པར་གཟིགས་པ་ནི་ལྟེ་བར་སྐུའི་རང་བཞིན་གྱི་བདེ་བ་སོགས་རིམ་པར་ཉམས་སུ་མྱོང་བའི་དོན་ནོ།",
    "དེ་ལ་བརྟེན་པའི་ཚོར་བའི་ཕུང་པོའི་རང་བཞིན་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་ནི་སྣང་བར་བྱེད་པའི་རིན་འབྱུང་གི་རིགས་ཡིན་ཏེ།",
    "ཅེས་སོ་གཙུག་ཏོར་གྱི་འཁོར་ལོའི་ལྟེ་བར་རིགས་ཆེན་པོ་ཐིག་ལེ་ཆ་བཅུ་དྲུག་ཡོངས་སུ་རྫོགས་པ་རྡུལ་གྱི་ཆ་ཤས་ཁམས་དཀར་པོ་ཟད་པར་བྱེད་པ་དང་བྲལ་བ་ལས་རྡོ་རྗེ་སེམས་དཔའི་རིགས་མི་འགྱུར་བའི་བདེ་བ་སྐད་ཅིག་མ་ཐམས་ཅད་རྫོགས་པ་ནི་གཙུག་ཏོར་ཆེར་གཟིགས་པའི་དོན་ཏེ་དཔེ་མེད་འཚོས།",
    "རིག་བྱེད་དེ་ནི་གང་གི་མགྲིན་པར་མི་གཡོ་བདེ་བཟུང་རིག་པ་པོ་དེ་རཏྟརཱིཀ།",
    "གང་གིས་དཔྲལ་བར་དེར་ནི་ཁུ་བ་དྲི་བྲལ་བདེ་བ་འདི་ཉིད་བཟུང་བ་པྲཛྙཱདཱིཀ།",
    "གཙུག་ཏོར་ཚངས་པའི་བུ་གར་མི་འགྱུར་མཆོག་གི་བདེ་བ་དགའ་བ་བཅུ་དྲུག་རྫོགས་པ་ནི།",
    "ཤེས་རབ་གང་ཞིག་རང་བཞིན་མེད་པ་ཉ་ཡི་མཐའ་ཡི་མཆོག་གི་ཟླ་བའི་ཆ་བཅུ་དྲུག།",
    "མཐའ་ཡས་དེ་ནི་གང་གི་རིག་མ་སྤྱི་བོའི་རྡོ་རྗེ་དེ་ནི་དྲུག་པ་རྡོ་རྗེ་སེམས།",
    "གང་གིས་མགྲིན་པར་དེ་རིག་གཡོ་མེད་བདེ་བ་འཛིན་པ་དེ་ནི་ཚོར་བྱེད་རིན་ཆེན་འཛིན།",
    "གང་གིས་མགོ་བོར་ཟླ་བ་འཛིན་པ་འདི་ནི་ཁུ་བ་དྲི་བྲལ་བདེ་བ་ཤེས་རབ་འཛིན།",
    "མཆོག་གི་བདེ་བ་དགའ་བ་བཅུ་དྲུག་རབ་གང་བ།",
    "གང་གིས་ཤེས་རབ་རང་བཞིན་མེད་པ་མཆོག་གི་ཟླ་བ་ཆ་ཤས་བཅུ་དྲུག་རྫོགས་པའི་མཐའ།",
    "དེ་ནི་དཔག་མེད་གང་གིས་རིག་པ་མགོ་བོར་རྡོ་རྗེ་དང་བཅས་དྲུག་པ་རྡོ་རྗེ་སེམས།",
    "གང་གི་རང་བཞིན་མི་འགྱུར་བདེ་བ་ཆེ།",
    "གསུང་བ་པོ་གང་གིས་དངོས་པོ་གང་གསུངས་པ།",
    "དང་པོ་གསུང་བ་པོ་གང་གིས་དངོས་པོ་གང་གསུངས་པ་ལ་སྤྱི་དང་།",
    "ཡན་ལག་གི་དོན་ནོ།",
    "དྲུག་པ་མཆོག་ཏུ་བསྟན་ནས་རིགས་དྲུག་གི་ལེའུ་སོ་སོ་བ་རྣམས་ཀྱིས་རྒྱས་པར་འཆད་པའི་ཕྱིར།",
