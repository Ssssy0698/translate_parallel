    "མི་གཙང་དྲི་མའི་སྤྱོད་ཚུལ་མ་ལུས་པ།",
    "ཀུན་ལ་ཉེ་རིང་མེད་པར་འཇིག་པའི་ཚུལ།",
    "དཔེ་དང་བཅས་པར་བླང་དོར་སྟོན་མཁས་པས།",
    "འདྲེན་བྱེད་རྟག་ཏུ་ཟུམ་པ་མེད་པར་བལྟ།",
    "ངེས་ལེགས་ཐར་བའི་ལམ་བཟང་མཚོན་པར་བྱེད།",
    "ཚིག་དོན་མ་ནོར་སོ་སོར་ལེགས་པར་འདོམས།",
    "གཟུངས་སྣང་བསྟན་པ་ཅི་དགོས་མཁྱེན་པའི་ཀློང་།",
    "མཐོང་བའི་སྐྱེ་བོ་ལོག་པར་འཁྲུལ་བ་བརྫུན།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་སྤྱོད་པ་གཙང་བ་ཡིས།",
    "དགའ་བདེའི་སྣང་བ་ནུབ་པར་གོར་མ་ཆག།",
    "བདག་ཅག་དོན་ཕྱིར་མ་ག་དྷ་འདིར་བཞུགས།",
    "དང་བའི་ཡིད་ཀྱི་ངང་ཚུལ་སྨྲས་པ་ལགས།",
    "བདག་ཅག་མགོན་མེད་ཐུགས་ཀྱིས་བཟོད་ལགས་སམ།",
    "སྒྲ་དོན་ཇི་ལྟར་ཞེན་པར་མི་འགྱུར་བའི།",
    "ཉེས་པའི་བསྙེངས་བྲལ་འབྲུག་སྒྲའི་དཔལ་འཛིན་པར།",
    "ཚུལ་བཞིན་མ་མྱང་བཀུར་སྟི་མ་བྱས་ཤིང་།",
    "གཉིས་པ་ཁྱད་པར་ལ་གནས་པའི་དོན་༡༧ན་གཞན་བཀོད་པ་ནི།",
    "འཇིག་རྟེན་མ་ལུས་ཀུན་ནས་རྣམ་པར་བཀྲ།",
    "སྐལ་བ་ངན་པའི་ཡིད་དང་མི་འཚམ་པར།",
    "པད་མའི་དགྲ་ཡིས་གདུངས་པར་འོང་ན་ཡང་།",
    "མཉེས་གཤིན་ཐུགས་ཀྱིས་སྨིན་མ་སྣུམ་པར་རིགས།",
    "ཟས་གཙང་སྲས་པོ་ལོངས་སྤྱོད་རྫོགས་སྐུར་མཚུངས།",
    "དཔྲལ་བ་ལེགས་པར་འབྱེས་པའི་ཡོན་ཏན་ནི།",
    "ཟས་གཙང་སྲས་པོ་མང་བཀུར་རིགས་སུ་འཁྲུངས།",
    "འབད་རྩོལ་མེད་པར་འཕྲིན་ལས་ཀུན་ཏུ་འཇུག།",
    "བྱི་དོར་མ་བྱས་གཟི་འོད་ཕྱོགས་སུ་འཕྲོ།",
    "རྟག་ཏུ་རྒྱུན་ཆད་མེད་པར་སྒྲོགས་པ་ཡི།",
    "དོག་པ་མེད་པར་ཤོང་བའི་ཞིང་ཁམས་འདི།",
    "མུ་སྟེགས་ཚོགས་ཀུན་རྣམ་པར་འཇོམས་པ་ཡི།",
    "ལྡན་པས་གང་གསུང་ཉན་པར་འོས་པ་ལ།",
    "གསུམ་པ་རྣམ་པར་འགྱུར་བའི་རྒྱུ་ནི།",
    "སྒྲ་འཛིན་ཡུལ་དུ་མི་རྩུབ་འཇམ་པར་འགྱུར།",
    "བསླབ་པའི་མཚམས་ལས་འགོང་པར་གྱུར་པ་ཡི།",
    "དཔག་པར་དཀའ་བའི་གསུང་མཆོག་མི་བརླང་བ།",
    "ཕྱི་རོལ་ཡུལ་ལ་རྣམ་པར་གཡེང་བ་སྤངས།",
    "ཟབ་དོན་མ་འདྲེས་རྣམ་པར་རིག་པའི་གསུང་།",
    "ཡིད་ཅན་རྣམ་པར་དཔྱོད་པའི་བློ་གྲོས་ཀྱི།",
    "ཆུ་སྐྱེས་ཚོགས་རྣམས་ཟུམ་པར་རིགས་སམ་ཅི།",
    "ཉམས་སུ་བླངས་པའི་དགའ་སྟོན་སྤྱོད་པར་རིགས།",
    "ཕྱོགས་བཅུའི་ཞིང་ཁམས་མ་ལུས་ཁྱབ་པར་བྱས།",
    "རྣམ་པར་རིགས་མཛད་བདག་ཉིད་ཆེན་པོ་རྣམས།",
    "འཚམ་པར་སྟོན་མཛད་འབྲེལ་བའི་གསུང་དབྱངས་ཀྱི།",
    "མུ་སྟེགས་ཚོགས་རྣམས་ཐམས་ཅད་སྐྲག་པར་མཛད།",
    "ལོག་པར་སྨྲ་བ་མཐའ་དག་ས་འོག་ཏུ།",
    "སྐྱོ་ངལ་མེད་པར་རྣམ་པར་དཔྱོད་པའི་མཐུས།",
    "དྲུག་ལྡན་སྙན་པའི་སྒྲ་ཡིས་དགའ་བསྐྱེད་པར།",
    "རྣམ་མང་གོ་མཚོན་གཡུལ་དང་མི་ལྡན་པར།",
    "མི་གཙང་འདམ་གྱིས་སྤགས་པའི་རྫིང་བུ་རུ།",
    "རྟག་ཏུ་ངལ་བ་མེད་པར་ཀུན་ཏུ་རྒྱུ།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བ་རྔ་སྒྲའི་དབྱངས།",
    "ས་ལ་འགྱེལ་ཞེང་མི་གཙང་བརྒྱུད་མར་འདོར།",
    "ཞུམ་པ་མི་དགོས་སྐྱབས་སུ་བསྟེན་པར་རིགས།",
    "ཐར་འདོད་གདུལ་བྱའི་བློ་དང་རྗེས་མཐུན་པར།",
    "མ་ཚང་མེད་པར་རྟག་ཏུ་ཉེར་གནས་པའི།",
    "རྨི་ལམ་རྣམ་པས་ལྷུམ་ཞུགས་ཟས་གཙང་སྲས།",
    "སྲིད་པར་མི་མཐུན་དམ་པའི་ལོངས་སྤྱོད་མཆོག།",
    "གསུང་གཅིག་སྒྲ་ཀུན་རྫོགས་པར་བྱེད་པ་དང་།",
    "མ་ལུས་མཁས་པའི་ཡིད་ནི་འགུགས་པར་བྱེད།",
    "ཇི་བཞིན་མཁྱེན་དང་བརྩེ་བའི་བདག་ཉིད་ཅན།",
    "མཁྱེན་པའི་གཏེར་ཏེ་རིན་ཆེན་འབྱུང་གནས་ཅི།",
    "ཉེ་རིང་མེད་པར་ཀུན་ཏུ་བསྒྲགས་པའི་གསུང་།",
    "ཉེར་ལྔ་པ་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ལ་ལྔ་ཡོད་པའི་དང་པོ་ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ནི།",
    "གཉིས་པ་རིགས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ནི།",
    "གསུམ་པ་བྱ་བ་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ནི།",
    "བཞི་པ་རྫས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ནི།",
    "བདུད་ཀྱི་དམག་ཚོགས་མ་ལུས་ཕམ་པར་བྱས།",
    "རྣམ་རྟོག་མེད་པར་རྟག་ཏུ་མཉམ་གཞག་ཅིང་།",
    "རྣམ་པར་བཀྲ་བའི་ཁ་དོག་དབྱིབས་ཀྱི་ཚོགས།",
    "ནམ་མཁའ་དང་ནི་རྣམ་པར་ཤེས་པའི་ཁམས།",
    "ཆགས་ཐོགས་བྲལ་བ་སྨོན་གནས་མཁྱེན་པ་ཡིས།",
    "ཡིད་ལ་བཟོད་དཀའི་མྱ་ངན་སྐྱེད་པར་བྱེད།",
    "སྲས་ཀྱི་ཐུ་བོ་བྱམས་དང་མཁྱེན་བརྩེའི་བདག།",
    "མ་ལུས་བདུད་ཀྱི་ཚོགས་རྣམས་ཕམ་པར་བྱས།",
    "འཇིག་རྟེན་༢༤ན་རྣམ་འདྲེན་ཀུན་མཁྱེན་ཉི་མའི་གཉེན།",
    "ལས་ཉོན་ཚ་བའི་གདུང་བ་འཕྲོག་པར་བྱེད།",
    "མཐའ་བྲལ་ཤེས་བྱའི་དཀྱིལ་འཁོར་མ་ལུས་པར།",
    "བྱ་དཀའ་བའི་ཁྱད་པར་གཞན།",
    "བདེན་པར་དམིགས་པ་མེད་པའི་ཡེ་ཤེས་ཀྱི།",
    "ཤེས་རབ་ས་གསུམ་མྱུར་དུ་བགྲོད་པར་མཛད།",
    "དམ་དམ་བདེན་པར་རྟག་ཏུ་ཞེན་པ་ཡི།",
    "ངལ་ངལ་སྲིད་པར་འཁྱམས་པའི་འགྲོ་བ་རྣམས།",
    "ལྷམ་ལྷམ་རྣམ་པར་བཀྲ་བའི་ཡེ་ཤེས་ཀྱིས།",
    "ཀུན་ནས་རྫོགས་པར་མངོན་སུམ་མཐོང་བ་ལ།",
    "མྱུར་དུ་འཇུག་པར་རྒྱལ་བས་བྱིན་གྱིས་རློབས།",
    "རྣམ་པར་བྱང་བ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར།",
    "རྣམ་པར་བྱང་བའི་རྒྱུ་ཚོགས་ཚང་བ་ལས།",
    "བདེ་ཆེན་རྣམ་གྲོལ་གླིང་དུ་འཁྲིད་པར་མཛད།",
    "དཀའ་དཀའ་མེད་པར་བདེ་བླག་འགྲོལ་མཛད་པའི།",
    "དང་པོ་རྐང་པ་བཞིའི་དབུས་ན་ཡོད་པར་དབྱེ་བ་གཉིས་ལས་དང་པོ་ཆོད་ཅིང་མ་ཆོད་པ་ནི།",
    "ལན་ཅིག་མིན་པར་ཡང་ཡང་གསོལ་བཏབ་མཐུས།",
    "ཐོས་བསམ་སྒོམ་ལ་ཡང་ཡང་འཇུག་པར་སྤྲོ།",
    "ཀུན་བྱང་རྣམ་དོན་རྣམ་པར་མ་འདྲེས་པར།",
    "འགྲོ་ལ་ཆགས་སྡང་མེད་པར་སྙོམས་པའི་ཐུགས།",
    "གསུམ་པ་བར་མཐའ་གཉིས་ན་ཡོད་པར་གཉིས་ཀྱི་དང་པོ་ཆོད་པ་ནི།",
    "ཟག་ཟད་མཁྱེན་པས་ད་ལྟར་བྱུང་རྣམས་མཁྱེན།",
    "འཆི་འཕོ་མཁྱེན་པས་མ་འོངས་འབྱུང་འགྱུར་མཁྱེན།",
    "དུས་གསུམ་མཁྱེན་པས་ཆགས་ཐོགས་མེད་པར་མཁྱེན།",
    "མཁྱེན་བརྩེའི་ཐུགས་བཟང་བཟང་པོའི་དབྱིངས་བཟང་བཟང་།",
    "བཞི་པ་ཐོག་བར་གཉིས་ན་ཡོད་པར་གཉིས་ལས་དང་པོ་ཆོད་པ་ནི།",
    "དཔལ་མཆོག་དམ་པ་མཁྱེན་པའི་དཔལ་དང་ལྡན།",
    "དཀར་དཀར་མཁྱེན་གཏེར་ངག་སྦྱིན་སྐུ་དཀར་དཀར།",
    "དྲུག་པ་༢༨བ་གནས་གསུམ་ཀ་ལ་ཡོད་པར་གཉིས་ལས་དང་པོ་ཆོད་པ་ནི།",
    "དང་པོ་གསུམ་པ་དང་གཉིས་པ་བཞི་པར་བཟླས་པ་ནི།",
    "གསུམ་པ་བཞི་པར་བཟླས་པ་ནི།",
