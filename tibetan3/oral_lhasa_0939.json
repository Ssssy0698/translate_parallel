    "ལེགས་སྤྱད་རྣམ་པར་དཀར་བ་གངྒའི་རྒྱུན།",
    "དབུགས་དབྱུངས་གཏན་བདེའི་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "ཁྱད་པར་ཕན་བདེའི་རྩ་བ་རྒྱལ་བའི་བསྟན།",
    "བསྐུལ་བའི་མི་གཙང་ས་ཡི་རྡུལ།",
    "ཆེ་བ་བཞི་ལྡན་ལམ་གྱི་རིམ་པའི་གདམས་པར་ཤར།",
    "རྟག་ཏུ་རྒྱལ་བའི་གདུང་འཚོབ་དམ་པར་བདག་གྱུར་ཅིག།",
    "ཞེས་གསུངས་པ་གདམས་ངག་ཏུ་ཡིད་ཆེས་ཏེ།",
    "ཁོ་བོ་མ་བསླབ་མཁྱེན་པའི་གྲགས་སྙན་གྱིས།",
    "དེ་སྲས་ཡིན་ན་ཟས་གཙང་སྲས་དེ་ནོངས།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པ་རྗེས་འབྲང་དང་བཅས་པའི་བཞེད་པ་ལྟར།",
    "དུས་དབྱངས་མཐུན་པར་ན་ཚོད་སྨིན་པ།",
    "བསྟན་འགྲོར་ཕན་པའི་ལྷག་བསམ་རྣམ་པར་དཀར་བའི་སྟོབས་ཀྱིས།",
    "སུ་དྷིན་པྲ་ཤ་ལའམ་མིང་གཞན་མཚོ་བྱུང་རོལ་པའི་བློ་གྲོས་སུ་འབོད་པས་རབ་ཚེས་མེ་ལུག་མཁའ་སྤྲིན་ཅན་གྱི་དགའ་བ་གསུམ་པར་གུས་པ་ཆེན་པོས་ཕུལ།",
    "རྫས་བཞིས་མཚོན་པའི་བརྗོད་པར་བྱས་བའི་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ནམ་ངོ་བོ་དང་།",
    "རིགས་ཀྱི་རྒྱན་རྣམས་དྲངས་པར་གསུངས།",
