    "དེའི་ཕྱིར་ཕྲན་གྱིས་སྙན་ངག་གསར་རྩོམ་ལ་འཇུག་འདོད་པའི་གྲོགས་པོ་ཚོར་གཤམ་གྱི་རེ་བ་དག་འདོན་རྒྱུ་ཡིན་ལ་འདི་དག་ནི་ང་ཚོའི་ལས་འགན་ཡང་ཡིན་པར་སྙམ།",
    "དེས་དངོས་པོའི་འཇིག་རྟེན་གྱི་གཤིས་ལུགས་དང་དེ་དང་འབྲེལ་བའི་ལྟར་སྣང་གི་བཀོད་པ་མང་དག་ཅིག་ལ་བརྩི་བཀུར་བྱེད་དགོས་པ་མ་ཡིན།",
    "སྙན་ངག་འཁྲུངས་པ་ནས་ཁྱོད་ཀྱིས་དག་ཞིང་ངམ་དམྱལ་ཁམས་ལྟ་བུའི་ཞིང་ཁམས་ཤིག་གསར་དུ་རྙེད་ཟིན་པས་དུས་ནམ་ཡང་ཀློག་མཁན་ཚོའི་བསྟོད་ཚིག་གི་ཆོ་ལོར་སྒུག་དགོས་དོན་ཅི་ཡོད།",
    "ཁྱོད་ལ་མཚོན་ན་ཁེར་རྐྱང་དུ་སྡོད་པ་ནི་གཟི་བརྗིད་ཅིག་དང་རྒྱལ་ཁ་ཞིག་མ་ཡིན་ནམ།",
    "སྙན་ངག་གི་མཆོད་སྟེགས་མདུན་དུ་པུས་ཚུགས་སུ་སྡོད་པའི་ཁྱོད་ཀྱིས་དགེ་སྡིག་དང་ལེགས་ཉེས།",
    "བཟང་ངན་དང་མཆོག་དམན་སོགས་ཚད་ཤིང་མང་པོའི་ཞལ་ཟས་ཙམ་བཤམས་ཏེ་སྙན་ངག་གི་ལྷ་ཆེན་པོའི་དངོས་གྲུབ་ལ་སྒུག་གམ།",
    "ཁྱོད་ཉིད་དངོས་དོན་གྱི་སྙན་ངག་པ་ཞིག་ཏུ་འགྱུར་སྲིད་པ་ཅི་ལ་མིན།",
    "དེང་གི་བོད་ཀྱི་གསར་བུ་འགས་ནི་བོད་ཀྱི་སྔོན་བྱོན་མཁས་པ་གང་ཞིག་ལ་རྗེས་དྲན་བྱེད་པ་དང་།",
    "བདག་གིས་བསམ་ན་བོད་ལ་ཁོང་གཉིས་ལས་གཞན་མཁས་པ་མང་པོ་མང་པོ་ཞིག་ཡོད་པ་རེད་ལ་དེ་ཀུན་གྱིས་ཁས་ཀྱང་ལེན་ངེས་རེད།",
    "འོན་ཀྱང་ཁོང་གཉིས་ལས་གཞན་པར་ཅིའི་ཕྱིར་རྗེས་དྲན་དང་གདེང་འཇོག་མི་བྱེད་པ་རེད་ཅེས་ན།",
    "སྤྲང་བོ་ཚོའི་ནང་དུ་རྒན་པ་དང་བྱིས་པ་ཡོད་ལ་གསར་བུ་དང་གསར་མོའང་འདུག་ཕྱི་ཚུལ་རྫོབ་པོ་ཅན་ཡོད་ལ་ཆ་ལུགས་གྲ་དག་ཅན་ཡང་མཆིས།",
    "དེ་བས་ང་ཚོ་མི་སུ་ཡང་སར་བསྡད་ནས་མཐེ་བོང་ལན་གཅིག་བསྒྲེངས་པ་ན་སྤྲང་བོར་མི་འགྱུར་བའི་ངེས་པའང་མེད།",
    "བོད་ཀྱི་སྙན་ངག་གི་ཚོགས་པ་མི་རབས་གསུམ་པའི་སྐོར་ནས་ཞིབ་འཇུག་པ་ཞིག་གི་དྲི་བར་ལན་བཏབ་པ།",
    "༡ཁྱེད་ཀྱི་མིང་ལ་ཅི་ཟེར།",
    "ཕྱིར་བུད་ཡོད་ན་ག་དུས་ཅིའི་ཕྱིར་བུད་པ་ཡིན།",
    "༢༡༡ལོར་ང་རང་ཚོགས་པ་དེ་ལས་ཕྱིར་བུད་པ་ཡིན།",
    "དཔེར་ན་ངེད་ཅག་གི་ཐེངས་དང་པོའི་འདུ་ཚོགས་སུ་ན་ཚོད་ངེད་ཅག་དང་མཉམ་པའི་མི་སུ་ཡིན་ཡང་དེར་ཞུགས་ཆོག་པའི་སྒོ་མོ་ཕྱེ་ཡོད་པར་མ་ཟད་མི་དེ་དག་གི་མིང་ནས་བགྲང་སྟེ་འདུ་ཚོགས་སུ་ཞུགས་མ་ཐུབ་པར་ཕངས་སེམས་བསྟན་ཡོད།",
    "ཡིན་ནའང་མི་འགའ་ཞིག་གིས་ཁོང་ཚོ་འཐད་མོས་ལ་མ་བལྟས་པར་མི་རབས་གསུམ་པ་རུ་བཙན་གྱིས་བཅུག་སོང་ཟེར་ནས་མི་འཐད་པའི་ཚིག་ཀྱང་སྨྲས་ཡོད་ཅིང་དེ་ནི་ཁོང་ཚོས་ངེད་ཅག་གི་སྐབས་དེའི་བསམ་འདུན་ལ་རྒྱུས་ལོན་མ་བྱས་པས་རེད།",
    "དེ་ནི་ངེད་ཅག་གི་ཐོག་མའི་དམིགས་འདུན་དང་འགལ་བ་ཞིག་ཡིན་པ་དང་ཐབས་ཟད་རྗེས་ཀྱི་ཐབས་ཤིག་ཀྱང་ཡིན།",
    "༢༡༡ལོར་ང་དང་གྲོགས་པོ་འགའང་སྙན་ངག་གི་ཚོགས་པ་དེ་ལས་ཕྱིར་བུད་པ་ཡིན།",
    "རང་ཉིད་ཞུགས་སའི་སྙན་ངག་གི་ཚོགས་པ་དེ་ནི་ཚ་ཚ་འུར་འུར་དང་།",
    "ཚེ་སྲོག་གི་དཔལ་གྱིས་བརྟས་པ།",
    "དང་པོ་ང་ཚོས་གཅིག་ནས་དུས་རབས་ཉི་ཤུ་བའི་ལོ་རབས་བདུན་ཅུ་བ་དང་བརྒྱད་ཅུ་བའི་ནང་དུ་སྐྱེས་པའི་བོད་ཀྱི་སྙན་ངག་པ་ཚོའི་སྤྱི་མིང་དང་།",
    "འོན་ཀྱང་འདུ་ཚོགས་གཉིས་པ་ནས་བཟུང་སྟེ་ཚོགས་མི་གཏན་འཁེལ་བྱས་ཟིན་པའི་སྙན་ངག་གི་ཚོགས་པ་དེ་ལ་ངོས་འཛིན་གྱི་ཡོད།",
    "ཚོར་བ་ཤུགས་དྲག་པོའི་ངང་མ་ནས་རང་གི་བརྩེ་བ་མཚོན་པ།",
    "འཇུ་སྐལ་བཟང་གི་ལུགས་བཅས་སྙན་ངག་གི་ལམ་ཀ་དེ་གསུམ་པོ་སྲོལ་རྒྱུན་སྙན་ངག་ཏུ་ངོས་འཛིན་ཞིང་ཁོ་ཚོ་རང་གིས་འབྲི་བཞིན་པ་དེ་ད་གཟོད་སྙན་ངག་གསར་བར་རྩི་བཞིན་ཡོད།",
    "སྙན་ངག་པ་མི་གཅིག་གི་རྩོམ་སྟངས་ཀྱང་རྣམ་པ་སྣ་ཚོགས་སུ་ངེས་པས་དེ་དག་རེ་རེ་བཞིན་ངོ་སྤྲོད་པ་ནི་ཚེགས་ཆེ་བའི་ལས་ཀ་ཞིག་རེད།",
    "ལས་ཀ་དེ་ནི་བོད་ཀྱི་རྩོམ་རིག་ལ་ཞིབ་འཇུག་བྱེད་མཁན་ཚོའི་ལས་ཀ་ཞིག་ཀྱང་རེད་སྙམ།",
    "དཔེར་ན་མདའ་བཙན་པོའི་སྙན་ངག་ནི་ཁ་རི་ཁ་ཐུག་གི་ཚོར་བ་ཤུགས་ཆེ་ཞིང་དམོད་ཚིག་གིས་ཀུན་ནས་ཁྱབ་པ་དང་།",
    "ཚེ་རིང་སྐྱིད་ཀྱི་སྙན་ངག་ནི་བུད་མེད་ཀྱི་བརྩེ་བ་དང་གདུང་བ་ཉིད་མཚོན་པའི་ཞི་དུལ་གྱིས་མཛེས་པོ།",
    "སྤྱིར་བདག་ནི་རྩོམ་རིག་གི་ངོས་ནས་ཕར་བརྒལ་དང་འཕེལ་རྒྱས་ལ་སོགས་པའི་ཐ་སྙད་བེད་སྤྱོད་པར་དགའ་བོ་མེད།",
    "བདག་གིས་བསམ་ན།",
    "དེ་བས་དཔྱད་རྩོམ་རིང་མོ་ཞིག་གིས་མ་གཏོགས་སྐད་ཆ་ཐུང་ཐུང་ཞིག་གིས་དྲི་བ་འདིར་ལན་གདབ་དཀའ་བར་སྣང་།",
    "ལྗང་བུའི་སྙན་ངག་གིས་ཁྱེད་ལ་བག་ཆགས་བཞག་ཡོད་དམ།",
    "བདག་གིས་བསམ་ན་ལྗང་བུ་དང་འཇུ་སྐལ་བཟང་གཉིས་ནི་བོད་ཀྱི་སྙན་ངག་པ་ཡག་ཤོས་གཉིས་ཀ་རེད་སྙམ།",
    "སྤྱིར་རང་གྲོལ་གྱི་རྗེས་ནས་བོད་ལ་རང་མོས་སྙན་ངག་གམ་དེང་རབས་སྙན་ངག་འབྲི་མཁན་མང་པོ་བྱུང་ཡོད་ནའང་མང་ཤོས་ཀྱིས་དཔེ་འགོད་སྟངས་དང་།",
    "སྤྱི་བའི་མཛེས་དཔྱོད་ཀྱི་ལྟ་བ་ལས་ཀྱང་འབུད་ཐུབ་མེད།",
    "བདག་གིས་ལོ་ན་ཕྲ་བའི་དུས་སུ་ལྗང་བུ་མ་ཟད་བོད་ཀྱི་ཅུང་གྲགས་ཆེ་བའི་སྙན་ངག་པ་མཐའ་དག་ལ་ལད་མོ་བྱས་མྱོང་བས་ཁོ་ཚོའི་བག་ཆགས་མེད་པ་ག་ལ་སྲིད།",
    "༧ཉིད་ཀྱིས་བསམ་པར་ལྗང་བུའི་སྙན་ངག་ཡག་ཤོས་གང་རེད།",
    "ང་རང་ཆེས་དགའ་སའི་ལྗང་བུའི་སྙན་ངག་ནི་ལྗང་བུའི་སྙན་ངག་དེབ་ནང་གི་ཆེས་གོ་དཀའ་བའི་རིགས་དེ་དག་དང་།",
    "༨ཁྱེད་ཀྱིས་མི་རབས་གསུམ་པའི་ཚབ་མཚོན་སྙན་ངག་གང་དག་རེད་བསམ།",
    "སྙན་ངག་གང་དང་སྙན་ངག་པ་སུ་ཡག་ཤོས་རེད་བསམ།",
    "མི་རབས་གསུམ་པའི་ཚགས་དེབ་སོགས་སུ་བཀོད་པའི་སྙན་ངག་དེ་དག་ནི་ཡག་ཤོས་རེད་སྙམ་ལ།",
    "སྙན་ངག་པ་ནི་མི་རབས་གསུམ་པའི་ཚབ་མཚོན་སྙན་ངག་པའི་བྱ་དགའ་ཐོབ་སའི་སྙན་ངག་པ་དེ་དག་ཡག་ཤོས་རེད་སྙམ།",
    "༩ཁྱེད་ཀྱིས་རང་ཉིད་ཀྱི་སྙན་ངག་ཡག་ཤོས་དེ་གང་རེད་འདོད།",
    "ཁྱེད་ཀྱི་སྙན་ངག་གང་གིས་མི་རབས་གསུམ་པ་མཚོན་ཐུབ་ཀྱི་འདུག་ལན།",
    "དེ་བས་འདི་ནི་སྙན་ངག་ཡག་ཤོས་རེད་ཅེས་བསལ་རྒྱུ་དེ་ཤིན་ཏུ་དཀའ་བ་རེད།",
    "མི་རབས་གསུམ་པ་བོད་ཀྱི་རྩོམ་སྟེགས་སུ་བུད་མ་ཐག་མི་མང་པོ་ཞིག་གིས་ཡིན་མིན་གྱི་གཏམ་མང་པོ་ཞིག་ལབ་ཅིང་།",
    "ཧ་ལས་དགོས་པ་ནི་མི་རབས་གསུམ་པའི་མཛེས་པར་དཔྱོད་པའི་བློ་གསར་བ་དེ་ཡིན་ཞིང་དེ་ནི་བོད་ཀྱི་རྩོམ་རིག་གི་སྐྱེད་ཚལ་ལ་མཚོན་ན་སྔོན་ཆད་ཀྱི་པད་མ་དེ་མིན་པའི་ཁ་དོག་སྣ་ཚོགས་སུ་ངེས་པའི་རྒྱ་སེ་ཆུན་པོ་དེ་རེད།",
    "རྩོམ་སྟངས་དང་མཚོན་ཐབས་གང་བློ་ལ་འབབ་ཤོས་རེད།",
    "ཁྱེད་ཀྱིས་བལྟས་ན་དེང་རབས་རིང་ལུགས་པའི་རྩོམ་ཐབས་ལེགས་ཤོས་རིགས་གང་དག་རེད་འདོད།",
    "ཁོང་ཚོའི་བསམ་བློའམ་ལྟ་གྲུབ་གཙོ་བོ་ཅི་རེད་བསམ།",
    "བདག་གིས་དེང་རབས་རིང་ལུགས་ཀྱི་རྩོམ་ཐབས་གང་ཡིན་ཡང་དགའ་བོ་བྱེད་ཀྱི་ཡོད།",
    "༡༣ནུབ་ཕྱོགས་དེང་རབས་རིང་ལུགས་ནི་སྒྱུ་རྩལ་གྱི་ལས་འགུལ་ཆེན་མོ་ཞིག་ཡིན་དུས།",
    "སྤྱིར་བདག་ནི་སྙན་ངག་མ་གཏོགས་པའི་སྒྱུ་རྩལ་གྱི་རྣམ་པ་གཞན་དག་སྟེ་རོལ་མོ་དང་།",
    "རི་མོ།",
    "གློག་བརྙན་སོགས་ལ་ཤིན་ཏུ་དགའ་མོས་བྱེད་མཁན་ཞིག་ཡིན་པར་མ་ཟད་མཚན་ཉིད་རིག་པའི་ཕྱོགས་ལའང་སྤྲོ་བ་ཆེས་ཆེར་ཡོད་པ་ཞིག་ཡིན།",
    "དཔེར་ན་རི་མོ་བ་དང་།",
    "དེ་མིན་སོགས་ཀྱི་སྒྱུ་རྩལ་གྱི་འཚོ་བ་ཇི་ལྟར་རོལ་བའི་སྐོར་ནི་བདག་ལ་མཚོན་ན་འགུག་ཤུགས་ཤིན་ཏུ་ཆེ་བ་ཞིག་རེད།",
    "ཁོང་གི་ཟློས་གར་གྱི་འཁྲབ་གཞུང་དང་མི་ཚེའི་ལྟ་བ་ལ་གོ་བ་ཡག་པོ་ཞིག་ལོན་རྗེས་ཡི་མཚན་ཉིད་རིག་པའི་གཞུང་དང་།",
    "དེ་ནི་ཆུང་ངུའི་དུས་ནས་ནང་བསྟན་གྱི་བག་ཆགས་ཟབ་མོ་ཡོད་པ་དེ་ལ་འགྲེལ་བ་གསར་བ་ཞིག་བྱུང་བ་དང་འདྲ།",
    "བརྡ་འཕྲིན་གྱི་ཡོ་བྱད་ཤུགས་ཆེན་པོར་དར་བའི་དེང་གི་དུས་འདིར།",
    "དེ་བཞིན་གོ་ལའི་སྟེང་བྱུང་བའི་གསར་བྱུང་གི་གནས་ཚུལ་མཐའ་དག་ཀྱང་ཅི་འདོད་དུ་ཐོས་ཐུབ་ཀྱི་ཡོད།",
    "ཡིན་ནའང་ཨ་རིའི་ཞེས་པའི་སྙན་ངག་གི་ཚོགས་པ་དེས་འཆལ་བོའི་སྤྱོད་པ་སྣ་ཚོགས་དང་བཅས་མི་མང་གི་དབུས་ནས་སྙན་ངག་ཀློག་པའི་ཚུལ་དེ་ཅི་ལྟ་བུ་ཞིག་ཡིན་ནམ་ཞེས་རང་གི་སེམས་ནས་རྟོག་བཟོ་བྱ་དགོས་འདུག་ཅིང་།",
    "སྐབས་ལ་ལར་དེ་ནི་རང་གིས་དངོས་སུ་བརྒྱུད་ཟིན་པའི་འཚོ་བའི་ལམ་ཀ་ཞིག་ཡིན་པའི་སྣང་བའང་སྟེར།",
    "བདག་གིས་བསམ་ན་འཛམ་གླིང་གི་སྙན་ངག་པ་ཡོངས་ལ་ཐུན་མོང་གི་གཤིས་སྤྱོད་ཅིག་ཡོད་པ་འདྲ་སྟེ།",
    "ལྷག་པར་དུ་ཆགས་སྲེད་བརྗོད་བྱར་བྱས་པའི་སྙན་ངག་ལ་སྐྱོན་བརྗོད་ཚ་ནན་བྱས་ཡོད་པ་རེད་ཟེར།",
    "ཁོ་ཚོས་ཐད་ཀར་དགག་པ་བརྒྱབ་པའི་རྩོམ་བྲིས་པ་བདག་གིས་ཀྱང་མཐོང་མ་མྱོང་།",
    "༡༩ཉིད་ཀྱི་བསམ་པར་མི་རབས་གསུམ་པའི་སྙན་ངག་གི་བཟང་ཆ་དང་སྐྱོན་ཆ་གཙོ་བོ་རྣམས་གང་དག་རེད་བསམ།",
    "ཞན་ཆ་ནི་བོད་ཀྱི་སྙན་ངག་པ་བྱིངས་བཞིན་དཔེ་ཀློག་གི་མྱོང་བ་ཉུང་བ་དང་།",
    "དེ་ཡི་མཐུ་ཡིས་གསར་གཏོད་ཀྱི་སྤོབས་པའང་ཞན་པར་བྱས་པ་དེ་རེད་སྙམ།",
    "ཁོང་ཚོའི་ཚོགས་པ་འཐོར་བ་ཡིན་ནམ།",
    "རྨོག་ཤེར་སོགས་དེ་ལས་བུད་ཡོད་པ་དང་།",
    "ཤུལ་ཏུ་ཡོད་པ་དེ་དག་གིས་མི་རབས་གསུམ་པའི་མིང་ཐོག་ནས་ལས་ཀ་ཅི་ཞིག་བསྒྲུབ་ཀྱང་རུང་ངེད་ཅག་ལ་འབྲེལ་བ་ཡོད་པ་མ་ཡིན།",
    "༢༡ཁྱེད་རང་ལ་བག་ཆགས་ཆེས་གཏིང་ཟབ་འཇོག་མཁན་གྱི་བོད་ཀྱི་གནའ་དེང་གི་རྩོམ་པ་པོ་སུ་སུ་ཡོད།",
    "ཉིན་མོའི་བྱ་བ་མཇུག་གྲིལ་རྗེས་མཚན་མོ་དུས་ལྟར་སླེབ་ངེས་ལ་སྐབས་དེར་གློག་སྒྲོན་དང་མིག་ཟུང་གཉིས་མཉམ་དུ་གཟིམས་ནས་རྨི་ལམ་གྱི་ཞིང་ཁམས་ལ་འཇུག་དགོས།",
    "ཨ་ཕའི་ཁ་ཏོན་དང་ཨ་མའི་ལག་ལས།",
    "བྱིས་སྒྲུང་ཁྲོད་ཀྱི་སྲོག་ཆགས་དང་རྒྱལ་སྲས་སོགས་ལ་གཏན་དུ་ཁ་བྲལ་ཟིན་ལ་གློག་ཆས་ཕན་ཚུན་ལ་གནོད་པ་གཏོང་རེས་བྱེད་བཞིན་པའི་ཚག་སྒྲ་ཞིག་གིས་མི་ཚེ་དམ་ལ་འདོགས་བྱེད་ཀྱི་རེའུ་མིག་འགའ་གྲུབ་བཞིན་པ་དེས་གོང་གི་དེ་དག་གི་ཚབ་བྱེད་བཞིན་འདུག་པས་སོ།",
    "འོན་ཀྱང་བདག་གིས་ཅི་ཞིག་ལ་མགོ་སྒུར་དགོས།",
    "ལྐོག་གྱུར་གྱི་གནས་ལུགས་དག་མཚོན་བྱེད་ཀྱི་རི་རབ་ཀྱི་བང་རིམ་ལ་མགོ་སྐུར་རམ་ཡང་ན་གྲོད་ཁོག་ལུག་གེར་གད་མོ་ཆེན་པོ་འབྱིན་པར་དགའ་བའི་མི་ཆེན་ཞིག་ལ་མགོ་སྐུར།",
    "བྱ་འབབ་ས་ཚང་དང་མི་འབབ་ས་འཆི་བའི་དྲོད་ཞག་ལམ་མེར་འཁྱིལ་བའི་མལ་ས་རེད།",
    "འོན་ཀྱང་དེ་ནི་རྒྱལ་བོའི་དབུ་རྒྱན་དང་བཙུན་མོའི་དོ་ཤལ་ཇི་བཞིན་ས་འོག་ལ་ཐིམ་ཚར་འདུག་རྩོམ་རིག་གིས་མིག་ཆུ་ཤམ་ཤམ་བཞུར་འོང་ཟེར།",
    "སྔོན་མ་དེའི་ཁ་ན་སྐད་ཆ་གྲག་གིན་འདུག་རྗེས་མ་དེའི་ཁ་ན་རོལ་དབྱངས་གྲག་གིན་འདུག་ད་རུང་མི་ཞིག་ཡོད་པ་དེ་ནང་དུ་འཛུལ་མ་འོང་ཡང་ཁོའི་རྐང་བའི་རྡོག་སྒྲས་ནང་གི་མི་གཉིས་ཀྱི་སྐད་ཆ་དང་རོལ་དབྱངས་ལ་བར་ཆད་བཟོས་སོང་།",
    "དབྱར་ཁས་ཁ་ཕྱིར་འཁོར་རྗེས་རྒྱབ་ན་ཡོད་པ་ནི་སྟོན་ཁ་མ་ཡིན་པར་དགུན་ཁ་རང་རེད།",
    "གལ་ཏེ་ཁོང་ད་དུང་ཡང་འདིར་ཐེངས་གཅིག་ཕེབས་སྲིད་ན་ང་ལའང་དེ་ལྟར་བསྡིག་ངེས་མོད་མཇུག་མཐར་ཁྱོད་ལ་ཁག་མི་འདུག་མི་འདི་ཚོ་གཅིག་ལས་གཅིག་བཙོག་པ་ལ་ཟེར་སྲིད།",
    "རྩོམ་དེའི་མཇུག་ན་དོན་གྲུབ་རྒྱལ་གྱིས་རྐང་ལམ་བོར་ཏེ་གཞུང་ལམ་གྱི་ཕྱོགས་སུ་གོམ་ཁ་བསྒྱུར་ཡོད་ལ་དེ་ནས་ཡུན་རིང་བོ་མ་འགོར་བར་ཁོས་རང་སྲོག་རང་གིས་བཅད་པ་རེད།",
    "བོད་ཡུལ་ཟེར་བར་དགའ་ཞིང་ཐག་རིང་གི་དམྱལ་ཁམས་ཀྱི་མི་དག་ཨ་ཚ།",
    "ངས་ད་བར་དུ་རྩོམ་མང་པོ་བྲིས་ཡོད་ནའང་དེ་དག་ཐམས་ཅད་སྒྲིག་ལམ་ཞིག་གི་འོག་ནས་ཐར་མེད།",
    "ཡིན་ནའང་དེ་དག་གིས་ང་ལ་དུས་ཚོད་ཕར་སྐྱེལ་རོགས་བྱས་ཤིང་ང་ལ་ལས་རྒྱུ་ཞིག་ཡོད་པར་བྱས།",
    "གལ་སྲིད་དེ་དག་མེད་ནའང་ངས་ལས་རྒྱུ་གཞན་པ་བཙལ་ཁོ་ཐག་རེད།",
    "གཞན་པ་དེ་གང་ཡིན་ཞེ་ན་བདག་གིས་ཀྱང་གསལ་པོར་མི་ཤེས།",
    "དེ་དག་ལས་དཀའ་ཁག་ཆེས་ཆེ་ཤོས་ནི་བསམ་བློའི་སྐོར་གྱི་དཀའ་ཁག་དེ་རེད།",
    "རང་མི་མང་པོས་བདག་གི་གམ་ནས་ཡར་འགྲོ་མར་འགྲོ་བྱེད།",
    "ཁོང་ཚོ་རེ་རེར་མིང་རེ་ཡོད་སྲིད་པ་དང་ཁ་པར་ཨང་གྲངས་རེའང་ཡོད་སྲིད།",
    "དོན་དུ་མིང་དེ་དག་ཀྱང་ཁོ་ཚོ་མཚོན་བྱེད་ཀྱི་ཨང་གྲངས་རེ་རེ་རེད།",
    "འོན་ཀྱང་ངེད་ཅག་གིས་ཅིའི་ཕྱིར་དེ་མ་རེད་སྙམ་པ་རེད་ཅེས་ན་ཨང་གྲངས་ཀྱི་མིང་ལ་ཨང་གྲངས་ཟེར་བ་ལས་མིང་མི་ཟེར་བས་སོ།",
    "ཁྱད་པར་ཕྲ་མོ་ཙམ་གྱིས་མི་རྣམས་ཀྱི་སེམས་ལ་གོམས་གཤིས་ཤིག་ཆགས་པར་གྱུར།",
    "ཡིན་ནའང་བཙོན་མ་ཚོར་ཨང་གྲངས་རེ་རེ་ཡོད་པ་རེད།",
    "བཙོན་པ་ཚོར་མཚོན་ན་ཨང་གྲངས་ནི་ཁོ་ཚོའི་མིང་རེད།",
    "དོན་ངོ་མར་ཨང་གྲངས་རེད་དམ་མིང་རེད།",
    "ཨང་གྲངས་དང་མིང་གཉིས་ལ་ཁྱད་པར་མེད་པ་ཧ་གོ་ཚེ་དོན་དམ་བདེན་པའི་དོན་ཅུང་ཙམ་ཞིག་ཀྱང་ཞོར་དུ་རྟོགས་སོང་བ་འདྲ།",
    "མི་ཞིག་གི་མིང་ལ་བཀྲ་ཤིས་ཞེས་བཏགས་རྗེས་ཁོས་ཀྱང་རང་ཉིད་བཀྲ་ཤིས་ཞེས་པ་དེ་ཡིན་པར་སྙམ།",
    "ཁྱི་ཞིག་གི་མིང་ལ་བཀྲ་ཤིས་ཞེས་བཏགས་རྗེས་མིང་ལ་བཀྲ་ཤིས་རུ་འབོད་པའི་མི་དེས་དེ་ནི་ཁྱི་བཀྲ་ཤིས་ཡིན་པ་ལས་ཁོ་རང་མ་ཡིན་པར་སྙམ།",
    "དེ་བས་ཁྱི་ཞིག་ལ་ཇི་ལྟར་བཀྲ་ཤིས་ཞེས་བཏགས་ཀྱང་མི་རྣམས་ཀྱིས་ཁོ་རང་ཁྱི་ཡིན་པ་དེ་གཙོ་བོར་བྱས་འདུག་པ་དང་བཀྲ་ཤིས་ཡིན་པ་དེ་རྩེད་མོ་ཙམ་དུ་བཟུང་འདུག་ཉིན་ཞིག་བཙན་པོ་ཞིག་གིས་ཇ་ཕོར་ཞིག་གི་མིང་ལ་བཀྲ་ཤིས་ཞེས་གདགས་པར་བྱ།",
    "ཇ་ཕོར་བཅས་རེད།",
    "འོན་ཀྱང་མི་བཀྲ་ཤིས་དྲན་བཞིན་པའི་བཀྲ་ཤིས་ཀྱི་མཛའ་མོའི་སེམས་ན་བཀྲ་ཤིས་ཞེས་པ་ཞིག་ལ་ལེར་ཡོད།",
    "ང་ཚོ་འཇིག་རྟེན་དུ་སྐྱེས་པའི་མི་སུ་ཡིན་ཡང་ཉིན་ཞིག་གི་ཉིན་མོར་རང་གི་གཉེན་ཉེ་དང་གྲོགས་པོའི་མིག་ལམ་ནས་གཏན་དུ་ཡལ་འགྲོ་བ་རེད།",
    "ང་རང་ནམ་ཡང་གནས་གཅིག་ནས་གནས་གཞན་ཞིག་ཏུ་སོང་ནའང་ལྟེ་བའི་དཀྱིལ་འཁོར་དེ་བརྒལ་བའི་དུས་ནི་མེད་པ་འདྲ།",
    "གཉིད་མ་ཁུག་པའི་དུས་རེ་རེར་ང་རང་གྱང་དང་གྱང་ལྟ་བུའི་མུན་པ་ལ་ཅེར་བསྡད།",
    "གཞོན་ནུའི་དུས་ཀྱི་རང་ཉིད་དང་དེའི་མཐའ་འཁོར་དུ་ག་ཞ་དང་རྩེད་མོར་རོལ་བའི་ཆང་རྐྱལ་འགའ་ཡང་དྲན།",
    "ད་བར་དུ་མི་མང་པོས་ང་ལ་ཁོང་ཁྲོ་བསླངས་མྱོང་ནའང་ང་རང་ཕམ་པར་གཏོང་མཁན་གཅིག་ཡོད་པ་ནི་དུས་ཚོད་རང་རེད།",
    "གཞོན་ནུ་མའི་གདོང་གི་ཚོས་དཀར་བོ་དེ་གཉེར་མ་སྣ་ཚོགས་སུ་གྱུར་ཅིང་ཁོང་ཚོའང་བགྲེས་མོ་དག་ཏུ་གྱུར་ཏེ་བདག་གི་མཐའ་རུ་འདུས་པའི་ཚེ་ན་སའི་གོ་ལ་སྔར་བཞིན་འཁོར་གྱིན་ཡོད་སྲིད་དམ།",
    "སྲིད་ཀྱི་སྟེགས་བུ་ཆུང་ཆུང་ལ་འབྱར་བའི་སྲིན་འབུ་དག་གིས་འཇིག་རྟེན་འཇིག་བཞིན་པའམ་ས་རིམ་པ་དགུའི་གཏིང་འོག་ནས་མེ་རི་དྲག་ཏུ་འཕྱུར་ཡོང་བ་དེ་མཐོང་སྲིད་དམ།",
    "རྫུན་གྱི་མེ་ཏོག་ལ་བདེན་པའི་བུང་བ་འཁོར་ཅིང་དེས་སྐབས་ཤིག་གི་སྐྱིད་སྣང་བཙལ།",
    "གོང་གི་ཚན་པ་དེ་གཉིས་བྲིས་ཚར་རྗེས་ངའི་རྣ་ལམ་ལ་ཞེས་པའི་གཞས་ཚོགས་ཤིག་གི་རོལ་མོ་གྲག་གིན་ཡོད་ལ་རོལ་མོ་ནི་ངའི་ཁང་པའི་ནང་ནས་ཤོག་སྦག་བཞིན་གས་ཤིང་ངོ་གདོང་བཞིན་འབུར་ཡོང་བའི་དུས་སུ་ང་རང་གིས་བྲིས་པ་དེའང་རྫུན་གཏམ་ཞིག་ཡིན་པའི་ཚོར་བ་བྱུང་།",
    "མི་དང་མིའི་བར་གྱི་གཟབ་ནན་གྱི་སྤྱོད་པ་མཐའ་དག་རྫུན་གཏམ་གྱིས་མངོན་དགོས་པའི་དུས་སུ་ཀུ་རེ་རྩེ་བ་ནི་ཐབས་ཡག་ཤོས་ཤིག་རེད།",
    "དེ་བས་མི་ཆུང་འགས་ཀུ་རེ་རྩེ་བར་བརྟེན་ནས་མི་ཆེན་གྱི་ཞལ་ནས་འཛུམ་པའི་མདངས་ཤིག་མཐོང་བར་རེ་ཞིང་།",
    "གལ་སྲིད་མི་ཆེན་དགོད་ཁ་ཤོར་ཏེ་ཁོའི་གཟབ་ནན་གྱི་སྤྱོད་པ་ཞིག་པར་གྱུར་ཚེ་རྫུན་གཏམ་ཕ་རོལ་ཀྱི་ལྷོད་ཡངས་པའི་ཞིང་ཁམས་ཀྱིས་ཁོང་ཚོར་དུས་ཐུང་ཐུང་གི་རིང་ལ་སྤྲོ་དགའ་མི་ཟད་པ་ཞིག་འཁྱེར་ཡོང་བ་རེད།",
    "ཆང་དང་བུད་མེད་ལའང་བཀའ་དྲིན་ཞུ་མི་དགོས།",
    "བཀའ་དྲིན་ཞུ་དགོས་ས་ཉག་གཅིག་ནི་ཁྱོད་ཀྱིས་ངའི་དགོད་ཁ་སློང་བྱེད་ཀྱི་རྩ་རྒྱུས་དག་སྒུལ་ཐུབ་པ་དེ་རེད།",
    "བགད་བགད་པའི་རྗེས་སུ་ཁྱོད་ཀྱི་ལག་གི་མེ་མདའ་དེའང་མེ་ཏོག་ཅིག་ཏུ་མི་འགྱུར་བའི་ངེས་པ་མེད་ལ་འུ་ཅག་གིས་དུས་ནམ་ཡང་མ་ཎི་བཞིན་བཟླས་པའི་རྫུན་གཏམ་དེ་དག་ཀྱང་བདེན་པར་མི་འགྱུར་བའི་ངེས་པའང་མེད།",
    "སྐད་ཆ་ལྐུགས་འགྲོ་ཡི་རེད།",
    "ཤིན་ཏུ་ཕྲ་བ་དག་གི་མདུན་དུ།",
    "མིག་གི་བྱེད་ནུས་ནི་ཉམས་འགྲོ།",
    "ཉིན་མོ་རྣམ་རྟོག་དང་འགྲོགས་ནས་གྲོག་མ་བཞིན་འདུར་ནའང་རྨི་ལམ་དུ་ཅི་ཡིན་ཆ་མི་འཚལ་བ་དག་གིས་གཙེ་བར་བྱེད།",
    "ཐམས་ཅད་རང་སོར་ཡོད་འདྲའི་སྣང་བ་སྐྱེ་ནའང་ཁ་སང་གི་འཆར་གཞི་ལས་མང་པོ་བོར་འགྲོ།",
    "ཡོད་པའམ་མེད་པ་གང་དུ་ངེས་ཀྱང་རུང་གིས།",
    "དེས་ཁྱོད་ལ་ཐ་སྙད་ཀྱི་ཁ་ཟས་སྦྱིན་པ་མ་ཡིན་ནམ།",
    "དེས་ཁྱོད་ལ་ཡི་གེ་དང་བརྡ་རྟགས་སྦྱིན་པ་མ་ཡིན་ནམ།",
    "དེ་ཉིད་ངོས་མ་ཟིན་གོང་གི་རྣམ་རྟོག་ཅིག་ལས་གཞན་ཅི་ཡང་ཡིན་པ་མ་རེད།",
    "དེའང་ཡོད་དམ་མེད་པའི་བློ་དེ་མ་ཤི་བའི་སྔོན་དུ་ལས་ཤི་རྗེས་སུ་ཅི་འདྲར་གྱུར་འགྲོ་བ་སུས་ཀྱང་ཤེས་ཐབས་མེད་པ་རེད།",
    "བདག་གིས་བསམ་ན།",
    "མེད་པའང་མི་ཤེས་ཏེ་མ་གཞི་ངེད་ཅག་འགྲོ་བ་མིའི་རིགས་ནི་འཆི་བའི་སྐོར་ལ་ཤེས་བྱ་ཕྲན་ཚེགས་ཙམ་ཡང་མེད་པའི་འགྲོ་བ་ཉམ་ཐག་ཅིག་རེད་སྙམ།",
    "འདི་ནི་བདག་གི་ལྟ་ཚུལ་ཕྲན་བུ་ཙམ་ལས་གཞན་ཅི་ཡང་མིན་ཏེ།",
    "བདག་གིས་འཆི་བའི་སྐོར་གྱི་བསམ་ཚུལ་ཐུང་ངུ་ཞིག་སྤེལ་བར་ཀློག་མཁན་འགའ་ཞིག་གོ་བ་གཏིང་ནས་ལོག་འདུག་དེའང་ཁག་མི་འདུག་རང་རེ་སུ་ཡིན་ཡང་འཇིག་རྟེན་གྱི་གྲགས་པ་དང་ལུང་གི་རྗེས་སུ་རྒྱུག་པ་ལས་རང་ངོས་ནས་བསམ་བློ་གཏོང་བའི་སྲོལ་མེད་པ་རེད་ལ་བརྡ་དོན་རེ་རེར་གོ་བ་ཕྲ་མོར་ལེན་པའི་ནུས་པའང་ཡོད་པ་མ་རེད།",
    "བདག་གིས་འཆི་བ་ཉིད་དོན་དམ་ཅི་འདྲ་ཞིག་ཡིན་པ་མི་ཤེས་པ་དེ་གླེང་བྱ་གཙོ་བོ་བྱས་ཡོད་ཅིང་།",
    "དེ་ནི་གཙང་བོ་ཞིག་གི་ཕ་རོལ་དང་ཚུ་རོལ་དང་འདྲ་སྟེ།",
    "ངས་ཁྱོད་བསྐྱར་དུ་བཞེངས་པར་བྱ།",
    "ཡི་གེའི་ནགས་ཚལ་དེ་ནས་ངས་རང་གིས་རང་ལ་གཟེབ་ཅིག་བཟོས་ཟིན།",
    "སྒྲུང་ཐུང་ཞིག་ཡང་ཡང་བཅོས་ཏེ་སྡོད་པ་ནི་བྱིས་པའི་ལག་ནང་གི་འགྱིག་རྩོམ་དེ་དབྱིབས་དང་རྣམ་པ་མང་པོར་བསྒྱུར་བ་དང་འདྲ་སྟེ།",
    "ཅི་ཞིག་བྲིས་ན་ད་གཟོད་ང་རང་གི་སེམས་ཀྱི་ཟ་ས་དེ་ལ་འཕྲུག་ཐུབ་པར་ཡང་བསམ་བློ་ཡང་ཡང་བཏང་།",
    "གཞན་པ་དག་གིས་བོད་ཡིག་ལ་བརྟེན་ཏེ་ཅི་ཞིག་འབྲི་བཞིན་འདུག་ཅི་ཞིག་ཤོད་ཀྱིན་འདུག་ཤོད་ཀྱིན་པ་དེ་ཤོད་དགོས་པ་དེ་རེད་དམ།",
    "མ་ཤོད་པ་གང་དག་ཅིག་ལུས་འདུག་དེ་ལྟར་བསམ་བཞིན་དུ་དུས་ཚོད་ཀྱིས་འཁྲིད་ཀྱིན་པའི་ཉིན་རེ་རེའི་དོན་རྣམས་མཐོང་བྱུང་བ་དང་།",
    "སྙན་ངག་སོགས་སོ་སོར་ཕྱེ་བའི་རྟགས་ཐམ་དེ་ལ་འཇུས་ནས་ཕྱིའི་རྣམ་པའི་རྩེད་མོར་འཇུག་པ་མཐོང་དུས།",
    "བུད་མེད་དང་སྐྱེས་པའི་བར་གྱི་འབྲེལ་བ་ནི་སྔར་བཞིན་དེ་ལྟར་ཡོད་པ་མཚོན་ཡོད་པ་དང་།",
    "ངས་རང་གི་སྨྱུག་འོག་གི་པར་མིག་དེ་ནི་མང་མང་གིས་ལྕེ་ཡིས་བལྡད་དེ་བསྙད་པར་བྱས་ཡོད་པའི་དོན་དེ་དག་དང་།",
    "མང་མང་གིས་བལྟས་ཏེ་མི་སྡུག་པར་བཏང་ཡོད་པའི་དོན་དེ་དག་ལ་གཏོད་མི་འོས་པར་སྙམ།",
    "ཁ་གཡང་དང་དམོད་ཚིག་གང་ཡིན་ཡང་ལྕེ་ཡི་རང་བཞིན་འགྱུར་བར་བྱས་རྗེས་སུ་བྱུང་བའི་སྐད་ཆ་ཡིན་ཏེ།",
    "མཚམས་ལ་ལར་རང་གི་སེམས་ལ་བདག་པོ་རྒྱུག་མ་ཐུབ་པར་བྱུང་བའི་ཁྲོ་བ་དང་འཚིག་པ།",
    "རེས་འགར་ཁྲོམ་སྲང་ན་གློག་བཞུ་ཆལ་ཆིལ་གྱིས་བརྒྱན་པའི་བསླུ་བྲིད་ཀྱི་ཚིག་ཕྲེང་།",
    "ཡང་སྐབས་འགར་ལུང་པ་ཆུང་ཆུང་གི་ར་བ་སྲུང་བྱེད་ཀྱི་མི་སྐད་དམ་མི་དང་མིའི་བར་ལ་བསམ་བཞིན་ལྕགས་རི་རྩིག་འདོད་ཀྱི་འདུན་པ་ཉམ་ཆུང་།",
    "དེ་ནི་སྤོབས་པ་མཐའ་དག་ལས་སྟོབས་དང་ལྡན་པ་ཞིག་རེད་དེ།",
    "ལྷིང་འཇགས་ནི་ཆེས་སྙན་པའི་རོལ་མོ་ཡིན་པ་དང་།",
    "གཅིག་བྱས་ན་འགལ་འདུའི་སེམས་ཁམས་དེ་ཁོང་གིས་རང་སྲོག་གཅོད་བྱེད་ཀྱི་དངོས་རྒྱུའམ་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་གང་རུང་ཞིག་ཏུ་གྱུར་ཡོད།",
    "དེ་ལྟར་བྱས་ཚེ་ཁོང་གི་སེམས་ཀྱི་འགལ་འདུ་དང་།",
    "དམངས་ཀྱིས་སྐྱེ་བོ་དམ་པར་བཀུར་བའམ་མཚན་སྙན་གྱིས་ཀུན་ནས་གྲགས་པའི་སྐྱེས་བུ་འགའ་ཞིག་གི་སྐྱོན་དང་ཉེས་པ།",
    "སྐབས་ཤིག་གི་བསམ་ཚུལ་ཤར་མར་འཁྱུག་པ་ཙམ་མོ།",
    "སྤྱིར་རང་ཅག་གིས་རིགས་པ་དང་།",
    "ང་ལ་ཡོད་པའི་བརྡ་རྟགས་དེ་འདྲ་ཁྱོད་ལ་མེད་ཚེ་འུ་གཉིས་ཀྱི་བར་དུ་བརྡ་གཏོང་ཐབས་བྲལ་བ་རེད།",
    "དེ་བས་རང་ཅག་གིས་འཇིག་རྟེན་འདིའི་ངོ་བོར་འགྲེལ་བརྒྱབ་པ་ནི་ཁ་པར་གྱི་བརྡ་རྟགས་དེ་ཡོད་ངེས་པ་གཞིར་བྱས་པ་འབའ་ཞིག་ཡིན་ལ།",
    "གལ་ཏེ་དེ་ཉིད་ཆད་པར་གྱུར་ཚེ་གནས་ལུགས་ཀྱང་ཆད་པར་འགྱུར་བ་རེད།",
    "རང་གི་སྣང་བའི་ཡུལ་དུ་གྱུར་བའི་ཤེས་བྱ་ཐམས་ཅད་ལ་དོགས་པ་བསླང་སྲིད་པ་རེད།",
    "མི་ཤེས་པར་འགྱུར་བ་ཞིག་ཡོད་པ་ནི་མི་དང་མིའི་བར་དུ་བརྡ་སྤྲོད་བྱེད་ཀྱི་སྐད་ཆ་ཞེས་པ་འདི་རེད།",
    "ཚན་རིག་སོགས་ཐམས་ཅད་སྐད་ཆ་ལས་བརྒྱུད་པ་དང་གོམས་པའི་མཐུ་ཡིས་གནས་ལུགས་སུ་གྲུབ་པ་མཐའ་དག་ཀྱང་སྐད་ཆས་བཟོས་པ་རེད།",
    "དེ་བས་འུ་ཅག་གིས་རང་གི་འགྲོ་འདུག་ཉལ་འཆག་སོགས་སྐད་ཆས་མཚོན་པར་ནུས་ཀྱང་འཇིག་རྟེན་གྱི་མཐའ་དང་།",
    "འཆི་བ་སོགས་ལྐོག་ཏུ་གྱུར་བའི་དོན་རྣམས་ལ་འཕྲད་དུས་དེ་ཉིད་ནུས་མེད་ཉམ་ཆུང་གི་ངང་དུ་ཁེགས་འགྲོ་བ་རེད།",
    "དེ་བས་བདག་གིས་སྐབས་འགར་མིའི་རིགས་ལ་སྐད་ཆ་མ་ཡིན་པའི་གནས་ལུགས་ཟེར་བ་ཞིག་ཨེ་ཡོད་སྙམ་ལ་སྐད་ཆར་དོགས་པ་སློང་བྱེད་ཀྱི་རྩོམ་དག་ཀྱང་སྐད་ཆར་མ་བརྟེན་ན་འབྲི་ཐབས་བྲལ་བས་འཇིག་རྟེན་གྱི་རིགས་པ་འདི་ཉིད་ཁུངས་མེད་ཅིང་གཏད་སོ་བྲལ་བ་ཞིག་ཏུ་ཡང་ཡང་འདོད་བྱུང་།",
    "སྙན་ངག་གི་སྐོར།",
    "སྙན་ངག་བྲི་རྒྱུ་ནི་ལས་ཀ་གཞན་གང་གིས་ཀྱང་ཚབ་བྱེད་མི་བཏུབ་པ་ཞིག་ཏུ་འཁུམས་ཀྱང་བྲིས་ཚར་རྗེས་དེའི་སྐོར་རྨང་ནས་བརྗེད་འགྲོ་སྟེ།",
    "འདི་ནི་ཁོ་བོས་ད་སྔ་བར་བཀླགས་པའི་བོད་ཀྱི་བརྩམས་སྒྲུང་ལེགས་ཤོས་ཤིག་ཏུ་སེམས་པས་སེམས་རྣལ་མོས་བོད་ཡིག་ཏུ་བསྒྱུར་བ་ཡིན་ལ།",
    "རྩོམ་མཁན་ཁོང་གི་ཐུགས་དགོངས་དང་མ་རྩོམ་གྱི་མཛེས་པ་མི་ཤོར་བ་གཞིར་བྱས་ཏེ་བོད་ཡིག་གི་ཀློག་མཁན་ཚོར་ཀློག་བདེ་བ་དང་ཀློག་སྤྲོ་བ་ཞིག་ཡོང་བ་ལོ་ཙཱའི་དམིགས་ཡུལ་དུ་བཟུང་ཡོད།",
    "ཧམ་སེམས་དང་བྱམས་སེམས་སོགས་ཀྱི་བར་ན་གསལ་ལེར་ཡོད་པའི་མགོ་ནག་བོད་པ་ཚང་གི་སྤང་བླང་དང་ཀུན་སྤྱོད་ཀྱི་ཐིག་རིས་གསལ་ལེར་མཐོང་བར་བྱེད་ཅིང་།",
    "མི་སྣའི་ནང་སེམས་ཀྱི་འཇིག་རྟེན་ཞིབ་མོར་འབྲི་བ་ལ་ཀུན་ནས་བྱང་བས་གཞན་གྱི་མཐོང་སྣང་གི་རྙོག་འཛིང་ཆེ་ཞིང་ཤེས་སུ་མི་བཏུབ་པའི་བརྗོད་བྱ་དག་ལག་མཐིལ་གྱི་སྐྱུ་རུ་ར་རློན་པ་བཞིན་ཀློག་མཁན་གྱི་མཐོང་ལམ་དུ་གསལ་བོར་བསྐྱལ་ཡོང་།",
    "གཞུང་གི་ལས་བྱེད་གསུམ་ཀས་ཁོང་ཅག་གསུམ་པོ་གསོ་མཁན་ནམ་ཡང་ན་གཞིས་ཀྱི་བདག་པོ་ངོ་མ་སྟེ་ཡུལ་མི་རྣམས་ལ་མང་ཚོགས་ཟེར་བའི་སྲིད་ཀྱི་ཐ་སྙད་ཅིག་གིས་དམའ་འབེབས་པར་བྱེད་ཅིང་།",
    "ཁྱོད་ཀྱི་ལུས་སེམས་གཉིས་ཀ་རྒྱ་ཁ་རོང་ཁའི་ཟས་སྙིགས་དང་རྫུན་གཏམ།",
    "ལས་འབྲས་རྩི་ཞིང་དགེ་སྡིག་གི་སྤང་བླང་གསལ་བ་སོགས་གནའ་ནས་བརྒྱུད་པའི་གཤིས་ཀ་དག་གི་མདུན་ནས།",
    "དེ་མིན་པར་ཡི་གེ་ཤེས་མིན་ཙམ་དང་ཆ་ལུགས་གཙང་མིན་ཙམ་ཚད་ཤིང་དུ་བཟུང་ནས་འབྲོག་པ་ཡིག་རྨོངས་པ་ཚོ་ཞེས་བསྡིགས་ཚེ་གྲི་ལེབ་ཆེན་གཅིག་གིས་ཁྱོད་མདུན་གྱི་རྩྭ་ལྗང་དག་དུས་གཅིག་ཏུ་བཞར་སོང་བ་དང་འདྲ།",
    "དེ་བས་ངེད་ཅག་གིས་སྔོན་ཀྱི་རུ་སྐོར་ཟེར་བ་དེ་མཐོང་མི་སྲིད་ལ།",
    "བྱིས་པ་དག་གིས་ཁྱིམ་མཚེས་ཀྱི་རྩེད་རོགས་འཚོལ་བ་དེའང་ཤིན་ཏུ་དཀའ་བར་འདུག་རེད་དེ།",
    "དེ་བས་ད་ལྟ་འབྲོག་ཁྱིམ་མང་པོ་ཞིག་གིས་ཚོད་མེད་པར་ཕྱུགས་ཟོག་མང་དུ་སྐྱོང་བ་དང་།",
    "དེ་དག་ལྕགས་རའི་ནང་གི་རྩྭས་མ་འདང་ཚེ་ཡུལ་གཞན་ནས་ས་གླས་ཏེ་སྐྱོང་བ་ཤིན་ཏུ་མང་།",
    "དམ་ཚིག་སྲུང་ཞིང་ལས་འབྲས་རྩི་མཁན་ཤ་སྟག་སྟེ་ཁོང་ཚོས་མཁས་པ་ཞེས་པའི་སྟེང་དུ་ད་དུང་བཙུན་པ་དང་བཟང་བ་ཞེས་པ་ཞིག་ལ་བརྩོན་སྲིད་པར་གཞིགས་ན་ད་ལྟ་མ་བརྟག་མ་དཔྱད་པར་བྱུང་རྒྱལ་དུ་སྡོམ་ཚིག་ཆེན་པོ་འགོད་མཁན་ཚོས་རང་མགོ་གཡོག་བྱེད་ཀྱི་རྩེད་མོ་ཅི་འདྲ་ཞིག་རྩེ་བཞིན་པ་ཤེས་ནུས།",
    "ཁོ་བོས་ཀྱང་བཀྲ་རྒྱལ་ལྟར་རྙིང་པས་རྒྱུད་པ་མཚོན་ཞིང་གསར་པས་དར་བ་མཚོན་པ་རེད་སྙམ་པའི་དོན་སྤྱི་རིལ་མོ་ཞིག་བཙན་ཐབས་ཀྱིས་བཙིར་ནས་གསར་པ་མིན་ན་རྙིང་པ་ཡིན་དགོས་པ་དང་རྙིང་པ་མིན་ན་གསར་པ་ཡིན་དགོས་པར་འདོད་མོད་གནས་ལུགས་ཀྱི་ཁམས་ཆེན་པོ་དེ་དང་མྱོང་བའི་ཀློང་ཡངས་པོ་དེ་ཡིས་བརྟག་ཅིང་དཔྱད་པར་བྱས་ཚེ་གསར་རྙིང་གཉིས་ཀ་ནི་ཕན་ཚུན་རྐྱ་འཐབ་པའི་གོང་བུ་གཅིག་ལས་སོ་སོར་དབྱེ་རུ་མེད་པ་དེ་གསལ་བོར་ཤེས་བྱུང་།",
    "དེའི་ཕྱིར་གསར་པར་ཁ་གཡར་ནས་རྙིང་པ་ཡོད་ཚད་བརླག་རྒྱུ་ཟེར་བ་ནི་ན་ཙེ་དང་རིག་གསར་གྱི་ལས་འགུལ་ཁོ་ནའི་བསྒྲུབ་བྱ་ཉག་གཅིག་ཡིན་པའང་ཞོར་དུ་རྟོགས་སོང་།",
    "ཡང་ན་རྩེད་མོ་ཙམ་ལ་དགའ་མཁན་ཁོ་ན་རེད་དོ།",
    "རང་གིས་མ་འཁྱོངས་པ་དེ་གཞན་མགོར་དཀྲི་རྒྱུར་གོམས་ཡོད་པ་སོགས་སོ།",
    "ཁོ་ཚོས་ཁ་ནས་དཀྱེལ་ཡངས་དགོས་ཞེས་ལབ་ནའང་དོན་དུ་དཀྱེལ་ཡངས་མི་ཐུབ་པར་ལག་པ་གཅིག་གིས་གནམ་འགེབས་པ་དང་།",
    "དེ་དག་དང་བསྡུར་ཚེ་ངུར་སྒྲིག་གི་ན་བཟའ་གསོལ་ཏེ་དཀྱིལ་མོ་ཀྲུང་གིས་མེས་པོའི་ཤུལ་དངོས་སྲུང་བཞིན་པའི་འདུལ་འཛིན་པ་དག་ནི་ཅི་འདྲའི་རླབས་ཆེ་བ་ལ་བསམ་གྱིན་ཡོད།",
    "ཡིན་ནི་ཡིན་ཏེ་ཕ་ཤུལ་བུ་ཡིས་མི་ཟིན་མཁན་ཚོས་ནི་ནམ་ཡང་རང་གི་ཨ་མ་དེ་ཕར་ལ་གཡུག་ནས་ཨ་མ་གསར་བ་ཞིག་བཙལ་སྲིད་དོ།",
    "༥༥ ག་བོད་ཀྱི་རོལ་མོའི་བླ་སྲོག་ག་བར་ཡོད།",
    "ལོ་འདི་དག་གི་རིང་ལ་ཁོ་བོའི་མཐའ་འཁོར་དུ་སྐད་ངག་བདེ་ཙམ་ཡོད་པ་ནས་གླུ་པ་བྱེད་འདོད་ཀྱི་འདུན་པ་འཕེལ་བཞིན་པའི་སྐྱེས་ཕོ་མོ་མང་དག་ཅིག་བྱུང་ཞིང་ཁོ་ཚོས་མི་སྒེར་གྱི་འབྲེལ་བ་ཁོ་ན་བརྒྱུད་ནས་རྩོམ་པ་པོ་ཚོར་གླུ་ཚིག་སློང་བ་དང་དབྱངས་མཁན་ཚོར་དབྱངས་སློང་བ།",
    "མ་འོངས་པའི་མདུན་ལྗོངས་སོགས་དང་འབྲེལ་བ་སྤུ་ཙམ་ཡོད་པ་ལྟ་ཅི་ཐ་ན་ལེན་མཁན་རང་གི་འཚོ་བ་དངོས་དང་དགའ་སྐྱོ་ཆགས་སྡང་ལའང་འབྲེལ་བ་གཏན་ནས་ཡོད་པ་མ་རེད།",
    "དེའི་ཕྱིར་ཁོ་ཚོ་ནི་མི་ཆེན་དཔོན་ཆེན་ཚོའི་མིག་སྔར་བཤམས་རྒྱུའི་ལུད་རྫས་སུ་གྱུར་ཏེ་མི་མང་གི་འདུ་ར་གང་དུ་ཆེ་ན་དེ་རུ་སླེབས་ཡོད་པ་རེད།",
    "སྤྲིན་དཀར་སོགས་ཐ་སྙད་སྐམ་པོ་དག་གི་ཚབ་བྱེད་སྤྱད་ཅིག་ཏུ་ངོས་འཛིན་པའི་ད་ལྟའི་ཡ་མ་གཟུགས་ཀྱི་སྣང་ཚུལ་དེའང་གཞི་ནས་ཆགས་ཐུབ་པར་གྱུར།",
    "རང་རེའི་གླུ་པ་དེ་ཚོས་མིག་གིས་འཛམ་གླིང་མི་མཐོང་ཞིང་སེམས་ཀྱིས་རང་ཉིད་མི་རྙེད་པར་སྐད་མགོ་སུ་མཐོ་འགྲན་པ་ལྟར་ཨེ་མ།",
    "ང་རང་ཁྱེད་ལ་དགའ་ཞེས་བླངས་པ་ནི་བོད་མིའི་ལྷིང་འཇགས་ཀྱི་སེམས་ལ་བཙན་གཡེམ་བྱས་པ་དང་བོད་ཀྱི་རི་ཆུ་ནགས་གསུམ་གད་སྙིགས་ཀྱིས་བཙོག་པོར་བཏང་བ་ཞིག་རེད།",
    "དེའི་ཕྱིར་ང་ཚོ་དང་ཆེས་རྒྱང་ཐག་རིང་བ་ནི་བརྩེ་བ་རྣལ་མ་དང་།",
    "དེའི་རྗེས་སུ་ང་ཚོས་ཕན་ཚུན་གྱི་བར་ཏུ་ཞེ་སྡང་རྩོད་བཞིན་ཧ་ཅང་གུ་དོག་པའི་མི་སྒེར་གྱི་བཙན་ས་རེ་འཛིན་པ་རེད།",
    "མཛེས་སྡུག་སོགས་ཀྱི་མཚོན་བྱེད་དུའང་འགྱུར་བ་རེད།",
    "འོན་ཀྱང་རང་རེའི་གླུ་བ་ཚོས་ནི་དེ་ལྟ་བུའི་ནུས་པ་འདོན་ཐུབ་པ་ཕར་ཞོག་ཐ་ན་ཁོ་ཚོ་རང་ཉིད་ལའང་ས་པཎ་གྱི་རོལ་མོའི་བསྟན་བཅོས་སུ།",
    "ཞེས་པའི་སྐྱོན་དེ་དག་ལྡན་པ་རེད།",
    "བོད་ཀྱི་རོལ་མོའི་བླ་སྲོག་ག་བར་ཡོད།",
    "གློག་འོད་ཆལ་ཆིལ་དེ་དག་དང་བསྡུར་ན་ལྷ་ས་ནི་མདང་དགོང་གཙང་གི་ཨ་ཅག་རྩོམ་པ་པོ་དེས་བཏང་བའི་གཞས་ཀྱི་འགྱུར་ཁུགས་དེ་ཡིན་སྲིད་ལ།",
    "ཁྱོད་ཀྱིས་སེམས་ནང་ན་ཡོད་པ་མཐའ་དག་ཤིན་ཏུ་ཐག་ཉེ་བའི་གནས་ན་ལྷ་ཚོགས་ཀྱི་དཀྱིལ་འཁོར་ལྟར་ཁྲ་ལམ་མེར་ཡོད་ཀྱང་།",
    "སྲིད་དང་དུས་འཁྲུག་གི་རྩེད་མོས་ཀུན་ཏུ་ཕམ་པའི་སྐུ་དྲག་དག་གི་ཕྱི་རབས་པའམ།",
    "སྐུད་པ་དེ་དག་ང་རང་ཡོད་ས་ལས་མཐོན་པོར་ཡར་འཕགས་བཞིན་འདུག་ལ་དེ་དག་གི་སྣེ་གཅིག་ནི་དབྱིབས་དང་ཁ་དོག་རི་མོ་བཅས་ཐ་དད་པར་ཡོད་པའི་ཤོག་བྱ་སྣ་ཚོགས་ཡིན་པ་དང་།",
    "སྣེ་གཞན་དེར་ཆ་མེད་རྒྱུས་མེད་དུ་གྱུར་བའི་སྐྱེས་ཕོ་མོ་སྣ་ཚོགས་འཇུས་འདུག་དར་ཚོན་སྣ་ལྔ་ལྟ་བུའི་ཤོག་བྱ་དེ་དག་དང་ལྷན་ཅིག་ངའང་ཆུ་ཁའི་ལྕི་བ་བཞིན་བར་སྣང་ལ་གཡེང་བསྡད་ཀྱང་།",
    "མུན་པའི་དབྱིངས་ལ་རབ་ཏུ་འདྲེས་པའི་ཤོག་བྱ་ནག་པོ་ནག་རྐྱང་ཞིག་གིས་ང་རང་མར་མནན་ནས་དབུགས་ཀྱང་ལེན་དཀའ་བར་བྱས།",
    "སྐབས་དེར་ངས་ཁ་སང་གནམ་མཚོར་འགྲོ་དུས་སུ་ངེད་ཅག་གི་བྷ་སིའི་ནང་ནས་དུས་ངེས་མེད་དུ་དབྱང་དབུགས་འཇིབ་པའི་ཐེན་ཅིང་གི་རྩོམ་པ་པ་དེ་ཡིད་ལ་དྲན།",
    "གལ་ཏེ་སྐབས་འདིར་ཁོའང་ང་དང་མཉམ་དུ་བར་སྣང་ན་ཡོད་ན་ཁོའི་བརྩམས་སྒྲུང་གི་གཏམ་རྒྱུད་དང་སྒྲོམ་གཞིའི་རྒྱུ་ནི་ཇི་ལྟར་བསྐྱེད་སྲིད་དམ།",
    "ཁོས་གདོང་ལྷ་སའི་ཕྱོགས་སུ་མི་གཏད་པར་ཁ་ཕྱིར་འཁོར་ཏེ་ཡངས་པའི་འཇིག་རྟེན་ཆེན་པོར་གཏད་ཚེ་ཐག་རིང་གི་རྒྱུ་སྐར་བྱེ་བ་ཁོའི་སེམས་ནང་ལ་ལྷུང་སྲིད་དམ།",
    "ང་རང་གཉིད་མ་སད་ཀྱི་སྣང་བ་དེ་དང་ལྷན་ཅིག་བར་སྣང་ནས་མར་བབས་ཏེ་བར་སྐོར་ལ་སོང་ཞིང་།",
    "དེ་ནས་ར་མོ་ཆེའི་སྲང་ལམ་གྱི་ཆང་ཁང་ཞིག་ཏུ་སོང་།",
    "ཆང་ཁང་དེའི་ནང་གི་ལྷ་སའི་སྦི་རག་གི་རིན་གོང་ནི་ཆང་ཁང་སྤྱིར་བཏང་བ་དག་ལས་ལྡབ་བཞིའམ་ལྔ་ཡིས་ཆེ་ལ་བཟི་ཁའང་དེ་ལས་བཙན་པའི་སྣང་བ་བྱུང་།",
    "ངའི་ཁ་གཏད་དུ་སྟོད་ཐུང་སེར་ནག་བལ་གྱི་ནང་མ་དང་གོང་བ་ཅན་གྱོན་ཅིང་རྣ་བ་གཡས་གཡོན་གཉིས་ཀར་གསེར་གྱི་རྣ་ལོང་ཆུང་བ་གསུམ་རེ་བཏགས་པ་ཞིག་བསྡད་འདུག་ལ་མོས་ཨ་རིག་མི་འཐུང་བར་མེ་ཏོག་མ་ལི་ཀའི་ཇ་ཞིག་འཐུང་བཞིན་ཇ་འདིར་གོང་ཆེ་བ་ལ་ཨང་ཟེར།",
    "ཞལ་དཀར་གཅིག་གིས་བཟི་སོང་ཞེས་པའི་ཚིག་དེ་དྲན་གྱིན་མོ་ལ་སྐད་ཆ་མང་པོ་ཞིག་བཤད།",
    "རྨི་ལམ་ནང་གི་ཆང་ཁང་དེ་ནི་ངའི་མི་ཚེའི་ནང་འགྱུར་བ་ཆེན་པོ་ཡོང་བྱེད་ལ་ཆེད་དུ་བཟོས་པ་དང་དེའི་ཇ་ཆང་གི་རིན་གོང་མཐོན་པོ་ཡིན་དོན་ཡང་དེར་བསྐྱལ་བའི་དུས་ཚོད་ཉིད་རྩ་ཧ་ཅང་ཆེ་བ་དང་འབྲེལ་བ་ཡོད་པར་སྙམ།",
    "གལ་ཏེ་ངའི་མི་ཚེའི་ནང་གི་དུས་ཚོད་གཞན་དག་ནི་བལ་དང་རྒྱུན་བུས་བསྒྲིམས་པའི་ཐག་པ་རིང་པོ་ཞིག་ཡིན་ན་ཆང་ཁང་དེའི་ནང་གི་དུས་ཚོད་ནི་གསེར་དངུལ་གྱིས་བསྒྲིམས་པ་ཁོ་ན་སྟེ།",
    "ངས་ཆང་ཁང་དེའི་ནང་གི་སྦི་རག་ནི་ལྷ་ས་ཡོངས་ལས་བཟི་དུག་ཆེ་ཤོས་ཡིན་པ་དང་།",
    "དེ་བཏུང་རྗེས་སུ་སེམས་པའི་རྟ་ཕོ་ཉིད་སྲབ་ལས་ཤོར་ཏེ་བརྩེ་དུང་གི་སྐྱེད་ཚལ་ཆེན་པོ་ཞིག་ཏུ་རྒྱུགས་མི་འཇུག་ཀ་མེད་བྱུང་།",
    "དེ་དུས་ངས་མོའི་གདོང་གི་མཛེས་པ་དང་ལུས་ཀྱི་ལྷོད་པའི་སྟང་སྟབས་དེ་མཐོང་མ་བྱུང་ལ་མོའི་སེམས་ནང་གི་འཇིག་རྟེན་ལ་ཉེ་བར་བཅར་བའི་གོ་སྐབས་ཀྱང་མ་བྱུང་།",
    "སྤྲུལ་སྒྱུར་གྱིས་ཆང་ཁང་ཞིག་བཟོས་ཏེ་མོ་རང་དེའི་ནང་ལ་ཡོང་བཅུག་པ་མ་ཡིན་ནམ།",
    "ལྷ་སའི་སྦི་རག་གི་ལ་སི་རེ་རེ་དང་ལྷན་དུ་ངའི་སུན་སྣང་མཐའ་དག་རྨང་ནས་སེལ་ནའང་མོ་དང་འབྲལ་དོགས་ཀྱི་ཚོར་བས་ང་རང་སྡུག་བསྔལ་གྱིས་ཀུན་ནས་བསྐོར་བར་གྱུར།",
    "ངས་མོའི་རྗེས་འདེད་པར་རྩོམ་དུས་མི་སྣང་བར་གྱུར།",
    "ང་རང་གནམ་ཐང་དུ་སྐྱེལ་བར་ཡོང་བའི་སྤུན་ཡ་དེས་ཀྱང་མགྲོན་ཁང་གི་སྒོ་མོ་ཐག་ཐག་ཏུ་རྡུང་གིན་འདུག་༢༡༦ལོའི་ཟླ་༡པའི་ཚེས་༡༧ཉིན།",
    "མཇུག་གི་གཏམ།",
    "གུས་ཕྲན་ངས་དེ་སྔོན་དུས་ཚོད་ཡོད་ཚད་གསར་རྩོམ་དང་རྣམ་གཡེང་གི་ངང་དུ་བསྐྱལ་དགོས་ཞེས་པའི་ཚིག་གཅིག་སྨྲས་མྱོང་།",
    "ཡང་ན་སེམས་ལ་ཅི་དྲན་གང་དྲན་དུ་བྱུང་བའི་དོན་རྣམས་སྒྲོམ་དང་སྒྲོག་གིས་མ་བཅིངས་པར་ཡིག་ངོར་འབེབས་པ་སོགས་ལ་གོ་ཞིང་།",
    "རང་རེའི་སྐད་དུའང་རྩོམ་ལུས་འདིའི་མཚན་ཉིད་དམ་འདི་དང་རྩོམ་ལུས་གཞན་བར་གྱི་དབྱེ་མཚམས་ནི་དེ་འདྲའི་གསལ་པོ་མེད་པས།",
    "རྩོམ་རིག་དཔྱད་བརྗོད་པ་གྲགས་ཅན་ཝལ་ཁྲིར་སྦེན་ལྔ་མེན་མཆོག་གིས་ཕྱོགས་གཅིག་བགྲོད་ལམ་ཞེས་པའི་དེབ་ཀྱི་ནང་དུ་ལྷུག་རྩོམ་ཡག་པོ་ཞིག་བྲི་བར་ཐེམ་པ་གསུམ་བརྒལ་དགོས་ཤིང་།",
    "དེ་དག་ནི་རོལ་མོའི་ཐེམ་པ་དང་།",
    "འཁེལ་འཐག་གི་ཐེམ་པ་བཅས་ཡིན་པར་གསུང་།",
    "འདི་ལས་ལྷུག་རྩོམ་བྲི་བ་ནི་ལས་སླ་མོ་ཞིག་མིན་པ་ཤེས་ལ་བརྗོད་བྱ་དོན་གྱིས་བྱུར་བུར་གཏམས་ཤིང་རྗོད་བྱེད་ཚིག་གི་སྙན་ཆ་རྫོགས་པའི་ལྷུག་རྩོམ་ཞིག་བྲི་བ་ནི་དེ་ལས་ཀྱང་ལས་སླ་མོ་ཞིག་མིན་པ་ཤེས་སོ།",
    "གང་ལྟར་རང་རེའི་སྐད་དུ་ལྷུག་རྩོམ་ཟེར་དུས་དབྱིན་སྐད་ཀྱི་དང་ལྟ་བུའམ་རྒྱ་སྐད་ཀྱི་",
    "ཟེར་བ་ལྟར་གོ་དོན་འཕྲལ་མར་ཡིད་ལ་ཤར་བ་ཞིག་ཡོང་གི་མི་འདུག་ཅིང་།",
    "དེ་ནི་རང་རེས་རྩོམ་རིག་གི་རྩོམ་ལུས་བྱེ་བྲག་པ་རྣམས་སོ་སོར་འབྱེད་དུས་བོད་སྐད་ཀྱི་རྩོམ་ལུས་སྣ་ཚོགས་ལ་ཞིབ་མོར་མི་དཔྱད་པར་སྐབས་འགར་དབྱིན་སྐད་དང་སྐབས་འགར་རྒྱ་སྐད་ཀྱི་བརྡ་དོན་རྣམས་བོད་སྐད་དུ་དྲངས་པས་མིན་ནམ་སྙམ།",
    "དེའི་ཕྱིར་ལྷུག་རྩོམ་ཟེར་དུས་རང་རེས་ཅུང་གུ་ཡངས་པོ་དང་དོན་ཆེ་ས་ནས་གོ་བ་བླངས་ན་བརྡ་དོན་ཕན་ཚུན་མི་འཁྲུག་པར་ཕན་ཐོགས་པར་སྣང་།",
    "སྐབས་དོན་གྱི་དཔྱད་བརྗོད་སོགས་རྩོམ་ལུས་བྱེ་བྲག་པ་མང་པོ་ཞིག་རྩོམ་ལུས་གཞན་ཞིག་གི་ནང་དུ་བསྡུ་ཐབས་མེད་པར་ཆགས་སྲིད་ལ།",
    "དེ་ལྟར་བྱུང་ཚེ་རྩོམ་རིག་གི་བྱེ་བྲག་ལྷུག་རྩོམ་ཟེར་བ་དེར་ཡང་གོ་བ་གསལ་པོ་མེད་པ་ཆགས་སྲིད།",
    "གང་ལྟར་ཐེངས་འདིའི་ལྷུག་རྩོམ་གྱི་དཔེ་ཚོགས་པར་དུ་བསྐྲུན་པ་འདིས་རང་རེར་རྩོམ་ལུས་འདི་ངོས་འཛིན་པར་མཐུན་རྐྱེན་ཡག་པོ་ཞིག་བསྐྲུན་ཡོད་སྲིད་ཅིང་།",
    "རྗེས་མར་རྩོམ་ལུས་འདིའི་རྒྱུན་མ་ཉམས་པར་གོང་ནས་གོང་དུ་འཕེལ་ཚེ་བོད་སྐད་ཀྱི་ལྷུག་རྩོམ་ཟེར་བའི་གོ་དོན་ཡང་གསལ་པོར་རྩོམ་རིག་གཞུང་ལུགས་སུ་བྲི་ཆོག་གི་རེད་སྙམ།",
    "འགྲེམས་སྤེལ་ཁང་གི་ཁ་པར།",
    "ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཅེས་བྱ་བ་ལ་སོགས་པ་མཚན་དུ་མའི་སྒོ་ནས་གསུངས་པ་ཡིན་ནོ།",
    "བདག་སྟོབས་ཆེན་བདག་གི་ལག་ཆར་འགྱུར་བས་ཐུན་མོང་བ་བཞིན་དུ།",
    "དེ་ལས་ཉོན་མོངས་པ་དང་།",
    "ལས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "གཞན་ཡང་འོ་མ་དུག་སྦྲུལ་གྱིས་འཐུངས་ན་དུག་གི་དངོས་པོར་འགྱུར་ལ།",
    "སྦྲུལ་དང་སྐྱེས་བུའི་རྐྱེན་དང་ཕྲད་པའི་བྱེ་བྲག་གིས་གཉིས་ཀའི་རྒྱུ་ཐུན་མོང་བ་ཡིན་པ་བཞིན་དུ་འདོད་པའི་ཡོན་ཏན་ཡང་ཤེས་པར་བྱའོ།",
    "ཐབས་ཀྱིས་ཟིན་པ་དང་མ་ཟིན་པའི་བྱེ་བྲག་གིས་གཉིས་ཀའི་རྒྱུ་ཐུན་མོང་བ་ཡིན་པའི་ཕྱིར་གཞི་ཡིན་ནོ།",
    "འདོད་པ་རྣམས་ནི་དུག་གི་ལོ་མ་ལྟ་བུའོ།",
    "དེས་ཀུན་ནས་ཉོན་མོངས་པའི་རྟོག་པ་གསུམ་མི་སྐྱེ་བས།",
    "གཞན་ཞེ་སྡང་ལ་བྱམས་པ་ལ་སོགས་པའི་སྒོ་ནས་ཀྱང་ཉོན་མོངས་པ་སྤོང་བར་བྱེད་པའོ།",
    "དེས་ན་རྒྱུ་ཐ་དད་པ་གཅིག་གིས་འབྲས་བུ་ཐ་དད་པ་གཅིག་སྒྲུབ་པར་བྱེད་པའོ།",
    "འབྲིང་གིས་སུམ་ཅུ་རྩ་དྲུག་ན་འགྲུབ།",
    "དཔེར་ན་སྟྭ་རེ་རྟུལ་པོས་ཤིང་གཅོད་པ་ན་ཡུན་རིང་དུ་འགོར་བ་ལ་མི་ཆོད་པ་ཡིན་ཟེར་བ་དང་འདྲ་གསུང་།",
    "ཐུན་མོང་གི་ཐབས་ལ་མཁས་པའོ།",
    "ཐུན་མོང་མ་ཡིན་པ་ཤེས་རབ་ཀྱི་རྒྱུད་ལྟར་ན།",
    "གཟུགས་ལ་སོགས་པ་དཀར་མོ་ལ་སོགས་པར་བྱས་ཏེ་ལྷ་ལ་ལྷ་ཐིམ་པའི་ཚུལ་དུ་ལོངས་སྤྱོད་པར་བྱེད་པའོ།",
    "དེ་ལྟར་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཀྱིས་ལྷ་སོ་སོའི་ཐབས་ལ་མཁས་པའོ།",
    "རང་གི་ལྷག་པའི་ལྷའི་ཐབས་ལ་མཁས་པ་ནི།",
    "གཟུགས་ལ་སོགས་པའི་ཡུལ་ཅི་སྣང་བ་ཐམས་ཅད་ཀྱང་རང་གི་ལྷག་པའི་ལྷར་བྱས་ནས།",
    "རང་གི་ལྷག་པའི་ལྷར་སྦྱོར་བས།",
    "རང་བྱིན་གྱིས་བརླབ་པའི་རིམ་པ་ཙཎྜཱ་ལཱི་ལ་བརྟེན་ནས་སྐྱེས་པའི་རང་བྱུང་གི་ཡེ་ཤེས་དང་།",
    "དེ་ལ་དང་པོ་ནི་ནང་དུ་རྣལ་འབྱོར་པ་ལ་གསལ་སྟོང་གི་ཏིང་ངེ་འཛིན་སྐྱེས་པ་ན།",
    "གཉིས་པ་ནི་ནང་དུ་བདེ་སྟོང་གི་ཏིང་ངེ་འཛིན་གྱི་ཉམས་སྐྱེས་པ་ན།",
    "རེས་འགའ་གནོད་ལ་རེས་འགའ་མི་གནོད་དེ་སྣང་བ་ཁྲ་བོར་འཆར་བ་དང་།",
    "མར་མེའི་རྩེ་མོ་རབ་བཅིངས་ལྟར།",
    "དེ་ནི་རིགས་ན་འོན་ཀྱང་དེར་དེ་ལྟར་གསུངས་པ་ནི་འཕགས་པའི་གང་ཟག་གིས་བསྟེན་པ་དང་།",
    "གཟུགས་ལ་སོགས་པ་ཐ་མལ་པའི་རྣམ་རྟོག་གི་ཡིད་ལས་སྐྱོབ་པར་བྱེད་པས་ན་གསང་སྔགས་སོ།",
    "ཤེས་རབ་ཆེན་པོ་བདག་གིས་བཤད།",
    "སྔགས་པས་ཅི་དང་ཅི་བྱེད་པ་ཐམས་ཅད་སྣང་བ་དེ་དག་གི་ངོ་བོར་སྣང་ལ།",
    "དེ་ཡང་ལས་དང་པོ་པས་མོས་པས་འཇུག་པ་དང་།"
  ]
}