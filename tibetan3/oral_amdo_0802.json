    "གཞན་བདག་ནི་དུས་ནམ་ཡང་གངས་རྒྱན་མེ་ཏོག་གི་ཀློག་མཁན་ཞིག་ཡིན་ལ།",
    "ཡང་མ་མ་བོད་ཀྱི་ཡིག་ངག་རྩོམ་རིག་གཉིས་ཀྱི་འབྱེད་མཚམས་ལས་འཕྲོས་ཏེ་ཕྲན་རང་གི་གསར་རྩོམ་གྱི་ཉམས་མྱོང་གླེང་བ།",
    "བོད་ཀྱི་ཡིག་ངག་གི་རྩོམ་གང་ཡིན་ནའང་ཧ་ཅང་ཕུན་སུམ་ཚོགས་པ་ཆུ་གཏེར་གྱི་ཀློང་ཡངས་པོ་ལྟ་བུ་ཞིག་ཡིན་པ་ནི་སྨོས་ཅི་དགོས།",
    "དེ་བས་དེ་གཉིས་ལ་སོ་སོར་བྱེ་བྲག་གི་དབྱེ་བ་ག་འདྲ་ཡོད་པ་དང་།",
    "ལོ་གཅིག་གི་སྔོན་དུ།",
    "ངག་རྩོམ་མང་པོ་ཞིག་ཡིག་ཐོག་ཏུ་བཀོད་རྗེས་ཡིག་རྩོམ་དུ་འགྱུར་བ་དང་ཡིག་རྩོམ་འགའ་ཞིག་ངག་ཐོག་ནས་བརྒྱུད་རྗེས་ངག་རྩོམ་དུ་གྱུར་བའི་དཔེ་ནི་བགྲང་གིས་མི་ལང་།",
    "ཡང་སྒྲོལ་མ་ཉེར་གཅིག་གི་བསྟོད་པ་ལྟ་བུ་ནི་བོད་ཀྱི་ལོ་ཙཱ་བས་རྒྱ་གར་ནས་བསྒྱུར་བའི་ཡིག་རྩོམ་ཡིན་ཡང་ཕྱིས་སུ་དད་ལྡན་པ་དག་གིས་ཡི་གེར་མི་བརྟེན་པར་ངག་ནས་ཡང་ཡང་ཟློས་པས་ངག་རྩོམ་དང་གཉིས་སུ་མེད་པར་གྱུར་ཡོད།",
    "ངག་རྩོམ་ནི་ངག་ནས་ཟློ་བ་བོ་དང་རྩོམ་པ་པོའི་ངག་གི་སྒྱུ་རྩལ་ཞིག་ཏུ་གྱུར་ཡོད་པར་མ་ཟད།",
    "ཡི་གེ་ཤེས་མཁན་རེ་གཉིས་ཀྱིས་སྐབས་འགར་དོན་འགའ་ཞིག་ཡིག་ངོར་འགོད་པ་ཕུད།",
    "ཕོ་མོའི་བརྩེ་འདང་།",
    "སྐབས་འགར་སྐད་བསྐུར་རེའི་རིང་ཚད་ལ་དེང་གི་སྒྲུང་ཐུང་རེ་ལྟ་བུའང་ཡོད།",
    "སྐད་འཁྱེར་མཁན་མང་ཤོས་ཀྱིས་མ་སྐད་དེའི་ནང་གི་གཏམ་དཔེ་སོགས་ཇི་བཞིན་དུ་མ་ལུས་པར་བློར་བཟུང་སྟེ་ཤོད་ཐུབ་པར་མ་ཟད།",
    "ཁ་ཤགས་སོགས་བཏང་བས་ཨ་ཕ་ཁྱིམ་ན་མེད་དུས་ངས་ཨ་ཕའི་སྒྲ་སྡུད་འཁོར་ལོར་ལྐོག་ནས་ཉན་པ་དང་།",
    "མོ་རང་ཆུང་དུས་ཀྱི་གཏམ་རྒྱུད་དང་།",
    "ངའི་ཕུ་བོ་ཞིག་གིས་ཞིང་རྨོ་བྱེད་ཀྱི་འདྲུད་འཐེན་འཁོར་ལོ་དང་།",
    "ད་ལྟ་བསམ་ན་གློག་རྡོ་ཅན་གྱི་རྩེད་ཆས་སམ་ཅ་ལག་དེ་དག་གིས་ང་ལ་བསླུ་བྲིད་ཐེབས་པའི་དུས་ནི་ཏག་ཏག་ངའི་སེམས་ནང་གི་བྱིས་སྒྲུང་དེ་དག་བོར་མགོ་བརྩམས་པའི་དུས་ཀྱང་རེད།",
    "དེ་དག་ནང་གི་གཟུངས་སྔགས་ལེགས་སྦྱར་སྐད་ཀྱིས་བྲིས་པ་དེ་དག་ལ་འཕྲད་དུས་སྤོབས་པ་ཆེན་པོས་འགྲིག་མིན་ལ་མ་བལྟས་པར་མགྱོགས་པར་བཀླགས་པ་ད་དུང་ཡང་གསལ་བོར་དྲན།",
    "དེའི་རྗེས་སུ་ང་ལ་ནང་དོན་ཧ་གོ་བའི་བོད་ཡིག་གི་དེབ་མང་པོ་ཞིག་བཀླག་རྒྱུ་བྱུང་བ་དང་དེ་དག་གི་ནང་དུ་ད་ལྟར་རྩོམ་རིག་ཏུ་འབོད་པའི་བརྩམས་སྒྲུང་དང་སྙན་ངག་མང་དག་ཅིག་ཡོད་ཅིང་།",
    "ཡང་ན་དམངས་ཀྱི་ངག་རྩོམ་དང་བར་ཐག་ཆེན་པོ་ཕྱེ་བའི་ཡི་གེའི་ནང་གི་སྒྲོམ་གཞི་དེ་ལ་ཚུད་པར་མ་ཟད།",
    "སྤང་ཆེན་མོ་དང་རྟ་ནོར་ལུག་གསུམ།",
    "དེ་ནས་བཟུང་སྟེ་ང་ས་ནས་ངག་རྩོམ་དང་ཡིག་རྩོམ་གཉིས་ནི་བར་ཐག་ཆེན་པོ་ཞིག་གིས་ཆོད་པར་གྱུར་ཅིང་།",
    "ཁོང་ཚོ་བཞིན་གཏམ་དཔེ་དང་ཚིག་རྒྱན་གྱིས་བརྒྱན་པའི་གཏམ་རིང་པོ་དེ་དག་ཀྱང་ཤོད་མི་ཤེས་པར་གྱུར།",
    "རང་རྣམ་རྩོམ་པའི་སྐབས་སུ་ཁོང་ཚོ་རང་གི་སྐད་ངག་དེ་ཡིག་རྩོམ་གྱི་ཁྲོད་ནས་གསལ་པོར་མངོན་དུ་བཅུག་ཡོད།",
    "ཡིན་ནའང་དེང་གི་བོད་རྩོམ་འབྲི་བ་བོ་རྣམས་ནི་རྩོམ་སྐད་རིགས་གཅིག་གི་ཁྱབ་ཁོངས་ལས་འགོངས་ཐུབ་ཀྱིན་མེད་པའི་སྣང་བ་བྱུང་།",
    "གཤམ་དུ་བཀོད་པ་ནི་ངའི་བརྩམས་སྒྲུང་སྒྲོལ་དཀར་ནང་གི་མི་སྣའི་ཁ་བརྡ་ཞིག་ཡིན།",
    "དེའི་ནང་གི་མང་ཕྱོགས་བརྡ་སྤྲོད་ཀྱི་རྣམ་གཞག་ལྟར་བྱས་པའི་ཡིག་སྐད་ཡིན།",
    "ངག་རྩོམ་ཉིད་འཚོ་བ་རོལ་བྱེད་མིན་པར་འཕྱོར་གོས་ཤིག་གི་ཚུལ་གྱིས་ལས་གཞི་ལེན་བྱེད་བྱས་པས།",
    "དུས་འདིར་ངེད་ཅག་གི་སྨྱུག་འོག་ཏུ་ཅི་ཞིག་བྱོན་སྲིད་དམ།",
    "སྐས་གདང་གི་མཐོ་སར་སླེབས་དུས་བསང་དུད་ཀྱི་དྲི་མ་ཙམ་གོ་ནའང་བསང་ཕུད་པའི་རྣམ་པ་ངོ་མ་དེ་མཐོང་ཐབས་བྲལ།",
    "དེ་བས་སྐབས་འགར་ང་རང་དངོས་གནས་མགོ་བོ་རྨོངས་ཀྱིན་འདུག་༢༡༦ལོའི་ཟླ་༥པའི་ཚེས་༡༤ཉིན་ཀློག་མཁན་འགའ་ཞིག་གི་རང་གཟུགས།",
    "ཁོ་ཚོས་རང་གི་མ་རིག་པའི་རྨ་ཁ་ཆེན་པོ་དེ་སྦེད་ཕྱིར་དེ་ཉིད་རྫུན་དང་ཕྲ་མའི་རས་ཐུམ་གྱིས་དམ་པོར་དཀྲི་རྒྱུར་འཛེམ་བག་སྤུ་ཙམ་མེད་པ་རེད།",
    "རྩོམ་རིག་གི་རྟོག་པ་མཐོན་པོར་བསླེབས་ཡོད་ཚུལ།",
    "འཛམ་གླིང་གི་གྲགས་རྩོམ་མང་པོ་བཀླགས་ཡོད་པའི་བཟོ་ལྟ་སྟོན་ལ་དེར་བརྟེན་ནས་རང་གི་མཐའ་འཁོར་གྱི་མི་མང་པོ་ཞིག་ལ་མགོ་བོ་སྐོར་བའི་སྦྱོར་བའང་རྩོམ་གྱི་ཡོད།",
    "མི་དེ་ཚོ་ནི་བོད་ཀྱི་དེང་རབས་རྩོམ་རིག་གི་འོ་མའི་ནང་དུ་ལྷུང་བའི་འབུ་ནག་འགའ་དང་འདྲ་སྟེ།",
    "དེ་བཞིན་ཁོ་ཚོའི་དེ་རིང་གི་ལྟ་བ་དང་སང་ཉིན་གྱི་ལྟ་བ་གཉིས་ལའང་འགྱུར་བ་ཆེན་པོ་ཡོད་པ་རེད།",
    "ངས་ཁྱོད་དྲན་བྱུང་།",
    "ཕྱི་གླིང་བར་ལད་མོ་བྱེད་ཀྱིན་འདུག་ལྟ་བུའི་ཉེས་མིང་འགེལ་གྱི་རེད།",
    "མི་དེ་ཚོར་དཀར་བོ་ནག་པོར་སྒྱུར་བྱེད་དང་ནག་པོ་དཀར་པོར་སྒྱུར་བྱེད་ཀྱི་མཆུ་ཏོ་ཞིག་ཡོད་པ་ལས་གཞན་ཅི་ཡང་ཡོད་པ་མ་རེད།",
    "བློ་ཁོག་སོགས་གང་ཡང་ཡོད་པ་མ་རེད།",
    "༢ ཁ་གསལ་ཞིང་གཏིང་ཟབ་པའི་སྒོ་ནས་བྱེ་བྲག་གི་དོན་ལ་མི་དཔྱད་པར་ལྐོག་གྱུར་གྱི་ཐ་སྙད་འགའི་ཕྱིར་ཏུ་བློ་རྨོངས་པ།",
    "ཆེ་བས་ཆུང་བར་མཐོང་ཆེན་དང་ཆུང་བས་ཆེ་བར་བརྩི་བཀུར་མེད་པར་རང་ཤོང་སྤྱིལ་བུ་རེ་ནས་སྒེར་གྱི་བཙན་ས་རེ་འཛིན་པ།",
    "ལྟར་སྣང་གི་གནས་ལུགས་བཅས་ལ་བརྟེན་ནས་ལུས་སེམས་གཉིས་ཀ་ཉོབ་ཉོབ་པོར་བཏང་ཡོད་པ།",
    "༡ བརྡ་སྤྲོད་ཀྱི་རིག་པར་བྱང་ཆ་མེད་ཅིང་སྐད་རིགས་གཞན་ལ་སྦྱང་བ་ཉུང་བས་ངག་གི་སྨྲ་བའི་རྩལ་ཧ་ཅང་ཞན་པ་དང་།",
    "འཇིག་རྟེན་དང་མི་ཚེའི་ཕྱོགས་ཀྱི་ལྟ་ཚུལ་ནི་ཧ་ཅང་གཟབ་ནན་ཞིག་ཡིན་པར་མ་ཟད་དེ་དག་མཚན་ཉིད་རིག་པའི་མ་ལག་ཞིག་གིས་བསྲུངས་པར་བྱས་ཡོད།",
    "བདག་གིས་བསམ་ན་དམིགས་སའི་གནས་དེ་ལ་སླེབ་པ་ལས་ལམ་ཁའི་ཡུལ་ལྗོངས་ཉམས་སུ་མྱོང་བ་དེ་ནི་ཕྱིར་དྲན་བྱེད་རིན་ལྡན་པ་ཞིག་རེད།",
    "དེ་ལྟ་ནའང་འཆི་བ་ཞེས་པའི་ཐ་སྙད་དེ་གནས་ལུགས་ཀྱིས་འཆད་དུ་མི་བཏུབ་ཅིང་སྣང་བས་ཀྱང་མྱོང་དུ་མི་འོས་ན་དེ་ཉིད་གསོན་པའི་ཕྱོགས་ཀྱི་སེམས་ཁྲལ་གྱིས་མི་མཚོན་ཀ་མེད་རེད།",
    "གལ་སྲིད་ཁྱོད་ཀྱིས་འཆི་བ་དང་གསོན་པ་གཉིས་དཀར་ནག་དང་།",
    "ཁོ་ཚོ་རེ་ཞིག་དེ་ལ་མི་གོམས་པར་གྱུར།",
