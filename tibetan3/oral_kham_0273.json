    "རས་བྲིས་བླངས་ཏེ་རྨ་བྱའི་སྟན་དེ་ལ་འདུའདུག་ནས།",
    "རས་བྲིས་ནུབ་ཏུ་བལྟས་པ་བཞག་ལ་བདག་ཉིད་ཀུ་ཤའི་སྟན་ལ་འདུག་པ་སོགས་སྔ་མ་བཞིན་བྱ་སྟེ།",
    "དཀྱིལ་དུ་གྲུའི་བཞོན་པ་ལ་འདུག་སྟེ།",
    "རས་བྲིས་ཆེན་པོ་ཞལ་ནུབ་ཏུ་བསྟན་པ་བཞག་ལ་བདག་ཉིད་ཤར་དུ་བལྟས་ནས་ཀུ་ཤའི་ཁྲེས་ལ་འདུག་སྟེ།",
    "འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་སྔགས་ཀྱི་གོང་ནས་གོང་དུ་འདུག་པ།",
    "ཁྲེས་སྙོམས་པར་གདལ་བའི་སྟན་ལ་འདུག་ནས།",
    "ཀུ་ཤའི་ཁྲི་ལ་ཉེ་བར་འདུག་པར་བྱ་སྟེ།",
    "ཅི་སྟེ་དེ་ཉིད་དུ་འདུག་ན་ཡང་།",
    "ཇི་སྲིད་ནམ་ཕྱེད་པ་དེའི་བར་དུ་བཟླས་པ་བྱས་ཏེ་འདུག་ན།",
    "ཟླ་བ་ཉ་བ་ལ་གནས་དབེན་པར་འདུག་ནས་སྒོ་བཅད་དེ།",
    "བདག་ཉིད་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་ནས།",
    "དེ་ནས་ཡར་ངོའི་ཟླ་བ་ཉ་བ་ལ་གསང་བྱེད་ཀྱི་ཁྲེས་ལ་འདུག་སྟེ།",
    "འདུག་ཅིང་འདུག་པའི་ལས་དང་ནི།",
    "དེ་དག་དུས་ཀྱི་ཐ་མ་ལ།",
    "འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་དུས་སུ།",
    "ཡི་གེ་ཙ་ནི་གྲུ་བཞིར་སྣང་།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷུ་ཏ་རཱུ་པཱི་ནཱཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷུ་ཏ་རཱུ་པཱི་ཎཱཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷུ་ཏ་རཱུ་པཱི་ཎཱཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏ་བྷུ་ཏ་རཱུ་པཱི་ཎཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷ་ཏ་རཱུ་པཱི་ཎཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷ་ཏ་རཱུ་པཱི་ཎཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷུ་ཏ་རཱུ་པཱི་ཎཱཾ།",
    "ཨ་ཙི་ཏྱཱ་ཏད་བྷུ་ཏ་རཱུ་པཱི་ཎཱཾ།",
    "ལྷོར་བལྟས་འདུག་ལའང་མ་ཡིན་ཏེ།",
    "ནུབ་ཏུ་བལྟས་ཏེ་འདུག་པའང་མིན།",
    "ཞུ་དག་ལན་བརྒྱད་ཙམ་བྱས་པའི་ཐུགས་དམ་འདུག་པ་ལ།",
    "ཚིག་དོན་གཉིས་ལ་མཁས་ཞིང་རང་རྒྱུད་ལ་ཇི་འབྱོར་མཛད་པར་ཞུ།",
    "རྟོགས་ན་རྟོགས་མྱོང་རང་རིག་ཡེ་ཤེས་ཐོབ།",
    "མཐར་ཡང་རང་ལུས་གང་ལེན་འབངས་སུ་མཐོང་།",
    "མེད་ལས་ཡོད་འབྱུང་རང་འབྱུང་ཡེ་ཤེས་དེ།",
    "མཐོང་ལམ་མཐོང་སྣང་རང་སྣང་ཡིན་པར་བཤད།",
    "དངོས་པོ་དངོས་མེད་དབྱིངས་སུ་ཕར་བཟློག་དུས།",
    "རང་རང་སྟོབས་ལས་ཤར་བའི་མཚན་ཉིད་སྟོན།",
    "ཙང་རི་ཙ་ནའི་ཐིག་ལེ་བཏང་སྙོམས་བསྐྱེད།",
    "སྣང་ཚུལ་འགྲོ་འདུག་འཕར་འཕྱོ་བརྟན་པའོ།",
    "གང་སྣང་རང་འབྱུང་ཡེ་ཤེས་ཡུལ་དུ་གྲོལ།",
    "ཅིར་མཐོང་རང་གྲོལ་ཆེན་པོའི་དབྱིངས་སུ་འཕྱོ།",
    "ཉོ་མཁན་བྱུང་ཡང་རང་ཉིད་བྲེད་པར་འགྱུར།",
    "ཤུགས་འབྱུང་རང་གྲོལ་ཆེན་པོའི་རྩལ་ཤུགས་བཏོན།",
    "བརྡའ་སྒོ་དབྱེ་ཞིང་རང་གྲོལ་གདན་ཡང་འབུལ།",
    "རང་རང་འཁོར་དུ་བདེ་ཆེན་ཡུམ་བཞི་དང་།",
    "ལྷ་ཚོགས་རྣམས་ཀྱང་རང་ཉིད་གཙོ་ལ་བསྡུ།",
    "ཐུགས་ཀ་བོན་གྱི་འཁོར་ལོ་འདུག་པའི་གནས།",
    "མེ་རྨིས་མེར་མཆོང་རང་ལུས་མེ་རུ་སྤྲུལ་། ཡེ་ཤེས་མེ་དཔུང་འབར་བའི་ཀློང་གུར་བཞུགས།",
    "ཆུ་རྨིས་ཆུར་མཆོང་རང་ལུས་ཆུ་རུ་སྤྲུལ།",
    "འཇིགས་པ་གང་སྣང་རང་གྲོལ་ཡེ་ཤེས་གྲོགས། །",
    "སེང་གེའི་རྩལ་ཚུགས་འདུག་པས་ཐར་ལམ་བགྲོད།",
    "འཁྲུལ་དང་རང་སྣང་རང་བཞིན་མེད་ཤེས་པས།",
    "སྣང་བ་འཁྲུལ་སྣང་རང་སྣང་དོན་སྣང་གསུམ།",
    "བཟང་ངན་བག་ཆགས་སྤྲིན་དཔུང་རང་བཞིན་དཔེ།",
    "ནམ་མཁའི་ཆོ་འཕྲུལ་རང་འབྱུང་རང་སར་བཞག།",
    "ཐོག་སེར་འབྲུག་གློག་རང་འབྱུང་རང་མི་བསྐྱོད།",
    "འདུག་པ་རང་བཞིན་ཆ་ལུགས་ཕྱག་རྒྱར་གནས།",
    "གསལ་བར་བསྒོམ་དང་རང་བཞིན་མེད་པ་ལ།",
    "སྲས་ཀྱི་ཞལ་ནས་ཡུམ་གྱིས་བཙལ་བ་དེ་དག་ཀྱང་ཀུན་རྫོབ་སྒྱུ་མའི་ཚུལ་དུ་གདའ་གསུངས་པས།",
    "རང་སེམས་སྐྱོན་གྱིས་མ་གོས་པར་འདུག་ན་ཤེལ་གྱི་བྲག་ཕུག་ཀྱང་དེ་ཡིན།",
    "སྲས་ཀྱི་གསུངས་པ་དེ་ཀུན་ཀྱང་བདེན་ཚིག་ཏུ་མ་གྱུར་པ་མི་འདུག་ཀྱང་།",
    "མཐུ་རྩལ་གྱི་འདུག་གནས་མཁར་ཆེན་བརྒྱད་བརྒྱད།",
    "དེ་ནས་བདག་མྱལ་གྱི་བཙུན་པ་གཞོན་ནུ་ཁམས་སུ་ཡོད་ཙ་ན་མཁའ་འགྲོའི་ལུང་བསྟན་གྱིས།",
    "ཞང་བོད་འདྲེས་མ་ལ་བོད་ཡིག་མང་བར་འདུག།",
    "ངང་དང་རང་བཞིན་འདུ་འབྲལ་མེད་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་གནས་སོ།",
    "རྒྱ་མཚོ་རང་ཉིད་ཡིན་ཞིང་རང་ཉིད་མྱོང་བར་གནས།",
    "ནང་རང་ལུས་རྒྱལ་བའི་དཀྱིལ་འཁོར་དང་།",
    "དེ་བཞིན་དུ་ནང་རང་ལུས་ཀྱང་སྲིད་ལུགས་སྲིད་པ་ནང་བསྟན་པ་དང་མཚུངས་སོ།",
    "དེ་ཡང་རང་རིག་པའི་ཡེ་ཤེས་ཀྱི་རྩལ་ལས།",
    "དེ་ཡང་ཤ་ཟཪ་འདུག་པས་ན་པྲ་ཤ་ཞེས་བྱའོ།",
    "ངང་དང་རང་བཞིན་འདུ་འབྲལ་མེད་པའོ། །",
    "པ་ཆུའི་ས་ཁོ་རང་ཉིད་གཏིང་ནག་བཀུར་ལྗི་ལུས་སེམས་གཉིས་གཅིག་མི་བདེ།",
    "ཁོ་རང་དེ་དང་བློ་སེམས་མི་མཐུན།",
    "འབྲས་བུ་སད་སྟོར་འབྱམས་གསུམ་སྟོན་པ་ནས་དཀོན་པའི་ཡོན་ཏན་ཅི་འདུག་གོ་ཕུག་ཧ་ར། །",
    "འགྲོ་ཉལ་འདུག་སྡོད་གང་བྱེད་ཀྱང་།",
    "ཤུགས་འབྱུང་རང་གྲོལ་ཆེན་པོའི་ངང་ལས་རྩལ་བྱུང་ན་རྩལ་བཏོན།",
    "དཔལ་མགོན་པྲ་མ་ར་ཙ་ནག་པོ་དང་།",
    "རྒྱས་པ་ཞི་བའི་ངང་དུ་རྩོལ་བ་དང་བྲལ་ཏེ་མཉམ་ཉིད་ཞི་བའི་ངང་ལ་གནས་པས་སྣང་བ་སྒྱུ་མ་འཁྲུལ་པའི་བག་ཆགས་སུ་འདུག་པས་སོ།",
    "དེ་ལ་སྒྲིབ་གཉིས་ཉོན་ཤེས་གཉིས་ཡིན་ཀྱང་རང་གཞན་གཉིས་ཀ་ཡང་གསང་སྔགས་ཀྱི་ཚོགས་ཀྱིས་འབྱང་སྟེ།",
    "དེ་ལ་རང་རང་སྔགས་ཀྱིས་བསྐུལ་བས།",
    "དེ་ནས་མི་འགྱུར་གཡུང་དྲུང་མ་བྱེ་བ་ས་ཡ་སྤྲོས་པས་གདན་དང་རང་ལུས་ལ་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "དེ་ནས་ཡང་རང་ལ་འོད་ཟེར་སྤྲོས་པས་ཡི་དམ་རྒྱལ་བ་མཁའ་འགྱིང་རིགས་ལྔ་སྤྱན་དྲངས་ལ།",
    "དག་སྣང་རང་ལ་འཆར་བས་སྣང་བ་ཡི་དམ་དུ་འགྱུར་བ་དང་།",
    "རང་དོན་ལྷུན་གྱིས་གྲུབ་ཅིང་རང་ལུས་ལྷ་རུ་འགྱུར་བས་སོ།",
    "དེ་ལ་ཡང་ཐར་ལམ་ནི་སྒོམ་ལམ་ཡང་དག་པར་མི་འདུག་པ་དང་།",
    "མལ་ས་ཆུང་ལ་བདེ་བར་འདུག་པ་ཡིན་ཞིང་།",
    "རང་ཁ་དང་རང་སེམས་བློ་གྲོས་འགྲིག་པའི་གཏམ་བཟློ་བ་འབྱུང་ངོ།",
    "སྣང་ཡང་རྨི་ལམ་གྱི་རང་བཞིན་དུ་འདུག་ཤར་ཡང་རྨི་ལམ་ལྟ་བུར་འཆར་བ་ཡིན་ནོ།",
    "མཛོད་སྤུ་སལེ་སྒྲོན་མ་གསལ་བའི་ཡུལ་ཐུགས་ཀ་བོན་ཉིད་འཁོར་ལོ་འདུག་པའི་གནས།",
    "ཚིག་པར་མ་གྱུར་དེ་ནི་རྨི་ལམ་ངེས་པར་འདུག་པས་རང་ཡང་མེ་དཔུང་དངོས་སུ་སྤྲུལ།",
    "མེ་རྨིས་མེར་མཆོང་རང་ལུས་མེ་རུ་སྤྲུལ།",
    "ཆུ་རྨིས་ཆུར་མཆོང་རང་ལུས་ཆུ་རུ་སྤྲུལ།",
    "འཇིགས་པ་གང་སྣང་རང་གྲོལ་ཡེ་ཤེས་གྲོགས་ཞེས་གསུངས་སོ། །",
    "བདུད་དཔུང་རང་སར་དག་ཐམས་ཅད་སེམས་སུ་ཤེས།",
    "ནམ་མཁའ་དག་པ་ལྟ་བུའི་སེམས་སུ་འདུག་པ་ལ།",
    "གཤིན་རྗེས་བསད་པ་བྱུང་ཡང་དེ་ལ་གཏད་དེ་བསྒོམས་པས་སེམས་སུ་དག་སེམས་ཀྱི་རང་བཞིན་སྟོང་པར་འདུག་པས་ཆགས་སྡང་བྱ་ས་མ་རྙེད་པས་འདྲེ་སྣང་རང་སྣང་དུ་དག་ནས་འགྲོའོ།",
    "ཡང་སྣང་བ་འདི་ཐམས་ཅད་སེམས་སུ་འདུག་སྟེ།",
    "སྟེང་ལྷའི་སྣང་བ་ཡང་སེམས་སུ་འདུག་འོག་ཀླུའི་སྣང་བ་ཡང་སེམས་སུ་འདུག་ཕན་པར་བྱེད་པ་ཡང་སེམས་ཀྱི་འཁྲུལ་སྣང་།",
    "སེམས་ལས་གུད་ན་གཞན་ཅི་ཡང་མི་འདུག་པས།",
    "ལྐུགས་པ་ལ་ལྕེ་ལས་སོགས་པ་གང་ལ་གང་འདོད་པ་དེ་རང་རང་འཐད་ཕྱོགས་སུ་སྤེལ་ལོ།",
    "ནམ་ལངས་པ་ཉི་ཟླ་ཤར་བ་པད་མའི་གདན་ལ་འདུག་པ།",
    "སེང་གེའི་རྩལ་ཚུགས་འདུག་པས་ཐར་ལམ་བགྲོད།",
    "སེམས་བོན་ཉིད་དུ་གནས་འགྱུར་དེ་ལ་མཉམ་བཞག་དུས་སུ་བསྐྱེད་རྫོགས་ཡ་མ་བྲལ་བར་བྱ་ཞིང་།",
    "མཐུན་པའི་གྲོགས་པོ་གཅིག་དང་རང་དེར་མཚམས་དམ་དུ་བཅད།",
    "དེ་ལྟར་ན་འོད་གསལ་སྐོར་ལྔ་གང་ཡང་འབྲས་བུ་གཅིག་པུར་འདུག་པས།",
    "གཉིས་པ་ལུས་ཀྱི་སྤྱོད་ལམ་བྱ་བྱེད་རྩོལ་བ་འགྲོ་འདུག་རྩ་འགྲམ་པས་སྤང་།",
    "དེ་རྣམས་ཀྱང་རང་ལ་བུང་བུང་ཐིམ་པར་བསམ།",
    "བློ་ཡུལ་དུ་གང་བདེ་བ་དང་རང་ལ་སྐྱེད་གང་ཆེ་བ་སྤོ་ཞིང་བྱ་སྟེ།",
    "ཉམས་ལ་སྣང་བ་དང་རང་ལ་གསལ་བ་དང་ངོ་བོ་མཐོང་བ་འོད་གསལ་ཁོ་ན་ལ་བྱའོ།",
    "སྤྱོད་ལམ་འགྲོ་ཉལ་སྨྲ་འདུག་ཅི་བྱེད་ཀྱང་དོན་གྱི་ཤུགས་འབྱུང་སྟོབས་པོ་ཆེས་ཐེན་ལ་དུས་རྟག་ཏུ་དྲག་ཞན་མེད་པར་འབུང་ཞིང་བསྐྱེད་འདོན།",
    "ཡོད་པ་ཙམ་གྱི་འཇིག་པ་དང་རང་ཆས་སུ་འབྲེལ་པ་ལ།",
    "དེ་ལྟར་འཆི་བ་དང་མི་རྟག་པས་འཇིག་རྟེན་འདི་ལ་བདེན་པ་མེད་ངེས་པར་འདུག་ན།",
    "འགོ་ཐོན་མེད་པར་འདུག་ན།",
    "དེ་ནས་རང་གདན་དཀར་པོའི་སྟེང་དུ་ཁ་ཤར་དུ་གྱུ་ལ་འདུག་སྟེ།",
    "ཡེ་ཤེས་ཀྱི་ཆུ་བོས་ཁྲུས་བྱས་ཤིང་རང་ལ་བསྟིམ་པས་ལུང་ཆེན་ལྔའམ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཏུ་དུག་ལྔ་ཡེ་ཤེས་ཀྱི་ནོན་པར་བྱ།",
    "ཁོ་རང་ལ་ཉེས་བྱས་དངོས་སུ་མེད་ཀྱང་དེ་ལས་མཆེད་ནས་ཉེས་པར་འགྱུར་བས་བསྲུང་བྱའོ། །",
    "འོད་ཀྱི་འཁོར་ལོ་ལྟེ་བ་མུ་ཁྱུད་རྩིབས་དང་བཅས་པའི་ལྟེ་བ་ལ་རང་འདུག་པ།",
    "༣ ཆགས་སྡང་རང་ཁ་མར་སྤྱོད་པའི་འགྲོ་བ་རྣམས་བོན་ཅན།",
    "དེ་ཡང་རང་དགར་ཤི་ཁར་བྲོད་པ་སྐྱེ་བའི་དོན་མེད་དེ།",
    "༧ སེམས་ཞི་བར་གནས་པ་སྟེ་སེམས་རྣལ་དུ་འདུག་པ།",
    "སྒྲ་ནི་འབྲུག་སྟོང་ཕྲག་དུས་གཅིག་གྲགས་པ་ལྟ་བུའི་ངར་ཤུགས་དྲག་པོ་སྒྲོག་པའི་ཟོལ་ལས་འཇིགས་ཤིང་ཡ་ང་བའི་ཚིག་སོད་རྒྱོབས་གཏུབ་ཕྱོགས་སོགས་ཐོས་སོ།",
    "འཁྲུལ་དང་རང་སྣང་རང་བཞིན་མེད་ཤེས་པས།",
    "སྣང་བ་འཁྲུལ་སྣང་རང་སྣང་དོན་སྣང་གསུམ།",
    "ངེས་འབྱུང་རང་འབྱུང་གཉིས་སུ་མེད་པའི་རྟེན།",
    "ད་དམ་སྩའམ་འདུག་པ་འམ།",
    "སྟང་སྟབས་འདུག་སྟངས་བཟླས་བརྗོང་བང་།",
    "རང་འབྱུང་རང་བཞིན་རང་གནས་བ།",
    "དངོས་པོ་མེད་ཅིང་རང་སྟོང་བ།",
    "སྐྱེ་བ་དང་འགག་པ་དང་བྲལ་ཞིང་རང་བཞིན་གྱིས་དག་པ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱིརྣམ་པར་ཡོངས་སུགསལ་བའོད།",
    "འགྲོ་བ་དང་འོང་བམེད་ཅིང་རང་བཞིན་གྱིས་འོད་གསལ་བ་རྣམ་པར་དག་པ།",
    "ཕུར་བུས་གདའ་བར་གྱུར་པ་ཡིན།",
    "བ་ཎྜི་ཏ་མཁས་པ་ཆེན་པོ་ཙྪ་ཏི་ཛཱ་ན་ཀཱི་རྟིས་རང་འགྱུར་བྱས་པ་ཅིག་ཀྱང་ཡོད་པར་གདའོ།",
    "གཏོར་མ་རང་རང་ཕྱག་ལེན་ལྟར།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་ས་དྷ་ནི་སྭཱ་ཧཱ།",
    "དེའི་པང་ན་གནས་པའི་རང་འོད་ཀྱི་ཐབས་དང་རང་ཉིད་འཇམ་པའི་རྡོ་རྗེར་གསལ་བ་དབྱེར་མེད།",
    "དེ་ནས་སློབ་དཔོན་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཤར་དུ་ཕྱོགས་པར་འདུག་ལ།",
