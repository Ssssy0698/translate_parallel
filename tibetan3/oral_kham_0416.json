    "མདུན་དུ་འདུག་ནས་དེས་དེའི་སྣམ་སྦྱར་དེ་ལ་ཡང་དང་ཡང་དུ་རྟོག་ནས་དགེ་སློང་དེས་སྨྲས་པ།",
    "དགེ་སློང་མ་རྣམས་ཀྱིས་དེ་ལ་ཚོན་སྣ་ལྔའི་སྐུད་པས་འཆར་ཀ་སྦེད་མའི་མགུལ་ནས་འཁྱུད་དེ་འདུག་པ་སྐུད་རིས་སུ་བཙེམས་པ་མཐོང་ནས་རྟ་གད་ཀྱིས་བཏབ་སྟེ་སྨྲས་པ།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་ལྷན་ཅིག་གནས་པ་འདུག།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་དགེ་ཚུལ་འདུག།",
    "ཞེས་དང་པོར་དགའ་བོ་འདུག་ནས།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་ལྷན་ཅིག་གནས་པ་འདུག།",
    "དེའི་འོག་ཏུ་དགའ་བོའི་དགེ་ཚུལ་འདུག།",
    "སྐྱེ་བོ་ཕལ་པོ་ཆེའི་ཚོགས་ཀྱི་ནང་དུ་ཞུགས་ཤིང་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་ཁ་ནང་དུ་བལྟས་ཏེ་འདུག་གོ།",
    "དེའི་ཚེ་ན་བཙུན་པ་འཆར་ཀ་དེ་ཉིད་ན་འདུག་པར་གྱུར་ཏམ་འདུག་གོ།",
    "སྦེད་མ་དགེ་སློང་མའི་དབྱར་ཁང་ན་ཕྱག་དར་བྱེད་ཅིང་འདུག་པ་དེས་ཚེ་དང་ལྡན་པ་འཆར་ཀ་ཐག་རིང་པོ་ཁོ་ན་ནས་མཐོང་སྟེ་མཐོང་ནས་ཀྱང་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གང་ཚུན་ཆད་ཁྱེད་ཅག་བསོད་སྙོམས་ལ་དོང་བ་དེ་ཚུན་ཆད་ནས་སྦེད་མ་མ་འདུག་པ་དེ་ནི་བདེན་ཏེ།",
    "ཤར་གྱི་ཀུན་དགའ་ར་བ་ན་རི་དགས་འཛིན་གྱི་མའི་ཁང་བཟངས་ན་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་འོད་སྲུང་ཆེན་པོ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེའི་ཚེ་ན་མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ལ་ཡུན་རིང་པོ་ནས་སྨོན་པ་འདི་ལྟ་བུ་སྐྱེས་ཏེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་འོད་སྲུང་ཆེན་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ལས་ཀྱི་མཐའ་གཉིས་བྱེད་དུ་འཇུད་དེ་ཚོང་དང་།",
    "ཕྱོགས་འདི་གོ་སྐབས་དབེན་པ་ཡིན་གྱི་འདི་ཉིད་དུ་འདུག་པར་བྱའོ་སྙམ་ནས།",
    "དེས་དེ་ཉིད་དུ་འདུག་པར་བརྩམས་ཏེ་མཉན་ཡོད་དུ་བསོད་སྙོམས་བརྒྱུས་ནས་དེ་ཉིད་དུ་གནས་འཆའོ།",
    "ཁོ་བོས་ཞིང་དེའི་དྲུང་དུ་སྤྱིལ་བུ་བྱས་ཏེ་སྤྱིལ་བུ་དེར་དགེ་སློང་བསོད་སྙོམས་པ་ཞིག་འདུག་པས་དེའི་མཐུས་ཞིང་དེ་ཤིན་ཏུ་ལོ་ཐོག་ཕུན་སུམ་ཚོགས་པར་གྱུར་ཏོ།",
    "ཡང་ཡང་དང་ནི་འདུག་གནས་གཅིག།",
    "རྒྱལ་པོའི་ཁབ་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "མཐོང་ནས་ཀྱང་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ་གསོལ་པ།",
    "ཚོང་དཔོན་དེས་ཚོང་པ་དེ་དག་འདུག་ཏུ་བཅུག་པ་དང་།",
    "རྒྱལ་པོའི་ཁབ་ན་ཚོང་དཔོན་བུ་མེད་པ་ཞིག་དུས་ལ་བབ་ནས་ནོར་ཅན་དག་དང་།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས།",
    "དེ་ནས་ཁྱིམ་བདག་དྲག་ཤུལ་ཅན་བསོད་སྙོམས་པ་དེའི་མདུན་དུ་འདུག་པ་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེའི་ཀུན་དུ་སྤྱོད་པ་ནི་ཚེས་བརྒྱད་དང་།",
    "རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་གཅིག་འདུག་པ་དེས་ཕྱོགས་བཞིའི་དགེ་སྦྱོང་དང་།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་དོན་དུ་འདུག་གནས་བྱེད་དུ་བཅུག་སྟེ།",
    "དེ་འདུག་གནས་དེ་ན་ཕྱོགས་བཞིའི་དགེ་སྦྱོང་དང་།",
    "བྲམ་ཟེ་གང་འདུག་པ་དེ་ལ་བསོད་སྙོམས་ཀྱིས་མཁོ་བ་སྟོབས་པར་བྱེད་དོ།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་དོན་དུ་འདུག་གནས་བགྱིད་དུ་སྩལ་བ་དེར་བཞུགས་ཤིག་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་དད་པ་ཅན་ཞིག་འདུག་པ་དེ་ཟོང་ཐོགས་ཏེ།",
    "ཇི་ཙམ་ན་གཅེར་བུ་པ་ངོ་ཚ་དང་ཁྲེལ་བོར་བ་ཤ་སྟག་ཡིན་པར་མཐོང་ནས་མངོན་སུམ་དུ་མི་སྙན་པ་བརྗོད་པ་ནི་སྡུག་བསྔལ་བ་ཡིན་པས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་ཉེ་དགའ་ནང་པར་སྔར་ལངས་ཏེ་སོ་ཤིང་བོར་ནས་སྣམ་སྦྱར་དམར་སེར་གྱོན་ཏེ་རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་སྒོ་ན་འཆག་ཅིང་འདུག་གོ།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་དོན་དུ་འདུག་གནས་བྱེད་དུ་བཅུག་ནས།",
    "ཁྱིམ་བདག་དེས་དེར་གནས་མལ་བཙལ་ནས་ཁྲི་དང་ཁྲིའུ་དག་འདུག་གནས་དེར་བསྐུར་རོ།",
    "འདུག་གནས་ཀྱང་མ་ཡིན་ན་ཁྱེད་ཅག་འདིར་གར་འཇུག།",
    "འདུག་གནས་ཀྱང་མ་ཡིན་ནོ་ཞེས་མ་ཟེར་ཅིག།",
    "གལ་ཏེ་འདུག་ན་ནི་འདུག་ཏུ་ཟད།",
    "ཁྱིམ་བདག་དེ་ཡང་གནས་ཁང་དུ་ཞུགས་ཏེ་འདུག་པ་དང་།",
    "འདི་ལྟར་གང་དེ་ན་འདུག་པ་དེ་ལ་བདག་བསོད་སྙོམས་ཀྱིས་མཁོ་བ་སྟོབས་པར་བྱེད་དོ།",
    "འདུག་གནས་ཀྱང་མ་ཡིན་གྱིས་ཕྱིར་བྱུང་ཤིག།",
    "འདུག་གནས་ཀྱང་མ་ཡིན་གྱིས་ཕྱིར་བྱུང་ཤིག་ཅེས་མ་ཟེར་ཅིག།",
    "མངོན་སུམ་དུ་མི་སྙན་བརྗོད་པ་ནི་སྡུག་བསྔལ་བ་ཡིན་པས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐར་གྱིས་རྒྱུ་ཞིང་འགྲོ་བ་ན་རི་བྲགས་དེར་ཕྱིན་ནས་ཁྱིམ་བདག་དེའི་འདུག་གནས་སུ་ཞུགས་སོ།",
    "འདུག་ནས་ཁྱིམ་བདག་དེས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་དགེ་སློང་མི་ན་བས་བསོད་སྙོམས་གཅིག་བཟའ་བར་བྱའོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཞག་ལོན་པའིའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "ཁུར་བ་དག་དུས་ཀྱིས་སྟོབས་པར་གྱུར་ལ།",
    "སྟན་གང་ལ་འདུག་པར་གྱུར་པའི་སྟན་དེ་ལས་ལངས་པར་གྱུར་པ་སྟེ།",
    "སྟན་གང་ལ་འདུག་པར་གྱུར་པའི་སྟན་དེ་ལས་ལངས་པར་མ་གྱུར་པས་ཏེ།",
    "དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "དགེ་སློང་དེས་འདུག་སྟེ་ཟོས་པ་དང་།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་དུས་མ་ཡིན་པར་བཅའ་བ་དང་།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་ནག་པོའི་གཙུག་ལག་ཁང་ན་འབྲས་ཆན་སྐམ་པོ་རབ་ཏུ་མང་པོ་དག་བཏིང་ཞིང་འདུག་གོ།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་དང་།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་མ་ཡིན་པ་ན་འདུག་པས་དང་།",
    "དུར་ཁྲོད་ཆེན་པོ་དེ་ན་གནོད་སྦྱིན་གདུག་པ་ཞིག་འདུག་པ་དེ་དེ་ན་མི་རོ་མྱགས་པ་ཟའོ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "ཁ་ཟེར་བར་བྱེད་ནས་དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཤེས་པ་ཅན་དགེ་སློང་རྣམས་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་ཤིག་དང་།",
    "ཤེས་པ་ཅན་དེ་དགེ་སློང་རྣམས་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་པ་དང་།",
    "གསེར་གྱི་སྣོད་ན་འདུག་པའི་མར་མེ་ལྟ་བུ།",
    "འདུག་ཤིག་དང་སྦྱིན་ནོ།",
    "དེ་གཉིས་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གཙུག་ལག་ཁང་ལམ་ཀ་ན་འདུག་པ་དང་།",
    "རྒྱལ་པོས་དེ་ཉིད་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་པ་དང་།",
    "དེའི་མཐུས་རི་བྲགས་པ་འདི་ཕེབས་པར་འགྱུར་བ་གང་ལགས་པ་དེ་ལྟ་བུའི་གནས་མཆིས་པར་འགྱུར་གདའོ།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ནང་ན་གནས་པའི་ཚེ་ཡང་ཞེས་བྱ་བ་ནི་འདུག་པའི་ཚེ་ཡང་ངོ།",
    "དེས་དེའི་སྟན་དེ་ཤིང་ལྗོན་པའི་དྲུང་དུ་བཞག་སྟེ་དབེན་པའི་ཕྱོགས་སུ་འདུག་ནས་ཡིད་ལ་བྱེད་པ་བསྐྱེད་པར་བརྩམས་སོ།",
    "དེ་དགེ་སློང་རབ་ཏུ་གྲགས་པས་སྨད་པས་ཅང་མི་སྨྲ་བར་འདུག་ནས།",
    "རི་བྲགས་དེ་ནས་བྱིས་པ་ཁྱེའུ་གཉིས་ཤིག་ལམ་ཀར་འོངས་ཏེ་རྩེ་ཞིང་འདུག་གོ།",
    "ཇི་ཙམ་ན་རི་དྲུང་དང་ཉེ་བ་ཞིག་ན་སེང་གེ་རལ་པ་ཅན་ཅོད་པན་ལྟ་བུ་དང་ལྡན་པ་ཞིག་འདུག་པ་དེས་སེང་གེ་དེ་དག་འབྲོས་པ་མཐོང་ནས།",
    "ཡུལ་ཐ་དད་པ་ན་གནས་པའི་བྲམ་ཟེ་རྣམས་ཀྱི་སྟོན་པར་གྱུར་པ་ཞིག་འདུག་པ་དེ་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཤིན་ཏུ་བཀུར་སྟིར་བྱས།",
    "ཚེ་དང་ལྡན་པ་སྒྲ་ཅན་ཟིན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "ཚེ་དང་ལྡན་པ་སྒྲ་ཅན་ཟིན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་ཏུ་ཡོད།",
    "དགེ་སློང་གནས་བརྟན་དག་ན་བར་གྱུར་ནས་དེ་དག་ལངས་ཤིང་རང་ཉིད་ཀྱིས་བྱིན་ལེན་བྱས་ཏེ་ཟ་བར་མི་ནུས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "ཟླ་བ་དྲུག་དྲུག་ཅིང་དུས་སྟོན་བགྱིད་དུ་སྩོལ་ཅིག་དང་དེར་བདག་ཅག་གཉིས་ཀྱང་རང་ཉིད་མཆིས་ནས་གཡར་སྔར་བྲིམ་པར་བགྱིའོ།",
    "བཟའ་བ་བསོད་པ་དེ་བྱིན་ལེན་བྱས་ནས་ཚེ་དང་ལྡན་པ་འཆར་ཀ་ཟན་ཟ་བ་ན་འདུན་པས་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་སྨྲས་པ།",
    "སྟེང་དུ་བུ་རམ་གྱི་དུམ་བུ་གཉིས་སམ་གསུམ་བཞག་སྟེ་འཆར་ཀའི་ཆ་ལུགས་ཅན་ཟན་ཟ་བའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་སྨྲས་པ།",
    "དེས་རྙེད་པ་ཐམས་ཅད་དེ་དག་ལ་བྱིན་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "དེ་ན་ཧ་ཅང་ཐག་མི་རིང་བ་ན་མི་འབྲས་བུ་དང་རྩ་བ་ཐུ་བ་ཞིག་འདུག་པ་དེས་དེ་ཐོས་ནས་དེས་བསམས་པ།",
