    "དེ་ཡང་ཇི་ཙམ་ངང་དུ་གྱུར་ན་དེ་ཙམ་གྱི་ཡོན་ཏན་ཐོབ་རྒྱུ་ཡོད་པ་དེས་ན་ལས་དང་པོ་བས་ལུས་ཀྱི་འདུག་སྟངས་བཅས་ནས་སེམས་ཀྱི་གཞག་ཐབས་ལ་ཞོག་དེ་ཡང་སྔར་རྗེས་མ་བཅད་འདས་པའི་འདུ་ཤེས་དོར།",
    "མགར་མ་ཤེས་ཀྱང་མགར་རའི་འདུག་སྟངས་བྱས་བསྡད་ནས།",
    "གཞི་སྣང་རང་སྣང་ཡིན་པར་མ་ཤེས་ནས་གཞན་དུ་བཟུང་བའི་ཁྱད་པར་གྱིས་འཁྲུལ་པ་ཇི་ལྟར་བྱུང་ན།",
    "འོན་ཀྱང་རང་བཞིན་རྫོགས་པ་ཆེན་པོའི་ལམ་འདི་ནས་ནི།",
    "ཟང་མ་རྗེན་པ་མཐོང་ཞེས་པ་འདིས་འབྲས་བུ་བསྟན་པ་ཡིན་པར་འདུག་དེ་ལས་ཙེན་ནེ་ཞེས་པ་དེ་མ་བཅོས་པའམ་ཐད་སོར་བཞག་པ་སྟེ།",
    "སེམས་མི་རྟོག་པར་བཞག་དུས།",
    "དེ་ནས་སེམས་མི་རྟོག་པར་བཞག་དུས།",
    "སེམས་གནས་པ་ལ་ངོ་སྤྲད་པ་ནི་སེམས་གཟུང་བ་མ་ཡིན་ཡང་རང་ས་ན་ལྷན་ནེ་རང་བབས་སུ་འདུག་དུས།",
    "སེམས་ཡུལ་ཐོག་ཏུ་ཤོར་དུས་ཡུལ་དེ་ལ་ཚལ་པ་དུམ་བུ་ལ་སོགས་པར་བཤིག་པའི་ཕྱོགས་གང་ན་སེམས་དེ་འདུག་དེད་པས།",
    "དར་ཅིག་ཐ་མལ་དུ་འདུག་ནས།",
    "ལོག་དུས་ཀྱི་ཤེས་པའི་ས་ལེ་མི་འཕྲོ་བ་དེ་བཞག་ལ།",
    "འདིའི་དར་ཅིག་ཐ་མལ་དུ་འདུག་ཅེས་པ་ནི་ཐ་མལ་རང་ག་མ་དུས་རྒྱུན་འཁྲུལ་འབྱམས་ལ་ཡོད་པའི་དུས་ཏེ།",
    "མཁའ་བསྐྱོད་མི་ནུས་པར་ས་ནས་བགྲོད་པ་ཞིག་གཡང་ས་ལ་ཐུག་དུས་འགྲོ་མི་ནུས་ཀྱང་།་",
    "དེས་ན་བྱར་མེད་ཀྱི་ངང་དེར་གནས་པས་ཁོ་རང་ལ་ལྷུན་གྲུབ་ཏུ་ཡོད་པ་གསལ་བར་འཆར་བས་མ་བཙལ་བར་འགྲུབ་པས་ཏེ།",
    "ད་འཁྲུལ་བ་གཞི་ལ་ལྡོག་དུས་འོད་སྐུར་གྲོལ་བའི་འཐད་པ་ཡང་འདིས་འགྲུབ་པ་ཡིན།",
    "བར་གྱི་བུམ་པ་རྫ་མའི་ངོ་བོ་དེ་ཞིག་དུས་ནམ་མཁའ་གཉིས་དབྱེར་མེད་དུ་འདྲེས་པ་བཞིན་དུ།",
    "དེ་རྩིས་ཆེན་དང་འདང་ཆེན་བྱས་ཏེ་གཟུང་འཛིན་དུ་མ་གྲུབ་པའི་གཉིས་སྟོང་རང་རིག་རང་གསལ་སེམས་ཙམ་པའི་འདོད་པ་ལྟ་བུ་ཞིག་ལས་མ་འདས་པ་ཡིན་ན།",
    "ད་གཟོད་བསྐྱར་ཞིང་བསྒྲུབ་འདུག་མི་དགོས་པ་ཞིག་ཡིན་ལ།",
    "མིག་ཕྱེས་ནས་བལྟས་བསྡད་ཡོད་དུས་གཅིག་རིག་འདུག་པས་མི་བདེའོ་མ་སེམས།",
    "དེ་རྟོགས་ཀྱང་རུང་མ་རྟོགས་ཀྱང་རུང་རང་གཤིས་གྲོལ་བ་ཡིན་པ་དེ་འགྱུར་དུ་མེད་པ་ལ།",
    "རྒན་པོས་བྱ་བ་ཐམས་ཅད་འགྲུབ་ཚར་ནས་ལས་ཟིན་ན་བློ་བདེ་ཁོང་ལྷོད་བྱས་ཏེ་འདུག་པ་བཞིན་དུ།",
    "ད་ནི་རིག་པའི་སྟེང་འདིར་ཁྱད་མི་འདུག་སྟེ།",
    "དུས་ཀྱི་འགྱུར་བ་བཞིན་དུ་ལུས་འདི་ཡང་སྐད་ཅིག་ལ་མི་འདུག་ནས་འགྱུར་བའི་ཚུལ།",
    "ལོ་ཉི་ཤུ་ལ་འདུག་རྒྱུ་དེ་ཡོད་པས་དགའ་དང་མེད་པས་དགའ་ཞེས་འདམ་དུ་བཅུག་ན་དེ་མེད་པས་དགའ་ཟེར་ནའང་ཐང་སྟེ།",
    "མིས་བསྐྱངས་ཀྱང་རང་ལུས་བདེ་ཐང་ཡིན་དུས་དང་སྡུར་ཐབས་མེད་པ་ཡིན།",
    "ཐ་ན་ཟ་ཆས་འཐུང་གཡོག་འགྲོ་ཆས་འདུག་ཆས།",
    "ཟླ་བ་རྗེས་མ་མ་དགོས་གཟའ་འཁོར་རྗེས་མ་ལ་འདུག་ཚེ་ཨེ་ཡོད་སུས་ཤེས།",
    "ཟ་འཆག་ཉལ་འདུག་ཉིན་ཞག་ཕྱམ་གདལ་བས།",
    "ཉལ་དང་འདུག་པ་སྒྲུབ་པའོ།",
    "དེ་ལྟར་འཇོག་དུས་གནས་ན་གནས་ཐོག་ཏུ་ཕྱམ་གདལ།",
    "ནང་འགྱུ་བའི་ཀློང་རང་སངས་རྗེས་མེད་ཆེན་པོར་ཡངས་པ་དང་།",
    "མ་བརྟགས་ཡེ་ནས་ཆོད་ནས་འདུག།",
    "ཀློང་ཡངས་གཉིས་པས་ནི་ནང་འགྱུ་བའི་ཀློང་རང་སངས་རྗེས་མེད་ཡངས་པ་ཆེན་པོར་བསྟན་པ་སྟེ།",
    "ཚིག་དེ་གཉིས་ཀ་གོ་བ་ཙམ་གྱིས་ཨ་ཁས་ང་ལོ་དུ་ལ་ལོན་འདུག་ངས་འཇིག་རྟེན་ཚེ་འདིའི་སྣང་བ་ཤར་ནས་མི་ལུས་ཤིག་བླངས་དང་ཚུན་ཆད་ནས་ད་ཡི་བར་གྱི་དེ་འདྲའི་ལོ་ཟླ་མང་པོའི་དུས་ཡུན་ལ་ཅི་ཞིག་བྱས་པར་འདུག་འཁོར་འདས་གཉིས་ཀའི་སོ་མཚམས་འབྱེད་བྱེད་ཀྱི་ཉམས་ལེན་གྱི་གཏད་སོ་ཅི་ཞིག་ཡོད་པ་ཡིན་སྙམ་དུས།",
    "དེ་སྔོན་ཉི་མ་ཡན་ཆད་ཀྱི་རང་རང་སོ་སོའི་མི་ཚེའི་བྱ་བ་ཕྱོགས་བསྡོམས་བྱས་ན།",
    "རང་བློ་རང་ལ་ཁེལ་ཆོག་པ་ཞིག་ནི་དཀའ་བའི་ཚད་དུ་ཕྱིན་འདུག་པས།",
    "སོ་སོའི་སྐྱེ་བོས་རང་རྒྱུགས་རང་ལ་འཕྲོད་པ་ཞིག་བྱུང་མི་འདུག་ན།",
    "མ་ཡེངས་པར་གནས་པའི་ཆ་ལ་འཇུག་དུས་ཀྱི་སྐབས་ཀྱང་ཡོད་ལ།",
    "རིག་པ་ངོ་འཕྲོད་ཕན་ཆད་རང་བབས་ཀྱི་བསམ་གཏན་ལ་གནས་པས་བདེ་གསལ་མི་རྟོག་པའི་ཉམས་ཆེད་ཀར་མ་བསྒྲབས་ཀྱང་རང་བཞིན་གྱིས་འཆར་ཞིང་།",
    "རིག་པ་ངོ་འཕྲོད་ཡོད་ཕན་ཆད་དེའི་རང་བབས་ཀྱི་བསམ་གཏན་ལ་རང་བཞིན་གྱིས་གནས་པ་ཡིན་པས་ན་བདེ་གསལ་མི་རྟོག་པའི་ཉམས་ཆེད་དུ་མ་བསྒྲབས་ཀྱང་རང་བཞིན་གྱིས་འཆར་ཞིང་།",
    "ངན་ན་དུད་འགྲོ་གཏི་མུག་ཅན་གྱི་རྒྱུ་རུ་འགྲོ་བར་འདུག་དགོངས་ནས་ཡི་མུག་པ་དང་།",
    "འདི་རྒྱ་གར་ཤར་མ་ལ་ངོས་འཛིན་བྱེད་དགོས་འདུག་སྙམ།",
    "མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱིས་དེང་སང་གེ་སར་གྱི་སྒྲང་ཡིག་ཙམ་མ་གཏོགས་ལྟ་མ་ཤེས་པར་འདུག།",
    "ད་འདི་ཚང་ལ་ཅི་ཡང་མེད་པས་སྐོརཚད་བཞག་པ་དེ་ཡང་རང་ག་རང་ག་ཡིན་པར་སེམས་མི་དགོས།",
    "ཚེ་ཟད་ས་ལ་ཐུག་དུས་མཐུད་རྒྱུ་ག་ལ་ཡོད།",
    "འདུག་རྒྱུ་ཙམ་ལས་ཐབས་མེད་པས།",
    "ཞག་ཉི་མའི་ཁ་གྲངས་འདི་ལྟ་བུ་ཞིག་ལ་འདུག་རྒྱུ་ཡོད་ཅེས་པའི་ཚད་ཅིག་ཡོད་ན།",
    "དེའི་བར་དུ་བློ་བདེ་བདེ་བྱས་ནས་འདུག་ཆོག་པ་ལྟ་བུ་ཡིན་ཡང་།",
    "ཤི་དུས་ཕན་ཐོགས་ཅན་གྱི་བྱ་བཞག་དེ་སྒབ་དགོས་བསམ་པ་ཁོ་ནས་ཆོག་པར་མི་འདུག་འཆི་བ་ནམ་ཡོང་མི་ཤེས་པ་དེས་ན་དང་པོར་ཤི་ན་སྐྲག་མི་དགོས་པ་ཞིག་ངེས་པར་བྱེད་དགོས་འདུག་དེ་ནས་གལ་སྲིད་མ་ཤི་ན་ཡང་བློ་བདེ་བར་སྡོད་ཆོག་པ་འདུག་འཆི་བའི་འཇིགས་སྐྲག་མེད་པའི་མི་ཚེ་དེ་བདེ་ཞིང་སྐྱིད་པ་ཞིག་འོང་བར་འདུག་སྙམ་པ་ཡིན།",
    "འབད་པར་མི་འདུག་པས་མི་ཚེ་ཆུད་ཟོས་སུ་མི་འགྲོ་ཞིང་།",
    "བདེ་བར་འདུག་བདེ་བར་འཆག་པར་གསུངས་ཤིང་།",
    "དེ་ལྟར་རང་གནས་དང་རང་ཤར་གཉིས་ལ་བཟང་ངན་མེད་པར་བསྟན་པ་དང་གསུམ་ལས།",
    "དགོངས་པའི་འདུག་ཚུལ་དེ་བཞིན་ནོ།",
    "ལུས་ཀྱི་འདུག་སྟངས་གཞིར་བྱས་ནས།",
    "དཀའ་ཐུབ་ཀྱི་བརྟུལ་ཞུགས་བརྟེན་པ་ཡང་མི་ཉུང་བ་འདི་ནང་ལ་ཡོད་འདུག་དེ་རྣམ་པས་ཡང་སྒོས་སྐུ་གཟུགས་ལ་ཐུགས་གཞག་མཛོད།",
    "གཞག་ཆེ་ཆུང་ཅི་དང་གང་ཞིག་ལ་ཇི་ལྟར་བྱས་ཏེ་འཇུག་ན་དགའ་འདུག་སྙམ་ན།",
    "འུ་གུ་སྤུན་ལོ་སྔར་བཞིན་དུ་ཨ་འགྲམ་སྤུན་གཉིས་གཤིབས་ནས་འདུག་རྒྱུ་དེ་ནི།",
    "ལྷོ་འབྲུག་རྒྱལ་ཁབ་གཅིག་ལ་ཡོད་ས་མི་འདུག་ཀྱང་།",
    "ངའི་ངོ་རིག་དུས་ཀན་གྱིས་ཁ་ཡག་ངོ་བསྟོད་དང་།",
    "ཅིག་ཤོས་ལ་ལྐོག་ཁ་གཏོང་བ་འདུག་ཀྱང་།",
    "ལ་ལས་གོང་བུའི་ནུས་པ་འདི་དང་འདི་ཚོ་མར་བཤིག་དགོས་འདུག་མ་གཏོགས།",
    "ངས་ཕྱི་རྟིང་གནམ་ལ་བཀྱགས་ནས་སྐེབསྲིང་ས་ལ་བར་དུ་གཅོད་འདུག་སྙམ་ནས།",
    "ད་ལྟའི་མིའི་མེ་འདི་བས་བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་བདུན་འགྱུར་གྱིས་ཚ་བ་དང་།",
    "དེའི་ཆ་ལ་རིག་ཆ་ཅིག་འདུག་པ་དེ་ཅར་ཕོག་ཏུ་ངོས་བཟུང་ནས།",
    "དོན་བསྡུ་བ་ནི། ག་གསུམ་པ་དེ་ལྟར་རང་གནས་དང་རང་ཤར་གཉིས་ལ་བཟང་ངན་མེད་པར་བསྟན་པ།",
    "དེ་ལྟར་རང་གནས་དང་རང་ཤར་གཉིས་ལ་བཟང་ངན་མེད་པར་བསྟན་པ་ནི།",
    "ད་ལྟ་སེམས་ལ་གང་བྱུང་རང་ཞིར་ཞོག།",
    "གནས་བཞིན་ད་ལྟ་བའི་སེམས་ལ་ཅི་ཤར་གང་བྱུང་རང་བཞིན་མཉམ་པའི་ངང་ལས་མ་འདས་བཞིན་དུ་ཞོག་དང་།",
