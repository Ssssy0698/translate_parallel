    "རྣམ་སྲས་སེར་ཆེན་སོགས་རྗེས་གནང་མང་པོ་ཞིག་གསན།",
    "ཉིན་ཞིག་གྲུབ་གནས་ལ་མཇལ་བར་ཕེབས་དུས།",
    "ཟླ་མཚམས་དང་ལོ་མཚམས་གང་མང་ཞིག་ལ་བསྡད་དེ་བསྙེན་པ་གང་མང་ཞིག་བཏང་།",
    "བྱེ་རུའི་སེར་འགོག་ཏུ་བསྡད་དེ།",
    "༢༧ལོར་ལོ་མཚམས་ལ་བཞུགས་པ་དང་ཆབས་ཅིག་ཆུ་མིག་དང་གཉན་བསྙེན་པ་གང་མང་ཞིག་རྫོགས།",
    "ལོ་འདིར་མཆོག་སྤྲུལ་གྲོལ་ལོའི་ཐུགས་བཀོད་བཞིན་སྔོན་འགྲོ་འབུམ་བཅུ་གདན་ཐོག་གཅིག་ནས་བསྒྲུབས་པས་ཐུགས་དགྱེས་པའི་བསྔགས་བརྗོད་ཟླ་མེད་གནང་།",
    "དྲོད་ཀྱིས་མ་བཏང་དེང་འདིར་ལྷག་པར་འཚེར།",
    "ཞོ་ར་གྲུབ་ཆེན་འཇིགས་མེད་མཐུ་སྟོབས་བཅས་བཞི་བྱུང་ཞེསགསུངས་པ་བཞིན་དུ།",
    "ཞོ་ར་མཐུ་སྟོབས་རྡོ་རྗེ་སྲས་ཆེ་བ་ཆོ་འཕྲུལ་སྐྱབས་དང་མགོན་པོ་རྣམ་གཉིས་ཀྱི་ཆེ་བ་ཆོ་འཕྲུལ་སྐྱབས་དང་གླིང་རྒྱ་བཟའ་ཀླུ་མཚོ་བྱམས་རྣམ་གཉིས་ཀྱིས་ཞོ་འོང་མཁར་ནང་ཞེས་པར་གཞི་བཟུང་སྐབས་སུ།",
    "ཡེ་ཤེས་ལྷ་སྒྲོན་རྣམས་སོ།",
    "ཕྱི་ནང་ཀུན་ཏུ་འགལ་བ་གཅིག་ཀྱང་མེད་པར་བཟོས་ནས་ཀུན་མཐུན་གསེར་གྱི་ཞགས་པ་རིང་དུ་བརྐྱངས་པའི་ཉིན་ལྟའི་ལྕགས་ཐར་འབུམ་གྱི་བཀའ་དྲིན་ནི་བརྗོད་ཀྱིས་མི་ལང་ཞེས་ཀུན་གྱིས་བསྔགས་བརྗོད་ཕུལ་ཞེས་པ་ལྟར།",
    "ཤར་རྡོ་རྗེ་སེམས་དཔར་ཁ་འཁོར་ནས།",
    "དམག་མི་གཅིག་བསད་དེ་མཁར་སྔོན་འཇམ་དབྱངས་དང་ལྷན་དུ་བླ་བྲང་ཕྱོགས་སུ་བྲོས་བྱོལ་ཏུ་ཕེབས།",
    "ཟླ་ལྔ་པར་ཆུ་དམར་སྐུ་ཕྲེང་དྲུག་པ་ཡོན་ཏན་རྒྱ་མཚོ་ལྔ་བའི་མ་ཎིའི་ཚོགས་མགོར་ཕེབས་ཏེ།",
    "དམག་དཔོན་ཁང་བཅས་ལ་རབ་གནས་གནང་བ་མ་ཟད།",
    "བར་ཆད་ལམ་སེལ་སོགས་ཀྱི་ལུང་གནང་སྟེ་ལྷ་ཁང་ལ་རབ་གནས་མཛད།",
    "ནང་རྟེན་གྱི་གཙོ་བོར་ཨོ་རྒྱན་གཙོ་རྗེ་འབངས་ཉེར་ལྔ་བཞུགས་པ།་",
    "ཛམ་དཀར་གཙོ་བྱས་པའི་ཛམ་ལྷ་རིགས་ལྔའི་གྱན་ཐང་དང་།",
    "ཛམ་དམར་གཙོ་བྱས་པའི་ཛམ་ལྷ་རིགས་ལྔའི་གྱན་ཐང་།",
    "འབག་ལས་དཔལ་ལྡན་གྱིས་གཙོ་འགན་བཞེས་ཏེ་བོན་གྱི་གསས་ཁང་བཀོད་ལེགས་ཤིག་བཞེངས་པར་མི་འགྱུར་གཡུང་དྲུང་གླིང་དུ་མཚན་གསོལ།",
    "ཡར་ཀའི་མཁའ་འགྲོ་སོགས་གཙོར་བྱས་ཏེ།",
    "གཡོན་དུ་བོན་གྱི་རྗེ་ཉམས་མེད་ཀྱི་འབག་སྐུའི་གཟུངས་བཞུགས་སུ་རང་ཤར་རིག་གྲོལ་དང་།",
    "རྣམ་མཁྱེན།",
    "སོགས་གསས་ཁང་མི་འགྱུར་གཡུང་དྲུང་གླིང་དུ་བཞུགས་སོ།",
    "རྫིང་བུའི་འགྲམ་ཡིན་པས་ས་བརླན་པ་སོགས་ཀྱི་རྐྱེན་གྱིས་ཉམས་ཉེས་ཐེབས་པར།",
    "གཉན་དམར་རི་བོར་ཁ་གཏད་དེ་གྲུ་བཞི་བང་རིམ་བཞི་གློ་འབུར་དང་བཅས་པ་བདུད་འདུལ་མཆོད་རྟེན་ཤིན་ཏུ་བཀོད་ལེགས་ཀུན་གྱིས་དང་བ་འདྲེན་པ་ཞིག་ལེགས་པར་གྲུབ་ཅིང་།",
    "སེ་རའི་རྟ་མགྲིན་གྱི་ན་བཟའ་བྱིན་ལྡན་སོགས་གཙོར་བྱས་སྐུ་གསུང་ཐུགས་རྟེན་ཅི་བཞུགས་དང་།",
    "མཁར་ཕྱིའི་ཤར་ཕྱོགས་གོམ་པ་ཉི་ཤུའི་མཚམས་སུ་དམག་དཔོན་ཁང་གསར་བ་གྱན་བཅུ་གཞི་གྱང་དང་བཅས་པ་བདེ་ལེགས་ངང་གྲུབ་པར་མཛད།",
    "སེང་ཆེན་ནོར་བུ་དགྲ་འདུལ་ཞི་དྲག་གཉིས་ཀྱི་ཐང་ཀ་བཅས་ལོ་དེའི་ཟླ་བཅུ་པའི་ནང་གྲུབ་པར་མཛད་ཅིང་།",
    "ཡར་ངོའི་ཚེས་བརྒྱད་ཀྱི་ཉིན་ཧྲིལ་བོར་འདོན་ཆ་སྔར་གྱི་དེ་གའི་འཐུས་པར་མཛད་དེ་ཚེས་བཅུ་འཚོགས་བཞིན་ཡོད།",
    "ཐན་པ་སོགས་ཀྱིས་མི་གནོད་པར་ལྷ་ལ་སྐྱབས་འཇུག་ཞུ་བ་དང་།",
    "གྱིས་ཟན་ལིང་བསྒྲལ་ནས་བཟློག་པ་འཕེན་པར་བྱེད།",
    "སྤྱིར་སྔོན་གྱི་དུས་སུ་སྐབས་དེར་བོན་པོ་མང་ཆེ་ཤོས་མཚམས་ལ་བསྡད་ཡོད་པས།",
    "སྐྱེས་པ་ཚོར་སྐྱེམས་ཆང་ལ་རོལ་བའི་ལུགས་སྲོལ་མཆིས་པ་རྣམས་ལས་འཆམ་མ་གཏོགས་དེང་སང་ཀྱང་རྒྱུན་མ་ཉམས་པར་ཡོད་དོ།",
    "རྒྱབ་ན་ཁྲ་ལྟར་སྡང་བ་སོགས་མི་མཐུན་པའི་ཕྱོགས་སེལ་བར་བྱེད་པའི་བྱང་བུ་བཅས་ཉིན་ལྟར་ཚགས་སུ་ཆུད་པར་བྱེད།",
    "སྔོན་པོ་ལྕགས་ཀྱི་མདེའུ་སྤྲད་དེ་ལྟོང་ལ་འབྲུ་མར་སེར་བོ་བྱུགས་ཤིང་མགུལ་དུ་དར་ཟབ་སྣ་ལྔ་བཏགས་པ་ཞིག་ཡིན་དགོས་ལ་མདའ་ཡི་བྱུང་ཚུལ་དང་མཚོན་དོན་སོགས་གཞུང་དངོས་སྒྲིབ་པར་དོགས་པས་འདིར་མ་བརྗོད་དོ་དེ་ལབ་ཙེའི་ནང་དུ་བསྟད་རྗེས།",
    "ཝེར་མ་བཅུ་གསུམ་གྱི་དམུ་ཐག་སོགས་ཡར་ལ་དྲོངས་ཞེས་འདོན་ཆོག་ཏུ་གསུངས་པ་བཞིན་དམུ་ཐག་འཐེན་མཁན་གྱིས་ཀྱང་དེ་ལྟར་དུ་བསམ་ནས་དམུ་ཐག་འཐེན་དགོས་པ་དང་།",
    "ས་བདག་ཀླུ་གཉན་ལ་འབུལ་བ་དང་བསྔོ་བ་བྱས་ཏེ་མི་གཡང་ཕྱྭ་གཡང་ཐོབ་པར་བསམ་ཏེ་ཕུལ་དགོས་ལ།",
    "མཇུག་ཏུ་ཕྱྭ་གཡང་དངོས་གྲུབ་གནང་བ་སོགས་ལབ་ཙེ་བསྟོད་པའི་ཆོ་ག་ཡོངས་སུ་གྲུབ་རྗེས།",
    "ཁ་བཏགས་དང་གོས་དར་སྣ་ཚོགས་ཀྱིས་ཆིབས་པར་སྲུང་འདོགས་པར་བྱེད་དོ།",
    "ཐག་འཐེན་གླུ་ཤགས་སོགས་རིག་རྩལ་སྣ་ཚོགས་ལ་རོལ་བ་དང་།",
    "པར་མཆིས།",
    "པྲ་ཕབ་དེས་ཀྱང་ཁས་ལེན་བྱས་ཏེ་ཐོག་མར་ལ་ཕུག་ཅིག་དུམ་བུ་མང་པོར་གཤགས་ཏེ།",
    "རི་བོའི་རྐེད་པར་སྲས་གཉན་གྱི་ལབ་ཙེ།",
