    "གཏོང་བ་རྗེས་སུ་དྲན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྐྱོ་བ་རྗེས་སུ་དྲན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དབུགས་ཕྱི་ནང་དུ་རྒྱུ་བ་རྗེས་སུ་དྲན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "འཆི་བ་རྗེས་སུ་དྲན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ལུས་ཀྱི་རྣམ་པ་རྗེས་སུ་དྲན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མྱི་རྟག་པའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྡུག་བསྔལ་གྱི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བདག་མྱེད་པའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མྱི་སྡུག་པའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དངོས་པོ་མྱེད་པའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བདག་གི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྲོག་གི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྐྱེ་བའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྐྱེས་བུའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "གང་ཟག་གི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཤེད་ཅན་གྱི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཤེད་བདག་གི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བྱེད་པ་པོའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཚོར་བ་པོའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཤེས་པ་པོའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མཐོང་བ་པོའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རྟག་པའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བདེ་བའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྡུག་པའི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བདག་གི་འདུ་ཤེས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྟོབས་རྣམས་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ལམ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མཚན་མ་མྱེད་པའི་ཏིང་ངེ་འཛིན་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མི་སྒོམ་མོ།",
    "སྨོན་པ་མྱེད་པའི་ཏིང་ངེ་འཛིན་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རྟོག་པ་དང་བཅས་དཔྱོད་པ་དང་བཅས་པའི་ཏིང་ངེ་འཛིན་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རྟོག་པ་མྱེད་ལ་དཔྱོད་པ་ཙམ་གྱི་ཏིང་ངེ་འཛིན་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རྟོག་པ་མྱེད་ཅིང་དཔྱོད་པ་མྱེད་པའི་ཏིང་ངེ་འཛིན་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྡུག་བསྔལ་འཕགས་པའི་བདེན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "འགོག་པ་འཕགས་པའི་བདེན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ལམ་འཕགས་པའི་བདེན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྡུག་བསྔལ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "འགོག་པ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ལམ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཟད་པ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མྱི་སྐྱེ་བ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རྗེས་སུ་འགྲོ་བ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཀུན་རྫོབ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "འདྲིས་པ་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྒྲ་ཇི་བཞིན་ཤེས་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ནང་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཕྱི་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མི་སྒོམ་མོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "གཟུངས་ཀྱི་སྒོ་ཐམས་ཅད་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "མྱི་འཇིགས་པ་བཞི་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།",
    "བྱམས་པ་ཆེན་པོ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མྱི་སྒོམ་མོ།"
