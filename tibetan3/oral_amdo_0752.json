    "མྱིག་གི་རྣམ་པར་ཤེས་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བརྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་པ་དང་མྱི་རྟག་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བ་དང་སྡུག་བསྔལ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་དང་བདག་མྱེད་ཅེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཞི་བ་དང་མ་ཞི་བ་ཞེས་བྱ་བར་མྱི་སྤྲོ་བ་འཕྲོ་བར་མྱི་བྱེད་དོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
