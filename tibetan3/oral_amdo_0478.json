    "པོ་ཏ་ལའི་སྲོང་བཙན་སྒྲུབ་ཕུག་གི་མེས་སྲོང་བཙན་གྱི་སྐུ་བརྙན་ལ་ཡོད་མོད།",
    "དབྱིག་མོ་འདབ་མ་སྦུག་མོ་ཆེ་བ་དང་།",
    "རྒྱ་ནག་གི་བཟོ་རྙིང་རྒྱུན་ལས་བྱུང་བའི་རྒྱུ་ཁྲོ་ལི་སྨུག་པོའི་ལྷ་རྣམས་ནི།",
    "ཞལ་རས་ཀྱི་ཁྱོན་དོག་ཅིང་ཤ་ཚུགས་སྡིག་ལ་ཞལ་སྒོ་ཅུང་ཀོང་བ།",
    "ཁྲི་གདན་རྒྱ་ཡིག་དང་རྒྱ་ནག་གི་མཆོད་རྫས་ཀྱི་གཟོང་རིས་ཅན།",
    "ཕྱག་ཞབས་ཀྱི་སོར་མོ་སྒྲོས་མི་གཙང་ཞིང་རྒྱུན་ཧ་ཅང་མི་མང་བ།",
    "ཁ་ཤ་ནི་ཡུལ་གྱི་མིང་སྟེ་དེང་གི་སོག་ཡུལ་དུ་གཏོགས་ལ།",
    "གཡོ་རུ་ཁྲ་འབྲུག་གི་ལི་མ་ཕལ་ཆེ་ཁ་ཤའི་ལི་མ་ཡིན་པར་བཤད།",
    "ཕྱག་ཞབས་གཞོན་ཤ་ཆགས་ཤིང་སོར་མོ་ཐུང་བ།",
    "ན་བཟའ་ལྷུབ་ཅིང་གོས་འཁྱུད་ཀྱི་རི་མོ་རྩིང་ཞིབ་རན་པ།",
    "ཙནྡན་སོགས་ཤིང་གི་རིགས་དང་།",
    "ལྡེབས་རིས་དང་མཆོད་རྟེན་སོགས་ཀྱི་བཟོ་ཕལ་མོ་ཆེ་ཞིག་བོད་ལུགས་སུ་བྱས་པར་བརྟགས་ན།",
    "རྒྱ་ནག་གི་ལྷ་ལ་རྙིང་མ་དང་གསར་མ་གཉིས་ཡོད་པ་ལས།",
    "ཕྱག་ཅུང་ཐུང་ཞིང་སོར་མོ་དོད་པ།",
    "རེ་འགའ་ལྷ་དང་རྒྱལ་པོའི་དབྱིབས་དོད་ཙམ་པ།",
    "ཞལ་གཟོང་གིས་བྲད་ཙམ་བྱས་པའང་འགའ་ཡོད་པར་སྣང་།",
    "རྒྱ་བོད་ཧོར་སོག་གི་ཡུལ་དུ་གང་མཐོང་བའི་འབྲེལ་ཡོད་ཀྱི་ཤེས་བྱ་ཕྲན་བུས་ཁ་བསྐོངས་ཏེ་བྲིས་ཀྱང་།",
    "ལེགས་དང་ཉེས་པའི་སྐྱོན་ཡོན་ལ་སོགས་པ་ཇི་སྙེད་ཀྱི་ཤེས་བྱ་ཐམས་ཅད་ཤེས་པར་བྱེད་འདོད་པའི་བློ་གསར་དག་གིས།",
    "ཡིན་ན་ཡང་སློབ་དཔོན་གྱི་མིང་འཛིན་པ་ཙམ་གྱིས་ཐམས་ཅད་མཁས་པ་དང་སློབ་དཔོན་མཚན་ཉིད་དང་ལྡན་པ་ཡིན་པའི་ངེས་པ་མེད་མོད།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་གཉིས་ཀྱི་མཚན་ཉིད་ཀྱི་དེ་ཁོ་ན་ཉིད་སྟོན་པ་བཅས་བཞིར་གསུངས་པ་དང་།",
    "ཚིག་གི་བྱ་བ་ལྡན་པའོ།",
    "སྤྱིར་ན་དེང་དུས་སུ་གོང་གི་ཡོན་ཏན་ཐམས་ཅད་ཚང་བའི་སློབ་དཔོན་ཉུང་ཞིང་བཟོའི་གནས་ལ་མཁས་ཤིང་ཐམས་ཅད་ཚང་བ་དེ་བས་ཀྱང་དཀོན་པ་དང་།",
    "ཡོན་ཏན་མེད་ལ་ཐུན་མོང་ཁྱད་པར་གྱིས།",
    "བཟོ་ལ་འཇུག་པའི་མོས་པ་དང་བླང་བྱ་བརྟན་པོ་ཡོད་པ་མ་ཟད།",
    "ལུས་ངག་གི་དཀའ་དཔྱད་ལ་ཡི་སྐྱོ་བའི་བཟོད་པ་དང་།",
    "དད་བརྩོན་དྲན་ཤེས་བརྟན་པོ་ཉིན་རེ་བཞིན།",
    "ཞེས་ཤེས་བྱའི་སྒོར་ཞུགས་པའི་ཐོག་མ་ནས་བག་རྣལ་དུ་ཕབས་ནས་ཉིན་རེ་བཞིན་དུ།",
    "དོན་གྱི་རྒན་པོ་ཚིག་གི་འཁར་བ་ལ།",
    "ཉིན་རེ་འགྲོ་ཐབས་དེས་ཀྱང་མི་ཕན་པས།",
    "དོན་ལ་བརྟག་དཔྱད་ཞིབ་མོར་གྱིས་ཤིག་ཨང་།",
    "ཡང་ཉིན་རེ་ཟས་ཀྱང་མི་དྲན་བརྩོན་འགྲུས་རྩོམ།",
    "ཡུན་རིང་མ་ལོན་པར་རྩེད་མོ་སོགས་ལ་གཡེང་བ་དང་།",
    "ཡང་ན་ཤེས་བྱའི་སྒོར་ཞུགས་པ་ཙམ་གྱི་མཁས་པའི་གོ་འཕང་རེ་བ་དང་།",
    "པདྨ་ལ་སོགས་ཤིན་ཏུ་སླ་ཞིང་རྩ་བའི་རི་མོ་སྦྱངས་པ་དང་ལྷན་དུ།",
    "ཐོག་མར་ཐིག་ལ་བརྟེན་པའི་རི་མོ་ཡུན་དུ་སྦྱངས་ནས་ཤིན་ཏུ་བྱང་བར་གྱུར་པ་ན།",
    "ཆ་ཚད་བྱང་ཞིང་རི་མོ་ཚད་དང་ལྡན་མིན་བརྟག་ཐབས་སུ།",
    "གཤིན་རྗེ་གཤེད་དམར་ནག་གི་རྒྱུད།",
    "ཞེས་ཟེར་བ་བཞིན་སྦྱངས་ཏེ་གཞུང་ལུགས་ཀྱི་ཚིག་གི་བརྡར་ཤ་ཆོད་པ།",
    "རྒྱུན་ཕྲ་མོ་ཙམ་ཚུན་ཆད་ཀྱི་ཀྱང་དོན་རེ་མཚོན་པ་ཡིན་པས།",
    "རང་གི་སྤྱོད་ལམ་ལ་རྒྱུན་མི་ཆད་པར་བརྟགས་ཏེ་ཡ་རབ་གོང་མའི་སྤྱོད་ལམ་ཇི་བཞིན་སྐྱོང་བ་གལ་ཆེ་ལ།",
    "ལག་ཤེས་ཅུང་ཤེས་པ་ཙམ་ནས་གཞན་གྱི་བཀུར་བ་དང་ཡོན་དུ་རེ་བའི་ཀུན་སློང་ནི་རང་གཞན་གཉིས་ཀར་ཕན་པ་ཞན་པའི་ལས་ལ་འཇུག་པ་སྟེ་འགའ་ཞིག་གིས་རྙེད་པའི་ཆེད་དུ་མགྱོགས་བྲིས་ཀྱིས་བྲིས་སྟངས་རན་ཙམ་རན་ཙམ་བྱས།",
    "སྤང་བླང་གི་གནས་ལ་མཁས་པ་མ་བྱས་ན།",
    "ནོར་དུ་རེ་བའི་འདོད་ཆགས་དང་།",
    "དེ་ཡི་འགྲོ་བ་ངན་སོང་གསུམ།",
    "དུལ་ཞིང་དད་ལྡན་ལང་ཚོར་འབབ།",
    "འཇུག་ལྡོག་གི་གནས་བཟོའི་གནས་ཀུན་ལ་མཁས་ཤིང་།"
  ]
}