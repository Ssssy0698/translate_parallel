    "རྒྱབ་ཤ་བཅས་གསོལ་རས་ཞུས་སྩལ་བྱུང་འཕྲལ་ཁལ་དྲེལ་བཅུའི་སྒ་གདན་གསར་བཟོ་བྱས་ཏེ་གཉེར་ཚང་ནང་རྩིག་འཇོག་བྱས།",
    "ལྷན་གཞིས་ཀ་བཀྲས་ལྷུན་ཛ་བླ་སྐུ་གསར་རོང་དཔལ་ལྷུན་ཐུབ་བསྟན་བསམ་འཕེལ་གསར་ཕེབས་ཀྱི་ཕོགས་རྟེན་དུ་རྩིས་འབུལ་ཞུ་རྒྱུར།",
    "ལྷན་གཞིས་ལོ་བདུན་དང་ཕྱེད་ཟིན་རྗེས་སྐུ་གསར་རོང་དཔལ་ལྷུན་པའི་ཞབས་སྡོད་སྐུ་ཞབས་ལ་རྩིས་འབུལ་ཞུ་སྐབས་སྤྲོད་འབྲུའི་ཁོངས་ནས་ཆུ་འབྲུག་མ་འབྲུའི་ཁ་སྣོན་ཞེས་པ་སྔར་ལམ་མ་བཞེས་པར་ལག་ཞོར་དུ་དགོས་ལུགས་འགན་བཞེས་གནང་བ་དང་།",
    "ཕྱོགས་དེར་ལྷན་གཞིས་སྐུ་གསར་ལ་སྤྲོད་འབྲུས་མཚོན་པའི་ཡང་ཆད་རྩག་རྩིག་སྣེ་མང་འབུལ་ལུས་གན་འཛིན་འབུལ་བཞེས་གནང་བ་ཙམ་མ་ཟད།",
    "གསེར་ཏོག་ཅན་སོགས་ལ་རྩིས་ཞིབ་ཞུ་རྒྱུར་ལུས་པ་རྣམས་ཀྱི་ཆེད་གཉེར་ཚབ་ཅིག་ས་གནས་སུ་ངེས་པར་གཏོང་དགོས་པ་དང་།",
    "བུ་ཀུན་བཟང་ལགས་ཕེབས་ན་ཕྲན་ནས་ད་ལྟ་ནས་རོགས་རམ་ཞུ་ཐུབ་མིན་ཞུས་ཡོད་ཚོད།",
    "སླད་ཕྱིན་གཟིམ་ཤག་དང་སྐྱིད་སྡུག་གཅིག་པ་བྱས་ཀྱང་འཐུས་རྒྱུར།",
    "མཐུན་གྲུབ་གན་འཛིན་གནང་འཐུས་གསུངས་ཀྱང་།",
    "གུས་ནས་གཟིམ་ཤག་དང་སྐྱིད་སྡུག་ཐུགས་འདོད་གཅིག་པ་ཞུ་མ་དགོས་པར་སྐལ་འབབ་གསོལ་རས་གང་གནང་ཞིག་སྐྱབས་འཇུག་ཡོང་བ་ཞུས།",
    "ཐག་ཆོད་ལམ་རོབ་ཟིན་ཡོད་ཚོད་ཀྱིས་གུས་པར་སྐུ་ངོ་མཆོག་ནས་ད་ལམ་གསོལ་རས་སྐལ་འབབ་མཚོན་ཆེད་ཊམ་རྡོ་བརྒྱ་ལས་མ་བྱུང་ཡང་།",
    "དེ་དོན་ལྷ་ས་ནས་གཞིས་སྡོད་འགོ་པ་གནམ་གང་ལགས་སྤྲོད་དཔང་དུ་ཆབས་ཅིག་ཐོན་བསྐྱོད་ཀྱིས་ལྷན་ལྷུན་གཞིས་སུ་འཛིན་ཆས་དངོས་རིགས་གང་ཡོད་ལག་འཛིན་ཞིབ་ཕྲ་གསར་བཀོད་ནང་གསལ་དང་།",
    "སླར་ས་གནས་སུ་ལས་དོན་དངོས་སུ་གནང་སྐབས་འདས་གསོན་དབར་ཡིན་སྟབས།",
    "འོན་ཀྱང་ཕྱོགས་དེར་གཞིས་འཛིན་གསར་རྙིང་གཉིས་ཀྱི་མིང་ཁུར་དཔུང་པ་མཉམ་གཤིབས་བྱས་ཏེ་ལོ་ལྔ་ཙམ་གྱི་ནང་སྤྱན་ཞིང་བླངས་པའི་ཁྱིམ་ཚང་ཐ་ཞན་སུམ་ཅུ་ཙམ་གྱི་ཕ་རྒན་དང་།",
    "འདི་ལོའི་སྟོན་འབྲས་འདེབས་སོན་ཞུས་ཟིན་པར་བརྟེན་སྔར་རྒྱུན་རང་འཇགས་འབུལ་དགོས་གསུངས་ཏེ་ཐག་བཅད།",
    "གད་པ་ཕུན་ཚོགས་ཀྱིས་ཕྲན་གྱི་མི་ཚབ་བྱས་ཏེ་ཕན་ཐོགས་ཞུས་པ་ནི་དངོས་ཡོད་གནས་ཚུལ་ཡིན།",
    "༡༩༣༩ ལོ་ཙམ་ལ་རྒྱ་མིས་བོད་ཤར་རྒྱུད་ནས་ཁ་མཁས་ཞི་འཇམ་གྱི་རྣམ་པས་བཙན་འཛུལ་གྱིས་ཐོག་མར་བྱང་སྤྱི་མཁན་ཆུང་ཐུབ་བསྟན་བཟང་པོ་ལགས་དང་།",
    "འོན་ལྷོ་སྤྱིར་བསྐོ་གཞག་སྐུ་ངོ་མཆོག་ལྷོ་ཁ་སྤྱི་ཁྱབ་ཏུ་བསྐོ་གཞག་གནང་དོན་ས་གནས་སུ་ཕེབས་རྒྱུའི་ཞབས་གྲས་སུ་ཕྲན་ངོ་བཅར་ཞུ་སྐབས།",
    "རྒྱ་མི་བཟའ་ཚོ་གཉིས་སྐུ་ངོའི་སར་ནང་ཚགས་བྱས་ཏེ་ཡང་ཡང་བཅར་གྱི་ཡོད་ཚོད།",
    "སྐུ་ངོ་མཆོག་རྒྱ་མིའི་རྗེས་འདེད་ལ་ཆིབས་བསྒྱུར་གནང་མི་དགོས།",
    "ལྷོ་ཁ་སྤྱི་ཁྱབ་གནང་ཡུན་རིང་རྐུན་བུ་མིང་ཅན་རྟ་གདོང་དང་།",
    "སོན་འགྲོ་རྡོག་སྐོར་གནང་འོས་གནང་ཡང་ཕན་ཚུན་གཉིས་ནས་ས་མཚམས་ཐོག་ཧམ་པ་ཤོད་ཀྱི་ཡོད་ཚོད།",
    "སྐུ་ངོ་མཆོག་ནས་སྐུ་ཚབ་ཚོར་ས་དབྱིབས་ལ་བལྟས་ན་འདི་ཡན་ཆད་ཤག་བྱང་དང་།",
    "ས་མཚམས་ཀྱི་ཐད་དབྱེ་ཞིབ་དྲང་འདོམས་གང་ཆེ་གནང་བ་ཕྱོགས་དེའི་འགོ་གཙོ་ཕལ་ཆེ་བས་མཁྱེན་གྱི་ཡོད་ཚོད།",
    "མི་སེར་ཐ་ཞན་ལ་བདེན་པ་ཡོད་ཕྱིན་ཡ་ལན་ཞུ་བརྒྱུད་དེ་ཙམ་མ་ཐུབ་ཀྱང་དོན་དུ་རོགས་རམ་གནང་མུས་ལ་བརྟེན།",
    "དེ་སྐབས་འཇའ་ཚོན་བཀྲག་གདངས་གང་ལེགས་ཤིག་དབུ་རྩེའི་བྲག་ཕུག་ནས་སྣེ་གཅིག་སྐུ་ངོ་གར་ཕེབས་ཀྱི་སྣ་ལོར་ཟུག་པ་ཀུན་གྱིས་མངོན་སུམ་མཐོང་བས་ཡ་མཚན་ཆེན་པོར་བརྩིས།",
    "ཕྱི་ལོ་༡༩༤ ཙམ་ལ་ལྷོ་ཁ་སྤྱི་ཁྱབ་གནང་མུས་ཐོག་རང་གཞུང་བཀའ་འབྲེལ་དབྱིན་ལེནྡྲ་དོན་གཅོད་དུ་ཕེབས་རྒྱུའི་ཕྱག་སྦྲེལ་གཡུ་ཐོག་ཛ་སག་བཀྲ་ཤིས་དོན་གྲུབ་དང་།",
    "ཤོད་དྲུང་ས་འདུ་རིན་ཆེན་དོན་གྲུབ་ལགས་བཅས་ཕེབས་རྒྱུའི་བཀའ་བསྒྱུར་ཐོན་པ་དང་།",
    "སྐུ་ངོ་མཆོག་ཕེབས་ཚེས་ངེས་བརྟན་གྱིས་ལྷོ་ཁ་ནས་ཆེད་མངགས་རྒྱལ་རྩེར་ཕེབས་འབྱོར་བཞིན་དབྱིན་ལེནྡྲ་དུ་ཞབས་ཞུར་བཅར་དགོས་པ་དང་།",
    "དེ་མིན་ལས་དོན་གང་ཅིར་ཁམས་དྭངས་གད་གཙང་ཡོང་བའི་བཀོད་མངགས་གནང་།",
    "རྒྱལ་རྩེར་ཉིན་གཉིས་ཙམ་ཐུགས་འགོར་འབྱུང་ན་ལས་དེ་མིན་ཤར་ཕེབས་གནང་དགོས་པར་བརྟེན།",
    "སྐུ་ངོ་ལྷན་རྒྱས་སྐལ་བཟང་ཟམ་པ་བརྒྱུད་ཕེབས་པ་དང་།",
    "རྟ་དྲེལ་དང་ཞབས་གྲས་རྣམས་ཀ་སྦུག་ནས་ཕྱིར་སློག་གནང་རྒྱུ་བྱས།",
    "བལ་ཡུལ་བཅས་རྒྱལ་ཁབ་ལྔ་ལ་དོན་གཅོད་དུ་ཕེབས་མི་མཁན་རིམ་ངོ་ལས་རྣམས་ཛ་དྲག་ལྟ་བུར་རྒྱལ་རྩེར་ཕེབས།",
    "མེད་ཚེ་ལྷོ་ཁ་སྤྱི་ཁྱབ་ས་གནས་སུ་ཕྱིར་ལོག་ཆོག་པའི་བཀའ་ལན་ཡོང་བ་ཞེས་སྙན་འབུལ་ཞུས་པར།",
    "སྔ་འཕྲོས་ས་གནས་སུ་ཕྱིར་ལོག་གནང་ན་འཐུས་རྒྱུ་ཡང་ངེས་མེད་ཕྱི་རྒྱལ་ལ་ཕེབས་དགོས་བྱུང་ཚེ་ཐུགས་གཏན་སྔོན་འཁེལ་བཞིན་ཐོན་ཆོག་ཨང་གསར་དགོས་པ་དང་།"
  ]
}