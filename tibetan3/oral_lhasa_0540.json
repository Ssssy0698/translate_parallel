    "གྲྭ་བཞི་བརྒྱ་དཔོན་སྐལ་བཟང་དགྲ་འདུལ་ལགས་རྣམ་གཉིས་ཤོ་རོང་དུ་ཕེབས་ནས།",
    "དེ་མིན་གཞིས་ཁོངས་ནས་ཕྱིར་འདོན་བྱ་རྒྱུ་ཡིན་ཞེས་བཀའ་གནང་སྟེ་ལྷིང་འཇགས་བྱུང་བའི་གནས་ཚུལ་གོ་ཐོས་བྱུང་།",
    "དེ་རྗེས་ཚང་མ་རུ་བསྟར་ཐོག་ཧིན་བོད་རྒྱལ་དར་ཁྱེར་ནས་ཁྲོམ་སྐོར་གྲུབ་མཚམས་རང་གནས་སུ་ལོག་དེ་ནས་དབྱར་དུས་རིང་ལ་རྒྱབ་བྷ་རཱ་ཌོ་ནི་ས་གནས་སུ་བསྡད།",
    "ལམ་སྤྱི་བྱམས་ཕུན་ལགས་ཀྱིས།",
    "དེ་ནས་༡༩༧ ལོའི་ཟླ་༡ ཚེས་ཤར་ལ་ནང་ལྷན་ནས་བཀོད་རྒྱ་སྤྱི་ཕེབས་དགོངས་དོན།",
    "སྐྱོབ་གསོ་སོགས་མེད་པས་དེ་དོན་བསམ་ཞིབ་ཀྱིས་བྱ་བདེའི་ལན་གསལ་འཕྲལ་འབུལ་ཞུ་དགོས་ཞེས་ཕེབས་བྱུང་།",
    "དེ་ནས་ལམ་སྤྱིས་གསུངས་དོན་ལྟར་ཕྲན་རང་བུ་གསོ་ཁང་དུ་སློབ་ཕྲུག་རྣམས་དང་མ་མ་ཚོར་ལས་ཞོར་སློབ་སྦྱོང་སྤྲད་དེ་སྡོད་མུར།",
    "ལྷ་ས་བ་ཆུང་བདག་ཟེར་བས་རྩ་བའི་མ་བྱན་གྱི་རོགས་པ་དང་།",
    "གང་ཡིན་དྲིས་པར།",
    "ཡར་ཆིབས་སྒྱུར་གནང་རོགས་ཞེས་གུར་ནང་གདན་འདྲེན་ཞུས།",
    "སྐུ་མདུན་ལ་བཅར་ཏེ་ཕྱག་འབུལ་ཞུས་པར་ཁྱེད་གཉིས་ག་པར་འགྲོ་མཁན་ཡིན་ནམ་གསུངས་བྱུང་།",
    "ང་གཉིས་ལམ་སྤྱིའི་སར་འགྲོ་མཁན་ཡིན་ཞུས་པར།",
    "ད་ག་རང་ཡིན་གསུངས་བྱུང་།",
    "ལམ་སྤྱི་དང་འགོ་བརྒྱ་རྣམས་འཛོམས་རྒྱུ་བྱས་ན་ཞེས་བཀའ་གནང་བྱུང་།",
    "ཁོང་རྣམས་ལ་གསོལ་ཚིགས་གྲ་སྒྲིག་དགོས་མིན་དགོངས་སྐོར་ཞུས་པར།",
    "དབུ་གུར་དུ་ཚང་མ་ཞབས་སྟེགས་ཐོག་འཁོད་མཚམས་གསོལ་ཇ་ཞལ་ཏོག་ཕུལ་ཏེ་ལྷོད་བཞུགས་གནང་རིང་།",
    "ལམ་སྤྱི་བྱམས་ཕུན་ལགས་ནས་བཙན་བྱོལ་བོད་མིའི་གནས་སྟངས་དང་།",
    "དེ་ནས་དིལླིར་ཐོན་ཏེ་ལ་དྭགས་དྷ་རམ་ས་ལར་བསྡད།",
    "དེ་ནས་ཐོན་ཏེ་དགེ་སློང་ལགས་སར་བསྡད་པ་ཡིན།",
    "ངས་སང་ཉིན་མེ་འཁོར་ལ་ཕེབས་ཐུབ་པ་བྱས་ཡོང་ཞེས་དབྱངས་སྐྱིད་ལགས་ཀྱིས་གསུངས་བྱུང་།",
    "དེ་ནས་དགེ་སློང་ལགས་ཀྱིས།",
    "དགེ་སློང་ལགས་ཀྱིས་དེ་སྐོར་ཀུཀླུ་དང་།",
    "ནང་སྲིད་གང་དུ་འགྲོ་དགོས་བྱུང་ཡང་ཕེབས་ཆོག་གསུངས་སྟབས་བློ་བདེར་གྱུར།",
    "སང་ཉིན་ཆིབས་ཐོན་གནང་རྒྱུའི་དེ་རིང་དགོང་དྲོ་མཇལ་ཁ་ཞིག་༧སྙན་སེང་ཞུས་འབྲེལ་ཧོར་གན་མི་མང་ཡོངས་ཀྱི་༧སྐྱབས་ཞུའི་རྟེན་ཡིན་ཞེས་འབུལ་ལམ་ཞུས་རྗེས་ཆིབས་སྒྱུར་གྲུབ།",
    "གཞོན་ནུ་དཔར་པ་གཅིག་བཅས་རྒྱ་མིའི་གཞུང་ཚབ་ཁང་དུ་ཕྱིན།",
    "དོན་གཅོད་ཚེ་རྡོར་ལགས་ནས།",
    "གཞན་གཉིས་པོ་ཡེ་ཤེས་དབྱིངས་དཔྱད་ཀྱིས་སྨིན་སྩོལ་ཡོང་བའི་སྙན་གསོལ་བཀའ་ལན་ཕྱིར་ཕེབས་སུ།",
    "བཙན་འཛུལ་དྲག་གནོན་ཤུགས་དྲག་འོག་ཤོར་བ་ཡིན་ཙང་ཚང་མས་དགོངས་པ་ཟབ་བཞེས་གནང་དགོས།",
    "སྐབས་རྗེས་མར་ཕྲན་གྱི་ཤག་ཏུ་ཉིན་བཅུ་ཙམ་བཞུགས་ཏེ་བྲག་སྲས་དང་།",
    "ཀ་སྦུག་ཏུ་ཐོག་མར་མཇལ་བའི་གནས་ཚུལ་སོགས་གསུངས་བྱུང་།",
    "ཕྱག་མཛོད་སྐུ་ཞབས་ལ་ཆིབས་སྒྱུར་དངོས་འབྲེལ་ཡིན་ཚེ་ཕྲན་དེང་སྐབས་སྡོད་ཤག་ཟུར་དུ་སྤོས་ཡོད་པ་དེར་ངེས་པར་གདན་ཞུ་ཆོག་པ་ཞེས་ཞུ་ཡིག་ཅིག་ཕུལ་བར།",
    "ཕ་རན་སིར་ཕེབས་མཚམས་ཞལ་དཔར་གནང་ཆོག་ཅེས་ཕེབས་བྱུང་།",
    "ཕྱག་སྐུ་མཆོག་ནས་སྔོན་ལ་ཁྱེད་རྣམ་པ་གཉིས་སུའི་ཁྱིམ་ལ་གདན་ཞུ་ཡིན་ནམ་གསུངས་བྱུང་།",
    "ཕྲན་གྱི་ཕན་སི་ཡོད་པ་ཁེབས་གཡོགས་ཏེ་བཞག་ཡོད་པ་བཀའ་བཀྱོན་ཕེབས་མི་ཡོང་ངམ་སྙམ་སེམས་འཚབ་ངང་བསྡད་པར།",
    "ལགས་ཡིན་ཞུས་པར་ཁེབས་བཤུས་ཏེ་སྟོན་དང་གསུངས་བྱུང་།",
    "ངོས་ནས་ཀྱང་དེ་འདྲ་གནང་མི་ཡོང་ངམ་སྙམ་སྟེ་སྔོན་ཚུད་ནས་དོན་གཅོད་ཚེ་རྡོར་ལགས་བརྒྱུད་༧སྐྱབས་ཞུ་སྒོར་༢ ཕུལ་ཐུབ་པ་བྱུང་།",
    "དེར་ཕེབས་སྒུག་ཞུས་ཏེ་སྡོད་སྐབས་གང་འཚམ་ནས་ཕྲན་དང་སྐུ་སྲུང་དམག་མི་ཆུང་བདག་གཉིས་མཇལ་ཁར་བཅར་སྐབས་ཁོ་པར་བཀའ་རྩད་གནང་བ་དང་ཆབས་ཅིག་བྱིན་རྟེན་གསོལ་རས་སྩལ་ཏེ་ཕྲན་བཅར་བར།",
    "གཟུགས་པོ་བདེ་པོ་བྱུང་ངམ་ཞེས་བཀའ་ཕེབས་པ་དང་ཆབས་ཅིག་རིན་ཆེན་བཙོ་བཀྲུ་རྡོག་ལྔ་ཕྱག་ཏུ་བསྣམས་ནས་འདི་ཟོ་ཨང་ཞེས་གསོལ་རས་གནང་བྱུང་།",
    "ཁ་སྔོན་བཅར་བ་ཡིན་ལ་དེ་རིང་ཞོར་དུ་བཅར་མཁན་ཡིན་ཞུས་པར།",
    "ཉིན་རྒྱབ་སུད་བོད་མཛའ་འབྲེལ་ཚོགས་པས་གདན་ཞུས་ལྟར་ཆིབས་སྒྱུར་སྐབས་ཐོག་མར་ཁང་ཆེན་ཞིག་སྟེང་བཞུགས་སྒྲིག་ཞུས་པར་༧ཞབས་སོར་འཁོད་པ་དང་།",
    "དེ་ནས་ཤོད་དུ་ཡེ་ཤུའི་ལྷ་ཁང་ཞིག་ནང་ལྷན་འཛོམས་གནང་སྟེ་ཧ་ལམ་ཆུ་ཚོད་༢།",
    "དེའི་གཡས་གཡོན་མཆོད་གཤོམ་གཉིས་ཀྱི་སྦྱིན་བདག་བྱེད་དགོས་ཞེས་ཕྱག་བྲིས་ཕེབས་པར་ཁས་ལེན་ཞུས་ཏེ་དངུལ་འབབ་གླིང་བླའི་ཕྱག་སྐུ་ནས་སྔ་འདོན་ཡོང་བའི་ཞུ་ཡིག་ཕུལ་བར་སྐུ་བསྟེན་ནས་ཕྱག་བྲིས་ཕེབས་གསལ།",
    "སྒྲོལ་དཀར་བཅས་ཞལ་ཐང་ལྔ་ལ་གོང་གཤམ་ཐང་རྡོག་རང་འགྲིག་གསར་བཞེངས་ཀྱིས་དམ་དོན་གཏོང་གནང་མཛད་བྱུང་།",
    "དེ་བཞིན་ཁྲི་བླའི་ཕྱག་མཛོད་སྐུ་ངོ་དཔལ་ལྡན་ཚེ་རིང་ལགས་སུ་སྐྱབས་ཞུས་རྗེ་ཡབ་སྲས་གསུམ་གྱི་སྐུ་བརྙན་ལ་ཞལ་གསེར་གཟུངས་དང་ན་བཟའ་བཅས་ཆ་ཚང་གཏོང་གནང་བྱུང་།",
    "དེ་ནས་བལ་ཡུལ་དུ་འགྲོ་མིའི་མདུན་མངགས་ཆ་བྱས་ཏེ་སྟོན་པ་གཙོ་འཁོར་གསུམ་དང་།",
    "ཚོགས་གཙོ་ལོ་གཉིས་ཞུས་པར་གཟེངས་བསྟོད་ཕྱག་འཁྱེར་གཞུང་དམ་སྦྱར་མ་གཉིས་སྩལ་ཐོབ་བྱུང་།",
    "ཐབས་ཞུ་དགོས་པའི་བཀའ་མངགས་གནང་བྱུང་བ་དེ་སྐོར་ཚང་མས་དགོངས་བཞེས་གནང་དགོས་གསུངས་པར།",
    "དེར་དྲུང་ཆེ་བྱམས་དཔལ་ལགས་ནས་ས་གནས་རང་བཙན་ལས་འགུལ་ཚོགས་ཆུང་དང་།",
    "བཞུགས་སྒར་དུ་རང་གཞུང་ནས་ངོས་ལེན་གནང་བའི་བོད་ཆོལ་ཁ་གསུམ་དང་།",
    "དེར་དྲུང་ཆེ་མཆོག་ནས་ད་ཆ་ཡག་པོ་ཞེ་དྲག་བྱུང་ཡང་ལམ་སང་ཕྱག་ལས་མེད་པས་སྔ་འཕྲོས་རིང་རྒྱུན་ལས་མི་བཞི་འཛུགས་དགོས་གསུངས།",
    "དེར་ངའི་ལས་རོགས་ངག་བློས་དེ་ནི་དངོས་འབྲེལ་དབུས་གཙང་ས་རྒྱུན་གསར་འཛུགས།",
    "དྷ་ས་དབུས་གཙང་རྒྱུན་ལས་དྲུང་ཆེ་བྱམས་པ་དཔལ་ལྡན་ལགས་སུད་སིར་གཉེན་འཕྲད་དུ་འབྱོར་བའི་གདོང་དྷ་ས་དབུས་རྒྱུན་ལས་ནས་མངགས་ཆ་གནང་དོན།",
    "དེར་དྲུང་ཆེ་བྱམས་དཔལ་ལགས་ནས་ཡག་པོ་ཞེ་དྲག་བྱུང་།",
    "ཁོང་རྣམ་པར་གསོལ་ཚིགས་སྟབས་བདེ་ཞིག་ཕུལ་ཏེ་གོ་བསྡུར་ཞུས་དོན།",
    "དེ་རྗེས་ཤེལ་དཀར་དྲུང་ཡིག་ནས་ཀྱང་དེ་མཚུངས་གསུངས་ཏེ།",
    "བཀའ་གནང་ཉི་ཤུ་རྩ་དགུ།",
    "དགོང་ཚིགས་གྲུབ་པ་ནས་མ་ཉལ་བར་དུ་འཆར་ཅན་མ་ཎི་གྲངས་གསོག་ཞུས་པར་བདུན་ཕྲག་གསུམ་རིང་མ་ཎི་འབུམ་གསུམ་གསོག་ཐུབ་པ་བྱུང་།",
    "ཡི་གེ་ཞིག་གནང་བྱུང་བར་བཟོ་གྲྭར་ཕུལ་བར་ཕྱི་ཉིན་ནས་བཟུང་ཤོད་དུ་ཉིན་གང་བསྡད་དེ་ལས་ཀ་བྱེད་ས་ཞིག་ལ་བཞག་བྱུང་།",
    "ངོས་རང་རྐང་པ་ན་མུས་ཕྲན་བུ་ཚིགས་འཆུས་པ་ལྟ་བུས་འགྱེལ་གྲབས་བྱས་ཏེ་སྐུ་ཕྱག་ཀྱང་ཇི་བཞིན་ཕུལ་མ་ཐུབ་པར་༧གོང་ས་མཆོག་ནས།",
    "ཐུགས་དམ་༧སྐྱབས་ཞུའི་ས་བོན་དང་མཎྜལ་རྟེན་དོད་བཅས་འབུལ་ལམ་ཞུས་པའི་བཀའ་ལན་བཞུགས་སྒར་ནས་སུད་སི་དོན་གཅོད་བརྒྱུད་སྩོལ་གནང་བྱུང་།",
    "དབུས་གཙང་དབུས་རྒྱུན་སོགས་ལ་སྙན་འབུལ་ཞུས་པར་མ་ཟད།",
    "ལེགས་པར་བཅོས་པས་བྱུས་ལམ་བསམ་དོན་འགྲུབ།",
    "ལྡུམ་བུའི་ཚལ་ལ་སྐུ་བདེ་བཟང་པོས་བཞུགས།",
    "དབུས་གཙང་ས་རྒྱུན་དམ་གཙང་སྤྱི་མགྲིན་ནས།",
    "དེ་བཞིན་ངོས་རང་ལ་རྩེད་ཐང་ཁང་ཚན་ནས་དགེ་སྐུལ་ཞུ་དགོས་ཕེབས་པ་ལྟར་གང་ཐུབ་ཐབས་སྐུལ་ཞུས་ཏེ་ཧིན་སྒོར་༡༧༦ ཙམ་གྱིས་ཁང་ཚན་ལ་བཀའ་དྲིན་འཇལ་ཐུབ་པ་བྱུང་།",
    "དིལླིར་ཞག་གཉིས་ལྷོད་བསྡད་ཀྱིས་རྡོར་གདན་ལ་ཐོན་པར་ཕྱི་ཚེས་༢༥ ཆུ་ཚོད་༥ པར་བླ་བྲང་དུ་འབྱོར།",
    "དེ་རྗེས་ཆུ་ཚོད་༨ ཙམ་ལ་གསོལ་ཇ་དང་བཞེས་འབྲས་བཏེགས་རྗེས་མཎྜལ་རྟེན་དོད་དང་།",
    "འཇམ་དཔལ་དབྱངས་ཀྱི་སྐུ་དཔར་དེ་ཕྱག་དཔུང་གཡོན་དུ་འདོགས་རྒྱུ་གསུངས་ཏེ་གསོལ་ཇ་དང་།",
    "ཕྲན་རང་དིལླིར་ཉིན་ཤས་བསྡད་ནས་དྷ་སར་ཐོན།",
    "སྐྱེས་བུ་ཆེན་པོའི་སྐོར་ཕྱི་ལོ་དུས་ཚོད་བྱུང་ན་གནང་རྒྱུ་ཡིན་ཞེས་གསུངས།",
    "རྩེད་ཐང་ཁང་ཚན་ལ་གསོལ་ཇ་བཞེས་བག་དང་།",
    "འབྲས་བློ་གླིང་གྲྭ་ཚང་ལ་གསོལ་ཇ་བཞེས་བག་དང་།",
    "དེ་རྗེས་བརྟན་བཞུགས་འབུལ་རྒྱུར་ཞལ་འདེབས་སྒོར་༥ ཕུལ།",
    "དེ་ནས་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོའི་གཟིམ་ཆུང་མཇལ་ཁ་ཞིག་སྙན་སེང་ཞུས་དོན་བཀའ་བཞེས་ཐོབ་པ་ལྟར་མཇལ་དར་ནང་མཛོད་དང་།",
    "དེ་ནས་ཧུན་སུར་ལ་ཕྱིན་ཏེ་སྨད་རྒྱུད་གྲྭ་ཚང་ལ་གསོལ་ཇ་བཞེས་བག་དང་།",
    "༡ དམ་ཅན་ནོར་ལྷའི་ཞལ་འབག་གཏེར་ནས་བཞེས་པ་ཁྱད་འཕགས།",
    "༡ མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱི་ཐུགས་དམ་རྟེན་ཀླུ་ཡུལ་ནས་གདན་དྲངས་པའི་སྒྲོལ་མ་གསུང་བྱོན་མ་༡ བཅས་བཞུགས་པའི་ནང་རྟེན་ཁྱད་འཕགས་ཅན་རྣམས་མཇལ་རྒྱུ་བྱུང་།",
    "མཎྜལ་རྟེན་དོད་སྒོར་༢༥ རྟེན་གཙོ་ཁག་ལ་སྙན་ཤལ་དང་བརྒྱ་མཆོད་གཅིག་བརྟན་བཞུགས་ཞལ་འདེབས་སྒོར་༥ བཅས་འབུལ་ལམ་ཞུས།",
    "བཞེས་ཚ་མར་ཁུ།",
    "བཙོ་བཀྲུ་ཤོག་སྒམ་༢ གསོལ་སྩལ་གནང་བྱུང་བ་སྐལ་བ་བཟང་པོ་བསམ་གྱིས་མི་ཁྱབ་པ་བྱུང་།",
    "དེ་ནས་བླ་ཞབས་ལ་དྭགས་ནས་འབྱོར་བ་ཚེ་བརྟན་བཀྲ་ཤིས་ཞུ་བར་ཕྱག་སྐུས་བོད་ཡིག་སློབ་དགོས་གསུངས་ཏེ་ལོ་གཅིག་འཁོར་མཚམས་གཏོང་ཡིག་འཕེར་ཙམ་བྱུང་ཡོད།",
    "མཎྜལ་རྟེན་དོད་ཧིན་སྒོར་༥༥ ཞབས་བརྟན་ལེགས་འབུལ་སུད་སྒོར་༡ ཐམ་པ་འབུལ་ལམ་ཞུས་པར།",
    "ལགས་ཡོད་ཞུས་པ་ཡིན།",
    "འཛམ་གླིང་ནོ་སྦེལ་ཞི་བདེའི་གཟེངས་རྟགས་འབུལ་ལམ་ཞུས་རྗེས་བསྒྲོན་པའི་གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོའི་སྐུ་དཔར་གཟི་འོད་ལྡན་པ་ཞིག་ལ་བླུ་ཡོན་སྒོར་༤ ཕུལ།",
    "མི་མང་གྲངས་༦ སྐོར་ལ་གསོལ་ཇ་བཞེས་བག་དང་།",
    "བོད་ཟླ་༡ ཚེས་༥ ཉིན་རྡོར་གདན་ནས་ཕེབས་ཐོན་གྱིས་བོད་ཚེས་༧ ཉིན་དྷ་སར་ཕེབས་འབྱོར་གནང་།",
    "རང་གཞུང་བཀའ་ཤག་སྤྱི་འཐུས་རྣམ་པས་གཙོས་ལས་བྱེད་ཡོངས་དང་།",
    "བཙུན་དགོན་བཅས་ལ་བསྙེན་བཀུར་གསོལ་ཇ་བཞེས་བག་དང་།",
    "བཞེས་ཐུག་འབྲས་ཚ།",
