    "སྣེ་མགྲོན་ལས་ཐོག་ཐུབ་བསྟན་ལེགས་སྨོན་ལགས་ཡིག་ཚང་དུ་ཕེབས་སྐབས་ཚལ་བདེ་གཞིས་སྡོད་བསྐོ་གཞག་སྔོན་སྩལ་ས་གནས་སུ་ཐོན་བསྐྱོད་ཞུ་འོས་མེད་པའི་རང་འཚམ་སྡོད་བབས་ཇི་ཡིན་གསུང་འབྲེལ།",
    "མཁན་དྲུང་ལྷན་རྒྱས་ནས་ཐུགས་རྒྱུས་བབས་བཅས་ཞབས་འཕར་ལས་མཇུག་འཕྲོ་སྐྱོང་སོགས་གསུངས་ཏེ་དགོངས་པ་དྭངས་ཚོད་ཀྱིས་མདའ་རིང་བར་ཆད་མ་ཕོག་ཙམ་ངང་ལས་མཇུག་གད་གཙང་ཞུས།",
    "སྤྲོད་ལེན་མི་ཆོག་པའི་བཀའ་རྩ་སྔ་རྗེས་ཕེབས་དགོངས་ས་འཇམ་བོང་ཉལ་གྱི་དཔེ་བཞིན་གླེང་མེད་ཐོག་དོས་རྒྱབ་པར་བབས་འོས་རྔན་པ་ཕྲན་བུ་སྤྲོད་རྒྱུ་ཆོག་ཤེས་བྱས་ན་དགེ་མཚན་ཆེ་བའི་གོ་བསྐོན་གསེད་འགྲོལ་བྱས་པ་བཞིན་སྟོང་བདལ་སྤྲོད་ལེན་མ་དགོས་པའི་མི་སེར་གྱི་བདེ་རྩར་ཕན་ཁྱད་བྱུང་ཡོད།",
    "ཕྱི་ལོ་ནས་མཁར་འབོ་ཚད་ལྡན་རྩ་བཟུང་གནང་རྒྱུ་བཅས་ཀྱི་སྐོར་ཚོགས་གཞུང་དུའང་སྙན་སྒྲོན་ཞུས།",
    "གཞན་ས་ཞོར་འདྲུད་མེད་པ་དྲང་འབྲེལ་དགོས་རྒྱུ་ཕེབས་དོན།",
    "འགོ་མཆན་ཁག་གཉིས་དང་སྦྲགས་གུས་རང་བཀའ་ཤག་ཏུ་བཅར་ཏེ་འགོ་མཆན་གྱི་དགོངས་དོན་མར་དོས་འདྲེན་ཁལ་སྐུལ་འདེད་ཤེས་མིན་ལ་ཇི་ལྟར་ཞུ་འགབ་སྙན་སེང་ཞུས་འབྲེལ་འགོ་མཆན་གཉིས་ཀ་ཕྱག་སེལ་ཐོག་ད་ལམ་ནག་ཚང་མར་དོས་ཐད་སྔར་ལམ་ཇི་ཡོད་སོར་གནས་ཀྱིས་འདྲེན་འབུལ་ཞུ་དགོས་བཀའ་རྒྱ་སྩལ་སྟབས།",
    "དཀོན་གཉེར་ཚབ་གསར་བསྐོ་སྩལ་གནང་བ་བཞིན་གུས་རང་གསར་རྙིང་སྤྲོད་ལེན་ཞུ་བར་བཅར་ཏེ་སྤྲོད་ཁོངས་གསེར་ཀོང་ཆེ་ཆུང་ལོ་མང་སྐུལ་ཟད་གྱུར་པའི་གསེར་ལྗིད་ཆག་པའི་བར་ཁྱད་ཕྲན་བུ་འཁྲི་སྒྲུབ་ཞུ་དགོས་བྱུང་བ་ལས།",
    "དེ་བྱིངས་སྐུ་ཆས་རིན་ཆེན་ཐང་སྤུངས་རྣམས་སྤྲོད་དེབ་གཞིར་བཟུང་ཞིབ་བཤེར་གྱིས་མེ་རྐམ་དང་བཅས་པ་ཆད་མེད་རྩིས་སྤྲོད་ཞུ་ཐུབ་པས་སྤྲོད་བསྡོམས་གད་གཙང་བྱུང་ཡོད།",
    "དམག་མིའི་བཟའ་ཉལ་བསྲུང་བྱའི་འགེལ་དཀྲི་སོགས་ས་གནས་སུ་ནགས་གསེབ་ཀྱི་གཅན་གཟན་ལྟ་བུའི་ཟ་རྔམ་བྱས་སྟབས།",
    "རྒྱུ་དངོས་ཁུངས་སྤྲོད་དགོས་རྒྱུའི་བཀའ་རྒྱ་ཕེབས།",
    "རྩིས་བཞེས་སུ་ཕེབས་འབྱོར་བྱུང་བར་གུས་པའི་ལས་འགན་ལོ་དུས་མ་རྫོགས་པར་ཚ་ལེན་གནང་བབས་ལ་བདེ་སྡུག་ཞུ་འོས་ཆེ་ཡང་།",
    "ཀོང་པོ་དེ་བཞིན་འཕྲང་འགག་དོག་ཅིང་ཤིང་སྡོང་འགྱེལ་ལྷུངས་ཡང་ཡང་བྱུང་བ་སོགས་ཀྱིས་ཕེབས་ལམ་བདེ་མིན་ལ་བརྟེན་ས་གནས་སོ་སོར་རྡོག་སྐོར་ལྟ་རྟོག་དང་།",
    "རྩེ་མཁན་མགྲོན་ཆེ་བའི་བཀའ་དགོངས་ལྟར་ཕྲན་རང་ཕེབས་ཟམ་སྲ་བརྟན་བཟོ་ཕྱིར་འཕྲལ་བསྐྱོད་དང་།",
    "བཞུགས་སྒར་ཆིབས་ཞབས་ལྷན་ཚོགས་ནས་ཐུགས་འགན་མ་བཟོད་པར་གུས་ལ་བཀའ་ནན་ཤུགས་ཆེ་ཕེབས་པ་ཐུགས་དགོངས་རྩ་བ་ནས་དག་གནས་ལ་བརྟེན།",
    "ཆིབས་ཞབས་ཁོངས་ཕྱི་མི་རྒྱ་དམར་དཔོན་དམག་ནས་མཐོང་ཚུལ་ཇི་ཡོང་མ་ངེས་པ་དང་བཅས་ཆིབས་ཞབས་རྣམས་རྩེ་སྒང་འདུ་སྤྱི་ནས་སྔ་གཡར་གྱིས་སྐབས་མཚམས་ཕེབས་འགྱངས་མ་བྱུང་ཙམ་ཞུ་ཐུབ་ཅིང་།",
    "ཁྲལ་འཆར་ཕྱག་རྟགས་མེད་པ་ཕྱིར་སྩལ་གྱིས་དེར་གསལ་ཁྲལ་བཟོ་ལག་ལེན་བསྟར་འཐུས་ཕེབས་ཀྱང་།",
    "ར་ལུག་བ་གླང་སོགས་རྩྭ་ཟར་བཏང་བ་པདྨ་རྒྱལ་པོས་བསད་བཟོས་བྱས་པའི་རྒྱུ་རྐྱེན་མང་དག་ལ་བརྟེན།",
    "ཁྱིམ་མཚེས་བཅས་པའི་སྲོག་ལ་ཉེན་ཁ་ཆེ་བའི་རྒྱུ་རྐྱེན་ཨ་འཐས་ཞུས་པར་བརྟེན།",
    "གཞུང་རྒྱུག་སྨད་ལྡིང་བྲག་ཕྱི་སྤྱིའི་ཁྲལ་རྟེན་སྒོ་ཕྱུགས་ཀྱི་རྩྭ་ཟ་ཐང་ཆེན་ཞིག་ཡོད་པ་རྒྱ་དམར་གྱི་ཕག་པ་འཇོག་ཡུལ་དགོས་ཚུལ་བཀའ་ཤག་ཏུ་སྙན་སེང་ཞུས་ཏེ་བཀའ་འཁྲོལ་བཀའ་རྒྱ་སྩལ་འབྱོར་བྱུང་ཡང་།",
    "ཞུ་བདེའི་བཀའ་ལན་སྩལ་ཐོན་མ་བྱུང་བར་རྒྱ་དམར་ཕྱོགས་ནས་སུན་གཙེར་བྱས་སྟབས།",
    "བཞུགས་གདན།",
    "དེ་མིན་བོགས་ཁོངས་ས་ཞིང་དང་རྩྭ་ཟ་ཕྱིར་སློག་དགོས་རྒྱུ་བཅས་ཀྱི་བཀོད་ཁྱབ་བྱས་པར།",
    "གསུམ་ཟུར་ཕྱི་ལོ་ལྔ་མཆོད་ཚུན་ལྷ་སར་འབུལ་རྒྱུ།",
    "ཐོག་མའི་དྲི་ལན་སོར་བཞག་ལན་འདེབས་བྱས་མཐར་ཕྱིར་ལོག་བྱས་འཐུས་བརྗོད་བྱུང་།",
    "འབྲི་གཡག་མཉམ་ཡོད་རྒན་བྱིས་༡ ཡོད་པ་ཉིན་མཚན་ལྟོགས་བཀག་ཏུ་བཞག་པ་ཆབ་སྲིད་ཀྲུའུ་རིན་ནས་ཕྱིར་ལོག་བྱས་འཐུས་བརྗོད་ཀྱང་།",
    "མི་མང་ནས་འགྲོ་ཕྱོགས་ལམ་སྟོན་བྱས་རུང་ཉན་ཤེས་མེད་པར་ཐད་བསྐྱོད་བྱས་པས་མ་ཚད།",
    "གུས་པ་ཐུབ་བསྟན་འགྲོ་དོན་གཉིས་འོས་འདེམས་གནང་དོན།",
    "དེ་སྐོར་གནས་ཆུང་དང་དགའ་གདོང་རྣམ་གཉིས་སྤྱན་འདྲེན་ལུང་སྐུལ་ཕྱིར་ཕེབས་ཇི་བྱུང་སོར་གནས་ཞུ་རྒྱུ་ཡིན་ཞེས་སྤྱན་འདྲེན་ཞུས་རུང་བཟང་ཕེབས་ལྟ་ཅི།",
    "ལྷ་སའི་ཇོ་བོ་དབུ་སྐྲའི་རྡོ་གཅལ་སྟེང་གུས་པར་མནོ་བསམ་ཇི་འཁོར་དང་།",
    "བཙན་ཁང་ནས་དེ་ནུབ་དང་སང་ཞོགས་བཅས་པར་བཟའ་བཏུང་ནར་གཏོང་སོགས་རོགས་རམ་གང་དྲག་དང་།",
    "བཞོན་རྟ་གཡར་སྟེར་གྱི་རོགས་རམ་གང་ལེགས་གནང་བྱུང་།",
