    "ཕྱིས་སུ་ཁོ་རང་ཧོ་ཀི་ཝ་ཙིར་ལ་སླེབས་དུས།",
    "ཡོ་རོབ་ཀྱི་མི་རྒྱུད་དཀར་པོ་རྣམས་ཀྱིས་ཀྱང་རང་ཉིད་མེ་གླིང་པ་ཚོའི་མིག་ལམ་དུ་ཕྱུག་བདག་ཁོ་ན་ཙམ་མིན་པར།",
    "གཞུང་ལུགས་རྣམ་པ་སྣ་ཚོགས་ཡོད་ན་ཡང་ཡིད་རྟོན་འཕེར་རུང་བ་གཅིག་ཀྱང་མི་འདུགཤ་རྒོད་སྨྲ་བའི་གཞུང་ལུགས།",
    "ཁོ་ཚོས་དམག་འཁྲུག་དུས་སྐབས་སུ་དམག་དཔུང་ལ་མངའ་བསྒྱུར་བས།",
    "ཁོ་རང་དགུང་ལོ་༡༨སྟེང་དབྱིན་ཇིའི་དམག་དཔུང་དུ་ཞུགས་མ་ཐག་དམག་དཔོན་ལ་བསྐོ་འཇོག་བྱས།",
    "དེ་དག་རྒྱུ་སྐར་གྱིས་ཉི་མར་སྐོར་བ་བྱེད་པ་ནང་བཞིན་རང་རང་སོ་སོ་འཁོར་སྐྱོད་ལ་ཐོགས་པ་མེད་པར་འདོད།",
    "ཁྱེད་རང་ལ་མཚོན་ན་ཐ་སི་མ་ཉི་ཡ་ནི་དངོས་གནས་སྐར་མ་ཕུར་བུའི་སྟེང་དུ་སླེབས་པ་དང་འདྲ།",
    "ཚོ་པ་སོ་སོས་རང་མཁོ་རང་སྒྲུབ་བྱེད་ཅིང་།",
    "ད་དུང་རང་ག་བའི་མ་ལག་ཅིག་གཏན་ནས་མིན་ཏེ།",
    "བཙན་རྒྱལ་ནི་དངོས་གནས་མི་རིགས་སྣ་མང་རང་བཞིན་ཉུང་དུ་གཏོང་བྱེད་ཀྱི་རྒྱུ་རྐྱེན་གཙོ་བོ་ཞིག་ཡིན་ལ།",
    "ཁོ་ཚོས་ཀྱང་རང་ཉིད་རྒྱ་གར་དང་མེ་གླིང་དུ་འོང་དོན་ནི་རྒྱུ་ནོར་གྱི་ཆེད་དུ་མིན་པར།",
    "གནའ་བོའི་རོམ་གྱི་མི་ཚོའི་མིག་ལམ་དུ་ཁོ་རང་སྔར་བཞིན་ཀླ་ཀློའི་རིགས་ཤིག་ཡིན་ཞིང་།",
    "འདི་ནི་ངེས་པ་དོན་གྱི་འཛམ་གླིང་རང་བཞིན་གྱི་བཙན་རྒྱལ་ཞིག་ཡིན་ངེས།",
    "རྐང་རྩེད་སྤོ་ལོ་ལའང་སྒྲིག་སྲོལ་དང་ཆོ་ག་དུས་རྒྱུན་ད་དུང་ཧ་ཅང་ཡ་མཚན་ཅན་གྱི་གོམས་སྲོལ་མང་པོ་ཡོད་ཀྱང་ཀུན་གྱིས་རྐང་རྩེད་སྤོ་ལོ་མིའི་རིགས་ཀྱིས་གསར་གཏོད་བྱས་པ་ཤེས་པར་མ་ཟད།",
    "ཡང་ལ་ལས་རང་ཉིད་ཀྱི་གཉའ་ཆག་དགོས་མི་འདུག་པར།",
    "རང་སྐྱོན་རང་ཞིབ་དང་རང་སེམས་ལ་ཉན་དགོས་ཏེ།",
    "གཅིག་ཏུ་ན་རྒྱལ་ཁ་ཐོབ་མཁན་གྱིས་ནམ་ཡང་རང་ཉིད་ཀྱི་མཚན་ཉིད་དེ་ཡང་དག་པར་ཡིད་ཆེས་བྱེད་པ་ནི་སྨོས་ཅི་དགོས།",
    "དེ་ནས་ཁོ་རང་གཉིད་ལས་སད་དུས་ལོ་༥འགོར་ཟིན་པར་ཆ་བཞག་ན།",
    "ཁོས་ཆུ་དེའི་ནང་དུ་སྐྱེ་དངོས་ཕྲ་རབ་མང་པོ་བར་མེད་དུ་འགུལ་བཞིན་པ་མཐོང་བས་ཁོ་རང་ཧང་སངས་པར་གྱུར།",
    "དེ་དག་ལ་ཁོ་རང་སྔར་བཞིན་སྤྲོ་བ་ཨེན་ཙམ་ཡང་མེད་པར་ལུས་སོ།",
    "ལྟ་ཚུལ་གསར་པ་སྤྱད་དེ་སྤྱི་ལོ་༡༥ལོ་ནས་༡༨༥ལོའི་བར་ལ་བལྟས་ཆོག་དུས་སྐབས་འདིའི་ནང་དུ་ཡོ་རོབ་གླིང་ལ་ཚན་རྩལ་དང་ཆབ་སྲིད།",
    "ཁོ་རང་ཚེ་ལས་འདས་པའི་བར་དུ་ཀོ་ལུན་པུའུ་ཡིས་རང་ཉིད་ཀྱིས་ནོར་འཁྲུལ་ཆེན་པོ་ཞིག་བཟོས་ཡོད་པ་ཤེས་ཀྱིན་མེད།",
    "གོང་མ་ཁོའི་ལག་ཏུ་ཡོད་རུང་ཁོ་རང་ནི་རྒྱུས་མེད་ཀྱི་སྐམ་ས་ཆེན་པོ་ཞིག་ཏུ་ཡོད་པར་མ་ཟད།",
    "ད་དུང་ཁོང་ཁྲོས་མེ་ལྕེ་དགུང་དུ་མཆེད་པའི་དམག་མི་ཁྲི་ཕྲག་དུ་མ་དང་ཁོ་རང་དགྲ་རུ་ལྟ་བའི་མི་སེར་ས་ཡ་དུ་མས་མཐའ་ནས་བསྐོར་ཡོད།",
    "ཁོ་རང་ནི་སི་ཕེན་པའི་ཕོ་ཉ་ཞིག་ཡིན་པའི་བཟོ་ལྟ་བསྟན།",
    "ཁོ་རང་མ་རྩ་རིང་ལུགས་པ་ཞིག་ལ་བགྲང་མི་རུང་།",
    "འཛམ་གླིང་རང་བཞིན་གྱི་ཧོ་ལན་བཙན་རྒྱལ་བཙུགས་པར་མ་ཟད།",
    "ད་དུང་གོང་མས་ཁོ་རང་ཐབས་ཇུས་བློན་ཆེན་དུ་བསྐོ་འཇོག་བྱས།",
    "དེ་ནས་བཟུང་མ་རྐང་སྤྱི་གཉེར་ཁང་རང་ཉིད་ཀྱིས་མི་སེར་སྤེལ་ཡུལ་བཙུགས་ནས་དེར་དོ་དམ་བྱ་མི་དགོས་པར།",
    "དེས་ན་འདི་ག་དུས་ཤིག་ལ་འབྱུང་སྲིད་དམ།",
    "མཐར་གད་སྙིགས་ནང་དོར་བ་མཐོང་ཚེ་ཁོ་རང་ཧ་ལས་ཤིང་ཧང་སངས་ངེས།",
    "ང་རང་ཆེས་དགའ་བའི་ཞོགས་ཟས་གྲོ་ཆག་ལ་མཚོན་ན།",
    "ཚོང་རྫས་བཟོ་སྐྲུན་པས་ཐོན་རྫས་ཇུས་འགོད་བྱེད་སྐབས་བསམ་གཟས་ནས་ཐོན་རྫས་དེ་དག་དུས་ཡུན་ཐུང་ངུའི་རྗེས་སུ་འདོར་དུ་འཇུག་སྲིད་པར་མ་ཟད།",
    "འོན་ཀྱང་དུས་ད་ལྟ་འབྱོར་བ་ལྡན་པའི་ཁྱིམ་ཚང་རང་ག་བ་ཞིག་ལ་ཡོད་པའི་ཆུ་ཚོད་འཁོར་ལོའི་གྲངས་ཀ་དུས་རབས་བར་མའི་རྒྱལ་ཁབ་ཅིག་ལས་ཀྱང་རིང་དུ་བརྒལ་ཡོད།",
    "ཡིན་ནའང་ད་ལྟ་ཆུ་ཚོད་ག་ཚོད་ཡིན་པ་ཤེས་མི་འདོད་པར་བྱེད་པ་ནི་དངོས་གནས་དཀའ་བའི་ཚོད་དུ་གདའ།",
    "དེ་རིང་མིའི་རིགས་ལ་འཛོམས་པའི་རྒྱུ་ནོར་ལོངས་སྤྱོད་ནི་གནའ་དུས་སུ་བྱིས་སྒྲུང་ཁྲོད་དུ་མ་གཏོགས་མི་སྲིད་པའི་ཚོད་དུ་གདའ།",
    "ང་རང་ཉིད་ཀྱི་བསམ་ཚུལ་དང་ཉེ་འགྲམ་གྱི་མིའི་བསམ་ཚུལ་གཉིས་གཅིག་མཐུན་བྱུང་ན།",
    "ཁོ་རང་བཀྲེས་ལྟོགས་ཀྱི་སྐབས་སུ་འཛིན་བདེ་བའི་ཕུགས་འདུན་ལྟ་བུ་ཡོད་ཀྱང་།"
  ]
}