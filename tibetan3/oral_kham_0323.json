    "སེར་བ་དང་སྔོ་བ་དང་དཀར་བ་ནི་རང་བཞིན་གྱིས་དེ་ལྟར་འདུགཔ་ལ་བྱ།",
    "གླེབས་པ་ཞེས་པ་ནི་ནས་འབྲས་ཀྱི་ཆནགཏུན་གྱིས་བརྡུངས་བ་ལྟ་བུར་ལུས་སམ་མགོལེབ་ལེབ་པོར་འདུག་པ་ལ་བྱ།",
    "ཀོསྐོ་གཅིག་ཅེས་པ་ནི་ཀོསྐོ་མདུངརྩེ་ལྟ་བུར་འདུག་པའོ།",
    "ཕྲག་མིག་ཅེས་བ་ནི་མགྲིན་པ་རོར་ནུབ་པའི་མག་ཕྲག་པདང་མཉམ་པར་འདུག་པའམ་ཕྲག་པ་གཡས་གཡོན་ལ་མིག་ཡོད་པའོ།",
    "ཚུན་ཆད་ཅེསབ་ནི་གྲོང་བམ་གཙུག་ལག་ཁང་བཞི་ལ་འདུག་པ་རྣམས་ཀྱིས་སྐྲབྲེགས་པ་ནི་སོར་གཉིས་སྲིད་དུའང་མི་གཞག་པར་བྲེགས་པའོ།",
    "གཙུག་ལག་ཁང་དུ་ཁྲུས་བྱེད་ནསྟོར་ཁུང་ག་ལ་འདུག་པར་ཁྲུས་བྱ་བའོ།",
    "མེད་ན་སྐད་ཅིག་ཙོག་ཙོག་པོརའདུག་ལ་ཁྲུས་རས་ཀྱིས་ཕྱི་ཞེས་པ་ཡིན་ནོ།",
    "མདུན་དུ་འདུག་ལ་མེ་མི་འདེ་ཞེས་པ་ནི་བསྲོ་གང་དུ་འོངས་པའི་ཚེསྔ་ནའཁོང་པའི་མདུན་བཅད་ལ་མེ་འདེ་བར་མི་བྱའོ།",
    "རྩུབཔོར་རུས་སྤལ་གྱི་གཟུགས་ལྟབུའོ་ཞེས་པ་ནི་རྐང་པ་བཀྲུ་བའི་གཞི་ཉིད་རྡོ་ལས་རུས་སྤལ་གྱིགཟུགས་ལྟ་བུ་རྒྱབ་རྩུབ་པོར་འདུག་པར་བྱོས་ཤིག་པའོ།",
    "ཚུལཕྱི་མར་ཞུགས་པ་ལས་གནས་མེད་པར་གྱུར་ན་ཟླ་བ་གཉིས་ལས་ལྷགཔར་མའདུག་ཤིག་པའོ།",
    "གོང་དུ་གནས་མེད་པར་མ་འདུག་ཅིག་ཅེས་བ་དེའིབྱེབྲག་བསྟན་པའི་ཕྱིར།",
    "མེད་པ་ཚོལ་བའི་ཚེ་གནས་པར་འོས་པ་མིགནས་པར་འདུག་ཀྱང་ཉེས་མེད་ཅེས་པ་ཡིན་ཏེ།",
    "གནས་མེད་པར་འདུགཀྱང་ཉེས་པ་མེད་པར་སྟོན་བའོ།",
    "ཞག་ལྔ་ལོན་གྱི་བར་དུ་གནསམེད་པར་འདུག་ཀྱང་སླ་བའོ།",
    "གཞག་ལྔའི་བར་དུ་གནས་མེད་བརའདུག་པའི་ཚེ་རྙེད་པ་བླང་དུ་རུང་ངམ་མི་རུང་ཞེ་ན།",
    "སྒོ་བརྡུངཞིང་ནང་ན་འདུག་པ་ཤེས་པར་བྱ་ཞེས་པ་ནི་དགེ་སློང་གཞན་གྱིགནས་ཁང་དུ་འགྲོ་ན་གནས་བ་ཉི་ཚེ་མ་ཡིན་གྱི་སུས་ཀྱང་རུངསྟེ།",
    "མ་གྲུབ་ན་ཉིད་ཀྱི་ཞེས་པ་ནི་གནས་བརྟན་འདུག་པལ་བརྡ་བྱས་ཀྱང་།",
    "མིའདུག་ཅེས་པ་ནི་ངེའི་མདུན་བཅད་ལ་འགྲེང་བ་འམ་འདུག་པ་མ་བྱེདཅིག་པའོ།",
    "འདི་ལྟ་བུར་བྱད་ལག་སྲེ་ལ་ཞིངའདུག་ཀྱང་སོ་སོའི་མཚན་ཡོད་པས་ནམ་ནིང་ལ་སོགས་པ་མ་ཡིན་ཏེསྡོམ་པ་འཆགས་སོ།",
    "དཀྲེ་སྤྱི་ཞེས་པ་ནི་སྤྱི་བོ་དཀྲེ་ལྟརམྱུག་མྱུག་པོར་འདུག་པའོ།",
    "སྐྲ་ཚོམས་ཅན་ཞེས་པ་ནི་ཟུར་ཕུད་འདྲབར་ཕ་ཟད་ཚུ་ཟད་ན་ཚོམས་སུ་འདུག་པའོ།",
    "མིག་གཟེའུ་ལྟར་འདུགཔ་དང་།",
    "སེར་པོ་དཀར་པོ་དམར་པོགཅེའུ་རྣ་ཞེས་པ་ནི་རྣ་བ་འདི་རྣམས་ལྟར་འདུག་པའོ།",
    "སྐྲ་སྔོན་པོཞེས་པ་ནི་སྐྲ་རམས་ཁར་འདུག་པའོ།",
    "དེ་ལརིང་པོ་ཞེས་པ་ནི་སྤྱི་རིངས་སུ་འདུག་པའོ།",
    "ཏ་ལའི་མགུལ་པ་ཞེས་པ་ནི་མགུལ་པཉེར་ཉེར་པོར་འདུག་པའོ།",
    "མ་ཚོར་བ་དང་རང་བཞིན་ཉམས་པའི་སྐབས་དང་།",
    "བདར་བ་ཕྱི་རོལ་དུ་བྱས་ལ་ནང་དུ་ལྡུགས་པ་དང་བདར་བནང་དུ་བྱས་ལ་ཕྱི་རོལ་དུ་འབོ་བ་ལྟ་བུ་འང་རངས་པར་འགྱུརབའོ།",
    "དབེན་པ་ནི་གསུམ་སྟེ་ཞེསཔ་ནི་བསྐོར་བའི་སྒོ་བཅད་དེ་འདུག་པ་དང་།",
    "མཚམས་སུ་འདུག་པ་སྤོས་ན་འདིས་མ་སྐོངས་པ་ཡིན་ཞེསཔ་ནི་འོ་བས་སམ་མུ་ཚིགས་ལ་སོགས་པའི་མཚམས་སྤོས་ཤིང་བསྒྱུརན་རྐུན་པོར་མི་འགྱུར་བ་མ་ཡིན་པའོ།",
    "དེར་མི་གནསཔས་དབྱར་གྱི་གོས་སྐལ་མི་མནོད་ཅེས་པ་དབྱར་གནས་དེ་ན་མ་འདུགཔས།",
    "གཞན་ཡང་དུག་ཕྱེ་མརླུགས་ཤིང་རང་བཞིན་ཉམས་ཏེ་གཏོང་བ་བྲང་དུ་བསྣུན་པ་འཁྲུལའཁོར་འཛོལ་རོ་སློང་བ།",
    "མ་བསམས་པར་ལྟོ་མཉེས་པའི་མ་དང་མངལ་ནི་སྦོམ་པོའོ་ཞེས་པ་ནིམདལ་ན་འདུག་པ་བསད་པའི་ཕྱིར་མའི་ལྟོ་མཉེས་པ་ལས་མདལ་ནའདུག་པ་ནི་མ་ཤིའི་མ་བསད་པར་མ་བསམས་པ་ལྟ་བུ་ཤི་བ་ལྟ་བུགསོད་པར་ཤོམ་པའི་སྦོམ་པོ་ཡོད་པར་ཟད་ཀྱི་མ་ཤི་བ་ཉེས་མེདཔར་མི་འགྱུར་བའོ།",
    "དེའི་ཚུལ་དུ་འདུག་པསསོ་ཞེས་པ་ཡིན་ཏེ།",
    "དབེན་པ་ན་འདུག་པ་དང་འགྲེད་བའོ་ཞེས་པ་ལ་སོགས་པཡིན་ཏེ།",
    "དབེན་པ་ན་འདུག་པ་དང་།",
    "དཔེར་ན་དངོས་སུ་མིག་ལམ་ག་ན་འདུག་ལ།",
    "དེ་ལགནས་ཤེས་པ་དེར་འདུག་པ་ཙམ་གྱིས་གནས་སུ་མི་འགྱུར་བས་ན་དེམཚན་ཉིད་སྟོན་པ་ནི།",
    "འགྲོ་བ་དངའདུག་པ་དང་ཐུལཡབས་ཀྱིས་ཇི་ཙམ་སླེབས་པའི་ཁོངས་སོ་ཞེས་པ་ཡིན་ཏེ།",
    "ཆོད་པས་ཁྱེར་ན་མི་བླང་ཞེས་པ་ནི་མི་གཅིག་གཉིས་ཀྱིས་ཆོདཔའི་འོག་ན་འདུག་པས་ཁྱེར་ན་ང་འདོད་དོ་ཞེས་དེ་ལ་མ་སློངཤིག་པའོ།",
    "འབྲལ་བའི་ཞག་དུས་ངེས་པར་སྟོན་པ་ནི།",
    "འདིས་ཕ་ཟད་དུ་འདུག་པར་བྱ་ཞེས་པ་ནི་བསྲུང་བའི་དགེསློང་དེ་ཁྱིམ་པའི་ནང་ན་མ་འདུག་པར་ཕ་ཟད་དུ་འདུག་ལ་སྲུངསཤིག་པར་སྟོན་པའོ།",
    "བྱ་རབྱ་ཞེས་པ་ནི་ཕ་ཟད་ན་འདུག་པའི་དགེ་སློང་དེས་ཁྱིམ་པ་དོངངམ་མ་དོང་བ་ལ་སོགས་པ་བགས་ཀྱིས་ལྟ་ཞིང་བྱ་ར་གྱིས་ཤིགཔའོ།",
    "འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ་གནས་དེ་དགལྟ་བུ་ན་འདུག་ན་གདོད་ཉེས་པར་འགྱུར་བའོ།",
    "ཇི་ཙམ་གྱིས་འདུགཔར་འགྱུར་ཞེ་ན།",
    "རྐུབ་བཞག་པ་ཙམ་གྱིས་དེ་ཉིད་དོ་ཞེས་པ་ཡིནཏེ་རྐུབ་ས་ལ་བཞག་པ་ཙམ་གྱིས་འདུག་པར་ཆུད་པའོ།",
    "ཞགགཉིས་སུ་འདུག་ན་ཉེས་བྱས་སུ་སྟོན་པའོ།",
    "འདུག་ནས་སོཞེས་པ་ཡིན་ཏེ་འདུག་པའི་གནས་ནས་ལངས་ནས་གདོད་ཉེས་པར་འགྱུརབའོ།",
    "འདུག་གོ་ཅོག་ལས་སམ་ཞེ་ན།",
    "གནས་སུ་གནའ་ནས་གྱེས་པ་ནི་མ་ལུས་པ་མ་ཡིན་ཞེས་པ་ནིཤིང་ལྟ་བུ་གནའ་ནས་གནས་ཀྱི་ནང་དུ་སྐྱེས་ཤིང་འདུག་པ་ཞིགན་ཡང་མཚམས་ཀྱི་ནང་དུ་ལུསཔ་ཡིན་ནོ་བར་སྟོན་པའོ།",
    "རྩ་བ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་ལལོ་མ་ནང་དུ་བོ་བ་དང་རྩ་བ་ནང་དུ་ཟུག་ལ་ལོ་མ་ཕྱི་རོལ་དུབོ་བ་དང་།",
    "འཚེདཔ་དེར་གཏོགས་ཀྱང་མ་ཡིན་ཞེས་པ་ནི་བཙོ་བ་ཉིད་མཚམས་ཀྱི་ཕྱིརོལ་ན་འཚེད་པའི་བྱན་བོ་ནང་དུ་འདུག་པ་ལྟ་བུ་ནི་འཚེད་པམཚམས་ཀྱི་ནང་དུ་གཏོགས་ཀྱང་ཕྱི་རོལ་དུ་བཙོས་པར་སྟོན་པའོ།",
    "ཡང་ཐོག་རྩེགམའང་དེའོ་ཞེས་པ་ནི་ཁང་པ་བརྩེགས་པ་དུ་མར་འདུག་པ་ཞིག་ནཉེ་སྤྱོད་ཀྱི་ཁོངས་སུ་གཏོགས་པར་སྟོན་པའོ།",
    "གྲུའི་དོར་ཡང་ངོ་ཞེས་པ་ནི་གྲུར་འཇུག་པའི་ཚེ་ནཡང་གྲུའི་ངོར་མ་འདུག་ཤིག་པའོ།",
    "མངོནསུམ་མཚམས་ཀྱི་ནང་རྣལ་མའི་ཕྱོགས་ན་འདུག།",
    "རྣལ་མའི་ཕྱོགས་ན་འདུག་ཅེས་པ་ནི་སྟེང་དང་ཤོད་ལྟབུའམ་སྟེགས་བུ་ལསོགས་པ་ཁྲི་འཕང་མཐོན་ད་མན་མ་ཁྱེར་བར་ས་མཉམ་པའོ།",
    "བསོད་སྙོམས་ཁྱེར་ཏེ་འོངས་པ་ལས་ཁ་རོག་པརའདུག་གམ་བཀྱིགས་པ་དང་འོན་ཅི་སློང་ཞེས་པ་འདྲི་བ་ནི་ཅི་བདེར་བསྟབས་པའོ་ཞེས་པ་ཡིནཏེ།",
    "སེ་གོལ་གཏོགས་ལ་བཞིནབཟངས་མི་སྣང་བའི་ལམ་དུ་འདུག་ཤིག་ཅེས་བྱ་ཞེས་པ་ཡིན་ཏེསྙད་འདི་སྐད་དུ་གྱིས་ལ་སྐྲོག་ཅིག་པའོ།",
    "ཇིལྟར་འདུག་པས་ཤེན་མངོན་སུམ་གྱི་ཚུལ་གྱིས་འདུག་ནའོ་ཞེས་པ་ཡིནཏེ་གབ་ཅིང་བ་ཞབས་པས་ནི་མ་ཡིན་གྱི་མངོན་སུམ་དུ་འདུག་ཅིངསྨྱེན་ངན་གྱི་བར་དུ་གཅོད་ན་གདོདཉེས་པར་འགྱུར་བའོ།",
    "སྨྱེན་ངན་གྱི་གནས་ན་འདུག་པའོ།",
    "དེ་ལ་འགྲེང་བ་ཉི་ཚེ་མ་ཡིན་ཏེ་འདུགཔ་ལ་སོགས་པའི་སྤྱོད་ལམ་གཞན་གྱིས་ན་ཡང་ཉེས་པར་འགྱུར་རོ།",
    "མཛོད་ཀྱང་དེར་གཏོགས་སོ་ཞེས་པ་ནིམཛོད་ཀྱི་སྒོ་ནས་ཁྱམས་སམ་ཁྱིམ་ཡོད་པར་དགེ་སློང་འདུག་ཅིངམཛོད་ན་སྨྱེན་ངན་སྤྱོད་ན་ཡང་གནས་གཅིག་པར་སྟོན་པའོ།",
    "དེ་དག་མེད་པར་དེ་ཞག་གཉིས་ལོན་པལས་ལྷག་པར་གནས་ནའོ་ཞེས་པ་ལ་སོགས་པ་ཡིན་ཏེ་རྒྱལ་པོ་ལ་སོགསཔས་བོས་པའམ་བར་ཆད་ཀྱི་རྐྱེན་མེད་ལ་དེར་ཞག་གཉིས་ལས་ལྷགཔར་འདུག་ན་ཉེས་པརའགྱུར་བའོ།",
    "སྒྲོནམ་སྦོར་བ་ནི་མེ་རངས་པར་འགྱུར་བས་ན་ཉེས་པའང་རངས་པརསྟོན་པའོ།",
    "དེ་འདུག་གོ་ཅོག་ན་ཉེས་པརའགྱུར་རམ་ཞེ་ན།",
    "གསེརཕོག་དང་དྲིལ་གྱིས་སྤྲས་པས་གོས་དེ་དག་ལྟར་བཤམས་ན་ཁྱིམཔའི་འོ་ཞེས་བསམ་ཞིང་འདུག་པར་བྱ་ཞེས་པ་ནི་འདི་དག་ལྟ་བུབཤམས་ཤིང་སྤྲས་པའི་རྒྱན་ཅན་ཞིག་ཡིན་ན་ཡང་ཁྱིམ་པའི་ཡིནནོ་བར་སོམས་ལ་འདུག་ཤིག་པའོ།",
    "འདི་དག་ལྟ་བུར་སྤྲས་པ་ལ་ཡང་འདུག་ཤིག་པའོ།",
    "འདི་བསྐོར་ལ་འདུག་པརམི་བྱ་ཞེས་པ་ནི་འཐབ་པ་དེའི་མཐའ་བསྐོར་ལ་འཁོད་པ་ལྟ་བུ་མབྱེད་ཅིག་པའོ།",
    "དད་པ་ན་འདུག་པ་དང་བཀར་བ་དང་།",
    "གཞན་གྱི་ཕྱོགསརྣམས་ཀྱང་ངོ་ཞེས་པ་ནི་ནམ་མཁའ་ལ་འདུག་པ་ལྟ་བུ་ལ་བྱས་བཀར་བའི་དགེ་སློང་ལ་བྱས་པའམ།",
    "འདུག་པའི་གནས་སུ་འདུག་ནའོ་ཞེས་པ་ནི་སླས་འདུག་པའི་ཁྱིམ་ཡིནན།",
    "ཇི་ཙམ་ཡན་ཆད་སླསའདུག་པའི་ཁང་པར་གཏོགས་ཤེ་ན།",
    "སྟན་མཐོན་པོ་དང་སྟན་ཆེན་པོ་ལ་མི་འདུག།",
    "ཁྱིམ་པའི་དེར་གཞནམེད་ན་སྔ་མ་བྱ་ཞེས་པ་ནི་ཁྱིམ་པའི་དེ་ན་འདུག་ལ་རུང་བའིཁྲི་སྟན་གཞན་མེད་ན་ཁྲི་སྟན་འདི་ལྟ་བུ་ལ་ཡང་འདུག་ནི་འདུགལ་མཉལ་ཅིག་པའོ།",
    "ཁྲི་བརྩེགས་པ་ལ་མི་འདུགཅེས་པ་ནི་ཁྲི་བརྩེགས་པ་ལ་མ་འདུག་ཤིག་པའོ།",
    "ནམ་མཁའ་ནི་ཕྱེད་དོ་ཞེས་པ་ནིདགེ་སློང་མ་གཅིག་ནམ་མཁའ་ལ་འདུག་ཅིང་སྦྱིན་ནམ་ལེན་པར་བྱེདཔ་ཉེས་བྱས་སུ་འགྱུར་བའོ།",
    "གུད་ན་འདུག་པ་ལ་ངོསམགྲོན་བྱས་ན་ཉེས་པར་འགྱུར་བའོ།",
    "དགེ་སློང་མས་ན་ཇི་ལྟ་བུ་ལ་འདུག་པས་བསྐོས་པའི་ཉེས་པར་འགྱུརཞེ་ན།",
    "དེའི་བྱིས་པ་དག་ཟསསློང་ན་ཁུར་བ་དང་རངས་པ་མ་ཡིན་པ་ལསོགས་པ་བྱིན་ཅིག་པའོ།",
    "ལག་པ་མིསྤྲེལ་འདིར་མ་བསྡམས་པས་སྟན་ལ་མི་འདུག།",
    "འདུགཔས་ཉལ་བ་ལ་མ་ཡིན།",
    "སྟན་དམའ་བལ་འདུག་པས་སྟན་མཐོན་པོ་ལ་འདུག་པ་ལ་མ་ཡིན།",
    "དུས་སུ་གཏོགས་པནི་ཐ་མའི་སྔ་རོལ་དུ་སྦྱོར་བའོ་ཞེས་པ་ཡིན་ཏེ་དུས་སུ་གཏོགས་སོཅོག་དུས་ཐ་མ་ལ་ཐུག་པའི་སྔ་ཨརོལ་ཀུན་ཉེས་བྱས་སུ་སྟོན་པའོ།",
    "དེ་དང་འགྲིལ་འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ།",
    "མ་བསྐོས་པ་ལ་སོགས་པ་བཅུ་དང་འབྱིན་པདང་ཡང་ཡང་དང་བསོད་པ་དང་འདུག་པ་དང་འགྲེང་བ་དང་སྟེརབ་མ་ཡིན་པ་དང་མ་ཚང་བ་དང་རས་ཆེན་རྣམས་མ་གཏོགས་ཞེསཔ་ཡིན་ཏེ།",
    "འབྲི་བ་ནི་ཉིད་དོ་ཞེས་པ་ཡིན་ཏེ་མཚན་གཞན་གྱིཚེ་ཉེས་པ་ཆུང་དུ་བྱས་པ་མཚན་གྱུར་ན་དེ་ལས་ལྷག་པར་མིསྦྱར་གྱི་དེ་ཉིད་ཀྱི་སོ་ན་འདུག་པ་སྟེ།",
    "མ་བསྐོསཔ་ལ་སོགས་པར་སྟོན་པ་བཅུ་དང་སྨྱན་གནས་ན་འགྲེང་ཞིང་འདུག་པ་དངགཅེར་བུ་མ་ལ་བྱིན་པ་དང་།",
    "སྟན་ལ་མ་གཉར་བར་འདུག་ཅེས་པ་ལ་སོགས་པ་འདི་དག་བསྡུ་བརསྟོན་པའོ།",
    "མ་བྱིན་བར་ལེན་པའི་བག་ཏུ་གཏོགས་པ་ནི་མ་བསྟབསཔའི་སྟན་ལ་འདུག་པ་དང་།",
    "སྐྱབས་ཡོད་པ་ན་འདུག་པ་དང་།",
    "དབེན་པ་ན་འདུག་པ་དང་།",
    "དེའི་སྨྱན་གནས་ན་འདུག་ཅིང་འགྲེང་ངམ།",
    "དབེན་པ་ན་འདུག་པ་དང་སྤྱོར་དུ་བཅུགཔ་དང་།",
    "དེ་ལས་དགེ་སློང་ཕར་འདུ་ཤེས་བཞགནས་སོ་ཞེས་པ་ཡིན་ཏེ་དེ་ལ་དགེ་སློང་རངས་པ་ཡིན་བར་འདུ་ཤེསབཞག་ནས་དད་པ་ལོང་ཤིག་པའོ།",
    "ནམ་མཁའལ་མི་འདུག་ཅེས་པ་དང་།",
    "མེད་པ་ནི་མ་སྨྲ་བར་འདུག་ཤིག།",
    "ཕྱིམ་ལས་སྔ་མའི་ཚུལ་དུ་ཞུགས་པ་མི་བསྲུང་ཞེས་པ་ནི་གསོ་སྤྱིནམི་བྱེད་ན་ཚུལ་སྔ་མ་འང་དྲོལ་ཅིགབའོ་དེ་ཡང་ཟླ་བ་གཉིས་ལས་ལྷག་པར་རོ་ཞེས་པ་ནི་ཚུལ་ཕྱིམར་ཞུགས་ནའང་དེ་ལྟ་བུའི་ཚེ་ཟླ་བ་གཉིས་ཀ་ལས་གཞིར་མའདུག་ཤིག་པའོ།",
    "ཅེས་པ་འགྲོན་པ་ཐུག་ཕྲད་ཀྱིས་གཏམ་ཟེར་བ་ལྟ་བུའགྲེང་ཞིང་མི་འཆད་པར་འདུག་ལ་ཤོད་ཅིག་པའོ།",
    "ཕལ་ཆེ་ན་གཉིས་གསུམ་གོ་བཞག་ནས་སོ་ཞེས་པ་ནི་རྒན་རབས་མངཔོ་ཞིག་འཁོད་ན་གོང་དུ་གཉིས་གསུམ་ཙམ་བཞག་པའི་འོག་ཏུ་འདུགལ་ཤོད་ཅིག་པའོ།",
    "ཆུན་གྱིས་འཐོན་ན་འགྲོལ་ལོ་ཞེས་པ་ནི་དངཔོ་མཚམས་གཅོད་གཅོད་པའི་དགེ་སློང་གཅིག་ཀྱང་མི་འདུག་པར་འཐོན།",
    "འདི་མཚམས་ཀྱི་ཕྱིར་རོལ་ན་འདུག་པས་མི་དབུལ།",
    "དབུལ་དུ་འངམི་གཞུག་ཅེས་པ་ནིམཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པའི་དད་པ་བླང་ཡང་མི་བླང་།",
    "གྲིབ་ཤིང་དངགཞན་ཡང་སྤྱོད་པའི་གནས་སུ་འདུག་བར་མི་བྱ་ཞེས་པ་དང་།",
    "ཁ་ཅིག་ཏུ་སྔ་དྲོའི་བཀླག་པ་དང་གདོན་བ་དང་འདུག་པ་དང་།",
    "ནམ་མཁའ་ལ་ཚུལ་དུའཇུག་པ་མི་སྐྱེ་ཞེས་པ་ནི་ནམ་མཁའ་ལ་འདུག་ཅིང་འཛུལ་དུ་འཇུགཔའི་ལས་བྱས་ན་ལསསུ་མི་རུང་བའོ།",
    "གཞིར་བྱིན་ནས་དོནཆེད་བཞིན་དུ་དེ་ན་འདུག།",
    "དོན་ཆེད་ཞག་དུས་འགྲུབ་པ་བཞིན་དུ་བྱིན་གྱིས་རློབས་ཤིགཔའོ།",
    "ཕྱི་རོལདུ་དེ་ལས་འདས་པར་མི་གནས་ཞེས་པ་ནི་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་ཞགབཞི་བཅུ་ལས་ལྷག་པར་མ་འདུག་ཤིག་པའོ།",
    "བཀར་དུ་ཟིན་ཀྱང་དེ་དང་ལྷན་ཅིག་ཏུའདུག་ཤིག་པའོ།",
    "མགུབ་ལྟ་བུ་ཆད་པ་རྣམ་པ་བདུན་གྱིས་ཆོད་པའི་ས་ན་འདུག་པ་ལྟབུའོ།",
    "བླ་གབ་མེད་པར་མི་འདུག་ཅེས་པརྣམས་ཡིན་ཏེ།",
    "མ་གྱུར་ཀྱངམི་འཆད་པ་མ་ཡིན་ཞེས་པ་ནི་གནས་གཅིག་ན་དགེ་སློང་གཅིག་པུ་ཞིགའདུག་པའི་གཏན་པ་བཏིང་བའི་དོན་རོགས་དགེ་སློང་འགྲོན་པ་གཞནགྱིས་བྱས་ཏེ།",
    "ཁྲི་ངན་པ་མ་ཡིནན་འདུག་པའི་བར་དུ་དེ་མ་ཡིན་པའི་གདིང་བ་མེད་པར་མི་བྱ་བདང་།",
    "མི་འདུག་ན་ཡང་ངོཞེས་པ་ནི་ཤི་བའི་དྲུང་ན་དགེ་སློང་ཐ་མལ་པ་མེད་དུ་ཟིནཀྱང་བཀར་བས་ཡོ་བྱད་མི་འཐོབ་པའོ།",
    "གར་ཤིབའི་གནས་མི་བརྩན་གྱི་ནོར་གང་ན་འདུག་པ་བརྩན་བའི་ཕྱིར་རོ།",
    "གུད་ནས་འདུག་པགཟུགས་བརྙན་ལ་བྱིན་གྱིས་བྲླབ་ཅེས་པ་ཡིན་ཏེ།",
    "བཅལ་བའི་ཕྱིར་ཚད་དེ་ཙམགྱི་ཤིང་བཅང་ཞེས་པ་ནི་ཕྱེད་དང་རངས་པར་བྱ་བ་བཅལ་བའིཆེག་ཤིང་གྱིས་ཤིག་པའོ།",
    "འདི་ལ་མིའདུག་མི་ཉལ་ཞེས་པ་དང་།",
    "ཁོང་ཡེ་བོར་བ་མ་ཡིན་པའི་སྟན་ལ་ཞུ་ཞིང་འདུག་པར་བྱ་བ་ལསོགས་པ་དུར་ཁྲོད་པའི་ཆོ་གར་སྟོན་པ་རྣམས་སོ།",
    "གྲོང་དང་ཁྱིམ་དུ་འཇུག་ཅིང་འདུག་པར་མི་བྱ་ཞེས་པདང་།",
    "ཡོད་ན་མི་འདུག་ཅེས་པ་ནི་མུ་སྟེགསཔའི་གནས་སུ་འོངས་པའི་ཚེ་མུ་སྟེགས་པ་ཡོད་ན་དེའི་ཐད་དུས་ལའདུག་ཤིག་པའོ།",
    "ཡུལ་གུད་ན་འདུག་ཀྱང་རུང་བ་མི་འཇིག་ཅེས་པ་དང་།",
    "གཞན་དུ་ཚུལ་དུ་མར་ཞུགས་ནཡུན་རིང་དུ་གནས་པ་བརྩན་ནོ་ཞེས་པ་ནི་གཙུག་ལག་ཁང་དུ་མའིཁ་བརྒྱུས་ཏེ་ཚུལ་དུ་ཞུགས་ན་གང་དུ་ཡུན་རིང་དུ་འདུག་པ་དེ་ཅིཆེ་ནས་རྙེད་པ་བྱིན་ཅིག་པའོ།",
    "ཁྱིམ་པ་དེརགཞན་མེད་ན་པགས་པལ་འདུག་པར་བྱ་ཞེས་པ་དང་།",
    "འདིར་དེ་ལྟ་བུའི་རྐྱེན་གྱིས་ནའངམི་ཞལ་བ་ཡང་ངོ་ཞེས་པ་ནི་ཁྱིམ་པ་དེར་འོངས་ལ་སྟན་མེད་ནཁོལ་ལྤགས་ཀྱི་སྟན་ལ་ཡང་འདུག་ཤིག་པའོ།",
    "གཞག་པ་ཕྱི་རོལ་བཞིན་ཞེས་པ་ནི་རུང་བའིཁང་པ་བྱིན་གྱིས་བྲླབས་ན་དགེ་སློང་ག་ལ་འདུག་པའི་གནས་ནསའདོམ་གང་ཕན་ཆད་དུ་བཞག་ཅིང་བཙོས་པ་དང་འདྲེས་ཏེ་ཉེས་པམེད་པར་སྟོན་པའོ།",
    "དེལེན་པར་ལྡང་ཞེས་པ་ནི་ཟ་བར་འདུག་པ་ལས་མི་ལྡང་ཞེས་པའབྲེལ་པའོ།",
    "བམ་ལ་འདུག་པར་བྱཞེས་པ་དང་།",
    "འདུག་པ་ཡང་དེ་བཞིན་ཞེས་པ་ནི་སྒྲ་བསྐྱུངས་ཤིང་སྤྱོདལམ་བསྔམས་པ་ལེགས་པར་བྱ་བ་དང་།",
    "དེ་ཐོས་པས་སོ་ཞེས་པ་ནིསྦྱིན་པ་འཆད་པའི་ཐོས་པ་ཉེན་ཀོར་ན་འདུག་པས་དེའི་ཚེ་ཟན་མཟ་ཤིག་པའོ།",
    "ཚདཔ་འཛག་པས་མཇུག་ཚུན་ཆད་ཕྱི་བ་ཙམ་བྱ་སྟེ་སྟན་ལ་འདུག་པཉེས་མེད་ཅེས་པ་དང་།",
    "དེ་མ་ཡིན་པ་གཞན་ནི་ཆུ་ཡོདཔ་ལ་བཀྲུས་ན་སྟན་ལ་མ་འདུག་ཤིག་པའོ།",
    "ས་གཞན་ལ་གནས་ཞེས་པ་ནི་དགེ་སློང་ཐ་མལ་བའི་ས་དེཆད་པས་བཅད་པ་ལ་སོགས་པའི་ལས་ན་འདུག་པའོ།",
