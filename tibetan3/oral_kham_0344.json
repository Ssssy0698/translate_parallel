    "འདིར་ལྷ་རྣམས་རྡོ་རྗེའི་གདན་གྱི་འདུག་སྟངས་ཀྱིས་གནས་པའོ།",
    "ཀླུ་ཐམས་ཅད་ཀྱང་རྡོ་རྗེ་གདན་གྱི་འདུག་སྟངས་ཀྱིས་གནས་པ་ཕྱག་བཞི་དང་ལྡན་པས་གཡས་པ་གཉིས་ན་བདུད་རྩིའི་བུམ་པ་དང་རྡོ་རྗེ།",
    "འདི་ལྟར་ཟླ་བ་ལ་སོགས་པའི་ལྷ་རྣམས་རྡོ་རྗེའི་གདན་གྱི་འདུག་སྟངས་ཀྱིས་གནས་པའོ།",
    "ལས་དང་རྗེས་སུ་མཐུན་པར་འདོད་པའི་ལྷའི་རྣལ་འབྱོར་གྱིས་སྲུང་བའི་ཆོ་ག་དང་བཟླས་པ་བྱ་ཞིང་མི་སྨྲ་བར་འཇམ་ཞིང་ཤིན་ཏུ་བདེ་བའི་སྟན་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ་སྲོད་ལ་ཁ་ཤར་དུ་བལྟས་ལ་བློས་བསྒྲུབ་བྱ་ལ་དམིགས་ནས་དཀར་པོའི་ཚེས་གཅིག་ནས་བརྩམས་ཏེ་ཞི་བའི་ཡིད་ཀྱིས་ཞི་བའི་ལས་བྱའོ།",
    "བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ་དགའ་བའི་ཡིད་ཀྱིས་ཁ་བྱང་དུ་བལྟས་ཏེ་ཉ་ནས་བརྩམས་ནས་སྔ་དྲོ་རྒྱས་པ་བྱའོ།",
    "མཐོ་ཞིང་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "སྟན་སྲབ་པ་ལ་ལྷོ་ཕྱོགས་སུ་བལྟས་ཏེ་འདུག་པ་འམ།",
    "ཕྱོགས་ཏེ་རྐང་པ་བཟློག་པས་འདུག།",
    "ཤིན་ཏུ་དགྱེས་ཤིང་རངས་པ་སྟེ།",
    "ཞེས་པས་ལྷ་དང་འཇིག་རྟེན་སྐྱོང་བ་དང་རང་ཡང་ཚིམ་པར་བྱའོ།",
    "འདི་དག་གཉིས་གང་ཡང་རུང་བ་བཅིངས་ལ་སྔགས་ལན་ཅིག་བརྗོད་ལ་འགྲོ་བའམ་འདུག་པས་ཀྱང་བཟླས་པར་བྱ་སྟེ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་མུ་ཞེས་བྱ་བ་ནི་བཟླས་པའི་སྔགས་སོ།",
    "ཨ་ར་པ་ཙ་ན་སཱ་དྷ་ནཾ།",
    "ཁ་བློ་བརྟན་ཞིང་གདམས་པས་དམ་པ་ཨ་ར་པ་ཙ་ན་ཡི་སྔགས།",
    "དེ་བཞིན་དུ་ཡི་གེ་ན་དཀར་པོ་ལས་གྲུབ་པའི་ཉེ་བའི་སྐྲ་ཙ་ནམ་ཡང་།",
    "ཚིག་ལྷུག་པའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་སོ།",
    "དེ་དག་ཐམས་ཅད་ཡོངས་སུ་གྱུར་པ་ལས་རལ་གྲི་དང་པོ་ཏི་བསྣམས་པ་ཟུར་ཕུད་ལྔ་ལེགས་པར་འགྲིལ་བ་ན་བཟའ་དམར་པོ་ཟུང་ཅིག་བསྣམས་ཤིང་སྒེག་པའི་ཆ་བྱད་དང་ལྡན་པ་ཞལ་འཛུམ་པས་རྣམ་པར་རྒྱས་པ་ཟླ་བའི་འཚེར་བག་དང་མཚུངས་པར་མཛེས་པས་འདབ་མ་སྣ་ཚོགས་པའི་པདྨ་ལ་སྐྱིལ་ཀྲུང་ཕྱེད་པས་བཞུགས་པའི་འཕྲལ་དུ་ཉམས་སུ་མྱོང་བའི་ཨ་ར་པ་ཙ་ནའི་གཟུགས་སུ་བདག་ཉིད་ལེགས་པར་བལྟ་བར་བྱ་བའོ།",
    "ཨ་ར་པ་ཙ་ན་དྷཱི་ཞེས་བྱ་བའོ།",
    "དེ་ནས་དེ་ཁོ་ན་བཞིན་དུ་དབུགས་དེས་བསྐྱོད་པའི་ལྕགས་ཀྱུ་དང་བུང་བ་དེ་དག་ཀྱང་རང་ཉིད་ཀྱི་དབུགས་ཀྱིས་དེའི་སྣ་བུག་གཡས་པའི་བུ་གའི་ལམ་དུ་ཞུགས་པར་བལྟས་ལ།",
    "ཛྙཱ་ན་ཀཱ་ཡ་བཱ་གཱི་ཤྭ་ར་ཨ་ར་པ་ཙ་ན་མ་གྲངས་བརྒྱ་རྩ་བརྒྱད་དུ་མཚན་བརྗོད་པས་ཀྱང་མཚན་ཡང་དག་པར་བརྗོད་པ་དུས་ཇི་ལྟ་བར་བཀླག་པར་བྱ་བ་ཡིན་ནོ།",
    "སྤྲོ་བར་བྱ་བ་ལ་སོགས་པ་སྔོན་དུ་བཏང་ཞིང་དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཡི་གེ་དྷཱི་དཀར་པོས་བསྐྱེད་པའི་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་དཀར་པོ་གཅིག་པུ་ཉིད་འབའ་ཞིག་གོ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་ཨ་ར་པ་ཙ་ནའོ།",
    "རྒྱུན་དུ་སྐྱིད་པོར་འདུག་པ་དང་ཁ་ཟས་སྐྱ་བ་ཟ་བ།",
    "སྤྱོད་ལམ་དལ་བར་འདུག་དང་སྐྱིད་པོར་འདུག་པ་སྤང་རྒྱུ།",
    "སྤྱོད་ལམ་དལ་བར་འདུག་དང་སྐྱིད་པོར་འདུག་པ་སྤང་རྒྱུ།",
    "རྩོལ་མེད་དལ་བར་འདུག་པ་སོགས་སྤང་བར་བྱ་དགོས་པ་ཡིན།་",
    "རྩོལ་མེད་དལ་བར་འདུག་པ།",
    "༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནས་ཁོང་རང་ཟླ་གཉིས་རིང་ལས་མཇུག་བསྐྱེལ་ཆེད་དུ་འགྲོ་བསྐྱོད་ཆོག་པའི་བཀའ་འཁྲོལ་བསྩལ་བ་བཞིན་རྡ་ས་ནས་ལྡི་ལིར་འབྱོར་རྗེས།",
    "ཐ་མ་རྡོར་གླིང་དུ་ཁྱུག་ཙམ་འགྲོ་བྱུང་ཞེས་བཀོད་འདུག།",
    "ཕྱི་རྒྱལ་གྱི་རོགས་དངུལ་འབྱོར་བ་རྣམས་གསང་བར་ཁག་དཀྲིས་ནས་ཁོ་རང་གཅིག་པོས་གནས་ཚུལ་ཁུངས་ལྡན་འབྱོར་དོན་དུ།",
    "ཁོང་རང་ནས་རྩིས་རྒྱག་རྩིས་སྤྲོད་ཀྱི་བྱེད་སྒོ།",
    "ཁོ་རང་སྤྱི་ཁྱབ་སྐལ་སྒར་དུ་བསྐྱོད་ཆོག།",
    "རྩིས་རྒྱག་སྐོར་སྔོན་ནས་རྩིས་རྒྱག་བྱས་ཟིན་འདུག་པས་ད་ལྟ་འཆར་གནང་དོན་ལྟར།",
    "ཁོ་རང་གདོང་དྷ་ས་བདེ་སྲུང་ལྷན་ཁང་དང་།",
    "རྒན་ཡེ་ཤེས་ཀྱིས་ཁྱེད་རང་འཇོན་པ་དང་མཁས་པོ།",
    "ཕྱི་ལོ་༡༩༦༧ ལོར་ནས་ཕྲན་གྱིས་དགོས་པ་མ་ཟད་དགའ་དབྱངས་སྲོག་ཐོག་ཏུ་འགྲོ་རྒྱུའི་ཉེན་ཁ་ཡོད་དེ་ལ་ཁྱེད་རང་ནས་བལྟ་ལས་ཀ་ཡག་པོ་བྱས་མི་འདུག་རྒན་ཡེ་ཤེས་ཀྱི་བཀའ་སྒྲུབ་པ་དང་།",
    "གལ་ཏེ་ཡང་རང་བཞིན་དང་གཞན་གྱི་དངོས་པོ་ངག་ཡོད་བ་མ་ཡིན་བ་དེ་ལྟན་ཡང་དངོས་པོ་ནི་མི་ཞུ་ཡོདཔ་ཡིན་ཏེ་མ་བཀག་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་སྟེ།",
    "དེ་ཡང་རང་བཞིན་ལུང་མ་བསྟན།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བཕུང་པོ་ལྔ་པོ་དེཡང་རང་བཞིན་གྱིས་ཡོདཔ་མ་ཡིན་ཏེ།",
    "འདིར་དཔྱད་པ་དེ་མི་འདུག་བ།",
    "ལྟག་པར་ཞེན་ནས་འདུག་པ་ལས་བདག་སྡུག་པིའོདེ་པོ་དང་།",
    "བདེན་པ་ཉིས་སུ་འང་རང་བཞིན་མེད་པའི་ཕྱིར་དེ་དག་རྟག་པ་མ་ཡིན་ཆད་པའང་ཡིན།",
    "པོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ལས་ནི་ཉན་ཐོས་དང་རང་སང་རྒྱས་ཐམས་ཅད་བྱུང་ངོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཇི་ལྟར་སྲང་མདའི་མཐོན་དམན་དག་དུས་གཅིག་ཉིད་དུས་བོན་འགག་བཞིན་དུ་པ་པ་ན་ན་མྱུ་མྱུ་གུ་གུ་སྐྱེ་སྐྱེ་བར་བར་འགྱུར་རོ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "ཉན་ཐོས་དང་རང་སངས་རྒྱུས་བཅས་རྩད་ངས་དངོས་པོ་ཐམས་ཅད་དང་།",
    "གཞན་ཡང་རང་བཞིན་སྟོང་པ་དང་ངོ་བོ་ཟུང་ཡང་རིམ་པ་ཡིན་མིན་དུ་སྐྱེ་བས་དྲོད་བྱུང་རྒྱལ་དུ་བསྐྱང་ངོ།",
    "ས་ཆེན་འདི་ནི་དགའ་ཞིང་རངས་ལ་མགུ།",
    "ཆོ་ག་ཡིས་ཞེས་བྱ་བ་ནི་སྔགས་ཀྱི་སྐུ་ལ་སོགས་པ་དང་རང་བྱིན་གྱིས་བརླབ་པའི་རྣལ་འབྱོར་གྱིས་སོ།",
    "གཉི་གའི་རང་བཞིན་རོ་གཅིག་པར་འདུག་པ་ནི་མ་བཅོས་ཤིང་མ་བརྟགས་པ་སྟེ་མཐར་ཐུག་པའོ།",
    "སྣར་ལ་ཧཱུྃ་ཞེས་འཁོད་འདུག་ཀྱང་བསྡུར་མཆན་དུ་བཀོད་མེད།",
    "འཇམ་པོའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དང་པོ་ཁོ་ནར་ཡིད་དང་རྗེས་སུ་མཐུན་པའི་གནས་སུ་འདུག་སྟེ།",
    "སྤྱན་སྔ་རུ་ནི་འདུག་པར་འགྱུར།",
    "འདུ་ཤེས་ནི་ཡུལ་ལ་མཚན་མར་འཛིན་པའི་བདག་ཉིད་ཅན་ཡིན་ཞིང་འདི་ཡང་རང་དང་གཞན་གྱི་རྒྱུད་ལ་ཡོད་པའི་དངོས་པོའི་ཚོགས་ཀྱི་ཡུལ་སྒྱུ་མའི་དཔེ་བཅུ་གཉིས་ཀྱིས་རིམ་པར་ཐོབ་པ་ནི་འདུ་ཤེས་སོ།",
    "རྣམ་པར་ཤེས་པ་དང་རང་བཞིན་གྱི་ཚོགས་འོད་གསལ་བར་ཐིམ་པའི་ཕྱིར་རོ།",
    "དེའི་རྗེས་ལ་སེམས་རྣམ་པར་དག་པའི་རིམ་པས་རྣམ་པར་ཤེས་པ་བརྒྱད་པོ་སྡུད་པར་བྱེད་པའི་རང་བཞིན་ཅན་ཡེ་ཤེས་གསུམ་དང་རང་བཞིན་རྣམས་ཀྱི་ངོ་བོ་སེམས་རྣམ་པར་དག་པར་བྱེད་དོ།",
    "གང་དག་དུས་ལྔ་དགའ་བ་དང་།",
    "བཅུ་ཡིས་ཏེ་རྩ་དགུ་པོ་དེ་རྣམས་དང་རང་ཉིད་ཀྱིས་མ་བཅིངས་པ་ནི་ལྷན་ཅིག་སྐྱེས་པའི་རང་བཞིན་ཉིད་ཡིན་པའི་ཕྱིར་འདོད་ཆགས་ལ་སོགས་པའི་ཉེས་པ་རྣམས་ཀྱིས་དྲི་མ་ཅན་དུ་བྱ་བ་མ་ཡིན་པའོ།",
    "བཅུ་པོ་འདི་རྣམས་ཀྱིས་འོད་གསལ་བ་གང་ཞིག་མ་བཅིངས་པ་ནི་རྣམ་པར་ཤེས་པ་དང་རང་བཞིན་རྣམས་ཀྱིས་དྲི་མ་ཅན་དུ་མ་བྱས་པའོ།",
    "མྱུར་བ་དང་ནི་རྣལ་འདུག་དང་།",
    "རྣལ་འདུག་ནི་མཆོག་གོ།",
    "སྣང་བ་ནི་ཤེས་པ་དང་ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པ་དང་རང་བཞིན་རྣམས་ཏེ་དེ་དག་སྤངས་པའི་ཕྱིར་སྣང་བ་མེད་པའོ།",
    "དེ་ཉིད་ཀྱི་ཅི་དགའ་སྟེ་ཇི་ལྟར་འདོད་པར་འགྱུར་བ་སྟེ་དེ་ཁོ་ན་བཞིན་དུ་གལ་ཏེ་འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བའི་མཚན་ཉིད་ཀྱི་བྱ་བ་སྤྱོད་པ་བྱེད་པ་དེའི་ཚེ།",
    "སྟན་གཅིག་ལ་འདུག་ནས་ཇི་སྲིད་ཚིམ་པ་དེ་སྲིད་དུ་ཟ་ཞིང་སྟན་དེ་ལས་ལངས་ནས་ཡང་མི་ཟ་བ་དེ་ནི་སྟན་གཅིག་པ་ཞེས་བྱའོ།"
