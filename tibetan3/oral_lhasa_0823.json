    "རང་བཞིན་སྣང་ཙམ་མ་འགགས་པས་གཟུགས་བརྙན་ལྟར་སྣང་བ་ཉིད་ཀྱིས་སྟོང་པར་ཤར་ཏེ།",
    "སྣང་སྟོང་སྒྱུ་མའི་རོལ་པར་གྲོལ་བ་ནི།",
    "བར་སྣང་རྫས་རྣམས་བརྟེན་པར་མི་ནུས་ཤིང་།",
    "རྟ་དང་གླང་པོ་ཤིང་རྟ་སྣ་ཚོགས་བྱས།",
    "མ་སྐྱེས་རྣམ་པར་དག་པས་སྒྲིབ་པ་མེད།",
    "བགྲོད་ལམ་ནམ་མཁའ་ལྟ་བུར་དག་པས་ཡེ་གྲོལ་བྱ་བཙལ་ལས་འདས་པར་བསྟན་པ་ནི།",
    "ལྟ་སྒོམ་ཡེ་གྲོལ་སྤང་བླང་མེད་པར་གྲོལ།",
    "ཏིང་འཛིན་ཡེ་གྲོལ་བསམ་ཡུལ་འདས་པར་གྲོལ།",
    "ས་ལམ་ལྟ་སྒོམ་ལ་སོགས་པ་རིག་པའི་ངང་དུ་བྱེད་ཀྱང་བྱ་བྱེད་རྫས་འགལ་བས་ཡེ་གྲོལ་བྱར་མེད་ཆེན་པོར་རྟོགས་པར་བྱ་སྟེ།",
    "ཡིན་མིན་མེད་པའི་མཐའ་གཉིས་རྣམ་པར་བསལ།",
    "རང་བྱུང་ཡེ་ཤེས་བརྫུན་པར་འགྱུར།",
    "ཀ་དག་ཡེ་ཤེས་བརྫུན་པར་འགྱུར།",
    "རྫོགས་ཆེན་གནས་ལུགས་བརྫུན་པར་འགྱུར།",
    "སྐད་ཅིག་རྣམ་གསུམ་བརྫུན་པར་འགྱུར།",
    "ཡེ་ཤེས་འོད་གསལ་བརྫུན་པར་འགྱུར།",
    "བྱས་པས་ལྷུན་རྫོགས་དོན་མི་རྙེད།",
    "བྱས་པས་ལྷུན་རྫོགས་དོན་རྙེད་ན།",
    "རང་བཞིན་འགག་མེད་བརྫུན་པར་འགྱུར།",
    "ཐུགས་རྗེ་ཀུན་ཁྱབ་བརྫུན་པར་འགྱུར།",
    "གང་དག་འཛིན་པ་སྟོང་པར་འགྱུར།",
    "ངར་འཛིན་ཡུལ་ལས་རྣམ་པར་ཐར།",
    "རྟག་པར་འཛིན་པའི་ཡུལ་ལས་གྲོལ།",
    "རང་བྱུང་སྤྲོས་པ་དང་བྲལ་བའི་ངང་དུ་མ་ཡེངས་རྗེན་པར་གཞག་གོ།",
    "རང་བྱུང་དོན་གྱི་དགོངས་པར་ལ་བཟླ་སྟེ།",
    "དོན་མ་བཅོས་རང་གསལ་དུ་ནང་དུ་ལྟོས་དང་རྙེད་པར་ངེས་སོ་ཞེས་པ་སྟེ།",
    "དམིགས་པ་མེད་ཅིང་འགྱུར་བའི་གནས་ལ་མི་ལྟོས་པར།",
    "ཡོད་མེད་ཡེ་གྲོལ་མཐའ་ལས་འདས་པར་གྲོལ།",
    "རྟག་ཆད་ཡེ་གྲོལ་གཞི་རྩ་མེད་པར་གྲོལ།",
    "ཡང་དག་ཡེ་གྲོལ་དམིགས་བསམ་འདས་པར་གྲོལ།",
    "ཡང་དག་མིན་གྲོལ་ཕྱོགས་བསམ་འདས་པར་གྲོལ།",
    "ལས་རྣམས་ཡེ་གྲོལ་གོས་པ་མེད་པར་གྲོལ།",
    "བག་ཆགས་ཡེ་གྲོལ་རྟེན་གཞི་མེད་པར་གྲོལ།",
    "རྣམ་སྨིན་ཡེ་གྲོལ་མྱོང་གཞི་མེད་པར་གྲོལ།",
    "རྣམ་པར་སྨིན་པ་དང་།",
    "གཉེན་པོ་ཡེ་གྲོལ་སྤང་བྱ་མེད་པར་གྲོལ།",
    "སྤང་བླང་གཉིས་མེད་མཁའ་མཉམ་ཡངས་པར་གྲོལ།",
    "གྲོལ་བ་ཡེ་གྲོལ་བཅིངས་པ་མེད་པར་གྲོལ།",
    "མ་གྲོལ་ཡེ་གྲོལ་བཅིངས་གྲོལ་མེད་པར་གྲོལ།",
    "རྟོག་པའི་ཡུལ་ལས་རྣམ་པར་འདས།",
    "དེ་ལ་འབད་རྩོལ་བྱས་ཀྱང་དོན་མེད་པས།",
    "ཚིག་གཅིག་ལན་གཉིས་བརྗོད་པར་བྱ།",
    "མེད་སྟོང་ཡིན་པས་རིག་པའི་དྭངས་མ་འགག་པར་འཇོག་པའོ།",
    "བསྒོམས་པས་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "བསྐྱེད་པས་རྫོགས་པར་མི་འགྱུར་ཏེ།",
    "གཟུང་བས་ཟིན་པར་མི་འགྱུར་ཏེ།",
    "སྦྱངས་པས་ཕྱིན་པར་མི་འགྱུར་ཏེ།",
    "བསྒྲུབས་པས་ཐོབ་པར་མི་འགྱུར་ཏེ།",
    "རང་རིག་དང་པོའི་གཞི་ལས་མ་གཡོས་པར་བསྟན་པ་དང་།",
    "ཁྲེགས་ཆོད་ཀྱི་སྐབས་འདིར་ཐོད་རྒལ་ལས་གོ་ལྡོག་པར་བསྟན་པ་ཡང་།",
    "ཞེས་གསུངས་པའི་དོན་ཏོ།",
    "བློས་བྱས་བཅོས་མའི་གཞི་མཐའ་བྲལ་གདེང་དུ་འཆའ་བའི་ལྟ་བ་ལས་ལོག་སྟེ་གཏད་མེད་ཕྱོགས་བྲལ་གྱི་རིག་པ་མཚོན་བརྗོད་ཀྱི་ཡུལ་ལས་འདས།",
    "དྲན་བསམ་གྱི་སྤྱོད་པ་སྣ་ཚོགས་ཅི་བྱས་ཀྱང་རོལ་པར་ཤར་བ་ངོ་མཚར།",
    "ཇི་ལྟར་བྱས་ཀྱང་སྐྱེ་མེད་ཀྱི་ཀློང་དུ་འགག་མེད་གྲོལ་བ་ཧ་ཧ།",
    "འབད་རྩོལ་མེད་པར་འབྲས་བུ་རང་རྙེད་པ་ངོ་མཚར།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་མ་སྤྱད་པར་ཚོགས་རྣམས་དུས་གཅིག་ལ་རྫོགས་པ་ཧ་ཧ།",
    "གཉིས་སུ་མེད་པར་གྱུར་ཏོ་ཞེས་རྒྱ་ཆེར་གསུངས་པ་གང་ཡིན་པའོ།",
    "དུ་བདེན་པར་འཛིན་པའི་གཏད་འཛིན་སྟོར་བས།",
    "རང་ལ་རང་སྟོབས་སྐྱེས་ནས་ཞེས་རྒྱ་ཆེར་གསུངས་པ་དག་གོ།",
    "མེད་ཡེ་གྲོལ་དགོངས་པར་ལྷུན་གྲུབ་པས།",
    "རིག་པའི་ངོ་བོ་མཐོང་བ་ལ་ཁྱད་པར་རྡུལ་ཙམ་ཡང་མེད་པར་ཀུན་ཏུ་བཟང་པོ་ངས་བསྟན་པའོ།",
    "སངས་རྒྱ་བ་ལ་ཁྱད་པར་རྡུལ་ཙམ་ཡང་མེད་པར་ཀུན་ཏུ་བཟང་པོ་ངས་བསྟན་པའོ།",
    "ཚོགས་རྫོགས་པའི་སྒོ་ལ་ཁྱད་པར་རྡུལ་ཙམ་ཡང་མེད་པར་ཀུན་ཏུ་བཟང་པོ་ངས་བསྟན་པའོ།",
    "དངོས་པོ་མཐོང་བ་ལ་ཁྱད་པར་རྡུལ་ཙམ་ཡང་མེད་པར་ཀུན་ཏུ་བཟང་པོ་ངས་བསྟན་པའོ།",
    "ངོ་བོ་རྟོགས་པ་ལ་ཁྱད་པར་རྡུལ་ཙམ་ཡང་མེད་པར་ཀུན་ཏུ་བཟང་པོ་ངས་བསྟན་པའོ།",
    "འབྲས་བུ་ཐོབ་པ་ལ་ཁྱད་པར་རྡུལ་ཙམ་ཡང་མེད་པར་ཀུན་ཏུ་བཟང་པོ་ངས་བསྟན་པའོ།",
    "འབད་པ་མེད་པར་ཉམས་སུ་ལོངས་པའི་གདེང་རྙེད་ནས།",
    "དེ་ལྟར་འཁྲུལ་པ་ཡང་མེད་པ་ལ་བདག་དུ་བཟུང་བས་བྱུང་བའི་ཕྱིར་ཞེན་འཛིན་སྤང་པར་གདམས་པ་ནི།",
    "དེ་ལས་རོལ་པར་ཤར་ལ་འཛིན་པས་བཅིངས།",
    "མེད་ལ་ཡོད་པར་འཛིན་པས་མ་བསླུ་ཞིག།",
    "རོལ་པར་སྣང་བའི་དུས་ནས་དོན་གྱི་ངོ་བོ་མ་གྲུབ་པས་ཡུལ་གྱི་རྣམ་པ་དང་།",
    "དོན་ལ་སེམས་ཉིད་ཀྱི་ངོ་བོ་མ་རིག་པར་ངང་ལས་ཤར་བའི་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "ཀུན་བྱེད་ང་ཡི་རང་བཞིན་མ་རྟོགས་པར།",
    "མི་རྟག་སྒྱུ་མའི་རང་བཞིན་འཇིག་པར་འགྱུར།",
    "བསྟན་ཅིང་ཐོས་པར་ལྟ་ཅི་སྨོས་ཏེ།",
