    "ཞལ་ནས་གསང་འཛབ་བགྲངས་འདུག་བསམ་པ་བྱུང་།",
    "ཡེ་སྟོང་རང་བཞིན་མེད་པར་ཞོག་གཞན་དོན་གྱི་ཟས་ལ་ཟ་མ་དགའ།",
    "དེ་ལྟར་གསུངས་ཏེ་གཤེགས་ནས་གདའ།",
    "སླར་ཡང་འགྲོ་ཉལ་འདུག་སྡོད་ནམ་ཀྱང་ཡང་",
    "དེ་ནས་འཆི་ཀའི་དུས་ལ་ཅོག་བུར་འདུག་སྟེ།",
    "འདུག་པའི་གནས་དང་།",
    "དང་པོ་འདུག་པའི་གནས་ནི།",
    "བསམ་མནོ་དང་བྲལ་བའི་ངང་ལ་འདུག་སྟེ།",
    "ཆོད་དུ་དེ་ལྟར་འདུག་བཅོལ།",
    "ཉི་མ་བདུན་དེ་ལྟར་བར་སྣང་ཁམས་སུ་བལྟའ་སྟེ་འདུག་བཅོལ།",
    "དེ་ཡང་རང་ཁར་བཏང་བ་མ་ལགས་སྟེ།",
    "ངོའོ་གཅིག་ཏུ་འདུག་པ་སྟོང་པ་ཡིན།",
    "གང་ཡང་གཉིས་མེད་གཅིག་ཏུ་སྟོང་སང་ངེ་འདུག་པ་འདི།",
    "ཅི་ཡང་མ་ཡིན་སྟོང་སང་ངེ་འདུག་པ་འདི།",
    "མ་འོང་རང་བཞིན་མེད་པར་ཕྱིན།",
    "རང་སྣང་རང་འོད་རང་སྒྲ་རུ།",
    "གཞན་སྣང་རྡུལ་ཙམ་ཡང་མི་གདའོ།",
    "རྟོག་པ་མེད་པའི་ངང་ལ་འདུག་ཀྱང་།",
    "སྟོང་ལ་དམིགས་མེད་དུ་འདུག་པ་དེ།",
    "གང་ལ་ཡང་རང་བཞིན་སྣང་ངམ།",
    "སྣ་ཚོགས་རང་འབྱུང་རང་གྲོལ་སྤྲུལ་པའི་སྐུ།",
    "ཡང་བསྒྲུབ་པ་པོ་སྒོམ་ནས་འདུག་པའི་དུས།",
    "སྣ་ཚོགས་མི་འཕྲོ་སྟོང་སང་ངེ་འདུག་པའི་དུས་ལ།",
    "དེ་ནས་འཕྲོ་མེད་སྟོང་པར་གནས་ཀྱང་ཞེ་འཛིན་མེད་པར་ཞོག་དགེ་སྦྱོར་ཡི་ངང་ལ་འདུག་ཙམ་ན།",
    "རྣལ་འབྱོར་དགེ་སྦྱོར་ངང་ལ་འདུག་དུས།",
    "ངོའོ་ངང་ལ་འདུག་པའི་དུས་རང་འབྱུང་རང་ཤར་རང་ཡལ་མི་ཤེས་ནས།",
    "རང་འབྱུང་རང་ཞི་སྟོང་པའི་ངང་དུ་བཞག་མི་གཡོ་བའི་ངང་ནས་འགག་མེད་འཆར་བ་དེ།",
    "ཡེ་ཤེས་གསལ་ཆ་མི་གདའ་ནས།",
    "རིག་པ་རང་སྒྲིབ་བྱིང་རྨུག་དུས།",
    "ཅི་ཡང་མ་ཡིན་སྟོང་སང་ངེ་འདུག་པ་དེ།",
    "སྣ་ཚོགས་འཆར་ཞིང་རང་བཞིན་མེད་པ་ནི།",
    "སྣ་ཚོགས་འཆོར་ཞིང་རང་བཞིན་མེད་པར་སྟོང་།",
    "རིག་པའི་ངོའོ་སྟོང་སང་ངེ་འདུག་པ་དེ་ལ་ཟེར་བ་ཡིན།",
    "ཁྲོམ་གསེབ་ན་འདུག་སྟེ་ཉམས་ལེན་སྐྱོངས་དུས་ལ།",
    "དངོས་མེང་རང་འབྱུང་སྟོང་པར་ངོས་ཀྱིས་བཟུང་།",
    "ཅི་ཡང་མ་བཅོས་སྟོང་སང་ངེ་འདུག་པ།",
    "གྲངས་སུ་མང་ཡང་རང་རིག་ཅི་ཡང་མ་ཡིན་པ།",
    "དྲན་པ་སྣ་ཚོགས་རང་འབྱུང་རང་ཤར་རང་གྲོལ་དུ་བཞག་པ་ལ་ཟེར་བ་ཡིན།",
    "ཆུ་ཤིང་འཛོམ་སྟེ་ཉམས་དགའ་དང་སྤྲོའི་གནས་མཆོག་འདུག་གནས་བདམ་པ་ཡང་ཤིན་དུ་གལ་ཆེ་སྟེ།",
    "དེ་ནས་གཅིག་འདུག་བྱེད་པའི་དུས།",
    "བྱིང་རྨུག་མེད་པར་སལེ་འདུག་པ་ལ་ཟེར་བ་ཡིན།",
    "མ་བསྒོམ་བས་ཀྱང་སྟོང་པར་འདུག་སྒོམ་དང་མི་སྒོམ་ཁྱེད་ཁྱད་པར་མེད།",
    "རྣམ་རྟོག་རང་འབྱུང་རང་ཤར་ཡིན།",
    "རྟོག་པ་མེད་དེ་རང་འབྱུང་རང་ཡལ་དུ་བཞག་དེ་ལ་བཟང་རྟོག་ངན་རྟོག་ཤེས་པ་ཐམས་ཅད།",
    "རང་བཞིན་མེད་དེ་སྟོང་པར་འདུག་ནས་རང་རིགས་རིག་",
    "དམར་ཐག་བཅད་མཁན་ལོག་ན་མི་གདའ་སྟེ།",
    "མིང་བརྒྱ་མཁན་སྟོང་རང་སེམས་འདི།",
    "ད་ལྟ་རང་རིག་ཅི་ཡང་མེད་དེ་སྟོང་སང་ངེ་འདུག་པ་དེ་ཀ་བོན་སྐུ་ཡིན།",
    "ཤེས་རྒྱུ་ཅི་ཡང་མེད་སྟེ་སྟོང་པར་འདུག་པ་གཅིག་ཡོད།",
    "རྟོག་པ་རང་ཁ་མའི་ཁས་ཁྱེར་བ་ལ་ཡེ་ཤེས་སུ་འདོད་པ་ཡང་མང་བར་གདའ་སྟེ་ག་ལ་བཏུབ།",
    "བལྟས་ནས་ཅི་ཡང་མ་མཐོང་སྟོང་པར་འདུག་ན།",
    "སྟོང་ཕྱ་ལེ་འདུག་པ་དེ་ཀ་ཡིན།",
    "ཅི་ལྟར་ཡིན་ཀྱང་སྟོང་པ་ལས་མི་གདའོ།",
    "རྒྱ་མཚོ་ལས་གཡོ་བ་མེད་དེ་མཁའ་སྟེང་ཁ་གཏིང་མེད་པ་རུ་འདུག་པས།",
    "ད་ལྟ་དྲན་པ་སྣ་ཚོགས་འགྱུ་བ་དེ་ཉིད་ལ་རང་བཞིན་མེད་དེ་སྟོང་པར་འདུག་ན།",
    "གང་ཡང་ངོའོ་གསལ་སྟོང་རང་བཞིན་མེད།",
    "ངོའོ་དོན་དུ་གཅིག་བེས་སོ་སོར་མི་གདའོ།",
    "སྐྱེས་བུ་རང་གནས་སུ་འདུག་པ་ལ།",
    "མཆེན་མཆན་ནས་མི་རྒོད་ལྔ་ལང་ནས་འདུག་དུ་མི་བཅོལ་ས་ཁྱེར་གནམ་ཁྱེར་བྱེད།",
    "རང་གནས་སུ་འདུག་ཟེར་བ་ནི།",
    "མི་རྒོད་ལྔ་ལང་ནས་འདུག་མི་བཅོལ་ཟེར་བ་ནི།",
    "སྟོང་ལ་རང་བཞིན་མེད་པ་གཅིག་འདུག་ན་དོན་ནི་དེ་ཀ་ཡིན།",
    "རྟོག་པ་བློ་སྒོམས་དུ་འདུག་ནས་ཡིན་པར་འདོད་སྟེ་དེ་ཡང་མ་ལགས་སོ།",
    "ངོའོ་འདི་ལ་འང་རང་བཞིན་མེད་པས་སྟོང་།",
    "རང་འབྱུང་རང་ཤར་གྱིས་གྲོལ་ཆ་བསྟོན་པའོ།",
    "ཁོ་རང་ཤད་ཀྱིས་འགྲོ་སྟེ་ཡན་དུ་བཏང་ན་འགྲོ་ས་མེད།",
    "སྐུའི་ཐ་སྙད་དངོས་པོར་མི་གདའ་སྟེ།",
    "རང་འབྱུང་རང་ཤར་ཡེ་ཤེས་འགགས་པ་མེད།",
    "ཐམས་ཅད་ངོའོ་གཅིག་སྟེ་སོ་སོར་གདའ་ཅེས་གསུངས་སོ།",
    "ངོའོ་གཅིག་ལས་འགྱུར་བ་མི་གདའ་སྟེ།",
    "ལམ་ལ་བསྒྲོད་ན་འགྲོ་ས་མི་གདའ་སྟེ།",
    "འབྲས་བུ་སྒྲུབས་རྒྱུ་ཅི་ཡང་མི་གདའ་སྟེ།",
    "སྟོང་སང་ངེ་འདུག་དུས་གཟའ་གཏད་བྲལ་བར་བཞག་གསལ་སལེ་འདུག་དུས་ཞེ་འཛིན་བྲལ་བར་བཞག་སྣ་ཚོགས་འཕྲོ་དུས་རང་གྲོལ་སྟོང་པར་བཞག་གསལ་སྟོང་མ་བུ་འདྲེས་དུས་གཡོ་བསྐྱོད་མེད་པར་བཞག་སེམས་ཉིེད་ཡེ་སྟོང་ཡིན་ངོ་ཤེས་པ་ལ།",
    "སེམས་ཀྱི་སེམས་ལས་བལྟས་ནས་ཅི་ཡང་མི་གདའ་ན།་",
    "རིག་པའི་ངོའོ་སྟོང་སང་ངེ་འདུག་པ་བསམ་མནོའ་འཕྲ་འཕྲོ་ཅི་ཡང་མེད་པ་འདི་ལ་ཟེར་བ་ཡིན།",
    "སོ་སོར་མི་གདའ་དོན་དུ་ཅིག་སེམས་ཀྱིས་རང་བཞིན་ཤེས་པ་གཞི་ཡིན།",
    "དྲན་པ་འགག་མེད་ཅི་བྱུང་ཡང་སྐྱོན་དུ་ལྟ་རྒྱུ་དང་རས་སུ་བོར་རྒྱུ་གཅིག་ཀྱང་མི་གདའོ།",
    "བསམ་མནོ་མེད་དེ་སྟོང་སང་ངེ་འདུག་པ་འདི་ནི་ཡེ་གནས་ཀྱིས་མ་ཡང་ཟེར།",
    "མ་སྒྲིབ་རང་བཞིན་མེད་དེ་གསལ་སལེ་འདུག་པ་འདི་ལ།",
    "མི་རྟོག་པ་གཅིག་དུ་འདུག་ན།",
    "དཔེ་ནམ་མཁའ་སྟོང་པ་ཡང་རང་བཞིན་མེད།",
    "དོན་བོན་ཉིད་སྟོང་པ་ལའང་རང་བཞིན་མེད།",
    "རྟགས་སེམས་ཉིད་ལ་ཡང་རང་བཞིན་མེད།",
    "དོན་བོན་ཉིད་ལ་ཡང་རང་བཞིན་མེད་དེ།",
    "ལྟ་མཁན་དང་ཞེ་སྡང་གང་ལ་ཡང་རང་བཞིན་མེད་པར་སྟོང་སངས་ཀྱིས་འགྲོ་བའོ།",
    "ཡང་ངོའོ་ཡི་ངང་ལ་སང་ངེ་འདུག་པའི་དུས་ལ་ཐོལ་སྐྱེས་ཀྱིས་རྟོག་པ་རྩིང་ཤོས་མི་འཕྲོ་སྟེ།",
    "དེ་ནས་སྟོང་པ་གཅིག་དུ་གཏད་ནས་མི་འདུག་སྟེ།",
    "འཁྲུལ་སྣང་རང་ཁར་ཤོར་བའོ།",
    "དྲན་པ་ལ་ཡང་རང་བཞིན་མེད་དེ་སྟོང་པའི་ཀློང་དུ་སངས་པ་དེ་ལས་ཡེ་ཤེས་འཆར་ཟེར་བའི་མིང་བཏགས་པ་ཡིན།",
    "རྟོག་པ་དེ་ལ་ལྟོས་དང་རང་བཞིན་མེད།",
    "སྣ་ཚོགས་འགག་མེད་རང་འབྱུང་རང་གྲོལ་དུ།",
    "སྟོང་ལ་མི་དམིགས་སལེ་འདུག་ན།",
    "ཐོལ་སྐྱེས་ཀྱིས་ཤེས་པ་བཟང་རྟོག་ངན་རྟོག་ཅི་བྱུང་ཡང་རང་འབྱུང་ངོ།",
