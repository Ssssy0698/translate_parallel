    "ཚེ་འདིར་ངེས་པར་སྨིན་དགོས་པས།",
    "གསུངས་པའི་ལས་ནི་དེ་ཡིན་ཏེ།",
    "ནམ་ཞིག་ངེས་པར་སྨིན་དགོས་པ།",
    "ཚེ་འདིར་སྨིན་པའང་སྲིད་ཅེས་གསུངས།",
    "རང་བྱས་རང་ལ་སྨིན་པ་ཡིན།",
    "མ་བྱས་ལས་དང་འཕྲད་མི་སྲིད།",
    "བྱས་པ་ནམ་ཡང་ཆུད་མི་ཟ།",
    "སྐྱེ་བ་ལྔ་བརྒྱར་ལྐུགས་པར་སྐྱེ།",
    "ལས་འབྲས་ཕྲ་ཞིབ་ཡང་ཡང་བསམ་། སྤང་བླང་ལག་ལེན་ཐེབས་པར་མཛོད།",
    "ཉམས་ལེན་བརྩོན་འགྲུས་ཁོ་ན་ལགས།",
    "དེ་ཕྱིར་དེ་ལ་འབད་པར་བྱ།",
    "འཁྱགས་ན་སུ་ཞིག་བསྲན་པར་ནུས།",
    "སྔར་བྱས་སྡིག་ལ་བཤགས་སྡོམ་དང་།",
    "ཉེས་ལྟུང་གང་བྱུང་འཕྲལ་དུ་བཤགས།",
    "ལུས་ངག་མི་དགེ་མ་བྱས་ཀྱང་།",
    "ཅེས་གསུངས་ཤོ་ལོ་ཀ་དེ་ལ།",
    "གདུལ་བྱའི་བློ་ཚོད་འཚམ་པར་གསུངས་པ་སྟེ།",
    "སྡོམ་ལྡན་དམ་གཙང་སྲིད་ཕྱིར་དམ་ཉམས་སྲིད།",
    "ཤེས་པར་བྱ་ལ་དེ་རུ་འཇུག་མི་བྱ།",
    "མུ་སྟེགས་གཞུང་རྣམས་བསླབས་ནས་མཁས་པར་སྦྱངས།",
    "དེ་ནི་མཐའ་འཁོབ་མི་དང་ཁྱད་པར་ཅི།",
    "ཞིབ་པར་ལྟ་ལོག་སུམ་བརྒྱ་དྲུག་ཅུ་གསུངས།",
    "མུ་སྟེགས་ནག་པོ་ཆད་པར་ལྟ་བ་སྟེ།",
    "ལྟ་བ་ལོག་པ་འཛིན་པར་འགྱུར་བ་ཡིན།",
    "དེ་བཞིན་མུ་སྟེགས་རྟག་ལྟའི་རིགས་རྣམས་ཀྱིས་། ཕྱི་མ་སྐྱེ་བ་ལེན་རྒྱུ་ཡོད་ལགས་ཏེ།",
    "གསུངས་པའི་རྒྱུ་འབྲས་དོན་ལ་བློ་མི་གཏོད་། གསོན་པོའི་རིམ་གྲོ་གཤིན་པོའི་དགེ་རྩ་ལ།",
    "མི་ཡི་ཟས་གོས་སྤངས་ན་དག་པར་འདོད།",
    "ལེགས་པར་སྦྱར་བ་ཚངས་པ་ལྷ་ཡི་སྐད།",
    "ཕྲ་ཞིབ་ཉེས་བྱས་རྣམས་ལ་གསོ་སྦྱོང་འབད།",
    "བཅོ་ལྔ་པ་ལགས་ཏེ།",
    "ལུས་སྲང་དྲན་པ་མངོན་དུ་གཞག་བྱས་ཏེ།",
    "ཡོངས་འཛིན་སྨྲ་བའི་སེང་གེའི་ཞལ་ནས་གསུངས་། དེ་ཡིས་ཉེས་བྱས་ཕྲ་ཞིབ་ཐམས་ཅད་དག།",
    "ཁྲག་རྣག་གཅིན་རྟུག་མི་གཙང་རྫས་ཀྱིས་གང་།",
    "མི་གཙང་རྐྱལ་པ་གོས་ཀྱིས་བཏུམས་པ་ཉིད།",
    "རང་གཞན་ལུས་ལ་མི་གཙང་འདུ་ཤེས་བསྒོམ།",
    "མཚང་འབྲུ་བ་ཡི་ལན་དུ་མཚང་མི་འབྲུ་། རྡུང་བཏག་བྱས་པའི་ལན་དུ་ལག་མི་བརྫོག།",
    "མཆོད་རྟེན་སྐུ་གཟུགས་བཞེངས་དང་ཕྱག་བསྐོར་བྱ།",
    "རྒྱལ་བའི་བཀའ་རྣམས་བཞེངས་དང་ཀློག་པར་བྱ།",
    "ཁྱད་པར་བྱམས་པའི་སྤྲུལ་པ་ཞྭ་དམར་བ།",
    "འདི་དག་རྣམས་ཀྱི་མིང་གནང་སྐྲ་ཕུད་དང་། དགེ་ཚུལ་དགེ་སློང་ལ་སོགས་ཞུས་པ་རྣམས།",
    "ཞལ་མཐོང་དགྲ་བཅོམ་ངེས་པར་ཐོབ་པར་བཤད།",
    "དུས་གཅིག་འབྱུང་ཞིང་ཕྱོགས་གཅིག་བཞུགས་པ་ལ།",
    "རང་རྒྱལ་བརྒྱད་ཁྲི་འབྱོན་པར་གསུངས་པ་ཡིན།",
    "འབྲུག་སྒྲོག་གློག་འབྱིན་ས་ཡང་རྣམ་པར་གཡོ།",
    "དག་པའི་ཞིང་དུའང་སྐྱེ་བ་མི་བཞེས་ཏེ།",
    "དེ་ལྟར་བཞུགས་ཤིང་བསྐལ་པ་བརྒྱད་ཁྲི་ནས།",
    "ཉན་རང་ལམ་དུ་གོལ་ན་ལོད་པར་བཞེད།",
    "ཀརྨ་བརྩོན་འགྲུས་རྒྱ་མཚོ་ལེགས་པར་གསོན།",
    "འགྲོ་བ་ཀུན་ལ་ཕན་པར་མ་བྱས་ན།",
    "བསྐལ་པ་བྱེ་སྟོང་བསམ་གྱིས་མི་ཁྱབ་པར།",
    "སྙམ་དུ་བློ་སྟོབས་ཆེན་པོ་བསྐྱེད་པར་བྱ།",
    "བཅོས་པར་སླ་སྟེ་ཉམས་ཀྱང་འཕྲལ་དུ་སྐྱེ།",
    "ཁྱད་པར་ཐུབ་པའི་མཛད་པ་བཅུ་གཉིས་པོ།",
    "ཀ་བ་བདེན་པར་མ་གྲུབ་མིང་བཏགས་ཙམ་། དེ་བཞིན་ཕྱི་སྣོད་ནང་བཅུད་དངོས་པོ་ཀུན།",
    "གང་ཡང་བདེན་པར་མ་གྲུབ་སྟོང་པ་ཉིད།",
    "ཤེས་བྱ་ཀུན་མཁྱེན་དྷརྨེ་ཤྭ་ར་ཡི།",
    "གཞུང་ལུགས་སྨྲ་བ་རྣམས་ཀྱི་དྲུང་དུ་བཤགས།",
    "ཞུས་ལན་མགུར་དུ་བྱས་པ་མངྒ་ལཾ།",
    "གཞུང་ལུགས་རྒྱ་ཆེན་ཐོས་བསམ་མ་བྱས་རྣམས།",
    "སྡོམ་པ་གསུམ་གྱི་སྲུང་ཚུལ་མུན་སེལ་ཉི་མའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དབུས་གཙང་མཁས་པ་ཀུན་གྱི་རྩོད་གཞི་ལགས།",
    "འགྲན་མེད་རྒྱུད་རྒྱལ་ཀྱེ་ཡི་རྡོ་རྗེ་ལས་། སོ་ཐར་བྱང་སྡོམ་སྔགས་སྡོམ་རིམ་པར་ཞུ།",
    "དེ་ཉིད་བོད་དུ་ལན་གསུམ་ཕེབས་པ་ཡི།",
    "དགེ་སློང་བར་དུ་རིམ་པར་ཞུས་བྱས་ཏེ།",
    "བྱང་སྡོམ་དེའང་སྔགས་ཀྱི་སྡོམ་པར་འགྱུར།",
    "མངའ་རིས་དབུས་གཙང་ཀུན་ཏུ་སེར་ཁྱིམ་དར།",
    "བདེ་མཆོག་རཱ་ལི་ཉེར་བཞིའི་རྒྱུད་རྣམས་གསུངས།",
    "ཆགས་ལམ་ལ་སོགས་བརྟེན་པར་བྱས་ན་ཡང་།",
    "སྡོམ་པ་གསུམ་ཀ་ཐོབ་པར་རློམས་ནས་ཀྱང་།",
    "བྱང་སྡོམ་སྔགས་སྡོམ་གཉིས་ཀ་མེད་པར་འགྱུར།",
    "དེ་ཕྱིར་སོ་ཐར་སྡོམ་པ་གཟབ་དགོས་པར།",
    "གསུངས་ཕྱིར་སྔགས་སྡོམ་མི་སླ་ཤིན་ཏུ་དཀའ།",
    "དེ་དག་རྫུན་དུ་ཆེ་གསུངས་བཞད་གད་མཛད།",
    "དེ་ནི་ཁྱིམ་པ་རྡོར་འཛིན་རྣམ་པར་དག།",
    "དེ་ཕྱིར་སྡོམ་རོ་ཕུལ་བར་མ་བྱས་ཚེ།",
    "སྨྲས་པས་བྱིན་པ་ཁྱེར་ཡོང་གཙང་སར་སྦས།",
    "ཕྱག་བསྐོར་མང་བྱས་ནང་དུ་ཐར་བའི་ཚེ།",
    "སྔར་དང་མི་འདྲ་ཅི་ལགས་ཞུས་པའི་ལན།",
    "འདི་ནི་ཐུབ་པའི་ཡིན་གསུངས་། དེ་ཕྱིར་ཡབ་སྲས་ལ་སོགས་མཁས་གྲུབ་རྣམས།",
    "སྡོམ་པ་ཐུབ་དང་མི་ཐུབ་མི་དཔྱད་པར་། ཀུན་ལ་བསྙེན་རྫོགས་གནང་བ་དེ་ཡི་དོན།",
    "ཉམས་ལས་མ་ཐོབ་ཉེས་པ་ཆེ་ཞེས་གསུངས།",
    "དེ་སྐད་བཅོམ་ལྡན་ཐུབ་པ་ཉིད་ཀྱིས་གསུངས་། མ་འོངས་ཐུབ་པའི་བསྟན་པ་འཇིག་པའི་ཚེ།",
    "སེར་གོས་གྱོན་ཚད་རྣམས་ལ་གུས་དགོས་གསུངས།",
    "ཕྱགས་དར་བྱས་པའི་ཉལ་ཉིལ་གསེབ་དག་ནས།",
    "རྒྱུན་དུ་ནམ་འབྱོན་ཚོགས་པར་ཕྱག་འབུལ་མཛད།",
    "དེ་དག་དོན་ལ་ལེགས་པར་དཔྱད་བྱས་ན།",
    "རབ་ཏུ་བྱུང་བས་ཆོག་པར་བརྩི་བ་ཡི།",
    "ལྟ་བ་རྣམ་པར་དག་པ་ཡོད་ན་ཡང་།"
  ]
}