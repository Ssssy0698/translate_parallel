    "དེའི་ནང་ན་འདུག་པའི་སྲིན་བུ་རྣམས་དང་།",
    "མུན་པ་མེད་པ་ན་འདུག་པ་དང་།",
    "དེ་དག་ལ་ནག་པོ་ལྟ་བུ་མཐོང་ཞིང་མེ་རབ་ཏུ་འབར་བ་དེའི་སྟེང་ན་འདུག་པ་མཐོང་བ་དང་ཝ་བརྒྱལ་བའི་སྒྲ་དྲག་པོ་ཐོས་པ་དང་།",
    "ལོག་པར་ལྟ་བའང་ཀུན་ཏུ་བསྟེན་ཅིང་བསྒོམས་ཏེ་མང་དུ་བྱས་པས་འགྱུར་བ་ནི་འདི་ལྟར་ཙོག་ཙོག་པོར་བསྒྱིངས་པར་འདུག་ལ་སྐོམ་འཐུང་ཞིང་ལག་པ་ལ་ལྡག་ན་མྱ་ངན་ལས་འདས་པ་འཐོབ་སྟེ།",
    "རུས་པ་ལ་སྲིན་བུ་མང་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་མི་སྡུག་པ་དང་། མཐོང་ངོ།",
    "གཟུགས་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་ཅིང་ཐགས་ཐོགས་མེད་པར་འགྲོ་བ་གཞན་ཡོད་པས་ཐམས་ཅད་ཀྱི་ནང་ན་བཅིང་བ་དམ་པོས་བདག་ཉིད་བཅིངས་པར་མཐོང་སྟེ།",
    "འཇིགས་འཇིགས་ལྟར་འདུག་ཅིང་རབ་ཏུ་འབར་བ་མང་པོ་དག་མཐོང་ངོ།",
    "རྒྱ་མཚོར་གཏོགས་པར་དེ་འདུག་གོ།",
    "ལུས་ཆེན་པོ་ཤིན་ཏུ་སྒྲ་འབྱིན་པ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་གང་དུ་དེའི་ལུས་དཔག་ཚད་བཅུ་ཡོད་ཅིང་ཤིན་ཏུ་གཞོན་པ་འཚེད་དོ།",
    "མེ་མདག་བྱེ་མ་ལྟ་བུའི་ཆར་རྟག་ཏུ་འབབ་པའི་སྒོ་གང་དུ་ཆར་རབ་ཏུ་འབབ་པ་ལྟར་བྱེ་མའི་ཆར་རབ་ཏུ་འབར་བ་འབབ་པའི་ནང་ན་འདུག་པ་འཚེད་དོ།",
    "བྱད་བཞིན་འཇིགས་འཇིགས་ལྟར་འདུག་པ་ཞིག་དང་།",
    "ནགས་ཚལ་བདེ་བ་དག་ལ་འཇིགས་འཇིགས་ལྟར་འདུག་པར་མཐོང་བར་འགྱུར།",
    "སྦྲུལ་ཤིན་ཏུ་ཁྲོས་པ་དག་མདུན་དུ་འདུག་པ་དང་།",
    "བུ་གའི་ནང་ན་སྦྲུལ་འདུག་བཞིན།",
    "དེའི་འཁོར་ཇི་ལྟར་འདུག་སྙམ་ནས་རྟོག་པར་བྱེད་དེ།",
    "གཞན་གྱི་ཆུང་མ་དང་ལྷན་ཅིག་ཏུ་འདུག་པར་འགྱུར།",
    "དེའི་དབུས་ན་འདུག་པ་མི་རི་ལྟ་བུར་ཀུན་ནས་རྣམ་པ་ཐམས་ཅད་རབ་ཏུ་འབར།",
    "ཁོང་གསོག་ཏུ་འདུག་པ།",
    "ཕྲོགས་ནས་ཀྱང་རང་ཉིད་ཟའོ།",
    "དེ་ནས་ཡང་དགེ་སློང་ལས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་ཤེས་པ་དེས་ཡི་དྭགས་རྣམས་ལ་བརྟགས་ནས་དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཁ་ཁབ་ལྟར་ཕྲ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་སྐྱུགས་པ་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་དྲི་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་འཇིག་རྟེན་ན་ཡི་དྭགས་ཆུ་འཐུང་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "གལ་ཏེ་མ་བྱིན་པར་འདོད་ནས་དེ་ཆུ་འགྲམ་དུ་འདུག་སྟེ་བཏུང་བ་འཐུང་བ་དང་།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་འཇིག་རྟེན་ན་ཡི་དྭགས་མཆིལ་མ་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བཀྲེས་སྐོམ་ཆུང་ཞིང་ལུས་གོས་མེད་པ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་འཇིག་རྟེན་ན་ཡི་དྭགས་ཤ་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་བདུག་པ་ཟ་བ་ཞེས་བྱ་བ་དེ་ཐོབ་པས་དེས་སྲོག་འཚོ་བ་འཐོབ་པ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་དྲག་ཤུལ་སྤྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་འཇིག་རྟེན་ན་ཡི་དྭགས་རྫུ་འཕྲུལ་ཆེ་བ་ཞེས་བྱ་བ་རང་བཞིན་གྱིས་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སྐོམ་པ་གདུངས་པ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཡི་དྭགས་མི་རྣམས་ཀྱི་བུས་པ་ལ་གླགས་ལྟ་བ་ཞེས་བྱ་བ་བུས་པ་གང་བཙས་མ་ཐག་ཏུ་འཕྲོག་པར་བྱེད་པ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་འཇིག་རྟེན་ན་ཡི་དྭགས་འདོད་པའི་གཟུགས་ཅན་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་འཇིག་རྟེན་ན་ཡི་དྭགས་གཤིན་རྗེའི་ཆད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེའི་ཉེས་པར་བྱས་པའི་ལས་ཀྱིས་གཤིན་རྗེའི་མི་ཉེ་བར་འདུག་སྟེ་ཤིན་ཏུ་དངངས་པར་བྱེད་ཅིང་ཆ་བྱད་བསྒྱུར་བ་འཆང་བ་ལུས་བསྒྱུར་བ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་ཡུལ་ནི་ཡི་དྭགས་བྱིས་པ་ལ་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་ཡུལ་ན་ཡི་དྭགས་མདངས་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་ཡུལ་ན་ཡི་དྭགས་ཚངས་པའི་སྲིན་པོ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
