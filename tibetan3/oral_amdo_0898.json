    "གཉིས་པ་མཆོད་བསྟོད་གསོལ་བ་བཏབ་པ་ལ་ལྷ་མོ་བརྒྱད་ཀྱིས་མཆོད།",
    "རྣམ་སྣང་གི་སྐབས་སུ་ས་བོན་བྷྲཱུཾ།",
    "ཆུ་ལྷག་མ་ཡར་ལུད་པ་ལས་རང་རང་གི་རིགས་ཀྱི་བདག་པོས་དབུ་བརྒྱན།",
    "དངོས་པོ་ཀུན་གང་དང་གང་དུ་སྣང་བ་དེ་ཐམས་ཅད་རང་གི་ལྷག་པའི་ལྷ་རིགས་ལྔ་ཡུམ་ལྔ་ཡེ་ཤེས་ལྔའི་རང་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཧཱུྃ་ལས་བྱུང་བའི་རྡོ་རྗེ་ལག་པ་གཡས་སུ་ཐུགས་ཀྱི་དམ་ཚིག་ཏུ་བྱིན་པར་མོས་ལ་ཚིགས་དང་སྔགས་བརྗོད་པས་སེམས་ཉིད་རྡོ་རྗེ་འཆང་ཆེན་པོའི་ཐུགས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་སུ་བྱིན་གྱིས་རླབས་པར་མོས་ལ།",
    "ཐོག་མཐའ་མེད་པའི་སོགས་བརྗོད་པས་སེམས་དེ་ཉིད་ཀྱང་ཡེ་ཤེས་ལྔར་བསྒོམ་ལ་ཨ་ལས་བྱུང་བའི་དྲིལ་བུ་ལྷ་གཉིས་ཤུ་རྩ་གསུམ་དང་ལྡན་པ་ལག་པ་གཡོན་དུ་བྱིན་པས་ངག་གྲག་སྟོང་དབྱེར་མེད་དུ་བྱིན་གྱིས་རླབས་པར་མོས་ལ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གི་བཞུགས་པ།",
    "དབུ་སྐྲ་རལ་པའི་ཐོར་ཅོག་ཅན་རུས་པའི་རྒྱན་དྲུག་གི་བརྒྱན་པའི་སྐྱེ་མཆེད་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་རླབས།",
    "གོང་གི་རྡོ་རྗེ་ཐུགས་ཀྱི་དམ་ཚིག་དང་དྲིལ་བུ་གསུང་གི་དམ་ཚིག་ཀྱང་གསལ་བཏབ་སྟེ།",
    "རྡོ་རྗེའི་ལམ་ནས་ཡུམ་གྱི་མཁར་བབས་པའི་ཐིག་ལེ་དུང་དང་ཀུནྡ་ལྟར་དཀར་བ་གདན་གསུམ་ཚང་བ་དེ་ཕྱི་ནང་གི་ལྷ་ཐམས་ཅད་ལ་བྱིན་པར་བསམ་ཏེ།",
    "ཇི་ལྟར་འདས་པའི་སོགས་བརྗོད་པས་གསལ་སྟོང་གི་ཏིང་ངེ་འཛིན་གྱི་ངང་ལ་བཞག་དེ་ལྟར་སོགས་རྟོགས་པ་བརྗོད།",
    "གདོང་བཅིངས་སློབ་དཔོན་གྱི་ཕྱག་རྒྱ་མཚན་ཉིད་དང་ལྡན་པ་གནང་བར་མོས་ཏེ།",
    "ཕྱག་རྒྱ་བསྟེན་པར་སྤྲོའམ་ཞེས་མོས་ཏེ།",
    "སྤྲོའོ་ཞེས་ལན་བཏབ་པའི་མོས་པ་བྱས་ཏེ།",
    "ཕྱི་ནང་གི་ལྷ་ཐམས་ཅད་ཀྱི་སྤྱི་བོ་ནས་ཐིམ་པས་སྐུ་ལུས་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་ཆུ་རྒྱུན་གྱིས་གང་ཆུ་ལྷག་མ་ཡར་ལུད་པ་ལས།",
    "རིགས་བདག་གི་རྒྱས་བཏབ་ཏེ།",
    "གོ་རཱི་གཟུགས་དང་གཟུགས་ཕུང་རྣམ་པར་དག་པ་རྣམ་སྣང་གི་ངོ་བོ་ལ་སེམས་ཀྱི་ངོ་བོ་མི་བསྐྱོད་པས་རྒྱས་བཏབ་པའོ།",
    "བསྲུང་འཁོར་གཞལ་ཡས་ཁང་སོགས་ཕྱི་རོལ་དུ་སྣང་བ་ཐམས་ཅད་རང་གི་སེམས་ཉིད་དེ་དག་ཏུ་ཤར་བ་མཚོན་བྱེད་དུ་སེམས་ལ་ལུས་ཀྱི་རྒྱ་སྟེ།",
    "སྒྲ་དང་ཚོར་བ་རྣམ་པར་དག་པ་ཙོ་རཱི་དང་ཆུ་རྣམ་པར་དག་པ་ཤཱ་བ་རི་མི་བསྐྱོད་པའི་ངོ་བོ་ལ་ལུས་ཀྱི་ངོ་བོ་རྣམ་སྣང་གི་རྒྱས་བཏབ་བོ།",
    "བེཏྟ་ལཱི་དྲི་དང་འདུ་ཤེས་རྣམ་པར་དག་ཙཎྜ་ལཱི་མེ་རྣམ་པར་དག་པ་འོད་དཔག་མེད་ཀྱི་ངོ་བོ་རྒྱུ་འདོད་ཆགས་རྣམ་དག་ལ་འབྲས་བུ་རྣམ་དག་རིན་འབྱུང་གི་རྒྱས་བཏབ་བོ།",
    "དབུ་རྒྱན་རྣམས་ཀྱི་སྤྱི་བོར་རང་རང་གི་རིགས་ཀྱི་ཕྱག་མཚན་བསྒོམ་དགོས་ཏེ།",
    "དེས་ན་དབུ་རྒྱན་རྣམས་ནི་རང་རང་གི་རིགས་དང་མཐུན་པའི་དབུ་རྒྱན་ཡིན་ཞིང་།",
    "དེ་དག་གི་སྤྱི་བོར་ཡང་རང་གི་རིགས་ཀྱི་མཚན་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་སྦྱང་གཞི་ནི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ཆུ་ཁམས་ཁ་དོག་སྔོན་པོ་ཞེ་སྡང་།",
    "ཨ་མྲྀ་ཏས་བསངས།",
    "དེའི་སྟེང་དུ་ཧཱུྃ་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ་ཧཱུྃ་གིས་མཚན་པའི་ཧཱུྃ་ལས་འོད་འཕྲོས།",
    "ཞེས་གསུངས་པའི་དོན་ནི་གོང་གི་མཆོད་བྱེད་ལྷ་མོ་བརྒྱད་པོ་དེས་ཁྱོད་ནི་རྣལ་འབྱོར་མ་སོགས་ཀྱི་བསྟོད་པའི་ཚིག་གི་དོན་ནི།",
    "དཀྱིལ་འཁོར་གཙོ་བོ་ཁྱོད་བདག་མེད་མ་སོགས་ལྷན་ཅིག་སྤྱོད་པ་དང་གོ་རཱི་སོགས་རྗེས་སུ་འབྲང་བའི་ཚོགས་ཀྱི་ཡོངས་སུ་བསྐོར་ནས་རྒྱ་ཆེ་བ་གྱ་ནོམ་པ།",
    "སྐུའི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་རྟེན་བྱེད་པ་བཞིན་གཞལ་ཡས་ཁང་གི་ལྷ་ཐམས་ཅད་ཀྱི་རྟེན་བྱེད་དོ།",
    "ཐལ་བ་དང་མཆོད་ཕྱིར་ཐོགས་ཏེ་དྲུག་གོ།",
    "གཞན་ཡང་རང་གི་ཤར་སྣང་བ་རྣམ་པར་དག་པ་ནི།",
    "དེ་གསུམ་པོ་འདྲེས་ཏེ་གཡུང་མོའི་རྐང་ནི།",
    "ཁྲག་གི་རྩ་སྦུབས་འགེངས།",
    "ལྤགས་པས་དེ་དག་གཡོགས་རུས་པས་དེ་དག་གི་རྟེན་བྱེད་པ་ཕྱོགས་གཅིག་ཏུ་གསུངས་སོ།",
    "ལྷ་མོ་བཞིས་རྣམ་པ་ཅན་གྱི་དྲན་པ་ཉེ་བར་བཞག་པ་བཞི།",
    "ནང་མཆོད་གཏོར་ཏེ་ཨ་མྲྀ་ཏས་བསངས།",
    "རང་གི་ལག་པ་གཡས་པའི་སོར་མོ་ལྔ་རྡོ་རྗེ་རྩེ་ལྔ་པ་ལག་མཐིལ་དུ་ཉི་མའི་དཀྱིལ་འཁོར་ལ།",
    "ལག་པ་གཡོན་པའི་སོར་མོ་ལྔ་པདྨ་འདབ་མ་ལྔ་པ་ལག་མཐིལ་དུ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་ཨ་ཨཱ་སོགས་དབྱངས་ཡིག་གི་གཡོན་དུ་བསྐོར་བའི་ལྟེ་བ་ལ་ཨཱ།",
    "ཨོཾ་པ་དེ་པ་དེ་མ་ཧཱ་ཛྙཱ་ན་སརྦ་བུདྡྷ་མ་ཡཾ་བྷ་ཝེ་ཏ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཧོ་ཧོ་ཧོ་ཨ་ཁཾ་སྭཱ་ཧཱ།",
    "རྗེ་བཙུན་རྩེ་མོས་གསུངས་པ་བཞིན་བདེ་བས།",
    "དེང་སང་གི་ཉམས་ལེན་འདི་ལ་མཛད།",
