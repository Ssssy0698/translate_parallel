    "ཐུན་ཕྱེད་རེ་ལ་དབུགས་བརྒྱ་རེ་བསགས་པས་ཞག་གཅིག་ལ་སྟོང་དྲུག་བརྒྱའོ།",
    "ནང་གི་ལྟེ་བར་རྩ་འཁོར་ལྔ་ཡོད་པའི་བར་གྱི་གཅིག་ལ་གཡས་ཀྱི་རྩ་འདབ་དྲུག་གཡོན་གྱི་རྩ་འདབ་དྲུག་ལ་འཕོ་ཆེན་རེ་རེ།",
    "དེ་རེ་རེ་ལ་འཕོ་ཆེན་ཕྱེད་པ་རེ་རེ་སྟེ།",
    "ལམ་དུས་སུ་ཡས་བབས་མས་བརྟན་གྱི་དགའ་བ་བཅུ་དྲུག་གི་རྟེན་ཅན་དཀར་ཆ་བཅུ་དྲུག།",
    "ཕྱག་མཚན་ཐུགས་ཀྱི་མཚོན་པའི་བདེ་སྟོང་གི་ཡེ་ཤེས་མཐར་ཐུག་པས།",
    "བདེ་སྟོང་གི་ཡེ་ཤེས་བསྐྱེད་པ་ལ།",
    "དེ་ལ་ནང་གི་རྐྱེན་རྡོ་རྗེ་བཟླས་པ།",
    "ཤོག་༣ བ་༤ བདེ་སྟོང་གི་ཡེ་ཤེས་རྗེའི་གསུང་འབུམ་ན་པ།",
    "གཞུང་གི་དོན་དང་།",
    "གང་གིས་བསྒྱུར་བའི་ཚུལ་ལོ།",
    "གང་ལ་ན་ཉོན་མོངས་པ་ལ་སོགས་པའི་རྩུབ་རེག་རྗེའི་གསུང་འབུམ་ན་པ།",
    "གང་གིས་ན།",
    "དགོས་པ་གང་གི་ཕྱིར་ན།",
    "ཤེས་བྱ་ཇི་ལྟ་བ་དང་ཇི་སྙེད་པ་ལ་སྒྲིབ་པས་ན་མི་ཤེས་པ་དེའང་ཉོན་མོངས་ཅན་དང་ཉོན་མོངས་ཅན་མ་ཡིན་པ་ཀུན་སྤངས་པས་ན་དྲི་མ་མེད་པའི་གཟི་བརྗིད་དང་ལྡན་པའོ།",
    "སློབ་དཔོན་དཔལ་འབྲས་རྡོ་རྗེ་དྲུག་པ་རྡོ་རྗེ་འཆང་གི་ཡེ་ཤེས་ལྔ་དག་པ་ནི་རིགས་ལྔ།",
    "ཤེས་རབ་ནི་རང་གི་ཡུམ་མཱ་མ་ཀཱིའི་རིགས་དེ་དེའི་ཡན་ལག་ཐབས་དང་བཅས་པ་འདུས་ཤིང་སྙོམས་པར་འཇུག་པས་འབར་ཞིང་རབ་ཏུ་མཛེས་པའོ།",
    "དེ་ལ་ཡོན་ཏན་དང་པོས་ནི་ཚངས་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "མཆོད་བརྗོད་ཀྱི་གཞུང་གིས་དགོས་འབྲེལ་བསྟན་པར་བཞེད་དོ།",
    "རང་གི་སློབ་དཔོན་སྲུང་བའི་ཞབས་དང་།",
    "ཁྱོད་ཀྱི་རྩོམ་པ་དགོས་པ་མེད་པ་ཡིན་ཏེ།",
    "དལ་འབྱོར་ཞེས་ཏེ་དེ་དག་གི་རྗེས་སུ་འབྲངས་ནས་ཀྱང་ཚེགས་ཆེན་པོ་དང་དུས་ཡུན་རིང་པོས་རྟོགས་ནུས་མོད་ཀྱང་།",
    "རྟེན་གང་གིས་སྒྲུབ་པ་དང་།",
    "བློ་གྲོས་དང་ལྡན་པའི་གང་ཟག་དེས་རང་སྔགས་ཏེ་རང་གི་ལྷག་པའི་ལྷ་མཉེས་ཤིང་བསྒྲུབ་པར་བྱའོ།",
    "ཆོ་ག་བཞིན་དུ་རྗེས་གནང་ཐོབ་པས་ཏེ་རང་གི་མེ་ཏོག་གི་ལྷ་ལ་བརྟེན་ནས་དངོས་གྲུབ་བསྒྲུབ་པའི་ཚུལ་ཞོལ།",
    "ཤོག་༤ ན་༦ མནྲལ་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "ཙནྡན་དང་ཤྲི་ཁནྡ་ལ་སོགས་པའི་དྲི་བཟང་པོས་བྱུགས་ཤིང་དྲི་ཞིམ་པོའི་མེ་ཏོག་གཅལ་དུ་བཀྲམ་པའི་ཆ་ནི་ཕྱོགས་ཡིན་པས་གནས་ཁང་གི་ཕྱོགས་ཀྱི་མཆོག་བསམ་གཏན་གྱི་གནས་སུ་བདེ་བའི་སྟན་ལ་གནས་པར་བྱའོ།",
    "ཐོག་མ་མེད་པའི་སྲིད་པའི་ཆུ་ཀླུང་དུ་བདག་དང་བདག་གི་བར་འཛིན་པ་དང་།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་རྟོག་མ་ལུས་པའི་ཀུན་རྟོག་གིས་བསགས་པའི་འདོད་ཆགས་ལ་སོགས་པའི་རྙོག་པ་ཐམས་ཅད་བཤགས་པར་བགྱིའོ།",
    "ཤཔྟས་རོལ་མོ་འབུལ།",
    "རྟོག་པ་ཞེས་ཏེ་བདག་དང་བདག་གི་བ་དང་།",
    "སློབ་དཔོན་ཤཱནྟི་པ་ནི་སྟོང་པ་ཉིད་ལ་དམིགས་ཏེ་བསྒོམས་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "མཆོག་གི་སེམས་ནི་བསྐྱེད་པར་བགྱིའོ།",
    "ཤོག་༩ བ་༡ དགོས་པ་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "སྒྲ་སོར་གཞག་གི་དོན་ལ་ཤེས་པ་ལས་མི་འབྱུང་ཡང་ཡེ་ནི་སྒྲ་པ་རྣམས་ཀྱིས་བསྣན་པའོ།",
    "བཛྲ་ནི་མི་ཕྱེད་པས་རྡོ་རྗེ་སྟེ་རྣལ་འབྱོར་པའི་བློ་སྟོང་པ་ཉིད་ལ་ཆུ་ལ་ཆུ་བཞག་པ་ལྟར་སོང་བས་མི་ཕྱེད་པ་དང་།",
    "དེ་འོག་ཧཱུཾ་གིས་རྡོ་རྗེར་བྱས་ཞེས་པ་སྟེ་ཡེ་ཤེས་ཀྱི་ཚོགས་བསག་པ་དེའི་འོག་ནས་དཔལ་འབྲས་རྡོ་རྗེས་ཉི་མ་ལ་གནས་པའི་ཧཱུཾ་ལས་རྡོ་རྗེ་ནག་པོ་ལྟེ་བར་ཉི་མ་ལ་གནས་པའི་ཧཱུཾ་གིས་མཚན་པ་དེ་ལས་འོད་ཟེར་འོག་ཏུ་འཕྲོས་པས།",
    "དང་པོའི་རྡོ་རྗེ་ནི་དྲག་པོའི་རྡོ་རྗེ་རྩེ་མོ་གྱེས་པ་རྩེ་དགུ་པའམ་ལྔ་པའོ།",
    "གཤིན་རྗེ་མཐར་བྱེད་ལ་སོགས་པ་བརྒྱད་ནི་རྩིབས་བརྒྱད་ཀྱི་རྩེ་མོ་ཅུང་ཟད་མ་རེག་པར་བསྒོམ་ཞིང་།",
    "རྒྱུ་ནི་ཀུན་ཏུ་ཞེས་ཏེ་ཧཱུཾ་ལས་བྱུང་བའི་རྡོ་རྗེ་ཧཱུཾ་གིས་མཚན་པ་ལས།",
    "རྡུལ་ཁུག་རྣ་ལ་སོགས་དང་བྲལ་བའི་སྟོན་ཀའི་ཟླ་བ་ལྟ་བུར་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "དབྱིབས་གྲུ་གསུམ་པ་རྩེ་མོ་ཕྲ་བ་ཐུར་དུ་བསྟན་ཅིང་།",
    "སྟེང་དུ་འཕེལ་ཁ་ཆེ་བ་ནི་མོས་སྤྱོད་ནས་བརྩམས་ཏེ་ཡོན་ཏན་གོང་ནས་གོང་དུ་འཕེལ་བ་དང་།",
    "ཕྱི་ནང་གི་སྒོ་ཁྱུད་ཀྱི་མཚམས་སུ་ཟླ་ཕྱེད་རྡོ་རྗེས་སྤྲས་པ།",
    "གང་དུ་ན་གཞལ་ཡས་ཁང་གི་དབུས་ཉིད་དུའོ།",
    "རྒྱུ་གང་ལས་ན་དབྱངས་ཡིག་བཅུ་དྲུག་གི་ཆ་དང་།",
    "བསྣོན་ས་ནི་རང་གི་ཡི་གེ་རིགས་མཐུན་ཡོད་པ་དེའི་མཚམས་སུའོ།",
    "ཨོཾ་བོ་དྷི་ཙིཏྟ་ཨུ་པཱ་ཏ་ཡཱ་མི་ཞེས་པས་ཐབས་ཀྱི་ངོ་བོར་བསམ་མོ།",
    "སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "བ་སྤུའི་སྒོ་ནས་རང་གི་ལུས་ཀྱི་ནང་དུ་གཞུག་པར་བྱའོ།",
    "དེ་ནས་སྤྱན་མ་ལ་སོགས་པའི་ཡུམ་བཞིའང་གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པའི་རྡོ་རྗེ་མ་ལྔའི་རང་བཞིན་དུ་རང་གི་ལུས་ལས་ཕྱུང་ནས་རང་གི་རིག་མའི་ལུས་ཀྱི་ནང་དུ་ཆུད་པར་བསམ་པར་བྱའོ།",
    "རང་གི་སྤྱི་བོའམ་ཞལ་ནས་ཞུགས་ཏེ་ཡུམ་གྱི་པདྨའི་ལྟེ་བའི་ནང་དུ་དཀྱིལ་འཁོར་དྲི་མ་མེད་པའི་དེ་བཞིན་གཤེགས་པ་ཞུ་བའི་བྱང་ཞོལ།",
    "དེ་ནས་དྲུག་དྲི་མ་དྲུག་གི་ས་བོན་དང་།",
    "དེ་རྣམས་གྱུར་པ་ལས་རང་རང་གི་ས་བོན་ཕྱག་མཚན་དུ་གྱུར་པའམ།",
    "རང་རང་གི་དེ་བཞིན་གཤེགས་པའི་གནས་རྣམས་སུ་བྱོན་པར་བསམ་ཞིང་།",
    "སྔར་གྱི་རྟེན་བརྟེན་པའི་དཀྱིལ་འཁོར་ནི་དེ་ཉིད་དུ་མི་དམིགས་པར་སྟོང་པར་བསམ་མོ།",
    "སྐྱེ་མཆེད་དྲུག་གི་ལྷ་དག་དེས་རྫོགས་ཞེས་པའི་དོན་ནོ།",
    "ཡབ་ཀྱི་ཞལ་ནས་ཞུགས་ནས་ཡི་གེའི་རྣམ་པར་རིམ་གྱིས་བརྒྱུད་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "ཡུམ་གྱི་པདྨའི་ནང་དུ་ཞུགས་པས་གཞན་དང་མཉམ་པ་མེད་པའི་ཤེས་རབ་ཀྱི་རང་བཞིན་ཡུམ་གྱི་ཆགས་པས་འཇུ་བའི་རྐྱེན་བྱས་ནས་ཞུ་བར་བྱས་པར་བསམ་མོ།",
    "ཆགས་པས་ཞུ་བདེའི་འོད་ཟེར་གྱི་མཐུས་ཡབ་ཡུམ་གཉིས་ཀའང་ཞུ་བར་བྱས་པར་བསམ་མོ།",
    "སྤྱན་མ་དང་གོས་དཀར་མོ་དང་སྒྲོལ་མ་རྣམས་རིམ་པ་བཞིན་དུ་ལྷོ་ལ་སོགས་པར་གནས་ནས་སོ།",
    "གོས་དཀར་མོས་གླུས་བསྐུུལ་བ་ནི།",
    "ཁྱོད་ནི་ཞེས་ཏེ།",
    "སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་དུ་གྱུར་པས་རྡོ་རྗེའི་གསུང་ཁྱོད་ཅེས་པའོ།",
    "ཁྱོད་ནི་ཞེས་ཏེ་འདོད་པའི་ཡོན་ཏན་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོར་གྱུར་པས་རྡོ་རྗེ་འདོད་པ་ཞེས་བོས་ནས་དམ་ཚིག་ནི་དོན་ཡོད་གྲུབ་པའོ།",
    "དེའི་འོད་ཟེར་གྱིས་རང་གནས་ཏེ་འཇམ་པའི་དབྱངས་ཀྱི་སྤྲུལ་པ་དཔག་ཏུ་མེད་པ་སྤྱན་དྲངས་ནས་བཅུག་པས་དཔལ་ལྡན་འཇམ་པའི་རྡོ་རྗེ་ཞེས་བྱ་བར་གྱུར་པར་བསམ་མོ།",
    "གདུ་བུ་དང་དཔུང་རྒྱན་ལ་སོགས་པ་སྣ་ཚོགས་པའི་རྒྱན་གྱིས་རྣམ་པར་བརྒྱན་པ་རྩ་ཕྱག་གཉིས་ཤེས་རབ་དམ་པ་རང་གི་རིག་མ་ལ་འཁྱུད་པ་དང་།",
    "རྐང་པ་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "དེ་སྤངས་ནས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་དེ་ཉིད་གཟུགས་ཀྱི་སྐུུའི་རྣམ་པར་ཤར་བར་མོས་པ་བྱའོ།",
    "དེས་རང་གི་མིག་སོགས་བྱིན་གྱིས་བརླབས་ལ།",
    "མིག་གཉིས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེ་ལ་ཀྵིཾ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "རྣ་བ་གཉིས་སུ་ཟླ་བ་ལ་གནས་པའི་ཛྲིཾ་ལས་རྡོ་རྗེ་ཛྲིཾ་གིས་མཚན་པ་ལས་འོད་སྤྲོ་བསྡུ་བྱས་པས།",
    "ཚུར་འདུས་རྡོ་རྗེ་ཕྲ་མོ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "གསུང་བྱིན་གྱིས་བརླབ་པ་ལ་རང་གི་མགྲིན་པར་བསྐྱེད་པ་ལ་གསོལ་བ་གདབ་པ་ནི།",
    "སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "གང་གིས་ན་རང་གི་མགྲིན་པར་བསྒོམས་པའི་གསུང་རྡོ་རྗེ་ཁྱེད་ཀྱིས་ཞེས་པའི་དོན་ནོ།",
    "དེ་དག་གི་དོན་ཡང་ཡབ་རྐྱང་བསྐྱེད་པ་ནི།",
    "དེ་བཞིན་གཤེགས་པ་རང་གི་ལུས་ལ་ཞུགས་པ་དང་གསང་གནས་སུ་ལྷ་ཉེར་གཅིག་བསྐྱེད་པ་མ་གཏོགས་རྫོགས་པར་སྦྱོར་ཞིང་།",
    "སྔར་མ་བསྐྱེད་ན་ཡབ་ཀྱི་རྩ་ཕྱག་གཉིས་ཡུམ་ལ་འཁྱུད་པ་འགལ་ཟེར་ན་སློབ་དཔོན་ཐ་ག་ན་ལྟར་ན་སྔར་བར་སྲིད་རང་གི་ཞལ་ནས་ཞུགས་པ་ཞུ་བ་ལས་བྱུང་བའི་ཐིག་ལེ་ཆ་གཉིས་སུ་གྱུར།",
    "ཤོག་༡༩ བ་༤ འགྲུབ་པ་དང་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "ཕྱི་མ་བཞི་ལ་ཉི་མའི་གདན་བསམ་མོ།",
    "རིམ་པ་བཞིན་དུ་ནུ་མ་ཡན་ཆད་རྣམ་སྣང་གི་རང་བཞིན་དུ་བྱིན་གྱིས་བརླབ་པ་དང་།",
    "དེ་ནས་པདྨ་ཡན་རིན་འབྱུང་གི་རྡུལ་ཕྲ་རབ་ཀྱི་རང་བཞིན་དང་།",
    "དེ་ནས་རྐང་མཐིལ་ཡན་དོན་ཡོད་གྲུབ་པའི་རང་བཞིན་དུ་ཁྱབ་པར་བསམ་མོ།",
    "ཨ་ལས་ཡུམ་གྱི་གསང་གནས་གྱི་ལྟེ་བ་དང་ཧཱུཾ་ལས་གསང་གནས་ཀྱི་པདྨ་འདབ་མ་བསྐྱེད་ལ་བུ་ག་ཕཊ་སེར་པོས་བཀག་པར་བསམ་མོ།",
    "དེ་ཉིད་བསྡུས་པ་ནས་གསུངས་པ་ནི་སྲིད་པ་ཐ་མལ་བ་མངོན་བྱང་ལྔའི་སྒོ་ནས་རྣམ་སྣང་གི་གོ་འཕང་ལྟ་བུ་སྒྲུབ་ཚུལ་སྟོན་པ་ཡིན་གྱི།",
    "གནས་སྲུང་འཁོར་ཐུན་མོང་བ་ནས་གཞལ་ཡས་ཁང་གི་བར་དང་།",
    "སཾ་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "དེ་ནས་ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཧཱུཾ་གིས་མཚན་པ་ནས་སྤྲོ་བསྡུ་ཚུན་ཆད་མངལ་གྱི་གནས་སྐབས་དང་མཐུན་ནོ།",
    "མར་རྩེ་ལྔ་རྐང་ལག་གི་སོར་མོ་ལྔ་ཚན་དུ་མཐུན་པ་དང་།",
    "ཡབ་ཀྱི་ཞལ་ལྟ་བུ་ནས་ཞུགས་ནས་རྡོ་རྗེའི་ལམ་ནི་ཡུམ་གྱི་པདྨར་སོང་སྟེ།",
    "ཡབ་ཡུམ་གཉིས་ཀྱང་ཞུ་བར་བསམ་མོ།",
    "༡༣སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "ཕྲ་མོ་རྫོགས་པ་ཡོད་ཀྱང་འདིར་ནི་ལྷའི་རྣམ་པ་ཅན་དུ་གྲུབ་ནས་མངལ་ནས་བཙས་པའི་སྐབས་དང་སྦྱོར་བ་ཡིན་ནོ།",
    "དེ་ལས་རང་རང་གི་ས་བོན་དང་བཅས་པ་ལས་ཞོལ།",
    "དེ་ནས་གཞལ་ཡས་ཁང་གི་དབུས་ནས་རིམ་པ་བཞིན་དུ་གསལ་གདབ་པ་ནི།",
    "ཧཱུཾ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ་ལྟེ་བ་ཧཱུཾ་གིས་མཚན་པ་ལས་མི་བསྐྱོད་པ་སྔོན་པོ་སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་རང་འདྲའི་ཡུམ་ལ་འཁྱུད་ཅིང་།",
    "གཞལ་ཡས་ཁང་ནང་མའི་ཤར་གྱི་ཟླ་བའི་གདན་ལ་ཨོཾ་ལས་འཁོར་ལོ་ཨོཾ་གྱིས་མཚན་པ་ལས་རྣམ་པར་སྣང་མཛད་དཀར་པོ་དཀར་སྔོ་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་རང་འདྲའི་ཡུམ་ལ་འཁྱུད་པ།",
    "དེ་ལྷ་བཅུ་དགུ་པོ་ཐམས་ཅད་སྔ་རིམ་གྱིས་གསལ་བཏབ་ནས་དེས་འབྱིན་སྔགས་ཀྱིས་ཕྱིར་འབྱིན་པ་ནི་བཛྲ་དྷྲིཀ་གིས་མི་བསྐྱོད་པ་ཕྱིར་ཕྱུང་།",
    "ཛི་ན་ཛིཀ་གིས་རྣམ་སྣང་ཕྱུང་སྟེ།",
    "ཕྱོགས་བཅུར་འཕྲོས་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "རཏྣ་དྷྲྀཀ་གིས་རིན་འབྱུང་ཕྱུང་།",
    "ཨཱ་རོ་ལིཀ་གིས་འོད་དཔག་མེད་ཕྱུང་།",
    "པྲཛྙཱ་དྷྲྀཀ་གིས་དོན་གྲུབ་ཕྱུང་།",
    "ལྷ་མོ་བཅུ་པོ་ཐམས་ཅད་རང་འདྲའི་ཐབས་ལ་འཁྱུད་པའོ།",
    "རྡོ་རྗེ་མ་དྲུག་གི་འབྱིན་སྔགས་ནི།",
    "གཞལ་ཡས་ཁང་གི་ཕྱིའི་མེ་མཚམས་སུ་འཁོད།",
    "རེག་དང་རྣམ་གཡེང་སྦྱངས།",
    "དེ་དག་གི་ཐབས་ནི་རིམ་པ་བཞིན་དུ།",
    "གཅིག་ཏུ་འདུས་པ་ཤར་སྒོར་སྣ་ཚོགས་པདྨ་དང་ཉི་མའི་གདན་ལ་གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་འཁོད།",
    "ལེ་ལོ་དང་ཉོན་མོངས་པའི་བདུད་སྦྱངས།",
    "བརྗེད་ངེས་དང་འཆི་བདག་གི་བདུད་སྦྱངས།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་ཅན།",
    "རྩ་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "ཡེ་ཤེས་ཀྱི་གཞལ་ཡས་ཁང་དང་གཅིག་ཏུ་འདྲེས་ནས་སྔར་གྱི་དམ་ཚིག་པའི་གཞལ་ཡས་ཁང་ལ་ཐིམ་པར་བསམ་མོ།",
    "སྔར་བསྐྱེད་པའི་དམ་ཚིག་གི་དཀྱིལ་འཁོར་གྱི་ཁ་དོག་དང་།",
    "ཡེ་ཤེས་པ་དེ་ཉིད་ཐབས་དང་ཤེས་རབ་ཏུ་སྙོམས་པར་འཇུག་པའི་ཏིང་ངེ་འཛིན་ལས་བྱུང་བའི་བདེ་བ་ཆེན་པོས་གང་བར་བསམ་མོ།",
    "དེ་ནས་རང་གི་ཐུགས་ཀ་ནས་སྤྲོས་པའི་གཤིན་རྗེ་མཐར་བྱེད་ལ་སོགས་པས་ཡེ་ཤེས་པར་མོས་པའི་ཕྱིར་འབྲང་གི་བགེགས་ཚར་བཅད་ཅིང་།",
    "དེ་ནས་སྔར་ལྟར་སེམས་དཔའ་དྲུག་གིས་འཁོར་ཐམས་ཅད་ཀྱི་སྐྱེ་མཆེད་བྱིན་གྱིས་བརླབ་པ་ནི་ཉེ་སྒྲུབ་ཆེན་པོའོ།",
    "གོས་དཀར་མོ་དྲི་རྡོ་རྗེ་མ།",
    "སྒྲོལ་མ་རོ་རྡོ་རྗེ་མ་རེག་བྱ་རྡོ་རྗེ་མ།",
    "སེམས་ཀྱི་རང་བཞིན་དུ་ཞུ་ནས་དེ་ཉིད་འོད་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཚོགས་སུ་གྱུར་པར་བསྒོམ་མོ།",
    "དེ་ནས་ཡུམ་ཤེས་རབ་མའི་བ་སྤུའི་སྒོ་རེ་རེ་ནས་འོད་ཟེར་སྣ་ཚོགས་པ་ནམ་མཁའ་མ་ལུས་པ་ཁྱབ་པ་སྤྲོས་ནས་འོད་ཀྱི་སྒོ་དེ་རྣམས་ལས་ལྷ་མོ་དེ་དག་ངེས་པར་ཕྱུང་ཞིང་སྤྲོ་བར་བྱའོ།",
    "ལྷ་མོ་དེ་དག་རང་བཞིན་མེད་བཞིན་དུ་རྣམ་པ་དེར་སྣང་བའི་སྒྱུ་མ་ལྟ་བུ་དྲན་པར་བྱ་ཞིང་།",
    "མཆོད་ལྷ་རང་རང་གི་ས་བོན་ལས་ཡུམ་གྱི་མངལ་དུ་བསྐྱེད་པ་ནི་རྩ་བའི་དགོངས་པ་མིན་ནོ།",
    "མི་བསྐྱོད་པའི་སྒོ་ནས་བསྟོད་པ་ནི་བདུད་དང་ཉོན་མོངས་པས་བསྐུུལ་མི་ནུས་པས་མི་བསྐྱོད་པ།",
    "རྣམ་སྣང་གི་སྒོ་ནས་བསྟོད་པ་ནི།",
    "རིན་འབྱུང་གི་སྒོ་ནས་བསྟོད་པ་ནི།",
    "ནང་གི་རྫས་གང་ཡིན་ཤ་ལྔ་བདུད་རྩི་ལྔར་བསྐྱེད་པ་ཡིན་ཏེ།",
    "ཐུན་མོང་དུ་བསྐྱེད་པའི་ལུགས་གཉིས་འབྱུང་ངོ།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་རོ།",
    "ཕྱི་མ་ནི་ཕྲ་མོ་དང་ཐིག་ལེའི་རྣལ་འབྱོར་གྱིས་བསྒྲུབ་པ་ཡིན་ནོ།",
    "རྗེས་དཔག་གིས་མི་འགྲུབ་པ་ནི།",
    "ཕྱི་རོལ་དོན་དང་ཤེས་པ་བདག་གཅིག་དང་དེ་བྱུང་གི་འབྲེལ་བ་གང་དུའང་མཐོང་བ་མེད་པའི་ཕྱིར།",
    "ཆ་བཅས་ཁོ་ནར་སྣང་གི་ཕྲ་རབ་རྣམས་མངོན་སུམ་ལ་སྣང་བ་མ་ཡིན་པའི་ཕྱིར།",
    "རྡུལ་ཕྲན་ཆ་མེད་མི་སྲིད་པར་ཐལ།",
    "ཕྲ་རབ་དུ་མ་འདུས་པའི་ཕྱོགས་གཅིག་གིས་ཕྲད་ན་ཆ་བཅས་སུ་འགྱུར་ལ།",
    "བདག་དང་བདག་གི་ཞེས་པ་ནས་དེས་ན་རྣམ་པར་དབྱེ་བ་ཐམས་ཅད་མིན་ཞེས་པའི་བར་རོ།",
    "བདག་དང་བདག་གིར་འཛིན་པའི་རྣམ་པར་རྟོག་པ་འབྲས་བུ་དང་བཅས་པ་ཡིན་ལ།",
    "དེས་ན་གང་ཞིག་སོ་སོ་སྐྱེ་བོ་རྣམས་ལ་གཟུགས་སོགས་སོ་སོར་ཞུགས་ཤིང་སྣང་བ་དེ་ཉིད་རང་བཞིན་འཐའ་དག་སྟོང་པ་ལ་སོགས་པར་རྟོགས་པ་རྣམས་ཀྱིས་གཟིགས་པ་ནི་དོན་དམ་པའི་བདེན་པ་ཡིན་ནོ།",
    "སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "གཟུགས་ལ་སོགས་པའི་ཡུལ་དུ་སྣང་བ་དྲུག་རྣམ་པར་དག་པ་ནི་གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པའི་ཤེས་རབ་མ་དྲུག་གི་རྣམ་དག་ཡིན་ལ།",
    "དེ་ནས་བ་སྤུའི་བུ་ག་རེ་རེ་ནས་འོད་ཟེར་སྤྲོས་ནས་ནམ་མཁའ་ཐམས་ཅད་ཁྱབ་པར་བྱས།",
    "ཡང་ན་རང་གི་མཚན་པ་ཞེས་སོགས་ཏེ།",
    "རང་གི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་འཕྲོས།",
    "དེ་གཙོ་བོའི་ཕྱག་མཚན་གཉིས་སུ་གྱུར་པ་ལས་བསྐྱེད་པས་ཆོག་གི་ཞུ་བ་གླུས་བསྐུུལའང་མི་དགོས་སོ།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་བསྒོམས་ནས་མཚན་མ་བརྟན་པོ་མཐོང་བ་དང་།",
    "རང་གི་སེམས་ཉིད་རྟེན་བརྟེན་པའི་དཀྱིལ་འཁོར་དུ་སྣང་བར་ཤེས་པར་བྱས་ནས་དབུགས་འབྱུང་འཇུག་གི་སྲོག་རྩོལ་ཧ་ཅང་བསྡམས་པ་མ་ཡིན་པར།",
    "སྐུུ་རྡོ་རྗེ་ལ་སོགས་པའི་རིགས་གང་ཡིན་དེ་ཉིད་ཀྱིས་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་གཙོ་བོ་བྱས་ནས་སྤྲོ་བསྡུ་བྱའོ།",
    "སྔ་མ་རགས་པའི་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་སྐབས་བཞིན་དུ་མཆོད་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "རང་གི་སྤྱི་བོར་མཐོ་གང་ཙམ་གྱིས་འཕགས་པར་ཟླ་བའི་སྟེང་དུ་བདུད་རྩི་ལྔའི་ས་བོན་ཨོཾ་ཡིག་དཀར་པོ་འོད་ཟེར་ལྔ་འཕྲོ་བ་དང་བཅས་པ་ཆོ་ག་བཞིན་དུ་བསམས་ནས།",
    "གི་སྤྱི་བོ་ནས་བརྩམས་ཏེ།",
    "སྦྱིན་སྲེག་གི་ཆོ་གའོ།",
    "ཐ་མལ་པའི་རྣམ་རྟོག་དག་པའི་སྒོ་ནས་རང་གི་སེམས་ལྷའི་ང་རྒྱལ་དང་ལྡན་པའི་སྒོ་ནས།",
    "སྐུུ་རྡོ་རྗེ་ལ་སོགས་པའི་ལྷ་རྣམས་ཚིམ་པར་མོས་པ་བྱའོ།",
    "གསུམ་པ་ནི་དམ་ཚིག་གི་ཞེས་ཏེ།",
    "གལ་ཏེ་བྲེལ་ན་ཐུན་གཞན་གསུམ་ལ་གཞལ་ཡས་ཁང་དང་གཙོ་བོ་དཀྲོངས་བསྐྱེད་བྱས་ནས་ཐུགས་ཀ་ནས་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་ལྷ་རྣམས་སྤྲོས་ནས།",
    "སད་ལྡང་བའི་དུས་སུ་ལྷ་མོ་རྣམས་ཀྱིས།",
    "གླུས་བསྐུུལ་ནས་ལྡང་བར་མོས་པ་བྱའོ།",
    "རྣལ་འབྱོར་པ་རང་གི་བཟླས་བརྗོད་ལ་སོགས་པ་མཐར་ཐུག་པའི་བར།",
    "རྒྱ་ཆེ་བ་ལྷའི་རྣམ་སྒྲུབ་ཐབས་ཀུན་བཟང་གི་ཚིག་དོན།",
    "པ་ཅན་དུ་ཤར་བའི་བློ་དེ་ཉིད་ཡོད་པའི་ཚེ་དེའི་གནོད་བྱ་ཕྱིན་ཅི་ལོག་གི་ཀུན་རྟོག་དེ་དག་མི་སྣང་བའི་ཕྱིར་རོ།",
    "སྔར་བསྒྲུབས་ཟིན་པས་རང་གི་སེམས་འཁོར་ལོའི་རྣམ་པ་ཅན་དུ་ཤར་བ་ལས་གཞན་མེད་པ་མི་འགལ་ལོ།",
    "གཉེན་པོ་གང་ཞིག་གིས་སྤང་བྱ་གང་དང་གནོད་བྱ་གནོད་བྱེད་ལན་ཅིག་མཐོང་བ་དེ་ལ་ནི།",
    "གསུམ་པ་གང་གིས་མཛད་པ་དང་བསྒྱུར་བའི་ཚུལ་ནི།",
    "སྒྲུབ་ཐབས་ཀུན་ཏུ་བཟང་པོའི་ཚིག་གི་དོན་ཅུང་ཟད་བཀོད་པ་འདི།",
    "སྟེང་གི་ཉི་ཟླ་ཚངས་པ་ཆེན་པོ་དང་།",
    "རང་གི་བུ་སྨད་མཛའ་བཤེས་གཉེན་འདུན་དང་།",
    "བདག་གི་ལས་འདིའི་འབྲས་བུ་མཆིས་པར་མཛོད།",
    "གིས་སྟོང་པར་སྦྱངས།",
    "རོལ་མོ་རྣམས་དྭངས་ཤིང་ཐོགས་པ་མེད་པ་ནམ་མཁའ་དང་མཉམ་པར་གྱུར་པར་བསམ།",
    "སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པར་བསམ།",
    "ལག་པ་གཉིས་སུ་ཨ་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེ།",
    "དེའི་སྟེང་དུ་ཧཱུཾ་ཧཱུཾ་ལས་རྡོ་རྗེ་དཀར་པོ་རྩེ་ལྔ་པ་རེ་རེ།",
    "སོར་མོ་རྣམས་ཀྱང་རྡོ་རྗེ་རྩེ་གཅིག་པར་གྱུར་པར་བསམ།",
    "ཁུ་ཚུར་གཉིས་སྒེག་པ་དང་བཅས་པས་ཐ་མ་ལ་སོགས་པ་ནས་རིམ་གྱིས་བཀྲོལ་ཏེ་མཐར་མཉམ་པའི་ཐལ་མོ་བརྡབས་ལ།",
    "ཞེས་ཉེར་སྤྱོད་ལྔ་རོལ་མོ་དང་བཅས་པ་དབུལ།",
    "གསུང་གི་ང་རོ་འབྲུག་སྟོང་ལྡིར་བའི་སྒྲས།",
    "ཉོན་མོངས་དུག་ཆེན་རྩད་ནས་འཇོམས་མཛད་པ།",
    "ཉི་ཟླ་འབར་བའི་སྤྱན་གྱི་སྡང་མིག་གིས།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་ཁ་སྟེང་དུ་བསྟན་ཏེ་སོར་མོ་རྣམས་འབར་བ་ལྟ་བུར་བྱས་པའི་མཐེ་བོང་རྩེ་སྦྱར་བ་སྲིན་ལག་དང་གུང་མོའི་བར་དུ་འཛིན་པ་རྡོ་རྗེ་མེའི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་མགལ་མེའི་འཁོར་ལོ་བཞིན་དུ་བསྐོར་ཏེ་མགོ་བོའི་སྟེང་དུ་མཛུབ་མོ་གཉིས་ལྕགས་ཀྱུའི་ཚུལ་དུ་བཞག་པ་རྡོ་རྗེ་འཇིགས་བྱེད་སྤྱན་གྱི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་ཐལ་མོའི་མཐེ་བོང་གཉིས་བརྐྱང་ལ་མཛུབ་མོ་གཉིས་མཆེ་བ་ལྟར་བྱས་པ་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་ཕྱག་རྒྱ་དང་།",
    "གུར་གྱི་འོག་ཏུ་རྡོ་རྗེའི་བླ་རེར་གྱུར་པར་བསམ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཐེའུ་ཆུང་གཉིས་ལུ་གུ་རྒྱུད་དུ་སྦྲེལ་མཛུབ་མོ་གཉིས་རྩེ་སྤྲད་དེ་བཟློག་ནས་སྤྱི་བོར་བཞག་པ་རྡོ་རྗེ་གཙུག་ཏོར་གྱི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་གཉིས་སེམས་དཔའི་སྐྱིལ་ཀྲུང་དུ་བྱས་ཏེ་མཛུབ་མོ་གཉིས་མཉམ་པོར་གཤིབས་ཏེ་ཕྱེ་ལ་མཐེའུ་ཆུང་གཉིས་བ་དན་ལྟར་བྱས་པ་རྡོ་རྗེ་བ་དན་གྱི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་ཕྱག་རྒྱ་དེ་ཉིད་ཁ་དྲུང་དུ་བཞག་པ་རྡོ་རྗེ་ནག་མོའམ་རྡོ་རྗེ་དུས་ཀྱི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཁ་སྟེང་དུ་བསྟན་པ་རི་བོ་འདེགས་པའི་ཚུལ་དུ་བྱས་པ་རྡོ་རྗེ་རྩེ་མོའི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་དང་གུང་མོ་གཉིས་རྡོ་རྗེ་ལྟར་བྱས་པ་རྡོ་རྗེ་ལས་ཀྱི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རྒྱབ་སྦྱར་མཐེའུ་ཆུང་གཉིས་སྦྲེལ་མཛུབ་མོ་སྡིགས་མཛུབ་བྱས་པ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་དང་།",
    "མདུན་དུ་བཅོམ་ལྡན་འདས་ཀུན་རིག་གི་རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་གྲུབ་པར་གྱུར།",
    "ཐལ་མོ་བརྐྱང་པ་ལས་གུང་མོ་གཉིས་ནང་དུ་བཀུག་པའི་ཕྱག་རྒྱ་དང་།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཐེ་བོང་དང་མཛུབ་མོའི་སྐམ་པས་ཞབས་བསིལ་གྱི་ཆུ་དང་མེ་ཏོག་འགྱིང་བའི་ཚུལ་གྱིས་སོར་མོ་རྣམས་བསྐོར་ཞིང་བླངས་ལ་མཛུབ་མོ་དང་གུང་མོ་དང་སྲིན་ལག་དང་མཐེའུ་ཆུང་རྣམས་རིམ་གྱིས་དགྲོལ་བའི་ཕྱག་རྒྱ་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རོལ་མོ་དཀྲོལ་པའི་ཚུལ་ལམ་རོལ་མོ་དཀྲོལ་ཞིང་།",
    "ཤཔྟ་ཞེས་པས་རོལ་མོ་རྣམས་ཀྱིས་མཆོད།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "སོ་སོར་བརྟན་པོར་བདག་གིས་བཟུང་།",
    "སྡོམ་པ་དེང་ནས་བདག་གིས་བཟུང་།",
    "ཉིན་རེ་བཞིན་ནི་དུས་དྲུག་ཏུ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "བདག་གིས་སྡོམ་པ་མ་ལུས་བཟུང་།",
    "མ་སྒྲལ་བ་རྣམས་བདག་གིས་བསྒྲལ།",
    "མ་གྲོལ་བ་རྣམས་བདག་གིས་དགྲོལ།",
    "དེ་ནས་ལག་པ་གཉིས་བཀན་ལ་སོར་མོ་རྣམས་ཕན་ཚུན་རྩེ་སྤྲད་དེ་མདུན་དུ་བཞག་ལ།",
    "ལག་མཐིལ་གཉིས་སུ་ཨ་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེ།"
  ]
}