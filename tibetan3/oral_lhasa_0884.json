    "དོན་གཞན་གང་དག་ཅི་ཡང་རུང་བ་རྣམ་པར་གྲོལ་བ་དང་།",
    "འབྲས་བུ་ལ་མི་ལྟོས་པ་ཁོ་ནར་རང་ལས་རབ་ཏུ་གྲུབ་པར་འགྱུར་བས་དེ་ཡང་མི་འཐད་དོ།",
    "འདིས་མཚོན་པར་བྱེད་པས་མཚན་ཉིད་ཅེས་བྱ་ན།",
    "འདིས་གང་མཚོན་པར་བྱ་བའི་མཚན་ཉིད་ཀྱི་གཞི་དེ་ཡང་མ་སྐྱེས་པས་མེད་དེ།",
    "དེ་མེད་ན་མཚོན་པར་མི་བྱེད་པ་དེ་ཅི་ལྟར་མཚན་ཉིད་དུ་འགྱུར།",
    "འདི་ལྟར་མཚན་ཉིད་མེད་པའི་དངོས་པོ་ཇི་ལྟར་ཡོད་པར་འགྱུར།",
    "མཚན་ཉིད་ཀྱི་གཞི་ཡང་མཚན་ཉིད་ལ་མི་ལྟོས་པ་ཁོ་ནར་རང་ལས་རབ་ཏུ་གྲུབ་པར་འགྱུར་བས་དེ་ཡང་མི་འཐད་དོ།",
    "ཅི་སྟེ་འགྱུར་ན་ནི་ཐམས་ཅད་ཀྱང་བདེ་བ་དང་སྡུག་བསྔལ་ཐམས་ཅད་དང་མ་ཕྲད་པར་ཚོར་བ་པོར་འགྱུར་བས་དེ་ཡང་མི་འཐད་དོ།",
    "ཚོར་བ་པོ་ཚོར་བ་ལ་མི་ལྟོས་པ་ཁོ་ན་ཚོར་བར་མི་བྱེད་བཞིན་དུ་རང་ལས་རབ་ཏུ་གྲུབ་པར་འགྱུར་བ་དང་།",
    "དེ་ལྟ་ན་སུ་ཡང་མྱ་ངན་ལས་མ་འདས་པར་མི་འགྱུར་བས་དེ་ཡང་མི་འཐད་དོ།",
    "ཅི་སྟེ་རྣམ་པར་གྲོལ་བས་མྱ་ངན་ལས་འདས་པ་འཕྱི་བར་གྱུར་ན་ནི་མྱ་ངན་ལས་འདས་པ་མ་ཐོབ་པ་ཉིད་དུ་ཡང་རྣམ་པར་གྲོལ་བར་འགྱུར་ཏེ།",
    "དེ་ལྟ་ན་ཡང་མྱ་ངན་ལས་འདས་པ་མ་ཐོབ་པ་ཐམས་ཅད་རྣམ་པར་གྲོལ་བར་འགྱུར་ཞིང་།",
    "རྣམ་པར་གྲོལ་ནས་ཕྱིས་མྱ་ངན་ལས་འདའ་བ་དོན་མེད་པ་ཉིད་དུ་ཡང་འགྱུར་རོ།",
    "སྔོན་མ་བྱུང་ལ་ཕྱིས་བྱུང་བར་གྱུར་ན་སྐྱེ་བ་ཅན་དང་མཚུངས་པར་ཡང་འགྱུར་བས་དེ་ཡང་མི་འདོད་དོ།",
    "ཅི་སྟེ་ཡང་རྣམ་པར་གྲོལ་བ་དང་།",
    "རྣམ་པར་གྲོལ་བ་མྱ་ངན་ལས་འདས་པ་ལ་མི་ལྟོས་པ་ཁོ་ནར་རང་ལས་རབ་ཏུ་གྲུབ་པར་འགྱུར་བ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ཡང་རྣམ་པར་གྲོལ་བ་ལ་མི་ལྟོས་པ་ཁོ་ནར་རང་ལས་རབ་ཏུ་གྲུབ་པར་འགྱུར་བས་དེ་ཡང་མི་འཐད་དོ།",
    "ཡོད་མ་ཡིན་པར་མ་ཟད་ཀྱི།",
    "སྡུག་བསྔལ་ཉིད་མི་འཐད་པས་བདག་ཡོད་པར་ག་ལ་འགྱུར།",
    "གཞན་གྱིས་བྱས་དང་གཉི་གས་བྱས།",
    "ཁ་ཅིག་ནི་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པར་འདོད།",
    "ཁ་ཅིག་ནི་སྡུག་བསྔལ་བདག་དང་གཞན་གྱིས་བྱས་པར་འདོད།",
    "གཉི་གས་བྱས་པར་སྨྲ་བ་རྣམས་ཀྱི་སྡུག་བསྔལ་དེ་ནི་བདག་དང་།",
    "གལ་ཏེ་སྡུག་བསྔལ་བདག་ཉིད་ཀྱིས་བྱེད་པར་གྱུར་ན་ཡོད་པའམ།",
    "མེད་པ་ཞིག་བྱེད་པར་འགྱུར་གྲང་ན།",
    "དེ་ཡང་བདག་ཉིད་ཀྱིས་བྱས་ན།",
    "ཇི་ལྟར་མེད་པ་བདག་ཉིད་ཀྱིས་བདག་ཉིད་བྱེད་པར་འགྱུར།",
    "སྡུག་བསྔལ་མ་བྱས་ཤིང་མེད་པ་ལ་གཞན་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "གཞན་མེད་པ་ཁོ་ནའི་ཕྱིར་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པར་མི་རིགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་རྣམ་པར་ཤེས་པའི་རྐྱེན་གྱིས་མིང་དང་གཟུགས་ཞེས་གསུངས་ཏེ།",
    "འདི་ལྟར་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་སོ།",
    "སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པ་མ་ཡིན་པ་ཉིད་དེ།",
    "སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པར་འགྱུར།",
    "གཞན་ཉིད་མེད་ན་ཇི་ལྟར་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པས་འཐད།",
    "སྡུག་བསྔལ་རྒྱུ་དང་རྐྱེན་ལས་བྱུང་བས་དེའི་ཕྱིར་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་སོ་ཞེས་ཀྱང་མི་སྨྲའོ།",
    "སྡུག་བསྔལ་གང་ཟག་གཞན་གྱིས་བྱས་པས་དེའི་ཕྱིར་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་སོ་ཞེས་ཀྱང་སྨྲའོ།",
    "སྡུག་བསྔལ་བྱས་པའི་གང་ཟག་ནི།",
    "འདི་ལྟར་ཕུང་པོ་སྡུག་བསྔལ་མེད་པ་གསལ་བར་བྱེད་པ་མེད་པའི་གང་ཟག་འབའ་ཞིག་པ་གང་ཡིན་པ་ལ་གདགས་པ་ཡང་མེད་ན་དེས་ཇི་ལྟར་སྡུག་བསྔལ་བྱེད་པར་འགྱུར་ཏེ།",
    "སྡུག་བསྔལ་དེ་བྱས་གང་སྦྱིན་དེ།",
    "སྡུག་བསྔལ་མེད་པར་ཇི་ལྟར་རུང་།",
    "གལ་ཏེ་གང་ཟག་གཞན་གྱིས་ཕུང་པོ་འདི་སྡུག་བསྔལ་བྱས་ཤིང་དེས་དེ་བྱས་ནས་གཞན་ལ་སྦྱིན་པར་བྱེད་ན་གཞན་གྱིས་དེ་བྱས་ནས་གང་ལ་སྦྱིན་པར་བྱ་བ་དེ་སྡུག་བསྔལ་མེད་ཅིང་།",
    "སྡུག་བསྔལ་དང་བྲལ་བ་གསལ་བར་བྱེད་པ་མེད་པ་འབའ་ཞིག་པར་ཇི་ལྟར་རུང་བར་འགྱུར་བ་དེ་ཇི་སྨྲོས་ཤིག།",
    "འདི་ལྟར་ཉེ་བར་ལེན་པ་མེད་པ་འབའ་ཞིག་པ་གང་ལ་གདགས་པ་ཡང་མེད་ན་གསལ་བར་བྱེད་པ་མེད་དེ་གཞན་ཡིན་དུ་ཟིན་ཀྱང་ཇི་ལྟར་སྡུག་བསྔལ་བྱེད་པར་འགྱུར།",
    "རྣམ་པ་ཐམས་ཅད་དུ་མི་སྲིད་པ་ཡིན་ན་དེའི་སྡུག་བསྔལ་བྱེད་པ་གཞན་ག་ལ་ཡོད་ན་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་སོ་ཞེས་བག་ཚ་བ་མེད་པར་སྨྲ།",
    "སྡུག་བསྔལ་གཞན་གྱིས་ག་ལ་བྱས།",
    "དེ་ནི་དེ་ཡི་བདག་བྱས་འགྱུར།",
    "ཅིག་ཤོས་ཀྱི་དེ་གཞན་གྱིས་བྱས་པར་འགྱུར།",
    "སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པར་མི་འཐད་པ་དེ་ནི་བསྟན་ཟིན་ཏོ།",
    "དེའི་ཕྱིར་གང་ཟག་གཞན་གྱིས་སྡུག་བསྔལ་བྱས་སོ་ཞེས་བྱ་བར་ཡང་མི་རིགས་སོ།",
    "གཞན་གྱིས་བྱས་སོ་ཞེས་མི་སྨྲའི།",
    "སྡུག་བསྔལ་གང་ཡིན་པ་དེ་ཉིད་གང་ཟག་མ་ཡིན་པས་རྣམ་གྲངས་ལས་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་སོ་ཞེས་ཀྱང་སྨྲའོ།",
    "འདི་ལྟར་གལ་ཏེ་གང་ཟག་ཉེ་བར་ལེན་པ་མེད་པ་འབའ་ཞིག་པ་འགའ་ཞིག་རབ་ཏུ་གྲུབ་པར་གྱུར་ན་ནི།",
    "དེ་ཉིད་ཀྱིས་ནི་དེ་མ་བྱས།",
