    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཆུད་མྱི་གཟོན།་",
    "ལུས་ཤིན་ཏུ་རྣམ་པར་ཕྱེ་བ་མཛེས་པ་དང་ལྡན་པ།",
    "བསྒྲིབས་ཞུཔ་མྱེད་པའི་ལས་རྣམ་པར་དག་པ་དང་ལྡན་པ་དེ།",
    "རྣམ་པར་ཤེས་པ་ཤིན་ཏུ་བཟུང་བ།",
    "བླ་ན་མེད་པར་དམྱིགས་ནས་བཟའ་བ་དང་བཏུང་བ་འདི་དག་འདི་ལྟར་བཏང་བ་དང་།",
    "ཡེ་ཤེས་ཀྱི་སྐུ་ལ་ཡང་དག་པར་སྤྱོད་པ་དང་།",
    "ཏིང་ངེ་འཛིན་གྱིས་ཚིམ་པར་བྱེད་པའི་སེམས་དང་ལྡན་པ་དང་།",
    "ཞིམ་ཞིང་ཚུལ་དང་ལྡན་པའི་རོའི་དམ་པར་གྱུར་པ།",
    "ལྟོ་ལ་བདེ་བས་ཡང་དག་པར་སྟོན་པ།",
    "པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཆ་བྱད་ངན་པ་ཐམས་ཅད་རྣམ་པར་བཟློག་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཁ་དོག་དག་༡༡པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཁ་དོག་འཇམ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།་",
    "༡་བདེ་བར་འགྲོ་བ་རབ་ཏུ་འཐོབ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "བླ་ན་མྱེད་པའི་ཐམས་ཅད་འམཁྱེན་པ་ཉིད་དག་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོ་སྟེ།",
    "སློང་ཞིང་ལེན་པ་སྣ་ཚོགས་ལ་དེ་དང་༩དེ་དག་སྦྱིན་པར་བྱ་བའི་ཚེ།",
    "བླ་ན་མྱེད་པའི་ཐམས་ཅད་མཁྱེན་པ་མཐོང་བ་རྣམ་པར་དག་པ་ཐོབ་པའི་༡་ཕྱིར།",
    "སྦྱིན་པས་བསྒོས་པར་གྱུར་ཅིག།",
    "ལྷ་རྫས་ཀྱི་མལ་ཆ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "གནས་ཐམས་ཅད་རྣམ་པར་བསྒོམ་༧པ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་གནས་ལ་གནས་པ་ཝ་དང་སྐེ།",
    "ལེགས་པར་༧སྤྱོད་པའི་རྟེན་ལ་སྤྱོད་པ་དང་།",
    "ཤིན་ཏུ་དག་པར་འགྱུར་བ་དང་།",
    "ཡེ་ཤེས་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "ལམ་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "བསམ་པ་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "ཡེ་ཤེས་རྣམ་པར་དག་པར་འགྱུར་བར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཁ་དོག་མཐའ་ཡས་པར་སྣང་བའི་མར་མེ་འམ།",
    "ཐོགས་པ་མྱེད་པའི་སྣང་བ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཡོངས་སུ་བསྔོ་བ་ཐོགས་པ་མྱེད་པར་འགྲོ་བས་དེ་ལྟ་དེ་ལྟར་ཡོངས་སུ་བསྔོའོ།",
    "འཕགས་པའི་བསྟན་པ་ལ་གནས་པར་བརྩོན་པས་སློབ་དཔོན་དང་།",
    "སྣོད་བཟང་པོ་རྣམ་པར་དག་པར་གྱུར་ཅིག།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཁོངས་སུ་ཆུད་པར་གྱུར་ཅིག།",
    "ནོར་བུའི་ཤིང་རྟ་ལ་རྒྱན་གྱིས་ཤིན་ཏུ་མཛེས་པར་བྱས་པ་སྦྱིན་པ་འམ།",
    "འཁྲུལ་བ་མྱེད་པར་དྲང་བ་༢སྦྱིན་པ་འམ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཡོངས་སུ་དག་པ་དང་མཐུན་ཞིང་གཅིག་༡པར་གྱུར་ཅིག།",
    "ཡོན་ཏན་གྱིས་རྣམ་པར་དག་པའི་ཡིད་དང་ལྡན་པ།",
    "མཐུན་པར་ཡོངས་སུ་གཏོང་བའི་བསམ་པ་ཅན།",
    "མཆོད་སྦྱིན་ཆེན་པོའི་མཆོད་སྦྱིན་ཤིན་ཏུ་བྱས་པ།",
    "རྫུ་འཕྲུལ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྫུ་འཕྲུལ་གྱི་འཁོར་མཐའ་ཡས་པ་ལ་མཁས་༣པར་གྱུར་ཅིག།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་ལ་རྣམ་པར་སེམས་པ།",
    "ཕན་འདོགས་པ་རྣམ་པར་དག་པས་ཆོ་འཕྲུལ་མཐའ་ཡས་པས་རྣམ་པར་རོལ་པ་ཡང་རིདག་པར་སྟོན་པར་གྱུར་ཅིག།",
    "མྱི་ཟད་པས་ཐམས་ཅད་མཁྱེན་པའི་མཐར་ཐུག་པར་གྱུར་ཏེ།",
    "སྦྱིན་པའི་གནས་དོན་ཡོད་པའི་འབྲས་བུ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཐོས་པ་དོན་ཡོད་པར་གྱུར་ཅིག།",
    "ཞེས་སྤྱི་བོས་བཏུད་དེ་བཟོད་༣པ་གསོལ་བས་སློང་བ་ཐམས་ཅད་བཟོད་པར་བྱས་རིམ་གྲོར་བྱས།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡེ་ཤེས་ཀྱི་ཤིང་རྟ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "སྟན་༡༡གྱི་སྦྱིན་པ་བྱེད་ཅིང་རྒྱལ་པོ་བཞུགས་༡༢པའི་ཁྲི་སྟན་བཟང་པོ་བེེ་ཌཱུརྱའི་༡་རྐང་པ་ཅན་སེང་གེའི་ཁྲི་ལ་གནས་པ།",
    "ཆིས་རུ་བྱ་བ་ལ་རྒྱལ་པོའི་བཀའ་ཐམས་ཅད་ཉམས་པ་མེད་པར་ཉན་པ།",
    "དཔལ་རྣམ་པར་སྣང་བ་དང་།",
    "དགའ་བ་༡་འཁྱིལ་པའི་རྒྱན་སྣ་ཚོགས་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "ཁམས་གསུམ་པས་ཟིལ་གྱིས་མྱི་ནོན་པའི་སྟན་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྒྱན་གྱི་རྣམ་པ་བསམ་གྱིས་མི་ཁྱབ་པ་༥སྣ་ཚོགས་དང་ལྡན་པའི་སྟན་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྣམ་པར་འཕྲུལ་པ་ཐམས་ཅད་དང་།",
    "རྡོ་རྗེའི་གདན་ཐམས་ཅད་ལ་འཁོད་པར་༡༢གྱུར་ཅིག་ཅེས།",
    "ཉེན་ཀོར་དྲི་ཞིམ་པར་བསྒོས་ཤིང་བདུགས་༡་པ།",
    "ནམ་མཁའི་མཐས་གཏུགས་པ་ཐམས་ཅད་ན་༢བཞུགས་པ་ཐམས་ཅད་ལ་གདུགས་ཀྱིས་དགབ་པའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "རྒྱན་མཛེས་ཤིང་རྣམ་པར་དག་པའི་གདུགས་དང་།",
    "བློ་ཡངས་པ་དང་སེམས་རྒྱ་ཆེ་བ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཡེ་ཤེས་ཆེན་པོས་མཉམ་པར་དགབ་པ་ཐོབ་དཔར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "སེམས་དང་སྒྲུབསམ་པ་རྣམ་པར་དག་པར་འགྱུར་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "རྒྱལ་མཚན་ཤིན་ཏུ་འཕགས་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་མཐུ་བོ་ཆེའི་རྒྱལ་མཚན་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་ཀྱི་ཉི་མའི་དཀྱིལ་འཁོར་འོད་ཟེར་༦རབ་ཏུ་འགྱེད་པའི་རྒྱལ་མཚན་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ལུས་བལྟ་ན་སྡུག་པ་ལུས་༤རྣམ་པར་དག་ཅིང་མྱི་མཐུན་པ་མྱེད་པའི་རྒྱན་གྱིས་ལུས་༥ཤིན་ཏུ་བརྒྱན་པ།",
    "རྒྱན་གྱིས་བརྒྱན་པར་བརྩོན་པ།",
    "མཚན་གྱིས་༤ལུས་ཤིན་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "ལུས་མཚན་གྱིས་ཤིན་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "རྣམ་པར་དག་པ་དང་ལྡན་ཞིང་ཡོན་ཏན་གྱིས་བརྒྱན་པའི་དབྱངས་༧དང་ལྡན་པར་གྱུར་ཅིག།",
    "སེམས་ཀྱི་རྒྱན་གྱིས་བརྒྱན་པར་གྱུར་ཅིག།",
    "གཟུངས་ཐམས་ཅད་ཀྱི་རྒྱན་གྱིས་རབ་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "སེམས་ཡེ་ཤེས་ཀྱིས་ཡང་དག་པར་བརྒྱན་པ་དང་ལྡན་༡པར་གྱུར་ཅིག་ཅེས།",
    "དྲེགས་པ་མེད་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "སྤྱི་བོ་༢གཙུག་ཏོར་ཅན་གྱི་མགོ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་ཀྱི་ཅོད་པན་ཤིན་ཏུ་བཅིངས་པར་གྱུར་ཅིག།",
    "སྤྱི་བོ་ཤིན་ཏུ་བཙུན་པ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "སའི་དམ་པ་ལ་གནས་པར་གྱུར་ཅིག།",
    "རྒྱལ་པོའི་མཆོག་དམ་པར་གྱུར་ཅིག་ཅེས།",
    "རྒྱལ་པོ་མྱིག་བཟངས་ཀྱིས་༥ཇི་ལྟར་བྱས་པ་བཞིན་དུ་བདག་དང་།",
    "འཁོར་དུ་བཅས་ལནོར་ཐམས་ཅད་དང་བཅས་པར་ཡོངས་སུ་བཏང་སྟེ།",
    "རྣམ་པར་བྲལ་བས་མ་རིག་པའི་མུན་པ་དང་རབ་རིབ་དང་།",
    "ལིང་ཏོག་རྣམ་པར་བསྩལ་༡ཅིང་།",
    "རབ་རིབ་མྱེད་པའི་ཡེ་ཤེས་ཡང་དག་པར་མཐོང་བར་གྱུར་ཅིག།",
    "འདོད་པའི་བཅིངས་པ་ཐམས་ཅད་རྣམ་པར་སྤངས་པར་གྱུར་ཅིག།",
    "གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པར་གྱུར་ཅིག།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་ས་ལ་གནས་པར་འགྱུར་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "འགྲོ་བ་ཐམས་ཅད་བསྲུང་བའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ཉིད་༦དུ་སེམས་བསྐྱེད་༧དོ།",
    "འགྲོ་བ་ཀུན་ཏུ་འཇིགས་པ་མྱེད་པའི་ཁང་པར་ཞུགས་ཅཔར་གྱུར་ཅིག་ཅེས།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡིད་དང་སྐེ།་",
    "ཐོར་པག་ཏུ་བཅས་པར་མཚོན་གྱིས་ཕོག་༤སྟེ།",
    "ཐ་དད་པར་ཁོང་དུ་ཆུད་པ་དང་།",
    "སྐྲ་སྣུམ་པར་གྱུར་ཅིག།",
    "པ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "རྡུལ་༡་མྱི་ཆགས་པ་དང་ལྡན་པར་གྱུར་ཅིག་ཅེས།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྟོབས་བཅུའི་མཐས་གཏུགས་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཡེ་ཤེས་ཀྱི་སྐྱེ་མཆེད་ལ་ཡང་དག་པར་བཏང་བའི་སེམས་དང་།",
    "མཉམ་པར་བྱས་པའི་སྦྱིན་པ་དང་།",
    "བག་མྱེད་པའི་སྲེད་༨པ་རྣམ་པར་ཟློག་པར་བྱེད་པ་དང་།",
    "སློང་བ་རྣམས་ཀྱིས་དངོས་པོ་ཅི་བསླངས་པ་སྦྱིན་པར་བྱེད་པའི་ཚེ།",
    "སྐྱེ་བ་ཤེས་ཤིང་ལྷའི་མྱིག་རྣམ་པར་དག་པར་གྱུར་ཅིག།",
    "ཀུན་ཏུ་ལྟ་བའི་མིག་དང་ལྡན་པར་གྱུར་ཅིག།",
    "རབ་རིབ་མེད་པའི་མིག་དང་ལྡན་པར་གྱུར་ཅིག།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་སུ་རིནརིགས་དང་ལྡན་པར་བྱུང་བས།",
    "རྒྱུད་ཆེད་དུ་བརྗོད་པ་རྒྱ་མཚོས་༡༡གཏོང་བའི་སེམས་ཡངས་པར་བྱས་པ་དང་།",
    "རྣ་བ་རྣམ་པར་དག་པའི་ཕྱིར་ཡོངས་སུ་བསྔོས་ནས།",
    "སྣ་རྣམ་པར་དག་པར་ཡོངས་སུ་བསྔོ་སྟེ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ངོ་དང་།",
    "ཨུ་དུམ་བས་སྐར་ལྟར་ཤིན་ཏུ་དཀོན་པར་སེམས་པའི་སེམས་རྣམ་པར་དག་པ་དང་།",
    "མཆེ་བ་དཀར་ཞིང་རྣོ་བ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "དུལ་བའི་སེམས་ཀྱིས་ཉེ་བར་སྤྱོད་པར་གྱུར་ཅིག།",
    "བཞིན་དྲན་པའི་རྒྱན་གྱིས་བརྒྱན་པར་གྱུར་ཅིག།"
  ]
}