    "ཕག་མོ་སྤུན་གསུམ་གྱིས་ལྷ་ཁང་འདིའི་གསེར་ཚོན་གྱི་འཐེབ་ཏུ་སྒོར་ཉིས་ཁྲི་ཕུལ།",
    "རབ་བྱུང་བཅུ་བདུན་པའི་ཐོག་མ་མེ་མོ་ཡོས་ཀྱི་ལོའི་ཁྲུམས་སྟོད་ཟླ་བའི་ཚེས་བཅོ་ལྔའི་ཉིན་ལྷ་ཁང་ལེགས་འགྲུབ་ཀྱི་སྟོན་ཆེན་ཐོག་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་མཆོག་གིས་ཞབས་ཀྱི་པདྨོ་མཛེས་པར་བཀོད་དེ་ལྷ་ཁང་ལ་རབ་གནས་གནང་།",
    "དམ་པ་འདིས་སྔོན་ཡང་རེབ་གཅིག་ལ་བཞོན་མ་བདུན་ཅུ་ལྷག་གྲྭ་ཚང་ལ་ཕུལ་བ་སོགས་ཀྱིས་བསྙེན་བཀུར་བགྱིས།",
    "བསམ་བློ་ཁམས་ཚན་ཞེས་མཚན་གྱི་རོལ་མོ་ཀུན་ལ་གྲགས་པ་ལྟར་རོ།",
    "ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་གནས་ལ་མཁས་པའི་པཎ་གྲུབ་ཆེ་ཆུང་།",
    "དོན་ལྡན་ལྷུན་གྱིས་གྲུབ་པའི་མཚན་བཟང་གིས།",
    "རྫིང་གི་པདྨ་བཞིན་དུ་བསྐྱངས་པའི་མཐུས།",
    "འདི་ན་མགོན་ཁྱོད་ཏིང་འཛིན་ལོངས་སྤྱོད་ལ།",
    "མནལ་ལམ་དུ་ཡི་དམ་གྱི་ཞལ་གཟིགས།",
    "རེ་སྐོང་མར་ནང་ཚོ་ལྔའི་ནང་ཚན་ཀ་རིང་གི་རྒྱུད་དུ་ཤར་ཀ་རིང་ཞེས་པའི་རྒྱུད་ཆགས་པ་ལས་ཀ་རིང་ཇོ་བཟང་བྱ་བ་ཀརྨ་རོལ་བའི་རྡོ་རྗེའི་སྐུ་གདུང་གི་དཀར་ཆག་མཛད་མཁན་དེ་དང་།",
    "རྡོ་བཏགས་པའི་ཐལ་ལས་བྱུང་བའི་རུང་ཁང་གཅོད་པ་སོགས་གཞི་ཚུགས་པ་ཙམ་བྱས་ཏེ་ཉིད་ཀྱི་དོན་གཉིས་པ་མེ་གླང་ལོར་འཆད་ཉན་མཛད།",
    "གདན་སའི་ཁྲི་དང་བོ་རང་ཉིད་ཀྱིས་བྱིན་གྱིས་བརླབས་ཏེ་སྐྱོ་ངལ་ལ་མ་གཟིགས་པར་བཀའ་པོ་ཏི་ལྔའི་འཆད་ཉན་ཡང་དག་པ་དང་།",
    "ང་ཀ་རིང་དཀའ་བཅུ་ལངས་ནས་འཆི་རྒྱུ་ཡིན་ཞེས་བཞེངས་ཏེ་ཐལ་སྐད་བཏང་ནས་གཤེགས།",
    "རང་དགོན་རེ་སྐོང་ཀ་རིང་གཉིས་ནས་རེ་རེ་བཞེངས་ནས་ཡོད།",
    "འདི་བ་རྨ་ཆུ་ཁའི་སྒོ་མེ་སྟེ་རེ་སྐོང་ཧོར་རྒྱ་ནས་ཆད་པའི་ཧོར་རྒྱ་ནས་འཁྲུངས་པས་ཧོར་རྒྱ་འི་གྲགས་རྒན་ཟེར།",
    "ཕྱིས་བྱ་ཁྱུང་གི་ལྷ་ཁང་ལ་རབ་གནས་གནང་དུས་འདིར་ཡང་མེ་ཏོག་བབས་པ་རྟེན་སྒྲོམ་དུ་བཞུགས་པ་སྔར་ཡོད།",
    "རེ་བཞི་བ་ཤིང་སྟག་ལ་གཤེགས།",
    "སྒྲུབ་ཁང་གི་བྲག་གས་པར་ཉེ་གནས་ཀྱིས་ཞུས་པར།",
    "རང་ཉིད་ལ་བུ་སློབ་བཅོ་བརྒྱད་ཀྱིས་བསྐོར་བ་རང་རང་གི་མཚན་བྱང་ཅན།",
    "དེའི་གཤམ་དུ་གྲོང་ཆོག་ལ་གཏན་ནས་སོང་མི་ཆོག་ཅེས་ཕྱག་བྲིས་གནང་བ་མཇལ་རྒྱུ་ཡོད།",
    "སྐྱབས་མགོན་སྐུ་ཕྲེང་གིས་ད་ལྟའི་བར་འཛིན་བདག་བྱས་པ་ཡིན་ལ།",
    "ལ་མོ་ནས་སྐྱོང་ཁུར་གྱི་སྲོལ་འདུགལྷ་དཀར་བོ་ཞེས་བྱ་བ་ནི།",
    "གྲུབ་ཆེན་སྐལ་ལྡན་རས་པས་ཕ་བོང་ལ་བྱམས་སྐུ་རང་བྱོན་ཡོད་པར་གསུངས་ནས་ཁོང་གིས་དེ་ནང་བཞུགས་སུ་ཕུལ་ཏེ་བྱམས་ཁང་རྟེན་བརྟེན་པ་བཞེངས།",
    "ཐོག་མར་ས་བརྐོས་སྐབས་ཚོགས་ཟངས་ཆེན་པོ་ཞིག་གི་ནང་དུ་མཆོད་རྫས་དང་དངུལ་ཡོད་པ་ས་ནང་ནས་བུད།",
    "རེ་སྐོང་བྲ་བོའམ་ཀྲུའུ་ཨ་ལགས་ཀྱིས་བཏབ།",
    "འགའ་རེས་ཞལ་གྱི་རྣམ་འཕྲུལ་ཡིན་ཡང་ཟེར།",
    "དགོན་རོང་གི་གནས་འཚོལ་སྐབས་འདིས་ཁྲིད་ནས་བྱོན།",
    "ཐར་ཤུལ་དཔོན་སློབ་ཀྱིས་གཟིམ་ཁང་རྒྱ་བསྐྱེད་དེ་སྟོན་དཔྱིད་རེས་མོས་ཀྱི་ཚུལ་དུ་རེ་ཞིག་བཞུགས།",
    "སྐབས་ཤིག་གཤིན་པོ་ཞིག་གི་པུར་བསྲེགས་པའི་ཤིང་ཁྲི་བརྩིགས་པ་གནས་བཟང་སར་སྤོ་དགོས་བྱུང་བར་ཁྲི་ལ་གཟན་ལྕག་གིས་བརྒྱབ་ནས་དེད་དེ་བསྐྱལ་བ་སོགས་གྲུབ་རྟགས་བསྟན།",
    "ཡབ་རྗེ་སྐལ་ལྡན་རྒྱ་མཚོའི་སྤྲུལ་བའི་བཀོད་པ་ཨ་རོལ་རྡོ་རྗེ་འཆང་བློ་བཟང་ལུང་རྟོགས་བསྟན་པའི་རྒྱལ་མཚན་གྱིས་ཕྱག་འདེབས་མཛད།",
    "རོལ་མོའི་སྒྲ་སྒྲོག་པ་ཀུན་གྱིས་ཐོས་པར་གྲགས།",
    "ལམ་ཁ་ཞིག་ནས་རྒན་མོ་མགོ་དཀར་ཞིག་གིས་ཆིབས་ཁ་ཁྲིད་དེ་སོང་བ་མ་ཅིག་གི་སྤྲུལ་བར་གསུངས།",
    "སྔོན་ཨ་ལགས་རྔ་རོང་ཟེར་བ་ཞིག་གིས་རྡོའི་མཆོད་རྟེན་ཆེན་པོ་ཞིག་བརྩིགས་ཏེ་ས་འདི་ནམ་ཞིག་ན་དམར་སེར་གྱིས་གང་བའི་དུས་ཤིག་ཡོང་ངེས་པས་དེ་དུས་ངེད་ཀྱི་མཆོད་རྟེན་འདི་སྐོར་མཐར་མི་བསྐྱལ་བའི་ངེས་པ་མེད་ཅེས་ལུང་བསྟན་མཛད་པའི་གནས་སུ་ཆིབས་རྟ་ཉལ་བ་དང་དགོན་རྟགས་གནང་ནས་གཞི་འཛིན་གྱི་གྲ་བ་བསྒྲིགས་པ་ན།",
    "ཨ་རོལ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོའི་སྐུ་འདྲ་དང་།",
    "གནས་བརྟན་བཅུ་དྲུག་ཁོང་གི་སྐུ་ཚད་ཅན་སོགས་རྟེན་གསུམ་གྱིས་བྱུར་བུར་གཏམས།",
    "བྱམས་ཁང་དུ་བྱམས་སྐུ་ཆེན་མོ་སུམ་ཐོག་ལ་བསྙེགས་པ།",
    "འཇམ་དབྱངས་ཁང་དུ་འཇམ་དབྱངས་ཀུན་གཟིགས་ཀྱི་སྐུ་བརྙན་ཧ་ཅང་ཆེ་བ།",
    "རིམ་གྱིས་གྲྭ་ཚོགས་རྒྱས་པས་ཁོང་ལྷ་སར་ཕེབས་དུས་གྲྭ་བ་ལྔ་བརྒྱར་བུད་འདུགགྲྭ་ཚང་གསར་ཚུགས་ཀྱི་དགི་རྒན་དུ།",
    "ཚོགས་འདོན་རོང་བོ་རྒྱུད་པ་དང་བསྟུན་ལ་གྲྭ་ཚང་གི་འགྲིག་ཕྱག་སྲོལ་རོང་བོ་གྲྭ་ཚང་དང་བསྟུན།",
    "མེ་ཉག་སོགས་བླ་སྤྲུལ་དྲེགས་ལྡན་ཤ་སྟག་གིས་གང་བར་གནས་ཤིང་།",
    "རྟ་ནོར་བརྒྱ་ཕྲག་གི་སྐྱབས་རྟེན་འབུལ་བ་བྱུང་ན་ལྟ་ག་ལ་ཞིགལྷ་སར་ཕེབས་དུས་གདུགས་རྟ་དར་བཅུ་གསུམ་གྱི་ཐོབ་དང་།",
    "སྐུ་འབུམ་ཚོས་ཤོས་སྒར་བ་ནས་བླ་བྲང་བཟུང་སྟེ་བྱམས་པ་གླིང་གི་གསེར་ཁྲི་ལོ་གསུམ་ལ་བསྐྱངས།",
    "རེ་སྐོང་རི་ཁྲོད་པའི་མཚན་ཐོ་རྣམས་རྗེ་འདིའི་ཕྱག་ཏུ་ཕུལ་ཡོད་ཅིང་།",
    "བསོད་རྣམས་ཀྱིས་མ་ཁྱོགས་པ་མིན་ན་ཕྱོགས་འདི་དག་གི་རི་ཁྲོད་པ་རྣམས་ཞབས་བརྟན་མཉམ་འཚོགས་བྱེད་འདུན་ཡང་ཡོད་པས་དེ་ལུགས་ཀྱི་གསུང་ཕེབས་པར་མ་ཟད་གྲ་སྒྲིག་ཀྱང་བྱས་ཟིན།",
    "རྗེས་སོར་འདི་དག་གི་མཚན་ཐོ་དང་།",
    "ཨ་རིག་གིས་བསྡུས་པའི་ལྷ་འབངས་རྒྱ་ཆེ།",
    "ཨ་རིག་ཆན་ཧུ་རྣམས་སྦྱིན་བདག་གི་གཙོ་བོ་ཡིན།",
    "ཝང་བེ་ལི་ཉེར་བཞི་བོ་སོ་སོ་ནས་རང་རང་གི་མིང་རྟགས་ཐམ་ག་ཉེར་བཞིས་རྒྱ་བཏབ་པ་སྔོན་དུས་རྒྱུན་ཀུན་གྱིས་མཐོང་སར་བཀལ་ནས་བཞག་ཡོད།",
    "དེ་ལྟར་མཚོ་སྔོན་ཕྱོགས་ཀྱི་རེ་སྐོང་གི་བསྟན་སྲིད་ཀྱི་མངའ་ཐང་དབུས་མཐའ་མེད་པར་དར་ན་ཡང་།",
    "ཨ་རོལ་བཅས་ཕྱོགས་ཁག་སོ་སོའི་མི་སྣ་ཆེད་དུ་སོང་ནས་རྗེས་དྲན་ད་ལྟའི་ལུགས་བཞིན་ཞུས།",
    "ཁོང་ཨ་རོལ་རྡོ་རྗེ་འཆང་།",
    "གཉན་ཐོགསྒོ་དམོར།",
    "ཁྱད་པར་ཁོང་གི་སྐུ་ཡུལ་ཨ་མ་གནམ་ཁོ་སོགས་ཁྱིམ་ལྔ་ལ་རྟེན་དང་བཅས་པའི་འཚམས་སྐྱེས་གནང་ཞིང་།",
    "ཁྲི་གཤོག་རྒྱལ་མོའི་མཚོ་ལ་ཕེབས།",
    "མཚོ་མཐའ་གཡེར་མོ་ཐང་གི་དཀྱིལ།",
    "སྲིན་པོ་ཁྲག་གི་རལ་བ་ཅན།",
    "ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླགས།",
    "སྲིན་པོ་ཕོ་དོང་མོ་དོང་སོགས།",
    "མར་མེ་དཔལ་འབར་བཟུང་ནས་སོང་གྱུར་ཏེ།",
    "སྟེང་གི་ནམ་མཁའ་དག་ལ་མཇལ་བ་ན།",
    "དེ་ནས་ཕྱིར་བུད་གཡོན་གྱི་ཕྱོགས་སོང་དང་།",
    "མར་མེ་དཔལ་འབར་གསལ་ནས་དེར་སོང་དང་།",
    "རོང་ཆེན་བཞི་དང་ཚོ་བཞི་རང་བྱོན་བཞུགས།",
    "མཐོང་བ་ཙམ་གྱིས་ངན་སོང་སྒོ་མོ་འགགས།",
    "དེ་ནས་ཕྱིར་བུད་སྔར་ལྟར་མར་མེ་དང་།",
    "གོང་དུ་སོང་དང་ཁང་བརྩེགས་གསུམ་ཚད་ལ།",
    "དེའི་གཡོན་དཔལ་ལྡན་ལྷ་མོ་གསལ་བར་བཞུགས།",
    "དེ་ནས་ཕྱིར་ཐོན་སྒོར་སོང་གཡས་གཡོན་གྱི།",
    "རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་གསལ་བར་བཞུགས།",
    "དེར་སོང་མར་མེ་དཔལ་འབར་སོགས་ཁྱེར་ན།",
    "དེ་ནས་སོང་བར་གཤོང་ལ་མཚོ་འཁྱིལ་ཡོད།",
    "དེ་ཡི་ཐུར་ནས་ཡར་ལ་སོང་བའི་དུས།",
    "དེ་ནས་ཕར་སོང་གཡོན་ཕྱོགས་ལོགས་ངོས་ལ།",
    "དེ་ནས་ཡར་སོང་ཕུག་པའི་རྩེ་ངོས་ལ།",
    "ཕུག་པ་ཅུང་ཙམ་ཡོད་པ་དེར་སོང་དང་།",
    "ལམ་གྱི་གཡས་ཕྱོགས་བྲག་གི་ངོས་ལོགས་ལ།",
    "དེ་ནས་ཡར་ལ་རིམ་གྱིས་སོང་བའི་ཚེ།",
    "འགྲོ་བ་གང་གི་ཁོང་དུ་དེ་སོང་ན།",
    "དེ་ཡི་ཕུག་སོང་འདོམ་གསུམ་བབས་མཚམས་ན།",
    "སྟོན་དང་དགུན་དུ་སོང་ན་ཐོན་ཙམ་ཡོད།",
    "དེ་ནས་ཕྱིར་བུད་ལམ་གྱི་སྒོ་འགྲམ་ལ།",
    "ཕར་ཚུར་བྲག་གི་ངོས་ལ་གནས་སྒོ་མང་།",
    "ལམ་ངོ་ཤེས་ཙམ་ཡོད་པ་དེར་སོང་ན།",
    "དེར་བསླེབས་གཡོན་ཕྱོགས་བྲག་ངོས་སྤྱན་རས་གཟིགས།",
    "རིགས་ཀྱི་བུ་ཁྱོད་བདེ་བ་ཅན་དུ་འགྲོ།",
    "ཞེས་གསུངས་ལུང་བསྟན་མོས་ལ་གསོལ་བ་ཐོབས།",
    "རྒྱབ་ཕྱོགས་སྤང་དང་བྲག་གི་སྒོ་མཚམས་སུ།",
    "དེ་ནས་བྲག་གི་གོང་ནས་ཡར་སོང་ན།",
    "གཤིན་རྗེ་ཕོ་དོང་མོ་དོང་འཇིགས་པ་ཡོད།",
    "ངན་སོང་གསུམ་གྲོལ་གདོན་སྲིན་དེ་ལ་འཛུལ།",
    "དེ་ནས་ཡར་གོང་རྩེ་ལ་སོང་གྱུར་ན།",
    "འགྲོ་དུས་ཐལ་མ་གྱུར་པ་ཐོན་པར་བྱང་།",
    "རང་བྱོན་ཡིག་འབྲུ་རང་གིས་བལྟས་ན་གསལ།",
    "གཡོན་གྱི་ཕྱོགས་ན་སྤྲེལ་མོ་བྲག་ཅེས་པ།",
    "མོ་རི་དཔའ་མོ་རྣམས་ཀྱི་བཞུགས་གནས་ཡིན།",
    "གཡོན་གྱི་ཕྱོགས་སུ་བཙུན་མོ་བྲང་དམར་མ།",
    "མ་འོངས་པར་ཁྱོད་བཞུགས་ས་ཞིག་ཀྱང་ཡོད་ན་བཟང་།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་ཁོང་གི་བཀས་ཉན་པོ་དཀའ་བཅུས་གཞི་བཟུང་།",
    "རྗེས་སོར་ཁྲི་རྒན་རང་ཉིད་བཀྲ་ཤིས་འཁྱིལ་ནས་བཞུགས་མ་བདེ་བར་དགོན་འདིར་ཕེབས་ཏེ་གདན་ས་གསར་བ་བདག་གིར་བཞེས།",
    "དམ་པ་འདི་ཉིད་རེ་སྐོང་བསེ་ཉ་ལུང་ནས་འཁྲུངས།",
    "ཁོང་དགུང་ལོ་ཧ་ཅང་མི་མཐོ་བ་ཞིག་གི་སྐབས་མྱ་ངན་ལས་འདས་པའི་གདུང་རྟེན་དགོན་ཆེན་དུ་བཞུགས།",
    "ཚོགས་མཆོད་ལ་དངུལ་ཊཾ་འགྱེད་དང་སྒོ་མང་ལ་སྲང་རེའི་འགྱེད།",
    "འདུ་ཁང་སྟེང་དུ་དངུལ་སྲང་སྟོང་གིས་བསྒྲུབས་པའི་གསེར་གྱི་རྒྱལ་མཚན་ཆ་བཞགཏཱ་དབོན་ཁང་ཚན་ལ་འཇོག་པ་དང་སྒེར་འགྱེད་བསྟབས།",
    "བྱ་ཡུལ་བའི་གདན་ས་མང་རར་བཞུགས་པའི་དྲུང་དུ་ཨུནེ་ཝང་གིས་ཨེལ་ཆི་བཏང་སྟེ་གདན་འདྲེན་ཞུས།",
    "མི་ཏྲ་རྡོར་ཕྲེང་གི་དཀྱིལ་ཐང་ཐམ་ག་གྲུ་སྒོར་སོགས་ཐོན་ཕྱག་ཏུ་བསྩལ།",
    "ཚོགས་སུ་དངུལ་ཊོ་རེའི་འགྱེད།",
    "རབ་བྱུང་བཅུ་གསུམ་པའི་ལོ་གཉིས་པ་ས་འབྲུག་ནག་ཟླར་མཆོད་ཡོན་ཆབ་ཚན་གྱི་ཞོར་གནས་འདིར་ས་བརྟག་བསླང་སོགས་མཛད་དེ་གཙོས་བླ་བྲང་གི་གཞི་བཟུང་།",
    "དེ་ནས་བཟུང་ཁྲི་ཆེན་སྐུ་ཕྲེང་གི་ཕྱག་མཚན་དུ་གྱུར།",
    "རྗེས་སོར་མཆོག་གི་སྤྲུལ་པའི་སྐུ་ཁ་སོ་བློ་བཟང་འཇིགས་མེད་འཕྲིན་ལས་དང་།",
    "སྔོན་པཎ་ཆེན་གོང་མ་རེ་སྐོང་ཕྱོགས་སུ་ཕེབས་དུས་རོང་བོ་ལྷ་བཙུན་ཆེན་པོ་ཞི་དྲག་གི་དཔུང་དང་བཅས་རང་གི་ས་ཆ་ལས་མ་བརྒལ་བར་སྐུ་སྐྱེལ་ཞུ་རྒྱུ་ཡིན་གསུངས་ནས་མཛོད་དགེ་སྣ་བར་ལྷག་ལ་བསྐྱལ་བ་ན།",
    "རོང་བོ་ཚང་ཁྱོད་ལ་ས་ཁུངས་ཇི་འདྲའི་རྒྱ་ཆེན་པོ་ཞིག་ཡོད་ཨང་།",
    "གྲྭ་བ་ཞྭ་ཟླམ་གྱོན་པ་མང་བོས་ངེད་ཚོའི་ས་ཆར་ཁྱོད་ཀྱིས་ཅི་བྱེད་ཅེས་ཞྭ་ལག་གིས་བརྡེག་གྲབས་བྱེད་པའི་མཚན་ལམ་དང་།",
    "རྗེ་འདིའི་ཞིང་ཁམས་ཐུན་མོང་མ་ཡིན་པར་གདོན་མི་ཟའོ།",
    "གཞན་སྒར་བ་བརྒྱད་ཀྱིས་ལྔ་མཆོད་རེས་མོས་སུ་གཏོང་།",
    "ད་དུང་རོང་བོ་ཚང་གི་རྒྱུད་ཀྱང་ཡོད་དོ། ། ཙག་ཙག་སྒར།",
    "ཞལ་དཀར་སྐུ་ཕྲེང་གི་གདན་ས་སྟེ།",
    "རོང་བོ་ནང་སོ་ཚང་གི་རིགས་རུས་སུ་འཁྲུངས།",
    "བསེ་ཚང་དང་འདི་རྣམ་གཉིས་ཀྱི་སྐུ་ཕྲེང་གིས་གཏེར་ལུང་སྐྱོང་ཁུར་བྱེད་རེས་ཀྱི་སྲོལ་ཡོད། ། གཉའ་གོང་བྲག་དཀར་དགོན།",
    "ཁ་གྱ་ཚོ་དྲུག་གི་ནང་ཚན་རྒན་གྱའི་གཞུང་གི་ཆར་གཉའ་གོང་བྲག་དཀར་སྒྲུབ་གནས་སུ་ཡོད་ལ།",
    "སྒྲུབ་ཁང་སྟེང་གི་བྲག་ངོས་སུ་དཔལ་འཁོར་ལོ་བདེ་མཆོག་ལྷ་རེ་གཉིས་ཀྱི་དཀྱིལ་འཁོར།",
    "དེ་ནས་བཟུང་རིམ་བཞིན་རྗེ་ཉིད་ཀྱི་སྐུ་ཚབ་རེ་བསྐོས་ཏེ་ད་ལྟའི་བར་བསྐྱངས།",
    "སྤྱན་རས་གཟིགས་རྣམས་བཞུགས་པའི་སྣང་བ་ཤར།",
    "སྟོང་འཁོར་ཡོན་ཏན་རྒྱ་མཚོས་ཡུལ་ཉེར་བཞིའི་དཔའ་བོ་དང་དཔའ་མོ་རྣམས་སྤྲིན་ལྟར་འདུས་ནས་ཚོགས་འཁོར་མཛད་པ་དང་།",
    "ཕྱི་རོལ་ཏུ་དུར་ཁྲོད་ཆེན་པོས་བསྐོར་བར་གཟིགས།",
    "འདི་མགོ་ལོག་གི་ཇག་པས་གཙེས་པས་གནས་སྤོར་བ་ལ་མཆོད་རྟེན་སྐྱག་ཟེར་ཏེ་རྗེ་མ་ཎི་བ་ཤེས་རབ་བཀྲ་ཤིས་ཀྱིས་བསྐྱངས་སོ།",
    "གོང་ས་སྐྱབས་མགོན་ཐམས་ཅད་མཁྱེན་གཟིགས་མཆོག་གི་སྐུ་གདུང་མཆོད་རྟེན་དང་བཅས་པའི་ལྷ་ཁང་རྟེན་བརྟེན་པ་ཡང་གསར་བཞེངས་སྒོ་ཀུན་ནས་ཡོངས་སུ་རྫོགས་པ་དང་།",
    "རྒྱུད་པའི་སྤྱི་ཁང་དང་སྤོང་ཁང་འགའ་རེ་ཡང་བརྩིགས་པ་དང་།",
    "ཨེ་མ་ཐུགས་བསྐྱེད་རྒྱ་ཁྱོན་དང་བྲལ་རྣམས།",
    "རེབ་གོང་ཟེར་བ་ནི།",
    "རེབ་ཁ་སོ་གཉིས་བྱུང་བའི་རེབ་ཁ་སོའམ་རེབ་སའི་མིང་དེ་ལས་རེབ་གོང་ཞེས་ཐོགས་པར་གྲགས་ལ།",
    "ཡོངས་གྲགས་སུ་རེབ་གོང་མ་ཆགས་རེབ་ས་ཆགས་ཟེར་བ་ཡང་ཕྱོགས་མཐུན་ནོ།",
    "རེ་སྐོང་གསེར་མོ་ལྗོངས་ཟེར་བ་ནི།",
    "རེ་སྐོང་སྨད་ཕྱོགས་ཀྱི་དཀར་རྩེ་གདོང་དུ་གྲགས་པའི་རི་རྒྱུད་ཨ་རྒྱལ་རིའི་སྟེང་ལ་གོ་མས་མི་ཉག་རྒྱལ་བོ་སྐུ་མཁར་བརྩིགས་པའི་སྐབས།",
    "ས་འདི་ལ་བཏང་བའི་བཀའ་ཡིག་ཏུ་རེ་སྐོང་གསེར་མོ་ལྗོངས་ཞེས་གནང་འདུག་པ་དེ་ནས་བཟུང་ཚུལ་དེ་ཤེས་པ་རྣམས་ཀྱི་ངག་ལས་དར་སྤེལ་བྱུང་ལ།",
    "གུང་སོགས་མང་ན་ཡང་སྐབས་འདིར་ཡུལ་ཕྱོགས་སྤྱིས་ངང་གིས་བཀུར་བའི་སྤྱི་དཔོན་ལ་བརྗོད་པ་ཡིན་ནོ།",
    "ཁོང་རང་གི་རྒྱུད་ལ་ཁོང་ཡབ་ཡུམ་གཉིས་དང་།",
    "སྲས་འབྲིང་བོ་ལ་གཅན་ཚའི་རིགས་ཀྱི་བུ་མོ་ཞིག་ཆུང་མར་བླངས་པ་ལ་རིགས་རྒྱུད་མ་བྱུང་།",
    "དེ་ནས་སྲས་ཆུང་བ་ཚེ་རིང་འབུམ་གྱི་བཙུན་མོར་རེབ་སའི་རིགས་སུ་འཁྲུངས་པའི་རེབ་རོང་བ་བསྟན་པ་རྒྱལ་མཚན་གྱི་བུ་མོ་ཞིག་བླངས།",
    "རེབ་རོང་བ་བསྟན་པ་རྒྱལ་མཚན་ནི་རྒྱལ་མོ་རོང་ནས་ཆད་པའི་བོད་ཀྱི་རྒྱལ་བོའི་དམག་དཔོན་ཞིག་གིས་ཁྲི་ཀ་ནས་མོའུ་གྲོང་དཔའ་ཟེར་བའི་ཆུང་མ་ཞིག་བླངས་ཏེ་གཞི་ཕབ་ནས་བསྡད་པ་ལ་སྲས་གཅིག་སྐྱེས་པ་ནི་རེབ་རོང་བ་བསྟན་པ་རྒྱལ་མཚན་ཡིན།",
    "རེབ་རོང་བ་བསྟན་པ་རྒྱལ་མཚན་གྱི་སྐབས་སུ་སན་ཀྲོའུ་ཟེར་བའི་དམག་དཔོན་གྱི་དམག་དཔུང་ཐག་ཁྲིག་དམག་ཟེར་བ་ལ།",
    "བོད་ཀྱིས་སྟོད་གོས་ལྟག་ཐུང་གི་དམག་ཟེར་བ་ད་ལྟའི་ཐག་ཐིག་ཐང་ཞེས་འབོད་པའི་སར་མཁར་ཉིས་རིམ་བསྐོར་ནས་གཞི་བཟུང་བ་ལ་རེབ་རོང་བ་བསྟན་པ་རྒྱལ་མཚན་གྱིས་མཐར་དམག་མཁར་གཅིག་བསྐོར་ཏེ་དམག་རྣམས་མཐར་བསྐྲད་པས་མཁར་དེ་ལ་མཁར་སུམ་བརྩེགས་ཟེར་ཞིང་རོང་ཆུང་རྐང་ཟམ་ཡན་ཆད་དང་གཙང་རིའི་ལྕགས་འཕུར་མན་ཆད་ཀྱི་ས་མཚམས་སྐབས་དེར་བཟུང་བ་ཡིན།",
    "རེབ་རོང་ས་སྐྱའི་མི་རིགས་བཅས་ཕྱོགས་ཁ་བཞི།",
    "དེའི་ཕྱི་མ་གང་རུང་ཡིན་དགོས་འདུགདེས་རྨ་ཆུ་སྔོན་མོའི་ནང་ལོགས་ནས་ཤར་ནས་ནུབ།",
    "ལྷོ་ནས་བྱང་གྱེན་སློང་གི་ཀ་བ་ཐད་འཇོག་གི་གདུང་བ་ལྟ་བུའི་སྤྱི་དཔོན་རོང་བོའི་ནང་སོའི་བཀའ་བཀུར་དགོས་ཞེས་པའི་ཡི་གེ་དང་།",
    "ལྷོ་བསང་གི་གུང་སྔོན་སྒྲོག་གི་ཚུན་ཆད།",
    "གཙང་ལ་སྟོད་ཀྱི་ལྷ་བཟོ་སོགས་ལག་རྩལ་ཅན་མང་བོས་ལོ་གཅིག་དང་ཟླ་གཅིག་ཉིན་གཅིག་གི་རིང་ལ་ཀ་མགོ་སུམ་བརྩེགས་ཅན་གྱི་ཡ་མོན་གྲུབ།",
    "ལྗོངས་གླིང་ཆེན་བཙུན་མོ་མཚན་བཟང་།",
    "ཚུལ་འདི་ནི་རེ་སྐོང་གི་འཇིག་རྟེན་ཕྱོགས་ནས་རྒྱས་པའི་ཕུན་སུམ་ཚོགས་པའི་སྒོ་དང་བོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དཔོན་པོ་འབུམ་ཡག་རྒྱལ་གྱི་རེ་བ་ལྟར་ནང་ལུགས་ཀྱི་ས་བགོས་གནང་སྟེ་སྟོད་ནས་རྡོ་དམར་ལྟེ་ཕུར་བར་ནས་དཀར་མཛེས་གད་པ་སྐྱ་རེངས་དང་།",
    "བྱ་རུང་ལུང་བ་སྟེ་དགུ་རོང་གི་ལུང་བ་ནས་དགུ་རོང་གི་ཚུན་མངའ་འབངས་ཀྱི་མཚམས་སུ་གནང་།",
    "ཚོགས་ཁག་འདི་དག་གི་ཐ་སྙད་བརྗོད་སྐབས་ཀླུ་རྒྱལ་དཔལ་དང་ཚེ་རིང་འབུམ་གཉིས་འདས་སོང་ཡང་།",
    "སྤྱི་དཔོན་ཆེན་མོས་བྱམས་སྐྱོང་གནང་བ་ཡིན་ལ།",
    "གོང་གི་འདི་ཚོ་མཐའ་གཅིག་ཏུ་ཡིན་དགོས་པའི་ངེས་པ་མེད་ལ་སྐད་ཆའི་ཟུར་ཀྱང་ཆག་ཡོད་པས་ད་དུང་དཔྱད།",
    "བྱང་སྟོད་ནས་ཇོའུ་ལོ་ཧོར་མོ་ཁ་གསུམ།",
    "ཡུལ་སྐད་ལ་རྒྱལ་བོར་གནམ་གོང་མ་ཞེས་རང་གི་སྤྱི་དཔོན་ལ་ཞེ་ས་འབུལ་ཚུལ་ཞིག་ཡིན།",
    "འདི་ནི་སྔོན་གོང་མ་ཐང་ཐེ་ཙོང་གིས་བློན་ཆེན་མགར་སྟོང་བཙན་ལ་རྒྱ་ནག་རང་དུ་གཡིའུ་གཡུ་ཐེའེ་ཇུང་གུན་ཟེར་བའི་འཇའ་ས་སྤྲད་པ་དང་ཀུན་ནས་མཚུངས་སོ།",
    "གོ་སའི་ལས་ཐོབ་ཕལ་ཆེར་ལེན་མཁན་དེ་དང་དེའི་རང་གི་ཡུལ་ཕྱོགས་ནས་མཐོ་བའི་གོ་གནས་སུ་བྱེད་ལ།",
    "སྤྱི་ལོ་བརྒྱད་བརྒྱ་རེ་དྲུག་ནས་དགུ་བརྒྱ་གཅིག་གི་བར་ཁྲི་རལ་བ་ཅན་གྱིས་རྒྱལ་སྲིད་སྐྱོང་སྐབས་ཡིན་པ་དང་།",
    "ཚུལ་འདི་དག་གི་སྤྲོས་པ་གཞན་དུ་འགོད་པར་འདོད་དོ།",
    "ཞེས་ཟུར་རྒྱན་ཅུང་ཟད་དང་བཅས་པ་ནི་རོང་བོ་ཚང་གི་ཕུན་སུམ་ཚོགས་པའི་སྒོ་གཉིས་པ་ཞེས་བརྗོད་པར་བྱའོ། ། དེ་ཡང་གསེར་ལྗོངས་རྒྱལ་ཐང་དུ་རོང་བོ་མཁར་འབུམ་རྒྱལ་ཞེས་མིའི་རྗེ་བོར་འོས་པའི་ཡོན་ཏན་དང་ལྡན་པ་དེ་ལ་ཆུང་མ་གླིང་རྒྱ་བཟའ་འཁོར་མོ་སྐྱིད་དང་།",
    "རྒྱ་ནག་རྒྱལ་བོ་དང་ཐུག་འཕྲད་ཞུས་དུས་གོང་མ་ཏཱ་མིང་གི་རྒྱལ་རབས་མཇུག་རྫོགས་ནས་གོང་མ་ཏཱ་ཆིན་ཤུན་ཀྲི་ལ་འཕྲད་པས་གོང་མས་བ་སོའི་ཐམ་ག་གནང་།",
    "ཁོང་གིས་ཚེ་སྐུ་བྱིན་ཅན་གནང་བ་རྗེས་སོར་རོང་བོ་ཤིང་ལེ་ཁའི་འདུ་ཁང་དུ་བཞུགས།",
    "དེ་དག་གིས་འབུལ་བ་མང་དུ་ཕུལ།",
    "རོང་རྒན་ཁྲི་ཆེན་ཚང་ལ་བསྙེན་བཀུར་མཐའ་འཁྱོལ་པ་བྱས་ཤིང་དུས་རྒྱུན་རོང་བོ་ཚང་གི་ནང་ཆེན་ནས་མཉམ་བཞུགས་ཀྱིས་བསྐྱངས།",
    "ནང་སོ་ཀླུ་རྒྱལ་ཚེ་རིང་གིས་རོང་བོའི་ནང་སོ་ཁུར་བའི་སྐབས་སུ་ནང་སོ་བཙན་པོ་མ་མར་ནང་ནང་སོ་དང་ནང་སོ་རྒྱུ་སྡང་གིས་རྡོ་སྦིས་ནང་སོ་ཁུར།",
    "རོང་བོའི་སྐྱ་སེར་རྣམས་ཀྱིས་གྲོས་བྱས་པ་ལྟར་ནང་སོ་རེས་མོས་བྱས་ནས་ལོ་ལྔ་ནས་ལོ་གསུམ་བར་སྐྱོང་ཁུར་བྱེད་དགོས་པའི་གྲོས་ཐག་བཅད།",
    "དུས་འདི་ཙམ་ན་ནང་སོ་ཆོཏི་ཟེར་བའི་མཁས་པ་ཞིག་ཀྱང་ཡོད་ཚོད་རེད།",
    "དེ་ནས་རྨ་ཆུའི་ནང་ལོགས་ལ་བཀའ་ཕབ་པ་ལྟར་རེབ་གོང་ཕུ་སྟོད་སྨད་ལ་དམག་བརྡ་བརྒྱབ་པའི་རྗེས་ནས་མི་གཅིག་མ་འོངས་ན་མཛོ་མོ་བཅུ་ཡི་ཆད་པ་གཅོད་པ་དང་།",
    "ངའི་བཀའ་དང་དུ་མ་བླངས་ན་དྲག་པོའི་དམག་དྲངས་ཏེ་ཐལ་བའི་རྡུལ་དུ་བརླག་རྒྱུ་ཡིན་ཞེས་བསྒྲགས་པ་ལྟར་དམག་དྲངས་ཏེ་མཚོ་མགོར་གསེར་མགོ་ཟེར་བའི་ས་དེར་དམག་སྒར་བརྒྱབ།",
    "བློན་པོ་གསེར་ཆེན་གྱི་རྩེ་མོ་ནས་ལྷ་བསང་ཕུལ།",
    "བྱང་ཕྱོགས་ཟིལ་གྱིས་མནན་པས་སྒོ་མོའི་ཕྱོགས་ནས་འབུལ་བ་སྣ་ཚོགས་འབུལ་བ་བྱུང་།",
    "དུས་སྐབས་ཤིག་ལ་ནང་སོ་ཐུབ་པ་རབ་གསལ་ཁ་ནག་གི་གཅུང་དོན་འགྲུབ་ཆང་འཐུང་ཟེར་བ་དེ་ལ་བིས་པ་རྡོ་རེ་ཆང་འཐུང་ཟེར་བའི་གྲོགས་པོ་ཞིག་ཡོད།",
    "དེ་ནས་གཅུང་བསད་པའི་སྡིག་བཤགས་ལ་དབུས་སུ་ཕེབས་པའི་ལམ་བར་དུ་སོག་དམག་གིས་བཀག་པར་ནང་སོ་རང་ཉིད་གཙོས་རྗེས་འབྲངས་པ་རྣམས་ཀྱིས་སོག་དམག་ཆམ་ལ་ཕབ་སྟེ་དབུས་སུ་འབྱོར།",
    "རེབ་གོང་ཕུ་སྟོད་སྨད་རྣམས་ལ་གསེར་དངུལ་གྱི་བབ་བསྟུན་བཞག་པའི་ནོར་རྣམས་ཁྱེར་ཏེ་གཙོས་སྤེན་མཁར་དགུ་ཐོག་བཞེངས།",
    "རབ་བྱུང་བཅོ་ལྔ་བའི་ཆུ་ལུག་ལོར་སོག་པོ་ཆིང་ཝང་དང་མ་མཐུན་པར་རེབ་སོག་གཉིས་འཁྲུགས་པའི་རྐྱེན་ངན་ཆེན་པོ་བྱུང་།",
    "ལྕང་ལུང་ཁྲི་རྒན་ཚང་གི་དུས་སུ་ནང་སོ་འཕྲིན་ལས།",
    "ནང་སོ་རྒྱ་སྡང་གི་རྒྱུད་ཡིན།",
    "ཁོང་གི་ཕ་མཆོག་གསུམ་སྐྱབས་ལ།",
    "དམག་ལ་ཆས་སྐབས་ཤིག་གཞུང་གི་མགོན་ཁང་ནང་མའི་སྙན་དར་གྱི་ཁྲོད་ནས་རྟ་ལྕག་ཅིག་འདིའི་མདུན་དུ་ལྷུང་བར་གྲགས།",
    "བྱང་སྐྱབས་ཀྱི་ཕ་ཨ་ཁུ་ཨ་མྱེས་སྐྱབས།",
    "དེའི་རྗེས་ནས་རྒྱ་ཙ་ཐོ་ལན་ཀྲང་ཟེར་བ་ཞིག་གིས་གནོད་པ་བྱས་ནས་མཐར་རེབ་གོང་མི་དམངས་ཀྱི་དོན་དུ་དཔའ་སྟོབས་འགྱུར་མེད་ཀྱི་ངང་ནས་རང་སྲོག་བློས་བཏང་བ་རེད།་",
    "འདིའི་ཨ་ཁུ་ནང་སོ་ཚེ་རིང་འབྲུག་གིས་སྐྱོང་སྐབས།",
    "རང་ཉིད་ཨ་རོལ་རྡོ་རྗེ་འཆང་གི་མདུན་ནས་རི་ཁྲོད་ཀྱི་སྐྱབས་འཇུག་ཞུས་པར་རྗེ་དེ་ཉིད་ནས་རེ་སྐོང་རི་ཁྲོད་པའི་གྲལ་མགོ་ནས་གདན་ཁྲི་གཅིག་གིས་བཀུར་བཟོ་གནང་།",
    "སྤྱི་དཔོན་ཆེན་པོས་རི་ཁྲོད་མཛད་པ་རེ་སྐོང་འདིར་ཁྱོད་གཅིག་ཁོ་ན་ཡིན་པས་ངོ་མཚར་ཆེ་གསུངས་ལ།",
    "འདིས་མཁར་སྒོའི་ཇོ་ཁང་ཆེན་མོ་གསར་དུ་བཞེངས།",
    "རང་སྲོག་བློས་བཏང་གིས་དགོན་ཆེན་སྲུང་སྐྱོབ་བྱས་ཏེ་ཇག་དམག་གི་ཉེན་ལས་བསྐྱབས།",
    "དེ་ད་དུང་ཡང་སྔོན་གྱི་ཡབ་མེས་གོང་མ་རྣམས་ཀྱི་བཀའ་འབངས་སུ་གཏོགས་ཚད་ཀྱི་རེ་སྐོང་སྤྱིའི་ཤོག་ཁ་དེ་ལ་ཡོངས་གྲགས་སུ་གཤོག་ཆེན་བཅོ་བརྒྱད་ཅེས་གྲགས་ཤིང་ཕྱི་ཤོག་ནང་ཤོག་གཉིས་སུ་ཕྱེ་བའི་ཕྱི་ཤོག་ཀྱང་ཟེར་རོ།",
    "༡ མར་ནང་ཚོ་ལྔ།",
    "རེབ་ས་ཚོ་བཞི།",
    "རེབ་ས་སོགས།",
    "༩ འབོ་ར་ཨ་མཆོག་སྐྱི་ཁ་གཉིས།",
    "༡ རྟ་བོ་དམེ་ཚང་ཚོ་བ་བཅུ་གཉིས།",
    "༡༡ ཨ་གྲོང་ཤོག་བཅུ་གཙང་ཚོ་དྲུག་༡༢ གཙང་ཁ་བཅུ་གཅིག་༡༣ རྨ་ཁ་ཚུར་གྱི་ཤ་སྦྲང་ཚོ་བཅུ་གཉིས།",
    "༡༥ སོག་པོ་མདའ་བཅུ་གཅིག་༡༦ མཚོ་སྔོན་ཕྱོགས་ཀྱི་ཉིན་ལུང་ཚོ་བ་བཅུ་གཉིས་དང་བོང་སྟག་སོགས།",
    "ལོར་རེ་སྐོང་ཀྲིག་གི་ཀྲིག་ཀྲང་ལ་བསྡད།",
    "འུ་ཅག་གིས་ཕན་ཚུན་གདུང་རྩིས་བྱེད་དགོས་ཚུལ་སོགས་ཀྱི་ཞལ་གསུང་གནང་།",
    "ཕལ་ཆེ་བས་ནི་ལོ་བདུན་རེར་བསྐྱངས་པའི་ལམ་སྲོལ་བཞིན་ཕེབས་པ་ཡིན་ཙ་ན་རེ་སྐོང་གི་ལུགས་གཉིས་ཀྱི་སྟེང་ཕྱག་རྗེས་མེད་པ་ག་ལ་སྲིད།",
    "དེའི་ཕྱིར་རེ་རེ་ལ་ཡང་རུས་མིང་དང་།",
    "རོང་བོ་ཚང་ལོས་མཐོ་ཞུས་པར་དེ་རེད་མོད།",
    "ཀུན་མཁྱེན་འཇིགས་མེད་རྒྱ་མཚོ་སེངྒེ་གཤོང་དུ་ཕེབས་ལམ་དགོན་ཆེན་མདུན་རིའི་སྟེང་ནས་ཆིབས་བཤོལ་ནས་ཕྱོགས་ཐམས་ཅད་ལ་གཟིགས་ཏེ་ཞལ་ནས།",
    "ད་དུང་མཚལ་དཔར་དང་མཚལ་བྲིས་ཀྱི་ཡུམ་དག་ཚར་རེ་རེ།",
    "མཐའ་སྐོར་དུ་དཔག་བསམ་འཁྲི་ཤིང་གི་ཐང་གགནས་བཅུ།",
    "འཇའ་མོ།",
    "གླིང་རྒྱུ་བཞི་ལ་རེ་སྐོང་ནང་ལོགས་ཀྱི་ཕྱོགས་བཞིའི་སྒོ་སྲུང་དུ་གྲགས།",
    "འཇིགས་མེད་གོང་མ་ཚང་གི་ཡོངས་འཛིན་དགའ་བྱང་ལྷ་རམས་པ།",
    "སྐྱི་ཕྲུག་ཚང་གི་ཡོངས་འཛིན་ཨ་ལགས་རྒྱ་མཚོ།",
    "རྒད་པོ་བསྟན་འཛིན་ཟེར་བ་ཞིག་གིས་ནག་ཟླའི་ཉར་གོས་དཀར་གསར་བ་གྱོན།",
    "ལག་ཏུ་རུ་མཚོན་བཟུང་ནས་དུས་འཁོར་སྦྱིན་སྲེག་གི་དུང་བརྡ་བཏང་བ་དང་མཉམ་དུ་ངར་སྐད་ལན་གསུམ་བསྒྲགས་ཏེ་ང་ཤམྦྷ་ལར་འགྲོ་རྒྱུ་ཡིན་ཟེར་བཞིན་འགྲེང་ནས་གྲོངས་པར་གྲགས་སོ།",
    "གཡུ་ཐོག་གསུམ་ལ་རེ་སྐོང་གི་གཉན་པོ་ཁ་གསུམ་དུ་གྲགས།",
    "ཁོང་ལ་ཏཱ་མིང་གོང་མས་གཟིགས་པ་ཆེ་ཞིང་སེངྒེའི་ཐམ་ག་བསྩལ་བས་ཁོང་གི་གདན་ས་འཛིན་པ་རྣམས་ལ་སེངྒེའི་མཚན་ཟུར་ཆག་ཡོད་པ་དང་།",
    "གཡང་ཊིའི་ཐམ་ག་དེ་ནི་སྟག་ཚང་ལྷ་མོའི་གསེར་ཁྲིའི་ནང་ཆེན་དུ་ཉེ་རབས་བར་དུ་བཞུགས།",
    "འབྲོག་གི་སར་ཡོད་པའི་རོང་བོ་ཚང་ལ་སྦྲ་དཀར་སྦྲ་ནག་བཙལ་ཏེ་ཁག་ཆེན་པོ་གསུམ་ཡོད་ལ།",
    "དཔོན་མོ་རྣམ་རྒྱལ་སྒྲོལ་མ་སོགས་ཀྱིས་དད་འདུན་ཆིག་དྲིལ་ངོས་དབུ་བླར་གདན་དྲངས།",
    "ཉིད་ཀྱི་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་ཉམས་བཞེས་ཀྱིས་ཡུན་རིང་བཞུགས་འཇགས་མཛད་པའི་བར་སྐབས།",
    "འབྲོག་ཕྱོགས་ནས་འཁོར་དྲུང་རྒྱ་བསྐྱེད་མཛད་པ་ནི་རོང་བོ་དཔོན་ཚང་གི་རྒྱུད་འབྲོག་ཏུ་སྤེལ་བའི་ཐོག་མ་ཡིན།",
    "དེ་ནས་རྩེ་གཞུང་དུ་བཞུགས་སྒང་རྡོ་རྗེ་ཕག་མོ་དངོས་སུ་ཕེབས་ཏེ་རྒྱུད་གྲྭ་འཛུགས་པར་བསྐུལ་ནས་རྩ་རྒྱུད་ཀྱི་གླེགས་བམ་ཕུལ།",
    "མཆོད་འཐེབ་ཏུ་སྦྲ་གུར་འདྲེས་མ་ཅན་གྱི་བོད་སོག་གི་ཁྱིམ་མང་བོ་ཤ་བི་ནར་རང་གི་མཚེར་ས་ན་མོ་ཝན་ཆུང་བ་དང་བཅས་ཕུལ་བ་དང་།",
    "ཤ་བི་ནར་བོད་སོག་གོང་དུ་བསྡད་ཀྱང་ཚྭ་བཀག་མེད་ཚུལ་གྱི་ཡི་གེ་རིམ་པ་མང་བོ་ཕུལ་བས་སྦྱིན་བདག་ཐམས་ཅད་ཀྱི་ནང་ནས་མཆོག་ཏུ་གྱུར་པ་ལྟ་བུར་སོང་།",
    "སྔོན་ནས་དཔོན་པོ་དང་ཙ་གི་སོ་སོ་ནས་འཇོག་པ་དང་།",
    "དེས་མི་ཚད་ལྷ་གུར་རྟེན་བརྟེན་པ་མཆོད་གནས་སུ་གནང་བའི་ནང་སྟེན་དུ་ཁོང་གིས་ཡི་དམ་རྡོ་རྗེ་འཇིགས་བྱེད་ལྷ་བཅུ་གསུམ་གྱི་གཙོ་སྐུ་ལ་སམ་ཁྲུ་ཚད་ཙམ་དང་།",
    "རེ་སྐོང་གི་སྤྱི་དཔོན་ནང་སོའི་གོ་ས་ཡང་བཟུང་བས་ཆོག་སྟེ།",
    "ཨ་ལགས་འཇའ་མོ་ཚང་ཡང་འཁྲུངས།",
    "སྦྲ་ནག་ཆུ་མའི་དོ་དགིསྐབས་དེར་ཨ་ལགས་བཀྲ་དགེ་ཁམས་ཕྱོགས་ནས་ཕེབས་ཏེ།",
    "ཁོང་གིས་རེ་སྐོང་སྔགས་མང་གི་ཁྲི་བསྐྱངས།",
    "ཁོང་གི་ཆིབས་རྟའི་ཐོང་སྡོམ་བཅས་གནང་སྟེ།",
    "ས་སྐྱ་བདག་ཆེན་མདུན་ནས་གདན་དྲངས་པའི་ཙན་དན་གྱི་གུར་སྐུ་བཙན་པོ་མ་དེ་ཁོང་གིས་ཕྱག་ཏུ་བསྣམས་ཏེ།",
    "གཏེར་ལུང་ཐང་ནས་བླ་སེར་དང་འབངས་རྣམས་ལ་ཤར་བླ་བྲང་གིས་གུར་སྒར་བཏབ་པའི་སྟེང་སྐྱབས་མགོན་ཁོང་དང་ཁྲི་རྒན་ཚང་བཞུགས་པའི་སྐབས་དེར་མཇལ་ཁ་ཞུས།",
    "སྐབས་དེར་ཁོང་གིས་ལྷ་གུར་ལ་གཉེར་གཏད་མཛད།",
    "འཇའ་མོ།",
    "ཆུ་དང་འབུད་ཤིང་ཡང་སྟེར་དགོས།",
    "རྒྱུ་རྫས་དང་ནོར་ལུག་གི་རིགས་གང་ཡོད་ཚོ་བ་འདིའི་བདག་བྱེད།",
    "རོང་བོ་མི་སྐྱ་ཚང་གི་སྤྱི་བ།",
    "དུས་བཟང་གི་མ་ཎི་སོགས་མ་ཉམས།",
    "སྲོལ་རྒྱུན་ལ་ཤར་བླ་བྲང་གི་སྒར་ཁ་ཕེབས་སྐབས་སྐྱེས་པ་རྣམས་ཀྱིས་ཆུ་རྐ་བརྐོ་བ་དང་བཞུགས་གུར་ཕུབ་པ་སོགས་དང་།",
    "སྐྱེས་མ་རྣམས་ནས་གསོལ་ཐབ་དང་ཤིང་གི་ཐབ་ཆེན་གྲུབ་རྗེས་གཉེར་བ་ནས་གསོལ་རས་འདོད་པ་བཞིན་སྟེར་སྲོལ་དང་།",
