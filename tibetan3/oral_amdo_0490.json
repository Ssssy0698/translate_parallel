    "བྱིན་བརླབས་ཚེ་འཕོས་རྒྱལ་རིགས་བུ་མོར་སྐྱེས།",
    "དུག་ཅན་ཟས་ལ་མགྲོན་གཉེར་མེ་དོང་གི།",
    "བསྲེགས་པ་ལས་སྐྱེས་གང་གིས་འབྱོར་པའི་ཚོགས།",
    "ལྷ་མཆོག་ལྷ་ཡི་དོན་མཛད་འཛམ་གླིང་གི།",
    "གྱད་སྟོབས་སྟོང་གིས་མ་བསྐྱོད་རྡོ་མོ་ཆེ།",
    "ཞབས་མཛུབ་ཀྱིས་ཕྱུང་ཕྱག་གིས་རིང་དུ་འཕངས།",
    "ཉིན་མཚན་བདེ་སྡུག་འབྲས་བུ་རེ་མོས་སྤྱོད།",
    "རྣམ་པར་རྩེན་པའི་བུ་བཙས་ཨ་མྲ་སྐྱོང་།",
    "རྩྭ་འཚོང་གིས་ཕུལ་ཀུ་ཤ་བཀྲམ་སྟེངས་སུ།",
    "མོང་གལ་བུ་ཡི་སྐལ་ལྡན་ཤིང་རྟ་དེ།",
    "རོ་བརྒྱའི་བཤོས་ཕུལ་སྟོན་པར་བསྟབས་ལྷག་གིས།",
    "བདེན་པའི་ཚིག་གིས་རྣལ་གནས་ཀཱཤི་མཛེས།",
    "མོང་གལ་བུ་ཡིས་སྒྱུ་འཕྲུལ་ཀླུས་བཅིངས་ཚེ།",
    "རབ་བྱུང་དགྲ་བཅོམ་ཚོང་པ་གྲུ་འཇིག་གིས་། གསོལ་བཏབ་འཕྲལ་ལ་འཇིགས་བསྐྱབས་གང་པོ་མཆོག།",
    "རྒྱལ་སྲིད་འབྱོར་པའི་ཀཱ་ཤི་མཛེས་དགའ་མོར།",
    "བཙུན་མོའི་ཚོགས་ཀྱིས་དད་ལ་ལོག་ལྟའི་ཁྲག།",
    "རི་མོར་ཤར་བ་མཐོང་འཕྲལ་དད་པའི་རྒྱུས།",
    "ཡུལ་ཕྱོགས་མུ་གེ་ལས་བསྲུངས་སྦྱིན་གཏོང་གིས།",
    "ནངས་རེར་དངུལ་དཀར་ཉིས་འབུམ་འཛག་རྡུལ་གྱིས།",
    "ལྟས་བྱིན་དུག་གི་སེན་མོས་འདེབས་སེམས་ཀྱིས།",
    "རང་གི་ཁྱད་པར་མངོན་མཐོ་བྱས་པ་ཤེས།",
    "སྟོན་པའི་མདུན་གནས་ཀླུ་ཆེན་བཞི་དག་གིས་གསལ་རྒྱལ་བཀུར་སྟིར་མ་བྱས་ཁྲོས་ལན་དུ།",
    "ཕན་ཚུན་ལས་ཀྱི་ལག་སྦྲེལ་མཛའ་ན་མོ།",
    "བུ་མོ་ཐོབ་མཐར་རྣམ་གྲོལ་གླང་པོ་ཅན།",
    "རྫིང་བུ་གདུང་བ་མེད་པར་མི་མཆོག་གིས།",
    "དབུལ་མོ་བཙས་ཤིང་ལྟོགས་མས་ཕྲུ་གུ་ཡང་།",
    "བཟའ་བར་བརྩམ་ལ་རང་གི་ནུ་འབུར་གཉིས།",
    "དད་པས་སྐྱབས་སོང་བ་ལང་སྐྱོང་ཀླུ་བཏུལ།",
    "བྲམ་ཟེ་ཁྱོ་ཤུག་ཟུང་གིས་ལྷ་ཡི་ལྷར།",
    "མིའམ་ཅི་མོ་བྲོས་པ་སྤྲོ་བ་བརྒྱས།",
    "རི་དྭགས་བུ་མོ་ལས་སྐྱེས་ཐུབ་པའི་བུ།",
    "དགེ་སྡིག་འབྲས་བུ་ལ་བལྟས་དྲང་སྲོང་ཚོགས།",
    "ཚངས་བྱིན་གྱིས་ཐོབ་ཟུང་གི་བུར་བཙས་ཀྱང་།",
    "སྐྱིལ་མོ་ཀྲུང་བཅས་གེགས་བྱེད་ཀླུ་བཏུལ་ནས།",
    "གདེངས་ཅན་ཚོགས་ཀྱིས་གཙུག་བླངས་དབྱིག་གི་དཔྱ།",
    "མ་རིག་རྩ་བ་སྦོམ་པོས་འཁྲུལ་སྣང་གི།",
    "སྐྱབས་སུ་སོང་ལ་ལམ་བསྟན་ཡོངས་ལྟང་འཕྲལ།",
    "ཀུན་གཟིགས་ཐ་མའི་གཟིམས་ཁྲི་ལ་བཞུགས་ཚེ།",
    "ཡེ་ཤེས་གཟིགས་པས་གདུལ་བྱའི་ལྷག་མ་ཟུང་།",
    "སྐྱེད་མོས་ཚལ་དུ་ཞག་དྲུག་ཐུ་བོ་བཅིངས།",
    "ལྗིད་ཆེ་དར་བའི་བུམ་པ་བགྲེས་མོ་ལ།",
    "འགྱོད་ཀྱིན་གཞན་ཕན་བློ་ཡིས་སྒྲིབ་བྱང་ནས་། དགའ་ལྡན་ལྟར་སྐྱེས་མཛའ་བོའི་བུ་མོར་གྲགས།",
    "སྤྱན་འདྲེན་གསོལ་བཏབ་སང་གི་མཁའ་ལམ་ནས།",
    "རང་གི་ཕྲུ་གུ་ལ་གཙིགས་བཟའ་ཉེ་བ།",
    "མ་སྨད་ཡོངས་ཀྱི་སྲོག་བསྲུངས་སྟག་མོའི་གཏམ།",
    "བཀྲེས་སྐོམ་ཉམ་ཐག་བརྩེ་བའི་སྣ་ལག་གིས།",
    "ཉེར་བླངས་ཆུ་ཡིས་དབུགས་ཕྱུང་རང་གི་ལུས།",
    "ཚུ་གཏེར་དོན་མཐུན་བྱིང་བ་རང་གི་རྒྱབ།",
    "སྔོན་ཚེ་དྲང་སྲོང་ཚོགས་ལ་ངེས་ལེགས་ལམ།",
    "ལྡང་བས་མ་མེས་དམག་གི་དཔུང་བསྐུལ་ཡང་།",
    "སྐྱོན་བྲལ་མངོན་སུམ་ཐོབ་པ་རེ་བ་ཏ།",
    "གནོད་སྦྱིན་གཅིག་གི་ལྕག་བྱས་བློན་པོའི་བུ།",
    "བུ་རྐང་འཐུང་གིས་མཚན་པའི།",
    "འགྲོ་ལ་གཟིགས་པ་སྒྲིབ་མེད་སྤྱན།",
    "སེམས་ཀྱི་ཀཱ་ཤི་མཛེས་དགའ་མོ།",
    "འབྱིན་པར་ངག་གི་གླིང་བུས་བསྐུལ།",
    "ཐ་སྙད་གཙུག་ལག་ཉིན་མོར་བྱེད་པ་ནས།",
    "དངོས་གྲུབ་སྒྲུབ་ཐབས་ཟབ་མོར་ལེགས་ཞུགས་ཀྱང་།",
    "བོས་པའི་ལད་མོ་བསྒྲགས་དང་ཅིས་མི་མཚུངས།",
    "མོས་གུས་། མི་དམན་སྐལ་བཟང་རཱ་མ་ཎས།",
    "སོ་ཐར་གྱི་སྡོམ་པ་མ་ཐོབ་ན་དགེ་སློང་གི་དངོས་པོར་མི་འགྱུར་བ་བཞིན་ནོ།",
    "ནཱ་རོ་པས་ཏི་ལོ་པ་ཉ་གསོན་པོར་བསྲེགས་ནས་ཟ་བའི་སྨྱོན་པ་ལྟར་མཐོང་བ་སོགས་མང་དུ་བྱུང་སྟེ་དེ་དག་གིས་སླར་མོས་གུས་བསྒོམས་པ་དང་བཀའ་བཞིན་བསྒྲུབས་པས་གྲུབ་པ་བརྙེས་པ་དང་།",
    "རང་གི་མདུན་དུ་རྡོ་རྗེ་དྲིལ་བུ།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པའི་ཕུང་ལྔ་ཀུན་འདུས་རྒྱལ་བ་དྲུག།",
    "གནས་གསུམ་རྡོ་རྗེའི་ཡི་གེ་གསུམ་མཚན་ཐུགས་ཀའི་འོད་ཀྱིས་བསྐུལ་བའི་མོད་། རང་བཞིན་གནས་ནས་ཡེ་ཤེས་པ་རྣམས་སྤྱན་དྲངས་དབྱེར་མེད་ཐིམ་པར་གྱུར།",
    "འཇིགས་ལས་སྐྱོབ་པའི་སྐྱབས་མཆོག་གསུམ་ཡང་ཁྱོད།",
    "ཀུན་འདུས་ཁྱོད་ཞབས་སྤངས་ནས་སྐྱབས་གཞན་ལ།",
    "རེ་བ་སྨིག་རྒྱུའི་ཆུ་ལས་འཐུང་འདྲར་བལྟ།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་སྙན་དངགས་དམ་པའི་གླུར།",
    "བཀའ་དྲིན་མཉམ་མེད་བ་ཆེན་བུདྡྷ་ཤྲཱི།",
    "དཔལ་ལྡན་དོན་གྲུབ་ག་ག་ན་བུདྡྷཾ།",
    "ཞེས་སོགས་གང་མོས་བསྒྱུར།",
    "རྐང་དྲུག་འཕུར་ལྡིང་གིས་རྩེན་གེ་སར་ཚོགས།",
    "གད་མོ་དགོད་སྙམ་མེ་ཏོག་ཅི་ཡང་བཀྲ།",
    "སྒྲ་སྙན་རོལ་མོའི་བྱེ་བྲག་རྣམས་ཀྱང་འབུལ།",
    "རེག་འཇམ་འདོད་ཡོན་ཕུན་སུམ་ཚོགས་དགུ་འབུལ།",
    "ཚིམ་མེད་ཉོན་མོངས་དུག་ལྔའི་མྱོས་ཆུ་ལ།",
    "ཡིད་སྲུབས་རེ་བ་བསྐངས་ལ་བདག་དགའ་མེད།",
    "གང་གི་དཔལ་མགུར་ཤིས་པའི་དུང་དཀར་ལས།",
    "ཐུན་མོང་བའི་ལམ་གྱི་གསོལ་བ་གདབ་པ་ནི།",
    "མགོན་ཁྱོད་སྐུ་ཡི་ཆ་རེར་རི་མོར་བགྱིས།",
    "ཐོག་མེད་དུས་ནས་བདག་གི་མར་བྱས་ཤིང་།",
    "བདག་གིས་ཐོབ་ནས་འགྲོ་ཀུན་སྲིད་མཚོ་ལས།",
