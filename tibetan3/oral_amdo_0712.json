    "སྐྱུ་རུ་ཉེར་ལྔ་གུར་ཏིག་གི་ཏིག་བསྟེན།",
    "ཅོང་ཞི་འབྲི་མོག་རྩི་དང་འུ་སུ་སྦྱར།",
    "ཆང་གིས་ཕུལ་ཞིང་སྤང་རྒྱན་བཅོ་ལྔ་དང་།",
    "༣༦ གློ་རྣག་ཟངས་ཐལ་ཉེར་ལྔ་བསེ་ཉེར་ལྔ།",
    "མཐེ་བོང་ཆང་བའི་ནང་དུ་བཅུག་ལ་འཁྱོར་ཁའི་མཐེབ་ཚིགས་ནས་གྱེན་དུ་སོར་ཕྱེད་བཅལ་བའི་སར་གཏར།",
    "ཟངས་ཐལ་ཉེར་ལྔ་ད་ལིས་བཅུ་དྲུག་གཏོང་།",
    "གི་ཝང་དགུ་དང་གཡུ་རྙིང་ཉེར་ལྔ་བསྟེན།",
    "གུར་གུམ་མཆོག་བདུན་མང་སྦྱོར་ཆེན་མོ་གཏོང་།",
    "གི་དགུ་ཁྱུང་ནག་གཏོང་ཞིང་རུ་ཐུང་གཏར།",
    "ཅོང་ཞི་འཕྲུལ་ཐལ་བཅོ་ལྔ་དྲག་སྦྱོར་གཏོང་།",
    "གྲང་འགགས་རྡོ་ཐལ་ཉེར་བདུན་གཉིས་ཀ་ལ།",
    "༥༤ ཕོ་ཐོག་ལ་ནི་རྡོ་ཐལ་ཉེར་ལྔའམ།",
    "ཟླ་ཤེལ་མྱུ་གུ་གྲང་སྦྱོར་ཆེན་མོ་ཟབ།",
    "ཅོང་ཞི་ཅུར་ནིས་ཟླ་ཤེལ་ཆེན་མོ་དང་།",
    "ཅོང་ཞི་ཅུར་ནིས་ཟླ་ཤེལ་ཆེན་མོ་དང་།",
    "༧༣ མོ་མཚན་ཟ་ཕྲུག་ལངས་ན་གུར་ཁྱུང་དང་།",
    "དེ་ཡི་རྟགས་ལ་བརྟེན་ནས་མྱོང་ཚོར་ཙམ།",
    "ཡང་ན་རྣ་བའི་ནང་གི་གཉན་ཚད་བརྟག།",
    "བར་དུ་དྲན་མེད་གཞོག་གཅིག་རེངས་ཤིང་འཁུམ།",
    "ཐ་མ་མིག་གི་རྒྱལ་མོ་ཆེ་རུ་འགྲོ།",
    "༡ བུད་མེད་ཟླ་མཚན་འོང་བའི་སྔ་ཕྱི་དུས།",
    "ཤེས་བྱའི་མཐའ་རྒྱ་རང་གིས་མི་ཆོད་མོད།",
    "༧ འཇམ་མགོན་ཀོང་སྤྲུལ་བློ་གྲོས་མཐའ་ཡས་མཆོག་གིས།",
    "དེང་སང་གི་དུས་འདིར་འཚོ་བའི་ན་ཚན་རིག་གི་ལག་རྩལ་འཕེལ་རྒྱས་སུ་སོང་བས།",
    "ལན་ཚྭ་སོགས་ཟུངས་ཁྲག་འཕེལ་བྱེད་ཀྱི་ཟས་སྐོམ་བསྟེན་མང་བས་ཁྲག་གི་ལྡང་ཚད་བརྒལ་བར་གྱུར་པ།",
    "གཉིས་པ་བྱེ་བྲག་གི་དབྱེ་བ།",
    "དགོང་དང་ཐོ་རེངས་ཀྱི་དུས་སུ་ཁྲག་ཤས་ཇེ་མཐོ་རུ་འགྲོ་བ།",
    "མཚན་མོ་གཉིད་མི་ཁུག་ཅིང་རྨི་ལམ་ཟ་ཟི་མང་བ།",
    "ཉིན་མོ་གཉིད་འོང་ཞིང་མཚན་མོ་གཉིད་མི་ཁུག་པ།",
    "ཁྱབ་བྱེད་འགྲོ་འདུག་རྩེད་མོ་དྲགས་པ་དང་།",
    "འགྲོ་འདོད་འཇིགས་སྐྲག་མི་སྙན་ཚིག་གིས་སློང་།",
    "གཅིན་པ་གཏོང་གྲངས་མང་ན་ཡང་འབབ་ཚད་ཉུང་དུ་སོང་བ་དང་།",
    "ནམ་མཁའ་ནས་གཟའ་ཡི་དུག་གིས་ཀླད་ཁྲག་འདྲེས་ནས་འཆི་བའང་སྲིད།",
    "དེ་གང་རུང་གི་རྐྱེན་གྱིས་ཀླད་པའི་ཆུ་སྐྲན་དུ་སྟབས་མ་ལེགས་ན་འགྱུར་སྲིད་དོ།",
    "སེམས་ཀྱི་བདེ་སྡུག་གི་ཚོར་བ་ཆེ་རུ་མི་གཏོང་ཞིང་ལུས་སེམས་གཉིས་ཀ་སྙོམས་པའི་ཐབས་ལ་བརྩོན་པར་བྱའོ།",
    "པི་པི་ལིང་གི་ཐང་བཏང་རྗེས་ཁྲག་གཏར་བར་བྱ།",
    "ཕག་མོ་གྲུ་པ།",
    "མཆིན་གནས་ཟུངས་སུ་མ་གྱུར་བའི་ཁྲག་ནང་གི་ས་ཆུའི་དྭངས་མ་མངར་ཆ་དང་།",
    "མཛོ་མོ་ལྔ་ཐང་།",
    "དྲན་པ་མི་བརྟན་པས་སྔར་སོང་གི་བྱ་བ་རྣམས་བརྗེད།",
    "ཚིགས་པ་གསུམ་པ་དང་དྲུག་བདུན་བྲང་གཞུང་དཀར་ནག་མཚམས་སོགས་བསྲེག་མིག་གི་འབྲེལ་སྐྱིའི་འོག་ཏུ་ཁྲག་དོན་ན་གཉེན་པོ་ཁྲག་གཅོད་ཙན་དན་བརྒྱད་པ།",
    "གསལ་བྱེད་ལྕགས་རིལ་ཆེན་མོ།",
    "དུས་རྟག་པར་ཚ་བ་རྒྱས་ཤིང་དགོང་མོ་རྔུལ་ཆུ་རྒྱུན་དུ་འོང་།",
    "བུད་མེད་ཀྱི་ཟླ་མཚན་མི་སྙོམས།",
    "དབུགས་འབྱིན་རྔུབས་བྱས་པ་དང་མཉམ་དུ་འགའ་རེར་གློ་ལུ་སྐབས་ལྷག་པར་ན།",
    "འགའ་རེ་ལ་ཁྲག་དང་རྣག་འདྲེས་ཡོད་པའམ་ཡང་ན་བེ་སྣབས་ཅན་འདྲེས་མར་བཤལ།",
    "སྐབས་རེར་དྲི་ཆེན་སྐམ་ནས་ཐོན་དཀའ།",
    "གསུས་པར་རེག་ན་མི་འགུལ་ཞིང་སྐྲངས་པ་འབར་འབུར་ཅན་ཡིན།",
    "མིག་གི་རྒྱལ་མོ་ཆེ་ཆུང་ཅན་དུ་འགྱུར།",
    "དུག་མོ་ཉུང་།",
    "ཙིཏྲ་ཀ་དབྱི་མོང་།",
    "བྲང་ཁོག་ཏུ་ཆུ་ཡོད་ན་དྭགས་པོའི་ཟངས་ཐལ་ཉི་ཤུ་ལྟག་སྤྲོད་བཏང་།",
    "མི་ཐོད་གསུམ་སྟེང་གཡའ་ཀྱི་ཨ་ཕྱག་དང་།",
    "ཟངས་ཐལ་ཉེར་དྲུག་བསེ་རུ་ཉེར་ལྔ།",
    "འབྲི་མོག་ཚོས།",
    "དགོང་མོ་གཙོ་བོ་ཉེར་ལྔ་གཏོང་།",
    "ཅི་འདོད་རེ་བ་སྐོང་མཛད་ཡིད་བཞིན་ནོར།",
    "འཕྲལ་རྐྱེན་ས་བདག་ཀླུ་གཉན་སོགས་ལ་ཕོག་ཐུག་སོང་བ།",
    "ལུས་ཀྱི་ཟུངས་སྟོབས་ཉིན་རེ་བཞིན་དུ་ཉམས།",
    "ཕོ་འབྲས་སྐྲན་ལྟར་རེག་པ་སྲ་བའམ།",
    "ཐེངས་རེར་ཟས་ཅུང་ཟད་ཙམ་ལས་འགྲོ་མི་ཐུབ་ནས་གྱེན་དུ་སྐྱུགས་འོངས།",
    "འཕར་སྤྱང་གིས་བསད་པའི་ཤ་དང་།",
    "རྦབ་གྲིར་ཤི་བའི་ཤ་རྔ་ཕྲན་དང་ར་ལུག་གི་ཤ་རྩམ་པ་དང་གྲོ་ཕྱེ་རྙིང་པ་དང་།",
    "གོ་གྲེ་བཅུ་བདུན་གང་རུང་གི་སྟེང་དུ་བཙོ་ཐལ་བསྣན་པའང་བཏང་།",
    "སྐབས་རེར་རིན་ཆེན་གྲང་སྦྱོར་བཏང་།",
    "འབྲུག་རུས་གླ་རྩི་མི་རུས་ཐལ་བ་རྡོ་ཐལ་ཨ་རུ་འབིགས་བྱེད་རྒྱ་ཚ་གཙང་གཡེཪ་འཇིབ་རྩི་ལྕམ་པ་དེ་རྣམས་སྦྱར་བས་ཕན་",
    "ཨ་རུ་བ་རུ་སྐྱུ་རུ་གུར་གུམ་ཀོ་ལ་སུག་སྨེལ་བཙན་དུག་བསྲེགས་ཐལ་ཞོ་གང་",
    "མི་ཡི་དྲི་ཆེན་བསྲེགས་ཐལ་ཞོ་རེ་དང་",
    "སྤང་རྩི་གྲེས་མ་ལ་ཕུག་ན་ལེ་ཤམ་བཅའ་སྒ་པི་ལིང་སྤང་སྤོས་ཟེ་ཚ་རྣམས་སྦྱར་བར་བྱེད་པ་ནུབ་མོ་བསྟེན་པས་ཕན",
    "བྱང་གི་འདབ་མ་ལ་ནི་ཤུ་དག་ལྗང་གུ་མར་གད་ལྟ་བུ་གྱུར་པ་བསྒོམ་ལ།",
    "དངུལ་ཆུ་བཙོ་བཀྲུ་ཆེན་མོ།",
    "ཅོང་ཞིའམ་རྡོ་ཐལ་བསྲེག་པ་ལྔ་བུངས་བསྐྱེད།",
    "གཅོད་བྱེད་ཐོག་གི་ཟེར་མ་འཁྲུགས།",
