    "བོང་དམར་བསྐོལ་བའི་ཁུ་བའི་ནང་དུ་ཆུ་ཚོད་གཅིག་ལྷག་བཙོས་རྗེས་ཆུས་བཀྲུས་རྗེས་ཟེ་ཚ་དང་ཚ་ལ་ཆུ་བཅད་ཅུང་ཟད་རེ་འདེབས་པ་ཉིད་འཇུ་རྩི་ཡིན་པས་ལེགས་གསུངས།",
    "མུ་ཟི་དུག་འདོན་ཀོང་སྤྲུལ་གྱི་ཟིན་ཏིག་ལྟར་བྱས་ན་མུ་ཟི་བསླ་མེད་ཁྲམ་ཕྲུམ་བརྡུངས་རྩ་རམ་པའི་རྩ་བ་ཧྲོབ་བརྡུང་བྱེད་པའི་ཆུར་བཙོས་པའི་ཁུ་བའི་ནང་དུ་ལྷོག་ཙམ་བསྐོལ་ནས་ཞག་གཅིག་བསྙལ་ཕྱིར་ཉིན་ཅུང་ཙམ་བསྐོལ་ལ་ཆུ་གྲང་གིས་ཡང་ཡང་བཤལ་བས་དྲི་མ་མེད་ན་དུག་ཐོན་པ་ཡིན་གསུངས།",
    "ཨ་བར་སྐྱུར་གསུམ་ཐུན་རེའི་ཕྱེ་མ་ཆུར་བཏབ་པའི་ནང་དུ་སྦངས་པ་བཏོན་ཏེ་ཚག་ཤའི་ནང་དུ་བཅུག་ལ་ཁ་བཙེམ་ནས་མེ་ནང་དུ་ཚག་ཤ་སེར་ཧྲོབ་ཙམ་བསྲེགས།",
    "༢༩ཏེ་ལོའི་ཤ་དང་སྲེ་མོང་གི་ཤ་གཉིས་གང་རུང་དང་པོ་ཆུ་གཙང་གིས་ལེགས་པར་བཀྲུས་རྗེས་ཆུ་ཁོལ་ངད་ཡལ་བའི་ནང་དུ་གླ་རྩི་དྲི་ཐོན་ཙམ་བཏབ།",
    "དེའི་ནང་དུ་ཏེ་ལོ་དང་སྲེ་མོང་གི་ཤ་གཏུབ་པ་ཞག་གཅིག་སྦངས།",
    "ཕྱིར་ཉིན་ཁུ་བ་དོར་ནས་ཆུ་གྲང་གིས་བཀྲུས་བཤལ་བྱས་ཏེ་ཉི་མར་བསྐམ།",
    "༣༢ གོ་ཐལ་དང་རྒོད་ཐལ་ཞིབ་པར་བཏགས་ལ་གླ་རྩིའི་ཆུས་བྲན་ལ་སླ་ངར་རྔོད་པར་བྱ།",
    "ཟེ་ཚའི་སུམ་ཆ་བེ་ལྗང་རེ་རལ་དང་གང་ག་ཆུང་།",
    "མགྲོན་བུ་སྦོ་ཅན་ཧར་བསྲེགས་བྱས་པའི་ཐལ་བ།",
    "དེ་ནས་ཆང་བཟང་བསྣན་ལ་ཅུང་ཟད་བཙོས་རྗེས་ཆུ་གྲང་གིས་དག་པར་བཀྲུས།",
    "གོ་ལ་འདི་འབག་བཙོག་གི་རྣམ་པར་གྱུར་དང་འགྱུར་བཞིན་ཡོད་པ་ནི་ཀུན་གྱིས་ཤེས་གསལ་ལྟར་ཡིན་མོད།",
    "ལག་པའི་སེན་མོ་རིང་ན་བཅད།",
    "གོས་བརྗེ་ཁང་དུ་སོང་ནས་ཞྭ་གོས་ལྷམ་སོགས་བརྗེས་ནས་སྐྲ་རིང་པོ་ཡིན་ན་ཞྭ་ནང་དུ་བཅུག་ལག་པ་གཙང་མ་བཀྲུས་ལ་ཁ་ཤུབ་གོན་ནས་ནང་དུ་འགྲོ་དགོས།",
    "མ་མོའི་ཁ་རླངས་གདུག་པ་སྤྲིན་དུ་འཁྲིགས།",
    "སྲང་གཉིས་ཁྱོར་གང་།",
    "ནག་མཚུར་སུམ་ཐང་ལྟ་བུ་གྲང་ཐང་གི་རིགས་དང་མ་ནུ་བཞི་ཐང་ལྟ་བུ་ནི་གདུས་ཐང་རིགས་སོ།",
    "སྦྲང་ཤད་འཐེན་ལུགས་སོགས་གོང་གི་བུ་རམ་དང་ལག་ལེན་གཅིག་མཚུངས་ཡིན།",
    "། ལྕགས་ཁམས་ཐལ་བཟོ་དང་དངུལ་ཆུ་བཙོ་བཀྲུ་ཆེན་མོའི་ལག་ལེན་མཐོང་བརྒྱུད་ལྟར་བཀོད་པ་བདུད་རྩི་བཅུད་དུ་འགུགས་པའི་སྦྱོར་བ།",
    "དངུལ་ཆུ་བཙོ་བཀྲུ་ཆེན་མོའི་ལག་ལེན་སྔར་སྲོལ་ལྟར་ཉམས་པ་མེད་པར་གཞི་བཞག་དུས་རབས་ཀྱི་མཁོ་ཆས་འཚམས་པར་སྤྱོད་དེ་སྦྱོར་བ་ཇི་ལྟར་བྱས་ཚུལ་ལ་གསུམ།",
    "དང་པོ་རྫས་རིགས་དང་ཡོ་བྱད་གཉིས་སྔ་ཚགས་བྱ་དགོས་དེ་ཡང་དངུལ་ཆུ་བཙོ་བཀྲུ་ཆེན་མོ་དང་འབྲེལ་བའི་ལྕགས་ཁམས་ཐལ་བཟོས་ལག་ལེན་གྱི་རང་བཞིན་ནི་རྫས་འགྱུར་གྱི་རིག་སྟོབས་ལ་བརྟེན་ནས་དངུལ་ཆུ་གཡོ་བ་དང་རྒོད་པའི་དུག་འཆིང་བར་བྱེད་པར་ལྕགས་བརྒྱད་དང་།",
    "ལྷང་ཚེར་ཐལ་བ་ཁམས་བདུན་གཅིག་གི་བཞི་འགྱུར་དགོས་པ་མ་ཚད།",
    "ཟི་ཁྱིམ་སིན་དྷིའི་ཆུ་ཀློང་དག་གི་འགྲམ།",
    "དེ་མཆོག་དམན་གང་རུང་གི་ངོ་བོ་ལྕི་ཞིང་མཉེན་པ་ཡིན་ཀྱང་ལྷད་ཡོད་ན་མི་རུང་བས་ཞིབ་ཏུ་བརྟག་པ་གལ་ཆེ།",
    "རི་མོ་དཀར་ནར་གྱིས་སོང་ན་དངུལ་ལྷད་མེད་པའི་རྟགས་ཡིན་པས་ལེགས།",
    "ལྕགས་ཐལ་མཆིན་དུག་དམུ་རྫིང་སྐེམ་པའི་མཆོག།",
    "དེ་ཡང་མེ་འཇམ་པོ་བཏང་ལ་བཞུ་སྣོད་གང་རུང་གི་ནང་དུ་ཞ་ཉེ་བཞུས་ནས་ཞུ་མ་ཐག་ཏུ་ལུག་རྭའམ་གནའ་རྭས་དཀྲུག་དཀྲུག་བཏང་བས་ཞན་ལྷད་སྙིགས་རོ་རྣམས་ཁར་ལྡིང་འོངས།",
    "རྡོ་ལ་བདར་ན་རི་མོ་དམར་སྨུག་དོད་པ་དེ་གས་ཀྱང་རུང་གསུངས།",
    "ལྷང་ཚེར་ཐལ་བ་རྒྱ་༡བཅས་ལ་མཚོན་ན།",
    "སེ་འབྲུའི་གང་བུ་རྣམས་གང་རུང་ཞིག་དང་མཉམ་དུ་ཆུར་སྦྱར་བས་ཁུ་བ་ནག་པོར་སོང་ན་ནག་མཚུར་དང་།",
    "རེའུ་སྐྱེས་འཕྲལ་གྱིས་སྤྱི་དང་།",
    "༢༡ ར་ཐུག་གི་གཅིན་ནི།",
    "༢༥ བེ་སོལ་རྒྱ་མ་༥གསོམ་ཤིང་གི་སོལ་ཕྱེ་རྒྱ་མ་༥ཙམ།",
    "ཞ་ཉེ་ལྔ་པོ་སྦྲང་གཤོག་སྲབ་མོ་བརྡུང་ལ་གྲུ་བཞི་ནར་མ་ཆེ་ཆུང་སྲེག་སྣོད་དང་འཚམས་པར་བཅད།",
    "ཏི་ཚ་སྦྲང་གཤོག་གམ་ཡང་ན་གསེག་བདར་གྱིས་བདར་བའམ་ལྕགས་གཏུན་དུ་བརྡུངས་བའི་ཕྱེ་ལེབ་གང་རུང་བྱས་པས་ཆོག་མཁར་བ་གསེག་བདར་གྱིས་བདར་བས་ཕྱེ་མ་ཞིབ་མོར་བྱ།",
    "ཆུ་གྲང་གིས་ལན་གསུམ་བཀྲུ་བཤལ་དག་པར་བྱ།",
    "དེ་ཡང་ཆང་སྐྱུར་དང་སྟར་ཁུ་གཉིས་རྒྱ་༡རེ་བླུགས་ཏེ་ཆུ་ཚོད་སྐར་མ་༣བར་དུ་བཙོས་ནས་གཡའ་ཁུ་ཕྱིར་དོར།",
    "ཆུ་གྲང་གིས་ལན་གསུམ་བཀྲུས་ཟིན་ནས་ལྡེབས་གཉེར་བསྲང་ལ་ཕྱི་བདར་བྱས་ནས་ཆུས་དག་པར་བཀྲུ་བ་སོགས་ཐེངས་བཞི་རེ་འགྲོ་དགོས་ཀྱང་ཉི་མས་མ་འདང་བས་བར་མཚམས་འཇོག་དགོས་བྱུང་ན་འདོན་ཁུ་གང་ཡིན་དེ་དང་མཉམ་དུ་བསྙལ་ནས་ཕྱིར་ཉིན་ལྷོག་ཅིག་ཁོལ་བར་བཙོས་ཏེ་བཀྲུ་བཤལ་བྱ།",
    "ཟངས་གཤོག་རང་དང་ལྗིད་མཉམ་པའི་ཚ་ལ་ཆུ་མ་བཅད་པ་སྲང་༥ཉིས་འགྱུར་གྱི་མུ་ཟི་དུག་མ་ཕྱུང་བ་རྒྱ་༡བྲི་ཐེབས་ཅུང་ཟད་དང་བཅས་ཀ་ཏོ་རའི་ནང་དུ་སྐམ་བསྲེས་ལེགས་པར་བྱས་རྗེས་ཆུ་དྲོན་གྱིས་སྐྱོ་མ་གཡོས་ནས་ཟངས་གཤོག་རེ་རེའི་གྲངས་དང་མཉམ་པར་རྒྱ་མར་བདེགས་ནས་ཆད་ལྷག་མེད་པར་བགོས།",
    "དེ་རེ་རེ་བཞིན་རས་སྐུད་ཀྱིས་དཀྲིས་ནས་བཅིང་ལ་ཉི་མར་བསྐམས།",
    "སོ་བར་འཆའ་དུས་སག་སྒྲ་དང་བཅས་ཞིག་སོང་ན་ཚད་ལྡན་ལེགས་གྲུབ་བྱུང་བའི་རྟགས་ཡིན་གསུངས་སོ།",
    "ཟངས་ཐལ་ལེགས་པར་བསྐམས་རྗེས་ཞིབ་པར་བཏུལ་ལ་རྒྱ་མཪ་བདེགས་པས་སྔར་གྱི་ལྗིད་ཚད་ལྟར་དུ་ཡོད་ན་འཕྲོ་བརླགས་མ་སོང་བ་ཡིན་ནོ།",
    "དང་པོ་ཞ་ཉེ་དཀར་ནག་གཉིས་ཀྱི་ཐལ་བཟོ་བྱ་ཚུལ་འདྲ་གསུངས་ཀྱང་།",
    "ཨ་བར་སྐྱུར་གསུམ་ཆ་མཉམ་སྲང་༣རེ་ཧྲོབ་རྡུང་བྱས་པའི་ཕྱེ་མ་བཏབ་པའི་ནང་དུ་ཞ་གཤོག་རྣམས་འདོན་ཁུ་རང་ཐུམ་མ་སོང་བར་དུ་བཙོ།",
    "མཐར་ཆུ་གྲང་གིས་ལན་གསུམ་དག་པར་བཀྲུ།",
    "གསེར་གྱི་སྦྲང་གཤོག་རེ་རེ་བཞིན་ཤིང་ལེབ་འཇམ་པོའི་སྟེང་དུ་བཞག་ལ་རས་བལ་གྱིས་ཕྱི་བདར་བཀྲུ་བཤལ་ལན་མང་བྱ།",
    "སླར་ཡང་སྐྱུར་གསུམ་ཆུ་སྔོན་མའི་ཚ་ཚད་ལྟར་གྱིས་ནང་དུ་ཆུ་ཚོད་སྐར་མ་༣བར་དུ་བཙོ་བ་དང་ཆུ་གྲང་གིས་ལན་གསུམ་བཀྲུ་བཤལ་བྱེད།",
    "ཆུ་གྲང་གིས་བཀྲུ་བཤལ་གོང་ལྟར་བྱ།",
    "ཉིས་འགྱུར་གྱི་ཞན་ཐལ།",
    "གསེར་གཤོག་རེ་རེ་བཞིན་དུ་སྲེག་རྫས་བྱུག་ལུགས་སོགས་སྤྱི་ལྟར་བྱ།",
    "བཀྲུ་བཤལ་སོགས་སྤྱི་ལྟར་ཡིན་མོད།",
    "དངུལ་ཐལ་ལ།",
    "གཤའ་ཐལ་ལ།",
    "ཕྱི་བདར་དང་ཆུ་གཙང་གིས་བཀྲུ་བཤལ་ལན་གསུམ་རེ་བྱ།",
    "ལྕགས་ཐལ་ལ།",
    "གསུམ་པ་སྲེག་རྫས་བྱུག་ཚུལ་འཁར་ཕྱེ་སྲང་༥ལ་ཉིས་འགྱུར་གྱི་ཚ་ལ་ཆུ་མ་བཅད་པ་རྒྱ་༡སུམ་འགྱུར་གྱི་མུ་ཟིའི་ཕྱེ་མ་རྒྱ་༡སྲང་༥བཅས་སྐམ་བསྲེས་ལེགས་པོར་བྱས་རྗེས་ཆང་སྐྱུར་གྱིས་འདམ་འཐག་ཟན་ཙམ་བྱས་མཐར་སྔོན་མའི་སྦྲང་གཤོག་གི་ཚད་ཙམ་རས་དཀར་གྱི་ནང་དུ་སྐར་གང་གི་མཐུག་སྲབ་ཡོད་པར་བྱས་ནས་དྲིལ་ལ་རས་སྐུད་ཀྱིས་བཅིངས་ནས་ཉི་མར་བསྐམས།",
    "། ཁམས་བརྒྱད་ཀྱི་ཐལ་བཟོ་བྱ་བའི་སྐོར།",
    "ལྡོང་རོས་གཉིས་ནས་འབྲུ་ཕྱེད་ཀ་ཙམ་ཧྲོབ་བརྡུངས་བྱས་ནས་སོ་སོར་འཇོག་༣ ལྷང་ཚེར་ནག་པོ་རྡོ་ལྷད་རྣམས་བསལ་ཏེ་གྲིས་སྲབ་མོར་ཤོག་གུ་ཙམ་གཤག་དེ་ནས་སླ་ངའི་ནང་དུ་སྐྱ་སོབ་སོབ་མ་སོང་བར་དུ་མེར་བརྔོས་རྗེས་ལྕགས་གཏུན་ནང་དུ་བརྡུངས་བའི་ཕྱེ་མ་ཚགས་ལ་དྲངས་པ་ལོགས་སུ་ཉར་རོ།",
    "ཆུ་གྲང་གིས་མ་དག་བར་དུ་ཡང་ཡང་བཀྲུ།",
    "ལྷག་མ་མཚུར་ཁུ་ཆ་གཅིག་ཕྱིར་བཞུར་ནས་ཆུ་གྲང་གིས་ཡང་ཡང་དག་པར་བཀྲུས་རྗེས་གྲིབ་སྐམ་བྱ།",
    "དེ་ཟན་སླ་ཤོས་ཙམ་རེད་དུས་མཐེབ་དཀྱུ་སྲབ་མོ་བྱས་ཏེ་ཉི་མར་བསྐམས།",
    "ལྷང་ཚེར་ནག་པོའི་ཐལ་བཟོ་བྱ་ཚུལ་ལ།",
    "ར་ཐུག་གི་གཅིན་སྲང་༥དང་དར་བ་སྲང་༥ཆ་མཉམ་གྲང་མོའི་ནང་དུ་ལྷང་ཚེར་ཕྱེ་མར་བསྲེས་པའི་སྐྱོ་མ་ཞོ་ཙམ་སླ་མོ་བྱས་ཏེ་རྫ་སྣོད་དུ་བླུགས་ལ་དྲོ་སར་ཉིན་བདུན་བསྙལ།",
    "ཁུ་བ་མང་ཆེ་ན་ཁའི་དྭངས་མ་སྣོད་ཅིག་གི་ནང་དུ་བཞུར་ནས་འཇོག་དེ་ནས་ར་ལྤགས་ཀྱི་ཐང་རྐྱལ་ལམ་ཡང་ན་འགྱིག་ཁུག་མཉེ་འཕུར་བདེ་བའི་ནང་དུ་བླུགས་ནས་འཕུར།",
    "ཤུག་ཐལ་སོལ་རྡོ་སོགས་མ་འདྲེས་པ་ཚགས་སུ་དྲངས་པ་རྒྱ་མ་༢༥།",
    "ཆུ་བསྐོལ་སྐོལ་སྣོད་དང་འབུད་ཤིང་འདང་ངེས།",
    "སྤོས་དང་གུ་གུལ་དཀར་ནག་གི་བདུག་པ།",
    "ཡ་བཀྵ་ར་བཅས་སོ་སོར་སྲང་དྲུག་རེ་ཆ་མཉམ་བྱས་པ་ཞིབ་པར་བཏུལ།",
    "ཉིན་ཉེར་གཉིས་པར་དགོས་པའི་ཅོང་ཞི་ཕོ་མོ་བུ་གསུམ་ལེགས་པ་ཆེ་བ་ནས་འབྲུ་ཙམ་དང་ཆུང་བ་ཡུངས་དཀར་ཙམ་བརྡུངས་པ་རྒྱ་མ་༡༢དང་།",
    "ཉིན་ཉེར་དྲུག་པར་ཟ་བྱེད་ཁམས་བརྒྱད་ནི་གསེར་རྡོ་དངུལ་རྡོ་ཆུ་སྐྱུར་རྡོ་རྡོ་ཕ་ཝཾ་ལུང་བུ་ཁབ་ལེན་རྡོ་བ་བླ་ལྡོང་རོས་བདུན་པོའི་ཐལ་བ་སོ་སོར་སྲང་ ༢རེ་དང་།",
    "དེའི་སྟེང་ལྷང་ཚེར་ནག་པོའི་ཐལ་བ་སྲང་ ༢ བཅས་དགུ་པོའི་སྟེང་དུ་རྒྱ་གར་བོང་དམཪ་གྱི་ཕྱེ་མ་སྲང་ ༢བཅས་ཞིབ་པར་བཏུལ།",
    "ཞ་ཉེ་དཀར་ནག་གཉིས་གཅིག་ཏུ་བརྩིས་པའི་སོ་སོའི་ཐལ་བ་སྲང་ ༡རེཪ་དན་རོག་གི་སྣུམ་རྒྱ་མ་༣དང་།",
    "ཁམས་བདུན་གཅིག་གི་བཞི་འགྱུར་ལྷང་ཚེར་ཐལ་བ་ཞོ་༦བཅས་དང་།",
    "སེ་འབྲུ་སྐྱུར་མོའི་འབྲས་བུ་མ་རུལ་བ་རྒྱ་མ་༦ཙམ་སྔ་ཚགས་བྱས་ཏེ་ལེགས་པར་བསྒྲིགས་སོ།",
    "ཁྱད་པར་ཁྱི་དང་བུད་མེད་ཀྱི་མཚམས་བཅད་ནས།",
    "དུག་སྲུང་བའི་རྫས་ཤ་དང་བུ་ཪམ་བསྟེན་རྒྱུ་སོགས་སྦྱིར་བཏང་གི་ཕྱག་བཞེས་ཞིབ་མོ་བྱས།",
    "པི་པི་ལིང་གི་ཕྱེ་མ་རྒྱ་མ་༡༡ ཕོ་རིལ་གྱི་ཕྱེ་མ་རྒྱ་མ་༡བཅས་སྐམ་པོའི་ཚད་ཡིན།",
    "དེ་རེ་རེ་བཞིན་གུ་ཤའི་ཀ་ཏོ་ར་ཆུང་བའི་ནང་དུ་བཞག་རྗེས་ཡུན་རིང་པོར་མི་འཇོག་པར་མཉེ་མཁན་རྣམས་གདན་ཐོག་ཏུ་སྐྱིལ་ཀྲུང་བཅས་ཏེ་ཀ་ཏོ་ར་པང་དུ་བླངས་ནས་དལ་བུས་ཐང་ཁུག་རྣམས་མཉེ་འཕུར་བྱས།",
    "དེའི་ཕྱེད་ཆ་ལན་ཚྭ་དང་བུལ་ཏོག་རེ་རེ་རྡོ་གཏུན་སོ་སོར་བླུགས།",
    "ད་ལམ་དངུལ་ཆུ་མང་བས་ཉིན་༢ལ་ཞོགས་པའི་ཆུ་ཚོད་༨པ་ནས་དགོང་མོའི་ཆུ་ཚོད་༨་བར་དུ་བསྲེས་འདུལ་དལ་མོ་བྱས།",
    "ཤུག་ཐལ་གྱི་ལེན་ལུགས་སོགས་སྔོན་མ་ལྟར་བྱས།",
    "བཀྲུ་བཤལ་བྱས་པའི་དངུལ་ཆུ་གཙང་མ་རྣམས་ཕྱོགས་གཅིག་ཏུ་བསྡོངས་པ་རྒྱ་བཏེགས་བྱས་པས་སྲང་༤སྐཪ་༥བྲི་འདུག་དེའི་ནུབ་མོ་དངུལ་ཆུ་སྟར་ཁུའི་ནང་དུ་བསྙལ་ལུགས་སྔར་ལྟར་བྱས་སོ།",
    "ཆུ་ཚོད་བཞི་རེའི་མཚམས་འདོན་ཁུ་བརྗེ་ནས་ཆུ་ཁོལ་གྱིས་བཀྲུ་བཤལ་བྱས།",
    "དེ་ལྟར་ཉིན་གཅིག་ལ་དགོང་མོའི་ཆུ་ཚོད་བརྒྱད་དང་ཕྱེད་བར་དེ་ལྟར་ཐེངས་གསུམ་བཏུལ་རྗེས་བཀྲུ་བཤལཡང་ཡང་བྱས།",
    "དགོང་མོ་སྟར་ཆུ་དྲོད་ལྡན་གྱི་ནང་དུ་བསྙལ་ལུགས་སོགས་སྔ་ལྟར་བྱས་སོ།",
    "དགོང་མོ་རྡོ་གཏུན་གཙང་བཤལ་དང་།",
    "ས་རྫི་ཀྵ་ར་སྟེ་མཚུར་ནག་གི་ཆུས་བཀྲུ་རན་པ་ཡིན།",
    "དེའི་སྟེང་མཚུར་ནག་ཞག་གཅིག་སྦངས་པའི་གྲུངས་ཆུ་ཚན་མོ་གོང་ལྟར་དངུལ་ཆུ་ནུབ་ངེས་བླུགས།",
    "ཞོགས་པ་ཆུ་ཚོད་བདུན་ཕྱེད་ནས་སྔོན་ལྟར་སྟར་ཁུ་གུད་དུ་ཕྱེས་ནས་བཤལ་རྗེས་ཀརྞ་ཀྵ་ར་སྟེ་སྐྱེས་པ་དར་མའི་དྲི་ཆུ་ཞག་གཅིག་དྭངས་སུ་བཅུག་པའི་གྲུངས་ཆུ་ཚན་མོ་གོང་ལྟར་དངུལ་ཆུ་ནུབ་ངེས་བླུགས།",
    "དེའི་སྟེང་ཚ་ལ་ཆུ་མ་བཅད་པའི་ཕྱེ་མ་དངུལ་ཆུ་སྲང་༤རེ་ལ།",
    "ཚ་ལ་སྲང་༡གི་ཚད་རེ་བཏབ་ནས་སྔར་བཞིན་བཏུལ།",
    "དགོང་མོ་བསྙལ་ལུགས་སོགས་གོང་ལྟར་བྱས་སོ།",
    "ཡ་བཀྵར་བཅས་སོ་སོར་སྲང་༦རེ་དང་།",
    "བུལ་ཏོག་སྲང་༨དང་ལན་ཚྭ་བཟང་པོ་སྲང་༨བཅས་མཉམ་དུ་བསྲེས་ནས་ཉིན་གཅིག་ལ་ཐེངས་གསུམ་བརྗེ་ལེན་དགོས་པས་ཕྱོགས་གསུམ་དུ་བགོས་ལ་དེའི་སྟེང་དུ་སྟར་བུའི་གྲུངས་ཆུ་ཚན་མོ་བླུགས་ཏེ་དཀྲུགས།",
    "ཉིན་གཅིག་ལ་ཐེངས་གསུམ་བརྗེས་ལེན་བྱས་ནས་བཀྲུ་བཤལ་དང་དགོང་མོ་བསྙལ་ལུགས་སོགས་སྔ་ལྟར་བྱས་སོ།",
    "ཉིན་བཅོ་བརྒྱད་པར་སྟར་དངུལ་སྔར་བཞིན་ཕྱེས་ལ་སྒོག་སྐྱ་ཆོལ་བརྡུང་བྱས་པ་རྒྱ་མ་༣ཙམ་དངུལ་ཆུ་ནུབ་ངེས་ཀྱི་ཚད་དང་སྦྱར་ནས་གྲང་རྗེས་དར་ཚགས་ལ་དྲངས་པའི་དྭངས་མ་ཞག་གཅིག་གི་གྲུངས་ཆུ་དྲོད་མོ་དེ།",
    "བཀྲུ་བཤལ་དང་དགོང་མོ་བསྙལ་ལུགས་སྔ་ལྟར་བྱས་ལ།",
    "ཉིན་ཉེར་གཉིས་པར་དངུལ་ཆུ་བཙོ་བ་དང་དགྲ་སྤྲད་པའི་སྟ་གོན་དུ་ཐབ་ཁང་དང་འདུར་ཁང་གཉིས་ལ་རས་སྔོ་ནག་གིས་ཡོལ་བས་གནམ་མི་འཐོང་བར་བྱས།",
    "བཙོ་ཆུང་གསུམ་མོ།",
    "བཙོ་ཐབ་དང་བཙོ་སྣོད་གཉིས་བརྟན་བརླིང་ཡིན་མིན་བརྟག་ཤིང་སྔ་དྲོའི་ཆུ་ཚོད་༡ནས་བཙོ་ཐབ་འོག་ཏུ་ལྕི་བ་སེར་ཁ་མ་ཟུར་དུ་བུས་པའི་མེ་ཁྲོབ་མིང་བཀྲ་ལེགས་པ་ཞིག་གིས་བཏང་བས་སིབ་སིབ་ཁོལ་བ་དང་མཉམ་དུ་ཅུང་ཟད་མེ་ཤུགས་ཆུང་བར་བཏང་།"
  ]
}