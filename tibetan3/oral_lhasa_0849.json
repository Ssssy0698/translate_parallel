    "འོན་ཀྱང་སྔོན་པོ་དང་སེར་པོ་དག་ཤེས་པ་ལས་སམ་ཕན་ཚུན་ཐ་དད་པར་རྟོགས་ཏེ་སྔོན་པོ་མཐོང་ངོ་ཞེས་བྱ་བར་རོ།",
    "འདི་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་ཐ་དད་པར་རིགས་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དོ་ཞེ་ན།",
    "ཕྱོགས་གཉིས་ལ་ཡང་རྣམ་པར་རྟོག་པ་གཉིས་ཏེ་ཚིག་གམ་རྟགས་ལས་རྟོགས་པར་བྱ་བ་ཡིན་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པར་དང་ཞེས་གསུངས་སོ།",
    "སྐབས་སྡུད་པར་བྱེད་པ་ནི་སྤྱི་གཞན་ཉིད་ནི་ཞེས་བྱ་བའོ།",
    "འོ་ན་གཞན་དང་གཞན་མ་ཡིན་པར་འགྱུར་རོ་སྙམ་ན།",
    "གཞན་དང་གཞན་པ་ཞེས་གསུངས་སོ།",
    "རྣམ་པ་གཞན་ཡོད་པ་ཉིད་ན་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ་། ཇི་ལྟར་དེ་ཁས་བླངས་ཀྱང་རྣམ་པ་གཞན་སྲིད་པར་འགྱུར་ཞེ་ན།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཚོར་བ་མེད་པ་ཞེས་ོགསུངས་སོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་གཞན་མ་ཡིན་པར་རོ།",
    "འདི་ཉིད་རྩ་བ་དང་སྒྲིབ་ེཔར་བྱེད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་མཚུངས་པའི་རང་བཞིན་གསལ་བ་དེ་དག་ལས་གཞན་ཉིད་ཡིན་པར་གྱུར་ན་ཞེས་འབྲེལ་ཏོ།",
    "གཞན་ལས་ལྡོག་པའི་སྤྱི་ནི་དངོས་པོ་མ་ཡིན་པས་ཐ་དད་པ་དང་ཐ་མི་དད་པའི་རྣམ་པར་རྟོག་པའོ།",
    "རྣམ་པར་རྟོག་པས་ནི་དངོས་པོ་དེ་མ་ཡིན་པ་ལས་ལྡོག་པར་མཚུངས་པ་བཞིན་དུ་ཞེན་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཚེ་དེ་དག་ལས་གཞན་ཉིད་ཡིན་པར་འགྱུར་ཞེས་འབྲེལ་ཏོ།",
    "འབྲེལ་པ་གྲུབ་པར་ཁས་བླངས་ནས་སྐྱོན་བརྗོད་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "འབྲེལ་པའི་ངོ་བོ་ཉིད་ཅེས་གསུངས་སོ།",
    "རྣམ་པར་མཚུངས་པ་ཉིད་ཅེས་བྱ་བའོ་། ཇི་༧ལྟར་ཞེ་ན།",
    "ཕན་ཚུན་ཞེས་གསུངས་སོ།",
    "གཞན་དུ་བྱེད་ཅེས་བྱ་བ་ནི་རིགས་མི་མཐུན་པར་རོ།",
    "དུ་མ་ཉིད་མ་འཕྲིགས་པའི་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་སྤྱིའི་བློ་ཉིད་ཀྱིས་སོ་། འདི་ག་ལས་ཤེ་ན་མཚུངས་པའི་རྣམ་པ་ཅན་གྱི་ཞེས་གསུངས་སོ།",
    "གཞན་དག་ཏུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དེ་ཉིད་ཀྱི་ཕྱིར་དངོས་པོ་མེད་པ་ཡིན་ནོ་ཞེས་བརྗོད་པ་དེའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་གཅིག་པུས་རྟོགས་པར་བྱ་བ་ནི་དེ་ཉིད་དང་གཞན་དག་ཏུ་མངོན་སུམ་གྱི་ཡུལ་དུ་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་རྟོག་པ་གཅིག་པུས་རྟོགས་པར་བྱ་བ་གསལ་བ་དང་འབྲེལ་པ་ཉིད་ནི་མངོན་སུམ་གྱི་ཡུལ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབྲས་བུ་ཉིད་ཡིན་པའི་ཕྱིར་གསལ་བ་བཞིན་དུ་འཇིག་པར་གྱུར་ིན།",
    "དེ་ཡང་དེ་ལྟར་འདོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་འཇིག་པར་འགྱུར།",
    "ཞེས་གསུངས་སོ།",
    "ནམ་མཁའ་བཞིན་དུ་སྤྱི་མ་ཡིན་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་རིགས་རྣམས་ཞེས་བྱ་བའོ།",
    "རྟོག་པ་འཁྲུལ་པའི་ཞེས་གསུངས་སོ་ོ།",
    "གལ་ཏེ་སྤྱི་ནི་རྣམ་པར་རྟོག་པའི་རྣམ་པ་ལས་ཐ་དད་པར་རྟོག་པ་ཉིད་མ་ཡིན་ནམ་ཞེས་དོགས་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "དུ་མ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་རྣམ་པ་གཉིས་ལ་སོགས་པར་ཐ་དད་པའི་ཕྱིར་རོ།་།",
    "གསལ་བ་བཞིན་དུ་འཕེལ་བའི་རྣམ་པ་ཅན་གྱི་སྤྱི་ལ་ཡང་འཕེལ་བའི་རྣམ་པ་ཅན་གཞན་ཡོད་ལ་དེ་ལ་ཡང་གཞན་ཡོད་པའི་ཕྱིར་ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི་སྤྱི་ལ་ཡང་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་གསལ་བ་ལ་བ་ལང་བ་ལང་ཞེས་ངོ་ཤེས་པ་ནི་སྤྱི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་ནས་ངོ་ཤེས་པ་ནི་ཞེས་༧གསུངས་སོ།",
    "གསལ་བ་ེདང་འདུས་པའི་རང་བཞིན་ནི་དེ་ཞིག་ན་གནས་པར་ཇི་ལྟར་འགྱུར།",
    "ཇི་ལྟར་ངོ་བོ་མེད་པར་འགྱུར་ཞེ་ན།",
    "སྤྱི་ཁྱབ་པ་ནི་ཞེས་གསུངས་སོ།",
    "དུས་ཀྱི་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དེ་ལྟར་མ་དམིགས་ཀྱང་དེ་ལྟར་ཡོད་པ་ཅི་སྟེ་མ་ཡིན་ཞེ་ན་དམིགས་པ་ཉིད་ཅེས་གསུངས་སོ།",
    "འདི་ནི་ཁས་བླངས་ནས་བརྗོད་པར་ཟད་དེ།",
    "ཡོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཡོད་པར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཞེས་གསུངས་ཏེ།",
    "དེའི་ཚེ་སྤྱི་ཡང་མེད་པར་འགྱུར་རོ།",
    "དེ་ལ་ཡང་ཞེས་གསུངས་ཏེ།",
    "ཡུལ་མེད་པར་ནི་བློ་རྣམས་མི་སྐྱེའོ་ཞེས་དོགས་པ་བསུ་བ་ནི་སྤྱི་ནི་ཞེས་བྱ་བའོ།",
    "ངེས་པར་བརྟགས་ན་ཞེས་བྱ་བའོ།",
    "དེ་ཡང་ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པ་ཡང་དངོས་པོ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་གཞན་ཡང་ཞེས་བྱ་བའོ།",
    "དངོས་པོ་ཉིད་ནི་བརྡའི་སྟོབས་ལ་མི་ལྟོས་པར་སྣང་བས་ཁྱབ་པ་དེ་དང་འགལ་བ་ཡོད་ན་མི་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "སྐབས་སུ་བབ་པ་ལ་ཁྱབ་པར་བྱེད་པ་དང་འགལ་བ་ཉིད་སྟོན་པ་ནི་བརྡ་ལ་མི་ལྟོས་པ་དེ་ལྟར་ནི་སྣང་བ་མེད་ཀྱི་འོན་ཀྱང་དེ་ལ་ལྟོས་པར་སྣང་ངོ།",
    "གལ་ཏེ་བརྡ་ལ་༤ལྟོས་པའི་ཤེས་པ་ལ་ཡང་དངོས་པོ་མེད་པ་ཁོ་ན་ལ་ཇི་ལྟར་འགྱུར་ཞེས་དོགས་པ་བསུ་བ་ནས་བརྡ་བྱེད་པ་ནི་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་སྔ་མ་དང་ཕྱི་མ་སྒྲོ་བཏགས་པ་ཁོ་ནས་ཡིན་། དེའི་ཕྱིར་དེ་ལ་ལྟོས་པའི་ཤེས་པ་པ་ཡང་དངོས་པོ་མེད་པར་སྒྲོ་བཏགས་པ་ཁོ་ན་མ་ཡིན་ནོ།",
    "དེས་ན་དེ་ལ་ལྟོས་པའི་རྟོགས་པ་ནི་དངོས་པོ་ལ་ཡང་འགྱུར་བ་ཡིན་ནོ་ཞེས་དོགས་ན་འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "བརྡའི་རྗེས་སུ་འགྲོ་བ་མེད་པར་སྒྲ་ལས་དོན་རྟོགས་པ་མི་སྲིད་དོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "བརྡ་མེད་པར་ནི་གང་དུ་ཡང་སྒྲ་རྗོད་བྱེད་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་གཉིས་མཐོང་ལ་ཞེས་བྱ་བའི་རྣམ་འགྲེལ་ཉེ་བར་ིབཀོད་པ་ཁོ་ནར་འཆད་པ་ནི་སྒྲ་མེད་པར་ཡང་ཞེས་བྱ་བའོ།",
    "སྒྲ་མེད་པར་ཡང་ཞེས་བྱ་བར་ནི་བརྡ་ལ་མི་ལྟོས་པར་སྤྱིར་བློར་འགྱུར་རོ་ཞེ་ན་ལན་དེར་ཡང་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་བརྡ་ལ་མི་ལྟོས་སོ་ཞེས་བྱ་བར་བརྗོད་པ་ནི་རིགས་སོ་ཞེས་དོགས་པ་བསུ་ནས་བརྡ་སྨོས་པ་ནི་ཞེས་གསུངས་སོ་། རྟགས་ལ་ཡང་ལྟོས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྐབས་ཀྱིས་དངོས་པོའི་སྟོབས་ཀྱིས་བསྐྱེད་པའི་ཤེས་པའོ།",
    "གལ་ཏེ་བརྡ་དང་ལྷན་ཅིག་པའི་མངོན་སུམ་ནི་རིགས་ཀྱིས་གྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དེས་ན།",
    "ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པས་དངོས་པོ་ཡུལ་ཅན་མ་ཡིན་པ་ཉིད་དུ་བརྗོད་པ་ནི་བརྡ་ཙམ་ལ་ལྟོས་པ་ནི་ཞེས་བྱ་བའོ།",
    "མཐོང་བ་ལ་ནི་ཞེས་གསུངས་སོ།",
    "བྲམ་ཟེ་ཉིད་ནི་རིགས་ནི་མི་འགྱུར་ཞེས་བྱ་བ་ཇི་ལྟར་ཞེ་ན་དེ་ནི་དེ་ལྟར་ཞེས་གསུངས་ཏེ་བྲམ་ཟེ་ཉིད་དེ་ནི་བརྡ་མེད་པར་བཏགས་པའི་ཕྱིར་རོ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "ཨྰ་ང་བ་ཡིན་པར་ཇི་ལྟར་རྟོགས་ཤེ་ན།",
    "བསྟན་པ་མེད་པར་ཞེས་བྱ་བའོ།",
    "སྒྲ་གཅིག་འཇུག་པར་བྱ་བའི་དོན་དུའོ་ཞེ་ན།",
    "གོང་དུ་སྤོང་སོགས་ཞེས་གསུངས་སོ།",
    "རིགས་མེད་པར་ཡང་འགྱུར་རོ་ཞེས་ེཔའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མིག་ལ་སོགས་པ་དཔེ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་དེ་ནི་ཞེས་གསུངས་ཏེ་བློ་གཅིག་བསྐྱེད་པའོ།",
    "འདི་སྙམ་དུ་མིག་ལ་སོགས་པ་ལ་ཡང་བློ་གཅིག་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱི་སྤྱི་ཡོད་པ་ཁོ་ནའོ།",
    "དེས་ན་མེད་པར་བསྒྲུབ་པ་ལ་དེ་དག་དཔེ་ཉིད་དུ་ཇི་ལྟར་འགྱུར་ཞེས་དོགས་པ་བསུ་བ་ནི་དེ་དག་ལ་ཡང་ཞེས་བྱ་བའོ།",
    "སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱང་བློ་གཅིག་སྐྱེད་པ་ལས་གཞན་ནི་མེད་དོ་ཞེས་ལན་འདེབས་པ་ནི་ཁྲ་བོ་ལ་སོགས་པ་ལ་ཡང་ཞེས་བྱ་བའོ།",
    "བློ་གཅིག་བསྐྱེད་པ་ཉིད་སྤྱི་ཡིན་ནོ་སྙམ་པར་དོགས་པ་ནི་གལ་ཏེ་དེ་ཉིད་ཅེས་བྱ་བའོ།",
    "རྣམ་པར་འབྱེད་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་ངེས་པའི་གསལ་བས་གསལ་བར་བྱེད་པ་ཉིད་དང་རྟེན་དུ་བྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གསལ་བའི་རྒྱུ་ནི་ནུས་པ་ཉིད་ལས་རྣམ་པར་དབྱེ་བ་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པ་མ་ཡིན་ནོ་ཞེས་དོགས་པ་མེད་པ་བསུ་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཐ་དད་པ་རྣམས་ཀྱི་བློ་གཅིག་བསྐྱེད་པ་ཉིད་དུ་བཟློག་པར་བྱ་བ་མ་ཡིན་གྱི།",
    "མི་དམིགས་པ་མ་གྲུབ་པར་བརྗོད་པ་ནི་འབྲས་བུའི་སྒོ་ནས་ཀྱང་ཞེས་བྱ་བ་ནི་ལན་ནོ།",
    "མིག་ལ་སོགས་པ་བག་ཆགས་ཀྱི་ཁྱད་པར་ཡིན་པའི་ལུགས་བརྗོད་པ་ནི་གང་ཞིག་ཅེས་བྱ་བའོ།",
    "ཇི་ལྟ་ཞེ་ན་འབའ་ཞིག་པ་ཞེས་གསུངས་སོ།",
    "སྤྱི་འབའ་ཞིག་པ་མ་མཐོང་བ་དེ་དེའི་རང་བཞིན་ཉིད་ལས་ཉམས་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "གཟུགས་ནི་སྣང་བ་མེད་ཀྱང་དམིགས་པར་འགྱུར་གྱི།",
    "གསལ་བ་མེད་པར་ནི་སྤྱི་དམིགས་པ་མེད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གཟུགས་དང་རོ་ལ་སོགས་པ་ཡང་ཡུལ་གཅིག་པའི་ཕྱིར་ཐ་དད་ེདམིགས་པར་མི་འགྱུར་བ་ཞིག་མ་ེའགྱུར་བ་ཡང་ཡིན་ཏེ།",
    "ཤིན་ཏུ་འདྲེས་པ་ན་གང་ཞིག་གང་དང་ཡུལ་གཅིག་པ་ཞེས་ཁྱད་པར་དུ་བྱེད་པའི་ཕྱིར་མ་ངེས་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "༢༤༣པར་གྱུར་ཏམ་དེ་མ་འདྲེས་པ་ཉིད་དོ།",
    "དེས་ན་ཁྱད་པར་མེད་ཉིད་དུ་ཡུལ་གཅིག་པའི་གཏན་ཚིགས་རྒྱུ་ཡིན་པས་ད་ནི་དེ་ལ་དངོས་པོ་ཉིད་ཀྱང་མ་ངེས་པ་ཉིད་དུ་ཡང་བརྗོད་པ་ནི།",
    "ཡུལ་ཙམ་མ་གྲུབ་པ་ནི་ཤིན་ཏུ་གསལ་བར་དེའི་ཁྱད་པར་མ་གྲུབ་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་པོ་ལས་ཐ་དད་པར་ཞེས་བྱ་བ་ནི་འཆད་པའོ།",
    "ཡུལ་ཐ་དད་པ་ཡིན་དུ་ཟིན་ཀྱང་དེ་ལྟ་ོན་ཡང་དེ་ཐ་དད་པ་ནི་འདིར་མ་གྲུབ་པོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ན་ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "རྣམ་པར་རྟོག་པ་དང་གཞན་པའི་ཤེས་པ་ཙམ་གྱི་དོན་བྱ་བ་ལ་ཡང་སྤྱི་དེ་རུང་བ་མ་ཀྱུ།",
    "དེ་མི་རུང་ཕྱིར་ཞེས་གསུངས་སོ།",
    "དེ་ལ་ཡང་ཞེས་གསུངས་ཏེ།",
    "དེ་ཉིད་དང་གཞན་དག་ཏུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཤེས་པ་ཙམ་གྱི་དོན་བྱེད་པར་ཡང་མི་རུང་བའི་ཕྱིར་ན་སྤྱིར་མཚན་ཉིད་དོ།",
    "ཾཐ་སྙད་ལས་ཞེས་གསུངས་ཏེ།",
    "རྣམ་པར་དབྱེ་བ་མེད་པར་འཇུག་པ་ེལས་དེ་ལྟར་ཞེས་བྱ་བས་སྤྱི་ཉིད་དུ་བརྗོད་པ་ཡིན།",
    "གལ་ཏེ་རྣམ་པར་དབྱེ་བ་མེད་པར་འཇུག་པ་ལ་ཡང་ཇི་ལྟར་ཏེ་གསལ་བ་དུ་མའི་ཞེས་གསུངས་སོ།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་སྤྱི་ལ་ཞེས་དབྱེ་བ་མེད་ན་འོ་ན་ནི་ཡུལ་གྱི་དབྱེ་བས་བརྟགས་པ་ཐ་དད་པར་མི་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་ནས་དངོས་པོ་དང་།",
    "དངོས་པོ་མེད་པ་དང་གཉིས་ཀ་ལ་བརྟེན་པའི་སྒོ་ནས་ཞེས་གསུངས་སོ།",
    "རྟགས་གོ་ཅི་ལྟར་ཞེ་ན་དེ་བྱེད་པ་ཉིད་ཀྱིས་ཞེས་གསུངས་སོ།",
    "ཐ་དད་པ་ནི་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དངོས་པོ་མེད་པའི་ཡིན་ན་ནི་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "༢༤༧བཞིན་ཡིན་ེཡང་ཐ་དད་པར་མི་འགྱུར་ཏེ་ཤིང་ཤ་པ་ལས་ཤིང་ཉིད་བཞིན་ནོ།",
    "ཐ་དད་པ་ན་ཡང་དེའི་ཉེ་བར་ལེན་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་གཉིས་པའི་ཉེ་བར་ལེན་པ་ཅན་ཁོ་ན་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཐ་དད་པ་ཡང་ཞེས་བྱ་བའོ།",
    "དངོས་པོ་མེད་པ་ནི་བུམ་པས་སྟོང་པའི་ས་ཕྱོགས་༧རྗེས་སུ་དཔག་པའི་བདག་ཉིད་ཀྱི་རྣམ་པར་རྟོག་པ་གང་ལ་ཉེ་བར་ལེན་པ་དེ་གཉིས་ཡོད་པའི་དེའི་དངོས་པོ་ཉིད་ཀྱིས་ཉེ་བར་ལེན་པ་བརྒྱུད་པའི་རྒྱུ",
    "མེད་པ་ལ་སོགས་པའི་ཐ་དད་པ་གང་ཡིན་པ་དེ་ལས་རྣམ་པར་རྟོག་པའི་ཐ་དད་པ་ལ་བརྟེན་ནས་མེད་པ་ིལ་སོགས་པའི་ཡུལ་ཐ་དད་པ་ཡིན་ནོ།",
    "ོདངོས་པོ་གཉིས་ནི་ཞེས་གསུངས་སོ།",
    "སྣང་བ་ནི་འགྱུར་བ་ཡིན་ན་དེ་ལྟར་ན་ནི་སྤྱི་དངོས་པོ་ཡིན་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "དེའི་ཚེ་དངོས་པོ་ཤེས་པར་འགྱུར་གྱི་དངོས་པོ་མེད་པའི་སྤྱི་ནི་ཤེས་པར་མི་འགྱུར་རོ།",
    "ཡང་རྣམ་པར་རྟོག་པ་དངོས་པོ་ལ་བརྟེན་པའི་ཕྱོགས་ལ་ཉེ་བར་ེདོགས་པ་བསུ་བ་ནི།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ཡང་དངོས་པོ་ལ་བརྟེན་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཤེས་པ་ཙམ་གྱི་༧དོན་བྱེད་པར་ཡང་མི་རུང་ངོ་ཞེས་བྱ་བ་དང་།",
    "རྣམ་པ་གཞན་དུ་ཞེས་བྱ་བ་སྟེ་སྤྱི་མེད་པར་ཡང་ངོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་དེའོ།",
    "སྤྱིའི་རང་བཞིན་མ་ཁྱབ་པར་གྱི་རང་བཞིན་ནོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ལའོ།",
    "ལྟར་འཁྲུལ་པ་ཙམ་དུ་རྟོགས་པ་ཡིན་ནོ་ཞེས་རྗེས་སུ་འཇུག་པར་བྱ་བའོ།",
    "ལན་བཏབ་པའི་ཕྱིར་དང་ཞེས་བྱ་བས་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ཤེས་ཞེས་བྱ་བར་ིའདིར་ངེས་པར་བཟུང་བ་བརྗོད་པར་འདོད་པ་ཡིན་ནོ་ཞེས།",
    "རྣམ་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ལའོ།",
    "སྤྱི་ཞེས་བྱ་བ་ནི་ཞེས་གསུངས་སོ།",
    "དོན་དམ་པར་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ཡོད་པ་དང་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་དཔྱོད་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རྩོད་པ་སྨྲ་བ་ཉིད་ཀྱིས་འོན་ཏེ་ཡུལ་གཅིག་ཡིན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་དོགས་པ་བསུ་བ་ེནས་གཞལ་བྱ་ོདོན་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་དེ་ལྟ་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "ཅིའི་ཕྱིར་ཞེ་ནསྔོན་པོ་ལ་སོགས་པ་ཞེས་གསུངས་སོ།",
    "མཐའ་ཡས་པ་ཉིད་ཡིན་ན་ཇི་ལྟར་རྣམ་པ་གཉིས་ཡིན་སྙམ་ན་འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ཡང་ཐ་དད་ན་ནི་བརྟགས་པ་ཁོ་ནར་འགྱུར་ཞེས་གསུངས་པའོ་ནིལྟོས་པས་བྱས་པའི་ཞེས་བྱ་བའོ།",
    "འཇུག་པར་འགྱུར་རོ།",
    "མཚན་ཉིད་མིན་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཐ་དད་པའི་ཞེས་བྱ་བས་ཁ་བསྐང་ངོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་དོན་དམ་༤ པའི་མཚན་ཉིད་གསུངས་པ་ནི།",
    "དེ་ལས་བཟློག་པས་དམིགས་པ་ཉིད་ཡོད་པ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་ཞེས་ལན་བརྗོད་པ་ནི་དམིགས་པ་ཉིད་ནི་དངོས་པོ་རྣམས་ཀྱི་དོན་དམ་པའི་ཡོད་པ་ཡིན་ནོ་ཞེས་རྣམ་པར་གཞག་སྟེ་བཟློག་པས་དོན་དམིགས་པས་ནི་མེད་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "༢༥༥རྣམ་པ་གསུམ་དུ་རྣམ་པར་རྟོག་པ་ནི་དམིགས་པ་མེད་པ་ཡིན་ནམ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཅིའི་ཕྱིར་མི་རྟོགས་སྙམ་དུ་དོགས་པ་བསུ་བ་ནས་ཇི་ལྟར་དམིགས་པར་བྱ་བ་མེད་པར་ནི་དམིགས་པར་བྱ་བ་མ་ཡིན་པ་དེ་བཞིན་དུ་དམིགས་པ་མེད་པ་ཡང་དམིགས་པ་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བརྗོད་པ་ནི།",
    "གལ་ཏེ་དོན་བཞིན་དུ་ཤེས་པ་ལ་ནི་དམིགས་པ་གཞན་མེད་པ་དེ་ན་དེ་མེད་པས་དམིགས་པ་མེད་པ་རྟོགས་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་ཐུག་པ་མེད་པར་འགྱུར་སྙམ་དུ་དོགས་པ་བསུ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའཱོ།",
    "ཡོད་པར་མ་རྟོགས་ན་ཉེས་པ་ཅི་ཡོད་སྙམ་ན།",
    "ཡང་དོན་གྱིས་༧གོ་བས་ཞེས་བྱ་བ་ནི་དེ་ལྟར་དོན་གྱིས་གོ་བའི་བློ་གཞན་དང་གཞན་གྱིས་གཞན་དང་གཞན་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་ན།",
    "དེའི་ཕྱིར་ཤེས་པ་ལྐོག་ཏུ་གྱུར་པར་ཞེས་བྱ་བར་ནི་མི་འཐད་དེ།",
    "གལ་ཏེ་རིགས་པ་རྣམས་ནི་ཅི་ལྟར་ཤེས་པ་གཞན་གྱིས་མངོན་སུམ་དུ་བྱེད་པ་ཡིན་ན་དེའི་ཚེ་དེ་མེད་ཀྱང་དམིགས་པ་མེད་པ་གཞན་གྱིས་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ན།",
    "དེ་ཞེས་བྱ་བ་ནི་མངོན་སུམ་དུ་གྱུར་པའི་བློ་ེབཞིན་མེད་པར་རྟོགས་པ་ལའོ།",
    "ངོ་བོ་མེད་པར་ཁྱདམེད་པའི་ཕྱིར་རོ།",
    "དེ་མེད་པར་རྟོགས་པ་ལ་ཐུག་པ་མེད་པས་མ་གྲུབ་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་དོན་ཡོད་པར་འགྱུར་བ་དེ་བཞིན་དུ་དམིགས་པ་ཡང་ཡོད་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "མ་གྲུབ་པ་ཉིད་ཀྱི་ཉེས་པས་བཏང་སྙོམས་སུ་བྱས་ཏེ།",
    "མ་ངེས་པ་ཉིད་བརྗོད་པར་རྟོགས་པར་བྱའོ།",
    "དེན་དངོས་པོ་མེད་པ་༤ཐ་དད་པར་སྨྲ་བ་རྣམས་ཀྱི་ལྟར་ན།་",
    "དེ་ལྟ་ན་དངོས་པོ་དང་དམིགས་པ་དག་ཀྱང་དེའི་བདག་ཉིད་དུ་གྲུབ་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "ཤེས་པ་གཅིག་ལ་བདེ་བ་དམིགས་པས་ཀྱང་དེ་ལས་གཞན་དམིགས་པ་མེད་པར་ངེས་པར་བྱེད་པ་ཡིན་ཏེ་མ་འདྲེས་པའི་ཕྱིར་རོ།",
    "དགག་པར་བྱ་བ་དེའོ།",
    "འོན་ཀྱང་དགག་པར་བྱ་བ་གཞན་ལས་འཇུག་པ་མེད་པའོ།",
    "འདི་ཡོད་པར་དོགས་པ་བསུ་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བ་ནས་ཞེ་ན་ཞེས་བྱ་བའི་བར་གྱིས་སོ།",
    "དེ་ལ་ཡང་ཞེས་བྱ་བ་དགག་པར་བྱ་བ་ལ།",
    "སོ་སོར་ངེས་པའི་རྣམ་པ་དམིགས་པའི་ཕྱིར་དེ་མི་དམིགས་པར་ངེས་པ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "༢༥༩པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ཡང་ལྐོག་ཏུ་གྱུར་པ་དེས་ན་དོན་གྱིས་གོ་བ་གཞན་གྱིས་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "འོན་ཏེ་ངེས་པའི་རྣམ་པར་དམིགས་པ་ལས་ནི་མེད་པར་འགྲུབ་པ་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་རིག་པར་བྱས་པར་ནི་མི་དམིགས་པ་དེ་ཉིད་ཡིན་གྱི་དངོས་པོ་མེད་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དངོས་པོ་ནི་རང་དང་གཞན་ལ་ལྟོས་ནས་དངོས་པོ་དང་དངོས་པོ་མེད་པའི་རང་བཞིན་ཡིན་ཡང་དམིགས་པ་ཉིད་ཡོད་པ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་ཐ་སྙད་བྱེད་སྙམ་ན་སོ་སོར་ངེས་པའི་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་སོ་སོར་ངེས་པའི་རང་བཞིན་ནི་གཞལ་བྱ་མ་ཡིན་ནམ་དེས་ན་དེ་དམིགས་པར་ནི་གཞན་ཁོ་ན་ཡིན་པའི་ཕྱིར་ན།",
    "ལས་ནི་གལ་ཏེ་དམིགས་པར་བྱ་བའོ།",
    "དམིགས་པ་དྲན་པ་ཉིད་ལས་ཞེས་གསུངས་སོ།",
    "སྐྱེས་བུའི་གཞན་ལ་ལྟོས་ནས་ཀྱང་དམིགས་པར་བྱེད་པ་དེ་ནི་དེ་ལྟ་བུ་ཁོ་ན་ཞེས་བྱ་བ་དམིགས་པར་བྱ་བ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ནི་དམིགས་པར་བྱ་བའོ།",
    "དེ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ལན་ནོ་། དམིགས་པར་བྱ་བ་ཉིད་ཀྱིའོ།",
    "དམིགས་པར་བྱ་བའི་རང་བཞིན་ཉིད་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ཏེ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པའི་དུས་སུ་དམིགས་པར་བྱ་བའི་རང་བཞིན་དུ་མ་རྟོགས་པར་དམིགས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ནི་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "མ་དམིགས་པ་ནི་མ་ངེས་པས་དངོས་པོ་མེད་པར་བསྒྲུབ་པ་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི་ཡོད་ཀྱང་ཞེས་བྱ་བའོ།",
    "ོདངོས་པོ་ཡོད་ཀྱང་མ་ིདམིགས་སོ་ཞེས་དེ་སྐད་བརྗོད་པར་བྱ་བར་འགྱུར་གྱི།",
    "རྗེས་སུ་དཔག་པ་ཡང་མཐོང་བའི་རང་བཞིན་ཉིད་ཀྱི་རྗེས་སུ་འབྲང་བའི་དམིགས་པར་བྱ་བའི་རང་བཞིན་ལ་ནི་མ་ཡིན་ནོ།",
    "ཕྱིས་དམིགས་པར་བྱ་བ་ཉིད་གཞན་དུ་མི་འཐད་པས་སྔར་ཡོད་པ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི་གལ་ཏེ་སྔར་མེད་ན་ཞེས་བྱ་བའོ།",
    "དམིགས་པར་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བ་ལན་ནོ།",
    "༢ ཅཎྜ་ཡ་ཌ་དེ་ལྟར་རྟོགས་པ་ནི་བལྟ་ེབར་བྱ་བ་མ་ཡིན་པ་༤ཁོ་ནར་འགྱུར་ཏེ་ཞེས་དོགས་པ་བསུ་བ་ནི་དམིགས་པར་བྱ་བའི་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་མ་ཡིན་པའོ།",
    "དེའི་རང་བཞིན་དུ་ནི་དམིགས་པར་བྱ་བའི་རང་བཞིན་དུའོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་ཡིན་པར་རོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དུའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྗེས་སུ་དཔག་པའི་དུས་ན་ཡོད་པ་ཉམས་སུ་མ་མྱོང་ཡང་ཡོད་པར་རྟོགས་པ་ནི་མི་འཐད་དེ།",
    "རྗེས་སུ་དཔག་པ་ལས་ཡུལ་དུ་མ་བྱས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གཉི་ག་ཡང་དམིགས་པར་བྱ་བ་ཁོ་ནའི་ཡུལ་ཅན་ཡིན་ན།",
    "དམིགས་པར་བྱ་བ་ཉིད་དོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་ཡོད་པ་ཉིད་དུའོ།",
    "༢༦༣དམིགས་པར་བྱ་བའི་རང་བཞིན་ཉིད་དོ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་ལྟོས་པས་བྱས་པ་ཐ་དད་ན་དོན་དམ་མཚན་ཉིད་མིན་པར་འགྱུར་ཞེས་བརྗོད་པའི་རྩོད་པ་རྗེས་སུ་བརྗོད་པས་བདེན་ཏེ་ཞེས་བྱ་བས་ལན་འདེབས་པའོ།",
    "དངོས་པོ་ལ་མི་སླུ་བའི་སྒོ་ནས་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་བརྟག་པར་བྱ་བའི་དོན་གཅིག་ཏུ་བྱེད་པར་དངོས་པོ་ཉིད་ཡིན་པ་དེ་ལ་ལྟོས་ནས་སོ།",
    "རྩོད་པ་བརྗོད་པ་ནས་དེ་ནི་མི་རིགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པར་བྱེད་དོ།",
    "རྟོགས་པར་ཁས་ལེན་ན་ཡང་ཉེས་པ་ཡོད་དོ་ཞེས་བརྗོད་པ་ནི།",
    "རྟོགས་པའི་དབྱེ་བ་ཉིད་ཀྱིས་ཞེས་གསུངས་ཏེ།",
    "འདི་ཡང་རྣམ་པ་ཇི་ཞིག་ལྟར་གཅིག་ཉིད་གཉི་གའི་རང་བཞིན་ཡིན་པས་༧ཁས་བླངས་ནས་བརྗོད་པ་ཡིན་གྱི་དེ་ནི་དོན་དམ་པར་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "ལྟོས་པ་བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་བརྗོད་པ་ནི་ཡང་ན་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་གཅིག་ལ་ཡང་ལྟོས་པས་ཐ་དད་པར་མཐོང་བ་ཉིད་མ་ཡིན་ནམ།",
    "གཞན་གྱིས་ཡུལ་གཅིག་༧མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་ཐ་དད་པ་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "མངོན་སུམ་ལ་ལྟོས་པའི་གཉིས་པ་རྗེས་སུ་དཔག་པའི་རྟོག་པ་ནི་འཁྲུལ་པ་ཉིད་ཡིན་པར་འདོད་དོ།",
    "ལྷག་པར་ཞེན་སྙམ་ན།",
    "སྔར་མཐོང་བའི་དོན་གྱིས་ཞེས་གསུངས་སོ།",
    "འཁྲུལ་པ་ཞེས་གསུངས་ཏེ་གཞན་རྟོགས་པ་ན་གཞན་ཐོབ་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁྲུལ་པ་ཉིད་ཡིན་པར་འགྱུར་ཞེ་ན།",
    "རྣམ་གཞན་གྱིས་ཀྱང་ཞེས་གསུངས་སོ།",
    "ཇི་ལྟར་དཀར་པོ་ལ་སེར་པོའི་རང་བཞིན་དུ་འཁྲུལ་པར་རྟོག་པ་མཐོང་བ་དེ་བཞིན་༤དོན་གྱི་རང་བཞིན་གསལ་བ་ཡང་མི་གསལ་བའི་རྣམ་པར་རྟོག་པའི་ཕྱིར་འགལ་བ་མེད་དོ།",
    "རྣམ་གཞན་གྱིས་ཀྱང་ཞེས་གསུངས་པའོ།",
    "དཔེར་ན་ལྷ་སྦྱིན་མཆོད་སྦྱིན་དུ་རློམ་པ་ལས་འཇུག་པ་ཡིན་ནོ་། ཡང་ན་རྗེས་སུ་དཔག་པའི་རང་བཞིན་ལས་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "ཐོབ་པར་བྱ་བ་ཉིད་སྣང་བ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་རྟོགས་པར་མི་བྱེད་སྙམ་ན།",
    "ཕྱོགས་འདི་ལ་ཞེས་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པ་དངོས་པོར་འཛིན་པ་ནི་བཀག་ཟིན་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པའི་རྟོག་པ་དོན་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པར་ལྷག་པར་ཞེན་པ་ཇི་ལྟར་ཡིན་ཏེ།",
    "འོ་ན་ཇི་ལྟར་རྗེས་སུ་དཔག་པ་དོན་ཇི་བཞིན་མ་ཡིན་པ་རྟོགས་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "འདི་ནི་འཆད་པར་བྱེད་པ་རྣམས་ཀྱིས་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པ་དོན་ལ་ངེས་པ་མ་ཡིན་ན་ནི་ཇི་ལྟར་དེ་ལས་སོ་སོར་ངེས་པའི་དོན་ལ་འཇུག་སྙམ་དུ་དོགས་པ་སེལ་བས།",
    "ཞེས་བྱ་བ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "ཅིའི་ཕྱིར་འདི་བརྩད་པར་བྱ་བ་མ་ཡིན་སྙམ་ན།",
    "མཐོང་བ་ལ་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ཡང་ཞེས་གསུངས་པ་སྟེ།",
    "སྒྲུབ་པར་བྱེད་པའི་མངོན་སུམ་ལ་ཡང་ངོ།",
    "ཇི་ལྟར་ཞེ་ན་ཉེ་བར་གནས་པ་ཞེས་གསུངས་སོ།",
    "ཉེས་ན་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པ་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པ་ཡིན་པའི་ཕྱིར་ན།",
    "ཉེ་བར་གནས་པ་ཙམ་ནི་ཞེས་གསུངས་སོ་། འཇུག་པ་ནི་འཐོབ་པའི་དོན་དུ་ཡིན་ན་དེ་ལ་ཡང་བྱུང་ཟིན་པ་ཞུགས་པས་ཅི་བྱ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གཅིག་ཏུ་ལྷན་ཅིག་ལྷག་པར་ཞེན་པས་ནའོ།",
    "མཚུངས་པ་ཉིད་མི་འཐད་པར་དོགས་པ་བསུ་བ་ནི་འོན་ཀྱང་ཞེས་བྱ་བའོ་། མངོན་སུམ་ནི་གཅིག་ཏུ་ལྷག་པར་ཞེན་པའི་རྣམ་པར་རྟོག་པ་སྐྱེད་པའི་སྒོ་ནས་འཇུག་པར་བྱེད་པ་ཡིན་ལརྗེས་སུ་དཔག་པ་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་རྟོག་པ་གཞན་གྱིས་ཀྱང་འཇུག་པར་བྱེད་པ་ཉིད་ཇི་ལྟར་འགྱུར་སྙམ་ན།",
    "རྣམ་རྟོག་གཞན་ནི་གནས་པར་འགྱུར།",
    "ཞེས་གསུངས་སོ་། དེས་ན་དེའི་སྒོ་ནས་དེ་ཡང་འཇུག་པར་བྱེད་པ་༤ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བསྟན་པར་བྱ་བའི་དོན་འདུ་བ་ཡིན་ནོ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ཐ་དད་པ་མེད་པའོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་རང་བཞིན་དེ་ཉིད་ཅེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡང་འཇུག་པར་བྱེད་པ་ཉིད་མེད་པའི་ཕྱིར་ན་ཇི་ལྟར་དེའི་སྒོ་ནས་མངོན་སུམ་འཇུག་པར་བྱེད་པ་ཡིན་ཞེས་བྱ་བ་ིལན་འདེབས་པ་ནི།",
    "འོན་ཏེ་འཇུག་པར་བྱེད་པ་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱིས་འཇུག་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན་དེ་ནི་མི་རིགས་ཏེ་ཅིའི་ཕྱིར་ཞེ་ན་དེ་རང་ཉིད་ཅེས་གསུངས་སོ།",
    "འཇུག་པར་བྱེད་པའི་རྣམ་པར་རྟོག་པ་བསྐྱེད་ེཔའི་སྒོ་ཁོ་ནས་འཇུག་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་དོགས་པར་བྱེད་པ་ནི་གལ་ཏེ་རྣམ་རྟོག་ཅེས་བྱ་བའོ།",
    "དངོས་འཛིན་མིན་པར་འཇུག་བྱེད་དུ།",
    "རྣམ་པར་རྟོག་པ་དངོས་པོ་འཛིན་པ་མ་ཡིན་ཡང་འཇུག་བྱེད་ཡིན་ན་ནི།",
    "དངོས་པོ་འཛིན་པ་མ་ཡིན་ཡང་གལ་ཏེ་རྣམ་པར་རྟོག་པ་འཇུག་པ་སྟེ་ཡིན་ན།",
    "དེའི་ཚེ་རྗེས་སུ་དཔག་པ་ལ་ཡང་འཇུག་པར་བྱེད་པ་འདི་ཅིས་མི་འདོད་དེ།",
    "འདོད་པར་བྱའོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པ་ཡང་དེ་འདོད་པར་བྱ་བའོ་ཞེས་ཅི་སྟེ་བརྗོད་ན།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པ་ཉིད་བསྐྱེད་པའི་སྒོ་ནས་ཞེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་མངོན་སུམ་པར་རྟོག་པ་སྐྱེད་ེཔའི་སྒོ་ནས་འཇུག་པར་བྱེད་པ་ཉིད་དུ་འདོད་ན།",
    "དེ་ལྟ་ཡིན་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པར་འཇུག་པར་བྱེད་པ་ཉིད་དུ་ཁས་ལེན་པ་ཡིན་ནའོ།",
    "རྣམ་པར་རྟོག་པ་ཞེས་སྨོས་ཏེ།",
    "སྔ་མ་དང་ཕྱི་མར་གྱུར་པའི་དངོས་པོའི་རྒྱུན་རྣམ་པར་བརྟག་པར་བྱ་བ་སྟེ་དེ་ལའོ།",
    "དེ་ལྟར་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྐད་ཅིག་ལ་ཞུགས་པས་རྒྱུན་ལ་ཞུགས་པར་འགྱུར་བའོ།",
    "འོན་ཏེ་ཉེ་བར་བཏགས་པས་རྗེས་སུ་དཔག་པ་ལ་དོན་ལ་ཞུགས་པས་ཐ་སྙད་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་གཞན་གྱི་ལམ་ཟློག་པར་བྱེད་པ་ནི་དེ་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་ཞེས་བྱ་བ་ནི་ཟློག་པར་བྱེད་པའོ།",
    "ཡང་རྣམ་པ་གཞན་གྱི་སྒོ་ནས་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་ཁྱད་པར་ཡོད་པར་དོགས་པ་བསུ་ནས་སེལ་བ་ནི་མངོན་སུམ་ནི་དེའི་རིགས་ལ་ཞེས་བྱ་བ་སྟེ།",
    "རྗེས་སུ་དཔག་པ་བཞིན་དུ་རྣམ་པར་རྟོག་པ་ཡང་དངོས་པོའི་ཡུལ་ཅན་མ་ཡིན་པའི་ཕྱིར་ན་དེའི་རིགས་ཅན་ལ་མི་འཇུག་གོ།",
    "ཇི་ལྟར་ཞེ་ན་རྗེས་སུ་དཔག་པའི་ཡུལ་ཞེས་གསུངས་སོ།",
    "གཉི་ག་ལ་ནི་རྣམ་པར་རྟོག་པ་དང་རྗེས་སུ་དཔག་པ་དག་ལའོ།",
    "ལྷག་པར་བརྗོད་པའི་དོན་དུ་ཡང་དོགས་པ་བསུ་བ་ནི།",
    "༢ ཚེ་སྤྱིརཔར་ཁྱད་པར་མེད་སྙམ་ན་རྒྱུ་དང་འབྲས་བུའི་འབྲེལ་པ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པའི་ཡུལ་ལ་ཡང་ཞེས་གསུངས་ཏེ།",
    "རྣམ་པར་རྟོག་པའི་ཡུལ་འབའ་ཞིག་ལ་ཡིན་པར་ནི་མ་ཟད་དོ།",
    "གང་ཞིག་དེའི་རིགས་ཡིན་པ་དེ་ནི་ཚང་བང་ལ་སོགས་པར་མངོན་སུམ་གྱི་ཡུལ་དུ་གྱུར་པ་ཡིན་ནོ།",
    "འདི་ནི་མངོན་སུམ་གཉིས་ཀྱི་ཁྱད་པར་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "འདི་ལ་ནི་རྣམ་པར་རྟོག་པ་ལའོ།",
    "གཞན་དག་ཁྱད་པར་བརྗོད་པ་ནི།",
    "འདིར་ནི་རྣམ་པར་རྟོག་པ་ལའོ།",
    "འདི་ཡང་སྔོན་པོ་ཡིན་ནོ་ཞེས་ངེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "འཇུག་པར་བྱ་བ་ལ་ནི་ཐོབ་པར་བྱ་བ་ལའོ།",
    "ཐོབ་པར་བྱ་བ་ནི་ཡུལ་མེད་ན་མདུན་ན་གནས་པའི་རྣམ་པ་ཉིད་ནི་འཁྲུལ་པ་དག་ལ་མཚུངས་པས་ན།",
    "འཁྲུལ་པ་ཡང་ད་ལྟར་བ་ཁྱད་པར་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དོན་ཡོད་པ་དང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཡོད་པར་དོགས་པ་བསུ་བའོ།",
    "མི་སླུ་བ་མེད་པར་ཞེས་བྱ་བའོ།",
    "མདུན་ན་གནས་པའི་རྣམ་པ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྐྱེས་བུ་གཞན་གྱི་མི་སླུ་བ་ལས་དངོས་པོའི་ཡུལ་ཅན་ཉིད་ཡིན་པ་དེ་ཡང་རྗེས་སུ་དཔག་པས་རྟོགས་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པའི་དངོས་པོའི་ཡུལ་ཅན་མ་ཡིན་པ་ེན་གཞན་དངོས་པོའི་ཡུལ་ཅན་དུ་ཇི་ལྟར་རྣམ་པར་འཇིག་པར་བྱེད།",
    "དེ་བས་ན་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་ནི་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཞེས་གསུངས་ཏེ།",
    "དེ་ལྟ་ེམ་ཡིན་ན་ཞེས་བྱ་བ་ནི་དངོས་པོ་འཛིན་པར་ཉེ་བ་ཁོ་ན་མ་ཡིན་ནའོ།",
    "དེ་ལ་འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་ཐོབ་པར་བྱ་བའི་རང་བཞིན་མ་རྟོགས་ན་འོ་ན་ཇི་ལྟར་འཐོབ་ཅེ་ན།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དོན་དམ་པར་འབྲེལ་བར་ངེས་པར་བྱ་མི་ནུས་པའི་ཕྱིར་གཞན་དག་རྐང་པ་བརྐྱང་བ་ཙམ་གྱིས་དོགས་པར་བྱེད་པ་ནི་དེ་ལྟ་བུ་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "ཐོབ་པར་བྱ་བ་དེར་རོ་། དེ་ཉིད་ཅེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མ་ཡིན་པའོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་འབྲེལ་པ་འཛིན་པའོ་། ཁས་མི་ལེན་པའི་རྒྱུ་དོགས་པར་བྱེད་པ་ནི་དེ་ཉིད་ཅེས་བྱ་བ་སྟེ་ཁྱབ་པ་འཛིན་པའོ།",
    "འདི་ནི་རྣམ་པར་རྟོག་པ་ལ་ཡང་མཚུངས་སོ་ཞེས་ལན་བརྗོད་པ་ནི་རྟོག་པ་སྐྱེ་བའི་ཞེས་བྱ་བའོ།",
    "རྒྱུ་དང་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པ་ཡང་དོན་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་བསམས་པའོ།",
    "སྔ་མ་དག་ཅེས་གསུངས་སོ།",
    "ངེས་པར་འབྱེད་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་དོགས་པ་བསུ་ནས།",
    "༢༧༩ཐེ་ཚོམ་ཟ་བ་ནི་ཞེས་གསུངས་སོ།",
    "འདིས་ནི་ཇི་སྐད་དུ་ཤེས་པའི་སྐད་ཅིག་དང་པོ་ཉིད་ཀྱིས་དོན་བཟུང་ཞིང་ནང་དུ་འདུས་པའི་ཞེན་པས་ངེས་པར་ཡང་བྱས་པ་ཡིན་ཏེ་དེ་མ་ངེས་ན་ཡུལ་དེ་ལ་འཛིན་པར་མི་འཐད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི་གསལ་བ་ཡིན་ཏེ།",
    "འགའ་ཡང་ཞེས་བྱ་བ་ནི་མངོན་སུམ་སྔ་མའམ་ཕྱི་མ་ཡང་སྟེ་མདུན་ན་གནས་པའི་རྣམ་པ་ཅན་ཉིད་དུ་ཁྱད་པར་ཕྱིར།",
    "རྗེས་སུ་དཔག་པ་ནི་མ་ཡིན་པར་འགྱུར་བ།",
    "འདིར་ནི་མངོན་སུམ་ཡིན་པར་འདོད་དོ།",
    "གཞན་གྱི་རང་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཐོབ་པར་བྱ་བ་ལས་གཞན་གྱི་རང་བཞིན་དུའོ།",
    "༧གཞན་ཞེས་བྱ་བ་ཐོབ་པར་བྱ་བ་ལས་གཞན་ལ་རྟོགས་པ་ཉིད་༤ག་ལ་ཡང་ཞེས་འབྲེལ་ཏོ།",
    "རྣམ་པར་བརྟག་ེཔར་བྱ་བ་ནི་མི་གསལ་བ་ཡིན་ལ།",
    "ལྷག་པས་ཞེས་གསུངས་ཏེ་ལྷག་མ་ནི་ཁྱད་པར་དུ་འཕགས་པ་སྟེ།",
    "ཕྱེད་ཕྱི་མ་རྣམ་པར་འགྲེལ་པ་ནི་གང་དུ་ཤིན་ཏུ་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་མ་ཡིན་ནམ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ལ་རག་ལས་པས་འཇུག་པར་བྱེད་པ་ཉིད་ཡིན་པའོ།",
    "རྣམ་པར་རྟོག་པ་ནི་མ་ཡིན་ཏེ།",
    "དཔྱད་ཟིན་ཏོ་ཞེས་བྱ་བ་ནི་ཅི་རྣམ་པར་རྟོག་པ་ལ་འཇུག་པར་བྱེད་པ་ཉིད་ཡོད་དམ་ཞེས་བྱ་བ་དེར་རོ།",
    "དེས་ནི་རྣམ་པར་འཇོག་པས་སོ།",
    "འོན་ཀྱང་སྟེ་ཞེས་བྱ་བ་རྣམ་པར་རྟོག་པས་སོ།",
    "ལན་ནི་མངོན་སུམ་ཞེས་བྱ་བ་སྟེ་རྣམ་པར་རྟོག་པ་ཉིད་ཀྱིས་འཇུག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མངོན་སུམ་གྱི་འོག་རོལ་གྱི་དུས་སུ་འཇུག་པའི་རྣམ་པར་རྟོག་པ་འཇུག་པ་ལ་མངོན་སུམ་ནུས་པ་ཡོད་པ་ཡིན་ན་ཞེས་རྣམ་པར་དབྱེ་བ་བསྒྱུར་ཏེ་འབྲེལ་ཏོ།",
    "གཞན་ཞེས་བྱ་བ་ནི་འཇུག་པར་བྱ་བ་མ་ཡིན་པའི་རྣམ་པ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཞེས་གསུངས་སོ།",
    "ཤེས་པ་མེད་༤ཕྱིར་རོ་ཞེས་ཡོངས་སུ་གཅོད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་འཇུག་པའི་ཡུལ་ཤེས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་མི་ཤེས་པ་ཞེ་ན་སྐད་ཅིག་མ་༧སྔ་མ་ཞེས་གསུངས་སོ།",
    "ཡོངས་སུ་གཅོད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མ་གྲུབ་པར་དོགས་པ་བསུ་བ་ནི་འོན་ཏེ་ཡང་ཞེས་བྱ་བའོ།",
    "ལན་ནི་འཇུག་པར་བྱེད་པའི་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པར་ནི་མངོན་སུམ་འཇུག་བྱེད་དུ་མ་མཐོང་ངོ།",
    "སྣང་བ་ཙམ་གྱིས་ནི་ཞེས་གསུངས་སོ།",
    "ལན་ནི་རྣམ་པར་རྟོག་པ་ཡང་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་གཉི་ག་ཡུལ་གཅིག་ཡིན་པ་ཇི་ལྟར་ཡུལ་གྱི་དབྱེ་བས་ཐ་དད་པར་འགྱུར་ཞེ་ན།",
    "ཅེས་བྱ་བ་ལེགས་པར་བརྗོད་པ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་༧དེས་ན་གཞན་གྱི་ཞེས་བྱ་བའོ།",
    "སྒོ་གསེབ་ཀྱི་བུ་ག་ན་ཡོད་པའི་ནོར་བུ་དབྱིབས་ཀྱི་ཁྱད་པར་གང་ལ་ཡོད་པ་དེ་ནི་དེ་སྐད་ཅེས་བརྗོད་དོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་ཐོབ་པས་བྱས་པའི་ཁྱད་པར་ཡོད་པས་སོ།",
    "ཚོགས་པའི་ཞེས་གསུངས་སོ།",
    "རྒྱུ་ཐ་དད་ལས་ཐ་དད་པར་ནི་གདོན་མི་ཟ་བར་འདོད་དགོས་ཏེ།",
    "ཇི་ལྟར་དངོས་པོ་ཉིད་ལ་སོགས་པར་ཁྱད་པར་དང་ལྡན་པར་འགྱུར་བ་དེ་བཞིན་དུ་འཁྲུལ་པ་ཉིད་དུ་ཁྱད་པར་མེད་ཀྱང་རྒྱུའི་ཁྱད་པར་ལས་འགའ་ཞིག་མི་སླུ་ྱབ་དང་ལྡན་པར་འགྱུར་བ་ཡིན་གྱི།",
    "རྗེས་སུ་དཔག་པ་འཁྲུལ་ལས་གཞན་ཁྱད་པར་ཡོད་པར་བརྗོད་པ་ནི་འབྲེལ་པའི་ལས་ཞེས་བྱ་བའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་རྣམ་པར་འགྲེལ་པ་ནི།",
    "དཔེར་རྣམ་པར་འགྲེལ་པ་ནི་མངོན་སུམ་ཡང་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་དེ་དཔེ་ཡིན་སྙམ་ན་འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "འོ་ན་འདི་གཉིས་ལ་ཁྱད་པར་ཅི་ཡོད་སྙམ་ན་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་གཉིས་ཀྱི་ཁྱད་པར་ནི་འདི་ཉིད་ཡིན་ཏེ།",
    "མྱོང་བའི་རྗེས་དཔག་ཉིད་འཇུག་བྱེད་མ་ཡིན་པ་ལ་མ་ཡིན་༧ཡང་འཇུག་པར་བྱེད་པའི་མངོན་སུམ་ལ་ཡང་སྔར་དེའི་རང་བཞིན་གྱི་རྗེས་སུ་དཔག་པ་ལ་གདོན་མི་ཟ་བར་ལྟོས་པར་བྱ་བ་ཡིན་ཏེ།",
    "༢་ཆགླ་ཆ་མེ་ལ་སོགས་པ་སྒྲུབ་པའི་རྗེས་སུ་དཔག་པ་ལ་ལར་ནི་གདོན་མི་ཟ་བར་ཕྱིས་ཀྱི་མངོན་སུམ་ལ་ལྟོས་པར་བྱ་བ་ཡིན་ཏེ།",
    "གཉི་ག་ལས་གཅིག་ཀྱང་གཞན་ལ་མི་ལྟོས་པ་ཞེས་བྱ་བའི་ཁྱད་པར་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཇི་སྐད་བརྗོད་པའི་སྔ་མ་དང་ཕྱི་མའི་དངོས་པོ་འགོག་པར་བྱེད་པའི་ཕྱེད་ཕྱི་མས་ཁྱད་པར་ཡོད་པར་དོགས་པ་བསུ་བ་ནི།",
    "རྗེས་སུ་དཔག་པ་ནི་མངོན་སུམ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པའི་ཕྱིར་ཁྱད་པར་ཡོད་པས་ཇི་ལྟར་ཁྱད་པར་མེད་ངེས་ཞེས་བྱ་བའི་དོགས་པའི་དོན་ཏོ། ། གལ་ཏེ་མངོན་སུམ་སྐྱེས་པས་ན་རྗེས་སུ་དཔག་པ་ལ་མི་ལྟོས་ཀྱང་ཐ་སྙད་ནི་ལྟོས་པ་ཁོ་ན་སྟེ།",
    "ཐ་དད་པར་༤ཡང་མི་འགྲུབ་པོ་ཞེས་སྦྱར་རོ།",
    "རྩིག་པ་ལ་སོགས་པས་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་རྗེས་སུ་དཔག་པ་༧མངོན་སུམ་ལ་ཇི་ལྟར་ལྟོས་སྙམ་ན་རྩིག་པའི་ཕྱི་རོལ་གྱི་ཞེས་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པར་རྟོགས་པར་མི་སྐྱེ་བར་མི་འགྱུར་ཏེ།",
    "ཐེ་ཚོམ་ཟ་དང་ཞེས་གསུངས་སོ།",
    "ནོར་བུའི་འོད་ལ་ནོར་བུའི་ཤེས་པ་ལས་རྗེས་སུ་དཔག་པའི་ཁྱད་པར་དོགས་པར་བྱེད་པ་ནི་འོན་ཏེ་ཡང་ཞེས་བྱ་བའོ།",
    "ཟླ་སྐན་ཉིད་༢༨༨ངེས་པ་ལ་ཡང་ཐེ་ཚོམ་གྱི་ཾབདག་ཉིད་ཡིན་པའི་ཕྱིར་ན་དེ་ལ་འཇུག་པར་བྱེད་པ་ཉིད་དུ་འཐད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་གཉི་གའི་ཆ་ལ་ཞེས་བྱ་བའོ།",
    "ཕྱིན་ཅི་ལོག་ནི་དེ་ལྟ་མ་ཡིན་པ་དེས་ནི་འཇུག་པར་བྱེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་ཕྱིན་ཅི་ལོག་ནི་ཞེས་བྱ་བའོ།",
    "ཆ་གཉིས་སུ་ཞེན་པ་དེས་ན་སྟོན་པར་བྱེད་པ་མ་ཡིན་པ་དེས་ན་དེ་ལ་འཇུག་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁྲུལ་པ་ཉིད་ཀྱིས་མངོན་སུམ་མ་ཡིན་པར་དོགས་པས་ན་འདྲི་བ་ནི་ཇི་ལྟར་ཞེས་བྱ་བའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འཁྲུལ་པ་དང་མ་འཁྲུལ་ཞེས་གསུངས་སོ།",
    "དེ་མེད་པར་མ་འཁྲུལ་བ་ཉིད་མི་འཁྲུལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་སླུ་བ་ཉིད་ལ་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ག་ལས་སྙམ་ན་མི་སླུ་༤བ་མ་ཡིན་པ་ཞེས་གསུངས་སོ།",
    "འཁྲུལ་པ་དང་མ་འཁྲུལ་པ་ཉིད་ལས་ཁྱད་པར་གཞན་ནི་མེད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མ་འཁྲུལ་བའི་དོན་ནི་མི་སླུ་བའི་དོན་ཡིན་པའི་ཕྱིར་ན་དེ་ལས་ནི་ཁྱད་པར་ཡོད་པ་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་རྣམ་པར་རྟོག་པ་དང་ཅིག་ཤོས་ཉིད་ཀྱིས་ཡིན་ནོ་ཞེས་ལན་བརྗོད་པ་ནི།",
    "འཁྲུལ་བ་ཉིད་དུ་ཁྱད་པར་མེད་ན་ཇི་ལྟར་སྣང་བ་ཐ་དད་སྙམ་ན་འཁྲུལ་བ་ཉིད་ལས་ཡང་ཞེས་གསུངས་སོ།",
    "ཇི་ལྟར་མངོན་སུམ་སྣང་བ་དང་རྗེས་སུ་དཔག་པ་དག་སྣང་བ་དང་རྣམ་པར་རྟོག་པ་དང་ཅིག་ཤོས་ཉིད་ཀྱིས་ཐ་དད་པ་དེ་བཞིན་དུ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་ཀྱང་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་ཁྱད་པར་མེད་ཅེ་ན།",
    "འཁྲུལ་པ་ནི་ཞེས་གསུངས་སོ།",
    "དེས་ན་ཡུལ་ཐ་མི་དད་པར་རློམ་པ་ཡིན་གྱི་ནོར་བུའི་འོད་ལ་ནོར་བུར་ཤེས་པ་ལ་ནི་དེ་ལྟ་མ་ཡིན་ནོ།",
    "ཤིན་ཏུ་ཞེས་གསུངས་སོ།",
    "སྤྱིའི་མཚན་ཉིད་དེ་མ་ཐག་ཏུ་འཆད་པར་འགྱུར་རོ།",
    "ཡུལ་གཞན་དུ་སྒྲོ་འདོགས་པ་ལྷག་པ་ཡོད་དོ་ཞེས་བྱ་བ་འདི་ཙམ་ཞིག་བརྗོད་པར་བྱ་བ་ཡིན་ན་ནི།",
    "ནོར་བུར་འཁྲུལ་པ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པར་དྲན་པ་མེད་དོ་ཞེ་ན།",
    "གཉི་ག་ལྟར་ཡང་ཞེས་གསུངས་ཏེ།",
    "ཐོབ་པར་བྱ་བའི་ཞེས་བྱ་བ་ནི་འཆད་པའོ།",
    "ཇི་ལྟར་ཁྱད་པར་མེད་དེ།",
    "དེས་ན་མིག་སེར་པོར་ཤེས་པ་བཞིན་དུ་ནོར་བུ་སྣང་བ་ཙམ་ནི་མངོན་སུམ་ལྟར་སྣང་བ་ཡིན་ནོ་ཞེས་དོགས་ན་ནི་ནོར་བུ་སྣང་བ་ནི་ནོར་བུ་ཉིད་དང་ཞེས་གསུངས་སོ།",
    "བདེན་པའི་ནོར་བུའི་སྣང་བ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྣང་བ་ཁྱད་པར་མེད་ཀྱང་ནོར་བུའི་འོད་ལ་ནོར་བུར་ཤེས་པ་ནི་ཡུལ་ལ་འཁྲུལ་པ་ཡིན་ལ་ནོར་བུའི་ཤེས་པ་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལ་ལར་ནི་ཞེས་གསུངས་སོ།",
    "འཁྲུལ་པ་ཉིད་དུ་ཡང་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ལ་ཞེས་བྱ་བ་ནི་དྲན་པར་བྱེད་དོ།",
    "བར་ཆད་མེད་པར་འཛིན་པ་ཡིན་པས་དེ་ནི་མངོན་སུམ་ཡིན་ཏེ།",
    "དེ་ལ་ནི་ཞེས་གསུངས་ཏེ་གང་ཞིག་བག་ཆགས་སད་པས་སྣང་བའི་ཡུལ་དུ་གྱུར་པའོ།",
    "འོན་ཏེ་རྗེས་སུ་དཔག་པས་རྣམ་པར་རྟོག་ཀྱང་མེའི་རང་བཞིན་མ་རྟོགས་པའི་ཕྱིར་ལྐོག་ཏུ་གྱུར་པ་ཡིན་ནོ་སྙམ་ན།",
    "ལྐོག་ཏུ་གྱུར་པའི་ཡུལ་ཅན་གང་ཡིན་པར་ནི་འགལ་བ་དེའི་ཕྱིར་རོ།",
    "༢༩༧དངོས་པོ་འཛིན་པར་མི་འགྱུར་རོ།",
    "འདི་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "མཚན་པར་བྱས་པའི་སྤྱིས་མཚོན་པར་ངེས།"
