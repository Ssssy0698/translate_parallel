    "དེ་ལ་ཁ་ཅིག་ནི་བྱས་པ་ཡིན་ཏེ་བུམ་པ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "ལ་ལ་ནི་མ་བྱས་པ་ཡིན་ཏེ།",
    "སྐྱེ་བ་དང་ལྡན་པའི་བྱས་པའི་དངོས་པོ་རྣམས་ཀྱང་འཇིག་པ་ལ་ལྟོས་པ་མེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱེ་༥གཏན་ཚིགས་སོ།",
    "རྒྱུ་གཞན་ཞེས་བྱ་བའི་རང་བཞིན་གཏན་ཚིགས་དེ་ཡང་ནི་སྐྱེད་པར་བྱེད་པ་ལས་ཐ་དད་པའོ།",
    "ཡང་ན་གང་དག་གང་དུ་ཡང་མ་ངེས་པ་དེ་དག་ནི་དེ་ལ་ལྟོས་པ་མེད་པ་ཡང་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "འདི་དག་སྐྱེས་མ་ཐག་ཏུ་འཇིག་པ་ཉིད་དུ་བསྒྲུབ་པར་འདོད་པ་མ་གྲུབ་པའོ།",
    "འོ་ན་གལ་ཏེ་རྣམ་པ་ཐམས་ཅད་དུ་ལྟོས་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གཏན་ཚིགས་ཀྱི་དོན་ཡིན་པར་འདོད་ན།",
    "འདི་ལྟར་འགའ་ཞིག་དག་འཇིག་པ་ལ་ཐོ་བ་དུ་ལ་སོགས་པ་ལ་ལྟོས་པར་མཐོང་སྟེ།",
    "གང་ཡང་བློ་དང་སྒྲ་ལ་སོགས་པ་ལྟོས་པ་མེད་པ་ཉིད་དུ་གྲགས་པ་དེ་དག་ཀྱང་གལ་ཏེ་ཐོ་བ་ལ་སོགས་པ་ལ་མི་ལྟོས་པ་དེ་ལྟ་ན་ཡང་ཡུལ་དང་དུས་ལ་ལྟོས་པས་དེའི་ཕྱིར་གཏན་ཚིགས་མ་གྲུབ་པ་ཡིན་ནོ་ཞེས་དོགས་པར་བྱས་ནས་ལན་གདབ་པར་བྱ་བའི་ཕྱིར།",
    "ཕན་མི་འདོགས་པ་ཡང་ལྟོས་པར་མི་རིགས་ཏེ།",
    "དངོས་པོ་ཡོད་པ་ལ་ནི་རྣམ་པར་རྟོག་པ་གཉིས་ལས་མི་འདའ་བའི་ཕྱིར།",
    "དེ་ཡང་དངོས་པོའི་རང་བཞིན་བཞིན་དུ་དེ་ལས་ཐ་མི་དད་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "གྲུབ་པ་ཡང་བྱེད་པར་མི་རིགས་ཏེ།",
    "དེའི་ཕྱིར་རྒྱུ་གཞན་གྱིས་འཇིག་པར་བརྗོད་པའི་རང་བཞིན་གཞན་ཐོབ་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཇི་ལྟར་དེའི་དུས་ཕྱིས་རྒྱུ་གཞན་གྱེས་རང་བཞིན་གཞན་བྱེད་པར་འགྱུར།",
    "དེ་དང་འབྱེལ་པའི་འཇིག་པ་བྱེད་པའི་ཕྱིར་དངོས་པོ་ལ་ཕན་བཏགས་པར་འགྱུར་རོ་ཞེས་ཀྱང་བརྗོད་པར་མི་རིགས་ཏེ།",
    "འདི་ལྟར་ཐ་དད་པར་ཁས་བླངས་པའི་ཕྱིར་དེའི་ཏྲཱི་བདག་ཉིད་ཀྱི་མཚན་ཉིད་ཀྱི་འབྱེལ་པ་མེད་ལ།",
    "གེགས་བྱས་པའི་ཕྱིར་དམིགས་པ་ལ་སོགས་པའི་འབྲས་བུ་བྱེད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དངོས་པོའི་རང་བཞིན་བྱི་ཁྱད་པར་ཉམས་པར་མི་བྱེད་པའམ།",
    "སྐྱེད་པར་མི་བྱེད་པ་དེ་ལ་སྒྲིབ་པར་བྱེད་པའམ།",
    "གེགས་བྱེད་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "ཡང་ན་ཞིག་པའི་མཚན་ཉིད་ཀྱིས་འཇིག་པར་༥བྱེད་པ་ན་འཇིག་པར་བྱེད་༦ཅེས་འདི་ལ་ཡང་ཐོ་བ་ལ་སོགས་པ་བཞིན་དུ་རྣམ་པར་རྟོག་པ་མཚུངས་པ་ཉིད་ལའང་༧རྗེས་སུ་འཇུག་སྟེ།",
    "འཆད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དོན་དེ་ལ་ཡང་ཞེས་བྱ་བ་ནི་གང་འདི་འཇིག་པས་འཇིག་པ་གཞན་བྱེད་ན་དེ་ལ་ཡང་འཇུག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་གཞན་ཉིད་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་དག་རྗེས་སུ་འཇུག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱུའི་ནུས་པས་ཐོབ་པའི་བདག་ཉིད་ཀྱི་ཟུཁྱད་པར་གང་ཡིན་པ་དེ་ཉིད་ལ་འབྲས་བུ་ཞེས་བྱ་བ་སྟེ།",
    "སྒྲུབ་པའི་བདག་ཉིད་ཀྱི་ཁྱད་པར་ཉིད་དངོས་པོ་ཡིན་ནོ།",
    "ཡང་ཇི་ལྟར་མེད་པ་སྒྲུབ་པར་བྱེད་ཅེས་དོགས་ཏེཔ་ལ་འདི་སྐད་དུ།",
    "མ་ཡིན་པར།",
    "བྱེ་རྣམ་པར་རྟོག་པ་ཡང་རྗེས་སུ་འཇུག་གོ།",
    "མེད་པར་དགག་པའི་བདག་ཉིད་དོ་ཞེས་ཁས་ལེན་པར་བྱེད་ན།",
    "འདི་ལྟར་མེད་པར་དགག་པ་ཡིན་ན་དགག་པ་བྱེད་པ་དང་འབྱེལ་པའི་ཕྱིར་མེད་པ་བྱེད་པ་ནི་དངོས་པོ་མི་བྱེད་དོ་ཞེས་བྱ་བ་བཀག་པའི་ཕྱིར་འཇིག་པའི་རྒྱུ་བྱེད་པ་པོ་ཉིད་མ་ཡིན་པར་བསྟན་པར་་འགྱུར་རོ།",
    "མ་སྐྱེས་པ་འཇིག་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་མ་གསུམ་པ་ལ་སོགས་པ་རྣམས་སུ་ཞིག་པ་ནི་ཡང་འཇིག་པར་མི་རུང་བའི་ཕྱིར་ཏེ།",
    "ཅི་སྟེ་རྟག་པ་ཡིན་ན་དེའི་ཚེ་དངོས་པོ་འཇིག་པ་དང་ལྷན་ཅིག་གནས་པར་འགྱུར་ཏེ།",
    "འོན་ཏེ་ཡང་ལྷན་ཅིག་གནས་པར་མི་འདོད་ན་དེའི་ཚེ་འབྲས་བུ་སྐྱེ་བར་མི་འགྱུར་ཏེ།",
    "གྲུབ་པ་ལ་སྒྲུབ་པ་དེ་ཉིད་དངོས་གང་ཞེས་བྱ་བ་ལ་སོགས་པས་སྟོན་པར་བྱེད་དོ།",
    "གཞན་མེད་པ་པོ་ལས་ཐ་དད་པ་དུས་ཕྱིས་ཀྱི་ཐོ་བ་ལ་སོགས་པ་འཇིག་པར་བྱེད་པ་མེད་པའི་ཕྱིར།",
    "དངོས་པོའི་དེ་མ་ཐག་ཏུ་བྱུང་བ་ཡང་གལ་ཏེ་སྤྱིར་བརྗོད་པར་འདོད་པ་ཡིན་ན་དེའི་ཚེ་གྲུབ་པ་ཉིད་ཡིན་ཏེ།",
    "རང་བཞིན་མེད་པ་དེ་ཇི་ལྟར་འདི་དེ་མ་ཐག་ཏུ་བྱུང་བ་ལ་སོགས་པ་སྲིད་པར་འགྱུར།",
    "འོན་ཀྱང་དངོས་པོ་བཀག་པ་ཉིད་སྟོན་པར་བྱེད་ཀྱི།",
    "དོན་དམ་པར་དངོས་པོའི་རང་བཞིན་འགའ་ཞིག་སྒྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལྟ་བུར་འགྱུར་བའི་སྒྲ་སྦྱོར་བའི་ཕྱིར་དེ་ལ་ཡང་དངོས་པོ་ཉིད་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "གདོན་མི་ཟ་བར་འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "དངོས་པོ་དེའི་ཕྱིར་ལྡོག་པར་འགྱུར།",
    "དེའི་ཕྱིར་འདི་དག་རྟག་པར་འགྱུར་ན།",
    "ཇི་ལྟར་རྟག་པར་འགྱུར།",
    "ལྡོག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཚིག་འདིས་ཀྱང་ཞིག་པ་འདི་ལ་སྒྲུབ་པའི་ངོ་བོ་ལྡོག་པའི་ངོ་བོ་བརྗོད་པ་ནི་མ་ཡིན་ནོ།",
    "རྟག་པའི་རྣམ་པར་རྟོག་པའི་གནས་མ་ཡིན་པ་ཉིད་དོ།",
    "འདི་ལས་ཀྱང་འཇིག་པའི་རྒྱུ་རྣམས་ཅུང་ཟད་ཀྱང་མི་བྱེད་པར་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་འཇིག་ན་དེ་ལ་འཇིག་པའི་རྒྱུས་ཅུང་ཟད་ཀྱང་བྱས་པ་མེད་དེ།",
    "འདི་སྙམ་དུ་དཔེར་ན་ས་བོན་ལ་སོགས་པ་མྱུ་གུ་ལ་སོགས་པ་སྐྱེད་པར་བྱེད་པའི་རང་བཞིན་ཡིན་ན་ཡང་གྲུའབའ་ཞིག་པ་ནི་སྐྱེད་པར་མི་བྱེད་དེ།",
    "དེ་བཞིན་དུ་དངོས་པོ་འཇིག་པའི་རང་བཞིན་ཡིན་ན་ཡང་འཇིག་པ་རྒྱུ་གཞན་ལ་ལྟོས་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ན།",
    "དེས་ན་གང་འདི་དེའི་རང་བཞིན་ཡིན་པ་དེ་ནི་སྐྱེད་པར་བྱེད་པ་ཁོ་ན་ཡིན་གྱི་འདི་གཞན་ལ་ལྟོས་པ་ནི་མ་ཡིན་ནོ།",
    "གང་སྦྱང་ལ་སོགས་པ་ལ་གནས་པ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ན་དེ་ནི་དེའི་རང་བཞིན་མ་ཡིན་ཏེ།",
    "རྒྱུའི་རྒྱུ་ཡིན་པའི་ཕྱིར་དེ་ལ་ཡང་རྒྱུ་ཞེས་ཐ་སྙད་དུ་བྱས་ཀྱི་དངོས་སུ་ནི་མ་ཡིན་པའི་ཕྱིར་འཁྲུལ་པ་མེད་དོ།",
    "འདི་ལྟར་གལ་ཏེ་དངོས་པོ་དེ་སྐྱེས་མ་ཐག་ཏུ་འཇིག་པར་མི་འགྱུར་ན།",
    "དེས་ན་འཇིག་པའི་རྒྱུ་ལྐུཐོབ་ནས་འཇིག་པར་བྱེད་དོ་སྙམ་པ་དེ་འདི་ནི་ཡང་དག་པ་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་དངོས་པོ་བྱས་པ་ཡིན་ན་འགའ་ཞིག་ཀྱང་འཇིག་པར་ངེས་པར་མི་འགྱུར་རོ་སྙམ་དུ་སེམས་ན་དེ་འདི་ནི་ཡང་དག་པ་མ་ཡིན་ཏེ།",
    "གཞན་གྱིས་མི་རྟག་པར་མི་འདོད་པ་གང་ཡིན་པའི་།",
    "བྱས་པ་དེ་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་ཉིད་འདིར་ཕྱོགས་སུ་བྱས་ཀྱི་གཞན་ནི་མ་ཡིན་པས་མ་ངེས་པ་ཉིད་དུ་ག་ལས་འགྱུར།",
    "གང་དག་བྱས་པ་ཉིད་ཡིན་ན་ཡང་མི་འཇིས་པ་ཉིད་ཀྱིས་རྟག་པ་ཉིད་དུ་འགྱུར་རོ་སྙམ་དུ་བསམ་པ།",
    "དེ་དག་དོན་དམ་པར་མ་བྱས་པའི་ཕུང་པོར་འདུས་པ་ཉིད་ཀྱིས་དེ་བཀག་པར་ཤེས་པར་བྱ་བ་ཡིན་པས་སྐྱོན་མེད་དོ།",
    "དངོས་སུ་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ནོ།",
    "མ་གྲུབ་པ་ཡང་མ་བྱེཡིན་ནོ་ཞེས་ཕྱིས་བསྟན་པར་བྱའོ།",
    "ཡང་ཅིའི་ཕྱིར་དངོས་པོ་མེད་པ་ལ་སྐད་ཅིག་དང་སྐད་ཅིག་མ་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པ་མི་འཇུག་ཅེ་ན།",
    "ཡང་ཅི་སྟེ་དངོས་པོ་ཉིད་དེ་མ་ཐག་ཏུ་འཇིག་པས་ཁྱད་པར་དུ་བྱས་པ་ལ་སྐད་ཅིག་ཅེས་བརྗོད་པ་དེ་ལྟ་ན་ཡང་དེ་ཕྱདེ་ཉིད་ཀྱིས་དེ་དང་ལྡན་པར་མི་འགྱུར་བའི་ཕྱིར་ལྡན་པའི་དོན་མི་རིགས་སོ།",
    "མིང་ཙམ་དངོས་པོའི་ཁྱད་པར་ཉིད་དུ་མི་རིགས་སོ་ཞེའོཚོ།་།",
    "དཔེར་ན་ནམ་མཁའི་རང་བཞིན་དང་མཆི་རྒྱ་གུའི་ལུས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་དངོས་པོ་ཐ་དད་པ་མེད་ན་ཡང་བློས་ཀུན་དུ་བརྟགས་པའི་ཐ་དད་པ་ལ་བརྟེན་འུནས་ཐ་དད་པའི་རྣམ་པར་དབྱེ་བར་འགྱུར་བ་དེ་བཞིན་དུ་འདི་ལ་ཡང་འགྱུར་རོ།",
    "དོན་དམ་པར་རང་བཞིན་ནམ་རྐྱེན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་དེ་ལྟ་བུར་གྱུར་པའི་དངོས་པོ་ལ་སྐད་ཅིག་མའི་སྒྲས་བརྗོད་པར་འདོད་པ་ན་རྐྱེན་དང་བཅས་པ་སྐད་ཅིག་མའི་སྒྲའམ་རྐྱེན་དང་བྲལ་བ་ཡང་སྦྱར་བར་བྱའོ།",
    "དེ་ལྟར་ནམ་མཁའ་ལ་སོགས་པ་བྱས་པ་ཉིད་དུ་ཁས་བླངས་པ་ན་ངེས་པ་མེད་པའི་ཐ་སྙད་ཀྱི་ཡུལ་ཡིན་ནོ་ཞེས་བསྟན་ནས།",
    "བྱས་པ་བཞིན་ཞེས་བྱ་བ་ནི་བྱས་པ་ལྟ་བུའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིས་ནི་བསྒྲུབ་བྱ་མ་ཚང་བའི་དཔེ་ཡིན་པར་དོགས་པར་མི་བྱ་བར་བསྒྲུབས་ཟིན་པའི་ཕྱིར་རོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "དེ་ལྟ་མ་ཡིན་ན་གཏན་ཚིགས་གང་ཡང་རུང་བ་ལ་མ་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་དག་ནི་ཕན་ཚུན་རྣམ་པར་གཅོད་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་བུམ་པ་སྦྲང་རྩི་དང་ཆུ་ལ་སོགས་པ་དང་དེ་ལས་གཞན་པའི་རྫས་དག་ཐ་མི་དད་པར་མ་འདྲེས་པར་རིམ་གྱིས་རྔུ་འཛིན་པ་དང་།",
    "དེའི་ཕྱིར་རིམ་པ་ནི་ཅིག་ཅར་རྣམ་པར་གཅད་པ་ཉིད་ཀྱིས་ཡོངས་སུ་གཅོད་པའི་ཕྱིར་དང་།",
    "དུས་ཀྱི་ཉུབྱེ་དངོས་པོ་ཐ་དད་པ་ཁས་མ་བླངས་པའི་ཕྱིར་དངོས་པོ་རྣམས་ཀྱི་རིམ་དང་ཅིག་ཅར་བ་ཉིད་མ་གྲུབ་ཅེས་བྱ་བ་འདི་ནི་བརྗོད་པར་མི་ནུས་ཏེ།",
    "ཁོ་བོ་ཅག་ནི་དངོས་པོ་རྣམས་ཀྱི་རིམ་དང་ཅིག་ཅར་དོན་གཞན་དུ་གྱུར་པའི་དུས་ཀྱི་དངོས་པོས་བྱས་པར་མི་སྨྲའོ།",
    "དེ་ལྟ་དེ་ལྟར་སྐྱེས་པས་བྱས་པ་ཡིན་ཏེ།",
    "འོན་ཏེ་བརྟེན་༤པའི་དངོས་པོ་གྲུབ་པར་གྱུར་ན་དེའི་ཚེ་དེ་ལ་རིམ་དང་ཅིག་ཅར་བོག་སན་དོན་བྱེད་པར་ནུས་པ་ལྡོག་པར་༦འགྲུབ་པར་འགྱུར་བ་མ་༧ཡིན་ནམ།",
    "དེ་ཉིད་དགག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ཡང་གྲུབ་པར་ཁས་ལེན་ན་འོ་ན་དེ་སྤང་བར་མི་རིགས་ཏེ།",
    "གལ་ཏེ་ཁྱེད་ཅག་འདི་དག་བརྟན་པའི་དངོས་པོ་ཉིད་དུ་ཁས་ལེན་པར་བྱེད་ན་དེའི་ཚེ་དོན་བྱེད་ནུས་པ་ཡང་ཁས་བླང་བར་མི་བྱ་སྟེ།",
    "དེ་ལ་རིམ་དང་ཅིག་ཅར་དང་ལྡན་པ་དེའི་ཁྱབ་པར་བྱེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཁྱབ་པར་བྱེད་པ་ལོག་པ་ན་ཁྱབ་པར་བྱ་བ་གནས་པར་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེ་དག་ཁྱབ་པར་བྱ་བ་དང་ཁྱབ་པར་བྱེད་པའི་དངོས་པོ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེ་ལ་བསྒྲུབ་པར་བྱ་བ་༥ལོག་ན་སྒྲུབ་པར་བྱེད་པ་ལྡོག་པ་ག་ཙམ་བསྟན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "ངེས་པར་འདི་ལ་གཞི་མི་འདོདཀྱེ།",
    "དེ་ལ་གལ་ཏེ་བརྟན་པ་གཅིག་པུའི་ངོ་བོ་འདི་ཐམས་ཅད་དུ་འབྲས་བུ་འདི་ཐམས་ཅད་ཀྱི་སྐྱེད་པའི་རྒྱུའི་ངོ་བོས་གནས་པ་ཡིན་ན་དེའི་ཚེ་ཅིའི་ཕྱིར་དེ་ཡོད་པ་ཙམ་དོན་དུ་གཉེར་བ་འབྲས་བུ་ཐམས་ཅད་ཅིག་ཅར་སྐྱེད་པར་མི་བྱེད།",
    "དེས་ན་དེའི་འབྲས་བུ་ཕྱིས་འབྱུང་པར་འགྱུར་བ་ཡང་དང་པོ་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་འདི་དེ་ལ་ལྟོས་ནས་འདི་རིམ་གྱིས་བྱུའབྲས་བུ་སྐྱེད་པར་བྱེད་པར་འགྱུར་རོ་ཞེ་ན་དེ་ལེགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "འདི་ལྟར་དཔེར་ན་ས་བོན་བང་བ་ཟུལ་སོགས་པའི་གནས་སྐབས་ཀྱི་ཁྱད་པར་བྱེད་པའི་ལྷན་ཅིག་བྱེད་པ་ལ་སོགས་པ་ལྟ་བུར་ཁྱད་པར་བྱེད་པའི་ལྷན་ཅིག་པ་ཡིན་ནམ།",
    "ཡོད་པ་ཡང་བྱེད་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "དེ་ཡོད་པ་ཧཱུཾན་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཡོད་པ་ནའོ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་རོ།",
    "དེ་དང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དང་ངོ།",
    "ཅི་སྟེ་དེ་ལས་དེ་སྐྱེ་བར་ཁས་ལེན་པར་བྱེད་ན།",
    "དེའི་ཚེ་དེ་ཙམ་དེ་ལས་བྱུང་བ་ཡིན་པས་ཁྱད་པར་རྣམས་ཅིག་ཅར་ཉིད་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཁྱད་པར་དང་ལྡན་པའི་རྒྱུ་ཐམས་ཅད་དུ་གནས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ནི་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "འདི་ལྟར་ལྷན་ཅིག་བྱེད་པ་རྣམས་ཁྱད་པར་གཞན་བྱེད་པའི་ཕྱིར་ལྷན་ཅིག་བྱེད་པ་ཉིད་བརྗོད་པར་བྱ་དགོས་སོ།",
    "ཁྱད་པར་དེ་ཡང་ཐ་དད་པ་ཉིད་ཡིན་ན་འབྱེལ་པ་གྲུབ་པོ།",
    "ཁྱད་པར་ཉིད་ལས་འབྲས་བུ་སྐྱེ་བའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ཡང་དེ་ནི་ཁྱད་པར་དང་ལྷན་ཅིག་དེ་ལས་བྱུང་བའི་མཚན་ཉིད་ཀྱི་འབྱེལ་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་མིན་ཞེས་བྱ་བ་ནི་ཕན་པར་བྱེད་པ་མ་ཡིན་པ་དེ་ལ་དེའི་འདུ་བར་བྱེད་དོ་ཞེས་བུ་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་ལ་ཕྱོགས་དང་པོ་ལ་ཕན་འདོགས་པ་ནི་ཕན་གདགས་པར་བྱ་བ་ལས་ཐ་མི་དད་པའི་ཕྱིར་དེ་ལས་བྱུང་བའི་མཚན་ཉིད་ཀྱི་འབྱེལ་པ་དེ་ཉིད་ཁས་བླང་བར་བྱ་བར་འགྱུར་ན།",
    "ས་གཉིས་པ་ཡིན་ན་དེའི་ཚེ་ཁྱད་པར་མེད་པའི་ཕྱིར་ཐམས་ཅད་ཐམས་ཅད་ཀྱི་འདུ་བར་འགྱུར་རོ།",
    "དེ་སྟོན་པར་བྱེད་པ་ནི་གལ་ཏེ་དེ་ནི་འདི་༢ལ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འདི་ཡང་གང་ཟག་ལ་སོགས་པ་བརྟག་པར་བསྟན་ཟིན་པ་དང་།",
    "འོན་ཀྱང་འདིར་འདི་དཔྱད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་དེ་ཉིད་ཡིན་ན་དེའི་ཚེ་ལྷན་ཅིག་བྱེད་པ་རྣམས་དང་རྟག་པར་འགྱུར་རོ།",
    "ལྷན་ཅིག་བྱེད་པ་དེ་དག་དང་འབྲེལ་པའི་རང་བཞིན་གང་ལ་ཡོད་ཅེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་ལྟ་ཡིན་ན་ནི་དེ་ཉིད་རང་བཞིན་སྔ་མ་མ་བཏང་བར་རྗེས་སུ་འཇུག་པར་ཕྱེའགྱུར་རོ།",
    "རིམ་གྱིས་དོན་བྱེད་པར་རིགས་པ་མ་ཡིན་ལ།",
    "ཁས་བླངས་པ་དང་འགལ་བར་ཡང་བསྟན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་རྗེས་སུ་འཇུག་པར་འགྱུར་ཞེས་བྱ་བ་ཕྱོགས་གཉིས་སོ།",
    "དེ་ལ་གལ་ཏེ་ལྡོག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཕྱོགས་ཡིན་ན།",
    "འོན་ཏེ་ཕྱོགས་གཉིས་ལ་རྟེན་རྔུཔར་བྱེད་ན་དེའི་ཚེ་དེའི་ངོ་བོ་ནུས་པའི་བདག་ཉིད་རྗེས་སུ་འཇུག་པ་ན་ཡང་འབྲས་བུ་སྐྱེད་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "གང་ཡང་ཅུང་ཟད་ཀྱང་མི་བྱེད་པ་དེ་ནུས་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་ལྟ་མ་ཡིན་ན་ནམ་མཁའི་པདྨ་ལ་སོགས་པ་ཡང་ཅིའི་ཕྱིར་ནུས་པར་རྣམ་པར་མི་འཇོག།",
    "དོན་བྱེད་པར་ནུས་པའོ།",
    "གལ་ཏེ་དེ་ལྡོག་ན་ཇི་ལྟར་དེའི་མཚན་ཉིད་ཀྱི་དངོས་པོ་ཉིད་དེ་ཞུདག་ལ་གནས་པ་རྙེད་པར་འགྱུར།",
    "ཅི་སྟེ་ཡང་གལ་ཏེ་དངོས་པོའི་མཚན་ཉིད་དོན་བྱེད་པར་ནུས་པ་ཁོ་ན་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་འདི་ཐམས་ཅད་མཛེས་པ་ཡིན་ནོ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་ནི་ཕན་ཚུན་རྣམ་པར་གཅོད་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར།",
    "ཤུགས་ཀྱིས་དངོས་པོ་མེད་པའི་མཚན་ཉིད་ལས་བཟློག་པ་དོན་བྱེད་པར་ནུས་པ་ཁོ་ནའི་དངོས་པོའི་མཚན་ཉིད་དུ་གནས་སོ་སྙམ་དུ་དགོངས་པའོ།",
    "དངོས་པོའི་མཚན་ཉིད་དོན་བྱེད་པར་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡོད་པའམ་ཡོད་པ་དང་འདུ་བ་གྲུབ་པར་གྱུར་ན་དེའི་ཚེ་དངོས་པོའི་མཚན་ཉིད་ཡོད་པ་དང་འདུ་བ་ཡིན་པར་འགྱུར་ན།",
    "ཡོད་པ་ནི་འགའ་ཞིག་དང་ལྷན་ཅིག་འབྱེལ་པ་མ་གྲུབ་པ་དེ་ནི་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕན་ཚུན་དུ་ཕན་མི་འདོགས་པ་དག་ནི་འབྱེལ་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "འདུ་བ་དང་ཁྱད་པར་དག་ལ་ཡོད་པ་དང་འདུ་བ་མ་ཡིན་ཐུཞིང་།",
    "མཚན་ཉིད་ཀྱི་སྒྲས་ནི་རྔུརང་བཞིན་རྗོད་པར་བྱེད་པའི་སྐབས་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཡོངས་སུ་མ་ཤེས་པ་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཉམས་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཤེས་པར་རུང་བའི་དངོས་པོ་མ་ཤེས་ན།",
    "ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པར་འགྱུར་ན།",
    "གཞན་དུ་ན་སྨྱོན་པར་འགྱུར་རོ།",
    "སོགས་པ་སྨོས་པས་མེ་དང་ཆུ་ལ་སོགས་པའི་དོན་གྱི་ཁྱད་པར་དག་ལ་སྤྱོད་པ་གཟུང་ངོ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་གཏན་ཚིགས་དེ་ལ་བསྒྲུབ་པར་བྱ་བས་ཐམས་ཅད་ཉེ་བར་སྡུད་པས་ཁྱབ་པ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཕྱོགས་དང་མཐུན་པའི་ཕྱོགས་ཀྱི་རྣམ་པར་དབྱེ་བ་མ་བྱས་པར་སྤྱིར་༦གཏན་ཚིགས་ཀྱི་ཁྱབ་པ་བསྟན་པ་གང་ཡིན་པ་དེ་ནི་ཐམས་ཅད་ཉེ་བར་བསྡུ་བའི་ཁྱབ་པའོ།",
    "ཅི་སྟེ་དོན་བྱེད་པར་ནུས་པས་སྟོང་༧ན་ཡང་ཅིའི་ཕྱིར་དངོས་པོ་ཉིད་དུ་མི་འདོད་ཅེ་ན།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཐུགས་ལ་ཡང་།",
    "གནས་སྐབས་ཀྱི་ཁྱད་པར་ཡང་གཟུང་ངོ།",
    "ལྟར་རྟོགས་པར་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པས་བརྒལ་ཞིང་བརྟག་པའི་ཕྱིར་རྒོལ་བས་བྱེད་པའི་འབྲས་བུ་མེད་པ་ཉིད་དེ།",
    "དེ་ནི་རྒོལ་བས་སྐད་ཅིག་མ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་བྱེམི་འདོད་པའི་ཕྱིར་རོ།",
    "ད་ནི་གཞན་གྱི་དོན་བྱེད་པར་ནུས་པ་ཡང་དངོས་པོའི་མཚན་ཉིད་དུ་མི་རིགས་ཏེ།",
    "ཧ་ཅང་ཁྱབ་ཆེས་པའི་ཕྱིར་རོ་ཞེས་སྟོན་པར་བྱེད་པ་ནི།",
    "དེ་དག་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ནམ་མཁའི་པདྨ་ལ་སོགས་པ་རྣམས་ལ་དོན་བྱེད་པར་ནུས་པ་༤མ་གྲུབ་སྟེ།",
    "འདི་ལྟར་དེ་དག་རང་ཉིད་ནུས་པར་འགྱུར་རམ་མི་ནུས།",
    "གལ་ཏེ་ནུས་ན་དེའི་ཚེ་ལྷན་ཅིག་བྱེད་པའི་རྒྱུ་ལ་ལྟོས་པར་མི་འགྱུར་ཏེ།",
    "ནུས་པ་ནི་འགའ་ལ་ཡང་ལྟོས་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "འདི་ལྟར་ཚོགས་པ་དང་པོའི་ནང་དུ་ཆུད་པའི་ལུས་གང་ཡིན་པ་དེ་དག་ནི་ཕན་ཚུན་དུ་ཁྱད་པར་ཐོབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལས་ཁྱད་པར་ཅན་སྐད་ཅིག་གཞན་སྐྱེ་བར་མི་འགྱུར་རོ།",
    "ཁྱད་པར་མེད་པ་དེ་དག་ལས་སྐད་ཅིག་གཞན་གྱི་ཁྱད་པར་སྐྱེ་ན།",
    "འབྲས་བུ་ཡང་ཅིའི་ཕྱིར་སྐྱེད་པར་མི་བྱེད།",
    "ཁྱད་པར་ཅན་དེ་དག་ནི་ཚོགས་པ་སྔ་མ་ལས་བྱུང་ངོ་ཞེས་བརྗོད་པར་རིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཚོགས་པ་དེའི་ནང་དུ་གཏོགས་༥པ་རྣམས་ཀྱང་དེ་ཉིད་ཀྱི་ཕྱིར་ཕན་ཚུན་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་དག་ཀྱང་ཁྱད་པར་གཞན་ལས་སྐྱེ་ན་ནི་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཁྱད་པར་མེད་པའི་ཕྱིར་དེ་ཇི་ལྟར་རྒྱུའི་ཚོགས་པ་༡ཁྱད་པར་མེད་པ་ལས་འབྲས་བུ་སྐྱེ་བར་འགྱུར།",
    "ཁྱད་པར་མེད་པ་ལས་ཀྱང་སྐྱེ་ན་ཐམས་ཅད་ཐམས་ཅད་ལས་འགྱུར་རོ།",
    "རྒྱུན་གྱི་གནས་སྐབས་ཁྱད་པར་ཐོབ་པས་འབྲས་བུ་སྐྱེ་བར་འགྱུར་གྱི།",
    "ཐམས་ཅད་དུ་ནི་མ་ཡིན་ནོ་ཞེས་ཀྱང་བརྗོད་པར་མི་རིགས་ཏེ།",
    "སྔ་མ་བཞིན་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྲོག་གཅོད་པ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་ཡང་ཆེས་འབྱེལ་པར་དཀའོ་སྙམ་དུ་བསམས་པའོ།",
    "སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྐད་ཅིག་གཅིག་ལ་ཆ་མེད་པ་ཉིད་ཀྱིས་ཁྱད་པར་བསྐྱེད་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཆོད་༤པའི་འབྲས་བུ་ལ་ལྟོས་ན་ནི་ཕན་ཚུན་དུ་ཁྱད་པར་ཅན་གྱི་སྐད་ཅིག་གོང་ནས་གོང་དུ་སྐྱེ་བའི་ཕྱིར།",
    "རྒྱུན་ལ་ལྟོས་ནས་ཕན་ཚུན་དུ་ཕན་འདོགས་པས་ཆོད་པའི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་ཕན་ཚུན་ཕན་པ་བྱེད་པའི་ཕྱིར་མཚན་ཉིད་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "དེ་དག་ནི་དེ་མ་ཐག་ཏུ་ཁྱད་པར་ཅན་ཀྱི་སྐད་ཅིག་སྐྱེ་བ་ལ་ཁྱད་པར་མེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེས་བྱས་པའོ་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་བྱེད་པས་བྱས་པའི་ཁྱད་པར་གྱི་རྒྱུས་བྱས་པའོ།",
    "དེ་རྣམས་ཏེ་དེའི་༨་ངོ་བོ་ཁྱད་པར་ལྷན་ཅིག་བྱེད་པས་བྱས་པའི་ཁྱད་པར་གྱེ་༩་རྒྱུས་བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་ཏེ།",
    "དེ་ལ་ཉེ་བར་སྤྱོར་བ་དེ་དག་ཀྱང་ལྷན་ཅིག་བྱེད་པས་བྱས་པའི་ཁྱད་པར་ཀྱི་རྒྱུས་བསྐྱེད་པར་བྱས་པའི་འབྲས་བུ་སྐྱེད་པར་རུང་བའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ནི་བརྒལ་ཞིང་བརྟག་པར་འོས་པ་མ་ཡིན་ཏེ།",
    "དེ་ལ་ཅུང་ཟད་སྒྲུབ་པར་ནི་མ་ཡིན་ནོ།",
    "འགལ་བའི་རྣམ་པར་གཞག་པ་བསྒྲུབ་པའི་ཕྱིར།",
    "དོན་དམ་པར་ཏེ་༡དངོས་པོ་རྣམས་ལ་གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པའི་དངོས་པོ་ཡོད་པ་ནི་མ་ཡིན་ཏེ།",
    "གནོད་པ་མེད་པ་ཞེས་བྱ་བ་འདིས་ནི་ཕྱིན་ཅི་མ་༢ལོག་པར་བསྟན་ཏོ།",
    "ངོ་ཤེས་པའི་ཤེས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "འབྲེལ་པ་མ་བཟུང་བའི་དོན་སྒྲ་དང་ལྷན་ཅིག་སྦྱར་ནས་འཛིན་པར་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་རིགས་པའི་རྗེས་སུ་འགྲོ་བ་འདི་མངོན་སུམ་གྱི་མཚན་ཉིད་དུ་རྗོད་༧པར་བྱེད་དོ།",
    "ཐ་དད་པ་ལ་ཐ་མི་དད་པར་ངེས་པར་འཇུག་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་འདི་སྔར་དམིགས་པའི་དོན་གྱིས་ཡུལ་ཅན་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་སྔར་ཉིད་དུ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་ཐ་དད་པ་དག་ལ་ཐ་མི་དད་པར་ངེས་པས་འཇུག་པའི་ཕྱིར་སྒྱུ་མའི་རི་ལུའི་རྣམ་པར་ཤེས་པ་བཞིན་དུ་འདི་ནི་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་མ་ཚང་བ་མེད་པ་ཉིད་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་སྔ་མའི་དོན་ཡུལ་ཡིན་པ་ཉིད་ཀྱིས་འདི་སྐད་ཅིག་མ་འཇིག་པ་ལ་གནོད་པར་བྱེད་པ་ཉིད་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "འདི་ལ་དོན་དམ་པར་སྔ་མའི་ཡུལ་ཡིན་པ་ཉིད་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ད་ལྟའི་དུས་སུ་ཡོད་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པས་གཞོན་ནུ་མ་ལེན་གྱི་ལུགས་ཀྱིས་བཟུང་ཟིན་པ་སྙེའཛིན་པ་ཉིད་ཀྱིས་མ་གྲུབ་པར་སྟོན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ནི་དེ་ཉིད་འདི་ཡིན་ནོ་དེཞེས་བྱ་བའི་རྣམ་པ་འཛིན་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་ངོ་ཤེས་པ་འདི་ལ་དྲན་པ་ལས་ཁྱད་པར་ཡོད་དོ།་།",
    "ངོ་ཤེས་པ་ནི་འདིའོ་སྙམ་པ་དེ་ལྟ་བུའི་ཐ་དད་པར་ཡང་དོན་ཀྱི་རྣམ་པར་འཛིན་པ་སྐྱེ་སྟེ།",
    "དེའི་ཕྱིར་དྲན་པ་ལས་ཁྱད་པར་དུ་གྱུར་པ་ཡིན་ཏེ།",
    "འོན་ཏེ་ཇི་ལྟ་བུ་ལ་སོགས་པར་རྟོགས་པའི་སྔོ་བསངས་ལ་སོགས་པ་བཞིན་དུ་ཇི་ལྟར་རྗེས་སུ་དཔག་པས་བསྒྲུབས་པའི་དོན་ལ་དུས་གཞན་ཡང་མངོན་སུམ་གྱིས་གནོད་པ་༢ གཞན་ཉིད་དུ་འགྱུར་བ་བྱེ་དེ་བཞིན་དུ་འདི་ལ་ཡང་མ་ཡིན་ནམ།",
    "དེ་ཇི་ལྟར་སྐད་ཅིག་མ་འཇིག་པ་ཉིད་ལ་གནོད་པར་བྱེད་ཅེས་དོགས་པ་ལ།",
    "བཅས་པ་ཞེས་བྱ་བ་ནི་ཡུལ་དུ་བྱས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ནི་༩མངོན་སུམ་ལས་ཅིག་ཤོས་ཀྱི་རྗེས་སུ་དཔག་པ་ལ་སོགས་པ་གནོད་པར་བྱེད་པ་ཉིད་དུ་སྐྱེ་བ་སྲིད་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་དུའོ།",
    "བཟློག་པར་ཞེས་བྱ་བ་ནི་གཞན་ཉིད་དུའོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལེན་འདེབས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཉམས་སུ་མྱོང་བ་ཉིད་ཙམ་ལས་ངེས་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "དོན་ཐོབ་པར་ནུས་པའོ།",
    "བློ་མི་མཐུན་པའི་གཞིར་གྱུར་པའི་དངོས་པོ་བརྗོད་པར་འདོད་པའི་ཉི་མ་དང་།",
    "སྐར་མ་ལ་སོགས་པའི་ཤེས་པའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཉིད་༡ཡིན་པའི་ཕྱིར།",
    "དུས་དང་པོར་བྱུང་བའི་ལྷ་སྦྱིན་གྱི་ཟླ་བ་དང་ཉི་མ་དང་།",
    "བརྗོད་པར་འདོད་པའི་ཉི་མ་ལ་སོགས་པ་ཡུལ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཉི་མའི་གཟི་བརྗིད་ལ་སོགས་པའི་རྫས་ཡུལ་ཡིན་པའོ།",
    "རྨི་ལམ་གྱི་མཐའི་ཤེས་རབ་ཀྱི་ཁྱད་པར་དེ་དག་ཐམས་ཅད་ནི་བདག་ཉིད་ཐོབ་མ་ཐག་ཏུ་འཇིག་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "མེད་པ་ལས་ཐ་དད་པའི་ཤེས་བྱའི་ཡུལ་ཅན་གྱི་ཤེས་པས་གཅད་༢སྣཔར་བྱ་བ་མ་ཡིན་པ་ཉིད་དང་།",
    "བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་རྗོད་པར་བྱེད་པས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དང་།",
    "རིགས་མཚུངས་པ་དང་མི་མཚུངས་པའི་རྫས་ལྡན་པ་དང་རྣམ་པར་དབྱེ་བ་ལས་སྐྱེས་པ་སྒྲའི་འབྲས་བུའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "དེ་ཡང་མེད་པ་ཉིད་ཀྱི་ཕྱིར་དེས་གཅད་༦པར་བྱ་བ་མ་ཡིན་པ་ཉིད་གྲུབ་པོ།",
    "དེ་བཞིན་དུ་གང་ལ་བརྗོད་པར་བྱ་བ་ཡོད་པ་མ་ཡིན་པ་དེ་ནི་རྗོད་པར་བྱེད་པ་སྟེ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའོ།",
    "དེས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་སྒྲུབ་སྟེ།",
    "བྱས་པ་ཉིད་ལ་སོགས་པར་མཚུངས་པའི་ཕྱིར་རོ།",
    "སྒྲའི་དང་པོའི་སྐྱེ་གནས་ནི་ལྡན་པ་དང་རྣམ་པར་དབྱེ་བའོ།",
    "ལོག་པར་རྟོགས་པའི་ཅིག་ཅར་བ་མ་ཡིན་པའི་དུས་ཀྱི་ཤེས་པ་རྣམས་ནི་ཡུལ་གཅིག་ཡིན་ཏེ།",
    "དེའི་ཤེས་པ་གཞི་མཐུན་པ་མ་གསལ་བ་མཚུངས་པའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ད་ལྟར་ཀྱི་བྱེ་སྐད་ཅིག་ལ་སྐྱེས་བུ་དུ་མའི་ཤེས་པ་བཞིན་ནོ།",
    "མཚུངས་པའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཉིད་ནི་ནག་པའི་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།་།",
    "གཅིག་ལ་བསྟེན་པ་སྟེ་གཞི་མཐུན་པར་གནོད་པ་མེད་ན་དེ་གནོད་པ་ཡོད་པ་མ་ཡིན་པ་ཡང་དེ་ཡིན་ལ་ཟུ།",
    "གཅིག་ལ་བརྟེན་པ་ཡང་ཡིན་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "གང་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ས་དང་འབྱེལ་པ་ཉིད་དུ་མི་དམིགས་པ་ཞེས་ཁྱད་པར་དང་བཅས་པ་ཡིན་ན་ཡང་གཏན་ཚིགས་མ་ངེས་པ་ཡིན་ནོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེ་དག་ལ་དེའི་སྐད་ཅིག་མ་འཇིག་པ་ཉིད་མེད་པར་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་སྨྲས་པ་གང་ཡིན་པ་དེ་ནི་ལོག་བྱེཔ་ཡིན་ཏེ།",
    "འདི་ལ་ཡང་ཞིབ་ཏུ་དཔྱད་པ་མ་བྱས་ཏེ།",
    "གང་ཡང་རུང་བའི་སྒྲ་ནི་རྣམ་པར་རྟོག་པའི་ཡུལ་ཡིན་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་ཡང་དངོས་པོ་དུ་མ་ཕྱོ་སྲིད་པ་ཡིན་ན་འགྱུར་གྱི།",
    "བརྗོད་པར་བྱ་བ་ཉིད་སྨོས་པ་ཉིད་ཀྱིས་སྒྲར་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་གཞན་ཡང་དོན་མེད་པ་ཉིད་དོ་ཞེས་གཟུང་བར་བྱའོ།",
    "འདི་ཡང་ཕྱིས་སྟོན་པར་འགྱུར་རོ།",
    "གང་ཡང་གང་དག་རྣམ་པར་རྩོད་པའི་ཡུལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་པ་དེ་ལ།",
    "མར་མེའི་ཤེས་པ་མར་མེའི་ཤེས་པའོ་སྙམ་པ་མར་མེ་ལ་སོགས་པའི་ཤེས་པ་ཡུལ་ཅན་བྱེ་ཐ་དད་པ་ཡིན་ན་ཡང་མཚུངས་པའི་སྒྲ་འཇུག་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེས་ན་སྟེ་སྒོན་མ་ལ་སོགས་པའི་ཤེས་པའི་ཡུལ་ཅན་མཚུངས་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱིས་མཚུངས་པའི་སྒྲས་བརྗོད་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་འཁྲུལ་པ་ཅན་ཡིན་ནོ།",
    "དེའི་ཤེས་པ་གཞི་མཐུན་པ་མ་བསལ་བ་ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་ནི་སྒྲོན་མ་ལ་སོགས་པའི་ཤེས་པས་འཁྲུལ་པ་བསལ་བའི་དོན་ཁོ་ནར་བྱས་པ་ཡིན་ཏེ།",
    "རྩ་བའི་གཏན་ཚིགས་འཁྲུལ་པར་ག་ལ་འགྱུར་ཞེས་བྱ་བ་ནི་གཞན་གྱི་བསམ་པའོ།",
    "དེའི་ཁྱད་པར་འདི་མ་གྲུབ་པོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟ་མ་ཡིན་ན་གང་ཁོ་ན་གྲང་བ་དང་འབྱེལ་པ་དེ་ཁོ་ན་གྲང་བ་དང་གལ་ཏེ་ཕྱིས་ཀྱི་དྲོ་བ་དང་འབྱེལ་པ་ཡིན་པར་འགྱུར་ན།",
    "དེའི་ཚེ་གྲང་བ་དང་དྲོ་བའི་གནས་སྐབས་གཉི་ག་དམིགས་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཁྱད་པར་དང་བཅས་པའི་གཏན་ཚིགས་ཀྱང་མ་གྲུབ་པོ།",
    "རྟག་པ་ན་དེས་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པ་ཡང་ལྟོས་པར་མི་རིགས་ཏེ།",
    "རྣམ་པར་གཞག་ལ་སོགས་པའི་རྟེན།",
    "སྐད་ཅིག་མའི་མི་རྟག་པ་སྨོས་པ་ནི་དུས་གཞན་དུ་གནས་པའི་མི་རྟག་པ་རྣམ་པར་གཅད་གྲུཔའི་དོན་དུའོ།",
    "དེས་ཁྱབ་པ་ནི་ཡང་དག་པར་བསྣན་པའོ།",
    "བྱས་པ་ཆུད་ཟོས་པ་དང་བྱེད་པ་པོ་མ་ཡིན་པ་༥འབྲས་བུ་དང་ལྡན་པའི་ཕྱིར་མ་བྱས་པ་དང་ཕྲད་པར་འགྱུར་རོ།",
    "དངོས་པོ་ཐམས་ཅད་པྱ་སྐད་ཅིག་མ་ཉིད་དུ་ཁས་བླངས་པ་ན་བདག་མེད་པ་ཉིད་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟ་ཡིན་ན་རྟོག་པ་དང་ལྡན་པར་བྱ་བ་ལ་འཇུག་པའི་དང་པོ་ཉིད་དུ་སྟེ།",
    "སྔར་རྟོགས་ཏེ་ངེས་པར་འཛིན་པར་བྱེད་དོ།",
    "དེ་སྲིད་ཀྱི་ཞེས་བྱ་བ་ནི་སྐྱེས་ནས་དུས་ཇི་སྲིད་དུ་འབྲས་བུ་འགྲུབ་པར་བྱེད་པའི་དུས་དེ་སྲིད་དུ་མི་གནས་ཏེ།",
    "གང་ནུས་པ་མ་ལུས་པ་དང་བྲལ་བ་དེ་ཇི་ལྟར་གཞན་གྱི་ཡན་ལག་ཏུ་རྟོགས་ཆཔར་བྱེད་དེ།",
    "གང་འབྲས་བུ་བྱ་བ་དང་འབྲས་བུ་བྱེད་པར་ནུས་པར་འགྱུར་བ་ད་ལྟར་ཡང་གནས་པ་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཉམས་པར་འགྱུར་བ་མིན།",
    "དེ་ལས་འབྲས་བུ་བསྐྱེད་ནས་ཕྱིས་འཇིག་པར་འགྱུར་རོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་དངོས་པོ་གཅིག་ལ་སྐད་ཅིག་མ་དུ་མ་ཡོད་པའི་ཕྱིར་སྐད་ཅིག་མ་ཉམས་པར་འགྱུར་རོ།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་སྒྲུབ་པར་བྱེད་པ་ནི་མངོན་སུམ་དང་མི་དམིགས་པ་ཡིན་ལ།",
    "རྣམ་པར་འཇིག་པའི་བྱེད་པ་སུས།",
    "དེའི་ཚེ་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཐུགྲུབ་ན་ཁྱེད་ཀྱི་རྒྱལུགས་ཀྱིས་མཚམས་སྦྱོར་བ་པོ་དེ་ཡང་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་འགྲུབ་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ད་ནི་ངོ་ཤེས་པ་མི་འཐད་པར་བསྟན་པའི་ཕྱིར།",
    "ཤེས་པ་པོ་དང་ཤེས་པར་བྱ་བ་ཀྱེགཅིག་པོ་འགའ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "ལྷ་སྦྱིན་ཀྱིས་༡་མཐོང་བའི་དོན་ཁྱབ་འཇུག་བཤེས་གཉེན་གྱིས་ངོ་ཤེས་པ་ནི་མེད་དོ།",
    "དོན་གཞན་ངོ་ཤེས་པར་བྱེད་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བར་ཡང་བལྟ་བར་བྱའོ།་།",
    "ཤིན་ཏུ་རིགས་པ་དང་ལྡན་པར་གནས་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "འདི་ལ་བརྗོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "བདག་མེད་པ་ཡིན་ན་ཡང་དངོས་པོ་རྣམས་ལ་ལས་དང་འབྲས་བུའི་འབྱེལ་པའི་རྣམ་པར་གཞག་པ་འདི་ནི་རྒྱུ་དང་འབྲས་བུ་ཉིད་དུ་རབ་ཏུ་དབྱེ་བ་ཡིན་ལ།",
    "བུམ་པ་ལ་སོགས་པ་ལ་བདག་ལྡོག་པ་ན་སྲོག་ལ་སོགས་པ་ལྡོག་པར་མཐོང་ངོ་ཞེས་གྲགས་པའི་ལྡོག་པ་ཅན་གྱི་གཏན་ཚིགས་གྲུབ་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་བུམ་པ་ལ་སོགས་པ་ཡང་བདག་དང་བཅས་པར་གྱུར་ན།",
    "འདི་སྐྱེས་པས་འདི་སྐྱེ་ཞེས་གསུངས་སོ།",
    "འབྲེལ་པ་ནི་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་ཉིད་དོ།",
    "མི་ཤེས་པའི་རབ་རིབ་ཀྱི་ཚོགས་ཤིན་ཏུ་ཆེན་པོས་ཡེ་ཤེས་ཀྱི་སྣང་བ་ཉམས་པར་བྱས་པའི་འཇིག་རྟེན་པ་བདག་ལ་དེ་ཉིད་དང་།",
    "རྣམ་པ་དེ་ལྟ་བུའི་རྣམ་པར་བཞག་པ་ཉིད་ལས་དངོས་པོ་གྲུབ་པོ་ཞེ་ན།",
    "དཔེ་མ་གྲུབ་པར་གྲགས་པར་སེམས་པ་ན་གཞན་གྱི་ཀླན་ཀ་དོགས་པར་བྱེད་པ་ནི།",
    "བཀོད་པ་གཞན་༥ཐོབ་པ་ན་ཡང་སའི་ཁམས་ཆུའི་ཁམས་ཀྱིས་བཟུང་༦ནས་ནང་མེས་སྨིན་པ་ན་རོའི་རྫས་སྒྲུབ་པར་བྱེད་ལ།",
    "རོ་དང་བཅས་པའི་སྔ་མའི་ཆ་ཤས་དག་དང་ལྷན་ཅིག་མྱུ་གུ་ལ་སོགས་པའི་དངོས་པོ་སྒྲུབ་པར་བྱེད་དོ་ཞེས་སྨྲས་པ།",
    "ཞིང་སོགས་ཁྱད་པར་མེད་པ་ན།་།",
    "དེ་ལྟ་ཡིན་དང་ས་བོན་དང་མྱུ་གུ་ལ་སོགས་པ་ཕན་ཚུན་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "ཅི་སྟེ་མྱུ་གུ་ལ་སོགས་པ་ཐ་དད་དུ་ཁས་ལེན་པར་བྱེད་ན་དེའི་ཚེ་ངེས་པར་ཞིང་ལ་སོགས་པ་སྔ་མའི་རང་བཞིན་ཡོངས་སུ་སྤངས་པ་ན་བཀོད་པ་སྔ་མ་བཏང་ནས་བཀོད་པ་གཞན་ཐོབ་པར་ཡང་ཁས་བླང་བར་ཤེབྱ་དགོས་སོ།",
    "དེའི་ཕྱིར་ལས་དང་འབྲས་བུ་ལ་སོགས་པའི་ཡོད་པ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལ་གཞན་གྱིས་བྱས་པའི་ཞིག་པ་དང་མ་ཞིག་པ་གང་དག་ཡིན་པ་དེ་བསལ་བའི་སྒོ་ནས་རྣམ་པར་གཞག་པ་ཐམས་ཅད་ཀྱི་རྩ་བ་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་དུ་གནས་པར་ཏེ་ངེས་པར་མི་འགྱུར་ཏེ།",
    "ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།་",
    "དེ་ལྟ་བས་ན་སྐྱེ་བ་རྣམས་ཐུག་པ་མེད་པར་འགྱུར་ལ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ནི་འབྲས་བུའོ་ཞེས་བྱ་བའི་རྣམ་པར་གཞག་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པས་མཇུག་བསྡུས་ནས་གནས་པའི་ཕྱོགས་སུན་ཕྱིན་པར་སྟོན་པ་ཡིན་ནོ།",
    "ཁས་མ་བླངས་པ་ཉིད་ཀྱི་ཕྱིར་ཞིག་པའི་རྣམ་པར་རྟོག་པ་ཡང་མི་རིགས་ཏེ།",
    "འདི་ལྟར་གཅིག་ནི་འདས་པས་འབྱིན་པར་བྱེད་ཅེས་ཇི་ལྟར་བྱེ་བྲག་ཏུ་སྨྲ་བས་ཁས་བླངས་པ་བཞིན་དུ་གལ་ཏེ་སྐད་ཅིག་མ་གསུམ་པ་ལ་སོགས་པ་ལ་འབྲས་བུ་འབྱུང་ངོ་ཞེས་ཁས་བླངས་པ་ཡིན་ན་དེའི་ཚེ་རྒྱུ་ཞིག་པ་ལས་འབྲས་བུ་སྐྱེ་བར་ཁས་བླངས་པ་བྱས་པར་འགྱུར་རོ།",
    "སྐྱེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ཡང་དུས་ཐ་དད་པར་འགལ་ཏེ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་སྨྲ་བ་པོ་དག་མེ་ནི་དུ་བ་སྐྱེད་པར་བྱེད་ལ་དུ་བ་ནི་མེ་ལ་བརྟེན་ནས་སྐྱེའོ་ཞེས་ཤེས་པར་འགྱུར་རོ་ཞེ་དུན།",
    "རྒྱུ་དེ་འབྲས་བུ་དེའི་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "དེ་ནི་དེ་ལ་བརྟེན་ནས་སྐྱེའོ་ཞེས་བྱ་བ་ཡང་ཤེས་པར་བྱའོ།",
    "ཕྱི་རོལ་གྱེ་དོན་ལ་ལྟོས་པ་མེད་པར་བརྗོད་པར་འདོད་པ་ལས་བྱུང་བའི་བརྡའི་རྗེས་སུ་བྱེད་པའི་ཐ་སྙད་དུ་འདོགས་པ་པོ་དག་དེ་ལྟར་སྨྲའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབྲས་བུ་ནི་རྒྱུ་ལ་ལྟོས་ལ་རྒྱུ་ཡང་འབྲས་བུ་ལ་བྱེད་དོ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་རྗོད་པར་བྱེད་ཅེ་ན།",
    "དེ་མ་ཐག་པར་ངེས་པ་གང་།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཡིན་ན་དངོས་པོ་ཙམ་ཡང་ཅིའི་ཕྱིར་རྒྱུའི་དངོས་པོར་འཛིན་པར་མི་རྗོབྱེད།",
    "དེའི་ཕྱིར་གང་དུ་གཏོགས་པའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་རྗེས་སུ་བྱེད་པ་ཉིད་འབྲས་བུ་ཡིན་པར་གྲུབ་པ་ཉིད་དེ་དངོས་པོ་ཙམ་མཆོག་སྟེ།",
    "དེ་ལྟ་ཡིན་ན་བྱ་བ་ཡང་རྒྱུར་བརྟགས་ནས་གཞན་ཡང་བརྟག་པར་བྱ་བར་འགྱུར་ཏེ།",
    "ནུས་པ་མ་མཐོང་བ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་བྱ་བ་འདི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་དེ་ཅི་བྱ་བ་གཞན་དང་ལྡན་པས་སམ།",
    "དེ་ལ་ཡང་གལ་ཏེ་བྱ་བ་གཞན་དང་ལྡན་པ་རྒྱུའི་དངོས་པོར་རྟོག་པར་བྱེད་ན་དེའི་ཚེ་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་ཡོད་པ་ཙམ་གྱིས་ཞེས་བྱ་བའི་ཕྱོགས་ཡིན་ན་དེའི་ཚེ་བྱ་བ་བཞིན་དུ་དངོས་པོ་ཡང་ཡོད་པ་ཙམ་ཉིད་ཀྱིས་འབྲས་བུ་བསྐྱེད་པར་འགྱུར་བའི་ཕྱིར་བྱ་བ་བརྟགས་པ་དོན་མེད་དོ་ཞེས་སྟོན་པ་ནི།",
    "དངོས་པོ་ཡོད་པ་ལ་རྣམ་པ་གཞན་མེད་དུཔའི་ཕྱིར་གཉི་ག་དང་གཉི་ག་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པ་ནི་མི་སྲིད་པ་ཉིད་དོ།",
    "མ་ཡིན་ཏེ་ཕན་ཚུན་དུ་ཕན་དུའདོགས་པ་མ་ཡིན་པ་ནི་འབྱེལ་པར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་དངོས་པོས་བྱ་བ་ལ་ཕན་འདོགས་པར་དུབྱེད་པ་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་ཐུག་ཛེེཔ་མེད་པས་སྒེན་བྱ་བ་རྣམས་ཉིད་ཕན་ཚུན་བྱེད་པའི་ཕྱིར་དངོས་པོ་དང་ལྷན་ཅིག་བྱ་བ་འབྱེལ་པ་ནམ་ཡང་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "འབྲས་བུ་ལ་ཡང་དེ་ཡོད་པ་ཙམ་གྱིས་ཕན་འདོགས་པར་བྱེད་པ་ལ་འགེགས་པ་འགའ་ཡང་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "དངོས་པོའི་རང་བཞིན་ཉིད་ཡོད་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེ་བ་ལས་ནི་མ་གཏོགས་པར།",
    "དེ་ལྟར་སྐྱེ་བར་བརྗོད་པར་འདོད།",
    "འདི་སྙམ་དུ་བློ་ལ་བྱ་བ་མེད་པར་རིགས་ཏེ།",
    "བསྒྲུབས་ཞེས་བྱ་བ་ནི་སྔར་བསྟན་པའི་དངོས་པོ་བརྟག་པར་དངོས་པོ་མཐའ་དུདག་ལ་ཁྱབ་པའི་སྐད་ཅིག་མ་འཇིག་པ་ཉིད་བསྒྲུབས་ཟིན་པའི་ཕྱིར་རོ།",
    "ནུས་པ་འཇུག་པ་མེད་པར་ནི།",
    "འདི་ལྟར་དངོས་པོ་དམིགས་པར་འགྱུར་བ་ན།",
    "ཅི་སྟེ་རྣམ་པ་མེད་པས་ཡིན་ན་དེའི་ཚེ་ཡང་ཁྱད་པར་མེད་པ་ཉིད་ཡིན་ཏེ།",
    "སེར་པོ་རིག་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་རྣམ་པར་གཞག་པ་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "འདི་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལེན་འདེབས་པར་བྱེད་དོ།",
    "གཞན་དུ་ན་དོན་འཛིན་པའི་ཤེས་པ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "ཁྱེད་ཀྱིས་གདོན་མི་ཟ་བར་རྣམ་པ་རྣམས་བརྫུན་པ་ཉིད་དམ་ལྷན་ཅིག་དམིགས་པ་ངེས་པའི་ཕྱིར་ཐ་དད་པ་ཡིན་ན་ཡང་ཤེས་པ་གཅིག་དང་ཐ་མི་དད་པ་ཉིད་ཡིན་ནོ་ཞེས་ལན་གདབ་པར་བྱ་དགོས་ལ།",
    "རྣམ་པ་མེད་པའི་ཕྱོགས་ལ་ཡང་ཤེས་པ་རྒྱུ་སྔ་མས་སྣེབྱས་པ་ཉིད་ཀྱི་ངེས་པའི་དོན་རྟོགས་པའི་རང་བཞིན་དུ་བརྗོད་པར་བྱ་དགོས་ལ།",
    "བྱས་པ་ཆུད་ཟོས་པ་དང་མ་བྱས་པ་དང་ཕྲད་པའི་སྐྱོན་སྤང་བར་དུབྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་རྒྱ་སྐྱེགས་ལ་སོགས་པའི་ཁྱ་བས་བཅུས་པའི་ས་བོན་ལ་སོགས་པའི་རྒྱུན་རྗེས་སུ་འཇུག་པ་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་སྔོན་གྱི་ལས་ཀྱིས་བསྒོས་པའི་ནུས་པའི་ཁྱད་པར་ཡང་ཡིན་ཏེ།",
    "སྔོན་གྱི་ལས་ཀྱིས་མ་བསྒོས་པའི་འདུ་བྱེད་ཀྱི་རྒྱུན་ལས་འབྲས་བུ་སྐྱེ་བར་འདོད་པ་ཡང་མ་ཡིན་པས་དེའི་ཕྱིར་གང་ལས་མ་བྱས་པ་དང་།",
    "བརྟན་པ་མ་ཡིན་པ་ལ་ནི་རང་བཞིན་གྱི་ཁྱད་པར་གཞན་སྐྱེད་པ་ཉིད་བག་ཆགས་ཡིན་ནོ།",
    "བྱས་པ་ཆུད་ཟོས་པ་དང་།",
    "དེའི་ཕྱིར་འདི་ལ་རྣམ་པ་དེ་ལྟ་བུའི་བྱས་པ་ཆུད་ཟོས་པ་དང་།",
    "མ་བྱས་པ་དང་མི་འདོད་པ་ཐོབ་པར་མི་རིགས་སོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ལས་ཀྱི་སྐད་ཅིག་སྔ་མ་རྗེས་སུ་འགྲོ་བ་མེད་པར་ཞིག་པའི་ཕྱིར་བྱས་པ་ཆུད་ཟོས་པ་དང་།",
    "འབྲས་བུའི་སྐད་ཅིག་སྔ་མ་མེད་པ་ཉིད་སྐྱེ་བའི་ཕྱིར་མ་བྱས་པ་དང་ཕྲད་པ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་སྐད་ཅིག་ཐ་དད་པའི་རྣམ་པར་རྟོག་པས་བྱས་པ་ཆུད་ཟོས་པ་ལ་སོགས་པའི་རྩོད་པ་དེ་ནི་འདོད་པ་ཉིད་ཡིན་ནོ།",
    "རྗེས་སུ་འགྲོ་བའི་དངོས་པོའི་ཆ་ཉུང་ངུ་འགའ་ཞིག་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱའོ།",
    "འདི་ལྟར་རྒྱུན་ལ་གཅིག་པ་ཉིད་དུ་ཞེན་ནས་བདག་ཅག་བདེ་བར་འགྱུར་རོ་ཞེས་དྷིཡོངས་སུ་དགའ་བར་བྱས་ནས་ལས་ལ་འཇུག་པར་འགྱུར་རོ།",
    "སྲིད་པ་ཡོངས་སུ་མ་བཅོམ་པར།",
    "ལོག་པར་སྒོ་འདོགས་གཞོམ་ཕྱིར་རྩོམ།",
    "ངོ་ཤེས་པ་ཡང་འཐད་པར་དཀའ།",
    "རྒྱུན་གང་ལ་ཉམས་སུ་མྱོང་བ་ཤིན་ཏུ་གསལ་པོས་གོང་ནས་གོང་དུ་ཤིན་ཏུ་ཆེས་ཁྱད་པར་ཅན་བྱི་སྐད་ཅིག་སྐྱེ་བས་དྲན་པ་ལ་སོགས་པའི་ས་བོན་བསྒོས་པ་དེ་ཉིད་ལ་དྲན་པ་ལ་སོགས་པ་སྐྱེ་བར་འགྱུར་གྱི་གཞན་དུ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་སྡུག་བསྔལ་གྱི་ཕུང་པོ་ཆེན་པོ་འདི་འབའ་ཞིག་སྐྱེ་བར་འགྱུར་རོ་ཞེས་གསུངས་སོ།"
  ]
}