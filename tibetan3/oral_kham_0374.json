    "སྦྱིན་བདག་ལ་བར་ཆད་ཀྱི་འཕྲང་ཞིག་འདུག་བསམ་པ་ལམ་ལུས་བྱ་བ་ཡིན།",
    "ཡུལ་མི་དྲག་ཞན་ཀུན་གྱི་བྱེད་སྤྱོད་ལབ་རིགས་འདི་འདུག་ཅེས་གསུངས་པ་དང་།",
    "དྲང་ངེས་ལྡེམ་དགོངས་ཀུན་ཡོད་པར་འདུག་པས་དར་རྒྱས་གང་ཆེ་བྱེད་དགོས་པ་འདུག།",
    "དེང་སང་རང་གཞན་གྱི་བཤེས་གཉེན་འགའ་ཞིག་མངའ་རིས་པཎ་ཆེན་མཁས་བཙུན་ཙམ་ཡིན་ཟེར་ཡང་།",
    "རང་བྱན་ཚུད་པར་འདུག་གོ་ཨ་བོ་ཡེ།",
    "བློ་གྲོས་ལ་ནང་བྱན་རྙེད་ནས་གདའ།",
    "བདུནསྣང་བ་སེམས་སུ་རྟོགས་ནས་གདའ།",
    "མི་ང་རང་དང་དཀོན་ཅོག་གཅིག་ཏུ་འདྲེས།",
    "དེ་དུས་ཁོ་རང་ལ་ཐ་དད་ནས་འཕྲོད་པ་ཞིག་སྤྱི་མཐུན་དུ་གྱིས་སྔ་འགྱུར་བཀའ་མ་གསུངས་པ་ལྟར་བྱས་ཤིང་།",
    "དེ་ཡང་རང་གཏེར་ཐརམཁཁཁལ་ཁབ་བབབལས་ལྷམས་ནས་ཧཱུཾ་ཧཱིའི་སྒྲ་སྒྲོགས་ཤིང་།",
    "མི་ཀུན་གྱིས་འདི་གཅུང་པོ་ལེགས་ལྡན་མ་ནོར་བར་འདུག་ཟེར་བ་བྱུང་།",
    "བུ་ཆུང་འདི་ང་ལ་ཅལ་ཅོལ་དུ་མ་ལབ་ཅིང་འདྲི་བ་འདུག།",
    "དེ་རྣམས་སྔགས་ལུགས་ཀྱི་རིམ་སྐྱེས་པའི་ཉམས་གོ་ཡུལ་ཉིས་བརྒྱདུ་མ་ལུས་པར་བྱུང་འདུག།",
    "ཁ་སིང་ནས་མཚམས་མི་བྱེད་པར་ཅི་བྱེད་འདི་བྱེད་མེད་པ་བྱེད་འདུག་ཟེར།",
    "ཉིན་མཚན་གཉིས་སུ་བསམས་ཙ་ན།",
    "ཉི་ཤུགྱང་ལོགས་ལ་ཡི་གེ་དག་མ་ཉུང་བ་ཞིག་བྲིས་འདུག་སྟེ།",
    "དེ་དང་རིམ་གྱིས་མཇལ་བར་གདའ་ཡི་གསུངས།",
    "ད་ནི་རྒྱལ་སྲིད་དགོས་པ་མི་གདའ།",
    "འདེ་ཞིང་འདུག་པ་ལ་ཐམས་ཅད་དགྲར་མ་གྱུར་པ་མི་འདུག་པས།",
    "ཕྱིས་ཁོ་རང་དཔོན་སློབ་དུས་ཟིང་ཆེར་པའི་རྟེན་དུ་བཟུང་།",
    "དེང་སང་ནི་པཀྵ་འདིས་དེ་ཕྱོགས་སུ་མི་ཐར་བ་འདུག།",
    "དེ་ལྟར་ཚིགས་སུ་བཅད་པ་དེ་ཡང་དྲང་དོན་དུ་སླར་ཟླ་བ་གསུམ་པ་རྣམདང་བཞི་པའི་མཚམས་སུ་པོ་ཏ་ལར་ཕེབས་སྐབས་མཇལ་ཞེས་པར་འདུག་ཀྱང་།",
    "འཛམ་གླིང་རང་ལུས་འདོམ་གང་གྲུ་བཞི་སྟེ།",
    "དྭངས་མ་ལུས་ཟུངས་རང་རང་མེ་དྲོད་ཀྱིས།",
    "ཞེ་སྡང་འདམ་རིང་རང་བཞིན་ངང་རྒྱུད་བཟང་།",
    "གཅེར་བུར་འདུག་དང་སྐྲ་དང་ཁ་སྤུ་བྲེགས།",
    "ཚད་དགུང་གཉིད་ལོག་འདུག་རྗེས་དྲག་ཤུལ་བྱས།",
    "འགྲངས་རྗེས་དལ་བར་འདུག་དང་ཉིན་གཉིད་ལོག།",
    "རང་རང་གནས་སུ་འཕེལ་ཞིང་གསོག་པར་བྱེད།",
    "གཉིས་པ་ལུས་ཀྱི་མེ་དྲོད་རང་གནས་འདུག་ཆ་ཤས་ལུས་ཟུངས་ཀུན་ལ་གནས་པ་དེ།",
    "རྒྱུ་ནི་རང་རང་སྐྱེད་པའི་རྐྱེན་ཡིན་ཏེ།",
    "གོས་བསྒོ་ཁང་པ་ཆག་ཆག་བཏབ་པར་འདུག།",
    "རྔུལ་ཞིང་འདར་ལ་སྐྲག་ཅིང་འདུག་མི་ཚུགས།",
    "གསོག་དུས་ཞི་ལ་ལངས་ནས་སྦྱང་བས་བཅོས།",
    "མེ་འདུག་པ་ན་མུན་པ་མེད།",
    "ཤེས་བློ་དམན་ཞིང་སོས་དལ་བག་ཡངས་ཆེ་བས་དེ་དག་དོན་གཉེར་བྱེད་མཁན་ཡང་ཆེས་ཉུང་བས་ཁོ་བོས་འབད་རྩོལ་གྱི་ངལ་བ་བརྟེན་པ་འདི་ནི་དགོས་དོན་མེད་པ་ཞིག་གདའ་ཞེས་ཐུགས་བཞེད་བཤོལ་ཏེ་འགྱུར་གྱི་མཚམས་བཞག་པར་མཛད་དོ།",
    "ཚིགས་བཅད་རྐང་བཞི་པ་ཞེས་ཚིགས་བཅད་གཅིག་ལ་རྐང་པ་བཞིར་གྲངས་ངེས་པའི་ཐ་ཚིག་མཛད་འདུག་པ་དང་།",
    "རྐང་པ་གཅིག་ནས་དྲུག་པའི་བར་ཚིགས་བཅད་ཡིན་པར་གསུངས་འདུག་ཅིང་།",
    "དེ་སྐབས་སློབ་དཔོན་དེ་ཉིད་སྐུ་ན་ཤིན་ཏུ་ཆུང་བ་ཡིན་ཚོད་འདུག་ཅེས་ཀྱང་ཟེར།",
    "བཀླུབས་ནས་ཙོག་བུའི་ཚུལ་གྱིས་འདུག་བྱེད་ལ།",
    "སྙན་པའི་སྒྲ་སྒྲོག་དུས་ལས་ཡོལ་མེད་པ།",
    "འོན་ཀྱང་ལྷ་ལམ་ཕ་མཐའ་མངོན་འདུག་གམ།",
    "ང་རང་ཁྱེད་ལ་ཤིན་ཏུ་དགའོ།",
    "ད་དུང་ས་གོམ་པ་གང་གང་ན་གདའ་ཞེས་སྨྲས་པས།",
    "ཡབ་ཡུམ་གཉིས་སྐུ་ཚེའི་བར་གཅོད་དུ་འགྲོ་བར་འདུག་དགོངས་ནས་ཁྱིམ་ཐབ་བྱའོ་ཞེས་ཞུས་པར།",
    "ཁོང་རང་འཆི་བར་ཁོ་ཐག་ཆོད་ནས་ཉེ་འཁོར་དང་།",
    "ན་སོ་ཤིན་ཏུ་ཕྲ་བས་ངའི་རྒྱུ་ནོར་ལོངས་སྤྱོད་རྣམས་ཉར་ཚགས་བྱེད་ཐུབ་པར་མི་གདའ་བས།",
    "ཁྱེད་བོད་ལ་བྱོན་ན་ཕན་ཐོགས་གདའ།",
    "ལོ་ཐོག་དང་འབྲས་བུའི་རིགས་ཀྱང་ལྷག་པར་ཇེ་ཕུན་སུམ་ཚོགས་པར་གྱུར་ཞིང་འདུག་གོ་ཞེས་ཞུས་པར།",
    "ཐབས་གང་བྱས་ཀྱང་འདི་ལ་གླགས་རྙེད་པར་མི་འདུག་སོགས་འདིར་སྤྲོས་པ་བསྐྱུངས།",
    "མཛོད་འགྲེལ་དུ་དེ་གསུམ་འོག་མིན་འགྲོ་བར་མ་ངེས་པར་གསུངས་པ་ལྟར་ན།",
    "སོ་སོར་དཔྱོད་པའི་སྐབས་གཉིས་ཀར་ཡང་ཡ་མཐའ་གཉིས་དང་མ་མཐའ་གསུམ་ཁོ་ནར་མཛད་འདུག་པའི་ཡང་ཕྱིར་རོ།",
    "ཞེས་གོ་རིམ་དང་དེ་གསུམ་གྱི་ཁྱད་པར་ཡང་སྐུ་མཆེད་དགོངས་པ་གཅིག་ཏུ་འདུག་གོ།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "ཞེས་སྲིད་རྩེར་འགྲོ་དང་འོག་མིན་འགྲོ་ལ་ཡང་འཕར་བ་གསུམ་པ་ལས་འཕར་བ་དང་པོ་གཉིས་ཀྱི་རྣམ་གཞག་མ་མཛད་པར་སྣང་བའི་དགོངས་པ་ནི་བརྟག་དཀའ་བར་འདུག་སྟེ།",
    "སྐྱེ་བ་མ་མཆིས་པ་དང་འགག་པ་མ་མཆིས་པ་དང་གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལས་བརྩམས་ནས།",
    "སྐྱེ་བ་མ་མཆིས་པ་དང་འགག་པ་མ་མཆིས་པ་དང་གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལས་བརྩམས་ནས།",
