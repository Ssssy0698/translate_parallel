    "འབྲས་བུ་ལ་སྤང་ཐོབ་མེད་པར་ལ་བཟླ།",
    "དམ་ཚིག་ལ་སྲུང་མཚམས་མེད་པར་ལ་བཟླ།",
    "ལྷ་ཐམས་ཅད་ཐུགས་རྗེ་ཆེན་པོ་ལས་ལྷག་པ་མེད་པར་ལ་བཟླ།",
    "ཡི་གེ་དྲུག་པ་ལས་ལྷག་པ་མེད་པར་ལ་བཟླ།",
    "ཉམས་ལེན་ཐམས་ཅད་རང་ཤར་རང་གྲོལ་ལས་ལྷག་པ་མེད་པར་ལ་བཟླ།",
    "ཉམས་ལེན་ཐམས་ཅད་བསྒྲུབ་བྱ་མེད་པར་ལ་བཟླ།",
    "རྣམ་པར་རྟོག་པ་ཐམས་ཅད་མ་འགགས་རང་བྱུང་བཟང་ངན་མེད་དོ།",
    "སྣང་སྲིད་ཀྱི་ད་ལྟར་གྱི་སྣང་བ་འཁྲུལ་སྣང་ཡིན་པས་མི་བདེན་པར་ལྟའོ།",
    "སེམས་རང་སར་བཞག་པས་མཚན་མའི་རྣམ་པར་རྟོག་པས་འབྱུང་འཇུག་མི་ནུས་པར་ལ་བཅད།",
    "གསེར་ལ་བཞུ་བཏུལ་གསེར་བཟོ་ཅི་བྱས་ཀྱང་ཁ་དོག་གསེར་ལས་མི་འགྱུར་བ་ལྟར།",
    "སྒྱུ་མ་མཁན་གྱིས་སྒྱུ་མ་བྱས་པའི་གཟུགས་དང་ཆོ་འཕྲུལ་ཅིར་སྣང་ཡང་མི་བདེན་པ་ལྟར།",
    "ད་ལྟར་གྱི་སྣང་བ་འཁྲུལ་སྣང་བ་བདེན་པ་མེད་པར་ཤེས་པར་བྱ།",
    "བོས་བསླུས་ནས་བཟུང་བསད་བྱས་པ་ལྟར།",
    "རང་གྲོགས་དང་བུ་ཚ་མཛའ་བཤེས་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྩ་བ་ངན་འགྲོར་ཁྲིད་པའི་སླུ་བྱེད་ཡིན་པར་ཤེས་པར་བྱ།",
    "ཆུ་བོའི་གཞུང་ལ་རྒྱུན་ཆད་མེད་པར་འབབ་པ་ལྟར།",
    "འདས་མ་འོངས་ད་ལྟར་གྱི་ཤེས་པ་སྟོང་པའི་ངོ་བོར་ཤེས་པས་ཉམས་ལེན་རྒྱུན་ཆད་མེད་པར་ལམ་དུ་འཁྱེར།",
    "ཅེ་སྤྱང་དང་བྱི་ལའི་མིག་ལ་ཉིན་ནུབ་མེད་པར་གསལ་བ་ལྟར།",
    "ཡུལ་ལ་འདོད་ཅིང་ཆགས་པ་ལ་སོགས་པ་གང་ལ་ཡང་ཞེན་པ་མེད་པར་རང་གྲོལ་དུ་བཏང་།",
    "ཁ་ཆུས་བཀང་ནས་སྨྲར་མི་བཏུབ་པར་སྨྲ་བསམ་བརྗོད་བྱ་དང་བྲལ་བར་བྱས་ལ་སྒོམ།",
    "སྨྱོན་པ་ལ་བཟའ་གཏད་མེད་པར་སྣ་མ་ཎི་བཀའ་འབུམ།",
    "རྒྱལ་པོ་གདན་ལ་བཞུགས་པ་ལས་དང་བྱ་བ་ལ་མི་འཇུག་པ་ལྟར།",
    "ད་ལྟར་གྱི་ནོར་རྫས་ལ་གདུང་སེམས་བྱས་པས་མ་རྙེད་ལྟོགས་པ་ཚོ་འཁྲུལ།",
    "ཐོ་ཡོར་ལ་མི་ཡིན་པར་བཟུང་ནས་འཁྲུལ་བ་ལྟར།",
    "ད་ལྟར་གྱི་གཟུང་འཛིན་གྱིས་མ་ཡིན་པ་ལ་ཡིན་པར་ཉེ་འབྲེལ་དུ་བཟུང་བས་འཁྲུལ།",
    "འཁྲུལ་པ་ལྟར་ཚེ་མི་རྟག་པ་ལ་རྟག་པར་བཟུང་བས་འཁྲུལ་ལོ།",
    "མིག་ཧར་ལོང་ཅེར་ལོང་དུ་མིག་འབྲས་མི་འགུལ་བར་ཡུལ་ལ་འཛིན་པ་མེད་པར་བཞག་པ་ཐབས་ཡིན།",
    "གང་ལ་ཡང་ཡིད་ལ་བྱེད་པ་དང་དྲན་པ་གང་དུ་ཡང་མི་འཛིན་པར་བཞག་པ་ཐབས་ཡིན།",
    "ཤེས་པ་ལ་རྩིས་གདབ་མེད་པར་རང་དགར་འཇོག་པ་ཐབས་ཡིན་ནོ།",
    "བ་དེ་ཤེས་པ་དང་མིག་གཉིས་མ་ཡེངས་པར་ཚོན་རྩི་བྱུག་པ་བྱེད་པ་ལྟར།",
    "སྐྱེས་བུ་ཡི་གེ་འདྲི་བ་དེ་མིག་དང་ཡན་ལག་ཐམས་ཅད་མ་ཡེངས་པར་འདྲི་བ་ལྟར།",
    "སྐྱེས་བུ་ཚེར་མ་ཟུག་པ་འདོན་པ་དེ་ཟུག་རྔུ་མིག་གཉིས་ཀར་མ་ཡེངས་པར་འདོན་པ་ལྟར།",
    "ལོང་བ་ལ་མཆུ་བཙུམས་པ་དང་སོ་བསྟན་པ་ལ་ཁྱད་པར་མེད་པ་ལྟར།",
    "སྣང་ལ་རང་བཞིན་མེད་པར་ངོ་སྤྲད་ལ་སྒོམ།",
    "ལྷ་སེམས་སུ་ངོ་སྤྲད།",
    "སེམས་སྟོང་པར་ངོ་སྤྲད།",
    "མ་ལ་གུས་པར་གྱིས་ཤིག།",
    "མཆེད་གྲོགས་ལ་གུས་པར་གྱིས་ཤིག།",
    "ཡི་དམ་གྱི་ལྷ་ཐུགས་རྗེ་ཆེན་པོ་ལ་གུས་པར་གྱིས་ཤིག།",
    "དུག་ལྔ་དུག་གསུམ་ལ་འཇིགས་པར་གྱིས་ཤིག།",
    "སྐྱེ་འཆི་ལ་འཇིགས་པར་གྱིས་ཤིག།",
    "གཡོ་སྒྱུ་ལ་འཇིགས་པར་གྱིས་ཤིག།",
    "དད་རྫས་ལ་འཇིགས་པར་གྱིས་ཤིག།",
    "ཤེས་རབ་ཀྱིས་དོན་ཤེས་པར་གྱིས་ཤིག།",
    "ཡི་དམ་དྲན་པར་བྱས་ལ་ཐུགས་རྗེ་ཆེན་པོ་སྒོམ།",
    "མཁའ་འགྲོ་དྲན་པར་བྱས་ལ་གཏོར་ཚིགས་བཏང་།",
    "ལྟ་བ་དྲན་པར་བྱས་ལ་སེམས་སྟོང་པ་ཉིད་ཀྱི་ངང་ལ་བཞག།",
    "སེམས་ལ་ཕན་པར་འགྱུར་རོ།",
    "འཆི་བསླུ་དང་ཉེ་འདོན་༦༡ན་བྱས་ན་ཚེ་ལ་ཕན་ནོ།",
    "ལེགས་པ་བྱས་ནས་ཉེས་པ་སྤངས་ན་ཕྱི་མ་ལ་ཕན་ནོ།",
    "ངག་འཇམ་དུལ་ན་ཀུན་དང་མཐུན་པར་བྱས་ན་འཕྲལ་ལ་ཕན་ནོ།",
    "ཕོངས་པར་གྱུར་ཀྱང་ཁྲེལ་མེད་བསྲུང་ངོ།",
    "ཆགས་མེད་ཞན་མེད་བྱས་ནས་རི་ཁྲོད་གནས་སུ་བྱེད་པའི་རྣལ་འབྱོར་སྤྱང་ངོ།",
    "ངལ་དུབ་ཀྱིས་དགེ་སྦྱོར་གཅོགས་ལ་ཉེས་པ་ཕོག་པར་འགྲོའོ།",
    "གྲོགས་ཀྱིས་ཁྲེལ་ལ་བླུན་པར་འགྲོ་ཉེན་ཡོད།",
    "ལེགས་པ་བྱས་ཀྱང་ཡིད་མི་ཆེས་ཉེན་ཡོད།",
    "དགོས་པ་མེད་པར་མི་ལ་དྲག་ཤུལ་ཚིག་རྩུབ་མི་སྨྲ།",
    "དང་པོ་དད་པ་སྐྱེས་ནས་ཅི་ཡོད་སྤོང་དག་བྱས།",
    "དང་པོ་སློབ་དཔོན་རྙེད་ན་བཀུར་སྟི་འབུལ་བ་བྱས།",
    "དང་པོ་ཐོས་པ་བྱས་པས་ཁ་ལྟ་ཚིག་ལ་འབྱམས།",
    "དང་པོ་ལྟ་བ་རྟོགས་པས་སེམས་ལ་སྟོང་པར་མཐོང་།",
    "དང་པོ་ཉམས་མྱོང་བག་ཙམ་སྐྱེས་པས་སྨོན་པའི་སྤྱོད་པ་བྱས།",
    "ཆགས་སྡང་མི་སྐྱེ་ངོ་བསྲུང་མི་དགོས་ན་ཡུལ་དུ་བསྡད་ཀྱང་མི་སྟོ།",
    "འབྲེལ་པ་དང་མཆེད་གྲོགས་ཀྱི་ངོ་སྲུང་མེད་ན་སྐྱོང་ཡང་མ་བྱས་ཀྱང་མི་སྟོ།",
    "སྟོང་པ་ཉིད་ཀྱི་ནམ་མཁའ་ལ་འཛེགས་པར་འདོད་པ་ནོར།",
    "ལམ་ཟམ་སྐས་མི་འཛུགས་པར་མི་ཐར་ངེས་པའི་སྐྱེ་མེད་འཆི་མེད་ཡིན་ཟེར་བ་ནོར།",
    "བདག་ཚེ་འདིའི་རྙེད་པ་དང་སྙན་གྲགས་མི་བསྒྲུབ་པར།",
    "སེམས་སྐྱེ་མེད་ངོས་གཟུང་དང་བྲལ་བས་འདུས་མ་བྱས་ཡིན་པར་ཡིད་ཆེས།",
    "སྣང་བ་འཁྲུལ་པ་ཡིན་པས་དོན་ལ་དགྲ་གཉེན་མེད་པར་ཡིད་ཆེས།",
    "སེམས་ཀུན་གྱི་འབྱུང་གནས་ཡིན་པས་འཁོར་འདས་ཀྱི་གཞི་མ་ཡིན་པར་ཡིད་ཆེས་སོ།",
    "སྐྱེ་ཤི་མེད་པས་རྟག་པར་ཡོད།",
    "བསྟན་དུ་མེད་པས་ཆད་པར་༦༥བ་ཡོད།",
    "དུས་མཐའ་མེད་པས་བརྟན་པར་ཡོད།"
