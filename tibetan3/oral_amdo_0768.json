    "གང་ལ་ཁམས་གསུམ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་དམ་ཚིག་གིས་ཏེ།",
    "འདོད་པས་ལོག་པར་གཡེམ་པ་དང་གསུམ་མོ།",
    "བུད་མེད་སྟེན་ཧཱུཾཔ་བྱེད་དུ་བཅུག་སྟེ།",
    "ཚིག་གི་ལས་གནས་མ་ལུས་པ།",
    "དེ་ནི་རྡོ་རྗེ་མཆོག་གི་ཕྱག་ཡིན་ནོ།",
    "ཕྱག་བྱ་བར་འོས་པ་རྣམས་ལ་ཕྱག་བྱ་བའི་འདུ་ཤེས་ཡོད་མོད་ཀྱི་འགའ་ལ་ཡང་ཕྱག་བྱས་པ་མེད་དེ།",
    "དེ་ཉིད་རང་རང་གི་ངོ་བོ་ལས་མི་འགྱུར་བས་ནི་ཡི་གེའི་ཚིག་གོ།",
    "དེ་མི་ཤེས་བཞིན་དུ་ཚིག་གི་སྒོ་ནས་འཆད་དོ་ཞེས་དེ་སྙམ་དུ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ལ་དེ་རྣམས་ཀྱིས་བརྙས་པར་འགྱུར་རོ།",
    "རང་གི་ཕྱོགས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འོན་ཀྱང་ཁོ་བོ་ཅག་གིས་ནི།",
    "དོན་དམ་པར་བཅོམ་ལྡན་འདས་ཀྱིས་ཚིག་གི་སྒོ་ནས་བསྟན་པར་མི་སྤྱོད་དེ།",
    "འོན་ཀྱང་དེ་རྣམས་ལ་ས་བོན་དང་རྟེན་བཞིན་དུ་སྒྲ་དང་དོན་དག་ལ་འབྱེལ་པ་མེད་པའི་ཕྱིར་བསྟན་པའི་ཚིག་ནི་བརྗོད་དུ་མེད་ཅིང་ཕྱིན་ཅི་ལོག་གི་རང་བཞིན་ཁོ་ན་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བ་ཡིན་ནོ།",
    "མཁའ་དབྱིངས་ནི་བཙུན་མོའི་པདྨའོ།",
    "རིག་པའི་བརྟུལ་ཞུགས་སྤྱད་ཅིང་ལྷ་རྣམས་ཀྱིས་རྗེས་སུ་གནང་རྐེ་བའི་རྣལ་འབྱོར་པས་རང་གི་དཀྱིལ་འཁོར་དུ་སྐུ་རྡོ་རྗེའི་རྣལ་འབྱོར་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "རྗེས་སུ་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་ཆེན་པོའི་ཆོ་གའི་རྗེས་ཐོགས་ལ་དེ་ཁོ་ན་བཞིན་དུ་རང་གི་རིག་མ་བསྐྱེད་དེ།",
    "རིགས་ཀྱི་བྱེ་བྲག་གིས་ཞེས་བྱ་བ་ལ།",
    "རང་གི་ལས་རྣམས་ལ་སྦྱར་ནས་སླར་བཀུག་སྟེ་གནས་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པར་བྱས་ལ།",
    "རང་རང་གི་རིག་མ་རྣམས་དང་ཡང་དག་པར་ལྡན་པར་བྱས་ཏེ།",
    "ལྷ་མོའི་གཟུགས་ཅན་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་སྙོམས་པར་འཇུག་པའི་སྒོ་ནས་འཁྱུད་པ་ལ་སོགས་པ་བཅིངས་པས་འགྲུབ་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་དཀྱིལ་འཁོར་ན་གནས་པའི་འོད་དཔག་ཏུ་མེད་པའི་རྣལ་འབྱོར་དང་ལྡན་ཞིང་གོས་ཕ་དཀར་མོའི་གཟུགས་སུ་རྣམ་པར་བསྒོམས་པའི་ཕྱི་རོལ་གྱི་བུད་མེད་དང་སྙོམས་པར་ཞུགས་པས་འདོད་པའི་ཁམས་སུ་གཏོགས་པ་རྣམས་དང་།",
    "གཟུགས་ཀྱི་ཁམས་སུ་གཏོགས་པའི་བུད་མེད་ཀྱི་གཟུགས་བྷ་ག་མེད་པ་རྣམས་དང་གཟུགས་མེད་པའི་ཁམས་ན་གནས་པའི་བུད་མེད་རང་གི་ཡིད་ཀྱིས་བསམས་པ་གོས་དཀར་མོའི་གཟུགས་སུ་རྣམ་པར་བསྒོམས་པ་རྣམས་རང་གི་བ་སྤུའི་བུ་གའི་གསེབ་ནས་རྣམ་པར་བྱུང་བའི་འོད་དཔག་ཏུ་མེད་པའི་ཚོགས་རྣམས་ཀྱིས་ཇི་ལྟ་བ་བཞིན་དུ་སྤྱད་པར་བྱའོ།",
    "གསུང་གི་རྡོ་རྗེས་མི་སྨད་དོ།",
    "རྡོ་རྗེ་སྐྱེ་མཆེད་ནི་ནང་གི་བདག་ཉིད་ཅན་གྱི་མིག་ལ་སོགས་པ་རྣམས་ཏེ།",
    "དེ་རྣམས་ཀྱི་ཡུལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རང་བཞིན་ཅན་རྣམ་པ་གསུམ་པའི་གཟུགས་ལ་སོགས་པ་རྣམས་ནི་གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པ་ལྷ་མོ་དྲུག་གི་རང་བཞིན་ནོ།",
    "དེ་ཀུན་དུ་བཟང་མོའི་གཟུགས་སུ་གྱུར་པ་སྙོམས་པར་འཇུག་པའི་འཁྱུད་པའི་སྦྱོར་བས་འཛིན་པར་མཛད་པས་ན་རྡོ་རྗེ་འཛིན་པ་སྟེ།",
    "དེས་ནི་སའི་ཁམས་ལ་སོགས་པའི་རང་བཞིན་ཅན་ལ་སོགས་པ་ལྷ་མོ་བཞིས་ཡོངས་སུ་བསྐོར་ཞིང་༥།",
    "འཁོར་གྱི་དཀྱིལ་འཁོར་ལ་གཟིགས་ནས་ཅང་མི་གསུང་བར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི་མགོན་པོ་བྱམས་པ་དང་དེ་བཞིན་གཤེགས་པ་རྣམས་གོ་རིམས་༡བཞིན་དུ་འདྲི་བ་དང་།",
    "སྙམ་དུ་གང་གི་རྟག་ཏུ་ང་རྒྱལ་བྱས།",
    "འཁོར་ལོ་ཅན་ཀུན་གདན་བསམ་མོ།",
    "ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་རང་གི་ལྷའི་གནས་ན་གནས་པའི་ཡི་གེ་ཏྲི་ལས་བྱུང་བའི་པདྨ་འདབ་མ་སྣ་ཚོགས་པ་རྣམས་ལ།",
    "དེ་ནས་དེ་ཁོ་ན་བཞིན་དུ་གདོལ་པའི་བུ་མོ་ལོ་བཅུ་གཉིས་ལོན་པའམ་བསྒོམས་པ་ལས་བྱུང་བ་བྱིན་གྱིས་བརླབས་ལ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་ང་རྒྱལ་དང་ལྡན་པ་ཁོ་ནས་བདག་ཉིད་རྡོ་རྗེ་འཆང་ཆེན་པོར་རང་གི་ཡང་དག་པར་སྤྱོར་བ་ལས་ཕྱུང་སྟེ།",
    "རང་གི་བ་སྤུའི་བུ་གའི་གསེབ་ནས་བྱུང་བའི་དེ་བཞིན་གཤེགས་པ་ཏིལ་གྱི་གང་བུ་དང་མཚུངས་པ་༢བུམ་པ་དང་རོལ་ཆ་དང་གོས་བཟང་པོ་དང་རྒྱན་བཟང་པོ་བསྣམས་པ་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཡོངས་སུ་གང་བར་བསམ་པར་བྱའོ།",
    "རང་གི་དཀྱིལ་འཁོར་ན་གནས་པའི་རྡོ་རྗེ་འཆང་ཆེན་པོའི་རྣལ་འབྱོར་དང་ལྡན་པས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་ཀུན་དུ་རེག་སྟེ།",
    "དེ་བཀུག་སྟེ་རང་གི་ལུས་ལ་བཅུག་ལ།་",
    "ཡི་གེ་དྷྲིས་མཚན་པའི་རང་གི་ལྕེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་སྦུ་གུ་ཁ་དོག་སྔོན་པོ་དང་།",
    "བསྡུས་ཏེ་རང་གི་ལྷ་མོའི་པདྨར་བཅུག་ལ།",
    "དེ་ནས་པདྨ་ན་གནས་པ་རང་གི་ཁས་བླངས་ཤིང་རང་བྱུང་དང་བཅས་པའི་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་དེས་རང་གི་ལུས་ལ་གནས་པའི་ལྷའི་འཁོར་ལོ་དང་དཀྱིལ་འཁོར་པ་རྣམས་ཚིམ་པར་བྱའོ།",
    "རང་གི་སྐུ་ལ་སོགས་པ་བྱེན་གྱིས་བརླབ་༡པ་ལ་ཐུག་པའི་ཆོ་གའི་རྗེས་ཐོགས་ལ་སྔ་མ་བཞིན་དུ་སྤྱད་པའོ།",
    "དེ་དག་གིས་བསྐྱེད་པའི་བདེ་བ་ཆེན་པོ་ལས་བྱུང་བ་ཉིད་ཡིན་པའི་ཕྱིར་གསང་བ་གསུམ་གནས་རྡོ་རྗེ་ལས་བྱུང་བའོ།",
    "བཟང་པོ་བདག་གིས་བསྒྲུབ་པར་བྱ།",
    "རང་གི་མགོའི་སྟེང་དུ་མཐོ་གང་ཙམ་གྱིས་དཔགས་ཐུནས་བདུད་རྩི་ལྔའི་དཀྱིལ་འཁོར་མཐོ་གང་གི་ཚད་དང་ལྡན་པ།",
    "དུག་གིས་ནོན་པའི་ལུས་ལ་འོད་ཟེར་གཞུག་ཅིང་དབྱུང་བ་དང་བྱབ་པའི་སྒོ་ནས་དུག་གཞོམ་པར་བྱའོ།",
    "འོད་ཟེར་སེར་པོ་རྣམས་ཀྱིས་བཀང་ན་རེངས་པར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ནི་སྣ་ཚོགས་རྡོ་རྗེ་རྩེ་མོ་བཅུ་གཉིས་པའི་སྟེང་ན་གནས་པའོ།",
    "དེའི་ལྟེ་བར་གྲུ་གསུམ་དང་དེའི་ནང་དུ་ཡི་གེ་ཧ་མགོ་བོ་དང་ཟླ་ཚེས་དང་ཐིག་ལེ་དང་རྩེ་མོ་དང་ལྡན་པ་དང་།",
    "ཨ་མྲྀ་ཏེ་ཧཱུཾ་ཕཊ།",
    "མུ་ཁྱུད་ལ་བཀོད་པའི་ཡི་གེ་རེ་རེ་ལས་གྲུབ་པའི་འཕགས་པ་བདུད་རྩི་འཁྱེལ་པའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་བར་བལྟས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀ་ན་གནས་པའི་པདྨའི་སྟེང་གི་ཟླ་བ་ལ་གནས་པའི་ས་བོན་ལས་བྱུང་བའི་བསྒྲུབ་བྱ་རྡོ་རྗེའི་སྐུ་ཅན་ཡི་གེ་ཧཾ་ལས་བྱུང་བའི་རྡོ་རྗེའི་གོ་བགོས་པ་བསམས་ལ།",
    "ཀུ་བེེ་རའི་ཕྱོགས་སུ་ཨ་མྲྀ་ཏ།",
    "དེའི་དབུས་སུ་ཐོད་པ་གསུམ་ཁ་སྦུབ་པའི་སྟེང་དུ་བདུད་རྩི་ལྔ་དང་བཅས་པའི་ཆང་གིས་ལེགས་པར་བྱུགས་པའི་ཐོད་པ་ཁ་སྦུབ་ཏུ་ཡང་དག་པར་བཞག་སྟེ།",
    "མཚན་ཕྱེད་ཀྱི་དུས་སུ་ཐོད་པའི་སྟན་ལ་འདུག་ཅིང་ཐོད་པ་གཉིས་ལ་པུས་མོ་གཉིས་བཞག་སྟེ་སྙོམས་པར་འཇུག་པར་གནས་པས་རང་གི་སྔགས་ཟློས་ཤིང་དུད་པ་ཆགས་སུ་གཞུག་གོ།",
    "རང་གི་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "དེའི་བཙུན་མོ་ནི་ཀུན་དུ་བཟང་མོ་སྟེ།",
    "དེའི་བྷ་ག་ལ་བྱ་བ་ཐམས་ཅད་དང་བྲལ་ཞིང་མཆོག་ཏུ་བདེ་བ་ལ་དགྱེས་པའི་རྡོ་རྗེ་འཆང་ཆེན་པོ་རང་གི་འཁོར་གྱི་རིག་མ་དང་གཉིས་སུ་མེད་པའི་སྦྱོར་བས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་ཐ་མི་དད་པར་གྱུར་པས་བཞུགས་སོ།",
    "གལ་ཏེ་གྱུར་དུ་བཅུག་༢ན་ཅིའི་ཕྱིར་སྟོང་པ་ཉིད་ལ་སོགས་པའི་རང་བཞིན་ཅན་གྱི་ལྷ་མོ་རྣམས་ཀྱིས་རབ་ཏུ་སྒུལ་བར་བྱེད་ཅེ་ན།",
