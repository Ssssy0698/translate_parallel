    "མདའ་ལྔའི་སྦྱོར་བ་དག་གིས་ནི།",
    "ཁ་དོག་དམར་པོ་སྟོང་གི་ཆའི་ཐུཡི་གེ་ཨོཾ་གྱིས་མཚན་པ།",
    "བྱིས་པའི་གཟུགས་ཅན་རྣམས་རང་གི་སྤྱི་བོ་ན་བཞུགས་པའི་འོད་དཔག་ཏུ་མེད་པ་དང་ཡང་དག་པར་སྤྱོར་བ་ལས་སྤྲོ་བར་བའོ།",
    "ཅེས་བྱ་བ་ལ་རིགས་བརྗོད་པར་འདོད་པའི་སྒོ་ནས་གཅིག་གི་ཚིག་ཅན་དུ་བྱས་ཏེ།",
    "བུམ་པ་བཟང་པོའི་གཟུགས་སེར་པོ་རང་གི་མཆུ་ལ་མངོན་དུ་ཕྱོགས་པར་རོ།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་ཚོགས་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་ཀུན་དུ་རེག་ནས།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་ཚོགས་རྣམས་ཀྱིས་ནམ་མཁའ་ཟིཁྱབ་པའི་དེ་བཞིན་གཤེགས་པའི་སྤྲིན་རྣམས་ལ་ཀུན་དུ་རེག་སྟེ།",
    "ཡང་དེ་རྣམས་བསྡུས་ཏེ་རང་གི་ས་བོན་ལ་གཞུག་པར་བྱའོ།",
    "དེ་བཀུག་སྟེ་རང་གི་ལུས་ལ་བཅུག་ལ།",
    "སྔགས་ཀྱི་ཚིག་དགོད་དོ་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་ཀྱི་ལྷ་མོའི་ཐུགས་ཀར་ཟླ་བ་ལ་ཡི་གེ་ལྕུ་རྣམ་པར་བཀོད་ནས།",
    "བཙུན་མོའི་པདྨའི་དབུས་སུའོ།",
    "དེའི་དབུས་སུ་པདྨའི་སྟེང་གི་ཟླ་བའི་གདན་ལ་བཞུགས་པའི་རྡོ་རྗེ་འཆང་ཆེན་པོའི་ང་རྒྱལ་དང་ལྡན་པས་དེ་ཁོ་ན་བཞིན་དུ་རྗེས་སུ་རྣལ་འབྱོར་ལ་སོགས་པ་ཆོ་ག་ཐམས་ཅད་བྱས་ཏེ།",
    "ཟླ་ཚེས་དང་ཐིག་ལེ་དང་རྩེ་མོ་འབར་བ་དང་ལྡན་པའི་ཛེེ་སེར་གྱིར་བསམས་ལ།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་སེར་པོའི་ཚོགས་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱེངས་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་ཀུན་དུ་རེག་སྟེ།",
    "རང་གི་བྱལུས་ལ་བཅུག་སྟེ་བདག་ཉིད་འཕགས་པ་ཛ་བྷ་ལར་བསམ་པར་བྱའོ།",
    "མདུན་ན་འདུག་པའི་པདྨའི་སྟེང་གི་ཟླ་བའི་གདན་ལ་མངོན་དུ་ཕྱོགས་པར་གནས་པར་བསམ་བྱུཔར་བྱའོ།",
    "དེ་ནས་རང་གི་ལག་པ་གཡོན་པ་ལ།",
    "རྡོ་རྗེས་མཚན་པའི་ས་བོན་གྱིས་གང་བའི་འབྲས་བུ་དང་བཅས་པའི་གཡས་པའི་རྩ་བའི་ཕྱག་གིས་འཁྱུད་པ།",
    "པདྨའི་སྟེང་གི་ཟླ་བའི་གདན་ལ་སྐྱིལ་ཀྲུང་ཕྱེད་པས་བཞུགས་ཆོཔ།",
    "རང་གི་རིག་མ་དང་གཉིས་སུ་མེད་པར་གྱུར་པ།་",
    "ལྷ་མོ་བཞིས་ཡོངས་སུ་བསྐོར་བ།",
    "ཡི་གེ་ཛེེ་ཀྱིས་མཚན་པ་དེ་རང་གི་ཡང་དག་པར་སྦྱོར་བ་ལས་ཀུན་དུ་ཕྱུང་ལ།",
    "ཆུའང་མོས་པ་འདི་ཉིད་ཀྱི་སྒོ་ནས་དབུལ་བར་བྱའོ།",
    "ཆོ་ག་ཡིས་ཞེས་བྱ་བ་ནི་ཡི་གེ་ཧཱུཾ་གིས་སོ།",
    "བྱང་མ་ར་ཀ་ཏའི་རང་བཞིན་ཅན་དབུས་བེ་ཌཱུརྱའི་རྣམ་པ་ཅན་བསམ་མོ་ཞེས་བྱ་བ་མན་ངག་ཡིན་ནོ།",
    "ས་བོན་འདི་ནི་གནོད་སྦྱིན་མ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་ལས་གསུམ་བྱེ་བྲག་གིས།",
    "འཇམ་དཔལ་ཀྱི་རྣལ་འབྱོར་དང་ལྡན་པས་རང་གི་སྙོམས་པར་འཇུག་པ་ལས་དཔལ་གཤིན་རྗེ་མཐར་བྱེད་ཕྱུང་སྟེ།",
    "གང་ལ་གནོད་སྦྱིན་མ་ཐམས་ཅད་བསྐྱེད་པ་ལ་ཧཱུཾཐུན་མོང་དུ་གྱུར་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "ཅེས་བྱ་བ་ནི་རང་གི་རིགས་ཀྱི་བུ་མོ་དང་ཡང་དག་པར་སྦྱོར་བ་དང་བདུད་རྩི་ལྔ་བཟའ་བ་ལ་སོགས་པ་དངོས་སུ་བྱ་བ་ཁོ་ན་སྟེ།",
    "༦་ཞེས་བྱ་བ་ནི་ལྷ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་པ་ཁྱད་པར་གྱིས་གནོད་པར་གྱུར་པ་མེད་པའོ།་།",
    "རི་མོར་བྲིས་པ་རྣམས་ལས་གང་ཡང་རུང་བ།",
    "འདོད་ཆགས་རྡོ་རྗེའི་སྐྱོ་བ་མོ་ནི་དཀར་མོ་ཞེས་བྱ་བའོ།",
    "ངག་གི་རྡོ་རྗེ་མཆོག་སེམས་ལ།",
    "ཞེས་བྱ་བ་ནི་གསུང་རྡོ་རྗེ་ལ་གོས་དཀར་མོ་དང་།",
    "རིག་པའི་བརྟུལ་ཞུགས་འཛིན་པའི་རྣལ་འབྱོར་པའི་དངོས་གྲུབ་ཀྱི་འབྲས་བུ་ལ་ཐུག་གི་བར་དུ།",
    "རིག་པའི་བརྟུལ་ཞུགས་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡེ་ཤེས་སྟོན་པར་མཛད་པས་ན་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "སྐུ་ལ་སོགས་པའི་དཀྱིལ་འཁོར་གསུམ་གྱི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་དཀྱིལ་འཁོར་གསུམ་མོ།",
    "འགྱུར་བ་ལ་འགྱུར་བར་བྱེད་ཅེས་བྱ་བ་བཞིན་དུ་རང་གི་དོན་ལ་བྱེད་པའི་རྐྱེན་སྦྱར་བར་༤རྣམ་པར་སྣང་མཛད་དོ།་།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཉོན་མོངས་པའི་དྲི་མ་ཐམས་ཅད་ཞི་བར་མཛད་པས་༦ན་ཞི་བའོ།",
    "ཞེ་སྡང་ལས་བྱུང་བའི་ཕྲག་དོག་གི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རྡོ་རྗེ་སེམས་དཔའོ།",
    "དེའི་ལོངས་སྤྱོད་ནི་མི་བསྐྱོད་པ་ལ་སོགས་པའི་སྐུ་ལ་སོགས་པའི་རྣམ་པ་སྟེ་གང་གིས་བསྟོད་ནའོ།",
    "ཞེས་བྱ་བ་ནི་གཏི་མུག་གི་རིགས་ཅན་གྱི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་བའི་སྲོག་གཅོད་པ་ལ་སོགས་པའིའོཥྱོ།",
    "འབྲས་བུ་དེ་ལ་ལྷག་པར་མོས་པ་རྣམས་ཀྱིས་ཀྱང་དེ་ཁོ་ན་བཞིན་དུ་བསྒོ་མ་པའི་སྒོ་ནས་ཐམས་ཅད་བྱའོ་ཞེས་བྱ་བ་ནི་དམ་ཚིག་གོ།",
    "ཚིག་རྩུབ་མོ་དང་།",
    "མོས་པ་དམན་པ་ཞེས་བྱ་བ་ནི་རང་བདག་ཉིད་དུལ་བ་དང་ཞི་བ་འབའ་ཞིག་ལྕུར་ལེན་སྦུང་།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་སེར་པོའི་ཚོགས་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་ཀུན་དུ་རེག་ནས་ཚངས་པའི་གཟུགས་རྣམས་སུ་བྱས་ལ་བསྡུས་ཏེ།",
    "དེས་ཟུའགྲོ་བ་རྣམས་ཞི་བར་བྱེད་དུ་བཅུག་ལ་དེ་བཀུག་སྟེ་རང་གི་ལུས་ལ་བཅུག་ལ་༤ཐམས་ཅད་ཡོངས་སུ་གྱུར་པར་བྱས་ནས།",
    "རང་གི་ཁ་དོག་དང་ཕྱག་མཚན་ལ་སོགས་པ་ཐམས་ཅད་དང་ལྡན་པ།",
    "མེ་ཏོག་སྣ་ཚོགས་བཅིངས་པའི་ཐོར་ཚུགས་ཅན་གྱི་ཞལ་གཅིག་པའི་ལྷ་མོ་རྡོ་རྗེ་ཞི་བ་དང་སྙོམས་པར་ཞུགས་པ།",
    "བྱུ་རུ་པྱ་ཚིགས་དགུའི་དབྱེག་སྐྱེ་པ་དང་བཅས་པའི་གཡོན་པའི་རྩ་བའི་ཕྱག་གི་རིག་མའི་ནུ་མ་འཛིན་པ།",
    "སྟག་གི་པགས་པའི་གོས་གྱོན་པ།",
    "ཁྱུ་མཆོག་གི།",
    "ཇི་ལྟར་རྙེད་པའི་ཕྱི་རོལ་གྱི་བཙུན་མོ་རྣམས་ཀྱིས་མཉེས་པར་བྱའོ་ཞེས་བྱ་བ་ནི་དམ་ཚིག་གོ།",
    "དུང་དང་བཅས་པའི་གཡས་པ་དང་གཡོན་པའི་རྩ་བའི་ཕྱག་དག་གིས་རང་དང་རྗེས་སུ་མཐུན་པའི་ཁ་དོག་ལ་སོགས་པ་དང་ལྡན་པ།",
    "གཞན་དག་གིས་འཁོར་ལོ་དང་མདའ་བོ་ཆེ་བསྣམས་པ།",
    "ནམ་མཁའ་ལྡིང་གི་སྟེང་ན་པདྨ་དང་ཉི་མ་ལ་བཞུགས་པ།",
    "དངོས་པོ་གང་དང་གང་དག་གིས།",
    "དེ་རྣམས་ཀྱི་བཙུན་མོའི་ཆུང་མ་ཀླུ་མོ་ཆགས་པ་དང་ལྡན་པ་རྣམས་བསྒྲུབ་པར་འདོད་ཅིང་འོ་མ་འཐུང་བ་ལྷུར་ལེན་པ་དང་།",
    "གང་ཞིག་དེ་ལྟར་མི་བྱེད་པ་དེ་ནི་ཉོན་མོངས་པ་ཉིད་འབའ་ཞིག་ཏུ་འགྱུར་གྱི་།",
    "ཁྲོ་བོ་རྡོ་རྗེ་ས་འོག་གི་རྣལ་འབྱོར་གྱི་ལྷ་མ་ཡིན་གྱི་བུ་མོ་རྣམས་བསྒྲུབ་པར་བྱའོ།",
    "རྟའི་ཞག་རྣམས་སྲིན་མོ་རྣམས་ལ་སྦྱིན་པར་བྱ་ཞིང་རང་ཉིད་ཀྱང་བཟའ་བར་བྱའོ།",
    "འདི་ནི་སྲིན་མོ་རྣམས་འབའ་ཞིག་གི་མ་ཡིན་གྱི།",
    "དཔལ་བདེ་མཆོག་གི་རྒྱུད་ཕྱི་མ་ལས་གསུངས་པའི་དཔལ་ཏེ་རུ་ཀའི་དཀྱིལ་འཁོར་པའི་ལྷ་མོ་རྣམས་ཀྱི་ཀྱེ་ས་བོན་ཡི་གེ་ཧྲི་ལ་སོགས་པ་གང་ཡང་རུང་བ་རྣམ་པར་བཀོད་ལ།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་རྣམས་ཀྱིས་ནམ་མཁའ་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་ཀུན་དུ་རེག་སྟེ།",
    "དེ་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པ་སྔ་མ་བཞིན་དུ་མི་བསྐྱོད་པའི་གཟུགས་སུ་བསྐྱེད་ནས་དེ་བཀུག་སྟེ་རང་གི་ལུས་ལ་བཅུག་ལ།་",
    "བདག་ཉིད་དཀར་མོ་ལ་སོགས་པ་རྡོ་རྗེ་མཁའ་འགྲོ་མའམ་གང་ཡང་རུང་བའི་གཟུགས་སུ་བསམ་པར་བྱའོ།",
    "དེ་ལ་རེ་ཞིག་དཀར་མོ་ནི།",
