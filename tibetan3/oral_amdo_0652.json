    "རྒྱལ་པོའི་ཁབ་ན་གནས་པའི་སྐྱེ་བོའི་ཚོགས་རྣམས་ཀྱིས་ཐོས་ནས་སྐྱེད་མོས་ཚལ་དེའི་ཕྱི་ནང་དུ་ཀུ་ཅོའི་སྒྲ་ཆེན་པོས་གང་བར་གྱུར་ཏེ།",
    "རྒྱལ་པོ་དེ་སྐྱེ་དགུ་ལ་བྱམས་པ་ཞིག་པས་ཕྱིར་ཞིང་བཙུན་མོ་སྐྱེ་བོའི་ཚོགས་དང་བཅས་ཏེ་མིག་མཆི་མས་གང་ཞིང་འཁོད་དོ།",
    "ལྷ་བྱ་འདི་དག་ནི་དུད་འགྲོའི་སྐྱེ་གནས་སུ་སོང་བ་ལགས་པས་རྒྱལ་སྲིད་ཕྱེད་ཀྱིས་འདི་དག་ལ་ཅི་བགྱི།",
    "འདི་དག་འོད་མའི་ཚལ་གང་དུ་གནས་པ་དེར་འདི་དག་གི་གནས་བཅའོ།",
    "སྐྱེད་མོས་ཚལ་དེ་འོད་མའི་ཚལ་གྱིས་ཡོངས་སུ་བསྐོར་ཏེ།",
    "ཇི་ཙམ་ན་བཅོམ་ལྡན་འདས་མ་ག་དྷཱ་ནས་ལྗོངས་རྒྱུ་ཞིང་གཤེགས་པ་དང་རྒྱལ་པོའི་ཁབ་ཏུ་བྱོན་ནས་ཤིང་ཞིག་གི་དྲུང་ན་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་སྟན་ལས་ལངས་ཏེ་སོང་ངོ།",
    "གསེར་གྱི་བྱ་མ་བུམ་བླངས་ཏེ་བཙུན་པ་འོད་མའི་ཚལ་བྱ་ཀ་ལན་ད་ཀ་གནས་པ་འདིར་བཅོམ་ལྡན་འདས་ཅི་བདེར་བཞུགས་ཤིག་ཅེས་བཅོམ་ལྡན་འདས་ལ་སྐྱེད་མོས་ཚལ་དེ་ཕུལ་ལོ།",
    "ཡང་དེའི་ཚེ་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་དགོས་པ་འགའ་ཞིག་གི་ཕྱིར་རྒྱལ་པོའི་ཁབ་ཏུ་ཕྱིན་ནས་དེ་ཁྱིམ་བདག་དེའི་ཁྱིམ་དུ་ནུབ་མོ་འབྲང་བཏབ་བོ།",
    "དེ་ནས་ཁྱིམ་བདག་དེ་དེ་ཉིད་ཀྱི་མཚན་མོ་ལངས་ཏེ་ནང་མི་རྣམས་ལ་བསྒོ་བ།",
    "ཁྱིམ་བདག་ཁྱོད་ཅི་བག་མ་ལེན་ཏམ།",
    "ཁྱིམ་བདག་བཅོམ་ལྡན་འདས་དེ་བདག་ཅག་གིས་བལྟར་རུང་ངམ།",
    "ཁྱིམ་བདག་དེའི་ཕྱིར་རེ་ཞིག་སྡོད་ཅིག་དང་།",
    "གལ་ཏེ་བཅོམ་ལྡན་འདས་འདི་ཉིད་དུ་གཤེགས་པ་དང་སང་ཁྱོད་ཀྱི་མཐོང་བར་འགྱུར་བའི་གནས་གང་ཡིན་པ་དེ་ཡོད་དོ།",
    "དེ་ནམ་མ་ནངས་པར་ནམ་ནངས་པའི་འདུ་ཤེས་ཀྱིས་ལྷོ་སྒོ་གང་ན་བ་དེར་སོང་བ་དང་།",
    "གཡོན་ཅན་འགའ་ཞིག་གིས་གཙེས་པར་མི་འགྱུར་གྲང་སྙམ་དུ་བསམས་ནས་སླར་ལྡོག་པར་འདོད་པ་དང་།",
    "ཁྱིམ་བདག་སྤྱན་སྔར་སོང་ཤིག།",
    "ཁྱོད་སྤྱན་སྔར་སོང་ན་ལེགས་པར་འགྱུར་གྱི་སླར་ལོག་ན་ནི་མ་ཡིན་ནོ།",
    "ཁྱིམ་བདག་སྤྱན་སྔར་སོང་ཤིག།",
    "ཁྱོད་སྤྱན་སྔར་སོང་ན་ལེགས་པར་འགྱུར་གྱི་སླར་ལོག་ན་ནི་མ་ཡིན་ནོ།",
    "ཁྱིམ་བདག་སྤྱན་སྔར་སོང་ཤིག།",
    "ཁྱོད་སྤྱན་སྔར་སོང་ན་ལེགས་པར་འགྱུར་གྱི།",
    "ཐོ་གར་ཡུལ་གྱི་བུ་མོ་བརྒྱ།",
    "ཁྱིམ་བདག་སྤྱན་སྔར་སོང་ཤིག།",
    "ཁྱོད་སྤྱན་སྔར་སོང་ན་ལེགས་པར་འགྱུར་གྱི་སླར་ལོག་ན་ནི་མ་ཡིན་ནོ།",
    "བཞིན་བཟངས་ཁྱོད་སུ་ཞིག།",
    "ཁྱིམ་བདག་ཁོ་བོ་ནི་ཁྱོད་ཉིད་ཀྱི་གྲོགས་པོ་རྙིང་པ་བྲམ་ཟེའི་ཁྱེའུ་སྦྲང་རྩིའི་ཕུང་པོ་ཡིན་ཏེ།",
    "མོད་གལ་གྱི་བུ་གཉིས་ལ་སེམས་དད་པ་བསྐྱེད་ནས་ཤི་བ་དང་།",
    "དེའི་ཕྱིར་ཁྱོད་ལ་ཁོ་བོས་འདི་སྐད་ཅེས་ཁྱིམ་བདག་སྤྱན་སྔར་སོང་ཤིག།",
    "ཁྱོད་སྤྱན་སྔར་སོང་ན་ལེགས་པར་འགྱུར་གྱི།",
    "བསིལ་བའི་ཚལ་གྱི་དུར་ཁྲོད་དུ་སོང་བ་དང་།",
    "དེའི་ཚེ་བཅོམ་ལྡན་འདས་གཙུག་ལག་ཁང་གི་ཕྱི་རོལ་བླ་གབ་མེད་པ་ན་འཆག་ཅིང་ལྷག་པར་ཡང་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་འོང་བ་ལ་གཞེས་སོ།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་གིས་ཡང་དག་པར་དགྱེས་པར་འགྱུར་བས་ཡང་དག་པར་དགྱེས་པར་བྱེད་དོ།",
    "འདིར་ནི་རེ་བ་ཀུན་བཅད་ནས།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་དགའ་བའི་སེམས་དང་།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཁྱིམ་བདག་ཁྱོད་ཀྱི་མིང་ཅི།",
    "བཙུན་པ་བདག་གི་མིང་བཟང་སྦྱིན་ལགས་མོད་ཀྱི་བདག་གིས་མགོན་མ་མཆིས་པ་རྣམས་ལ་འཚལ་མ་སྩོལ་བས་དེས་ན་བདག་མགོན་མེད་ཟས་སྦྱིན་ཞེས་བགྱི་བར་སྐྱེ་བོས་འཚལ་ཏོ།",
    "ཁྱིམ་བདག་ཁྱོད་ཀྱི་གནས་གང་ཡིན།",
    "བདག་གིས་ཅི་ནས་ཀྱང་མཉན་ཡོད་དུ་དགེ་སློང་རྣམས་མཆིས་པ་དང་།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་ཅང་མི་གསུང་བས་གནང་བར་རིག་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ནས་སོང་ངོ།",
    "དེས་རྒྱལ་པོའི་ཁབ་ཏུ་བྱ་བ་དང་བསྒྲུབ་པ་གང་ཡིན་པ་དེ་ཐམས་ཅད་བྱས་ཤིང་བསྒྲུབས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་བདག་གི་གྲོགས་དགེ་སློང་གཅིག་སྩལ་དུ་གསོལ།",
    "དགེ་སློང་སུ་ཞིག་གིས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་འཁོར་དང་བཅས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ནས་སོང་ངོ།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་ལམ་རྒྱགས་མང་པོ་ཁྱེར་ནས་ནུབ་མོ་ནུབ་མོ་ཞིང་མཉན་ཡོད་དུ་སོང་སྟེ་ཕྱིན་ནས་ད་མཉན་ཡོད་དུ་མ་ཞུགས་པ་ཉིད་དུ་ཀུན་དགའ་ར་བ་ནས་ཀུན་དགའ་ར་བ་དང་།",
    "སྐྱེད་མོས་ཚལ་ནས་སྐྱེད་མོས་ཚལ་དང་།",
    "མཚན་མོ་གཅོམ་ཆུང་བ་དང་།",
    "སྡིག་སྦྲུལ་གྱི་རེག་པ་ཆུང་བའི་ས་ཕྱོགས་གང་ན་ཡོད་པ་དེར་བདག་གིས་བཅོམ་ལྡན་འདས་ཀྱི་ཕྱིར་གཙུག་ལག་ཁང་བརྩིག་ན་ཕྱོགས་དེ་གང་ན་ཡོད་སྙམ་པ་ལས།",
    "མཚན་མོ་གཅོམ་ཆུང་བ་དང་།",
