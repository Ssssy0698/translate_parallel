    "ཁོ་བོ་ཅག་གི་ནི་མཉན་ཡོད་ཡིན་ནོ།",
    "ཁྱིམ་བདག་ཁྱོད་དགའ་མགུར་བྱེད་དུ་མི་གཞུག་སྟེ།",
    "རུང་གིས་རེ་ཞིག་འཕགས་པ་ཤཱ་རིའི་བུ་ལ་བརྟག་གོ།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "བཙུན་པ་ཤཱ་རིའི་བུ་མུ་སྟེགས་ཅན་རྣམས་འདི་སྐད་ཅེས་ཁྱིམ་བདག་ཁྱོད་དགའ་མགུར་བྱེད་དུ་མི་གཞུག་སྟེ།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་དགའ་བ་དང་མགུ་བ་སྐྱེས་ནས་མུ་སྟེགས་ཅན་རྣམས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་མུ་སྟེགས་ཅན་རྣམས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཤེས་ལྡན་དག་འཕགས་པ་ཤཱ་རིའི་བུ་ན་རེ་དེ་བཞིན་དུ་བྱ་སྟེ།",
    "ཁྱོད་དང་བདག་ཅག་ནི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ཡིན་གྱིས།",
    "དགེ་སྦྱོང་གོ་ཏ་མའི་ཉན་ཐོས་ཀྱི་མཆོག་བདག་ཅག་གིས་བརྩད་པའི་ཕྱིར་བཀུག་ན་དེ་ཕྱོགས་ཚོལ་གྱིས།",
    "ཁྱོད་ཀྱང་བདག་ཅག་གི་གྲོགས་གྱིས་ཤིག།",
    "རུང་གིས་དེ་བཞིན་དུ་བྱ་སྟེ།",
    "གང་གི་ཚེ་ཁྱེད་ཅག་འདུས་པར་གྱུར་པ་དེའི་ཚེ་ཁོ་བོ་ལ་སྦྲོན་ཅིག།",
    "མུ་སྟེགས་ཅན་རྣམས་བག་ཚ་བ་དང་སེམས་ཁྲལ་སྐྱེས་ནས་ཉིན་རེ་ཞིང་ཕྱོགས་ཚོལ་བ་དང་།",
    "ཤེས་ལྡན་དག་ཅི་རེ་ཞིག་བྱེད་དམ།",
    "ཁོ་བོ་ཅག་གིས་བྱས།",
    "ཁྱོད་ཀྱིས་ཤིག་ཅིག་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་བསམས་པ།",
    "ཁྱོད་ཀྱིས་བྱོས་ཤིག་ངས་གཞིག་གོ།",
    "དེ་མིག་འཕྲུལ་བྱེད་པ་ཡིན་པས་དེས་ཤིང་ས་ཧ་ཀར་ཤིན་ཏུ་མེ་ཏོག་གིས་རྒྱས་པ་ཞིག་སྤྲུལ་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་གླང་པོ་ཆེ་བཟང་པོ་ཞིག་སྤྲུལ་ནས་དེས་ཀུན་དུ་བརྣལ་ནས་མིང་གི་ལྷག་མ་ཙམ་ཞིག་བཞག་གོ།",
    "བརྩལ་བ་བྱས་པས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས་དགྲ་བཅོམ་པ་མངོན་སུམ་དུ་བྱས་ཏེ་དགྲ་བཅོམ་པར་གྱུར་ནས།",
    "ཁ་ཅིག་གིས་ནི་སྐྱབས་སུ་འགྲོ་བ་དང་བསླབ་པའི་གཞི་རྣམས་བླངས།",
    "ཁ་ཅིག་གིས་ནི་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས།",
    "ཁ་ཅིག་གིས་ནི་ལན་གཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་དང་།",
    "ཁ་ཅིག་གིས་ནི་ཕྱིར་མི་འོང་བའི་འབྲས་བུ།",
    "ཁ་ཅིག་གིས་ནི་རབ་ཏུ་བྱུང་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཏེ།",
    "བདག་ཅག་གིས་འདི་ཤགས་ཀྱིས་ཚར་བཅད་མི་ནུས་ཀྱིས་ཐབས་ཤིག་བཤམ་པར་བྱས་ལ།",
    "ཁྱོད་ཀྱི་གཙུག་ལག་ཁང་དུ་གླ་མིའི་ལས་བྱའོ།",
