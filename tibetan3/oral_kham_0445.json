    "ཀུ་ཤའི་ཁྲི་ལ་འདུག་ལ་བཟླས་བརྗོད་བརྩམས།",
    "བར་དུ་མཉམ་གཞག་ཙོག་ཙོག་པུར་འདུག་ནས།",
    "ཕྲེང་ཆད་ཡིག་ཕྲེང་གཅིག་ཙམ་བྱུང་འདུག་པ་དེ་ཅི་ལྟར་ཡིན་དྲིས་པའི་ལན་དུ།",
    "རང་རང་གཞུང་བཞིན་ལེན་དང་གཏོང་རྒྱུ་ནི།",
    "དང་པོ་ཉིད་ནས་རང་རང་ལམ་འཇུག་དང་།",
    "སེམས་དང་སེམས་བྱུང་རང་གསལ་སྐད་ཅིག་མ།",
    "ཀུན་ཀྱང་རང་རང་ལུགས་ཀྱི་ཀུན་རྫོབ་ཀྱི།",
    "འཁོར་འདས་ཀུན་དང་རང་བཞིན་མེད་པར་མཉམ་ཉིད་དུ་གནས་པ་ཡིན་ཏེ།",
    "རང་རང་ལས་བྱེད་དེ་ལ་རྒྱུ་བར་བཏགས།",
    "བསྐྱེད་རིམ་ལྷའི་དངོས་པོར་ཞེན་པ་མེད་པ་རྫོགས་རིམ་གྱི་ཡེ་ཤེས་ཀྱང་རང་བཞིན་མེད་པར་ཡོངས་སུ་ཤེས་པར་བྱ་སྟེ་དེ་ལྟར་ཤེས་པས་གྲོལ་བར་འགྱུར་ཞིང་།",
    "ཨོཾ་ན་གྲ་ན་གྲ་ཀུ་མ་རི་ཀེ་དི་བྱ་ལོ་ཙ་ནི་སྭཱཧཱ་ཞེས་བྱ་བའི་སྔགས་འདིས་སྔོན་དུ་འབུམ་བཟླས་ཏེ་པདྨ་དམར་པོའི་སྦྱིན་སྲེག་ཁྲི་བྱས་ནས་དུས་མ་ཡིན་པའི་དུས་མར་ངོའམ།",
    "ཨེ་མ་ཞེས་དགའ་ཞིང་རངས་པ་སྔོན་དུ་བཏང་ནས།",
    "སྟན་ལ་འདུག་པ་དང་།",
    "བདེ་སྟོང་ཟུང་འཇུག་དེ་རྣམ་པ་སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པས་སྒྱུ་མའི་གཟུགས་ཅན་ཉིད་དུ་འདོད་དོ།",
    "ཞེས་པ་ལ་རང་དང་རང་ཞེས་པ་ནས་བདེ་བ་ཅན་ཞེས་སོ།",
    "ཞ་ལུའི་གྲྭ་ཚང་གཅིག་དུས་འཁོ་ར་གྲྭ་ཚང་བཞི།",
    "སྤྱི་ལོ་༡༩༣༦ བོད་མེ་བྱི་ལོའི་ཟླ་བ་༡ ཚེས་༣ ཉིན་ཕྲན་བཙས་འདུག་པ་བྱིས་པ་ཆུང་དུས་རྒྱལ་ཚེ་རིང་ངམ་ཟུར་ཆག་ཏུ་ལོ་རྒྱལ་ཞེས་འབོད།",
    "ཁྱེད་རང་ལ་ཉེན་ཁྲ་ཞིག་འོང་ངེས་ཞེས་གསུངས་བྱུང་བས་དེ་ནས་བཟུང་ཇུས་ཏོག་མ་བྱས།",
    "ཁ་ཕོར་སོགས་ཚང་མ་ཟང་ཟིང་བཟོས་འདུག་པ་དང་ཕྲན་རང་ལ་རྒྱ་གར་ནས་ཐོན་པའི་དངུལ་ཁུག་སྐེད་པར་དཀྲི་བྱེད་གཅིག་དང་དངུལ་ཕྲན་བུ་ཡོད་པ་འཁྱེར་འདུག་དེ་ནས་རིམ་གྱི་ཛ་དྲག་ཏུ་བཏང་ནས་ཉལ་ཁང་སོ་སོའི་འགན་འཁུར་བ་ཆོགས་འདུར་སྐོང་བ་དང་མི་འགའ་ཞིག་ལ་འདྲི་ཞིབ་བྱས།",
    "བླ་བྲང་ཨུ་རྒྱན་གྱིས་ཨ་ཙི་ཁྱེད་ཚོ་ཡང་འདིར་སླེབས་སམ།",
    "ང་ནས་ཡར་ལོངས་དང་མགོ་ཡུ་འཁོར་གྱི་མི་འདུག་གམ།",
    "ཁོ་ཚོར་ངོ་དགའ་སྤྲེལ་ལས་འཁྲབ་ན་ལྟོ་ཆས་ཡག་ཙམ་སྤྲད་ཀྱང་རང་ཉིད་ཀྱིས་རྒྱུན་ནས་དེ་རིགས་འཁྲབ་མ་ཤེས་སྟབས་ཉིན་བདུན་རིང་ལྟོ་ཆས་ཀྱང་སྐྱོ་པོ་ཞིག་ལས་མ་ཐོབ།",
    "ཕྲན་གྱིས་ཁེ་པར་མིག་འབུར་ཚུགས་སུ་བལྟས་ཏེ་ཨམ་གཙིགས་བསྔམས་ཀྱང་གདོང་སྨད་དེ་ཞུམ་ཞུམ་གྱིས་འགྲོ་བ་ད་ནི་ང་གཉིས་ཀྱི་སྤོར་ངོས་ལེན་ཚར་འདུག་སྙམ་སྟེ་གུས་ཀྱིས་ཀྱང་རྒྱ་ལས་སྐྱིད་པར་ང་ལྔ་ས་ལེན་ཞིག་ཞུ་རྒྱུར་ཡར་བཅར་ཆོག་པ་ཞུ།",
    "ཁྱེད་རང་སྐུ་གཟུགས་ལ་ཐུགས་བཅགས་གནང་དགོས།",
    "མས་རྒྱ་མིས་བཙུགས་པའི་ཆུས་སུ་འབྱོར་འདུག་པ་ང་ཆོ་འབྱོར་བ་དང་མལ་ས་ནས་ལངས་ཏེ་སྣེ་ལེན་བྱས།",
    "སྐབས་དེར་ཉེར་མཁོའི་ཆས་ཀ་ཡང་ཉོ་ཡུལ་དཀའ་ངལ་ཧ་ཅང་ཆེ་བས་ཐ་མག་འཐེན་མི་རྣམས་ཀྱིས་ཇ་རོ་རྩོདག་བུར་བསྒྲིལ་ནས་འཐེན་གྱི་འདུག་ཕྲན་གྱིས་ལམ་བར་དམག་སྒར་ཞིག་ནས་ཕོ།",
    "གང་འདྲ་འདུག་ཅེས་བརྗོད་སྐབས་འུ།",
    "ས་འགྱེལ་མ་གུག་འཁར་བ་ལ་བརྟེན་ནས་ཡར་ལྡང་ནས་ཕྲན་ལ་འཐམས་ཏེ་ངུ་བཞིན་འདུག་པ།",
    "འཁོར་ཞག་དུས་ཡུན་རྫོགས་པ་དང་རྒྱལ་རྩེ་ནས་ཐོན་ཏེ་སྔར་མུས་ལྟར་སྤོ་བོ་སྤྲ་རྨོག་བཙོན་ཁྲ།",
