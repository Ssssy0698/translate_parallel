    "ཤིན་ཏུ་ཡུན་རིང་དུ་བཟླས་པ་ལས་ཞི་གནས་དང་ལྷག་མཐོང་གེརྫོགས་པར་གྱུར་པ་ན།་",
    "ཡང་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གྲངས་ཀྱི་ངེས་པ་གསུངས་པ་ཡིན།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "བསད་ན་མྱུར་དུ་འགྲུབ་པར་འགྱུར།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དེའི་ལག་ན་གནས་པའི་རྡོ་རྗེ་འབར་བ་འཕངས་པ་ལ་སོགས་པས་ཕྱེ་མར་བྱས་པ་ཉིད་ཀྱིས་སོ།",
    "དེ་ལ་གནོད་པར་བྱེད་པར་འདོད་པ་གྲདང་ལྡན་པ་རྣམས་ལའོ།",
    "ཁྲོ་བོའི་སྔགས་ལ་གསུངས་པའི་གསད་པ་དང་།",
    "བསྐྲད་པ་ལ་སོགས་པའི་ཆོ་ག་ཁ་བསྐང་བའི་ཕྱིར་ཁྲག་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྲག་ལ་སོགས་པ་གཤེར་བར་བྱས་པའི་གོས་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "ངེས་པར་འཇིག་ཅེས་བྱ་བ་ནི་འཆི་བའོ།",
    "འཇིགས་པའི་ཚུལ་ནི་ཁྲོ་བོ་ལས་བྱུང་བའི་ལུས་ཀྱི་རྣམ་པར་འགྱུར་བའི་ཚུལ་དུའོ།",
    "དབྱིག་བྱེ་སྔོན་གྱི་སྔགས་སུ་གསུངས་པའི་ཆོ་ག་དང་།",
    "ཕུར་བུའི་མངོན་སྤྱོད་ནི་མི་རུས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "མི་ཤེས་པ་དང་ལྡན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱད་པར་དུ་གསུངས་པ་འདི་ནི་སྦྱོར་བའི་མཐར་ཐུག་ཀྱེགསལ་བར་བྱ་བའི་དོན་ཡིན་ནོ།",
    "དོན་ནི་ཁྲོ་བོ་གང་ཡང་རུང་བའི་སྦྱོར་བས་དུར་ཁྲོད་ཀྱི་རས་ལ་དུག་དང་ལན་ཚྭ་དང་སྐེ་ཚེ་ལ་སོགས་པས་ཁྲོ་བོའི་རྡོ་རྗེ་བྲིས་ལ་དེའི་ལྟེ་བར་བསྒྲུབ་པར་བྱ་བའི་མིང་དང་།",
    "དེའི་སྟེང་དུ་རྐང་པ་བཞག་ནས་སྔགས་བརྒྱ་རྩ་བརྒྱད་མཚན་ཕྱེད་དམ་ཉི་མའི་གུང་ལ་བཟླས་ན་དེ་ནས་ཇི་སྐད་གསུངས་པ་བཞིན་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་འདི་ཡིན་ནོ།",
    "བསྐྲད་པ་ནི་ཡང་ན་ཐོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཟླས་པ་བྱ་སྟེ་སྦས་ན་ཞེས་བྱ་བ་ནི་བཟླས་པར་བྱས་ནས་སྦས་ནའོ།",
    "རྨིག་པས་འདེབས་པར་བྱེད་པ་དེ་དག་བསམ་པར་བྱས་པ་གང་ཡིན་པ་དེས་དེ་དང་རྣམ་པར་དབྱེ་བར་འགྱུར་རོ།",
    "དུག་དང་མྱོས་པར་བྱེད་པའི་ལོ་མ་དང་།",
    "དེ་ནས་དགྲ་བོའི་སྒོ་ལ་སོགས་པར་ཙོག་པུས་ཁུང་བུ་བརྐོས་ལ་སྦས་ན་ཇི་སྲིད་གསུངས་པ་བཞིན་དུ་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་ཡིན་ནོ།",
    "དེ་སྟོན་པར་མཛད་པ་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ངེས་པར་འཆིང་བ་ཡང་ཡིན་ལ།",
    "སྔགས་འདིར་ཡང་སཏྠ་དུཥྛན་སརྦ་པཱ་པཾ་ཞེས་བྱ་བའི་ཕུང་ཞུབའི་གནས་སུ་བསྒྲུབ་པར་བྱ་བའི་མིང་གཉིས་པའི་མཐའ་ཅན་བལྟ་བར་བྱའོ།",
    "ཁྲོ་བོའི་སྤྱོར་བ་བྱས་ལ་ཐུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ཕུར་བུས་ཕུར་བུ་གདབ་པར་བྱ་བ་ཡིན་པ་དེའི་ཕྱིར།",
    "འོད་འཕྲོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ནི་མི་བསྐྱོད་པ་ཁྲོས་པར་གྱུར་པའོ།",
    "གཟུགས་བརྙན་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའི་གཟུགས་བརྙན་ནོ།",
    "བསམས་ནས་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའི་གཟུགས་སུ་བསྒོམས་ནས་སོ།",
    "ཇི་ལྟར་བསྣུན་པར་བྱ་ཞེ་ན།",
    "དེ་རྣམས་ལ་ཕུར་བུས་བསྣུན་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "ལྕགས་ལས་བྱས་པའི་ཕུར་བུ་སོར་བརྒྱད་པའི་ཁོང་སྟོང་དུ་བཅུག་ལ་མེ་ཏོག་སྔོན་པོས་མཆོད་དེ་ཞེ་སྡང་རྡོ་རྗེའི་སྦྱོར་བས་བརྒྱ་རྩ་བརྒྱད་བཟླ་བར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་མིང་བསྐུལ་བའི་ཚིག་དང་ལྡན་པའི་སྔགས་བཟླས་ལ་སྤྱི་བོ་ཕྱེནས་བརྩམས་ཏེ།",
    "དེ་བཞིན་དུ་འཁོར་ལོའི་ལྟེ་བར་ཁྲོས་ཤིང་གནག་པའི་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕུར་བུ་བྲིས་ལ།",
    "དེ་མི་རུས་ཀྱི་ཕུར་བུ་སོར་བརྒྱད་པའི་ཁོང་སྟོང་དུ་བཅུག་ནས་ཁྲོས་ཤིང་གནག་པའི་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བ་དེས་སྔ་མ་བཞིན་དུ་ཕུར་བུས་བྱུགདབ་པར་བྱའོ།",
    "རྡོ་རྗེ་བདུད་རྩི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་རྨྱེལ་བདུད་རྩི་འཁྱིལ་པ་ལ་ཕྱབདུད་རྩི་ཐབ་སྤྱོར་རོ།",
    "དེས་གདུག་ཅིང་ཁྲོ་བ་རྣམས་ཚར་གཅད་པར་བྱའོ།",
    "དེ་ལྕགས་ལ་སོགས་པ་ལས་བྱས་པའི་ཕུར་བུ་སོར་བརྒྱད་པའི་ཁོང་སྟོང་དུ་བཅུག་ལ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པའི་སྦྱོར་བ་དེས་སྔ་མ་བཞིན་དུ་ཕུར་བུས་གདབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིར་མན་ངག་ནི་བསྒྲུབ་པར་བྱ་བའི་གཟུགས་བརྙན་ལ་མི་རུས་ཀྱི་ཕུར་བུ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པ་དང་བཅས་པས་སྤྱི་བོར་ཕུར་བུས་བཏབ་ན་ཀླད་གཟེར་ཀྱིས་བཏབ་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ལ་ལྕགས་ལས་བྱས་པའི་ཕུར་བུ་སོར་བརྒྱད་པས་བཏབ་ལ་དུར་ཁྲོད་ཀྱི་མེའི་ནང་དུ་བཅུག་ན་འཕྲལ་དུ་འཆི་བར་འགྱུར་རོ།",
    "ཕུར་བུས་བཏབ་ན་ཞེས་བྱ་བ་ནི་ཕུར་བུས་བཏབ་པར་གྱུར་པ་ནའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཉིད་བདུད་རྩི་ཐབ་སྦྱོར་དང་གཉིས་སུ་མེད་པར་གྱུར་པ་ནི་རྣམ་པར་སྣང་མཛད་ཆེན་པོའོ།",
    "དེས་སྐུ་རྣམ་པར་འཕྲུལ་པ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕུར་བུའོ།་།",
    "ཕན་ཚུན་ཞེས་བྱ་བ་ལ་སོགས་པས་སྦྱོར་བ་གསུངས་པ་ནི་ཕན་ཚུན་དཀྲི་བ་ནི་དམ་དུ་འཁྱུད་པའོ།",
    "ཐབས་དང་ཤེས་རབ་ཀྱི་ལུས་གང་ལ་ཁྲོས་ཤིང་གནག་པའི་སྤྱན་རྣམ་པར་སྣང་མཛད་ཀྱི་ཚུལ་དུ་བསྒོམས་པ་ཡོད་པའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱེཚུལ་ནི་པདྨའི་ལྟེ་བ་ལ་བཞུགས་པའི་རྟག་པའི་གཟུགས་དཀར་པོའོ།",
    "འཇིག་རྟེན་ལས་འདས་པ་གྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱད་པར་གསུངས་པ་གྲུབ་པ་རྦོའདི་ནི་སྦྱོར་བ་ལ་བསྟོད་པའི་དོན།",
    "གསུང་དེ་ཉིད་ནི་རྣམ་པར་འཕྲུལ་པའོ།",
    "ཐུགས་དེ་ཉིད་ནི་རྣམ་པར་འཕྲུལ་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཇི་སྐད་དུགསུངས་པ་ཉིད་ཀྱིས་སོ།",
    "རྡོ་རྗེ་ཕུར་བུ་སྟོན་པར་མཛད་པའི་ཕྱིར་དེ་སྐད་ཅེས་བྱའོ།",
    "མཉེས་པར་མི་བྱེད་པ་ནི་མ་ཡིན་ནོ་ཞེས་ཡང་དག་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མཉེས་པ་ཡང་དག་པར་སྟོན་པར་མཛད་དེ།",
    "འདི་ཉིད་རྟོགས་པར་བྱ་བའི་ཕྱིར་དུ།",
    "ཨེ་མའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱི་ཀུན་བཏུས་པ་འདི་ནི་མ་ལུས་པར་ཐོབ་པའོ།",
    "དེ་རྣམས་རྣམ་པར་འཇོམས་པའོ།",
    "ཕུར་བུས་བསྣུན་པ་འབྲས་བུ་ཆེན་པོ་འདི་ཉིད་གང་ཡིན་པ་དེ་ཅི་རྣམ་པར་སྣང་མཛད་དང་།",
    "སྐུ་ལ་སོགས་པའི་སྦྱོར་བས་ཕུར་བུས་གདབ་པར་གསུངས་པ་གང་ཡིན་པ་དེ་ནི་སྔགས་རྣམས་ལ་སྟེ།",
    "དེ་ཐོབ་པར་བྱེད་པས་ན་སྐུ་གསུང་ཐུགས་ཀྱི་མཆོག་སྦྱིན་པའོ།",
    "དེ་རྣམས་ཀྱིས་བསྡུས་པ་ནི་མ་ལུས་པར་ཐོབ་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་ཕྱིར་འདུད་པར་བྱེད་པ་དེས།",
    "སྔགས་དེ་ཤིན་ཏུ་དགྱེས་པར་འགྱུར།",
    "ཡང་ཡང་དང་ནི་ངེས་པར་རམ།",
    "མྱུར་བ་ཉིད་ཅེས་ཤེས་པར་བྱ།",
    "བྱ་བའི་དོན་ཏེ་གསུངས་ཤིག་གསུངས་ཤིག་ཅེས་བྱ་བའི་བར་དུའོ།",
    "སཱ་དྷ་ནི་ཐོབ་པར་བྱེད་པ་སྟེ།",
    "ཆར་འབེབས་པར་བྱེད་པས་ན་ཀ་ཊི་སྟེ།",
    "སྤྲིན་ལ་སོགས་པ་རླན་པར་བྱེད་པའོ།",
    "དེ་ཡང་རླན་པ་རྣམས་རྒྱས་པར་བྱེད་པའོ།",
    "བི་ཀ་ཊི་ཞེས་བྱ་བ་ནི་རྣམ་པར་བསྐམས་པ་རྣམས་སོ།",
    "དེ་ལྟར་ན་ཁྲོ་བོའི་ཡེ་ཤེས་མངོན་སུམ་དུ་བྱ་བ་ལ་ངེས་པར་སྦྱར་བའོ།",
    "གཡེར་བག་དང་བཅས་པར་གསོལ་བར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་ཙ་ཏུརྨུ་ཁའོ།",
    "གྲིམས་པར་མཚོན་ཆ་འཕྱར་བ་ཉིད་ཀྱི་ཕྱིར་ཙ་ཏུསྒོ་ཛའ།",
    "དེ་རྣམས་ཀྱི་སྠཱ་ཎ་ཨ་པ་ཧ་ར་ནེེ་ནི་སྲོག་འཕྲོག་པར་གྱིས་ཤིག་པའོ།",
    "བོད་པ་ལ་རྣམ་པར་བསྒྱུར་ནས་བཞི་པ་ཡིན་ནོ།",
    "གདུག་པ་རྣམས་འཇིགས་པར་བྱེད་པ་ཡང་ཁྲོ་བོའི་ལས་ཡིན་ཏེ།",
    "བི་ཀྲྀ་ཏཱ་ན་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་མན་ཆད་ནི་བསྒོ་བ་ལ་ངེས་པར་སྦྱར་བ་ཡིན་ནོ།",
    "ཡི་གེ་ཧཱུཾ་སྤྱོགཉིས་ཀྱིས་ནི་དྲག་པོའི་ལས་ཀྱི་བསྒོ་ཚེབ་ལ་ངེས་པར་སྦྱར་བ་གཉིས་སོ།",
    "རི་པུ་ན་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་གདུག་ཟུཔ་རྣམས་སོ།",
    "བདུད་རྩི་ཐབ་སྤྱོར་གྱི་སྔགས་ལ་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་འཇིག་པར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་བཛྲ་ཡང་ཡིན་ལ་ཀྲི་ཀླུདྷ་ཡང་ཡིན་པ་དུདེ་ལྟར་ན་མཚན་གཞན་སྤུནོ།",
    "ཁཱ་ཏི་ཁཱ་ཏི་ཞེས་བྱ་བ་ནི་སེམས་འདིའི་ཡང་གཉིས་སུ་སྣང་བ་ནུབ་པར་གྱིས་ཤིག་པའོ།",
    "ཏིཥྛ་ཏིཥྛ་ཞེས་བྱ་བ་ནི་སྣང་བ་ཙམ་དེ་ཉིད་ལ་ཆགས་པར་མཛོད་ཅིག་པ་སྟེ།",
    "བརྙ་བནྡྷ་ཞེས་བྱ་བ་ནི་དེ་ཉིད་ལ་གཞན་དག་ཀྱང་བཞག་པར་མཛོད་ཅིག་པ་སྟེ།",
    "མི་འཇིག་རྣམ་པར་མི་ཤེས་པ།",
    "གང་དག་ཅེ་ན་སརྦ་བིསྤྱོ་བི་ནཱ་ཡ་རྐ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་ལྟར་ན་བཞི་པོ་ནི་ཁྲོ་བོའི་ལས་ལ་ངེས་པར་སྦྱོར་བའོ།",
    "ཧཱུཾ་ནི་ཁྲོ་བོ་ཡིན་པར་བཤད།",
    "ཅེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་ཁྲོ་བོའི་ཡེ་སྤུཤེས་མངོན་སུམ་དུ་བྱེད་པ་ལ་ངེས་པར་སྦྱོར་བ་ཡིན་ཏེ།",
    "ལ་ངེས་པར་སྦྱོར་བ་གཉིས་ཡིན་ནོ།",
    "དང་པོའི་ཧཱུཾ་རྔུགསུམ་གྱིས་ནི་ཁྲོ་བོའི་ཡེ་ཤེས་མངོན་དུ་བྱེད་པ་ལ་ངེས་པར་སྦྱོར་བའོ།",
    "དེ་དེ་ལྟར་ན་དོན་ཐམས་ཅད་མཉམ་པར་བྱས་པ་དང་།",
    "སེམས་མཉམ་པ་དང་མི་མཉམ་པས་ཡང་དག་པར་མཚོན་པ་ནི་ལྡུཔདྨའི་ཁྲོ་བོའི་ཡེ་ཤེས་ཏེ།",
    "དེ་ཉིད་རྣམ་པར་དཀྲུག་པར་མཛད་པས་ན་བི་རུ་ལའོ།",
    "ལུས་ལ་སོགས་པ་ལ་འབར་བ་ཉིད་ཀྱི་མེ་སྟག་འབྱེན་པར་མཛད་པས་ན་ཛ་ལི་ཏའི་བི་སྤུ་ལིངྒའོ།",
    "ཁཱ་ད་ཁཱ་ད་པ་ར་མནྟྲ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཁྲོ་བོའི་ལས་ལ་ཡོངེས་པར་སྦྱར་བའོ།",
    "ཨ་བེེ་ཤ་ཡ་ཞེས་བྱ་བ་ནི་སྣོད་ལ་བབས་པར་མཛོད་ཅིག་ཀྱེཔའོ།",
    "འཛིན་པར་བྱེད་པས་ན་གྲ་ཧ་སྟེ།",
    "ཧཱུཾ་གསུམ་གྱིས་ནི་གདུག་པའི་ལས་ལ་ངེས་པར་སྤྱོར་བ་ཡིན་ནོ།",
    "བྷཱུ་ཏཱ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ར་ད་ར་ཞེས་བྱ་བ་ནི་ཕྱེརྣམ་པར་ཆོམས་ཤིག་རྣམ་པར་ཆོམས་ཤིག་པའོ།་།",
    "སཏྠ་ཀརྨ་ཤཱཉེནི་ཞེས་བྱ་བ་ནི་འབྱུང་པོ་དེ་དག་ཉིད་ཀྱིས་གཞན་ལ་གནོད་པར་བྱ་བ་དང་།",
    "རང་ལ་བསྲུང་བའི་ཕྱིར་བྱས་པའོ།་",
    "སཛེེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བསྒོ་བ་ལ་ངེས་པར་སྦྱོར་བའོ།་།",
    "ཏུ་རུ་ཏུ་རུ་བིསྣ་བི་ནཱ་ཤ་ཀ་ཞེས་བྱ་བ་ནི་བགེགས་རྣམ་པར་བཤིག་པའི་དོན་དུ་མྱུར་ཅིག་མྱུར་ཅིག་པའོ།",
    "གསལ་བར་བྱ་བའི་ཕྱིར་སནྡྲ་ཤ་ཧཱུཾ་ནིཊྭཱཾ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྗེས་སུ་གནང་བའི་བསྒྲུབ་པར་བྱ་བ་ཐམས་ཅད་ཀྱིའོ།",
    "ཧཱུཾ་བིབྱཱ་མཱཾ་ཤིཥྚ་ཀ་ཞེས་བྱ་བ་ནི་རིག་པ་ཐམས་ཅད་ཀྱི་ནང་ནས་ཤིན་ཏུ་ཁྱད་པར་ཅན་ནོ།",
    "མརྨཱ་ནི་བསྒྲུབ་པར་བྱ་བ་རྣམས་ཀྱིས་སོ།",
    "དེ་ཉིད་ཀྱིས་ན་ཀྲོ་ཀྱེཏནྟ་ཡ་ཞེས་གསུངས་སོ།",
    "སྟོབས་པོ་ཆེའི་སྔགས་ལ་ལར་ནི་ཨོཾ་ནོར་བུའི་རིགས་རྗོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ནས་འདིར་དེ་ཉིད་ཀྱིས་དེ་བོས་ཏེ་ཧཱུཾ་གསུམ་གྱིས་གདུག་པའི་ལས་ལ་ངེས་པར་སྦྱར་བ་གསུམ་ཡིན་ནོ།",
    "ཡང་དེ་བཞིན་དུ་བོས་ནས་ཨུ་གྲ་ཤུ་ལ་པཱ་ཎི་ཟུཞེས་བྱ་བ་ནི་ཁྱད་པར་ཏེ།",
    "དེ་བཞིན་དུ་ངེས་པར་སྤྱོར་བ་ཉིད་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ངེས་པར་སྦྱར་བ་ཉིད་ཡིན་ནོ།",
    "ཊཀྐི་ཙུཉུརྟག་ཏུ་འདོད་པར་བཤད།",
    "ཧཱུཾ་ནི་ཁྲོ་བོ་ཡིན་པར་བཤད།",
    "ཡི་གེ་ཛ་ནི་འགུགས་པར་བཤད།",
    "ཅེས་གསུངས་པ་ལྟ་བུའོ།",
    "དོན་དང་བློ་དང་མིང་ཡང་དག་པར་སྟོན་པའི་ཕྱིར་ཀཱ་ཎ་ཡང་ཡིན་པས་ན་ཨ་ཙ་ལ་ཀཱ་ནའོ།",
    "བི་ག་ནཱ་ན་ལྒེ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཧཱུཾ་གསུམ་ཁྲོ་བོའི་དོན་གྱིས་གཞིག་པར་སྦོད་པའོ།",
    "དེ་ནས་བརྗོད་བྱས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ནམ་མཁའི་སྔགས་ཞེས་བྱ་བ་ནི་སཾ་ངོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གསུམ་པོ་ནི་ངེས་པར་སྦྱོར་བ་ཡིན་ཏེ།",
    "རྗེད་པར་བྱེད་པ་ལ་རྗེད་པར་བྱེད་པ་སཾ་༦ངོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེ་ལ་དགའ་བའི་བསྔགས་པས་དེ་མཉེས་པར་བྱའོ།",
    "སྒྲིབ་པ་ཐམས་ཅད་ལ་གནོད་པར་བྱེད་པས་ན་སུ་བྷའོ།",
    "ངེས་པར་གནོན་པར་བྱེད་པས་ན་ནི་སུ་བྷའོ།",
    "དེ་དང་སློབ་དཔོན་གྱིས་སྐྲག་པར་བྱེད་པས་ན་ཏཱ་སྤུས་ནིའོ།",
    "ཏཱ་ས་ཡ་ཏཱ་ས་ཡ་ཞེས་བྱ་བ་ནི་ངེས་པར་སྤྱོར་ཧཱུཾབའོ།",
    "དེ་ལ་སྔགས་དང་པོ་ཕཊ་ཀྱི་མཐའ་ཅན་གསུམ་ནི་ངེས་པར་སྤྱོར་བའོ།",
    "སྲེག་པ་ལ་ངེས་པར་སྤྱོར་བའོ།",
    "དེའི་དོན་དུ་རྣམ་པར་འཕྲུལ་པ་ནི་ཕུར་བུས་འདེབས་པའོ།་།",
    "གཙོ་བོའི་སྒོ་ནས་ཐ་སྙད་དུ་བྱས་པའི་ཕྱིར་རོ།",
    "འདིར་ནི་དངོས་གྲུབ་ཀྱི་མཚན་མར་གྱུར་པའི་ཞུརྨི་ལམ་ནི་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "རྡོ་རྗེ་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཏེ་དེའི་བདག་ཉིད་ཀྱིས་དེ་འཛིན་པར་མཛད་པའི་ཕྱིར་རྡོ་རྗེ་འཛིན་པའོ།",
    "བཀའ་སྩལ་པ་ནི་གསུང་བར་འགྱུར་བའོསྣེ་དེ་ལྟར་ན་འདི་མཛེས་ཤིང་འབར་བས་ན་རྒྱལ་པོ་སྟེ་རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ཐམས་ཅད་དུ་ཡེ་ཤེས་སྤྲོས་པའི་ཕྱིར་ཀུན་མཁྱེན་པ་སྟེ།",
    "དོན་ཡོད་པར་གྲུབ་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ནི་ལོ་བཅུ་བཞི་པ་ནས་བརྩམས་ཏེ་ལོ་བཅོ་བརྒྱད་པའི་བར་དུ་ལྔ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བས་ན་འདིར་བཙོ་བླག་མཁན་ནི་དྲི་མ་དག་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ཡང་རྣམ་པར་སྣང་མཛད་ཡིན་ལ་དེ་ནི་སེམས་དག་པ་འབའ་ཞིག་དོན་གྱིས་སྟོང་པ་ཉིད་རྟོགས་པར་བྱེད་པས་ན་སེམས་ཀྱི་དྲི་མ་དག་པར་བྱེད་པའོ།",
    "རྣམ་པར་སྣང་མཛད་སྐུ་ཆེན་པོ།",
    "ཞེས་བྱ་བ་ནི་སྔགས་དང་མཚན་མ་ལ་སོགས་པ་བསྐྱེད་པའི་རིམ་གྱིས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་ཐོབ་པར་གྱུར་པ་དེ་ཉིད་དོ།",
    "བསམ་གཏན་ནི་རྣམ་པར་མི་རྟོག་པའི་བདེ་བ་སྟེ།",
    "ན་ཚོད་ནི་བརྒྱད་པ་ལས་ལོ་གྲངས་བཅུ་གཉིས་པ་ནས་བཟུང་དུ་སྟེ་བཅུ་དྲུག་པའི་བར་དུ་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་སྤྱོར་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་སུ་བསྒོམས་པས་སོ།",
    "དེས་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་དག་དང་།",
    "པདྨ་དང་ཙརྡོ་རྗེ་དག་ཡང་དག་པར་སྦྱོར་བ་བྱས་ནས་དཀྱིལ་འཁོར་ལྔ་ཅན་ཞེས་བྱ་བ་ལ་སོགས་པས་གསུངས་པ་གང་ཡིན་པའི་ལས་དེ་རྣམས་བརྩམ་པར་བྱའོ།",
    "ཤིན་ཏུ་འདའ་དཀའ་བ་ཞེས་བྱ་བ་ནི་ཆོ་ག་འདིས་ངེས་པར་འདི་དག་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེར་སྒྲུབ་པ་ནི་དེ་ཐོབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ས་བཅུ་ལ་ནི་གནས་པར་འགྱུར།",
    "སྒྲུབ་པ་འདིས་མི་གཡོ་བ་ལ་སོགས་པ་རྣམ་པར་སྨིན་པའི་ས་གསུམ་ཐོབ་པའི་ཕྱིར་རོ།",
    "གཙང་སྦྲ་གཙོར་བྱེད་པ་དང་མཚོན་ཆ་གཙོར་བྱེད་པ་དང་།",
    "གསང་བ་ཐོབ་པར་ཊུབྱེད་པ་ནི་རིགས་གསུམ་གྱི་དངོས་གྲུབ་ཐོབ་པར་བྱེད་པའོ།",
    "སྒྲུབ་པ་རྩོམ་པ་དང་དངོས་གྲུབ་ཀྱི་དུས་ནི་རྡོ་རྗེ་ཉི་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ན་ཐུན་བཞིའི་སྦྱོར་བས་ཟླ་བ་ཕྱེད་ཀྱི་ནང་དུ་འགྲུབ་པར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "ཅུང་ཟད་ཀྱང་ནི་བསྐྱོད་པར་བྱ།",
    "ཡིད་ལས་བྱུང་བ་དགག་པར་བྱ།",
    "རྒྱུན་མི་འཆད་པར་སྣང་བ་ཡིན།",
    "གོ་འཕང་མཆོག་ནི་ཐོབ་པར་འགྱུར།་།",
    "སྤྲོས་ན་ནི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཁྱབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "འདིའི་འོག་མའི་ཚིགས་སུ་བཅད་པ་གསུམ་གྱིས་གོ་རིམས་བཞིན་དུ་ལས་ཀྱི་དམ་ཚིག་དང་བཟའ་བའི་དམ་ཚིག་དང་བཅས་པ་ཉིད་ལས་གྲུབ་པོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་སྟོན་པར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་ཁྱབ་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་ཀུན་དུ་སྐྲག་པར་བྱེད་པ་ནི་དགྲ་བོ་སྐྲག་པར་བྱེད་པའོ།",
    "འཇོམས་པ་པོས་སེལ་ཅིང་མེད་པར་བྱེད་པས་ན་ཏྲཱི་སྟེ་གཤིན་རྗེ་མཐར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "སྦྱིན་པ་པོའི་སྤྱི་བོར་གནས་པའི་སྣ་ཚོགས་རྡོ་རྗེ་ལ་རི་རབ་དང་མཉམ་པའི་གཤིན་རྗེ་མཐར་༤བྱེད་སེར་པོ་གཡོན་བརྐྱང་བའི་ཞབས་ཀྱིས་མནན་པར་བསམ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་གཞན་ལ་བྱིན་ནམ་ལེན་པར་བྱེད་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བཀུག་ཅིང་ཁམ་ཕོར་ཁ་སྦྱར་ལ་གནས་པར་བྱའོ།",
    "རྟག་ཏུ་ཞེས་བྱ་བ་ནི་ངེས་པར་རོ།",
    "ཞར་ལ་སྦྱོར་བ་གཞན་ཡང་བསྟན་པའི་ཕྱིར་སྔགས་ཤེས་པ་ཡིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐོ་བ་དེ་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཕབ་ནའོ།",
    "ངེས་པར་རྩང་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་དེ་ངེས་པར་འཆི་བར་འགྱུར་རོ།",
    "གནོད་མཛེས་ལ་སོགས་པའི་སྦྱོར་བས་ཧཱུཾ་ལས་བྱུང་བའི་རྡོ་རྗེ་འབར་བ་ལག་ཏུ་བསམས་ལ་དེ་གདུག་པའི་སྟེང་དུ་བབ་པ་གང་ཡིན་པ་དེ་ཉིད་ཀྱིས་སྤུདེ་འཇིག་པར་བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་བསྣུན་པར་གྱུར་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལ་དོར་བ་གསུངས་པ་འདི་ནི་སྦྱོར་བ་ལ་བསྟོད་པའི་དོན་ཏོ།",
    "ལས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་དོན་ནི་རྡོ་རྗེ་འཆང་ཆེན་པོ་སེར་བའི་སྦྱོར་བ་དང་ལྡན་པས་དཀྱིལ་འཁོར་གྱི་ཁང་པ་དང་།",
    "འདི་ཙམ་ཐམས་ཅད་ཀྱིས་ཀྱང་སྔགས་པའི་མཐུ་བསྟན་པར་འགྱུར་རོ།",
    "དེའི་སྟེང་དུ་ཁས་ཕུབ་སྟེ་ཁ་སྦྱར་བྱས་ལ་རྡོ་ལེབ་ཀྱིས་མནན་ཏེ་བཞག་ན་ཆར་གཅོད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་བདུད་རྩི་ཐབ་སྦྱོར་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་རྡོ་རྗེ་མེ་ལྟར་འབར་བ་འཇིག་པའི་དུས་ལྟར་སྣང་བ་རི་རབ་ཀྱི་ཚད་ཙམ་ཁྲོ་བོའི་ལྟ་བས་བགེགས་ཀྱི་གནས་རྟོགས་པར་བྱེད་པ་ཅན་བརྟན་པོར་བྱས་ནས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་འཆད་པར་འགྱུར་བའི་ཡི་གེ་ཕཊ་དེ་དེ་བརྗོད་པར་བྱའོ།",
    "འཇིག་པར་འགྱུར་ཞེས་བྱ་བ་ནི་སྤྲུལ་པ་རྣམས་སོ།",
    "སྔགས་དེ་ཉིད་ནི་དེ་ལ་ཞེས་བྱ་བ་ལ་བྱེ་སོགས་པ་གསུངས་ཏེ།",
    "ཆོ་ག་དེ་ཉིད་ཁ་བསྐང་བའི་ཕྱིར་ཡེ་ཤེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་ཡེ་ཤེས་སེམས་དཔའ་ནི་རྡོ་རྗེ་སེམས་དཔའོ།",
    "ཇི་ལྟར་ཞེ་ན་ཡེ་ཤེས་སེམས་དཔའི་སྦྱོར་བ་ཡིས་ཏེ་བསྐྱེད་པར་བྱ་བའི་རྡོ་རྗེ་འཛིན་པ་ཡེ་ཤེས་སེམས་དཔའི་རིགས་ལྔས་བསྐོར་བའི་རིགས་ཀྱི་བདག་པོ་མདུན་གྱི་ནམ་མཁའ་ལ་ལྟའོ།",
    "དེའི་རབ་སྦྱོར་ནི་དེ་ཉིད་དབུས་ཀྱི་གདན་ལ་དགོད་པར་བྱའོ།",
    "དེ་ཉིད་གསུངས་པ་ཧཱུཾ་ཞེས་པའོ།",
    "འབྲས་བུ་ནི་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "རྣམ་པར་སྣང་མཛད་འོད་འདྲ་ཞིང་ངོ།",
    "གཞུག་པར་བྱ་ཞེས་བྱ་བ་ནི་པདྨ་ལའོ།",
    "རི་ལུའི་སྒྲུབ་པ་ནི་ལེའུ་བཅུ་གཉིས་པའི་རྗེས་སུ་འབྲངས་སྤུནས་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་འཇམ་དཔལ་ཀྱི་སྦྱོར་བས་མི་སྣང་བར་གསུངས་ནས།",
    "དེ་ལས་གཞན་པའི་སྤྱོར་བས་ཀྱང་གསུངས་པ་ནི་རྡོ་རྗེ་འཛིན་པ་ཞེས་པ་ལ་སོགས་པ་ལ་རྡོ་རྗེ་འཛིན་པ་ཞེས་བྱ་བ་ནི་ལྷ་རྣམས་ཀྱིའོ།",
    "རྡོ་རྗེ་འགྲོ་བར་ཞེས་བྱ་བ་ནི་ཐོགས་པ་མེད་པར་འགྲོ་བའོ།",
    "མི་གཙང་བ་ལ་སོགས་པའི་ཏིང་ངེ་ཟུའཛིན་གྱིས་འདོད་ཆགས་དང་བྲལ་བ་ཡང་ངོ་འདི་ལྟར་སྟོབས་ཆེན་ནི་ཐོགས་པ་མེད་པའི་ནུས་པ་དང་ལྡན་པའོ།",
    "དེ་སྟོན་པར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་དེ་སྐད་ཅེས་བྱའོ།",
    "འཕྲུལ་པ་ནི་རབ་ཏུ་དགྱེས་པར་་ཌ་རྣམ་པར་གཡོ་བའོ།",
    "དོན་དམ་པར་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱས་པར་ནི་ལེའུ་དང་པོ་ལས་འདོད་ཆགས་ཆེན་པོའི་ཚུལ་ཞེས་བྱ་བ་ནས་བརྩམས་ཏེ།",
    "ཞལ་གསུམ་པ་ལྟ་བུར་སྣང་བར་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་དུ་གསུངས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དང་པོར་རིག་མ་དང་བཅས་པའི་མཆོག་དང་པོའི་ཚུལ་གྱིས་རྣལ་འབྱོར་པ་སྟོན་པར་འགྱུར་རོ།",
    "རྡོ་རྗེའི་གསུང་ནི་འཆད་པར་འགྱུར་བའི་གསང་བ་སྟོན་པའོ།",
    "དེ་རྣམས་མཉེས་འགྱུར་ནི་དགྱེས་པར་འགྱུར་བའོ།",
    "དེའི་སྦྱོར་བ་ནི་སྤྱི་བོར་ཡང་དག་པར་སྦྱོར་བའོ།",
    "དེས་ན་འདི་ནི་ངེས་པར་གཟུང་བ་དང་བཅས་པ་ཡིན་ཏེ།",
    "འཁོར་ལོས་སྒྱུར་བ་དྲུག་པོ་མཉེས་པར་བྱེད་པར་རོ།",
    "མཉེས་པར་བྱེད་པ་ནི་ཁྱད་པར་གྱི་ལྐུཚིག་མེད་པའི་ཕྱིར་རོ།",
    "ཁྲོ་བོའི་ནང་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གདོན་མི་ཟ་བའི་ཡེ་ཤེས་ནི་དོན་ཡོད་པར་གྲུབ་པའོ།",
    "ཕྱོགས་གཞན་ནི་སྔགས་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བའི་བར་གྱིས་འཆད་པར་འགྱུར་རོ།",
    "དེ་སྟོན་པར་མཛད་པ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གེཐམས་ཅད་ཀྱིས་གསུངས་ཞེས་བྱ་བར་སྤྱོར་རོ།",
    "ཅི་གསུངས་ཤེ་ན།",
    "ཏིང་ངེ་འཛིན་བརྟན་ཊུཔོས་སྔགས་རྣམས་མཉེས་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་དཀྱིལ་འཁོར་དག་སྟེ།",
    "དེའི་སྒྲུབ་པར་བྱེད་པ་ནི་མཉེས་པར་བྱེད་པ་སྟེ།",
    "དེའི་བཀའ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "སྟོན་པ་ཞེས་བྱ་བ་ནི་དེའི་བཀས་ལྷ་ཐམས་ཅད་སྣོད་ལ་འབེབས་པར་མཛད་པའི་ཕྱིར་རོ།",
    "དེ་འཆད་པར་མཛད་པ་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "བཀའ་སྩལ་པ་ནི་བཀའ་སྤྲུལ་པར་གྱུར་པའོ།",
    "རབ་བྱ་བ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དུ་བྱ་བ་སྟེ།",
    "སྣོད་དང་ལྷ་དག་ཀྱང་ཇི་ལྟར་འཆད་པར་འགྱུར་བ་བཞིན་དུ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཇི་སྐད་དུ་གསུངས་པ་དེ་བཞིན་དུ་མཛད་པའོ།",
    "དབབ་པའི་ཆོ་ག་ཐམས་ཅད་ནི་བྱས་ན་ཞེས་བྱ་བ་ནི་དེ་ནས་དབབ་པར་བྱ་བའི་ལྷ་གནོད་མཛེས་ཀྱིས་བཀུག་ལ་སྣོད་ཀྱི་ལུས་ལ་བཅུག་སྟེ།",
    "རིགས་གསུམ་གྱི་འོད་ཟེར་དམར་པོས་ལུས་ཐམས་ཅད་ལ་འགེངས་པར་གྱུར་པར་རྣམ་པར་བསམས་ལ་བདུག་སྤོས་གཏུལ་ཏེ།",
    "གདོན་མི་ཟ་བར་གྲུབ་ཙུཉེཅེས་བྱ་བ་ནི་ངེས་པར་བབས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་དེ་ལྟར་བྱས་ན་རྟག་པར་གྲུབ་སྟེ་གསུངས་པའི་ཆོ་གས་ངེས་པར་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྔོན་དུ་བྱ་བ་བསྟན་པའི་ཕྱིར་ཆོ་ག་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "ཐམས་ཅད་བྱས་ན་ནི་ཞེས་བྱ་བ་ནི་སེམས་བརྟན་སྤྱོཔར་བྱ་བ་དང་ལྷག་པར་གནས་པ་ལ་སོགས་པའོ།",
    "དབེེས་པར་འགྱུར་ཞེས་བྱ་བ་ནི་བཞད་གད་ཉིད་དུ་འགྱུར་བའོ།",
    "དྲན་པ་ཞེས་བྱ་བ་ནི་བློ་ལ་གནས་པར་སྨྲ་བར་འགྱུར་བ་སྟེ།",
    "གསུམ་ཊུཆར་ཡང་སྟོན་པར་བྱེད་ཅེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "གསང་བ་ཡིན་པར་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ལས་ཀྱི་ངོ་བོ་ཉིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "སྣོད་ཇི་ལྟ་བ་བཞིན་དུ་འོད་དཔག་ཏུ་མེད་པར་བྱས་ནས་ཆོ་ག་གསུངས་པ་དེ་བཞིན་དུ་ཡི་གེ་ཧ་ལས་རྣམ་པར་སྣང་མཛད་དམར་པོའམ།",
    "ཡི་གེ་ཧཱུཾ་ལས་མི་བསྐྱོད་པ་དམར་པོར་ཕྱེབྱས་ནས་ཞེས་ཤེས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོརྐ།",
    "དེའི་སྟེང་དུ་རྣམ་པར་སྣང་མཛད་སེར་པོ་བསྒོམས་ན་ངེས་པར་ལྡོག་པར་འགྱུར་རོ།",
    "སླར་ཡང་གཤེགས་པར་མཛད་དུ་གསོལ།",
    "མངོན་སྤྱོད་བྱ་བའི་ཕྱིར་བདུད་རྩི་ཐབ་སྦྱོར་གྱི་རྟོག་པ་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྒྱལ་པོ་ནི་མ་རུངས་པ་རྣམས་ཚར་གཅོད་པར་བྱེད་པ་དེ་བས་ནའོ།",
    "ཅི་གནོད་སྦྱིན་རྣམས་ཀྱི་རྒྱལ་པོ་ཡིན་ནམ་ཞེ་ན་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ཀུན་གྱི་བདག་གོ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཕན་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དེས་ཀྱང་གདུག་པ་ཐམས་ཅད་རྣམ་པར་གཞིག་པའི་ལས་འདི་དག་བྱེད་པ་ཡིན་ན།",
    "སྦྱོར་བ་གཞན་གྱིས་བྱས་ན་འགྲུབ་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕུབ་སོགས་ལས་ཞེས་བྱ་བ་ལ་ཞུསོགས་པའི་སྒྲས་ནི་བསྒྲུབ་པར་བྱ་བའི་རྐང་རྗེས་ཀྱི་ས་ལ་སོགས་པ་སྟེ་ལྷག་མ་ནི་དབྱིག་སྔོན་ཀྱི་སྔགས་དང་འདྲའོ།",
    "བྱས་པ་ལ་ཞེས་བྱ་བ་ལ་སྦྱིན་སྲེག་ཅེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "ད་དུ་རའི་ཀའི་ཁྱད་པར་ནི་རིམ་གསུམ་པ་སྔོན་པོ་ཅན་ནོ།",
    "རོ་བསྲེགས་པའི་མེ་བསླངས་པས་བསྲེག་ཞུཔའི་མྱོས་པར་བྱེད་པའི་སོལ་བའོ།",
    "ལྷག་མ་ནི་གཞན་ཀྱིས་མི་ཐུབ་པའི་སྔགས་ཀྱི་སྐབས་སུ་གསུངས་པ་ནི་སྲིན་པོ་ལ་སོགས་པ་འཛིན་པ་དང་འདྲའོ།",
    "ལིངྒ་ནི་བསྒྲུབ་པར་བྱ་བའི་གཟུགས་བརྙན་ནོ།",
    "དེ་བྱ་བའི་ཕྱེད་ཀྱི་རྫས་ནི་རུས་ཕྱེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།་",
    "ཁྱད་པར་ཕྱེའགྱུར་ཞེས་བྱ་བ་སྲིན་པོ་རྣམས་ཀྱིས་སོ།",
    "བྱས་པའི་བསྒྲུབ་པར་བྱ་བའི་གཟུགས་བརྙན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཚ་བ་ཆེན་པོས་བཏབ་པར་འགྱུར།",
    "མཚན་མའི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ནུབ་པར་བྱ་བའི་ཕྱིར།",
    "ཡང་ན་བསམ་གཏན་དག་ནི་འཆད་པར་འགྱུར་བའོ།",
    "བསམ་གཏན་དེ་ཉིད་ནི་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསད་པར་ནི་ཞེས་བྱ་བ་ནི་ནམ་མཁའི་དབྱིངས་ཀྱི་ཡུལ་ཅན་ལ་ཉེ་བར་བཏགས་པའི་ཕྱིར་རོ།",
    "དེ་ཡིས་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཡིས་ཏེ།",
    "ཁྱད་པར་ཅན་དུ་གྱུར་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གནོད་པར་བྱེད་པ་རྣམས་འཇིགས་པ་གང་ཡིན་པ་དེ་རྣམས་ངེས་པར་འབེེབས་པའི་མཆོག་སྟེ་ཤིན་ཏུའོ།",
    "ཐོ་བ་ཞེས་བྱ་ནི་གཡས་ཀྱི་གསུམ་པར་གཞག་ཙུཔའོ།",
    "ཨོཾ་གྷ་གྷ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་བརྗོད་ཅིང་བསྣུན་པར་བྱའོ།",
    "རྡོ་རྗེ་ཕུང་པོས་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལའོ།",
    "བསད་བདག་ཉིད་གཏོགས་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའི་ཉེས་པ་བསྒྲགས་པ་དང་།",
    "དེ་ལ་ཁྲོས་ནས་ཁྲོ་བོའི་གཟུགས་སུ་བྱས་ཏེ།",
    "རྡོ་རྗེ་ཆེན་པོའི་དམ་ཚིག་ནི་ཇི་སྐད་དུ་གསུངས་པའི་བསམ་གཏན་ནོ།",
    "དེ་སྟོན་པར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་བཅོམ་ལྡན་འདས་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་སྟོན་པར་མཛད་པ་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "ཨེ་མའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མ་སྐྱེས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འགུལ་པར་གདོན་མི་ཟ་ཞེས་བྱ་བ་ནི་ཡི་གེ་ཁཾ་ཉིད་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ལ་འཛིན་པའི་ཕྱིར་བསྐུལ་ན་གནས་ལས་འགྲོ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡིས་ཞེས་བྱ་བ་ནི་སྦྲུལ་གྱི་ཁར་བསྒོམས་པའི་ཡི་གེ་ཇུའི་འོད་ཟེར་གྱི་ལྕགས་ཀྱུས་སྦྲུལ་གྱི་ཁར་འབབ་པར་འགྱུར་བའོ།",
    "ཡེ་ཤེས་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་དཀར་པོའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེ་བཞིན་དུ་བུ་རམ་གྱི་ཁམ་ཕོར་ལ་སོགས་པར་བྱའོ།",
    "དེ་སྟོན་པར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ནས་དེའི་འོད་ཟེར་དཀར་པོ་བསེལ་བའི་ཚོགས་ཀྱིས་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཁྱབ་པར་བྱས་ལ།",
    "དཔྲལ་བ་དང་མགོ་བོར་བསྡུས་ལ་ལངས་པར་ཞེས་བྱ་བ་ལན་གཉིས་ལན་གསུམ་བསམ་ཏཱུཔར་བྱའོ།",
    "དེའི་ཡོན་ཏན་ནི་ཁྱད་པར་ཅན་ནོ།",
    "དེ་ཐོབ་པར་འགྱུར་བ་ནི་དེའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "སྔགས་དེ་རྣམས་ཀྱི་འབྲས་བུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་གཟུགས་སོ།",
    "དེ་བྱུང་སྤུབ་དག་ཏུ་རྣམ་པར་བསམ་པ་ནི་རྣམ་པར་བརྟག་པར་བྱའོ།",
    "ཡང་ན་ཞེས་བྱ་བ་གསུངས་པའི་ཕྱིར་གནག་ཅིང་མི་སྡུག་པ་གཅེར་བུ་རྔོ་ཡི་དྭགས་ཀྱི་གཟུགས་སུ་ཡོངས་སུ་གྱུར་པའང་རུང་།",
    "འཁོར་ལོའམ་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་ཏུའོ།",
    "བསྒོམས་ནས་ཞེས་བྱ་བ་ནི་འབར་བ་རྣམ་པར་བསམས་ནས་སོ།",
    "སྐུ་ལ་སོགས་པར་ཞུགས་ནས་གནས་པ་དག་གོ།",
    "རྡོ་རྗེ་རྣམས་ཀྱི་རྒྱལ་པོ་ནི་རྡོ་རྗེ་སེམས་དཔའ་སྟེ་དེའི་སྤྲིན་བསམ་པར་བྱའོ།",
    "ཁྲོས་པར་ཞེས་བྱ་བ་ལ་ནིའི་སྒྲས་ནི་བསྣུན་པར་ནིའོ།",
    "མཐོང་ནས་ཀྱང་སྔོན་དུ་བསྙེན་པ་ལ་འཇུག་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་བསྟན་པའི་སྐབས་དབྱེ་བའི་སྤུཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འདྲེན་པར་མཛད་པས་ན་ཡེ་ཤེས་ཀྱི་དུཀྱོ་བ་ཡང་དེ་ཡིན་ལ།",
    "དེ་དེ་མ་ཐག་ཏུ་སྟོན་པར་མཛད་པ་ཉིད་ཀྱི་ཕྱིར་བཅོམ་ལྡན་འདས་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "འོན་ཀྱང་འཁྲུལ་པའི་རྡོ་རྗེ་རབ་ཏུ་གསུངས་ཏེ།",
    "བག་ཆགས་བརྟན་པོས་ཤིན་ཏུ་བརྟན་པར་གྱུར་པ་ནི་འཁྲུལ་པའི་རྡོ་རྗེ་ཡིན་ལ།་",
    "དེ་ལ་བརྩོན་པ་ནི་སེམས་བརྟན་པར་གྱུར་པ་ཅན་ནོ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ་ནི་རྣམ་པར་དག་པའི་མཐར་ཐུག་པའོ།",
    "ཉེ་བར་གནས་པའམ་སྒོགང་ན་གནས་པར་མཐོང་ནའོ།",
    "དེ་ལ་གནས་པ་ནི་སེམས་བརྟན་པར་གྱུར་པའོ།",
    "ཡང་གསུངས་པ་ཞེས་བྱ་བ་ནི་ཀྱེདངོས་གྲུབ་དམན་པའི་མཚན་མའི་ཚིགས་སུ་བཅད་པ་འོག་མ་གཉིས་སོ།",
    "བརྟག་བུ་པའི་བློས་མཐོང་བར་གྱུར་པ་དེའི་ཚེ་ཐུགས་ཀྱི་གསང་བ་འགྲུབ་པར་འགྱུར་རོ།",
    "རྨི་ལམ་བརྟག་པར་བྱ་བ་ཡིན་པ་དེའི་ཕྱིར།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་དེ་ལ་ཞེས་བྱ་བ་ནི་རྨི་ལམ་གྱི་མཚན་མ་དེ་མཐོང་བ་ཡོད་ནའོ།",
    "འདི་ནི་ཞེས་པ་་དའཆད་པར་འགྱུར་བའི་ཚིགས་སུ་བཅད་པའི་དོན་གྱི་ཚུལ་ལོ།",
    "དེ་ཉིད་ནི་རང་སེམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱི་དམ་ཚིག་ནི་དུ་ཡང་དག་པའི་དེ་ཁོ་ན་ཉིད་དང་ཡང་དག་པར་རྟོགས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་བཞིན་མེད་པར་མ་གྲུབ་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "རང་ཉིད་ལ་བྱེད་པ་འགལ་བའི་ཕྱིར་རལ་གྲིའི་སོ་རྣོན་པོས་ཀྱང་རལ་གྲིའི་སོ་རྣོན་པོ་དེ་ཉིད་གཅོད་པར་མི་བྱེད་པ་ལྟ་བུའོ།",
    "ནམ་མཁའ་ནི་འདི་སྙམ་དུ་ཡང་མི་སེམས་སོ་ཞེས་བྱ་བ་ནི་ནམ་མཁའ་ལ་༢རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "འགྲོ་ཞིང་རྒྱུན་མི་འཆད་པར་མཐོང་བ་ནི་རྗེས་སུ་ལྟ་བའོ།",
    "དེ་ལས་བྱུང་བ་ནི་དེར་རོ་གཅིག་པར་གྱུར་པས་སྣང་བར་ཤེས་པར་བྱའོ།",
    "ཡིད་ལ་མི་བྱེད་པས་ཡོངས་སུ་སྤོང་ཞིང་དེ་རྣམས་ནུབ་པས་ཡང་དག་པ་ལ་སོ་སོར་རྟོག་པའི་སྟོབས་བསྐྱེད་པའི་ཕྱིར་ལྷུན་གྱིས་གྲུབ་པའི་ནམ་མཁའི་རྡོ་རྗེ་ཤིན་ཏུ་འཁྲུལ་པ་མེད་པར་སྐྱེད་པའི་༤ཕྱིར་རོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "དེ་བས་ན་སེམས་ལ་དམིགས་པ་ལ་སྣ་ཚོགས་པར་སྣང་ཞིང་ནམ་མཁའ་རྡོ་རྗེ་ལ་ནི་རོ་གཅིག་པ་ཡིན་པ་དེ་ལྟར་ན་འདི་འགལ་བ་ཅི་ཞིག་ཡོད།",
    "དགོངས་པ་ངེས་པར་འགྲེལ་པ་ལས་ཀྱང་བྱམས་པས་གསོལ་པ།",
    "བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛིན་གྱི་སྤྱོད་ཡུལ་གྱི་གཟུགས་བརྙན་གལ་ཏེ་སེམས་དེ་ལས་ཐ་དད་པ་མ་ལགས་ན།",
    "སེམས་དེ་ཉིད་ཀྱིས་སེམས་དེ་ཉིད་ལ་ཇི་ལྟར་རྟོགས་པར་བགྱིད་ལགས།",
    "འོན་ཀྱང་དེ་ལྟར་སྐྱེས་པའི་སེམས་གང་ཡིན་པ་དེ་དེ་ལྟར་སྣང་ངོ་ཞེས་གསུངས་པ་དང་།",
    "དེ་ཉིད་ཀྱིས་དེ་ཡང་དག་པར་རིག་པ་འགྲུབ་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་བུམ་པར་སྣང་བས་དབེན་པ་མཐོང་བས་ས་ཕྱོགས་སུ་༧བུམ་པས་སྟོང་པ་ཉིད་དུ་འགྲུབ་ཀྱིས་གཞན་གྱིས་ནི་མ་ཡིན་པ་ལྟ་བུའོ།",
    "འོ་ན་ཇི་ལྟར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་འདི་རྣམ་པ་མེད་པ་ཞེས་བྱ་ཞེ་ན།",
    "འདིར་ཛྭནི་གཟུང་བ་མེད་པར་སྟོན་པར་བྱེད་དོ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་ནི་ཡོད་པ་མ་ནཡིན་ནོ་ཞེས་མ་གྲགས་པ་དེ་འདིས་ཙུདངོས་སུ་བརྗོད་པར་བྱའོ།",
    "གཅིག་དང་དུ་མའི་རང་བཞིན་དང་བྲལ་བའི་གཟུགས་ཀྱི་ཕུང་པོ་དང་སྐྱེ་མཆེད་བཅུ་དང་ཁམས་བཅུ་པོ་དོན་དམ་པར་ཡོད་པ་ཉིད་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྟོང་པ་ཉིད་དུ་གསུངས་པ་གང་ཡིན་པ་དེ་འདི་ལྟ་སྟེ།",
    "དེ་ལྟར་ནི་རྣམ་པར་ཤེས་པར་བྱེད་པས་ན་རྣམ་པར་ཤེས་ཉུ་པ་སྟེ།",
    "དོན་དེ་ཉིད་ཀྱི་ཁྱད་པར་འཛིན་པའི་སེམས་ལས་བྱུང་བའི་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་དག་ཡིན་ནོ།",
    "གསལ་བའི་མཚད་ཉིད་ཅན་གྱི་སེམས་འདི་ཉིད་ནི་ཐོག་མ་མེད་པ་ཐུནས་གཉིས་སུ་རྟོག་པའི་བག་ཆགས་ཀྱིས་བསླད་པའི་ཕྱིར་གཉིས་མེད་ཀྱང་གཉིས་ཀྱི་རྣམ་པར་བྱུང་བ་ཡིན་ཏེ།",
    "ཁྱད་པར་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱད་པར་ཉིད་ཀྱིས་ཡོངས་སུ་གྲུབ་པ་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དཔེར་ན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྟག་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་བརྟན་པར་ནུས་པ་མ་ཡིན་ལ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བྱེད་པ་ནི་ཐོབ་པར་བྱེད་པ་སྟེ།",
    "ལུས་དང་གནས་དང་ལོངས་སྤྱོད་དུ་སྣང་བའི་རྣམ་པར་རྟོག་པ་རྣམས་ནུབ་པའི་ཕྱིར་ནམ་མཁའ་དང་མཉམ་པ་སྟེ།",
    "དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་༤ལ།",
    "ཁམས་གསུམ་དུ་རྨི་ལམ་ཞེས་བྱ་བ་ནི་ཁམས་གསུམ་གྱི་རྣམ་པར་རྟོག་པ་དང་འགྲོ་བ་ལ་སོགས་པའི་ལས་རྨི་ལམ་དུ་མཐོང་བའོ།",
    "དེ་རྣམས་ཀྱང་ཞེས་བྱ་བ་ནི་རྨི་ལམ་དུ་སྟོན་པའི་རྣམ་པར་རྟོག་པ་ལ་སོགས་པའི་ཕྱིར་རོ་༦།",
    "གཟུང་བ་དང་འཛིན་པར་ཧཱུཾ་སྣང་བ་དག་ནི་བརྫུན་པ་ཉིད་ཀྱིས་ན་དེར་སྣང་བ་དག་ནི་རོ་གཅིག་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དང་པོའི་སྐབས་དབྱེ་བའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དགག་པར་བྱ་བའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྒྲུབ་པ་པོས་ཐོབ་པར་བྱ་བའི་དངོས་གྲུབ་རྣམས་ལྷ་རྣམས་ཀྱི་སྒུ་གསུམ་ལ་མི་གནས་པ་ཉིད་ཡིན་ནོ།",
    "འོན་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་སེམས་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་དེ་ཞེས་བྱ་བ་ནི་༡དེ་དག་ལ་སྟེ།",
    "འདི་ཙམ་གྱིས་ནི་སྔ་མ་བཞིན་དུ་སེམས་ལ་དམིགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "སྟོང་པ་ཉིད་ནི་དེ་ཁོ་ན་ཉིད་ཀྱི་མཆོག་ཡིན་ཀྱི་རྣམ་པར་རིག་པ་ཙམ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དེ་ནས་ལྷའི་སྐུ་ལ་སོགས་པར་དེ་ཉིད་སྣང་བའི་ཕྱིར་རོ།",
    "དོན་དེ་ཉིད་ཀྱི་ཕྱིར་འདི་ལྟར་ལེའུ་འདི་ནི་བསྙེན་པའི་ལེའུ་ཞེས་དངོས་ཀྱི་མིང་ཡིན་པར་རིགས་ཀྱི་བསྒྲུབ་པ་དང་པོ་བསྟན་པས་གཙོ་བོར་གྱུར་པས་ནི་མ་ཡིན་ནོ།",
    "སྡོམ་པ་རྣམས་བསྟན་པར་བྱའོ།",
    "དང་པོ་བྲི་བའི་དཀྱིལ་འཁོར་གྱི་སྐབས་དབྱེ་བའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "༢ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དགའ་བ་རྒྱས་པར་བྱེད་པས་ན་རིན་ཆེན་ནོ།",
    "དེའི་སོ་སོར་སྤྲོས་པ་དེ་སོ་སོའི་མཚན་མའི་རྣམ་པར་བསྙུས་པས་ནི་ཇི་ལྟ་བ་བཞིན་དུ་བཀོད་པ་ནི་བཀོད་པའོ།",
    "རྣམ་པར་སྣང་མཛད་ཡིན་ལ།",
    "དཔལ་མཆོག་དང་པོ་ལ་སོགས་པའི་རྒྱུད་གཞན་དག་ལས་སྤྱིར་གསུངས་པའི་བྱ་བ་འགལ་བ་མེད་པ་ཅན་འདིར་ཡང་བྱ་བ་ཉིད་ཡིན་པའི་ཕྱིར་ཆོ་གའོ།",
    "གསང་བ་འདུས་པ་ཁྱད་པར་དུ་གསུངས་པ་ནི་འགལ་བ་ཉིད་ཡིན་པའི་ཕྱིར་རྡོ་རྗེ་སྟེ།",
    "དེ་མ་ལུས་པར་ཡང་དཀྱིལ་འཁོར་གྱི་ཆོ་གར་བལྟ་བར་བྱའོ།",
    "སྔགས་རྣམས་ཀྱི་དེ་ཁོ་ན་ཉིད་དགོད་པར་བྱའོ།",
    "གསང་བ་ནི་བསྟན་པར་བྱ་བ་མ་ཡིན་པ་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་གནས་ནི་འོད་ཟེར་དང་བཅས་པའི་འཁོར་ལོའོ།",
    "ལྷག་མ་རྣམས་ནི་སྔ་མའི་རྗེས་སུ་འབྲངས་ནས་ཤེས་པར་བྱའོ།",
    "དེའི་ཡོན་ཏན་དེ་རྣམས་སྐྱེད་པར་མཛད་པ་སྟེ།",
    "དབབ་པར་བྱ་ཞེས་བྱ་བ་ནི་དཀྱིལ་འཁོར་སར་པ་བྲི་བར་བྱའོ།",
    "དེ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ལེའུ་བཞི་པ་ལས་གསུངས་པ་གང་ཡིན་པ་དེ་ཉིད་དུའོ།",
    "དེ་བཞིན་གཤེགས་པའི་གསང་བ་གསུམ་ལས་སྐྱེས་ཤིང་གསུམ་གྱིས་༢ཡང་དག་པར་བསྡུས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྲོ་བོ་ལ་སོགས་པའི་དབྱེ་བས་སྣ་ཚོགས་པར་སྟོན་པ་ཡིན་པ་ལ་འདིར་ཐེ་ཚོམ་མི་བྱའོ།",
    "དེའི་སྲས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་ཀྱེགསུངས།",
    "དེའི་སྔགས་ནི་དེ་ཤེས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གནས་ནི་རྗོད་ཅིཔར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་རྡོ་རྗེའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔོན་དུ་བསྙེན་པས་བརྟན་༥པར་བྱས་པའི་སེམས་ནི་སེམས་དཔའོ།",
    "ཚུལ་ནི་༡ལེའུ་བཅོ་ལྔ་པ་ལས་གསུངས་པའི་ལྷ་དབབ་པ་ལ་སོགས་པའི་ཆོ་གའོ།",
    "གཞུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་རྣམས་གོ་རིམས་ཀེབཞིན་དུ་ལྷ་དབབ་པར་བྱ་བ་གཉིས་པོ་གོ་རིམས་ཀྱེགང་དང་གང་ཡིན་པ་དེ་ནི་རྒྱལ་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྐྱ་གསུངས་སོ།",
    "སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་མུ་དབབ་པ་བྱས་པས་ཅིར་འགྱུར་ཞེ་ན།",
    "དེ་ལྟར་བྱས་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀྱང་གསུངས་སོ་ཞེས་བྱ་བ་ནི་ལྷ་བཤོས་རྣམས་སོ།",
    "ཚིགས་སུ་བཅད་པ་༧ནི་ལྔ་པའི་ཁྱད་པར་གསུངས་པ་ཡིན་ནོ།",
    "དེས་དེ་ལྟར་སྒྲུབ་པའི་དཀྱིལ་འཁོར་ཇི་ལྟར་བྲི་བ་དེ་བཞིན་དུ་གསུངས་པ་ཡིན་ནོ།",
    "དོན་ཡོད་པར་གྲུབ་པའི་དཀྱིལ་འཁོར་ཀྱི་དོན་དུ་ནི་དཀར་པོ་དང་སེར་པོ་དང་དམར་པོ་དང་ནག་པོ་དང་ལྗང་གུ་རིམ་བཞིན་དུ་བཞག་ལ།",
    "དེ་བཞིན་གཤེགས་པ་ལྔའི་རང་བཞིན་ཅན་འབར་བའི་སྲད་ཚོབུ་དེ་བསམ་པར་བྱའོ།",
    "རྡུལ་ཚོན་ཁ་དོག་ལྔ་པ་སྣོད་སོ་སོར་བཞག་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ས་བོན་གྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་ཁ་དོག་མཐུན་པའི་རང་བཞིན་ཅན་དུ་བྱས་ནས་འབར་བའི་ལྟ་བས་སྦྱར་ཏེ།",
    "༧ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་ཆེན་པོ་གསུངས་ནས།",
    "བསྦུས་པའི་དཀྱིལ་འཁོར་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཉུ་ལ་སྔགས་རྣམས་ཞེས་བྱ་བ་ནི་ལྷ་རྣམས་སོ།",
    "རྡོ་རྗེ་ནི་རྡོ་རྗེས་མཁྲེགས་པར་གྱུར་པ་སྟེ་ཅི་རིགས་པར་བསྙུས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡི་གེ་ཧཱུཾ་དུ་བརྟག་༤པ་དང་སྐུ་ལ་སོགས་པ་ཞི་བརྟག་པར་བྱ་བའི་དོན་ཏོ།",
    "སྐུ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "དམ་ཚིག་ནི་དོན་ཡོད་པར་གྲུབ་པའོ།",
    "དེ་ལྟར་དུ་བྱས་ན་ནི་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་གསུངས་པའི་༨ཆོ་གས་བྲི་བར་བྱས་ནའོ།",
    "དེ་ལྟར་བྱས་པས་བྱིན་ཀྱིས་རློབ་པར་བྱེད་ཅེས་ཟེར་རོ།",
    "བུམ་པའི་དགོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་རྡོ་རྗེ་བུམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "ཅི་ཞིག་བརྟག་༢པར་བྱ་ཞེ་ན།",
    "ཀྱང་གསུངས་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་ཚིགས་སུ་བཅད་པའོ།",
    "ཞེས་བྱ་བ་ནི་མེ་ལ་བཞུགས་༢པའི་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་སྙོམས་པར་འཇུག་པ་ཉིད་དུ་བསམ་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཡི་གེ་ཨོཾ་ལས་རྣམ་པར་སྣང་མཛད་དུ་བྱས་པའོ།",
    "སྐུའི་དཀྱིལ་འཁོར་དུ་གཞུག་པར་བྱའོ་ཞེས་པ་ནི་ལྷག་མའོ་༥།",
    "རྡོ་རྗེས་གཟུང་བར་བྱ་ཞེས་བྱ་བ་གསུངས་ཏེ་༧།",
    "རྒྱལ་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "དེ་བས་ན་འདི་ཉིད་བརྗོད་པས་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པ་དང་འཇུག་པར་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ཀྱི་བསྟན་པ་ནི་དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།"
  ]
}