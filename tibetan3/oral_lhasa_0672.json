    "ཁ་ཅིག་ནི་ཚད་ཤེས་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "ཁ་ཅིག་ནི་དངོས་པོ་གཅིག་ཏུ་ཤེས་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "ཁ་ཅིག་ནི་ཉིད་ལ་ལྔ་ནས་སོ་སོ་ཡང་དག་པར་རིག་པར་གྱུར་པའི་དོན་གསུང་བ་ཉིད་དུ་ཡང་དག་པར་བསྟན་པའི་ཕྱིར་ཏེ།",
    "དེ་ན་འཁོད་པ་རྣམས་སྐོམ་པར་བྱ་བའི་ཕྱིར་དང་།",
    "ཉིད་དེ་ལ་ཆགས་པ་མི་མངའ་བར་ཡང་དག་པར་བསྟན་པའི་ཕྱིར་དང་།",
    "མི་དང་མི་མ་ཡིན་པས་བྱས་པས་གཞན་གྱི་ལུས་དང་སེམས་ལ་གནོད་པ་བྱེད་པའི་ཕྱིར་དང་།",
    "བཅོམ་ལྡན་འདས་ཟླ་བ་ཕྱེད་དང་གསུམ་ནང་དུ་ཡང་དག་པར་འཇོག་པར་མཛད་པ་ནི་ཉན་ཐོས་རྣམས་སྐོམ་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "དེས་ན་བསྟན་པར་མི་བྱ་བར།",
    "མཁྱེན་ཅིང་སྐོམ་པར་བྱ་བའི་ཕྱིར།",
    "ཅེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཤེས་དང་བྱས་གཟོ་ཡོན་གནས་དང་།",
    "དེ་ནི་ཅི་རིགས་པར་རིག་པར་བྱའོ།",
    "ལེའུར་བྱས་པ་དང་པོའོ།",
    "དེ་ནི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་ཉིད་ཀྱིས་རྣམ་པ་གཉིས་ཀ་ཡང་ཡིན་པར་བསྟན་ཏོ།",
    "དེ་ལྟར་ན་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་ཀྱིས་གཤེགས་པ་ཡིན་པར་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་རིག་པ་རྗོགསུམ་ཚོགས་དང་བཅས་པ་རྣམས་ཀྱིས་སྟོན་པ་ཉིད་པྱཕུན་སུམ་ཚོགས་པ་མཉེས་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཇི་ཙམ་དུ་གཤེགས་པར་བྱ་བར་ཏེ།",
    "དེ་ལས་གཞན་པ་དགྲ་བཅོམ་པ་དག་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་རོ།",
    "དེས་ན་འཇིག་རྟེན་མཁྱེན་པ་ཞེས་བྱའོ།",
    "ལྷ་དང་མི་རྣམས་ཀྱི་༤སྟེསྟོན་པ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཞེས་གསུངས་པ་དེ་གང་ཡིན་ཞེ་ན།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་བའི་ཁྱད་པར་སྟོན་པར་མཛད་དེ།",
    "དེ་ལ་རྣམ་པར་གྲོལ་བའི་ཁྱད་པར་ནི་ལྷ་དང་མིའི་གཙོ་བོ་དང་།",
    "གཙོ་བོ་མ་ཡིན་པ་རྣམས་ལ་རྗོརྣམ་པར་གྲོལ་བ་ལ་སོགས་པས་སྟོན་ཏེ།",
    "རབ་ཏུ་རྣམ་པར་གྲོལ་བ་དག་ཀྱང་མ་ཡིན་ཏེ།",
    "སླར་འོང་རྗོབའི་ཕྱིར་ལ་སླར་འོང་བ་དང་བྲལ་བར་འགྲོ་བ་ནི་རབ་ཏུ་སྣེརྣམ་པར་གྲོལ་བ་དག་ཡིན་པས་སོ།",
    "སྐྱེ་བོའི་བཙོན་ར་ནས་རབ་ཏུ་རྣམ་པར་མ་གྲོལ་བ་ཡང་ཡིན་ཏེ།",
    "དེ་དག་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་ཉིད་ཀྱི་ཛེེརྣམ་པར་གྲོལ་བ་རྣམ་པ་བཞི་སྟོན་པར་མཛད་དོ།",
    "སྡུག་བསྔལ་ལས་ཀྱང་རབ་ཏུ་རྣམ་པར་མ་གྲོལ་བ་དག་ཡིན་ཏེ།",
    "དེ་དག་ལས་ཀྱང་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་སྔ་མ་བཞིན་ནོ།",
    "རབ་ཏུ་རྣམ་པར་མ་གྲོལ་བ་དག་ཀྱང་ཡིན་ཏེ།",
    "དེ་དག་ལས་ཀྱང་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་སྔ་མ་བཞིན་ནོ།",
    "ཐུགས་སུ་ཆུད་པས་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཞི་བར་མཛད་པ་ནི་ཞི་བའི་སྙེམས་པར་འཇུག་པའི་བདེ་བར་གནས་པ་ལ་རབ་ཏུ་འཇོག་པར་མཛད་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཞི་བ་མཆོག་དང་ལྡན་པ་ཞེས་གསུངས་སོ།",
    "དབུགས་འབྱིན་པར་མཛད་པ་ནི་ངན་འགྲོ་ལས་ཡང་དག་པར་འདས་པ་ལ་རབ་ཏུ་འཇོག་པར་མཛད་པའི་ཕྱིར་རོ་རྗོ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདས་པར་མཛད་པ་ནི་ཡང་སྲིད་པ་ལས་ཡང་དག་པར་འདས་པ་ལ་རབ་ཏུ་འཇོག་པར་མཛད་པའི་ཕྱིར་རོ།",
    "སྦྱོར་བ་དང་བཅས་པར་བཟུང་བའི་ཕྱིར་རོ།",
    "ཞི་བར་མཛད་པ་ནི་ཏིང་ངེ་འཛིན་རྣམ་པར་དག་པ་ལ་རབ་ཏུ་འཇོག་པར་མཛད་པའི་ཕྱིར་རོ།",
    "དབུགས་འབྱིན་པར་མཛད་པ་ནི།",
    "ཤེས་རབ་རྣམ་པར་དག་པས་དབུགས་འབྱིན་པ་དང་།",
    "དབུགས་མཆོག་ཏུ་ཕྱིན་པ་གཉིས་ལ་རབ་ཏུ་འཇོག་པར་མཛད་པའི་ཕྱིར་རོ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདས་པར་མཛད་པ་ནི་དེ་ཉིད་ཀྱིས་བསེལ་བར་གྱུར་པ་དང་།",
    "མཆོག་ཏུ་བསེལ་བར་གྱུར་པ་གཉིས་ལ་རབ་ཏུ་འཇོག་པར་མཛད་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "དེ་ལ་ལམ་མཁྱེན་པ་ལམ་ཐུགས་སུ་ཆུད་པ་ནི་ལམ་དང་།",
    "ལམ་མ་ཡིན་པ་གཉིས་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ལམ་སྟོན་པ་ལམ་གསུང་བ་ནི་ལམ་དང་ལམ་མ་ཡིན་པ་གཉིས་ཡང་དག་པར་རབ་ཏུ་སྟོན་པའི་ཕྱིར་རོ།",
    "ཡང་དག་པར་རབ་ཏུ་སྟོན་པའི་ཕྱིར་ཏེ།",
    "ལམ་ཡོངས་སུ་འདྲེན་པ་ནི་ལམ་མཐོང་བ་རྣམས་ལམ་བྱུ་གོང་ནས་གོང་དུ་ཁྱད་པར་དུ་འགྲོ་བས་ལམ་གྱི་མཐར་ཐུག་པར་འདྲེན་པའི་ཕྱིར་རོ།",
    "བསམ་པ་ཡོངས་སུ་སྨིན་པ་རྣམས་ལ་ལམ་སྟོན་པར་མཛད་པས་ན་ལམ་སྟོན་པའོ།",
    "ལམ་ཡོངས་སུ་འདྲེན་པ་ནི་བསམ་པ་ཡོངས་སུ་མ་མིན་པ་རྣམས་ལ་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཤེས་རབ་ཡོངས་སུ་སྨིན་པར་མཛད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཕྱིན་ཅི་མ་ལོག་པར་ཡང་དག་པར་གསུངས་པའི་ཕྱིར་ལེགས་པར་གསུངས་པའོ།",
    "དོན་མཐོང་བའི་ཕྱིར་ཡང་དག་པར་མཐོང་བ་ཡིན་གྱི་དད་པ་ཙམ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཇི་སྐད་དུ་ངའི་ཉན་ཐོས་ཀྱི་དགེ་སློང་རྒྱཚུར་ཤོག་ཤིག་དང་ཞེས་བྱ་བ་རྒྱས་པར་གསུངས་པ་ལྟ་བུའོ།",
    "ལྷག་མ་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱ།",
    "ལུང་ལས་ནི་ལེགས་པར་གསུངས་པ་ཞེས་བྱ་བ་ནི་བསྟན་པ་ཡིན་ལ།",
    "དེ་ལ་གཞན་གྱི་རྐྱེན་གྱིས་ཚིཁ་ན་མ་ལུས་པའི་ཕྱིར་ཡང་ཛེེཡང་དག་པར་མཐོང་ངོ།",
    "ལྷ་དང་མིས་ཡང་དག་པར་བཟུང་བ་ཉིད་དང་།",
