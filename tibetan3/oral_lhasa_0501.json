    "དྲིས་པའི་ཚེ་ཙ་ཞེས་པ་ན་ལྷོ་ཕྱོགས་ཀྱི་རྐེད་པ་ཙམ་ན་མིའི་སེལ་ཡོད་པས་ས་དེར་གནས་པ་རྣམས་ཀྱི་ཁྱིམ་བདག་འཆི་བ་དེས་པར་བྱེད་དོ།",
    "དྲིས་པའི་ཚེ་ཏ་ཞེས་པ་ན་སྲིན་པོའི་ཕྱོགས་ཀྱི་ཁྲུ་ཕྱེད་དང་དོ་ཙམ་ན་རུས་པ་ཡོད་པས་ཁང་པ་དེར་གནས་པ་རྣམས་ཀྱི་བྱིས་པ་ཟད་པར་ངེས་པར་བྱེད་དོ།",
    "དྲིས་པའི་ཚེ་ཤ་ཞེས་པ་ན་ལུས་ངན་པོའི་ཕྱོགས་ཀྱི་རྐེད་པ་ཙམ་དེ་ན་གཉིས་སྐྱེས་ཀྱི་སེལ་ཡོད་པས་ཁྱིམ་དེར་གནས་པ་རྣམས་ནི་ནོར་སྦྱིན་ལྟ་བུའང་ངེས་པར་མྱུར་དུ་ནོར་མེད་པར་བྱེད་དོ།",
    "དེ་ལྟར་སེལ་རྣམས་སྐྱོན་དང་ལྡན་པར་ཤེས་ནས་རབ་ཏུ་འབད་པས་བཏོན་ཏེ་སླར་ཡང་དག་པའི་ས་གཞི་དགའ་བ་དེར་ཕུར་བུས་གདབ་པར་བྱའོ།",
    "ཕུར་བུ་ནི་རྒུན་འབྲུམ་གྱི་ཤིང་ལས་བྱས་པ་སྟེ་ལྕགས་ཀྱིས་བརྡུང་བར་བྱའོ་ཞེས་པས་སེལ་དབྱུང་བའི་ཆོ་གའོ།",
    "དེ་ལ་ཐིག་ནི་གདབ་པར་བྱ་སྟེ་ཆོ་ག་བཟང་པོས་མཉམ་པར་བྱས་པའི་ས་གཞི་ལ།",
    "ཅེ་སྤྱང་དང་ནི་བྱ་རྒོད་བྱ་བང་ངུ་བར་གྱུར་ན་རྗེ་བོ་ངེས་པར་འཆི་བར་འགྱུར།",
    "དེ་ནས་སེལ་ཡོད་རྣམ་མང་པོ་ཡི་མཚན་མ་གསུངས་པ་འདིར་ནི་ཡང་དག་བསྡུས་པ་ཙམ།",
    "བཀྲ་ཤིས་དང་ནི་དགེ་འཕེལ་བ་ཡི་ཆེད་དུ་དང་པོར་ཤིན་ཏུ་རྣམ་པར་སྤྱད་ནས་དེས།",
    "དཔལ་ལྡན་སེང་གེ་རྣམ་པར་གནོན་པའི་ཏིང་ངེ་འཛིན་གྱིས་བར་སྣང་དུ།",
    "དྲི་ཡི་ཆུ་དང་ཙནྡན་དམར་པོ་གུར་གུམ་གྱིས་ནི་བྱུག་པར་བྱ།",
    "ཡང་དག་ཚིམ་པར་བྱ་སྟེ་རྩིག་མཁན་བཟོ་བོའི་ཚོགས་ནི་མཁས་པ་རྣམས།",
    "བརྩམས་པས་ཕ་གུ་དངུལ་དང་གསེར་གྱི་རུས་སྦལ་སྟེང་དུ་གཞག་པར་བྱ།",
    "དེ་རྣམས་མེ་ཡི་ཟུར་གྱི་ཕྱོགས་ལ་སོགས་པར་རིམ་པ་ཇི་བཞིན་དུ།",
    "གཡས་སུ་བསྐོར་བའི་རིམ་པས་ངེས་པར་སྦྱར་ན་རྫོགས་པར་འགྱུར་བ་སྟེ།",
    "ལེགས་པར་གནས་པས་དེ་ནས་ཡོངས་སུ་བཟླས་ཏེ་སྔོན་ལ་ཕྱོགས་བྲལ་རྣམས།",
    "དོང་དགང་བ་ནི་དེ་བཞིན་དུ་སྐ་རགས་ཙམ་མེ་དང་མདའ་དང་ཐུབ་པར་གསུངས་ཤིང་གང་ཡང་ཆུ་དང་རྡོའི་མཐར་ཐུག་པར་བྱ་སྟེ།",
    "ཞེས་པ་སོ་སོའི་ཟུར་ལ་ལན་བདུན་གྱིས་ཕ་གུ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཧཱུཾ་ཨཱ་ཨོཾ་ཞེས་པས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "འཆད་པར་འགྱུར་བའི་སྦྱང་བའི་ཆོ་གས་ཤིང་དང་འཇིམ་པ་དང་རྡོ་བ་ལ་སོགས་པའི་རྫས་ཀྱི་དངོས་པོ་གཙང་མ་རྣམས་སྟོང་པ་ཉིད་དང་།",
    "ཉེ་བར་གནས་པར་མཛད་པའི་རིགས།",
    "ཞེས་པའི་མཐར་ཐུག་བ་འཆད་པར་འགྱུར་བ་རྣམས་བརྗོད་པར་བྱའོ།",
    "ཐམས་ཅད་དུའང་འདིར་བསྒོམས་པའི་ལྷ་རྣམས་གཤེགས་སུ་གསོལ་བར་བྱའོ་ཞེས་པ་སྐུ་གཟུགས་ལ་སོགས་པའི་མཆོད་ཡོན་གྱི་ཆོ་གའོ།",
    "སྣག་ཚའི་སྣོད་དང་སྨྱུ་གུ་དག་སྦྱར་ནས་གང་ཞིག་ཤེས་རབ་དང་ཡེ་ཤེས་རྣམ་པར་འཕྲོ་བས་གང་བྲིས་པ་དེ་རྣམས་དེ་ཡོངས་སུ་རྫོགས་པའོ་ཞེས་བསམ་པར་བྱའོ།",
    "བྲིས་མཁན་ཕན་པར་གཏོགས་པས་སོ།",
    "ཆ་ལྔ་མཉམ་པར་བྱས་ནས་ནི།",
    "ཆ་གསུམ་མཉམ་པར་བྱས་ནས་ནི།",
    "མཆོད་རྟེན་ལ་སོགས་སྐུ་གཟུགས་རྙིང་པ་ཤིང་རུལ་དང་།",
    "ཡང་དག་རྙིངས་པར་གྱུར་རྣམས་གསོ་ཞིང་བསྒྲུབ་བྱ་སྟེ།",
    "དཔང་དུ་བྱས་ནས་ཕྱོགས་སྐྱོང་རྣམས་དང་ལྷ་ཀུན་དང་།"
  ]
}