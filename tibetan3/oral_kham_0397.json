    "ཁྱི་ངན་པ་དེ་དོན་མེད་དུ་ཞེ་སྡང་སྐྱེས་ཏེ་ཟུག་ཅིང་ཕ་རོལ་བོའི་རྗེས་སུ་བསྙེགས་པས་རྡོ་འཕངས་པ་ཕོག་པ་ན་འཁང་ཞིང་དཔའ་ཞུམ་སྟེ་རང་སར་ཉལ་ནས་འདུག་པའི་སྤྱོད་ཚུལ་ལ་ལྟོས་ཞེས་པའོ།",
    "དེ་དག་རྫིང་བུར་ཞུགས་ནས་གླང་བོ་ཆེ་དེ་ཆུ་ནང་དུ་ནུབ་ནས་འདུག་པ་དང་།",
    "འདི་ལ་ཟགས་ཞེས་འདུག་ཀྱང་ཐིག་ཟགས་ཀྱི་ཟགས་ཡིན་པར་སེམས།",
    "དེ་རིང་མི་འོང་ངམ་སྙམ་སྟེ་སྐྲག་ཅིང་འདུག་པ་དང་།",
    "མི་མེད་པར་རྟ་གྲོག་པོའི་ཁ་ན་འདུག་པར་མཐོང་ནས།",
    "ཁྱེའུ་ཡང་སྤངས་འདུག་པས།",
    "ངེད་ཀྱིས་མི་ཐུབ་པར་གདའ་ཟེར་བས།",
    "རྒྱལ་པོ་རྒྱལ་སྲིད་དང་བཅས་པ་ལ་ཆག་ཆེན་པོ་ཡོད་པས་དེའི་རིམ་གྲོར་བློན་པོ་ཆེ་ཞིག་ཟླ་བ་གསུམ་གྱི་བར་དུར་དུ་འདུག་དགོས་པར་བསྒྲག་ཏུ་བཅུག་སྟེ།",
    "གླང་བོ་ཆེའི་རོ་ནི་ངས་མི་ཐེག་ཤ་ནི་ཟ་དགོས་པར་འདུག་སྙམ་སྟེ་སྨྲས་པ།",
    "རྒྱལ་པོ་ངོ་ཚ་ནས་མགོ་སྨད་དེ་འདུག་གོ།",
    "པའམ་མི་འགྲུབ་པའི་བྱ་བ་ལ་འཇུག་པ་ནི་བླུན་ཞིང་རང་ཉིད་བརླག་པའི་རྒྱུ་ཡིན་ཏེ།",
    "དེ་ལྷག་ཅིང་མང་བ་བཞིན་དུ་བཀྲ་མི་ཤིས་པའི་རྐྱེན་བྱེད་པའི་ཉེས་པ་དང་རང་གཞན་སྡུག་ལ་སྦྱར་བའི་སྐྱོན་ཤིན་ཏུ་ཆེ་སྟེ།",
    "ཙ་ན་ཀའི་བསྟན་བཅོས་ལས།",
    "ད་དམ་བཅས་པ་བཞིན་དུ་མཐུ་རྩལ་མི་སྟོན་པར་ཞུམ་ཞིང་འདུག་གམ།",
    "དེའི་ཚེ་གཞོན་ནུ་ནོར་བཟང་ཡང་འཁོར་དེ་ན་འདུག་པས།",
    "གོས་ངུར་སྨྲིག་བགོས་ཏེ་འདུག་གོ།",
    "སྟན་གཅིག་བོར་ནས་གཉིས་པ་ལ་འདུག་གོ།",
    "རི་དྭགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་ཟས་ཀྱིས་ལྟོ་འགྲངས་ཤིང་ཚིམ་པ་ན་གཞན་ལ་གནོད་པ་མི་བྱེད་པར་གཞོགས་གཡས་པ་འོག་ཏུ་ཕབ་ནས་བདེ་བར་ཉལ་ནས་འདུག་པ་ལ་ལྟོས།",
    "མི་ངན་དེ་སྐྱེངས་བཞིན་དུ་མགོ་སྨད་དེ་འདུག་པ་མཐོང་ནས།",
    "ཕྱོགས་བཞིར་རྫུ་འཕྲུལ་སྣ་ཚོགས་བསྟན་ནས་ཁྲི་ལ་འདུག་སྟེ།",
    "རི་དྲུང་ཞིག་ན་སེང་གེ་རོལ་བ་ཅོད་པན་ལྟ་བུ་དང་ལྡན་པ་ཞིག་འདུག་པ་དེས།",
    "རོ་བསྲེགས་པའི་མེ་ལ་ནེ་ལེ་འདུག་པ་དང་།",
    "ཟན་ལ་སྨིན་བྱེད་ཀྱི་རྫས་བསྲེས་ཏེ་མ་མ་ལ་བྱིན་ནས་དེ་ལ་འདུག་ཏུ་བཅུག་པས།",
    "རྒྱལ་པོ་དང་ལྷན་དུ་ཞག་བདུན་དུ་འདུག་ཅིང་།",
    "གུས་པ་དང་དད་པའི་རྣམ་འགྱུར་ཆེ་བ་ཞིག་འདུག་པས།",
    "ཁོ་སྐྱེངས་པས་ཁྱིམ་བདག་དེའི་མདུན་དུ་མ་འདུག་གོ།",
    "དེ་མཁས་ཤིང་སྤྱོད་ལམ་དང་འགྲོ་འདུག་འོ་བཟེ་བས་སྐྱེ་བོ་རྣམས་ཀྱི་ཡིད་དུ་འོང་བར་གྱུར་ཏོ།",
    "ཙ་ན་ཀ་རྒྱལ་པོའི་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "འཛེགས་ན་ཐར་བ་གམ་ན་འདུག།",
    "སློབ་བརྒྱུད་བཅས་ཀྱི་སྐོར་ཞིབ་ཆ་བཀོད་འདུག་པ་ལ་གཞིགས་ན།",
    "༡༤ཞེས་སོགས་བཀོད་འདུག་པ་དང་།",
    "པཱ་དསཤག་ནམས་མ་ཚོར་སྣག་ཚའི་སྒེར་ཉེད་མིན་འདུག་པས།",
    "༡༥ཞེས་བཀོད་འདུག་པ་ལས་ཤེས་ཐུབ་པ་ཡིན་ལ།",
    "གཞན་གྱི་ལུང་དྲངས་པའང་མི་འདུག་པས།",
    "༡༦ཞེས་བཀོད་འདུག་པས།",
    "བཀའ་གདམས་གླེགས་བམ་ག་དུས་བརྩམས་གྲུབ་ཚུལ་གླེང་བ།",
    "༢༧ཞེས་བཀོད་འདུག་པ་འདི་ཡིན་ལ།",
    "༣ཞེས་འཁོད་འདུག་པས།",
    "ཆུ་སྟག་ལོར་དཔལ་སྣར་ཐང་གཙུག་ལག་ཁང་དུ་བཀོད་པའི་སྐོར་གསལ་བར་འཁོད་འདུག་པས།",
    "༣ ༡ཞེས་བཀོད་འདུག་པས།",
    "༤ཅེས་འཁོད་འདུག་པས།",
    "བནཔས་ག་ནན་༥ ཟཤན་འ་ཁཔནང་གྲ་ནང་དུ་དེ་བཞིན་འཁོད་ཡོད་པར་ཐེ་ཚོམ་གཏན་ནས་མི་འདུག་སྙམ།",
    "༧ཅེས་གསལ་བར་འཁོད་འདུག་པས།",
    "༨ ཅེས་འཁོད་འདུག་པས།",
    "གཞན་དག་རྣམས་ནི་ཕྱིས་སུ་ཚིག་ཟུར་སོགས་ལ་བཟོ་བཅོས་ཅི་རིགས་འཕོག་འདུག་པའང་ཤེས་ཐུབ་ལ།",
    "ཉང་ཉི་མ་འོད་ཟེར་ལ་འགེལ་དགོས་པ་ཆགས་འདུག་སྟེ།",
    "བེ་རོ་ན་ཙ་ན་ཡེ་ཤེས་སྤྱན་དང་ལྡན།",
    "ཡ་མཚན་ཤིན་ཏུ་ཆེ་ངེས་སུ་འདུག་གོ།",
    "རྗེ་འབངས་ཉེར་ལྔའི་རྣམ་གཞག་ག་དུས་ཐོན་མིན་དཔྱད་གླེང་།",
    "བེ་རོ་ཙ་ན་དང་།",
    "བི་རོ་ཙ་ན།",
    "དུས་རབས་འཁྲུགས་ནས་ཡོད་པའི་གནས་ཚུལ་གསལ་པོར་མངོན་འདུག་པས།",
    "༣ཞེས་བཀོད་འདུག་པས།",
    "༤ཞེས་བཀོད་འདུག་པ་དང་།",
    "༧ཞེས་འཁོད་འདུག་པས་ཐོག་མར་མཁར་ཆེན་བཟའ་མཚོ་རྒྱལ་ཞེས་བོས་པ་ཡིན་པར་ཆེས་གསལ་ལ།",
    "མཁའ་འགྲོ་ཡེ་ཤེས་མཚོ་རྒྱལ་དང་༡༡ཞེས་བཀོད་འདུག་པས།",
    "༡༣ཞེས་འཁོད་འདུག་པར་བརྟགས་ན།",
    "འོག་མིན་གྱི་གནས་མཐོང་བ་ལ་གཟུགས་ཀྱི་ཕུང་པོ་དང་འགྲོགས་འདུག་པ་གསུངས་པས།",
    "ཁམས་པ་རིན་ཆེན་གླིང་པས་ཤིང་བྱ་ལོ་པ་ཞེས་བཀོད་འདུག་པར་དཔྱད་ན།",
    "༡༥ཞེས་བཀོད་འདུག་པར་བརྟགས་ན།",
    "༢༡ཞེས་བཀོད་འདུག་པས།",
    "དེ་མིན་འཚོ་བཞུགས་དང་གཤེགས་ཚུལ་བཀོད་མི་འདུག་སྐྱེས་རབས་ལེའུ་བདུན་པ་ལས།",
    "བོད་ཡུལ་བགྲང་བྱ་ཉིས་ང་རྒྱ་ཉེ་བ་ནཟབ་བུ་ལུང་བུ་བྱ་ཟླའི་ཚེས་བཅུ་ལ་༢༥ ཞེས་འཁོད་འདུག།",
    "པདྨ་གླིང་ང་ས་ཀྱང་དེ་མཚུངས་བཀོད་འདུག་སྟག་ཤམ་པས།",
    "གླུ་ཚུལ་འཁོད་འདུག་དེབ་དེའི་ངོས་༣༧༩ལས།",
    "༣༡ཞེས་འཁོད་འདུག་མཁས་པ་ལེའུའི་གསུངས་དེ་ལ་བརྟགས་ན།",
    "༤ཞེས་ཀྱང་གསུངས་འདུག་པས།",
    "འོན་ཀྱང་དེ་སྔོན་འདིའི་ཐད་ལ་རྟོག་ཞིབ་དམིགས་བསལ་བྱ་མཁན་ནི་བྱུང་མྱོང་མི་འདུག་པས།",
    "དུས་རབས་བཅུ་གསུམ་གྱི་སྨད་ཙམ་ལས་སྔ་བ་མིན་པ་ནི་སློབ་དཔོན་གྱི་ཆ་ལུགས་ཀྱིས་མཚོན་བཞིན་འདུག་འོ་ན་སྔ་དར་དུས་སུ་སློབ་དཔོན་སྐུ་བརྙན་བཞེངས་ཡོད་དམ་མེད་ཅེས་འདྲི་ན།",
    "༦ཞེས་གསལ་བ་ལས་དེར་བྲིས་པའི་ཨུ་རྒྱན་པདྨའི་སྐུའི་ཆ་བྱད་རབ་བྱུང་ལྟ་བུ་ཞིག་ཡོད་པར་བསྟན་འདུག་པ་དང་།",
    "དེའི་མཇུག་ཏུ་བཀོད་པའི་ལྷ་སྐུའི་གྲས་སུ་བཙན་པོ་ཁྲི་རལ་པ་ཅན་སོགས་བྲིས་ཡོད་ཚུལ་བཀོད་འདུག་པས་ཀྱང་།",
    "དེའི་ངོས་༡༨༨ན་ཡང་དེ་བཞིན་འཁོད་འདུག་པས།",
    "ཁ་ཊམ་ཀ་མེད་པ་ཞིག་བྲིས་འདུག་པས་ཡ་མཚན་བྱུང་ཡང་།",
    "༩ཞེས་འཁོད་འདུག་པས།",
    "ད་ལྟ་ཡོངས་ཁྱབ་ཀྱི་སློབ་དཔོན་སྐུ་བརྙན་འདི་ག་དུས་བཞེངས་མགོ་ཚུགས་སམ།",
    "ཟ་ཧོར་མའི་ཁུངས་དངོས་གང་ཡིན་རྩ་བ་ནས་བསྟན་གནང་མི་འདུག་དེས་ན་བོད་དུ་གུ་རུ་སྔ་ཕྱི་གཉིས་བྱུང་བ་ཨེ་།་",
    "༡༡ ཞེས་འཁོད་འདུག་པས་སྔ་ཕྱི་གཉིས་བྱུང་བར་གསལ་བ་དང་།",
    "༡༣ཞེས་གསལ་པོར་བཀོད་འདུག་ཅིང་།",
    "དེ་ལྟར་ཟེར་དོན་ཡང་དེའི་གོང་དུ་དེ་འདྲའི་དབྱིབས་ཅན་གྱི་སྐུ་བརྙན་དར་མེད་པའི་རྒྱབ་ལྗོངས་ཤིག་མངོན་གྱིན་ཡོད་འདུག་སྙམ།",
    "བོད་དུ་གུ་རུའི་སྐུ་ཚབ་ཡིན་ཟེར་བའི་སྐུ་རིམ་པས་བྱོན་པ་ལས་སྔ་ཤོས་ཡིན་འདུག་པས།",
    "དེ་ནས་གུ་རུ་མཚན་བརྒྱད་ཀྱི་སྐུ་བརྙན་བཞེངས་སྲོལ་དར་བ་ཡིན་འདུག་ཅིང་།",
    "ཟ་ཧོར་མའི་སྐུ་ཡི་ཆ་ལུགས་ཀྱི་སྣང་བརྙན་གྱི་སྐོར་རྩ་བ་ནས་བསྟན་མི་འདུག་པས།",
    "སློབ་དཔོན་ཆེན་པོའི་ཆ་ལུགས་ཀྱི་སྣང་བརྙན་འདི་ལ་ཆ་ལུགས་ཡ་མ་ཟུང་ཡིན་ཞེས་རྒོད་ཀྱི་རྩེ་སྒྲོ་སོགས་འགའ་ཞིག་རྩོད་གནས་སུ་བྱེད་པ་གཅིག་འདུག་པ་ལ།",
    "ཀ་ཐོག་སི་ཏུའི་དབུས་གཙང་གནས་ཀྱི་ལམ་ཡིག་ཏུ་བཀོད་འདུག་པ་ལས་ཤེས་ཐུབ་ལ།",
    "པདྨ་འབྱུང་གནས་ཞེས་བོས་སྲོལ་མི་འདུག་ལ།",
    "པདྨ་འབྱུང་གནས་ཀྱི་སྐུ་བརྙན་ཞེས་པ་ཞིག་མི་འདུག་པ་གང་ཡིན་མི་ཤེས།",
    "༣ཞེས་བཀོད་པ་ལས་འདི་སྐོར་དམིགས་བསལ་གཏན་ནས་གསུང་མི་འདུག་པས།",
    "ཅེས་བཀོད་ནས་ཤོད་ཚུལ་འདི་ཉིད་འཐད་ལྡན་ཡིན་མིན་དཔྱད་དགོས་ཚུལ་འདི་ཉིད་བསྟན་པ་ཡིན་འདུག་ལ།",
    "ཤག་མཆོག་པའི་རང་ལུགས་གང་ཡིན་ཁ་གསལ་བསྟན་མི་འདུག་ཡང་དེ་མིད་ལ་ནས་བརྒྱུད་པའི་བདེ་མཆོག་སྙན་བརྒྱུད་ཟེར་བ་དེ་ཡིན་ཟེར་ན།",
    "༥ཞེས་བཀོད་འདུག་པ་ལ་བརྟགས་ན།",
    "སྔ་མ་གསེར་ཐུར་དུ་བཀོད་པ་དེ་འདྲ་ཟུར་ཙམ་ཡང་མི་འདུག་ལ།",
    "ད་ལྟ་མཇལ་ཡུལ་དུ་མི་འདུག་པས་གང་ཡིན་གླེང་ཐབས་བྲལ།",
    "དེ་དག་བོད་མ་དང་ཁུངས་མེད་ཡིན་ཞེས་ཐག་བཅད་མི་འདུག་པ་ལ་འང་བསམ་རྒྱུ་ཡོད།",
    "༡ཞེས་བཀོད་འདུག་པ་ལས།",
    "ཁོང་དང་ཁོང་རང་ཉིད་ལས་ན་ཚོད་གཞོན་པའི་རྗེ་བཙུན་རས་ཆུང་པ་དང་།",
    "རོ་ལ་ཡང་རྣ་བ་འདུག་པའི་ཕྱིར་རོ།",
    "༡༦ཞེས་བཀོད་འདུག་པར་བརྟགས་ན།",
    "ཉང་ལུགས་བདེ་མཆོག་མཁའ་འགྲོ་སྙན་བརྒྱུད་ཀྱི་སྐོར་ཞེས་པ་ཞིག་ཀྱང་ཡོད་འདུག་པ་དང་།",
    "བུ་བྱོན་ཙ་ན་ཕ་མཁའ་སྤྱོད་ལ་གཤེགས།",
    "ནཱ་རོ་པ་བཞུད་ཙ་ན་ཀྱེ་རྡོ་རྗེའི་དཀྱིལ་ཐང་དང་།",
    "ཕུ་ལ་ཧ་རིར་གཏོར་མཆོད་ལ་སོགས་པ་ཅི་ཡང་མི་སྣང་བར་མར་པ་ཁོ་ན་ལུས་གདའ་སྐད་དོ།",
    "ར་ལིའི་བདེ་མཆོག་གསང་བའི་རྒྱུད་དུ་དབྱངས་གསལ་ལ་༢༣དེ་བཞིན་སྦྱར་བའང་འདུག་མཧཱ་མུ་དྲ་ལའང་དེ་ལྟར་སྦྱོར་མི་སྲིད་པའི་གནས་ཅི་ལ་ཡོད།",
    "༢༥ཞེས་བཀོད་འདུག་པས་ཤེས་ནུས།",
    "ད་ལྟ་ཙ་རིའི་དཀར་ཆག་ཁག་ལ་གཞིགས་དུས་རྩེ་སྐོར་དང་བར་སྐོར་སོགས་ག་དུས་ཙ་ན་བྱུང་མིན་སྤྱིར་ན་རིམ་ཞིག་རགས་གསལ་པོར་རྟོགས་ཐུབ་ཀྱི་ཡོད་ཀྱང་།",
    "༡༣ཞེས་འཁོད་འདུག།",
    "སྐྱེ་སྒོམ་ཡེ་ཤེས་རྡོ་རྗེ་རོགས་སུ་ཁྲིད་ཡོད་ཚུལ་འཁོད་འདུག་པས།",
    "ཙ་རི་རོང་བསྐོར་ཆེན་པོ་ཞེས་པའི་ལམ་སྲོལ་ག་དུས་བྱུང་མིན་གླེང་བ།",
    "དེ་དུས་ཙ་ན་བསྐོར་ལམ་གཙོ་བོ་དེ་དག་ཡིན་པ་ལས།",
    "ཙཱ་རི་རོང་སྐོར་ཞེས་པའི་ཐ་སྙད་འདི་ཡིག་ཐོག་ལ་ཐོག་མར་ཐོན་པ་དེ་ཡིན་འདུག་སྟེ།",
    "ཙ་རིའི་བར་བསྐོར་གྱི་ལམ་རྣམས་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་བརྒྱུད་རིམ་དང་མཐུན་པར་གསུངས་འདུག་པས།",
    "དེ་ཕྱིན་སྤྲེལ་ལོ་ནམ་འཆར་ལ་རོང་བསྐོར་སྐོར་འཁོད་འདུག་པས་མཚོན།",
    "ཞེས་འཁོད་འདུག་པར་གཞིགས་ན།",
    "ཡོན་ཏན་རྒྱ་མཚོ་སྔ་མ་དེས་ཁོང་ནི་ཤེས་བྱ་སྤྱི་དང་བྱེ་བྲག་ནང་བསྟན་ལ་རྒྱུན་རིང་འདྲིས་པའི་རྣམ་འབྱེད་སྤོབས་པ་མེད་པར་བསྟན་འདུག་ལ།",
    "མཐོང་གྲོལ་གྱི་ཡོན་ཏན་ཡང་གསལ་པོར་བསྟན་གནང་འདུག།",
    "ཕྱིས་སུ་བསྣམས་ཚུལ་སོགས་གཏན་ནས་འཁོད་མི་འདུག་ལ།",
    "ཁོང་ནས་ཞྭ་ཡི་བསྟོད་པ་མཛད་དགོས་བྱུང་ལུགས་ཀྱང་མངོན་འདུག་པས།",
    "དུས་ཕྱིས་སུ་ཀར་མ་བཀའ་བརྒྱུད་ཀྱི་གཙུག་རྒྱན་རྒྱལ་བ་ཀར་མ་པས་དབུ་ཞྭ་ཞྭ་ནག་དེ་ཉིད་དམིགས་བསལ་གྱི་མཇལ་ཁ་གནང་བའི་སྲོལ་བྱུང་འདུག་ཅིང་།",
    "དེའི་སྐོར་ཡང་སྐབས་འདིར་ཅུང་ཟད་དཔྱད་ནའང་འབྲེལ་མི་ཆགས་པ་མི་འདུག་སྙམ།",
    "༡ ཞེས་འཁོད་འདུག་པས།",
