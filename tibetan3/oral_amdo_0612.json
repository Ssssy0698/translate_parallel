    "སྐྱིལ་མོ་ཀྲུང་ནི་ཕྱེད་བཅས་པས།",
    "རྐང་པ་རང་གི་བརླས་མནན་ན།",
    "དེ་དག་གི་ཕྲིན་ལས་དང་ཡོན་ཏན་དང་བཅས་པ་ནི།",
    "ད་ནི་འཁོར་གྱི་ལྷ་མོ་ལས་དང་པོ་སྤྱིའི་མཚན་ཉིད་ནི།",
    "གཙོ་བོའི་ཆ་ལུགས་ལས་གཞན་པའི་ལྷ་མོ་རྣམས་ཀྱི་མཚན་ཉིད་ཕྱག་རྒྱ་སྣ་ཚོགས་ཀྱི་ཚུལ་དུ་གནས་ཏེ།",
    "འདིར་གནས་ཞེས་པའི་སྒྲས་ཞལ་གདོང་གི་ཁྱད་པར་དང་།",
    "པྲ་མོ་ཧཱ་ནི་རྨོངས་བྱེད་མ་སྟེ།",
    "ཙཎྜ་ལཱི་ནི་ཟབ་མོ་སྟེ།",
    "དེ་ལྟར་ལྷ་མོ་ཀུན་ཀྱང་རང་རང་གི་སྐྱེས་བུ་དང་མི་འབྲལ་ཞིང་བདེ་བ་ལ་ལོངས་སྤྱོད་པས་ན་བདེ་བའི་ཕྱག་རྒྱའོ།",
    "ཡང་ལྷ་མོ་དག་གི་ལྟ་བའི་ཁྱད་པར་བསྟན་པའི་ཕྱིར།",
    "གསང་བའི་སྦྱོར་བ་དེ་མཆོག་གིས།",
    "དེ་ལ་ཞི་བའི་ལྟ་བ་ནི་མིག་ཟམ་ཟིམ་དུ་བྱས་ལ་གླང་པོ་ཆེ་ཁྱོ་ཤུག་བྱེད་པའི་གནས་སྐབས་བཞིན་ནོ།",
    "དྲག་པོའི་ལྟ་བ་ནི་སྡང་མིག་གི་ཚུལ་དུའོ།",
    "རྨོངས་པའི་ལྟ་བ་ནི་ཆང་གིས་མྱོས་པ་བཞིན་མི་གསལ་བར་བརྟགས་པའོ།",
    "ཤི་བ་སློང་བ་ནི་ཅུང་ཟད་གྱེན་དུ་གཟིགས་པའོ།",
    "གར་བྱེད་པ་ནི་རང་གི་གཡས་དང་གཡོན་དུ་རེས་བཞིན་གཟིགས་པའོ།",
    "རྣམ་པར་གཡེང་བ་ནི་ཕྱོགས་བཅུར་ཕུར་བུ་འདེབས་པའི་ཚུལ་གྱིས་གཟིགས་པའོ།",
    "རོ་ཟ་བ་ནི་མདུན་དུ་རེས་ཀྱིས་ལྟ་བའོ།",
    "གྲུབ་པའི་མཆོག་ནི་ལྟ་བ་དེ་དག་གི་ལས་ལ་སྦྱོར་བར་བྱེད་ཅིང་།",
    "འཁོར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་ཕྱག་རྒྱ་རིམ་པ་བཞིན་དུ་བཅིང་ཞིང་ལས་ཐམས་ཅད་ལ་སྦྱར་བར་བྱའོ།",
    "རང་གི་ལས་ལ་སྦྱོར་བར་བྱ་བའི་ཕྱིར།",
    "ལས་ཐམས་ཅད་འགྲུབ་པར་བྱེད་པའི་ཚུལ་གྱིས་རང་གི་དེ་ཁོ་ན་ཉིད་གསལ་བར་སྟོན་པའི་གླུ་བརྗོད་པའོ།",
    "གཟིགས་པ་རྣམ་པ་སྣ་ཚོགས་འགྱུར་བའི་རྒྱས་ཐོབ་ལ།",
    "ཞལ་དང་པོ་དྲག་པོའི་སྒོ་ནས་གཟིགས་པ་སྣ་ཚོགས་འགྱུར་བའི་རྒྱས་འདེབས་པ་དང་།",
    "ད་ནི་འཁོར་གྱི་ལྷ་མོ་བརྒྱད་ཀྱིས་བསྐུལ་བའི་གླུ་གསུངས་ཏེ།",
    "ཞེས་པ་ནི་ནང་གི་ལྷ་མོ་བཞིའིའོ།",
    "ཞེས་པ་ནི་ནང་གི་ལྷ་མོ་བཞིའི་ཕྲིན་ལས་སོ།",
    "ཉོན་མོངས་ཀུན་ལས་རྒྱལ་བར་མཛོད།",
    "ཉོན་མོངས་ཐམས་ཅད་བསལ་བར་མཛོད།",
    "ཅེས་པ་ནི་ཕྱིའི་ལྷ་མོ་བཞིའིའོ།",
    "དེ་དག་གི་སྒོ་ནས་རིགས་ཀྱི་དཀྱིལ་འཁོར་སྤྲོ་ཞིང་།",
    "ཡབ་ཡུམ་དང་ཞལ་སྦྱོར་དུ་བཞུགས་པའི་སྐྱིལ་ཀྲུང་གི་མཚན་ཉིད་ནི།",
    "སྐྱིལ་མོ་ཀྲུང་ནི་ཕྱེད་མར་གནས།",
    "རྒྱལ་པོའི་སྐྱིལ་མོ་ཀྲུང་བཅས་ནས།",
    "གཡོན་པ་བསྐུམ་སྟེ་སྐྱིལ་མོ་ཀྲུང་གི་ཚུལ་དུ་ཡུམ་དང་ཞལ་སྦྱོར་བའི་ཚུལ་གྱིས་གནས་པའོ།",
    "གཞན་ཡང་འཁོར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོའི་མཚན་ཉིད་ནི།",
    "ལྷ་མོ་བརྒྱད་པོ་འདི་དག་གིས།",
    "ཕྱག་གཡོན་པ་ན་པདྨ་སོ་སོའི་ཁ་དོག་དང་མཐུན་པར་འགྱིང་བག་གི་ཚུལ་གྱིས་གནས་ཤིང་འཛིན་པ།",
    "དེ་ལས་དང་པོ་ལྷ་མོ་རྣམ་པར་གཟིགས་པས་ནི་གཡོན་པས་པདྨ་དམར་པོ་ཅི་བདེ་བར་འཛིན་ཞིང་།",
    "དེས་ནི་གཞན་དག་གི་འདོད་པ་ཐམས་ཅད་སྐོང་བར་མཛད་པས།",
    "སྣ་ཚོགས་པདྨ་མོས་ནི་གཡོན་ན་པདྨ་ལྗང་གུ་བསྟོད་ཅིང་གཡས་ན་རྩེ་གསུམ་པ་འཛིན་པས་ཕྲིན་ལས་གསུམ་གྱིས་གཞན་འཇོམས་པའི་ཕྱིར།",
    "པདྨ་དཔལ་ཆེན་མོས་ནི་གཡོན་ན་པདྨ་སེར་པོ་འཛིན་ཅིང་གཡས་ན་ཆུ་སྲིན་གྱི་རྒྱལ་མཚན་འཛིན་པའོ་ཞེས་པས་ན།",
    "འཇིག་རྟེན་གྱི་ལྷ་དྲེགས་བྱེད་ཆེན་པོ་དག་གི་སྐུ་སྣ་ཚོགས་སྟོན་ཅིང་འགྲོ་བའི་དོན་དུ་འཕྲུལ་བའོ།",
    "ཡང་འཁོར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་གླུ་ནི།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་རྫོགས་པ།",
    "བུད་མེད་ལ་སོགས་རིན་ཆེན་མཆོག།",
    "ཉི་མ་འབུམ་གྱི་འོད་ཟེར་དང་ལྡན་པའི་སྒོ་ནས་གཞན་དག་གི་གདུང་བ་སེལ་ཞིང་།",
    "དེ་དག་གི་ཕྱག་མཚན་ལ་སོགས་པའི་ཁྱད་པར་བསྟན་པའི་ཕྱིར།",
    "སྐྱིལ་ཀྲུང་གི་ཁྱད་པར་བསྟན་པའི་ཕྱིར།",
    "རྡོ་རྗེ་པུས་མོ་གཉིས་བཅིངས་ཏེ།",
    "རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་བཅས་ནས།",
    "གཞན་ཡང་འཁོར་གྱི་ལྷ་མོ་དག་གི་མཚན་ཉིད་ཀྱི་སྒོ་ནས་ཕྱག་རྒྱ་ཆེན་པོའི་ཆ་ལུགས་བསྟན་པའི་ཕྱིར།",
    "ཞེས་པ་ནི་ནང་གི་ལྷ་མོ་བཞིའོ།",
    "རང་གི་དོན་རྣམས་རབ་སྒྲུབ་པའོ།",
    "ཞེས་པ་ནི་ཕྱིའི་ལྷ་མོ་དག་དང་སོ་སོའི་ལས་སོ།",
    "རྒྱལ་པོ་སྒྱུ་མ་མཆོག་གི་གླུ།",
    "དེ་ཡང་ལས་རྣམ་པ་བཞིའི་སྒོ་ནས་ཞལ་བཞིའི་རྣམ་པས་ལྷ་མོ་བཞིའི་ཕྲིན་ལས་ལ་གཟུང་བའི་ཕྱིར།",
    "བདག་གི་རེ་བ་ཀུན་སྒྲུབ་མྱུར་དུ་སྟོན་ཨ་ལ་ལ་ཧོ།",
    "བདག་གི་རེ་བ་ཀུན་སྒྲུབ་པའི་ཐབས་མྱུར་དུ་སྟོན་པ་དང་།",
    "གཞན་ཡང་ལྷ་མོ་རྣམས་ཀྱིས་ཁྱད་པར་གྱི་ལས་ལ་བསྐུལ་བའི་ཕྱིར།",
    "ཁྱད་པར་འདི་དག་ཐམས་ཅད་བུད་མེད་རིན་ཆེན་རྣམས་ཀྱི་ཕྱིར།",
    "དཔལ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ལས་རྟ་མཆོག་གི་སྐུར་སྤྲུལ་པའི་ཚུལ་ལོ།",
    "ཐམས་ཅད་དག་པར་མོས་པ་ཡིས།",
    "ཞེས་པ་ལ་སོགས་པ་སྟེ་ཞབས་གཡས་བརྐྱང་བའི་དང་པོས་གསུམ་གྲུབ་མ་དང་དཔལ་མོ་མནན་པའོ།",
    "གཉིས་པས་སྒྲོལ་མ་དང་དགའ་མོ་མནན་པའོ།",
    "འདོད་པའི་ལྷ་མོ་དག་དང་ཆགས་པའི་ཚུལ་གྱིས་གནས་ཤིང་།",
    "ཐམས་ཅད་དག་པར་མོས་པས་ངོ་མཐོན་གྱི་སྟོབས་ཀྱིས་གདུལ་བའི་ཕྱིར།",
    "ཞལ་བཞི་པ་རྟའི་གདོང་པ་ཁྲོ་གཉེར་དང་བཅས་པ་ལས་དགྱེས་པའི་གད་མོ་ཕ་རོལ་གནོན་པའི་སྟོབས་ཀྱིས་སྒྲ་དང་བཅས་པར་སྒྲོགས་པའོ།",
    "གཞན་ཡང་ཞབས་རྣམ་པ་བཞིའི་སྒོ་ནས་ལྷ་ཆེན་པོ་བཞི་མནན་ཞིང་དེ་དག་གི་ཆུང་མ་ལ་སྤྱོད་པར་མཛད་པའོ།",
    "དེ་དང་ལོངས་སྤྱོད་པ་ལས་རྟ་མཆོག་གི་མཐུས་ཕྲོགས་པའོ།",
    "ཚངས་པས་ནི་སྦྱོར་བའི་མཐུ་ལས་ལྷ་མོ་སྤྲུལ་པར་མཛད་པ་དང་།",
    "དེ་ལྟར་དཔལ་མོ་དང་སྒྲོལ་མ་དང་དགའ་བ་མོ་དག་ལ་སྤྱོད་པར་མཛད་པའོ།",
