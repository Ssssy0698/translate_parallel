    "དེ་ལྟར་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་ལས་རང་གི་གཙོ་བོ་དང་རིགས་ཀྱི་ལྷ་མོ་བཞིའི་སྦྱོར་བ་ཐམས་ཅད་ཀྱི་མཚན་ཉིད་བསྟན་ཏེ།",
    "དེའི་སྒོ་ནས་འཁོར་གྱི་ལྷ་མོ་གཞན་དག་དང་།",
    "ལྷ་མོ་ཀུན་གྱི་བདེ་བའི་མཆོག།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ལས་རང་རང་གི་དཀྱིལ་འཁོར་དུ་ལས་ཀུན་ལ་འཇུག་པའི་ཡན་ལག་ཏུ་བཞིན་གྱི་སྒོ་ནས་སྦྱོར་བ་སྟེ།",
    "གཞན་ཡང་འཁོར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་གཞན་གྱི་ཕྱག་རྒྱ་ནི།",
    "བུད་མེད་མཁས་པ་སྒྱུ་མ་ཆེ།",
    "བུད་མེད་ཀྱི་སྒྱུ་འཕྲུལ་དྲུག་ཅུ་རྩ་གཅིག་གི་སྒྱུར་རྩལ་ལ་སྦྱར་ཞིང་།",
    "མཛེས་པའི་བཞིན་རྣམ་པར་བསྒྱུར་ཏེ་རང་གི་ཕྲིན་ལས་ལ་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པ་ཞལ་གྱི་མདངས་རི་མོའི་མཚན་མ་ཅན་ཟུར་གྱི་མིག་གིས་བལྟ་བ་དང་།",
    "འགྱིང་བག་གི་སྲི་ཞུར་བཅས་པ་སྟེ་བུད་མེད་ཀྱི་ཆ་ལུགས་ཀུན་གྱི་མཆོག་ཏུ་གྱུར་པའོ།",
    "གཞན་ཡང་རྣམ་པར་སྣང་མཛད་པ་སོགས་པ་དག་གི་ཡང་བསྟན་པའི་ཕྱིར།",
    "རྟ་མཆོག་གི་ནི་ཞལ་རྣམ་པ་བཞིའི་སྒོ་ནས་བཞིན་གྱི་ཆ་ལུགས་སོ་སོར་གནས་པ་སྟེ།",
    "ལྷ་མོ་ཀུན་གྱི་བདེ་བའི་མཆོག།",
    "དང་པོར་ནི་ལྷ་མོ་བདེ་མཆོག་མའིའོ།",
    "ཚུལ་འདི་ཉིད་ཀྱིས་རང་རང་གི་ཕྲིན་ལས་མཛད་པའོ།",
    "བཞིན་གྱི་ཕྱག་རྒྱ་ལས་གཟིགས་ཐབས་ཀྱི་ཁྱད་པར་ལྷག་པར་བསྟན་ཏེ་གཙོ་བོ་སྐུ་ཞལ་སྦྱོར་དུ་གནས་ཤིང་།",
    "བདེ་བ་མྱོང་བའི་ཚུལ་དུ་སྤྱན་ཟམ་ཟིམ་དུ་གཟིགས་པས་ཕྲིན་ལས་བཞི་ལ་སྦྱོར་བར་བྱེད་པའོ།",
    "ཡང་ལྷ་མོ་བདེ་མཆོག་མ་ལ་སོགས་པའི་ནི།",
    "བུད་མེད་མཁས་པ་སྒྱུ་མའི་མཆོག།",
    "ལྷ་མོ་རྣམས་སོ་སོའི་ཕྲིན་ལས་ཀྱི་གཟིགས་ཐབས་མཐའ་དག་གིས་རང་རང་གི་ལས་ལ་སྦྱོར་བར་བྱེད་པའོ།",
    "དཔལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་གཞན་དག་གི་ནི།",
    "རྣམ་སྣང་གི་ཞི་བའི་ལྟ་བ་དང་།",
    "གང་ཞིག་གི་གནས་སྐབས་སུ་དེ་ཉིད་ཀྱི་ལྟ་བའི་ལྟ་བ་དང་ཚུལ་དང་ལྡན་པའོ།",
    "ན་མོ་སྟུ་སརྦ་བུད་ྡྷེ་བྷྱ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་དབུས་སུ་ཧུའཾ་ལས་གྱུར་བའི་རྡོ་རྗེ་དཀར་དམར་རྩེ་མོ་ལྔ་པ་བུམ་པ་ལ་ཡི་གེ་ཧཱུཾ་གིས་མཚན་པ་བསྒོམས་ནས།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱིས་ཕྱོགས་བཅུར་ཁྱབ་ཅིང་བདེ་བར་གཤེགས་པའི་གསུང་གི་གསང་སྔགས་ཐམས་ཅད་གཅིག་ཏུ་བསྡུས་ཏེ།",
    "དེ་ལྟར་བསྒོམ་ཞིང་བཟླས་པའི་མཐུས་རང་གི་ཡོན་ཏན་རྒྱ་ཆེན་པོ་དག་འགྲུབ་པར་བྱེད་པ་སྟེ་གོ་སླའོ།",
    "རྟ་མཆོག་གི་ནི་པདྨ་ལ་གནས་པའི་སྣ་ཚོགས་རྡོ་རྗེ་ལ་ཤྲཱི་བཛྲ་ལ་སོགས་པའི་སྔགས་ཀྱིས་བསྐོར་བའོ།",
    "གྲེ་འགྱུར་དང་ཁུགས་སུ་བཅས་པས་དུས་གསུམ་དུ་རབ་ཏུ་ཞི་བའི་ལྷ་རྣམས་མཚོན་པར་བྱེད་པའི་ཧཱུཾ་གིས་སྣ་དྲངས་ཏེ་བསྟོད་པ་ལ་སོགས་པའི་དབྱངས་རྗོད་པར་བྱེད་པའོ།",
    "ཧཱུཾ་གི་གླུ་ཡི་ཕྱག་རྒྱ་དཔལ།",
    "དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ནི་ཧཱུཾ་གི་གླུ་ཅི་བདེ་བར་ལེན་ཅིང་།",
    "ལྷ་མོ་རྣམས་ཀྱིས་ནི་ལྔ་ལྡན་དང་དྲུག་ལྡན་ལ་སོགས་པའི་དབྱངས་བརྗོད་པའོ།",
    "དཔལ་ཧེ་རུ་ཀའི་ནི་དབྱངས་དྲུག་གི་སྒོ་ནས་རུ་ལུ་འབྲུ་བརྒྱད་ཀྱི་སྒྲ་བརྗོད་ཅིང་འོད་ཟེར་གྱི་འཕྲོ་འདུས་གསལ་བར་བྱེད་པའོ།",
    "རྟ་མཆོག་གི་སྒོ་ནས་ལས་རྣམ་པ་བཞི་ལ་སོ་སོའི་གནས་སྐབས་སུ།",
    "བསྟོད་པ་དང་གཞན་དག་གི་ཡང་ཡན་ལག་ཏུ་སྦྱར་བར་བྱའོ།",
    "རང་རང་གི་ལྷ་མོའི་ཚོགས་ཀྱིས་འཛིན་པས།",
    "མ་དཀྲོལ་ཞིང་བཀོད་པ་ཙམ་གྱིས་ཀྱང་ལས་ཕྲ་མོ་དག་འགྲུབ་པར་འགྱུར་བའོ།",
    "རིགས་བཞི་དང་ཕྱག་རྒྱ་བཞི་དང་ལྷ་མོ་བཞི་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "དེ་དག་གི་ཁྱད་པར་གྱི་དོན་དུ་རིགས་ཀྱི་དཀྱིལ་འཁོར་རིམ་པ་བཞིན་དུ་བསྟན་པ་ལས།",
    "དང་པོར་རྡོ་རྗེ་སེམས་དཔའི་ལྷ་མོ་རྣམས་ཀྱི་སྒོ་ནས་ནི།",
    "ཊཀྐི་ཧཱུཾ་ཛ་ལྷ་མོ་དག་ལས་རོལ་པའི་ཚིག་གོ།",
    "ཡང་ཧུ་ལུ་ཞེས་པ་ནི་ཐལ་བྱེད་མའི་འོ།",
    "ཏ་གྷེན་ྡྷེ་ཞེས་པ་ལ་སོགས་པ་ནི་རྡོ་རྗེ་སེམས་དཔའི་ཐལ་མོ་བརྡབ་པའི་སྒྲ་སྐད་དོ།",
    "ཧིན་དོན་ཞེས་པ་ལ་སོགས་པ་ནི་མ་མོ་རྣམས་ཀྱིས་ཐལ་མོ་བརྡབ་པའི་སྒྲ་སྐད་དོ།",
    "ཡང་ཀོང་ཀོང་ཀོང་ཀོང་ཞེས་པ་ནི་པྲ་མོ་ཧཱའིའོ།",
    "རུ་ལུ་རུ་ལུ་ཧཱུཾ་བྷྱོ་ནི་དཔལ་ཆེན་པོ་དང་ལྷ་མོ་སྨ་ཤ་ནཱིའི་ཐུན་མོང་གི་སྔགས་སོ།",
    "ཊཀྐི་ནི་ཧཱུཾ་ཛྫ་ཞེས་པ་ལ་སོགས་པའི་རྟ་མཆོག་གི་ལས་བཞིའི་སྒོ་ནས་བསྐུལ་བའོ།",
    "དེ་དག་གི་ལས་ལ་རྣམ་པར་སྦྱར་བའོ།",
    "དེ་ལ་པས་ནི་ཐབས་ཀྱི་རང་བཞིན་པས་ཐལ་མོའི་ལས་ལ་སྦྱར་བ་ཡིན་ལ།",
    "དེ་ཡང་མུ་སྟེགས་པའི་མ་ཧཱ་དེ་བ་གདུལ་བའི་ཕྱིར་ནི་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་ལྷ་མོ་ཉི་ཤུའི་དཀྱིལ་འཁོར་རྒྱན་དང་ཆ་ལུགས་ཀྱིས་མཛེས་པར་བསྟན་པ་དང་།",
    "འཇིགས་པའི་གཟུགས་ཅན་ཁྱབ་འཇུག་གདུལ་བའི་དོན་དུ་ནི་དཔལ་རྟ་མཆོག་གི་སྐུར་བསྟན་པ་དང་།",
    "སྐྱེ་འགྲོ་མཐའ་དག་གི་དོན་སྤྱོད་པའོ།",
    "དངོས་གྲུབ་ཀྱི་མཆོག་དག་སྩོལ་བར་མཛད་ནས་འགྲོ་བ་ཐམས་ཅད་ཀྱི་རེ་བ་སྐོང་ཞིང་ཟག་པ་མེད་པའི་བདེ་བ་སྟེར་བར་མཛད་པའོ།",
    "ཕྱག་རྒྱའི་སྦྱོར་བ་འདི་དག་གིས།",
    "དེ་དག་གི་སྦྱོར་བ་ལ་གནས་པར་བྱའོ་ཞེས་པའོ།",
    "ཕྱི་དང་ནང་གི་མཚམས་བཅད་ནས་ལས་ཀྱི་རྡོ་རྗེ་དག་སྒོ་སྲུང་གི་ཁྲོ་བོར་གནས་པ་ལས།",
    "ཕྱི་ནས་འཇུག་པ་པོ་དག་གིས་ཕྱག་རྒྱ་དཀྲོལ་ཞིང་།",
    "སླར་ནང་ནས་དེ་དག་གི་ལན་བསྟན་པར་བྱ་ཞིང་།",
    "རིགས་དྲུག་གི་དཀྱིལ་འཁོར་དག་གི་སྒོ་ནས་སོ་སོའི་མཚན་ཉིད་དང་ཕྲིན་ལས་ལ་སྦྱར་བར་བྱའོ།",
    "དེའི་རྗེས་ལ་རྣལ་འབྱོར་པ་གཉིས་ཀྱིས་གར་སྟབས་དང་ལྡན་པའི་སྒོ་ནས་དང་པོར་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོ་ལྷ་མོ་སོ་སོའི་སྔགས་དང་ཕྲིན་ལས་སུ་བཅད་པའི་སྒོ་ནས་གར་བསྒྱུར་ཞིང་།",
    "དེའི་རྗེས་ལ་རྒོལ་བས་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་དག་གི་ཕྱག་རྒྱ་སྔགས་དང་བཅས་པར་རིམ་པ་བཞིན་དུ་འཆིང་ཞིང་།"
  ]
}