    "དེ་ནས་ངའི་སྟེང་ལ་ཁོང་ཁྲོ་ལངས་པར་གྱུར་ཏེ་གང་བྱུང་ངང་སྡིགས་མོ་འགའ་བྱས་རྗེས།",
    "མོར་ཁོ་ཚང་གི་བུ་མོར་བརྙས་བཅོས་བྱས་པ་རེད་དམ་ཞེས་དྲིས་པ་ན།",
    "མོས་མོ་ཚང་ལ་བུ་མོ་མེད་ཟེར།",
    "སློབ་གཙོས་ཧ་མ་གོ་བར་འོ་ན་ཇི་ལྟར་བརྙས་བཅོས་བྱས་པ་རེད་ཅེས་དྲིས་པ་ན།",
    "མོས་ང་ནམ་གུང་མོའི་ཁྱིམ་དུ་ཡོང་བ་རེད་ཅེས་སྨྲས་སོང་།",
    "མོ་ཕྱིར་སོང་མ་ཐག་ང་སློབ་གཙོའི་གཞུང་ལས་ཁང་དུ་བོས་པ་རེད།",
    "སློབ་གཙོ་ཀུན་བཟང་གཏན་ནས་ཁྲོས་མི་འདུག་པར་དེ་ལས་ལྡོག་སྟེ་དགོད་ཀྱིན་འདུག་འོན་ཀྱང་ངའི་མིག་ལམ་དུ་སློབ་གཙོ་ཀུན་བཟང་གི་ངོ་གདོང་ཕྲ་བུ་དེ་ནམ་རྒྱུན་ལས་ཇེ་ཆེར་གྱུར་ཡོད་པ་ལྟར་སྣང་ལ།",
    "ཁོའི་གདོང་གི་འཛུམ་དམུལ་གྱི་ཁྲོད་དུའང་དཔོན་པོའི་ཟིལ་ཤུགས་ཤིག་གིས་ཁེངས་འདུག་པའི་སྣང་བ་སྐྱེས་བྱུང་།",
    "ངས་ཀྱང་མྱུར་མོར་མཐོང་བྱུང་ཞེས་ལན་སྦྲང་ཆར།",
    "བྱིས་པ་ཞིག་ལ་ཁ་གློང་བ་ལྟར་འཛུམ་ལངས་པ་རེད་ཅེས་བཤད།",
    "ཆམོ་གཏུགས་བཤེར་དུ་ཡོང་བ་གཞིར་དེ་འདྲ་ཞིག་རེད་དམ་ཟེར་ནས་རེ་ཞིག་ལ་རེད་ཅེས་སྨྲ་བཞིན་ངས་ཅི་ཟེར་ལ་བསྒུགས།",
    "དེ་ནས་མུ་མཐུད་དུ་གསང་ལངས་ཅུང་ལྡབ་ལྡིབ་ངང་ངས་མོར་ཅི་བྱེད་བ་ཅི་ཞིག་རྟོགས་འདོད་པ་ལྟར་འཛུམ་ཤིག་ཤིག་ངེས་སམ་ཞེས་བཤད།",
    "བྱས་ཡོད་པ་དང་ཡོངས་སུ་མི་མཐུན་པས་ཁོའི་རེ་ཁྱོད་ཀྱིས་མོར་བརྙས་བཅོས་བྱས་སོང་ཟེར།",
    "སློབ་གཙོས་ངས་དེ་ལྟར་ཆ་དེ་ཕྱི་རུ་འཁྱར་ན་དགོད་བྲོ་བ་ཞིག་མ་རེད་དམ།",
    "ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་ཟེར་ནས་པ་དང་།",
    "དཔྲལ་བའི་ངོས་སུ་སྦྲང་མ་ཞིག་འགུལ་གྱིན་ཡོད་གང་ལྟར་ཁྱོད་ཀྱི་སྟེང་ནས་དོན་དག་དེ་འདྲ་ཞིག་འདྲའི་ཚོར་སྣང་བྱུང་།",
    "དེ་དང་བསྟུན་ནས་སྤོབས་ཤུགས་ཤིག་ཀྱང་བཟང་བོ་ཞིག་མ་རེད།",
    "ཅུང་ཚབ་ཚུབ་ཏུ་གྱུར་ནས་མྱུར་མོར་ངས་ཅི་ཞིག་འགྱོད་བཤགས་བྱེད་དགོས་པ་རེད།",
    "སློབ་གཙོས་ཅི་མི་སྙམ་པའི་ངང་དུ་ཇི་བག་ཅིག་ཁྱེར་སོང་སྟེ་ང་ནོར་སོང་བ་རེད་ཅེས་དགོངས་དག་ཞུས་པས་ཆོག་པ་རེད།",
    "སྡིགས་མོ་དང་དམོད་མོ་སྣ་ཚོགས་བྱེད་བཞིན་ངའི་སྟེང་ལ་།",
    "ཤོར་ཤོར་བྱས་སོང་།",
    "མོས་དམོད་མོ་བྱེད་པའི་ཆུ་ཚད་ངའི་བློ་ངོར་མི་ཤོང་བ་ཤ་སྟག་སྟེ།",
    "ངེད་ཚང་གི་གསོན་པོ་ས་སྟེང་དུ་ཡོད་པ་དང་ཤི་ནས་ས་འོག་ཏུ་ཡོད་པ་ཚང་མའི་རུས་པ་བརྡུངས་ཏེ་ཁྱི་ལ་འཕང་དགོས་ཚུལ་དང་།",
    "ངེད་ཚང་གི་མི་རབས་ཚང་མར་ལུས་ལ་ན་ཚ་ཡོང་བ་དང་ཁ་ལ་མུ་གེ་ཡོང་བའི་དམོད་མོ་དང་བཅས།",
    "ངས་ནི་གུས་གུས་ཞུམ་ཞུམ་གྱིས་སེམས་བསམ་པའི་སྟེང་ནས་མོར་བཟོད་པ་སྒོམ་དགོས་པའི་ཞུ་བ་བྱ་རུ་སོང་ཡང་།",
    "བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ལ་མོས་ནི་དེ་ལས་ལྡོག་སྟེ་ཞེ་འཚེར་བའི་དམོད་མོ་དེ་འདྲ་ཞིག་བོར་བའི་ཁར།",
    "དེསྐབས་དེར་ངེད་གཉིས་ཀྱིས་མཐའ་འཁོར་དུ་མི་མང་བོ་འདུས་བྱུང་བས་ངའི་ངོ་གདོང་ཧྲིལ་བོ་ཚ་ལམ་ལམ་དུ་གྱུར་སོང་།",
    "ཡིན་ནའང་ངས་ད་དུང་མོར་འཁོན་སེམས་མ་བཅངས་ལ།",
    "མི་མང་གི་མདུན་ནས་མོས་ཀྱང་ང་ལ་ལག་འཛིང་བྱེད་མི་སྲིད་སྙམ་ནས།",
    "ཁྱོད་ཁོང་ཁྲོ་མ་ལངས།",
    "དེ་ལས་ལྡོག་སྟེ་སྔར་ལས་ཀྱང་སྨྱོས་པ་ཡིན་མི་ཤེས་པའི་གདངས་ཀྱིས་ཁྱོད་ཀྱིས་མ་བྱས་ལྟར་གྱུར་ཏེ་མི་མང་གི་ཁྲོད་དུ་ང་ལ་ཁྱོད་ཀྱིས་ངའི་ཟེར་ཕོད་དམ།",
    "ཁྱོད་འདོད་པ་ཡིན་ནམ་ཟེར།",
    "མོས་དེ་ལས་ལྡོག་སྟེ་མི་རྣམས་ལ་ངས་འཇུན་ཀྱིས་ངའི་མིག་ཀོང་ཕྱི་རྟིང་གིས་བརྫིས་པ་མིན་ནམ།",
    "ལག་གཡས་པའི་གུང་མཛུབ་དེ་ཡོ་སྙད་འདོགས་བྱས་པ་མ་རེད་དམ།",
    "མི་ཞིག་གི་གཟི་བརྗིད་དང་འདོད་པ་ཡིན།",
    "མ་གཞིར་ཀ་མི་སྡུག་པ་དེའི་སྟེང་ལ་ལག་པ་ཕྱིའི་ལག་གིས་རྒྱག་ཁའི་མགོ་རྔ་མི་ཤེས་པའི་རྒན་མོ་དེས་ཀྱང་སྐད་ཆ་ལ་ཁད་ཅིག་བྱས།",
    "ངས་མོའི་ངོ་གདོང་དུ་གཞུ་ག་གཏམ་ཡན་བསྒྲགས་པ་དེ་ནི།",
    "དེ་བས་ངས་སྔར་བཞིན་གང་ནུས་ངང་ལྕག་གིས་བརྒྱབ་པ་དང་མཆིལ་མ་བཏབ་པ།",
    "བོད་ཀྱི་ཡིན་པར་ང་རེད་ཟེར་བ་དེ་ཡིན་འདུག་སྒྲུང་གཏམ།",
    "ལ་སྐྱོན་ཆ་ཅི་ཡང་མེད་པ་རང་སེམས་སུ་གསལ་ཉེས་པ་ཡོད་ཚད་ངའི་སྟེང་དུ་ཡོང་བ་མ་རེད་དམ།",
    "གཉིས་ཀ་མཐོང་སོང་བ་བདེན་མོད།",
    "འོན་ཀྱང་འགྲམ་གྱི་མི་འགའ་རེས་མོ་བཟུང་འདུག་པ་དང་གཏམ་དེ་ཕྱི་ལ་སྒྲོག་མཁན་ང་མིན།",
    "དེའི་ཐད་འགའ་རེས་ང་ཕར་དེད་བྱུང་བས།",
    "ང་ཡང་གོ་ནས་ངས་ཁྱོད་ལ་མནའ་བསྐྱལ་ཆོག་ཅེས་རང་ཉིད་སྐབས་དེ་དང་བསྟུན་ནས་ཕྱིར་ལོག་ཐུབ་ཙམ་བྱུང་།",
    "འོན་ཀྱང་ངའི་རྣ་རྒྱབ་ན་ད་དུང་མོའི་སྐད་ཅོར་།",
    "ཁྱོད་ཚོས་ང་འཆི་རུ་ཆུགས་ཞེས་པ་གྱུར་ནས་སྨྲེ་སྔགས་བཏོན་བྱུང་།",
    "འོན་ཀྱང་ཐེངས་ལྷང་ལྷང་དུ་གྲག་གིན་འདུག་༡ ༡༡དེའི་སྐད་ཅོར་གྱི་ནང་དོན་ནི་སྔོན་ཏག་ཏག་ལ་ང་དོན་དག་དེས་ངའི་སེམས་སྐྱིད་པོ་ཞིག་འབྱུང་དམྱལ་ཁམས་བཅོ་བརྒྱད་ཀྱི་ཞབས་སུ་སྐྱེ་ངེས་པའི་དུ་མ་བཅུག་པས།",
    "ཉིན་དེ་ནས་བཟུང་ངས་ཀྱང་དམོད་མོ་བྱས་པ་སོགས་གང་ཡང་མ་ཡིན་པར།",
    "ཁོ་གཉིས་ལ་མི་ཁ་བསྐོར་པའི་གཏམ་ཡན་དེའི་དེ་ལས་ལྡོག་སྟེ་མོ་དམྱལ་ཁམས་བཅོ་བརྒྱད་དུ་ལྷུང་།",
    "འབྱུང་ཁུངས་ངོ་མ་གང་དུ་ཡོད་པ་རྩད་གཅོད་བྱས་འགྲོ་ཞེས་པར་གྱུར་འདུག་མོས་ངུད་མོ་དང་པས་ཅང་མ་འགོར་པར་མཇུག་འབྲས་བྱུང་སོང་།",
