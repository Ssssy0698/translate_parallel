    "ལྷ་དྲང་སྲོང་དེ་ཕྱོགས་དེ་ཁོ་ན་ཉིད་ན་མཆིས་ནས་དེང་དུ་དགུང་དྲུག་ལགས་ཀྱིས་བཀའ་སྩལ་པའི་རིགས་སོ།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནས་དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟ་བུ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་དུའོ།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་བཟང་ལྡན་གྱིས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་མི་གཙོ་བོ་རྣམས་ཀྱི་རྒྱལ་པོར་གྱུར་ལགས།",
    "དགེ་སློང་དག་ལས་བྱས་ཤིང་བསགས་པ་དག་ནི་ཕྱི་རོལ་གྱི་སའི་ཁམས་ལ་རྣམ་པར་སྨིན་པར་མི་འགྱུར།",
    "ཇི་ཙམ་ན་རྒྱལ་པོ་ཚངས་སྦྱིན་གཉིད་ཀྱིས་དུབ་པ་སངས་ནས་རིངས་པ་རིངས་པར་བཱ་རཱ་ཎ་སཱིར་ཞུགས་སོ།",
    "བདག་ལ་འདི་ཅི་དགོས་འདིའི་ཕྱིར་གནོད་པར་འགྱུར་བའི་གནས་གང་ཡིན་པ་དེ་ཡོད་སྙམ་ནས་དེས་དེ་སུའི་ཡིན་པ་དེ་ལེན་པར་འགྱུར་གྲང་ཞེས།",
    "དེ་རྣམས་ཁ་ཟས་བསོད་པས་ཚིམ་པར་བྱས་པ་དང་།",
    "མུ་ལྟོ་བ་རྣམས་ནི་རང་བཞིན་གྱིས་བཀྲེས་སྐོམ་པས་ཟིལ་གྱིས་ནོན་པ་ཡིན་པས་ཚོང་འདུས་ནས་བཟའ་བ་དང་བཏུང་བ་འཕྲོག་པར་བྱེད་དོ།",
    "དེ་རྣམས་རྒྱལ་པོས་བཀུར་ནས་ནི་ལྷག་པར་ཡང་དབྲོག་པར་བརྩམས་སོ།",
    "ཁྱེད་ཅག་སྲུང་བ་ལ་བག་ཡོད་པར་བྱོས་ལ་དེ་རྣམས་ལ་ནི་མ་རྡེག་ཤིག།",
    "འདི་བས་ཁྱད་པར་དུ་འཕགས་པའི་སྟོན་པ་མཉེས་པར་བྱེད་ཀྱི་མི་མཉེས་པར་མི་བྱེད་པར་གྱུར་ཅིག་ཅེས་བཏབ་བོ།",
    "མི་གཙོ་བོ་རྣམས་ཀྱི་རྒྱལ་པོར་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནས་དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟ་བུ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་དུའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ལྷུང་བཟེད་བླ་གབ་མེད་པར་བཞག་གོ།",
    "དགེ་སློང་དག་སྤྲེའུ་འདིས་ལྷུང་བཟེད་རྣམས་བཅག་པར་མི་འགྱུར་གྱིས་འདི་ལ་མ་བཟློག་ཤིག།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྲོག་ཆགས་དང་བཅས་པ་ཡིན་པས་མ་བཞེས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་བརྟགས་པ་མ་ཡིན་ནོ་ཞེས་མ་བཞེས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་བརྟགས་པ་བྱས་སོ་ཞེས་བཞེས་སོ།",
    "དེའི་ཉེ་དུ་རྣམས་ཚོགས་ཤིང་འདུས་ནས་ཉི་མ་བདུན་གསུམ་ཉི་ཤུ་གཅིག་ཏུ་དེའི་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ནས་ཁྱེའུའི་མིང་ཅིར་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད་དོ།",
    "གསུམ་པ་འགྲོགས་བཤེས་དང་ལྷན་ཅིག་ལོངས་སྤྱོད་པར་བྱེད་དོ།",
    "བཙུན་པ་མཐོང་ལགས་སོ།",
    "དེས་ན་འདིས་དེ་བཞིན་གཤེགས་པ་ལ་སྦྲང་རྩིའི་ལྷུང་བཟེད་ཕུལ་བ་དེའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པས་བྲམ་ཟེ་ལས་དྲུག་ལ་བརྩོན་པའི་ཁྱིམ་དུ་སྐྱེས་ཤིང་ཉིང་མཚམས་སྦྱོར་བ་བླངས་པ་དང་བཙས་པ་ན་ཡང་སྦྲང་རྩིའི་ཆར་བབ་བོ།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཞེས་བྱ་བ་ནས་ལས་གཅིག་ཏུ་དཀར་བ་ལས་བརྩལ་བར་བྱའོ་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་དུའོ།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་ཉེ་བ་འཁོར་གྱིས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་རྒྱལ་པོའི་འབྲེག་མཁན་དུ་གྱུར་ལགས།",
    "དེས་གུས་པར་བྱས་ཏེ་དེའི་སྐྲ་དང་ཁ་སྤུ་བྲེགས་སོ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་དེ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ལས་ཁྱེའུ་ཞིག་བཙས་སོ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ལས་ཁྱེའུ་ཞིག་བཙས་སོ་ཞེས་བྱ་བ་ནས།",
    "ལྷ་འབྲེག་མཁན་འདིས་འབྲེག་མཁན་ཐམས་ཅད་ལ་དེ་རྣམས་ཀྱི་ཁ་སྤུ་བཅོས་པའི་ལས་སུ་ཡང་མ་བགྱིད་ཅིག་ཅེས་བཀག་ལགས་སོ།",
    "དེ་རྣམས་ཡིད་མི་བདེ་བ་སྐྱེས་ཏེ་འཇིག་རྟེན་གྱིས་སྨད་པས་འཇིགས་ནས་དེ་གསད་པར་འདོད་དོ།",
    "དེ་རྣམས་བདག་ལ་གསད་པར་འཚལ་གྱིས་གནང་བར་མཛོད་ཅིག་དང་རབ་ཏུ་འབྱུང་ངོ།",
    "དེ་གནང་བ་ཐོབ་ནས་དྲང་སྲོང་རྣམས་ཀྱི་ནང་དུ་རབ་ཏུ་བྱུང་སྟེ།",
    "དེ་ལ་འདིས་ཚེ་ཇི་སྲིད་པར་ཚངས་པར་སྤྱོད་པ་སྤྱད་ན་ཡོན་ཏན་གྱི་ཚོགས་འགའ་ཡང་མ་ཐོབ་ནས།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནས་བརྩལ་བར་བྱ་སྟེ།",
    "དགེ་སློང་དག་དེ་ལྟ་བུ་ལ་ཁྱེད་ཀྱིས་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་དུའོ།",
    "ལྷ་རྣམས་ཀྱི་ཤེས་པ་མཐོང་བ་ནི་འོག་ཏུ་འཇུག་པ་ཡིན་པས་གནས་གཙང་མའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱིས་སྨྲས་པ།",
    "དེའི་བཙས་པའི་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ནས་ཁྱེའུའི་མིང་ཅིར་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད་དོ།",
    "དེ་མ་མའི་པང་ན་འཚོ་བ་ན་མཚན་མཁན་རྣམས་ཀྱིས་ཁྱེའུ་འདིས་ནི་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་རིམ་གྲོ་བྱེད་པར་འགྱུར་རོ་ཞེས་ལུང་བསྟན་ཏོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་བཅོམ་ལྡན་འདས་ཀྱིས་རབ་ཏུ་ཕྱུང་དུ་འོང་ངོ་ཞེས་སྤྱན་སྔར་མི་འབབ་པར་བྱའོ་སྙམ་ནས།",
    "རྣམ་པར་མི་རིག་པ་ཅུང་ཟད་ཀྱང་མི་མངའོ།",
    "འཇིག་རྟེན་ལ་ཕན་པར་ཞུགས་པ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞིའི་ཞབས་ལེགས་པར་གནས་པ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་མཁས་པ།",
    "གང་ནི་གནོད་པར་འགྱུར།",
    "ང་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ནས་བདུད་རྩི་ཐོབ་པར་འགྱུར་གྱིས།",
    "ཡང་དག་པར་འཛིན་དུ་འཇུག་པར་མཛད།",
    "ཡང་དག་པར་གཟེངས་སྟོད་པར་མཛད།",
    "ཡང་དག་པར་རབ་ཏུ་དགའ་བར་མཛད་དེ།",
    "ཡང་དག་པར་འཛིན་དུ་བཅུག།",
    "ཡང་དག་པར་གཟེངས་བསྟོད།",
    "ཡང་དག་པར་རབ་ཏུ་དགའ་བར་མཛད་ནས་གདན་ལས་བཞེངས་ཏེ་བཞུད་དོ།",
    "བདུད་རྩི་ཟས་ཆུང་མའི་འཁོར་དང་བཅས་པས་བཟློག་པར་མ་ནུས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འོད་སྲུང་གཞོན་ནུ་རབ་ཏུ་ཕྱུང་ཤིག་ཅེས་འོད་སྲུང་སྟོབས་བཅུ་ལྡན་ལ་གཏད་ནས་དེས་དེ་རབ་ཏུ་ཕྱུང་བསྙེན་པར་རྫོགས་པར་བྱས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་སེར་སྐྱའི་གཞིར་ཇི་ཙམ་བཞེད་ཀྱི་བར་དུ་བཞུགས་ནས་རྒྱལ་པོའི་ཁབ་གང་ན་བ་དེར་རྒྱུ་ཞིང་གཤེགས་ཏེ།",
    "རིམ་གྱིས་རྒྱུ་ཞིང་གཤེགས་པ་དང་རྒྱལ་པོའི་ཁབ་ཏུ་བྱོན་ནས་རྒྱལ་པོའི་ཁབ་འོད་མའི་ཚལ་བྱ་ཀ་ལན་ད་ཀ་གནས་པ་ན་བཞུགས་སོ།",
    "དེས་དེའི་ཕོལ་མིག་སྨིན་པར་འགྱུར་བ་དག་བསྐུས་ནས་དེ་ཉིད་དུ་དྲལ་ཏེ་དེ་ཉིད་དུ་སོས་པར་བྱས་སོ།",
    "དེས་ན་སྤྱི་བོར་ཕོལ་མིག་བྱུང་བར་གྱུར་ལགས།",
    "དགེ་སློང་དག་དགེ་སློང་ཀུན་དགའ་བོ་འདི་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དག་ནི་ཞེས་བྱ་བ་ནས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱལ་པོའི་ཁབ་ཏུ་ཇི་ཙམ་བཞེད་ཀྱི་བར་དུ་བཞུགས་ནས་མཉེན་ཡོད་གང་ན་བ་དེར་རྒྱུ་ཞིང་གཤེགས་ཏེ།",
    "རིམ་གྱིས་རྒྱུ་ཞིང་གཤེགས་པ་དང་མཉན་ཡོད་དུ་བྱོན་ནས་མཉན་ཡོད་ན་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ན་བཞུགས་སོ།",
    "འཕགས་པ་ད་ལྟར་ཤིང་ཤ་པ་འདི་ལ་འདབ་མ་ཇི་སྙེད་མཆིས་མཁྱེན་ཏམ།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ལས་ཅི་ཞིག་བགྱིས་ན་དེས་ན་མཚན་མ་ལ་མཁས་པར་གྱུར་ལགས།",
    "དགེ་སློང་དག་དགེ་སློང་ཀུན་དགའ་བོ་འདི་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དག་ནི་ཞེས་བྱ་བ་ནས།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་དོ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ལས་ཁྱེའུ་ཞིག་བཙས་ཏེ་ཞག་བདུན་གསུམ་ཉི་ཤུ་གཅིག་ཏུ་དེ་བཙས་པའི་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ཏེ་རིགས་དང་མཐུན་པའི་མིང་བཏགས་ནས་གསོས་བསྐྱེད་དེ་ཆེན་པོར་གྱུར་ཏོ།",
    "དེས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་རིག་པར་བྱས་ཏེ།",
    "ཅིག་ཤོས་ནི་ས་ལ་ལྷུང་བར་གྱུར་ལགས།",
    "དགེ་སློང་དག་ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་འདི་ཉིད་ཀྱིས་སྔོན་གྱི་ཚེ་རབས་གཞན་དག་ཏུ་ལས་བྱས་ཤིང་བསགས་ཏེ།",
    "དེས་ན་འདིའི་ཟས་ཀྱི་དུས་སུ་གཞོང་པར་འབྲས་སཱ་ལུའི་ཆན་དང་།",
    "སེམས་དད་པར་མཐོང་ནས་དེས་དེར་དེ་ལ་ཐོག་མར་ལོ་ཏོག་སར་པ་འོན་ཅིག་ཅེས་བྱས་ནས་འབྲས་སཱ་ལུའི་ཆན་དང་།",
    "སྲེག་པ་གཉིས་ཕུལ་བ་དེའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པས་ལོ་མང་པོ་དང་།",
    "ད་ལྟར་ཡང་འདིའི་ཟས་ཀྱི་དུས་སུ་གཞོང་པར་འབྲས་སཱ་ལུའི་ཆན་དང་།",
    "ལྟས་མཁན་རྣམས་ཀྱིས་འཕགས་པ་ཀུན་དགའ་བོ་ནི་ཅོད་པན་གྱིས་བཅིངས་པར་འགྱུར་རོ་ཞེས་ལུང་བསྟན་པས་ཅི་ཙམ་ནམ་ནངས་པ་དང་།",
    "དགེ་སློང་དག་དགེ་སློང་ཀུན་དགའ་བོ་འདི་ཉིད་ཀྱིས་སྔོན་གྱི་ཚེ་རབས་གཞན་དག་ཏུ་ལས་བྱས་ཤིང་བསགས་པ་དག་ནི་ཞེས་བྱ་བ་ནས།",
    "ཁྱིམ་བདག་རྣམས་ཀྱིས་འདི་ལ་བསྙེན་བཀུར་བྱས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་མཉན་ཡོད་ན་ཇི་ཙམ་བཞེད་ཀྱི་བར་དུ་བཞུགས་ནས་ཤིང་སཱ་ལ་ཅན་གང་ན་བ་དེར་རྒྱུ་ཞིང་གཤེགས་ཏེ།",
    "བཙུན་པ་བདག་བཅོམ་ལྡན་འདས་ལ་ཐུགས་ལ་མི་འཐད་པ་མ་ལགས་ཀྱི།",
    "བཙུན་པ་བདག་ནི་བཅོམ་ལྡན་འདས་ལ་ཐུགས་ལ་མི་འཐད་པ་མ་ལགས་ཀྱི་ཐུགས་ལ་འཐད་པས་རིམ་གྲོ་བགྱིད་ཅིང་།",
    "བཅོམ་ལྡན་འདས་དགེ་སློང་གང་ཞིག་རིམ་གྲོ་པར་བཞེད་པར་འགྱུར།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ཤེས་པར་གྱིས་ཤིག།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ལ་བལྟས་ན་དགེ་སློང་ཀུན་དགའ་བོས་ངའི་རིམ་གྲོ་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "ཤར་ཕྱོགས་སུ་སྐར་ཁུང་ནས་ཉི་མའི་འོད་ཟེར་ཤར་བ་ནུབ་ཕྱོགས་ཀྱི་རྩིག་པའི་ངོས་ལ་འབབ་པ་དེ་བཞིན་དུ་ངའི་རིམ་གྲོ་དགེ་སློང་ཀུན་དགའ་བོས་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་དང་ལྷན་ཅིག་མངོན་དུ་ཡང་དག་པར་དགའ་བ་དང་།",
    "ཡང་དག་པར་མགུ་བར་འགྱུར་བའི་གཏམ་རྣམ་པ་སྣ་ཚོགས་བྱས་ཏེ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་པར་བདག་མི་སྤྲོའོ།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་མེ་འབར་བའི་མེ་ཕྲག་ནི་བསྙེན་པར་དཀའ་ཞིང་བཟོད་པར་དཀའ་བ་ཡིན་ནོ།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་གཅན་གཟན་གྱི་རྒྱལ་པོ་སེང་གེ་རི་ཕུག་ན་གནས་པའི་སོ་ཕྲག་ནི་བསྙེན་པར་དཀའ་ཞིང་བཟོད་པར་དཀའ་བ་ཡིན་ནོ།",
    "གཡུལ་ངོར་སོན་པའི་མཆེ་བའི་ཕྲག་ནི་བསྙེན་པར་དཀའ་ཞིང་བཟོད་པར་དཀའ་བ་ཡིན་ནོ།",
    "ཚེ་དང་ལྡན་པ་ཤེས་པར་གྱིས་ཤིག།",
    "བཅོམ་ལྡན་འདས་ནི་ངའི་རིམ་གྲོ་དགེ་སློང་ཀུན་དགའ་བོས་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "ཁང་པ་བརྩེགས་པའི་ཁྱམས་བྱང་ཕྱོགས་སུ་རིང་བ་ཤར་ཕྱོགས་སུ་སྐར་ཁུང་བཏོད་པ་ཤར་ཕྱོགས་ཀྱི་སྐར་ཁུང་ནས་ཉི་མའི་འོད་ཟེར་ཤར་བ་ནུབ་ཕྱོགས་ཀྱི་རྩིག་པའི་ངོས་ལ་འབབ་པ་དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ནི་ངའི་རིམ་གྲོ་དགེ་སློང་ཀུན་དགའ་བོས་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "བཀུར་སྟི་བྱ་བའི་ཕྱིར་ཉེ་བར་འགྲོ་བ་ལ་དུས་མ་ཡིན་པ་ཅུང་ཟད་ཀྱང་མེད་པར་གནང་ངམ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་པར་སྤྲོ་བ་བསྐྱེད་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འཁོད་དོ།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལགས་ན།",
    "བདག་བཅོམ་ལྡན་འདས་ལ་བལྟ་བ་དང་བཀུར་སྟི་བྱ་བའི་ཕྱིར་ཉེ་བར་འགྲོ་བ་དུས་མ་ཡིན་པ་ཅུང་ཟད་ཀྱང་མེད་པ་གནང་ངམ།",
    "གལ་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ལ་མཆོག་གསུམ་གནང་བ་ལྟ་ན་བདག་དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་བགྱིད་པར་སྤྲོའོ་ཞེས་མཆི་ལགས་སོ།",
    "གཞི་འདིས་བདག་ལ་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་དགེ་སློང་ཀུན་དགའ་བོ་ནི་ཁ་ཟས་ཀྱི་རྒྱུས་སྟོན་པ་ལ་བཀུར་སྟི་བྱེད་དོ་ཞེས་ཁ་ཟེར་བར་འགྱུར་བ་མཐོང་སྟེ།",
    "ཀུན་ཏུ་རྒྱུ་འདི་དག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་བཀའ་ལ་སྤོབས་པ་དང་ལྡན་པར་འགྱུར།",
    "འདི་དག་ནི་བཀའ་ལ་སྤོབས་པ་དང་ལྡན་པར་མི་འགྱུར།",
    "བཟའ་བ་དང་བཅའ་བ་འདི་ནི་བཅོམ་ལྡན་འདས་ལ་བདེ་བ་སྐྱེད་པར་འགྱུར།",
    "ཀུན་ཏུ་རྒྱུ་འདི་དག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་བཀའ་ལ་སྤོབས་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "འདི་དག་ནི་བཀའ་ལ་སྤོབས་པ་དང་ལྡན་པར་མི་འགྱུར་རོ།",
    "བཟའ་བ་དང་བཅའ་བ་འདི་ནི་བཅོམ་ལྡན་འདས་ལ་བདེ་བ་སྐྱེད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཕྱི་མ་ནང་དུ་ཡང་དག་འཇོག་ལས་བཞེངས་པ་མཚན་མ་འམ་གསུང་བསྟན་པས་ཤེས་པར་འགྱུར་ཞིང་བདེ་བའི་གནས་པ་འདི་དང་འདིས་བཅོམ་ལྡན་འདས་མང་དུ་བཞུགས་སོ།",
    "གནས་པ་འདི་དང་འདིས་བདེ་བར་གཤེགས་པ་མང་དུ་བཞུགས་སོ་ཞེས་སྟོན་པར་འདོད་ན་ཇི་སྐད་བསྟན་པ་དེ་དག་ཐམས་ཅད་དེ་བཞིན་དུ་འགྱུར་ཏེ།",
    "དེས་དེ་བཞིན་གཤེགས་པའི་རིམ་གྲོ་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་བཅོམ་ལྡན་འདས་ཀྱི་མཆེད་དུ་གྱུར་ཅིང་ཐོས་པ་མང་བ་དང་།",
    "ཐོས་པ་བསགས་པའི་རིམ་གྲོ་པར་གྱུར་ལགས།",
    "དགེ་སློང་དག་དགེ་སློང་ཀུན་དགའ་བོ་འདི་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དག་ནི་ཞེས་བྱ་བ་ནས།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་དོ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ལས་ཁྱེའུ་ཞིག་བཙས་ཏེ་དེའི་བཙས་པའི་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ནས་ཁྱེའུའི་མིང་ཅིར་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད་དོ།",
    "འདིའི་ཡབ་འོད་ཟེར་ལགས་པས་དེའི་སླད་དུ་ཁྱེའུའི་མིང་འོད་ཟེར་ཅན་དུ་གདགས་སོ་ཞེས་དེའི་མིང་འོད་ཟེར་ཅན་དུ་བཏགས་ནས།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ན་ཁྱེའུ་ཞིག་བཙས་ནས་དེའི་ཡང་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ཏེ་འོད་ཟེར་ལྡན་ཞེས་བྱ་བར་མིང་བཏགས་སོ།",
    "ལྷ་མཁྱེན་པར་མཛད་དུ་གསོལ།",
    "རབ་ཏུ་འབྱུང་ལགས་སོ།",
    "སྦྱིན་སྲེག་སྲེག་པར་བྱེད།",
    "རྒྱལ་པོས་གདོན་མི་ཟ་བར་གལ་གྱིས་འཆུ་བར་ཤེས་ནས་གནང་བ་དང་།",
    "བདག་རབ་ཏུ་འབྱུང་ལགས་སོ།",
    "དྲང་སྲོང་ཆེན་པོ་འདིའི་ཚེ་ཞག་བདུན་ལགས་སམ།",
    "དྲང་སྲོང་ཆེན་པོ་གལ་ཏེ་དེ་ལྟ་ན་གནང་བར་བགྱིས་རབ་ཏུ་ཕྱུང་ཤིག།",
    "དེ་བདག་ལ་ཚེ་ཅུང་ཞིག་ཡོད་པར་ཤེས་ནས་དད་པ་དྲག་པོས་དེ་ལ་བཀུར་སྟི་བྱ་བར་བརྩམས་སོ།",
    "འོ་ན་སུ་འཆད་ལགས།",
    "ཐོས་པ་བསགས་པར་གྱུར་ཅིག་ཅེས་བཏབ་བོ།",
    "ཐོས་པ་འཛིན་པ་ཐོས་པ་བསགས་པའི་རིམ་གྲོ་པར་གྱུར་ཏོ།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་བཅོམ་ལྡན་འདས་ཀྱིས་ཐོས་པ་མང་བ།",
    "ཐོས་པ་བསགས་པ་རྣམས་ཀྱི་མཆོག་ཏུ་བསྟན་ལགས།",
    "ཐོས་པ་བསགས་པ་རྣམས་ཀྱི་མཆོག་ཏུ་ལུང་བསྟན་པར་གྱུར་ཅིག་ཅེས་བཏབ་བོ།",
    "དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟ་བུ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "བཅོམ་ལྡན་འདས་རྒྱལ་པོའི་ཁབ་འོད་མའི་ཚལ་བྱ་ཀ་ལན་ད་ཀ་གནས་པ་ན་བཞུགས་སོ།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགོད་པར་བྱེད་དོ།",
    "སྐྱུར་རྩིའི་ཚལ་གང་ཡིན་པ་དེ་ལས་སྐྱུར་རྩིའི་འབྲས་བུ་ཁ་དོག་དང་དྲི་དང་རོ་ཕུན་སུམ་ཚོགས་པ་རྣམས་ལས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ།",
    "སུམ་བཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་ནང་དུ་དོང་ནས་ལྷའི་བདུད་རྩི་ལས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགོད་པར་བྱེད་དོ།",
    "མི་མང་པོས་གང་བའི་བར་གང་ཡིན་པ་དེ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ།",
    "སྐྱུར་རྩིའི་ཚལ་གང་ཡིན་པ་དེ་ལས་སྐྱུར་རྩིའི་འབྲས་བུ་ཁ་དོག་དང་དྲི་དང་རོ་ཕུན་སུམ་ཚོགས་པ་རྣམས་ལས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ།",
    "སུམ་བཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་ནང་དུ་དོང་ནས་ལྷའི་བདུད་རྩི་ལས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་ནས་ཡུལ་ལྗོངས་འབྱོར་པ་དང་ཞེས་བྱ་བ་ནས།",
    "སྐྱེ་བོ་དང་མི་མང་པོས་གང་བའི་བར་གང་ཡིན་པ་དེ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་པར་བྱེད་ཅིང་།",
    "ལྷག་མ་ཡང་དགེ་སློང་ཡོད་པ་རྣམས་ལ་འགེད་པར་བྱེད་ཀྱིས།",
    "སྐྱེ་བོ་དང་མི་མང་པོས་གང་བའི་བར་གང་ཡིན་པ་དེ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བས་ལྷུང་བཟེད་བཀང་སྟེ་བླངས་ནས་བདག་ཉིད་ལོངས་སྤྱོད་ཅིང་།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ལ་ཚུལ་བཞིན་ཡིད་ལ་བྱོས་ཤིག་དང་།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ལྷ་སྦྱིན་གྱིས་ནམ་གྱི་ཆ་སྟོད་དང་།",
    "རབ་ལ་ཡང་ལུས་ཀྱིས་མི་ཐོགས་པར་ཐད་ཀར་འགྲོའོ།",
    "ཆུ་ལ་ཡང་མི་ནུབ་པར་རྒྱུན་ཕྱོགས་སུ་འགྲོ་སྟེ།",
    "འདི་ལྟར་མཐུ་ཆེ་བ་ལ་ཡང་ལག་པས་ཉུག་ཅིང་ཀུན་དུ་ཉུག་པར་བྱེད་དོ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ཡང་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་ལྷ་སྦྱིན་གྱིས་གླང་པོ་ཅང་ཤེས་བཟང་པོ་དང་།",
    "མ་སྐྱེས་དགྲ་ཡང་གཞོན་ནུ་དེ་ལ་འཛིན་ཅིང་ཁ་སྤྲད་དེ་འཁྱུད་པར་བྱེད་དོ།",
    "ཀྱེ་མ་སྟོན་པ་བས་ནི་འཕགས་པ་ལྷ་སྦྱིན་ཆེས་མཐུ་ཆེའོ་ཞེས་དད་པར་གྱུར་ཏོ།",
    "དེ་ལ་དད་པར་གྱུར་ནས་ལྷག་པར་བྱ་བ་བྱེད་དོ།",
    "དེ་ལ་གཡོས་ཀྱི་སྣ་རྫེའུ་ལྔ་བརྒྱ་ཙམ་ཡང་བཀད་ས་དང་བཀད་ས་དག་ཏུ་སྟོབས་པར་བྱེད་དོ།",
    "དགེ་སློང་རབ་ཏུ་མང་པོ་རྒྱལ་པོའི་ཁབ་ཏུ་བསོད་སྙོམས་སྤྱོད་པས་ལྷ་སྦྱིན་ལ་རྙེད་པ་དང་བཀུར་སྟི་འདི་ལྟ་བུ་དག་བྱུང་བར་གྱུར་ཏེ།",
    "དེ་ལ་གཡོས་ཀྱི་སྣ་རྫེའུ་ལྔ་བརྒྱ་ཙམ་ཡང་བཀད་ས་དང་བཀད་ས་དག་ཏུ་སྟོབས་པར་བྱེད་དོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འཁོད་དོ།",
    "ལྷ་སྦྱིན་ལ་རྙེད་པ་དང་བཀུར་སྟི་འདི་ལྟ་བུ་དག་བྱུང་བར་གྱུར་ཏེ།",
    "དེ་ལ་གཡོས་ཀྱི་སྣ་རྫེའུ་ལྔ་བརྒྱ་ཙམ་ཡང་བཀད་ས་དང་བཀད་ས་དག་ཏུ་སྟོབས་པར་བགྱིད་དོ།",
    "ལྷ་སྦྱིན་ཡང་དགེ་སློང་ལྔ་བརྒྱ་ཙམ་དང་ལྷན་ཅིག་བཀད་སའི་གུང་ལ་མཆིས་པར་བགྱིད་དོ་ཞེས་ཐོས་ལགས་སོ།",
    "དགེ་སློང་དག་ཁྱེད་ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ལ་དགའ་བར་མ་བྱེད་ཅིག།",
    "ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་གསོད་པ་ཡིན་ནོ།",
    "ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་སྨད་པ་ཡིན་ནོ།",
    "ཆུ་ཤིང་ནི་འབྲས་བུ་ཕྱུང་ནས་བསྐམས་པར་འགྱུར་བ་དེ་བཞིན་དུ་ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་གསོད་པ་ཡིན་ནོ།",
    "ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་སྨད་པ་ཡིན་ནོ།",
    "དཔེར་ན་སྦ་དང་སྨྱུག་མ་ནི་འབྲས་བུ་ཕྱུང་ནས་བསྐམས་པར་འགྱུར་ཞིང་།",
    "སྦ་དང་སྨྱུག་མ་ནི་འབྲས་བུ་ཕྱུང་ནས་དུང་ཡག་ཏུ་འགྱུར་བ་དེ་བཞིན་དུ་ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་གསོད་པ་ཡིན་ནོ།",
    "ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་སྨད་པ་ཡིན་ནོ།",
    "ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ནི་སྨད་པ་ཡིན་ནོ།",
    "དགེ་སློང་དག་ལྷ་སྦྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་དེ་ལྟ་བུ་ཇི་སྙེད་བྱུང་བ་དེ་དག་ནི་སྐྱེས་བུ་གཏི་མུག་ཅན་དེ་ལ་ཡུན་རིང་པོར་གནོད་པ་དང་།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ།",
    "རྙེད་པ་དང་བཀུར་སྟི་གང་ཡིན་པ་ཟིལ་གྱིས་མནན་པར་བྱའི་རྙེད་པ་དང་བཀུར་སྟི་བྱུང་བ་ལ་སེམས་གཏུགས་ཏེ་གནས་པར་མི་བྱ་སྟེ།",
    "དེའི་ཚེ་བཅོམ་ལྡན་འདས་ཀྱི་ཉན་ཐོས་སྐྲོད་ངའི་བུ་དགེ་སློང་ནོག་ཅན་ཞེས་བྱ་བས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་ཚངས་པར་སྤྱོད་པ་སྤྱད་དེ།",
    "ཚངས་པའི་གནས་པ་བཞི་བསྒོམས་ནས་འདོད་པ་རྣམས་ལ་འདོད་པའི་འདུན་པ་སྤང་བའི་ཕྱིར་དེ་ལ་མང་དུ་གནས་པས་ཚངས་པའི་འཇིག་རྟེན་དང་སྐལ་བ་མཉམ་པར་སྐྱེས་སོ།",
    "དེ་ནས་ཚངས་པ་ནོག་ཅན་གྱིས་ལྷ་སྦྱིན་རྫུ་འཕྲུལ་དེ་ལས་ཡོངས་སུ་ཉམས་པར་ཤེས་ནས།",
    "རྒྱལ་པོའི་ཁབ་འོད་མའི་ཚལ་བྱ་ཀ་ལན་ད་ཀ་གནས་པར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "བཙུན་པ་མད་ལགས་སོ།",
    "དེ་ནས་ལྷ་སྦྱིན་གྲོགས་དགེ་སློང་བཞི་པོ་ཀོ་ཀ་ལི་ཀ་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་ལྷ་སྦྱིན་གྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ནི་ཐུགས་ལས་ཆུང་ངུར་བདེ་བར་གནས་པའི་རྣལ་འབྱོར་གྱི་རྗེས་སུ་བརྩོན་པས་བཞུགས་སུ་གསོལ།",
    "དེ་ནས་ལྷ་སྦྱིན་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ལྷ་སྦྱིན་འཁྲུགས་པ་དང་།",
    "དེ་ནས་ལྷ་སྦྱིན་གྱིས་འཇལ་ཏོ་ཞེས་བྱས་ནས་མགོ་ལན་གསུམ་ལྕོགས་ཏེ།",
    "བཙུན་པ་འོད་མའི་ཚལ་བྱ་ཀ་ལན་ད་ཀ་གནས་པ་ན་དགེ་སློང་ཇི་སྙེད་ཉེ་བར་བརྟེན་ཏེ་མཆིས་པ་དེ་དག་ཐམས་ཅད་རིམ་གྲོའི་གནས་སུ་བསོགས་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ད་ནི་དེའི་དུས་ལ་བབ་པར་དགོངས་སུ་གསོལ།",
    "བཞུགས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་རྣམས་ལ་བཀའ་སྩལ་པ།",
    "སྟོན་པ་ཤེས་ལྡན་འདི་རང་ཉིད་ཤེས་པར་འགྱུར་གྲང་།",
    "སྟོན་པ་ཤེས་ལྡན་འདི་རང་ཉིད་ཤེས་པར་འགྱུར་གྲང་།",
    "སྟོན་པ་ཤེས་ལྡན་འདི་རང་ཉིད་ཤེས་པར་འགྱུར་གྲང་།",
    "ང་ཡང་ཉན་ཐོས་རྣམས་ཀྱིས་ལུང་སྟོན་པ་དང་ལྡན་པར་རྗེས་སུ་སྲུང་བར་འདོད་པ་མི་མངའོ།",
    "དེ་ནས་ལྷ་སྦྱིན་གྱིས་ཀོ་ཀ་ལི་ཀ་དང་།",
    "འཁོར་ལོ་ཕྱེ་བ་བྱས་སོ་ཞེས་ཕྱོགས་དང་ཕྱོགས་མཚམས་སུ་གྲགས་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ལྷ་སྦྱིན་བཅོམ་ལྡན་འདས་ཀྱི་ཉན་ཐོས་རྫུ་འཕྲུལ་ཆེ་བ་མཐུ་ཆེ་བ་ལྷའི་མིག་དང་ཕ་རོལ་གྱི་སེམས་རིག་པ་དག་ཡོད་ལ།",
    "དེ་རྣམས་ཀྱི་སེམས་ཀྱིས་སེམས་ཁྱབ་པར་བྱས་ནས།",
    "ཡིད་ཀྱིས་ཡིད་རྣམ་པར་ཤེས་ཀྱི།",
    "དེ་རྣམས་ཀྱིས་བདག་ཅག་བསྐྱོད་པ་ཉིད་ཀྱིས་ཤེས་པར་འགྱུར་རོ།",
    "ཚེ་དང་ལྡན་པ་ལྷ་སྦྱིན་ཐབས་དེ་ནི་བདེན་པ་ཞིག་ཡོད་དོ།",
    "དགེ་སློང་དག་ཁྱེད་ཀྱིས་ལྷ་སྦྱིན་དང་།",
    "དགེ་སློང་དེ་རྣམས་ཀྱིས་ལྷ་སྦྱིན་བཞམས་ཏེ་བསྒོ་བ་དང་།",
    "དགེ་སློང་དག་ཁྱེད་ཀྱིས་ལྷ་སྦྱིན་དང་།",
    "ཚེ་དང་ལྡན་པ་གང་དག་ལྷ་སྦྱིན་ལ་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྒོ་བར་མཛད་པར་བཟོད་པ་དེ་དག་ནི་ཅང་མ་གསུང་ཤིག།",
    "དེའི་གྲོགས་བྱེད་ཅིང་མི་མཐུན་པར་སྨྲ་བའི་རྗེས་སུ་ཕྱོགས་པའི་དགེ་སློང་བཞི་པོ་ཀོ་ཀ་ལི་ཀ་དང་།",
    "དགེ་སློང་འདི་ནི་ཤེས་བཞིན་དུ་སྨྲའི་མི་ཤེས་པར་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེའི་གྲོགས་བགྱིད་ཅིང་མི་མཐུན་པར་སྨྲ་བའི་རྗེས་སུ་ཕྱོགས་པའི་དགེ་སློང་བཞི་པོ་ཀོ་ཀ་ལི་ཀ་དང་།",
    "དགེ་སློང་འདི་ནི་ཤེས་བཞིན་དུ་སྨྲའི་མི་ཤེས་པར་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དགེ་སློང་འདི་གང་ལ་བཟོད་ཅིང་འདོད་པ་དེ་ལ་བདག་ཅག་ཀྱང་འདོད་ཅིང་བཟོད་དོ་ཞེས་མཆི་ལགས་སོ།",
    "དགེ་སློང་འདི་ནི་ཤེས་བཞིན་དུ་སྨྲའི་མི་ཤེས་པར་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "རྒྱ་མཚོས་བྱིན་རྣམས་ལ་བཞམས་ཏེ་བསྒོ་ལགས་ན།"
  ]
}