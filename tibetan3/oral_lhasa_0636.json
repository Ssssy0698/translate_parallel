    "ལྷ་མཁྱེན་པར་མཛོད་ཅིག།",
    "འདི་ལྟར་རབ་ཏུ་བྱུང་བ་ནི་མཁས་པ་རྣམས་ཀྱིས་བསྔགས་པ་ལགས་ཏེ།",
    "སླར་ཡང་དྲང་སྲོང་རྣམས་ལས་ལོག་པར་གྱུར་ན་བུའི་གནས་ནི་ཕ་དང་མ་མ་ལགས་པ་གཞན་གང་དུ་མཆི་བར་འགྱུར།",
    "གཞོན་ནུ་དག་གལ་ཏེ་དེ་ལྟ་ན་གནང་བར་བྱའོ།",
    "གཞོན་ནུ་དེས་པ་མཁྱེན་པར་མཛོད་ཅིག།",
    "བརྩལ་བ་བྱས་པས་འདོད་པ་རྣམས་ལས་འདོད་ཆགས་དང་བྲལ་བར་བྱས་ནས་བྱམས་པའི་ཏིང་ངེ་འཛིན་ཐོབ་སྟེ།",
    "དེའི་བྱམས་པ་དེས་ནི་རི་དགས་གདུག་པ་རྣམས་ཀྱང་བསྟི་གནས་སུ་འདྲིས་པར་གྱུར་ཏེ།",
    "སེམས་ནི་རྟག་ཏུ་གོམས་བྱས་པས།",
    "རྒྱལ་པོ་སྡིག་ཅན་འདིས་དྲང་སྲོང་འདི་ཉེས་པ་མེད་ཅིང་གནོད་པ་མ་བྱས་པར་རྐང་པ་དང་ལག་པ་དང་ཕྲལ་ཏེ་བོར་གྱིས།",
    "སྣ་དང་ཕྲལ་ནས་མ་རུང་བྱས་གྱུར་པ།",
    "ཤེས་ལྡན་དག་དེ་ལ་ཇི་ལྟར་བསྒྲུབ་པར་བྱ།",
    "ཡོ་བྱད་རྣམས་ཀྱིས་ལྷ་རབ་ཏུ་འཁྲུགས་པ་མཉེས་པར་འགྱུར་བས་གཏོར་མ་དང་།",
    "ནེ་ཙོ་རྣམས་རབ་ཏུ་མང་པོར་བྱས་ཏེ་སྐྱེ་བོའི་ཚོགས་ཀྱང་ཤི་བར་གྱུར་གྱིས།",
    "འོན་ཀྱང་ཡིད་ཆེས་པར་མ་གྱུར་ནས་དེས་ཡང་སྨྲས་པ།",
    "དྲང་སྲོང་ཆེན་པོ་བཟོད་པར་གསོལ་ལོ།",
    "ལུས་ལ་གཏུབ་པར་བྱེད་པ་ན།",
    "ཡུལ་མི་དང་བཅས་པས་དྲང་སྲོང་དེའི་རྐང་པ་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་དོང་ངོ།",
    "དགེ་སློང་དག་ད་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནས་དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟ་བུ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "དེད་དཔོན་དེད་དཔོན་དེས་ནི་བདག་ཅག་ལ་མ་བལྟས་པར་མཆིས་ཏེ།",
    "ཡི་བློང་བར་མ་བྱེད་པར་འཁོད་ཅིག་དེད་དཔོན་དེ་བཙལ་ལོ།",
    "གློག་འབྱིན་པའི་ཆོ་འཕྲུལ་གྱིས་དད་པར་བྱས་སོ།",
    "འདི་ལ་བྱ་བ་བྱས་ན་གདོན་མི་ཟ་བར་འབྲས་བུ་སྨིན་པར་འགྱུར་རོ།",
    "དེ་རྣམས་ཀྱིས་དེ་ལ་བྱ་བ་རྣམ་པ་དུ་མ་བྱས་སོ།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཡིན་ལ།",
    "གཅིག་ཏུ་དཀར་བ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་དཀར་བ་ཡིན་ལ།",
    "འཁྲུག་པ་རྣམས་ལས་ཡོངས་སུ་གྲོལ་ནས་ཐམས་ཅད་མཁྱེན་ཅིང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཏེ།",
    "འཁྲུག་པ་རྣམས་ལས་ཡོངས་སུ་གྲོལ་ནས་ཐམས་ཅད་མཁྱེན་ཅིང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཏེ།",
    "ཇི་ཙམ་ན་མཐར་གྱིས་རྒྱ་མཚོའི་འགྲམ་དུ་ཕྱིན་ནས་གྲུ་སོ་སོ་སྟ་གོན་བྱས་ནས་འཇུག་པའི་ཚེ་དེ་རྣམས་ཀྱིས་དེད་དཔོན་ནོར་གྱི་ཤིང་རྟ་ལ་སྨྲས་པ།",
    "ལས་དེའི་རྣམ་པར་སྨིན་པས་འཁོར་ལ་གདུགས་ལྟ་བུར་བགྱིས་ཏེ་མཆིས་ལགས།",
    "དགེ་སློང་ཀུན་ཤེས་ཀོཎྜི་ནྱ་འདི་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་ཚོགས་རྙེད་པ་དག་ནི་ཞེས་བྱ་བ་ནས་ལུས་ཅན་དག་ལ་འབྲས་བུར་འགྱུར་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་ནོ།",
    "དེ་ལ་ཁྱེད་ཅག་ལས་ལོ་བཅུ་གཉིས་ཀྱི་བཟའ་བ་དང་བཏུང་བ་ཡོད་པ་དེ་དག་ནི་ངའི་ཡུལ་ན་གནས་པར་གྱིས་ཤིག།",
    "འཕགས་པ་དག་ཕུལ་ལགས་བཞིན་དུ་ཡང་བསླང་ཅི་འཚལ།",
    "འཕགས་པ་རྣམས་བཞུགས་ཤིག་ཁྱེད་ཀྱི་གདུགས་ཚོད་ཀྱི་དུས་གང་ལགས།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་དྲོལ་བབ་པ་དང་ལྷས་ཆར་དབབ་པར་བརྩམས་སོ།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་ལས་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་གཅིག་ཏུ་གནག་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནས་དགེ་སློང་དག་དེ་ལྟ་བུ་ལ་ཁྱེད་ཀྱིས་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་དུའོ།",
    "དེ་ལུས་དུབ་པས་དེ་རྣམས་ལེགས་པར་བསྒྲལ་ཏེ་མགྲིན་པ་བརྐྱང་ནས་གཉིད་ལོག་གོ།",
    "དེ་ནས་ལུས་ཆེན་པོ་དེ་གཉིད་ལོག་པར་མཐོང་ནས་རིངས་པའི་འགྲོས་ཀྱིས་སྲིན་བུ་ཀི་ཏ་ཀའི་ཚང་དུ་སོན་ཏེ།",
    "སྲོག་ཆགས་གཞན་ལ་གནོད་པར་བྱེད་པ་བས་ནི་སྲོག་དང་བྲལ་ཡང་བླའོ་སྙམ་དུ་བསམས་ནས།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་གཅིག་ཏུ་གནག་པ་རྣམས་ཀྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་ཞེས་བྱ་བ་ནས་དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟ་བུ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "བདག་ལ་ཕན་པ་དང་གཞན་ལ་ཕན་པར་ཞུགས་པ།",
    "ཆགས་པ་མེད་པར་ཡོངས་སུ་གཏོང་བ།",
    "དེ་ལྷག་པར་བྱམས་པ་ལ་ཤིན་ཏུ་གོམས་པས་དེ་ཉིན་གཅིག་ལ་ལན་གསུམ་བྱམས་པ་ལ་སྙོམས་པར་འཇུག་པར་བྱེད་དེ།",
    "དེ་བྱམས་པ་ལ་སྙོམས་པར་ཞུགས་པ་ན།",
    "སློང་བའི་སྐྱེ་བོས་ཕོངས་པར་གྱུར་ནས་དེས་བློན་པོ་རྣམས་ལ་བསྒོ་བ།",
    "ལྷ་བདག་ཅག་བཀྲེས་ལགས་ན་གཡར་ཟས་ཀྱིས་རྗེས་སུ་གཟུང་དུ་གསོལ།",
    "ཤེས་ལྡན་དག་བྲམ་ཟེ་འདི་རྣམས་ཁ་ཟས་བསོད་པས་ཚིམ་པར་བྱོས་ཤིག།",
    "བདག་ཅག་ནི་ཤ་དང་ཁྲག་འཚལ་ལགས་སོ།",
    "ལྷ་བཱ་རཱ་ཎ་སཱིའི་སྐྱེ་བོའི་ཚོགས་ཏེ་པོར་འགུམ་ལགས་སོ།",
    "ལྷ་བདག་ཅག་བཀྲེས་ལགས་ན་གཡར་ཟས་ཀྱིས་རྗེས་སུ་གཟུང་དུ་གསོལ།",
    "ཤེས་ལྡན་དག་བྲམ་ཟེ་འདི་རྣམས་ཁ་ཟས་བསོད་པས་ཚིམ་པར་བྱོས་ཤིག།",
    "ལྷ་བདག་ཅག་ནི་ཤ་དང་ཁྲག་འཚལ་ལགས་སོ།",
