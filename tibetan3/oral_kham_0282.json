    "འདུག་པའི་ཆེད་དུ་ས་ལས་བྱས་པའི་སྟེགས་བུ་གྲུ་བཞི་དག་དང་ཤིང་ལས་བྱས་པའི་ཁྲིའུ་ཡང་ངོ་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་དེ་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་ནང་དུ་འདུན་པ་ལེན་དུ་འོང་ན་ཡང་དེ་ལ་འདུན་པ་འབུལ་དུ་མི་རུང་ལ།",
    "ནམ་མཁའ་ལ་འདུག་པར་འདུག་པ་དང་འགྲོ་བར་མི་བྱའོ།",
    "མཚམས་ཀྱི་ནང་ན་འདུག་ན་ཞེས་སོ།",
    "གནས་དེ་ན་དགེ་སློང་རང་ཉིད་གཅིག་པུ་འབའ་ཞིག་ཡོད་ན་སྤྱོད་ལམ་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པའོ།",
    "དགེ་སློང་རང་ཉིད་མ་གཏོགས་པ་ལྷག་མ་ཟླ་བོ་དགེ་སློང་གཞན་གཅིག་དང་བཅས་པ་སྟེ་དགེ་སློང་གཉིས་འདུག་པ་ཉིད་ཡིན་ན་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཉེ་བར་ཙོག་ཙོག་པུར་ཕས་འདུག་ཚུལ་འདུག་སྟེ་གཅིག་ལ་གཅིག་བྱིན་གྱིས་བརླབ་བོ།",
    "གནས་དེ་ན་དགེ་སློང་གསུམ་ཡོད་ན་ནི་གསུམ་ཆར་འཁོད་དེ་འདུག་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གནས་དེ་རྣམས་མཛེ་ཅན་གྱིས་འདུག་ན་གཞན་ལ་གནོད་པའི་ཕྱིར་རོ།",
    "ཁ་ཏོན་དང་འདུག་པ་དང་།",
    "གནས་ཁང་ལ་ལར་སྔ་དྲོ་དང་དགུང་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་གནས་ཁང་ཐམས་ཅད་ལོངས་སྤྱད་པ་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "ལུང་དང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་བདག་གནས་པར་ཁས་བླངས་སམ་མ་བླངས་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བ་ཉིད་ལ་ནི་དབྱར་གནས་པར་ཁས་བླངས་པ་མི་འཇིག་གོ།",
    "དེང་སང་ནི་དགེ་སློང་གསུམ་གསུམ་གྱི་མདུན་དུ་འདུག་པར་བྱེད་དེ་ཚེགས་ཆུང་བར་བྱ་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་གང་ཟག་རྐྱང་པ་འཇོག་པ་དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ་ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པས་ཅི་ནས་ཀྱང་གང་ཟག་འཇོག་པར་བྱེད་ཅིང་གཞི་འཇོག་པར་མི་བྱེད་ཅིང་གཞི་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི་འདི་ཊཱི་ཀ།",
    "གསུམ་པ་གཞི་དང་གང་ཟག་གཉིས་ཀ་འཇོག་པ་དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ་ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པ་ཅི་ནས་ཀྱང་གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱིས་འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་པ་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་བརྗོད་པའི་འོ།",
    "མི་ཕན་ཏེ་དགེ་སློང་དེའི་སྲ་བརྐྱང་རང་འཇུག་བྲལ་གྱི་གནས་སྐབས་ཉིད་ལ་གནས་སོ།",
    "སྲིད་དུ་བཏང་བའི་ཚལ་བུ་རྣམས་ཀྱི་སྣ་མཐོ་དམན་དུ་འདུག་པས་སྣམ་ཕྲན་སྣྲེལ་གཞི་ཉིད་དུ་འགྱུར་བ།",
    "གང་ན་ནོར་རྫས་དེ་འདུག་པའི་མཚམས་དེར་གཏོགས་པ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "རྒྱ་ཅང་དམ་ནི་སྐུད་པ་མང་པོ་ལས་བཏགས་པ་ཉིད་དུ་དབུས་ཁོང་སྟོང་དུ་འདུག་པའོ་ཞེས་ཊཱི་ཀའོ།",
    "སྣམ་སྦྱར་དེ་ལ་དེའི་སྟེང་དུ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "གདོང་ཕྱིས་ལ་ཡང་ཆག་བྱ་སྟེ་ཊཱི་ཀའི་སྐབས་གཞན་ལས་གདོང་ཕྱིས་ཀྱིས་དྲིལ་ཏེ་བཅོམ་ཤིང་རང་ཆག་བྱའོ་ཞེས་སོ།",
    "འདུག་པར་མི་བྱའོ།",
    "མ་དྲས་པའི་སྣམ་སྦྱར་ཡོད་པས་ཀྱང་དེར་འཇུག་པ་དང་འདུག་པར་མི་བྱ་ན་སྣམ་སྦྱར་གཏན་ནས་མེད་པས་ལྟ་ཅི་སྨོས་སོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་སྣམ་སྦྱར་མེད་པའམ་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་སྔ་མ་དེ་བཞིན་ནོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་དག་འཁོད་ཅིང་མུ་སྟེགས་ཅན་ཉེ་བར་གནས་ན་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་འདུག་གནས་དེར་སྣམ་སྦྱར་མེད་པར་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "དགེ་ཚུལ་ལ་ཞིག་འོང་ན་ཡང་དེ་དེར་འདུག་ལ་ཟོ་ཞིག་ཅེས་ལུང་སིལ་བུ་ལས་སོ།",
    "དགེ་སློང་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "དུ་དོམ་ལྤགས་དེ་རྐང་པའི་གནས་སུ་གདིང་བ་དང་མཆིལ་ལྷམ་དག་ཏུ་བགོ་བ་དང་འདུག་པ་དང་ཉལ་བར་ཡང་བྱའོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "དགེ་སློང་དག་ཕྱིན་པའོ་ཞེས་སྨོས་ན་དེའི་དུས་ཀྱི་ཚིགས་ཅིས་བཟུང་ཞེ་ན་གནས་དེར་ཕྱིན་ནས་བྱ་བ་གཞན་ཆུ་བཙགས་པ་དང་གནས་ཁང་བསྐོ་བ་སོགས་བརྩམས་པ་དང་ངལ་བསོ་བ་ནི་སྟན་ལ་སོགས་པ་འདུག་པ་སྟེ་བྱ་བ་དེ་གཉིས་དངོས་ནི་ད་དུང་མ་བྱས་ལ་དེ་གཉིས་བྱ་བའི་མཚམས་ལ་ཐུག་པ་ཚུན་ཆད་ཀྱི་དུས་དེ་ནི་དགེ་སློང་དག་ཕྱིན་པ་ཉིད་ཀྱི་དུས་དེ་ཉིད་དོ།",
    "སྟན་གཞན་མེད་ན་རྩ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དུས་སྟོན་ཆེན་པོ་བྱུང་སྟེ་འདུས་པ་ཆེན་པོའི་ཚེ་དགེ་སློང་མ་རྣམས་རྒན་རིམ་བཞིན་དུ་འདུག་པ་ན་ཅ་ཅོ་འདོན་པར་གྱུར་ནས་འདི་གསུངས་སོ།",
    "སྒོའི་ལོག་གཅིག་ནང་དུ་སྣོལ་ལ་སྒོའི་ལོག་གཅིག་ཕྱིར་སྣོལ་ཞིང་སྒོ་དྲང་ཐད་དུ་མི་འདུག་པས་ནང་དུ་ཞུགས་པའི་མི་དེ་ཕྱི་རོལ་ནས་མི་སྣང་བ་དེ་ལྟར་སྒོ་གདོང་པར་བྱའོ།",
    "ལུང་ལས་འདུག་པ་ན་རྐུབ་རུས་ན་ན་ཐགས་མའི་སྤུ་གུའི་ཐན་ཀོར་འབོལ་བའི་ཕྱིར་དུ་ལོ་མའི་ཆངས་བུ་དག་གཞུག་གོ།",
    "གང་ཟག་ཇི་ལྟ་བུས་ཕྱིར་བཟློག་འཆགས་ཞེ་ན་འདུག་པའི་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་དང་།",
    "རབ་ཏུ་དབྱུང་བར་འདོད་པ་སྟེ་ཙོག་པུར་འདུག་སྟེའོ།",
    "མནན་ཏེ་འདུག་པར་བྱའོ།",
    "ཅི་བདེར་འདུག་ཏུ་གཞུག་པ་ཡིན་གྱི་ཙོག་པུར་འདུག་ཏུ་མི་གཞུག་གོ།",
    "ཙོག་པུར་འདུག་སྟེ་བརྗོད་པར་བྱའོ།",
    "གསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ།",
    "ཤིང་དྲུང་ལ་སོགས་འདུག་པའི་གནས་ཐམས་ཅད་ལ་བསླབ་པ་རྒན་རིམ་དུ་བསྐོ་བར་བྱའོ།",
    "གང་ཟག་དེ་ཚུལ་ཇི་ལྟར་འདུག་པ་ལ་བྱ་ཞེ་ན་ཆུ་བཅད་དེ་ས་ལ་བཀྲམ་པ་ལྟ་བུར་ལུས་ཐམས་ཅད་ས་ལ་འགྱེལ་བ་ལའོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ཉིད་ལ་འདུག་པར་བྱའི་དེ་ལས་གཞན་སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་ཡང་ངོ།",
    "སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་མི་བྱ་ན་སྟན་གཅིག་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ངོས་དང་སྟེང་གཡོགས་མ་གཅིག་ཏུ་ཉལ་བར་མི་བྱ་བས་དེར་མལ་བཤམ་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་གནས་པ་དེ་དང་བརྟེན་པར་ཏེ་འཇིང་པ་བསྒྲིལ་བར་མི་བྱའོ།",
    "གསོ་སྦྱོང་དང་དགག་དབྱེ་གཞག་པ་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྦྱོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གནས་གང་དུ་དུས་འདའ་བར་བྱ་བ་ངལ་བསོ་བའི་གནས་བསྟི་གནས་ལྟ་བུ་གནས་དབེན་པ་གང་ན་མི་མཐུན་པ་དགྲ་བོ་ཡོད་པ་དེ་དང་ལྷན་ཅིག་ཏུ་འཁོད་པ་འདུག་པ་དང་འགྲེང་བར་མི་བྱའོ།",
    "གནས་བརྟན་དེས་རྒོལ་ཕྱིར་རྒོལ་དེ་གཉིས་དང་ལྷན་ཅིག་འགྲེང་བ་དང་ལྷན་ཅིག་འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆག་པ་དང་གཏམ་འདྲེ་བ་དང་བག་ཕེབས་པར་སྨྲ་བ་ཡང་ངོ།",
    "རྒྱབ་ཀྱིས་ཕྱོགས་པ་མདུན་ཕར་ལ་ལྟ་བ་དང་ཁྱིམ་གཞན་ཁྱིམ་པའི་ཁྱིམ་ཊཱི་ན་འདུག་པ་དང་།",
    "ས་གཞན་ན་གནས་པ་དང་ཉམས་པ་ལ་སོགས་པ་བཅུ་གསུམ་སྔར་བསྟན་མ་ཐག་པ་དེ་རྣམས་ལས་ཁྱིམ་གཞན་ན་འདུག་པ་མ་གཏོགས་པ་གཞན་ཐམས་ཅད་ལ་ནི་ཁྱིམ་པས་ཀྱང་ཕྱག་མི་བྱའོ་རབ་ཏུ་བྱུང་བ་ཁྱིམ་གཞན་ན་འདུག་པ་དག་ལ་ཡང་ཁྱིམ་པས་ཕྱག་བྱའོ་ཞེས་ཊཱི་ཀ་ལས་སོ།",
    "ལྷོད་ཕབ་ཏུ་འདུག་པར་བྱའི་མ་བསྒོ་ན་ཙོག་པུས་སོ།",
    "འདུག་པར་བྱའོ།",
    "ལུང་ནོད་པར་བྱ་བའི་གཞུང་མང་བ་ཉིད་ཡིན་ན་གསར་བུ་དེས་ལྷོད་ཕབ་ཏུ་འདུག་པའི་ཕྱིར་ལུང་འབོག་པ་པོ་ལ་ཞུ་བར་བྱའོ།",
    "སེང་གེ་འདུག་ཏུ་རུང་བར་སྟེར་གྲུ་བཞི་པར་བི་བྱ།",
    "སེང་གེའི་ཁྲི་ལ་འདུག་པའི་མདུན་དུ་མེ་ཏོག་དང་བདུག་སྤོས་དགྲམ་ཞེས་འགྲེལ་ཆུང་ལས་སོ།",
    "ལུང་ལས་སྐར་ཁུང་དམའ་བར་གཏོད་པས་ཧ་ཅང་ཚ་བར་གྱུར་ནས་བཀའ་སྩལ་པ་སྐུར་ཁུང་དེ་དག་མ་མཐའ་དང་དགེ་སློང་འདུག་པའི་ཁྲི་ལ་སོགས་པའི་སྟན་གྱི་ཚད་དག་ཡ་མཐའ་ཐད་ཀར་བབ་པ་བྱའོ།",
    "ཁྲིའུ་ཁྲི་ཆུང་དུ་གྲུ་བཞི་ལ་གང་ཟག་གཅིག་ཁོ་ན་འདུག་པར་མི་བྱའི་གཅིག་གཉིས་ཡན་ཆད་མ་ཡིན་པས་འདུག་པར་མི་བྱའོ།",
    "གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་གཉིས་སྟན་གཅིག་ལ་འདུག་ཏུ་མི་རུང་ངོ་ཞེས་ལུང་ལས་སོ།",
    "ས་སྟེགས་སམ་ཤིང་ལེབ་བམ་རྡོའི་སྟེང་ན་ནི་ཁྱིམ་པ་དང་ཡང་ལྷན་ཅིག་ཏུ་འདུག་དུ་རུང་ངོ་ཞེས་ཊཱི་ཀ་ཆུང་ལས་སོ།",
    "སྤུ་གྲི་དང་རང་ཐག་ལ་སོགས་ལ་ཇི་ལྟར་སུ་སྔར་འོངས་པས་ལོངས་སྤྱད་པར་བྱ་བ་ཡིན་གྱི་བསླབ་པ་རྒན་རིམ་གྱིས་སྤྱད་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ་དང་པོར་སུ་འོངས་པ་དེ་ལ་གཡར་པོར་སྦྱིན་ནོ།",
    "གྲལ་ཐོབ་པ་ལས་གོང་དུའང་མི་འདུག་འོག་ཏུ་འང་མི་འདུན་བི།",
    "ཆར་པ་ཆད་ན་དྲུང་ན་འདུག་པའི་ཁྱིམ་དག་ཏུ་གདུགས་དེ་བཞག་གོ།",
    "དགེ་སློང་མ་དེས་དབྱར་ཁང་དེའི་ཕྱི་སྒོར་འདུག་པར་མི་བྱའོ།",
    "གོས་ཐམས་ཅད་ཕུད་དེ་གཅེར་བུར་མི་འདུག་ཁི་གོ།",
    "དགེ་སློང་མ་གོས་མེད་བྱ་བ་དེ་ལ་རྔུལ་གཟན་ནི་གཅེར་བ་བསྐྱབ་པའི་གོས་ཉིད་ཡིན་པས་དེས་རྔུལ་གཟན་གྱོན་ན་གཅེར་ཐེར་འདུག་པའི་ཉེས་པ་མེད་པ་ཡིན་ནོ།",
    "ཁོ་རང་ཐོབ་བྱེད་ཆོ་ག་ལ་བརྟེན་ནས་ཐོབ་པའི་སྡོམ་པ་ཡིན་པའི་ཕྱིར།",
    "ཁོ་རང་ཐོབ་བྱེད་ཀྱི་ཆོ་ག་ལ་བརྟེན་ནས་ཐོབ་པའི་སྡོམ་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ཁོ་རང་ཐོབ་བྱེད་ཆོ་ག་ལ་བརྟེན་ནས་ཐོབ་པའི་སྡོམ་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་ཁོ་རང་ཐོབ་བྱེད་ཆོ་ག་ལ་བརྟེན་ནས་བརྒྱུད་ནས་ཐོབ་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་འདྲའི་གཞུང་དོན་གྲུབ་འདུག་པའི་ཕྱིར་ཟེར་ན་མ་ཁྱབ་སྟེ།",
    "ཤཱ་རིའི་བུ་ཚུར་ཤོག་ཚངས་པར་སྤྱད་པ་སྤྱོད་ཅིག་ཅེས་པའི་ཚིག་དེ་ལྟ་བུ་ཡང་སྔོན་ཆོག་མཚན་ཉིད་པ་ཡིན་ཞེས་ཁས་ལེན་ནུས་འདུག་པའི་ཕྱིར་རོ།",
    "ཞེས་པའི་གཞུང་དོན་གྲུབ་འདུག་པའི་ཕྱིར་རོ།",
    "དཀའ་བ་སྤྱོད་པ་ལ་མ་ཞུགས་པའི་སྐབས་དེར་ཡང་དགེ་སློང་དུ་བཞག་འདུག་པའི་ཕྱིར་སྙམ་ན།",
    "རྩ་བཞི་སྤོང་བའི་སྡོམ་པ་ཡིན་དགོས་ཞེས་ཁྱེད་ཧབ་འགྲོས་པ་རྣམས་ཀྱིས་ཁས་བླངས་འདུག་པའི་ཕྱིར་རོ།",
    "དགེ་ཚུལ་དང་དགེ་སློང་ལ་དེ་འདྲ་མ་བཅས་འདུག་པའི་ཕྱིར་ཞེས་ལན་བཏབ་པ་དེ་དོན་ལ་གནས་ཀྱང་ཁ་ཆེ་བ་ནི་དེ་ལྟར་མི་འདོད་ཅེས་པའི་དོན་ཡིན་པ་ཡང་།",
    "འདུག་པའི་སྤྱོད་ལམ་དང་ལྡན་པའི་དགེ་སློང་དེ་ལས་དེའི་ཁ་སྐོང་དུ་མི་རུང་བའི་ཕྱིར།",
    "ས་ལ་འདུག་བཞིན་པའི་སྒོ་ནས་ལས་བྱེད་ན།",
    "ས་ལ་འདུག་བཞིན་པ་དེ་དག་ཁ་སྐོང་དུ་མི་རུང་བ་དང་།",
    "རྒྱལ་ཟླའི་མར་ངོའི་ཚེས་ཞག་བཅུ་བཞི་པ་བཅུ་གསུམ་པ་སོགས་ཁོ་རང་ཡིན་ཟེར་བ་ཙམ་ལ།",
    "བསྒྲུག་ཅིང་བསྡད་དགོས་བྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "ཚེས་ཞག་ང་དྲུག་ལས་མི་འདུག་སྟེ།",
    "གལ་ཏེ་རང་རང་ཐད་སོར་ཆད་ཀྱང་།",
    "ཞག་མི་ཐུབ་ཀྱི་ཞག་དྲུག་པོ་དེ་ཟླ་བ་རང་རང་དྲུག་པོ་དེར་ལྷག་ནས་བཞག་པའམ་ཟླ་བ་བཅུ་རྫོགས་རྗེས་ལྷག་པོར་ཞག་དྲུག་བསགས་ནས་འཇོག་པ་གང་ཡང་མ་ཡིན་གྱི།",
    "མགོ་ཟླ་དང་རྒྱལ་ཟླའི་མར་ངོའི་ཟླ་ཕྱེད་བར་ལ་ཟླ་བ་ཕྱེད་གཉིས་དང་ཚེས་ཞག་ལྷག་པོ་གཅིག་འབྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ནས་དེའི་བར་ལ་ཉིན་ཞག་དྲུག་བཅུ་ལྷག་ཙམ་ཡང་འཕེལ་འདུག་པའི་ཕྱིར་རོ།",
    "དེས་དགུན་ཉི་ལྡོག་དུས་དངོས་སུ་བསྟན་པའི་ཕྱིར།",
    "དེའི་ཕྱི་ཉིན་ཚེས་བཅུ་དྲུག་ནས་སྲ་བརྐྱང་འདིང་རྒྱུ་ཡང་མ་བྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཁྱེད་རང་ལ་མི་འགྲིག་སྟེ།",
    "སྟོན་ཉིན་མཚན་མཉམ་པ་དེ་ཟླ་བ་དེའི་ནང་ཁོ་ནར་ངེས་པའི་ཕྱིར་ཞེས་ཚིག་ཟིན་ལ་ཞུགས་འདུག་པའི་ཕྱིར་རོ།",
    "གཞུང་དེས་དབྱར་ཉི་ལྡོག་དུས་དངོས་སུ་བསྟན་པའི་ཕྱིར།",
    "གཞུང་དེས་དགུན་ཉི་ལྡོག་དུས་དངོས་སུ་བསྟན་པའི་ཕྱིར།",
    "ཡུལ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "ཁྱེད་རང་ལ་ནང་འགལ་ཏེ།",
    "ཟོས་ཀྱང་རུང་ངོ་ཞེས་བསྟན་འདུག་པའི་ཕྱིར་དང་།",
    "ཕ་རྣམ་དག་ལྟ་བ་ཐ་དད་ན་ཕན་ཚུན་བྱིན་ལེན་ཆགས་པས་བསྟན་འདུག་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་རྣམས་ལ་ཤིན་ཏུ་གུ་ཡངས་ཀྱི་ཕན་ཡོན་ཆེ་བར་འདུག་གོ།",
    "མ་བཏུབ་ན་དེ་ཉིད་ཟས་པས་ཆོག་གོ་ཞེས་གནང་འདུག་པའི་ཕྱིར་རོ།",
    "ཁར་མིད་པ་མ་ཡིན་པ་ཁ་གཤལ་བའི་ཆུ་ལ་བྱིན་ལེན་མི་བྱེད་ཅེས་འབྲུ་སྣོན་གནང་འདུག་མ་གཏོགས་སོ།",
    "གནས་གང་ན་ཁུར་རྩ་བ་འདུག་པ་དེར།",
    "དེ་ཡོལ་གང་ཞིག་དུས་མིན་ཟ་བྱེད་པ།",
    "དེ་ཡང་ཁྱེད་རང་གསོལ་ཅིག་བདག་མི་ཟའོ་ཞེས་དང་།",
    "ཙོག་པུར་འདུག་སྟེ།",
    "ཞེས་འདུག་ས་ཡང་ཡང་སྨྲོས་ནས་ཟོས་པའི་དགེ་སློང་དེའི་དྲུང་དུ་ལྷག་བོར་བྱ་བ་མ་ཡིན་ཏེ།",
    "བྱིན་ལེན་མ་བྱས་པ་ནི་རུང་བ་ཚད་ལྡན་གྱིས་ཀྱང་རང་སྟོབས་ཀྱི་ཉེས་པ་དེ་སྐྱེད་པའི་ཕྱིར་སྙམ་དུ་ཁོ་བོ་སེམས་སོ།",
    "དེ་ཁོ་ཁོ་རང་རང་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་ཏུ་འཇུག་སྟེ།",
    "སྒྲ་དྲང་ཐད་དུ་བསྒྱུར་ན་བདག་ཉིད་སྨྲ་བར་བྱེད་དོ་ཞེས་པ་སྟེ་ཁོ་རང་སྨྲ་ཞེས་པ་ཡིན་ནོ།",
    "དེའི་ལུགས་ལ་ཞུ་བ་པོས་ཀྱང་ཙོག་ཙོག་པོར་འདུག་སྟེ།",
    "ལྷག་པོར་ཡང་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་སྟེ་ཞེས་པས་སོ།",
    "དེའི་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "འདུན་དུ་ཙོག་ཙོག་པོར་འདུག་ཏུ་གཞུག་སྟེ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ཡིན་པས་ཚོགས་ཀྱི་ཁ་སྐོང་བར་མི་བྱའོ།",
    "འདུག་པར་བྱའོ།",
    "དེའི་ལན་གདབ་པ་དང་བསྙེན་པར་རྫོགས་པའི་དངོས་གཞི་ལ་སྐབས་ཐམས་ཅད་དུ་བསྒྲུབ་བྱ་དེ་ཡུན་རིང་པོར་ཙོག་ཙོག་པོར་འདུག་པ་སྡུག་བསྔལ་བས།",
    "དེ་ལ་རྟིང་པ་གཉིས་ཀྱིས་བསྣུན་པས་ཙོག་ཙོག་པོར་འདུག་ཏུ་བཅུག་སྟེ།",
    "འདུག་པའི་ཚེ་མགོ་རྒྱབ་ཏུ་སྟན་ལ་གདིང་ངོ།",
    "སྤྱོད་ལམ་འདི་ལྟར་བྱ་སྟེ་འདུག་ལ་ཞེས་པས།",
    "ལས་བརྒྱ་རྩ་གཅིག་པོ་ཐམས་ཅད་འདུག་པའི་སྤྱོད་ལམ་གྱི་བྱ་ཡི།",
    "འགྲོ་འཆག་ཉལ་འདུག་འགྲེང་སྤྱོད་ལམ་བཞིས་ནི་མི་བྱའོ་ཞེས་སྤྱིར་བསྟན་པའོ།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བ་དེ་བདག་ལ་ཕྱག་གསུམ་འཚལ་དུ་བཅུག་ནས་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་ཏུ་བཅུག་སྟེ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་སོགས་པའི་དྲུང་དུ་བསླབ་པ་ལེགས་པར་ཕུལ་ལམ།",
    "འདི་མན་ཆད་ལ་འགྲེལ་པ་མི་འདུག་ནའང་།",
    "དེ་ནི་དེས་པའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་བརྗོད་པར་བྱའོ་ཞེས་དང་།",
    "འདུག་ཏུ་གཞུག་ཅིང་འདུག་ཏུ་བཅུག་ནས་བསྙེན་པར་རྫོགས་པ་གསོལ་དུ་གཞུག་གོ།",
    "དགེ་སློང་ཉིད་རྫོགས་པ་དང་ཉེ་བར་བསྙེན་པའི་ངོ་བོར་འདུག་པའི་ཕྱིར་རྫོགས་པར་བརྗོད་པར་བྱ་བར་ཤེས་པ་བྱ་སྟེ།",
    "སྤྱོད་ལམ་མི་མཐུན་པ་ལ་ལ་འདུག་པ།",
    "བདེ་བ་འདོད་ཀྱང་རང་བློ་འཁྲུལ་གྱུར་ཏེ།",
    "དུར་ཁྲོད་འཇིགས་སུ་རུང་བ་ཞིག་དེ་ན་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ངེད་ཀྱི་ཚིག་རིས་ལྟར་ལུས་ལ་ཐ་མལ་གྱི་སྣང་བ་བསལ་ཏེ་འོད་གསལ་དུ་བཅུག།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "རྗེ་བཙུན་མ་སྒྲོལ་དཀར་ཡིད་བཞིན་འཁོར་ལོ་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཐིམ་པས་སྒྲོལ་དཀར་ཡིད་བཞིན་འཁོར་ལོའི་སྐུ་གསུང་ཐུགས་དང་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དབྱེར་མེད་དུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་ངེད་ཀྱི་ཚིག་རིས་ལྟར་ལུས་ལ་ཐ་མལ་གྱི་སྣང་བ་བསལ་ཏེ་འོད་གསལ་དུ་བཅུག།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་མཛད་པར་ཞུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ལྟར་ཁྱེད་རང་རྣམས་ཀྱིས་རྗེ་བཙུན་སྒྲོལ་མའི་སྐུ་གསུང་ཐུགས་ཀྱི་རྗེས་གནང་ཐོབ་ནས་རྗེ་བཙུན་སྒྲོལ་མའི་སྐུ་གསུང་ཐུགས་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོའི་གཙུག་བ་སྤུའི་བུ་ག།",
    "ཁྱེད་རང་རྣམས་ཐུགས་བསམ་འདི་བཞིན་དུ་མཛོད།",
    "སྟོང་པའི་ངང་ལས་པད་དཀར་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཧཱིདཀར་པོ་སྟེ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྣ་བུག་གཡོན་ནས་ཞུགས།",
    "ད་ཁྱེད་རང་རྣམས་ཐུགས་བསམ་འདི་བཞིན་དུ་མཛོད།",
    "ཁྱེད་རང་རྣམ་པའི་ལུས་ལ་རྡོ་ཚན་ལ་ཁ་བ་བབས་པ་བཞིན་དུ་ཐིམ།",
    "ཞལ་ནས་འཐོན་ཁྱེད་རང་རྣམས་མགོན་པོར་གསལ་བའི་མགོན་པོ་ཡིད་བཞིན་ནོར་བུའི་རྗེས་གནང་བྱ་ཚུལ་དངོས་གྲུབ་ཀུན་འབྱུང་།",
    "མཆོད་གཏོར་གཏང་རག་དུས་སུ་ཆག་པ་བཤགས།",
    "རང་རང་ལས་ལ་སྤྱོད་པ་ཉིད་ཡིན་གྱི།",
    "དེ་ཡང་རང་ཉིད་ཀྱི་ཐུགས་ཉམས་སུ་ཐང་ལྷོད་མེད་པར་བསྟར་ཞིང་གདུལ་བྱ་ཉེ་རིང་མེད་པ་འགོད་པ་ལ་འཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པ།",
    "ཡིད་སློང་སློང་པོར་འགྱུར་བ་ཞིག་ནི་འཆར་དཀའ་བ་འདུག།",
    "ཐོས་དོན་ཡང་རང་འཁོས་དང་བསྟུན་པའི་དགེ་སྦྱོར་དང་འབྲིས་ཐབས་ལ་འབད་པ་དང་།",
    "ངེས་པར་ད་ནི་གང་ནས་བསམས་ཀྱང་དོན་མེད་ཀྱི་འགྲོ་འདུག་སོགས་བྱ་བ་དང་།",
    "དཔྱད་བཟོད་མི་བཟོད་དང་རང་རྩོམ་དང་།",
    "དེ་ཡང་གཞན་དུ་བསྒྱུར་མི་བཏུབ་ཅིང་མི་སྨོན་པར་སྐྱོན་ཡོན་ཤེས་པའི་བློ་གྲོས་དང་རང་ཚུགས་ཐུབ་པའི་གྱོང་ཤ་དང་བཅས་པ་ཞིག་མ་བྱུང་ན།",
    "རྒྱལ་བའི་བཀའ་ལས་ཡི་གེ་ན་གཅིག་ཀྱང་འདོར་ཏུ་མེད་པར་གདམས་ངག་ཏུ་གོ་བ་ལ་བྱེད་ཟེར་བས་དེ་ཤིན་ཏུ་ཡིན་པར་འདུག་གསུངས་པ་ལྟར་ཏེ།",
    "ཧ་དཔྱད་ན་མི་གདའ་ཇི་ལྟར་ལགས།",
    "དེ་ཉིད་སྦས་པའི་རྣལ་འབྱོར་པ་ཞིག་ཡིན་འདུག་ཅིང་།",
    "གླེགས་བམ་དེ་སྐབས་སུ་མ་བབ་པ་སུ་ཡིན་གྱིས་མདུན་དུ་ཡོད་ཀྱང་མི་མཐོང་བ་ཞིག་ཡིན་སྐད་མ་ཐོས་སམ་ཞེས་གསུངས་ནས་ཞལ་གྱིས་བཞེས་པར་མི་མཛད་འདུག།",
    "ཞེས་གསུངས་འདུག་ཅིང་ཁོང་ཉིད་ཀྱིས་ཀྱང་།",
    "བར་འདིར་པཎ་ཆེན་འཇིགས་མེད་གྲགས་པ་ཟེར་བ་ཞིག་འདུག།",
    "ཚུལ་འདི་བསམ་ཞིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "གཞན་ཡང་དེ་སྐོར་གྱི་ཁྲིད་ཕྲན་འགའ་ཞིག་གསན་འདུག་ཀྱང་བརྒྱུད་ཁུངས་ནི་མ་རྙེད་དོ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་ལུང་རྗེས་གནང་།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "བེ་རོ་ཙ་ནའི་མན་ངག་ཨི་ཐོའི་མཐའ་ཅན་རྣམས་ཀྱི་ལུང་ཐོབ།",
    "དམིགས་བརྩེ་མའི་ལས་ཚོགས་བཞེས་འདུག་པ་འདིའི་མིང་མ་བཀོད་སྣང་བ་བཞིན།",
    "འཇིགས་བྱེད་ཀྱི་རྫོགས་རིམ་བཀའ་རྒྱ་མ་ཞི་ཁྲོ་སྦྲགས་སྒྲུབ་དང་བཅས་པ་བཞེས་འདུག་པ་ལྟ་བུ་དང་།",
    "ད་ནི་མི་རན་དགུ་རན་དུ་འདུག་གོ།",
    "ཐ་དད་ཡུལ་ན་མི་འདུག་རང་སེམས་དང་ལྷན་སྐྱེས།",
    "དེ་ཡང་ངོ་བོས་སྟོང་ཡང་རང་བཞིན་གསལ།",
    "འཁྲུལ་སྣང་རང་ཤར་རང་གྲོལ་དབྱིངས་སུ་ཐིམ།",
    "སརྦ་མངྒ་ལཾ། ། རྫོགས་པ་ཆེན་པོ་ལྟ་བ་གཅེར་མཐོང་རང་གྲོལ་ཞེས་བྱ་བ།",
    "རིག་པ་གཅེར་མཐོང་རང་གྲོལ་མཁྱེན་ལགས་སམ་། ཕྱི་རོལ་སྣང་བའི་ཡུལ་ལ་ཕར་བརྟགས་པས།",
    "ཤར་ཡང་རང་ཉིད་དྲན་པར་གནས་འགྱུར་ཏེ།",
    "བཤིག་ན་རང་རང་འདོགས་བྱེད་ལ།",
    "འགྲོ་བ་སྒྲོལ་བའི་སླད་དུ་གདུལ་བྱ་རང་རང་དང་རིགས་མཐུན་པའི་སྐུར་སྣང་བས།",
    "དོན་དུ་སྤྲོས་བྲལ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་ཡོད་པ་མ་ཡིན་པས།",
    "ང་ཡེངས་འདུག་སྙམ་པའི་འགྱོད་པ་དང་།",
    "རང་བྱུང་རང་ཤར་སྒོམ་གྱི་མཆོག།",
    "ཐམས་ཅད་མཁྱེན་པ་བེ་རོ་ཙ་ནས།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཀུན་ཏུ་ལྷུག་པར་ཞོག།",
    "རྣམ་རྟོག་མ་སྤང་རང་སར་དག།",
    "གཞན་གྱི་སྡུག་བསྔལ་ཀུན་འབྱུང་རང་ལ་བླངས།",
    "དེ་འདྲ་ལ་དགོངས་པ་གནང་ཆོག་མཁན་དེ་ཤཱཀྱ་ཐུབ་པའི་གྲལ་མགོར་སྡོད་མཁན་ཞིག་ལོས་ཡིན།",
    "ཅེས་པ་དེ་གདའ་བས་མ་ཎི་འདོན་པ་ལས་འོས་ཅི་ཡོད།",
    "ཡིད་བཞིན་ལེགས་གྲུབ་གསུང་སྐད་དང་སྐུ་གཟུགས་བཟང་བས་ལྟར་སྣང་ཅི་མཛེས་གཙོ་བོར་བཏོན་པ་ཡིན་སྙམ་པ་གདའ་སྟེ།",
    "འཇིག་རྟེན་མིག་གཅིག་བེ་རོ་ཙ་ན་སྐ་ཅོག་ལ་སོགས་ལོ་པཎ་དང་།",
    "བེ་རོ་ཙ་ན་སོགས་འབངས་རིགས་གྲུབ་ཆེན་ཉེར་ལྔ།",
    "ཟུར་མཁར་ཨ་ཇོ་དཔལ།",
    "བྱང་གཏེར་ཀ་དག་རང་བྱུང་རང་ཤར།",
