    "མགུལ་བ་ཁྲམ་གཉེར་དུ་འདུག་པ་ཤིང་ཏ་ལའི་གཉེར་མ་ལྟ་བུ་དང་།",
    "ཚིག་ཏུ་སྨྲས་པ་དེ་ཁོ་ན་ལས་བསླབ་པ་དབུལ་བར་འགྱུར་བར་མ་ཟད་ཀྱི་ཚིག་ཏུ་མ་སྨྲས་པར་གཏོང་བའི་མཚན་མ་ལས་ཀྱང་ཕུལ་བར་འགྱུར་ཏེ་དེས་ན་ལུས་ཀྱི་རྣམ་པར་རིག་བྱེད་ལས་ཕུལ་བར་འགྱུར་ཞེས་ཊཱི་ཀ་དང་རང་འགྲེལ་ལས་ཀྱང་ངོ།",
    "དགེ་སློང་བསྲུངས་པ་ནི་གསུམ་སྟེ་སྒོ་བཅད་ཅིང་ལུང་རྣམ་འབྱེད་ལས་སྒོ་སྒོ་གཏན་གྱིས་བཅད་ཅེས་སོ་རྣམ་འབྱེད་འགྲེལ་ལས་སྒོ་གཏན་ཞེས་བྱ་བ་ནི་སྒོ་ལྕགས་ལ་སོགས་པའི་ཞེས་སོ་འགྲེལ་ཆུང་ལས་ཁང་པ་ལྟ་བུས་མཐའ་བསྐོར་ཅིང་འདུག་པ་ལ་སྒོ་གཏན་ལ་བཅུག་སྟེ་ཉལ་ན་ཉེས་མེད་དོ་ཞེས་སོ།",
    "མུ་ཏིག་ཆུན་པོ་ལ་སོགས་རྩྭ་བཏིང་བའི་སྟེང་ན་འདུག་པ་ལ་རྩ་ཁ་དོག་གཅིག་པ་ཡིན་ན་ཕྱོགས་གཅིག་པར་བརྗོད་པར་བྱའོ་རྩྭ་ཁ་དོག་ཐ་དད་པ་ཡིན་ན་ཕྱོགས་ཐ་དད་པར་བརྗོད་པར་ལུང་བྱའོ།",
    "ཐོག་མ་འདུག་པའི་གནས་མི་སྣང་བར་གྱུར་ན་ལམ།",
    "ཕ་རོལ་གྱི་འགྲམ་དུ་མ་ཕྱིན་ཀྱང་ཐོག་མ་འདུག་པའི་ས་མི་སྣང་ན་བི་ཕམ།",
    "གང་ན་གྲུ་ཕུར་པ་ལ་བརྟོད་ཅིང་འདུག་པའི་གནས་དེ་ནས་ཁྲིད་དེ་ཕ་རོལ་ཏུ་བསྒྲལ་བའི་ཕྱིར་ཚུ་རོལ་ཏུ་བཏང་བའི་གནས་སུ་གྱེན་ལ་འཁྲིད་པར་བྱེད་པའི་ཕྱོགས་དེ་ནི་གྲུ་ཚུགས་ཞེས་བྱའོ།",
    "ནོར་མང་པོ་ཞིག་འདུག་པ་ལ་གདམ་སྟེར་གང་བཟང་པོ་དེ་རྐུ་བར་འདོད་པས་ཊཱི་གདམ་པ་ལ་ཡང་ངོ།",
    "རྩིས་བྱེད་པ་ལྟ་བུ་ལ་བཅུ་ཁྲམ་དང་བརྒྱ་ཁྲམ་དང་ཡིག་འབྲུ་ལ་སོགས་པ་གླེགས་བུ་ལ་བྲིས་ཏེ་བཞག་པ་ན་བདག་རྒྱལ་བར་བྱ་བའི་ཕྱིར་བཅུ་ཁྲ་མ་དང་བརྒྱ་ཁྲམ་ལ་སོགས་པའི་མཚན་མ་ཕྱིས་པ་མེད་པར་བྱས་པ་དང་མཚན་མ་བསྣན་པ་ལྷག་པར་བསྣན་པ་གཉིས་དང་མཚན་པ་གནས་གཞན་དུ་ལྟག་འོག་སྣོར་ཅིང་བཞག་པ་ཡང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་དེ་ཉིད་ཡིན་ཏེ་སྦྱོར་བ་དེའི་སྐྱོང་བ་སྟེ་ཉེས་བྱས་ཉིད་དོ།",
    "མི་གཞན་ལ་འདི་ལྟར་བྱས་ན་ཕམ་པར་འགྱུར་བས་དགེ་སློང་རང་ཉིད་གཡང་ས་ནས་མཆོང་པ་དང་།",
    "རྣམ་འབྱེད་འགྲེལ་ལས་རྡུལ་ཁྲོད་ཀྱི་ཤ་ཟ་ནི་ཕྱག་དར་ཁྲོད་ཀྱི་འདྲེའམ་ཚུབས་མའི་ནང་ན་འདུག་པའི་འདྲེའོ་ཞེས་སོ།",
    "ཁྱིམ་དུ་ཞུགས་ཤིག་སྟན་ལ་འདུག་ཅིག་ལག་ཆུ་བཟེད་ཅིག་བཟའ་བ་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ལ་བརྟེན་པ་སྟེ་དེ་དག་དང་ཉེ་བར་གྱུར་པ་ཉིད་དང་།",
    "ལོ་དྲུག་སྟན་གྱི་གནང་བ་གསོལ་བ་ན་སྟན་སྔ་མ་རྙིང་ཞིང་བཅོས་དཀའ་བ་ཉིད་ཡིན་ནམ་མ་ཡིན་བརྟག་པ་ལ་ཡང་རང་དག་རྟོག་ཏུ་འདོང་བར་བྱའོ་ཡང་ན་དགེ་སློང་བསྐོས་པ་དག་གོ་ཞེས་དེ་བཞིན་ནོ།",
    "གདིང་བ་བརྙར་མ་རྙེད་ན་བླ་གོས་སྣམ་ཕྲན་བདུན་པ་བཞི་ལྟབ་ཏུ་བྱས་པའི་སྟེང་དུ་མཚན་ཐོག་ཐག་ཏུའམ་ཞེ་ན་ཡུན་རིང་དུ་མི་ཉལ་ཡུན་ཐུང་ངུ་ནི་ཉལ་ཊཱི་བར་བྱ་ནམ་གྱི་སུམ་ཆ་དགུང་ཐུན་ལ་ཉལ་བར་བྱའོ་སྲོད་དང་ཐོ་རངས་ནམ་གྱི་སུམ་གཉིས་ཀྱི་བར་དུ་བཅག་པའམ་ཙོག་པུར་འདུག་ལ་ཁ་ཏོན་བྱའོ།",
    "ཡང་ན་བྱ་གག་ཁྱིམ་བྱ་དེ་ཕོ་སྦར་འཕུར་དུ་བཅུག་ནས་ས་ལ་བབས་ཏེ་འདུག་པའི་ལམ་གྱིས་ཇི་ཙམ་དུ་ཁྱབ་པ་ཉེ་འཁོར་ཡིན་ནོ་དེ་ལ་འདོམ་དགུའོ།",
    "འདུག་པ་ཕྱིར་འོང་བ་ན་ཁལ་འབོག་པ་ལྟ་བུ་དང་།",
    "༧གནས་ཀྱི་བདག་པོ་ཐ་དད་པའི་མཚམས་གཞན་ནམ་མཁའ་འམ་ཆུས་པར་དུ་ཆོད་པའི་མཚམས་གཞན་ནི་དྲུང་ན་འདུག་ཀྱང་ཉེ་འཁོར་མ་ཡིན་ནོ།",
    "གཞན་དུ་འདུག་ན་ཉེས་བྱས་སུ་འགྱུར་ཊཱི་རོ།",
    "དབེན་པ་དེར་དགེ་སློང་མ་མི་འདུག་ན་དགེ་སློང་མ་གཞན་རྣམས་ཀྱིས་ཡལ་བར་མི་དོར་རོ།",
    "གནོད་པ་མི་བྱ་བར་མི་བཏུབ་ན་ཁ་བཙུམ་སྟེ་འདུག་གོ།",
    "འདུག་པའི་ཁྲིའུ་དང་།",
    "དགེ་སློང་གནས་ནས་འཕགས་པར་འགྱུར་བ་ན་གནས་མལ་སྡུད་ཅིང་བསྡད་ན་མགྲོན་པའི་རྗེས་མ་སླེབས་ནས་ཆོམ་རྐུན་པས་བཅོམ་པ་ལ་སོགས་པའི་རྐྱེན་ཉམ་ང་བ་དང་ཕྲད་པར་མི་འགྱུར་བ་ལྟ་ན་གནས་མལ་སྐྱབས་ཡོད་པའམ་བླ་གབ་མེད་པ་ན་འདུག་ཀྱང་རུང་སྟེ་བསྡུ་བར་བྱའོ།",
    "གང་དུ་འདུག་པའི་གནས་སྐྱེ་བོའི་རྒྱུན་ལུགས་མེད་པ་ཉིད་ཀྱིས་ས་ཕྱོགས་དབེན་པ་ཉིད་དང་།",
    "འདུག་པ་དེ་ནི་རྐུབ་ཚོས་ཙམ་ས་ལ་བཞག་པའོ།",
    "འདུག་པ་ལའོ་ཞེས་སྔར་སྨོས་པ་ལས་འདིར་ཁྱད་པར་ནི་དགེ་སློང་དང་དགེ་སློང་མ་གཉིས་ཀ་འགྲེང་བ་ལའོ།",
    "དགེ་སློང་དེའི་ཉེ་དུས་བརྩིག་ཏུ་བཅུག་པའི་འདུག་གནས་ཉེ་དུ་བདག་པོ་ཡིན་པ་དེར་ཞག་གཅིག་ལས་ལྷག་པར་གནས་ཤིང་བསོད་སྙོམས་གཅིག་ལས་ལྷག་པར་ཟོས་ན་ཡང་ཉེས་བྱས་སོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ལངས་པའོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ལངས་པའོ།",
    "འཚེད་པར་བྱེད་པའི་གང་ཟག་དང་བཙོ་བར་བྱ་བའི་རྫས་གཉིས་ཀ་མཚམས་ནང་ན་འདུག་པ་ཁོ་ནར་མ་ཟད་དོ།",
    "བཙོ་བར་བྱ་བའི་རྫས་དེ་མཚམས་ཀྱི་ཕྱི་རོལ་ཏུ་འདུག་པ་བཙོས་ན་འཚེད་པར་བྱེད་པའི་མི་དེ་མཚམས་ཀྱི་ནང་དེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་རྫས་དེ་མཚམས་ཀྱི་ནང་དུ་བཙོས་པར་མི་འགྱུར་རོ།",
