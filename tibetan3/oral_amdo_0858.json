    "གྱེན་དུ་འགྲོ་བ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏེ་ཤིན་ཏུ་གླུ་དང་རོལ་མོ་ལ་སོགས་པའི་སྒྲའི་དུས་རྣམས་སུ་སྤྲོ་བའི་སེམས་ཀྱིས་སྦྱོར་བ་འདི་བསླབ་པར་བྱ་སྟེ་སྟེང་དང་འོག་ཏུ་སྤྲད་པས་སྲོག་ལ་སོགས་པ་ནང་དུ་ཐིམ་པར་བྱས་ནས་དབྱུ་གུ་དང་དབྱུ་བྱེད་གུ་གཉིས་ཀྱི་བར་དུ་ཡང་དག་པར་གྱེན་དུ་འགྲོ་བའོ།",
    "ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཚིག་གིས་ཀྱང་ངོ།",
    "སླར་ཡང་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་འབབ་པ་ལ་ཡང་དགའ་སྟེ་དེའི་དེ་ལྟར་སྦྱོར་བས་ཟུང་གི་ཡེ་ཤེས་སྐྱེའོ།",
    "དེ་ལ་ཟུང་གི་གཟུགས་ཀྱང་རྣལ་འབྱོར་པ་ཟུང་གི་འཇིག་རྟེན་པའི་ཡང་དེ་ཉིད་དེ་ལྟར་དུའོ།",
    "ལྷ་མོ་རྡོ་རྗེ་ཕག་མོ་ནི།",
    "རྡོ་རྗེ་ཕག་མོ་ཐམས་ཅད་ཀྱི།",
    "རྨོངས་མ་རང་གི་རིགས་༡ལས་སྐྱེས།",
    "སྲུང་བའི་རོ་ཀུན་བདག་གི་སོགས།",
    "འདོད་ཆགས་མེ་ཞེས་བྱ་བ་ནི་གཏུམ་མོའི་ཡེ་ཤེས་ཀྱི་མེས་འབར་ཞིང་གསལ་བར་གྱུར་པའི་འོད་ཟེར་དེའི་འོད་ཟེར་ནི་ཡེ་ཤེས་ཀྱི་འོད་རྩེ་མོར་སོན་པའོ།",
    "དེ་ལྟར་འདིའི་ཤེས་རབ་རྨོངས་བྱེད་མ་དེ་ཡང་ཁའི་པདྨར་མགྲིན་པའི་སྟེང་གི་གཙོ་མོའོ།",
    "དབྱེ་བའི་ཚིག་གིས་མྱང་བར་བྱ་སྟེ་རོ་ཐམས་ཅད་ལ་ཞེས་བྱ་བའོ།་།",
    "བདག་གི་ཞེས་བྱ་བ་ནི་དེ་ལྟར་དེས་ཡེ་ཤེས་ལྡན་པ་ཡང་མེད་པའོ།",
    "དེའི་ཕྱིར་དེ་མི་མཐུན་ཏེ་ཡེ་ཤེས་མེད་ཅིང་ཡེ་ཤེས་དང་ལྡན་པ་ཡང་མེད་ཅེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "ཧེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏེ་འདིའི་ཧེ་རུ་ཀའི་མིང་གི་ཡི་གེ་རྣམས་ཏེ།",
    "འདི་ལྟར་ཏེ་ནི་སེམས་བདག་ཉིད་རྣལ་འབྱོར་ཞེས་བྱ་བ་ནི་སེམས་ཀྱིས་ཡོངས་སུ་བསྒོམས་པའི་རྣལ་འབྱོར་གཞོམ་དུ་མེད་པའི་སེམས་ཀྱི་རྒྱུས་རང་ཉིད་འཇིག་རྟེན་ལ་གནས་ནས་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་ཏེ་རང་འབྱུང་གི་ཡེ་ཤེས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅེས་བྱ་བ་ནི་སླར་ཡང་གི་སྒྲས་རྣལ་འབྱོར་སྟོན་པའི་ཚིག་གོ།",
    "སྔགས་ཀྱི་ཚིག་བརྗོད་པ་རྣམས་སུ་རྣལ་འབྱོར་དེ་ཉིད་རང་གིས་རིག་པའི་ཡེ་ཤེས་མིའི་འཇིག་རྟེན་ཏེ་ཛྭ་རྣམས་ཀྱི་སྐྱེ་བ་དང་ཟད་པའི་རྒྱུ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "ས་འོག་གི་འཇིག་རྟེན་རྣམས་སུ་ཕྱོགས་རྣམས་ཀྱིས་གནས་ལ་ལྟ་བས་སོ།",
    "གང་གི་ཕྱིར་དེའི་བདེ་བ་ནི་ལུས་ངག་ཡིད་ཀྱི་རང་བཞིན་གྱི་ས་འོག་ས་སྟེང་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་ཅན་ཏེ་དེའི་ཕྱིར་བདེ་བའི་ཐོག་མཐའ་དབུས་སུ་ནི་ཞེས་བྱ་བ་ནི་སྔགས་ཀྱི་ཡི་གེ་རྣམས་ཀྱིས་བསྲུང་བར་བྱ་སྟེ།",
    "དེ་ལྟར་ཡི་གེ་གསུམ་པོ་དེས་ལྟེ་བའི་འོག་གི་རྩ་གསུམ་སྟེང་དུ་ཁ་བལྟས་པ་རྣམས་སོ།",
    "དེ་ལྟར་ཧྲོ་གི་ཡི་གེ་ནི་སྟེང་དུའོ།",
    "ཧྲི་གི་ཡི་གེ་ནི་འོག་ཏུའོ།",
    "གཉིས་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཅན་གྱེ་ཡིད་ཀྱིའོ།",
    "ཀུན་དུ་བསྐྱོད་མའི་ནི་ལས་ཞེས་བྱ་བ་ནི་རྣམ་པ་སྣ་ཚོགས་པ་རང་གི་སེམས་གཡོ་བའི་ཕྱིར་དེའི་མི་གཡོ་བ་ཀྲུཉིད་ཀྱིས་དང་།",
    "ལས་རྣམས་སུ་ལུང་གི་སྒོར་བསྟན་པ་ཉིད་ནི་ཀུན་བསྐྱོད་མ་ལྟ་བུའོ།",
    "དེ་ལྟར་ཡང་རེ་རེ་ལ་རྣམ་པ་གཉིས་རབ་ཏུ་གསུངས་ཏེ།",
    "ཚོར་བ་དང་ཉོན་མོངས་པ་དེ་བཞིན་ནོ།",
    "དེ་ཀུན་སོང་བའི་བདག་ཉིད་དུ།",
    "ཉོན་མོངས་ཀྱང་ནི་ཀུན་ཕུན་ཚོགས།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ཀྱི་བཅུ་དྲུག་ཅེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་བཅུ་དྲུག་གི་དབྱེ་བས་སོ།",
    "ཞེས་བྱ་བ་ནི་རྩ་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་གཉིས་རྣམས་ཀྱི་རྩ་བ་ནི་གཙོ་བོའི་རྩ་སྟེ་བདུན་ཅུ་༥རྩ་བྱེད་གཉིས་པོ་རྩ་སྟོང་ཕྲག་སོ་སོ་རེ་རེ་ཡང་ངོ།",
    "ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་ཧེ་རུ་ཀའི་རྣམ་པས་སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པའི་དབུས་སུ་བཞུགས་པ་དེའི་ཚེ་སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པ་ངེས་པར་སྟོན་པའི་དོན་དུ་གསུངས་པ་སྟེ་སྣ་ཚོགས་པ་ཉིད་དོ།",
    "དུས་གཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ་མཐོང་འགྱུར་ཞེས་བྱ་བ་ནི་རང་ཉིད་རང་གི་ཡེ་ཤེས་དེའི་ཚེ་རྣམ་པ་ཉིད་ལས་སོ།",
    "གཉིས་གསང་བར་ཞེས་བྱ་བ་ནི་ཆུ་དང་ཁུ་བ་དག་གིའོ།",
    "དེ་ལྟར་མ་ལུས་རང་གི་ལས་ལས་སྐྱེས།་།",
    "རང་རང་གི་ལྟ་བ་ཞེས་བྱ་བ་ནི་རང་རང་གི་ལྷག་པར་མོས་པས་འདིར་དུས་གཅིག་ལ་གང་བྱེད་པ་དེ་ཐམས་ཅད་རང་གི་རྟེམཐོང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཏུམ་མོ་ཐམས་ཅད་ཀྱིས་མ་ཡི།",
    "རང་གི་འགྲེལ་པ་བརྗོད་པར་བྱ།",
    "ད་ནི་རྟ་མཆོག་དང་དེ་བཞིན་དུ་གཏུམ་མོའི་སྲུང་ཆོབའི་ལེའུ་ཉི་ཤུ་རྩ་གཉིས་པ་གསུངས་པ།",
    "བདག་གི་བ་ཞེས་བྱ་བ་ནི་གཅིག་པུ་མེད་པས་རྟ་མཆོག་གི་ཏིང་ངེ་འཛིན་དུ་ཞེས་བྱ་བ་ནི་ངེས་པའོ།",
    "འདི་བྱས་པས་ཕཊ་ཧཾ་གི་ཡི་གེ་རྣམས་ཀྱི་ངེས་པའི་ཚིག་གསུངས་པ།",
    "རྣལ་འབྱོར་པ་ཞེས་བྱ་བ་ནི་རྟ་མཆོག་གི་བདེ་བ་རྣམ་པར་བཟུང་བས་རྡོ་རྗེའི་བུ་ག་རྣམས་སུ་ཕཊ་བལྟ་བའོ།",
    "དེ་བཞིན་དུ་ཡང་ཡེ་ཤེས་མིན་ཡང་རྣམ་རྟོག་གོ་ཞེས་བྱ་བ་ནི་དེ་ཡང་མེད་པ་སྟེ་བཀས་པ་ཞེས་བྱ་ནི་གཉིས་པ་ཇེགཏུམ་མོའིའོ།",
    "དེ་ལྟར་བྱས་པ་ཡོད་པས་ཧཾ་གི་ཡི་གེའི་དོན་དུ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མེད་དོ།",
    "གཏུམ་མོའི་ཡོན་ཏན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས།",
    "དེ་བཞིན་དུ་རྟ་མཆོག་གིས་གསུངས་པ།་",
    "དེ་རྣམས་སུ་བྱེའབར་བ་སྟེ་གཏུམ་མོའི་མེ་མྱུར་བའི་སྐད་ཅིག་གིས་སོ།",
    "དེ་ལྟར་གཏུམ་མོས་མེར་བསྲེགས་པས་ཡེ་ཤེས་ཀྱི་གཟུགས་བག་ཆགས་ཐམས་ཅད་ཡེ་ཤེས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་ཕག་མོའི་རིགས་ལས་བྱུང་།",
    "ཞེས་བྱ་བ་ནི་ལེའུ་གཉིས་པར་གསུངས་པའི་ཕག་མོའི་ཡི་གེ་རྣམས་སུ་དེའི་ལྷག་མའི་ཡེ་ཤེས་དེར་རིགས་གཏུམ་མོའི་ཡེ་ཤེས་དང་ཁྱད་མེད་པ་བརྗོད་དུ་མེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་རྣལ་འབྱོར་གང་གིས་བསྐྱེད་པ་གསུངས་པ།",
    "སྐར་མ་ཞེས་བྱ་བ་ནི་དྲང་སྲོང་བདུན་ལ་སོགས་པ་རྣམས་ཀྱིས་ཏེ་དེ་རྣམས་ཀྱིས་སྣང་བ་ཙམ་མོ།",
    "ཧཾ་གི་ཡི་གེ་དེར་ཆ་ཤས་འཕེལ་བ་ལས་ཞེས་བྱ་བར་དགོངས་སོ།",
    "སྐར་མ་ལྟ་བུ་ནི་བདེ་བ་ཙམ་མོ།",
    "གཏོར་མ་སྣ་ཚོགས་མན་ངག་གི།",
    "འདིའི་རྒྱས་པ་འཆད་པར་འགྱུར་བས་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་ནོ།",
    "དེ་ནས་ཏིང་ངེ་འཛིན་སྔོན་དུ་གོམས་པས་སྐད་ཅིག་གིས་དམིགས་པར་བྱའོ།",
    "ཇི་ལྟར་ནང་གི་བདག་ཉིད་དུ་བསམ་པར་བྱའོ།་།",
    "རྩེ་མོར་བྱས་ཞེས་བྱ་བ་ལ་སོགས་པས་སྐྱེ་གནས་ཀྱི་ཕྱག་རྒྱ་གསུངས་ཏེ།",
    "ངེས་པར་གུང་མོ་རྩེ་མོ་ཞེས་བྱ་བ་ནི་གུང་མོ་དང་མིང་མེད་དང་མཐེའུ་ཆུང་གི་སོར་མོ་གསུམ་གསུམ་རྩེ་མོའི་རྣམ་པར་གཞག་པར་བྱ་སྟེ་རིམ་པ་ཇི་ལྟ་བས་འོག་དང་སྟེང་དང་ལྟེ་བའི་དབུས་ལས་ལ་ལ་ནཱ་དང་ར་ས་ནཱ་དང་ཨ་ཝ་དྷཱུ་ཏཱིའོ།",
    "གཡོན་དང་གཡས་པའི་ལག་པ་དག་གིས་ཞེས་བྱ་བ་ནི་ལོངས་སྤྱོད་ཀྱི་རླབས་གཉིས་བཅིར་བར་བྱའོ།",
    "འོག་གི་སྒོར་མི་འགྲོ་བས་དེའི་ཕྱིར་རྒྱུན་གྱི་བདེ་བ་མི་གཡོ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཧཱུཾ་གི་ཡི་གེ་ནི་ཐམས་ཅད་སེམས་ཀྱི་རང་བཞིན་ཏེ་རྣལ་འབྱོར་བྱེད་མ་དེ་དབུས་སུ་གཞུག་པའོ།",
    "བཾ་གི་ཡི་གེ་ནི་རབ་ཏུ་འབབ་པ་འཆིང་བའོ།",
    "ཧོ་འི་ཡི་གེ་ནི་རང་གི་སེམས་ཀྱི་བདེ་བས་དགའ་བའོ།",
    "དེ་ལྟར་རྡོ་རྗེ་ཐལ་མོ་ཞེས་བྱ་བ་ནི་སྲོག་ལ་སོགས་པ་ཐམས་ཅད་བདེ་བ་བཅུའི་རང་བཞིན་ནོ།",
    "གཏོར་མ་དང་སྟོན་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཕྱི་རོལ་ལྷ་མོ་མཐོང་བ་ལས།",
    "འགེངས་བྱེད་གང་གིས་དུས་ཤེས་སོ།",
    "མཆོག་གི་གོ་འཕང་སྟེར་བར་བྱེད།",
    "མཆོག་གི་དངོས་གྲུབ་སྟེར་བའོ།",
    "དེ་ལྟར་ས་གཞི་ཡོངས་སུ་བཟུང་བ་བྱས་ནས་དེར་པུས་མོ་ཙམ་རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར་བརྐོ་བར་བྱས་ཏེ་གྱོ་མོ་ལ་སོགས་པ་བསལ་ལ་བེེར་ཡང་དེར་དབུས་སུ་མཐོ་གང་ཙམ་བརྐོས་ནས་ཤིས་ང་།་",
    "ས་གཤེགས་སུ་གསོལ་བ་དང་སྤྱན་དྲང་བ་སྔོན་དུ་སོང་བས་འདིར་ཐིག་གཉིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་ལྟར་ནིའི་སྒྲར་༥ཟུར་གྱི་ཐིག་གཉིས་ཀྱང་བཏབ་ནས་དེ་ནས་ཚངས་པའི་ཐིག་གི་ལོགས་གཉིས་སུ་ཞེས་བྱ་བ་ནི་ལྷོ་དང་བྱང་དག་དང་དེ་བཞིན་དུ་ཤར་དང་ནུབ་དག་ཏུའོ།་།",
    "ཀུན་ནས་དུམ་བུ་བཅུ་དྲུག་ཅེས་བྱ་བ་ནི་ཚངས་པའི་ཐིག་ནས་བརྩམས་ནས་ཚོན་སྣ་ལྔའི་ནང་གི་མཐར་༡དུམ་བུ་གཉིས་བལྟ་བར་བྱའོ།",
    "ད་ནི་སྦྱིན་སྲེག་གི་ཐབ་རྣམས་གསུངས་པ།",
    "དེ་ལྟར་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཐམས་ཅད་རྟོགས་པར་སླའོ།",
    "ཀུན་སྒོབ་དག་པ་སྔོན་སོང་བས།",
    "དག་བྱེད་རྣམས་དང་གསེར་གྱི་ཡུ་བ་ཅན་གྱི་རྔ་ཡབ་དང་ཡན་ལག་གི་སྣོད་བྷེ་རི་དང་བུམ་པ་དང་ཌ་ཀ་རྣམས་ཏེ་བཅུའོརྔོ།",
    "དེའི་ཕྱིར་འདི་རྣམས་ཐམས་ཅད་སྒྱུ་མའི་རང་གི་མཚན་ཉིད་དོ།",
    "དེའི་དོན་འདིར་ཡང་གང་ཟག་སྒྱུ་མ་བདག་མེད་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཚིག་གིས་གསུངས་ང་།",
    "རབ་གནས་སྒྱུ་མའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་རང་གི་སེམས་ཀྱི་ལུས་ཀྱི་དངོས་པོའི་སྒྱུ་མ་གང་ཟག་གི་བདག་མེད་པ་དེའི་རབ་ཏུ་གནས་པ་སྒྱུ་མའི་གཟུགས་སུ་གཟུང་བར་བྱའོ།",
    "དེ་ལྟར་གང་ཟག་གི་བདག་མེད་པ་སྟེ།",
    "བསྒོམས་པའི་རང་རང་གི་ལྷག་པའི་ལྷ་ལ་སོགས་པ་ཡང་ངོ།",
    "རང་གི་གཟུགས་རང་གི་རྣལ་འབྱོར་ལས་བྱུང་བ་ཕྱི་རོལ་དུ་ལུགས་མ་ལ་སོགས་པར་དམིགས་པར་འཕྲོ་བ་སྟེ།",
    "གང་གི་ཚེ་དེ་དུས་སུ་དེ་ལྟར་བྱུང་བ་ཞེས་བྱ་བ་ནི་རང་གི་རང་བཞིན་ལས་བྱུང་བའི་དུས་རྣམས་སུ་གང་དང་གང་གི་ལྷ་འདིའི་སྣ་ཚོགས་པའི་རྒྱུད་ཀྱི་དགོངས་པ་རྣམས་ཀྱིས་དེའི་སྐུར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རྟོགས་པར་༤བེེའོ།",
    "འདི་སྐད་བདག་གི་ལ་སོགས་པ་ནས་བཞུགས་སོའི་བར་དུ་ཐོག་མའི་ངག་སྟེ།",
    "བཾ་ཡིག་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བྱ་བ་སྟེ་གཅིག་གི་ཚིག་གིས་མང་པོའི་ཚིག་སྟེ་རྡོ་རྗེ་སེམས་དཔའ་ཅན་ཞེས་བྱའོ།",
    "རྒྱུད་འདི་རྣམས་སུ་མིང་གང་གི་མན་ངག་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱི་ངག་གི་ཚིག་རྣམས་སུ་རབ་ཏུ་གནས་པ་མི་བདེན་པའི་དངོས་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཐམས་ཅད་ཅིས་གང་གི་ཚེ་དངོས་པོ་ཐམས་ཅད་མི་བདེན་པས་ན་འཁྲུལ་པ་ཙམ་སྟེ་འཛིན་པའི་གཟུགས་ཀྱང་བྱིས་པའི་སྐྱེ་བོ་རྣམས་ཀྱིས་ཡོངས་སུ་བརྟགས་པའོ།",
