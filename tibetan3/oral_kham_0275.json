    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "ཉེ་ཉོན་རྣམས་ངོ་ཤེས་པར་བྱས་ནས་ཆགས་སྡང་ལ་སོགས་པ་གང་རུང་རྒྱུད་ལ་སྐྱེས་ཙ་ན་འདི་དེ་ཡིན་ཨང་།",
    "སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན་ད་ཡང་རང་ལོག་མི་འོང་བས་བཟློག་དགོས།",
    "དུས་ཚོད་དེ་ཙ་ན་གདན་ས་གང་ལ་འོས་ཟེར་བ་ལ་བགྲེས་པོ་ཕལ་ཆེ་བ་རི་མེར་བ་ལ་ཞལ་འཆམ་ནས་ལྷོ་བྲག་ཏུ་གདན་འདྲེན་ལ་བྱོན་པས།",
    "མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "རང་ཕུན་ཚོགས་ཤིག་བྱེད་པར་འདོད་ཀྱང་རང་དོན་གཙོ་བོར་བཟུང་སྟེ་ཐབས་མ་ཡིན་པ་ལ་ཞུགས་པས།",
    "འདུག་ཀྱང་རུང་།",
    "ཇོ་བོ་ཆེན་པོའི་སེམས་བསྐྱེད་དང་སྡོམ་པའི་ཆོ་གར་གསལ་བའི་སེམམས་བསྐྱེད་གཟུང་བའི་ཆོ་གའི་ཚིག་དོན་ཇི་མ་ཇི་བཞིན་བཀོད་འདུག་ནི།",
    "སྒོམ་རིམ་དང་པོའི་བོད་དཔེར་ཚིགས་བཅད་ཕྱི་མ་གཉིས་མ་བཞུགས་ཀྱང་རྒྱ་དཔེར་ཚིགས་བཅད་གསུམ་ག་ལུང་དྲངས་འདུག་པས་ལེགས་སྦྱར་ཡང་བཞུགས།",
    "དེ་ཡང་རང་ངོས་ནས་གདུལ་བྱ་དེ་ལ་སྦྱར་བ་དགོས་ཀྱི།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "སྡུག་བསྔལ་བྱུང་བ་དེ་སླར་བཅོས་སུ་འདུག་ན་ནི་ཡིད་མི་དགའ་བ་བྱ་མི་དགོས་ལ།",
    "ཚོམས་སོགས་སུ་མིང་ཚིག་རྣམ་པའི་ཞི་གནས་དང་ལྷག་མཐོང་ཧ་ལམ་མི་སྣང་ཞིང་ལྷག་པར་དེ་གཉིས་ཟུང་འབྲེལ་དུ་བྱས་ནས་བསྟན་པའི་གཞུང་ཚིག་ཉིན་སྐར་ལྟར་དཀོན་པོ་འདུག་འོན་ཀྱང་དམིགས་བསལ་ལྟ་བུ་བརྩམས་རིམ་སྔ་བའི་ནང་ཚན་གནས་བརྟན་ཚིགས་བཅད་ལས།",
    "ཞེས་སྒོམ་རིམ་བར་པར་ལུང་འདྲེན་གནང་བ་དེ་རང་སླར་ཡང་ལུང་འདྲེན་གནང་འདུག་ཅིང་།",
    "ལམ་རིམ་དུ་སྒོམ་རིམ་བར་པར་ལུང་འདྲེན་གནང་བ་དེ་རང་སླར་ཡང་ལུང་འདྲེན་གནང་འདུག་ཅིང་།",
    "དེ་འདུག་མ་ཐག་ཏུ་སེམས་འཇོག་སྟེ།",
    "སྡོམ་པ་གཉིས་ཀ་ལ་ཡང་རང་བཞིན་དང་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པའི་བསླབ་པའི་གཞི་མི་འདྲལ་བ་དང་།",
    "ཧ་ཅང་ཡང་མི་དགྱེ་བར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་གཞག་སྟེ་འདུག་པར་བྱའོ།",
    "ལུས་ཧ་ཅང་ཡང་མི་སྒུ་ཧ་ཅང་ཡང་མི་དགྱེ་བར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་གཞག་སྟེ་འདུག་པར་བྱའོ།",
    "ལུས་ནི་ཧ་ཅང་དགྱེ་བ་དང་དགུ་བ་མིན་པར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ས་གོང་མ་དག་ལ་ཡང་རང་བཞིན་རགས་པ་ཉིད་དང་།",
    "ཡོད་པ་ལ་སོགས་པའི་ངོ་བོ་དང་བྲལ་བའོ་ཞེས་དཔྱད་ནས་རྣམ་པར་རྟོག་པ་མེད་ཅིང་བརྗོད་པ་མེད་པར་ངང་གཅིག་ཏུ་གྱུར་པའི་ཡིད་ཀྱིས་དེ་ཁོ་ན་བསྒོམ་ཞིང་ཇི་སྲིད་འདོད་པར་འདུག་པར་བྱའོ།",
    "དེ་ཡང་བློས་གསར་དུ་བསྐྱེད་པ་དང་རང་བཞིན་གྱིས་བཞུགས་པ་གསལ་འདེབས་པ་གཉིས་ལས།",
    "འདི་ཙམ་ཞིག་ལ་བཞག་ན་བྱིང་བ་སྐྱེ་སླ་བར་འདུག་སྙམ་པའི་ཚད་དེ་ལས་ཀྱང་འཕང་མཐོ་བའི་འཇོག་ཚུལ་ལ་བྱའོ།",
    "ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་དེ་ཁོ་ན་བསྒོམ་ཞིང་འདུག་པར་བྱའོ།",
    "ཐུན་གཅིག་གམ་ཇི་སྲིད་ནུས་པ་དེ་སྲིད་དུ་འདུག་པར་བྱའོ།",
    "ཞི་གནས་ཡོངས་སུ་བྱང་བར་མ་བྱས་པའི་ཞི་གནས་ཀྱི་ཕྱོགས་གཅིག་ཡིད་ལ་བྱེད་པ་དང་སེམས་མུན་པ་ལྟ་བུར་འདུག་པ་དང་དམིགས་པ་ལ་གཏོད་པར་མི་དགའ་བའོ།",
    "སེམས་མུན་པ་ལྟར་འདུག་པ་དང་།",
    "དེ་ནང་དུ་ཡང་དག་འཇོག་ལ་འདུག་སྟེ།",
    "དྲུག་པ་རྣམ་རྟོག་ཀུན་ཀྱང་རང་ཞིར་འགྲོ་ཚུལ་ནི།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ཡང་།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ཡང་།",
    "ང་རང་བཞིན་མེད་པར་གཏན་དབབ་པ་དང་།",
    "དང་པོ་ང་རང་བཞིན་མེད་པར་གཏན་ལ་དབབ་པ།",
    "དེར་མ་ལྷུང་བར་བྱེད་པ་ལ་ནི་སྐྱེ་བ་དྲན་པའི་དུས་སུ་ཡུལ་དང་དུས་དང་རང་བཞིན་བྱེ་བྲག་པས་ཁྱད་པར་དུ་མ་བྱས་པར་སྤྱིར་ང་ཞེས་དྲན་པའི་དྲན་ཚུལ་ཁྱད་པར་བ་ལེགས་པར་ཤེས་དགོས་སོ།",
    "ཡུལ་ལ་རིགས་པས་དཔྱད་དེ་གསིལ་བ་ན་ཡུལ་དེ་མི་འདུག་པ་སྙམ་པ་དང་པོར་འབྱུང་ཞིང་།",
    "གང་ཟག་ལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་རྡུལ་ཙམ་མེད་ཀྱང་།",
    "དེ་དག་གང་ལའང་རང་བཞིན་མེད།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "དྲུག་པ་དེ་ལྟར་རང་ངོས་སྟོང་པ་ནི་ཁོ་རང་ལ་ཁོ་རང་མེད་པའི་དོན་ཡིན་ན།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་བདེན་པ་སྟེ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "ཞེས་གསུངས་པ་ལྟར་ཤེས་པར་བྱ་སྟེ་བདག་མེད་པ་དང་རང་བཞིན་མེད་པའི་ངེས་པའི་རྒྱུན་བསྐྱང་བར་བྱའོ།",
    "ལྔ་པ་དཔྱད་པས་ཞི་གནས་དྲངས་པའི་ཚེ་ཞི་ལྷག་དུས་གཅིག་ཏུ་ཕན་ཚུན་མཚུངས་ལྡན་ཟུང་དུ་འབྲེལ་བའི་ཤེས་བྱེད་ནི།",
    "གཉིས་པ་དེར་འཇུག་དུས་བཤེས་གཉེན་བསྟེན་པ་གལ་ཆེ་ཚུལ་ནི།",
    "དེ་ཤིན་ཏུ་ཡིན་པར་འདུག་ཅེས་གསུངས་སོ།",
    "ལྷ་བཞི་ལུས་ཀྱི་གནས་སོ་སོར་སྒོམ་ཚུལ་ཞིག་ཀྱང་ཡོད་པར་འདུག་གོ།",
    "དེ་ཙ་ན་སྟོད་ལུང་པའི་ཞལ་ནས།",
    "རྔོག་ལོ་ཆེན་པོའི་ཐུགས་སྲས་བྲིན་ལས་པས་བསྟན་རིམ་རྒྱས་བསྡུས་གཉིས་མཛད་འདུག་པ་འདི་རྔོག་ཁུ་དབོན་ལས་བརྒྱུད་པར་སྣང་བས།",
    "ལར་སྒོ་ཐམས་ཅད་ན་བཀྲ་ཤིས་པ་ཞིག་བྱོན་པར་གདའ།",
    "དེ་རྣམས་གླུ་ལེན་གྱི་འདུག་པའི་ནང་ན་མར།",
    "སྔོན་ནས་སྔོན་གྱི་དུས་ཙ་ན།",
    "བསྟན་པའི་ཁྱབ་གདལ་གསུང་ཙ་ན་པོ་ཏོ་བའི་དངོས་སུ་ཞལ་བསྟན་ནས་གསུངས།",
    "མི་དེ་ཡང་ང་རང་ཆེ།",
    "སྐལ་བར་ལྡན་རྣམས་རང་རང་བསམ་པ་དང་།",
    "ཇོ་བོ་ལོ་བཅུ་དགུ་བསྟེན་པའི་ལོ་ཙཱ་བ་ཆེན་པོ་དེ་གུང་ཐང་ན་ད་དུང་བཞུགས་པར་འདུག་ཇོ་བོ་བཞུགས་ཀྱང་ལོ་ཙཱ་བར་དུ་འཇུག་པ་ལས་མེད་དེ་ལ་དེངས་ཤིག་ཐུག་དགོས་སྙམ་ནས་ཡར་བྱོན་པས།",
    "འདི་སྔ་ཙམ་ནས་མཇལ་ན་དམིགས་སྐོར་དེ་དག་ལ་དཀའ་ལས་དེ་ཙམ་མི་དགོས་པར་འདུག་པ་ལ་གསུངས་པ་ལྟར།",
    "དིང་རིར་ཕ་དམ་པའི་སྒྲུབ་གནས་མཁའ་འགྲོའི་གསང་ཕུག་ཞེས་གསལ་བ་ནི་མཁའ་འགྲོའི་གསང་ཕུག་ཕ་དམ་པའི་སྒྲུབ་གནས་ཡིན་སྟབས་དིང་རིར་ཡོད་པར་དགོངས་འདུག་ཀྱང་དེ་ནི་སྐྱིད་གྲོང་ན་ཡོད།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ཤཱཀྱ་བློའི་རྣམ་འགྲེལ་འགྲེལ་བཤད།",
    "སྐབས་དེར་གསུང་འབུམ་ལ་རྒྱས་པར་བལྟ་འདོད་པ་ལས་ང་རང་ལ་པར་སྐྲུན་གྱི་འགན་འཛིན་པའི་སྤོབས་པ་དང་འདུན་པ་གཏན་ནས་སྐྱེས་མ་བྱུང་།",
    "ཁང་དཀར་མཆོག་ནས་ཀྱང་ཐུགས་དགྱེས་བཞིན་ང་རང་བྱ་བ་སྒྲུབ་པ་ལ་ནན་ཏན་ཡིན་པ་དང་།",
    "འདུག་གམ་མི་འདུག་རང་རང་བསམ་པས་ཤེས།",
    "སེམས་ཀྱི་འགག་མེད་གདངས་དང་རང་རྩལ་གྱི།",
    "གསུམ་པ་འང་རང་བཞིན་དབྱེར་མེད་ངོ་བོ་ཉིད།",
    "ཇི་ལྟར་འདུག་པའི་རང་བབས་གཉུག་མར་ཞོག།",
    "ཅི་ཤར་ཅི་སྣང་ཡང་རང་སེམས་ལས་ཐ་དད་དུ་མེད་པར་ཤེས་པས་སྣང་བའི་བདེན་འཛིན་ལོག།",
    "དངོས་ཀྱང་འབྲུམ་རིགས་ཐར་ཐོར་ཕྱོགས་སྒོར་མར་ཡོད་འདུག་པ་དང་།",
    "དེ་ད་དུང་ལུས་པ་ཅི་ཡིན་སྙམ་ནས་རྡོ་རྗེ་གདན་ལུས་པ་སོགས་རང་བློ་ལ་སྣང་བ་དང་རང་བློས་བཞག་པ་ཡིན་པ་དེ་མ་གོ་བར་སྣང་བ་དེ་ཕྱི་རོལ་ཏུ་བདེན་པར་འཛིན་པའི་ཆ་གཅིག་ཞུགས་ནས་ཐེ་ཚོམ་གྱི་བློས་དྲིས་པ་སྟེ།",
    "དེ་དུས་དེ་ལྟར་ངོ་སྤྲོད་མཁན་མ་བྱུང་བས་ད་དུང་རང་ཐོག་ཏུ་མཉམ་པར་བཞག་ཅིང་།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་ལས་གྲྭའི་ཞུ་དག་བྱ་ཡུལ་ནི་རིག་ཚན་རྣམ་གྲངས་ཤིན་ཏུ་མང་བ་དང་།",
    "རང་རང་སྒེར་རྐྱེན་གྱིས།",
    "གཞུང་ལུགས་ཀྱི་གཞི་མ་དག་ཆུད་གསོན་མཁན་ཡང་མང་པོ་འདུག་པས་དེ་རྣམས་ལའང་དམིགས་ནས་དང་།",
    "བརྡ་རྙིང་རང་སོར་གནས་པ་གཉིས།",
    "མིག་སེར་ལྟ་བུས་གཞན་གཞུང་རང་ལུགས་ལ་ཡོད་ཟོལ་གྱིས་མཛད་པ།",
    "རང་རང་འཁྲུལ་པའི་གྲངས་དང་བརྫུན་གྱི་ལུང་།",
    "ཁྱབ་ཆེ་ཆུང་དོན་ལ་གནས་མི་གནས་ཀྱི་དབྱེ་བ་དག་ལ་ཅུང་ཟད་དཔྱད་རྒྱུ་འདུག་བསམ་ཡང་དགོས་པ་ཆུང་བས་མི་བརྗོད་དོ།",
    "ཡང་གཞུང་དེའི་མགོ་མཇུག་སོགས་ཀྱི་ཚིག་འགའ་དོར་ནས་གཞུང་གཞན་ཞིག་ཡིན་ཚུལ་བྱས་པ་དེ་འདྲའང་འདུག་པས་ཤེས་པ་དང་ནུས་པས་འགྲུབ་ཚོད་ཡོད་ན་འགོད་དགོས་ལ།",
    "གཉིས་ལ་གཅིག་ཏུ་བྱས་པ་སོགས་གཞི་འཛིན་ས་མེད་པའི་གཏམ་མང་པོ་འདུག་གོ། དཀར་ཆག་རྒྱས་པའི་མཚོན་དཔེ་ཞིག་བྲིས་ན།",
    "ནང་དོན་ཆ་ཚང་བ་ལ་བསྟར་པར་བྱས་པ་དེ་ཉིད་ལེགས་པར་འོང་འདུག་བསམ།",
    "ལྷག་པར་རང་རང་སོ་སོའི་བཤེས་གཉེན་དང་།",
    "སྐྱོབས་དང་རང་བཟོས་མ་བཅོས་མྱུར་སྐྱོབས་དང་།",
    "མ་དཔེ་དེ་ལ་དང་ཐོག་དུས་རབས་རང་བཞིན་དང་།",
    "གོ་དེང་སང་གོ་ལའི་སྐོར་འདི་རིགས་ལ་ཟང་ཟིང་མང་པོ་བརྗོད་བཞིན་འདུག།",
    "ཡང་སྒྲ་གཅིག་དོན་དུ་མར་འཇུག་དུས་རང་སོར་བཞག་པའང་།",
    "འོན་ཀྱང་དེ་སྔོན་པོ་ཏ་ལར་ཐོན་མིའི་ཕྱག་བྲིས་ཞེས་པ་དཔེ་ཚུགས་དང་འབྲུ་ཚ་ཞབས་ཐུང་འདྲེས་པའི་གཟུགས་བྱས་པ་ཞིག་འདུག་པའང་དོགས་གཞི་ཙམ་དུ་རུང་བར་སེམས་སོ།",
    "ལོ་ཙཱ་བ་ཆེན་པོ་ཤོང་སྤང་སྐབས་དིང་རི་གཙོ་བོར་གྱུར་པའི་སྟོད་ཀྱི་ཡུལ་ནས་མཁས་པ་འགྲན་ཟླ་དང་བྲལ་བ་མང་པོ་ཞིག་དུས་གཅིག་ལ་གནས་དེ་ནས་བྱུང་བ་མ་ཟད།",
    "ཡི་གེ་ལ་མི་མཛེས་མི་གདའ་སྟེ།",
    "དབྱངས་གང་ཡོད་དག་ཇི་བཞིན་འགོད་པ་རྒྱུག་ཆེ་ཙམ་དུ་འདུག་སྙམ།",
    "ལྷག་པར་གཟུགས་དེ་རང་ལ་སྐབས་སྐབས་ཀྱི་གོ་བ་སྦྱར་རྒྱུ་ཡོད་པ་བཟོས་གནང་འདུག་ལ།",
    "དེ་ནི་རང་རང་སོ་སོ་དང་བློ་མི་མཐུན་པས།",
    "དེའང་ཀློག་དུས་སེམས་འཚབ་འཚུབ་བམ་རྟབ་རྟབ་ཅན་དེས་ཀློག་དགོས་ཏེ།",
    "དེ་ལས་ཟློག་ན་ཚུགས་ཆ་ཆེ་བ་དེས་ཀློག་དུས་སྐྱོན་ཤོར་རྩ་བ་དེ་སེམས་འཚབ་འཚུབ་ཅན་དེས་སྐྱོན་རྩ་ཟིན་མ་ཐུབ་ནས་སྐྱོན་ཤོར་སླ་བ་འདུག།",
    "དེ་མ་བཅུག་ན་དེས་ལྟ་རྒྱུ་ལ་སྣང་མེད་དུ་བྱས་པས་ཞུ་དག་ག་ཚོད་བྱས་ཀྱང་ཕན་འབྲས་མི་ཐོན་པ་དེ་འདྲ་ཤིན་ཏུ་ནས་མང་པོ་འདུག།",
    "ཞུ་ཆེན་སྒྱུར་བྱེད་མཆན་བུའི་གནས་འདུག་པ།",
    "འདི་ནི་དེང་འགས་ཉེ་དུས་བྱུང་བའི་རྩོམ་རིག་རྙིང་གཟུགས་སུ་གནས་པ་ལག་ཏུ་འབྱོར་བ་དག་ཕྱོགས་བསྡུས་བྱས་པ་ལ་དུས་རབས་མང་པོའི་འགྲེལ་བརྗོད་བྱས་ཏེ་དཔེ་རྙིང་མྱུར་སྐྱོབ་ཏུ་སྒྲོ་བཏགས་པ་མང་པོ་འདུག་པས་དབྱེ་བ་འདི་ལྟར་འབྱེད་རྒྱུ་ཡོད་དམ་སྙམ།",
    "དག་ཡིག་རང་ལའང་མ་དག་པ་འདུག་པས་དེ་རང་ལ་ཡིད་རྟོན་མི་རུང་གསུངས་པ་བཞིན་དུས་རབས་སོ་སོ་དང་།",
    "ཞུ་བ་པོས་གོ་དོན་རྙོག་འཛིང་ཅན་ཐུག་དུས་རང་ལས་ཡོན་ཏན་རྒན་པར་བཀའ་འདྲི་ཞུ་བ།",
    "ཞེས་གསུངས་འདུག་གོ།",
    "རང་ཉིད་དང་རང་འབྲེལ་ངོ་སྤྲོད་བྱ་སའི་ལག་ཆ་ལྟ་བུར་བསམ་སྟེ་ཅལ་ཅོལ་མང་པོ་འགོད་བཞིན་འདུག་པ་དང་།",
    "གཞུང་གཞན་ལས་དེང་སང་ཕན་ཡོན་ཆེ་བར་གྲགས་པ་ཞེས་ཀྱངགསུངས་འདུག་གོ།",
    "ཨ་ཙིན་བསམ་དུ་མེད་པ།",
    "ལོ་པཎ་རྣམས་ཀྱིས་སྐད་རིགས་རང་རང་དུ་བསྒྱུར་པ་དེ་ལས་དང་།",
    "ཞུས་དག་བྱེད་ཙ་ན།",
    "དེས་ཁྱེད་རང་རྣམས་ཀྱི་རྒྱུད་ལ་ཐེག་ཆེན་ཡན་ལག་བརྒྱད་པའི་སྡོམ་པ་ལེགས་པར་ཐོབ་ཟིན་པ་ཡིན་པས།",
    "ཁྲུ་གང་ལས་ལྷག་པའི་ཁྲི་སྟན་མཐོན་པོ་དང་རང་བཞིན་ཕལ་པར་མི་འོས་པའི་སྟན་རིན་ཐང་ཆེན་པོ་ལ་མི་འདུག་པ་སྟེ་མལ་ཆེ་མཐོ་གཉིས་དང་།",
    "ཙོག་པུར་འདུག་སྟེ་མཎྜལ་ཕུལ།",
    "བཛྲ་མུ་ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས་པར་གྱུར།",
    "ན་མ་ཨཱརྻ་ཛྙཱ་ན་སཱ་ག་ར་བེ་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་བྱཱུ་ཧ་ར་ཛཱ་ཡ།",
    "ཁོང་རང་དེ་རིང་འདིར་བསླེབས་ཡོད།",
    "ང་རང་ཁེ་ཎ་ཌ་ནས་ཡོང་བའི་རྒྱ་རིགས་ཤིག་ཡིན།",
    "ང་རང་ནིའུ་ཡོཀ་ནས་ཡོང་བའི་རྒྱ་རིགས་ཤིག་ཡིན།",
    "ང་རང་དྲུག་བཞིའི་དོན་རྐྱེན་རྗེས་ནས་ཕྱི་ཕྱོགས་སུ་འབྱོར་བའི་རྒྱ་རིགས་རྩོམ་པ་པོ་ཞིག་ཡིན།",
    "ང་རང་ཨོ་སི་ཊོ་ལི་ཡ་ནས་ཡོང་བའི་རྒྱ་རིགས་ཤིག་ཡིན།",
    "སྐད་ཅོར་གྱིས་ཁེངས་ནས་འདུག་གཞུང་ལ་སྐྱོན་འཛུགས་བྱེད་རྒྱུ་དང་།",
    "ང་རང་བོད་ལ་འགྲོ་མ་བཅུག་རུང་ངའི་སེམས་པ་ག་དུས་ཡིན་ནའང་བོད་དང་མཉམ་དུ་ཡོད་མུས་སུ་མ་ཟད།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཚོགས་ཀྱི་ཞིང་རང་ལ་ཐིམ།",
    "ཡུམ་གྱི་དཔྲལ་བར་བེ་རཱོ་ཙ་ནཱ།",
    "དེ་ཉིད་དབུས་ཀྱི་གདན་ལ་འདུག་པ་ལ།",
    "གཞལ་ཡས་ཁང་ཡང་རང་ལུས་ལ་ཐིམ།",
    "རང་ནི་རབ་བྱུང་བཅུ་དྲུག་པའི་ལྕགས་རྟ་ལོའི་རྒྱལ་ཟླའི་གྲལ་ཚེས་བཞི་པའི་ནམ་ལངས་ཉི་མ་རི་རྩེར་ཤར་བའི་སྐབས་བཙས་པ་ཡིན་འདུག་ཅིང་།",
    "ཅེས་སོགས་ཚིགས་བཅད་ཁ་ཤས་གསུངས་པ་སྐབས་དེར་ཡིད་ལ་ངེས་ཀྱང་ཕྱིའི་ཉིན་ཚིག་གཉིས་འདི་མ་གཏོགས་བརྗེད་འདུག།",
    "ད་ནི་ང་རང་ལོ་ན་མཐོ་བས་ཅི་ཙམ་འདུག་མི་ཤེས་པས་ན།",
    "ད་ནི་ཀླ་ཀློ་དབུས་སུ་བརྟོལ་བའི་མགོ་ཚུགས་པར་འདུག་པས།",
    "རང་ཡང་ལོ་ན་མཐོ་བ་སོགས་ཀྱིས་ཡུན་རིང་བསྡད་ཀྱང་དགོས་པ་མི་འདུག།",
    "སྐྱབས་མཆོག་ཉིད་ཀྱང་མི་འགྱང་བར་ཕེབས་རྒྱུ་ཡིན་པས་ཁྱེད་རང་ཡང་ལྷན་དུ་འགྲོ་ན་ལེགས་ཞེས་སོགས་ཐུགས་བརྩེའི་བཀའ་མཆིད་མང་དུ་སྩལ་ཞིང་།",
    "ཁོང་དཔོན་སློབ་ཁ་ཤས་གསང་སྟབས་ཀྱིས་ཕེབས་བསྐྱོད་གྲུབ་ཟིན་པས་ཁྱེད་རང་ཡང་མྱུར་དུ་འོང་ན་ཁམས་རི་བོ་ཆེ་ཡན་ནས་ངང་སྒུག་མཛད་བཞིན་འབྱོན་རྒྱུ་ཡིན་ཞེས་གསུངས་ཀྱང་།",
    "ཕུ་ཆུ་ལྟེང་ཀ་སྣ་ཚོགས་ཀྱིས་མཛེས་པའི་སྤང་ལྗོངས་དྭངས་སྤྲོ་བའི་ཕུལ་དུ་གྱུར་པ་ཞིག་འདུག་ལ།",
    "ད་ལྟ་ལྷོ་ཕྱོགས་དཔལ་དང་ལྡན་པའི་ཞིང་དུ་ཡོད་འདུག་ཅེས་གསུངས་པས་སྔར་གྱི་རྨི་ལམ་དང་མཐུན་བྱུང་སྙམ་པའི་ཡིད་ཆེས་རྙེད།",
    "བྲོས་པོ་ཧ་ཅང་མང་པོ་བཟུང་འདུག་པའི་གྲལ་དུ་ངེད་ཅག་ཀྱང་བཅུག།",
    "ང་ཁྱེད་རང་དང་མཉམ་དུ་རྒྱུན་དུ་ཡོད་པ་ཡིན་པས་ཁྱེད་ཀྱིས་མི་ཤེས་སམ་ཟེར།",
    "དཔོན་རིགས་ཆེ་ཆུང་མང་པོ་ལྷན་དུ་བཞུགས་འདུག།",
    "སྤྱིའི་མནར་གཅོད་ཀྱི་འོ་བརྒྱལ་ཤིན་ཏུ་ཆེ་བར་འདུག་པས།",
    "དུས་སྐབས་འདི་ལྟར་འབྱུང་འགྱུར་མཁྱེན་ནས་དགོངས་གཞི་ཅན་གྱི་གསུང་དུ་འདུག་སྙམ་པ་ཡིད་ལ་བཅང་ནས།",
    "ཆུ་མིག་གོང་འོག་ཀྱང་རྩ་བ་ནས་མེད་པར་གྱུར་འདུག་ཅིང་།",
    "ལྷ་ཁང་ཕལ་ཆེར་མཇལ་ཁ་མི་འདུག།",
    "ཚེ་ཆུ་འབུམ་པ་རྣམས་མཇལ་དུ་ཕྱིན་པས་སོ་སོའི་ཤུལ་ཙམ་ལས་རྟེན་དང་ལྷ་ཁང་སོགས་གཅིག་ཀྱང་མི་འདུག་ཀྱང་སོ་སོར་ཕྱག་བསྐོར་དང་།",
    "བེ་རོའི་ཕུག་གར་ཡོད་མ་ཤེས་ཤིང་ཡུལ་མི་འགར་དྲིས་ཀྱང་མི་ཤེས་པར་འདུག་ལ།",
    "ཁང་པ་དང་རྟེན་སོགས་གཅིག་ཀྱང་མི་འདུག་ཀྱང་།",
    "བྱ་ས་ལྷ་ཁང་ཤུལ་ཙམ་ལས་མི་འདུག།",
    "གདུང་ཁག་སོ་སོའི་བླ་བྲང་རྣམས་ཤུལ་ཙམ་ལས་མི་འདུག།",
    "ཉིན་དགོན་གྱི་ལྷ་ཁང་གཅིག་ཀྱང་མི་འདུག་ཀྱང་།",
    "བྲག་ཡེར་པའི་ལྷ་ཁང་རྣམས་རྗེས་ཤུལ་ཙམ་ལས་མི་འདུག་ཀྱང་སྒྲུབ་ཕུག་རྣམས་དང་།",
    "ནང་དུ་བརླན་གྱིས་མ་གོས་པར་འདུག་པ་མ་ཟད་ཕྱོགས་དེར་མིའི་རྒྱུ་འགྲུལ་ཡེ་མེད་པས་ཉམས་མཚར་བ་ཞིག་བྱུང་།",
    "ཕྲན་ནས་ཀྱང་རང་ལ་དེ་ལྟའི་མཚན་ཉིད་དང་ཡོན་ཏན་མེད་ཚུལ་ཞུས་པས།",
    "གསང་ཡུམ་བཞུགས་འདུག་པས་སྣེ་ལེན་ལེགས་པར་མཛད་ཅིང་རྟེན་རྣམས་ཞིབ་མཇལ་ཐོབ།",
    "རི་འདབས་དེར་བསིལ་བ་ཚལ་གྱི་དུར་ཁྲོད་ཟེར་བ་རོ་བསྲེག་རྒྱུན་མི་ཆད་པ་ཞིག་འདུག་པར་ལུས་སྦྱིན་དང་བསྔོ་སྨོན་བྱས།",
    "སྦྱིན་བདག་མང་པོའི་འདོད་སྐོང་སྣ་ཚོགས་བགྱིས་ཤིང་རང་དགོན་དུ་འབྱོར་ནས་སྨིན་གླིང་བཀའ་བརྒྱད་བདེ་འདུས་ཀྱི་སྒྲུབ་ཆེན་སྨད་ལས་ཁྲོ་རོལ་གཏོར་བཟློག་ལས་བཞིའི་སྦྱིན་སྲེག་བཅས་བསྒྲུབས།",
    "པི་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས་བྱང་ཟུར་རྣམ་གཉིས་ནས་ཀོང་སྤྲུལ་ཡབ་སུས།",
