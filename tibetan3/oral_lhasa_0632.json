    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་བ་དེན་པ་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱགས་པའི་ཚུལ་གྱིསམཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "སྨོན་པ་མྱེད་པས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འབྲིབ་པར་མྱྀ་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུའགྲོ་པར་མྱི་འགྱུར་རོ།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོ་བས་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "མྱྀ་འཇིགས་པ་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "སོསོ་ཡང་དག་པར་རིག་བརྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲབ་པར་མྱྀ་འགྱུར་རོ།",
    "བྱམས་པ་ཆེན་པོས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱ་འགྱུར་རོ།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ།",
    "ཡོངས་སུ་འགྲིབ་པར་མྱི་འགྱུར་རོ་མྱི་དམྱྀགས་པའིཚུལ་གྱིསཐམས་ཅད་ཤེས་པ་ཉིད་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པརམྱི་འགྱུར་རོ་། མྱི་དམྱིགས་པའི་ཚུལ་གྱིས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "ཚིག་རནཔ་ ། དང་ལྡན་པར་འགྱུར་རོ།",
    "ཚིག་འཆལ་བ་མྱེད་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཁྲོ་བའི་ཟིལ་ཀྱིས་ནོན་པ་མྱེད་པར་འགྱུར་རོ།",
    "བདག་ཀྱང་སྲོག་གཅོད་པསྤངས་པར་འགྱུར།",
    "གཞན་ཡང་སྲོག་གཅོད་བ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འབྱུང་།",
    "སྲོག་གཅོད་པ་སྤོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་མ་བྱིན་པར་ལེན་པ་སྤོངས་བར་འགྱུར།",
    "གཞན་ཡང་མ་བྱིན་པར་ལེན་པ་སྟང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "མཁྱེན་པར་ལེན་པ་སྤོང་བའི་ལེགས་བ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་འདོད་པས་ལོག་པརག་ཡེམ་པ་སྤོང་༤་ལ་ཡང་དགཔར་སྐུལ་བར་འགྱུར།",
    "འདོདཔས་ལོག་བར་གཡོམ་པ་སྤོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།་",
    "གཞན་ཡང་བརྫུན་དུ་སྨྲ་བ་སྤང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བརྫུན་དུ་སྨྲ་བ་སྤོང་བ་འི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་ཕྲམ་སྤངས་པར་འགྱུར།",
    "གཞན་ཡང་ཕྲམ་སྤང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཕྲ་མ་སྡོད་བའི་ལེགས་བ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་ཞེ་གཅོད་པ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཞེ་གཅོད་པ་སྱོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་ཚིགཀྱལ་བ་སྤོངབ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཚིག་ཀྱལ་པ་སྤོང་བའི་ལེགས་བ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་ཆགས་སེམས་སྦང་བ་ལ་ཡ་ང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཆགས་སེམས་སྲོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "འདག་ཀྱང་གནོད་སེམས་སྤངས་པར་འགྱུར།",
    "གཞན་ཡང་གནོད་སེམས་སྤོང་བལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "གནོད་སེམས་སྤོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་ལོག་པར་ལྟ་བསྦྱོངབ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ལོག་པརལྟ་བ་སྤོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་སྦྱིན་པའི་ཕ་རོལ་ཏུཕྱིན་བ་ལ་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཡང་དག་པར་སྐུལ་པར་འགྱུར།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལེགས་པ་རྗོང་པར་འགྱུར།",
    "བདག་ཀྱང་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར",
    "གཞན་ཡང་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བདག་ཀྱང་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཤེས་རབ་ཀྱི་༥རོལ་ཏུ་ཕྱིན་པའི་ལེགས་བརྗོད་པར་འགྱུར།",
    "གཞུན་ཡང་ནང་སྟོང་པ་ཉིད་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་ཕྱིནང་སྟོང་བ་ཉིད་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཕྱནང་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "སྟོང་བཉིད་སྟོང་བཉིད་ཀྱི་ལེགས་པ་རྗོད་པརའགྱུར།",
    "ཆེན་པོ་སྟོང་བཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་དོན་དམ་པ་སྟོང་པ་ཉིདལ་ཡངདག་པར་སྐུལབར་འགྱུར།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་འདུས་བྱས་སྟོང་པ་ཉིད་ལ་ཡང་ངག་པར་སྐུལ་བར་འགྱུར།",
    "འདུས་བྱས་སྟོང་བ་ཉིད་ཀྱི་ལོགས་པ་རྗོད་བར་འགྱུར།",
    "འདུསམ་བྱས་སྟོང་པ་ཉིད་ཀྱི་ལེ་པ་རྗོད་པར་འགྱུར།",
    "མཐའ་ལས་འདས་བ་སྟོང་བ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡངཐོག་མ་དངཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ལ་ཡང་དག་པར་སྒུལ་བར་འགྱུར།",
    "ཐོགམ་དང་ཐམ་སྐྱེད་པ་སྟོང་བ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་དོར་བ་མྱེད་པ་སྟོང་བ་ཉིད་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "དོར་བམྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོདཔརའགྱུར།",
    "གཞན་ཡང་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "དངོས་པོ་མེདཔསྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "སྟོང་པ་ཉིད་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ངོ་བཞིིང་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་དངོས་པོ་མྱེད་བའི་ངོ་བོཉིད་སྟོང་པ་ཉིད་ལ་ཡང་དེག་པར་སྐུལ་བར་འགྱུར།",
    "དངོས་པ་མྱེད་ཕཔའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་ལེགས་བརྗོད་པར་འགྱུར།",
    "བདགཀྱང་ཚེ་ཏང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "ཏིང་ངེའཛིན་ཐམསཅད་ལ་སྙོམས་པརའཇུག་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་གཟུངསརྣམས་ཐོབ་པར་བྱབ་ལ་ཡང་དག་པར་སྐུལ་པར་འགྱུར།",
    "གཟུངས་རྣམས་ཐོབ་པར་བྱེད་བའི་ལགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་པསམ་གཏན་དང་པོ་ལ་སྙོམས་བར་འཇུག་པར་འགྱུར།",
    "གཞནཡང་བསམ་གཏན་དང་པོ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བསམ་གཏན་དང་པོའི་ལེགས་པརྗོད་པར་འགྱུར།",
    "གཞན་ཡངབསམ་གཏནག་ཉིས་པ་ལ་ཡང་དག་པར་སྐུལ་པར་འགྱུར།",
    "བདགཀྱང་བསམགཏནགསུམབ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་བསམ་གཏན་གསུམ་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བསམ་གཏན་གསུམ་པའི་ལེགས་པརྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་བསམ་གཏན་བཞི་པལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་བསམ་གཏན་བཞི་པ་ལ་ཡ་ང་དག་པར་སྐུལ་བར་འགྱུར།",
    "གཞནཡ་ངབྱམས་པ་ལ་སྙོམས་བར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བདག་ཀྱང་དགའཔ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་དགའབལ་། སྙོམས་པར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "དགའ་བ་ལ་སྙོམས་པར་འཇུག་བའི་ལེགས་བ་རྗོདཔར་འགྱུར།",
    "གཞན་ཡངབཏང་སྙོམས་ལ་སྙོམས་པར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བཏང་སྙོམས་ལ་སྙོམས་པར་འཇུག་བའི་ལེགས་བ་རྗོད་པེརའགྱུར།",
    "གཞན་ཡང་ནམམཁའམཐའ་ཡས་སྐྱེམཆེད་ལསྙོམས་པར་འཇུག་པར་ཡང་དག་བར་སྐུལ་བར་འགྱུར།",
    "ནམ་མཁའམཐའཡས་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་ཆུངཟདཔྱོད་པའི་སྐྱེ་མཆེད་ལ་སྙོམས་བར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཆུང་ཟང་མྱེད་པའི་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་འདུ་ཤེས་མྱེད་འདུ་ཤེསམྱེད་མྱན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་འདུ་ཤེས་མྱེད་འདུ་ཤེས་མྱོད་ཀྱིན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "འདུ་ཤེསམེད་འདུ་ཤི་མེད་མིན་སྐྱེམཆད་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡ་ང་དྲན་པ་ཉེ་བར་གཞག་བབསྐོལཔ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཡང་དག་པར་སྡོང་བྱ་སྒོམ་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "འཕགས་པའི་ལམ་ཡན་ལགབརྒྱད་བསྒོམ་བའི་ལེགས་བ་རྗོད་པར་འགྱུར།",
    "སྨོན་བསྐྱེད་པའི་ཏིང་ངེ་འཛིན་ལ་ཡང་དྲག་པར་སྐུལ་བར་འགྱུར།",
    "སྨོན་བམྱེད་བའི་ཏིང་ངེ་འཛིན་གྱི་ལགས་པ་རྗོད་པར་འགྱུར།",
    "ལུགས་དང་སྐྱི་མ་ཐུན་བར་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "རྣམ་པར་ཐར་བ་བརྒྱད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདགཀྱང་མཐརད་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་མཐརད་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་སྙོམས་པརའཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པརའཇུག་པ་དགུ་འ་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་དེ་བཞིནག་ཤེགས་པའི་སྟོབས་བརྩལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུལ་ཡང་དག་པར་སྩལ་བར་འགྱུརདེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་མྱི་འཇིགས་པ་བཞ་ལ་ཡང་དྲག་པར་སྐུལ་བར་འགྱུར།",
    "གྱི་འཇིགས་པ་བཞིའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་༥། བཞིའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་བྱམས་པ་ཆེན་པོལ་སྙོམས་པར་འཇུག་པར་འགྱུར་༴",
    "བྱམས་པཆེན་པོལ་སྙོམས་པརའཇུག་པ་འལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་བྱམས་པ་ཆེན་པོ་ལ་སྙོམས་པར་འཇུག་ནུ།",
