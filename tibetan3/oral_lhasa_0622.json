    "ཀུན་ཀྱང་གྲུ་བཞི་ལྷམ་པར་བྱ།",
    "རང་སྔགས་ཀྱིས་ནི་འབར་བྱས་པ།",
    "འཇམ་དབྱངས་ཏེ་བློ་ཅན་གྱིས་ཞེས་པ་ནི་ཨུཏྤལ་དེའི་སྟེང་དུ་འཇམ་དབྱངས་ཉིད་ཀྱི་སྔགས་ཀྱི་ས་བོན་བཞག་སྟེ་གཟེངས་བསྟོད་པར་བྱ་ཞེས་པའོ།",
    "ཨུཏྤལས་ནི་བརྒྱན་པར་རོ།",
    "ཅི་བགྱི་ཇི་སྐད་གསུངས་རྣམས་ཀྱི།",
    "དེ་དག་ཀུན་ཀྱང་དཀྱིལ་འཁོར་གྱི་ནང་ན་པདྨོ་ལ་གནས་པར་བྱའོ་ཞེས་པའི་བར་དུ་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་འཁོར་དང་བཅས་པའི་ཕྱག་རྒྱ་ཇི་སྐད་དུ་སྨོས་པ་རྣམས་བྲི་བར་གསུངས་པ་སྟེ།",
    "ཁ་དོག་ཀུན་ཀྱང་ལྡན་ཞེས་པ་ནི་གདན་དེའི་སྟེང་དུ་པདྨོ་འདབ་མ་བརྒྱད་པར་བྲི་སྟེ།",
    "དེ་མཐའ་ཡས་མང་པོའི་གཙོ་འཁོར་རྣམས་གྲངས་མེད་པ་སྟེ་ཞེས་པ་ནས་ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱང་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཆུད་པར་བྱའོ་ཞེས་པའི་བར་དུ།",
    "ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱང་དཀྱིལ་འཁོར་འདིའི་ནང་དུ་ཆུད་པར་བྱའོ་ཞེས་པ་ནི།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་གསང་བའི་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་ཆོ་ག་གསུངས་པ་ཞེས་པ་ནས།",
    "དེ་ལྟར་སྟོང་པར་གྱུར་པ་དང་དེའི་གནས་། སུ་ཡང་ཡི་གེ་ཨ་བསམས་ཏེ།",
    "བཟླས་པ་དང་སྒྲུབ་པ་ལ་སོགས་པའི་ཆོ་ག་བཟླས་ཏེ་ལོབས་པར་གྱུར་ཅིང་མཁས་པ་ཞེས་པའོ།",
    "སྟོང་པར་བྱས་ནས་དེ་ཉིད་ཀྱི་ཚེ་ན།",
    "ཞེས་པ་ནི་བསྲེག་པ་ཡང་ལྷག་མ་ཡོད་པ་མ་ཡིན་པར་ཤིན་ཏུ་ཚིག་ནས་སྟོང་པ་ཉིད་དུ་འགྱུར་བར་བྱའོ་ཞེས་པའོ།",
    "ཞེས་པ་ནི་དེ་ལྟར་སྟོང་པ་ཉིད་དུ་བརྟན་པར་གྱུར་ནས།",
    "ཇི་ལྟར་བསྲེག་ཅེས་གསུངས་པ་ཡི་གེ་སུ་ནི་ཡི་གེ་བསྲེས་ཅེས་པ་སྟེ།",
    "དེ་ལྟར་བསྲེགས་ཏེ་སྟོང་པར་གྱུར་ནས་ཀྱང་སླར་ལྔ་ཕུང་མི་སྐྱེ་བར་སྟོང་པར་འགྱུར་བ་ལས་གཞན་དུ་མི་འགྱུར་བར་ཏིང་ངེ་འཛིན་གྱིས་བརྟན་པར་བྱའོ་ཞེས་པའོ།",
    "དེ་ཡི་སྣོད་དུ་གྱུར་པར་བྱ།",
    "ཞེས་པ་ནི་དེའི་གདན་པདྨོ་ལ་ཡན་ལག་བཅུ་གཉིས་ཀྱི་ཚིག་རྣམས་དགོད་པར་བྱ་ཞེས་པའོ།",
    "རྒྱུད་ཀུན་དུ་ཡང་བཞུགས་པ་ཡིན།",
    "ཞེས་པ་ནི་གོང་དུ་སླར་གསོས་ནས་དཀར་ཞིང་གསལ་བར་བྱ་ཞེས་པ་ནི་སྤྱིར་སྨོས་པ་ཙམ་དུ་ཟད་ཀྱི་ཚིག་འདིས་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུགས་ཉིད་དུ་བྱ་ཞེས་པའོ།",
    "ཞེས་པ་ནི་ཏིང་ངེ་འཛིན་དེ་ལྟ་བུར་མ་བྱས་ཏེ་ལོག་པར་གཞན་དུ་བྱས་ན་དམ་ཚིག་ཏུ་མི་བྱ་ཞེས་པའོ།",
    "དེ་ནས་སླར་གསོས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་སྐུར་བསྒྱུར་བ་ནི་ལྡང་བའི་སེམས་སུ་ཤེས་པར་བྱའོ།",
    "གཟུགས་བརྙན་གྱི་དཀྱིལ་འཁོར་ཀྱང་ཇི་སྐད་དུ་གསུངས་པ་བཞིན་དུ་རྫོགས་པར་དཀའ་སྟེ།",
    "དེ་བས་ན་ཡིད་ཀྱི་དཀྱིལ་འཁོར་ལ་སོགས་པའི་ཡིད་ཀྱིས་བསྐྱེད་པ་ཐམས་ཅད་སྦྱོར་བས་ཐོག་མར་སེམས་མཉམ་པར་གཞག་པ་ལ་དགོད་པའི་མགོན་ཇི་ལྟར་གྱུར་ཅིག་ཅེས་བསམས་ཤིང་།",
    "དེ་དག་ཇི་ལྟ་བ་ཉིད་དུ་མཁྱེན་གྱི་མ་འོངས་པའི་འགྲོ་བ་རྣམས་ཀྱི་དོན་དུ་དངོས་པོ་ཡོད་པ་མ་ཡིན་པ་ལས།",
    "བཅོམ་ལྡན་འདས་སྙོམས་པར་ཞུགས་མ་ཐག་ཏུ།",
    "ལག་མཐིལ་བཞིན་དུ་མཉམ་པར་འགྱུར།",
    "དེ་ཡང་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་བཞུགས་པ་དེ་བཞིན་གཤེགས་པའི་སྐུ་ལས་གྱུར་པའི་ལྷ་རྣམས་ཀྱིས་བསྐོར་ཞིང་བཞུགས་པར་བྱ་བ་བསྟན་པའོ།",
    "ཡེ་ཤེས་དག་པ་དེའི་མཚན་མས་དཀར་བར་ཤེས་པར་བྱ་སྟེ།",
    "ཚིག་དེ་དག་གྲོལ་བར་གསུངས་པ།",
    "ལས་ཐམས་ཅད་པའི་སྔགས་ཀྱིས་བསྲུང་བར་བྱ་བ་དང་ལས་ཐམས་ཅད་པའི་སྔགས་ཀྱིས་བཏབ་པའི་སྐུད་པ་དཔུང་པར་བཅིང་བ་དང་སོ་ཤིང་སྦྱིན་པ་རྣམས་བྱས་ཏེ།",
    "དེ་དག་ནི་ལྷག་པར་གནས་པའི་ཆོ་གའོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དངོས་པོ་མེད་པར་བསྒོམས་ཏེ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་དང་ཡི་གེ་ར་ཡང་སྟོང་པར་བསམས་ཏེ་ཐ་མར་སྒྲའི་དེ་ཁོ་ན་ཉིད་དེ་ཡང་དམིགས་སུ་མེད་པར་བསྒོམས་ཏེ་སྟོང་པ་ཉིད་དུ་ཇི་སྲིད་འདོད་པར་གནས་ཏེ།",
    "ཀླད་པའི་བར་དུ་ཕྱིན་པར་བསམ།",
    "དེ་ནས་དེ་དག་ཀུན་ཟིན་པ་དང་སེ་གོལ་བརྡབ་པར་བྱ་སྟེ།",
    "དེ་ནས་བདག་ལས་ཀྱི་ལྷ་རྡོ་རྗེ་སེམས་དཔར་བྱིན་གྱིས་བརླབས་ལ་ཞེས་པ་ནི།",
    "ཟུག་རྡུར་བྲལ་ཞེས་པ་ནི་མུ་སྟེགས་གཞན་རྣམས་ཀྱི་བདག་ལ་སོགས་པའི་དངོས་པོ་དེ་རྣམས་ཀྱང་དམིགས་སུ་མེད་པར་སྒོམ་ཞེས་པ་སྟེ།",
    "གྲུ་བཞི་སྒོ་བཞི་ལས་ནུབ་ཕྱོགས་ཀྱི་སྒོ་རྟག་། པར་ཕྱེ་བ་སྒོ་ཁྱུད་དང་སྟེགས་བུ་རབ་ཏུ་བརྒྱན་པ་ཞེས་པ་དེ་ནི་དེ་ལྟར་སྟོང་པ་ཉིད་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་བྱས་ལ།",
