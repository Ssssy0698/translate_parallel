    "རྣམ་པར་མི་རྟོག་པའི་ཏིང་ངེ་འཛིན་ལས་ཀྱང་ཉམས་པ་མེད་པར་བསྟན་པའི་ཕྱིར་གསུངས་པ་དེ་ནི་དང་པོའོ།",
    "འཇིག་རྟེན་གྱིས་ཞེས་པ་ནས་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཞེས་པའི་བར་དུའོ།",
    "སྤྱོད་པ་དང་མི་གཉིས་པར་སྦྱོར་བ་ཞེས་པ་ནི་ལུས་དང་ངག་དང་ཡིད་གསུམ་གྱིས་འཁོར་ལོ་སྤྱོད་པ་དང་།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལྟ་བུ་ཞེས་པ་ནི།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་དང་འདྲ་ཞེས་པ་རྣམ་པར་སྨིན་པ་ཉིད་མ་ཡིན་གྱི།",
    "དེ་ཉིད་ཟད་པར་འགྱུར་གྱིས།",
    "དེ་ཟད་པར་མི་འགྱུར་བ་སྟེ།",
    "ཨ་དེའི་ཡོན་ཏན་དང་བརྗོད་པ་དང་བཅས་པར་གསུངས་པ།",
    "ཕྱོགས་གཅིག་སྟོང་པར་ལྟ་བ་རྣམས་སོ།",
    "ཡོངས་སུ་རྫོགས་པའི་སྟོང་པ་ལ་ལ་ནི་ཕྱོགས་མཚམས་སྟོང་པར་ལྟ་བ་སྟེ།",
    "བསམ་གཏན་བྱས་ཞེས་པ་ནི་གང་བསམ་པ་དེའི་འབྲས་བུ་སྟེ།",
    "ཡིག་འབྲུ་རྣམས་ཀྱང་ཀུན་རྫོབ་དང་དོན་དམ་པའི་སྒོ་ནས་སྲོག་ལ་སོགས་པར་འགྱུར་བ་སྟེ།",
    "དེ་བཞིན་དུ་ཡི་གེ་ལྷག་མ་རྣམས་ཀྱང་ཤེས་པར་བྱའོ།",
    "ཡི་གེ་ཨ་ཞེས་བྱ་བས་རྒྱུ་བྱས་པ་ན།",
    "སྤྱོད་ཡུལ་མཐུན་པས་ལྷན་ཅིག་ཏུ་སྐྱེས་པར་འགྱུར་རོ།",
    "དབུང་མཐའ་དང་མཆོག་རྒྱན་དུ་ལྷའི་བཞུགས་པའི་གནས་ངེས་པར་བྱ་བ་དང་།",
    "ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་སྤྲུལ་ཞེས་བྱ་བ་ནི་གང་ཏིང་ངེ་འཛིན་དུ་ཞུགས་ནས་བསྲུང་བའི་རིག་པ་དང་སྔགས་ལ་སོགས་པའོ།",
    "དེ་ལ་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོར་རྣམ་པར་བཀོད་ཅེས་པ་ནི།",
    "དེ་ལ་དང་པོ་ཐིག་བྲི་བའི་ཚེ་དང་པོར་ནམ་མཁའི་ཐིག་བྲི་བར་གསུངས་པ་ལ།",
    "དེ་ནས་སའི་དཀྱིལ་འཁོར་གྱི་ཐིག་བྲི་བའི་ཕྱིར་གསུངས་པ།",
    "ལྷག་མ་རྣམས་འདིར་མ་གསུངས་པ་ནི།",
    "དེ་ལ་དཀྱིལ་འཁོར་སྣམ་བུ་བར་མའི་ནང་ན་རྫོགས་ལོངས་སྤྱོད་པའི་སྐུ་དང་སྤྲུལ་པའི་སྐུ་གཉིས་བཞུགས་ཏེ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་ཚོན་རྩི་རྣམས་བྱིན་གྱིས་བརླབ་པའི་ཆོ་ག་གསུངས་པ་ཡང་།",
    "བཅོམ་། ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དུ་བདག་ཉིད་བྱིན་གྱིས་བརླབ་པོ་ཞེས་པ་ནས།",
    "དེ་ལ་རྣམ་པར་སྣང་མཛད་དུབ་དག་ཉིད་ཕྱག་རྒྱས་བྱིན་གྱིས་བརླབ་ཅེས་པ་ནི་ཚོན་རྣམས་བྱིན་གྱིས་བརླབ་པའི་ཚེ།",
    "རྡོ་རྗེའི་ཕྱག་རྒྱས་སློབ་དཔོན་ཉིད་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུར་བྱིན་གྱིས་རློབས་ཤིག་ཅེས་པ་སྟེ།",
    "དེ་ལ་དོན་དམ་པར་བྱིན་གྱིས་བརླབས་པའི་ཕྱིར་གསུངས་པ།",
    "དེ་ནས་ཚོན་དམར་པོ་བྱིན་གྱིས་བརླབས་པ་གསུངས་པ།",
    "ཚོན་ནག་པོ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བས་བྱིན་གྱིས་བརླབས་པར་གསུངས་པ།",
    "ཏིང་ངེ་འཛིན་ལས་རྣམ་པར་གྲོལ་བ་ཞེས་གོང་དུ་སྨོས་པ་དེ་འདི་མན་ཆད་འཆད་དེ།",
    "མཐའ་ཡས་པར་རྣམ་པར་རྒྱལ་བཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་རྟོག་པ་གཞན་སྤངས་པ་དང་།",
    "ལྷའི་གཟུགས་སུ་སྣང་བ་རྫོགས་པར་རོ།",
    "གཙུག་ཏོར་གྱི་ཕྱག་རྒྱ་ལ་སོགས་པའི་ཕྱག་རྒྱ་ནི་སྐུའི་ཡོན་ཏན་ཏེ་ཅི་ལྟར་རིག་པར་སོ་སོར་སྦྱར་བར་བྱའོ།",
    "དེ་རྟོགས་ཤིང་ཆུད་པར་མཛད་པའི་མཚན་མ་ནི་རལ་གྲི་དང་རྡོ་རྗེ་ལ་སོགས་པའི་ཕྱག་རྒྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་མི་ཚུགས་པའི་གནས་ཀྱི་སྟོབས་བྱིན་གྱིས་བརླབ་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་པ་ནི།",
    "བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞུགས་ནས།",
    "བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་མ་ཐག་ཏུ།",
    "དེ་བྱས་པ་ཙམ་གྱིས་དམ་ཚིག་ལས་ཉམས་པ་དེ་འཚོ་བ་སྟེ།",
    "སླར་དམ་ཚིག་ཏུ་ཞུགས་པར་འགྱུར་བས་ན་དམ་ཚིག་ཏུ་འཇུག་པ་ཞེས་བྱའོ།",
    "སྔགས་འདིར་བྱས་ན་འཇུག་པས་ན།",
    "ས་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྫོགས་པར་བྱེད་པའོ།",
    "སྐུ་མི་ཟད་པ་ལ་སོགས་པ་ཆུད་པར་བྱེད་པའམ།",
    "སྐུ་དེ་དག་ཡོངས་སུ་ཐོབ་པར་བྱེད་པ་དེ་དག་ཕྱག་རྒྱ་འདིའི་སྒོ་ནས་མཆོད་ཅིང་ཆུད་པར་བྱེད་པས་ན་ཕྱག་རྒྱ་འདི་ལ་རབ་ཏུ་གནས་པར་བྱེད་པ་ཞེས་བྱའོ།",
    "ཕྱག་རྒྱ་དེས་རྡོ་རྗེ་སེམས་དཔར་གྱུར་ནས།",
    "ཡེ་ཤེས་དེས་མ་རིག་པ་དང་སེམས་ལས་བྱུང་བའི་འཁོར་རྣམས་དང་བཅས་པར་འཛོམས་ཞེས་པ་གཙུག་ཏོར་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ།",
    "ཕྱག་རྒྱ་གཙོ་བོར་གྱུར་པར་འང་།",
    "འདི་ལྟར་བཅིང་བ་བྱས་ན་ནི།",
    "ཁམས་གསུམ་ཐམས་ཅད་དུ་ཡང་ཁྱབ་པར་འགྱུར་བ་དཀྱིལ་ནས་དེ་ཉིད་དུ་ཟད་པར་ཕྱག་རྒྱ་འདིར་བྱིན་གྱིས་བརླབས་པ་སྟེ།",
    "ལྷུང་བཟེད་ཀྱི་ཕྱག་རྒྱ་ནི་ཚིགས་སུ་བཅད་པ་རང་ལོག་ཏུ་གསུངས་པར་ཟད་དོ།",
    "མཆོག་སྦྱིན་རྒྱལ་བ་དམ་པར་འགྱུར།",
    "སོ་སོར་གྱེས་པར་གདོན་མི་ཟ།",
    "ཞེས་པ་ནི་བགེགས་རྣམ་པར་སྐྲག་པར་བྱེད་པའི་ཕྱག་རྒྱ་སྟེ།",
    "བགེགས་ལ་སོགས་པ་ཐམས་ཅད་རྣམ་པར་སྐྲག་ནས་སོ་སོར་འབྱེར་བར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་བསམས་པའི་དོན་གྲུབ་པར་འགྱུར་བས་ན།",
    "ཞགས་པ་འདི་ནི་མཆོག་ཅེས་གསུངས།",
    "གནོད་པ་ཐམས་ཅད་མེད་པར་བྱེད།",
    "འདི་ནི་ཀྱོ་བ་བཏང་ཞེས་གསུངས།",
    "གཞན་ཡང་གནོད་པར་སེམས་པའོ།",
    "ལྕགས་ཀྱུས་ཀྱང་ཐམས་ཅད་འདྲེན་པར་བྱེད་པ་ནི།",
    "བགེགས་ལ་སོགས་པ་གནོད་པར་བྱེད་པ་རྣམས་དང་།",
    "ལྕགས་ཀྱུའི་ཕྱག་རྒྱ་སྲིན་ལག་གཉིས་བསྒྲེང་བར་ཤེས་པར་བྱའོ།",
