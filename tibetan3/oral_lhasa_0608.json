    "རྒྱུན་དུ་གོ་ཆས་འདྲིས་བརྟན་པར་བྱས་ནས་ཉམས་ལེན་ཁོང་དུ་ཆུད་པ་གལ་ཆེའོ།",
    "དང་པོ་རང་དོན་རྐྱང་པར་མི་བཏང་བ་ནི།",
    "ལུས་ཐ་མལ་དུ་མི་བསྡད་ཐུགས་རྗེ་ཆེན་པོ་སྒོམ།",
    "ངག་ཐ་མལ་དུ་མི་བསྡད།",
    "ཡིད་ཐ་མལ་དུ་མི་བསྡད་རྣམ་རྟོག་དང་དུག་ལྔ་རང་ཤར་རང་གྲོལ་དུ་བཏང་།",
    "སེམས་མ་འགགས་པ་རང་ཤར་དུ་ཐོགས་ཐུགས་མེད་པར་ཤར་བ་ལ་བྱའོ།",
    "ཧྲིལ་གྱིས་བྲིལ་བས་ཐུགས་རྗེ་ཆེན་པོའི་ལྟ་བ་གསལ་ལ་མ་བསྒྲིབས་པ་རང་བྱུང་དུ་ཤར་བ་ཡིན་པས་སྐལ་ལྡན་རྣམས་ལ་བསྟན་པར་བྱའོ།",
    "སྐལ་ལྡན་རྣམས་ལ་བསྟན་པར་བྱའོ།",
    "མཐུན་རྐྱེན་དང་འགལ་རྐྱེན་གང་བྱུང་ཡང་རྐྱེན་གྲོགས་སུ་ཤར་ནས་མི་གནོད་པར་རང་སར་གྲོལ་བ་ལ་བྱའོ།",
    "བཀྲ་མི་ཤིས་པའི་སར་ཐུགས་རྗེ་ཆེན་པོ་བསྒྲུབ་པར་མི་བྱ།",
    "ལུས་དགོས་མེད་དུ་ཤེས་པར་བྱའོ།",
    "རྒྱུད་ལ་སྐྱེས་ནའང་ངའི་སེམས་བསྐྱེད་པས་བཟང་བ་མེད་སྙམ་ནས་ཞེན་ཆགས་བྱས་ནའང་།",
    "མཉམ་པ་རིས་མེད་ལ་གནས་པར་བྱའོ།",
    "དང་པོ་ཐོས་པ་བྱས།",
    "བར་དུ་བསམ་པ་བྱས།",
    "ཁྱད་པར་དུ་ཐུགས་རྗེ་ཆེན་པོའི་གདམས་ངག་དང་འབྲེལ་པ།",
    "སྒྲུབ་པ་ལེ་ལོར་མི་འཇོག་པར་མགོ་ལ་མེ་ཤོར་བ་ལྟ་བུར་ཉམས་སུ་ལེན་ཞིང་།",
    "འབྲས་བུ་ཐུགས་རྗེ་ཆེན་པོ་རང་དང་གཉིས་སུ་མེད་པར་ཡིད་ཆེས་བསྐྱེད་དོ།",
    "ཐུགས་རྗེ་ཆེན་པོས་ཁོ་བོ་སྲོང་བཙན་སྒམ་པོ་ལ་གསུངས་པས་བར་དུ་གང་ཟག་གཞན་གྱི་བར་བརྒྱུད་པ་མེད་པར་ཡིད་ཆེས་དགོས་སོ།",
    "དྲུག་པ་འབྲས་བུ་ཐུགས་རྗེ་ཆེན་པོ་རང་དང་གཉིས་སུ་མེད་པར་ཡིད་ཆེས་བསྐྱེད་པ་ནི།",
    "ང་གདོད་རྩོལ་སྒྲུབ་ཀྱིས་གཞན་ནས་སྒྲུབ་པར་འདོད་པ་འབྲས་བུ་འདྲ་མིན་ཡིན་ནོ།",
    "བར་དུ་བསམ་པས་ཚིག་དོན་ཁོང་དུ་ཆུད་པར་བྱ།",
    "འགྲོ་དོན་ཕྱོགས་རིས་མེད་པར་བྱའོ།",
    "ལྟ་སྒོམ་སྤྱོད་འབྲས་རྟོགས་པར་མ་བྱས་པས་ཚིག་དོན་རྣམས་དཔེ་དོན་དུ་སྦྱོར་མི་ཤེས་པར།",
    "ཐ་སྙད་ཀྱི་རིགས་པས་དེ་ཁོ་ན་ཉིད་མ་རྟོགས་པར་གཞན་སུན་འབྱིན་པས་བསྟན་བཅོས་པའི་ཚིག་དང་འདྲའོ།",
    "རྣམ་རྟོག་དུག་ལྔའི་རྩ་བ་སྟོང་པར་རྟོགས།",
    "བརྟུལ་ཤུགས་ཀྱིས་ལྷ་འདྲེ་དྲག་པོ་ཚར་གཅོད་ཅིང་མཐུ་མ་བྱས་ཀྱང་དགྲ་འཆི་བ་ལ་བྱའོ།",
    "ཐུགས་གྲུབ་པའི་རྟགས་རྟོགས་པ་ཁྱད་པར་ཅན་སྐྱེ་བ་ལ་བྱའོ།",
    "སྐུ་གསུམ་རང་ལ་གནས་པར་མ་ཤེས་པར་ལོགས་ནས་བསྒྲུབ་པར་འདོད་པས་འགྲུབ་པར་མི་༡༣༡བ་འགྱུར་རོ།",
    "སྙན་བརྒྱུད་ཀྱི་གདམས་ངག་མེད་པས་ངོ་སྤྲོད་མ་ཤེས་པར་རྒྱུད་ལ་མ་སྐྱེས་པའོ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་སྙན་བརྒྱུད་ཀྱི་གདམས་ངག་ཡོད་པས་ལྷ་སེམས་སུ་ཤེས་སེམས་སྟོང་པར་ཤེས།",
    "བར་དུ་བསམ་པ་བྱས།",
    "སེམས་འཁྲུལ་པར་ཤེས་པས།",
    "སེམས་ཐུགས་རྗེ་ཆེན་པོའི་དགོངས་པ་མཉམ་པ་རིས་མེད་ཀྱི་ངང་ལ་མཉམ་པར་བཞག་པས།",
    "རང་ལ་རྟོགས་པ་མེད་པར་གཞན་ལ་སྟོན་མི་ཤེས་སོ།",
    "དུག་ལྔ་མ་འགགས་པར་རང་ཤར་མ་སྤངས་པར་རང་གྲོལ་དེ་རྗེས་མེད་དོ།",
    "གནོད་པར་བཟུང་ཡང་ཐ་མལ་གྱི་རྟོགས་པ་ཡིན།",
    "ཟས་ཀྱི་ཞེན་པ་མ་ཆོད་པར་ལྟོ་གོས་ཀྱི་ཞེན་པས་སྡིག་བསགས་པས་ཁ་ཟས་དུག་དང་འདྲེས་པ་ཟོས་པས་མཐར་ན་སྟེ་འཆི་བ་དང་འདྲའོ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་དགོངས་པ་ལ་དགྲ་གཉེན་མེད་པར་མཉམ་པ་རིས་མེད་དུ་གནས་སོ།",
    "བཅུ་གཉིས་པ་བདུད་ཀྱི་རྟགས་ལ་འཁྲུལ་པ་བཟློག་པར་ངེས་ཤེས་བསྐྱེད་པ་ནི།",
    "གཡེང་བས་ཁྱེར་བས་བདུད་དུ་ངོ་ཤེས་པར་བྱས་པ།",
    "བདུད་ངོ་མ་ཤེས་པར་བར་དུ་བདུད་ཀྱི་བར་ཆད་བྱས་ན་ལྷ་བདུད་དུ་བབས་པ་ཡིན་ནོ།",
    "བདུད་གང་ལ་ཡང་ཆགས་པ་དང་ཞེན་པ་མེད་པར་བྱའོ།",
    "ནམ་མཁའ་ལྟར་རྒྱ་ཚད་དང་བྲལ་བ་དེ་རྒྱུད་ལ་རྟོགས་པར་ངེས་ཤེས་བསྐྱེད་དོ།",
    "ལྟ་བ་རྟེན་མེད་དུ་རང་ལ་ཡོད་པར་མ་ཤེས་ན།",
    "བར་འདུས་བྱས།",
    "ནང་རྣམ་པར་རྟོག་པ་གང་ལ་ཡང་ཆགས་ཞེན་མེད་པར་རང་ཤར་རང་གྲོལ་དུ་བཏང་ངོ།",
    "རང་ལ་གནས་པར་རྟོགས་པ་ངེས་པར་ཤེས་པའོ།",
    "འབྲས་བུ་སྐུ་གསུམ་རང་ལ་གནས་པར་མ་ཤེས་པར་གཞན་ནས་སྒྲུབ་པ་ནི་རི་དྭགས་སྨིག་རྒྱུ་སྙེག་པ་དང་འདྲ་སྟེ།",
    "ལུས་ངག་ཡིད་གསུམ་ཐ་མལ་དུ་མ་ལས་པར།",
    "སྐྱོན་དུ་འགྲོ་བའི་རྫས་ནི་ཤ་ཆང་སྒོག་བཙོང་དང་མཚོན་སྦྱིན་པར་མི་བཏང་ངོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས་ལམ་འབྲས་བུ་དང་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "འབྲས་བུ་རྣམ་པར་དག་པས་སྐྱོན་གྱི་དྲི་མ་དང་བྲལ།",
    "ཟས་ནོར་སྤྱི་མ་ཡིན་པས་ཆོམ་པོ་བྱས་ནས་ཕྲོགས་པ་དང་མ་ཚོར་བར་བརྐུས་པ་ཡང་བཟོད་པར་བྱའོ།",
    "དེ་ལྟར་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས་ལམ་འབྲས་བུ་དང་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "དེ་ཡང་བཟོད་པ་ཐོབ་པས་ཚིག་ལ་བརྩོན་པར་བྱས་པས།",
    "ཡང་དག་པའི་དོན་ཕྱིན་ཅི་མ་ལོག་པ་ཚིག་བཞི་པ་ཅིག་ཐོས་པར་འདོད་པ་ལ་ཡང་།",
    "དེ་ལྟར་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྒྱུ་བྱས་ནས་ལམ་འབྲས་བུ་དང་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "དེ་ལྟར་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས།",
    "ཀུན་རྫོབ་སྒྱུ་མ་ཙམ་དུ་སྣང་ལ་རང་བཞིན་མེད་པར་བསྒོམ།",
    "དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས་ཤེས་རབ་ཀྱིས་ལམ་འབྲས་བུ་དང་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "དེ་ལྟར་རྟོགས་ནས་ཀུན་གྱི་དོན་མི་བརྗེད་པར་བྱེད་པས་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "དེ་ལྟར་ཐབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས།",
    "ཚོགས་དེ་གཉིས་དབྱེར་མི་ཕྱེད་པར་རྫོགས་པས་གཉེན་པོ་ཅིས་ཀྱང་མི་ཚུགས་པས་དཔའ་བར་འགྲོ་༡༤༡བ་བའི་ཏིང་ངེ་འཛིན་གྱིས།",
    "དེ་ལྟར་སྟོབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས་སྟོབས་ཀྱི་ལམ་འབྲས་བུ་དང་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ནི།",
    "དེ་ལྟར་ཡེ་ཤེས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྒྱུ་བྱས་ནས་ཡེ་ཤེས་ཀྱི་ལམ་འབྲས་བུ་དང་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "འོ་ན་མེད་དམ་བྱས་ན་མ་འགགས་ཏེ་རིག་པའི་རྩལ་དུ་ཤར།",
    "ཁྱད་པར་སྒོས་ཀྱི་དམ་ཚིག་གོ།",
    "གཉིས་པ་ཁྱད་པར་སྒོས་ཀྱི་དམ་ཚིག་ནི་མི་འདའ་བ་གསུམ་སྟེ།",
