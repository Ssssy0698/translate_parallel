    "ཁྲུས་དང་གཙང་སྦྲ་ལ་བརྩོན་པར་བྱ།",
    "དམ་ཚིག་ཉམས་པར་ཚུལ་བཞིན་དུ་བསྲུངས་ན།",
    "རྡོ་རྗེ་སློབ་དཔོན་གཉན་པར་བཀུར་དང་།",
    "ཡོ་བྱད་མངར་གསུམ་དཀར་གསུམ་དང་ལྡན་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་མེད་པར་འདོད་པ་ཞེ་ལ་སྒྲུབ།",
    "འཛབ་བཟླས་མི་བྱེད་པར་ལོང་གཏམ་བྱེད།",
    "གནས་ལུགས་བཞི་ལ་བཞག་ནས་རང་ལུས་ཐ་མལ་པར་བསྡད།",
    "བཅུ་དྲུག་པ་དམ་ཚིག་ཉམས་པའི་སྐྱོན་གྱིས་ཉམས་གྲིབ་གཞན་ལ་ཕོག་པར་བསྟན་པ་ནི།",
    "དམ་ཚིག་ཉམས་པའི་གྲིབ་མ་མི་གཙང་བ་དང་ཉམས་པ་གཙང་མ་ལ་འགོ་བས་དེ་ལ་འཛེམ་པར་བྱ།",
    "ལུས་ངག་ཡིད་གསུམ་གྱི་དམ་ཚིག་མི་༡༡༡བ་གཙང་བ་དེ་ཆེད་དུ་མི་བསྟེན་པར་ཕྱལ་བར་འཇོག།",
    "ཕྱི་མ་ལ་སྒྲིབ་པར་འགྱུར་བས་སྤང་བར་བྱའོ།",
    "བཅོ་བརྒྱད་པ་གསང་སྔགས་རིག་སྔགས་གཟུངས་སྔགས་གསུམ་ཡི་གེ་དྲུག་པ་ལ་མ་ལུས་པར་འདུས་པར་བསྟན་པ་ནི།",
    "སེམས་ཉིད་བརྗོད་བྲལ་གྱི་རྣལ་མ་ལ་འགོས་པ་མེད་པར་འབྱོར་ན་རྣལ་འབྱོར་གྱི་ངེས་ཚིག་ཡིན།",
    "གསུམ་པ་རྣལ་འབྱོར་བྱ་བའི་དུས་ནི་མི་ལུས་གཙང་མ་ཐོབ།",
    "བཞི་པ་རྣལ་འབྱོར་མ་བྱས་པའི་སྐྱོན་ནི།",
    "ལྔ་པ་རྣལ་འབྱོར་བྱས་པའི་ཡོན་ཏན་ནི།",
    "ཁྱད་པར་གྱི་རྣལ་འབྱོར་བཅུའོ།",
    "རྣམ་པར་སྨིན་པའི་རྣལ་འབྱོར་ནི།",
    "ཁྱད་པར་གྱི་རྣལ་འབྱོར་བཅུ་ལ།",
    "རྣམ་པར་གྲོལ་བའི་རྣལ་འབྱོར་ནི།",
    "བར་འདོད་ཡོན་ལ་སྐྱོན་དུ་མི་ལྟ་མ་ཞེན་མ་ཆགས་པར་སྤྱད་དོ།",
    "རང་སེམས་འོད་གསལ་འདུས་མ་བྱས།",
    "ཚེ་སྔ་ཕྱི་ཡོད་པར་ཤེས།",
    "ཉིན་པར་སེམས་རྩེ་དགའ་ལ་ཤོར།",
    "སྔགས་ཆེ་བའི་ཡོན་ཏན་དང་ལྡན་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ་ཞེས་གསོལ་བ་ཐོབ།",
    "མཉམ་པ་རིས་མེད་ཀྱི་ངང་ལ་མ་བསྡད་པར་ལུས་ངག་ཡིད་གསུམ་འཆལ་བར་བཏང་།",
    "མ་བྱིན་པར་ལེན་པ་ལ་ནི་བྱི་བ་བས་འགྲུས།",
    "མི་ཚངས་པར་སྤྱོད་པ་ལ་ནི་བོང་བུ་བས་དགའ།",
    "མྱོས་པར་འགྱུར་བའི་ཆང་ལ་ནི་རྒྱལ་འགོང་བས་གདུང་།",
    "མཆེད་གྲོགས་དང་མི་འགྲོགས་པར་སུ་དང་ཆང་ནས་འགྲོགས།",
