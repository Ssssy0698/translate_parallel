    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་སྟེ།",
    "གཟུགས་ཀྱི་འདུ་ཤེས་རྣམས་ལས་རྣམ་པ་ཐམས་ཅད་དུ་ཡང་དག་པར་འདས་ཏེ།",
    "ཐོགས་པའི་འདུ་ཤེས་རྣམས་མེད་པར་གྱུར་ཅིང་སྣ་ཚོགས་ཀྱི་འདུ་ཤེས་རྣམས་ཡིད་ལ་མི་བྱེད་པས་ནམ་མཁའ་མཐའ་ཡས་སོ་སྙམ་ནས་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་རྫོགས་པར་བྱས་ཏེ་གནས་པ་དང་།",
    "ཅི་ཡང་མེད་དོ་སྙམ་ནས་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་རྫོགས་པར་བྱས་ཏེ་གནས་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་དུ་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་རྫོགས་པར་བྱས་ཏེ་གནས་པ་སྟེ།",
    "དེ་ལ་བྱས་ལ་མ་བསགས་པའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "བྱས་ནས་ངོ་ཚ་བར་འཛིན་པ་དང་འགྱོད་པ་དང་སྨོད་པ་དང་འཆགས་པ་དང་མཐོལ་བ་དང་།",
    "སྤོང་བ་དང་ཕྱིན་ཅད་མི་བྱེད་པར་སྡོམ་པ་སྟེ།",
    "ལས་དེ་ལྟ་བུ་ནི་བྱས་པ་མ་བསགས་པའོ།",
    "དེ་ལ་བསགས་ལ་མ་བྱས་པའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ལས་གང་ལུས་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་བྱས་པ་དེ།",
    "སེམས་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་བྱས་ཤིང་ཚིག་ཏུ་ཡང་ལས་འདི་བྱའོ་ཞེས་སྨྲས་ལ་དེ་མ་བྱས་པ་སྟེ།",
    "ལས་དེ་ལྟ་བུ་ནི་བསགས་ལ་མ་བྱས་པའོ།",
    "དེ་ལ་བྱས་ཀྱང་བྱས་ལ་བསགས་ཀྱང་བསགས་པའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ལས་གང་བྱས་ནས་མི་འཛེམ་པ་དང་མི་ལྡོག་པ་དང་མི་འགྱོད་པ་དང་མི་སྨོད་པ་དང་མི་འཆགས་པ་དང་མི་མཐོལ་བ་དང་མི་འདོར་བ་དང་།",
    "མི་སྤོང་བ་དང་ཕྱིན་ཅད་མི་སྡོམ་པར་བྱེད་པ་སྟེ།",
    "ལས་དེ་ལྟ་བུ་ནི་བྱས་ཀྱང་བྱས་ལ་བསགས་ཀྱང་བསགས་སོ།",
    "དེ་ལ་བྱས་ཀྱང་མ་བྱས་ལ་བསགས་ཀྱང་མ་བསགས་པའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ལས་གང་ཆེད་དུ་མ་བསགས་པར་བྱས་པ།",
    "རྨི་ལམ་ན་བྱས་པའམ་བྱེད་དུ་བཅུག་པ་ལྟ་བུ་སྟེ།",
    "ལས་དེ་ལྟ་བུ་ནི་བྱས་ཀྱང་མ་བྱས་ལ་བསགས་ཀྱང་མ་བསགས་པའོ།",
    "ཀྱང་ལས་དེ་བྱས་པས་ངོ་ཚར་མི་འཛིན་མི་འགྱོད་མི་སྨོད་པ་དང་མི་འཆགས་མི་མཐོལ་ཞིང་ཕྱིན་ཅད་མི་སྡོམ་ལ་ཕྱིར་ཞིང་དགའ་བ་དང་ཉམས་བདེ་བ་སྐྱེད་པ་སྟེ།",
    "ལས་དེ་བྱས་པས་ངོ་ཚ་བར་འཛིན་ལ་འགྱོད་ཅིང་སྨོད་པ་དང་འཆགས་ཤིང་མཐོལ་ན་ཕྱིན་ཅད་མི་བྱའོ་ཞེས་སྡོམ་པར་བྱེད་པས།",
    "ཤིན་ཏུ་མི་བཟད་ལས་རྣམས་བྱས་པ་ནི།",
    "བདག་ལ་སྨོད་དང་རབ་ཏུ་བཤགས་པ་དང་།",
    "སྡོམ་པར་བྱེད་པས་དེ་དག་སྲབས་འགྱུར་གྱིས།",
    "གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དེ་ལ་ངེས་པར་སྐྱེ་བར་འགྱུར་བའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ལས་དེ་ལྟ་བུ་ནི་ངེས་པར་སྐྱེ་བར་འགྱུར་བའོ།",
    "དེ་ལ་མ་ངེས་པར་སྐྱེ་བར་འགྱུར་བའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ལས་དེ་ལྟ་བུ་ནི་མ་ངེས་པར་སྐྱེ་བར་འགྱུར་བའོ།",
    "དེ་ལ་ཡུལ་གཞན་དུ་རྣམ་པར་སྨིན་པར་འགྱུར་བའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "དེ་ནི་ཚེ་འདི་ཉིད་དམ་ཚེ་གཞན་ལ་ཡུལ་གཞན་དུ་བདེ་བའམ་མི་བདེ་བ་རྣམ་པར་སྨིན་པ་སྟེ།",
    "གྲོགས་པོ་རྣམས་ཀྱིས་ངེས་པར་མི་འདོང་དུ་མི་རུང་ངོ་ཞེས་བསྒོ་ནས།",
    "མས་བདོག་པ་ཐམས་ཅད་བསོགས་ནས་རྐང་པ་ཡ་གཅིག་ནས་བཟུང་སྟེ་མི་འགྲོ་བར་བྱས་པ་ལས།",
    "དེས་མ་ལ་མ་བྱས་པར་རྒྱ་རྫས་ཐམས་ཅད་ཕྱིར་བཏོན་ནས་དེ་ལམ་དུ་འཇུག་པར་བྱས་པ་དང་།",
    "དེའི་མས་སྒོ་ཁར་བསྡད་དེ་རྐང་པ་ནས་བཟུང་བ་དང་བུ་མ་འགྲོ་ཤིག་ཅེས་བྱས་པ་དང་།",
    "རྒྱ་མཚོར་འཇུག་པར་ནི་བྱ་ན་འཚོ་འམ་མི་འཚོར་ཡང་གཏོལ་མེད་ཀྱིས།",
    "རལ་གྲི་འཁོར་ལོ་མགོ་ལ་འཁོར་ཞིང་གཅོད་པ་འདི་ཡིན་ནོ་ཞེས་བྱས་པ་དང་།",
    "མི་དེ་ཡང་དེར་ཚེ་འཕོས་པར་གྱུར་ཏོ།",
    "དེ་སྐད་ཅེས་བརྗོད་དེ་བསྡད་པ་དང་།",
    "ལོ་དྲུག་ཅུ་ཡང་མ་ལོན་པར་ཚེ་འཕོས་པར་གྱུར་ཏེ།",
    "དགེ་སློང་དག་དེའི་ཚེ་དེའི་དུས་ན་དེད་དཔོན་གྱི་བུ་བྱམས་པ་མཆོད་སྦྱིན་ཞེས་བྱ་བ་དེ་གཞན་ཞིག་ཡིན་པར་སེམས་ན་དེ་ནི་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "དགེ་སློང་དག་ཁྱེད་ཀྱིས་འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ཡུལ་གཞན་དུ་བདེ་བ་དང་སྡུག་བསྔལ་ཉམས་སུ་མྱོང་བར་གྱུར་པའི་ལས་དེ་ལྟ་བུ་ནི་ཡུལ་གཞན་དུ་རྣམ་པར་སྨིན་པར་འགྱུར་བའོ།",
    "དེ་ལ་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐད་ཅེས་གསུངས་ཏེ།",
    "ཇི་ལྟར་ན་ཚེ་འདི་འདི་ལ་རྣམ་པར་སྨིན་པ་མཚུངས་ཤིང་མཉམ་པ་ཡིན་ཞེ་ན།",
    "རྒྱལ་པོར་འགྱུར་བའི་ལས་ཀྱང་བྱས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཚིགས་སུ་བཅད་དེ་གསུངས་པ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དང་།",
    "དེ་ལས་བདེ་བ་འཐོབ་པར་འགྱུར།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཕ་མ་ལ་རིམ་གྲོ་བྱས་ན།",
    "ཚེ་འདི་ལ་འབྲས་བུ་རྣམ་པར་སྨིན་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཇི་ལྟར་ན་བཅོམ་ལྡན་འདས་དང་ཕ་མ་ལ་ཞེ་སྡང་བར་བྱས་པའི་སེམས་ཀྱིས།",
    "དེ་ལྟ་ཡིན་ཡང་ཕ་མའི་ཚིག་ནི་ཐམས་ཅད་མཉན་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "ལ་ལ་ལོག་པར་ལྟ་བ་དང་ལྡན་པ་དག་བུ་ལ་འདི་སྐད་ཅེས་ཟེར་ཏེ།",
