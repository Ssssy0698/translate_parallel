    "དེ་ཙམ་གྱིས་ཆོག་ཤེས་མི་བྱ་བར་ཚེ་དང་སྒྲུབ་པ་སྙོམས་པའི་དམ་བཅའ་རྡོ་ལ་རི་མོ་བྲིས་པ་ལྟ་བུ་ཞིག་ནམ་ཡང་བརྗེད་དུ་མེད་པ་སེམས་ཀྱི་གུགས་ནོར་བྱས་ནས་ཇི་སྲིད་སངས་མ་རྒྱ་བར་དུ་བརྩོན་པ་རྒྱུན་རིང་ལ་ཤུགས་དྲག་པོ་ཞིག་དགོས་སོ།",
    "ཟས་གོས་ངན་ངོན་སློང་མོ་དང་ཕྱག་དར་ཁྲོད་ཀྱི་གོས་རྣམས་འཆང་ཞིང་འདོད་པ་བསོད་སྙོམས་ཀྱི་མཐའ་ལ་མ་ཀུང་བར་དང་།",
    "ཁྱད་པར་ཡུལ་བུད་མེད་ལ་ཆགས་པ་འདིས་འདི་ཕྱི་ཀུན་ཏུ་གནོད་ཚབས་ཤིན་ཏུ་ཆེ་བ་དུག་ཧ་ལ་ལྟ་བུ་ཡིན་པས་དེའི་ཉེས་དམིགས་རྒྱུ་སྒྲུབ་དཀའ་བ།",
    "དེ་ཡང་བུད་མེད་ཀྱི་ལུས་ལལྤེགས་པར་བརྟགས་ན།",
    "ཁྱད་པར་བུད་མེད་མ་སྲིང་ཡིན་ཡང་བསྟེན་མི་བྱ།",
    "ཁྱིམ་པའི་བུད་མེད་ནི་རྒྱུན་དུ་གྲོང་དུ་སྡོད་པ་དང་གཞན་གྱིས་བདག་ཏུ་བཟུང་བས་དང་།",
    "བཙུན་པ་ཁྱིམ་དུ་སྡོད་ན་མནའ་མ་སོགས་བུད་མེད་རྣམས་བསླུ་ཁྲིད་མཁས་པ་དང་།",
    "བདེན་པ་གཉིས་ཀྱི་རྣམ་བཞག་ཞིབ་མོ་ཤེས་དགོས་ཀྱང་གཞན་དུ་ཤེས་པར་བྱ་བ་ལས་འདི་ཡི་གེ་མང་དུ་དོགས་ལ།",
    "དེས་ན་ཕུང་པོའི་རྒྱུན་ལ་དམིགས་པ་གང་ཟག་གི་བདག་འཛིན་དང་དེའི་ཡུལ་གང་ཟག་ཡིན།",
    "བྱིས་པ་ནས་རྒན་པོའི་བར་རགས་པ་འགྱུར་བས་མི་རྟག་ཕྲ་བ་སྐད་ཅིག་གིས་ཆུ་རྒྱུན་བཞིན་མི་རྟག་གཅིག་པུ་ཡིན་སྙམ་ན་མ་ཡིན་ཏེ།",
    "སྐྱེས་པ་བུད་མེད་སོགས་ཀྱི་གཟུགས་སུ་མ་གྲུབ་པས་གཟུགས་མཐོང་རྒྱུ་དང་།",
    "ཕྱག་རྫོགས་ཀྱི་ལྟ་བ་ནི་འདི་སྔོན་དུ་སོང་ནས་སེམས་ཀྱི་གནས་ལུགས་ལ་བརྟགས་པའི་སོ་སོ་རང་རིག་ཡེ་ཤེས་མཉམ་བཞག་ཡེ་ཤེས་ཀྱི་ལྟ་བ་ཞེས་བྱ།",
    "རང་གིས་ཉན་ཏེ་གསུངས་པ་བཞིན་གོ་བ་དེ་ཡིན།",
    "བསམ་གཞིག་གིས་གཏན་ལ་ཕབ།",
    "ཁྱད་པར་བླ་སྤྲུལ་མཁན་གསུམ་དང་བེེར་མོ་བ་དད་ཟས་དང་གཤིན་དཀོར་ཟ་བ་དང་།",
    "དེ་དང་བྲལ་ན་ཤི་གསོན་སུ་ལ་ཡང་མི་ཕན་ཞིང་རང་ལ་ཉེས་སྒྲིབ་མི་ཛིད་བསྐྱེད་ཅིང་ངན་སོང་རུ་འགྲོ་ངེས་པས་ཤིན་ཏུ་གལ་ཆེའོ།",
    "དེ་ལྟར་བློ་ག་རྣམ་བཞི་དང་སེམས་བསྐྱེད་ཡན་ཆད་ལ་ཞག་གྲངས་བརྒྱ་དང་བརྒྱད་ལ་བློ་སྤྱོང་ཚད་དང་ལྡན་པར་བྱས་ནས་ཞི་ལྷག་གི་ཏིང་ངེ་འཛིན་ལ་མྱོང་བ་ཅུང་ཟད་ཐོན་པར་བྱ།",
    "བསྙེན་སྒྲུབ་ཡན་ལག་བཞི་ལྡན་དུ་དུས་གྲངས་རྟགས་གསུམ་གང་རུང་གི་བསྙེན་ཚད་ཐོན་པར་བྱ།",
    "གསུམ་ལ་སྐྱབས་སོང་ལས་འབྲས་ཡིད་ཆེས་ངང་།",
    "བདག་ཉིད་ཉོན་མོངས་རྦ་རླབས་ཁྱེར་བཞིན་དུ།",
    "འདི་བྲིས་རྐྱལ་རྩེད་ཟོལ་འདི་མི་འོས་མོད།",
    "སྤྱན་རས་གཟིགས་མགོན་དེ་དང་མཚུངས་པར་ཤོག།",
    "ན་མོ་གུ་རུ་བིཅ་བོ་རྙི་ས་ཏྭ་ཡ།",
    "མཐོང་ཐོས་དྲན་རེག་རིག་འཛིན་ས་འགོད་ཕྱིར།",
    "ཆུ་མིག་བརྒྱ་དང་མཚོ་མོ་བརྒྱ་རྩ་བརྒྱད།",
    "མངོན་སུམ་ཞལ་གཟིགས་ལུང་བསྟན་ངེས་པར་འོང་།",
    "བཛྲ་གུ་རུ་ཌཱ་དྲིལ་རོལ་མོའི་སྒྲ།",
    "མཚན་མོ་ཡེ་ཤེས་མེ་དཔུང་རབ་ཏུ་འབར།",
    "རི་སྐད་ཐམས་ཅད་སྟག་མོ་མཆོང་བ་འདྲ།",
    "སྨྱོ་ཤུལ་ཨ་ངག་ཉིན་མོ་གཏེར་སྟོན་སོགས།",
    "རབ་དཀར་གངས་རི་པདྨ་གསུང་གི་གནས།",
    "ལྟ་བ་དྲི་མེད་གངས་དཀར་གནམ་ལ་རེག།",
    "མ་ལུས་རྡུལ་སྙེད་ཞིང་གི་རྟེན་དང་བརྟེན།",
    "ཅི་ལྟར་རེ་བ་སྐོང་བ་དེ་བཞིན་དུ།",
    "མཐར་ཐུག་འདུས་པའི་རིག་འཛིན་ཕོ་མོ་རྣམས།",
    "ངན་སོང་སྐྱེ་སྒོ་ཆོད་པ་ཐེ་ཚོམ་མེད།",
    "ནང་གི་སྲུང་མ་སྐྱེས་བུ་གིང་བདུད་བཅས།",
    "སི་ཁྲོན་མི་རིགས་དཔེ་སྒྲུན་ཁང་གིས་པར་དུ་བསྒྲུན་ནས་བཀྲམ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་ལ་སྙོམས་པར་བཞུགས་སོ།",
    "དམ་ཚིག་གི་རིམ་པ་བཀའ་སྩལ་པ།",
    "ཐུན་མོང་བརྒྱད་དང་བཅུ་བཞི་སྟེ།",
    "དཔའ་བོ་དཔའ་མོ་དམ་ཚིག་བསྲུང་།",
    "རང་གི་སྤྱོད་དང་གཞན་སྤྱོད་ལ།",
    "ངག་གི་ཉེས་སྡོམ་གསུམ་དུ་གསུངས།",
    "ཧཱུྃ་གི་ཁ་དོག་ནག་པོ་ཡིས།",
    "གསུང་གི་མཁའ་འགྲོ་བཅུ་གཉིས་སུ།",
    "རང་གི་དམ་ཚིག་བསྲུང་བའི་ཕྱིར།",
    "མཚན་མོ་ཤེས་རབ་གྱུ་གསུང་ཐུགས།",
    "ཉིན་མོ་ཐབས་ཀྱི་སྐུ་གསུང་ཐུགས།",
    "རང་གི་རྣལ་འབྱོར་ཤོར་མི་བྱ།",
    "བདག་གི་བཅུ་བཞི་ཡིན་པར་གསུང་།",
    "བཙུན་མོ་དམ་ཚིག་གིས་བརྒྱན་མཛེས།",
    "བྃ་ནི་གསུང་གི་དམ་ཚིག་གོ།",
    "མ་ནི་ཐུགས་ཀྱི་དམ་ཚིག་གི།",
    "ངག་གི་ཉེས་པ་སྣ་ཚོགས་སྨྲ།",
    "ལག་གི་རྫས་རྣམས་མི་ཐུབ་ཅིང་།",
    "བཞི་ནི་ཡིན་པར་གསུངས་པའོ།",
    "བུད་མེད་འདུ་ཞིང་དགའ་བར་འགྱུར།",
    "མཁའ་འགྲོ་རྣལ་འབྱོར་མ་མོ་སྟེ།",
    "ངག་གིས་ཕྲ་མའི་ཚིག་སྨྲས་ཀྱང་།",
    "ཨེ་མའོ་རྒྱུད་ནི་ངོ་རེ་མཚར།",
    "ཉོན་མོངས་བྱིན་གྱིས་རློབ་པ་དང་།",
    "ཉོན་མོངས་པ་སྤྱོད་པ་དང་།",
    "དབྱིབས་དང་ཁ་དོག་གི་དམ་ཚིག་གིས་ཉོན་མོདས་པ་རང་བཞིན་གྱིས་གྲོལ་བའོ།",
    "མཆོད་རྟེན་བསྐོར་བ་ལ་སོགས་ལུས་ངག་གི་སྤྱོདཔ་གཙོ་བོར་གསུངས་པ་ཡིནནོ།",
    "ཏེ་རྡོ་རྗེ་རྩེ་མོར།",
    "འབྲས་བུ་སྐུ་གསུམཐུནམོང་གྲུབ།",
    "རང་གི་། སེམས་ཀྱི་ཆེས་ཉིད་རང་བཞིན་གྱི་རྟོག་པའི་དྲི་མ་ཐམས་ཅད་དང་བྲལ་བ་ཡིན་ཏེ།",
    "འབྲས་བུའི་རྒྱུད་ནི་གནས་སྐབས་ཐུནམོང་གི་འབྲས་བུམཁའ་སྤྱོད་དང་།",
    "དང་པོ་སྦྱོར་བ་དང་དྲཀྱིལ་འཁོར་རྒྱལ་མཆོག་དང་ལྷ་རྒྱལམཆོག་གི་ཏིང་ངེ་འཛིན་གསུམ་ལྷ་བསྐྱེད་ཚུལ་ཕལ་ཆེར་ལ་མཐུན་བཅུ་གཅིག་པར་སྟོན་པ་བསྐྱེད་པའི་རིམ་པ་སྤྱི་དང་།",
    "རིམ་པ་ལྔའི་ཟུང་འཇུག་གི་རིམ་པ་ལས་ལྷག་པའི་ལམ་མེད་པས་ལམ་གྱི་མཐར་ཐུག་དད།",
    "རང་རང་གི་མཐར་ཐུག་གི་དོན་ཐུག་ཏུ་གསུངས་པ་ལྟ་བུའོ།",
    "རྗོད་བྱེད་ཡི་གེའི་དོན་ནི་ཐུནམོང་གི་རིག་པ་ངེས་བརྗོད།",
    "ག་ལས་བ་ལང་གི་ཤ།",
    "ཞེས་པས་ངེས་དོན་ཟབ་མོ་བསྟན་པའི་སྣོད་དུ་མི་རུང་བའི་གང་ཟག་ཐེ་ཚོམ་དང་ཡིད་གཉིས་ཅན་རྣམས་ལ།",
    "དང་ཞི་རྒྱས་ལ་སོགས་པའི་དངོས་གྲུབ་ཕྲ་མོ་སྟོན་པ་དྲང་དོན་དང་ཟབ་མོ་བསྟན་པའི་སྣོད་དུ་རུང་བའི་གདུལ་བྱ་སྐལ་ལྡནལ།",
    "ཤིན་ཏུ་ཟབ་པའི་དོན་འཇིག་རྟེན་གྱི་ལུགས་དང་འགལ་བའི་བཅུ་བཞི་ཚིགགིས་སྟོན་པ་དགོངས་པ་དང་།",
    "ཚིགགི་ཐ་སྙད་སྤྱོད་པའི་ཤེས་རབ་དམན་ཅིང་ཤིན་ཏུ་ཟབ་པའི་དོན་བསྟན་པའི་སྣོད་དུ་རུང་པ་ལ།",
    "རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁེར་འདྲིའཝཟིག་༤ལོ།",
    "རང་རྒྱུད་ལ་ངེས་བཡང་དག་པར་དྲངས་ནས་སྐལ་བ་དང་ལྡན་པ་དག་ལའང་རྡོ་རྗེའཆང་གི་དགོངས་བམ་ལ་ཡུན་རིང་དུ་གོམས་པར་བྱས་ཏེ།",
    "ཚིག་པ་ལ་མཁསཀྱང་མྱུར་དུ་བརྗེད་པར་གྱུར་ཏེ་བསམ་བྱུང་གི་ཤེས་རབ་ཀྱིས་གཏན་ལ་འབེབས་པར་མི་ནུས་པས་ཨུཏ་པལ་ལྟ་བུ་དང་།",
    "ཉིན་རེ་བྲམ་ཟེ་གསོད་པ་དང་།",
    "དངགསོ་སྦྱོང་ཞག་རེ་ཙམ་བླངས་པ་ལ།",
    "ཀུན་རྫོབ་བསྐྱེད་པའི་རིམ་པ་ལ་བརྟེནནས་ཐུན་མོང་གི་དངོས་གྲུབ་དོན་དུ་གང་ཟག་ལཾ།",
    "དོན་དམ་རྫོགས་རིམ་ལ་བརྟེནནས་མཆོག་གི་དངོས་གྲུབ་འདོད་པའི་གང་ཟགལ།",
    "དེ་ལ་རབ་དང་འབྲིང་གི་གཏི་མུག་གི་རིགས་ཅན་ལ་རྒྱུད་བསྟན།",
    "དམན་པ་དང་བར་མའི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གི་གྲས་ཅན་རྣམས་ལ་རྣལ་འབྱོར་གྱི་རྒྱུད་བསྟན་ཏོ།",
    "འབར་བ་ཀྱི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གི་རིགས་ཅན་རྣམས་ཁུ་ལ་རྣལ་འབྱོར་མའི་རྒྱུད་བསྟན་ཏོ།",
    "ཞེས་གསུངས་པ་ལྟར་ཉོན་མོངས་པ་གཞན་ཐམས་ཅད་ཀྱི་རྩ་བ་ཡང་གཏི་མུག་ཡིན་པས།",
    "ལས་དང་པོ་པས་ཁམས་དངས་པར་བྱ་བའི་ཕྱིར་སྲོག་ཆགས་མེད་པའི་ཆུ་གཙདི་གིས་དུས་གསུམ་དུ་ཁྲུས་བྱེད་པ་དང་།",
    "ཐོག་མར་ནང་གི་དམིགས་པ་ལ་རྩེ་གཅིག་ཏུ་འཇོག་མི་ནུས་པས་ཕྱི་རོལ་གྱི་རས་བྲིས་ལ་སེམས་བཟུང་ནས་ཉམས་སུ་ལེན་པ་ཡིནནོ།",
    "རང་གི་ལུས་ངག་ཡིད་གསུམ་མཚུངས་ཤིང་ཁྱད་པར་མེད་པར་གྱུར་པའི་ཚེ་གྲུབ་པ་ཡིནནོ།",
    "ཡིད་རྣམ་པར་དག་པ་དདལྡན་པ་དེ་ཚེ་རྣམ་པ་ཐམས་ཅད་དུ་བརྟག་པརབདགགི་ལུས་དང་ལྷའི་གཟུགས་མཚུངས་པ་དང་།",
    "བདག་གི་ངག་དང་ལྷའི་ངག་ཏུ་མཚུངས་པ་དང་།",
    "བདག་གི་ཡིད་དང་ལྷའི་ཡིད་དུ་མཚུངས་པར་མཐོང་བ་དེའི་ཚོ་མཉམ་པར་བཞག་པ་ཡིནནོ།",
    "ཕུང་པོ་ལྔ་དང་ཉོན་མོངས་ལྔ་ལ།",
    "བདག་གི་ལུས་ངག་ཡིད་གསུམ་བྱ་བ་དང་བཅས་པ་རྒྱལ་བའི་སྐུ་གསུང་ཐུགས་ཕྲིན་ལས་སུ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "རྩེ་དགའབར་བྱེདཅིད་རྡོ་རྗེའི་ཚིག་གིས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་མྱུར་བར་དངོས་གྲུབ་ཏུའགྱུརའོ།",
    "སྤྲུལ་པའི་སྐུནིམཚན་དཔེས་སྤྲས་པའི་དབྱིབས་དང་ཁ་དོག་གི་རྣམ་པ་ཅན་དུ་སྣང་པའི་ཕྱིར་གཟུགས་སུ་གནས་པའོ།",
    "འགའ་ཞིག་ཏུ་ཐིག་གི་གདུབ་ཚུལ་ཞིབ་མོ་འབྱུང་ཡང་ཅུང་ཟད་གོ་དཀའ་བར་སྣང་དོ།",
    "རྒྱུད་ཕལ་མོ་ཆེར།",
    "དེཆ་མཉམ་པ་བཞིར་བགོས་ནས་ཤར་ནུབ་ཀྱི་ཆ་རེ་རེ་དོར་ལ།",
    "གཡས་པས་རྩེ་མོ་གཅིག་ཤོས་བཟུང་ནས་བྱད་དང་ལྷོའི་ཕྱོགས་སུ་དྲུད་ནས་ས་རིས་བྱའོ།",
    "དེལྟརལྷོ་བྱང་དུ་བྱ་རོག་རྗེས་གཉིས་བྱུང་པའི་སྟེད་དུ་ཚངསཟིགགཉིས་པ་གདབ་བོ།",
    "སྒོ་ཁྱུདནང་གི་ཀྱུས་ཆ་ཆུང་གཉིས།",
    "སྒོ་འགྲམ་དང་ནང་གི་ངོས་ཆ་ཆུང་གཉིས།",
    "སྒོ་ལོག་དང་ནང་གི་དཀྱུས་ཆ་ཆེན་བཞི།",
    "ཆ་ཕྲ་མོ་རྣམས་ཐིགཤིང་གིས་འབྱེད་པ་ཡིན་ནོ།",
    "ནངགི་ཀ་བ་ལ་ངོས་འཛིན་པར་བཀག་པས།",
    "ཐིག་གདབ་པའི་ཚུལ་ཞིབ་པར་བྲམ་མཁས་པ་དག་གིས་མང་དུགསུངས་པའི་ཕྱིར་འདིར་མ་བྲིས་སོ།",
    "ཧཅང་ཐལ་བའི་ནོར་པ་སུན་དབྱུང་བ།་",
    "བྱིན་བརླབས་ཀྱི་བརྒྱུད་པ་མ་ཉམས་ག་གདམ་ངག་གིས་ས་ཀ་མ་ལོག་པ།",
    "དེང་སང་རྡོ་རྗེ་ཕགམོ་ཡི།",
    "དེས་ན་རྡོ་རྗེ་ཕག་མོ་ན།",
    "ཐོག་མར་བདེ་མཆོག་གི་དཀྱིལ་འཁོར།",
    "དེ་ནས་རྡོ་རྗེ་ཕག་མོ་སྦྱིན།",
    "དེས་ན་རྡོ་རྗེ་ཕག་མོའི་བྱིན་བརླབས་ཀྱི་ཚེ་གནམཆོག་གི་དངོས་གྲུབ་ཐོབ་པའི་རྐྱེན་གྱི་ཡན་ལག་ཏུ་རུང་གི་རྒྱུའི་རང་བཞིན་དུ་མི་རུང་ངོ།",
    "རྡོརྫོབགམོ་བྱིན་བརླབས་འབྲེལ་བསྒྲིག་ཚུལ་གང་ཡང་མ་གོ་བར་རྣལ་འབྱོར་བླ་ན་མེདཔའི་ཉམས་ལེན་བྱེད་པར་རློམ་པ་འགའ་ཞིག།",
    "དགེ་སློངགི་སྡོམ་པ་འབོགས་པའི་ཆོ་གལ་མང་པོ་ཡོདནའང་།",
