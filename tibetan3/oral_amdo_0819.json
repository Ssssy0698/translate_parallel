    "ཕྱག་རྒྱ་ཆེན་པོམྱུར་དུ་འགྲུབ་པའི་ཉམས་མྱོངགི་དྲོད་རྟགས་ལ་ངེས་པ་ཐོབ་པས།",
    "ཕྱི་རོལ་གྱི་ཡུལཉོན་མོངས་པའི་དམིགས་རྐྱེན་དུ་གྱུར་པ་རྣམས་ཀྱིས་ཚུལ་ཟིལ་གྱིསམ་ནེན་ཅིང་།",
    "ཕར་ཟིལ་གྱིས་མནན་ནས་རིམ་གཉིས་ཀྱི་གྲོགས་སུ་འཁྱེར་ནུས་པ་ཞིག་གིས་སྤྱོད་པ་བྱེད་པ་ཡིནནོ།",
    "རང་གི་ཏིང་ངེ་འཛིན་ནི་བརྟན་པར་བྱ་བའི་ཕྱིར་མི་ལྕགས་དར་ན་རོབས་དང་ཕྲུ་ཆག་དང་ཉེ་བར་མཁོ་བ་གང་རྙེད་ལ་བླང་དོར་དང་བཟང་ངན་གྱི་ཅུངུ་ཤེས་སྤངས་ནས་དུར་ཁྲོད་དང་འབྱུང་པོའི་ཁྱིམ་ལ་སོགས་པས་མཚནམོའི་དུས་སུ་ཉམས་ལེན་བྱེད་ཅིང་།",
    "ཕ་རྒྱུད་པའིལུགསགཙོ་ཆེ་བའི་སྤྱོད་པ་གསུམ་ནི་ལྷ་གྲངས་དང་མཐུན་པའི་རྣལ་འབྱོར་ཕོ་མོ་འདུས་ནས་སྒྱུ་ལུས་ཀྱི་ཏིང་ངེ་འཛིནནམ་ཟུང་འཇུག་གི་རྟོགས་པ་གང་རུང་གི་ངང་ནས་རྟེན་དང་།",
    "ལུས་ཀྱི་སྤྱོད་ལམ་བློ་གཡས་པ་ཕབ་སྟེ་ཉལ་བས་དུས་དགེ་སྡིགགི་རྟོགས་པ་ཐམས་ཅད་སྤངསནས་གཉིད་འོད་གསལ་གྱི་ངོ་བོ་ཉིདདུའདུས་འདའ་བར་བྱེད་པ་ཡིན་ནོ།",
    "རྡོ་རྗེ་འཆང་གི་ཐུགས་སྲས་གསང་སྔགས་ཀྱི་བསྟན་པ་འཛིན་པའི་སྐྱེས་བུ་འཇིག་རྟེན་ལྷ་དང་བཅས་པའི་ཡོངསསུ་འཛིན་པ་ཆེན་པོ་ཡིན་ནོ།",
    "རང་གི་དམ་ཚིག་ཡོངས་སྤངས་ནས།",
    "ངན་སོང་གསུམ་དུ་འགྲོ་བར་འགྱུར།",
    "སླར་ཡང་བུད་མེད་རྟག་ཏུ་ཆགས།",
    "ལྟ་བ་དང་སྤྱོད་པ་རྡོ་རྗེ་འཆང་གི་གསུང་དང་མཐུན་པའི་བླང་དོན་ལ་ཞིབ་ཏུ་དགོངས་ནས་མཛད་འཚལ་ལོ།",
    "སྐྱེ་བ་སྔམའི་ལས་འཕྲོ་བཟང་ངན་དང་ནུས་པ་ཆེ་ཆུང་གི་བྱེ་བྲག་དུ་མ་ཡོད་བས།",
    "དེ་སད་པར་བྱེད་པའི་རྐྱེན་རྡོ་རྗེའི་ལུས་ལ་བརྟེན་པའི་རྩ་ཁམས་ཀྱི་ནུསཏེ་པ་རྐྱེན་གང་གིས་འཆིང་ཞིང་།",
    "ཐོག་མར་སྨོན་འཇུག་གི་སེམས་བསྐྱེད་བླངས་ནས་མ་ཉམས་པར་སྲུང་བ་དང་།",
    "མོན་སྲན་དང་།",
    "སྡུག་བསྔལ་བའི་རྒྱུ་ལས་དང་ཉོན་མོངས་པ་སྤོངས་བའི་ལམཉེ་བར་སྟོན་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་ཕག་མོའི་བྱིན་བརླབུས་མེད།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ཞེས་བྱ་བའི་མིང་གི་ཐ་སྙདཀྱང་གཏན་ནསམེད་དོ།",
    "སེམས་ཀྱི་བག་ཆགས་ལས་བྱུང་བ་ཙམ་དུ་ཤེས་ནས་མོཉམ་པར་འཇོག་པ་ནི་སྦྱོར་ལམ་དྲོད་ཀྱི་ཡེ་ཤེས་ཡིན་ལ།",
    "གཟུང་ཡུལ་ལ་སྔོན་གོམས་པའི་བག་ཆགས་ཀྱི་གཡོ་བ་དེ་ནི་རྩེ་མོའི་ཡེ་ཤེས་སོ།",
    "དེ་ལ་ལྟ་བརྟེན་ནས་རྣམ་བྱང་དུ་འཛིན་པའི་རྟོགས་པ་ཕྲམོ་གཅིག་ལུས་པ་དེ་བཟུང་ཡུལ་མ་གྲུབ་པས་འཛིན་པའང་མ་དམིགས་པར་ཤེས་ཏེ་ཀུན་རྫོབ་སེམས་ཀྱི་གསལ་ཆད་བཟུང་འཛིན་ཐམས་ཅད་ཀྱིས་སྟོང་པ།",
    "ནང་གི་སལམ་ཀུན་བགྲོད་ནས།",
    "ཕན་འདོགས་པ་དང་གནོད་པ་བྱེད་པའི་རོ་སྙོམས་པའི་རྟོགས་པ་ཤར་ནས་འཁོརའདས་མཉམ་ཉིད་དུ་བསྲི་བའི་ཕྱིར་རྒྱུདནས་གསུངས་པའི་རྣམ་དག་གི་སྤྱོད་པ་རྣམས་སྤྱོད་པས།",
    "འཐུང་གཅོད་མོས་པ་སྤྱོད་པའི་ས་དང་།",
    "གང་ཟག་སྐལ་བ་དང་ལྡན་ཅུང་དཀའ་སྤྱད་དང་དུ་ལེནནུས་པས་མྱུའི་དུ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པར་འདོད་ན།",
    "ཀྱེ་མ་གང་གི་བསྟན་པར་འགྱུར།",
    "མི་རིགས་བཞི་དེ་གང་གི་ནང་དུའངམི་ཆུད་དོ།",
    "སྤྱིར་མུ་སྟེགས་ལ་ངེས་འབྱུང་གི་སྡོམ་པ་མེད་པས་སྲོག་གཅོད་སྤོང་བ་དང་།",
    "སྔགས་ཀྱི་སྡོམ་པ་མེད་པའི་ཐབས་ལམ་ཟབ་མོ་ཅན།",
    "འཁོར་གྱི་ལྷ་རྣམས་ལའང་སྙོམས་འཇུག་གི་དོན་ཚད་བར་སྒྲུབ་བསྟོད་ཕྲིན་ལས་བསྒྲུབས་ལས་རྒྱལ་མཆོག་གི་ཏིང་ངེ་འཛིན་ཡིནནོབདག་གི་ལུས་གང་ཡིནམཚུདས་ཁྲོ་བོའི་སེམས་དཔའ་གཞན་དེའི་ལུགས་ཡིན་པ་དང་དགོས་ཏེ།",
    "བསྒོས་ཤིང་བག་ཆགས་དང་ནི་རྡོ་རྗེ་རྩེ་མོར།",
    "རྒྱུ་དང་མཆོག་གི་གནས་ཡིནནོ།",
    "དྲར་ས་བོན་དང་ཕྱག་མཚན་བསྐྱེད་པ་ནི་སྐྱེས་པ་དང་བུད་མེད་ལ་སོགས་པར་འཛིན་པའིའདུ་ཤེས་དང་དོ་ལ་མཚན་མར་བཟུང་བ་ལས་བྱུང་བའི་འདོད་ཆུགས་དབྱིབས་དང་ཁ་དོག་གི་རྣམ་པར་ཤར་བ་ལམ་དུ་བྱས་པས།",
    "མུ་སྟེགས་བྱེད་ཀྱི་གཏུམ་མོ་ལྟར།",
    "དེ་དགཉོནམོངས་རྣམ་རྟོག་དང་།",
    "ཅེས་པ་དེངསང་གཏུམ་མོ་བསྒོམས་ནས་གྲོས་རས་རྐྱང་གིས་ཆོག་པ་ངོ་མཚར་ཆེ་བར་འཛིན།",
    "ཉོན་མོངས་དང་རྣམ་རྟོག་དང་བདེ་བའི་ཉམས་ཁྲག་དང་།",
    "མོས་པ་བྱས་ཀྱང་ཚེ་འདི་ཡི།",
    "ལྟ་བར་བྱ་ཞེས་གསུངས་མོད་ཀྱི།",
    "ཐུན་མོང་མ་ཡིན་པའི་གསང་བ་ལས།",
    "དེ་བས་ན་དགེ་སློང་གི་སྡོམ་པ་མེད་པར་རབ་བྱུང་དུ་ཁས་ལེནཔ་དང་།",
    "ཡད་དག་ཁ་པའི་དོན་མ་རྟོགས་པའི་གཏི་མུག་གི་གནས་སྐབས་ཡིན་ཏེ།",
    "དེ་ཡུནནིད་དུ་གོམས་ན་སེམས་ཀྱི་གསལ་ཆ་ཙམ་ཡང་མི་སྣང་བའི་ཉེ་བའི་ཉོན་མོངས་པ་རྨུགས་པ་ཞེས་བྱ་བར་གོམས་པས་དུད་འགྲོར་སྐྱེ་བའི་ལས་ཡིན་ནོ།",
    "ཞིག་གནས་འདུག་པ་དག་མཉམ་མོ།",
    "འགཅིག་ཏུ་གྱུར་པའི་དོན་གྱིས་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཟུང་འཇུག་གི་རྟོག་པ་མངོན་དུ་གྱུར་པ་ལ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པ་ཞེས་རྡོ་རྗེ་འཆང་གིས་གསུངས་པ་ཡིནནོ།",
    "དེ་དག་གི་འབྲས་བུ་ཕྱག་རྒྱ་ཆེན་པོ།",
    "ཟབ་མོའི་ཏིང་ངེ་འཛིན་ནི་ཡོད་པར་སྟོན་པ་དང་།",
    "བདག་དང་བདགགི་ལ་སོགས་རྒྱུ་༡ ཆསམ་པ་རྟོག་པ་དེ་ནི་དེ་ཁོ་ན་ཉིད་ལ་ལྟ་བའི་སྐབས་འདིར་དམུས་ལོང་ཆེན་པོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "དེ་རྣམས་ལས་བྱུང་བའི་ཉམས་མྱོང་དང་ཡོན་ཏན་ཕྱོགས་རེ་ཙམ་རྒྱུད་ལ་སྐྱེས་པ་ནི་ལྷན་ཅིག་སྐྱེས་།",
    "ཡེ་ཤེས་ཆེན་པོ་རང་གི་རིག།",
    "དེའི་འགྲེལ་པ་ལྷ་ལྕམ་ལེགས་སྨིནཀ་ར་དཔལ་མོས་མཛད་པ་ལས་འདི་དག་ཞིབ་ཏུ་ཤེས་པར་བྱའོ།",
    "གང་གིས་དེ་ཤེས་དེ་གྲོལ་འགྱུར།",
    "བྱོལ་སོང་འཇིག་རྟེན་མི་གོ་ཇི་ལྟར་བྱ།",
    "བླུན་པོ་གང་གིས་བཅིངས་འགྱུར་བ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་རང་བཞིན་དེ་ཚེ་མཛེས། ། ཁྱིམ་བདག་ཟོས་ནས་ཁྱིམ་བདག་མོ་ལོངས་སྤྱོད།",
    "དེ་ཉིད་དྲི་མེད་མཆོག་གི་གོ་འཕང་ངོ།",
    "ཁམས་གསུམ་མ་ལུས་ཀུན་ཏུ་ཁྱབ་པར་སོང་།",
    "ལུས་སེམས་ཉོན་མོངས་དང་སྡུག་བསྔལ་སྣ་ཚོགས་ཀྱི་ཚད་པས་གདུངས་ཏེ་སྐྱེ་ཤི་ཁེ་ནས་དུས་འདའ་བར་ཟད་དོ།",
    "སྔ་མ་རྡོ་རྗེ་འཆང་གི་དབུགས་དབྱུར་དང་།",
    "མཆོག་གཅིག་གིས་ནི་ཤེས་པར་འགྱུར།",
    "ཤེས་དཀར་དམར་འདུས་ཤིང་བདེ་སྟོངགི་རོ་མྱོང་བ་ཤིན་ཏུ་རྣལ་འབྱོར་དང་།",
    "རིགས་དྲུག་པ་མཆོག་ཏུ་མི་འགྱུར་པའི་བདེ་བཆེན་པོ་རྡོ་རྗེ་འཆང་གི་ངོ་བོ་ཡིན་ལ།",
    "དེའི་ཁྱད་པར་རིགས་ལྔ་དང་ལྷམོ་ལྔ་དང་།",
    "དེ་ནི་གང་གིས་རྟོགས་དོན་དུ།",
    "ད་ནི་རྒྱ་གར་ཡང་ངན་པར་ཐལ་ལོ་ཞེས་གསུངས་སོ།",
    "དེས་ན་གསང་སྔགས་ཟབ་མོའིལམ་ཤིན་ཏུ་རྟོགས་པར་དཀའ་བས་ཉོན་མོངས་པ་དང་ཡེ་ཤེས་འདྲེས་པ་ལྟ་བུ་བླ་།",
    "ཁ་ཅིག་རྣ་བ་ལ་རེག་སྟེ་ཞིབམ་ལྟ་བུ།",
    "ཁ་ཅིག་རྨིག་པ་ལ་རེག་སྟེ་བརྟན་ལྟ་བུ།",
    "ཕྱོགས་གཞུང་ལ་རེག་སྟེ་རྐྱལ་པ་བུས་པ་ལྟ་བུ།",
    "ཕྱོགས་རེ་ཙམ་ཉམས་སུ་བླངས་པསགོམི་ཆོད་དོ།",
    "རྒྱལ་པོ་ཞིག་གིས།",
    "རིགས་དྲུག་གི་སྣང་བ་མ་འགགས་པར་ཤར་བ་འདི་མ་བཅེས་ས་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན་ཟེར་བ་དང་།",
    "རྒྱ་ནག་ཧོ་ཤཱང་གི་རྫོགས་ཆེན་གཉིས་ཀྱི་དོན་ལ་ཁྱད་པར་མེད་དེ།",
    "རྒྱལ་བརྒྱ་པོ་ཁྱོད་ཀྱི་བོད་ཡུལ་འདིར།",
    "ལྷོ་ཕྱོགས་ན་བྲམ་ཟེའི་བུམུ་སྟེགས་ཀྱི་རིག་བྱེད་ལ་ཤིན་ཏུ་མཁས་པ་ཞིག་གིས་ཕྱི་ནང་གི་རྒོལ་བ་རྣམས་ཕམ་པར་བྱས་ཏེ་སྙན་པར་གྲགས་པས་ཁེངས་ཤིང་ན་ལེནྡྲར་སོང་ནསམཁན་རྫོགབོ་ཞི་བ་འཚོ་ཕམ་པར་བྱས་ན་འགྲན་ཟླ་དང་བྲལ་བར་འགྱུར་སྙམ་དུ་སེམས་སོ།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་ཡུལ་ཁམས་སུ་ཕྱི་རོལ་མུ་སྟེགས་པ་མི་འབྱུང་སྟེ།",
    "དེའི་ཚཚེས་རྒྱལ་གྱི་ས་ཁྱོད་རེ་ཤིག་བལ་ཡུལ་དུ་བཞུགས་ཤིག།་",
    "ཁོ་བོས་ཅུང་ཟད་ཕན་པར་བྱའོ་ཞེས་བརྒྱ་གསུངས་ནས་ཐུགས་དམ་མཛད་ཆུ་ཁེལབས་ཚད་གྲང་མོར་གྱུར་ཏེ།",
    "ཁྱེའུ་དང་བུ་མོ་གཙང་མ་ལ་པྲ་འབེབས་པའི་ཆོ་ག་མཛད།",
    "བཀའ་ནན་དྲག་པོ་སྩལ་ཚོབས་མི་མ་ཡིན་རྣམས་ཀྱིས་རད་རད་གི་ཉེས་པ་ཁས་བླངས་ཤིང་ཕྱིན་ཆད་མི་བྱེད་པར་དམ་བཅས་སོ།",
    "ལྷ་བཙན་པོ་ཐུགས་མ་བདེ་བར་དམག་མང་པོ་དང་བཅས་ཏེ་བོད་དང་མོན་གྱི་སོ་མཚམས་སུ་བསྐྱལ་ལོ།",
    "གཟུངས་སྔགས་ཟབ་མོ་དང་གདམས་པ་བསྟན་ཏེ།",
    "བུད་མེད་ཀྱི་ལུས་སྤངས་ནས་སྐྱེས་པར་གྱུར།",
    "ད་། མེད་ཤིན་ཏུ་མང་པོ་སྐྱེས་པར་གྱུར་ཁྱིམ་སྤངས་ཤིང་རབ་ཏུ་བྱུང་བས་སྐྱེ་བོ་མང་པོ་མ་དད་པར་གྱུར་ཏེ་མཐའ་འཁོབ་ཏུ་སོང་ནས།",
    "དགེ་སློང་འཚཨུཏྤལའི་གདོང་གིས་དེ་རྣམས་དད་པར་བྱ་བའི་ཕྱིར་སོང་བས་སླར་ཡང་ཞེ་སྡང་བར་གྱུར་ཏེ།",
    "ལུས་ངག་གི་དགེ་སྦྱོང་རྣམས་འཕྲོ་བཅུདདོ།",
    "ལ་ལས་རང་གི་མཚནམ་རྡོས་བརྡུངས།",
    "ལན་ལེགས་པར་བཏབ་སྟེ་རེ་འཇིགས་ཤིག་འདུགགོ་གསུང་ངོ།",
    "ཅི་ཡང་མི་བསམ་མོ་ཞེས་ཟེར་བ་དེ་ནི་སོ་སོར་རྟོག་པའི་ཤེས་རབ་སྤངས་པ་ཡིན་ནོ།",
    "ཁྱུང་གི་ཕྲུག་གུ་ཐོགས་ནས་ལུས་ཡོངས་སུ་རྫོགས་པའི་འདབ་གཤོག་རྩལ་དང་ལྡན་པར་རང་བྱུང་བ་ནི་མི་སྲིད་པས་དང་པོར་སྒོ་ངའི་ནང་དུ་ལུས་བླངས་ཤིང་རིམ་གྱིས་སྨིན་པར་བྱས་ཏེ།",
    "ཤགས་འདེབས་པ་བསླབས་པའི་ཚེ་ཅི་ཡད་ཡིད་ལ་མ་སེམས་པར་ཉལ་བས་ཆོག་གོ་ཞེས་པའི་སྒྲོམ་ཡིག་བསམ་གཏན་ཉལཆོག་གི་འཁོར་ལོ་དང་།",
    "དེ་ལ་གཟིགསཔས་དེའི་དོན་རྟོགས་ཏེ་༦༤ སྟན་གཅིག་གི་ཐོག་ཏུ་སྒོམ་ཚུལ་ཞུས་པས་སྒོམ་རིམ་བར་པ་མཛད།",
    "དེ་ལྟརབས་ན་ཅི་ཡང་མི་བསམ་མོ།",
    "འདི་ལྟར་ཅི་ཡང་མི་བསམ་མོ་ཞེས་སྨྲ་བནི།",
    "བདག་གི་ལྟ་བ་མཆོག་ཏུ་འཛིན་པ།",
    "རིག་པ་དང་ལུང་དང་འགལ་བའི་དུག་གིས་བཏབ་པའི་ཚིག་ནི།",
    "འ་ཞེས་བྱ་བར་གཞོན་ནུ་ཁྱོད་ཀྱིས་བསླབ་པར་བྱའོ།",
