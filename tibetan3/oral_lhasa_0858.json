    "ཚངས་པ་ལ་སོགས་པས་བསྐུལ་༤པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ནུབ་ཀྱི་རི་ལ་རྟེན་མ་བཅས་ནས་རྒྱ་མཚོ་ཆེན་པོར་ལྷུང་བའི་ཕྱིར་རོ་ཞེས་མུ་སྟེགས་པའི་ལུང་ལས་མ་གྷས་གསལ་བར་བྱས་སོ།",
    "ངག་ཐ་དད་པ་ལ་ནི་བསྟན་བཅོས་དང་འགལ་བ་ཡིན་ནོ་ཞེས་ཡུལ་གྱི་དབྱེ་བ་བྱས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་བརྗོད་པར་བྱ་བ་མང་བས་གོ་རིམས་ལས་བརྒལ་ཏེ།",
    "ངོ་བོ་ཉིད་གང་ཞིག་གཉིས་མེད་པར་སྣང་བར་གྱུར་པ་དེ་ཉིད་ཡོད་ན་མངོན་སུམ་གྱིས་གནོད་པ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "ཅི་ལྟར་གཉིས་མེད་པར་ཞེ་ན།",
    "བརྗོད་པར་བྱ་བ་དེ་ཡང་གང་ཡིན་ཞེ་ན།",
    "འབྲེལ་བ་འགོག་པར་ཁས་མི་ལེན་པའི་ཕྱིར་རོ།",
    "རིགས་ཞེས་གསུངས་སོ།",
    "ཆ་༡༡༦༢ལ་གནོད་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་སྟོན་པར་འགྱུར་རོ།",
    "ཅི་ལྟར་དོན་འདི་སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོའི་གཞུང་ལས་རྙེད་སྙམ་ན་དེ་དོན་ཞེས་བྱ་བ་གཉིས་སུ་མེད་པར་བསྟན་པའི་དོན་དུ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཞན་དག་སྤྱི་མ་དམིགས་པ་མ་ངེས་པ་ཉིད་དུ་སྟོན་པར་བྱེད་དོ།",
    "བ་ལང་མ་ཡིན་པ་ལས་ལྡོག་ེཔ་ཡང་གཅིག་པར་འཐད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "འདིས་ནི་ཁྲ་བོ་དང་རྟ་དག་སེར་སྐྱ་ལས་ཐ་དད་པར་མཚུངས་པར་བསྟན་ཏོ། བ་རྟ་རིགས་མི་མཐུན་གཞན་ལས་ཞེས་བྱ་བ་ནི།",
    "འཆོལ་བ་མེད་པར་མི་འགྲུབ་སྟེ་འོན་ཀྱང་འཆོལ་བ་ཁོ་ནའོ།",
    "རིགས་མཐུན་པ་དང་རིགས་མི་མཐུན་པའི་གསལ་བ་རྣམས་ཀྱང་གཞན་ལས་ལྡོག་པར་སྲིད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཅི་ལྟར་ཐ་སྙད་འཆོལ་བར་བྱེད་པར་འགྱུར་སྙམ་ན་དངོས་པོའི་ཞེས་སྨོས་སོ།",
    "མུན་པར་གནས་པས་གསལ་བའི་རང་བཞིན་མ་རྟོགས་པའོ།",
    "དེས་ན་སྤྱི་རྣམ་པར་ཕྱེ་བས་གསལ་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་ཞེས་བྱ་བ་སྤྱི་ལས་རྣམ་པར་ཕྱེ་ནས་རྟོགས་པ་༧ མེད་པས་ནའོ།",
    "ཁྲ་བོ་འདི་ནི་བ་ལང་ཡིན་ནོ་ཞེས་བྱ་བ་འདིར་ནི་སྤྱི་ཁྱད་པར་ཡིན་ལ།",
    "སྤྱི་ཁྱད་པར་ཉིད་ཡིན་ནོ།",
    "ཐམས་ཅད་ཀྱི་ཚེ་འདིར་ནི་བ་ལང་ངོ་སྙམ་པའི་རྟོགས་པ་སྐྱེད་པར་འགྱུར་རོ་ཞེས་སྟོན་པ་ནི།",
    "འོན་ཏེ་ཁྱད་པར་ཡིན་ཡང་གསལ་བའི་ཡུལ་ལ་ཐེ་ཚོམ་ཟ་ཟློག་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་ནས་བརྗོད་པ་ནི།",
    "རྒྱང་རིང་པོ་ན་ནི་དེ་མ་བཟུང་བ་ཡིན་ནོ་ཞེས་ཀྱང་བརྗོད་པར་མི་བྱ་སྟེ།",
    "རྣམ་པར་གཅོད་པར་བྱེད་པ་ཉིད་ཡིན་ཡང་།",
    "ཐེ་ཚོམ་ཟློག་པར་བྱེད་པ་ཅི་ལྟར་ཡིན་ཞེ་ན།",
    "རྣམ་པར་གཅོད་པར་ཞེས་བྱ་བའོ།",
    "སྤྱི་ལ་སོགས་པར་ནི་དེ་ལྟ་མ་ཡིན་ནོ།",
    "ཡང་ན་དེ་ལྟ་ན་ཡང་ཐེ་ཚོམ་ལྡོག་པར་ཅི་ལྟར་འགྱུར་སྙམ་ན།",
    "གང་ཞིག་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཞེས་སྨོས་སོ།",
    "སྤྱི་ལ་སོགས་པ་ནི་རྣམ་པར་གཅོད་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཅི་ལྟར་རྣམ་པར་གཅོད་པར་བྱེད་པ་མ་ཡིན་ཞེ་ན།",
    "གཞན་ཡོད་པ་ཞིག་སྤྱིས་ལྡོག་པར་བྱེད་དམ།",
    "འོན་ཏེ་གཞན་ལས་ཡོད་པ་ཁྱད་པར་གྱི་སྟོབས་ཀྱིས་ལྡོག་པར་བྱེད་དེ་དེས་ན་ཁྱད་པར་ནི་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཁོ་ན་ཡིན་ནོ་སྙམ་ནས།",
    "ཅི་སྟེ་བརྗོད་པར་མི་བྱ་སྙམ་ན།",
    "ལྐོག་ཤལ་ལ་སོགས་པར་རོ།",
    "འོན་ཏེ་བྲམ་ཟེ་ཉིད་མེད་ན་སྤྱོད་པ་བཟང་པོ་དང་ལྡན་པར་མི་འགྱུར་རོ་སྙམ་ན།",
    "༡༡༦༧བོའི་བརྡ་ཙམ་ཞིག་ཡིན་ཏེ་ཆང་མི་འཐུང་བ་ལ་སོགས་པས་ཀུན་ཏུ་སྤྱོད་པ་བཟང་བ་ཙམ་ཞིག་སྐབས་ཡིན་ནོ་ཞེས་འགྲེལ་པར་ཁ་ཅིག་འཆད་དོ།",
    "ཡང་ན་ཆང་མི་འཐུང་བ་ལ་སོགས་པས་ནི་ཀུན་ཏུ་སྤྱོད་པ་བཟང་བ་ཙམ་ཞིག་འཇུག་པར་ཟད་ཀྱི།",
    "བ་ལང་ཉིད་ནི་ངང་པ་ལ་སོགས་པའི་གསལ་བ་ལས་རྣམ་པར་ཕྱེ་ནས་ཁྲ་བོ་ཉིད་ལ་སོགས་པ་ལ་གནས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ངེས་པ་གང་ཡིན་པ་དེ་ནི།",
    "དེའི་ཚེ་ཐུག་པ་མེད་པར་འགྱུར་རོ་། དེ་བས་ན་གསལ་བ་རྣམས་ལ་ལྡོག་པའི་རང་བཞིན་འདོད་པར་བྱ་དགོས་ལ།",
    "གལ་ཏེ་བྲམ་ཟེ་ལ་སོགས་པ་མེད་ན་བྲམ་ཟེ་བསད་པ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་མེད་པར་འགྱུར་བ་ཞིག་ན་ཡོད་པ་ཡང་ཡིན་ཏེ།",
    "བསྟན་བཅོས་ཉིད་ལས་ཞེས་ངེས་པར་བཟུང་བས་ནི།",
    "སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོ་ལ་འདི་ཅི་ལྟར་རྟོགས་པར་བྱ་ཞེ་ན་འདི་ནི་ཞེས་བྱ་བའོ།",
    "འོ་ན་རྗེས་སུ་དཔག་པས་གནོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྤྱི་ལ་གནོད་པར་བྱེད་པ་ནི།",
    "རྗེས་སུ་དཔག་པས་གནོད་པར་བྱེད་པ་མ་ཡིན་ཏེ་དེ་མེད་པའི་ཕྱིར་རོ་ཞེས་སྤྱིའི་རྗེས་སུ་དཔག་པ་སུན་འབྱིན་པའི་སྐབས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཉན་པས་གཟུང་བ་ཞེས་བྱ་བའི་དོན་འདི་ཉིད་ལ་མཉན་པར་བྱ་བ་ཞེས་བྱས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་གཟུང་བ་དང་འཛིན་པའི་འབྲེལ་པར་མ་གྱུར་ན།",
    "༡༡༦༩དག་གཟུང་བ་དང་འཛིན་པར་མི་འགྱུར་རོ།",
    "གཟུང་བ་དང་འཛིན་པར་ནི་འགྱུར་བའང་ཡིན་ཏེ།",
    "དེས་ན་རྗེས་སུ་དཔག་པས་གྲུབ་པ་ཡིན་པའི་ཕྱིར་སྒྲ་མཉན་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་དམ་བཅས་པ་ནི།",
    "ཾརྗེས་སུ་དཔག་པས་གནོད་པ་ཡིན་གྱི་མངོན་སུམ་གྱིས་བསལ་བ་ནི་མ་ཡིན་པའི་ཕྱིར་དེ་ལྟར་ཇི་ལྟར་ན་འདི་མངོན་སུམ་གྱིས་གནོད་པར་བརྗོད།",
    "འདི་ནི་རྗེས་སུ་དཔག་པས་གནོད་པའི་དཔེར་བརྗོད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་སྔ་མས་ནི་དོགས་པ་མེད་པར་ཡང་མཉན་བྱའི་སྒྲ་འཇུག་པར་བསྟན་པ་ཡིན་ལ།",
    "ཞེས་བྱ་བ་རྣམ་པར་འགྲེལ་པ་ནི་དེའི་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་བུམ་པ་དང་སྣམ་བུ་བཞིན་དུ་མཉན་བྱ་དང་མཉན་བྱ་མ་ཡིན་པ་དག་ཀྱང་གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "གཞན་མཉན་བྱ་མ་ཡིན་པ་མེད་པར་རོ།",
    "དེ་མེད་པར་ཞེས་བྱ་བའོ།"
  ]
}