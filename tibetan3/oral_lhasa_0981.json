    "དྲི་མེད་པར་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བར་བསྟན་པའི་ཕྱིར།",
    "དེ་ཡང་རོའི་སྣོད་མེད་པར་མ་ཡིན་པས་དེའི་ཕྱིར་ཕྱག་ན་རོའི་སྣོད་བསྣམས་པའོ།",
    "དེ་བཞིན་དུ་མུན་ནག་ཏུ་ནི་ཕན་ཚུན་མཐོང་བ་མེད་པས་དེའི་ཕྱིར་མར་མེ་བསྣམས་པར་མཛད་པ་ནི་མར་མེའོ།",
    "གར་རྣམས་བྱེད་པས་རྣམ་པར་སྒེག་པར་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་དུ་མིག་དགའ་བའི་སྡུག་པ་དང་།",
    "ཞེས་གསུངས་ཏེ།",
    "དེ་བས་ན་རབ་ཏུ་དགའ་བ་རྣམ་པར་དག་པའི་གནས་ནི་འདི་ལྟ་སྟེ།",
    "རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་རྣམ་པར་དག་པ་ཁོང་དུ་ཆུད་པ་མངོན་སུམ་དུ་བྱས་པའི་ངོ་བོ་ཉིད་དོ།",
    "ཡོངས་སུ་དག་པའོ་ཞེས་བྱ་བ་ནི་ཁམས་གསུམ་པ་ལྟ་བུའི་བག་ཆགས་དང་བཅས་པའི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིས་ནི་དོན་འདི་སྟོན་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "གང་རབ་ཏུ་དགའ་བ་ལ་སོགས་པ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ཡིན་ལ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་རབ་ཏུ་དགའ་བ་ལ་སོགས་པ་རྣམ་པར་དག་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ཡིན་པའི་གཏན་ཚིགས་དེས་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མངོན་སུམ་དུ་བྱས་པས་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་རྣམ་པར་དག་པ་ཐོབ་པར་འགྱུར་ཏེ།",
    "དེ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་རྣམ་པར་དག་པའི་སྒོ་ནི་དེའི་གནས་ཀྱི་དཀྱིལ་འཁོར་ལ་སོགས་པའོ།",
    "དངོས་གཞིའི་ལས་ཀྱི་ངོ་བོ་བྱས་མ་ཐག་ཏུ་ཞེས་པ་དེ་རྣམས་བྱས་པ་ཙམ་གྱིས་སྡུག་བསྔལ་མེད་པར་ཞེས་པ་སྡུག་བསྔལ་མེད་ཅིང་རིམས་ལ་སོགས་པའི་གནོད་པ་མ་བྱས་པར་དེ་རྣམས་ཟད་པར་འགྱུར་ལ།",
    "དེའི་རིམས་ལ་སོགས་པ་གནོད་པ་བསྐྱེད་པ་དེ་རྣམས་ཟད་པར་འགྱུར་ཞིང་།",
    "བྱས་མ་ཐག་ཏུ་ཡང་སྡུག་བསྔལ་མེད་པར་འགྱུར་རོ།",
    "སུ་ཞིག་འཛིན་པ་དང་ཞེས་བྱ་བ་ནི་གཞུང་དང་དོན་གྱི་ཚུལ་མི་བརྗེད་པའི་སྦྱོར་བས་སེམས་ལ་ཡང་དག་པར་འཇོག་པའོ།",
    "འམ་ཞེས་བྱ་བའི་སྒྲ་ནི་ཚུལ་བཞིན་ནམ་ཡིད་ལ་བྱེད་པ་ཞས་རྣམ་པར་བརྟག་པའོ།",
    "དེ་འཐོབ་པ་ནི་རྙེད་པར་གྱུར་པ་སྟེ།",
    "དེ་ཉིད་ནི་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་རྣམ་པར་དག་པ་མངོན་སུམ་དུ་བྱེད་པ་ལ་མངའ་བདག་ཏུ་འགྱུར་བའོ།",
    "སྐད་ཅིག་མ་གསུམ་པ་ལ་སོགས་པར་སྐྱེས་པ་ནི་མཆོག་ཏུ་དགའ་བ་སྟེ་ཐམས་ཅད་ལ་དགའ་བ་དང་མགུ་བ་དང་མཆོག་ཏུ་དགའ་བ་དག་ནི་དགའ་བ་དང་མགུ་བ་དང་མཆོག་ཏུ་དགའ་བ་དག་སྟེ།",
    "དེ་རྣམས་མྱོང་བར་འགྱུར་ཞིང་མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་དུས་གསུམ་དུ་གཤེགས་པའི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དང་།",
    "དེ་འཛིན་པར་མཛད་པས་ན་རྡོ་རྗེ་འཛིན་པ་སྟེ།",
    "དེ་ཐོབ་པར་འགྱུར་པའོ།",
    "དབྱིངས་ནི་རྒྱུ་སྟེ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་གང་ཡིན་པའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་རོ།",
    "དེར་རྣམ་པར་རྒྱལ་བ་གང་ཡོད་པ་དེ་ནི་ཁམས་གསུམ་པོ་མཐའ་དག་ན་འཇིག་རྟེན་གསུམ་པོ་མ་ལུས་པ་ལས་རྣམ་པར་རྒྱལ་བ་ཞེས་བྱ་བ་སྟེ་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཧཱུཾ་མཛད་དོ།",
    "ལག་ན་རྡོ་རྗེ་ཡང་ཡིན་ལ་ཐམས་ཅད་ཀྱང་ཡིན་པས་ལག་ན་རྡོ་རྗེ་ཐམས་ཅད་དེ་རིགས་ལྷག་མ་རྣམས་ཀྱི་དཀྱིལ་འཁོར་དུ་བཞུགས་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་གྱི་དོན་འདི་ནི་ཞེས་བྱ་བ་ནི་རབ་ཏུ་དགའ་བ་རྣམ་པར་དག་པ་ལ་སོགས་པའི་གནས་བཅུ་བདུན་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་ལོ།",
    "དངོས་གྲུབ་ཐམས་ཅད་མི་ཟད་པར་སྩོལ་བར་བྱེད་པ།",
    "དེའི་དམ་ཚིག་ནི་རྫོགས་པར་བྱེད་པའི་རྒྱུ་སྟེ།",
    "སྨྲས་སོ་ཞེས་བྱ་བ་ནི་གསུངས་པའོ།",
    "དེ་སྟོན་པར་བྱད་པའི་སྒྲ་ལ་ཡང་ཉེ་བར་གདགས་པས་ད་སྐད་ཅེས་བྱའོ།",
    "དེ་ནས་འདི་གསུངས་པ་ཙམ་གྱིས་ཞེས་བྱ་བ་ནི་གོ་བར་ཟད་དོ།",
    "རྗེས་སུ་མཉེས་པ་བརྟན་པོས་མཉེས་པར་བྱས་ནས་ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འགུགས་པར་རྣམ་པར་སེམས་རྩེ་གཅིག་ཏུ་བྱས་པ་ན་རྗེས་སུ་མཉེས་པར་བྱ་བ་བརྟན་པོ་སྟེ།",
    "འདོད་ཆགས་དམ་ཚིག་ཡིན་པར་བཤད།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེས་མཉེས་པར་བྱས་པ་ནི་དགྱེས་པར་བྱས་པའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་དཀྱིལ་འཁོར་ཆེན་པོར་བཅུག་སྟེ་ཞེས་བྱ་བ་ནི་གང་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པར་སྣང་མཛད་བསྐུལ་བའི་ཕྱིར་རོ།",
    "དཀྱིལ་འཁོར་སྤྲུལ་པར་མཛད་པ་དེ་ནི་འདིར་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཏེ་དཀྱིལ་འཁོར་ཆེན་པོ་དེར་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་གཟུགས་ཀྱིས་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་གནས་སུ་བཞུགས་པའོ།",
    "བདེ་བ་ཆེན་པོའི་སྒྲར་རྒྱུད་ཕྱི་མ་ལས་གསུངས་ཏེ།",
    "དེ་བཅིངས་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསང་བའི་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པས་རྣམ་པར་སྣང་མཛད་བཞུགས་པ་སྟེ།",
    "དེ་ལ་སྙོམས་པར་ཞུགས་པ་ནི་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་ནས་བཞུགས་སོ་ཞེས་སྟོན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཕྱག་རྒྱའི་ཡེ་ཤེས་ཀྱི་ཕྱོགས་གཅིག་ཀྱང་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་འདུས་པ་མཛད་པ་ལ་སོགས་པ་ནི་ལས་ཀྱི་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གསུམ་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་གང་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔས་རྣམ་པར་སྣང་མཛད་བསྐུལ་བའི་རྗེས་ཐོགས་ཉིད་ལ་སྤྲུལ་པར་མཛད་པ་སྟེ།",
    "དེ་ལ་སྙོམས་པར་ཞུགས་པ་ནི་མངོན་སུམ་དུ་མཛད་པ་སྟེ།",
    "ཅེས་གསུངས་པ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའོ།",
    "ཀུན་དུ་བཟང་པོའོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "སྔར་བསྙེན་པ་བྱས་པའི་རྗེས་ཐོགས་ཉིད་ལ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེར་ཞུགས་ན་གྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་བས་ན་དེ་རྣམས་ཀྱི་བག་ཆགས་བསྐྲུན་པར་བྱ་བའི་ཕྱིར།",
    "དཀྱིལ་འཁོར་དམ་པ་སྟེ་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་དང་པོ་དམ་ཚིག་ཆེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་སྟེ།",
    "གང་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་སྤྲུལ་པར་མཛད་པ་དེ་ལ་མིང་དེ་སྐད་ཅེས་མཚུངས་པར་བརྗོད་ཅིང་མིང་འདོགས་པ་གང་ཡིན་པ་དེ་ནི།",
    "གྲུ་བཞིར་བགྱི་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཁ་དོག་དབྱིབས་ཀྱི་བདག་ཉིད་ཅན་གྱི་གཟུགས་ཅན་དཀྱིལ་འཁོར་དུ་གསུངས་པ་ཡིན་ཏེ།",
    "སྒོ་དེའི་ཕྱེད་ཀྱི་ཚད་ཀྱི་ཁྱམས་ཀྱིས་སྐོར་ཕྱོགས་སུ་ཕྱི་རོལ་ཀུན་ནས་བསྐོར་ལ་རྟ་བབས་དང་བཅས་པར་བྱ་བ་ནི།",
    "སྒོ་རྣམས་སུ་ནི་སྒོའི་སུམ་འགྱུར་གྱི་ཆད་ཀྱི་རྟ་བབས་བཞི་དང་ལྡན་པར་བྱ་བ་ནི།",
    "སྣ་ཚོགས་རྡོ་རྗེས་ཉེ་བར་མཛེས་པར་བྱས་ཤིང་བརྒྱན་པ་ནི་རིན་ཆེན་ཀུན་གྱིས་ཉེ་བར་མཛེས་པ་སྟེ།",
    "ཐ་མ་ཁ་དོག་ལྔ་པས་མཛེས་པར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤར་ལྷོའི་མཚམས་སུ་ནི་རྡོ་རྗེ་རྩེ་ལྔ་པས་ཉེ་བར་མཛེས་པར་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ལ་ཤེས་པར་བྱའོ།",
    "ཅེས་གསུངས་པས་སྒྲ་འདི་ནི་ཟླུམ་པོ་འབའ་ཞིག་སྟོན་པའི་ཚིག་ནི་མ་ཡིན་ནོ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་བརྒྱད་པ་སྟེ།",
    "སྔ་མ་བཞིན་དུ་མཐོང་བ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ལ་ཤེས་པར་བྱའོ།",
    "ཅི་རིགས་པར་ཞེས་བྱ་བ་ནི་སྔོན་དུ་བསྙེན་པ་ལ་སོགས་པ་སྔར་བྱས་ཏེ་ཇི་ལྟ་བ་བཞིན་དུ་དགོས་པར་བྱའོ་ཞེས་བྱ་བར་སྟོན་པ་ཡིན་ཏེ།",
    "ཅེས་འདི་ཉིད་ཀྱི་འོག་ནས་གསུངས་པ་དང་།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ནི་དཀྱིལ་འཁོར་གཉིས་པ་ཡིན་པས་དེའི་ཕྱིར་ཡང་སོམ་ཉི་མི་བྱའོ།",
    "དེ་དད་བཅས་པར་བཞུགས་པ་ལ་འཛུམ་བཅས་ཞེས་བྱའོ།",
    "རྡོ་རྗེ་འཛིན་པར་མཛད་པས་ན་རྡོ་རྗེ་སྙེམས་པ་འཛིན་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ལྔས་བརྒྱན་པར་བྱ་སྟེ།",
    "པདྨའི་གདན་ལ་བཞུགས་པར་ནི།",
    "ལུགས་མ་ཞེས་བྱ་བ་ནི་གསེར་ལ་སོགས་པའི་རྫས་ལས་སྐུའི་གཟུགས་བརྙན་དུ་བྱས་པའོ།",
    "རྡོ་རྗེ་ཡིད་ལས་བྱུང་བ་ལ་སོགས་པ་ཐམས་ཅད་ཧཱུཾ་ཉིད་ཀྱིས་ཡང་དག་པར་དགོད་པར་བྱ་ཞིང་གཞག་པར་བྱའོ།",
    "དེ་ལ་ཇི་ལྟར་དགོད་པར་བྱ་ཞེ་ན།",
    "རྡོ་རྗེ་ཤུགས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཡིད་ལས་བྱུང་བ་ལ་སོགས་པ་ལ་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་ཡང་དག་པར་བསྡུས་པ་སྟེ།",
    "དཀྱིལ་འཁོར་པའི་ཆོགས་གཞག་པར་བྱའོ།",
    "ཡང་ན་བྲི་བར་བྱ་ཞེས་བྱ་བ་ནི་ཚོན་རྩི་རྣམས་ཀྱིས་ལེགས་པར་བྲི་བར་བྱའོ།",
    "མདུན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཉི་མའི་འོད་ཅན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཡོན་དུ་ཞེས་པ་ལ་སོགས་པ་ལ་དང་ལ་རྡོ་རྗེ་སེམས་དཔའི་གཡོན་དུ་རྡོ་རྗེ་སྙེམས་པ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་རྡོ་རྗེ་རྩེ་ལྔ་པ་གཉིས་བསྣམས་ནས་རྐེད་པའི་ཕྱོགས་གཉིས་སུ་སྙེམས་པར་འཛིན་པ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ཞེས་བྱ་བ་ལེགས་པར་བྲི་བར་གྱུར་པ་ཡིན་ནོ།",
    "ཚངས་བ་ཞེས་བྱ་བ་ནི་གྲགས་པར་ཟད་དོ།",
    "ཞི་བྱེད་ཅེས་བྱ་བ་ནི་གྲགས་པར་ཟད་དོ།",
    "འདིས་ནི་དོན་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "བརྒྱ་བྱིན་ཆུང་མ་དང་བཅས་པར་བྲི་བར་བྱའོ།",
    "རྣམ་པར་རྒྱལ་བ་དང་།",
    "ཆུ་ལྷ་ཆུད་མ་དང་བཅས་པར་བྲི་བར་བྱའོ།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་ཡི་གེ་ཧཱུཾ་ཉིད་ཀྱིས་དགོད་པར་བྱའོ།",
    "འཇུག་པ་ལ་སོགས་པའི་ཆོ་ག་རྒྱས་པའོ་ཞེས་བྱ་བ་ནི་དེར་འཇུག་པ་ལ་སོགས་པའི་ཆོ་ག་རྒྱས་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ་འཇུག་པ་དྲན་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ནས་བརྩམས་ཏེ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་ཉེ་བར་དགོད་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དང་པོ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ཞུགས་ནས་ཡང་དག་པར་སྒེག་པར་འགྱུར་བ་དང་།",
    "ཕྱག་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཇི་སྲིད་ཆོ་ག་རྒྱས་པར་མ་བྱས་པར་ཞུགས་པ་ཙམ་གྱིས་སློབ་དཔོན་ཇི་ལྟ་བུའི་འབྲས་བུ་ཐོབ་པ་དེ་ནི་དཀྱིལ་འཁོར་དུ་ཞུགས་པའི་འབྲས་བུ་ཡིན་ནོ་ཞེས་སྤྲོ་བ་བསྐྱེད་པའི་ཕྱིར།",
    "ཆོ་ག་ཇི་ལྟ་བུས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔས་བྱིན་གྱིས་རློབ་པར་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱི་སློབ་དཔོན་དང་ཞེས་བྱ་བ་ལ་དཀྱིལ་འཁོར་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཏེ།",
    "པདྨའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་སློབ་དཔོན་དུ་འགྱུར་རོ་ཞེས་སྟོན་པར་གྱུར་པ་ཡིན་ནོ།",
    "རིགས་དང་དཀྱིལ་འཁོར་དང་ལྷ་ཐམས་ཅད་ཀྱིས་ནུས་པ་དང་ལྡན་པར་མཛད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "རང་ལ་རག་ལས་པར་འགྱུར་རོ།",
    "དེ་བས་ན་རྒྱུ་དེ་ལྟ་བུས་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་ཕྱག་རྒྱ་ཐམས་ཅད་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་བཅིངས་ན་འདིའི་དངོས་གྲུབ་རྣམས་འགྲུབ་པར་འགྱུར་རོ།",
    "དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱའི་བྱིན་གྱི་རླབས་ཀྱིས་དམ་ཚིག་ཐམས་ཅད་བྱིན་གྱིས་བརླབས་པར་རྟོགས་པར་འགྱུར་ཏེ།",
    "དེ་སྒྲུབ་པ་པོའི་རྒྱུད་ལ་སོ་སོར་སྣང་བའི་སྦྱོར་བས་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་བསླབས་པར་ཡང་ཐམས་ཅད་ཤེས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ནས་བསྟན་བཅོས་ལ་སོགས་པ་མ་བསླབས་པར་ཡང་དེ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་མཛད་པའི་མཐུས་ཐམས་ཅད་ཤེས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བུའི་བྱ་བ་ཐམས་ཅད་ཀྱང་འདི་ལ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེའི་འདོད་པ་ཇི་ལྟ་བུས་ཇི་ལྟ་བ་འདོད་པ་དེ་ལྟ་བུ་ཉིད་ཀྱི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "རྗེས་སུ་མཉེས་པར་བྱས་ཏེ།",
    "དཀྱིལ་འཁོར་ཐམས་ཅད་བསྟན་པར་བྱ་ཞིང་།",
    "དཀྱིལ་འཁོར་གྱི་དངོས་གྲུབ་ཀྱང་དེ་ཉིད་ཀྱིས་བསྒྲུབས་ན་འགྲུབ་པར་འགྱུར་ཞིང་རྫོགས་པར་འགྱུར་བས་བཅོམ་ལྡན་འདས་དེ་ཡང་དེ་ལ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་བས་ན་ཇི་སྐད་དུ་གསུངས་པའི་འབྲས་བུ་དཀྱིལ་འཁོར་དུ་འཇུག་པ་ཙམ་གྱིས་སློབ་དཔོན་གྱིས་འཐོབ་པར་འགྱུར་རོ།",
    "ཐོག་མར་བྱས་ལ་ཕྱག་རྒྱ་གཞན་དག་བཅིང་བ་དང་།",
    "དཀྱིལ་འཁོར་དུ་འཇུག་པར་བྱས་ནས་ཧཱུཾ་ཟློས་ཤིང་།",
    "རྡོ་རྗེ་ལྟ་བས་ལྟ་བཞིན་དུ་དཀྱིལ་འཁོར་དུ་བསྒྲུབ་པར་བྱའོ།",
    "རྡོ་རྗེ་བཅིང་བ་བསྟན་བྱས་ཏེ།",
    "བཅུག་ལ་བསྐྱོད་ཅིང་བསྡམ་པར་བྱ།",
    "དེ་ནས་རྡོ་རྗེ་རྣམ་པར་སྒེག་པའི་ཕྱག་རྒྱ་དང་།",
    "བཟླས་བརྗོད་ལན་ཅིག་བྱས་ལ་ཕྱག་བྱ་ཞིང་ཞེས་བྱ་བ་ནི་དེ་ལྟ་བུའི་རྡོ་རྗེའི་ཕྱག་རྒྱ་དང་ཡི་གེ་ཧཱུཾ་ཟློས་ཤིང་དཀྱིལ་འཁོར་ཐམས་ཅད་རབ་ཏུ་ཇི་ལྟ་བ་བཞིན་བསྒྲུབས་ལ།",
    "ལྷག་མ་རྣམས་ཀྱིས་ཀྱང་ཇི་ལྟར་བྲིས་པ་དང་རྗེས་སུ་མཐུན་པར་ཡི་གེ་ཧཱུཾ་ཟློས་ཤིང་ཕྱག་རྒྱ་ཆེན་པོ་དེ་དག་ཉིད་ལ་ཉེ་བར་བསྟན་པར་བྱའོ།",
    "དེའི་རྗེས་ཐོགས་ཉིད་དུ་རྡོ་རྗེ་རྣམ་པར་སྒེག་པའི་ཕྱག་རྒྱས།",
    "བཅོམ་ལྡན་འདས་ལ་ཕྱག་བྱས་ཏེ།",
    "དེ་དག་ཀྱང་འདིའི་འོག་ནས་ཤེས་པར་བྱའོ།",
    "རྡོ་རྗེ་ལྕགས་ཀྱུ་ལ་སོགས་པ་བཟླས་པས་ཀྱང་དེ་སྟོད་གཡོགས་དང་སྨད་གཡོགས་དང་ཟེའུ་ཁ་དང་གདོང་གཡོགས་བྱས་ལ།",
    "ལག་པ་གཡས་པ་བ་དན་གསུམ་པ་བྱས་ལ།",
    "ཞུགས་ནས་ཀྱང་ཡང་རྣམ་པར་སྒེག་པས་བསྐོར་བས་བདུད་བཅིང་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་སྔར་རྡོ་རྗེ་སྒེག་པས་ཕྱག་བྱ་བར་གསུངས་པ་བཞིན་དུ་འདིར་ཡང་བྱའོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ལ་རྡོ་རྗེའི་ལྟ་བས་བལྟས་ལ་ཡི་གེ་ཧཱུཾ་འདོན་ཅིང་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དགྱེས་པས་བདག་ཉིད་སྟོན་པར་མཛད་པའམ།",
    "ལུས་ཐམས་ཅད་དམ་ཡན་ལག་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་གལ་ཏེ་ཞིག་ན་སྐུ་ཐམས་ཅད་བསྐྱོད་པར་འགྱུར་བའམ།",
    "སྐུའི་ཕྱོགས་གཅིག་བསྐྱོད་པར་འགྱུར་བའོ།",
    "འོད་ཟེར་གྱི་རང་བཞིན་གྱི་ཞལ་ལམ་སྐུ་ཐམས་ཅད་སྟོན་པར་འགྱུར་རོ།",
    "མི་སོད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དེར་རང་ཉིད་ཞུགས་པའོ་ཞེས་སྔ་མ་བཞིན་དུ་རྒྱུད་དང་སྦྱར་ཏེ།",
    "གང་ཞིག་དཀྱིལ་འཁོར་འདི་ལ་ཞུགས་པ་ཙམ་གྱིས་མི་ཚུགས་པར་འགྱུར་བ་འདི་ནི།",
    "གང་བདུད་ལ་སོགས་པས་ཟིལ་གྱིས་མི་གནོད་ཅིང་ཚུགས་པར་མི་འགྱུར་བ་དང་།",
    "བསད་པར་མི་ནུས་པའོ།",
    "དེ་དག་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་སློབ་དཔོན་ལ་བསྒྲུབ་པར་མཛད་ཅིང་རྫོགས་པར་མཛད་དོ།",
    "དེར་དེ་ལྟ་བུའི་འབྲས་བུ་ཐོབ་པར་འདོད་པའི་སློབ་དཔོན་གྱིས་རང་ཉིད་འཇུག་པར་བྱའོ།",
    "དེ་ནས་ཡང་དག་པར་མཆོད་ལ་ཞེས་བྱ་བ་ནི་དངོས་གྲུབ་ཐམས་ཅད་རབ་ཏུ་བསྒྲུབ་པར་མཛད་པ།",
    "བཅོམ་ལྡན་འདས་ལ་ཕྱག་བྱས་ལ་བླང་བར་བྱའོ།",
