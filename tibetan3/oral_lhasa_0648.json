    "ཁྱད་པར་སྤྱི་གཙུག་རྐང་མཐིལ་གཏར་ལ་བསྲེག།",
    "མཆིན་འགྲམས་ཐོག་མར་ག་པར་དགུ་པ་བསིལ་གསུམ་གཡུ་རྙིང་ལུག་རུ་བུ་རྐང་པ་སྲི་ཡང་ཀུ་སྦྱར།",
    "རྗེས་ལ་ཚིགས་པ་བཅུ་པ་བསྲེག་པར་བྱ།",
    "རྐང་འགྲམས་རྨ་བཅོས་ལྟར་སྐུ་སྦྱོར་བྱས་ལ་ཕྱིང་དེབ་བཅིང་།",
    "ཅེས་གསུངས་སོ།",
    "དེ་སྐད་ཞུས་པའི་དོན་ལ་སྤྱི་དོན་བདུན་གྱིས་ལན་གསུངས་པ་ལས།",
    "སྤྱི་དོན་གཉིས་པ་དེ་རྐྱེན་རྣམ་པར་གྱུར་པའི་དུས་གདོན་ཟས་སྤྱོད་རྣམ་བཞི་ཡིས།",
    "སྤྱི་དོན་གསུམ་པ་ཉེས་པ་གསུམ་འཁྲུགས་པས་རྟེན་ཁྲག་ཚད་ཆེར་བསྐྱེད་པར་བྱས་ནས།",
    "དང་པོ་ཚ་བ་སྡོངས་པ་ལ་སྤྱི་དོན་ཁྱད་པར་གཉིས་ལས་དང་པོ་སྤྱི་རྟགས་གཡལ་དང་འདར་དང་གཟེར་བ་འཕོ།",
    "གཉིས་པ་ཁྱད་པར་ཚ་སྟོངས་རྩ་ནི་སྟོང་ལ་མགྱོགས།",
    "གསུམ་པ་འཇམ་འཁྲུགས་ལུད་པ་མི་གཙང་གཟེར་ཕྲན་འབྱུང་།",
    "དག་པར་འབྱོངས་ན་བཤལ་རྗེས་བསིལ་གྱིས་བཅད།",
    "ཁུར་མང་སྐྱབས་ཚོད་ཆུ་གྲོག་བསྟེན་པར་བྱ།",
    "བསེར་བུ་གྲིབ་མ་བསིལ་སར་དལ་བར་བསྡད།",
    "གཟེར་མེད་ལུད་པ་གཙང་ལ་དང་ག་བདེ།",
    "གཉན་མ་སོད་པར་ག་བུར་གཏར་ག་བྱས་ན་གཉན་དང་ཚ་བ་སྲོག་རྩར་འཕུལ་ཞིང་ངུར་བས་སྤོང་།",
    "མ་ནུ་སྨེ་ཀན་སྒ་བཞི་ཐང་དྲོ་འཇམ་རྒྱུན་དུ་བསྔལགས།",
    "ཞེས་གསུངས་སོ།",
    "ཀྱེ་དྲང་སྲོང་ཆེན་པོ་རིག་པའི་ཡེ་ཤེས་ལགས།",
    "ཉི་མ་སྙེག་ཅིང་ཁྱད་པར་སྲོད་ལ་ན།",
    "དཔྱི་མགོ་དང་དང་རྐེད་པ་རུས་རྐང་ཁྱད་པར་ན།",
    "ཁྱད་པར་འདར་བུ་ཕྲུམ་སེར་ཡུན་རིང་འདར།",
    "ཁྱད་པར་ལེ་བརྒན་སྟོད་གཟེར་ལུད་པ་དམར།",
    "ཁྱད་པར་རྨོངས་བུ་ཟ་ཟི་ཉག་ཉོག་མང་།",
    "ལུས་ལྕི་མྱོས་དང་ལྐུགས་པར་འགྱུར་བ་ཡིན།",
    "དེ་དག་རི་ཐང་མཚམས་སུ་ཕེབས་རྟགས་ཡིན།",
    "གློ་མང་ལུད་པ་མི་གཙང་མིག་ཆུ་དམར་ཞག་གཅིག་འ་འང་ཚ་བའི་ཟུག་གཟེར་ལན་གཉིས་ལྡང་།",
    "བད་མཁྲིས་ཤས་ཆེ་སྟེ་དང་ཕྲག་པར་འབབ།",
    "ཀླད་པར་བབས་ཚེ་མགོ་འཁོར་ཆམ་པས་འདེབས།",
    "ཡར་ལ་མགོ་དང་ཀླད་པར་བད་ཡུལ་འཕྲོག།",
    "ཁྱད་པར་མགོར་བྲོས་ཀླད་གཟེར་སྣ་ཁྲག་འཛག།",
    "ཡང་ན་སླེ་ཏྲེས་ལྔ་ཐང་ཨ་བར་སྐྱུར་ཏིག་སྨིན་པར་བྱ།",
    "ཟས་དང་སྤྱོད་ལམ་བསིལ་དྲོད་སྙོམས་པར་བཅོས།",
    "དེ་བ་བ་སྤུ་ཆུང་པར་པ་ཏ་དང་ལི་ག་དུར།",
    "ཁྱད་པར་རིམས་སོ་ཅོག་ལ་ཞོ་གནོད་དེ།",
    "ཁྱད་པར་རི་ཐང་མཚམས་ཀྱི་བདུད་རྩི་ཡིན།",
    "དེ་ཕྱིར་མཁས་པས་འདི་དུས་གཟབ་པར་བྱ།",
    "ཁ་ཟས་བསིལ་ཕྱོགས་མི་བཏང་སྨིན་པར་དཀའ།",
    "དྲོད་བཅུད་མི་བསྟེན་རྩི་ལྟར་ཞེན་པར་འགྱུར།",
    "ཁྱད་པར་གཏར་ག་དང་བཤལ་དང་བསིལ་བའི་རིགས་དང་བཅུད་ཅན་རྣམས་སྤང་།",
    "བྱི་ཚེར་ག་དུར་རྩ་མཁྲིས་སྐྲ་བཟང་པར་པ་ཏ་དང་།",
    "ཁྱད་པར་ལེ་བརྒན་སྣ་ཁྲག་འཛག་པ་ལ།",
    "གླ་སྒང་པར་པ་ཏ་ཡི་སྨིན་ཐང་བཏང་།",
    "ཁྱད་པར་རྨོངས་བུའི་རིགས་ལ་ར་དཀར་པོའི།",
    "བཅའ་སྒ་བྱེ་ཚེར་པར་པ་ཏ་གསུམ་ལ།",
    "སྟོབས་ཆེ་སྨིན་དུས་བསྡད་པའི་ལོང་མེད་པས།"
  ]
}