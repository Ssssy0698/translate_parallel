    "གསུམ་པ་ལུས་ཅན་གྱི་རྒྱུད་སྒྲིབ་པ་སྤང་རུང་དང་གཉེན་པོ་སྐྱེ་རུང་དུ་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་ས་བདུན་པ་ནི།",
    "སྤྱི་གཙུག་ནས་འོད་ཟེར་སྟོང་གསུམ་གྲངས་མེད་པ་འབུམ་ཕྲག་བཅུའི་རྡུལ་དང་མཉམ་པ་འཕྲོས་ནས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པའི་དཀྱིལ་འཁོར་ཐམས་ཅད་སྣང་བར་བྱས།",
    "བྱང་སེམས་དེ་ལ་ལྟ་ཞིང་མཆོད་དེ་ཏིང་ངེ་འཛིན་སྟོང་ཕྲག་བཅུ་བཅུ་ལ་སྙོམས་པར་འཇུག་གོ།",
    "བྱང་སེམས་དེའི་དཔལ་བེའུ་དང་རྡོ་རྗེ་དང་བཀྲ་ཤིས་སུ་ནུབ་པས་མཐུ་སྟོབས་ལྷག་པར་འཕེལ་ལོ།",
    "འདུས་བྱས་ལས་གུད་ནའང་འདུས་མ་བྱས་དམིགས་སུ་མེད་དོ།",
    "འདུས་མ་བྱས་ལས་གུད་ནའང་འདུས་བྱས་དམིགས་སུ་མེད་དོ།",
    "གསུམ་པའི་གཉིས་ནི་གཙང་བདེ་རྟག་བདག་ཏུ་འཛིན་པའི་ཕྱིན་ཅི་ལོག་བཞི་སྤངས་པ་ནི།",
    "ཕྱིན་ཅི་ལོག་དེའི་གཞི་སྒྲོ་བཏགས་པ་ཙམ་མ་གཏོགས་པར་དོན་ལ་མེད་པའི་ཚུལ་དུ་རྟོགས་པ་ནི།",
    "གསོལ་བ་བཅོམ་ལྡན་འདས་དེ་གང་ལགས།",
    "དང་པོ་བཞི་ཚོགས་ལམ་ཕལ་བ་དང་ལྔ་པར་ཐར་ཆ་དང་དེ་ནས་གཉིས་སྦྱོར་ལམ་ཡིན་ཞེས་དེ་ཉིད་ལས་སོ།",
    "གཞན་དག་ནི་ཆགས་པ་དེ་ས་བཅུ་པའི་བར་དུ་ལྡན་པས་ས་འོག་མ་ལ་ལྟོས་ནས་ཞེན་པ་སྤངས་པར་འདོད་དོ།",
    "དེས་ན་རྟོགས་དཀར་དང་པོ་དང་ཐ་མར་ཞེས་འདོན་པ་ལྟར་རམ་ཡང་ན་ཐ་མའི་ལས་ཞེས་པའི་དྲུག་སྒྲ་གཞི་མཐུན་པའི་བསྡུ་པ་བྱས་ན་ལེགས་སོ།",
    "མཚན་ཉིད་ཀྱི་དང་དེའི་སྦྱོར་བ་སོགས་ནས་དེའི་རྣམ་སྨིན་གྱི་སྐབས་ཞེས་སྦྱར་བས་དོན་ནས་སྐབས་དྲུག་ཏུ་འགྱུར་བ་དག་ལྡན་དུ་དེའི་ཞེས་པ་དང་པོ་མཁྱེན་གསུམ་དང་།",
    "མཁྱེན་གསུམ་གྱི་མཚན་ཉིད་ཡིན་ཏེ།",
    "མཁྱེན་གསུམ་གྱི་ཡུལ་གཞི་ལམ་རྣམ་གསུམ་མཚོན་པར་བྱེད་པས་མཚན་ཉིད་ཅེས་འཆད་པ་ནི་དོན་མ་ཡིན་ནོ།",
    "རྣམ་པ་ནས་རྟོགས་པ་ནི་མཁྱེན་གསུམ་གྱི་སྦྱོར་བ་ཡིན་ཏེ།",
    "རྩེ་ནས་ནི་མཁྱེན་གསུམ་གྱི་རབ་ཀྱི་གནས་སྐབས་ཡིན་ཏེ།",
    "མཁྱེན་གསུམ་ལ་ཤིན་ཏུ་ནས་ཕྱིར་རོ།",
    "མཐར་ནས་ནི་མཁྱེན་གསུམ་གྱི་གོ་རིམས་ཀྱི་གནས་སྐབས་ཡིན་ཏེ།",
    "སྐད་ཅིག་ནས་ནི་མཁྱེན་གསུམ་གྱི་མཐར་ཐུག་པའི་གནས་སྐབས་ཡིན་ཏེ།",
    "སློབ་པའི་སྐབས་སུ་དེ་ལས་ཁྱད་པར་དུ་འགྲོར་མེད་པས་སོ།",
    "མཁྱེན་གསུམ་དེའི་འབྲས་བུ་མཐར་ཐུག་ཡིན་པས་སོ།",
    "འདིའི་མཁྱེན་གསུམ་ནི་སྐྱེ་མེད་གསུམ་མཁྱེན་པའི་བྱང་སེམས་ཀྱི་རྣལ་འབྱོར་ལ་བྱའོ།",
    "རྟོགས་པའི་དུས་ཀྱི་ཁྱད་པར་བསྟན་པའོ།",
    "བརྩམ་པར་དམ་བཅའི་གཞུང་གཟུགས་པའོ།",
    "འདོད་པར་མི་ནུས་ཏེ།",
    "འདིར་གཞུང་བསྡུས་པ་ཡིན་པར་འདོད།",
    "ཅེས་ལུང་འདི་དྲངས་ནས་རྒྱན་སྣང་དུ་རྒྱན་དང་བརྒྱད་སྟོང་པ་སྦྱོར་བ་རིགས་པར་བསྒྲུབས་པས་སོ།",
    "ཁ་ཅིག་བསྟན་བཅོས་ཀྱིས་ཡུམ་གསུམ་ཐམས་ཅད་ཀྱི་རིམ་པ་མ་བསྡུས་པར་སྦྱོར་བ་ནི་མ་འབྲེལ་ལོ།",
    "ཁོ་ནར་ཟད་པས་ནི་དོན་ཁྱད་མེད་པར་བསྟན་ཏོ།",
    "འདིས་ཀུན་གྱི་རྒྱན་དུ་འགྱུར་བའི་ཕྱིར་ཞེས་སྨྲས་པའི་དགོས་པ་དེ་གྲུབ་པར་བསྟན་ཏོ།",
    "ཅི་འདི་གཞན་གྱིས་མ་གནང་བར་བྱས་སམ་ཞེ་ན།",
    "འདིས་རྣམ་པར་དབྱེ་ཞེས་པའི་དམ་བཅའ་དེ་གྲུབ་པར་བསྟན་ཏོ།",
    "དེ་ལ་བཟོད་པར་གསོལ་བའོ།",
    "སྤྱོད་ཡུལ་མིན་ན་ལོག་པར་འཆད་པས་འགྲེལ་པ་བྱེད་མི་རིགས་ཤེ་ན།",
    "མཚན་བརྗོད་པར་དཀའ་བའི་སློབ་དཔོན་ཆེན་པོ་སེང་གེ་བཟང་པོ་ཞེས་ཉི་མ་དང་ཟླ་བ་ལྟར་གྲགས་པ་དེས་མཛད་པ་རྫོགས་པར་གྲུབ་པའོ།",
    "བདག་ཅག་གངས་རིའི་ཁྲོད་པ་རྣམས་ཀྱི་མིག་གཅིག་པུ་ཚིག་དོན་གཉིས་ཀའི་ཞུ་ཆེན་གྱི་ལོ་ཙྪ་བ་བན་དྷེ་དཔལ་བརྩེགས་རཀྵི་ཏ་ཞེས་མཚན་ཡོངས་སུ་གྲགས་པ་དེས་རྒྱ་སྐད་ལས་བོད་སྐད་དུ་བསྒྱུར་ཅིང་ཚིག་དོན་གཉིས་ཀ་དག་པར་ཞུས་ཏེ་འཆད་ཉན་གྱིས་ཀྱང་གཏན་ལ་ཕབ་པའོ།",
    "ཡུན་རིང་དུས་ནས་གབ་པར་གྱུར་པ་ཡུམ་དོན་ཡིད་བཞིན་ནོར།",
    "ཁྱད་པར་རྒྱན་འགྲེལ་བཅུ་ཕྲག་གཉིས་དང་གཅིག།",
    "སྤྱི་དོན་རིགས་པས་ལེགས་པར་མཐའ་བཅད་ཅིང་།",
    "དེ་ཡང་ཡིད་ཆེས་གཞུང་དང་མི་འགལ་པར།",
    "གྲུབ་པ་འདི་ནི་འདི་ཡི་ཁྱད་པར་རོ།",
    "དེ་ལ་མི་འདོད་མེད་པར་དགའ་བཞིན་དུ།",
    "གཏིང་ཟབ་ལ་མཐའ་མེད་པའི་མཁྱེན་པ་དྲི་མ་མེད་པ་མངའ་བས།",
    "འཚལ་ཡང་དགོན་དུ་ཕལ་ཆེར་གྲུབ་པར་བྱས་ཤིང་།",
    "བདུད་མཁའ་མུན་པར་བྱེད་པ་འཁྲིགས།",
    "མེ་ཏྲི་པ་ཡི་བྱུག་པར་ཆགས།",
