    "དབུགས་ནི་རྣམ་པར་རྒོད་གྱུར་ན།",
    "ཞེས་བྱ་བ་ནི་ཉི་མ་ཉི་ཤུ་རྩ་དྲུག་ནས་སུམ་ཅུའི་བར་དུ་ནི་ལྔ་པའི་ཚུལ་གྱིས་ཤེས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གོང་མ་སྟེ་ལྔ་ནས་ཉི་ཤུ་ལྔའི་བར་གྱི་གྲངས་ཏེ་འཆི་བའི་དུས་ཀྱི་གྲངས་རྣམས་ཤེས་པར་བྱ་སྟེ།",
    "འོག་ནས་སྟོན་པས་དེར་ཤེས་པར་བྱའོ།་།",
    "ད་ནི་ངེས་པར་འཆི་བར་འགྱུར་བའི་ལུས་ཀྱི་མཚན་མ་བསྟན་པར་བྱ་བའི་ཕྱིར་སྒོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་ན་ཡི་གེའི་གཟུགས་ཀྱིས་སྟེང་དུ་བལྟས་པར་གནས་པའོ།",
    "ཆད་པ་ནི་དེའི་དབུས་ན་གནས་པའི་རྩ་ཆད་ན་སྟེང་དུ་བལྟས་པར་འགྱུར་ཞིང་སྣ་ཡོན་པོར་འགྱུར་ཏེ།",
    "ཆ་ཤས་ནི་ཆ་སྟེ་དབྱངས་ཡིག་དགུ་པ་ལ་བྱ་བ་ལྡུདེར་ཡང་དག་པར་གནས་པ་ནི་ཛའི་གཟུགས་སུ་གནས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣ་བ་གཡས་པར་བརྟེན་པ་ཞེས་བྱ་བ་ནི་རྣ་བ་གཡས་ཀྱི་འོག་འགྲམ་པའི་ངོས་རྗ་རྩའི་རྩ་སྟེ།",
    "ཅེས་བྱ་བ་ནི་གྲི་ལྡར་སྲོག་གཅོད་པར་བྱེད་པའི་རྩའོ།",
    "དེའི་ཚེ་དབུགས་རྩེག་པར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ནི་ཉི་མ་བཅུའི་མཐར་ཡང་དག་ཉལ་ཏེ་ལེགས་པར་ཉལ་ཞིང་འཆི་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།་",
