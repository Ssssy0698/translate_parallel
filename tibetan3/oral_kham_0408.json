    "ཨོཾ་བེ་རོ་ཙ་ནི་སོགས་རོལ་ཆེན་དང་།",
    "ལུས་བསམ་གཏན་གྱི་འདུག་སྟངས་དང་ལྡན་པས།",
    "ཅེས་པའི་བར་སྒྲུབ་ཐབས་རྒྱས་པ་བཞིན་གྱིས་བསྟན་མའི་གཏོར་མ་ཕུལ་ཞིང་རང་གང་འདོད་པའི་ཕྲིན་ལས་བཅོལ་ལ།",
    "༣༡པེ་སྣར་སུན་འདུག་པེ་སྣར་མྱང་།",
    "སྨོན་པ་འགྲོ་ཡང་རུང་འགྲོང་ཡང་རུང་འདུག་ཀྱང་རུང་སད་ཀྱང་རུང་རྟག་པར་རྒྱུན་དུ་དྲན་པར་གྱིས་ལ་ཡིད་ལ་ཟུང་སྟེ་སྒོམས་ཤིག་དང་།",
    "འདུག་པ་དང་ཉལ་བའི་དུས་ལ་བབ་པ་ན།",
    "འདུག་པ་དང་ཉལ་བའི་བདེ་བ་ལ་ལྷག་པར་ཆགས་པ་ནི་སྐྱོན་དང་བཅས་པ་ཡིན་ཞིང་ཞེས་ལུས་ཀྱི་ཁམས་བརྟགས་པ་སྟེ།",
    "འདུག་པ་དང་།",
    "དངོས་སུ་གནས་པ་དང་འདུག་པའི་སྤྱོད་ལམ་ལ་བརྟག་པར་བསྟན་ལ།",
    "ཁོ་བོ་ཅག་ནི་ཡུལ་སྒྱུ་མ་ཙམ་འདི་མེད་ཀྱང་རང་རིག་པའི་སྒོ་ནས་ཤེས་པ་ཉིད་དུ་ཁས་ལེན་པས་དམ་བཅས་པ་ཕན་ཚུན་འགལ་བའི་ཉེས་པ་མི་མཚུངས་སོ་ཞེ་ན།",
    "འོན་ཏེ་གང་ལས་ཀྱང་མ་སྐྱེས་ཀྱང་རང་བཞིན་གྱིས་གནས་སོ་སྙམ་ན།",
    "མཁས་པ་སུའི་གསུང་ཡིན་ཀྱང་གཟུགས་ཅན་གྱི་རྒྱན་དུ་བཀོད་འདུག་པས་དོནནི།",
    "དེ་རིང་རང་ཡང་ནུབ་པར་མི་འགྱུརབའི།",
    "སྤྱོད་བསྡུས་པས་སེམས་རྣམ་པར་དབེན་པའི་མཐར་ཐུག་པ་ཡང་རང་བཞིན་གྱིས་སྣང་བཙམ་ཡོངས་སུ་ཤེས་པཙམ་དུ་ཟད་པས།",
    "ཐོགས་མེད་བགྲོད་ནས་གདུལ་བྱ་རང་རང་ལ།",
    "ཚིགས་བཅད་འདི་ནི་སྔོནརི་རྣམས་འགྲོ་འདུག་བྱེད་པས་སྐྱེ་བོ་མང་པོ།",
    "སྐྱེ་བོ་རྣམས་ཀྱང་རང་བཞན་བཟང་པོའི་ངང་ཚུལ་ལ་གནས་པ་དང་།",
    "སྔ་ཕྱི་གང་དུའང་རང་ཚིག་འགལ་མེད་དང་།",
    "མི་རྣམས་ཚེ་རིང་ཞིང་གཟུགས་བཟང་བ་ལོངས་སྤྱོད་ཆེ་བ་ཕན་ཚུན་འཚོ་བ་གང་ཡང་མེད་ཅིང་རང་བཞིན་བཟང་བ་ཤ་སྟག་བྱུང་བསའདི་དག་ནི་ཤིན་ཏུ་བཟང་ངོ་ཞེས་བདེ་བར་གཤེགས་པ་སྔ་མ་དེ་དག་ཐམས་ཅད་ཀྱིས་བཏང་སྙོམསམཛད་པ་ཡི་སྟེ་བཏང་སྙོམས་སུ་བཞག་པ་ན།",
    "ད་དུང་གཉིད་མ་སད་ན་དེ་གདམ་ལསཀྱང་ལྷག་པའི་གདམས་པ་གནང་རྒྱུ་ཡན་འདུག་པ་སཾགཉིད་སད་པ་མ་ལེགས་ཤིང་ཤིན་ཏུ་ཕངས་སོ་སྙམ་དུ་དགའ་བ་དང་སྐྱོ་བ་ཟུང་དུ་འབྲེལ་བ་ཞིག་བྱུང་ངོ།",
    "དབྱུ་གུ་ཉི་ཤུ་རྩ་བཞི་ཞེས་པའདུག་སྟེ་དྲུག་ཅུ་རྩ་བཞི་ཡིན་ཤག་ལ།",
    "སྟང་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "ཞེས་གསུངས་པ་ཡིན་ནམ་སྙམ་པ་འདུག།",
    "དེའི་རྗེས་སུནི་ཡུམ་གྱིམངལ་ནང་དུ་གཙོ་བོ་ཡབ་ཡུམ་གསལ་འདེབས་དགོས་པ་ཡིན་པའི་ཚོད་ནི་མི་འདུགཅིང་།",
    "གཏོར་མ་ཆུ་ལ་སྦྱར་ན་བྱ་ཁྱི་ཁོ་ཐག་ཆོད་ཅེས་པ་དེ་ཡིནའདུག་ལགས།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "དམ་སྙམ་པ་འདུག་ལགས།",
    "ང་ཡི་བར་འཛིན་པའི་འཇིག་ལྟ་གཉིས་ཡོད་པར་གསུངས་འདུག་པས།",
    "ང་ཡི་བརའཛིན་པའི་འཇིག་ལྟས་ང་དང་ང་ཡི་བ་གཉིསཀ་ལ་དམིགས་པ་ནི་རྫེཙོང་ཁ་པ་ཆེན་པོ་ཡང་སྲས་ཀྱི་དགོངས་པ་ཡིན་འདུག་པས་ཐུགས་ལ་འདོགས་པར་ཞུ།",
    "རིགས་དྲམ་ཟེའི་ཁྱེའུ་ཙ་ན་ཀྵ།",
    "དབེན་པའི་གནས་སུའདུག་ཀྱང་དོན་མེད་ཡིན།",
    "ཐུགས་བྱམས་བརྩེའི་གཏེར་ཆེན་ཁྱེད་རང་མཁྱེན།",
    "རང་རང་བློ་མཚོ་རུ་སྐྱིལ་ནས།",
    "རང་རང་སྔགས་ཚིག་ལན་གསུམ་དང་བཅས་ཏེ།",
    "གཞན་དང་རང་གཞན་གཉིས་ཀའི་བསམ་པས་འཆང་།",
    "ཙ་ན་ཀ་ལྟར་བརྩོན་པ་ཆིག་བསྒྲིལ་ཐོས་པ་འཚོལ་ལ་བྱས་གྱུར་ཀྱང་།",
    "རང་རང་ཁྱད་ཡོན་ངོམས་ནས་སྙེམས་མི་འཚལ།",
    "ནུབ་རྒྱུད་ཀྱི་མཉམ་འབྲེལ་དེ་ཡང་གོམས་སྟབས་གཅིག་ཏུ་བསྒྱུར་བ་མིན་པར་རང་རང་སོ་སོའི་ལེགས་ཆ་འདོན་སྤེལ་བྱས་ཏེ་ཕན་ཚུན་ཁ་གསབ་བྱེད་པའི་ཚད་ལ་སླེབས་པ་བྱེད་དགོས་ལ།",
    "བྱ་ཚོགས་རང་རང་ཚང་མལ་ཕྱོགས་སུ་བསྙེགས།",
    "སྐྱེ་བའི་གཏམ་ཞིག་ཀྱང་འདུག།",
    "ཙ་ན་ཡིན་ཡང་ཞེ་སྡང་མེ་ལྕེ་ཚ་བོ་ཕུ་ནུའི་གཤེད་མ་རུ།",
    "ཧ་ཧ་འཇིགས་པའི་གད་རྒྱངས་དང་བཅས་ཨ་ཙི་གཤེད་མ་མཐོང་བ་ལྟར།",
    "ཚ་ཚ་འུར་འུར་མཚོན་གྱི་འཁོར་ལོ་ཙ་ན་ཡིན་ཡང་རྒྱུན་མི་ཆད།",
    "རློམ་སེམས་ཆེ་ཞིང་རང་རིགས་ལ་སྡང་བའི།",
    "གཞན་པ་མཐའ་ཡས་པ་དག་ཀྱང་རང་བློས་དཔག་པར་བྱ་ནུས་པ་ཞེས་པ་ནི།",
    "མ་བུ་གཉིས་ཀ་སྔར་ནས་གཉིད་དུ་ཡུར་འདུག་ལ་མཆོད་ཁྲིའི་སྟེང་དུ་མར་མེ་ཆུང་ཆུང་ཞིག་སྒྲོན་ཡོད་པས།",
    "ཡིན་ནའང་ང་རང་ཇི་སྲིད་དུ་མིའི་གྲས་སུ་བགྲང་ཐབས་མེད།",
    "འགྲོ་འདུག་ཉལ་བསམ་སོགས་བྱ་བའི་མིང་།",
    "ཁྱེད་རང་སྐྱི་གཡའ་བའི་རི་གྲོང་ཞིག་ཏུ།",
    "སྤོ་བོ་བསམ་འགྲུབ་ལགས་ནི་མདུན་གྱི་བུ་དེར་བལྟ་བཞིན་འོ་ཙི་བུ་ཁྱེད་རང་ལྷ་སར་གཏན་ནས་ཕེབས་མྱོང་མེད་པ་འདྲ།",
    "གལ་ཏེ་ཁོས་གཟི་དེར་སྒོར་ཆིག་སྟོང་ལ་བཙོང་ན་ངས་སྤོ་ཁྱེད་རང་ལ་སྒོར་ཆིག་སྟོང་རྔན་པ་སྤྲས་ཆོག་གལ་ཏེ་སྒོར་ཆིག་སྟོང་ལྔ་བརྒྱ་ལ་བཙོང་ན་ངས་སྤོ་ཁྱེད་རང་ལ་སྒོར་ལྔ་བརྒྱ་རྔན་པ་སྤྲས་ཆོག་ཅེས་བརྗོད།",
    "ཁྱེད་རང་རླངས་འཁོར་དུ་མི་སྡོད་པར་ཅིའི་ཕྱིར་རྐང་ཐང་དུ་ཡོང་བ་ཡིན་ཞེས་དྲིས་དུས།",
    "སང་ཉིན་ཞོགས་པའི་དུས་ཚོད་བདུན་གྱི་སྟེང་ཁྱེད་རང་ངེས་པར་དུ་ཞང་རླངས་འཁོར་ས་ཚིགས་སུ་སླེབས་དགོས།",
