    "ཕར་འགྲོ་ཚུར་འོང་གི་གོམ་ཁ་ལྷོད་པོ།",
    "ལང་ཚོའི་འདབ་མ་ལྷ་ས་ནས་འཚར་བ།",
    "ངས་ཀྱང་བརྗེད་མེད་དྲན་རྟེན་དུ་ཆགས་སོང་།",
    "རྐང་ཟུང་ཕྲ་མོའི་ལྡེམ་ལྡེམ་གྱི་བྲོ་གར།",
    "མཇིང་པ་མ་ཁེབས་གོང་ཁ་ནས་བུད་པ།",
    "ཆགས་ལྡན་སྐྱེ་བོའི་སེམས་ཁོང་གི་ན་ཟུག།",
    "གླུ་དབྱངས་སྙན་མོ་ལྷོད་ཆགས་ཀྱིས་བཀུག་པ།",
    "གཤིས་རྒྱུད་འཇམ་པོའི་ཚུགས་ཀ་ཡི་ལང་ཚོ།",
    "སྐུ་གཟུགས་དྲང་མོ་མཉེན་ལྕུག་གིས་འགུལ་བ།",
    "གངས་ལྷ་སྒེག་མོའི་བདེ་སྡུག་དང་ལྷན་དུ།",
    "ཡིད་འཕྲོག་ལྷ་མོའི་མཛེས་སྡུག་གི་རིན་ཐང་།",
    "རྒྱང་ལ་འཁྲེང་བའི་ཕྱི་མིག་མཚན་གནམ་འོག་གི་ཟླ་འོད།",
    "གཅེས་དགུའི་ཚེ་སྲོག་གཏའ་མར་འཇོག་གིན།",
    "ཁྲག་དང་མིག་ཆུ་ཕྱག་གིས་འབྱིད་ཀྱིན།",
    "མདའ་གྲི་མདུང་གི་སོ་ཁའི་བར་ནས་།",
    "ལ་རྒྱའི་རེ་ཁ་འདི་ནས་བཀོད་ཡོད།",
    "གངས་ཐང་སྐྱ་མོར་ཁྲག་གིས་སྦགས་པའི།",
    "ཡ་གིའི་ཁྲི་འཕང་བསྲུངས་ནས་བསྡད་མེད།",
    "ང་ཚོའི་མདུན་ལྗོངས་ཁོ་ནར་གཟིགས་ཏེ་།",
    "མཚན་མོ་ཞིག་ལ་ཆར་པ་ཤགཤག་འབབ་དུས།",
    "དགོང་མོ་ཞིག་ལ་གཡུ་འབྲུག་ལྷང་ལྷང་གྲགས་དུས།",
    "ལུས་ངག་ཡིད་གསུམ་བཅོལ་ས་ཅི་ཡང་མེད་སོང་།",
    "རྔ་དང་རོལ་མོ་བརྡུངས་པའི་ཆོ་གའི་བར་ནས་།",
    "ཁྲི་ཕྲག་འདུས་པ་རྒྱ་མཚོའི་གྲལ་མགོ་སྟོངས་ཐལ་།",
    "སྔ་འགྱུར་རྙིང་མ་ཚང་གི་སྲོག་ཤིང་ཆག་ཐལ།",
    "གྲུབ་བརྙེས་རིག་འཛིན་བྱེ་བའི་གཙུག་རྒྱན་ཐོར་ཐལ་།",
    "འདི་དག་རེ་རེ་ལས་ཀྱང་ན་ཟུག་སློང་བ།",
    "མཛད་པའི་རེ་ཁ་དཀར་པོ་ཕྱོགས་བརྒྱར་ཁྱབ་པའི།",
    "འཚོ་བའི་མཐུན་རྐྱེན་ཞན་པས་ལང་ཚོ་ཤོར་ནས།",
    "ལྔ་རིག་ནང་བསྟན་སློབ་གླིང་གྱེན་དུ་བསླངས་སོང་།",
    "སྣང་བ་བསླུ་བྲིད་མཁས་པའི་ངང་ཚུལ་གཟིགས་ན།",
    "འཕྱུགས་མེད་བཀའ་ལུང་ཟབ་མོའི་དབུགས་འབྱིན་གནང་མཁན།",
    "ཡ་གིའི་ཞིང་ཁམས་ཤིག་ལ་ཕེབས་དོན་ཅི་ལགས་།",
    "ཚེ་སྲོག་ཁྲག་གིས་གཤེར་བའི་བཞི་ཤད།",
    "ཁྲག་ལན་ཁྲག་འཇལ་བྱ་རྒྱུ་ཡོད་སོང་རུང་།",
    "མཚོན་ཁ་ནང་ལ་སྐོར་འདི་ཕམ་ཁ་རེད།",
    "ལང་ཚོའི་རིན་ཐང་རྙེད་པའིཤུལ་ལམ་ནས་།",
    "བཟང་ལན་ངན་འཇལ་དགོས་པའི་ཀླད་སྟོང་ཚོག།",
    "ཚེ་སྲོག་ཁྲག་གིས་གཤེར་བ་སུ་ཡིས་ལན།",
    "གཤེད་མ་སྟོང་གིས་ལག་ལེན་བསྟར་སྟངས་ཡིན།",
    "ང་ཚོའི་ཡོད་ཚད་ཡང་ཡང་སེམས་ལུགས་འདིས་།",
    "སུས་ཀྱང་འགྲན་པར་རུང་བ་མ་ཡིན་མོད།",
    "ང་ཚོའི་མདུན་ལྗོངས་རིང་ཐུང་ངོ་མ་དེ་དུས་ཁྱེད་ཀྱིས་གསལ་ལེར་གཟིགས་ཚོད།",
    "རྒྱང་ལ་བཞུད་སའི་སློབ་གླིང་དེ་ནས་གངས་ལྷ་སྒེག་མོའི་མཛེས་སྡུག་རུམ་ཞོར།",
    "ན་ཚོད་ཕྲ་མོའི་མཛེས་སྡུག་ཁྲོད་ནས་ཡར་ལ་གཟིགས་པའི་རྨུ་ཐག་འཚོལ་དུས།",
    "བདེ་མོ་སྐྱིད་པོ་ཞིག་འཚོལ་འཚོལ་འདྲ་ཡང་།",
    "ཕར་ཀྱོག་ཚུར་ཀྱོག་གི་ཁུག་སོ་རེ་ནས།",
    "ཤ་གསེང་རུས་གསེང་ན་ཟུག་གིས་བསྡམས་པའི།",
    "ཡོད་ཚད་བློས་གཏོང་གི་ཕོ་ཚོད་མེད་ཀི།",
    "ཞེ་ལ་ཐོགས་པའི་མཛེས་སྡུག་དབྱངས་གསལ་སོ་བཞིའི་མཛེས་སྡུགཐུ་བྷོད་ཚང་གི་གཞིས་ཁྱིམ་དྲོན་མོར་ཕྱོགས་བཞིའི་ནོར་གཡང་འགུགས་ས་ནས་།",
    "སྔོན་བྱོན་མཁས་པའི་ལྟ་གྲུབ་འཚོལ་དགོས་རང་གིས་རང་ལ་མཐོང་ཞིག་ཞོག།",
    "ཀ་རྩོམ་དད་པའི་རོལ་མོ།",
    "ཅ་ཅོ་འདུ་འཛིར་སྣང་བ་རང་རིག་གི་ཆོ་འཕྲུལ།",
    "ཆ་ལུགས་ཅི་བདེར་རོལ་ཀྱང་ཡེ་དག་གི་དཀྱིལ་འཁོར།",
    "ཧ་ཧ་གོ་མྱོང་རྟོགས་གསུམ་ཅི་རིགས་རེ་བྱོས་དང་།",
    "ཚིག་ངན་སྨྲ་བ་མང་པོས་ཨ་མཆོག་འུར་གྱིས་བཀང་མོད།",
    "ཚུར་ལ་ཞེ་འགྲས་བྱས་པ་ནམ་ཡང་མཐོང་ཐབས་བྲལ་སོང་།",
    "རྨི་ལམ་ནང་གི་རྒྱ་སེའི་མེ་ཏོག་དྲན་པའི་ཨ་ལོང་ལ་བཟུང་ནས།",
    "ཞོགས་པ་ཡར་ལང་གི་སྐབས་སུ།",
    "ལོ་ཟླའི་འཕྲེང་རིང་རེ་ཟད་ཀྱང་།",
    "ཚོར་བ་ཁེར་རྐྱང་དུ་གྱུར་སོང་།",
    "ཁྱེད་ཀྱི་ཡོད་ཚད་ཀྱི་རེ་ཁ།",
    "གདོང་གི་འཛུམ་མདངས་དེ་མཐོང་ན།",
    "མིག་གིས་ལྟ་ཙམ་རེ་མ་གཏོགས།"
  ]
}