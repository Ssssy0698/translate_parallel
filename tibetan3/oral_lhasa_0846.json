    "ཉམས་ལེན་བྱས་ཏེ་དལ་འབྱོར་དོན་ཆེན་བྱེད་པར་བྱིན་གྱིས་རློབས་ཞེས་པའོ།",
    "ཞེས་གསུངས་པ་ལྟར་ཡིན།",
    "བརྩོན་པ་ལྷུར་ལེན་བྱེད་པར་བྱིན་གྱིས་རློབས།",
    "ཡང་ན་སྐབས་འདིར་སྡོམ་པ་བཟུང་བའི་དམིགས་པ་བྱས་ཀྱང་འགྲིག་པ་ཡིན།",
    "བརྩོན་པ་ལྷུར་ལེན་བྱེད་པར་བྱིན་གྱིས་རློབས།",
    "ཞེས་པའི་མཚམས་འདིར་ཅུང་ཟད་རྒྱས་པར་བྱེད་ན།",
    "ཞེས་སེར་སྣས་ཀུན་ཏུ་འཛིན་པའི་ཆགས་པ་མེད་པར།",
    "དེ་བཞིན་དུ་ཞུམ་པའི་སེམས་མེད་པར་གཏོང་བའི་སེམས་པ་གོང་ནས་གོང་དུ་སྤེལ་བའི་ཐབས་ཚུལ་གྱི་མན་ངག་ལ་བརྟེན་ནས།",
    "ཞེས་ཁམས་གསུམ་གྱི་སྐྱེ་དགུ་མ་ལུས་པ་ཁྲོས་པར་གྱུར་ཏེ་གཤེ་ཞིང་སྤྱོ་བ་དང་།",
    "སྲོག་འཕྲོག་པའི་སྤྱོད་པ་བྱས་ཀྱང་དེ་ལ་གནོད་ལན་ནམ།",
    "གཞན་གྱིས་རང་ལ་གནོད་པ་བྱས་པར་ཅི་མི་སྙམ་ཞིང་སེམས་གཏན་ནས་མི་འཁྲུག་ཅིང་།",
    "བྱིང་རྒོད་རྣམ་པར་གཡེང་བའི་སྐྱོན་སྤངས་ནས།",
    "རྩེ་གཅིག་མཉམ་པར་འཇོག་པའི་ཏིང་འཛིན་གྱིས།",
    "དེ་ལ་རྩེ་གཅིག་ཏུ་མཉམ་པར་འཇོག་པའི་སྒོམ་མམ་རྩེ་གཅིག་པའི་ཏིང་ངེ་འཛིན་གྱི་སྒོམ་གྱིས།",
    "དོན་དམ་བདེན་པ་དེ་ཁོ་ན་ཉིད་རྟོགས་པའི་བློའི་ཡུལ་དུ་བྱས་ནས།",
    "དེ་ལ་རྩེ་གཅིག་ཏུ་མཉམ་པར་གཞག་པའི་མཉམ་བཞག་དེ་ཉིད་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་དྲངས་པའི་ལུས་སེམས་ཤིན་སྦྱངས་ཀྱི་བདེ་བ་སྟེ།",
    "ཉམས་མྱོང་དེ་ལ་བརྟེན་ནས་རྗེས་ཐོབ་ཏུ་གང་སྣང་དགག་བྱའི་རྣམ་པར་ཤར་བའི་ཚེ་ཡང་སྣང་ཡང་མི་བདེན་པར་སྒྱུ་མ་ལྟ་བུ་མཐོང་ཐུབ་པར་བརྟེན།",
    "མཉམ་བཞག་ནམ་མཁའ་ལྟ་བུའི་སྐྱོང་ཚུལ་གསུངས་པའི་ནམ་མཁའི་རྣལ་འབྱོར་གྱིས།",
    "སྣང་ཡང་བདེན་པར་མེད་པའི་ཚུལ་རྟོགས་ནས།",
    "སྒྱུ་མའི་ཏིང་འཛིན་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "སྣང་ཡང་གཟུགས་བརྙན་བཞིན་དུ་བདེན་པར་མེད་པའི་ཚུལ་རྟོགས་པའི་སྒོ་ནས།",
    "སྒྱུ་མའི་ཏིང་འཛིན་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཀླུ་སྒྲུབ་དགོངས་དོན་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "འཁྲུལ་བ་མེད་པར་རྟོགས་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཀླུ་སྒྲུབ་དགོངས་དོན་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "སྲོག་ལས་གཅེས་པར་འཛིན་པར་བྱིན་གྱིས་རློབས།",
    "གང་སྣང་ལྷ་སྐུར་འཆར་བར་བྱིན་གྱིས་རློབས།",
    "དམ་ཚིག་དང་སྡོམ་པ་རྣམས་ཚུལ་བཞིན་དུ་སྲུང་བ་གཞིར་བྱས་ཏེ།",
    "སྐུ་གསུམ་པོ་དེས་རིགས་འདྲའི་རྒྱུ་བྱས་ནས་མཐར་འབྲས་དུས་ཀྱི་རྒྱལ་བའི་སྐུ་གསུམ་འགྲུབ་པ་དང་།",
    "སྟོང་པ་ལྷའི་རྣམ་པའམ་ལྷ་སྐུར་འཆར་ཐུབ་པའི་རྣལ་འབྱོར་སྐྱོང་བ་དང་།",
    "འཆི་དུས་ཀྱི་བསྲེ་བ་གསུམ་བཅས་བསྲེ་བ་སྐོར་དགུ་གསུངས་པ་དང་།",
    "འཕགས་པ་ལྷའམ་ཨརྱ་དེ་བས་ཀྱང་སྤྱོད་བསྡུས་ནང་ཞིབ་ཕྲ་གསུངས་ཡོད་པ་ལྟར།",
    "གང་སྣང་ལྷ་སྐུར་འཆར་བར་བྱིན་གྱིས་རློབས།",
    "བདེ་བ་ལྷ་སྐུར་འཆར་བ་སྟེ།",
    "གང་སྣང་ལྷ་སྐུར་འཆར་བར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ་ཞེས་པའོ།",
    "འཆི་བའི་གནས་སྐབས་ཀྱི་འཆི་བ་འོད་གསལ་ལྟ་བུའི་འོད་གསལ་མངོན་དུ་བྱས་ནས།",
    "གཉུག་མ་ལྷན་ཅིག་སྐྱེ་བའི་འོད་གསལ་མངོན་དུ་བྱས་པས།",
    "ཟུང་དུ་འཇུག་པའི་ལམ་གྱི་རིམ་པ་རྣམས་ཕྱིན་ཅི་མ་ལོག་པར།",
    "ཞེས་པའི་གསུང་རྒྱུན་ཞིག་ཀྱང་ཡོད་པར་མ་ཟད།",
    "དེ་ནས་ཡང་ཏིག་བྱས་ཏེ།",
    "དག་པའི་ཞིང་དུ་བགྲོད་པར་བྱིན་གྱིས་རློབས།",
    "མྱོང་གོམས་དགའ་རབ་མེད་ན་སེམས་རགས་པ་རྣམས་ཐིམ་རྗེས་དཀའ་ལས་ཁག་པོ་ཡིན་པར་མ་ཟད།",
    "སོ་སོར་རྒྱུ་ནོར་ལོངས་སྤྱོད་ཏོག་ཙམ་ཡོད་པ་རྣམས་རང་ཉིད་མ་ཤི་གོང་ནས་ཐག་བཅད་དེ་གཙང་མ་ཏག་ཏག་བཟོ་བ་སྟེ།",
    "སྐྱབས་འཇུག་དང་བསྙེན་བཀུར་ཞུ་བ་ལ་དངུལ་ཇི་ཙམ་བཏང་དང་མ་བཏང་ལ་རྩོད་པ་ཤོར་བ་ལྟ་བུ་མི་དགོས་པར་བྱེད་པ་ཡིན།",
    "སྔོན་ལ་དངོས་གནས་འཆི་བ་ཟློག་ཐབས་ཡོད་མེད་བརྟག་དཔྱད་བྱས་ཏེ།",
    "གསུངས་པ་བཞིན་འཕེན་པའི་སྟོབས་དང་།",
    "ཡར་ཕུལ་དགོས་པ་དང་མར་སྦྱིན་པ་གཏོང་དགོས་པ་སོགས་ཆ་ཚང་བྱས་ཏེ་བརྡབ་བརྡབ་གསིག་གསིག་གམ།",
    "དམིགས་བསལ་གྱིས་བདག་འཇུག་སོགས་ཀྱིས་བཤགས་པ་བྱེད་དགོས།",
    "དེ་ཡོང་བ་ལ་འགལ་རྐྱེན་གྱིས་མི་ཚུགས་པར་ཆེད་དུ་དམིགས་ནས་བཤགས་པ་བྱེད་པ་ཡིན།",
    "དག་པའི་ཞིང་དུ་བགྲོད་པར་བྱིན་གྱིས་རློབས།",
    "དེང་སང་ལྷ་ས་སོགས་སུ་མི་གྲོངས་ཚར་རྗེས་བདུན་ཚིགས་བདུན་ཚིགས་དང་།",
    "ལོ་མཆོད་ཀྱི་སྐབས་སུ་ནང་མི་གཉེན་ཚན་རྣམས་མཉམ་འཛོམས་བྱས་ཏེ།",
    "ལོ་མཆོད་སོགས་ཀྱི་སྐབས་སུ་དགའ་ཉེ་བློ་དཀར་རྣམས་རུབ་རུབ་བྱས་ཏེ་གཙོ་བོ་ཕྱག་མཆོད་འབུལ་དང་ཁ་ཏོན་དགེ་སྦྱོར་བྱེད་པ་དང་ཆབས་ཅིག་ཇ་ཞིམ་པོ་འཐུང་བ་དང་ཟས་ཞིམ་པོ་ཞིག་ཟོས་ན་འགྲིག་ཀྱང་།",
    "དེ་ལས་སྤྲོས་ཏེ་ཐུགས་སྤྲོ་གཏོང་བ་སོགས་བྱས་ན་འདྲ་ཆགས་པོ་མེད་པར་མ་ཟད།",
    "ཞེས་གསུངས་པ་ལྟར་ཚོགས་ཞིང་བསྡུ་བ་ནི།",
    "ཚོགས་ཞིང་ལ་སྤྲོས་པ་མང་པོ་མེད་པར།",
    "ཞེས་སོགས་ཀྱི་དོན་ལ་བསམ་བློ་བཏང་ན་ཧ་ཅང་ཤ་གས་ཆེན་པོ་ཡོད་པར་མ་ཟད།",
    "ཞབས་སེན་འོད་ཆགས་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "དེ་ལྟར་བསམ་བློ་གཏོང་དགོས་པར་མ་ཟད།",
    "ཅེས་པའི་མཚམས་དེར་བསྡུ་ཆོག་མི་བྱེད་པར་བཞག་ནས།",
    "ཁ་བཏོན་དགེ་སྦྱོར་ཅི་ཞིག་བཏོན་ཀྱང་དེ་ཆ་ཚང་བར་བྱས།",
    "ཉིན་གང་སོ་སོའི་གང་འདོད་ཀྱི་དགེ་སྡུག་སྤེལ་མ་བྱས་ཏེ།",
    "ཉིན་གང་བོར་ཅི་བྱས་ཞུས་དག་ཅིག་བཏང་སྟེ།",
    "རང་སྐྱོན་ངོས་ལེན་གྱི་ཐོག་ནས་སོ་སོས་སོ་སོར་འཐབ་འཛིང་གཏོང་བ་ལྟར་བྱས་ནས་ཞུས་དག་གཏོང་བ་དང་།",
    "རང་དང་ཞལ་ལྟ་ཕྱོགས་མཐུན་པར་བཞུགས།",
    "ལྷག་པར་དུ་ཡང་གསོལ་བ་བཏབ་ནས་བདུད་རྩི་འབེབས་སྦྱངས་བྱས།",
    "སྤྱི་བོ་བདེ་ཆེན་གྱི་འཁོར་ལོའི་ནང་ལ་ཕེབས་ཏེ་འོད་ཟེར་འཕྲོས།",
    "ཡང་རྫོགས་རིམ་གྱི་དམིགས་པར་བསམ་བློ་གཏོང་ན་ཡང་འདིའི་མཚམས་སུ་བསམ་བློ་གཏོང་བ་ཡིན་ལ།",
    "འདི་ཕྱིའི་ལེགས་ཚོགས་ཐམས་ཅད་ཀྱི་རྩ་བ་བརྟན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "བརྗོད་བྱའི་དོན་རྣམས་ཁོང་དུ་ཆུད་པར་བྱས་ཏེ་ལེགས་པའི་ཆ་ཐམས་ཅད་ལེགས་པར་བསྡུས་ནས།",
    "ཡན་ལག་བདུན་པའི་ཚོགས་བསགས་པ་སྔོན་དུ་བཏང་ནས་དམིགས་བརྩེ་མའི་གསོལ་བ་འདེབས་པ་ལ་དམིགས་བརྩེ་མ་དགུ་སྐོར་སོགས་གསུངས་ཤིང་།",
    "དམིགས་བརྩེ་མ་དང་འབྲེལ་བའི་སྒོ་ནས་ཤེས་རབ་སྒྲུབ་སྐོར་གྱི་དམིགས་པ་རྣམས་བྱས་ན།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་རོལ་པ་ལས་བྱུང་བའི།",
    "མར་བདག་འཇུག་ལེན་པའི་སྐབས་སུ་བློ་ལ་འཆར་བདེ་བ་བྱས་ཏེ།",
    "དེས་རྐྱེན་བྱས་ཏེ་རང་ཉིད་འོད་ཞུ་བྱེད་པའམ་རང་ཉིད་འོད་གསལ་དུ་དག་ཅིང་།",
    "དེ་ནས་སྤྱོད་ལམ་གྱི་ལྷ་ལྟར་ཞལ་གཅིག་ཕྱག་གཉིས་པར་བསམ་བློ་བཏང་སྟེ་བདག་འཇུག་ལེན་པ་ལྟར།",
    "མཚན་སྔགས་གསོག་ན་ཡང་ཧ་ཅང་ལེགས་པར་མ་ཟད།",
    "བསྐྱེད་རྫོགས་ཀྱི་རྟོགས་པ་རྣམས་རྒྱུད་ལ་སྐྱེ་བའི་དམིགས་པ་བྱས་ཏེ།",
    "མཆོག་མྱུར་དུ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "དེ་ལྟ་བུའི་ཚུལ་ལ་བསླབ་ནས་སྐུ་བཞིའི་གོ་འཕང་དངོས་སུ་འདྲེན་པར་བྱེད་པའི་ཐབས་ཤེས་ངོ་བོ་གཅིག་ཏུ་ཚོགས་པ་སྟེ་ཐབས་ཤེས་དབྱེར་མི་ཕྱེད་པའི་ཟུང་འཇུག་མངོན་དུ་བྱས་ནས།",
    "ཞལ་ནས་ཞལ་དུ་བརྒྱུད་པ་ཞེས་བརྗོད་ཆོག་པར་མ་ཟད།",
    "གླེགས་བམ་ཆུང་ཆུང་ཞིག་ལ་སྙན་བརྒྱུད་ཀྱི་མན་ངག་ཅེས་ཧ་ཅང་བརྩིས་བསྡད་ན་དཀའ་ལས་ཁག་པོ་ཡིན་པས།",
    "ཕལ་ཆེར་བཀའ་གདམས་གཞུང་པ་བའི་ཕྱག་བཞེས་རྩ་བར་བཟུང་ཐོག་སྔགས་ཀྱི་སྣོན་པ་བརྒྱབས་པ་ཞིག་ཡིན་པས།",
    "ཁྱད་པར་རྗེ་བཙུན་བློ་བཟང་གྲགས་པ་ཡི།",
    "ལྷག་པར་དུ་ཡང་རབ་བྱུང་ན་ཚེ་རབས་ནས་ཚེ་རབས་སྐྱེ་བ་དོན་དང་ལྡན་པ་ཞིག་ཡོང་བར་བསམ་པ་བཟང་པོ་བསྐྱེད་པ་དང་།",
    "དེར་བརྟེན་བླ་སློབ་གཉིས་ཀའི་ངོས་ནས་བསམ་པ་རྣམ་པར་དག་དགོས།",
    "སྡུག་བསྔལ་སྐྱེ་བའི་རྒྱུ་རྩ་བ་ནས་མེད་པར་གྱུར་ནས།",
    "ལམ་ལོག་པ་ལས་ཁྱད་པར་དུ་འབྱེད་བྱེད་ཅེས་ཟེར།",
    "ཡིད་སྤྲུལ་གྱི་མཆོད་སྤྲིན་བཤམས་པ་དང་ཆབས་ཅིག་བསྟན་པ་རྒྱས་པ་དང་འགྲོ་བ་བདེ་བའི་ཐུགས་སྨོན་གནང་།",
    "མཁན་ཆེན་ཞི་བ་འཚོ་དཔལ་ནཱ་ལེནྜའི་མཁས་པའི་གཙུག་རྒྱན་གྱི་གྲས་ཆགས་ཡོད་པར་མ་ཟད།",
    "ཁོང་ནི་ནཱ་ལེནྜའི་མཁས་པ་གཅིག་འགྲེ་གཅིག་མཚུངས་ཙམ་ཞིག་མིན་པར།",
    "དེ་བཞིན་སློབ་དཔོན་བཀའ་དྲིན་ཅན་པདྨ་འབྱུང་གནས་སམ་པདྨ་སཾ་བྷ་ཝ་ཡང་ཁོང་དང་དུས་ཚོད་གཅིག་ལ་བོད་དུ་ཕེབས་ནས།",
    "དཔལ་ནཱ་ལེནྜ་ནས་ཕེབས་པའི་རྩོད་མེད་ཡོངས་གྲགས་ཀྱི་མཁས་པ་ཆེན་པོ།",
    "ཇོ་ནང་དང་བཅས་པ་ཚང་མས་མཁན་ཆེན་ཞི་བ་འཚོའི་ཕྱག་བཞེས་ལྟར།",
    "དུས་ད་ལྟ་ཡང་ཕྱག་སྲོལ་དེ་གནས་ཡོད་པར་བརྟེན།",
    "མ་ཡིན་པར།",
    "སྔ་འགྱུར་རྙིང་མའི་གསུངས་ཚུལ་ལྟར་བྱས་ན།",
    "བྱ་བ་འབྲས་བུ་དང་བཅས་པ་ལ་བཟླས་པ་ཞེས་བཟླས་པ་གསུམ་གྱི་དབྱེ་བ་ཕྱེ་ནས་གསུངས་པ་དང་།",
    "གཞིའི་གནས་ཚུལ་དེ་འདྲ་ཞིག་ཡིན་ན་བླང་དོར་གྱི་འཇུག་ལྡོག་ཇི་ལྟར་བྱེད་དགོས་སམ་ཞེས་བརྗོད་པ་ན་བདེན་བཞིའི་བྱ་བ་ལ་བཟླས་པ་གསུངས།",
    "དེ་ནས་བྱ་བ་འབྲས་བུ་དང་བཅས་པ་ལ་བཟླས་པ་ཞེས་པ་ནི་ལམ་དེར་བསླབ་པའམ་བླང་དོར་དེར་ཞུགས་ན་འབྲས་བུ་ཅི་འདྲ་ཞིག་ཡོང་ངམ་ཞེས་དྲིས་པའི་ལན་དུ་གསུངས་པ་ཡིན།",
    "ནང་པའི་གཞུང་ནས་ཀྱང་དངོས་ཁམས་རིག་པའི་སྐོར་གང་འཚམ་གསུངས་ཡོད་ཀྱང་།",
    "འཇིག་རྟེན་བཀོད་པ་པོས་བཀོད་པ་མིན་པར།",
    "གཞན་ལ་མི་དགའ་བར་བྱས་ཏེ།",
    "བློའི་བྱ་བའི་རིམ་པར་གཞན་ལ་གནོད་པའི་རིགས།",
    "གཞན་གྱི་བདེ་སྡུག་ལ་ཅི་མི་སྙམ་པར་གཞན་བདེ་ཁྱད་དུ་བསད་ནས།",
    "སྡུག་བསྔལ་ཉུང་དུ་གཏོང་རྒྱུའི་ཐབས་ཤེས་བྱེད་འོས་པར་མ་ཟད།",
    "སྡུག་བསྔལ་ཤེས་པར་བྱ།",
    "ཕྲག་དོག་ཆེན་པོ་བྱས་ན་འཕྲལ་སེལ་ཁེ་ཕན་ཅུང་ཟད་འགྲུབ་སྲིད་ཀྱང་།",
    "མཐར་རང་ཉིད་སུ་དང་ཡང་མི་འགྲིག་པར།",
    "དེ་ལས་ཞིམ་བུ་ཞིག་ཡོད་ཚེ་དེར་བྱམས་པོས་བྱུགས་བྱུགས་བྱས་ན།",
    "དེར་བརྟེན་སྲོག་ཆགས་ཚོར་ཕར་བྱམས་པོ་བྱས་ན་ཚུར་ཡང་བཟང་པོའི་བཟང་ལན་འཇལ་རྒྱུ་ཞིག་ཡོད་ཀྱང་།",
    "སེམས་མེད་བེམ་པོ་ལ་ཇི་ཙམ་གྱིས་རྩིས་པོ་བྱས་ཀྱང་བཟང་པོའི་བཟང་ལན་འཇལ་རྒྱུ་ཅི་ཡང་མེད།",
    "དངུལ་གྱིས་ཚུར་བརྩེ་བ་མི་སྤྲོད་པར་མ་ཟད།",
    "དེ་དང་མཚུངས་པར་དེང་སང་དངོས་པོ་ཡར་རྒྱས་དང་འབྲེལ་བའི་ཐོག་ནས་མིའི་བདེ་སྐྱིད་ཅེས་བརྗོད་པའི་ཚེ།",
    "སེམས་སྟེང་ནས་ཡིད་བདེ་སྐྲུན་མི་ཐུབ་པར།",
    "སེམས་ཀྱི་བདེ་སྐྱིད་དེ་ཕྱི་རོལ་གྱི་ཆ་རྐྱེན་ལ་བརྟེན་ནས་ཡིད་ཚིམ་པར་བྱེད་པ་དང་།",
    "མི་དེ་མཁས་པ་མིན་པར་མ་ཟད་མཐར་གཏུགས་ན་ཕལ་ཆེར་དུད་འགྲོ་དང་གཅིག་མཚུངས་ཡིན།",
    "དོན་དམ་པའི་དགའ་བོ་བྱས་ནས་ཡོང་མིན་ཐེ་ཚོམ་ཡིན།",
    "དེ་ནི་དངུལ་ལ་བལྟས་ནས་དགའ་བོ་བྱས་པ་ལས་དོན་དམ་པའི་མི་དང་མིའི་བརྩེ་བ་བྱས་ནས་མིན།",
    "ཕྱི་དངོས་པོའི་ཁྲ་ཁྲ་ཟང་ཟིང་ཁོ་ན་ལ་མགོ་འཁོར་ནས་བསྡད་པ་ནི།",
    "རྒྱུ་རྐྱེན་བྱེ་བྲག་པ་གཅིག་རྡོག་སྒྲུག་བརྒྱབས་ན་མི་འགྲིག་པར་མ་ཟད།",
    "འདི་ལྟར་བསམ་ན་ཁྱད་པར་ཧ་ཅང་ཆེན་པོ་ཡོད།",
    "༢༡ ནས་༢༩ བར་ཨ་རིའི་སྲིད་འཛིན་གནང་།",
    "ངའི་གྲོགས་པོ་ཧ་ཅང་ཡག་པོ་ཞིག་ཡིན་པར་མ་ཟད།",
    "སྤྱི་ལོ་༢༦ ཟླ་༡༢ ཚེས་༣ སྲོག་ཐོག་ཉེས་པར་སྐེ་ལ་དཔྱང་ཐག་བརྒྱབས་ཏེ་དཀྲོངས།",
    "དེ་ནི་རྒྱུ་རྐྱེན་གཅིག་ཙམ་མིན་པར་རྒྱུ་རྐྱེན་མང་པོ་དང་འབྲེལ་ཡོད་པ་མཐོང་བ་ཡིན་ན།",
    "དེ་ནི་དངོས་ཡོད་གནས་ཚུལ་ལ་བརྒྱ་ཆ་དགུ་བཅུ་ཐམ་པ་སེམས་ཀྱིས་སྒྲོ་བཏགས་པ་ཞིག་མ་གཏོགས་ཕ་རོལ་པོའི་ཡུལ་སྟེང་ནས་ངན་པ་དེ་འདྲ་ཞིག་མེད་པར་བཤད།",
    "རྒྱུ་རྐྱེན་མང་པོའི་ཐོག་ནས་ཡོང་བསྡད་པ་མཐོང་ན་བསམ་བློ་རང་བཞིན་གྱིས་གུ་ཡངས་པོ་ཡོང་ངེས་ཡིན།",
    "བ་ཞིག་ངེས་པར་དུ་ཡོད་པས།",
    "ནང་པ་རྣམས་བཅོམ་ལྡན་འདས་ཀྱི་ལུང་ཙམ་ལ་སྐྱབས་སུ་མཆི་བ་མ་ཡིན་པར་ལྟ་གྲུབ་ཧ་ཅང་རྩད་གཅོད་གཏོང་དགོས་པ་ནི་བཅོམ་ལྡན་འདས་རང་ཉིད་ཀྱིས།",
    "ལེགས་པར་བརྟག་ལ་ང་ཡི་བཀའ།",
    "ཞེས་ངའི་རྗེས་འབྲངས་དགེ་སློང་དང་མཁས་པ་རྣམས་ཀྱིས་ང་ལ་དད་པ་དང་ཡིད་ཆེས་བྱས་ནས་ཁས་ལེན་མི་དགོས་པར།",
    "ཡིད་ཆེས་གཙང་མ་བྱེད་དགོས་གསུངས་ཡོད་ན་ཀླུ་སྒྲུབ་ཡབ་སྲས་ལ་སོགས་པས་བརྩད་གཅོད་དེ་ལྟ་བུ་བྱེད་མིཐུབ།"
  ]
}