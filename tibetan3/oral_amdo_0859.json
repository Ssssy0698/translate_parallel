    "ཤིན་ཏུ་བཟང་མོའི་ཡི་གེའི་རབ་ཏུ་སྦྱོར་བ་དེས་ནི།",
    "ཞུ་བྱས་བདུད་རྩི་དྲོན་མོ་བཅས།",
    "མེའི་རྣམ་པའི་ལྷ་མོ་དེ།",
    "དེ་ལྟར་རེ་རེའི་ཞེས་བྱ་བ་ནི་སྔགས་ཀྱི་ཡི་གེ་རྣམས་ཀྱི་མཐར་རོ།",
    "བདུད་རྩིའི་འོད་བཞིན་གདན་བཞིའི་རིམ་པ་སྟེ་གང་གི་ཕྱིར་དེར་གསུངས་པའོ།",
    "དེ་ལྟར་སྔོན་མོའི་ད་གཟུགས་ཞེས་བྱ་བ་ནི་གཅིག་གིས་དམན་པའི་དུམ་བུ་ལྔ་བཅུའི་བདག་ཉིད་ཅན་ནོ།",
    "རྣམ་པར་སྣང་མཛད་ནི་ཡི་གེ་ཨོཾ་མོ།",
    "རིག་བྱེད་ཀྱི་དང་པོ་ཡི་གེ་ཨོཾ་མོ།་།",
    "དེ་ནི་བདེན་ཏེ་འོན་ཀྱང་བཅོམ་ལྡན་འདས་ཀྱི་ཚིག་གིས་མི་འགྱུར་བ་གསུངས་པ།",
    "བརྩེ་བའི་བདག་ཉིད་ཅན་གྱི་རྣལ་འབྱོར་པས་རང་གི་སེམས་གསད་པ་དེ་དྲུག་པའི་དོན་གྱིས་དང་པོ་དེ་རང་གི་སེམས་གསོད་པར་བྱེད་པ་སྟེ།",
    "ཁྱབ་འཇུག་གིས་ནི་ཐམས་ཅད་དཀྲུགསབྱེ།",
    "དེའི་ཕྱིར་རང་གི་སེམས་བསད་པས་ཐམས་ཅད་གསད་ཌ་པར་འགྱུར་རོ།",
    "རང་གི་སེམས་ཀྱིས་དེ་ལྟར་ཞེས་བྱ་བ་ལ་དགོངས་པའི་དོན་ཏོ།",
    "མཐའ་ནས་རིམ་པས་ཞེས་བྱ་བ་ནི་པདྨའི་འདབ་མ་རེ་རེ་ལ་ཀླུའི་རྒྱལ་པོ་བརྒྱད་རེ་རེ་སྟེ་རྩའི་ཡི་གེས་ཀྱང་ཀླུའི་རྒྱལ་པོ་རྣམ་པར་རྒྱལ་བ་དང་།",
    "མཐའ་ཡས་ཀྱིས་གནོན་པ་ནི་འོག་དང་སྟེང་གི་དབྱེ་བས་སོ།",
    "ཇི་སྲེད་དེར་ཐིམ་ནས་སོང་གི་བར་དུའོ།",
    "དེས་དེ་ལྟར་གཏོང་བ་དང་འགེངས་པ་དག་གིས་ཆར་དབབ་པ་བུམ་པ་ཅན་གྱིས་བྱ་སྟེ།",
    "ཀླུ་མོ་རྣམས་འདིར་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་རྣམས་ཀྱི་རང་བཞིན་ནོར་རྒྱས་ལ་སོགས་པའི་ཆུང་མ་དེ་རྣམས་ཀྱང་དེ་ཉིད་བྱས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ཐབས་གང་གིས་ན་བུམ་པ་ཅན་ལ་སོགས་པར་འགྱུར་བ་ཞེས་པ་ལ་སོགས་པས་འགྱུར་བ་གསུངས་པ།",
    "བརྒྱད་བརྒྱད་ཅེས་བྱ་བ་ནི་དྲུག་ཅུ་རྩ་བཞི་སྟེ་ཀླུ་རེ་རེ་ལ་བརྒྱད་བརྒྱད་དུ་འགྱུར་རོ།",
    "དེ་ལྟར་ཐམས་ཅད་རྡོ་རྗེ་ཕག་མོའི་རྩ་བའི་སྔགས་ཀྱི་འཁྲུལ་འཁོར་རྣམས་སུ་བྱའོ།",
    "དཔལ་མཁའ་འགྲོ་རྒྱ་མཚོ་རྣལ་འབྱོར་མའི་རྒྱུད་ཀྱི་རྒྱལ་པོ་ཆེན་པོའི་འགྲེལ་པ་གྲུ་གཟིངས་ལས་བཅོམ་ལྡན་འདས་ཀྱི་རྩ་བའི་སྔགས་དང་དེ་བཞིན་དུ་ཤིན་ཏུ་བཟང་མོའི་རྩ་བའི་སྔགས་གཉིས་སུ་མེད་པའི་སྦྱོར་བའི་བདག་ཉིད་དང་མིང་གི་ཡི་གེ་རྣམས་དང་དཀྱིལ་འཁོར་གྱེ་འཁོར་ལོའི་བདག་པོ་བྱེ་དང་ལས་ཀྱི་ཚོགས་ཀྱི་མཚལས་སྦྱོར་གྱི་སྐད་ཅིག་གིས་གསད་ཀྱེཔ་ལ་སོགས་པས་དང་ཀླུ་དགུག་པ་ལ་སོགས་པས་དང་རྟའི་འཁྲུལ་འཁོར་གྱི་ཆོ་གའི་མཚན་ཉིད་རྒྱས་པར་བསྟན་པ་སྟེ།",
    "ལས་ཀྱི་སྦྱོར་བར་ལྷ་མོ་དེ།",
    "དེ་ལྟར་ཡང་ཐམས་ཅད་ཀྱི་མིང་གི་ཡི་གེའི་ངེས་པའི་ཚིག་གི་སྦྱོར་བ་བསྡུས་པའི་དོན་གྱི་གནས་གང་དུ་གནས་ཞེ་ན་གསུངས་པ།",
    "དེས་ཧའི་ཡི་གེ་ནཱ་ད་ལས་ཞེས་བྱ་བ་ནི་བདེ་བའི་ཐིག་ལེ་ཙམ་མོ།",
    "ཞེས་བྱ་བ་ནི་གཏུམ་མོ་དེ་ཉིད་དེ་ལྟར་ནཱ་དའི་བདག་ཉིད་ཅན་ཡེ་ཤེས་ཀྱི་འོད་གསལ་བ་ངེས་ཏེ།",
    "ཀྱང་གི་ཡི་གེ་ནི་སྡུད་པའོ།",
    "དེ་ལྟར་བྱུང་བ་གང་གིས་ཡིན་ཞེ་ན་གསུངས་པ།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་སྟེ་རེ་རེའི་ནང་རྣམས་སུ་རྟ་རྣ་མ་ལ་སོགས་པ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་གཟུགས་ཀྱི་གནས་པའོ།",
    "ཎའི་ཡི་གེའི་དོན་གྱི་ལྷ་མོ་དེ་ཡང་གསལ་བ་མ་ཡིན་ཞེས་བྱ་བ་སྟེ།",
    "ཡང་གི་ཡི་གེ་ནི་བསྡུ་བའོ།",
    "སྡང་བ་རྣམས་ཀྱི་སྐྱོན་སྤངས་པས་རང་གི་སེམས་ཀྱི་ནང་དུ་དེ་ལྟར་གྲོལ་བའོ།",
    "ཐམས་ཅད་ཀྱི་བདག་ཉིད་དུ་གང་གི་ཚེ་འགྱུར་བ་སྟེ་བརྟན་པ་དང་འགྲོ་བ་ལ་སོགས་པའི་ཁྱབ་པ་པོར་རོ།",
    "དེ་ལྟར་ཐོག་མར་ཞེས་བྱ་བ་ནི་རེའུ་མིག་ཐོག་མ་ལ་སྟེ་མརྣམ་པར་སྣང་མཛད་ནི་ཡི་གེ་ཨོཾ་མོ།",
    "རྡོ་རྗེ་ཕག་མོའི་གསུམ་པའི་འཁྲུལ་འཁོར་སྔགས་ཀྱི་འཁྲུལ་འཁོར་གྱི་འཁོར་ལོ་རྣམས་སུའོ།",
    "སྦར་ཡང་ངོ་མཚར་ཞེས་བྱ་བ་ལ་སོགས་པས་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མའི་འཁོར་རྣམས་ཀྱི་དང་།",
    "དེའི་ཚེ་རང་ཉིད་ལ་ཡིད་ཆེས་པ་རྣམས་ཀྱིས་བདག་གི་ཤེས་པ་དེས་བེེར་ཡང་དིང་ཞེས་བྱ་བ་ལ་སོགས་པ་དེ་དེ་བཞིན་ནོ།",
    "ཀྱེ་བཅོམ་ལྡན་འདས་བདག་པོ་ཁྱབ་བདག་སྟོན་པ་ཅི་ཡིས་བདག་ཅེས་བྱ་བ་ནི་ཕྱག་ན་རྡོ་རྗེ་ལ་སོགས་པ་དང་དཔའ་བོ་ཐམས་ཅད་གལ་ཏེ་བདག་ཅག་འབྲས་བུ་དང་རྒྱུའི་རང་བཞིན་དུ་རྣམ་པར་གཞག་ཐུན་དེའི་ཚེ་ཛད་ཉིད་གང་གི་རང་བཞིན་དུ་རྣམ་པར་བཞག་ཛིཅེས་བདག་གི་ཐེ་ཚོམ་ཡོད་དེ།",
    "གསད་པ་ཞེས་བྱ་བ་ནི་རང་གིས་བཅོམ་ལྡན་འདས་ཀྱི་གཟུགས་ཉིད་ཀྱིས་སོ།",
    "ལས་ཀྱི་སྦྱོར་བས་གནས་པ་མོ།",
    "བྱ་གདོང་ལྷ་མོར་ཀྱེཕྱག་བྱས་ནས།",
    "ཡི་དྭགས་འཁོར་ལོ་ཉིད་ལྷ་མོ།",
    "འདོད་པ་ཀུན་སྟེར་བདག་གིས་བཤད།",
    "རྙེད་དཀའ་བ་ནི་གང་གིས་དེ་ལྟར་ལམ་བཟང་བོར་རབ་ཏུ་འཇུག་ཅིང་ལམ་ངན་པ་སྤོང་བ་སྟེ།",
    "དེ་ལྟར་གང་གིས་བསྒྲུབ་པར་བྱ་ཞེ་ན།",
    "འཁོར་ལོའི་གཙོ་མོ་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་བདག་ཉིད་ཅན་ནོ།",
    "ཕོ་ཉ་ཞེས་བྱ་བ་ནི་འདིར་ཕོ་ཉའི་སྒྲས་རང་གིས་རིག་པ་འབབ་པའི་རྩ་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པ་སྤངས་པ་འདིས་ནམ་མཁའི་གཟུགས་ཀྱི་བདག་ཉིད་དུ་གནས་སོས།",
    "གང་གི་ཚེ་དེའི་ཚེ་རྐན་དང་རྡོ་རྗེ་ཆུ་སྐྱེས་དབུས་སུ་ཞེས་བྱ་བ་ནི་རབ་སྤྲུར་བ་གསུངས་པ།",
    "དེས་དེའི་དུས་སུ་མདའི་ཤུགས་ཀྱིས་གྱེན་དུ་བསྐྱོད་པ་སྟེ་རང་གི་སེམས་ཀྱི་སྦྱོར་བས་ལུས་ཐམས་ཅད་འདར་བར་བྱ་སྟེ།",
    "ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "བརྒྱ་ལ་ཞིག་ན་རྣལ་འབྱོར་པ་རང་གི་འདོད་པའམ་མི་འདོད་པས་མཚན་ཉིད་དུ་འགྱུར་རོ།",
    "མ་ཡིག་རང་གིས་རིག་པ་ཞེས་བྱ་བ་ནི་བདག་ཉིད་ནམ་མཀ་འི་གཟུགས་སྐྱེས་ཏེ་དེ་ཉིད་ཕོ་ཉ་སྟེ་རང་གིས་རིག་པའི་བདག་ཉིད་སྔོན་གྱིའོ།",
    "ཞེས་བྱ་བའི་ཚིག་གིས་ཀྱང་ངོ།",
    "རྣལ་འབྱོར་མ་ལས་རྣམས་སྒྲུབ་པ་མོའོ།",
    "རིག་བྱེད་དང་པོ་ནི་ཡི་གེ་ཨོཾ་མོ།",
    "དེ་ལྟར་ཡང་རྡོ་རྗེ་ཕག་མོའི་བཞི་པའི་འཁྲུལ་འཁོར་གྱི་འཁོར་ལོ་རྣམས་སུ་ཤེས་པར་བྱའོ་ཞེས་བྱ་བ་ནི་བྲངེས་པའོ།",
    "རེངས་པའི་དོན་གྱི་ལས་རྣམས་ཀྱི།",
    "འཁོར་ལོ་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་རེངས་པའི་ལས་རྣམས་སུའོ།",
    "དེ་ལ་སོགས་པ་རེངས་པར་བྱ་བ་གསུངས་པ།",
    "བྱེས་པའི་རིགས་ཅན་ཐ་མལ་པར་སྐྱེས་པ་རྣམས་ཀྱི་རྨོངས་པ་ནང་དང་ནང་དུ་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སྤྱཏིང་ངེ་འཛིན་མ་བྱས་པ་དེའི་དུས་སུ་བྱུང་བ་རྣམས་ཀྱི་དེ་ལྟར་རེངས་པར་བྱེད་པ་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "གཉིས་པ་ནི་དེའི་དུས་སུ་རྣམ་པར་ཆད་པ་རྣམས་ཀྱི་བཛད་པའི་རྒྱུར་ནང་གི་བདག་ཉིད་ཀྱི་ལས་རྣམས་སོ།",
    "ད་ནི་ཡི་གེ་རེ་རེའི་རབ་ཏུ་སྦྱོར་བ་གསུངས་པ།",
    "དེར་གནས་ནས་ཐམས་ཅད་དུ་འགྲོ་བས་དེའི་འགྲོ་བ་དང་འོང་བ་རེངས་པར་བྱེད་དེ་དུ་གཡོ་བ་མེད་པའི་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱག་རྒྱ་བཟང་མོར་བཅས་པས་སོ།",
    "ཞེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་ལ་སོགས་པས་བགྲོད་པའི་རྣལ་འབྱོར་པ་ལྔརྣམས་ཀྱི་གཏུམ་མོ་ལ་སོགས་པའི་འདོད་ཆགས་ཀྱི་མེས་ཨ་ཝ་སྒྲུ་ཏཱིར་རབ་ཏུ་གཞུག་པ་སྟེ་དེ་ཉིད་ལྷ་རྫས་ཀྱི་ཕྱག་རྒྱའི་ཡན་ལག་ཅན་མ་སྟེ་དེའི་ཐིམ་པ་རྣམ་པར་ཤེས་པ་བདེ་བའི་དབུས་རྣམས་སུ་སྟེ་ཐམས་ཅད་ཀྱི་བདག་ཉིད་དུའོ།",
    "བདེ་བ་ཉིད་ཀྱང་ལུས་ཐམས་ཅད་ལ་ཐིམ་ནས་འགྲོ་སྟེ་ཁྱབ་བདག་ཅེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "སྔོན་དུ་བརྗོད་པ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་སྔོན་དུ་བྱས་པ་དེ་དེ་བཞིན་དུ་སཐོག་མ་ཞེས་བྱ་བ་ནི་ཐོག་མའི་རེའུ་མིག་ལའོ།་།",
    "རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བ་ནི་ཡི་གེ་ཨོཾ་མོ།",
    "འོན་ཀྱང་དེ་ལྟར་ཐམས་ཅད་རྡོ་རྗེ་ཕག་མོའི་འཁྲུལ་འཁོར་གྱི་འཁོར་ལོ་ལྔ་པར་རབ་ཏུ་བྱ་བ་སྟེ།",
    "གནང་བས་བདག་གིས་རབ་སྨྲ་བྱ།",
    "བསྐྲད་པར་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རང་གི་སེམས་ལ་སོགས་པ་རྣམས་སོ།",
    "དེར་སླར་ཡང་སྐམ་བྱ་ཨཱའ་རྣམ་པ་ཡིས་ཞེས་བྱ་བ་ནི་ལྔའ་རྣམ་པ་ཅན་ནི་བུམ་པ་ཅན་རྨི་སྦྱོར་བས་རྣམ་པར་བཟུང་བར་གྱུར་པས་ཐམས་ཅད་དུ་ཐིམ་ནས་འགྲོ་བ་སྟེ་ཁམས་ཐམས་ཅད་དུ་བསྡུ་བ་བྱས་ཐུསྦར་ཡང་མགོ་བོའི་དབུས་སུ་འོང་བ་སྟེ་མགོ་བོར་རྣམ་པར་གཟུང་བར་བྱ་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "མགོ་བོའི་དབུས་སུ་དང་འཕྱང་བར་དེ་ཉིད་རྒྱལ་མཚན་ཏེ་ལོངས་སྤྱོད་ཀྱི་རླབས་གཉིས་རྒྱལ་མཚན་གྱི་རྣམ་པར་རེག་པས་སོ།",
    "འདིའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཀྱིས་དཔག་ཚད་འབུམ་ཕྲག་སྟོང་ཕྲག་སྟེ་ཉེ་བར་མཚོན་པ་ཙམ་མོ།",
    "རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བ་ནི་ཡི་གེ་ཨོཾ་མོ།",
    "ཞེས་བྱ་བ་ནི་དུམ་བུ་འདི་ལ་ཧཱུཾ་གི་ཡི་གེའི་དང་པོར་ཛའ་ཡི་གེ་སྦྱིན་པར་བྱའོ།",
    "སུམ་ཅུ་པ་ལ་དེ་ཉིད་ཅེས་བྱ་བ་ནི་ཧཱུཾ་གི་ཡི་གེ་སྦྱིན་པར་བྱའོ།",
    "རོ་ལངས་ཞེས་བྱ་བ་ནི་སྟག་གི་རྣམ་པར་༤བྱས་ནས་དེའི་ཁ་རུའོ།",
    "དེ་ལྟར་ཡང་ཐམས་ཅད་རྡོ་རྗེ་ཕག་མོའི་འཁྲུལ་འཁོར་དང་སྔགས་དང་འཁོར་ལོ་དྲུག་པར་བྱའོ།",
    "དབྱེ་བའི་ལས་ནི་བྱེད་པ་མོ།",
    "མིང་གི་ཡི་གེ་རབ་སྦྱོར་བས།",
    "འཁྲུལ་འཁོར་ཟུང་དུ་གནས་པ་མོ།",
    "ཕྱི་རོལ་བཀླགས་པས་གྲུབ་པ་མོ།",
    "དེའི་ཕྱིར་མཆོག་གི་བཅུད་ལེན་ཏེ་བཅུད་ལེན་ཐམས་ཅད་ཀྱི་དབུས་སུ་གྱུར་པ་དམ་པའི་དངོས་པོའི་རོ་མཆོག་གི་བདུད་རྩིའི་བཅུད་ལེན་ཏེ་དེ་འཛིན་པ་ནི་ཡོངས་སུ་འཛིན་པར་བྱེད་དེ།",
    "མཆོག་གི་གཙོ་བོ་སྟེ་བརྗོད་དུ་མེད་པའི་བདུད་རྩིའོ།",
    "པདྨར་ཞེས་བྱ་བ་ནི་ཁམས་ཐམས་ཅད་སོ་སོར་གྱུར་ནས་སྣ་ཚོགས་པའི་རྩ་ལ་སོགས་པ་དེ་རྣམས་ཀྱི་མཆོག་གི་པདྨར་རྣམ་པར་གནས་པ་སྟེ་མང་པོའི་ཚིག་གོ།",
    "གཙོ་མོ་མཆོག་ཅེས་བྱ་བ་ནི་ཆང་འཚོང་མ་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱང་རྟེཉམས་པར་བྱེད་པའི་ཕྱིར་མཆོག་གོ།",
    "རང་གི་སེམས་སྣག་ཚས་བྲི་བར་བྱ་བ་ནི་འཇུག་པར་བྱ་བ་སྟེ་རང་གིས་རིག་པའི་རང་བཞིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་གཉིས་པ་ཞེས་བྱ་བ་ནི་ཕྲེང་གཉིས་པ་རྣམས་ལ་སྟེ་རེའུ་མིག་བདུན་རྣམས་ལ་ཇི་ལྟ་བའི་རིམ་པས་ཡི་གེ་རྣམས་གསུངས་པ།",
    "དེ་བཞིན་དུ་སྒོའི་ལོགས་སུ་རེ་རེ་སྟོང་པ་སྤངས་པར་བྱ་བ་སྟེ།",
    "ལྷོ་དང་བྱང་གི་དུམ་བུ་གཉིས་སུ་ཡི་གེ་རྣམས་གཉིས་གཉིས་སུ་གསུངས་པ།",
    "དེ་བཞིན་དུ་དྲུག་པའི་ཕྲེང་གི་དུམ་བུ་རྣམས་ལ་རིམ་པ་ཇི་ལྟ་བས་བདུན་རྣམས་གསུངས་པ།",
    "དེ་ལྟར་སླར་ཡང་ཀུན་དུ་སྤྱོད་པ་ལ་སོགས་པ་ཐམས་ཅད་རྡོ་རྗེ་ཕག་མོའི་འཁྲུལ་འཁོར་དང་སྔགས་དང་འཁོར་ལོ་བདུན་པར་ཤེས་པར་བྱ་སྟེ།",
    "ཏིང་ངེ་༥འཛིན་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་མིང་གི་ཡི་གེ་རྣམས་ཀྱིས་རྒྱས་པར་འཆད་པའོ།",
    "གང་གིས་རྣལ་འབྱོར་གྱིས་ཤེ་ན་གསུངས་པ།",
    "དེས་དེའི་ཚེ་གཟུགས་ཆེན་པོ་སྟེ་རང་གི་སེམས་པར་སྣང་ལ་བལྟས་པས་གཡོ་བའི་སེམས་འཆིང་བ་ཞེས་བྱ་བ་སྟེ།",
    "འདི་ཞེས་བྱ་བ་ནི་རྨའི་ཡི་གེའི་ཕྱི་མོ་ཨིའི་ཡི་གེས་ཏེ་ཨི་མིའི་རྐྱེན་གྱི་ཎིའི་ཧཱུཾཡི་གེའི་ཡང་དོན་ཏོ།",
    "ཧའི་ཡི་གེ་གང་གི་ཕྱིར་གྱི་དོན་ཏེ་ནམ་མཁའ་ལ་ཞེན་པས་སྟོན་གྱི་ནམ་མཁའ་དྲི་མ་མེད་པ་ཉི་མ་གུང་གི་ནམ་མཁའི་རྣམ་པའི་སེམས་ཀྱི་རྒྱུན་ཡེ་ཤེས་དང་ཤེས་བྱ་དེ་རྣམས་གཉིས་སུ་མེད་པར་སོན་པར་བལྟས་པས་ཞེས་བྱ་བ་ནི་ངེས་པའོ།",
    "རྩ་ནམ་མཁའ་དབུས་མི་མཐོང་སྟེ་སྲོག་གི་ཡོངས་སུ་སྦྱོར་བས་ཁ་སྟེང་དུ་བལྟས་པར་འབབ་སྟེ།",
    "མཐོང་བར་འགྱུར་ཏེ་ནམ་མཁའི་རྣམ་པར་སོང་བ་ནའོ།",
    "གཟུགས་དེ་རྣམས་སུ་ཡེ་ཤེས་ལྐུགས་པའི་རྣམ་པ་བཞིན་དུ་གནས་པ་སྟེ་རང་གི་པ་སེམས་བཅིངས་པའོ།",
    "གང་གི་ཕྱིར་ན་དེ་བྱེད་པ་པོ་བྱེད་ཀྭ།",
    "གསེར་གླིང་གི་ཡི་གེ་རྣམས་ཀྱིས་སོ།",
    "བདག་མེད་པའི་མཚན་ཉིད་དུ་སྐད་ཅིག་མ་ཟད་པས་ཀྱང་བསམ་དུ་མེད་པས་དངོས་པོ་ཐམས་ཅད་དུ་གང་ཟག་གི་བདག་མེད་པའི་གཟུགས་སུ་འགྱུར་རོ།",
    "རྒྱུ་དང་འབྲས་བུ་གཉིས་དག་གིས།",
    "གཞུའི་སྦྱོར་བས་འུ་ནི་ལ་ལ་ནཱ་དང་ར་ས་ནཱ་གཉིས་བསྐྱོད་པར་འགྱུར་བས་ཕྱིན་ཅི་ལོག་གི་སྤྱོར་བ་སྟེ།",
    "དེ་དག་གི་དབུས་ཀྱི་མདའ་ནི་ཨ་ཝ་སྒྲུ་ཏཱི་མདར་འགྱུར་རོ།",
    "འདིས་སྔགས་སྐྱེས་ཞེས་བྱ་བ་ནི་སེམས་ནི་ཟིགཡོ་བའི་སྦྱོར་བས་རྩ་གསུམ་མནན་པས་གཏུམ་མོ་རབ་ཏུ་འབར་བ་སྟེ།",
    "སྲོག་ཆགས་ཞེས་བྱ་བ་ནི་སྲོག་དང་ཡང་དག་པར་ལྡན་པ་སྟེ་སྲོག་ཆགས་ནི་རང་གི་སེམས་ཀྱི་རང་བཞིན་ནོ།",
    "དེ་བྱེ་རྣམ་པར་སྣང་མཛད་ནི་ཡི་གེ་ཨོཾམོ།",
    "ཉུང་ངུ་བསྡུས་པར་ཤེས་པར་བྱས་ནས་དེ་ཐམས་ཅད་ཕྱི་རོལ་དུ་བྱི་བའི་སྟེང་གི་ཞེས་བྱ་བ་ལ་སོགས་པས་བྱ་སྟེ།",
    "བ་ལང་གི་རྨིག་པ་ཞེས་བྱ་བ་ནི་བ་ལང་ཤི་བའི་རྨིག་པར་རོ།",
    "དེ་ལྟར་སླར་ཡང་ནང་གི་བདག་ཉིད་དུ་བདག་ཉིད་ཀྱི་བྱེ་ཨ་ཝ་དྷཱུ་ཏཱིའི་ནང་དུ་བྱས་ནས་ཞེས་བྱ་བ་སྟེ།",
    "སྲིན་པོ་ཞེས་བྱ་བ་ནི་བྱི་ལའམ་རྔ་མོའོ།",
    "འཁོར་ལོའི་གོ་ཆ་མའི་མིང་གི་ཡི་གེ་ལ་སོགས་པའི་རབ་ཏུ་སྦྱོར་བས་ལྐུགས་པར་བྱ་བ་དང་སྣ་ཚོགས་པའི་མན་ངག་གི་རབ་ཏུ་སྦྱོར་བའི་ཆོ་གའི་མཚན་ཉིད་དང་།",
    "རང་བདག་གིས་ལས་རྟོགས་བྱེད་མའི།",
    "དེ་ནས་ཤིན་ཏུ་དཔའ་མོའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་རྣམས་ཀྱིས་སྙེཤིན་ཏུ་དཔའ་མོའི་ཡི་གེའི་རབ་ཏུ་སྤྱོར་བ་བྱའོ།",
    "ཧིའི་ཡི་གེ་ནི་གང་གི་ཕྱིར་གྱི་དོན་ཏེ།",
    "དོན་དམ་པའི་རང་གི་མཚན་ཉིད་ཀྱི་ཡན་ལག་ཡང་གསུངས་པ།",
    "དེ་ལྟར་ཡང་ཐམས་ཅད་རྡོ་རྗེ་ཕག་མོའི་དགུ་པའི་འཁྲུལ་འཁོར་དང་སྔགས་དང་འཁོར་ལོ་རྣམས་སུ་ཤེས་པར་བྱའོ།",
    "བརྩེ་བས་བདག་གིས་དེའི་འགྲེལ་པ།",
    "དེ་ནས་ལྷ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཚིགས་སུ་བཅད་པ་གཅིག་གིས་རྡོ་རྗེ་ཕག་མོས་བཅོམ་ལྡན་འདས་ལ་དྲིས་པ་དང་།",
    "མ་མོའི་འཁོར་ལོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "མ་མོའི་འཁོར་ལོ་ཞེས་བྱ་བ་ནི་ལེའུ་བཅོ་ལྔ་པ་ཇི་ལྟ་བའམ།",
    "དྲག་ཤུལ་སྦྱོར་བའི་མཚན་ཉིད་ཅེས་བྱ་བ་ནི་ཏིང་ངེ་འཛིན་འདི་རྣམས་ཀྱི་མཆོག་གི་རྣལ་འབྱོར་རྣམས་ཀྱིས་སེམས་རྣམ་པར་བསྐྱེད་པའི་དྲག་ཤུལ་གྱི་སྤྱོར་བ་བྱ་བའོ།",
    "གང་གིས་ཤེ་ན།",
    "ལོ་ནྱན་སྟིཞེས་བྱ་བ་ནི་འདིར་རྩ་འདི་རྣམས་ཐམས་ཅད་ཀྱི་རེ་རེའི་བུ་ག་གསུམ་གྱི་བདག་ཉིད་ཅན་རྩ་གསུམ་གསུམ་དུ་འགྱུར་ཏེ།",
    "ཞེས་བྱ་བ་ནི་ལྟེ་བའི་གནས་ལ་གང་གི་ཚེ་སའི་རང་བཞིན་སྟེང་དུ་བགྲོད་པ་དེའི་ཚེ་དེས་གཟུང་བ་གསུམ་གྱིས་མགོ་བོ་ལ་མཚན་ཞིང་བརྒྱན་པ་སྟེ།",
    "འཕྱང་བའི་སྒོར་ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་ཆུ་འགྲོ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་ཤེས་བྱ་རྣལ་འབྱོར་མཆོག་ནི་ཞི་བ་ལ་སོགས་པ་བསྲུང་བ་ཆེན་པོའི་གཟུགས་ཅན་དེ་རྣམས་ཀྱི་ས་དང་བསྲུང་བ་ཐམས་ཅད་ཀྱི་རྩོགཟུགས་ཀྱིས་བསྒྲུབ་བྱ་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་གྱིའོ།",
    "དེས་ལྟ་བ་ཡང་དག་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གིས་སོ།",
    "རྡོ་རྗེ་ཕག་མོའི་བཅུ་པའི་འཁྲུལ་འཁོར་དང་སྔགས་དང་འཁོར་ལོར་གོ་བར་བྱའོ།",
    "གནས་ཀྱི་གཙོ་མོ་བཞུགས་པ་སྟེ།",
    "འགྲོ་བའི་གཙོ་མོས་སྒྲུབ་པ་ཡིས།",
    "མཆོག་སྟེར་ད་ལྟར་བདག་གིས་ནི།",
    "གཏུམ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདིར་ཐོག་མར་རྩའི་ཡི་གེ་ལ་སོགས་པས་འཁོར་ལོས་སྒྱུར་སྤྲུམའི་མིང་གི་ཡི་གེ་ལྷག་པར་བརྗོད་དེ།",
    "དེ་རྣམས་བསྲེགས་ནས་སླར་ཡང་ཐིག་ལེའི་གནས་སུ་སོང་ནས་གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པ་བསྲེག་གོ།",
    "རེ་རེའི་དེ་ཚེ་སྤྱོད་པ་ཡིས།",
    "ཡེ་ཤེས་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་ཙམ་མོ།",
    "དེ་ཡང་འགྲོ་བ་མེད་ཅེས་བྱ་བ་ནི་མི་སྣང་བར་སོང་བའོ།",
    "བདག་གི་གདན་ལ་དེ་ལྟའོ།",
    "སོང་བ་སྟེ་མ་ར་ཎའི་སྒྲས་སོ།",
    "དེ་རེ་རེ་ལས་རེ་རེའི་དེ་ཇི་ལྟར་འདོད་ཅེ་ན།",
    "གསང་བའི་མཐར་གནས་པ་གསང་བའི་གདན་ཏེ་ཧིས་ནི་གང་གི་ཕྱིར་ཏེ་ཐམས་ཅད་མཁྱེན་པ་གདན་གསུམ་གྱི་ཉེ་བར་སྤྱོད་པ་ལས་ཐམས་ཅད་ཀྱི་གཟུགས་ཐམས་ཅད་དེ་ཐམས་ཅད་མཁྱེན་པ་གསང་བའི་གདན་དེའི་བདག་ཉིད་ཅན་ཏེ།",
    "རྣལ་འབྱོར་གྱི་ནི་མིང་གིས་བརྗོད།",
    "ད་ནི་རྒྱས་པའི་ལས་ཀྱི་རྒྱུད་རྔུལས་ཐམས་ཅད་པའི་ཐབས་སམ་ཊུརྒྱས་པའི་རྒྱུད་དེ་རྣམས་སྒྲུབ་པའི་སྦྱིན་སྲེག་གི་རྫས་དང་ཆོ་ག་གསུངས་པ།",
    "བ་ལང་རྟ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རང་བཞིན་དངོས་གྲུབ་ཅེས་བྱ་བ་ནི་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་སྟེ་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི་ཉེ་བར་སྤྱོད་པས་སོ།",
    "རང་གི་སྦྱོར་བའི་རྐྱེན་གྱིས་སྐྱེས།་།",
    "ཞེས་བྱ་བ་ནི་རང་གི་དུབདག་གི་རྣལ་འབྱོར་ལས་བྱུང་བ་གང་གི་ཚེ་ཡི་དྭགས་ལ་སོགས་པ་ཐམས་ཅད་རང་གི་ཡིད་ཀྱིས་བསམས་པ་ཙམ་ཀྱིས་སོ།",
    "སྔགས་ཀྱི་ཡི་གེ་རྣམས་ཀྱིས་ཞེས་བྱ་བ་ནི་ཨོཾ་ཏཱ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཡང་ན་དུམ་བུ་གཅིག་གིས་དམན་པའི་ལྔ་བཅུའི་བདག་ཉིད་ཅན་ལའོ།",
    "སརྦ་བུདྡྷཱ་ཌཱ་ཀི་འུ།་",
    "དེའི་ཕྱི་རོལ་དུ་ཇི་ལྟ་བ་བཞིན་ཞེས་བྱ་བ་ནི་དེ་རྣམས་ཀྱི་དུམ་བུ་བཅུ་དྲུག་རྣམས་ཀྱི་དུམ་བུ་རེ་རེ་ཉུ་བར་དུམ་བུ་བརྒྱད་བརྒྱད་རྣམས་ལ་ཡི་གེ་རེ་རེ་སྟེ་སྠཱ་མ་གསུངས་ཀྱང་བི་ཀྲྀ་ཏཱ་ན་ན་བྲི་བར་བྱའོ།",
    "དེ་བཞིན་དུ་མཚམས་ན་གནས་པ་མོའི་རྣལ་འབྱོར་མ་གཏི་མུག་དགའ་མ་ལ་སོགས་པའོ།",
    "ཁྱབ་བདག་རང་གིས་ཞེས་བྱ་བ་ནི་སྔགས་ཀྱི་ཡི་གེའི་གཟུགས་ཀྱིས་སོ།",
    "དེས་མཚམས་ཐམས་ཅད་དུ་ཞེས་བྱ་བ་ནི་ལུས་ཀྱི་མདུད་པ་ཐམས་ཅད་དེ་སྤྱི་གཙུག་ལ་སོགས་པ་ནས་རྐང་པའི་མཇེ་བོང་གི་བར་རྣམས་སུ་རྩ་སོ་སོའི་ཁའི་བུ་ག་ནི་མཚམས་སུ་གོ་བར་བྱ་སྟེ།",
    "ཚིགས་བཞི་བཅུ་རྩ་དགུ་པོ་དེ་རྣམས་ཀྱི་སོ་སོར་ཞུརེ་རེའི་ཡང་མཚམས་ཀྱི་གྲངས་གསུངས་པ།",
    "དེ་ལྟར་ཐམས་ཅད་ཀྱང་རྡོ་རྗེ་ཕག་མོའི་འཁྲུལ་འཁོར་དང་སྔགས་དང་འཁོར་ལོ་བཅུ་གཅིག་པར་གསུངས་པའི་སྦྱོར་བ་རྣམས་སུ་ཡང་བྱའོ་ཞེས་འདི་ནི་ངེས་པའོ།",
    "གསང་བའི་མན་ངག་སྟོན་པ་མོ།",
    "རྒྱས་པ་ཡང་ནི་སྒྲུབ་པ་མོ།",
    "བཅུད་ལེན་ལ་སོགས་གསང་བ་མོའི།",
    "གང་གིས་བསྒྲུབ་པར་བྱ་བ་དེ་གསུངས་པ་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་ཚེ་དེ་རྣམས་ཀྱིས་བསྡུས་པར་དང་རྡོ་རྗེ་ཕག་མོའི་འཁོར་ལོས་ཀྱང་བརྒྱད་ཅུས་ངལྷག་པའི་བདུན་བརྒྱའི་དཔའ་བོ་རྣམས་སོ།",
    "ཁམས་བརྒྱད་པོ་ཐམས་ཅད་དུ་དེ་རྣམ་པ་གསུམ་དུ་མཚོན་པར་བྱའོ་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "དེ་ལྟར་དཔའ་བོ་འཕྱང་བའི་རང་བཞིན་དེ་རྣམས་ཕག་མོ་ལ་སོགས་པའི་རྩ་འདི་རྣམས་ཐམས་ཅད་ཀྱི་ནང་དུ་ཡོངས་སུ་གནས་པར་ཤེས་པར་བྱ་བ་ནི་མིང་གི་ཡི་གེའི་རབ་ཏུ་སྦྱོར་བའི་ཡེ་ཤེས་ཀྱི་བརྩོན་འགྲུས་ཆེན་པོ་ཁྱབ་པར་བྱེད་པ་པོ་སྟེ།",
    "གང་གི་ཚེ་མཆོག་ཏུ་ཟག་པ་མེད་པའི་དུས་སུ་ཁམས་དེ་གཉིས་འཕྱང་བའི་ཁོངས་སུ་ཞེས་བྱ་བ་ནི་འདི་རྣམས་ཐམས་ཅད་འཕྱང་བ་ཅན་དེ་རྣམས་ཀྱི་ཁོངས་སུ་ཨ་ཝ་སྒྲུ་ཏཱིའི་རྡོ་རྗེའི་ཁོངས་དེའི་དབུས་སུ་རབ་ཏུ་འཇུག་པར་འགྱུར་རོ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་ཁམས་ཐམས་ཅད་ཞུ་བས་ནམ་མཁའ་བཞིན་དུ་གནས་སོ་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "དེའི་ཕྱིར་སྐྱེ་འགྲོ་ཀུན་གྱི་རྒྱས་པ་ཞེས་བྱ་བ་ནི་རང་གི་ལུས་ལ་བསྒྲུབ་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དེའི་གོ་འཕང་གིས་གནས་པས་བརྗོད་པ་མེད་པ་སྟེ།",
    "དེ་ལྟར་ཐོད་པའི་དུམ་བུ་ཞེས་བྱ་བ་ནི་གཅིག་གི་མིང་བཟུང་བས་འདི་རྣམས་ཐམས་ཅད་ཀྱི་མིང་བཟུང་བ་སྟེ་དུས་ལ་སོགས་པར་འགྱུར་རོ།",
    "མང་པོའི་ཚིག་གིས་འདིའི་ངེས་པ་དེ་ལྟར་འདིར་སྟེན་མོ་དང་སོ་འབབ་པ་ཞེས་བྱའོ།",
    "སླར་ཡང་དེ་ལྟར་དུམ་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་མཆོག་གི་བདེ་བར་བརྗོད་ཅེས་བྱ་བའི་བར་དུ་དཔའ་བོ་རྣམས་ཀྱིས་ཀྲུ་རང་གི་མིང་རྣམས་ཀྱི་ངེས་པའི་ཚིག་བསྟན་ཏོ།"
  ]
