    "ལེན་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྲིད་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྲིད་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྐྱེ་བ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྐྱེ་བ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རྒ་ཤི་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རྒ་ཤི་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ནང་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ནང་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཕྱི་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཕྱི་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མི་བྱའོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མི་བྱའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྟོབས་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྟོབས་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྨོན་པ་མྱེད་པ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སྨོན་པ་མྱེད་པ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མྱི་འཇིགས་པ་བཞི་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "མྱི་འཇིགས་པ་བཞི་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བྱམས་པ་ཆེན་པོ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "བྱམས་པ་ཆེན་པོ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་བདག་གི་དོན་ཅེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་བདག་གི་དོན་མ་ཡིན་ཞེས་སྤྱད་པར་མྱི་བྱའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ལ་བསླབས་ཤིང་།",
    "ལེའུ་ལྔ་བཅུ་གསུམ་མོ།",
    "ཁྱིམ་བདག་གི་རིགས་ཆེ་ཞིང་མཐོ་བར་སྐྱེ་བ་དང་།",
    "ཆུང་སྣང་གི་ལྷར་སྐྱེ་བ་དང་།",
    "དེ་ལ་གང་གིས་ཡོན་ཕུལ་བ་དེ་དག་ཀྱང་རིམ་གྱིས་འདི་ལྟ་སྟེ།",
    "གང་གི་དོན་ཏུ་བདག་གིས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་པར་བྱའོ།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་ཐམས་ཅད་རྒྱུན་འཆད་པར་འགྱུར་རོ།",
    "མྱི་ཁོམ་པ་དང་ངན་སོང་ཐམས་ཅད་རྒྱུན་འཆད་པར་འགྱུར་རོ།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་ཐམས་ཅད་ཀྱང་རྒྱུན་འཆད་པར་མྱི་འགྱུར།",
    "རབ་འབྱོར་དེ་བཞིན་ཉིད་གང་གིས་དེ་བཞིན་གཤེགས་པར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་འཕགས་པ་ཐམས་ཅད་དུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་གཟུགས་སུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་ཚོར་བར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་འདུ་ཤེས་སུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་འདུ་བྱེད་དུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་རྣམ་པར་ཤེས་པར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་མྱིག་དུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་རྣ་བར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་སྣར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་ལྕེར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་ལུས་སུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་ཡིད་དུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་གཟུགས་སུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་སྒྲར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་དྲིར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་རོར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་རེག་ཏུ་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་མྱིག་གི་རྣམ་པར་ཤེས་པར་གདགས་པ་དང་།",
    "དེ་བཞིན་ཉིད་གང་གིས་རྣ་བའི་རྣམ་པར་ཤེས་པར་གདགས་པ་དང་།",
