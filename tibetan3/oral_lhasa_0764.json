    "གཡས་པས་ཐུགས་ཀ་ན་གནས་པའི་པདྨ་ཁ་འབྱེད་པར་མཛད་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ནུབ་ཕྱོགས་སུ་པདྨ་དམར་པོ་འདབ་མ་རྗེ་བརྒྱད་པའི་གདན་ལ་བཞུགས་སོ།",
    "པྲཛྙཱ་དྷྲིཀ་ཅེས་བྱ་བ་ལས་བྱུང་བའི་དོན་ཡོད་པར་གྲུབ་པ་བེ་ཌཱུརྱ་ལྗང་སེར་ལྟ་བུ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ།",
    "དེ་བེེར་བཀུག་ནས་མེའི་ཕྱོགས་སུ་ཟླ་བ་ལ་བཞུགས་སོ།",
    "གཡོན་པ་དག་ན་ནོར་བུ་དང་རལ་གྲི་བསྣམས་པ་དེས་གདོན་ལ་སོགས་པས་བསྐམས་པ་རྣམས་རྒྱས་པར་བྱ་སྟེ།",
    "ཧཱ་ཞེས་བྱ་བ་འདི་ལས་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་ཕྱག་གཡོན་པ་རོལ་པའི་ཚུལ་གྱིས་གདན་མནན་པ།",
    "ཁྱད་པར་རྣམས་ནི་བརྗོད་པར་བྱ་སྟེ།",
    "གཡོན་པ་དྲིལ་བུ་དང་བཅས་པས་སྙོམས་པར་ཞུགས་པའི་རོ་ལངས་མའི་ནུ་མ་འཛིན་ཅིང་།",
    "གད་རྒྱངས་སྤུཀྱིས་རི་བོའི་ཚོགས་འཇིག་པར་མཛད་པ།",
    "བིསྤྱོནྟ་ཀྲྀཏ་ཅེས་བྱ་བས་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པ་བགེགས་ཀྱི་རིགས་༥མ་ལུས་པ་སྐྲག་པར་མཛད་པ་ཟར་མའི་མེ་ཏོག་ལྟ་བུ།",
    "མེའི་མཚམས་སུ་པདྨ་དང་ཉི་མའི་གདན་ལ་གཡོན་བརྐྱང་བས་མེ་ལྷ་མནན་ནས་བཞུགས་པར་བསམ་པར་བྱའོ།",
    "གཡོན་པ་དྲིལ་བུ་དང་བཅས་པས་སྙོམས་པར་ཞུགས་ཤིང་འཁྱུད་པའི་རིག་མའི་ནུ་མ་འཛིན་ཅིང་།",
    "ཕྱག་ལ་སོགས་པ་རྣམ་པར་སྣང་མཛད་དང་མཚུངས་པ་སྟེ།",
    "འོན་ཀྱང་སྟེང་ན་ཚངས་པ་དང་ཉི་མ་དང་ཟླ་བ་ལ་སོགས་པ་རྣམས་མནན་ནས་བཞུགས་པར་བསམ་པར་བྱ་སྟེ།",
    "གསེར་དང་མཚུངས་པའི་འཇོག་པོ་སྒེག་པ་དང་བཅས་པས་རྣ་རྒྱན་བྱས་པ་༡།",
    "པདྨ་དམར་པོ་ལྟ་བུའི་ནོར་རྒྱས་ཀྱི་བུས་རྣམ་པར་སྤྲས་པའི་སྐ་རགས་བཟང་པོ་མངའ་བ།",
    "ཀླུ་པདྨ་དང་དུང་སྐྱོང་དཀར་པོ་དང་དམར་པོས་རྐང་གདུབ་བྱས་པ།",
    "ཕྱག་རྒྱ་བཞིས་ལྷའི་འཁོར་ལོ་རྒྱས་བཏབ་པར་བལྟ་བར་བྱས་ཏེ།",
    "དེ་རྣམས་དང་ལྷན་ཅིག་ཐ་མི་དད་པར་ལྷའི་འཁོར་ལོ་བསམ་པར་བྱའོ།",
    "གྲུབ་པ་དང་རིག་པ་འཛིན་པ་ལ་སོགས་པའི་ཚོགས་རབ་ཏུ་དགའ་བ་དང་ལྡན་པ་རྣམས་ཀྱིས་བྱས་པའི་གླུ་དང་གར་དང་པི་ཝང་དང་གླིང་བུ་དང་རྫ་རྔ་དང་ཁར་དཀྲོལ་ལ་སོགས་པའི་ཅ་ཅོའི་སྒྲས་ནམ་མཁའི་དབྱིངས་མ་ལུས་པ་ཀུན་དུ་གང་ཞིང་འཁྲུགས་པ་དང་།",
    "ཡང་ན་ཕུང་པོ་ལ་སོགས་པ་བྱིན་གྱིས་བརླབས་པས་་སྙོམས་པར་ཞུགས་ཤིང་ལས་ལ་གནས་པའི་གཟུགས་གབྱུག་པུ།",
    "བརྟན་པར་བྱ་བ་དང་།",
    "རྗེས་སུ་མཉེས་པར་ཡང་བྱའོ།་།",
    "ཐམས་ཅད་ཀྱི་ཆོ་ག་ཀུན་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཧཱུཾདང་མཚུངས་པར་བྱའོ།",
    "དེ་ལྟར་མཚན་མ་དང་ལྷའི་རྗེས་སུ་གནང་བ་ཐོབ་པ།",
    "སྒྲུབ་པའི་དཀྱིལ་འཁོར་དུ་ཐམས་ཅད་བྱེད་ཅིང་གྲུབ་པ་ནི་འགྲོ་བ་མ་ལུས་པ་རྣམས་ཀྱི་བསམ་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་ནུས་པར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་དེའི་ཐུགས་ཀའི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གཞུག་ཅིང་བཟླས་པར་༥བྱ་སྟེ།",
    "འདིས་ནི་རྡོ་རྗེ་གསུམ་དང་མཚུངས་པར་འགྱུར་རོ།",
    "ཡི་གེ་ཨོཾ་ལས་འཁོར་ལོའི་ཕྱག་རྒྱ་དང་རྣམ་པར་སྣང་མཛད་རྣམས་སྤྲོ་བར་བྱའོ།",
    "ཐམས་ཅད་དུ་སྔགས་བརྗོད་པར་བྱ་ཞིང་།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་ཐམས་ཅད་ཡང་དག་པར་སྤྲོས་ཏེ།",
    "དེ་རྣམས་ཀྱིས་ནམ་མཁའ་ལ་བརྗོད་པའི་མཐར་དེ་རྣམས་ཡང་དག་པར་བསྡུས་ཏེ།",
    "ཕྱིའམ་ནང་ངམ་གཉིས་ཀའི་བར་ན་སེམས་གནས་ཞེས་རྣམ་པར་དཔྱོད་༡པ་ནི་སྐུ་རྡོ་རྗེ་དང་གསུང་རྡོ་རྗེ་དང་ཐུགས་རྡོ་རྗེ་རྣམས་ཀྱི་བཟླས་པ་ཡིན་ནོ།",
    "འདོད་པ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ།",
    "ཞེས་བྱ་བས་གང་ཡང་རུང་བའི་མིང་ཅན་ཇི་སྲིད་འདོད་པར་བཟླས་པ་བྱས་ལ།",
    "དེའི་དོན་ལ་ངེས་པར་བརྟག་པར་བྱ་སྟེ།",
    "དངོས་གྲུབ་རབ་མཆོག་བསྒྲུབ་པར་བྱ།",
    "ངག་དང་ལུས་ཀྱང་རྣམ་པར་བསྒོམ།",
    "སྤྱོར་བ་རྣམ་གསུམ་བསྒྲུབ་པར་བྱ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "སྤྱོད་པ་དྲི་མེད་ཀུན་དུ་བཟང་པོ་བདག་ལ་དགྱེས་པར་མཛོད།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ལ་༧གསོན་པར་མཆིས་བཞེད་ན།",
    "ཡོན་ཏན་རིན་ཆེན་མང་པོའི་གཏེར་གྱུར་བདག་ལ་དགྱེས་པར་མཛོད།",
    "རྣམ་པར་སྣང་མཛད་རབ་ཏུ་དག།",
    "ཞེས་བྱ་བས་བསྟོད་པར་གྱུར་ཏོ།",
    "དེ་རྣམས་ཀྱང་ནམ་མཁའ་དང་མཚུངས་པར་དམིགས་ནས་ཉེ་བར་བསྡུ་བར་བྱའོ།",
    "ཟླ་བ་ལྟར་བསིལ་བའི་རྒྱུན་རྐན་གྱི་ཕྱོགས་སུ་བབས་པས་རྩ་རྣམས་ཀྱི་སྦུབས་ཁྱབ་པའི་སྒོ་ནས་ལུས་ཐམས་ཅད་ཚིམ་པར་བསམ་པར་བྱའོ།",
    "དེ་ནས་ལྕེའི་འོད་ཟེར་གྱིས་བཀུག་ལ་བཟའ་བ་དང་བཏུང་བ་ལ་སོགས་པ་བྱས་ན་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཏེ།",
    "འཇིག་པའི་དུས་ཀྱི་མེ་དང་ཉི་མ་ལྟ་བུ་རང་ལ་བཀའ་ནོད་པར་བསམས་ནས་མངག་པར་བྱའོ།",
    "ཞེས་བརྗོད་ན་ཞག་བདུན་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་དྷྲི་ལས་བྱུང་བའི་ཉི་མའི་དཀྱིལ་འཁོར་ཉི་མ་བྱེ་བ་དང་མཚུངས་པ་༤་རྣམ་པར་བསམས་ལ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོ་ལ་སོགས་པའི་གཟུགས་སུ་རྣམ་པར་བསྒོམས་ནས།",
    "རྣམ་པ་གསུམ་པོ་དེ་རྣམས་ཀྱིས་གོ་རིམས་བཞིན་དུ་བསྡུམ་པ་དང་དབྱེ་བ་དང་ཆད་པས་༡གཅད་པའི་རིམ་པར་ཤེས་པར་བྱ་སྟེ།",
    "ལེགས་སོ་ལེགས་སོ་ཞེས་བྱ་བ་ནི་ཞལ་གྱིས་བཞེས་པ་སྟེ།",
    "འོན་ཀྱང་ཞེས་བྱ་བའི་སྒྲ་ནི་རྣམ་པར་རྟོག་པའོ།",
    "གཞན་རྣམས་ལྟ་ཅི་སྨོས་ཞེས་བྱ་བ་ནི་དའདི་རིགས་མ་ངེས་པ་དང་རིགས་ཆད་པ་རྣམས་ཀྱི་སྤྱོད་ཡུལ་ཡིན་པར་སྤྲོ་བ་མེད་པར་སྟོན་ཏོ།",
    "དེ་ནས་སླར་ཡང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བཅོམ་ལྡན་འདས་ཐེ་ཚོམ་ཐམས་ཅད་གཅོད་པར་མཛད་པ་དེ་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དམ་ཚིག་དང་སྡོམ་པ་ལ་སོགས་པ་སྟོན་པར་མི་སྤྲོ་བ་དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་བྱིན་གྱིས་བརླབ་སྣེཅིང་སྣོད་དུ་རུང་བ་ཉིད་དུ་མཛད་དེ་ཡང་དག་པར་བསྟན་དུ་གསོལ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "བདེ་བ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡིད་བདེ་བ་ནི་དེ་ལས་བྱུང་བའི་ལྷའི་ཁྱད་པར་ནམ་མཁའི་གཏོས་ཡེཁྱབ་པ་རྣམས་ཀྱིས་འགྲོ་བ་མ་ལུས་པ་རྣམས་ཀྱི་དོན་བྱེད་པའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་སྤྲུལ་པར་མཛད་དེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་དེ་བཞིན་གཤེགས་པ་ནི་རྡོ་རྗེ་འཆང་ཆེན་པོ་སྟེ་རིགས་ཐམས་ཅད་བསྡུས་པར་གྱུར་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཏིང་ངེ་འཛིན་གང་ལ་དེ་སྐད་ཅེས་བྱ་བའི་མིང་ཡོད་པ་དེ་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "ཞི་བར་ཕན་པར་མི་འགྱུར་ཏེ།",
