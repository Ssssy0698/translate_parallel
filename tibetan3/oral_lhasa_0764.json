    "འདོད་པ་ཐམས་ཅད་ལ་ཉེ་བར་ལོངས་སྤྱོད་པའི་དཔལ་གྱི་ཏིང་ངེ་འཛིན་ལས་གསུངས་པ་ཁོ་ན་བཞིན་དུ་འདོད་པར་བྱའོ།",
    "འཛིན་དེ་ཉིད་ལ་ཅང་མི་སྨྲ་བར་གནས་པར་བྱའོ།",
    "ཁུ་བ་ཕྱུང་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་སྒྱུ་མ་ལྟ་བུའི་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་རྣམ་པར་གྱུར་པའི་ཞུ་བ་ཉིད་བཏུང་བར་བྱའོ།",
    "དེ་རྣམས་སླར་བཀུག་ལ་གནས་ཇི་ལྟ་བ་བཞིན་དུ་བཀོད་པར་བྱས་ཏེ།",
    "ཕྱག་རྒྱ་བཞིས་རྒྱས་བཏབ་ནས་བསྡུས་ཏེ་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་གཞུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏེ་གཉིས་པའོ།",
    "སྐུ་གསུང་ཐུགས་རྨད་དུ་བྱུང་བའི་སྔགས་ཀྱིས་འགུགས་པའི་རྣམ་པར་འཕྲུལ་པའི་རྒྱལ་པོའི་ལེའུ་བཅུ་བཞི་པ་ལས་གསུངས་པའི་ཞི་བ་ལ་སོགས་པའི་ལས་ཅན་དུ་རྟོགས་པར་བྱའོ་ཞེས་བྱ་བས་ནི།",
    "གཅིག་ཏུ་གཞན་གྱི་དོན་བྱེད་པའི་མཚན་ཉིད་ཅན་གྱི་ཏིང་ངེ་འཛིན་གསུམ་པ་ཡིན་པར་བསྟན་ཏོ།",
    "དེ་ནས་ལེའུ་གསུམ་པ་ལས་གསུངས་པའི། ༡ རིན་ཆེན་ཁ་དོག་སྣ་ལྔ་པ།",
    "ལེའུ་བཅུ་གསུམ་པ་ལས་གསུངས་པའི་བཟླས་པ་ཡང་སྒྲུབ་ཐབས་ཀྱི་ཚུལ་བཞིན་བྱའོ།",
    "ལེའུ་བཅུ་པ་ལས་གསུངས་པའི་ང་རྒྱལ་དང་ལྡན་པའི་སྤྱོར་བས་བསྒྲུབ་པར་བྱ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་མི་བསྐྱོད་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བསྟོད་པ་རྣམས་ཀྱིས་ཀྱང་བསྟོད་དེ་ཡང་དག་པར་སད་༣ནས།",
    "དཀྱིལ་འཁོར་ལུས་དང་ཧཱུཾཐ་མི་དད་པར་བལྟས་ལ་བརྟན་པར་བྱས་ཏེ་ཉེ་བར་བསྲུང་བར་བྱའོ།",
    "སྐུ་གསུམ་མི་ཕྱེད་སྒྲུབ་པར་འགྱུར།",
    "རྣམ་པར་དབེེན་པའི་རི་བོ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བསྐལ་པར་གནས་པའི་མན་ངག་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་འཁོར་ལོ་ལ་སོགས་པས་རྔུ་སེམས་བསྒྲུབ་པ་གསུངས་སོ།",
    "ཤ་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྒྲུབ་པ་ཆེན་པོ་ལ་སོགས་པ་ལ་ཞུགས་པའི་ཟས་ངེས་པར་བྱེད་པའོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་རྫོགས་པའི་རིམ་པ་གསུངས་སོ།",
    "རྒྱལ་པོ་དང་དགྲ་དང་གནོད་པར་བྱེད་པ་རྣམས་རྨོངས་པར་བྱ་བ་དང་།",
    "རྣམ་པར་སྣང་མཛད་ཞལ་གསུམ་པ།",
    "ལེའུ་བཅོ་ལྔ་པ་ལས་ནི་རྡོ་རྗེའི་རིགས་ཀྱི་ཡན་ལག་དཀྱིལ་འཁོར་གྲུ་བཞི་པ་གསུངས་སོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའོ།",
    "འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་རྣལ་འབྱོར་གྱིས་རྣམ་པ་དུ་མའི་སྒོ་ནས་གསད་རྨི་པ་གསུངས་སོ།",
    "དུག་མེད་པར་བྱ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་བཏབ་པས་ཡང་དག་པར་རྟོགས་པར་མཛད་ཅིང་།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་རྟོགས་པར་གྱུར་ནས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉི་གའི་རང་བཞིན་གྱི་ལྷའི་དཀྱིལ་འཁོར་ཐམས་ཅད་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྫོགས་པའི་རྣལ་འབྱོར་པས་སྣོད་དུ་རུང་བ་གཉིས་བཅུག་ནས་བསྒྲུབ་པ་ཁྱད་པར་ཅན་གྱི་དཀྱིལ་འཁོར་འདྲིར་གཞུག་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཁྱད་པར་ཅན་དུ་གྱུར་པ་ཡིན་ཡང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ལྷ་ཐམས་ཅད་དགུག་པ་ལ་སོགས་པའི་དོན་དུ་ཞགས་པ་དང་ལྕགས་ཀྱུ་ཐོགས་པའི་རྡོ་རྗེ་ཧཱུཾ་ཧུམཛད་དུ་ཤེས་པར་བྱའོ།",
    "ལངས་ནས་ལུང་བསྟན་པའི་རྗེས་ཐོགས་ལ་མན་ངག་སྦྱིན་པར་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་བསྒྲུབ་པར་བྱ་བའོ།",
    "རྡོ་རྗེའི་དོན་གྱི་བློ་ཡིས་གསུངས།",
    "རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་བཀྲེས་པ་དང་སྐོམ་པ་ལ་སོགས་པ་བཟློག་པའི་སྦྱོར་བའོ།",
    "དེ་ནས་ཕྱག་ན་རྡོ་རྗེ་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ནས་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་རྡོ་རྗེས་དེ་སྐད་བཀའ་སྤྲུལ་ཏོ་ཞེས་བྱ་བ་ལ་ཐུག་པའི་བར་གྱིས་ནི།",
    "ཡང་དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནས་རྫོགས་པ་ལ་ཐུག་པས་ནི་རིག་པའི་བརྟུལ་ཞུགས་གསུངས་སོ།",
    "དེ་རྣམས་ཀྱིས་བརྙས་པར་གྱུར་དུ་ཟིན་ཀྱང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གསུངས་པའི་དོན་ཉིད་བཅོམ་ལྡན་འདས་ཀྱི་ཞལ་ནས་བཞེས་པའོ།",
    "དེ་ནས་ངོ་མཚར་ཞེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པར་གྱུར་ཏོ།",
    "ནམ་མཁའ་རྡོ་རྗེའི་དབུས་གནས་པར།",
    "གལ་ཏེ་དངོས་གྲུབ་མཆོག་ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་གོང་མ་གོང་མའི་ཚུལ་ལ་དོན་ཁྱད་པར་ཅན་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་གསུམ་གྱི་རྡོ་རྗེ་སློབ་དཔོན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་ལ་ཡང་མི་གནས་སོ་ཞེས་བྱ་བའི་བར་གསུངས་ཏེ།",
    "དེ་རྣམས་ཀྱང་ངོ་མཚར་ལ་སོགས་པར་གྱུར་ནས་ཅང་མི་སྨྲ་བར་འཁོད་པར་གྱུར་ཏོ།",
    "ཧཱུཾ་དཱི་ཁཾ་ཞེས་བྱ་བ་འདིས་ནི་བདུད་རྩི་དགུག་པའི་དོན་དུ་སྦྱོར་བ་གསུངས་སོ།",
    "ཚིམ་པར་བྱ་བའི་སྤྱོར་བ་དང་།",
