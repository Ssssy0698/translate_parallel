    "ཕྱུགས་འདུག་གིས་ངེས་པར་གལ་གྱིས་འཆུ་བར་ཤེས་ནས་ཐབས་ཤིག་བཤམས་ཏེ།",
    "དེས་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ལས་ཐོས་ནས་དེ་ཕན་ཚུན་བྲོས་པ་ལས་རྒན་མོ་ཞིག་གི་ཁྱིམ་དུ་ཞུགས་པ་དང་དེས་དེ་སྦས་ཏེ།",
    "དེ་ནས་ཡུང་དང་འབྲུ་མར་གྱིས་ལུས་བསྐུས་ནས་ཁྱོགས་ཀྱི་སྟེང་དུ་བཞག་སྟེ་རོ་ལྟ་བུར་བཅོས་ནས་ཕྱུང་སྟེ་དུར་ཁྲོད་དུ་བོར་བ་དང་ལངས་ཏེ་བྲོས་པ་ཕྱོགས་དེ་ན་མི་ཞིག་མེ་ཏོག་དང་འབྲས་བུ་ཚོལ་བ་དེས་དེ་བྲོས་པ་མཐོང་ངོ།",
    "མཐོང་སྟེ་ལམ་འདི་ནས་སོང་ངོ།",
    "དེ་ཡང་རི་འོར་དེར་བཙོ་བླག་མཁན་ཞིག་གི་ཁྱིམ་དུ་ཞུགས་ནས་དེ་ལ་ཇི་ལྟར་གྱུར་པ་སྨྲས་པ་དང་།",
    "དེར་ཡང་མི་གཞན་ཞིག་གིས་མཐོང་ནས།",
    "ཤེས་ལྡན་དག་ཁྱེད་གང་གི་དོན་དུ་རི་འོར་ན་ཚོལ་བའི་མི་དེ་ནི་ལམ་འདི་ནས་སོང་གིས་མྱུར་དུ་དེང་ཤིག།",
    "བདག་གིས་སྔོན་ལན་འགའ་ཡང་མཆིལ་ལྷམ་དེ་ལྟ་བུ་བྱེད་མ་མྱོང་ངོ།",
    "ལྷམ་མཁན་ཁྱོད་ཀྱིས་ང་ཡི་ཚིག་བཞིན་འདིར།",
    "ཤེས་ལྡན་དག་དེང་ལ་ཀླུའི་གནས་ཆེ་གེ་མོ་ཞེས་བྱ་བར་ཀླུ་ཟུང་ཤིག།",
    "ཀླུ་རྣམས་ཀྱིས་གྲོས་བྱས་པ་བདག་ཅག་གིས་འདི་ལྟར་དེ་སེར་སྐྱའི་འབྲོག་ལས་མ་བསྒྲལ་བ་ནི་མ་ལེགས་པ་ཞིག་བྱས་ཏེ།",
    "ཤེས་ལྡན་དག་གང་གི་ཕྱིར་བདག་ཅག་འཁྲུགས་པར་བྱས་པ་དེ་ནི་བདག་ཅག་གིས་ཐབས་ཀྱིས་བསད་པ་ཉིད་དེ་འདི་ལྟར་སེར་སྐྱའི་འབྲོག་ཏུ་བོར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་འོན་ཀྱང་ཚོལ་ཅིག།",
    "ཅི་འདིས་བདག་ཤི་བར་གྱུར་ཏོ་ཞེས་ཐོས་ནས་དེས་ན་དེ་འདིར་འོངས་སམ་སྙམ་མོ།",
    "སེར་སྐྱས་ལྗོན་ཤིང་གི་དྲུང་དུ་བསྡད་དེ།",
    "ཀྭའི་ནང་རྗེ་ཁྱོད་ཀྱི་སེར་སྐྱའི་འབྲོག་ན་མི་མ་ཡིན་པ་སེར་སྐྱ་ཞེས་བྱ་བ་གནས་ཏེ།",
    "དེར་སོང་བ་གང་ཡིན་པ་དེ་དེས་གསོད་པར་འགྱུར་རོ་ཞེས་མ་ཐོས་སམ།",
    "ཁྱོད་ཀྱི་དུས་ལ་བབ་ཀྱིས་བོབས་ཤིག།",
    "དེ་ལྗོན་ཤིང་ལས་དལ་གྱིས་དལ་གྱིས་བབས་ཏེ་སོང་ནས་དེ་དེ་དང་དེ་ན་འཁོར་ཞིང་བསམས་པ།",
    "བདག་གི་ཞང་པོ་དྲང་སྲོང་རྣམས་ཀྱི་ནང་དུ་རབ་ཏུ་བྱུང་བ་ཞིག་ཡོད་ཀྱིས་དེའི་དྲུང་དུ་འགྲོའོ་སྙམ་ནས་དྲང་སྲོང་དེ་ལ་ཡང་རི་འོར་ཞིག་ན་སྐྱེད་མོས་ཚལ་རྩ་བ་དང་།",
    "ཆུ་ཕུན་སུམ་ཚོགས་པ་ཤིང་རྣམ་པ་སྣ་ཚོགས་ཚང་ཚིང་གིས་མཛེས་པར་བྱས་པ།",
    "དེ་མཆོངས་པ་དང་མི་ཞིག་གིས་གཙུག་པུད་ནས་བཟུང་བ་ལས་གཙུག་པུད་བྱུང་ནས་དེ་ལྷུང་ངོ།",
    "དེ་རྣམས་ཀྱིས་བསམས་པ་འདི་ནི་ཤི་བས་འདོང་ངོ་ཞེས་གཙུག་པུད་ཁྱེར་ཏེ་རྒྱལ་པོའི་དྲུང་དུ་སོང་ནས།",
    "དེ་ནས་དྲང་སྲོང་གི་སྐྱེད་མོས་ཚལ་ན་གནས་པའི་ལྷ་གང་ཡིན་པ་དེས་དྲང་སྲོང་དེ་ལ་སྨྲས་པ།",
    "ཁྱོད་ཀྱི་ཚ་བོ་ནི་སྡུག་བསྔལ་མི་བཟད་པ་དོག་པ་ཉམ་ང་བ་ཐོབ་ན་མ་དགོངས་སམ།",
    "གལ་ཏེ་བདག་གིས་མ་བསམས་པར་གྱུར་ན་དེ་རིང་ཉིད་དུ་སྲོག་དང་བྲལ་བར་འགྱུར་རོ།",
    "གང་གིས་ནི་སྐྱེས་པ་བུད་མེད་དུ་འགྱུར་ཞིང་ཕྱིར་ཡང་སྐྱེས་པར་འགྱུར་བ་དེ་ལྟ་བུའི་རིག་སྔགས་ཤེས་པས་དེས་དེ་ལ་རིག་སྔགས་དེ་བསླབས་ཏེ་སྨྲས་པ།",
    "ད་ནི་སོང་ལ་འཇིགས་པ་དང་བག་ཚ་བ་མེད་པས་འདུག་ཤིག།",
    "རྒྱལ་པོའི་སྐྱེད་མོས་ཚལ་ན་འདུག་པ་སྐྱེད་མོས་ཚལ་གྱི་སྲུང་མས་མཐོང་ནས་མཆོག་ཏུ་ངོ་མཚར་སྐྱེས་ཏེ་དེས་མྱུར་བ་མྱུར་བར་སོང་ནས་རྒྱལ་པོ་ཉི་མའི་མུ་ཁྱུད་ལ་སྨྲས་པ།",
    "ལྷ་སྐྱེད་མོས་ཚལ་ན་བུད་མེད་གཟུགས་ཕུན་སུམ་ཚོགས་པ་དར་ལ་བབ་བ་ཞིག་མཆིས་སོ།",
    "གང་གིས་མགོ་མ་བཅད་པ་དེ་བསད་མིན།",
    "ད་ནས་ལམ་གྱིས་དུབ་པ་ངལ་སོས་ནས་ནོར་བུ་མཁན་གཅིག་གི་དྲུང་དུ་སོང་སྟེ་སྨྲས་པ།",
    "ཅིག་ཤོས་ཀྱི་དྲུང་དུ་སོང་ནས་སྨྲས་པ།",
    "འདི་སྙེད་ཀྱི་རིན་ཐང་རེ་ཞིག་བདག་ལ་མི་བདོག་གོ།",
    "དེའི་དྲུང་དུ་སོང་ནས་བདག་གིས་འདི་ཐོག་མར་ཁྱིམ་དུ་ཁྲིད་ཅིང་བདག་གིས་འདིའི་རིན་ཐང་ཡང་བཅད་ན་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་བཀུར།",
    "གལ་ཏེ་གཞན་བླངས་ན་དེ་ཡང་ཤི་བར་འགྱུར་གྱིས་ཁྱེའུ་ཕུ་བོ་ཤོས་ཀྱི་ཁྱིམ་དབུབ་པར་བྱའོ་སྙམ་ནས་དེའི་ཁྱེའུ་ཕུ་བོ་ཤོས་ཀྱི་ཁྱིམ་ཕུབ་པ་ལས་དེ་ལས་ཁྱེའུ་དང་བུ་མོ་མང་དུ་བཙས་སོ།",
    "རྗེའི་སྲས་ཁྱེའུ་འདི་ཁྱོད་ཀྱི་ཅིར་མཆི།",
    "རྗེའི་སྲས་ཁྱོད་ལ་ནི་སྲས་མང་ལ།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་ཁྱིམ་བདག་གི་བུ་ཕུ་བོ་ཤོས་གང་ཡིན་པ་དེ་ནི་ལྷ་སྦྱིན་འདི་ཉིད་ཡིན་ནོ།",
    "དེ་ཟླ་བ་བརྒྱད་དམ་དགུ་ལོན་པ་ན་བུ་མོ་གཟུགས་བཟང་བ་བལྟ་ན་སྡུག་པ་མཛེས་པ་ཞིག་བཙས་སོ།",
    "དེ་རིང་བདག་གི་ཁྱིམ་དུ་བྲམ་ཟེ་སུ་བསོད་སྙོམས་ཀྱི་ཕྱིར་ཞུགས་པ་དེ་ལ་བུ་མོ་འདི་བསོད་སྙོམས་ཀྱི་གོར་སྦྱིན་ནོ་སྙམ་མོ།",
    "བྲམ་ཟེའི་ཁྱེའུ་བུ་མོ་གཞོན་ནུ་འདི་བདག་གིས་ཁྱོད་ལ་བསོད་སྙོམས་ཀྱི་གོར་སྦྱིན་ནོ།",
    "དེ་རིང་མི་བླང་གི་ཉི་མ་དང་ཡུད་ཙམ་དག་བསྟུན་ནས་བླང་ངོ་ཞེས་སོང་ངོ།",
    "བྲམ་ཟེའི་ཁྱེའུ་བུ་མོ་གཞོན་ནུ་འདི་བདག་གིས་ཁྱོད་ལ་བསོད་སྙོམས་ཀྱི་གོར་སྦྱིན་ནོ།",
    "དེ་ན་རེ་རྒྱུ་སྐར་མི་བཟང་ཞེས་ཟེར་རོ།",
    "ཁྱོད་རྒྱུ་སྐར་ལ་ཅིའི་ཕྱིར་མི་སྡོད།",
    "ཞེས་སྨྲས་ནས་དེས་ཁྱེར་ཏེ་སོང་ངོ།",
    "བྲམ་ཟེ་གཞན་པོ་དེས་བྲམ་ཟེ་དེ་ལས་བྲམ་ཟེ་ཆེ་གེ་མོ་ཞེས་བྱ་བས་བུ་མོ་ཁྱེར་རོ་ཞེས་ཐོས་ནས་དེ་དེའི་དྲུང་དུ་སོང་སྟེ་སྨྲས་པ།",
    "བྲམ་ཟེའི་ཁྱེའུ་བདག་གི་བུ་མོ་དེ་སྔར་ཐོབ་ཟིན་ན་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་བཀུར།",
    "རྒྱུ་སྐར་རྩི་བ་ལྷུར་ལེན་པ་ཁྱོད་རེ་ཞིག་རྒྱུ་སྐར་ལ་རྟོགས་ཤིག།",
    "དེའི་ཚེ་རྒྱལ་པོ་མ་སྐྱེས་དགྲའི་གླང་པོ་ཆེ་གདུག་པ་ནོར་སྐྱོང་ཞེས་བྱ་བ་ཞིག་ཡོད་པ་དེ་ཉིན་རེ་ཞིང་ཁྱིམ་ནས་བྱུང་བ་ན་སྐྱེ་བོ་མང་པོ་ཁ་འདོག་པར་བྱེད་དོ།",
    "ལྷ་གླང་པོ་ཆེ་གདུག་པ་ནོར་སྐྱོང་གདུགས་རེ་ཞིང་གནས་ནས་བྱུང་བ་ན་ལམ་པོ་ཆེ་དང་།",
    "ཅི་ནས་གདུགས་རེ་ཞིང་མི་དབྱུང་བར་སང་ལྟ་བུ་འབྱིན་པ་ན་ཡང་དྲིལ་སྒྲོགས་སུ་སྩལ་བའི་རིགས་སོ་ཞེས་གསོལ་གྱིས།",
    "ཁྱེད་ཀྱིས་དེ་ཉིན་རེ་ཞིང་མ་དབྱུང་བར་སང་ལྟ་བུ་འབྱིན་པ་ན་ཡང་དྲིལ་སྒྲོགས་ཤིག།",
    "དེ་ནས་ལྷ་སྦྱིན་རྒྱལ་པོ་མ་སྐྱེས་དགྲ་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "གླང་པོ་ཆེའི་འདུལ་མཁན་རྣམས་ཀྱི་དྲུང་དུ་སོང་སྟེ་སྨྲས་པ།",
    "ལྷ་ལ་ཡང་བདག་གིས་རིག་པར་བྱས་ཀྱིས་ཁྱོད་ཀྱིས་སང་གླང་པོ་ཆེ་དམ་པ་ནོར་སྐྱོང་རྦོད་ཅིག།",
    "སང་གླང་པོ་ཆེ་དམ་པ་ནོར་སྐྱོང་གཏོང་གིས་དེ་བས་ན་ཁྱེད་ཅག་ཐམས་ཅད་སང་རང་རང་སྲུང་བ་ལ་སྒྲིམས་ཤིག་ཅེས་བསྒྲགས་པ།",
    "གཡོས་བྱས་ལ་དེ་ཉིད་དུ་ཁྱེར་ཏེ་བཅོམ་ལྡན་འདས་གདུགས་ཚོད་གསོལ་ལོ་སྙམ་ནས་དེས་དེ་ཉིད་ཀྱི་ནུབ་མོ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་སྟ་གོན་བྱས་ནས་ནང་པར་སྔར་ལངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་སོང་ནས་བཅོམ་ལྡན་འདས་རྒྱལ་པོའི་ཁབ་ཏུ་དྲིལ་བསྒྲགས་པ།",
    "སང་གླང་པོ་ཆེ་དམ་པ་ནོར་སྐྱོང་གཏོང་གིས་ཁྱེད་ཅག་རང་རང་སྲུང་བ་ལ་སྒྲིམས་ཤིག་ཅེས་མཆི་བས།",
    "ཁྱིམ་བདག་ཁྱོད་སེམས་ལས་ཆུང་ངུར་གྱིས་ལ་ཞལ་ཟས་དང་བཏུང་བ་སྟ་གོན་བྱོས་ཤིག་དང་།",
    "དེ་ནས་ཁྱིམ་བདག་ཡིད་དགའ་ནས་རང་གི་ཁྱིམ་དུ་སོང་སྟེ་ཞལ་ཟས་དང་བཏུང་བ་སྟ་གོན་བྱས་གདན་བཤམས་ནས་བཅོམ་ལྡན་འདས་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "གླང་པོ་ཆེའི་དམ་པ་ནོར་སྐྱོང་གིས་བཅོམ་ལྡན་འདས་རྒྱང་རིང་པོ་ཁོ་ན་ནས་མཐོང་ངོ།",
    "མཐོང་ནས་ཀྱང་འགྱིང་ཞིང་སྐད་ཕྱུང་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་མོད་ལ་ཤུགས་ཅི་ཡོད་པས་བང་ཐག་པས་བརྒྱུགས་སོ།",
    "དེ་ནས་ལྷ་སྦྱིན་མ་སྐྱེས་དགྲའི་གྲོགས་ཅན་སྟེང་གི་ཁང་བཟངས་ཀྱི་གཞིར་འཛེགས་ནས་དགེ་སྦྱོང་གོ་ཏ་མ་གསོད་པ་ལ་ལྟ་ཞིང་འདུག་གོ།",
    "ཁྱོད་ནི་གླང་ཆེན་མཐུས་བརྫིས་ནས།",
    "ཤཱཀྱའི་བུ་ཁྱོད་དེ་རིང་དུ།",
    "ཉན་ཐོས་བཅས་ཏེ་རེ་སྙམ་མེད།",
    "ལྷ་སྦྱིན་ངན་ཁྱོད་ང་ལ་ནི།",
    "དེ་ནས་ནོར་སྐྱོང་དྲེགས་པའི་ཤུགས་དང་བྲལ་ནས་དལ་གྱིས་འགྲོ་བའི་འགྲོས་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་སོང་བ་དང་།",
    "བཞིན་བཟངས་ཁྱོད་རེ་ཞིག་སྔོན་གྱི་ཉེས་པར་སྤྱད་པས་དམན་པ་དུད་འགྲོའི་སྐྱེ་གནས་སུ་སྐྱེས་ན་ཁྱོད་ད་དུང་གཞན་གྱི་སྲོག་གཅོད་ཅིང་གཞན་གྱི་སྲོག་གཅོད་པས་ཡོངས་སུ་དགའ་བར་བྱེད་པ་འདི་ནས་ཤི་འཕོས་ན་ཁྱོད་ཀྱི་འགྲོ་བ་ནི་ཅིར་འགྱུར།",
    "ནོར་སྐྱོང་ཡང་བཅོམ་ལྡན་འདས་ཀྱི་རྗེས་བཞིན་རྗེས་བཞིན་སོང་སྟེ་བཅོམ་ལྡན་འདས་ནང་དུ་གཤེགས་པ་ན་སྒོ་དྲུང་དུ་སྡོད་པ་ལས་བཅོམ་ལྡན་འདས་མ་མཐོང་ནས་ཁྱིམ་གཞིག་པར་བརྩམས་སོ།",
    "དེ་བཅོམ་ལྡན་འདས་ཀྱི་རྗེས་བཞིན་རྗེས་བཞིན་སོང་བའི་སྐབས་དེ་བློན་པོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་རིག་པར་བྱས་སོ།",
    "ཁྱོད་ཀྱིས་བདག་ལ་གནོད་པ་བྱས་ཏེ།",
    "གླང་པོ་ཆེ་དམ་པ་འདི་ལ་བརྟེན་ནས་མཚམས་གཞན་གྱི་རྒྱལ་པོ་རྣམས་ཁོ་བོ་ལ་གནོད་པ་བྱེད་པར་མི་འགྱུར་ན་དེ་ཡང་ཁྱོད་ཀྱིས་དུལ་བར་བྱས་སོ།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཕྱིར་བྱུང་བར་གྱུར་པ་དེའི་ཚེ་གླང་པོ་ཆེ་དམ་པ་ནོར་སྐྱོང་ཇི་ལྟར་ཡང་ཁྱོད་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་ཕྱི་བཞིན་འབྲང་བར་མི་འགྱུར་བར་སྒོ་ཆོད་ལ་ཞོག་ཤིག།",
    "ལས་གང་གིས་ཡིན་པའོ།",
    "བདག་ཞག་ལོན་ནས་བཅོམ་ལྡན་འདས་ལ་བལྟ་བའི་ཕྱིར་འགྲོ་བ་ནི་བདག་གི་ཆ་མ་ཡིན་གྱིས།",
    "མ་ལ་བདག་གིས་ཞག་མ་ལོན་པར་བཅོམ་ལྡན་འདས་ལ་བལྟ་བ་དང་བསྙེན་བཀུར་བྱ་བའི་ཕྱིར་འགྲོའོ་སྙམ་མོ།",
    "དོ་ཤལ་དང་སེ་མོ་དོས་ལུས་བརྒྱན་ནས་དེ་ཉིད་ཀྱི་མཚན་མོ་ལྷ་རྣམས་ཀྱི་མེ་ཏོག་ཨུཏྤལ་དང་།",
    "རང་གི་སྐྱེ་བོ་དང་གཉེན་གྱི་ཚོགས་ཀྱིས་མ་ལགས།",
    "ངན་སོང་གི་སྒོ་རྣམས་ནི་བཀུམ།",
    "ཁྱོད་མཐུས་རབ་དྲག་ཉེས་པ་མང་ལྡན་པའི།",
    "མཐོ་རིས་འགྲོ་བ་ཕྱེ་བཞིན་བདག་གིས་ནི།",
    "ཤིན་ཏུ་རྣམ་དག་ཁྱོད་བརྟེན་བདག་གིས་ནི།",
    "ཐུབ་པ་དེ་རིང་ཁྱོད་མཐོང་འབྲས་བུ་མཆིས།",
    "ལྷ་ཡི་འཇིག་རྟེན་མངོན་ཕྱོགས་མཁའ་ལ་སོང་།",
    "དེ་ལྟ་མོད་ཀྱི་དགེ་སློང་དག་ཁྱེད་ཀྱིས་གླང་པོ་ཆེ་དམ་པ་ནོར་སྐྱོང་ཞེས་བྱ་བ་འདི་ལྟར་གདུག་པ།",
    "བཙུན་པ་ནོར་སྐྱོང་གིས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་དུད་འགྲོར་སྐྱེས་ལགས།",
    "དེའི་བསྟན་པ་ལ་འདི་རབ་ཏུ་བྱུང་སྟེ་ཞལ་ཏ་བྱེད་པ་ན་དེ་ན་འདི་བསླབ་པའི་གཞི་ཕྲ་མོ་ཕྲ་མོ་རྣམས་ལ་གུས་པར་མ་བྱས་པས་ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པས་དུད་འགྲོར་སྐྱེས་པར་གྱུར་ཏོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་དགེ་སློང་ལྔ་བརྒྱས་ཡོངས་སུ་བཏང་ན་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཡོངས་སུ་མ་བཏང་བ་ལ་གཟིགས།",
    "ངང་པ་རྣམས་ཉི་མ་རེ་རེ་ཞིང་ངང་པ་རྣམས་ཀྱི་དཔོན་པོ་ཡུལ་འཁོར་སྐྱོང་གི་གན་དུ་སོང་སྟེ་རིག་པར་བྱེད་ནས་དེས་བསམས་པ།",
    "གཟུ་ལུམས་ཅན་ཡིན་པས་གལ་ཏེ་བདག་གིས་འདི་རྒྱལ་ཚབ་ལ་བཞག་ན་བདག་ཤི་ནས་འདིས་ངང་པའི་ཚོགས་བཤིག་པར་འགྱུར་གྱིས།",
    "དེ་ལ་ཐབས་ཤིག་བཤམ་པར་བྱའོ་སྙམ་མོ།",
    "དེས་བཱ་རཱ་ཎ་སཱིའི་སྐྱེད་མོས་ཚལ་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ཏུ་ཚངས་ལྡན་ཞེས་བྱ་བའི་རྫིང་མཚེའུ་བས་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་རྐོར་བཅུག་སྟེ།",
    "བཞིན་རྒྱས་ལ་རང་རང་གི་ཚོགས་ཀྱིས་སྨྲས་པ།",
    "ཁྱོད་ཀྱང་བོབས་ལ་རྩེད་མོ་གྱིས་ཤིག།",
    "རེ་ཞིག་རྒྱལ་སྲིད་བླངས་ལ་དེ་ནས་ཕྱིས་ལོག་སྟེ་རྩེ་བར་བྱའོ་ཞེས་དེ་རིངས་པ་རིངས་པར་སོང་སྟེ་རྒྱལ་སྲིད་བླངས་སོ།",
    "གཟུགས་བཟང་པོས་ཆུ་ན་རྒྱུ་བའི་འདབ་ཆགས་ཐམས་ཅད་ཟིལ་གྱིས་མནན་ནས་ཚངས་ལྡན་གྱི་རྫིང་གི་རྒྱན་བྱེད་ཅིང་དགའ་བར་གནས་ཤིང་འཇིག་རྟེན་དགའ་བ་སྐྱེད་པར་བྱེད།",
    "ངང་པ་གཅིག་གིས་ལྔ་བརྒྱར་མ་ཚང་བ་ནི་བྲོས་སོ།",
    "དེ་རྣམས་ཀྱིས་ངང་པའི་དཔོན་པོ་དེ་ཁྱེར་ནས་རྒྱལ་པོའི་དྲུང་དུ་སོང་བ་དང་།",
    "ལྷ་བདག་ཅག་གིས་འདི་མ་བཟུང་མོད་ཀྱི་རང་ཉིད་མཆིས་ལགས་སོ།",
    "ངང་པ་གཅིག་གིས་ལྔ་བརྒྱར་མ་ཚང་བ་གང་ཡིན་པ་དེ་ནི་དགེ་སློང་ལྔ་བརྒྱར་གཅིག་གིས་མ་ཚང་བ་འདི་དག་ཉིད་ཡིན་ཏེ།",
    "ད་ལྟར་ཡང་ང་འདི་དག་གིས་ཡོངས་སུ་བཏང་གི་དགེ་སློང་ཀུན་དགའ་བོས་ནི་ཡོངས་སུ་མ་བཏང་ངོ།",
    "དགེ་སློང་དག་གཞན་ཡང་ཇི་ལྟར་འདི་དག་གིས་ང་ཡོངས་སུ་བཏང་ན་དགེ་སློང་ཀུན་དགའ་བོས་ཡོངས་སུ་མ་བཏང་བ་དེ་ཉོན་ཅིག།",
    "དེ་བློན་པོ་གཞན་ཞིག་གིས་རྒྱལ་པོ་ལ་ཕུལ་ཏེ།",
    "དེ་རྣམས་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པོ་གླང་པོ་ཆེ་བའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ནས་རྒྱལ་པོ་གད་རྒྱངས་ཅན་དང་གཡུལ་སྤྲད་པའི་ཕྱིར་འོངས་སོ།",
    "རྒྱལ་པོ་གད་རྒྱངས་ཅན་གྱིས་ཀྱང་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པོ་གླང་པོ་ཆེ་པའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ནས་ས་གཞན་གྱི་རྒྱལ་པོ་རྣམས་དང་གཡུལ་སྤྲད་པའི་ཕྱིར་སྤགས་ཏེ་བསུའོ།",
    "རང་རང་གི་ཡུལ་དུ་དོང་ངོ།",
    "ཁྱེད་ཅག་ལས་ལོངས་སྤྱོད་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་དག་གིས་བགོ་བཤའ་བྱའོ་ཞེས་ཡོ་བྱད་ཀྱིས་ཁ་དྲངས་པ་དང་དེ་རྣམས་ཀྱིས་ཁས་བླངས་སོ།",
    "དེ་ནས་ས་གཞན་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་སླར་ཡང་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པོ་གླང་པོ་ཆེ་པའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ནས་རྒྱལ་པོ་གད་རྒྱངས་ཅན་དང་གཡུལ་སྤྲད་པའི་ཕྱིར་འོངས་སོ།",
    "རྒྱལ་པོ་གད་རྒྱངས་ཅན་གྱིས་ཀྱང་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པོ་གླང་པོ་ཆེ་པའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ནས་ས་གཞན་གྱི་རྒྱལ་པོ་རྣམས་དང་གཡུལ་སྤྲད་པའི་ཕྱིར་སྤགས་ཏེ་བསུའོ།",
    "གྲོགས་པོ་གཅིག་པུས་མ་བཏང་གི།",
    "གྲོགས་པོ་ཀུན་གྱིས་ཁྱོད་བཏང་ངོ།",
    "དེ་ན་ཡང་འདི་དག་གིས་ང་ཡོངས་སུ་བཏང་ངོ།",
    "ད་ལྟར་ཡང་འདི་དག་གིས་ང་ཡོངས་སུ་བཏང་གི་ཀུན་དགའ་བོས་ནི་ཡོངས་སུ་མ་བཏང་ངོ།",
    "གཞན་ཡང་ཇི་ལྟར་འདི་དག་གིས་ང་ཡོངས་སུ་བཏང་གི་ཀུན་དགའ་བོས་ཡོངས་སུ་མ་བཏང་བ་དེ་ཉོན་ཅིག།",
    "སེང་གེས་སྲོག་ཆགས་རྣམས་བསད་དེ་ཤའི་དམ་པ་དང་ཁྲག་གི་དམ་པ་དེ་འཐུངས་ནས་བོར་ཏེ་འགྲོ་བས་དེ་རྣམས་དེ་ལྟ་བུས་དུས་རིང་མོ་ཞིག་འདས་པར་གྱུར་ཏོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རི་དགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་མཚན་མོ་སྲོག་ཆགས་ཚོལ་བ་ན་ཁྲོན་པར་ལྷུང་བ་དང་ཝ་ལྔ་བརྒྱ་པོ་དེ་རྣམས་ལས་ཝ་ལྔ་བརྒྱར་གཅིག་གིས་མ་ཚང་བ་སོ་སོར་དོང་སྟེ།",
    "ཝ་གཅིག་པུ་ཞིག་སེང་གེ་ལ་རྟོག་ཅིང་ཁྲོན་པའི་ཁར་འདུག་སྟེ་གང་གིས་ན་འདི་ཕྱིན་པར་འགྱུར་བའི་ཐབས་དེ་ཅི་ཡོད་སྙམ་སེམས་ཤིང་དེ་ཁྲོན་པའི་ཉེན་ཀོར་ཕན་ཚུན་སོང་བ་ལས་ཇི་ཙམ་ན་ཁྲོན་པ་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་མཚེའུ་ཞིག་མཐོང་ནས།",
    "ཝ་གཅིག་གིས་ལྔ་བརྒྱར་མ་ཚང་བ་གང་ཡིན་པ་དེ་ནི་དགེ་སློང་ལྔ་བརྒྱ་པོ་འདི་དག་ཡིན་ཏེ།",
    "དེ་ན་ཡང་འདི་དག་གིས་ང་ཡོངས་སུ་བཏང་གི་ཀུན་དགའ་བོས་ནི་ཡོངས་སུ་མ་བཏང་ངོ།",
    "ད་ལྟར་ཡང་འདི་དག་གིས་ང་ཡོངས་སུ་བཏང་གི་ཀུན་དགའ་བོས་ནི་ཡོངས་སུ་མ་བཏང་ངོ།",
