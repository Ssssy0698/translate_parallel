    "ཚོན་སྔོ་དཀར་སེར་དམར་ལྗང་བའི་རིམ་པས་སྣོད་གཙང་མར་བཀོད་ལ་བསང་སྦྱངས་སོགས་སྔར་ལྟར་ལས་ཐིག་སྐུད་དང་རྡུལ་ཚོན་འདོན་པ་བརྗེས་ཏེ་བསྐྱེད་བཟླས་བྱ།",
    "ཚོན་རྣམས་ལ་ཧི་ཡིག་བཀོད་དེ་འབར་བའི་ལྟ་ལྟངས་བྱས་ལ།",
    "ཡོ་ན་གདུང་བ་བསྐྱེད་ཆད་ན་སློབ་དཔོན་འཆི་འདྲེས་ན་རིགས་རྒྱུད་ཆད་པས་ལེགས་པར་བྲི།",
    "སློབ་དཔོན་གྱིས་རྫོགས་པར་བྲི་མ་ནུས་ན་དེ་ནས་གཞན་གྱིས་ཀྱང་བྲིའོ།",
    "རང་ཁྲུས་བྱས་དྲི་ཞིམ་པོ་བྱུགས་གཙུག་ཏོར་སོགས་ཀྱིས་བརྒྱན་ཏེ་དཀྱིལ་འཁོར་གྱི་ཤར་ནས་ནུབ་ཏུ་ཕྱོགས་པས་གཏོར་མ་སྦྱིན་པ་ནས་ཉེར་བསྡུའི་བར་གྱི་རྣལ་འབྱོར་རྒྱས་པའམ།",
    "བརླ་རྩར་འདུ་བྱེད་ཀྱི་ངོ་བོ་ཧཾ་ལས་དོན་གྲུབ་རྣམས་ཞལ་གསུམ་ཕྱག་དྲུག་པར་གྱུར།",
    "རྒྱལ་བ་རྣམས་འབྱོན་པར་བསྐུལ་ཞིག་ཅེས་བསྒོས་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "དེ་ནས་བུམ་པ་གཉིས་བསང་བ་ནས་ལས་བུམ་གྱི་ལྷ་ལ་ཕྲིན་ལས་བཅོལ་བའི་བར་བུམ་པ་སྟ་གོན་ལྟར་བྱས་ལ།",
    "ཕྱོགས་བཅུར་རྣམ་པར་གནས་རྣམས་དང་།",
    "གནས་འདིར་ཉེར་འཚེ་མེད་པར་མཛོད།",
    "ༀམཆོག་ཏུ་བདེ་བའི་སེམས་ནི་རོལ་པར་ལྡན།",
    "མགོན་པོ་སྙིམ་པའི་མེ་ཏོག་བཞེས་སུ་གསོལ།",
    "མགྲིན་པར་པདྨའི་ལྟེ་བར་ཟླ་བ་ལ་ཨཱ་དམར་པོ།",
    "ཨོཾ་སུ་ར་ཏེ་ས་མ་ཡ་སྟཱཾ་ཧོ་སིད་དྷྱ་བཛྲ་ཡ་ཐཱ་སུ་ཁཾ་ཞེས་བརྟན་པར་བྱས་ནས།",
    "ཞེས་བརྗོད་ཅིང་དཀྱིལ་འཁོར་ལ་བསྐོར་བ་བྱས་ལ་ཤར་སྒོར་མི་བསྐྱོད་པ་བསྐྱེད་པའམ་དེའི་ང་རྒྱལ་གྱིས།",
    "དམ་ཚིག་འདས་ན་བསྲེག་པར་བྱེད།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བྱིན་གྱིས་རློབས་ཤིག་རྡོ་རྗེ་སེམས་དཔའ་བདག་ལ་དབབ་པར་མཛད་དུ་གསོལ་ཞེས་ལན་གསུམ་གསོལ་བ་གདབ།",
    "སྐུ་གསུང་ཐུགས་ལ་བབས་ན་རིམ་པས་ལུས་འདར་བ་སྔགས་སྨྲ་བ་ཏིང་ངེ་འཛིན་སྐྱེ་བ་སོགས་འབྱུང་སྟེ་སྤྱི་བོར་རྡོ་རྗེ་བཞག་ལ་ཡིག་བརྒྱའམ་ཏིཥྛ་བཛྲས་བརྟན་པར་བྱའོ།",
    "དེས་དཀར་པོ་སོགས་སུ་སྣང་ཟེར་ན་ཞི་སོགས་ཀྱི་དངོས་གྲུབ་འགྲུབ་པར་ལུང་བསྟན།",
    "རྐང་མཐིལ་དུ་གནོད་མཛེས་རྣམས་ཀྱིས་ལུས་བྱིན་གྱིས་བརླབ་པར་གྱུར།",
    "གང་ཡིན་དེ་ལ་ཕོག་པར་ཤོག།",
    "མིག་འབྱེད་པར་ནི་བརྩོན་པར་མཛད།",
    "གཤིན་རྗེ་དགྲ་སོགས་བསྟན་པར་བྱ།",
    "སྟོང་པའི་ངང་ལས་བུམ་ཆུ་ཧཱུཾ་དང་རྡོ་རྗེ་ལས་མི་བསྐྱོད་པ་སྔོན་པོ་ཞལ་གསུམ་ཕྱག་དྲུག་པ་ཡུམ་དང་བཅས་པར་གྱུར།",
    "གཟུགས་རྡོ་རྗེ་མ་སོགས་ཀྱིས་བཀྲ་ཤིས་ཀྱི་གླུ་ལེན་ཁྲོ་བོ་རྣམས་ཕྱོགས་མཚམས་སུ་འཁོད་དེ་བགེགས་བསྐྲད་པར་གྱུར།",
    "སྡང་བས་ཟིལ་མནན་སྐྱེ་བོ་རྣམ་པར་སྦྱོང་མཛད་པ།",
    "བརྩེ་བའི་བདག་ཉིད་ལོག་པར་ལྟ་བ་ངེས་པར་སྤོང་།",
    "ཁམས་གསུམ་པ་ཡི་ཕྱག་བྱས་པ།",
    "གནས་ལས་བྱུང་བ་སྦྱིན་པར་བྱ།",
    "སླར་ཡང་སོགས་བགེགས་བསྐྲད་པར་གྱུར་གྱི་བར་དང་དབུ་རྒྱན་ཐོགས་ལ།",
    "ཨོྃ་བཛྲ་དུ་ཥྱ་ཧོས་དགྱེས་པར་བྱས་ལ་བུམ་པ་ཐོགས་སྟེ།",
    "སྐུ་མངའ་རྒྱལ་བའི་ཅོད་པན་འཛིན་པ་པད་ཟླའི་གདན་ལ་བཞུགས།",
    "གདུགས་དང་རྒྱལ་མཚན་སོགས་ཀྱིས་མཛེས་པར་བྱས་ལ།",
    "ཟླ་བ་ལ་འཁོད་པར་གྱུར་གྱི་བར་དང་།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྲིད་བྲལ་བྱས།",
    "སྲིད་པ་དམ་པར་བྱེད་པར་འགྱུར།",
    "དངོས་གྲུབ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ།",
    "བགེགས་བསྐྲད་པར་གྱུར་གྱི་བར་དང་།",
    "རྗེས་གནང་དང་བརྟུལ་བཞུགས་སྦྱིན་པ།",
    "གཞན་གྱི་ཆུང་མ་བསྟེན་པར་བྱ།",
    "སློབ་དཔོན་བརྙས་པར་མི་བྱ་སྟེ།",
    "རྟག་ཏུ་སྡུག་བསྔལ་ཐོབ་པར་འགྱུར།",
    "རྡོ་རྗེ་སློབ་དཔོན་མེད་པར་ནི།",
    "རང་བཞིན་མེད་ཅིང་གནས་མེད་པར།",
    "ཅན་དོན་ནི་མཉམ་མེད་བྱས།",
    "ནམ་མཁའ་མཉམ་པར་ཉིད་སྦྱོར་བས།",
    "སྔགས་དང་རྒྱུད་རྣམས་འཛིན་པར་འགྱུར།",
    "ལྷ་རྣམས་ཀྱིས་ཀྱང་མཐུན་པར་བསམ།",
    "ལས་རྣམས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར།",
    "གཡས་མི་འཇིགས་པའི་ཕྱག་རྒྱ་བྱས་ལ།",
    "རྣམ་པར་བསྟེན་པར་བྱ་མ་ཡིན།",
    "སློབ་དཔོན་སྨད་པར་མི་བྱ་སྟེ།",
    "དེ་རིང་བདུད་རྣམས་ཕམ་བྱས་ནས།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཕུང་པོ་ཅན།",
    "བུ་ཡིས་སྲོག་ཆགས་བསད་པར་བྱ།",
    "མ་བྱིན་པར་ཡང་བླང་བར་བྱ།",
    "གཞན་གྱི་ཆུང་མ་བསྟེན་པར་བྱ།",
    "བརླ་རྩར་འདུ་བྱེད་ཀྱི་ངོ་བོ་ཧ་ལས་དོན་གྲུབ་རྣམས་ཞལ་གསུམ་ཕྱག་དྲུག་པར་གྱུར།",
    "སྟོང་པ་གསུམ་རིམ་གྱིས་ཐིམ་པའི་ཐམས་ཅད་སྟོང་པ་འོད་གསལ་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་ཉམས་སུ་མྱོང་བ་བྱས་ཏེ་ལྷ་རྣམས་ཞུ་བའི་ཐིག་ལེ་མཐེབ་སྲིན་གྱིས་དཔལ་གསང་བ་འདུས་པའི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་ནོར་བུའི་དགའ་སྟོན།",
    "འབྲས་བུ་ལོངས་སྐུ་འགྲུབ་པར་བྱས་སོ་ཞེས་གོ་བ་སྦྱིན་ནོ།",
    "ཞེས་ལན་བཏབ་པས་རིག་མ་དགྱེས་ནས་སྐྲ་བཤིག་གོས་མེད་པར་ཆུ་སྐྱེས་བྱེ་ནས་སྟོན་ཅིང་།",
    "འདི་ཉིད་དུ་ནི་རྟག་ཏུ་བཞུགས།",
    "ཐིག་ལེའི་གནས་བཅུ་དྲུག་ནས་བྱང་སེམས་ཀུན་ད་ལྟ་བུ་སྤྱན་དྲངས་མགྲིན་པར་དགའ་བ།",
