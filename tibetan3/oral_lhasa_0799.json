    "མཆོག་ལྟར་བཟོད་གསོལ་དང་གཤེགས་པ་སོགས་བྱས་ལ་རྡོ་དྲིལ་འཛིན་པས།",
    "། དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ་ཞེས་བྱ་བ།",
    "མཉམ་མེད་སྒམ་པོ་པར་གྲགས་དེ་ལ་འདུད།",
    "རི་བོ་དབེན་པ་ལ་སོགས་པའི་གནས་མེ་ཏོག་སོགས་ཀྱིས་བརྒྱན་པར་སྐུ་གཟུགས་ལ་སོགས་པ་བཀོད་པ་མཆོད་གཏོར་ཚུལ་བཞིན་བཤམ།",
    "གཞན་ཡང་མཁོ་བའི་ཡོ་བྱད་ཚོགས་པར་བྱས་ཏེ་འཇུག་གོ།",
    "སོ་སོར་བཞེས་ཤིང་ཉེ་བར་ལོངས་སྤྱད་ནས།",
    "འཕྲོག་པར་བྱེད་པའི་བགེགས་དང་ལོག་འདྲེན་ཀུན།",
    "མི་དང་མི་མ་ཡིན་རྣམས་རྨོངས་པར་མཛོད།",
    "གནང་བར་མཛད་ཅིང་རྟག་ཏུ་སྡོང་གྲོགས་དང་།",
    "བཛྲཱིར་བྷ་བ་མ་ཧཱ་ས་མ་ཡ་ས་ཏྭ་ཨཱ་ཧཱུྃ་ཕཊ་ཀྱིས་བཟོད་པར་གསོལ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨཧཱུྃ་པཱུ་ཛ་མེ་གྷ་ས་མུ་ཏྲ་སྥ་ར་ཎ་ས་མ་ཡ་ཤྲི་ཡེ་དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ།",
    "ཆོ་ག་བཞིན་དུ་ཐམས་ཅད་བཤགས་པར་བགྱི།",
    "བསམ་དང་རྣམ་པར་སྨིན་པ་དག་གྱུར་པས།",
    "ཡང་དག་ཉིད་དུ་ད་ནི་གནས་པར་བགྱི།",
    "ཞེས་སྡིག་བཤགས་སོགས་བྱས་ཏེ།",
    "བདག་ལ་དགོངས་པར་མཛད་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "སྡོམ་པ་ཐམས་ཅད་ལྡན་པར་ནི།",
    "དུང་སྐྱོང་སེར་པོས་ལག་གདུབ་དང་སྟོབས་རྒྱུ་ལྗང་གུས་མཆོད་ཕྱིར་ཐོགས་བྱས་པ།",
    "དེ་སྟོད་བདུད་རྩི་འཁྱིལ་པ་ལ་ལྟེ་བ་མན་ཆད་མདུང་རྩེ་གཅིག་པའི་རྣམ་པ་ཅན་གྱི་ཕུར་བུ་མེ་རབ་དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ།་",
    "སྐུ་སྟོད་ལྷའི་གོས་ཀྱིས་ག་ཤལ་བྱས་ཤིང་སྐུ་སྨད་ལྷའི་དར་སྣ་ཚོགས་ཀྱི་ཤམ་ཐབས་འཕྱར་བ།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་སྣ་ཚོགས་པད་ཉི་ལ་བཞུགས་པའོ།",
    "ཚར་གཅོད་པའི་ཚུལ་གྱིས་བཞུགས་པར་གྱུར།",
    "དེའི་དབུས་སུ་ཨོཾ་ཨཱ་ཧཱུྃ་སྟེང་ནས་སྟེང་དུ་བརྩེགས་པར་ཐམས་ཅད་འདྲེས་པ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་ཉ་གང་བ་ཞིག་ཏུ་གྱུར།",
    "རྟ་བབས་བཞི་ནི་བརྗོད་པར་བྱ།",
    "ཀ་བ་བརྒྱད་དུ་རྣམ་པར་བཤད།",
    "སྣ་ནི་བ་དན་དུ་ནི་གསུངས།",
    "ཡིད་ནི་དབུས་ཀྱི་པདྨར་གསུངས།",
    "ཞེས་ལུས་གཞལ་དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ།",
    "མགྲིན་པར་འདུ་ཤེས་ཀྱི་ངོ་བོ་ཨཱ་ལས་འོད་དཔག་མེད།",
    "རྣ་བའི་སྒོར་སྒྲའི་རང་བཞིན་ཧཱུཾ་ལས་སྒྲ་རྡོ་རྗེ་མ་ཕྱག་རྡོར་དང་སྙོམས་པར་འཇུག་པ།",
    "ཞེས་གསོལ་བ་བཏབ་པས་སྐུའི་ལྷ་ཚོགས་ཐམས་ཅད་ཕན་ཚུན་སྙོམས་པར་ཞུགས།",
    "ཞེས་དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ།",
    "ཞེས་གསོལ་བ་བཏབ་པས་ཐུགས་ཀྱི་ལྷ་ཚོགས་ཐམས་ཅད་ཕན་ཚུན་སྙོམས་པར་ཞུགས་ཆགས་པ་ཆེན་པོའི་མེས་འོད་ཟེར་ནག་མེས་བོའི་ཤུལ་བཞག་ལས།",
    "རྡོ་རྗེ་འཛིན་པར་མཚུངས་པར་ཤོག།",
    "རིག་མ་འདུ་བྱས་ཏེ་སྙོམ་འཇུག་སོགས་བྱ་བ།",
    "ཁཾ་དང་རྡོ་དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ།",
    "ཡུམ་གྱི་བྷ་ག་ཨཱ་ལས་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་བུག་པ་ཕཊ་སེཪ་པོས་བཀག་པར་གྱུར།",
    "ཐིག་ལེ་ཆ་གཅིག་ཆ་སོ་གཉིས་སུ་གྱུར་ནས་གདན་རྣམས་ཀྱི་སྟེང་དུ་ཡི་གེ་གསུམ་གྱི་དབུས་སུ་ཆུད་པའི་ལྷ་སོ་གཉིས་ཀྱི་ས་བོན་དུ་གྱུར།",
    "དེ་ལས་ལྷ་སོ་གཉིས་གཡས་ཀྱི་ཕྱག་མཚན་དང་པོ་སོ་གཉིས་སུ་གྱུར།",
    "དཔལ་གསང་བ་འདུས་པ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་སྒྲུབ་ཐབས་དངོས་གྲུབ་འདོད་འཇོ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཐུགས་ཀ་ནས་ཕྱུང་ཕྱོགས་བཅུར་འཕྲོས་སྣོད་ཀྱི་འཇིག་རྟེན་གྱི་དྲི་མ་སྦྱངས་རང་བཞིན་གྱི་གཞལ་ཡས་ཁང་དང་འདྲེས་སླར་འདུས་ནས་གཞལ་ཡས་ཁང་ལ་ཐིམ་པར་གྱུར།",
    "དེ་བརྟན་པ་ན་ཕྱག་མཚན་མི་བསྐྱོད་པར་བསྒྱུར་ནས་གོང་བཞིན་སྤྲོ་བསྡུ་བྱ།",
    "རྣམ་སྣང་སོགས་གཙོ་བོར་བྱས་པ་ལ་འཁོར་ལོ་དཀར་པོ་ཡུངས་དཀར་ཙམ་པ་སོགས་གོང་བཞིན་སྒྲེའོ།",
    "དེ་དག་ཀྱང་སྙོམས་འཇུག་བྱས་པས་ལྷའི་ཚོགས་སྤྲོ་ཞིང་བསྡུ་བ་ལ་བསླབ་བོ།",
    "སྔགས་འཁོར་ཚུལ་སྔ་མ་ལས་བཟློག་སྟེ་ཡི་གེ་རྩུབ་པར་སྒྲ་གཞན་གྱིས་ཐོས་པར་བཟླས་པ་ནི་ཁྲོས་པའི་བཟླས་པའོ།",
    "རང་གཙོ་བོ་ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པའི་རྐྱེན་གྱིས་ཡུམ་ཡབ་ལ་ཐིམ།",
    "ནཱ་དའང་འོད་གསལ་དུ་ཐིམ་སྟེ་མི་དམིགས་པར་གྱུར།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "རབ་དགའི་སྤྱོད་པ་ཀུན་ཏུ་བཟང་པོས་བདག་ལ་གྱེས་པར་མཛོད།",
