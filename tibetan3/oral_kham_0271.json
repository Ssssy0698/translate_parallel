    "དུས་ནམ་ཡིན་ཡང་རང་ཉིད་ཞིབ་བཤེར་གྱི་གོ་སྐབས་ཤོར་དུ་འཇུག་མི་འོས།",
    "གནས་འདི་ནས་སྐྱེ་ཞིང་གནས་འདི་ནས་འཚར་ལོངས་བྱུང་བའི་ཁོ་རང་ལ་མཚོན་ན་མིག་ལ་དགའ་བ་སྟེར་བའི་བོད་ལྗོངས་ཀྱི་ཉི་འོད་དྲག་པོ་འདི་མཚར་དུ་མི་འཛིན་ཞིང་།",
    "ནི་ཁོ་རང་བསྐྱེད་པའི་དངོས་ཀྱི་མ་ཡུམ་སྟེ།",
    "ཐང་སྟོང་དང་དལ་ཅག་གེར་ལུས་པའི་གནས་འདིར་ཁོ་རང་མི་བཅར་བ་མི་སྲིད།",
    "ད་དུང་རང་བྱུང་ཁམས་ནས་བྱུང་ཞིང་རང་བྱུང་ཁམས་ལ་འདྲེས་པའི་བསམ་གཞིག་མཚོན་གྱིན་ཡོད།",
    "སེམས་པའི་འདུ་ཤེས་འདི་ནི་ཁོ་རང་འཚར་ལོངས་བྱུང་སའི་མཐོ་སྒང་ནས་བྱུང་ལ།",
    "ཁོ་རང་ཉིད་ཀྱིས་མཐོ་སྒང་ལ་བཅངས་པའི་བརྩེ་དུང་ལས་བྱུང་བ་ཡིན།",
    "ཁོང་རང་སྐྱེ་སའི་ཁྱིམ་ཚང་དབུལ་ལ་ཁྱད་དུ་འཕགས་པའི་ཤེས་རབ་ནི་ངལ་རྩོལ་གྱིས་དུབ་སྟེ་ཤུགས་རིང་ནར་ནར་འབྱིན་པའི་སྡུག་བསྔལ་གྱི་ཁྲོད་ན་ཡིད་ཀྱི་སྨོན་པ་གཡོ་བའི་དུས་སུ།",
    "སྙན་ངག་པའི་ཚོར་བ་རྣོན་པོས་ཁོ་རང་ལ།",
    "མེས་པོ་དང་རང་བྱུང་ཁམས།",
    "ཆའི་མཛེས་ཉམས་དང་མཛེས་པའི་དཔེ་ཞིབ་འབྲི་བྱེད་པའི་སྨྱུག་རྩལ་ལས་བཟི་ནས་འདུག་དགོས།",
    "ཐམས་ཅད་སེམས་ཀྱི་ཉེ་རིང་ཁོ་ནར་འདུག་ཁོ་བོ་ཕ་མས་ལུས་ཀྱི་ཆ་བགོས་ཏེ།",
    "འཇིག་རྟེན་བྱེད་པོའི་བློ་དང་ཁྱད་མི་འདུག།",
    "བླུན་པོ་ཞེས་ན་འདུག་ས་མཐོ་བས་མནར།",
    "ལས་སུ་སླ་པོ་མི་འདུག།",
    "དེ་ནས་བཟུང་འཚོ་གོས་ཀྱི་འགན་ལྕི་དེ་གཅེན་གཅུང་གཉིས་ཀྱི་ཕྲག་ཐོག་ཏུ་བབས་ནས་རང་རང་སོ་སོའི་འཚོ་བ་སོ་སོས་བསྐྱལ།",
    "ཐབས་ཤེས་ང་ལ་མི་འདུག།",
    "ང་རང་བྱིས་པའི་དུས་ཀྱི་གཏན་ཚིག་ནི་ཤིན་ཏུ་སླ་སྟེ།",
    "ཁྱིམ་མི་དག་ང་རང་འཚོལ་དུ་འོང་ནས་ངའི་མིང་ནས་འབོད་བཞིན་པ་ཐོས།",
    "དེ་ལ་ལན་བྱིན་ཚེ་སྲོག་འཆོར་ལ་མ་བྱིན་ན་ཁོ་རང་ཐབས་ཟད་ནས་ཕྱིར་ལོག་འགྲོ་ཟེར་བ་ཕྲལ་མར་དྲན་པས་ལན་སྟེར་མ་ཕོད།",
    "འོན་ཀྱང་གལ་ཏེ་མི་ཡིན་ན་ནི་ལན་མ་བྱིན་ཚེ་ང་རང་གང་དུ་ཡོད་མི་ཤེས་པས་མི་རྙེད་སྙམ་ཅི་བྱ་གཏོལ་མེད་པར་གྱུར་བ་ན།",
    "ད་ལོ་ང་རང་གཅིག་པའི་ཐོབ་སྐར་ལའང་མི་ཉུང་བ་ཞིག་ཡོད་སྨྲས་པས།",
    "དེ་མིན་ཀྱང་རང་ཉིད་གཅིག་པུའི་ལྟོ་རྒྱབ་ཙམ་ཁོ་ན་ལས་ཅི་ཡང་འདང་རྒྱག་མེད་པ་ནི་ཤིན་ཏུ་ཐ་ཤལ་སྙམ་པའི་བློ་ཞིག་ཡོད།",
    "ཕ་རྗེ་བུ་ཡིས་ཟིན་ལ་ཐེ་ཚོམ་རང་མི་འདུག།",
    "དེ་དུས་ང་རང་རང་ལོ་བཅོ་བརྒྱད་ཡིན་པས།",
    "ཏིག་ཏ་ཡིས་བརྩམས་པའི་གྲུ་ག་གཞན་ཞིག་ནས་མཐོང་བའི་འཇིག་རྟེན་གཉིས་ཀ་ལེགས་པར་མཐོང་ཅེས་སྨྲས་འདུག་པ།",
    "དང་པོ་ཙ་ན་ཁ་དམ་དྲགས་ཞེས་པ་དང་།",
    "བོད་མིའི་དགའ་སྡང་སོགས་ཀྱང་རང་སྟོབས་ཀྱིས་མཚོན་ཡོད།",
    "སྡུག་དུས་དཔོན་པོ་མ་མཐོང་།",
    "སྡུག་དུས་མགོན་སྐྱབས་མེད་ན།",
    "ང་རང་ཕ་ཡུལ་དང་བྲལ་ནས་ལོ་ངོ་ཉི་ཤུར་ཉེ་བ་ཙམ་འགོར་བ་དང་།",
    "མི་རྣམས་ཀྱིས་རང་ཤུགས་སུ་ངེད་ཚང་ལ་སྡོང་རྒན་ཚང་ཞེས་འབོད་པ་སྲོལ་དུ་གྱུར་འདུགདོན་དམ་པར་སྡོང་རྒན་དེ་ངེད་ཚང་གཅིག་པུའི་ཡིན་ག་ལ་སྲིད།",
    "ཕྱོགས་བཞི་མཚམས་བརྒྱད་ནས་འོངས་པའི་འགྲུལ་བ་རྣམས་ཀྱིས་ས་གང་ནས་བལྟས་ཀྱང་ཐོག་མར་སྡོང་བོ་འདི་མཐོང་ཐུབ་པ་དང་དེ་ཚོར་སྔོན་བསུ་གནང་མཁན་ཡང་ཀླུ་སྡོང་རང་ཡིན།",
    "སྡོང་རྒན་ཉིད་ནི་ས་དེ་གའི་མི་དམངས་ཀྱི་མཚོན་བྱེད་དུ་གྱུར་འདུག།",
    "ང་རང་སྲོག་བསྡོས་ནས་འབྲོ་སྐབས་མ་འར་ཁེ་ཟི་དང་ཁིན་ཏི་ར་གཉིས་ལ་འཕྲད་པས་སྲོག་སྐྱོབ་རོགས།",
    "མ་གཞི་སིལ་རྭ་དེ་གཞན་ལ་གཙང་ཁུར་བྱས་འདུག་ཡིན་ནའང་དེ་རུ་ངས་གཞི་ནས་མཁས་པ་སློབ་པའི་དུས་ན་སྡུག་ཅེས་པ་ཉམས་སུ་མྱངས་ཏེ་བོད་ཀྱི་བརྡ་སྤྲོད་དང་སྙན་ངག་སོགས་སློབ་པའི་སྐལ་བ་ལྡན་ཞིང་།",
    "ཀྱིན་འདུག་དེ་འདྲ་ཡིན་ཡང་སྐབས་དེར་ང་ལ་རྨོངས་བ་སེལ་བའི་སློབ་དཔོན་ཡོད་ལ་རྩོམ་རིག་གླེང་སའི་གྲོགས་པོའང་ཡོད་པར་མ་ཟད་སློབ་དཔོན་དམ་པ་དེའི་དྲིན་ལ་དགོད་བྲོ་བ་ཞིག་ལ་དེ་དུས་དམ་པ་ཁོ་རང་ཞའོ་ཀྲང་གཞོན་པ་ཡིན་པ་དང་ཞའོ་ཀྲང་གཙོ་བོ་ཡིག་རྨོངས་ཤིག་ཡིན།",
    "དུསདེར་ང་རང་ཧ་ཅང་ཆུང་ནའང་།",
    "ང་རང་བྱིས་པ་ཚོར་གྱེས་སྐབས།",
    "ད་སོ་མ་ལམ་སྣ་ཟིན་པའི་ང་རང་།",
    "དེ་ལ་སུས་ཀྱང་དོ་སྣང་བྱེད་རིན་མེད་པར་འདུག་བརྩེ་དུང་།",
    "དོན་དངོས་ཀྱིས་ཞུ་ན་ང་རང་རྩོམ་རིག་ལ་དུང་བ་ཡང་དེའི་རྗེས་མཐུན་རང་ཡིན།",
    "ང་རང་དངོས་གནས་དེ་འདྲའི་གནས་བབ་ཅིག་ཏུ་འཕག་འཚག་རྒྱག་སེམསཔའི་རྩོམ་གྱི་ལམ་བུ།",
    "བསྔགས་བརྗོད་དེ་ཚོས་ང་རང་རྗེས་སུ་གསར་རྩོམ་གྱི་ལམ་བུར་ཞུགས་པར་སྐུལ་འདེད་ཆེན་པོ་ཐེབས་པ་སྨོས་ཅི་དགོས།",
    "གང་ལྟར་ཁྱེད་རང་ནག་རིལ་རིལ་ཞིག་ནི་འདུག་ད་འཐོམས་ནས་མ་བསྡད་པར་མགྱོགས་པོ་འགྲོ་དང་ཞེས་ལབ།",
    "ཁྱེད་རང་སོ་སོ་ལ་གཅིག་ལྟོས་དང་།",
    "སོ་སོའི་བཟོ་ལྟ་གང་འདྲ་འདུག་ཨམ་ཅོག་གཅིག་ཡར་འགྲེངས།",
    "གཅིག་མར་གུག་འདུག་ཨམ་ཅོག་གཉིས་ཀ་གཅིག་པ་བཟོས་དང་ལབ།",
    "ཨམ་ཅོག་གཅིག་ཡར་ལངས་པ་དང་གཅིག་མར་ཉལ་འདུག་ཅེས་འཕྱ་ལད་བརྒྱབ།",
    "ཁོ་གཉིས་ཤིང་ནགས་དཀྱིལ་ལ་ཕར་ཙམ་སླེབས་སྐབས།",
    "ཁྱེད་རང་ལ་སྐུད་པ་ཡོད་དམ་ཟེར།",
    "ང་རང་འབུ་དམར་ཞིག་ཡིན་བསམས་ཏེ།",
    "ངས་ཁྱེད་རང་གཉིས་ལ་རྔན་པ་སྤྲད་ཆོག་ཟེར་ནས།",
    "ཁོ་རང་ཐོབ་བྱེད་ཆོ་ག་ལ་བརྟེན་ནས་ཐོབ་པའི་སྡོམ་པ་ཡིན་པའི་ཕྱིར།",
    "ཁོ་རང་ཐོབ་བྱེད་ཀྱི་ཆོ་ག་ལ་བརྟེན་ནས་ཐོབ་པའི་སྡོམ་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ཁོ་རང་ཐོབ་བྱེད་ཆོ་ག་ལ་བརྟེན་ནས་ཐོབ་པའི་སྡོམ་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་ཁོ་རང་ཐོབ་བྱེད་ཆོ་ག་ལ་བརྟེན་ནས་བརྒྱུད་ནས་ཐོབ་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་འདྲའི་གཞུང་དོན་གྲུབ་འདུག་པའི་ཕྱིར་ཟེར་ན་མ་ཁྱབ་སྟེ།",
    "ཤཱ་རིའི་བུ་ཚུར་ཤོག་ཚངས་པར་སྤྱད་པ་སྤྱོད་ཅིག་ཅེས་པའི་ཚིག་དེ་ལྟ་བུ་ཡང་སྔོན་ཆོག་མཚན་ཉིད་པ་ཡིན་ཞེས་ཁས་ལེན་ནུས་འདུག་པའི་ཕྱིར་རོ།",
    "ཞེས་པའི་གཞུང་དོན་གྲུབ་འདུག་པའི་ཕྱིར་རོ།",
    "དཀའ་བ་སྤྱོད་པ་ལ་མ་ཞུགས་པའི་སྐབས་དེར་ཡང་དགེ་སློང་དུ་བཞག་འདུག་པའི་ཕྱིར་སྙམ་ན།",
    "རྩ་བཞི་སྤོང་བའི་སྡོམ་པ་ཡིན་དགོས་ཞེས་ཁྱེད་ཧབ་འགྲོས་པ་རྣམས་ཀྱིས་ཁས་བླངས་འདུག་པའི་ཕྱིར་རོ།",
    "དགེ་ཚུལ་དང་དགེ་སློང་ལ་དེ་འདྲ་མ་བཅས་འདུག་པའི་ཕྱིར་ཞེས་ལན་བཏབ་པ་དེ་དོན་ལ་གནས་ཀྱང་ཁ་ཆེ་བ་ནི་དེ་ལྟར་མི་འདོད་ཅེས་པའི་དོན་ཡིན་པ་ཡང་།",
    "འདུག་པའི་སྤྱོད་ལམ་དང་ལྡན་པའི་དགེ་སློང་དེ་ལས་དེའི་ཁ་སྐོང་དུ་མི་རུང་བའི་ཕྱིར།",
    "ས་ལ་འདུག་བཞིན་པའི་སྒོ་ནས་ལས་བྱེད་ན།",
    "ས་ལ་འདུག་བཞིན་པ་དེ་དག་ཁ་སྐོང་དུ་མི་རུང་བ་དང་།",
    "རྒྱལ་ཟླའི་མར་ངོའི་ཚེས་ཞག་བཅུ་བཞི་པ་བཅུ་གསུམ་པ་སོགས་ཁོ་རང་ཡིན་ཟེར་བ་ཙམ་ལ།",
    "བསྒུག་ཅིང་བསྡད་དགོས་བྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "ཚེས་ཞག་ང་དྲུག་ལས་མི་འདུག་སྟེ།",
    "གལ་ཏེ་རང་རང་ཐད་སོར་ཆད་ཀྱང་།",
    "ཞག་མི་ཐུབ་ཀྱི་ཞག་དྲུག་པོ་དེ་ཟླ་བ་རང་རང་དྲུག་པོ་དེར་ལྷག་ནས་བཞག་པའམ་ཟླ་བ་བཅུ་རྫོགས་རྗེས་ལྷག་པོར་ཞག་དྲུག་བསགས་ནས་འཇོག་པ་གང་ཡང་མ་ཡིན་གྱི།",
    "མགོ་ཟླ་དང་རྒྱལ་ཟླའི་མར་ངོའི་ཟླ་ཕྱེད་བར་ལ་ཟླ་བ་ཕྱེད་གཉིས་དང་ཚེས་ཞག་ལྷག་པོ་གཅིག་འབྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ནས་དེའི་བར་ལ་ཉིན་ཞག་དྲུག་བཅུ་ལྷག་ཙམ་ཡང་འཕེལ་འདུག་པའི་ཕྱིར་རོ།",
    "དེས་དགུན་ཉི་ལྡོག་དུས་དངོས་སུ་བསྟན་པའི་ཕྱིར།",
    "དེའི་ཕྱི་ཉིན་ཚེས་བཅུ་དྲུག་ནས་སྲ་བརྐྱང་འདིང་རྒྱུ་ཡང་མ་བྱུང་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཁྱེད་རང་ལ་མི་འགྲིག་སྟེ།",
    "སྟོན་ཉིན་མཚན་མཉམ་པ་དེ་ཟླ་བ་དེའི་ནང་ཁོ་ནར་ངེས་པའི་ཕྱིར་ཞེས་ཚིག་ཟིན་ལ་ཞུགས་འདུག་པའི་ཕྱིར་རོ།",
    "བེ་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "ཡན་ལག་ལེགས་པར་གནས་འདུག་བྱ།",
    "དེ་ལྟར་ངེས་པར་རང་གནས་འདུག།",
    "སྟན་བསྲབས་སྲབ་ཙོག་བུར་འདུག་པ་དང་།",
    "གདོང་ནི་ལག་པས་བཀབ་ནས་འདུག།",
    "དེ་འོག་ས་ལ་མལ་བཅས་འདུག།",
    "བར་ནི་སྟོང་པར་འདུག་པ་ཡིན།",
    "དེ་བཞིན་དུ་འདུག་ན་ཅི་ན་ཡང་རྒྱས་པའི་ཚ་བ་ཡིན་པས།",
    "བརླན་ལ་འདུགས་འདུག་ན་མི་འཇུ་རྨུ་དམུ་ཆུར་འགྲོ།",
    "མེ་དང་ཉི་མ་རིང་འདུག་སྤང་།",
    "ཕྱི་ཤ་ལྤགས་ལ་ཤ་ཐང་ཐང་པོར་འདུག་པ་དང་།",
    "ཚོར་བ་མེད་པར་བེམ་བེམ་པོར་འདུག་པ་དང་།",
    "དགུའམ་བཅུ་གཅིག་དུས་ན་འཆི།",
    "ཁྲག་ནག་སྐྱུག་ལ་འདུག་མི་ཚུགས།",
    "མཚོན་ཕོག་དུས་སུ་བསྲེགས་པས་ཐུབ།",
    "དངུལ་ཆུ་བསྣན་པས་ཤིན་ཏུ་ཕན་པར་འདུག།",
    "བཅོ་ལྔའི་ཟླ་ཟེར་ལ་ཞག་གཅིག་འདུག་པ་དེ་གཙོ་བོ་ཡིན།",
    "སླར་ཡང་རང་ཡེ་ཤེས་ཀྱི་མགོན་པོས་ཱུྃ་ཞེས་བརྗོད་པས་ཁྲོ་བོ་བཅུ་དང་།",
    "སླར་ཡང་རང་ཡེ་ཤེས་ཀྱི་མགོན་པོས་ཱུྃ་ཞེས་བརྗོད་པས་འཁོར་དང་།",
    "ཁྱད་པར་དུའང་རང་ཅག་ཁ་བ་ཅན་པ་རྣམས་ཀྱི་མེ་ཏོག་གང་ལ་ཕོག་པའི་ལྷ་སྐལ།",
    "ཐར་འདོད་ཀྱི་སྐྱེས་བུ་རྣམས་ཀྱིས་ཚེ་ཐུང་འདིའི་ནང་ཡུལ་གང་ལ་ཚུལ་ཇི་ལྟར་བསླབ་ཚུལ་གྱི་རིམ་པ་ཆེས་ཤིན་ཏུ་གསལ་བར་མཛད་འདུག་པས།",
    "རང་ཕྱོགས་ཉེ་སྐོར་ནགས་གསེབ་ཏུ་ཡོད་བཟོ་འདུག་ཅེས་བཀའ་གནང་བར་བརྟེན།",
    "བཤགས་སྡོམ་ཇི་ལྟར་བྱ་དགོས་ཚུལ་གྱི་ཡི་གེ་འབྱོར་བྱུང་ཡང་རང་ཡུལ་གྱི་འགྲུལ་པ་དཀོན་པ་དང་།",
    "ཞྭ་ལུང་གླ་རྒྱུན་མ་གཏོགས་སྲིན་ཐག་སོགས་ཀྱིས་མི་རུང་བ་ནི་འཆི་བ་མི་རྟག་པ་དྲན་པའི་ཆེད་ཡིན་འདུག།",
    "ཁོ་བོས་དགག་བཞག་ཞུ་བ་མ་སྤོབས་ཞེས་ཞུས་ཡོད་ཅེས་བཀའ་གནང་འདུག་དེ་ལྟར་ཡང་སེ་ར་ནས་རྗེ་རང་ཉིད་ཀྱི་དངོས་སློབ་ཐུགས་ཀྱི་སྲས་མཆོག་ལུང་རིགས་སྨྲ་བ་རྣམས་ཀྱི་གཙུག་རྒྱན།",
    "འདི་ཕྱོགས་སུ་རྨོངས་ཞེན་དང་བྲལ་བའི་གཟུར་གནས་རྣམས་ལ་བློ་བསྐྱེད་དུ་འགྱུར་བ་འདུག་ན།",
    "འདི་ལོར་བརྟག་གཞིའི་དངོས་པོ་ཅི་འདྲ་འདུག་ཅེས་ཚང་མས་ཐུགས་སྣང་ཆེན་པོ་གནང་བར་མ་ཟད་རྗེས་སུ་དེ་དོན་ར་འཕྲོད་གསལ་པོར་ཡོང་ངེས་ཡིན།",
    "ཕར་ཙམ་ནག་ཁུང་ཞིག་བརྒྱུད་ནས་ཤིང་ནགས་སྟུག་པོ་ཞིག་ཏུ་རྡོ་ཕ་བོང་ཆེན་པོ་ཡོད་པ་དེའི་སྟེང་དུ་བཞུགས་པའི་ཚེ།",
    "འགྲོ་འདོད་ཅི་ཆེར་འདུག་ཀྱང་།",
    "དེང་རང་གཞན་སུ་ལ་བལྟས་ན་ཡང་།",
    "ཕྱག་འབུམ་གཅིག་དང་སྒྲོལ་མ་འབུམ་གཅིག་ངེས་པར་འགྲོ་ངེས་བསགས་དགོས་འདུག་ཅེས་བཀའ་ཕེབས་པ་བཞིན།",
    "ཐུགས་རབ་ཏུ་དགྱེས་པས་ཞལ་བཞེས་ཀྱིས་དེ་འཕྲལ་ནོར་གླིང་རང་དུ་ལས་གྲྭ་ཚུགས་ཏེ།",
    "ཞེས་པ་འདི་འདྲ་ཞིག་མཛད་འདུག་པ་ནི་རྩོམ་པའི་ཡོན་ཏན་གྱི་དཔེ་མཚོན་ཙམ་དུ་བཀོད་ཅིང་།",
    "མཚན་བཏགས་བཞེས་པར་ཉེ་ཡང་རང་ཡུལ་ཁམས་ཕྱོགས་སུ་མི་རིང་བར་ངེས་པར་ཕེབས་ན་ལེགས་ཚུལ་ཇི་ལྟར་བཀའ་སྩལ་བ་བཞིན།",
    "ད་ལྟར་དགའ་བ་བསྒོམ་རྒྱུ་འདི་དག་འདུག་ཅེས་ཞལ་ནས་དངོས་སུ་ཐོས་པ་ལྟར་བྲིས་ཤིང་།",
    "མདུན་ཕྱོགས་ཆུ་ཕྲན་འབབ་པའི་ལུང་གཤོངས་ཤིག་འདུག་པ་དེ་ནས་འགྲོ་ན་བཟང་བར་བབས་པས།",
    "བོད་མི་སྐྱབས་བཅོལ་བའི་གསོག་སྒར་དེར་རྩྭ་ཁང་མང་པོ་རྒྱབ་འདུག་པ་དེ་འདྲ་ཞིག་ཏུ་གནས་མལ་མཛད།",
    "བསྒྱུར་ཚུལ་ཡང་རང་དགར་གང་བྱུང་ཙམ་མ་ཡིན་པར་རྒྱལ་པོས་བཀས་བཅད་པ་བཞིན།",
    "བཀའ་ལན་གོང་འཁོད་ལྟར་གནང་བ་དང་ཆབས་ཅིག་ཞབས་བརྟན་ཞིག་ཀྱང་འབྲི་རྩོམ་མཛད་འདུག་པ་འདི་ལྟར།",
    "ཡང་ལོ་འདི་ཡས་མས་ཤིག་ཏུ་རྒྱུད་སྨད་འདུ་ཁང་དུ་བོད་ཟླ་དང་པོའི་ཚེས་༢༥ ནས་ཉིན་ཤས་རིང་རྒན་མཁན་ཟུར་རང་ཉིད་ཀྱིས་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ལ་འགྲེལ་པ་བཞི་སྦྲགས་ཀྱི་བཀའ་ཁྲིད་གསོལ་བ་བཏབ་འདུག་ཀྱང་།",
    "གཞན་དུ་ཕེབས་ཡུལ་དམིགས་བསལ་མེད་པ་སོགས་ཀྱིས་གྲྭ་ཚང་རང་ལ་འཁོར་ཏེ་བཞུགས་པ་ཙམ་ལས།",
    "སྐབས་དེར་གསུང་སྒྱུར་བྱམས་པ་རྒྱ་མཚོ་ལགས་ནས་གནང་འདུག་དེ་ལྟར་གཞི་བསྙེན་ཆེན་པོ་དངོས་གཞི་མ་ཚུགས་གོང་རྒྱ་གར་དུ་གུང་སེང་འཁྱུག་ཙམ་ཞིག་ཕེབས་སྐབས།",
    "སྐབས་འདིར་གསུང་སྒྱུར་བློ་བསྟན་ལགས་ཀྱིས་གནང་འདུག་ཡང་སྤྱི་ཟླ་༡ པའི་ཚེས་༡༥ ཉིན་ས་གནས་རི་ཀོན་གཞིས་བཞུགས་སྐུ་ཞབས་མིག་དམར་ཚེ་རིང་ལགས་དང་།",
    "བརྟན་བཞུགས་ཆོ་ག་སྟབས་བདེ་ཞིག་བྱས་ན་ཁྱད་མི་འདུག་ཅེས་དགོངས་པ་ཅན་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་དོན་ལྟར་ས་ཟླའི་ནང་མཆོད་འབུལ་གང་རྒྱས་ཕུལ་འདུག་ཡང་དེ་བཞིན་ཉེ་བའི་ཆར་ཨ་རི་གཞུང་ནས་༧གོང་ས་མཆོག་ལ་གསེར་གྱི་རྟགས་མ་མ་ཕུལ་གོང་ཙམ་ཞིག་ཏུ།",
    "ང་རང་ཡང་གྲ་སྒྲིག་བྱེད་བཞིན་ཡོད།",
    "མགྲིན་གཅིག་ཏུ་གཙོ་བོ་དགུང་ན་མཐོ་བའི་སྐྱོན་ལས་དམིགས་བསལ་སྙུན་གཞི་དེ་འདྲ་རྩ་བ་ནས་མི་འདུག་ཅེས་པ་ཙམ་དང་།",
    "ཀཱ་པ་ཙ་ནཱ་ཡ་ནི་ཏྱོ་ཏཱ་བ།",
    "པསྟ་པ་༡༧ཨ་བྷཱ་ས་ཏ་ཐཱ་ག་ཏཱ་བ་ཙ་ནེ་ན་ཏྭ་ཡ་བྷ་ཤཱི་ཏཾ།",
    "ཨ་པྲ་ཏི་ཧ་ཏ་པ་ཙ་ནེ་སྭཱ་ཧཱ།",
    "ཤི་རི་བི་སི་རི་སྨྲྀ་ཏི་བ་ཙ་ནེ།",
    "དེ་༡༢ན་ས་ཀུ་ཤའི་ཁྲེས་ལ་འདུག་སྟེ་སྟོང་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "གཡོན་གྱི་གཞོགས་སུ་རིག་པའི་རྒྱལ་པོ་དམ་པ་རྨ་བྱ་ལ་ཉེ་བར་འདུག་པའོ།",
    "དེ་ན་ས་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ་ཨ་ཤྭཏྤའི་༤འད་བ་མ་བདུན་གྱིས་ལྡོང་རོས་བཏུ་མས་ཏེ་བཞག་ན་ས་ཇི་སྲིད་འཕགས་པ་ཕྱག་ན་རྡོ་རྗེ་གཡོ་བར་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "འབྱུང་པོ་ཐམས་ཅ་ད་པའི་གཏོར་མ་བྱས་ན་ས་དེ་ན་ས་སྒྲུབ་པ་པོས་ཐོད་པ་ལ་ཉེ་བར་འདུག་སྟེ་ར་ས་དེས་ཀུན་ན་ས་གཡོགས་པས་སྲུང་བ་བྱས་པས་ཇི་སྲིད་དྲོ་བའམ།",
    "དེ་ན་ས་གཙང་མས་གོས་གཙང་མ་༢བགོས་ཏེ་ཐོད་པ་ལ་ཉེ་བར་འདུག་སྟེ།",
    "དེ་ན་ས་རིག་པ་འཛིན་པ་གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ།",
    "དེ་ན་ས་སྒྲུབ་པ་པོས་བསྲུང་༩བ་བྱས་ཏེ་ཀླུའི་སྟན་༡ལ་ཉེ་བར་འདུག་པས་ཇི་སྲིད་ན་མ་མཁའ་ལྡིང་ལས་འོད་ཟེར་འཕྲོ་བ་དེ་སྲིད་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ་ཀཱམྤ་ཛའི་ཡམ་ཤིང་ལ་ཞོ་དང་སྦྲང་རྩི་དང་།",
    "ཀློག་པར་བྱེད་པ་དེ་བཞིན་དུ་འདི་ཡང་གཙང་མ་བགོས་པས་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ་བཀླག་པར་བྱ་སྟེ།",
    "ཤུ་ཙ་ནི་སྭཱ་ཧཱ།",
    "སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ།",
    "སྒྲུབ་པ་པོས་དུས་གསུམ་དུ་ཁྲུས་བྱས་པའི་འོག་ཏུ་ཤིས་པའི་ཀུ་ཤའི་ཁྲེས་ལ་འདུག་སྟེ་སྦྱང་ས་པ་ལས་བྱུང་བའི་གོས་བགོ་ཞིང་འབུམ་ཕྲག་གཅིག་ཏུ་བཟླས་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་ཉེ་བར་འདུག་ན་ས་སྟོང་ཕྲག་བརྒྱད་ཉིན་ཞག་གསུམ་ཐུན་གསུམ་དུ་བཟླས་པར་བྱའོ།",
    "ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ་ནོར་བྱིན་ཅིག་གནོད་སྦྱིན་འོང་བར་འགྱུར་རོ།",
    "གྲོགས་བཟང་པོས་ཕྱོགས་སྐྱོང་བར་བྱེད་པ་གན་ས་སུ་བཅུག་ན་ས་དེའི་སྟེང་དུ་སྐྱིལ་ཀྲུང་བྱས་པ་ཉེ་བར་འདུག་སྟེ།",
    "དེའི་སྟེང་དུ་ཉེ་བར་འདུག་སྟེ།",
    "མར་མེ་བརྒྱ་ར་བ་ཏུ་སྦར་ན་ས་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་སྟེ།",
    "༩ཾ་༢ འདུག་སྟེ་ལ་ག་པ་གཡས་པས་རྩེ་གསུམ་བླང་ས་ན་ས་ཇི་སྲིད་རྩེ་གསུམ་ལས་འོད་ཟེར་བྱུང་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "དེ་ན་ས་སྒྲུབ་པ་པོ་གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་ཀུ་ཤའི་ཁྲེས་ལ་ཉེ་བར་འདུག་པས་ལག་པ་གཡས་པས་སེང་གེ་མན་ན་ཏེ་ཇི་སྲིད་སེང་གེ་གཡོ་བར་བྱེད་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
