    "མ་གྲུབ་པ་ཉིད་མ་ཡིན་པ་དེ་ལྟ་ན་བྱང་གི་སྒྲ་མི་སྙན་དང་ལྷ་མོ་ཨ་ས་ར་ལ་སོགས་པའི་ཤེས་པ་ནི་གསུམ་ལ་སོགས་པ་ཉིད་ཡིན་པར་འགལ་བར་འགྱུར་ཏེ་གཞལ་བྱ་གཞན་ཡོད་པའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་ནི།",
    "ཞེས་བྱ་བ་ནི་གཅིག་དང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་ངོ་བོ་ནི་མངོན་སུམ་ཡིན་ལ་དོན་བྱེད་པ་དང་འབྲེལ་པ་ཉིད་ནི་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དུ་བ་མཐོང་བ་ལས་མེ་རྗེས་སུ་དཔོག་པ་ན་རྗེས་སུ་དཔག་པ་འཇུག་པར་བྱེད་པ་ཉིད་ལ་སོགས་པ་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བ་མེན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འདི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལྐོག་ཤལ་ལ་སོགས་པར་སྣང་བའི་བ་ལང་གི་རྣམ་པར་རྟོག་པ་ཡང་དེར་སྣང་བ་ཙམ་ལས་བྱུང་བའི་ལྐོག་ཤལ་ལ་སོགས་པའི་ཡུལ་ཉིད་ལ་རང་བཞིན་གྱི་གཏན་ཚིགས་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའོ།",
    "རང་གི་རྟོགས་པ་གཞན་ལ་གོ་བར་བྱེད་པ་ན་འདི་ནི་འདི་དང་འདྲའོ་ཞེས་དེ་ལྟ་བུའི་རྣམ་པར་རྟོག་པའི་ཡུལ་ཉིད་ཁོ་ན་བ་བ་ལང་འདི་ཡིན་ཏེ།",
    "དེའི་ཚེ་ན་སྣང་བ་མི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཤེས་པ་ཡང་ཡིན་པས་ལྐོག་ཏུ་གྱུར་པ་དང་ཅིག་ཤོས་ཀྱི་ཤེས་པ་དེ་དག་གང་གི་ཡུལ་ཡིན་པ་དེ་ནི་དེ་བཞིན་ནོ།",
    "འབྲེལ་པ་རྟོགས་པ་ཞེས་བྱ་བ་ནི་རྟགས་འཛིན་པའི་མངོན་སུམ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྟོགས་པའི་ཁྱད་པར་ནི་དངོས་པོ་དང་འབྲེལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཅིག་ཅེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་དོ།",
    "རྟོགས་བཞིན་པ་ཐམས་ཅད་ནི་རང་གི་ངོ་བོ་ཁོ་ནས་ཡིན་གྱི།",
    "གཞན་གྱི་ངོ་བོ་རྟོགས་པ་ཉིད་སྒྲུབ་པར་བྱེད་པ་ནི་དོན་བྱེད་ནུས་པ་ནི་རང་གི་ངོ་བོ་དམིགས་པ་ལའོ་གཞན་ནི་རང་གི་ངོ་བོ་དམིགས་པ་མེད་ན་དམིགས་བཞིན་པ་ཀུན་རྫོབ་པའི་ཡང་དག་པའི་རྟོགས་པས་རྟོགས་བཞིན་པའི་གཞན་གྱི་ངོ་བོས་དམིགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དག་དེ་ལྟར་རྟོགས་པ་ནི་རང་གི་མཚན་ཉིད་དང་ཅིག་ཤོས་ཉིད་དུ་སྔོན་གྱི་སློབ་དཔོན་རྣམས་ཀྱིས་གསུངས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱོགས་སྔ་མ་པའི་བསམ་པ་ནི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བྱེད་པ་མེད་པ་ཞེས་བྱ་བ་ནི་དེའི་རང་གི་ངོ་བོ་ཉམས་པ་མ་ཡིན་ཡང་དེ་ལ་གཞན་མེད་ན་འབྲས་བུ་མཐོང་བ་མ་ཡིན་ནོ།",
    "ཐ་དད་པ་ལ་ནི་ཞེས་བྱ་བ་ནི་རྒྱུན་དང་རྒྱུན་ཅན་དག་གིའོ།",
    "སྐད་ཅིག་པའི་རྒྱུན་ཡང་རྒྱུན་གྱི་འབྲས་བུ་ཡིན་ཞེས་བྱ་བའི་ཕྱོགས་ལ་དེ་ཡང་སྐད་ཅིག་པ་ཡིན་པའི་ཕྱིར་རྒྱུན་གཞན་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་འདིར་ཡང་རྒྱུན་གྱིས་ཞེས་བྱ་བ་སྟེ།",
    "དེ་སྟེ་ཁྱོད་ལ་འབྲས་ཉིད་མིན་ཏེ་དུས་མཚུངས་པའི་ཕྱིར་རོ།",
    "དྲན་པ་ནི་རྣམ་པར་རྟོག་པ་སྟེ་ཐོག་མ་མེད་པའི་བག་ཆགས་ཀྱི་བསྐྱེད་བྱ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཉམས་སུ་མྱོང་བའི་བག་ཆགས་ཀྱི་བསྐྱེད་བྱའི་དྲན་པ་ནི་ཇི་ལྟར་ཉམས་སུ་མྱོང་བ་ཁོ་ན་ལ་འཇུག་གི།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འབྲས་སོགས་གཞལ་བྱ་རེ་ཞིག་ཞོག།",
    "གལ་ཏེ་ཡང་མཐོང་བའི་རྗེས་སུ་དཔག་པའི་རྣམ་པར་རྟོག་པ་སྔོན་པོ་དང་དེ་མཐོང་བ་དག་གི་རྒྱུ་དང་།",
    "གང་ཞིག་གང་གི་ཞེས་བྱ་བའོ།",
    "རྒྱུ་གང་གིས་རབ་རིབ་ཅན་གྱི་ཤེས་པར་ཐལ་བར་འགྱུར་སྙམ་དུ་སེམས་པ་ནི།",
    "དེའི་ཕྱིར་ཐལ་ཆེས་པ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི་སྔོན་པོ་ལ་སོགས་པ་མ་གཏོགས་པའི་ཞེས་བྱ་བའོ།",
    "ཅིག་ཤོས་དག་གིས་སོ་སོར་སྣང་བཞིན་པའི་ཁྱད་པར་ལས་དམིགས་པ་དང་བཅས་པ་དང་།",
    "ཅིག་ཤོས་ཉིད་ཀྱི་ཁྱད་པར་ཡིན་ནོ་སྙམ་དུ་སེམས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ནི་མྱོང་ཡང་ནི་རེག་བྱ་རིག་པ་ལ་ཡང་ངོ།",
    "དེ་ཉིད་བསྟན་པ་ནི་གཞན་ཡང་ཉམས་སུ་མྱོང་བ་ཞེས་བྱ་བ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་དག་ཅེས་བྱ་བ་ནི་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པ་དག་གོ།",
    "གང་ཕྱིར་མངོན་སུམ་རྗེས་དཔག་གིས།",
    "ཁྱད་པར་རིག་པ་མིན་པ་ནི་རང་གི་མཚན་ཉིད་རིག་པ་མིན་པའོ།",
    "གང་གིས་རིག་ཅེ་ན་རབ་རིབ་ཅན་གྱིས་སོ།",
    "རང་རང་གི་དམིགས་བྱ་ཉིད་མ་གཏོགས་པ་མ་དམིགས་པའི་ཕྱིར་དང་།",
    "ཕྱི་རོལ་གྱི་དོན་མི་བྱེད་པ་ནི་བདེ་ན་མོད་ཀྱི་ཅུང་ཟད་ཉམས་སུ་མྱོང་བ་ཁོ་ན་སྔོན་པོ་ལ་སོགས་པའི་སྣད་བ་དང་།",
    "ཅིག་ཤོས་དག་གིས་ཡོད་པ་དང་མེད་པའི་རྣམ་པར་གཞག་པའོ་སྙམ་དུ་སེམས་པ་ནི་ཅི་སྟེ་མྱོང་བ་རྣམས་ཞེས་བྱ་བའོ།",
    "ཕྱོགས་འདི་ལ་རང་རིག་པའི་ཤེས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འབྲས་བུ་མཐོང་བ་ལས་རྒྱུད་གཞན་གྱི་ཤེས་པ་རྗེས་སུ་དཔོག་པར་བྱེད་ལ་འབྲས་བུ་ཉིད་ཀྱང་འགའ་ཞིག་གིས་རང་གི་རྒྱུད་ལ་གཟུང་བར་བྱ་བ་དེ་ཡང་རང་རིག་པ་ཙམ་གྱིས་འཛིན་པར་མི་བྱེད་ཅིང་གཞན་རིག་པའི་ཤེས་པ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ཉིད་གཞན་དུ་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་རྒྱུ་ཉིད་རྗེས་དཔག་གིས།",
    "གང་གི་ཕྱིར་ཤེས་པ་ཡོད་པ་ཉིད་ཀྱི་ཕྱིར་ཤེས་བྱ་ཡང་ཐམས་ཅད་དུ་ཡོད་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "གང་གི་ཚེ་ན་ཡོད་པ་དེའི་ཚེ་རྗེས་སུ་དཔོག་པར་བྱེད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ་སྔ་མ་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "ད་ནི་ད་ལྟར་བའི་རྟོག་གེ་བ་རྣམས་དགའ་བའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གལ་ཏེ་ཡང་འབྲས་བུ་སྟོང་པའི་ངོ་བོ་སྔ་ན་མེད་པ་ལ་འབྲས་བུ་ནི་ཐལ་ཆེས་པ་ཡིན་ཡང་གཏན་མེད་པ་ལ་ནི་ཐལ་ཆེས་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ་ནི་སྔ་ན་མེད་པ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "འབྲས་བུ་ཉིད་ལ་སོགས་པ་མེད་ན་ཐམས་ཅད་མེད་པར་ཐལ་བར་འགྱུར་བས་རྟོགས་པ་ལ་འགལ་བ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འབྲས་བུའི་དུས་ནི་མེད་པ་ནི་རྒྱུ་ཉིད་དུ་མ་རིག་གིས་པ་ཡིན་ལ།",
    "རྒྱུ་བཞིན་དུ་རེ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་དགོངས་པའོ།",
    "འདི་རྗེས་སུ་དཔག་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྗེས་སུ་དཔག་པས་ཀྱང་རང་གི་ངོ་བོ་རྟོགས་པ་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པ་ཡང་མི་གསལ་བའི་དངོས་པོའི་ངོ་བོ་ལ་རེག་པས་མངོན་སུམ་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་དུས་ཀྱི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "རྟོགས་པ་མེད་པ་ཉིད་ཅེས་བྱ་བ་ནི་རང་གི་ངོ་བོར་རོ།",
    "ལྐོག་ཏུ་གྱུར་པ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོར་མ་རྟོགས་པ་ཁོ་ན་དོན་ལྐོག་ཏུ་གྱུར་པ་ནི་ཐེ་ཚོམ་མོ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོར་རྗེས་སུ་དཔག་པས་བདག་ཉིད་ཐམས་ཅད་ངེས་པ་ལ་ཐེ་ཚོམ་ཟ་བ་ནི་མི་རིགས་ལ་མངོན་སུམ་གྱིས་མཐོང་བ་ལ་ནི་ངེས་པའི་བདག་ཉིད་མ་ཡིན་པའི་ཕྱིར་ཐེ་ཚོམ་ཟའོ།",
    "སྐད་ཅིག་པ་ལ་སོགས་པ་ལ་ནི་ཐལ་བ་ལས་མེ་རྗེས་སུ་དཔོག་པ་ན་ཞིག་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "ནུས་མེད་ན་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོ་མ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མཐོང་བ་ཞེས་བྱ་བ་རང་གི་ངོ་བོའི་ཡུལ་ཅན་མ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་ནུས་པའི་ཡུལ་ཅན་ཡིན་ལ་དེ་ནི་མངོན་སུམ་མ་ཡིན་ནོ།",
    "ལྷག་པར་མོས་པ་ནི་བསྟན་པའི་རྣམ་པར་རྟོག་པའོ།",
    "རྣམ་པར་རྟོག་པ་ཉིད་ནི་ཕལ་ཆེར་འཇིག་རྟེན་པ་ཐ་སྙད་དུ་བྱེད་པ་ཡིན་པར་བསྟན་པ་ནི་དངོས་འདི་བདག་གིས་དྲན་པ་ཞེས་བྱ་བ་སྟེ།",
    "མངོན་སུམ་ནི་རང་གི་ངོ་བོ་རིག་པ་ཙམ་གྱི་མཐར་ཐུག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གིས་རང་གི་ངོ་བོ་ཡིས།",
    "རེ་ཞིག་མངོན་སུམ་དང་མི་དམིགས་པ་རྣམས་མངོན་སུམ་གྱི་ངོ་བོ་སྟེ།",
    "རང་གི་ཡུལ་རྣམས་ལ་འབྲས་བུ་དང་ཅིག་ཤོས་ཉིད་ཀྱིས་སྦྱོར་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པའི་ངོ་བོ་ཡང་རྗེས་སུ་དཔག་པ་ལ་འབྲེལ་པ་འཛིན་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་བཞིན་རྗེས་དཔག་གི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་དུ་བ་ནི་མེ་ཉིད་ལས་བྱུང་བར་ལན་ཅིག་མ་ཡིན་པར་དམིགས་པ་ཡིན་གྱི།",
    "མ་ཁྱབ་པ་ལས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མི་སྨོད་པའི་རྣམ་པར་རྟོག་པ་ནི་མོས་པ་ཡིན་གྱི།",
    "ཡུན་རིང་བའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་པ་ལ་སྐད་ཅིག་གི་དངོས་པོ་ཞེས་བྱ་བའོ།",
    "དོན་གྱིས་ནུས་པ་མེད་པ་རྣམས་ལ་དེ་མ་ཐག་པ་རྣམ་ལ་དོགས་པ་མེད་དོ་ཞེས་བྱ་བའི་རིགས་པས་དེ་མ་ཐག་པ་ཉིད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལྟ་མོད་ཀྱི་རང་གི་ཡུལ་རྣམ་པར་འཇོག་པ་ནི་མ་ཡིན་ནོ།",
    "རྟོགས་པའི་ངོ་བོ་ཉིད་ཀྱིས་ནི་ཡུལ་རྣམ་པར་འཇོག་པར་བྱེད་པ་ཡིན་གྱི་རྟོགས་པ་གཞན་རང་གི་ཡུལ་རྣམ་པར་གཞག་པ་བྱེད་པས་ནི་མ་ཡིན་ནོ།",
    "གང་དུ་ཡང་རང་གི་ཡུལ་རྣམ་པར་གཞག་པ་མེད་པའི་ཕྱིར་རོ།",
    "གནོད་པ་ཅན་ཡང་རང་གི་ངོ་བོ་ལ་གནོད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རང་གི་དུས་ཙམ་ཡུལ་ཡིན་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པའོ།",
    "གཞན་པ་ཙམ་ནི་ཡུལ་མ་ཡིན་མོད་ཀྱི།",
    "ཞེས་བྱ་བ་ནི་མིག་ལ་སོགས་པའི་བློ་བཞིན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལྟ་ཡང་མིག་ལ་སོགས་པ་མེད་པར་ནི་ནང་གི་ཞེས་སྟོན་པའོ།",
    "བ་ལང་གི་ཚོགས་པ་པ་ཡང་རྟ་ལ་སོགས་པ་མཚན་ཉིད་མི་མཐུན་པ་རིལ་པོ་བཞིན་དུ།",
    "མ་ཚོལ་བའི་བེའུ་ནི་རྟ་ལ་སོགས་པ་ལས་ལོག་པ་བ་ལང་གི་ཚོགས་ལ་རྗེས་སུ་འཇུག་པ་ནི།",
    "དེས་ཞེས་བྱ་བ་ནི་དེའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ཉིད་ཁོ་ན་ཡན་ལག་དུ་མའི་ཐུན་མོང་ཡིན་པའི་ཕྱིར་སྤྱི་ཡིན་ནོ།",
    "ལས་ཡིན་ལ་དེ་ཉིད་རྫས་དུ་མའི་ཐུན་མོང་ཡིན་པའི་ཕྱིར་སྤྱི་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་ཡིན་པའི་ཕྱིར་འགལ་བ་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "བསྐོར་བ་དང་འདེགས་པ་ལ་སོགས་པ་ནི་བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་དུས་གཅིག་ན་ཡོད་པ་མ་ཡིན་ནོ་བྱ་བའི་ཡན་ལག་རིམ་གྱིས་དུས་མང་པོར་བྱུང་བ་རྣམས་ཀྱིས་བསྐོར་བ་གཅིག་ཏུ་གསལ་བར་བྱེད་པ་འདི་ཡང་གཏམ་ཙམ་ཡིན་ཏེ་མཐའི་གསལ་བྱེད་ཙམ་གྱིས་གསལ་བར་བྱ་བ་ཉིད་ལ་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོ་ཉིད་ཀྱིས་བསྐོར་བ་མ་ཡིན་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "རང་གི་ཤེས་པས་གཞན་གྱི་བློའི་རྒྱུ་གསལ་བར་བྱེད་པའི་ཕྱིར་ཏེ་གསལ་བྱེད་ལྟ་བུའོ།",
    "རྡུལ་ཕྲ་རབ་ཀྱང་ཡིན་ན་གང་གི་ཕྱིར་གཞན་གྱི་མངོན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དབྱིབས་ཀྱི་བྱེ་བྲག་གི་ཁྱད་པར་དུ་བྱས་པས་མཚན་ཉིད་མི་མཐུན་ཞིང་བརྡའི་བྱེ་བྲག་གི་ཡུལ་དུ་མཐོང་བ་རྣམས་ནི་དེའི་བག་ཆགས་སད་པའི་རྒྱུ་རྣམས་ལ་དེའི་སྒྲ་རྣམས་ཀྱིས་བརྗོད་པ་ཡིན་ནོ་ཞེས་དོན་དུ་བསྟན་པ་ནི།",
    "དེ་བཞིན་དུ་བདག་གིས་རེག་གོ་ཞེས་བྱ་བའོ།",
    "མཐོང་བ་ལ་བདག་གིས་རེག་གོ་ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་ནི་མཐོང་བ་ལས་བྱུང་བ་ཡིན་གྱི།",
    "བག་ཆགས་ཅམ་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ཡང་ཕྱི་རོལ་རྣམ་པར་འཇོག་པ་བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་ལ་ཡང་དབྱེ་བ་དང་དབྱེ་བ་མ་ཡིན་པར་རིག་པ་ཁོ་ན་སྣང་བའི་མེད་པ་རིག་པ་ལན་ཡིན་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བརྡས་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པར་བྱས་པ་དག་ཇི་ལྟ་བ་བཞིན་པའི་བརྡས་པ་བརྗོད་པ་དང་རྟོགས་པ་ཡིན་གྱི་དེ་དག་ལས་དངོས་པོའི་དབྱེ་བས་གྲུབ་པ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི།",
    "གང་ཁོ་ནར་གཟུགས་ཡིན་པ་དེ་ཁོ་ནར་རེག་པ་མ་ཡིན་ནམ།",
    "གཟུགས་དང་རེག་པ་ལ་སོགས་པའི་ཚོགས་པ་གཅིག་ལས་བྱུང་བའི་འདུས་པ་ནི་བུམ་པར་ཐ་སྙད་གདགས་པའི་ཡུལ་ཡིན་ལ།",
    "ཁ་ཅིག་ན་རེ་གྲངས་ཀྱི་ཤེས་པའི་རྟོགས་བྱ་ནི་མང་བ་ཉིད་ཡིན་གྱི།",
    "ཡན་ལག་ཅན་ཐ་དད་པ་མ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་གྲུབ་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དང་བདེ་བ་གཅིག་པའི་གཟུགས་ལ་སོགས་པའི་ཐ་སྙད་གཅིག་གི་ཡུལ་ཡིན་ལ་སྟེང་དང་འོག་གི་ཆས་ཕྱེ་བ་ཡིན་ཡང་གཅིག་ཡིན་ཏེ།",
    "དེ་བསྟན་པ་ནི་སྣང་བ་ཐ་མི་དད་པར་ཐལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "རེ་ཞིག་གཅིག་ཉིད་དོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འདས་པ་ནི་གསལ་བར་བྱེད་པ་མ་ཡིན་རང་གི་ཤེས་པས་གཞན་གྱི་བློའི་རྒྱུད་ཉིད་མ་ཡིན་ཞེས་བསྟན་པ་ནི།",
    "ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དོན་གྱི་ཁྱད་པར་གྱི་འགལ་བ་ཟེར་བ་ནི་ཆུ་ཀླུང་གི་འགྲམ་ན་ཞེས་བྱ་བའོ།",
    "དེ་སྤྱི་ཡིན་མོད་ཅེས་བྱ་བ་ནི་སྒྲའི་ཡུལ་ཙམ་མོ།",
    "ཡོད་པའི་དོན་གྱིས་སྒྲའི་ཡུལ་དུ་སྣང་བ་ཉིད་ཐལ་ཆེས་པར་མི་འགྱུར་བར་བསྟན་པ་ནི་འདི་ལྟར་སྤྱི་ནི་ཁོ་བོ་ཅག་ཅེས་བྱ་བའོ།",
    "རང་གི་མཚན་ཉིད་ཀྱི་མཚན་ཉིད་ལ་ཡང་ཁྱབ་ཆེས་བ་གསལ་བའི་ཕྱིར།",
    "གལ་ཏེ་སྐྲ་ལ་སོགས་པ་ཡང་གང་དག་གི་བྱ་བ་ལ་ལྟོས་ནས་དེ་དག་གི་བྱ་བ་དང་ཞེས་སྦྱར་རོ།",
    "གང་གི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པ་གསལ་བ་ཉིད་དུ་སྣང་བཞིན་པ།",
    "ལན་དུ་གསལ་སྣང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་དག་གི་ཡང་དེ་ལྟའི་དངོས་ཞེས་བྱ་བའི་གནས་སྐབས་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོས་སྐྲ་ཤད་ཀྱི་སྣང་བ་ནི།",
    "རང་གི་ངོ་བོས་དགག་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཡོད་པ་དང་མེད་པ་དག་གིས་མེད་པར་བསྟན་པ་ནི།",
    "འགལ་ལོ་ཞེས་བྱ་བ་ནི་ནུས་པ་ཅན་དང་ནུས་པ་ཅན་མ་ཡིན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་དོན་རྣམས་ཀྱིས་མཚུངས་པའི་ངོ་བོ་ནི་མཚུངས་པ་ཉིད་ཡིན་ཏེ།",
    "ཀུན་ལ་ཞེས་བྱ་བ་སྨོས་ཏེ་ཤིང་གི་སྒྲའི་ཤེས་པ་ཡང་།",
    "གང་གི་ཕྱིར་ལྡོག་པ་ལས་སྐྱེས་པའི་རྣམ་པ་ནི་ལྡོག་པ་ཉིད་དུ་ཞེན་པར་བྱེད་དེ།",
    "གང་གི་ཕྱིར་ཐོས་པའི་སྒྲ་ནི་རང་བཞིན་ཁོ་ནས་དོན་རྟོགས་པར་བྱེད་ཀྱི།",
    "ངག་ནི་མིང་ལ་འཇུག་ལ་མིང་ནི་དོན་ལ་འཇུག་ཅེས་བྱ་བའི་ཁ་ཅིག་གི་ལྟ་བ་དེ་སེལ་བར་བྱེད་པ་ནི་ཤེས་པའི་རྣམ་པ་དེ་ནི་མིང་མ་ཡིན་ཏེ།",
    "མཐོང་བ་པོ་ལོང་ཞིང་ལྐུགས་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཡུལ་དེ་རྡུལ་གང་གི་ཡིན་པ་དེ་ནི་དེའི་ཡུལ་ཡིན་པ་དེའིའོ།",
    "འཁྲུལ་པ་ཉིད་ནི་ཕྱི་རོལ་ལ་ཤེས་པའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྨི་ལམ་གྱི་ནང་གི་ནི་སྔོན་པོ་ལ་སོགས་པ་ཉིད་མ་ཡིན་ཏེ།",
    "ལྷའི་མིག་གིས་མཐོང་བ་ཉིད་ཡིན་ཡང་ཐུན་མོང་བ་མ་ཡིན་ནོ།",
    "ཐམས་ཅད་ཀྱིས་ཞེས་བྱ་བ་ནི་གཉིད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ནང་གི་བག་ཆགས་ཡོངས་སུ་སྨིན་པ་ཡང་འཛིན་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རྒྱུ་ཡིན་པར་བསྟན་པ་ནི་འདུ་བྱེད་ཀྱི་ཞེས་བྱ་བའོ།",
    "འདུ་བྱེད་པའི་དང་གིས་དེ་སྐྱེད་པར་བྱེད་པ་མཐོང་བ་ལ་རྣམ་པར་དབྱེ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "འདིས་ནི་ཞེས་བྱ་བ་ནི་ཤེས་པ་ཐམས་ཅད་ཕྱིན་ཅི་ལོག་པར་སྣང་བ་ཉིད་དུ་ཐལ་ཆེས་པས་སོ།",
    "རྨི་ལམ་ལ་སོགས་པའི་ཤེས་པ་དོན་དང་ལྡན་པ་ཉིད་ནི་རེ་ཞིག་ཞོག།",
    "སད་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྣམས་ཀྱིས་གཟུགས་ལ་སོགས་པའི་བློ་འདི་གང་ཡིན་པ་དེ་ཉིད་དོན་དན་ལྡན་པར་གང་གིས་ཏེ།",
    "རྨི་ལམ་ལ་སོགས་པ་དང་ཐུན་མོང་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "མིང་དང་མཚན་མ་ལ་བསྟན་པའི་ཐལ་བར་འགྱུར་བར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཚུངས་པ་རྣམས་ཀྱི་ངོ་བོ་ཞས་བསྒྲུབ་པ་ཙམ་གྱི་དངོས་པོ་རང་གི་བདག་ཉིད་ཀྱིས་ཡོད་བཞིན་པའི་སྤྱི་ནི་གསལ་བ་རྣམས་ལ་འཇུག་པ་ཡིན་གྱི།",
    "རྟག་ཏུ་ནི་གསལ་བ་ཡོད་དམ་མེད་ན་ཡང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རེས་འགའ་བ་ནི་རྟག་ཏུ་དམིགས་པ་མ་ཡིན་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ་རྟག་ཉིད་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "གང་གི་ཞན་གསལ་བའི་སྟེ་ཁྱད་པར་གྱིའོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྔོན་པོ་ལ་སོགས་པའི་རང་གི་མཚན་ཉིད་ལ་དམིགས་ན་བྱིས་པའི་ཐོག་མ་མེད་པའི་བག་ཆགས་ཀྱིས་བསྐྱེད་པའི་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་མི་གསལ་བར་སྣང་བ་ཡིན་ཏེ།",
    "གང་གིས་སྤྲུལ་ཞེས་བྱ་བ་ནི་སྔོན་པོར་མཐོང་བ་དང་བག་ཆགས་དག་གིས་དྲངས་པ་ཡིན་གྱི།",
    "སྤྱི་མེད་པར་ཐལ་བའི་ཕྱིར་ཏེ་ཞེས་བྱ་བ་འདི་བསྟན་པ་ཡིན་ནོ།",
    "གཉི་ག་ཡང་ཞེས་བྱ་བ་ནི་དོན་དང་སྤྱི་དག་གིའོ།",
    "ཡིན་ནོ་ཞེས་བྱ་བའི་ཐལ་བར་འགྱུར་བའི་དོན་ཉེ་བར་བསྡུ་བ་ནི་གསལ་བ་ཉིད་སྒྲས་ཞེས་བྱ་བའོ།",
    "གཅིག་གི་ངོ་བོ་ལ་མངོན་སུམ་དུ་ངོ་བོ་ཉིད་གཉིས་སུ་མི་སྣང་བའི་ཕྱིར་ཐ་དད་པར་སྣང་བ་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པས་གཟུང་བའི་ཕྱིར་ཡུལ་ཐག་རིང་བ་ལ་སྒྲ་ཐོས་པའི་ཤེས་པས་རྟོགས་པ་ཡིན་ཏེ།",
    "གསལ་བའི་ངོ་བོ་ནི་སོ་སོར་གཅིག་ལ་གཅིག་ལྡོག་པར་གྲུབ་པ་རང་རང་གི་རྒྱུ་ལས་གྱུར་པ་ཡིན་ཞེས་གཞན་གྱིས་ཀྱང་ཁས་བླངས་པ་བསྟན་ཏོ།",
    "གང་གིས་གཞན་ལ་བརྟེན་པའི་ཕྱིར།",
    "ཁྲ་བོ་ལ་ཁུ་ཡུ་ཉིད་དུ་སྣང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་རྒྱུ་ལ་ལྟོས་ནས་འབྲས་བུ་ཉིད་ཡོད་དོ་ཞེ་ན།",
    "དེའི་འདི་ཞེས་ཇི་ལྟར་འབྲས་བུ་ཡིན་པ་དེ་བཞིན་དུ་དེ་ཉིད་འདིའོ་ཞེས་འབྲས་བུ་མ་ཡིན་པར་རྟོགས་པ་ཉིད་དོ་ཞེ་ན་རྟོག་པ་འབའ་ཞིག་གིས་འབྲེལ་པར་བྱེད་པ་ཡིན་གྱི།",
    "གང་གི་ཕྱིར་ཐ་མི་དད་པ་དང་།",
    "གསལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རི་བོང་གི་རྭ་བཞིན་དུ་འབྲེལ་པ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་འགྱུར་ན་རི་བོང་གི་རྭ་ལ་ཡང་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ལ།",
    "མེད་པ་རིགས་སུ་ཐལ་མི་འགྱུར།",
    "མེད་པ་ནི་རི་བོང་གི་རྭའོ།",
    "འདི་ནི་རི་བོང་གི་རྭ་དང་བ་ཁྲ་མོ་དག་ལ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་བརྟེན་ནས་ཞེས་བྱ་བ་ནི་བ་ཁྲ་མོ་ལ་སོགས་པ་ལ་བརྟེན་ནས་སོ།",
    "དེ་ལ་ཡང་ནི་བ་ཁྲ་མོ་ལ་སོགས་པ་ལ་བ་ལང་ཉིད་ཀྱི་རྟོག་པ་འཇུག་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཏེ་ཞེན་པའི་ཕྱིར།",
    "སྤྱི་དེའི་ངོ་བོ་ཡིན་གྱི་བ་ཁྲ་མོ་ལ་སོགས་པ་དེ་དག་གི་འབྲེལ་པ་ཅན་ཐ་དད་པ་ནི་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "ཕྱོགས་དང་མཐུན་ཕྱོགས་པ་བཞིན་དུ་རི་བོང་གི་རྭ་དང་བ་ཁྲ་མོ་དག་ལ་ཡང་ཅིས་མི་འགྱུར་སྙམ་དུ་སེམས་པ་ལ།",
    "བྱིས་པ་དང་ཕྱུགས་ལ་སོགས་པ་ཡང་བ་ཁྲ་མོ་མཐོང་ནས།",
    "དེའི་ཕྱིར་རི་བོང་གི་རྭ་དང་དོན་མཐོང་བ་ལས་བྱུང་བའི་རྟོགས་པས་གོ་བར་བྱ་བའི་ཡུལ་ལ་སྒྲ་རྣམས་རྒྱུད་ནས།",
    "དགོས་པ་གང་དག་གིས་ཡིན་པ་དེ་ནི་དོན་ཅན་ནོ།",
    "རྟོག་པ་དང་མཚུངས་པའི་ཡུལ་ཅན་རྣམས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་དག་གི་དགོས་པ་ཡིན་པ་དེ་དག་གིས་སོ་ཞེས་ཁ་ཅིག་འཆད་དོ།",
    "དེ་ཡང་ཁྱད་པར་ཐམས་ཅད་ཀྱི་ཐུན་མོང་ཡིན་པའི་ཕྱིར་སྤྱི་ཞེས་བརྗོད་དོ།",
    "མི་གསལ་བའི་ངོ་བོ་རྣམ་པ་ཉིད་ཇི་ལྟར་ཡིན་གང་གི་ཕྱིར་ངོ་བོ་མེད་པ་ལ་ནི་ངོ་བོར་རིགས་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ།",
    "རིགས་སྦྱོར་ཡིན་པ་ཉིད་དུ་ཟིན་ཀྱང་དེ་དག་ཤེས་པ་གཅིག་གི་བདག་ཉིད་དུ་གྱུར་པའི་ཕྱིར་གཅིག་ཉིད་དུ་ཞེན་པ་ཅི་ལས་ཡིན་ཞེས་དབྱེ་བ་ལས་དབྱེ་བ་བསྟན་པ་ནི།",
    "མ་མཐོང་བ་ཞེས་བྱ་བ་ནི་གསལ་བ་དང་རྣམ་པར་རྟོག་པ་དག་གི་དབྱེ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དོན་ལས་ལྡོག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཞན་དག་གི་ལྡོག་པ་ནི་ལྡོག་པར་བྱེད་པ་ཉིད་ཀྱི་མཚན་ཉིད་དེ།",
    "ངོ་བོ་གང་གི་ཡིན་པ་དེ་ནི་གཞན་ལས་ལྡོག་པའི་བདག་ཉིད་ཀྱི་དངོས་ཁོ་ན་སྤྱི་ཡིན་ལ།",
    "རང་གི་མཚན་ཉིད་ནི་མ་ཡིན་ནོ།",
    "མིང་ལ་གཞན་དུ་ཐལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་ཁྱེར་ནས་འོངས་པ་ནི་ཁྱེར་ནས་མ་འོངས་པ་འགོག་པར་བྱེད་པ་དང་པོ་འཛིན་པ་ལའོ།",
    "དེ་ནི་བ་ལང་མ་ཡིན་པ་ལ་ཡང་ཐལ་བར་འགྱུར་བས་བ་ལང་ཞེས་བྱ་བའོ།",
    "དེ་ལས་ཀྱང་ནག་པོ་མ་ཡིན་པ་ལ་ཡང་ཐལ་བར་འགྱུར་བའི་ཕྱིར།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བདེན་ཏེ་མ་ཡིན་པར་དགག་པ་ལ་ཡང་དེའི་བདག་ཉིད་ཁོ་ན་གཞན་དང་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོས་མེད་པར་དགག་པ་བརྗོད་ཀྱི་དངོས་པོ་ལས་ཐ་དད་པས་ཐུན་མོང་མ་ཡིན་པ་མ་རྟོགས་པའི་ངོ་བོ་བསྟན་པ་ནི་བཀག་པ་ནི་འགོག་པར་བྱེད་པ་སྟེ།",
    "གཞན་གྱི་རྟོག་པ་ཡིན་ཞེས་བྱ་བ་ནི་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོའི་རྟོག་པའོ།",
    "གཞན་བ་ལང་གི་ཇི་ལྟར་ཡིན་གང་གི་ཕྱིར།",
    "མེད་པ་སེལ་བར་བྱེད་པའི་ངོ་བོ་ཡང་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོ་དང་བྲལ་བ་མེད་པ་ཙམ་ཁོ་ནའོ་ཞེས་ཟེར་བ་ནི་གཞན་ཡོད་པ་ཉིད་ཅེས་བྱ་བའོ།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་མཐོང་བ་ནི་གཞན་ལས་ལྡོག་པར་བྱེད་པའི་བདག་ཉིད་ཀྱིས་རྟོག་པའི་ཡུལ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་ནི་རང་གི་ངོ་བོས་རྣམ་པར་རྟོག་པ་ལ་མི་སྣང་བ་མ་ཡིན་ནམ།",
    "དེ་དང་ཐུན་མོང་མ་ཡིན་པ་ལྡོག་པར་བྱེད་པར་ཡང་ངོ་སྙམ་དུ་སེམས་པ་ལ།",
    "རང་གི་བློ་ཉིད་དེ་སྟེ།",
    "ཐུན་མོང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རིམ་པ་གཞན་ནོ།",
    "ཐུན་མོང་མ་ཡིན་པས་མེད་དོ་ཞེས་རྟོགས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཐ་མི་དད་པར་ཡོད་པ་མ་ཡིན་པ་དེ་ལྟ་མོད་ཀྱི།",
    "སྤྱི་ཉིད་དུ་ཞེས་བྱ་བ་རང་གི་ངོ་བོར་མཐོང་བ་ལས་སྤྱི་ནི་མ་ཡིན་ཏེ།",
    "འདི་ཡང་ཞེས་བྱ་བའི་དོན་ནི་ཡང་གི་སྒྲའོ།",
    "གལ་ཏེ་ཡང་བ་ལང་ཉིད་རང་གིས་གསལ་བ་རྣམས་ལས་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཡང་།",
    "རྟའི་གསལ་བ་རྣམས་ལས་ལྡོག་པ་ནི་བརྗོད་བྱ་ཁོ་ན་ཡིན་པའི་ཕྱིར་བརྗོད་བྱ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་ཞིག་ཁ་ཅིག་ཏུ་བརྗོད་བྱའི་དབྱེ་བ་མཐོང་བ་རང་གི་གསལ་བ་ལ་གཞན་དུ་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རང་གི་གསལ་བ་ལ་བརྗོད་བྱ་མ་ཡིན་པ་ནི།",
    "དབྱེ་བས་དམིགས་པ་བ་ཁྲ་མོ་དང་།",
    "འགྲེལ་པར་ནི་རང་གི་ངོ་བོ་ཉིད་དང་།",
    "གལ་ཏེ་དེ་དག་གི་ནི་རི་བོང་གི་རྭ་ལ་སོགས་པ་རྣམས་ཀྱིའོ།",
    "སྤྱི་ལྟ་བུར་ཞེས་བྱ་བ་ནི་དངོས་པོའི་རང་གི་ངོ་བོ་རྟོགས་པ་ཡང་དོན་བྱེད་པ་དང་བྲལ་བ་ཉིད་ཀྱི་སྤྱི་ལྟ་བུའོ།",
    "རྟོགས་པ་ཐམས་ཅད་དོན་ལ་དམིགས་པ་ཉིད་དུ་བྱེ་བྲག་མེད་པའི་ཕྱིར་རོ་ཞེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཙོ་བོ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དངོས་པོ་མ་ཡིན་པ་ལ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཡང་དངོས་པོ་མ་ཡིན་པ་བརྗོད་བྱར་ཐལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་དེའི་ཕྱིར་དངོས་པོ་ཞེས་བྱ་བའོ།",
    "གང་གིས་དེ་དངོས་ཞེས་བྱ་བ་ནི་མེད་པའི་ཡུལ་ཅན་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མ་ཡིན་པ་ནི་རང་གི་ངོ་བོ་མ་ཡིན་པའོ།",
    "གཉི་གའི་ཐུན་མོང་ཡིན་ན་ཞེས་བྱ་བ་ནི།",
    "དེ་ཉིད་འདིའོ་ཞེས་བྱ་བའི་འདས་པ་དང་ད་ལྟར་བ་གཉི་ག་དེ་དང་ཐུན་མོང་པའོ།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡང་དེའི་བྱ་བ་ལས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཐ་དད་པ་ཐུན་མོང་བའི་ངོ་བོ་མེད་པར་བསྟན་པ་ནི།",
    "ཐལ་ཆེས་པས་འཁྲུལ་བའི་ཕྱིར།",
    "ཡོད་པ་དང་མེད་པའི་ཡུལ་ཉིད་ཀྱིས་དོན་སྣ་ཚོགས་པ་ནི་བ་ལང་གི་སྒྲ་བཞིན་དུ་གཙོ་བོ་ཁོ་ན་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ།",
    "གཉི་ག་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་བུམ་པའོ་ཞེས་འདས་པའམ།",
    "གང་གིས་ཐལ་ཆེས་པར་འགྱུར།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྣང་བ་ཉིད་དོན་དང་དོན་མ་ཡིན་པ་ལ་ཐུན་མོང་བ་ཡིན་གྱི།",
    "གཡོ་བ་ཡིན་ཏེ་སྔར་རྟོགས་པའི་རྒྱུན་ལྡོག་ཅིང་རྒྱུན་གཞན་ཡང་འདོད་པ་ལས་སྐྱེ་བར་བསྟན་པ་ནི་གལ་ཏེ་དེར་ནི་དངོས་པོ་དང་རེག་པས་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་ཡང་རྒྱུ་ལ་རང་གི་ངོ་བོ་འཛིན་པ་དང་བྲལ་བར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པས་དངོས་པོའི་རང་གི་ངོ་བོ་མཐོང་བ་ན།",
    "རང་གི་ངོ་བོ་འཛིན་པ་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོར་མ་མཐོང་བ་ཉིད་གཡོ་བ་ཡིན་པར་བསྟན་པ་ནི་རེག་བྱ་རེག་མ་ཡིན་ཞེས་བྱ་བའོ།",
    "མ་མཐོང་བས་ཁ་ཅིག་ལ་ཡང་རྗེས་སུ་དཔག་པ་ཉིད་ཡིན་ཏེ་འོག་གི་ཆ་ལ་དབུས་ཀྱི་ཆ་བཞིན་དུ་དངོས་པོ་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕྱི་རོལ་ལ་ལྟོས་པའི་དབྱེ་བ་ནི་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གིས་ཏེ།",
    "མངོན་སུམ་དང་དེའི་སྣང་བ་དག་གིས་ཡིན་གྱི།",
    "འཇིག་རྟེན་གྱི་གྲགས་པ་ལས་སོ་ཞེས་བསྟན་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གསལ་བ་མ་གཏོགས་པའི་འབའ་ཞིག་འཛིན་པ་ནི་སྤྱི་མ་ཡིན་པར་འགྱུར་ཡང་ཐ་མི་དད་པ་ལ་ནི་སྐྱོན་འདི་མ་ཡིན་པ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ནི་འོན་ཏེ་གསལ་པ་དེ་ཉིད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཐ་མི་དད་པར་རྟོགས་པར་མི་ནུས་པའི་ཕྱིར་དེ་ལ་རེག་པའི་རྟོག་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི།",
    "རང་གི་ངོ་བོ་ཉིད་ནི་རྗེས་སུ་འགྲོ་བའི་ངོ་བའོ།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་ཤེས་པའི་མངོན་སུམ་ཡིན་ནོ།",
    "རྗེས་སུ་སོང་བའི་རྣམ་པ་ཅན་གྱིས་ཤེས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའོ།",
    "འདི་ལྟར་སྔོན་པོ་ཞེས་བྱ་བ་བ་ཞིན་དུ་འདི་སྤྱིའོ་ཞེས་ཇི་ལྟར་སོར་མོས་སྟོན་པ་མ་ཡིན་ཞེས་བསྟན་པ་ནི།",
    "བག་ཆགས་ལས་བྱུང་བའི་རྗེས་སུ་སོང་བའི་ཤེས་པ་ནི།",
    "རྟ་ཉིད་ཁྲ་མོ་ལ་སོགས་པ་དང་འཕྲེལ་པ་མེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཁྱད་པར་དུ་བྱེད་པ་ནི་དེ་དག་ཅེས་བྱ་བའོ།",
    "ལན་ནི་དེ་དག་གི་ཞེས་བྱ་བའོ།",
    "ལོག་པ་དང་མ་ལོག་པའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་དངོས་པོའི་ངོ་བོ་ནི།",
    "དེ་ཉིད་དང་གཞན་ཉིད་དག་གིས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "རྟོག་པ་གཅིག་གི་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "སྤྱི་མ་ཡིན་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་དེ་འབྲས་ཡིན་ཞེ་ན་ཡང་ཞེས་བྱ་བའོ།",
    "དངོས་མེད་ནི་རང་བཞིན་མེད་པ་ཉིད་དེ་རི་བོང་གི་རྭ་བཞིན་དུ་འབྲས་བུ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངོ་བོ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བ་ཁྲ་མོ་ལ་སོགས་པའི་གསལ་བ་རྣམས་མཐའ་ཡས་པ་མ་ཡིན་ནམ།",
    "རིགས་གཅིག་མེད་ན་གཅིག་གི་སྒྲ་ངེས་པར་སྦྱོར་རོ།",
    "བ་ཁྲ་མོ་ལ་སོགས་པ་ལ་ངོ་བོ་གཅིག་མེད་ན།",
    "མིག་ལ་སོགས་པའི་ཤེས་པས་གཞན་དུ་མི་འཐད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལུགས་ཀྱི་ནི་དབྱེ་བ་ཞེས་བྱ་བ་ནི་གསུམ་མོ།",
    "གང་གི་ཕྱིར་གསལ་བ་རྣམས་ཉིད་ལ་རྣམ་པ་འགས་གཅིག་གི་བློར་འགྱུར་བ་དང་།",
    "རང་གི་ངོ་བོར་སྣང་བ་ཡང་རིགས་ལ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཕྱིའི་དོན་བྱེད་པ་ཡིན་པར་ལྟ་ཞོག་གི།",
    "དེ་ལས་བཟློག་པ་རང་གི་ངོ་བོར་སྣང་བའི་བརྗོད་བྱ་ཉིད་ནི་བརྗོད་བྱ་མ་ཡིན་པ་ཉིད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཅེས་བྱ་བ་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་རང་གི་མཚན་ཉིད་ཡིན་པར་བསྟན་པ་ནི།",
    "རང་གི་ངོ་བོ་ཉིད་ལ་མཚན་ཉིད་ཅེས་བྱ་བར་ནི་མི་རིགས་ཏེ།",
    "སྤྱིའི་མཚན་ཉིད་ལ་རང་གི་ངོ་བོ་མེད་པས་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "གང་ཞིག་རང་གི་གསལ་བ་རྣམས་ལ་ཁྱབ་པར་མི་བྱེད་པ་དེ་ནི་མཚན་ཉིད་མ་ཡིན་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ནི།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་དངོས་པོ་ལ་བརྟེན་པ་མ་ཡིན་ཏེ།",
    "མི་སྣང་བའི་ཕྱིར་ལ་སྣང་བཞིན་པ་ལ་ནི་འགྱུར་བ་དེ་ལྟ་ན་སྤྱིའི་དངོས་པོར་ཐལ་བར་འགྱུར་བ་མ་ཡིན་ན་མ་ཞེས་ཟེར་བ་ནི།",
    "རྣམ་པ་འགས་ཀྱང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཞེས་བྱ་བའི་རང་གི་མཚན་ཉིད་ཀྱི་དངོས་པོ་ཁས་བླངས་ནས་བཀོད་པ་ཡིན་ནོ།",
    "བརྒྱུད་པས་རང་གི་མཚན་ཉིད་ཀྱི་ངོ་བོ་དངོས་པོ་ལ་བརྟེན་པར་བསྟན་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི།",
    "རང་གི་མཚན་ཉིད་གཅིག་གཞལ་བྱ།",
    "དངོས་པོ་ལ་རང་གི་མཚན་ཉིད་སྣང་བའི་མངོན་སུམ་དང་།",
    "རྗེས་སུ་དཔག་པ་ལ་ཡང་རང་གི་མཚན་ཉིད་ཁོ་ན་རྣམ་པར་དཔྱོད་ཀྱི་སྤྱི་ཙམ་ནི་མ་ཡིན་ནོ།",
    "ཅི་ལས་ཤེ་ན་དོན་བྱ་དེ་ལས་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ལས་ཏེ་སྤྱིས་མཚོན་བཞིན་པའི་རང་གི་མཚན་ཉིད་ཡིན་ཏེ།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་ཡོད་པའམ་མེད་པ་ཉིད་དུ་རྗེས་སུ་དཔག་པས་དཔྱོད་པ་ཡིན་ཏེ།",
    "རང་གི་མཚན་ཉིད་ཡོད་པ་དང་མེད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པ་ཡང་རང་གི་མཚན་ཉིད་ཁོ་ན་སྟོན་པར་བྱེད་པ་ནི་གཞལ་བྱ་རྣམ་པ་གཉིས་སུ་མི་འགྱུར་བ་ཞེས་ཟེར་བ་ལ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ཀྱི་སྟེ།",
    "དེའི་ཕྱིར་འདི་ནི་དེའི་རང་དང་གཞན་གྱི་ངོ་བོ་དག་གིས་ཞེས་བྱ་བའི་དབྱེ་བའི་མཚན་ཉིད་ནི་མི་རུང་ངོ།",
    "དེ་དག་གིས་ཉེ་བར་མཚོན་པ་ནི་གཅིག་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཐའ་མེད་པ་ཉིད་ནི་དེ་ཉེ་བར་གནས་ཀྱང་དེ་ཉིད་ཀྱི་ནང་གི་དབྱེ་བ་ལས་སོ་ཞེས་བསྟན་པ་ནི།",
    "ལྟོས་པས་བྱས་པས་ཞེས་བྱ་བ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཚེ་མི་དམིགས་པའི་མེད་པ་ཡིན་ལ།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པ་མ་དམིགས་པ་ཞེས་བྱ་བའོ།",
    "ཐུག་པ་མེད་པར་འགྱུར་ལ་གང་གི་ཕྱིར་གང་ཁོ་ན་ལ་ཉེ་བར་གཞག་པ་མ་བྱས་པ་དེ་ཁོ་ན་ལ་མེད་པར་འགྱུར་རོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འགས་ཀྱང་ཞེས་བྱ་བ་ནི་རང་གིས་སམ་གཞན་གྱིས་མ་དམིགས་པའི་ངོ་བོ་སྟེ།",
    "རང་གི་ངོ་བོ་དམིགས་པ་མེད་ཀྱང་ངོ་ཞེས་བྱ་བ་སྟེ་སྣང་བ་དམིགས་པའོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་མཚན་ཉིད་དོན་དམ་པ་ཡིན་དུ་ཟིན་ཀྱང་རྗེས་སུ་དཔག་པའི་ཡུལ་དོན་དམ་པ་མ་ཡིན་པར་ཟེར་བ་ནི།",
    "ཡང་ན་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ཀྱང་དོན་དམ་པ་པ་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་དཀར་པོ་ནི་སེར་པོ་ཉིད་ཀྱིས་རྟོགས་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ།",
    "གལ་ཏེ་ཡང་རང་གི་རྣམ་པ་མཐོང་བ་ཐོབ་བྱ་ཉིད་དུ་སྒྲོ་འདོགས་པར་བྱེད་ལ།",
    "རང་གི་རྣམ་པ་མཐོང་ནས་སེམས་ལ་ཕྱི་རོལ་དུ་སྒྲོ་འདོགས་པར་མཐོང་བའི་ཕྱིར་འགལ་བ་མེད་དོ།",
    "དེ་ལ་ལྟོས་ནས་ཕྱི་རོལ་ལས་གཞན་པ་རང་གི་རྣམ་པ་མཐོང་བའི་ཕྱིར།",
    "མ་འོངས་པའི་ཐོབ་བྱ་ལ་རེག་པ་ཅན་ཡིན་གྱི་མངོན་སུམ་ནི་མ་ཡིན་ཏེ།",
    "རང་གི་ནུས་པ་འཛིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་གསལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གིས་ཤེས་ཕྱིར་དེ་ཤེས་ཡིན།",
    "ཞེས་བྱ་བའི་རིགས་པས་རང་གི་ངོ་བོ་ཉེ་བར་གནས་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ཐ་དད་པའི་རྟོག་པ་མེད་པའོ།",
    "རྗེས་སུ་དཔག་པ་ནི་རྒྱུ་གཞན་དང་ཐུན་མོང་བས་དེ་སྟོན་པར་བྱེད་ཅིང་དེ་ལས་ལྟོས་ནས་ཀྱང་སྤྱིའི་ཡུལ་ཅན་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ་མངོན་སུམ་གྱི་བྱ་བ་མི་དཔྱད་པར་རྣམ་པར་རྟོག་པ་ཙམ་ལ་དཔྱོད་པར་བྱེད་པ་ནི་གཉི་ག་ཡང་སྤྱིའི་ཡུལ་དུ་མཚུངས་སོ།",
    "བྱུང་བ་དང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་མངོན་སུམ་ནི་ཐམས་ཅད་ཀྱི་ཆ་ལ་གསལ་བའི་བྱ་བ་ཅན་ཡིན་པར་བསྟན་པ་ནི།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཕན་ཚུན་ཁྱད་པར་མེད་མོད་ཀྱི་ཞེས་བྱ་བ་ནི་གསེབ་ཀྱི་བུ་གའི་ཕྱོགས་ལ་གཉི་ག་ལ་ཡང་ནོར་བུ་མེད་པའི་ཕྱིར་རོ།",
    "སྔར་ཉམས་སུ་མྱོང་བའི་བག་ཆགས་ལས་བྱུང་བའི་རྗེས་སུ་དཔག་པ་ནི་དྲན་པ་ཡིན་ལ་ཇི་ལྟར་ཉམས་སུ་མྱོང་བ་ཁོ་ན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་འདོད་པ་བསྟན་པ་ནི།",
    "གལ་ཏེ་དེ་ལྟ་ན་རང་གི་ཕྱོགས་ཀྱི་རྩོད་པ་སྟེ།",
    "འཁྲུལ་པ་དད་མ་འཁྲུལ་པ་ཉིད་དུ་ཁོ་ནས་དེ་དག་གི་དབྱེ་བ་ཡིན་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་འཁྲུལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ཡང་བསྡུས་པའི་བདག་ཉིད་ཀྱི་སྡུད་པར་བྱེད་པའི་དག་གི་སྐྱོན་མ་ཡིན་ནོ།",
    "མངོན་སུམ་ཐམས་ཅད་ལ་ནི་ངེས་པ་འདྲེན་པའི་བྱ་བ་ཅན་རང་གི་ཡུལ་ལས་འདས་ནས་དེའི་ཡུལ་དུ་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་དོན་དམ་དུ་ནི་ཞེས་བྱ་བའོ།",
    "རེ་རེ་ནི་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ཉིད་མངོན་སུམ་མ་མ་ཞེས་བྱ་བ་ནི་རང་གི་འདོད་པའོ།",
    "འཁྲུལ་པ་ཉིད་དུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་དངོས་པོའི་ངོ་བོ་མཐོང་བ་དང་ལྐོག་ཏུ་གྱུར་པའི་ཡུལ་ཉིད་ཀྱང་འགལ་བ་ཅན་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "གལ་ཏེ་ལྐོག་ཏུ་གྱུར་པ་སྣད་བ་མ་ཡིན་པའི་ཡུལ་ཤེས་པ་གང་གི་ཡིན་པ་དེ་སྟེ།",
    "དངོས་པོ་ལ་རེག་པ་མ་ཡིན་པ་ཞེས་བྱ་བའོ།",
    "སྤྱི་སྣང་ཞིང་ཁྱད་པར་མི་སྣང་བ་ཡིན་ན་ཡུལ་ལྐོག་ཏུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གལ་ཏེ་རང་གི་ངོ་བོས་རྟོགས་པ་མ་ཡིན་པ་དེ་བཞིན་གྱིས་རྟོགས་བཞིན་པ་ཡང་ཡོད་དོ་ཞེས་ཅི་ལས་ཡིན།",
    "གཞན་ལས་རྟོགས་པ་ཡིན་ལ་ཐལ་ཆེས་པར་འགྱུར་བ་སེལ་བ་ཡིན་ཏེ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་དེའི་དོན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་ངོ་བོས་རྟོགས་པ་ཇི་ལྟ་བ་དེ་བཞིན་རང་གི་ངོ་བོ་དང་མ་འབྲེལ་བ་ལས་ཀྱང་མ་ཡིན་ནམ།",
    "ཇི་ལྟར་རང་གི་ངོ་བོ་རྗེས་སུ་དཔག་པས་རྟོགས་པ་མ་ཡིན་ཞེས་ཟེར་བ་ལ།",
    "དེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འབྲེལ་པ་འཛིན་པ་ལ་ལྟོས་པ་མེད་པར་ལུང་དང་དོན་གྱི་གོ་བ་ལ་སོགས་པ་ནི་རང་གི་ངོ་བོས་སམ།",
    "གཞན་དུ་ཡང་རང་གི་གོ་བྱེད་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གིས་དེའི་ཡུལ་ལ་གསུམ་པར་འགྱུར།",
    "དེ་བཞིན་དུ་རང་གི་མཚན་ཉིད་ཁོ་ན་གཅིག་མ་ཡིན་ན།",
    "དེ་ལ་རེ་ཞིག་རང་གི་མཚན་ཉིད་གཅིག་པོ་ཁོ་ན་སྤྱི་དང་ཁྱད་པར་རྟོགས་པའི་ཡུལ་ཡིན་པའི་ཕྱིར།",
    "རང་གི་མཚན་ཉིད་གཅིག་པོ་ཁོ་ན་རྣམ་པ་གཉིས་སུ་རྟོགས་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "དེ་རྗེས་སུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གལ་ཏེ་གང་གི་མེད་པ་འདི་ཡིན་པ་དེ་ནི་དེའི་ཁྱད་པར་ཅན་མངོན་སུམ་གྱི་ཡུལ་མ་ཡིན་ལ་འོ་ན་ཅི་ཞེ་ན།",
    "གཅིག་གི་རིགས་པ་ཁོ་ནའི་མི་སྣང་བ་ལ་ལྟོས་ནས་མི་རིགས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཁྱབ་པར་བྱེད་པ་ལ་སོགས་པ་འགལ་བ་མ་ཡིན་པ་ལ་འབྲས་བུ་འགལ་བ་མ་ཡིན་ཞིང་དེས་ཁྱབ་པ་ཡང་མ་ཡིན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྟགས་ལ་ལོག་པར་མཐོང་བ་གང་གི་ཡིན་པ་དེའི་འདི་ལྟ་བུའི་རྟགས་དང་རྟགས་མ་ཡིན་པ་མཚུངས་པར་བྱེད་པས་རྟགས་ལས་ངེས་པ་མེད་པ་ཡིན་གྱི།",
    "དེ་ཡང་རེ་ཞིག་ཚོགས་པ་གཅིག་པར་མཚུངས་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "ཐལ་ཆེས་པའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་ལ།",
    "གང་གི་ཕྱིར་དེ་ལ་ངེས་པ་ནི་དེའི་འབྲས་བུ་མ་ཡིན་པའམ་ཁྱབ་བྱ་མ་ཡིན་པ་མ་ཡིན་ཏེ།",
    "དེའི་ངོ་བོ་ཞེས་བྱ་བ་ནི་དེའི་རང་གི་ངོ་བོའོ།",
    "རང་གི་རྒྱུའམ་ངོ་བོ་དག་ཅེས་བྱ་བའོ།",
    "གལ་ཏེ་རེས་འགའ་རྒྱུའམ་རང་བཞིན་ཡིན་ཡང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་ངོ་བོའམ་ཞེས་བྱ་བའོ།",
    "རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་དག་གིས་རུང་བ་མ་ཡིན་པའི་མི་དམིགས་པ་དང་ལྡན་པ་ཉིད་ཀྱི་མེད་པར་ངེས་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་འདི་འབྲེལ་པ་ཅན་ཞེས་བྱ་བ་སྟེ།",
    "མཐོང་བ་ཙམ་ཁས་བླངས་ནས་ལྐོག་ཏུ་གྱུར་པ་གསལ་བར་བྱེད་ན་ཁས་བླངས་པའི་ཁྱིམ་དང་སྐྱེད་མོས་ཚལ་ལ་སོགས་པ་ཡང་ཡུལ་གཞན་དུ་སོང་བ་མི་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "དེ་མེད་པ་ནི་རང་གིས་ཁས་བླངས་པའི་ལྐོག་ཏུ་གྱུར་པ་དེ་ཡང་མེད་པར་འགྱུར་རོ།",
    "ཁྱིམ་དང་སྐྱེད་མོས་ཚལ་ལ་སོགས་པ་མ་མཐོང་བ་ནི་དེའི་ཚེ་མེད་བསམ་རིག་ན་མི་ལྟར་ཁྱད་པར་དུ་བྱེད་ཅེས་ཟེར་བ་ལ།"
  ]
}