    "རྒྱ་གར་གཞུང་གི་རྒྱབ་སྐྱོར་ཆ་ཚང་བྱེད་ཀྱི་ཡོད།",
    "ཕྱི་ལོ་༢༡༡ ལོར་གོང་ས་མཆོག་གི་བཀའ་སློབ།",
    "ཕྱི་ལོ་༢༡༡ ཕྱི་ཟླ་༣ ཚེས་༡༩ དང་བོད་ཟླ་༡རྭ་༤ཕྱི་ལོ་༢༡ ལོར་གོང་ས་མཆོག་གི་བཀའ་སློབ།",
    "དེ་ཡང་ཕྱོགས་གཅིག་ནས་བསམ་བློ་མང་པོ་བཏང་སྟེ་ཐག་བཅད་པ་ཞིག་རེད།",
    "རྒྱ་ཕྱོགས་ནས་རྒྱ་རིགས་མང་པོ་ཞིག་གིས་རྒྱབ་སྐྱོར་ཐོབ་རྒྱུ་འདི་དངོས་གནས་གནས་ཚུལ་རན་པའི་ཐབས་ཤེས་རེད་ཅེས་ཁ་གཅིག་གྲགས་ཀྱིས་བརྗོད་ཀྱི་འདུགདེར་བརྟེན་ང་ཚོའི་འདི་ཕྱོགས་ནས་རིགས་དགའ་ཤས་ཀྱིས་བོད་ནང་གཞིས་ལུས་རྒྱ་ཆེའི་མི་མང་གི་རང་བཙན་འདོད་ཀྱི་ཡོད་ཅེས་ཁའི་རྩེ་མོར་འཁྱེར་ཡོང་གི་འདུག་བསམ་བློ་གང་ཡང་མེད་མཁན་ཞིག་ལ་ཁྱེད་རང་ལ་རང་བཙན་དགོས་སམ།",
    "རང་བཙན་དགོས་ཞེས་བརྗོད་ཀྱི་རེད།",
    "སྲང་ལམ་གསེབ་ནས་ལམ་སེང་རང་བཙན་སྒྲུག་ཆོག་པ་ཞིག་ཡོད་ན་འགྲིག་གི་ཡོད་ཀྱང་དེ་མ་རེད།",
    "དེར་བརྟེན་དངོས་ཡོད་གནས་ཚུལ་རན་པའི་ཐོག་ཕྱོགས་ཡོང་ནས་བསམ་བློ་བཏང་སྟེ་ཐག་བཅད་པ་ཞིག་རེད་མ་གཏོགས་ལམ་ཕྱི་ལོ་༢༡ ལོར་གོང་ས་མཆོག་གི་བཀའ་སློབ།",
    "སང་སོ་སོའི་སེམས་ཀྱི་རེ་བ་དང་འདོད་པ་ཁོ་ནའི་ཐོག་ནས་ཡོང་རྒྱུ་ཁག་པོ་ཞེ་དྲག་རེད།",
    "དེ་དག་གིས་རྒྱབ་སྐྱོར་མེད་ན་ང་ཚོ་གཅིག་པུས་བྱེད་ཐུབ་ཀྱི་མ་རེད།",
    "འདི་ཕྱོགས་ནས་བསམ་བློ་མ་བཏང་བར་ཁ་ནས་བོད་རྒྱ་ཆེའི་མི་མང་གིས་རང་བཙན་འདོད་ཀྱི་ཡོད།",
    "ཤེས་སོང་ངམ་དེ་གཅིག་བརྗོད་འདོད་བྱུང་།",
    "ཞེས་བཀའ་སློབ་ཟབ་མོ་བསྩལ།",
    "ལས་མེད་པ་གྱུར་ཟིན་པ་རེད།",
    "བོད་ཀྱི་ས་ཁྱོན་བརྒྱ་ཆ་༥ལྷག་ཙམ་དེའི་ཕྱིར་རོལ་དུ་ཡོད་སྟབས་བོད་རིགས་ཡོངས་རྫོགས་གཅིག་སྒྲིལ་ཡོང་ཐབས་དཀའ་བ་རེད།",
    "དེང་སྐབས་འཛམ་གླིང་ནང་མི་རིགས་རྒྱལ་ཁབ་ཀྱི་ལྟ་གྲུབ་རིམ་གྱི་གུ་ཡངས་སུ་ཕྱིན་ནས་མཉམ་རུབ་བྱེད་བཞིན་པ་རེད།",
    "ང་ཚོ་བོད་མི་ས་ཡ་དྲུག་རང་མགོ་ཐོན་ལ་མ་ཐོན་བྱས་ནས་བཞུགས་པ་ལས་རྒྱ་མི་ས་ཡ་ཆིག་སྟོང་གསུམ་བརྒྱ་དང་མཉམ་དུ་བཞུགས་ན་ཁེ་ཕན་ཆེ་བ་ཡོང་གི་རེད།",
    "སྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ལ་བཏོན་པའི་རེ་འདུན་ནི།",
    "རོགས་རེ་བཅས་ཀྱི་འབྲེལ་བ་སྲུང་སྐྱོབ་དང་གོང་དུ་སྤེལ་རྒྱུ།",
    "རྒྱ་ནག་གི་དགག་བྱ།",
    "རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་ས་ཁྱོན་བཞི་ཆ་གཅིག་ཟིན་གྱི་ཡོད་ཅེས་བརྗོད་ཀྱི་ཡོད་པ་རེད།",
    "རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་ས་ཁྱོན་བཞི་ཆ་གཅིག་ཟིན་གྱི་ཡོད་པ་དངོས་བདེན་ཡིན་རུང་།",
    "དེ་ནི་ང་ཚོས་བཟོས་པ་མ་ཡིན་པར་གནའ་སྔ་མོ་ནས་བཟུང་དེ་ལྟར་རང་བཞིན་གྱི་བརྒྱུད་རིམ་ལ་བརྟེན་ནས་བྱུང་བ་ཞིག་ཡིན་སྟབས།",
    "བོད་དུ་མིའི་འགྲོ་བ་ཆགས་པ་ནས་བཟུང་འཚོ་སྡོད་བྱེད་མུས་རེད།",
    "ས་ཆའི་རྒྱ་ཁྱོན་གྱི་རྩོད་གཞི་མིན།",
    "བོད་ཀྱི་ས་ཆའི་རྒྱ་ཁྱོན་དེ་ཆེན་པོར་མངོན་སྲིད་ཀྱང་།",
    "ང་ཚོས་ཁ་བྲལ་མ་ཡིན་པར་རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་རང་༩༨རྒྱ་ནག་གི་དགག་བྱ།",
    "རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་ས་ཁྱོན་གྱི་དྲུག་ཆ་གཅིག་ཙམ་དང་།",
    "ལྷག་པར་དུ་ང་ཚོས་བྱུང་རབས་ལ་གཞི་བཅོལ་ནས་དགོས་འདུན་འདོན་གྱི་མེད།",
    "ང་ཚོའི་དགོས་འདུན་གྱི་གཞི་རྩ་འཇོག་ཡུལ་ནི་མར་ཁེ་སེ་དང་།",
    "ས་ཆ་འཕར་སྣོན་དགོས་པའི་རེ་འདུན་འདོན་གྱི་མེད།",
    "ལྷག་པར་དུ་རྒྱ་ནག་གི་ས་ཁྱོན་ཆིག་སྒྲིལ་ལ་དེ་བས་ཀྱང་ཁྱད་པར་མི་འགྲོ།",
    "བོད་རིགས་ཡོངས་རྫོགས་གཅིག་གྱུར་བྱེད་རྒྱུའི་བསམ་ཚུལ་དེ་འོས་ཤིང་འཚམས་པ་ཞིག་རེད།",
    "ཕྱི་ལོ་༡༩༥༡ ཟླ་༩ ཚེས་༢༩ ཉིན་བོད་གཞུང་བཀའ་ཤག་གིས་རྒྱ་དཔོན་ཀྲང་ཅི་ཨུ་ལ་",
    "བོད་དུ་གཡོན་ཐལ་རིང་ལུགས་པའི་བྱ་སྤྱོད་ཐོན་པར་བརྟེན་ལས་དོན་བྱེད་མ་ཐུབ།",
    "མཐུན་པ་རྒྱ་ཆེའི་བོད་མིའི་བསམ་ཚུལ་དང་མཐུན་པ་ཞིག་ཀྱང་རེད།",
    "ལོག་སྤྱོད་ཀྱི་གནས་ཚུལ་གང་ཡང་མ་རེད་ཅེས་བཀའ་གནང་ཡོད་པ་རེད།",
    "ཆབ་སྲིད་ཀྱི་ཆོད་སེམས་ཡོད་པ་ཙམ་གྱི་བསྒྲུབ་ཐུབ་ཀྱི་རེད།",
    "ཆ་ཚང་བ་ཞིག་རྟོགས་ཐུབ་ཀྱི་མ་རེད།",
    "རྡོག་དེ་གང་རེད་ཅེ་ན།",
    "དེའི་ནང་ལ་ཡོད་པ་དེ་ཚོ་སྣེ་ཁ་གཅིག་མེད་ན་འགྲིག་གི་འདུག་ཅེས་ཀྱང་བརྗོད་མེད།",
    "རྒྱ་ནག་ནང་གི་གནས་ཚུལ་ཡོངས་ལ་ཐུགས་ཞིབ་དགོངས་བཞེས་གཏིང་ཟབ་དང་འབྲེལ།",
    "ཕྱི་ལོ་༡༩༧༩ ལོར་སྐབས་དེའི་རྒྱ་ནག་གི་ཆེས་མཐོའི་དབུ་འཁྲིད་ཏེང་ཞའོ་ཕིང་",
    "གིས་བོད་རང་བཙན་མ་གསུང་ན་དེ་མིན་བཀའ་མོལ་ག་རེ་གནང་ན་ཡང་མི་སྒྲིག་པ་ཡོང་གི་མ་རེད་གསུང་ནས་བོད་རྒྱ་འབྲེལ་མོལ་གྱི་གྲོས་འཆར་གཏོན་ནས་ཕྱི་ལོ་༡༩༨༢ དང་༡༩༨༣ ལོ་སོ་སོར་རང་རེས་སྐུ་ཚབ་རྒྱ་ནག་དུ་ཕེབས་སྐབས་བཀའ་ལན་གནང་བདེའི་གོ་སྒྲིག་སྔོན་ཡོད་ལ་བརྟེན་འཕྲལ་དུ་འབྲེལ་མོལ་འགོ་ཚུགས་ཐུབ་པ་བྱུང་ཞིང་།",
    "བོད་ནང་གི་གནས་ཚུལ་ད་དུང་ཇེ་ཞན་ཇི་སྡུག་ཏུ་ཕྱིན་ཏེ།",
