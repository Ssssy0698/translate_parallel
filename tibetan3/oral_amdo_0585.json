    "དམར་ནག་རཀྟ་ལ་ཕེབས་ལམ་དུ་ཚེ་ཆུ་ངོ་མཚར་བ་ཞིག་གཟིགས།",
    "ཞིང་སྐྱོང་གི་ལྕགས་ཞྭ་སོགས་རྟེན་རྣམས་ཞིབ་མོར་གཟིགས་རྗེས།",
    "སང་དེ་ཡུལ་སྟོད་ཀྱི་གཙང་པ་སྤང་མོར་ཕེབས།",
    "ཞལ་གཟིགས་ངོ་མཚར་བ་མང་པོ་ཕྱིས་ཀྱིགདུལ་བྱ་རྣམས་ཀྱིས་ཀྱང་མཐོང་བའི་སྐལ་བ་ཅན་དུ་བྱིན་གྱིས་བརླབས་སོ།",
    "ར་བས་རི་མོར་བགྱིས་སོ།",
    "གཞན་གསུང་བསྔོ་ཞུ་རྟེན་དུ་ཕུལ་བའི་གཡུ་སྤུས་གཙང་ཁོ་ན་རྩེས་སྲང་གི་ཉག་ལྔ་སོང་བ་དང་།",
    "ཡོལ་བ་བླ་རེ།",
    "གཙུག་ལག་ཁང་རྒྱ་ཁྱོན་ཆེས་པས་ཞིག་གསོས་མང་བར་དགོས་འདུག་པའི་ཞལ་ཏ་གནང་ནས་དཔོན་སློབ་ཉུང་ཤས་ཀྱིས་ལྕང་ལོ་ཅན་དང་མི་གཉིས་པའི་སྒྲུབ་ཕུགཚེ་ཀོང་དུ་སྐུ་མཚམས་བཅད་རྒྱར་བཞུགས།",
    "གྲལ་འཕྲོས་ཀྱང་ཐོག་མར་དྲུང་པ་རང་གིས་རྒྱལ་བ་ཉིད་ལ་ཞུས།",
    "སྐུ་འབུམ་ཆེན་མོར་ཞིག་གསོས་མཛད་འདུག་པ་ལེགས་པར་གྲུབ་པའི་རབ་ཏུ་གནས་པ་གནང་བར་དའ་སློགགཉིས་ཀ་ཕེབས།",
    "ཙ་རིའི་དག་པ་ཤྲཱི་ན་བུན་གྱི་གསེབ་ནས་ཟེའུ་ལྷ་ཁང་གི་སྣ་དབྱེ་བ་ལྟར་སྒྲིབ་མེད་དུ་སྐུ་འཁོར་ན་ཡོད་པ་རྣམས་ཀྱིས་ཀྱང་མཇལ་ཞིང་།",
    "རྗེ་ཉིད་ཀྱིས་རང་བྱུང་གི་མཆོད་རྟེན་ལྷ་ཉིས་སྟོང་བརྒྱད་བརྒྱ་དང་བཅས་པ་ལེགས་པར་གཟིགས་པར་འདུག།",
    "བྱ་པའི་ཞབས་དྲུང་ཁྲི་པ་ལྕམ་སྲིང་གི་རྟེན་བཞེངས་སུ།",
    "ཞག་གསུམ་རྣམ་དབྱེ་སོགས་ཀྱི་རི་མོའི་ཕྱག་ཁྲིད་དགོས་ཚུལ་བཞིན་བཞེད་པ་བསྐང་།",
    "ཀ་ལཱ་པའི་རི་མོ་ཕུལ་ཕྱིན་གནང་ཐུབ་འདུག་ནའང་རྣམ་དབྱེའི་མཐའ་པུཨོ་དང་།",
    "ཁ་སྐོང་ཨཱཎ་སོགས་ལ་དོགས་གནས་འགའ་རེ་འཁྲུངས་འདུག་པ།",
    "མའི་སྒོ་མྱོས་རབ་ཏུ་གནས་པ་རྒྱས་པའི་སྦྱིན་སྲེག་གི་ཁ་ང་དང་བཅས་པ་མཛད།",
    "དེ་ནས་རྒྱལ་ཡུམ་མཆོག་གིས་འཕྱོང་རྒྱས་གྲོང་གསར་དུ་སྤྱན་དྲངས་པ་ལྟར་རིམ་གྱིས་ཆིབས་ཁ་བསྒྱུར་བའི་རྡོ་རྗེ་གདན་དུ་ཕེབས་ཐོག་སྐུ་ལ་མི་པི་བཞེས་པར་བརྟེན།",
    "རབ་བྱུང་སྟེ་མེ་མོ་ཡོས་ལོ་གཟིམས་དཔོན་ཆེན་མོ་དགེ་སློང་པས་ཞབས་ཏོག་ཞུས།",
    "ངེད་རང་གི་ཚེ་སྔོན་གྱི་ལས་ལས་གྲུབ་པའི་དགོངས་པ་ཅན་དང་དགོངས་མིན་གྱི་གསུང་སྣ་ཚོགསཔ་མ་གཏོགས་མཐའ་གཅིག་ཏུ་ངེས་པ་རང་ཨེ་ཡོད་ཀྱང་མི་ཤེས་པས།",
    "ད་ལམ་འདི་སྐོར་ལ་ངེད་རང་ཚོས་མིབཏང་ཡང་ཅི་བྱེད་ལས་མི་འདུག།",
    "སྐྱེས་བུ་དམ་པའི་བཀའ་རང་འདོད་དང་ཕྱོགས་ལྷུང་གི་དྲི་མས་མ་གོས་པ་ལ་ཐུགས་མགུ་ཡང་།",
    "ལྷོ་བྲག་གི་བྲེལ་བ་གང་རྩོལ་བཅད་ནས་ཡོང་རྩིས་ལ།",
    "གཡུ་ལེགས་པ་གཅིག་གིས་གཙོས་པའི་གནང་ཆ་བཟང་བ་དང་བཅས་མཇལ་འཛོམ་ཤིན་ཏུ་ཐུགས་ནང་གཙང་བ་བྱུང་དུས་ཕེབས་སྒོ་ལ།",
    "དེ་ནས་གསུང་གི་ཐ་མ།",
    "དེ་ནས་མི་འགྱང་བར་གཞན་སྨོ་ལ་དགོངས་པ་ཞིག་བྱུང་སོང་།",
    "རྗེ་བསྟན་པའི་ཉི་མའི་སྐུ་ཚའི་སྨད་ལ་ཐུགས་སྣང་དག་ཏུ་སོང་བ་མ་གཏོགས།",
    "ཕྱིས་འགལ་རྐྱེན་མང་ཞིང་མཐུན་རྐྱེན་དཀོན་གཞིས་བསྟན་པའི་གེགས་འདི་འདྲ་ཞིག་བྱུང་སོང་།",
    "སྒྲ་ཙནྡྲ་པའི་རི་མོ་འདི་ད།",
    "ཁྱོད་ཀྱི་ཤེས་རབ་དང་འདུན་པས་ལྕོགས་པ་ཙམ་ཡོང་ཤས་ཁ་བས་ཅིས་ཀྱང་སློབས་ཤིག་གསུངས།",
    "ཚུར་མཐོང་གིསྐྱེ་བོ་དག་ཀྱང་དད་པའི་སྤུ་ལོང་གཡོ་ཞིང་ཡིད་ཆེས་ཀྱི་མཆི་མ་འཁྲུགཔ་དེ་ལྟ་ན།",
    "ཞབས་འབྲིང་ན་གསོད་པའི་གང་ཟག་དམ་པ་རྣམས་ལ་ངོ་མཚར་གྱི་ལྟད་མོ་ཆི་ཡང་ཡོད་པར་མངོན་ཞིང་།",
    "གསང་གླིང་རྩེའི་གཟིམས་སྤྱིལ་ཁྱབ་གདལ་ཆེན་མོར་བཅད་རྒྱ་སྐུ་ལོ་མཚམས་ཀྱི་ངེས་པ་ལ་བཞུགས།",
    "དེ་ནས་བྱར་སྨད་བེའུ་ཁ་དང་བྱར་པོ་ནགས་དགོན་སོགསཀྱི་གནས་གཟིགས་ལ་ཕེབས་ནོར་གསང་གླིང་དུའང་གདན་དྲངས།",
    "ཕལ་ཆེར་གྱིས་བརྙས་བཅོས་བྱེད་པ་ཞིག་འདུག་མོད་ཀྱང་།",
    "གནས་ལུགས་རང་མཚང་རིག་པའི་རེ་བ་ཟད།",
    "འཁོར་སློབ་ཕལ་ཆེར་བན་མ་ཧོར་འདྲར་སོང་།",
    "ཆགས་སྡང་ཉོན་མོངས་སྤོང་བ་ཞེ་དམ་ཡིན།",
    "ཤ་བ་ཡུ་མོའི་མཇུག་མ་མང་མཐོང་རུང་།",
    "རང་དོན་རང་གིས་སྒྲུབ་པ་ཞེ་དམ་ཡིན།",
    "གཞན་མར་བལྟ་བའི་མིག་དང་ལྡན་མོད་ཀྱང་།",
    "ཞེས་སྙིགས་མའི་སྣང་ཚུལ་མང་དུ་མཐོང་བའི་རྐྱེན་གྱིས་ཁྱབ་གདལ་འ་མོར་ཐུན་གསེང་ལ་རེག་ཟིག་བགྱིས་པའོ།",
    "འདི་ཉིད་ཀྱིས་བསྐལ་ངོར་གནས་བརྟན་བཅུ་དྲུག་གི་རྗེས་གནང་ཆོ་ག་རྙིང་པ་ཞིག་འདུག་པ་དེ་ལ་གཞི་མཛད་ནས་གསུང་རྩོམ་གནང་།",
    "ལས་རིམ་རྒྱས་པ་དང་འབྲེལ་བའི་འཆམ་གྱི་གཟིགས་མོ་ཕུལ་ཚ་དགྱེས་པའི་འཛུམ་ཞལ་ཀུནྡའི་གེ་སར་ལྟར་ཕྱེ་ར་། བར་གྱུར་ཏོ།",
    "གྲྭ་ཚང་པར་གནས་བརྟན་བཅུ་དྲུག་གི་རྗེས་གནང་།",
    "བྲག་ལར་ཕེབས་དུས་སྲིད་པའི་ལྷ་ཆེན་ཡར་ལྷ་ཤམ་པོས་རྣམ་མཁའ་གདུགས་འཇམ་ཞིང་བཀྲ་ཤིས་པའི་རྟགས་ཀྱི་རེ་ཁཱས་མཚན་པའི་འཇའ་སྤྲིན་སོགས་ངོ་མཚར་སྤྱོ་བཀུར་སྟི་ཅི་ཡང་བསྒྲབས།",
    "ཉིན་རེ་བཞིན་ཇོ་མཇལ་ལ་ཕེབས།",
    "རྒྱལ་ཀུན་ཐུགས་རྗེའི་སྤྱི་གཟུགས་འཕགས་མཆོག་གི།",
    "ཁྱོད་ཞབས་པདྨོ་བསྙེན་དང་མི་འབྲལ་ཞིང་།",
    "བདག་གིས་བགྱིས་དང་བགྱིད་འགྱུར་བགྱིད་པ་ཡི།",
    "བདག་ཅག་ལྷག་བསམ་བཟང་པོའི་བདེན་ཚིག་གིས།",
    "འཕྲིན་ལས་བཅོལ་བ་མངའ་གསོལ་གྱི་སྤྱན་གཟིགས་སོགས་སྩལ།",
    "དེ་རེས་ལྷ་སར་ཟླ་བ་ལྷག་ཙམ་བཞུགས།",
    "དཀོན་གཉེར་སྒུག་དགོས་པ་འདྲ་ཞུ་བར་ཇོ་འོ་ཤཱཀྱ་མུ་སྣའི་ལྷ་ཁང་གི་ལྕགས་དྲྭ་རང་བྱེ་ལ་སོང་ནས་ཐོགས་མེད་ཕེབས་ཆོག་པའང་བྱུང་ངོ།",
    "སྤྲུལ་པའི་སྐུ་རྣམ་གཉིས་ལ་སྒེར་བྱེ་དཔལ་ལྡན་ལྷ་མོའི་རྗེས་གནང་དང་།",
    "དེ་རེས་ཟླ་བ་གཉིས་ཙམ་བཞུགས།",
    "དེ་རེས་དཔལ་བསམ་ཡས་ར་། ཁྱེ་གཙུག་ལག་ཁང་ཆེན་པོ་མཇལ་བར་ཕེབས།",
    "དབུ་རྩེ་ཆེན་མོས་གཅོས་པའི་གཙུག་ལག་ཁང་རྣམས་དང་།",
    "མཆོད་ཁང་ཆེན་མོ།",
    "མ་ཎིའི་བཟླས་ལུང་སོགས་ཞུ་མི་གྲངས་མེད་པ་ཉིན་རེ་བཞིན་ལྷགས།",
    "ངེད་ཀྱི་ཚེ་ཕྱི་མའི་རེ་ས་རྗེ་ཉིད་དང་།",
    "ལས་རིམ་དང་འབྲེལ་བའི་གར་འཆམ་གྱི་གཟིགས་མོ་དང་བཀུར་སྙི་ཁྱད་པར་ཅན་བསྔགས་པར་འོས་པ་གྲུབ་རྗེས།",
    "མཆོད་ཡོན་ལྷན་རྒྱས་ཤེལ་བྲག་གི་གནས་གཟིགས་ལ་ཕེབས།",
