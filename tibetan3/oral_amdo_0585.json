    "སྤྲལ་པའི་སྐྱེས་མཆོག་ཆེན་པོ་གསུམ་ཡང་བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོ་སྒྲུབ་པར་གསོལ་བའི་བཞེད་དོན་བཞིན།",
    "ཨེ་བ་ལང་གཟིམས་ཁང་པའི་ལག་ཏུ་བཞུགས་པའི་ཐུགས་རྗེ་ཆེན་པོ་རྗེ་རྒྱ་རས་ཀྱི་སྐུ་ཚིགས་ལ་ཕེབས་པ་དེ་ལ་ཙནྡན་ལས་གྲུབ་པའི་བཞུགས་ཁང་རེག་པ་མེད་པའི་མཆོད་རྟེན་གྱི་དབྱིབས་ཅན་ལྗགས་བཀོད་མ་དང་།",
    "རྒྱལ་བ་ཉིད་རེ་ཞིག་སྐུ་མཚམས་ལ་བཞུགས།",
    "ལྡོ་རོང་གི་ཕེབས་ལམ་བགྲོད་དཀའ་བ་རྣམས་སུ་གཞི་བདག་མི་མ་ཡིན་རྣམས་ཀྱིས་བཀུར་སྟི་བསྒྲུབས།",
    "གནས་འདིའི་སྲུང་མ་སྨྱོན་ཁ་དང་དུར་ཁྲོད་བདག་མོའི་བསྐང་བ་རྣམས་གསུང་རྩོམ་གནང་།",
    "ཧོར་བྱ་རིག་ཚང་གི་འབུལ་བ་དང་སྡིག་སློང་གི་དམ་བཅའ་བཞེས།",
    "བླ་བྲེ་ཤིན་ཏུ་ཆེ་བ་ཞིག་གི་རྟེན་དང་བཅས།",
    "དེ་ཉིན་མེ་ཏོག་གི་ཆར་ཆེན་པོ་བབས།",
    "རབ་ཐོན་འཕྲལ་ཆུ་ནག་པོ་གནམ་ལ་འཕྱོ་བ་བཞིན་རྒྱས་ནས་ཕར་མཆོངས་ཚུར་མཆོངས་ལ་སོང་བས་ལྷ་ཆེན་ཐང་ལྷས་བཀུར་སྟི་སྒྲུབ་པར་འདུག་ཅེས་ཐམས་ཅད་ཡིད་ཆེས་ཀྱི་དད་པའི་མེ་ཏོག་འཐོར་བར་གྱུར།",
    "སྐྱེས་བུ་དམ་པ་རྣམས་གང་འདུལ་གཟུགས་སྐའི་བཀོད་པ་ཆུ་ནང་གི་ཟླ་བ་བཞིན་སྟོན་པར་གསུངས་པ་ལྟར།",
    "ཞུ་ཡིག་གཟིགས་རྟེན་བཀྲ་ཤིས་པའི་ལྷ་རྫས་དང་བཅས་ཞེས་གུས་འདུད་ཀྱི་གདན་འདྲེན་འགྲོར།",
    "བཀྲ་ཤིས་ཁ་བཏགས་ཟུང་འབྲེལ་རེའི་ཕྱག་མཇལ་བྱས་གནས་ལྔ་ས་ལ་གཏུགས་པའི་ཕྱག་བགྱིས།",
    "དེ་རྙིར་ཤིན་ཏུ་མི་བསྲུན་པའི་ཀླ་ཀློའི་དཔུང་གོ་། ཚོགས་སྟོབས་ཪྴ་པོ་དང་ལྡན་པའང་གསུང་ཐེངས་གཅིག་གིས་གཡུལ་ངོ་ལྗོགས་པའི་རྫུ་འཕྲལ་བསྟན་ནས་བོད་ཁམས་ཀྱི་སྐྱེ་འགྲོ་ཐམས་ཅད་བདེ་བ་ལ་འགོད་པའི་བཀའ་དྲིན་སྩལ་བ་ཡིན་ནོ།",
    "སོག་པོའི་རིགས་ཀྱི་མི་གདུག་རྩུབ་ཅན་འདི་རྣམས་ཀྱང་གདུལ་བྱར་གཟིགས་པའི་ཆིབས་ཀྱི་ཁ་ལོ་བྱང་དུ་བསྒྱུར་བ་ཞུ་ཞེས་གསོལ་ནས།",
    "སོག་ཡིག་དང་བོད་ཡིག་གི་རྒྱལ་པོ་དཔལ་གྱི་འབུལ་བ་ཞེས་པ་དང་།",
    "ཉིན་ཁྲི་མཚན་ཁྲི་འདྲེན་པའི་དམ་བཅའ་འབུལ་མཁན་ཡང་སོག་པོ་སྟོང་ཚོ་ཟིན་པ་བྱུང་།",
    "ཁྲོམ་ལ་སྤྱན་རས་གཟིགས་ཀྱི་སྒོམ་ལུང་བདའ་འབྲེལ་དུ་སྩལ།",
    "འོན་ཀྱང་ཁྱོད་ས་ཐག་རིང་པོ་ནས་འོངས་པ་ཡིན་པས།",
    "འབབ་རོང་གི་གདན་ས་འདི་ལ་ཐུགས་རྗེས་འཛིན་པ་ཞུ་ཞེས་པའི་ཞུ་བའང་གསོལ།",
    "གྲྭ་ཚང་གིས་གཙུག་ལག་ཁང་གསར་པར་སྤྱན་དྲངས།",
    "དེ་ཐོག་བསམ་ཡས་སུ་མཆོད་འབུལ་གྱི་མི་སྣར་ཆེ་ཆེན་ནང་སོ་རྟ་པ་མང་པོ་དང་བཅས་དངུལ་གྱི་མཎྜལ་ཤིན་ཏུ་ཆེ་བ་རྔ་མོང་གི་རྒྱབ་ལོངས་གཅིག།",
    "རིས་མེད་འགྲོ་ལ་བྱམས་ར་། བརྩེས་བརླན་པའི་ཐུགས་རྗེའི་ཆ་རྫོགས་སྤྱན་རས་གཟིགས།",
    "རང་རང་གི་བསྟན་པ་འདི་ལའང་དུས་དང་བསྟུན་པས་སྦྱིན་བདག་གི་ཤེད་མོང་ལ་བརྟེན་པ་ཞིག་མ་བྱུང་ན།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་འདུལ།",
    "ད་ལམ་གྱི་གྲོས་ཐག་དེ་ངེད་རང་གིས་ཆོད་པས་དེ་མི་བྱེད།",
    "ཁྲ་འབྲུག་གི་གནས་གཟིགས་གནང་།",
    "རེ་ཞིག་འདི་ཕྱོགས་སུ་འོད་འཇགས་པ་ཡོང་བས་ལོ་གསུམ་གྱི་རིང་ཐུགས་ཁུར་བཞེས།",
    "ཞེས་གསུངས་པས་རང་རང་གི་བསམ་པ་དགེ་མི་དགེའི་ལས་འབྲས་ཆེ་ཆུང་སོ་སོར་སྨིན་ར་། པ་ཡིན་མོད།",
    "ད་བར་ནི་བསྟན་པའི་ཁུར་ཟེར་བ་འདིས་རྣམ་གཡེང་འབའ་ཞིག་ལ་སོང་།",
    "ང་ཡང་ད་ལམ་རེས་ཀྱི་བྲེལ་བ་དེ་ཙམ་ལ་ཆ་བཞག་གཟིམས་སྤྱིལ་འདི་ཁར་བཅད་རྒྱ་དམ་པ་ཞིག་བྱེད།",
    "བསྔོ་སྨོན་ཐུགས་རྗེའི་སྐྱབས་འཇུག་ཉིན་རེ་བཞིན་མཛད།",
    "ཡང་རྩེར་ཞབས་དྲུང་བདག་མོས་བཀུར་སྟི་ཕུལ་དུ་ཕྱིན་པ་ཞུས།",
    "ཁྲོ་ཕུ་གྲྭ་ཚང་གི་སློབ་དཔོན་དུ་བསྐོ་བཞག་མཛད་པའི་བསྐོ་འཇའ་ཞུ་བར་ཞབས་དྲུང་དུ་འབྱོར།",
    "ཁོང་གིས་དང་དོད་ཆེན་པོ་བྱས་སོང་སྟེ།",
    "ཨའུ་རྩི་རྗེས་སུ་གནང་བ་ཡིན་མོད་གསུངས།",
    "དཔོན་སློབ་གསུང་འཕྲོས་བྱུང་བ་ཡིན་འདུག་པས་ཁོང་གིས་དོ་སྡོམ་མཛད།",
    "རྒྱལ་བ་མཆོག་གི་དགོངས་པ་ལ་གཏད་འདུག་པས་ཁྱོད་ཀྱིས་ཅིས་ཀྱང་སྒྲིགས་ཤིག་གསུངས་པ་བྱུང་ནའང་།",
    "དུས་ངན་གྱི་དམོད་པ་དྲག་པོ་དུས་མཐའི་མེ་ལྟར་འབར་བས་རིང་དུ་གཟིར་ནས་འགྱངས་གཞིར་སོང་བའི་ཁར།",
    "འདི་ལ་བར་ཆད་དུ་སོང་ན་དགྲལ་བ་མནར་མེད་དུ་འགྲོ་བ་ཡིན་པས་ཐམསཅད་ཀྱི་ཁུར་དང་བསམ་པ་ཆེ་དགོས་གསུངས།",
    "རྒྱལ་བ་ཉིད་རེ་ཞིག་སྐུ་མཚམས་ལ་བཞུགས།",
    "ཞུས་དག་དབུ་ལུང་པ་སོགས་ལས་ཚན་རྣམས་ལ་གཟན་རེས་གཙོས་པའི་རྣམ་གཞག།",
    "བྱ་པའི་ཞབས་དྲུང་བདག་མོས་འདི་སྐབས་ཀྱང་ཞབས་ཏོག་ཏུ་འགྱུར་བ་བྱུང་བས་གནང་ཆ་དགུ་ཚན་བདུན།",
    "བཅད་ཁྲ་སོ་སོར་དམ་ཕྲུག་གིས་གནོན་པ་གནང་།",
    "དེ་ནས་གཟའ་སྐར་ལེགས་པ་དང་བསྟན་བྱམས་ཆེན་གྱི་ཀུན་དགའ་ར་བར་སྤྱན་གཟིགས་སོགས་བཀོད་པའི་ཁྱད་པར་ཅི་ཡང་བཤམས།",
    "ས་ཆོག་གི་ཉིན་སྐུ་གཞོགས་གྲྭ་ཚང་པས་མགོ་བརྙན་སྔགས་འཆམ་སོགས་དང་།",
    "ལོངས་སྐུའི་ཆས་སུ་བཞེངས་ནས་ཁ་སྐོང་གི་སྦྱིན་སྲེག་དང་ཁྲོམ་ལ་ཚེ་བལཁ་སྩལ།",
    "དེ་ཉིན་གདུགས་འཇམ་ཞིང་ནམ་མཁའ་འཇའ་འོད་ཀྱིས་ཁྱབ་པ་མེ་ཏོག་གི་ཆར་འབབ་པ་སོགས་ངོ་མཚར་བའི་ལྟས་ནི་བསམ་གྱིས་མི་ཁྱབ།",
    "ཕྱག་མཛོད་ཆེན་མོའི་སྟེང་དུ་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་རུ་མཚོན་དང་རྒྱལ་མཚན་འཕན་གདུགས།",
    "གསེར་ཞོ་བརྒྱ་ཕྲག་གིས་གཙོས་པའི་འབུལ་ཆེན་མཛད།",
    "ཐམས་ཅད་མོས་པས་གསོལ་བ་འདེབས་ཤིང་།",
    "མར་མི་ཡབ་སྲས་ཀྱི་གདམས་ངག་ཟབ་མོ་མཁའ་འགྲོའི་ཁ་རླངས་མ་ཡལ་བ་རྣམས་ཐུགས་ཉམས་སུ་བཞེས་པས་བཔོཁ་ཕྱག་ཆུ་བོ་གཉིས་འདྲེས་ཞེས་གྲགས་ཤིང་།",
    "བོང་བུས་གཟིག་ལྤགས་རྒྱན་པའི་དཔེ་བཞིན་མི་མ་རུངས་པ་འགའ་ཞིག་གིས་ཆ་ལུགས་དེར་བསྒྱུར་ནས་སྤྱོད་ངན་སྣ་ཚོགས་བྱས་པ་དང་།",
    "རྩེ་མོ་རི།",
    "མོན་གྲབ་དང་ཤ་འུག་སྟག་སྒོར་ཕེབས།",
    "མཚོ་སྣར་གནས་པོ་ཞིག་ལ་སྒམ་པོ་ཞབས་དྲུང་ནོར་བུ་རྒྱན་པའི་སྐུ་སྐྱེ་ཡིན་ཟེར་བ་ཞིག་འདུག་པར་གཟིགས་རྟོག་གནང་།",
    "རིན་སྡིངས་གྲྭ་ཚང་པར་མང་ཇའི་ཐོག་རྒྱ་སྦུག་ལེགས་པ་ཞིག་གིས་གཙོས་གནང་ཆ་གྱ་ནོམ་པ་མཛད།",
    "གཙང་དཔུང་ལྷོར་བཅུག་འདུག་དུས་དམག་དཔོན་སྒོག་ལུང་པར་ཐལ་ཆ་མེད་ངོས་ལུགས་ལེགས་ཡོང་བའི་ཐུགས་བསམ་ཆེ་དགོས་ཚུལ་སོགས་བ།",
    "ད་ལམ་ལྷོའི་དམག་འདི་ལ་ཐལ་སོང་ཆེན་པོ་རང་མི་ཡོང་བ་འདུག།",
    "མདང་ངོས་ཀྱི་རྨི་ལམ་ན་ཁྱི་དམར་པོ་གཅིག་དང་སྤྱང་ཀི་གཅིག་འཛིངས་གྲབས་ལ་སོ་སོར་གྱེས་སོང་།",
    "ངེད་རང་གི་ཆ་ནས།",
    "ལར་རང་ཚིག་སྐམ་པོའི་ཕར་ལབ་ཚུར་ལབ་འདི་ལ་ཨ་འཐས་ཀྱི་ཕྱོགས་སྔ་ཀུན་སློང་བཅོས་པ་འདི་རང་གིས་ལན་པ་ཡིན་འདུག་གསུངས།",
    "ཐུན་མོང་མ་ཡིན་པའི་འཕྲིན་ལས་ཀྱི་ཆ་ཤས་ཡོངས་སུ་གང་བ་སྒྲུབ་བརྒྱུད་རྒྱ་མཚོའི་དཔལ་དུ་སྤེལ་བའི་རབ་ཏུ་བྱེད་པ་སྟེ་བཅོ་བརྒྱད་པའོ།",
    "དེ་ནས་མྱོས་ལྡན་ཏེ་ས་མོ་ཡོས་ལོ་དབྱེད་ཀྱི་དུས་སྟོན་ལ་ཕྱོགས་པའི་ཚེ།",
    "སོ་སོའི་དཔལ་འགྱོར་དོན་ལྡན་དུ་བྱ་བའི་ཕྱིར་ཟང་ཟིང་གི་འབུལ་བ་ཆར་སྤྲིན་ལྟར་གཏིབས།",
    "གྲྭ་ཚང་པས་འཆམ་གྱི་གཟིགས་མོ་དང་།",
    "བདེ་ཡངས་ཀྱི་བཞུགས་ཁྲི་ཆེན་མོར་གདན་དྲངས།",
    "ད་ཚེ་འདི་ལ་མཇལ་བ་ཞིག་དབཁ་བས་ཐུགས་རྗེའི་སྐྱབས་འཇུག་ཞུ་གསུངས་ཞབས་ཀྱི་པདྨོ་ལ་གཙུག་གིས་འདུད་པ་དང་ལྷན་ཅིག་སྤྱན་ཆབ་མཛད་འདུག་པས་རང་རེ་ཡང་ཡིད་ཤིན་ཏུ་སྐྱོ་ཞིང་མིག་ནས་མཆི་མའི་རྒྱུན་སྐྱིལ་མི་ཐུབ་པ་ལྟ་བུ་བྱུང་།",
    "རང་རེའི་ཁྲོ་ཕུ་བ་རྣམས་སྤྱོད་ལམ་ལེགས་པོ་མཛད་དགོས་པ་འདུག།",
    "བློས་མི་བཟོད་པར་གང་དྲག་ཅི་དྲག་བྱེད་དགོས་པ་ཡོང་གི་འདུག།",
    "སྒོམ་ཐག་ཕྱག་གིས་སྤྱི་བོར་བཞག་ནས་འདི་ངེད་རང་གིས་བྱ་བྲལ་གྱི་བསྐོ་འཇའ་ཡིན་ནོ་གསུངས།",
    "ད་རྒས་པས་སུན་ཡོང་གི་འདུག་གསུངས།",
    "དེ་མཚམས་གཟིམས་ཆུང་དུ་དུད་སོལ་ལྷ་མོར་སྒེར་བསྐང་བརྒྱ་ཚར་ཞིག་ལྗགས་ཐོག་ནས་གནང་སྐབས།",
    "གཡོག་གིས་དཔོན་ལ་མི་ཉན་པའི་ཟང་ངེ་ཟིང་ངེ་འདི་ཡོང་བ་ཡིན།",
    "དུས་སྙིགས་མའི་ཐུགས་དམ་རང་ཚོ་ཐུབ་ངེས་ཡིན་འདུག་ཀྱང་།",
    "གདན་ས་ཆེན་པོ་ར་ལུང་ཐེལ་གྱི་གངས་རི་རྣམས་གཟིགས་པ་དང་ཆིབས་ཐོག་ཏུ་དབུ་ཞྭ་ཕུད།",
    "མཐོ་རིས་ཀྱི་དཀོ་ཚལ་ནོར་འཛིན་དཔལ་མོའི་རྒྱན་དུ་བཀོད་པ་ལྟ་བུའི་སྐྱེད་ཚལ་གཞལ་མེད་ཁང་བཀོད་པ་ཕུན་སུམ་ཚོགས་པར་ཕེབས།",
    "དེ་རེས་ཀྱང་ཤེལ་བྲག་གི་གནས་གཟིགས་ལ་ཕེབས།",
    "མཁར་ཐོག་ཚུན་ཆིབས་སྐྱེལ་ལ་ཕེབས་དུས་སྐ་ངོས་ཀྱིས་གོང་མ་ཆེན་པོར་ཆབ་སྲིད་ཀྱིས་སྐྱོང་བྲན་སོགས་ལུགས་གཉིས་མའི་བླང་དོར་གྱི་གནས་ལ་དེ་རེས་བསླབ་སྟོརྣོ་སྔར་བས་ཞིབ་རྒྱས་ཆེ་བ་སྩལ།",
    "དེ་སྐབས་ཞག་ཁ་ཤས་ཀྱི་བར་ཉིན་མོ་ལྟ་ཅི་མཚན་མོའིང་སྐུ་གཞོགཀྱི་པདྨོ་ལ་སྤྱི་བོས་བཏུད་དེ་འདུག་པའི་སྐལ་བ་བཟང་པོ་ཐོབ་ཅིང་།",
    "བླང་དོར་གྱི་གནས་མཐའ་དག་ལའང་མཚན་ཐོག་ཐག་འཁྱོངས་པའི་བཀའ་མཆིད་ཞིབ་སབཀའ་དྲིན་མཛད་པས་རང་རེའི་ལེགས་བྱས་ལའང་མགུ་བར་བྱུང་གསུངས།",
    "མཁྱེན་བརྩེ་མོས་ངོར་སྣང་བ་ཉི་ཟླའི་འགྲོས།",
    "མ་འདྲེས་གསལ་གཟིགས་གསུང་གི་ནོར་བུ་ཡང་།",
    "ཁྱེད་ཀྱི་བརྩེ་བའི་ཆུ་རྒྱུན་ངང་གིས་ལྷང་།",
    "ཐབས་མཁས་ཐུགས་རྗེར་ལྡན་པའི་རྟེན་འབྱང་གིས།",
    "སྣ་ཚོགས་མོས་པའི་འཇུག་ལྡོག་ཇི་བཞིན་དུ།",
    "སྒོ་ཁང་སྟེང་དུ་རྗེ་ཉིད་རང་གི་སྐུ་ཐོག་ལ་ཕྱག་ཏུ་འབྱོར་བའི་རྟེན་ལི་མའི་རིགས་རྒྱ་གར་དབུས་འགྱུར་ཤར་ལྷོ་ནུབ་བྱང་གི་ཡུལ་གྲུ་སྤྱི་དང་བྱེ་བྲག་ལས་བྱུང་ཞིང་།",
    "དགོང་མོ་མགོན་པོ་ལྷ་མངས་སོགས།",
    "གནམ་གང་གི་དགོང་མོ་ནས་སྐུ་མཚམས་ངེས་པ་ཅན་ལ་བཞུགས།",
    "ཉིན་རེ་བཞིན་བུག་མཇལ་ཡུན་རིང་བ་གནང་།",
    "སད་ཐོ་འདྲིལ་ཞིང་རྡོ་རྗེའིགསུང་རེ་རེས་ཀྱང་ཐེ་ཚོམ་གྱི་དྲྭ་བ་གཅོད་པའི་བསླབ་སྟོན་ཀྱང་ལྷུག་པར་སྩལ་ཏོ།",
    "རྒྱལ་བ་མཆོག་གི་ཞབས་དྲུང་དུ་ཞབས་པད་རྟག་བརྟན་གྱི་རྟེན་བྱུང་དུ།",
    "བླང་དོར་གྱི་མིག་བར་དུ་གཅོད་པའི་རབ་རིབ་འཐུག་པོས་བསྒྲིབས་པས་ཕལ་ཆེར་གྱིས་མ་གཟིགས།",
    "ཁོང་གིས་ཞུས་ངོར་སྨོནེ་ལམ་འདི་སྩལ།",
    "བདག་གིས་རྣམ་དཀར་དགེ་ཚོགས་མ་ལུས་པ།",
    "སྐུ་བརྙན་རིན་ཆེན་ལས་གྲུབ་ཀུན་བཟང་གི།",
    "མི་བསྲུན་དུག་གི་སྡོང་པོས་གང་བའི་ཁྲོད།",
    "མི་འགྱངས་པར་སྐད་ཆ་ཡོང་གསུང་བ་ཕེབས་སོང་ཟེར།",
    "དེ་ནས་མྱ་ངན་ལས་འདའ་བའི་དུས་གཟིགས་ཏེ།",
    "སྲས་གྲོ་བོ་ལུང་རྣམས་སུ་སྔ་སོར་ཕེབས་པ་མ་ཤར་བའི་འདི་རེས་ཀུར་འབྲག་ཐུགས་སྣང་དག་པའི་གནས་གཟིགས་ལ་ཕེབས་དགོས་ཚུལ་གྱི་ཞུ་བ་ནན་ཅན་བྱུང་བར།",
    "ང་རང་དགུང་སྒེག་གི་ཏིག་ཏིག་མི་ཡོང་།",
    "སྐབས་འདིར་མ་ཟད་ལོ་སྔ་རེས་གཙང་ཕྱོགས་ལ་ཆིབས་ཁ་བསྒྱུར་བ་ནས་བཟུང་ཞིང་གཞན་དུ་དགོངས་པའི་ཕེབས་སྒོ་རྒྱུད་མར་བྱུང་འདུག་པ་དང་།",
    "དེ་ནས་ཚེས་བཅུ་དགུའི་ཉིན་ཚེ་བདག་གི་དུས་གཏོར་གནང་བའི་གསུང་ཆོག་ཚོགས་དབུར་བཞུགས་ཏེ།",
    "སྤྱན་བར་སྣང་ལ་ལྟ་སྟངས་སུ་གཟིགས་ཏེ།",
    "ངང་ཚུལ་ཡིན་མོད་དེ་མཐའ་སུ་ཡིས་བགྲང་།",
    "སྐྱེ་འཆིའི་འཆིང་བ་ལས་ཡོངས་སུ་གྲོལ་བའི་བདག་ཉིད་ཆེན་པོ་འདི་ནི་གདུལ་བྱ་ལས་སྣང་མཐའ་དག་གི་ངོར།",
    "མཆོག་གི་སྤྲུལ་པའི་སྐུ་རྣམས་ཀྱི་མཛད་པ་མཐའ་མ་ནི་མྱ་ངན་ལས་འདས་ཚུལ་སྟོན་པ་འདི་ཡིན་ལ།",
    "ཕྱོགས་ཀྱི་འཁོར་ལོ་འཇའ་ཚོན་སྣ་ལྔས་བདབ་པའི་བར་བར་ནས་མེ་ཏོག་གི་ཆར་འབེབས་པ་སོགས་དཔག་པར་དལཁ་བའི་ངོ་མཚར་གྱི་ཆོ་འཕྲལ་སྣ་ཚོགས་པ་ཡང་བསྟན་ཅིང་།",
    "གནམ་ས་གྲུམ་པའམ་རི་ཆེན་པོ་ཉིལ་བ་ལྟ་བུའི་འུར་སྒྲ་འཇིགས་སུ་རུང་དྲོ་ཤར་ནས་བརྩམས་ཏེ་ནུབ་ཕྱོགས་སུ་སོང་བའང་བྱུང་།",
    "དེ་ལྟར་ཡན་ལག་བདུན་ལྡན་གྱི་ཁ་སྤྱོར་མངོན་དུ་མཛད་དེ་འོད་གསལ་ལས་ཟུང་འཇུག་གི་སྐར་བཞེངས་ནས།",
    "གར་ཕེབས་སུ་འཇའ་གུར་དང་དྲི་བཟང་གིས་ཁྱབ་པ་སོགས་བྱུང་བས།",
    "འདུ་ཁང་ཆེན་མོར་བླ་སྤྱོ་བཅུ་ནས་འདུས་པའི་སྒྲུབ་པ་ཕོ་མོ་གྲངས་མང་བས།",
    "ལྷོ་མོན།",
    "སོ་སོའི་མོས་བླ་དང་མཐུན་པའི་མཐོང་སྣང་ངོ་མཚར་ཆེན་པོར་བགྲང་བར་འོས་པ་ཡང་མང་དུ་བྱུང་བ་རེ་རེ་ནས་བྲི་བར་མ་ནུས་སོ།",
    "དེ་ནས་གདུང་ཁང་ལ་སྤྲུལ་པའི་སྐུ་རྣམ་གསུམ་དང་ཕྱག་མཛོད་ཀྱི་ཕྱག་རྒྱས་བཏབ་སྟེ་བདུན་ཕྲགགསག་གི་བར་དུ་ལེགས་པར་མཆོད་ནས་ཞལ་ཕྱེ་ཚེ།",
    "གཞན་ཡང་ར་། ལྷ་སྐུ་ཡིག་འབྲུ་རིང་བསྲེལ་སོགས་མོས་པའི་རྟེན་གནས་སྐབས་དེ་དང་ཕྱིས་གདུང་སྐལ་ལ་ཕེབས་པ་སོགས་མང་དུ་བྱུང་བ་སྣང་།",
    "དེ་ནས་དགོངས་རྫོགས་ཆེན་མོའི་གྲལ་དབུར།",
    "ཆིབས་ཆས་དང་བཅས་པ་སོགས་དགུ་ཚན་བཞི་རེ།",
    "གྲྭ་ཚང་འགངས་ཆེ་བ་ཐམས་ཅད་ལ་རྒྱ་ཧོར་གྱི་སྦུག་སིལ་ལམ་བླ་བྲེ་སྤུས་གཙང་བ་ལྟ་བུ་སྤྱི་རྫས་སུ་འགྲོ་ངེས་རེས་གཙོས་སྤྱི་འགྱེད་མང་ཇ་དང་བཅས་པ།",
    "སྒར་རང་གི་དབུ་ཆེ་དྲུང་འཁོར་ལས་ཚན་སོ་སོར་རྣམ་གཞག་བབས་འབྲེལ།",
    "ཕྱག་འགྱེད་ཇ་དངུལ་ཕོར་རེ།",
    "སྤེན་ཏོག་རེ་རྣམས་བཀྱེ།",
    "འབྲུ་སྣ་སོགས་གནོད་སྦྱིན་འབོར་མོའི་བར་མ་ཚང་བ་མེད་པ།",
    "གཡས་གཡོན་དུ་རྒྱལ་བ་ཉིད་ཀྱིགདུང་ཐལ་ལས་གྲུབ་པའི་འཇམ་དབྱངས་དང་ཕྱག་ན་རྡོ་རྗེའི་སྐུ་རྒྱ་ནག་མ་ལུགས་དང་།",
    "འཇིགས་རུང་མི་བཟད་སྲིད་པ་དུག་གི་མཚོ།",
    "སྣ་ཚོགས་མོས་པའི་ས་གཞི་དེ་དང་དེར།",
    "དེ་ལྟ་མོད་ཀྱི་བྱང་ཕྱོགས་མུན་པའི་གླིང་།",
    "ཟེགས་མ་ཕྲ་མོ་ལ་ཡང་མཆོག་གི་རོ་བྲོ་བའི།",
    "གང་གི་རྟོགས་བརྗོད་རྒྱ་མཚོ་ཆེན་པོ་ལས།",
    "གཟིགས་པ་མི་གཡེལ་སྒྱུ་འཕྲུལ་ཟློས་པའི་གན།",
    "ཟ་ཧོར་རིགས་མཆོག་ཐིག་ལེ་ལ་གཟིགས་ཏེ།",
    "གང་གི་སྤོབས་པས་སྔོན་རབས་མཁས་རྣམས་ལ།",
    "ཁ་ན་མ་ཐོ་རེང་སྤངས་ཚངས་པར་སྤྱོད།",
    "གང་ཁྱོད་དོན་གཉིས་ལྷན་གྲུབ་རྒྱལ་ཐབས་མཆོག།",
    "ར་། བདག་གིར་མཛད་ཀྱང་བས་མཐའི་གནས་མལ་ཆེར།",
    "བཤེས་གཉེན་ཁྱོད་ཉིད་ཁོན་ལ་རག་ཅེས།",
    "གང་གི་མཚན་ཙམ་ཐོས་སམ་དྲན་བྱེས་ཀྱང་།",
    "འཁོར་སི་། བའི་དུ་ཁ་བཅིལ་ཏེ་ཐར་མཆོག་གི།",
    "རྣམ་ཀུན་ཁྱོད་ཉིད་ཁོ་ནར་གསོལ་བ་འདེབས།",
    "གསུང་གི་གསང་བ་འཛིན་པའི་མཆོགགྱུར་ཅིག་༢༥།",
    "ཁུན་གསལ་ཁྱོན་འདི་གང་བས་དགེར་གྱུར་ཅིག།",
    "རྒྱལ་བསྟན་ཀུ་མུད་ཀྱི་མོང་ཚོ་རྣམ་པར་བཞད་པའི་ཟིལ་དངར་གྱིས་རིས་མེདའགྲོ་བའི་",
    "རྒྱ་མོན་ཡབ་སྲས་ཀྱིས་བྲིས།",
    "བཀས་བཅད་གསར་རྙིང་འདྲེས་མར་སྣང་བས་ཕྱི་མོ་བཞིན་བཞག་པ་འགྱུར་མེད་འགོད་པའི་བི་ཤྭ་དྲོ་བཅུ་ཕྲག་གཅིག།",
    "རྡོ་རྗེ་འཆང་གི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "༡༡༧། ཁྲིད་བརྒྱའི་སྔོན་འགྲོ་ཐུན་མོང་བ་བཞུགས་སོ། ༡༡༨། ཨོཾ་སྭ་སྟི་སིདྡྷཾ།",
    "རང་གི་རྙེད་དཀའི་དལ་འབྱོར་ཐོབ་པ་དོན་དང་ལྡན་པར་བསམས་ནས་དེ་ཉིད་ཀྱང་ཡུན་རིང་མི་གནས་པའི་འཆི་བ་མི་རྟག་པའི་ཚུལ་ལ་དཔྱད་པས།",
    "དཀར་ནག་གི་ལས་འབྲས་མི་བསླུ་བར་ངེས་པ་བརྟན་པོས་དགེ་སྡིག་གི་བླང་དོར་ཕྲ་མོ་ཡང་ཁྱད་གསོད་མེད་པར་རྗེས་༡༡༩",
    "མཐའ་སྐོར་དུ་མཁའ་སྤྱོད་ཀྱི་དཔའ་བོ་དཔའ་མོ་སྤྲིན་ལྟར་གཏིབ་པ་ཙམ་གྱིས་བསྐོར་བ།",
    "ཨོཾ་བཛྲ་ཡོ་གི་ནི་ཨརྒྷཾ་སོགས་ཀྱིས་མཆོད།",
    "སྣང་སྲིད་ཐམས་ཅད་སྒྱུ་མའི་རང་བཞིན་དུ་ཕྱམ་གྱིས་སོང་བར་བསམས་ལ།",
    "སྐད་ཅིག་གིས་བདེན་མེད་དུ་སྦྱང་བ་དང་སྐྱེ་མེད་འོད་གསལ་དུ་བསྲེ་བ་རྣམས་རིམས་གྱིས་བྱའོ།",
    "གཞན་ཡང་ཏིང་ངེ་འཛིན་གྱི་ཡོན་ཏན་བདེ་གསལ་མི་རྟོག་པ་ངང་གིས་འཆར་ཞིང་།",
    "སྣང་བ་འདི་ཕྱམ་གྱིས་ཟང་ཐལ་དུ་སོང་ནས་སྣང་དུས་དེ་ཉིད་སང་སེང་།",
    "ཁྲལ་ཁྲོལ་དུ་སོང་བ་མཉམ་ཞིང་།",
    "རིག་པ་བན་བུན་ཕྱད་ཕྱོད་ཕྱལ་ཕྱལ་སོང་སྟེ།",
    "སྣང་བ་ཟང་ཐལ་དུ་མཐོང་བའི་སྤྱན་དང་།",
    "རིམ་གྱིས་ཇེ་དྭངས་སོང་ན་རྗེས་གཅོད་ནུ་གསང་ཁ་བཞི།",
    "བློ་ཡུལ་ལ་དགོང་མོར་མར་དཀར་བྱུགས།",
    "སྤྱི་གཙུག་གི་སྐྲ་འཁྱིལ་དབུས་གཙུག་གསང་བཅས་སྟག་རུས་འབུར་པོའི་གཤམ་སྣེ་འགའ་ཞིག་ལ་ཀློང་ཙམ་ཡོད་པ་ལྟག་གཉིས།",
    "སྐར་ཆུས་རེག་བྱ་ཉམས་པར་བྲན་པས་གཉན་སྐྲངས་ཡིན་ན་གཟེར་ཞི་འགྲོདེ་ལ་གཉན་བཅོས་བྱ།",
