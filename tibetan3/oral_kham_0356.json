    "ཁྱེད་རང་རྣམས་ཀྱི་ལྕེ་སྟེང་ནས་ཞུགས།",
    "སྔར་བཞིན་ཁྱེད་རང་རྣམས་བདེ་མཆོག་ལྷན་སྐྱེས་སུ་གསལ་བའི་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས་ཏེ་ལུས་ཀྱི་ནང་ཐམས་ཅད་གང་བས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལྕེ་རྩེ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་དགེས་མཛད་རྡོ་རྗེར་གསལ་བ་ལ་འཁྱུད་པས་སྲུབ་དང་སྲུབ་པའི་སྦྱོར་བ་སྤངས་ཏེ།",
    "སླར་ཡང་ཁྱེད་རང་རྣམས་དགེས་མཛད་རྡོ་རྗེ་ཡབ་ཡུམ་དུ་གསལ་བ་དེ་ཉིད་ནམ་མཁའ་ལ་འཇའ་ཡལ་བ་ལྟར་གྱུར་ཏེ།",
    "ཅིར་སྣང་རང་སེམས་ལན་པས་ཕྱི་དོན་བདེན་ཞེན་སྤོངས།",
    "གང་བྱུང་ཡང་རང་བཞིན་མེད་པར་ཤེས་བའྀ།",
    "ལྷ་དང་རང་འཇིགས་ཕ་མེས་དང་།",
    "སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "བརྒྱ་བྱིན་ལ་སོགས་པ་འདི་དག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རང་རང་ལས་ལ་ཉེར་སྤྱོད་པས།",
    "རང་རང་རྒྱུ་བ་ལས་རབ་གྲུབ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད་ཅེས་པ་སྟེ།",
    "དེ་བཞིན་དུ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར་ཏེ་རིམ་པ་འདི་ནི་སྔར་བརྗོད་པ་ཡིན་ནོ།",
    "དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་སྟེ་ཉིན་ཞག་དྲུག་ཅུ་རྩ་བཞི་ལ་དེ་ནི་ཆ་དམན་ཟླ་བ་སྟེ་ཟླ་བའི་ཆ་ཉམས་པའོ་ཞེས་པའི་དོན་ཏོ།",
    "འདི་དག་རྣམས་ཀྱང་རང་བཞིན་གསུམ་སྟེ་གཡོ་བ་ལུག་ལ་སོགས་པ་དང་བརྟན་པ་གླང་༢ལ་སོགས་པ་དང་མཉམ་པ་གཉིས་ཀྱི་རང་བཞིན་འཁྲིག་པ་ལ་སོགས་པའོ།",
    "ཉིན་ཞག་དུས་ཐུན་བརྒྱད་ཀྱི་བདག་ཉིད་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་དག་ལས་ལྷན་ཅིག་སྐྱེས་པའི་སྐུ་ནི་པདྨ་གསུམ་ལ་རང་བཞིན་དང་རང་བཞིན་མེད་པའི་དབྱེ་བས་སོ།",
    "དེའི་ཕྱིར་གསང་བའི་པདྨ་དང་གཙུག་ཏོར་གྱི་པདྨ་དང་ལྟེ་བའི་པདྨ་ལ་རྣམ་པར་དག་པའི་སྐུ་ལྷག་པའི་ལྷ་སྟེ་རང་བཞིན་མེད་པ་མ་བརྟགས་པ་དང་རང་བཞིན་པྲ་ཕབ་པ་ལྟ་བུའོ།",
    "རིགས་པ་འདི་ལས་མངལ་ནས་སྐྱེས་པའི་གྱིས་པ་གང་ཞིག་དུས་མ་ཡིན་པར་འཆི་བར་འགྱུར་བ།",
    "དེ་ཡི་དབུས་སུ་རང་རང་བསམ་པས་མི་བདག་ནི་བོད་པ་སྟེ།",
    "གཞན་ནི་ཡོད་པའི་ལུས་ལྔ་ཞེས་པ་ནི་ཁ་ཟས་ཅན་གྱི་ལུས་དང་འོད་ཀྱི་ལུས་དང་རང་བཞིན་ཅན་གྱི་ལུས་དང་།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་པར་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཅི་ལྟར་འགྲོ་ཞེས་པ་ནི་འདིར་སད་པའི་དུས་སུ་སད་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱ་བ་དང་བཅས་ཤིང་།",
    "འོག་ཏུ་ཡེ་༡ཤེས་ཀྱི་ཁམས་ལས་སྐྱེས་པ་ཡིད་ནི་ཀུན་ཏུ་བཟང་པོ་ཁ་དོག་སྔོན་པོ་ཞལ་གསུམ་པ་ཕྱག་དྲུག་པ་ཁ་དོག་དུས་ཀྱི་འཁོར་ལོ་ལྟ་བུ་སྟེ་ཤར་གྱི་སྒོའི་གཡོན་དུ་ར་བའི་རྩིག་པ་ལའོ།",
    "རང་རང་ཞིང་དུ་རབ་ཏུ་གཞུག་ཅེས་པའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "རྣམ་པར་དག་པ་དེས་ལྷ་རྣམས་ཀྱི་སྟབས་དང་འདུག་སྟངས་རྣམ་པར་དག་པར་འགྱུར་ཏེ་གཡོ་བ་མེད་པ་ལས་སོ་ཞེས་པ་ངེས་པའོ།་།",
    "ཨོ་ལོ་ཙ་ནེ་བ་སུ་དེ་སྭཱ་ཧཱ།",
    "ཐབ་དང་འདུག་སྟངས་ལ་སོགས་པའི་ཆོ་གས་གྲུབ་པར་འགྱུར་བ་ཇི་སྲིད་ཉིད་དུའོ།",
    "དེ་བཞིན་དུ་བྱང་དུ་ར་པ་ཙ་ནཱ་ཡ་ཏེ་ན་མ་ཞེས་པ་སྟེ་བཛྲ་ཏཱིཀྵ་ལ་སོགས་པ་ཡི་གེ་རྣམས་སོ།",
    "གལ་ཏེ་འཆད་པར་འགྱུར་བའི་འདུག་སྟངས་བཅིངས་ནས་ཐུན་ཚོད་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱེད་པར་མི་ནུས་ན་དེའི་ཚེ་ཐུན་ཕྱེད་གཅིག་སྦྱིན་སྲེག་བྱས་ནས་བསྒྲུབ་པར་བྱ་སྟེ་གཉི་ག་གསུངས་སོ།",
    "ད་ནི་ཞི་བ་ཞེས་པ་ལ་སོགས་པས་ཞི་བ་ལ་སོགས་པའི་ལས་སྒྲུབ་པའི་དོན་དུ་འདུག་སྟངས་རྣམས་གསུངས་ཏེ།",
    "འདིར་ཞི་བ་ལ་སོགས་པ་ལ་རིམ་པས་འདུག་སྟངས་རྣམས་སུ་འགྱུར་རོ།",
    "རྒྱས་པ་ལ་རྡོ་རྗེའི་འདུག་སྟངས་ནི་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དང་གཡོན་པ་ཡང་བརླ་གཡས་པའི་སྟེང་དུ་སྟེ་ཐད་ཀུར་གན་རྐྱལ་གྱིས་སོ་ཞེས་པ་ནི་རྡོ་རྗེ་འདུག་སྟངས་སོ།",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀུའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།་།",
    "དེ་ནས་ཨོ་སརྦ་ཏ་ཐཱ་ག་ཏ་སྐྲྀ་ད་ཡ་སི་ར་ཤི་ཁཱ་ཀ་བ་ཙ་ནེ་ཏྲ་ཨནྟྲ་བཛྲ་ཥ་ཌི་ག་སྭ་བྷཱ་བ་ཨཱདྨ་དཀོ་ཧཾ་ཞེས་པ་སྟེ་ཡན་ལག་དྲུག་དགོད་པའི་ཆོ་གའོ།",
    "བྱང་དུ་ཝཾ་ཝཱ་བཀོད་ཅིང་པདྨའི་ཕྱག་རྒྱས་རིག་ནས་པདྨའི་འདུག་སྟངས་ཀྱིས་བྱིན་གྱིས་བརླབ་པའམ་ཏཱ་ཎ་ཌ་པའི་སྟབས་ཀྱིས་བཅག་པར་བྱའོ།",
    "ཨོ་བེེ་རོ་ཙ་ནཱ་ཡ་ན་མ།",
    "ཨོ་ལོ་ཙ་ནཱ་ཡི་ན་མ།",
    "ལྔ་པ་ནི་ཟར་མ་དང་བ་ར་ཊཱི་དང་བརྗེ་དང་ཀུ་ལན་ཐ་དང་ཙ་ན་ཀ་ནག་པོ་སྟེ་ལེ་ཚེ་སྦྱར་བའི་ཆས་འབྲུ་ལྔ་ཇི་ལྟར་རྙེད་པ་གཟུང་བར་བྱའོ།",
    "ཁུ་ཚུར་གྱིས་མཐེ་བོ་བསྡམས་པ་དག་བརླ་གཡས་པ་དང་གཡོན་པའི་སྟེང་དུ་རྡོ་རྗེའི་འདུག་སྟངས་ལ་གནས་པ་ནི་རྡོ་རྗེའི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "མངོན་དུ་ཕྱོགས་པ་སྟོན་པར་གྱུར་ན་འདུག་ཅིག་ཅེས་བརྗོད་པའོ།",
    "སླར་ཡང་རང་བཞིན་རྣམས་ཀྱིས་རྣམ་པ་མང་པོར་རིག་པར་བྱའོ་ཞེས་པ་ནི་ལྟ་སྟངས་ཀྱི་བརྡའི་ངེས་པའོ།",
    "འདུག་སྟེགས་ཆུང་ངུའི་མིང་།",
    "ང་རང་ཨ་བྲ་གསོད་པའི་རྫས་ཤིག་འཚོལ་དུ་འགྲོ་བ་ཡིན།་",
    "མི་རྐྱང་རྒྱ་ལོ་ཕྱིར་སླེབས་འདུག་ཁོས་ད་དུང་ཀོ་ཆས་བཟོ་གྲྭ་ཞིག་འཛུགས་རྩིས་འདུག་ཟེར།",
    "ཆུང་དུས་སུ་ཁོའི་ཀྱི་རིང་ལ་རྒྱ་གར་དང་བལ་ཡུལ་ནས་ཚོང་བརྒྱབ་སྟེ་མིང་ལ་རྒྱ་ལོ་ཞེས་འབོད་པ་ལས་མི་རྐྱང་སྔོན་དུ་ཕྱུག་པོ་ཆགས་འདུག་ཟེར།",
    "ཁོ་རང་ཉིད་མིང་གང་ལ་ལོབས་ཡོད་པའང་ངས་མི་ཉལ་ཁང་ནང་ཟིང་ཟིང་ལོང་ལོང་དུ་གྱུར་བ་ཤེས།",
    "དེ་ནི་གནམ་རྒན་མས་བསམ་གཟས་ནས་རྒྱ་ལོ་ལ་འཁྱམ་ཉུལ་གྱི་ཆེད་གཉེར་འདི་སྩལ་བ་ལོས་ཡིན།",
    "ཐུབ་པའི་ན་ཟུག་ཅིག་ལངས་པ་དང་དེ་མུར་རུམ་མི་འདུག་སྐབས་འདིར་མིའི་རྣ་ལམ་དུ་གྲགས་།",
    "སྟོབས་རྒྱལ་སྐྲག་མ་དངངས་ཀྱིས་ཁོ་ལ་བལྟས་ཏེ་ཧད་ནས་འདུག་པའི་ཕ་རོལ་པ་སུ་ཡིན་ལ་ལྟ་ཡག་བྱེད་ཁོམ་ཡང་མ་བྱུང་བར་རུམ་ནས་མགོ་སྐོར་བླངས་ཏེ་ཤུགས་ཀྱིས་གཡུགས་པས་སིང་སེ་བཏང་བ་དང་ཕ་རོལ་བ་རྟ་ལས་ལྷུང་།"
  ]
}