    "དེ་ནས་དམ་ལ་བཞག་པའི་སླད་དུ་རྡོ་རྗེ་མགོ་བོར་གཏད་ནས་ཚིག་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "བདུད་རྩི་ལྔ་ཡི་ཆུ་བླུད་ནས་དམ་ཚིག་བསྲུང་བར་གདམས་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཐུགས་འདུན་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས་ལུས་ཐམས་ཅད་གང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་པཾ་ལས་པདྨ་རམ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་འཇིགས་བྱེད་དུས་མཚན་གྱི་གདན་ལ་ཡི་གེ་ཧཱུྃ་མཐིང་ག་ཞིག་གསལ་འདེབས་པ་ཞུ།",
    "མཐར་རྣལ་འབྱོར་མ་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "སླར་ཡང་རང་ཉིད་ཧེ་རུ་ཀ་ཡབ་རྐྱང་དུ་གསལ་བའི་གནས་གསུམ་དུ་ཡི་གེ་གསུམ་གྱིས་མཚན་པའོ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "སྡུག་བསྔལ་དེ་ཡང་ཟད་མི་ཤེས་ཤིང་ཐར་བར་དཀའ་བའི་རྒྱ་མཚོ་དང་མཚུངས་པར་འདུག་པ་ལ།",
    "གསུམ་པ་སྤྲོ་བ་སྐྱེད་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "ལྔ་པ་གནང་བ་སྦྱིན་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཨོཾ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་ནང་དུ་འཁོད་པ་ལ་ཡེ་ཤེས་དབབ་པའི་སྔོན་འགྲོ་དམ་བཞག་བྱེད་པ་འདིར་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "དང་པོ་བསྐུར་བར་བྱ་བའི་དོན་དུ་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་༤༨",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཨོཾ་དཀར་པོ་དེ་ལས་འོད་ཟེར་དཀར་པོ་འཕྲོས།",
    "ཡང་ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པར་ཨཱ་དམར་པོ་དེ་ལས་འོད་ཟེར་དམར་པོ་འཕྲོས།",
    "ཡང་ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བར་ཏྲཱཾ་སེར་པོ་དེ་ལས་འོད་ཟེར་སེར་པོ་འཕྲོས།",
    "ཡང་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཨཱ་ལྗང་གུ་དེ་ལས་འོད་ཟེར་ལྗང་ཁུ་འཕྲོས།",
    "དེ་ལྟར་ན་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་དྭངས་མ་ཡེ་ཤེས་ལྔ་ལྡན་བདེ་མཆོག་ལྷན་ཅིག་སྐྱེས་པའི་སྐུར་གསལ་སིང་ངེར་གྱུར་པའི་ངང་ལ་མཉམ་པར་ཞོག་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྨིན་ཕྲག་ཏུ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལྕེ་ལ་ཐིམ་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་སེམས་ཁོང་སློད་ལ།",
    "དང་པོ་ནི་ཁྱེད་རང་རྣམས་ལྷ་སྐུར་གསལ་བའི་ལུས་ཀྱི་དབུས་སུ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་གང་།",
    "ཡང་ཁྱེད་རང་རྣམས་ལྷ་སྐུར་གསལ་བ་ལ།",
    "རྩ་ནང་འོད་ཟེར་གྱིས་གང་བའི་རྐྱེན་གྱིས་རྩ་རྣམས་ཀྱང་འཇའ་འོད་དུ་ལྡེམ་ལྡེམ་འདུག་པར་བསམ་ལ་ཅུང་ཟད་མཉམ་པར་ཞོག་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོའི་ཧམ་ཡིག་དེ་ཐིག་ལེ་དཀར་པོ་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཨོཾ།",
    "ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "བདུད་རྩི་ལྔ་ཡིས་ཆུ་བླུད་ནས་དམ་ཚིག་བསྲུང་བར་གདམས་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "ཁྱེད་རང་རྣམས་ལ་ཕོག་པའི་རྐྱེན་གྱིས་ཁྱེད་རང་རྣམས་སྐད་ཅིག་ཙམ་གྱིས་༤༢༡",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཚངས་བུག་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཚངས་བུག་ནས་ཞུགས།",
    "དེས་ཁྱེད་རང་རྣམས་འཁོར་ལོ་སྡོམ་པ་ཡབ་རྐྱང་དུ་གསལ་བའི་སྐུ་ལ་འཁྱུད་ཅིང་།",
    "ཡབ་འོད་དུ་ཞུ་སྟེ་ཁྱེད་རང་རྣམས་ཀྱི་ཚངས་བུག་ཏུ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་འཁོར་ལོ་བདེ་མཆོག་ཏུ་གསལ་བའི་ཡུམ་ཡང་ཡབ་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྨིན་མཚམས་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཕྱི་ནང་གསང་བ་དེ་ཁོ་ན་ཉིད་དང་བཅས་༴",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པ་ནས་ཞུགས་༴",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བ་ནས་ཞུགས།",
    "དེ་ཉིད་ཀྱང་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པར་བསམ་ལ་སྤྲོས་བྲལ་ནམ་མཁའི་དབྱིངས་ལྟ་བུའི་ངང་དུ་ཅུང་ཟད་མཉམ་པར་ཞོག་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོའི་རྩ་འདབ་རྣམས་བརྒྱུད་དེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པའི་རྩ་འདབ་རྣམས་བརྒྱུད་དེ་ལུས་ཀྱི་ནང་ཐམས་ཅད་འོད་ཟེར་གྱིས་ལམ་སྟེ་གང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བའི་རྩ་འདབ་རྣམས་བརྒྱུད་དེ་ལུས་ཀྱི་ནང་ཐམས་ཅད་འོད་ཟེར་གྱིས་ལམ་སྟེ་གང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཞུགས་ཏེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པ་ནས་ཞུགས་ཏེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས་པས་ལུས་སེམས་ཐམས་ཅད་བདེ་བས་ཁྱབ་པ་ལ་སེམས་རྩེ་གཅིག་ཏུ་གཏད་༤༣༩",
