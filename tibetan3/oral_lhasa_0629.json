    "འདི་ལྟརདེས་གང་ལ་བསླབཔར་བྱ་བའི་སྒྲ་དེ་ཡང་ངག་པར་རྗེས་སུ་མིམཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་དེ་ཡང་དག་པར་རྗེས་སུ་ཀྱི་མཐོང་ངོ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཡི་ད་དེ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདི་ལྟར་ངེས་གངལ་བསླབ་པ་ཁྱབའིགཟུགས་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་སྒྲ་དེ་ཡང་དག་པར་རྗེསསུ་ལྷེམྱིམཐོངངོ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་དྲིང་ཡངདག་བར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་རོ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོངངོ།",
    "འདི་ལྟརདེས་གང་ལ་བསླབ་པར་བྱ་བའི་རིག་དེ་ཡང་དག་བར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རྣབའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའིན་བའིནམ་པར་ཤེས་པ་དེ་ཡང་དག་པར་རྗེས་སུམྱ་མཐོང་ངོ།",
    "སྣའི་རྣམ་པར་ཤེས་པལ་མྱི་སློབ་སྟེ།",
    "དེ་ཅིའི་ཕྱིརཞེན། ། འདི་ལྟར་དེསགང་ལ་བསླབ་པར་བྱ་བའི་སྣའི་རྣམ་པརཤེས་པ་དེ་ཡང་ངག་པར་རྗེས་སུམྱི་མཐོང་དྲོ་ལྕེའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་བར་བྱ་བའི་ལྕེའི་རྣམ་བར་ཤེས་པ་དེ་ཡང་དྲག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་མ་སློབ་སྟེ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པར་མྱསློབ་སྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་ཡང་དག་བར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་ཀངལ་བསླབ་པར་བྱ་བའི་སའི་ཁམས་དེ་ཡངདག་པར་རྗེས་མུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གངལ་བསླབ་པར་བྱ་བའི་ཆུའི་ཁམས་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོངངོ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབཔར་བྱབའིམྱེའི་ཁམས་དེ་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་ངོ།",
    "འདིལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ནམ་མཁའི་ཁམས་དེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེསགདྲལབསླབ་པར་བྱ་བའིརྣམ་པར་ཤེས་བའི་ཁམས་དེ་ཡང་དགཔར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟརདེསགང་ལ་བསླབ་པར་བྱ་བའི་འདུ་བྱེད་དེ་ཡང་དག་པར་རྗེས་སུ་མྱྀམཐོདདོ།",
    "འདིལྟརདེསགངལབསླབཔརབྱབའིརྣམཔར་ཤེས་པ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་ངེསགང་ལ་བསླབ་པར་བྱ་བའི་སྐྱེ་མཆེད་དྲུག་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།་",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཚོར་བདེ་ཡང་དག་པར་རྗེསསུ་མྱིམཐོང་།",
    "འདི་ལྟར་དེ་གང་ལ་བསླབ་པར་བྱ་བའི་རྒ་ཤི་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདྲིལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའིསྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིནཔ་དེ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གངལ་བསླབ་པར་བྱབའི་བརྩོན་འཐུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་དག་པར་རྗེས་སུ་མིམཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་བར་བྱབའིབསམགཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ།",
    "ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟརདེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཕྱི་སྟོངཔ་ཉིད་དེ་ཡངདག་པར་རྗེས་སུམྱི་མཐོངངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཕྱིནང་སྟོང་པ་ཉིད་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོངངོ།",
    "འདི་ལྟར་དེས་གངལ་བསླབ་པར་བྱ་བའི་སྟོང་པ་ཉིད་སྟོང་པ་ཉིང་དེ་ཡང་དག་པར་རྗེས་སུ་མྱམཐོང་ངོ་། ཆེན་པོ་སྟོང་པ་ཧིང་ལམྱི་སློབ་སྟེ།",
    "འདི་ལྟརདེསགངལ་བསླབ་པརབྱབའིཆེནཔོ་སྟོང་པ་ཉིད་དུ་ཡངདག་པར་རྗེསསུ་མིམཐོངངོ།",
    "འདི་ལྟར་དེསགངལ་བསླབ་པར་བྱ་བའི་དོན་དམ་པ་སྟོང་བ་ཉིད་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདུསམ་བྱས་སྟོངཔ་ཉིད་ལམྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་དེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོངངོ།",
    "གང་ལ་བསླབ་པར་བྱ།",
    "དེཅི་འི་ཕྱིར་འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཡང་དག་པར་སྤོང་བ་དེ་དག་ཡང་དག་བར་རྗེས་སུ་མྱྀ་མཐོངངོ།",
    "འབིལྟར་ངེས་གྲང་ལ་བསླབ་པར་བྱབའི་རྫུའཕྲུལ་གྱི་རྐང་པ་དེདག་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདི་ལྟར་ངེས་གངལ་བསླབ་པར་བྱ་བའི་སྟོབས་ངོ་དག་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱདཔ་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱིས་ཐོང་ངོ།",
    "འདི་ལྟར་དེས་གྲང་ལ་བསླབ་པར་བྱ་བའི་འཕགས་པའི་བདེན་པ་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་ངོ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་བསམ་གཏན་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་བཞིལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་གཟུགསམྱེད་པའིསྙོམས་པརའཇུག་པ་དེདག་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུལ་མྱི་སློབ་སྟེ།",
    "འདྲི་ལྟརདེས་གང་ལ་བསླབ་པར་བྱ་བའི་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱམཐོང་ངོ།",
    "སྨོན་པམྱེད་པ་དེདག་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའིམ་ངོན་པར་ཤེས་པ་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཏིང་ངེ་འཛིན་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོད་ངོ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་གཟུངས་ཀྱི་སྒོ་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་དེ་བཞིན་གཤེགས་པའི་སྟོབས་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གངལ་བསླབ་པར་བྱ་བའི་ཕྱི་འཇིགས་པ་དེ་དག་ཡང་དག་པར་རྗེས་སུ་མྱྀ་མཐོངངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླ་བ་པར།",
    "འདི་ལྟར་ངེས་གྲང་ལ་བསླབ་པར་བྱ་བའི་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་དེ་ཡངདྲག་པར་རྗེསས་མི་མཐོང་ངོ།",
    "འདི་ལྟརདེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཕྱིར་མི་འོང་བའི་འབྲས་བུ་དེཡངདག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདིལྟ་བདེས་གང་ལ་བསླབ་པར་བྱབའི་ལམ་གྱིནམ་པ་ཤེས་པ་ཉིད་དཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིང་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་བཉི་དེཡང་དག་པར་རྗེས་སུ་མུ་མཐོང་ངོ།",
    "གཟུགས་ཡངདག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་འདུ་ཤེས་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་།",
    "ཅིའིཕྱིར་ན་འདུ་བྱེད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནརྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་མྱིག་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་།",
    "ཅིའི་ཕྱིརནསྣ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལྕེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལུས་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་།",
    "ཅིའི་ཕྱིརན་དྲ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་རྣབའི་རྣམ་བར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མུ་མཐོང་།",
    "ཅིའི་ཕྱིར་ནསྣའིརྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལྕེའི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མྱྀ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡངདག་པར་རྗེས་སུ་མྱིམཐོང་།",
    "ཅིའི་ཕྱིར་ནམེའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་།",
    "ཅིའི་ཕྱིར་ནརྣམ་པར་ཤེས་པའི་ཁམས་ཡང་དག་པར་རྗེས་སུ་བྱམཐོང་།",
    "ཅིའི་ཕྱིར་ནམ་རིག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིརན་འདུ་བྱེད་ཡད་དགྲ་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིཕྱིར་ན་མྱིང་དང་གཟུགས་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་།",
    "ཅིའི་ཕྱིར་ན་སྐྱེམཆེད་དྲུག་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཆོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལེན་པ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་སྐྱེ་བ་ཡང་དག་པར་རྗེས་སུ་མཐོང་།",
    "ཅིའི་ཕྱིར་ནབསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནནང་སྟོང་པ་ཉིད་ཡང་དག་པརརྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིརན་གྱི་སྟོང་པ་ཉིད་ཡ་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནཕྱིནང་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱྀམཐོང་།",
    "ཅིའི་ཕྱིར་ན་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཆེན་བོ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་དོན་དམ་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་འདུས་བྱས་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིརན་དོར་བསྐྱེད་པ་སྟོང་པཉིད་ཡང་དག་པར་རྗེས་སུམ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཚེས་ཐམས་ཅད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་རམྱི་དམག་ས་བསྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིང་ཡང་དག་པར་རྗེས་སུམྱམཐོང་།",
    "ཅིའི་ཕྱིརན་ངོ་བོ་ཉིད་སྟོངང་ཉིད་ཡང་དག་པར་རྗེསསུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིརན་དངོས་བསྐྱེད་བའི་ངོབོ་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེསུ་མུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་དྲན་པ་ཉེ་བར་། གཞག་པ་རྣམས་ཡང་དག་པརརྗེས་སུ་མྱིམཐོང་།",
    "ཅིའི་ཕྱིརན་རྫུའཕྲུལ་གྱི་རྐང་བརྣམས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནའཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡང་དག་པར་རྗེས་སུ་མྱྀ་མཐོང་།",
    "ཅིའི་ཕྱིར་ནའཕགས་པའི་བདེན་བརྣམས་ཡང་དག་པར་རྗེསསུ་མྱི་མཐོང་།",
    "མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་མཐར་ཀྱིས་གནས་བའི་སྙོམས་པར་འཇུག་པདགུ་ཡང་དག་པར་རྗེས་སུ་ཀྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནགཟུངས་ཀྱི་སྒོ་རྣམས་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པས་སྟོ་ངོ།",
    "རྣམ་པར་ཐརཔ་རྣམས་ཀྱིས་སྟོང་ངོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་སམཐར་ཀྱི་གནས་པའིསྙོམས་པརའཇུག་པ་རྣམས་ཀྱིས་སྟོདདོ།",
    "རྣམ་པ་ཐམས་ཅངམ་ཁྱེན་པ་ཉིད་རྣམ་པཐམསཅདམཁྱེན་བ་ཉིད་ཀྱིས་སྟོང་ངོ།",
    "ཚོར་བ་སྟོང་བ་ཉིད་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུམྱི་མཐོང་ངོ།",
    "རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཀྱིས་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱམཐོང་ངོ།",
    "ལྕེ་སྟོང་པ་ཉིད་ཀྱིས་ལྕེ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་སྱིམཐོང་ངོ།",
    "གཟུགས་སྟོང་པ་ཉིད་ཀྱིས་གཟུགས་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུམ་མཐོང་།",
    "རོ་སྟོང་པ་ཉིད་ཀྱིས་རོ་སྟོང་པ་ཉིད་ཡངདག་པར་རྗེསསུ་མཐོད་ངོ།",
    "རྣ་བའིརྣམ་པར་ཤེས་པ་སྟོངས་ཉིད་ཀྱིས་རྣ་བའི་རྣམ་པར་ཤེས་པ་སྟོད་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "ལྷའི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཀྱིས་ལྕེ་རྣམ་བར་ཤེས་པ་སྟོང་པ་ཉིད་ཡང་ངག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཀྱིས་ལུས་ཀྱི་རྣམ་པར་ཤེས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཀྱིས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་བྱ་སྟོང་ཉིང་ཡང་དྲུག་པར་རྗེས་སུ་མ་ཐོང་།",
    "མྱེའི་ཁམས་སྟོང་བ་ཉིད་ཀྱིས་མྱེའི་ཁམས་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་།",
    "འདུ་བྱེད་སྟོང་པ་ཉིད་ཀྱིས་འདུ་བྱེད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "རྣམ་པར་ཤེས་པ་སྟོང་བ་ཉིད་ཀྱིས་རྣམ་པར་ཤེས་པ་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མཐོང་ངོ།",
    "མྱིང་དང་གཟུགས་སྟོ་དཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་ངོ།",
    "ཁྱེམཆོད་སྐྱེ་མཆེད་དྲུག་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "སྲེདཔ་སྟེདག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "བཟོད་པའིཕ་རོལ་ཏུ་ཕྱིན་བ་སྟོང་པ་ཉིད་ཀྱིས་བཟོད་པའི་རོལ་ཏུ་ཕྱིན་པ་སྟོངཔ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་པོ།",
    "བརྩོ་ནའགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོ་བ་ཉིང་ཀྱིས་བརྩོན་འགྲུས་ཀྱི་རོལ་ཏུ་ཕྱིན་པ་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་བ་ཉིད་ཀྱིས་བསམ་གཏན་གྱི་ཕརོལ་ཏུ་ཕྱིན་པ་སྟོང་པ་ཉིང་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "སྟོང་བ་ཉིད་སྟོང་པ་ཉིད་སྟོང་བ་ཉིད་ཡ་དག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "འདུས་བྱས་སྟོང་བ་ཉིང་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུམ་མཐོངངོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱིས།",
    "པ་ཉིད་སྟོང་བཉིད་ཡང་དག་པར་རྗེས་སུམི་མཐོང་ངོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྟོང་པ་ཉིང་ཡང་དག་པར་རྗེས་སུ་མཐོང་ངོ།",
    "མི་དམིགས་པསྟོང་བཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུམྱིམཐོང་ངོ།",
    "ངོ་བོ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུམྱམཐོངངོ།",
    "ཡང་དག་བརསྤོང་བ་སྟོང་བཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "རྫུ་འཕྲུལ་གྱིན་པ་སྟོང་པ་ཉིད་ཡང་དག་པརརྗེས་སུ་མཐོང་དོ།",
    "འཕགས་པའི་བདེན་པ་སྟོད་ཡང་དག་པར་རྗེས་སུ་མིམཐོང་ངོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་སྟོ་པ་ཉིདཀྱིས།",
    "མཐར་ཀྱིས་གནས་པའིསྙོམས་པར་འཇུག་པ་སྟོངཔ་ཉིད་ཀྱིས།",
    "མཐར་ཀྱིས་གནུས་པའི་སྙོམས་པར་འཇུག་པ་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "སྨོན་པམྱེདཔ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "མངོན་། པར་ཤེས་པ་སྟོང་པ་ཉིད་ཀྱིས།",
    "ཏིང་ངེ་འཛིན་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "གཟུངས་ཀྱི་སྒོ་སྟོང་བ་ཉིད་ལ་ངདག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "མྱི་འཇིགས་པསྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་སྟོང་པ་ཉིད་ཀྱིས།",
    "སོ་སོ་ཡང་དག་པར་རིག་བྱ་སྟོང་པ་ཉིང་ལང་དག་པར་རྗེས་སུ་མྱི་མཐོངང་།",
    "བྱམས་བཆེན་པོ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ཐམས་ཅད་ཤེས་བ་ཉིད་སྐྱོངཔ་ཉིད་ཡང་དག་པར་རྗེས་སུམ་མཐོང་ངོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་སྐྱོང་བ་ཉིད་ཀྱིས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་སྟོང་བ་ཉིད་ཡང་དག་པར་རྗེས་སུམ་མཐོང་ངོ།",
    "དེ་གཉིས་སུ་བྱརམྱེད་པར་འདུ་ཤེས་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་འདུ་བྱེད་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ག་ཉིས་སུ་བྱརམྱེད་པར་རྣམ་པར་ཤེས་པ་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་ན་བསྟོང་པ་ཉིང་ལ་སློབ་བོ།",
    "དེག་ཉིས་སུ་བྱར་བྱེདཔར་སྣ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མེད་པར་ལུས་སྟོང་པ་ཉིང་ལ་སློབ་དེ་གཉིས་སུ་བྱར་མྱེད་པར་ཡིད་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་བྱེད་པར་གཟུགས་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མེད་པར་དྲི་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེག་ཉིས་སུ་བྱར་མེད་པར་ལྕེའི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱར་མྱེདཔར་ནམམཁའི་ཁམས་སྟོང་པ་ཉིད་ལསློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་རྣམ་པར་སྟོང་བ་ཉིད་ལ་སློ་བ་འོ།",
    "དེ་གཉིས་སུ་བྱར་མེད་པར་མ་རིག་བ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་འདུ་བྱེད་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱརམྱེད་པར་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱར་མྱེད་པར་མྱྀང་དངག་ཟུགཟུགས་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱར་མེད་པར་སྲེད་པ་སྟོང་བཉིད་ལསློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་ལེན་པ་སྟོང་བ་འདི་ལ་སློབ་བོ་། དེ་ག་ཉིས་སུ་བྱར་མྱེད་པར་སྲིད་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་བྱེད་པར་སྐྱེ་བསྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེག་ཉིས་སུ་བྱར་མྱེད་པར་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མེད་པར་དངོས་པོ་མྱད་པའི་ངོཔོ་ཉིད་སྟོང་བ་བ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱར་ཆུད་པར་དྲན་བ་ཉེ་བར་གཞག་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མེད་པར་རྫུ་འཕྲུལ་གྱི་རྐང་བ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དག་ཉིས་སུ་བྱར་མེདཔ་ར་མཐར་ཀྱིས་གནས་པའིསྙོམས་པར་འཇུག་པ་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་ཏིང་ངེ་འཛིནསྟོངས་པཞིིདི་ལསློབ་བོ།",
    "དེ་ག་ཉིས་སུ་བྱར་མྱེད་པརགཟུངས་ཀྱི་སྒོ་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱར་མེད་བརས་སོ་ཡང་དག་པར་རིག་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིསསུ་བྱར་མེད་པར་ཐམས་ཅད་ཤེས་བཉིད་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེགཉིས་སུ་བྱར་མེད་པར་ལམ་གྱི་རྣམ་པ་ཤེས་པཉིད་སྟོང་བ་ཉིང་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་བྱེད་པར་རྣམ་བཐམས་ཅད་མཁྱེན་བ་ཉིད་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "རྒྱག་སྟོང་པ་ཉིད་ལ་གང་གཉིས་སུ་བྱརམྱེད་པརསློབ་པ་དང་།",
    "ཡིདསྟོང་བཉིད་ལག་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "གཟུགས་སྟོང་བ་ཉིད་ལ་གང་གཉིས་སུ་བྱར་མེད་པར་སློབ་པ་དང་།",
    "དྲི་སྟོང་བ་ཌིད་ལ་ག་ང་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "རོ་སྟོང་པ་ཉིད་ལ་གངགཉིས་སུ་བྱར་མེད་པར་སློབ་པ་དང་།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ལགང་གཉིས་སུ་བྱར་མེད་པར་སློབ་པ་དང་།",
    "སྣའི་རྣམ་པར་ཤེས་བསྟོང་པ་ཉིད་ལག་ང་གཉིས་སུ་བྱར་མེད་པར་སློབ་པ་དང་།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ལ་གངགཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ལག་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྣང་བཞིང་ལགངགཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "རྣམ་བར་ཤེས་པ་སྟོང་པ་ཉིད་ལ་གང་གཉིས་སུ་བྱ་མེདཔར་སློབ་པ་དང་།",
    "སྐྱེ་མཆེད་དྲུག་སྟོང་ལག་ང་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་བདད།",
    "ལེན་པ་སྟོང་པ་ཉིད་ལ་གང་གཉིས་སུ་བྱར་མྱེདབ་རསློབ་བདབསྲིད་པ་སྟོདཔ་ཉིད་ལག་དག་ཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "སྐྱེ་བ་སྟོང་པ་ཉིད་ལགངགཉིས་སུ་བྱར་མེད་པར་སློབ་པ་དང་།",
    "རྒ་ཤི་སྟོང་པ་ཉིད་ལ་གང་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིནབ་སྟོངབ་ཉིང་ལགང་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "དངོས་བམྱེད་པའི་ངོ་བོ་འདི་སྟོང་པ་ཉིད་སྟོང་བ་ཉིད་ལགངགཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་བ་འགང་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "གཟུགསམྱེདཔའི་སྙོམས་པར་འཇུག་གཉིས་སུ་བྱརམྱེད་བར་སློབ་པ་དང་།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་བསྟོང་པ་ཉིང་ལ་གང་གཉིས་སུ་བྱར་མྱེདཔར་སློབ་པ་དང་།",
    "ཏིང་ངེ་འཛིན་སྟོང་པ་ཉིད་ལ་གང་ལྷོ་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "མྱི་འཇིགས་པ་སྟོང་པ་ཉིད་ལ་གང་གཉིས་སུ་བྱར་བྱེད་པར་སློབ་དང་སོ་སོ་ཡང་དག་པར་རིག་བསྟོང་པ་ཉིད་ལ་གངག་ཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "བྱམས་པ་ཆེན་པོ་སྟོང་པ་ཉིད་ལ་གང་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "ཐམས་ཅད་ཤེས་པ་ཉིད་སྟོང་བ་ཉིད་ལགངག་ཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "དེནིགཉིས་སུ་བྱ་མྱང་པར་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སློབ་བ།",
    "དེ་ནག་ཉིས་སུ་བྱརམྱེད་པར་འདུས་བྱས་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནིག་ཉིས་སུ་བྱར་མྱེད་པར་འདུས་མ་འདས་པ་སྟོང་བཉིད་ལ་སློབ་བོ།",
    "དེ་ནཾགཉིས་སུ་བྱར་མྱེད་པར་དོར་བགྱེད་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནིག་ཉིས་སུ་ཁྱར་མེད་པར་རང་བཞིན་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནིག་ཉིས་སུ་བྱར་བྱེད་པར་མི་དམིགས་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མྱེད་པར་ངོ་བོ་ཉིད་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མེད་པར་དྲན་པ་ཉེ་པར་གཞག་པ་རྣམས་ལ་སློབ་བོ།",
    "སུ་བྱར་མྱེད་བར་ཡང་དག་པར་སྤོང་བ་རྣམས་ལ་སློབ་བོ།",
    "དེ་ནིག་ཉིས་སུ་བྱུར་མྱེདཔར་རྫུ་འཕྲུལ་གྱི་རྐང་བ་རྣམསལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མྱེད་པར་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱདབ་ལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མེད་པར་བསམ་གཏན་རྣམས་ལ་སློབ་བོ་། དེ་ནིགཉིས་སུ་བྱ་ཕྱེད་བར་ཚད་བྱེདབརྣམས་ལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མྱེད་བར་རྣམ་པར་ཐར་བ་རྣམས་ལ་སློབ་བོ།",
    "དེ་ནི་ཉིས་སུ་བྱར་མེད་པར་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མྱེདཔར་སོ་སོ་ཡ་ང་དག་པར་རགེ་པ་རྣམས་ལ་སློབ་བོ།",
    "དེན་གཉིས་སུ་བྱར་བྱེད་པར་བྱམས་པ་ཆེན་པོ་ལ་སློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མྱེདཔར་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ལ་སློབ་བོ།",
    "དེ་ནིགཉིས་སུ་བྱར་མྱེད་པར་དགྲ་བཅོམ་པ་ཉིད་ལསློབ་བོ།",
    "དེ་ནི་གཉིས་སུ་བྱར་མྱེད་པར་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་དེ་ལ་སློབ་བོ།",
    "གཉིས་སུ་བྱར་སྐྱེད་པར་བརྩོན་འགྲུསཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གདསློབ་པ་དང་།",
    "གཉིས་སུ་བྱར་མེད་པར་སྟོདཔ་ཉིད་སྟོང་བཉིད་ལ་གང་སློབ་པདང་།",
    "གཉིས་སུ་བྱར་མེད་པར་མཐའ་ལས་འདས་བསྟོང་བ་ཉིད་ལ་གང་སློབ་པ་དང་།",
