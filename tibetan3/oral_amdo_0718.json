    "དམིགས་རྩེ་རྣོ་ཞིང་མཛངས་པའི་འགྲོ་བ་འདི་དག་ཁྱོད་ཀྱི་སྒོ་ཕྱུགས་འཚོ་བའི་བཙག་ཁའི་རྫི་བོ་ཡིན་ནམ།",
    "བརྩེ་དུངས་ཀྱི་མཚོ་མོ་ལྷོག་ལྷོག་རྒྱས་པའི་འགྲམ་ངོགས་སུ།",
    "ཁྱོད་མིན་ནམ།",
    "བྱ་རྒོད་ཀྱི་གཤོག་ཟུང་ཁྱོད་ལ་གཏད་ཡོད།",
    "ཉི་ཟླ་མཆན་འོག་ལ་བཙིར་ནས་རྒས་སོང་འདྲའི་བཤུལ་ལམ་རིང་མོ།",
    "ད་དུང་ཐག་རིང་གི་མ་འོངས་པའི་འབབ་ཚིགས་ལ་བསྙེག་བསམས་པས་ཡིན།་།",
    "ཁྱོད་ཀྱིས་སྤྲེའུ་དེ་དག་ལའང་ལོ་མའི་སྒྲིབ་གཡོགས་ཤིག་ལས་ཅི་ཡང་མི་གནང་བར།",
    "འ་༡༡ ཀ་མཚོ་མོའི་ངམ་ཁར་ཟུག་པའི་འཇའ་ཚོན་བཞིན་མཛེས་ཤིང་ཡིད་དུ་འོང་།",
    "འཛམ་གླིང་རང་བྱུང་ཐེབས་རྩ་ཚོགས་པ་དང་སྦྲང་ཆར་རྩོམ་སྒྲིག་ཁང་གིས་མཉམ་སྒྲུབ་བྱས།",
    "སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཙམ་ཡོད།",
    "སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི་ཡོད།",
    "སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཡོད།",
    "སྣུམ་ཚོན་རི་མོ་ཚེ་རིང་རྡོ་རྗེས་བྲིས།",
    "བླང་དོར་བློ་མིག་རང་སྲུང་གི་རྩིས་ཐང་སོགས་ལ་འབྲེལ་བས་ན།",
    "ང་ཚོས་ནམ་རྒྱུན་སྙན་ངག་པར་འགན་འཁྲིའི་འདུ་ཤེས་དང་མི་གཞི་དྭངས་གཙང་དགོས་ཚུལ་གྱི་གླེང་གཞི་སློང་གིན་པའང་མཐར་དེད་ན་སྙན་ངག་གི་རྩིས་ཐང་ལ་དོ་གཟབ་གནང་བར་བསྐུལ་བ་ཡིན་སྙམ།",
    "སྙན་ངག་གིས་ནི་ནམ་ཡང་ཕྱི་ཁ་སྤམ་ཆེ་བ་ཞིག་ཀྱང་ཡིན་པར་སེམས།",
    "ང་ཚོས་རྒྱལ་ཁབ་ཕྱི་ནང་གི་སྙན་ངག་དང་མི་མིའི་རིགས་ཀྱི་ནང་སེམས་རྒྱུད་ཀྱི་མཛེས་པ་དང་རིགས་གཞན་གྱི་སྙན་ངག་ཡང་ན་རང་ཉིད་ཀྱིས་བསམ་པའི་ཀུན་སློང་གི་དྭངས་གཙང་ལ་རེ་འབོད་བགྱི་དགའ་མགུ་ལྷོད་པའི་སྙན་ངག་པ་གང་དང་སུ་རུང་གི་བ་ཡིན་པར་སེམས།",
    "གཞན་སྙན་ངག་གིས་མིའི་རིགས་ལ་བཟུང་བའི་རྣམ་འགྱུར་པའི་གདོང་དུ་སྤྲད་ན་ག་ལ་མཛེས།",
    "འུད་བསྟོད་དང་ངོམ་རང་གི་སྙན་ངག་ཏུ་མི་འགྱུར་ཏེ།",
    "གི་ཚབ་མཚོན་མི་རུང་བས་སོ་ཞེས་པ་ནང་བཞིན་ནོ།",
    "མིའི་རིགས་ཀྱི་བླ་སྲོག་གི་སྒྲ་དབྱངས་ལ་རིགས་ཤིག་གམ་དུས་རབས་ཤིག་གི་སྙན་ངག་གི་ཉན་པར་མཁས་པའི་བློ་མིག་དོག་ཡངས་ལས་འཇིག་འཕེལ་རྒྱས་དང་འོད་སྟོང་འཕྲོ་བའི་གྲུབ་འབྲས་ཉིད་རྟེན་གྱི་ཤེས་ནུས་བསྐྱེད་པར་ནུས་ཚེ།",
    "སྙན་ངག་གི་ནི་སྙན་ངག་པའི་ཁ་གྲངས་ལས་འཕགས་པ་མིན་པར།",
    "སྙན་ངག་སོགས་སྙན་ངག་འཁྲུངས་པའི་རྒྱུ་རྐྱེན་དུ་གྲུབ་ཅིང་མི་གི་རྩིས་ཐང་ནི་སྙན་ངག་པའི་མི་གཞིའི་རྩིས་ཐང་ཡིན་གཤིས་ཀྱི་དྭངས་མ་ཉིད་ནི་སྙན་ངག་གི་སྲོག་རྩར་ལ།",
    "ང་ཚོས་སྙན་ངག་གི་རྩིས་ཐང་ལ་རྡོག་སྙན་ངག་འབྲི་བ་ནི་རང་དོན་ཁོ་ན་ཡིན་པར་བརྫིས་མི་གཏོང་བར་སྲུང་འཛིན་དང་དོ་སྣང་བགྱི་སྨྲ་བ་དག་ལ་ནི་མི་འཐད་དེ།",
    "ཨའེ་ཆིང་རྩ་གིས།",
    "བ་ག་དུ་མ་ལྷག་བསམ་དར་དཀར་གཅིག་གིས་སྦྲེལ་པའི་ཕུ་ནུའི་དཔུང་རྡང་གངས་རིའི་རྒྱན།",
    "བདག་ཀྱང་གངས་དཀར་ཨ་མའི་པང་ནས་བཞད་པའི་མུ་ཏིག་རྡོག་ཅིག་ལགས།",
    "བརྗིད་ཆགས་རི་བྲག་སྟོང་གི་དབུས་ན་གངས་ཀྱི་རྒྱལ་མོའི་དབུ་འཕང་མཐོ།",
    "དབྱིག་འཛིན་སྒེག་མོའི་ཚེ་བསོད་དབུ་འཕང་གཡོ་མེད་རྡོ་རྗེའི་ཁམས་སུ་བསྐྱེད།",
    "རི་སྐེད་ཚང་ཚིང་ནགས་ཀྱིས་བཏུམས་པས་གཡུ་ཡི་མཚོ་མོ་འཁྱིལ་དང་མཚུངས།",
    "རི་མཐར་སྤང་རྒྱན་མེ་ཏོག་བཀྲ་བས་ཟ་འོག་ཟེར་མའི་རི་མོ་བཞིན།",
    "ཁུ་བྱུག་བུ་མོའི་འགྱུར་ཁུགས་དཀྲོལ་བའི་རྫོགས་ལྡན་དཔྱིད་ཀྱི་མེ་ཏོག་བཞད།",
    "འཇོལ་མོའི་གཤོག་འགྱུར་ཅི་དགར་བསྒྱུར་སའི་སྤང་དཀར་རྩྭ་ཐང་མཛེས་པས་བརྒྱན།",
    "དེང་རབས་ལང་ཚོ་བཅུད་དུ་སྨིན་པའི་སྦྲ་གུར་སྐར་ཚོགས་བཞིན་དུ་བཀྲམ།་",
    "གྲང་རེག་བུ་མོའི་ཏིང་འཛིན་ཀློང་ལས་འཕྱོ་ཞིང་ཐོལ་གྱིས་རྡོལ་བཞིན་དུ།",
    "འགྲན་པའི་སྟོབས་དང་རྒོལ་བའི་མཐུ་ནི་བདག་ལ་གང་ཡང་མ་མཆིས་མོད།",
    "གངས་དཀར་ཨ་མའི་མངལ་ལས་བརྡོལ་བའི་དྲི་མེད་རྫ་ཆུ་བསིལ་མ་ང་།",
    "འདི་ལ་ཡིད་ཆེས་དང་བ་ཟབ་པས་སྐྱབས་བཅོལ་རེ་བའི་གུས་ཕྱག་འབུལ།",
    "འདི་ལ་ཤ་རུས་བརྩེ་འདང་ཆེ་བས་སྙན་མོ་གླུ་ཡིས་ཡང་ཡང་བསྟོད།",
    "འདི་ལྟར་ངོ་མཚར་བརྗོད་དུ་མེད་པའི་ལང་ཚོའི་འཇོན་ཐང་ཁྱོད་ལ་རྫོགས།",
    "ཡིད་ཐུལ་དཀར་འབྲི་མོའི་འོ་མ་དང་ནི་བདུད་རྩི་ཚང་གི་བཟི་ཁ་བཞིན།",
    "བདེ་མོའི་ཐང་ན་དར་དཀར་འཐེན་འདྲའི་རེག་འཇམ་དགུ་ཚིགས་སྐུ་མོ་ང་།",
    "འགྲོས་མྱུར་གློག་དམར་འཁྱུག་པའི་གར་སྟབས་བདག་ལུས་ཕྲ་མོར་མ་འཛོམས་ཀྱང་།་",
    "ལྟ་བུ་འཁྱག་དར་སྲ་མོའི་སྦུབས་ལས་གྲོལ་པའི་རླན་གཤེར་ལྷ་ཆབ་སྔོན་མོ་ང་།",
    "མཚོ་ལྷོ་ཐོལ་བྱུང་གི་གླུ།",
    "ཁོ་བོའི་སྙན་ངག་གི་བསླུ་བྲིད་མ་བཟོད།",
    "རི་སྤྱང་ངུ་ཟུག་གི་སྐྱོ་ཉམས་མངོན་དུས།",
    "དབྱར་གཞུང་མེ་ཏོག་གི་འཛུམ་མདངས་ཡལ་དུས།",
    "དེའིདབེན་པའི་རི་གྲོང་གི་ཏིང་འཛིན་བརྟན་པོར།",
    "གནས་ལུགས་བདེན་སྟོང་གི་རི་མོ་མ་ཤར།",
