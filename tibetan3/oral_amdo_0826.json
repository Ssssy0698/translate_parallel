    "པའི་བ་གླང་དེ་གཉི་ག་ལའང་ཐུན་མོང་དུ་ཡོད་པ་ཡིན་པའི་ཕྱིར།",
    "དེས་ན་སྤྱི་སྒྲ་འཇུག་པ་ལ་སྤྱི་དོན་གཞན་དགོས་པ་མ་ཡིན་པར་ཐལ།",
    "དོན་གསལ་བ་རྣམས་ལ་ཐ་དད་པའི་སྤྱི་གཞན་མེད་པར་ཡང་སྤྱི་སྒྲ་འཇུག་གི་སྒྲ་ཐ་དད་ཁོ་ནར་འཇུག་པ་མི་རིཊ་པའི་ཕྱིར།",
    "སྤྱི་དོན་གཞན་མེད་ཀྱང་ཁྱད་པར་མེད་པའི་འབྲས་བུ་དེ་བསྐྱེད་པའི་ནུས་པའི་སྒོ་ནས་སྤྱི་སྒྲ་གཅིག་གིས་སྟོན་པ་དག་ནི་སྲིད་པར་འགྱུར་ཏེ།",
    "རྐྱེན་གསུམ་དེའི་ངོ་བོ་རང་གི་སྤྱི་ལས་རྫས་ཐ་དད་དུ་མེད་དུ་ཟིན་ནའང་།",
    "བརྡ་ལས་བྱུང་བའི་སྤྱི་སྒྲ་གཅིག་གིས་བསྙད་པར་བྱས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "གལ་ཏེ་གསལ་བ་མང་པོ་དག་ལ་སྤྱི་གཞན་དངོས་པོ་བ་གཅིག་གནས་པ་ཡི་ཕྱིར་ཡང་མཉན་པ་ཐུན་མོང་བ་གཅིག་འཇུག་སྟེ།",
    "དེ་ལྟར་སྤྱི་དེ་ལ་གཉི་ག་མི་རིགས་པར་ཐལ།",
    "རང་ནང་གི་རྒྱ་ཤུག་ལ་ཕན་མི་འདོགས་བཞིན་དུ་རྟེན་བྱེད་པ་མིན་པར་ཐལ།",
    "ཁྱོད་ཀྱིས་དེའི་རིགས་འདྲ་ཕྱི་མ་རྣམས་རིགས་འདྲ་སྔ་མ་རྣམས་དང་།",
    "གསལ་བ་དེ་ཁྱོད་གྲུབ་ཟིན་གནས་པའི་རྟེན་དུ་དགོས་པ་མིན་པར་ཐལ།",
    "དེ་མེད་ན་ཡང་ཁྱོད་རྟག་པའི་དངོས་པོར་གནས་པའི་ཕྱིར།",
    "གསལ་བ་དེ་ཁྱོད་ཀྱི་གྲུབ་ཟིན་གནས་པའི་རྟེན་ཡིན་པ་དེ་ཡང་མི་རིགས་ཏེ།",
    "ཁྱོད་ཀྱི་གནས་པ་ཁྱོད་ལས་རྫས་ཐ་དད་དང་།",
    "ཁྱོད་སྒྲོན་འོད་ཀྱི་གསལ་བྱ་ཡིན་པར་ཐལ།",
    "༧༧བ་དེ་ཁྱོད་ཀྱི་རྒྱུར་འདོད་རིགས་ཏེ།",
    "རང་འཛིན་ཤེས་པ་བབསྐྱེད་གསལ་བ་དེ་ལ་བལྟོས་པ་མི་རུང་བར་ཐལ།",
    "དེའི་སྔ་ནས་རྟག་པར་གནས་པའི་ཕྱིར་སྤྱི་ལྡན་གསལ་བ་ལས་གསལ་བར་བྱས་པ་གང་ལས་ཡིན་ཏེ་མ་ཡིན་པར་ཐལ།",
    "ཁྱོད་འགྱུར་བ་མེད་པའི་ཕྱིར།",
    "དེ་དག་གིས་དོན་གཞན་གྱི་གསལ་བྱ་གསལ་བྱེད་ཀྱི་ཚུལ་རྒྱུ་འབྲས་བུ་གནས་པ་ཡིན་ལ་རྟག་པ་ལ་དེ་མི་སྲིད་ཅེས་བསྟན་པ་དང་།",
    "འང་གི་སྒྲས་སྒོ་དེས་ཀྱང་སྤྱིའི་གསལ་བྱེད་དུ་མི་འཐད་ཅེས་པའོ།",
    "བ་གླང་ཉིད་ལ་སོགས་པ་དེ་དང་ལྡན་པ་འཐོབ་པར་ཐལ།",
    "༧༨ན་སྒྲོན་འོད་ལ་བ་གླང་ངོ་སྙམ་པའི་བློ་སྐྱེ་བར་ཐལ་ལོ།",
    "སྔོན་མེད་གསར་བྱུང་གི་བ་གླང་གི་གསལ་བ་རྣམས་ལ་འདི་བ་གླང་ངོ་སྙམ་པའི་སྤྱིའི་བློ་གྲོས་སྐྱེ་བ་ཇི་ལྟར་ཡིན་པ་མི་འཐད་པར་ཐལ།",
    "སྔར་བྱུང་གི་གསལ་བ་གཅིག་ལ་ཡོད་པར་མཐོང་བ་ནི་གསལ་བ་གཞན་ལ་མཐོང་བ་མི་སྲིད་སྤྱི་ལ་ཆ་ཤས་མེད་པའི་ཕྱིར།",
    "གསལ་བ་སྔ་མ་ལས་རྫས་གཞན་མིན་པར་གཅིག་ན་གསར་བྱུང་གི་གསལ་བ་ལ་རྗེས་འགྲོ་མེད་པར་ཐལ།",
    "རྫས་གཞན་ཉིད་ཡིན་ན་དེ་ལ་བརྟེན་པ་མིན་པར་ཐལ།",
    "གསར་བྱུང་གི་བ་གླང་ལ་སྤྱི་མེད་པར་ཐལ།",
    "སྔ་ནས་ཡུལ་གཞན་ན་ཡོད་པའི་བ་གླང་གི་སྤྱི་དེ་དེ་ལ་རྗེས་སུ་མི་འགྲོ་ཞིང་སྤྱི་ལ་ཆ་ཤས་མེད་པའི་ཕྱིར།",
    "ཡུལ་དེ་ན་སྤྱི་སྔ་༧༨བ་ནས་ཡོད་པའང་མིན་པར་ཐལགསལ་བ་མེད་པའི་སྤྱི་ཁས་མ་བླངས་པའི་ཕྱིར།",
    "གསལ་བའི་ཕྱིས་སྤྱི་ཡོད་པའང་མིན་པར་ཐལ།",
    "སྤྱི་ཆ་གཅིག་གསལ་བ་སྔ་མ་ལ་གནས་ནས་ཆ་གཅིག་ཕྱི་མ་ལ་འཕོས་པ་མ་ཡིན་པར་ཐལ།",
    "རྗེས་སུ་བརྩེ་བས་ན་ཀྱེ་མ་སྤྱི་འཇོག་ཚུལ་དེ་སྤྱིས་ཕོངས་པའི་རྒྱུ་ཉིད་ཡིན་པར་ཐལ།",
    "འོ་ན་རྡུལ་ཕྲན་ཆ་མེད་གཅིག་རང་གི་གསལ་བ་དུ་མ་ལ་རྗེས་སུ་འགྲོ་བ་མི་སྲིད་པར་ཐལ།",
    "རང་མ་ཡིན་པའི་རང་གི་ཆ་རྫས་ཐ་དད་དུ་མ་དང་མི་ལྡན་པའི་དོན་ཡིན་ལ།",
    "སྔ་མ་དེ་ལས་གནས་གཞན་དུ་སྐྱེས་པའི་གསལ་བ་ལ་སྤྱི་གནས་པ་ཤིན་ཏུ་རིགས་པར་ལྡན་ཏེ་མི་རིགས་པར་ཐལ།",
    "གཞན་གསལ་བ་སྔ་མ་ལ་གནས་པར་གྱུར་པའི་སྤྱི་ནི་རང་གི་གནས་ལས་གཞན་དུ་མི་གཡོ་ཞིང་སྤྱི་ལ་ཆ་ཤས་མེད་པའི་ཕྱིར།",
    "གསལ་བའི་ཡུལ་དེ་དག་གི་ཡུལ་ན་ཡོད་པ་ཅན་གྱི་གསར་བྱུང་གི་གསལ་བ་༧༩ན་ལ་ཁྱབ་པ་ངོ་མཚར་ཆེ་སྟེ་མི་རིགས་པར་ཐལ།",
    "གང་ན་གསར་བྱུང་གི་གསལ་བའི་དངོས་པོ་དེ་གནས་པར་གྱུར་པའི་ཡུལ་དེར་ནི་སྔ་ནས་ཁྱོད་འབྲེལ་ཞིང་ཡོད་པའང་མ་ཡིན་པའི་ཕྱིར།",
    "དཔེ་ལུ་ཀ་ན་རེ།",
    "ཁྱོད་ཡུལ་གཅིག་ཏུ་བློ་ཡུལ་དུ་གསལ་བས།",
    "གསལ་བ་ཡོད་མེད་ཀྱི་ཡུལ་ཀུན་ཏུ་འདུག་པ་མཐོང་བར་ཐལ།",
    "ཁྱོད་ཡུལ་གཅིག་ཏུ་གསལ་བ་གང་ཞིག།",
    "གསལ་བ་མཐོང་ནས་དེས་གསལ་བར་བྱས་པ་ལ་བལྟོས་པས་གསལ་བ་མེད་པའི་ཡུལ་དང་གསལ་བ་མ་མཐོང་བའི་ཡུལ་ན་ཡོད་པ་མཐོང་བར་ཐལ་བའི་ཉེས་པ་མེད་དོ་ཞེ་ན།",
    "བློ་ཡུལ་དུ་འགྱུར་བ་གསལ་བས་གསལ་བར་བྱས་པ་ལ་བལྟོས་པ་མིན་པར་ཐལ།",
    "ཁྱོད་མཐོང་བའི་སྒོ་ནས་གསལ་བ་ལ་སྒྲ་བློ་འཇུག་དགོས་པ་གང་ཞིག།",
    "གསལ་བས་སྤྱི་གསལ་བ་ལ་བལྟོས་པ་སྤྱི་དང་དེ་དང་ལྡན་པའི་གསལ་བ་དག་ཅིའི་ཕྱིར་ན་རྟོགས་ཚུལ་གོ་ལྡོག་པར་འདོད་དེ་མི་རིགས་པར་ཐལསྔར་སྤྱི་མཐོང་ནས་གསལ་བ་ལ་སྒྲ་བློ་འཇུག་དགོས་༧༩བ་པར་ཁས་བླངས་པ་དང་འགལ་བའི་ཕྱིར།",
    "སྤྱི་སྒྲ་དང་སྤྱི་བློ་སྐྱེ་བ་ལ་སྤྱི་དོན་གཞན་ངེས་པར་དགོས་པ་མིན་པར་ཐལ།",
    "ཐབ་འཛུགས་པའི་ལས་དོན་གཞན་སྤྱི་བློའི་སྒྲ་རྟོག་གི་རྒྱུར་མི་འཐད།",
    "ཐབ་འཛུགས་པའི་ལས་འགགས་པའི་སྐྱེས་བུ་དུ་མ་ལ་འཚེད་པ་པོའི་སྒྲ་མི་འཇུག་པར་ཐལ།",
    "ཐལ་བ་བཞི་ཀའི་ཁྱབ་པ་ཁས་བླངས་སོ།",
    "ལས་ཀྱི་རིགས་ལས་དང་དེ་སྐྱེས་བུ་ལ་འཕྲོད་༨ན་འདུ་འབྲེལ་བས་བརྒྱུད་ནས་ལས་ཀྱི་རིགས་སྐྱེས་བུ་ལ་སྒྲ་རྟོག་གི་རྒྱུ་ཡིན་ནོ་ཞེ་ན།",
    "ལས་ཀྱི་སྤྱི་དེ་ལས་འགགས་པའི་སྐྱེས་བུ་དུ་མ་ལ་སྤྱི་སྒྲ་ཡི་རྒྱུ་ཡིན་པ་མི་རིགས་པ་མིན་པ་མིན་ནས་མི་རིགས་པར་ཐལ།",
    "ཁྱབ་པར་ཐལ།",
    "འབྲེལ་བ་མེད་ཀྱང་སྒྲ་རྟོག་གི་རྒྱུ་ཡིན་ན་ཧ་ཅང་ཐལ་བའི་ཕྱིར།",
    "དངོས་སུ་སྒྲ་བློ་མི་འཇུག་པར་ཐལ་ཞེས་པའོ།",
    "དེ་རྣམས་ལ་ཐུན་མོང་དུ་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཕྱིར།",
    "དེ་དག་གིས་ལས་དང་ལས་ཀྱི་རིགས་དང་ལས་ཀྱི་ནུས་པ་གསུམ་དུ་བསྡུས་ནས་དགག་པ་མཛད་དོ།",
    "ཞེས་པ་ནི་ཁོ་བོ་ཅག་གི་གཞུང་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།"
