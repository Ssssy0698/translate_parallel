    "འདིར་ཡང་དེ་རྣམས་དང་དཀྱིལ་འཁོར་གྱི་བདག་བོ་ནས་བརྩམས་ཏེ་གནོད་མཛེས་ཀྱི་མཐར་ཐུག་པ་ཞེས་པ་ལ་སོགས་པ་དང་སྔགས་གཞན་རྣམས་ཀྱང་ཤེས་པར་བྱའོ།",
    "འདི་ཡང་དེ་རྣམས་ཀྱི་མངའ་བདག་ནས་བརྩམས་ཏེ་གནོད་མཛེས་ཀྱི་མཐར་ཐུག་པ་ཞེས་པ་ལ་སོགས་པ་ནི་འདུས་པའི་གཏོར་མའི་ཆོ་ག་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཨ་ཡིག་སྔོན་དུ་ཨི་མཾ་བ་ལིཾ་གྲྀ་ཧྞ་གྲྀ་ཧྞ་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ཁྱིམ་དང་གཙུག་ལག་ཁང་ལ་སོགས་པ་བསྲུང་བ་དང་བདེ་ལེགས་སུ་བྱ་བའི་དོན་དུ་དཔལ་ལྡན་དཔུང་པ་བཟང་པོས་ཡོངས་སུ་ཞུས་པ་རྣལ་འབྱོར་གྱི་རྒྱུད་ཆེན་པོར་གསུངས་པའི་སྔགས་ཀྱི་ཚིགས་སུ་བཅད་པ་རྣམས་ཀྱིས་ཆོ་ག་བཞིན་དུ་གཏོར་མ་སྦྱིན་པར་བྱའོ།",
    "ཡན་ལག་བཅུ་པའི་བདུག་སྤོས་དང་སྣང་གསལ་ལ་སོགས་པ་ཇི་ལྟར་རྙེད་པ་དང་ཇི་ལྟར་ནུས་པས་བདེ་ལེགས་སུ་འགྱུར་བའི་དོན་རྣམས་ཉེ་བར་གསོག་པར་བྱེད་དོ།",
    "རིན་ཆེན་གནས་ན་ལྷག་པར་གང་གནས་དང་།",
    "འདི་རྣམས་བཞེས་ནས་གསོལ་ཞིང་བཏུང་བར་མཛོད།",
    "འདིར་ཡང་ལས་ཀྱི་འབྲས་བུ་ལྡན་པར་མཛོད།",
    "ཁྱད་འཕགས་གཏོར་མ་འདི་ནི་བཞེས་སུ་གསོལ།",
    "ས་འཛིན་ལྷ་དང་གཙང་བའི་ཚོགས་བཅས་ལ།",
    "ཚིམ་ཞིང་ཐོབ་པས་བཞེས་པར་མཛད་ནས་སུ།",
    "འདིར་ཡང་ལས་ཀྱི་འབྲས་བུ་ལྡན་པར་མཛོད།",
    "ཞོ་དང་ཟན་དང་ཛམྦུ་ཏི་ཀ་རྣམས་སྣོད་གཅིག་ཏུ་བསྲེས་ནས་པི་ཌ་ཀ་ལ་སོགས་པར་བྱ་ཞིང་།",
    "ཏིལ་དང་འབྲས་ཡོས་ནི་སྣོད་སོ་སོར་བྱས་ནས་གཡས་སྐོར་གྱིས་ཁྱིམ་ལ་སོགས་པའི་ཕྱི་རོལ་ནས་ཞུགས་ཏེ་གཏོར་མ་སྦྱིན་པར་བྱའོ།",
    "སྔ་དྲོའམ་དུས་ཁྱད་པར་ཅན་གྱི་དུས་སུ་གཏོར་མ་དབུལ་བར་བྱ་ཞིང་སྔ་དྲོའི་ཉི་མ་ལ་གཏོར་མ་བྱིན་པའི་ཕྱི་ནས་སློབ་དཔོན་གྱིས་ཁ་ན་མ་ཐོ་བ་མེད་པའི་བཟའ་བ་རྣམས་ཆུ་ཚོད་བདུན་ན་བཟའ་བར་བྱ་སྟེ།",
    "སློབ་དཔོན་ལ་ཡང་ཇི་ལྟར་ནུས་པའི་ཡོན་དབུལ་པར་བྱ་སྟེ།",
    "དབུལ་བའི་སྡུག་བསྔལ་རབ་ཏུ་ཉམས་པར་བྱ་ཕྱིར་དང་།",
    "ཆ་ཆུང་བཞི་ནི་སྤངས་བྱས་ནས།",
    "དེ་ནས་ཆ་ཆུང་བཞི་སྤངས་པར།",
    "ཆ་ཆུང་གཉིས་པར་དུའོ་སླར།",
    "རྣམ་པར་རྒྱལ་བའི་འཁོར་ལོ་ནི།",
    "དོན་ཀུན་གྲུབ་པར་བྱེད་པ་སྟེ།",
    "དབུས་ཀྱི་ལྟེ་བར་པདྨ་དཀར་པོའི་སྟེང་དུ་གུར་གུམ་གྱི་དྲིའི་མཎྜལ་ལ་ལྷ་ཉི་མ་བསམ་པར་བྱ་སྟེ།",
    "བདེན་བྲལ་གྱི་འདབ་མར་འདམ་སྐྱེས་དཀར་པོའི་སྟེང་དུ་སྔོན་པོ་དང་ཙནྡན་གྱི་དྲིའི་མཎྜལ་ལ་སྤེན་པ་ནི་ནག་པོ་ཕྱོགས་ཀྱི་གོས་ཅན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "མཆེ་བ་རྣམ་པར་གཙིགས་ཤིང་སྨིན་མའི་ཁྲོ་གཉེར་དཔྲལ་བར་བསྡུས་པ་ཁ་དོག་ལྔ་པའི་སྤྲིན་གྱི་གསེབ་ན་གནས་བ།",
    "དེའི་རྗེས་སུ་གཟའ་རྣམས་ཀྱི་ཡུམ་ཞེས་བྱ་བའི་གཟུངས་ལན་བདུན་བཀླག་པར་བྱའོ།",
    "ཕྱི་ནས་སློབ་དཔོན་ལ་སོགས་པ་རྣམས་ཁ་ན་མ་ཐོ་པ་མེད་པའི་བཟའ་བ་ལ་སྤྱད་པར་བྱ་ཞིང་ཡོན་ལ་སོགས་པ་ཇི་ལྟར་ནུས་པ་དབུལ་བར་བྱའོ་ཞེས་པ་གཟའ་ཡུམ་གྱིས་བདེ་ལེགས་སུ་བྱེད་པའི་ཆོ་གའོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཅོད་པན་ཅན་ཕྱག་གཡས་ཀྱི་དང་པོས་མཆོག་སྦྱིན་གྱི་ཕྱག་རྒྱས་གཏེར་སྟོན་པར་མཛད་པ།",
    "གསུམ་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གླེགས་བམ་འཛིན་པ་རྒྱན་ཐམས་ཅད་དང་ལྡན་པར་བསམ་པར་བྱའོ།",
    "གཟུངས་རྣམས་མ་ཆད་པར་བཀླག་པར་བྱའོ།",
    "དེའི་རིམ་པས་ནི་ཐམས་ཅད་དུ་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ།",
    "ཙནྡན་གྱི་མཎྜལ་བྱས་ཏེ་ཐེ་ཚོམ་མེད་པས་གཟུངས་རྣམས་བར་མ་ཆད་པར་ལན་གསུམ་བཀླག་པར་བྱའོ།",
    "ཉེ་བར་འཚེ་བ་ཐམས་ཅད་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "མྱོས་བྱེད་ཀྱི་བཏུང་བ་ལ་སོགས་དང་བྲལ་ཞིང་ཁ་ན་མ་ཐོ་བ་དང་ལན་ཚྭ་མེད་པའི་བཟའ་བ་དང་ཚངས་པར་སྤྱོད་པ་དང་ལྡན་པར་གྱུར་པས།",
    "སེམས་རྩེ་གཅིག་པས་སྦྱིན་བདག་ལ་ཕན་པ་དང་བདེ་བའི་བསམས་པ་དང་དད་པ་དང་མཆོག་ཏུ་ཐེ་ཚོམ་མེད་པས་གཟུངས་འདི་ཉིན་མཚན་གཅིག་གམ་ཉིན་མཚན་བདུན་དུ་གཞན་དང་མི་སྨྲ་ཞིང་རྒྱུན་མ་ཆད་པར་བཀླག་པར་བྱའོ།",
    "དེ་ནས་བཀླགས་པས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཉེ་བར་འཚེ་བ་ཐམས་ཅད་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "དེ་ནས་སྔར་བཞིན་དུ་རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་གཤེགས་སུ་གསོལ་ལ་རྡུལ་ཚོན་ཐམས་ཅད་ཁང་བའི་མཛོད་མིག་དུ་བཅུག་ནས་གཞག་པར་བྱ་སྟེ།",
    "གང་དུ་རྡུལ་ཚོན་བཅུག་པ་དེར་ནི་ཐམས་ཅད་ཟད་པ་མེད་པར་འགྱུར་རོ།",
    "སློབ་དཔོན་ལ་སོགས་པ་རྣམས་ཀྱང་ཁ་ན་མ་ཐོ་བ་མེད་པའི་བཟའ་བ་དང་ཡོན་ལ་སོགས་པས་མཉེས་པར་བྱའོ་ཞེས་པ་ནོར་རྒྱུན་མའི་གཟུངས་བཀླག་པའི་ཆོ་གའོ།",
    "རིགས་ཀྱི་བུ་དག་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མ་ཞེས་པའི་གཟུངས་འདི་ནི།",
    "དེ་བཞིན་གཤེགས་པ་རང་བཞིན་ནམ་རྣམ་པར་རྒྱས་པའི་གཙུག་ཏོར་ཏེ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ལས་བྱུང་བའི་གཙུག་ཏོར་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལས་བྱུང་བའི་གཙུག་ཏོར་དང་།",
    "པདྨའི་ཕྱི་རོལ་ཕྱོགས་བཞིར་ཆུས་གང་བའི་བུམ་པ་བཞི་གཞག་པར་བྱའོ།"
  ]
}