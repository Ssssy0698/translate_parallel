    "མིག་ནི་ཁྲ་སིང་ངེ་འདུག་ཅིང་།",
    "མིག་སེར་བཀྲག་སིང་ངེ་བ་ལ་དཀར་བའི་ཞད་ཅུང་ཟད་ཆགས་ཤིང་དབྱིབས་ནས་འབྲུ་ལྟར་འདུག་པ།",
    "རྣ་བ་དཀར་ལ་དམར་བའི་མདངས་ཆགས་ཤིང་དམར་སེང་ངེ་འདུག་པ།",
    "སྨིན་མ་དང་རྫི་མ་སེར་བོ་རིང་ཆབས་སེ་འདུག་པ།",
    "འོད་ཀྱི་རང་བཞིན་ཅན་ཡུངས་དཀར་གྱི་འབྲུ་མ་ཆུང་ཤོས་ཙམ་དུ་འདུག་པས།",
    "ཆུ་བོ་ཆེན་པོས་ས་གཞི་གཡོས་པར་འདུག་སྙམ་པ་དང་།",
    "ཆུ་བོ་ཆེན་པོས་ས་གཞི་ཁེབས་པར་འདུག་སྙམ་པ་འབྱུང་།",
    "རང་ཉིད་འདུག་པའི་གནས་སུ།",
    "གཉན་ཁྲོད་དུ་རྟག་ཏུ་འདུག་པ་དང་ལུས་ཀྱི་མཆོད་སྦྱིན་བྱེད་པ་དང་གཅིག་ཚེ་འདིའི་བྱ་ཐབས་ལ་བློ་སྐད་ཅིག་ཀྱང་མི་འཇོག་པ་གསུམ་ལ་སྐད་ཅིག་ལེ་ལོ་མེད་པར་བྱེད་པ་དང་གཉིས།",
    "བདག་འཛིན་དང་བྲལ་ཞིང་བདག་དོན་གྱི་དྲི་མས་ཀྱང་རང་ཉིད་ལ་མ་གོས་ན།",
    "ཁྱད་པར་ཁྱིའི་པགས་པ་ལ་སྐྱོན་ཆེ་བར་གདའ་སྟེ།",
    "དེ་བས་པགས་པས་སྐྱོན་དང་ཡོན་ཏན་བསྐྱེད་པའི་ནུས་པ་ཤིན་ཏུ་ཆེ་བར་གདའ་སྟེ།",
    "གང་དུ་འདུག་ཀྱང་ཞི་བ་དང་།",
    "ལྷོང་སོགས་བཞི་ག་དུས་གཅིག་ལ་རྫོགས་པ་ཡང་ཡོད།",
    "ཕྱི་ནང་ཆ་ཐམས་ཅད་མ་ལུས་པར་བསྐྱུགས་ནས་ཁོང་བ་རྐྱལ་བ་ལྟར་སྟོང་ཨིང་ངེ་འདུག་པ་དང་།",
