    "སྐྱེར་སྣའི་ཕུག་པར་རྨ་སྒོམ་དང་མཇལ་བས་ཁོ་བོ་རྒྱ་གར་གྱི་གྲུབ་ཆེན་གཅིག་དང་མཇལ་བས་འཚེང་དེ་མིན་སྟོན་ཆེན་གྱི་མལ་ནས་ཐ་མལ་གྱི་རོ་ཡོང་བར་འདུག་གསུང་བར།་",
    "ད་ངའི་ཤེས་པ་འདི་གང་ལ་ཡང་ཐོགས་པ་མི་གདའ་བྱས་པས།",
    "དམ་པ་ཁྲོམ་གྱི་དཀྱིལ་ན་བཞུགས་འདུག་པའི་སྐུ་པང་དུ་གསེར་སྲང་གསུམ་པོ་བསྒྱུར།",
    "དེ་ནས་འཛེང་ཕྱིན་ཙ་ན།",
    "ཉི་མ་ཕྱི་དྲོ་ཙ་ན་མི་རོད་ངན་པ།",
    "ཕྱག་མཛུབ་པང་དུ་སྦྲེལ་ནས་སྡུག་བསྔལ་ལུ་གུ་རྒྱུད་དུ་གདའ་གསུངས།",
    "གཟུང་འཛིན་གྱི་འཕྲང་ལ་ཐར་བའི་ལམ་སྣ་མ་ཟུག་པར་གདའ་འོ་གསུངས།",
    "དམ་པ་སྐུ་གྲོངས་ནས་གདུང་སྦྱངས་ཙ་ན།་",
    "དབུ་ཐོག་ནས་ཤོག་དྲིལ་ཅིག་འདུག་པ་བླངས་ནས།",
    "ཚྭ་བཟང་བོ་ཡོད་ཀྱང་ལ་སྟོད་ན་མྱང་ཤེས་པ་མི་འདུག་གསུངས།",
    "གཞན་ཡང་ཀརྨ་པཀྴི་དང་རང་བྱུང་རྡོ་རྗེ་ཡང་དམ་པའི་སྤྲུལ་བར་གྲགས་ཤིང་གྲུབ་ལ།",
    "འདིའི་མན་ནི་ཆད་འདུག་ལ།",
    "ནམ་ལངས་ཙ་ན་དུར་ཁྲོད་ཀྱི་མཁའ་འགྲོ་མ་དེས་ངས་ཁྱེད་ཀྱི་ལམ་མཁན་བྱེད་དོ་ཟེར་ཏེ།",
    "དེ་ནས་སྐུ་བལྟམས་མ་ཐག་ཏུ་འཇའ་འོད་ཀྱི་ནང་དུ་ཞབས་བརྐྱང་བསྐུམ་གྱིས་འདུག་སྟེ།",
    "མཁའ་འགྲོ་མའི་མཚན་རྟགས་ཐམས་ཅད་ཚང་བར་འདུག་པས།",
    "ཐམས་ཅད་ཀྱིས་སྐད་འགྱུར་དང་ཡི་གེ་ལ་མཁས་འདུག་ཟེར།",
    "དེ་ནས་ལོ་བཅུ་དྲུག་དུས་སུ་ཨ་ཅེ་དང་གཉིས་ཀ་གྲྭ་བའི་དྲུང་དུ་ཕྱིན་ནས།",
    "དར་ཞྭ་དེ་མནབས་པས་སྐེད་པ་ཡན་ཆད་དར་སྔོ་དམར་གྱིས་ཁེབས་ནས་མཛེས་དཔུང་ངེ་འདུག་པས།",
    "དེང་སང་གར་ཡོད་ཟེར་བའི་མངོན་ཤེས་མཁྱེན་པ་ཞིག་འདུག་ཟེར་སྐད།",
    "དོན་རང་རྒྱུད་ལ་མ་སྐྱེས་པར་འདུག་གསུངས།",
    "གྲོགས་མཁན་སློབ་བཙུན་པའི་གྲལ་མིན་པ་ལ་མི་འདུག་པ་ལ།",
    "ཕྱིས་མཛེ་སྤྲང་དང་ལྷན་དུ་འདུག་པ་བྱུང་བ་ནི།",
    "ཕྱིས་མཛེ་ཁང་དང་ལམ་འཕྲང་ལ་སོགས་པ་གང་དུ་ཡང་འདུག་པ་ཞིག་བྱུང་བ་དེ་གནས་ཀྱི་ཞེན་པ་ཆོད་པའི་རྟགས་སོ།",
    "དགུང་ལོ་བཅུ་དྲུག་དུས་སུ་ཡབ་འདས་པ་རྒྱ་གར་དུ་སྐུ་འཁྲུངས་ཏེ།",
    "ཁྱེད་རང་ལ་སེམས་བསྐྱེད་ཀྱི་ཆོ་ག་མི་དགོས་ཤིང་།",
    "རྗེ་བཙུན་མ་སྒྲོལ་མ་དངོས་ཡིན་པར་འདུག་ཟེར་ཞིང་།",
    "གླིང་བཞིར་ཐོས་པ་ཙམ་དུ་གྲག་གོ་སྙམ་པ་བྱུང་ཙ་ན་རྣལ་སངས་པར་འདུག་དེའི་ཕྱི་ཉིན་ཉི་མ་རྩེ་ཤར་བའི་དུས་སུ་སྲས་ཆུང་བ་དང་།",
    "རྒྱ་གར་ཡང་བསྒྲུབས་པར་གདའ་བས།",
    "དིའི་ནང་དུ་རྒྱ་གར་ནས་བྱོན་པའི་ལོ་ཙྪ་བ་མཁས་པ་བཞི་འདུག་གོ།",
    "ངའི་ཉམས་ལེན་པར་འོངས་པར་འདུག་པས།",
    "མ་ཅིག་སྐུ་ཡལ་དུ་འགྲོ་བར་གདའ་གཏམ་སྐད།",
    "དེ་ནས་དགུང་ལོ་ལྔ་བཅུ་ང་དྲུག་དུས་སུ།",
    "དྲན་རིག་སྐྱེ་མེད་ནམ་མཁའི་དབྱིངས་སུ་སྦས་པའི་འགག་མེད་ཤུགས་འབྱུང་རང་གྲོལ་སྟོང་པའི་ངང་ལ་གནས་པས་ན་ངར་འཛིན་ངང་ངམ་ཤུགས་ཀྱིས་ཆོད་ནས།",
    "ཁོ་རང་གདུག་སེམས་པ་དང་དུས་རྒྱུན་དུ་འགྲོགས་པས།",
    "ལོ་ཁྲི་ཚོའི་བར་གྱི་འདུག་ཆས་བྱེད་པར་མི་རིགས།",
    "བུ་གཟུགས་དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པའི་ཕྱིར།",
    "དེས་ན་བདག་ཡོད་ཙ་ན་བདུད་ཀྱང་ཡོད།",
    "བདག་མེད་ཙ་ན་བདུད་ཀྱང་མེད་པས།",
    "དེ་ཡང་རང་ལ་བརྩེ་ཞིང་གདུང་བར་བྱེད་པའི་གཉེན་འདུན་རྣམས་ཀྱིས་བདག་ལ་རི་ཁྲོད་དུ་འགྲོ་བ་མི་འཐད་དེ།",
    "དེ་ཡང་རང་དོན་དུ་ཞེ་སྡང་ཆེན་པོ་བསྐྱེད་ནས།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་དག་ཐམས་ཅད་ཟིང་སྟེ་རང་རང་ཕྱོགས་ནས་བྱུང་བར་བསམ།",
    "སྔར་ང་འདུག་པའི་དུས་སུ་ཙན་དན་གྱི་ཚལ་ཆེན་པོའི་གསེབ་ཏུ།",
    "རྗེ་བཙུན་སྒྲོལ་མས་བྱིན་གྱིས་བརླབས་པའི་བྱ་ཡིན་པར་འདུག་ལ།",
    "གར་འདུག་པའི་ཡུལ་ཤེས་ཚད་དམ།",
