    "འགྲོ་འཆགས་ཉལ་དང་འདུག་སོགས་ལ།",
    "སྤྱོད་པ་མི་སྒྲུབ་རང་བྱུང་རང་ཆས་སུ་ཡོད་པས་སོ།",
    "དེ་ལྟར་བདེ་བས་གང་ཙ་ན་ནཱ་ད་གནས་པར་བྱ་སྟེ།",
    "འོག་སྒོ་རས་ཀྱིས་བཅིངས་ཏེ་ཙོག་པུར་འདུག་ནས།",
    "དེ་ལས་བདེ་བར་འདུག།",
    "སྟོང་པར་འདུག་སྙམ་པ་དེ་ལ་མཆོག་དགའ།",
    "མཉམ་བཞག་ལ་དེ་ལྟར་འདུག་ཀྱང་རྗེས་ཐོབ་ལ་སྣ་ཚོགས་སུ་སྣང་བ་ནི་དགའ་བྲལ་ལོ།",
    "དེ་ནས་བདེ་སྟོང་དབྱེར་མེད་དུ་ཉམས་སུ་མྱོང་བའི་རྟགས་ཆབ་རོམ་ཆུ་རུ་འདུག་པ་ལྟ་བུ་དང་།",
    "འབྲས་བུ་མ་བསམས་ཤིང་རང་བྱུང་བའོ།",
    "ཐམས་ཅད་བདེ་སྟོང་ཆེན་པོར་རྟོགས་ཙ་ན་ཀུན་རྫོབ་དང་དོན་དམ་དུ་མི་དབྱེ།",
    "དྲུང་ན་འདུག་པའི་ཚིག་ཉིད་ཀྱིས་རྡོ་རྗེ་ལས་ཕྱི་རོལ་གྱི་དྲུང་དུ་བསྟེན་པ་ཞེས་བརྗོད་པ་ཉིད་དོ།",
    "ཁོང་རང་ཉིད་ཀྱིས་དཔར་བསྐྱོན་པ་དང་།",
    "སྒྱུ་རྩལ་གྱི་རང་བཞིན་བཅས་དང་ལྡན་པའི་ལེགས་ཆ་ཆེན་པོ་ཡོད་འདུག།",
    "སྐུ་སྟོད་ལ་རི་དྭགས་ཀྲིཥ་ཎ་སཱ་རའི་པགས་པས་ནུ་མ་གཡོན་པ་བཀབ་པ་མཚན་དང་དཔེ་བྱད་ཀྱིས་བརྒྱན་པ་གཅིག་འོད་འཕྲོ་ངེར་བྱོན་འདུག་པ།",
    "རྒྱལ་ཆེན་བཞི་བཞེངས་སྟབས་སུ་ཡོད་པའི་སྐུ་བརྙན་མཇལ་རྒྱུ་འདུག་པ་འདི་ཚོའི་བྱུང་བ་དང་།",
    "༧པ་གོར་བེ་རོ་ཙ་ན།",
    "མཁའ་འགྲོ་འབུམ་ནས་ས་སྐྱའི་སྐུ་ཞང་རང་།",
    "དེ་ལྟར་གླེང་ལ་དགོས་པ་འདུག་ན་ནི།",
    "སྤྲང་པོའི་ཁ་ནི་འབྲེལ་མེད་ཡིན་འདུག་པས།",
    "དེ་གྲུབ་རྟགས་སུ་ཤེས་པ་གདུག་འདྲེ་མིན་པ་མི་འདུག་ད་སྟག་ལུང་ན་བྱོན་ཡོད་པས་ཟབ་ཡངས་མཐིལ་གྱི་གཙུག་ལག་ཁང་འདི་རྣམས་ལ།",
    "གདུང་བརྒྱུད་འདི་སྐུ་སྐྱེད་ཡག་པོ་བྱུང་འདུག་ས་ལོ་ཐམས་ཅད་མཁྱེན་པའི་སྐུ་རྗེས་ཟིན་པ་ཞིག་ཨེ་ཡོང་།",
    "དེ་སྐབས་ཤིག་ཁོང་པ་འགྲོ་ཙ་ན།",
    "ཐུགས་དགྱེས་པ་བྱུང་འདུག་ཅེས་གསུངས།",
    "མི་གཞན་གྱི་ནོར་དེ་ང་ལ་དགོས་ཟེར་ནས་བླངས་ན་སྡོམ་པ་འཆོར་བ་ཡིན་གསུང་བྱུང་ཞེས་བཀའ་སྩལ་འདུག་པ་སོགས།",
    "ཕལ་ཆེ་བ་ད་ལྟའང་གསལ་པོ་འདུག་ཅེས་རྗེ་དེ་ཉིད་ཀྱི་གསུངས།",
    "གསུང་བ་ཞིག་འདུག་ཅེས་གསུངས་ཏེ།",
    "མ་ཕུལ་བས་འོ་ན་དེའི་ནང་ན་ཤིག་འདྲ་འདུག་ན་ཡུམ་གྱིས་དེ་ཚོ་ཤ་ཡག་པོ་དང་མཉམ་དུ་གོས་ནང་དུ་འཇོག་རོགས་མཛོད་ཅེས་གསུངས།",
    "རྟ་སྒ་བསྟད་པ་གཅིག་རྟ་པ་གསུམ་འདུག་པས་གཅིག་ས་སྐྱ་ནས་འོང་པའི་མགོན་ཆེན།",
    "གསུང་བ་པཎ་ཆེན་དང་དྲུང་ཆེན་བསོད་ཤེས་ཐུགས་ལ་བཞག་པས་ཟླ་བ་གསུམ་ནས་སྐུ་འབྲིང་སྐུ་གཤེགས་པས་དེ་མངོན་ཤེས་ཀྱི་མཁྱེན་པར་འདུག་གསུང་།",
    "འདི་འདྲ་ངོ་མཚར་ཅན་ཡིན་པ་འདུག་ཞེས་སྙན་གྲགས་ཀྱིས་ཁྱབ།",
    "ལྷ་མི་ཚང་མའི་དགའ་སྟོན་འབུལ་བ་རྒྱས་པའི་ཐོག་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་མཛད།",
    "རིམ་བཞིན་བརྒྱ་གྲོང་དུ་ཞག་གསུམ་ཚེ་ཆོག་མཛད་པ་སོགས་ཕེབས་ལམ་གྱི་ཐུགས་བྲེལ་རྣམས་བཅད་དེ་གདན་སར་ཕེབས་སྐབས་འཁངས་ཀྱང་ད་ནི་ཅི་བྱ་ཆ་མེད་དུ་འདུག་པས།",
    "སྔར་སྐུ་རྒྱུའི་འཇིམ་པ་དཀོན་ཀྱང་རང་རྡོལ་ལྟ་བུ་དང་།",
    "ཟླ་བ་བཞི་པའི་ནང་འུ་ཡུག་ཟམ་འཚེར་ཆབ་འདུགས་ལ་ཕེབས་ཤིང་།",
    "རྗེ་ཉིད་ནས་ཀྱང་འདི་འདྲ་ཞིག་ཡོད་འདུག་པ་དེ་ག་ན་ཡོད་པ་སོགས་སྔོན་གནས་རྗེས་དྲན་ཚུལ་དུ་མཇལ།",
    "སྐུ་འཁོར་རྣམས་ལ་བྱ་སྐད་མང་བ་ཞིག་འདུག་སྙམ་པ་ལས་རྟོག་པ་མ་བྱུང་།",
    "གསུང་གླེང་ཡུན་རིང་གནང་འདུག་པར་དབུའི་གཙུག་ན་མར་འཇའ་མདུང་ཚུགས་དང་།",
    "གཡོན་གྱི་ཕྱག་རྗེས་ཡིན་འདུག་གསུངས།",
    "རྩེ་གདོང་ནས་ཡོང་མི་འདྲ་ཨེ་འདུག་ངེད་ལ་ཆས་འདྲ་སྐྱེལ་རྩིས་ཡིན་པས་ད་དུང་མ་བྱུང་།",
    "ཉིི་མའང་ལྡབ་འགྱུར་གྱི་རིང་བ་བྱུང་འདུག་པས།",
    "གཞིས་རྩེ་རིན་རྩེ་སོགས་བརྒྱུད་དེ་འབྲས་ལྗོངས་སུ་ཕེབས་ནས་འབྲས་ལྗོངས་ཁ་སྟོད་ཀྱི་གནས་བརྟེན་རྣམས་མཇལ་གནང་ཐོགཚུར་ཕེབས་ལམ་བར་གྱི་ལ་ཆེན་གངས་ལ་དང་ཟེར་བའི་མདུན་དུ་ཕེབས་ཚེ་དོ་ནུབ་ལ་འདི་ཅིས་ཀྱང་བབས་པ་འགྲོ་གསུངས་པར་མགྲོན་གཉེར་ཚངས་པས་དོ་ནུབ་ཐང་ཡང་ཆད་ཅིང་ཚང་མས་འགྲོ་མི་ཐུབ་ཁྱེད་རང་རྣམས་འབྱོན་ན་ཡང་ང་ནི་འདི་གར་སྡོད་ཞེས་ཞུས་པར་བརྟེན་དེ་ནུབ་དེར་བཞུགས་པས།",
    "འཇམ་དབྱངས་དངོས་སུ་རང་ཕེབས་འདུག་གསུངས་ཤིང་ལེགས་འབུལ་སོགས་རྒྱ་སྤོམ་ཆེ་བར་གནང་ཞིང་།",
    "ཕྱག་མཛོད་ཀུན་དོན་གྱིསགྱི་མགོ་བཏགསསྟས་ཏེ་དག་སྦྱངས་ཀྱི་རྩེ་གདོང་རང་འཇགས་ཡོང་བར་བྱས་ཀྱང་དེ་སྐབས་རང་སྲོག་སྐྱོབ་ཐུབ་ཙམ་ལས་གཞན་ཕན་མ་ཐོགས།",
    "ཕྱག་དྲིལ་བཅས་རྒྱལ་མཚན་ཐོན་པོར་ཕུལ་སྐད་འདུག་པས་སྲང་དབར་གྱི་ས་རྡོའི་གྲས་ལ་བཞུགས་མ་དགོས་པ་འདི་ཡང་རྒྱུ་འབྲས་ཀྱི་གདེན་པར་གོ།",
    "གཞན་ཡང་སོག་པའི་རིགས་རྣམས་ཐོག་ཁ་ནས་ལྷུངས་ཤིང་ལས་མགོན་པུ་ཏྲ་མིང་སྲིང་རྣམས་ཁོག་ཞུགས་ཀྱི་སྨྱོ་འབོག་སེམས་འཁྲུགས་ལྟས་ངན་སྣ་ཚོགས་བྱུང་འདུག་པ་དང་།",
    "ཞབས་ཕྱི་རྣམས་ལ་གསུང་སྒྲོས་སུ་ང་བན་རྒན་ལ་ཕ་གཞིས་ཀྱི་དགོས་པ་མེད་པས་གདན་ས་གོང་རང་དུ་འབུལ་འབྱོར་ཐུབ་པ་ཞིག་ཅིས་ཀྱང་བྱ་རྒྱུ་ཡིན་གསུངས་པ་ལྟར།",
    "ཚ་བའི་རོང་དུ་བེ་རོ་ཙ་ནར་གྲགས།",
    "བར་ཆད་ཕྲན་བུ་འདུག་སྟེ་ཁོ་བོས་སེལ།",
    "ལོད་རྒྱུ་རང་མེད་དཔལ་མགོན་ཞལ་གྱི་ཆོ་འཕྲུལ་ཞིག་ཡིན་འདུག་པས་བསྐང་གསོ་གྱིས་ཕེབས་པ་ལྟར།",
    "རྗེ་ཉིད་རིང་སྟབས་སུ་བྲོས་ཕེབས་པའི་སྐས་ཞིག་འདུག་པར་འཛེགས་ཕེབས་ཏེ་ཐོག་མཁར་ཕེབས་དགོངས་པ་དང་།",
    "དམག་ཟོར་མའི་ཆོ་འཕྲུལ་ཞིག་ཏུ་འདུག་ཀྱང་རིགས་ཀྱི་སྲུང་མ་གཞན་གྱིས་བར་གཅོད་སྲུང་བའི་ལྟས་བཞིན་བསྙུན་ཡང་སེང་དངས་བྱུང་།",
    "རྒྱལ་ཡུམ་དེ་ཉིད་བདག་མེད་མ་དངོས་ཡིན་པའི་བརྡའ་རུ་འདུག་ཅིང་།",
    "ཁྱེད་རང་ངའི་ཕྱི་ལ་ཕྱིིན།",
    "རྗེ་ཉིད་ཐུགས་གཡོ་མེད་དུ་བཞུགས་འདུག་པའི་སྐུ་ལ་ཉམས་ང་ལྟ་ཅི།",
    "སྐུ་ཕྱྭ་བཏབ་པས་སྐུ་ཚེ་རིང་པོ་ཡོང་བར་གདའ།",
    "ཐུགས་སྦྱོང་གནང་གོང་མི་གཡོ་བ་དཀང་པོའི་བསྙེན་པ་ཞིག་མཛད་ན་ལེགས་པར་གདའ་ལགས།",
    "ཉི་མ་ནུབ་པ་ནི་རྒྱལ་ཡུམ་དེ་ཉིད་སྐུ་མ་གཤེགས་བར་རྗེ་མུས་ཆེན་དེ་ཉིད་མ་མཇལ་བའི་རྟགས་སུ་འདུག་གསུངས།",
    "དངོས་པོ་གང་ཡོད་འབུལ་ཐུབ་པ་ལ་དགའ་སྤྲོ་ཆེན་པོ་བྱེད་སྲོལ་བཟང་པོ་ཞིག་ཡོད་འདུག་ཀྱང་།",
    "རིགས་ཀྱི་བུ་ལ་བརྒྱུད་ཀྱི་ལྷ་མགོ་ཟེར་བ་དེ་གདའ།",
    "གསེར་ཁ་བདག་པོའི་དཔེར་འདུག་པས།",
    "རྗེ་འདི་ཞལ་བཞུགས་རིང་ཚར་གཅིག་གཉིས་ཤིག་ཅི་ལྟར་ཡང་འཆད་ཐུབ་པ་དགོས་འདུག་དགོངས་པའི་ཐུགས་དམ་གྱི་གོ་ཆ་བཙན་པོ་བཞེས།",
    "སྐུ་གཉེར་དེ་ཀརྨ་པའི་གྲྭ་རིགས་ཤིག་ཡིན་འདུག་ཀྱང་ངོ་མཚར་ནས་འདི་བཞིན་སྔར་ནས་མེད་ལགས།",
    "ད་ལམ་སྐྱེས་ཆེན་ཉིད་ཕེབས་པས་གནས་སྒོ་གསར་དུ་ཕྱེ་བར་འདུག་ཟེར་བ་དེ་བཞིན་ཡོངས་ལ་གྲགས་པ་བྱུང་།",
    "རྗེ་ཉིད་དང་སྤྱན་སྔ་བ་ལྷན་ཅིག་ཏུ་བཞུགས་འདུག་པའི་དྲུང་ན།",
    "ལྦ་བ་དཀྱུས་མ་ཞིག་ཏུ་མི་འདུག་གསུང་།",
    "ཛཱ་ཀིའི་གཞོགས་ན་ནྔྷེ་གཟུགས་བོང་ཆེ་བ་ཞིག་ངོ་ནོང་ཙམ་བྱས་ནས་ཅང་མི་ཞུ་བར་འདུག་པ་ཞིག་བྱུང་བར།",
    "བནྡྷེ་ངམ་ནག་དེ་ཚར་ཆེན་ཉིད་ལ་བེག་ཙེ་འཁོར་ཉམས་ཤིན་ཏུ་ཆེ་བས་སྐུ་གདུང་ཞུ་བ་དེ་ལ་ཡིད་ཕམ་ཚོད་དུ་འདུག་གསུངས།",
    "བྲེལ་བ་འགའ་ཞིག་གཅོད་པར་འགྲོ་དགོས་པ་འདུག་ཅིང་།",
    "སླར་སྐབས་བསྟུན་ལྷོ་ནང་རང་ལ་འགྲོ་དགོས་འདུག་པས།",
    "ངེད་རང་རང་ལོའི་ཐོག་ཡིན་ཀྱང་དོག་ཆ་མེད།",
    "མཁན་ཆེན་ལ་སྐུ་རྐྱེན་ཆེ་ཙམ་འདུག་གསུངས།",
    "སླར་དབུས་ཕྱོགས་སུ་མཇལ་འདུག་ཐོག་ཞིབ་རྒྱས་ཕུལ་ཆོག་པ་ཞུས།",
    "ན་ཚོད་དང་བཅས་ལུས་ཟུངས་འདི་ཡང་ཞན་དུ་ཀ་འགྲོ་བ་ཞིག་འདུག་པས།",
    "ང་རང་བསྟན་པའི་བྱ་བ་ཡང་དེ་ཙམ་ཡིན་འདུག་ཅིང་།",
    "ལན་གཅིག་ས་སྲོས་མཚམས་སྐུ་འཁོར་རྣམས་ཀྱིས་གཟིམ་ཆུང་སྟེང་དུ་ཕེབས་རན་འདུག་ཞུས་པས་ཅུང་ཟད་ལྷོད་ཅིག་གསུངས་པའི་མུ་ནས།",
    "རྗེ་ཉིད་ནས་དོས་རྣམས་ཕ་ཀར་ཕྱིན་ཙམ་བྱུང་ན་སྐུ་ཉིད་བཅས་ཀོ་བར་ཕེབས་ཆོག་ཚུལ་སོགས་གནང་བ་ལྟར་གྲུ་ཁར་ཕེབས་ཕྲལ་གནམ་ཡུལ་དྲོ་བས་དེ་ནུབ་གྲ་ཕྱིར་ཕེབས་པ་ན་བྱིངས་དམངས་ཀྱིས་སྔར་དུས་ལས་ཉི་མ་ཉིས་འགྱུར་དུ་རིང་བ་བྱུང་བས་རྗེ་ཡབ་སྲས་ཀྱིས་ཉི་མ་བཟུང་བར་འདུག་ཅེས་གྲགས་པ་བྱུང་བ་ལྟར་དོན་ལའང་གནས།",
    "ཤེལ་ཕྲེང་གཡུ་ཕྲེང་ལྕགས་ཕྲེང་སོགས་རྒྱུད་མན་ངག་བཀའ་གཏེར་གྱི་གཞུང་རྙིང་དུ་མ་ཡོད་ཚུལ་འདུག་ཀྱང་།",
    "གསང་བའི་དགྲ་བོ་ཞིག་ཚེ་འཕོས་པའི་བསྔོ་རྟེན་འབུལ་མི་འབྱོར་བས་དེ་ལ་བལྟ་བར་འདུག་གསུངས།",
    "ཁྱེད་ཀྱི་རྟེན་འདི་རྣམས་ལ་རབ་གནས་བྱས་པ་ཡིན་ནམ་གསུངས་བྱུང་བར་ཡིན་ལགས་ཞུས་པས་དེ་ལེགས་འདུག་གསུངས་ཏེ་ཤིང་ཏོག་ནས་རྟེན་རྣམས་ལ་འཐོར་བ་མཛད་པའི་ཐུགས་སྣང་ཤིན་ཏུ་གསལ་བར་བྱུང་བ་ནི་གདན་ས་འདི་ཉིད་ཀྱི་ཕྲིན་ལས་རྒྱས་པའི་རྟགས་སུ་མངོན།",
    "ང་རང་འཆི་ཐག་ཆོད་པ་ལ་མངོན་མཁྱེན་འདི་འདྲ་ཟེར་བ་བྱུང་བ་དང་།",
    "ཕྱུག་པོ་སྟོད་ལུང་པའི་རྒད་པོ་ལོང་བ་ཞིག་ལ་མིག་ཐུར་འབྱེད་སོགས་མ་བྱེད་པར་གཞོག་དང་རང་བྱེ་འོང་གསུངས་པར།",
    "སྐུ་རིམ་སོགས་ཀྱིའང་ཁྱད་འདུག་ཚུལ་ཞུས་པས་དགོངས་ཁྲོལ་མ་གནང་ཡང་།",
    "ཡུམ་གྱིས་འདི་ལས་མི་གདའ་ཞུས་པས།",
    "ད་དུང་མགོན་པོ་ལྕམ་དྲལ་གྱི་སྐུ་ཞིག་ཡོད་པ་འདིར་མི་འདུག་གསུངས་པ་དང་།",
    "ཟློག་ཐབས་ལ་རྡོ་རྗེ་ཕུར་པ་དྲུག་ཅུ་སོགས་ཀྱི་གཏོར་ཟློག་ཚེ་སྒྲུབ་སོགས་དགོས་ཚུལ་འདུག་པས་རྗེ་ཉིད་ནས་ཡབ་རྗེ་དང་ངེད་རང་སུ་ལ་སྐུ་དོགས་ཡོད་ཀྱང་ད་ལན་ཧུར་ཐག་དགོས་པ་འདུག་གསུངས་ཏེ་ཚེ་སྒྲུབ་སོགས་ཀྱི་ཐུགས་དམ་ལ་གཡེལ་མེད་བརྩོན་པ་དང་།",
    "གཟིམ་ཆུང་རང་ནས་ཕྱག་རྫས་བཏོན་པའི་ཡོན་སྤྲད་ནས་རྡོ་རྗེ་འཛིན་པ་གཞན་ལ་ཡང་ཚེ་སྒྲུབ་སྲུང་བཟློག་རྒྱ་ཆེར་བསྒྲུབ་འཇུག་པ་གནང་།",
    "འོན་ཀྱང་ང་རང་སྒོ་རུམ་ཡེ་ཤེས་མགོན་པོའི་དྲུང་དུ་བརྟག་པ་ཞིག་ལ་འགྲོ་གསུངས་ནས་གསུང་བསྐང་ཚུགས་ཏེ་བརྟག་བསྒྲིལ་གནང་ཚེ་ཡབ་རྗེ་རྡོ་རྗེ་འཆང་དེ་ཉིད་ཞིང་གཞན་དུ་ཕེབས་ཡོད་འདུག་གསུངས་པ་དང་།",
    "སླར་བཞུགས་སྒར་དུ་ཕེབས་པའི་ལམ་བར་ཐུགས་རྗེ་ཆེན་པོའི་བྲག་ཟེར་བ་དེར་ཕེབས་ཚེ་འདི་ན་གཏེར་ཞིག་ཡོད་པར་འདུག་གསུངས།",
    "ཕྱག་མཛོད་ནས་ཉིན་བཞིན་འཇའ་སྒོར་འདི་ཡིད་སྣང་བདེ་རྒྱུ་རང་ཞིག་མི་འདུག་པས།",
    "བཅོ་བརྒྱད་དུ་འབོག་གོང་ལ་བྱོན་པའི་ལྕམ་གྱི་མཆེད་བསྟན་འཛིན་ཟེར་བ་ཞིག་ཡོད་འདུག་པས་དེ་ཁ་ས་སྐྱར་བཞེས་ན་ཇི་ལྟར་ལེགས་ཀྱི་སྙན་འབུལ་མཛད་འདུག་པར་གཞུང་ས་ནས་དེ་ཁ་ལེགས་ཚུལ་གྱི་བསླབ་དོན་བཀའ་དྲིན་བསྐྱང་འདུག་པ་དང་།",
    "མ་ནས་ལྕམ་འདི་དཀྱུས་མ་ཞིག་མིན་འདུག་པས།",
    "མགོན་པོ་མཇལ་བ་ན་སྙན་དར་བབས་པ་ཞལ་ཁེབས་མ་གསལ་བ་ཕྱེ་བ་སོགས་ལོ་ཕྱི་ནང་དུ་ལྟས་ཡ་མཚན་པ་བྱུང་འདུག་ཅིང་།",
    "ཞེས་སྐུ་རིམ་གྱི་བརྡའ་སྦྱོར་ཞིག་བྱུང་ཡོད་ཚོད་འདུག་ཀྱང་དེ་སྐབས་ཀྱི་ཟིན་བྲིས་དང་རྒྱུས་ཡོད་ཀྱི་མི་མེད་པས་ཇི་བཞིན་མ་རྟོགས།",
    "སློན་དཔོན་པདྨ་ང་རང་ཡིན་ཞེས་ཐོགས་མེད་ཀྱིས་སྩལ་བ་དང་།",
    "ཡུམ་ལ་སྲས་ཀྱི་དབུ་སྔས་མགོ་ན་པུ་ཏྲ་ལྕམ་སྲིང་ཕེབས་འདུག་ཞུས་པས།",
    "གསུང་ངག་གསན་དུས་དགུང་གྲངས་ལྔ་པ་ཡིན་འདུག་ཀྱང་ཉིན་གཅིག་གསུང་ལས།",
    "དེ་ནས་རིམ་བཞིན་མགོན་ཁང་སྟེང་འོག་ཏུ་འཕྲིན་བཅོལ་གནང་སྐབས་སྐྱེད་ལྷས་དུས་བྲག་སྒོའི་ནང་ན་དྲིལ་ཆུང་གསེར་ཁའི་སྐད་མང་པོ་འདུག་གསུངས་པ་སོགས་ངོ་མཚར་དུ་མ་བྱུང་ཡོད་ཚོད་དུ་འདུགདེ་ནས་རིམ་བཞིན་ཕུར་སྒྲུབ་ཚུགས་པའི་ས་སྐྱ་ཚོགས་སུ་རྩ་འཆམས་ཐོག་སྐུ་ཞང་མཁྱེན་བརྩེ་དཔོན་གཡོག་ནས་ལེགས་འབུལ་མཛད་ཡོད་དམ་སྙམ།",
    "གནས་གསར་གོང་མའི་ཐུགས་དམ་མ་མགོན་སྐུ་བྱིན་ཆེན་ཞིག་དང་ཐུན་རུ་ཁྱད་མཚར་སོགས་འབུལ་བར་མཛད་འདུག་ཅིང་།",
    "ཡར་ལུང་སོགས་ནས་ངེད་ཀྱི་ལག་ཏུ་གནམ་ལྕགས་ཀྱི་རྡོ་རྗེ་ཡོངས་གྲགས་དེ་ཡོད་པ་སྙན་དུ་འབུལ་མི་བྱུང་སྟབས་ཕྱག་མཛོད་ནས་དེ་འདྲ་ཡོད་འདུག་པ་སྤུས་བསྒྱུར་དགོས་ནན་གྱིས་གནང་བྱུང་བར་ཐོག་མར་དེ་འདྲའི་རིགས་མེད་ཅེས་སྐུ་རྩེད་ཞུས་པར་ནན་བསྐྱེད་གནང་བྱུང་བར།",
    "ཞེས་ཡང་ཡང་ཞུ་བ་ཞིག་བྱུང་འདུག་པས་རྗེས་སུ་དྲུང་ཡིག་ལགས་ནས།",
    "ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "ངེང་རང་ནི་བློ་འགྲོ་རང་བསམ་པ་ཞིག་མ་བྱུང་།",
    "ཡང་དགོས་དེ་སྔོན་གཞན་ནས་མཇལ་ཕྱག་ཞུས་པའི་ཉེན་བླང་སྐུ་ཁམས་ལ་གནོད་པ་འདྲ་ཡང་བྱུང་ཡོད་ཚོད་འདུག་ཀྱང་།",
    "གསུང་བརྟག་ཡང་སྐྱར་ཞུས་པར་ནུ་བོ་དེར་རིམ་གྲོ་ཕྲན་ཙམ་མཛད་ནས་འུ་གུ་འདི་བས་སྐུ་ཞབས་གཅེན་གྱི་ཞབས་བརྟན་སྐུ་རིམ་ལ་བརྩོན་དགོས་འདུག་གོཞེས་ནུ་བོ་དེ་མི་འཚོ་བ་དང་ངེད་ལ་རྐྱེན་སེལ་དགོས་པའི་ལུང་གསལ་དེ་འདྲ་སྩལ་ཡང་ཧ་མ་གོ་བས།",
    "འོན་ཀྱང་རིང་བསྲེལ་སོགས་ཞལ་དཀར་བར་བསྐུར་ནས་ངེད་རང་ཡང་དེའི་དྲུང་དུ་ཕྱིན་པས་ཟླ་བོ་ཟི་ཁོལཁོལ་དང་རྒྱལ་ཚིང་མཆི་མ་འདོན་ཞིང་འདུག་པས་ཞལ་དཀར་བས་འཕེལ་གདུང་སོགས་གཏད་བྱུང་བ་བཞིན་བྱིན།",
    "འགྲོ་ལ་རྗེས་བརྩེ་མ་འདི་བློ་ལ་ཐོགས་མེད་འཆར་འདུག་པས་གང་དྲན་དེ་རང་བརྩམས།",
    "ཨ་ར་པ་ཙ་ན།",
    "དངུལ་སྲང་སུམ་བརྒྱ་དང་དྲུག་ཟངས་ཁལ་བཅུ་གསུམ་སོགས་བྱུང་འདུག་ཅིང་།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "བདེན་ངེས་ན་གྲགས་བློ་བའི་བག་ཆགས་ཡོང་རྒྱུར་འདུག་ཀྱང་དེའི་དྲི་ཙམ་ཡང་མ་བྲོ།",
    "ས་སྤྲེ་དབོ་ཟླའི་ནང་མནལ་ལམ་དུ་སྐྱེད་ལྷས་མགོན་ཁང་ཡིན་སྙམ་ཞིག་ན་ཤིང་ལེབ་ལ་བྲམ་གཟུགས་བླ་བརྒྱུད་ཀྱི་མཚན་ཞལ་གྱི་སྔགས་བཅས་འདུག་པ་སྐུ་སྲུང་དུ་བཅང་བ་དང་།",
    "ཡང་རྟག་ཚེར་གངས་རྩེར་ཕེབས་འདུག་པས་དེ་ན་གུར་དཀར་ནང་ཁྲི་མཐོན་པོའི་འགྲམ་བུམ་མེད་མང་པོ་འདུག་པར།",
    "འཇའ་དང་མེ་ཏོག་ཆར་བྱུང་གསུང་བ་འདུག་ཀྱང་།",
    "ཁོ་བོ་ལོ་གཉིས་པ་ལྕགས་ཁྱི་ལོ་དེ་ཧོར་དམག་ཡོང་ངོ་ཡོད་འདུག་ཀྱང་བོད་ཀྱི་སྐུ་རིམ་སྤྱི་སྒེར་གྱིས་སྲུང་ཐུབ་པ་འདྲ།",
    "ཡང་ལན་ཅིག་ཚོགས་ཁང་གྲལ་གདན་མང་པོ་ཞིག་ན་ཁྲོ་འབག་ཀ་བར་སྒྲགས་པ་མཇལ་ཡང་འདི་ཡིན་ངེས་མི་འདུགཡང་ལན་ཅིག་ནམ་ཟིར་ཡིན་བསམ་པ་ཞིག་ལ་བུ་རྫིའི་རྒྱབ་ལ་ཁུར།",
