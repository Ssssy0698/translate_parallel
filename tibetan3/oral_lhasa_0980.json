    "གང་ལ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་རྣམ་པར་དག་པ་ནི་སྔ་མ་དང་འདྲའོ།",
    "འཛིན་པ་ནི་ཚིག་དང་དོན་གྱི་ཚུལ་མ་བརྗེད་པར་དེ་སེམས་ལ་ངེས་པར་འཇོག་པའོ།",
    "ཀློག་པ་ནི་གླེགས་བམ་དུ་བྱས་ནས་ཀློག་པའོ།",
    "ཁ་ཏོན་དུ་བྱེད་པ་ནི་དམ་ཚིག་ཏུ་བཟུང་བ་དེ་ཡང་དང་ཡང་དུ་གོམས་པར་བྱེད་པའོ།",
    "ཁམས་གསུམ་མཐའ་དག་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་སྟེ།",
    "དོན་ཅི་ཞིག་སྟོན་པར་མཛད་ཅེ་ན།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རབ་ཏུ་དགའ་བ་རྣམ་པར་དག་པའི་གནས་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་དེ་བཞིན་གཤེགས་པའི་ཞི་བའི་ཚུལ་རྣམ་པར་སྤངས་ནས་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་ལ་སོགས་པ་སྒེག་པའི་གཟུགས་སུ་འཇོག་པར་མཛད་ཅིང་བཅིངས་ལ།",
    "དེ་ལ་དམིགས་པའི་ཏིང་ངེ་འཛིན་མིང་དེ་སྐད་ཅེས་བྱ་བ་གང་ཡིན་པའི་ཏིང་ངེ་འཛིན་དེ་ལ་སྙོམས་པར་ཞུགས་པས་བཞུགས་པ་ནི།",
    "ཞི་བའི་ཚུལ་སྤངས་ནས་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་དང་གཅིག་ཏུ་གྱུར་ནས་བཞུགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རབ་ཏུ་དགའ་བ་རྣམ་པར་དག་པ་ལ་སོགས་པ་ནས་བརྩམས་ཏེ།",
    "ཏིང་ངེ་འཛིན་གཉིས་པོ་དེ་དག་མངོན་སུམ་དུ་བྱས་ནས་བདེ་བ་ཆེན་པོའི་གནས་ལ་གནས་པའི་སྔགས་པས་བསྡུ་བར་བྱས་ཏེ།",
    "བདེ་བ་ཆེན་པོ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་ངེས་པར་སྦྱར་བ་ནི་ལས་ཀྱི་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལྟར་ན་ཏིང་ངེ་འཛིན་གསུམ་པོ་དེ་དག་ནི་དཀྱིལ་འཁོར་གྱི་བརྟུལ་ཞུགས་ལ་གནས་པའི་སློབ་དཔོན་གྱིས་ངེས་པ་ཁོ་ནར་སྙོམས་པར་འཇུག་པར་བྱས་ཏེ།",
    "དེ་ནས་རྒྱུད་ཕྱི་མ་ལས་གསུངས་པའི་ཚུལ་དུ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་གསོལ་བ་བཏབ་པས་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་སྟེ།",
    "དཀྱིལ་འཁོར་གསུངས་པ་ཡིན་ནོ།",
    "མིང་དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་སྙོམས་པར་ཞུགས་པ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱི་རྣམ་པར་ཐུགས་རྩེ་གཅིག་ཏུ་མཛད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་དེ་ཁོ་ན་ཉིད་ནི་རབ་ཏུ་དགའ་བའི་ངོ་བོ་ཉིད་ལ་སོགས་པར་སྟོན་པའོ།",
    "མིང་དེ་ཉིད་ཅེས་བྱ་བའི་དཀྱིལ་འཁོར་དེ་ཉིད་གང་ཡིན་པ་དེ་གསུངས་པ་ནི་བཀའ་སྩལ་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཀ་བ་བརྒྱད་ལ་སོགས་པའི་གཟུགས་ཅན་དུ་ཡང་དག་པར་བྲིས་ལ།",
    "རྡོ་རྗེ་སེམས་དཔའི་སྐུ་གཟུགས་ཏེ།",
    "ཅེས་གསུངས་པའི།",
    "དཀྱིལ་འཁོར་གཉིས་པར་དེ་བཞིན་གཤེགས་པའི་སྐུ་བསྟན་པས་འདིར་ཡང་སོམ་ཉི་མི་བྱའོ།",
    "རོའི་སྣོད་ཀྱི་མཚན་མ་རྣམས་ནི་དམ་ཚིག་ཆེན་པོ་དང་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པའི་རྒྱུད་རྣམས་ལ་སྟོན་པས་འདིར་སོམ་ཉི་མི་བྱའོ།",
    "སྒོ་ནི་ཐམས་ཅད་ཀྱང་ཆ་བརྒྱད་པར་བྱའོ།",
    "རྡོ་རྗེ་སེ་གོལ་བརྡབ་པ་བྱས་པས་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་སྦྱོར་བ་དང་།",
    "ལན་ཅིག་བར་དུ་བརྗོད་པར་བྱ།",
    "ཡི་གེ་ཧཱུཾ་ཉིད་དང་དང་པོའི་རྡོ་རྗེ་མཉམ་པར་གཞག་པ་དང་བཅས་པ་ཉིད་ཀྱིས།",
    "ཐམས་ཅད་ལ་བསྟན་པར་བྱའོ།",
    "གྲུབ་པར་བྱེད་ཅིང་མྱུར་དུ་འདུད་པར་བགྱི།",
    "མདུད་པ་བྱས་ནས་སྤྱི་བོར་བཞག་ནས་ཕབ་སྟེ།",
    "འཐོར་བ་ལྟར་བྱས་པ་ནི་རྡོ་རྗེ་སྦྲང་རྩིའོ།",
    "དེ་ལ་སོགས་པར་བྱ་བར་བལྟ་བར་བྱའོ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་རྫོགས་པར་བྱས་ནས།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཉིད་ཀྱི་བར་དུ་ཐོབ་པར་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་ཆེན་པོའི་སློབ་དཔོན་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་གྱི་སློབ་དཔོན་དུ་བྱིན་གྱིས་བརླབས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་གྲུབ་ཐམས་ཅད་གྲུབ་པ་དང་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་ལ་སོགས་པའི་དཀྱིལ་འཁོར་གྱི་སློབ་དཔོན་ཉིད་དུ་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔས་བྱིན་གྱིས་བརླབས་པ་དང་ཞེས་བྱ་བ་ནི་ངེས་པ་ཐམས་ཅད་དང་ལྡན་པར་མཛད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ལ་རིགས་ཐམས་ཅད་ཤེས་པ་དང་ལྡན་པ་མངོན་དུ་ཕྱོགས་པར་འགྱུར་རོ།",
    "ལས་ཀྱི་རིགས་རྟོགས་པར་འགྱུར་བར་སྟོན་པ་ཡིན་ལ།",
    "རྡོ་རྗེ་རྣམ་པར་སྒེག་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་སྒེག་པའི་དགའ་བའི་རྡོ་རྗེ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཡང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རྗེས་སུ་མཉེས་པར་ཕྱག་བྱའོ།",
    "ཡི་གེ་ཧཱུཾ་ཡང་ཟློས་བཞིན་དུ་འཇུག་པར་བྱའོ།",
    "ཕྱག་རྒྱ་རྣམས་ཀྱིས་རྒྱས་གདབ་པར་བྱ་སྟེ།",
    "ཕྱག་རྒྱ་རྣམས་ནི་རྒྱས་འདེབས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ཡང་ཅི་སྟེ་ཞེ་ན་གཟུགས་བརྙན་གྱི་ཚུལ་དུ་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་ཕྱག་རྒྱ་རྣམས་གདུལ་བྱ་རྣམས་ལ་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དཔེར་ན་བདེན་པར་སྨྲ་བ་ལ་བདེན་པར་སྨྲ་བ་པོ་ཞེས་ཟེར་བ་ལྟ་བུའོ།",
    "རབ་ཏུ་དགའ་བའི་རྡོ་རྗེའི་ཕྱག་རྒྱ་ལྔ་པོ་བསྡུས་པ་བཅིངས་ལ་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ་བཟླས་བརྗོད་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཕྱག་རྒྱ་དམ་པ་བཅིང་བར་མ་བྱས་པར་ཡང་བཟླས་བརྗོད་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དཀྱིལ་འཁོར་དུ་ཞུགས་པ་ཙམ་གྱིས་ཞེས་བྱ་བ་ནི་སྔོན་དུ་བསྙེན་པ་མེད་པར་ཏེ།",
    "རིམ་པ་འདི་ནི་ཡེ་ཤེས་བབས་པར་གྱུར་པ་ཡིན་ནོ།",
    "ལས་རྣམས་འགྲུབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་བདེ་བ་ཐམས་ཅད་ཕུལ་བས་སོ་ཞེས་བྱ་བ་ལ་འདོད་ཆགས་ཐོག་མར་བྱས་པའི་བདེ་བ་ཐམས་ཅད་གང་ཡིན་པ་དེ་ནི་འདོད་ཆགས་ལ་སོགས་པའི་བདེ་བ་སྟེ།",
    "འདོད་ཆགས་དམ་ཚིག་ཡིན་པར་བཤད།",
    "དེ་ཡང་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་བསྒོམས་པས་དུབ་པར་གྱུར་ན།",
    "ཕྱག་བཞི་ཡང་དང་ཡང་དུ་བྱས་པས་ངལ་བ་བསལ་བ་ནི་བདེ་བ་ཐམས་ཅད་ཕུལ་བ་སྟེ།",
    "དེ་ལྟ་བུས་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མཉེས་པར་བྱས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་དང་འཁྱུད་ཅིང་འོ་བྱེད་པས་སོ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་སེམས་དཔའ་མདུན་དུ་བཞུགས་སུ་གསོལ་ཏེ་བཅིངས་ལ།",
    "ཡང་ན་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་མཆོག་ལས་བཏུས་པའི་བཟླས་པའི་རྣམ་པ་ཡིན་པར་བསྟན་ཏེ།",
    "བརྒྱ་བྱིན་ལ་སོགས་པའི་གཟུགས་བརྙན་གྱི་མདུན་དུ་དེ་རྗེས་སུ་ཆགས་པར་བྱ་བའི་བསམ་པས་ཡི་གེ་ཧཱུཾ་བཟླས་བརྗོད་འབུམ་བྱས་ན།",
    "དེ་ནས་དེ་རྗེས་སུ་ཆགས་པས་བདག་ཉིད་ཀྱི་ཐམས་ཅད་ཉེ་བར་སྟོབས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་འབར་བའི་ནང་དུ་བདག་ཉིད་ཚུད་པར་བསམས་ན་བདག་ཉིད་བསྲུང་བར་བྱས་པར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་གྱི་ར་བ་ལ་སོགས་པའི་ཚུལ་དུ་བྱས་པས་བསྲུང་བར་བྱའོ།",
    "རྨུགས་པར་བྱ་བ་ལ་ནི་བསྒྲུབ་པར་བྱ་བའི་ལྕེ་གཟུང་བའི་ཚུལ་གྱིས།",
    "རྡོ་རྗེ་བསྡམས་པས་རྡོ་རྗེ་བཟུང་ལ་དེ་བཅིང་བའི་ཚུལ་དུ་བྱས་ན་དེ་ལྐུགས་པར་འགྱུར་ཏེ།",
    "ཚིག་འཕྲོག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྨོངས་པར་བྱ་བ་ལ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་གཅིག་ཏུ་བྱས་ལ་མིག་བཙུམས་ཏེ་བཟླས་པ་བྱའོ།",
    "ལག་པ་གཡོན་པའི་རྡོ་རྗེ་ལ་བསྒྲུབ་པར་བྱ་བའི་མིང་བློས་བསམས་ཏེ།",
    "ལག་པ་གཡས་པའི་རྡོ་རྗེས་བསྣུན་ན་ཐམས་ཅད་གསོད་པར་འགྱུར་རོ།",
    "སེམས་ཀྱིས་ཀྱང་ཅི་ཡང་ཤེས་པར་མི་འགྱུར་རོ།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མའི་ཕྱག་རྒྱས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདི་ཡང་ཁྲོ་བོ་ཆེན་པོའི་ཁུ་ཚུར་གཉིས་ཀྱིས་གར་བྱས་ལ།",
    "བདག་ཉིད་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་གཟུགས་ནམ་མཁའི་ཁམས་ཐམས་ཅད་ཁྱབ་པར་བསམས་ལ།",
    "བསྙེམས་པ་དང་བཅས་པས་ཧཱུཾ་བཟླས་པར་བྱའོ།",
    "དབུ་འོག་ནས་བསྟོད་པའི་ཚུལ་གྱིས་བྷྱོ་ཞེས་བྱ་བ་བརྗོད་པར་བྱ་སྟེ།",
    "རྗེས་སུ་ཆགས་པར་འགྱུར་རོ།",
    "ཀི་ལི་ཀི་ལའི་ལས་ཀྱི་ཕྱག་རྒྱས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འཁྱུད་པས་ནི་ཐམས་ཅད་མཉེས་པར་འགྱུར་རོ།",
    "གནོད་སྦྱིན་མའི་གཟུགས་བརྙན་ལ་སོགས་པ་ལ་ཡང་འཁྱུད་ནས་བསྒྲུབ་པར་བྱའོ།",
    "རྡོ་རྗེ་སྙེམས་པ་ལ་ནི་རྡོ་རྗེ་སྙེམས་པའི་ལས་ཀྱི་ཕྱག་རྒྱས་མ་རུངས་པ་རྣམས་རབ་ཏུ་བསྒྲུབ་པར་བྱའོ།",
    "འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གཡོགས་ཏེ་བྱ་བ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་སྒྲ་ཐམས་ཅད་ཐོས་པར་བྱའོ།",
    "གར་བྱེད་དུ་འཇུག་པ་ལ་ནི་ལྷའི་སྦྱོར་བས་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཡིད་ཀྱིས་ཞུགས་ཏེ་རང་ཉིད་གར་བྱེད་ཅིང་བཟླས་པ་བྱའོ།",
    "གཾ་ལས་བྱུང་བའི་བ་དན་གསུམ་པ་གཉིས་བྱས་ལ།",
    "བདུད་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་བགེགས་ཐམས་ཅད་བསྐྲད་ཅིང་གཞིག་པ་ལ་ནི་འཁྲུགས་པས་དཔག་ཏུ་མེད་པར་བཟླས་པ་བྱས་ཏེ།",
    "མཁའ་འགྲོ་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྡོ་རྗེ་བསྙེམས་པས་རྡོ་རྗེ་གསོར་ཞིང་རྡོ་རྗེ་འབར་བས་མཁའ་འགྲོ་མའི་གདོན་རྣམས་བསྲེག་པར་གྱུར་པར་བསམ་ཞིང་ཧཱུཾ་ཞེས་བྱ་བ་བརྗོད་ན་མཁའ་འགྲོ་མའི་གདོན་ཐམས་ཅད་ལས་གྲོལ་བར་འགྱུར་རོ།",
    "ཕྱག་རྒྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རྡོ་རྗེ་འཕེན་པའི་ཚུལ་དུ་འཕངས་ན་གདོན་ཐམས་ཅད་ལ་སོགས་པའི་ཕྱག་རྒྱ་རྣམས་འཇིག་པར་འགྱུར་རོ།",
    "བསྐལ་པའི་མེ་ལྟར་འབར་བའི་ཁུ་ཚུར་དེ་ཉིད་ཀྱིས་ཡང་དང་ཡང་དུ་འཕང་པར་བྱའོ།",
    "དེས་ཆོ་འཕྲུལ་ཐམས་ཅད་བསྟན་པར་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་གློག་འགྱུ་བ་འདེབས་པའི་ཚུལ་དུ་ནམ་མཁའ་ལ་བསྐོར་བར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་རྫུ་འཕྲུལ་རྣམ་པར་འཕྲུལ་པའོ།",
    "ཀླུའི་གཟུགས་བརྙན་བྱས་ལ་ཀླུ་ཡོད་པའི་མཚོར་ཞུགས་ཏེ།",
    "ཀླུ་དེ་ཉིད་གཡོན་བརྐྱང་བས་མནན་ལ་བཟླས་བརྗོད་བྱས་ན་རྗེས་སུ་འབྲང་བར་འགྱུར་རོ།",
    "སེར་བ་ཐམས་ཅད་ཟློག་པར་བྱེད་པའོ།",
    "དང་པོའི་རྡོ་རྗེ་ཕྱག་རྒྱ་བཅིངས་ལ་མཐེ་བོང་གཉིས་གདེངས་ཀ་བསྒྱིངས་པའི་ཚུལ་དུ་བསྟན་པ་བྱས་པ་འདི་ནི་རྡོ་རྗེ་གླུའི་ཕྱག་རྒྱའོ།",
    "ཇི་སྲིད་ཆུ་ལུད་པར་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་བརྗོད་བྱ་སྟེ།",
    "འདི་ནི་གཏེར་ཤེས་པར་བྱ་བའི་ཕྱག་རྒྱའོ།",
    "འདིས་རྒྱལ་སྲིད་ཐམས་ཅད་ཐོབ་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་རིག་པ་འཛིན་པར་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པའི་དཀྱིལ་འཁོར་སྟོན་པར་མཛད་པར་བཞེད་པས་དེ་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པར་ཉེ་བར་དགོད་པར་མཛད་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་སྲ་བ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདུས་མ་བྱས་པའི་ངོ་བོ་ཉིད་ཡིན་པས་རྡོ་རྗེ་དེ་ནི་རོ་གཅིག་པའི་ཡེ་ཤེས་ཏེ།",
    "དེ་བས་ན་རྡོ་རྗེ་སྲ་བ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "དོན་དམ་པར་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་དོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་རྣམ་པར་དག་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐམས་ཅད་ལ་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པའི་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དང་བཅས་པས་འདི་གསུངས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་གསུངས་པ་ནི་བཀའ་སྩལ་པའོ།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་སྙོམས་པར་ཞུགས་ནས་དཀྱིལ་འཁོར་ཆེན་པོ་འདི་གསུངས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་སྟོན་པར་བྱེད་པ་ཉིད་ཀྱིས་ན་མིང་དེ་ཉིད་ཅེས་བྱ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་གང་ཡིན་པ་འདི་གསུངས་སོ་ཞེས་བྱ་བ་ནི་བཀའ་སྩལ་པའོ།",
    "བཛྲ་བཛྲ་ཨ་ཞེས་ཟློས་ཤིང་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་འཇུག་པར་བྱའོ།",
    "རྣམ་པར་མི་རྟོག་སྦྱོར་བ་ཡི།",
    "སྣ་ཚོགས་རྡོ་རྗེ་སྐལ་པ་ཇི་ལྟ་བ་བཞིན་དུ་མེ་ཏོག་གང་ལ་བབས་པ་དེ་ལ་མཚན་མ་དེ་སྦྱིན་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་དུ་ཞུགས་པ་ཙམ་ཉིད་ཀྱིས་ལས་རྣམས་འགྲུབ་པར་འགྱུར་ཞེས་བྱ་བ་འདི་ནི་ཡེ་ཤེས་བབས་པར་གྱུར་པ་རྣམས་ཀྱི་ཡིན་པར་ཐམས་ཅད་བལྟ་བར་བྱའོ།",
    "དེས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཚིམ་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཡང་དག་པར་མཆོད་ལ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་དཀྱིལ་འཁོར་སྟོན་པར་བཞེད་པ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་རྣམ་པར་རྒྱལ་བ་ནི་མཉམ་པ་ཉིད་བསྒོམས་པས།",
    "ཞེ་སྡང་ལ་སོགས་པ་ངེས་པར་བསྩལ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྒྲུབ་པ་དེ་གསུངས་པའོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "རྗེས་སུ་ཆགས་པའི་དངོས་པོ་དམིགས་སུ་མེད་པས་ཁོང་ཁྲོ་བ་འདིའི་དངོས་པོ་ཡང་ཉེ་བར་དམིགས་པར་མི་འགྱུར་རོ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་རྡོ་རྗེའི་ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱའོ།",
    "འབར་བའི་ལྟ་བ་ཡིན་པར་བཤད།",
    "དེ་ནས་རྡོ་རྗེ་ཁྲོ་བོ་སྟེ་ཁྲོ་བོ་ཆེན་པོ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཕྱུང་ནས་བཞུགས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མཆེ་བ་རྣམ་པར་གཙིགས་པ་ཉིད་ཀྱི་ཚེམས་ཀྱི་སྒྲོས་མ་མཆུ་གནོན་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཨག་ཚོམ་རྣམས་འབར་ཞིང་འཇིགས་སུ་རུང་བའི་ཞལ་གང་ལ་མངའ་བ་དེ་ལ་ནི་རྣམ་པར་འགྱུར་བའི་མཆེ་བ་གཙིགས་པ་ཚེམས་ཀྱི་སྒྲོས་གནོན་པ་སྨིན་མ་མི་བཟད་ཅིང་ཁྲོ་གཉེར་བསྙེར་བ་སྤྱན་དང་དབུ་སྐྲ་དང་ཨག་ཚོམ་འབར་བ་ཞལ་འཇིགས་པ་ཞེས་བྱའོ།",
    "དེར་གནས་པ་ལ་སོགས་པའི་ལྷ་ཆེན་པོ་ལ་སོགས་པ་གདུལ་བར་མཛད་པས་ན་ཁམས་གསུམ་པོ་མཐའ་དག་ལས་རྣམ་པར་རྒྱལ་བ་སྟེ།",
    "རྣམ་པར་རྒྱལ་བ་དེ་དཀྱིལ་འཁོར་གང་དུ་མཛད་པ་དེ་ནི་དཀྱིལ་འཁོར་ཆེན་པོའོ།",
    "ཡང་ན་ཁམས་གསུམ་པོ་མཐའ་དག་ལས་རྣམ་པར་རྒྱལ་བ་ཞེས་བྱ་བ་ལ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ནི།",
    "དཀྱིལ་འཁོར་མིང་དེ་སྐད་ཅེས་གསུངས་སོ།",
    "འདི་ནི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་བཅས་པས་ཐམས་ཅད་རྒྱས་གདབ་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་གཞིག་པའི་བསམ་པར་བྱ་བ་སྟེ།",
    "འདིས་ནི་ཐམས་ཅད་གཞིག་པར་འགྱུར་རོ།",
    "འདིས་ནི་གནོད་པ་ཐམས་ཅད་དགུག་པར་བྱའོ།",
    "མ་ཡིན་པར་འཆད་དོ།",
    "ཧ་ཧ་ཧ་ཧཱུཾ་ཞེས་བཟླས་པས་གནོད་སྦྱིན་ཐམས་ཅད་སྐྲོད་པར་འགྱུར་རོ།",
    "འདིས་ལུས་ངན་པོ་མནན་ལ་དཔལ་དབྲོག་པར་བྱའོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ནི་རྡོ་རྗེ་ཁྲོ་བོའི་གདུག་པའི་དམ་ཚིག་འཇིག་པར་བྱེད་པའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ལ་ཁ་ཕྱེ་སྟེ་གདོང་འཇིགས་སུ་རུང་ཞིང་སྐྲ་གྱེན་དུ་བརྫེས་པ་མགོ་འོག་ནས་བསྟོད་དེ་བཏེག་ཅིང་བྷྱོ་ཞེས་བྱ་བ་སྨྲ་བ་འདི་ནི་རྡོ་རྗེ་ཁྲོ་བོའི་གནོད་སྦྱིན་མ་སྟེ་འདིས་བདུད་ཀྱི་དཔུང་ཐམས་ཅད་གསོད་པར་བྱེད་དོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཟློས་ཤིང་ནུབ་པའི་ཚུལ་གྱིས་ས་ཐམས་ཅད་ནུབ་པར་བྱའོ།",
    "འདི་ཉིད་དང་ཧི་ཞེས་བྱ་བས་འཇིག་རྟེན་གསུམ་པོ་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བར་བྱ་སྟེ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་གྱི་འགྲེལ་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།"
  ]
}