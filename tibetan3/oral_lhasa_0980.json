    "བཞི་པར་ཡི་གེ་ཧཱུཾ་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "གཉིས་པར་ནི་རྡོ་རྗེ་གསང་བའི་ཆོ་ག་དང་བཅས་པ་ཉི་ཤུ་རྩ་བདུན་ནོ།",
    "གསུམ་པར་ནི་ཉི་ཤུ་རྩ་གཅིག་གོ།",
    "ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ་སྡོང་བུ་དང་བཅས་པའི་སྣ་ཚོགས་པདྨའི་གདན་བྱས་ལ།",
    "འཇམ་དཔལ་འཁོར་དུ་བཞུགས་པའོ།",
    "ཆུང་མ་དང་བཅས་པར་གནས་པའོ།",
    "ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ་སྣ་ཚོགས་པའི་པདྨའི་སྟན་རྣམ་པར་བཞག་པ་ལ།",
    "དབུས་སུ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་སྤྲུལ་པའི་སྐུ་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་དེར་བཞུགས་པར་བྱའོ།",
    "དེ་ལྟར་ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ་སྣ་ཚོགས་པདྨའི་གདན་ལ་དབུས་སུ་རྡོ་རྗེ་ཧཱུཾ་མཛད་དེའི་སྤྱན་སྔར་གཡས་བརྐྱང་པས་བཞུགས་ཏེ།",
    "གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་སྡིགས་མཛུབ་མཛད་པར་བརྩོན་པའོ།",
    "བྱང་དུ་ནི་མདུང་བསྒྲེང་ནས་གནས་པར་བྱའོ།",
    "བྱང་དུ་ནི་པདྨའི་གཟུགས་ཅན་ཡང་དག་པར་དགོད་པར་བྱའོ།",
    "རྡ་ཡབ་ཀྱིས་ཉེ་བར་བསྒྲུབ་པར་བྱས་པས་མཛེས་པར་གནས་པར་བྱའོ།",
    "ཕྱི་རོལ་གྱི་མཚམས་རྣམས་སུ་ནི་བུམ་པ་གང་བ་གཞག་པར་བྱའོ།",
    "ཕྱི་རོལ་དུ་ནི་རྒྱལ་མཚན་དང་བ་དན་ལ་སོགས་པ་གནས་པར་བྱའོ།",
    "དེའི་ཕྱེད་ཀྱིས་དེའི་ནང་དུ་རྡོ་རྗེ་ཐིག་ཟླུམ་པོས་བསྐོར་བ་ཀ་བ་བརྒྱད་ཀྱིས་ཉེ་བར་མཛེས་པར་བྱས་པ།",
    "ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ་སྣ་ཚོགས་པདྨའི་གདན་བྱས་ཏེ།",
    "འདོད་པ་ཐམས་ཅད་ཐོབ་པར་བྱེད་པའོ།",
    "དེ་ལ་ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ་ནི་སྣ་ཚོགས་པདྨ་ཡང་དག་པར་གནས་པ་ལ་འཁོར་ལོའི་ལྟེ་བར་བཅོམ་ལྡན་འདས་འཇམ་དཔལ་ལོ།",
    "ཕྱི་རོལ་གྱི་མཚམས་རྣམས་སུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གླེགས་བམ་བཞི་གཞག་པར་བྱའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གླེགས་བམ་གཞག་པར་བྱའོ།",
    "ཤར་ལ་སོགས་པའི་སྒོ་རྣམས་སུ་ནི་དོང་ཙེ་དང་གསེར་དང་མུ་ཏིག་དང་རྒྱན་གཞག་པར་བྱའོ།",
    "ལྷ་ཐམས་ཅད་ཀྱི་གནས་སུ་སྣ་ཚོགས་པདྨའི་གདན་ལ་འབར་བའི་དཀྱིལ་འཁོར་གྱིས་བརྒྱན་པར་བྱས་ལ།",
    "སྒོ་རྣམས་སུ་ནི་རྩེ་ལྔ་པའི་ཁྲོ་བོ་རྡོ་རྗེ་བསྣམས་པའི་ཕྱག་ན་རྡོ་རྗེ་གཞག་པར་བྱའོ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་དཀྱིལ་འཁོར་རྣམས་མཚམས་སུ་གནས་པར་བྱའོ།",
    "རིམ་པ་གསུམ་པ་སྟེ་ཐམས་ཅད་ཀྱང་སྒོ་བཞི་པ་ལ་མཚམས་བཞི་པོར་མདུང་རྩེ་གསུམ་པས་མཚན་པ་གནས་པར་བྱའོ།",
    "དྲག་པོ་ཆེན་པོ་རྣམས་གནས་པར་བྱའོ།",
    "ཕྱིའི་དཀྱིལ་འཁོར་ཟུར་བཞི་པ་ལ་སྒོ་བཞི་པར་བྱས་ལ།",
    "དེའི་དབུས་སུ་གཞུ་ལྟ་བུའི་དཀྱིལ་འཁོར་གཉིས་ལ་ཕྱེད་ཀྱི་ཚད་དུ་བྱས་ལ།",
    "དེའི་དབུས་སུ་སེང་གེའི་གདན་བྱས་ནས།",
    "ལྕགས་སྒྲོག་དང་དྲིལ་བུ་རྣམས་གནས་པར་བྱའོ།",
    "ཤར་ལ་སོགས་པའི་སྒོ་རྣམས་སུ་ནི་ལྕགས་ཀྱུ་ལ་སོགས་པ་ཡང་དག་པར་གནས་པར་བྱའོ།",
    "ཤར་ལ་སོགས་པའི་སྒོ་རྣམས་སུ་ནི་ལྕགས་ཀྱུ་ལ་སོགས་པ་གནས་པར་བྱའོ།",
    "ཁྲུ་གང་ཙམ་གྱི་སྐས་བཞི་ལས་བབས་པར་བརྐོས་པ།",
    "རིགས་ལྡན་གདེངས་ཀ་བདུན་བདུན་དང་ལྡན་པ་སྐྱེས་བུའི་གཟུགས་སུ་གནས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་བུམ་པ་གཅིག་གཞག་པར་བྱའོ།",
    "དུམ་བུ་གཉིས་པ་ནས་གསུངས་པའི་རྒྱུད་ཕྱི་མའི་དཀྱིལ་འཁོར་དང་པོའོ།",
    "ཤར་ལ་སོགས་པའི་སྒོ་རྣམས་སུ་ནི་ལྕགས་ཀྱུ་ལ་སོགས་པ་གནས་པར་བྱས་པ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་མཉམ་པའི་ཟླུམ་པོ་རིམ་པ་བདུན་པ་བྱས་ཏེ།",
    "དེའི་མདུན་དུ་རྡོ་རྗེ་མཚོན་ཆ་འཛིན་མ་གཡོན་བརྐྱང་པས་གནས་པས་བཞུགས་པ།",
    "དེའི་ཕྱི་རོལ་གྱི་ཐིག་དང་པོའི་ནང་དུ་རྡོ་རྗེ་གཙུག་ཏོར་ལ་སོགས་པ་གོ་རིམས་བཞིན་དུ་བཞུགས་པར་བྱས་ཏེ།",
    "དེ་བཞིན་དུ་གཡོན་བརྐྱང་པས་བཞུགས་ཤིང་གཡོན་པའི་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་སྡིགས་མཛུབ་བྱེད་ཅིང་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རྡོ་རྗེ་གཙུག་ཏོར་ལ་སོགས་པ་བསྣམས་པར་བྱའོ།",
    "ལྔ་པར་ནི་རཱ་ཛ་ནཱ་ག་དང་པྲ་ཏི་ཧ་ར་དང་།",
    "དྲུག་པར་ནི་རྡོ་རྗེ་ཕོ་ཉ་དང་།",
    "བདུན་པར་ནི་རྡོ་རྗེ་གཙུག་ཏོར་རམ།",
    "རྡོ་རྗེ་སྨིན་མཚམས་ཀྱིས་བརྙས་པར་གྱུར་ཅིང་།",
    "སྒོ་རྣམས་སུ་ནི་ལྕགས་ཀྱུ་ལ་སོགས་པ་བཞུགས་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "སྒོ་རྣམས་སུ་ནི་པདྨའི་ལྕགས་ཀྱུ་བཞུགས་པར་བྱའོ།",
    "སྒོ་རྣམས་སུ་རིན་ཆེན་ལྕགས་ཀྱུ་ལ་སོགས་པ་ཡང་དག་པར་གནས་པར་བྱའོ།",
    "འདི་དག་ཐམས་ཅད་ཀྱང་འཁོར་དང་བཅས་པར་བཞུགས་པའོ།",
    "རྡོ་རྗེའི་མེ་ཏོག་ཅན་གྱིས་མདའ་དང་གཞུ་བསྣམས་ནས་བཞུགས་པར་བྱའོ།",
    "རྟོག་པ་ཐམས་ཅད་ཀྱི་རྒྱུད་ཕྱི་མ་དང་རྩ་བའི་རྒྱུད་རྫོགས་སོ་ཞེས་གསུངས་པས་ན་འདིར་སོ་མ་ཉི་མི་བྱའོ།",
    "འདི་དག་ཉིད་མྱུར་དུ་འགྲུབ་པར་བྱ་བའི་ཕྱིར་རྡོ་རྗེ་སེམས་དཔའ་དང་།",
    "ཀླུ་དང་སྡུག་བསྔལ་གྱི་དཀྱིལ་འཁོར་མེད་པར་བལྟ་བར་བྱའོ།",
    "རས་རིས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་དྲུག་པོ་འདི་དག་ནི་རྒྱུད་ཀྱི་དུམ་བུ་གཉིས་པར་གསུངས་པ་ཡིན་ནོ།",
    "དུམ་བུ་གསུམ་པར་ཡང་རྡོ་རྗེ་སེམས་དཔའ་དང་།",
    "བསྡུས་པའི་དཀྱིལ་འཁོར་རྣམས་དུམ་བུ་གཉིས་པ་ལས་གསུངས་པའི་དཀྱིལ་འཁོར་ལ་བལྟ་བར་བྱའོ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་གསང་བའི་དཀྱིལ་འཁོར་དུ་ནི་ཁྱད་པར་འདི་ཡིན་ཏེ།",
    "རྡོ་རྗེ་མེ་ལྟར་རབ་ཏུ་འབར་བའི་རས་རིས་ཀྱི་ཆོ་ག་ལ་ནི་ཁྱད་པར་འདི་ཡོད་དེ།",
    "བཞི་པར་ཡང་རྡོ་རྗེ་སེམས་དཔའ་དང་།",
    "རྡོ་རྗེ་མེ་ལྟར་རབ་ཏུ་འབར་བའི་དཀྱིལ་འཁོར་རྣམས་ནི་དུམ་བུ་གཉིས་པར་གསུངས་པ་ཉིད་ཡིན་ནོ།",
    "ཀླུ་དང་སྡུག་བསྔལ་ལས་གདོན་པ་དང་བསྡུས་པའི་དཀྱིལ་འཁོར་རྣམས་ནི་དུམ་བུ་གཉིས་པ་ལས་གསུངས་པའི་དཀྱིལ་འཁོར་ཉིད་ཡིན་ནོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་སྒྲའི་རྒྱུན་ནི་རྒྱུད་ཅེས་བྱ་སྟེ།",
    "དེ་ལྟར་གྱུར་པའི་དཔལ་མཆོག་དང་པོའི་རྒྱུད་རྡོ་རྗེ་འཛིན་པ་ཆེན་པོའི་ངོ་བོ་ཉིད་བློ་ལ་བཞག་ནས་སྡུད་པར་བྱེད་པ།",
    "དུས་གཅིག་ན་ཞེས་བྱ་བ་གསུངས་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་བྱིན་གྱི་རླབས་དང་དམ་ཚིག་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱག་རྒྱ་དམ་ཚིག་ཡིན་པར་བཤད།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དམ་ཚིག་དེ་རྣམས་ལ་མཁྱེན་པ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་མངོན་སུམ་དུ་བྱ་བ་ངེས་པའི་ཚུལ་ལོ།",
    "དེས་ན་དེ་ལྟ་བུའི་ཚུལ་དང་ཡང་དག་པར་ལྡན་ཞིང་བཅས་པའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཟུགས་མེད་པའི་ཁམས་ཀྱི་ངོ་བོ་ཉིད་ཀྱི་ཁམས་གསུམ་དུ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་དམིགས་ཤིང་བདག་ཏུ་རྨོངས་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་དངོས་པོའི་དོན་ཐམས་ཅད་ཇི་ལྟ་བ་བཞིན་དུ་ཐུགས་སུ་ཆུད་པ་སྟེ།",
    "ལམ་གྱི་རྣམ་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའོ།",
    "བཅོམ་ལྡན་འདས་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རྣམ་པར་དག་པ་པདྨའི་རིགས་ཀྱི་ངོ་བོ་ཉིད་ཐུགས་སུ་ཆུད་པ་ཡིན་པར་སྟོན་ཏོ།",
    "སྔགས་པ་རྣམས་ཀྱིས་ཀྱང་རྣལ་འབྱོར་ལ་གོམས་པར་བྱའོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "དེ་རྣམས་ཀྱི་མཉམ་པ་ཉིད་ནི་དོན་དམ་པར་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་དང་།",
    "ཀུན་རྫོབ་ཏུ་དབྱེ་བ་མེད་པ་ཁྱད་པར་དུ་འབྱེད་པར་བྱེད་པ་ཉིད་དེ་དེས་ཐུགས་སུ་ཆུས་པ་ནི་བརྙེས་པའོ།",
    "མ་མཐོང་བའི་འབྲས་བུ་ཐོབ་པར་མཛད་པས་ན་སྣ་ཚོགས་པའི་བྱ་བ་མཛད་པ་སྟེ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་མངོན་སུམ་དུ་མཛད་པས་བྱ་བ་སྒྲུབ་པའི་ཡེ་ཤེས་བརྙེས་ཏེ།",
    "ལས་ཀྱི་རིགས་ཀྱི་ངོ་བོ་ཉིད་ཡིན་པར་སྟོན་ཏོ།",
    "སྔགས་པ་རྣམས་ཀྱིས་ཀྱང་ཞི་བ་ལ་སོགས་པའི་ལས་རྣམས་ལ་གོམས་པར་བྱའོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "ཐུགས་རྗེ་ཆེ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་རྣམ་པར་སྣང་མཛད་ཀྱང་ཡིན་ལ་ཆེན་པོ་ཡང་ཡིན་པས།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོ་སྟེ།",
    "རྣམ་པར་སྣང་བར་བྱེད་པ་ཉིད་ཀྱིས་ན་རྣམ་པར་སྣང་མཛད་དོ།",
    "འདི་སྐད་སྟོན་ཏེ་ནམ་མཁའི་ཁམས་ཐམས་ཅད་ལྟར་རྟག་ཏུ་བཞུགས་པ།",
    "གཟུགས་ཐམས་ཅད་ཡང་དག་པར་སྟོན་པར་མཛད་པས་ན་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ཞེས་བྱའོ།",
    "རྟག་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ད་ལྟར་བྱུང་བ་ཞེས་བརྗོད་པར་བྱ་ཞེ་ན།",
    "དུས་གསུམ་གྱིས་མཉམ་པ་ཉིད་ལ་བཞུགས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་དག་སྤྲུལ་པའི་སྐུས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ལ་སོགས་པ་ཡང་དག་པར་སྟོན་པར་མཛད་པས་དུས་གསུམ་གྱིས་མཉམ་པ་ཉིད་ལ་བཞུགས་པ་སྟེ།",
    "ཀུན་རྫོབ་ཏུ་བཞུགས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅི་འདི་དག་གཞན་དུ་རྣམ་པར་དབྱེ་བའམ་འོན་ཏེ་མ་ཡིན་ཞེ་ན།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་པོ་དེ་ལས་ངེས་པར་བྱུང་བའི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་དང་།",
    "དེ་ཡང་ཇི་ལྟར་སྐུ་དང་གསུང་དང་ཐུགས་འདི་དག་རྡོ་རྗེར་གནས་པ་དེ་བཞིན་དུ་བློས་རྟོགས་པར་མཛད་ཅིང་དེ་བཞིན་དུ་གཞན་དག་ལ་སྟོན་པར་མཛད་པ་ནི།",
    "དེ་བཞིན་གཤེགས་པའོ་ཞེས་གསུངས་ཏེ།",
    "སྟོན་པར་མཛད་པའི་ཡོན་ཏན་ཡང་དག་པར་སྟོན་པར་མཛད་པ་འདིས།",
    "དང་བས་བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་པ་ཡིན་ནོ་ཞེས་ངེས་པ་སྐྱེས་པར་གྱུར་ནས་འཇུག་པར་འགྱུར་བ་དང་།",
    "གང་དུ་བཞུགས་པས་འདི་གསུངས་ཞེས་རྣལ་འབྱོར་གྱི་གནས་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཞུགས་ཤིང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བསྟེན་པ་ཡིན་པས་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཞུགས་ཤིང་ཞེས་བྱའོ།",
    "དེ་ལྟར་ན་དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཞུགས་པ་དང་།",
    "དེ་བས་ན་དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཞུགས་ཤིང་བསྔགས་པའང་བསྟོད་པ་དེ་ལྟ་བུའི་གནས་དེར་བཞུགས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་རྣམས་ཀྱིས་སྤྲས་པ་ནི་རྣམ་པར་བརྒྱན་པའོ།",
    "གང་ན་བཞུགས་ཤེ་ན།",
    "འདོད་པའི་ཁམས་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་གྱི་སྤྲུལ་པ་ལ་ལོངས་སྤྱོད་པར་ནུས་པའི་ལྷ་དེ་རྣམས་ཉིད་ཀྱི་རྒྱལ་པོ་ཡིན་པས་ན།",
    "འདིས་ནི་གདུལ་བྱ་རྣམས་འདོད་པ་བསྐྱེད་པར་བྱ་བའི་ཕྱིར།",
    "གནས་ཕུན་སུམ་ཚོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཅི་བཅོམ་ལྡན་འདས་འདི་གཅིག་པུ་ཞིག་བཞུགས་སམ་ཞེ་ན།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ལ་སོ་སོར་རྟོག་པར་མཛད་པ་དང་།",
    "དེ་ཉིད་ནི་རྫས་ཀྱི་སྣོད་ཀྱི་ཁང་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ནམ་མཁའི་མཛོད་དོ།",
