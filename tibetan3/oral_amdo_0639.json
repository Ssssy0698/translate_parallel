    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "ཀའོ་ཀྲིན་ཏུང་གིས་བརྩམས།",
    "རེད་ཡ།",
    "མ་རེད།",
    "དཔེར་ན་ད་ལོའི་མཐོ་རྒྱུགས་ལ་མི་རེ་རེར་སྐར་བཅུ་ཁ་སྣོན་བརྒྱབ་པ་ཡིན་ན་སྐར་གྲངས་མ་བསྣན་པ་དང་ཁྱད་པར་ཅི་ཡོད།",
    "གནམ་འོག་གི་དར་རྒུད།",
    "སྐྱེས་པའི་འགན་ཟེར་བ་ནི་མི་ཚང་མར་འགན་ཅི་ཡང་མེད་ཟེར་བ་དང་གཅིག་མཚུངས་རེད།",
    "དེས་ན་སྐྱེས་པའི་འགན་དེ་ང་ཡི་འགན་ཞེས་པར་བསྒྱུར་དགོས་པ་རེད།",
    "གནམ་འོག་གི་དར་སོ་ལྔ།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "དེས་ན་ཁོང་ཚོས་སྒྲུབ་ཐུབ་པ་ཞིག་ང་ཚོས་ཅི་ལ་མི་ནུས།",
    "གནམ་འོག་གི་དར་རྒུད་ང་ལ་ཡང་འགན་ཁུར་ཡོད་པའི་བསམ་བློ་འདི་ཡོད་ན་ད་གཟོད་ང་ཚོའི་རྒྱལ་ཁབ་ལ་རེ་བ་ཡོད་སོང་བ་རེད།",
    "རྒྱལ་ཁབ་སྟོབས་འབྱོར་མི་ལྡན་པ་ང་ལ་ཡང་འགན་ཁུར་ཡོད་ཅེས་རང་རྟོགས་ཀྱིས་ང་ཡི་འགན་ཁུར་ཡིན་པར་བསམ་ཐུབ་ན་གནམ་འོག་གི་རྒྱལ་ཁབ་གང་ཞིག་འཕེལ་རྒྱས་སུ་མི་འགྲོ།",
    "འདི་ནི་ང་ཡི་འགན་ཁུར་རེད་ཅེས་ཟེར་བཞིན་མྱུར་དུ་སོང་ནས་གད་བདར་བྱེད།",
    "མི་འགའ་རེས་འདི་ལྟར་བྱས་ན་རང་གིས་ཕམ་ཁ་ཉོས་པ་རེད་ཟེར་སྲིད་མོད།",
    "ཁྱོད་ཚོས་བསམ་བློ་ཐོངས་དང་།",
    "ཁྱོད་ཀྱིས་ལས་བཟོ་བ་སྐོར་ཞིག་ལ་བལྟས་ཏེ་འདི་ནི་ཁོ་ཚོའི་བྱ་བ་རེད།",
    "ཁྱོད་ཀྱིས་མིག་སྔར་གྱི་བྱ་བར་ཡང་འགན་ཁུར་མི་ཐུབ་ན་མ་འོངས་པའི་ལས་ལ་འགན་ཁུར་ཐུབ་བམ།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "རང་འབབ་ཆུའི་ཁ་ཤོར་བ་མཐོང་ན་ཁྱོད་ཀྱིས་ཆུ་སྒོ་རྒྱག་མི་ཉན་པ་ཨེ་རེད།",
    "མི་འགའ་རེས་དེ་ནི་སྤྱི་གཉེར་ཁང་གི་ལས་ཀ་རེད་ཟེར་བའི་བསམ་བློ་ནི་རྩ་བ་ནས་ནོར་བ་རེད།",
    "སྤྱིར་བཏང་མི་འགའ་རེར་ཆེས་སྡུག་པའི་གོམས་གཤིས་ཤིག་ཡོད་པ་ནི།",
    "རང་གཅིག་པུའི་མིག་མདུན་གྱི་ཁེ་ཕན་ཁོ་ན་དོན་དུ་གཉེར་བའི་མི་ཞིག་ཡིན་ན་དེ་ནི་ལས་བྱེད་བཟང་པོ་ཞིག་མ་རེད།",
    "ཀུན་ལ་ཕན་ཐོགས་པའི་མི་ཞིག་མ་རེད།",
    "ངེད་ཚང་གི་མ་རེད་འདོད་མཁན་ཚོ་ནི་རྒྱལ་ཁབ་ལ་གྱོང་གུན་བཟོ་མཁན་དང་།",
    "ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་རྒྱལ་ཁབ་ཀྱི་ཆུ་ཆུད་ཟོས་སུ་གཏོང་བ་ཡིན།",
    "ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་རྒྱལ་ཁབ་ཀྱི་ཐོན་ཁུངས་ཆུད་ཟོས་སུ་གཏོང་དཔྱོད་མིག་བ་ཡིན།",
    "ཁྱོད་ཀྱིས་རྩིས་ཤིག་རྒྱོབས་དང་།",
    "རྒྱལ་ཁབ་ཀྱི་ཐོན་ཁུངས་གྲོན་ཆུང་བྱས་པ་རེད།",
    "འབད་བརྩོན་ཅན་གྱི་རྒྱལ་གཅེས་པས་རྒྱལ་ཁབ་ཀྱི་ཆེད་དུ་རྒྱུ་ནོར་གསར་བསྐྲུན་བྱེད་ཅིང་མཛད་སྤྱོད་རྒྱལ་གཅེས་པས་ནི་རྒྱལ་ཁབ་ཀྱི་རྒྱུ་ནོར་ལ་གྲོན་ཆུང་བྱེད་པ་རེད།",
    "ཁྱོད་ཀྱིས་ད་དུང་རྒྱལ་ཁབ་ཀྱི་རྒྱུ་ནོར་ཆུད་ཟོས་སུ་བཏང་བ་ཡིན་ན་ཁྱོད་ལ་རྒྱུ་འབྲས་ཤིག་ཡོད་དམ།",
    "ང་ཚོས་རང་ཉིད་ཀྱི་ཉེ་འཁོར་ནས་འགོ་བརྩམས་ཏེ་བྱ་བ་སྒྲུབ་ན་ད་གཟོད་ང་ཚོའི་རྒྱལ་ཁབ་ལ་རེ་བ་ཡོད་པ་རེད།",
    "འདི་ནི་གནམ་འོག་གི་དར་རྒུད་ང་སོ་ལྔ།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "ཕྱོགས་གཞན་ནས་ང་ཚོས་བཟང་ཆ་ཆུང་ཆུང་རེད་སྙམ་ནས་སྣང་མེད་དུ་མི་འཇོག་པ་དང་།",
    "སྐྱོན་ཆ་ཆུང་ཆུང་རེད་སྙམ་ནས་སྣང་ཆུང་དུ་མི་འཇོག་པའི་ལས་གཅེས་ཀྱི་ལྟ་ཚུལ་འདི་ཡིད་ལ་དམ་པོར་འཛིན་དགོས།",
    "གནམ་འོག་འདི་ན་ཆེད་དུ་དམིགས་པའི་དོན་དག་ཆེན་པོ་ཡོད་པ་མ་རེད།",
    "དོན་ཆུང་གིས་དོན་ཆེན་བརླགས་འགྲོ་བ་དང་།",
    "དོན་ཆུང་གིས་དོན་ཆེན་འགྲུབ་པར་བྱེད་པ་རེད།",
    "གནམ་འོག་ན་དོན་ཆེན་ཞིག་ཡོད་པ་མ་རེད།",
    "འདི་ནི་རྒྱལ་གཅེས་ཀྱི་བྱ་བ་ཞིག་རེད།",
    "འོག་ཏུ་བདག་གིས་ཚང་མར་ཤོག་བུ་དང་འབྲེལ་བའི་གཏམ་རྒྱུད་གཉིས་བཤད།",
    "དང་པོ་ནི་ཨ་མེ་རི་ཀར་ཧྥ་ཐི་བཟོ་གྲྭ་ཟེར་བ་ཞིག་ཡོད།",
    "རྡོ་ཐི་ཟེར་བ་ནི་མི་ཞིག་གི་མིང་རེད།",
    "སྔོན་གྱི་མི་སྐོར་ཞིག་ལ་ངོ་རྒྱུགས་བླངས་ཚར་རྗེས་ཁོའི་སེམས་སུ་བདག་ལ་ད་ནི་རེ་བ་མི་འདུག་སྙམ།",
    "ཧ་ཅང་བཟང་གི་ཧ་ཅང་བཟང་གི་སྐུ་ཞབས་ཧྥ་ཐི་ལགས།",
    "བདག་གིས་བསམ་ན་སྔོན་གྱི་མི་དེ་ཚོ་ང་ལས་ཧ་ཅང་བཟང་པོ་འདུག་ཁྱོད་ཀྱིས་ང་ཅིའི་ཕྱིར་ལས་མིར་བླངས་པ་ཡིན་ཞེས་དྲིས།",
    "ཡིན་ཡང་ཁོ་ཚོའི་མིག་གིས་བྱ་དངོས་ཆེན་པོ་མ་གཏོགས་ཆུང་ཆུང་མཐོང་གི་མི་འདུག་ཁྱོད་ཀྱིས་མིག་གིས་བྱ་དངོས་ཆུང་ཆུང་མཐོང་གི་འདུག་བདག་གིས་བསམ་ན་དོན་ཆུང་ཆུང་མཐོང་བའི་མིས་པས་བབབབབབབབབབབབ་སོ་ལྔ།",
    "སྐབས་དེར་བཟོ་གྲྭ་འདི་དེ་འདྲ་མིང་གྲགས་ཆེ་བ་ཞིག་མ་རེད།",
    "འདི་ནི་དེ་རིང་གི་ཨ་རིའི་རྡོ་ཐི་བཟོ་གྲྭའི་གསར་བཏོད་པ་ཧྥ་ཐིར་གྱི་གཏམ་རྒྱུད་རེད།",
    "ཤོག་ཧྲུལ་འདི་གལ་ཆེན་ཨེ་རེད།",
    "འཛམ་གླིང་གི་གསར་ཤོག་ཆེན་མོ་གང་སར་ཧ་ལས་པའི་ངང་གུས་པར་འོས་པའི་འཇར་པན་པ་ཞེས་བཀོད་ཡོད་ཅིང་།",
    "ཚོགས་རྭ་ཆེན་མོ་དེ་འདྲ་ཞིག་ལ་ཤོག་ཧྲུལ་གཅིག་ཀྱང་མེད་པ་ནི་འཛམ་གླིང་མི་དམངས་ཧང་སང་དཔྱོད་མིག་དགོས་པ་ཞིག་རེད།",
    "ད་ལྟ་ང་ཚོས་ཕྱིར་འཁོར་ནས་པེ་ཅིན་ཐང་ཆེན་གྱི་རྒྱལ་དར་བསྒྲེང་བའི་མཛད་སྒོར་ལྟོས་དང་།",
    "མི་ཚོགས་གྲོལ་ཚར་ཤུལ་གང་སར་ཤོག་ཧྲུལ་ཕྱི་རྒྱལ་གྱི་མི་ཞིག་གིས་མཐོང་ན་ཁྱོད་ཚོ་ཀྲུང་གོ་བ་ནི་འཇར་གྱིས་ཁེངས་འདུག་པན་པ་དང་བསྡུར་ན་ད་དུང་ཧ་ཅང་གིས་རྗེས་ལུས་སུ་གྱུར་འདུག་ཟེར་ངེས།",
    "ཚང་མས་ང་ཚོའི་རྒྱལ་ཁབ་ཀྱི་ས་རྒྱ་ཆེ་ཞིང་གཏེར་ཁ་མོད།",
    "ཤོག་ཧྲུལ་འདི་གལ་ཆེན་པོ་ཨེ་རེད།",
    "དོན་ཆེན་གང་ཡིན་ཐམས་ཅད་ཐོག་མར་དོན་ཆུང་ཆུང་ནས་འགོ་བརྩམས་ཏེ་སྒྲུབ་དགོས་པ་རེད།",
    "ཨ་རིའི་མཁའ་དབྱིངས་འཁོར་སྐར་གསུམ་པ་རྟགས་ཅན་ཅུང་མི་འགོར་བར་ཟླ་བའི་སྟེང་སླེབས་ལ་ཉེ་བ་རེད།",
    "ཁོ་ཚོ་འུ་ཐུག་པའི་ངང་སའི་གོ་ལའི་སྟེང་ཕྱིར་ལོག་པ་རེད།",
    "ཨ་སྒོར་དུང་ཕྱུར་ཁྲི་ཕྲག་མང་པོ་ཆུད་ཟོས་སུ་ཤོར་སོང་།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "མ་རེད།",
    "དེ་ནི་སྣུམ་ལམ་ཆུང་ཆུང་ཞིག་བརྒྱུད་ནས་གནམ་གྲུའི་འབབ་འཁོར་གྱི་འཁོར་ལོ་སར་མ་བབ་པས་དོན་རྐྱེན་བྱུང་བ་རེད།",
    "ང་ཚོ་ཚང་མས་ཀྲུང་གོའི་ཟ་མ་ཟ་བ་དང་ཀྲུང་གོའི་སྐད་ཆ་བཤད།",
    "གལ་ཏེ་ཀྲུང་གོའི་མི་ཞིག་གིས་ཀྲུང་གོའི་ཟ་མ་ཡང་མི་ཟ་ན་ད་དུང་ཁོ་ལ་ཀྲུང་གོ་བ་ཟེར་རམ།",
    "ང་ཨ་རིར་འགྲོ་སྐབས་ལན་རེར་ཁོ་ཚོའི་ནུབ་ཟས་ཟོས་པ་ཡིན།",
    "སློབ་གྲོགས་ཚོས་བྱ་ཤ་བསྲེག་མ་ཟ་རྒྱུ་ཟེར་ན་ངས་ཆོག་གི་ཟེར་ངེས།",
    "ང་ཚོས་དབྱིན་ཡིག་སློབ་པ་ནི་ང་ཚོའི་རྒྱལ་ཁབ་ཀྱི་ངོ་ཚ་ཞིག་ཡིན་ཞིང་།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "ཚང་མ་ང་ཚོའི་སྔོན་དུ་སླེབས་ཟིན་པས་ང་ཚོས་དབྱིན་ཡིག་མི་སློབ་ཐབས་མེད་ཡིན།",
    "དགྲ་བོའི་མེ་མདའ་དང་ཚན་རིག་གིས་ང་ཚོའི་མགོ་བོ་ཡར་འགྱོག་དཀའ་བར་བྱས་ཡོད།",
    "ང་ཚོའི་ནུས་པས་ཁོ་ཚོའི་ནུས་པ་འཇོམས་པར་བྱེད།",
    "ང་ཚོས་དབྱིན་ཡིག་སློབ་པའི་དམིགས་ཡུལ་ནི་ཨ་རིར་སོང་ནས་ཟས་སྣོད་བཀྲུ་བ་དང་ཆབ་ཁང་ཕྱགས་ནས་ཕྱི་རྒྱལ་བར་ཞབས་ཞུ་བྱས་ཏེ་ང་ཚོའི་ཕ་མེས་ཡང་མེས་ཀྱི་བླ་བཙོང་པའི་ཆེད་དུ་མ་ཡིན་ནོ་ཞེས་པའི་ཚིག་འདི་བྲིས་ཡོད།",
    "འཛམ་གླིང་སྟེང་ཆེས་སྙན་པའི་སྐད་ཆ་རེད།",
    "དེ་ལྟར་བྱས་ན་ཁྱོད་རང་ནང་འཚོང་བར་གྱུར་བ་རེད།",
    "ཡིན་ཡང་དགའ་སྣང་གིས་འགན་ཁུར་གྱི་ཚབ་བྱེད་མི་ཐུབ་བོ།",
    "ཆེས་མུན་ནག་གི་དུས་སྐབས་སུ་དཀར་གསལ་གྱི་འོད་སྣང་སྦྱིན་ཐུབ་ན་དེ་ནི་རྨད་དུ་བྱུང་བའི་ཀུན་སྤྱོད་ཅིག་རེད།",
    "ཁྱོད་ཚོས་བསམ་བློ་ཞིག་ཐོངས་དང་།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "ཁོ་ཚོས་ཁྱོད་ཀྱིས་སློབ་སྦྱོང་ཡག་པོ་བྱོས།",
    "དེ་བས་ཁྱོད་ཀྱིས་ངེས་པར་དུ་སློབ་སྦྱོང་ལ་འབད་བརྩོན་བྱས་ན་ད་གཟོད་མི་ཚེ་ལ་རེ་བ་དང་མདུན་ལམ་ཡག་པོ་ཡོད་པ་དང་།",
    "ཁྱོད་ཚོས་རྒྱལ་ཁབ་ཀྱི་ཆེད་དུ་དོན་ཅི་ཞིག་སྒྲུབ་ངེས་སམ།",
    "ཁྱོད་ཀྱིས་འདང་རྒྱོབས་དང་།",
    "འདི་ལྟར་བྱས་ན་ང་ཚོའི་རྒྱལ་ཁབ་ལ་རེ་བ་ཡོད་དམ།",
    "དགོས་མཁོ་ཆེ་བ་རེད།",
    "ཁྱོད་ཀྱིས་དོན་མེད་དུ་རྒྱལ་ཁབ་ཀྱི་དངུལ་དང་ཟས་ནོར།",
    "ཁྱོད་ཀྱིས་གཞན་གྱི་ཆེད་དུ་ཅི་ཞིག་བློས་གཏོང་བྱས་མྱོང་ངམ།",
    "གཅིག་ཀྱང་བཞག་ཡོད་པ་མ་རེད།",
    "ཁྱོད་ཀྱིས་རྒྱལ་ཁབ་ལ་བྱས་རྗེས་བཞག་ཨེ་མྱོང་།",
    "རྒྱལ་ཁབ་ཀྱིས་ཁྱོད་ལ་རེ་བ་ཆེན་པོ་བཅངས་ཡོད་པ་དང་།",
    "མ་འོངས་པར་ཁྱོད་རང་འཇོན་ཐང་ཅན་གྱི་མི་སྣ་ཞིག་ཏུ་གྱུར་ནས་རྒྱལ་ཁབ་ཀྱི་ཆེད་དུ་ལས་ཀ་སྒྲུབ་པར་རེ་བ་བཟུང་ཡོད།",
    "དེ་བས་ཁྱོད་ཀྱི་ཆེད་དུ་མ་དངུལ་བཏང་བ་ཡིན་པས་ཁྱོད་ཀྱིས་རྒྱལ་ཁབ་ལ་ཞབས་འདེགས་ཞུ་འོས།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "ཁྱོད་ཚོ་ཉིན་རེར་སེམས་ཁྲལ་དང་།",
    "གར་འགྲོ་འདི་འགྲོ་མེད་ཅིང་རྟག་ཏུ་ཁྲོམ་སྲང་ཀུན་མྱུལ་ནས་བསྡད་ན་ང་ཚོའི་མི་རབས་རྗེས་མ་ཚོར་རེ་བ་ཅི་ཞིག་ཡོད་དམ།",
    "བཟོ་གྲྭ་ཆེན་མོ་ཞིག་གི་སྤྱི་གཉེར་བ་དག་གི་དབྱིན་བསྒྱུར་ལོ་ཙཱ་བ་བྱེད་འདོད་པ་ནི་ཅི་འདྲའི་ངོ་ཚ་བའི་བྱ་བ་ཞིག་དང་།",
    "ལ་རྒྱུ་དང་རང་ཚུགས་མེད་པ་ཞིག་རེད་ཨང་།",
    "ཉིན་ཞིག་ང་ཚོ་ཡུལ་སྐོར་ལྗོངས་རྒྱུ་ལ་སོང་བ་ཡིན།",
    "མདུན་ཕྱོགས་སུ་རྩྭའི་སྤྱིལ་བུ་ཞིག་རལ་ཏུ་སོང་བ་ཞིག་མཐོང་མ་ཐག་ཚང་མ་མཉམ་རུབ་ཀྱིས་སྤྱིལ་བུ་ནང་འཛུལཚང་མས་ང་ཚོ་དེ་རིང་ལས་བཟང་བ་ལ་དྲག་ཆར་གྱིས་གནོད་པ་ཐེབས་མ་བྱུང་ཞེས་དགའ་སྤྲོས་ཁེངས།",
    "ཅུང་མ་འགོར་བར་དྲག་ཆར་ཇེ་ཆེ་ནས་དཔྱོད་མིག་ཇེ་ཆེར་སོང་བ་དང་།",
    "ཁྱོད་ཚོས་ཤོད་དང་།",
    "ང་ཚོ་ལ་ཁང་བ་འདི་དགོས་མཁོ་ཆེའམ།",
    "ངས་བསམ་ན་ང་ཚོ་ལ་ཁང་བ་འདི་ཧ་ཅང་དགོས་མཁོ་ཆེ་བ་རེད།",
    "ཁང་བ་འདི་ནི་དཔེར་ན་ང་ཚོའི་རྒྱལ་ཁབ་ལྟ་བུ་རེད།",
    "ཅི་ལྟར་དབུལ་ཞིང་ཉམ་ཐག་ན་ཡང་ང་ཚོའི་ཁྱིམ་རེད།",
    "ཁྱོད་ཀྱིས་ཕྱི་གླིང་བར་ཡིད་སྨོན་བྱེད་དོན་ཅི་ཡིན་ནམ།",
    "ཡིན་ཡང་ང་ཚོས་ཀྱང་རང་གི་བདེ་སྐྱིད་བློས་བཏང་ནས་རྒྱལ་ཁབ་ལ་དགའ་བ་དང་རྒྱལ་ཁབ་ཀྱི་ཆེད་དུ་བརྩོན་ལེན་བྱེད་དགོས་པ་རེད།",
    "ད་ལྟ་མི་རེ་རེས་རྒྱལ་ཁབ་ཀྱི་ཆུ་དང་ཟ་མ་བཟའ་བ་དང་དངུལ་ལེན་རྐྱང་བྱས་ན་ང་ཚོའི་རྒྱལ་ཁབ་ཇི་ལྟར་ཡར་རྒྱས་འགྲོ་འམ།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "ང་ཚོ་ཀྲུང་གོ་ལ་ཚང་མས་ལེན་ཟེར་བ་ཞིག་ཡོད་པ་རེད།",
    "འབྱོར་ལྡན་གྱི་རྒྱལ་ཁབ་ཇི་འདྲ་ཞིག་ཡིན་ན་ཡང་ཚང་མས་བླང་ན་བླངས་ནས་དབུལ་པོ་ཆགས་ངེས་རེད།",
    "ང་རང་ས་གང་ལ་སོང་ན་ཡང་གཞུང་གིས་སྣེ་ལེན་ལ་བཀག་འགོག་བྱས་པ་ཡིན།",
    "ས་གང་ལ་སོང་ན་ཡང་རང་སྟེང་ནས་ཟ་འཐུང་འགྲོ་འདུག་བྱས་པ་ཡིན་ཞིང་།",
    "ཅི་ཞིག་ལ་རྒྱལ་གཅེས་ཟེར་བ་རེད་ཅེ་ན།",
    "ང་ཚོའི་རྒྱུ་ནོར་དང་ལོངས་སྤྱོད།",
    "ཚེ་སྲོག་དང་བཅས་པ་རྒྱལ་ཁབ་ཀྱི་ཆེད་དུ་གཏོང་བར་ཟེར་བ་རེད།",
    "ཁྱོད་ཀྱིས་ནམ་ཡང་རྒྱལ་ཁབ་ཀྱི་རྒྱུ་ནོར་ཁྱིམ་ནང་འཁུར་ན་འདི་ལ་རྒྱལ་གཅེས་ཟེར་རམ།",
    "མི་འགའ་རེས་རྒྱལ་ཁབ་ཀྱི་རྒྱུ་ནོར་རྐུ་ཞིང་རྒྱལ་ཁབ་ཀྱི་རྒྱུ་ནོར་འཁྱེར།",
    "མི་འགའ་རེས།",
    "ཁྱོད་ཁྲིད་སྟེགས་སྟེང་བུད་མ་ཐག་གཤམ་ན་ཡོད་པ་ནི་ཁྱོད་ཀྱི་རྒྱལ་ཁབ་རེད།",
    "ཁྱོད་ཚོར་དགའ་བ་ནི་ངའི་རྒྱལ་གཅེས་ཀྱི་བསམ་བློ་ཡིན།",
    "ཁྱོད་ཀྱིས་ཁོ་ཚོའི་དུས་ཚོད་ཆུད་ཟོས་མི་བྱེད་པ་དང་།",
    "འདི་ལྟ་བུའི་རྒྱལ་གཅེས་ཀྱི་བསམ་བློ་སྤེལ་བ་དང་རྒྱལ་གཅེས་པ་སྐྱེད་བསྲིང་བྱས་ན་ཁྱོད་རང་རྒྱལ་གཅེས་པ་ཞིག་རེད།",
    "གལ་ཏེ་ཁྱོད་ལ་རྒྱལ་གཅེས་ཀྱི་བསམ་བློ་མེད་ན་ཁྱོད་ནི་རྒྱལ་འཚོང་བ་ཞིག་གོ།",
    "མ་འོངས་པར་ཁྱོད་རང་ཕྱི་གླིང་དུ་སློབ་སྦྱོང་ལ་འགྲོ་བའི་གོ་སྐབས་རག་པའི་སྐབས་སུ་གཟབ་གཟབ་བྱེད་དགོས་རྒྱུ་ཞིག་ལ་ཕྱི་རྒྱལ་དུ་སོང་རྗེས་ཕྱིར་མ་ལོག་པར་མ་འདུགདེས་ང་ཚོ་ཀྲུང་གོ་བའི་མིག་རྫོབ་ངེས་རེད།",
    "ཕྱི་གླིང་བས་ཁྱོད་ལ་ལྟ་སྟངས་ངན་པ་འཛིན་ཞིང་མིག་ནང་དུ་མི་འཇོག་པ་རེད།",
    "ཐེ་ཝན་གྱི་སློབ་གཙོ་ཞིག་གི་གཏམ་བཤད།",
    "དམས་སུ་འགྲོ་བཞིན་པའི་བྲན་གཡོག་རྒྱལ་ཁབ་ཀྱི་མི་ཞེས་དམའ་འབེབས་བྱེད་ངེས་རེད།",
    "དེ་བས་གཞན་མིས་ཁྱོད་ལ་ལྟ་སྟངས་ཡག་པོ་ཞིག་ཅི་ལ་འཛིན།",
    "འདི་ནི་ངོ་ཚ་དགོས་པ་ཞིག་དང་ཡིད་སྐྱོ་བའི་དོན་ཞིག་རེདདེས་ན་རྒྱལ་ཁབ་ནི་ང་ཚོར་མཚོན་ན་ཧ་ཅང་གལ་ཆེ་བ་ཞིག་ཡིན་པ་དང་།",
    "ཁྱོད་རང་རྒྱལ་ཁབ་ཕྱི་ལ་མ་སླེབས་བར་རང་གི་མེས་རྒྱལ་ནི་རང་ལ་དེ་འདྲའི་གལ་ཆེན་ཡིན་པའི་རང་བཞིན་རྟོགས་མི་ནུས།",
    "དེ་བས་ང་ཚོ་དེ་རིང་གི་ཀྲུང་གོ་བས་རང་སྟོབས་རང་སྤེལ་བྱས་ཏེ་ང་ཚོའི་རྒྱལ་ཁབ་ལ་དགའ་ཞེན་དང་ནུས་པ་ཕུལ་ནས་རྒྱལ་ཁབ་དར་རྒྱས་ཡོང་བར་བྱེད་དགོས།",
    "ཁྱོད་ལ་ནམ་ཡང་གཞན་གྱི་བརྩི་བཀུར་ཐོབ་མི་སྲིད་དོ།",
    "ང་ཚོའི་བྱ་སྤྱོད་གང་ཡང་རུང་བ་ཞིག་གིས་རྒྱལ་གཅེས་ཀྱི་བསམ་བློ་མཚོན་ཐུབ།",
    "ཚང་མས་ཨ་ལ་པོ་དང་ཨི་ཟི་རེལ་ཙ་རྒྱལ་ཁབ་གཉིས་ཀྱི་དམག་འཁྲུག་གི་གནས་ཚུལ་ཤེས་གསལ་རེད།",
    "ཨ་ལ་པོ་དང་ཨི་ཟི་རེལ་རྒྱལ་ཁབ་གཉིས་ཀྱིས་དམག་འཁྲུག་གི་མེ་ལྕེ་འབར་སྐབས་འཛམ་གླིང་གིས་བུད་མེད་མཛེས་མའི་འགྲན་བསྡུར་སྤེལ་བཞིན་པ་རེད།"
  ]
}