    "ངའི་གྲོགས་པོ་ཞིག་གི་གཉེན་སྟོན་ལ་ང་ཡང་མགྲོན་འབོད་བྱས་འདུག་པས་སྟོན་མོའི་ཉིན་གང་ནས་ནམ་གུང་བར་བསྡད།",
    "འདི་བཞིན་དེང་སྐབས་ཀྱང་བོད་ཡུལ་སྟོད་སྨད་བར་གསུམ་ན་རྟགས་སྟོན་མོ།",
    "ཁྱིམ་གཞི་གསར་འཛུགས་དང་ཚོང་ཁང་སྒོ་འབྱེད་ལ་སོགས་པར་ཤོག་སྦག་རྒྱག་པ་ནི་སྤྱིར་བཏང་གི་གནས་ཚུལ་ལྟ་བུར་གྱུར་ཡོད།",
    "མཚན་མོར་ཤོག་སྦག་འགད་སྟོན་ལ་བལྟ་བར་ཕྱིན་པ་ཡིན།",
    "མཚན་མོ་དེར་ཤོག་སྦག་སྣ་ཚོགས་འགད་སྟོན་གྱིས་གནམ་ས་གཡོ་བ་ལྟ་བུའི་ཚོར་སྣང་སྟེར་ལ་ཉེར་གཉིས།",
    "མི་ཞིག་གི་སེམས་ཁམས་མ་སྐྱིད་པར་ཡོད་པའི་སྐབས་སུ་རང་གི་འདུ་ཤེས་གང་འདྲ་ཞིག་ཁུར་ནས་རང་གི་སེམས་ངལ་སེལ་དགོས་ལགས།",
    "སེམས་མ་སྐྱིད་པ་ཞིག་བྱུང་བ་ནི་ཏན་ཏན་རྒྱུ་རྐྱེན་ཞིག་ལ་བསྟེན་ནས་བྱུང་ཡོད་པ་རེད།",
    "དེས་ན་མ་སྐྱིད་པ་ཡོང་རྒྱུའི་རྩ་བ་དེ་ལ་བསམ་བློ་ཤུགས་ཆེན་པོ་རེ་བཏང་ནས་སེལ་ཐབས་ཤིག་ཡོད་མེད་ལ་བལྟ་བ་དང་།",
    "ལྷག་པར་རང་གི་བྱ་བ་གཞན་ལ་ཤུགས་རྐྱེན་ཐེབས་ནས་ལེགས་འགྲུབ་ཡོང་བར་གེགས་བྱེད།",
    "རང་ཅག་སོ་སྐྱེ་ཐ་མལ་བ་ནང་གི་བློ་སྦྱོང་དཔྱོད་མིག་ཁམས་པ།",
    "ཡག་པོ་མེད་པས་ལན་རེར་རང་གཞན་གཉིས་ཀྱི་དོན་ཕྲན་ཚེགས་རེས་ཀྱང་འཚིག་པ་ཟ་བ་དང་།",
    "བྱུང་ཚེ་རང་ཉིད་མ་དགའ་བ་དང་མ་སྐྱིད་པ་སོགས་ཡོང་དོགས་ཡོད་པས་འདི་ནི་ཕྲག་དོག་ཞེས་པའི་མ་རུངས་པའི་བསམ་པ་ཅན་གྱི་མངོན་རྟགས་ཤིག་ཡིན་པས་རང་བློ་རང་གིས་གཅུན་ཐབས་བྱེད་དགོས།",
    "གོ་ནོར་ཐེབས་པ་དང་མི་སྙན་པ་སོགས་བྱུང་ཚེ་དེ་མ་ཐག་ཐག་གཅོད་ཀྱི་བསམ་པ་དང་ཧ་རེ་ཧུར་རེ་མེད་པར་བསམ་རྒྱ་ཆེ་རུ་གཏོང་བ་དང་།",
    "ཆགས་སྡང་དང་ཕྲག་དོག་སོགས་ཀྱི་སེམས་ངན་བྱུང་རེས་ལ་ངོས་ཟིན་པ་འདི་གལ་ཆེ་བ་དང་།",
    "ལན་རེར་རང་ཅག་ལ་ངོས་འཛིན་གསལ་པོ་མེད་པར་ཚོད་ཚོད་ལ་མ་སྐྱིད་པ་རེ་ཡང་ཡོང་རྒྱུ་ཡོད་པས།",
    "དེ་ཡང་རང་རེ་གཏི་མུག་སོགས་དུག་གསུམ་གྱི་སྒྲིབ་ཉེར་གསུམ།",
    "ཡང་ན་གཉིད་ཕྲན་བུ་རེ་བསྟེན་ན་ཏག་ཏག་ཕན་ཚོད་ཅིག་འདུག་སྙམ་པ་འདུག་འདི་ནི་རང་གི་ནམ་རྒྱུན་གྱི་ཐབས་བསྟེན་ཚུལ་ལྟ་བུ་ཡིན་ཞིང་།",
    "གཞན་དག་སྡོམ་པ་ལ་གནས་པའི་གང་ཟག་དག་ལ་འཁོར་ལོ་གསུམ་གྱི་བས་དུས་འདའ་བ་ཟེར་བས་དེ་བཞིན་འབད་བརྩོན་བསྟེན་དགོས་པ་རེད།",
    "དེ་མིན་བོད་ཡུལ་གང་སར་མི་རྐྱང་ཕོ་མོས་ཁྱབ་སྟེ་ནམ་ཞིག་མི་རིགས་གཞན་སུ་དང་གང་ལ་ཡང་མཐུན་འཇུག་བྱེད་པ་དེང་སང་ཡང་གང་མང་མཐོང་ཞིང་ཐོས་ན་མ་དཔྱོད་མིག་འོངས་པར་དེ་ལས་སྡུག་ཏུ་འགྲོ་བར་ཚེགས་མེད།",
    "ང་ཚོས་ཤེས་གསལ་ལྟར་འགྲོ་བ་མིའི་ཚེ་སྲོག་འདི་འཛམ་གླིང་འདིར་ཡུན་རིང་དུ་འཚོ་བ་ལ་ཕྱིའི་རྐྱེན་དང་ནང་གི་རྐྱེན་དུ་མས་ཡང་ཡང་གཙེས་ནས་བདེ་ཐང་ངང་མི་ཚེ་ཧྲིལ་པོ་འདའ་བ་ཕལ་ཆེར་མེད་པའི་ཚད་ཡིན།",
    "དེང་སྐབས་བོད་ཡུལ་གྱི་ས་ཆ་མང་པོར་ཡང་ཨེ་ཙིའི་རེག་དུག་བྱུང་བ་ནི་སྨད་ཚོང་བསྟེན་པ་ལས་བྱུང་བ་མངོན་གསལ་དང་།",
    "ད་རེས་འདིར་ཚིག་འགའ་མི་སྨྲ་ཐབས་མེད་བྱུང་ནས་བྲིས་པ་ཡིན།",
    "པའི་བུ་ལ་བརྡ་ཟེར་བ་ལྟར་གོ་བ་ཅན་གྱིས་རིམ་པས་བསམ་གཞིགས་བཏང་ནས་ཤེས་ཡོང་གི་རེད།",
    "གཙོ་བོ་རང་གིས་བརྩིས་ན་འགྲིག་བསྡད་ཡོད་ནི་རེད།",
    "རེད་དང་རེད།",
    "ངན་པ་གཉའ་རེངས་ཟེར་བ་ཡོང་གི་རེད།",
    "བཙན་འཛུལ་ཟེར་བ་འདིས་འདྲ་མིན་བཟོ་དང་བཟོ་བཞིན་པ་ཡིན་པས་ཁ་རོག་གེར་བསྡད་ན་ཁྱེད་ལ་ལེབ་ལེབ་གོར་གོར་བཟང་བཟང་ཞིག་སྟེར་ནི་མ་རེད།",
    "སྨྱུ་གུ་འཛིན་ཤེས་ཙམ་ནས་ཆེ་ཆུང་ཁྱད་མེད་ལ་ངན་སྨྲས་དང་མཚང་འདྲུ་རེས་བྱེད་པ་ནི་ལུགས་སྲོལ་ཉམས་བྱེད་རེད།",
    "བོད་ཀྱི་རྩོམ་པ་པོ་རྣམས་ཀྱིས་གཅིག་གིས་གཅིག་ལ་ཕྲག་དོག་དང་སྨད་རེས་གཏོང་བ་འདི་ཤིན་ཏུ་ཐབས་རྡུགས།",
    "ཚང་མས་སྤྱིའི་དོན་དང་ཕན་ཆེ་ས་ལ་མི་བལྟ་བར་ཚིག་གི་མདུང་ཐུང་གང་དུ་འཕྱར་བ་སམ་ནི་ཧ་ཅང་ཡིད་ཕམ།",
    "རྩོམ་པ་བཟང་པོའི་ཡོན་ཏན་ནི་ཉོན་མོངས་ཕྲག་དོག་སོགས་ཀྱི་ཁ་སྣོན་མ་ཡིན་པར་ཐུན་མོང་ཡར་སྐུལ་གྱི་ལས་རླབས་པོ་ཆེ་དེ་རེད།",
    "སྔོན་གྱི་ཆེན་པོ་དག་གིས་ཀྱང་དེ་བཞིན་ལུང་དུ་བསྟན་པ་མ་ཟད།",
    "ཐ་ན་ས་དགེ་ཀར་རྙིང་རིས་མེད་ཀྱིས་དམ་པ་མཆོག་གི་བླང་དོར་སྟོན་པའི་གསུང་རྩོམ་དག་མིག་གི་རྒྱན་དུ་བཟུང་ནས་བལྟ་ཞིང་ཀློག་ཡིན་ན་འང་།",
    "མ་ཟད་མདའ་སྨྱུག་གིས་བོད་ན་གང་ཆེ་ཆེ་དང་།",
    "གཡས་མས་གསང་གཞིར་མདའ་སྨྱུག་མཆོག་རྣམ་དཔྱོད་ཀྱི་རྩལ་དང་ལྡན་ཞིང་གཞུང་ལུགས་ལ་རྟོག་དཔྱོད་ཀྱི་མིག་དང་ལྡན་པ་ཞིག་ཡིན་པར་ཁོང་གི་གསུང་རྩོམ་གཞན་དག་ལ་བལྟས་པས་ཤེས།",
    "སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་ནི་ཉེས་ཅན་ཞིག་རེད་སོགས་དུས་ཡུན་ལོ་མང་པོ་ཞིག་ལ་དེ་ལྟའི་རྩོམ་པ་ཞིག་གི་ཆུ་ལྷོག་ལྷོག་ཏུ་འཁོལ་མྱོང་།",
    "ཕྲག་དོག་གིས་ཚིག་མཚོན་འདེབས་པ།",
    "ཁ་བྱང་འདི་དང་འབྲེལ་བའི་སྐད་ཆ་ནི་རིང་མོ་ཞིག་ནས་གླེང་འདོད་བྱུང་།",
    "ཀུན་གཟིགས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པས་མགར་བ་རྡོ་རྗེར་ཕྱག་འཇུ་གནང་བའི་གནས་ཚུལ་དེ་ཚང་མ་ལ་ཆ་རྒྱུས་ཡོད་ངེས་རེད།",
    "རང་རེའི་བོད་ཀྱི་སྲོལ་རྒྱུན་གྱི་ལྟ་བ་ངན་པ་ཁག་ཅིག་ལ་སྙིགས་དོར་བཅུད་ལེན་བྱེད་དགོས་པའི་བཀའ་སློབ་ཟབ་མོ་གནང་ཡོད་པ་རེད།",
    "ད་དུང་གཞུང་གི་ཕོགས་ཐོབ་མ་ཡིན་པའི་རང་ཉིད་ཀྱིས་ཁེ་ལས་དང་བཟོ་གྲྭ།",
    "ཟ་ཁང་དང་ཇ་ཁང་སོགས་གཉེར་ནས་འདུག་པ་ལ་ལྟ་སྟངས་སྡུག་པོ་འཛིན་པ་དང་འཚོ་དངུལ་གྱི་ཡོང་ཁུངས་བརྟན་པོ་ཞིག་མེད་པར་འདོད་པ་རེད།",
    "མ་རེད།",
    "བེམ་མིན་རིག་དངོས་བཤམས་སྟོན་ཁང་སོགས་ནི་དུས་རབས་འདིའི་ནང་ཅུང་ཚབ་མཚོན་ལྡན་པའི་གྲུབ་འབྲས་ཅན་གྱི་ལས་ཀ་ཡིན་པ་རེད།",
    "འདི་ནི་གཞོན་ནུ་ཚོར་མཚོན་ན་འགྲན་རྩོད་ཅིག་ཡིན་པ་རེད།",
    "ང་ཚོ་བོད་རིགས་ཀྱིས་བོད་རིགས་སྐྱོང་བའི་ཉི་མ་ཞིག་སླེབས་ཀྱང་ང་ཚོས་རང་ཉིད་སྐྱོང་རྒྱུ་ཧ་ཅང་ཁག་པོ་ཡིན་ཞིང་།",
    "ཁེ་ལས་པ་སོགས་ཀྱི་ལས་རིགས་གང་ཞིག་གཉེར་བཞིན་ཡོད་ན་ཡང་ཐམས་ཅད་གཅིག་མཚུངས་ཡིན་པ་རེད།",
    "རྒྱུས་ཅན་གྱི་མིའི་ནུས་པ་ལ་བརྟེན་དགོས་པ་ལས་མི་གཅིག་གིས་འགྲུབ་ཡོང་བ་དང་འཕེལ་རྒྱས་གཏོང་ཐུབ་པ་ཞིག་མིན་ནོ།",
    "འུ་ཐུག་ན་བྱ་མེད་བོང་བུས་ནམ་ཚོད་འཛིན་པ་ལྟར་ཡིན་པས་ང་ཚོས་རང་རང་གི་ནུས་པ་དང་བསྟུན་ཞིང་།",
    "མི་ཞིག་གི་ཀུན་སྤྱོད་དང་མི་གཞི།",
    "སྔོན་ང་ཚོས་རྐུབ་སྟེགས་འཛིན་དགོས་སར་མ་བཟུང་བས་གྱོང་ཆེན་པོ་ཁུར་ཡོད་པ་རེད།",
    "ལས་རིགས་གང་ཞིག་དོན་དུ་གཉེར་ན་ཡང་རྩ་བ་རང་རེའི་མི་རིགས་དང་སྤུན་ཟླ།",
    "ན་ལས་རིགས་གང་ཞིག་གཉེར་ན་ཡང་སོ་སོས་རང་གི་ལས་རིགས་དེར་འགན་ཁུར་གྱི་འདུ་ཤེས་དྲག་པོ་ཞིག་དགོས་པ་དང་རྣམ་འགྱུར་དྲང་པོ་ཞིག་ཅན་བཟུང་ནས་ལས་ཀ་བྱེད་རྒྱུ་ནི་དེ་བས་ཀྱང་གལ་ཆེན་པོར་མཐོང་ཞིང་།",
    "འདི་ལྟར་བྱས་ན་ད་གཟོད་ང་ཚོའི་མི་རིགས་འདི་གྲ་བཞི་གྲུ་བཞི་མ་ཉམས་པར་ཡར་རྒྱས་ཀྱི་ལམ་ཁར་བསྐྱོད་ངེས་པ་དང་གང་ལ་ཡང་སྟོབས་དང་ནུས་པ་ཡོད་མཁན་ཞིག་ས།་",
    "སྒྲ་བསྒྱུར་ཆེན་མོ་མར་བ་ལོ་ཙཱ།",
    "ལོ་ས་ས་ཙཱ་བ་ཆེན་མོ་རིན་ཆེན་བཟང་པོ་ལ་སོགས་པར་བོད་གཞུང་དམངས་གཉིས་ཀྱིས་དངུལ་རྩ་འབོར་ཆེན་བཏང་ནས་གདན་འདྲེན་དང་སྐྱེད་བསྲིང་།",
    "བོད་རིགས་སློབ་ཕྲུག་སྟོང་ཕྲག་མང་པོར་སློབ་སྦྱོང་གི་མཐུན་རྐྱེན་སྦྱར་ཞིང་།",
    "འདི་ཡང་ང་ཚོ་བོད་རིགས་མི་དམངས་ཚོས་ནམ་ཡང་བརྗེད་མི་ཉན་པའི་མི་མཆོག་ཞིག་ཡིན།",
    "དེས་ན་བོད་རིགས་ཀྱི་འཕེལ་རྒྱས་ནི་ནམ་ཡང་གཞན་ལ་བསྟེན་ནས་འགྲོ་དགོས་པ་ཞིག་མ་ཡིན་པར་རང་གིས་གཙོ་ཤུགས་ནུས་པ་འདོན་དགོས་པ་དང་།",
    "དེ་ནི་རྩ་བ་ནས་ནོར་བ་རེད།",
    "ལོ་ངོ་སྟོང་ཕྲག་གཅིག་གི་རྗེས་སུ་ཡེའུ་ཐེ་བ་སྔར་བཞིན་རང་བཙན་བྱས་ཤིང་།",
    "མི་རིགས་སྤྱི་ལ་ཕན་ཐོགས་པའི་རླབས་ཆེན་གྱི་མཛད་པ་ཞིག་རེད།",
    "སྐབས་རེར་སློབ་ཚན་གྱི་ནང་དོན་ཁྲིད་མི་ཐུབ་པ་དང་།",
    "མི་འགའ་རེ་ནི་རྫས་འགྱུར་སློབ་པར་དགའ་བ་དང་།",
    "བསམ་གཞིགས་ཀྱི་སྒོ་མོ་གསར་བ་འབྱེད་པའི་རེ་བ་གཅོད་དོ།",
    "གྲོས་སྔོག་འདོན་བྱེད་མི་རུང་བ་དེ་རེད།",
    "དེའི་དམིགས་ཡུལ་ནི་ཆེས་སྔ་མོ་ནས་ཚད་ལས་བརྒལ་བར་བྱིས་པའི་བློ་གྲོས་སྔོག་འདོན་བྱེད་མི་རུང་།",
    "༣ སློབ་ཚན་ལས་གཞན་པའི་ཤེས་བྱ་འགའ་སློབ་པའི་རེ་བ་བཏོན་པ་ཡིན།",
    "བྱིས་པའི་བློ་གྲོས་ཆེས་སྔ་བར་ཚད་ལས་བརྒལ་ཏེ་སྔོག་འདོན་བྱེད་པ་ནི་དོན་དག་བཟང་པོ་ཞིག་མ་རེད།",
    "རྡུང་རེས་དང་འཁོན་འཛིང་མི་བྱེད་པ།",
    "ཁོ་བོས་འཇར་མན་རྒྱལ་ཁབ་གཅིག་པུར་འདི་ལྟའི་ཁྱད་མཚར་གྱི་སྒྲིག་སྲོལ་ཞིག་ཡོད་པར་འདོད་མོད།",
    "དོན་དངོས་སུ་དེ་ནི་དགོས་མེད་ཀྱི་སེམས་ཁྲལ་ལྷག་མ་ཅིག་རེད།",
    "ཨོ་གླིང་གི་མི་ཚང་མས་ཡོངས་ཁྱབ་ཀྱི་འདོད་ཚུལ་ཞིག་ནི།",
    "བྱིས་པས་རང་ཉིད་ཀྱི་འཚར་ལོངས་གོ་རིམ་དང་མཐུན་པའི་བྱ་བ་སྒྲུབ་ན་ཆོག་པར་འདོད་པ་རེད།",
    "འཛམ་གླིང་གི་ནོ་པེར་བྱ་དགའི་རྣམ་གྲངས་སྟེར་འགོ་ཚུགས་པ་ནས་བཟུང་འཇར་མན་གྱིས་ནོ་པེར་བྱ་དགའི་ལོན་ཚད་འཛམ་གླིང་གི་སྤྱིའི་ཕྱེད་ཀ་ཟིན།",
    "མི་གྲངས་ཁྲི་སྟོང་ཕྲགར་༢ལྷག་ལས་མེད་པའི་འཇར་མན་པས་འཛམ་གླིང་གི་ནོ་པེར་བྱ་དགའི་ཕྱེད་ཀ་འཁྱེར་སོང་བ་དང་།",
    "སའི་གོ་ལའི་སྟེང་གི་མི་གྲངས་དུང་ཕྱུར་དྲུག་ཅུ་ལྷག་གིས་ནོ་པེར་བྱ་དགའི་ཕྱེད་ཀ་མ་གཏོགས་ལོན་མེད་པ་རེད།",
    "མ་རེད།",
    "གསོག་ཉར་སྒམ་ལྟ་བུའི་ཤེས་བྱ་སློབ་སྦྱོང་གིས་ང་ཚོའི་བྱིས་པ་ཚོའི་བསམ་གཞིགས་ཀྱི་བར་སྟོང་དང་གསར་གཏོད་ཀྱི་སྒོ་མོ་ཁེགས་ཤིང་།",
    "མ་འོངས་པའི་རེ་བ་བརླག་པར་འགྱུར་བ་ཡང་ཤེས་དགོས་སོ།",
    "ཚད་རིམ་དམའ་མོའི་དུ་བ་འཐེན་མི་ཚར་བ་ཞིག་དང་ལས་མི་ཚར་བའི་ནུས་ཤུགས་ངལ་རྩོལ་འབའ་ཞིག་གོ།",
    "རིན་གོང་དམའ་མོའི་གོས་གྱོན་མི་ཚར་བ་ཞིག་དང་སྔོ་ཚོད་ཁང་དུ་མྱུལ་མི་ཚར་བར་འགྲོ་བའོ།",
    "སྒོར་མོ་ནི་མི་སུ་ལ་ཡང་འདང་ངེས་ཤིག་མེད།",
    "༣ གྲོགས་པོས་ཁྱོད་ལ་རོགས་རམ་བྱས་པ་ནི་དགེ་ལས་དང་ལ་རྒྱ་རེད།",
    "གྲོགས་པོས་ཁྱོད་ལ་རོགས་རམ་མ་བྱས་ཀྱང་དེ་ལ་ངན་སེམས་བཟུང་སྟེ་སེམས་འཁྲུག་མི་རུང་ངོ།",
    "དཔྱོད་མིགཁྱོད་ཀྱིས་ཤེས་དགོས་པ་ཞིག་ལ་མི་སུས་ཀྱང་ཁྱོད་ལ་ཆེས་དགོས་མཁོ་ཆེ་༤ དུས་ངེས་པར་རོགས་བྱེད་ཐུབ་པའི་ངེས་པ་མེད།",
    "མཐར་ཐུག་སོགས་ལ་བརྩོན་ལེན་བྱེད་པ་ནི་ཁྱོད་ཀྱིས་བསྒྲུབ་དགོས་པ་ཡིན་ཞིང་ཁྱོད་རང་ཉིད་ཁྱོད་དང་མཉམ་ཤི་མཉམ་གསོན་བྱེད་མཁན་དེ་ཡིན་ནོ།",
    "གཞན་ལ་སྒོར་མོ་དུང་ཕྱུར་ཁྲི་ཕྲག་ཡོད་ཀྱང་ཁྱོད་ལ་སྐར་གང་གི་འབྲེལ་བ་ཡང་མེད་པས་རང་གཞན་ཡང་མི་ལ་རྒྱུ་ནོར་གཅིག་ཀྱང་ཉིད་གཞན་གྱི་རྒྱུགས་ཁྱི་ལྟ་བུ་མ་བྱེད་ཅིག་མེད་ན་ཡང་ཟ་བཞིན་པའི་མོག་མོག་དེ་བགོས་ནས་ཕྱེད་ཀ་ཁྱེད་ལ་སྟེར་སྲིད།",
    "རྒྱུ་ནོར་ཕྱུག་པོའི་གྲོགས་པོས་ཁྱོད་ལ་དཔལ།",
    "ཡིན་ཡང་བསམ་བློ་ཕུན་སུམ་ཚོགས་པའི་གྲོགས་པོས་ཁྱོད་རང་མུ་མེད་ཤེས་བྱའི་བྱང་ཐང་དང་ནང་སེམས་ཀྱི་མཛེས་སྡུག་སྟེར་སྲིད་ཅིང་།",
