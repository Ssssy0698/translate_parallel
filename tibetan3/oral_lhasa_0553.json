    "རྡོ་རྗེ་འདུས་པ་ཞེས་པར་འགྱུར་ལ།",
    "དེ་ལྟར་ན་འཛའ་ཞེས་མི་བརྗོད་པར།",
    "འདི་གཉིས་གང་རུང་བརྗོད་ཀྱང་རུང་གསུངས།",
    "དེ་ལྟར་བྱས་པས་ཞན་པས་ཞུགས་ན་འབྲེལ་བས་མི་བསླུ་བའི་ལམ་ཞེས་བྱ་བ་དེ་དག་ལ་རྒྱུ་འབྲས་ཀྱི་འབྲེས་པ་གྲུབ་པའི་ཕྱིར།",
    "བྱེད་ན་ཏིང་ཤགས་བརྡུང་བའི་ཚུལ་རྣམས་སོ་སོར་སྔགས་དང་བཅས་པས་མཆོད།",
    "བདུན་ཡིན་པས་དོན་དྲན་བཞིན་པར་ལན་གསུམ་བརྗོད་པར་བྱེད།",
    "རྒྱུད་ཀྱི་རྣམས་ལོངས་སྐུའི་དྲུང་དུ་བྱེད་པའི་ཕྱིར་དེ་གཉིས་མ་གསུངས་སོ་ཞེས་གསུངས་པ་འདྲ་འདྲ་ཞིག་ཡོད་ནའང་།",
    "རིགས་པ་ལྟར་སྣང་དུ་ཟད་དོ་གསུངས།",
    "རང་བཞིན་གྱིས་མི་དམིགས་པ་གསུམ་གང་བྱས་ཀྱང་འགལ་བ་མེད་དོ་གསུངས།",
    "འོད་ལྗང་གུ་གོ་རཱི་དང་བཅས་པས་བཏང་སྙོམས་ལ་བཀོད་པར་བསམ་སྟེ།",
    "སྭ་བྷ་ཝ་ཤུདྡྷོ་ནི་སྔར་བཞིན་ཨ་ཧོ་ནི་ངའོ་ཞེས་ང་རྒྱལ་གཟུང་བ་སྟེ་གཟུང་བའི་ཡུལ་ཐམས་ཅད་སྟོང་པར་བསམ་བཅུ་གསུམ་པ་དེ་ཀའི་ངང་དུ་རིག་པ་བརྗོད་མེད་དུ་བཞག་པ་ལ་ང་རྒྱལ་གཟུང་བ་ཞེས་ཐ་སྙད་བྱས་པ་ཡིན་གསུངས།",
    "ད་ལྟར་གྱི་སྣང་བ་འདི་དག་ཐམས་ཅད་ལས་ཉོན་ལས་གྲུབ་ཟིན་པའི་ཕྱིར་སྟོང་པར་སྦྱོང་ཡང་མི་ནུས་པས་ན།",
    "དེའི་རང་བཞིན་སྟོང་པར་གནས་པའི་མེད་དགག་ཙམ་ལ་བློ་འཇོག་པ་ཡིན་གྱི་སྣང་བ་འདི་དག་དགག་ཏུ་མི་རུང་ངོ།",
    "དབྱིབས་གསུམ་སྐྱོག་ཏུ་བྱེད་པ་ནི་ལུས་རྟེན་དེ་གཟུགས་འགྱུར་བ་མི་ཐུབ་པར་མཚོན་པ་ཡིན།",
    "ལམ་བྱེད་བཞིས་ལམ་དུ་བྱས་པས་འབྲས་བུ་མངོན་དུ་བྱེད་པའོ།",
    "ལུས་འཚོལ་བའི་འདུན་པ་དྲག་པོ་དེས་རྐྱེན་བྱས་རིགས་དྲུག་ཏུ་སྐྱེ་འགྱུར་གྱི་ལས་བསགས་པ་དེས་རྒྱུ་བྱས་སྐྱེ་བ་ལེན་ལ།",
    "དེ་དག་ཀྱང་སོ་སོར་ལམ་བྱེད་བཞིས་ཉམས་སུ་དྷཱི་། ལེན་པར་བྱེད།",
    "ལམ་བྱེད་རྣམ་བཞིས་ཉམས་སུ་ལེན་པར་བྱེད་པ་གཞན་ལ་གནོད་པ་བྱས་པའི་འབྲས་བུ་རྐྱེན་དང་འཕྲད་ན་འབྱིན་ངེས་སུ་བག་ཆགས་ཀྱི་ཚུལ་དུ་གནས་པ་དེ་ཉིད་སྲུང་བའི་འཁོར་ལོའི་རྣམ་པར་བསྒྱུར་ཏེ་བསྒོམས་པས།",
    "བར་ཆད་བསྲུང་བ་སྤང་བྱ་གཉེན་པོར་ཤར་བ་ཡིན་གསུངས།",
    "ཞེས་གསུངས་པའི་པདྨའི་ལྟེ་བ་ཤིན་ཏུ་ཆེ་ཞིང་འདབ་མ་ཆུང་བའི་རྣམ་པ་ཅན།",
    "འབུམ་ལྡན་གཉིས་ལས་གྲུབ་ཆེན་ལ་ལི་ཏས་འབུམ་ལྡན་དུ་གསུངས་པས།",
    "ཁ་དོག་དྷཱི་། སྣ་ཚོགས་སུ་ཤར་བའི་མཚོན་བྱེད་ལྗང་གུར་བཞེད་པ་ཡིན་གསུངས།",
    "ཕྱིར་འཕྱར་བྱས་པར་རབ་གསལ་གྱི་བྱེ་རྩེ་ལྟར་བྱས་པའི་འདོད་སྣམ་ནོན་པ།",
    "ཆ་ཆེན་གསུམ་པ་། དང་གཉིས་པར་འདོད་པ་གཉིས་ལས།",
    "ཁ་དོག་ཅི་མཛེས་སམ་དག་པར་སྦྱར་ན།",
    "བསམ་གཏན་དག་པས་རྟ་བབས་ཉིད་ཅེས་གསུངས་པས།",
    "ལམ་བྱེད་བཞིས་ཉམས་སུ་ལེན་པར་བྱེད།",
    "དེ་ལ་ཆགས་སྡང་དྲག་པོ་སྐྱེས་པས་རྐྱེན་བྱས་ཉིང་མཚམས་སྦྱོར་བར་འགྱུར་བས།",
    "རྡོ་རྗེའི་དབྱུག་པ་གཅིག་ཉིད་ལས་ཐམས་ཅད་བསྐྱེད་པར་གསུངས་པའོ།",
    "མགུལ་ཡན་ཚང་མ་ཕག་ཏུ་བྱས་པ་སོགས་འབྱུང་ཡང་།",
    "ཅེས་གསུངས་པའི་དོན་གྱིས།",
    "ཕྱག་རྒྱ་འདུ་བྱས་ཏེ་བདེ་བ་བསྒྲུབ་པ།",
    "དང་པོ་ནི་ཡབ་ཡུམ་གྱི་མཁའ་གསང་བྱིན་གྱིས་བརླབས་ཏེ་འདུ་ཤེས་གསུམ་གྱིས་སྙོམས་པར་ཞུགས་པས།",
    "སྦྱངས་འབྲས་འདོད་ཆགས་རྣམ་པར་དག་པ་སོར་རྟོགས་ཡེ་ཤེས་གཟུགས་ཀྱི་སྐུར་བཞེངས་པའི་འོད་དཔག་མེད་ཡིན་སྙམ་དུ་བྱེད་པའོ།",
    "ལྷ་འཁོར་ལོ་པདྨ་རྡོ་རྗེ་དྲིལ་འཛིན་གྱི་རྣམ་པར་སྤྱན་དྲངས་སོ་སོ་ལ་ཐིམ་པས།",
    "ཕན་ཚུན་བསྲེ་ནས་མི་བྱ་གསུངས།",
    "ཇི་སྲིད་སངས་མ་རྒྱས་ཀྱི་བར་དུ་འབྲལ་མེད་དུ་གྱུར་པར་བསམ།",
    "ཕྱག་རྒྱ་ནི་ཡོ་ག་དེ་ཉིད་། འདུས་པར་གསུངས་པ་ཀྱེ་རྡོར་དུ་བྱེད་པ་ལྟར་རོ།",
    "གསུངས་པས་བྱ་མི་དགོས་སོ།",
    "གསུམ་པ་རྗེས་སམ་མཉམ་པར་མ་བཞག་པའི་རྣལ་འབྱོར་ལ་ལྔ་སྟེ།",
    "ཐོག་མར་ལེགས་པར་བཀྲུས།",
    "ཁ་སར་བྱས་ཡར་སྦྱར་བའི་ཚེ་རྣམ་བཅད་རྐང་སྟོང་ཤིང་དགེ་ལྡན་བ་རྣམས་ཧཱིཏྟི་རི་ཞེས་གསུངས་ནའང་།",
    "ས་སྐྱ་པའི་བཞེད་པ་ཎི་ཊི་རི་ཞེས་པར་འབོད་པ་ཡིན་གསུངས།",
    "ནག་པོས་དྲག་པོ་བསྒྲུབ་པར་བསམ་ཞིང་།",
    "རྒྱས་པར་འཁྲུལ་འཁོར་གྱི་ཆོ་གས་ཀྱང་བསྟན་པ་དང་།",
    "དེ་ལ་གཞིའི་བསྙེན་པ་བྱེད་པར་འདོད་ན།",
    "གཞན་ཡང་མཉམ་གཞག་མཉམ་ལངས་ཀྱི་ངེས་པ་ཤེས་པར་བྱ་སྟེ།",
    "དག་པ་དྲན་པའི་བར་ཚིག་གཞན་དང་མ་འདྲེས་པར་ཉམས་སུ་བླང་བར་བྱའོ་གསུངས།",
    "རིམ་གྱིས་ཐུན་ལ་འཇུག་པར་བྱའོ།",
    "སྣང་གྲག་རིག་གསུམ་གཤིན་རྗེའི་གཤེད་ཀྱི་སྐུ་གསུང་ཐུགས་སུ་ཤེས་བས་ཡུལ་ཐམས་ཅད་ལ་སྡང་ཞེན་མེད་པར་ལོངས་སྤྱོད་ཅིང་།",
    "སྦྱང་གཞི་བདེན་པར་གྲུབ་པ་ཞིག་ན་འགྱུར་བ་མེད་པ་ཇི་ལྟར་བ།",
    "ཉམས་རྟོགས་པད་དཀར་བཞད་པའི་ཉི་མ་ལགས།",
    "ཞེས་པས་རིམ་པ་བཞིར་ཡོད་པར་བསྟན།",
