    "ཁྱོད་ཁྱིམ་བདག་ལུག་གི་སར་སོང་ལ།",
    "ཁྱོད་ཀྱི་ཆེད་དུ་ང་འདིར་འོངས་ན་ཅིའི་ཕྱིར་སྒོ་བཅད་དེ་འདུག་ཅེས་གསུང་ངོ་སྨྲོས་ཤིག།",
    "ཁྱོད་ཀྱི་བུའི་སྐེད་པ་ལས་པ་ན་བརྒྱ་སྟོང་ཟད་མེད་དུ་འབྱུང་ན།",
    "བུ་མོ་དེས་ཀྱང་ཕྱིར་ལྡོག་སྟེ་དེ་ལྟར་སྨྲས་པ་ན།",
    "ཁྱིམ་བདག་ལུག་གིས་བསམས་པ་འདི་ནི་ཐམས་ཅད་མཁྱེན་པའི་སྙམ་སྟེ།",
    "ཁྱིམ་བདག་ལུག་གིས་ཞུས་པ།",
    "དེར་སྐྱེ་བོ་ཐམས་ཅད་དགག་པ་མེད་པར་སོང་སྟེ།",
    "ཐམས་ཅད་ཀྱང་སྐབས་སུ་འགྲོ་བ་དང་བསླབ་པའི་གཞི་འཛིན་པ་ལ་བཀོད་དོ། རེ་དགུ་པ་དཔལ་སྦེད་བཏུལ་བ་ནི།",
    "དེའི་ཚེ་སྔར་གྱི་ཁྱེའུ་མེ་སྐྱེས་དེའི་སྲིང་མོའི་ཁྱོ།",
    "ཁྱོད་ཀྱིས་ཀྱང་གཅེར་བུ་པ་གང་པོ་ལ་ཡོན་ཕུལ་ཅིག་ཟེར་ཏེ།",
    "དེ་ལ་ཉན་ཐོས་ཞིག་གིས་རྒྱུ་འདྲི།",
    "ཐེམ་པ་ལ་རྐང་པ་བཞག་ནས་གད་མོ་དགོད་དོ།",
    "གཅེར་བུ་པ་གཅིག་གིས་རྒྱུ་དྲིས་པས།",
    "ཆུ་བོ་དྲེགས་བྲལ་གྱི་འགྲམ་ན་སྐྱེས་པའི་ཤིང་ཞིག་ལ་གནས་པའི་སྤྲེའུ་ཞིག་སྤྲེའུ་མོ་ལ་ཆགས་པས་དེད་ན།",
    "སྤྲེའུ་མོ་འདྲེད་དེ་ཆུ་ལ་ཤོར་བ་ན་སྤྲེའུ་དེ་ཡང་ཆུ་ལ་མཆོངས་ཏེ་ཤིའོ།",
    "དེར་བྲན་ཞིག་ན་རེ།",
    "ཕོར་བུའི་ནང་གི་ཚོད་མ་མིན།",
    "སྦྱིན་བདག་གིས་ནི་སྦྱིན་པོའི་དུས།",
    "གལ་ཏེ་ཁས་ལེན་ན་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པས་བླའོ་སྙམ་དེ་ནས་དེ་སྟོན་པའི་དྲུང་དུ་སོང་སྟེ་ཞུས་པས།",
    "དེར་དཔལ་སྦེད་དགའ་སྟེ་ཁྱིམ་དུ་སོང་ནས།",
    "དེའི་ནང་ཤིང་ཀཏི་ཏའི་མེ་མདག་གིས་བཀང་།",
    "དེར་མེ་སྐྱེས་ཀྱི་སྲིང་མོས་ཅི་བྱེད་དྲིས་པ་ན།",
    "དེ་ཁྱིམ་གྱི་ཕུགས་མཛོད་ཅིག་གི་ནང་དུ་བཅུག་སྟེ་སྒོ་ལྕགས་བཏབ་བོ།",
    "མེ་དང་དུག་གི་གནོད་པ་མེད་པར་བཀའ་སྩལ་ཏེ་ཕེབས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་མེའི་དོང་གི་སྟེང་དུ་ཞབས་བཞག་པ་ན།",
    "ལྷ་རྣམས་ཀྱིས་ཀྱང་ནམ་མཁའ་ནས་མེ་ཏོག་གི་ཆར་ཕབ་བོ།"
  ]
}