    "འདུག་ཏུ་མི་བཏུབ་པམེད་པར་གྱུརཏོ།",
    "དེས་ན་སྤྱི་མཚན་དང་རང་མཚན་གཉིས་ཀ་ལའང་དོན་བྱེད་པ་ཡོད་དོ་ཞེསའགྲེལ་ཟེར་དེ་མི་འཐད་དེ།",
    "སྤྱི་དེ་ནི་གསལ་བ་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་དུས་ཀུན་གྱི་ཚེ་ནའང་རང་འཛིན་ཤེས་པ་སྐྱེད་པའི་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་རང་མཚན་མེད་པ་འདས་མ་འོངས་དང་ལོག་ཤེས་རྣམས་ལ་དེའི་རང་མཚན་ལྐོག་ཏུ་གྱུར་པའི་ཚུལ་གྱིས་ཇི་ལྟར་གཞལ་ཏེ་གཞལ་བྱ་རང་མཚན་མེད་པས་སོ།",
    "གསལ་བ་གཅིག་ལའང་གནས་སྐབས་ཁྱད་ཡོད་པ་དང་རང་བཞིན་ཕན་ཚུན་རྗེས་སུ་འགྲོ་བས་ཁྱད་མེད་པའི་ངོ་བོ་ཉིད་གཉིས་སུ་ཡོད་པ་ཅི་འགལ་སྙམ་ན་ཡང་།",
    "དེ་གསལ་བ་འཛིན་པའི་དུས་དེ་ཉིད་དུ་སྣང་རུང་ཡིན་པར་ཁས་བླངས་ལ་དེ་གསལ་བ་ཁོ་རང་མ་ཡིན་པར་ཡང་ཁས་བླངས་པས་ན།",
    "དེ་ཡང་རང་མཚན་ལ་མི་རྟག་པའི་སྤྱི་སྦྱར་ནས་བཟུང་ངོ་སྙམ་ཚངཔ་རྣམས་ཀྱི་ཞེ་འདོད་ལ་གསུམ་སྟེ།",
    "ཡོད་པ་ཉིད་དང་རང་རྒྱུ་དང་།",
    "གལ་ཏེ་རང་མཚན་ལ་ཡང་ཡང་ཤེས་པ་མེད་དུ་ཆུག་ཀྱང་རང་མཚན་དེ་ལ་ཡོད་པའི་སྤྱི་རྟག་པ་དེ་རང་མཚན་གྱི་སྒོ་ནས་ཡང་ཡང་ཤེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དུ་བ་སོགས་རྟགས་ལས་སྔར་གྱི་མེ་དེ་འདི་ན་ཡང་འདུག་གོ་སྙམ་པ་ནི་རྟགས་དེ་མེ་ཙམ་ལ་མ་འཁྲུལ་པ་ཡིན་པས་འབྲས་རྟགས་ཡིན་ཀྱང་སྔར་གྱི་དེ་འདིའོ་སྙམ་པ་ནི་འཁྲུལ་པ་ཡིན་ནོ།",
    "རིམ་ཅན་དུ་མཐོང་བ་ནི་གཅིག་དུས་ན་གཅིག་མེད་པས་དུས་ཅིག་ཅར་གསལ་སྣང་ཡོད་མི་སྲིད་ལ།",
    "དེ་ལྟར་མཐོང་བ་ལ་དོན་སྦྱོར་རྟོག་པ་མེད་ན་བ་ལང་དཀར་ཟལ་དང་ནག་པོ་མཐོང་བ་ལ་རིགས་གཅིག་ཏུ་འཛིན་པར་མི་འགྱུར་ཞིང་རིགས་མེད་པའི་ཕྱིར་སྒྲས་ཀྱང་རང་མཚན་གོ་བར་མི་འགྱུར་རོ་ཞེ་ན།",
    "མི་མཐུན་པ་མཐའ་དག་བསྟན་ནས་འདི་ལ་མི་འཇུག་ཅེས་བསྟན་པར་ནི་སུས་ཀྱང་མི་ནུས་པས་སྒྲ་དང་རང་མཚན་འབྲེལ་མི་ནུས་ཏེ།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "དང་པོ་ལྟར་དོན་བརྒྱ་དང་བདེ་བ་གཉིས་ཀྱིས་སོ་སོ་སོ་སོར་ཏེ་ཡན་གར་བ་ཡང་རང་འཛིན་ཤེས་པ་སྐྱེད་ནུས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འགའ་ཞིག་སྟེ་གྲངས་ཅན་པས་ནི་བདེ་སོགས་ཕྱི་རོལ་ན་དེ་ཙམ་ལྔའི་བདག་ཉིད་དུ་གནས་པ་ཉིད་དང་ནི་དེ་ཡང་༣ སེམས་མེད་པ་དང་རང་ལས་གཞན་པར་གྱུར་པའི་ཤེས་པས་གཟུང་བར་སྨྲ་སྟེ་ཞེས་སོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "མ་བསྟན་ཀྱང་འདི་ན་སྦྲུལ་འདུག་ཅེས་བརྗོད་པས་སྦྲུལ་འཛིན་སྐྱེ་བ་བཞིན་ནོ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་པའོ།",
    "དངོས་དང་རང་མྱོང་བ་ཡི་དཔེ།",
    "སྐྱེས་བུའི་རྒྱུད་ཀྱི་ཤེས་པས་སྔོ་སོགས་ཤེས་པ་བཞིན་དུ་སྔོ་འཛིན་ཡང་རང་བློ་རང་ལ་ལྐོག་ཏུ་མ་གྱུར་པར་མྱོང་བ་དང་དྲན་པས་གྲུབ་པ་ལ་བསྙོན་དུ་མེད་དོ།",
    "དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་ཡིན།",
    "དཀར་སྣང་ནི་མ་བསླད་པའི་ཕྱིར་རྣམ་པ་གཏོད་བྱེད་ཀྱི་ཕྱི་དོན་དུང་རང་ཉིད་དཀར་པོ་ཕམ་ཉིད་དུ་ཡོད་ཅེས་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཇི་ལྟར་རང་རང་སོ་སོས་མཐོང་བ་དེས་དོན་དེ་དང་དེ་ལྟ་བུར་རིག་པའི་ཐ་སྙད་བྱེད་ཀྱང་ཡུལ་གྱི་སྣང་བ་དེ་ལ་སྐྱུ། ། བརྟན་མི་བརྟན་དང་།",
    "དེས་ན་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུ་ཡིན་ན་དོན་མི་འདོད་པའི་ལུགས་ལ་ལྟ་ཅི་སྨོས་ཞེས་ཤེས་པར་འགྱུར་རོ།",
    "མིན་ཀྱང་རང་རིག་འབྲས་མི་འགལ།",
    "དེ་ཡང་རང་ལ་རང་ཡུལ་དུ་བདེན་ན་ཡུལ་དང་ཡུལ་ཅན་དང་དེ་རིག་པ་གསུམ་དུ་གནས་པས་དེ་གསུམ་ཐ་དད་དུ་འགྱུར་ལ།",
    "འཛིན་རྣམ་ལ་འཛིན་རྣམ་གཞན་མེད་ཀྱང་རང་རིག་མེད་པར་མི་འགྱུར་བའི་རྣམ་གཞག་ཐམས་ཅད་བདེ་ཕམ་བླག་ཏུ་གྲུབ་པ་ཡིན་ཏེ།",
    "བསྙོན་དུ་མེད་པའི་བློ་རྣམ་བཅས་དང་རང་རིག་པ་ལ་སྡང་བའི་བསམ་པ་དོར་བར་བྱས་ན་ལེགས་སོ།",
    "འོན་ཀྱང་བློ་གཅིག་དུས་གཅིག་ཏུ་སྣ་ཚོགས་སུ་འཆར་དུ་རུང་བའི་ཕྱིར་བློ་དང་དོན་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་བློ་ཡི་གཟུང་འཛིན་རྫས་གཅིག་ཏུ་གྲུབ་པས་རྣམ་བཅས་དང་རང་རིག་གྲུབ་པར་གྱུར་ན་དེ་འདྲའི་ལྷན་ཅིག་དམིགས་ངེས་དེས་ཕྱི་དོན་མེད་པར་འགྲུབ་སྟེ།",
    "གཞན་ལུགས་འགོག་དང་རང་ལུགས་བཞག།",
    "སྔར་ཞིག་ཟིན་དེ་ད་ལྟ་གསལ་པོར་སྣང་བ་མི་སྲིད་ཀྱང་རང་དང་དུས་མཉམ་པའི་རང་མཚན་ད་ལྟ་བ་དེ་རྗེན་གཅེར་གསལ་བར་སྣང་ངོ་ཟེར་ན།",
    "དོན་འདོད་པའི་ཞེན་ངོར་བྱས་ན་གཟུང་བའི་རྣམ་པ་དེས་ཁ་ཕྱིར་བལྟས་ཀྱི་དོན་རིག་པར་འདོད་པས་གཞན་རིག་དང་རང་རིག་ཐ་དད་པ་ལྟ་བུའི་ཚུལ་གཉིས་པ་འགྲེལ་ཅན་གྱི་བློར་བསྒྲུབས་ཀྱང་དོན་དུ་མྱོང་བ་དེ་ནི་རང་རིག་ཁོ་ན་ལས་གཞན་རིག་པ་མི་སྲིད་པར་ཤུགས་ཀྱིས་འགྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞན་མཐོང་བ་དང་རང་མ་མཐོང་བའི་ཆ་ཞེས་པ་ནི་འཁྲུལ་པས་སྒྲོ་བཏགས་པ་ཙམ་ལས་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "བློའི་ཡུལ་དུ་གྱུར་པའི་དོན་གང་ཡང་ནི་སྔར་མཐོང་བ་ཡོད་པ་མིནཏེ་དུས་མཉམ་པས་ནི་ཕན་མི་འདོགས་ལ་དུས་མི་མཉམ་པའི་རྒྱུ་སྔ་མས་ཀྱང་རང་འདྲའི་རྣམ་པ་བློ་ལ་མི་བྱེད་པར་འདོད་པས་ན་ཇི་ལྟར་ཡུལ་དང་ཡུལ་ཅན་དེ་ནི་མཐོང་བ་ཞེས་པ་དང་།",
    "བདེ་མྱོང་རང་བློ་མངོན་སུམ་བསྒྲུབ།",
    "བདེ་མྱོང་རང་རིག་ཡིན་དམ་བཅའ།",
    "དེ་ལྟ་ན་རྣམ་བཅས་དང་རང་རིག་པ་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་དོན་ཙམ་མྱོང་བར་མ་ཟད་གཞན་ཤེས་རྣཔ་དེའང་རང་ཉིད་ཉམས་སུ་མྱོང་བའམ་མཐོང་བར་གདོན་མི་ཟ་སྟེ།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "དེ་ལྟ་ན་སྔོ་འཛིན་དེའང་རང་ཉིད་འགྲེལ་ཀྱི་ངོ་བོར་མྱོང་བ་དང་ཡུལ་ཅན་གྱི་ཚུལ་དུ་མི་སྣང་བར་སྔོན་པོ་བཞིན་དུ་ཡུལ་དུ་སྣང་བར་གྱུར་རོ།",
    "དེ་ལས་སྐྱེས་པའི་ཤེས་པ་གསལ་བ་དེ་ཡང་རང་རིག་པས་མ་མྱོང་ན་གསལ་བར་མི་རྟོགས་ལ།",
    "ལུང་དང་རང་ཚིག་བསྡུས་ཏེ་བཤད།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "འདི་པར་ཤིང་གསར་བཞེས་སྐབས་སུ་ཞུ་བཅོས་བྱས་འདུག་སྙམ་ཏེ།",
    "གཉིས་ནི་ལྟ་བུ་གང་འཁོད་དཀར་ཆག་ཏུའང་རང་སོར་འཇོག་པ་ལས་ཚིག་བདེ་མིན་དང་།",
    "དང་པོ་ལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པའི་བསྒྲུབ་བྱ་གཙོ་བོར་འགོག་པ་རྩ་བ་ཤེས་རབ་དང་།",
    "ཞི་བ་འཚོས་ནི་ཐ་སྙད་དུ་ཕྱི་དོན་མེད་ཅིང་རང་རིག་ཡོད་པ་དང་།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "དེ་སྐད་དུའང་རང་འགྲེལ་ལས།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "འདིས་ནི་བར་ཆད་མེད་ལམ་ལ་གནས་པའི་སེམས་དཔའི་རྒྱུད་ལ་ཀུན་རྫོབ་སེམས་བསྐྱེད་ཡོད་པའང་ཐོན་འདུག་གོ།",
    "སྔོན་ཆད་གཞན་གྱིས་ཡེ་མ་མཐོང་བར་འདུག་གོ།",
    "ཕུང་པོ་ཡང་རང་བཞིན་མེད་པར་རྟོགས་པར་གསུངས་སོ་། ཞེས་གསུངས་པའི་ཕྱིར།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "འདི་ལ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པའི་དམ་བཅའ་བཞག་པ་ནི།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "སྤྲུལ་གཞི་རྡེའུ་ཤིང་རང་ངོས་ནས་རྟ་གླང་དུ་སྣང་བ་ལ་འགལ་བ་མེད་པའི་ཕྱིར།",
    "ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱིར་ཞེ་ན།",
    "སྒྲུབ་བྱེད་ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་བསྒྲུབ་བྱ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་བསྒྲུབ་དཀའ་སླ་མཚུངས་པའི་ཕྱིར།",
    "ལན་ཅི་འདུག་བསམ་པར་བྱའོ།",
    "དེ་ཡང་དངོས་སྨྲ་བ་དང་རང་རྒྱུད་པ་རྣམས་ཀྱི་གཞན་སྐྱེ་འདོད་པའི་ལུགས་སྤྱིར་འགོག་པ་ལ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེས་ཁོ་རང་དངོས་སུ་རྟོགས་པ་གང་ཞིག་ཁོ་ཁོ་རང་དང་ཐ་དད་མ་ཡིན་པའི་ཕྱིར་ན་མ་ཁྱབ་བོ།",
    "དེ་ཁོ་རང་ལ་མངོན་སུམ་ཡིན་པའི་ཕྱིར།"
