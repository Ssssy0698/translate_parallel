    "དམངས་ཁྲོད་གཏམ་རྒྱུད་དང་ལྷ་སྒྲུང་གཉིས་མཐའ་གཅིག་ཏུ་ཕན་ཚུན་ལ་འབྲེལ་བ་མེད་པའང་མིན་ཏེ།",
    "བསམ་བློའི་ཉམས་ལེན་གྱི་ཁྲོད་ནས་བསྡུ་ལེན་དང་ལེགས་སྒྲིག་བྱས་ཏེ་རིམ་གྱིས་བྱུང་བ་ཡིན་སྟབས།",
    "དམངས་ཁྲོད་གཏམ་རྒྱུད་ལས་ལྷ་མི་སྲོག་ཆགས་ཅི་རིགས་ཡིན་ཆོག་པར་སྣང་།",
    "ངག་རྒྱུན་ལ་ལྷ་སྒྲུང་ལྟ་བུའི་བྱུང་རབས་ཀྱི་དུས་ཡུན་རིང་བོ་མེད་ཅིང་།",
    "ལྷ་སྒྲུང་།",
    "ལྷ་སྒྲུང་རིག་པའི་གཞུང་ལུགས་ཀྱི་རྨང་གཞི་བརྟན་པོ་འཛུགས་ཐུབ་པ་བྱུང་།",
    "མིའི་རིགས་རིག་པ་སོགས་རིག་གཞུང་སྣ་ཚོགས་ཀྱི་ལམ་ནས་གནའ་བོའི་དུས་སུ་བྱུང་བའི་ལྷ་སྒྲུང་ལ་ཞིབ་འཇུག་བགྱིས་ཤིང་།",
    "ལྷ་སྒྲུང་དང་ཆོ་གའི་ལྟ་བ།",
    "བྱེད་ནུས་རིང་ལུགས་ཀྱི་ལྷ་སྒྲུང་སྨྲ་བ་རྣམས་གཞུང་ལུགས་ཀྱི་ལྟ་བ་དང་ཁྱབ་ཁོངས་སོ་སོ་ནས་ལྷ་སྒྲུང་ལ་ཞིབ་འཇུག་བྱས་ཏེ།",
    "ལྷ་སྒྲུང་རིག་པ་དང་།",
    "ལྷ་སྒྲུང་དང་ཆོ་ག་གཉིས་ཀ་གཟུགས་དང་གྲིབ་མ་བཞིན་འགྲོགས་ཤིང་།",
    "བསྟན་བཅོས་དེའི་ནང་དུ་ལྷ་སྒྲུང་ནི་མིའི་འཚོ་བ་དང་ཕྱི་རོལ་ཡུལ་གྱི་སྣང་ཚུལ་རྣམས་ལ་ནོར་འཁྲུལ་གྱི་སྒོ་ནས་འགྲེལ་བརྗོད་བརྒྱབ་པར་ངོས་འཛིན་བྱེད་ཅིང་།",
    "ཆོ་གའི་བརྗོད་བྱ་ལ་གོ་བ་ལེན་པར་ཅི་ནས་ཀྱང་ཕན་པ་ཡོད་པར་འདོད།",
    "དེ་ལས་ཆོ་ག་ལ་འགྲེལ་བརྗོད་བྱེད་པའི་ལྷ་སྒྲུང་ཡང་རིམ་གྱིས་བྱུང་བ་ཡིན་ཟེར།",
    "སྐུ་སྙུང་བཞེས་པ་དང་ཡང་ན་དགུང་ལོ་བགྲེས་ཚུལ་བཞེས་པའི་དུས་སུ་བབས་ཚེ།",
    "ལོའི་པར།",
    "རྒྱལ་བོ་གང་ཞིག་སྲིད་ཁྲིར་བཞུགས་དུས་རྒས་ཤིང་འཁོགས་པའི་གནས་སུ་མི་ལྷུང་བའི་ཆེད་དུ་སྲིད་སྐྱོང་བའི་དུས་ཡུན་གཏན་འཁེལ་བྱས་ཡོད་ཅིང་།",
    "དུས་ཡུན་དེ་ལ་སླེབས་པ་ན་རྒྱལ་བོའི་སྲོག་ལེན་པར་བྱེད།",
    "ལྟ་དགོངས་འདིས་ནི་ཕྱིས་སུ་ལྷ་སྒྲུང་ཞིབ་འཇུག་བྱེད་པའི་མཁས་པ་ཀུན་ལ་བློ་བསྐྱེད་མི་ཉུང་བ་ཐེབས་ཡོད་པ་སྨྲས་ཅི་དགོས།",
    "དུས་རབས་ཉི་ཤུ་བའི་ལྷ་སྒྲུང་རིག་པའི་ལྟ་བ་གཙོ་བོ་སྟེ་ལྷ་སྒྲུང་དང་ཆོ་གའི་གཞུང་ལུགས་འདི་ནི།",
    "བྱེད་ཐབས་ཤིག་ཡིན་པར་ངོས་འཛིན་གནང་ཡོད།",
    "བསྟན་བཅོས་དེའི་ནང་ཞིབ་འཇུག་བྱས་ཡོད་པའི་བར་བརྒལ་གྱི་ཆོ་གའི་གཞུང་ལུགས་ཀྱིས་དེང་རབས་མིའི་རིགས་རིག་པ་དང་བཅས་པའི་རིག་གཞུང་ཁྱབ་ཁོངས་གཞན་དག་ལ་ཤུགས་རྐྱེན་ཆེན་པོ་ཐེབས་སུ་བཅུག་ཡོད།",
    "དེ་མིན་མཚམས་ཚིགས་ཞེས་པའི་ཐ་སྙད་གསར་བཟོ་བྱས་ཤིང་དེས་ནི་སེམས་ཁམས་རིག་པ་དང་ཆོ་གའི་ཞིབ་འཇུག་ཐད་ལ་བྱས་རྗེས་བླ་ན་མེད་པ་ཐོན་ཡོད་པ་ལ་མ་བགྲོས་གཅིག་མཐུན་གྱི་ལྟ་བ་ཆགས་ཡོད།",
    "ཚོང་དོན་པར་སྐྲུན་ཁང་།",
    "ལོའི་པར།",
    "བར་བརྒལ་གྱི་བྱ་འགུལ་དེ་དག་སོ་སོར་བྱས་ཏེ་ཆོ་གའི་རིགས་ལ་དབྱེ་ཞིབ་བགྱིས་ན།",
    "ཐ་སྙད་དེའི་དོན་ལ་གཞིགས་ན་བྱ་དངོས་གཉིས་ཀྱི་འབྲེལ་མཚམས་སམ་མཐའ་ན་ཡོད་པ་ལྟ་བུ་ལ་ངོས་འཛིན་གྱི་ཡོད་པས་དེ་ལྟར་ཡིན་པར་སེམས།",
    "མི་རིགས་པར་སྐྲུན་ཁང་།",
    "ལོའི་པར།",
    "ཐོལ་བྱུང་དང་ཚན་རིག་བར་གྱི་རྩོད་སྒྲུབ་ཀྱི་འབྲེལ་བ་ལ་མཐོང་ཆེན་བྱས་ཡོད་ཅིང་།",
    "ལྷ་སྒྲུང་དང་ཆོ་ག་གཉིས་ནི་གཅིག་ལ་གཅིག་རྟེན་གྱི་འབྲེལ་བ་ཆགས་ཤིང་།",
    "དེ་གཉིས་ཀ་གཅིག་ནི་ཅིག་ཤས་ཀྱི་འབྱུང་ཁུངས་སམ་ཡང་ན་ཕན་ཚུན་བར་འགྲེལ་བརྗོད་རྒྱག་བྱེད་ཅིག་གཞི་ནས་མིན་པར་སེམས།",
    "སྐབས་དེའི་ལྷ་སྒྲུང་ནི་རོལ་རྩེད་ཁོ་ནའི་ཆེད་དུ་བཟོས་པའི་ཤེས་བྱ་ཞིག་དེ་བས་ཀྱང་མིན་པར་བརྗོད།",
    "ལྷ་སྒྲུང་ནི་དཔེ་མཚོན་ལེའུ་དང་པོ།",
    "ཙམ་མ་ཡིན་པར།",
    "ཚོང་དོན་པར་སྐྲུན་ཁང་།",
    "ལོའི་པར།",
    "ཚོང་དོན་པར་སྐྲུན་ཁང་།",
    "ལོའི་པར།",
    "དེ་དང་ཆབས་ཅིག་མིའི་རིགས་ཀྱི་སྤྱོད་ལམ་མང་བོ་ཞིག་གདོད་མའི་དུས་ཀྱི་ལྷ་སྒྲུང་དང་འབྲེལ་བ་ཡོད་པར་བཞེད།",
    "མིའི་སེམས་ཁམས་ཁྲོད་ཀྱི་འདུ་ཤེས་རྟིང་མའི་ཆ་དང་ལྷ་སྒྲུང་གཉིས་བར་གྱི་འབྲེལ་བར་ཉམས་ཞིབ་ཟབ་རྒྱས་གནང་ཡོད་ཅིང་།",
    "མངོན་མེད་འདུ་ཤེས་ནི་མིའི་སེམས་ཁམས་ཀྱི་གཏིང་སར་ཆགས་པའི་མ་རིག་པའི་ཤེས་པ་རིགས་ཤིག་ལ་ངོས་བཟུང་སྟེ་མི་གཞི་གྲུབ་བྱེད་ཀྱི་རྨང་གཞི་ཡིན་པར་བཤད།",
    "ངེས་པར་དུ་འཇོང་ཀི་རང་ནས་གསར་བཟོ་བྱས་པའི་ཐ་སྙད་གདོད་གཟུགས་སོགས་ལ་བསྟེན་ནས་རྟོགས་དགོས།",
    "དེ་ཉིད་ལྷ་སྒྲུང་དང་།",
    "ཁོའི་བཞེད་ལུགས་ལ་ལྷ་སྒྲུང་ནི་ཕྱི་རོལ་ཡུལ་གྱི་སྣང་ཚུལ་ལས་བྱུང་བ་མིན་པ་དང་།",
    "ཕྱི་རོལ་ཡུལ་གྱི་གནས་སྣང་ལ་ལད་ཟློས་བྱས་ནས་བྱུང་བའི་ཆོ་ག་དག་མི་རབས་མང་བོ་བརྒྱུད་མཐར་གཏམ་རྒྱུད་དུ་གྱུར་བ་ཡང་མིན་པར།",
    "ལྷ་སྒྲུང་དང་སྒྲུང་རབས།",
    "གདོད་མའི་འདུ་ཤེས་ཀྱིས་བསྐྱེད་པའི་ལྷ་སྒྲུང་དང་མཐུན་པར་འདོད།",
    "ལྷ་སྒྲུང་ཡང་དེ་ནང་བཞིན་ཡིན་ཏེ།",
    "དོན་དངོས་ཀྱི་གནས་སྐབས་དག་འདྲ་མཚུངས་ཀྱི་སྒོ་ནས་དཔེ་མཚོན་བྱས་པ་ཙམ་མིན་པར།",
