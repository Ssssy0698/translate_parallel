    "ཅེས་ཞབས་བརྟན་གསོལ་ཚིག་འདི་འདྲ་ཞིག་དགོས་ཞེས་གཏེར་ལུང་ཕྱག་གཉེར་ཀྱི་གཙོས་སེར་སྐྱ་ཐུན་མོང་ནས་བསྐུལ་བ་ལྟར་༧སྐལ་ལྡན་བློ་བཟང་འཕྲིན་ལས་ལུང་རྟོགས་རྒྱ་མཚོས་སྦྱར་བའོ། སྐྱེ་ཞིང་སྐྱེ་བ་དག་ནི་ཐམས་ཅད་དུ།",
    "རྒྱལ་ཀུན་གསང་བ་གསུམ་གྱི་རི་མོ་འབུམ།",
    "སྙིགས་དུས་འགྲོ་བའི་འདྲེན་མཆོག་ཁྱོད་ཉིད་ལ།",
    "མགོན་པོ་ཁྱོད་ཀྱིས་འབྲལ་མེད་རྗེས་བཟུང་སྟེ།",
    "གསུང་གསང་ཟབ་མོའི་སྣོད་དུ་འགྱུར་བར་མཛོད།",
    "བརྩེ་བས་གཟིགས་པ་ལྷོད་པར་བསྐྱེད་ལགས་སམ།",
    "འོན་ཀྱང་ཁྱོད་ཀྱི་འཕྲིན་ལས་སྣང་བའི་ཟེར།",
    "གཟིགས་པ་དག་པའི་ཐུགས་རྗེའི་སྤྱན་རས་ཀྱིས།",
    "དེ་སྲིད་ཁྱོད་ཀྱི་ཞབས་སྐྱེས་པདྨའི་རྡུལ།",
    "མགོན་པོ་གང་གི་གཟུགས་སྐུའི་བཀོད་པ་ཞི་བའི་དབྱིངས་སུ་བསྡུས་སྐབས།",
    "དེ་མཐུན་༧དམ་པ་གང་གི་གདན་ས་ཚེ་ཏན་དང་།",
    "༧མགོན་པོ་གང་གི་ཞལ་གྱི་བདུད་རྩི་རོལ་བའི་སྐལ་བ་བཟང་བོ་ཐོབ་པ།",
    "རང་གི་སྤྱི་བོར་སེང་ཁྲི་པད་ཟླའི་སྟེང་།",
    "གསུང་གི་གསང་བ་ཟབ་མོའི་སྣོད་གྱུར་ཅིག།",
    "ཁྱད་པར་མགོན་ཁྱོད་དྲག་པོ་འཁོར་ལོའི་སྐུར།",
    "༧ཀུན་གཟིགས་མཆོག་ཐུགས་བྲེལ་ཧ་ཅང་ཆེ་བའི་སྐབས་སུ་འཕྲད་པས་དམན་པ་བདག་ལ་སྐུལ་བ་བོའི་རེ་འདོད་ལྟར་མྱུར་བར་བྲིས་ཤིག་ཅེས།",
    "ལྷག་བསམ་ལང་ཚོ་གསར་བའི་རྩེ་དགའ་ཡིས།",
    "བྱིས་པའི་སྨྲ་བྱེད་གློག་གི་རྩེ་འཇོ་ཡིས།",
    "ཁྱོད་སྙན་མཛེས་པའི་རྒྱུན་དུ་སྤེལ་ལ་དགོངས།",
    "བསྟན་འཛིན་མཁས་གྲུབ་བྱེ་བའི་གཅིག་གི་རྒྱན།",
    "འབུམ་ཕྲག་ཤེས་བྱའི་རི་མོ་གཟུགས་ཅན་དུ།",
    "གཏན་གྱི་སྐྱབས་གནས་ཁྱོད་ལ།",
    "ཕན་བདེའི་གཏེར་ཆེན་ཁྱོད་ལ།",
    "བདེ་སྟོང་མཆོག་གི་ཏིང་འཛིན་རབ་གསལ་བའི།",
    "འགྲོ་བའི་འདྲེན་པ་ཁྱོད་ལ།",
    "ཁྱོད་ཐུགས་པདྨོའི་ལྟོ་བར་ཡོངས་འཁྱིལ་བས།",
    "སྙན་པ་གཡས་འཁྱིལ་དུང་གི་རང་སྒྲ་ཆེ།",
    "བསྟོད་ཚིག་ཉིན་བྱེད་འོད་ཀྱིས་རེག་པ་ལས།",
    "ཁྱོད་མཉེས་འབའ་ཞིག་བསྒྲུབ་པར་བདག་གྱུར་ཅིག།",
    "མགོན་ཁྱོད་དཔག་མེད་ཚེ་ཡི་ལྷ་མཆོག་དང་།",
    "བཀའ་སྡོད་ཧོར་མོ་ལ་སོགས་སྲུང་མ་ཡིས།",
    "ལྷ་རྫས་བཅས་རྐང་ཚའི་གསར་སྒའི་སྒར་གྲོང་འདུས་སྤྱི་ཐུན་མོང་ནས་བཀྲ་ཤིས་པའི་བསྐུལ་པ་ལ་བརྟེན་ནས།",
    "བདག་གིར་མཛད་པའི་ཁུར་ཆེན་ཕྲག་ཏུ་བཞེས།",
    "ཕྱོགས་རྫོགས་ལང་ཚོ་གསར་བའི་མཛེས་སྡུག་ཅན།",
    "ཚེ་དང་ཡེ་ཤེས་མཆོག་གི་ཤིས་པ་སྩོལ།",
    "བསྔགས་པའི་རོལ་མོ་བྱེ་བའི་གནས་སུ་མཐོ།",
    "རེ་བའི་མིག་འབྲས་ཁྱོད་གདོང་ཉིད་ལ་གཏད།",
    "སྟོང་གསུམ་ཁྱོན་དུ་འགེངས་པས་རྫོགས་ལྡན་དཔྱིད།",
    "བདག་སོགས་དད་མོས་ཚོགས་པའི་མཐུ་སྟོབས་ཀྱིས།",
    "བསླབ་གསུམ་ཡོན་ཏན་གཟི་འོད་སྟོང་གིས་བརྗིད།",
    "དྲི་མེད་ལུང་རིགས་ཟབ་མོའི་རྣམ་དཔྱོད་ཀྱིས།",
    "གང་གི་ཐུགས་བསྐྱེད་བདག་སོགས་དད་མོས་མཐུས།",
    "མགོན་ཁྱོད་ཞབས་པད་སྲིད་མཐར་གནས་གྱུར་ཅིག།",
    "བདག་གི་སྤྱི་བོར་པད་ཟླའི་གདན་བཞུགས་ལ།",
    "མགོན་ཁྱོད་ལུས་ངག་ཡིད་ཀྱིས་བསྟེན་པ་ལ།",
    "ཞེན་པ་གཏིང་ནས་ལོག་པའི་ངེས་འབྱུང་གིས།",
    "སྐྱེ་ཞིང་སྐྱེ་བར་ཁྱོད་ཞབས་གུས་བསྟེན་ནས།",
    "ཅི་མཛད་ལེགས་པར་མཐོང་བའི་མོས་གུས་ཀྱིས།",
    "རྡོ་རྗེ་འཆང་གི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "ཐུགས་རྗེ་འོད་ཟེར་ཕྲ་མོས་རེག་པས་ཀྱང་།",
    "ཁྱོད་ཞབས་མི་འཇིག་རྡོ་རྗེའི་ཁམས་ཀྱི་ངོར།",
    "རིས་མེད་བསྟན་འཛིན་བྱེ་བའི་གཙུག་གི་རྒྱན།",
    "ཁྱོད་སྐུ་མི་ཤིགས་གསང་གསུམ་རྒྱན་གྱི་བཀོད།",
    "ཟླ་ཞུན་ལང་ཚོར་སྒེག་པའི་ཉམས་ལྡན་མ།",
    "འབེབས་མཛད་རྒྱལ་ཡུམ་ཏཱ་རེས་དགེ་ལེགས་སྩོལ།",
    "ཁྱོད་གསུང་ཉན་ཅིང་བཀའ་བཞིན་བསྒྲུབ་པ་ལ།",
    "སྐད་ཅིག་རེར་ཡང་འགྲོ་ཁམས་རྒྱ་མཚོའི་ཁྱོན།",
    "འདྲེན་མཛད་བདེ་གཤེགས་ས་ལ་རེག་གྱུར་ཅིག།",
    "བདག་ཅག་ཇི་ལྟར་སྨོན་པའི་རེ་འབྲས་རྣམས།",
    "རྡོ་རྗེའི་ཕྱག་གིས་རྡོ་རྗེའི་མདུད་རྒྱ་གྲོལ།",
    "རྡོ་རྗེ་གསུང་གིས་རྡོ་རྗེའི་ཚིག་གྲོལ་ཏེ།",
    "རྡོ་རྗེ་འཆང་གི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "ལིས་དབུང་ཡུས་སོགས་མི་སྣ་སུམ་ཅུ་ལྷག་གིས་གོས་ཆེན་དམར་བོ་བུབ་གསུམ་བཅས་༡༩༩༧སྤྱིའི་ཟླ་༦ཚེས་༩དགུང་དྲོར་ཁོང་ཧྲེའི་ཡུལ་དུ་ཁོ་ཚོ་ཡོངས་ལ་དུར་བདག་གི་རྗེས་གནང་བཏོན་སྐབས་བསྐུལ་བ་ལ་བརྟེན་ནས་བསེ་ཚང་བློ་བཟང་དཔལ་ལྡན་ནས།",
    "ཚེ་དཔལ་ཡེ་ཤེས་མཆོག་གི་དངོས་གྲུབ་སྩོལ།",
    "ལྔ་རིག་དབྱངས་ཀྱི་རྒྱལ་མོ་དགྱེས་པའི་གླུས།",
    "བྱམས་བརྩེ་རྔ་ཡབ་དཀར་བོའི་འཇོ་སྒེག་གིས།",
    "འཕྲལ་ཡུན་རེ་འབྲས་འཛམ་བུའི་དོག་པ་ཅན།",
    "བདག་ཅག་དད་མོས་ལྷག་བསམ་དག་པའི་མཐུས།",
    "ཁྱོད་ཞབས་འགྱུར་མེད་རྡོ་རྗེ་ལྟར་བརྟན་ཅིང་།",
    "ཅེས་པ་འདི་གང་གི་ཞལ་སློབ་དད་གུས་ཀྱི་ལྷག་བསམ་རབ་ཏུ་རྒྱས་པ་རྣམ་འཇོམས་སྐྱབས་ཀྱིས་འདི་འདྲ་ཞིག་དགོས་ཞེས་བཀྲ་ཤིས་པའི་ལྷ་དར་དང་བཅས་ཡང་ཡང་བསྐུལ་བ་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "དཔལ་ལྡན་མཁས་དགུའི་གཙུག་གི་རྒྱན་གྱུར་པ།",
    "སྔོན་མེད་ཕྱག་རྗེས་གསར་བའི་རི་མོའི་རྒྱུ།",
    "བདག་ཅག་དད་མོས་ལྷག་བསམ་དག་པའི་མཐུས།",
    "བཅུ་དྲུག་ལང་ཚོ་དར་བའི་མཛེས་སྡུག་སྐུ།",
    "པོར་ཁྱོད་ཞབས་རྟག་བརྟན་ཤོག།",
    "བདག་ཅག་དད་མོས་ལྷག་བསམ་དག་པ་དང་།",
    "བསྟན་པའི་དཔལ་གྱུར་ཁྱོད་ཞབས་རྟག་བརྟན་ཤོག།",
    "ཐུབ་བསྟན་འཛིན་མའི་ལང་ཚོའི་དཔལ་ཡོན་དུ།",
    "གཅིག་ཏུ་དྲིལ་བའི་ལང་ཚོའི་དཔལ་མངའ་བ།",
    "བྱེད་པོར་མགོན་ཁྱོད་ཞབས་པད་རྟག་བརྟན་ཤོག།",
    "ཅེས་པ་འདི་གང་གི་སློབ་བུ་བྱ་བཏང་བ་རྣམས་ཀྱིས་བསྐུལ་བར་བརྟེན།",
    "བརྒྱད་གཉིས་ལང་ཚོ་གསར་བའི་མཛེས་རྫོགས་པ།",
    "རྒྱལ་ཡུམ་ཏཱ་རེ་ལ་སོགས་ཚེ་ལྷ་ཡིས།",
    "ཁྱོད་ཐུགས་བུམ་བཟང་ལྟོ་བར་གཡས་འཁྱིལ་ཏེ།",
    "ཅེས་པ་འདི་ནི་གང་གི་ཡོངས་འཛིན་རྣམ་དཔྱོད་ཡངས་པ་དགེ་སློང་བསྟན་འཛིན་ནས་ལྷ་དར་བཅས་བསྐུལ་བ་ལ་བརྟེན་ནས།",
    "རབ་འབྱམས་ཞིང་གི་ཇི་སྙེད་ཚེ་ཡི་ལྷ།",
    "དྲི་མེད་ལུང་རིགས་ཉིན་བྱེད་འོད་སྣང་གིས།",
    "མཁྱེན་རྩལ་སྟོབས་ཀྱིས་ཤེས་བྱའི་གནས་ཀུན་གཟིགས།",
    "མགོན་ཁྱོད་ཞབས་སེན་མི་འགྱུར་རྟག་བརྟན་གསོལ།",
    "དམ་བཅའི་རི་མོ་ཐུགས་དབུས་བཅངས་པ་བཞིན།",
    "གསུང་གསང་ཟབ་མོའི་སྣོད་དུ་བདག་གྱུར་ཏེ།",
    "རྒྱལ་ཡུམ་ཡིད་བཞིན་ཚེ་ཡི་ལྷ་མཆོག་གིས།",
    "སྐལ་ལྡན་རེ་བ་ཀུན་སྐོང་ཡིད་བཞིན་ནོར།",
    "བསླབ་གསུམ་རིན་ཆེན་ཏོག་གིས་རབ་མཛེས་པའི།",
    "ཐུགས་རྗེའི་སྤྱན་གྱིས་གཡེལ་མེད་བརྩེ་གཟིགས་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "སྐྱེ་ཞིང་སྐྱེ་བར་ཁྱོད་ཀྱིས་རྗེས་འཛིན་མཛོད།",
    "རེབ་གོང་རོང་འབྲོག་ཚོ་ལྔའི་སྐྱ་སེར་ཐུན་མོང་ནས་བསྐུལ་པ་ལྟར།",
    "རྒྱ་མཚོའི་གོས་ཅན་ཁྱོན་དུ་ལེགས་སྤེལ་བའི།",
    "སྐྱེ་ཞིང་སྐྱེ་བར་མགོན་པོ་ཁྱོད་ཉིད་ཀྱིས།",
    "མགོན་ཁྱོད་སྐྱབས་ཀུན་འདུས་པའི་བདག་ཉིད་དུ།",
    "རྩེ་གཅིག་མོས་པས་དད་པའི་ཆུ་འཛིན་ཆེར།",
    "འཇོ་བས་རེ་འབྲས་མྱུ་གུ་སྨིན་པར་ཤོག།",
    "འཛིན་པའི་རྒྱལ་ཡུམ་ཚེ་ཡི་ལྷ་མཆོག་གིས།",
    "མཛད་མེད་འཇོ་བས་སྐལ་ལྡན་རེ་སྐོང་བའི།",
    "དད་ལྡན་སློབ་བུའི་མོས་གུས་མཐུ་བཙན་པས།",
    "མགོན་ཁྱོད་ཞབས་ཟུང་བཀྲ་ཤིས་རི་མོ་རྒྱུ།",
    "ཁྱོད་གསུང་ཟབ་རྒྱས་གདམས་པའི་རྫིང་བུ་ཡིས།",
    "དེ་སྲིད་ཁྱོད་ཞབས་པདྨོར་ཉེར་བཏུད་ནས།",
    "ཉམ་ཐག་འགྲོ་བའི་རེ་སྐོང་ཁྱོད་མིན་སུ།",
    "གསེར་ལྗོངས་ཐུབ་པ་མཆོག་གི་གདུང་འཚོབ་རྗེ།",
    "མགོན་པོ་ཁྱོད་ཀྱི་བཀའ་དྲིན་སུས་མི་དྲན།",
    "ཐུགས་རྗེ་སྤྱན་རས་ཡངས་པས་འགྲོ་ལ་གཟིགས།",
    "ཁྱོད་ཞབས་པདྨོ་འབྲལ་མེད་གུས་བསྟེན་ནས།",
    "སྐུའི་ཉེ་གནས་ཐུན་མོང་གིས་ལྷ་རྫས་དང་བཅས་བསྐུལ་བ་ལ་བརྟེན་ནས།",
    "ཁྱོད་ཞབས་པདྨོ་འབུམ་གྱི་མཛེས་སྡུག་རིས།",
    "མོངས་གཡུལ་ལས་རབ་རྒྱལ་ཏེ།",
    "ཐུན་མོང་ལམ་གྱི་རིམ་པས་རྒྱུད་སྦྱངས་ཏེ།",
    "རིམ་གཉིས་ཟབ་མོའི་ཏིང་འཛིན་ལ་བརྟེན་ནས།",
    "བདེ་ལྡན་ཞིང་གི་བཀོད་པ་རྒྱ་མཚོའི་དཔལ།",
    "གསུང་གི་གསང་བ་ཟབ་མོའི་སྣོད་གྱུར་ནས།",
    "ཅི་མཛད་ལེགས་པར་མཐོང་བའི་མོས་གུས་ཀྱིས།",
    "རྡོ་རྗེ་འཆང་གི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "གང་ཁྱོད་བདུད་བཞིའི་གཡུལ་ལས་རྣམ་རྒྱལ་ཀྱང་།",
    "རེ་བའི་སྐྱབས་བྲལ་མི་བཟད་གདུང་བས་མནར།",
    "མྱུར་དུ་བྱོན་ཏེ་རེ་འབྲས་སྨིན་པར་མཛོད།",
    "རེ་བའི་སྨོན་པ་མྱུར་དུ་འགྲུབ་པ་དང་།",
    "མྱུར་བསལ་རེ་བའི་ཀུ་མུད་རྒྱས་པར་མཛོད།",
    "སྐྱོང་བའི་བྱེད་པོར་བརྩེ་བས་མྱུར་གཟིགས་མཛོད།",
    "ཐུགས་རྗེ་འགོག་པ་མེད་པའི་དབྱིངས་ནས་གཟིགས།",
    "མནར་བའི་ཚུལ་འདི་གཟིགས་པ་ལྷོད་དམ་ཅི།",
    "མགོན་པོ་ཁྱོད་ལ་སྐྱོན་གྱི་སྐབས་མེད་པས།",
    "ཇི་ལྟར་རེ་བའི་འདབ་སྟོང་རབ་རྒྱས་པའི།",
    "རེ་ཞིག་གཟུགས་སྐུ་རགས་པའི་ཆུ་འཛིན་དཀར།",
    "གང་ཁྱོད་བདུད་བཞིའི་གཡུལ་ལས་རྣམ་རྒྱལ་ཀྱང་།",
    "བདག་ཅག་སྨོན་པའི་རེ་བ་བསྐང་བར་མཛོད།",
    "རེ་བའི་འབྲས་བུ་མྱུར་དུ་སྨིན་པ་དང་།",
    "འོན་ཀྱང་གདུལ་བྱའི་མོས་པའི་རྗེས་འགྲོ་བའི།",
    "གང་ཁྱོད་དག་པའི་དགའ་བ་བརྒྱ་ལྡན་དུ།",
    "གངས་དཀར་ལང་ཚོ་གཞོན་ནུ་དགའ་བའི་དཔྱིད།",
    "ཐོན་མི་གཉིས་པའི་སྙན་པ་ཁྱོད་ཀྱིས་བཟུང་།",
    "ཡིད་འོང་ཕྱོགས་ཀྱི་བུ་མོའི་འགྲམ་པར་ཆགས།",
    "ཆེ་དགུའི་གཙུག་གི་རྒྱན་དུ་ཅི་ཡང་བརྗིད།",
    "དྲི་བྲལ་ལང་ཚོ་རྫོགས་པའི་མཚར་སྡུག་སྐུ།",
    "མཚན་དཔེའི་ལང་ཚོའི་མྱུ་གུ་ཆེར་ཕྲ་ཡང་།",
    "གང་གང་མོས་པའི་རྗེས་འགྲོའི་གསུང་གི་དབྱངས།",
    "ཕྱག་རྗེས་རླབས་ཀྱི་རི་མོའི་གཟི་དཔལ་འབར།",
    "བྷོ་ཊའི་དཀྱིལ་འཁོར་ཁྱོན་ལ་ཡོངས་བཅིངས་པས།",
    "རྗེས་དྲན་དཔལ་དུ་དབྱངས་ལྡན་ངག་གིས་སྤེལ།",
    "ཀུན་ཕན་སྣང་བ་ཕྱོགས་ཀྱི་བུ་མོའི་རྒྱན།",
    "གངས་རིའི་ལང་ཚོ་དར་མའི་སྟོབས་ཀྱི་ཕུལ།",
    "རྣམ་འདྲེན་སྟོང་ལས་པད་དཀར་ལྟར་བསྔགས་ཤཱཀྱ་སེང་གེ་གཙུག་གིས་མཆོད།",
    "མི་ཕམ་དབྱངས་ཀྱི་རོལ་མོ་ས་གསུམ་དུ།",
    "ཡེ་ཤེས་སྒྱུ་མའི་ལང་ཚོར་སྨིན་པའི་སྐུ།",
    "ཉོན་མོངས་དགྲ་ཚོགས་བཅོམ་པའི་དཔའ་བོ་ཆེ།",
    "འདྲེན་པ་གང་དེའི་རི་མོ་གསུམ་པའི་ལམ།",
    "སྲིད་གསུམ་ཡངས་པའི་ཁྱོན་ལ་ཅི་ཡང་བསྒྱུར།",
    "རྣམ་དཀར་འཛིན་མའི་ཁྱོན་ལ་ལེགས་དྲངས་པའི།",
    "དུས་མཐར་ཐུབ་པའི་ལུང་གི་བསྟན་པ་བསྐལ་བའི་ཡང་མཐར་སྐྱོང་གྱུར་ཅིག།",
    "ཞི་ལྷག་ཏིང་འཛིན་མཆོག་གི་མེ་ཏོག་ཤིན་སྦྱང་བདེ་བའི་དཔལ་དུ་མཛེས།",
    "རྒྱལ་ཀུན་ཡེ་ཤེས་མཆོག་གི་སྒྱུ་འཕྲུལ་གང་འདུལ་འགྲོ་ལ་དེར་སྟོན་པའི།",
    "མ་རིག་གིས་བསྐྱོད་ལས་ཉོན་འཕྲུལ་འཁོར་གྱིས།",
    "བདག་མེད་གནས་ལུགས་ཟབ་མོ་རྟོགས་གྱུར་ཅིག།",
    "ཁོང་གི་བཀའ་ཡི་མེ་ཏོག་རྨོངས་པའི་སྤྱི་བོར་བབས་པ་ལ་བརྟེན་ནས་༡༩༨༧ལོའི་ཟླ་༡ཚེས་༣ལ་དམ་པ་གང་གི་ཞབས་གྲས་ཀྱི་ཐ་ཤལ་བསེ་ཚང་བློ་བཟང་དཔལ་ལྡན་ནས་འཕྲལ་དུ་བྲིས་ནས་ཕུལ་པ་ལགས་སོ།",
    "གསུང་རྩོམ་ཐོར་བུའི་སྐོར། ། ཀྲུང་གོའི་བོད་བརྒྱུད་མཐོ་རིམ་ནང་བསྟན་སློབ་གླིང་གི་དཔེ་དེབ་གང་ཡོད་ཀྱི་མཇུག་ཏུ་འགོད་རྒྱུའི་པར་བྱང་སྨོན་ཚིགབློ་ཆེན་མཁྱེན་རབ་བཟང་བོའི་དཀྱིལ་འཁོར་རྒྱས།",
    "ལུགས་གཉིས་གཤོག་ཡངས་དཀར་བོའི་འཕུར་ལྡིང་གིས།",
    "བཀོད་པའི་གྲགས་སྙན་ལྷ་ཡི་རོལ་མོའི་དབྱངས།",
    "ཕྱོགས་ཀྱི་བུ་མོའི་རྣ་བའི་བདུད་རྩིའི་དཔལ།",
    "འབུམ་ཕྲག་ཤེས་བྱའི་རི་མོའི་དཀྱིལ་འཁོར་ལ།",
    "གཟུར་གནས་མཁས་དགུའི་གཟིགས་མོར་སྤྲོས་འདིས་དགེས།",
    "ཕྲ་རགས་འབྲེལ་ཐོགས་སྐྱེ་བོ་གང་དག་གི།",
    "མགོན་ཁྱོད་རིགས་ལྡན་དྲག་པོའི་སྐུར་བཞེངས་ཚེ།",
    "གསུང་རྩོམ་ཐོར་བུའི་སྐོར། ། སྐུ་འབུམ་དགོན་དུ་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་བློས་བསླངས་གསར་བཞེང་གྲུབ་པའི་དཀར་ཆག་གི་མགོ་མཇུག་རྒྱན་ཚིགའཇིགས་མེད་སྟོབས་བཅུ་མངའ་བའི་དམ་བཅའི་ཁུར།",
    "མཁྱེན་བཟང་པད་མོའི་སྦུབས་སུ་ཡོངས་རྫོགས་པའི།",
    "མི་འགྱུར་བདེ་སྟོང་མཆོག་གིས་རབ་མྱོས་པ།",
    "སྐུ་འབུམ་དགོན་དུ་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་བློས་བསླངས་གསར་བཞེངས་གྲུབ་པའི་དཀར་ཆག་གི་མགོ་མཇུག་དུ་སྦྱོར་རྒྱུ་ཞིག་མྱུར་མོར་འབྲི་དགོས་པའི་བཀའ་ལུང་བསྩལ་བ་ལ་བརྟེན་ནས་ཀུན་གཟིགས་ཐམས་ཅད་མཁྱེན་པའི་ཞབས་འབྲང་ཐ་ཤལ་བ་བསེ་བློ་བཟང་དཔལ་ལྡན་མིང་ཅན་ནས།",
    "ངོ་མཚར་བྲིས་ཐང་མིག་གི་བདུད་རྩིའི་དཔྱིད།",
    "རྣམ་འདྲེན་ཤཱཀྱ་སེང་གེ་གཙུག་གིས་མཆོད།",
    "རང་རུས་གདུང་ཞེན་ཟབ་མོས་གླུ་འདི་ཐལ།",
    "འོན་ཀྱང་འདྲ་མིན་ངག་གི་འཇའ་ཚོན་རིས།",
    "ཁུངས་ལྡན་ལུང་གི་རྒྱུན་ལས་ལེགས་དྲངས་པའི།",
    "ཐུགས་རྗེ་དགོངས་ཡངས་ཟབ་མོས་དགྱེས་བཞེས་ཞུ།",
    "པར་བྱུང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར། ། རྗེ་ཚེ་ཏན་ཞབས་དྲུང་ཚང་གི་ཞལ་རྩོམ་གཅེས།",
    "སྙིགས་ལྔའི་ལས་ཀྱི་རི་མོ་ཆེས་ཆེར་གསལ་བའི་དུས་མཐར།",
    "རིན་ཐང་གཞལ་མཐའ་མེད་པའི་ཁ་བ་ཅན་གྱི་ཐུན་མོང་མ་ཡིན་པའི་རིག་པའི་གནས་ལྔའི་བང་མཛོད།",
    "ཤེས་ལྡན་མི་སྣ་བསྐྱེད་བསྲིང་བྱེད་པ་སོགས་ཀྱི་ཆེད་རྨད་དུ་བྱུང་བའི་ཕྱག་རྗེས་རྡོ་ལ་རི་མོ་བྲིས་པ་ལྟ་བུ་མིག་མཐོང་ལག་ཟིན་དུ་ཡོད་པ་འདི་ལ།",
    "གང་ཁྱོད་དག་པའི་དགའ་བ་བརྒྱ་ལྡན་དུ།",
    "གངས་དཀར་ལང་ཚོ་གཞོན་ནུ་དགའ་བའི་དཔྱིད།",
    "ཐོན་མི་གཉིས་པའི་སྙན་པ་ཁྱོད་ཀྱིས་བཟུང་།",
    "ཡིད་འོང་ཕྱོགས་ཀྱི་བུ་མོའི་འགྲམ་པར་ཆགས།",
    "ཆེ་དགུའི་གཙུག་གི་རྒྱན་དུ་ཅི་ཡང་བརྗིད།",
    "སྣང་བརྙན་སྐལ་བཟང་མིག་གི་བདུད་རྩི་གང་།",
    "སྐྱབས་མགོན་ཀུན་མཁྱེན་མཆོག་གི་བརྩེ་གཟིགས་ཀྱིས།",
    "ཅེས་པ་འདི་ནི་ཐུབ་བསྟན་ཡོངས་ཀྱི་མངའ་བདག་ཀུན་མཁྱེན་ཆེན་མོ་འཇམ་དབྱངས་བཞད་པ་དྲུག་པ་མཆོག་གི་བརྩེ་གཟིགས་ཆེན་པོས་མགར་རྩེ་གདན་རབས་དང་བཅས་པའི་འཇམ་དབྱངས་ཀུན་གཟིགས་ལྷ་ཁང་ཆེན་མོའི་དཀར་ཆར་འདི་པར་དུ་བསྐྲུན་སྐབས་ཀྱི་མཐུན་རྐྱེན་ཡོངས་སུ་རྫོགས་པ་བཀའ་དྲིན་བསྩལ་ཏེ།",
    "ཞེས་ཨ་ལགས་མ་ཎི་བའི་ཐུགས་འདོད་ལྟར་ཁོའི་མཆོད་ཁང་གི་སྒོར་འབྲི་རྒྱུ་ལ་༧བསེ་སྐྱེས་མིང་བས་༡༩༩༢ལོའི་ཟླ་༥པའི་ཚེས་༩ལ་ཟི་ལིང་ནས་བྲིས། ། དཔར་ཤིང་སྨོན་ཚིག།",
    "སོར་མོས་འདུ་བྱེད་བཀོད་པའི་རྡོ་རྗེ་སོགས།",
    "བདེ་ལེགས་སྐུ་བརྙན་མཐོང་ཐོས་དྲན་རེག་གི།",
    "༡༩༩༣ལོའི་ཟླ་༧ཚེས་༢ ལ་པེ་ཅིན་ནས་བྲིས་པ་ཛཡནྟུ། ། ཁ་སོ་ཚང་གི་དཔར་ཁང་གི་མཚན་འདོགས།",
    "གསུང་གསང་ཟབ་མོའི་སྣོད་དུ་འགྱུར་བར་ཤོག།",
    "མཆོག་གྱུར་སྤྲུལ་བའི་ལོ་པཎ་ཕྱག་གི་ཡུལ།",
    "གང་འདུལ་མོས་པའི་རྗེས་འགྲོ་ནམ་མཁའི་ཁམས།",
    "ཕྱེ་བས་ཆེ་དགུའི་གཙུག་གི་རྒྱན་གྱུར་པ།",
    "གསུང་གི་བཀོད་པ་རེར་ཡང་ཆེས་བརླིང་བའི།",
    "མ་འདྲེས་རི་མོར་དངོས་སུ་འཕོས་པའི་བརྙན།",
    "གངས་རིའི་ལང་ཚོ་དར་མའི་རྒྱན་དུ་ངོམས།",
    "མཐའ་དག་འཇིག་རྟེན་སྲིད་པའི་མིག་སྟོང་གི།",
    "གཟིགས་མོའི་ཞལ་ཐང་མཛེས་སྡུག་སྒེག་པ་མོས།",
    "རྒྱ་མཚོའི་ཁྱོན་ཀུན་འགེངས་པའི་མཚར་སྡུག་ལ།",
    "གཟུགས་བརྙན་རི་མོར་འཕེལ་བའི་ཞལ་ཐང་ཆེ།",
    "ཡ་མཚན་མིག་གི་བདུད་རྩིའི་དཔལ་འཛིན་པ།",
    "གྲགས་པ་གཡས་འཁྱིལ་དུང་གི་སྙན་པ་ཡིས།",
    "མཛེས་མཛེས་གླིང་ལྔའི་ཁྱོན་ལ་ཁྱབ་པར་ཤོག།",
    "བདེ་སྐྱིད་ཀུན་དགའ་གསར་བའི་ལང་ཚོ་ཅན།",
    "རྫོགས་ལྡན་དཔྱིད་ཀྱི་རྒྱལ་མོ་སྡུག་གུ་མ།",
    "སོར་མོས་འདུ་བྱེད་བཀོད་པའི་རྡོ་རྗེ་སོགས།",
    "པར་རྐོ་རྡོ་རྗེ་གཉིས་ཀྱི་འདོད་མོས་བཞིན།",
    "བཅུ་དྲུག་ལང་ཚོ་རྒྱས་པའི་གཞོན་ལུས་པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "རྒྱལ་ཀུན་གསང་བ་གསུང་གི་བདག་པོའི་ལྷས།",
    "གང་འདོད་མོས་པའི་འདབ་སྟོང་འཛུམ་གྲོལ་ཏེ།",
    "སྟོང་བའི་ངང་ལས་བསང་རྫས་རྣམ་གྱི་རང་རང་གི་མིང་ཡིག་དང་བོ་སྨིག་ཡེ་བརྒྱན་པ་ཞུ་བ་ལས་ཕུང་བས།",
    "སྔགས་དྲུག་དང་ཕྱག་རྒྱ་དྲུག་གིས་བྱིན་གྱིས་བརླབས།",
    "ཨོཾ་སརྦ་པཱིབ་བདག་གི་བསམ་པས་འབྱུང་གྱུར་ཅིག།",
    "མོ་རབ་མཛེས་མར་གད་ལྷུན་པོ་ལ།",
    "གདངས་སྙན་རོལ་མོའི་སྒྲ་དབྱངས་བཅས།",
    "ཁྱོད་ལ་གཏད་དོ་མཐུ་མ་ཆུང་།",
    "ཡཁ་གསུང་རྩོམ་ཐོར་བུའི་སྐོར། ། མཚོ་བྲག་གི་བསང་ཡིགཀྱི།",
    "ཁྱད་པར་ཡུལ་ཕྱོགས་འདིར་གནས་བདག་ཅག་གི།",
