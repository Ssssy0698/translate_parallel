    "འཕྲིན་ལས་གཉེར་དུ་གཏད་པས་བདག་ཅག་གི།",
    "ཡུལ་སྐྱོང་དགྲ་ལྷ་ཆེན་མོ་གཉན་དམར་ཞེས།",
    "ཡུལ་སྐྱོང་དགྲ་ལྷ་ཆེན་མོ་མཐུ་རྩལ་ཅན།",
    "ཐལ་བར་རློག་པའི་དྲག་པོའི་འཕྲིན་ལས་སྒྲུབས།",
    "ལྷ་ཁྱོད་ཡུལ་ལྷར་མཆོད་ཀྱིས་སྐྱབས་མ་ཞན།",
    "བདེ་སྐྱིད་ལྷུན་གྲུབ་མོས་དོན་འཕྲིན་ལས་བཞི།",
    "སྒྲུབ་པའི་དཔའ་བོར་ལྷ་ཁྱོད་མངའ་གསོལ་གྱིས།",
    "རོང་འབྲོག་ཚོ་ལྔའི་ཡ་གྱལ་ཐེའུ་བུའི་སེར་སྐྱ་རྣམས་ཀྱི་འདོད་མོས་བཞིན།",
    "གསུང་རྩོམ་ཐོར་བུའི་སྐོར། ། ཞོལ་འཕོང་ཕྱེ་དྲའི་ཡུལ་ལྷ་ཀེ་མིང་གི་བསང་མཆོད།",
    "ལྷ་ཁྱོད་དད་པས་སྤྱན་འདྲེན་ན།",
    "ཁྱོད་ལ་ཉེར་གཏད་སྲུང་སྐྱོབ་མཛོད།",
    "ཅེས་གཞི་བདག་ཀེ་མིང་གི་བསང་མཆོད་འདི་ནི།",
    "མཛེས་མཛེས་དགའ་བ་འབུམ་བསྐྱེད་ནོར་འཛིན་ཁྱོན།",
    "ལེགས་ལེགས་ཏང་གི་རྗེས་སུ་བརྟན་པོར་འབྲང་།",
    "མཛེས་པ་འབུམ་ལྡན་ཀན་ལྷོའི་འཛིན་མའི་ཁྱོན།",
    "ཁྱོན་ཀུན་ཁྱབ་པའི་དགའ་སྤྲོའི་གླུ་དབྱངས་ཆེ།",
    "འདི་ནི་བྲེལ་འཚུབ་ངང་བྲིས་པ་ལགས་པས་ཚིག་ཧ་ཅང་འབྱོང་བདེ་མོ་ཞིག་མ་བྱུང་བ་ལ།",
    "མངོན་བཀྲ་གངས་ལྗོངས་བྱང་གི་གཞིར།",
    "ཉ་མོ་ཆུ་ལ་རོལ་བཞིན་མཆིས།",
    "ཝ་མོ་བཞིན་དུ་རིག་པ་སྒྲིམ།",
    "ཨ་ཕའི་ཡུལ་འདི་མ་བརྗེད་པར།",
    "མྱུར་དུ་སྤྲོ་བའི་རེ་བ་དོན་ཡོད་མཛོད།",
    "ཡི་གེ་འདི་ནི་ཁོང་གི་ཞབས་ཕྱིའི་གཙོ་གྲས་གཞུང་དྲང་གཤིས་བཟང་གིས་སྲི་ཞུ་དང་དུ་ལེན་པའི་རྒྱུན་རིང་སྐུ་བཅར་བ་དཔལ་ལྡན་བཀྲ་ཤིས་ལ་བསྩལ་པ་ལགས་སོ།",
    "ལུང་རྟོགས་ནོར་བུའི་ཏོག་གི་འོད་མཛེས་པ།",
    "དགའ་བའི་གཤོག་ཟུང་སྐྱོད་པའི་ཉམས་སྟོང་གིས།",
    "བདེན་གཏམ་ངག་གི་རོལ་མོ་འབུམ་དུ་གྲགས།",
    "ཕན་བདེ་ཟླ་བ་སྟོང་གི་འཛུམ་རིས་ཅན།",
    "ལྷག་བསམ་མེ་ཏོག་སྟོང་གི་འཛུམ་གྲོལ་བས།",
    "ཧ་ཧ་རང་མགོ་རང་གིས་མི་ཐོན་པར།",
    "ངོ་ཚ་ཁྲེལ་མེད་བདག་གི་སྤྱོད་པ་འདི།",
    "ལས་ཀྱི་འབྲས་བུ་རང་གིས་མྱོང་བ་དང་།",
    "ག་ནས་བསྡད་ཀྱང་འཇིག་རྟེན་ཟང་ཟིང་གིས།",
    "ང་ཡི་མི་ཚེ་སྐྱེལ་འདིར་ཡིད་རེ་སྐྱོ།",
    "ཝ་མོ་ལྟ་བུར་འཕྱ་ཞིང་ཀུན་གྱིས་དམོད།",
    "དགྱེས་པའི་ཚིག་གིས་ཐུགས་དམ་བསྐང་གྱུར་ཅིག།",
    "ཁྱོད་ལ་བཀྲ་ཤིས་ང་ལ་བཀྲ་ཤིས་པའི།",
    "བཀྲ་ཤིས་ཚིག་གིས་ཀུན་ལ་བཀྲ་ཤིས་ཤོག།",
    "བསེ་རུའི་མིང་ཅན་ཞིག་གིས་ཕུལ་བ་དགེ།",
    "ཉི་གཞོན་གཅིག་གིས་འཛམ་གླིང་མཛེས།",
    "སྨྲ་མང་འབྲུག་གི་སྟོང་སྒྲ་ཡིན།",
    "རང་དོན་རང་གིས་སྒྲུབ་པ་མང་།",
    "ཀུན་གྱི་མིག་གི་བདུད་རྩིར་འགྱུར།",
    "ཀུན་གྱི་མིག་གི་ཚེར་མར་འགྱུར།",
    "ཉ་མོ་རྒྱ་ལས་མི་ཐར་བས།",
    "གསེར་གྱི་རྒྱན་ལ་མི་རེ་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "མ་འཕྲུལ་བློ་ཡིས་བཙལ་ཀྱང་རྙེད་རེ་སྐན།",
    "ཞྭ་ཟུར་གྱོན་པའི་ཤ་ཟ་ཧོར་མོ་ཚོས།",
    "ཧ་ཅང་གོ་ས་མཐོ་ན་ཨ་མ་བརྗེད།",
    "ཧ་ཧེ་ཀུ་རེ་ཚིག་གིས་གཞན་འཛེར་ཀྱང་།",
    "རིགས་བརྒྱ་མཐུན་ན་རིག་པའི་སྒོ་མོ་འབྱེད།",
    "ཞོ་ཀྲང་ཚོན་པོ་ཧུའུ་ཅིས་སྐམ་པོ་གཉིས།",
    "གཡག་རྭ་ལྟ་བུ་མ་མཛད་མོའུ་འགལ་བུ།",
    "གཞུ་མོ་ལྟ་བུ་མ་མཛད་ཀུན་དགའ་བོ།",
    "རི་དྭགས་ལྟ་བུ་མཛོད་ཅིག་ཨ་མའི་བུ།",
    "སྐབས་རེར་འོན་རྫུན་བྱེད་ན་ཅིས་མི་བཟང་།",
    "སྐབས་རེར་ལོང་རྫུ་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "ཚོད་རེ་བཟུང་ན་འཇིག་རྟེན་ལུགས་དང་མཐུན།",
    "མཱ་ལེ་དྭངས་གཙང་པདྨའི་རེག་བྱ་གཉིས།",
    "སློབ་ཚོགས་པད་མོའི་གཉེན་དུ་འབུམ་བཀྱེས་པས།",
    "རེ་འབྲས་དྲི་བསུང་ཕྱོགས་བཅུར་ཁྱབ་པར་ཤོག།",
    "བློ་བཟང་དཔལ་ལྡན་ངག་ལས་ཐལ།",
    "ཀུ་རེ། ། འཇམ་པའི་དབྱངས་ཀྱིས་བྱམས་པས་སྐྱོང་།",
    "སྐྱེམས་ལ་མ་རེ་འདོད་དོན་སྒྲུབས།",
    "འབོ་རའི་ཐང་གི་སྒོམ་ཆེན་གྱིས།",
    "འཕགས་མ་སྒྲོལ་མ་ཉེར་གཅིག་གིས།",
    "བ་སྤུ་བཞིན་དུ་འདོར་བ་ཡིད་རེ་མུག།",
    "ཧ་ཅང་གོ་ས་མཐོ་ན་ཨ་མ་བརྗེད།",
    "རེ་ཚིག་གིས་འཛེར་ན་ཡང་།",
    "རང་རིགས་རང་གིས་དགྲར་འཛིན་བྱེད་པ་མཚང་།",
    "རིགས་བརྒྱ་མཐུན་ན་རིག་པའི་སྒོ་མོ་འབྱེད།",
    "ཞོ་ཀྲང་ཚོན་པོ་ཧུའུ་ཅི་སྐམ་པོ་གཉིས།",
    "རི་དྭགས་ལྟ་བུ་མཛོད་ཅིག་ཨ་མའི་བུ།",
    "སྐབས་རེར་འོན་རྫུ་བྱེད་ན་ཅིས་མི་བཟང་།",
    "ཚོད་རེ་བཟུང་ན་འཇིག་རྟེན་ལུགས་དང་མཐུན།",
    "མ་ལེ་དྭངས་གཙང་པདྨོ་རེག་བྱ་གཉིས།",
    "དལ་རྟེན་ཚང་བའི་བཙུན་པ་གང་གིས་ཞུ།",
    "དུས་འདིར་བྱོན་པའི་དུས་ཀྱི་སྟོན་པ་ཁྱོད།",
    "རྡོ་རྗེ་གསུང་གིས་རྡོ་རྗེ་གླུ་དབྱངས་ལེན།",
    "བདག་ལ་ཞེན་པས་དུག་གསུམ་ཉིན་རེར་འཕེལ།",
    "སྐལ་ལྡན་རས་པས་སྐལ་བཟང་རེ་སྐོང་བས།",
    "ལྷ་མིའི་མགོན་དུ་ལྷ་ཡི་ལུང་གིས་བསྔགས།",
    "ལྷར་བཅས་འགྲོ་བའི་གཙུག་གིས་མཆོད།",
    "རིགས་ཀྱི་གཙོ་བོར་རིགས་བདག་གི།",
    "ཅོད་པན་སྲོག་ཞུར་མཛེས་མོད་ཀྱི།",
    "ལྷ་ཡི་གཙུག་གི་རྒྱུན་དུ་བཞག།",
    "རྣམ་ཐོས་སྲས་ཀྱི་མཛོད་ལ་རེ།",
    "རེ་བའི་རྐང་དྲུག་གཞོན་ནུའི་ཁྱུ།",
    "དོན་དམ་སྨྲ་བ་ཉིན་མོའི་སྐར།",
    "ཐབས་མཁས་ཁྱོད་ཀྱིས་ཐབས་རྩལ་སྣ་ཚོགས་ལས།"
  ]
}