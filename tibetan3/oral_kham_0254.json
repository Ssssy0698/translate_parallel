    "ཤར་ཕྱོགས་རྒྱ་སྟག་ཙ་ན་ནགས་ན་ཡིབས།",
    "བྲིས་པས་ཚར་ས་དང་མི་འདུག།",
    "མ་ལྷག་མ་ཆད་ཁྱབ་སྒྲག་བྱེད་ཐུབ་འདུག།",
    "ང་རང་འདོད་པའི་ལམ་ལ་ང་རང་འགྲོ།",
    "ང་རང་འདོད་པའི་བདེ་བ་བསྒྲུབ་པའི་སླད།",
    "ང་རང་ཟུར་དུ་འགྲོ་བའི་བཀྲ་ཤིས་ཐོག་མའི་མགོ་བོ་དེ་ནས་ཚུགས།",
    "དེ་སླད་གནས་དེར་སྡོད་འདོད་མི་འདུག་མདུན་སྐྱོད་གོམ་ཁ་ལྷོ་ལ་བསྒྱུར།",
    "རང་རང་ལས་ཀྱི་བགོ་སྐལ་ཡིན་ཕྱིན་ཕ་མས་ཐུགས་ཁྲལ་གནང་དོན་མེད།",
    "གངས་ཅན་ལོ་ཙཱ་བེ་རོ་ཙ་ན་མཆོག།",
    "རྟོག་གེ་འབུམ་གྱིས་སྡང་ཡང་འགྱོད་པ་དེ་མི་འདུག།",
    "གནའ་མི་རྒན་པོ་ཁྲོས་ཀྱང་འགྱོད་པ་དེ་མི་འདུག།",
    "མི་རྒན་བརྒྱ་ཕྲག་ཁྲོས་ཀྱང་འགྱོད་པ་དེ་མི་འདུག།",
    "རྒན་རབས་ཀུན་གྱིས་སྡིགས་ཀྱང་འགྱོད་པ་དེ་མི་འདུག།",
    "༡༣༧ དྲུང་ཆེན་གཏིང་ནས་ཁྲོས་ཀྱང་འགྱོད་པ་དེ་མི་འདུག།",
    "རྒྱུན་ལས་དགོངས་པ་འཁྲུགས་ཀྱང་འགྱོད་པ་དེ་མི་འདུག།",
    "སྤྲང་རྒན་བེ་སྨྱོན་འགྱོད་པ་སྐྱེ་དོན་ཞིག་མི་འདུག།",
    "སྨྱོན་པའི་བཟི་གཏམ་འགོག་ཐབས་མི་འདུག་པས།",
    "ག་ས་ག་ལ་འདུག་ཀྱང་།",
    "རང་ཡུལ་མ་གཏོགས་མི་འདུག།",
