    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "རེག་པ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་སྒྲིབ་པ་གཉིས་རྣམ་པར་བྱང་བའོ།",
    "གཟུགས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "འདུ་ཤེས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "འདུ་བྱེད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མིག་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣ་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྣ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལྕེ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལུས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་ཉི་མ་དགུ་ཤར།",
    "ཡིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "གཟུགས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྒྲ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "དྲི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རོ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རེག་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བོན་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་འས་ལ་གནས་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མེའི་ཁམས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སའི་ཁམས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ནམ་མཁའི་ཁམས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མ་རིག་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "འདུ་བྱེད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མིང་དང་གཟུགས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྐྱེ་མཆེད་དྲུག་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རེག་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཚོར་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྲེད་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལེན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྲིད་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྐྱེ་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྒ་ཤི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཕྱི་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ནང་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རང་བཞིན་མེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་བཞི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "གཤེན་རབ་ཀྱི་ལམ་བཞི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མི་འཇིགས་པའི་སྟོབས་རྣམས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཕྱིར་མི་ལྡོག་པའི་འབྲས་བུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ལན་གཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཡང་དག་པའི་རིག་པ་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "ཡེ་ཤེས་ཆེན་པོ་ལྔ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སོ་སོ་ཡང་དག་པའི་རིག་པ་བཞི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མི་བསྙེལ་བའི་གཟུངས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མཚན་མ་མེད་པ་སྙོམས་པར་འཇུག་པ་བཞི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྒྱུན་དུ་གནས་པའི་ཐུགས་རྗེ་བཞི་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྟོགས་པ་ཆེན་པོའི་ལྟ་བ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བསྲུང་དུ་མེད་པའི་དམ་ཚིག་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "པའི་ཕྲིན་ལས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "འགྱུར་བ་མེད་པའི་སྐུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རང་བཞིན་མེད་པའི་གསུང་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "མཉམ་ཉིད་འཁྲུལ་པ་མེད་པའི་ཐུགས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སྐྱེ་བ་མེད་པ་གཡུང་དྲུང་གི་ས་ལ་གནས་པའོ།",
    "རེག་བདེ་བའི་ཞིང་ཁམས་ཡངས་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་བདེ་བའི་ཞིང་ཁམས་ཡངས་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བའི་ཞིང་ཁམས་ཡངས་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བའི་ཞིང་ཁམས་ཡངས་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བའི་ཞིང་ཁམས་ཡངས་པའོ།",
