    "དེ་ཉིད་ཀྱི་ཕྱིར་སློབ་དཔོན་གྱིས་བ་ལང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲ་དག་ལ་རིགས་ཀྱིས་སྤྱོཁྱད་པར་དུ་བྱས་པའི་དོན་བརྗོད་པ་ཡིན་ནོ་ཞེས་གང་བརྗོད་པའི་ཚིག་འདི་འབྲས་བུ་དང་བཅས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པས་རྟོགས་པ་གྲུབ་པ་མཇུག་སྡུད་པར་བྱེད་དོ།",
    "ཞེས་བྱ་བ་ནི་བྱས་ཞེས་བྱ་བ་དང་འབྱེལ་ཏོ།",
    "ཁྱད་པར་ནི་རིགས་ལ་སོགས་པའོ།",
    "རྗོད་པར་བྱེད་པ་ནི་མིང་ངོ།",
    "ཐ་མི་དད་པར་ཉེ་བར་བརྟགས་པ་ནི་མཚོན་པ་སྟེ།",
    "གང་ལ་ཐ་དད་དུ་འཛིན་པ་འདིའི་བ་ལང་ཉིད་འདིའི་ཞེས་བྱ་བ་འདི་ལ་ཡང་རྟོག་པར་འདོད་པ་ཁོ་ནའོ།",
    "ཐ་དད་ཁྱད་པར་དེ་ལྡོག་པ།",
    "དེའི་རྗོད་པར་བྱེད་པ་ཡིན་གྱི་རིགས་ལ་སོགས་པ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཐ་མི་དད་པ་བཏགས་པ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "བྲལ་བའི་དོན་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་དོན་ཡིན་ནོ་སྙམ་དུ་བསམས་ནས་བྷ་ཏྲེ་དང་བྷ་ར་དྷྭ་ཛ་ལ་སོགས་པ་གཞན་ཀླན་ཀ་བྱེད་དོ་ཞེས་གྲགས་ཏེ།",
    "དེའི་བདག་ཉིད་དགག་པ་ཞེས་བྱ་བ་ནི་གང་ལ་རྟོག་པ་འདི་མེད་པ་དེ་ནི་མངོན་སུམ་ཡིན་ནོ་ཞེས་བྱ་བའི་གཞུང་འདིས་མཚན་ཉིད་མཛད་པ་དེའི་བདག་ཉིད་འགེགས་པར་མཛད་པ་ཡིན་ནོ།",
    "རྟོག་པ་དང་བྲལ་བའི་དོན་བརྗོད་པར་བྱ་བ་མ་རྗོཡིན་པའི་དོན་དུ་བརྗོད་པ་ནི་མ་ཡིན་ནོ།",
    "འདི་སྙམ་དུ་གཞན་ལ་སྤངས་པའི་རྣམ་པར་རྟོག་པས་འདི་ཉིད་མདུན་ན་གནས་པ་སྔོན་པོ་ལ་སོགས་པ་རྟོགས་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "རྣམ་པར་རྟོག་པ་འདི་ཉིད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྒོས་ཏེ།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པ་དེ་ཉིད་དོན་དེ་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེའི་ཚེ་འདས་པ་ལ་སོགས་པ་དོན་རྗོད་པར་བྱེད་པ་འགགས་པས་སྔོན་པོ་ལ་སོགས་པ་དེ་ཉིད་མིང་དང་སྦྱོར་བར་བྱེད་དེ།",
    "འདི་སྙམ་དུ་རྣམ་པར་རྟོག་པ་གཞན་ཉིད་དེའི་ཚེ་དོན་དེ་རྟོགས་པར་བྱེད་དོ་ཞེས་བྱ་བ་དེ་ལྟ་བུར་ཅིའི་ཕྱིར་ཤེས་པར་བྱེད་སྙམ་ན།",
    "གཉིས་ཞེས་བྱ་བ་ལ་རྣམ་པར་རྟོག་པར་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "རྣམ་རྟོག་ཅེས་བྱ་བ་ལ་སོགས་པས་མཇུག་སྡུད་པར་བྱེད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "གལ་ཏེ་རིམ་གྱིས་སྐྱེ་བ་ཡིན་ན་ཇི་ལྟར་དེ་ཅིག་ཅར་རིགས་པར་འགྱུར་ཞེ་ན།",
    "མགལ་མེ་བཞིན་དུ་མགྱོགས་པར་འབྱུང་།",
    "དཔེར་ན་མགལ་མེ་ལ་མྱུར་དུ་བསྐོར་བའི་ཕྱིར་ཅིག་ཅར་འཁོར་ལོའི་རྣམ་པར་ཤེས་ཏེ།",
    "འདི་ལྟར་གལ་ཏེ་ཉེས་པར་རིམ་གྱིས་རིག་པར་བྱ་བ་ཡིན་གྱི།",
    "རྣམ་པར་རྟོག་པ་ནི་རིག་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་སྐབས་ལ་གནོད་པ་མེད་དོ།",
    "དེ་ནི་བར་མེད་པར་གསལ་ཏེ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སླར་ཡང་གནོད་པར་བྱེད་པ་ཉིད་ཡོད་དོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "གོས་དང་རྒྱན་སྦྱིན་པ་ལ་སོགས་པ་སེམས་པར་བྱེད་དེ།",
    "དེ་ལྟ་ཡིན་དང་མཚོ་དང་རོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲ་ཐོས་པ་ན་ཐོས་པ་ཐ་དད་པའི་རྟོག་པ་ཐ་དད་པར་མི་འགྱུར་རོ།",
    "རིམ་གྱིས་ངེས་པར་མི་འགྱུར་ཏེ།",
    "བློ་ཐམས་ཅད་སྐད་ཅིག་མ་ཉིད་ཀྱིས་ཡུན་རིང་དུ་མི་གནས་པའི་ཕྱིར་མགྱོགས་པར་འཇུག་པ་ཡོད་པས་དོན་འགའ་ཡང་རིམ་པ་དང་ལྡན་པར་རྟོགས་པར་མི་འགྱུར་རོ།",
    "གང་ཡང་མགལ་མེ་བཞིན་ནོ་ཞེས་བྱ་བའི་དཔེ་འདི་ནི་བསྒྲུབ་བྱས་སྟོང་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "རྣམ་པར་རྟོག་པའི་རྗེས་སུ་འབྱེལ་པ་ལ་གསལ་བར་སྣང་བ་ཉིད་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དཔེ་བསྒྲུབ་བྱས་སྟོང་པ་ཡིན་ནོ།",
    "ད་ནི་རྗེས་སུ་དཔག་པས་སྒྲུབ་པར་བྱེད་པ་ནི།",
    "རིགས་ལ་སོགས་པ་བཀག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "གལ་ཏེ་རིགས་ཐ་དད་དུ་མ་བཅད་པ་དེ་ལྟ་ན་ཡང་ཅིའི་ཕྱིར་ཁྱད་པར་དུ་མི་འགྱུར་ཞེ་ན།",
    "དེ་ལྟར་ཁྱད་པར་ཡོད་མ་ཡིན།",
    "དེ་ལྟ་བས་ན་ཁྱད་པར་ཁྱད་པར་ཅན་གྱི་དོན་འཛིན་པ་ཡོད་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་མ་གྲུབ་པ་ཉིད་མ་ཡིན་ནོ།",
    "སྒྲའི་རང་བཞིན་ཉིད་ཁྱད་པར་དུ་འགྱུར་བ་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "སྒྲ་སྦྱར་བ་མེད་པའི་རྣམ་པར་རྟོག་པ་ཡང་མེད་དེ།",
    "དེ་ལྟ་བས་ན་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་དངོས་པོ་ནི་སྒོ་བཏགས་པ་ཉིད་ཡིན་གྱི།",
    "དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་བརྡ་འདི་ཡུལ་དུ་བྱས་པ་མ་ཡིན་ནམ་ཡུལ་དུ་མ་བྱས་པ་ཡིན་ལ།",
    "དེ་ལ་སྦྱོར་བ་ནི་གང་ཞིག་གང་ལ་བརྡ་མ་བཟུང་བ་དེ་ནི་དེ་ལ་རྟོག་པ་དང་བཅས་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པའོརྐ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་གཅེར་བུ་པ་ལེགས་པའི་བློ་གྲོས་ཀྱི་ལུགས་ཀྱིས་གཏན་ཚིགས་དང་པོ་མ་གྲུབ་པར་རྟོགས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ནི་དངོས་པོ་ཐམས་ཅད་སྤྱི་དང་ཁྱད་པར་གྱི་བདག་ཉིད་ཀྱིས་གཉི་གའི་ངོ་བོར་བརྗོད་ལ།",
    "ཁྱབ་པ་དུརྣམ་པར་ཆད་པ་ནི་དཔེར་ན་བ་ལང་ཉིད་ལ་སོགས་པ་བཞིན་ནོ།",
    "རྣམ་པར་མ་ཆད་པ་ནི་དཔེར་ན་ཡོད་པ་དང་དངོས་པོ་ཉིད་ལ་སོགས་པ་བཞིན་ནོ།",
    "བརྗོད་པར་འདོད་པའི་དོན་གཞན་གང་ཡིན་པ་དེ་ལས་རྣམ་པར་གཅད་པ་དེ་ལ་ཡོད་པ་མ་ཡིན་ནོ།",
    "བརྗོད་པར་འདོད་པའི་དོན་ལ་གནས་པའི་ངོ་བོ་གང་ཡིན་པ་སྟེ།",
    "རང་བཞིན་ཁྱད་པར་ཅན་གྱི་དོན་དེ་གལ་ཏེ་སྣེའཛིན་པར་འདོད་ན།",
    "དེའི་ཚེ་དོན་ཙམ་འཛིན་པར་འགྱུར་བ་ལས་རྗོདོན་ཙམ་གང་ཡིན་པ་དེ་ནི་དོན་གཞན་མི་སྲིད་པར་རང་བཞིན་དང་བྲལ་བ་དེ་ཉིད་འཛིན་པར་འགྱུར་བའམ།",
    "ཅི་སྟེ་དེ་ཡང་མི་འཛིན་པ་དེའི་ཚེ་འཛིན་པར་མི་འགྱུར།",
    "ལྡོག་པའི་མཚན་ཉིད་དུཀྱིས་བྱས་པའི་བུམ་པ་མེད་པའི་ངོ་བོས་གལ་ཏེ་བུམ་པ་དེ་མི་འཛིན་ན།",
    "དེ་བཞིན་དུ་ཁྱད་པར་མ་བཟུང་བའི་དཔེ་དོན་འདི་ལ་ཡང་དོན་ཙམ་འཛིན་པའམ་མི་འཛིན་པར་འགྱུར་ཞེས་བྱ་བར་ངེས་སོ།",
    "ཁྱད་པར་འགའ་ཡང་ཡོད་མ་ཡིན།",
    "གང་ཞིག་གཟུང་བར་བྱ་བ་དེ་ལ་ལྟོས་པ་མེད་པའི་ཁྱད་པར་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་འབྱེལ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དབྱེག་པ་དང་འབྲེལ་པ་མེད་པར་དེ་དང་ལྡན་པར་འགྱུར་བ་མ་ཡིན་པ་དེ་བཞིན་དུ་ཁྱད་པར་དང་འབྱེལ་པ་ཅན་ཡང་རིགས་པ་མ་ཡིན་ནོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་གང་ཞིག་ཁྱད་པར་དང་འབྱེལ་པ་འཛིན་པ་དེ་ནི་རྟོག་པ་དང་བཅས་པ་ཞེས་བྱའོ།",
    "སྦྱོར་བ་ནི་རྩོད་པའི་གཞིར་གྱུར་པའི་ཁྱད་པར་ཅན་གྱི་ཡུལ་ཅན་གྱི་ཤེས་པ་ནི་རྟོག་པ་དང་བཅས་པ་ཡིན་ཏེ།",
    "ཁྱད་པར་ཅན་གྱི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་འདི་བུམ་པའོ་སྙམ་པ་སོགས་པའི་ཤེས་པ་བཞིན་ནོ།",
    "རིགས་མཐུན་རིགས་མ་རྗོམཐུན་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "དེའི་ཕྱིར་འདིར་གལ་ཏེ་ཐ་དད་པའི་ཕྱིར་སྙེཁྱད་པར་དང་འབྱེལ་པ་ལས་ཁྱད་པར་ཅན་གྱི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་གཏན་ཚིགས་ཀྱི་དོན་ཡིན་ན།",
    "རིགས་མཐུན་པ་དང་རིགས་མི་མཐུན་པ་དག་ལས་ལྡོག་པའི་དོན་ཙམ་འཛིན་པས་ཁྱད་པར་གྱི་ཡུལ་ཅན་གྱི་ཤེས་པ་འཛིན་པར་འདོད་པ་དེ་ཁས་ལེན་པ་ཡིན་ནོ།",
    "འོ་ན་འདི་ནི་ཁྱད་པར་ཡིན་ནོ།",
    "འདི་ནི་ཁྱད་པར་ཅན་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཐ་སྙད་དང་ཐ་དད་པ་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "དངོས་པོ་ཉིད་ཁྱད་པར་གཞན་སྤངས་ནས་དེ་ཙམ་ཤེས་པར་འདོད་པ་ན་དེ་སྐད་ཅེས་བྱའོ།",
    "འདི་སྙམ་དུ་གལ་ཏེ་རིགས་མཐུན་པ་དང་རིགས་མི་མཐུན་པ་དག་ལས་ཐ་དད་པའི་དངོས་པོ་འཛིན་ན་འོ་ན་འཛིན་པ་ངེས་པར་རྟོགས་པ་དང་བཅས་པར་འགྱུར་ཏེ།",
    "འདིར་ཐ་དད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པར་འཇུག་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གཞན་གྱི་རྣམ་པས་འཇུག་པར་འགྱུར་ན།",
    "ཁྱད་པར་དོན་གཞན་དང་འབྲེལ་པ་མེད་པའི་ཕྱིར།",
    "ཁྱད་པར་གྱི་རྣམ་པར་བཅད་པའི་ངོ་བོ་དང་།",
    "རྣམ་པར་མ་བཅད་པའི་ངོ་བོའོ།",
    "དེ་ལ་རྣམ་པར་བཅད་པའི་ངོ་བོ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཤེས་པའི་གཟུང་བར་བྱ་བ་རྗོའདོད་དོ།",
    "འདི་དང་རྣམ་པར་རྟོག་པ་ནི་ཤེས་པས་གཟུང་བར་བྱ་བ་འདི་དང་མཚུངས་སོ།",
    "ཅི་དེ་ཁྱད་པར་ཉིད་ལས་ནི།",
    "དེ་ལྟ་ཡིན་དང་སྤྱི་འདི་ཁྱད་པར་ལས་ལྡོག་པར་འཛིན་པའི་ཤེས་པ་རྟོག་པ་དང་བཅས་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་གྱི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕྱིས་གཏན་ཚིགས་མ་ངེས་པ་ཉིད་ཀྱིས་ལན་འདེབས་པར་བྱེད་པར་གྲག་གོསྐེ།",
    "གལ་ཏེ་ཁྱད་པར་མེད་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འོ་ན་ཇི་ལྟར་སྤྱི་དང་ཁྱད་པར་དག་མ་འཆོལ་བ་ཉིད་དུ་རྣམ་པར་གཞག་ཅེ་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དོ།",
    "ཁྱད་པར་ཡང་གཞན་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྤྱི་ཁྱད་པར་ལས་ཁྱད་པར་ཅན་ཡིན་ཞེས་བྱ་བ་ནི་ཉེ་བར་མཚོན་པ་ཙམ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་ཁྱད་པར་ཡང་སྤྱི་ལས་ཁྱད་པར་ཅན་ཉིད་ཡིན་ནོ།",
    "མ་འཆོལ་བར་གནས་ཞེས་བྱ་བ་མ་འདྲེས་པར་གྱུར་པའོ།",
    "ཇི་སྐད་དུ་ལེགས་པའི་བློ་གྲོས་དེ་ཉིད་ཀྱིས་ཡོད་པ་ལ་སོགས་པའི་ཕྱིར་སྤྱིའི་རང་བཞིན་དང་ལྡན་པ་ཉིད་ཀྱིས་ཁྱད་པར་མངོན་སུམ་དུ་བྱེད་ཀྱི།",
    "འདིར་མ་འཆོལ་བར་གནས་པར་མི་འགྱུར་རོ།",
    "ཐ་དད་པར་ཡང་མ་ཡིན་ལ་དབྱེར་མེད་པར་ཡང་མ་ཡིན་པར་འདོད་དོ་ཞེ་ན།",
    "གཞན་ཡང་ཁྱད་པར་མེད་པ་གཟུང་བ་དང་ཐ་དད་པ་ཞེས་བྱ་བ་ཕན་ཚུན་འགལ་བ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཁྱད་པར་བདག་ཉིད་མ་གཏོགས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཐ་དད་པ་དག་ལས་ཁྱད་པར་གཞན་མ་ཡིན་ཏེ།",
    "དེ་ཁྱད་པར་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་རྣམ་པར་རྟོག་པའི་ཤེས་པ་གཟུང་བར་བྱ་བར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་གལ་ཏེ་སྟོང་པ་ཞེས་དེ་སྤྱི་ལས་ཁྱད་པར་ཅན་དུ་འགྱུར་བ་དེ་ཡང་དངོས་པོ་ཉིད་དུ་འགྱུར་ཏེ།",
    "དངོས་པོ་སྐེད་པ་ལ་ནི་ཁྱད་པར་དུ་བརྗོད་པའི་རང་བཞིན་ཉིད་སྲིད་པ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་དུ་བརྗོད་པའི་རང་བཞིན་མེད་པ་ཡང་ཁྱད་པར་ཅན་དུ་བརྗོད་པར་མི་ནུས་ཤིང་།",
    "སྤྱིའི་ངོ་བོ་མེད་པ་ལས་མཚུངས་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་སྟོང་པ་སྤྱིའི་ལྡོག་མཚམས་སུ་བྱས་ནས་མཚུངས་པའམ།",
    "ཁྱད་པར་ཅན་ཉིད་རིགས་པ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་གང་ཞིག་འདི་སྡོག་མཚམས་སུ་བྱས་ནས་མཚུངས་པའམ།",
    "དངོས་པོ་ཉིད་དངོས་པོ་གཞན་མ་ཡིན་པའི་ཕྱིར་དངོས་པོ་མེད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེས་ན་འདི་དག་ལས་ཁྱད་པར་ཅན་ཡིན་ཞེས་ལེགས་པའི་བློ་གྲོས་ཀྱིས་སྨྲས་པ།",
    "དངོས་པོས་ཁྱད་པར་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དངོས་པོ་གང་ཞིག་དངོས་པོ་ལས་ཁྱད་པར་ཅན་ཉིད་ཡིན་ཏེ།",
    "སྤྱི་ནི་དུའདི་ལྟར་མི་འདོད་པའི་ཕྱིར་འདི་དེ་ལས་ཁྱད་པར་ཅན་ཡིན་པར་གསལ་རབ་པ་ཡིན་ནོ།",
    "དེ་དངོས་པོ་གཞན་ལས་ཁྱད་པར་ཅན་དུ་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་ལས་ལྡོག་པར་བརྗོད་པའི་ཕྱིར་རོ།",
    "ལྟ་བ་ལས་མ་གཏོགས་པའི་མངོན་སུམ་གཞན་ལ་སྤྱི་ལ་སོགས་པའི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དོན་འཛིན་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ལྟ་བའི་ཤེས་པ་ཉིད་ཕྱོགས་སུ་བྱས་ནས་གཏན་ཚིགས་སུ་བརྗོད་ན།",
    "དེ་ཉིད་ཚིགས་སུ་བཅད་པ་གཉིས་པས་གསལ་བར་བྱེད་པ་ནི་ཁྱད་པར་ཅན་མ་ཡིན་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཁྱད་པར་ནི་ཉི་ཚེ་བའི་སྤྱི་སྟེ་བ་ལང་ཉིད་ལ་སོགས་པའོ།",
    "རིགས་ལ་སོགས་པ་ཞེས་བྱ་བ་འདིས་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དོན་འཛིན་པ་བསྟན་ཏེ།",
    "ཡང་ན་ཞེས་བྱ་བ་ནི་སྐད་ཅིག་མ་གསུམ་པ་ལ་སོགས་པར་རོ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་ན་སྣང་བ་ནས་ནི་ཁྱིམ་ཕུགས་སུ།",
    "དེ་ནི་མི་རིགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཁྱད་པར་གཅིག་ཏུ་ཐ་དད་པ་ཉིད་དུ་འགྱུར་ཏེ་ཞེས་བྱ་བ་ལ་ཁྱད་པར་ཅན་ལས་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "གཞན་གྱིས་འདི་འདོད་པ་ཡང་མ་ཡིན་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གཅིག་ཏུ་ཐ་དད་པ་ཉིད་དུ་ཅི་ལྟར་མི་འདོད་ཅེ་ན།",
    "གལ་ཏེ་ཁྱད་པར་ཅན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གཞན་དུ་ན་ཁྱད་པར་དུ་མི་འཐད་པའི་ཕྱིར་རོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "སྒྱུར་བྱེད་དེ་ནི་ཁྱད་པར་ཡིན།",
    "ཕྱི་མའི་ཞེས་བྱ་བ་ནི་སྤྱིའི་བདག་ཉིད་རིགས་པར་མི་འགྱུར་རོ།",
    "མངོན་སུམ་གྱི་རྗེས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ཡང་བཟུང་ཟིན་པ་འཛིན་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་བྱེད་པ་འགལ་བ་དམིགས་སོ།",
    "དེའི་ཕྱིར་འདིར་གལ་ཏེ་སྒོ་བཏགས་པའི་ཡུལ་རྣམ་པར་དཔྱད་པས་བཟུང་ཟིན་པ་ཞེས་བྱ་བ་གཏན་ཚིགས་ཀྱི་དོན་ཡིན་ན་དེའི་ཚེ་གཏན་ཚིགས་མ་གྲུབ་པ་ཡིན་ནོ།",
    "འདི་ལྟར་ངེས་པར་དུསྒྲོ་འདོགས་པ་རྣམ་པར་དཔྱོད་པའི་ཡུལ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཡང་ཁྱེད་ཅག་དང་ཡང་རྩོད་པ་མེད་དེ།",
    "མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ཡང་དག་པར་མ་རིག་པ་སྐྱེ་བ་མེད་པའི་ཕྱིར་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་མ་དམིགས་པར་སྒོ་བཏགས་པ་མ་སྐྱེས་པ་ཉིད་དུ་གྲུབ་པོ།",
    "ད་ནི་རིགས་ལ་སོགས་པའི་དོན་དམ་པར་ཡོད་པ་ཉིད་མ་ཡིན་ན་དེའི་ཡུལ་ཅན་ཡིན་པ་ཉིད་ཀྱི་མངོན་སུམ་རྟོག་པ་དང་བཅས་པ་ཉིད་དུ་ག་ལ་འགྱུར་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཐ་དད་ལས་ཐ་དད་པར་མི་སྣང་བའི་ཕྱིར་རོ།",
    "གང་ཡང་རུང་བའི་ངོ་བོ་རྣམ་པར་བཅད་ནས་གང་ཡང་རུང་བ་ཡོངས་སུ་གཅོད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་དེས་ཐ་སྙད་དུ་བྱེད་འདི་ལྟར་འདི་ནི་བདེ་བ་སྒྲུབ་པར་བྱེད་པའོ།",
    "འདི་ནི་སྡུག་བསྔལ་སྒྲུབ་པར་བྱེད་པ་ཞེས་བྱ་བ་གལ་ཏེ་ངེས་པ་དེའི་ཚེ་དེ་དག་ཐོབ་པ་དང་སྤངས་པའི་དོན་དུ་འཇུག་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་རྗེས་སུ་དཔག་པ་ལ་སོགས་པའི་ཐ་སྙད་འཇུག་པའི་རྟག་ལས་རྟོག་པ་མེད་པའོ་ཞེས་བྱ་བ་འདི་དམ་བཅས་པ་འདི་རྗེས་སུ་དཔག་པས་གནོད་པ་ཡིན་ནོ་ཞེས་གང་རྩོད་པར་བྱེད་པ་དེ་ལ།",
    "དེའི་སྒོ་ནས་ཞེས་བྱ་བ་རྣམ་པར་རྟོག་པའི་སྒོ་ནས་སོ།",
    "འདི་ལྟར་མངོན་སུམ་རྟོག་པ་དང་བྲལ་བ་ཡང་རིགས་མཐུན་པ་དང་མི་མཐུན་པ་ལས་ལོག་པའི་མེ་ལ་སོགས་པའི་དོན་དེའི་རྣམ་པར་སྣང་བ་སྐྱེ་བ་ལས་རྣམ་པར་གཅོད་པ་སྐྱེ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་ངེས་པའི་ངོ་བོར་རྣམ་པར་གནས་པའི་དངོས་པོ་འཛིན་པའི་ཕྱིར་དང་།",
    "སྣང་བ་དང་རྣམ་པར་བརྟག་པ་དག་གཅིག་ཏུ་ཞེན་ནས་འཇུག་པས་དངོས་པོའི་ངོ་བོ་མ་རྟོགས་སྐེཔ་རྟོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྣམ་པར་རྟོག་པ་གཉིས་ཀྱི་རྒྱུ་ཡིན་པའི་ཕྱིར།",
    "འདི་ལྟར་དེ་གང་ལ་འཇུག་པ་མེད་དེ་སྣང་བའི་ཕྱིར་དེ་ཡོངས་སུ་གཅོད་ལ་འདིར་དེ་ལས་གཞན་མི་དམིགས་པར་དེའི་ཕྱིར་དེ་རྣམ་པར་གཅོད་ལ་དངོས་པོ་ཐམས་ཅད་ཀྱང་སྣང་བ་དང་དེ་ལས་གཞན་པ་ཕུང་པོ་གཉིས་སུ་རྣམ་པར་གཞག་པའི་ཕྱིར།",
    "རྣམ་པ་གཞན་མེད་པར་སྟོན་པ་ཡིན་ནོ།",
    "མངོན་སུམ་སྐྱེས་ན་ཡང་ཆ་གང་ལ་ཞེན་པ་སྐྱེད་པར་བྱེད་པའི་ཆ་དེ་ཉིད་ལས་ཐ་སྙད་དུ་རུང་བར་གཟུང་བར་བྱེད་ཀྱི།",
    "ངེས་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་བཞིན་ནོ།",
    "ཡུལ་ཐ་དད་པ་ཡང་མ་ཡིན་ཞེས་བྱ་བ་འདིས་ནི་ཡུལ་དང་བཅས་པ་ཉིད་ཡིན་ན་ཡང་རྣམ་པར་རྟོག་པའི་ཡུལ་ཐ་དད་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་མ་གྲུབ་པར་བསྟན་ཏོ།",
    "དོན་དམ་པར་རྣམ་པར་རྟོག་པ་ཡུལ་མེད་པ་ཡིན་པ་དེའི་ཚེ་ཡང་མ་གྲུབ་པ་ཉིད་གསལ་རབ་པ་ཉིད་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཞེས་བྱ་བའི་དཔེ་འདི་བསྒྲུབ་པར་བྱ་བ་མ་ཚང་བར་བསྟན་ཏོ།",
    "ཡང་ཡུལ་ཐ་དད་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་མི་མཐུན་པའི་ཕྱོགས་ལ་ཡོད་པར་བསྟན་པའི་སྒོ་ནས་གཏན་ཚིགས་མ་ངེས་པ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟ་མ་ཡིན་ན་རྣལ་འབྱོར་སྤྱོད་པའི་ལུགས་ཀྱི་དམིགས་པ་མ་གྲུབ་པའི་ཕྱིར་ལ་ལུགས་གཉི་ག་ལ་བརྟེན་པར་འདོད་པའི་མངོན་སུམ་གྱི་མཚན་ཉིད་མ་ཁྱབ་པ་ཉིད་དུ་འགྱུར་རོ།",
    "དེ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།་",
    "སྤྱིའི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་ལྡོག་པ་མ་ཡིན་ནོ།",
    "དེ་ཙམ་གྱིས་ནི་ཡིད་ཀྱི་འཁྲུལ་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།་",
    "ཅེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "འདི་དེ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ལ་འདོད་པས་དངོས་སུ་ནུས་པ་མ་ཡིན་ནོ།",
    "དེ་མིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "ཁྱད་པར་ཅན་གྱི་དོན་བྱ་བ་བྱེད་པ་ཉིད་ཀྱི་སེར་པོ་ཉིད་དུ་ཞེན་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་ཆད་པར་འགྱུར་རོ།",
    "ལུང་ལ་གྲགས་པ་ཡིན་པའི་ཕྱིར་འདིར་ཡིད་ཀྱི་མཚན་ཉིད་མ་བྱས་ལ།",
    "རང་རིག་པ་མ་ཡིན་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་ཕྱི་རོལ་གྱི་དོན་རིག་པར་བྱེད་པ་མ་ཡིན་པ་དེ་ནི་ཤེས་པའི་རང་བཞིན་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཕྱི་རོལ་དངོས་པོ་ཞེས་བྱ་བ་ལ་སོགས་པས་འགེགས་པར་བྱེད་དོ།",
    "བདེ་བ་ལ་སོགས་པ་ནི་ནང་དུ་རིག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཡིད་ཀྱི་ཤེས་པས་རིག་པར་བྱ་བ་ཉིད་དུ་འདོད་པའི་ཕྱིར་རོ།",
    "མགྱོགས་པར་འཇུག་པས་ཅིག་ཅར་འཁྲུལ་པ་གང་ཡིན་པ་དེ་ཡང་སྔར་གསལ་བ་ཉིད་དོ།",
    "གཞན་ཡང་བདེ་བ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པའི་ཡུལ་ཉིད་ཡིན་ན་དགའ་བ་དང་ཡོངས་སུ་གདུང་བ་ལ་སོགས་པའི་ངོ་བོས་གསལ་བར་སྣང་བར་ཡང་མི་འགྱུར་ཏེ།",
    "ཡིད་ཀྱི་ཤེས་པས་རིག་པར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་པའི་ཕྱིར་དང་།",
    "སྣེསྔོན་པོ་ལ་སོགས་པ་བཞིན་དུ་རྣམ་པར་ཆད་པར་སྣང་བར་འགྱུར་ན།",
    "སིམ་པ་ལ་སོགས་པའི་ངོ་བོ་ཤེས་པ་ལས་རྣམ་པར་ཆད་པར་དམིགས་པ་ཡང་མ་ཡིན་ནོ།",
    "སིམ་པ་ལ་སོགས་པའི་ངོ་བོས་ཤེས་པ་ལས་ཐ་མི་དད་པར་འཛིན་པ་འཁྲུལ་པ་ཡིན་ནོ་ཞེ་ན།",
    "བདེ་བ་ལ་སོགས་པའི་ཤེས་པ་དེའི་ངོ་བོ་ཡིན་ནོ་ཞེ་ན་ནི་བདེ་བ་ལ་སོགས་པའི་ཤེས་པའི་རང་བཞིན་ཡིན་པར་གྲུབ་བོ།",
    "ཐ་དད་པར་མ་གྲུབ་པས་འཁྲུལ་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "གནས་སྐབས་མཚུངས་པ་ཞེས་བརྗོད་པར་མི་བྱ་སྟེ།",
    "ཅི་སྟེ་བདེ་བ་ལ་སོགས་པ་རྣ་མས་ཀྱི་རྣམ་པ་གཉི་ག་ཉམས་སུ་མྱོང་བར་ཁས་ལེན་པར་བྱེད་ན།",
    "དེ་ལྟ་བས་ན་གཞན་གྱི་སྡུག་བསྔལ་རྗེས་སུ་དཔག་པ་བུན་རྗེས་སུ་དཔོག་པ་པོ་དང་ཡང་ཉམས་སུ་མྱོང་བ་མཚུངས་པར་འགྱུར་རོ།",
    "ཤེས་པ་ཞེས་ཐ་སྙད་དུ་མ་བྱས་པའི་ཕྱིར་བུམ་པ་རྗོལ་སོགས་པ་བཞིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཁྱེད་ཅག་ལ་ཤེས་པ་ཡང་ཤེས་པ་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་གསལ་བའི་བདག་ཉིད་ཀྱི་ཤེས་པ་གསལ་བར་ཉམས་སུ་པྱོང་བའི་ཕྱིར་ཤེས་པ་མ་ཡིན་པར་མི་འགྱུར་ན།",
    "འཆད་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པར་གྲུབ་པར་རོ།",
    "པ་ལ་ཤ་འཆད་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "འདིས་གཅོད་པར་བྱེད་པས་ན་གཅོད་པའོ།",
    "ཤེས་པ་ཡུལ་གྱི་རྣམ་པར་སྐྱེ་བ་ན་ཡུལ་ཡོངས་སུ་གཅོད་བཞིན་པ་ན་བྱ་བ་དང་བཅས་པ་ལྟ་བུར་སྣང་སྟེ།",
    "རྣམ་པར་འཇོག་པ་ཡང་དེའི་རྗེས་ལ་ཐོབ་པའི་རྣམ་པར་རྟོག་པས་ཡིན་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་གཞག་པ་གྲུབ་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་སྟོན་པ་ཡིན་ནོ།",
    "གདོན་མི་ཟ་བར་ཐོག་མར་རྣམ་པར་གཞག་པའི་སྒོ་ནས་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པར་རྣམ་པར་བཞག་པར་བྱེ་བྱ་དགོས་སོ་ཞེས་བྱ་བ་འདི་ཙམ་ཞིག་སྨྲ་བ་ཡིན་ནོ།",
    "རིག་པ་ཐ་དད་པ་ཡུལ་ཐ་དད་པར།",
    "རྣམ་པར་མ་བཞག་པར་ངེས་པར་འཇུག་པར་མི་རིགས་ལ།",
    "དེ་ལྟ་བས་ན་རྣམ་པར་གཞག་པ་གྲུབ་ན།",
    "དེ་རྣམ་པ་གཞན་དུ་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པའི་ངོ་བོས་རྟོག་པ་དེ་ལྟ་ན་ཡང་སྐྱོན་མེད་པ་ཉིད་དོ་ཞེས་བྱའོ།",
    "ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དོ།",
    "དོན་མེད་ཅེས་བྱ་བ་ལ་སོགས་པས་སུན་འབྱེན་པར་བྱེད་དེ།",
    "གང་ཕྱིར་ཡོངས་སུ་གཅོད་པས་ཞེས་བྱ་བ་ལ་སོགས་པས་སྐྱེད་པར་བྱེད་པའི་འབྲས་བུ་གཞན་ཡང་སྨྲས་པ་ཡིན་ནོ།",
    "བྱེད་པ་པོ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཡང་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་བརྗོད་པར་འདོད་ན་ཡང་གཏན་ཚིགས་མ་གྲུབ་སྟེ།",
    "སྒྲུབ་པར་བྱེད་པ་ནི་རྣམ་པར་འཇོག་པར་བྱེད་པ་ཉིད་དུ་འདོད་པའི་ཕྱིར་རོ།",
    "འཇོག་པར་བྱེད་པ་ཉིད་བརྗོད་པར་འདོད་ན་ཡང་མ་ངེས་པ་ཡིན་ཏེ།",
    "སྤྱིར་བརྗོད་པར་འདོད་ན་ཡང་མ་ངེས་པ་ཡིན་ཏེ།",
    "ཁོ་བོ་ཅག་རྣམ་པར་ཤེས་པ་སྨྲ་བ་རིག་པའི་རྗེས་སུ་འབྲང་བ་རྣམས་ཀྱིས་འདི་འདོད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཆད་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "དེ་རྣམ་པར་དཔྱད་པ་ནི་སེལ་བའོ།",
    "སྒྲུབ་པར་བྱེད་པ་གསལ་པོ་དེ་ཡང་གང་ཞེ་ན།",
    "ཡུལ་ལ་ལོག་པར་རྟོགས་པ་ནི་སྤྱི་དངོས་པོར་གྱུར་པ་བཀག་པའི་ཕྱིར་ལ།",
    "ལོགས་ཤིག་ཏུ་གསལ་བ་མ་བྱས་སོ།",
    "རྟོག་པ་དང་བྲལ་བ་ཉིད་ལ་སོགས་པ་མཚོན་པ་ནི་འཇིག་རྟེན་འཇུག་པ་དང་ལྡོག་པར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "འོན་ཀྱང་ཇི་ལྟ་བ་བཞིན་དུ་གཞག་པ་ཉིད་ཀྱི་དངོས་པོའི་རང་བཞིན་རྗེས་སུ་བརྗོད་ནས་གྲགས་པ་དང་མ་གྲགས་པའི་རང་བཞིན་གྱི་ཁྱད་པར་བསྟན་པར་འདོད་པས་དཔེར་ན་ས་ནི་སྲ་བ་ཉིད་ལྟ་བུར་དེ་རིགས་པ་མཚན་ཉིད་བྱེད་པ་ཡིན་ཏེ།",
    "མངོན་སུམ་གྱིས་མཚོན་པར་བྱེད་པའི་མཚན་ཉིད་རྟོག་པ་དང་བྲལ་ཞིང་མ་འཁྲུལ་བ་དག་ལས་གཞན་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་དེ་ལ་གདོན་མི་ཟ་བར་མ་འཁྲུལ་པར་ཁས་བླང་བར་བྱ་དགོས་ཏེ།",
    "ཇི་ལྟར་མངོན་སུམ་རྟོག་པ་མེད་པ་ཡིན་ཡང་འཇུག་པར་བྱེད་པ་ཉིད་ཡིན་པ་དེ་ལྟར་ནི་དང་པོ་ཉིད་དུ་བསྟན་ཟིན་ཏོ།",
    "འདི་ལྟར་འཇུག་པ་ལས་སྔར་རབ་ཏུ་གྲགས་པ་གང་ཡིན་པ་དེ་ཉིད་འཇུག་པར་འདོད་པ་རྣམས་ཀྱི་མཚན་ཉིད་དུ་བྱ་བར་རིགས་ཀྱི་མ་གྲགས་པ་ནི་བྱམ་ཡིན་ཏེ།",
    "དོན་ཇི་ལྟ་བ་བཞིན་དུ་ཇི་ལྟར་ཉེ་བར་བཏགས་པའི་དོན་ཐོབ་པར་ནུས་པའི་མཚན་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དུས་ཕྱིས་དོན་ཇི་ལྟ་བ་བཞིན་དུ་ངེས་པར་བཟུང་རྗོན་ཡང་འབྲས་བུ་དང་བཅས་པ་མ་ཡིན་ཏེ།",
    "གང་ཡང་འཇུག་པ་ལས་སྔར་མི་ངེས་པའི་རྒྱུ་ནི་ཚུ་རོལ་མཐོང་བ་ཉིད་ཡིན་པར་བརྗོད་པ་དེ་ཡང་མ་ངེས་པ་ཉིད་ཡིན་ཏེ།",
    "འདི་ནི་བདེ་བ་མ་ཡིན་པའོ་སྙམ་དུ་འཇུག་པ་ལས་སྔར་ངེས་ན་གཡང་ས་ལ་སོགས་པ་སྤོང་བ་དང་ནུ་མ་ལ་སོགས་པ་ལེན་པར་བྱེད་པར་མཐོང་བ་ཉིད་དོ།",
    "དེས་དབེན་པར་ངེས་པའི་རྒྱུ་ཡང་གོམས་པ་ལ་སོགས་པ་ཡིན་པའི་ཕྱིར་རྟགས་ངེས་པ་སྲིད་པས་དེས་ན་རྗེས་སུ་དཔག་པ་མི་སྤོང་ངོ།",
    "ངེས་པ་སྐྱེད་པར་བྱེད་པས་དོན་དུ་གཉེར་བ་རྣམས་དེ་ལ་འཇུག་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གལ་ཏེ་ཡང་དེ་ལ་རྟོག་པ་དོན་དུ་གཉེར་བ་དོན་གྱི་རྣམ་པ་ལས་བཟློག་པ་ངེས་པ་དེ་ལྟར་ན་ཡང་མངོན་སུམ་དེ་རྣམ་པ་དེས་འཇུག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཟློག་པར་བྱེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "མངོན་སུམ་ལས་དོན་དུ་གཉེར་བར་འཇུག་པར་ཡང་མི་འགྱུར་ལ།",
    "སྡོག་པར་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ཐོབ་ན་དེ་ལྟ་ན་ཡང་མ་ཡིན་གྱི།",
    "འདིས་ནི་མངོན་སུམ་ངེས་པའི་རྒྱུ་ཡིན་པ་ལས་འདི་ཁྱད་པར་འགའ་ཡང་མེད་དོ།",
    "དེའི་བདག་ཉིད་དུ་རིག་པར་བྱའོ།",
    "སྒྲ་རྟག་ཅེས་བྱས་པའི་ཕྱིར་ལུས་ཅན་ཡིན་པའི་ཕྱིར།",
    "མཉན་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ལུས་ཅན་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ལྟ་བུ་སྟེ།",
    "སྒྲ་ནི་རྟག་སྟེ་བྱས་པའི་ཕྱིར།",
    "གང་ལ་གཞན་དུ་མི་འཐད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒྱས་པར་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པར་བསྟན་པའི་སྒོ་ནས་གཞན་དུ་མི་འཐད་པ་ཉིད་ཅེས་བྱ་བའི་གཏན་ཚིགས་མཚན་ཉིད་གཅིག་པ་ཉིད་དུ་སྒྲུབ་པར་བྱེད་དོ།",
    "མཚན་ཉིད་གསུམ་པར་ཡང་རིགས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བའི་མི་མཐུན་པའི་ཕྱོགས་ལས་ལྡོག་པ་ཞེས་བྱ་བའི་མཚན་ཉིད་གསུམ་པ་ཡིན་གྱི།",
    "ཞེས་བྱ་བ་འདི་ནི་ཕྱེད་གདོན་པར་བྱའོ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པའི་ཚོགས་ཐམས་ཅད་ཕྱོགས་སུ་བྱས་པའི་ཕྱིར་རོ།",
    "ཟླ་བ་ཉིད་དུ་ཐ་སྙད་དུ་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་སོ།",
    "མཚན་ཉིད་གཉིས་པ་གཞན་འདི་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "གང་ལ་བསྒྲུབ་བྱ་རྣམ་པར་བཅད་པ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་སྒྲུབ་པར་བྱེད་པ་རྣམ་པར་གཅོད་པས་སྟོན་པར་འགྱུར་བ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དེ་ལས་མ་གཏོགས་པ་གསུམ་པ་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "དེ་ལ་གཏན་ཚིགས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "ཁྱད་པར་གྱི་སྒོ་ནས་ཡིན།",
    "ཁྱད་པར་གྱི་ཡིན་ན་ཡང་ཤེས་པར་འདོད་པའི་བྱེ་བྲག་སྟེ།",
    "བརྗོད་པར་འདོད་པ་གྲུབ་མི་བརྟེན།",
    "སློབ་དཔོན་གྱིས་ཞེས་བྱ་བ་འདིས་ནི་དེའི་ལུགས་དང་མི་འགལ་བར་སྟོན་པར་བྱེད་དོ།",
    "བསྒྲུབ་བྱ་མེད་པར་མི་མཐོང་འདོད།",
    "གཏན་ཚིགས་ལས་བསྒྲུབ་པར་བྱ་བ་ངེས་པར་བྱ་བ་ཡིན་ན།",
    "ད་ནི་གང་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་དཔེར་བརྗོད་པ་རྣམས་སུན་འབྱིན་པར་བྱེད་དེ།",
    "འདི་ལྟར་གཏན་ཚིགས་ཐེ་ཚོམ་ལ་བརྗོད་པའི་ཕྱིར་བསམས་པ་བཞིན་དུ་གྲུབ་པར་ཡང་གཏན་ཚིགས་ཀྱི་རྟེན་མ་ཡིན་པ་ཉིད་དེ།",
    "དེའི་ཕྱིར་བསྒྲུབ་པར་བྱའོ་ཞེ་ན།",
    "རྣམ་པར་འགྱུར་བའི་བདག་ནི་རྣམ་པར་འགྱུར་བའི་རང་བཞིན་ནོ།",
    "དེ་དག་ཀྱང་དེ་ཁོ་ན་ཉིད་དུ་ཞེས་བྱ་བའི་ཁྱད་པར་དང་བཅས་པའི་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་མེད་པ་ཉིད་ལ་བརྟེན་གྱི་རྣམ་པ་ཐམས་ཅད་དུ་ནི་མ་ཡིན་ཏེ།",
    "སོགས་པའི་སྒྲས་དོན་དམ་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་གཟུང་ངོ།",
    "ཅི་སྟེ་ཐ་སྙད་སྒྲུབ་ན་དེའི་ཚེ་གང་དུ་སྔར་ཐ་སྙད་དུ་བྱས་པ་དེ་དཔེར་གྲུབ་པ་ཡིན་པའི་ཕྱིར་ཚུལ་གསུམ་པ་ཉིད་དུ་འགྱུར་བ་ལ་དེ་ལྟ་མ་ཡིན་ཏེ།",
    "དཔེ་མེད་པ་ཡིན་ན་ཐ་སྙད་དེ་ཡང་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་ཟླ་བ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་ཚུལ་གསུམ་པའི་གཏན་ཚིགས་སྲིད་པ་ཡིན་ན།",
    "དེ་གྲགས་གང་ཞིག་འདོད་པར་འགྱུར།",
    "ཁྱད་པར་མཐོང་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་དང་དམ་བཅའ་དག་སྟེ།",
    "འདི་ལྟར་འདིར་ཉམས་སུ་མྱོང་བའི་རྒྱུ་ཁྱད་པར་ཅན་གྱི་སྦྲང་བུ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་དེ་ཉིད་སྒྲ་གཞན་གྱིས་གཏན་ཚིགས་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "གཏན་ཚིགས་དང་དམ་བཅའ་བ་དག་ཁྱད་པར་མེད་དོ།",
    "སྦྲང་བུ་གཞན་གྱིས་བྱས་པའི་ཚོར་བས་འཁྲུལ་པར་འགྱུར་དུ་འོང་བའི་ཕྱིར་གདོན་མི་ཟ་བར་ཁྱད་པར་བྱ་དགོས་སོ།",
    "ཅི་སྟེ་རྒྱུ་དང་འབྲས་བུའི་ཐ་སྙད་བརྗོད་པ་དེ་ལ་བསྒྲུབ་པ་དེ་ལྟར་ཡིན་ན་གཏན་ཚིགས་ཚུལ་གསུམ་པར་འགྱུར་ཏེ།",
    "ཡོད་པ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་གཏན་ཚིགས་ཐམས་ཅད་སྐྱོན་གྱི་རིགས་གསུམ་ལས་མི་འདའ་སྟེ།",
    "འོ་ན་ཇི་ལྟར་ཁྱེད་ཅག་ལ་ཡང་མིག་ལ་སོགས་པ་འགྲུབ་པར་འགྱུར་ཞེ་ན།",
    "དེ་ཞེས་བྱ་བ་ནི་ཕ་དང་འབྱེལ་པ་སྟེ་ཡུལ་ཕྱོགས་གཞན་འགའ་ཞིག་ཏུ་ཉམས་སུ་མྱོང་བ་ན་གཏན་ཚིགས་མ་གྲུབ་པར་འགྱུར་རོསྐེ།",
    "རྗོད་པར་བྱེད་པའི་ངོ་བོས་ནི་མ་ཡིན་ནོ།",
    "སྒྲོན་མ་ནི་དུ་བ་བཞིན་དུ་རྟགས་ཀྱི་སྒོ་ནས་ཤེས་པར་བྱེད་མི་འདོད་དོ།",
    "གཞན་དུ་ན་མིག་ལ་སོགས་པ་རྣམས་ལ་ཡང་བརྩད་པར་བྱ་བར་འགྱུར་རོ།",
    "གཞན་དུ་མི་འཐད་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་སྐབས་ཀྱི་དོན་མཇུག་སྡུད་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཤེས་པར་བྱེད་པ་ཉིད་དུའང་མཐོང་།",
    "ངེས་པར་འཇུག་པ་མ་ཡིན་ནོ།",
    "རྒྱུ་ཐ་དད་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་དེའི་བུ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་འདི་བྱས་པ་ཉིད་བཞིན་དུ་རང་བཞིན་གྱི་གཏན་ཚིགས་མ་ཡིན་ཏེ།",
    "བྱས་པ་དེ་ནི་མི་རྟག་པ་ཉིད་སྤངས་ནས་གཞན་དུ་མེད་པ་བཞིན་དུ་དེའི་བུ་ལ་རང་བཞིན་གཞན་མེད་པ་མ་ཡིན་ཏེསྐེ།",
    "འདི་ལྟར་འབྲས་བུ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་འགའ་ཞིག་ལ་ལྟོས་ནས་དེའི་བུ་ཞེས་ཐ་སྙད་དུ་བྱས་ཀྱི་སྔོ་བསངས་ཉིད་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་རྒྱུ་སྐར་སྨིན་དྲུག་ཤར་བ་ལ་རྒྱུ་སྐར་སྣར་མ་ཉེ་བར་རྟོགས་པར་བྱེད་དེ།",
    "ཞེས་ཅི་སྟེ་རྗོད་པར་བྱེད་ཅེ་ན།",
    "ཅི་ལྟ་བུའི་ཁྱད་པར་ཅན་ཡིན་ཞེ་ན།་",
    "འདི་ནི་གདོན་མི་ཟ་བར་དེ་ལྟ་བུ་ཡིན་པར་རིགས་ཛེེཔར་བྱ་སྟེ།",
    "གལ་ཏེ་འབྱེལ་པ་མེད་པས་ཀྱང་དེ་ལྟར་གོ་བར་བྱེད་པ་ཡིན་ན་དེའི་ཚེ་གང་ཅི་ཡང་རུང་བ་གོ་བར་བྱེད་པར་འགྱུར་ཏེ་འབྱེལ་བ་མེད་པ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་འདི་ལ་ཡང་འབྲེལ་པར་བརྗོད་ལ།",
    "གཅིག་ན་ལྷན་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པས་རྩོད་པར་བྱེད་པའི་བསམ་པ་དོགས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དངོས་པོ་ཉིད་ཡིན་ན་གཅིག་ན་གཟུགས་གཉིས་ལྷན་ཅིག་ཡོད་པར་མི་འགྱུར་བ་ཞིག་ན་ཡོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེར་སྐྱེས་པ་ཡང་ཅིའི་ཕྱིར་གཞན་དུ་དམིགས་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "ཇི་ལྟར་རྗོད་པར་བྱེད།",
    "དེ་ལྟ་བས་ན་སྒྲུབ་པར་བྱེད་པ་ཡན་ལག་ཏུ་མ་གྱུར་པའི་ཕྱིར་ཉེ་བར་སྦྱོར་བ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ཏེ་སྦྱོར་བ་མིན་པ་རྒྱུར་གྱུར་པ་མ་ཡིན་པར་འཆད་ན་དམ་བཅའ་བའི་དོན་གྱི་ཕྱོགས་ཀྱིས་གཅིག་ཏུ་འགྱུར་རོ།",
    "ཇི་ལྟར་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་མ་ཡིན་ཞེ་ན།",
    "ནུས་པ་མེད་པ་སྟོན་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ཉིད་བརྗོད་པའི་ཕྱིར་རོ།",
    "བསམ་པ་རིག་པར་བྱེད་པ་ལ།",
    "བསྒྲུབ་པར་བྱ་བ་བརྗོད་པ་ཡིས།",
    "ཁ་ཅིག་ཡན་ལག་ཏུ་མ་གྱུར་ཀྱང་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "དཔེ་ཡིས་བསྟན་པར་བྱ་བ་ཡིན།",
    "དེ་ལྟ་བུར་གྱུར་པའི་ཚིག་ཀྱང་སྦྱོར་བ་བསྟན་པའི་དོན་དུ་བསྟན་པར་བྱ་བར་འགྱུར་རོ།",
    "འདི་དག་མེད་པར་ཡང་སྐབས་མ་ཡིན་པ་སྒྲུབ་པར་བྱེད་པ་འཇུག་པ་མི་སྲིད་དོ་ཞེས་བྱ་བའོ།",
    "འབྲས་བུ་མེད་ཅེས་བྱ་བ་ནི་དེ་དག་མེད་པར་ཡང་བསྒྲུབ་པར་བྱ་བ་རྟོགས་པའི་ཕྱིར་ཏེ།",
    "འདི་ལྟར་གང་དང་གང་བྱས་པ་ཡིན་པ་དེ་ཐམས་ཅད་ནི་མི་རྟག་པ་ཡིན་ལ།",
    "སྒྲ་ཡང་བྱས་པས་ཞེས་བྱ་བ་དེ་ཙམ་ཞིག་བརྗོད་པ་ན་དམ་བཅའ་བ་བརྗོད་པ་མེད་པར་ཡང་སྒྲ་མི་རྟག་གོ་ཞེས་རྟོགས་པར་འགྱུར་རོ།",
    "འོ་ན་ཇི་ལྟར་མཐུན་པའི་ཕྱོགས་ལ་སོགས་པ་རྣམ་པར་འཇོག་སྟེ།",
    "སྒྲུབ་པར་བྱེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དོ།",
    "མཐུན་པའི་ཕྱོགས་ལ་སོགས་པའི་ཐ་སྙད་མེད་པར་ཡང་མེ་རྟོག་པ་ཁོ་ནའོ།",
    "དེ་ལྟ་བས་ན་སྒྲུབ་པར་བྱེད་པའི་དུས་ན་མཐུན་པའི་ཕྱོགས་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་ན་སྒྲུབ་པར་བྱེད་པ་བརྗོད་པའི་དུས་ན་ཡང་དེའི་རྣམ་པར་གཞག་པ་བྱེད་པ་འགལ་བ་མེད་པ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་ཡང་ན་སྐབས་ཀྱི་དོན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "སྒྲུབ་པར་བྱེད་པའི་དུས་ན་སྐབས་སུ་བབ་པ་ཉིད་ཀྱི་དོན་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་བརྗོད་པར་མི་བྱ་སྟེ།",
    "ཤེས་པར་འདོད་པའི་ཞེས་བྱ་བ་སྨོས་ཏེ་གོ་བར་ཟད་དོ།",
    "དཔེར་བརྗོད་པ་ལ་ལྟོས་ནས་དེ་ལྟར་ཞེས་ཉེ་བར་སྡུད་པའམ་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་བསྒྲུབ་པར་བྱ་བ་ཉེ་བར་སྦྱོར་བ་ནི་ཉེ་བར་བརྗོད་པའི་མཚན་ཉིད་དོ།",
    "དེ་ལ་སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོའི་ཞལ་སྔ་ནས་ཀྱི་ཉེ་བར་སྦྱོར་བ་བརྗོད་པ་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "བྱས་པའི་ཕྱིར་ཏེ།",
    "བྱས་པ་ཉིད་དེ་ཡང་ཅི་སྒྲ་ལ་ཡོད་དམ་མེད་སྙམ་པ་ལ།",
    "དེ་ལྟ་བས་ན་ཁྱད་པར་བསལ་བར་བྱ་བའི་ཕྱིར་ཟློས་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཡོད་པ་བསྒྲུབ་པར་བྱ་དོན་དུ།",
    "ཉེ་བར་སྦྱར་བ་ལེན་པར་བྱེད་པ་ན་ཟློས་པ་ཉིད་དུ་བསལ་བར་རབ་ཏུ་སྟོན་པར་བྱེད་པའི་ཕྱིར་གཏན་ཚིགས་མ་གྲུབ་པ་ག་ལས་ཡིན།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་གཏན་ཚིགས་ཀྱི་ནུས་པ་དཔེར་བརྗོད་པ་གྲུབ་པར་བསྟན་ནས།",
    "དམ་བཅའ་བའི་དོན་ཡང་རྗོད་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་མཇུག་སྡུད་པ་སྟེ།",
    "དམ་བཅའ་བ་དང་གཏན་ཚིགས་དང་དཔེ་དང་ཉེ་བར་སྦྱོར་བ་དོན་གཅིག་པ་ཉིད་དུ་འདིས་ཤེས་པར་བྱེད་འབྲེལ་པར་བྱེད་པས་ན་མཇུག་སྡུད་དོ།",
    "གལ་ཏེ་དེ་རྗེས་སུ་བརྗོད་པའི་བདག་ཉིད་ཀྱི་མཇུག་སྡུད་པ་ཡིན་པས་དེའི་ཕྱིར་མཇུག་སྡུད་སྒྲུབ་སྣེཔར་བྱེད་པའི་ཡན་ལག་མ་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་མ་ཡིན་ནོ་ཞེས་སྨྲས་པ་དེ་ལ།",
    "མཇུག་སྡུད་པ་མེད་པར་ནི་གྲུབ་པ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དོགས་པ་དེ་ཟློག་པའི་ཕྱིར་མཇུག་སྡུད་པ་ལོགས་ཤིག་ཏུ་བརྗོད་པར་བྱའོ་ཞེས་ཟེར་རོ།",
    "མེ་འབར་བའི་ཚོགས་ཡོངས་སུ་གནས་པར་ངེས་པའི་བདག་ཉིད་ཀྱི་ས་ཕྱོགས་ན་སེམས་རང་བཞིན་དུ་གནས་པ་གྲང་བ་ཡོད་པར་དོགས་པར་བྱ་བར་རིགས་པ་མ་ཡིན་པ་མ་ཡིན་ལ་དེ་ཡང་རིགས་པ་མེད་པར་ཚིག་ཙམ་གྱིས་མཇུག་སྡུད་པ་ལས་ལྡོག་པ་ཡང་མ་ཡིན་ནོ།་",
    "མཇུག་སྡུད་ལོགས་ཤིག་བརྗོད་པར་བྱ།",
    "གལ་ཏེ་ཚིག་ཁྲུརྣམས་སིལ་བུ་ཡིན་པ་དེ་ལྟ་ན་ཡང་འཟེལ་པ་ཉིད་ཀྱི་དོན་གཅིག་ལ་ཉེ་བར་སྡུད་པའི་ཕྱིར་འབྲེལ་པ་གྲུབ་པར་བྱ་བའི་དོན་དུ་མཇུག་སྡུད་པ་ལོགས་ཤིག་ཏུ་བརྗོད་པར་མི་བྱའོ།",
    "དེ་དག་ནི་རྗེས་སུ་དཔག་པ་རྣམ་པ་གཉིས་ཏེ་ཁྱད་པར་དུ་མཐོང་བ་དང་སྤྱིར་མཐོང་བའོ་ཞེས་རྗོད་པར་བྱེད་དོ།",
    "དེ་ལ་ཁྱད་པར་དུ་མཐོང་བ་གང་ཞེ་ན།",
    "སྔར་ཡོངས་སུ་བཟུང་བའི་ཕྱིར་མེ་དེ་ཉིད་རྗེས་སུ་དཔོག་པར་བྱེད་པ་དེ་ནི་ཁྱད་པར་མཐོང་བའི་རྗེས་སུ་དཔག་པ་ཡིན་ཏེ།",
    "སྔར་མངོན་སུམ་གྱིས་གཟུང་བའི་ཁྱད་པར་ཡུལ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྗེས་སུ་དཔག་པ་ནི་འབྲེལ་པ་ཞེས་ཕྱོགས་གཅིག་མཐོང་བ་ལས་གཞན་ཕྱོགས་གཅིག་ཉེ་བ་མ་ཡིན་པར་ཤེས་པའོ།",
    "འབྲེལ་པ་མངོན་སུམ་གྱིས་མཐོང་བ་ནི་དཔེར་ན་དུ་བའི་རྣམ་པར་མཐོང་བ་ལས་མེའི་རྣམ་པར་ཤེས་པ་ལྟ་བུའོ།",
    "དེ་ལ་གཞོན་ནུ་མ་ལེན་འབྲེལ་པ་མངོན་སུམ་གྱིས་མཐོང་བ་རྗེས་སུ་དཔག་པ་ནི་འཆད་པར་འདོད་ནས།",
    "གང་དག་ཅེས་བྱ་བ་ནི་མེ་དང་དུ་བའི་ཁྱད་པར་ཡུལ་དུ་གྱུར་པ་གང་དག་སྟེ།",
    "དེ་བཞིན་དུ་མེ་དང་དུ་བ་འདི་དག་ནི་རི་ལ་སོགས་པའི་ཡུལ་གྱི་ཁྱད་པར་ན་གནས་པའི་ཕྱིར།",
    "རི་ལ་སོགས་པའི་ཁྱད་པར་གྱི་བློར་བྱས་པ་ཡིན་ནོ།",
    "དེ་དག་ཉིད་ཁྱད་པར་ཏེ།",
    "ས་ལ་རྗོཀེ་ལ་སོགས་པ་ཀྱེ་ཁྱེ་ལ་སོགས་པའི་ཁྱད་པར་རྣམས་སོ།",
    "དེ་བློ་ཞེས་བདུན་པ་སྦྱོར་བའི་རྣམ་པར་དབྱེ་བས་བསྡུ་བ་ཡིན་ནོ།",
    "དེ་ནི་དེ་ཡང་ཡིན་ལ་དངོས་པོ་ཡང་ཡིན་པའི་ཕྱིར་དེ་ལྟ་བུ་དེ་རྟོགས་པ་ཡིན་ནོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "སྤྱིར་མཐོང་བའི་རྗེས་སུ་དཔག་པ་ལ་མེ་དང་དུ་བ་ཉིད་ཀྱིས་དཔེར་རྗོབརྗོད་པར་བྱ་བ་ལ།",
    "གཅིག་ཏུ་སྟེ་མཐའ་གཅིག་ཏུ་ཉི་མའི་འགྲོ་བ་ལ་སྤྱིར་མཐོང་བའི་རྗེས་སུ་དཔག་པ་ཁོ་ན་ཡིན་གྱིས་ཁྱད་པར་དུ་མཐོང་བ་ནི་མ་ཡིན་ནོ་སྙམ་དུ་བསམས་ནས།",
    "དོན་དམ་པར་རྗོནི་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་ནི་ཉུང་ཟད་ཀྱང་གནས་པ་མེད་དོ།",
    "ཅི་སྟེ་ཡང་རྟོག་པས་སྒོ་བཏགས་པའི་གཅིག་ཉིད་ལ་བརྟེན་ནས་ཁྱད་པར་དུ་མཐོང་བར་བརྗོད་ཀྱི་ཡང་དག་པ་ནི་མ་ཡིན་ནོ་སྙམ་ན།",
    "རིགས་ནི་མི་འཇིག་པར་འདོད་དེ།",
    "རིགས་དང་གསལ་བ་དག་གཞན་གྱིས་གཅིག་ཉིད་དུ་འདོད་པའི་ཕྱིར་གསལ་བ་ཞིག་པ་རིགས་པ་གནས་པར་ག་ལ་འགྱུར།",
    "དེ་ལྟ་མ་ཡིན་ན་གྲུབ་པ་དང་བདེ་བ་ཐ་དད་པའི་ཕྱིར་གཅིག་ཏུ་དེ་དག་ཐ་དད་པར་ཁས་བླང་བར་བྱ་དགོས་པར་འགྱུར་རོ།",
    "ཁྱབ་པར་བྱེད་པའི་སྐད་ཅིག་མ་འཇིག་པ་བསྒྲུབས་ཟིན་པའི་ཕྱིར་རོ།",
    "བར་དུ་འཇུག་པའི་ཐེ་ཚོམ་ལྡོག་པར་བྱེད་པའི་མངོན་སུམ་གྱིས་མཐོང་བ་ལས་བླ་ལྷག་པ་ཡོད་དོ་ཞེ་ན།",
    "རྗེས་སུ་དཔག་པས་མཐོང་བ་ལས་བླ་ལྷག་པར་ཡོད་པར་མཚུངས་ཏེ།",
    "འདིའི་སུན་འབྱིན་པ་ཕྱིས་གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "ལོག་པའི་ཤེས་པ་བཞིན་དུ་འདིའི་བསྐྱེད་པར་བྱ་བ་སྟེ་ཚུལ་གསུམ་པའི་རྟགས་ལས་བྱུང་བ་ཡིན་ནོ།",
    "གཞན་ཡང་ཐམས་ཅད་དུ་སྒྲུབ་པར་བྱེད་པ་ནི་རྗེས་སུ་དཔག་པ་དང་འགལ་བ་ཡིན་ཏེ།",
    "འདི་ནི་རྗེས་སུ་དཔག་པ་ཐམས་ཅད་རྗེས་སུ་དཔག་པ་མ་ཡིན་པར་བསྒྲུབས་པ་ཡིན་ནོ།",
    "ཐམས་ཅད་རྗེས་སུ་དཔག་པ་ཁྱད་པར་དང་འགལ་བ་ཡང་ཡིན་ཏེ།",
    "དཔེར་ན་སྒྲ་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན་ནོ་ཞེས་བྱ་བའི་སྦྱོར་བ་ལ།",
    "ཁ་ཅིག་ཁྱད་པར་དང་འགལ་བ་སྟོན་པར་བྱེད་དོ།",
    "ཇི་ལྟར་གཏན་ཚིགས་འདི་མི་རྟག་པ་སྒྲུབ་པར་བྱེད་པ་དེ་བཞིན་དུ་ནམ་མཁའི་ཡོན་ཏན་མ་ཡིན་པ་ཉིད་ཀྱང་ངོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པའོ།",
    "བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན་ནོ་ཞེས་བྱ་བའི་སྦྱོར་བ་ལ།",
    "ཁ་ཅིག་སྒྲ་ནི་རྟག་སྟེ་མཉན་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་སྒྲ་ཉིད་བཞིན་ནོ་ཞེས་བྱ་བས་འགལ་བ་མི་འཁྲུལ་པ་ཅན་དུ་འཆད་དོ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔག་པའི་ཁོང་དུ་འདུ་བར་ངེས་པར་བྱ་མི་ནུས་ཏེ།",
    "ལྷ་སྦྱིན་ནི་ཁུར་ཁུར་བར་ནུས་པ་མ་ཡིན་ཏེ།",
    "ལྷ་སྦྱིན་ཡིན་པའི་ཕྱིར་བྱེས་པའི་གནས་སྐབས་ཀྱི་ལྷ་སྦྱིན་བཞིན་ནོ་ཞེས་དེ་ལྟར་རྗེས་སུ་དཔག་པ་ལས་ངེས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་ཆུ་ཐམས་ཅད་གྲང་བ་ཡིན་ནོ་ཞེས་ངེས་པར་བྱ་བར་མི་ནུས་སོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པའོ།"
  ]
}