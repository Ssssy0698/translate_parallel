    "རོལ་མོའི་སྒྲ་དབྱངས་དང་བཅས་སྤྱན་འདྲེན་ཞུས་ཏེ།",
    "དངུལ་གྱི་རྣམ་རྒྱལ་མཆོད་རྟེན་རྣམས་ཀྱི་ནང་བཞུགས་རབ་གནས་མཛད་དུས་མེ་ཏོག་གི་ཆར་ཆེན་པོ་བབས་པ་ཡོངས་ལ་གསལ་ཞིང་།",
    "དེ་ལོ་རྗེ་བྱ་བཏང་པ་ཞིང་བརྗེས་པའི་ཕྱག་རྫས་གསེར་གཡུ་སོགས་དངོས་པོ་བསམ་གྱིས་མི་ཁྱབ་པ་རྗེ་རང་གི་ཞལ་ཆེམས་ལྟར་ཞབས་དྲུང་དུ་ཕུལ་བ།",
    "སེམས་བསྐྱེད་སྐབས་བླ་བྲང་གི་ཞིང་གཤོངས་མའི་ཁར་བཞུགས་ཁྲི་བརྩིགས་ནས་གནང་དགོས་པ་བྱུང་ཞིང་།",
    "གཙང་སྟོད་ཀྱི་སྣར་ཐང་པ་སོགས་དཔོན་རྣམ་པ་ཐ་དད་མཇལ་བ་ལ་བྱོན་པའི་གུར་དཀར་ནག་གིས་ས་གཞི་ཁེབ་པ་ཙམ་བྱུང་ཞེས་སྒྲོག་ཅིང་།",
    "ངེད་རང་གི་སྔོན་འགྲོའི་དགེ་རྩ་ལ་དམིགས་པ་ཡིན་པས།",
    "ས་ག་ཟླ་བའི་ཉེར་ལྔའི་རྗེ་རྡོ་རྗེ་འཆང་གི་དུས་ཆེན་སྟེང་དུ།",
    "འོད་དཔག་མེད་ཀྱི་མདུན་དུ་ང་རང་གི་གཟུགས་གཅིག་ཀྱང་པདྨའི་སྟེང་དུ་ཡོང་བ་བྲིས་གསུངས་ཤིང་།",
    "ཟམ་སྣེར་རྟ་མོ་ལུང་གང་གི་སྐྱ་སེར་རྣམས་ལ་སེམས་བསྐྱེད།",
    "ཕ་དམ་པའི་སྐྱེ་བདུན་རེ་ཕྱག་གིས་སྩལ་བར་མཛད་ནས།",
    "བཟང་སྤྱོད་ཅིག་གི་དབུ་རྗེ་ཉིད་ཀྱིས་དྲངས་ནས་བཞུགས་ཁྲི་ཁ་ནས་བཞེངས་ཕེབས་པའི་ཚུལ་བསྟན་ཅིང་།",
    "དེ་སྐབས་ཟླ་བ་བདུན་པའི་བཅུ་བཞི་ལ་ས་ནག་བྲག་ལུང་པ་ཡིན་པའི་བུད་མེད་སྐལ་དམན་གཅིག་གིས་སྐུ་གཟན་ཞིག་ཕུལ་བའི་རྐྱེན་བྱས་བསྙེལ་ཚུལ་བསྟན་ཟླ་བ་བདུན་པའི་ཚེས་བཅུ་བདུན་ཉིན་གསུང་ངག་གི་དམིགས་པའི་འཕྲོ་རྣམས་ཤར་པ་ཞིག་གསུངས་ནས།",
    "ཁོང་གིས་ཕྱག་གི་དབུས་སུ་ནོར་བུ་གཅིག་བཟོས་ནས་གཟིགས་འབུལ་བྱས་པས།",
    "དཀར་མེ་ཆ་རྐྱེན་རྣམས་དམིགས་སུ་འཁྱོལ་བ་དང་།",
    "ང་རང་གི་དུས་མཆོད་སོགས་ལ་སྦྱོར་བ་དང་།",
    "ཚེས་དྲུག་གི་ཉིན་ཁང་གསར་བའི་བདག་མོ་སོགས་གཤིན་པོ་འགའི་མིང་བྱང་ཀུན་རིག་གི་ཆོ་ག་དག་གསལ་དང་བཅས་ལྷོ་སྒོ།",
    "སྤྱན་བར་སྣང་ལ་ཁྲོལ་གཟིགས་པ་དང་།",
    "ཐོགས་པ་མེད་པར་ཐལ་གྱིས་གཤེགས་པ་ཉིད་དོ།",
    "ཚེས་བཅུ་བདུན་ཉིན་མན་བདག་ཆེན་འཇམ་པའི་དབྱངས་ས་ལོ་ཐམས་ཅད་མཁྱེན་པའི་དྲུང་གིས་བདེ་མཆོག་ནག་པོ་པའི་སྒྲུབ་མཆོད་དང་།",
    "ལུགས་ཕུད་རྗེ་རང་གི་སྐུ་འདྲ་མདའ་གང་ཙམ་དང་།",
    "དེ་དག་གིས་ནི་བདག་ཅག་གི་རྣམ་འདྲེན་དམ་པ་རྗེ་བཙུན་མུས་པ་ཆེན་པོ་བུདྷའི་མཚན་ཅན་དེ་ཉིད་ཀྱིས།",
    "བློ་ཆུང་བློ་དམན་བདག་གིས་མཚོན་པ་ཙམ་འདི་སྤེལ།",
