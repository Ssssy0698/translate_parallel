    "བུད་མེད་ཀུན་ལ་ལོངས་སྤྱོད་དོ།",
    "ཤེལ་གོང་དཀར་པོ་རྫལ་ཏུ་བསྙུབཨོ་གི་བྱ་། སྣོད་ངན་ནང་དུ་སེང་གེའི་འོ་མ་བཞོ།",
    "བྱ་ཡི་རྒྱལ་པོ་ཁྱུང་གི་གཤོག་མི་བཅག།",
    "སྟག་གཟིག་རོལ་པའི་ཟས་ཀྱི་ལྷག་མི་བཟའ།",
    "བཟླས་བརྗོད་དང་ཆོ་གའི་རྒྱུན་ཁྱེནམི་ཚིག་གིས་བར་མི་གཅོད།",
    "དམག་འཁྲུག་དང་ཚོངགི་གཏམ་ལ་སོགས་པའི་ངག་འཁྱལ་གྱི་རིམ་པ་དང་།",
    "རང་གིས་བསད་པའི་ཤ་མ་གཏོགས་གཞན་པ་མི་བཟའ་ཞིང་གོས་དཀར་དང་།",
    "བྱ་གག་གི་བཏུང་བ་འབའ་ཞིག་བསྟེན་པ་སོགས་ལྷ་མིན་གྱི་འཇུག་པཅན་ཀླ་ཀློའིཚོས་ལུགས་ལ་སྤྱོད་པ་དང་ལྟ་ཡིན་པས་སྤང་ངོ།",
    "རྡོ་དེ་ཉིད་ཀྱི་ཕྱིར་བ་སྙེག་གིས།",
    "རེག་བྱ་རྣམས་ཀྱིས་གནོད་པར་འགྱུར་རོ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "དམ་ཚིག་གིས་ནི་ཕྱག་རྒྱ་ཆེར།",
    "ཞེས་པའི་སྒྲདྲིལ་བུས་སྒྲོག་པར་མོསནས་དཀྲོལ་ཞིང་དེའི་སྒྲ་ལ་ངེས་ཤེས་དྲངས་པའི་འབྲས་བུ་ནི།",
    "ཕྱི་ལྟར་དུ་ཟང་ཟིང་གི་སྦྱིན་བ་གཏོང་བ་ཆེ་ཆུང་གི་དབྱེ་བས་བཞག་པ་དང་།",
