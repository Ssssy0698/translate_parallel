    "རྒྱུ་པྱཡོངས་སུ་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་སྣ་ཚོགས་གྲགས་པ་ལོངས་སྤྱོད་སྟོན་པར་བྱེད་དོ།",
    "ཡང་ན་ཁྱབ་པར་བྱེད་པའི་ཕྱིར།",
    "ཡང་ན་ཡང་དག་པར་བདེ་བ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱི་རང་བཞིན་གྱི་ངོ་བོ་ཡོངས་སུ་ཤེས་པས་རྣམ་པར་སྨིན་པའི་ངོ་བོ་ཉིད་ཀྱི་དགའ་བ་སྐྱེད་པར་བྱེད་དོ།",
    "སྦྱོར་བ་མེད་པ་འཆད་པར་འགྱུར་རོ།",
    "རྣམ་པར་དཔྱོད་བྱེཔ་ལ་རྒྱུ་ཡང་སྦྱིན་ནོ།་།",
    "རི་བོང་ཅན་གྱི་མཚན་ཉིད་སྲོག་མའི་འོག་ཏུ་ནང་དུ་འཛིན་པར་བྱེད་དེ།",
    "དབུས་སུ་ཉིད་ཀྱི་རྟེན་མེད་པའི་གཉིས་སུ་མེད་པའི་མཚན་ཉིད་ཀྱིས་རོལ་པར་བྱེད་དོ།",
    "རྣམ་པར་འབྱེད་པ་ལ་ཡང་སྒྱུ་སྦྱིན་ནོ།",
    "ཀྵེའི་རྣམ་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་འབྱེད་པའོ།",
    "མ་རིག་པའི་སྤྲིན་གྱིས་ཁྱབ་པ་འོད་ཉི་མ་སྟོང་ལ་ལམ་དག་པར་བྱེད་དོ།",
    "ཡང་དག་པར་ཡེ་ཤེས་སྐྱེ་བའི་རྒྱུ་བདག་ལ་ཡོད།",
    "གཞན་རྣམས་ཀྱིས་རྙེད་པར་དཀའ་བའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་རྙེད་པར་དཀའ་ཞེ་ན།",
    "རྒྱས་པར་མ་ཡིན་ཞེས་བྱ་བ་ནི་གསུམ་པ་ཉིད་དུ་ངེས་པའོ།",
    "རྒྱས་པར་མིན་ཞེས་བྱ་བ་ནི་འཁོར་ལོ་སྡོམ་པ།",
    "རྒྱས་པར་མ་ཡིན་བཅོམ་ལྡན་འདས།",
    "སྦྱོར་ཞེས་བྱ་བ་ནི་ཀུན་རྫོབ་ཀྱི་ཡེ་ཤེས་ལ་མཉམ་པར་འཁྱུད་པ།",
    "དགྱེས་པ་ཞེས་བྱ་བ་ནི་འདབ་མ་གསུམ་པར་སྤྱོད་པའོ།",
    "སྤྱོད་པ་ཙམ་གྱིས་ནི་ཉིད་རྫོགས་པར་འགྱུར་ཞེས་དགོངས་པའོ།",
    "རང་བཞིན་དགའ་བ་ནི་ཀུན་རྫོབ་ཀྱི་གཟུགས་བཟུང་བ་ཙམ་ཀྱིས་ཡང་དག་པར་མི་རྙེད་དོ།",
    "ཐམས་ཅད་བདག་ཉིད་རྟག་ཏུ་བཞུགས།",
    "རང་བྱུང་ནི་གཞན་མས་མ་བྱས་པའི་ཕྱིར་དགོངས་པའོ།",
    "དེའི་ནང་ན་བཞུགས་ན་ཡང་དེ་ལས་མ་སྐྱེས་པ།",
    "ཡང་ན་སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པར་འཛིན་པ་བཅོམ་པའི་ཕྱིར།",
    "འཇིག་པར་བྱེད་པའི་ང་རྒྱལ་བཅོམ་པའི་ཕྱིར་བཅོམ་ལྡན་འདས།",
    "རྣམ་པར་རྟོག་པ།",
    "ཡང་ན་ཆད་པ་རྣམ་པར་འབྱེད་པའི་སྦྱོར་བ་ལས་གཤེགས་ཞེས་དགོངས་པའོ།",
    "འཇིག་རྟེན་གསུམ་དུ་རྙེད་པར་དཀའ།",
    "མེད་པ་མ་ཡིན་ཞེས་བྱ་བ་ནི་དེས་ཀུན་རྫོབ་ཀྱི་རྣམ་པའི་སྣང་བའི་བརྡར་བྱས་སོ།",
    "ཞེས་བྱ་བའི་ཚིག་གསུངས་སོ།",
    "ཉམས་སུ་མྱོང་བ་ནི་ཡེ་ཤེས་ཀྱི་ངོ་བོས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་ཚོར་བ།",
    "རང་བཞིན་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་མེད་པ་ལས་རྣམ་པར་འདས་པ།",
    "ཕྱི་མ་ཡིན་པས་འཇིག་རྟེན་གསུམ་དུ་རྙེད་པར་དཀའ་བས།",
    "རྙེད་པར་དཀའ་བ་ནི་མཚན་མ་དང་བཅས་པའི་དགའ་བ་ལ་སོགས་པ་མི་ཐོབ་པའོ།",
    "སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པར་བསྟན་པ་ལས།",
    "ཞེས་གསུངས་སོ།",
    "དངོས་རྟེན་རྣམ་པར་འབྱེད་པ་ལ།",
    "ཇི་བཞིན་གནས་ལ་སོགས་པར་བསྟན།",
    "དེ་དག་མ་ཁྱབ་པའི་ཕྱིར་རྣམ་པར་འབྱེད་པ།",
    "རྣམ་པར་འབྱེད་པ་ནི་གཉིས་སུ་དབྱེ་སྟེ།",
    "རྟེན་གྱི་རྣམ་པར་འབྱེད་པ་དང་།",
    "དེ་བཞིན་དུ་བརྟན་པའི་རྣམ་པར་འབྱེད་པའོ།",
    "གང་ཞིག་ཡེ་ཤེས་ལ་ལྡུང་བ་དེ་ནི་རྟེན་གྱི་རྣམ་པར་འབྱེད་པ།",
    "ཡེ་ཤེས་ལ་སོགས་པ་རྣམ་པར་འབྱེད་པ་བྱས་ནས་ཤར་དང་ནུབ་དང་བྲལ་བའི་ཚུལ་གྱི་ནམ་མཁའ་ལ་གང་ཞིག་སྣང་བ་མེད་པ་དེ་ནི་རྟེན་པའི་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་རྟག་ཏུ་དངོས་པོ་དང་རྟེན་དང་ཡེ་ཤེས་དང་རྣམ་པར་འབྱེད་པའི་རང་བཞིན་ཞུགས་ཞེས་དགོངས་པའོ།",
    "དབུས་ནི་རྟེན་མེད་པའི་རང་བཞིན་བཞུགས་པའོ།",
    "སོགས་པའི་སྒྲ་ནི་རྟེན་མེད་པ་ཇི་ལྟར་རྟེན་དང་བཅས་པ་བསྟན་པ་དེ་ལྟར་དེ་རང་རྟེན་མེད་པར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ལས་ཀྱི་ཕྱག་རྒྱ་དང་མཉམ་པར་འཁྱུད་པས་ལྟ་བ་སྤྱོད་ཅིང་གཉིད་སྐྱེའོ།",
    "གནས་ལ་སོགས་པ་འདིར་ས་རྣམས་ཀྱི་དོན་གྱིས་དགའ་བ་ལ་སོགས་པ་ཤེས་པར་བྱའོ།",
    "དེ་ལ་མཉམ་པར་སྦྱོར་བ་ལས་ཡེ་ཤེས།",
    "དེ་ལ་ཧའི་རྣམ་པའི་འདོན་པས་རྣམ་པར་འབྱེད་པས།",
    "སྲུབ་དང་བསྲུབ་ཐབས་སྤྱད་པར་བྱ།",
    "དེ་བཞིན་སྔགས་དང་ལྡན་པར་བྱ།",
    "ཇི་ལྟར་མེ་ཏོག་མེད་པར་དྲི་མི་རྙེད།་།",
    "ཡང་ན་ཡེ་ཤེས་ཀྱི་དགོངས་པ་མ་ནིང་རྟགས་ཀྱིས་ངེས་པར་བསྟན་པའོ།",
    "བདེ་བ་ཆེན་པོ་ཡང་དག་པར་ཁོང་དུ་ཆུད་པས་འཛུམས་པའི་དངོས་པོ་ཆུང་བ་མི་འགྲོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྤྱོར་བ་ཀྱེཉིད་ཆོ་གའི་ཡེ་ཤེས་ཞེས་བྱ་བ་ལ་སྦྱོར་བ་ནི་མཉམ་པར་སྤྱོར་བ་ཤེས་རབ་ཐབས་ཡང་དག་པར་འཁྱུད་པ་ཉིད་ཅེས་བྱ་བ་ནི་རྒྱུ།",
    "རྒྱུད་ལས་གསུངས་པ་མཉན་བྱེད་པར་གྱིས།",
    "སྦྱོར་བའི་ཆོ་གའི་ཡེ་ཤེས་གང་ཞིག་རྒྱུད་ལས་གསུངས་པ་དེ་ཉོན་ཅིག་ཅེས་འབྲེལ་བའོ།",
    "ཡང་ན་བརྟན་པ་དང་ངེས་པར་བརྟན་པར་གྲགས་པ།",
