    "སྐྱ་གང་ལྟར་འདོད་པ་བཞིན་ཚོན་ཁ་བསྒྱུར་བའི་ཐོག་མ་ནས་ཚོན་མང་ཉུང་གིས་བྱ་ལ།",
    "བསྒྱུར་ཟིན་པའི་ཅོང་ཕྱེ་ལ་དཀར་པོ་སོགས་བསྲེས་ནའང་ཕྱེ་རྩིང་པའི་རྐྱེན་གྱིས་གཅིག་ཏུ་འདྲེས་མི་ནུས་ཤིང་ཚོན་ཁྲ་བོ་ཞིག་ལས་མི་འོང་བ་རྡུལ་ཚོན་གྱི་བྱེ་མའི་ཁྱད་པར་ཡིན་པ་ཤེས་གལ་ཆེ།",
    "སྒྲུབ་མཆོད་ཀྱི་ཟིན་བྲིས་སོགས་ལས་ཇི་ལྟར་གསུངས་པ་བཞིན་ཚང་ལ་མ་ནོར་བ་འོག་ནས་སྟེང་དང་དབུས་ནས་མཐའ་རུ་རིམ་པ་བཞིན་བླུག་མཐའ་སྐོར་གྱི་མེ་རི་པ་ཏྲ་དང་པད་འཁོར་སོགས་གཅིག་མཚུངས་ཀྱི་རི་མོ་རྣམས་རེ་རེ་བཞིན་བླུག་དཀའ་བས།",
    "རྡུལ་ཚོན་གྱིས་ཐང་ཀ་བྲིས་པ་ལྟ་བུའི་རི་མོ་ཞིབ་ཅིང་ཕྲ་བ་མི་འོང་ལ།",
    "རི་མོ་ཞིབ་དྲག་ན་བཀྲག་མདངས་ཆུང་བ་དང་།",
    "གང་བླུག་པའི་རི་མོ་ཐམས་ཅད་རགས་ཤིང་ཉམས་ཅན་དུ་བྱའོ།",
    "༡༡སྦྱིན་སྲེག་གི་ཐབ་ཐིག་འདེབས་ཐབས།",
    "སྦྱིན་སྲེག་བླུག་པའི་སར་ས་ཆོག་དང་གཏོར་མ་བསྔོ་བ་སོགས་སྔོན་དུ་སོང་ནས།",
    "མེ་ཐབ་ཏུ་བུད་ཤིང་རྩིག་བསྲེག་རྫས་བསགས་ཏེ་སྦྱིན་སྲེག་གི་ལུགས་གང་ཡིན་པའི་གཞུང་ནས་ཇི་ལྟར་གསུངས་པའི་སྟ་གོན་ཕུན་སུམ་ཚོགས་པ་གྲུབ་མཐར།",
    "དགྲ་བགེགས་དང་ཉོན་མོངས་དུག་ལྔ་ཐམས་ཅད་མེ་ཡིས་བསྲེགས།",
    "ཚངས་ཐིག་སྟེང་གི་ཚད་གསུམ་གྱིས།",
    "གོང་གི་སྦྱིན་སྲེག་ཐབ་ཐིག་འདེབས་ཐབས་གཞུང་བསྡུས་འདི་ནི་ཐབ་ཐིག་སྤྱིའི་འགྲོས་ཙམ་དུ་བཀོད་པ་ཡིན་གྱི།",
    "དགེ་ཕྱོགས་ལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་སྒོ་ནས་སྦྱིན་སྲེག་གི་ཆོ་ག་སྣ་ཚོགས་སུ་སྣང་བ་རྣམས་ཏེ།",
    "དེ་དག་གི་ཐིག་དང་།",
    "ལག་ལེན་ཐམས་ཅད་རང་རང་གི་གཞུང་དང་བསྟུན་པ་གལ་ཆེའོ།",
    "དེ་ལ་གྲོ་ཕྱེ་དང་ཡང་ན་ས་དཀར་བྱུགས་ཏེ་སྦྱིན་སྲེག་བླུག་ཐབ་ཀྱི་ས་ཐོག་ཏུ་ལྟེབ་མཐུད་ཀྱི་ཚུལ་དུ་དཔར་བ་ནི་སྦྱིན་སྲེག་གི་ཐབ་ཐིག་སླ་ཐབས་དང་མགྱོགས་ཐབས་ཡིན་ལ།",
    "སྲོལ་དེ་ནི་ཆེས་སྔ་མོ་ཞིག་ནས་བོད་དུ་དར་བ་ཡིན་ལ།",
    "རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོས་རང་གི་དཀོར་ཆ་རྣམས་ཕྱི་རབས་གཙུག་ལག་ཁང་གི་གསོས་སུ་བསྔོས་ནས་སྦས་པ་ལ་སོགས་ཀྱི་ནོར་གཏེར་དང་།",
    "བོད་དུ་བསྒྱུར་བའི་ཕྱི་མོ་རྒྱ་གར་པཎ་ཆེན་རྣམས་ཀྱི་ཕྱག་དཔེ་རྒྱ་དཔེ།",
    "དེ་ལ་འགའ་ཞིག་གིས་གཏེར་སྟོན་ནི་རྙིང་མ་བ་ཁོ་ན་ལས་མེད་པ་དང་།",
    "དོན་གྱི་གཏེར་མར་སོང་བའི་ཕྱིར་དང་།",
    "རྒྱལ་སྲིད་ཉམས་ནས་ཚང་མ་མེད་མོད་བསམ་ཡས་གཙང་པོའི་མཛོད་དུའང་མང་པོ་ཡོད་པས་ཁྲོ་ཕུ་ལོ་ཙཱ་བ་ཆེན་པོས་ལྷ་ཆེན་པོའི་ཡོ་བྱད་མ་ལྡང་ནས་ཁོང་རང་གི་འབུལ་བ་ཕྱིར་བསློག་སྟེ་ཁ་བྱང་འགའ་ཞིག་བསླངས་པ་ན།",
    "གཙང་པོ་ན་རེ།",
    "པཎ་ཆེན་གྱིས་དེས་ཁོང་ལའང་གནོད་པས་ཁྱེད་རང་འདི་སྒྲུབ་གསུང་ནས་ཛམ་ནག་གི་སྒྲུབ་ཐབས་གནང་བ་ལྟར་ཡིན་ལ།",
    "བཀའ་གདམས་གསར་རྙིང་གི་སྔོན་བྱོན་སྐྱེས་མཆོག་རྣམས་ཀྱིས་གཏེར་བཞེས་ཚུལ་ལའང་བཙན་པོ་སྲོང་བཙན་སྒམ་པོ་རང་གི་བཀའ་ཆེམས་ལེའུ་ཀ་པ་ནས་ཁོལ་བཏོན་གྱིས་ལྷ་ལྡན་གཙུག་ལག་ཁང་གི་ཀ་བ་ཤིང་ལོ་ཅན་གྱི་ལོགས་སུ་གཏེར་དུ་སྦས་པ་དེ་ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤས་གཏེར་ནས་བཏོན་པར་བཀའ་ཆེམས་ཀ་ཁོལ་མའམ་ལྷ་སའི་དཀར་ཆག་ཏུ་གྲགས་པ་དང་།",
    "སྐུ་འབུམ་བྱམས་པ་གླིང་གི་སྟེང་ཀུན་དགའ་ར་བ་སྒོ་ཁྱིམ་བཅུ་པའི་ནང་དུ་གནམ་ལྕགས་ལས་གྲུབ་པའི་ཨོ་རྒྱན་ཆེན་པོའི་སྐུ་བརྙན་ཡེ་ཤེས་པ་མངོན་དུ་ཞུགས་པའི་བྱིན་ཅན་དང་།",
    "མར་ནི་རང་རེའི་ཡུལ་དུ་ཆེས་སྔ་མོ་ཞིག་ནས་ཡོད་ཅིང་།",
    "ཉི་ཟླ་ལ་སོགས་བཀྲ་ཤིས་པའི་མཚན་མའི་རི་མོ་མར་ལས་བྱས་པས་བརྒྱན་པ་དང་།",
    "གསོལ་སྟོན་གྱི་ཐོག་མར་ལུག་མགོ་བཙོས་མ་ལ་དཀར་རྒྱན་བྱས་ཏེ་ཟས་ཀྱི་ཐོག་མར་དྲངས་ཚུལ་བདག་གིས་དངོས་སུ་མཐོང་བ་མ་ཟད།",
    "དེ་ཐམས་ཅད་བོད་ལུགས་ཀྱི་ཤུགས་རྐྱེན་ཡིན་ཞེས་སོག་རིགས་ཀྱི་སྦྱིན་བདག་གིས་ལབ་པ་ཐོས་པས་སོ།",
    "ར་ས་འཕྲུལ་སྣང་གཙུག་ལག་ཁང་གི་ཕྱིའི་སྐོར་ལམ་གྱི་རྡོ་རིང་འགྲམ།",
    "རི་ཀླུང་དང་ཁང་བཟང་གི་བཟོ་ཁྱད་ཡུལ་སྣང་སོགས་གནས་དེར་དངོས་སུ་ལྷགས་པའི་འཁྲུལ་སྣང་སྐྱེ་ནུས་པ།",
    "ཐ་ན་དུད་ཚང་ཞིག་གི་གླུད་གཏོར་ཞིག་བསྔོ་ནའང་དཀར་རྒྱུན་མཚོན་ཙམ་ཞིག་དགོས་པ་དང་།",
    "བྱང་གི་དགོན་ཆེན་བཞི།",
    "རྒྱ་ནག་གི་དགའ་ལྡན་བྱིན་ཆགས་གླིང་།",
    "མར་རྡུང་བྱེད་ཀྱི་སྟག་པ་ཤིང་གི་ཤིང་ཐོ།",
    "མར་དང་འབྲི་མོག་མར་ཁུ་བཞུ་སྣོད་ཀྱི་བཞུ་སྐྱོགས་མཆུ་ཅན་གཉིས།",
    "འཇོག་ཡུན་རིང་ཐུང་གི་སྒོ་ནས་བརྟགས་ཏེ་བྱ་ལ།",
    "ཡུན་ཐུང་གི་སྒྲུབ་གཏོར་སྐོར་ཡིན་ན་ཆུ་འཇམ་གྱིས་རྩམ་པ་བརྫིས་ནས་གཏོར་གཞི་བཅའ།",
    "དཀར་རྒྱུན་མ་བཟོས་པའི་ཐོག་མར་ཤིང་གི་གཞོང་པའི་ནང་དུ་མར་མི་འགོས་པའི་མཁྲེགས་ཤིང་སྟག་པ་ལས་བཟོས་པའི་འདུལ་ཐོས་དུལ་ངེས་བརྡུང་།",
    "དེ་ནས་ཆུ་གྲང་མོའི་ནང་དུ་ལག་པས་སྣོ་མྱུར་ལེགས་པར་བྱའོ།",
    "དམར་གཏོར་ཡུན་ཐུང་གི་རིགས་ལ་མར་ཁུས་སྦྱངས་པའི་འབྲི་མོག་མར་ཁུ་བྱུག་ཡུན་རིང་ཉར་བྱའི་མཆོད་གཏོར་ཡིན་ན།",
    "འབྲི་མོག་མར་ཁུ་བྱུག་ན་ཟླ་ཤས་སོང་རྗེས་འབྲི་མོག་གི་ཚོས་ལད་ནས་དཀར་རྒྱུན་ཐམས་ཅད་དམར་པོར་འགྲོ་བའི་སྐྱོན་དང་བཅས་པ་སྟེ།",
    "གཤམ་དུ་འཆད་འགྱུར་ལྟར་གཏོར་རྩི་ལེགས་པར་བཟོས་པའི་ནང་འབྲི་མོག་བླུགས་ནས་དྲོ་འཇམ་ཚད་རན།",
    "མར་ཚོན་སྦྱོར་བ་དང་དཀར་རྒྱན་དངོས་བྱེད་སྐབས་རྒྱ་ནག་གི་འདག་རྫས་ཤིང་འབྲས་ཇོའི་ནང་དུ་སྦངས་པ་དེའི་ཁུ་བ་ལག་པར་བྱུག་པ་ནི།",
    "ཐོག་མར་གསེར་ཤོག་སྲབ་མོ་སྤུས་ལེགས་དེ་ཇའི་ནང་དུ་སྦངས་ལེན་གྱིས་ཤོག་སྲབ་སྟེང་དུ་སྦྱར།",
    "དེ་ནས་གསེར་ཤོག་གི་ངོས་མར་རྒྱུན་གྱི་ཕྱོགས་སུ་བསྟན་ཏེ་ཤོག་སྲབ་གསེར་ཤོག་དང་བཅས་པ་དཀར་རྒྱན་གྱི་ཐོག་ཏུ་སྦྱར།",
    "དེའི་སྟེང་ནས་མེ་གཟོང་སོགས་ཀྱིས་རི་མོ་གཏོར་མཐར་ཤོག་བུ་བླངས་ནས་གྲུབ་པོ།",
    "དཀར་རྒྱན་མེ་ཏོག་གི་ཟེའུ་འབྲུ་དང་ཤིང་ལོ་བཟོ་ཐབས་ནི།",
    "ཚགས་དམ་པོ་མ་ཡིན་པའི་རས་ཀྱི་རིགས་མཐོ་གང་བ་སོགས་ལག་ཏུ་འཛིན་བདེའི་དབུས་སུ་གང་ལྟར་འདོད་པའི་ཟེའུ་འབྲུ་ཆེ་ཆུང་གི་ཚད་ཀྱི་ལི་ཁྲི་སྐམ་ཕྱེའི་ཐིག་ལེ་ཟླུམ་པོ་བྱ།",
    "དེ་ལ་ལེགས་པར་བསྒོས་པའི་མཆོད་མར་དཀར་པོ་ལག་པས་འཇོང་འཇོང་དུ་བཅོས་པ་དེའི་སྣེ་མོ་ལི་ཁྲི་ལ་གཏད་ནས་རས་ཀྱིས་བཏུམས་ཏེ།",
    "གཏོར་རྩི་བྱུག་པར་གར་སླ་དང་དྲོ་གྲང་གི་ཚོད་མ་ཟིན་ནས་གར་ཆེ་ན་སྐམ་མཐའ་གོག་འགྲོ།",
    "སྒྲ་རྒྱན་གྱི་བྱ་དཀའ་བ་ཀུན་ཏུ་བཟང་པོའི་འཁོར་ཚུལ་དང་མཐུན་པའི་ཚོན་སྣ་ཚོགས་ཀྱི་རེའུ་མིག་གི་ལྟེ་བར་གྱུར་པའི་རི་མོ་དང་ཡང་ན་རྟགས་བརྒྱུད་དང་དཔལ་བེའུ་སོགས་གང་ལ་གང་འཚམ་པའི་རི་མོའི་གཞིར་སྣོད་བཅུད་བསྟོད་པའི་སྙན་ངག་གཙོ་བོར་གྱུར་པའི་ཚིགས་བཅད་ཚིག་སྙན་ཞིང་དོན་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་བྲིས་ཤིང་།",
    "གསེར་གྱི་རྒྱ་ཕིབས་སོགས་སྟེང་དུ་དགོད་པར་འོས་པའི་རི་མོ་དང་།",
    "ཏིང་འཛིན་ཞི་ཉིད་རིག་ཅིང་གཟིགས།",
    "ཉོན་མོངས་ཚོགས་བཅོམ་མགོན་པོ་མཆོག།",
    "ཞེས་ཚིག་རྐང་གི་རིམ་པར་ཨེ་དང་།",
    "སྐབས་དེར་དེང་གི་ཀུན་འཁོར་དང་མཚུངས་པའི་ཚིག་རིས་སྤེལ་མ་བྱེད་པའི་སྲོལ་ཡོད་མེད་མ་ངེས་ཀྱང་།",
    "ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་གཙོས་པའི་གཙུག་ལག་བརྒྱ་རྩ་བརྒྱད་བཞེངས་པའི་ནང་།",
    "སྙན་ངག་དང་སྙན་ངག་གི་བསྟན་བཅོས་རྩོམ་མཁན་མང་པོ་བྱུང་།",
    "ཀོང་སྤྲུལ་ཡོན་ཏན་རྒྱ་མཚོས་མཛད་པའི་རྡོ་རྗེ་སེམས་དཔའ་དཔལ་བདེ་བ་ཆེན་པོའི་རྒྱལ་བ་བྱ་དཀའ་བའི་རྣམ་འགྱུར་མང་པོས་བསྔགས་པ་སྣང་བྱེད་ཉི་མའི་རོལ་རྩེད་ཨེ་ཝཾ་འཕྲུལ་གྱི་རོལ་མོ་ཞེས་བྱ་བ་ལ་སོགས་རྟགས་བརྒྱད་ཟུང་ལྡན་དུ་སཾ་བོད་ཤན་སྦྱར་གྱིས་བྲིས་པ་ཤིན་ཏུ་ངོ་མཚར་བ་དང་།",
    "དེང་དུས་བོད་ཀྱི་སྙན་ངག་གི་བསྟན་བཅོས་ཐམས་ཅད་ཀྱི་རྩ་བ་ནི།",
    "སྔོན་རྒྱ་གར་གྱི་ཡུལ་དུ་མཛེས་པའི་དཔེ་སྟོན་པ་ལ་མཆོག་ཏུ་མཁས་པའི་སློབ་དཔོན་ནག་མོ་ཁོལ་དང་།",
    "སྙན་པའི་ཉམས་འདོན་པ་ལ་མཆོག་ཏུ་མཁས་པ་སློབ་དཔོན་དབྱུག་པ་ཅན་ཏེ་སྙན་ངག་གི་སློབ་དཔོན་ཆེན་པོ་གསུམ་བྱུང་བའི་ནང་ནས་སློབ་དཔོན་དབྱུག་པ་ཅན་གྱིས་བརྩམས་པ་དེ་ཡིན།",
    "སྙན་ངག་གི་རྒྱུན་གྱི་རྩ་བ་ལ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་རྒྱན་དང་དོན་རྒྱན་དང་།",
    "དེ་དག་ལ་ནང་གསེས་ཀྱི་དབྱེ་བ་ཤིན་ཏུ་མང་པོ་བྱར་ཡོད་པ་ལས་རི་མོ་དང་སྤེལ་མ་བྱེད་པའི་སྙན་ངག་ནི་ཕལ་ཆེར་སྒྲ་རྒྱན་གྱི་ནང་གསེས་བྱ་དཀའ་བ་བ་ལང་གི་གཅིན་འགྲོས་དང་།",
    "བ་ལང་གི་གཅིན་འགྲོས་ནི།",
    "ཚིག་རྐང་གི་ཕྱེད་ཕྱི་མ་ལུགས་ལྡོག་ཏུ་བཀླགས་པ་དང་གཡོན་ཟུར་གྱི་རྩེ་ནས་ཐུར་དུ་བཀླགས་པ་གཉིས་མཚུངས་ལ་བར་མ་གཉིས་གྱེན་དུ་བཀླགས་ན་སྔ་མ་སྔ་མ་དང་འདྲ་ཞིང་།",
    "ཀུན་མཁྱེནམཆོག་མཆོག་ཁྱོདདཔལ་མཁྱེན།",
    "འདིའི་གོང་གི་དཔེ་བརྗོད་གཉིས་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱིས་མཛད་པའི་སྙན་ངག་ལ་འཇུག་ཚུལ་ཚིག་རྒྱན་རིག་པའི་སྒོ་འབྱེད་ལས་བཤུས་ཤིང་།",
    "ཀུན་འཁོར་གྱི་དཔེ་བརྗོད་ཀུན་འཁོར་སྒོར་མོ་བི་དར་བྷའི་ལུགས་དང་།",
    "རྒྱུད་ལས་སྐྱེས་པའི་རོལ་མོ་ཏམྦུ་རའི་ཚོགས་མང་པོ་རྒྱུད་གཅིག་པ་ནས་རྒྱུད་བརྒྱའི་བར་གྱི་རྒྱུད་མང་གི་སྒྲ་སྙན་གྱི་རིགས་དང་།",
    "ཕེབ་རྡོབ་ལ་སོགས་སྐད་ལི་ལས་བྱས་པའི་རོལ་མོའི་རིགས་དང་།",
    "གཙུག་ལག་ཁང་གི་བར་སྒོར་གདགས་བྱ་རྒྱལ་གྱུར་མ་བཅས་རིགས་གསུམ།",
    "རྒྱ་ནག་གི་ཅོང་འདབ་མ་དང་མགོ་པོར་གཉིས་ཀ་རྒྱ་ཆེ་བ།",
    "འདོམ་སྟོང་ཙམ་གྱི་ཁྱོན་དང་ལྡན་པ་མ་བྱུང་བ།",
    "འདི་དག་ཡ་རེ་ས་ལ་གཏིབས་པའི་ཕྱིར་ས་ཆོའམ་ས་ཅོང་དུ་འབོད་པར་གྲགས་ལ།",
    "མགོ་འདབ་ཀྱི་མཚམས་སུ་པུས་མོ་གསལ་བ།",
