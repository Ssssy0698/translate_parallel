    "བཞི་པ་སྐྱོང་དུ་རུང་བའི་གནས་ནི་གྲུ་དང་ཤིང་རྟ་དག་གི་ཡང་ཆ་འོག་མར་སྦྱངས་པ་སྟེང་གཡོགས་དང་འདྲའོ།",
    "ལག་པ་དང་རྐང་པ་ལ་སོགས་པ་ཡན་ལག་གིས་ཁྱབ་པ་གནས་ཀྱི་མཐའོ།",
    "དམིགས་བསལ་ནི་རྩིག་པས་བསྐོར་བའི་གྲོང་ལ་ནི་ཇི་ཙམ་དུ་བ་ལང་དྲུག་གིས་དྲང་དགོས་པ་དང་ལྡན་པའི་ཤིང་རྟ་སྨྱིག་མས་གང་བ་ཅན་གྱི་ལམ་གྱིས་ཁྱབ་པ་འམ།",
    "ཤིང་གི་རིབ་མས་བསྐོར་བའི་གྲོང་ལ་ནི།",
    "ཐག་པས་འབྲེལ་བ་ལ་སོགས་པས་ཁྱབ་པའི་གནས་སུ་དབུས་ནས་བརྩམས་ཏེ་ཕྱོ་གས་ཐམས་ཅད་དུ་རྒྱང་གྲགས་གཅིག་གི་ནང་ཚུན་ཆད་ཉེ་འཁོར་ཡིན་ལ་དེ་ཕན་ཆད་མཚམས་ཐ་དད་པ་ཡིན་ནོ།",
    "དེ་ལ་རང་གི་ཉིད་དང་མི་འབྲལ་བའི་ཕྱིར་རོ།",
    "དེས་ན་སྔར་བྱིན་གྱིས་བརླབས་པ་ཡིན་ན་དམ་དུམ་དུ་སོང་ཡང་འབྲལ་སྤང་སྐྱེད་དོ།",
    "འབྲལ་བའི་རྒྱུ་ནི་བྱིན་གྱིས་བརླབས་པ་ཡིན་གྱི་རང་གི་ཉིད་ནི་མིན་པའི་ཕྱིར་རོ།",
    "ལྟ་མཆན་མི་མཐུན་པ་གཞན་གནས་པས་གཞན་དགེ་སློང་གི་གནས་མི་ཉམས་སོ།",
    "སྐྱེས་པ་དུ་མ་ཉལ་པོ་བྱེད་པར་ཤོམས་པ་ལ་དགེ་སློང་གིས་ཕྱིས་གནོན་བྱས་ན་སྐྱེས་པ་དེ་དག་ནོར་ཐ་དད་དུ་འགྱུར།",
    "གང་གི་ཚེ་འདྲ་ན་གོས་ཕྱི་མས་ཁ་བཀང་བ་ལ་རེ་བ་མེད་པའི་ཚེ་ན་འདྲ།་",
    "གོས་ཟླ་བར་བཞག་ཏུ་རུང་བ་ལ་ཁ་བསྐང་བ་ལ་རེ་བ་ཡོད་པར་བོ་བའོ།",
    "ཟླ་བའི་ནང་དུ་འགྲུབ་བོ་སྙམ་དུ་རེ་བ་དགོས་པར་བསྟན།",
    "གཉིས་པ་ཡན་ལག་གི་མཚན་ཉིད་ལ་གཉིས་ལས།",
    "གླེང་གཞི་ཡུལ་མཉན་ཡོད་དུ་གང་ཟག་དགེ་སློང་རབ་ཏུ་མང་པོས་ཉོན་མོངས་པ་ཟང་ཟིང་ལ་འདུ་བས།",
    "མཐར་ཐུག་ཞག་སོ་གཅིག་པའི་སྐྱ་རེང་ཤར་བའོ།",
    "གང་ལ་ཟླ་འཇོག་གི་སྤང་བར་འགྱུར་ཞེ་ན།",
    "ཁ་བསྐང་བ་ལ་རེ་བ་མེད་པ་དང་།",
    "བྱིན་གྱིས་བརླབ་པར་བྱ་བ་ཡོད་པ་ལས་གཞན་དུ་ཁ་བསྐང་བའི་རེ་བ་ཡོད་ཅིང་།་",
    "སྦྱིན་བདག་གི་ཡོ་བྱད་ཆུད་ཟ་བ་སོགས།",
    "དུས་འཇིམ་པས་སྦྱར་བ་སོགས་གཞི་མ་བྱས་ན་ཉི་མ་ཐ་དད་ལའང་བསྐྱེད་པས་དེ་དག་བྱས་ན་ཉི་མ་གཅིག་གི་དུས་ཡིན་པ།",
    "གལ་ཏེ་གཙུག་ལག་ཁང་གི་རྨང་ལ་སོགས་པ་ཐམས་ཅད་རྡོའམ་སོ་ཕག་སོ་བཏང་བའམ་ཤིང་ལས་བྱས་པ་མིན་ན་བྱེད་པ་པོ་ཡིན་ནོ།",
    "རང་གིས་བསྐོས་པ་གཞན་གྱིས་བརྩིགས་ན་ཡང་བྱེད་པ་པོ་ཡིན་ནོ།",
    "གང་གི་ཚེ་བརྩིགས་ན་ཡིན་ཞེ་ན།",
    "རང་གི་གནས་སུ་ཆུ་ཁུང་དག་མ་གཏོད་བ་ལ་ཡང་།",
    "དེ་ལས་བཟློག་པ་ལ་སྤང་བར་འགྱུར་བ་བརྗོད་པར་བྱ་སྟེ་དུས་ཚིགས་སུ་མ་བཅད་པའི་གསར་པ་ལས་སྣམ་སྦྱར་བྱེད་ན་དེའི་རིམ་པའི་ཚད་ཀྱི་མཐའ་ནི་ཉེས་རིམ་མོ།",
    "གདིང་བ་ཡང་གསར་པ་ལས་བྱེད་ན་དེའི་རིམ་པའི་ཚད་ཀྱི་མཐའ་ཉིས་རིམ་མོ།",
    "སྣམ་ཕྲན་དེ་དག་གི་གླེགས་བུ་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "སྣམ་ཕྲན་དགུ་པ་དང་བཅུ་གཅིག་པ་དང་བཅུ་གསུམ་པ་སྟེ་དང་པོ་གསུམ་ལ་ནི་སྣམ་ཕྲན་དེ་དག་གི་གླེགས་བུ་ཕྱེད་དང་གསུམ་པ་ཉིད་དོ།",
    "སྣམ་སྦྱར་དང་བླ་གོས་དང་མཐང་གོས་བྱིན་གྱིས་བརླབ་ཏུ་རུང་བ་ཆེན་པོ་དག་གི་ཚད་ནི།",
    "ཞེང་དུ་རང་གི་ཁྲུ་གསུམ་དང་།་",
    "འབྲིང་རྣམས་ཀྱི་ཆུ་དང་ཞེང་གི་ཚད་ནི།",
    "ཆེན་པོ་དང་ཆུང་ངུ་དེ་དག་གི་བར་མ་གང་ཡང་རུང་བའོ།",
    "ཁྲུའི་དོན་ནི་རང་གི་ལུག་ལ་ཆ་མཉམ་པ་བདུན་དུ་བྱས་པ་ལས་ཆ་གཉིས་ཡིན་གྱི།",
    "གྲུ་མོ་ནས་གུང་མོའི་རྩེ་མོའི་བར་མིན་ནོ།",
    "ལག་པའི་ཚད་རིང་བའི་ཆེད་དུ་གསུངས་པ་ཡིན་གྱི་ལུས་ཀྱི་རྐྱེན་དང་ལག་པའི་ཚད་འཚམ་པ་དག་ལ་ནི་རང་གི་ཁྲུ་ཉིད་འདིར་ཡང་ཚད་ཡིན་ནོ།"
  ]
}