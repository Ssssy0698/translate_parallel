    "མཚན་མོ་མཐའི་སྐད་ཅིག་མ་དེ་ལ་ཐ་མ་སྐད་ཅིག་མ་གཅིག་པུ་མིན་པ་སྟེ་མ་གཏོགས་པ་དེའི་མདུན་རོལ་གྱི་དུས་རྣམས་ཞག་ཏུ་མེད་པ་ཡིན་ཏེ།",
    "དཔེར་ན་ལོ་མཇུག་ལ་སྐྱེས་པའི་བུ་ཆུང་གིས་ཟླ་བ་གཅིག་ལས་མ་ལོན་ཀྱང་ལོ་གཅིག་ལོན་པར་རྩི་བ་བཞིན།",
    "དེ་བཞིན་དུ་ཚེས་ཀྱི་གུང་ཚིགས་སམ་ཕྱི་དྲོ་ནས་ཚེས་བཅུ་གཅིག་གི་གུང་ཚིགས་སམ།",
    "བསླབ་པའི་གཞི་དེ་དག་གི་སྐབས་སུ་དུས་དེ་དག་སྦྱོར་བ་ཉེས་བྱས་ཀྱི་སྣོད་ཉིད་དམ་རྒྱུ་ཡིན་པའི་ཕྱིར།་",
    "དམག་གི་ནང་ན་གནས་པ་ལ་ནི་ཉིན་པར་གནས་ན་ཡང་སྦྱོར་བའི་སྣོད་ཉིད་ཀྱི་རྒྱུའི་དངོས་པོར་འགྱུར་ཏེ།",
    "དེས་ན་བསླབ་པའི་གཞི་འདི་དག་གི་སྦྱོར་བ་ལ་ཉེས་པར་འགྱུར་ཏེ།",
    "ཉིན་མཚན་དེའི་དང་པོ་ནི་སྐྱ་རེངས་ཡིན་ལ།",
    "དེ་ལ་ཡང་སྐྱ་རེངས་དང་པོ་དང་།",
    "སྐྱ་རེངས་གསུམ་པོ།",
    "སྐྱ་རེངས་དང་པོ་ཤར་ན་ནམ་མཁའ་སྔོན་པོར་སྣང་ངོ་།་།",
    "འདི་ལྟར་མཚན་མོ་ཟད་༡༣༦ན་པར་གྱུར་པའི་ངོ་བོ་ནི་ཉིན་མོ་ཡིན་ལ།",
    "ཉིན་མོའི་ངོ་བོ་ནི་སྣང་བ་ཡིན་ཞིང་།",
    "སྣང་བ་ཡང་སྐྱ་རེངས་དང་པོ་ལ་སོགས་པ་ཡིན་ནོ་ཞེས་སོ།",
    "ཉི་མ་བཅུ་གཅིག་གི་སྐྱ་རེངས་ཤར་ནའོ་ཞེས་གསུངས་པའི་ཕྱིར་ཞེས་དང་།",
    "སྐྱ་རེངས་འཆར་བའི་སྐད་ཅིག་གིས་མཚན་མོའི་མཐའི་སྐད་ཅིག་བདེ་བླག་ཏུ་གོ་བར་ནུས་པས་དེའི་ཕྱིར་དེ་སྐད་བསྟན་ཏོ་ཞེའོ།",
    "ཐམས་ཅད་དུ་སྐྱ་རེངས་དང་པོ་ཉིན་མཚན་གྱི་དང་པོར་ཉིན་མཚན་གྱི་དང་པོར་ངེས་སམ་ཞེ་ན།",
    "གསོ་སྦྱོང་དབྱར་གནས་དགག་དབྱེ་སོགས་ཚེས་གྲངས་དང་འབྲེལ་བའི་ལས་ལ་ནི་སྤྱིར་སྐྱ་རེངས་དང་པོ་ཉིན་མཚན་གྱི་དང་པོ་ཡིན་ཡང་།",
    "དང་པོ་ཡིན་པས་སྐྱ་རེངས་དང་པོ་ཤར་ཡང་ཉི་མ་མ་ཤར་ན་གསོ་སྦྱོང་ལ་སོགས་པའི་ལས་བྱའོ།",
    "གཉིས་པ་བདག་པོ་དང་འབྲེལ་བའི་ཐུན་མོང་བ་ནི།",
    "བཅུ་ཚན་བར་པ་སྟེ་རྒྱུར་གྱུར་གྱི་རྫས་དགེ་སློང་རང་གི་ཡིན་པ་ཡན་ལག་ཏུ་དགོས་པའི་སྤང་བའི་དངོས་པོ་ལ་ནི།",
    "རྫས་རང་གི་ཡིན་པ་དེ་རྫས་འདི་བདག་གིའོ་སྙམ་དུ་འཛིན་པའི་འདུ་ཤེས་ལས་རང་གི་ཉིད་ཡིན་པ་ཡན་ལག་གོ།",
    "རྣམ་པ་ཇི་ལྟར་ན་གཙོ་ཆེར་ཏེ་དངོས་པོ་ལས་རང་གི་ཉིད་ཡིན་པས་སོ།",
    "དེས་ན་བསླབ་པའི་གཞི་དེ་དག་གི་སྐབས་སུ།",
    "རང་གི་ལ་རང་གིར་ཤེས་ན་དངོས་གཞི།",
    "རང་གི་ལ་གཞན་གྱིར་ཤེས་པ་དང་།",
    "གཞན་གྱི་ལ་རང་གིར་ཤེས་པ་ལ་ཉེས་བྱས་སུ་འགྱུར་རོ།་།",
    "དེ་གཉིས་ལ་དངོས་པོ་ལས་གཙོ་ཆེར་རང་གི་ཡིན་པ་ཡན་ལག་ཡིན་གྱི།",
    "དཔེར་ན་དགེ་སློང་གིས་དངོས་པོ་སྐུར་བ་འགའ་ཞིག་གིས།",
    "དེ་དག་གི་སྐབས་སུ་རང་གི་ཉིད་གང་ཡིན་པ་དེ་ནི་གཞན་ལ་སེམས་ཀྱིས་ཡོངས་སུ་བཏང་སྟེ་བསྔོས་པ་ཉིད་ན་འཚོ་བའི་ཡོ་བྱད་ཀྱི་བྱིན་བརླབས་སོགས་མ་བྱས་ཀྱང་སྤང་བར་མི་འགྱུར་ཏེ།",
    "རང་གི་ཉིད་དང་བྲལ་བ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེ་ཡང་འདུ་ཤེས་ལས་རང་གི་ཉིད་དང་བྲལ་བ་ཡིན་གྱི་དངོས་པོ་ལས་བྲལ་བ་ནི་མིན་ཏེ།",
    "ཤི་བའི་ཡོ་བྱད་ལ་ནི་དངོས་པོ་ལས་རྣམ་པར་བཞག་གི་འདུ་ཤེས་ལས་མིན་ཏེ་ཞེས་སོགས་གསུངས།་",
    "སོགས་པ་གཞན་ལ་རྣམ་པར་བརྟགས་པའི་བསྔོ་བ་བྱས་ན་རང་གི་ཉིད་དང་བྲལ་ལོ།",
    "རྣམ་པར་བརྟགས་ན་ཆེ་གེ་མོ་ཞེས་མིང་བརྗེའོ།",
    "གསུམ་པ་ཤན་དང་འབྲེལ་བའི་ཐུན་མོང་བ་ལ་གཉིས་ལས།",
    "རང་གི་ཡིན་པས་རྗེས་སུ་ཞུགས་པས་༡༣༧བ་དང་།",
    "རྡེག་བྱེད་ཀྱི་རྫས་ཀྱི་རང་གི་ཉིད་ཀྱི་རྒྱུན་འབྲེལ་བ་དེས།",
    "དགེ་སློང་གིས་གོས་སྤང་བ་མ་སྤངས་ཤིང་བྲལ་བར་མ་བྱས་ལ།",
    "ཞག་བཅུ་འདས་པའི་སྤང་བ་ལ་ཐུག་པ་ན་དེའི་ཤུགས་ཀྱིས་གཞན་ལས་བྱུང་བའི་གོས་ཕྱིས་རྙེད་པ་བྱིན་གྱིས་བརླབས་པ་དང་འབྲེལ་རང་གི་ཉིད་ཀྱི་རྗེས་སུ་ཞུགས་པ་དང་བཅས་པ་དེ་ཡང་འཆང་བའི་སྤང་བ་ཁོ་ནར་འགྱུར་རོ་ཞེས་སོགས་གསུངས།",
    "འགྱུར་ནས་ཚེས་དྲུག་ལྟ་བུ་ལ་གོས་སྔ་མ་རུང་བར་བྱས་སམ་བསྔོས་ཀྱང་གོས་ཕྱི་མ་ལ་དེ་དག་མ་བྱས་ན་ཞག་བཞིའི་ཤན་དང་དྲུག་གི་རང་སྟོབས་བསྡོམས་པས་སྤང་བ་བསྐྱེད་དེ།",
    "ཕྱིས་རྙེད་ལ་ཤན་མི་འདྲེ་མོད།",
    "ཕྱིས་རྙེད་བྱིན་གྱིས་བརླབས་པས་རང་ལས་བྱུང་བའི་རང་གི་ཉིད་ཀྱི་རྗེས་ཞུགས་ཉམས་ཀྱང་གཞན་ལས་བྱུང་བའི་རྗེས་ཞུགས་ཉམས་པར་མི་འགྱུར་བ་བཞིན་ནོ།་།",
    "གང་གིས་༡༣༩ན་གང་ལ་བརྡེག་པའོ།",
    "རང་གི་ཉིད་ཀྱི་རྗེས་ཞུགས་དང་བཅས་ཤིང་།",
    "རང་ལས་བྱུང་བའི་རང་གི་ཉིད་ཀྱི་རྗེས་སུ་ཞུགས་པ་དེ་རིགས་མཐུན་གྱི་ཛ་ས་གཞན་ལ་འདྲེ་བར་བྱེད་པས་རྡེག་བྱེད་དང་།",
    "རིགས་མཐུན་གྱི་རྫས་གཞན་ལས་བྱུང་བའི་རང་གི་ཉིད་ཀྱི་རྗེས་ཞུགས་དེས་གོས་པར་བྱ་བས་ན་བརྡེག་བྱའོ།",
    "གོས་འཆང་བ་ཟླ་འཇོག་ལྷུང་བཟེད་འཆང་བ་གསུམ་གྱི་སྐབས་སུ་བརྡེག་བྱ་རྡེག་བྱེད་ཅེས་རིགས་མཐུན་པ་དང་གསོག་འཇོག་གི་སྐབས་སུ་ནང་ཚེས་ཀྱི་རིགས་མཐུན་ཁོ་ན་དང་།",
    "བརླབས་པ་ནང་དང་བརླབས་པ་ནང་གིས་རྡེག་པའི་ཚེ་སྔ་མས་ཕྱི་མ་ལ་རྡེག་གི།",
    "དེས་ན་ཚེས་གཅིག་ལྟ་བུ་ལ་གོས་ཤིག་རྙེད་པ་རང་གི་ཉིད་ཀྱི་རྗེས་ཞུགས་དང་བཅས་པར་བཅངས་པ་ལས།",
