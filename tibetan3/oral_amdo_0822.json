    "ཡང་ན་ལྷ་མོ་དེ་བུད་མེད་གཞན་གྱི་གཟུགས་སུ་སྟོན་པར་བྱེད་ན་དེ་ནས་སྐྱེ་བ་འདིར་འགྲུབ་པར་ཤེས་པར་བྱའོ།",
    "རྡོ་རྗེའི་སྦྱོར་བས་ལྷ་མོ་དེ་ཇི་སྲིད་གཙུག་ཏོར་བདེ་བའི་བར་དུ་བསྟེན་པར་བྱའོ།",
    "སྔོན་པོའི་རྣམ་པར་བསམས་པས་དེ་ནས་ལས་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་ཇི་ལྟར་རིགས་པར་ཐོབ་པར་འགྱུར་རོ་། ཡང་ན་དེ་ཡང་མ་ནུས་ན་འོན་ཀྱང་རང་གི་ཚུལ་ཁོ་ནའི་རིགས་པས་བུད་མེད་དེ་རྣམས་རང་གི་ལྷ་མོའི་གཟུགས་སུ་བསམས་ཏེ།",
    "ལག་ན་རྡོ་རྗེ་དེའི་ཕྱིར་རང་གི་ཏིང་ངེ་འཛིན་གྱིས་ིཚུལ་འདི་ཉིད་ཀྱི་སྦྱོར་བས་རིག་པའི་ལྷ་མོ་ཐམས་ཅད་ཀྱང་བསྒྲུབ་པར་བྱ་སྟེ་འདི་ལ་ཐེ་ཚོམ་མི་བྱའོ།",
    "ཡང་ན་ལག་ན་རྡོ་རྗེ་གལ་ཏེ་རང་གི་བཟང་མོ་ཨེམ་རྙེད་ན་གཞན་གྱིའང་མཐའ་གཅིག་ཏུ་བཟུང་སྟེ་ཞུ་བ་བཏུང་བ་ལ་སོགས་པ་བྱ་སྟེ།",
    "ཡང་ན་ཡུལ་གྱི་གཟུགས་འཚོང་མ་ལ་བདག་གིས་ཚུལ་འདིས་བསྟེན་པར་བྱའོ།",
    "བསྟེན་པས་གལ་ཏེ་དེ་བསམས་པ་ན་སྔགས་པ་དེའི་ཞུ་བ་རེད་པར་གྱུར་ན་དེ་ནས་དངོས་གྲུབ་འཐོབ་པར་ཤེས་པར་བྱའོ།",
    "མཆོག་ཏུ་གསང་བའི་མཛོད་རྟོག་པའི་རྒྱལ་པོ་ཆེན་པོ་ལས་ལྷ་མོའི་རྒྱུད་ཀྱི་ཆོ་ག་རྒྱས་པ་ཡོངས་སུ་རྫོགས་སོ།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ།",
    "དར་གྱི་བ་དན་དང་མེ་ཏོག་གི་ཆུན་པོས་ཉེ་བར་སྤུད་པ།",
    "རིག་པའི་ལྷ་མོ་དེ་དག་དཀྱིལ་འཁོར་གྱི་གྲྭར་ཡོངས་སུ་གཞག་པར་བྱའོ།",
    "ལྷ་མོ་རྣམས་དང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྦྱང་བའི་༧ དོན་དུ་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་གནས་པའི་ཟླ་བའི་དཀྱིལ་འཁོར་ཡོངས་སུ་དྲི་མ་མེད་ཅིང་སའི་ཕྱོགས་མཐའ་དག་ཁྱབ་པར་བརྗོད་དོ།",
    "ལག་ན་རྡོ་རྗེ་དང་པོ་རེ་ཞིག་སེམས་སོ་སོར་རྟོགས་པར་བྱ་སྟེ།",
    "གང་གིས་སྤྲུལ་པ་ཉོན་ཅིག།",
    "དེ་ལས་བྱུང་བའི་སྔགས་བདག་གིས་། དབྱེ་བ་བཞིན་དུ་བརྟག་པར་བྱ།",
    "རིག་པའང་ཚོར་བའི་རྣམ་པ་ཡི།",
    "ཁྱོད་ཀྱིས་མ་མོ་བསྒྲག་མི་བྱ།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་སྐོང་བ།",
    "དམ་ཚིག་གི་སྦྱོར་བ་དང་ཡང་དག་པར་ལྡན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་བཀའ་ལུང་ཇི་ལྟར་བགྱི།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་དེ་ལྟར་བགྱིའོ་ཞེས་གསོལ་ཏེ་ཕྱིར་བྱུང་ངོ།",
    "ཁྱོད་ཀྱི་མིང་ཅི།",
    "ཅིའི་ཕྱིར་ཁོ་བོ་ཅག་གིས་ཁྱོད་ཀྱི་ངག་མཉན་པར་བྱ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་ལྟར་བཀའ་སྩལ་པ་དེ་ལྟར་བདག་ཅག་གིས་བགྱིའོ།",
    "གཡས་པས་ལྷ་མོ་ཨུ་མའི་ནུ་མ་རྒྱས་པ་དག་མནན་ཏེ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "ཀྱེ་མའོ་འཇིག་རྟེན་གསུམ་གྱི་བདག་པོའི་གནས་སྐབས་བདག་ནི་བཟང་གི་དེ་ནི་དེ་ལྟ་མ་ཡིན་ནོ་སྙམ་མོ།",
    "དེ་ནས་ལྷ་མོ་དེས་ལག་པ་ཐལ་མོ་སྦྱར་བ་སྤྱི་བོར་གཞག་ནས་འདི་སྐད་ཅེས་སྨྲ་བར་བྱེད་དོ།",
    "ཨེ་མའོ་གཟི་བརྗིད་ཆེན་པོ་འདི་གང་གི་ཕྱིར་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་བདག་གི་བདག་པོ་ཡང་ཞབས་གཡོན་པས་ཀུན་ནས་མནན་ནས་འདིའི་བྲན་མོ་ཉིད་མཆོག་སྟེ་ང་ཡང་འདིའི་ཆུང་མ་བྱ་སྙམ་ཞེས་སྨྲའོ།",
    "བདག་གང་གི་ཕྱིར་འདི་ལྟ་བུའི་སྡུག་བསྔལ་མྱོང་བ་ིབཟོད་པ་བས་དེ་ནས་ཡང་དེས་རྗེས་སུ་བསམས་པ།",
    "སླར་ཡང་ཁྲོ་བ་དང་བཅས་པའི་ལྟ་སྟངས་ཀྱིས་གཟིགས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱིས་དེ་ལ་གཟིགས་ཏེ།",
    "དེ་ནས་ལྷ་མོ་དེ་འདི་སྐད་ཅེས་སྨྲ་ཞིང་དུ་བར་བྱེད་དོ།",
    "ཇི་ལྟར་བདག་གི་བདག་པོ་འཇིག་རྟེན་གསུམ་གྱི་མངའ་བདག་དེ་འདིས་བསད་ན་ད་ིབདག་གིས་ཇི་ལྟར་བྱ་ཞེས་སྨྲའོ།",
    "དེ་ནས་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱིས་ཡང་ལྷ་མོ་དེ་ཞབས་གཡོན་པས་ཤིན་ཏུ་བརྫིས་ཏེ་བསད་པར་བརྩམས་སོ།",
    "དེ་ནས་ལྷ་མོ་དེ་འདར་བའི་ཡིད་ཀྱིས་འདི་སྐད་སྨྲས་སོ།",
    "བདག་ཁྱོད་ཀྱི་བྲན་མོར་མཆིའོ།",
    "དེ་ནས་ལྷ་མོ་དེས་ཕྱག་ན་རྡོ་རྗེ་ལ་གསོལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལྷ་མོ་དེའི་ཚིག་གསན་ནས་ཐུགས་རྗེ་དང་ལྡན་པའི་ཐུགས་ཀྱིས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "བཟང་མོ་འདི་གལ་ཏེ་སྟེར་ན་དེ་ནས་གཏང་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ཅི་བགྱི་བ་བཀའ་སྩལ་དུ་གསོལ།",
    "ཡང་བཅོམ་ལྡན་འདས་སེམས་དཔའ་ཆེན་པོ་ཁྱོད་ཀྱི་དཀྱིལ་འཁོར་དུ་ཞུགས་ལ་ཁྱོད་ཀྱི་བཀའ་བཞིན་དུ་བགྱིའོ།",
    "བདག་གི་ཆུང་མ་འདི་དབུལ་བར་བགྱི་ཞིང་།",
    "དེ་ནས་ལྷ་མོ་དེས།",
    "ཨེ་མའོ་འདི་ནི་ངོ་མཚར་ཆེ་སྟེ་བདག་གི་ཆུང་མ་འདིས་བདག་བགྲང་བར་མི་བྱེད་དོ་སྙམ་མོ།",
    "ཁྱོད་འཇིག་རྟེན་གྱི་ཁམས་དེར་སོང་ཤིག།",
    "དེ་ནས་ལྷ་མོ་དེ་དེའི་གཟུགས་ཕུན་སུམ་ཚོགས་པ་རང་གིས་མཐོང་ནས་ིསླར་ཡང་སྨྲས་པ།",
    "འདིའི་བྲན་མོ་མཆོག་ཏུ་འགྱུར་རམ་མ་ཡིན་ཏེ།",
    "ཁྱོད་ལ་བདག་གིས་མཛེས་མ་འདི་དབུལ་བར་བགྱིའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ་ཁྱོད་ཉིད་ལ་ཞོག་ཤིག།",
    "བརླ་ཟུང་གི་སྟེང་དུ་གཞག་ནས་དེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེའི་རིགས་ཀྱི་ལྷ་མོ་ཆེན་མོ་ཁྱོད་ཡིན་ནོ།",
    "དེ་ནས་ལྷ་མོ་དེས་འདི་ལྟ་བུའི་བཀའ་ཉེ་བར་ཐོས་ནས་དགའ་ཞིང་རངས་པའི་ཡིད་ཀྱིས་གནས་སོ།",
    "དེ་ནས་ཡང་ལྷ་ལ་སོགས་པ་དང་གཟའ་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལྷ་མོ་ཆེན་མོ་དང་བཅས་པ་ཕྱག་ན་རྡོ་རྗེ་དང་ཐབས་ཅིག་པ་དཀྱིལ་འཁོར་ཆེན་པོ་ལ་ལན་གསུམ་དུ་གཡས་ནས་བསྐོར་ཞིང་ིརྒྱང་ནས་ཕྱག་བྱས་ཏེ་འགྲོ་བ་ིབཀའ་ནོད་ཅིང་གནས་སོ།",
    "དེ་ནས་ལྷའི་བུ་དེ་དག་ཅ་ཅོའི་སྒྲས་བཅོམ་ལྡན་འདས་ལ་ལེགས་སོ་ཞེས་གསོལ་ཏེ་སོང་ངོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་མེ་ཏོག་གི་ཆར་ཆེན་པོ་ཕབ་པར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པ་སྣ་ཚོགས་ཤིང་བཀྲ་བའི་མེ་ཏོག་གི་ཆར་སུས་ཕབ་པ་ལགས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ཀུན་ཏུ་བཟང་པོའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ་རྣམ་པར་གཟིགས་སོ།",
    "གཟིགས་ཏེ་དེ་ནས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "ཁྱོད་དེ་ལྟར་མ་བྱེད་ཅིག།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ཕྱིའི་ཚུལ་གྱི་ལྷ་མོ་དེ་ཉིད་ཀྱི་སྐུ་ལ་བཅུག་སྟེ་བཞུགས་སོ།",
    "བུད་མེད་འདི་ཁྱོད་ཉིད་ལ་ཞོག་ཤིག།",
    "༣༩༩བསྐོར་ིབ་བྱས་ཏེ་འཁོར་དང་བཅས་པ་སོང་ངོ།",
    "ཤིན་ཏུ་སྒེག་པ་ཉིད་དུ་གཟིགས་ནས་རྡོ་རྗེ་སྒེག་མོ་ཞེས་མིང་དུ་བཏགས་སོ།",
    "གང་གིས་དེ་བཞིན་གཤེགས་པ་ཉིད་ཐོབ་ནས་མཛེས་མ་ཤིན་ཏུ་གཟུགས་དང་ལྡན་པ་བདེ་བ་ཆེན་པོ་སྟེར་བ་རྙེད་པར་གྱུར་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྷ་མོ་གཞན་ཡང་ཕྱུང་སྟེ་དཀྱིལ་འཁོར་དེ་ཡོངས་སུ་གང་བར་མཛད་དོ།",
    "བཅོམ་ལྡན་འདས་བདུད་སྡིག་ཅན་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་དང་བཅས་ཏེ་ལྷགས་པ་འདི་སུ་ཇི་ལྟ་བུ་ཞིག་ལགས།",
    "དེ་ནས་ཕྱག་ན་རྡོ་རྗེ་རབ་ཏུ་ཁྲོས་ཏེ་རྡོ་རྗེ་གསོར་ཞིང་བཅོམ་ལྡན་འདས་ཅི་ཕྲག་དོག་གི་སེམས་ཀྱིས་འོངས་ན་རྡོ་རྗེ་འདིས་དེ་དག་བསྲེག་པར་བགྱིའོ་། དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "གང་ང་ོལ་སྦྱིན་པར་འདོད་པ་དེ་ཁྱོད་ཉིད་ལ་ཞོག་ཤིག།",
    "དེ་ལྟ་ལགས་མོད་ཀྱང་འདི་དག་བཞེས་སུ་གསོལ་ཞེས་གསོལ་ཏེ།",
    "དེ་ནས་པདྨོའི་ལུས་ཅན་ལ་སོགས་པ་གཞན་རྣམས་ཀྱང་ལྷགས་ཏེ་མཆོད་ནས་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་རྒྱུ་གང་གི་ཕྱིར་དྲན་པ་ཙམ་ཡང་མི་བགྱི་ལགས།",
    "ལག་ན་རྡོ་རྗེ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཞེས་བྱ་བའི་རིག་པ་ཡོད་དེ།",
    "ལག་ན་རྡོ་རྗེ་དེ་ལ་འདི་ནི་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཞེས་བྱ་བའི་རིག་པའོ།",
    "ན་མོ་བྷ་ག་བ་ོཏེ།",
    "ཏྲི་ལོཀྱ་དཱ་ནི་མ་ཧཱ་བིདྡྷཱ་ཨཱ་ཀནྟ་ཎི་མོ་ཧ་ནི།",
    "མ་ཧཱ་མོ་ཧེ།",
    "གཟས་བཟུང་བ་མ་མཐོང་བར་ཇི་སྲིད་ཟླ་བ་མ་གྲོལ་བ་དེ་སྲིད་དུ་བཟླས་ལ་སྔ་དྲོ་ཁྲུས་བྱས་ཏེ་བིལ་བའི་ཡམ་ཤིང་མར་ལ་བཏགས་པའི་ེཉི་ཤུ་རྩ་གཅིག་བསྲེག་པར་བྱའོ་། དེ་ནས་བྲམ་ཟེ་ལ་སྟོན་མོ་བྱས་ཏེ།",
    "ཆུ་ཁྱོར་བ་གང་ལ་རིག་པ་འདི་ཡོངས་སུ་བཟླས་ཏེ།",
    "གང་གི་ཚེ་སྔགས་པ་མཐའ་གཅིག་ཏུ་སོང་སྟེ་ཆོམ་རྐུན་ལ་སོགས་པ་མཐོང་བ་ན་དེ་ནས་བྱེ་མ་སྤར་བར་བླངས་ལ་རིག་པ་ཅུང་ཟད་ཅིག་བཟླས་ཏེ་ཕྱོགས་བཞིར་གཏོར་བར་བྱའོ།",
    "དཔུང་གི་ཚོགས་གླང་པོ་དང་།",
    "ལག་ན་རྡོ་རྗེ་སྒོ་དེ་ཉིད་ཀྱིས་ཕ་རོལ་གྱི་བུད་མེད་བཀུག་ལ་འདོད་པར་བྱའོ།་།",
    "དེ་ཉིད་ཀྱིས་ཕ་རོལ་གྱི་སྔགས་རེངས་པར་བྱེད་དོ།",
    "འདི་ཉིད་ཀྱིས་གང་ཡིད་ལ་འདོད་པའི་བུད་མེད་འགུགས་པར་བྱེད་དོ།",
    "ལག་ན་རྡོ་རྗེ་འདི་དག་ནི་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཞེས་བྱ་བའི་རིག་པ་སྒྲུབ་པའི་ཐབས་དང་བཅས་པ་སྟེ།",
    "ལག་ན་རྡོ་རྗེ་དེས་ན་འཇིག་རྟེན་པ་དགའ་བའི་ཕྱིར་དངོས་གྲུབ་ཕྲ་མོ་འདི་སྔགས་པས་བསྒྲུབ་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་སྒེག་མོ་དག་དང་ཐབས་ཅིག་ཏུ་རྣམ་པ་དུ་མ་ཨཱ་ལིང་ག་དང་།",
    "ཙུམྤ་ན་ལ་སོགས་པས་བྷ་གའི་ནང་དུ་སོང་བར་བྱ་སྟེ།",
    "དཔེར་ན་ནམ་མཁའི་ཆུ་སྐྱེས་རྣམ་པ་གང་གིས་ཀྱང་བསྒྲུབ་པར་ནུས་པ་མ་ཡིན་པ་བཞིན་ནོ།",
    "ལག་ན་རྡོ་རྗེ་དེའི་ཕྱིར་སྔགས་པས་ལྷ་མོ་གང་རྙེད་པ་དེ་བརླ་ཟུང་གི་སྟེང་དུ་བཞག་ིལ་ཙུམ་དང་།",
    "ང་གི་སྔགས་ཀྱི་རྒྱལ་པོས་བདག་ཉིད་འདོད་པ་ཡིན་ནོ་ཞེས་བསྒོམས་ཏེ།",
    "གང་གི་ཕྱིར་ཨེའི་ཡི་གེ་རྣམ་པ་སྣ་ཚོགས་པ་སྟེ།",
    "ཁྱོད་ལ་ཡོངས་སུ་མ་རྫོགས་པ་འགའ་ཞིག་མཆིས་ལགས་སམ།",
    "ལག་ན་རྡོ་རྗེ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་མོད་ཀྱང་ིདབུལ་བར་བྱ་བ་ཡིན་ནོ།",
