    "དགེ་སློང་ཁྱོད་ཀྱིངག་པ་དག་གིར་མ་བྱས་སམ་ཞེས་བྱབ་ནི་འཇིག་རྟེན་ལ་གོ་བར་བྱ་བའི་ཕྱིར་རོ།",
    "གཟིགས་ཞེས་བྱ་བ་ནི་ངོ་མཚར་ཆེའོ་སྙམ་དུ་བསམས་པའོ།",
    "ཁ་རྡོག་དང་ལྡན་པ་ཞེ་ས་བྱ་བ་ནི་ཁ་དོག་གི་གཟུགས་ལ་གནས་པའོ།",
    "དེ་ཡང་བུང་བ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་སྦྲང་རྩ་རྣམ་པ་བཞི་ཡོད་པས་དེའི་ཕྱིར་སྦྲང་བུའི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིར་ནིདེའི་སྐད་ཅིག་གི་ཡུན་ཡིན་ནོ།",
    "ཁ་དོག་གསལ་བཞེས་བྱ་བ་ནི་ཁ་དོག་གིབཀྲག་གོ།",
    "ནི་ངག་གི་ཉོན་མོངས་བའོ།",
    "ཀུནནས་མདཀྲིས་པ་ཞེས་བྱ་བཞི་རྒྱལ་སོགས་ལ་གང་གིས་ཀྱང་མ་དཀྲིས་པ་གང་ཡིན་པའོ།",
    "ནུབ་བརྔས་ནཞེས་བྱ་བཞི་ནུབ་མོ་བཅད་ནའོ།",
    "གངགི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཆའི་ཚིག་ཡིན་ནོ།",
    "ཁྱོད་ཀྱིས་ཞེས་བྱབ་ནི་ཁྱེད་ཅག་གིས་སོ།",
    "སློབ་དབོན་དུལ་བའི་ལྷས་ཉེ་བར་སྦྱརབ་ལས་ཕམ་པར་འགྱུར་བ་དང་པོའི་མི་ཚངས་བར་སྤྱོད་པའི་ཚིག་གི་རྣམ་པར་བཤཤད་བརྫོགས་སོ།",
    "དེའིགནས་ནི་གླིང་བུ་བུད་པ་ལ་སོགས་པའི་ཡུལལོ།",
    "སྟེང་རི་མཞེས་བྱ་བ་ནི་སྟེང་གིཆ་ཆར་ཁབ་དང་ལྷན་ཅིག་པའོ།",
    "ལུས་འཕགས་མོའི་བུ་ཞེས་བྱ་བ་ནི་རྣམུལ་ལུས་འཕགས་ཞེས་བྱ་བ་ནས་སྐྱེས་པའི་བཙུན་མོལུས་འཕགསམ་ཞེས་བྱ་བའི་བུ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་སྐད་མཆིའོ་ཞེས་བྱབ་ནི་བདག་གིས་ཇི་སྐད་བརྗོདཔ་དེསྐད་མཆིའོ་ཞེས་བྱའོ།",
    "བླང་དུ་ཞེས་བྱ་བ་ནི་བདག་གིར་བྱ་བའོ།",
    "ཡོངས་སུམ་བཟུང་བལཞེས་བྱབནི་བདག་གིར་མ་བྱས་པ་ལའོ།",
    "བྱིས་པཞེས་བྱ་བ་ནི་རང་གིས་མི་ཤེས་པའོ།",
    "སྒྱི་སྡོམ་ལཞེས་བྱ་བ་ནི་སྡོམ་གྱི་ཚིགས་སུབཅད་པ་རྣམས་སྦྱར་བསྡུས་པའི་སྡོམ་མོ།",
    "གསུམ་པ་དང་པོ་འདི་ནི་རང་གིས་ས་མགཞན་གྱིས་སམ་མངོན་སུམ་དུའམ་ལྐོག་ཏུ་རྐུ་བ་ལ་བྱེ་བྲག་ཟགའ་ལ་ཆེད་པོ་ཞེན་པའི་ཕྱིར་གསུངས་སོ།",
    "རང་གི་འདུ་ཤེས་ཞེས་བྱ་བ་ནིངང་གི་བློའོ།",
    "དེ་ཞིག་གི་འདུ་ཤེས་ཞེས་བྱ་བ་ནི་ཕྱིར་སྦྱིན་པའི་བློའོ།",
    "དེ་འདི་སྙམ་དུ་ཞེས་བྱབ་ལ་སོགས་ཞི་བརྒྱུད་པ་ནི་མིས་བདག་གིར་བབདང་མབྲལ་བའི་ཕྱིར་དང་མིས་ཡོངས་སུབཟུང་བའི་འདུ་ཤེསམེདཔའི་ཕྱིར་དེ་ལ་སྨད་དོ།",
    "སྲང་གི་ཁང་བཞེས་བྱབནི་ཤིང་རྟའི་ལམ་གྱི་ཁང་བཟངས་ཉིས་བརྩེགས་ལ་སོགས་བའོ།",
    "ལུས་མ་ཐོབ་པ་ཞེས་བྱ་བ་ནི་བརྩོན་བ་མོད་པའོ།",
    "ཟུང་ཁྱོགས་ཞེས་བྱ་བ་ནི་མི་གནས་འདེགསཔའོ།",
    "དེའི་བ་སམ་པས་ཞེས་བྱ་བ་ནི་ཕྲག་དོག་གི་སེམས་ཀྱིས་ཞེས་བྱ་བའི་ཐཆི་ག་གོ།",
    "བུམ་པའི་གྲཞེས་བྱ་བ་ནི་བུམ་པ་ཁ་སྦུབ་ཏུ་གཞག་པ་དག་གིས་འགྲུབ་པའི་གྲུགང་ཡིནཔའོ།",
    "རྫ་མའིག་ཞེས་བྱ་བ་ནི་རྫ་མ་དག་གིས་འགྲུབ་པའི་གྲུགང་ཡིན་པའོ།",
    "ཐོབརྒྱལ་ཞེས་བྱ་བཞིག་ང་གིས་གང་ཟིན་པ་དེ་དེའི་ཡིན་པར་རྣམ་པར་བཞག་པར་བྱའོ།",
    "བྱ་ར་གྱིས་ཤིག་ཅེས་བྱ་བཞི་རེངས་པར་ལྟ་བ་ལྟར་ལོངས་ཤིག་ཅེས་པའོ།",
    "འདིངཞི་རྐུ་བབས་ཀྱིས་རང་གི་རྫས་ཤོ་གམ་གཞལ་དགོས་པ་བཟླས་དེ་རིན་ཐང་ཚང་ན་ཕམ་པར་ཁ་ཡུར་རོ་གཞན་གྱིས་བཟླསན་སྦོམ་པོར་འགྱུར་རོ།",
    "ཐོས་ནས་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་རྣམ་ཕྱིན་ནསབཅོམ་ལྡན་འདས་དང་ཐབས་ཅིག་མངོན་དུ་ཡང་དག་ལ་ཐདགའ་བ་རྔ་གྱུརབ་དང་ཡང་དག་པར་མགུབར་འགྱུར་བའི་གཏམ་སྣ་ཚོག་ལ་བྱས་ཏེ་མཐའ་ཅིག་ཏུ་འདུག་གོ།",
    "ཀྱེེ་གོ་ཏམཛེ་ལྷ་གང་དག་ཇི་སྐད་མཆི་བ་དེ་དག་དེ་ལྟར་བ་རྡ་སྤྲོད་པར་བགྱིད་པ་ན་ཤེས་ལྡན་གོ་ཏ་མལ་སྐུར་པ་འདེབས་པརམི་བགྱིད་ཅི་ང་ཧ་ཅང་ཐལ་བར་ང་གཉིསབགྱིད་པ་དང་།",
    "སྐྱེས་པ་བུདམེད་དུམ་དང་།",
    "ཚུརྩོལ་བར་བྱེད་ཅེས་བྱ་བ་ནི་ག་ང་གིས་རིགས་པའི་ཐ་སྙད་བརྗོད་པའོ།",
    "བྱ་དཀའ་བ་བྱེད་པ་དག་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་ཤ་ངལ་ན་གནས་པ་བཟུང་བ་དངམིག་ཙ་རེ་བའོ།",
    "རིགས་པ་དང་ཞབས་སུ་ལྡན་པཞེས་བྱ་བ་ནི་མི་སློབ་པའི་རིག་པ་གསུམ་དང་མི་སློབ་པའ་ལུས་ཀྱི་སྡོམ་པ་དང་ངག་གི་སྡོམ་པ་དང་ཡང་དག་པར་འཚོ་བའི་སྐྱོད་པ་དག།",
    "འདི་ལྟར་གང་ཁོ་ནའི་ཚེ་སྡུག་བསྔལལ་དམིགས་པའི་ལས་སྐྱེ་བ་དེ་ཁོན་ཆེ་སྡུག་བསྔལམཐོངབས་སྡང་བར་བྱབའི་ཞོན་མོངས་པ་རྣམས་སྡོང་བ་དང་།",
    "བག་པ་མེད་པའི་ཤེས་པ་དང་ལུས་དང་ངག་གི་སྡོམ་པ་དང་ཡང་དག་བའི་འཚོབ་ནིད་ལ་ཞུགས་པའོ།",
    "འདོད་པ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་བསྒོམས་པས་སྦད་བར་བྱ་བ་དག་གི་རྣམ་པ་དྲུག་པ་སྐྲངས་ཤིང་མཐོང་བའི་ལམ་ལས་ལངས་པའི་འཕགས་བའི་གང་ཟག་རྣམས་སོ།",
    "ལ་ན་ཅི་ག་བཱིར་འོང་བ་དག་ཅེས་བྱ་བ་ནི་གང་དག་གིས་དེའི་འབྲས་བུ་ཐོབ་བདག་གོ།",
    "ཕྱིར་མི་འོང་བ་དག་ཅེས་བྱ་བ་ནི་ག་ང་དག་གིས་དེའི་འབྲས་བུ་ཐོབ་བ་དག་གོ།",
    "དེ་དག་གི་བསྔགས་པ་བརྗོད་ཅིང་ཞེས་བྱ་བ་ནི་ཕ་ན་ཡོན་བསྒྲགས་ཤིང་ངོ།",
    "བལང་གི་ལྕིབ་བཙིར་བཞེས་བྱ་བ་ནི་བལང་གི་ལྕི་བའི་ཁུབའོ།",
    "རྐང་པ་སྟེའུའི་ཞག་གིས་བསྐུས་ཏེཞེས་བྱ་བ་ནི་རྐང་པ་བསྐུབ་ལ་དེ་མཁོ་སྟེ།",
    "སྒེའུ་ཆུང་ཞེས་བྱ་བ་ནི་མ་གྲགས་པའི་ལམ་མོ།",
    "མཚན་མོ་ནམ་ལངས་པ་ཞེས་བྱ་བནི་མཚན་མོ་ཟད་པའོ།",
    "དགེ་སྦྱོང་གི་ཚུལ་ཞེས་བྱ་བ་ནི་རབ་ཏུ་བྱང་བའོ།",
    "རྩ་ཕུག་གིས་ཞེས་བྱ་བ་ནི་ཁྲག་གཏར་བའོ།",
    "གཟིགས་སུགསོལ་ཞེས་བྱ་བན་ལྟོས་ཤིག་ཅེས་བྱ་བའོ།",
    "མངོན་སུམ་དུ་བབས་པ་ཞེས་བྱང་ནགཞནངག་གི་དགེ་སློང་གི་མངོན་སུམ་དུ་ལྡང་བར་བྱས་པའོ།",
    "ཁྱོད་པ་ཞེས་བྱ་བ་ནི་རྗེས་སུ་སྒྲུབ་པའོ།",
    "འཕྲལ་གྱི་ཞེས་བྱ་བ་ནི་འཕྲལ་གང་གི་བྱ་བའོ།",
    "འདིར་རྣམ་པར་རྒྱལ་བཞེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་གཡུལ་ལམ་ཁམས་གསུམ་པ་སྟེ།",
    "ངེས་བཞེས་བྱ་བ་ནི་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ལ་སོགས་པར་བྱེད་པ་ངེས་པ་སྟེ་མཐོད་བའི་ལམ་མོ།",
    "སྣོན་ཟླ་ཐ་ཆུངས་ཀྱི་གཡོན་ཅ་ན་ཞེས་བྱ་བ་ནི་སྔོན་ཟླ་བ་ཆུངས་ཀྱི་ཟླ་བ་ལ་ལྷ་མོ་བགྲོད་དཀའ་མཆོད་ནས་ཆོ་མ་རྐུན་བྱེད་པ་དག་གོ།",
    "ལྟང་བ་མཐོང་ཞེས་བྱ་བ་ནིཡང་བན་ཉོན་མོངས་པ་ཅན་ཡིན་པའི་ཕྱིར་དང་།",
    "ཐམས་ཅ་ད་གཟིག་ས་པཞེས་བྱ་བ་ནི་མཐོང་བས་དངོས་པོ་ཐམས་ཅད་ཀྱི་བྱེ་བྲག་མ་བྱནཔའི་ཕྱིར་རོ།",
    "སྡམ་པཞེས་བྱ་བ་ནི་ཁྱིམ་མོ་རྒྱལ་པོའི་ཁབ་ཀྱི་ཕྱི་རོལ་དང་འོད་མའི་ཚལ་གྱི་ཕྱི་རོལ་གྱི་བར་དུ་ཞེས་བྱ་བ་ཞི་དེ་གཉིས་ཀྱི་བར་དུའོ།",
    "དགེ་སློང་གིརྒྱས་ཤེས་པ་ཞེས་བྱ་བཞི་དགེ་སློང་དང་འདྲེ་འདྲེ་བའོ།",
    "སྒོའཔར་ཞེས་བྱ་བ་ནི་སྒོ་དྲུང་གི་ཐེམ་པའོ།",
    "དགོངས་ཀ་ཟའ་དོད་པས་ཞེས་བྱ་བནི་མཚན་མོ་ཟ་འདོད་པས་སོ།",
    "ཁ་ཅིག་ན་རེ་སྐབས་འདིར་བྲམ་ཟའི་དཀྱིལ་འཁོར་དང་ལྡེའུ་རིགས་ཀྱི་དཀྱིལ་འཁོར་དང་དགེ་སྦྱོང་གི་དཀྱིལ་འཁོར་འཇིག་རྟེན་དུ་འགྱུར་བའི་གཏམ་དང་།",
    "ཁ་ཅིག་གི་སའདིར་བཏུས་པ་ཡིན་ཏེ།",
    "འདག་རྫས་ཞེས་བྱ་འབྱེད་བ་ནི་ལྕི་སྐམ་དང་ཐལ་བ་ལ་སོགས་པ་ལུས་ཀྱི་ཆ་ལལོ་ཧ་ཅང་ཟས་དྲགས་ནས་ཞེས་བྱ་བ་ནི་ཅང་ཚམ་ཆེས་སོ།",
    "འདི་ནི་རེ་ཞིག་བྱུང་བ་ཡིན་གྱི་ཞེས་བྱ་བཞི་འཆི་བསྐོས་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཡུལགཞན་དུ་སོང་ན་ཞེས་བྱ་བ་ནི་དུས་ཞི་བར་རོ།",
    "བདག་འརྩོམ་པར་བྱེད་པའོ་ཞེས་བྱ་བ་ནི་བ་དག་གིས་བདག་གསོད་པར་བྱེད་པའོ།",
    "བསྟནཔ་ཞེས་བྱ་བ་ནི་སེམས་བརྟན་བ་སྟེ་རེ་བ་དང་བཅས་པའོ།",
    "གྲོགས་མོཞེས་བྱབ་ནི་མཛའ་བཤེས་མོའོ།",
    "ཆེན་པོར་གྱུར་པ་ཞེས་བྱ་བ་ནི་ལུས་ཀྱི་བོང་ཚོད་དོ།",
    "བྱ་སྐྱིབས་སུ་ཞེས་བྱ་བ་ནི་ངམ་གྲོག་གི་ཕྱོགས་སུའོ།",
    "བདག་གི་སྲོག་ལ་གནོད་པར་འགྱུར་ཞེས་བྱ་བ་ནི་དེ་ལྟ་བུར་རྟག་ཏུགནས་པར་གྱུར་དུ་ཟིན་ཀྱང་བད་ག་གི་སྲོག་ལ་གནོད་པར་བྱེད་པར་མགྱུར་ཅིག་ཅེ་ས་བྱ་བའཐཚིག་གོ།",
    "གཞན་དུམ་ཡིན་པའི་བདག་གི་བདེན་ཚི་ག་མ་ནོར་བ་དེས་བདག་གི་ལུས་ལ་དུག་མའཇུག་ཅིག་ཅེས་བྱ་བའི་ཐཆིག་གོ།",
    "འོད་པ་བཞིན་དུ་ཞེ་བར་གནས་པཞེས་བྱ་བ་ནི་ཆུའི་འོད་པ་བཞིན་དུ་རང་གི་བྱ་བ་བྱེད་པ་ལ་མངོན་དུ་ཕྱོགས་པ་རགནས་པའོ།",
    "ནང་གིས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ཉལ་བའི་ལུས་བསྐྱིལ་བ་ཟླུམ་པོར་འདུག་པ་ལུར་བ་རླ་གཉིས་ཀྱི་སྐྱིལ་མོ་ཐུང་བྱས་ཏེ་འདུག་པའོ།",
    "ཉོན་མོངས་པ་ཞེས་བྱ་བ་ནི་བཀྲེན་པའོ།",
    "འཁྱམས་པཞེས་བྱ་བ་ནི་གར་སོང་མི་ཤེས་པའོ།",
    "འདི་ལྟངཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བའིཐཚིག་གོ།",
    "ཐུན་མོངས་མ་ཡིན་པཞེས་བྱ་བཞི་བསྒྲུབ་དཀའ་བའོ།",
    "བུ་ཟན་མོའི་བུ་ཞེས་བྱབ་ལ།",
    "རྡརྔོར་གྱུར་ཞེས་བྱ་བཞི་ཤེ་བ་མི་ཤེས་པ་དག་གི་བྱུག་རིས་བཞག་པས་སྐབས་སྐབས་སུ་སྟོང་བར་གྱུར་པའི་ཕྱིར་རོ།",
    "བསླབས་པར་གྱུར་ཅེས་བྱ་བ་ནི་དགེ་སློང་ཉུང་བས་གོ་བར་སྲབ་མོར་གྱུར་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་ཞི་པར་གྱུ་རཔ་དེ་དག་ནི་སྔོན་བཅོམ་ལྡནའདས་འོད་སྲུང་གི་རིང་ལ་དགེ་སློང་རྣལ་འབྱོར་སྤྱོད་པར་གྱུར་ཏེ།",
    "རང་གིལག་དར་ཏེ་ཞེས་བྱ་བ་ནི་འ་དིལ་རང་གིལག་མངོན་སུམ་དུ་དར་བ་སྲིད་པའི་ཕྱིར་ངོ།",
    "བདག་ཉིད་སོད་ཅིག་ཅེས་བྱ་བ་ནི་རང་གིས་བསྐྱེད་པའི་མཚོནལ་སོགས་པས་སོ།",
    "ལུས་ཀྱི་ཀུན་ཏུ་སྤྱོད་པ་ཞེས་བྱ་བ་ལུས་ཀྱི་ལས་ཉོན་མོངས་པ་ཅན་གང་ཡིན་བ་དེ་ནི་ལུས་ཀྱི་ཀུན་ཏུ་སྤྱོད་པ་ཡོངས་སུམ་དག་ལའོ།",
    "རྒྱ་ཤུག་གིའབྲས་བཞེས་བྱ་བནི་རྒྱ་ཤུག་གིརུས་པའོ།",
    "མདུང་ཐུང་ཞེས་བྱ་བ་ནི་ཡུ་བ་ཐུང་བ་མིའི་ཚད་ཙམམོ།",
    "རྡོན་སྡུད་ཅེས་བྱབ་ནི་རི་དགས་ཀྱི་འཁྲུལ་འཁོར་རེ།",
    "སོག་མའི་ཆག་ཆག་ཅེས་བྱ་འཆི་སོགམའི་ཆང་སྤུངས་སྟེང་ཆུ་གྲང་མོ་མ་འདེབས་པའོ།",
    "དེའི་ཕྱིར་བཤམས་པའི་གདན་ནི་དྲང་སྲོང་གི་ག་དན་ནོ།",
    "དེ་བརྡ་སྤྲོད་པ་ཞེས་བྱ་བ་ནིབདག་གི་ཟག་པ་ཟད་དོ་ཞེས་བྱ་བ་ལ་སོག་ས་བསྒྲོགས་པར་བྱེད་ཅེས་བརྗོད་པའི་ཐ་ཆིག་གོ།",
    "ཐང་ཟང་གི་ལོངས་སྤྱོད་ཅེས་བྱ་བ་ནི་བསོད་སྙོམས་ལ་སོགས་པའི་ཟར་བྲིང་གི་ལོངས་སྤྱོད་དོ།",
    "ཁ་ཅིག་ན་རེ་པོ་བལིར་དཀར་བོའི་རྩབ་མོལནཚ་ཅན་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ལས་སུ་བསྐོ་བཞེས་བྱབ་ནི་ལས་སུག་སུག་པ་སྐུ་ལས་ཀྱི་རེས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འཕོང་གིསློབ་དཔོན་ཞེས་བྱ་བ་ནི་འཕོང་གི་རིག་བྱེད་ལམཁས་པའོ།",
    "གཏིམུག་གི་འཆིང་བ་སྟུག་པོ་དག་གོ།",
    "གཙུག་ལག་ཁང་ཞེས་བྱ་བ་ནིཐུན་མོང་མ་ཡིན་པའོ།",
    "འདུག་གནས་ཞེས་བྱ་བ་ནི་གཞན་དང་མཐུན་མོ་རབའོ།",
    "ལྟདམོ་ཞེས་བྱ་བ་ནི་ཡ་མཚན་གྱི་བློས་ལྟ་འདོད་པའོ།",
    "ལས་བདག་གིར་བྱ་བམཁྱེན་པའི་སྟོབས་དང་།",
    "མོས་པ་སྣ་ཚོགས་མཁྱེན་པའ་སྟོབས་དང་།",
    "མཚན་མོའི་ཐུན་དང་བོ་དང་།",
    "འབྲས་བུཞེས་བྱ་བ་ནི་དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུའོ།",
    "འདོ་ད་པའི་འདམ་ཞེས་བྱ་བ་ནི་དངོས་པོའི་འདོད་པ་དང་ཉོན་མོངས་པའིའདོད་པ་སྟེ།",
    "ཡང་ན་རང་གི་ངོ་བོ་ངེས་པར་རྟོག་པའོ།",
    "འཕྲུལ་དགའཞེས་བྱ་བ་ནི་ཅི་དགར་སྦལ་པ་དག་གིས་མངོན་བར་དགའ་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "དགེ་རྒྱས་ཞེས་བྱ་བ་དག་ཀྱང་དགེ་ཆུང་དང་འབྲིར་དང་ཆེན་པོའདི་ཀྱི་བྱེ་བྲག་གིས་གེ་རིམས་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "བད་གམེད་པཞེས་བྱ་བ་ནི་རང་གི་བདག་ཉིད་དང་གཞནལ་བདག་པོ་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "ཐལམོ་སྦྱར་ཏེ་ཞེས་བྱ་བ་ནི་ཐལ་མོ་ཕུག་པུག་པོར་སྦྱར་བའོ།",
    "རང་བློས་ཞེས་བྱ་བ་ནི་རང་གི་ཡེ་ཤེས་ཀྱིས་སོ།",
    "དམ་པ་ད་གེ་བ་དག་གིས་ཞེས་བྱ་བ་གསུངས་ཏེ་བརྟན་པ་ཞེས་བྱ་བཞི་མིགཡོ་བའོ།",
    "ཞིབ་ཞེས་བྱ་བ་ནིལུས་དང་ངག་གིས་སོ།",
    "སེངྒལྟར་ཞེས་བྱ་བ་ནི་ནགས་ཁྲོད་ན་གནས་པ་དག་གི་དཔེའོ།",
    "ད་པའ་བོ་ལྟར་ཞེས་བྱ་བནི་སྡར་མ་དག་གི་དཔེའོ།",
    "ཡུལ་འཁོར་སྲུད་ལྟར་ཞེས་བྱ་བལ་སོགས་བརྒྱལ་པོ་ཆེན་པོ་བཞི་ནི་རི་རབ་ཀྱི་བང་རིམ་དག་ན་གནས་པ་དག་གི་དཔེ་རྡོ།",
    "སོར་མོ་དང་བ་དང་།",
    "ཐལ་གོང་རྒྱས་པ་དང་།",
    "དྲང་སྲོང་སྔ་བཞེས་བྱ་བ་ནི་དྲང་སྲོང་གི་གནས་ཀྱི་མིང་ངོ།",
    "སྲིད་སྲུང་གི་རིག་བྱེད་དོ།",
    "ཁྱོད་ཚུལ་ཞེས་བྱ་བ་ནི་འགྲེང་བ་ལ་སོགས་བྱ་བ་མེད་པའི་རྣམ་པའོ།",
    "ཚིག་དེ་དག་གི་ས་མྱ་ངན་ལས་འདས་པ་ལ་བསམ་པ་ཡིན་པ་ས་བྲམ་ཟེ་མི་ཤེས་སོ།",
    "བག་ལ་ཉལ་ཞེས་བྱ་བནི་སྲེད་པལ་སོགས་པ་སྡུད་པའི་ཉོན་མོངས་བའོ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བཞེས་བྱ་བཞི་ཞབར་ལེན་ོཔའི་ཕུང་པོལྔའི་ཡུལ་ལ་བདག་དང་བདག་གིར་ཤེས་པའོ།",
    "རིའི་རྩེ་མོཞེས་བྱ་བན་འཇིག་ཚོགས་ལལྟ་བ་དེ་ཞི་དགཞག་དཀའ་བའི་ཕྱིར་རི་དང་འདྲའོ།",
    "དན་སོང་ཤུལ་ཞེས་བྱ་བ་ནི་ཡང་སོས་ལ་སོགས་པའིསྒོའོ།",
    "མྱ་ངན་ལས་འདས་པའི་ཤུལ་ཞེས་བྱ་བནིའཕགས་པའལམ་༡མོ་ཐོབ་པར་འགྱུར་ཞེས་བྱབ་ནི་ཤེས་པར་གྱུར་པའོ།",
    "འབྲིང་གི་ཁྱིམ་མོ།",
    "གང་གི་ལུས་ལ་དེ་གྱོན་པ་དེ་ནི་སྣུམ་སྐྱར་གྱོན་པའི་ལུས་དང་ལྡན་པའོ།",
    "གྲོང་གི་བྱང་ཕྱོགས་ཞེས་བྱ་བ་ཞི་གྲོང་ནས་ཧ་ཅང་མི་རིང་བའི་བྱད་ཕྱོགས་ལོགས་ཀྱི་ངོས་ནའོ།",
    "གྲོང་ཚིགསཞེས་བྱབ་ན་གྲོང་གི་ཕྱོགས་སོ།",
    "སྦོར་བ་ཞེས་བྱ་བ་ནི་ཞེ་སྡར་ལ་སོགས་པ་ཞོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་འགོག་པའོ།",
    "རུས་གོང་གི་འ་ཞུགས་ཞེས་བྱ་བ་ལ་ནི་ཐོད་པ་ལ་སོགས་པ་ལ་དམིགས་པའི་འདུ་ཤེས་སོ།",
    "ཞེས་བྱ་བར་མོས་པ་ལས་བྱུང་བ་བསམ་གཏན་ཀྱིས་པའིཞ་༦།",
    "མཐའ་ཞེས་བྱ་བ་ནི་མཇུག་གི་མཐར་ཐུག་པསྟེ་མྱངན་ལས་འདས་པའོ།",
    "རེག་པར་སྤྱོད་པ་ཞེས་བྱ་བ་ནི་བདེ་བར་གནས་པའོ།",
    "ལུས་ལ་སོགས་པའི་ངང་གི་ངོ་བོ་ལ་དམིགས་པའི་ཕྱིར་རོ།",
    "དེའི་ཤས་ཆེ་བཞེས་བྱབ་ནི་དེའི་འབྲས་བུདང་ལྡན་པའོ།"
  ]
}