    "རགས་པ་ལ་བརྟན་པ་མ་ཐོབ་བར་དུ་དེ་ལྟར་བྱས་ཀྱང་འོང་ངོ།",
    "སྤྲོས་བྲལ་དབྱེར་མེད་ལ་མཉམ་པར་བཞག་པ་གོམས་པས་སེམས་གནས་ན་སྟོང་གཟུགས་གནས་གཡོ་ན་གཡོ།",
    "སེམས་ལེགས་པར་གནས་དུས་མཐོང་བྱ་མཐོང་བྱེད་ཐ་དད་པར་སྣང་བ་མངོན་གྱུར་འགགས་པ་ནི་ཤེས་རབ་རྒྱུད་ལ་སྐྱེས་པའི་ཚད་ཡིན།",
    "ངེས་ཚིག་ནི་དྷཱུ་ན་ཞེས་དམིགས་པ་ལ་སེམས་རྩེ་གཅིག་པར་འཛིན་པའི་དོན་ཅན་ནོ།",
    "དེ་ལྟར་བྱས་པས་སོར་སྡུད་བསྒོམ་ཀྱང་ཉམས་རྟོགས་མ་སྐྱེས་པ་རྣམས་སྐྱེ་ཅུང་ཟད་སྐྱེས་པ་རྣམས་གསོ།",
    "བོགས་འདོན་མ་དགོས་ན་རང་བཞིན་བསྒོམས་པར་མི་བྱ།",
    "གཞན་ཡང་བོགས་འདོན་ཅི་རིགས་གཞན་ལས་ཤེས་པར་བྱ།",
    "སོར་བསམ་གཉིས་ཀྱི་ཉམས་མྱོང་ཁྱད་པར་ཅན་སྐྱེས་པ་རྩ་བཟང་བའི་རིགས་འགའ་ཞིག་སྲོག་རྩོལ་ཆེད་དུ་མ་བསྒོམ་ཀྱང་།",
    "གྱེན་དུ་འགྲོ་བ་ཤས་ཆེ་ཁམས་ངན་པར་འགྱུར།",
    "འདི་སྐབས་དང་པོར་དལ་བུས་འབེབ་མང་དུ་བྱས་ནས།",
    "དལ་བར་མ་མནན་པར་ཤུགས་དྲག་ན་མགོ་རོ་སྟོད་ན་བའང་སྲིད།",
    "དྷཱུ་ཏིའི་འཁོར་ལོ་རྣམས་སུ་འགྲོ་འོང་བྱེད་ཅིང་རིམ་གྱིས་འགག་པར་བྱེད་པ་སྲོག་རྩོལ་དང་།",
    "དེ་རྗེས་འབྱིན་པ་ཨཱ་ཡིས་སྒྲ་གདང་བཅས་འོད་ཟེར་ཨཱ་ཡིག་དམར་པོའི་རྣམ་པར་འཕྲོ་བ།",
    "སྒྱུ་མ་ལྟར་རྟོགས་པ་ལས་མི་ཡེངས་པར་བྱ་བའོ།",
    "འདི་སྐབས་རོ་རྐྱང་སོགས་ཀྱིས་ཁྱད་པར་མི་སྦྱར་བ་འབྱིན་འཇུག་གནས་གསུམ་ལ་སེམས་འཛིན་པ་སོགས་ལུགས་དུ་མ་ཡོད།",
    "མི་ཐུབ་འདྲ་ན་རྔུབ་ཆུང་ལན་གསུམ་བྱས་ཏེ་མནན།",
    "དེ་ལྟར་བུམ་ཅན་ལ་ཡང་ཡང་གོམས་པར་བྱ།",
    "ཁོག་པའི་ནང་དུ་ཕྱི་ལ་རྒྱུ་བའི་སྲོག་ཐུར་རགས་པ་འདྲེས་པ་རྨོངས་པ་མཚར་སྐྱེད་ཙམ་ཡིན་གསུངས།",
    "རྒྱུད་ལས་ཞལ་བཞི་ལས་འཁོར་འདས་ཐམས་ཅད་སྤྲུལ་པར་གསུངས་པའི་དགོངས་པའི་གཙོ་བོའང་འདི་ཡིན་ནོ།",
    "འཛིན་པའི་སྐབས་འདིར་ངེས་པའི་རྟགས་ཡིན་ཅིང་འདི་སྐབས་སྲོག་གཟུགས་ཁྱད་པར་ཅན་འགྲུབ་པ་ཡིན་ཏེ།",
    "བློས་བརྟགས་ལ་མ་ལྟོས་པར་ལྷ་སྐུ་མཚན་དཔེ་ཅན་གྱི་རྣམ་པས་དང་པོ་གཅིག་འཆར་བ་ནས་བརྩམ་སྟེ་ཇེ་མང་འཕེལ།",
    "སྲོག་གཟུགས་འདྲེས་པའི་ལྷ་དེ་གང་འདོད་ཀྱི་ལྷའི་རྣམ་པར་བློས་གང་སྒྱུར་བ་དེར་འགྱུར་ཏེ།",
    "ཟད་པར་རྣམས་ཀྱང་དེ་བཞིན་འགྲུབ་སྟེ།",
    "དཔེར་ན་ལྟེ་བའི་ལ་ཡིག་ལས་ས་ཡི་ཟད་པར་ཟམ་པ་ལྟ་བུ་སྤྲོས་ཏེ་ལྟེ་བའི་བུམ་ཅན་ལ་འབད་པས་ཆུ་བོའམ་རྒྱ་མཚོའི་སྟེང་ནས་མི་བྱིང་བར་འགྲོ་བ་སོགས་བྱེད་པའོ།",
    "གེགས་སེལ་གདམས་པ་གཞན་ལ་མ་ལྟོས་པར་སྒྲུབ་པོ་རང་ཉིད་ཀྱི་ཤེས་པར་འགྱུར་རོ།",
    "ལམ་སྔ་མའི་སྟོབས་ཀྱིས་རང་ཤུགས་ཀྱིས་སམ་ཞུ་བདེ་འབར་བས་བདེ་བ་ཁྱད་པར་ཅན་སྐྱེས་པ་ན།",
    "འདིའི་དམིགས་ཡུལ་བདེ་བ་དེ་ཉིད་ཡང་ནས་ཡང་དུ་རྒྱུད་ལ་དྲན་པར་བྱེད་པའོ།",
    "མཁའ་གསང་བྱིན་དུས་འཁོར་རྫོགས་རིམགྱིས་བརླབས་ནས་སྙོམ་པར་ཞུགས་པའི་བདེ་བ་སྐྱེས་པས།",
    "མཐར་ནོར་བུའི་རྩེར་བཅིངས་བ་གྱེན་དུ་དྲངས་ཏེ་གཙུག་ཏོར་གྱི་འཁོར་ལོའི་བར་མས་བརྟན་གྱི་དགའ་བ་དང་གཟུགས་བསྲེས་ཏེ་བུམ་ཅན་འཛིན་ཅིང་མཉམ་པར་བཞག།",
    "དེས་ཏིང་ངེ་འཛིན་མཚན་ཉིད་པ་འདྲེན་ཏེ་ས་ལམ་དངོས་སུ་བགྲོད་ནུས་པར་འགྱུར་རོ།",
    "ཕྱག་ཆེན་ཁོ་ནས་བདེ་བ་རྫོགས་པར་འདྲེན་མི་ཐུབ་པའི་དུས་ན།",
    "དག་པ་དང་མ་དག་པའི་སྲིད་གསུམ་གྱི་གཟུགས་བརྙན་སྒྲོ་ཞིང་སྡུད་པར་སྣང་བ་འབྱུང་ངོ།",
    "རང་ཉིད་སྟོང་གཟུགས་ཀྱི་ལྷ་སྐུ་ཡབ་ཡུམ་དུ་གྱུར་ཏེ།",
    "པར་ཅན་སྐྱེས་ཏེ་རྩ་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་གཉིས་ཀྱི་བྱང་སེམས་ཐམས་ཅད་དྲོས་ནུས་པ་དང་།",
    "དཔྲལ་བར་ཐིག་ལེ་འཛིན་པར་ནུས་ལ།",
    "རྟག་ཏུ་ཁེགས་ན་ནོར་བུར་འཛིན་ནུས་ཞེས་མན་ལུང་གུ་རུ་སོགས་གསུངས།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "རྩོལ་མེད་དུ་བཞག་ཀྱང་ནོར་བུ་ལས་བྱང་སེམས་མི་འཛག་པར་མ་ཟད་ཀྱི།",
    "འཁོར་འདས་ལམ་གསུམ་གྱི་གཟུགས་བརྙན་དཔག་ཅིག་ཆར་སྣང་བ་རྒྱུན་མི་འཆད་པར་འབྱུང་།",
    "ཕུང་ཁམས་སོགས་ལྷ་སྐུར་ཤར་བས་ལུས་དག་པ།",
    "མཐོང་ཉམས་རྨི་ཉམས་ཏེ་རྟགས་ལྔར་གྲགས་པ་ཉེར་མཁོ་ཆེ་རིགས་བརྟན་པ་འདིས་མཚོན་ནས་མཐའ་ཡས་པའི་བར་དུ་ཤེས་པར་བྱ་བ་དང་།",
    "ཡོན་ཏན་ཅན་གྱིས་ངོ་སྤྲད་པར་བྱ་སྟེ།",
    "ཞེས་རྗེ་བཙུན་སྒྲོལ་བའི་མགོན་པོས་གདམས་པར་མཛད་དོ།",
    "སྐུ་བཅུ་དྲུག་དག་པར་འགྱུར།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་འཁོར་ལོ་འགྲུབ་བོ།",
    "ཐུན་མཚམས་ཀྱི་རྣལ་འབྱོར་སོགས་ལམ་གྱི་ཡན་ལག་རྣམས་གཞན་དུ་ཤེས་པར་བྱའོ།",
    "ཉམས་རྣམས་ལ་སྐྱོན་ཡོན་དུ་རློམ་པས་མ་བཅིང་པར་བྱུང་རྒྱལ་དུ་བསྐྱངས་བས་གྲོལ་ལོ།",
    "དེ་བཞིན་བོགས་འདོན་གྱི་གདམས་ངག་རྣམས་ཀྱང་ཤེས་པར་བྱའོ།",
    "བསམ་གཏན་ནི་སྟོང་གཟུགས་ལ་དམིགས་རྟེན་བྱས་ཏེ་ཤེས་རབ་དང་།",
    "དུས་ཀྱི་འཁོར་ལོའི་རྒྱུད་ལས་གསུངས་པའི་སྦྱོར་དྲུག་འདི་ནི་རྫོགས་རིམ་དངོས་ཡིན་ལ་གསང་བ་འདུས་པ་ལས་གསུངས་པའི་སྦྱོར་དྲུག་ནི་གཙོ་ཆེར་བསྐྱེད་རིམ་དང་འབྲེལ་བ་ཡིན་ཏེ།",
    "དངོས་པོར་བལྟས་ཏེ་མཚན་མའི་རྗེས་སུ་འབྲང་བ་གཉིས་གང་ཡང་མིན་པར།",
    "རྟགས་ཡོད་པར་ལུས་དང་ལྷའི་རང་བཞིན་དུ་ཡང་དམིགས་པའོ།",
    "གོང་མ་ལྟར་རྩལ་སྦྱངས་པའི་ཤུགས་ཀྱིས་ཡེ་ཤེས་རང་རིག་པ་རྣམ་པར་མི་རྟོག་པ་ཐོབ་སྟེ་སྒྲིབ་པའི་དྲྭ་བ་གཅོད་པའོ།",
    "འབྱུང་ལྔའི་གདན་དང་ལྷ་སྐུ་ཡབ་ཡུམ་བར་གྱི་དམིགས་པ་དང་།",
    "རྡུལ་བྲལ་འཕོ་མེད་ཀྱི་སྐུ་འགྲུབ་པར་བྱེད་ལ།",
    "ལྷ་ནི་མཐོང་བ་སྐྱེད་མིན་དག་དང་སྲེད་པ་རྣམ་བཅུར་གསུངས་པ་རྡོ་རྗེ་ཡི་ནི་ལུས་དག་ལས།",
    "ཀུན་ཏུ་ཡེ་༧ཤེས་དང་ནི་སྟོང་པའོ་ཞི་བ་གནས་དང་བཅས་པ་དངོས་པོ་ཀུན་གྱིས་རྣམ་པར་གྲོལ།",
    "ཨ་སོགས་ཀ་སོགས་ལྡན་པ་དག་ལས་དེ་ལྟར་ཁམས་གསུམ་དག་ནི་ངེས་པར་སྐྱེད་འགྱུར་མི་ཡི་བདག་༨།",
    "མཐའ་དག་ས་༢༦གཞི་ལ་ནི་གྲུབ་པའི་མཐའ་རྣམས་རྣམ་པར་ཉམས་པ་དུས་ཀྱི་སྦྱོར་བ་ལ་འབྱུང་འགྱུར།",
    "ནག་པ་ལ་སོགས་ཟླ་བ་བསྲེས་ཏེ་འོག་ཏུ་དུས་ཀྱིས་བསྒྱུར་བ་མཁའ་མེ་ཟླ་བས་རྣམ་པར་དབྱེ།",
    "རྙེད་པ་སྟེང་དུ་བསྲེས་པ་དག་ནི་མི་ཡི་བདག་པོ་ཟླ་བའི་ཚོགས་པ་རྣམ་པར་དག་པར་འགྱུར།",
    "འདི་དག་ཟླ་བའི་ངེས་པར་འགྱུར་ཏེ་སླར་ཡང་ཟླ་བ་ཟླ་བ་དག་ལ་རབ་ཏུ་སྦྱིན་པར་གསུངས།",
    "སྟོང་ལ་སྟོང་པ་རྣམ་དག་བཅུ་གསུམ་ཟླ་བའི་རྐང་པར་ལྔ་སྟེ་མིག་དང་ཉི་མ་དག་ལ་ཕྱོགས།",
    "ལྔ་དང་བུག་པར་ཉི་ཤུ་རྩ་གཉིས་དུས་དང་ནོར་ལ་རྒྱལ་བ་བདུན་པར་ཉི་ཤུ་རྩ་ལྔ་སྟེ།",
    "དེ་ལ་ཉི་མའི་རབ་ཏུ་དབྱེ་བས་གསལ་བྱས་ཉི་མའི་རྐང་པ་དག་ནི་སྦྱིན་དང་དོར་བར་འགྱུར།",
    "དམན་པར་གྱུར་པ་རི་བོང་མཚན་མར་འགྱུར་ཏེ་མི་ཡི་བདག་པོ་ཉི་ཟླ་བསྲེས་པ་སྦྱོར་བའོ།",
    "༣༦ ལུག་སོགས་རྣམས་ཀྱིས་སྣོན་བྱེད་དག་ལ་གཟའ་དང་ཆུ་ཚོད་རིམ་པར་ཡོངས་བཀོད་བཅུ་གཉིས་འདི་དག་སྟེ།",
    "གནས་གསུམ་དབུས་སུ་རྣམ་པར་བསྲེས་པ་ལས་ཀྱང་ཆུ་གཏེར་རོས་ཐོབ་དམན་པ་མི་གསལ་ཉིན་ཞག་གོ།",
    "མིག་དམར་ལ་ནི་ཕྱེད་བཅས་དགུ་སྦྱང་གལ་ཏེ་བུ་ལོན་ལྷག་ན་འཁོར་ལོ་བསྲེས་ལ་རྣམ་པར་སྦྱང་།",
    "ཕྱེད་ལས་ལྷག་པར་གྱུར་ནའང་འཁོར་ལོ་ཕྱེད་ནི་དོར་བར་བྱ་སྟེ་དོར་བའི་ལྷག་མ་རིམ་མིན་འགྱུར།",
    "སྐར་མ་དྲུག་ཅུས་བསྒྱུར་ཏེ་ཆུ་ཚོད་དག་དང་རབ་ཏུ་ལྡན་པར་གྱུར་པ་འབྱུང་མེ་ཟླ་བས་བགོ།",
    "སྐྱེས་དཀར་པོ་ལ་ཡང་ཉི་མ་དག་སྟེ་མྱུར་བའི་ལས་ལ་ངེས་པར་རིམ་པས་ནོར་དུ་འགྱུར།",
    "ས་སྐྱེས་ལ་ནི་རྐང་པ་རྒྱལ་བ་སོགས་ཏེ་རབ་གསལ་མ་ནུའི་གནས་ལ་མཐའ་དག་གཞག་པར་བྱ།",
    "གང་དག་སུ་ཞིག་ཉི་མའི་ལོངས་སྤྱོད་ལ་ནི་རབ་ཞུགས་གཟའ་དེ་དག་ཀྱང་ངེས་པར་ནུབ་པར་འགྱུར།",
    "ཉི་མ་བཏང་ནས་འཆར་བར་འགྱུར་ཏེ་དེ་ཡི་ལམ་ཡང་བགྲོད་པ་འགྲོ་བའི་རྣམ་པར་དབྱེ་བས་སོ།",
    "སྐར་མ་ལ་སྟེ་གཞན་ལ་འཐོབ་པ་མིན་པར་ངེས་ཤིང་འདིར་ནི་ཕན་ཚུན་མཚུངས་པ་དག་ཏུ་ལྡན།",
    "ཚིགས་མཚམས་སུ་ཡང་སྒྲ་གཅན་གདོང་དང་མཉམ་པར་འགྲོ་སྟེ་མངོན་དུ་ཕྱོགས་པར་འཛིན་པ་ཁོ་ནའོ།",
    "རྒྱུ་སྐར་གཡས་དང་གཡས་མིན་དག་ལ་ངེས་པར་སྲིད་པའི་གནས་སུ་ཁྱིམ་གྱི་དབྱེ་བས་ཡང་དག་གནས།",
    "འདིར་ནི་གཡོན་བགྲོད་དུ་འགྱུར་ཉི་མ་ཆུ་སྲིན་གནས་པ་ལ་སྟེ་བུམ་པར་ཉི་མས་གཉིས་པ་ལ།",
    "ཉི་མ་ཀརྐ་ཊ་ལ་གནས་པས་འགྱུར་ཏེ་སེང་གེ་ལ་གནས་ས་ཡི་དུམ་བུ་བརྒྱད་པར་རོ།",
    "གཞུ་ལ་གནས་པས་བཅུ་གཉིས་པར་འགྱུར་མི་རྣམས་བགྲོད་པ་དག་ཀྱང་བཅུ་གཉིས་རྩིབས་ཀྱི་ས་ལའོ།",
    "དེ་ནས་གཡས་ཕྱོགས་སུ་ཡང་ཟད་པར་འགྱུར་ཏེ་མི་ཡི་བདག་པོ་སྟོང་ཕྲག་དག་ནི་དྲག་པོའི་གྲངས།",
    "དེ་ལས་གང་ཞིག་འཕེལ་དང་འགྲིབ་པར་འགྱུར་བ་མཁའ་མཁའ་མདའ་དང་མདའ་ནི་བྱང་དང་ལྷོར་ཡང་ངོ།",
    "རི་ཡི་རྒྱལ་པོ་དག་ནི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་ཡང་བྱང་ན་གནས་པར་འགྱུར་རོ་མི་ཡི་བདག།",
    "སྟོང་ཕྲག་ཉི་ཤུ་རྩ་གཅིག་རོ་བརྒྱ་ལྡན་པ་དག་ལས་སོ་ཡི་ཆ་ཡིས་ངེས་པར་ཕྱུང་གྱུར་པ།",
    "མ་བཅད་དུས་ཀྱི་འཁོར་ལོའི་བགྲོད་པ་དག་ལ་བུ་ལོན་དགུ་ནི་བསྲེས་པར་གྱུར་པ་མཐའ་དག་རྣམས།",
    "སྔ་ཕྱི་ཕྱེད་ལ་མཚུངས་པར་བུ་ལོན་ནོར་གྱི་བགྲོད་པ་དག་ལ་གནས་ཀྱི་དབྱེ་བས་ངེས་པར་སྦྱར།",
    "རྩ་བ་དག་ལས་རིག་བྱེད་དྲག་པོ་དང་ནི་རབ་གསལ་ངེས་པར་བཅུ་གཉིས་པ་ལ་ཉི་ཤུ་སྟེ།",
    "སུམ་ཅུ་རྩ་དྲུག་ཕྱེད་བཅས་ཟླ་བ་ངེས་པར་ནོར་གྱིས་བསྒྱུར་བ་དག་ནི་བཀྲ་ཤིས་ལ་སོགས་པ།",
    "སྒྲ་གཅན་ཟླ་བའི་ལོངས་སྤྱོད་ཉི་མ་དང་བཅས་ཟླ་བའི་རྐང་པ་ཆུ་ཚོད་ཕྱེད་ཀྱིས་རྣམ་པར་དམན།",
    "དེ་ནི་ཉི་མའི་ལྷག་པར་འགྱུར་ཏེ་ངེས་པར་དུས་ཀྱིས་བསྒྱུར་བ་ཉི་མའི་ཟླ་བར་ཉིན་ཞག་དེའོ།",
    "ཆུ་སྲང་བདུན་དང་ཕྱེད་ཕྲོགས་ངེས་པར་ཡོན་ཏན་གྱིས་བསྒྱུར་ཉི་མའི་ལོངས་སྤྱོད་དག་ལ་སྦྱང་བར་བྱ།",
    "དེ་ཡི་འཆར་བའི་ཆ་དག་ཤེས་པར་གྱུར་ན་དེ་ཡི་འཆར་བ་མཐའ་ཡས་དུས་ཀྱང་ཤེས་པར་འགྱུར།",
    "ས་སྐྱེས་ལ་ནི་རི་དུས་གཅིག་ཀྱང་ངེས་པར་ནོར་དུ་འགྱུར་ཏེ་ཟླ་བའི་བུ་ལ་བརྒྱས་བསྣུན་པ།",
    "ཕྱི་ནས་དེ་དག་རྣམས་ནི་དག་པར་འགྱུར་ཏེ་མི་ཡི་བདག་པོ་སྐྱེ་བའི་རྒྱུ་སྐར་རྒྱུ་བ་ལས།",
    "སླར་ཡང་ཕུང་པོ་གཉིས་ཀྱིས་ངེས་པར་བཞི་པོ་རྣམས་ཀྱི་ལོ་ཡི་གྲངས་དག་ཏུ་ནི་རབ་ཏུ་འགྱུར།",
    "དཔལ་ལྡན་དུས་ཀྱི་འཁོར་ལོ་གཟའ་ཡི་ཚོགས་དང་བཅས་པ་འདི་དག་ཕྱི་དང་ལུས་ལ་དབྱེར་མེད་པར།",
    "བདེན་པར་འཆར་བ་ལྔ་པོ་རྣམས་ཀྱི་འབྲས་བུ་མང་པོར་འཆི་བའི་སྦྱོར་བས་དམན་པ་དག་ལ་འགྱུར།",
    "དར་བབ་རྒན་པོ་རིམ་པས་མེ་དང་ཆུ་གཏེར་ཉིན་ཞག་ལ་སྟེ་ལྔ་པ་ལ་ནི་ནུབ་པར་འགྱུར།",
    "ཨ་སོགས་དབྱངས་ལྔ་གང་དག་ངེས་པར་ཡོན་ཏན་གྱིས་བསྒྱུར་དེ་དག་རྣམས་ནི་རྣམ་གཉིས་སུམ་ཅུ་ཉིད།",
    "རིང་པོ་རྣམས་ནི་ནག་པོའི་ཕྱོགས་ལ་ཤིན་ཏུ་ངེས་པར་འགྱུར་ཏེ་སྤྲོ་དང་བསྡུ་བའི་སྦྱོར་བས་སོ།",
    "གཡས་ལ་དེ་ཉིད་འཛིན་མ་སོགས་དང་གཟའ་ཡི་ཚོགས་ནི་ངེས་པར་ཉི་མའི་བུ་ལ་སོགས་པ་ཉིད།",
    "ཕྱི་རོལ་ཏུ་ཡང་དུས་ཀྱི་ཆུ་ཚོད་གཟའ་ཡི་གནས་དང་མཉམ་པ་དབྱངས་བཅས་དག་ནི་བསྒྲུབ་པར་བྱ།",
    "༡༤ གཡུལ་དུ་དགྲ་ནི་ངེས་པར་རབ་ཏུ་ཉམས་པར་འགྱུར་ཏེ་སྒྲ་གཅན་སྟོང་པ་དག་ལ་ཤར་ན་ཡང་།",
    "མིག་དང་རིག་བྱེད་རོ་སྟེ་ཤིན་ཏུ་མཉམ་པའི་གནས་སུ་གྱུར་ན་བྱ་བ་དག་ཀྱང་འགྲུབ་པར་འགྱུར།",
    "ད་ལྟར་བྱུང་བ་ཤེས་པ་མིན་པར་དགེ་དང་མི་དགེའི་འབྲས་བུ་འཇིག་རྟེན་འདིར་ནི་གང་བརྗོད་པ།",
    "པར་ཉམས་པ་དག་ཀྱང་བྱེད།",
    "དགྲ་ཉམས་རང་ཉིད་རྒྱས་ཤིང་གཡུལ་དུ་རྣམ་པར་རྒྱལ་ཏེ་དགའ་མ་དང་བཅས་ནོར་དག་ཐོབ་པར་འགྱུར།",
    "ངེས་པར་དོན་ནི་ཐམས་ཅད་འགྲུབ་སྟེ་མཐའ་དག་ས་ཡི་སྟེང་དུ་དག་པའི་གཟའ་དང་ཚེས་ལའོ།",
    "རྒྱུ་སྐར་རྣམས་ནི་དགུ་དང་དགུ་དང་དགུ་ཡིས་ཆ་གསུམ་བྱས་ཏེ་སྐྱེས་པའི་རྒྱུ་སྐར་དང་པོ་ལས།",
    "ཐ་སྐར་ལ་སོགས་རྣམས་ཀྱིས་རྩ་གསུམ་སྤྲུལ་ཡང་སྤྲས་པར་གྱུར་པ་ནམ་གྲུ་ཉིད་ཀྱི་བར་དུ་སྟེ།",
    "སྡིག་ཟླ་སྐྱེས་པའི་རྒྱུ་སྐར་གལ་ཏེ་རྩ་གཅིག་དག་ལ་གྱུར་ན་མི་རྣམས་དག་ནི་རྣམ་པར་ཉམས།",
    "རྒྱལ་གྱི་ཟླ་བར་ཉི་མ་ཆུ་སྲིན་ལ་སོན་མ་རིག་པ་སྟེ་བུམ་པར་ཉི་མ་མཆུ་ལ་ཡང་།",
    "འདུ་བྱེད་དུ་འགྱུར་མི་ཡི་བདག་པོ་ཉ་རུ་ཉི་མ་དབོ་དག་ལ་ནི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "འདུ་བྱེད་མཆུ་ཡི་མཚམས་དག་ཏུ་སྟེ་བུམ་པར་ཉི་མ་སོན་པ་དེ་ལ་འདུ་བྱེད་ཁོ་ནའོ།",
    "དེ་ནས་གཉིས་པ་ལ་ནི་རྣམ་པར་ཤེས་པར་འགྱུར་ཏེ་ཉིན་ཞག་གསུམ་པ་ལ་ནི་མིང་དང་གཟུགས།",
    "གཡོན་དང་མདུན་དུ་འཆི་བའི་རང་བཞིན་མཉམ་དང་མི་མཉམ་གྱུར་པས་གཉིས་ཀའི་དཔུང་ནི་འཇོམས་པར་འགྱུར།",
    "ཆུ་ནས་མེ་ལྡན་དག་ཏུ་དེ་ནི་ངེས་པར་འགྲོ་སྟེ་ལྷོ་རུ་ལྷོ་ཡི་ཉི་མ་དག་ལའོ།",
    "ཕོ་ཉས་བརྗོད་པ་དང་པོའི་མིང་དེ་རྣམ་པར་རྒྱལ་བར་འགྱུར་ཏེ་ཕྱིས་ཀྱི་མིང་ནི་འཕམ་པར་འགྱུར།",
    "གཡུལ་དུ་ལྷ་ཡི་མགོན་པོ་དག་ནི་འཕྲོག་བྱེད་དྲག་པོ་དང་བཅས་མི་རྣམས་ཀྱིས་ཀྱང་འཇོམས་པར་འགྱུར།",
    "དཀྱིལ་འཁོར་ལ་གནས་ཤེས་པར་བྱ་སྟེ་གཞན་དུ་དགྲ་ནི་ཉམས་པ་མེད།",
    "༡༢༤ སྒྲ་གཅན་དུས་ལ་གནས་པ་རྣམས་ནི་འཆི་དང་བཅས་པར་འགྱུར་ཞིང་དཔུང་རྣམས་མཉམ་དུ་ལྷུང་བ་ནི།",
    "ལྟ་བའི་ཆ་ནི་སྤངས་པ་རྣམས་དག་རྣམ་པར་རྒྱལ་བར་འགྱུར་ཏེ་ལྟོ་བར་ཞུགས་ལ་གཉིས་པོ་ཡང་།",
    "དེ་ཡི་ནང་དུ་རྡོ་བ་རབ་ཏུ་བཅུག་སྟེ་སྟོབས་ལྡན་འཐེན་བྱེད་རྣམས་ཀྱིས་འཐེན་པར་གྱུར་པ་དག།",
    "བཏང་བ་མྱུར་དུ་ནམ་མཁར་འགྲོ་སྟེ་འཕྲལ་ལ་ངེས་པར་ལྟུང་ཞིང་ཁང་སྟེང་སོགས་དང་ལམ་སྲང་དུ།",
    "མཐའ་དག་ཕྱེ་མར་བྱས་ནས་ས་ཡི་འོག་ཏུ་འགྲོ་སྟེ་རྡོ་རྗེ་འབབ་པ་ཇི་ལྟ་བ་ཉིད་བཞིན།",
    "འཁོར་ལོ་ཁྲུ་ནི་ཕྱེད་དང་གསུམ་པར་འགྱུར་ཞིང་གནམ་གདན་སྟེང་དུ་གཞན་ཡང་དེར་ནི་སྲོག་ཤིང་སྟེ།",
    "ས་ལ་ཚད་ཀྱང་དེ་ཡིས་བརྗོད་པར་འགྱུར་ཏེ་དགྲ་རྣམས་ཀྱི་དུས་འཁོར།",
    "རྩེ་ལ་བཀོད་དེ་དགྲ་ཡི་ཁང་པའི་གཞི་དང་འདུན་ས་དག་ལ་མེ་ནི་རབ་ཏུ་སྦྱིན་པར་བྱ།",
    "སྤང་ལེབ་དང་ནི་མ་ཧེའི་པགས་པ་རྣམས་ཀྱིས་ཀུན་ནས་གཡོགས་པར་གྱུར་པ་ཟླུམ་པའི་རྣམ་པ་སྟེ།",
    "འོབས་དེ་བཀངས་ནས་མཁར་གྱི་རྩིག་པ་དང་ནི་ལམ་སྲང་དག་ཏུ་འཕྲལ་ལ་རབ་ཏུ་འཇུག་པར་འགྱུར།",
    "སྟེགས་བུར་ཕུར་པ་གཉིས་ལ་ངེས་པར་རྒྱུད་དང་བཅས་པའི་གཞུ་ནི་གཡོ་བ་མེད་པར་བཏགས་བྱས་ནས།",
    "ཀ་བ་གཉིས་ནི་ས་ཡི་ནང་དུ་བརྟན་པར་བཙུགས་པ་ཐག་པ་རྣམས་ཀྱིས་དཀྲིས་པར་གྱུར་པ་སྟེ།",
    "དེ་ཡི་དབུས་སུ་རལ་གྲིའི་ཆང་གཟུང་ངེས་པར་གཡོ་བ་མེད་པར་གཟེར་གྱིས་བཏབ་པར་རབ་ཏུ་འགྱུར།",
    "རལ་གྲིའི་སྟེང་དུ་ཟླ་བའི་དབུས་ཀྱི་ཆ་ལ་ལྕགས་ལས་བྱས་པ་ཆུང་ངུ་གཅིག་ཀྱང་གཞག་པར་བྱ།",
    "མཁར་གྱི་སྒོ་ཡི་མཐའ་རྣམས་དང་ནི་མི་ཡི་བདག་པོའི་ཁང་པར་འཁྲུལ་འཁོར་ཁོ་ན་མཚོན་ཆའོ།",
    "ཟླུམ་པོ་ཕྱེད་བཅས་གཅིག་ཆ་པདྨའི་ཤིང་རྟའི་ས་ནི་དགའ་བའི་དབྱེ་བ་དག་ལ་མཉམ་པར་འགྱུར།",
    "ཉི་མའི་ཤིང་རྟ་མཆོག་ནི་འཁོར་ལོ་གཅིག་པ་མི་མཉམ་རྟ་ཡང་ལྷ་མ་ཡིན་རྣམས་རྣམ་པར་འཇོམས།",
    "གཡུལ་དུ་ཕྱིར་མི་ལྡོག་པར་འགྱུར་བ་མི་མཉམ་མཉམ་པའི་ཤིང་རྟ་ཆེན་པོ་རྒྱལ་རིགས་རྣམས་ཀྱིའོ།",
    "སྟེང་དང་མངོན་དུ་ཕྱོགས་པ་འཇོམས་ཏེ་མཉམ་དང་མི་མཉམ་གཡུལ་དུ་རྒྱབ་ནི་འཇོམས་པ་མཉམ་པར་འགྱུར།",
    "ཆུ་ནི་འདྲེན་པར་བྱེད་ཅིང་དྲངས་པའི་ཆུ་ནི་བཏང་བར་གྱུར་པ་དག་ཀྱང་བུམ་པའི་བུ་ག་ནས།",
    "ཕྱི་རོལ་དུ་ནི་དུས་ཀྱི་དབྱེ་བ་ངེས་པར་འགྱུར་ཏེ་ཇི་ལྟར་འཇིག་རྟེན་མགོན་གྱི་དེ་བཞིན་ནོ།",
    "གང་དུ་འཇིག་རྟེན་ལྷ་མིན་ཡན་ལག་སྟོབས་དང་ལྡན་པར་གནས་ཤིང་བརྩེ་བ་མེད་པ་ཀླ་ཀློའི་གཟུགས།",
    "ཡང་དག་རྒྱུ་བའི་གཟུགས་འདི་རྣམས་ཀྱིས་ས་ལ་འཇུག་པར་འགྱུར་རོ་རྒྱལ་བ་ཡི་ནི་ཡེ་ཤེས་སྐུ།",
