    "ཁོ་བོ་ནི་ནམ་དུ་ཡང་རང་བཟོའི་སྤྱི་བརྟོལ་མི་བྱེད་དེ་མཁས་རློམ་གྱིས་མ་དྲེགས་པའི་ཕྱིར་རོ་གསུངས་པ་དང་།",
    "ཕྱི་ཞེས་པ་དེའི་ནང་པར་བལྟས་པས་ཁྲག་རོ་ལུག་ཤིག་ཙམ་ཅོལ་ལེ་འདུག་ན་ལྷ་སྐྱོན་ཐུན་བུར་བཏུ་སྟེ་དེ་དུས་ལྷ་བས་མི་འབྱེར་བའི་མནའ་བསྐྱལ་བ་ཡིན་པས་ཕྱིར་མི་ལྡོག་གོ།",
    "བ་ཐག་མི་འདུག་ན་ཆ་སེར་དཀྱུས་མ་ཡིན་པས་དེ་རྣམས་ལ་མཚོན་ལམ་རིང་ཐུང་ནི་རྨ་ཁུང་དུ་རྒྱུས་པའི་རྩེ་བལྡད་པ་དལ་བུས་བཏང་ལ་བརྟགས་ཏ་ཏེ།",
    "རྒྱུས་པས་སྐམ་པོའི་རྩེ་བལྡད་པ་ནང་དུ་བཅུག་ལ་རྣག་ཆུ་ཨེ་འདུག་བཙལ་ཏེ།",
    "གཞན་ཡང་རང་རང་གསང་ལ་མེ་དང་ཁྲག་ཤས་ཆེ་ན་གཏར་ག་ཕྱེ་མ་སོགས་གང་དགོས་རིགས་པས་སྤྱི་དང་སྦྱོར་རོ།",
    "ཤ་ཆང་བརྡེག་པ་ནི་ཆེར་བསྟེན་ཞིང་ཟན་དྲོན་ཏེ་ཨ་ས་བ་ཡིས་འདུག་སྦོས་ན་ཚ་སྦོས་ལ་རྨ་དང་ཀླད་རྒྱ་ཆུ་རྩ་རྣམས་ཚ་མགོ་ལྕི་ཀླད་རྒྱ་དམར་དེ་ལ་ག་བུར།",
    "དོན་ལྔ་གང་ལ་ཟིན་ཀྱང་ཕོག་དུས་ཤེས་པ་ཟི་ཞིང་འཚུབ་པ་དང་།",
    "ཅོག་ཙོག་གེ་འདུག་པར་མི་ཚུགས་པ་དེ་ནི་ཞག་དགུའི་དུས་ན་འཆིའོ།",
    "སྨྲ་བར་འདོད་ཅིང་སྙན་མིང་ནས་འབོད་པའི་ཞེ་ས་མཁས་ལ་འགྲོ་འདུག་བྱེད་པ་དང་།",
    "སྦྲིད་པ་མང་ལ་འཆག་པ་སྟེ་ཕར་ཙམ་ཚུར་ཙམ་བྱེད་འདེད་འདོད་ཅིང་མཆན་འོག་གཟེར་ལ་ལོགས་གཉིས་ཀྱིས་ཉལ་བ་མི་ཤེས་ཤིང་ཙོག་པུ་སྟེ་ཙོག་གེར་བདེ་བ་དང་།",
    "ཕྱེ་མས་བསད་པ་ཁྲག་དུས་ཀྱིས་སྐེམ་དང་འདྲ་སྟེ་འོག་ཏུ་བསྟན་པ་ལྟར་རྟོགས་དགོས་ཤིང་།",
    "ཚེས་ཡར་ངོའི་གསུམ་ལྔ་སོགས་ཆ་མ་ཡིན་པ་བཟང་བའི་སྔ་སྐད་དུས་སུ་ཁད་མཉམ་པའི་སྟན་ལ་ལུས་དྲང་པོར་བསྲང་སྐྱིལ་ཀྲུང་དུ་འདུག་པ་དང་།",
    "ཐ་མ་ཞ་ཉེའི་འཕྲུལ་ཐེམ་ནི་དམར་ཁྲིད་དུ་རྣག་ཤ་ཐོན་རྣག་ཆུ་ལྟར་འོང་ཙ་ན་ཞ་ཉེའི་སྦུབས་ཐུར་ཁ་ཁྱེར་ཅན་ནང་བརྡཪ་ཤ་བཅད་པ།",
    "སྤྱང་ཚེར་སོགས་སྦྱར་བ་དུས་གསུམ་རྟས་བསྒྱུར་ཞེས་པ་ཁྲག་དུས་སུ་ཆུ།",
    "རྐང་ནང་བརྡོལ་ནས་རྐང་མར་དུ་སླེབ་ན་ཟུག་རྔུ་སྟེ་མདེའུ་བྱ་འདས་པས་ཕྱི་རུས་ཀྱིས་བསྡམས་ནས་གདོན་པ་དཀའ་སྟེ་དེ་ཡང་སྤྱིར་མདའ་ནི་བར་སྣང་ལ་འཁོར་ཞིང་འགྲོ་བས་འདན་འདོན་དུས་ཀྱང་ལུས་ལ་ཕོག་དུས་ཀྱི་འདུག་ལུགས་གང་ཡོད་ལྟར་ལ་གདོན་པ་དང་།",
    "གཞུག་དུས་དང་།",
    "ཤ་སྟེང་རང་སར་སྡོམ་པའི་ཁྲ་དང་།",
    "གཞུག་དུས་ནི་རྨའི་སྐྲངས་དང་ཚ་བ་ཆོགས་པ་དང་།",
    "བར་དུ་རྣག་དུས་དབུག་ཐ་མ་ཤ་གསོ་རྨེན་པ་རྟས་པར་བྱེད་པ་སྟེ་དུས་གསུམ་དཔེ་དང་སྦྱར་བའི་བཅོས་ཚུལ་ཡིན་ཏེ།",
    "བཙལ་བའི་ཐབས་ལ་རྨ་གསར་དང་པོ་མདེལ་མདེའུ་ཕོག་དུས་ཀྱི་སྡོད་ལུགས་གང་ཡོད་ལྟར་བསྡད་ལ་རྨའི་བཟོ་དབྱིབས་དང་ཆ་བྱད་བསྟུན་ཏེ་བཙལ་བ་དང་།",
    "ཁྲུས་ཀྱིས་བཅད་པ་ནི་དང་པོ་རྣག་དུས་བུལ་ཏོག་ཆུས་བཀྲུས་ལ་རུལ་འདོན།",
    "ཚིགས་ཤོར་གང་ཡང་གཞུག་དུས་ཚིགས་ཁ་བྲལ་པར་བྱ་དགོས་ཏེ་ལུས་མི་གཞན་གྱིས་བཟུང་ནས་གང་ཤོར་བའི་ཡན་ལག་ཐག་པས་དྲག་ཏུ་འཐེན་ལ་ཤོར་བའི་ངོས་སུ་ཕྱིར་རུས་པའི་མགོ་འབུར་བ་དེ་ནས་མཐེ་བོང་ངམ་དྲུ་བུའི་ནང་དུ་འཕུལ་བ་དང་།",
    "འོག་ཏུ་ཤོར་ན་ཡང་གོང་ལྟར་འཐེན་ལ་ཐད་ཀར་ཐེ་གུ་ལྷུག་ལྷུག་མིན་པའི་ཐང་ཐང་བྱུང་བ་དང་བསྟུན་དེ་ལ་འབེམ་དྲུ་བུ་ཁུ་ཚུར་ཙམ་ཞིག་བཅུག་ལ།",
    "སྐྲངས་སམ་ཚའམ་དྲེག་པ་ཆགས་པའམ་ཐོར་པ་ལ་སོགས་པ་གར་འདུག་པ་དེའི་སྟེང་དུ་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ལུམས་བྱ་ཞིང་།",
    "རྩ་རྒྱུད་མ་ངེས་པའི་ཇི་ལྟར་དུ་འདུག་གྱུར་ཀྱང་འགྱུར་ལྡོག་མང་ལ་ཁྱད་པར་གདོན་རྩ་འདྲ་ན་དུག་ཡིན་ཞིང་།",
    "ཡང་ན་ཆུ་དེ་སྔ་མ་ལས་ཁ་དོག་དངས་སངས་པ་འདུག་ན་དུག་ཏུ་ངེས་པ་ཡིན་ཞིང་།",
    "མེ་དང་ཉི་མ་དང་བསིལ་གྲིབ་འདོད་ནས་སྙེག་ཅིང་དེ་རྣམས་སུ་ཡུན་རིང་དུ་འདུག་མི་ཚུགས་པ་དང་།",
    "རང་རང་ལ་ཁ་བསྒྱུར་ཏེ་བཏང་ངོ།",
    "རྨ་བྱའི་ཤ་མ་རྙེད་ན་བྱ་མཚའ་ལུའི་ཤ་རྣམས་སྦྱར་བ་དེའི་སྟེང་ཁྱད་པར་དུ་རང་རང་ལ་ཁ་བསྒྱུར་སྦལ་རྒྱབ་ལ་སྦྱར་བ་དང་།",
    "ཅེས་འདུག་པས་ཉ་ཁྲག་རང་འགལ་བ་ཆུང་བར་སེམས་པ་དང་།",
    "གང་ཞེ་ན་ཚད་ལྡན་གྱི་སློབ་དཔོན་བསྟེན་དགོས་ཤིང་དེ་ཉིད་ཀྱི་ཞལ་ལས་ཤེས་དགོས་པའི་དོན་གྱིས་གསུངས་པ་ཡིན་ཀྱང་འདིར་རྗེས་འཇུག་རྣམས་རྟོགས་སླ་བའི་ཆེད་དུ་དཀྱུས་སུ་གང་འདུག་ལྟར་བྲི་བར་བྱ་སྟེ།",
    "ཟླུམ་པོར་འདུག་པ་ལུས་འཁྱིལ་ཞིང་།",
    "བེ་རོ་ཙ་ན་ཨོཾ།",
    "འདིར་རོ་ཙ་ནི་ཁམས་ལ་རག་ལས།",
    "བྱ་བྲ་སྤྱང་ཚེར་ལ་ངོས་བཟུང་བ་ཡང་འདུག་རུང་ཕུག་རོན་གྱི་བྲུན།",
    "ཁ་ཅིག་ཀ་པེད་དྲུག་ཐང་ཟུར་དུ་བགྲངས་ནས་སྙ་ལོ་གསུམ་ཐང་ཨིནྡྲ་བཞི་ཐང་གཉིས་ཕན་ཡོན་མཚུངས་པས་གཅིག་ཏུ་འདྲེན་པའི་སྲོལ་འདུག་ཀྱང་དེ་ལྟ་བུ་མི་རིགས་པས་རང་ལུགས་ནི་གོང་བཞིན་ནོ།",
    "འགྲོ་འདུག་ལ་སོགས་ཏེ་མཐའ་གཉིས་དང་ལྡན་པའི་ཟས་སྤྱོད་རྣམས་སྤངས་ཏེ་ལེགས་པར་བརྟག་པ་དེས་ནི།",
    "སྐྱོན་ཅན་མིན་པ་ཤུགས་ཀྱིས་དགེ་པར་བསྟན་པ་དུས་རྩ་སོ་སོའི་མཚན་ཉིད་དང་མཐུན་པའི་རྩ་འདུག་ན་ཁྱིམ་ཕྱྭ་བཟང་བའི་ལུས་བསྟན་པར་བྱའོ།",
    "འདི་རྣམས་ཀྱི་རྩ་དར་ཞེས་པ་ཁམས་རང་རང་མཐུན་པ་རྩའི་མཚན་ཉིད་ཅན།",
    "དེ་ལྟར་དུས་ལ་མ་ལྟོས་པར་ནམ་ཡང་མཆིན་རྩ་དེ་ཚང་བར་འདུག་ན་ཕ་མི་འཆི་ཞིང་མ་ཚང་ན་ངེས་པར་འཆི།",
    "དུས་རྩ་དེའི་མ་རང་རྩ་དེའི་བུ་རྩ་དེ་རང་རང་དུས་རྩའི་མཚན་ཉིད་བྱུང་ན་མི་འཆི་ལ།",
    "དེ་ཡང་གྲངས་མང་ཉུང་ཇི་ལྟར་ཡང་མཁྲང་བ་དང་གྲིམས་པ་འདུག་ན་ཚ་བ།",
    "གྲངས་མང་ཡང་སྟོང་པ་དང་ལྷོད་པ་འདུག་ན་གྲང་བ།",
    "དགྲ་རྩ་མ་ཚང་ན་རང་ལ་སྡང་བས་དགྲ་རབས་ཆད་ཅིང་རང་ལ་བཟང་ཡང་དེར་ངན།",
    "སྡོད་གསུམ་པོ་དེའི་ནང་ནས་འདྲེ་སྡོད་ལྟར་འདུག་ན་འདྲེ་གང་ཡིན་ཕྱོགས་སོགས་བརྟགས་ལ་ཡས་བྱིན་ཞིང་།",
    "རྩ་ཆེ་བ་ཞེས་སྦོམ་ལ་ཡུན་རིང་དུ་འཕར་བའི་མི་གྲུང་བ་དེ་གསལ་པོ་མིན་པ་དང་གདོན་རྩ་གཡས་ལ་འདུག་ན་ཕོ་གདོན་ཡིན་པར་བཟུང་བ་དང་།",
    "དེའི་ཁར་བྱེ་བྲག་ཏུ་མལ་མི་ཐུབ་པ་དེ་ཡང་སྦོམ་ཞིང་འཁྲུག་པ་འདུག་ན་ཕོ་གདོན་དང་།",
    "ཞིབ་པ་ན་རྟགས་གཞན་དང་བསྟུན་ཟླ་ཞག་དུས་ཟ་མའི་གྲངས་ལ་བརྩི་བ་གོང་དུ་བརྗོད་པ་ལྟར་རོ།",
    "དུགས་རྔམས་ཆེ་བ་འདུག་ན་འགྲམས་རིགས་སམ་ཚ་བ་རྒྱས་པ་སོགས་འཁྲུགས་ཀྱི་ཆུ་ཡིན་ཏེ།",
    "བརྟག་དུས་བར་པ་ཆུའི་ཚ་ངད་ཡལ་བའི་དུས་སུ་ཀུ་ཡ་ཞེས་དྲི་ཆུའི་ནང་དུ་བལ་ལྟ་བུའམ།",
    "དེ་བཞིན་དུ་ཁ་དོག་དམར་སེར་ཚ་བའི་ཆུ་ལྟར་འདུག་ནའང་དྲི་མ་ཆུང་ཞིང་ཀུ་ཡ་མེད་པ་དེ་ནི་ལྟར་སྣང་ཙམ་དུ་ཚ་བ་བཞིན་སྣང་ཡང་དྲི་ཆུང་ཀུ་ཡ་མེད་པས་ངོ་བོ་གྲང་བའི་ཆུ་ཡིན་ནོ།",
    "ཆུར་ཀུ་ཡ་མེད་ཀྱང་ལྡོག་དུས་ལྡོག་ན་སྐྱོན་མེད།",
    "རང་རང་ཐ་མའི་དུས་འཆི་སྟེ་ཤར་ནས་ནུབ་ཟུག་དཔྱིད་འཆི།",
    "དེ་བཞིན་རང་རང་ཕྱོགས་གང་ནས་གང་དུ་བྱུང་ནའང་མ་བུ་དགྲ་གྲོགས་ཀྱི་འབྲས་བུ་བརྗོད་པར་བྱའོ།",
    "དེའང་རང་གཞུང་ལས།",
    "བསྡོངས་སྡོང་གྲོགས་བྱེད་པ་མང་པོ་འདུག།",
    "ཕུང་འདྲེ་གདོན་རྣམས་ཞུགས་ཉེན་འདུག།",
    "གང་ཞེ་ན་སྐྱེ་ས་གཙང་ས་བསིལ་དྲོད་རང་རང་ནུས་པ་དང་མཚུངས་པའི་སར་སྐྱེས་པ་དང་།",
    "རྩ་སྡོང་ཡལ་ག་སོགས་རང་རང་ལ་འཆད་པ་ལྟར་གྱི་དུས་སུ་བཏུས་པ་དང་།",
    "འགའ་ཞིག་ཙོང་ཚབ་ལྕ་བ་གཏོང་བའང་འདུག་པ་དང་།",
    "བྱིས་པ་དང་རྒས་པ་དང་སྐྱིད་པར་འདུག་པ།",
    "འདི་ལ་བཅུ་པའི་ཁཎྜ་ཞེས་སྔོན་གྱི་མཁས་པ་རྣམས་བརྡ་ཆད་ཀྱང་མཛད་འདུག་གོ།",
    "གཏམ་མི་སྨྲ་ཞིང་མི་འགུལ་བར་ཙོག་པུར་འདུག་པ་དང་།",
    "མན་ངག་རྒྱུད་ཀྱི་རྒྱ་བཤལ་རྩ་དམར་སྐྱུག་དུས་གུར་གུམ་དང་ཞེས་པ་གང་འོས་ཀྱིས་བཅད་ལ།",
    "སང་ཉིན་གཏར་རྒྱུའི་དོ་ནུབ་ལྟ་བུ་གཏོང་བའི་སྲོལ་འདུག་ཀྱང་དེས་ནི་ཆོག་པ་མ་ཡིན་ཏེ།",
    "ཁ་ཆར་བུ་ཡུག་དུས་མི་བསྲེག་ཚེས་གཅིག་དྲུག་བཅོ་བརྒྱད་ཉེར་གཉིས་ཉེར་བཞི་ཉ་སྟོང་རྣམས་ལ་གཏར་བསྲེག་གཉིས་ཀ་སྤང་།",
    "རྣ་བའི་གཡས་གཡོན་གྱི་སྐྲ་མཚམས་སུ་བཏབ་ན་རྣ་བ་དང་ཀླད་པ་ན་བ་དང་རང་འགྱེལ་འགྲོ་བར་ཕན།",
    "རྐང་པའི་བོལ་གྱི་རྒྱ་ཆིངས་ལ་བཏབ་ན་འདུག་མི་ཚུགས་པ་དང་སྐྲངས་པ་ལ་ཕན།",
    "རུས་པ་ལ་ཐུག་ན་རྟུགས་ཀྱིས་མཐུ་བརྡུགས་ཏེ་མི་འགྲོ་བར་འགྱུར་བས་དེ་ལ་རྩིབ་མའི་གོ་བར་གང་ན་འདུག་བཙལ་ཏེ་དབུལ་དགོས་ཤིང་།",
    "དེ་ལྟར་གོང་དུ་སྨོས་པའི་ཚིག་འདི་རྣམས་དཔེ་ལ་འདུག་པ་ཙམ་ལ་མ་བཞག་པར་དོན་ལ་ལག་ཏུ་ལོན་པར་བྱེད་པ་དང་།",
    "ཁྱུར་མིང་མིད་གནས་འདུག་རིག་པ་རྣམས།",
    "ཤིང་ཁུར་འདིས་བྱུང་སྟེ་གཞན་ནི་ཁོ་བོས་མི་ཤེས་ཟེར་བ་ལ་ཤིང་བརྟག་པའི་རིག་པས་འབྱུང་པོ་ཐམས་ཅད་སྡང་བར་བྱེད་པའི་ནོར་བུ་འདུག་པར་མཐོང་ནས།",
    "དར་རྒྱས་སུ་མཛད་པའི་དུས་ལོ་ཆེན་བེ་རོ་ཙ་ནས་རྒྱ་གར་དུ་བྱོན་ཏེ་པཎ་ཆེན་ཟླ་བ་མངོན་དགའ་དང་བཅས་བསྒྱུར་ཏེ་བོད་དུ་སྤྱན་དྲངས།",
    "དེའི་རྒྱན་རྣམས་ཐང་ཁོབ་ཁང་ཐོག་ཏུ་བཀྲམས་པར་རྫིས་མཐོང་སྟེ་འདི་ལ་གཡུ་ཐོག་འདུག་བྱས་པས་གཡུ་ཐོག་པར་དེ་ནས་གྲགས།",
    "གཡུ་ཐོག་ཡོན་ཏན་མགོན་པོ་འདི་ཉིད་སློབ་དཔོན་ཆེན་པོ་པདྨ་བོད་དུ་ཕེབས་ནས་ཟན་གཡང་བརྩིག་དུས་དགུང་ལོ་ཉེར་ལྔ་བཞེས།",
    "དེ་ཐོག་བེ་རོ་ཙ་ན་ཡིས།",
    "ལ་ལ་ཟ་འོག་བརྩེགས་པའི་ཁྲིར་འདུག་སྟེ།",
    "མར་ལམ་ཕྲན་བུ་འཁྲུགས་པ་འདི་གར་ཞག་བཅུ་སྐོར་རིང་སོས་འདུག་ཅིང་།",
    "མ་གཞི་འབྲུ་བསྣན་གྱི་འགྲེལ་པར་ཆར་རྟོགས་ཤིག་འདུག་རུང་ཞིབ་ཏུ་བརྟགས་ན་རྗེ་ཟུར་མཁར་བ་དྷརྨ་སྭཱ་མི་དེ་རིག་པ་འདིར་སྐུ་དྲིན་ཆེ་བ་ཞིག་ཡིན་འདུག་ཀྱང་རྒྱུད་འགྲེལ་མཛད་པ་སོགས་སྐུ་ཚེས་མ་ཐུབ།",
    "ཟླ་བའི་རྒྱལ་པོ་དེ་ཡང་མི་དག་པ་ཞིག་བྱུང་འདུག་པ་དང་།",
    "གསོ་དཔྱད་སྐོར་ལ་ཁོང་པ་དེང་དུས་གཉུག་མར་གནས་པ་སོགས་ནས་ལེགས་པར་གོ་བའི་ཁོང་པར་དྲི་རྟོགས་ཁྱམས་སྟེངས་སུ་ལྷུན་སྡིངས་པ་རང་དང་བཅས་དཔྱད་པར་འཕྲལ་རང་ལ་གསུང་བ་བབས་ནས་དཀའ་འདུག་བསམ་བྱུང་ཡང་།",
    "དེ་དང་བྲིས་ཆ་ངོ་འཕྲོད་པའི་མཛུབ་བཙུགས་ཀྱི་ལག་ཁྲིད་འདི་བཞིན་མཛད་སྲོལ་མ་བྱུང་འདུག་ཅིང་།",
    "ད་ལམ་གཞི་རྙིང་པ་ཤས་ཆེ་བ་བཅས་ཆིག་སྒྲིལ་བྱས་ན་ཟླ་བ་ཕྱེད་གཉིས་དང་མིན་ཀྱང་གསུམ་བཞིར་ངེས་པར་གྲུབ་འདུག་ཀྱང་།",
    "བྲང་ཏི་དཔལ་ལྡན་འཚོ་བྱེད་པས་འབིགས་བྱེད་སོགས་རི་བཞི་ཡི་དབུས་སུ་གསུངས་པ་ཚིག་དང་མི་འགལ་བ་འདུག་དེ་བས་གཞན་གྱིས་ལྟ་ན་སྡུག་བཙལ་བ་ནི་ལོང་བས་འཁར་བ་བཙུགས་པ་ལྟར་གར་གཏད་ཆ་མེད་དུ་འདུག་གོ།",
    "ཟུར་མཁར་བློ་གྲོས་རྒྱལ་པོས་ཀྱང་རང་གར་བཞག་པ་དེ་ལྟར་ལས་འཕྲོག་མ་ཡིན་པ་མ་སེམས་སོ།",
    "དེ་ནི་བློ་དམན་གསར་བུ་རྣམས་ཀྱིས་ཉམས་ལེན་དཀའ་བ་ཞིག་ལས་མི་འདུག་པ་དང་།",
    "བདེ་བའི་འབྲས་བུ་ཐེག་ཆེན་དང་སྦྱར་བ་སོགས་ནི་འཐད་པར་མི་འདུག་ལ།",
    "འབྲས་བུ་གསུམ་ལ་འགའ་ཞིག་ཕྱི་མ་ནི་འབྲས་བུའི་འབྲས་བུ་ཟེར་བ་དེའང་མངོན་སུམ་གྱི་དཔེ་དང་སྦྱར་བ་ལ་འབྲས་བུ་ལ་འབྲས་བུ་སྨིན་པ་ཞིག་གང་ལའང་མི་འདུག་པ་དང་།",
    "སྐྱིད་ཁུང་ཆུ་བ་བཞི་ཡོད་འདྲ་ཡང་གཉིས་སུ་བརྩིས་འདུག་སྒལ་འདབ་ཆུ་བ་བཞིར་བརྩིས་འདུག་ཀྱང་གཉིས་བཅས་བཅུ་དྲུག་རྒྱུས་པ་དགུ་བརྒྱ་ནི།",
    "གོང་དུ་བྱང་ཁོག་དུས་དཔུང་སོག་བར་གནས་པའི་མཁྲིས་རྩ་དེ་ཡི་མཇུག་དཔུང་པའི་སྐྱོགས་རའི་ཚིགས་མཚམས་ན་དོན་པའི་གསེར་གྱི་ཀ་བ་གཉིས།",
    "འགྲེལ་པ་བྱུང་ཡང་རང་ལུགས་སུ་མི་མཛད་པས་འདིར་མ་སྨོས་ལ།",
    "འདི་ལ་བུ་སྟོན་གྱིས་མཛད་པའི་འགྲེལ་པ་ལེགས་ཆ་བསྡུས་པའི་ཆེན་པོ་ཞིག་ཡོད་ཀྱང་རང་ལུགས་མ་ཡིན་ནོ།",
    "འདས་ཞེས་བྱ་བ་རྒྱ་སྐད་ལ་མེད་ཀྱང་འཇིག་རྟེན་གྱི་ལག་ལྡན་སོགས་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་དུ་བོད་ཀྱི་ལོ་ཙཱ་བས་བསྣན་པར་གདའ།",
    "ཁ་དོག་དང་དབྱིབས་ཀྱི་དངོས་པོ་མེད་པ་རྫོགས་པའི་རིམ་པའི་ཡེ་ཤེས་རང་ཡང་རང་བཞིན་མེད་པར་ཤེས་པས་གྲོལ་བར་འགྱུར།",
    "འོན་ཀྱང་ཡེ་ཤེས་ཀྱི་ཉེ་བའི་རྒྱུ་དཀྱིལ་འཁོར་འཁོར་ལོ་ཡིན་པས་དེ་ལའང་སྦྱར་བ་ཡིན་ཚོད་དུ་གདའ།",
    "ཉེར་གསུམ་པ་འདིའི་དོན་ཀུན་ཚང་བར་གདའ།",
    "ཐམས་ཅད་ཀུན་ཀྱང་རང་བྱུང་བདེ་བའི་ཞིང་།",
    "འདི་ཀུན་ཤར་ཡང་རང་བཞིན་འགག་མེད་དོ།",
    "གང་སྣང་རང་གཞག་བྱ་རྩོལ་བྲལ་ན་མངོན།",
    "དེ་ཡང་རང་བྱུང་ངང་འདིར་ལྷུན་གྲུབ་པས།",
    "གཉིས་སུ་མེད་པ་ངོ་བོའི་འདུག་ཚུལ་ཏེ།",
    "ཟ་འཆག་ཉལ་འདུག་ཉིན་ཞག་ཕྱམ་གདལ་བས།",
    "ད་ལྟ་སེམས་ལས་གང་བྱུང་རང་ཞིར་གློད།",
    "མཉམ་པར་གྲོལ་ཡང་རང་བྱུང་ཡེ་ཤེས་ཀློང་།",
    "རྒྱལ་བའི་དགོངས་ཀློང་རང་བཞིན་ཡངས་པའི་མཆོག།",
    "དྲན་བསམ་ཐམས་ཅད་རང་བྱུང་རང་ཞི་ན།",
    "རང་བཞིན་བར་མ་འགྲོ་འདུག་གྱིན་འདར་གནས།",
    "གཉིད་ཀྱང་རང་བྱུང་གདོད་མའི་ཀློང་ཆེན་ཏེ།",
    "ཁྱེད་ཅག་ཅི་བྱ་ང་ནི་གང་ན་འདུག།",
    "ཨུཉ་སྟེ་ཨུ་ཞེས་པ་འདི་ཨི་ཏི་ཕ་རོལ་ལ་ལྔ་ཞེས་པར་འགྱུར་བ་དང་རང་བཞིན་དུ་གནས་པ་ཡང་ན་བར་བྱ་སྟེ།",
    "ཨ་ཙི་ར་རྀ་ཏ།",
    "མ་ནིང་རང་ལུགས་ལྟར་ན་ནུམ་བྱིན་དྲངས་པའོ།",
    "མ་ནིང་རང་ལུགས་ལྟར་ན།",
    "ཊཱ་མན་ཆད་ལ་ཨཙ་དང་པོ་ཅན་རྣམས་ལ་མ་ནིང་རང་ལུགས་ཀྱི་ཆོ་ག་ལྟར་ན་ནུམ་བྱིན།",
    "ཊཱ་སོགས་ལ་མ་ནིང་རང་ལུགས་ལྟར་ན་ནུམ་སྟེརསྐེ།",
    "བ་ཧུ་བ་ཙ་ན་སུ་བསྣ་སོ།",
    "ཏེ་མ་ཡཱ་བེ་ཀ་བ་ཙ་ན་སུ།",
    "ཨུ་རྔ་ཏཱངྒ་ཎ་བ་ཙ་ནཱཏ།",
    "ཨི་ཏི་པཱ་ཎི་ནི་བྱཱ་ཀ་ར་ཎ་སུ་སྲུ་ཏཱཏ་སྟེ་ཡོ་བ་ཙ་ན་པྲ་ཏྱ་ཡཱམ་མཱབྷཱ།",
    "ཀྲྀ་ཛྲ་རྣམས་ཀྟའི་རྐྱེན་ཅན་དང་སྤྱོར་བ་ལ་ལྔ་པའི་མཐའ་མི་དབྱི་ཞིང་རང་སར་གནས་ཀྱང་དེ་དག་ལ་མི་དབྱེ་བའི་ཚིག་སྡུད་ཅེས་ཟེར་རོ།",
    "ཨུ་པ་མཱ་ནཱ་ནི་སཱ་མཱ་ནྱ་བ་ཙ་ནེ།",
    "ཨཙ་ནཱ་སི་ཀཱ་ཡཱ་སཾ་ཛྙཱ་ཡཱི་ན་སཾ་བཱརྫུ་འདོ་ཏེདྔྷ།",
    "བྱི་ཏིརྫ་ན་པ་ད་རཱ་ཏྲི་ནཱ་བྷི་ནཱ་མ་གོ་ཏྲ་རཱུ་པསྠཱ་ན་བརྞ་བ་ཡོ་བ་ཙ་ན།",
    "བནྟུ་༦་བྱེ་ཏི་ཥ་ཛ་ན་པ་ད་རཱ་ཏྲི་ནཱ་བྱེ་ནཱ་མ་གོ་ཏྲ་རཱུ་པ་སྭཱན་བརྞ་བ་ཡས་བ་ཙ་ན་བནྟུ་རྣམས་ལའོ།",
    "མཱུསྒོ་མསྟ་ཀ་ཀཱ་མ་ལ་མ་ཡིན་ཞིང་རང་ལུས་ལས་སོ།",
    "དེའང་ཨེཙ་ནི་སོ་སོར་བསྡུ་བ་ཡིན་པས་ཡ་ཡིག་ཡོད་ན་ཨེ་དང་བ་ཡོད་ན་ཨོ་སྟེར་ཏེ།",
    "ཎ་ཛཱ་ཏི་བ་ཡོ་བ་ཙ་ནོངྒཱ་ཏཱ་དི་བྷྱོཉུ།",
