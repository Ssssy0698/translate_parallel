    "མཐར་སེང་གེ་དང་འཕྲད་དེས་དྲིས་པར་ལན་བཏབ་པས་ཕར་ཙམ་བྲོས་ཏེ་རི་བོང་དེ་ལ།",
    "དེ་ལ་ལུང་རིགས་ཀྱི་རྒྱབ་བརྟེན་ཁུངས་འཕེར་བ་ཞིག་ཕར་བཞག་ཚིག་སྦྱོར་གྱི་དབྱེ་བ་ཙམ་ལའང་བསམ་ཞིབ་ཅུང་ཆ་ཚང་བ་བྱེད་ཐུབ་མི་འདུག་པ་བཅས་ལ་བརྟེན་མ་འགྲིག་ས་དང་མ་མཐུན་ས་ཇི་སྙེད་ཅིག་ཆགས་པ་ནི་གོར་མ་ཆག་སྟེ།",
    "མིང་དང་གཟུགས་མདུང་ཁྱིམ་ལྟར་གཅིག་ལ་གཅིག་བརྟེན་པའི་ཚུལ་གྱིས་འདུག་པ་གང་ཡིན་པ་དེ་ཡང་།",
    "གལ་ཏེ་གང་ཐམས་ཅད་ན་ཐམས་ཅད་ལ་འདུག་པའི་ལོག་པ་དེ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་བའོ།",
    "འཁོར་ན་གདའ་ལ་རྣམ་ཀུན་ཏུ།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་དང་།",
    "གཞན་དག་ནི་ཞིག་ནས་འདུག་གོ།",
    "གཞན་དག་ནི་ཆགས་ནས་འདུག་གོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་རྟེན་ཞིག་པར་འདུག་གོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་རྟེན་ཆགས་ནས་འདུག་གོ།",
    "༢༡ ༣ཐ་མལ་པར་འདུག་པ་ལ་བརྟེན་ནས་ནུབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "པེ་སྣར་འདུག་པེ་སྣར་ནི་དེ་ལྟར།",
    "དེ་ནས་རྣམ་པར་ཤེས་པ་ཙམ་ཉིད་ལ་འདུག་པ་ན་རྗེས་སུ་མཐུན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་འཇིག་རྟེན་པ་ཀུན་རྫོབ་ཏུ་རྟོགས་པ་དང་།",
    "དེ་ཡང་ལྷན་ཅིག་འདུག་པའི་ཚུལ་གྱིས་ཆུ་དང་འོ་མ་བཞིན་དུ་ངོ་བོ་གཅིག་པར་འཇུག་པར་འགྱུར་ན་ཡང་དེ་དེའི་ངོ་བོ་མ་ཡིན་པ་ཉིད་དེ།",
    "དེ་ཁོ་ན་ཉིད་མ་ིམཐོང་བ་དང་མཐོང་བ་དག་དུས་མཉམ་པ་ཉིད་དུ་ཞེས་བྱ་བ་ལ།་",
    "བོར་ནས་དེ་ཚེ་འདུག་པ་ནི།",
    "ཤེས་བྱའི་ཕ་རོལ་དུ་གནས་པ་ཞེས་བྱ་བ་ནི་འདུག་ཅེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "ཐམས་ཅད་ན་ཐམས་ཅད་ལ་འདུག་པའི་ལོག་པ་ཞེས་བྱ་བ་ནི་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་དུ་རྟོག་པའོ།",
    "ཁོ་རང་དང་སྤྱིའི་མཚན་ཉིད་དང་།",
    "ཡུལ་གྱི་སྐད་ཐ་དད་པ་རང་རང་དང་ཕན་ཚུན་མིང་གཞན་གྱིས་ཐ་སྙད་འདོགས་པ་དང་།",
    "འཁོར་མ་གདའ་ལ་རྣམ་ཀུན་དུ།",
    "༤པེ་སྣར་འདུག་ཚེ་སྣར་པ་ཐོབ།",
    "ས་བོན་གྱི་བདག་ཉིད་ཀྱང་རང་ིབཞིན་དུ་གནས་པ་དང་ཡང་དག་པར་བསྒྲུབས་པ་དང་རྣམ་པ་གཉིས་ཏེ།",
    "དོན་དམ་པ་དང་རང་རིག་པའི་སྒོ་ནས་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་ཀྱིས་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་དག་དང་ཐ་མི་དད་པར་འདུག་པ་ཡུལ་གཟུགས་ལ་སོགས་པ་དང་བཅས་པ་ལ་དགོངས་པ་ཡིན་ནོ།",
    "སྡོང་བུ་ལ་སོགས་པ་བརྒྱུད་པ་སྦྱང་ིན་འདུག་པའི་བར་གྱི་ནི་འཕེན་པར་བྱེད་པ་ཡིན་ནོ།",
    "ནས་ལ་སོགས་པའི་ས་བོན་སྦྱང་ིལ་སོགས་པ་ན་འདུག་པ་མ་བཏབ་པ་རྣམས་ཀྱི་རྒྱུན་དུས་རིང་པོར་འབྲེལ་པར་མི་འགྱུར་རོ།",
    "ལས་ཀྱི་འཕེན་པ་ཡོད་ཀྱང་རྣམ་པར་ཤེས་པ་དང་བྲལ་བའི་ཕྱིར་མ་ཟིན་པ་སོ་ན་འདུག་སྟེ་བུམ་པ་ལ་སོགས་པ་བཞིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ལྷན་ཅིག་འདུག་པའི་ཚུལ་གྱིས་འཇུག།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་ལ་སོགས་པ་ལ་ནི་ལུས་ཡོད་པའི་ཕྱིར་རོ།",
    "ལོངས་སྤྱོད་འབྱོར་པ་རྒུད་པའི་མཚན་ཉིད་ནི་འཇིག་རྟེན་པའི་འབྱོར་པ་ཐམས་ཅད་གཏན་དུ་འདུག་པ་མ་ཡིན་པས་མཐར་ཉེས་པ་ཉིད་དོ།",
    "འདུག་ཀྱང་ཇི་ལྟར་འདོད་པ་དང་།",
    "བཅས་པའི་ཁ་ན་མ་ཐོ་བ་རྣམས་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་རྣམས་ལ་ཡང་བསམ་པ་དྲག་པོས་བསླབ་པས་ཁ་ན་མ་ཐོ་བ་ཆུང་ངུ་ཙམ་རྣམས་ལ་ཡང་འཇིགས་པར་ལྟ་བ་ཡིན་ནོ།",
    "དེ་ལ་དང་པོ་ནི་ཞི་གནས་ཐོབ་པའི་ཕྱིར་འདུག་བཞིན་དུ་སེམས་འཇོག་པ་ནས་མཉམ་པར་འཇོག་པའི་བར་དང་།",
    "ལྷག་མཐོང་མ་ཐོབ་པའི་ཕྱིར་ཏིང་ངེ་འཛིན་དེ་ལ་བརྟེན་ནས་ཕྱིས་དེ་བཞིན་དུ་འདུག་སྟེ།",
    "༡༦༣ པེ་སྣར་འདུག་པེ་སྣར་མཚུངས་པར།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་ལ་སོགས་པ་ནི་ལུས་ཡོད་པའི་ཕྱིར་རོ།",
    "ཡུལ་སྤྱོད་ཡུལ་དུ་གྱུར་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཕྱོགས་འགའ་ཞིག་ན་འདུག་པར་དམིགས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ལུང་དུ་མ་བསྟན་པ་རྣམས་ཀྱང་རང་གཞན་གྱི་རྣམ་པ་རྣམས་དང་སྦྱར་བར་བྱའོ།",
    "གཞན་དག་ནི་ཞིག་ནས་འདུག་གོ།",
    "གཞན་དག་ནི་ཆགས་ནས་འདུག་གོ།",
    "མ་ཞུ་བ་གཉིས་ཀྱི་བར་ན་འདུག་པ་ལས་བྱུང་བ་དང་།",
    "འཇིག་རྟེན་པའི་འབྱོར་པ་ཐམས་ཅད་གཏན་དུ་འདུག་པ་མ་ཡིན་པས་མཐར་ཉེས་པ་ཉིད་དོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་རྟེན་ཆགས་ནས་འདུག་གོ།",
    "འདུག་ཀྱང་ཇི་ལྟར་འདོད་པ་དང་།",
    "གྲོང་ན་འདུག་ཀྱང་རུང་།",
    "ཐ་མལ་པར་འདུག་པ་ལ་བརྟེན་ནས་ནུབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཐ་མ་གདོན་མི་ཟ་བར་ཐ་མལ་པར་འདུག་པའི་སྒོ་ནས་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་དང་པོ་ནི་ཞི་གནས་ཐོབ་པའི་ཕྱིར་འདུག་བཞིན་དུ་སེམས་འཇོག་པའི་བར་དང་།",
    "༡༥ ༤༧ནས་ཕྱིས་དེ་བཞིན་དུ་འདུག་ཏེ།",
    "མི་ཆེན་རྣམས་ཕྱིང་གུར་ཆེན་པོར་འདུག་ལ།",
    "མདུང་རང་འདེབས་དང་།",
    "ལྷའི་དཀོར་ཏེ་ནོར་མདུང་རང་འདེབས་དང་།",
    "མྱི་འི་སྨུག་བྱ་རྨུག་ལྟར་འདུག་པ་འོག་ནས་འགེབས་པ་གཆིག་འདོད་ཅེས་ཟེར་ནས།",
    "བུ་ཁུ་ལྗོ་ན་འདུག་པ་ཞིགརྨུག་བྱ་རྨུག་དང་མཚུངས་འོག་ནས་འགེབས་པ་གཆིག་འདུག་ནས།",
    "མིའི་མིག་འདབ་ཆགས་བྱ་མིག་ལྟར་འདུག་པ་མིག་སྤགས་འོག་ནས་ཡར་འགེབས་པ་ཞིག་འདོད་ཅེས་ཟེར་ནས།",
    "དུས་ནམ་ཞིག་ན་བཙན་པོ་རྗེ་དབྱལ་ཏེ་སྟེང་ཞལ་ནོངས་ཏེ་གཤེགས་ནས་འདུག་པ་ལ།",
    "ཞེས་གསལ་བ་ལྟར་ཡབ་ཀྱི་མཚན་ལ་ཟླ་གོང་ཞེས་གསལ་པོར་བཀོད་འདུག་འ་ཞཕལཕོ་ཆེ",
    "༡༩༨༤ཀྱིས་རྡོ་རིང་བརྐོས་ཡིག་པར་སྐྲུན་གནང་འདུག་པ་དེ་ལའང་མཁས་པར་མཁོ་བའི་ལེགས་ཆ་མི་ཉུང་བ་ཞིག་ལོས་ཡོད།",
    "ཤ་ཁོན་གྱི་བག་དུསྲོགསྲིདལས་༧",
    "སྦ་གསལ་སྣང་སོགས་རྒྱ་ཡུལ་དུ་བཏང་གསལ་བ་སོགས་ནི་ཡིག་ནོར་མངོན་གསལ་ཅན་ཞིག་བྱུང་འདུག།",
    "ཡིག་ཚང་མང་ཞིག་ན་མེ་ཡོས་ལ་རྨང་བཏིང་ནས་ས་ཡོས་ཀྱིས་ཚར་ཞེས་པ་འདུག་ཀྱང་མེ་ཡོས་ནས་ལོ་བཞི་ལོན་པ་ལྕགས་རྟ་ལ་ཁྲི་སྲོང་འཁྲུངས་པའི་ཕྱིར་དགུང་ལོ་ཉེར་གཉིས་བཞེས་པ་ལྕགས་ཡོས་ལ་རྨང་བཏིང་ཉེ་དྲུག་པ་ཤིང་ལུག་ལ་སད་མི་རྣམས་རབ་ཏུ་བྱུང་།",
    "རྒྱ་ནག་པོའི་ལོ་ཙ་ནི་བྲེན་ཀ་ལེགས་ཀོ་དང་།",
    "བེ་རོ་ཙ་ན་དང་།",
    "བེ་རོ་ཙ་ན་དང་གཙང་བཙུན་ལེགས་གྲུབ་འཚོལ་དུ་བཏང་།",
    "བི་རོ་ཙ་ན་ཚ་བ་རོང་དུ་སྤྲུགས་པའི་བཀའ་ཆད་ཀྱིས་དེ་ནས་ཟླ་བ་གསུམ་ལོན་པ།",
    "དེ་བཞིན་མི་དམངས་རྣམས་ཀྱིས་ཀྱང་རང་ནུས་གཞོགས་འདེགས་ཧུར་ཐག་ཞུས་པའི་གྲུབ་འབྲས་སུ།",
    "ཞེས་ཁྲི་སྲོང་ཟླ་བ་བཅུ་པར་གཤེགས་ཟེར་བ་དེ་བཞིན་ཟླ་བ་བཅུ་པར་ནང་རྒྱལ་ཁྲི་ལས་ཟུར་ཟེར་རྒྱུ་དེ་བཞིན་དེ་སྔོན་ནས་གཤེགས་པ་ལྟར་ནོར་ནས་བཀོད་འདུགཞར་བྱུང་བྱང་ལ་སྤྲུགས་པའི་རྒྱལ་སྲས་ཀྱི་མཚན་ལ་དོགས་པ་དཔྱོད་དགོས་པ་འདི་ཡོད།",
    "༡༩༨༤ཀྱིས་རྡོ་རིང་བརྐོས་ཡིག་པར་སྐྲུན་གནང་འདུག་པ་དེ་ལའང་མཁས་པར་མཁོ་བའི་ལེགས་ཆ་མི་ཉུང་བ་ཞིག་ལོས་ཡོད།",
    "ཡང་རྡོ་རིང་རང་དུ་བཀའ་ལ་རྗེས་འཇུག་འ་ཆད་པ་ལྟ་བུ་ཡི་གེ་མ་དག་པ་ཡང་འདུག་པས་ཐུགས་འཇགས་གནང་དགོས།",
    "སྐར་ཆུང་བཀའ་གཙིགས་འདི་བཞིན་ག་དུས་བཞག་མིན་གསལ་པོར་འཁོད་མིན་འདུག་ཀྱང་།",
