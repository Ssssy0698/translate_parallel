    "༤༧ང་རང་ལ་ཏཱ་ལའི་ལོག་སྤྱོད་པ་ཟེར་ནའང་འདྲ།",
    "ང་རང་སྒེར་གྱི་ངོས་ནས་ཆ་བཞག་པ་ཡིན་ན།",
    "བསམ་བློ་ཕྱོགས་གཞན་ཞིག་ནས་གཏོང་སྐབས་དུས་ཚོད་ཁག་པོ་འདི་འདྲའི་སྐབས་སུ་ཞབས་འདེགས་སྣ་ཁ་གཅིག་ལས་ཞུ་མ་ཐུབ་ཀྱང་བོད་བསྟན་པ་དང་འགྲོ་བའི་དོན་ཡིན་པ་དེ་ནི་སྡོད་ས་དང་ཉེ་རྒྱང་ལ་མ་ལྟོས་པར་བྱེད་ཐུབ་ཡོད་དུས་འགལ་བ་གང་ཡང་མི་འདུག་ཡང་དངོས་གནས་བོད་མི་རིགས་ཀྱི་དད་པ་དང་དམ་ཚིག་ལ་རྒྱ་ཞེན་ཁོག་ཤིན་ཏུ་བརྟན་པོ་ཡིན་འདུག་ང་རང་ཤིན་ཏུ་དགའ་བོ་བྱུང་།",
    "བར་སྐབས་ཚིགས་བཅད་ཅིག་འདུག་པ་ཡང་མིག་སྟོན་གནང་ནས།",
    "འདི་ཕྱིའི་ལེགས་ཚོགས་མ་ལུས་པ་འབད་མེད་དུ་སྩོལ་བའི་མཆོད་ཡུལ་རྣམ་དག་མི་འདུག་གཤིས།",
    "ད་ལམ་དམག་དུས་གསུམ་གྱི་དམག་ཕོགས་བཞི་ཟུར་འབབ་འབྲུ་ཁལ་ཁྲི་ཉི་ཤུ་རྩ་བདུན་ཐོབ་པ་གྲངས་ཚང་ཆད་མེད་གཙང་སྒྲུབ་དགོས་རྒྱུའི་འདོད་གཙེར་བྱས་འདུག་པ་དང་།",
    "མདའ་དཔོན་མཚོ་སྒོ་བ་གཉིས་དམག་མི་དང་བཅས་བཀག་འགོག་བྱེད་པར་མངགས་འདུག་པ་དང་།",
    "ཁོ་ཚོ་ཚང་མས་གང་འཚམ་བར་བསྐྱོད་རྗེས་ཕེབས་མཇུག་ཟིན་ཐབས་བྲལ་ནས་ཕྱིར་ལོག་མི་བྱེད་ཀ་མེད་བྱུང་འདུག་པ་དང་།",
    "ནམ་ཞིག་དུས་འགྱུར་བགེགས་འཚུབ་ཆེ་བ་འབྱུང་ངེས་ཡིན་པས།",
    "ཅེས་ཕེབས་འདུག་པ་སྔ་རྗེས་ཞལ་གདམས་བཀའ་སློབ་དང་།",
    "སྐུ་མདུན་གྱི་སྐུ་ཕྱྭ་ལ་ཐུག་ནའང་ད་དུང་མངོན་ལྐོག་མདུན་རྒྱབ་ཀྱི་ལས་ཀ་རྒྱུན་མཐུད་བྱས་འདུག་པ་ནི་ཧ་ཅང་བློ་ཕམ་ཞིང་།",
    "བུ་ཕྲུག་ཚོས་སྐད་ཅོར་དང་རྡོ་འཕེན་བྱེད་པ་སོགས་བྱས་འདུག་པ་དང་།",
    "དུས་དེ་ཙམ་ནས་བཟུང་བོད་རྒྱ་མི་རིགས་གཉིས་ཕན་ཚུན་འཚེ་མེད་ཞི་བའི་ལམ་ནས་འགྲིག་མཐུན་ཡོང་བའི་ཐུགས་འཆར་རྒྱ་བསྐྱེད་གནང་ངེས་ཤིང་རང་རྣམ་ལས།",
    "དེ་ནས་བཟུང་རང་དོན་གྱི་བསམ་པ་མིན་པར་གཞན་དོན་གྱི་བསམ་བློ་ཆེས་མང་པོ་བཏང་སྟེ།",
    "གྲྭ་བ་རྣམས་ལ་རྐུན་མ་དམར་བོ་སོགས་དངོས་དངོས་རྗེན་རྗེན་གྱི་སྐྱོན་བརྗོད་གྲངས་མེད་བྱས་འདུག་པ་དང་།",
    "འགྲུལ་བསྐྱོད་སྐབས་མི་གསུམ་དང་རྟ་དྲེལ་མང་པོ་ཤི་གོད་བྱུང་འདུག་པ་དང་།",
    "འདི་དུས་བོད་བསྟན་སྲིད་ཀྱི་རྙོག་དྲའི་ལས་ཁུར་ལྕི་བས་ནོན་ཏེ་དགའ་སྐྱིད་ཀྱི་ཐུགས་སྣང་གང་ཡང་ཤར་མི་འདུག་པ་དེ་ལ་དཔགས་ན།",
    "ཁ་དང་བརྒྱ་དཔོན་སྐལ་བཟང་དགྲ་འདུལ་གྱིས་ཆིབས་ཁྲིད་ཕེབས་སྒུག་བྱས་འདུག་པར།",
    "གོང་ས་མཆོག་ནས་མགྲོན་ཆེ་ཕ་ལྷ་བརྒྱུད་མེ་མདའ་གང་བྱུང་ཧོལ་རྒྱུག་ཏུ་མི་རྒྱག་པར་ཁུ་སིམ་པོ་བྱས་ནས་སྡོད་དགོས་ཞེས་བཀའ་སྩལ་འདུག་ཅིང་།",
    "གནམ་གཤིས་དྭངས་ཏེ་མིག་ཤེལ་མེད་པ་ཚོར་གངས་འོད་ཀྱིས་དཀའ་ངལ་སྔར་ལས་ཆེ་བ་བཟོས་འདུག་ལམ་འཕྲང་དཀའ་ངལ་ཅན་ལ་རྟ་ཐོག་ཏུ་ཉིན་གཉིས་བགྲོད་དེ་བོད་མི་གནས་སྡོད་མང་མང་ཟེར་བར་འབྱོར་ཞིང་།",
    "ཐེངས་ཉེར་ལྔར་ཕེབས་འདུག་ཇི་སྐད་དུ།",
    "ཞེས་འགལ་བ་རྫུན་བསྒྲིགས་ཀྱིས་གསང་གྲོས་བྱས་འདུག་པ་དང་།",
    "ང་རང་སྒེར་གྱི་ངོས་ལ་ཆ་བཞག་ན་འཛམ་གླིང་ས་གནས་གང་ས་ནས་སེམས་ཐག་ཉེ་བའི་གྲོགས་པོ་བློས་ཐུབ་མང་པོ་ཞིག་རྙེད་བྱུང་།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བསམ་བློ་གཏོང་དུས་གོ་ཡང་གང་ལ་གང་འཚམས་ཆོད་ཡོད་བསམ་ནས་སྤྲོ་བ་འཕེལ་གྱི་འདུག་ཅེས་གསུངས་སོ།",
    "དགུ་ཆུང་དུས་ནས་གྲོངས་འདུག་ནང་མི་ཚང་མ་མཛའ་བརྩེའི་འབྲེལ་བ་དམ་པོ་ཡོད།",
    "ཅེས་མ་ཡུམ་དམ་པའི་བཀའ་དྲིན་ཡང་ཡང་བགྲངས་འདུག་པ་ལྟར།",
    "དེ་ནས་བཟུང་རང་དོན་གྱི་བསམ་པ་མིན་པར་གཞན་དོན་གྱི་བསམ་བློ་ཆེས་མང་པོ་བཏང་སྟེ།",
    "ཡང་༤ང་རང་ཕྲུ་གུའི་སྐབས་སྐྱིད་པོ་མེད་པ་མ་ཡིན།",
    "ལྟོ་འཕྱེ་ཆེན་པོའི་འཁོར་དང་ལྷན་ཅིག་སྟན་བཏིངས་པ་ལ་འདུག་གོ།",
    "ང་རང་ལ་ཆ་བཞག་ནའང་ཉམས་ལེན་ཅི་ཐུབ་ཐུབ་བྱེད་ཀྱི་ཡོད།",
    "ང་རང་ཁྱེད་ཚོ་དང་གཅིག་པ་ཡིན།",
    "འདིས་ཕན་ཐོགས་ཆེན་པོ་འདུག་ཅེས་དང་།",
    "འཛམ་གླིང་སྤྱིའི་ནང་པ་ཡོངས་ཀྱི་མངའ་བདག་ཡིན་ནའང་རང་ལོ་ཉེར་ལྔ་ནས་བརྒྱད་ཅུ་བར་མི་ལོ་ལྔ་བཅུ་ང་ལྔ་ཙམ་བཙན་བྱོལ་ཡུལ་གྱར་གྱི་འཚོ་བ་བསྐྱལ་ནའང་ཡུལ་གང་དུ་འཁོར་གང་ལ།",
    "ཆེད་མཁས་པ་སོགས་ཕྱོགས་མང་རང་བཞིན་གྱི་ཉམས་མྱོང་ཡོད་པའི་མི་སྣ་མང་པོ་དང་ཐུག་འཕྲད་བྱས་ཤིང་།",
    "སྟོང་ལོ་གསར་བའི་ཀུན་སྤྱོད་པར་བསྐྲུན་བྱས་རྗེས་ནེའུ་ཡོག་དུས་བབ་ཀྱི་ཚོང་རྒྱུགས་ཆེ་བའི་དེབ་གྲལ་དུ་སླེབས་པར་མ་ཟད།",
    "ཅེས་གསུངས་འདུག་ཅིང་།",
    "མྱུར་ལམ་སོགས་ཀྱི་ཁྲིད་ཐེངས་དྲུག་ལ་གསན་འདུག་པ་༥དེས་གཞན་ཡང་དཔོག་ནུས་ཤིང་།",
    "ང་རང་སྒེར་གྱི་བསམ་ཚུལ་ལ།",
    "ལྟ་བ་མ་ཡིན་དགག་དང་མེད་དགག་ཏུ་འདོད་པ་གཉིས་དགོངས་པ་གཅིག་ཏུ་འབབ་ཚུལ་ཇི་ལྟར་ཡིན་བཀའ་འདྲི་ཞུ་དགོས་པར་འདུག་ཅེས་དེ་འདྲ་གསུང་སྲོལ་འདུག་ཅེས་ལུང་དེ་སྒྲ་ཇི་བཞིན་པ་མ་ཡིན་ཟེར་མཁན་གྱི་མཁས་པ་འགའ་ཤས་བྱུང་ཡོད་ཀྱང་།",
    "གཉིས་ཚོགས་གསུངས་འདུག་ཅེས་གསུངས།",
    "དགེ་ཚུལ་གྲངས་འབོར་སུམ་སྟོང་དགུ་བརྒྱ་བརྒྱད་ཅུ་༣༩༨ལྷག་ཙམ་བསྒྲུབས་འདུག་པ་དེ་ཡང་ཡུལ་ལུང་དང་རྒྱལ་ཁབ་དང་།",
    "བཙུན་དགོན་བཅུ་དྲུག་ཡོད་པའི་ནང་བཙུན་མ་༡༤༧༣བརྒལ་འདུག་པ་དང་།",
    "སྟོན་པ་ཤཱཀྱ་ཐུབ་པའི་དུས་ཆེན་སྲུང་བརྩི་བྱེད་པ་ལས་ཀྱང་ཤུགས་ཆེ་ཙམ་ཡོད་འདུག་ལ།",
    "ཁྱེད་རང་རྣམ་པས་འདི་སྐོར་ངོས་འཛིན་གསལ་བོ་གནང་སྟེ།",
    "རྒྱ་དམར་གྱིས་དེ་མེད་བརླག་ཏུ་གཏོང་རྒྱུའི་ཕུགས་དམིགས་ནི་བོད་པ་ཚོས་སྔར་ནས་ཤེས་ཡོད་འདུག་པས།",
    "ང་རང་སྒེར་གྱི་ཉམས་མྱོང་ནས་ཞུས་ན།",
    "སའི་གོ་ལའི་སྲོག་སྐྱོབ་རོགས་ཞེས་འབོད་སྐུལ་ཞུས་དང་ཞུ་བཞིན་འདུག་ཉེ་ས་ནས་གླེང་ན།",
    "རོང་པོའི་ཆུ་ཀླུང་དུའང་སྔོན་རྫས་འགྱུར་མ་རུ་འདྲེས་ཚད་༡༣ཡིན་པ་ཕྱི་ལོ་༡༩༩༢ ལོའི་དཔྱིད་ཀར་ལྡབ་ལྔ་ནས་བདུན་བར་འཕར་འདུག་ཟེར།",
    "འཛམ་གླིང་སྟེང་ཆེས་མཐོའི་འཁྱག་རོམ་དང་མཚོ་ངོས་ལས་སྨི་༧༡ ཙམ་གྱི་གངས་ཁྲོད་ཀྱི་འཁྱག་རོམ་ནང་བརྟག་དཔྱད་བྱས་དུས་དེར་ཡང་བཙོག་སྐྱོན་ཐེབས་འདུག་ཟེར།",
    "དེ་འདྲའི་གནས་ཚུལ་དང་ཤུགས་རྐྱེན་འོག་ནས་ཐབས་ཤེས་གང་འདུག་བལྟས་ཏེ།",
    "སྟོང་ལྡབ་ཀྱིས་མང་བའི་བརྩེ་སེམས་ཡོང་བ་དེ་ལ་ངེས་ཤེས་བརྟན་པོ་བྱུང་འདུགཕྱི་ལོ་༡༩༣༩ ལ་ཡུ་རོབ་ནང་དམག་ཆེན་ལངས་སྐབས་དབྱིན་གཞུང་ལ་དཀའ་ངལ་བྱུང་བ་དེ་རྒྱ་གར་ལ་གོ་སྐབས་ཐོབ་པ་ཞིག་ཡིན་པར་ཆ་འཇོག་བྱེད་མཁན་རྒྱལ་གཅེས་ཀྱི་རྒྱ་གར་བ་མང་པོ་བྱུང་བ་ལ།",
    "བོད་ལྗོངས་བསྟན་འགྲོའི་དོན་དུ་སྐུ་ཉམས་སུ་བཞེས་དགོས་བྱུང་འདུག་པ་འདི་ཙམ་གྱི་བཀའ་དྲིན་ཡང་སྲིད་མཐའི་བར་དུ་འཁོར་དཀའ་བར་སྣང་ཞེས་གསལ་བ་ལྟར།",
    "ཐག་གཅོད་ཀྱང་རང་ངོས་ནས་བྱས་པ་ཡིན།",
    "འཚེ་མེད་ཞི་བའི་ལམ་དུ་འགྲོ་རྒྱུ་ལས་དྲག་ལས་ཀྱི་དགོངས་བཞེད་ཅི་ཡང་བཞེས་མི་འདུག་གོ།",
    "ང་རང་ལ་ཆ་བཞག་ནའང་ཉམས་ལེན་ཅི་ཐུབ་ཐུབ་བྱེད་ཀྱི་ཡོད།",
    "བོད་པའི་ཐོག་ལ་བློ་གཟུ་བོར་གནས་པ་སུས་ཀྱང་རང་ཤུགས་ཀྱིས་ཤ་ཚས་རྒྱབ་སྐྱོར་སླེབས་བཞིན་ཡོད།",
    "གཞན་ཕན་གྱི་བསམ་པས་མ་འདང་བའི་སྐྱོན་ཧ་ཅང་ཆེན་པོ་འདུག་ལ།",
    "ཡག་པོ་འདུག་ཅེས་བརྗོད་ཀྱི་འདུག་དེ་འདྲ་མང་པོ་ཕྱོགས་མཐུན་གྱིས་བརྗོད་དུས།",
    "ལྷ་སར་ཁ་ཆེ་མང་པོ་ཡོད་པ་ཁོ་ཚོ་ནང་པ་མིན་ཀྱང་བོད་པའི་དཀྱིལ་དུ་སྡོད་སྐབས་བོད་པའི་གོམས་གཤིས་དེ་འཇགས་འདུག་དེས་བོད་མི་ཙམ་དུ་མ་ཟད།",
    "ཕྱི་ལོ་༡༩༧༣ ལོར་ང་རང་དབྱིན་ཇིའི་རྒྱལ་ཁབ་ཏུ་ལྟ་སྐོར་ལ་ཐོག་མར་སླེབས་པ་ནས་བཟུང་སྟེ་ང་གཉིས་ངོ་ཤེས་ཡོད།",
    "མི་སུ་ལ་ཐུག་ཀྱང་རང་བཞིན་གྱིས་འཛུམ་ཤིག་ཤིག་བྱེད་པ་དང་དགའ་ཉེ་བློ་དཀར་ལྟར་གྱི་རྣམ་འགྱུར་སྟོན་པའི་གཤིས་ཀ་ཡོད་པ་འདི་སོ་སོའི་ལུང་པའི་གོམས་སྲོལ་དང་།",
    "ང་རང་དེང་རབས་འཕྲུལ་ཆས་འདིར་དགའ་བོ་ཡོད་ཅེས་གསུངས་ཤིང་།",
    "སྤྱིར་བཏང་ང་རང་སྒེར་གྱི་ངོས་ནས་ཚན་རིག་ལ་དོ་སྣང་ཤུགས་ཆེན་པོ་ཡོད།",
    "གོམ་གང་མདུན་སྤོས་ཀྱིས་ཁ་བྲལ་ལ་ངོ་རྒོལ་བྱེད་པའི་འཐབ་རྩོད་ཀྱི་ཡུན་རིང་རང་བཞིན་དང་དཀའ་ཚེགས་རང་བཞིན།",
    "རྙོག་འཛིང་རང་བཞིན་གསལ་བོར་ཤེས་དགོས།",
    "ཐའེ་ཝན་རྒྱ་ནག་དུས་བབ་གསར་ཤོག་ཏུ།",
    "དེ་ཡང་རང་བཙན་མི་རྩོད་པ་དང་།",
    "རང་དང་རང་མཚུངས་རང་བས་བློ་དམན་ལ།",
    "མུ་སྟེགས་གཞན་དང་རང་ཉིད་ཀྱིས།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
