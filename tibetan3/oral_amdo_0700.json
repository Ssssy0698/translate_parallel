    "ནང་གི་འགྲན་ཟླ་དང་བཅས་པ་ཡིན།",
    "ནང་གི་ཕྱིར་རྒོལ་བ་ཡིན།",
    "ནང་གི་དགྲ་བོ་ཡིན་ནོ།",
    "ནང་གི་དྲི་མ་ནི་འདི་ལྟར་སེམས་དྲི་མ་ཅན་དུ་བྱེད་པ་སྟེ།",
    "ཀུན་ནས་ཉོན་མོངས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་གཟུགས་ལས་བྱུང་བའི་ཤུགས་དེ་བཟོད་པ་དེ་ནི་མིག་གི་རྒྱ་མཚོ་དབའ་རླབས་དང་བཅས་པ་ཀློང་དང་བཅས་པ་འཛིན་ཁྲི་དང་བཅས་པ།",
    "གཟུགས་ལས་བྱུང་བའི་ཤུགས་ཞེས་བྱ་བ་ནི་ཡུལ་གཟུགས་ལ་དམིགས་པའི་ཉོན་མོངས་པའི་ཤུགས་སོ།",
    "གང་ཞིག་གཟུགས་ལས་བྱུང་བའི་ཤུགས་དེ་བཟོད་པ་ཞེས་བྱ་བ་ནི་གང་ཞིག་ཡུལ་གཟུགས་ལ་དམིགས་པའི་ཉོན་མོངས་པ་དེ་དག་གིས་སྟིཟིལ་གྱིས་མི་གནོན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མིག་གི་བདག་པོས་བྱས་ནས་ཞེས་བྱ་བ་ནི་མིག་གི་བདག་པོས་རྐྱེན་བྱས་ནས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བསླབ་པ་གཏོང་བ་ནི་ཆུད་ཟ་བ་བཞི་བུདང་བཅས་པ་གཅིག་ཡང་དག་པར་བསྟན་པ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "རྒྱ་ཆེ་བ་ནི་དེ་དག་གི་ཡུལ་ཐག་རིང་བ་དང་།་",
    "གཞན་དག་གིས་རྟོགས་པར་དཀའ་ཆབའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ཟབ་པ་ཡིན་ནོ།",
    "རང་གི་དོན་ལས་བརྩམས་ནས་རིག་པར་བྱ་སྟེ།",
    "ཤེས་རབ་ཟབ་པ་ཉིད་ཀྱིས་ནི་གཞན་དག་རི་མོའི་ཁྱད་པར་སྐྱེད་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པ་སྤངས་པ་དང་།",
    "དགེ་སྦྱོང་རྣམས་ནས་སློང་མོ་པ་རྣམས་ཀྱི་བར་དག་ལ་ཞེས་བྱ་བ་ནི་དགེ་སྦྱོང་རྣམས་དང་།",
    "སློང་མོ་པ་བཀྲེན་པ་རྣམས་དང་།",
    "ལུས་ཀྱི་ཉོན་མོངས་པ་མེད་པ་དེ་དག་ལ་བརྟེན་ནས་ཞེས་བྱ་བ་ནི་འདིར་ལུས་གནས་པ་དང་།",
    "ལུས་ཀྱི་ཉོན་མོངས་པ་མེད་པ་ནི་ཟས་འདོད་པའི་སྡུག་བསྔལ་བཟློག་དྷིཔའི་ཕྱིར་རོ།",
    "རེག་པར་གནས་པ་དེ་དག་ཀྱང་ཚངས་པར་སྤྱོད་པ་རྗེས་སུ་བཟུང་བ་སྔར་བསྟན་པ་གང་ཡིན་པ་སྟེ།",
    "བསམ་པ་གང་གིས་ཡིན་པ་ནི་ལུས་འདི་ཁོ་ན་གནས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "རེག་པ་ལ་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "བརྒྱན་པའི་ཕྱིར་མ་ཡིན་པ་ཞེས་བྱ་བའི་བར་ཚིག་བཞི་དག་གིས་སོ།",
    "ཚངས་པར་སྤྱོད་པ་རྗེས་སུ་གཟུང་བའི་ཕྱིར་ཞེས་བྱ་བའི་བར་ཚིག་བཞི་དག་གིས་སོ།",
    "རེག་པར་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་ཚིག་ལྷག་མ་རྣམས་ཀྱིས་སོ།",
    "ཚིག་བཞི་དག་གིས་ནི་ལོངས་པའི་ཕྱིར་མ་ཡིན་པ་ནས་བརྒྱན་པའི་ཕྱིར་མ་ཡིན་ཞེས་བྱ་བའི་བར་འདི་དག་གིས་སོ།",
    "གསུམ་དག་གིས་ནི་ལུས་འདི་ཁོ་ན་གནས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "བཀྲེས་པ་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་འདི་དག་གིས་སོ།",
    "ཚིག་གཅིག་གིས་ནི་ཚངས་པར་སྤྱོད་པ་རྗེས་སུ་གཟུང་བའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་སོ།",
    "ཚིག་ལྔ་ཀྱེདག་གིས་ནི་དེ་ལྟ་བུས་ཚོར་བ་རྙིང་ནི་གཞིལ་བར་བྱ་ལ་ལྐུཞེས་བྱ་བ་ནས་བདེ་བ་དང་ཞེས་བྱ་བའི་བར་འདི་དག་གིས་སོ།",
    "རེག་པ་ལ་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་གཉིས་ཀྱིས་ཏེ།",
    "གལ་ཏེ་དེ་དག་གིས་ཟིལ་གྱིས་མི་ནོན་ནའོ།",
    "གང་གིས་ན་དེས་ཟོས་པ་དང་།",
    "གཅིག་གིས་གཅིག་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་ནི་ཕན་ཚུན་དུ་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་རོ།",
    "གང་གིས་ན་འཇུ་བར་བྱེད་པས་སོ།",
    "ཐ་ཆད་ནི་ངན་སོང་ཞེས་བྱ་བའི་ཕྱིར་རོ།",
    "གཞན་དག་ན་རེ་ནི་ཚེགས་དང་མཉམ་པ་མེད་པ་ཉིད་ངན་ངོན་མ་ཡིན་པ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "འདི་སྐད་དུ་སྒྲ་དང་རེག་བྱ་ལ་སོགས་པའི་རྐྱེན་གང་ཅི་ཡང་རུང་བ་ཞིག་གིས་བསམ་གཏན་དེ་གཏོང་བར་བྱེད།",
    "སྣོད་དུ་གཞག་པ་ནི་མཚན་མོ་དང་ཉིན་མོ་དེ་དང་དེ་དག་འདས།",
    "གཟུགས་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་རྣམས་སོ།",
    "བདག་གི་སྐྱེ་བའི་ཁྱད་པར་དོན་དུ་གཉེར་བར་བྱེད་པ་ནི་ལྷ་དང་མི་ལ་སོགས་པ་རྣམས་སུའོ།",
    "ལྷ་རྣམས་ལ་བགོ་སྐལ་ཏེ་ལོངས་སྤྱོད་ཞུ་དང་བདག་གི་སྐྱེ་བའི་ཁྱད་པར་དོན་དུ་གཉེར་བར་བྱེད་ཅིང་།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེ་རྣམས་ནི་རྒྱལ་པོ་ལ་སོགས་པ་དང་ཐུན་མོང་ཡིན་པའི་ཕྱིར་དང་།",
    "བྲམ་ཟེའི་བུ་མོའམ།",
    "རྒྱལ་རིགས་ཀྱི་བུ་མོའམ།",
    "ཁྱིམ་བདག་གི་བུ་མོ་ལོ་བཅོ་ལྔ་ལོན་པའམ།",
    "ལོ་བཅུ་དྲུག་ལོན་པ་ཞིག་གང་གི་ཚེ་ལེགས་པར་ཁྲུས་བྱས།",
    "སྐྲ་དང་སེན་མོ་བྱི་དོར་བྱས།",
    "དེ་ལ་བག་མེད་པར་ཡང་མ་བྱེད་ཅིག་ཅེས་བྱ་བ་འདི་གཉིས་ཀྱིས་ལྐེནི་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་རྒྱུ་ལ་སྦྱོར་བར་མཛད་པ་ཡིན་ནོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་རྒྱུ་ནི་ང་རྒྱལ་མེད་པ་སྟེ།",
    "ཉོན་མོངས་པ་རྒྱུའི་གནས་སྐབས་འདི་དག་ཀྱང་བསམ་གཏན་ལ་སྟོམས་པར་ཞུགས་པ་འདི་དག་ཁོ་ན་ལ་འབྱུང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱང་རིང་པོ་ནས་ཤིང་གི་སྡོང་པོ་ཆེན་པོ་ཞིག་འབར་ཞིང་རབ་ཏུ་འབར་ལ་ཛེེཀུན་དུ་རབ་ཏུ་མཆེད་ཅིང་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ཏེ།",
    "དེ་ལྟར་ཀུན་དུ་རྨོངས་པ་ནི་བདག་གི་ཉིད་དུ་ཡང་དག་པར་རྗེས་སུ་ལྟ་བ་ཡིན་ནོ།",
    "བདག་གིར་ལྟ་བས་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་རྣམས་ལ་བདག་ཏུ་ཕྱིན་ཅི་ལོག་ཡིན་པར་ཡོངས་སུ་བསྟན་པར་རིག་པར་བྱའོ།",
    "ཚིག་གིས་བསམ་ཞུཔའི་གཞི་བསྔགས་པར་བྱེད་པ་ནི་ཚིག་གིས་བསམ་པའི་གཞི་གོས་དང་གླེགས་བམ་ལ་སོགས་པ་ཡོན་ཏན་ལས་བསྔགས་པ་བྱེད་པའོ།",
    "གཉིས་པ་ནི་ངག་གིས་ཡིན་ཏེ་ཁ་གསག་གོ།",
    "ལྷག་མ་གཞོགས་སློང་ལ་སོགས་པ་འཚོ་བ་ལོག་པ་རྣམས་ནི་ལུས་དང་ངག་གིས་ཥྤེཡིན་ནོ།",
    "རེ་ཞིག་ལུས་ཀྱིས་ནི་གཞོགས་སློང་ཉིད་དེ།",
    "ངག་གིས་ནི་བསམ་པའི་གཞི་བསྔགས་པར་བྱེད་པའོ།",
    "ངག་གིས་རྣམ་པ་གསུམ་བསྟན་པ་ཡིན་ནོ།",
    "ལུས་ཀྱིས་ནི་གཅིག་པོ་ཇི་སྐད་བསྟན་པ་ཡིན་ལ་ངག་གིས་ནི་གཉིས་ཡིན་ནོ།",
    "ཁ་གསག་ཀྱང་ངག་གི་ལས་ཡིན་པས་སོ།",
    "རིགས་ཀྱི་ནང་ན་རྒན་རབས་ལ་ཨྱོརི་མོ་བྱེད་པ་དང་།",
    "ལྡང་བ་དང་ཐལ་མོ་སྦྱོར་ཧུབ་དང་།",
    "སྙན་པར་སྨྲ་བ་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲས་ནི་རི་མོ་བྱ་བ་ལ་སོགས་པའོ།",
    "གཞི་བུརྣམས་ཀྱི་རེ་རེས་ནི་རྒན་པོ་རྣམས་དང་།",
    "རང་གི་ལས་དང་།",
    "ཚིག་རེ་རེས་ནི་རེ་རེས་སོ།",
    "སྨྲས་པ་ཚིག་དུ་དག་གིས་ཤེ་ན།",
    "གཞི་རྣམས་ཀྱི་རེ་རེས་ཏེ།",
    "རེ་ཞིག་རྒན་པོ་རྣམས་ལ་ནི་རིགས་ཀྱི་ནང་ན་རྒན་རབས་ལ་རི་མོ་བྱེད་པ་ཞེས་བྱ་བའི་ཚིག་གོ།",
    "རྒུད་པ་རྣམས་ལ་ནི་དོན་བྱེད་པ་ཞེས་བྱ་བའི་ཚིག་གཅིག་གིས་སོ།",
    "རང་གི་ལས་ལ་ནི་བྱ་བ་བྱེད་པ་ཞེས་བྱ་བའི་ཚིག་གཅིག་གིས་སོ།",
    "དེ་ལ་འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་ཕ་རོལ་གྱི་ཁ་ན་མ་ཐོ་བ་རྣམས་ལ་འཇིགས་པར་རྨྱེལྟ་བ་ཞེས་བྱ་བའི་ཚིག་འདི་དག་གིས་ནི་ཡང་དག་པར་བསྒྲུབས་ཙཔ་དེ་ཉིད་ཀྱི་རྒྱུ་ཡང་དག་པར་བསྟན་པ་ཡིན་ནོ།",
    "འདི་ལྟར་ཞེ་སྡང་གིས་ནི་སྡུག་བསྔལ་བྱི་ཚོར་བ་ལ་བཅིངས་སོ།",
    "འདི་ལྟར་གཏི་མུག་གིས་ནི་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་ཡང་མ་ཡིན་པ་ལ་དུབཅིངས་སོ།",
    "གང་གི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་དམིགས་པ་དང་།",
    "ཐོབ་པ་བག་ལ་ཉལ་གྱི་མཚན་ཉིད་སྤངས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་ས་བོན་དེ་ཉིད་མ་བཏོན་ཅིང་ཉམས་པར་མ་བྱས་པ་ནི་ཐོབ་པ་ཡིན་ཏེསྤུ།",
    "ཉོན་མོངས་པ་རྣམ་པ་དགུ་པོ་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པའི་རྣམ་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "མ་ལུས་པར་སྤངས་པ་ནི་སོ་སོ་རང་གིས་ཞུརིག་པར་བྱ་བ་ཉིད་དུ་བསྟན་པ་ཉིད་ཡིན་ཏེ།",
    "གང་དག་ཉོན་མོངས་པ་སྤངས་པ་ལ་གཞན་ལ་རག་ལས་པ་དང་།",
    "སྲིད་པའི་རྩེ་མོའི་བར་དུ་འགྲོ་བའི་ཕྱིར་དང་།",
    "ཉོན་མོངས་པ་རྣམས་དང་བུ།",
    "ལས་ལ་ཉོན་མོངས་པ་རྣམས་གྲོགས་སུ་འགྱུར་བས་།",
    "དགྲ་བཅོམ་པ་ཉིད་ལ་ཉོན་མོངས་པ་ཟད་པ་ནི་མི་སྐྱེ་བའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པ་མ་ཟད་ན་ལས་ཇི་ལྟ་བ་བཞིན་དུ་སྐྱེ་བའི་ཕྱིར་ཏེ།",
    "ཉོན་མོངས་པ་དེ་དག་ཀྱང་སྲེད་པ་ལ་སོགས་པའི་ཞེས་བྱ་བ་ནི་སྲེད་པ་དང་ལྟ་བ་དང་།",
    "བདག་ཏུ་ལྟ་བའི་སྒོ་ནས་བདག་མེད་པ་ཉིད་ལ་ཀུན་ནས་ཉོན་མོངས་ན་དེ་ཀུན་དུ་རྒྱུ་བ་དང་མི་སྤོང་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ལས་ཀྱང་ཡོད་ལ་ཉོན་མོངས་པ་རྣམས་དང་ཞེས་བྱ་བ་འདིས་ཡང་དག་པར་སྟོན་ཏོ།",
    "ཇེ་ཚོམ་ཤས་ཆེ་བའི་བསམ་གཏན་གྱི་བར་ཡིན་ན་ནི་ཐེ་ཚོམ་མོ།",
    "ཐེ་ཚོམ་ཤས་ཆེ་བའི་བསམ་གཏན་པར་མི་འདོན་པ་དེ་ཁྱདག་གི་ལྟར་ན་ནི་བརྩད་འུདུ་ཡང་མེད་ལ།",
    "དགེ་སློང་དག་དགེ་སློང་གསར་བུ་བྱེའདི་དག་ནི་དགེ་སྦྱོང་གི་གནོད་པས་གཙེས་པ་ཚངས་པར་སྤྱོད་པའི་འདམ་གྱིས་ཟིལ་གྱིས་ནོན་པ།",
    "དགེ་སྦྱོང་གི་གནོད་པས་གཙེས་པ་ཞེས་བྱ་བའི་ཚིག་འདིས་སོ།",
    "དེ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་ཡང་སྲིད་པ་པ་ཉིད་ཉེས་དམིགས་དང་བཅས་པས་ཡང་དག་པར་སྟོན་ཏོ་ཞེས་བྱ་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་ཉིད་ཉེས་དམིགས་དང་བཅས་པ་དང་།",
    "ད་ལྟར་བྱུང་བའི་ཚེ་རབས་ལ་ཉོན་མོངས་པས་ཡོངས་སུ་གདུང་བ་ཡིན་ཏེ།",
    "རང་གི་དོན་བྱི་སྦྱོར་བ་ལ་རྗེས་སུ་བརྩོན་པ།",
    "རང་གི་དོན་གྱི་སྦྱོར་བ་ལ་རྗེས་སུ་བརྩོན་པ་ཞེས་བྱ་བ་འདིས་སོ།",
    "དགེ་སློང་གི་ལས་ཁྱད་པར་དུ་འཕགས་པ་ནི་བསམ་གཏན་ཡིན་པར་རིག་པར་བྱ་བ་ནི་ལས་ཁྱད་པར་དུ་འཕགས་པ་ལ་སྦྱོར་བའི་ཕྱིར་ཞེས་གང་བསྟན་པ་ཡིན་ནོ།",
    "རང་གི་དོན་དང་སྦྱོར་བ་ལ་རྗེས་སུ་བརྩོན་པ་ཞེས་བྱ་བའི་ཚིག་འདིས་སོ།",
    "ཀྱེ་གོ་ཏ་མ་གང་གིས་ན་ད་ལྟར་མི་རྣམས་སྟོབས་ཆུང་བ་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "གང་གི་ཚེ་དེ་སེམས་རངས་པ་དང་།",
    "དེའི་ཉེས་དམིགས་བསྟན་པ་འདི་གཉིས་ཀྱིས་ནི་འདི་ལྟར་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "དེ་ལ་རོ་མྱོང་བར་བྱེད་པས་ནི་ཀུན་ནས་ཉོན་མོངས་པར་བྱེད་དོ།",
    "ཐེ་ཚོམ་མོསེམས་དེའི་ཕན་ཡོན་ཡོངས་སུ་བསྟན་པ་ནི་སེམས་དགའ་བ་དང་།",
    "གང་དག་མེད་པ་དེ་ཐམས་ཅད་ནི་བདག་གི་མ་ཡིན།",
    "དེ་ནི་བདག་གི་བདག་མ་ཡིན་ནོ་ཞེས་དེས་དེ་ལྟར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་གྱི་ལེགས་པའི་ཤེས་རབ་ཀྱིས་བལྟ་བར་བྱའོ།",
    "དགའ་བ་སྔོན་དུ་སོང་བའི་འདོད་ཆགས་ཞེས་བྱ་བ་ནི་ཡིད་བདེ་བ་སྔོན་དུ་སོང་བའི་འདོད་ཆགས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་འདི་སྐད་ཅེས་བྱ་བ་དེ་ནི་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་ཐོས་པ་དང་མི་ལྡན་པས་ཡུན་རིང་པོ་ནས་བྱི་དོར་བྱས་ཤིང་སྦས་ལ་བདག་གིར་བྱས་པ་དང་།",
    "འདི་ནི་བདག་གི་ཡིན།",
    "འདི་ལྟར་དེ་བདག་གིར་བྱས་པས་སོ།",
    "དེའི་རྗེས་སུ་འབྲང་བས་ཞེས་བྱ་བ་ནི་བདག་གི་བ་དང་།",
    "བདག་གིར་རྣམ་པར་ལྟ་བ་གཉིས་ཀྱི་རྗེས་སུ་འབྲང་བ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཀུན་དུ་བརྟགས་པ་དང་ནི་འདི་ནི་བདག་གི་བདག་ཡིན་ནོ་ཞེས་བྱ་བ་སྟེ།",
    "འདི་ནི་བདག་གི་བདག་ཡིན་ནོ་སྙམ་པའོ།",
    "དེའི་རྗེས་ལ་གྲུམཐུན་པའི་སྲེད་པ་གཉིས་པོ་ལཞེས་བྱ་བ་ནི་བདག་གི་བའི་རྣམ་པའི་རྗེས་སུ་མཐུན་པའི་སྲེད་པ་དང་།",
    "བདག་གི་བའི་རྣམ་པར་ལྟ་བའི་མཇུག་ཐོགས་སུ་དེར་ལྟ་བའི་རྗེས་སུ་འབྲང་བས་ཆགས་པ་གང་ཡིན་པའོ།",
    "བདག་ཏུ་ལྟ་བས་ནི་འདི་ནི་བདག་གི་བདག་ཡིན་ནོ་ཞེས་བྱ་བ་དང་།",
    "འདི་ནི་བདག་གི་ཡིན་ཞེས་བྱ་བ་བདག་གི་བའི་རྣམ་པའི་སྐྱེརྣམ་གྲངས་དང་པོར་གསུངས་པ་སྟེ།",
    "རྣམ་གྲངས་དང་པོ་བདག་གི་བའི་རྗེས་སུ་མཐུན་པ་སྟེ།་",
    "ཁས་བླངས་ལ་བཟུང་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་ནི་བདག་གིར་བྱས་པ་ཞེས་བྱའོ།",
    "དེའི་རྣམ་པ་ནི་བདག་གི་བའི་རྣམ་པ་སྟེ།",
    "འདི་ནི་བདག་གི་ཡིན་ཞེས་བྱ་བ་འདིས་སོ།",
    "བདག་གི་བའི་རྣམ་པའི་རྒྱུས་ཏེ།",
    "འདི་གཉིས་ཀྱིས་ཉུ་དེ་བདག་གིར་བྱས་པ་ཡིན་ཞེ་ན།",
    "བདག་གིར་བྱས་པ་དང་།",
    "འདི་ནི་བདག་གི་ཡིན་ཞེས་བྱ་བ་བུལ་སོགས་པ་ཚིག་ལྔ་དག་གིས་རིག་པར་བྱའོ།",
    "རེ་ཞིག་རྣམ་གྲངས་དང་པོའི་བསྡུས་པའི་དོན་ནི་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "རེ་ཞིག་བདག་ཏུ་ལྟ་བ་ལོག་པར་བསྒྲུབ་པ་ལས་དང་བཅས་པར་ཡོངས་སུ་བསྟན་པ་ནི་སྔ་མ་བཞིན་དུ་བཟུང་བ་དང་།",
    "སྡོགས་པར་བྱས་ནས་བདག་གི་སྐྱེ་བ་ནི་ཟད་དོ།",
    "ཆེ་གེ་མོ་ཞིག་ནི་ག་གེ་མོ་ཞིག་ཏུ་སྐྱེས་སོ།",
    "ཆེ་གེ་མོ་ཞིག་ནི་ཡོངས་སུ་མྱ་ངན་ལས་འདས་སོ་ཞེས་བྱ་བ་དེ་ལུང་བསྟན་པའོ།",
    "བཞུགས་ནས་བདག་མ་བྱུང་ཀྱང་རུང་བདག་གི་མ་བྱུང་ཊུཡང་རུང་།",
    "བདག་གི་མི་འབྱུང་ངོ་ཞེས་དེ་ལྟར་མོས་པ་ན།",
    "གོང་མ་སྲེག་གི་སྐྱེས་པའི་རབས་བསྟན་པ་ལ་སོགས་པའོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་དག་གིས་ས་བཅུ་དག་ཏུ་ནི་དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་དག་ནི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པ་དྲུག་དང་།",
    "རིང་དུ་སོང་བ་དང་།",
    "ངེས་པའི་ཚིག་གི་ཚུལ་གྱིས་ཏེ།",
    "ངེས་པའི་ཚིག་གི་ཚུལ་གྱིས་ནི་ཁྱེམཚུངས་པ་དང་བྲལ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་ཚིག་གི་དོན་ནི་བརྗོད་པ་གང་གིས་བརྗོད་པར་བྱ་བ་གང་ཡིན་པ་སྟེ་ཞེས་རྒྱས་པར་གསུངས་པ་དང་།",
    "ངེས་པའི་ཚིག་གིས་ནི་ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་ཡིན།",
    "རྣམ་པ་བཞི་དག་གིས་ཚིག་གི་དོན་རིག་པར་བྱ་སྟེ་ཞེས་བྱ་བ་འདི་ནི་ངེས་པ་མེད་དོ།",
    "དགེ་སློང་དག་གང་ཞིག་འདི་སྐད་དུ་བདག་གིས་ནི་སྟོང་པ་ཉིད་དང་།",
    "ཉོན་མོངས་པ་ཡང་དག་པར་སྡོམ་པའི་ཕྱིར་ནི་གསུམ་པ་ཡིན་ཏེ།",
    "ཀུན་ནས་ཁྱོན་མོངས་པ་རྣམ་པ་ཧཱུཾགསུམ་གྱི་གཉེན་པོས་ཀྱང་བསླབ་པ་གསུམ་པོ་དག་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་ཡིན་ནོ།",
    "དུག་གི་ལྗོན་ཤིང་ར་བས་བསྐོར་བ་དང་།",
    "ཟིལ་གྱིས་གནོན་པའི་གནས་སྐབས་དང་པོའི་གཉེན་པོར་འགྱུར་བ་ནི་དུག་གི་ལྗོན་ཤིང་ར་བས་བསྐོར་བའི་ཚུལ་གྱིས་སོ།"
  ]
}