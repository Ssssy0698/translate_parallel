    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཛཱ་ལ་མུ་ཁི་པཾ་ག་ལ་ལོ་ཙ་ནེ།",
    "ཡབ་ཀྱི་མགྲིན་པར་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་བཕཊ་སྭཱ་ཧཱ།",
    "ཛཱ་ལ་མུ་ཁི་པཾ་ག་ལ་ལོ་ཙ་ནེ།",
    "ཡབ་ཀྱི་མགྲིན་པར་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "། ཛ་ལ་མུ་ཁི་པོ་ག་ལ་ལོ་ཙ་ནེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "བྱམས་པའི་ངོ་གདོང་འཚོས་ནས་འདུག་ཐབས་ཀྱང་མེད་པས།",
    "དྲོད་ལམ་ལམ་གྱི་གཏམ་རྒྱུད་ཅི་ཞིག་འདུགཕྱི་མིག་ནམ་ཡང་རང་ཉིད་ལ་བཏང་བའི་མནར་གཅོད་ཅིགགཙང་པོ་རྒྱང་ལ་བཞུར་རྗེས།",
    "རྨ་ལྷོ་མི་རིགས་དགེ་ཐོན་སློབ་ག་དུས་ཚིགས་འདིར།",
    "བུ་ཆུང་ང་ཡི་འདྲེན་བྱེད་དཔལ་དུ་དྲན་པའི་གཟུགས་རིས་འཆར་ཙ་ན།",
    "བུ་ཆུང་ང་ཡི་འདྲེན་བྱེད་དཔལ་དུ་དྲན་པའི་གཟུགས་རིས་འཆར་ཙ་ན།",
    "དྲིན་ཆེན་ཕྱུགས་རྫི་བཟང་པོའི་འཚོ་སྐྱོང་རང་མེད་ན།",
    "ཐབས་རྩལ་སོགས་ཀྱི་མཛེས་པར་ཇི་མ་ཇི་བཞིན་དུ་དཔྱད་པ་བཏང་འདུག་པས།",
    "བོད་གངས་ཅན་གྱི་མི་རབས་གསར་བའི་ཕུགས་བསམ་མངོན་འདུགརྙིང་ཞེན།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་ངེར།",
    "ཕྲུ་བའི་འབྲས་ནི་ཕྲུ་བའི་ནང་ན་འདུག་པའི་འབྲས་ཏེ།",
    "ཕྲུ་བའི་ནང་ན་འདུག་པ་ཕལ་ཆེར་ཚོས་པ་མཐོང་ལ།",
    "དེ་བཞིན་དུ་མ་ཚོས་པ་དག་ལ་གཏན་ཚིགས་ཕྲུ་བའི་ནང་ན་འདུག་པ་ཉིད་མ་མཐོང་བ་ཙམ་ཡང་ཡོད་དུ་ཟིན་ཀྱང་།",
    "འོན་ཀྱང་ཕྲུ་བའི་ནང་ན་འདུག་པ་ཙམ་གྱི་གཏན་ཚིགས་ཀྱིས་ནི་འབྲས་ལྷག་མ་ཚོས་པར་མི་འགྲུབ་པོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་ཕྲུ་བའི་ནང་ན་འདུག་པ་ཉིད་ཙམ་གྱིས་ཐམས་ཅད་ཚོས་པ་སྒྲུབ་ན་ནི།",
    "དེ་ཡང་རང་བཞིན་ཐ་དད་པ་མེད་པར་མི་རུང་སྟེ།",
    "གཉིས་པ་ལ་ཡང་རང་བཞིན་གྱིས་མི་གཡོ་བ་ནི་དོན་གཞན་མི་རྟག་པ་ཉིད་དང་ལྡན་ཡང་།",
    "དེ་ལྟ་བས་ན་བསྡུས་པའི་དོན་ནི་སྲེག་པའི་སྐད་ཅིག་མ་ཕྱི་མ་ཕྱི་མ་སྐྱེད་པར་ནུས་པའི་རྒྱུན་འཇུག་པའི་མེས་དུ་བའི་རྒྱུན་འཇུག་པ་འདུག་པ་སྐྱེད་པར་མངོན་སུམ་གྱིས་ངེས་པར་གཟུང་ལ་དེ་ལྟ་བུ་གཞན་དུ་ངེས་པར་བཟུང་ནས།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་གཞན་དང་གཞན་ཡོངས་སུ་ཚོལ་བས་ཐུག་པ་མེད་པའི་ཕྱིར་རང་བཞིན་རྟིང་ཚུགས་པ་གཅིག་ཀྱང་མེད་པས་ནམ་མཁའ་རང་བཞིན་དང་པོ་རྟོགས་པ་མེད་དེ་དེའི་ཕྱིར་དེ་ཉིད་ཐ་དད་བ་མེད་པ་ཡིན་ནོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་དོན་དེ་དག་ཉིད་འགའ་ཞིག་ལས་ལོག་པ་ལྟ་བུར་འདུག་པ་ན་སྟེ།",
    "དེ་ལྟ་བས་ན་གསལ་བ་རྣམས་ཁོ་ན་ཐ་དད་ཀྱང་རང་བཞིན་གྱིས་རྣམ་པར་ཤེས་པ་གཅིག་ཏུ་སྙེམས་པ་ཅན་བསྐྱེད་དོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "རིམ་པ་དེ་ལྟར་འདུག་པ་དང་།",
    "རྗེས་སུ་འགྲོ་བ་མེད་པ་ཅན་གྱི་ལྡོག་པ་མེད་ན་ཡང་དེའི་དངོས་པོའི་སོ་ན་འདུག་པ་ལ་ཅུང་ཟད་ཀྱང་མི་བྱེད་པས་དེ་བཞིན་དུ་དམིགས་པ་ལ་སོགས་།",
    "དེའི་སོ་ན་འདུག་པ་དེ་ལ་སྒྲིབ་པར་ཡང་མི་རུང་བའི་ཕྱིར་རོ།",
    "ཐ་དད་པ་ཡིན་ན་ཡང་རང་ཉིད་ཀྱི་ངོ་བོ་ལ་གནས་པ་དེ་ལྟར་ན་ཇི་ལྟར་གསལ་བ་རྣམས་ཀྱི་སྤྱིའི་ངོ་བོ་ཡིན་ཏེ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "གསལ་བར་བྱ་བ་དང་རང་ཉིད་ནི་བུམ་པ་ལ་སོགས་པའོ།",
    "དགག་པ་ཙམ་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་མེད་པ་ཉིད་ཡིན་པ་དེའི་ཕྱིར་དེ་ནི་རྩོད་པ་མ་ཡིན་ནོ།",
    "བྱས་པ་ཉིད་ལ་སོགས་པ་ཡང་རང་བཞིན་ཡིན་པས།",
    "རང་བཞིན་གྱི་ཡང་རང་བཞིན་ཁྱབ་པར་བྱེད་པ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "ཡོད་པ་ཉིད་ཡིན་ན་ཡང་རང་བཞིན་ལ་སོགས་པས་བསྐལ་པས་འགའ་ཞིག་ཏུ་མི་དམིགས་པ་དེའི་ཕྱིར།",
    "དོན་ཐམས་ཅད་ལ་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པ་དག་ལ་ཡང་ངོ།",
    "ཐེ་ཚོམ་ཟ་བ་ཡོད་ན་གདོན་མི་ཟ་བར་འདུག་པར་མི་བྱའོ་ཞེས་དེ་ལྟར་སེམས་ལ་ངེས་པར་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཀྱང་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་བསྐལ་པ་ཅན་ནི་རང་བཞིན་ཡིན་ལ་ཤེས་བྱེད་ནི་རྟགས་ཡིན་ཏེ།",
    "ཅི་སྟེ་ཡང་འདིར་མི་དམིགས་པ་ཞེས་མ་ཐོས་པ་དེ་ལྟར་ན་ཡང་རང་བཞིན་འགལ་བ་ཞེས་བྱ་བའི་རྟགས་ནི་མི་དམིགས་པ་ལས་ཐ་དད་པར་བརྗོད་པར་མི་བྱའོ།",
    "བདེ་བ་ལ་སོགས་པ་དག་ཀྱང་རང་རིག་པའི་མངོན་སུམ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བར་འགྱུར་ན་ཡང་རང་བཞིན་གྱི་རྟགས་ཀྱིས་ནི་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་དོན་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པ་ནི་སྒྲའི་ངོ་བོ་མ་ཡིན་ཞིང་རང་བཞིན་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་སྐྱེས་བུ་དེས་རྟག་ཏུ་ཟིན་ཀྱང་རང་བཞིན་ཏེ།",
    "འོན་ཀྱང་རང་ཉིད་གྱིས་གཙུབ་ཤིང་གཙུབས་པའི་ཚོགས་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་རང་བཞིན་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པ་ཅན་ཉིད་དུ་འགྱུར་ཏེ།",
    "ཡི་གེའི་གནས་སྐབས་དང་རང་བཞིན་བསྐྱོད་པ་ཙམ་སྟེ།",
    "གོ་རིམས་ལ་སོགས་པའི་གནས་སྐབས་དང་རང་བཞིན་མ་བསྐྱོད་པ་མ་བྱས་པ་གང་ལ་ཡོད་པ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "སྣང་བ་ཐ་དད་པས་ཀྱང་རང་བཞིན་ཐ་དད་པ་ཉིད་ཡིན་ན་དེ་ལ་རྟོགས་པའི་སྣང་བ་དང་རང་བཞིན་ཐ་དད་པ་སྟེ།",
    "བདག་མེད་པ་གང་ཡིན་པ་དེ་ཡང་རང་དགས་འཇུག་པ་ཅན་མ་ཡིན་པ་དེ་བས་ན།",
    "ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡང་རང་བཞིན་མི་དམིགས་པ་དེ་དང་ལྡན་པ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "ཁྱབ་བྱེད་ནི་རྒྱུ་དང་རང་བཞིན་གཉི་ག་ཡང་ཡིན་ཏེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་དག་ལ་ཁྱབ་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཉམས་སུ་མྱོང་བ་ཡང་རང་རིག་པས་ཡིན་གྱི།",
    "དེ་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་ཉིད་རྟོགས་པའི་བདག་ཉིད་ཅན་ཡིན་གྱི་གཞན་གྱི་ཆར་གྱུར་པ་ནི་མ་ཡིན་ཏེ།",
    "རྟོག་པ་ཡང་རང་རིག་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ལ་དམིགས་པ་ཁོ་ན་སྔོན་པོ་ལ་སོགས་པ་ཡིན་ཞིང་།",
    "དོན་དུ་སྣང་བ་དང་རང་སྣང་བ་ཞེས་བྱ་བ་ནི་བསྡུས་པའི་དོན་ཡིན་ནོ།",
    "ཡུལ་དུ་སྣང་བ་དང་རང་སྣང་བའི་མཚན་ཉིད་ཅན་དག་ནི་ཞེས་བྱ་བ་ན་གཟུང་པ་དང་འཛིན་པའི་རྣམ་པའི་མཚན་ཉིད་ཅན་དག་གོ།",
    "ནང་མངོན་ཕྱོགས་འཛིན་པའི་རྣམ་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ནང་རང་རིག་པའི་ངོ་བོ་ཉིད་དུ་རུང་བ་ཉིད་ཀྱི་མཚན་ཉིད་དུ་ཡིན་གྱི།",
    "ཡུལ་ལ་དམིགས་པའི་དམིགས་པ་ཞེས་བྱ་བ་ནི་ཡུལ་ལ་དམིགས་པའི་དམིགས་པ་ཤེས་པ་གཉིས་པ་གང་ཡིན་པ་དེ་ཡང་རང་རིག་པ་ཁས་མི་ལེན་པའི་ཕྱིར་བདག་ཉིད་གསལ་བ་མ་ཡིན་ནོ།",
    "སོགས་པའི་སྒྲ་དང་པོས་ནི་མ་ཆོད་པ་དང་རང་བཞིན་ཁྱད་པར་ཅན་དང་།",
    "ཆོད་པ་མེད་པ་དང་རང་བཞིན་ཁྱད་པར་ཅན་མངོན་དུ་ཕྱོགས་པ་དང་རྐྱེན་གཞན་ཚོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་ཡིན་ནོ།",
    "དེར་བགྲོད་པའི་ཐེག་ཆེན་གྱི་ལམ་རྗེས་སུ་མཐུན་པ་ཙམ་ཡང་རང་ལམ་དུ་ཉམས་སུ་མི་ལེན་པར།",
    "མངར་བར་གྱུར་པའི་རོ་ནི་ནང་ན་འདུག།",
    "བདུན་པའི་ཡེ་ཤེས་དེ་ཕྱིར་མི་ལྡོག་པའི་ས་བརྒྱད་པ་ལ་མངོན་དུ་ཕྱོགས་པའི་ཡེ་ཤེས་སུ་འདུག་པས།",
    "ལས་ཉོན་གྱིས་སྐྱེ་བ་ལེན་དགོས་པ་འདུག་ལ།",
    "དེའི་ཚུལ་ཡོད་དེ་ང་རང་བཞིན་མེད་པ་རྟོགས་ཟིན་གོམས་པར་བྱས་པ་ལ་བརྟེན་ནས།",
    "འབྲས་བུ་རྣམས་རང་རང་ལས་སྐྱེ་བ་ཡིན་ཀྱང་།",
    "སྔར་གྱི་སྔོན་འཛིན་ལྟ་བུའི་ཤེས་པ་ཡང་རང་དུས་སུ་ཉམས་སུ་མ་མྱོང་བས་ཕྱིས་ཀྱི་དྲན་པ་ཡོད་པར་མི་འགྲུབ་བོ།",
    "དྲན་པ་ལས་ཀྱང་རང་རིག་གྲུབ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "རྨུགས་པའི་ཚེ་དུག་ཞུགས་པར་འདུག་སྙམ་དུ་དྲན་ཀྱང་།",
    "ཕྱིས་བྱི་བས་རྨུགས་པ་དྲན་པའི་སྟོབས་ཀྱིས་སྔར་རྨུགས་དུས་དེར་བྱི་དུག་ཞུགས་འདུག་སྙམ་དུ་དྲན་པ་གཉིས་དཔེ་དོན་དུ་སྦྱོར་བ་སོགས་ཡིན་ཏེ།",
    "ཁོ་རང་འཛིན་པའི་རྟོག་པས་བརྟགས་པ་ཡིན་ཏེ།",
    "ཁོ་རང་འཛིན་པའི་རྟོག་པས་བརྟགས་པ་ཡིན་ཏེ།",
    "དེ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དད་ཡིན་པ།",
    "དེ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཏུ་ལྡན་པའི་ཚུལ་དང་།",
    "༩༢ན་དེ་ལྟར་འཇུག་པའི་འགལ་རྐྱེན་སེལ་ཞིང་མཐུན་རྐྱེན་མ་ལུས་པ་ཚང་འདུག་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་མ་ཕྱི་ནང་མི་གསལ་བ་དང་དོགས་ཅན་ཁ་ཤས་སྣང་ཡང་རང་སར་བཞག་པ་ལས་ཕྲི་བསྣན་རྔོ་མི་ཐོགས།",
    "ད་ནས་ཁྱེད་རང་འདིར་སྡོད་དགོས་མེད།",
    "མ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "སྐབས་ཤིག་ཨོ་རྒྱན་གྱི་ཕྲ་མེན་མ་ལྔ་བརྒྱས་བར་ཆད་བརྩམ་པར་འདོད་ནས་བཙལ་བས་སློབ་དཔོན་གྱི་ཤུལ་མ་ས་ཡདུ་ལྭ་བ་གཅིག་ལས་གཞན་མི་འདུག་པས།",
    "བཙད་པོས་བློན་པོ་རྣམས་ལ་ཨཱ་ཙརྱ་དེ་ཇི་ལྟར་འདུག་ལྟོས་ལ་ཤོག་བཟང་པོ་ཞིག་འདུག་ན་འདིར་ཡང་སྤྱན་འདྲེན་ནོ་གསུངས།",
    "ནམ་ཞིག་རྨ་ཆུ་ཁའི་ཕྱུགས་རྫིས་སྨར་གཡོ་གཙང་གསུམ་དན་ཏིག་ན་བཞུགས་པ་མཐོང་ནས་འདི་ལྟར་འདུག་ཅེས་མི་རྣམས་ལ་སྨྲས་པ་ཐོབ་ནས།",
    "དེ་དང་མི་ལྡན་པའི་སྔགས་སུ་ཁས་བླངས་ནས་སྦྱོར་སྒྲོལ་སོགས་བག་མེད་བྱེད་པ་བཀག་འདུག་འདི་ལན་བཏབ་པའི་གནས་མིན་གདམས་པ་ཡིན།",
    "བལ་པོ་ན་རྒྱ་དཔེ་མང་དུ་འདུག་པ་ལ།",
    "ད་དུང་འགྱུར་མང་དུ་བྱ་རྒྱུ་འདུག་པ་ལ་གསུངས་ཤིང་།",
    "རྙིང་མར་ཁ་ཟེར་བའི་ཐོག་མ་ཡིན་པར་འདུག་ལོ་ཆེན་རིན་བཟང་དང་།",
    "ཡེ་གྲགས་ཡེ་ཤེས་འོད་སོགས་ཀྱིས་སྔགས་འཆལ་ཆེས་བཀག་པའི་བདེན་གསུང་རང་གཞན་སུས་ཀྱང་དེ་ལྟར་ཤེས་དགོས་པ་ཞིག་འདུག་གོ།",
    "མཁས་གྲུབ་ཆེན་པོ་སོག་བཟློག་པས་ཀྱང་ལན་ལེགས་པར་གདབ་པས་ཆོག་པར་གདའ།",
    "ཕྱིས་ཀྱི་ལོ་ཙཱ་མཁས་པས་རྒྱ་དཔེ་བོད་དཔེ་ཀུན་ནས་བརྟག་དུས་ལྷག་པར་ཡིད་ཆེས་སྐྱེ་ཡིས་བཅོས་དགོས་མི་སྣང་བ་ཤ་སྟག་ཡིན་ཏེ།",
    "འཕགས་པ་ཡབ་སྲས་ཀྱི་ལུགས་དང་མི་མཐུན་པའི་འགྱུར་ཉེས་ཡོད་པ་ལྟ་བུར་བསྟན་འདུག་ཀྱང་།",
    "དངོས་དོན་མི་བཅོས་མི་རུང་བ་ནི་ཅི་ཞིག་བཅོས་འདུག་དཔྱད་ན་ངོ་བོ་ཉིད་ཟེར་ག་",
    "རང་རང་རསན་སྐད་གཞན་རྣམས་ཀྱིས་སྲིད་གསུམ་མ་ཚང་མེད་པ་ལམ་ལ་ཡང་དག་འགོད་བྱེད་པས།",
    "བརྒྱ་དང་དྲུག་ཁྱད་ཆེ་ཡང་དོན་ལ་མི་འགལ་བ་ལྟ་བུ་འདི་འདྲ་ཕལ་གྱི་བློ་ངོར་མི་འཐད་ཀྱང་མཁས་པ་ལ་ཆེས་མཛེས་གསུངས་༥རྙིང་མའི་སྔགས་རྟགཕལ་ཆེར་བོད་སྐད་ཡིན་པས་འདི་ལ་ཐེ་ཚོམ་ཟ་འདུག་ཀྱང་།",
    "ཕྱིས་སུ་སུས་ཀྱང་བསྒྱུར་པ་འདུག་གམ།",
    "དེ་དག་དུས་ཀྱི་འཁོར་ལོ་ན་མ་སྦས་ཀྱང་།",
    "མཐར་གཙང་རྒྱ་མ་ཉེ་དུ་ཁའི་ཕུང་པོ་རི་བོ་ཆེ་ལ་ད་ལྟ་འདུག་འཕྲོར་རི་ཟུར་ནས་ཡར་སྐུ་ལུས་སྤྲིན་ཆད་པ་བཞིན་ལྷག་མེད་དུ་གཤེགས་། དེས་དབུ་རུ་ཞའི་ཉང་ཤེས་རབ་འབྱུང་གནས་བྱ་བའི་དགེ་སློང་བགྲེས་པོ་ཞིག་ལ་གདམས་པ་བཏབ་པས།",
    "ག་ཅ་སྐྱེངས་པའི་རྣམ་རྟོག་ཅིག་ཤར་ཙ་ན།",
    "བྲག་ཕུག་ཅིག་ཏུ་བྱོན་ཙ་ན་ཁང་སྟོང་དེ་འགྱེལ།",
    "ཀརྨའི་ཡང་དགོན་དབེན་པར་འདུག་པའི་ཚེ།",
    "སློབ་དཔོན་རྣམས་ལས་ཀྱང་ང་རང་མཁས་སོ་སྙམ་པའི་རྟོག་པ་ལན་གསུམ་སྐྱེས་པས།",
    "འདི་སྤྲུལ་པའི་སྐུར་འདུག་པས་མཚན་སྤོ་མི་དགོས་གསུངས།",
    "སླར་སངས་ཙ་ན་སློབ་དཔོན་དགོངས་པ་གློད་ནས་ཞལ་འཛུམ་མེར་འདུག་ད་བཞེངས་རྒྱུའི་ལྷ་ཞལ་གསུམ་ཕྱག་དྲུག་གཅིག་བསྟན་པར་ཞུས་པས།",
    "ཁོང་རྣམས་དེ་ལྟར་བྱེད་རིང་ནང་ན་འཕྲོས་དིར་དིར་འདུག་ཁྲུས་དང་སྐོར་བ་ཟིན་ནས་ནང་དུ་ཕྱིན་ཙ་ན་སྐུ་དྲུང་དུ་སུ་ཡང་མེད།",
    "དཔལ་ཆེན་པོའི་ལྟེ་བ་ཡན་ཆོད་རང་བྱོན་དུ་ཤར་འདུག་པས་བུ་སློབ་དང་བཟོ་བོ་ཀུན་ངོ་མཚར་དཔག་ཏུ་མེད་པ་སྐྱེས།",
    "ཟུར་ཆུང་པ་རིས་མེད་མཉམ་པ་ཆེན་པོའི་གནས་ལ་བྱོན་པས་ལྟ་བ་མཐོ་བ་མཚོན་ཕྱིར་ཤིང་རྟ་གང་ཙམ་འཕགས་ནས་གདའ་སྐད།",
    "དེར་ཉི་མ་ཤར་བ་དང་ཀ་ཀ་ལནསྐུ་མདུན་དུ་ཕྱིན་པས་གཟིམས་མལ་ན་སྐུ་ཚགས་མཛད་ཅིང་འདུག་གར་གཤེགས་ཞུས་པས།",
    "ད་ནི་འགྲོ་དོན་བྱས་ཀྱང་འགྲུབ་པར་འདུག་དགོངས་པའི་ཚེ།",
    "ཁོའི་དྲུང་དུ་ཕྱིན་ཙ་ན་བཅོམ་ལྡན་འདས་དཔལ་ཆེན་པོ་ཨམ་དེ་འདི་ཀ་ཡིན་པར་འདུག་སྙམ་པ་ལས་མི་ཡིན་པའི་འདུ་ཤེས་མ་སྐྱེས་གསུངས་སྐད།",
    "སྒྲོ་ཕུག་པས་དམ་པར་མངོན་ཤེས་ཨེ་འདུག་ཉམས་སད་དུ།",
    "ཁོང་རང་ཕྱིན་ཞབས་འབྲིང་ལྟར་བྱས་པས།",
    "ཁོང་རང་དགུང་གྲངས་ཉེར་དྲུག་ནས་བརྩམས་སྐབས་གསེང་ཕྲན་བུ་མ་གཏོགས་སྒྲུབ་པ་ཉམས་ལེན་ཁོ་ན་གཙོ་བོར་བཏོན་པས།",
    "བརྒྱུད་པ་གསུམ་ག་རོག་བདེ་གཤེགས་ཆེན་པོ་ལ་བཀའ་བབས་ཤིང་དེ་ནས་རོག་ཐམས་ཅད་མཁྱེན་པ་སོགས་རིམ་གྱིས་བརྒྱུད་དེ་སྔར་དར་རྒྱས་སུ་བཞུགས་ས་ཀ་པར་འདུག་ཀྱང་དེང་སང་མཚན་ཙམ་དུ་གྱུར་ཅིང་།",
    "དེ་ལས་སད་ཙ་ན།",
    "རྫོགས་པ་ཆེན་པོ་ཨ་ཏི་ཡོ་གའི་སྐོར་རྣམས་བེ་རོ་ཙ་ནས་སློབ་དཔོན་ཤྲཱི་སེང་ཧ་ལས་གསན་པ་དང་།",
    "མནམརྒྱུཡས་པ་ས་ཡ་དང་གདམས་སྐོར་ཕལ་ཆེར་ཕྱི་རབས་གདུལ་བྱའི་དོན་དུ་གཏེར་རྒྱས་བཏབ་པར་མཛད་དོ་ གཉིས་པ་ལོ་ཆེན་བེ་རོ་ཙ་ནས་རྒྱ་གར་གྱི་མཁས་པ་ཉེར་ལྔ་སོགས་བསྟེན་ཅིང་།",
    "ཀུན་ཀྱང་རང་རང་སོ་སོའི་ལས་ལ་འཇུག།",
    "ཕལ་ལ་མི་འཚམ་རང་རང་ལས་ཀྱིས་བསྐལ།",
    "སྒྲུབ་བརྒྱུད་འདྲེན་པའི་ཤིང་རྟ་ཆེན་པོ་བརྒྱད་རྗེས་འབྲང་དང་བཅས་པ་རང་རང་སོ་སོའི་ལྟ་གྲུབ་ཀྱི་ཁས་ལེན།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "རང་རང་སྐད་ཀྱི་ཁྱད་པར་རྣམས་ཀྱིས་ནི།",
    "རང་རང་སྐད་གཞན་རྣམས་ཀྱིས་སྲིད་གསུམ་མ་ཚང་མེད་པ་ལམ་ལ་ཡང་དག་འགོད་བྱེད་པ།",
    "ཙོག་པུར་འདུག་དང་གཅིག་པུར་རྒྱུ་བ་དང་།",
    "འགྲོ་དང་འགྲེང་དང་ཉལ་དང་འདུག་པ་དང་།",
    "ཡས་པ་སྦ་བར་མཛད་པའི་སྐབས་སུ་བོན་གཏེར་ཚད་ལྡན་རྣམས་ཀྱང་དེ་དང་ལྷན་ཅིག་དུས་མཉམ་དུ་སྦས་པ་དང་།",
    "གར་ལ་བལྟ་བའི་ཁྲོད་དུ་འདུག་པ་ཞིག།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཐ་ན་ཁྱིམ་པ་སོགས་གང་ཡང་མི་ཤེས་ཤིང་བསྟན་པའི་གཉེར་མེད་པ་རྣམས་ཀྱང་རང་རང་སོ་སོའི་ཕྱོགས་བཟུང་ནས།",
    "ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟ་བུའི་ཟབ་དོན་ཐང་མར་བརྡལ་ཏེ་རང་རང་གང་འདོད་དུ་སྤྱོད་ཆོག་པར་མཛད་པ་འདི་ལྟ་བུའི་བཀའ་དྲིན་གྱི་ཁྱད་པར་ནི།",
    "རང་རང་འཇུག་ལྡོག་བྱ་བར་བརྩོན་པ་བཞིན།",
    "པདྨ་གསར་པའི་འདབ་མ་དང་གེ་སར་དང་ཟེའུ་འབྲུ་དང་ལོ་འདབ་སྡོང་པོ་མ་ཉམས་པར་སྦྲང་རྩི་གཞོན་ནུའི་ཟིལ་པ་དང་བཅས་ནས་འདུག་པ་ལྟར།",
    "གཞན་ཡང་ཀུན་བཟང་རང་མཚན་དེ།",
    "བྱེད་བཅིངས་རྫ་ས་སམ་གཉིད་སྟུག་དུས།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "ཐ་སྙད་རྣམས་ཀྱང་རང་དྲན་ཡིན། ། ཁ་ཅིག་ཕྱག་ཆེན་ལྟ་བ་ནི།",
    "དེས་བསྟན་བཅོས་དེར་མགོན་པོ་གང་ལ་བསྟོད་པ་ཤོ་ལོ་ཀ་གཅིག་ཕུལ་འདུག་པ་འདིར་དྲངས་ནས་དེའི་དོན་ལ་དྭགས་དོགས་",
    "ཞེས་བྲིས་གདའ་ལ།",
    "གཉིས་སུ་སྣང་བའི་ཆ་ནས་དངོས་སུ་རིག་པའི་མཁྱེན་ཚུལ་གྱི་ཤེས་པའི་རྫས་ཐ་དད་པ་ཉིད་དོན་གྱི་ཁས་བླངས་པས་མཁྱེན་གཉིས་ངོ་བོ་གཅིག་པའང་བཀག་འདུག་པའི་ཕྱིར།",
    "ང་རང་ཡོད་མེད་གཉིས་གང་བྱས་ཀྱང་ཆོག་པའི་ཕྱིར།",
    "དེའང་རང་མི་རིག་ཅིང་གཟུང་འཛིན་གཉིས་དང་བཅས་པ་ཡིན་ཅིང་།",
    "སྣང་བ་དང་བཅས་པའི་འཕགས་པ་ཉན་ཐོས་དང་རང་རྒྱལ་དང་བྱང་སེམས་ཀྱི་རྒྱུད་ཀྱི་རྗེས་ཐོབ་དག་པ་བའི་བློ་ཉིད་ལ་ཡོད་ལ།",
    "ཉེས་པ་སོ་ན་འདུག་པ་ཉིད་དོ་སྙམ་ན།",
    "ཞར་བྱུང་རང་རྒྱུད་པ་དག་དངོས་པོ་རང་མཚན་དུ་གྲུབ་པར་བཞེད་པ་ལ་དྭགས་དོགས་པ་དཔྱོད་པའོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་དང་མེད་པ་ལ་རིམ་གྱིས་ཀྱང་ཡོད་པ་དང་མེད་བ་འགལ་བ་ཉིད་དོ།",
    "དེ་ཡང་རང་རྒྱུད་པ་དག།",
    "སྣང་བཅས་ཀྱང་རང་བཞིན་ཡིན་གྱི།",
    "མི་ལེན་ན་དོན་དམ་པའི་བདེན་པར་གྲུབ་ན་ཡུལ་རང་ངོས་ཀྱི་སྡོད་ལུགས་ཀྱི་བདེན་པར་གྲུབ་པ་དེ་དོན་དམ་པར་དང་ཡང་དག་པར་ང་རང་་",
    "དོན་ཐོབ་པའི་རང་བཞིན་དུ་གྲུབ་པའམ་རྙེད་པར་འགྱུར་ཞིང་དེའང་རང་ལུགས་ལ་གྲུབ་པའི་ཕྱིར།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་དོན་གྱི་རྣམ་པར་རིག་པ་ཡང་རང་རིག་ནསབ་མཔ་ཡིན་པར་འདོད་དེ།",
    "གཉིས་པ་ལྟར་ན་ཡང་རང་རིག་ཉིད་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "ངས་མ་མཐོང་ཡང་ངས་མ་མཐོང་བའི་ཁྱབ་པ་མེད་པ་གཉིས་བཅས་འདུག་པ།",
    "དེ་ལྟ་ན་བདེན་པ་ནི་མི་བདེན་པས་ཁྱབ་པ་དོན་གྱིས་འཕངས་འདུག་སྟེ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "ཁྱེད་རང་ཉིད་དང་འཕགས་པ་འཇམ་དབྱངས་དང་།",
    "ཅི་རྐྱེན་གྱི་ཚོགས་པའི་དངོས་པོ་ལྟར་སྣང་བ་དེ་ཉིད་ཀྱི་ཕྱིར་དེ་དངོས་པོར་གྲུབ་པ་འགོག་པར་མཛད་པ་དེ་ཡང་ཁྱེད་རང་ལྟར་ན་རིགས་པ་དང་མི་ལྡན་པའི་ངག་ཡིད་དུ་འགྱུར་རོ།",
    "ཁོ་བོ་ཅག་དཔྱད་པ་ན་དེ་དེར་ཡོད་མེད་ཐམས་ཅད་འགོག་ཅིང་དེ་ཡོད་མེད་གང་དུ་ཡང་རང་ལུགས་ཀྱིས་འཇོག་པ་བྱར་མེད་དེ།",
    "གཟུགས་བརྙན་རང་མེད་ཙ་ན་གཟུགས་ཀྱི་ངོ་བོ་ཉིད་ཅན་བྱ་བའི་སྒྲུབ་བྱེད་མེད་ལ།",
    "ཡང་རང་ལུགས་སུ་རང་མཚན་གྱི་དངོས་པོ་ཞིག་འཇོག་ཅི་ཐུབ་ཐུབ་བྱེད་ནས།",
    "དེ་དེར་སྣང་བ་ལྟར་དེ་དེའི་བདག་ཉིད་དམ་རང་མཚན་ནམ་རང་བཞིན་ནམ་ངོ་བོ་འམ་ཁོ་ཁོ་རང་དུ་གྲུབ་ན་རྒྱུ་རྐྱེན་གཞན་ལ་ལྟོས་མེད་དུ་གྲུབ་དགོས་པའི་ཕྱིར།",
    "གཞིའམ་རྩ་བ་མི་འདུག་པར།",
    "བདེ་སྡུག་གཞི་རྩ་མི་འདུག་པར་བདེ་བ་ཆེ་ཞེས་བཏགས་པ་འཆལ།",
    "ཐ་སྙད་གདགས་གཞི་མི་འདུག་པར།",
    "གཞི་དང་གཞི་མེད་མི་འདུག་པར།",
    "སྲང་མདའ་གཉིས་ལ་ནི་ད་ལྟ་བ་ཡིན་པའི་ཕྱིར་མཐོ་དམན་གྱི་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་ཡོད་ཀྱི།",
    "དེའི་ཕྱིར་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་དུ་མི་རིགས་སོ།",
    "བ་ན་ཡང་ཁྱེད་ཅག་ཐ་སྙད་དུ་ས་བོན་འགག་པ་དང་མྱུ་གུ་སྐྱེ་བའི་སྐད་ཅིག་དུས་མཉམ་ཚོམས་དང་པོའི་རྣམ་བཤད།",
    "ཡང་དེའི་བཟློག་ཕྱོགས་ཀྱི་ལུང་རིགས་གང་ཡང་རང་ལུགས་ཀྱིས་གྲུབ་པར་བཞག་ཏུ་མེད་དེ།",
    "སྣང་གཞི་ཤིང་བུ་ཉིད་རྟ་གླང་དུ་དོན་བྱེད་པར་སྣང་ན་དེ་ལས་རྟ་གླང་རང་རྒྱུད་པ་གཞན་དུ་མེད་པའི་ཕྱིར།",
    "སྨྱུག་སོགས་ཀྱི་དངོས་པོ་རང་རང་ལ་བདག་བདེན་ཡོད་ན་དེ་མྱུག་སོགས་ཀྱི་དངོས་པོ་ལས་གཞན་པའི་ཡུལ་རང་ངོས་ནས་བདག་བདེན་དུ་གྲུབ་པར་ཡོད་དགོས་ཟེར་བ་ནི།",
    "སྣང་བ་འདི་ཀུན་ཟབ་ཏ་ཟོབ་ཏ་རུ་གདའོ།",
    "སྣང་བ་འདི་ཀུན་སྒྱུ་མ་རྨི་ལམ་དུ་གདའོ།",
    "སྟོང་པ་ཉིད་ལ་རང་བཞིན་ཡོད་པ་དང་རང་བཞིན་ཡང་མ་བཅོས་པའི་རང་བཞིན་ཡོད་པ་དང་།",
    "སྟོང་པ་ཉིད་ལ་རང་བཞིན་སྒྲོ་མ་བཏགས་པ་མེད་ཀྱང་རང་བཞིན་ཅིར་ཡང་མི་གནས་པ་ལ་རང་བཞིན་དུ་སྒྲོ་བཏགས་པ་ནས་བསྟན་པ་ཡིན་ནོ་ཞེས།",
    "ལ་དྲིས་པས་དེའི་ལན་ཇི་བཞིན་མ་བྱུང་ཞེས་བྲིས་གདའ་བ་ནི།",
    "ཐ་སྙད་ཙམ་དུ་སྣང་བ་སེམས་སུ་ཁས་བླངས་ནས་སེམས་ཀྱང་རང་བཞིན་མེད་པར་བརྗོད་དེ།",
    "རྗེས་སུ་འགྲོ་ན་ཡང་རང་མཚན་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེ་ལྟ་ནའང་རང་ལུགས་ཀྱི་གྲུབ་པ་འཇོག་བྱར་མེད་པས་སུན་ཅི་ཕྱིན་དུ་གཞན་གྱི་གྲུབ་པ་བཀག་པ་ཡང་མེད་དེ།",
    "འདི་ལྟ་བུ་རུ་འདུག་སྟེ།",
    "གློ་ལ་གནམ་ལྕགས་འབར་བའི་ཡ་ཙ་ནི་བཏགས།",
    "སྔ་ན་མ་མཐོང་བའི་ལམ་གཅིག་ལྷོ་ཕྱོགས་སུ་རྙེད་ནས་འདུག་གོ།",
    "བསགས་པའི་ནོར་རྫས་སྟོང་ཟད་མི་འདུག་གམ།",
    "ནམས་ཀྱང་མི་སྡོང་འཆི་བའི་ལས་སུ་འདུག།",
    "སེམས་ལ་སེམས་སུ་མ་མཆིས་ཞིང་རང་བཞིན་གྱི་འོད་གསལ་བའོ།",
    "ངང་དང་རང་བཞིན་ལ་རྒྱུན་ཆད་མེད་པ་ནི།",
    "དེ་བབས་ནས་སྟན་ལ་འདུག་པ་དང་།",
    "སྐྱེས་པའི་ཡིད་དུ་འོང་བ་ཞིག་འདུག་གོ།",
    "བལྟ་ན་སྡུག་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ཏེ་དེ་ཆུང་མ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "དེ་ཡང་དེར་འདུག་གོ།",
    "གལ་ཏེ་མཛའ་ཅན་མ་ལ་སྤྲོ་ན་ཁྱིམ་ན་འདུག་དང་།",
    "མཉན་པས་ཕ་རོལ་གྱི་འགྲམ་དུ་ཕུར་པ་ལ་གྲུ་བཏགས་ཏེ་འདུག་གོ།",
    "དེ་ནས་དགེ་སློང་མ་འགྲམ་དུ་འདུག་པ་རྣམས་ཀྱིས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཅི་བསྐད་ནས་ཕྱོགས་དང་ཡུལ་དུ་འདུག་ཏུ་མི་རུང་ངམ།",
    "ཚོང་པ་ལ་ཞག་དུས་བཏབ་ནས་རས་ཡུག་ཆེན་སར་པ་ཞིག་སྐྱིན་པོར་བླངས་ཏེ་བསྐོན་ནོ།",
    "བདག་ཅག་དུས་མ་ཡིན་པར་སྲ་བརྐྱང་མི་འབྱིན་ནོ།",
    "ཁྱེད་རང་ཅིའི་ཕྱིར་མི་མཛད།",
    "རིམ་ལྷག་མུ་སྟེགས་འདུག་གནས་སོ།",
    "དེ་འདུག་པ་ན་ཁྲིའི་རྐང་པས་ཁང་ཐོག་རྡོལ་བར་བྱས་ཏེ།",
    "དེ་ལ་འདུག་ནས་རྫས་ལས་བྱུང་བའི་གཞི་བདུན་གྱི་བསྔགས་པ་བརྗོད་ནས།",
    "འདུག་འགྲེང་གཅེར་བུར་ཟས་སྦྱིན་ནོ།",
    "དགུ་པ་ཉལ་ཤོམ་པའི་གནས་ལ་འདུག་པའི་གླེང་གཞི་ནི།",
    "དམག་ལ་བལྟ་ཞིང་དམག་ནང་འདུག།",
    "གཉིས་པ་དམག་ནང་དུ་འདུག་པའི་གླེང་གཞི་ནི།",
    "རྐུན་མ་ས་རྐོ་རིང་དུ་འདུག།",
    "དགུ་པ་རིང་དུ་འདུག་པའི་གླེང་གཞི་ནི།",
    "དེ་ཕྱི་ཉིན་དགེ་སློང་མ་རྣམས་དེར་འོངས་ནས་སྟན་ལ་འདུག་གོ།",
    "གསུམ་གྱི་ཚེ་འདུག་པར་ཤེས་ན་ལན་མང་ལྟ་ཅི་སྨོས།",
    "ཁ་ཅིག་འཇོལ་ཞིང་འདུག་པ་དང་།",
    "ཁྱིམ་ཐབ་བཟའ་མི་གཉིས་འཐབ་ཅིང་འདུག་པ་དང་།",
    "དེ་སེམས་ལས་བསྐྱུངས་ཏེ་འདུག་གོ།",
    "བསམ་གཏན་བཞི་ལ་ཞུགས་པ་བཞིན་དུ་ཅིའི་ཕྱིར་འདུག་གྲོགས་གྱིས་ཤིག།",
    "འཆར་ཀ་དང་སྦེད་མ་རབ་ཏུ་བྱུང་ནས་དབེན་པ་བླ་གབ་མེད་པར་འདུག་པ་དེ་གསོལ་བས།",
    "གནས་ཁང་དུ་ཞུགས་ནས་ཁྲི་སྟེང་དུ་འདུག་པ་དང་སྐྱེས་པ་དེ་ཡང་འགུལ་བར་བརྩམས་སོ།",
    "ཁྲིའུ་ལ་འདུག་ཕྱིས་གནོན་བྱེད།",
    "བཞི་པ་ཁྲིའུ་ལ་འདུག་པའི་གླེང་གཞི་ནི།",
    "དེར་གྲོང་རྡལ་གྱི་ཕྱེད་ན་འདུག་པ་དག་འོངས་ནས་དྲིས་པ།",
    "དེའི་མདུན་ན་འདུག་གོ།",
    "ནངས་པར་དེར་བྲམ་ཟེ་རྣམས་འདུག་གོ།",
    "བྲམ་ཟེ་གཙང་སྦྲ་འདོད་པ་ཡིན་པས་ཡིད་མི་བདེ་ཞིང་འདུག་པ་དང་།",
    "དཀུར་མི་བརྟེན་པར་ཁྱིམ་གྱི་ནང་དུ་འཇུག་པ་དང་འདུག་པ་སོགས་ལ་བསླབ་པར་བྱའོ་ཞེས་བཅས་པའོ།",
    "མ་བརྟག་གྱ་ཚོམ་བསྣོལ་ནས་འདུག།",
    "འདོམས་མི་སྦེད་པར་འདུག་པའོ།",
    "དང་པོ་མ་བརྟག་པར་སྟན་ལ་འདུག་པའི་གླེང་གཞི་ནི།",
    "གཉིས་པ་གྱ་ཚོམ་དུ་འདུག་པའི་གླེང་གཞི་ནི།",
    "སེར་སྐྱའི་གཞིར་འཆར་ཀ་ལ་བརྟེན་ནས་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ཕབ་སྟེ་འདུག་པར་མི་བྱའོ་ཞེས་བསླབ་གཞི་བཅའ་བ་མཛད་པ་དང་།",
    "དེ་ལྟར་འདུག་པར་མི་བྱའོ་ཞེས་བཅས་པའོ།",
    "གསུམ་པ་རྐང་པ་བསྣོལ་ནས་འདུག་པའི་གླེང་གཞི་ནི།",
    "དེ་དག་གཞན་གྱིས་ཁྱེད་ཅག་ཅིའི་ཕྱིར་དེ་ལྟར་འདུག།",
    "གཡོན་ཅན་དག་འདུག་གོ་ཞེས་སྨྲས་པས།",
    "བཞི་པ་བརླ་བསྣོལ་བའམ་བརྩེགས་ནས་འདུག་པའི་གླེང་གཞི་ནི།",
    "ཚོང་དཔོན་དག་འདུག་གོ་ཞེས་སྨྲས་པའི་སྐབས་དེ་བཅོམ་ལྡན་འདས་ལ་གསོལ་བས།",
    "འདུག་པར་མི་བྱའོ་ཞེས་བཅས་པའོ།",
    "འདུག་པར་མི་བྱའོ་ཞེས་བཅས་པའོ།",
    "དྲུག་པ་བཀུག་སྟེ་འདུག་པའི་གླེང་གཞི་ནི།",
    "བདུན་པ་བྱིན་པ་ཕྲལ་ཏེ་འདུག་པའི་གླེང་གཞི་ནི།",
    "བརྒྱད་པ་འདོམས་མི་སྦེད་པར་འདུག་པའི་གླེང་གཞི་ནི།",
    "འགྲེང་ཉལ་མཐོ་འདུག་རྒྱབ་ནས་འཆདོ།",
    "གསུམ་པ་སྟན་མཐོན་པོ་ལ་འདུག་པའི་གླེང་གཞི་ནི།",
    "བཅུ་དགུ་པ་ཤིང་རྟར་འདུག་པ་ལ་འཆད་པའི་གླེང་གཞི་ནི།",
    "ཕྱི་ཉིན་ཀུན་དགའ་ར་བ་སྲུང་མཁན་གྱི་མི་དེས་མཐོང་ནས་ཡིད་མི་བདེ་བར་འདུག་གོ།",
    "དེ་བབས་ནས་སྟན་ལ་འདུག་པ་དང་།",
    "ཉེར་བརྒྱད་པ་ཁྲིའུ་འདུག་པའི་གླེང་གཞི་ནི།",
    "འཇམ་པའི་སྟན་ལ་འདུག་ནས་ནི།"
  ]
}