    "ལྷག་མ་ཉིད་ནི་མ་རིག་པ་ཡིན་པས་སུན་དབྱུང་བ་མ་ཡིན་པར་བསྟན་པ་ནི་རང་རིག་ཅེས་བྱ་བའོ།",
    "ཅི་ལས་ཤེ་ན་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་སྟེ།",
    "འདིའི་རྣམ་པར་རྟོག་པ་ཡང་ཉམས་སུ་མྱོང་བའི་རྗེས་སུ་འགྲོ་ཞིང་གསུམ་ཀ་རྣམ་པར་གཞག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་ཅན་གྱི་ཐ་སྙད་འབྲས་བུ་ཡིན་གྱི་དེ་ཙམ་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་ཇི་སྟེ་ཞེས་བྱ་བའོ།",
    "རྟོག་པ་མེད་པའི་ཡུལ་རྣམ་པར་དཔྱད་པ་ལ་ཁྱེད་ལ་འབྲས་བུ་ཅི་ཡོད་ཅེས་ཟེར་བ་ལ་གང་ཚེ་ཕྱི་རོལ་ཞེས་བྱ་བའོ།",
    "དེའི་རྣམ་པ་ཅན་གྱི་འབྲས་བུའི་ཤེས་པ་གཞན་ཤེས་པར་བྱ་བའི་དོན་དུ་དེ་ཉིད་ནི་སྐྱེད་བྱེད་སྔ་མའོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་རྣམ་པ་མེད་པ་ཉིད་འཛིན་པར་བྱེད་པ་མ་ཡིན་པར་མཐོང་བར་འདོད་དོ།",
    "ཕན་ཚུན་རྗེས་སུ་འཇུག་པ་མེད་ན་རྡུལ་ཕྲ་རབ་ཀྱི་བར་དུ་ཐ་དད་པ་ཡིན་པས་མ་རིག་པར་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་འགའ་ཡང་ཞེས་བྱ་བའོ།",
    "ལྐོག་ཏུ་མ་གྱུར་པ་ཉིད་ཅེས་བྱ་བ་གཞན་དུ་བརྟག་པར་བྱ་བ་མ་ཡིན་པར་བསྟན་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "གཞན་བརྟག་པར་བྱ་བ་མ་ཡིན་པ་ནི་ཕྱི་རོལ་ལོ།",
    "སྔོན་པོའི་ནི་བློ་བཞིན་དུ་ལྐོག་ཏུ་མ་གྱུར་པའི་ཁོངས་སུ་གཏོགས་པ་ཡིན་ན་གཞན་གྱིས་ཅི་ཞིག་བྱ་བ་ཞེས་བསྟན་པ་ནི་མཐོང་བའི་ཁྱད་པར་ཞེས་བྱ་བའོ།",
    "ཞེན་པ་ཇི་ལྟར་མཐོང་བ་མ་ཡིན་པ་ནི་ཐོག་མ་མེད་པའི་བག་ཆགས་ལས་བྱུང་བས་ལོག་པར་འཛིན་པ་ཡིན་པར་བསྟན་པ་ནི་མཐོང་བ་གང་ཡིན་པ་དེ་ཉིད་ཅེས་བྱ་བའོ།",
    "སྣང་བའི་སྒོ་ནས་བསྟན་ནས་ཚོགས་པ་ཐ་མི་དད་པར་བསྟན་པ་ནི།",
    "གཞན་གྱི་རྒྱུ་ལ་ཡོད་པའི་ཕྱིར་ངའི་ཞེས་བྱ་བ་ནི་རྟོགས་པར་བྱེད་པ་པོའིའོ།",
    "ལྐོག་ཏུ་མ་གྱུར་པ་ཉིད་བཞིན་དུ་དེའི་བདག་ཉིད་ཀྱི་སྔོན་པོ་ཡང་ལྐོག་ཏུ་གྱུར་པར་བརྟགས་པ་མ་ཡིན་ཏེ།",
    "དུ་བའི་ཡུལ་དུ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་དུའོ།",
    "མཐོང་བ་ལས་ཐ་དད་པར་ཞེས་བྱ་བ་སྨོས་སོ།",
    "འཇུག་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་འཇུག་པར་བྱེད་པའི་མིའོ།",
    "དེའི་ཕྱིར་སྒྲོ་འདོགས་པས་སྒྲོ་བཏགས་པ་ཡིན་པར་བསྟན་པ་ནི་སྒྲོ་འདོགས་པ་དེ་ལྟ་བུ་ཞེས་བྱ་བ་སྟེ།",
    "ཉམས་སུ་མྱོང་བ་ལས་སམ་སྒྲོ་འདོགས་པ་ལས་ཀྱང་འཇིག་རྟེན་འཇུག་པར་མ་ཐོང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡུལ་མེད་པའི་སྒྲོ་འདོགས་པ་ནི་རིགས་པའི་ཕྱིར་མ་གཏོགས་པ་སྒྲོ་འདོགས་པའི་ཡུལ་མ་ཡིན་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ་དེ་ཞེས་བྱ་བའོ།",
    "སྒོ་འདོགས་པར་བྱ་བ་བཞིན་དུ་ཡུལ་ཡང་སྒྲོ་འདོགས་པར་བྱ་བ་རྟོགས་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "གཞན་གྱིས་སམ་རང་ཉིད་ཀྱིས་རྟོགས་པའི་ལྐོག་ཏུ་གྱུར་པ་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེས་ཟེར་བ་ལ།",
    "བག་ཆགས་ཡིན་པར་གང་བརྗོད་པ།",
    "གཞན་དོན་མེད་ཕྱིར་རྙེད་པར་དཀའ།",
    "གཞན་དོན་མེད་ཕྱིར་ཞེས་བྱ་བ་རྩོམ་པར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "ཡུལ་ལ་སོགས་པ་དང་དེའི་ཤེས་པ་ལ་ཡང་ཁྱད་པར་མེད་དོ།",
    "དེ་ཡང་ཡིན་ལ་ཁྱད་པར་གྱི་བག་ཆགས་ལ་སོགས་པ་ཡང་ཡིན་ནོ་ཞེས་སྦྱར་བར་བྱའོ།",
    "དེ་ཡང་མིག་ལ་སོགས་པའི་ཁྱད་པར་བག་ཆགས་ཀྱི་ངོ་བོའི་རྟོག་པའོ།",
    "དེ་མ་ཐག་པའི་རྐྱེན་གྱི་ཁྱད་པར་ཉིད་ཀྱི་བག་ཆགས་ཀྱི་ཁྱད་པར་གྱི་ངོ་བོ་ལས་ཡུལ་དང་དུས་དང་རྣམ་པ་ལ་སོགས་པ་ངེས་པ་ཡིན་གྱི།",
    "ཕྱི་རོལ་ལས་ནི་མ་ཡིན་པ་མ་མཐོང་བ་ཁྱད་པར་མེད་ན་ཇི་ལྟར་ཡིན་ཞེས་ཟེར་བ་ལ་ཇི་ལྟར་ཆགས་སོགས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་འབད་པ་མེད་ན་ཡང་ངོ།",
    "སེམས་པ་གཞན་པ་དེ་ལས་གཞན་པའི་སད་པར་བྱེད་པར་གང་དུ་ཡིན་ཞེས་ཟེར་བ་ལ་དཔེར་ན་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཁྱེད་ལ་ངེས་པར་བྱེད་པ་མེད།",
    "མཐོང་བ་ནི་མ་ངེས་པ་ཡིན་པས་ངེས་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི་ཐམས་ཅད་ཅེས་བྱ་བའོ།",
    "ཡུལ་ངེས་པ་ཅན་ལ་སོགས་པའི་ངེས་པར་བྱེད་པ་མེད་པའི་ཕྱིར་ཡུལ་མ་ངེས་པ་ལ་སོགས་པ་ཐམས་ཅད་སྣང་བར་འགྱུར་བ་ཡིན་པར་ཟེར་བར་བསྟན་པ་ནི།",
    "མི་སྣང་བ་ངེས་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་དོན་གྱི་རྣམ་པ་ཅན་གྱི་མཐོང་བ་ཉིད་ནི་ངེས་པར་བྱེད་པ་ཡིན་དུ་ཟིན་ཀྱང་དོན་ནི་མ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་སྣང་བ་ལ་ནི་སྔ་མའི་དོན་ཡང་མཚུངས་པ་ཡིན་པར་བསྟན་པ་ནི་སྣང་བ་དོན་གྱི་ཞེས་བྱ་བའོ།",
    "སྔོན་གྱི་སྣང་བ་འདི་ལ་སྣང་བ་མ་ཡིན་པར་བསྟན་པ་ནི་སྣང་བ་ནི་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་མི་སླུ་བ་མེད་པས་དེར་འབྲེལ་པ་མ་ཡིན་ཞིང་འོན་ཀྱང་གནོད་པར་བྱེད་པ་མེད་པའི་ཕྱིར་གལ་ཏེ་གང་ཞིག་ཅེས་བྱ་བའོ།",
    "ཕྱི་རོལ་དུ་རྟོག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "བྱིས་པའི་ཞེས་བྱ་བ་སྟེ་ཕྱི་རོལ་གྱི་བྱིས་པ་ཡོད་པ་དེའི་ཕྱིར་ཕྱི་རོལ་དང་འདི་ན་དང་འདིའོ་ཞེས་འཛིན་པར་བྱེད་པའི་ཆ་ལས་ཐ་དད་པའི་རིག་བྱ་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པ་མངོན་སུམ་ལ་སོགས་པས་བསྟན་པ་ཡིན་ནོ་ཞེས་བྱ་བ་སེལ་བ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་མཐོང་བ་ཡང་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "འདིར་བདག་ཡིན་ནོ་ཞེས་ཐ་སྙད་གདགས་པར་བྱ་བ་དེའི་བྱེད་པ་ནི་བྱ་བ་ཡིན་ལ་ཤེས་པ་ནི་དེའི་འབྲས་བུ་ཉམས་སུ་མྱོང་བ་ལས་གཞན་དུ་མི་འཐད་པ་ཡིན་པའི་ཕྱིར།",
    "རྣམ་པར་རྟོག་པ་ནི་དྲན་པ་ཡིན་ལ་ཉམས་སུ་མྱོང་བའི་རྗོད་བྱེད་ལ་སོགས་པ་དང་སྦྱོར་བའི་ཉམས་སུ་མྱོང་བའི་ཡུལ་ཏེ།",
    "ངོ་ཤེས་པར་ནི་འགྲུབ་མི་འགྱུར།",
    "ཐ་དད་པར་ངེས་པ་ཡིན་ན་ནི་དེ་ལྟར་མི་འགྱུར་ཏེ།",
    "འདི་སྔོན་པོའོ་ཞེས་བྱ་བའི་ཤེས་པ་ལ་ཕྱི་རོལ་དུ་ངེས་པར་རྟོགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "ར་ཞིག་སྔོན་པོ་ཉིད་ལས་ཉིད་ནི་རྣམ་པར་རྟོག་པ་ལ་སྣང་བ་མ་ཡིན་པར་བསྟན་པ་ནི་ཐ་དད་པར་ཞེས་བྱ་བའོ།",
    "སྔོན་པོའོ་ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་ནི་བརྫུན་པ་ཡིན་ཏེ།",
    "འབད་པ་ཆེན་པོས་བསྒྲུབ་པར་བྱ་བའི་ཕྱི་རོལ་འགྲུབ་ན།",
    "རྣམ་རིག་རྒྱུ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རིག་པ་དང་དུས་མཚུངས་པ་མ་ཡིན་པ་ཉིད་རྫོགས་པའི་རྒྱུའོ།",
    "རྒྱུ་ནི་རྣམ་པར་རིག་པའིའོ།",
    "གནོད་པ་མེད་པའི་ཕྱིར་འགལ་བ་མེད་པ་ན་ཡང་ཕྱི་རོལ་ཐོབ་པར་འགྱུར་བ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཉམས་སུ་མྱོང་བ་ཇི་ལྟ་བཞིན་དུ་ངེས་པར་ཁས་ལེན་པ་ཡིན་ཡང་ཕྱི་རོལ་མ་ཡིན་ཏེ།",
    "འདོད་པའི་བདག་ཉིད་རིག་པ་དང་དོན་རིག་པ་དག་ཐ་མི་དད་པ་ཡིན་ནོ་ཉེ་བར་བཏགས་པའི་ཁྱད་པར་ཡོད་ན་སྒྲོ་བཏགས་པ་ཡིན་ལ།",
    "རང་རིག་པ་ཉིད་ཀྱིས་གཉི་ག་གྲུབ་པར་ཡོངས་སུ་གཟུང་བའི་ཕྱིར།",
    "བདེ་བ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བ་ཡང་ཐོབ་པར་མི་འགྱུར་བའི་ཕྱིར་ཐམས་ཅད་བདེ་བ་ཉིད་ཡིན་པས་ཇི་ལྟར་ཐ་དད་མ་ཡིན་པའོ།",
    "རྣམ་པ་གཉི་གའི་བདག་ཉིད་ཀྱིས་གོ་རིམས་བཞིན་དུ་གཉི་ག་མེད་པར་འགྱུར་རོ།",
    "གོ་རིམས་ཇི་བཞིན་མ་ཡིན་པར་འགྱུར་བར་བསྟན་པ་ནི།",
    "ངོ་བོས་ནི་མ་ཡིན་ཞིང་ཉམས་སུ་མྱོང་བར་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟ་དེ་ལྟ་ཡིན་དུ་ཆུག་ཀྱང་རྣམ་པ་ཐམས་ཅད་དུ་དོན་དེ་ཉིད་ཁོ་ན་ཡིན་པར་གོ་རིམས་བཞིན་དུ་སྟོན་པ་མ་ཡིན་ན་ཡང་དབྱེ་བ་མེད་དོ།",
    "རྣམ་པར་རིག་པར་སྨྲ་བ་ཡང་དོན་བཞིན་དུ་ཁས་ལེན་པ་ཙམ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་སྨྲ་བ་ཞེས་བྱ་བའོ།",
    "འདོད་པ་ནི་རིག་པར་རོ།",
    "ཐ་དད་པར་ནི་དུ་མའི་བདག་ཉིད་དུ་སྟེ་ལས་སུ་སྒྲུབ་བྱེད་ཡིན་པའི་ཕྱིར་རྣམ་པ་གཉིས་པོ་དག་ལས་གཅིག་ཉམས་སུ་མྱོང་ན་ཅིག་ཤོས་ཀྱང་ཉམས་སུ་མྱོང་བར་འགྱུར་རོ།",
    "དངོས་པོའི་དོན་ཏོ་ཞེས་བྱ་བ་ནི་བག་ཆགས་ཀྱི་ཁྱད་པར་ཕྱི་རོལ་དུ་ངེས་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངེས་པར་བཟུང་བས་ནུས་པར་འགྱུར།",
    "པར་མི་འགྱུར་བ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཐ་མི་དད་པ་སྟེ་ངེས་པ་མེད་པས་རྣམ་པ་ཐམས་ཅད་ཀྱི་ཤེས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་དབྱེ་བའོ།",
    "ཐ་དད་པར་ཁས་བླངས་ཀྱང་སྟེ་དོན་ནི་སྔ་བ་ཡིན་ལ་ཤེས་པ་ནི་འཕྱི་བ་ཡིན་ནོ།",
    "རིག་བཞིན་པའི་དོན་གྱིས་བསྒྲིབས་པས་རིག་པར་མི་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་རྟོགས་མི་འགྱུར་ཞེས་བྱ་བའོ།",
    "དེ་ཡོད་ཀྱང་འཛིན་པར་འདོད་པ་མ་ཡིན་ན་མི་རིགས་པའི་ཕྱིར་རོ།",
    "འགྲེལ་པར་ནི་དོན་གྱི་རྣམ་པ་གཅིག་ཤེས་པ་ན་རྣམ་པ་གཞན་བསྒྲིབས་པ་ཡིན་པ་ལ་བརྒལ་བའི་བསལ་བས་དེ་ལྟ་ན་དོན་ཇི་ལྟ་བ་བཞིན་དུ་རིག་པར་མི་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི་གཅིག་ཏུ་སྟེ་དོན་གྱིའོ།",
    "རབ་རིབ་ནི་ཟླ་བ་གཅིག་ལ་རྣམ་པ་གཉིས་སུ་མཐོང་བར་བྱེད་པས་བརྫུན་པ་ཡིན་པ་དེ་བཞིན་དུ་མ་མཐོང་བ་ཡང་གཅིག་ཉིད་ལ་གཉིས་ཀྱི་རྣམ་པར་རོ་ཞེས་བསྟན་པ་ནི།",
    "མེད་པ་མཐོང་བར་མི་ནུས་པ་ནི་ཡོད་པ་བསྒྲིབས་པ་དང་མཚུངས་པ་ཡིན་པར་བསྟན་པ་ནི་རུང་བའི་ཡུལ་ན་ཞེས་བྱ་བའོ།",
    "ཡོད་པ་ལ་དམིགས་པའི་བདག་ཉིད་ཀྱིས་ལོངས་སྤྱོད་པ་གཞན་དུ་མི་འཐད་པས་རྟོགས་པར་བྱ་བའི་མ་མཐོང་བ་ནི་ལོངས་སྤྱོད་པའི་བདག་ཉིད་མ་ཡིན་པ་བསྒྲིབས་པའི་འབྲས་བུར་མི་འཐད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ལ་ཞེས་བྱ་བ་སྟེ་ཇི་ལྟར་རིག་པར་བྱེད་པ་ཡིན་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ལས་ནི་ལས་གཞན་དང་འབྲེལ་པས་རང་ཉིད་ཀྱིས་ཉམས་སུ་མྱོང་བ་སྐྱེད་པར་བྱེད།",
    "འབྲས་བུ་དེའི་རྗེས་སུ་འགྲོ་བ་ལ་སོགས་པའི་རྗེས་སུ་བྱེད་པར་ཉམས་སུ་མྱོང་བ་མེད་པའི་ཕྱིར།",
    "དེ་ལྟ་བུའི་མཐོང་བ་ནི་རིག་པའི་བདག་ཉིད་ཀྱིས་དོན་གྱི་སྐྱེད་བྱེད་ཉིད་ཡིན་གྱི་རིག་པ་མ་ཡིན་པ་རིག་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི་གྲུབ་པ་ཉིད་ཅེས་བྱ་བའོ།",
    "ཕྱིའི་དོན་ལ་ཡང་ཞེས་བྱ་བ་ཡང་ཞེས་བྱ་བ་ནི་ཐ་དད་པར་ཁས་ལེན་པ་ནའོ།",
    "ཇི་ལྟར་རིག་པས་ནི་རིག་པ་ཁོ་ནར་འགྱུར་ན་ཐ་དད་པ་ལས་དོན་རིག་པར་ཇི་ལྟར་འགྱུར་ཞེས་ཟེར་བ་ལ་འདི་ལ་ཡང་ཉམས་སུ་མྱོང་བའི་རང་རིག་པ་ལ་ཤེས་པའི་ཉམས་སུ་མྱོང་བ་བོར་ནས་ཕྱི་རོལ་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ནི་ཉེ་བར་མཚོན་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྣམ་པ་ཐ་དད་པ་མེད་པའི་ངོ་བོ་ཡིན་པས་འཛིན་པའི་རྣམ་པ་ནི་རྣག་རིག་པར་རུང་བའི་ངོ་བོར་ཐ་མི་དད་ཀྱང་ཉེ་བར་བཏགས་པ་ཉིད་ཀྱིས་རྣམ་པར་གཞག་པར་ཅིའི་ཕྱིར་མི་བྱེད་ཅེས་བྱ་བ་ལ་ཀུན་ལ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "སྔོན་པོ་ཞེས་དོན་གྱི་ཁྱད་པར་གྱི་ངེས་པ་བྱུང་བ་ནི་ཉམས་སུ་མྱོང་བའི་ཆའི་ཁྱད་པར་སྔར་ཉམས་སུ་མྱོང་བ་ལ་རག་ལས་པ་ཡིན་གྱི་ཉམས་སུ་མྱོང་བའི་བདག་ཉིད་ཀྱི་རང་མཚན་ཉིད་ཀྱིས་དབྱེ་བ་ལ་རིག་པའམ་ངེས་པ་ལ་ཁྱད་པར་དུ་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཡིན་ཞིང་ཡོད་པ་ཙམ་གྱིས་ཀྱང་ཁྱད་པར་མེད་པ་མ་ཡིན་ཏེ་ངོ་བོ་ལ་དབྱེ་བ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་ཁྱད་པར་མེད་ན་རིག་པར་བྱ་བ་མ་ཡིན་ལ།",
    "རིག་ན་ཡང་རྣམ་པའི་ཁྱད་པར་ཐོབ་པར་འགྱུར་བ་དེའི་ཕྱིར།",
    "རྣམ་པ་ནི་རང་ལས་ཐ་དད་པ་མེད་པས་དོན་རིག་པར་སྒྲོ་བཏགས་པ་མ་ཡིན་ཏེ།",
    "དོན་དང་ཤེས་པ་དང་དེ་དག་དང་འབྲེལ་པ་ཅན་གྱི་བློ་ནི་མ་ཡིན་ཏེ་ཉམས་སུ་མྱོང་བ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "མངོན་སུམ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཐབས་ཡིན་པ་དང་དང་པོར་རིག་པར་ཁས་བླངས་པ་ནི་མ་ཡིན་ནོ།",
    "དོན་རིག་པའི་ཡང་ངེས་པར་བྱེད་པའི་ངེས་པར་བྱེད་པ་གཅིག་པ་ཉིད་དུ་སྒྲོ་བཏགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྒྲུབ་བྱེད་ནི་ངེས་པ་ཅན་གྱི་ངེས་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "རྣམ་པས་བྱས་པའི་རིག་པས་རྣམ་པ་གཞན་མི་གནས་པ་སྟེ།",
    "ངེས་པར་འགྱུར་བ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་ཇི་ལྟར་དོན་དེ་ནི་གནས་པ་ཞེས་བྱ་བ་སྟེ།",
    "རྣམ་པར་འཇོག་པའམ་ཐ་སྙད་ལས་སོ་ཞེས་བྱ་བ་ཡང་ངོ།",
    "དེའི་ཕྱིར་རྣམ་པར་རིག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཕྱི་རོལ་གནས་པའི་ཕྱིར་ཡུལ་ཐ་དད་པ་མ་ཡིན་ནོ།",
    "ཤེས་པ་དང་ཤེས་པ་མ་ཡིན་པ་ཉིད་གཞན་དུ་རྣམ་པར་དབྱེ་བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་གལ་ཏེ་ན་ཞེས་བྱ་བའོ།",
    "དོན་ནོ་ཞེས་ངེས་པར་རིག་པར་བྱེད་པའི་ཤེས་པ་ནི་དོན་གྱི་འབྲས་བུ་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟར་སྣང་བ་ཞེས་བྱ་བ་སྟེ།",
    "སྔོན་པོ་ལ་སོགས་པ་རྣམ་པ་ཉིད་ཀྱི་དོན་ནོ་ཞེས་པ་ཉིད་ཀྱི་ཕྱིར་འཛིན་པར་བྱེད་པ་ཉིད་བཞིན་དུ་འབྲས་བུ་ཉིད་ཀྱང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངེས་པར་རྣམ་པར་འཇོག་པར་མི་བྱེད་པའི་ཕྱིར་ངེས་པར་གཟུང་བའི་དོན་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དོན་ཙམ་ལ་ངེས་པ་ཡིན་གྱི་ཁྱད་པར་ལ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "ཁྱད་པར་བཞིན་དུ་དེ་ཙམ་ཡང་ངེས་པ་ནི་རྣམ་པར་འཇོག་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བ་སྟེ།",
    "སྨིག་རྒྱུ་ལ་ཆུར་སྣང་བ་ནི་ཆུའི་བག་ཆགས་ཀྱི་རྒྱུ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་ལོག་པར་རྟོགས་པ་མེད་དེ།",
    "ཁས་བླངས་བ་སྒྲུབ་པར་བྱེད་པ་ནི་དོན་ཉེ་བར་གནས་པའི་ཞེས་བྱ་བའོ།",
    "དེའི་དུས་ཉིད་ནི་མེད་པའི་བག་ཆགས་ལས་བྱུང་བ་ཡིན་པར་བསྟན་པ་ནི་ཡུལ་གཞན་ཡང་ཞེས་བྱ་བའོ།",
    "ཡུལ་དང་དུས་ཀྱི་ངེས་པ་མེད་ན་དངོས་པོ་ཞེས་བྱ་བ་མེད་པར་བསྟན་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཡུལ་ལ་སོགས་པ་རྣམ་པར་མ་བཅད་པའི་དངོས་པོ་ཡོད་པ་ཡིན་ཏེ།",
    "རང་ཉིད་ཀྱིས་མཐོང་བ་ཉིད་དུ་ཁྱད་པར་མེད་པས་ཐམས་ཅད་ལ་ཐམས་ཅད་སྣང་བར་འགྱུར་བར་བསྟན་པ་ནི་མ་མཐོང་བར་ཡང་ཞེས་བྱ་བ་སྟེ་དོན་ཐམས་ཅད་ཅེས་བྱ་བར་སྦྱར་རོ།",
    "གནས་སྐབས་ཀྱི་ཁྱད་པར་ཡིན་ཟེར་བ་ནི་རབ་རིབ་ལ་སོགས་ཞེས་བྱ་བའོ།",
    "གཉི་ག་ལ་ཡང་ཞེས་བྱ་བ་ནི་རུང་བའི་ཡུལ་ན་གནས་པ་མ་གཏོགས་པར་མ་མཐོང་ངོ་ཞེས་བྱ་བའི་རྒོལ་བ་པོ་དག་ནི་ནུས་པ་མ་གཏོགས་པར་རོ།",
    "དོན་ཉིད་ཅེས་བྱ་བ་ནི་དོན་བྱེད་པར་ནུས་པ་ཉིད་དོ།",
    "དེ་ཉིད་དུ་ཡོད་པ་ལས་གནོད་པར་བྱ་བ་ཉིད་དམ་སླུ་བ་ཉིད་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་ནི་རབ་རིབ་ལས་གཞན་པ་ལས་སོ།",
    "མེད་པར་ཐེ་ཚོམ་ཟ་བ་ནི་ཕྲད་པའི་ཤེས་པ་ལ་ཡང་མཚུངས་ཏེ།",
    "ཁྱད་པར་མ་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་ཅི་ལྟར་ཞེས་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནི་མི་རིགས་པར་བསྟན་པ་ནི་འོན་ཏེ་རྒྱུ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཤེས་པ་ཅན་གྱི་བསྐྱེད་བྱ་ཉིད་དུ་ཉེ་བར་ལེན་པ་ཐ་མི་དད་པ་ནི་རྣམ་པར་རྟོག་པ་དང་ཅིག་ཤོས་དག་ངེས་པ་མེད་པ་དང་ཅིག་ཤོས་སུ་འཛིན་པ་དག་ལ་ཅིག་ཅར་ཉེ་བར་བླང་བ་ཉིད་དུ་འགལ་བ་ཡང་མ་ཡིན་ཏེ།",
    "བག་ཆགས་ཀྱི་ཁྱད་པར་ཉེ་བར་ལེན་པའི་ཕྱིར་བདེ་བ་དང་སྡུག་བསྔལ་ལྟ་བུར་ལེན་གདབ་པར་སླ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཐོག་མེད་འབྲེལ་པ་ཡིན་པར་ནི།",
    "རང་བཞིན་ཉིད་ཅེས་བྱ་བ་ནི་གཞན་མ་ཡིན་པའི་ཕྱིར་འབྲེལ་པ་མེད་ན་དེས་བྱས་པའི་འབྲེལ་པ་ཅན་མེད་པར་བསྟན་པ་ནི་འབྲེལ་པ་དང་འབྲེལ་པ་ཅན་དག་ཅེས་བྱ་བའོ།",
    "ཕྱི་རོལ་གྱི་ཚུལ་ལ་ཡང་འདི་ལས་འདི་སྐྱེའོ་ཞེས་ངེས་པའི་རྟེན་ཡོད་པ་ནི་སྔ་མ་དང་ཕྱི་མའི་ཁྱད་པར་དང་བཅས་པ་ནི་དུས་ཀྱིས་བྱས་པ་ཡིན་ཡང་རྟོག་པ་མེད་ན་གོ་བ་མ་ཡིན་པར་བསྟན་པ་ནི་བག་ཆགས་དང་འབྲེལ་པ་ཞེས་བྱ་བ་སྟེ།",
    "དྲན་པ་མེད་པ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་ལ་རྣམ་པར་རྟོག་པ་གཞན་དེ་ཉིད་དུ་རྣམ་པར་འཇོག་པ་ཡིན་པར་བསྟན་པ་ནི་དེ་ལ་ཡང་ཞེས་བྱ་བའོ།",
    "ཕྱི་རོལ་ན་ཡང་འབྲས་བུ་ལ་སོགས་པ་དེ་ཉིད་དེ་ལྟ་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟ་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "དངོས་པོ་ནི་རྣམ་པར་འཇོག་པར་བྱེད་པ་རྟོག་པར་བྱེད་པ་ཡིན་ཡང་རྣམ་པར་རྟོག་པའི་གོ་བྱ་ཡང་འབྲས་བུའི་དུས་ལས་འདས་པ་བཞིན་དུ་ཡུན་རིང་པོར་འདས་པ་ཡང་ཡིན་ཏེ་རྟོག་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཡང་གལ་ཏེ་ནུས་ན་དེའི་ཚེ་ཉིད་བྱེད་པར་འགྱུར་ལ།",
    "ཤེས་པ་ཉིད་ཡིན་པར་བསྟན་པ་ནི་རྒན་པོས་ཞེས་བྱ་བའོ།",
    "འབྲས་བུ་ཉིད་བག་ཆགས་ལས་བྱུང་བ་ཉིད་ཀྱིས་ཁྱབ་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "འབྲས་བུའི་འགལ་བ་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟ་མིན་ན་ཞེས་བྱ་བའོ།",
    "ལུང་ཕོགས་པ་ལས་དེ་ཡང་རྟོགས་པ་ཡིན་པར་ཟེར་བ་ནི།",
    "མི་སྡུག་པ་སྟེ་གཤའ་མ་མ་ཡིན་པ་བྱེད་པ་ཅན་གྱི་ལས་ཡིན་ལ་དེ་ལས་སྐྱེས་པ་ཡིན་པར་ཁས་བླངས་པས་དེ་བྱེད་པ་ཅན་ལས་ཀྱི་སྒོ་ནས་ཕྱིན་ཅི་ལོག་ཏུ་བྱེད་པ་ཡང་རྟོག་པ་དང་མི་ལྡན་པ་ཉིད་ལ་ངེས་པ་ཡིན་པར་བསྟན་པ་ནི་ཅི་རུང་བར་ནི་ཞེས་བྱ་བ་སྟེ།",
    "ཞེས་བྱ་བས་བར་མ་ཆོད་པར་སྐྱེད་པར་བྱེད་པ་ཉིད་མི་རིགས་ཏེ་གཟུགས་ཀྱིས་གཟུགས་བཞིན་དུ་སྣམ་བུ་ལ་ཡང་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་སེལ་བ་ནི་རྗེས་སུ་འགྲོ་བ་ལ་སོགས་པའི་རྗེས་སུ་བྱེད་པ་ཅན་པར་དུ་ཆོད་པའི་ཕྱིར་རོ་ཞེས་དགོངས་པས་སོ།",
    "ཞེས་བྱ་བ་ནི་ལེགས་པར་སྨྲས་པ་མ་ཡིན་ནོ།",
    "ཤེས་པ་དོན་འཛིན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ལེགས་པར་བྱས་པ་མ་ཡིན་ནོ།",
    "ཐ་སྙད་ཅེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའམ་སྒྲ་ལ་སོགས་པ་ཡང་ངོ།",
    "རྣམ་པར་དབྱེར་མེད་ནི་ཐམས་ཅད་རང་རིག་པ་ཙམ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕྱིན་ཅི་ལོག་རྣམས་ཀྱིས་ཞེས་བྱ་བ་ནི་ཕྱིན་ཅི་ལོག་པའི་རྣམ་པར་རྟོག་པ་ཡིན་ཏེ།",
    "རང་རིག་པ་ལས་འཁྲུལ་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "ཅེས་བྱ་བ་ནི་འཇིག་པར་མཚུངས་པའི་དུས་ཉིད་ཀྱིས་དེའི་རྒྱུ་ཉིད་མེད་པས་གཞན་དུ་ཡོད་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་མི་རིགས་སོ།",
    "གཞན་གྱིས་མཐོང་བ་གང་ཡིན་པ་དེ་ངས་མཐོང་ངོ་ཞེས་བྱ་བ་ལ་རྗེས་སུ་དཔག་པར་འགྱུར་རོ་ཞེས་ཟེར་བ་ནི་འོན་ཏེ་དེ་ཡང་སྟེ་གཞན་ཡང་ངོ།",
    "མཐོང་བ་ནི་མངོན་སུམ་གྱིས་འདྲེས་པར་འགྱུར་བ་སྟེ་གཅིག་ཉིད་དུ་དེ་ལྟ་མ་ཡིན་ན་གཅིག་ཉིད་དུ་མངོན་སུམ་གྱིས་རྟོགས་པའོ།",
    "གཞན་གྱིས་མཐོང་བ་ཉིད་ནི་སྣང་བའི་རང་བཞིན་ཡིན་པས་སྣང་བ་བཞིན་དུ་སྣང་བ་མི་དམིགས་པ་ལས་བ་ནི་རྣམ་པར་རྟག་པར་བྱ་བའི་བདག་ཉིད་ཀྱིས་སོ།",
    "སྣང་བ་མི་དམིགས་པ་ལ་ཐེ་ཚོམ་མེད་པར་བསྟན་པ་ནི་དེ་ལྟ་ན་ནི་འོ་ན་ཞེས་བྱ་བའོ།",
    "གཅིག་ཉིད་ལ་ཡང་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ཞེ་ན་ཞེས་བྱ་བ་ནི་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྣང་འདིར་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟག་པར་བྱ་བའི་བདག་ཉིད་ཀྱིས་སོ།",
    "དེ་ནི་ཕྲད་པར་བྱ་བའོ།",
    "ཡོད་པར་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉེ་བར་མཚོན་པའི་ཕྱིར་རོ།",
    "འདུས་བྱས་པའི་ཁྱིམ་ལ་སོགས་པ་ཡང་ངོ།",
    "དེ་ལྟར་མཐོང་བ་མིན་ན་སྔ་ན་ཡོད་པར་རོ།",
    "རྟོགས་པར་འགྱུར་བ་མིན་པ་ཞེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་སོ།",
    "མངོན་སུམ་གྱིས་བསྒྲུབ་བྱ་ཤེས་ན་དེ་དང་འབྲེལ་པ་ཤེས་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ཡིན་པར་བསྟན་པ་ནི་ངེས་ན་ཞེས་བྱ་བའོ།",
    "རྗེས་སུ་དཔག་པ་ཙམ་ནི་འབྲེལ་པ་མི་ཤེས་པའི་ཕྱིར་ཕན་ཚུན་བསྟེན་པར་བརྗོད་དོ་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པ་ཞེས་བྱ་བའོ།",
    "འདམ་བུའི་ཕུང་པོ་གཉིས་ལུས་དང་སེམས་ཀྱང་གཞན་ལས་ཡོད་པ་གྲུབ་པ་ནི་ཕན་ཚུན་བསྟེན་པ་ཡིན་གྱི་མ་གྲུབ་བ་ཡོད་པ་ཅན་མ་ཡིན་པར་བསྟན་པ་ནི་ཕན་ཚུན་བསྟན་པའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་ཐོག་མ་མེད་པ་ཅན་གྱི་དེ་ལྟ་བུར་གྱུར་པའི་རྗེས་སུ་དཔག་པ་ཞེས་བྱ་བ་སྟེ་རྣམ་པར་རྟོག་པ་ནི་རྣམ་པར་རྟོག་པའི་བག་ཆགས་ལས་རྗེས་སུ་བྱུང་བའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་ཞེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ག་ལས་ཤེས་ན་ཞེས་བྱ་བ་ནི་འཁྲུལ་པ་ལ་ཡང་གཟུང་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་མ་སྤངས་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྣམ་པ་མ་གཏོགས་པར་ཕྱི་རོལ་སྣང་བ་མ་ཡིན་པའི་ཕྱིར།",
    "གཉི་ག་ཞེས་བྱ་བ་དེ་དག་ཙམ་གྱིས་བཟུང་བ་དང་ཅིག་ཤོས་མ་ཡིན་པར་བསྟན་པ་ནི་སྔགས་དང་རྒྱུད་ལ་སོགས་པ་ཞེས་བྱ་བའོ།",
    "ཕྱི་རོལ་སྣང་བ་ལ་འཁྲུལ་པ་ཉིད་ནི་གནོད་པར་བྱེད་པའམ་མེད་པར་ཡང་མ་ཡིན་ལ།",
    "དེ་ཁོ་ན་བཞིན་དུ་ཞེས་བྱ་བ་ནི་རིག་པར་བྱེད་པའོ།",
    "མ་ཡིན་ཏེ་རྗེས་སུ་དཔག་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་དཔྱད་པའོ།",
    "འོན་ཏེ་དཔྱོད་པའི་བདག་ཉིད་ཀྱི་རྣམ་པར་རྟོག་པས་ཕྱི་རོལ་རྣམ་པར་གཞག་པར་བྱེད་ན་དེ་བཞིན་དུ་ཕྱི་རོལ་མ་ཡིན་པ་ཡང་ཡིན་པ་འགལ་བར་བསྟན་པ་ནི་བཟློག་པ་ལ་ཡང་རྗེས་སུ་དཔག་པ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་ཕྱི་རོལ་མི་དམིགས་པ་ལས་བྱུང་བའོ།",
    "ཤེས་པ་བོར་ནས་དེ་ལས་གཞན་རྗེས་སུ་རྟོགས་པར་བྱེད་ན།",
    "ཐ་དད་པར་འགྱུར་བ་དེའི་ཕྱིར་གཟུང་བ་ཉིད་ནི་ལྐོག་ཏུ་གྱུར་པའི་ངོ་བོ་ལས་གཞན་མ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པ་རྟོགས་ན་བཟློག་པ་ལ་ཡང་ཡིན་པར་བསྟན་པ་ནི་བཟློག་པ་ལ་ཡང་ཞེས་བྱ་བ་སྟེ་འགལ་ལོ་ཞེས་བྱ་བའི་དོན་ནོ།",
    "དེ་ཉིད་དང་གཞན་ཉིད་འདི་ལ་ཁྱད་པར་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཟུང་བའི་རྣམ་པ་ལས་གཞན་པ་གཟུང་བ་མ་ཡིན་གྱི་གཟུང་བ་དང་གཟུང་བ་མ་ཡིན་པའི་རྣམ་པ་ཡང་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་བཞིན་དུ་འདི་ནི་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་འགའི་ཡང་སྒྲུབ་བྱེད་ཡིན་ཞེས་ཟེར་བ་ལ་ཡང་ན་ཞེས་བྱ་བ་སྟེ་རྟོག་པས་བྱས་པ་ཉིད་ནི་མི་སླུ་བ་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་དངོས་སུ་བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྗེས་སུ་དཔག་པ་ནི་དེའི་ངོ་བོའི་རྣམ་པར་འཇོག་པར་བྱེད་པར་ཐ་དད་པར་མཐོང་བར་བྱེད་པ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་རྗེས་སུ་དཔག་པ་ཡང་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "གཞན་ལ་ཐ་མི་དད་པར་རྣམ་པར་འཇོག་པར་བྱེད་ན་རང་ཉིད་ལ་ཡང་མཚན་ཉིད་མཚུངས་པའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཐོང་བའི་བྱེད་པ་དང་ཅིག་ཤོས་ཀྱི་རྗེས་སུ་འབྲངས་པ་ལས་རྣམ་པར་དབྱེ་བ་བསྟན་པ་ནི་གཟུང་བ་འཛིན་པ་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་རྗེས་སུ་སྣང་བཞིན་པ་ནི་མཐོང་བའི་རྗེས་སུ་འབྲང་བའི་རྣམ་པར་རྟོག་པ་ལས་མ་འདས་པས་སོ།",
    "གཟུང་བ་དང་རིག་པ་རྣམ་པར་རིག་པ་ནི་གཞལ་བྱ་ལ་སོགས་པའི་བདག་ཉིད་རྣམས་སོ།",
    "དེས་བྱས་པ་ཡང་ཡུལ་ཉེ་བར་གཞག་པ་དང་།",
    "ཤེས་པ་ཉིད་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ་ཡིན་ཡང་དེ་མ་ཡིན་པ་ལས་ལོག་པས་གཅིག་ཏུ་ཞེན་པ་ཡིན་ཏེ།",
    "མངོན་སུམ་གྱི་ཡུལ་ཡིན་པའི་ཕྱིར་གཞན་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟ་མིན་ན་ཞེས་བྱ་བ་སྟེ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཡང་རྣམ་པར་དབྱེ་བ་དང་ལྡན་པ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་ཐ་དད་མེད་པ་ནི་གཅིག་ཉིད་དོ།",
    "གཞན་གྱི་ཐ་མི་དད་པའི་རང་བཞིན་མཐོང་བ་མེད་པའི་ཕྱིར་ཐ་མི་དད་པར་ཉམས་སུ་མ་མྱོང་བའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་པ་ཚུལ་ལ་ནི་སྔོན་པོ་ལ་སོགས་པ་ཡང་ཤེས་པ་ལས་ཐ་མི་དད་པ་ཉམས་སུ་མྱོང་བའི་ཕྱིར་དེ་དང་རྗེས་སུ་མཐུན་པར་ངེས་པ་ཡིན་པར་བསྟན་པ་ནི་བློས་དངོས་ཐ་དད་མེད་ཅེས་བྱ་བའོ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་རང་བཞིན་ཐ་དད་པར་སྣང་བས་ན་ཞེས་བྱ་བའོ།",
    "བདག་ཉིད་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི་གསལ་བའི་རང་བཞིན་ཉིད་ཅེས་བྱ་བའོ།",
    "མེད་པ་ཉིད་ཀྱི་ཕྱིར་གནོད་བྱ་ཉིད་མི་འགྲུབ་པར་བསྟན་པ་ནི་འདི་ནི་འཁྲུལ་པ་ཞེས་བྱ་བའོ།",
    "མེད་པར་མ་ངེས་པ་ལས་ཀྱང་སྔོན་པོ་ལ་སོགས་པའི་ཁྱད་པར་གྱི་སྣང་བ་ལྡོག་པའི་ཕྱིར་རྣལ་འབྱོར་པ་འཇུག་པར་མི་འགྱུར་བར་བསྟན་པ་ནི་འཁྲུལ་པར་ངེས་པ་ལ་ཞེས་བྱ་བའོ།",
    "གཉི་གའི་བདག་ཉིད་འགལ་བ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི་གཅིག་ནི་ཡོད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ།",
    "རྟོགས་པའི་མཐར་ཐུག་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "བསྒོམས་པ་ལས་བྱུང་བ་ཉིད་ནི་ཅིའི་ཕྱིར་མི་བདེན་ཞེས་ཟེར་བ་ལ་བཟློག་པར་ནུས་པའི་ཕྱིར་ན་ཞེས་བྱ་བའོ།",
    "བཟློག་པར་ནུས་པ་ནི་མི་བདེན་པ་ཡིན་ཏེ།",
    "དབྱེ་བ་མེད་པར་རིག་པ་ནི་དབྱེ་བ་དང་ལྡན་པ་འཁྲུལ་པས་རྟོགས་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་མ་ཡིན་ནམ།",
    "རྣམ་པར་དབྱེ་བ་དང་ལྡན་པ་ནི་དངུལ་གྱི་བཞིན་དུ་ཉ་ཕྱིས་ལ་དངུལ་དུ་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རྒོལ་བའོ།",
    "རྣམ་པར་རྟོག་པ་ཡང་བག་ཆགས་ལས་བྱུང་བ་ཡིན་པར་བསྟན་པ་ནི་གང་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་དབྱེ་བ་མ་མཐོང་ན་ཇི་ལྟར་དེའི་བག་ཆགས་སད་པ་ཡིན་ཞེས་ཟེར་བ་ལ།",
    "མཐོང་བའི་རྗེས་སུ་འབྲངས་པའི་རྟོགས་པས་གཞལ་བྱ་ལ་སོགས་པ་ལ་གཟུང་བ་ལ་སོགས་པ་རྣམ་པར་གཞག་པ་མི་རིགས་པ་མ་ཡིན་ནམ།",
    "པར་གཞག་པ་ངེས་པས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེའི་སྒྲུབ་བྱེད་ཡིན་པར་འདོད་པའོ།",
    "དེ་ལྟར་རབ་ཏུ་རྟོགས་པར་བྱེད་པའི་ཚིག་ལས་དེའི་ཡུལ་ཅན་གྱི་གཞལ་བྱ་ཤུགས་ཀྱིས་བསྟན་པ་ཡིན་ནོ།",
    "བདེ་བ་ལ་སོས་པ་ལ་ནི་རིག་པ་ཁོ་ན་ཡིན་གྱི་དེ་དག་ཙམ་གྱི་ཁྱད་པར་ནི་མ་ཡིན་ཏེ།",
    "རིག་པ་ལས་ཐ་མི་དད་པར་ཉམས་སུ་མྱོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་བདེ་བ་ལ་སོགས་པ་ཇི་ལྟར་རང་རིག་པ་ཡིན་པར་མི་འགལ་བ་ཡིན་ཞེས་ཟེར་བ་ལ་བདེ་བ་ལ་སོགས་པ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "གོམས་པའི་སྟོབས་ལས་ཞེས་བྱ་བ་ནི་རང་རིག་པ་སྒྲུབ་པར་བྱེད་པའོ།",
    "དེའི་ཕྱིར་ཐ་དད་པའི་ཚིག་ནི་རྨོངས་པ་ཡིན་པར་བསྟན་པ་ནི་རྣམ་པ་བཞིར་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པ་ཁོ་ནའོ་ཞེས་བྱ་བ་ནི་བདེ་བ་ལ་སོགས་པ་ཉིད་འཛིན་པར་བྱེད་པའི་ཕྱིར་དབྱིབས་མ་ཡིན་པའོ།",
    "སྔོན་པོའི་རྣམ་པ་ཞེས་བྱ་བ་ནི་དབྱིབས་དང་བཅས་པ་དང་ཅིག་ཤོས་ཞེས་བྱ་བའི་ཁྱད་པར་ཡིན་གྱི་གཟུང་བ་དང་ཅིག་ཤོས་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པ་མེད་པ་ལ་ནི་རྣམ་པར་དབྱེ་བ་རང་ཉིད་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "བདེ་བ་ལ་སོགས་པའི་བདག་ཉིད་བཞིན་དུ་བདེ་བ་དང་སྔོན་པོ་ལ་སོགས་པ་དག་ལ་ཁྱད་པར་མེད་དེ་ལས་དང་ཅིག་ཤོས་ཀྱི་ངོ་བོས་གཉི་ག་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་དེ་ལའང་ཞེས་བྱ་བའོ།",
    "སྐྱེད་པར་བྱེད་པ་ཡང་འབའ་ཞིག་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "མངོན་དུ་ཕྱོགས་པར་བྱེད་པ་དང་སྣང་བ་དག་ལ་དབྱེ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "པ་ལ་ངེས་པར་བྱེད་པ་ཡིན་ཡང་དེ་ལ་ངེས་པ་དང་མ་ངེས་པ་འཛིན་པའི་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ནི་བག་ཆགས་ཀྱི་རྣམ་པར་དབྱེ་བ་ལས་ཡིན་ཏེ།",
    "དབྱེ་བ་ན་གནོད་པར་བྱེད་པ་མེད་པའི་ཤེས་པ་ལས་ཡིན་ནོ་ཞེས་ཟེར་བ་གནོད་བྱ་ཞེས་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་རྣམ་པ་དང་བཅས་པའི་རིགས་པ་དང་དོན་རིག་པ་ལ་ཡང་དེའི་རིག་པ་ཡིན་ན་དེའི་ལན་ནི་རྣམ་པར་རིག་པ་ཙམ་གྱི་ཚུལ་ཡིན་ཏེ།",
    "ཉེ་བ་ལས་སྨང་བ་མ་ཡིན་ཏེ་འོན་ཀྱང་མིག་ལ་སོགས་པའི་བསྐྱེད་བྱ་སྣང་བ་ཁྱད་པར་ཅན་ཡིན་པར་བསྟན་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "ཆེན་པོ་མ་ཡིན་པར་ནི་རགས་པར་མ་ཡིན་པ་སྟེ་མིག་འབྲས་ཙམ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ཅན་ནི་སྔར་མི་གསལ་བ་ལས་གསལ་བ་དང་།",
    "དེའི་བསྐྱེད་བྱའི་ཁྱད་པར་མེད་ན་སྔར་མི་གསལ་བ་འམ་མི་རིག་པའོ།",
    "ཁྱད་པར་གཞན་ཡིན་ན་ནི་ཐུག་པ་མེད་པར་འགྱུར་བར་བསྟན་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཀུན་གྱི་རྣམ་པར་ཞེས་བྱ་བ་ནི་མིག་ལ་སོགས་པའི་རྣམ་པར་རོ།",
    "ཉེ་བ་གང་ལས་ཤེས་པ་དོན་ཉིད་ཀྱི་རྗེས་སུ་བྱེད་པ་དེས་དེ་ཉིད་རྗེས་སུ་འཛིན་པར་འགྱུར་ན་རྣམ་པའི་རྟོག་པ་ལ་དགོས་པ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡིན་གྱི་འབའ་ཞིག་ནི་མ་ཡིན་པར་བསྟན་པ་ནི་ཡུལ་རྣམས་ལས་ཞེས་བྱ་བའོ།",
    "རྣམ་འགའ་ཞེས་བྱ་བ་ནི་སྐྱེ་བ་ལ་ངེས་པར་བརྟགས་པ་མ་བྱས་ཀྱང་སྐྱོན་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངེས་པའི་རྣམ་པ་སྐྱེད་པར་བྱེད་པས་ཕན་འདོགས་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པའོ།",
    "དེ་ཉིད་དུ་སྒྲོ་བཏགས་པའི་ཡུལ་ཡིན་པར་བསྟན་པ་ནི་དཔེར་ན་ཞེས་བྱ་བ་སྟེ།",
    "རིག་པའི་སྔོན་པོ་ནི་རིག་པ་ལས་ཐ་མི་དད་པར་ཕྱི་རོལ་གྱིས་བྱས་པ་ནི་ཕས་བྱས་པའི་བུའི་ངོ་བོ་བཞིན་དུ་མཐོང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་རྟོགས་པའམ་གཞན་རྟོགས་པ་ཙམ་ཡིན་ན་ཡུལ་རྟོགས་པར་འགྱུར་བ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་རྟོགས་པ་དང་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཡུལ་མི་རིགས་པར་བསྟན་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བ་སྟེ་སྔོན་པོ་ལ་སོགས་པའོ།",
    "རྟོགས་བཞིན་པ་ཉིད་འབྲས་བུ་ཡིན་པས་བྱེད་པ་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ནམ།",
    "སྤྲོས་དང་ལྡན་པར་མཐོང་བ་མིན།",
    "འདི་བུམ་པའོ་ཞེས་བྱ་བ་ལས་བུམ་པའི་རྣམ་པ་མ་རྟོགས་པར་ཤེས་པའི་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་མི་རིགས་པ་ཡིན་ནོ།",
    "རྣམ་པ་དང་བཅས་པ་ཉིད་ཀྱིས་ཁྱད་པར་མེད་པ་ན་བུམ་པའི་ཤེས་པ་དེའི་ཤེས་པའི་དབྱ་བ་ལས་ནི་མ་ཡིན་ནོ།",
    "ཉམས་སུ་མྱོང་བ་དྲན་པ་ཕྱི་རོལ་ལ་ཡིན་གྱི་རྣམ་པ་ནི་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟ་བུར་ཞེས་བྱ་བ་སྟེ།",
    "མངོན་སུམ་པ་ཕྱི་རོལ་ལོ་ཞེས་བྱ་བ་ཡང་མངོན་སུམ་པ་མ་ཡིན་པར་བསྟན་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ངེས་པ་ནི་དེའི་རྣམ་པ་ཅན་ཉིད་ཀྱི་འདས་པ་ལ་སོགས་པར་འཛིན་པ་ལའོ་ཞེས་བསྟན་པ་ནི་འདས་པའི་ཞེས་བྱ་བའོ།",
    "འཛིན་པར་བྱེད་པ་རང་རིག་པར་གྱུར་པ་ནི་འབྲས་བུའོ།",
    "དགག་པར་བྱ་བ་བསྟན་པ་ནི་གང་དག་ཤེས་པ་ནི་ཞེས་བྱ་བའོ།",
    "གསལ་བ་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་ཉིད་དུ་ངེས་པ་རྣམ་པར་འཛིན་པ་ཡིན་ནའོ།",
    "མ་ལུས་སྒྲུབ་པར་བྱེད་བློ་ཡང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པར་ལེགས་པར་སྨྲས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་འདིའི་ངོ་བོ་ཉིད་སྤྱིར་གཟུང་བ་ཉིད་དུ་སྣང་བ་ཡིན་པར་བསྟན་པ་ནི་སྔོ་སོགས་ཞེས་བྱ་བའོ།",
    "བསྒོས་ན་ཡང་ཤེལ་ལྟ་བུར་ཐ་དད་པར་གྲུབ་ནའོ།",
    "སྐྱེད་པར་བྱེད་པ་ནི་སྣང་བ་ཡིན་ལ་སྣང་བཞིན་པ་ནི་མ་ཡིན་ཏེ།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་ནི་སྣང་བར་འགྱུར་བ་མ་ཡིན་པ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡོད་པའི་རིགས་པའོ།",
    "དམིགས་པའི་ཤེས་པ་སྐྱེད་པར་མི་བྱེད་པ་མི་རིགས་པའི་ཕྱིར་ཏེ།",
    "དྲན་པ་ལས་ཀྱང་རྗེས་སུ་དཔག་པ་ལས་བྱུང་བ་ཡིན་པར་བསྟན་པ་ནི་རྣམ་པ་འདི་འདྲ་ཞེས་བྱ་བ་སྟེ།",
    "ཞེས་བསྟན་པ་ནི་དེའི་བདག་ཉིད་མ་ཡིན་པའི་ཡུལ་ཡང་མ་ཡིན་ན་ཁྱད་པར་མ་ཡིན་ལ།",
    "ཉམས་སུ་མྱོང་བ་དང་རྣམ་པ་དག་འདྲེས་པས་ཐ་མི་དད་པར་སྣང་བ་མ་ཡིན་ཏེ།",
    "དྲན་པའི་རྣམ་པར་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེར་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཏེ་རྣམ་པ་མེད་པ་ཉིད་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཉམས་སུ་མྱོང་བ་ལ་ནི་རྣམ་པར་རྟོག་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ལ་རྣམ་པ་དེ་ནི་ཞེས་བྱ་བ་སྨོས་ཏེ་འདི་ནི་དོན་གྱི་བསྐྱེད་བྱ་བ་མ་ཡིན་ཏེ།",
    "བག་ཆགས་ཀྱི་བསྐྱེད་བྱ་ཤེས་པ་ལ་ཐ་དད་པ་ནི་ཞེན་པར་བྱ་བ་ཉིད་ཀྱིས་ཕྱི་རོལ་ཡིན་ལ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཡང་ཞེས་བྱ་བ་ནི་མ་བསྟན་པར་ཏེ།",
    "མཚམས་སྦྱོར་བ་ནི་ལོག་པར་རྟོགས་པ་མ་ཡིན་པའོ།",
    "ཐ་དད་པ་ལ་ཐ་མི་དད་པར་སྣང་བ་ཁས་བླངས་པའི་དུས་ནའོ།",
    "ལ་དོན་མེད་པའི་རྣམ་པར་དོགས་པ་མ་ཡིན་ནམ།",
    "ཉམས་སུ་མྱོང་བཞིན་པའི་སྔོན་པོ་ནི་གཞན་གྱིས་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་འཛིན་པ་དང་རིག་པའི་བདག་ཉིད་ཀྱི་ཕྱིར་དེའི་བདག་ཉིད་དུ་གྱུར་པའི་འབྲས་བུ་ཡང་ཡིན་ཏེ།",
    "སྔོན་པོ་གཟུང་བའོ་ཞེས་བྱ་བས་དེ་མ་ཡིན་པ་ལས་ལོག་པས་ཐ་མི་དད་པར་མ་རྟོགས་པ་ལོག་པར་རྟོག་པ་རྣམས་རྟོགས་པ་ཡིན་ནོ།",
    "མེད་པ་རྟོག་པ་ཙམ་ཡིན་པའི་ཕྱིར་ཤེས་པའི་ཁྱད་པར་ལས་བློ་རྟོགས་པ་ཡིན་ནོ།",
    "ཐ་དད་པར་འགྱུར་བ་མ་ཡིན་པ་ནི་དངོས་པོའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངེས་པར་བརྟག་པར་བྱ་བ་ཅི་ཞིག་ཡིན་ཞེས་ཟེར་བ་ལ་དེའི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པ་ཞེས་བྱ་བའོ།",
    "སྔོན་པོའི་ཤེས་པའོ་ཞེས་བྱ་བ་ནི་ཐ་མི་དད་པར་ཉམས་སུ་མྱོང་བ་དང་འགལ་བར་བསྟན་པ་ནི་སྔོན་པོ་ལས་ཞེས་བྱ་བའོ།",
    "བློ་ནི་དོན་རྟོགས་པ་ཉིད་ཀྱི་ཤེས་བྱ་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་བློ་དང་ལྡན་པ་ཞེས་བྱ་བའོ།",
    "གཞན་དུ་ན་ཉམས་སུ་མྱོང་བ་མ་ཡིན་པར་ཟེར་བ་ནི་འོན་ཏེ་དོན་ཡང་ཞེས་བྱ་བའོ།",
    "དོན་ཉམས་སུ་མྱོང་བ་གཅིག་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟ་ན་ཞེས་བྱ་བའོ།",
    "དེའི་རྣམ་པ་ཅན་ནི་དོན་ལ་ཉམས་སུ་མྱོང་བ་ངེས་པར་བྱེད་དོ་ཞེ་ན།",
    "ངེས་པའི་རྣམ་པ་ནི་རྣམ་པའི་སྒོ་ནས་དོན་ལ་ཉམས་སུ་མྱོང་བ་ངེས་པར་བྱེད་པས་ཉམས་སུ་མྱོང་བ་ཉིད་ངེས་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི་དཀར་པོ་ལས་ནི་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་མེད་པ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངེས་པས་ཀྱང་རྣམ་པ་དང་ཕྱི་རོལ་ཐོབ་བྱའི་ཉམས་སུ་མྱོང་བར་བྱེད་པ་ཡང་དེ་ལས་ངེས་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི་དེ་ཕྱིར་ཞེས་བྱ་བའོ།",
    "རྟོགས་པར་བྱེད་པའི་བློ་ནི་སྤྱིས་ཡིན་ཏེ།",
    "དེའི་རྒྱུ་ཉིད་ནི་ཁྱད་པར་ལས་ཡིན་ནོ་ཞེ་ན་དེས་ན་ཞེས་བྱ་བ་སྨོས་སོ།",
    "རྒྱུ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ཡང་བློས་བྱས་པ་ཡིན་གྱི་དངོས་སུ་བའི་འབྲེལ་པ་ལ་རག་ལས་པ་ནི་མ་ཡིན་ཏེ།",
    "འདི་ལ་གཅིག་སྣང་བ་ཡིན་གྱི་གཟུང་བ་ལ་སོགས་པ་ཉིད་ནི་མ་ཡིན་ན་ཇི་ལྟར་རྣམ་པ་གཉིས་ཉིད་ཡིན་ཞེས་ཟེར་བ་ལ་ཆ་གཉིས་ལ་ནི་ཞེས་བྱ་བ་སྟེ་ཁྱད་པར་ནི་དེ་དང་དེ་ལས་ལོག་པ་ཡིན་ལ་དེས་བྱས་པའི་རྣམ་པ་གཉིས་ཉིད་ཡིན་གྱི་སྔོན་པོ་དང་སེར་པོ་བཞིན་དུ་སྣང་བའི་དབྱེ་བས་བྱས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་ལ་ནི་དྲན་པ་ལ་ཇི་ལྟར་གནས་པར་འགྱུར་རོ།",
    "དྲན་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་དེ་ལ་མཆོག་ཏུ་འཛིན་པ་ཡིན་ན་འདི་ཉིད་གསུམ་དང་བདག་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་བའི་ཕྱིར་རྒྱུན་གྱི་ལེགས་པར་མཚོན་པ་རྨོངས་པའི་གནས་མ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ང་ལ་ཅི་ཞིག་ཡོད་པར་གྱུར་ཞེས་རྒྱུན་མཆོག་ཏུ་འཛིན་ན་མི་སྣང་བ་མེད་པར་བསྟན་པ་ནི་གདོན་མི་ཟ་བར་ཞེས་བྱ་བའོ།",
    "སྤྲོས་དང་ལྡན་པར་མཐོང་བ་མིན།",
    "དཔྱོད་པར་བྱེད་པ་མི་འདོད་ཀྱི།",
    "རིགས་པར་ཤེས་རྣམས་དཔྱོད་པར་བྱེད།",
    "མ་དཔྱད་པར་ནི་གཉིས་སམ་ཅིག་ཤོས་སུ་ཡང་ཞེས་བྱ་བར་ངེས་པར་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱུན་གྱི་ཡོངས་སུ་བརྟགས་པ་དེ་ཉིད་མཚོན་པའི་ཐབས་ཡིན་པར་བསྟན་པ་ནི་དོན་གྱི་ངོ་བོས་ཞེས་བྱ་བའོ།",
    "རིག་པའི་བདག་ཉིད་མ་ཡིན་པ་ཡང་དེ་ལྟ་བུའི་ཁྱད་པར་གྱི་ཡུལ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བསྲེ་བ་ནི་རིག་པར་བྱ་བ་དང་།",
    "རིག་པར་བྱེད་པ་དག་ཐ་དད་པར་ཤེས་པ་དག་གཅིག་ཏུ་བྱེད་པའོ།",
    "ལེན་ན་དེ་དག་ཙམ་ཡིན་པས་སྣང་བ་དང་ཡིད་ལ་བྱེད་པ་ལ་ཡང་འགྱུར་ཏེ་དྲན་པ་ལ་ཡང་ཉམས་སུ་མྱོང་བ་ལ་བག་ཆགས་ཀྱིས་སྐྱེད་པར་བྱེད་པ་ཡིན་ཞིང་དམིགས་པ་ཡང་རྣམ་པ་མེད་ན་སྐེད་པར་བྱེད་པ་ཙམ་ཡིན་ནོ།",
    "བྱེད་པ་པོ་ཉིད་ཀྱང་དོན་ལ་ཁྱད་པར་ཅན་དུ་སྐེད་པར་བྱེད་པ་ཡིན་གྱི་ཁྱད་པར་ཅན་ལས་གཞན་ཤེས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་མ་ཡིན་པའི་ངོ་བོ་འཛིན་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "མེད་པར་མི་འཛིན་པ་ཞེས་བྱ་བ་ནི་དེའི་བདག་ཉིད་དོ།",
    "སྔོན་པོའི་ཤིང་ཞེས་བྱ་བ་ནི་ཐག་རིང་བའི་ཁྱད་པར་ལའོ།",
    "ངེས་པར་འཛིན་པའི་སེམས་ཀྱིས་ཞེས་བྱ་བ་ནི་ངེས་པར་དཔྱོད་པའི་སེམས་ཀྱིས་ཏེ།",
    "རྣམ་པའི་ཁྱད་པར་ཉམས་སུ་མྱོང་བ་མ་ཡིན་པར་བསྟན་པ་ནི་དོན་བསྲེ་བ་དང་འབྲེལ་པ་ཅན་ཏེ།",
    "འབྲེལ་པ་ནི་ངོ་བོ་ཡིན་གྱི་ངེས་པར་འཛིན་པ་ནི་མ་ཡིན་ནོ།",
    "གཅིག་ལ་མ་ངེས་པར་ཟེར་བ་ལ་བཟུང་ལ་ཞེས་བྱ་བ་སྟེ།",
    "ངེས་པར་འཛིན་པ་དང་ཅིག་ཤོས་དག་ཐ་དད་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེར་ནི་ཞེས་བྱ་བ་ནི་འཛིན་པ་ལ་ཤེས་པ་འབའ་ཞིག་པ་ཉིད་ནི་འཛིན་པ་ཉིད་དང་འགལ་བ་ཡིན་པར་བསྟན་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "དབྱེ་བར་མི་ནུས་པ་ཞེས་བྱ་བ་ནི་དྲན་པས་སམ་ཉམས་སུ་མྱོང་བས་ཐ་མི་དད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ངེས་པར་འཛིན་པ་མ་ཡིན་པའི་ཕྱིར་ལ་དེའི་འཛིན་པ་ལ་སོགས་པ་ཡང་འབྱེད་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐ་དད་པར་མི་རིགས་ན་ཡུལ་ལ་སོགས་པ་ཉིད་ལྷན་ཅིག་པ་ཉིད་ཀྱང་མི་རིགས་པར་བསྟན་པ་ནི་གཉིས་དག་ཅེས་བྱ་བའོ།",
    "སྔོན་པོ་མཐོང་བ་ན་བདེ་བ་མཐོང་བ་ནི་ཤེས་པ་ཉིད་མ་ཡིན་པར་ཁས་བླངས་པར་བསྟན་པ་ནི་བདེ་བ་ལ་སོགས་པའི་ངོ་བོར་ན་ཞེས་བྱ་བའོ།",
    "བདེ་བའི་ཤེས་པ་ཡང་གཞན་གྱི་འཛིན་བྱེད་མ་ཡིན་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་ཇི་ལྟར་ཞེས་བྱ་བའོ།",
    "གང་མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་འཛིན་པ་ཉིད་མེད་པར་ཡང་ངོ།",
    "དེས་བྱས་པ་ནི་འཛིན་པ་ཉིད་བྱས་པའི་འཛིན་པ་སྟེ།",
    "བྱས་པ་ནི་རབ་ཏུ་སྦྱར་བའོ།",
    "དེ་མེད་པར་ནི་གཞན་གྱི་སེམས་ལའོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ལྐོག་ཏུ་མ་གྱུར་པ་ཉིད་ནི་དང་པོའི་ཤེས་པ་ལ་གཉིས་པར་ངེས་པར་རྟོགས་པ་ནི་ལྐོག་ཏུ་མ་གྱུར་པ་ཉིད་འཛིན་པ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པ་ལྟ་བུའོ་ཞེས་བསྟན་པ་ནི་ངེས་པར་ཞེས་བྱ་བའོ།",
    "ངེས་པར་ཞེས་བྱ་བ་ནི་སོ་སོ་བ་མ་ཡིན་པར་དམིགས་པ་ལས་ཐ་མི་དད་པའི་དམིགས་པ་ཉིད་དོ།",
    "བདག་ཉིད་ལ་ཡང་ནི་རང་རིག་པ་ལ་སྟེ་དེའི་རྣམ་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པའི་རྣམ་པ་ཐ་དད་པའི་ཕྱིར་ནི་ཁྱད་པར་ཡིན་པའི་ཕྱིར་འདི་ཇི་ལྟ་བུ་ཡིན་པ་དེ་ལྟ་བུ་རབ་རིབ་ཅན་ནི་མ་ཡིན་ནོ།",
    "ཐ་དད་པར་རྟོགས་པར་ནུས་པ་མ་ཡིན་པ་ནི་ཞེས་བྱ་བ་རང་རིག་པའི་ཁོངས་སུ་གཏོགས་པའི་ཕྱིར་རོ།",
    "ཐ་དད་པར་མ་རྟོགས་ན་རིགས་པ་ཅི་ཡིན་ཞེས་ཟེར་བ་ལ་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "མི་འཐད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་སྣ་ཚོགས་པར་ཉམས་སུ་མྱོང་བའོ།",
    "ཐ་དད་པ་དྲན་པར་བྱ་བ་ཡང་སྔོན་པོ་དང་སེར་པོ་གཅིག་ཏུ་དམིགས་པར་མཐོང་བ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་དེ་ལྟ་ན་འོ་ན་ཞེས་བྱ་བ་ནི་སྟེ།",
    "ཐ་མི་དད་པར་འཛིན་པ་དེ་ཡང་རྐྱང་པ་ལ་དམིགས་པའི་ཕྱིར་གཅིག་ཉིད་ཡིན་ལ་ཐ་དད་པར་འཛིན་པའི་དྲན་པ་ནི་འཁྲུལ་པས་སོ།",
    "དེ་ལྟ་བུའི་རིག་པར་བྱེད་པ་ལས་སྔོན་པོའི་རིག་པ་མ་ཡིན་ཏེ་རིག་པ་ཉིད་ཁོ་ན་མི་དྲན་ན་དེ་མི་དྲན་པའི་ཕྱིར་རོ།",
    "ངེས་པས་ཞེས་བྱ་བ་ཡང་འདི་ཉིད་ཀྱི་ཁྱད་པར་བརྗོད་པའི་ཆེད་དུ་ཡིན་པར་བསྟན་པ་ནི་དེ་ནི་དེ་བཞིན་ཏེ་ཞེས་བྱ་བའོ།",
    "འདོད་ན་ནི་ཞེས་བྱ་བ་ནི་འཁྲུལ་པས་ཐ་དད་པར་རྣམ་པར་གཅད་པའོ།",
    "དེ་བཞིན་དུ་བདེ་བ་དང་སྔོན་པོ་དག་གཅིག་པར་དམིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་ནི་འགལ་བ་དམིགས་པ་གཅིག་པར་དམིགས་པའི་ཁོངས་སུ་གཏོགས་པ་མ་ཡིན་པར་དེ་ལྟར་བརྗོད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "རིག་པར་བྱ་བ་དང་རིག་པར་བྱེད་པ་དག་སྔོན་པོ་དང་སེར་པོ་བཞིན་དུ་ཐ་དད་པར་རིག་པ་མ་ཡིན་པར་བསྟན་པ་ནི་མྱོང་བ་མེད་པར་ཞེས་བྱ་བའོ།",
    "བདེ་བ་དང་སྔོན་པོ་དང་དེ་ཉིད་ཀྱི་ཕྱིར་ཐ་དད་པར་སྣང་ཡང་ཐ་མི་དད་པའམ་ཐ་དད་པའི་འབྲས་བུ་མེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་ཐ་དད་པར་ནི་ཞེས་བྱ་བའོ།",
    "ཐ་དད་རིག་པ་ཞེས་བྱ་བ་ནི་དེ་སྙེད་ལ་སོགས་པའི་ཐ་དད་པ་ཉིད་ཀྱི་ཁྱད་པར་རོ།",
    "རིག་པ་ལས་བཞིན་དུ་སེར་པོ་ལས་ཀྱང་སྔོན་པོ་ཐ་མི་དད་པའི་རིག་པ་ཅན་གཅིག་ཉིད་ཡིན་པར་བསྟན་པ་ནི་བླང་བྱ་དང་ཞེས་བྱ་བའོ།",
    "དུས་གཞན་ལ་ཐ་དད་པར་རིག་པ་ནི་གཞན་ཉིད་ཡིན་པར་བསྟན་པ་ནི་དེའི་ཚེ་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པ་དང་ཐ་མི་དད་པ་རིག་པའི་སེར་པོ་གཅིག་ཏུ་བརྟགས་ནས་མ་ངེས་པའི་འཁྲུལ་པ་ཡིན་པར་བསྟན་པ་ནི་ཐ་དད་པའི་ཞེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བའི་རྣམ་འགྲེལ་གྱི་དོན་ནི་གཅིག་དམིགས་པའི་རང་བཞིན་དུ་གཞན་ལའང་ཁྱད་པར་མེད་པ་ཡིན་ཏེ།",
    "དོན་སྣང་བ་ཡིན་ན་ཤེས་པའི་རྣམ་པ་ཉིད་ཐོབ་པར་འགྱུར་ན་ཞེས་པ་ཇི་ལྟར་ཡིན་ངེས་པ་མ་ཡིན་ན་ཡང་དེ་དང་ལྡན་པ་ཉིད་ལས་དབྱེ་བ་ཡིན་གྱི་རིག་པ་ལས་ནི་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ནི་ཤེས་པ་འབའ་ཞིག་ཅེས་བྱ་བའོ།",
    "རྒྱུ་ཉིད་ནི་སྐེད་པར་བྱེད་པའོ།",
    "ཐ་དད་པར་ནི་ཁྱད་པར་རོ།",
    "འགྱུར་བ་ནི་ཤེས་པའི་རྣམ་པའི་ཁྱད་པར་ལས་སོ་ཞེས་རྗེས་སུ་དཔོག་པ་ནི་དོན་གྱི་ནུས་པ་ཡིན་ཏེ།",
    "དེའི་རྣམ་པ་མ་ཡིན་པ་ཉིད་ཐོབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ནི་སྣ་ཚོགས་པའི་རྣམ་པ་ཅན་རྨི་ལམ་མཐོང་བ་ནི་དེའི་རྣམ་པ་སྐྱེད་པར་བྱེད་པ་མཐོང་བ་ཡིན་གྱི་རྣམ་པ་མེད་པའི་ཉིད་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "གྲུབ་པ་བཞིན་དུ་དོན་དང་བརྟག་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "འབྲས་བུ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་མཐོང་བའི་ཞེས་བྱ་བ་སྟེ།",
    "འབྲས་བུའི་ཁྱད་པར་རོ།",
    "མ་རིག་པ་བག་ཆགས་མ་གཏོགས་པར་དེ་ཡིན་ཏེ།",
    "དོན་ཡོད་ན་ལྷན་ཅིག་བྱེད་པ་རྣམས་ཀྱིས་སྒྲོ་བཏགས་པའི་ཁྱད་པར་ཅན་ཉེ་བར་ལེན་པའི་འབྲས་བུའི་རྒྱུད་ཐ་དད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "བདག་མེད་པར་ལྟ་བ་ཕྱིན་ཅི་མ་ལོག་པ་དང་དེ་དང་རྗེས་སུ་མཐུན་པའི་སྦྱོར་བ་ལ་སོགས་པ་འདོད་པའི་འབྲས་བུ་དང་ལྡན་པ་ནི་ཡང་དག་པའི་ཤེས་པ་བཞིན་དུ་འདོད་པ་འཐོབ་པར་བྱེད་པ་ཡིན་ལ།",
    "རྣམ་པའི་ཁྱད་པར་ལས་ངེས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་མི་རིགས་ཏེ།",
    "དེ་དག་ལས་ངེས་པ་མེད་པར་གསལ་བར་བྱེད་པ་ནི་རྣམ་པར་ཤེས་པར་སྨྲ་བས་ནི་ཞེས་བྱ་བའོ།",
    "ལྐོག་ཏུ་གྱུར་པའི་རྗེས་སུ་དཔག་པར་བྱ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཁྱད་པར་ལས་སོ།",
    "ལྷན་ཅིག་བྱེད་པ་རྣམས་ཀྱིས་སྒྲོ་བཏགས་པའི་ཁྱད་པར་ཅན་གྱི་རྒྱུ་དང་འབྱེད་པར་བྱེད་པ་ནི་ཉེ་བར་ལེན་པ་ནི་ཕྱི་རོལ་ལམ་ཤེས་པ་ལ་ཡང་ཁྱད་པར་མེད་དོ།",
    "རྣམ་པ་དང་བཅས་པའི་ཤེས་པ་ནི་ངེས་པར་བྱེད་པ་ཡང་ཡིན་ལ།",
    "སད་པར་བྱེད་པ་ཡང་དམིགས་པ་ལ་ལྷན་ཅིག་བྱེད་པ་བཞིན་དུ་དམིགས་པ་ཁ་ཅིག་ལ་རྨི་ལམ་དུ་མཐོང་བ་ཡིན་ཏེ།",
    "འདི་ལ་སེམས་ཀྱི་གནས་སྐབས་ཀྱི་ཁྱད་པར་ཡང་འབྲས་བུའི་ནུས་པ་ཅན་གྱི་རིགས་པ་མེད་ན་ཉེ་བར་མཚོན་པར་བླ་བའི་སད་པར་བྱེད་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པའི་ཁྱད་པར་དང་ལྡན་པའི་ཤེས་པས་སོ།",
    "དགོས་པ་ནི་གྲང་བ་མེད་པར་བྱེད་པ་ལ་སོགས་པའོ།",
    "རྒྱུ་ནི་བག་ཆགས་ཡིན་ལ་དེས་ན་ཕྱི་རོལ་མེད་ཀྱང་དེ་ངེས་པ་ཡིན་པར་བསྟན་པ་ནི་ཕྱིའི་དོན་ནོ་ཞེས་བྱ་བའོ།",
    "མེད་པ་ཉིད་དུ་འགལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཁྱད་པར་ཡིན་པར་བསྟན་པ་ནི།",
    "གྲུབ་ན་ཞེས་བྱ་བ་ནི་མ་དམིགས་བཞིན་པའི་གནས་སྐབས་ན་ཡང་འབྲས་བུ་ཉིད་ལ་སོགས་པའི་ཁྱད་པར་ཡོད་པའི་ཕྱིར་རོ།",
    "པ་དེ་དམིགས་ན་དམིགས་བཞིན་པ་དེའི་འབྲས་བུ་ཡིན་པས་རྣམ་པར་རྟོག་པ་དེ་མ་ཡིན་པ་ལས་ལོག་པའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་ཁྱབ་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་འོན་ཏེ་གཅིག་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "རང་ལ་སྣང་དུ་རུང་པ་དང་ཅིག་ཤོས་ལ་སྣང་དུ་རུང་བ་དག་གཅིག་པ་ཉིད་དུ་སྒྲོ་འདོགས་པར་ནི་ཕྱི་རོལ་དུ་སྨྲ་བ་དང་ཅིག་ཤོས་ལ་མཚུངས་པ་ཡིན་པར་བསྟན་པ་ནི་རྣམ་པར་ཤེས་པ་སྣང་བ་ལ་ཡང་ཞེས་བྱ་པའོ།",
    "རྣམ་པར་འཇོག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རྟག་ཏུ་ཞེས་བྱ་བ་ནི་རྟོགས་པའི་ཁྱད་པར་རོ།",
    "དཔེ་ཅན་ལ་ནི་དེས་དེའམ་ཞེས་བརྗོད་པ་ཡིན་ལ་རྣམ་པར་ཤེས་པའི་ཚུལ་ལ་འདི་གཉིས་ལ་ཞེས་བྱ་བའི་ཕྱི་རོལ་དང་ཅིག་ཤོས་དག་ལའོ།",
    "མེའི་སྣང་བ་ནི་དེའི་བག་ཆགས་སད་པར་བྱེད་པ་ཉིད་ཀྱི་རྒྱུ་ཉིད་ཡིན་པ་ནི་དུ་བ་ལ་ཡང་ཡིན་ཏེ།",
    "དེས་ཀྱང་དེ་སད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་གཉི་ག་དེ་ལྟར་སད་པ་ཡིན་པར་གོ་བར་བྱེད་པ་ཡིན་ལ།",
    "དེའི་དངོས་པོ་ཉིད་སད་པར་བྱེད་པ་ཉིད་དུ་བརྗོད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་དེ་ལའང་ཞེས་བྱ་བའོ།"
  ]
}