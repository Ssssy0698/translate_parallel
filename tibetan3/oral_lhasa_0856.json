    "འདིས་ནི་ལུང་ལས་གཞན་གྱིས་མཐོང་བ་ཡང་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ལོག་པར་རྟོགས་པ་བསལ་བ་མ་ཡིན་ནོ།",
    "དེས་ན་མཚན་ཉིད་འདིས་ལོག་པར་རྟོགས་པ་ཞེས་གསུངས་སོ།",
    "ལུང་ལས་མཐོང་བ་རབ་ཏུ་གསལ་བརརྗེས་སུ་དཔག་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ལོག་པར་རྟོགས་པ་བསལ་རྩཱབ་ཡིན་ནོ།",
    "གང་ཞིག་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་འགྱུར་བ་གཞན་གྱི་སྟེ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བའི་གསལ་བྱེད་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་བརྗོད་པ་ཅི་ལྟར་གསལ་བར་བྱེད་པ་མ་ཡིན་ཞེ་ན།",
    "དོན་གང་ལ་བསྟན་པར་བྱ་བ་གཞན་ནོ།",
    "གཞན་ནི་བསྟན་པར་བྱ་བའོ།",
    "རྩོད་པ་མེད་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་གྲུབ་ཟིན་པའི་ཕྱིར་ན་དམ་བཅའ་བ་རྗོད་པ་དོན་མེད་དོ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་གྲུབ་ཟིན་པའི་ཕྱིར།",
    "ཅི་ལྟར་དམ་བཅའ་བ་བརྗོད་པ་དོན་མེད་པ་དེ་བཞིན་དུ་རྟགས་བརྗོད་པ་ཡང་དོན་མེད་པར་འགྱུར་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་མ་གྲུབ་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཅི་ལྟར་ཚུལ་གསུམ་པའི་ཚིག་ལས་བཟུང་ཟིན་པའི་འབྲེལ་པ་དྲན་པར་གྱུར་པ་ན།",
    "གཞན་ལ་ཞེས་བྱ་བ་ནི་བསྟན་པར་བྱ་བ་ལའོ།",
    "ཚིག་ནི་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པས་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་བརྗོད་ཀྱི།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕ་རོལ་པོ་དག་གཞན་གྱི་དོན་གྱི་མངོན་སུམ་གྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་གཞན་གྱི་དོན་གྱི་མངོན་སུམ་ཡིན་ནོ་ཞེས་སྟོན་པར་བྱེད་པའོ། ། ཚིག་འདི་ནི་མངོན་སུམ་གྱི་རྒྱུ་ཡིན་པ་དེས་ན་ཚིག་འདི་གཞན་གྱི་དོན་གྱི་མངོན་སུམ་ཡིན་ནོ་ཞེ་ན།",
    "མངོན་དུ་ཕྱོགས་པར་གྱུར་པར་རུང་བ་ཉིད་ལ་ནི་མངོན་སུམ་སྲིད་པས་ཁྱབ་པར་རྟོགས་པ་ཡིན་ཏེ།",
    "དེས་ན་མངོན་དུ་ཕྱོགས་པར་རུང་བའི་མཚན་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པ་ལྟོས་ཞེས་བྱ་བ་དེ་ལྟར་རྟོགས་པ་ལས་མངོན་སུམ་སྐྱེ་བར་སྲིད་པ་དེ་རྗེས་སུ་དཔོག་པ་སྐྱེ་བ་ཡིན་གྱི།",
    "དེ་མ་ཐག་པར་ནི་མངོན་སུམ་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "མངོན་སུམ་སྲིད་པས་ཁྱབ་པ་བདག་ཉིད་ལ་སྔར་མཐོང་བ་ལ་རྟོགས་པར་བྱ་བ་སྟེ།",
    "གང་ཞིག་དོན་གང་ལ་༦མངོན་དུ་ཕྱོགས་པར་གྱུར་པ་དེ་ནི་མ་ཚང་བ་དང་གགས་བྱེད་པ་མེད་ན་དོན་དེ་མངོན་སུམ་དུ་བྱེད་པ་ཅན་ཡིན་ཏེ།",
    "དེས་ན་བསྟན་པར་བྱ་བས་དོན་དེ་ལ་མངོན་དུ་ཕྱོགས་པར་གྱུར་པ་མ་རྟོགས་པར་བདག་ཉིད་ལ་དེ་མི་སྲིད་པར་དོགས་པ་ན།",
    "དེ་ལ་དེའི་མངོན་སུམ་དོན་དུ་གཉེར་བས་འཇུག་པར་མི་འགྱུར་བ་ཁོ་ནའོ་ཞེས་དོགས་པ་བསུ་ནས་བརྗོད་པ་ནི།",
    "བསྟན་པར་བྱ་བ་ལ་ཡང་བསྟན་པ་ཡིན་ནོ།",
    "ཚིག་དེ་བརྗོད་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མ་ཡིན་པར་ནི་མངོན་སུམ་གྱི་རྒྱུ་ཉིད་དུ་ཁས་བླང་བར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དེའི་ཕྱིར་ན་ངེས་པར་སྦྱོར་བའི་ཚིག་ནི་རྗེས་སུ་དཔག་པ་ཉིད་ཡིན་ཏེ་ཚུལ་གསུམ་པའི་རྟགས་གསལ་བར་བྱེད་པས་ན་རྗེས་སུ་དཔག་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་མངོན་དུ་ཕྱོགས་པའི་མཚན་ཉིད་ཀྱི་རྟགས་ཀྱིས་མངོན་སུམ་སྲིད་པར་བལྟས་ཏེ།",
    "ངེས་པར་སྦྱོར་བའི་ཚིག་ལས་མངོན་དུ་ཕྱོགས་པ་ལ་འཇུག་པ་ཡིན་ནོ་ཞེས་རྟོགས་པར་བྱའོ།",
    "གང་ཞིག་དོན་གང་ལ་མངོན་དུ་ཕྱོགས་པར་གྱུར་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྲིད་པའི་རྗེས་སུ་དཔག་པ་སྟེ།",
    "དེས་ན་འབྲས་བུའི་རྟགས་བརྗོད་པའི་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "འོན་ཏེ་ཚུལ་གཉིས་སྟོན་པར་བྱེད་པའི་བརྗོད་པ་ཡང་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ཡིན་ནོ་སྙམ་ན།",
    "མངོན་སུམ་གྱིས་ནི་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་འདི་ཅི་ལྟར་ཤེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "མ་གྲུབ་པའི་ཕྱིར་གཏན་ཚིགས་འབའ་ཞིག་བརྗོད་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་རྟོགས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་རྟོགས་པ་ཡང་སྐབས་ལ་སོགས་པ་ལས་རྟོགས་པར་འགྱུར་རོ།",
    "ཚིག་འདི་ཅི་ལྟར་དེའི་རང་བཞིན་ཅན་གྱི་རང་བཞིན་གྱི་ཚུལ་གསུམ་པའི་རྟགས་སྟོན་པར་བྱེད་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ཡིན་པ་དེ་དེ་སྟོན་པ་ནི།",
    "གལ་ཏེ་དེ་ལྟར་ན་ཡང་ཚུལ་གསུམ་པའི་རྟགས་སྟོན་པར་བྱེད་པ་ཅི་ལྟར་ཡིན་ཏེ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་འདི་དུ་བའོ་ཞེས་བརྗོད་པས་མངོན་སུམ་དུ་མཐོང་བ་བསྟན་པར་རོ།",
    "ཚིག་ནི་ཞེས་གསུངས་སོ།",
    "དེར་ཡང་ཞེས་སྨོས་ཏེ་དུ་བའི་རང་བཞིན་ལ་ཡང་དཔྱོད་པའོ་ཞེས་བྱ་བ་རྗེས་སུ་དཔོག་པ་པོ་རང་བཞིན་རྟགས་ཏེ་དེའི་རང་བཞིན་གྱི་རྗེས་སུ་དཔག་པ་མེད་པར་འཁྲུལ་པ་ལྡོག་པ་མ་ཡིན་ནོ།",
    "དེས་ན་རང་དོན་གྱི་རྗེས་སུ་དཔག་པར་ཡང་རྒྱུ་རྗེས་སུ་དཔག་པ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོ་ན་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་ཡང་རྒྱུ་རྗེས་སུ་དཔག་པར་འགྱུར་བ་ཁོ་ནའོ་སྙམ་ན།",
    "གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་ནི་ཞེས་སྨོས་སོ།",
    "ཚིག་ཀྱང་དངོས་སུ་རང་བཞིན་གྱི་གཏན་ཚིགས་སྟོན་པར་བྱེད་པའི་ཕྱིར་རང་བཞིན་གྱི་རྗེས་སུ་དཔག་པ་ཁོ་ན་སྟེ།",
    "མེ་རྗེས་སུ་དཔོག་པ་ཞེས་བྱ་བ་ནི་༤རྒྱུ་བསྒྲུབ་པར་བྱ་བ་ལའོ།",
    "བསྟན་བཅོས་ལས་ནི་རང་བཞིན་ལ་བརྟེན་ནས་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་བརྗོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ་། གང་ཡང་འགལ་བ་ཅི་ཞིག་ཡོད་ཅེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པ་དེ་ཡང་རྟོགས་པ་པོ་འཁྲུལ་པ་ལ་ལྟོས་པ་ཁོ་ནས་འཐད་པ་ཡིན་གྱི།",
    "ཚུལ་གསུམ་པའི་ཞེས་གསུངས་སོ།",
    "༢༡༥༩ ༤༨ཚུལ་གསུམ་བརྗོད་པར་བྱ་བ་ཡིན་གྱི་མ་འཁྲུལ་པ་ལ་ནི་མ་ཡིན་ཏེ་དེའི་འབྲེལ་པའི་ཚིག་ཙམ་ལས་རྟོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་གཞན་གྱིས་ཀྱང་བསལ་བའི་ཕྱིར་གཞན་ཡང་ཞེས་གསུངས་སོ།",
    "ཐ་སྙད་ཀྱི་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་གསལ་བརཚིག་མེད་པར་ནི་ཞེས་བྱ་བའོ།",
    "འདི་གསུམ་མེད་པར་ཡང་འཇིག་རྟེན་གྱི་ཐ་སྙད་དམ་ཅི།",
    "འདིར་ནི་འདི་ཙམ་ཞིག་ཅེས་གསུངས་ཏེ།",
    "འོ་ན་ཅི་ཞིག་བརྗོད་པར་འདོད་སྙམ་ན།",
    "དེས་ན་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་རྒྱུའི་རྗེས་སུ་དཔག་པ་མི་སྲིད་ཀྱང་མཚན་ཉིད་ཀྱི་ཚིག་ལ་གནོད་པ་མེད་དོ་ཞེས་དགོངས་པའོ།",
    "ཚུལ་གསུམ་པ་སྟོན་པར་བྱེད་པ་འབའ་ཞིག་ཏུ་ནི་མ་ཟད་དེ་རིག་བྱེད་ལ་ཡང་ངོ།",
    "རིག་བྱེད་ལ་ནི་ཞེས་གསུངས་ཏེ་མེའི་སྦྱིན་སྲེག་ལ་སོགས་པའི་ངག་ལས་སོ།",
    "འདིས་རྗེས་སུ་འགྲོ་བས་ན་རྗེས་འགྲོ་ནི་རྒྱུས་ཏེ་བསྒྲུབ་པར་བྱ་བ་དང་འབྲེལ་པའི་རྟགས་སོ།",
    "སྔར་ཞེས་བྱ་བ་ནི་སྟོང་ཕྲག་ཕྱེད་དང་བཞི་པར་རོ།",
    "སྐྱེས་བུས་མ་བྱས་པ་ལ་ཡང་ལྡོག་པ་ཙམ་གྱིས་ནི་གོ་བར་བྱེད་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་དོན་དུ་ཡང་ན་ཞེས་གསུངས་སོ།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "སྐྱེས་བུས་མ་བྱས་པ་ཉིད་ལས་རིག་བྱེད་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་རིག་བྱེད་བྱས་པ་ཡིན་ན་ཅི་ལྟར་སྐྱེས་བུས་མ་བྱས་པ་ཡིན་ཞེ་ན།",
    "དེ་ལྟ་བུའི་ཞེས་བྱ་བ་ནི་བྱས་པའིའོ།",
    "བསྟན་ཟིན་པ་ནི་ཞལ་འགྲེལ་ལེའུ་དང་པོ་ལ་སོགས་པར་རོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ལ་སོགས་པ་ནི་མ་ཡིན་ཏེ་གསལ་བར་བྱེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་བརྗོད་པར་མི་བྱ་སྙམ་ན།",
    "གལ་ཏེ་དེ་ཡོད་ཅེས་བྱ་བ་ནི་ཕྱིར་རྒོལ་རང་ཉིད་རྟོགས་པར་གྱུར་ནའོ།",
    "གྲུབ་པའི་མཐའི་ཆ་རྣམ་པར་འགྲེལ་པ་ནི་བསམ་དེ་ཞེས་བྱ་བའོ།",
    "ངག་ཐམས་ཅད་རྣམ་པར་གཅོད་པའི་འབྲས་བུ་ཅན་ཡིན་པ་ཉིད་ཀྱིས་རང་ཁོ་ནས་མཐོང་བ་ཞེས་ངེས་པར་བཟུང་བ་ནི་གདོན་མི་ཟ་བར་བྱ་བ་ཡིན་ནོ།",
    "དེས་ན་རྒོལ་བས་མཐོང་བ་ཁོ་ན་སྒྲུབ་པར་བྱེད་པ་ཡིན་གྱི་ཕྱིར་རྒོལ་བས་མཐོང་བ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ་། དེ་ལྟ་ན་ཡང་ལུང་ལས་གྲུབ་པ་ཁོ་ནར་འགྱུར་རོ།",
    "དེས་ན་གཞན་གྱིས་མཐོང་བ་རྣམ་པར་བཅད་པའི་ཕྱིར་དོན་མེད་པ་གཞན་ཞེས་བྱ་བ་དོན་གཞན་མ་ཡིན་པ་གང་ཡིན་པ་རྣམ་པར་རྟོག་༧ པ་ཙམ་གྱི་ཾབཀོད་པ་སྒྲུབ་བྱེད་དུ་འགྱུར་བ་ཐོག་ཏུ་བབ་པོ་ཞེ་ན།",
    "དེས་ནི་ཞེས་བྱ་བ་གཉི་གས་མཐོང་བར་བསྟན་པའི་དོན་གྱིས་ནི་ལོག་པར་རྟོགས་པ་ལུང་ལས་གཞན་གྱིས་མཐོང་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རང་བཞིན་ནོ།",
    "གཙོར་ལོག་པར་རྟོགས་༤པ་བསལ་བའི་དོན་ཁོ་ནར་མཚན་ཉིད་བྱས་པ་ཡིན་གྱི།",
    "གཞན་དུ་ནི་གཞོན་ལ་གྲུབ་པས་ཞེས་བརྗོད་པར་མི་བྱ་བར་འགྱུར་རོ།",
    "གཞན་གྱིས་རྟགས་༦པར་གྲུབ་པ་ལ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་མེད་པས་བརྗོད་པ་ནི་ཚུ་རོལ་མཐོང་ཞེས་བྱ་བ་རྒོལ་བ་གཞན་གྱིས་༧ཞེས་བྱ་བ་ཕྱིར་རྒོལ་བའི་རྟོགས་པའོ།",
    "དེ་ལྟར་ན་ཕྱིར་རྒོལ་བས་རྟོགས་པར་༧རྒོལ་བས་ཤེས་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེས་ན་གཞན་ཁོ་ནས་མཐོང་བ་ཞེས་ངེས་པར་ཅི་ལྟར་འགྱུར་དེ་ཉིད་བརྗོད་པ་ནི་དེས་ན་ཞེས་བྱ་བ་སྟེ།",
    "དེས་རབ་ཏུ་གྲུབ་པ་ཞེས་བྱ་བ་ལུང་ལས་གྲུབ་པའི་གཏན་ཚིགས་ཉམས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་དེ་ལ་རག་ལས་པ་ཉིད་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཕྱིར་རྒོལ་བ་ལ་བསྒྲུབ་པར་བྱ་བ་ངེས་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཉེས་པ་ཡང་མེད་དོ་ཞེས་སྨྲས་པ་ནི།",
    "རྟགས་མ་ཤེས་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཤེས་པ་ནི་རྒོལ་བ་ལ་ཡོད་པ་ཉིད་དོ་ཞེས་བྱ་།",
    "༢༡བསྒྲུབ་པར་ནུས་པ་མ་ཡིན་ཞེས་ཏེ།",
    "གྲངས་ཅན་དེ་བསྒྲུབ་པར་བྱ་བ་སེམས་པ་མེད་པ་ཉིད་བསྒྲུབ་པ་ལ་ཡང་མི་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "རྟོགས་པར་བྱ་བ་དེ་ནི་གཏན་ཚིགས་དེ་ལས་ཞེས་བྱ་བ་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་ལས་སོ།",
    "གྲངས་ཅན་འདི་སྒོ་མེད་པར་ཏེ་ཐབས་དང་བྲལ་བར་བྱ་ནུས་པ་སྟེ།",
    "བསྒྲུབ་བྱ་རྟོགས་པའི་ཐབས་སུ་གྱུར་པ་སྒྲུབ་པར་བྱེད་པའི་རང་བཞིན་གསལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་བྱས་པས་རྒོལ་བ་བརྟན་པོ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ང་གྲུབ་ཅེས་བྱ་བ་ནི་སྟོན་པར་བྱེད་པ་ལ་གྲུབ་པས་སོ།",
    "འོན་ཏེ་ཡང་གཏན་ཚིགས་སྟོན་པར་བྱེད་པ་ལ་མ་གྲུབ་ན་འདི་ལས་བསྟན་པར་བྱ་བས་བསྒྲུབ་བྱ་ཅི་ལྟར་རྟོགས་སྙམ་ན།",
    "ཐམས་ཅད་ང་ཡིས་བྱ་བ་སྟེ་སྟོན་པར་བྱེད་པས་སོ།",
    "འོན་ཏེ་གཏན་ཚིགས་ཀྱི་རང་བཞིན་བསྟན་པར་བྱ་བས་མི་ཤེས་པ་ཉིད་ཡིན་པ་དེས་ན་དེ་ལ་གྲུབ་པའི་རྟགས་ཀྱི་ཤེས་པ་༦ ཅི་སྟེ་བརྗོད་སྙམ་ན།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་བསྟན་པར་བྱ་བ་ལ་གྲུབ་པའི་རྟགས་ཀྱིས་རྟོགས་པར་བྱ་བ་ཞེས་བྱའོ་༧།",
    "བསྟན་པར་བྱ་བ་འདི་སྟོན་པར་བྱེད་པ་ངས་སོ།",
    "འདི་ཞེས་བྱ་བ་ནི་བསྟན་པར་བྱ་བའོ་ཞེས་དེ་ལྟར་རྟོགས་པ་ཅི་ལྟར་ཞེས་འབྲེལ་ཏེ།",
    "རྒོལ་བ་ངས་རྟོགས་པས་ཕྱིར་རྒོལ་ཁྱེད་ལལ་མི་རྟག་པ་ཉིད་ཀྱི་སྒྲུབ་པར་བྱེད་པ་འདིར་དགོས་པ་གཞན་ཅི་ཞིག་ཡོད་དེ་ཅུང་ཟད་ཀྱང་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ནི་ཕྱིར་རྒོལ་བས་སོ།",
    "འོ་ན་ཅི་ཞིག་བརྗོད་པར་བྱ་ཞེ་ན་འདིར་ཞེས་སྨོས་ཏེ།",
    "འདིར་ནི་སྒྲུབ་པར་བྱེད་པ་ལའོ།",
    "འོན་ཏེ་གཞན་ལ་དོན་གྲུབ་པར་ངེས་པས་ཅི་དགོས་ཏེ་མ་ཤེས་པ་བསྒྲུབ་པའི་དོན་དུ་རྩོམ་པའི་ཕྱིར་རོ་སྙམ་ན།",
    "གཞན་གྱི་དོན་དུ་ཞེས་གསུངས་སོ།",
    "འོ་ན་ཅི་ལྟར་གཞན་གྱིས་རྟོགས་པར་ངེས་སྙམ་ན།",
    "མ་རྟོགས་པར་བསྟན་ན་ཉེས་པ་ཅི་ཡོད་སྙམ་ན་འདིས་ཞེས་གསུངས་ཏེ།་",
    "གྲངས་ཅན་གྱིས་སྒྲུབ་པར་བྱེད་པ་གང་ལ་རྟོགས་པ་མེད་པ་སྟེ་བརྗོད་པ་ནི་བརྫུན་ཉིད་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟར་ན་ཡང་སྟོན་པར་བྱེད་པ་ཉིད་ལས་ནི་མ་ཉམས་སོ་སྙམ་ན།",
    "རྒོལ་བ་རང་ཉིད་ཀྱི་རྟགས་ཀྱི་ཡུལ་ཅན་གྱི་རྟོགས་པ་གང་ཡིན་པ་དེ་མེད་པར་ནི་རྒོལ་བ་སྟོན་པར་བྱེད་པ་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཕྱིར་རྒོལ་བ་ཁས་ལེན་ཀྱང་མི་བདེན་པ་སྨྲ་བ་ཉིད་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "འོན་ཏེ་ཕྱིར་རྒོལ་བས་མ་རྟོགས་ན་རྒོལ་བ་རྟོགས་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་འགྱུར་རོ་སྙམ་༢ན་གལ་ཏེ་ཕྱིར་རྒོལ་བས་ཞེས་བྱ་བའོ།",
    "༩༦༣ཏེ་ཕྱིར་རྒོལ་བ་ལ་བརྗོད་པར་དོན་མེད་པར་གྱུར་པའི་ཕྱིར་རྟོགས་པར་བྱེད་པ་མ་ཡིན་པའི་ཉེས་པ་ཁོ་ནའོ་སྙམ་ན།",
    "རྒོལ་བའི་ཉེས་པ་ནི་ཞེས་གསུངས་སོ།",
    "དེར་ཞེས་བྱ་བ་ནི་ཕྱིར་རྒོལ་བ་དམུས་ལོང་དུ་གྱུར་པར་རོ།",
    "ཉེས་པ་ནི་རྟོགས་པར་བྱེད་པ་མ་ཡིན་པའི་མཚན་ཉིད་དོ།",
    "ཕྱིར་རྒོལ་བས་རྟོགས་པར་བྱ་བའི་ཞེས་བྱ་བའོ།",
    "ཉན་པོ་གཞན་ཏེ་དེར་ཡོ་བས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཕྱོགས་གཅིག་གནོད་པར་གྱུར་པ་ཅན་གྱི་ལུང་ནིའོ།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པའི་སྒྲུབ་པར་བྱེད་པ་ནི་གཉི་ག་ལ་གྲུབ་པ་ཡིན་ནོ།",
    "ལུང་དེ་དང་ལྡན་པ་ཞེས་བྱ་བ་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་སྟོན་པར་བྱེད་པའི་ལུང་དང་ལྡན་པ་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་འགའ་ལ་ཡང་སྒྲུབ་པར་བྱེད་པ་མ་གྲུབ་པོ།",
    "དེས་ན་ཅི་ལྟར་གཞན་༩ གྲུབ་པའི་རྟགས་ཀྱིས་གཞན་ཉིད་རྟོགས་པར་བྱེད་ཅེས་བརྗོད།",
    "དེས་ན་དེ་ལས་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལས་ཕྱིར་རྒོལ་བས་བསྒྲུབ་བྱ་འགྲུབ་བོ་སྙམ་ན།",
    "མི་ཤེས་པ་ཡང་མ་ཡིན་ཏེ་ཞེས་གསུངས་ཏེ།",
    "དེ་དང་ཞེས་གསུངས་ཏེ།",
    "ཕྱིར་རྒོལ་བ་རྨོངས་ན་ནི་རྒོལ་བ་སྟོན་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་སོ།",
    "བཟློག་པ་ནི་བདེ་བ་ལ་སོགས་པ་སེམས་པ་ཅན་དུ་ཁས་བླངས་པ་ལས་བཟློག་པ་སྟེ་དེ་ལྟར་བྱས་པས་རྒོལ་བ་གྲངས་ཅན་གྱི་འབྲས་བུ་འགྲུབ་བོ།",
    "དེས་ན་རྒོལ་བ་ནི་སྟོན་པར་བྱེད་པ་ཁོ་ནའོ་ཞེས་བྱ་བར་བསམ་པའོ།",
    "དེ་ལྟ་བུའི་ཞེས་བྱ་བ་ནི་མི་རྟག་པ་ཉིད་ལ་སོགས་པའི་མཚན་ཉིད་སྒྲུབ་པར་བྱེད་པའོ།",
    "གལ་ཏེ་གང་ཞིག་སུན་འབྱིན་པ་འབྲེལ་མེད་བརྗོད་པར་འགྱུར་བ་དེ་ལ་སྒྲུབ་པར་བྱེད་པ་ཡང་འབྲེལ་མེད་ཁོ་ན་བརྗོད་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ག་ལས་སྙམ་ན།",
    "དོན་དེ་ིཞེས་བྱ་བ་ནི་སེམས་མེད་པའི་དོན་སྒྲུབ་པར་བྱེད་པའོ།",
    "དེ་ཞེས་བྱ་བ་རང་ལ་བསྒྲུབ་པའི་སྒྲུབ་པར་བྱེད་པའོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་ནི་སེམས་པ་མེད་པའིའོ།",
    "༩༦༩སོགས་པའི་མཚན་ཉིད་ཀྱི་ནི་རྣལ་འབྱོར་པས་རྟོགས་པར་བྱ་བ་ཡིན་གྱི་རིག་པས་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེའི་ཞེས་གསུངས་སོ།",
    "གསལ་བར་སྣང་བའི་ཤེས་པ་སྐྱེ་བའི་ཡུལ་ཅན་དེ་ཤེས་པར་གྱུར་པ་ན།",
    "དེའི་རྣལ་འབྱོར་པས་རྟོགས་པའི་ཡུལ་གྱི་དོན་ཁས་ལེན་པར་ནུས་པ་ལ་ཡིན་ཏེ་མཐུ་ཡོད་པ་ཡིན་ནོ།",
    "དེ་སྒྲུབ་པར་བྱེད་པའི་ཐབས་རྟོགས་པ་ནི་རྣལ་འབྱོར་པ་སྒྲུབ་པར་བྱེད་པའི་ཐབས་རྟོགས་པའོ་། དོན་དེ་རྟོགས་པའི་རང་བཞིན་གྱིས་མངོན་སུམ་ཞེས་བྱ་བ་ནི་རྒྱུ་ལ་འབྲས་བུ་བརྟགས་ིནས་བརྗོད་པར་བལྟའོ།",
    "༢༡པ་དེ་དག་ནི་དེའི་རྣལ་འབྱོར་པས་རྟོགས་པའི་དོན་ཁས་ལེན་པར་བྱ་བ་ལ་ནུས་པ་ཉིད་དོ་ཞེས་འབྲེལ་ཏེ།",
    "ཾཐབས་སུ་གྱུར་པའི་དོན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་རོ།",
    "འོ་ན་ཅི་ལྟར་བརྗོད་པར་རིགས་སྙམ་ན།",
    "ཅི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་ན་ཡང་གྲངས་ཅན་གྱིས་མ་བརྗོད་དེ་དེས་ན་སྒྲུབ་པར་བྱེད་པ་དེ་ནི་སྲིད་པ་མ་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འོ་ན་ཏེ་ཞེས་གསུངས་ཏེ།",
    "དེའི་སྒྲུབ་པར་བྱེད་པ་ནི་སེམས་པ་མེད་པ་ཉིད་ལ་སོགས་པའི་སྒྲུབ་པར་བྱེད་པའོ།",
    "དོན་གང་ཞིག་སྒྲུབ་པར་བྱེད་པས་རྗེས་སུ་རྟོགས་པར་ནུས་པ་དེ་ལ་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་སེམས་པ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "ལུང་གཅིག་པུས་རྟོགས་པར་བྱ་བ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྤྱིའི་དོན་དང་འབྲལ་ོབ་མེད་པའི་ཕྱིར་རོ།",
    "དེས་ན་སྒྲུབ་པར་བྱེད་པ་མེད་པ་ལས་ཀྱང་སྐྱེསྟེ་ཤེས་པ་ལ་སྐྱོན་ཅི་ཡོད་སྙམ་ན།",
    "ཅི་ཞིག་རྟོགས་པར་བྱེད་སྙམ་ན།",
    "བདག་གཅིག་པུ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དེ་ལས་བསྒྲུབ་པར་བྱ་བ་ངེས་པ་མ་ཡིན་ན།",
    "བསྒྲུབ་བྱ་མེད་པར་ཞེས་སྨོས་སོ།",
    "དུ་མ་ལ་ཡོད་པར་ཁས་བླངས་པའི་ཆ་མེད་པའི་གཅིག་པུ་གང་ཡིན་པ་དེ་ནི་ཡུལ་ལ་སོགས་པའི་ཁྱད་པར་ཅན་གྱི་གོང་བུ་གཞན་དང་ལྡན་པ་མ་ཡིན་ཏེ།",
    "ཡུལ་དང་དུས་དང་གནས་སྐབས་ཀྱི་ཁྱད་པར་དུ་ངེས་པའི་གསལ་བ་གཅིག་པུ་གང་ཡིན་པ་དེ་དང་འདྲེས་པ་སྟེ།",
    "འབྲེལ་བ་གང་ཡིན་པ་དེས་རྣམ་པར་མ་བཅད་པའི་སྟེ་ཁྱད་པར་དུ་མ་བྱས་པའི་རང་བཞིན་གཞན་གྱིས་སྟོང་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཡུལ་ལ་སོགས་པ་དུ་མ་དང་ལྡན་པར་འགྱུར་བ་དེ་། དེའི་ཚེ་འགལ་བ་ཅི་ཡོད་པ་དེའི་ཕྱིར་རང་བཞིན་གཞན་གྱིས་སྟོང་པ་ཡང་ཡིན་ལ་ཡུལ་ལ་སོགས་པའི་ཁྱད་པར་ཅན་གཞན་དང་ཡང་ལྡན་པར་ཡང་ིའགྱུར་བའི་ཕྱིར་མ་ངེས་པ་ཉིད་དོ་ཞེ་ན།",
    "འོ་ན་སྔོན་དང་ཕྱི་མའི་དངོས་པོ་ཁྱབ་པའི་དུས་ཡོད་པར་འགྱུར་རོ་ཞེ་ན་དེའི་དུས་སུ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དུས་ཀྱི་དབྱེ་བས་དངོས་པོ་རྣམས་ཀྱི་སྔ་མ་ཉིད་ལ་སོགས་པ་ཡིན་ན་ནི་དུས་ཀྱི་དབྱེ་བ་ཡང་དུས་གཞན་ལས་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པར་འགྱུར་རོ་སྙམ་ན་དེའི་ཡང་ཞེས་གསུངས་ཏེ།",
    "ཅི་ལྟར་ཕན་ཚུན་བརྟེན་པར་འགྱུར་སྙམ་ན།",
    "ལྷན་ཅིག་སྤྱོད་པའི་ཞེས་གསུངས་སོ།",
    "དང་པོ་ནི་གསལ་བ་ཉིད་པས་ཚིག་ལེའུར་བྱས་པ་གཉིས་པ་རྣམ་པར་འགྲེལ་པ་ནི་ཅི་སྲིད་ཅེས་བྱ་བའོ།",
    "དེ་ནི་གདོན་མི་ཟ་བར་ཁས་བླང་བར་བྱ་བའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་ནི་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ད་ལྟར་བྱུང་བ་ཡང་རྣམ་པར་གནས་པས་ཏེ་རྣམ་པར་གནས་པས་༧ནི་དུས་མེད་པས་ཀྱང་གྲུབ་པས་སོ།",
    "འབྲས་བུ་ཡོད་པ་ཞེས་བྱ་བ་འདི་ལས་ནི་ད་ལྟར་བ་རྣམ་པར་གནས་ལ།",
    "གང་ཞིག་རྒྱུན་ལ་མི་ལྟོས་པར་གནས་པ་ཅན་དེ་ནི་རྒྱུ་ཡོད་པ་ལ་ཡོད་པ་ཞེས་བྱ་བ་ད་ལྟར་བ་ཡིན་ལ།",
    "དེས་ན་མ་མཐོང་བའི་དུས་རྟག་པ་༤ཅི་ཞིག་བྱ་སྔོན་དང་ཕྱི་མ་དང་བར་གྱི་དངོས་པོ་ནི་ཡོད་པ་དང་མེད་པ་རྣམ་པར་གནས་པ་ཡིན་ནོ།",
    "ཚིག་ལེའུར་བྱས་པར་ནི་ཕྱི་མའི་སྒྲས་ད་ལྟར་བ་དང་མ་འོངས་པ་གཉི་ག་བསྡུས་པ་ཡིན་ནོ།",
    "དེས་ན་རྫས་ཀྱིས་དངོས་པོ་དུས་ཡོད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡུན་རིང་པོ་དང་མྱུར་བ་ལ་སོགས་པའི་བློའི་གཟུང་བར་བྱ་བ་དུས་ཡིན་པར་འདོད་ན།",
    "དེས་ན་གཟུང་༤བར་བྱ་བ་རྟག་པ་དང་ཁྱབ་པ་ཡིན་ན་འཛིན་པར་བྱེད་པའི་བློ་མྱུར་བ་ལ་སོགས་པར་ཅི་ལྟར་འཇུག།",
    "འོན་ཏེ་ཡུན་རིང་པོ་ལ་སོགས་པར་བཟུང་ཡང་འདི་ནི་རྟག་པ་ཉིད་ལ་སོགས་པའི་རང་བཞིན་ཉིད་ཡིན་ནོ་སྙམ་ན།",
    "གཟུང་བའི་རང་བཞིན་གང་ཡིན་པ་ཞེས་གསུངས་སོ།",
    "རྣམ་གཞག་འདི་རྣམ་པར་དབྱེ་བ་ལཐ་དད་པ་ལས་ཡུན་རིང་པོ་ལ་སོགས་པའི་ཁྱད་པར་དུས་ཀྱི་རང་བཞིན་གྱི་རྗེས་སུ་འགྲོ་བ་གང་དག་ཡིན་པ་དེ་དག་ནི་དངོས་པོ་ཉིད་དེར་འགྱུར་བ་ཉིད་དོ།",
    "གཏན་ཚིགས་དེའི་ཕྱིར་དུས་ནི་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "འདི་ནི་དེ་ལས་ཐ་དད་པར་ཡོད་པ་ཉིད་ཀྱང་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "ཚད་གྱུར་ལས་ཞེས་བྱ་བ་ནི་ལས་ལ་གནས་པའི་བྱ་བ་མེད་པར་བརྗོད་པའོ།",
    "ཐོག་མེད་ཅེས་བྱ་བ་གསུངས་སོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལྷས་བྱིན་ལས་ཐ་མི་དད་པར་གྱུར་ན་དེའི་ཚེ་སྐྱེས་བུ་གཞན་དག་བྱ་བ་དང་ལྡན་པ་དེར་མི་འགྱུར་རོ།",
    "ལྷས་བྱིན་གྱི་རང་བཞིན་ནི་མཆོད་སྦྱིན་གྱིས་ཡིན་པར་མི་འཐད་དོ།་།",
    "ལྷས་བྱིན་དང་མཆོད་སྦྱིན་དག་ལ་ནི་འགྲོ་བ་ཡོད་པར་ཡང་ཡིན་ཏེ།",
    "རང་བཞིན་དང་སྐྱེས་བུ་བྱ་བ་དང་ལྡན་པ་ལས་སྐྱེས་བུ་གཞན་ཡང་ཁྱབ་པ་དང་ལྡན་པའི་ཕྱིར་བྱ་བ་གཞན་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་ཞེས་བརྟག་སྟེ་རྣམ་པར་གཞག་ེཔ་ཡིན་གྱིས་༧དོན་དམ་པར་ནི་ཐ་དད་པར་མཐོང་བ་ཡང་མ་ཡིན་ནོ།",
    "འདི་ཡང་ཞེས་བྱ་བ་ནི་ཐ་དད་པར་ལྷག་པར་ཞེན་པའོ་། བསྟན་ཟིན་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི་སྨྲ་བར་བྱེད་པའི་ཡུལ་ཞེས་བྱ་བ་དེར་རོ།",
    "གལ་ཏེ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ནི་མངོན་སུམ་གྱིས་རྟོགས་པར་བྱ་བ་མ་ཡིན་ནམ།་",
    "དེ་ཅི་ལྟར་རྣམ་པར་རྟོག་པ་ཙམ་གྱིས་ཡུལ་ཡིན་པར་བརྗོད་ཅེ་ན།",
    "ཐོག་མ་མེད་པའི་ཞེས་གསུངས་སོ།",
    "ཡུན་རིང་བ་ལ་སོགས་པ་ཡང་བྱ་བའི་ཁྱད་པར་ཉིད་ཡིན་པས་སོ།",
    "འོ་ན་ནི་དོན་གྱི་རང་བཞིན་གྱི་རྗེས་སུ་ཞུགས་པའི་སྤྱི་ཉིད་ཡུལ་ལ་སོགས་པ་ཐ་དད་པ་དང་ལྡན་པར་འགྱུར་རོ་སྙམ་ན།",
    "དེར་ཞེས་གསུངས་ཏེ་ཡུལ་ལ་སོགས་པའི་ངེས་པའི་གོང་བུར་རོ།",
    "དེ་ལྟར་ནི་ཁོངས་སུ་ཞུགས་པར་རོ།",
    "གཞན་དུ་རྗེས་སུ་འཇུག་པ་ལ་ཉེས་པ་བརྗོད་པ་ཉིད་སྤྱི་ལ་ཐ་དད་པ་མེད་པས་གསལ་བ་ཐམས་ཅད་དེར་རྗེས་སུ་ཞུགས་པར་གྱུར་ན་གོང་བུ་གཅིག་ཏུ་འགྱུར་རོ།",
    "མཚུངས་ཏེ་ཞེས་བྱ་བ་ནི་བློ་ལ་ཡོད་པའི་མཚུངས་པ་ཉིད་དེས་ནི་གཞན་ལ་ཞེས་བྱ་བ་དོན་༦ལ་མཚུངས་པ་ཡོད་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "རྣམ་པར་བརྟག་ེཔར་བྱ་བའི་དོན་དུ་གཞི་འདིངས་པ་ནི།",
    "དོན་ཞེས་གསུངས་སོ།",
    "མཚུངས་པའི་རྣམ་པ་ཅན་གྱི་བློ་ཞེས་བྱ་བའི་སྒྲ་དང་འབྲེལ་པའི་བརྗོད་པར་བྱ་བའི་དོན་གང་ཡང་ཡིན་པ་དེ་རྣམ་པར་དཔྱད་ན་རྣམ་པ་གཉིས་སུ་འགྱུར་རོ་ཞེས་སྦྱར་རོ།",
    "བློའི་རྣམ་པ་དེ་ཡང་ཞེས་གསུངས་སོ།",
    "དོན་དང་བློ་གཞན་ལ་མི་འགྲོ་། ཞེས་གསུངས་སོ།",
    "ད་ནི་གཉིས་པ་རྣམ་པར་འགྲེལ་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་བློས་དངོས་པོ་གཉི་གའི་བདག་ཉིད་ཅན་ཡང་འཛིན་པ་ཡིན་ནོ་ཞེས་བསམ་པའོ།",
    "གལ་ཏེ་ཕྱི་མ་ཡིན་ན་ནི་དེའི་ཚེ་ཅི་ལྟར་སེར་པོ་ལས་ཐ་དད་པའི་སྔོན་པོ་སེར་པོ་དང་མི་མཚུངས་པའི་མཐོང་བ་དེ་བཞིན་དུ་སྔོན་པོ་གཞན་དང་ཡང་མི་མཚུངས་པར་མཐོང་བར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྣམ་པར་རྟོག་པ་མེད་པའི་བློས་ཀྱང་དངོས་པོ་གཉི་གའི་བདག་ཉིད་ཅན་འཛིན་པ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཐོག་མ་མེད་པ་ནས་ཕྱིན་ཅི་ལོག་ཏུ་རྣམ་པར་རྟོག་པ་གོམས་པས་བསྐྱེད་པའི་རྣམ་པར་རྟོག་པ་ཅན་གྱི་༧བློས་གཅིག་ཏུ་སྒྲོ་འདོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ན་ནོ།",
    "ཕྱེད་ཕྱི་མ་རྣམ་པར་འགྲེལ་པ་ནི་རྣམ་པ་ཞེས་བྱ་བའོ།",
    "དེའི་བདག་ཉིད་མ་ཡིན་པར་བརྗོད་པ་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པ་གཞན་ནི་གསལ་བ་དང་གཅིག་དང་དེའི་བདག་ཉིད་ཡིན་པ་ན་གསལ་བ་རང་ཡང་ཡིན་པར་འགྱུར་རོ་།",
    "ཕྱེད་ཕྱི་མ་རྣམ་པར་འགྲེལ་པ་ནི་རྣམ་པ་གཞན་དེ་ཞེས་བྱ་བའོ།",
    "དེའི་ཚེ་རྣམ་པ་གཞན་བཟུང་ཡང་དེ་ལས་གཞན་ཞེས་བྱ་བ་གསལ་བ་གཞན་ལ་གནས་པའི་རྣམ་པ་གཞན་འཛིན་པར་མི་འགྱུར་རོ།",
    "འོན་ཏེ་དེའི་བདག་ཉིད་ཁོ་ནས་འཛིན་པ་ཡིན་ནོ་སྙམ་ན་ཐ་མི་དད་པ་ནི་ཞེས་གསུངས་སོ།",
    "རྣམ་པ་བཟུང་བ་ན་དེ་དང་ཐ་དད་མེད་པའི་རྣམ་པ་དང་ལྡན་པ་ཆོད་པ་འཛིན་པར་འདོད་པ་ནི་མ་ཡིན་ནོ་། དེས་ན་རྣམ་པ་གཅིག་བཟུང་ཡང་གཞན་བཟུང་བ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "རྣམ་པ་ཐ་མི་དད་པ་ནི་རྣམ་པ་དང་ལྡན་པ་ལས་ཐ་དད་པ་མ་ཡིན་པའི་ཕྱིར་རྣམ་པ་དང་ལྡན་པ་ཡང་ཐ་དད་པར་མི་འགྱུར་རོ།",
    "ཐ་མི་དད་པ་ལས་ཐ་མི་དད་པ་ནི་ཐ་དད་པར་འགྱུར་བ་མི་འོས་སོ།",
    "རྣམ་པ་ཞེས་གསུངས་སོ།",
    "གསལ་བ་ནི་ཡོན་ཏན་ལ་སོགས་པའི་དབྱེ་བས་དེ་དང་ལྡན་པའི་གསལ་བ་ཐ་དད་པའི་ཕྱིར་ཐ་དད་པར་འཐད་ཀྱི་རྣམ་པ་ནི་གཞན་མ་ཡིན་ཏེ།",
    "ནག་པོ་ལ་སོགས་པ་གསལ་བ་འབྱེད་པར་བྱེད་པ་དེ་ཐ་དད་པའམ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་འགྲེལ་པའོ།"
  ]
}