    "ཅི་སྟེ་ཐ་དད་ན་ལེགས་པར་བྱས་པ་ཉིད་ལས་ཤེས་པ་སྐྱེད་པའི་ཕྱིར།",
    "དུས་གཅིག་ཚེ་ན་སྒྲ་ལེགས་བྱས།",
    "ཡང་སྐྱོན་ཅན་ཉིད་ཡིན་པར་སྟོན་ཏེ།",
    "གཉི་༡ག་ལེགས་པར་བྱས་ཕྱོགས་ལ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གང་སྨྲས་པ་༢དེ་ལ་གཉི་ག་ལེགས་པར་བྱས་ཕྱོགས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།་",
    "ལེགས་པར་བྱས་པ་སྨྲ་བའི་ཕྱོགས་ལ་ནི་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་ཐོས་པ་ནི་མ་ཡིན་ནོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་ཏེ།",
    "ཅི་སྟེ་ཡང་སོ་སོར་ངེས་པའི་སྐྱེས་བུ་རྣམས་ཀྱིས་ཐོས་པར་རུང་བ་རྣ་བ་དང་ཡི་གེ་ལེགས་པར་བྱས་པ་ཡིན་ཏེ།",
    "རྣ་བ་ཡི་གེ་ལེགས་བྱས་དག།",
    "སྐྱེས་བུ་ངེས་པ་རྣམས་ཀྱིས་ཐོས་པར་རུང་བ་ཞེས་བསྙུ་སྟེ།",
    "དེ་དག་ནི་གཞན་ཡང་ཡིན་ལ་ཡི་གེའི་རྟོགས་པ་པོ་ཡང་ཡིན་པ་ནི་ཡི་གེ་གཞན་རྟོགས་པ་པོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་དག་ཉིད་ཀྱི་ཞེས་བྱ་བ་ནི་རྣ་བ་དེ་དག་དང་སྒྲ་སྔར་ལེགས་པར་བྱས་པ་དེ་དག་ཉིད་ཀྱིའོ།",
    "འཁྲུལ་པའི་ཤེས་པ་ཐམས་ཅད་ཡུལ་མེད་པ་ཡིན་ནོ་ཞེས་ཁྱད་པར་མེད་པ་སྔར་བསྟན་ཟིན་པ་དེ་ལྟ་ན་ཡང་སླར་ཡང་རྣམ་པ་མེད་པ་དང་རྣམ་པ་དང་བཅས་པའི་ཕྱོགས་གཉི་ག་ཡང་གཟུགས་བརྙན་གྱི་བློ་ཁྱད་པར་དུ་སྟོན་ཏེ།",
    "ཁྱེད་ཅག་སྤྱོད་༢པ་པ་རྣམས་ཀྱི་ལྟར་ན་རྣམ་པར་ཤེས་པ་རྣམ་པ་མེད་པ་ཡིན་ལ།",
    "ཕྱི་རོལ་གྱི་༤དོན་ཁོ་ན་རྣམ་པ་དང་ལྡན་པར་ཁས་ལེན་པའི་ཕྱིར་རོ།",
    "ཉི་མ་ཡང་གཟུགས་བརྙན་གྱི་ཤེས་པ་ལ་སྣང་བའི་རང་བཞིན་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པའོ།",
    "དེ་ལྟ་ན་ཡང་ཅི་ཡང་རུང་བས་གང་ཅི་ཡང་རུང་བའི་སྣདམིགས་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཡང་གཞན་དུ་རྟོགས་ན་ཡང་དེ་ཉིད་ཡིན་པར་གྱུར་ན་སྣ་ཚོགས་པ་ཐམས་ཅད་གཅིག་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་ལྷན་ཅིག་སྐྱེ་བ་དང་འཇིག་པར་འགྱུར་བ་དང་།",
    "ཤེས་པ་ཐམས་ཅད་ཀྱང་ཡུལ་གཅིག་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་དེ་ཁོ་ན་རྟོགས་པར་འགྱུར་བའི་ཕྱིར་མ་གྲུབ་པ་ག་ལས་ཡིན།",
    "ཕྱི་རོལ་རིག་པར་བརྗོད་ཀྱི།",
    "དེ་ལྟ་མ་ཡིན་ན་གཟུགས་བརྙན་གྱི་བློ་ཉི་མའི་ཤེས་པ་དང་ཁྱད་པར་མེད་པར་མ་འཁྲུལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་ཇི་ལྟར་གནས་པ་འཛིན་པ་དེ་ལྟ་ན་དེ་ཉིད་རྟོགས་པར་འགྱུར་གྱི།",
    "ལོག་པར་འཇུག་ཕྱིར་བརྟད་པ་ཡི།",
    "ཤིང་ལ་སོགས་པ་ཡང་ཆུར་བྱིང་བ་དང་ཡལ་ག་ལ་སོགས་པ་ཐུར་དུ་བལྟས་པར་རྟོགས་སོ།",
    "དེ་བཞིན་དུ་བྱད་ཕྱིར་ལོག་པ་དང་ཆུ་ལ་སོགས་པ་གཏིང་དུ་ཞུགས་པར་དམིགས་ཏེ།",
    "ཐག་རིང་བའི་ཕྱིར་འདིའི་ཡུལ་ལ་ངེས་པར་མི་ཟིན་ཏེ།",
    "ཅིག་ཅར་བས་དུ་མ་ཉིད་དུ་གྲུབ་པར་སྟོན་པ་ནི།",
    "སྤྱིར་བསྒྲུབ་པར་བྱ་བ་ཡིན་ལ།",
    "འདི་ལྟར་གལ་ཏེ་རྟག་པ་རྒྱུ་གཞན་ལ་ལྟོས་པ་སྲིད་པར་གྱུར་ན་དེའི་ཚེ་གྲུབ་པ་ལ་སྒྲུབ་པར་འགྱུར་ན།",
    "དེ་ནི་དེས་ཕན་གདགས་པར་བྱས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕན་འདོགས་ན་ལྟོས་པར་འགྱུར་གྱི།",
    "དཔེ་བསྒྲུབ་པར་བྱ་བ་མ་ཚང་བ་ཡང་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་༡དོན་འདི་བརྗོད་པར་འདོད་པ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གང་སྔར་སྨྲས་པ་དེ་ནི་ཞར་ལ་སུན་ཕྱུང་ནས་རྟག་པ་རྣམས་ཀྱི་གསལ་བར་བྱེད་པ་ཡོད་ན་ཡང་ཕྱོགས་འདི་སྐྱོན་ཅན་༤ཉིད་ཡིན་ནོ་ཞེས་བསྟན་པར་འདོད་ནས་སུན་དབྱུང་བའི་ཕྱིར།",
    "དེ་ལྟར་ན་དེ་འཛིན་པར་འགྱུར་གྱི།",
    "སྒྲ་ནམ་མཁའ་ཇི་སྙེད་པར་འཛིན་པ་ཡང་མ་ཡིན་ལ།",
    "དེ་ནི་སྒྲ་ཙམ་གྱི་ངོར་བྱས་ནས་སྒྲ་ཐོས་པར་ཡང་རིགས་པ་མ་ཡིན་ནོ།",
    "ཐོས་པ་འདི་གང་ཡིན་པའི་སྒྲ་དེ་ཉིད་ལ་རྗེས་སུ་བྱེད་པར་རིགས་པ་ཡིན་པ་དེ་ལྟ་ན་དེའི་འདི་གྲུབ་པར་འགྱུར་༧གྱི།",
    "དཔེར་ན་ལྷ་སྦྱིན་གཅིག་རིམ་གྱིས།",
    "འདི་ལྟར་སྨྲ་བ་པོ་མུན་ཁུང་དུ་ཐོགས་པར་བྱེད་པ་མ་མྱོང་བ་ན་ནམ་མཁའ་ཉིད་ཡིན་གྱི།",
    "ར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་དངོས་པོ་བསྒྲུབ་༥པར་འགྱུར་རོ་ཞེས་དང་པོ་ཉིད་དུ་གཞན་སེལ་བ་བསམ་པར་བསྟན་ཟིན་ཏོ།",
    "ས་གཏིང་མ་ཚུགས་པ་འབའ་ཞིག་ཏུ་ཟད་པའི་ཕྱིར་ཀུན་རྫོབ་ཏུ་རྗོད་པར་བྱེད་པ་ཉིད་འཐད་པར་འཆད་པ་ནི།",
    "དེ་༧རྣམ་པར་གཞག་པའི་ངོ་བོ་གང་ཡིན་པ་དེ་ནི་ཀུན་རྫོབ་ཅེས་བྱའོ།",
    "མྱུར་བ་ལ་སོགས་པའི་བྱེ་བྲག་འདི་གསལ་བར་བྱེད་པས་བྱས་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བའི་སོགས་པའི་སྒྲས་སྒྲུབ་པར་བྱེད་པ་དང་རྗེས་སུ་གནང་བ་དང་དོན་དུ་གཉེར་བ་ལ་སོགས་པ་གཟུང་རི་ངོ།",
    "འདི་ལྟར་སྒྲ་རྣམས་ཕྱི་རོལ་གྱི་དོན་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "འོ་ན་དེ་ལྟ་ན་ཅི་ཞིག་སྟོན་པར་བྱེད་ཅེ་ན།",
    "བརྗོད་པར་འདོད་པ་སྟོན་པ་ཡིན།",
    "བརྗོད་པར་འདོད་པ་ཡང་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱིས་སྟོན་པ་ནི་མ་ཡིན་ནོ།",
    "རྟགས་ཉིད་ཀྱིས་སྟོན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་སྒྲ་བརྗོད་པ་ལས་དོན་ངེས་པའི་རྣམ་པར་རྟོག་པ་སྐྱེའི།",
    "བརྗོད་པར་འདོད་པ་ངེས་པ་ནི་མ་ཡིན་ལ།",
    "གལ་ཏེ་ཡང་བརྗོད་པར་འདོད་པ་ཙམ་དུ་ལྷན་ཅིག་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཉིད་ཀྱིས་ངེས་ཏེ་ཤཱབརྗོད་པར་འདོད་པའི་ཁྱད་པར་དང་ནི་གཞན་གྱི་རྒྱུད་ལས་བརྡ་ལས་མ་གཏོགས་པ་ངེས་པར་མི་ནུས་པས་དེའི་ཕྱིར་དེ་ངེས་པར་བྱ་བའི་ཕྱིར་བརྡ་བྱེད་དོ།",
    "འོན་ཏེ་བརྡ་ལས་ཀྱང་ཅི་ལྟར་འདི་ངེས་པར་ནུས་ཏེ།",
    "འདི་ལྟར་བརྡའི་དུས་ན་གཞན་གྱི་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་སྲིད་པར་གྱུར་༦ན་དེའི་ཚེ་དེ་ལ།",
    "དེ་ལྟ་ཡིན་དང་སྒྲ་དེ་ཉིད་ལས་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་རྟོགས་པ་ན་ཕན་ཚུན་བསྟེན་པའི་སྐྱོན་དུ་འགྱུར་ཏེ།",
    "སྒྲ་ཡང་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་རྟོགས་པ་མེད་པར་སྒྲ་ལས་མ་ཡིན་པའི་ཕྱིར་ཕན་ཚུན་བསྟེན་པ་ཉིད་དུ་གསལ་བའོ་ཞེ་ན།",
    "ཐམས་ཅད་དུ་སྒྲ་ཉིད་ཐམས་ཅད་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་རྟོགས་པའི་རྒྱུ་གེཉིད་ཀྱང་མ་ཡིན་ཏེ།",
    "གཞན་ཡང་ཁྱེད་ཅག་བསྒྲུབ་པར་སྨྲ་བ་ལ་ཡང་ཀླན་ཀ་མཚུངས་ཏེ།",
    "ཇི་ལྟར་སྨྲ་བ་པོ་དང་ཉན་པ་པོ་དག་དོན་གཅིག་རྟོགས་པར་ངེས་པ་མེད་པར་བརྡ་རིགས་པ་ཡིན།",
    "འདི་སྙམ་དུ་སྒྲ་བརྗོད་པར་འདོད་པ་ལ་བརྡ་མ་བྱས་པའི་ཕྱིར་དེ་ཇི་ལྟར་བརྡ་ལས་དེ་དང་ལྷན་ཅིག་འབྲེལ་པ་ངེས་པར་བྱེད།",
    "གཞན་ལ་བརྡ་བྱས་པས་ནི་དོན་གཞན་གསལ་བར་བྱེད་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "འདིར་སྒྲས་བརྗོད་པར་འདོད་པ་ལ་ཡོངས་སུ་གསལ་བ་ལྐུདོན་གྱི་རྣམ་པ་ཕྱི་རོལ་གྱི་ངོ་བོ་ཉིད་ངེས་པར་བྱས་པ་གང་ཡིན་པ་དེ་འདིར་འདོད་དེ།",
    "དེ་ནི་དོན་དམ་པར་བརྗོད་པར་འདོད་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་སྒྲས་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ལས་དེའི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་སྐྱེ་བའི་ཕྱིར་བརྗོད་པར་འདོད་པ་འབའ་ཞིག་སྒྲས་བརྗོད་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་གལ་ཏེ་བརྗོད་པར་འདོད་པ་ལ་ཡོངས་སུ་གསལ་བ་ལ་དོན་གྱི་རྣམ་པས་སྒྲའི་འབྱེལ་པ་རྒྱུ་དང་འབྲས་བུའི་མཚན་ཉིད་ཁོ་ན་ཡིན་ན་བྱེདེ་ཇི་ལྟར་སློབ་དཔོན་གྱིས་དེ་དང་དེར་སྒྲ་དང་དོན་གྱི་འབྲེལ་བ་བརྡ་ལས་བྱུང་བའམ།",
    "བརྗོད་པར་འདོད་ལ་གསལ་དོན་དང་།",
    "དེ་ལྟ་ནའང་དོན་དམ་པར་ཡོད་པ་དང་སྐྱེ་བ་ཐ་མི་དད་པའི་ཕྱིར་དེ་ཉིད་བརྗོད་པར་འདོད་པ་ཡོད་པ་ཡིན་ནོ།",
    "སྨྲ་བ་པོའི་རྒྱུད་ལ་ཡང་བརྡའི་སྒོ་ནས་གསལ་བར་བྱེད་པའི་ཕྱིར་ཉེ་བར་བཏགས་ནས་བརྡ་ཡིན་པར་བརྗོད་དེ།",
    "འོན་ཏེ་གལ་ཏེ་དོན་དམ་པར་དངོས་པོར་གྱུར་པའི་འབྲེལ་པ་མེད་ཅེས་བསྟན་པ་མ་ཡིན་ནམ།",
    "དེ་བཞིན་དུ་ཉན་པ་པོ་ཡང་འདི་སྙམ་དུ་དེ་ཉིད་ཀྱིས་དོན་དེ་ཉིད་རྟོགས་པར་བྱེད་དོ་སྙམ་སྟེ།",
    "དེ་མ་ཡིན་ན་བློ་ཐ་དད་པ་ལ་གནས་པ་དག་ཇི་ལྟར་ཐ་སྙད་དུ་བྱེད་པར་འགྱུར་ཞེ་ན།",
    "རྨོངས་པར་ཞེས་བྱ་བ་ནི་འཁྲུལ་པས་སོ།",
    "ཐ་མི་དད་ན་ཡང་དངོས་པོ་དེ་གཅིག་ཁོ་ན་ཡིན་པའི་ཕྱིར་གང་ཞིག་གང་དང་ལྷན་ཅིག་འབྱེལ་པར་འགྱུར།",
    "དེའི་ཞེས་བྱ་བ་ནི་འབྱེལ་པའི་རིམ་པ་བརྗོད་དེ་སྟོན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྦྱོར་བ་ནི་སྔ་མ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "ཕྱིར་ན་ཐ་སྙད་འཇིག་པར་འགྱུར།",
    "དང་པོ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་སྤྱི་བརྟགས་པར་རོ།",
    "འབྱུང་པོ་རྣམས་ཉི་མ་ལ་སོགས་པའི་གཟའ་རྣམས་ཀྱི་མགུལ་ཆིངས་བཞིན་དུ་ཁྱེད་ཅག་སྤྱོད་པ་བ་རྣམས་ཀྱི་༤རིགས་ཐ་དད་པར་མི་འདོད་ལ་བལྟར་༥རུང་བ་ཉིད་ཡིན་པ་ནི་༦་སྣང་བ་ཡང་མ་ཡིན་ཞིང་ཐ་མི་དད་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཅི་སྟེ་ཡང་ཐ་དད་པར་ཁས་ལེན་ན་དེའི་ཚེ་འབྲེལ་པ་མེད་པའི་ཉེས་པ་དང་ཐ་དད་པ་རྣམས་ཀྱི་འབྱེལ་པ་ནི་དེ་ལས་བྱུང་བའི་མཚན་ཉིད་ཁོ་ནར་འགྱུར་ཏེ།",
    "གལ་ཏེ་བུམ་པ་ལ་སོགས་པ་རིགས་དེ་ལས་སྐྱེ་བར་ཁས་ལེན་པར་བྱེད་ན།",
    "དེ་ལྟ་ནའང་དངོས་པོ་གཅིག་ཉིད་དུ་ཁས་བླངས་པར་འགྱུར་གྱི་གཅིག་གཉི་གའི་བདག་ཉིད་ནི་མ་ཡིན་ནོ།",
    "དེ་ནི་སོ་སོར་ངེས་པའི་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་གནས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་འབྲེལ་པ་ནི་ནུས་པའི་མཚན་ཉིད་དུ་འདོད་ལ་སྐྱེད་པར་བྱེད་པའི་ངོ་བོ་ཡང་ནུས་པ་ཞེས་བྱའོ།",
    "དེ་ཡང་རྟག་པ་དང་གཅིག་པུའི་རང་བཞིན་དང་དོན་རྟོགས་པ་སྐྱེད་པར་བྱེད་པ་ལ་ངེས་པར་ཧཱུཾ་འདོད་དོ།",
    "དེ་ལྟ་ན་དོན་རྟོགས་པ་ལ་ངེས་པ་ཡིན་ན་སྐྱེས་བུ་ཉུང་ཟད་ཀྱི་མཚམས་དང་འབྲལ་ཀླེབ་མཚམས་མེད་པར་འདོད་དམ།",
    "ཕྱོགས་གཉིས་པ་ལ་ཡང་སོ་སོར་ངེས་པའི་ཤེས་པ་སྐྱེད་པར་བྱེད་པའི་རང་བཞིན་ངེས་པའི་རྒྱུ་བརྗོད་པར་བྱ་སྟེ།",
    "རང་བཞིན་ནི་བརྒལ་ཞིང་བརྟག་པར་འོས་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "འོ་ན་དེ་ལྟ་ན་གལ་ཏེ་དེའི་རང་བཞིན་འདི་རང་ཉིད་ཀྱིས་༢ཡིན་གྱི་གཞན་ལ་ལྟོས་པ་མེད་པ་ཡིན་ན་དེའི་ཚེ་བརྡ་འཛིན་པ་ལས་སྔ་རོལ་དུ་དང་བརྡ་བརྗོད་པའི་སོ་སོར་ངེས་པའི་རྟོགས་པ་པོ་དེའི་ཤེས་པ་ཐམས་ཅད་ཀྱི་ཚེ་འཇུག་པར་འགྱུར་ཏེ།",
    "དེའི་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ལ་ངེས་པའི་ནུས་པ་ཐམས་ཅད་ཀྱི་ནཚེ་གནས་པའི་ཕྱིར་རོ།",
    "ཡང་ཅི་སྟེ་ཤེས་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་འབྱེལ་པའི་མཚན་ཉིད་ཀྱི་ནུས་པ་ཤེས་ན་ཤེས་པ་སྐྱེད་ཧཱུཾཔར་བྱེད་པ་ཡིན་གྱི་མ་ཤེས་པར་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཤེས་པ་དང་མི་ཤེས་པའི་གནས་སྐབས་གཉིས་ཕན་ཚུན་ཐ་དད་པར་འདོད་ན་དེའི་ཚེ་རྟག་པ་ཉམས་ལ་ཅི་སྟེ་ཐ་མི་དད་ན་དེའི་ཚེ་ཤེས་པ་དང་མི་ཤེས་པའི་རང་བཞིན་གཉིས་ཀྱི་རྣམ་པར་དབྱེ་བ་མི་འཐད་དེ།",
    "གཞན་ཡང་ནུས་པ་རྟོགས་པར་བྱེད་པའི་ཐབས་ཡོད་ན་ཤེས་པ་ཉིད་དུ་འགྱུར་ན།",
    "ངེས་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བྱེད་པ་ནི་བྱེད་པ་པོས་བྱས་པའི་གཡོ་བས་རྗེས་སུ་དཔག་པ་ཉིད་དུ་བརྗོད་དོ།",
    "འབྲེལ་པ་རྟག་པ་མེད་ན་ཡང་རྟོགས་ཙོ་པ་སྲིད་པར་བསྟན་ཟིན་པའི་ཕྱིར་རོ།",
    "འདིར་ནི་དེའི་ཁྱབ་པ་ཙམ་ཞིག་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་སྒྲ་རྣམས་ནི་དོན་རྟོགས་པའི་མཚན་ཉིད་ཀྱི་འབྲེལ་བས་འབྱེལ་པ་རྟག་པ་དང་ལྡན་པར་འདོད་ལ་ནུས་པ་དེ་ཡང་རྟག་པའི་ཕྱིར་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པས་བརྡ་ལ་སོགས་པས་འགའ་༤ཞིག་ལ་ཡང་ལྟོས་པ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་དུ་མ་ཡིན་ཞེས་རྣམ་པར་བརྟག་༦གོ།",
    "དེ་ལ་ཕྱོགས་དང་པོ་ལ་ཡུལ་དང་དུས་ལ་སོགས་པ་ཐ་དད་པས་བརྡ་གཞན་བྱེད་པ་ན་སྒྲ་དོན་གཞན་རྟོགས་པར་བྱེད་པ་གང་ཡིན་པ་འདི་མཐོང་སྟེ།",
    "མི་གཡོ་ཞེས་བྱ་བ་ནི་རྟག་པ་སྟེ་འདི་ཡང་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ལ་གཏན་ཚིགས་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་སྒྲ་རྣམས་ལ་དོན་དུ་མ་སྟོན་༥པར་བྱེད་པའི་ནུས་པ་ཡོད་ཀྱི་ཐུདོན་རྣམས་ལ་དོན་གྱི་ཛྭབྱ་བ་ཐམས་ཅད་བྱེད་པ་ཉིད་མེད་དེ་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་སོ་སོར་ངེས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་ལོག་པ་ཉིད་སྲིད་པའི་ཕྱིར་རྟག་པར་བརྟགས་པ་དོན་མེད་པ་ཉིད་ཡིན་ནོ།",
    "གལ་ཏེ་འབྲེལ་པ་ཡོད་པ་ཙམ་གྱིས་དོན་རྟོགས་པའི་རྒྱུར་གྱུར་ན་དེའི་ཚེ་བརྡ་མི་ཤེས་པ་ལ་ཡང་འགྱུར་བའི་ཕྱིར་གདོན་མི་ཟ་བར་དེ་ནི་བརྡ་ལ་ལྟོས་པ་ཉིད་དུ་འདོད་པར་བྱའོ།",
    "དོན་རྟོགས་པ་བསྐྱེད་༤པར་བྱེད་པ་གང་ཡིན་པའོ།",
    "ཁྱད་པར་བོགས་དབྱུང་དུ་མེད་པ་དེ་ནི་འགའ་ཞིག་ལ་ཡང་ལྟོས་པ་མ་ཡིན་ནོ་ཞེས་ལན་བརྒྱར་དཔྱད་ཟིན་ཏོ།",
    "ནུས་པ་མ་མཐོང་བ་རྒྱུ་ཉིད་དུ་རྟོགས་ན་ཀྱེ་༥མ་ཨ་རུ་ར་དང་ཕྲད་ནས་ལྷས་༦འཁྲུ་བར་བྱས་སོ་ཞེས་ཅིའི་ཕྱིར་རྟོགས་༧པར་མི་བྱེད།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པས་འབྱེལ་པའི་བྱ་བ་དེ་ཉིད་མ་གྲུབ་པར་སྟོན་པ་ཡིན་ནོ།",
    "འདི་ལྟར་འབྱེལ་པ་རྟོགས་ན་ཡང་གཞན་ཡང་ནུས་པ་མ་མཐོང་བའི་རྒྱུ་གཞན་ཅིའི་ཕྱིར་རྟོགས་ཏྲེ་པར་མི་བྱེད་དེ་ནུས་པ་མ་མཐོང་བ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་དོན་གྱི་༡གོ་བ་སྔར་མ་ངེས་པ་ཉིད་དུ་བསྟན་པ་མཇུག་སྡུད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་བྱས་ན།",
    "གལ་ཏེ་ཐམས་ཅད་མི་ཤེས་པ་ཉིད་ཡིན་ན་འོ་ན་ཇི་ལྟར་སྔ་མ་སྔ་མས་མི་ཤེས་པའི་ཕྱིར་འབྱེལ་པ་གྲུབ་པར་འགྱུར།",
    "ལོང་བ་བརྒྱུད་པ་ནི་གཞན་དག་ལ་གཟུགས་ཀྱི་ཁྱད་པར་འདོམ་པར་བྱ་བའི་ཕྱིར་ནུས་པ་མ་ཡིན་ནོ།",
    "འདི་ལྟར་དོན་ཀྱིས་གོ་བས་འབྱེལ་པ་ཙམ་ཡོད་པ་ཉིད་དུ་རྟོགས་ཀྱིས་ཁྱབ་པར་ནི་མ་ཡིན་ཏེ།",
    "འདི་སྙམ་དུ་སྒྲ་མི་རྟག་པ་ནི་དོན་རྟོགས་པར་བྱེད་པའི་རྒྱུ་ཉིད་དུ་མ་མཐོང་ལ་རིགས་པ་ཡང་མ་ཡིན་ནོ་ཞེས་སྔར་བསྟན་ཟིན་ཏོ།",
    "དེའི་ཕྱིར་ཤུགས་ཀྱིས་རྟག་པ་གྲུབ་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་ན།",
    "འདི་ལྟར་འབྱེལ་པ་རྟག་པ་ལ་ཡང་དོན་རྟོགས་པའི་རྒྱུ་ཉིད་དུ་མ་མཐོང་བའི་ཕྱིར་མཚུངས་ལ་ལག་བརྡ་ལ་སོགས་པ་མི་རྟག་པ་ཉིད་ལ་ཡང་རྟོག་པར་བྱེད་པ་ཉིད་མཐོང་བའི་ཕྱིར་མ་མཐོང་བ་ཉིད་མ་གྲུབ་པོ།",
    "འོན་ཏེ་ག་བ་ལ་སོགས་པའི་སྒྲ་རྣམས་ལེགས་པར་བྱས་པ་མ་ཡིན་པའི་ཕྱིར་གཞན་གྱིས་རྗོད་ཉུ་པར་བྱེད་པ་ཉིད་མི་འདོད་པ་མ་ཡིན་ནམ།",
    "དེ་མི་ནུས་བྱུང་ཅན་བྱས་པའོ།",
    "རྩ་བ་སྟེ་གཙོ་བོ་ལ་ལེགས་པར་བྱས་པའི་གའི་ཕྱརྗེས་སུ་འབྲངས་ནས་དེ་ལ་ནུས་པ་མེད་པ་ལས་བྱུང་བ་ཅན་གྱེས་བྱས་པའི་ཞེས་བྱ་བ་དང་།",
    "ལེགས་པར་བྱས་པའི་གོ་སྒྲ་དེ་ལ་སྐྱེས་བུས་བརྗོད་པ་ཉིད་དུ་མི་ནུས་པ་ནི་དེ་མི་ནུས་པའོ།",
    "གཟུང་སྙེབར་བྱ་བ་སྐྱེས་བུ་ནི་ག་བ་ཛྭལ་སོགས་པའི་སྒྲས་བརྗོད་པ་ན་བྱ་བ་དེ་ནི་འཛུད་པར་བྱེད་པ་ཉིད་དུ་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ལེགས་སྦྱར་སྦྱར་བྱས་ལ།",
    "དེ་ལྟ་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "འདི་ལྟར་ཧཱུཾདེ་དག་ནི་སླར་ལ་ལེགས་པར་སྦྱར་བའི་སྒྲ་ཉིད་ཀྱིས་དོན་སྟོན་པར་བྱེད་པ་ན་མགོ་རྨོངས་པར་འགྱུར་ཏེ།་",
    "དེ་ལྟ་བས་ན་རྩ་བའི་སྒྲའི་རྗེས་སུ་འབྲངས་ནས་དོན་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཡང་ན་ཡུལ་འཇིག་པ་དང་རིགས་ཆད་པའི་ངོ་བོའི་འཇིག་པར་འགྱུར་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་སྨྲས་པ་དེ་ལ།",
    "འོན་ཀྱང་ཁྱེད་ཅག་ནི་ཡུལ་འཇིག་པ་ལ་སོགས་པའི་ངོ་བོ་འཇིག་པར་བརྗོད་ལ།",
    "དགག་པར་མི་ནུས་པའི་ཕྱིར་ཚངས་པ་ལ་སོགས་པ་ལ་ཡང་དོགས་པ་ཡིན་ནོ།",
    "འཇིག་པ་དེ་གཉིས་ཀ་ལ་ཡང་རིག་བྱེད་འཇིག་པར་སྲིད་དེ།",
    "གལ་ཏེ་གཞན་དུ་བྱེད་པར་འདོད་པ་ན་རིག་བྱེད་ཀྱི་སྒྲ་གཞན་དུ་འཇུག་པར་མི་འགྱུར་བ་དང་གཞན་དུ་བྱེད་པར་འདོད་པ་ཡང་སྐྱེད་པར་མི་ནུས་པ་ཡིན་ན།",
    "སྐྱེས་ཐུ་དག་ཀྱང་ཁྱད་པར་དུ་འཕགས་པར་སྣང་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་སྤྱོད་པ་པ་དང་ངེས་ཚིག་ལ་སོགས་པས་རིག་བྱེད་ཀྱི་དོན་རྣམ་པ་མང་པོ་བྱེད་པར་མཐོང་སྟེ།",
    "ཙམ་གྱེ་སྒྲས་ནི་ཁྱབ་པ་སྟོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "ལྟར་རོ་བྱས་ཞེས་བྱ་བ་ནི་བྱེད་པ་ལའོ།",
    "འདིས་ནི་གཅིག་ཏུ་གཏོགས་པ་ནི་མི་མཐུན་པའི་ཕྱོགས་ལ་སྲིད་པར་བསྟན་པས་མ་ངེས་པ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ།",
    "སྔར་ཞེས་བྱ་བ་ནི་བྱེ་བརྟག་པར་རོ།",
    "ཡོད་པ་ཡིན་ཡང་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པའི་རིགས་དེ་བུམ་པ་ལ་སོགས་པའི་ཤིམཚན་ཉིད་ཀྱི་གསལ་བ་དང་འབྲེལ་པ་མི་རུང་བའི་ཕྱིར་དེས་ཐ་སྙད་ཉེ་བར་མཚོན་པ་རིགས་པ་མ་ཡིན་ནོ།",
    "དེས་ན་གསལ་བར་བྱེད་པ་རྟག་ཏུ་གནས་པའི་ཕྱིར་སྒྲ་ཡང་རྟག་ཏུ་དམིགས་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་གསལ་བ་རྣམས་མི་རྟག་པར་ཁས་བླངས་པའི་ཕྱིར་དེ་དང་འབྱེལ་པའི་རང་བཞིན་གྱི་རིགས་ཀྱང་མི་རྟག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་དང་འབྲེལ་པའི་རིགས་རྣམས་ཀྱང་མི་རྟག་པ་ཉིད་དུ་འགྱུར་ན་དེ་ལྟ་ན་དེ་དང་འབྱེལ་པའི་རང་བཞིན་གྱི་གསལ་བ་རྣམས་མི་རྟག་པ་ཉིད་དུ་གྲུབ་པར་འགྱུར་གྱི་གཞན་དུ་ན་འབྲེལ་པ་གཉིས་པ་མ་ཚང་བ་མེད་པ་ཡིན་པ་ན་གཞན་མ་ཚང་བར་རིགས་པ་མ་ཡིན་ཏེ།",
    "གཞན་དང་ཁྱད་པར་མེད་ཕྱིར་ཞེས་བྱ་བ་ནི་གཞན་ལས་ཁྱད་པར་མེད་པ་ནི་གཞན་དང་ཁྱད་པར་མེད་པ་སྟེ།",
    "གསལ་བར་བྱེད་པའི་དུས་ཀྱི་ཁྱད་པར་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གང་ཞིག་བརྗོད་པར་འདོད་གང་ལས།",
    "ནས་སྐྱེད་པར་བྱེད་དོ།",
    "ཚིག་སོ་སོ་ལ་ཚིག་རྣམས་རང་བཞིན་ཐ་དད་པའི་ཕྱིར་རྒྱུ་དང་འབྲས་བུ་ཐ་དད་པས་མཚོ་དང་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྟོགས་པ་ཐ་དད་པར་རིགས་ཀྱི་རྟག་པ་རྣམས་ནི་མ་ཡིན་ཏེ།",
    "དེ་དག་ལས་གོ་རིམས་དོན་གཞན་དུ་གྱུར་པར་འདོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལས་བྱུང་བའི་བརྗོད་པར་འདོད་པ་གང་ཡིན་པ་བྱེདེ་སྐད་ཅེས་བྱའོ།",
    "སྨྲ་བ་པོའི་རྒྱུད་ལ་ཡི་གེ་སྔ་མ་སྔ་མ་ཀུན་ནས་སློང་བར་བརྗོད་པར་འདོད་པ་ལས་བྱུང་བའི་ཕྱི་མ་ཕྱི་མའི་བརྗོད་པར་འདོད་པ་གཞན་དེ་ལས་ཕྱི་མ་ཕྱི་མའི་ཡི་གེ་སྐྱེ་བ་གང་ཡིན་པ་དེ་དྲན་པར་བྱེད་ཅེས་འཆད་པར་འགྱུར་བ་དང་འབྱེལ་ཏོ།",
    "ཧ་ཅང་མྱུར་དུ་ཐོས་མིན་ཞེས་བྱ་བ་ནི་མྱུར་དུ་ཐོས་པ་ནི་དྲན་པ་སྐྱེད་པར་བྱེད་མི་༦ནུས་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ཉིད་དུ་བསྐྱེད་བྱ་ཞེས་ཇི་ལྟར་འཐད་པར་སྦྱར་ཏེ།",
    "ཀུན་ནས་སློང་བའི་ཤེས་པ་ལ་བསྐྱེད་པར་བྱ་བར་འཛིན་པའི་ཕྱིར་ཉམས་སུ་མྱོང་བ་དྲན་པའི་ཤེས་པ་ལ་ལྟོས་ནས་རྒྱུ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྗོད་པར་བྱེད་པའི་སྒྲའི་བདག་ཉིད་ཀྱི་གསལ་བ་ཡང་དགག་པར་འདོད་ནས།",
    "དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་མ་དམིགས་པ་དེ་ལས་སླར་ལ་འདི་མེད་པ་ཉིད་དུ་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནི་ཕྱིན་ཅི་ལོག་ཏུ་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "གྲུབ་ན་ནི་གཏན་ཚིགས་ཚོལ་ཀེབའི་འབད་པ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "ཡི་གེ་རྣམས་ལ་ཁྱད་པར་མེད་པ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེ་བརྟགས་པ་དོན་མེད་དོ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་རྗེས་སུ་དཔག་པར་བྱ་བ་ཉིད་ལ་སྐྱོན་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བར་དགོངས་པའོ།",
    "ཅི་སྟེ་ཡང་འདི་རྗེས་སུ་དཔག་པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་རྟགས་མ་ཤེས་པ་ཤེས་པར་བྱེད་པར་མི་འགྱུར་བ་དེ་བཞིན་དུ་འདི་ཡང་འགྱུར་ཏེ་མི་ཤེས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཡི་ངྒ་སྔ་མ་སྔ་མས་བསྒོས་༢པའི་འདུ་བྱེད་ལེགས་པར་བྱས་པ་ཐོབ་པའི་བློ་ལ་སྒྲ་ཆ་མེད་པར་སྣང་བ་ཉིད་ཡིན་ནོ་སྙམ་དུ་སེམས་ན་སྒྲ་ཙམ་གྱིས་བསྒོས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "བློ་སྔ་མས་བསྒོས་པའི་ལེགས་པར་བྱས་པ་ཡོངས་སུ་སྨིན་པའི་བློ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཡི་གེ་རྣམས་ཉིད་ཇི་ལྟར་ཉམས་སུ་མྱོང་བ་བཞིན་དུ་ཕྱིས་སྲེད་པར་བྱེད་པའི་དྲན་པའི་ཤེས་པ་ངེས་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དེ་ལྟ་ཡིན་དང་ཡི་གེ་ལྷག་མ་ལ་སོགས་པ་སྤྱོར་བ་དོན་མེད་པར་འགྱུར་རོ།",
    "དེའི་ངོ་བོ་མ་ཡིན་ན་རྗོད་པར་བྱེད་པ་ཉིད་རྟག་པར་འགྱུར་ཏེ།",
    "རང་ཉིད་ཀྱིས་དོན་བྱེད་པའི་ཆ་ཤས་དེ་དག་ཀྱང་དེ་དག་ལ་དེའི་བདག་སམ་ཡིན་པར་རྟོགས་༦ན་སྒྲོ་བཏགས་པར་འགྱུར་ཏེ།",
    "ཅིའི་ཕྱིར་མ་མཐོང་བའི་གསལ་བའི་ཆ་ཤས་རྟོགས་ཀྱེ་པར་བྱེད།",
    "དེའི་ཚེ་དེ་དག་ཉིད་ངག་ཏུ་བརྗོད་པའི་ཕྱིར་གཅིག་ཡན་ལག་དུ་མའི་བདག་ཉིད་དུ་གྲུབ་པར་མི་འགྱུར་རོ།",
    "གསལ་བར་བྱས་པ་དེ་ལྟ་ན་ཡང་ཕྱི་རོལ་གྱི་སྒྲ་སྤྱོར་བ་དོན་མེད་པ་མ་ཡིན་ཏེ།",
    "ཡང་བཟླས་པས་དེའི་ཁྱད་པར་གཞན་བྱེད་པ་ཡང་མ་ཡིན་པ་ལ་ཡང་བཟླས་པ་དོན་མེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འདི་ལ་ཡང་ཕྱིས་ཀྱི་སྒྲ་དོན་མེད་པར་མི་འགྱུར་རོ།",
    "རྟོགས་པར་དཀའ་ཞེས་བྱ་བ་ནི་ངེས་པར་གཟུང་བར་མི་ནུས་པའོ།",
    "ཀྭ་ཡེ་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "དེས་བྱས་པ་ན་གསལ་བར་མ་བྱས་པར་མི་འགྱུར་ཏེ།",
    "བཟླས་པ་དེ་བས་གཅིག་ཉིད་ཀྱིས་ཡང་ནས་ཡང་དུ་བཟླས་པར་བྱ་བར་ནུས་པའི་ཕྱིར་ཡི་གེ་ལྷག་མ་བརྗོད་པ་དོན་མེད་དོ།",
    "ནུས་པ་ཐ་དད་པ་ཉིད་དུ་ཁས་བླངས་ནས་ཆ་ཤས་རྔེད་པའི་ཁྱད་པར་གཞན་བརྗོད་པར་མི་ནུས་པའི་ཕྱིར་དང་།",
    "དེ་ཇི་ལྟར་གསལ་བ་མེད་པར་ཡི་གེ་མཐའ་དག་སྣང་བའི་དྲན་པའི་ཤེས་པ་ཅི་རིགས་པ་ཡིན།",
    "དེའི་ཚེ་རིམ་གྱིས་ཉམས་སུ་མྱོང་བའི་བརྒྱ་ལ་སོགས་པ་ལ་ཅིག་ཅར་བརྒྱ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བརྒྱ་དང་བྱེ་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ཀྱང་སྐྱེ་བའི་དུས་ཐ་དད་པར་མི་འགྱུར་རོ།",
    "དེས་ན་ཞེས་བྱ་བས་མཇུག་སྡུད་པར་བྱེད་དེ།",
    "ཇི་ལྟར་དེ་ལ་གནས་པར་འགྱུར།",
    "དེ་ལྟ་ཡིན་དང་མཐའི་ཡི་གེ་ལ་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་གསལ་བར་སྨྲ་བ་ལ་ཚོགས་པའི་ཤེས་པ་བརྗོད་པ་ན་གཞོན་ནུ་མ་ལེན་ཀྱིས་སྨྲས་པ།",
    "ཁྱེད་ཅག་དཔྱོད་པ་པ་ཤེས་པ་རྣམ་པ་མེད་པར་སྨྲས་པ་ལ་ནི་མ་ཡིན་པ་དེས་ན་དེ་ལྟར་བསྟན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡི་གེ་དེ་དག་ཉིད་སྔར་ཉམས་སུ་མྱོང་བ་ན་ཕྱིས་གསལ་བ་རྣམས་བསྒྲིབས་པ་ཚོགས་པའི་ཤེས་པས་འཛིན་པར་འགྱུར་ན།",
    "སྔར་ཞེས་བྱ་བ་ནི་དུས་གསུམ་བརྟགས་པར་རོ།",
    "འདིར་སྒྲ་པ་དག་རྩོད་པར་བྱེད་དེ།",
    "མྱུར་ཕྱིར་ནི་མགྱོགས་པར་བརྗོད་པའི་ཕྱིར་རོ།",
    "ལྷས་བྱིན་ལ་སོགས་པའི་ཚིག་ནི་ཡི་གེ་སོ་སོ་ལ་དབྱངས་དང་བཅས་པ་རྣམ་པར་ཆད་པས་གསལ་བར་ཐ་དད་དུ་གཏོགས་པ་ཡིན་པའི་ཕྱིར་བློ་གཅིག་པ་ཉིད་ཕྱོགས་ཀྱི་ཕྱོགས་གཅིག་ལ་མ་གྲུབ་པོ།",
    "འདིར་འབྲས་བུ་ཉིད་ཀྱི་ཐ་སྙད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེས་ན་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་དག་ཐ་དད་དོ།་།",
    "ཅེས་བྱ་བ་དང་གཞི་མཐུན་པར་སྦྱར་རོ།",
    "འདི་ལྟར་རྟག་པའི་ཕྱིར་གོ་རིམས་དུས་ཀྱིས་བྱས་པ་མ་ཡིན་ལ།",
    "སྒྲ་འདི་གང་ཡིན་བརྗོད་པར་བྱ།",
    "དེའི་ཕྱིར་ཁྱད་པར་མེད་པར་བསྟན།",
    "སྔར་ཞེས་བྱ་བ་ནི་སྤྱི་བརྟག་པར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དུ་བ་ལ་སོགས་པ་ལ་ཡང་རྣམ་པར་རྟོགས་པར་བྱ་བར་ནུས་ཏེ།",
    "འོན་ཏེ་རྣམ་པར་ཤེས་པ་དང་།",
    "དུས་ལ་སོགས་པའི་རྣམ་པར་འགྱུར་བ་ཡིན།",
    "བྱས་དང་མི་རྟག་སྒྲུབ་བྱེད་གང་།",
    "སོ་སོར་བརྟགས་པས་འགོག་༩པ་ལ་སོགས་པ་དེ་རྩོམ་པར་བྱེད་པ་ཞེས་བྱ་བ་དགག་པ་སྐྱེ་དང་སྦྱར་རོ།",
    "ཀུན་རྫོབ་ཏུ་འབྲས་བུ་འགའ་ཞིག་རྩོམ་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེའི་གནས་སྐབས་བཀག་པ་ཉིད་མི་རྟག་པར་སྒྲུབ་ཇེཔར་འདོད་དེ།",
    "གལ་ཏེ་དེ་དག་འགྲོ་ན་དེ་དག་ཉཉེ་བ་ན་གནས་པའི་རྩྭ་དང་རས་བལ་ལ་སོགས་པ་ཅིའི་ཕྱིར་སྲེད་རྔུཔར་མི་བྱེད་ཅེ་ན།",
    "འདི་ནི་རྟག་ཆེཔ་ཙམ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།་",
    "རྟག་པ་འདི་བདེན་༥ཡང་དཔེ་བསྒྲུབ་པར་བྱ་བ་མ་ཚང་བ་ཡིན་ཏེ།",
    "སྒོན་མ་ལ་སོགས་པ་ལ་དེའི་གནས་སྐབས་ཉིད་མེད་པའི་ཕྱིར་གང་ལས་བསྒྲུབ་པར་བྱ་བ་མ་ཚང་བ་ཉིད་ཡིན།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འབྱེལ་པ་མི་བྱེད་པར་རིགས་ཕྱིར།",
    "ངག་རྣམ་པར་དཔྱད་པར་བྱ་བའི་ཕྱིར་ཇི་ལྟར་ངག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཡང་ན་ཡི་གེ་ཉིད་ཁྱད་པར་ཅན་གྱེ་རིམ་པས་འཇུག་པས་ངག་ཡིན་ནམ།",
    "གྲོག་མ་དང་ཡིག་འབྲུ་ལ་སོགས་པ་བཞིན་དུ་ཡུལ་གྱིས་བྱས་པའམ།་",
    "དུས་ཀྱིས་བྱས་པ་སྟེ།",
    "ནམ་མཁའ་བཞིན་དུ་ཡུལ་ཐམས་ཅད་དུ་ཁྱབ་པར་གནས་པ་ལ་ནི་ཡུལ་རྣམ་པར་ཆད་པས་བྱས་པའི་རིམ་པ་རིགས་པ་མ་ཡིན་ཏེ།",
    "རྟག་པ་ཉིད་ཀྱིས་ཐམས་ཅད་དུས་མཚུངས་པའི་ཕྱིར་དུས་ཀྱིས་བྱས་པ་ཡང་མ་ཡིན་ནོ།་།",
    "གཞན་ཡང་རིམ་པ་སྐྱེས་བུས་བྱས་པ་ཡིན་ནམ།",
    "རིག་༤བྱེད་སྐྱེས་བུས་མ་བྱས་པའི་ཕྱིར་རོ།",
    "ངོ་ཤེས་པས་ཡི་གེ་རྣམས་རྟག་པ་དང་༧གཅིག་པུ་ཉིད་དུ་གྲུབ་པའི་ཕྱིར་ཡི་གེ་རྣམས་ཚིག་ཞེ་སོ་སོ་ལ་ཐ་དད་པར་ཁས་ལེན་པས་མཚོན་ཏེ།",
    "སྐྱེས་བུས་འཕྲལ་བྱས་པ་སྟེ།",
    "དེ་དག་ལ་སྒྲ་དང་དོན་ཞེས་བྱ་བའི་ནུས་པའི་མཚན་ཉིད་ཅན་གྱི་བརྗོད་པར་འདོད་པའི་འབྲེལ་པ་བརྟག་པ་ཡོད་པ་ཡང་མ་ཡིན་པ་དེ་བཞིན་དུ་རིག་བྱེད་ལ་ཡང་སྲིད་པ་ཡིན་ནོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "འཕྲལ་ལ་བྱས་པའི་གཏམ་རྒྱུད་ལ་སོགས་པ་དེ་ལ་ཡང་ནུས་པ་རྟག་པ་ཉིད་དུ་འདོད་པ་ཁོ་ན་སྟེ།་",
    "འོན་ཀྱང་མེད་པའི་དོན་ལ་ངེས་པར་སྦྱོར་བ་སྐྱེས་བུས་བྱས་པ་གང་ཡིན་པ་དེ་ནི་མི་རྟག་སྟེ།",
    "དེ་ལ་ཕྱི་རོལ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་གཞན་དག་རྩོད་པར་བྱེད་དོ།",
    "འོན་ཏེ་འདི་ནི་སྐྱེས་བུས་བྱས་པའི་ལུང་དག་ལ་ཡང་མཚུངས་ཏེ།",
    "རིགས་པར་སེམས་པ་ལས་སྐྱེས་པའི་ངེས་པས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།་།",
    "འདི་ལྟར་དེ་ལ་སྐྱེས་བུས་བྱས་པའི་ཚིག་ལ་སྐྱེས་བུ་རང་ཉིད་ཀྱི་བསམ་པ་བརྟན་པ་ཕྱིན་ཅི་མ་ལོག་པའི་གདམས་ངག་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་སྐྱེས་བུས་མ་བྱས་པ་ལ་ནི་མ་ཡིན་ཏེ།",
    "གཞན་ཡང་སྟོན་པ་པོ་བརྩེ་བས་འཇིག་རྟེན་གྱིས་ཤེས་པར་བྱ་བའི་ཕྱིར་སྨྲ་བ་ན་འཇིག་རྟེན་གྱི་བརྡ་ཉིད་ཀྱི་རྗེས་སུ་འབྲངས་ནས་སྨྲ་བས།",
    "དེའི་ཕྱིར་འཇིག་རྟེན་ལ་གྲགས་པ་ལས་ཀྱང་དོན་དེ་འགྲུབ་པར་འགྱུར་གྱི་དེ་ལ་འདོད་པ་མེད་པའི་ཕྱིར་སྐྱེས་བུས་མ་བྱས་པ་ཇེནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཅིའི་ཕྱིར་ཁྱེད་ཅག་ལུང་གང་ཡང་རུང་བས་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "གལ་ཏེ་དེ་ལྟ་ན་རིག་བྱེད་ལ་ཡང་རིགས་པ་འདིས་འཇུག་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེས་ནི་ཡུལ་གཉིས་རྣམ་པར་དག་པ་སྲིད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་དངོས་པོ་འགའ་ཞིག་རྟག་པ་ཉིད་དུ་འདོན་པ་དེ་ཡང་བརྟན་པའི་དངོས་པོ་རྟག་པར་མི་རིགས་པ་ཉིད་དུ་བསྟན་ཟིན་ཏོ།",
    "དེ་བཞིན་དུ་ཁྱད་པར་དུ་བྱར་མེད་པ་སྔར་བྱེད་པ་པོ་མ་ཡིན་པ་གཞན་ལ་ལྟོས་ནས་སྐྱེད་ནཔར་བྱེད་པ་ཉིད་དང་།",
    "གང་ཡང་གཞོན་ནུ་མ་ལེན་གྱི་༤འབྱེལ་པ་རྟག་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་གཞན་སྨྲས་པ་དེ་ནི་འཕྲལ་ལ་བྱས་པའི་གཏམ་རྒྱུད་ཀྱི་ངོ་བོ་ཟློས་གར་ལ་སོགས་པས་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "འདི་ནི་འཕྲལ་བྱས་པའི་དོན་ཡང་ཡིན་ལ།",
    "གཏམ་རྒྱུད་ཀྱང་ཡིན་ནོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་བཞིན་དུ་འབྱེལ་པ་བྱེད་པའི་ཐབས་མེད་པའི་ཕྱིར་འབྱེལ་པ་མི་བྱེད་པར་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ནོ།",
    "སྐྱེས་བུ་ཐམས་ཅད་ཀྱང་འབྱེལ་པ་བྱེད་པའི་ཐབས་དང་བྲལ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པའོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་རྒྱུ་བཞིན་དུ་འབྱེལ་པ་བརྗོད་པ་མེད་པར་རྗེས་སུ་དཔག་པར་༧འགལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཁྱབ་པར་བྱེད་པའི་སྐད་ཅིག་མ་འཇིག་པར་བསྒྲུབས་ཟིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མིན་ན་ཉམས་ཞེས་བྱ་བ་ནི་གལ་ཏེ་རྒན་པོ་རང་ཉིད་མི་ཤེས་པ་ཡིན་ན་ཡང་འབྲེལ་པ་རྟོགས་པར་བྱེད་དོ་ཞེས་འདོན་ན་དེའི་ཚེ་མཐོང་བ་དང་འགལ་ཏེ།",
    "སྒྲུབ་བྱེད་བཞིན་ན་བརྗོད་པར་བྱ།",
    "འདིས་ནི་འདི་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པ་ཉིད་ཡིན་པར་བསྟན་ཏེ།",
    "དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་གཞན་དུ་བྱ་བར་མི་ནུས་པ་དེ་ཉིད་ཀྱི་ཕྱིར་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པའི་རྗེས་སུ་དཔག་པ་ཟློག་པ་སྒྲུབ་པར་བྱེད་པ་མི་སྲིད་ལ།",
    "ཡི་གེ་རྣམས་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་ཡིན་ན་འདི་ཐམས་ཅད་མི་འཐད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "འོན་ཏེ་རིག་བྱེད་འདོད་སྙེཔར་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདིའི་ཁྱབ་པ་ཐམས་ཅད་ཉེ་བར་བསྡུས་ནས་གྲུབ་པ་མ་ཡིན་ནམ།",
    "སྐྱེས་བུ་ཐམས་ཅད་ཀྱིས་བྱ་བར་ནུས་པ་མེད་པར་ངེས་པར་བྱ་བ་ཡིན་ན་དེ་ཁྱབ་པ་ངེས་པར་འགྱུར་རོ།",
    "དེ་ཇི་ལྟར་ཐེ་ཚོམ་ཟ་བའི་མ་གྲུབ་པར་འགྱུར་ཞེས་དོགས་པ་ལ།",
    "རིག་བྱེད་ཀྱི་འདོད་པས་ལོག་པར་གཡེམ་པ་ནི་འདོད་པ་ལོག་པར་སྤྱོད་པ་སྟེ་མ་ལ་སོགས་པ་ལ་༤འགྲོ་བ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བ་ལང་ཅན་གྱི་མཆོད་སྦྱིན་ལས་ཇི་སྐད་དུ་མཆོད་སྦྱིན་བྱེད་པ་ན་ཆུ་སོག་ཕྱཔར་བྱའོ།",
    "རྟའི་མཆོད་སྦྱིན་ལ་སོགས་པར་ཡང་སྲོག་ཆགས་གསོད་པ་ཉེ་བར་བསྟན་ཏེ།",
    "ནོར་བུ་འཕྲོག་ཚེ་བརྫུན་བྱས་གནོད་རྔེད་དེ།",
    "དེ་བཞིན་དུ་འདོད་པས་ལོག་པར་གཡེམ་པ་ལ་སོགས་པ་སྨྲ་བ་ནི་བརྗོད་པའོ།",
    "སྨྲ་དཀའ་བ་ནི་བརྗོད་པར་དཀའ་བའོ།",
    "འབྱོར་པ་ནི་རྣམ་པར་འབྱོར་པ་སྟེ།",
    "བདེ་བར་གཤེགས་པས་སྤུའདོན་པར་བརྗོད་པར་བྱ་བའི་ཕྱིར་ད་ལྟར་བའི་འདོན་པར་བྱེད་པ་བཞིན་ནོ།",
    "འདི་ལྟར་འདིར་ཡང་བྱེད་པ་དྲན་པའི་དོན་དུ་ཅིའི་ཕྱིར་འཆད་པར་མི་བྱེད།",
    "གལ་ཏེ་དོན་འདི་རིགས་པ་དང་ལྡན་པར་གྱུར་ན།",
    "དེས་ན་སྐྱེས་བུས་མ་བྱས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་བདེན་པའི་དོན་ཅན་དུ་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟ་ན་ཡང་འདི་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་དུ་བསྒྲུབ་པར་འདོད་པ་ཡིན་ལ་དེ་ཡང་མི་འགྲུབ་པོ།",
    "འདིར་མི་འདོད་པའི་ཐོག་མ་མེད་པ་ཉིད་འགྲུབ་པར་འགྱུར་རོ།",
    "འདི་སྙམ་དུ་ཐོག་མ་མེད་པ་ཉིད་གྲུབ་པ་ན་ཤུགས་ཀྱིས་མ་བྱས་པ་ཉིད་དུ་འགྲུབ་པ་ཁོ་ན་སྟེ།",
    "ཐོག་མ་མེད་པ་དེ་ལས་གལ་ཏེ་མ་བྱས་པ་ཉིད་དུ་གྱུར་ན་དེའི་ཚེ་པར་སེག་པ་ལ་སོགས་པའི་ཐ་སྙད་ཀྱང་འགྱུར་རོ།",
    "གཞན་གྱི་༢འདུས་བྱས་ལས་བྱུང་ཅན།",
    "ཞེས་བྱ་བ་ནི་གཞན་གྱི་འདུས་བྱས་པས་བྱུང་བ་དེ་དག་གང་ལ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཡང་ན་འདི་ལ་གཞན་གྱི་འདུ་བྱེད་པ་ལས་བྱུང་བའི་ངང་ཚུལ་ཡོད་པས་ནི་གཞན་གྱི་འདུས་བྱས་པ་ལས་བྱུང་བའོ།",
    "སྐྱེས་བུ་ཐམས་ཅད་ལ་བྱེད་པའི་ནུས་པ་མེད་པར་སྒྲུབ་པར་བྱེད་པ་ནི་གཏན་ཚིགས་མི་མཐུན་པའི་ཕྱོགས་ལ་གནས་ཀྱེ།",
    "གཏན་ཚིགས་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བ་ལས།་",
    "སྔར་བཞིན་ཞེས་བྱ་བ་ནི་རིག་བྱེད་འདོན་པར་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱི་སྒྲུབ་པར་བྱེད་པ་བཞིན་ནོ།་",
    "དཔེར་ན་བསྒྲུབ་བྱས་སྟོང་ཞེས་བྱ་བ་ནི་ད་ལྟར་གྱི་དུས་སུ་མཐོང་བ་བཞིན་ནོ།",
    "ཐ་མལ་པའི་མི་བཞིན་ནོ་ཞེས་བྱ་བ་དེ་དག་བསྒྲུབ་བྱས་སྟོང་པ་ཡིན་ནོ།",
    "འདི་ཡང་གཏན་ཚིགས་མ་གྲུབ་པ་དང་དཔེ་བསྒྲུབ་བྱས་སྟོང་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "གནོད་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་དག་ངེས་པར་མ་གྲུབ་པ་ཉིད་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེས་བྱས་བློ་གང་ལས།",
    "ཐོས་པར་སྐྱེས་བུས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བདག་ནི་འཇིག་པར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་འདི་ངེས་པར་མ་གྲུབ་པ་ཉིད་ཡིན་ནོ།",
    "ཐམས་ཅད་དུ་འཇུག་པར་བྱེད་པ་ཉིད་མ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བའི་ཚིག་འདི་སྒུལ་བར་བྱེད་པར་མི་འགྱུར་ཏེ།",
    "འཇུག་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུས་བྱས་པའི་ཚིག་ལས་བྱུང་བའི་ཤེས་པ་འགའ་ཞིག་འཁྲུལ་པ་ཡིན་གྱེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཐེ་ཚོམ་ཟ་བའི་མ་གྲུབ་པ་ཉིད་ཡང་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དོན་ནི་བརྗོད་པར་བྱ་བ་སྟེ།་",
    "འདི་ལ་སྐྱེས་བུས་མི་ཤེས་པའི་ངོ་བོ་དང་དོན་ཡོད་པ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།་།",
    "པའི་ཁྱད་པར་འདི་ཡིན་ནམ།",
    "ངེས་པ་མེད་པར་སྣང་བར་འགྱུར་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "མ་བྱས་པ་ཉིད་ཅེས་གང་སྨྲས་པ་དེ་ལ།",
    "རྣམ་གཡེམ་པའི་ཞེས་བྱ་བ་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པ་གཙང་བ་རྣམས་ཏེ།",
    "ཕྱུགས་གསོད་པ་དང་འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་ལ་སོགས་པའི་དྲི་མས་མ་གོས་པ་རྣམས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྟོན་མཛད་སྐྱེས་བུ་འདོད་པར་གྱེས།་།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟ་ན་ནི་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་དེ་རྟག་༤པ་དོན་དང་བཅས་པ་ཉིད་དུ་འགྱུར་རོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་སྐྱེས་བུས་མ་བྱས་པ་བརྟགས་པས་ཅི་ཞིག་བྱ།",
    "རྣལ་འབྱོར་པ་རྗེས་སུ་དཔག་པ་ནི་ཕྱིས་བསྒྲུབ་པར་འགྱུར་བའི་ཕྱིར་རོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "གཞན་ངེས་པར་འཛིན་པའི་རྒྱུ་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "ཅིག་ཤོས་དག་མེད་པ་ལ་འདིའི་ངོ་བོ་གཞན་ངེས་པར་ནུས་པ་མ་ཡིན་པའི་ཕྱིར་འདི་ཇེ་ཚོམ་རྔེད་པར་ཉེ་བར་བརྗོད་པ་མེད་པ་ཉིད་དུ་འགྱུར་རོ།",
    "དཔེར་ན་ནམ་མཁའ་ལུས་ཅན་མ་ཡིན་པར་བྱ་བ་བཞིན་ནོ།",
    "དོན་གང་ཡིན་པར་འདོད་ཅེས་འདྲི་བ་ལ།",
    "ཤེས་པ་ནི་དོན་གཅོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་མིག་ལ་སོགས་པ་ཡིན་ན་དེའི་ཚེ་དེ་དག་དོན་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་དང་།",
    "འདི་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནི་དེའི་ཁྱབ་པར་བྱེད་པ་དང་འགལ་བའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་འཇོག་པར་བྱེད་ཅེ་ན།",
    "ཤེས་པར་བྱེད་པ་ཤེས་པ་ནི་ཤེས་པར་བྱ་བའི་དོན་ཤེས་པར་བྱེད་ཀྱི་ཡོད་པ་ཙམ་གྱིས་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟའི་དོན་རྒོ་ཞེས་བྱ་བ་ལ་སོགས་པས་སུན་འབྱིན་པ་རྩོམ་པར་བྱེད་དེ།",
    "དེ་ལ་རང་བཞིན་ཞེས་བྱ་བའི་དོན་ཅི་ཡིན་པར་འདོད།",
    "འདི་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟ་མ་ཡིན་ན་གྲུབ་པ་དང་བདེ་བ་ཐ་དད་པ་ཉིད་ཀྱི་ཕྱིར་ཐ་མི་དད་པར་མི་འགྱུར་རོ།",
    "རྟག་པའི་དངོས་པོའི་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "སྔར་ཐོས་པ་བརྟག་པར་རྒྱས་པར་རྟག་པའི་གསལ་བ་བཀག་ཟིན་ལ།",
    "རྒྱུ་གཞན་ལ་ལྟོས་པ་ཡང་ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པ་ལ་རིག་ཀྱེསྣཔ་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "གཅིག་ལ་ཕན་ཚུན་འགལ་བའི་རང་བཞིན་གཉིས་ཡོད་པར་རིགས་རྟེཔ་ཡང་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་བརྟན་པ་དང་མི་བརྟན་པའི་རང་བཞིན་ཐ་དད་པས་དངོས་པོའི་རྣམ་པ་གཉི་ག་ཡང་ཆ་མེད་པའི་ཕྱིར་བདག་ཉིད་ཀྱིས་ཡོངས་སུ་རྫོགས་པས་དུས་ཕྱིས་རྐྱེན་གཞན་གྱེ་བདག་ཉིད་དུ་བྱེད་པའི་ནུས་པ་མེད་པར་མི་ནུས་ལ།",
    "མི་བརྟན་པའི་དངོས་པོ་ལ་ཁྱད་པར་སུན་འབྱིན་པ་ནི།",
    "རྟོགས་པར་ཞེས་བྱ་བ་ནི་ངེས་པར་རོ།་།",
    "དེ་ཇི་ལྟར་རྟོགས་པར་བྱེད་པ་མི་ནུས་སྙམ་དུ་སེམས་ན།",
    "ཇི་ལྟར་གནས་པའི་ཤེས་བྱའི་དངོས་པོའི་རྟོགས་པ་དང་ཐོབ་པ་གང་༥ཡིན་པ་དེ་ལ་དེའི་ཡུལ་ཅན་གྱི་ནུས་པ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "འོ་ན་གང་ལས་དེ་ངེས་པར་བྱ་བ་ཡིན་ཞེ་ན།",
    "དེ་མཇུག་ཐོགས་ཉིད་དུ་མེད་པའི་ཕྱིར་ཞེས་ཚིག་རྣམ་པར་སྦྱར་ཏེ་མཇུག་ཐོགས་སུ་འབྲས་བུ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཞེས་བྱ་བ་ནི་དུག་ལ་སོགས་པའི་བདག་ཉིད་རྣམ་པར་མ་ངེས་ནའོ།",
    "དེ་དག་ནི་དེ་ལ་ཕན་འདོགས་པར་བྱེད་པ་ཡང་མ་ཡིན་པའི་ཕྱིར་རོཧཱུཾ་༧།",
    "ཕན་འདོགས་པར་མི་བྱེད་པ་ཡང་རྟེན་དུ་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་དངོས་པོ་རྣམས་སོ་སོར་ངེས་པའི་ནུས་པ་དང་ལྡན་པར་མི་འགྱུར་ལ་གཞན་དུ་ན་ཐམས་ཅད་ཐམས་ཅད་ལ་ཉེ་བར་སྤྱོར་བར་འགྱུར་རོ།",
    "གཞན་དག་ནི་འབྲས་བུ་ཡོད་པར་ལྟ་བ་ལ་བརྟེན་ནས།",
    "མེད་པ་སྐྱེད་༦ན་མེད་པར་ཁྱད་པར་མེད་པའི་ཕྱིར་ཐམས་ཅད་ཐམས་ཅད་ཀྱི་ཚེ་ཐམས་ཅད་དུ་སྐྱེ་བར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་དེ་ནི་མི་རིགས་ཏེ།",
    "དེ་བས་ན་རྒྱུ་དང་འབྲས་བུ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་མེད་པ་བྱེད་ཅེས་རྣམ་པར་རྟོག་པ་འདི་གཉིས་འཇུག་པ་ཡིན་ཏེ་ཅི་སྟེ་ཡོད་པ་བྱེད་དམ།་",
    "དེ་ལ་ཕྱོགས་དང་པོ་ལ་ནི་ཁྱད་པར་མེད་པའི་ཕྱིར་བྱེད་པ་མི་འཐད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "ཕྱོགས་གཉིས་པ་ཡང་མ་ཡིན་ཏེ་མེད་པ་བྱེད་པར་ཁས་མི་ལེན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དོན་གཞན་དུ་གྱུར་པ་བྱེད་ན་དེའི་ཚེ་དངོས་པོ་ལ་ཅུང་ཟད་ཀྱང་བྱས་པར་མི་འགྱུར་རོ།",
    "གཞན་བྱེད་པ་ན་གཞན་བྱས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཕན་གདགས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཀྱིས་དེ་དང་འབྲེལ་པ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཕན་འདོགས་པར་བྱ་བ་མ་ཡིན་པ་གཞན་ལ་ལྟོས་པར་ཡང་རིགས་༢པ་མ་ཡིན་ནོ་ཞེས་རྣམ་པ་མང་དུ་བསྟན་ཟིན་ཏོ།",
    "ཁྱད་པར་དུ་བྱར་མེད་པའི་ཕྱིར་རོ།",
    "བྱེད་པར་མི་རིགས་སོ་ཞེས་བྱ་བ་འདི་ཉིད་བསམ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེར་ཅི་ཞིག་དམིགས་ནས་རྒྱུ་རྣམས་ལྡོག་པར་འགྱུར།",
    "དེས་ན་རྒྱུའི་ནུས་པས་སོ་སོར་ངེས་པའི་ཕྱིར་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ངེས་པར་འགྱུར་རོ།",
    "དངོས་པོ་ཐམས་ཅད་སྐྱེད་པའི་ནུས་པ་ཡོད་པར་ཁས་བླང་བར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ནུས་པ་ཡང་རྣམ་པར་ཤེས་པ་སྐད་ཅིག་མ་ལ་བརྟེན་པའི་ཕྱིར་ཡོད་པར་བྱ་བ་ནུས་པ་མ་ཡིན་ཏེ།",
    "དུས་གསུམ་དུ་ཡང་དེ་བྱེད་པར་ཙོམི་འཐད་པའི་ཕྱིར་རོ།",
    "བརྟེན་པ་རྟེན་པ་མེད་པར་བྱེད་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དུས་དེ་ཙམ་དུ་གནས་པ་མེད་པའི་སྒོ་ནས་དེ་ཉིད་སྐད་ཅིག་མ་ཡིན་པའི་ཕྱིར་སྐྱེས་པ་ན་རྣམ་པར་ཤེས་པ་ཕྱིས་བྱེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "ནུས་པ་ཤེས་པ་དེ་ཉིད་ལ་བརྟེན་པ་ཡིན་ན་དེ་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་འཐད་པ་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་ཅན་གྱི་དོན་བྱ་བ་བྱེད་པའི་དངོས་པོའི་རང་བཞིན་ཉིད་དེའི་དངོས་པོ་ཙམ་ཤེས་པར་འདོད་པ་ན་ནུས་པ་ཞེས་ཐ་སྙད་དུ་བྱའི།",
    "རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་སྐྱེའོ་ཞེས་བྱ་བ་ཡོད་པ་རིགས་པ་ཁོ་ན་སྟེ།",
    "གནས་པའི་རང་བཞིན་ཉིད་དེ་ལྟར་ཁྱད་པར་གཞན་སྤངས་པའི་སྒོ་ནས་བརྗོད་ཀྱི་རྟེན་ཞེས་གནས་པ་པོའི་མཚན་ཉིད་བྱེད་པ་ནི་མ་ཡིན་པའི་ཕྱིར་ཅུང་ཟད་ཀྱང་མི་བྱེད་པ་ཁོ་ནའོ།",
    "གནས་པ་པོ་ལས་གནས་པ་ཐ་དད་པ་ཡིན་ན་ཡང་དོན་གཞན་དུ་གྱུར་པའི་གནས་པ་བྱེད་པའི་ཕྱིར་གནས་པར་བྱེད་པ་པོ་ཅུང་ཟད་ཀྱང་མི་བྱེད་པ་ཁོ་ནའོ།",
    "གཞན་བྱེད་པ་ན་གཞན་ལ་ཅུང་ཟད་ཀྱང་བྱས་པ་ཞེས་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རྣམ་པ་གཉི་ག་ལྟར་ན་ཡང་གནས་པར་བྱེད་པ་པོ་ནི་ཅུང་ཟད་ཀྱང་མི་བྱེད་པ་ཉིད་དོ།",
    "མ་ཡིན་ཏེ་གནས་པར་བྱ་བ་དང་གནས་པར་བྱེད་པ་གཉིས་གཞན་དུ་གནས་པ་དང་ལྡན་པར་གནས་པ་པོ་དག་ལྷན་ཅིག་འབྲེལ་པ་མ་གྲུབ་པའི་ཕྱིར་དང་།",
    "གཞན་ཡང་གལ་ཏེ་དངོས་པོའི་གནས་པར་བྱེད་པ་གནས་པ་ལས་དོན་གཞན་དུ་གྱུར་པར་༡ཁས་ལེན་པར་བྱེད་པ་དེའི་ཚེ་གནས་པར་བྱེད་པའི་གནས་པ་༢ཡོད་པའི་ཕྱིར་དངོས་པོ་འགའ་ཞིག་ཀྱང་འཇིག་པར་མི་འགྱུར་ལ།",
    "དེ་ཡང་ཅུང་ཟད་ཀྱང་མི་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་འཇིག་པར་བྱེད་པ་ཉིད་དུ་མི་རིགས་སོ།་།",
    "འོན་ཏེ་དངོས་པོ་ཉིད་ཡིན་ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་འདི་ཉིད་ཁོ་ན་འཇུག་པ་ཡིན་ནོ།",
    "གཞན་བྱེད་ན་ཡང་དངོས་པོ་ལ་ཅུང་ཟད་ཀྱང་མ་བྱས་པའི་ཕྱིར་དངོས་པོ་དེའི་གནས་སྐབས་ཁོ་ན་ཡིན་པའི་ཕྱིར་འཇིག་པ་མེད་པས་འཇིག་པའི་རྒྱུ་ཅུང་ཟད་ཀྱང་མི་བྱེད་དོ་ཞེས་རྒྱས་པར་བརྟན་པའི་དངོས་པོ་བརྟག་པར་གཏན་ལ་ཕབ་ཟིན་ཏོ།",
    "ཅི་སྟེ་རང་བཞིན་ཀྱི་བརྟན་པའི་ངོ་བོ་ཉིད་ཡིན་པ་དེ་ལྟ་ན་ཡང་དེའི་རང་བཞིན་གཞན་ཉིད་མི་སྲིད་པའི་ཕྱིར་འཇིག་པར་བྱེད་པ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "རང་ཉིད་གནས་པ་ཡིན་པའི་ཕྱིར་གནས་པར་བྱེད་པ་འགའ་༧ཡང་ཡོད་པ་ཡིན་པས་གནས་པ་དང་འཇིག་པའི་རྒྱུ་གཉི་ག་ལྟར་ཡང་ཅུང་ཟད་བྱེད་པ་མ་ཡིན་ནོ།",
    "གཞན་ཡང་གལ་ཏེ་དུས་གསུམ་ཆར་དུ་ཡང་ཤེས་པའི་ནུས་པ་སྐྱེ་བར་མི་འགྱུར་བ་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་ནུས་པ་ཐམས་ཅད་ཀྱིས་༤སྟོང་པར་འགྱུར་ཏེ།",
    "རྟག་པ་ཉིད་ཀྱི་རང་བཞིན་གྱི་ཁྱད་པར་འགའ་ཞིག་བྱར་མེད་པའི་ཕྱིར་ཏེ་སྤྲོས་པས་ཆོག་གོ།",
    "ཡང་རྣམ་པ་གཞན་གྱི་དམ་བཅའ་བའི་དོན་བརྟག་པར་བྱ་བའི་ཕྱིར།",
    "བདག་ཉིད་ཐོབ་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འདི་སྐད་དུ་ཞེས་བྱ་བ་༥རྣམས་ཀྱི་རང་ལ་ཡོད་པའི་ཡོན་ཏན་ཕྱིན་ཅི་མ་ལོག་པ་རྟོགས་པའི་བདག་ཉིད་དང་རྣམ་པར་དག་པའི་རྒྱུས་བསྐྱེད་པ་ཉིད་ཅེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་གང་དག་ཡིན་པ་དེ་དག་ངེས་པ་བསྐྱེད་པར་བྱ་བ་ལ་འདི་དག་རྒྱུ་རྣམས་ལ་ལྟོས་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལྟར་དམ་བཅའ་བའི་དོན་མི་འགལ་བར་བསྒྲུབས་ནས་དེའི་ངོ་བོ་ངེས་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདིའི་ཁྱབ་པ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "ཕྱོགས་གཉིས་པ་ལ་ཡང་ཐུག་པ་མེད་པའི་སྐྱོན་བསྟན་པར་བྱ་བའི་ཕྱིར།་",
    "འདི་སྙམ་དུ་མི་སླུ་༩བ་དང་ཡོན་ཏན་ཤེས་པ་དག་ནི་རྩ་བའི་ཤེས་པ་ལས་ཁྱད་པར་ཡོད་དེ།"
  ]
}