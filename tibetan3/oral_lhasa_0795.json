    "མཐོང་ལམ་དང་སྐྱེ་རིམ་གྱིས་གསུངས་པ་དང་འགལ་ལོ།",
    "བཅུ་པ་ལ་གཉིས་དོན་བཞག་པ་ནི་འགྱུར་རམ་ཡི་གེ་མ་དག་པར་གསལ་ཏེ།",
    "འདི་དག་ཀྱང་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "ཞེས་གསུངས་ལ།",
    "འདིའི་ངོ་བོ་ཉིད་ནི་ངེས་པར་བྱས་པའི་དངོས་པོ་ལ་ངེས་པར་འཛིན་པའོ།",
    "རྒྱུ་ལ་གོམས་པར་བྱེད་པའི་གནས་སྐབས་ཡིན་པས་སོ།",
    "ཞེས་གསུངས་ཀྱང་།",
    "ཕན་ཡོན་དུ་ཡུམ་ཡོད་པས་མངོན་མཐོ་དང་ངེས་ལེགས་ཐམས་ཅད་ཡོད་པར་བསྟན་པ་དང་།",
    "ཡུལ་བཅུ་གཉིས་ལ་མ་ཞེན་པའི་རྣམ་པར་དམིགས་པའི་ཤེས་རབ་དང་།",
    "ཞེས་གསུངས་ཤིང་།",
    "འདི་ཞེན་མེད་དུ་བསྟན་བཞེད་ནས་མཛད་ལ་བློས་མི་དམིགས་པར་མ་རྟོགས་ན་ཡུལ་མི་དམིགས་པ་ཡིན་ཀྱང་ཞེན་པར་བྱེད་པས་སོ།",
    "ལུང་འདིས་ཁྱད་པར་ཅན་ལ་སོགས་པ་སྔོ་བར་བྱེད་མཁན་ལ་མི་བྱེད་པར་བསྔོ་བའི་གྲངས་བཅུ་གཉིས་གང་ཞེས་པའི་ལན་དུ་སྦྱོར་བ་ཡང་བཀག་གོ།",
    "ཉན་ཐོས་སུ་འདུ་ཤེས་པར་མི་འགྱུར།",
    "དམིགས་པར་འཛིན་པའི་འདུ་ཤེས་དང་།",
    "ཡུམ་གྱིས་སྦྱིན་སོགས་༡མི་དམིགས་པར་བསྔོ་བའི་ཐབས་ལ་མཁས་པ་དང་བཅས་པ་ནི།",
    "དེས་ན་ཡུམ་འདིར་བྱང་ཆེན་གྱི་ཐབས་མཁས་རིག་པར་བྱ་སྟེ།",
    "ཁམས་གསུམ་པར་མ་གཏོགས་པ་སྟེ་དེ་ལ་ཞེན་པ་མེད་པ་ནི་འདོད་པ་དང་སོགས་པས་གཟུགས་གཟུགས་མེད་ཀྱི་ཁམས་ཏེ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "ཕྱིར་མི་འོང་བ་དང་དགྲ་བཅོམ་པར་གྱུར་ཏེ་ཞེས་དང་།",
    "དེ་བཞིན་དུ་རང་རྒྱལ་དུ་གྱུར་པ་ལ་ཡང་གསུངས་ནས་སྔར་ལྟར་དྲིས་ལན་མཛད་པའོ།",
    "འདིས་ནི་བསྔོ་བ་ཐ་མ་གསུམ་ངོ་བོ་ཐ་དད་པར་འདོད་པ་ཡང་བཀག་ལ་ཆུང་འབྲིང་ཆེ་གསུམ་གྱི་དབྱེ་བ་ཡང་དཔེ་གསུམ་གྱི་སྟེང་ནས་དེ་ཉིད་ལས་གསུངས་པས་སོ།",
    "སྔར་བསྔོ་བ་བཅུ་གཉིས་བྱེད་པར་བསྟན་པ་ནི།",
    "མི་ཟད་པར་འདོད་པའི་འདུན་པ་རྣམས་ཅི་རིགས་པ་སྟེ་རང་བཞིན་མེད་རྟོགས་ཀྱི་ཤེས་རབ་ཀྱང་དགོས་སོ།",
    "བསྔོ་བའི་འོག་ཏུ་ཟག་བཅས་གསུམ་པ་རྗེས་སུ་ཡི་རང་བ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིར་བསྔོ་བའི་འོག་དང་སྡུད་པར་གོང་དུ་བསྟན་པ་ནི།",
    "དགེ་རྩ་རྣམས་གཅིག་ཏུ་བསྡུས་ནས་རྗེས་སུ་ཡི་རང་བྱ་བར་གསུངས་ན་ཅི་ཙམ་གྱིས་རྗེས་སུ་ཡི་རང་རབ་ཏུ་གྱུར་པ་ཡིན་ཞེས་རབ་འབྱོར་གྱིས་དེ་བཞིན་གཤེགས་པ་ལ་དྲིས་པའི་ལན་དུ་གསུངས་སོ།",
    "ཀུན་རྫོབ་ཏུ་ཐབས་མཁས་ཀྱིས་སྒྱུ་མ་ལྟ་བུར་དམིགས་ནས་དང་དོན་དམ་པར་ཤེས་རབ་ཀྱིས་ཅིར་ཡང་མི་དམིགས་པར་རྟོགས་པ་ཉིད་ཀྱིས་སོ།",
    "རྣམ་པར་སྨིན་པ་བསམ་མི་ཁྱབ།",
    "རྣམ་དག་སྒོམ་ལམ་སྤངས་པ་ཡིན་པས་འདུས་མ་བྱས་སུ་འགྱུར་ལ།",
    "ཞེས་སྒོམ་ལམ་དྲི་མ་དགུ་སེལ་བྱེད་དུ་གསུངས་སོ།",
    "ཞེས་སྤང་བྱ་དགུ་འཇོམས་བྱེད་དུ་གསུངས་ལ།",
    "མཉམ་རྗེས་ལ་འདོད་པར་སྣང་བས་དེ་ཡང་མི་རུང་སྟེ།",
    "དེས་ན་མཉམ་གཞག་ཟག་མེད་གཅིག་ཉིད་ཡུལ་རྟོགས་ཚུལ་གྱི་སྒོ་ནས་ཐོབ་བྱ་འགྲུབ་པར་བྱེད་པ་དང་།",
    "ཡི་རང་བྱ་བར་གསུངས་པ་ལ་འཕྲོས་ནས།",
    "ཤཱ་རིའི་བུས་ཡུམ་དེ་སྣང་བར་བྱེད་པ་དང་ཕྱག་བྱ་བར་འོས་པ་ལ་སོགས་པར་གསུངས་སོ།",
    "ངོ་བོ་དང་ཁྱད་པར་དང་བློའི་རྣམ་པའོ།",
    "ཨ་བྷྱཱས་སྐབས་འདིར་ཟག་མེད་སྒྲུབ་པ་སྒོམ་ལམ་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་དེ་དྲོད་སོགས་ཀྱི་གནས་སྐབས་སུ་ཇི་ལྟར་རིགས་ཞེས་པ་དང་།",
    "སྒོམ་ལམ་དེས་གཏོད་པར་བྱེད་པ་ནི།",
    "སྒྲུབ་པ་སྒོམ་ལམ་དེའི་འོག་ཏུ་ཟག་མེད་གཉིས་པ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་མཚན་ཉིད་གསུངས་སོ།",
    "ཇི་ལྟར་ན་མཐུན་རྐྱེན་གང་ཞིག་ཡོངས་སུ་བཟུང་བ་དང་འགལ་རྐྱེན་གང་ཞིག་བོར་བས་འཐོབ་པར་འགྱུར་བའི་རྣམ་དག་སྒོམ་ལམ་འདིའི་སྐྱེ་བའི་རྒྱུ་དང་མི་སྐྱེ་བའི་རྒྱུ་གང་ཞིག་ཡིན་སྙམ་པའི་ཐེ་ཚོམ་བསལ་བ་སྔོན་དུ་གཏང་བའི་སྒོ་ནས་སོ།",
    "འབྲས་བུ་དག་པ་ནི་གཟུགས་དང་སོགས་པས་རྣམ་མཁྱེན་གྱི་བར་དག་པ་ཉིད་ཡིན་ཏེ།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་རྣམ་པར་དག་པ་ཉིད་དོ།",
    "ཞེས་རྣམ་མཁྱེན་གྱི་བར་ལ་གསུངས་ནས།",
    "རབ་འབྱོར་གཞན་ཡང་གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་རྣམ་པར་དག་པ་ཉིད་དོ།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་ཡུམ་རྣམ་པར་དག་པ་ཡུམ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་གཟུགས་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་གཟུགས་རྣམ་པར་དག་པ་དང་།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་དང་།",
    "ཞེས་འབྱུང་ཞིང་རྣམ་མཁྱེན་གྱི་བར་ལ་ཡང་དེ་ལྟར་རོ།",
    "འདི་ཞིབ་པར་དཔྱད་ན་གསུམ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ཉིད་ནི་དེའི་དམིགས་པ་དང་དེའི་འབྲས་བུ་རྣམ་པར་དག་པ་ཡིན་ཏེ།",
    "རྒྱུན་དུ་ཞུགས་པ་ལ་སོགས་པའི་འབྲས་བུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་རྣམ་པར་དག་པ་ཡིན་ལ།",
    "ཡུལ་ཅན་འབྲས་བུ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ཉིད་དང་ཡུལ་གཟུགས་སོགས་རྣམ་པར་དག་པ་དེ་གཉིས་ནི་འཆད་འགྱུར་གྱི་དྲི་མ་དེས་དག་པ་ཡིན་མིན་དུ་ཁྱད་པར་མེད་པ་ཡིན་ནོ།",
    "རྣམ་པར་དག་ཚུལ་གང་ན།",
    "མཐར་ཐུག་པའི་ལམ་གྱི་ཁྱད་པར་རོ།",
    "རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་དུ་ཡོངས་སུ་དག་པ་གང་ཡིན་པ་འདི་ལ་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་ཐ་མི་དད་ཅིང་མ་ཆོད་པའོ།",
    "འཁྲུག་པ་རྣམ་པར་དག་པ་དང་།",
