    "དེ་ནི་སྤྱོད་འཇུག་ཏུམཐུན་པར་རིམ་གྲོ་བསྟེན་བྱས་ན།",
    "ཅེས་གསུངས་པ་དང་དོན་འདྲའོ།་",
    "རྣམ་པར་རྟོག་པ་སྟེ།",
    "བདེ་གསལ་མི་རྟོག་པའི་ཏིང་འཛིན་ཐོབ་པར་འགྱུར་རོ།",
    "ཞེས་པར་བསྟན་ནོ།་",
    "ཞིབ་པར་ཨ་ནབསྐྱེད་རྫོགས་ཀྱི་གཞུང་རྣམས་ལས་ཤེས་པར་བྱའོ།",
    "འབྱེད་མཁན་གསེར་གྱི་རུས་སྦལགས།",
    "རྒྱལ་བ་ཚངས་དབྱངས་པ་འདི་པ་འཕགས་པའི་གང་ཟག་ཁྱད་པར་ཅན་ཡིན་པའི་སྒྲུབ་བྱེད་མང་དུ་མཐོང་བས།",
    "ཆར་ཆུ་སོག་པའི་རྫིང་བུ་གཉིས་རྒྱ་དཔངས་དང་ཡོན་ཏན་མཉམ་པར་བཟུང་བ་ལྟ་བུ་ཡིན་པས།",
    "འཐད་པར་འགངས་མི་སེམས་ཤིང་།",
    "འཇིག་རྟེན་མཐུན་པར་མི་འཇུག་ན།",
    "མ་བྱས་མི་ཁ་སྡང་བ་སོགས་ཀྱིས་ལྷ་བཟང་ཧན་གྱི་སྤྱོད་པའི་ངན་རྒྱུར་ཐེར་འདོན་བྱས།",
    "ཞིབ་གཞུང་སོགས་བཟོས་ཏེ་གཞུང་འབབ་ཁག་ཐེག་བྱས།",
    "ཧོར་སྤྱི་ལས་ཐོག་བརྒྱད་པ་རིམ་བཞི་ཐའི་ཇི་ཁྱུང་རམ་པ་དོན་གྲུབ་རྒྱལ་པོའི་དུས་སྐབས་སུ་ས་སྟག་ཞིབ་གཞུང་ཞེས་ཧ་ཅང་ཞིབ་ཚགས་པ་ཞིག་བཟོ་འཆར་ལྟར་བཟོས་མ་ཚར་པར་ལུས་པར་གྲགས།",
    "དྲུག་པར་བསྒྱུར་པ་སྟེ།",
    "སྟག་དྲུག་སོགས་ཀྱི་སྟོང་དཔོན་རྣམས་བརྒྱ་དཔོན་གྱི་གྲས་སུ་ཕབ་སྟེ་དཔོན་གནས་རིམ་པ་ལྔ་པར་བསྒྱུར་བ་དཔོན་ཁག་བཅུ་བཞི་དང་།",
    "བློན་པོ་རང་འཇགས་ཀྱིས་རིམ་པ་བཞི་པའི་ཧོར་སྤྱི་ནས་རིམ་པ་བདུན་པའི་ལྡིང་དཔོན་བར་དུ་ཚགས་སུ་ཆུད་པར་བཟོས།",
    "གཞུང་གནས་སུ་འབབ་ཡོང་ཡང་དེ་ཙམ་མ་མཆིས་པར་གཞིགས་ཏེ།",
    "བྱང་བརྒྱུད་ཀྱི་སྤྱི་འདོམས་བྱུང་སྤྱི་འཛུགས་རྒྱུའི་འཆར་གཞི་ཕུལ་བར་དེ་འཐུས་ཀྱི་ཕྱག་རྟགས་གནང་པས།",
    "གནས་སྤར་བསྐོ་ཏུ་ནག་ཆུ་ཁར་རྒྱལ་བའི་བཞག་བྱས།",
    "ཡང་སྲིད་ཀྱི་ཕེབས་བསུར་བསྐྱོད།",
    "དུལོའི་པར་རྩེམགྲོན།",
    "གཞུང་རྩིས་ལོ་བརྒྱད་བྱས།",
    "ཧོར་སྤྱིའི་ཐམ་ག་རྒྱལ་ཞེས་པ་དང་ཧོར་སྤྱི་རྣམ་པར་རྒྱལ་བའི་ལས་ཐམ་ཞེས་པའི་ཐམ་རིས་ཁག་གཉིས།",
    "གཞུང་རྩིས་ཞུ་ལགས་བཅས་ཀྱི་གཞུང་ཁྲ་འདྲ་གཉིས་བཀོད་པར།",
    "ཕྱོགས་མཚུངས་དེ་ལོའི་སྦྲ་ཆེན་གྱི་གཏོང་འབབ་ཇི་ཡོད་རྙིང་པས་བསྡུས་འབྲེལ་དགོས་ཀྱི་མཆོད་ཐེབ་གཏོང་སྒོ་སོགས་གོང་མཚམས་བར་གསར་པར་ཁ་འཕངས་མེད་པ་རྙིང་པས་བྱེད་རྒྱུ།",
    "དངོས་རིགས་བཅས་སྤྲོད་བཤེར་སྐབས་ཆད་རིགས་ལ་བཀའ་དགོངས་བཞིན་རིན་འབབ་གཞུང་འབུལ་ཞུ་དགོས་ཕེབས་པ་ལྟར་ཆད་ཁྲ་ཟུར་གསལ་རིན་འབབ་ཇི་ཐོབ་གསར་པར་ཁ་འཕངས་མེད་པ་རྙིང་པས་མགོ་དཀྲིས་གདོང་དག་བྱེད་རྒྱུ་ཟིན་པ་བཅས་ཕུད།",
    "སེར་ཚ་ས་སྲུང་གཙང་མདའ་མཚོ་སྒོ་བ།",
    "བྱས་ཉེས་འཁྲུན་གཅོད།",
    "པའི་སྟེང་དུ་མུ་འགོད་བྱས་ཡོད།",
    "ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "ཧོར་སྨད་བཅས་བཞིར་བརྩི་མཁན་ཡང་ཡོད་པར་སྣང་།",
    "ཚང་མས་མཁྱེན་གསལ་ལྟར།",
    "མཆོད་ཐེབས་འཚོ་རྟེན་གྱི་ས་ཞིང་དང་འབྲོག་ར་གནང་སྦྱིན་སྦྱོར་འཇགས་བསྩལ་བ་སོགས་བྱས་ཏེ།",
    "ཆན་ལུང་ཁྲི་ལོ་གཉིས་པར་སྤྱི་ལོ་༡༧༣༧སྦྱོར་ཁང་ནས་ཞིབ་གཞུང་བཀོད་པ་ལྟར་ན།",
    "འབྲེལ་ཡོད་དཔྱད་ཡིག་ལ་གཞིགས་པའི་བསྡོམས་རྩིས་བྱས་པ་ལྟར་ན།",
    "ཞིབ་པར་དཔྱད་ན་གང་ལྟར་ངོ་བོར་གཏུག་པའི་ཁྱད་འིཔར་ཆེར་མེད་པར་སྙམ་སྟེ།",
    "དེ་ཡང་ཁྲལ་རྟེན་ནི་རྐང་འགྲོ་ལག་འདོན་གྱི་ཁྲལ་འུལ་སྣ་ཚོགས་རྒྱུག་པ་ཆ་རྐྱེན་དུ་བྱས་ཏེ།",
    "མ་མཐར་འཚོ་རྟེན་ཆགས་ཐེབས་ཙམ་གྱི་ས་ཞིང་བོགས་མར་ལེན་རྒྱུ་བྱུང་བ་དེ་སྔོན་དང་བསྡུར་ན་ཡར་རྒྱས་ཆེན་པོ་ཞིག་ཡིན་པས་ཁོ་ཚོའི་ཐོན་སྐྱེད་ལ་བརྩོན་པར་སྐུལ་འདེད་ཐེབས་ཏེ།",
    "ཞིང་བྲན་རྣམས་ཀྱིས་ཡར་ལངས་ནས་གྱེན་ལོག་བྱས་པ་དང་།",
    "ཐོན་སྐྱེད་ལག་རྩལ་སོགས་ལ་ལྟོས་པའི་ལས་བགོས་སོམ་ཁྱད་པར་འབྱེད་དུ་མེད་པའི་ཕྱིར།",
    "གཞིས་ཁོངས་ས་རིགས་རྒྱུ་ནོར་སོགས་ཡུག་ཅིག་ཏུ་གཞུང་བཞེས་བྱེད་སྲིད་པ་མ་ཟད།",
    "སྐུ་དྲག་དཔའ་འཁུམས་པར་གྱུར་ཏེ།",
    "ཞི་དྲག་ཐབས་སྣེ་སྣ་ཚོགས་སྤྱད་དེ་ཁོ་ཚོའི་བློ་འགུག་ཐབས་བྱས་པ་དང་བསྟུན།",
    "དབུས་གཙང་དྭགས་ཀོང་སོགས་ཚང་མར་ཡུལ་གྲུ་འགའ་ཞིག་ས་སྟོང་དང་།",
    "ཕལ་ཆེ་བར་བསྡད་དུད་གཅིག་གཉིས་དང་ལྔ་དྲུག་ཙམ་ལ་ཐུག་པའི་འཐོར་རྐྱེན་ལ་གྱུར་བའི་གནས་ཚུལ་རིམ་པར་ཐོན་གྱི་ཡོད་ན།",
    "དབྱིན་ཁོངས་རྒྱ་གར་གྱི་བཟོ་གྲྭ་ནས་ཐོན་སྐྱེད་བྱས་པའི་བལ་སྲིང་སེ་ཤན་སོགས་ཀྱི་རས་ཆ་སྣ་ཚོགས་དང་།",
