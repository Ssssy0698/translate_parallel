    "རྗེ་ཞྭ་དམར་པཎྜི་ཏའི་བཀའ་འབུམ་ལས་ལུང་རྒྱུན་གང་བཞུགས་རྣམས་ཀྱི་ལུང་།",
    "ཀུན་མཁྱེན་གསུང་གྲས་ལོ་གྱོན་མའི་ལས་ཚོགས་དང་།",
    "ལྕགས་རའི་ཆོ་གའི་སྟེང་ནས་གདུགས་དཀར་རྒྱལ་མཚན་འཁོར་ལོའི་ཁྲིད་རྣམས་རིམ་པར་བསྩལ་པ་གསན།",
    "ལུང་ཕྲན་འགའ་བཅས་ཐུགས་གསང་ནོར་བུའི་ཟ་མ་ཏོག་ཏུ་ཡོངས་སུ་གཏེམས་པར་མཛད་དོ།",
    "མ་བསླད་བསྐལ་པར་ཉན་ཀྱང་སྒྲའི་ཁྲོན་པ།",
    "ནང་ལུགས་ཀྱི་བཀའ་བགྲོས་བཅས་ལེགས་པར་ཐོན་ཞིང་།",
    "སྐུ་ལྕགལྷ་དར་དཀར་སེར་བཅས་འབུལ་ལམ་དུ་བསྟར་བ་བཞེས་ཤིང་།",
    "ཡང་དར་གྲོང་གྲུབ་སྤྲུལ་གྱིས་ཞུས་པ་ལྟར་གསུངས་པའི་སྐབས་སུ།",
    "དེ་ལས་བྱུང་བའི་རྗེས་གནང་བདུན།",
    "ཞྭ་དམར་པཎྜི་ཏའི་སྐུ་བསྟོད་ཀྱི་ཁྲིད་བཅས་གསན་པར་མཛད་དོ།",
    "ད་ནས་བཟུང་ཐུགས་ཁོམ་ནམ་ཡོད་ལ་བཀའ་དྲིན་སྐྱོང་བར་འོས་ཞེས་བཀའ་ཕྱིར་ལྡོག་མེད་པའི་གསུང་གནང་བར།",
    "འཇམ་དབྱངས་བདེ་བའི་རྡོ་རྗེའི་གསུང་འབུམ་རྣམས་ཀྱི་ལྗགས་ལུང་རྣམས་གསན་པར་མཛད་པ་ནི།",
    "གསུངས་པའི་ཚུལ་དང་མཐུན་པར་གསལ་ལོ།",
    "ཕྱིར་ཕེབས་ནས་མཁན་ཆེན་རྡོ་རྗེ་འཆང་དང་ཡབ་སྲས་ཞལ་འཛོམས་ཀྱིས་དབེན་གནས་བཀྲ་ཤིས་འཁྱིལ་དུ་ཕྱག་བཏེགདེར་ཟླ་བ་ཕྱེད་དང་གཉིས་རིང་ལ།",
    "ཞག་བཞུགས་མཛད།",
    "བཀའ་བསྡུས་སོགས་ཀྱི་ལུང་གནང་།",
    "ལོ་མཇུག་ཏུ་བཅུ་ཆའི་སྦྱིན་སྲེག་གནང་བ་ཡིན།",
    "ཀུན་མཁྱེན་བཀའ་རྒྱ་མའི་ལུང་ཡོད་སྐོར།",
    "སྐུ་མདུན་པ་གཞུང་བརྒྱ་སྨྲ་བ་འོད་ཟེར་རྒྱ་མཚོ།",
    "རོང་བོ་ལུང་རྟོགས་རྒྱ་མཚོ་བཅས་ལ་མཚོ་སྣ་པའི་འདུལ་མཆན་ཁྲིད་གཞུང་དུ་བྱས།",
    "ཚེས་ཉི་ཤུའི་སྐོར་ལ་དགེ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་དུ་ཕེབས།",
    "སྒོ་ཡོལ་དང་སྒེའུ་ཡོལ་ཕྱིར་འཕུར་སོགས་ཀྱང་གོས་དམར་སེར་གྱིས་བྱས།",
    "གཟིམ་ཆུང་སྒོར་རྟ་རྔ་ཡ་འཕྱང་བཅུགདེ་ནས་སྐུ་རབས་གོང་མ་རྣམས་བཞིན་སྤྱི་སོ་གྲྭ་ཚང་ལ་རིམ་གྱིས་ཚོགས་ཞུགས་གནང་།",
    "སྤྱི་སོ་གྲྭ་ཚང་ཁང་ཚན་ལ་མང་ཇ་གྲྭ་ཇ་ཚོམས་ཇ་འགྱེད་སྤྱི་འཇོག་དང་བིཅས་པ་གནང་།",
    "རོང་བོའི་སྟོང་མཆོད་ཀྱི་གཏོང་རྩ་ལ་ཁ་སྣོན་ཀྱང་གནང་བར་མཛད།",
    "བོད་ལོའི་བཅུ་དྲུག་ཉིན་ལྷ་སར་ཕེབས་ཏེ་ལྕགས་ཡོས་ལོ་གསར་གྱི་དགའ་སྟོན་ཡོ་ལང་ལ་རོལ་བར་མཛད་དོ།",
    "དཔྱིད་ཀ་ཞིག་ལ་རྒྱུད་སྟོད་པའི་གྲྭ་བ་མང་ཙམ་ལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་བསྙེན་ཁྲིད་གནང་།",
    "ལྔ་བའི་ནང་བཀྲ་ཤིས་ལྷུན་པོར་མཇལ་དུ་ཕེབས་སྐབས་ཁུ་བྱུག་གྲག་པ་ལ་བརྟེན་སྐྱེ་བོ་མང་བོ་དད་པ་འཕེལ་བར་གླེང་ལ།",
    "དེ་ནས་སྣོན་ཟླའི་བཅུ་གཅིག་ཉིན་གདན་སར་ལོ་དེར་ཕེབས་ངེས་ཀྱི་གློག་འཕྲིན་དང་གསུང་རིས་བསྟུད་མར་བཏང་སྟེ་ཕྱིར་འབྱོན་པར་ཆས།",
    "ཤོལ་ཟླ་དྲུག་པའི་ནང་རྭ་རྒྱ་བཀྲ་ཤིས་འབྱུང་གནས་སུ་ཕེབས་པ་ན།",
    "རྭ་རྒྱ་ནས་ཕྱག་བཏེག་ཉིན་མཁན་ཆེན་རྡོ་རྗེ་འཆང་སྐུ་དངོས་བསུ་བ་ལ་ཕེབས་པ་དང་ཞལ་འཛོམས།",
    "ཚེས་ཉེར་ལྔའི་ཉིན་མངའ་འབངས་དད་ལྡན་སྤྲིན་བཞིན་གཡོ་བས་བསུས་ཏེ་ནོར་བུ་གྲུ་འཛིན་གྱི་སྤོ་ལ་བཞུགས་པར་མཛད་ནས་དབུས་སྟོན་སྟེང་ཡོངས་འཛིན་མཁན་ཆེན་རྡོ་རྗེ་འཆང་ལ་བདེ་མཆོག་དཀར་བོའི་ལི་སྐུས་ཐོག་དྲངས་པའི་རྟེན་གསུམ་དངོས་སྐྱེས་ཚན་གྲངས་སྤུས་ལེགས་རྒྱ་ཆེན་ཕུལ་ལ།",
    "སྣོན་ཟླའི་ཚེས་གསུམ་ཉིན་གདན་སར་མ་འགྱངས་ཚུན་ཕེབས་རྒྱུའི་གློག་འཕྲིན་གནང་།",
    "སྐུ་མདུན་པ་འོད་ཟེར་རྒྱ་མཚོ་སོགས་ལ་འཇམ་དབྱངས་ཞི་ཁྲོ་སྦྲགས་སྒྲུབ་དྲི་མེད་ཤེས་རབ་མིག་འབྱེད་ཀྱི་ཁྲིད་གནང་།",
    "སྐུ་མདུན་པ་ཆེན་པོ་འོད་ཟེར་རྒྱ་མཚོས་ཞུས་ངོར།་",
    "ཞལ་རྣམ་འགྱུར་བཅུ་བདུན་གྱི་རྗེས་གནང་།",
    "འཇིགས་བྱེད་བསྙེན་ཁྲིད་བཅས་གནང་།",
    "སྒྲོ་རོང་བོར་ཡང་ཕེབས་བཞུད་གནང་།",
    "མགོན་ཤུལ་ནས་ཁྱིམ་གྲངས་ལ་ཕེབས་ཏེ་བྱིན་ནས་གཏོར་བར་མཛད།",
    "སོལ་ནག་ལ་ཕེབས་ཏེ་བདེ་ལམ་གྱི་ཁྲིད།",
    "རྟ་མགྲིན་གསང་སྒྲུབ་ཀྱི་རྗེས་གནང་།",
    "རབ་རྒྱས་སོགས་ལ་ཕྱག་ཆེན་གྱི་ཁྲིད་བཅས་གནང་།",
    "རྗེ་བཙུན་ཆེན་པོ་འཇིགས་མེད་རིགས་པའི་བློ་གྲོས་དཔལ་བཟང་བོ་ནི་ཕ་རྒོད་བཛྲ་དྷ་རའི་སྲས་ཀྱི་ཐུ་བོ་ཡིན་པར་མ་ཟད།",
    "དེའི་སྔ་ལྟས་སུ་འགྲོ་དོན་ལ་ཡུན་རིང་བཞུགས་པའི་ས་ཕྱོགས་སུ་མགོ་ཟླའི་ནང་སྤྲིན་མར་མེ་ཏོག་སེར་བོ་བཞད་པ་དང་།",
    "ཐོས་བསམ་རྣམ་པར་རྒྱལ་བའི་གླིང་།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པས།",
    "འབའ་ཞིག་སྙན་དངགས་ལམ་དུ་མཚོན་པར་བྱས།",
    "ཅེས་གསུངས་པ་ལྟར་ཞུས་པ་ཡིན་པ་ལས།",
    "པཎ་ཆེན་སྐུ་ཕྲེང་དྲུག་པའི་སྐུ་སྲུང་བགྱིས་པར་ཆོ་ལོ་དང་གཟེངས་བསྟོད་པ་སྔགས་འཆང་རིག་འཛིན་དཔལ་བཟང་།",
    "འདི་བ་བཞི་བའི་ཚུལ་དུ་ཕེབས།",
    "ཞེས་ལུང་གསལ་པར་བསྟན།",
    "དགུང་ལོ་བདུན་པར་གདན་སར་བཀོད།",
    "ལོ་དེར་གོང་ས་ཐམས་ཅད་མཁྱེན་པ་ལས་རབ་བྱུང་དགེ་ཚུལ་དཀྱུས་གཅིག་ཏུ་བསྒྲུབས།",
