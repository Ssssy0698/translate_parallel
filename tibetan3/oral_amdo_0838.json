    "ཚུར་ཕུང་པོ་རྙིང་པ་ལ་ཞུགས་པའི་མོས་པ་བྱས་ཏེ།",
    "རིམ་གྱིས་འོད་ཟེར་དཀར་པོའི་རྒྱུན་བྱུང་ནས་རང་གི་སྤྱི་བོར་ཐིམ།",
    "འོད་ཟེར་དམར་པོའི་རྒྱུན་བྱུང་ནས་རང་གི་མགྲིན་པ་ལ་ཐིམ།",
    "ཅིག་ཅར་དུ་བྱུང་ནས་ལུས་ངག་ཡིད་གསུམ་ཐུན་མོང་གི་སྒྲིབ་པ་དག་པའི་དམིགས་པ་བྱེད་ཅིང་།",
    "འདི་འདྲའི་ཐོག་ནས་ལས་རུང་གི་བསྙེན་པ་སྔོན་དུ་བཏང་ནས།",
    "དུས་རྒྱུན་ཁ་འདོན་དུ་བྱེད་པ་ཡིན་ན་བདག་འཇུག་གི་གོ་ཆོད་པར་མ་ཟད།",
    "ལམ་རིམ་སྔོན་ལ་ཕྱིན་ཚར་སྟབས་རོབ་ཙམ་རེ་མ་གཏོགས་ཞུ་མི་དགོས་པར་གྱིས།",
    "བདེ་ལེགས་རྩ་བ་མགོན་པོ་ཁྱོད་ཉིད་ཀྱིས།",
    "དེ་བཞིན་ད་ལྟ་ཡང་མ་རྟོགས་ལོག་རྟོག་གི་བློ་སྐྱེས་པ་ཚང་མ་དག་པའམ་ཟད་སོང་སྙམ་ཞིང་།",
    "ལམ་རིམ་ཆེན་མོར།",
    "མདང་དགོང་སྦྲང་བུ་ཞིག་རྨི་ལམ་བཏང་སོང་།",
    "བཞད་མོ་བཞད།",
    "གང་ལྟར་ཁྱིམ་བདག་དཔལ་སྐྱེས་སྦྲང་བུ་ཞིག་ཏུ་སྐྱེས་པ་ཆུའི་ནང་གི་ལོ་མ་ཞིག་གི་སྟེང་དུ་བབས་པ་ཆུས་འཁྱེར་ནས།",
    "ཞེས་གསུངས་པ་ནི་ཞིང་གི་མཐུ་ལ་བརྟེན་པའི་དོན་ཡིན།",
    "གཞན་གྱིས་རང་གི་ལུས་མཐོང་བ་དང་མིང་ཐོས་པ།",
    "རང་ལ་རེག་པ་སོགས་ཅི་ཞིག་བྱུང་ཡང་དེ་དག་ལ་ཕན་པ་འབའ་ཞིག་ཡོང་བར་ཤོག་ཅེས།",
    "ངན་སོང་སྡུག་བསྔལ་འབར་བའི་མེས་འཇིགས་ནས།",
    "ངན་སོང་སྡུག་བསྔལ་འབར་བའི་མེས་འཇིགས་ནས།",
    "ལས་དང་ཉོན་མོངས་རྦ་ཀློང་དྲག་ཏུ་འཁྲུགས།",
    "ལས་ཉོན་རྦ་ཀློང་གི་གཟུགས་སུ་བཀོད་ནས་དེ་དྲག་ཏུ་འཁྲུགས་ཤིང་།",
    "སྡུག་བསྔལ་གསུམ་གྱི་ཆུ་སྲིན་མང་པོས་རྟག་ཏུ་གཙེས་ནས་ཡོད་པའི་མཐའ་མེད་པའི་འཇིགས་རུང་གི་སྲིད་མཚོ་ཆེན་པོ་འདི་ལ།",
    "ཀུན་འབྱུང་ལས་དང་ཉོན་མོངས་ཀྱི་རྦ་ཀློང་དྲག་ཏུ་འཁྲུགས་པའི་འབྲས་བུར་སྡུག་བདེན་དང་།",
    "ཡན་ལག་སྔ་མ་སྔ་མ་མ་རྫོགས་གོང་ཡན་ལག་ཕྱི་མ་ཕྱི་མ་གསོག་གིན་བྱས་ཏེ།",
    "ངེས་འབྱུང་གི་བསམ་པ་བཅོས་མ་མ་ཡིན་པས་རྒྱུད་བསྐུལ་ནས།",
    "འདི་ནས་མར་ཐེག་ཆེན་གྱི་ལམ་ཉམས་ལེན་བྱེད་པའི་སྐབས་སུ་བློ་སྦྱོང་གི་སྐོར་རྣམས་དང་སྦྱར་ནས་གསུངས་པ་ལ།",
    "ཞེས་པས་སྐྱེས་བུ་འབྲིང་གི་ལམ་བསྟན།",
    "ཉམ་ཐག་འགྲོ་བ་འདི་ཀུན་བདག་གི་མ།",
    "ང་ཚོས་མཐོང་ཚད་དང་ཐོས་ཚད།",
    "ཉམ་ཐག་འགྲོ་བའི་བདག་གི་མ་འདི་དག་ཀུན་ཉམ་ཐག་པ།",
    "རང་གི་མས་མཚོན་པའི་གཉེན་དུ་མ་གྱུར་པ་གཅིག་ཀྱང་མེད་ཅིང་།",
    "བུ་ཡི་དོན་དུ་མས་རང་གི་སྲོག་ཀྱང་གཏོང་ཕོད་པའི་བརྩེ་བའི་བསམ་པ་ཤ་གས་ཆེན་པོ་ཞིག་ཡོད་པ་ལྟར།",
    "དེ་ནི་ཕྱོགས་རེས་པ་དང་ཚད་ཅན་མིན་པར་མཐའ་མེད་པ་ཞིག་ཡིན།",
    "སྡུག་བསྔལ་ཕྲ་མོ་ཙམ་ཡང་མི་འདོད་ཅིང་།",
    "སྐབས་འདིའི་བཏང་སྙོམས་ཀྱི་བློ་མཉམ་པ་ནི་སྡུག་བསྔལ་ཕྲ་མོ་ཙམ་ཡང་མི་འདོད་པ་དང་།",
    "ཉམ་ཐག་འགྲོ་བ་འདི་ཀུན་བདག་གི་མ།",
    "ད་ལྟ་གང་གི་གནས་སྐབས་ཡིན་ཀྱང་དངོས་དང་བརྒྱུད་པའི་སྒོ་ནས་རང་ཉིད་ལ་ཕན་འདོགས་པའི་དྲིན་ཅན་ཤ་སྟག་ཡིན་པའི་ཚུལ་བསམ་པའི་སྒོ་ནས།",
    "ཉེ་རིང་བྱས་ན་ག་ལ་འགྲིག་ཐམས་ཅད་དངོས་དང་བརྒྱུད་པའི་སྒོ་ནས་རང་ལ་ཕན་བཏགས་པ་དང་གདགས་པར་འགྱུར་བ་ཤ་སྟག་ཡིན་པའི་ཚུལ་བསམ་ནས་ཕན་བདེ་སྒྲུབ་འདོད་ཀྱི་བསམ་སྦྱོར་རིང་ཐུང་མེད་པ་ཞིག་ད་ལྟ་ང་ཚོས་དགྲ་དང་གཉེན་ཏེ།",
    "ཤི་རན་ཡོད་ཀྱང་ད་དུང་ནང་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལ་འཛིང་རེས་བྱེད་ཀྱི་འདུག་དུད་འགྲོ་རང་རེད་སྙམ་པ་ང་ཚོའི་བློ་ལ་འཆར་ངེས་ཡིན།",
    "ང་ཚོ་ནང་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལ་ཆགས་རིན་དང་།",
    "གཅིག་གིས་གཅིག་ལ་སྡང་རིན་རྩ་ནས་མི་འདུག་བསམ་པའི་ཐོག་ནས་སེམས་སྙོམས་པར་སྒྲུབ་ལུགས་གཅིག་གསུངས་པ་ཡིན།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གཟིགས་དགོས་པར་མ་ཟད།",
    "ཐུབ་པའི་ཉོན་མོངས་ཉིད་གཟིགས་ཀྱི།",
    "ཉོན་མོངས་དང་ལྡན་གང་ཟག་མིན།",
    "རང་གི་བློ་རྨོངས་ཤིང་འཁྲུལ་པས་མཐོང་བ་ལས།",
    "གལ་ཏེ་ཡོད་ན་ཐུབ་པས་གཟིགས་དགོས་པ་ལས་དེས་མ་གཟིགས་པས་མེད་པ་རེད་བསམ་པའི་ཐོག་ནས་ཀྱང་ཐམས་ཅད་ལ་ཕན་བདེ་སྒྲུབ་འདོད་ཀྱི་བློ་སྐྱེ་བ།",
    "དེ་བཞིན་དུ་ང་ཚོའི་ཐ་སྙད་ལ་དགྲ་དང་གཉེན་ཞེས་པ་ཞིག་ཡོད་ཀྱང་།",
    "རྟག་བརྟན་ཐེར་ཟུག་གི་དགྲ་དང་གཉེན་ཞིག་མེད་པས།",
    "ནམ་རྒྱུན་སེམས་སྐྱེད་བཀའ་རྒྱ་མ་ཞེས་པ་ཡང་འདི་ལས་ལྷག་པའི་ཟུར་བ་ཞིག་ཡོད་པ་མ་རེད་ཅེས་གསུང་གི་ཡོད།",
    "རང་གི་སྡུག་བསྔལ་སེལ་བ་དང་བདེ་བ་བསྒྲུབ་པའི་དོན་དུ་འབད་པ་དེ་བཞིན།",
    "གཅིག་གི་ཆེད་དུ་མང་པོ་བེད་སྤྱོད་བཏང་ན་གླེན་པ་དང་མ་རབས་ཡིན།",
    "གཅིག་གིས་གཅིག་ལ་སྡང་ཞིང་ཁྲོ་བར་མི་རིགས་ཏེ།",
    "བྱ་གསོ་ཁང་གི་བྱ་དང་།",
    "ང་ཚོར་ཆ་བཞག་ཀྱང་རང་གཞན་ཐམས་ཅད་མི་རྟག་པའི་རང་བཞིན་དང་།",
    "ཐུབ་པའི་ཉོན་མོངས་ཉིད་གཟིགས་ཀྱི།",
    "ཉོན་མོངས་དང་འབྲེལ་གང་ཟག་མིན།",
    "དགྲ་ཞེས་གནོད་པ་བྱེད་མཁན་ནི་ཉོན་མོངས་པ་དང་དེས་དྲངས་པའི་བྱ་བ་ལ་ཟེར་བ་དང་།",
    "ཡལ་བར་འདོར་རྒྱུ་ཡོད་པ་མ་རེད་ཅེས་གསུངས་པ་ཡིན།",
    "རང་ངོ་ལ་བལྟས་ཀྱང་གུང་ཐང་ཚང་གིས།",
    "ཚིག་ལེགས་ཉེས་ཤིག་ལ་རྣམ་རྟོག་གིས།",
    "ཉེ་རིང་གི་འཛིན་པ་དེ་ནས་ཆོད།",
    "སེམས་བསྐྱེད་བཀའ་རྒྱ་མ་འཐོབ་ན་ཉིན་རེ་བཞིན་དུ་ཁྲིད་དམིགས་བསྐྱང་དགོས་པས།",
    "ད་ཆ་བདག་འཛིན་གདོན་ཆེན་གྱིས་ང་ཚོ་བྲན་གཡོག་ཏུ་བཀོལ་ནས་སྡུག་ལ་སྦྱར་བའི་ངང་ཚུལ་དྲན་པར་བྱས་ཏེ།",
    "འགྲོ་བ་འདི་དག་བདག་གི་དགྲར་ལངས་ཀྱང་།",
    "མཐའ་ཡས་པའི་སྲིད་པ་དང་ཞི་བའི་ཡོན་ཏན་ཐམས་ཅད་གཞན་གཅེས་འཛིན་ལ་བརྟེན་ནས་ཡོང་གི་ཡོད་པས།",
    "འགྲོ་བ་འདི་དག་ཐམས་ཅད་རང་གི་ལུས་སྲོག་ལ་རྒོལ་བའི་དགྲར་ལངས་ཀྱང་།",
    "དུས་ནམ་ཡང་ཉམས་པ་མེད་པར་རང་གི་སྲོག་བཞིན་དུ་གཅེས་པོ་བྱས་ནས་འཛིན་པ་དང་།",
    "བྱིས་པ་རང་གི་དོན་བྱེད་དང་།",
    "སྐྱོན་གྱི་གོང་བུ་ཡིན་པ་ང་ཚོ་དང་གཅིག་མཚུངས་ཡིན།",
    "དེ་ལྟ་ན་ཡང་རང་གཅེས་འཛིན་ལ་ཉེས་དམིགས་སུ་གཟིགས་ཤིང་།",
    "མཐར་ཐུག་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་མངོན་དུ་བྱས་པ་རེད།",
    "བདག་གི་བདེ་དགེ་གཞན་ལ་བཏང་བ་ཡིས།",
    "པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པས་གསར་དུ་བཅུག་གནང་བ་རེད་ཅེས་གསུང་རྒྱུན་འདུག་གང་ལྟར་རྐང་པ་ལྔ་ཡོད་པ་རེད།",
    "གཞན་གྱི་སྡུག་བསྔལ་རྣམས་རང་གི་ལུས་སྤྱི་དང་།",
    "རབ་ཏུ་མ་ཞི་བར་བྱེད་པའི་ཉོན་མོངས་པ་ས་བོན་དང་བཅས་པ།",
    "ལན་གསུམ་པའི་སྐབས་སུ་ཉོན་མོངས་པ་དེས་བཞག་པའི་བག་ཆགས་ཏེ།",
    "དེ་ལྟར་བྱས་ནས་གཏོང་ལེན་གྱི་དམིགས་པ་རྣལ་དུ་སོང་དང་མ་སོང་ནི།",
    "སེམས་ལ་རྩུབ་རེག་རྒྱག་པ་ལྟ་བུ་ཡོང་གི་འདུག་ན།",
    "རང་གཅེས་འཛིན་ལ་གནོད་ཡོང་གི་ཡོད་པ་ཡིན།",
    "གཞན་རྣམས་ཀྱང་ང་ཚོ་བཞིན་སྡུག་བསྔལ་མི་འདོད་པ་དང་།",
    "གཞན་གྱི་སྡུག་བསྔལ་རྣམས་བདག་གིས་བླང་བར་བྱ་སྙམ་དུ།",
    "རང་གི་སྒོ་གསུམ་གྱི་ལེགས་པའི་ཆ་ཅི་ཡོད་ཐམས་ཅད་སེར་སྣས་ཀུན་ཏུ་འཛིན་པ་དང་།",
    "མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱི་རིགས་པ་ནི་དངོས་གནས་ཧ་ལས་དགོས་པ་ཞིག་རེད།",
    "མགོན་པོ་ཀླུ་སྒྲུབ་ནི་དངོས་ཡོད་གནས་ཚུལ་འབའ་ཞིག་ལ་བསམ་བློ་གཏོང་མཁན་ཞིག་ཡིན་པས་ཁོང་གི་བཀའ་ནི་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན།",
    "ཉིན་གུང་གི་ཟ་མ་བཟའ་བར་འགྲོ་དགོས།",
    "དེ་རིང་དགོང་མོ་འཁྲུངས་སྐར་སྤྲོ་ཚོགས་ཡོད་དམ།",
    "བཞད་མོ་བཞད།",
    "དེ་རིང་ནི་སྤྱི་ཟླ་བཅུ་གཉིས་པའི་ཚེས་ཉེར་ལྔ་ཡིན་པས་ཡེ་ཤ་འི་འཁྲུངས་སྐར་རེད།",
    "ཚོས་གཞི་འདྲ་མིན་སོགས་ཀྱིས་བརྒྱན་ནས་སྡོད་ཁང་གི་ཕྱི་ནང་གང་སར་སྒྲིག་གཤོམ་བྱེད།",
    "གཞན་གྱི་སྡུག་བསྔལ་རང་གི་ཐོག་ལ་ལེན་པ།",
    "ཉོན་མོངས་དུག་གསུམ།",
    "དེ་དག་གི་རྩ་བར་གྱུར་པའི་བདེན་འཛིན་དང་།",
    "ཕར་གཏོང་བའི་དམིགས་པ་བྱེད་སྐབས་རང་གི་དགེ་རྩ་གང་ཡོད་པ་རྣམས་ཏེ།",
    "ངན་འགྲོའི་སྡུག་བསྔལ་སྣ་ཚོགས་མྱོང་ནས་ཡོད་པ་རྣམས་ལ་རང་གི་དགེ་ཚོགས་སྦྱིན་ནས་འཕྲལ་གྱི་སྡུག་བསྔལ་སེལ་བ།",
    "ང་ཚོའི་ངོས་ནས་ཀྱང་དེ་ལྟ་བུའི་འཕྲིན་ལས་རྣམས་བདེ་བླག་ཏུ་འགྲུབ་པའི་ཆེད་དུ་དགེ་རྩ་བསྔོ་བར་གསུངས།",
    "དེ་ནས་ཚེ་གཅིག་གི་བློ་སྦྱོང་གི་ཉམས་ལེན་རྣམས་དྲིལ་ནས་སྟོན་པ་ལས།",
    "རྐྱེན་ངན་གྲོགས་སུ་ཤར་བའི་བློ་སྦྱོང་གི་ཉམས་ལེན་གོང་ནས་གོང་དུ་འཕེལ་ཐུབ་པ།",
    "ངས་གཏོང་ལེན་བྱས་པའི་དགོས་དོན་སྨིན་སོང་།",
    "ངའི་འདོད་དོན་འགྲུབ་སོང་།",
    "མི་དེ་རྫབ་ཆེན་ལྟ་བུ་ཞིག་ཆགས་ཡོང་གི་ཡོད།",
    "རེ་དྭོགས་ལུ་གུ་བརྒྱུད་ནས་བཅིངས་པ་དེ་མེད་པ་ཆགས་ནས།",
    "ཆེ་ས་ནས་ཉོན་མོངས་ལ་གཉེན་པོ་བསྟེན་ཏེ།",
    "བློ་སྦྱོང་གི་བསམ་པ་དང་ཉམས་ལེན་མ་ཉམས་པ་ཞིག་གལ་ཆེ་བར་བསམ་པའི་ཐོག་ནས།",
    "མི་ཚེ་གཅིག་གི་ནང་དུ་ཡང་འཕར་རྡིབ་མང་པོ་ཡོང་བ་ནི་སྐྱིད་སྡུག་གཉིས་ཡིན་པ་དང་།",
    "ཉོན་མོངས་སྐྱེ་བའི་རྐྱེན་ཡོད་ཀྱང་།",
    "རང་གི་མོས་པ་མང་པོའི་རྒྱུས།",
    "འདིའི་ལུང་མེད་ཀྱང་ཐེངས་གཅིག་ཀློག་གི་ཡིན།",
    "ངས་ནམ་རྒྱུན་འདི་ཏོག་ཙམ་ཀློག་གི་ཡོད།",
    "སེམས་ལ་ཧ་ཅང་ཕན་ཐོགས་འདུག་གསུང་འདི་ང་ཚོ་བདེ་ན་དགའ་བ་སྟེ་སྐྱིད་ན་དགའ་ཞིང་སྡུག་ན་མི་དགའ།",
    "སྐྱིད་ན་ཉོན་མོངས་དུག་ལྔ་འབར།",
    "སྨད་ན་རང་སྐྱོན་ཐེད་ལ་འབུད།",
    "རང་སྐྱོན་རང་གིས་མི་ཤེས་ཀྱང་།",
    "ནས་སྐྱོན་མཚང་ནས་བྲུས་ཡོང་བའི་སྐབས་རང་སྐྱོན་ནམ་རང་གི་རང་བཞིན་ངོས་ཟིན་ཐུབ་པ་དང་།",
    "ཅེས་གསུངས་པ་ལྟར་ཧ་ཅང་ཡག་པོ་རེད།",
    "འབྱོར་བ་བྱུང་ན་གསོག་སྲུང་གི་སྡུག་བསྔལ་ཡོང་བ་ནི་བདེན་པ་རེད།",
    "ཤེས་མི་ཡོང་ངམ་སྙམ་པའི་སེམས་འཁྲལ་ཧ་ཅང་བྱེད་དགོས་པ་ནི་སྣོན་པ་རང་རེད།",
    "སྡོད་གནས་སྤོ་བའི་སྐབས་སུ་ཡང་སོ་སོའི་གཟུགས་པོར་གང་ཡོད་པ་དེ་ལས་ཕ་གཞིས་ས་ཁང་གི་ཚོད་གཞན་ཅི་ཡང་མེད་པ་ནི།",
    "ལྷ་གྲལ་ཐོབ་ཅེས་བུད་ཉུལ་ཐོབ་གསུམ་གསུངས་པ་རྣམས་དངོས་ཡོད་གནས་ཚུལ་ཡིན་པར་མ་ཟད།",
    "རྗེ་བཙུན་མི་ལ་ལྟ་བུ་སོགས་ནི་ཧ་ལས་པའི་རླབས་ཆེན་རེད།",
    "ཞེས་གསུངས་པ་རྣམས་ངོ་མ་ཧ་ལས་པ་རེད།",
    "མི་གཞན་གྱིས་རྒྱུ་ཅ་ལག་གི་རྔན་པ་སྤྲོད་པར་གཟབ་གཟབ་མ་བྱས་ན་དཀོར་ཆགས་ནས།"
  ]
}