    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་དེ་བས་ན་ཁྱོད་ཀྱིས་༡༩རང་གི་ལུས་ཀུན་ཏུ་ལྟ་བའི་མྱིག་དང་ལྡན་པར་བྱིན་གྱིས་རློབས་ལ་ཤེས་རབ་ཀྱི་མིག་ནམ་མཁའི་དབྱིངས་ཀྱིས་ཀླས་པར་བྱིན་གྱིས་རློབ་སྟེ་སྐུ།",
    "ཡེ་ཤེས་ཡངས་པའི་མིག་དམིགས་པ་ཐམས་ཅད་ཀྱི་རྗེས་སུ་སོང་ལ་༢༡ཁོང་དུ་ཆུད་པར་གྱིས་ལ་༢༢ཕྱོགས་འབྱམ་༢་ཀླས་པ་ཐམས་ཅད་དུ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བྱིན་གྱིས་རློབ་སྟེ་།",
    "མཆོག་གི་བློ་གྲོས་དང་ལྷའི་བློ་གྲོས་དང་།",
    "སྐད་ཅིག་གཅིག་གི་བློ་གྲོས་དང་།",
    "རང་བཞིན་གྱི་རྒྱན་དང་ཡུལ་ཟབ་མོ་དང་གནས་དང་གནས་མ་ཡིན་པ་ལ་མཁས་པ་དང་།",
    "ཡེ་ཤེས་རྡོ་རྗེའི་བློ་གྲོས་དང་ཀུན་ཏུ་མིག་གི་དཔལ་དང་།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ལ་གཟར་རིནས་པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་གང་ན་༥བ་དེར་ཐལ་མོས་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གལ་ཏེ་བདག་གིས་ཞུས་ནས་ཞུས་པའི་ལུང་བསྟན་པར་བཅོམ་ལྡན་འདས་ཀྱིས་སྐབས་དབྱེ་བར་གནང་ན།",
    "ཀུན་ཏུ་མིག་ཁྱོད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ལ་ཅི་དང་ཅི་འདོད་པ་དྲིས་ཤིག་དང་ངས་དྲིས་པ་དེ་དང་།",
    "དེའི་ལུང་བསྟན་པས་ཁྱོད་ཀྱི་སེམས་ཚིམ་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱིཉེཁྱུ་མཆོག་གི་མཐུ་དང་རྣམ་པར་འཕྲུལ་པ་དང་ལྡན་པ་ལགས་དེ་སྐད་ཅེས་གསོལ་པ་དང་སྐེ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་ཀུན་ཏུ་བཟང་པོ་དེ་མ་མཐོང་ངོ།",
    "ངག་གི་སྤྱོད་ཡུལ་གསང་བ་དང་།",
    "ཕྱོགས་ཐམས་ཅད་དུ་མངོན་དུ་གྱིས་ལ་ཀུན་ཏུ་མིག་གི་ལས་སུ་བྱིན་གྱིས་རློབ་སྟེཁོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་བརྗོད་དུ་མེད་པ་རྣམ་པ་དྲུག་ཏུ་གཡོས་སོ་རོལ་མོ་བརྡུང་བ་དང་།",
    "ངན་སོང་གི་ལམ་གྱི་རྒྱུད་གསུམ་རྣམ་པརལ་ཞི་བར་གྱུར་ཏོ།",
    "ཀུན་ཏུ་མིག་དེ་ཁྱོད་ཀྱིས་ཇི་སྐད་དུ་སྨྲས་པ་དེ་བཞིན་ཏེ།",
    "ཞིང་འབྱམས་ཀླས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པའི་རྗེས་སུ་སོང་བ་དང་།",
    "ནེ་ཐམས་ཅད་གཟིགས་པ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པ་མེད་པའི་སེམས་རབ་ཏུ་བསྒོམས་པ་ཡིན།",
    "མཚན་མ་མེད་པ་ལ་མོས་པ་ཡིན།",
    "ཤར་ཕྱོགས་ནས་རྣམ་པར་ལྡང་བ་དང་ཤར་དང་བྱང་གི་༣མཚམས་སུ་སྙོམས་པར་ཞུགས་ཏེ།",
    "ནུབ་དང་བྱང་གི་མཚམས།",
    "ནུབ་དང་བྱང་གི་༢ཉམཚམས་ནས་རྣམ་པར་ལྡང་བ་དང་།",
    "འོག་གི་ཕྱོགས་སུ་སྙོམས་པར་ཞུགས་ཏེ།",
    "སྟེང་གི་ཕྱོགས་ནས་རྣམ་པར་ལྡང་བ་དང་།",
    "སྟེང་གི་ཕྱོགས་སུ་སྙོམས་པར་ཞུགས་ཤིང་ཝ་འོག་གི་ཕྱོགས་ནས་རྣམ་པར་ལྡང་བཏུསྟེ།",
    "པདྨོ་གཅིག་པོ་དེ་རང་གི་སྐྱིལ་མོ་ཀྲུང་གིས་༧རྒྱས་པར་ཁྱབ་པ་མེ་བྱིན་གྱིས་རློབ་བོ།",
    "རང་གི་ལུས་དེ་ལས་ཀྱང་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་སྟོན་ཏོ།",
    "གླིང་བཞི་པ་ཁྲག་ཁྲིག་བརྒྱ་པོ་རེ་རེ་ཞིང་ཡང་བདག་གི་ལུས་རེ་རེ་བྱིན་གྱིས་གཤེ་རློབ་སྟེ།",
    "ལུས་དེ་དག་རེ་རེ་ལའང་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཁྲག་ཁྲིག་བརྒྱ་བརྒྱ་སྟོན་ཏོ།",
    "འདུག་ཀྱང་ལུས་ཀྱི་སྟོད་གྱེན་དུ་འཕགས་པ་རི་རབ་ཀྱི་རྩེ་མོ་དང་མཉམ་ཡང་།",
    "སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་རེ་རེ་ལ་བྱིན་གྱིས་རློབ་སྟེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་དེ་དག་རེ་རེ་ཡང་ལུས་རྣམ་པར་དམིགས་པ།",
    "ལུས་དེ་དག་རེ་རེ་ལས་ཀྱང་འོད་གཟེར་ཧུ་གྱི་དཀྱིལ་འཁོར་མིསྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ནིརྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་རབ་ཏུ་འགྱེད་དོ།",
    "འོད་གཟེར་པརེ་རེ་ལ་ཡང་ཁ་དོག་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ཡང་དག་པར་སྟོན་ཏེ་སྙེ།",
    "ཁ་དོག་དེ་དག་རེ་རེས་ཀྱང་འཇིག་རྟེན་གྱི་ཁམས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་སྣང་བར་བྱེད་དོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཀུན་ནས་ཉོན་མོངས་པས་རབ་ཏུ་ཤེས་སོ།་",
    "ཆུ་ཀླུང་གི་རྒྱུན་༥་ཀྱང་སྟོན་ཏོ།",
    "བཟའ་ཤིང་གི་ར་བ་དང་།",
    "ལྷ་མ་ཡིན་གྱི་གནས་སུ་བཅས་པ་དང་ནམ་མཁའ་ཧུ་ལྡིང་གི་གནས་སུ་བཅས་པ་དང་།",
    "འཇིག་པ་དང་འདུ་བར་བཅས་པ་དང་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་དག་པ་དང་།",
    "ཝ་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་གྲངས་དེ་དག་གིས་ཀྱང་འཇིག་རྟེན་གྱི་ཁམས་འདིཤེདག་རྣམ་པར་འཇིག་པར་མི་༧བྱེད་དེསའཇིག་རྟེན་གྱི་ཁམས་འདི་དག་གིས་འཇིག་རྟེན་གྱི་ཁམས་དེ་དག་རྣམ་པར་འཇིག་པར་མྱི་བྱེད་དོ།",
    "སྒྱུ་མའི་སྤྲིན་དེ་དག་གིས་ཀྱང་ས་འདི་རླན་པར་མི་འགྱུར་ཏེ།",
    "གཅིག་གིས་གཉིས་པ་ཡངསྙི་འཇིག་པར་མི་བྱེད་དོ།",
    "རྗེས་སུ་སྒོམ་མོ།",
