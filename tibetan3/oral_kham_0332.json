    "ཡུལ་དང་ཕྱི་བཅས་འདྲེས་མ་མང་པོ་ཞིག་འདུག་པ་དེར་གནའ་བཟང་དེང་སྤྱོད་དང་།",
    "འདི་ལས་ཀྱང་རང་ཡུལ་བོད་ནང་རྒྱ་ཆེའི་མི་མང་རྣམས་ཁག་པ་ཡོད་ངེས་བསམ་བློར་འཁོར་དགོས།",
    "འོན་ཀྱང་ཡུལ་གྱི་བདག་པོར་གྱུར་ཏེ་ལས་འགན་འཁུར་བ་ལ་སློབ་སྦྱོང་ལེགས་པར་བྱས་ཏེ་རང་རང་ཡོན་ཏན་གྱི་གནས་ཚད་དང་།",
    "དངོས་གཞིའི་ལག་ལེན་ལའང་དེ་བཞིན་བསྟར་རྒྱུ་གལ་ཆེན་པོ་འདུག་པས་ཚང་མར་ང་སྒེར་གྱི་ཆ་ནས་དེ་དོན་གཞེན་བསྐུལ་ཞུ་རྒྱུར་ཐུགས་ལ་བཅང་རོགས་གནང་།",
    "དམ་བསྒྲགས་ཀྱང་ཇེ་ཆེར་ཕྱིན་འདུག་དཔེར་ན།",
    "ཡང་བསྐྱར་བརྗོད་པར་འགལ་བ་གང་ཡང་མི་འདུག་སྤྱི་ལོ་༡༩༦ ཟླ་བ་༩ པ་བར་བོད་མི་བསད་པ་ལ།",
    "ཡི་གེར་བྲིས་པ་ཙམ་མིན་པར་ལག་ལེན་དུ་འགེལ་རྒྱུ་གལ་ཆེན་པོ་འདུག་དེར་བརྟེན་དམ་ཚིག་ཆིག་སྒྲིལ་ཡག་པོ་མ་བྱུང་ན།",
    "ད་དུང་ཤུགས་སྣོན་རྒྱག་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཆ་",
    "འདི་དག་ནས་ཀྱང་གནས་ཚུལ་གསལ་པོ་གང་འདྲ་ཞིག་བསྟན་འདུག་ག་",
    "རང་རང་སོ་སོས་དོན་དམ་ལག་ལེན་གྱི་ཐོག་ནས་བསྟན་པ་འཛིན་པ་དང་།",
    "གཙོ་བོ་ཕན་ཚུན་གྱི་ནུས་པ་སྦྲེལ་ཏེ་སྒྲུབ་དགོས་པའི་གནས་ཚུལ་དེ་གཞི་ལ་བཞག་ནས་མཉམ་རུབ་ཀྱིས་ནུས་ཤུགས་འདོན་པའི་སྤྱིའི་སྒྲིག་འཛུགས་མཐོ་ཤོས་ཤིག་ཡོད་དགོས་པ་དེ་ལ་བརྟེན་ནས་གཞུང་ཞེས་པ་འདི་ཆགས་པ་ཡིན་འདུག་དེས་ན་སྤྱི་སྒེར་ཚང་མའི་བདེ་སྡུག་གནས་སའི་སྤྱིའི་སྒྲིག་འཛུགས་ནུས་པ་ཆེ་ཤོས་དེ་གཞུང་ཡིན་དགོས་པ་དང་།",
    "བོད་ནང་སྲིད་ཚབ་བློ་བཟང་བཀྲ་ཤིས་ཀྱང་རྒྱ་མིའི་མནར་གཅོད་འོག་ཏུ་འདས་ཚར་ཡོད་འདུག་བོད་ནང་རྒྱ་མིའི་གནས་ཚུལ་ཐོག་མ་འགོ་ཚུགས་ཁག་པོ་ཡོད་པའི་སྐབས་སུ་འགན་འཁུར་མཁན་སྲིད་ཚབ་བློ་བདེ་གཉིས་ཞེས་བློ་བཟང་བཀྲ་ཤིས་དང་།",
    "ས་གནས་འགའ་ཤས་ལ་འདི་ག་ཙམ་ཞིག་མིན་འགྲོ་བསམ་མཁན་ཡང་བྱུང་ཡོད།",
    "འཕྲོ་བརླགས་མི་འགྲོ་བ་ཞིག་ཚང་མས་གཟབ་གཟབ་བྱ་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་མིན་ནམ་བསམ་གྱི་འདུག་ག་",
    "ཚང་མས་ངེས་པར་དོ་སྣང་དགོས་ཀྱི་འདུག་ཅེས་དེ་རིང་འདིར་ཡང་བསྐྱར་ཞུ་རྒྱུ་ཡིན།",
    "ཚུར་ཙམ་དེར་རྒྱ་མིའི་ཆ་ནས་ད་ལྟ་བདེ་སྲུང་བཀའ་བློན་གྱིས་གསུམ་བཅུའི་དུས་དྲན་ངོ་སྤྲོད་གནས་ལུགས་གསུངས་པ་ཇི་བཞིན།",
    "ཐུབ་བསྟན་ཉི་མ་ཟེར་བ་ཞིག་འདུག་ཐུབ་བསྟན་ཉི་མ་ཟེར་བ་དེ་ཕལ་ཆེར་ཞོལ་ཁང་རྗེ་དྲུང་མིན་ནམ།",
    "དེ་ནི་དམ་ཚིག་ཟོང་ཁ་གཅིག་སྒྲིལ་ཟེར་བ་དེ་རང་ལ་ཐུག་འདུག་དམ་ཚིག་ཟོང་ཁ་གཅིག་སྒྲིལ་ངག་ནས་སྐྱོར་བཞིན་པ་དེ་ལྟར་ཡིན་ན་ཡང་དོན་ཐོག་ལ་གང་འདྲ་ཡོད་དམ།",
    "འདི་ལོ་དང་སྔ་ལོ་གཉིས་ཀྱི་བར་ལའང་བོད་རིགས་གཞོན་ནུ་ཚོའི་ནང་ལ་ཧ་ལས་པའི་སེམས་ཤུགས་ཆེན་པོ་འཁྱེར་ནས་རྩ་བའི་སྒྲིག་འཛུགས་ཁག་མང་པོ་བཟོས་འདུག་ཅིང་།",
    "མ་གཞི་ད་ལྟ་དེ་ལྟར་ཡོད་པའི་སྐད་ཆ་གོ་ཐོས་མི་འདུག་ཀྱང་གཟབ་གཟབ་བྱེད་དགོས།",
    "རང་རང་སོ་སོར་སྐབས་སུ་གང་བབས་ཀྱི་ཐོན་སྐྱེད་ཀྱི་ལས་ཀ་བྱེད་མཁན་ཡིན་ཚེ།",
    "རང་བཞིན་ལྷན་སྐྱེས་སུ་ཡོད་པའི་སྤྱོད་གཤིས་བཟང་པོ་དེ་དག་རང་རང་སོ་སོས་ངོས་འཛིན་ཐུབ་པ་ཞིག་དང་།",
    "རང་ཉིད་ཀྱི་ལུང་པ་རྒྱུས་ཡོད་ཅན་གྱི་བོད་མི་བཙན་བྱོལ་བའི་ཁྲོད་དུ་རང་རང་སོ་སོའི་ཕ་མ་བུ་ཕྲུག་དང་།",
    "ལོ་ནས་ལོ་སྦྲེལ་ཏེ་ཉིན་ཞག་ཕྲུགས་གཅིག་ནང་རང་ཉིད་ཀྱི་སྐབས་སུ་གང་བབས་ཀྱི་ལས་འགན་དེ་དག་ཡར་རླངས་མར་ཐིགས་མེད་པ་ཚགས་སུ་ཚུད་པ་ཞིག་སྒྲུབ་ཐུབ་ན་དེས་རང་བཙན་ལ་ཕན་ཐོགས་ཡོད།",
    "ངོས་ནས་འདིར་མང་པོ་བརྗོད་དགོས་དོན་མི་འདུག།",
    "བསམ་བློ་གཏོང་རྒྱུའི་ཐོག་ལ་གང་ཐུབ་ཀྱིས་འབད་བརྩོན་དང་དོ་སྣང་བྱ་རྒྱུ་གལ་ཆེན་པོ་འདུག་ག་",
    "མཐའ་གཉིས་སུ་མ་ལྷུང་བའི་ཐོག་ནས་འབད་བརྩོན་བྱེད་དགོས་པའི་དུས་སྐབས་ཤིག་ལ་སླེབས་འདུག་ཚང་མས་དེ་དག་སེམས་ལ་ངེས་པའི་ཐོག་ནས་འབད་བརྩོན་བྱེད་རོགས་ཞེས་བརྗོད་རྒྱུ་ཡིན།",
    "གཞན་ཕན་གྱི་བསམ་པ་དང་ལྡན་པའི་ཞིང་བྲན་ལམ་ལུགས་ཤིག་ཆགས་ཡོད་བསམ་གྱི་འདུག་ང་",
    "དངོས་ཡོད་གནས་ཚུལ་ཤེས་ཀྱི་མེད་པའི་སྐྱོན་ཆེན་པོ་འདུག་ཅེས་བརྗོད་རྒྱུ་བྱུང་།",
    "གང་ལྟར་བོད་ཀྱི་གནས་ཚུལ་ངོ་མ་དེ་རྒྱ་མིའི་དཔོན་རིགས་ཚོས་ཏན་ཏན་ཤེས་ཀྱི་མི་འདུག་ལ་ཁག་ཀྱང་མི་འདུག་བོད་ནང་ལ་ལས་ཀ་བྱེད་མཁན་མང་ཆེ་བ་ཡག་པོ་ཡོད་ཀྱང་།",
    "རྒྱ་མིའི་མདུན་ལ་འཕྲལ་སེལ་གྱི་ངོ་དགའ་སྤྲེལ་ལད་འཁྲབ་མཁན་དེ་རིགས་འདུག་དཔེར་ན།",
    "ལག་རྗེས་འཇོག་ཐུབ་མཁན་དེ་རིགས་གང་མང་ཐོན་དགོས་ཀྱི་འདུག་ཅེས་ངོས་ནས་འདིར་འབོད་སྐུལ་བྱེད་ཀྱི་ཡོད།",
    "ཕུགས་བརྟན་པོ་ཞིག་མི་འདུག་ཅེས་ཚང་མས་ངོས་འཛིན་གསལ་པོ་བྱེད་ཀྱི་ཡོད།",
    "རིག་གཞུང་སྲུང་སྐྱོབ་བྱེད་ཅེས་པ་དེ་ཡང་རང་ཉིད་ཀྱི་གཤིས་རྒྱུད་ལ་བརྟེན་དགོས་པ་ཞིག་དང་།",
    "དེ་ལ་ཞབས་འདེགས་ཞུ་ཐུབ་པ་བྱ་རྒྱུ་དེ་ཤིན་ཏུ་གལ་ཆེན་པོ་འདུག་སོ་སོའི་རིག་གཞུང་ལ་གཅེས་སྤྲས་དང་།",
    "ས་ཆ་དེའི་བདག་པོ་མིན་པའི་རྒྱ་རིགས་མང་བ་ཆགས་འདུག་དེ་བཞིན་རྒྱ་མིས་ཤིན་ཅང་དུ་འབོད་པ་ཤར་ཏུར་ཀི་སི་ཐན་ནང་སྤྱི་ལོ་༡༩༥ དང་༡༩༥༡ དུས་སྐབས་སུ་རྒྱ་རིགས་བརྒྱ་ཆ་བཞི་ལས་མེད།",
    "ཕར་ཙམ་དེར་རྒྱ་མི་ས་ཡ་སྟོང་ཕྲག་གཅིག་ལ་ཉེ་བ་ཡོད་པས་གྲངས་ཀར་མང་ཉུང་ཡོད་ཀྱང་།",
    "ང་རང་སྒེར་གྱི་ངོས་ལ་ཆ་བཞག་ན་མཐོ་ཡང་དགེ་སློང་ཞིག་དང་།",
    "ང་རང་ལ་བདག་པ་ཞིག་ཡིན་བསམ་གྱི་མེད།",
    "དེར་བརྟེན་ད་ཕན་སོ་སོ་རང་ཉིད་ཀྱི་ཐོག་ལ་དངོས་སུ་མྱངས་པའི་སྡུག་བསྔལ་གྱི་རྣམ་གྲངས་འདྲ་མིན་དེ་དག་དངོས་དངོས་རྗེན་རྗེན་ཡིག་ཐོག་ལ་བཞག་རྒྱུ་གལ་ཆེན་པོ་འདུག་དེ་རིང་དམིགས་བསལ་གྱི་འབོད་སྐུལ་ཞུ་རྒྱུར།",
    "ལྷག་པར་དེ་རིགས་བོད་ནང་ནས་འབྲི་ཐུབ་ན་ཡག་པོ་འདུག།",
    "རིམ་པས་གནས་ཚུལ་འབྱོར་བ་ཁག་གཞིར་བཞག་ལྟར་ན་ཧ་ལམ་མི་བརྒྱ་ཕྲག་བསད་མེད་དམ་བསམས་པའི་དོགས་པ་འདུག།",
    "དེ་དག་མེད་པར་བཟོས་རྗེས་ཕལ་ཆེར་བོད་མིའི་ཐོག་ཏུ་སྡུག་སྦྱོང་དང་གནོན་བཙིར་ཧ་ལས་པའི་ཤུགས་ཆེ་ཞིག་བྱས་མི་ཡོང་ངམ་བསམས་པའི་བློ་གཡེང་འདུག།",
    "ད་མུས་བཞིན་ཞི་འཇམ་གྱི་སྲིད་བྱུས་བཟུང་རྒྱུ་དགེ་མཚན་ཆེ་ལུགས་བརྗོད་ནས་སྐབས་དེར་འདི་དག་ཤུགས་ཆེ་བ་བྱུང་འདུག།",
    "སྡུག་པོ་མྱང་རྒྱུ་ཡོད་ཚད་ཚང་མ་མྱངས་ཟིན་པས་བསམ་བློ་གཏོང་རྒྱུ་གཞན་མི་འདུག་ཀྱང་།",
    "བོད་པས་འཇོན་ན་རྒྱ་མི་སྡོད་དགོས་དོན་མེད་ཅེས་ཧམ་པ་དེ་ལས་ཆེ་ཙམ་ཚུར་ཤོད་ཀྱི་འདུག།",
    "བོད་པས་ཤེས་ཀྱི་མི་འདུག་ཅེས་ཤོད་ཀྱི་འདུག།",
    "རྒྱ་ཡིག་ལས་བོད་ཡིག་སློབ་ཀྱི་མི་འདུག་པས།",
    "བོད་པས་ཕར་མེ་མདའ་རྩ་བ་ནས་བརྒྱབ་མེད་པ་ཕྱི་རྒྱལ་གྱི་མི་མང་པོས་ཁ་གྲགས་ནས་བོད་པའི་ལག་པར་མེ་མདའ་རྩ་བ་ནས་མི་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "སྔ་ལོ་ནས་དམག་མི་དབོར་འདྲེན་གྱི་གོ་མཚོན་ལྡན་པའི་རླངས་འཁོར་ཆེ་བ་ཁག་ཡོད་མུས་ཐོག་ད་ལན་ལྕགས་ཁྲབ་འཁོར་ལོ་ཁག་ཆེད་འཛུགས་བྱས་ཡོད་འདུག།",
    "རྙོག་གྲ་དེ་འདྲ་ཞིག་མི་ཡོང་བའི་བསམ་བློ་ཞིབ་ཚགས་སྔོན་ཚུད་ནས་གཏོང་རྒྱུ་གལ་ཆེན་པོ་ཆགས་འདུག།",
    "དེར་བརྟེན་རྟགས་མཚན་གསལ་པོ་གང་ཞིག་འདུག་ཅེ་ན།",
    "ད་དུང་དེ་འདྲའི་ཐོག་བསམ་བློ་གཏོང་རྒྱུ་གལ་ཆེན་པོ་མེད་དམ་སྙམ་པས་ཚང་མས་བྱེད་ཐབས་གསར་པ་གང་ཞིག་འདུག་བསམ་བློ་གཏོང་དགོས།",
    "ད་དུང་ངོས་ནས་ཁ་བྲལ་གྱི་ལས་འགུལ་སྤེལ་གྱི་འདུག་ཅེས་མཐའ་གཅིག་ཏུ་ངོ་རྒོལ་བྱེད་ཀྱི་ཡོད།",
    "བོད་པའི་གཤིས་ཀ་ལ་ཛ་དྲག་གནས་ཚུལ་ཞིག་མ་བྱུང་ན་ལྷོད་གཡེང་བྱེད་པའི་ཉེན་ཁ་ཕྲན་བུ་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "དོན་དམ་བཅིངས་བཀྲོལ་བཏང་བར་ཡོང་བའི་ངོས་འཛིན་བྱེད་མཁན་གཅིག་ཀྱང་མི་འདུག་བོད་ལ་རྒྱ་མིས་བཙན་འཛུལ་བྱས་པ་དེ་དངོས་ཡོད་གནས་ཚུལ་ཡིན་སྟབས།",
    "བཙན་བྱོལ་ལ་ཡོད་པའི་མི་རབས་གསར་པ་ཚོས་གནས་ཚུལ་གང་ཡང་མ་ཤེས་ཀྱང་རང་ཉིད་ཀྱི་ཕ་མ་དང་།",
    "འཚེ་བའི་རང་བཞིན་ཅན་ཞིག་ལ་འགྲོ་རྒྱུ་ཐག་ཉེ་པོ་འདུག་གནས་ཚུལ་གཅིག་ནི་གོང་དུ་བརྗོད་པ་བཞིན།",
    "དེ་ཡང་ཅི་འདྲ་ཞིག་ཆགས་ཡོང་བསམ་གྱི་འདུག།",
    "དེ་མིན་བསམ་བློའི་ནང་མ་བདེ་བ་ཞིག་ཡོད་བཞིན་དུ་ངོས་ནས་ཁུ་སིམ་ངང་བསྡད་ན་ཡག་པོ་མི་འདུག་སྙམ་སྟེ།",
