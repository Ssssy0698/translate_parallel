    "ཆུད་མི་ཟ་བའང་ཚོགས་དང་དུས།",
    "རྒྱལ་པོ་ཚངས་སྦྱིན་གྱིས་ཀྱང་སྐྱེད་མོས་ཚལ་ག་གེ་མོ་ཞེས་བྱ་བར་དྲང་སྲོང་དུང་དང་བྲིས་པ་སྤུན་གཉིས་གནས་ཏེ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་དུང་གིས་རིལ་བ་ཆུས་བཀང་ནས་རྩ་བ་དང་འབྲས་བུའི་ཆེད་དུ་ནགས་ཁྲོད་དུ་སོང་ངོ།",
    "བྲིས་པ་ཡང་དེ་ཉིད་ནས་ནང་པར་སྔར་ལངས་ཏེ་སོང་ནས་དེས་མེ་ཏོག་དང་འབྲས་བུ་དག་བླངས་ཏེ་རིངས་པར་འོངས་ནས་རང་གི་རིལ་བ་ལས་བརྟགས་ནས་ཆུ་ཉུང་ནས་དེ་སྐོམ་པས་ཉེན་པས་བསམས་པ།",
    "ཁོ་བོའི་ཆུ་རྐུན་ན་མ་སུ་ཞིག་གིས་བརྐུས།",
    "བདག་གིས་འཚལ་གྱིས་བདག་ལ་ཆད་པས་དགུམ་དུ་གསོལ།",
    "ཁོ་པོ་ཆད་པ་མི་གཅོད་ཀྱིས་ཅི་སྟེ་ཁྱོད་ཆད་པ་དོན་དུ་གཉེར་ན་རྒྱལ་པོའི་དྲུང་དུ་སོང་ཤིག།",
    "ལྷ་བདག་གིས་འགྱོད་པ་བསལ་བར་རྡོ་མི་ཐོག་གིས་ཆོམ་རྐུན་པ་ལ་འགུམ་པའི་ཆད་པ་ལྕི་བ་གང་ལགས་པས་བདག་ལ་དགུམ་དུ་གསོལ་ཞེས་དེ་སྐད་སྨྲས་པ་དང་།",
    "གལ་ཏེ་དེ་ལྟན་འདི་ཉིད་དུ་འདུག་ལ་རེ་ཞིག་ང་སླར་མ་ལོག་གི་བར་དུ་ཁྱོད་མ་འགྲོ་ཤིག།",
    "བློན་པོ་རྣམས་ཀྱིས་ཞག་དྲུག་གི་ཉིན་པར་རྒྱལ་པོ་ལ་སྨྲས་པ།",
    "ཆད་པ་ནས་ཕྱུང་ལ་དེའི་ཆད་པ་ནི་དེ་ཁོ་ན་ཡིན་གྱིས་སོང་ཤིག།",
    "དྲང་སྲོང་ལྷའི་ཞལ་ནས་ཆད་པ་ནས་ཕྱུང་ལ་དེའི་ཆད་པ་ནི་དེ་ཁོ་ན་ཡིན་གྱིས་སོང་ཤིག་ཅེས་གསུང་ངོ།",
    "དེ་འགྱོད་པ་དང་བྲལ་ཏེ་སོང་ངོ།",
    "ཆུད་མི་ཟ་པའང་ཚོགས་དང་དུས།",
    "དབྱུག་པ་ལ་སོགས་པས་ཤིན་ཏུ་བརྡེགས་ནས་བསྐྲད་དེ་དེ་བཱ་རཱ་ཎ་སཱིའི་ཕྱི་རོལ་ན་རྒྱལ་པོའི་སྐྱེད་མོས་ཚལ་ཞིག་ཡོད་པ་ན་གནས་སོ།",
    "མེ་ཏོག་གི་ཤིང་རྣམས་ཁ་འབུས་ཤིང་ངང་པ་དང་།",
    "བུད་མེད་ནི་མེ་ཏོག་དང་འབྲས་བུ་ལ་དགའ་བ་ཡིན་པས།",
    "བཙུན་མོའི་བུད་མེད་རྣམས་ཀྱང་རིངས་པ་རིངས་པར་དོང་ངོ།",
    "ཇི་ཙམ་ན་བུད་མེད་གཞན་ཞིག་རྟབས་པས་མུ་ཏིག་གི་དོ་ཤལ་པོར་ཏེ་སོང་ངོ།",
    "ཇི་ཙམ་ན་མུ་ལྟོ་བ་དེ་སྐྱོང་མོས་ཚལ་དེར་གྱུ་བར་བརྩམས་པ་ན།",
    "དེ་སྐྱེད་མོས་ཚལ་ཉིད་དུ་ཤིང་གི་ཡལ་གཞིག་ལ་བཏགས་ཏེ་བཞག་གོ།",
    "ཇི་ཙམ་བཙུན་མོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་གསོལ་པ།",
    "ལྷ་བཙུན་མོ་ཆེ་གེ་མོ་ཞེས་བྱི་བའི་མུ་ཏིག་གི་དོ་ཤལ་སྐྱེད་མོས་ཚལ་དུ་ལུས་ལགས་སོ།",
    "ཤེས་ལྡན་དག་མུ་ཏིག་གི་དོན་ཤལ་སྐྱེད་མོས་ཚལ་དུ་ལུས་པ་ཚོལ་ཅིག།",
    "དེ་རྣམས་སྐྱེད་མོས་ཚལ་དུ་དོང་ནས་བཙལ་བར་བརྩམས་པ་དང་།",
    "ཇི་ཙམ་ན་ཤིང་གི་ཡལ་ག་ཞིག་ལ་བཏགས་པ་མཐོང་ནས་དེ་རྣམས་ཀྱིས་བསམས།",
    "རེ་ཞིག་འདི་སུས་བཏགས་དཔྱད་པར་བྱའོ་སྙམ་ནས་དེ་རྣམས་སྐྱེད་མོས་ཚལ་ན་རྒྱུ་བར་བརྩམས་པ་དང་།",
    "ཀྭའི་ནང་རྗེ་མུ་ཏིག་གི་དོ་ཤལ་འདི་སུ་ཞིག་གིས་ཡལ་ག་ལ་བཏགས་ཏེ་བཞག།",
    "བློན་པོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་མུ་ཏིག་གི་དོ་ཤལ་ཕུལ་ནས་ཇི་ལྟར་གྱུར་པ་སྨྲས་སོ།",
    "ཀཱའི་ནང་རྗེ་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་མུ་ཏིག་གི་དོ་ཤལ་གི་ཡལ་ག་ལ་བཏགས་ཏེ་བཞག་ནས་རང་གིར་མ་བྱས།",
    "ཀྭའི་ནང་རྗེ་ཁྱོད་ནི་དམ་པ་འོས་པ་ཡིན་པས་དམ་པ་གང་འདོད་པ་གསོལ་ཅིག་སྦྱིན་ནོ།",
    "གལ་ཏེ་ལྷ་བདག་ལ་དགྱེས་པར་གྱུར་ན་མུ་ལྟོ་བ་རྣམས་འཚལ་མ་སྩལ་ཅིང་དེ་རྣམས་རེ་རེ་ལ་རས་ཟུང་རེ་བསྐོན་ནས་བདག་དཔོན་པོར་བསྐོ་བར་གསོལ།",
    "ཤེས་ལྡན་དག་ཁྱེད་ཅག་གིས་མུ་ལྟོ་བ་ཐམས་ཅད་ཟན་བྱིན་ལ་རེ་རེ་ལ་རས་ཟུང་རེ་བསྐོན་ཏེ་འདི་དེ་རྣམས་ཀྱི་དཔོན་པོར་ཆུག་ཤིག།",
    "ལྷས་བཀའ་སྩལ་གྱི་བཱ་རཱ་ཎ་སཱིའི་མུ་ལྟོ་བ་ཇི་སྙེད་པ་ཐམས་ཅད་སྐྱེད་མོས་ཚལ་ཆེ་གེ་མོ་ཞིག་ཏུ་འདུས་ཤིག།",
    "ངས་མུ་ལྟོ་བ་རྣམས་ལ་ཟས་སྦྱིན་ཞིང་རེ་རེ་ལ་ཡང་རས་ཟུང་རེ་བསྐོན་ནོ་ཞེས་བསྒྲགས་པ་དང་།",
    "དེ་དག་ཐམས་ཅད་འདུས་ནས་བློན་པོ་རྣམས་ཀྱིས་ཁ་ཟས་བསོད་པས་ཚིམ་པར་བྱས་ནས་རེ་རེ་ལ་ཡང་རས་ཟུང་རེ་བསྐོན་ཏེ་བསྒོ་བ།",
    "དེ་ཕན་ཆད་ཁྱེད་ཅག་གི་རྒྱལ་པོར་མུ་ལྟོ་བ་འདི་བསྐོས་ཀྱིས།",
    "ཁྱེད་ཅག་གིས་འདིའི་ཚིག་བཞིན་དུ་བྱོས་ཤིག།",
    "རས་ཟུང་རེ་བསྐོན་པས་ཡི་རངས་ནས་སྨྲས་པ།",
    "ཇི་ཙམ་ན་མི་ཞིག་སྣུམ་ཁུར་དག་ཁྱེར་ནས་ཚོང་འདུས་ཀྱི་དབུས་ནས་སོང་བ་ལས་མུ་ལྟོ་བའི་དཔོན་པོ་དེས་དེ་ལ་ཕྲོགས་ནས་དེ་ཁྱེར་ཏེ་ཕྱོགས་དབེན་པ་ཞིག་ཏུ་སོང་བ་དང་།",
    "མུ་ལྟོ་བ་རྣམས་ཀྱིས་ཕྱིར་འབྲངཏེ་དེ་རྣམས་ཀྱིས་དེ་ལ་གླགས་བལྟས་པ་ན་འབབ་ཆུ་བ་རི་ཀ་རྒལ་ནས་ཤིང་ཞིག་གི་དྲུང་དུ་འདུག་གོ།",
    "གདོན་མི་བ་བར་གིས་ཡོན་གནས་དམ་པ་འདི་ལྟ་བུ་ལ་བྱ་བ་མ་བྱས་པ་དེས་ན་ཡང་མུ་ལྟོ་བར་སྐྱེས་ཀྱིས།",
    "གལ་ཏེ་བདག་ཉིད་ཆེན་པོ་འདི་བདག་ལས་སྣུམ་ཁུར་བཞེས་པར་གྱུར་ན་བདག་གིས་དེ་དབུལ་ལོ་སྙམ་མོ།",
    "དེ་རྣམས་ཀྱིས་སྨྲས་པ་བདག་ཅག་ཁོ་ན་ཁྱོད་ཀྱི་མི་གཙོ་བོ་རྣམས་སུ་གྱུར་ཅིང་།",
    "དེ་རྣམས་ཀྱི་རྒྱལ་པོར་ཁྱོད་གྱུར་ཅིག།",
    "བདག་ཅག་ཁྱོད་ཀྱི་མི་གཙོ་བོ་རྣམས་སུ་གྱུར་ཅིང་དེ་རྣམས་དེ་རྣམས་ཀྱི་རྒྱལ་པོར་ཁྱོད་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "དེ་ནས་སྤྲེའུ་ཤིག་ཤིང་སཱ་ལ་ལས་བབས་ནས་ལྷུང་བཟེད་རྣམས་རྣམས་གང་ན་ཡོད་པ་དེར་སོང་བ་དང་།",
    "དེ་ནས་སྤྲེའུ་དེ་བཅོམ་ལྡན་འདས་ཀྱི་ལྷུང་བཟེད་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "དེ་ནས་སྤྲེའུ་དེས་མཐའ་གཅིག་ཏུ་སོང་ནས་སྲོག་ཆགས་བསལ་ཏེ་བཅོམ་ལྡན་འདས་ལ་ཕུལ་བ་དང་།",
    "དེ་ནས་སྤྲེའུ་དེ་མཐའ་གཅིག་ཏུ་སོང་སྟེ་ཆུ་གྲང་མོས་བཏབ་ནས་བཅོམ་ལྡན་འདས་ལ་ཕུལ་བ་དང་།",
    "དེ་ནས་སྤྲེའུ་དེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་གི་སྦྲང་རྩིའི་ལྷུང་བཟེད་བཞེས་སོ་སྙམ་དུ་རིག་ནས།",
    "གང་གི་ཉི་མ་ཁོ་ན་ལ་ཉིང་མཚམས་སྦྱོར་བ་བླངས་པ་དེ་ཁོ་ནའི་ཉི་མ་ལ་སྦྲང་རྩིའི་ཆར་བབ་བོ།",
    "ཇི་ཙམ་ན་བྲམ་ཟེ་མོ་དེ་ཟླ་བ་བརྒྱད་དམ་དགུ་འདས་ནས་ཁྱེའུ་ཞིག་བཙས་སོ།",
