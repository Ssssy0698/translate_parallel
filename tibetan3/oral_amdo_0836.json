    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་རབ་ཏུ་བྱུང་ཡང་རུང་མ་བྱུང་ཡང་རུང་།",
    "རེ་ཞིག་ཁོ་བོ་ནི་རབ་ཏུ་འབྱུང་ངོ།",
    "དེ་ནས་རྒྱལ་པོ་ཀྲྀ་ཀཱིས་དེཉིད་ཀྱི་ནུབ་མོ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བདག་སྟ་གོན་བྱས་ནས་ནང་པར་སྔར་ལངས་ཏེ་གདན་བཤམས་ནོར་བུའི་ཆུ་སྣོད་བཞག་ནས།",
    "རྣམ་གྲངས་དུ་མར་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་རང་གི་ལག་ནས་བསྟབས་ཤིང་ཚིམ་པར་བྱས་སོ།",
    "ཡང་དག་པར་རྫོགས་པའི་སགས་རྒྱས་འདོ་སྲུང་གིས་ཞལ་ཟས་གསོལ་ཟིན་ཏེ།",
    "བྱི་བྲུན་མ་གཏོགས་པར་རང་གིས་ས་མི་རྐོ་ཞིང་བརྐོར་མི་འཇུག་གོ།",
    "མོན་སྲན་གྲེའུ་ལ་སོགས་པ་མཐའ་གཅིག་ཏུ་ཞོག་ལ།",
    "རིམ་གྱིས་བསོད་སྙོམས་ལ་རྒྱུ་བ་ན་རྫ་མཁན་དགའ་སྐྱོང་གི་ཁྱིམ་གང་ན་བ་དེར་གཤེགས་ཏེ་བྱོན་ནས་སྒོ་འཕར་ལ་མི་དྲག་པར་དལ་བུ་དལ་བུས་བརྡབས་པ་དང་།",
    "དེའི་ཚེ་རྫ་མཁན་དགའ་སྐྱོང་ནི་དགོས་པ་འགའ་ཞིག་གི་ཕྱིར་ཕྱི་རོལ་དུ་སོང་བར་གྱུར་ནས།",
    "རྫ་མཁན་དགའ་སྐྱོང་གི་ཕ་མས་སྒོ་འཕར་བརྡབས་པའི་སྒྲ་ཐོས་སོ།",
    "ཐོས་ནས་ཀྱང་འདི་སྐད་ཅེས་སྒོ་འཕར་ལ་མི་དྲག་པ་དལ་བུད་ལ་བུས་རྡེབས་པའི་འཕགས་པ་དེ་སུ་ཞིག།",
    "རྫེའུ་ན་སྲན་ཆོད་མཆིས་མོད་ཀྱི་ཁྱོད་ལ་བ་སྙེན་བཀུར་བགྱིད་པ་ནི་སླད་རོལ་དུ་མཆིས་ལགས་ཀྱིས།",
    "རྒྱལ་པོ་ཆེན་པོ་ངས་བྱང་གི་སྒྲ་མི་སྙན་མི་སྙན་གྱི་དུས་བྱིན་གྱིས་བརླབས་ནས་ཉིད་ཁོ་ནས་ཕྲུ་བའི་ནང་ནས་ཟན་དྲོན་དང་།",
    "དེ་ནས་ཕྱི་ཞིག་ནས་རྫ་མཁན་དགའ་སྐྱོང་འོངས་ནས་རྫ་མཁན་དགའ་སྐྱོང་གིས་ཕྲུ་བའི་ནང་ན་ཟད་དྲོན་དང་།",
    "རྫེའུ་ན་སྲན་ཚོད་མཆིས་པ་འདི་སུ་ཞིག་གིས་གསོ།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་འདིར་སྒོ་འཕར་ལ་རྡེབས་པའི་སྒྲ་ཞིག་ཐོས་སོ།",
    "རྫེའུ་ན་སྲན་ཚོད་མཆིས་མོད་ཀྱི་ཁྱོད་ལ་བསྙེན་བཀུར་བགྱིད་པ་ནི་སླད་རོལ་དུ་མཆིས་ལགས་ཀྱིས་གལ་ཏེ་བཞེད་ན་ཉིད་ཀྱིས་བཞེས་ཏེ་ཡོངས་སུ་ལོངས་སྤྱད་དུ་གསོལ་ཞེས་གསོལ་པ་དང་།",
    "དེའི་ཚེ་རྫ་མཁན་དགའ་སྐྱོང་དགོས་པ་འགའ་ཞིག་གི་ཕྱིར་ཕྱི་རོལ་དུ་སོང་བར་གྱུར་ཏོ།",
    "རྫ་མཁན་དགའ་སྐྱོང་གི་ཕ་མ་ལོང་བས་ལས་ཀྱི་ཁང་པ་ཐོག་འཆུ་བའི་སྒྲ་ཐོས་སོ།",
    "རྫ་མཁན་དགའ་སྐྱོང་གི་ལས་ཀྱི་ཁང་པ་རྩྭ་སར་པས་གཡོགས་པ་འཆུ་བའི་འཕགས་པ་དེ་སུ་ཞིག།",
    "དེ་ནས་ཕྱི་ནས་རྫ་མཁན་དགའ་སྐྱོང་འོངས་ནས་རྫ་མཁན་དགའ་སྐྱོང་གིས་ལས་ཀྱི་ཁང་པོ་གཡོགས་པའི་རྩྭ་སར་པ་བཤུས་པར་མཐོང་ངོ།",
    "ཡབ་ཡུམ་ལས་ཀྱི་ཁང་པ་གཡོགས་པའི་རྩྭ་སར་པ་འཆུ་བའི་པ་དེ་རྣམས་སུ་ཞིག་གིས་བཤུས་ལགས།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་འདིར་ལས་ཀྱི་ཁང་པ་གཡོགས་པའི་རྩྭ་སར་པ་འཆུ་བ་ཐོས་སོ།",
    "དེ་དག་གིས་འདི་སྐད་ཅེས།",
    "བཙུན་པ་རྫ་མཁན་དགའ་སྐྱོང་གིས་ནི་རྙེད་པ་ལེགས་པར་རྙེད་དེ།",
    "ཁྱོད་ཀྱིས་འབྲས་སོག་མའི་སྦུབས་སུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་ཁོང་ལ་རྫ་མཁན་དགའ་སྐྱོང་གདན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་རྫ་མཁན་དགའ་སྐྱོང་ལ་འདི་སྐད་ཅེས།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་ལ་རྒྱལ་པོ་ཀྲི་ཀཱིས་འབྲས་སོག་མའི་སྦུབས་སུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་པོ་བསྐུར་བ་འདི་དག་ཡིན་གྱིས།",
    "དེ་ལས་ཁྱོད་བདག་ཉིད་དང་ཁྱོད་ཉིད་ཀྱི་ཕ་མ་ཡང་དག་པའི་བདེ་བས་ཚིམ་པར་བྱ་བ་དང་།",
    "རྫ་ཁན་དགའ་སྐྱོང་གང་ན་བ་དེར་སོང་ནས་ཕྱིན་པ་དང་།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་ལ་རྒྱལ་པོ་ཀྲྀ་ཀཱིས་འབྲས་སོག་མའི་སྦུབས་སུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་པོ་བསྐུར་བ་འདི་དག་ཡིན་གྱིས།",
    "དེལས་ཁྱོད་བདག་ཉིད་དང་ཁྱོད་ཀྱི་ཕ་མ་དག་པའི་བདེ་བས་ཚིམ་པར་བྱ་བ་དང་།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཀྱིས་དགཀའ་བ་སྤྱད་པ་དོན་མེད་པར་ཐུགས་སུ་ཆུད་ནས་ཅི་བདེར་དབུགས་འབྱིན་པ་དང་།",
    "མར་དང་ཏིལ་མར་གྱིས་སྐུ་བྱུགས་ནས་ཆུ་འཇམ་པོས་སྐུ་འཁྲུ་བར་མཛད་པ་དེའི་ཚེ་བཙུན་མོ་ཡང་ཅི་བདེར་དབུགས་འབྱིན་པ་དང་།",
    "ཇི་མངོན་ཁྱོད་ཡིད་ཆེས་པར་བྱའོ།",
    "ཉི་མ་གཅིག་ནི་བཙུན་མོའི་ནང་དུ་གསོལ་བ་དེའི་ཚེ་གྲགས་འཛིན་མ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བུ་ཁྱོད་ཀྱི་ཡབ་གང་ཡིན་པ་དེ་ལ་ཕུལ་ཅིག།",
    "མི་གཟིགས་པ་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་བཙུན་མོའི་བུད་མེད་དང་ཤཱཀྱ་རྣམས་དང་བཅས་པ་ངོ་མཚར་སྐྱེས་ནས།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་ཐོས་ནས་དེ་བཅོམ་ལྡན་འདས་ཀྱིས་དྲུང་དུ་སོང་སྟེ་པྱིན་ནས།",
    "དེང་གི་གདུགས་གཅིག་ལ་མཆིས་སུ་གསོལ་ཅིག་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྒྲ་ཅན་ཟིན་གྱི་སྐྱེ་བོའི་དུས་སྟོན་ཆེན་པོ་བྱས་སོ།",
    "བཟང་མོ་བདག་ཅག་གིས་བུ་ལོན་དེད་པ་དང་ནོར་འཕྲོག་པ་སྐྱེས་ཀྱིས་ཟོང་ཐོགས་ཏེ་རྒྱ་མཚོ་ཆེན་པོར་འཇུག་ཏུ་འགྲོའོ།",
    "དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བཞིག་ན་ཐག་པ་རང་གི་བཟོ་ལ་མཁས་པ་ཞིག་གནས་ཏེ།",
    "དེ་རང་གི་བཟོས་ཐམས་ཅད་གྲུབ་པར་འགྱུར་རོ།",
    "དེས་དེའི་རང་གི་བཟོས་འབྱོར་པ་འགྲུབ་པ་མཐོང་ནས་སྨྲས་པ།",
    "དེར་སོང་ན་ཚུལ་མ་ཡིན་པས་སྡུག་བསྔལ་བར་འགྱུར་རོ།",
    "རུང་གིས་དེ་བཞིན་དུ་བྱའོ་ཞེས་དེས་དེ་ལ་བསླབ་པར་བརྩམས་པ་ན་དེ་སྒྲིན་པོ་གཡེར་བག་ཅན་ཞིག་པས་དེས་དུས་ཐུང་དུ་ཞིག་གིས་ཐག་པའི་ལས་རྣམས་ལོབས་སོ།",
    "ཞང་པོ་ཁྱོད་ཀྱང་ལས་འདི་ཁོན་བྱེད་ལ་བདག་ཅག་ཀྱང་འདི་ཁོ་ན་བྱེད་པ་ལས་ཅིའི་ཕྱིར་ཁྱོད་ནི་བཟང་པོས་འཁྲུ།",
    "ནུབ་མོ་ནི་རྐུན་པོ་བྱེད་དོ།",
    "ཚ་བོ་ཁྱོད་ཀྱིས་རྐུན་པོ་བྱེད་མི་ནུས་སོ།",
    "རེ་ཞིག་འདི་བ་གམ་པར་བྱའོ་སྙམ་ནས་དེ་ཁྲིད་དེ་ཚོད་འདུས་སུ་སོང་ནས་དེས་དེར་རི་བོང་ཞིང་ཉོས་ཏེ་དེ་ལ་གཏད་ནས་ཚ་བ་བོ་རེ་ཞིག་སྲེགས་ཤིག་དང་།",
    "ཚ་བོ་རི་བོང་འདིའི་གཟུགས་བཞི་པ་ཤོས་གར་སོང་།",
    "རེ་ཞིག་བདག་ཀྱང་རྐུན་མ་ཡིན་ན།",
    "དེས་དེ་དང་རི་བོང་གཟུགས་གསུམ་པོ་ཁྱེར་ཏེ་ཆད་འཚོང་གི་ཁྱིམ་ཞིག་ཏུ་ཞུགས་ནས་ཚ་བོ་ཆང་བཏུང་ངམ།",
    "བདག་གིས་ནི་མ་འཐུངས་པས་གྱ་གྱུ་བྱར་ཅི་ཡོད།",
    "ཞང་པོ་ཁྱོད་རྐུན་མ་བྱེད་ཀྱང་ཐབས་མི་ཤེས་ཏེ།",
    "དེ་ནི་གཅིག་པུ་ཡིན་པས་སླར་འདྲེན་མ་ནུས་ནས་མགོ་བཅད་དེ་ཁྱེད་ཏེ་སོང་ངོ།",
    "དེའི་མགོ་གཅིག་གིས་བཀུམ་ནས་འཚལ་ཏེ་མཆིས་སོ།",
    "ཤེས་ལྡན་དག་མགོ་བཅད་དེ་ཁྱེར་ཏེ་སོང་བ་གང་ཡིན་པ་དེ་ནི་རྐུན་ཆེན་ཡིན་ནོ།",
    "བདག་གིས་ཞས་པོའི་མགུལ་ནས་འཇུས་ཏེ་དུང་མོས་མི་གདབ་པ་ལྟ་མི་སྲིད་དོ་སྙམ་ནས།",
    "དེས་བདག་ཉིད་སྨྱོན་པའི་བྱད་དུ་ཞུགས་ནས་བུད་མེད་ཀྱི་མགུལ་ནས་ཀྱང་འཇུས།",
    "ཁྱིའི་མགུལ་ནས་ཀྱང་འཇུ་བར་བརྩམས་ནས་གང་གི་ཚོ་འཇིག་རྟེན་གྱིས་སྨྱོས་པར་ཤེས་པ་དེའི་ཚེ་རོ་མགོ་རྡུམ་པང་དུ་བླངས་ཏེ་ཇི་ཙམ་འདོད་ཀྱི་བར་དུ་དུས་ནས་སོང་ངོ།",
    "སྨྱོན་པ་ཞིག་གིས་རོ་མགོ་རྡུམ་དེ་པངདུ་བླངས་ཏེ་ཇི་ཙམ་འཚལ་གྱི་བར་དུ་དུས་ནས་མཆིས་སོ།",
    "བདག་གིས་ཞང་པོ་ལ་བསྐུར་སྟི་མི་སྲིན་དོ་སྙམ་ནས་དེས་ཤིང་རྟ་པའི་ཆ་བྱད་དུ་བྱས་ནས་ཤིང་རྟ་ཤིག་སྐམ་གྱིས་བཀང་སྟེ།",
    "ཕྱོགས་དེར་འོངས་ནས་དེའི་སྟེང་དུ་ཤིང་རྟ་ཤིང་སྐམ་གྱིས་བཀང་བ་བཞག་སྟེ་གླང་བཀྲོལ་ནས་ཤིང་རྟ་མེས་བཏང་སྟེ་སོང་བ་དང་།",
    "སུས་དེ་དག་གིས་ཇི་ལྟར་གྱུར་པ་རྣམས་སྨྲས་པ་དང་རྒྱལ་པོས་སྨྲས་པ།",
    "བདག་གིས་ཞག་པོ་ལ་དྲུ་ཁྲོད་དུ་མཚུན་གྱི་བྱ་བ་མ་བྱས་པ་ནི་མ་སྲིད་དོ་སྙམ་ནས།",
    "དེས་བྲམ་ཟེའི་ཆ་བྱད་དུ་བྱས་ནས་ཁྱིམ་ནས་ཁ་སློང་ཞིང་བརྒྱུས་ཏེ་བསླངས་པ་དེ་ལས་དེའི་ཕངས་ཤ་ལྔ་བྱས་ནས་དུར་ཁྱོད་དུ་བཞག་སྟེ་སོང་ངོ།",
    "ལྷ་བྲམ་ཟེ་ཞིག་གིས་ཁྱིམ་ནས་སློང་ཞིང་བརྒྱུས་ཏེ་ཕྱོགས་གང་དུ་རོ་མགོ་རྡུམ་བསྲེགས་པ་དེར་དེས་ཕངས་ཤ་ལྔ་བགྱིས་སྟེ་བཞག་སྟེ་མཆིས་ལགས་སོ།",
    "བདག་གིས་ཞང་པོའི་རུས་པ་རྣམས་གང་གཱར་མི་འདོར་བ་ལྟ་མི་སྲིད་དོ་སྙམ་ནས།",
    "དེས་ཐོད་པ་ཅན་གྱི་ཆ་བྱད་དུ་བྱས་ཏེ་ཕྱོགས་དེར་སོང་ནས་དེས་དེར་ལུས་ཐལ་བས་བྱུགས་ཤིང་རུས་པ་དང་ཐལ་བས་ཐོད་པ་བཀང་ནས་གང་གཱར་ཕོ་སྟེ་སོང་ངོ།",
    "ངས་དེ་གཟུང་ངོ་ཞེས་རྒྱལ་པོས་གང་གཱའི་གྲུའི་ནང་དུ་སྐྱེད་མོས་ཚལ་བྱེད་དུ་བཅུག་སྟེ།",
    "འགྲམ་གཉིས་སུ་སྲུང་མའི་མི་དག་བཀོད་ནས་རྒྱལ་པོའི་བུ་མོ་གཟུགས་བཟང་བ།",
    "བལྟ་ན་སྡུག་པ་ཞིག་ཆུའི་སྐྱེད་མོས་ཚལ་དེར་བཞག་སྟེ་བསྒོ་བ།",
    "གལ་ཏེ་ཁྱོད་ལ་འགའ་ཞིག་གིས་བཟུང་དང་སྐད་ཕྱུང་ཤིག།",
    "ངག་གི་ཚེ་སྐང་འབྱིན་པ་དེའི་ཚེ་ཁྱེད་ཅག་ཆུའི་སྐྱེད་མོས་ཚལདུ་དེང་ཤིག།",
    "རྐུན་པོ་ཅིག་ཤོས་ཀྱིས་བསམས་པ་བདག་གིས་རྒྱལ་པོའི་བུ་མོ་དང་ལྷན་ཅིག་དགའ་མགུར་མ་སྤྱད་དུ་མི་གཏོང་ངོ་སྙམ་ནས་དེ་གང་གཱའི་འབབ་ཕྱོགས་ཞིག་ཏུ་འདུག་སྟེ།",
    "གཅིག་བསྐུར་བ་དང་སྲུང་མའི་མི་རྣམས་ཀྱིས་རྐུན་པོའི་སྙམ་ནས་བསྙགས་ཏེ་དེ་དག་གིས་དེ་ལཐལ་མོ་གཅིག་བསྣུན་ནས་བཅག་གོ།",
    "དེ་ནས་རྐུན་པོ་ཅིག་ཤོས་པོ་དེས་རྫེའུ་ཞིག་གི་ནག་དུ་མགོ་བཅུག་ནས་རྒྱུན་ཕྱོགས་སུ་བརྐྱལ་ཏེ།",
    "ཕྱོགས་དེར་ཕྱིན་པ་དང་དེ་ནས་གྲུ་ལ་འཛེགས་ནས་བུ་མོ་ལ་སྨྲས་པ།",
    "ཁྱོད་བས་ད་རེ་སྒྲ་མ་འབྱིན་ཅིག།",
    "དེ་དེ་དང་ལྷན་ཅིག་དགའ་མགུར་སྤྱད་ནས་སོང་ངོ།",
    "ཤེས་ལྡན་དག་རྐུན་པོ་ཅིག་ཤོས་ཀྱིས་ཁོ་མོ་ལ་དག་མགུར་སྤྱད་ནས་སོང་ངོ།",
    "ངག་གི་ཚེ་དགའ་མགུར་སྤྱད་པ་དེའི་ཚེ་ཅང་མི་སྨྲ་བར་འདུག་ལ།",
    "གང་གི་ཚེ་དགའ་མགུར་སྤྱད་ནས་སོང་བདེའི་ཚེ་དུས་ན་ད་གང་དུ་བཙལ་བར་བྱ།",
    "བདག་གི་བུ་བཙས་པའི་དགའ་སྟོན་མ་བྱས་པར་མི་བཏང་ངོ་སྙམ་ནས།",
    "དེ་ནས་རྒྱལ་པོས་ཁྱེའུ་དེ་ལ་མེ་ཏོག་གི་ཕྲེག་བ་ཞིག་བྱིན་ནས་བསྒོ་བ།",
    "ཁྱོད་ཀྱི་ཕ་གང་ཡིན་པ་དེ་ལ་བྱིན་ཅིག།",
    "དེ་ནས་ཁྱེའུ་དེ་མེ་ཏོག་གི་ཕྲེག་བ་དེ་ཁྱེད་ནས་སྐྱེ་བོའི་ཚོགས་ལ་རྟོག་ཅིང་རྒྱུ་བ་ན་དེས་རྐུན་པོ་ཅིག་ཤོས་པོ་དེ་མཐོང་ངོ།",
    "འདི་ལ་སྤྱན་རས་ཀྱིས་བཙའ་བར་བྱའོ་ཞེས་དེས་བུ་མོ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ནས་དེ་ལ་ཆུང་མར་བྱིན་ཏེ།",
