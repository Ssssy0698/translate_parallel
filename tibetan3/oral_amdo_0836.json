    "ཞེས་མཁྱེན་པ་དང་གཟིགས་པ་འཇུག་གོ།",
    "བདུད་རྩི་ཟས་ཀྱིས་གཞོན་ནུ་ཀུན་དགའ་བོ་ཁང་ཕྲན་གཞན་ཞིག་གི་ནང་དུ་བཅུག་སྟེ་བཞག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་གི་ཚེ་ན་སྒོ་རང་བྱེ་བར་འགྱུར་བ་དེ་ལྟར་བྱིན་གྱིས་བརླབས་ནས་ཐོག་མ་ཁོ་ནར་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་བསིལ་ཡབ་བླངས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་སྣ་མ་ལོགས་ནས་བཅོམ་ལྡན་འདས་ལ་གཡོབ་ཅིང་འདུག་གོ།",
    "རང་གི་སྐྱེ་བོ་དང་གཉེན་གྱི་ཚོགས་རྣམས་ལ་ཡང་བཟོད་པ་གསོལ་དུ་བཅུག་ནས་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ཏེ།",
    "དེ་ཡང་སྲང་གི་དབུས་ནས་འགྲོ་བ་ན་གླང་པོ་ཆེས་ཨུཏྤ་ལའི་ཆུན་པོ་ཞིག་ཟོས་སོ།",
    "དེ་ཇི་ཙམ་བཞོན་པའི་སའི་བར་དུ་བཞོན་པས་སོང་ནས་བ་ཞོན་པ་ལས་བབས་ཏེ་རྐང་པ་ཁོ་ནས་ནྱ་གྲོ་དྷའི་ཀུན་དགའ་ར་བར་ཞུགས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་འཔགས་པ་ཀུན་དགའ་བོ་འདི་ཉིད་ན་མཆིས་བཞིན་དུ་ཕོལ་མིག་སྨིན་པར་བགྱིས་ཏེ་བརྟོལ་ནས་སོས་པར་བགྱིས་ལགས་སོ།",
    "གལ་ཏེ་བདག་གི་ལུས་ཏིལ་འཕྲུ་ཙམ་དུ་གཏུབས་པར་གྱུར་ཀྱང་བདག་གིས་མི་ཚོར་ལགས་སོ།",
    "དེ་དེ་ལ་མི་བཟོད་པ་སྐྱེས་ཏེ་སེམས་གདུག་པས་འཇིམ་རིལ་གྱི་ངན་ཀོང་གིས་རྒྱབ་ཏུ་བསྣུན་པ་ལས་བདག་ཉིད་ཆེན་པོ་དེ་དྲེགས་པ་དང་ང་རྒྱལ་བཅོམ་པ་ཡིན་པས་དེ་སྣོད་དུ་མ་གྱུར་པས་ཤེས་ནས་སོང་ངོ།",
    "གང་གི་ཚེ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བཅོམ་ལྡན་འདས་དང་ཐབས་ཅིག་འགྲོ་བ་དེའི་ཚེ་བཅོམ་ལྡན་འདས་ལ་ལྷག་པར་དད་པ་དང་།",
    "གང་གི་ཚེ་སྤྲུལ་པ་ཡིན་ན་ནི་དད་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ཅི་དེ་རིང་ཁྱོད་བཅོམ་ལྡན་འདས་དང་ཐབས་ཅིག་སོང་ངམ།",
    "ཅི་མངོན་གང་གི་ཚེ་ཁོ་བོ་བཅོམ་ལྡན་འདས་དང་ཐབས་ཅིག་འགྲོ་བ་དེའི་ཚེ་བདག་བཅོམ་ལྡན་འདས་ལ་ལྷག་པར་དད་པ་དང་།",
    "ཞེ་ཐོས་པ་གང་ཡིན་པ་དེ་ནི་འདི་ཡིན་གྱིས་རེ་ཞིག་ཤིང་ཤ་པ་ཞེས་བྱ་བ་འདི་ལ་འདབ་མ་དུ་ཡོད་པ་དྲིའོ་སྙམ་ནས་དེས་དེ་ལ་དྲིས་པ།",
    "ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་ལ་ཡང་ཉི་མ་རེ་རེ་ཞིག་དྲོ་ཀའི་དུས་སུ་གཞོར་པར་འབྲས་སཱ་ལུའི་ཆན་དང་།",
    "བུ་རམ་ཤིང་གི་སྡོང་བི་ཞིག་དང་།",
    "བུ་རམ་ཤིང་གི་སྡོང་བུ་ཞིག་དང་།",
    "བུ་རམ་ཤིང་གི་སྡོང་བབུ་དང་།",
    "བུ་རམ་ཤིང་གི་སྡོང་བུ་ཞིག་ཁྱེད་ཏེ་འོངས་ཏེ།",
    "བུ་རམ་ཤིང་གི་སྡོང་བུ་ཞིག་དང་།",
    "བུ་རམ་ཤིང་གི་སྡོང་བུ་དང་།",
    "བུ་རམ་ཤིང་གི་སྡོང་བུ་དང་།",
    "༩༧༨༩༣༨༣༩༡༦༥བོད་ཀྱི་དཔའ་བོ་དཔའ་མོ་རྣམས་ཀྱི་ཆེད་དུའོ།",
    "རི་མོའི་རྣམ་པ་ཅན་གྱི་མཚོན་བྱེད་བརྡ་ཡིག་སྣ་ཚོགས་འབྲི་ནུས་པའི་མི་སྣ་རིམ་གྱིས་བྱུང་བ་ནས་བཟུང་།",
    "རང་གི་ལས་འགན་གང་ཡིན་སྒྲུབ་ཐུབ་པའི་བློ་སྟོབས་དང་ལྷག་བསམ་ཡང་ཡོད་དགོས།",
    "སྐྱོན་ཆ་ལ་ཐེར་འདོན་བྱེད་པའི་སྤོབས་པ་ཡང་ཡོད་དགོས་པ་ནི་དུས་རབས་ཀྱིས་ང་ཚོར་སྤྲད་པའི་འགན་འཁྲི་ཞིག་ཡིན།",
    "ངོ་མཚར་བླ་ན་མེད་པ་ཞིག་ཏུ་བཀུར་ཏེ་མང་ཚོགས་ལ་བཤ་གཞོག་གཏོང་བ།",
    "ཆེ་གེ་མོ་ཞིག་གི་ཡང་སྲིད་ཀྱི་མིང་ཡོད་ན།",
    "དད་ལྡན་མང་ཚོགས་ཀྱི་འབུལ་དངོས་རྣམས་ཆང་ཁང་དང་གཞང་ཁང་།",
    "རྒྱན་སྐུགས་ཁང་སོགས་ན་ཕངས་མེད་དུ་སྟོར་བའི་མི་འུ་ཙམ་པོ་པ་དེ་དག་ལ་ཡང་དད་པ་བརླག་མི་ཆོག་པའི་འཇིགས་སྐུལ་བླ་འདར་བ་རེ་བྱེད་པ་འདིས།",
    "རང་རེ་གངས་ཅན་པ་རྣམས་ད་དུང་རྨོངས་འཐོམ་དུ་ལྷགས་པར།",
    "ཡིན་ན་ཡང་དུས་ཀྱི་སྟོན་པ་ཆེན་པོ་ལྷ་མོ་དོན་གྲུབ་དང་མགོན་པོ་ཚེ་བརྟན་སོགས་ཀྱི་ཐུགས་བསྐྱེད་གཡར་དམ་དུས་སུ་སྨིན་པའི་བཀའ་དྲིན་ལས།",
    "བསྟན་པ་དང་འགྲོ་བའི་དོན་འབའ་ཞིག་ཐུགས་ལ་བརྣག་པའི་ལྷ་མོ་དོན་གྲུབ་མཆོག་ནི།",
    "ཁྱོད་ནི་འགྲོ་བའི་དོན་གྱི་སླད།",
    "ཡིན་ན་ཡང་ལྷ་མོ་དོན་གྲུབ་ཀྱིས་ཀླད་པ་ལྗང་ཁུ་ལྗང་རྐྱང་ཡིན་ན་སྐྱོན་ཡོད་པར་མ་ཟད།",
    "དུས་རབས་བདུན་པའི་ནང་རང་རེའི་བོད་ཁ་བ་གངས་ཅན་དུ་ཡང་དངོས་སུ་དར་ཁྱབ་བྱུང་སྟེ།",
    "བུའི་གླིང་བ་སྤྱི་དང་ལྷག་པར་ཁ་བ་གངས་ཅན་པ་རྣམས་ཀྱིས་གཞར་ཡང་བཀའ་དྲིན་བསབ་ཏུ་མེད་པའི་ཞི་བདེའི་སྟོན་པ་ཆེན་པོ་གང་གི་གསུང་ལ་བག་ཆགས་ཨེན་ཙམ་རེ་འཇོག་མཁན་ཞིག་བྱུང་ན་ཅི་མ་རུང་སྙམ་པ་དང་།",
    "ཁོང་གི་གསུང་རྣམས་བསྐལ་བའི་མཐར་ཡང་མི་ནུབ་པར་འཕྲིན་ལས་ཀྱི་སྣང་བ་དཀར་པོས་ཀུན་ལ་ཁྱབ་ཐུབ་པ་ཞིག་བྱུང་ན་སྙམ་པ་སོགས།",
    "རབ་ཡངས་མཁའ་ལ་འཇའ་ཚོན་ལྟར་བཀྲ་བའི་རྣམ་བྱང་གི་ཀུན་རྟོག་སྣ་ཚོགས་པ་ཞིག་གིས་ཀུན་ནས་བསླངས་ཏེ།",
    "རང་ངོས་ནས་ཐེངས་དུ་མར་ཡང་དང་བསྐྱར་དུ་ནན་ཏར་གྱིས་གཞུང་ཆེན་མོའི་ལུགས་དང་བསྟུན་གང་ཐུབ་བྱས་པ་ལས་གཞན།",
    "དེས་ན་ལས་དོན་འདིའི་ནང་ནོར་ཞིང་འཁྲུལ་བའི་ཆ་ཅི་ཡོད་ལ་ལག་ཟུང་ཐལ་མོ་སྦྱར་བཞིན་མཛད་པས།",
    "རྩོམ་སྒྲིག་སྐབས་གསུང་གི་ཚིག་རིས་མཚུངས་པ་རྣམས་ཕྲིས།",
    "སྤྱིར་རང་ཅག་ཁ་བ་རི་བའི་འདྲེན་པ་ཆེན་པོ་ལྷ་མོ་དོན་གྲུབ་ཀྱི་སྐུ་ཚེ་བསྐལ་བརྒྱར་བརྟན་ཅིང་།",
    "ཕ་ཡུལ་གངས་ལྗོངས་ན་ཉིན་མཚན་རེ་བས་བལྟས་པའི་ཕ་མ་གཉིས་ཀྱི་བཀའ་དྲིན་ཅུང་ཙམ་བསབ་ཐུབ་པ།",
    "སྒོས་སུ་བོད་ཁ་བ་གངས་ཅན་པའི་ཆེད་དུ་རང་སྲོག་འབེན་ལ་བཙུགས་པའི་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་རྣམས་དང་།",
    "ལྷག་པར་འུ་ཅག་བོད་པ་ཚང་གི་ཆེད་དུ་རང་ལུས་མཆོད་མེར་སྦར་བའི་དཔའ་བོ་དཔའ་མོ་དེ་དག་གི་དགེ་རྩར་བསྔོ་བ་ཡིན་པས།",
    "བདག་གིས་སྦྱིན་ཚོགས་བགྱིས་པའི་ཚོགས་རྣམས་ཀྱིས།",
    "གང་གི་ཐུགས་བརྩེས་ཉེར་བཟུང་ནས།"
  ]
}