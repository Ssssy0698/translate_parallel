    "དེ་ཡང་ལེའུ་དང་པོ་ལ་ཕྱི་ནང་གི་ཡུལ་ཉེར་བཞི་དང་།",
    "སྲིད་པ་སུམ་ཅུ་རྩ་གཅིག་གི་དང་།",
    "ཤིན་ཏུ་ཕྲ་བའི་དབུགས་སོགས་ཀྱིས་ཉིན་མོའི་ཚད་ལ་སོགས་པའི་དང་།",
    "འཁོར་ལོས་སྒྱུར་བ་ཆེན་པོ་ལ་སོགས་པ་རིགས་ལྡན་གྱི་མཐར་ཐུག་པའི་མི་རྣམས་ཀྱི་མཆོག་གི་ཚེའི་ངོ་བོ་ཉིད་ཀྱིས་གནས་པ་སྟེ་ཉི་ཤུ་རྩ་བཞིའོ།",
    "བརྗོད་བྱ་དེ་དག་རྗོད་བྱེད་ཚིག་གི་ངོ་བོ་ཉིད་ཀྱི་སྐབས་དེ་དག་ཏུ་གནས་པའམ།",
    "ཡང་ན་བརྗོད་བྱ་དེ་དག་གི་ངོ་བོ་ཉིད་ཀྱི་སྐབས་དེ་དག་ཡིན་པས་བྱེད་འགྲེལ་གྱི་སྒྲ་ཇི་ལྟར་བྱས་ཀྱང་རུང་ངོ།",
    "གནས་པ་ཞེས་པའི་དོན་ནི་བརྗོད་བྱ་དེ་དང་དེ་དག་གི་ངོ་བོ་ཉིད་དམ་དོན་དེ་ཉིད་སྐབས་དེར་གནས་པ་ཡིན་པའི་ཆ་ནས་གནས་པ་ཞེས་བྱའོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཡེ་ཤེས་སྐུ་དང་ཉིན་མོར་བྱེད་པའི་སྐུ་སྟེ་པདྨའི་འདབ་མ་རྒྱས་པའི་སྤྱན།",
    "མི་ཤེས་པའི་མུན་པ་ཐམས་ཅད་འཇོམས་པ་ཉིན་མོར་བྱེད་པའི་སྐུ་ཉིད་ཀྱང་སྟེ།",
    "འགྲོ་བའི་དོན་ལ་ཡེ་ཤེས་ཀྱི་གཟིགས་པ་འཇུག་པའི་སྤྲུལ་པའི་སྐུ།",
    "ཐམས་ཅད་མཁྱེན་པ་གང་ཡིན་པ་ཡེ་ཤེས་ཀྱི་སྐུ་མ་ཡིན་ནམ་ཞེ་ན་ཡིན་མོད་ཀྱང་།",
    "ཡེ་ཤེས་ཀྱི་སྐུ་གང་ཡིན་པ་མི་ཤེས་པའི་མུན་པ་འཇོམས་པ་ཉིན་མོར་བྱེད་པའི་སྐུ་མ་ཡིན་ནམ།",
    "རང་གི་ངོ་བོ་ལ་མཚན་མའི་དབྱེ་བ་མེད་མོད།",
    "ཡང་འགའ་ཞིག་གིས་རྒྱུད་ཀྱི་བརྗོད་བྱ་ཡེ་ཤེས་ཀྱི་སྐུ་དེ་ནི་རྡུལ་ཕྲ་རབ་འདུས་པའི་གཟུགས་ཅན་མ་ཡིན་ལ།",
    "པདྨའི་འདབ་མ་དེ་དག་གི་མཐའ་ཇི་སྲིད་པར་བཅོམ་ལྡན་འདས་གང་གི་ཡེ་ཤེས་ཀྱི་གཟིགས་པའི་སྤྱན་བརྒྱ་རྒྱས་པ་དེ་ནི་པདྨའི་འདབ་མ་རྒྱས་པའི་སྤྱན་ཞེས་གསུངས་ཏེ།",
    "རྒྱུད་གཞན་དག་ཏུ་བདག་གིས་བརྗོད།",
    "བརྟེན་པ་དག་ཀྱང་བདག་གིས་བརྗོད།",
    "ཟླ་བཟང་ཁྱོད་ཀྱིས་གསོལ་བཏབ་པ།",
    "རྒྱུད་རྣམས་སུ་འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་སོགས་ཀྱིས་གླེང་གཞི་བསྟན་ཅིང་།",
    "དེ་ཡང་འདི་སྐད་ཅེས་པའི་ཚིག་ཨེ་ཝྃ་ཐབས་ཤེས་ཀྱི་ཡི་གེ་ཐོག་མར་སྨྲོས་པས་ཐབས་ཤེས་ཟུང་འཇུག་གི་རྣལ་འབྱོར་མཚོན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་ལ་བཞུགས་ཞེས་སོགས་ཀྱིས་ཀྱང་དེ་བཞིན་དུ་སྟོན་པ་ཡིན་ན།",
    "དེའི་ཕྱིར་ལེགས་སྦྱར་གྱི་སྐད་དུ་གསུངས་པ་ཕལ་མོ་ཆེ་ལ་འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་སྦྱར་ཡོད་པ་བདེན་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་ཅིག་ན།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་རྣམས་ལ་བཞུགས་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་གསུངས་སོ།",
    "མངོན་བརྗོད་འབུམ་པ་ལ་རྡོ་རྗེ་ཕག་མོས་གསོལ་བ་བཏབ་པ་སོགས་སྣ་ཚོགས་སུ་གནས་ཤིང་དུས་ཀྱི་འཁོར་ལོའི་རྒྱུད་འདིར་ནི་གསོལ་བ་འདེབས་པ་པོ་རྒྱལ་པོ་ཟླ་བ་བཟང་པོའོ།",
    "པུས་མོ་གཉིས་ནི་སར་བཙུགས་ཤིང་།",
    "དེ་ནས་པུས་མོ་གཡས་པ་ཡི།",
    "དཔྲལ་བར་ཐལ་མོ་སྦྱར་བྱས་ཏེ།",
    "དེའི་ཕྱིར་འདི་སྐད་བདག་གིས་ཐོས་ཞེས་པའི་ཚིག་འདི་འབའ་ཞིག་གིས་རྒྱུད་ཐམས་ཅད་ཀྱི་གནས་ངེས་པར་སྟོན་དགོས་པར་འདོད་པ་ནི་ཉི་ཚེ་བའི་བློ་གྲོས་རྒྱ་ཆུང་བར་གྱུར་པ་སྟེ།",
    "རིག་བྱེད་བཞི་བྲམ་ཟེ་དང་རྒྱལ་རིགས་དག་གིས་བཀླག་པར་བྱའི།",
    "དེ་ཡང་དེ་དག་གིས།",
    "རེ་ཤིག་ཡུལ་གྱི་ཁྱད་པར་གཞན་དང་གཞན་མང་པོ་ལྟ་ཞོག་གི།",
    "རྒྱ་ནག་ཏུ་རྒྱ་ནག་གི་སྐད་ཀྱིས་སོ།",
    "ཡོན་ཏན་མེད་པ་རང་གི་འདོད་པའི་ལྷར་བཟུང་སྟེ་དེ་ལའང་གུས་པ་གང་།",
    "བྲམ་ཟེ་མཁས་པས་བདག་གི་དགའ་བ་དང་མི་དགས།",
    "མ་ཡིན་ན་ཡང་སྲིན་མོའི་རིགས་ཀྱིས་འཇིག་རྟེན་ན།",
    "རང་གི་བུ་ལ་བཟའ་བར་སེམས།",
    "དག་གིས་ནི་ཅི་ཞིག་བྱ།",
    "དེ་ཡང་དཔེར་ན་བུད་མེད་དང་མི་མོ་དང་ན་ཆུང་མ་ཞེས་པའི་མིང་དེ་དག་སྐྲ་དང་ནུ་མར་ལྡན་པའི་བུད་མེད་ཀྱི་དངོས་པོ་གོ་བར་བྱེད་པ་ལ་མཚུངས་བཞིན་དུ་བུད་མེད་གཅིག་པུ་དེ་བརྗོད་པའི་གཙོ་བོའི་མིང་ཡིན་མི་དགོས་པ་བཞིན་ནོ།",
    "དེ་ལྟར་ལྷ་རྣམས་ལྷའི་སྐད་ཀྱིས་ཡོངས་སུ་སྨིན་པའི་དོན་དུ་འདུས་པ་ལ་སོགས་པའི་རྒྱུད་ཀྱི་དང་པོར་ཨེ་ཝཾ་གྱི་ཡི་གེ་ཉིད་བཅོམ་ལྡན་འདས་ཀྱིས་ངེས་པའི་ཚིག་གི་ཚུལ་གྱིས་བསྟན་ཅིང་།",
    "གསང་བའི་པདྨ་ནི་རྟེན་གནས་ཀྱི་ཕྱིར་བདུན་པའི་གཅིག་ཚིག་གི་མཐའ་ཅན་དེ།",
    "རིགས་ལྔ་དང་རང་བཞིན་གྱི་རིགས་གཅིག་དང་བཅས་པས་རིགས་དྲུག་གི་བདག་ཉིད་བརྗོད་བྱར་འགྱུར་རོ།",
    "གདོང་ལྔ་ཟུར་ཕུད་ལྔ་དང་ལྡན་སོགས་ཚིགས་བཅད་གཅིག་གིས་སོ།",
    "དེ་བཞིན་དུ་ཕུང་ཁམས་ཀྱི་དབྱེ་བས་རིགས་དྲུག་གི་བདག་ཉིད་ནི།",
    "གསང་སྔགས་དོན་ཀུན་སྐྱེད་པ་པོ་སོགས་ཚིགས་བཅད་གཅིག་གིས་སོ།",
    "དེ་དག་གི་ཡུམ་རྡོར་དབྱིངས་མ་ནས་གཏུམ་མོ་རྣམས་ཀྱི་བར་ཏེ་དེ་ལྟར་ལྷ་དང་ལྷ་མོའི་ཚོགས་དཀྱིལ་འཁོར་གྱི་འདུས་པ་རྣམས་ཀྱིས་གཙོ་བོ་གང་གི་ཞབས་ཀྱི་པདྨ་ལ་རབ་ཏུ་བཏུད་པར་གྱུར་པ་ཁམས་གསུམ་པོས་ཞབས་ཀྱི་པདྨ་ལ་ཕྱག་བྱས་པ།",
    "དཔེར་ན་སྒྱུ་མའི་སྐྱེས་བུ་ཆེན་པོ་འགའ་ཞིག་གིས་སྒྱུ་མའི་གཟུགས་དུ་མ་སྤྲུལ་ཏེ་སྤྲུལ་པའི་གཟུགས་དེ་དག་གིས་ཤིང་རྣམས་རྩ་བ་ནས་འབྱིན་པར་བྱེད་ཅིང་རིའི་རྩེ་མོ་ཡང་སྐྱོད་པར་བྱེད་ལ།",
    "ལྷ་ཆེན་པོ་དང་ཁྱབ་འཇུག་གི་གཟུགས་ལྟ་བུས་ལྷས་སྦྱིན་ལ་སོགས་པ་འཆིང་བར་བྱེད་པ་བསྟན་ན་སྒྱུ་མའི་སྐྱེས་བུ་ཆེན་པོ་དེ་དུ་མ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "ཀ་ལཱ་པའི་གྲོང་དུ་ཡབ་ཉི་མའི་འོད་ཀྱི་ལྷ་མོ་རྣམ་པར་རྒྱལ་མའི་མངལ་ནས་འཁྲུངས་པ་ཟླ་བ་བཟང་པོའོ།",
    "གསང་བའི་སྒྲས་གནོད་སྦྱིན་རྣམས་བརྗོད་ལ་དེ་དག་གི་བདག་པོར་གྱུར་པ་སྟེ།",
    "བདུད་དང་ཉོན་མོངས་ཤེས་བྱ་སྙོམས་འཇུག་གི་སྒྲིབ་པའི་གནོད་སྦྱིན་རྣམས་གསོད་པར་བྱེད་པ་གནོད་སྦྱིན་གྱི་བདག་པོ་ཞེས་བྱའོ།",
    "ཟབ་མོ་སྔགས་ཀྱི་ཚུལ་འདི་ལས་བདེན་པ་གཉིས་བསྟན་ཏེ་གང་འཇིག་རྟེན་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ནི།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱི་རང་གི་སེམས་ཉིད་འོད་གསལ་གྱི་རང་མདངས་མངོན་སུམ་དུ་ནམ་མཁའ་ལ་སྣང་བ་འགྱུར་མེད་བདེ་བའི་ཡེ་ཤེས་ཀྱི་སེམས་གང་ཞིག།",
    "དེ་དགོས་པ་གང་གི་ཕྱིར་ཞེ་ན།",
    "ལྷ་མོ་རྣམས་ཀྱི་སྡོམ་པ་ཡང་ཡེ་ཤེས་ཀྱི་སྐུ་འདི་དང་ལྷན་ཅིག་རོ་མཉམ་པ་ཉིད་དོ།",
    "རང་གི་སེམས་ཀྱིས་མ་བརྟག་པའི་རྣམ་པ་མངོན་སུམ་མཐོང་བ།",
    "དེའི་ཕྱིར་རང་བཞིན་མེད་པའི་ཕྱོགས་ནི་མཐར་གཉིས་གང་གི་ཡང་ཕྱོགས་མེད་པར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "རྨོངས་དང་རྨོངས་མིན་ཞེས་པ་དེ་ལྟ་བུ་ལ་སོགས་པ་རྣམས་ནི་ཕྱོགས་རེ་ཕན་ཚུན་ལྟོས་པ་དང་བཅས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ལྟར་གང་གི་ཚེ་རྣལ་འབྱོར་བས་རིག་པ་དེའི་ཚེ།",
    "གསུང་རྡོ་རྗེ་ཉིན་མོར་བྱེད་པའི་སྐུ།",
    "མཐའ་ཡས་པའི་སྤྲུལ་པའི་སྐུ་དག་གིས་ཅིག་ཅར་རྣམ་པ་ཐམས་ཅད་པའི་སྐུའི་བཀོད་པའི་རྫུ་འཕྲུལ་སྤྲོ་བའི་ཕྱིར་རོ།",
    "སྲོག་གིས་བསྐྱེད་པ་ཡོད་པ་དང་མེད་པའི་རྨི་ལམ་གྱི་སེམས་ཀྱི་དངོས་པོ་མེད་པའི་སེམས་ནི་ལོངས་སྤྱོད་རྫོགས་པ་ཉིན་མོར་བྱེད་པའི་སྐུ་ཞེས་པའོ།",
    "སྟོང་པ་ཡེ་ཤེས་ཀྱང་སྟེ་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "དེའི་སྤྱོད་ཡུལ་མ་ཡིན་པ་མ་མཐོང་བའི་དངོས་པོ་རྣམས་ལ་སྟོང་པ་ལ་སོགས་པའི་མིང་གིས་བསྟན་པར་མཛད་དོ།",
    "ཡི་གེ་རེ་རེ་བའི་མིང་རྣམས་ཀྱིས།",
    "སྟོང་པ་ཞེས་པ་ལ་སོགས་པའི་མིང་རྣམས་ཀྱིས་ཁམས་དྲུག་གི་བདག་ཉིད་སྐྱེས་བུ་ཆེན་པོའི་གང་ཟག་འདི་བསྡུས་པ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས།",
    "ས་ཡི་ཁམས་རྣམ་སྣང་གི་རིགས་སོ།",
    "ཚོར་བ་དང་མེ་དང་མིག་དང་རོ་དང་ལག་པ་དང་འགྲོ་བ་རྣམས་མེ་ཡི་ཁམས་རིན་འབྱུང་གི་རིགས་སོ།",
    "སྟོང་པ་ཞེས་པའི་མིང་གིས་སྟོང་ཆེན་ཡི་གེ་དང་པོ་བརྗོད་དེ།",
    "འདི་ལྟར་ཕུང་པོ་དྲུག་གི་ནང་ནས་ཡེ་ཤེས་ཀྱི་ཕུང་པོ་དང་།",
    "ཁམས་དྲུག་གི་ནང་ནས་ཡེ་ཤེས་ཀྱི་ཁམས་དང་།",
    "གཞོམ་མེད་འདིའི་མིང་ངམ་མཚོན་བྱེད་ཀྱི་མཚན་མ་ནི་ལྷོ་བྱང་ཤར་ནུབ་ཀྱི་ཕྱོགས་བཞིའི་དབུས་སུ་གྱུར་པ་གང་ཡིན་པར་གྲི་གུག་གི་རྣམ་པའི་རི་མོ་ཙམ་ངག་ཏུ་བརྗོད་དུ་མེད་པ་བཀོད་པ་ནི་སྟོང་ཆེན་ཡི་གེ་དང་པོའོ།",
    "འདིའི་མིང་གི་མཚན་མ་དབུས་མ་གཞོམ་དུ་མེད་པའི་མཚན་མའི་ལྷོ་རུ་ཐིག་ལེ་གཉིས་ཏེ་རྣམ་བཅད་བཀོད་པ་བརྗོད་དུ་མེད་པའོ།",
    "སྔ་མའི་ཀྱང་ཡིག་གིས་བསྡུས་ཏེ་བསྟན་པའོ།",
    "དེའི་མིང་གི་མཚན་མ་ནི་དབུས་ཀྱི་མཚན་མའི་བྱང་དུ་ཐིག་ལེ་གཅིག་བཀོད་པ་ང་རོ་སྟེ་བརྗོད་དུ་མེད་པའོ།",
    "མཆོག་ཅེས་པ་མཆོག་དང་པོའི་མིང་གིས་སྟོང་ཆེན་གཉིས་པ་བསྟན་ཏེ།",
    "སྔར་གྱི་ཀྱང་ཡིག་གིས་འདི་ཡང་སྟོང་ཆེན་གྱི་མིང་ཅན་དུ་སྡུད་པའོ།",
    "སྣ་དང་རེག་བྱ་དང་།",
    "འདིའི་མིང་གི་མཚན་མ་ནི་དབུས་མ་གཞོམ་དུ་མེད་པའི་ཤར་དུ་དབྱུག་པའི་རྣམ་པའི་རི་མོ་ཙམ་བརྗོད་དུ་མེད་པའོ།",
    "མཆོག་ཕྱི་མ་ནི་དང་ཡིག་གིས་ཟླས་དབྱེ་བའི་བསྡུ་བའི་ཤུགས་ཀྱིས་གོ་བར་བྱའོ།",
    "འདིའི་མིང་གི་མཚན་མ་ནི་དབུས་མ་གཞོམ་དུ་མེད་པའི་ནུབ་ཏུ་ཐོང་བའི་རྣམ་པ་བརྗོད་དུ་མེད་པའོ།",
    "དབུས་སུ་ཨ་ཡིག་སྟོང་པ་གྲི་གུག་གི་རྣམ་པ།",
    "འདི་རྣམས་དབུས་མ་གཞོམ་དུ་མེད་པའི་སྒྲིབ་བྲལ་གྲི་གུག་གི་རྣམ་པའི་མིང་གི་མཚན་མས་བསྡུས་པར་རྟོགས་པར་བྱའོ།",
    "རེག་བྱ་ཨེ།",
    "དེ་ལྟར་དབྱངས་དང་ཡོན་ཏན་དང་འཕེལ་བ་དང་ཡ་ཎྜ་ར་བསྒྱུར་བའི་རྣམ་པས་སུམ་ཅུ་རྩ་དྲུག་གི་དབྱེ་བ་ཐ་དད་པར་འགྱུར་རོ།",
    "རོ་དྲུག་གི་དབྱངས་ནི་རིམ་བཞིན་ཨཾ་ཨ་ཨི་རྀ་ཨུ་ལྀ་ཞེས་སོ།",
    "དེ་ལྟར་ཡི་གེ་སུམ་ཅུ་རྩ་དྲུག་གི་བདག་ཉིད་ཅན།",
    "འདིར་གསལ་བྱེད་སྲོག་མེད་བརྗོད་དུ་མེད་པ་དེ་རྣམས་དབྱུག་པའི་རྣམ་པ་ཙམ་དུ་བཀོད་པ་མཐར་གཉིས་རེ་འདུས་ཏེ་ཨེ་ཡིག་ཏུ་གྲུབ་པ་ནི་ཨེ་ཡིག་གི་གཟུགས་སྒྲུབ་པའོ།",
    "དབྱངས་དང་གསལ་བྱེད་འདི་དག་གི་ཡང་ཐུང་ངུ་དང་རིང་པོའི་དབྱེ་བས་ཕུང་པོ་དང་ཁམས་ལ་སོགས་པའི་དབྱེ་བ་ཤེས་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ཞེས་པ་མཆོག་གི་བདེ་བ་དང་ཡུལ་ཅན་ཤེས་པ་དང་ཁུ་བའོ་ཞེས་ཟླ་བ་དང་སྐུ་ཡང་ངོ།",
    "དེ་ལྟར་ན་རེ་རེའང་ཁམས་དྲུག་གི་ཆ་ཤས་སུ་འགྱུར་རོ།",
    "དེ་ལྟར་ཟླ་བ་དང་ཉི་མ་དག་གི་ཉེར་ལེན་ལས་བྱུང་བའི་ཁམས་གསུམ་པོ་རྣམས་ནི་རིམ་པ་བཞིན་མངལ་སྐྱེས་རྣམས་ཀྱི་ལུས་དང་ངག་དང་སེམས་སུ་འགྱུར་ཏེ།",
    "ཇི་ལྟར་ན་བུ་མོ་ལོ་བཅུ་གཉིས་པ་ན་རྡུལ་འབབ་པ་དང་།",
    "བུ་མོ་དང་སྐྱེས་པ་ལ་རྡུལ་དང་ཁུ་བ་འབབ་པའི་དུས་ཇི་སྲིད་པ་དེའི་སྔོན་དུ་སྒོ་གསུམ་གྱི་རིགས་གསུམ་མམ།",
    "དེས་རྒྱུད་གཞན་མཐའ་དག་གི་ངེས་པའི་དོན་ཡང་གསལ་བར་ནུས་ཏེ་གསང་སྔགས་ཀྱི་བརྡ་ཁྱད་པར་ཅན་འདི་དག་གི་སྒོ་ནས་ཟབ་མོའི་རྒྱུད་དོན་བསྟན་པ་ཤེས་པར་བྱའོ།",
    "དེ་དག་རང་རང་གི་ཡི་གེ་བསྟན་པ་དེས།",
    "འོག་གི་སྐབས་རྣམས་སུའང་དེ་ལྟར་དྲན་པར་བྱ་སྟེ།",
    "ལྷ་མིན་ནི་ཀླུའི་རྒྱལ་པོ་རྣམས་དང་ལྷ་མོ་ཁྱི་གདོང་མ་སོགས་པ་ཡང་ངོ།",
    "ཕྱི་རོལ་དུ་དང་ནང་རང་གི།",
    "སྒྱུ་འཕྲུལ་ཆེན་མོ་དྲག་ཆེན་པོ།",
    "འབྱུང་དང་སྡུད་པར་བྱེད་པ་མོ།",
    "ལུས་ལ་སྣ་ཚོགས་པའི་ཚད་ཇི་ལྟར་ཡིན་པ་ཞུས་པ་ནི་ནང་གི་ལེའུར་བརྗོད་པར་བྱའོ།",
    "ལྷ་རྣམས་ཉིན་མོ་ལ་ལོངས་སྤྱོད་ཅིང་།",
    "ལྷ་མིན་རྣམས་མཚན་མོ་ལ་ལོངས་སྤྱོད་པ་ཡིན་པས་ཉིན་མཚན་གྱི་ཆུ་ཚོད་དང་།",
    "དོན་དམ་པའི་བདེན་པས་ནམ་མཁའི་ཁམས་ལ་ཐིག་གདབ་པ་དང་ཚོན་དགྱེ་བ་སོགས་དང་བྲལ་བ།",
    "ཞུ་བ་འདི་རྣམས་སུ་ཞིག་གིས་ལུང་སྟོན་པར་བྱེད་ཅེ་ན།",
    "དེ་ལྟར་སྒྲིབ་པ་དང་བཅས་པའི་ཕྱི་རོལ་དང་ནང་གི་རྣམ་པར་སྣང་བ་དེ་དག་སྒྲིབ་པ་དང་བྲལ་བའི་ཚེ་དག་པ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་དུ་སྣང་བ་ནི་གཞན་དུས་ཀྱི་འཁོར་ལོ་ཞེས་བྱ་སྟེ།",
    "སྒྲིབ་པ་དང་བཅས་པའི་ཕྱི་དང་ནང་གི་སྣང་བ་རྣམས་ལས་གནས་གཞན་དུ་གྱུར་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་མ་འོངས་པའི་དུས་ཀྱི་གདུག་པའི་སློབ་དཔོན་རྣམས་ཀྱི་འཇུག་པ་གཟིགས་ནས།",
    "རྩ་རྒྱུད་དང་བསྡུས་རྒྱུད་རྣམས་སུ་བཞི་པ་ཤེས་རབ་ཡེ་ཤེས་རང་གི་ངོ་བོ་དང་།",
    "རྒྱལ་བ་སྲས་དང་བཅས་པའི་ཡེ་ཤེས་ཀྱི་གཟིགས་པ་དང་།",
    "ཟླ་བ་བཟང་པོ་ཁྱོད་ལ་བདག་མགུ་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "རྒྱུད་སྟོན་པ་པོའི་ཞལ་ནས་ཀྱེ་ཟླ་བ་བཟང་པོ་ཁྱོད་ལ་བདག་མགུའོ།",
    "གང་ཞིག་ཁྱོད་ཀྱིས་དྲིས་པ་དུས་ཀྱི་འཁོར་ལོའི་རྣལ་འབྱོར་འདི་ལྟ་བུ་ནི་འཇིག་རྟེན་པའི་བློ་གྲོས་རབ་དང་མཆོག་ཏུ་གྱུར་པ་རྒྱལ་ཆེན་རིས་བཞི་ནས་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་མཐར་སོན་པའི་ལྷ་རྣམས་དང་།",
    "དྲང་སྲོང་མི་སྦྱིན་ལ་སོགས་ཐུབ་པ་མཆོག་གི་རིགས་སུ་གྱུར་པ་རྣམས་དག་གིས་ཤེས་པ་མིན་པས་སོ།",
    "དེ་ལྟར་དེ་དག་གིས་མི་ཤེས་པ་དུས་ཀྱི་འཁོར་ལོའི་རྣལ་འབྱོར་གང་ཞིག་མྱ་ངན་ལས་འདས་པ་ཡེ་ཤེས་ཀྱི་ཁམས་ལ་སོགས་པ་འཛིན་མའི་མཐར་ཐུག་པའི་ཁམས་དྲུག་གི་རང་བཞིན་ནི།",
    "ཚིག་གི་བགྲོད་པ་ཞེས་ཚིག་ནི་དབྱངས་གསལ་གཉིས་ཡིན་ལ་དེའི་བགྲོད་པའམ་གནས་ནི་མགྲིན་རྐན་སྤྱི་བོ་མཆུ་དང་སོའི་གནས་རྣམས་ཏེ་དེ་ལྟར་གནས་དེ་རྣམས་ལས་བྱུང་བའི་དབྱངས་དང་གསལ་བྱེད་རྣམས་བརྗོད་པའོ།",
    "འདི་ལྟར་བུམ་པ་སོགས་ཀྱི་མིང་གིས་མིང་ཅན་གྱི་དངོས་པོ་བུམ་པ་ལ་སོགས་པ་རྣམས་གོ་བར་བྱེད་པས་ན།",
    "གླེང་བསླང་བ་ཞུས་པ་ལན་དང་བཅས་སོང་ནས།",
    "དུས་ཀྱི་སྟོང་པ་རྣམས་ལས་ཞེས་སོགས་ཚིགས་བཅད་དྲུག་གིས་བསྟན་པ་ཡིན་ནའང་།",
    "དང་པོ་དུས་ཀྱིས་སྟོང་པ་རྣམས་ལས་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "དེའི་ཕྱིར་འདིའི་དོན་སྔར་གྱི་དུས་འཁོར་པ་ཁ་ཅིག་གིས།",
    "ཁ་ཅིག་གིས་མིའམ་ཅི་ལྗོན་པ་རྟ་མགོ་ཅན་ཡིན་ཟེར་བ་དང་།",
    "ཡང་འགའ་ཞིག་གིས་འདི་ཐད་ཙ་མིའི་འགྱུར་ལས་ཤིག་ལ་སོགས་པ་རྫུས་ཏེ་སྐྱེས་པ་རྣམས་ནི་དུད་འགྲོ་ས་ཡི་སྐྱེ་གནས་ཅན་ནོ།",
    "ཞེས་འབྱུང་ཞིང་ལྗོན་ཤིང་གི་མིང་མེད་ལ།",
    "ཡང་ན་ལྗོན་པ་ཞེས་པ་དུད་འགྲོ་རྫུས་སྐྱེས་བྱེ་བྲག་པ་ཞིག་གི་མིང་ཡིན་ཚུལ་གྱི་ངེས་པ་ཡོད་ན་དེར་ཟད་ཀྱི།",
    "འགྲེལ་པར་ས་ཞེས་པ་ནི་ལུང་གི་ཚིག་གོ་ཞེས་པ་དེའི་སྐད་དོད་མ་ཧཱི་རིང་པོ་དགོས་ཀྱང་ཐུང་ངུ་བྱུང་བ་ལུང་འདི་ཡི་ཚིག་གོ་ཞེས་སོ།",
    "གཞོམ་མེད་སྲོག་གི་ང་ལས་གཟའ་སོགས་སྲིད་པ་རིམ་པར་མཆེད་པའི་ཚུལ།",
    "ལུས་དང་ཡེ་ཤེས་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "ཡི་གེ་རྣམས་བརྩེགས་པའི་སྟེང་དུ་ཐིག་ལེ་ཟླུམ་པོ་ལ་ཡེ་ཤེས་རྩེ་མོའི་རྣམ་པ་དང་།",
