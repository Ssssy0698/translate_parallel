    "ཅེས་བརྗོད་ཅིང་དྲི་བཟང་གིས་གཙོ་བོ་ལྔའི་གནས་སུ་གྲུ་བཞི་དང་།",
    "ལྷ་རང་རང་གི་གནས་རྣམས་སུ་དྲིའི་ཐིག་ལེ་ཟླུམ་པོ་བྱའོ།",
    "རང་གི་མདུན་དུ་ནམ་མཁའ་ནས་རྟེན་གྱི་གཞལ་ཡས་ཁང་གནས་པར་གྱུར་པ་ནི།",
    "དེའི་ཕྱེད་ཀྱི་ཚད་དུ་ནང་གི་གཞལ་ཡས་ཁང་ཞེས་པ་རྗེའི་གསུང་འབུམ་ན་པ།",
    "ཐམས་ཅད་ཀྱི་གནས་གསུམ་དུ་ཡི་གེ་གསུམ་དང་རང་རང་གི་ཐུགས་ཀར་ཟླ་བ་ལས་ས་བོན་དགོད་པ་སོགས་བྱས་ལ།",
    "ཨོཾ་བཛྲ་ཨཾ་ཀུ་ཤ་ཛ་ནམ་མཁར་བཏེག་པའི་ཡེ་ཤེས་པ་རྣམས་རང་རང་གི་དམ་ཚིག་པ་རྣམས་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཨོཾ་བུདྡྷ་ཨ་བྷི་ཥིཉྩ་ཨོཾ།",
    "བཅུ་ལས་མི་ཉུང་བར་བྱས་ལ་ཆུ་གཉིས་ཉེར་སྤྱོད་རོལ་མོ་དང་བཅས་པ་ལ་སོགས་པས་མཆོད་ལ་བསྟོད་པ་རྒྱས་བསྡུས་གང་རུང་བྱའོ།",
    "ལྷ་རང་རང་གི་སྔགས་བདུན་བདུན་བརྗོད་ཅིང་དྲི་བཟང་གི་ཐིག་ལེ་སྔར་ལྟར་བྱས་ལ།",
    "ཕྱོགས་བཞིའི་བུམ་པར་རང་རང་གི་ཕྱོགས་མཚམས་ཀྱི་རྩ་བའི་ལྷ་རྣམས་བསྐྱེད་པ་ནས་མཆོད་བསྟོད་ཀྱི་བར་བྱའོ།",
    "ཀྵཾ་ལས་མཆེ་བ་ཀྵཾ་གིས་མཚན་པ་ལས།",
    "ལྷ་ཐམས་ཅད་ཀྱི་གནས་གསུམ་དུ་ཡི་གེ་གསུམ་དགོད་པ་ནས་མཆོད་བསྟོད་ཀྱི་བར་སྔར་བཞིན་བྱས་པའི་རྗེས་སུ་བཟླས་པའི་སྔགས་ཀྱིས་བསྐོར་བའི་ལྷ་རང་རང་གི་ཐུགས་ཀའི་ས་བོན་ལས་ལྷའི་ཚོགས་འོད་འཕྲོས།",
    "སླར་འདུས་ནས་རང་རང་གི་ཐུགས་ཀའི་ས་བོན་ལ་ཐིམ་པར་གྱུར་པར་བསམས་ལ།",
    "རང་རང་གི་དམ་རྒྱས་གཟུངས་ཐག་བཟུང་ལ།",
    "གཞན་རྣམས་ཀྱི་སྔགས་བརྒྱ་རྩ་བརྒྱད་དམ་ཉེར་གཅིག་རེ།",
    "ཐམས་ཅད་ལ་ཐུན་མོང་དུ་རྩ་རིག་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའི་རྗེས་སུ།",
    "མེ་ཏོག་ནས་རོལ་མོའི་བར་གྱིས་མཆོད་ལ་ལས་ཐམས་ཅད་པ་བརྗོད་ཅིང་ལས་བུམ་གྱི་ཆུ་གཏོར་ཏེ།",
    "ལག་པས་བུམ་པ་ལ་རེག་ལ་བསྟོད་པ་རྒྱས་བསྡུས་གང་རུང་བྱའོ།",
    "པུས་མོ་བཙུགས་ཐལ་མོ་སྦྱར་ལ།",
    "དགའ་ཆེན་སྟོན་པ་ཁྱོད་གཅིག་པུ།",
    "བདེ་གཤེགས་སྲས་ཀྱི་ཚོགས་གཉིས་ཟབ་མོ་དང་།",
    "རང་གི་སེམས་ནི་དག་པར་བྱ་བའི་ཕྱིར།",
    "ཨུ་དུམ་ཝ་ར་སོགས་ཀྱི་སོ་ཤིང་སོར་བཅུ་གཉིས་པ་རྩེ་མོར་མེ་ཏོག་བཅིངས་པ་ལ།",
    "སྟེང་འོག་རིག་འཛིན་དང་ས་འོག་གི་དངོས་གྲུབ་འགྲུབ་ཅེས་བརྡ་སྤྲད་དོ།",
    "ངག་གི་ཉེས་པ་སྦྱང་བའི་དོན་དུ་ཁྱོར་བ་གསུམ་བྱིན་ལ་འཐུང་དུ་གཞུག་གོ།",
    "རེས་འགའ་འབྱུང་ངམ་མི་འབྱུང་སྲིད།",
    "བརྒྱ་ལམ་ན་ནི་རེས་འགའ་ཞིག།",
    "གང་གིས་ཁྱེད་རྣམས་རྒྱལ་བ་ཀུན།",
    "གང་གིས་ཁྱེད་རྣམས་འགྲོ་འགྱུར་བས།",
    "རྨི་ལམ་རྟོགས་ལ་ནང་བར་ང་ལ་སྨོས་ཤིག་ཅེས་བརྗོད་ནས་མགོ་ཤར་རམ་སོ་ཤིང་གི་མགོ་གང་དུ་བསྟན་པ་དེར་སེང་གེའི་ཉལ་སྟབས་ཀྱིས་ཉལ་དུ་གཞུག།",
    "དེ་ནས་སྟ་གོན་གྱི་ལྷ་ལ་ཆུ་གཉིས་ཉེར་སྤྱོད་རོལ་མོ་དང་བཅས་པས་མཆོད་དེ།",
    "རིག་པའི་རྒྱལ་པོ་ཁྱོད་ལ་འདུད།",
    "དེས་ཀྱང་དེ་ཉིད་བརྗོད་ཅིང་བླངས་ནས་གཉིས་ཀའི་ལག་པ་གཡོན་པའི་སོར་མོའི་རྩེ་མོ་ནས་མཐེ་བོའི་རྩ་བའི་བར་དུ་སྔོ།",
    "ལས་ཐིག་ལྟར་བསྲུང་ཞིང་བདུད་རྩི་ལྔ་ལ་སོགས་པས་གཏོར་ལ་རྡོ་རྗེ་དང་བཅས་པའི་ལག་པ་གཡས་པས་རེག་ནས།",
    "མཆོད་ཡོན་ནས་རོལ་མོའི་བར་གྱིས་མཆོད་ཅིང་བསྟོད་ནས།",
    "ཞེས་དེར་མོས་ལ།",
    "ཞེས་རྡོ་རྗེ་དང་བཅས་པའི་གཡས་པའི་མཐེ་བོང་དང་མཛུབ་མོས་ཐིག་སྐུུད་བཟུང་ལ་སེ་གོལ་གྱི་སྒྲ་དང་བཅས་པས་ནམ་མཁར་གདབ།",
    "དེ་ནས་སློབ་དཔོན་པུས་མོ་གཡས་གྱེན་དུ་བསླང་།",
    "འོད་འཕྲེང་ནས་འོད་འཕྲེང་གི་བར་དུ་ཚངས་ཐིག་དང་པོ་བཏབ་ལ།",
    "ངོ་བོ་ཡེ་ཤེས་ལ་རྣམ་པ་སྲད་བུ་ཁ་དོག་ལྔར་སྣང་བའི་ཐིག་སྐུུད་རེ་ཆད་ནས་ལས་ཐིག་ལ་ཐིམ་པར་བསམ་མོ།",
    "ཞེས་བརྗོད་ཅིང་དང་པོར་དཀྱིལ་འཁོར་གྱི་ནང་ནས་ཤར་དུ་ཁ་བལྟས་ཏེ་དྲིའི་ཆུས་ཚངས་ཐིག་གི་གཡས་གཡོན་གྱི་རྩ་ཐིག་ཆ་ཕྲན་གཉིས་གཉིས་གཡས་སྐོར་དུ་རིམ་པ་བཞིན་དབྱིའོ།",
    "འོག་གི་ཚོན་ལ་ཡང་གཤེགས་གསོལ་དེ་བཞིན་དུ་བྱའོ།",
    "ཨོཾ་དཱིཔྟ་དྲིཥྚ་ཨཾ་ཀུ་ཤ་ཛ་ཞེས་སྔར་ཡེ་ཐིག་གི་སྐབས་བཞིན།",
    "མེ་ཏོག་ནས་རོལ་མོའི་བར་གྱིས་མཆོད་དོ།",
    "ཞེས་ཡིད་ཀྱིས་རི་མོ་བཏེག་པའི་འོག་ནས་འཛུལ་བར་བསམས་ལ་ནང་དུ་འདུག་སྟེ།",
    "རང་རང་གི་ཕྱག་མཚན་ནམ།",
    "རོལ་མོའི་ཆ་བྱད་སྣ་ཚོགས་པ་དང་།",
    "ནང་གི་ཕྱོགས་བཞིར་ཟླ་བའི་དཀྱིལ་འཁོར་རྣམས་ཀྱི་དབུས་སུ།",
    "ཤར་དུ་ཧཱུཾ་ལས་རྡོ་རྗེ་ཧཱུཾ་གིས་མཚན་པ།",
    "ཞེས་པ་ནས་རྡོ་རྗེའི་འབེབས་པའི་བར་རང་རང་གི་ཟླ་གདན་གྱི་དབུས་སུ་རང་རང་གི་ས་བོན་ལས་ཕྱག་མཚན་ས་བོན་གྱིས་མཚན་པ་སྔར་བཞིན་བརྗོད་ཅིང་བསམས་ལ་ཆོ་ག་གསུམ་གྱིས་བདག་བསྐྱེད་ཀྱི་སྐབས་ལྟར་རྫོགས་པར་བསྐྱེད།",
