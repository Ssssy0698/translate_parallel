    "འདིར་ཞེས་བྱ་བ་ནི་ཡན་ལག་ཅན་གནོད་པར་བྱེད་པ་ལའོ།",
    "གཞན་དག་ཅེས་བྱ་བ་ནི་རིགས་པ་ཅན་ལ་སོགས་པའི་ཁྱད་པར་རོ།",
    "གལ་ཏེ་རྫས་སོ་སོར་ངེས་པ་འབའ་ཞིག་གཞལ་ན་དེའི་ཚེ་དེའི་ལྗི་བ་ཉེ་བར་མཚོན་པར་ནུས་པ་ཞིག་ན།",
    "འདི་ཉིད་གསུངས་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ལྕི་བ་ཉིད་བླ་ལྷག་པར་མི་རྟོགས་ན་ཡན་ལག་ཅན་བླ་ལྷག་པ་དེ་ནི་ག་ལས་རྟོགས་ལྕི་བ་ཉིད་དང་འོག་ཏུ་འགྲོ་བ་ཉིད་མེད་པར་ཡང་ཡན་ལག་ཅན་རྟོགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་ཀུན་རྫོབ་ཏུ་ཡོད་པའི་ཡན་ལག་ཅན་ནི་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ནོ།",
    "དེ་སྐད་སྨྲ་བ་དེ་ནི་རྡུལ་གཉིས་པ་ལ་སོགས་པའི་རིམ་གྱིས་ལྡན་པ་དང་ཅིག་ཅར་ལྡན་པའི་ཕྱག་དར་གྱི་ཕུང་པོ་འདི་གཉིས་ཀྱི་ལྗིད་ཐ་དད་པར་འགྱུར་རོ།",
    "དེ་ཕྱིར་ཞེས་གསུངས་སོ།",
    "འོན་ཏེ་གཉི་ག་ལ་ཡང་ཡན་ལག་ཅན་གཅིག་ཁོ་ན་ཡིན་པ་དེས་ན་ལྗིད་ཐ་དད་པར་༡༤མི་འགྱུར་རོ་ཞེ་ན།",
    "ད་ེལྟ་ན་འོ་ན་སོ་སོ་དང་ལྷན་ཅིག་ཏུ་བཅལ་བ་ལ་ལྗིད་ཐ་དད་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ཡང་རིམ་མམ་ཅིག་ཅར་གྱི་གོང་བུར་བྱས་ནས་བཅལ་བ་སྟེ།",
    "དེ་ལྟར་སོ་སོ་དང་ལྷན་ཅིག་བཅལ་བ་ན་ལྗིད་ཐ་དད་པར་འགྱུར་རོ།",
    "འདིར་ཡང་གཉི་ག་ལ་ཡན་ལག་ཅན་གྱི་རྫས་གཅིག་༤ཁོ་ན་ཡོད་དོ་ཞེས་ནི་བརྗོད་པར་མི་ནུས་སོ།",
    "ལན་འདི་ནི་གསལ་བའི་ཕྱིར་རྣམ་པར་མ་ཕྱེའོ།",
    "འདི་ལ་སྲང་དམའ་བའི་ཁྱད་པར་མེད་ན།",
    "༡༢༡༡སྐྱེ་བ་ཡིན་པའི་ཕྱིར་སྲང་དམའ་བའི་ཁྱད་པར་དུ་མི་འགྱུར་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཡིན་ན།",
    "དེའི་ཚེ་རྡུལ་ཕྲ་རབ་རྣམས་ཀྱང་འཇིག་པར་འགྱུར་རོ་། ཡན་ལག་ཅན་ཐམས་ཅད་འཇིག་པ་ན་རྡུལ་གཉིས་པ་ཡང་བསྡུས་པ་ནི་མ་ཡིན་ནོ།",
    "རྡུལ་ཕྲ་རབ་རྣམས་ལ་ཡང་རྣམ་པར་དབྱེ་བ་ཡོད་དོ་ཞེ་ན།",
    "འདིས་ནི་རྡུལ་ཕྲ་རབ་རྣམས་ལ་རྣམ་པར་དབྱེ་བ་མེད་པའི་སྒྲུབ་བྱེད་ཆ་མེད་པ་ཉིད་མ་གྲུབ་སྟེ་གཞན་གྱིས་ལུས་ཅན་དུ་ཁས་བླངས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "༢༡༡༢༡༢མར་གནས་པའི་ཡན་ལག་ཅན་གཅིག་ཁོ་ན་སྐྱེས་པ་དེའི་ཕྱིར་སྲང་དགུག་༢ཁྱད་པར་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "མ་ཤ་ལ་སོགས་པ་རིམ་གྱིས་བཅལ་བ་གྲངས་ལྔས་རིམ་པར་བཅད་པ་ཕྱིས་གོང་བུར་བྱས་པ་རྣམས་ཀྱི།",
    "གོང་བུར་བྱས་པའི་གནས་སྐབས་ན་ཡན་ལག་ཅན་གཅིག་ཡིན་པའི་ཕྱིར་དང་།",
    "དོན་དམ་པར་ནི་མི་འགྱུར་གྱི་འོན་ཀྱང་བརྟག་པར་འགྱུར་རོ།",
    "ཅིག་ཅར་ལྡན་པ་དང་རིམ་གྱིས་ལྡན་པ་དག་ནི་གནོད་མི་ཟ་བར་ལྗིད་ཁྱད་པར་ཡོད་པར་འགྱུར་རོ།",
    "ཅི་ལྟར་རྫས་གཅིག་མི་རྟོགས་པ་དེ་བཞིན་དུ་གོང་མ་གོང་མའི་འབྲས་བུ་ཐམས་ཅད་ཀྱང་ཡིན་པར་འགྱུར་ཏེ།",
    "ཡན་ལག་ཅན་ཡང་ཞིག་པར་གྱུར་ཀྱང་དུམ་བུའི་ཡན་ལག་ཅན་དང་དེའི་ཡན་ལག་ལུས་དག་ལ་ཡང་ལྗིད་དེ་ཉིད་མཐོང་ངོ་ཞེས་སྦྱར་༤རོ།",
    "ཡང་དུམ་བུའི་ཡན་ལག་ཅན་དང་དེའི་ཡན་ལག་དག་ཞིག་པར་གྱུར་ཀྱང་།",
    "དེ་རྟོགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡན་ལག་ཅན་ལ་གནོད་པར་བྱེད་པ་དུ་མ་ཡོད་པ་ཡིན་ནོ་། འོ་ན་ཅི་ལྟར་སྲང་དམའ་བའི་ཁྱད་པར་མི་འཛིན་པའི་ཕྱིར་ཞེས་བྱ་བ་འབའ་ཞིག་བརྗོད་ཅེ་ན།",
    "རྩ་བའི་སློབ་དཔོན་གྱིས་གསུངས་པའི་དམའ་བ་མེད་པ་གང་ཡིན་པ་དེ་ནི་ཡན་ལག་ཅན་ལ་གནོད་པར་བྱེད་པ་གཞན་གྱི་ཉེ་བར་མཚོན་བྱེད་ཡིན་ནོ།",
    "གལ་ཏེ་ཡན་ལག་ཅན་གྱི་ཡོན་ཏན་ཐམས་ཅད་རྟོགས་པ་མེད་པ་ཉིད་གང་ལས་ཤེ་ན། གཟུགས་སོགས་ཞེས་གསུངས་ཏེ།",
    "གཞན་དག་ཀྱང་ཞེས་བྱ་བ་ནི་ཡན་ལག་ཅན་གྱི་གནོད་པར་བྱེད་པའོ།",
    "ཡན་ལག་ཅན་གྱི་གཟུགས་དང་སྒྲ་ལ་སོགས་པ་ཐམས་ཅད་མི་རྟོགས་པ་ཡིན་ནོ་ཞེས་གང་ལས་ཤེས་པར་བྱ་བ་ཡིན་ཞེ་ན།",
    "ཡན་ལག་ཅན་ཡོད་པར་ཁས་བླངས་ཀྱང་།",
    "ཐ་མའི་ཡན་ལག་ཅན་ལ་གནས་པའི་གཟུགས་དང་རོ་ལ་སོགས་པ་ཡན་ལག་ཅན་ལ་གནས་པའི་གཟུགས་ལ་སོགས་པ་དག་ལས་ཁྱད་པར་དུ་གྱུར་པ་ནི་རྟོགས་པ་མེད་དོ།",
    "དེ་ལ་ཡན་ལག་ཅན་གཞན་ཁས་བླངས་ནས་ཁྱད་པར་ལྕི་བ་ཉིད་ལ་སོགས་པའི་མཚན་ཉིད་རིགས་པའི་སྟོབས་ཀྱིས་མི་འདོད་པ་དེས་ན་གཞན་ཉིད་དུ་ཁས་བླངས་པ་ནི།",
    "གཞན་ཉིད་ཀྱི་ཁྱད་པར་མེད་པར་ཁས་བླངས་པས་གནོད་པ་ཡིན་ནོ།",
    "དེས་ན་ཡན་ལག་ཅན་དོན་དམ་པར་ཡོད་པ་ནི།",
    "དོན་དམ་པར་ཡོད་པ་མ་ཡིན་པ་ཀུན་རྫོབ་ཏུ་ཡོད་པར་གནོད་པ་ཡིན་ནོ།",
    "མངོན་སུམ་གྱིས་གནོད་པའི་རྗེས་སུ་དཔག་པས་བསལ་བ་ཡང་སྲང་དམའ་བའི་ཁྱད་པར་མི་འཛིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "དེས་ན་ཕྱོགས་ལྟར་སྣང་བ་གཅིག་པོ་འདི་ནི་གནོད་པ་རྣམ་པ་བཞིའི་ནང་དུ་འདུས་པ་ཡིན་ནོ་། གལ་ཏེ་ཐམས་ཅད་ཡན་ལག་ཅན་ལ་གནོད་པའི་དཔེར་བརྗོད་པ་ཡིན་པར་ཅི་ལྟར་རྟོགས་པར་བྱ་སྟེ་མ་བསྟན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "༡༢ ༡༧བརྗོད་པ་གཞན་རྟོགས་པར་བྱའོ།",
    "ཡན་ལག་ཅན་གྱི་གནོད་པར་བྱེད་པའི་རིགས་པ་ཉེ་བར་སྟོན་པའི་དཔེར་བརྗོད་པ་ནི་ཅི་སྐད་བརྗོད་པའི་ཕྱོགས་ཀྱིས་ན་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བར་གྱུར་པ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་ཡང་འདི་གཉིས་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དེ་ལྟ་ན་ཡང་མ་གྲུབ་པ་ཉིད་ལ།",
    "མ་གྲུབ་པ་ཡང་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་འདི་གཉིས་ནི་ཕྱིས་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྒྲུབ་པར་བྱེད་པའི་བདག་ཉིད་མ་ཡིན་པར།",
    "དེའི་ཚེ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་ཚེ་ཉིད་སྒྲུབ་པར་བྱེད་པར་མི་འདོད་ཀྱང་བསྒྲུབ་བྱར་འགྱུར་རོ་།",
    "ཡང་ན་ཾདེ་ལྟའི་མིན་ཞེས་བྱ་བ་བསྒྲུབ་པར་བྱ་བའི་བདག་ཉིད་མ་ཡིན་པ།",
    "གཞན་དག་ལ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཉེ་བར་བཀོད་པ་དེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པའི་ཚེ་མ་ཟད་ཀྱི།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཕྱིས་འགྱུར་བ་ཅི་ལྟར་ཡིན་ཏེ།",
    "ད་ལྟར་བ་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་དུས་ནའོ།",
    "དེ་ལྟ་བུའི་བདག་ཉིད་མ་ཡིན་པར་ཞེས་བྱ་བ་ནི།",
    "བསྒྲུབ་པར་བྱ་བའི་བདག་ཉིད་མ་ཡིན་པར་རོ།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་ནི་སྒྲུབ་པར་བྱེད་པར་བསྟན་པའི་དུས་ན།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་འོ་ན་ཕྱིས་ཅི་ལྟར་བསྒྲུབ་བྱར་འགྱུར་སྙམ་ན།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་མ་གྲུབ་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་མ་ཡིན་པས་ནའོ།",
    "དེ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དེའོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་དུས་ན་ཅི་ལྟར་བསྒྲུབ་བྱ་མ་ཡིན་སྙམ་ན།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་དུས་ན་ཡང་མ་གྲུབ་པ་སྒྲུབ་བྱེད་ཉིད་དུ་བསྟན་པ་ནི།",
    "ཅི་ལྟར་བསྒྲུབ་པར་བྱ་བའི་སྒྲ་ཤེས་པར་བྱ་བ་ཉིད་དུ་གྱུར་པའི་བསྒྲུབ་པར་བྱ་བ་རྟོགས་པར་བྱེད་ཀྱི།",
    "བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "མ་གྲུབ་པའི་གཏན་ཚིགས་དང་དཔེ་དག་ཀྱང་བརྗོད་པར་བྱ་བར་མི་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "ཤེས་བྱེད་སྐབས་ཀྱིས་༤སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་མ་གྲུབ་པ་ཐམས་ཅད་ཀྱང་བསྒྲུབ་པར་བྱ་བའི་ཁྐྲིསྒྲས་རྟོགས་པར་འགྱུར་རོ།",
    "བྱེད་པ་པོ་ལ་ལྟོས་པའི་བསྒྲུབ་པར་བྱ་བ་གང་ཡིན་པ་དེ་ནི་ཤེས་པར་བྱེད་པའི་སྐབས་ཀྱིས་བསལ་བར་བྱེད་པ་ལ་བཟློག་པར་བྱ་བ་ཡིན་ལ།",
    "གཞན་པའི་བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་ེཔར་བྱེད་པ་ཉིད་དུ་ཉེ་བར་བསྟན་པ་ཐམས་ཅད་ནི་སྡུད་པར་བྱེད་པ་ཁོ་ནའོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་གཞན་ཐམས་ཅད་སྡུད་པར་བྱེད་པའི་ཕྱིར་ན་བསྒྲུབ་པར་བྱ་བ་གཞན་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་ནི་རྣམ་པར་གཅོད་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "འོ་ན་བྱེད་པ་པོའི་བསྒྲུབ་པར་བྱ་བ་ཡང་ཅི་ལྟར་རྣམ་པར་གཅོད་སྙམ་ན།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་གཞན་རྣམ་པར་མ་བཅད་པ་བཞིན་དུ་བྱེད་པ་པོའི་བསྒྲུབ་པར་བྱ་བ་ཡང་རྣམ་པར་མ་བཅད་པར་ཅི་སྟེ་མི་འགྱུར་ཞེ་ན་འགའ་ཞིག་ཅེས་བྱ་བའོ།",
    "བྱེད་པ་པོའི་བསྒྲུབ་བྱ་རྣམ་པར་བཅད་པ་ངེས་པ་ནི།",
    "ཤེས་པར་བྱེད་པ་རྒྱུའི་སྐབས་ཀྱི་རྒྱུས་རྒྱུ།",
    "མ་གྲུབ་པའི་གཏན་ཚིགས་དང་དཔེ་དག་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་པར་ངེས་པའོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཞེས་བྱ་བ་ནི།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པའི་བཅའ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི། སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དང་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་བསྟན་པ་གཉི་གའི་སྤྱིའི་མཚན་ཉིད་ཡིན་ཏེ།",
    "དེས་ན་ཁྱད་པར་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་གཞན་བསྟན་པའི་མཚན་ཉིད་གཞན་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་ཕྱོགས་ཀྱི་མཚན་ཉིད་ཤིན་ཏུ་ཁྱབ་ཆེས་པའི་ཉེས་པར་འགྱུར་རོ།",
    "དེ་དང་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོའི་བསྒྲུབ་པར་བྱ་བ་༤བཟློག་པར་བྱ་བ་དང་ངོ།",
    "མི་རྟག་པ་ཉིད་ཀྱི་ཁྱད་པར་ཅན་གྱི་བུམ་པ་ནི་གྲངས་ཅན་ལ་མ་གྲུབ་སྟེ།",
    "ལས་གང་ལ་ཁྱད་པར་དུ་འཕགས་པ་ཡོད་པ་དེ་ནི་དམ་བཅའ་བ་ཡིན་ནོ་ཞེས་སྦྱར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "འདི་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི་འོ་མ་ཟ་བའི་བྱ་བས་ཞེས་བྱ་བའོ།",
    "ཕྱིས་འགྱུར་བའི་བསྒྲུབ་པར་བྱ་བ་ལ་ལྟོས་ནས་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཉིད་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདོད་པར་འགྱུར་བ་ནི་སྒྲུབ་བྱེད་མ་གྲུབ་པའོ།",
    "འོན་ཏེ་མི་རྟག་པ་ཡིན་ཞེས་བྱ་བ་ལྟ་བུར་རྫས་ཡོད་པའི་ཁྱད་པར་མི་རྟག་པ་དང་།",
    "ཁས་བླངས་པའི་གྲུབ་པའི་མཐའི་མཚན་ཉིད་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི།",
    "དམ་བཅའ་བ་ཡིན་ནོ་ཞེས་པའི་མཚན་ཉིད་བསྒྲུབ་པའི་ཕྱིར་ཏེ་བྱས་པའི་ཕྱིར་རོ།",
    "སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་ཡིན་པ་བསྒྲུབ་བྱ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རུང་བ་མ་ཡིན་ནོནོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དང་།",
    "༡༢༢༣པས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་རྣམ་པར་འབྱེད་པ་ནི།",
    "རྩོད་པ་ཐ་མ་སེལ་བས་རྣམ་འགྲེལ་དང་པོའི་རྐང་པ་དང་པོ་རྣམ་འགྲེལ་གཉིས་པའི་ཕྱེད་ཕྱི་མ་དང་བཅས་ཏེ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "སྒྲུབ་བྱེད་འདི་མ་གྲུབ་པས་ན་༤ཅི་ལྟར་བསྒྲུབ་པར་བྱ་བ་འདི་ལས་རྟོགས་པར་འགྱུར་ཞེས་བརྒལ་ཞིང་བརྟགས་པ་ན།",
    "སྒྲུབ་པར་བྱེད་པ་དེ་༦བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འགྱུར་རོ་དེས་ན་གདོན་མི་ཟ་བར་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་མ་གྲུབ་པ་ནི་ཞེས་གསུངས་སོ་། གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་ནི་མ་གྲུབ་པ་ཁོ་ན་ཡིན་ལ།",
    "སྒྲུབ་པར་བྱ་བའི་སྒྲ་ནི་བྱ་བའི་རྐྱེན་གྱི་མཐའ་ཅན་ཡིན་ལ།",
    "ཐམས་རང་ཅེས་བྱ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཉེ་བར་བསྟན་པ་དང་མ་བསྟན་པའོ།",
    "འདིས་ནི་བསྒྲུབ་བྱའི་ཡན་ལག་ཅེས་མི་རུང་ཞེས་བྱ་བ་དེ་རྣམ་པར་བཀྲལ་བ་ཡིན་ནོ།",
    "ཐམས་ཅད་ཅེས་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དང་མ་བསྟན་པ་ཐམས་ཅད་དམ་བཅའ་བར་འགྱུར་རོ་ཞེས་སྦྱར་རོ།",
    "གལ་ཏེ་སྒྲུབ་པར་བྱེད་པ་བསྟན་པ་ཡང་དམ་བཅའ་བ་ཡིན་ན།",
    "གྲུབ་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "ཡང་ན་ཞེས་བྱ་བའོ་། མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་དམ་བཅའ་བ་མ་ཡིན་པའི་འཐད་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་གྲུབ་པའི་གྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་བརྒྱ་ལ་བསྒྲུབ་པར་བྱ་བར་འགྱུར་བའམ།",
    "དམ་བཅའ་བ་ཡང་ངེས་པ་ཉིད་དུ་བསྟན་པར་བྱ་བ་ཡིན་ནོ།",
    "ཅི་ལྟར་ནུས་མིན་ཞེས་བྱ་བ་ལ་སོགས་པ་དོན་གྱི་རྣམ་པར་འགྲེལ་པ་ན།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་འདོད་པའི་ཤུགས་ཡིན་པའི་ཕྱིར་རོ་ཞེས་འབྲེལ་ཏོ།",
    "གལ་ཏེ་སྒྲུབ་པར་བྱེད་པ་གཞན་གྱིས་མ་བསྒྲུབས་ན་ནི།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "འོན་ཏེ་དེ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་ཕྱིར་ན་ཕྱུགས་འདོད་ཉིད་མ་ཡིན་ནོ་སྙམ་ན།",
    "ཁྱད་པར་དུ་འཕགས་པའི་རྐྱེན་ནི་ཏ་མའི་རྐྱེན་ནོ།",
    "འདོད་པར་འགྱུར་བ་ནི་ལས་མ་ཡིན་ནོ་ཞེས་༧གང་བརྗོད་པ་ནི་མི་རིགས་སོ་ཞེས་སྨྲས་པ་ནི།",
    "བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདོད་པར་གྱུར་པཡིན་པའི་ཕྱིར་བྱུང་བའི་རྐྱེན་གཙོ་བོ་མ་ཡིན་ནོ།",
    "འདི་ལ་ནི་མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་ལའོ།",
    "མཚན་ཉིད་སུན་དབྱུང་བའི་ཕྱིར་རྣམ་པར་རྟོག་པ་ནི་འདིར་ཞེས་བྱ་བ་སྟེ་དམ་བཅའ་བའི་མཚན་ཉིད་ལའོ།",
    "ཚོགས་པ་ཞིག་བསྒྲུབ་པར་བྱ་བ་༦ སྟེ་མཚོན་པར་བྱ་བར་ཡིན་པར་འགྱུར་གྲང་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའོ།",
    "དེ་ལས་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་དེ་རྣམས་ཀྱི་ནང་ནས་སོ།",
    "ཕྱོགས་གཉི་ག་ལས་བྱུང་བའི་ཉེས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དོན་གྱིས་འཐོབ་༧པོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣམ་འགྲེལ་ལ་འཇུག་པར་བྱེད་པའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་ཞེས་བྱ་བའོ།",
    "༦ ༢༡༦ཡུ་ཅུ་༡༢༢༨བྱས་པ་ཡང་གཞན་དུ་བརྟག་པར་བྱ་བར་འགྱུར་རོ།",
    "མི་སྲིད་པའི་ཕྱིར་ཏེ་། མཚན་ཉིད་ཀྱིས་བསྟན་པར་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་ཡང་གསུངས་སོ་ཞེས་འབྲེལ་ཏེ་། སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོས་གསུངས་པའོ།",
    "ཅི་སྐད་གསུངས་སྙམ་ན།",
    "འོན་ཏེ་གྲུབ་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པར་འགྱུར་རོ་སྙམ་ན།",
    "སྒྲུབ་པར་བྱེད་པའི་རང་བཞིན་དཔྱོད་པ་ལས་རང་བཞིན་བསྒྲུབ་པར་བྱ་བའི་བློ་དེ་མེད་པའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་ཞེས་བྱ་བའོ།",
    "ཾ་སྒྲུབ་པར་བྱེད་པའི་རང་བཞིན་དཔྱོད་པའི་དུས་ན་ནི་བསྒྲུབ་པར་བྱ་བ་ངེས་པ་མ་ཡིན་གྱི།",
    "ཐེ་ཚོམ་དུ་གྱུར་པ་བསྒྲུབ་པར་བྱ་བ་ངེས་པ་ཉིད་སྟོན་པ་ནི།",
    "འོ་ན་ཅི་ལྟར་གཏན་ཚིགས་ཐེ་ཚོམ་ལ་བརྗོད་ཕྱིར་ཞེས་གསུངས་ཤེ་ན།",
    "གྲུབ་པ་དང་ཞེས་གསུངས་སོ།",
    "ཐེ་ཚོམ་མངོན་དུ་གྱུར་པ་མེད་ཀྱང་སྒྲུབ་པར་བྱེད་པ་འཇུག་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་ལ་ཡང་མ་གྲུབ་པ་ཡིན་ཏེ།",
    "དེས་ན་ཅི་ལྟར་དེས་ཁྱད་པར་དུ་བྱས་པ་ཕྱོགས་ཡིན་ཞེས་ལོག་པར་རྟོགས་པ་ཡོད་དོ་ཞེས་བྱ་བའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནིནི།",
    "དེ་ལ་སྟེ་གྲུབ་པའི་མཐའ་འདི་རྣམ་པར་གནས་པ་ནའོ།",
    "གསུངས་པ་ནི་ཕྱོགས་ཀྱི་སྒྲས་ཞེས་བྱ་བའོ།",
    "བསྒྲུབ་པར་བྱ་བ་རྟོགས་པའི་དུས་ན་ཡོད་པ་ནི་དངོས་པོ་ཡིན་ནོ།",
    "ཤུགས་ནི་ཁྱད་པར་ཅན་རྟོགས་པ་ནི་ཁྱད་པར་རྟོགས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བས་སོ།",
    "ཁྱད་པར་རྟོགས་པ་དེ་ཡང་ལྷག་པར་སྒྲོ་འདོགས་པའི་བདག་ཉིད་ཅན་སྔར་བསྟན་༤པ་ཉིད་དོ།",
    "འདོད་པ་རྗེས་སུ་གནང་བའི་མཚན་ཉིད་གང་ཡིན་སྙམ་ན།",
    "ཁྱེད་ལ་ཞེས་སྨོས་ཏེ་རིགས་པ་ཅན་ལ་སོགས་པ་ལ་ནི་དེ་མ་ཐག་པར་བརྗོད་པའི་དགོས་པ་དེ་ལྟར་མ་ཡིན་པའི་ཕྱིར་ཏེ་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "ངེས་པར་བཟུང་བ་དེས་བཟློག་པར་བྱ་བའོ།",
    "འོན་ཏེ་གྲུབ་པ་བསྒྲུབ་པར་བྱ་བ་ཡིན་པ་དགག་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཁོ་ནས་འཕངས་པ་ཡིན་པས་ངེས་པར་གཟུང་བ་འདིས་ཅི་བྱ་ཞེ་ན།",
    "འོན་ཏེ་མ་གྲུབ་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དམ་བཅའ་བ་ཉིད་ཡིན་པ་བཟློག་པའི་དོན་དུ་ངེས་པར་གཟུང་བ་ཡིན་ནོ་ཞེ་ན།",
    "གཏན་ཚིགས་སོགས་ཞེས་གསུངས་སོ།",
    "གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་ནི་བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་པ་ནི་གཏན་ཚིགས་སོ་ཞེས་བྱ་བའོ།",
    "སྒྲུབ་པར་བྱེད་པ་མ་གྲུབ་པ་ནི་སྒྲུབ་པར་བྱེད་པ་མེད་པ་ཉིད་དུ་དོགས་པ་མེད་པ་ཁོ་ནའོ།",
    "དེས་ན་མ་གྲུབ་པའི་སྒྲུབ་བྱེད་དམ་བཅའ་བ་ཡིན་པ་བསལ་བའི་དོན་དུ་ནི་ངེས་པར་གཟུང་བ་མ་ཡིན་ནོ།",
    "དེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཅི་ལྟར་ཡིན་ཞེ་ན།",
    "སྒྲུབ་པར་བྱེད་པས་ནི་ཞེས་བྱ་བའོ།",
    "དེར་ཞེས་བྱ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་མ་གྲུབ་པའོ།",
    "ཅི་ལྟར་སྤངས་སྙམ་ན་བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "སྔར་ངེས་པར་བཟུང་ན།",
    "མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅའ་བ་ཉིད་དོ་ཞེས་བྱ་བའི་ངག་ལས།",
    "ཕྱིས་ངེས་པར་གཟུང་བ་དེ་བརྗོད་པས་ཤུགས་ཀྱིས་ཁྱབ་པའི་འབྲས་ཅན་ཡིན་པར་རྟོགས་སོ།",
    "དེ་ཡ་ཡང་ཞེས་བྱ་བ་ནི་ཕྱིས་ངེས་པར་གཟུང་བའོ།",
    "གཞན་དུ་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་མཚན་ཉིད་གཞན་གྱིས་ཁྱབ་པ་ཡང་དམ་བཅའ་བ་ཡིན་པར་མ་གྱུར་ན་དེའི་ཚེ་ཕྱིས་ངེས་པར་གཟུང་བ་དོན་མེད་དོ།",
    "རྣམ་པར་བཅད་པར་བྱ་བ་མེད་པའི་ཕྱིར་རོ།",
    "སྒྲུབ་པར་བྱེད་ལ་དགོས་པའང་མེད།",
    "༡༢༣༥བཏབ་པར་བྱས་པ་ན།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བར་ཁས་ལེན་ན་དེ་ནི་མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ཡང་དམ་བཅའ་བར་ཁས་བླངས་པར་བྱ་དགོས་སོ།",
    "འོན་ཏེ་སྔར་ངེས་པར་བཟུང་བ་ཁས་ལེན་ན་ནི་དེའི་ཚེ་ངེས་པར་བཟུང་༤བ་དོན་མེད་པར་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་ཡང་གཏན་ཚིགས་ལ་སོགས་པས་ཁྱབ་པའི་ཕྱིར་རོ་ཞེས་མི་འདོད་པ་ཐོག་ཏུ་འགལ་བ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་དང་ཞེས་བྱ་བ་ཕྱིས་ངེས་པར་བཟུང་བ་ཡིན་དང་ངོ།",
    "དམ་བཅའ་བ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་ཡང་ངོ།",
    "སྒྲ་ནི་རྟག་སྟེ་ཐམས་ཅད་མི་རྟག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདིར་བརྗོད་པར་འདོད་པ་ནི།",
    "ོབསྒྲུབ་པར་བྱ་བ་མེད་པ་རྗེས་སུ་བརྗོད་ནས་སྒྲུབ་པར་བྱེད་པ་མེད་པ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེས་ན་མི་རྟག་པ་ནི་ཐམས་ཅད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པར་བྱ་བ་ལ།",
    "ལེགས་པར་མ་སྦྱངས་པ་ཁོ་ནའི་ཡིན་པས་མ་སྦྱངས་དག་ཅེས་བརྗོད་པ་ཡིན་ནོ།",
    "རྣམ་པར་འགྲེལ་པ་ནི་གཞན་དག་ཅེས་བྱ་བའོ།",
    "ོསྒྲུབ་པར་བྱེད་པའི་སྐྱོན་དུ་འགྱུར་བའི་གོ་སྐབས་མེད་པ་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐ་མི་དད་ཀྱང་ལོགས་སུ་བརྗོད་པར་འགྱུར་རོ་སྙམ་ན།",
    "དེས་ཀྱང་གཏན་ཚིགས་དང་ལྡན་པར་རྗོད་པར་བྱེད་ན།",
    "གལ་ཏེ་སྒྲ་ལ་མི་རྟག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་དང་ལྡན་པར་གྱུར་པས།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ཐམས་ཅད་མི་རྟག་པའི་ཕྱིར་རོ་ཞེས་རྗོད་པར་བྱེད་ན།",
    "འོན་ཏེ་སྒྲ་ཉིད་ལརྟག་པ་ཉིད་སྟོན་པར་བྱེད་པ་དེས་ན།",
    "སྒྲ་ཉིད་ལ་མི་རྟག་པ་ཉིད་སྟོན་པར་འགྱུར་རོ།",
    "མི་རྟག་པ་གཏན་ཚིགས་དང་ལྡན་པས་ཞེས་བྱ་བ་རིགས་པར་ཉེ་བར་བསྟན་པ་ཡིན་ནོ།",
    "ཅི་ལྟར་མི་རྟག་པ་ཉིད་སྟོན་པར་མི་འཐད་སྙམ་ན་འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "སྒྲའི་མཚན་ཉིད་ཁྱད་པར་ཏེ་ེམི་རྟག་པ་ཉིད་ཀྱི་སྤྱིས་ཁྱབ་པ་མ་ཡིན་ནོ།",
    "སྒྲ་རྟག་གོ་ཞེས་ཁྱད་པར་བརྗོད་པ་ནི་དམིགས་ཀྱིས་བསལ་བ་ཡིན་ལ།",
    "སྒྲ་ནི་སྤྱིས་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་གཉིས་པ་སྤྱི་དང་ཁྱད་པར་སྟོན་པར་བྱེད་པ་ཉིད་ཡིན་ཡང་སྤྱིར་བཏང་བ་དང་དམིགས་ཀྱིས་བསལ་བའི་བདག་ཉིད་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "སྒྲ་ལས་བྱུང་བའི་རིགས་པ་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི།",
    "སྒྲ་ཐམས་ཅད་ནི་སྒྲུབ་པ་དང་དགག་པའི་རྗེས་སུ་འཇུག་པར་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གནོད་པར་བྱ་བ་ཡང་ཨཎའི་རྐྱེན་གྱིས་བསྒྲུབས་པ་ཡིན་ལ།",
    "གནོད་པར་བྱེད་པ་ནི་ཨཱ་ཉེ་བར་བསྒྱུར་བ་དང་བྲལ་བ་ལས།",
    "ངེས་པ་ཡང་གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པ་ཞེས་རྗེས་སུ་འཇུག་གོ།",
    "འདིར་ལྷས་བྱིན་ཁོ་ནས་གནས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "གཞན་གནས་པ་ལ་གནོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "སྤྱི་དང་ཁྱད་པར་བརྗོད་པ་བདག་ཉིད་གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པའི་དངོས་པོར་འགྱུར་བ་ཡིན་ནོ།",
    "བྲམ་ཟེ་རྣམས་ལ་ཞོ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "གནོད་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་ཕྱིས་ཉེ་བར་ལེན་པ་ཡིན་ཏེ།",
    "དེས་ན་ཅི་ལྟར་སྒྲ་རྟག་པ་ཡིན་ཏེ་ཞེས་བྱ་བ་གནོད་པར་བྱེད་པ་དང་།",
    "༩༧ ༢༡༡༢༤བར་བླངས་པ་གནོད་པར་བྱ་བར་ཡང་ཅི་ལྟར་འགྱུར་སྙམ་ན།",
    "སྔར་གནོད་པར་བྱ་བ་ཞེས་བྱ་བ་ལས་ལ་ནི་ཨཎའོ་ཞེས་བྱ་བའོ།",
    "དེས་ན་སྒྲ་རྟག་སྟེ་ཞེས་བྱ་བ་གནོད་པར་བྱེད་པ་ནི་དང་པོ་ཡིན་ལ།",
    "ཕྱིས་ཀྱི་ཐམས་ཅད་མི་རྟག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གནོད་པར་བྱ་བ་ཡིན་ནོ།",
    "སྒྲའི་ཚུལ་འདི་ནི་འདིར་ཡང་ཡོད་པ་ཡིན་ནོ་ཞེས་སྟོན་པས་༧རྣམ་འགྲེལ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "ཕྱིར་དེ་ལྟར་གནོད་པར་བྱ་བ་དང་།",
    "གནོད་པར་བྱེད་པའི་དངོས་པོ་འཐད་ཀྱི།",
    "ཁྱད་པར་གྱིས་སྤྱི་ལ་གནོད་པ་ཞེས་བྱ་བ་འདི་ཉིད་ག་ལས་ཤེ་ྲན།",
    "དེའི་ཕྱིར་སྤྱི་རྗེས་སུ་འཇུག་པར་འགྱུར་བ་ན་ཁྱད་པར་སྒྲ་དེ་མི་རྟག་པ་ཉིད་སྤྱིས་ཁྱབ་པ་ཡིན་ནོ།",
    "སྤྱི་རྗེས་སུ་འཇུག་པ་ལའང་ཞེས་བྱ་བ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "གལ་ཏེ་ཁྱད་པར་ཁྱབ་པ་མ་ཡིན་ན།",
    "ཐམས་ཅད་མི་རྟག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཚིག་ཉིད་མི་འཐད་དོ་ཞེས་ནི་བརྗོད་པར་མི་བྱ་སྟེ།",
    "གལ་ཏེ་སྒྲ་ལ་མི་རྟག་པ་ཉིད་བསྟན་པར་བྱ་བ་ཡིན་ན།",
    "དེའི་ཚེ་སྒྲ་རྟག་སྟེ་ཐམས་ཅད་མི་རྟག་པའི་ཕྱིར་རོ་ཞེས་དོར་ལ་སྒྲ་ནི་རྟག་ཏེ་མི་རྟག་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པར་འགྱུར་རོ།",
    "ཁྱད་པར་དག་ནི་ཞེས་བྱ་བ་ནི་རྟག་པ་དང་མི་རྟག་པ་དག་གོ།",
    "སྦྱོར་བ་ནི་ཞེས་བྱ་བས་ནི་སྦྱོར་བ་བྱ་བའི་ཕྱིར་གཞན་སློབ་པར་བྱེད་པའོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་མི་རྟག་པར་གྱུར་པའི་ཕྱིར་རོ།",
    "འོ་ན་གཏན་ཚིགས་གང་ཡིན་སྙམ་པར་དོགས་པ་བསུ་བ་ནི།",
    "ཐམས་ཅད་མ་ཡིན་པར་རོ།",
    "སྤྱི་ནི་ཁྱད་པར་མི་སྤོང་བའི་ཕྱིར་རོ།",
    "སྤྱི་ནི་ཁྱད་པར་སྤོང་བ་མ་ཡིན་གྱི།",
    "འདིའི་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་རྟག་པའིའོ།",
    "ཁྱད་པར་རྣམས་༤ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ཁྲ་བོ་ནི་སེར་སྐྱ་སྤངས་ནས་གནས་ཀྱི་བ་ལང་ཉིད་ནི་ཁྱད་པར་སྤངས་ནས་གནས་པ་མ་ཡིན་ཏེ་ཁྱད་པར་གཅིག་དོར་ན་ཁྱད་པར་གཞན་ལ་ངེས་པའི་ཕྱིར་རོ།",
    "ཤིང་ཉིད་ངེས་པར་འགོག་པ་ཡིན་གྱི།",
    "དེ་བཞིན་དུ་ཐམས་ཅད་ཀྱི་སྒྲ་མཉན་པ་གཉི་ག་ཉིད་ལ་འཇུག་པ་འགོག་པ་ཡིན་༦པར་འགྱུར་རོ།",
    "སྒྲ་དེ་ཐམས་ཅད་མ་ཡིན་པར་མི་འགྱུར་རོ།",
    "ཁྱད་པར་ཀུན་སོ་སོར་སྒྲ་བཞིན་དུ་ཐམས་ཅད་མ་ཡིན་པར་གྱུར་ན།",
    "ཐམས་ཅད་དེ་མེད་འགྱུར་ཕྱིར་ཏེ་མི་སྲིད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེས་ན་སྤྱིའི་དངོས་པོས་ཀྱང་གཏན་ཚིགས་ཉིད་མ་ཡིན་ནོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "དཔེ་ལ་གཞན་གྱིས་ལོག་པར་རྟོགས་པའི་དོགས་པ་བསུ་བ་ནི།",
    "གཅོམ་ཉིད་ནི་སྒྲའི་རང་བཞིན་ཡིན་པས་དེ་མེད་ན་སྒྲ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "ཤེས་པར་བྱ་བ་ནི་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "མ་གྲུབ་ན་ནི་གཏན་ཚིགས་ཉིད་མ་གྲུབ་པར་འགྱུར་ཏེ།",
    "ཤེས་པར་བྱ་བའི་སྒྲ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "སྤྱི་དང་ཁྱད་པར་གྱི་ངོ་བོས་གཏན་ཚིགས་ཐ་དད་པར་འགྱུར་ཏེ།",
    "འོན་ཀྱང་རྣམ་པ་འདི་ནི་སྒྲ་ནི་མི་རྟག་སྟེ་གཅོམ་༤པའི་ཕྱིར་ཞེས་བྱ་བ་སྐབས་འདིར་བརྗོད་པར་འདོད་པ་མ་ཡིན་ཏེ།",
    "ཅིའི་ཕྱིར་བརྗོད་པར་མི་འདོད་སྙམ་ན།",
    "དུ་བ་ཡིན་པའི་ཕྱིར་དུ་བ་མེ་དང་ལྡན་པར་འགྱུར་བ་ཉིད་དོ་ཞེས་འབྲེལ་ཏོ།",
    "གལ་ཏེ་དེ་ལྟར་བྱེད་ན་སྤྱི་སྒྲུབ་པར་བྱེད་པའི་གཏན་ཚིགས་སུ་འགྱུར་བ་ཉིད་དོ།་",
    "མ་ངེས་པ་ཉིད་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་མི་མཐུན་པའི་ཕྱོགས་ལས་ལྡོག་པར་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཡང་བསྟན་པར་བྱ་བ་ཉིད་དང་ལྡན་པར་ཏེ་འབྲེལ་པར་མ་གྲུབ་པའོ།",
    "སྒྲ་ནི་མི་རྟག་སྟེ་སྒྲ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "༡༢༤༧ཞེས་བརྗོད་པར་བྱའོ།",
    "གལ་ཏེ་རྟག་པ་ཉིད་བསྒྲུབ་པར་ནུས་པ་ཡོད་པ་ཡིན་ན་དེའི་ཚེ་སྒྲ་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་གཞན་བླངས་པ་དོན་མེད་དོ།",
    "དེའི་རང་བཞིན་དུ་གྱུར་པའི་སྒྲུབ་པར་བྱེད་པ་ཡང་ནུས་པ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་བརྗོད་པར་འདོད་པ་གང་ཡིན་པ་སྒྲུབ་པར་བྱེད་པ་ལས་ཐ་དད་པའི་སྒྲ་མི་རྟག་པ་ཉིད་ཀྱི་ཁྱད་པར་དང་ལྡན་པར་བརྗོད་པ་འདོད་པ་དེ་འདིར་མེད་པའི་ཕྱིར་རོ།",
    "ཕམ་ཟིན་པ་ལ་ཏེ་མ་གྲུབ་པའི་ཉེས་པ་བརྗོད་པས་རྡུགས་པར་བྱས་ཟིན་པ་ལ།",
    "དེ་ལྟར་གྱུར་ན་ནི་ཐུག་པ་མེད་པས་རྩོད་པ་དག་རྫོགས་པའི་མཐའ་མེད་པར་འགྱུར་རོ།",
    "ཤེས་པར་བྱེད་པ་ཉིད་གང་ཡིན་པ་དེར་མ་གྲུབ་པའི་ཕྱིར་ཏེ་ཤེས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤེས་པར་བྱ་བ་ཡིན་ཡང་ཤེས་བྱེད་ཅི་སྟེ་མ་ཡིན་སྙམ་ན།",
    "དེ་བཞིན་དུ་ཤེས་པར་བྱེད་པ་ཡང་ཤེས་པར་བྱ་བ་ལས་ཐ་དད་པར་ཤེས་པར་གྱུར་ན་ཤེས་པར་བྱ་བ་ཤེས་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "ཤེས་པར་བྱ་བ་ནི་ཤེས་པར་བྱེད་པ་ལས་རང་བཞིན་ཐ་དད་པའི་ཕྱིར་རོ།",
    "དེའི་ཚེ་དེ་ལ་རྗེས་སུ་འགྲོ་བ་ཡོད་དམ་འོན་ཏེ་མེད་ཅེས་སེམས་པར་འགྱུར་ཏེ།",
    "སྔར་སྒྲུབ་པར་བྱེད་པའི་རང་བཞིན་གྲུབ་པར་བྱས་ནས།",
    "དངོས་པོ་ཀུན་ལ་བྱ་བ་སྟེ་སྒྲ་དང་བྱས་པ་ལ་སོགས་པ་ལའོ།",
    "འདིས་ནི་ཕྱོགས་སྔ་མའི་ཆ་རྣམ་པར་བཀྲོལ་བ་ཡིན་ནོ།",
    "ལན་གྱི་ཆ་རྣམ་པར་འགྲེལ་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཀུན་རྫོབ་ཏུ་སྒྲ་དང་བྱས་པ་དག་ཐ་དད་པའི་ཕྱིར་ཤེས་པར་བྱ་བ་དང་ཤེས་པར་བྱེད་པའི་དངོས་པོ་ཡིན་ན།",
    "སྒྲ་དང་བྱས་པ་དག་ལ་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ཐ་དད་པར་རྟོགས་པ་ཉིད་བརྗོད་པ་ནི།",
    "བརྗོད་པར་འདོད་པ་ནི་མར་མེའི་སྒྲས་བྱེད་པ་དང་བཅས་པའི་གནས་སྐབས་ཉིད་བརྗོད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ཡིན་ཏེ།",
    "ད་ནི་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་སྟོན་པར་བྱེད་པས།",
    "སྒྲུབ་པར་བྱེད་པ་ཡང་སྟོན་པ་ནི།",
    "དོན་བྱ་བ་༤བྱེད་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ལ།",
    "རང་བཞིན་ནི་བསྒྲུབ་པར་བྱ་བ་ཡིན་པའམ།",
    "རང་བཞིན་ནི་སྒྲུབ་པར་བྱེད་པ།",
    "དོན་བྱ་བ་བྱེད་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་རྣམས་ལྡོག་པའི་དབྱེ་བས་བརྟགས་པའི་ཐ་དད་པ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ཡིན་ནོ།",
    "བརྗོད་པར་འདོད་པའི་དོན་བྱ་བ་མེད་པས་བྱེད་པ་མེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རྩོད་པའོ།",
    "བརྗོད་པར་འདོད་པའི་དོན་ནི་མར་མེས་བསྒྲུབ་པར་བྱ་བའོ།",
    "དེ་སྐད་བརྗོད་པས་ནི་ཞེས་བྱ་བ་ནི་བྱེད་པ་དང་བཅས་པ་དང་ཅིག་ཤོས་ཉིད་ལ་སོགས་པ་བརྗོད་པས་ནིའོ་། ཐ་དད་པར་ཞེས་བྱ་བ་ནི་དོགས་པའོ།",
    "ལན་ནི་དེ་ནི་ཞེས་བྱ་བ་སྟེ་ཐ་དད་པར་རྟོགས་པ་ནིའོ།",
    "འབྲས་བུ་བྱེད་པའི་ཁྱད་པར་ནི་མར་མེ་ཡིན་ནོ།",
    "མར་མེ་ནི་ཁྱད་པར་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མར་མེས་རང་བཞིན་ཁྱད་པར་དུ་བྱེད་དེ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་ེཔར་བྱེད་པའི་དངོས་པོ་ལ་ཐ་དད་པ་ཉིད་ངེས་པ་ཡང་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་ཐ་དད་པ་ལ་ངེས་པ་ཡིན་ཏེ།",
    "ལོག་པར་རྟོགས་པ་ལ་ལྟོས་ནས་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་དངོས་པོ་ཡིན་ཡང་ཆད་པ་མེད་དེ།",
    "བྱས་པ་དང་མི་རྟག་པ་ཉིད་བཞིན་ནོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བའི་རྣམ་པར་འགྲེལ་པ་ནི།",
    "འོ་ན་བྱས་པ་དང་མི་རྟག་པ་ཉིད་ཅི་ལྟར་ཐ་དད་སྙམ་ན་བྱས་པ་དང་ཞེས་བྱ་བའོ།",
    "དོན་དམ་པར་ཐ་དད་པ་ཉིད་དུ་ཅི་སྟེ་ཁས་མི་ལེན་སྙམ་ན།",
    "མངོན་སུམ་གྱིས་ནི་བྱས་པ་ལ་སོགས་པ་ཐ་མི་དད་པར་འཛིན་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་དངོས་པོ་པའི་ཐ་དད་པ་ལ་གནོད་པར་བྱེད་པ་ཡིན་པ་དེས་ན།",
    "ཅི་ལྟར་དོན་དམ་པར་ཐ་དད་པར་འགྱུར་རོ།",
    "དོན་དམ་པར་ཐ་དད་པར་དོགས་པ་བསུ་བ་ནི།",
    "སྒྲ་འཛིན་པར་མི་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "དེ་ཡང་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མངོན་སུམ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཡིན་པར་བརྗོད་པ་ནི།",
    "མངོན་སུམ་མཁྲང་བོས་བསྟན་པའི་རྟག་པ་ནི་རྗེས་སུ་དཔག་༧པ་མི་རྟག་པར་དཔོག་པར་ེགནོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་ཁྱབ་པ་དེ་མ་བཟུང་ན་དེའི་ཚེ་མི་རྟག་པར་རིག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "རྣམ་པར་རྟོག་པ་དང་པོ་ཁས་ལེན་པར་དོགས་པ་ལ་ནི་དེ་ཉིད་ཀྱི་ཚེ་ཞེས་བྱ་བའོ།",
    "དམིགས་པར་བྱ་བ་ཉིད་དུ་ཡོད་དོ་ཞེ་ན།",
    "མ་རྟོགས་ན་ཞེས་གསུངས་ཏེ།",
    "བརྗོད་པ་གཞན་དུ་མེད་པའི་ཡུལ་གྱི་རྟོགས་པ་མེད་པར་འགྱུར་རོ།",
    "ཡང་ན་གཞན་དུ་མེད་པས་རྟོགས་པར་འགྱུར་ཞེས་བྱ་བ་སྟེ།",
    "གཏན་ཚིགས་མེད་པ་ཉིད་ཀྱིས་རྟོགས་པར་འགྱུར་ཏེ།",
    "མཐའ་གཉིས་ལ་རྗེས་སུ་དཔག་པར་བྱ་ནུས་པ་ཡིན་ཏེ།",
    "སྲོག་ཆགས་འདི་ནི་སྔོན་གཏོང་བ་བྱས་པ་ཡིན་ཏེ་བདེ་བར་གནས་པའི་ཕྱིར་རོ།",
    "འདིས་ནི་བསྟན་བཅོས་གོམས་པར་བྱས་པ་ཡིན་ཏེ།",
    "མཁས་པའི་ཕྱིར་རོ་ཞེས་དེ་ལྟར་མི་རྟག་པ་ཉིད་ཀྱི་ཕྱོགས་ལ་ནི་རྗེས་སུ་དཔག་པའི་འབྲས་བུ་དང་བཅས་པར་འགྱུར་གྱི།",
    "འདས་པ་དང་མ་འོངས་པའི་གནས་སྐབས་དག་ཀྱང་བཟུང་བའི་ཕྱིར་རྗེས་སུ་དཔག་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "སྔོན་དང་ཕྱི་མའི་མཐའ་གཉིས་རྗེས་སུ་དཔག་པར་ཡང་མི་འགྱུར་ཏེ།",
    "ཅིག་ཤོས་ནི་རྗེས་སུ་དཔག་པར་བྱའོ་། རྟག་པ་ེཉིད་ཀྱི་ཕྱོགས་ལ་ནི་རྗེས་སུ་དཔག་པ་དོན་མེད་པ་ཁོ་ནའོ་ཞེས་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "རྗེས་སུ་དཔག་པ་ཡང་མེད་པར་འགྱུར་ཏེ།",
    "དེས་ན་རྣམ་པར་རིག་ེཔ་ཙམ་འབའ་ཞིག་ཏུ་འགྱུར་རོ།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པར་ནི་བཟུང་བ་མ་ཡིན་ནོ་སྙམ་ན།",
    "རྟག་པ་དང་མི་རྟག་པ་ཉིད་སྤངས་ནས་སྒྲ་ཉིད་ལ་སོགས་པར་འཛིན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐོ་ཡོར་པོ་ཉིད་ལ་སོགས་པ་མེད་པར་ཡང་རོད་རོད་པོ་ཙམ་བལྟ་བར་ནུས་ཀྱི་རྟག་པ་ཉིད་ལ་སོགས་པ་དང་བྲལ་བའི་དོན་ནི་མ་ཡིན་ནོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "༡༢༥༩བཞིན་དུ་ཡུལ་ཁྱབ་པ་ཡང་གཞན་དུ་འཛིན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་རྩོད་པ་འགོད་པ་ནི།",
    "དུས་ཁྱབ་པའི་དོན་ལ་ཡང་ཁྱབ་པ་ཉིད་དུ་འཛིན་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "ཡན་ལག་ཅན་གྱི་རིང་པོ་དེ་ཡང་རྗེས་སུ་དཔག་པར་རྟོགས་པར་བྱ་བ་ཡིན་གྱི།",
    "མངོན་སུམ་གྱིས་རྟོགས་༤པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པས་རྟོགས་པར་བྱ་བ་ཉིད་གཞན་གྱི་ལུགས་ལ་གནས་ནས་བརྗོད་པ་ནི།",
    "ཐམས་ཅད་ཀྱང་གཡོ་བར་འགྱུར་བ་དེའི་ཕྱིར་དངོས་པོ་དེ་ནི་རིང་པོ་གཅིག་ཡིན་ནོ་ཞེས་རྟོགས་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དངོས་པོ་གཅིག་ཡིན་པར་མ་གྱུར་ན་ནི།",
    "དེ་ལྟར་གཞན་གྱི་ལུགས་ཀྱིས་རྗེས་སུ་དཔག་པ་བརྗོད་ནས་ཟློག་༧པར་བྱེད་པ་ནི།",
    "དཔེར་ན་སྔོན་པོའི་རང་བཞིན་དུ་ནི་སེར་པོ་ལ་སོགས་པ་མངོན་སུམ་གྱིས་ཡུལ་དུ་བྱེད་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་ཁྱབ་པ་༤ཡང་མ་ཁྱབ་པར་ཡུལ་དུ་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་པའི་སྲིད་པར་དོགས་པ་བསུ་བ་ནི།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་ནོན་པས་བྱས་པའི་འཇིག་པའོ།",
    "དུས་ཕྱིས་མ་དམིགས་པ་མ་གྲུབ་པར་དོགས་པ་བསུ་བ་ནི།",
    "གལ་ཏེ་མངོན་སུམ་གྱིས་དེ་མ་གྲུབ་ན་དྲན་པས་འགྲུབ་པར་འགྱུར་རོ་སྙམ་དུ་དོགས་པ་ནི།",
    "འོ་ན་མངོན་སུམ་གྱིས་དེ་འཛིན་པར་འགྱུར་རོ་སྙམ་ན།",
    "རང་བཞིན་ཉིད་ཡིན་ན་དེའི་ཚེ་ཀུན་རྫོབ་ཏུ་ཐ་དད་པར་ཅི་ལྟར་འགྱུར་ཏེ་དོན་དམ་པའི་ཐ་མི་དད་པ་ནི་བརྟགས་པའི་ཐ་དད་པར་འགལ་བའི་ཕྱིར་རོ།",
    "འགྱུར་ཡང་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་དངོས་པོར་ནི་མི་འཐད་དོ་ཞེས་བརྗོད་པ་ནི་ཉེར་༤ལེན་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་ལ་གནས་པའི་བྱས་པ་དང་མི་རྟག་པའི་རང་བཞིན་ནི།",
    "སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཞིང་བསྒྲུབ་པར་བྱ་བ་ཡང་མ་ཡིན་ནོ།",
    "ཉེར་ལེན་མེད་པར་སྟེ་དོན་དམ་པའི་ཐ་དད་པ་ནི་ཉེ་བར་ལེན་པ་དང་བྲལ་བས་སོ།",
    "༡༢༦༣བསྒྲུབ་བྱ་དང་སྒྲུབ་བྱེད་ཀྱི་རང་བཞིན་དུ་འགྱུར་རོ་སྙམ་དུ་དོགས་པ་བསུ་ནས་རྩོད་པར་བྱེད་པ་ཉིད་ཀྱིས་སྨྲས་པ་ནི།",
    "གོ་བར་བྱ་བ་དང་གོ་བར་བྱེད་པའི་དངོས་པོ་ནི་འབྲེལ་པ་ཡོད་པས་ཁྱབ་པ་ཡིན་ན་བརྟགས་པའི་རང་བཞིན་དག་ལ་ནི་འབྲེལ་བ་ཡོད་པ་མ་ཡིན་ཏེ་དེས་ན་དེ་དག་ནི་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་དངོས་པོ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མངོན་སུམ་རྣམ་པར་རྟོག་པ་དང་བཅས་པས་བ་ལང་ཉིད་ལ་སོགས་པ་ནི་སྤྱི་སྟོན་པར་བྱེད་ཀྱི།",
    "རྣམ་པར་རྟོག་པ་ཙམ་གྱིས་ནི་མ་ཡིན་ནོ།",
    "ོདངོས་པོ་མེད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་དོགས་པར་བྱེད་པ་ནི་རྣམ་རྟོག་བཅས་པ་མངོན་སུམ་ན།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡང་ནོག་དང་ལྐོག་ཤལ་ལ་སོགས་པ་ཐ་ན་སྣང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གསལ་བ་ལ་རྗེས་སུ་ཞུགས་པའི་སྤྱི་ཡོད་ན་ནི་དེའི་ཚེ་གསལ་བ་གཅིག་དང་པོ་མཐོང་བ་ན་ཡང་དམིགས་པར་གྱུར་པ་དེ་ལྟ་༤ན་ཡང་མ་ཡིན་ནོ།",
    "གསལ་བ་ཆབ་བྱར་གྱུར་པ་བཟུང་བ་མེད་པར་ནི་ཾགསལ་བ་ལ་ཁྱབ་པར་བྱེད་པའི་སྤྱི་འཛིན་པ་ཉིད་དུ་མི་འགྱུར་ཏེ།",
    "ཁྱབ་བྱ་མ་བཟུང་བར་ནི་དོན་དམ་པར་ན་ཁྱབ་བྱེད་ཀྱང་འཛིན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པ་དང་རྟོག་པ་མེད་པའོ།"
  ]
}