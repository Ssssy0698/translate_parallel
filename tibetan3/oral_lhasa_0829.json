    "བཅོམ་ལྡན་འདས་དེ་དག་ནི་ཚུལ་བཞིན་མ་ཡིན་པར་འཆི་བའི་དུས་བགྱིད་པར་བགྱིའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་སྤྲོ་བའི་སྦྱོར་བའི་དཔའ་བོའི་ཏིང་ངེ་འཛིན་གྱིས་དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་གཅིག་ཏུ་མཛད་དོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "སྡོམ་པ་དེང་ནས་བརྟན་པར་གཟུང་།",
    "སྡོམ་པ་ཐམས་ཅད་ལྡན་པར་ནི།",
    "༨༦༣༥༢ནས་མ་སྐྱེས་པ་ཉིད་དོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་སེམས་སོ་སོར་རིག་པའི་རྒྱལ་པོ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ།",
    "ཡང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་འཁོད་དེ་ཆེད་དུ་བརྗོད་པ་འདིས་ཆེད་དུ་བརྗོད་པ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ལ་གསོལ་བ་བཏབ་པ།",
    "མ་ལུས་ཤིང་ལུས་པ་མེད་པའི་འཇིག་རྟེན་གྱི་ཁམས་རབ་ཏུ་རྒྱས་པའི་ཚད་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཉིད་ཀྱི་ཐུགས་ཀར་ེཞུགས་པར་མཛད་དོ།",
    "ཞུགས་ནས་ཀྱང་གཅིག་ཏུ་མི་ཕྱེད་པར་གྱུར་ཏེ།",
    "ནམ་མཁའི་ཁམས་ཐམས་ཅད་རབ་ཏུ་རྒྱས་པའི་ཚུལ་དུ་རྣམ་པར་གནས་སོ།",
    "ཤིན་ཏུ་དྲི་མ་མེད་པ་ནམ་མཁའ་དང་མཚུངས་པའི་གཟུགས་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་སྤངས་པའི་མཆོག།",
    "གནས་ངན་ལེན་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བ།",
    "གཅིག་ཏུ་མི་ཕྱེད་པར་གྱུར་པ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་ཉིད་དུ་བསམ་པར་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སེམས་དཔའ་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ།",
    "ནམ་མཁའི་ཁམས་ཐམས་ཅད་རབ་ཏུ་རྒྱས་པའི་ཚད་ཀྱི་རྡོ་རྗེ་འབར་བས་རྣམ་པར་བརྒྱན་པ།",
    "ཞལ་ཅུང་ཟད་བཞད་པར་སྔགས་པས་བསམ་པར་བྱའོ།",
    "དེ་དག་ལ་སོགས་པའི་ཡོན་ཏན་གྱིས་ཁྱད་པར་དུ་འཕགས་པའི་ཁང་པ་བརྩེགས་པ་སྔགས་པས་བསམ་པར་བྱའོ།",
    "དེ་ནས་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་དུ་བྱས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བསྐྱེད་པ་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "སྟེང་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་བཞུགས་པ།",
    "དེ་ལྟ་བུའི་ཡོན་ཏན་གྱི་ཁྱད་པར་དང་ལྡན་པ་རྡོ་རྗེ་སེམས་དཔའི་གཟུགས་སུ་བསྒོམ་ིཔར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔའི་གཟུགས་སུ་མཐོང་ལགས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེ་ནས་རྡོ་རྗེ་དབབ་པ་བསྐྱེད་ནས་སེམས་དཔའ་རྡོ་རྗེ་བཅིངས་ལ་དམ་ཚིག་བསྒྲག་པར་བྱ་སྟེ།",
    "དེ་ནས་དམ་ཚིག་བྱིན་ལ་ཡི་གེ་བརྒྱ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རྡོ་རྗེ་མེ་ཏོག་སྤྱི་བོར་སྔགས་འདིས་གཞག་པར་བྱ་སྟེ།",
    "དེ་ནས་ནམ་མཁའི་དཀྱིལ་ན་བཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་།",
    "དེ་ནས་ཕེག་རྡོབ་གསུམ་དང་སེ་གོལ་གདབ་པར་བྱ་སྟེ།",
    "དེ་ནས་རྡོ་རྗེ་སེམས་དཔའ་རང་ཉིད་དམ་དེ་བཞིན་གཤེགས་པ་སྟོན་པར་མཛད་དོ།",
    "དེ་ནས་བརྟན་པར་བྱ་བའི་ཕྱིར་བརྗོད་པ།",
    "དེ་ནས་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་དེ་ཁོ་ན་ཉིད་དབབ་པ་བསྐྱེད་པར་བྱ་སྟེ།",
    "དེ་ནས་བདག་ལ་རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་བརྗོད་པར་བྱ་སྟེ།",
    "སླར་ཡང་ཡི་གེ་བརྒྱ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་ཡང་དེ་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའི་ཚུལ་དུ་ལག་པ་གཡོན་པར་དྲིལ་བུ།",
    "བསྒོམ་ེཔའི་རིམ་པ་དེས་རྡོ་རྗེ་སེམས་དཔའ་ཉིད་དམ་དེ་བཞིན་གཤེགས་པ་ཉིད་ཐོབ་པར་འགྱུར་རོ།",
    "༣༥༩བའི་དཀྱིལ་འཁོར་དེ་ལ་བཞུགས་ནས་དཔའ་བོའི་ཏིང་ངེ་འཛིན་ལ་ཞུགས་ཏེ།",
    "དེ་ནས་དེའི་རྗེས་སུ་དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་ཀྱིས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ཐོག་མ་དང་ཐ་མ་མེད་པ་ལ་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་འདིས་གསོལ་བ་བཏབ་པར་གྱུར་ཏོ།",
    "ཚུལ་ཆེན་པོ་ནི་རྣམ་པར་སྤྲོས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་འབྱུང་གནས་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་རྡོ་རྗེ་དབྱིངས་ཞེས་བྱ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་མཆོག་འདི་བཀའ་སྩལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོ།",
    "པས་བཅོམ་ལྡན་འདས་ཐོག་མ་དང་ཐ་མ་མེད་པ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ལ་གསོལ་བ་བཏབ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "འོན་ཏེ་གསང་བའི་ཚུལ་གྱིས་ལགས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་ིམཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "གསང་བ་དེའི་རང་བཞིན་གང་ལགས།",
    "བཅོམ་ལྡན་འདས་གསང་བ་དེའི་རང་བཞིན་མ་འཚལ་བས་ཅི་ཞིག་ལགས།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "ཤེས་རབ་ཀྱི་ཁྱད་པར་གྱིས་བདག་ཉིད་གསང་བ་བསྙེན་པ་བརྩམ་པར་བྱའོ།",
    "༣༦༣མའི་ཐིགས་པ་འོད་ཟེར་དང་བཅས་པར་གྱུར་པ་དང་།",
    "བཅོམ་ལྡན་འདས་དེ་ལྟ་ནའང་གསང་བ་དེ་བསྟེན་པ་ཉིད་ཇི་ལྟ་བུའི་རྣམ་པས་འགྲུབ་པ་ལགས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་བདག་སྔགས་པ་མ་ལགས་པ་གསང་བའི་བདག་པོ་མ་ལགས་པས་བཅོམ་ལྡན་འདས་ཇི་ལྟར་གསང་བ་དང་ིསྔགས་རྣམས་ཀྱི་བདག་པོར་འགྱུར་བ་དེ་ལྟར་མཛད་དུ་གསོལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དགུག་པ་ལ་སོགས་པ་རྣམས་བསྒྲུབ་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཐོག་མར་བསྒྲུབ་ིཔར་བགྱི་བ་གང་ལགས།",
    "ཡང་ན་རལ་གྲི་ལ་སོགས་པ་བསྒྲུབ་པར་བགྱི།",
    "བཅོམ་སེམས་དཔའ་ཆེན་པོ་ལག་ན་རྡོ་རྗེ་ལ་ལེགས་སོ་ཞེས་གནང་བ།",
    "སྔགས་རྣམས་ཀྱིས་མཉེས་པའི་སྦྱོར་བས་དེ་རྣམས་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་དེ་སྐད་ཅེས་བཀའ་སྩལ་ནས་གཅིག་ཏུ་འདྲེས་པར་གྱུར་ཏེ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཏིང་ངེ་འཛིན་གྱིས་རྡོ་རྗེ་ཧཱུྃ་མཛད་དེ་དང་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "རྡོ་རྗེ་གནྡྷ་རི་འདི་ཁྲོ་བོའི་ཚུལ་གྱིས་བསྒྲུབ་པར་བྱའོ།",
    "ལག་ན་རྡོ་རྗེ་སྔགས་པ་དེས་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱི་ཚུལ་དུ་གནས་ནས་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་སྔགས་བརྗོད་པར་བྱའོ།",
    "ཅེས་ལན་གསུམ་བརྗོད་ལ་དེ་ནས་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་རྡོ་རྗེ་ཆེན་པོ་ཁྲོ་བོ་རྡོ་རྗེ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ།",
    "ཁྲོ་བོའི་ཚུལ་གྱིས་གདུག་པ་ཐམས་ཅད་འཇོམས་པར་བྱེད་དོ།",
    "ཐམས་ཅད་སྐྲོད་པར་བྱེད་དོ།",
    "ལག་ན་རྡོ་རྗེ་དེའི་ཕྱིར་སྔགས་པས་ཚུལ་འདིས་བཟླས་པར་བྱ།",
    "བཀླག་པར་བྱའོ།",
    "ལག་ན་རྡོ་རྗེ་དེའི་ཕྱིར་འདི་བཟླས་པ་ཙམ་གྱིས་དགུག་པར་མི་ནུས་པའི་རི་བོ་ལ་སོགས་པ་རྣམས་ཀྱང་འགུགས་པར་བྱེད་དོ།",
    "དེ་ནས་འགྲུབ་པར་འགྱུར་རོ།",
    "མཐེའུ་ཆུང་འོག་ཏུ་བསྟན་ཏེ་ནོར་བུའི་རྣམ་པར་བྱས་པའི་ཕྱག་རྒྱ་འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱི་དམ་ཚིག་སྦྱིན་པའོ།",
    "མིང་མེད་གདོང་ནི་ལེགས་པར་སྦྱར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "ཁྲོ་བོའི་ལྟ་སྟངས་ཀྱིས་གང་ལ་བལྟས་པ་དེ་བསྐྱོད་པར་འགྱུར་རོ།",
    "༨༦སེམས་དཔའ་རྣམས་དང་ང་ལྟ་བུ་ཡང་སྐྱོད་པར་བྱེད་དོ།",
    "ཅུང་ཟད་བསྒྲུབས་པ་དེ་ཐམས་ཅད་གདོན་མི་ཟ་བར་འགྲུབ་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་ལག་ན་རྡོ་རྗེ་ལ་བཀའ་སྩལ་པ།",
    "གལ་ཏེ་དེ་རྣམས་ཀྱིས་གྲུབ་ཀྱང་ཚེ་འདིར་རྒྱལ་པོའི་ལོངས་སྤྱོད་ལ་སོགས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "ལེགས་པར་ལྡན་པ་གང་དུ་ཡང་མི་གནས་པར་འགྲོ་བས་ནི་རྣམ་པར་སྣང་མཛད་ཉིད་དམ།",
    "༣༧༣ཕྱིན་པར་རིག་པར་བྱའོ།",
    "རྩ་གཅིག་ལས་འཛག་པ་དང་ལྡན་པར་རྣམ་པར་བསམ་པར་བྱའོ།",
    "ཞུ་བ་དམར་པོ་དེ་ལས་བདག་ཉིད་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་གཟུགས་སུ་རྣམ་པར་བསམ་པར་བྱའོ།",
    "ཐོགས་པ་མེད་པར་འགྲོ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་གསོད་པར་འདོད་ན་དེ་ནས་དེའི་རྩ་ཁ་དོག་ནག་པོ་སོལ་བའི་རྣམ་པ་ལྟ་བུར་བསམས་ལ།",
