    "ཁྱོད་ཀྱིས་ཕ་ལས་ཆུང་ཟད་ཅི་ཐོབ།",
    "བུ་ཁྱོད་དེས་བསླུས་ཏེ་ལམ་གྱི་ཚེགས་ཕྱུང་བར་ཟད་ཀྱི་ཆུང་ཟད་ཀྱང་མ་རྙེད་དོ།",
    "དེས་དེ་ལྟར་ཚིགས་བཅད་ཀྱི་དོན་དཔྱད་ནས་མུན་ཚབ་ཚུབ་ཙམ་ན་དུར་ཁྲོད་དུ་སོང་སྟེ་དེའི་ཉེ་འཁོར་དུ་དེས་བལྟས་ན་ཤིང་རྟ་རྣ་ཞིག་ཡོད་པ་དེའི་ཤར་གྱི་ངོས་སུ་གཉའ་ཤིང་གང་གཅལ་ཏེ་བརྐོས་པ་དང་།",
    "བདག་གིས་ཀྱང་མར་བཏུང་ངོ་སྙམ་ནས་དེས་འཚོ་བྱེད་ལ་དྲིས་པ།",
    "ཁྱོད་ཀྱིས་ནི་འཇུ་བར་མི་ནུས་སོ།",
    "ཀུན་ཏུ་བཅོམ་ལྡན་འདས་ཀྱི་བདེན་པའི་གསུང་གིས་ལྷ་སྦྱིན་ཚོར་བ་དྲག་པོས་ཉེན་པས་སྲོག་དང་འབྲལ་བ་ན་སོས་པར་མཛད་དོ།",
    "ལྷ་སྦྱིན་ཁྱོད་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་སོས་པར་མཛད་ཀྱི་གཞན་དུ་ན་སྲོག་དང་བྲལ་བར་འགྱུར་རོ།",
    "ལྷ་སྦྱིན་ཁས་རླབས་དེ་ཐོང་ལ་རང་གི་སེམས་གཏན་ལ་ཕོབ་ཤིག།",
    "ཁྱོད་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གསོས་སོ།",
    "བྱས་པ་མི་ཚོར་བ་ལ་གཟིགས།",
    "ཨ་མྲ་དང་ནི་ཤིང་སྟ་མོ།",
    "དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བར་བལ་གླང་མོ་ཞིག་ཕྲུ་གུ་བྱུང་སྟེ།",
    "རེ་ཞིག་ཅིག་ན་དྲང་སྲོང་དེ་བསྟི་གནས་ནས་བྱུང་ནས་བསྟི་གནས་ཀྱི་ཉེ་འཁོར་གྱི་ཕྱོགས་སུ་ལྟ་ཞིང་སོང་བ་ལས་ཇི་ཙམ་ན་གླང་པོ་ཆེའི་ཕྲུ་གུ་གསར་དུ་བྱུང་མ་ཐག་པ་མ་དང་བྲལ་བ་དེ་མཐོང་ངོ།",
    "གང་གི་ཚེ་གནས་ཐམས་ཅད་ན་མི་སྣང་བ་དེའི་ཚེ་དེ་ཁྱེར་ནས་བསྟི་གནས་སུ་ཞུགས་ཏེ།",
    "དེ་གང་གི་ཚེ་ཆེན་པོར་གྱུར་པ་དེའི་ཚེ་དྲང་སྲོང་དེའི་བསྟི་གནས་སུ་གནོད་པ་བྱེད་དེ་མེ་ཏོག་གི་ཤིང་རྣམས་འབྱིན་པར་བྱེད།",
    "གང་གི་ཚེ་འདོད་ཆགས་སྐྱེས་པར་གྱུར་པ་དེའི་ཚེ་བསྡིགས་ཀྱང་བརྙས་ཐབས་བྱེད་དོ།",
    "སྐྱེ་བོ་ངན་བསྟེན་ཁྱོད་ལ་ཅི་ཞིག་དགོས།",
    "དེའི་བཙུན་མོ་ཟླ་འོད་མ་ཞེས་བྱ་བ་རྨི་ལམ་རྣོ་བ་ཡིན་ཏེ།",
    "གང་གིས་དེ་མཐོང་ན་དེ་རྟོག་ཅིང་དེ་ཉིད་དུ་སྡོད་པར་བྱེད་དོ།",
    "ཀྱེ་ཞང་པོ་ཁྱོད་ཅིའི་ཕྱིར་འདི་ལྟར་འཚེར་ཞིང་སྐྲག་པས་སྤྱོད།",
    "ཚ་བོ་བདག་གི་ལུས་སྐལ་བ་དང་ལྡན་པ་འདི་ལ་འཇིག་རྟེན་ཐམས་ཅད་འདོད་པ་སྐྱེད་པས་ཁོ་བོ་འཇིག་རྟེན་གྱིས་འཇིགས་ཤིང་རྔོན་པས་འཚེར་ཞིང་སྐྲག་པས་སྤྱོད་དོ།",
    "བདག་གིས་ནི་ཁྱོད་ཉིན་པར་བསྲུང་ངོ།",
    "ཁྱོད་ཀྱིས་ནི་བདག་མཚན་མོ་སྲུངས་ཤིག་ཅེས་དེ་གཉིས་ཀྱིས་དེ་ལྟར་དམ་བཅས་ནས་གནས་སོ།",
    "གང་གིས་དེ་རིང་བདག་གི་སྲོག།",
    "བདག་གིས་དེ་ཡི་དྲན་བྱ་ཞིང་།",
    "དེ་ཡི་གོར་རེ་ལོང་ཡང་བྱ།",
    "འབབ་ཆུའི་འགྲམ་དུ་ཉེ་བར་སོང་ངོ།",
    "བུ་ལམ་འདི་ནས་ཅི་དགའ་བར་སོང་ཤིག།",
    "དེ་ནས་མི་དེས་ཐལ་མོ་སྦྱར་ཏེ།",
    "ཁྱོད་ཀྱིས་བདག་གི་སྲོག་གང་ལགས།",
    "ཡབ་གཅིག་ཁྱོད་ཀྱི་འབངས་བདག་སྟེ།",
    "དེ་བཞིན་གོ་རེ་ལོང་ཡང་བགྱི།",
    "དེང་ཁྱོད་བདག་གི་བྲན་དང་ནི།",
    "གོ་རེ་ལོང་ཡང་མ་བྱེད་པར།",
    "པགས་པའི་ཕྱིར་ནི་བསད་འོང་གིས།",
    "ཁྱོད་ཀྱིས་བདག་གཞན་མ་བསྟན་ཅིག།",
    "འདོད་པར་བྱ་བ་ཡིན་པས་ཁྱོད་ཀྱིས་ཁོ་བོ་སུ་ལ་ཡང་མ་བསྟན་དང་།",
    "རི་དགས་ཀྱི་དཔོན་པོ་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ཏེ་རྐང་པ་ལ་གཏུགས་ནས་སོང་ངོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་བཙུན་མོ་ཟླ་འོད་མ་རྩེད་མོས་དུབ་ནས་མལ་ཆེན་པོར་ལེགས་པར་གཉིད་ལོག་པ་ལས་མཚན་མོའི་ཐུན་ཐ་མ་ལ་རྨི་ལམ་དུ་རི་དགས་ཀྱི་དཔོན་པོ་གཟུགས་མཆོག་ཏུ་སྡུག་པ་ཞིག་སེང་གེའི་ཁྲི་ལ་འདུག་ནས།",
    "དེ་ནས་བཙུན་མོ་ཟླ་འོད་མས་དགའ་བ་དང་།",
    "གཡེར་བག་གི་གཏམ་དང་ལྡན་པའི་ཀུན་དུ་སྤྱོད་པས་རྒྱལ་པོ་ཡུད་ཙམ་ཞིག་དགའ་བར་བྱས་ནས་སྨྲས་པ།",
    "ངའི་ཡུལ་ན་རྔོན་པ་གནས་པ་རྣམས་འདིར་ཁུག་ཅིག་ཅེས་བྱུང་གིས་ཁྱོད་ཀྱིས་རྔོན་པ་ཐམས་ཅད་འདིར་ཐོང་ཤིག།",
    "ལྷ་བདག་ཅག་ནི་འདི་ཉིད་ཀྱིས་འཚོ་བ་ལགས་པས་བདག་ཅག་གིས་དུས་འདི་ཙམ་གྱི་བར་དུ་ལྷའི་ཡུལ་དུ་བརྒྱུས་པ་ལས་རི་དགས་ཀྱི་དཔོན་པོ་མཆོག་འདི་ལྟ་བུ་ནི་སྔོན་ཆད་ལན་འགའ་ཡང་མ་ཐོས་ན་མཐོང་བ་ལྟ་ཅི་སྨོས།",
    "ལྷ་གཅིག་ནས་གཅིག་ཏུ་སྨྲས་ཏེ་ཕྱོགས་ག་གེ་མོ་ཞིག་ན་མཆིས་སོ་ཞེས་གསན་ནས་བདག་ཅག་ལ་བཀའ་སྩལ་པའི་རིགས་སོ།",
    "དེ་ལྟ་ན་བདག་ཅག་གིས་ཀྱང་ལྷའི་བཀའ་སྩལ་པ་ངེས་པར་འགྲུབ་པར་མཆིའོ།",
    "ཅི་རེ་ཞིག་འཁོར་རྗེས་སུ་བསྐྱང་བར་བྱ་འམ།",
    "བྱས་པ་གཟོ་བ་རེ་ཞིག་ཞོག།",
    "རེ་ཞིག་དེ་ལ་ཤ་གླན་པར་བྱའོ་སྙམ་ནས།",
    "ལྷ་ཕྱོགས་ག་གེ་མོ་ཞིག་ན་ཞུགས་ཤིང་སྣ་ཚོགས་ཀྱི་ནགས་བྱ་དང་རི་དགས་འདྲིས་པས་མཛེས་པར་བགྱིས་པ་ན་རི་དགས་ཀྱི་དཔོན་པོ་གསེར་གྱི་གློ་ཞེས་བགྱི་བ་རི་དགས་ཀྱི་ཚོགས་སྟོང་ཕྲག་དུ་མས་ཡོངས་སུ་བསྐོར་ཅིང་མཆིས་ཏེ།",
    "བདག་གིས་ལྷ་ལ་རི་དགས་དམ་པ་གཟུགས་མཆོག་ཏུ་སྡུག་པ་དེ་བསྟན་པར་བགྱིའོ།",
    "རི་དགས་ཀྱི་རྒྱལ་པོ་ཁྱོད་ལ་བདག་གིས་སྔར་མི་རྣམས་ནི་ཕན་པ་བྱས་པ་མི་སེམས་ཤིང་བྱས་པ་མི་གཟོ་ལ་བྱས་པ་མི་ཚོར་བ་ཡིན་ནོ་ཞེས་སྨྲས་པ་ཡིན་ཏེ།",
    "ཇི་ལྟར་ཁྱོད་ཀྱིས་ལུས་འདི་གསང་བ་བས།",
    "གྱོ་མོ་རྣམས་བསལ་ཅིང་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ།",
    "མཐུ་ཆེན་པོས་བཙུན་མོ་དང་།",
    "དེའི་མེ་ཏོག་གི་རབ་ཆུའི་ཕ་རོལ་ན་ཡོད་པས་དེ་ཉི་མ་རེ་རེ་ཞིང་ཆུ་རྒལ་ཞིང་མེ་ཏོག་ཐུའོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་ཆུ་རྒལ་བ་ན་དུས་ཚིགས་མ་ཡིན་པའི་ཨ་མྲའི་འབྲས་བུ་ཆུས་ཁྱེར་བ་ཞིག་མཐོང་ནས་དེས་དེ་བླངས་ཏེ་སྒོ་བ་ལ་བྱིན་ནོ།",
    "རྒྱལ་པོས་བཙུན་མོ་ལའོ།",
    "བཙུན་མོས་དེ་མྱངས་པ་ན་རོལ་ཞེན་ནས་རྒྱལ་པོ་ལ་གསོལ་བ་བཏབ་པ།",
    "ཁྱོད་ཀྱིས་ཨ་མྲའི་འབྲས་བུ་སུ་ལས་འོངས།",
    "ཀྭའི་མེ་ཏོག་ཕྲེང་རྒྱུད་མཁན་ཁྱོད་ཀྱིས་ཨ་མྲའི་འབྲས་བུ་འདི་ག་ལས་རྙེད།",
    "དེས་རྒྱགས་ཁྱེར་ནས་ཐོག་མ་ཨ་མྲ་རྙེད་པ་ལོགས་སུ་སོང་བ་དང་།",
    "རིའི་ཕྱོགས་གཅིག་ན་ཨ་མྲའི་ཤིང་སྤྲེའུ་རྣམས་ཀྱི་བགྲོད་པར་གྱུར་གྱི་མི་རྣམས་ཀྱི་ནི་མ་ཡིན་པ་དེ་མཐོང་ནས།",
    "དེ་དེ་ན་ཨ་མྲའི་འབྲས་བུ་འདོད་པའི་ཕྱིར་ཞག་མང་དུ་ལོན་པས་རྒྱགས་ཟད་པར་གྱུར་ཏོ།",
    "བདག་འདི་བཞིན་འདུག་ན་ཡང་རྒྱགས་མེད་པས་འཆིར་ཆབས་གཅིག་གིས་ཅི་བྱུང་བ་བྱུང་གཟེག་གོ་ཞེས་དེས་རྡོ་བ་རྣམས་ལ་འཇུས་ཏེ་འཛེག་པར་བརྩམས་པ་ལས་ཨ་མྲའི་འབྲས་བུ་མ་ཐོབ་པར་གཡང་དུ་ལྷུང་ངོ།",
    "གང་གི་ཚེ་བདག་གིས་དབྱུང་བར་ནུས་སོ་སྙམ་དུ་རིག་པ་དེའི་ཚེ་དེས་དེ་གཡང་ས་ནས་རིམ་གྱིས་ཕྱུང་བ་དང་།",
    "ཁྱོད་ཅིའི་ཕྱིར་ཉམ་ང་བ་འདི་ལྟ་བུ་དང་ལྡན་པར་གྱུར།",
    "འདི་ཨ་མྲའི་འབྲས་བུ་མེད་པར་སོང་ན་གནོད་པ་འཐོབ་པར་འགྱུར་གྱི།",
    "བདག་གིས་འདི་ལ་ཨ་མྲའི་འབྲས་བུ་སྦྱིན་ནོ་སྙམ་ནས་བདག་ཉིད་ཆེན་པོ་དེ་སྤྲོ་བ་དང་གཞན་ལ་ཕན་པར་བྱ་བ་ལ་བརྩོན་པ་མ་བོར་བས་དུབ་བཞིན་དུ་ཡང་ཤིང་དེ་ལ་འཛེགས་ནས་ཨ་མྲའི་འབྲས་བུ་ཀླག་པར་བརྩམས་ཏེ།",
    "མི་དེ་ཇི་ཙམ་འདོད་ཀྱི་བར་དུ་ཨ་མྲའི་འབྲས་བུ་ཟར་བཅུག་ནས་ཐུ་བ་ཡང་བཀང་ངོ།",
    "ཀྭའི་ནང་རྗེ་ཁོ་བོ་དུབ་པས་ཡུད་ཙམ་ཞིག་ཉལ་གྱིས་རེ་ཞིག་ཕྱོགས་སུ་བྱར་གྱིས་ཤིག།",
    "བདག་རྒྱགས་ཆད་པས་གལ་ཏེ་ཨ་མྲ་རྣམས་ཟོས་ན་ནི་བདག་གིས་རྒྱལ་པོ་ལ་ཡང་ཅི་དབུལ་དེ་བས་ན་སྤྲེའུ་འདི་བསད་ལ་ཤ་སྐམ་དུ་བྱས་ཏེ་ལམ་དུ་འཇུག་གོ་སྙམ་ནས།",
    "བྱ་ཤིང་སྟ་མོ་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "ཁྱོད་སྡུག་བསྔལ་ཅི་ལྟ་བུ་ཞིག་གིས།",
    "ཞང་པོ་ཁྱོད་ལ་བདག་གིས་དཔྱད་བྱས་ཁྱོད་ནི་སེང་གེ་ཡིན་ཏེ་རྐང་བཞི་བ་ཐམས་ཅད་ཀྱི་དཔོན་པོ་ཡིན་པས་ཕན་གདགས་པར་ནུས་ཀྱིས་ཁྱོད་ཀྱིས་བདག་ལ་དུས་དུས་སུ་ཕན་པ་བྱོས་ཤིག།",
    "ཤིང་སྟ་མོས་བསམས་པ།",
    "ཇི་ལྟར་འདིས་བྱེད་པ་ཡང་མ་ཚོར་བ་དེ་ལྟར་འདིའི་དཔྱད་བྱས་ནས་སོས་ནས་ཤེས་པར་འགྱུར་བར་བྱའོ་སྙམ་མོ།",
    "དེ་ནས་ཤིང་སྟ་མོ་དེ་རི་དགས་ཀྱི་དཔོན་པོ་དེའི་དྲུང་དུ་སོང་ན་དེ་ལྟར་བསོད་པར་གནས་པར་མཐོང་ནས་དེས་བསམས་པ།",
    "འདིའི་དཔྱད་བྱ་བའི་དུས་དེ་ལ་བབ་བོ་སྙམ་དུ་རིག་ནས་ལེགས་པར་བརྟགས་ཏེ་སོའི་བར་དུ་ཆུད་པའི་རུས་པ་འདབ་མས་བསྐྱོད་པའི་རིམ་པས་མོད་ལ་ཕྱུང་སྟེ་སྐྱེས་ཤིང་གཉིད་ཀྱི་སྙོམས་པ་བསལ་བའི་མིག་གིས་ལངས་ནས་འདུག་གོ།",
    "དེ་ནས་ཤིང་སྟ་མོ་དེས་རི་དགས་ཀྱི་དཔོན་པོ་དེ་སྡུག་བསྔལ་དང་།",
    "ཡིད་མི་བདེ་བ་དང་བྲལ་བར་རིག་ནས་རབ་ཏུ་དགའ་བའི་ཡིད་ཀྱིས་དེའི་དྲུང་དུ་སོང་སྟེ་སྨྲས་པ།",
    "ཞང་པོ་ཁྱོད་ཀྱི་སྡུག་བསྔལ་གྱི་རྒྱུར་གྱུར་པ་ནི་རུས་པ་འདི་ཡིན་ནོ།",
    "ཚ་བོ་ཕན་པ་འདིའི་ལན་ཁྱོད་ལ་བདག་གིས་ངེས་པར་སླར་ཕན་པ་བྱས་དུས་དུས་སུ་ཤོག་ཤིག།",
