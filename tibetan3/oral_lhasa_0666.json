    "གཉིད་དང་རྨུགསཔ་མེད་པས་གཡེལ་བ་མེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཞེས་བྱ་བལ་སོགས་པ་གསུངས་ཏེ།",
    "འོ་ན་ཇི་ལྟརསྐྱོ་བའི་བློ་བསྐྱེད་པར་མི་བྱ་ཞེ་ན།",
    "ཡང་དག་པར་ཞུགས་པ་ཉིད་ལ་བདུད།",
    "གནོད་པ་བྱེད་པར་འགྱུར་བ་བསྟན་པའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱབ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཐོས་ནས་བྱ་བར་མི་ནུསཔ་ལ་སོགས་པས་སྐྱོ་བའི་བློ་སྐྱེད་པར་བྱེད་ཅིང་།",
    "འོ་ན་དེས་བློ་ཇི་ལྟ་བུབསྐྱེདཔར་བྱ་ཞེ་ན།",
    "ཇི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདྲེན་པ་ནི་བཅོམ་ལྡནའདས་དང་འབྲེལ་པར་ཤེས་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "འགྲོ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པགསུངས་ཏེ།",
    "ཇི་ལྟར་དགེབའི་བཤེས་གཉེན་ཚོལ་བ་ལ་སོགས་པ་ལ་ཞུགས་པས་གོམས་པར་བྱསཔ་སྟེ།",
    "གཞན་དུ་ཡང་དག་པར་འདོད་པའི་དོན་གྲུབ་པར་མི་འགྱུརཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པགསུངས་ཏེ།",
    "བཟོད་ལ་ཞེས་བྱ་བལ་སོགས་པ་གསུངས་ཏེ།",
    "མཚན་སུམ་ཅུ་རྩ་གཉིསཀྱིས་ལུས་རྣམ་པར་བརྒྱན་པའི་ཕྱིར་སུམ་ཅུ་རྩ་གཉིས་མཚན་དངམཐུ་སྟོབས་སོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཟོད་པ་དང་བཅས་པར་གྱུར་པས་སེམས་བསྐྱེདདེ།",
    "གཞན་གྱིས་གནོད་པ་བྱས་པ་ལ་སོགས་པལ་དམིགསཔ་ཅན་གྱིས་ཡང་དེ་ལ་བཟོད་པར་བྱ་བ་བསྟན་པའི་ཕྱིར་བཟོདབྱེད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅིའི་ཕྱིར་གྱི་སྒྲས་འཕངས་པ་བྲྗོད་པར་བྱ་བའི་ཕྱིརསྨོས་ཀྱང་ཅི་དགོས་ཞེས་དེ་ལྟར་སྙམ་པའོ།",
    "ཤེས་རབ་ཀྱི་སྟོབསཀྱིས་གཞན་གནོད་པ་བྱེད་པ་ལ་རྣམ་པར་དཔྱད་པར་འགྱུར་ཞེས་བྱབར་དགོངས་སོ།",
    "དེ་ཉིད་བསྟན་པའིཕྱིར་ལྕག་དབྱུག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་ཇི་སྙེད་འཕགས་པར་འགྱུར་བ་སྡོམ་པའི་བྱེད་པཡིན་པའི་ཕྱིར་སྡོམ་པའི་བྱ་བའོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་འདྲེན་པས་གསུངས་སོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ཉན་ཐོས་ལ་སོགས་པར་སེམས་བསྐྱེདཅིང་འདོད་པ་དང་བཅས་པར་གྱུར།",
    "དེ་བས་ན་དེ་ལྟར་འཇུགཔར་བྱའོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པགསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་དངོས་པོརདམིགས་པར་མི་བྱའོ།",
    "གང་ལཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱི་རོལ་གྱིདངོས་པོ་ཡོངས་སུ་གཏོང་བ་མེད་པར་ཇི་ལྟར་ན་ཐམས་ཅད་གཏོང་བཡིན་ཞེ་ན།",
    "དོན་དམ་པརརང་བཞིན་དང་བྲལ་བའི་ཕྱིར་བདག་མེད་པར་ཡང་ཤེས་ནས།",
    "བདག་ཏུ་ཞེས་བྱ་བ་ལ་སོགསཔ་གསུངས་ཏེ།",
    "ཡང་དེ་ཉིད་ཀྱི་ཕྱིརཇི་སྐད་བསྟན་པ་ཉིད་ཀྱི་སྦྱིན་པ་ལ་འཇུག་པར་བྱའོ་ཞེས་བྱབར་གནས་སོ།",
    "དེ་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུང་ལ་སོགས་པའི་ཚདམ་དང་ལྡན་པ་ཉིད་ཀྱིས་འབྲས་བུ་དང་བཅས་པས་ཐམས་ཅད་གཏོངཞིང་རྟག་ཏུ་ལྷུག་པར་གཏོང་བ་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "འཁོར་གསུམ་རྣམ་པར་དག་པ་དང་ལྡནཔར་བྱིན་ནས་དེ་བཞིན་དུ་དགའ་བར་ཏེ་ཡིད་བདེ་བ་ཐོབ་པར་འགྱུརགྱི།",
    "སྦྱིན་པ་བྱིན་ནསཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྦྱིན་པར་བྱེད་པ་དང་།",
    "ལེན་པ་པོ་མི་དམིགས་པ་གང་ཡིན་པ་དེ་ནི་དངོས་པོ་ལགནས་པར་བྱེད་པ་མེད་དོ།",
    "དེ་ལྟར་འབྲསབུ་དང་བཅས་པར་རང་ལ་ཇི་སྙེད་བདོག་པ་གཏོང་བར་འགྱུར་བ་ནིམཁས་པ་ཐམས་ཅད་སྟོང་པ་སྟེ་ཆུང་དུ་བཏང་བ་ལ་ཡང་ཐབསལ་མཁས་པའི་སྟོབས་ཀྱིས་གྲངས་མེད་དཔག་ཏུ་མེད་པ་སྟེ་ཡོངས་སུབཅད་པར་མི་ནུས་པའི་ཕྱིར་དཔག་ཏུ་མེད་པའི་རྣམ་པར་སྨིན་པཐོབ་པ་འགྱུར་རོ་ཞེ་བྱ་བ་ནི་ལྷག་མའོ།",
    "གང་སེརསྣ་ཚར་བཅད་པ་དང་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཞིན་དུརྗེས་སུ་ཡི་རང་བ་སྔོན་དུ་འགྲོ་བས་ཡོངས་སུ་བསྔོ་བ་ལ་གོམསཔར་བྱའོ་ཞེ་བསྟན་པའི་ཕྱིར།",
    "སྲིད་པ་ཞེས་བྱ་བ་ལ་སོགས་པགསུངས་ཏེ།",
    "རང་རྒྱལ་དགྲ་བཅོམ་ལ་བསྐལཔ་མཐའ་ཡས་པར་སྦྱིན་པ་བྱིན།",
    "ཇི་སྐད་བསྟན་པའི་ཡོངས་སུ་བསྔོབས་ཡོངས་སུ་སྔོ་བར་བྱེད་པཇི་ལྟ་བ་བཞིན་དུ་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "ནོར་བུ་ཞེས་བྱ་བལ་སོགས་པ་གསུངས་ཏེ།",
    "གལཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བུའི་གདམས་ངག་ཐོབ་པལ་སེམས་བསྐྱེད་པ་ལ་སོགས་པའི་རིམ་གྱིས་རབ་ཏུ་དགའ་བ་ལ་སོགསཔའི་ས་ཐོབ་པས་སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལགཙོ་ཆེརལྷག་པར་བྱ་བ་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡིས་མི་ཉིད་ལ་སོགས་པ་དལ་འབྱོར་ཁྱདཔར་ཅན་གྱི་དོན་བྱེད་པ་རྟག་ཏུ་རྙེད་དོ།",
    "སྦྱངས་དཀའབ་ལ་གནས་པས་ནི་རྣམ་པར་གཡེང་བ་ཐམས་ཅད་སྤངས་པའིབསམ་གཏན་གྱིས་ནི་འདོད་པའི་ཡོན་ཏན་རྣམ་པར་གཡེང་བའི་རྒྱུར་གྱུར་པས་ཉེས་པའི་རྣམ་པ་ཅན་ཡིན་པའི་ཕྱིརསྨད་པ་རྣམ་པ་ཐམས་ཅད་ཡོངས་སུ་འདོར་བར་བྱེད་ཅིང་།",
    "ཁྱདཔར་ཅན་གྱི་བདེན་པ་རྟོགས་པ་དང་།",
    "དཔའ་བར་འགྲོབ་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་མངོནཔར་སྒྲུབ་པའོ།",
    "བྱ་ཞེས་བྱ་བ་ནི་འཕགས་པ་ཀུན་དགའབོ་ལ་སོགས་པ་ལ་ཡོངས་སུ་གཏོད་པ་ཡིན་པར་རྟོགས་པར་བྱ་སྟེ།",
    "མཉམ་པར་གཞག་པའི་ཕྱག་རྒྱ་བཅས་ལ།",
    "ལེའུ་ལ་སོགས་པའིདབྱེ་བ་ལ་རྗེས་སུ་སྤྱོད་པའི་སེམས་ཀྱིས་རྣམ་པར་དཔྱད་དེ།",
    "སྐུར་བ་འདེབས་པ་མེད་པརདཔྱོད་པ་དང་།",
    "དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དོན་རྣམ་པབཞིར་རྣམ་པར་དཔྱད་དེ།",
    "ཡི་གེ་ཡང་སིལ་བུ་དང་བསྡུས་པའི་རིམཔ་ཇི་ལྟ་བ་བཞིན་དུ་དོན་མེད་པ་དང་དོན་དང་བཅས་པ་ཉིདཀྱིས་རྣམ་པ་དེ་གཉིས་ལ་རྣམ་པར་དཔྱོད་པའི་ཕྱིར་རྣམཔར་དཔྱོད་པའི་སེམས་སོ།",
    "དེའི་ཚེ་རྣམ་པར་དཔྱད་པའི་རྒྱུམཚན་གྱིས་འདི་ཉིད་བདེན་གྱི་གཞན་ནི་རྨོངས་པའོ་ཞེས་ངེསཔར་འཛིན་པའི་སེམས་ཀྱིས་ངེས་པར་བཟུང་ནས།",
    "ཇི་ལྟ་བ་བཞིནགྱི་རྣམ་པར་དཔྱད་པ་ཉིད་ཀྱི་དོན་མཚན་མ་ལ་དམིགས་པ་རྩབའི་སེམས་སུ་བསྡུས་པའི་སེམས་ཀྱིས་བཅུག་ནས།",
    "ཡང་དེ་བཞིན་དུ་རངབཞིན་གྱིས་འོད་གསལ་བའི་རྣམ་པར་གྲོལ་བའི་སྒོའི་ཏིང་ངེའཛིན་ཏོ།",
    "སྐྱོན་དྲུག་པོ་དེ་དགགནས་སྐབས་ཇི་ལྟ་བས་སྐྱེས་པ་ན་དེའི་གཉེན་པོ་འདུ་བྱེདབརྒྱད་ཇི་ལྟ་བ་བཞིན་དུ་བསྟེན་པར་བྱ་སྟེ།",
    "ལུས་དང་སེམས་ཤིན་ཏུསྦྱངས་པས་ལེ་ལོ་ལྡོག་པར་འགྱུར་རོ།",
    "ཡངདག་པར་སྐྱོ་བའི་དངོས་པོ་མི་རྟག་པ་ལ་སོགས་པ་ཡིད་ལ་བྱེདཔ་ལ་སོགས་པས་རྒོད་པ་སྤོང་བརའགྱུར་རོ།",
    "བྱིང་རྒོད་ཞི་བར་བྱེད་པའི་དུས་སུ་མི་རྩོལ་ནཡང་སྐྱོན་ཡིན་པས་སེམས་པ་ལ་གོམས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ཐུནམཚམས་བཞིར་བསྒྲུབ་པར་བྱའོ།",
    "གཏི་མུག་མུན་ནག་སྨག་ནི་མ་ལུས་བསལ་བའི་མགོན་པོས་མཁྱེན་ནསགསུངས་པ་ཡི།",
    "དེས་ནི་ཡོན་ཏན་རིན་ཆེན་བསྡུསལྡན་འདི་ནི་འགྲོ་བས་མྱུར་དུ་ཐོབཔར་ཤོག།",
    "རྫོགས་ལརྟོགས་པར་སླ་བ་ཡིན།",
    "བརྒྱ་ཡིས་འདི་ལྷག་ཤེས་པར་བྱ།",
    "ཡོན་ཏན་རིནཔོ་ཆེ་སྡུད་པ་ཚིགས་སུ་བཅད་པའི་དཀའ་འགྲེལ་རྟོགས་པར་སླབཞེས་བྱ་བ།",
    "དེའི་རྒྱན་ཚིག་ལེའུར་བྱས་པདང་།",
    "ཡང་དག་རྟེན་ནས་རྣམ་པར་བཀྲོལ།",
    "རྣམ་པར་གྲོལ་བ་ཞེས་བྱས་ཀྱང་།",
    "དེས་བྱས་བྱས་པ་མིན་མཐོང་ནས།",
    "བསྟན་བཅོས་མཐའ་དག་མ་རྙེད་པར།",
    "དེ་ལྟར་མཁས་པས་སྣང་བྱསཤིང་།",
    "འཕགས་པ་བྱམས་པ་རང་ཉིད་དམཔའི་སྤྱོད་པ་དང་མཐུན་པར་རབ་ཏུ་སྟོན་པས།",
    "པོ་ཆེ་ཕུལ་དུ་དབྱུང་དུ་མེད་ཅིང་དཔག་ཏུ་མེད་པའིའབྱུང་གནས་ལ་དོན་གྱིས་འཇུག་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་དང་བབསྐྱེད་པའི་ཆེད་དུ།",
    "འགྲོ་ལཕན་པར་བྱེད་རྣམས་ལམ་ཤེས་ཉིད་ཀྱིས་འཇིག་རྟེན་དོན་སྒྲུབམཛད་པ་གང་།",
    "གང་དང་ཡང་དག་ལྡན་པས་ཐུབ་རྣམས་རྣམ་པཀུན་ལྡན་སྣ་ཚོགས་འདི་གསུངས་པ།",
    "ཞེས་བྱ་བ་གསུངསསོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་གསུམ་གྱི་བདག་ཉིད་ཚུལ་གསུམ་པ་ཅན།",
    "སངསརྒྱས་ལ་སོགས་པ་བསྐྲུན་པར་མཛད་པ་ནི་གདོན་མི་ཟ་བར་སྲིད་པཉིད་དེ་ཞེས་ངེས་པར་གཟུང་སྟེ།",
    "དེ་ལ་རབ་ཏུ་དང་བ་སྐྱེདཔར་བྱེད་པ་ཉིད་དོ།",
    "དེ་ནས་ཐོས་པ་ལས་བྱུང་བ་ལ་སོགས་པའི་ཤེས་པ་སྐྱེ་བའིརིམ་གྱིས་ལེགས་པའི་མཆོག་འཐོབ་པར་འགྱུར་རོ།",
    "དེལ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱིས་ནི་དོན་བརྒྱ་བསྡུས་ལ་དེདག་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་ཞིང་དེས་ཀྱངའཆད་པར་འགྱུར་བའི་ཚུལ་གྱིས་དོན་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པཡིན་ནོ་ཞེས་དེ་ལྟར་ཐུགས་ལ་བཞག་ནས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱི་སྒོ་ནསཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསྟོད་དོ།",
    "མྱ་ངན་ལས་འདའ་བར་འདོདཔ་རྣམས་གཞི་ཐམས་ཅད་སྐྱེ་བ་མེད་པར་ཡོངས་སུ་ཤེས་པ་ཉིདཀྱིས་ཕུང་པོ་དང་བཅས་པ་དང་ཕུང་པོ་མེད་པའི་མཚན་ཉིདཀྱིས་མྱ་ངན་ལས་འདས་པ་རྣམ་པ་གཉིས་ཐོབ་པར་མཛད་པ་གངཡིན་པ་དང་།",
    "རྣམ་པཐམས་ཅད་སྐྱེ་བ་མེད་པར་ཐུགས་སུ་ཆུད་པ་གང་དང་ལྡན་ན།",
    "རྒྱས་པལས་ཀྱང་རྒྱ་ཆེར་གསུངསསོ།",
    "དགོས་པ་དང་དགོས་པའི་ཡང་དགོས་པ་དང་འབྲེལ་པ་ཁོང་ན་ཡོདཔ་རྣམས་གསུངས་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་ལམ།",
    "བཅོམ་ལྡན་འདས་ཆོ་འཕྲུལ་རྣམ་པ་གསུམ་གྱིས་འགྲོབ་མཐའ་དག་ལ་རྗེས་སུ་སྟོན་པར་མཛད་པ་དེ་ཉིད་ཀྱིས་རྒྱལབའི་ཡུམ་རྣམ་པ་གསུམ་ཅར་ལས་བྲྗོད་པར་བྱ་བ་ཉིད་དུ་བསྟན་པགང་ཡིན་པ།"
