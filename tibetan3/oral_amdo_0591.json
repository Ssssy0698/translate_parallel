    "སྐུ་ལ་སོགས་པའི་ཆ་ཤས་རེ་རེ་ལ་ཡང་རྡོ་རྗེ་འབར་བས་ཏེ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཉིད་སྐུའི་ཆ་དེ་དང་དེའི་རྣམ་པར་ཤར་བ་ཡིན་པས།",
    "རྗེས་འཇུག་གི་ཉམས་ལེན་ལ་སྦྱར་ན།",
    "རྡོ་རྗེ་སྟེ་རྣམ་རྟོག་གིས་མི་ཕྱེད་པའི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་དེ་ཉིད་ཡུལ་དེ་ཁོ་ན་ཉིད་ལ་གཉིས་སྣང་ཕྲ་མོས་ཀྱང་བར་མ་ཆོད་པར་རོ་མཉམ་དུ་གྱུར་པའི་ཚུལ་གྱིས་འབེབས་པ་དང་།",
    "གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་རལ་གྲིས་ཉོན་མོངས་མ་ལུས་གཅོད་ཅིང་།",
    "རྡོ་རྗེ་གཅིག་པུ་ལས་རྒྱ་ལ་བརྟེན་པའི་བདེ་བས་གཡུལ་སེལ་བ་རྡོ་རྗེ་གཏུམ་མོ་འབར་བ་དང་།",
    "མིག་མི་བཟང་ནི་ཕྱག་རྒྱའི་ལྷ་མོ་དང་གཏུམ་མོའི་མེ་སྤྱི་བོར་སོན་པ་སྐྲ་ཡང་རྡོ་རྗེ་འབར་བ་དང་།",
    "སེན་མོ་སྐྱེས་པ་རྡོ་རྗེའི་རྩེ་མོར་གྱུར་པ་དང་ལྡན་ལ།",
    "སེན་མོ་དཀར་དམར་འདྲེས་པ་ལས།",
    "དེ་དག་རེ་རེས་ཀྱང་ལྟ་བ་དང་མཉན་པ་སོགས་བྱ་བ་ཐམས་ཅད་བྱེད་ནུས་སུ་འཇོག་པ་ཡིན་ནོ།",
    "ཕྱི་ནང་གི་སྐྱེ་མཆེད་དྲུག་མི་འགྱུར་བའི་བདེ་བའི་ངོ་བོར་དབྱེར་མི་ཕྱེད་པས་རྡོ་རྗེའི་སྒྲ་སྟེ་དེ་ལྟ་བུར་བྱས་པ་དང་།",
    "འཇིག་རྟེན་གསུམ་ན་ཡོད་པའི་བརྟན་གཡོའི་དངོས་པོ་ཐམས་ཅད་སྒྲ་གཅིག་པ་སྟེ་བདེ་སྟོང་གི་ཡེ་ཤེས་དེའི་རྣམ་རོལ་དུ་འཆར་བར་རྒྱས་འདེབས་ལ།",
    "འོག་གི་རྩ་བཞི་དྲི་ཆེན་དང་།",
    "རྣམ་དཔྱོད་ལང་ཚོ་ངོམས་པ་བཞིན།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "ནང་གི་བདག་ཉིད་ཅན་གྱི་རིག་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་མ་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཕྱག་རྒྱ་ཆེན་མོའི་ཡེ་ཤེས་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའི་གཟུགས་ཞེས་ཀྱང་བྱའོ།",
    "དེ་དག་གིས་སྤྲོས་པའི་ཡིད་གྲངས་མེད་པའི་སྤྲུལ་པའི་སྐུ་འཇིག་རྟེན་གྱི་ཁམས་མ་ལུས་པར་འཆང་བའམ་སྟོན་པར་མཛད་པ་ལའོ།",
    "དེ་ལྟར་གསུང་བ་ལ་མི་འཇིགས་པ་བཞི་བརྙེས་པས་བདུད་དང་མུ་སྟེགས་སོགས་ཀྱིས་ཚུགས་པ་མེད་ཅིང་ཚོགས་གཉིས་རླབས་པོ་ཆེའི་མཐུ་ལས་སྟོང་གསུམ་ཐམས་ཅད་དུ་ཆེ་བར་གྲགས་པ་དང་།",
    "སྡ་གུ་གཏུམ་མོའི་ན་ཆུང་ལ།",
    "དེ་ཉིད་ལ་མིང་གི་རྣམ་གྲངས་ཀྱང་།",
    "དེ་ལྟར་ཉིན་མཚན་གྱི་རྣལ་འབྱོར་གཉིས་ཀྱིས་རོ་རྐྱང་གི་རྒྱུ་བ་དྷཱཏཱིར་བཀག་པ་ལས་གཉུག་མའི་སེམས་མངོན་དུ་གྱུར་ཏེ།",
    "དེ་ལ་ལྡོག་པས་ཕྱེ་བས་ཡེ་ཤེས་ལྔ་རྒྱན་དུ་ཐོགས་པ་སྟེ་རང་གི་བདག་ཉིད་དུ་ཐོབ་པར་གྱུར་པའོ།",
    "རྩ་བ་དང་ཉེ་བའི་ཉོན་མོངས་པའི་དྲི་མ་བག་ཆགས་དང་བཅས་པ་ཀུན་ལས་འདས་པ་སྟེ་སྤངས་པ་དང་།",
    "ཇི་ལྟ་བ་གཟིགས་པའི་མཉམ་གཞག་གི་དོད་དུས་གསུམ་གྱི་དུས་རང་བཞིན་མེད་པར་རྟོགས་པ་༡ ༢ ༣ ༤ ༥ ༦ བསྐྱར་བསྡུར་ཞུ་ཡུལ་དཀར་མཛེས་དཔར་མ་དང་།",
    "རྣམས་གང་གིས་བོད་པར།",
    "ཉོན་མོངས་ཀུན་ལས་ཞེས་པ་ནི།",
    "རྩོལ་བ་མེད་པར་ངང་གིས་གྲོལ།",
    "ཤིང་ཐགས་བསྲེགས་པའི་ཐལ་ཕུང་བཞིན།",
    "ཉན་རང་གཉིས་དང་ཐེག་ཆེན་གྱི་རྣམ་གྲོལ་གསུམ་ཐོབ་པའི་ལམ་རང་རང་གི་རིགས་ཅན་གྱི་གདུལ་བྱ་ལ་སྟོན་པ་ལ་མཁས་པའོ།",
    "ཤིང་བསྲེགས་ཐལ་བའི་ཕུང་པོ་བཞིན།",
    "ཀརྐ་སེང་གེ་བུ་མོ་སྲང་།",
    "པདྨར་རྡོ་རྗེ་བཅུག་པས་མཆོག་དགའི་སྐད་ཅིག་སྟེ་ངག་གི་དམ་ཚིག་གོ།",
    "དགའ་བ་ཟད་པ་ལས་པདྨར་རྡོ་རྗེ་ཞུགས་པས་མཆོག་ཏུ་དགའ་བའི་སྐད་ཅིག་མར་འགྱུར་ཏེ་དེ་ཉིད་གསུང་གི་དམ་ཚིག་གོ།",
    "བཀྲ་ཤིས་པ་ཀུན་གྱི་ནང་ནས་ཀྱང་མིའི་རྟེན་མངལ་སྐྱེས་ཁམས་དྲུག་ལྡན་ཞིག་གིས་བཀྲ་ཤིས་པ་སྟེ་དང་པོར་ཚོགས་ལམ་དང་།",
    "དེ་ནས་ཀྱང་ཟག་མེད་ཀྱི་དགའ་བ་ཆེན་པོའི་རོལ་མོ་ཆེན་པོ་སྟེ་དེས་ཐ་མལ་པའི་བཞི་པའི་གནས་སྐབས་བསྐྱེད་པའི་ཐིག་ལེ་སྒྲིབ་བྲལ་དུ་བྱེད་པ་དང་།",
    "དེ་ལྟ་བུ་ནི་བྲམ་ཟེ་སྟེ་ཉོན་མོངས་པས་མ་གོས་པས་གཙང་བ་དང་།",
    "ཉོན་མོངས་པ་བག་ཆགས་དང་བཅས་པ་སྤངས་པས་ཚངས་པ་ཚངས་པ་ཞེས་པ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱི་གནས་སྐབས་དང་མཐར་ཐུག་གི་བདེ་བ་བསྒྲུབ་པ་དང་།",
    "དེ་ཡང་དག་པ་གཉིས་དང་ལྡན་པ་ལས་རང་བཞིན་རྣམ་དག་གི་ཁྱད་པར་ནི།",
    "རང་གི་རང་བཞིན་རྡུལ་མེད་པས་དྲི་མ་མ་ཞུགས་པའོ།",
    "སྲིད་མཐའ་ལ་མི་གནས་པའི་ཤེས་རབ་མི་འགྱུར་བའི་ཡེ་ཤེས་གཉིས་ཐབས་ཤེས་ངོ་བོ་དབྱེར་མེད་པའི་བདག་ཉིད་ཡིན་གྱིས་ཐབས་ཤེས་ཕྱོགས་རེ་བའི་རིགས་སུ་ཆད་པ་མེད་ལ།",
    "རེ་དོགས་ཀུན་དང་བྲལ་བ་འོ།",
    "མཆོག་གི་གསུང་ནི་གསུང་དག་པའོ།",
    "ཉོན་མོངས་རྣམ་དག་མཚུངས་པ་མེད།",
    "ལག་ན་འཛིན་པས་ཏེ་ཉམས་སུ་བླངས་པས་འོད་འབར་བ་སྟེ་ཡུལ་སྣང་ཐམས་ཅད་བདེ་སྟོང་གི་རོལ་པར་འཆར་བར་བྱེད་པ་སོགས་སུ་འཆད་དོ།",
    "དེ་ལྟ་བུའི་རྣམ་པ་ཅན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རྡོ་རྗེ་འཆང་གིས་མི་འགྱུར་བའི་བདེ་སྟོང་གི་ངོ་བོར་གཅིག་ཏུ་མཛད་པ་ལས།",
    "འགྲོ་བ་རིགས་དྲུག་གི་ཁམས་ན་གདུགས་གཅིག་ཡངས་པ་སྟེ།",
    "དེ་ཉིད་དཔའ་བོ་དཔའ་མོ་ནི་སུམ་ཅུ་རྩ་བདུན་རྣམ་པར་དག།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་ནི་གསང་གནས་ན་རྩ་སུམ་ཅུ་ལྕགས་སྒྲོག་གིས་བཅིངས་པ་ལྟ་བུ་དང་།",
    "དཔལ་ལྡན་ནི་བདེ་སྟོང་གི་ཡེ་ཤེས་ཡིན་ལ་ཤེས་རབ་མའི་པདྨ་ལས་སྐྱེས་པ་དང་།",
    "རྡོ་རྗེ་རྣོན་པོ་རལ་གྲི་ཆེ་སྟེ་བདེ་ཆེན་དེས་གཉིས་སྣང་གི་རྣམ་རྟོག་གཅོད་པ་དང་།",
    "དེ་མན་ཆད་གོང་གི་རིགས་པ་སྦྱར་རོ།་",
    "དྲི་མེད་འོད་དེ་སྒྲིབ་བྲལ་དུ་གྱུར་པ་དེའི་ཚེ་ཕྱི་ནང་གི་ཉི་མའི་དཀྱིལ་འཁོར་སྒྲིབ་བྲལ་དུ་འགྱུར་བས་རྡོ་རྗེ་ཉི་མ་སྣང་བ་ཆེ་དང་།",
    "ཕྱི་ནང་གི་ཟླ་བའི་འཕེལ་ཟད་ཀྱི་ཆ་སྒྲིབ་བྲལ་དུ་གྱུར་པ་ལས་རྡོ་རྗེ་ཟླ་བ་དྲི་མེད་འོད་ཅེས་བྱའོ།",
    "ཆགས་པ་དཀར་ཕྱོགས་ཀྱི་ཆ་བཅོ་ལྔ་ཡོངས་སུ་རྫོགས་པའི་དབུས་བཅུ་དྲུག་པ་འབའ་ཞིག་གིས་གནས་སྐབས་ལ་གནས་པའི་མཆོག་ཏུ་མི་འགྱུར་བའི་ཡེ་ཤེས་ནི་ཆགས་པ་ཆེན་པོའོ།",
    "ཡེ་ཤེས་དེ་དང་བདག་ཉིད་གཅིག་པའི་སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོ་ནི་ཁ་དོག་སྣ་ཚོགས་པ་འབར་བའི་འོད་ཅན་ནོ།",
    "གཞུང་འདི་དག་གིས་སྦྱོར་བ་ཡན་ལག་དྲུག་བསྒོམས་པ་ལས་བྱུང་བའི་ཉིན་རྟགས་རྣམས་ཀྱང་སྟོན་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེ་སྟེ་མཚན་འཛིན་གྱིས་མི་ཕྱེད་པས་ཟབ་མོ་སྟོང་པ་ཉིད་རྟོགས་པའི་མཆོག་ཏུ་མི་འགྱུར་བའི་ཡེ་ཤེས་དེ་ནི་ཛིནཛིཀ་སྟེ་གཉིས་སྣང་གཅོད་ཅིང་དེ་ལས་རྒྱལ་བ་དང་།",
    "ཡེ་ཤེས་སེམས་དཔའ་དྲུག་གི་སྐུ་ནི་མ་ལུས་པའི་བདག་ཉིད་མི་འགྱུར་བའི་བདེ་བ་ཆེན་པོ་རང་གི་ངོ་བོར་འཆང་ཞིང་།",
    "༥ རྩེ་མོའི་བར་གྱི་གནས་དྲུག་ཏུ་ཕུང་པོ་དང་བོད་པར།",
    "དེའི་ཐུགས་ཀར་འཁོར་ལོ་རྩིབས་བརྒྱད་ལ་ཨོཝགིཤཱརཡཏེནམདང་།",
    "རྐང་མཐེབ་ཀྱི་སེན་མོས་མནན་པས་གཏུམ་མོ་འབར་བ་ལས་དྷཱཏཱིའི་ནང་ནས་ཁམས་བ་མོ་འཛག་པ་ལས་བདེ་ཆེན་བསྐྱེད་པའོ་ཞེས་འཆད་དོ།",
    "སྟོན་ཀའི་ཟླ་བའི་འོད་དེ་བྱང་སེམས་དཀར་པོ་སྤྱི་བོར་གནས་པ་ཉི་མ་འཆར་ཀའི་དཀྱིལ་ལྟར་མཛེས་པས་ཏེ་གཏུམ་མོ་འབར་བས་བྱང་སེམས་ཞུ་བ་སེན་མོའི་འོད་ནི་ཤས་ཆེར་དམར་ཏེ་ཁམས་དཀར་དམར་གྱི་འདུ་འཕྲོད་དང་།",
