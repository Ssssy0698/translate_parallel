    "ཡང་ན་གཉིས་ཀར་ལྷ་བ་བརྡར་བྲད་བྱས་ལ་གསོན་དང་སྤྱད།",
    "ལེགས་པར་བརྟགས་ལ་སོ་སོའི་སྐྱོན་དང་དབྲལཏེ་དེའི་རྒྱུ་གསུམ་ནི།",
    "ཡང་ན་ལྷ་རྩ་ཤོར་བས་མར་གྱིས་བསྲེག་ཡང་ན་ཤ་རུས་སྐྱོན་རྒྱུ་ཆེར་ཡོད་པས་ཤ་ཤུན་དབྱེརུས་པ་མཐའ་ཆོད་པར།",
    "མགོ་ལུས་ཐམས་ཅད་ཆུ་ཆགས་བྱས་ཏེ་གན་རྐྱལ་ཉལ་བ་ལ།",
    "ཞེས་གསུངས་སོ།",
    "ཀྱེ་སྟོན་པ་དྲང་སྲོང་རིག་པའི་ཡེ་ཤེས་ལགས།",
    "དྲང་སྲོང་རིག་པའི་ཡེ་ཤེས་ཀྱིས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "དེ་ཕྱིར་མགོ་དང་བྱང་ཁོག་ཡན་ལག་གསུམ་ག་འདུས་པར་འགྱུར་པ་སྐྱེ་ཡི་བཅོས་ཐབས་བསྟན།",
    "རྩ་དེ་ཆོད་པར་མ་གྱུར་ན་བཅོས་གླག་ཡོད།",
    "དེ་ཆོད་ཁྲག་མི་ཆོད་དེ་ཁྲག་མ་བཅད་པར་བཞག་ན་འབོག་ནས་འཆི།",
    "གཤགས་ཀྱང་ཕོག་སྔ་འགྱེལ་སྔར་འགྲོ་བ་ཡིན།",
    "རྨ་ཡི་འཇིབ་རྩིར་ཕྲུམ་སར་རྨ་ལ་བཏབ་པར་བྱ།",
    "ཉལ་འདྲེས་མི་བྱ་ཙོག་གེ་བསྡད་ལ་གསོ།",
    "པར་བྱ།",
    "དེ་ཕྱིར་འཇིབ་ལུམས་བསྲེག་པ་གསུམ་ག་འཛོམ་བསིལ་དྲོད་སྙོམས་པར་བཅོས།",
    "ཞེས་གསུངས་སོ།",
    "ཀྱེ་དྲང་སྲོང་ཆེན་པོ་རིག་པའི་ཡེ་ཤེས་ལགས།",
    "དྲང་སྲོང་རིག་པའི་ཡེ་ཤེས་ཀྱིས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "ཞེས་གསུངས་སོརྩ་ཡི་མདུད་པ་ཤ་རྨེན་འདྲ།",
    "ལྷེན་སྣ་དང་བྲང་རུས་འབྲེལ་མཚམས་ནས་རྒྱབ་ཀྱི་ཚིགས་པ་བཅུ་གསུམ་པརའཕྲེད་ལ།",
    "མཆིན་དྲི་ཁུག་པ་རྒྱབ་ཀྱི་ཚིགས་པ་བརྒྱུད་པ་དང་བཅུ་གསུམ་པའི་པར།",
    "རྒྱུངས་པར་མ་སླེབ་མདེའུ་མ་ལས་འཚོ།",
    "དེ་ཕྱིར་དང་པོ་ཕོག་ས་བརྟག་པར་བྱ།",
    "ཤ་གཤགས་པ་ལས་རུས་པ་ཕུག་པ་ཉིན་ཆེ་རུས་ཕུག་པ་ལས་རྩ་ཆོད་པ་ཉེན་ཆེ་དེ་བས་ཀྱང་དོན་དང་སྣོད་ལ་ཟིནཔ་ཉེན་ཚེ།",
    "དེ་ལྟར་རིམ་པས་ཉེན་ཚེཞིང་དེ་བཞི་ག་སྦྲགས་མར་ཕུག་པནི་ངེས་པར་འཆི།",
    "དེ་ཕྱིར་དོན་ལ་ཐིགས་གསོག་པས་གསོ་པར་དཀའ་ཞིང་ཡུན་རིང་དུ་སྦྱོང་།",
    "གསུམ་པ་ནང་བརྟོལ་མ་བརྟོལ་པརྟག་པ་ནི།",
    "ཁྲག་མ་ཤོར་ན་མདའ་ལམ་རིང་པར་གྱུར་ཡང་།",
    "ཞག་ཏུ་ལོན་ནས་ལྕེ་དང་མཆུ་དང་རྙིལ་བཀྲག་མེད་པར་འཆོར།",
    "དེ་རྟགས་ལྡན་ན་ཁྲག་ངན་བབ་པར་ངེས།",
    "ཇི་ལྟར་འགོར་ཡང་ཞག་གསུམ་དག་ལས་རིང་པརམི་སྡོདདེ་འཆི།",
    "འཆི་ངེས་པའི་ལ་ཆེན་འདའ་བར་ཁ་དམར་གདགས་པར་བྱ།",
    "གལ་ཏེ་འཚོ་འཆིའི་ཐེ་ཚོམ་ཟ་ནི་ཤན་མི་ཕྱེད་པར་ཁ་དམར་མི་སྨྲའོ།",
    "དང་པོ་ཕྱི་ལ་ཤ་སུལ་རུས་པར་མདེ་སྟོར་ན།",
    "དེ་རྟགས་ཡན་ལག་དག་དང་ཁྱད་པར་མེད།",
    "མེ་ཕེབས་སྨྲ་མི་ཤེས་དང་ཀོ་ལེར་ན།",
    "དར་དཀར་རམ་ཤོག་བུ་བཀབ་ལ་བཞག་ནང་པར་བལྟས་པས་ལྕགས་གཡའ་འབྱུང་།",
    "སྐམ་པས་ཕྱུངས་ཏེ་ཡན་ལག་ལྟ་བུར་དབྱུངས་པར་བྱ།",
    "ཆུ་བྲེ་གང་ལ་བུམ་པར་བཙོས་པ་ཡིན།",
    "དེ་ནས་སྦང་མའི་འཇིབས་སུ་གཞུག་པར་བྱ།",
    "ཏིག་ཏ་ཧོང་ལེན་ཀྱི་ལྕེ་པར་པ་ཏ།",
    "ཞོ་དང་སྦྱར་བའི་འཇིབས་སུ་གཞུག་པར་བྱ།",
    "རྨ་ཆེན་རྣག་ཁྲག་གསར་རྙིང་མེད་པར་སྐེམ།",
    "ཆུང་ན་རྨ་ཁ་དེ་ཉིད་བསྲེག་པར་བྱ།",
    "སོགས་དཀྱིལ་དང་ཚིགས་པ་དྲུག་པ་བདུན་པ་གསེར་གྱིས་བསྲེག་པར་བྱ།",
    "རྨ་ཁ་མི་སྐམ་པར་སྔོའམ་སྦྱང་རོའི་ཆས་སྟེང་ཐེར་སྲབ་བཅིང་།",
    "དེ་མ་འཛོམ་ན་ཡོས་དུགས་བྱས་ཀྱང་བཏུབ།",
    "ཞེས་གསུངས་པས་དེ་ངོ་ཤེས་པར་གྱིས་ཤིག་ཀན།",
    "ལི་ཁྲི་ནི་བརྡ་སྤྲོད་དྲུག་པར།",
    "སྐྱིད་ཁུང་མཐེ་བོང་སྤུ་མཐེ་བོང་བཞིའི་རྒྱབ་ཀྱི་སྐྱེས་བསྲེག་པར་བྱ།",
    "བྲམ་ཟེ་ལྟ་བུར་གཙང་སྦྲའི་སྒོ་ནས་བཅོས།",
    "མགྱོགས་མེ་དར་དཀར་དྲི་མེད་གཙང་མ་རུ།",
    "ནུབ་གཉིད་མི་ཕེབས་ཉིན་པར་གཉིད་མི་ཐུབ།",
    "དར་གསར་མར་དཀར་ཆུ་བསིལ་བསྟེན་པར་བྱ།",
    "ཀ་ར་དཀར་སྦྱར་ནང་སྔ་པར་ལྟོ་སྟོང་བཏང་།",
    "ཧོང་ལེན་ཀ་ར་སྦྱར་ལ་ནང་པར་བཏང་།",
    "སྨིན་དུས་བསྡད་ན་སྟག་བྱུང་བའི་གདོང་དུ་མདའ་སོགས་ལ་རྒྱབ་པར་ས་ཀྱིན་བསྡད་ན་གཏོར་ཚུར་བསོད་པ་དང་འདྲ།",
    "དབུགས་བདེ་ཉིན་གཉིད་ཆུང་ལ་ནུབ་གཉིད་ཕེབས།"
  ]
