    "གཙང་པོར་ཕྱིན་པས་ཀྱང་ཆུ་མི་འདུག་པས།",
    "སེམས་ཀྱི་གཞག་ས་དེ་ན་གདའ།",
    "བརྟགས་ན་རང་ལའང་ཚེ་འདིའི་ཕུན་ཚོགས་ཐོབ་འདོད་བློ་ཕུགས་ན་ཡོད་པའི་རྟགས་སུ་གདའ་གསུང་།",
    "འདིས་ནི་བདག་ལ་ཕན་འབའ་ཞིག་བཏགས་འདུག་སྟེ།",
    "ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱིས་ཕན་འདོགས་བའི་དྲིན་ཅན་རང་དུ་འདུག་པ་ཨང་སྙམ་དུ་བསམས་ཤིང་།",
    "ཡང་རང་གང་ལ་ཆགས་པའི་དངོས་པོ་དེ་བཀར་ཞིང་གཏོང་།",
    "དེ་ཙ་ན་ཡིད་བཞིན་དུ་བསྒྱུར་ཅིང་གཏང་རྒྱུ་ཡང་དཔག་ཏུ་མེད་དེ།",
    "སྔགས་རྙིང་མ་བའི་གྱེར་སྒོམ་ཀུན་ཡང་འདི་དང་དོན་གཅིག་དེ་ཡང་དང་པོ་ཙ་ན་ཁ་རུ་མི་ཐོན་པ་འབྱུང་དོགས་ཡོད།",
    "འདས་མ་འོངས་ད་ལྟར་ཏེ་དུས་གསུམ་གྱི་སྡུག་བསྔལ་ཐམས་ཅད་བདག་ཏུ་འཛིན་པ་འདིས་བསྐྱེད་ནས་འདུག་གོ།",
    "ད་ལྟར་ཡང་མི་དང་མི་མིན་གྱི་གནོད་བྱེད་ཐམས་ཅད་སྤྱན་འདྲེན་མཁན་ཕུང་བྱེད་འུག་པའི་མགོ་ཅན་དེ་ནི་ང་དང་བདག་ཏུ་འཛིན་པ་བྱ་བ་རང་དོན་འབའ་ཞིག་སྒྲུབ་བའི་བློ་ཅན་འདིར་འདུག་པ་སྙམ་དུ་བསམས་ལ་དགྲ་ལ་དགྲར་ངོ་ཤེས་པར་བྱའོ།",
    "དེས་ན་བདག་འཛིན་ནམ་བྱུང་ཙམ་ན་བརྟགས་ན་བདག་གང་ཡང་མི་འདུག་པ་ལ་ཅིའི་ཕྱིར་བདག་ཏུ་འཛིན་ཞེས་བདག་འཛིན་ནམ་སྐྱེས་དུས་འཕྲལ་འཕྲལ་ལ་སྤངས་ཏེ།",
    "དེ་ཙ་ན་རྐྱེན་གྱི་འཕྲང་ལས་གྲོལ།",
    "དེ་ཙ་ན་ཟིན་སར་སླེབ་པ་ཡིན་ཏེ།",
    "ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱིས་ཕན་འདོགས་འདོགས་པ་དྲིན་ཅན་འབའ་ཞིག་ཏུ་འདུག་པ་ཨང་སྙམ་དུ་ཤེས་པ་ཉེ་དུངས་པ་བསྐྱེད་ལ།",
    "མི་མ་ཡིན་སུ་འདུག་པ་མདུན་དུ་སྤྱན་དྲངས་ལ།",
    "དེ་ལྟར་ན་ཉེས་པ་ཐམས་ཅད་བདག་གཅེས་འཛིན་ལས་བྱུང་འདུག་པས་དེ་ལ་དགྲར་བལྟས་ལ་སྤང་།",
    "འདི་བདག་ལ་ཕན་འདོགས་པར་འདུག་སྙམ་དུ་བསམ།",
    "དེ་ཙ་ན་དེས་དྲན་པའི་རྐྱེན་བྱས་ནས་འདི་ལྟར་བསྐུལ་དུ་བྱུང་བར་བསམས་ཏེ།",
    "དཔེར་ན་ནམ་མ་ལངས་པར་ཤིང་འཐུ་རུ་འགྲོ་སྙམ་ཙ་ན་གཉིད་སྔར་སད་ནས་ཡོང་བ་དང་འདྲ།",
    "ད་དུང་ཡང་འདི་དང་མ་བྲལ་རིང་ལ་བདེ་བ་མེད་ཅིང་སྡུག་བསྔལ་འབའ་ཞིག་ལ་སྦྱོར་བར་འདུག་པས་འདི་བརླག་ཏུ་གཞུག་དགོས།",
    "གཉིས་ཀ་ཚངས་བའི་གནས་སུ་སྐྱེས་པར་འདུག་གསུང་།",
    "བདག་པས་གཞན་གཅེས་ཀྱི་བློ་སྣ་བཅོས་མིན་སྐྱེས་པས་འདི་ཉིད་དུའང་ངོ་མཚར་བའི་ལྟས་དུ་མ་བྱུང་འདུག་སྟེ།",
    "སྟོད་ལུང་པས་ཁྱེད་རང་ཇི་ལྟར་མཛད་གསུངས་པས།",
    "སྨ་འབེབས་སུ་འདུག་རྟོག་དཔྱོད་གྱིས་དང་།",
    "སྨ་འབེབས་སུ་འདུག་ན།",
    "དེ་ཙ་ན་སྒྲུབ་པའི་ཉམས་ལེན་ཚད་དུ་ལོངས་པ་ཡིན་པས།",
    "སོ་སོ་སྐྱེ་བོ་ཡིད་མི་བདེ་བའི་རང་བཞིན་དུ་འདུག་པ་ཡིན།",
    "དེ་ཙ་ན་གཉེན་པོའི་ལྡང་ཚད་དུ་ལོངས་པའོ།",
    "ང་རང་སྣང་བ་མ་དག་པ་ཡིན།",
    "ས་ཡུལ་གཉན་ཟེར་ཙ་ན་ཁོ་གྲགས་ནས་ཁྱེར་གྱིས་དོགས།",
    "ལུང་སྨད་པ་སྣེའུ་ཟུར་ན་བཞུགས་ཙ་ན་གྲོགས་པོ་རྟོག་ཏུ་བཅུག་པས་རྟོགས་པ་ལྟ་བུ་ཡིན།",
    "ཕྱིས་ངས་དེ་ཙ་ན་བྱས་ཏེ་མ་བཏུབ་པས་ད་ཅི་དགའ་གྱིས་ཞེས་ཡུས་སུ་འཆད་པར་མི་བྱ།",
    "ཚིག་ངན་བསྣུན་པ་ལ་སོགས་པ་ཅི་བྱས་ཀྱང་རང་ལ་གྱོད་བདའ།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "དཔོན་སློབ་དམ་ཚིག་ཉམས་སུ་འདིས་འཇུག་བཟའ་མི་ནང་འདིས་མི་མཐུན་དུ་འཇུག་བྲང་ཟླ་མི་རྙེད་དུ་འདིས་འཇུག་པས་འདི་དང་དུས་ཐམས་ཅད་དུ་འབྲལ་བ་མེད་པ་ཞིག་དགོས་པས་ཇ་སུན་མཐོ་དམན་དང་འདུག་ས་ལེགས་ཉེས་ལ་ཀོ་ལོང་མི་བསྡམ།",
    "ཁྱེད་རང་ལ་སྡོམ་པ་མེད་ཅེས་པའམ།",
    "སྔོན་རྒྱ་སྟོན་བྱིས་པ་ཙ་ན་གཞན་གྱི་རྟ་བཀྲོགས་ནས་བྲག་ལ་མཆོངས་ནས་བསད་པས།",
    "ནགས་གསེབ་ན་དུ་བ་འདུག་ནས་དེར་བལྟར་ཕྱིན་པས།",
    "ཚོས་ཕྲུ་ཁ་ཕྱེ་ནས་བལྟས་པས་ཤ་རུ་འདུག་པ་ཟེར།",
    "དགེ་སློང་དེས་བེའུ་བརྐུས་པར་མི་གདའ་བས་གཏོང་བར་ཞུ་ཞུས་ནའང་།",
    "འདོད་པ་སྤྱི་སོ་ན་འདུག་པ་ལ་རྩེ་གཏོད་པ་འདིར་ངན་པ་ཁོ་ན་ལ་ཡོད་པའི་ངེས་པ་མེད།",
    "དགྲ་གཉེན་འདི་བློ་ཡི་འཛིན་སྟངས་སུ་འདུག་པས།",
    "ཕོ་རུས་ཆེ་བར་འདོད་པ་འགའ་ཞིག་དངོས་བས་ཀྱང་ཞེ་སྡང་ཆེ་བའི་རིགས་ཡོད་འདུག་གསུང་།",
    "ང་ལ་སྒོམ་ལོག་སྐྱེས་ནས་འདུག་སྙམ་དུ་བསམས་ལ།",
    "ཁྱད་པར་བློ་སྦྱོང་དང་འགལ་བ་བྱས་ནས་འདུག་ན།",
    "དེ་གཉིས་དང་མི་འགལ་ཞིང་མཐུན་པར་བྱས་ནས་འདུག་ན།",
    "ཁ་ངོམས་པའི་དུས་སུ་བཏུང་བར་ལོད་པ་བཞིན་བྱུང་ཡང་རྐྱེན་ངན་དང་འདོམ་ཐུག་བྱུང་ཙ་ན་གཉེན་པོ་དྲན་དཀའ་བ་ཡིན་གསུང་།",
    "དེ་ཙ་ན་འབུང་བ་ཞིག་དགོས་ཏེ་བཟློག་པར་དཀའ།",
    "དེ་ལྟར་ཡིན་པ་ལ་གཉེན་པོ་བསྐྱེད་ལ་རྐྱེན་ངན་བྱུང་ཙ་ན་གཉེན་པོ་དྲན་ལ།",
    "བརྩོན་འགྲུས་ཆེ་ན་འདི་ལ་སྤྲོ་བ་ཅི་འདུག་བལྟ།",
    "རང་ལ་དེ་གསུམ་ཚང་འདུག་ན་དགའ་བ་བསྒོམ་ཞིང་།",
    "དེ་ལྟར་དགྲ་རྣམས་ཀྱང་དགའ་བ་བསྐྱེད་ཅིང་རང་གཞན་གྱི་ཞེ་སྡང་ཞི་བར་བྱས་པ་དེ་གཅིག་ལགས་ཏེ་མི་ཡོང་མཆི།",
    "གསུམ་པ་ཆགས་སྡང་སྤངས་ཤིང་དབེན་པ་བསྟེན་ནས་དལ་བར་བསྡད་དུ་ཕངས་པར་གདའ་བས།",
    "གསུང་ཟེར་ཏེ་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བར་གདའ་གསུང་།",
