    "གལ་ཏེ་མེད་པར་རང་གི་ངོ་བོ་ནི་དགག་སྒྲུབ་ཀྱི་ཐ་སྙད་ཀྱི་རྟེན་མིན་ཡང་ཡུལ་གྱི་ཁྱད་པར་འགའ་ཞིག་དང་དུས་ཀྱི་གནས་སྐབས་འགའ་ཞིག་གཞིར་བཟུང་ནས་དེ་འགོག་པའི་ཐ་སྙད་བྱེད་དོ་ཅེ་ན།",
    "ཅི་ལྟར་ཐ་སྙད་འཇུག་པའི་ཡུལ་རང་གི་ངོ་བོ་དེ་ཡོད་པ་དེ་ལྟར་ན་ནི་མི་འགོག་ལ།",
    "ཅི་ལྟར་དེ་མེད་པ་དེ་ལྟར་ན་ཡང་ནི་འགོག་པ་མི་འགྱུར་བས་ཡུལ་རང་གི་ངོ་བོ་ཡོད་པ་དང་མེད་པ་གང་རུང་ལས་འོས་མེད་ཅིང་དེ་གཉིས་གང་ལ་འང་དགག་པ་མི་འཇུག་པས་ན་སྐྱོན་སོ་ན་གནས་སོ།",
    "དངོས་པོའི་དོན་ནི་རང་གི་རང་བཞིན་ཇི་ལྟ་བར་གནས་པ་ཙམ་ལས་འཕེལ་འགྲིབ་དང་།",
    "དེ་ཡང་དངོས་མེད་ལ་དགག་སྒྲུབ་ཀྱི་ཐ་སྙད་མི་འཇུག་ན་ཧ་ཅང་ཐལ་བ་དེ་བཞིན་དུ་ཡོད་པ་སྒྲུབ་མི་དགོས་ལ་མེད་པ་སྒྲུབ་མི་ནུས་པས་དངོས་པོ་ལ་དཔྱད་ན་སྒྲུབ་པའང་མེད་མོད།",
    "སྒྲ་མིན་ལས་ལོག་ཙམ་གྱི་གཞན་སེལ་ལ་བརྟེན་ནས་སྒྲ་ཞེས་པའི་མིང་གི་དོན་རྟོག་ཡུལ་ན་སྣང་བ་དེ་ལ།",
    "ཡང་དག་པར་དཔྱད་ན་དངོས་པོར་མེད་པ་ཡི་ནི་དོན་ཅན་གྱི་སྒྲ་དོན་ལ་བརྟེན་ནས་བྱང་བའི་ཐ་སྙད་གང་ཞིག་ཇི་ལྟར་ཐོག་མ་མེད་པ་ནས་བརྒྱུད་དེ་འོངས་པའི་བློས་བསྟན་པ་སྟེ་བློ་རང་གི་ངང་གིས་མཚོན་པར་གྱུར་པ་འདི་ནི་ཇི་ལྟར་སྣང་བ་དེ་བཞིན་ཉིད་དེ་གྲུབ་པ་ཡིན་ནམ་མིན་ཞེས་མ་བརྟག་པར་ལྡོག་པ་ཐ་དད་པའི་དོན་གྱི་རྟེན་ནི་སྒྲ་དོན་ཙམ་མོ་ཞེས་ཁས་ལེན་པ་གང་དེ་འཇིག་རྟེན་ཐ་སྙད་ཀྱི་ཚུལ་ལ་བརྟེན་ནས་ཡིན་ནོ།",
    "དེ་མེད་པས་ལྡོག་པ་ཆིག་རྐྱང་ཡང་ཇི་ལྟར་འགྲུབ་སྟེ་རང་གར་སྨྲ་བ་ཙམ་མོ།",
    "འདི་ལྟར་རིགས་པ་ཅན་པ་ཁྱོད་ཀྱིས་མཐུན་པའི་ཕྱོགས་མེད་པ་ལས་རྟགས་ལྡོག་པ་མེད་དོ་ཞེས་སྨྲས་པ་ཤིན་ཏུ་མི་རིགས་པར་བཀག་ཟིན་ཀྱང་།",
    "གལ་ཏེ་མེད་པ་ལས་རྟགས་ལྡོག་པ་མེད་དུ་ཆུག་ན་ཡང་དེས་ཁྱོད་ཀྱི་ཞེ་འདོད་ལ་ཅི་ཞིག་ཕན་ཏེ།",
    "ཁྱོད་རང་གི་བསྒྲུབ་བྱ་བདག་ཡོད་འདོད་ཀྱི་བདག་མེད་མི་འདོད་པས་སྲོག་རྟགས་སུ་བཀོད་པ་འདི་ནི་མཐུན་ཕྱོགས་བདག་ཡོད་པ་ལས་ཀྱང་ལྡོག་གམ་སྙམ་དུ་ཐེ་ཚོམ་ཟ་སྟེ།",
    "མཐུན་ཕྱོགས་ལ་གྲུབ་ངེས་སུ་མ་མཐོང་བས་མི་མཐུན་ཕྱོགས་ལ་ལྡོག་ངེས་སུ་གང་གིས་འགྲུབ་སྟེ།",
    "ཡང་ན་བདག་གཅིག་གི་རང་བཞིན་དག་ཏུ་ངེས་པ་ལས་གཞན་ཤེས་བྱེད་ཅི་ཞིག་ཡོད་དེ་མེད་ལ།",
    "དེ་གྲུབ་པ་མིན་པར་འདོད་པ་བཞིན་དུ་བདག་མེད་མེད་ཅེས་པའི་དགག་པ་གཉིས་ཀྱིས་བདག་ཡོད་མི་འགྲུབ་པ་ཁོ་རང་གི་ཁས་བླངས་ལས་གྱུར་པ་ཡིན་ནོ།",
    "གལ་ཏེ་གཏན་ཚིགས་སྲོག་དེ་མི་མཐུན་ཕྱོགས་ཁོ་ན་ལས་ལྡོག་གི་མཐུན་ཕྱོགས་ལས་ལྡོག་པ་མེད་ན་དེ་ཡི་རྒྱུས་མཐུན་ཕྱོགས་ལ་རྗེས་འགྲོ་ཅན་དུ་གྲུབ་དགོས་ལ།",
    "དེ་བྱུང་གི་འབྲེལ་བ་ལ་ནི་རྒྱུ་གང་ཞིག་མཐོང་བ་ན་འབྲས་བུ་མཐོང་བ་དང་རྒྱུ་དེ་དག་མ་མཐོང་ན་འབྲས་བུ་ཡང་མ་མཐོང་བ་གང་ཡིན་པ་སྟེ།",
    "སྲོག་དམིགས་ཀྱང་དེ་བདག་གི་འབྲས་བུ་ཡིན་པར་མཐོང་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "ཁྱོད་ཀྱི་བདག་རྟག་ཏུ་ཡོད་པ་དེ་ནི་ནམ་ཡང་མེད་པར་མི་རིགས་ལ།",
    "གལ་ཏེ་འབྲས་བུ་འདི་ཐ་དད་དུ་བྱེད་པ་ནི་རྒྱུ་ཡི་ཁྱད་པར་གྱིས་ཐ་དད་དུ་བྱེད་པ་མིན་ན་དུ་བ་གཅིག་གི་རང་བཞིན་དུ་འདོད་པ་དེ་ལའང་རིགས་གཉིས་ཡོད་པས་རང་བཞིན་གཅིག་པ་ཉིད་ཉམས་པར་འགྱུར་ཏེ།",
    "འབྲས་བུ་རྒྱུ་ལ་ངེས་པར་ལྟོས་པའང་མི་འགྲུབ་པས་རྟག་ཏུ་སྐྱེ་བར་ཐལ་ལོ།",
    "གལ་ཏེ་རང་བཞིན་གཅིག་དང་དུ་མ་མི་འགལ་ན་དེ་དུ་བ་ཙམ་དུ་མ་ཟད་དེའི་རྒྱུ་འདོད་པ་བརྒྱ་བྱིན་སྤྱི་བོ་ཡང་མེ་དང་མེ་མིན་གྱི་རང་བཞིན་གཉིས་སུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ལྟར་རྒྱུ་དང་འབྲས་བུ་དག་ཕན་ཚུན་གཞན་དུ་འཆོལ་བ་མེད་པའི་རང་བཞིན་དུ་ངེས་པ་ཉིད་ཡིན་པ་དེས་ན་ཇི་ལྟར་རང་གི་རང་བཞིན་མཐོང་བ་ན་ཡང་མེ་དེ་ཡོད་པ་འཁྲུལ་བ་བཞིན་མེ་མ་མཐོང་བར་འབྲས་བུ་དུ་བ་མཐོང་ན་ཡང་མེ་དེ་ཡོད་པ་འཁྲུལ་མེད་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "ཕ་རོལ་པོ་ན་རེ།",
    "འབྲས་བུ་སོ་སོའི་རྒྱུར་གྱུར་པའི་ཆུ་ནང་ཕན་ཚུན་ཡང་རང་རང་གི་ངོ་བོ་ལ་གནས་པའི་ཕྱིར་ཕན་ཚུན་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཐ་དད་ཡིན་ཞེས་ལེགས་པར་བསྒྲུབས་ཟིན་པ་བཞིན་ནོ།",
    "རང་གིས་འདོད་པ་གྲུབ་པའི་ཚུལ།",
    "ཆུའི་རྫས་ཐ་དད་ཀྱང་གཤེར་བར་རིགས་གཅིག་པ་དེ་བཞིན་མེ་ཡི་ཁྱད་པར་དག་ནི་ཐ་དད་ཀྱང་མེ་མིན་ལས་ལྡོག་པའི་ཆ་གང་གིས་ནི་དངོས་པོ་གང་ལ་འདི་ཐམས་ཅད་མེར་རིགས་གཅིག་ཅེས་རྟོགས་པའི་རྟེན་དུ་གྱུར་པ་ཚ་ཞིང་སྲེག་པའི་རང་བཞིན་ཅན་གང་ཡིན་པའི་དངོས་པོ་དེས་ནི་རང་འབྲས་དུ་བ་བསྐྱེད་པ་དེས་ནི་དེ་ལྟར་རྒྱུ་འབྲས་སུ་གྱུར་པའི་ཕྱིར་དུ་བས་མེ་རྟོགས་པ་ཡིན་ཞིང་།",
    "དེ་ལྟ་བུའི་བདག་གཅིག་གི་འབྲེལ་བ་དེ་ཡང་བདག་དང་སྲོག་ལ་མེད་པར་དོན་གྱིས་བསྟན་ཏེ།",
    "ཇི་ལྟར་ན་འབྲས་རང་གི་གཏན་ཚིགས་གཉིས་པོའི་ལྡོག་པ་སྟོན་པ་ན།",
    "རྒྱུ་ཁྱབ་མ་དམིགས་པ་དེ་ལའང་སྣང་རུང་གིས་ཁྱད་པར་དུ་བྱ་དགོས་པར་བཞེད་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་འགོག་པ་དེ་ཡང་བལྟར་རུང་གི་དོན་ལ་མ་དམིགས་པ་དེ་རྟགས་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ཏེསྐྱེས་བུ་མ་མཐོང་བ་དེའི་ཕྱིར་དེ་ལྡོག་པས་སྲོག་ལ་སོགས་པ་ལྡོག་པར་ངེས་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དངོས་པོའི་ཆ་སྒྲུབ་པར་བྱེད་པ་སྔ་མ་འབྲས་རང་གི་གཏན་ཚིགས་གཉིས་པོ་དག་གིས་ནི་དགག་པ་ཙམ་སྟོན་པ་མ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་མ་དམིགས་པ་དེ་ཁོ་ནར་གནས་ཤིང་།",
    "ཡོད་ངེས་ཀྱི་ཐ་སྙད་འཇུག་པའི་ཡུལ་བུམ་སོགས་དེ་མེད་པའི་ཕྱིར་ན་དགག་གཞི་དེར་ཡུལ་ཅན་དུ་གྱུར་པ་ཡི་ནི་ཡོད་ངེས་ཀྱི་ཤེས་བརྗོད་དག་གི་ཐ་སྙད་དང་ཡོད་དམ་མེད་སྙམ་པའི་ཐེ་ཚོམ་དག་ནི་འགྲོག་པར་འགྱུར་ཏེ།",
    "དགོས་དོན་མེད་པར་ཐལ་བ་སྤང་།",
    "ཡུལ་རང་གི་ངོ་བོ་གང་ན་ལྡོག་པའི་གཞི་དེར་དེ་ཉིད་མི་སྣང་བ་དེ་ལས་གཞན་པའི་མེད་པ་ཞེས་བྱ་བ་ཅི་ཡང་མེད་དོ།",
    "སྣང་དུ་རུང་བ་དེ་མ་མཐོང་ན་དེ་ཙམ་གྱིས་མེད་ཅེས་བྱ་བའི་ཐ་སྙད་འདི་སྤྱིར་གནག་རྫི་མོའི་བར་ལ་གྲགས་ཤིང་གྲུབ་པས་མེད་པའི་ཐ་སྙད་དེ་མི་དམིགས་པ་དེ་ཡི་འབྲས་བུ་ཡིན་ཡང་རྒྱུ་དེ་ལས་ནི་མེད་ཅེས་པའི་བློ་དང་སྒྲ་ཐེ་ཚོམ་མེད་པར་འགྲུབ་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་གཞན་ལ་དཔེ་སྟོན་པ་ཙམ་གྱི་ཆེད་ཁོ་ནར་མ་ཟད་རང་གི་ངོ་བོའང་གཏན་ཚིགས་སྐྱོན་ཅན་མིན་ཏེ།",
    "རྗེས་སུ་འགྲོ་ལྡོག་གི་དོན་ནི་སྔར་ནས་གྲུབ་ཟིན་པ་ལ་ད་བསྒྲུབ་མི་དགོས་སོ།",
    "འོན་ཀྱང་དེ་འདྲའི་རྗེས་སུ་འགྲོ་ལྡོག་གི་ཚུལ་གྱིས་ལྟོས་པ་ཅན་འབྲས་བུ་དང་།",
    "ལྟོས་ཡུལ་རྒྱུ་གཉིས་ཀ་ལ་རྒྱུ་འབྲས་ཞེས་པའི་ཐ་སྙད་སྦྱར་བས་རྗེས་སུ་འགྲོ་ལྡོག་གི་དོན་དེ་དག་བདེ་བླག་ཏུ་ཤེས་ནུས་ཤིང་དེའི་དོན་མང་པོ་བརྗོད་མི་དགོས་པར་ཐ་སྙད་ཟོར་ཡང་བས་རྟོགས་བྱ་ཁོང་དུ་ཆུབ་པ་ཡིན་ནོ།",
    "དམིགས་བྱེད་ལོག་པ་ཙམ་ཡང་མ་ཡིན་མོད་ཀྱི་མེད་པར་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ཏེ།",
    "དགག་བྱ་མེ་ལྟ་བུས་དབེན་པའི་དངོས་པོ་ཕྱོགས་ལྟ་བུ་གཅིག་མངོན་སུམ་གྱིས་དམིགས་ཤིང་དེ་ལྟ་བུར་རང་རིག་གིས་ཉམས་སུ་མྱོང་བ་ལས།",
    "མ་འདྲེས་པའམ་དབེན་པ་དེ་ལྟའི་བདག་ཉིད་ཅན་དུ་མྱོང་བ་རང་རིག་པ་འདི་ནི་དངོས་པོ་འདི་རྣམས་ནི་མ་འདྲེས་པར་གཅིག་གཅིག་གིས་དབེན་པའི་ཐ་དད་པར་འཛིན་པའི་བློ་ཡི་རྒྱུ་ཡིན་ཏེ།",
    "དེ་ཕྱིར་དགག་བྱ་གང་གིས་དབེན་པའི་རྣམ་པ་ཅན་གྱི་བློ་ཐ་དད་པའི་དབྱེ་བ་ནི་དེ་ལྟར་མྱོང་བའི་བློ་རང་རིག་ཉིད་ལས་གྲུབ་པར་འགྱུར་ཏེ་མངོན་སུམ་མྱོང་བ་ཙམ་ལས་འགྱུར་རོ།",
    "བློ་ཐ་དད་པར་སྐྱེས་པ་དེ་དག་གིས་ཡུལ་ཅན་དེའི་གཞལ་བྱའི་དོན་དེ་ཡང་དེ་ལྟར་དབེན་པ་དང་མི་དབེན་པར་འཇོག་སྟེ།",
    "དགག་བྱ་མེད་ངེས་སུ་མཚོན་པ་སྣང་རུང་མི་དམིགས་པར་རང་གི་ངོ་བོར་ཁྱད་མེད་ཀྱང་སྦྱོར་བ་འགོད་པ་དག་ལ་གཉིས་སུ་ཡོད་དེ།",
    "མི་དམིགས་པ་དེའི་རང་གི་ངོ་བོའི་ཚུལ་དངོས་སུ་སྨོས་པའི་སྦྱོར་བ་རྒྱུ་ཁྱབ་རང་གསུམ་འབྲས་བུ་དང་བཅས་པའམ།",
    "འདི་ལ་ཚ་རེག་གྲང་རེག་ལྟ་བུ་དོན་འགལ་དང་།",
    "ཐལ་བ་འགོད་དང་དེའི་ལན་དགག།",
    "དངོས་པོ་ལ་དེས་ཅི་ཡང་མི་བྱེད་པའི་ཕྱིར་དེ་ནི་རང་གར་སྨྲ་བ་ཙམ་མོ།",
    "དེ་ཡང་འཇིག་པ་དེ་ནི་མེའི་ཚ་བ་བཞིན་དུ་བུམ་སོགས་དངོས་པོའི་བདག་ཉིད་ལ་གྲུབ་པར་གྱུར་ན་རང་གི་རྒྱུ་ལས་བདག་གི་ངོ་བོ་གྲུབ་ཟིན་པ་ལ་ཕན་འདོགས་བྱེད་པ་ཡི་རྒྱུ་གཞན་གང་ཞིག་ཡོད་དེ་ཅི་ཡང་མི་དགོས་ལ།",
    "དེ་ལྟར་སྐྱེས་ཙམ་ནས་མེའི་ཚ་བ་བཞིན་དུ་དངོས་པོའི་གཤིས་ཀྱིས་འཇིག་ངེས་པར་གྱུར་པ་གང་ཞིག་འཇིག་རྒྱུ་གཞན་ལ་ལྟོས་མེད་ཀྱི་དངོས་པོ་ནི་དུས་ནམ་དུ་ཡང་ནི་འཇིག་པ་དེ་ལྟ་བུ་མིན་པར་རེས་སྐད་ཅིག་ཕྱི་མ་རྣམས་སུ་མི་འཇིག་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "དཔེར་ན་རྒྱུ་ཚོགས་པ་ཚང་ནས་ནུས་པ་ཐོགས་མེད་དུ་གྱུར་པ་དག་རང་གི་འབྲས་བུའི་ལས་ཏེ་འབྲས་བུ་སྐྱེད་བར་བྱེད་པའི་ས་ལ་གེགས་བྱེད་པ་མེད་པ་ཅན་གྱི་ཚོགས་པ་བཞིན་ནོ།",
    "འདི་ལྟར་བློ་ཡི་ནུས་པ་ཆུང་བ་མེད་པར་གྲགས་པ་ཡི་རྣམ་དཔྱོད་དང་ལྡན་པ་དེ་དག་གིས་ཀྱང་འདི་ལྟ་བུའི་ཟབ་མོའི་དེ་ཁོ་ན་ཉིད་རྟོགས་པ་མེད་པ་ཅན་ཡིན་ལ།",
    "ཉིན་དང་མཚན་དུ་འབད་པས་བརྩོན་འགྲུས་ཤིན་ཏུ་ལྷག་པར་གྱུར་པ་དེ་དག་གིས་ཀྱང་གཞུང་འདི་ལྟ་བུའི་རིགས་པ་མཆོག་གི་དེ་ཉིད་ཚུལ་བཞིན་མཐོང་བ་མེད་པ་དང་ལྡན་ན་ཤེས་རབ་ཆུང་ཞིང་ལེ་ལོ་ཅན་གྱི་ལྟ་ཅི་སྨོས།",
    "ཕྱིན་ཅི་ལོག་གི་ལྟ་བ་ངན་པའི་ནགས་འཐུག་པོའི་ཚང་ཚིང་སྲེག་པར་བྱེད་པ་དང་།",
    "ལྟ་བ་ཆུ་བོ་བཟློག་པར་དཀའ་མོད་ཀྱི།",
    "སྔོན་གྱི་བསྒྱུར་བྱེད་དམ་པ་དེ་དག་གི།",
    "གཙུག་གི་ནོར་བུ་སྐལ་ལྡན་ནི།",
    "གཞན་དུ་ཕྱིན་ཅི་ལོག་གི་འཛིན་པ་སྟུག་པོའི་ཚང་ཚིང་ལས་ཀྱང་བརྒལ་མི་ནུས་ན།",
    "ཚུར་མཐོང་ལས་འདས་པའི་དེ་ཁོ་ན་ཉིད་རྣམས་ཀྱི་སོ་སོ་རང་གིས་རིག་པར་བྱ་བའི་དོན་ཇི་ལྟར་རྟོགས་པར་ནུས་ཏེ་གནས་མ་ཡིན་པའི་ཕྱིར་དེས་ན་ཐོག་མར་ཚུ་རོལ་མཐོང་བའི་སྒོ་ནས་དེའི་ཡུལ་དུ་གྱུར་པའི་དངོས་པོའི་དེ་ཁོ་ན་ཉིད་མཁས་པར་བྱས་ནས་དམ་པའི་དོན་ལ་གདོད་འཇུག་པར་བྱ་བ་ཡིན་ཏེ།",
    "འདི་དེ་བཞིན་གཤེགས་པས་ཐུགས་སུ་ཆུད་པའི་དགོངས་པ་ཟབ་མོ་སྤང་བར་མི་བྱ་སྟེན་དང་པོར་ཐོས་ལ་བརྟེན་ནས་ཡིད་ལ་བྱེད་པ་འབྱུང་།",
    "ཟབ་མོ་ཅི་ཡི་ཕྱིར་ན་རྟོག་གེའི་ཡུལ་མ་ཡིན།",
    "ཅི་ཕྱིར་ཟབ་མོའི་དོན་རིག་པ་དག་ཐར་འགྱུར་ཞེས།",
    "དམན་པར་མོས་ཤིང་ཁམས་ཀྱང་ཤིན་ཏུ་དམན།",
    "གྲོགས་པོ་དམན་པ་དག་གིས་ཡོངས་བསྐོར་བ།",
    "འདི་ལ་གལ་ཏེ་མོས་མེད་གྲུབ་པ་ཡིན།",
    "རྨོངས་པ་གང་གི་ཕྱིར་ན་ངེས་པར་བྱེད།",
    "ཟབ་མོ་བྱིས་པའི་སྤྱོད་ཡུལ་མ་ཡིན་པ།",
    "མཐའ་དང་དབུས་མེད་ཚིག་གིས་བརྗོད་དུ་མེད།",
    "ལྷའི་བུ་འདི་ནི་དོན་དམ་པའི་བདེན་པ་ཞེས་སྒྲོ་བཏགས་ཏེ་བརྗོད་མོད་ཀྱི་ཇི་ལྟར་དོན་དམ་པའི་བདེན་པའོ་ཞེས་བྱ་བ་ལྟར་ནི་མ་ཡིན་ནོ་ཞེས་དང་།",
    "ལྷའི་བུ་དོན་དམ་པའི་བདེན་པ་ནི་དམིགས་པ་ཅན་ཐམས་ཅད་ཀྱིས་མོས་པར་དཀའ་འོ་ཞེས་དང་།",
    "ཉོན་མོངས་པ་དང་བཅས་པ།",
    "དོན་དམ་པར་ན་ཀུན་ནས་ཉོན་མོངས་པ་གང་དང་མཉམ་པ་དོན་དམ་པར་ན་རྣམ་པར་བྱང་བ་ཡང་དེ་དང་མཉམ་མོ།",
    "ཉོན་མོངས་པ་རྣམས་ལ་ནི་དེ་ལྟ་མ་ཡིན་ནོ།",
    "མ་དམིགས་པ་ལ་མོས་ཤིང་།",
    "ཉོན་མོངས་པ་དང་བཅས་པ་བླའི།",
    "དཔེར་ན་བརྒྱར་གཤགས་པའི་སྐྲའི་རྩེ་མོའི་ཐོག་མས་མར་གྱི་ཐིགས་པ་བླངས་པ་ཚད་ཡོད་པ་བཞིན་དུ།",
    "གཟི་བརྗིད་ཅི་འདྲ་ཚིག་གི་ལམ་ནས་ནི།",
    "གདེང་ཚོད་དང་བཅས་ཕྱོགས་མེད་བསྟན་འགྲོ་ལ།",
    "བདག་ཀྱང་སྐྱེ་ཀུན་བདེ་གཤེགས་གསུང་གི་མཛོད།",
    "སྲིད་འདིར་ནང་གི་ཉིན་མོར་བྱེད་པ་དེས།",
    "སྤྱི་བོས་རེག་བྱས་རྣམ་དཔྱོད་ཡངས་པའི་སྤྱན།",
    "འདི་ན་ཉིན་མོར་བྱེད་པའི་སྣང་བ་ནི།",
    "ཕྱི་དྲོ་འགྲེལ་བ་འབྲི་བ་སྦྲགས་མའི་ཚུལ་གྱིས་ཐམས་ཅད་འདུལ་ཞེས་བྱ་བ་མེ་མོ་ཕག་གི་ལོའི་ཆོ་འཕྲུལ་ཟླ་བའི་ཚེས་གཅིག་ལ་གྲུབ་པར་བགྱིས་པའི་ཡེ་གེ་པ་ནི་ཚུལ་འདི་ལ་དོན་གཉེར་ཆེན་པོས་འབྱོར་བའི་སྐྱེས་དང་བཅས་ཏེ་ཡང་དང་ཡང་དུ་བསྐུལ་ཞིང་ལྷག་བསམ་གྱི་ཁུར་མཆོག་ཏུ་ལེན་པ་གནས་ལྔ་རིག་པ་ཀརྨ་ལྷག་བསམ་བསྟན་པའི་རྒྱལ་མཚན་ནམ་འཇམ་དཔལ་དགའ་བའི་གོ་ཆ་ཞེས་བྱ་བས་བགྱིས་པ་སྟེ།",
    "རྨད་བྱུང་ཚོགས་གཉིས་ཡོངས་སུ་རྫོགས་པ་ཡི།",
    "མཉམ་མེད་ཐུབ་པ་མཆོག་གི་ཟླ་བ་ནི།",
    "ཐུགས་བསྐྱེད་ཟབ་མོས་སྤར་དུ་ལེགས་བཞེངས་པའི།",
    "མདུན་ཤོག་ཇུས་འགོད་པ་རེན་ཞའོ་ཅུས།",
    "པེ་ཅེན་ཧྲན་དབྱི་ཞང་དབྱང་འགྱིག་པར་ཁང་གིས་དཔར་བཏབ།",
    "དེབ་སྤུས་ལེགས་རེར་སྒོར།",
    "བདེ་སྡུག་གི་ཚོར་བ་བསམ་བློའི་ཁྱེར་སོ་བརྟན་མིན་ལ་རག་ལས་ཡོད།",
    "བདེ་སྡུག་གི་ཚོར་བ་བསམ་བློའི་ཁྱེར་སོ་བརྟན་མིན་ལ་རག་ལས་ཡོད།",
    "རང་རང་སོ་སོའི་བསམ་བློའི་འཁྱེར་སོ་ལ་ཉམས་ཞིབ་བྱས་ན་དེ་དག་གིས་སེམས་རྒྱུད་མ་ཞི་བར་བྱས་ཏེ་བཟོད་མི་ཐུབ་པ་ཞིག་ཡོད་པ་མཐོང་ཐུབ།",
    "ཉོན་མོངས་པའི་སེམས་དེ་དག་མེད་པ་བཟོ་བ་དང་།",
    "རྙོག་དྲ་དེ་དག་གིས་ཁོ་ལ་སུན་སྣང་བཟོ་བའི་རྐྱེན་དེ་ཙམ་བྱེད་མི་ཐུབ།",
    "མཚམས་རེར་སེམས་འདུལ་རྒྱུ་དང་།",
    "སྟངས་འཛིན་བྱེད་རྒྱུ་སོགས་ཁག་པོ་ལྟ་བུར་སྣང་གི་རེད།",
    "རྣམ་དཔྱོད་བཅས་ལ་བརྟེན་དགོས་པ་རེད་སྙམ།",
    "དེ་ལྟར་རྒྱུན་བསྲིངས་པའི་བརྒྱུད་རིམ་ནང་ང་རང་ཚོའི་སེམས་ལ་བསྒྱུར་བཅོས་བཏང་སྟེ་ཡར་རྒྱས་འགྲོ་ཐུབ།",
    "ངའི་ཕ་མ་ལ་ཆ་བཞག་ན་ངའི་ཨ་མ་ལགས་ཧ་ཅང་གི་བཟོད་སྒོམ་གྱི་རང་བཞིན་བཟང་པོ་ཡོད་མཁན་ཞིག་དང་།",
    "ངའི་སྐྱེད་བྱེད་དེ་ལས་ལྡོག་སྟེ་ཧ་ཅང་གི་སྤྲོ་ཐུང་ཐུང་ཞིག་ཡོད།",
    "དེ་ནི་ངས་ཁོང་གཉིས་ཀྱི་རྩ་ནས་ཤེས་པ་རེད།",
    "འགྲོ་བ་མིའི་གོད་ཆག་བྱུང་རིམ་ལ་བལྟས་ན་དེ་དག་ཕལ་ཆེ་བ་མིའི་ཀུན་སྤྱོད་མ་རུངས་པ་དང་ཉོན་མོངས་པའི་སེམས་དཔེར་ན།",
    "འདས་པའི་འགྲོ་བ་མིའི་ཉམས་མྱོང་དང་དུས་སྐབས་སོ་སོའི་ཉིན་རེའི་བྱེད་སྒོ་བཅས་ལ་ཡང་དག་པའི་བརྩད་ཞིབ་མཐིལ་ཕྱིན་པ་བྱེད་རྒྱུ་ནི།",
    "ཉིན་རེའི་འཚོ་བའི་ནང་དཀའ་ངལ་འཕྲད་དུས་དེ་ལ་དངོས་སུ་གདོང་ལེན་བྱེད་སྐབས་གཞན་ཕན་གྱི་ལྟ་བ་ཇི་ལྟར་གཅེས་འཛིན་དང་བསྲུང་ཐབས་བྱེད་དགོས།",
    "ང་ཚོ་ཨ་མའི་མངལ་དུ་ཡོད་པའི་སྐབས་ཨ་མའི་སེམས་ཀྱི་བརྟན་ཆ་དང་།",
    "དེའི་རིང་ཕྲུ་གུ་ཨ་མའི་གཟུགས་པོ་དང་སྦྱར་ནས་ཉར་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་ཡིན།",
    "མིའི་ཕྲུ་གུ་ཚོ་སྐྱེས་ནས་བྱ་བའི་ཐོག་མ་ནི་ཨ་མའི་ནུ་མ་ནུ་རྒྱུ་དེ་ཡིན་ཅིང་།",
    "ཐ་ན་རང་གི་ཨ་མ་ཅི་འདྲ་ཞིག་ཡོད་པའི་གསལ་སྣང་ཙམ་ཡང་མེད།",
    "འོན་ཀྱང་ཨ་མ་ལ་སེམས་ཐག་ཉེ་པོའི་ཚོར་བ་ཏན་ཏན་གྲུབ་ཟིན་ཡོད།",
    "གང་ལྟར་ཨ་མའི་སེམས་ནང་ཕྲུ་གུ་དེ་ལ་ཁོང་ཁྲོ་དང་།",
    "མི་དགའ་བའི་སེམས་གང་ཞིག་གི་ཚོར་སྣང་ཡོད་ཚེ་འོ་མ་འབབ་ཁག་པོ་ཡིན།",
    "ཨ་མའི་ངོས་ནས་ཕྲུ་གུ་ལ་བརྩེ་བ་གཏིང་ཟབ་དང་།",
    "དགའ་གཅེས་ཀྱི་ཚོར་བ་ཟབ་མོ་ཡོད་པའི་སྟབས་ཀྱིས་ཡིན།",
    "ཕྲུ་གུའི་ངོས་ནས་འོ་མའི་ཆེད་དུ་རང་གི་ཨ་མའི་ཕྱོགས་སུ་ཁ་བསྒྱུར་བ་ནི་ང་ཚོ་འགྲོ་བ་མི་རྣམས་ཀྱི་བྱ་བའི་ཐོག་མ་ཡིན།",
    "ང་རང་ཚོ་སྐྱེས་རྗེས་ཀྱི་ཟླ་བ་ཁ་ཤས་དང་ལོ་ཁ་ཤས་རིང་གཙོ་བོ་ཕ་མ་དང་།",
    "སྤྱིར་བཏང་ཁོང་ཚོའི་བྱམས་བརྩེ་དང་འགན་ལེན་མེད་ན་ཕྲུ་གུ་དེ་འཚོ་གནས་ཡོང་མི་ཐུབ།",
    "བཞིན་བསྡུས་ནས་བསྡད་ཡོད་ན་ང་ཚོའི་སེམས་ལ་རང་བཞིན་གྱིས་མི་བདེ་བ་ཡོང་བ་དང་།",
    "ང་ཚོ་རྒན་འཁོགས་ཆགས་པའི་སྐབས་སུའང་ད་དུང་མི་གཞན་གྱི་བརྩེ་བ་དང་།",
    "ང་ཚོས་སྦྲང་བུ་དེ་ཚོར་ཞིབ་ཏུ་བལྟས་ན།",
    "ལས་ཀ་མཉམ་དུ་བྱེད་དགོས་པ་ཞིག་རང་བཞིན་གྱིས་ཡོང་གི་ཡོད།",
    "ཡིན་ནའང་མཚམས་རེར་ང་ཚོས་གནས་ཚུལ་དེ་ལས་ཡོངས་སུ་ལྡོག་པའི་བྱ་བ་བྱེད་ཀྱི་ཡོད།",
    "ང་ཚོ་འཚོ་གནས་ཐུབ་པ་ཡང་།",
    "ང་ཚོའི་གཟུགས་པོའི་ཆ་ཤས་ཚོགས་པའི་མཉམ་འབྲེལ་ལ་བལྟོས་པ་ཡིན།",
    "སོ་སོ་རང་ཉིད་དེ་དག་ལ་བརྟེན་དགོས་པ་ལྟར་རང་གི་ཁེ་ཕན་ཆགས་ཡོད།",
    "ངོས་རང་དུས་རྒྱུན་གད་མོ་དགོད་རྒྱུ་དང་སྐྱིད་ཉམས་སྟོན་རྒྱུར་དགའ་པོ་ཡོད།",
    "དེ་ལས་ལྡོག་སྟེ་བཅོས་མིན་ལྷག་བསམ་གྱི་འཛུམ་མདངས་ཀྱིས་ང་ཚོའི་སེམས་ལ་ཡིད་ཚིམ་པའི་ཚོར་སྣང་ཤུགས་ཆེ་ཡོང་གི་ཡོད།",
    "འཛུམ་མདངས་དེ་གང་ལ་བརྟེན་ནས་ཡོང་གི་ཡོད་ཅེ་ན་དེ་ནི་ཁོང་ཁྲོ་དང་།",
    "ཕ་རོལ་པོའི་ངོས་ནས་ཀྱང་དེ་ལྟར་གུ་ཡངས་ཀྱི་རྣམ་འགྱུར་སྟོན་གྱི་རེད།",
    "ངོས་རང་གི་ཉམས་མྱོང་ནས་དཔེ་མཚོན་ཞིག་ཞུས་ན།",
    "ལྷད་མེད་དང་སེམས་ཐག་ཉེ་བོའི་འདུ་ཤེས་ཀྱིས་ཕན་ཚུན་བསམ་ཚུལ་སྤེལ་རེས་དང་།",
    "ཁེ་ཕན་ལ་འབྲེལ་བ་ཡོད་སྟབས་དེ་ནི་རང་གཅེས་འཛིན་རེད།",
    "གལ་སྲིད་ང་ཚོར་ལྷག་བསམ་ཟོལ་མེད་ཀྱི་བསམ་བློ་ཞིག་ཡོད་ན་བློས་ཐུབ་ཀྱི་གྲོགས་པོ་རག་རྒྱུ་དང་།",
    "མཐའ་འཁྱོལ་གྲུབ་འབྲས་ཀྱི་འབྱུང་ཁུངས་ཀྱང་གཞན་ཕན་གྱི་བསམ་པ་ཡིན།",
    "མི་ཚེའི་ནང་ལས་ཀ་མཐའ་འཁྱོལ་བ་དང་གྲུབ་འབྲས་ཡག་པོ་ཡོང་བ་ནི་སེམས་ཤུགས་དང་།",
    "དེ་དག་གི་འབྱུང་ཁུངས་ཀྱང་གཞན་ཕན་གྱི་བསམ་པ་ཡིན།",
    "གང་དང་གང་ཡིན་ཀྱང་མཐར་ཐུག་ང་རང་ཚོའི་ཁེ་ཕན་ལ་འབྲེལ་བ་ཡོད་པ་བསྟན་པར་མ་ཟད།",
    "ཁོང་ཁྲོ་དང་ཞེ་སྡང་གི་རིགས་ཉམས་དམོད་པར་བྱེད།",
    "ང་ཚོ་སུ་ཡིན་ཀྱང་སྐད་གྲགས་དང་།",
    "ང་ཚོས་དུས་རྒྱུན་གང་ཟག་གཞན་ལ་ལྟ་ཕྱོགས་ཀྱི་བསམ་བློའི་འཁྱེར་སོ་དགོས་ཤིང་།",
    "སོ་སོར་ཡོད་པའི་ཉོན་མོངས་ཕྱོགས་ཀྱི་སེམས་དེ་དག་ལ་འདུལ་སྦྱོང་ཇི་ལྟར་བྱེད་དགོས་པའི་ཐད།",
    "ང་ཚོའི་སེམས་ལ་སྐྱེ་བ་ཐོག་མ་མེད་པ་ནས་ཉོན་མོངས་ཕྱོགས་ཀྱིས་ཤུགས་རྐྱེན་ཆེན་པོ་ཞིག་ཡོད་སྟབས།",
    "དུས་རྒྱུན་ང་ཚོས་ཉོན་མོངས་ཀྱི་སེམས་ལ་འཐབ་དགོས་པ་དང་།",
    "དེ་ཡང་ཁོང་ཁྲོ་ལྟ་བུའི་ནུས་སྟོབས་ཅན་དེ་དག་ལ་ང་ཚོས་ཐབས་ལམ་སྣ་ཚོགས་སྤྱད་དེ་འཐབ་དགོས།",
    "རང་གི་དགྲ་ཁ་གཏད་དགྲ་བོ་ལ་དམིགས་པའི་ཁོང་ཁྲོ་ལ་གདོང་ལེན་བྱེད་པའི་ཐབས་ལམ་གཅིག་ནི་ཕ་རོལ་པོའི་ལེགས་པའི་ཡོན་ཏན་གྱི་ཆ་ལ་དམིགས་པ་གཏོད་རྒྱུ་དེ་ཡིན་པ་དང་།",
    "ཁོང་ཁྲོ་ལངས་པའི་སྐབས་སུ་ང་ཚོའི་སེམས་ནང་ཕ་རོལ་པོའི་ཉེས་པའི་ཆ་གཅིག་པུ་ལས་གཞན་མཐོང་ཐུབ་ཀྱི་མེད།",
    "ཕྱོགས་གཅིག་ནས་ཁ་གཏད་ཀྱི་དགྲ་བོ་དེས་ང་ཚོར་དཀའ་ངལ་བཟོ་བཞིན་ཡོད་ནའང་།",
    "འདོད་རྔམས་སོགས་ཉོན་མོངས་ཕྱོགས་ཀྱི་སེམས་འཕེལ་བའི་སྐབསསུ་གདོང་ལེན་བྱེད་རྒྱུའི་གྲ་སྒྲིག་ཨང་གསར་བྱེད་དགོས་ཤིང་།",
    "གལ་སྲིད་ཉོན་མོངས་ཀྱི་སེམས་འཕེལ་བའི་སྐབས་སུ་ཁ་གཏད་མ་བཅག་པར་ལྷོད་ཡངས་སམ།",
    "སྣང་མེད་དུ་བཞག་ན་ཉོན་མོངས་ཅན་གྱི་སེམས་དེ་དག་ཤུགས་ཆེ་རུ་འགྲོ་ངེས་ཡིན།",
    "དེས་ན་ཉོན་མོངས་ཀྱི་སེམས་གང་ཞིག་སྐྱེས་མ་ཐག་དེ་བཟློག་ཐབས་ཀྱི་འབད་བརྩོན་བྱེད་དགོས།",
    "གལ་ཏེ་གཉོམ་ཆུང་དང་དྲང་པོ་དྲང་བཞག་བྱས་ན་མི་ཁ་ཤས་ཀྱི་ང་ཚོའི་ཁེ་ཕན་འཕྲོག་སྲིད།",
    "སྐྱེས་ཕོ་མོ་གང་ཞིག་ཡིན་ཀྱང་ཁོ་རང་ཚོའི་འདོད་པར་གང་ཡོད་ཀྱི་ལས་མ་རུང་བ་བྱེད་དུ་བཅུག་ན་མཐའ་མར་ཁོ་རང་ཚོར་གནོད་རྒྱུ་ཡིན་སྟབས།",
    "ཕ་རོལ་པོར་ཚིག་རྩུབ་སོགས་རང་གི་ངང་གིས་ཐོན་སྲིད།",
    "རིམ་པས་ཁོང་ཁྲོ་ཞི་བའི་རྗེས་སུ་རང་ཉིད་ཁ་སྐྱེངས་པའི་གནས་ཚུལ་མང་པོ་ཡོང་གི་ཡོད།",
    "དང་པའི་ཨེམསལས་ཕུལ་བྱུང་ཞིང་གི་མཆོག།",
    "དེ་ནས་བཟུན་ཏེ་ཁྱད་ཆུབ་བར་དུ་ཁྱོད་མིན་སྐྱབས་གཞན་མི་འཚོལ་བས།",
    "བཅས་འཚམས་སྲོག་གིཕྱིར་ཡང་མི་གཏོང་ཞིང་།",
    "འགོན་པོ་ཁྱོད་ཀྱིས་འབྲལ་མེད་རྗེས་བཟུང་ནས།",
    "ིམཛོ་༤ལེགས་པར་མཐོང་བའི་མོས་གུས་ཀྱིས།",
    "རོ་བརྒྱུའི་ཞལ་ཟས་སྙན་བརྗིད་རོལ་མོའི་སྒྲ།",
