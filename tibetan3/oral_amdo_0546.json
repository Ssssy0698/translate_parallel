    "སུ་ཞིག་འབྲས་བུ་འདོད་ན་ཐམས་ཅད་རྩེ་མོ་བྱུང་རྒྱལ་གནུབས་ཆེན་མཁྱེན་པའི་ཏིང་ངེ་འཛིན་ཉིད་ལ་ཡོད་པས་བསྒོམས་ཤིག་པའོ།",
    "བྱང་རྩེ་མོ་ཆུབ་སེམས་ནི་བརྒྱ་ལམ་ལན་ཅིག་ན།",
    "སྐལ་པ་ཅན་རྟོགས་ནས་མ་བསྒོམས་པ་ལ་འགྱོད་པས་རང་གིས་མ་ཁྲེལ་བར་བྱས་ཏེ་བརྩོན་པ་ནི་གོ་བའི་རྟགས་སོ།",
    "ཐོག་མ་མེད་པ་ནས་ལས་སྙད་པཔའི་བཀའ་བཅུ་དྲུགམ་རིག་པ་གཉིས་ཀྱང་བརྩོན་པ་ཆེན་པོ་ཡོང་པའི་ལྟ་བ་ཟབ་མོས་མཐོང་བའི་འོད་ཟེར་གྱིས་སྦྱང་དུ་མེད་པར་གསལ་བསསེ་གོལ་དང་ཉུངས་ཀར་བསྐོར་བའི་ཡུན་ལ་ཀ་ནས་རང་འགྱུར་སྔ་ཐདག་པ་ལ་གནས་བསྒྱུར་བ་དང་གཉེན་པོ་མེད་པའོ།",
    "དེ་ནི་ཐུན་མོང་གི་དོན་དམ་པ་དང་ལྷག་པའི་དོན་དམ་པ་ལས་གྲོལ་བའོ།",
    "རང་གི་མཚན་ཉིད་མ་བཅོས་དེ་བཞིན་ཉིད།",
    "རང་བྱུང་གི་ཡེ་ཤེས་མམཆོག་ཏུ་བདལ་པ་ངེས་པ་བདུན་གྱིས་དངོས་གཞི་གྱུར་པས་ཆེ་བ་ནིསུ་ལ་བསྟན་ཅིང་གོ་བ་དེ་དཔེས་སྤྱོད་ཡུལ་རྣམ་དག་འཇིག་རྟེན་དུ་གསལ་བས་ཡེ་ཤེས་ཆེན་པོའི་ཐིག་ལེའོ།",
    "བཀ་བས་ཀ་གཡའ་ཐལན་ཅལམ་བ་ཨབ་རཁས་བླངས་པའི་སྐུ་གསུང་ཐུགས་འཆད་པ་ལསསྐུ་ནི་སྣོད་བཅུད་ཀྱི་གཟུགས་སོ་ཅོག་མིང་ལས་ངོ་བོ་མེད་བཞིན་ཡེ་ཤེས་རང་སྣང་བའི་ཕྱིརསྐུ་ལྔ་ལ་སོགས་པར་ཁྱད་པར་གྱུར་རྩེ་མོ་པས་མ་བསྡུས་པར་ཀུན་རྒྱན་ཆ་ལུགས་ཐམས་ཅད་པའི་སྐུའི་དཀྱིལ་འཁོར་ལའོ།",
    "ཞེས་པབཅོསབྱུང་སྒྲ་གསུམ་རིལ་གྲགས་སྟོང་ལས་འདས་བཞིན་སྣ་ཚོགས་སུ་མཇལ་བ་ཡེ་ཤེས་ཆེན་པོར་བྱེ་བྲག་མེད་དེ་མ་འདྲེས་ལ་རྫོགས་པ་གསུང་གི་དཀྱིལ་འཁོར་ཏེ་ལྔ་སོགས་གྲངས་དང་བྲལ་བསྟན་རྒྱལ་བས་རྟོགས་དཀའ་བའོ།",
    "རང་གི་ལྟ་བ་བསྙེམས་པའི་ང་རྒྱལ་གྱིས་སྤྱོད་པ་རྩིང་པོར་བྱེད་པ་གོལ་བར་བསྟན་པའི་ཕྱིར།",
    "རང་གི་ལྟ་བ་ཡ་རབས་མཐོ་འདོད་དེ།",
    "འོ་ན་གང་གིས་འགྲུབ་ཞེ་ན།",
    "འདིར་གཉིས་པ་རིལ་དང་རྩེ་མོ་བྲལ་བས་གཞན་ལྟར་བླང་དོར་མེད་པ་ཉིད་ཀྱང་ཆེད་དུ་བྱེད་པ་དང་བྲལ་བས་ལུང་གི་རྒྱལ་པོའོ།",
    "གདུང་བཅོསབྱུང་བ་མེད་པ་བླང་དོར་འབྱེད་པ་མེད་པ་ངང་གིས་གདུང་བ་བྲལ་བས་འགྱོད་པ་མེད་པའགྲོ་དོན་རྩོལ་ཆད་མེད་པའི་ཡེ་ཤེས་མངའ་བ་ནི་ཁྲོ་གཏུམ་བྱམས་པ་ལ་སོགས་པའི་རྩོལ་བ་དང་བསྟན་རྒྱལ་བྲལ་བའོ།",
    "ཀུན་ཏུ་བཟང་མོར་སྦྱོར་ལྡན་དངོས་གྲུབ་ཅན།",
    "རྩེ་མོ་བྱུང་རྒྱལ་གྱི་འགྲེལ་པ་རྫོགས་སོ།",
    "ཆེན་ཉེམ་འགྲེལབཀའ་གཅིག་། མན་ངག་སྲོག་གི་འཁོར་ལོའི་འགྲེལ་པ་བཞུགས་སོ།",
    "འགྱུར་ལྟསྔ་ཟབ་ནས་ས་བ་རྨ་༤༤༤༤ཐཨ་༤མན་། མན་ངག་སྲོག་གི་འཁོར་ལོའི་འགྲེལ་པ་བཞུགསསེམས་ཉིད་ནམ་མཁའ་མཐའ་བྲལ་དབྱིངས་འདས་ལྷུན་རྫོགས་ཅིར་ཡང་གསལགཞལ་བྱ་རང་བཞིན་གསུམ་གཉིས་ལྔར་ངག་རྫོགས་རྒྱུ་འབྲས་དབྱེར་མེད་སྐུ།",
    "ཞེས་བྱ་བགང་དག་སྡུག་བསྔལ་གསུམ་པོ་དག་ནི་གདུང་བ་དང་སྐྱོ་བ་དང་སུན་འབྱིན་པས་བྲལ་བར་འདོད་པ་ནི་མྱ་ངན་ཏེ་དེ་དག་གི་ངོ་བོ་ཉིད་ཤེས་པསདེ་བཀག་བ་ཀ་༤དག་ལ་མི་གནས་པ་ནི་ཡོངས་སུ་གྲོལ་ཏེསྤྱོད་ཡུལ་དུ་མི་བྱེད་པས་མིང་འཐོབ་བོ།",
    "གང་གིས་དེ་དག་ངོ་བོ་ཉིད་ཡོངས་སུ་ཤེས་པས་འཆིང་བ་ལས་ཡོངས་སུ་གྲོལ་བ་ནི་མྱ་ངན་ལས་འདས་པར་བརྗོད་དེ།",
    "དེ་དག་བསྟན་བཅོས་སྲོག་རང་གི་མཚན་ཉིད་ལས་མི་འདའ་བ་ཡང་མུན་པའི་ངོ་བོ་ཉིད་ཡོངས་སུ་དག་པས་བསྒྲུབ་བྱ་རིལ་ལུས་པ་མེད་པ་དང་།",
    "དེ་དག་གི་ཡོན་ཏན་གྱི་ཁྱད་པར་དང་དགོངས་པའི་རྒྱུད་ནི་བགྲང་ཞིང་བསམ་པ་ལས་འདས་ཀྱང་གདུལ་བྱ་མི་ལྕོགས་པ་རྣམས་ལ།",
    "དེ་ནི་གཞན་གྱིས་མ་རེག་པའི་ཕྱིར་རྒྱལ་བ་འབའ་ཞིག་གི་སྤྱོད་ཡུལ་བཀའ་ལྔརིའི་ཏེ་མི་བཟད་པ་རྒྱན་གྱི་འཁོར་ལོ་ཡང་།",
    "རང་གི་ངོ་བོ་ཉིད་མི་དམིགས་པས་སྣང་སྟོང་མཉམ་པའི་ངོ་བོ་ཉིད་ནི་ཨ་ཏི་ཡོ་ག་རང་གི་ངོ་བོ་སྟེདེ་ཉིད་ཚིག་དང་ཡི་གེ་ཐམས་ཅད་འདས་འགྱུར་སྔ་ཀྱང་གདུལ་བྱ་ལ་མཚོན་པར་བྱ་བའི་དོན་དུ་གསུངས་པ་ནི་མན་ངག་འདི་དག་གོ།",
    "དགའ་རབ་ལ་སོགས་པ་འཁོར་དེ་དག་གི་རྗེས་སུ་ངེས་པར་བྱུང་བ་ནི་རིགས་འཚོབ་པ་སྟེ།",
    "ཐམས་ཅད་བདག་ཉིད་དུ་གྱུར་པས་གཞན་ཀུན་བཅད་པ་ནི་མཉམ་པ་ཉིད་དོ། ། ཡིད་ཀྱི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་གང་ཡང་མ་སྤངས་པ་ནི་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡེ་ཤེས་སུ་གསུངས་པས་རྣམ་པར་ཤེས་པ་སྟེ་མཐའ་དང་བྲལ་བར་གང་དག་གིས་འགྲེལདོན་སོ་སོར་ཡོངས་སུ་གྲུབ་པ་ནི་རང་གི་ས་ཉིད་དེ་དོན་ཡོངས་སུ་བཙལ་ན་མི་རྙེད་པས་ཡེ་ཤེས་སུ་གསུངས་སོ།",
    "ཀུན་ཏུ་བཟང་མོ་ཡུམ་གྱི་བྷ་གར་བཤད།",
    "གཅིག་གི་ངོ་བོ་ཉིད་ཀྱང་གདུལ་བྱས་དུ་མར་སྣང་བའི་ཕྱིར་ཏེ།",
    "དེ་ནི་ཐམས་ཅད་ཀྱི་རྒྱུ་གཅིག་ཏུ་གྲུབ་པའི་ཕྱིར་གཉིས་སུ་སྣང་བ་དང་བྲལ་བས་བསམ་པའི་གཡོ་བ་མེད་མོད་ཀྱི་སྟོང་གསུམ་རིལ་ཡང་བདག་ཉིད་མན་ངག་ལས་གུད་དུ་མ་གྱུར་པའི་ཕྱིརཐུགས་རྗེ་ཆེན་པོའི་འབྲེལ་བ་ནི།",
    "མྱ་ངན་ལས་འདས་པ་ཐམས་ཅད་སྣང་བའི་གཞི་སྟེ་རང་བྱུང་གི་ཡེ་ཤེསདེ་ཉིད་ལྷུན་གྱིས་གྲུབ་པ་ལ་རྒྱུ་རྩ་ཡོངས་སུ་བཅད་པས་གང་ཡང་རག་མ་ལུས་པ་མེད་དོ།",
    "དེ་དག་གི་ངོ་ཟམ་ཆ་ཆ་བོ་ཉིད་ནི་སེམས་ཉིད་ཀྱི་ཕྱིར་ཡེ་ཤེས་སུགསལ་བས་རང་གི་ངོ་བོ་ཉིད་དང་བྲལ་བ་དང་ཡེ་ཤེས་ཉིད་ཀྱི་ཕྱིར་མ་སྤངས་ཏེ་ཡན་ལག་དང་བཅས་པ་རྗེས་སུ་མཐུན་པའི་ཕྱིར།",
    "གང་ཟག་གིས་མ་རེག་པས་དོན་དམ་པ་སྟེ།",
    "དེ་དག་གི་ཆོ་འཕྲུལ་ནི།",
    "འབྲས་བུ་དེ་དག་གི་རྒྱུ་དང་རྒྱུའི་རྒྱུ་ཤེས་རབ་ཀྱིས་ཞིབ་པར་བརྟགས།",
    "ཞེས་བྱ་བ་དང་ཡང་ལུང་དག་ལས་རྒྱུ་ཉིད་རང་གི་སེམས་ཡིན་པས།",
    "བསམ་པའི་ངང་གིས་དེ་ཉིད་དམ་གཞན་དུ་བརྗོད་དུ་མི་རུང་བའི་ཚུལ་དུ་བསྟན་ཏོ།",
    "དེ་ཡང་རང་གི་ངོ་བོ་མ་གྲུབ་པ་ཉིད་ཡུམ་གྱི་ཕྱིར་ཐམས་ཅད་ཀྱི་རྒྱུ་ནི་ཐ་མི་དད་པས་གཅིག་ཞེས་སྨོས་སོ།",
    "བཀའ་བཅུ་དྲུག་ཀུན་ཀྱང་བདག་ཉིད་དུ་མངའ་མཛད་པ་ནི་དཔེ་དང་བྲལ་བས་གོང་ན་མེད་པའི་ཕྱི་རང་བྱུང་གི་ཡེ་ཤེས་དངོས་པོ་གང་དུ་ཡང་མ་ངེས་ན་ཅིས་ཀྱང་མ་བསྒྲིབས་པ་ཉིད་ཐམས་ཅད་ཀྱིའགྱུར་རྒྱུའི་ཕྱིར་ཐུགས་སུ་གསུངས་སོ།",
    "ཞེས་གསུངས་ཏེརང་བྱུང་གི་ཡེ་ཤེས་ལ་འབྲས་བུའི་སྔ་པཡོན་ཏན་ཏེསྐུ་གསུང་ཐུགས་ཡོན་ཏན་ཕྲིན་ལས་བསམ་ཡས་པ་ཐམས་ཅད་ཡེ་ནས་རྫོགས་པའི་ཕྱིར།",
    "རང་གི་མཐུའི་རིག་པ་ལས།",
    "དངོས་པོ་ཐམས་ཆེན་ཅད་ཀྱང་ཕྱོགས་བཅུས་བསྡུས་པའི་ཕྱིར་ཏེདེ་ཉིད་རང་བྱུང་གི་ཡེ་ཤེས་སུ་རྒྱས་བཏབ་པཕྱོགས་བཞི་མཚམས་བརྒྱད་སྟེང་འོག་བཅུ།",
    "ལྡན་ཞེས་པས་ལོག་རྟོག་ཅན་ཐམས་ཅད་དུ་ཐལ་བར་མི་འགྱུར་བསྟེངོ་བོ་ཉིད་མ་བཅོ་ནི་མི་འདོད་པ་མ་ཡིན་ནོ།",
    "གཉིས་མེད་མན་ངག་སྲོག་གི་འཁོར་ལོ་ཞེས།",
    "བསམ་ཞིང་སྣང་བ་ཡང་ཅིག་གི་རྗེས་སུ་ཐམས་ཅད་འགྱུར་བའི་ཕྱིར་ཏེདེ་ཉིད་སྟོན་པའི་ཡི་གེ་འདི་ཡང་བྱ་བ་དང་བྱེད་པའི་ཚུལ་གྱིས་མིང་ཐོབ་བོ།",
    "འགྲོ་བ་རིལ་ལ་ཐུན་མོང་དུ་བྱས་པའོ། ། ངག་བཅོསསྲོག་མན་ངག་སྲོག་གི་འཁོར་ལོའི་འགྲེལ་པ་རྫོགས་སོ།",
    "དེ་ཉིད་སྤྲོས་བྲལ་མཐའ་རྣམས་ངང་གིས་དག།",
    "བདེ་བ་ཆེན་པོ་མཚན་ཉིད་མངོན་དུ་འབྲེལ་པ་དང་བཅས་པར་སྟོན་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་མན་ངག་ལརེ་ཤིག་ཉེ་། འབྲུ་གཉེར་དྲངས་ལ་བག་ཅིརྡོར་ཆེན་སོགས་གཉིས་མེད་ཀྱིས་བསྟོད།",
    "ཐིག་ལེ་ཆེན་པོ་ལ་སྤྲོས་པ་སྣ་ཚོགས་སུ་སྣང་བ་ནི་རང་གི་རྒྱུན་ཙམ་སྟེ།",
    "དེ་དག་གི་བཅིངས་པ་ནི་དྲི་མ་བཞིན་རང་ལས་བྱུང་ངོ།",
    "རྨོངས་པའི་རང་བཞིན་ཅན་ནི་ཀུན་ནས་ལྡང་བ་མང་ཆེན་པོས་སེམས་རྙོག་མ་ཅན་གྱིས་ཟབ་མོ་བལྟ་བར་དཀའོ།",
    "དེས་ན་འདིས་ཞོན་པས་དོན་མེད་སྒྲ་ཕྱིར་དེ་འབྲངས་ན་མ་རིག་པསཞེས་བྱ་བ་གསུངས་ཏེགང་ཟབ་མོ་ལ་བློས་རྟོག་པས་མ་རེག་པ་ལྷེ་། ནི་ཟབ་མོ་ལ་དད་པ་ཡོད་ཀྱང་རྒྱུད་སྔ་མས་ཟིན་པས།",
    "ཞེས་བྱ་བསྒྲས་སྤངས་པ་ཅེས་པ་བསྟན་པ་ཡང་ཆེད་དུ་རྩོལ་མ་རིགས་པས་དགེ་རྩའི་ཕྱོགས་ཀུན་སྤོངས་ཚིག་གི་ལྟ་བས་བ་ནི་ཁུར་བུ་འདུ་ཤེས་བྱེད་དེ་སྤང་ངོ།",
    "མཐའ་ཐམས་ཅད་དང་བྲལ་བའི་དོན་ནི་དབུས་ལ་ཡང་མི་གནས་གང་གི་ཕྱོགས་སུ་ཡང་མ་གྱུར་པར་བདག་པོ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ནམ་མཁའི་མེ་ཏོག་ལག་གིས་བཅོས་པར་འདོད་པ་ནི་ཚི་ཆད་པས།",
    "ཞེས་བྱ་བ་ལམ་རྒྱུད་དྲུག་གི་རང་གི་རྟོག་པ་ཙམ་པས།",
    "དངོས་པོའི་གནས་ལུགས་ཐ་དད་ཀྱི་རྗེས་སུ་འགྱུར་བ་མེད་དེསྣང་ཚོགས་གང་ཡང་ཡིད་ལ་མི་བྱེད་པས་བསམ་པ་མཉམ་པའོ།",
    "ཡེ་ཤེས་མམཆོག་གི་བདེ་བ་ཆེན་པོའི་ས་འདི་ད་ལྟ་ཉིད་ནས་དེ་བཞིན་གཤེགས་པའི་བསྟན་འཁོར་དགོངས་པ་ལ་བཞུགས་པས།",
    "ཡེ་ཤེས་མཆོག་གི་ས་ལ་མི་གནས་པའི་ཚུལ་གྱིས་གནས་པའི་ཕྱིར་རོ།",
    "ཀུན་ཏུ་བཟང་པོ་བདེ་བ་ཆེན་པོ་ལས་མ་ཉམས་ནའཇིགས་པ་དེ་དག་གིས་མི་ཚུགས་ཤིང་།",
    "ཅིའི་ཕྱིར་ཞེ་ནའདུ་འབྲལ་མེད་པའི་ཤེས་རབ་ཀྱི་ཚལ་ཆེན་པོ་ནི་དངོས་གྲུབ་ཡིན་གྱིཆོ་འཕྲུལ་དང་འགྲེལ་ཁྱད་པར་སྣ་འགའ་ཙམ་ནུས་པ་ནི་ཟད་ཤེས་པའི་མཐུ་འཕྲ་མོ་ཙམ་ཡིན་ནོ།",
    "འདུ་འབྲལ་མེད་པའི་གཟུངས་ཀྱི་རྒྱལ་མོ་ཀུན་ཏུ་བཟང་པོའི་དོན།",
    "རྫོགས་པ་ཆེན་པོ་ཐོབ་པར་བྱེད་པའི་ཐབས་ཀྱི་རྒྱལ་མོ་ཡིན་པའི་ཕྱིར།",
    "མིང་གི་རྣལ་འབྱོར་རྣམས་ཀྱི་ཐུན་མོང་མིན།",
    "རྟོགས་པ་རྙེད་སབ་༤བབ་ཐཔ་༤༣ མས་ལགན་མཐའ་ཡས་ཞིང་རྣམས་བདག་གི་རྡོ་རྗེ་སྐུར་གསལ་ཏེ་ཡོན་ཏན་གྱི་ཟླ་མེད་པའོ།",
    "དེ་ལྟ་བུའི་ཕྱིར་རེ་བ་གསུམ་དང་དོགས་གསུམ་བྲལ་བས་ཡེ་ཤེས་ཀྱི་ནམ་མཁར་གསལ་བའོ།",
    "ངང་གིས་གཞན་པ་བྲལ་བའི་ཕྱིར་ཀུན་ཀྱང་བདག་ཉིད་ཡིན་པས་ལེགས་པ་ཆེན་པོའོ།",
    "ཀུན་ནས་འདུས་པས་སྲོག་གི་མཆོག།",
    "འགྲོ་བ་རིགས་དྲུག་ཡེ་ནས་མཐའ་གསུམ་བྲལ་བས་རང་བྱུང་གི་ཡེ་ཤེས་ཉིད་ཡིན་པའི་དོན་མཇལ་བའོ།",
    "དེ་ལས་ཧཱུྃགིས་དོན་ཅིག་རྙེད།",
    "ཞེས་པ་དཔྱད་ཐབས་ནིགལ་ཏེ་བརྡ་མ་ཡིན་པར་ཡི་གེ་ཁོ་ནས་མཚོན་ནས་སྒོམ་མོ་ཞེ་ནའང་།",
    "ཡི་གེ་དངོས་པོ་གང་གིས་བགྱི།",
    "འདིའི་གསུང་རྣམ་པ་དང་བྲལ་བ་དེ་ཡི་གེ་ཕྱོགས་ཆ་ཅིག་གིས་ཇི་ལྟར་འགྲུབ་དྲིས་པའོ།",
    "རིགས་པའི་ཡེ་ཤེས་འབྲུ་གསུམ་རེ་རེས་མཚོན་པའི་ཐ་སྙད་མེད་པར་གསུམ་ལྷུན་གྱིས་གྲུབ་པའི་ངོ་བོའོ།",
    "ཉོན་མོངས་དྲུག་ཉིད་རང་བྱུང་བའི་ཡེ་ཤེས་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ཡང་རྣམ་པ་ཅན་ཞིག་ཏུ་མེད་པའི་ཕྱིར་དངོས་པོར་ཐལ་བ་མེད་པ་སེམས་སོ།",
    "ངང་གིས་སྒྲོ་སྐུར་བྲལ་བར་གསུངས་འགྲེལཔའོ་ དཀར་ལ་ལྡེམ་ཚེར་དག་པ་སྟེ།",
    "ཐུན་མོང་མ་ཡིན་པའི་བསམ་དཔྱོད་ཀྱིས་རྟོགས་སུ་བཏུབ་པའོ།",
    "ཉོན་མོངས་པ་སོ་མ་གྲུབ་པས་དུག་གསུམ་གྱི་དེ་ཁོ་ན་ཉིད་བདེ་བ་ཆེན་པོ་སྟེ།",
    "དེར་མཇལ་བས་ཉོན་མོངས་པའི་བག་ཆགས་རང་སར་རང་གྲོལ་བའོ།",
    "དེ་ལྟ་བུའི་ངང་ལ་གཡང་ས་གང་གི་རིག་པ་ལས་བྱུང་།",
    "འདི་བཙའ་བའི་ཐབས་ནིརྒྱ་མཚོའི་གཏིང་གི་རྡོ་བ་བཞིན།",
    "ཀ་བ་༣་ ཆ་ཉེའགྲེལགཅིག་། རྫོགས་པ་ཆེན་པོ་རིག་པའི་ཁུ་བྱུག་གི་དོན་འགྲེལ་བཞུགས་སོ།",
    "དོན་གསུམ་དུ་བསྡུས་ཏེ་བདག་གིས་བཀྲོལ་བ་འདི་ལྟ་སྟེ།",
    "སྭ་སྟི་དཔལ་གྱི་དཔལ་ཞེས་པས་བགྲོད་དུ་མེད་པས་སྩོལ་བའི་སྡུག་བསྔལ་ཞི་བར་གྱུར་པས་ཐ་མའི་དབུགས་ཆེན་པོ་ཡོངས་སུ་ཕྱིན་པ་ན་རྟེན་མེད་པའི་ངལ་སོས་པའོ་ དེ་བས་ན་དམན་པ་པའི་ལེགས་པའི་ཡོན་ཏན་དག་ལས་ཁྱད་པར་དུདུ་གྱུར་པ་ནིངང་དང་རང་བཞིན་དང་བདག་ཉིད་ཆེན་པོའི་དོན་ཚིག་དྲུག་གིས་རྫོགས་པར་སྟོན་པ།",
    "དེ་ཡང་ཐུན་མོང་གི་བདུད་བཞི་དང་ལྟ་བའི་སྒྲིབ་པ་ལ་སོགསཔ་དག།",
    "རང་ཉིད་རང་བྱུང་གི་ཡེ་ཤེས་རྒྱུ་རྐྱེན་དང་བྲལ་བས་སྐྱེ་ཤི་མེད་པའི་སྲོག་གཟུངས་ཉིད་དུ་བཞུགས་པ་དང་།",
    "དེའི་ཆ་འགྲེལལུགས་ནི་སྣང་གྲགས་རིག་ཤེས་རིལ་རང་སྣང་གི་སྐུ་གསུང་ཐུགས་ཡིན་པའི་ཕྱིར་ཆ་ལུགས་ཐམས་ཅད་པའོ།",
    "འོ་ན་དེ་དག་གི་མཚན་ཉིད་ཅི་ཞེ་ནམི་གཉིས་ཀྱང་ཞེས་པ་དེ་དག་ནི་མིང་ཙམ་སྣང་གི་ངོ་བོ་མ་ངེས་པ་དང་།",
    "ངང་གིས་རང་རྒྱུད་པ་མེད་པ་དང་།",
    "ངང་གིས་མ་གཡོས་པ་ལ་གཡོ་རྡུལ་གྱི་སྤོང་ལེན་མེད་པ་དང་།",
    "ཀུན་ཏུ་བཟང་པོ་ལྔ་སྟེབཟང་ངན་ལས་འདས་པའི་བླ་དགས་ཙམ་ལས་དེ་ཉིད་ལེན་པའང་མ་འགྲེལཡིན་པས་རྩོལ་བར་ཐལ་བ་མེད་པ་ནི།",
    "ཚོགས་ལ་རེ་བའི་རྩོལ་བ་རྣམས་ནི།",
    "དེ་མེད་མི་འབྱུང་དེ་ཕྱིར་རྣམ་གྲོལ་མཆོག་གི་ལམ་ཞེས་པ།",
    "ལུང་བཞིན་ཚིག་གི་མཐའ་སྤྱོད་ལམ་དུ་དེ་མཐོང་བས།",
    "དེའི་རང་བཞིན་ལ་ཚིག་གི་འབྲུ་དང་བྲལ་བས་བརྗོད་དུ་མེད་དེརྫས་སུ་བཅོསརྡོ་ལ་མ་གྲུབ་པས།",
    "ངང་གིས་མིམི་གཡོ་རྨུགས་ཤིང་ཏིང་འཛིན་རྒྱལ་པོར་གནས།",
    "དེ་བས་ན་ཐམས་བཅོས་རྡོ་ན་ལ་ཅད་ཡེ་ནས་གཉིས་སུ་མེད་པ་ལསྤང་བླང་གི་རྫས་སུ་གྲུབ་པ་མེད་དོ།",
    "གཞན་ནས་དངོས་གྲུབ་འོང་དུ་རེ་བ་དང་།",
    "རང་བྱུང་གི་ཡེ་ཤེས་ཡེ་ནས་མ་བཅོས་ལ།",
    "ལྟ་བ་གང་གིས་ཀྱང་མི་འཕྲོགས་པ་ཅིས་ཀྱང་མ་བཅོས་མ་བསླད་པ་ནིགོང་ན་མེད་པས་ཆེན་པོ་ཉིད་ཡིན་པས།",
    "རེ་ཞིང་སྨོན་པའི་དུས་མེད་པས།",
    "བདེ་བའི་སྒྲོན་མེ་འདི་ལས་གཞན་མེད་དོ་ཞེས་བྱ་བ་ནིམན་ངག་ལུང་གི་ཆེ་བ་བསྟན་ཉེ་། པ་སྟེ།",
    "ཀུན་གྱི་ཐུན་མོང་མ་ཡིན་ཞིང་།",
    "བདག་མགིས་དེ་རིང་འགྲེལ་པ་བྱས་པའི་ཕན་ཡོན་དང་།",
    "དེ་ལ་སྤྱིར་རྒྱབ་ལུགས་རྣམ་པ་གསུམ་ལས་རྣལ་འབྱོར་རྣམ་པ་ལ་གསུམ་གྱི་ངོ་བོ་ནི་གཞུང་གིས་བསྟན་ཏེདོན་ཉམས་སུ་རིག་པས་མྱོང་བར་བྱའོ།",
    "གཞུང་སོ་སོར་དབྱེ་བ་ནི་མན་ངག་གིས་དབྱེ་བར་འགྲེལ།",
    "སྤྱི་རང་བཞིན་དང་ངང་ཐ་མི་དད་མོད་འགྱུར་ཀྱི་སྒྲས་སྤྲོས་པ་ཡོངས་སུ་གཅོད་པ་སྟེ།",
    "དེ་དག་ལ་མོས་པ་བསྐྱེད་པ་དང་མངོན་དུ་བྱེད་པ་ནི་ཕྲད་པ་དང་རྒྱུའི་ཕྱིར་ཕྱག་གོ།",
    "དེ་དག་གི་འབྲེལ་བ་ནི་དོན་དཱམ་ངོ་བོ་སྟེ་སྐུའོ།",
    "འོ་ན་དེ་ན་དེ་དག་ནི་མཐོང་བ་མེད་པས་གུད་དུ་གྱུར་ཏེ་བདག་ཅག་གིས་ཤེས་པར་དཀའོ་སྙམ་པ་ལཡོད་གསུམ་དང་མེད་པའི་མཐའ་ནི་དབྱིངས་སུ་གཅིག།",
    "དེ་ཉིད་མིང་གིས་མཚོན་པ་སྟེ་རིལ་པོ་དང་བྱེད་པ་ལྟ་བུ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལོག་པའི་ཕྱིར་རང་གི་ངོ་བོ་མ་གྲུབ་ཀྱང་ཡེ་ཤེས་ཆེན་པོའི་དོན་གྱིས་ལྟ་བ་ཞེས་སྨོས་ཏེ་ལྟ་བ་པོ་ཉིད་ཀྱང་ཡང་དག་པར་མི་གཞན་ནོ།",
    "དེ་དག་གིས་རིས་སུ་རྟོག་པ་ཡང་འགྲོ་བ་དྲུག་དང་རིན་བསྟན་བཅོས་ཆེན་ཕྱག་རྒྱ་ལ་སོསོགས་པ་རེད་པས་དེ་དག་སྣང་བ་ནི་གཞི་ལ་མ་ངེས་པས་སྣང་བ་ཐམས་ཅད་མི་ཆད་པཔར་གསུངས་སོ།",
    "འོན་ཏེ་ནབདག་ཅག་གི་མྱ་ངན་ལས་འདས་པ་ནི།",
    "ཆ་ས་རྨ་ཟ་ཨལ་ལས་མཆོག་གི་ལམ་ཞེས་པགང་ཐིག་ལེ་ཆེན་པོ་ལ་མཚན་ཉིད་མ་གྲུབ་པ་ཉིད་པས་དེ་དག་སྣང་བ་ནི་བཏགས་པ་ཙམ་མོ་ཞེས་ཟེར་བ་ཡང་བདེན་མོད་ཀྱི་དོན་ཀྱང་དེ་དག་ལ་བརྟེན་པ་ལུས་ལ་སོགས་པ་རྗེས་སུ་མཐུན་པའི་འབྲས་བུར་ཤེས་པས།",
    "དེ་དག་ཉིད་གོང་ན་མེད་པར་སྣང་བ་ཡང་སྔ་མ་ལ་བརྟེན་པས་ལམ་མོ།",
    "སྦྱོར་བའི་ལུང་སྟོང་ཕྲག་དུ་མ་ནི་ཟ་ཧོར་དང་མ་ཐུང་གི་ཡུལ་ན་རྒྱས་པར་སྤྱོད་དོ།",
    "སྒྲོལ་ལུང་སྟོང་ཕྲག་དུ་མ་ནི་ཐོར་དང་ཀོས་བྲང་གི་འགྱུར་སྔ་ཡུལ་ན་རྒྱས་པར་སྤྱོད་པ་ལ་སོགས་པ་ལྟ་བུས་བསྟན་ནོ།",
    "ཐ་སྙད་ཙམ་དུ་འདུལ་ཞེས་བྱ་མོད་ཀྱང་།",
    "དེ་དག་སེམས་ཉིད་ཁོ་ན་བས་རང་གི་མཚན་ཉིད་དུ་ཆ་ཕྲ་བ་མཡང་མ་རྙེད་པས་དེའི་ཕྱིར།",
    "དེ་དག་གི་འབྲས་བུ་ཇི་ལྟ་བུ་སྙམ་པ་ལཡེ་ཤེས་ཀླུང་དུ་ཤར་བའི་རྣལ་འབྱོར་པཞེས་པ།",
    "ཀ་ཆ་ཡེ་ནས་ཤེས་པ་ནི་རང་བྱུང་གི་ཡེ་ཤེས་སོ།",
    "དེ་དག་རྒྱུ་རྐྱེན་གྱིས་མ་བྱས་པ་ཡང་ངེས་ཚིག་བསྟན་ཆེན་ཀུན་གིས་བསྒྲུབས་ཏེ་རིལ་རྫོགས་པས་འཕེལ་བར་བྱ་བ་མེད་པའོ།",
    "དེ་དག་རིལ་ཐ་སྙད་གང་གིས་ཇི་ལྟར་ཞེ་ནཡེ་ཤེས་འོད་གསལ་ཆེན་པོས་བསལ་ལོ།",
    "ཞེས་བྱ་ཉེའགྲེལ་། བ་དེ་དག་གོ་ཞེས་ཟེར་བ་ནི་བདེན་མོད་ཀྱི་བསལ་ཞེས་སོ་དོན་མེད་པར་འགྱུར་པས་རིགས་པ་མིན་ཟེར་བ་ཡིན་ནོ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་ནི་མུན་འགྱུར་སྔ་པ་ངང་གིས་མེད་པའི་ཕྱིརའཛམ་བུའི་གླིང་ཐམས་ཅད་གསལ་བར་བྱེད་དོ།",
    "དེ་དག་གི་ཏིང་ངེ་འཛིན་བསྟན་པའི་ཕྱིར།",
    "གལ་ཏེ་མ་གོམས་པ་དག་གི་སྤང་སྟེ།",
    "ཀྱང་ཞེས་པ་ནི་གཞན་དག་གི་ལུགས་ཀྱིས་མི་མཐུན་པའི་སྟོན་པ་སྟེ།",
    "བཀོལ་བ་མེད་དེ་ཀུན་གྱི་རེ་སྐོངས་བའི།",
    "མ་བཀོལ་བ་དེ་དག་ཉིད་ན་གདེང་གི་བློས་དུས་གསུམ་དུ་འདུ་ཤེས་མ་གཡོས་པ་ནི་མཉམས་པ་ཉིད་དོ།",
    "དེ་དག་གི་ལས་དང་འབྲས་བུ་བསྟན་པའི་ཕྱིར།"
  ]
}