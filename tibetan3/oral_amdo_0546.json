    "འདིར་རང་བྱུང་གི་ཡེ་ཤེས་སྣང་སྟོང་ཀར་དག་པའི་མ་ད་ཀྱིས་བཀའ་གདེང་གིས་ཟིན་པ་ནི།",
    "དེ་ནི་ངོ་བོ་དང་ཡུལ་ཞིག་གིས་ཕྱེ་བ་མེད་དེབདག་ཅག་གི་སྤྱོད་པ་མཁ་ལ་མ་ར་པ་ཐ་མ་ཡ་༤༤དྲང་ཡུལ་གྱི་རྣམ་པ་དང་རྟོག་པ་རྣམས་ནི་སེམས་ཉིད་ཁོ་ན་བས་སྤང་ཞིང་བསལ་དུ་མེད་དོ།",
    "གང་གིས་ཉམས་སུ་བླང་བ་གཉིས་པོ་ནི་རྣམ་པར་དག་པ་གཉིས་ཀྱི་སྒྲས་། ཕྱོགས་ཐམས་ཅད་ཡོངས་སུ་བཅད་པ་ཡིན་ཏེརིལ་ཡིན་པའི་དོན་གྱིས་ཁྱབ་ལ་ཁྱབ་པའི་དོན་གྱིས་གཞི་མེད་དེ་དཀྱིལ་འཁོར་དང་བྲལ་བར་བསྟན་པ་ཡིན་ན།",
    "གདེང་གི་ཉམས་མེད་ཅིང་གལ་ཏེ་ན་ཡང་རྗེས་སུ་དཔོག་པ་དང་མཐུན་པའི་ངེས་པ་མ་རྙེད་ཅིང་གལ་ཏེ་ན་ཡང་སྒྲ་མངོན་དུ་བྱེད་འགྲེལ་པའོ་ གཞན་ཡང་རིག་པ་ལསམཉམ་པའི་གདེང་མེད་སྟོང་པའི་ཕྱོགས་ལ་ཞེན།",
    "བསྟེན་དང་ལམ་ནོར་རྟོག་པས་ཟིན་ཏ་རེ།",
    "བློ་གཞན་བདག་གིས་དགྲོལ་བར་མི་འོས་ཉེའགྲེལ།",
    "ཀྱང་ ཕྱོགས་འགའ་མཐོང་བའི་རང་གི་བརྗེད་བྱང་བྲིས།",
    "བདག་ཀྱང་ཐམས་ཅད་ཡིན་པའི་ཕྱིར་ཕྱི་ནང་གི་བར་ཆད་གཏུལ་ལ།",
    "ཞེས་པ་འདིར་ཟིན་པ་དྲུག་གི་དོན་གྱིས་འདུ་བྱེད་ཉེའགྲེལ་། ཐམས་ཅད་བྲལ་བར་བདག་ཉིད་གནས་པ་ལ།",
    "རྒྱུ་འབྲས་ཀྱི་ཅུརྩ་བ་ལ་ཤེས་ཐོབ་ཏུ་རེ་བས་ལོགས་སུ་གཉེར་བ་དང་།",
    "ངང་གིས་བྲལ་བ་ནི་ཚོལ་བའི་དམ་པའོ།",
    "ཞེས་པ་བདག་ཉིད་ཕྱི་མོ་ནས་འབྲས་བུའི་སྡོང་པོ་ཡིན་པའི་ཕྱིར།",
    "རེ་བ་དང་བྲལ་བས་འབྲས་བུའི་རྟེན་གཞི་རང་རྒྱུད་པར་མ་གྲུབ་པས་ཡེ་ཤེས་ལ་བདག་ཏུ་འཛིན་པ་མེད་དོ།",
    "རྣམ་རིག་གི་གོལ་སྒྲིབ་བསྟན་པའི་ཕྱིར།",
    "རྣམ་རིག་གི་དངོས་པོ་འཁྲུལ་པའི་གཟུགས་བརྙན་དུ་ཤེས་བསྟན་ཆེན་ལྡིངཔ་དང་དེས་འཐོབ་པར་ལྟ་བ་ནི་དེ་ཉིད་རང་གི་ཀུན་བརྟགས་ཀྱི་རྟོག་པ་སྟེདེས་འདི་མི་མཐོང་བའི་ཕྱིར།",
    "དོན་མ་ནོར་བའི་ངོ་བོ་ནིརང་བྱུང་ཡེ་ཤེས་ཉིད་ཀྱང་ཚིག་གི་མཐའ་དང་བྲལ།",
    "གཞན་དུ་ནཨ་ཏི་ཡོ་ག་པ་གོལ་བ་དག་གཟའ་གཏད་བྲལ་བ་ཞིག་ཡུལ་དུ་བྱས་པ་ལས་རང་བྱུང་ཡེ་ཤེས་འཆར་དུ་རེབཀའ་བརྒྱད་བས་སྒོ་གསུམ་གྱི་འདུ་བྱེད་ཀྱིས།",
    "མཐོ་རིས་བགྲོད་པའི་རྒྱུ་དེས་ཉོན་མོངས་ཟིན་པར་འགྱུར།",
    "དེ་ཕྱིར་ཚིག་གིས་གཏན་ལ་མི་འབབ་པའོ།",
    "སྒྱུ་མཁན་རི་མོའི་རྣམ་པ་བཞིན།",
    "རི་མོ་མཁན་ཁང་བུའི་ངོས་ལ་ལྷ་དང་ལྷ་མོ་བྲིས་ནས་རང་ལྟ་བ་ལྟར།",
    "གདེང་གིས་གོལ་སྒྲིབ་རྣམས་ལ་ཟློས་པས་ཆ་མཐུན་པའི་ཏོན་མུན་ལ་སོགས་པར་གོལ་དུ་དོགས་པ་དང་རང་གི་དོན་ཐོབ་ཏུ་རེ་བར་རྩོལ་བ་མེད་དོ།",
    "ཐམས་ཅད་དུ་ལེགས་པའི་ཡེ་ཤེས་ནི་གྲངས་ཁྱོན་བྲལ་འགྲེལབས་དཔག་དཀའ་བའོ།",
    "ཐུན་མོང་གི་ཕ་མ་བསད་པ་ལ་སོགས་པ་ལྔ་སྤྱོད་པ་དང་།",
    "དེ་འདྲའི་མི་ལག་ཤོར་རྭ་རེ།",
    "ཚིག་གི་དོན་ཏོ།",
    "དགོས་ཆེད་ཀྱི་དོན་ནི་གང་ཟག་གསུམ་གྱི་ཕྱིར་གོལ་པསྒྲིབ་གདར་ཤ་བཅད་ནས་གཞུང་གི་དོན་ངོས་ཟིན་པས་ཚེགས་མེད་པར་འགྲུབ་པས་སྟོན་ཏོ།",
    "ཚིག་གི་དོན་ནི་བཅུ་གཅིག་སྟེ།",
    "སྤྲུགས་པ་མེད་པར་ངན་སོང་དོང་སྤྲུག།",
    "ཆེ་བས་ཆེ་བའི་ཟབ་མོ་ཡི།",
    "སྐྱོན་ངང་གིས་བྲལ་བས་ལྟོས་པ་མེད་པའི་ཕྱིར་དཀོར་བདུན་དང་ཉི་ཤུ་རྩ་ལྔའི་ཡོན་ཏན་ལ་སོགས་པ་ཅི་ལའང་དམ་པར་འཛིན་པ་མེད་པའོ།",
    "ཐིག་ལེ་གཉིས་པའི་དོན་བསྟན་པ་གང་སྙམ་པ་ལརང་བཞིན་གྱིས་གནས་པའི་ནམ་མཁའ་སྐབས་ཞེས་པངང་གིས་འགྲོ་བ་རྣམས་ལོག་བརྡོ་ཙམ་ན་ལྷུན་གྱིས་གྲུབ་པའི་ཡེ་ཤེས་ཉིད་དུ་བཞུགས་པའི་དོན་སྟོན་པའི་དུས་ཐད་དུ་བབ་པའོ།",
    "ཞེས་པསྐབས་ཀྱི་དོན་ཀྱང་ཡིན་ཏེསྤྱི་མེས་དེའི་ངོ་མ་བོ་ནི་གཞན་མིན་ཏེ་དྲུག་འགྲོ་བ་རིལ་ངང་གིས་ངོ་བོ་བསྟན་དཀའ་བས་དེ་ཉིད་ཡིན་པའོ།",
    "ཞེས་པལྔའི་ལམ་པ་དག་ངེས་པའི་ཤེས་རབ་ཀྱིས་དབུལ་བས་ལས་ཙམ་ནོར་པས་ཀུན་བརྟགས་ལ་ཞེན་ཙམ་ནའང་འཆད་པ་ལྟར་མིང་ཙམ་ལོག་པ་ལསདབོ་འགྱུར་སྔ་ཉིད་མ་ལོག་པའི་ཕྱིར་རང་བྱུང་གི་ཡེ་ཤེས་བཅིངས་པ་དང་བྲལ་བ་ཉིད་ཡིན་པས་ནོར་བར་ཐལ་བ་མེད་དོ།",
    "ལྔས་སྤགས་པ་དང་གསུམ་གྱིས་སྤགས་པ་དང་གཅིག་གིས་སྤགས་པ་དང་ལུང་རྒྱུད་མན་ཆད་ལས་ཁྱད་པར་གྱུར་པ་མི་གནས་པའི་ཡེ་ཤེས་ཉིད་ནི་སྟོར་བར་སླ་ལ་ཐོབ་པར་དཀའོ།",
    "ཞེས་པལྷག་པའི་རྣལ་འབྱོར་པ་ལ་ཏིང་ངེ་འཛིན་སྒོ་ཕུགས་འབྱུང་འཇུག་མབཀའ་གི་རྩོལ་བ་མེད་པས་འབྲས་བུ་དང་དྲོད་ཆགས་མངོན་ཤེས་ཀྱི་ལེགས་པ་རིལ་ལ་འབད་པ་མེད་པའི་དོན་སྟོན་པའོ།",
    "མི་རྟོག་པ་ལ་གཞག་གི།",
    "དུས་དེང་སང་གི་གདེང་མ་ཤར་བའི་གང་། ཟག་ཚིག་ལ་རྟེན་པ་དག།",
    "བརྩལ་དུ་མེད་པ་ནི་གཞི་ལ་ཐལ་ཏེ་རྒྱལ་ཡུལ་ཡིན་གྱིགང་ཟག་གིས་ལྷག་པའི་སྒོ་འདིར་དམིགས་དགོས་སོ་ཞེས་སྨྲ་ཞིང་།",
    "ཞེ་ལ་འགྱུར་སྔ་བརྣགས་པའི་གསང་བ་ལྟ་བུ་མིན་ཏེ་ཤིན་ཏུ་མཐོང་དཀའ་བས་ཕལ་པའི་རྒྱུའི་བློས་མ་རེག་པའི་ཇི་བཞིན་པ་ནི་མན་ངག་གི་སྲོག་སྟེ།",
    "འོངས་བ་མེད་པར་གནས་མ་བཀའ་རིས་ཀུནཏུ་སློབ་པས་ཆེ་ཆུང་ངང་གིས་མེད་པར་བཞུགས་པའོ།",
    "རྟོག་གེ་བ་དག་བདེ་བ་ཚོལ་བས་གནས་ཆེན་པོར་འགྲེལ་མི་ཕྱིན་ཏེ་རང་གི་ལྟ་བས་བསྒྲིབས།",
    "འདིར་སྣ་ཚོགས་ཀྱིའདུ་ཤེས་ངང་གིས་དག་པས་ཏིང་ངེ་འཛིན་གྱི་འདུ་བྱེད་རིལ་དང་བྲལ་མབར་སྟོན་པའོ།",
    "ལྷུན་གྱིས་གྲུབ་པའི་ཡོན་ཏན་ནོ་ཅོག་གི་དངོས་གཞི་ཆེན་པོར་ཡེ་བཞུག་པ་བཀའ་བཅུ་ལ་བསྒོམ་བྱ་དང་བྱེད་པར་རྒྱ་མ་ཆད་པར་འདིར་ཡིད་ལ་བྱེད་ཅིང་ཞེ་ལ་འཛིན་པ་རིལ་དང་བྲལ་བས་བསམ་པ་མེད་པ་ནི་ཡང་དག་པའི་བསམ་པའོ།",
    "རྟོག་པ་ཕྲ་རགས་དང་མཚན་མ་ཆེ་ཆུང་དང་རྒྱུ་བ་རིང་ཐུང་དང་ཚོར་བ་གསལ་མི་གསལ་དང་བྱུང་ཚོར་མྱུར་བུལ་ཅི་སྐྱེས་ཀྱང་།",
    "འཕྲ་བའི་སྒོ་མོར་མིང་བཏགས་ནས།",
    "ལྷག་པའི་སྒོ་འདི་ཉིད་ནིམཐོ་རིས་ངན་ལ་༧ས་ལས་ཀ་ལཟབཅས་སོང་དང་དགེ་སྡིག་ལུང་དུ་མ་བསྟན་པ་རིལ་རྒྱལ་བ་ཡང་དག་པའི་མཛད་སྤྱོད་ཉིད་དུ་ཤར་བསཁམས་གསུམ་ལས་འབྲས་བུ་གཞན་ནས་མི་ཚོལ་བས་བྱེད་སྤྱོད་གང་ཡང་དགག་ཏུ་མེད་པའི་དགྱེས་པ་ཆེན་པོ་འཆར་ཞིང་ཟིན་ཆགས་མེད་པས་གོལ་སྒྲིབ་དག་གོ།",
    "ཆགས་དང་མ་ཆགས་ཚིག་གི་ལམ།",
    "མབཀའ་བཅུ་ཞེས་པརང་གི་སེམས་ཉིད་ངང་གིས་མཐའོ་ཅོག་དག་པའི་ཕྱིར་ཀུན་སྦྱོར་གསུམ་ལ་སོགས་པའི་གདུང་རྟོག་རིལ་རང་རིག་པར་རང་གསལ་བས་ཡེ་ཤེས་རག་གཞན་དུ་མ་ལུས་པའི་གཉིསདོན་སྟོན་པའོ།",
    "སྤྱོད་པ་ལྔའི་དང་པོ་ཀུན་ནས་ཉོན་མོངས་པ་གྲོལ་བའི་ལམ་དུ་བསྟན་པའི་ཕྱིརའདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་ཀྱང་།",
    "ལྷག་པའི་རྣལ་འབྱོར་པའི་བློ་བཅོས་པར་ཡང་འཆད་དེསེམས་ཉིད་ཀྱི་ནམ་མཁའ་ཉིད་ངང་གིས་རྟོག་འཛིན་མཆེད་པའི་འཕྲོ་བ་མེད་དོ།",
    "མི་འགོག་སྟེ་སྣ་ཚོགས་སུ་རྒྱུ་བའི་རྟོག་པ་ཉིད་ངང་གིས་མ་སྐྱེས་པས་མ་གཡོས་པར་གསལ་བ་མཁའ་ལྟ་བུའོ།",
    "ཞེས་པམ་སྐྱེས་པ་དང་ལས་ཀྱི་ཡི་གེ་ནི་བརྡའ་སྟེ་ཀུན་ཏུ་བཟང་པོ་དང་བཟང་མོའོ།",
    "ཟབ་མོའི་དོན་ལ་སྙེགས་པས་ཉེ་བར་འཆད་པ་ནི།",
    "དོན་དམ་པ་མཚོན་པ་པའི་ཡི་གེ་ལ་སོགས་པ་ཕོ་ཉེ་། མོ་དང་མ་ནིང་གི་ཡི་གེ་ཐ་དད་དུ་འཕྲོས་པ་ལྟར།",
    "དོན་རང་རིག་མངོན་སུམ་དུ་བྱས་པ་ལས་འབྲས་བུ་བཀའ་རྙེད་པ་དང་ལྟ་བ་ཟབ་མོའང་ལུང་ངེས་པས་ཟིན་པས་ལྟ་བའི་སྲོག་ལུང་ཡིན་ཏེ།",
    "ཞེས་པཁམས་གསུམ་གྱི་གནས་ན་སྤྲུལ་པའི་སྐུས་དྲུག་གི་ལས་རྣམས་དག་པར་བྱེད་པའང་།",
    "འོ་ན་རྒྱུ་དང་མ་འདྲེས་པའི་བཀའ་ལུང་གང་སྙམ་པ་ལལུང་སྟོན་པའི་སྐབསཞེས་པལུང་གི་རྒྱལ་པོ་ཐམས་ཅད་གཅིག་པར་སྟོན་པས་དཀྲི་བའི་། ལུང་ལས་ཤིན་ཏུ་འཕགས་པར་འཆད་པའོ།",
    "གདེངས་དེ་ལྟ་བུའི་སྐྱེས་བུ་འདི་པར་ངེས་པ་ལ་སྨོན་རེ་དང་དོགས་པའི་སེམས་ཀྱི་འདུ་འཕྲོ་དང་བག་ཚ་བ་མེད་པས་ཁྱུང་ཆེན་བཅོ་བའགྱུར་བརྒྱདལྡིངས་པ་ལྟར་བཞུགས་པའོ།",
    "ལུང་གི་ངོ་བོ་དང་ངེས་ཚིག་བསྟན་པའི་ཕྱིར།",
    "ཟབ་མོ་ཆ་ཤས་རྟོགས་ཡུལ་མེད།",
    "འདིར་ཡུལ་དང་ཤེས་པར་སྣང་བའི་ཡུལ་ཡང་རང་བྱུང་གི་ཡེ་ཤེས་ཁོ་ན་བས་རྟོགས་པར་བྱའི་ཡུལ་ཟབ་ཅིང་ཕྲ་བ་འདོད་ནས་མེད་པར་བསལ་ཏོ།",
    "ལྔ་པས་ཡེ་ཤེས་ཀྱི་རེ་དོགས་དང་བྲལ་པབར་བཤད།",
    "གང་དང་གང་གི་གང་དུའང་།",
    "འདི་ལ་སྐྱེས་པ་བུད་མེད་ཅེས།",
    "སྐབས་འདིར་འདོད་པའི་འཁྲིག་སྤྱོད་ཐམས་ཅད་ཀྱང་བདག་ཉིད་བཀའ་ཆེན་པོའི་སྤྱོད་པར་རང་ཤར་བ་ལ་ཕོ་མོའི་རིས་དང་བ་གར་བསྲུབས་པའི་བདེ་བ་རྟོགས་པ་ལྟ་བུར་ཀུན་ཏུ་བཟང་པོས་མ་གསུངས་པས་རྒྱུད་ལས་ཐབས་ཁྱད་པར་ཆེའོ།",
    "ཤིན་ཏུ་རྣལ་འབྱོར་པ་ལ་ལུང་གི་བརྟུལ་ཤུགས་ཉི་ཤུ་རྩ་གསུམ་གྱི་སྤྱོད་པ་བྱས་པས་ཐོབ་བྱའི་གཞི་མི་རྩམ་ཡང་མེད་པའི་ཕྱིར་གནས་སུ་བྱ་བའི་མིང་མེད་དེ།",
    "ཀུན་ཏུ་བཟང་པོ་དང་བཟང་མོར་བརླབས་པའི་ཐབས་ཤེས་རབ་འཚམ་པའི་ཚེ་བཅོསརོལ་པའི་ལས་སྒྱུ་མ་ལྟ་བུ་ལས་དགྱེས་པ་ཆེན་པོའི་ཡེ་ཤེས་སྣང་བར་འདོད་པ་གོལ་བའོ།",
    "བཏགས་པ་ཐམས་ཅད་དུ་ཆགསཇི་ལྟར་བལྟས་པར་རང་སྣང་བ་ལ་རྣམ་པའི་བདེ་བ་སྣང་བའང་རེ་བ་མེད་པས་འཕགས་པའོ།",
    "སེམས་བརྩལ་བ་དང་བྲལ་བ་སླར་མཐོང་དུ་མི་སྟེར་བས་མན་ངག་གི་སྒྲིབ་པ་དངོས་སོ།",
    "ཞེས་པསྤྱོད་པ་བླ་ན་མེད་པ་གཉིས་པ་དང་ལུང་གི་སྲོག་མན་ངག་འཆད་དེ།",
    "བླང་དོར་མེད་པའི་ཀྲི་ཡ་པ་ཡེ་ཤེས་སེམས་དཔའ་ལ་དངོས་གྲུབ་རེ་བ་ལྟ་བུ་གོལ་སྒྲིབ་ཀྱི་ནོར་བ་མེད་པའོ།",
    "རང་གི་མཐུའི་རིག་པ་ལས།",
    "སའི་མན་ངག་དང་དམ་ཚིག་གི་སྲོག་ལྟ་བ་བསྟན་པའི་ཕྱིར།",
    "སྤྱན་གཟིགས་དང་།",
    "དངོས་པོའི་དོ་བྱི་ལ་རིང་མོར་ཆགས་པ་དང་འདིར་བྲལ་ཏེ།",
    "ཉམས་ལྟུང་གི་ཉོན་མོངས་པ་ངང་གིས་མེད་ཅིང་།",
    "དམ་ཚིག་ཆེན་པོ་སྟེདམ་བཅོསཚིག་གི་སྒྲིབ་པ་དང་གོལ་སའང་མེད་པའོ།",
    "ཇི་བཞིན་པ་མཐོང་བ་ནི་དགྱེས་པ་ཆེན་པོའི་གཞིར་གྱུར་པསདམ་ཚིག་ཆེན་པོ་སྟེདམ་ཚིག་གི་སྒྲིབ་པ་དང་གོལ་སའང་བསྟན་ནམ་མཁའ་མེད་པའོ།",
    "ཞེས་པམངོན་དུ་ཕྱུང་བའི་ལུང་སྟེ་བྱ་བ་མེད་པའི་དོན་སྟོན་ཆེ་རྒྱབ་པ་ལ་བྱེད་རྩོལ་སྒྲིབ་པར་ཚིག་གིས་བརྡའ་ཡིས་སྟོན་པའོ།",
    "རྩོལ་བ་སྒྲིབ་པ་བཞིན་དུ་བྱ་མེད་ངང་ལ་དེ་ཉིད་ཡུལ་དུ་འཛིན་ན་འཛིན་པའི་བློ་ལ་དེ་འགྲེལབཞིན་སྣང་དུ་མི་བཏུབ་སྟེ་ཟཟབ་མོའི་དོན་ནི་མ་རྙེད་པའོ།",
    "ཚིག་གི་དོན་རྣམ་པར་ཕྱེ་བའོ།",
    "དེ་དག་གིས་འཆིང་བ་དང་།",
    "དེ་ཉིད་ཀྱི་དུས་ན་ཀློང་གི་དོན་གྱིས་སེལ་མེད་པ་དང་།",
    "རང་གི་མཚན་ཉིད་ངེས་པར་མི་རྙེད་སྔ་པས་ དེ་རྟོགས་པའི་རྣལ་འབྱོར་པ་ནི་ཐམས་ཅད་བདག་ཏུ་གྱུར་པའི་ཕྱིརརྒྱལ་པོ་ལྟ་བུར་གསུངས་པས།",
    "གཡུང་དྲུང་གི་ལྷུན་ལ་བཞུགས་པསཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པ་ཞེས་བྱ་སྟེ།",
    "འོ་ན་དེ་དག་ནི་བདག་ཅག་ལས་གུད་དུ་གྱུར་པས་ལམ་དང་བྲལ་ལོ་བར་བདོགས་པ་ལཐམས་ཅད་མ་བཀག་དབྱེར་མེད་བདག་གི་རྒྱུ།",
    "ཞེས་གསུངས་ཏེ་། དངོས་པོ་གཉིས་ཀྱིས་བསྡུས་པ་རིལ་བདེན་པ་གཉིས་ཀྱི་གཞུང་གིས་ཀྱང་མ་སྤངས་ན།",
    "སྒྲ་གཙོར་བྱེད་པའི་མིང་གི་རྣལ་འབྱོར་པ་དག་འདི་དག་ལམ་ཕྱོགས་གཅིག་གི་ཕྱིར།",
    "ཐ་འགྱུར་སྔ་མི་དད་པའི་ཕྱིར་ས་གསེར་ལྟ་བུར་གཞག་གིའབྱུང་ཁུངས་དག་ཏུ་སྨྲ་བ་ནི།",
    "ཅེས་བྱ་བ་དེ་དག་སྤྱོད་པ་དང་ཡུལ་ཡོངས་སུ་བཅད་དེརིལ་བདག་ཏུ་གཅིག་པ་ནི་ཤིན་ཏུ་རྣལ་འབྱོར་ཏེགང་གིས་མྱོང་བ་ཡང་སྤྱོད་ཡུལ་དང་བྲལ་བས།",
    "དེ་དག་འགྱུར་སྔ་བདག་གིས་སྤྱད་པ་ནི་ཉན་ཐོས་ལྟར་ངེས་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ན་མང་དུ་མ་བྱས་པ་དག་གིས་སྨད་པ་ཀློང་བསྟན་བཅོས་ཡངས་ཉེ་བར་བསྟན་པ་ནིངོ་བོ་ངན་པ་ཉིད་དང་འབྲས་བུ་གསུམ་ཉེ་བར་ལེན་པས།",
    "སྤང་དུ་མེད་པས་བདག་གི་རྒྱུ།",
    "དེ་བཞིན་དུ་བར་གཅོད་པ་ལ་འཇུག་པར་མོས་པ་དང་།",
    "ངོ་བོ་མ་སྐྱེས་པ་དག་པ་སྟེ་བདག་གིས་མ་བྱས་པའོ།",
    "འདི་དག་གིས་བྱ་བ་མེད་པ་སྟོན་ཏོ།",
    "ངང་གིས་མི་གཡོ་རྨུགས་ཤིང་ཏིང་འཛིན་རྒྱལ་པོར་གནས།",
    "དེ་དག་གི་རྗེས་སུ་ཆུད་པ་རྣམས་ཀྱང་རྗེས་སུ་མཐུན་པར་གནས་པའི་དུས་ན་བསྲུང་མཚམས་དང་བྲལ་ཡང་སྒོ་གསུམ་གྱིས་ཉེས་པ་མེད་པར་བསྟན་ཏོ།",
    "དེ་དག་ཉིད་ཡེ་ཤེས་ཆེན་པོའི་ངོ་བོ་ཉིད་དུ་བསྟན་པ་ནི་རྩེ་མོར་གྱུར་པ་སྟེ།",
    "བདག་གིས་བདག་མི་དམིགས་མོད་ཀྱི་ཁོ་ན་བཞིན་རིག་པས་ཞེན་པ་ཐམས་ཅད་དང་བྲལ་བ་ནི་ཤར་བ་ཞེས་བྱ་སྟེདེ་ཉིད་ཐོག་མའི་ཀློང་བཅོསཡངས་རྒྱུན་ཡིན་ཡང་རྒྱུད་མཐུན་པ་ཉིད་དང་།",
    "མིག་གིས་མིག་མི་དམིགས་པའི་ཚུལ་དུ་ཤེས་པ་ནི་བསམ་དུ་མེད་པ་ཞེས་བྱ་མསྟེ་དམིགས་པ་ཡིད་ལ་ཅི་གསལ་ཡང་།",
    "རྣམ་བྲལ་གང་ལ་མཆོག་དང་ཐ་མ་མེད་པར་མཆོག་འདི་བསྒོམ་མོ་ཞེས་འབྱུང་ངོ།",
    "དེ་བཞིན་ཐིག་ལེ་ཆེན་པོ་རིལ་བདག་ཏུ་ལོངས་སྤྱོད་པ་ནི་འཕོ་འཇུག་གི་སྐབས་མེད་ཀྱང་འདུ་ཤེས་བཐ་དད་པ་ཚོན་ལྟ་བུ་ནི་འགྲེལདག་པ་དང་།",
    "ཞེས་བྱ་སྟེ་རྗེས་སུ་འཇུག་པ་ཡཡང་བདེན་མོད་ཀྱི་སྐབས་འདིར་དེ་དག་གི་ངོ་བོ་ཉིད་མ་གྲུབ་པའི་ཕྱིརཡེ་ཤེས་ཆེན་པོ་སྣང་བ་མེད་པའི་མཉམས་སྙེད་པ་ནིམ་གཡོས་པ་ཁོ་ནར་བདེན་ནོ།",
    "ཞེས་བྱ་བཐམས་ཅད་མ་བཀག་དབྱེར་མེད་བདག་གི་རྒྱུ།",
    "ཞེས་གསུངས་ཏེསྔ་ཐ་སྙད་རིལ་འབྲས་བདུད་རྫོགས་པ་བདག་གིས་མངོན་དུ་བྱས་པ་ཡང་ཐ་སྙད་ལ་གཉེན་པོར་བསྒྱུར་ནས།",
    "དེ་དག་མུ་མཐའ་བྲལ་བ་ཉིད་རང་གི་རབ་རིབ་ཡོངས་སུ་དག་པས་འདུ་ཤེས་བྲལ་བར་གསུངས་སོ།",
    "སྤང་དུ་མེད་པས་བདག་གི་རྒྱུ།",
    "ཀུན་ནས་ཉོན་མོངས་རྩ་བར་གྱུར་པ་དག་སྐུ་ལ་སོགས་པ་ལྷུན་གྱིས་གྲུབ་པ་དེ་དག་ཡེ་ཤེས་ཆེན་འགྲེལཔའི་དོན་གྱིས་སྣང་བ་ནི།",
    "ཐམས་ཅད་སེམས་ཕྱིར་མཐའ་རྣམས་ངང་གིས་སྟོང་།",
    "དེ་མན་ངག་གི་ལུང་རྣམས་འཆད་པའི་སྤྱི་ལུགས་ཀྱིས།",
    "ཚིག་གི་དོན་དང་ལྔའོ།",
    "འཁོར་དང་འགྲེལ་། གསུང་གི་བྱིན་གྱིས་རླབས་ཀྱིས།",
    "ཚིག་གི་དོན་ནི་དོན་མན་ངག་ལས།",
    "ཚིག་གི་འབྲུ་འཇོམས་ཐང་ཀར་གཟན་ལ་བཅུམ།",
    "འབྲུ་སྟོང་མི་གཞག་ཚིག་གི་གཟེར་བུས་གདབ།",
    "དེའི་ངོ་བོ་ཉིད་ནི་རང་བྱུང་གི་ཡེ་ཤེས་བཀའ་གསུམ་རྒྱུ་རྐྱེན་གྱིས་དབེན་པའི་ཕྱིར།",
    "རང་གི་ངོ་བོས་སྟོང་སྟེ།",
    "ཤིང་གི་སྟ་རེ་ཞེས་པ་ལྟ་བུ་སྟེལྕགས་ཀྱི་སྟ་རེ་ཡང་མི་འདོད་པ་མ་ཡིན་ནོ།",
    "བློ་གཞག་པའི་ཐབས་ནིསེམས་ཉིད་མཐའ་ཐམས་ཅད་ཀྱིས་མ་རེག་པའི་ཕྱིར།",
    "འུང་ནས་མན་ངག་གི་ལུགས་ཀྱི་གབ་ཅིང་སྦས་ནས་སྟོན་པསངང་ལ་བྱིན་གྱི་རླབས་ཀྱིས་ཕུན་སུམ་ཚོགས་པ་བསྟན་པའི་ཕྱིར།",
    "རང་གིས་རིག་ནས་ཞེས་བྱ་བ་ནི་མྱང་བ་དང་།",
    "དེ་ཉིད་རང་གིས་མངོན་སུམ་དུ་བྱིན་གྱིས་བརླབས་ནས།",
