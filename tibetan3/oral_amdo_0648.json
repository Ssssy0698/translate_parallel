    "ཀོཤི་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ནི་བཏགས་པ་ཙམ་མོ།",
    "ཀོ་ཤི་ཀ་རྔུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ནི་བཏགས་པ་ཙམ་མོ།",
    "ཀོ་ཤི་ཀ་འཕགས་པའི་ལམ་ཡནལགབརྒྱདཔནིབཏགསཔཙམམོ།",
    "ཀོ་ཤི་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་བརྣམས་ནི་བཏགས་པ་ཙམ་མོ།",
    "ཤིཀམཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུནི་བཏགས་པ་ཙམམོ།",
    "ཀོ་ཤིཀ་སོ་སོ་ཡང་ད་ག་པར་རིག་པ་བཞིན་བཏགས་པཙམམོ།",
    "ཀོ་ཤི་ཀ་རྒྱུནཏུ་ཞུགས་པའི་འབྲས་བུ་ནབིཏགས་པ་མམོ།",
    "ཀོཤི་ཀ་དགྲ་བཅོམ་པ་ཉིད་ནིབཏགས་པ་ཙམ་མོ།",
    "ཀོཤིཀརྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་བཏགས་པ་ཙམམོ།",
    "ཀོ་ཤིག་རྒྱུན་ཏུ་ཞུགས་བནབཏགས་པ་ཙམམོ།",
    "ཀོ་ཤིཀ་ཕྱིར་མི་འོང་བནི་བཏགས་པཙམམོ།",
    "རེག་ལ་མྱི་སློབ་སྟེ།",
    "ཁྱང་ཆུབསེམས་དཔའསེམས་དབ་འཆེན་བོད་ལྟར་སློབ་པ་ནི་མྱིག་གི་རྣམ་པར་ཤེས་པ་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའིམྱིག་གི་འདུས་ཏེ་རེག་པ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོངངོ།",
    "རྣ་བའི་འདུས་ཏེརེག་པ་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་གངལ་བསླབ་པར་བྱ་བའི་རྣ་བའིའདུས་ཏེརེག་པ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་སྣའི་འདུས་ཏེ་རེག་བུ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདིལྟར་དེས་གངལ་བསླབ་བར་བྱ་བའི་ལྕེའི་འདུས་ཏེ་རེག་པ་དེ་ཡང་དག་པར་རྗེས་སུཀྱི་མཐོང་ངོ།",
    "ལུསཀྱི་འདུས་ཏེ་རེག་པ་ལམ་སློབས།",
    "འདི་ལྟརདེས་གང་ལ་བསླབ་བར་བྱ་བའི་ལུས་ཀྱི་འདུས་ཏེ་རེག་བ་དེ་ཡང་དག་པར་རྗེས་སུ་མཐོངངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལམྱི་སློབསྟེ།",
    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་དེ་ཡངདག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདི་ལྟརདེསགདལ་བསླ་བཔར་བྱ་བའི་མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དེ་ཡང་དག་པར་རྗེས་སུམྱྀམཐོང་།",
    "འདི་ལྟར་ངེས་གུང་ལ་བསླབ་པར་བྱ་བའི་རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོངངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་ངེས་གང་ལ་བསླབ་པར་བྱ་བའི་སྣའིའདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བདེ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བགལ་མྱི་སློབ་སྟེ།",
    "དེ་ཅིའི་ཕྱིར་ཞེན་འདི་ལྟར་དེས་གང་ལབསླབ་པར་བྱབའི་ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དེ་ཡང་དག་པར་རྗེས་སུམྱམཐོང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ལ་མྱི་སློ་བསྟེ།",
    "འདི་ལྟར་དེས་གང་ལབསླབ་པར་བྱ་བའི་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ལ་མྱི་སློབ་སྟེ།",
    "འདི་ལྟར་དེས་ག་ང་ལ་བསླབ་པར་བྱབའི་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དེ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "འདི་ལྟ་རརེས་གང་ལ་བསླབ་པར་བྱ་བའི་སྐྱེ་བདེ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདི་ལྟརདེས་གང་ལ་བསླབཔར་བྱ་བའི་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུད་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "ཅིའི་ཕྱིར་ན་རེག་ཡང་དག་པར་རྗེསསུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིརནམྱིག་གི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་མུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་རྣབའི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེསསུ་མྱམཐོང་།",
    "ཅིའི་ཕྱིར་སྣའི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་།",
    "ཅིའི་ཕྱིརན་ལྕེའི་འདུས་ཏེ་རེག་པ་ཡང་དག་པརརྗེས་སུམྱི་། མཐོང་༴",
    "ཅིའི་ཕྱིར་ན་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མམཐོང་།",
    "ཅིའི་ཕྱིར་ནམིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནནཔའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡངདག་བར་རྗེས་སུམ་མཐོང་།",
    "ཅིའི་ཕྱིརེན་སྣའི་དུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུམྱྀ་མཐོ།",
    "ཅིའི་ཕྱིར་ན་ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ནལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱིམཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཡིད་ཀྱི་འངུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཆུང་གི་ཁམས་ཡང་དག་བར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མཐོང་།",
    "ཅིའི་ཕྱིར་ནརང་གིམཚན་ཉིད་སྟོང་པཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་མྱིག་གི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "རྣཔའི་འདུས་ཏེ་རེག་བརྣ་བའི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "སྣའིའདུས་ཏེ་རེག་པ་སྣའི་འདུས་ཏེ་རེག་བས་སྟོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་བ་ལྕེའི་འདུས་ཏེ་རེག་པས་སྟོང་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའིཚོར་བམྱིག་གི་འདུས་ཏེརེག་པ་ལས་སྐྱེས་པའི་ཚེརབས་སྟོང་ངོ།",
    "རྣབའི་འངུས་ཏེ་རེག་བ་ལས་སྐྱེས་པའིཚོར་བ་། རྣབའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའིཚེར་བསྣའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་བའི་ཚོར་བས་སྟོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་ལྡེའི་འདུས་ཏེ་རེག་ཕ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོརབ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོད་ང་།",
    "ཡད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཇིར་བ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚེར་བས་སྟོང་ངོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིང་ཀྱིས་ཕྱག་གི་འཇུས་ཏེ་ཡིག་པ་སྟོབ་ཀྱིད་ཡང་དག་པར་རྗེས་སུ་མཐོང་།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་ལྕེའི་འདུས་ཏེ་རེག་པ་སྟོད་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱམཐོང་ངོ།",
    "ཡང་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་ཡངཀྱི་འདུས་ཏེ་རེག་པ་སྟོ་དྲཔཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ཞབའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པ་ཉིད་ཀྱིས་རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཆིས་ཚོར་བ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོངཔ་ཉིདཀྱིསསྣའི་འདུས་ཏེ་རེག་བའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་བ་ཉིད་ཡང་དྲག་བར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "ལྕེའི་འདུས་ཏེརེག་པའི་རྐྱེན་ཀྱིས་ཚོང་བསྟོང་པ་ཉིད་ཀྱིས་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "ལུས་ཀྱིའདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པ་ཉིད་ཀྱིས་ལུས་ཀྱི་འདུས་ཏེརེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པཉིད་ཡ་ད་དག་པར་རྗེས་སུ་མྱྀམཐོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རིག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པ་ཉིད་ཀྱིས་ཡད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྦྱོང་པའི་ཡང་དག་པར་རྗེས་སུ་མྱ་མཐོང་ངོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་སྟོང་བ་ཉིད་ཀྱིས།",
    "རང་གིམ་ཚན་ཉིད་སྟོང་བ་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མ་མཐོངངོ།",
    "དེ་གཉིས་མུ་བྱར་མེད་པར་མིག་གི་རྣམ་པར་ཤེས་བ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་ལྕེའི་འཇུས་ཏེརེག་པ་སྟོང་པ་ཉིད་ལསློབ་པོ།",
    "དགཉིས་སུ་བྱར་མེད་བར་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་བ་ཉིད་ལ་སླབ་བོ།",
    "དེ་གཉིས་སུ་མྱེད་པར་མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པ་ཉིང་ལསློབ་བོ།",
    "ཉིས་སུ་བྱར་མྱེད་པར་སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚར་བ་། སྟོང་བཤིང་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མྱེད་པར་ལྕེའི་འདུས་ཏེ་རེག་བའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོདཔ་ཉིདི་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་མེད་པར་ཡིདི་ཀྱིའ་དུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་གཉིས་སུ་བྱར་བྱེད་པར་རེག་པ་སྟོང་བ་ཉིད་ལ་སློབ་བོ།",
    "ད་པར་རང་གི་མཚན་ཉིད་སྟོང་བཉིད་སྟོངཔ་ཉིད་ལ་སློབ་བོ།",
    "རེག་སྟོང་བཉིད་ལག་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་བ་དང་།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ལགངག་ཉིས་སུ་བྱར་མེད་པར་སློབ་བ་དང་།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིདི་ལག་ངགཉིས་སུ་བྱར་མྱེད་པར་སློཁ་བ་དང་སྣའི་འཇུས་ཏེ་རེག་པ་སྟོངབ་ཉིད་ལགངགཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པསྟོང་པ་ཉིད་ལག་ང་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་པ་ཉིད་ལགང་ག་ཉིས་སུ་བྱར་མྱེད་བར་སློབ་བ་དང་།",
    "། རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བསྟོང་བ་ཉིད་ལག་གཉིས་སུ་བྱར་མྱེད་པར་སློབ་པ་དང་།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེནཀྱིས་ཚོར་བ་སྟོང་བ་ཉིད་ལགདགཉིས་སུ་ཕྱརམེདཔརསློབཔ་དང་།",
    "ལུས་ཀྱི་འདུས་ཏེརེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་བ་ཉིང་ལ་གངགཉིས་སུ་བྱར་མྱེད་པརསློབ་བ་དང་།",
    "དེ་ནགི་ཉིས་སུ་བྱར་མེད་བརཐོག་མ་དངཐམ་མྱེད་པ་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནག་ཉིས་སུ་བྱར་བྱེ་དབར་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལ་སློབ་བོ།",
    "དེ་ནགི་ཉིས་མུ་བྱར་ཕྱེད་པར་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པརྣམས་ལ་སློབ་བོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་འཕེལ་བར་བྱ་བ་དང་།་",
    "མིག་གི་འདུས་ཏེ་རེག་པའཕེལ་བར་བ་དང་།",
    "སྣའི་འདུས་ཏེ་རེག་པ་འཕེལ་བར་བྱ་བ་དང་།",
    "ལྕེའིའདུས་ཏེ་རེག་པར་ཕེལ་བར་བྱ་བ་དང་།",
