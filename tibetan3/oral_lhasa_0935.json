    "རྣམ་པར་གྲོལ་བའི་ལམ་ལས་སྦྱངས་པའི་ཡོན་ཏན་བསྟན་པ་ཞེས་བྱ་བ།",
    "ཡོན་ཏན་དོན་དུ་གཉེར་བས་སྦྱངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་ཏེ་འཇུག་པར་བྱའོ།",
    "རྣལ་འབྱོར་སྤྱོད་པ་སྦྱངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་པ་ནི་རྣམ་གྲངས་དུ་མས་འདོད་པ་ཆུང་བ་ཉིད་དང་།",
    "རིག་པར་གནས་པ་ཉིད་དང་།",
    "ཡོངས་སུ་ཞེན་པ་རབ་ཏུ་གཅོད་པར་འགྱུར་ཞིང་།",
    "མཐར་ཆགས་སུ་རྒྱུ་བ་ཉིད་ནི་བརྙོགས་པར་རྒྱུ་བ་སྤོང་བ་ཡིན་ནོ།",
    "ཟས་ཕྱིས་མི་ལེན་པ་ཉིད་ནི་ཟས་ལྷག་པར་ལེན་པ་སྤོང་བ་ཡིན་ནོ།",
    "ཤིང་དྲུང་པ་ཉིད་ནི་གཡོགས་པར་གནས་པ་སྤོང་བ་ཡིན་ནོ།",
    "དེ་ལ་ཕྱག་དར་ཁྲོད་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཞེ་ན།",
    "ཕྱག་དར་ཁྲོད་པ་ཉིད་ནི་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཡོངས་སུ་སྤྱོད་པ་ན་ལྷག་པར་མ་ཆགས་པ་ཉིད་དང་།",
    "དུས་མ་ལགས་པ་ཉིད་དང་།",
    "རང་བཞིན་གྱིས་མི་རྣམས་ཀྱིས་སྨད་པར་གྲགས་པའོ།",
    "ལམ་པོ་ཆེ་ནས་དམ་དུམ་དག་བཏུས་ནས་སྣམ་སྦྱར་བྱས་ཏེ།",
    "མུ་སྟེགས་ཅན་གྱི་མཚན་མ་འདི་དག་ནི་རང་བཞིན་གྱིས་མི་རྣམས་ཀྱིས་སྨད་པར་གྲགས་པའི་ཕྱག་དར་ཁྲོད་པ་ཡིན་ནོ།",
    "བསོད་སྙོམས་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "མཐར་ཆགས་སུ་རྒྱུ་བ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཅེ་ན།",
    "མཐར་ཆགས་སུ་རྒྱུ་བ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ལྷན་ཅིག་སྤྱོད་པ་རྣམ་པར་སྤོང་བ་ཉིད་དང་།",
    "མཐར་ཆགས་སུ་རྒྱུ་བ་ནི་བརྙོགས་པར་རྒྱུ་བ་སྤོང་བ་ཡིན་ནོ།",
    "བརྙོགས་པར་རྒྱུ་བས་ནི་མཐར་ཆགས་སུ་རྒྱུ་བ་ཉིད་འཇིག་གོ།",
    "སྟན་གཅིག་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཅེ་ན།",
    "སྟན་གཅིག་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཟས་ལྷག་པར་མི་ཟ་བ་ཉིད་དང་།",
    "ཟས་ཆོག་པ་པ་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཅེ་ན།",
    "ཟས་ཆོག་པ་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཀུན་ནས་ལྡང་བ་ཡང་དག་པར་སྤོང་བ་དང་།",
    "གོམས་པ་ན་ལྟོའི་ཚད་ཀྱང་ཤེས་པར་འགྱུར་རོ།",
    "པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཅེ་ན།",
    "ཟས་ལྷག་པར་ཟོས་ན་ཕུལ་སྐྱེ་བ་དང་།",
    "ཟས་ཕྱིས་མི་ལེན་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཟས་ཕྱིས་མི་ལེན་པ་ནི་ཟས་ལྷག་པར་སྤོང་བ་ཡིན་ནོ།",
    "ཟས་ལྷག་པར་ཟ་བས་ནི་ཟས་ཕྱིས་མི་ལེན་པ་ཉིད་འཇིག་གོ།",
    "འཛིངས་པར་གནས་པ་ཉིད་ཀྱི་ཉེས་དམིགས་ཀྱང་མཐོང་།",
    "གཏམ་གྱི་གཞི་བཅུ་ཡང་དག་པར་སྟོན་པ་དང་།",
    "ཤིང་དྲུང་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཞེ་ན།",
    "གཡོགས་པར་གནས་པ་ཡོངས་སུ་བཟུང་བ་དང་།",
    "དེང་སླན་ཆད་གཡོགས་པར་གནས་པ་སྤོང་སྟེ།",
    "ཤིང་དྲུང་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཤིང་དྲུང་པ་ནི་གཡོགས་པར་གནས་པ་སྤོང་བ་ཡིན་ནོ།",
    "བླ་གབ་མེད་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཞེ་ན།",
    "བླ་གབ་མེད་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "དུར་ཁྲོད་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཞེ་ན།",
    "དུར་ཁྲོད་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "འདོད་པའི་འདོད་ཆགས་རྣམ་པར་གནོན་པ་ཉིད་དང་།",
    "དུར་ཁྲོད་ཇི་ལྟ་བུར་ནི་གནས་པར་བྱ།",
    "དུ་བ་ཡོད་པ་དེ་ལྟ་བུའི་དུར་ཁྲོད་དུ་གནས་པར་བྱ་ལ།",
    "དེ་ནས་ནི་དུར་ཁྲོད་གཞན་གང་ཡང་རུང་བར་ཡང་གནས་པར་བྱའོ།",
    "མས་ལྡང་བར་གནས་པར་མི་བྱ།",
    "ཁུམ་འཕྲིག་ཅན་དུ་གནས་པར་མི་བྱ།",
    "ལྷུང་བཟེད་སྦྱིན་པར་མི་བྱ།",
    "གཞི་ཇི་བཞིན་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཞེ་ན།",
    "བརྐམ་ཆགས་ཀྱི་གནས་མལ་ལ་ཕན་ཚུན་ལྡང་བ་ཕ་རོལ་ལ་གནོད་པར་བྱེད་པའི་ཉེས་དམིགས་ཀྱང་མཐོང་།",
    "གཞི་ཇི་བཞིན་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "དད་པར་བྱ་བ་ཉིད་དང་།",
    "ཇི་ལྟར་ཅོག་པུ་པ་ཉིད་ཡང་དག་པར་ལེན་ཞེ་ན།",
    "ཅོག་པུ་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ལ་བ་དག་བྱིན་པར་གྱུར་ན་སྐབས་ཕྱེ་བས་བླང་བར་བྱ་སྟེ།",
    "ཕྱག་དར་ཁྲོད་པ་ཉིད་ཉམས་པར་མི་འགྱུར་རོ།",
    "བསོད་སྙོམས་པ་ཉིད་འཇིག་པར་མི་འགྱུར་རོ།",
    "འོན་ཀྱང་ཉེས་དམིགས་སུ་ལྟ་བས་ནི་ཡོངས་སུ་ལོངས་སྤྱད་པར་བྱའོ།",
    "མཐར་ཆགས་སུ་རྒྱུ་བ་ཉིད་ཉམས་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་ལངས་པར་གྱུར་ན་སྐབས་ཕྱེ་བས་ཡང་བཟའ་བར་བྱ་སྟེ།",
    "སྟན་གཅིག་པ་ཉིད་འཇིག་པར་མི་འགྱུར་རོ།",
    "གཞན་ཡང་དེ་ལྟ་བུའི་རྐྱེན་ཡོད་ན་སྐབས་ཕྱེ་བས་གྲོང་མཐར་གནས་པར་བྱ་སྟེ།",
    "གཞི་ཇི་བཞིན་པ་ཉིད་ཀྱི་སྐབས་ཕྱེ་བས་ནི་རྐྱེན་དེ་ལྟ་བུ་ཡོད་ལ་གཞན་གྱིས་གནས་མལ་རྙེད་ན་རྗེས་སུ་གནང་ངོ།",
    "ཅོག་པུ་པ་ཉིད་ཉམས་པར་མི་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "བསོད་སྙོམས་པ་ཉིད་དང་གསུམ་གྱིས་རྫོགས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་སྦྱངས་པའི་སྒོ་གསུམ་རྫོགས་པར་བྱེད་ན།",
    "སྦྱངས་པའི་ཡོན་ཏན་ཐམས་ཅད་རྫོགས་པར་འགྱུར་རོ།",
    "ངན་ངོན་གྱིས་འཚོ་འདོད་པ་རྣམས་ལ་ནི་ལྟ་བ་མེད་པ་མཐོང་ཞིག་གུ་ཞེས་གསུངས་སོ།",
    "ནི་སྦྱངས་པའི་ཡོན་ཏན་བསྟན་པར་དགའ།",
    "སྦྱངས་པའི་ཡོན་ཏན་ཅིར་བརྗོད་པར་བྱ་ཞེ་ན།",
    "འདིས་ཆོག་པ་ཉིད་ལ་བརྟེན་ནས་ཕྱག་དར་ཁྲོད་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "རྣམ་པ་གཅིག་ཏུ་ནི་མ་ཆགས་པས་རྗེས་སུ་གནང་བ་འཚམ་པར་བསྟེན་པས་འདོད་པའི་བསོད་སྙོམས་ཀྱི་རྗེས་སུ་བརྩོན་པའི་སླུ་བ་སེལ་ལ།",
    "སྦྱངས་པའི་ཡོན་ཏན་གཏི་མུག་མེད་པ་ནི་ཡོ་བྱད་བསྙུངས་པར་འཚམ་པར་བསྟེན་པས་བདག་ཉིད་དུབ་པའི་རྗེས་སུ་བརྩོན་པའི་སླུ་བ་སེལ་ཏེ།",
    "ཡང་ཅི་སྤྱོད་པའི་གང་ཟག་རྣམས་སྦྱངས་པའི་ཡོན་ཏན་སྟེན་པར་དགའ་ཞེ་ན།",
    "གཏི་མུག་སྤྱོད་པ་སྦྱངས་པའི་ཡོན་ཏན་སྟེན་པར་དགའི།",
    "སྤྱོད་པ་བསྒྲུབ་དཀའ་བ་ལ་བརྟེན་ནས་འདོད་ཆགས་རྣམ་པར་གནོན་པར་འགྱུར་ལ།",
    "གཏི་མུག་སྤྱོད་པ་ཡང་སྦྱངས་པའི་ཡོན་ཏན་སྟེན་པ་ཡང་དག་པར་བླངས་པ་ཡོ་བྱད་བསྙུངས་པ་ལ་བརྟེན་ནས་རྟག་ཏུ་བག་ཡོད་པར་འགྱུར་ཞིང་བག་ཡོད་ན་གཏི་མུག་རྣམ་པར་གནོན་པར་འགྱུར་རོ།",
    "གཏི་མུག་སྤྱོད་པ་སྦྱངས་པའི་ཡོན་ཏན་སྟེན་པར་དགའོ།",
    "དེ་ལྟ་བས་ན་ཞེ་སྡང་སྤྱོད་པ་ནི་སྦྱངས་པའི་ཡོན་ཏན་བསྟེན་པར་དཀའ་བ་ཡིན་ནོ།",
    "དུར་ཁྲོད་པ་ཉིད་ནི་ཟླ་བ་བརྒྱད་ཀྱི་མཐར་ཐུག་པར་བྱ་སྟེ།",
    "དབྱར་ནི་གཡོགས་པར་གནས་པར་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ངོ།",
