    "རྟགས་ཚིག་དེ་ནི་ཐེ་ཚོམ་གྱིས་དྲངས་པའི་མཐའ་གཅིག་ཏུ་ཤེས་པར་འདོད་པས་སྒྲུབ་བྱེད་འདྲི་བའི་སྐབས་ལ་བརྟེན་ནས་ཀྱང་འཇུག་པ་ཡིན་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པའི་མི་མཐུན་ཕྱོགས་སྒྲ་རྟག་ཅེས་ཁས་ལེན་ན་ཡང་སྒྲ་མི་རྟག་པའི་རྟགས་ཚིག་དེ་འཇུག་པར་མཚུངས་པའི་ཕྱིར།",
    "དེ་ཉིད་སྟོན་པའི་རྟགས་ཚིག་ལ་ཡང་དག་པར་གནས་ཀྱི་ཕྱོགས་ཚིག་ལ་མི་གནས་པའི་ཕྱིར།",
    "༣༥༤བ་གཏན་ཚིགས་ཀྱི་བྱེད་པ་འཇུག་པའི་ཡུལ་བསྟན་པ་མེད་པར་གཏན་ཚིགས་འཇུག་པ་རིགས་པ་མེད་པའི་ཕྱིར།",
    "ཕྱོགས་ཚིག་ཀྱང་བསྒྲུབ་བྱ་ལ་ནུས་པ་གྲུབ་པར་འདོད་དོ་ཅེ་ན།",
    "དེས་ན་ངེས་པར་ཡན་ལག་གཉིས་ལྡན་ཁས་ལེན་དགོས་ལ།",
    "དེ་དངོས་སུ་བརྗོད་པ་མེད་ཀྱང་སྒྲ་ནི་བྱས་པ་ཡིན་ལ།",
    "གང་བྱས་པ་འདི་འདྲ་ཀུན་མི་རྟག་ཅེས་ནི་བརྗོད་པས་ཀྱང་དོན་གྱི་ཤུཊ་ཀྱིས་སྒྲ་དེ་ནི་འཇིག་པར་རྟོགས་པའི་བློ་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར།",
    "དེ་དངོས་སུ་བརྗོད་པ་མེད་ཀྱང་རྒོལ་བས་སྒྲ་ནི་བྱས་པ་ཡིན་ལ།",
    "གང་བྱས་པ་འདི་འདྲ་ཀུན་མི་རྟག་ཅེས་བརྗོད་པས་ཀྱང་།",
    "སྒྲུབ་བྱེད་ཀྱི་ཡན་ལག་མ་ཡིན་པར་ཁས་ལེན་ན།",
    "ཐེ་ཚོམ་སྐྱེ་མི་རིགས་པར་བསྟན་པ་ཡིན་གྱི།",
    "རིགས་ཐ་དད་ལ་ཐེ་ཚོམ་སྐྱེ་མི་རིཊ་པར་སྟོན་པ་མ་ཡིན་ཏེ།",
    "གང་ཟག་སུ་ལ་ཡང་ཐེ་ཚོམ་གང་ཡང་སྐྱེ་བ་མི་རིགས་པར་འགྱུར་ཏེ།",
    "ཚིག་ཡིན་པས་ཁྱད་པར་དུ་བྱས་ནས་འགོད་ན།",
    "ཞེས་བྱ་བ་ལ་བྷ་ར་ཏ་འདོན་པས་མ་ངེས་པར་བརྩད་པ་ན།",
    "རིག་བྱེད་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར་རོ་ཞེས་ལན་བརྗོད་ན།",
    "རིག་བྱེད་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "གང་ཞིག་གཞན་དུ་གདོན་པར་མི་ནུས་པའོ་ཞེ་ན།",
    "ཁྱེད་༣༥༧ན་སྒྲུབ་ངག་འཆད་པའི་སྐབས་སུ་བསྒྲུབ་བྱའི་མཚན་ཉིད་འཆད་པ་མི་རིགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྦྱོར་བ་སྐོར་གཅིག་པོའི་སྒྲུབ་བྱེད་དུ་བཀོད་བཞིན་པ་མིན་པ་ཞིག་དགོས་པར་ཤེས་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "ཞེས་གསལ་བ་ཟུར་དུ་བཅད་ནས་གསུངས་སོ།",
    "མཚན་ཉིད་ཡན་ལག་ལྔ་གསུངས་པ་ནི།",
    "དེ་ཕྱིར་རྒོལ་གྱིས་བསལ་ཟིན་པ་མ་བསལ་བས་སེལ་བའི་ཚུལ་དེ་ལྟར་ཤེས་པར་བྱའོ།",
    "དེས་ན་བསྒྲུབ་བྱའི་མཚན་ཉིད་ཀྱི་ཟུར་དུ་འདོད་པ་ངེས་པར་སྨོས་དགོས་སོ།",
    "དེས་ན་གྲངས་ཅན་ཤེས་བྱ་ཐམས་ཅད་གྲངས་ཉི་ཤུ་རྩ་ལྔར་འདུས་པར་འདོད་ལ།",
    "དེ་ལྟ་མ་ཡིན་ན་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚེ་ཡང་།",
    "རྩོད་གཞི་མཐུན་སྣང་དུ་མ་གྲུབ་པར་འགྱུར་ཏེ།",
    "གྲངས་ཅན་གྱིས་སྒྲ་རྟག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་ཕྱིན་ཅི་ལོག་ཏུ་བྱེད་པའི་འགལ་བ་ཡང་གཅིག་ཁོ་ནར་འགྱུར་བས་འགལ་བ་དུ་མར་དབྱེ་བ་མི་འཐད་པར་འགྱུར་རོ་ཞེ་ན།",
    "གཞན་དོན་བྱེད་པ་ཁྱད་པར་གྱི་གཞི་ཡིན།",
    "མིག་སོགས་ཁྱད་པར་གྱི་གཞི་དང་།",
    "མི་རྟག་སྟེ་འདུས་མ་བྱས་ཡིན་པའི་ཕྱིར།",
    "དངོས་པོ་ཡིན་ཏེ་འདུས་མ་བྱས་ཡིན་པའི་ཕྱིར་ཅེས་པ་སྟེ།",
    "འདི་ནི་འོག་ཏུ་འཆད་པར་འགྱུར་རོ།",
    "བྱས་པའི་ཕྱིར་ཅེས་བཀོད་པ་ན།",
    "བདག་དོན་བྱེད་པ་སྒྲུབ་འདོད་པར་གང་ལས་ཤེས་ཤེ་ན།",
    "ཕྱི་རོལ་གྱི་དོན་ལྡན་མ་ཡིན་པར་འདོད་པས།",
    "སྒྲའི་རྣམ་དབྱེ་བརྒྱད་དང་ལྡན་པར་མཐོང་བའི་ཕྱིར།",
    "དེ་ལྟ་ན་ཕྱིར་རྒོལ་གྱི་ངོར་ཡང་གྲུབ་ཟིན་སྒྲུབ་པའི་ཉེས་པར་འགྱུར་བའོ།",
    "ཨུ་ལ་སོགས་པ་དོན་གསུམ་གསུམ་གོ་བའི་ནུས་པ་བརྡ་ལ་མི་བལྟོས་པར་ཡོད་པའོ།",
    "ལུས་སེམས་རྫས་གཅིག་པས་ལུས་ཞིག་ན་བློ་ཡང་མེད་པར་འགྱུར་བས།",
    "སྐྱེ་བ་སྔ་ཕྱི་མེད་པར་འགྲུབ་སྙམ་དུ་བསམས་སོ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི།",
    "ཞེ་འདོད་ཀྱི་བརྗོད་བྱས་སྟོང་པའི་ཚིག་ཡིན་པའི་ཕྱིར།",
    "བརྗོད་བྱས་སྟོང་པ་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "ཁྱད་པར་བསྒྲུབ་བྱར་མི་རུང་བས་སྤྱི་ཡང་བསྒྲུབ་བྱར་མི་རུང་ན་སྒྲའི་འཇིག་པདང་བུམ་པའི་འཇིག་པའི་ཁྱད་པར་གྱིས་རྟོག་ན།",
    "དེ་གཉིས་བསྒྲུབ་བྱ་མ་ཡིན་པས་སྒྲ་འཇིག་པ་ལའང་བསྒྲུབ་བྱ་མ་ཡིན་པར་མཚུངས་སོ་ཞེ་ན།",
    "སྒྲ་ལ་འཇིག་པའི་ཁྱད་པར་བསྒྲུབ་བྱ་མ་ཡིན་པས།",
    "སྒྲ་ཁོ་ན་ལ་གནས་པའི་མི་རྟག་པ་སྒྲ་ཡི་ཁྱད་པར་ཅན་དེ་ཉིད་བསྒྲུབ་བྱར་འགྱུར་ལ།",
    "སྒྲ་ལ་མི་རྟག་པ་ཙམ་མ་འབྲེལ་བ་རྣམ་པར་ལྡོག་ཅིང་གཅོད་པ་ཙམ་ཞིག་བསྒྲུབ་བྱར་བྱེད་པའི་ཕྱིར།",
    "གཞན་ལ་ལྡན་པ་རྣམ་པར་གཅོད་པའི་ཚུལ་རྣམ་པ་གཉིས་ཡོད་པའི་ཕྱིར།",
    "སྒྲ་དེའི་སྤྱི་མི་རྟག་པ་ཙམ་དང་ལྡན་པར་མ་གྲུབ་པས་སྒྲུབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "སྒྲས་མི་ལྡན་རྣམ་གཅོད་ཙམ་གྱིས་ཁྱད་པར་དུ་བྱས་པའི་ཕྱིར།",
    "སློབ་དཔོན་གྱིས་རྒོལ་བ་སྒྲུབ་འདོད་མེད་པ་བཀག་པས་རྒོལ་བའི་ཞེ་འདོད་ལ་གནོད་པར་མི་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "སྒྲ་རྟག་པར་སྒྲུབ་པའི་འགལ་རྟགས་ཡིན་ཡང་།",
    "རྩོད་པའི་ཚེ་རྒོལ་བ་བདག་ཉིད་ཀྱིས་དེའི་ཚེ་འདོད་ཡུལ་དུ་བྱས་པ་དེ་ཁོ་ན་རྟགས་དེའི་བསྒྲུབ་བྱ་ཡིན་གྱི།",
    "སྐབས་ཀྱི་བསྒྲུབ་བྱ་ལ་ཡང་གནོད་པར་འགྱུར་ཏེ།",
    "གཞན་ལ་སྟོན་པར་བྱེད་པ་ནི་དམ་བཅའ་ཡིན་ལ།",
    "དེའི་དོན་གཅིག་ལ་རྩོད་པའི་སྐབས་ཀྱིས་གཏན་ཚིགས་དེས་རབ་ཏུ་གནོད་པ་བྱས་ནའང་།",
    "དེ་ལ་སའི་ཡོན་ཏན་བཀག་པས་སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་འགལ་བར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚེ་སྒྲ་ལ་ནམ་མཁའི་ཡོན་ཏན་བཀག་པའི་སྒོ་ནས་ཀྱང་།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚེ་རྩོད་པའི་སྐབས་མིན་པ་དེ་ནི།",
    "སྐབས་ཀྱི་བསྒྲུབ་བྱ་ལ་གནོད་པར་འགྱུར་གྱི།",
    "བྱས་པས་སྒྲ་ལ་རྟག་པ་ནམ་མཁའི་ཡོན་ཏན་ཅན་བཀག་པ་དང་།",
    "ཅི་སྟེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚེ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་བསྒྲུབ་བྱ་སྤྱིའི་ཕྱོགས་གཅིག་ཏུ་གྱུར་པའི་ཁྱད་པར་ཡིན་པ་སོགས་ཀྱི་སྒྲུབ་བྱེད་ཀྱིས།",
    "ནམ་མཁའི་ཡོན་ཏན་ཡང་སྐབས་དེར་རྒོལ་བའི་འདོད་ཡུལ་གྱི་བསྒྲུབ་བྱ་ཡིན་པར་བརྗོད་དོ་ཞེ་ན།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚེ།",
    "སྒྲུབ་བྱེད་འགོད་པའི་ཚིག་དེ་ཙམ་ལ་བརྟེན་ནས་བསྒྲུབ་བྱ་ལ་དཔག་འདོད་ཡོད་པ་རྟོགས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་སྒྲུབ་བྱེད་ཀྱི་ཚིག་དེ་ནམ་མཁའི་༣༦༦ན་ཡོན་ཏན་གྱི་དཔག་འདོད་ལ་འཁྲུལ་པར་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིས་གནོད་པར་འགྱུར་བའི་ཕྱིར།",
    "འདི་དག་ལས་གང་ཕྱིན་ཅི་མ་ལོག་པར་གྲུབ་པ་ཡིན།",
    "གང་དག་ནི་ཕྱིན་ཅི་ལོག་པ་ཡིན་སྙམ་དུ་གཟུ་བོར་གནས་པའི་བློས་དཔྱོད་པར་བྱེད་པ་ཡིན་གྱི།",
    "དཔྱད་པ་མ་དག་བཞིན་དུ་ལུང་གནོད་བྱེད་དང་སྒྲུབ་བྱེད་དུ་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "སྒྲུབ་བྱེད་ཡོད་མེད་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་པར་འགྱུར་བས་སོ།",
    "དེ་ལྟར་གཞལ་བྱའི་གནས་ཀྱི་ཡུལ་གཉིས་ལ་དཔྱད་པ་རྣམ་པར་དག་ན།",
    "རིགས་པས་བྱས་པ་ཡིན་ན།",
    "མེ་ལ་སོགས་པ་རྗེས་སུ་དཔོག་པར་བྱེད་ནུས་པ་མྱོང་བས་གྲུབ་པའི་ཕྱིར།",
    "བྱས་པ་སྒྲ་རྟག་པ་དང་ངོ་བོ་ཉིད་ཀྱིས་འགལ་ཞིང་དེ་ལ་གནོད་པའི་ཕྱིར།",
    "གཞན་གྱིས་གོ་བར་བྱས་པས་རྒོལ་བ་སྐྱོན་ཅན་ཡིན་ནོ་ཅེ་ན།",
    "བྱས་པ་དེ་སྒྲ་ནམ་མཁའི་ཡོན་ཏན་ཡིན་པ་ལ་གནོད་བྱེད་དུ་བརྗོད་པའི་ཆ་ནས་མི་རིགས་པ་བྱེད་པ་མིན་ཏེ།",
    "སྐབས་དང་མཐུན་པར་གནོད་བྱེད་ཡང་དག་བརྗོད་པའི་ཕྱིར།",
    "ཕྱིར་རྒོལ་གཞན་དག་ལ་གཏན་ཚིགས་ཡང་དག་འགོད་པར་ཁས་བླངས་ནས།",
    "མི་རིགས་པ་བཀག་པས་རིགས་པ་ཡང་འགོག་དགོས་པར་སྨྲ་བའི་ཕྱིར།",
    "དེ་འདྲའི་ལུང་དོན་ཀུན་མཚུངས་པར་ཁྱབ་བྱེད་དུ་བྱས་ནས་སྒྲུབ་བྱེད་ཡང་དག་སུས་ཀྱང་བརྗོད་པར་ནུས་པ་མ་ཡིན་པ་དེས་ནའི་ཕྱིར།",
    "འདིར་སྲིད་པར་བྱས་ནས་འགོག་པ་ཡང་མིན་ནོ།",
    "འདིར་ཡང་སྒྲ་ལ་མི་རྟག་པ་བྱས་པས་གྲུབ་ལ།",
    "སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་ལ་བྱས་པ་རྟགས་སུ་བཀོད་པ་འདིར་ནི།",
    "སྒྲ་ལ་མི་རྟག་པ་དང་འགལ་བར་ངེས་པའི་ནམ་མཁའི་ཡོན་ཏན་ལ་ཅིག་ཤོས་དེས་གནོད་པར་འགྱུར་བའི་ཕྱིར།",
    "སྐབས་ཀྱི་བསྒྲུབ་བྱ་ལ་གནོད་པར་འགྱུར་གྱི།",
    "དྲི་ལ་སའི་ཡོན་ཏན་བཀག་པའི་སྒོ་ནས་སྒྲ་མི་རྟག་པ་ལ་གནོད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བྱས་པས་སྒྲ་ལ་ནམ་མཁའི་ཡོན་ཏན་བཀག་པས།",
    "ནུས་ན་ཡོན་ཏན་ཅན་དུ་དཔྱད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་འདིར་ནི།",
    "རྟགས་གཞན་གྱིས་གནོད་པ་བྱས་པ་དང་།",
    "ཞེས་དངོས་སྟོབས་ཀྱི་སྐབས་སུ་ཡང་དེ་ལྟར་བསྒྲུབ་བྱར་བྱས་ནས་སྒྲུབ་དགོས་སོ་ཞེས་འདོད་པ་ཡིན་ནོ།",
    "དེ་དོར་ནས་བསྟན་བཅོས་གཞན་ལ་འདོད་པས་འཇུག་པར་ཤེས་པའི་དོན་དུ་རང་ཉིད་འདོད་ཅེས་སྨོས་ཞེ་ན།",
    "ལོག་པར་རྟོག་པ་བསལ་བའི་ཚད་ཡིན་པའི་ཕྱིར།",
    "ལུང་དོན་ལ་གནོད་པས་སྐབས་ཀྱི་འདོད་ཡུལ་ལ་གནོད་པ་མེད་པར་ཤེས་པ་དང་ཁས་བླངས་པའི་ལུང་དོན་མཐའ་དག་སྐབས་ཀྱི་བསྒྲུབ་བྱ་མིན་པར་ཤེས་པ་དང་།",
    "ལུང་དོན་ལ་གནོད་པས་སྐབས་ཀྱི་བསྒྲུབ་བྱ་ལ་གནོད་ན་ཉེས་པ་ཐུག་པ་མེད་པར་བསྟན་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "འདི་ལ་བརྟེན་ནས་དེ་བསྒྲུབ་བྱ་མིན་པར་རྟོགས་པའི་ཕྱིར།",
    "སྒྲུབ་བྱེད་དུ་བཀོད་བཞིན་པའི་དུས་ན་བསྒྲུབ་བྱའི་ངོ་བོར་བསྟན་པ་དག་ཡོད་པ་ཡིན་ན་དེ་བཅད་པའི་ཆེད་དུ་བསྒྲུབ་བྱའི་ངོ་བོ་ཁོ་ན་ཉིད་དུ་བསྟན་པ་ཞེས་བྱ་བ་འདི་ནི་འབྲས་བུ་དང་ལྡན་པར་འགྱུར་བའི་ཕྱིར།",
    "དེ་ལ་གནོད་པ་གོང་དུ་རྒྱས་པར་བརྗོད་ཟིན་ཏོ།",
    "སོག་མ་ལས་བྱུང་བ་སོགས་ཀྱི་ཁྱད་པར་མི་རྟོགས་པར་བསྟན་པ་ལྟར་རོ།",
    "མིག་ཤེས་ཀྱི་གཟུང་བྱ་སྒྲའི་སྟེང་དུ་འགོད་ཚུལ་དང་མཐུན་པར་མ་གྲུབ་པའི་ཚེ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མ་གྲུབ་པའི་རྟགས་ཀྱི་སྐྱོན་ཡིན་གྱི་ཕྱོགས་ཀྱི་སྐྱོན་མིན་ཏེ།",
    "དེ་བཞིན་དུ་གཏན་ཚིགས་ཡང་དག་དང་ལྟར་སྣང་གཞན་དག་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཤེས་བྱེད་ཀྱི་རྒྱུ་དཔེ་དང་རྟགས་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱི་བསལ་བྱ་སེལ་བ་ལ་བལྟོས་པ་མེད་པར་ཕྱོཊ་ཀྱི་མཚན་ཉིད་མཚན་གཞི་འགའ་ལ་མ་ཁྱབ་པ་དང་།",
    "གཞི་གྲུབ་ན་བུམ་མེད་ཡིན་པས་ཁྱབ་པར་འགྱུར་ལ།",
    "རིགས་པའི་སྒོར་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་འགལ་བའི་དོན་གྱིས་མ་བསལ་བ་ཕྱོགས་ཡིན་ནོ།",
    "ཞེས་གསུངས་སོ།",
    "རིགས་སྒོར་ཕྱོགས་ཀྱི་མཚན་ཉིད་བསྡུས་ནས་བསྟན་པ་ནི་རིགས་མི་མཐུན་སེལ་བ་གཙོ་བོར་བྱས་པ་ཡིན་ལ།",
    "དེ་ལ་ཀ་ཏ་བའི་རྐྱེན་ད་ལྟར་གྱི་དུས་གོ་བྱེད་དུ་༣༧༦བ་ཡོད་པས་ཚིག་ཕྲད་ཀྱི་དོན་ཡང་གནས་པར་འཆད་པར་འགྱུར་རོ།",
    "རིགས་སྒོར་ཡང་ངེས་གཟུང་སྨོས་དགོས་པར་འགྱུར་ཏེ།",
    "སྐབས་དེར་ཚིག་ཕྲད་ངེས་པར་སྨོས་དགོས་ཏེ།",
    "འོ་ན་རིཊ་སྒོར་ཡང་ཚིག་ཕྲད་སྨོས་དགོས་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདིར་དུས་གསུམ་གའི་ཡུལ་ཅན་གྱི་བསྟན་བྱ་ཁྱད་གཞིར་འབྲེལ་བའི་ཕྱིརརིགས་སྒོའི་རང་ཉིད་འདོད་པར་གྱུར་པའི་ཚིག་དག་དེ་ཡིས་ནི་སྒྲུབ་བྱེད་དུ་བཀོད་བཞིན་པའི་གཏན་ཚིཊ་མ་གྲུབ་པ་དང་དཔེ་མ་གྲུབ་པ་སོགས་དུས་དེར་བསྒྲུབ་བྱ་ཡིན་པ་འགོག་ནུས་ཏེ།",
    "དེ་བསྟན་བྱ་ཁྱད་༣༧༧བ་གཞིར་མ་འབྲེལ་བས་མ་འོངས་པ་གཅོད་བྱེད་ཀྱི་ཡན་ལག་ཉིད་དུ་ཡོད་པའི་ཕྱོགས་ཀྱི་མཚན་ཉིད་ཀྱི་རང་ཉིད་འདོད་པར་འགྱུར་བའི་ཚིག་ཡིན་པའི་ཕྱིར།",
    "དོན་ནི་བསྟན་བྱ་དུས་གསུམ་ག་ལ་ཞུགས་པས་དེ་ཁྱད་གཞིར་འབྲེལ་བ་ན་འདོད་པ་ཡང་འདོད་པར་འགྱུར་བ་ལ་ཡང་ཞུགས་པས།",
    "བསྒྲུབ་བྱར་འདོད་པར་འགྱུར་བའི་ཕྱིར།",
    "ཅེས་པར་འགྱུར་བས་དེ་གཅད་པའི་ཆེད་དུ་ཚིག་ཕྲད་སྨོས་སོ།",
    "འོ་ན་རིགས་པའི་སྒོ་ལྟར་ཕྱོགས་ཀྱི་མཚན་ཉིད་སྨོས་པར་རིགས་ཀྱི་ཉེས་པ་མང་པོ་སྤང་དགོས་པའི་བསྟན་བྱ་སྨོས་པས་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "གལ་ཏེ་བསྟན་པར་བྱ་བ་ཡིན་དུ་ཆུག་ན་ཡང་།",
    "རྒོལ་བ་རང་ཉིད་ཅེས་པའི་ཚིག་དེས་རྒོལ་བ་བདག་ཉིད་འདོད་པ་མིན་པའི་བསྟན་བཅོས་ཀྱི་དོན་ཀུན་ལ་བལྟོས་པ་མེད་པར་རྒོལ་བ་དེའི་འདོད་ཡུལ་དུ་བྱས་པ་བསྒྲུབ་བྱ་ཉིད་དུ་གོ་བར་བྱེད་དེ།",
    "ལུང་དོན་གྱི་ཕྱོགས་གཅིག་ལ་གནོད་ཀྱང་རྒོལ་བའི་འདོད་ཡུལ་ཇི་ལྟར་ཡིན་པ་བསྒྲུབ་པ་ལ་གནོད་པ་མེད་པར་བསྟན་པ་དེས་ནའི་ཕྱིར།",
    "གཞན་དོན་གྱི་སྐབས་ནས་བསྟན་པར་བྱ་བའི་གཙོ་བོ་ནི་དེ་ཉིད་ཡིན་ལ།",
    "སྒྲ་མི་རྟག་པར་སྨྲས་ཙམ་གྱིས་སྒྲ་མི་རྟག་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "བདེ་བ་འབྱིན་པར་ཁས་བླངས་ནས།",
    "ཕྱིས་ཡང་བདེ་བ་མི་འབྱིན་པར་ཁས་བླངས་སོ།",
    "ཁ་ཅིག་དེ་རྟགས་ཡང་དག་མ་ཡིན་པར་འདོད་ལ།",
    "ཕྱོགས་དེ་གཉིས་ཀས་ལེགས་པར་མ་སྨྲས་ཏེ།",
    "གལ་ཏེ་ལུང་རྣམ་དག་ལས་དོན་མཐུན་དུ་གསུངས་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་ལ་མི་རྟག་པ་རྟགས་སུ་བཀོད་པ་ལྟ་བུ།",
    "བསྒྲུབ་བྱ་དེ་ཉིད་སྒྲུབ་བྱེད་དུ་བྱས་པའོ།",
    "དེ་གཉིས་སེལ་བྱེད་ཀྱི་ཚུལ་མཚུངས་པར་ཤེས་པའི་ཆེད་དུ་དེ་ལྟར་བསྟེན་པ་དེས་ནའི་ཕྱིར་རོ།",
    "དེ་ནི་སྒྲ་རྟག་པར་སྟོན་པའི་བསྟན་བཅོས་ཀྱི་དོན་གཞན་ལ་གནོད་བྱེད་དུ་འགྱུར་ཏེ།",
    "ཆེ་སྔར་ཉིད་རྣམ་པར་ལྡོག་ཟིན་པ་ཡིན་པའི་ཕྱིར།",
    "ལུང་སྒྲུབ་བྱེད་དུ་ཁས་བླངས་ནས་དཔྱོད་པའི་གནས་དག་ལ་ལུང་དང་འགལ་ན་དེས་གནོད་པའི་སྐྱོན་འདི་འཇུག་པར་འདོད་དེ།",
    "སེལ་བྱེད་རྩ་བའི་དབྱེ་བ་འཆད་པའི་སྐབས་སུ་རྗེས་དཔག་ལས་ཐ་དད་དུ་བྱས་པ་ལ་དགོས་པ་ཡོད་པ་ཡིན་ཏེ།",
    "ཡུལ་གྱི་ཁྱད་པར་བསྟན་པའི་ལོགས་སུ་བྱས་པ་དེ་ལྟ་མིན་ན།",
    "ཡུལ་གྱི་ཁྱད་པར་བསྟན་པའི་ཆེད་དུ་བྱས་པ་དེ་ལྟ་མིན་པའི་ཕྱིར།",
    "ལོགས་སུ་བྱས་པ་དོན་མེད་དོ་ཞེ་ན།",
    "ཡིད་ཆེས་དང་གྲགས་པ་དེ་ལས་ལོགས་སུ་བསྟན་པ་ན་དེ་དག་རྗེས་དཔག་ཏུ་མ་འདུས་སམ་སྙམ་པའི་དོགས་པ་བཅད་པའི་ཆེད་དུ་གསུངས་ཀྱི་དངོས་སྟོབས་རྗེས་དཔག་ཏུ་ངེས་ཟིན་ན་དོགས་པ་སྐྱེ་བའི་གཞི་མེད་པའི་དངོས་སྟོབས་རྗེས་དཔག་ལས་ཐ་དད་དུ་བྱས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "ལུང་འདིའི་དོན་ལ་བརྟག་པ་བྱས་པ་ན་ཕལ་ཆེར་ནང་འགལ་བ་བརྗོད་པར་མཐོང་བ་ཡིན་པའི་ཕྱིར།",
    "ཁྲུས་བྱས་པས་ཆགས་པ་མངོན་གྱུར་ཆུང་དུ་མི་འགྲོ་བ་རང་རིག་མངོན་སུམ་གྱིས་གྲུབ་པས་ཁས་བླངས་སྔ་ཕྱི་འགལ་བར་ཤེས་སོ།",
    "ནུས་པའི་ཁྱད་པར་དེ་ལ་ཁྲུས་ཀྱིས་མི་གནོད་པ་མངོན་སུམ་གྱིས་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་དག་ནི་བསྒྲུབ་བྱའི་སྒོ་ནས་ཁྱད་པར་ཞུགས་པ་ཡིན་གྱི་སྒྲུབ་བྱེད་ཀྱི་སྒོ་ནས་མ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཚུལ་ལུགས་ལས་གྲུབ་པའི་ཤེས་བརྗོད་ཀྱི་ཐ་སྙད་ཀྱིས་ཁྱད་པར་དུ་བྱས་པ་རྣམས་ཡིན་ལ།",
    "དེ་ནི་ད་ཏྲིག་ཤིང་ཞེས་པའི་སྒྲས་བརྗོད་དུ་མི་རུང་བ་ལ་གྲགས་པས་གནོད་པར་བསྟན་པ་ཡིན་ནོ།",
    "གྲགས་པ་མཚན་ཉིད་པ་རྣམ་པར་རྟོག་པའི་ཐ་སྙད་ལས་སྐྱེས་པ་ཡི་རྗོད་བྱེད་ཀྱི་སྒྲ་དེའི་ཡུལ་རྟགས་སུ་བཀོད་པའམ།",
    "སྔར་བརྡ་མ་བྱས་པའི་རྗོད་བྱེད་སྣ་ཚོགས་རྣམས་སུ་བྱུང་བའི་རྗོད་བྱེད་ཀྱིས་བརྗོད་དུ་རུང་སྟེ།",
    "ཞེས་གསུངས་སོ།",
    "ལུང་གཉིས་པའི་དོན་སྒྲ་བྱུང་གྲགས་པ་ལ་སྒྲུབ་བྱེད་ཡོད་པར་བསྟན་པ།",
    "གྲགས་རུང་གྲགས་པར་བཞེད་པ་ལས་གཞན་དུ་གྲགས་ཟིན་ཉིད་གྲགས་པར་བཞེད་པ་ཡིན་ན།",
    "འབྲས་བུ་དང་ལྡན་པར་འདོད་དེ།",
    "སྒྲ་ལས་བྱུང་བའི་གྲགས་པ་དང་ཞེས་གསུངས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "ཞེས་དེ་ལྟར་ཤེས་པའི་ཆེད་དུ་གསུངས་པའི་ཕྱིར།",
    "པར་བརྗོད་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལས་གཞན་གང་ཞིག་ཀྱང་དེ་ལྟར་འདོད་པར་འགྱུར་བ་མི་འཐད་པ་དེའི་ཕྱིར།",
    "ལུང་དང་པོ་གསུངས་པའི་ཕྱིར།",
    "རྟགས་སྔ་མ་མི་མཐུན་ཕྱོགས་ལ་མི་འཇུག་པར་སྒྲུབ་པའི་ཆེད་དུ་ཡིན་ནོ།",
    "གལ་ཏེ་རི་བོང་ཅན་ལ་ལ་ཁོ་ནར་ཟླ་བའི་སྒྲ་དེ་འཇུག་པར་གྲུབ་ན།",
    "གལ་ཏེ་རི་བོང་ཅན་ལ་གྲགས་པས་གྲུབ་པར་ཁས་ལེན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་ག་པུར་སོགས་ལ་ཡང་ཟླ་བའི་སྒྲ་དེ་འཇུག་པར་བརྡ་སྤྲོད་པའི་བློ་ངོར་ཡང་གྲུབ་པས་དེའི་ངོར་མཐུན་དཔེ་མེད་པ་མ་གྲུབ་བོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་དག་ལ་ཟླ་བའི་སྒྲ་གྲགས་པས་གྲུབ་པར་ཁས་ལེན་ནོ་ཞེ་ན།",
    "དེ་དག་དོན་དམ་པར་མ་གྲུབ་པར་བསྟན་པའི་ཕྱིར།",
    "གྲགས་པ་རྗེས་དཔག་ལས་ཐ་དད་དུ་བྱས་པའི་དགོས་པ་དང་།",
    "ཡིད་ཆེས་དང་གཉིས་ཀ་ཐ་དད་དུ་བྱས་པའི་དགོས་པའོ།",
    "སྔ་མ་ཡིད་ཆེས་རྗེས་དཔག་སེལ་བྱེད་རྩ་བའི་དབྱེ་བ་འཆད་པའི་སྐབས་དེར་རྗེས་དཔག་ལས་ཐ་དད་དུ་བསྟན་པ་བཞིན་དུ་ཐ་དད་དུ་བྱས་པ་ལ་དགོས་པ་ཡོད་པ་ཡིན་ཏེ།",
    "གྲགས་པའི་རྗེས་དཔག་གཉིས་ཡུལ་གྱི་ཁྱད་པར་བསྟན་པའི་ཆེད་དུ་རྗེས་དཔག་ཙམ་ལས་ལོགས་སུ་སྨོས་པ་ཡིན་པ་གང་ལས་ཤེས་ཤེ་ན།",
    "ཡུལ་གྱི་ཁྱད་པར་ཤེས་པའི་ཆེད་དུ་མེད་ན།",
    "རིགས་པ་རྒྱས་པར་འཆད་པར་འགྱུར་བའི་ཕྱིར།",
    "དེ་ལྟར་གྲུབ་ན་བྱས་མི་རྟག་སོགས་སྦྲུལ་མགོའི་གདེངས་ཀ་བཞིན་དུ་སྣ་ཚོགས་སུ་སྣང་བ་ཡི་ཉན་པའི་བློ་སྐྱེ་དགོས་པ་ལ་དེ་སྐྱེ་བ་མེད་པའི་ཕྱིར།",
    "སྒྲ་ལ་མེད་དོ་ཞེས་སྤོང་ན་མངོན་སུམ་གྱིས་གནོད་པར་འགྱུར་ཏེ།",
    "སྒྲ་དེ་ལ་དོན་དམ་པར་གྲུབ་པའི་ཕྱིར།",
    "སྒྲ་ལ་དོན་དམ་པར་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "སྒྲ་མཉན་བྱ་ཡིན་པ་དོན་ཉན་ཤེས་ཀྱིས་གྲུབ་པ་ཡི་སྟོབས་ཀྱིས་སྒྲ་མཉན་བྱ་མ་ཡིན་པ་ལ་གནོད་པར་ཤེས་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "ཚོགས་དོན་དེ་ལ་གནོད་པའི་སྒོ་ཁོ་ན་ནས་སྐབས་ཀྱི་བསྒྲུབ་བྱ་ལ་གནོད་པ་ཉིད་ཡིན་པར་སེམས་པ་ལྡོག་པའི་ཆེད་དུ་སྨོས་པ་དེས་ནའི་ཕྱིར།",
    "དེ་བཀག་ཀྱང་བསྒྲུབ་བྱ་ལ་གནོད་པའི་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "༣༩༦བ་འོ་ན་སྒྲ་ཡང་མཐུན་སྣང་དུ་གྲུབ་པ་མེད་པར་འགྱུར་ཏེ།",
    "དེར་ནི་ཁྱད་པར་དོར་བའི་ཉན་ཤེས་ཀྱི་གཟུང་བའི་དོན་ཙམ་ཞིག་གཉིས་ཀ་ལ་མཐུན་སྣང་དུ་གྲུབ་པ་ཡོད་ལ།",
    "དེ་ཡོན་ཏན་དོན་གཞན་དུ་མའི་རྟེན་བྱེད་པའི་རྫས་ཡིན་པ་དགག་པར་བྱ་བ་ཡིན་ནོ།",
    "དེས་དེ་འགག་པར་འགལ་ལོ་ཞེ་ན།"
  ]
