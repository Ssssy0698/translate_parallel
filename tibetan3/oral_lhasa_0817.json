    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "ཅད་མཁྱེན་པའི་ཡེ་ཤེས་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་བདག་གཞན་གཉིས་ཀ་ལ་སྨྲའོ།",
    "རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "རྣམ་པར་ཤེས་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཚིག་དང་དོན་ལ་སྨྲའོ།",
    "༧ འབུམ་དེ་དག་ནི་འདྲེས་ལ་སྦྱོར་བ་རིག་པར་བྱའོ།",
    "བཀའ་རྟགས་ཀྱི་ཕྱག་རྒྱ་དང་ལྡན་པར་བྱའོ།",
    "གླིང་བཞི་ཕུན་སུམ་ཚོགས་པ་རིག་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "རྣམ་པར་ཤེས་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་རྒྱུ་ལས་མ་བྱུང་བའོ།",
    "རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཡེ་མ་སྐྱེས་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "རྣམ་པར་ཤེས་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུས་པའོ།",
    "རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "རྣམ་པར་ཤེས་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་བདག་དོན་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "ཀྲེ་པ་ལྷོ་མའི་རྒན་ཆེན་ཚང་ནས་སྤྱི་ལོའི་དུས་རབས་ཉི་ཤུའི་སྟོད་དུ་བཞེངས་པའི་ལྡིབ་གཟུགས་ཡིག་ནག་ཅན་ཞིག་འཕྲུལ་པར་བྱས་པའི་བུ་དཔེ་ཞིག་ལ་གཞིར་བཞག་བྱས་ཐོག།",
    "གྱི་དེབ་གྲངས་༡༡༣ པར་ཞུས་བསྒྲིགས་བྱས་པ་ཡིན་ཀྱང་།",
    "སྤྱི་ལོ་༢ ཡར་སྔོན་ལོ་ངོ་ལྔ་བརྒྱ་ལྷག་ནས་གངས་ཅན་བོད་ཀྱི་ཡུལ་དུ་ཡི་གེའི་པར་ཁང་འཛུགས་བསྐྲུན་དང་།",
    "དཔེ་གཞི་ལེགས་བསྒྲིགས་བྱས་པའི་འགྲེམས་སྤེལ་ཡོངས་ཁྱབ་བྱེད་སྲོལ་དར་ཟིན་ནའང་།",
