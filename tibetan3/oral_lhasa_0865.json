    "གསུངས་ལྟར་ཞི་གནས་མ་འགྲུབ་པས།",
    "ཟས་གོས་བཟང་པོ་དང་མང་པོ་ལ་ལྷག་པར་ཆགས་པ་མེད་པས།",
    "ཟས་གོས་ངན་ངོན་ཙམ་གྱིས་ཆོག་ཤེས་པར་བྱེད་པ་དང་གསུམ།",
    "བྱིང་རྒོད་མེད་པར་གནས་དུས་འདུ་བྱེད་པའི་གཉེན་པོར་འདུ་མི་བྱེད་པར་བཏང་སྙོམས་སུ་གློད་ནས་འཇོག་པ་དང་བརྒྱད་དོ།",
    "བཞག་པའི་དམིགས་རྟེན་དེ་ཉིད་ལས་གཞན་དུ་མི་ཡེངས་པར་དམིགས་པ་དེ་ལ་རྒྱུན་དུ་འཇོག།",
    "སེམས་རང་བཞིན་གྱིས་རྒྱ་ཆེ་བས་ཡང་ནས་ཡང་དུ་ནང་དུ་བསྡུས་ཏེ་ཕྲ་བར་བྱས་ཉེ་བར་འཇོག།",
    "བདུན་པ་རྣམ་པར་ཞི་བར་བྱེད་པ་ནི།",
    "ཆགས་སེམས་དང་ཡིད་མི་བདེ་བྱིང་རྨུགས་སོགས་ལངས་བྱུང་བ་རྣམ་པར་ཞི་བར་བྱེད།",
    "རབ་ཏུ་འབད་ནས་བྱིང་རྒོད་ཀྱིས་བར་ཆད་པ་མེད་པ་བྱས་རྒྱུན་ཆགས་སུ་ཏིང་ངེ་འཛིན་ལ་རྩེ་གཅིག་ཏུ་འཇོག་པར་བྱེད།",
    "དགུ་པ་མཉམ་པར་འཇོག་པ་ནི།",
    "བྱིང་རྒོད་ཀྱི་རྣམ་པར་གཡེང་བ་ཐམས་ཅད་དང་བྲལ་ནས།",
    "འབད་མེད་ལྷུན་གྲུབ་ཏུ་ཏིང་ངེ་འཛིན་ལ་ངམ་ངམ་ཤུགས་ཀྱིས་འཇུག་པའི་ཚེ་རྩོལ་བའི་འདུ་ཤེས་མེད་པར་བཏང་སྙོམས་སུ་གློད་ནས་མཉམ་པར་འཇོག་པའོ།",
    "གདམས་ངག་ཐོས་པའི་སྟོབས་ལ་བརྟེན་ནས་སེམས་མཉམ་པར་འཇོག་ཚུལ་ལེགས་པར་ཤེས་པར་བྱས་ནས་འཇོག་པས་ན།",
    "དེ་ལྟར་མཉམ་པར་གཞག་པ་དེ་ཡང་ཡང་བསམ་པའི་སྟོབས་ཀྱིས་རྒྱུན་ཅུང་ཟད་འཐུད་ནས་སྐྱོང་བས་ན།",
    "འབད་རྩོལ་མེད་པར་ཏིང་ངེ་འཛིན་དུ་ཧྲིལ་ཧྲིལ་འགྲོ་བར་འགྱུར་བས་ན།",
    "གསུམ་པ་ཆད་པ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་ནི།",
    "ཆད་པ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་ཟེར།",
    "བཞི་པ་རྩོལ་བ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་ནི།",
    "དེ་ནས་བསྐྱངས་པའི་བར་ཡང་མི་འཆད་ཅིང་རྩོལ་བ་ཡང་རྒྱུན་པར་བརྟེན་མི་དགོས་པར་ངམ་ངམ་ཤུགས་ཀྱིས་ཏིང་ངེ་འཛིན་ལ་འཇུག་པས་ན།",
    "རྩོལ་བ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་ཟེར་རོ།",
    "ཤེས་བཞིན་གྱིས་ཤེས་པར་བྱས་ནས་སླར་སྔར་གྱི་དམིགས་རྟེན་ཡིད་ལ་ཝ་ལེར་དྲན་པར་བྱ།",
    "དམིགས་རྟེན་ལ་གཡོ་མེད་དུ་མི་གནས་པར་ཅུང་ཟད་འཕྲོ་བའོ།",
    "དམིགས་རྟེན་ལ་ལྷན་ནེ་གནས་དུས་རྩོལ་བ་མེད་པར་བཏང་སྙོམས་སུ་གློད་ནས་ཏིང་ངེ་འཛིན་གྱི་ངང་ལ་བཞག་པས་སྔར་བས་བརྟན་ཞིང་ཤིན་སྦྱངས་ཀྱི་བདེ་བ་དང་བཅས་པའི་ཞི་གནས་མཚན་ཉིད་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "མངོན་ཤེས་ལ་སོགས་ཞི་གནས་ཀྱི་ཡོན་ཏན་ཐམས་ཅད་ཐོབ་པར་འགྱུར་རོ།",
    "ཞི་གནས་རི་ལྟར་བརྟན་པར་བྱིན་གྱིས་རློབས།",
    "མཐུན་པར་གྱུར་པའི་ཡུལ་ན་གནས་པ་དང་།",
    "བྱིང་རྒོད་མེད་པར་གནས་དུས་འདུ་བྱེད་པའི།",
    "གཉེན་པོར་འདུ་མི་བྱེད་པར་བཏང་སྙོམས་བཞག།",
    "དམིགས་རྟེན་ཐོག་ཏུ་རང་སེམས་ལེགས་པར་འཇོག།",
    "ཞི་བར་བྱེད་དང་རྣམ་པར་ཞི་བར་བྱེད།",
    "རྩེ་གཅིག་བྱེད་དང་མཉམ་པར་འཇོག་པར་བྱ།",
    "ཐོས་པའི་སྟོབས་ཀྱིས་མཉམ་གཞག་ལེགས་པར་བྱ།",
    "དྲན་པའི་སྟོབས་ཀྱིས་བརྗེད་ན་དྲན་པར་བྱ།",
    "ཆད་པ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་དགོས།",
    "རྩོལ་བ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་འོང་།",
    "བྱིང་རྒོད་འོང་བ་ཤེས་པར་བྱས་ལ་སྤོང་།",
    "སྔར་གྱི་དམིགས་རྟེན་ཝ་ལེར་དྲན་པར་བྱ།",
    "རྩོལ་བ་གློད་ནས་བཞག་ན་བརྟན་པར་འགྱུར།",
    "འཇིག་རྟེན་ན་ཡང་ཤིང་རྟ་དང་ཤིང་རྟའི་ཡན་ལག་ཅེས་མིང་སོ་སོར་བརྗོད་པ་ཡང་དོན་མེད་པར་འགྱུར་བས་ན།",
    "གཅིག་མ་ཡིན་པར་ཐག་ཆོད་པ་དང་གཅིག།",
    "ཡན་ལག་རྣམས་སོ་སོར་བསལ་བའི་ཤུལ་ན་ཤིང་རྟ་འདི་འོ་ཞེས་སྟོན་རྒྱུ་ཡོད་དགོས་ཀྱང་རིག་པས་དཔྱད་ན་མེད་པས་ན་སོ་སོར་ཡང་མེད་པར་ཐག་གཅོད་པ་དང་གཉིས།",
    "ཡན་ལག་རྣམས་ཀྱི་རྟེན་དུ་ཡང་མེད་པར་ཐག་གཅོད་པ་དང་གསུམ།",
    "ཡན་ལག་རྣམས་ལ་བརྟེན་ནས་ཀྱང་ཤིང་རྟ་མེད་པར་ཐག་གཅོད་པ་དང་བཞི།",
    "ཡན་ལག་ལ་ཤིང་རྟ་ལྡན་པ་ཡང་མ་ཡིན་པར་ཐག་གཅོད་པ་དང་ལྔ།",
    "ཡན་ལག་འཚོགས་པ་ཙམ་ཤིང་རྟ་མ་ཡིན་པར་ཐག་གཅོད་པ་དང་དྲུག།",
    "དེས་ན་ཡན་ལག་འཚོགས་པའི་དབྱིབས་ཀྱང་ཤིང་རྟ་མ་ཡིན་པར་ཐག་གཅོད་པ་དང་བདུན་ནོ།",
    "འཇིག་རྟེན་ན་ང་དང་ངའི་ཕུང་པོ་ཞེས་སོ་སོར་བརྗོད་པ་ཡང་དོན་མེད་པར་འགྱུར་བས་ན།",
    "ང་དེ་ཕུང་པོ་ལྔ་དང་གཅིག་ཏུ་མ་གྲུབ་པར་ཐག་བཅད།",
    "སོ་སོར་ཡང་མ་གྲུབ་པར་ཐག་བཅད།",
    "རིགས་པས་བརྟག་ན་མེད་པས་ཕུང་པོ་ལྔ་ཡི་རྟེན་དུ་ཡང་མེད་པར་ཐག་བཅད།",
    "ཕུང་པོ་ལྔ་ལ་བརྟེན་ནས་ཀྱང་ང་མེད་པར་ཐག་བཅད།",
    "ཕུང་པོ་ལྔ་ལ་ང་ལྡན་པ་ཡང་མ་ཡིན་པར་ཐག་བཅད།",
    "ཕུང་པོ་འཚོགས་པ་ཙམ་ཡང་ང་མ་ཡིན་པར་ཐག་བཅད།",
    "དེས་ན་ཕུང་པོ་ལྔ་འཚོགས་པའི་དབྱིབས་ཀྱང་ང་མ་ཡིན་པར་ཐག་བཅད།",
    "རང་བཞིན་མེད་པའི་ངེས་པ་འདྲེན་པར་བྱ།",
    "རང་བཞིན་མེད་པར་གཏན་ལ་དབབ།",
    "དེ་ནས་སྤྲོས་པ་ཆེར་མི་བྱེད་པར་དེ་བཞིན་དུ་རི་རྭ་བ་ཁང་ཁྱིམ།",
    "དེ་ནས་བསྐྱངས་པས་ལུས་སེམས་ལ་སྔར་མེད་པའི་ཤིན་སྦྱངས་ཀྱི་དགའ་བདེ་ཁྱད་པར་ཅན་དང་བཅས་པས་མཉམ་གཞག་བརྟན་པོ་བྱུང་ན།",
