    "ནང་ནུབ་ཟས་ནོར་ཏེ་འདུ་བ་རྣམ་པ་གསུམ་རྣམས་ནི་ཐམས་ཅད་ཀྱི་མཐུན་སྣང་དུ་གྲུབ་པ་དེར་གདའ།",
    "ལར་ཁྱེད་རང་རྣམས་ནས་བྱ་དགོས་ངེས་དེ་ཅིའང་མི་བྱེད།",
    "འདི་དེ་ཙམ་གྱི་རྙིང་ཉམས་བཅའ་ཁ་སོགས་མི་འདུག་པས་ནམ་ཅི་ཆེ་གསུངས་པས།",
    "རྗེ་ཉིད་ཁྱམས་ཡངས་པ་ཞིག་ན་ཁྲི་མཐོན་པོར་བཞུགས་འདུག་པ་ལ།",
    "སུ་བྱིས་པ་ཆུང་ངུའི་ངང་ཚུལ་གྱིས་བརྩེ་གདུང་དང་བཅས་ཏེ་བཞུགས་འདུག་པ།",
    "སྟོད་ཀླུ་འཇིམ་གྱི་རྣམ་པ་རྡོ་རྗེ་འཆང་སྐུ་སྐེད་ཡན་ཆོད་ཤིན་ཏུ་གསལ་བ་ཞིག་འདུགཡི་གེ་ཁ་ཕྱེ་བས།",
    "ཤོག་སེར་ཆུང་ངུ་ཞིག་འདུག་སྟེ་ངེད་ནས་ཀློག་མི་ཤེས་གསུངས།",
    "དེར་སུ་འདུག་བལྟ་དགོས་དགོངས་ནས་ཕེབས་པས།",
    "དེར་མངའ་རིས་རིག་འཛིན་ལེགས་ལྡན་རྡོ་རྗེ་ཉིད་སྔགས་པའི་ཆ་ལུགས་ཅན་དུ་བཞུགས་འདུག་པ་ལ་གུས་འདུད་མཛད་ནས་འདིར་ཕེབས་དོན་ཅི་ཡིན་ཞུས་པར།",
    "ཁྱེད་རང་གསུམ་ཙམ་མ་གཏོགས་སྐས་ཆེན་འདི་ཚུགས་ཐུབ་པ་ནི་སུའང་མི་འདུག་ཟེར་བ་ཞིག་བྱུང་བས་འདི་ལའང་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གསུངས།",
    "ཡིད་དུ་འོང་བ་ཞིག་ཏུ་ཕེབས་འདུག་པར།",
    "མཐར་འཆི་དུས་ཀྱང་གཅིག་པུར་འཆི་བས་གལ་ཆེ་ཤོས་དེ་གཉིས་ལ་བློ་སྟོན་གྲོས་བྱེད་མཁན་སུ་མི་འདུག་པ།",
    "རྗེ་ཉིད་སྐུ་ན་གཞོན་ནུའི་དུས་སྐུ་གཟུགས་ཐང་པོ་ཞིག་ཡིན་འདུག་རུང་།",
    "རིགས་ཕལ་ཆེར་རྩ་གསུམ་སྒྱུ་འཕྲུལ་དྲྭ་བའི་ལུང་བྱང་དུའང་གསལ་ཆ་ཡོད་པར་འདུག་དགུང་ལོ་བཅུ་དྲུག་པ་ཤིང་ལུག་ས་ག་ཟླ་བའི་ཚེས་བརྒྱད་ལ་མནལ་ལམ་དུ།",
    "ད་ནས་དུས་ཡོལ་ཟིན་པས་ཅི་བྱ་མེད་ནའང་ཁྱེད་རང་ལ་ཐེངས་པ་ཡིན།",
    "ཡང་མེ་ཡོས་ལོར་རྗེ་ཉིད་དང་མཆོག་གླིང་ལྷན་རྒྱས་ཕེབས་བཞུད་མཛད་སྐབས་ཡབ་གཞིས་རི་བོ་ཁྱུང་ལྡིང་ངམ་ཁྱུང་ཚང་བྲག་ནས་རྡོ་སྒྲོམ་རིམ་པ་གསུམ་པ་ཞིག་སྤྱན་དྲངས་པ་ལ་རྩ་གསུམ་བཀའ་འདུས་ཀྱི་ཆ་ལག་རྗེ་འབངས་ཉེར་ལྔ་སོ་སོའི་སྒྲུབ་ཐབས་དམ་རྫས་བཅས་བཞུགས་པ་ཡིན་འདུག་ཀྱང་།",
    "པ་མི་འོང་བར་འདུག་པས་དེ་རིགས་ལོན་རྒྱུ་བྱུང་ན་གལ་ཆེ་བ་ཡོད་ཚུལ་བཀས་གནང་བ་ལྟར།",
    "གཞན་ཐམས་ཅད་རྗེ་ཉིད་ནས་འབེབས་པར་གནང་འདུག་པ་དང་།",
    "འདི་སྐོར་དག་སྣང་མང་དུ་འདུག་ཀྱང་འདིར་མ་བཀོད།",
    "ཕྱིས་སུའང་དགོངས་པ་ཆེད་དུ་གཏད་ན་ཞིབ་ཆ་མཁྱེན་པར་འདུག་གསུངས།",
    "ནག་ཕྱོགས་དར་ན་ཕུང་ཁྲོལ་ཚབ་ཇེ་ཆེར་འགྱུར་བས་དམ་སྲི་འདི་རྣམས་བསྒྲལ་དགོས་ཞེས་ནན་གྱིས་བཏུད་ནས་ཟེར་འདུག་པ་ལ།",
    "བྱུང་འདུག་དེ་རྗེས་ངོས་བཟུང་མེད་པའི་བསྙུན་ཁམས་ཀྱིས་གསུང་འགག་པ་སོགས་ཀྱང་བྱུང་འདུག་པས།",
    "དེ་སྐབས་བསྟན་པའི་རིམ་གྲོ་འདོན་བྱ་སོགས་སྒྲུབ་མཁན་མང་འདུག་ཀྱང་དོན་དུ་རྗེ་འདི་ཉིད་ཀྱི་ཐུགས་རྗེས་ནག་ཕྱོགས་གདུག་པའི་ཚ་ངར་ཕྱེད་ཙམ་ཞི་ནས་རྒྱལ་ཁམས་སུ་བདེ་སྐྱིད་སྤྲིན་བར་གྱི་ཉི་མ་ཙམ་བརྡོལ་བར་མངོན་ནོ།",
    "རང་རང་ཉམས་ལེན་མཐར་དབྱུང་ལ",
    "བར་སྣང་དུ་སླེབས་པ་ལྟ་བུ་མཐོ་བའི་ནང་དུ་ཁྲི་སྟན་ཞིག་འདུག་པ་ཉིད་ཀྱི་ཡིན་སྙམ་གྱིས་དེར་བཞུགས།",
    "བར་དན་དུ་ཆང་བུམ་ལྟ་བུའི་ལྗང་གུ་ཆེ་ལེགས་ཞིག་འདུག་པ་ན་ཉིད་སྔར་མལ་བཞུགས།",
    "ཁྱེད་རང་རྣམས་སློབ་དཔོན་པདྨ་དང་།",
    "དེ་སྔ་གཏེར་སྟོན་གྱི་མིང་ཐོགས་མི་འདུག་མིང་ཐོགས་དགོས།",
    "ཞེས་གསུངས་པའང་ཇི་བཞིན་བྱུང་བར་འདུག་གོ།",
    "ཁྱེད་སྔ་འགྱུར་ལོ་ཙཱ་བ་ཡིན་ན་རྗེ་འབངས་ཉེར་ལྔའི་གྲལ་དུ་མི་འདུག་ན་གསུངས་པས།",
    "ད་རུང་གཏེར་རྙིང་སྐོར་ཉི་ཤུ་རྩ་ལྔ་ཁ་ལོངས་པ་ཞིག་ཕབ་རྒྱུ་དང་འཇོག་རྒྱུ་ཐོན་ན་ཁྱེད་རང་གཉིས་གང་རུང་ལོ་ཉི་ཤུ་རྩ་ལྔ་སྡོད།",
    "ནོར་བུའི་ཁང་པ་དང་རྒྱན་སོགས་ལ་ལོངས་སྤྱོད་པའི་ཡ་མཚན་ཅན་ཞིག་འདུག་སྙམ་བྱེད་པའི་ངང་དེ་ལས་སད་གསུངས།",
    "གསོལ་ཚིགས་ཞིག་ཞུ་དགོས་ཟེར་འདུག་པས་རྟ་འདི་ཆིབས་ནས་གསོལ་ཚིགས་ལ་འབྱོན་པར་ཞུ་ཟེར།",
    "ཟབ་བུ་ལུང་གཏེར་ལུང་མཇལ་དུ་འགྲོ་བ་ཡིན་ཁོ་ན་གསུངས་ཀྱིན་འདུག་ལམ་དུ་ཆར་པ་འགའ་ཞིག་བབས་པ།",
    "ཕྱི་དྲོ་ལུང་པའི་རྐེད་ཙམ་སླེབ་པ་ཆུ་ཕར་ཀ་དེར་འབྲོག་དུད་ཕྱུག་པོ་ཞིག་འདུག་པ།",
    "ཉིད་དཔོན་སློབ་ནས་ཕོ་གཏོར་སོགས་འབག་འབོག་མི་མཛད་པར་ཞུ་འདུག་དེ་ནུབ་ཐུགས་དམ་འདྲ་མཛད་ཀྱིན་བཞུགས།",
    "ཞལ་རྒྱན་ཅུང་ཟད་ཡོད་པ་ཞིག་ཆར་ཡིབས་ལྟ་བུས་བཞུགས་འདུག་པ་བཞེངས་ནས།",
    "སེང་ཁྲིའི་ཕྱོགས་བཞིར་སྒོ་འདུག་པས་ཕྱོགས་བཞི་ཀར་ཕེབས་ཀྱང་སྒོ་རྣམས་བཅད་པས་ནང་དུ་མ་བརྟོལ།",
    "འདི་ལ་རྫོགས་རིམ་ལས་ཚོགས་སོགས་ཟབ་རྒྱས་བཞུགས་ཡོད་འདུག་ཀྱང་རྩ་བའི་ཕྲིན་ལས།",
    "རྣམ་རྒྱལ་མའི་སྒྲུབ་ཐབས་ཙམ་འབེབས་པར་མཛད་འདུག་གོ།",
    "དེར་ཤིང་ལོ་སྔོན་པོའི་སྤྱིལ་བུ་ཞིག་འདུག་པ་སྒོར་ཕེབས་པས།",
    "ཁྱེད་རང་ཐམས་ཅད་ཀྱི་བརྒྱུད་པ་ལ་ཡོད་ཅིང་གསོལ་བ་འདེབས་ཡུལ་ས་ར་ཧ་ཞེས་པ་དེ་ཡིན་གསུངས།",
    "ཁྱེད་ནས་ད་སྔ་བསྙེན་རྫོགས་སུ་ལ་མ་བསྒྲུབས་འདུག་པས་ད་སྟེ་མི་ལྔ་བཅུ་ལ་བསྙེན་རྫོགས་བསྒྲུབ་དགོས་པས།",
    "དེར་ལས་གྲྭ་མི་སུའང་མི་འདུག་པས་ཅི་འདྲ་མཛད་རྒྱུ་ཡིན་དགོངས་པས།",
    "མགོན་བྱེད་རང་རང་རྟེན་ལས་བཞེངས།",
    "རང་རང་བརྟེན་པའི་གནས་ནས་བཞེངས།",
    "སུ་ཁྱེད་རང་རྣམས་གང་དུ་གནས་པའི་གོ་སར་ཉི་མ་ལ་གནས་པའི་སོགས་གོང་ལྟར་ལ།",
    "ཁྱེད་རང་གསང་བའི་བདག་པོ་ཞེས་བསྒྱུར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཙནྡན་ལ་སོགས་པའི་འདུག་སྤོས།",
    "རང་རང་ཡིད་མཐུན་སྣོད་ནང་དུ།",
    "རང་རང་མཐུན་རྫས་འདི་ཁྱེར་ལ།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཁ་ན་མ་ཐོ་མེད་གནས་འདུག།",
    "རང་རང་གནས་སུ་གཤེགས་ནས་ཀྱང་།",
    "གཏད་མེད་རྒྱ་ཡན་ངང་དུ་རང་བབས་ལ་འབྱམས་འདུག།",
    "གཅེར་མཐོང་རང་ས་ཟིན་པའི་དུས་ཚོད་ལ་སླེབ་ཚེ།",
    "གེགས་དང་གོལ་སའི་སྤྲིན་ཚོགས་ཁོ་རང་ཡང་རྫུན་པས།",
    "དགག་སྒྲུབ་མེད་པར་རང་བྱུང་རང་ལ་སྐད་གཉིས་ཤན་སྦྱར་དང་རྟོགས་བརྗོད་གཡང་སྒྲུབ་སོགས་ཀྱི་སྐོར།",
    "ཕན་གནོད་མི་བྱེད་རང་བྱུང་རང་ལ་ཐིམ།",
    "བཅུ་བདུན་ལོའི་ལོ་སྟོད་ལ་པ་སྣམ་བེ་ལུང་དགོན་དུ་ཨ་ཞང་ཆེན་པོ་བྱམས་པ་ཕུན་ཚོགས་མཆོག་ལས་བྱཱ་ཀ་ར་ནའི་སུམ་ཀུན་རྟགས་དང་།",
    "ནམ་ལངས་ནས་བལྟ་སྐབས་རྐང་རྗེས་ཙམ་ཡང་མི་འདུག་གནས་དེ་སྔགས་སྲུང་མའི་གནས་ཆེན་ཡིན་པས་དེའི་འཁྲུལ་ཉམས་ཡིན་ནམ་སྙམ།",
    "དོན་དབུས་གཙང་། པ་རྣམས་ན་ཐིག་པ་འདུག་གསུངས།",
    "གཅིག་བཅས་མཁོ་བསྡུས་གྲྭ་དཀྱུས་ལྟ་བུ་མཛད་ནས་བཞུགས་འདུག་པ་དང་མཇལ།",
    "དེས་གནོད་འདུག་གསུངས་ནས་གྲྭ་གཞོན་ཁག་གཅིག་ཐོ་བ་སོགས་འཁྱེར་ནས་གཏོར་བར་བཏང་།",
    "ཁོང་རང་འཕྲུལ་འཁོར་ལ་ཧ་ཅང་མཁས་པོ་འདུག་འཕྲུལ་འཁོར་རྣམ་གྲངས་བརྒྱ་ཕྲག་ཙམ་འདུག་གཅིག་བརྒྱུད་དཔེ་ཐོག་བྲིས་མི་ཆོག་པ་ཞིག་ཡིན་ཀྱང་འཕྲུལ་འཁོར་གྲངས་མང་བས་བརྗེད་ཐོ་བསམ་བྱར་མཛད་འདུག་པ་བསྐྱར་བཤུས་ཆོག་པའི་གནང་བ་ཞུས་ནས་འབད་བརྩོན་གྱིས་སྦྱང་སྟེ་བྱང་པོ་བྱུང་།",
    "དགོན་ནང་དུ་ཡང་གྲྭ་བ་ཁ་ཤས་ལས་མེད་པ་རང་ཡུལ་དུ་ཕྱིན་ཟིན་འདུག་ཀྱང་།",
    "སྐུ་ཞབས་ཡང་ཡར་བཞེངས་ནས་བྲོ་གར་བྱེད་འདུག་དེའི་ནང་ལྕམ་སྐུ་ཞབས་ཀྱི་སྟང་སྟབ་ནི་ཆེས་མཛེས་པ།",
    "ལུགས་པ་ལ་ཡང་འདི་འདྲ་ཡོད་ན་ཅི་མ་རུང་ཞེས་ཡང་ཡང་དྲན་གྱི་འདུག་གསུངས།",
    "ཁོང་རང་རྒྱལ་པོའི་བརྒྱུད་དུ་འཁྲུངས་པས་བ་མེན་ལྔ་དྲུག་ཙམ་ཡོད་ལ་བ་མེན་ནི་ཧ་ཅང་དཀོན་པའི་ཚད་ཡིན་ཞེས་གསུངས་སོ།",
    "གཏོར་མའི་རྩི་དེ་རངས་མིན་ཚུལ་ཞུས་པར་དེ་འདྲའི་འོད་ཆེན་དེ་འདྲ་རངས་ལ་མ་གཏོགས་ག་ནས་འོངས་ཞེས་ཐུགས་ཡིད་མི་བསྐྱང་བར་འདུག་གསུངས།",
    "འོན་ཀྱང་དོན་ཆེན་པོ་མེད་འདུག་ཅེས་རྣམཞུས་འདུག་པར།",
    "༡༩༨༦ ལོའི་ཟླ་བ་གསུམ་པའི་ནང་རང་དགོན་འདིར་སྨྱུང་གནས་ཀྱི་ཕན་ཡོན།",
    "ཚོགས་ཀྱི་ལྷག་མ་ཕལ་ཆེར་དང་ཆད་ཐོ་བཅས་ཀྱི་འབུལ་ཡུལ་ཡང་གཙང་རིས་དཔལ་མགོན་བདུན་བཅུ་རྩ་ལྔ་ཡིན་པས་ཧ་ཅང་ཡག་པོ་འདུག་ཅེསགསུང་ནས་དགྱེས་ཚོར་ཆེ་བས་ནན་ཏན་གྱིས་འབུལ་གནང་མཛད།",
    "ཕྱི་ལོ་༡༩༩༤ལོའི་ནང་རང་དགོན་དུ་གཞི་གསུམ་གྱི་ཆོ་ག་བསྟན་པའི་མིག་རྐྱེན་བཟང་པོ་ཞིག་འཛུགས་ཐུབ་རྒྱུར་ཐུགས་དགོངས་རྒྱ་ཆེར་བཞེས་ཏེ།",
    "ལྟར་གསུང་གནང་བ་མ་ཟད་ཁོང་རང་ཡང་རྒྱུན་གཏན་གསུང་མཛད་ཀུན་མངོན་ཤེས་ཀྱི་མཁྱེན་པ་ལྟར་གསུང་རྒྱུ་ཡོད་ཀྱང་།",
    "སྟེགས་མཐོ་བ་ལ་གཏོར་མ་ཀྱོག་མེད་པ་བཤམས་ནས་རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "། ཀྱང་རང་ལ་བསྡུས།",
    "དེ་ཡང་རང་ཉིད་འཕགས་པར་གསལ་བའི་ཕྱག་གཡས་བུམ་པའི་ནང་དུ་པདྨ་ཉི་ཟླའི་གདན་ལ།",
    "དེ་རྣམས་རང་རང་གདན་ལ་བཞུགས་པར་བསམ",
    "མི་ལྷེབ་ལྷེབ་འདུག་པས།",
    "སེ་གོལ་ཕྱིར་བསྟན་གྱི་ཏོག་ཅིང་རང་ཉིད་ཁྲོ་བོ་བདུད་རྩི་འཁྱིལ་ཕར་གསལ་བའི་ཐུགས་ཁ་ནས་ཁྲོ་ཚོགས་དཔག་ཏུ་མེད་པ་འཕྲོས།",
    "མགྲོན་རྣམས་ལ་ཐོབ་རྒྱ་ཆུང་བར་འདུག་གསུངས།",
    "དེ་ལྟར་བྱང་གཏེར་བཀའ་བརྒྱད་རང་བྱུང་རང་ཤར་གྱི་ཆ་ལག་ཆུ་གཏོར་བརྒྱ་རྩའི་ངག་འདོན་རིག་འཛིན་ཆེན་པོ་པདྨ་ཕྲིན་ལས་ཀྱིས་ནག་འགྲོས་སུ་མཛད་པ་དེར།",
    "ཞུས་ཆེན་སྒྱུར་བྱེད་མཆན་བུའི་གནས་འདུག་པའི།",
    "ཞེས་ལོ་ཙཱ་བ་བེེ་རོ་ཙ་ན།",
    "ཞག་དང་ཉིན་མཚན་སྐད་ཅིག་དུས་མི་རྟག།",
    "ཨོཾ་ཨ་ཙིནྟེ་ཛྭ་ལ་ཡེ་སྭཱཧཱ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "རང་རང་སྐད་དང་བློ་འཚམས་པའི།",
    "རང་རང་ལས་ཀྱི་ཕྲིན་ལས་བཅོལ།",
    "འགྲོ་ཀུན་རང་རང་འདོད་པ་ཡི།",
    "དེ་ནི་འཆག་འདུག་འགྲེང་ཞིང་གནས་པའི་ཚེ།",
    "གཞན་ཡང་རང་ཉིད་བློ་གྲོས་ཀྱི་རྩལ་ཞན་པ་ཞིག་ཡིན་ཀྱང་།",
