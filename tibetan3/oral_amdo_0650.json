    "ཀོ་ཤ་ཀ་དེ་བས་ན་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དདག་གིས་དེ་བཞིན་གཤེགས་པ་བཞུགས་ཀྱང་རུང་དེ་བཞིན་གཤེགས་པ་ཡོངས་སུ་མྱ་དན་ལས་འངས་ཀྱང་རུང་སྟེ།",
    "དེ་དག་གིས་བསམ་གཏན་གྱི་ཕརོལ་ཏུ་ཕྱིན་པ་ཉིད་ལ་བརྟེན་པར་བྱསྟེ།",
    "དདག་གིས་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་བཟོད་པའིཕརོལ་ཏུཕྱིན་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་སྦྱིན་པའི་ཕ་རོལ་ཏུཕྱིན་རྟེན་པར་བྱསྟེ།",
    "དེ་དག་གིས་ཤྲྰི་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱསྟེ།",
    "དེ་དག་གིས་སྟོངཔ་ཉིད་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེདག་གིས་དོན་དམ་པ་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱསྟེ།",
    "དེདག་གིས་འདུས་བྱས་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིང་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་དོར་བ་མྱེ་དང་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་རང་བཞིན་སྟོང་བ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེདག་གིས་རངགི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལ་བརྟེན་བར་བྱ་སྟེ།",
    "ཀོ་ཤ་ཀརང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་འདི་ནི་ཉན་ཐོས་དང་།",
    "དེ་དག་གིས་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ལ་བརྟེན་པར་བྱསྟེ།",
    "དེ་དག་གིས་དྲན་པཉེ་བར་གཞག་པརྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེདག་གིས་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱུདཔ་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་འཕགས་པའི་བདེན་པ་རྣམས་ལ་བརྟེན་པར་བྱསྟེ།",
    "ལྷ་ད་མི་དང་ལྷམ་ཡིན་གྱིསྐྱེ་དགུའི་བར་གྱི་རྟེན་ཡིན་ནོ་དེ་དག་གིས་བསམ་གཏན་རྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་བ་རྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་མཐར་ཀྱིས་གནས་པའིསྙོམས་པར་འཇུག་པ་རྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་རྣམ་པར་ཐར་བའི་སྒོ་སྟོང་པ་ཉིད་དང་།",
    "དེ་དགྲ་གིས་ཏིང་ངེའཛིན་རྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་གཟུངས་ཀྱི་སྒོ་རྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་དེ་བཞན་གཤེགས་པའི་སྟོབས་རྣམས་ལབརྟེན་པར་བལྟ།",
    "དེ་དག་གིས་མྱ་འཇིགས་པ་རྣམས་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེདག་གིས་ཐམས་ཅད་ཤེས་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིང་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "དེ་དག་གིས་རྣམ་པ་ཐམས་ཅད་མ་ཁྱེན་པ་ཉིད་ལ་བརྟེན་པར་བྱ་སྟེ།",
    "ཀོ་ཤི་ཀ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གི་ས།",
    "ཀོ་ཤ་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བྲིས་ཤིང་འཛན་པ་དང་།",
    "ཀོ་ཤི་ཀམཆོད་རྟེནགཅིག་ལྟ་ཞོག་གི།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལལ་ཞིག་གིས།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བྲིས་ཤིང་འཛན་པ་དང་།",
    "ཀོ་ཤི་ཀ་འཛམ་བུའི་གླིང་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་གྱིས་ཡོངས་སུ་བཀང་བ་ལྟ་ཞོག་གི།",
    "ཀོ་ཤི་ཀ་གལ་ཏེ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་གང་ལ་ལ་ཞིག་གྲིས་དེ་བཞིན་གཤེགས་པ་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ནས།",
    "ཀོ་ཤཾ་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་གླིགས་བམངུ་བྱས་ཏེ་འཛིན་པ་དང་།",
    "ཀོ་ཤ་ཀ་གླིང་བཞི་པའི་འཇིག་རྟེན་། ཀྱི་ཁམས་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་གྱིས་ཡོངས་སུ་བཀང་བ་ལྟ་ཞོག་གི།",
    "ཀོཤི་ཀ་གལ་ཏེ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་ག་ངལ་ལ་ཞིག་གིས།",
    "ཀཾ་ཤི་ཀ་དེ་བས་ཀྱདྲ་རགས་ཀྱིབུ་ལམ་རིགས་ཀྱི་བུ་མོགང་ཤེས་རབཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་གླེགས་བམ་དུ་བྱས་ཤིང་འཛིནཔ་དང་།",
    "ཨོཾ་ཤཀི་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་བྱུར་བུ་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་གྱིས་ཡོངས་སུ་བཀྭང་བ་ལྟ་ཞོག་གི།",
    "རིགས་ཀྱི་བུ་མོ་དེའི་བསོདནམས་མངངུ་འཕེལ་ལམ།",
    "ཀོ་ཤི་ཀྲ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ།",
    "ཀོ་ཤ་ཀ་འཇིག་རྟེན་གྱི་ཁམས་འབྲིང་པོ་སྟོང་གཉིས་པ་འདི་དེ་བཞིན་གཤེགས་པའི་མཆོ་ད་རྟེ་ན་གྱིས་ཡོངས་སུ་བཀད་བ་ལྟ་ཞོག་གི།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེའི་བ་སོང་ནམས་མང་དུ་འཕེལ་ལམ།",
    "ཀོ་ཤཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུ་འམ་རགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པར་བྱེད།",
    "ཀོཤ་ཀ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་དེ་བཞིན་གཤེགས་བའིམཆོད་རྟེན་ཀྱིས་ཡོངས་སུ་བཀང་བ་ལྟ་འོག་གི།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བྲིས་ཤིང་བཟུང་བ་དང་།",
    "ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེམ་སྙེད་ན།",
    "ལྷོ་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེམ་སྙོད་ན།",
    "ནུབ་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེམ་སྟེདན།",
    "བྱང་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་ཁྱིམ་སྟོད་ནེ།",
    "བྱང་ཤར་གྱི་ཕྱོགས་མཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་ག་ངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེདན།",
    "ཤར་ལྷོའི་ཕྱོགསམཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གཟཱའི་ཀླུང་གི་བྱེ་མ་སྙེདན།",
    "ལྷོནུབ་ཀྱིཕྱོགས་མཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེདན།",
    "དེའི་སླང་ངུ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོད་དག་གི་བསོདམས་མང་དུ་འཕེལ་བ་ལགས་སམ།",
    "རིགས་ཀྱི་བུ་མོགང་གིས་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བྲིས་ཤིང་།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "རིགས་ཀྱི་བུ་མོ་དེ་དག་གི།",
    "རིགས་ཀྱི་བུ་མོ་དེ་དག་གི་བསོང་ནམས་ནི་ཚང་མྱེད་གྲངས་མྱེད།",
    "རང་གི་མཚན་ཉིད་སྟོ་ངཔ་ཉིད་དོ།",
    "ཀོ་ཤི་ཀ་དེ་བས་ནོ་རགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གངལ་ལས་ཤས་རབཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བྲིས་ཏེ།",
    "སྟོང་གི་ཆ་དང་།",
    "བརྒྱ་ཕྲག་སྟོང་གི་ཆ་དང་བྱེ་བའི་ཆདང་།",
    "རངགི་མཚན་ཉིད་སྟོ་བ་ཉིད་འཇིག་རྟེན་དུ་འབྱུད་པར་འགྱུར་རོ།",
    "ཆུང་སྣང་གི་ལྷ་རྣམས་དང་།",
    "ཀོ་ཤིན་ཁྱོང་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཟུངས་ཤིག།",
    "དེའི་ཚེ་ཀོ་ཤི་ཀ་ཁྱོད་ཀྱིས་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཡིད་ཀྱིས་སེམས་པ་བ་ཏོན་གྱིས་ཤིག་སྐུལ་བཞིན་དུ་ཡོདལ་གྱིས་རྒྱག་དང་།",
    "ཤེས་རབ་ཀྱིཕ་རོལ་ཏུ་ཕྱིནཔ་ལ་མོས་པས།",
    "རིགས་ཀྱི་བུ་འམ་རགས་ཀྱི་བུ་མོ་གྲང་སུ་ཡང་རུང་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ནི་རིག་སྔགས་ཆེན་མོའོ།",
    "ཀོ་ཤི་ཀ་འདི་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ནི་རིག་སྔགས་ཆེན་མོའོ་། ཀོ་ཤ་ཀ་འདི་ལྟ་སྟེ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་འཇིག་རྟེནན་ཡོད་པ་ཡིན།",
    "རངགི་མཚནཉིདསྟོདཔཉིད་འཇིག་རྟེན་ན་གདགས་སུ་ཡོད་པ་ཡིན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལ་སྤྱོད་པ་དང་།",
    "ཀོ་ཤི་ཀ་གཞན་ཡངརིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདིའཛིན་བ་དང་།",
    "བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་གང་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "ཀོ་ཤི་ཀ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "སྔོན་གྱི་ལས་ཀྱིརྣམ་པར་སྨིན་བམ་གཏོགས་པར་དུག་གིས་དུས་བྱེད་པར་མྱི་འགྱུར་རོ།",
    "གལ་ཏེ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཁ་ཏོན་བྱེད་ཅིང་།",
    "དེ་ལ་གླགས་ཚོལ་བ་དེ་དག་གིས་གླགས་མི་རྙེད་དེ།",
    "གལ་ཏེ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དྲེ་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཁ་ཏོན་བྱེད་ཅིང་།",
    "རྒྱལ་པོའི་བློན་པོ་ཆེན་པོ་དག་ཀྱང་དགའ་བའ་ཚིག་གིས་གཏམ་དྲི་བ་དང་།",
    "ཀོ་ཤི་ཀ་རགས་ཀྱི་བུ་འམ་རིགསཀྱི་བུ་མོ་གངཤིས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་སུ་ཕྱི་སྐྱེ་གཤིན་རྗེའིའཇིག་རྟེན་དུ་མ་སྐྱེའོ།",
    "བར་ཆ་དབྱེད་པརམྱི་འགྱུར་བར་བདག་གིས་བཅོམ་ལྡན་འདས་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདིལསཇི་སྙེད་ཅིག་བཟུ་བ་དེདག་ཁ་ཏོན་ང་བྱའོསྙམནས།",
    "ཤར་དྭ་ཏིའིབུ་གཞན་ཡང་ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀྲུང་གི་བྱེ་མ་སྙེད་དག་ན།",
    "ལྷོ་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དགན།",
    "བྱང་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་ག་དྷུའི་ཀླུང་གི་བྱེམ་སྙེད་དགན།",
    "བྱང་ཤར་ཀྱི་ཕྱོགས་མཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གྲངྒཱའི་ཀྲུང་གི་བྱེ་མ་སྙེད་དག་ན།",
    "ཤར་ལྷོའི་ཕྱོགས་མཚམསཀྱི་འཇིགརྟེནགྱི་ཁམསགདྷཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དགན།",
    "ལྷོནུབ་ཀྱི་ཕྱོགས་མཚམསཀྱི་འཇིག་རྟེནགྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེང་དགན།",
    "ནུབ་བྱང་གི་ཕྱོགསམཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀྲུང་གི་བྱེ་མ་སྙེད་དག་ན།",
    "འོགགིཕྱོགས་ཀྱིའཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱི་མ་སྙེད་དགན།",
    "སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེམ་སྟེད་དྭག་ན།",
    "དེ་ལ་བདག་གིས་བཅོམ་ལྡན་འདས་ག་ལ་བདེར་དོང་སྟེ།",
    "བཅོམ་ལྡནྲ་འདས་གངརྡ་བ་དེ་ར་འགྲོ་བར་འདོད་ལ་བདུད་སྡིག་ཏོ་ཅན་གྱི་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་རྣམ་པར་བཀོད་པ་འདི་ནི་རྒྱལ་པོ་བམ་བ་སརའི་དཔུང་གི་ཚོགས་ཡན་ལག་བཞིཔ་རྣམ་པར་བཀོད་པས་ཀྱང་དེ་ཙམ་མྱི་ཕོད།",
    "ལིད་ཙ་བྱི་རྣམས་ཀྱི་དཔུང་གི་ཚོགས་ཡན་ལག་བཞིབ་རྣམ་བར་བཀོདཔས་ཀྱང་དེཙམ་མྱི་ཕོད་དེ།",
    "བདཀ་གིས་ཤེས་རབ་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཡང་དྭག་པར་བསམ་པར་བྱའོ།",
    "འོག་མྱིན་གྱི་ལྷའི་བར་དུ་ད་པ་དེ་དག་གིས་ལྷ་རྫས་ཀྱིམེ་ཏོག་དང་།",
    "འཛམ་བུའི་གླིང་གི་མྱིརྣམས་ཇི་སྲིད་དུ་ཤེས་ཏེ་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ལ་སྤྱོད་པ་དེ་སྲིད་དུ་སྟོང་གསུམ་གྱིསྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་དང་།",
    "རིགས་ཀྱི་བུམོདདག་གིས་ཤེས་རབཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའདི་བྲིས་ཤིངགླེགསབམདུ་བྱས་ཏེ།",
    "ལྷའི་བུདེ་དག་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "ཕྱོགས་གང་ན་རགིས་ཀྱི་བུ་འམ་རིགས་ཀྱིབུ་མོ་དེ་དག་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བྲིསཤིང་གླེགས་བམ་དུ་བྱས་ཏེ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་ཀྱང་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོད་ལ་རྟག་རྒྱན་གྱི་ཆད་པརབསྡུ་དགུ་དང་།",
    "རིགས་ཀྱིབུ་འམ་རིགས་ཀྱིབུ་མོག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནངཔ་འདིའཛིན་ཅིང་འཆང་བ་དང་།",
    "བཅོམ་འདས་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་གང་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་ཅིང་འཆང་བ་དང་།",
    "བཅོམ་ལྡན་འདསརིགས་ཀྱི་བུ་འམརིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ནི་བ་འདི་འཛིན་ཅིང་འཆང་བ་དང་།",
    "རེག་གཉིས་སུ་མྱེདཔའི་ཚུལ་དང་།",
    "མྱིག་གིརྣམ་པར་ཤེས་པ་གཉིས་སུ་མེད་པའི་དང་།",
    "མིག་གི་འདུས་ཏེ་རིག་བ་གཉིས་སུ་མེདཔའི་ཚུལ་དང་།",
    "ལྕེའི་དུས་ཏེ་རེག་པ་གཉིས་སུ་མེད་པའི་ཚུལ་དང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་གཉིས་སུ་མེད་པའི་ཚུལ་དང་།",
    "ཡིད་ཀྱི་འདུས་ཏེརེག་པ་གཉིས་སུ་མེད་པའི་ཚུལ་དང་།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བགཉིས་སུམྱེད་པའི་ཚུལ་དྲང་།",
    "སྣའི་འདུས་ཏེ་རེག་བའི་རྐྱེན་ཀྱིས་ཚོརབ་གཉིསསུམྱེདཔའི་ཚུལ་དང་།",
    "ལྕེའི་འདུས་ཏེརེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་གཉིས་སུམྱེད་པའི་ཚུལ་དང་།",
    "ལུས་ཀྱི་འཇུས་ཏེ་རེག་། པའི་རྐྱེན་གྱིས་ཚོར་བ་གཉིས་སུ་མྱེད་པའི་ཚུལ་དང་།",
    "རེག་པ་གཉིས་སུ་མྱེད་པའི་ཚུལ་དང་།",
    "ཇི་ལྟརརེག་གཉིས་སུ་མམཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟར་མྱིག་གི་འདུས་ཏེརེག་བགཉིས་སུ་མ་མཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟར་སྣའི་འདུས་ཏེ་རེག་པ་གཉིས་སུ་མམཆིས་པའིཚུལ་དང་།",
    "ཇི་ལྟར་ལྕེའི་འདུས་ཏེ་རེག་བ་གཉིས་སུ་མ་མཆིས་པའིཚུལ་དང་།",
    "ཇི་ལྟར་ལུས་ཀྱི་འདུས་ཏེ་རེག་བ་གཉིས་སུ་མ་མཆིས་ཆེ་པའི་ཚུལ་ངང་།",
    "ཇི་ལྟར་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པགཉིས་སུ་མ་མཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟར་མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚེར་བགཉིས་སུ་མ་མཆིས་པའི་ཚུལདང་།",
    "ཇི་ལྟར་རྣ་བའི་འངུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་གཉིས་སུམ་མཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟར་སྣའིའདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་གཉིས་སུ་མ་མཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟརལྕེའིའདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་གཉས་སུ་མ་མཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟར་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་གཉིས་སུམ་མཆིས་པའིཚུལ་དང་།",
    "ཇི་ལྟར་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་གཉིས་སུམ་མཆིས་པའི་ཚུལ་དང་།",
    "ཇི་ལྟར་རེག་བ་གཉིས་སུ་མམཆིས་བའི་ཚུལ་དང་།",
    "ཇི་ལྟར་རང་གི་མཚན་ཉིད་སྟོང་བ་ཉིད་གཉིས་སུམམཆིས་པའི་ཚུལ་དང་།",
    "དེ་ནིའདྲིལྟརམྱིག་གི་འདུས་ཏེ་རེག་པ་དང་ཕ་རོལ་ཏུ་ཕྱིནཔའདི་དག་གཉིས་སུ་ྲ་མེད་དེ་གཉིས་སུ་བྱར་མྱེད་དོ།",
    "ནིའདི་ལྟར་རྣབ་འི་འདུས་རེག་པ་དང་ཕརོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིསས་མེད་དེ་གཉིས་སུ་བྱར་མྱེད་དོ།",
    "སྣའི་འདུས་ཏེརེག་བནི་སྣའི་འདུས་ཏེ་རེག་པས་སྟོང་སྟེ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ནི་ལྕེའི་འཇུས་ཏེ་རེག་པས་སྟོངསྟེ།",
    "ད་ཅིའི་ཕྱིར་ཞེཤྰན་དེ་ནི་འདི་ལྟར་ལྕེའི་འདུས་ཏེ་རེག་པ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིས་ཕྱེད་དོ་གཉིས་སུ་བྱར་མྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་ཤབ་ནི་ལུས་ཀྱིའདུས་ཏེ་རེག་པས་སྟོང་སྟེ།",
    "ད་ནི་འདི་ལྟར་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དང་ཕ་རོལ་ཏུཕྱན་པ་འདི་དག་གཉིས་སུ་སྐྱིད་དེ་གཉིས་སུ་བྱར་མེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེརེག་པན་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པས་སྟོང་སྟེ།",
    "དེ་ནིའདི་ལྟརས་ཏེ་རེག་པ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིས་སུ་མྱེད་ད་གཉིས་སུ་བྱར་མེད་དོད།",
    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་མྱིག་གི་འདུས་ཏེ་རིག་པའི་རྐྱེན་ཀྱིས་ཚོར་བས་སྟོང་སྟེ།",
    "དེ་ནི་འདི་ལྟར་མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་རྣབའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོརབས་སྟོང་སྟེ།",
    "དེ་ནི་འདི་ལྟར་རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིས་སུ་མྱོང་།",
    "དེན་འདྲི་ལྟར་སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེནགྱིས་ཚོར་བདང་ཕ་རོལ་ཏུ་ཕྱིན་པ་གགཉིས་སུམྱེདདེ་གཉིས་སུ་བྱར་མྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་ས་ཏེ་རིག་པའི་རྐྱེནཀྱིས་ཚོར་བས་སྟོང་སྟེ།",
    "དེནི་འདི་ལྟར་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚེར་བདངཕ་རོལ་དུ་ཕྱིན་པ་འདིདག་གཉིས་སུ་མྱེད་དགཉིས་སུ་བྱར་མེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་བའི་ཀྱོ་མཚོར་བཞི་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཆོར་བས་སྟོང་སྟེ།",
    "དེ་ནི་འདི་ལྟར་རེག་པ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིས་སུ་མྱོད་དེག་ཉིས་སུ་བྱར་སྐྱེད་དོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའིའབྲས་བུདང་ཕརོལ་ཏུ་ཕྱིན་པ་འདི་དག་གཉིས་སུ་མྱེད་དེ་གཉིས་སུ་བྱར་མེང་དོ་། ལན་ཅིག་ཕྱིར་འོངབའིའབྲས་བུ་ནི་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུས་སྟོང་སྟེ།",
    "དེནི་འདི་ལྟར་ཕྱིར་མི་འོང་བའི་འབྲས་བུདང་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་དགགཉིས་སུ་མྱད་དེ་གཉིས་སུ་བྱར་སྐྱེད་དོ།",
    "ཕརོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་འདི་དག་གི་ཐོག་མར་འགྲོ་བན།",
    "རང་གིམཚན་ཉིད་སྟོང་བ་ཉིད་རྣམ་པར་འཕེལ་ལོ།",
    "རགས་ཀྱི་བུམོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "ཤེས་རབ་ཀྱཔ་རོལ་ཏུ་ཕྱིནཔ་འདིའི་ཡོན་ཏན་གང་ཇི་སྙེད་ཅག་བདག་གིས་བཅོམ་ལྡན་འདས་ལསབཟུང་སྟེ།",
    "ཆུང་ཚོའི་ལྷ་རྣམས་འཇིག་རྟེན་ན་མཆིས་སོ།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཤས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱན་པ་འདི་འཛིན་པ་དག།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདིའཛིན་པ་དང་།",
    "རིགས་ཀྱི་ཁྱུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཕྱིན་པ་འདིའཛིན་པ་དང་།",
    "ཀོ་ཤ་ཀ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོག་ང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པདང་།",
    "བརྒྱ་ཕྲག་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའོ།",
    "བྱེ་བ་བརྒྱ་ཕྲག་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མྱ་འགྲོའོ།",
    "དེ་ན་འདི་ལྟར་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་ད་དག་ཉན་ཐོས་དང་རརས་པས་རྒྱས་ཀྱིས་ལས།",
    "བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛན་བ་དང་།",
    "ཀོ་ཤི་ཀྲ་རགས་ཀྱི་བུ་འམ་རགིས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་འདི་ཁ་ཏོན་དུ་བྱེད་པའི་ཚེ།",
    "ཀོ་ཤཾ་ཀརིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱན་བ་འདི་འཛིན་པ་དང་།",
    "ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པོ་དང་།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེ་ཡང་།",
    "ཀོ་པ་གཞན་ཡངརིགས་ཀྱི་བུ་འམ་རོགས་བུམོ་ཤེས་རབ་ཀྱི་འརོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་ཅིང་འཆང་བ་དང་།",
    "དེ་ནི་འདི་ལྟར་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དདག་གིས་གང་ཞུམ་བར་འགྱུར་བ་འམ།",
    "ཀོ་ཤི་ཀརིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོག་ངཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "ཀོ་ཤི་ཀ་གཞན་ཡང་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོགངལ་ལ་ཤེས་རབ་ཀྱིཕ་རོལ་ཏུ་ཕྱིན་པ་འདིའཛིན་བ་དང་།",
    "བྲམ་ཟེ་དག་གིས་དགོས་ཁར་བྱ་བ་ཡིན།",
    "རྒྱུན་དུ་ཞུགས་བ་གང་ཇི་སྙེད་ཡོདཔ་དེ་དགེ་གིས་ཀྱང་དགོས་ཤིང་ཡིད་དུ་འོང་བར་བྱ་བ་ཡིན།",
    "ཀོ་ཀི་ཀ་རིགས་ཀྱི་བུ་འམ་རིགེ་ས་ཀྱི་བུ་མོ་གྲང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་འཛིན་པ་དང་།",
    "ཀོ་ཤ་ཀ་དེ་ལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་དེ་དག་གིས་ཀྱང་སེམས་འདི་ལྟར་བསྐྱེད་པར་བྱ་སྟེ།",
    "ཀོ་ཤི་ཀ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོ་འི་འཇིག་རྟེན་གྱི་ཁམས་འདིའི་རྒྱལ་ཆེན་བཞི་རི་རིས་ཀྱི་ལྷ་རྣམས་དང་།",
    "ཀོ་ཊིཀ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེས་ཚེ་འདིའི་ཡོན་ཏན་དེ་ལྟ་བུ་དག་ཀྱང་ཡོངས་སུ་ཟན་པརའགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་དདག་ལ་བསྲུང་བ་དང་།",
    "བཅོམ་ལྡན་འདས་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེམ་འདིར་ཕྱོགས་བཅུ་ཀུན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་ནས་ཤས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནཔ་འདི་རླག་པ་དང་།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེས་འདིར་ནཾ་ལྷ་མཐུ་བོ་ཆེ་མཐུཆེན་བོ་རྫུ་འཕྲུལ་ཆེ་བ།",
    "ཀོཤི་ཀ་གཞན་ཡང་གལ་ཏེ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཙང་སྦྲའི་སྤྱོད་པ་དང་ལྡནན།",
    "དེ་དགུ་ཉེ་བར་ལོང་བར་སེམས་པ་དེ་ལྟ་དེ་ལྟར་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེ་ཡང་མོས་པ་རྒྱཆེ་ན་བོདང་ལྡན་པར་འགྱུར་རོ།",
    "དེའི་འཁོར་ཀྱིས་ཡང་སྤོས་ཆུའི་ཆག་ཆག་གིས་གདབ་བོ།",
    "ཀྲོ་ཤཾ་ཀ་རིགེས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་ལ་ངལ་ཞིང་ཆད་པར་འགྱུར་བམྱེད་དེ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོད་ནི་སེམས་བདེབ་དང་།",
    "དྲན་བ་ཉེ་བར་གཞག་པ་བཞི་པོ་དེ་དག་གི་དོན་རྣམ་བར་ཕྱེ་བ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་པོ་དེ་དག་གི་དོན་རྣམ་པར་ཕྱོ་བ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "རྫུའ་ཕྲུལ་གྱི་རྐང་པ་བཞ་པ་དེ་དག་གི་དོན་རྣམ་པར་ཕྱེ་བ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "སྟོ་བས་ལྔ་པོདེ་དག་གི་དོན་རྣམ་པར་ཕྱེ་བ་ཡངཐོས་པར་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པོ་དེ་དག་གི་དོན་རྣམ་པར་ཕྱེ་བ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "མཐརཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་པོ་ད་དག་གི་དོན་ནམ་པར་ཁྱབ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "གཟུངས་ཀྱི་སྒོ་དེ་དག་གི་དོན་རྣམ་པར་ཕྱེབ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "མྱི་འཇིགས་པ་བཞི་བོ་དེ་དག་གི་དོན་རྣམ་པར་ཕྱེ་བ་ཡང་ཐོས་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཆེ་གེམོ་ཞིགནན།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཆེ་གེ་མོ་ཞིག་ན་ནི།",
    "དེབཞན་གཤགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིས་ངཔས་རྒྱས་ཆེ་གེ་མོ་ཞིག་བཞུགས་ཏེ།",
    "ཉེན་ཐོས་བྱེབ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་འདི་སྙེད་ཅིག་གིས་བསྐོར་ཅིང་མདུན་དུ་བྱས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཆེ་གེ་མོ་ཞིག་ན་ནི།",
    "དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིས་ངས་རྒྱས་ཆེ་གེ་མོ་ཞིག་བཞུགས་ཏེ།",
    "ཉན་ཐོས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་འདི་སྙེད་ཅིག་གིས་བསྐོར་ཅིང་མདུན་དུ་བྱས་ཏེ།",
    "ཉན་ཐོས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་འདི་སྙེད་ཅིག་གིས་བསྐོར་ཅིང་མདུན་དུ་བྱས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཆེ་གེ་མོ་ཞིགནན།",
    "ཉན་ཐོས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་འདི་སྙེད་ཅིག་གིས་བསྐོར་ཅིང་མདུན་དུ་བྱས་ཏེ།",
    "ནུབ་བྱང་གི་ཕྱོགས་མཚམས་ཀྱི་ས་ངས་རྒྱས་བྱེ་བ་ཁྲག་ཁྲག་བརྒྱ་སྟོང་མང་པོ་འསྒྲ་ཐོས་པར་འགྱུར་ཏེ།",
    "ཉན་ཐོས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་འདི་སྙེད་ཅིག་གིས་བསྐོར་ཅིང་མདུན་དུ་བྱས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམསཆེ་གེ་མོ་ཞག་ནན།",
    "དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱུས་ཆེ་གེ་མོ་ཞིག་བཞུགས་ཏེ།",
    "འཇིགརྟེན་གྱི་ཁམས་ཆེགེ་མོ་ཞིགནནི།",
    "དེ་བཤནགཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིས་ཨ་རྒྱསཆེ་གེ་མོ་ཞིག་བཞུགས་ཏེ།",
    "ཉན་ཐོས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་འདི་སྙེད་ཅིག་གིས་བསྐོར་ཅིང་མདུན་དུ་བྱས་ཏེ།",
    "དེ་བཞིན་གཤེགས་བ་དེ་དག་གི་མཆོད་རྟེན་རིན་པོཆེ་བདུན་ལས་བྱས་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་མང་པོ་དག་ཀྱང་མཐོང་བར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་གིམཆོ་དརྟེན་ནི་པོ་ཆེ་བདུན་ལས་བྱས་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་མང་པོ་དག་ཀྱང་མཐོང་བར་འགྱུརརོ།",
    "ཀོ་ཤི་ཀ་དེ་ལྟར་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེདག་གིས་རྨི་ལམ་བཟང་པོ་དེ་ལྟ་བུ་དག་མཐོང་བར་འགྱུར་ཏེ།",
    "ནུབ་བྱ་དགི་ཕྱོགས་མཚམས་ཀྱིས་ངས་རྒྱས་བཅོམ་ལྡན་འདས་གང་ཇི་སྙེདཔ་དང་།",
    "ཀོ་ཤི་ཀ་རིགས་ཀྱི་བུ་འམ་རིགས་བུམོཚ་འདིཉིདི་ལ་ཡོན་ཏན་འདི་དག་ཡོངས་སུ་བཟུང་བར་འདོད་པས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེདག་གིས་ཤེས་རབ་ཀྱི་ཕྱིན་པ་འདི་བྲིས་ཤིང་གླེགས་བམ་དུ་བྱས་ཏེ།",
    "ཀོ་ཤི་ཀ་དེ་ལྟར་ན་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་ད་དག་འགྲོ་བམ་ང་པོ་ལ་ཕན་བ་དང་།",
    "འགྲོ་བམང་པོ་ལ་བདེ་བའི་དོན་དུ་ཞུགས་པ་ཡིན་ཀོ་ཤ་ཀ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གྲང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་གཟུང་བ་དང་།",
    "ཀོ་ཤི་ཀ་ཁྱོད་ཀྱིས་འཛམ་བུའི་གླིངད།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་བདག་འཛམ་བུའི་གླིང་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་གིས་བྱུར་བུར་བལྟམ་བ་ཞིག་ཀྱང་ལ་ལས་སྩལ་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལདུ་ཕྱིན་པ་འདི་ཉིད་བདག་གིས་བླང་བར་བགྱིའོ།",
    "ཀུནནས་ཉོན་མོངས་པའི་ཕྱིད་མ་ཡིན།",
    "ཀོ་ཤི་ཀརེ་ནི་འདི་ལྟར་བརྩོན་འགྲུས་ཀྱི་འརོལ་ཏུ་ཕྱིན་པ་དང་།",
    "བདག་གིས་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་འདི་བླངས་ཏེ།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་དང་།",
    "རིགས་ཀྱི་བུ་འམ་རགས་ཀྱི་བུ་མོ་དག་གིས་དེདག་ལ་རིམ་གྲོར་བགྱིས།",
    "ངན་སོང་དུ་མཆི་བར་མྱ་འགྱུར་ཏེ།",
    "རིགས་ཀྱི་བུ་མོ་ལ་ལས་ཞེས་རབ་ཀྱིཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་བཟུབ་ཞིང་ཀུན་ཆུབ་པར་བགྱིས་ཏེ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་ལ་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདིག་ཟུ་བཞིང་།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་དང་།",
    "འདི་ལྟར་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ།",
    "བཅོམ་ལྡན་འདས་གཞན་ཡང་རགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་། ཕྱིན་པ་འདི་བྲིས་ཤིང་འཛིན་པ་དང་།",
    "དེ་དག་གིས་འཇིགས་པར་མི་འགྱུར་རོ།",
    "བདག་གིས་ཆ་དེ་ཀཉིས་ལས་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་བླང་བར་བགྱིའོ།",
    "ནུབམོ་ནི་སྣང་བར་བགྱིད་དོ།",
    "བུད་བྱེད་ལལ་ཞིག་སྦྲུལ་གདུག་པས་ཟིན་པ་ལ།",
    "བུད་མེད་ལ་ལ་ཞིག་འབྲུམ་བུས་བཏབ་བམ།",
    "དེ་དག་གི་འབྲུམ་བུའམ།",
    "ཤེལ་གྱི་ཁ་དོག་གི་གོས་ཀྱིས་དཀྲིས་ཏེ།",
    "ཡོན་ཏན་གྱི་རྣམ་པ་དེ་ལྟ་བུདྲུག་དང་གཞན་ཡང་རྣམ་པམང་པོ་དག་དང་ལྡན་ནོ།",
    "འཛམ་བུའི་གླིང་གི་མི་རྣམས་ལ།",
    "གཞན་ཡར་སྣོད་དེ་ལ་མོས་པ་བསྐྱེད་དོ།",
    "ནམ་ཆིས་པ་དེའི་རིགས་ཀྱ་བུ་འམརིགས་ཀྱི་བུ་མོ་དེ་དག་གི་ལུས་སམ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་དེ་དག་ཀྱང་རང་གིམཚན་དེ་ཀྱི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་པགཆགས་ཀྱི་མཚམས་སྦྱོར་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བག་ཆགས་ཀྱིམཚམས་སྦྱོར་བའི་ཉོན་མོངས་པ་ཐམསཅད་སྤངས་པའི་ཡོན་ཏནནིཚདམ།",
    "བག་ཆགས་ཀྱི་མཚམས་སྦྱོར་བའི་ཉོན་མོངས་པ་ཐམསཅད་སྤངས་པའི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་དྲི་བཞིན་གཤུགས་པའི་སྐུ་གདུངད་དགནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཀུན་ནས་ཉོན་མོངས་པ་མ་མཆིས་པ་དང་།",
    "གཞན་ཡང་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་དེ་བཞནིགཤེགས་པའི་སྐུ་གདུངགིས་བྱུར་བུར་ཡོངས་སུབལྟམ་པ་ལྟ་ཞོག་གི།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེམ་སྟེ་དཅིག་དེབཞིན་གཤེགས་པའི་སྐུ་གདུང་གིས་བྱུར་བུར་བལྟམ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རེ་སླད་ངུ་འན།",
    "བཅོམ་ལྡན་འདས་རིགིས་ཀྱི་བུའམ།",
    "རིགས་ཀྱི་བུ་མོ་གངདེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་རྣམས་ལ་རིམ་གྲོར་བགྱིད་པ་དང་།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་རྣམས་ཀྱིས།",
    "དེ་བས་ན་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིནེ་པ་ལ་སྤྱོད་བདེས།",
    "རང་གིམཚན་ཉིད་སྟོང་བ་ཉིད་ཀྱི་ཡེ་ཤེས་དང་།",
    "ཀུན་ནས་ཉོནམོངས་པ་མ་མཆིས་བ་དང་།",
    "རང་སངས་རྒྱུས་གངཇི་སྙེད་ཅིག་འཁོད་ཅིང་འཚོ་སྐྱོང་བདེ་དག་གིས་ཀྱང་།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་ཚུལ་དང་།",
    "བཅོམ་ལྡན་འདས་ཤེས་རེབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཆེན་པོ་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པར་དམིགས་པ་མ་མཆིས་སོ།",
    "རྣབའི་འདུས་ཏེ་རེག་པར་དམྱགས་པམ་མཆིས་སོ།",
    "སྣའི་འདུས་ཏེརེག་པརདམྱགས་བམ་མཆིས་སོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་བར་དམྱིགས་པ་མམཆིས་སོ།",
    "ཡིང་ཀྱི་འདུས་ཏེརེག་བར་དམྱགས་པ་མ་མཆིས་སོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་བ་ལས་བྱུང་བའི་ཚོར་བར་དམྱགས་བམམཆིསསོ།",
    "ནབའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བར་དམིགས་བྱམམཆིས་སོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བར་དམྱགས་པམ་མཆིས་སོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བར་དམྱགས་པ་མ་མཆིས་། ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བར་དམྱྀགས་པ་མ་མཆིས་སོ།",
    "རེག་མྱི་དམིགས་པའི་ཚུལ་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་མྱིང་མིགས་པའི་ཚུལ་དང་།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་མྱ་དམྱགས་པའི་ཚུལ་དང་།",
    "སྣའི་འདུས་ཏེ་རེག་པ་མྱི་དམྱགས་པའི་ཚུལ་དང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་མྱྀ་དམིགས་པའི་ཚུལ་དང་།",
    "ཕྱག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མྱ་དམྱགས་པའི་ཚུལ་དང་།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བམྱ་དམིགས་པའིཚུལ་དང་།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བམྱ་དམྱགས་པའི་ཚུལ་དང་།",
    "ལྕེའིའདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བམྱ་དམྱྀགས་པའི་ཚུལདང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མྱ་དམྱགས་པའི་ཚུལ་དང་།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མྱ་དམིགས་པའི་ཚུལ་དང་།",
    "རེག་པ་མྱི་དམྱགས་པའི་ཚུལ་དང་།",
    "རིགས་ཀྱི་བུ་མོལ་ལ་ཞིག་གིས།",
    "རིག་ས་ཀྱི་བུམོ་ལ་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་གླེགས་བམ་དུ་བགྱིས་ཏེ།",
    "ཀོ་ཤི་ཀ་ངེ་བས་ན་ཁྱོད་ཉིད་ལ་དྲིས།",
    "ཁྱོད་ཀྱིས་ཇི་ལྟར་བཟོད་པ་དེ་ལྟར་ལུང་སྟོན་ཅིག།",
    "རགས་ཀྱ་བུ་འམརིགས་ཀྱི་བུ་མོ་ལལས།",
