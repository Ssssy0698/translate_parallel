    "ཞེས་བྱ་བ་ཡན་ཆད་ཀྱིས་བསླབ་པ་ཕྲ་མོ་རྣམས་བསྟན་ཏོ།",
    "ཇི་ལྟར་ཉོན་མོངས་མྱུར་ཟད་ནས།",
    "རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་བརྙེས་པའི་སྒོ་ནས་བསྟོད་དེ།",
    "ཐམས་ཅད་མཁྱེན་ཞེས་བྱ་བས་བདག་གི་དོན་ཕུན་སུམ་ཚོགས་པ་བརྙེས་པ་བསྟན་ཏེ།",
    "དཔྲལ་བ་གཏུགས་པ་ཐལ་མོ་སྦྱར་བ་ལ་སོགས་པ་བྱེད་པའོ།",
    "བསླབ་པ་ཉམས་སུ་བླང་བ་ཡང་ཚིག་རྣམ་པ་བཞི་ཞིག་གིས་སྟོན་ཏེ།",
    "དེ་ཚུལ་དེ་ལས་ཉོན་མོངས་པ་སྤོང་བ་དང་མཐུན་པའི་ཚུལ་ཡིན་པས་ཁྱིམ་ན་གནས་པའི་ཚུལ་ལས་འཕགས་པ་ཡིན་ནོ།",
    "བུད་མེད་དང་ཉེ་དུ་ལ་སོགས་པའི་འཇིགས་པ་མི་བཟད་པའི་གནས་སྤངས་ནས་ཁྱིམ་མེད་པར་ཤིང་དྲུང་དང་བྲག་ཕུག་ན་གནས་པས་ན།",
    "བདག་གི་ལུས་བཞིན་བསླབ་པ་བསྲུང་།",
    "དཔེར་ན་བདག་གི་ལུས་འདི་ལ་དུག་དང་ཚེར་མ་དང་ངམ་གྲོག་ལ་སོགས་པས་འཆི་བར་མི་འགྱུར་བར་བསྲུང་བ་དང་།",
    "ངག་གིས་གུས་པར་ཕྱག་བྱ་བ་དང་།",
    "མི་དྲག་མི་ངལ་བའི་དབྱངས་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ལ་བསྟོད་པ་ནི་ངག་གིས་གུས་པར་ཕྱག་བྱ་བའོ།",
    "དེ་ལྟ་བུའི་སེམས་སྔར་བསྐྱེད་ལ་དེ་ནས་གདོད་ལུས་ངག་གིས་ཕྱག་བྱ་བས་ཕྱག་བྱའོ།",
    "ཐུག་ཐུབ་ཏུ་མི་བྱ་བར་ཚུལ་འདི་ལྟར་བྱ་བ་ནི་དགེ་སྦྱོང་གི་ཚུལ་ཞི་བ་དང་དུལ་བའི་རང་བཞིན་ཡིན་པའི་ཚུལ་བསྟན་པར་བྱ་བ་དང་།",
    "སོགས་པའི་སྒྲས་ནི་མཚན་མོ་བདེ་བར་མནལ་ལམ་མ་མནལ།",
    "ཁྱོར་བའམ་འདབ་མས་བུམ་པ་དགང་།",
    "ཁྱོར་བའམ་འདབ་མས་བུམ་པ་དགང་།",
    "ཉ་ཕྱིས་དང་དུང་ཕོར་མ་འབྱོར་ན་ཡང་ཁྱོར་བ་བཀང་སྟེ་བརྟག་གོ།",
    "མིག་ལིང་ཏོག་གིས་ཁེབས་པས་ནི་མི་བརྟག་གི་མིག་གསལ་བས་ཆུ་ན་གནས་པའི་སྲོག་ཆགས་ཕྲ་མོ་དང་སྦོམ་པོ་རྣམས་ཡོད་དམ་མེད་བརྟག་གོ།",
    "དེ་ལ་ཆུ་གྲང་མོ་ལ་གནས་པའི་སྲོག་ཆགས་རྣམས་ཆུ་དྲོན་མོ་ལ་བསྐྱལ་ན་གནོད་པར་འགྱུར་བས་ཆུ་གྲང་མོ་ཉིད་དུ་བསྐྱལ་ལོ།",
    "ཆུ་དྲོན་མོ་ལ་གནས་པའི་སྲོག་ཆགས་རྣམས་ཆུ་གྲང་མོ་ལ་བསྐྱལ་ན་གནོད་པར་འགྱུར་བས་ཆུ་དྲོན་མོ་ཉིད་དུ་བསྐྱལ་ལོ།",
    "སྲོག་ཆགས་རྣམས་རང་རང་གི་གནས་མ་ཡིན་པར་བསྐྱལ་ཏེ།",
    "ཆུ་རྣམ་པ་ལྔ་ནི་བདག་གིས་མ་བཙགས་མ་བརྟགས་ཀྱང་སྤྱད་དུ་རུང་བའི་ཆུ་སྟེ།",
    "ཁྲོན་པ་ལ་སོགས་པའི་ཆུ་ནི་ཁྲོན་པ་དང་ལྟེང་ཀ་དང་རྫིང་ལ་སོགས་པར་ཉ་ཕྱིས་གང་གི་ཆུ་བླངས་ཏེ།",
    "སྲོག་ཆགས་ཡོད་དམ་མེད་བརྟགས་ཏེ་མེད་ན་ཉིན་ཞག་གཅིག་གི་བར་དུ་སྤྱད་དུ་རུང་ངོ།",
    "ཆུ་བཙགས་པའི་བསླབ་ཚིག་ནི་དགེ་སློང་མོས་པ་ཅན་གྱི་སྲོག་ཆགས་དང་བཅས་པའི་ཆུས་ཆག་ཆག་དང་དཀྱིལ་འཁོར་ལ་སོགས་བྱས་པ་ལས་བཅས་སོ།",
    "དེའི་ཕྱིས་དགེ་སྦྱོང་གིས་ཆུ་ཚགས་ལྔ་ལས་གང་ཡང་རུང་བ་ཅིག་མེད་པར་གནས་སུ་མི་རུང་ངོ།",
    "མ་བུད་པའི་ཤིང་དང་།",
    "དགེ་སྦྱོང་གིས་སྤྱད་པར་བྱ་བའི་རྫས་གང་ཅི་ཡང་རུང་སྟེ་ཀུན་ལ་སྲོག་ཆགས་ཡོད་དམ་མེད་བརྟགས་ནས་སྲོག་ཆགས་ཡོད་ན་བཙགས་ལ་སྲོག་ཆགས་རྣམས་ཀྱང་རང་རང་གི་གནས་སུ་བདེ་བར་བསྐྱལ་ཏེ།",
    "དེ་བཞིན་གུས་པར་ཐལ་སྦྱར་ནས།",
    "དུས་ནི་སྐྱ་རེངས་ཤར་བ་ནས་བརྩམས་ཏེ།",
    "འཛམ་བུའི་གླིང་གི་ཉི་མ་དྲོས་མན་ཆད་དེ།",
    "དེ་བཞིན་གུས་པས་ཐལ་སྦྱར་ནས།",
    "ངག་གིས་མ་གུས་པ་རྟ་གད་བྱེད་པ་ལ་སོགས་པ་བཏང་ལ།",
    "ཐལ་མོ་སྦྱར་ལ་འཚལ་མ་འཚལ།",
    "ཞེས་བྱ་བ་ནི་ཟས་ཟ་བའི་ཚེ་གད་མོ་མི་བགད་དོ།",
    "བཅའ་བ་ནི་སྤྱན་གཟིགས་ལ་བྱའོ།",
    "སྦྱིན་པའི་འབྲས་བུ་ལྷ་དང་མིའི་ལུས་ཐོབ་པའི་ལོངས་སྤྱོད་ཆེན་པོ་ཐོབ་པར་བྱ་བའི་ཕྱིར་སྦྱིན་པའི་ཡོན་བདག་གི་དོན་དུ་ཚིགས་སུ་བཅད་པ་གཅིག་བཀླགས་པ་དང་།",
    "དེ་ལ་འདོད་ཆགས་ལ་སྤྱོད་པའི་གང་ཟག་གིས་ནི་མི་གཙང་བ་བསྒོམ་མོ།",
    "རྣམ་པར་རྟོག་པ་ལ་སྤྱོད་པའི་གང་ཟག་གིས་ནི་དབུགས་ཕྱི་ནང་དུ་རྒྱུ་བ་བསྒོམ་མོ།",
    "ཆོ་གའི་སྒྲ་ནི་སྦོམ་པོ་དང་ཉེས་བྱས་ལ་སོགས་པ་བསླབ་ཚིག་ཕྲ་མོ་དང་དགེ་སྦྱོང་གི་བྱ་བ་རྣམས་ལ་བྱ་སྟེ།",
    "འདི་དག་ནི་བདག་གི་ལས་སུ་བྱ་བ་ཡིན།",
    "འདི་དག་ནི་བདག་གི་ལུས་སུ་བྱ་བ་མ་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱའོ།",
    "ཉོན་མོངས་པའི་གནས་སུ་གྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་གདུལ།",
    "ངག་གི་སྡོམ་པ་ལེགས་པ་ཡིན།",
