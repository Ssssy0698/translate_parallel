    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་འདུས་བྱས་སྟོང་པ་ཉིད་མི་དམིགས།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་དམིགས།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་། ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་མི་དམིགས་ན་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་ཡང་དག་པར་སྤོང་བ་། རྣམས་མི་དམིགས།",
    "ཡང་དག་པར་སྤོང་བའི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "ཡང་དག་པར་སྤོང་བ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "སྟོབས་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "བསམ་གཏན་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མི་དམིགས།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པའི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་མཐར་གྱིས་། གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མི་དམིགས།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པའི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "སྨོན་པ་མེད་པའི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་ཉིད་ཀྱང་མི་དམིགས་ན་དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "མི་འཇིགས་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་མི་དམིགས།",
    "སོ་སོ་ཡང་དག་པར་རིག་པའི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུའི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུའི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུའི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "དེ་ལ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མི་དམིགས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མི་དམིགས་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་མི་དམིགས་ན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "ཚོར་བའི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "འདུ་ཤེས་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
    "འདུ་བྱེད་ཀྱི་དེ་བཞིན་ཉིད་ལྟ་དམིགས་པར་ག་ལ་འགྱུར།",
