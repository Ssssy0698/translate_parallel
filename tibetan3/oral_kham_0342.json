    "འཕགས་རྒྱུད་ཀྱི་བདེན་པའི་གནས་ལུགས་མངོན་སུམ་དུ་རྟོགས་པའི་ཡེ་ཤེས་དེས་རང་ཡུལ་གྱི་དམིགས་རྣམ་མི་བརྗེད་པར་དྲན་འདུག་པའི་ཆའི་སེམས་བྱུང་དེ།",
    "འཕགས་རྒྱུད་ཀྱི་ཞི་གནས་དང་དམིགས་པ་ལ་སེམས་རབ་ཏུ་འཛིན་པ་དང་བྱིང་རྒོད་བྲལ་ཚེ་གཉེན་པོ་བསྟེན་པ་ལ་མི་རྩོལ་བའི་བཏང་སྙོམས་རྣམས་མི་བརྗེད་པར་དྲན་འདུག་པའི་ཆའི་སེམས་བྱུང་དེ་ཡང་དག་པའི་དྲན་པའོ།",
    "ཟབ་ཟབ་ཟ་སཟབ་བས་འཛིན་རྟོག་པའི་ཞེན་གཞིར་རང་མཚན་དུ་གྲུབ་པའི་དངོས་པོ་མེད་ཀྱང་རང་འཛིན་རྟོག་པའི་ཞེན་གཞི་ཙམ་དུ་གྲུབ་པའི་ངོ་བོ་ཡོད་པ་དེ་ཉིད་དང་།",
    "འབྲིང་དུ་དབྱེ་ན་དངོས་པོ་དངོས་མེད་སྟོང་པ་ཉིད་དང་རང་གཞན་གྱི་ངོ་བོ་སྟོང་པ་ཉིད་དང་བཞི་དང་།",
    "ཕྱི་དོན་ཁས་མི་ལེན་པ་ཙམ་ལས་གོང་རང་རྒྱུད་པ་དང་འདྲའོ།",
    "ད་ལྟ་ཚེ་ལོ་བརྒྱ་ཐུབ་པ་སྲིད་མཐར་འདུག་དེ་མན་དུ་ནི་ལྟག་ཆུ་ཆད་པའི་རྫིང་བུ་བཞིན་དུ་སྣོན་པ་ཅུང་ཟད་ཀྱང་མེད།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "དེ་ཡང་རང་ཉིད་ལ་ཚ་དམྱལ་ཀྱི་བར་སྲིད་གྲུབ་ཚེ་ལུས་ལ་གྲང་སྣང་བྱུང་སྟེ་ཚ་བ་དོན་དུ་གཉེར་བའི་རྐྱེན་བྱས་ནས་བར་སྲིད་འགགས་ཏེ་ཚ་དམྱལ་དུ་སྐྱེ་བར་བསམ་དགོས་པར་གསུངས་པས་དེ་ལྟར་བྱ་སྟེ།",
    "ངུ་འབོད་ནི་ཡང་དེ་ལས་བྲོས་པས་ལྕགས་ཁང་གཅིག་རིམ་གྱི་ནང་དུ་སླེབས་པ་ན་སྒོ་དབྱེར་མེད་དུ་འགྲིགས་ཏེ་ཕྱོགས་ཀུན་ནས་མེ་འབར་ཏེ་བསྲེགས་པས་ད་བྲོས་ས་ཡང་མི་འདུག་སྙམ་དུ་ངུ་འབོད་ལྷང་ལྷང་བྱེད་དོ།",
    "ཡང་དེ་ལས་བྲོས་པས་ལྕགས་ཁང་གཉིས་རིམ་ནང་དུ་ཚུད་དེ་ལྕགས་ཁང་ནང་མ་ནས་ཐོན་སྲིད་ཀྱང་ཕྱི་མ་ལས་མི་ཐོན་ཞིང་བྲོས་ས་ཡང་མི་འདུག་སྙམ་དུ་སྔ་མ་ལས་ཀྱང་སྡུག་བསྔལ་ཏེ་ངུ་འབོད་ལྷང་ལྷང་བྱེད་དོ།",
    "ཐོབ་དགོས་པར་འདུག་སྙམ་དུ་བསམས་ལ།",
    "ཧ་ཅང་འདི་ཙམ་བསྒྲིམ་ན་རྒོད་པ་སྐྱེ་བར་འདུག་སྙམ་པ་དེ་ལས་ཅུང་ཟད་གློད།",
    "ཧ་ཅང་འདི་ཙམ་གློད་ན་བྱིང་བ་སྐྱེ་བར་འདུག་སྙམ་པ་དེ་ལས་འཛིན་སྟངས་འཕང་བསྟོད་ལ་བསྒྲིམ་པར་བྱ་བའི་གྲིམ་ལྷོད་རན་པ་རང་ཉམས་ལ་སྦྱར་ཏེ་ཐོག་མར་ཆུ་ཚོད་གཅིག་སོགས་ཀྱི་ཡུན་ལ་འཇོག་ཅི་ཐུབ་བྱ་དགོས།",
    "གསལ་ཆའི་ངར་ཧད་ཀྱིས་ཤོར་ནས་དྭངས་ཆ་ཙམ་ལས་མི་འདུག་ན་བྱིང་བ་རགས་པ་ཡིན་པས་ངོ་ཤེས་པར་བྱས་ལ།",
    "དེ་ཡང་རང་ལུགས་ལ་ནི་བློས་ཡུལ་ཆེད་དུ་བཟུང་བ་དང་།",
    "དེ་ཚེ་དམིགས་པ་བོར་བའི་གཞན་དུ་འཕྲོ་བའི་འཕྲོ་རྟོག་རགས་པ་མ་ཟད་སེམས་ཀྱི་ངོ་བོ་མ་བོར་ཀྱང་སེམས་ཀྱི་ཟུར་ཆ་ཞིག་གཞན་དུ་འཕྲོས་ཏེ་ཡུལ་སྣ་ཚོགས་དྲན་འདུག་པ་དང་ཟུར་ཆ་མི་འཕྲོ་ཡང་རང་སེམས་ཀྱི་ངོ་བོ་ལ་གཏད་འདུག་པའི་ཆ་དང་།",
    "ངོ་བོ་དེ་འཛིན་འདུག་པའི་ཆ་དང་།",
    "གསལ་སང་ངེར་མྱོང་འདུག་པའི་ཆ་དང་།",
    "དམིགས་པ་ཡང་བོར་ནས་འཕྲོ་མི་ཐུབ་པར་ཧད་དེ་སྡོད་པའི་ཆ་ལ་སོགས་པའི་བློས་བྱས་ཡིན་པ་གང་ཞིག་རང་སེམས་རང་བབས་སུ་བཞག་པའི་ངོ་ན་བྱིང་རྒོད་མ་ཟད་གཏད་འདུག་པའི་ཆ་དང་།",
    "ངོ་བོ་གསལ་སེང་ངེ་མྱོང་འདུག་པའི་ཆ་དང་།",
    "འཛིན་འདུག་པའི་ཆ་ལ་སོགས་པ་གཟུང་འཛིན་བློས་བྱས་ཐམས་ཅད་དང་བྲལ་བའི་རང་བབས་ཁོ་ན་གནས་པའི་རིག་པ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཡིན་པའི་ཕྱིར་རོ།",
    "དུས་ཀྱི་སྒོ་ནས་འགལ་བའི་གནོད་བྱ་ལྡོག་དུས་གཉིས་ལས།",
    "བུམ་པ་དེའི་ལྟོ་བ་མགྲིན་པ་སོགས་བུམ་པ་སྤྱི་ལྡོག་དེ་ལས་གཞན་པའི་ཆ་ཤས་སུ་སྣང་འདུག་པའི་ཆ་ནས་རྟོག་པ་ལ་རགས་པ་ཆ་དང་ཆ་ཅན་དུ་སྣང་ཚུལ་འཇོག་པ་ཡིན།",
    "གསར་དུ་མི་བསླུ་བའི་ཆ་ནས་བཞག་པའི་མཁྱེན་པ་ཞེས་སྦྱར་ཞིང་མཚན་གཞི་རྣམས་ཀྱང་རང་ཡིན་གྱི་ཤེས་པ་སྐད་ཅིག་དང་པོ་རྣམས་སོ།",
    "དེ་ལུགས་བཞིན་སེམས་ཀྱི་བདེ་སྡུག་སོགས་ཆེས་མངོན་གསལ་གྱི་སྣང་བ་དང་རང་རྒྱུད་ཀྱི་ངར་སྣང་བ་དང་།",
    "གང་ཟག་དུས།",
    "རང་རྒྱུད་པ་མན་ཆད་ཀྱིས་བག་ཆགས་འདོད་ཅིང་དེ་ཡང་རང་སྐྱ་མི་ཐུབ་པའི་བཏགས་ཡོད་དུ་འདོད་ལ།",
    "ལྡན་མིན་དང་ཤེས་པ་རྣམས་རང་རང་འཛིན་པའི་ཡིད་ཤེས་ཁོ་ན་སྐྱེ་བའི་ཡུལ་གྱི་སྒོ་ཡིན།",
    "བེ་རོ་ཙ་ན།",
    "ཡེ་ཤེས་སྤྱན་ལྡན་བེ་རོ་ཙ་ན།",
    "༤༡ ཉལ་པོ་བྱེད་པའི་ཁྱིམ་དུ་འདུག་པ་དང་།",
    "༣༢ ལུས་ལྗིད་ཕབ་ཏེ་འདུག་པ།",
    "༣༥ ལོང་བུའི་སྟེང་ལོང་བུ་བརྩེགས་ཏེ་འདུག་པ།",
    "༨༣ ཉལ་བ་ལ་འདུག་པས་དང་།",
    "༨༤ མཐོན་པོར་འདུག་པ་ལ་དམའ་བ་ལ་འདུག་པས་དང་།",
    "ཡང་འདོད་སྲེད་ཀྱི་བསམ་པས་རིན་ཐང་ཆེ་བའི་མལ་སྟན་རྒྱ་ཆེ་བར་འདུག་པ་དང་།",
    "ཁྲུ་གང་ལས་ལྷག་པའི་ཁྲི་མཐོ་བར་འདུག་པ་དང་།",
    "དེ་ལུགས་བཞིན་སེམས་ཀྱི་བདེ་སྡུག་སོགས་ཆེས་མངོན་གསལ་གྱི་སྣང་བ་དང་རང་རྒྱུད་ཀྱི་ངར་སྣང་བ་དང་།",
    "ཡུལ་འཛམ་གླིང་འདུག་ཆུས་སྒྲུབ་ལགས་སོ།",
    "གཏམ་ཡ་མཚན་ཆེ་བ་བརྗོད་རྒྱུ་གདའ།",
    "འདུག་མ་ཤེས་མི་ལ་སྐྱིད་པོ་མེད།",
    "མི་རྒན་གཞོན་བར་མའི་འདུག་ཆས་དང་།",
