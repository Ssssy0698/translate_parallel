    "ཐ་ན་རྡོ་གཡམ་རྣ་ཤོག་ཙམ་ཞིག་གཞན་ཡུལ་དུ་འཁྱེར་ན་ཡང་འཁྱེར་བ་པོ་གང་ཉིད་སྡོད་ཚུགས་མི་ཟིན་པ་བཟོ་ཡི་ཡོད་ལུགས་ཀྱི་དན་རྟགས་ལྟ་བུར་ཡུལ་དེའི་དམངས་ཁྲོད་རྒན་པོའི་ངག་རྒྱུན་དུ་སྒྲུང་ཐུང་འདི་འདྲ་ཞིག་ཤོད་རྒྱུ་འདུག་པ་སྟེ།",
    "བོད་སྐད་ཀྱི་མིང་དུ་ཁ་ཝང་ཞེས་བཏགས་པ་མཐོང་རྒྱུ་འདུག་པ་ལ།",
    "གཞུང་ལམ་གྱི་ལྷོ་ངོས་ན་སྔོ་རྩྭ་སྐྱེས་འཚར་ལེགས་ཤིང་ཆུ་ཕྲན་གྱ་གྱུར་རྒྱུ་བའི་ན་གཤོང་ཉམས་སུ་དགའ་བ་ཞིག་འདུག་པའི་དབུས་སུ་དཀར་ནག་ཕྱུགས་ལུག་སོས་གདལ་བག་ཕེབས་སུ་རྩྭ་ཆུར་རོལ་ནས་འདུག་ལ།",
    "ཉན་པ་གཞིས་འོག་འདབས་ལུང་དཀར་ཆུང་རང་བྱོན་སོགས་དང་འབྲེལ་བའི་སྣ་དཀར་རྩེའི་ལྗོངས་རྒྱུར་མྱོང་རོལ་གནང་འདོད་ཚེ་དེབ་ཆུང་འདིའི་ལེའུ་ལྔ་པ་སྟེ།",
    "ཙ་ན་ཡིན་ཡང་རྒན་བོས་བྱང་བཏང་བསྐོརད།",
    "འཇིག་རྟེན་གདགས་པའི་དཔེའུ་ཆུང་རྣམས་བྲིས་ཞེས་འདུག་ཀྱང་ད་བར་བཞིན་མཇལ་གྱི་གོ་སྐབས་མ་ཐོབ།",
    "ཡིན་རྒྱུ་ནི་མཚོ་ངོས་ཀྱི་བྲག་རིའི་གྲིབ་གཟུགས་མཚོ་ཆུར་ཕོག་པ་ཡིན་འདུག་བྲག་རི་དེ་ལ་གཏེར་ཆེན་བྲག་ཅེས་ཞུ་དོན་ནི།",
    "དེ་ནས་ཆུ་བོའི་རྒྱུ་ཕྱོགས་དང་བསྟུན་ནས་ཤར་ཕྱོགས་སུ་གཞུ་འདོམ་ལྔ་བརྒྱ་ཙམ་སྐྱོད་ཙ་ན།",
    "ཀརྨ་པ་སྐུ་ཕྲེང་ལྔ་པའི་སྒྲུབ་ཁང་དུ་གྲགས་པས་གཙོས་པའི་སྒྲུབ་ཁང་མང་པོའི་རྗེས་ཤུལ་འདུག་པ་དེ་དག་ཕལ་ཆེར་རྒྱུ་རྡོ་གཡམ་ལས་གྲུབ་པ་ཁོ་ན་ཡིན་ཞིང་།",
    "སྒྱུ་འཕྲུལ་རྡོ་རྗེ་སེམས་དཔའ་གཉིས་བསྣན་པས་ཞི་ཁྲོའི་ལྷ་ཚོགས་བརྒྱ་དང་གཉིས་བཞུགས་སུ་གསོལ་ནས་འདུག་པ་ངོ་མ་རྔམ་བརྗིད་ཆེའོ།",
    "སྒོ་རའི་ནང་གཡམ་པ་སྔོ་ལེབ་ཅན་གྱི་རྡོ་གཅལ་བཏིང་འདུག་ཅིང་།",
    "ཡི་དམ་ཞི་ཁྲོའི་དཀྱིལ་འཁོར་ཞིག་འདུག་མགོན་ཁང་ན་ཡི་དམ་རྡོ་རྗེ་དྲག་རྩལ་དང་།",
    "ལྷ་ཁང་སྟེང་ནི་ཞལ་ནུབ་ཏུ་ཕྱོགས་ནས་འདུག་པ་ལ།",
    "འོན་ཏེ་ལོ་ཟླའི་འཕོ་འགྱུར་གྱི་རྐྱེན་པས་ད་མཚམས་རྗེས་ཤུལ་ཙམ་ལས་མེད་པར་གྱུར་ནས་འདུག་ཀྱང་ང་རང་ནི་རྙིང་དད་ཅན་ཞིག་ཡིན་པས་དེ་རིང་ཆེད་མངགས་སུ་གནས་དེར་ལྟ་རུ་བསྐྱོད།",
    "ཕར་བལྟས་ཀྱང་མགོ་ཞྭ་ལྟག་རྒྱབ་ནས་ས་རུ་ལྷུང་བའི་ཚད་དུ་འདུག་ལ།",
    "སྐབས་དེ་དུས་སྡོང་རྒན་དེ་ཉིད་ཕྱེད་ཤི་ཕྱེད་གསོན་གྱི་ཚུལ་དུ་འདུག་པ་ལ།",
    "ཁྱེད་རང་གཅིག་པོ་གསོན་པོར་འཚོ་མྱོང་བ།",
    "ཁྱེད་རང་བཞའ་བློན་གྱི་ཁྲག་རྒྱུན་དང་བྲལ་ཞིང་།",
    "བསྐྲུན་དངོས་དེའི་བྱང་འདབས་ཀྱི་གྱེན་མ་གསེག་ཏུ་ཉེན་འགོག་ཀྱང་བརྩིགས་ནས་འདུག་ལ།",
    "ད་མཚམས་ཤུལ་དུ་ལུས་པའི་གྱུང་རོའི་མཐོ་ཚད་ནི་སྤྱི་ཁྲེ་གཉིས་མ་ཟིན་ཙམ་ཞིག་གོརི་རྩེར་འགྲོ་སའི་ལམ་བུ་བྱང་ངོས་ན་མ་གཏོགས་མི་འདུག་ཅིང་།",
    "མཛོད་ཁང་བཅས་ཁང་མིག་བཞི་འདུག་ལ།",
    "ཞོགས་པ་ས་དེར་འཇའ་ཁ་དོག་སྣ་ལྔ་ཟུག་འདུག་པ་ཁ་རག་པའི་རྩོམ་སྐྱེལ་བ་མང་པོས་མཐོང་བར་སྣང་།",
    "དེ་ནས་ཆུ་མིག་ཡོད་ས་དང་ཐག་ཉེར་སླེབས་པའི་དུས་ལྷག་པར་ན་འབག་ཚོགས་འཚོག་པ་ཞེས་གསོན་འདྲེ་མ་དག་རང་རང་ཁ་ལ་རན་པའི་སོ་ཞེས་པའི་དཔེ་ལྟར་སྒོམ་གཞོན་མ་དང་།",
    "ད་ནི་ཉི་མ་ཆུ་ལྷའི་ཕང་བ་རུ་ཡིབ་པ་ལ་ཐག་རྒྱང་གང་དོ་ལས་མི་འདུག་གཤིས།",
    "དགོན་དེའི་དཀར་ཆག་ནང་ཆེས་ཞིབ་ཅིང་ཕྲ་བ་བཀོད་འདུག་པ་སྟེ།",
    "བདེ་མཆོག་དུས་འཁོར་ལ་སོགས་ཆེ་བ་ཁྲུ་གང་ནས་ཆུང་བ་སོར་བཞི་བར་ལྔ་བརྒྱ་མ་ལོང་ཙམ།",
    "སྤྲུལ་པ་ཞིག་འདུག་བསམ།",
    "མ་དང་མཁའ་འགྲོ་སྤྲིན་དང་ན་བུན་བཞིན་དུ་འདུས་ནས་དྲོ་པ་དེ་གཉིས་དང་བཅས་ཕ་བོང་རང་རོང་ལ་ཐིམས་སོ།",
    "ཁྱེད་རང་སྐྱེ་བ་གསུམ་དུ་དབུས་ཀྱི་སྨད།",
    "བསམ་སྡིངས་ནས་ཐོན་ཕྱི་སྟབས་ལ་རྩེར་འབྱོར་དུས་ཁ་ལུང་བ་སྔོན་ཚུད་ནས་དེ་གར་འབྱོར་འདུག་པས་ཁོ་བོར་ཡིད་མི་བདེ་བའི་སྣང་བ་ཅུང་ཟད་སྐྱེས་ན་ཡང་བསུ་བ་པོ་ནི་ཕ་ཡུལ་ཁ་ལུང་ནས་ཡིན་ཞིང་།",
    "ད་མཚམས་ནགས་གླིང་ཐགས་སུ་བཀྲ་བར་གྱུར་འདུག་པས་སྔོན་དུས་ཀྱི་བྱེ་ཐང་སྐྱ་ཐང་ཐང་དེ་དེང་ཆར་གཡུ་གཞོང་སྔོ་ཐིང་ཐིང་ཞིག་ཏུ་གྱུར་བའི་དབུས་ནས་བྱ་བྱིའུ་གསུང་སྙན་ཀྱུར་ཀྱུར་དུ་ལེན་པ་དེ་ནི་ངོ་མ་ལྗོངས་རྒྱུའི་རྒན་པོར་བསུ་མ་བྱེད་པ་དང་མཚུངས་ལ།",
    "ཡུལ་དེ་གའི་དམངས་ཁྲོད་རྒན་པོའི་ངག་སྒྲོས་ལྟར་ན་གསུང་རྒྱུན་གཉིས་ཙམ་འདུག་པ་སྟེ།",
    "ཁོང་ནས་དགྱེས་འཛུམ་དང་བཅས་ང་རང་སྐྱེས་ས་འཚར་སའི་ཡུལ་མིང་ལ།",
    "གཞན་གྱི་འདྲེ་བྱ་སླེབས་འདུག།",
    "བློ་རྩེ་ཉི་ཤུ་རྩ་ལྔ་བཀོད་པ་ལས་ཐབས་མཆོག་ཏུ་གྱུར་བ་ནི་མཁའ་དབྱིངས་ནས་བལྟ་རྒྱུ་དེ་ཡིན་ན་ཡང་ང་རང་ནི་ལྷ་ཡི་ནུས་མཐུ་མེད་ལ་འདྲེ་ཡི་ཆོ་འཕྲུལ་གྱི་དབུལ་བའི་སོ་སྐྱེ་ཕལ་པ་ཞིག་ཡིན་ཞིང་།",
    "གཞོས་བཅས་ནས་སྟོངས་རྙིང་ཕུད་རྒྱུན་བཅས་སྒྲུབ་རྐང་དྲུག་ཅེས་འཁོད་འདུག་གཤིས།",
    "རྒྱལ་སྒོ་འཛུལ་མཚམས་རིང་ཚད་ལ་སྤྱི་ཁྲེ་༦དང་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་༢༢༣དང་ལྡན་པའི་ཁྱམས་རིང་ཞིག་འདུག་པའི་ནུབ་མཚམས་ན་ཀ་གཉིས་ཀྱི་མཛོད་ཁང་ཞིག་དང་།",
    "གསོལ་ཐབ་ཁང་འདུག་པ་དེ་དག་ཚང་མ་དཀྱིལ་དབུས་ཀྱི་རྒྱ་མཐོངས་མཐའ་འཁོར་དུ་འདུག་ཅིང་།",
    "འོད་ཟེར་ཚོམས་ཆེན་དེ་ཉིད་བྱང་ངོས་ཀྱི་ཤར་མཚམས་སུ་འདུག་པ་ལ།",
    "གསོལ་ཐབ་ཁང་ནི་ནུབ་ཕྱོགས་ཀྱི་ལྷོ་མཚམས་སུ་འདུག་ཅིང་།",
    "མཇལ་འདོད་བློ་ལ་འདུག་སྟེ།",
    "མཇལ་བའི་བསོད་བདེ་མི་འདུག་གསུངས་ནས་ཁོ་བོར་དེ་དོན་བོད་རྒྱ་ཡིག་རིགས་གང་རུང་ནས་ངོ་སྤྲོད་ཅིག་བྲིས་ཏེ་རྒྱ་ཆེའི་ཀློག་པ་པོར་ངོ་སྤྲོད་ཞུ་དགོས་པའི་སྐུལ་མ་གནང་བྱུང་བས་ད་ཐེངས་གཡུ་མཚོའི་ནང་སྐོར་གྱི་གོ་སྐབས་དེ་དང་བསྟུན་ནས་ངོ་སྤྲོད་ཅུང་ཟད་ཅིག་ཞུས་ན་འདི་ལྟར་ལགས།",
    "དེ་བས་ན་ལང་ཤུཡག་ཁམ་པ་འདི་བཞིན་མཐུ་དང་ནུས་པ་ལྷག་པར་ཆེ་སྐད་ལ་ང་རང་བྱིས་པའི་དུས་སུ་ཡུལ་མི་རྒན་རབས་ཚོས་དུས་རབས་གོང་མའི་སྤྱི་ལོ་༡༩༥༥ལོར།",
    "བྲག་བཙན་དམར་པོ་ནི་དོན་དམ་དུ་ཡུལ་ལྷ་ལང་པ་རྒྱལ་མཚན་ཡིན་འདུག་ཅིང་།",
    "སྟབས་ལེགས་ནས་གསོལ་མཆོད་ཕྱག་དཔེ་དེ་ལས་ཡིག་ནོར་ཅུང་ཟད་མ་གཏོགས་གཤམ་གསལ་འདི་ལྟར་འཁོད་ནས་འདུག་པ་སྟེ།",
    "དེ་ཡང་ཡུལ་ལུང་དེའི་ཤར་ངོས་ཀྱི་སྤྱི་ཁྲེ་བརྒྱད་བརྒྱ་ཙམ་གྱི་ཕུ་ཤུར་ན་གསེར་རི་དང་དགའ་བཟང་རི་བོ་གཉིས་ཀྱི་རྩ་བ་འབྲེལ་སའི་རི་སྐེད་དུ་དཔལ་རི་དགོན་ཤུལ་གནས་འདུག་ཅིང་།",
    "དགོན་དེ་ཉིད་རྒྱ་མཚོའི་ངོས་ལས་མཐོ་ཚད་སྤྱི་ཁྲེ་༤༦༨༩དང་ལྡན་པའི་བྱང་མཚམས་སུ་རྒྱབ་རྩིག་བྲོག་རིར་རྙེས་པའི་ཞལ་ལྷོ་ལྟ་ཅན་ཞིག་འདུག་ཅིང་།",
    "ཡུལ་དེ་ན་སྒོ་པ་བས་དགུང་ཟས་སྟ་གོན་ཚགས་ཚུད་གྲུབ་ནས་འདུག་ཅིང་།",
    "དགོན་ཤུལ་དེ་བཞིན་དེའུ་འབུར་ཞིག་མཆིས་པའི་སྡིངས་ཁ་རུ་འདུག་པ་ལ།",
    "སྟོད་གོས་དེ་དག་ལ་ཡར་འབྲོག་སྒང་དུ་རྒྱུ་ཆའི་ཆ་ནས་རིགས་ཆེ་བ་གསུམ་ལ་དབྱེ་སྲོལ་འདུག་པ་སྟེ།",
    "གལ་ཏེ་འབྲུ་མ་གས་ཚེ་ཆང་ཆུ་བཙག་དུས་བྲོ་བ་ཆུང་བ་དང་།",
    "གས་དྲགས་ན་ཆང་བཙག་དུས་ཉོག་པོ་ཐོན་སྲིད།",
    "གྲྭ་ཤག་ནི་འདུ་ཁང་མདུན་ཕྱོགས་སུ་ཡོད་ཚོད་འདུག་ན་ཡང་སྤྱི་ཁྲེ་གང་མིན་ཙམ་གྱི་གྱང་རོ་ཙམ་ལས་མི་མངོན།",
    "མཆོད་གཤོམ་དབུས་སུ་རྗེ་ཙོང་ཁ་བ་ཆེན་པོའི་སྐུ་འདྲ་ཆུང་ཆུང་དང་གཡས་གཡོན་གཉིས་སུ་རྡོ་བརྐོས་ཀྱི་ཞི་ཁྲོའི་ལྷ་ཚོགས་རྣམ་པར་བཀྲ་བ་བཅུ་གྲངས་ཤིག་བཞུགས་སུ་གསོལ་ནས་འདུག་ལ།",
    "གཙོ་བོ་པཱ་ལ་རྣམ་གསུམ་སོགས་འདུག་པ་ལས།",
    "སྟོན་པ་གཙོ་འཁོར་གསུམ་པོ་དཀྱིལ་དབུས་སུ་འདུག་པ་ལ།",
    "ཀུན་དགའ་བོ་དང་འོད་སྲུངས་གཉིས་ཀྱི་སྐུ་འདྲའི་མཐོ་ཚད་ལ་སྐར་མ་ལྔ་བཅུ་དང་ཞེང་ཚད་ལ་སྐར་མ་སུམ་ཅུ་ཙམ་འདུག་གཙོ་འཁོར་གསུམ་གྱི་སྟེང་ཕྱོགས་གཡོན་ངོས་སུ་པཱ་ལ་རྣམ་གསུམ་བཞུགས་སུ་གསོལ་ནས་འདུག་ལ།",
    "བྲག་ངོས་ཀྱི་གཤམ་ཐད་ན་སྟོན་པའི་ལྷ་སྐུ་ཞིག་བཞུགས་སུ་གསོལ་བའི་སྐུ་རྒྱབ་ན་ཡིད་འོང་ལྡིང་ཁང་རྣམ་པར་བཀྲ་བ་ཞིག་འདུག་ཅིང་།",
    "འབུར་བརྐོས་དང་ཤུར་བརྐོས་ཟུང་འབྲེལ་གང་ལེགས་བྱས་འདུག་ཅིང་།",
    "དེ་ཉིད་ལས་བརྒྱུད་པ་ཚེ་ནོར་ལགས་དང་རང་གྲོལ་ལགས་ནི་རྒྱུད་འཛིན་མི་རབས་གསུམ་པ་ཡིན་ཞིང་།",
    "མཆོག་གྱུར་རིགས་གཉིས་ཡོད་འདུག་པ་ལས།",
    "གསེར་ཉ་ཡིན་ན་བསམ་བྱུང་ཞེས་པའི་དམངས་གཞས་དེ་དྲན་གྱིན་ཡོད་ཙ་ན་གློག་གྲུ་དགོན་འདབས་ཀྱི་མཚོ་ཁར་འབྱོར་ཟིན།",
    "གནས་རིའི་དབུ་རྩེ་ནས་ཧའོ་གནོད་སྦྱིན་གང་བཟང་དམ་འདོགས་གནང་ཡུལ་གྱི་སྒྲུབ་ཕུག་བྱིན་ཅན་དང་རང་བྱོན་དུ་མ་ཞིག་མཇལ་རྒྱུ་ཡོད་ལ།",
    "ཁ་ཕྱིར་བསྐོར་ནས་ལྟ་དུས་གནའ་ཕྲུག་པྲ་ཚགས་ཅན་དེ་འདུར་རྒྱུགས་སུ་བྲོས་ཀྱིན་འདུག་པས་ངེད་གསུམ་ཧབ་ཆ་ཆེས་ཆེར་ཤོར།",
    "དེ་རྗེས་ས་ཡོས་༡༨༡༩དང་ལྕགས་འབྲུག་༡༨༢བསྐྱར་ཞིབ་སྐབས་དགུང་ལོ་ཉི་ཤུ་རྩ་དྲུག་ཅེས་གསལ་འདུག་པས་གསུང་རྒྱུན་དང་གཞུང་ཡིག་དབར་མཚན་གྱི་བརྗོད་ཚུལ་འགའ་ཞིག་ཅུང་ཟད་མི་འདྲ་ཞེས་དང་།",
    "ལ་ལས་དགེ་ཡང་སྡིག་འབྲོག་ཟེར་འདུག་པ།",
    "སྐྱ་སེར་གྱི་ངེས་པ་མི་གདའ་ཡི།",
    "ལུ་གུ་དོ་དགོན་ཤུལ་དེ་ཉིད་རི་སྐེད་ན་འདུག་ཅིང་།",
    "རྩིག་ཞེང་ལ་སྤྱི་ཁྲེ་༧༦འདུག་ཅིང་།",
    "ལྷ་ཁང་དེ་ཉིད་ཐོག་ས་གཉིས་ལྡན་ལ་ཐོག་ས་དང་པོ་རྡོ་རྩིག་དང་ཐོག་ས་གཉིས་པ་བ་དཀར་གྱི་ས་ཕག་ལས་གྲུབ་ཅིང་རྩིག་རོའི་མཐོ་ཚད་སྤྱི་ཁྲེ་༣ཙམ་འདུག་རྒྱལ་སྒོའི་ནང་ངོས་སུ་ཆེས་ཆུང་བའི་སྒོ་ར་ཞིག་འདུག་པ་དེའི་དཀྱིལ་དབུས་ཀྱི་སྐས་ཐེམ་འཛེགས་ན་ལྷ་ཁང་ནང་སླེབས་པ་དང་།",
