    "སྤྱན་ཆབ་སིལ་མ་སོགས་གནང་འདུག་པར་དགོས་ཆའི་རིགས་དང་རྟ་དྲེའུ་གསུམ་བཅས་ཕུལ་བས་དགྱེས་པར་གྱུར།",
    "མདུན་གྱི་ཁྲོད་བཀའ་འཁོར་གྱི་ཚོགས་བཅས་ལམ་ལམ་པ་ཞིག་འདུག་པས་ངེད་རང་སེམས་རྒྱུད་བདེ་ཆམ་པ་ཞིག་བྱུང་བ་རྨིས།",
    "དགོན་དུ་འོང་དགོས་ཀྱི་བཀའ་ནན་མཛད་འདུག་དོན་ལྟར་ཕྱི་ཉིན་སྒར་ཆེན་ཁྲ་ལེབ་ངོ་གོང་ནང་དུ་བརྫངས།",
    "གཞན་ཡང་འདོད་ལྷ་ཁ་ཤས་བཅས་ཤིན་ཏུ་སྒྲོས་ལེགས་གྲུབ་འདུག་པའི་རབ་གནས་མངའ་གསོལ་དང་།",
    "འདུག་གནས་གཟིམས་ཁང་གསར་པར་མཛད།",
    "ཉེ་སྐོར་དུ་འབུམ་པ་ཁ་ཤས་ཡོད་འདུག་པར་དེ་དག་ལ་དམིགས་པའི་ཞབས་བརྟན་གྱི་ཐོ་ཕུལ་ཏེ་མི་བདག་ཆེན་པོར་ཞག་ཤས་གནས་ཁང་དུ་གང་སྤྱིའི་དོན་དུ་འགྲོ་བ་ཞིག་ཞུས་པས་དེ་ལྟར་བྱེད་ཆོག་ཕེབས་པ་དང་།",
    "ཁོང་རང་རྣམས་ཀྱི་མཇལ་རྟེན་བླང་སྟེ་རིམ་གྱིས་ཆས་ཟུར་བཞུགས་གྲལ་དང་།",
    "ཞབས་དྲུང་རི་བོ་རྩེ་པ་ནས་འཚམས་རྟགས་དང་བཞེད་དོན་ཕྲན་བུ་འདུག་པའི་སྐུ་ཚབ་རྣམས་ལ་ཞབས་འགྱུར་གང་དྲག་དང་།",
    "ཡུན་རིང་ཙམ་ཞིག་བཅད་རྒྱར་འདུག་བསམ་རུང་།",
    "ཡུལ་གང་དུ་བཟང་བ་འདུག་སྨྲས་པས།",
    "རིམ་གྱིས་གནས་ཁང་དུ་འོང་བས་འདུག་གནས་སུ་སླེབས་འཕྲལ།",
    "འབུལ་ཞབས་བཟང་བར་འདུག།",
    "འདུག་གནས་ཕྱི་རོལ་སྤང་ལྗོངས་སྟེང་དུ་གཟིམས་གུར་ཕུབ་པ་གནང་འདུག་པར་བསྡད་དེ་རིམ་གྱིས་དེ་ནུབ་མཇལ་འཛོམ་ཞུས།",
    "ཕྱི་རོལ་དུ་ཡུལ་དེ་ཉིད་དང་ཕྱོགས་མཐའ་ནས་འོངས་པའི་སེར་སྐྱ་ལྔ་བརྒྱར་ཉེ་བའི་བསྔོ་རྟེན་འབུལ་བ་རྒྱས་པར་འདུག་པས་ཚེ་སྒྲུབ་ཀྱི་རྗེས་གནང་དང་བསྔོ་སྨོན་དད་རྟེན་སློག་ཆ་རྒྱས་པར་ཕུལ།",
    "ཤིང་ཁྱི་ཟླ་བ་བཅུ་པའི་ཚེས་ཉི་ཤུ་ལ་ཞེས་པ་སྩལ་འདུག་ཅིང་།",
    "གཙང་གླིང་ཁང་ཚན་གྱིས་རྟ་བསུ་མཇལ་དར་དང་ལྕགས་རིར་ཉེ་བར་སྤོས་སྣ་བཅས་ཏེ་གླིང་ཁང་དུ་སྡོད་གནས་བགྱིས་འདུག།",
    "འབྲུག་ཐམས་ཅད་མཁྱེན་པ་ལྷ་ལྡན་གཡུ་ཐོག་ཏུ་བཞུགས་གདན་འཇགས་འདུག་པར་མཇལ་འཛོམ་ཐོག་བསྔོ་རྟེན་འབུལ་བ་སྦྲགས་པར་ཁ་བཏགས།",
    "ལྷ་ས་བཀྲ་ཤིས་དཔལ་རབ་ཏུ་ཀརྨ་ཞྭ་ནག་པ་བཞུགས་འདུག་པ་མཇལ་ཞུས་ཐོག་ཁ་བཏགས།",
    "ཇུས་སྲིད་ལ་འདི་ལ་མཆན་མི་འདུག།",
    "ཕྱི་ཉིན་གཞིས་རྩེར་འགྲོ་བའི་ལམ་བར་ཟམ་ཆེན་གྱི་ཆུ་ཤར་དུ་བཀྲ་ཤིས་ལྷུན་པོའི་བཞད་པ་མི་ཚན་གྱིས་ཐབ་འཛིན་མཇལ་དར་རྟ་བསུ་དང་སྦྲགས་རྒྱ་གསར་པར་སྡོད་གནས་བགྱིས་འདུག་པར་བླ་བྲང་རྒྱལ་མཚན་མཐོན་པོ་ནས་གསོལ་ཇ་དང་ཁ་བཏགས་གནང་།",
    "དེ་མཚམས་རྒྱལ་མཚན་མཐོན་པོར་ངོར་དུ་འགྲོ་རྒྱུའི་ཐོན་ཆས་ཞུས་པས་གཟིམས་ཆུང་རང་དུ་གསོལ་ཇའི་ཐོག་དད་རྟེན་སྲུང་མདུད་ཀྱི་ཚོགས་དང་གོས་བཟང་ཡུག་བཞིས་གཙོས་པའི་དར་རས་དགུ་ཚན་བདུན།",
    "གཟིམས་གུར་ཡོལ་གོར་བཞུགས་ཁྲི་བཅས་བཀོད་ལེགས་བགྱིས་འདུག་པར།",
    "འདུག་གནས་ཕན་བདེ་ཁང་དང་བླ་བྲང་ཁང་པ་བདེ་ཡངས་གླིང་ཁང་བཅས་དགེ་ལམ་གང་ཆེ་སྔོན་དུ་བརྟག་པ་བགྱིས་པས་གླིང་ཁང་ཚན་དུ་བཟང་ཐོན་བྱུང་བ་ལྟར་དེ་ཉིད་དུ་བབས་ཏེ་བསྟི་གནས་བཅས།",
    "ག་ར་བཀྲ་ཤིས་དར་རྒྱས་སུ་གཟིམས་གུར་ཡོལ་སྒོར་བླ་བྲེ་བཞུགས་ཁྲི་རྒྱབ་ཡོལ་བཀོད་ལེགས་སུ་སྩལ་འདུག་པ་དང་།",
    "གཞིས་གཉེར་ནས་ཆིབས་བསུ་གྲ་བསྒྲིགས་བཀོད་ལེགས་དང་འདུག་གནས་གོང་མ་རིམ་བྱོན་གྱི་གཟིམས་ཆུང་དུ་བགྱིས།",
    "པའི་སྐབས་ཀུན་བཟང་སྣང་བརྙན་གང་དེར་རང་བབ་ཀྱིས་བཞེས་འདུག་པ་ཡ་མཚན་དུ་མངོན།",
    "ཕྱིས་སུ་རྡོ་རྗེ་སློབ་དཔོན་གསར་བཀོད་ལ་བརྗོད་གླེང་ཕྲན་བུ་བྱུང་བའི་ལྟས་སུ་འདུག།",
    "ལྷག་ཏུ་གུར་ཞལ་པུ་ཏྲ་གསུམ་གྱི་སྣང་བརྙན་བྲིས་པའི་དར་ནག་སློང་བ་དང་ཆབས་ཅིག་པར་བདག་ཆེན་ལྷན་རྒྱས་པས་ལྷ་བསང་བཏང་ཞིང་དབུའི་སྟེང་དུ་གདུགས་སེར་པོ་ཤིན་ཏུ་མཐོ་བ་ཞིག་བསྐོར་གྱིན་འདུག་པས་སེར་སྐྱ་ཐམས་ཅད་ཀྱིས་སྐྱབས་མགོན་དམ་པ་སྐུ་དཀྱིལ་དྭངས་པ་བཀའ་དྲིན་ཆེ་ཟེར་བ་ཞིག་བྱུང་ཞིང་།",
    "ཡུལ་མི་ཀུན་གྱིས་རྒྱན་གོས་འཕྱོར་ཆས་ཀྱི་གླུ་གཞས་ཞབས་བྲོ་སོགས་འཁྲབ་འདུག།",
    "མགོན་ཁང་དུ་ཨ་ཇོ་ཆེན་པོར་བསྐང་གསོའི་སྟེང་སྙན་དར་ལ་འདོད་གསོལ་དུ། ། ཏྲི་པཾ།",
    "འབུལ་ཆེན་སྔ་ལོ་ལྷ་སར་བཞུགས་སྐབས་གྲུབ་ཀྱང་ཕྱི་ཉིན་ཡང་བསྐྱར་འདུག།",
    "གཞུང་ས་ནས་མཚལ་ཁང་ཁྲི་ཆེན་ནོ་མན་ཧན་གྱིས་ཞལ་བདག་གནང་བའི་གཟིམས་ཁང་བཀྲ་ཤིས་དགོས་འདོད་གནང་འདུག་པ་དེར་བསྡད།",
    "འདུག་ཁང་བླ་བྲང་ཟུར་པ་ཞིག་ཏུ་ལྗགས་བཀོད་གནང་ལྟར་བསྡད།",
    "ལྔ་མཆོད་གྲྭ་ཚང་དུ་འདུག་གནས་བགྱིས།",
    "བཞུགས་ཁྲི་བཅས་མཛད་འདུག་པར་བསྡད།",
    "འདུག་པས་དགོངས་འཇགས་དང་།",
    "སྣེ་ལེན་གུས་ཞབས་ཆེ་ཞིང་ངོས་ཀྱི་མདུན་དུ་གྲྭ་བཤར་གཉིས་ཀྱིས་རོ་དྲུག་སོ་སོར་ཁྱབ་རྟགས་འགོད་པའི་མཚན་ཉིད་ཀྱི་གླེང་བ་ཡ་མཚན་པ་བྱེད་ཅིང་འདུག།",
    "མགོན་པོ་ཏྲག་ཤད་ཁང་དུ་སྙན་དར་ཕུལ་ནས་ཕྲིན་བཅོལ་ཞུས་པར་བཀའ་ཤིན་ཏུ་གཉན་པར་འདུག།",
    "སྤྱི་ས་ནས་བསྙེན་བཀུར་ཧུར་བསྐྱེད་ཞུ་འདུག།",
    "མཚན་ལྡན་ནམ་མཁའི་རྣལ་འབྱོར་པའི་སྐུ་བརྙན་གྱི་མདུན་དུ་དེ་ཕྱོགས་ཚང་མས་བླང་དོར་གྱི་རིམ་པ་མར་མེའི་བརྟག་པ་བྱེད་སྲོལ་མཆིས་པས་བཟང་ངན་འཁྲུལ་མེད་དུ་ལུང་བསྟན་པ་ཞིག་ཡིན་པར་འདུག།",
    "དགོན་གྱི་གྲུ་ཁང་ཞིག་ཏུ་འདུག་གནས་བགྱིས།",
    "མ་རྒན་བགྲང་བྱ་བཅུ་ཕྲག་བརྒྱད་ལྷག་ཙམ་དུ་སླེབས་པ་ཞིག་འདུག་པས་སྔོན་འགྲོར་གོས་ལྷམ་ལུས་གང་ཆ་འགྲིགས་ཕུལ་བར་བསྔོ་སྨོན་བགྱིས།",
    "དཀར་པོ་གྲྭ་ཚང་དུ་འདུག་གནས་བགྱིས།",
    "ཧོར་ཁག་དང་རྒྱལ་རོང་བཅས་རང་རང་སྡོད་མ་ཐུབ་པའི་རང་བྱས་གཉའ་བར་བབས་པ་ཡིན་ཚེ་མི་ཤ་ཟོག་འཐོར་རྣམས་རྩད་མེད་དང་།",
    "སྒོར་ཞིང་སྒོར་བའི་དགུང་ཉི་མའི་དཀྱིལ་འཁོར་ལས་རིན་ཆེན་དང་པོའི་གསེར་སྐུད་ཁྲི་མ་འབུམ་དུས་གཅིག་ཏུ་འཇིག་རྟེན་མི་ཡུལ་ལ་བཀྲམ་འདྲའི་འོད་བརྒྱུའི་ཁོ་ལག་ཡངས་པོ་རབ་ཏུ་འགྱེད་ཀྱིན་གདའ།",
    "ཞིང་གཞན་ཐམས་ཅད་ནི་ལྷག་མེད་དུ་བཅོམས་ནས་འདུག་པ་ལ།",
    "ཤར་ནུབ་ཀྱི་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་༧ ཙམ་འདུག་ལ།",
    "བཟོ་སྐྲུན་ཧྲིལ་པོ་རྡོ་རྩིག་ལས་གྲུབ་ནས་གདའ།",
    "གྱང་རོ་དེ་ལ་ལྕགས་རི་ཕྱི་ནང་གཉིས་འདུག་པ་ལས།",
    "ལྕགས་རི་ཕྱི་མའི་ནང་ངོས་ཀྱི་ནུབ་ཕྱོགས་ན་གྲུ་བཞི་ཕྱ་ལེ་བའི་བཅད་འཐེན་པའི་ཁང་མིག་ཆུང་ངུ་འགའ་ཤས་འདུག་པ་དེ་དག་ནི་ཕར་བལྟས་ན་རྟ་ར་སོགས་སྒོ་ཕྱུགས་ར་སྐོར་ཡིན་ཤས་སུ་སྣང་ལ།",
    "ལྕགས་རི་ནང་མའི་རྒྱལ་སྒོ་ནུབ་ཕྱོགས་སུ་འདུག་ཅིང་།",
    "གྲ་ཤག་རུང་ཁང་གསུམ་ལས་གྲུབ་ནས་འདུག་ཅིང་།",
    "སྒོ་མཆོར་ནང་ངོས་ཀྱི་ཤར་ཕྱོགས་ན་ཐོག་ས་གཉིས་པར་བསྐྱོད་སའི་སྒྲོམ་སྐས་ཤིག་འདུག་པ་རྒྱས་སྤྲོས་མི་ཆེ་ཡང་ཤིན་ཏུ་ནས་རྒྱུ་སྤུས་དག་པར་མངོན།",
    "ང་རང་བརྩིས་ན་བཅུ་དྲུག་ཡོད།",
    "མི་ལོ་བཞི་བཅུ་ལྷག་འདས་པའི་དུས་དེ་རིང་ཁྱིམ་ཚང་དུ་མའི་སྒོ་ཁ་ན་ཚོས་གཞི་དང་ལན་པར་སྣ་ཚོགས་པའི་རླངས་འཁོར་ཆེ་ཆུང་མང་པོ་མཐོང་རྒྱུ་འདུག་པས་ཐོར་ཕྲུག་དེ་ཉིད་ཐ་ན་ལྕགས་བཙའ་བརྒྱབ་ནས་ལྟ་བཟོ་འདི་བཟོ་མེད་པའི་རྐང་འཁོར་གོབ་ཏོ་ཞིག་ཏུའང་མི་དོ་བར་གྱུར་ནས་འདུག་དེ་ཡང་ཡིན་ཏེ།",
    "མདའ་ལ་གཡུ་ཆབ་མི་འདུག།",
    "པོ་རོ་ཙ་ན་ཞུ་བ་ནི།",
    "དེ་རྗེས་བཙན་པོས་བེ་རོ་ཙ་ན་དང་རྩངས་ལེགས་གྲུབ་ཟུང་ལ་གསེར་བསྐུར་ནས་བཀའ་རྫོགས་པ་ཆེན་པོ་འཚོལ་དུ་བཏང་།",
    "རྔོག་ལོ་ཙཱ་བ་བློ་ལྡན་ཤེས་རབ་ཀྱིས་ཀྱང་བེ་རོ་ཙ་ན་ནམ་མཁའ་དག་དང་མཉམ།",
    "འོ་ན་གཡུ་མཚོ་དེར་ཕོ་མ་ཞེས་མིང་ཐོགས་དགོས་དོན་ཇི་ཡིན་སྙམ་ན་དམངས་ཁྲོད་ངག་རྒྱུན་དུ་དེ་དང་འབྲེལ་བའི་ལྷ་སྒྲུང་ལྟ་བུའི་ཤོད་རྒྱུན་འདི་འདྲ་ཞིག་འདུག་པ་གཤམ་གསལ་སྔོན་སྲིད་པ་དང་པོ་ཆགས་པའི་དུས།",
    "ང་རང་འདི་ལོ་སྤྱི་ལོ་༢༡༦ལོ་ན་ང་དྲུག་ཏུ་སླེབས་པའི་སྤོ་བོ་ཞིག་ཡིན་ཞེས་སྨྲ་ཞོར་དུ་ལྕེ་ལེབ་ཅུང་ཟད་བསྣར་ནས་མི་འདོད་པའི་བརྡ་རུ་དབུ་ཌ་མ་རུ་ལྟར་གཡུགས།",
    "དམར་པོ་ཤ་ཡི་དགོས་པ་མི་འདུག་ཅེས་པ་ལྟར་དཀར་ཟས་ལེགས་ཤོས་སུ་བྱེད།",
    "དེ་ནས་ཡར་ཙམ་བགྲོད་ན་དགོན་རོའི་ལྷོ་ཐད་ཀྱི་ཉ་བ་ན་མཆོད་རྟེན་གྲུ་བཞི་མ་ཞིག་རལ་ཅན་ཞིག་འདུག་པ་དེ་ལ་སྡིག་བཤགས་མཆོད་རྟེན་དུ་གྲགས་དོན་ནི།",
    "བར་ཁྱམས་ཀྱི་གཡས་ཕྱོགས་སུ་བཅད་ཁང་དྲུག་ཡོད་པའི་དཀྱུས་རིང་ཤོས་ལ་སྤྱི་ཁྲེ་ལྔ་ལྷགུ་དང་ཆུང་ཤོས་ལ་སྤྱི་ཁྲེ་བཞི་ལྷག་དང་ལྡན་ཞིང་ཞིང་ཚད་ལ་སྤྱི་ལེ་གཉིས་ཙམ་འདུག་པ་དེ་དག་ལྷ་ཁངང་གམ་གཟིམ་ཆུང་ཡིན་ཤས་ཆེ།",
    "ཁོང་རང་མཚན་ལ་འདི་ལྟར་ཞུ་བ་ཡོད།",
    "ཁག་གསུམ་པ་ནི་ཁག་དང་པོའི་ནུབ་མཚམས་ཀྱི་བྲག་ཟུར་སྟེང་མཐོ་ཚད་ལ་སྤྱི་ཁྲེ་ཕྱེད་དང་གཉིས་དང་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་གཅིག་ཙམ་པ་འི་སྟོན་པ་ཤཱཀྱ་ཐུབ་པའི་སྐུ་བརྙན་ཞིག་འདུག་པ་དེ་ལ་ཚོན་གསར་སྒྲོན་ནས་འདུག་པས་དེ་བས་རྣམ་པར་བཀྲ།",
    "ངེད་ཚོ་སྤང་ལྗོངས་སྟེང་དུ་དགུང་ཟས་ཀྱི་སྟ་གོན་ལ་རོལ་ནས་ཡོད་ཙ་ན།",
    "སྤྱི་ལོ་༢ལོར་ཁོ་རང་སྐུ་སྒེར་གྱི་ཐུགས་འདུན་ལ་ཡབ་ཡུམ་གྱི་རྒྱབ་སྐྱོར་ཐོབ་པས་བྲག་ར་དགོན་དུ་སྒྲ་ཞུགས་མཛད།",
    "ངག་རྒྱུན་ལྟར་ན་ཁག་གསུམ་འདུག་པ་ལས་གཅིག་ནི་ངེད་ལུང་པའི་ཡུལ་སྐད་དུ་ཞའུ་རི་ཟེར་བའི་མདའ་རུ་ལུང་པ་ཆགས་པ་ན་ཞ་མདའ་ཟེར་སྲོལ་འདུག་ཞའུ་རི་ཟེར་བ་ནི་སྔོན་ཚེ་ནང་ཞ་ཉེའི་གཏེར་ཁས་གང་བ་ལ་ཕྱི་ཁ་བས་ཡོངས་སུ་བཏུམས་པའི་གངས་རི་ཆུང་ཆུང་ཞིག་ཡིན་པར་གྲགས་ལ།",
    "རང་རང་རིགས་མཐུན་ཀྱུ་རུ་བྱས་ཏེ་བཅུད་ལྡན་རྩྭ་ཆུར་རོལ་འདི་སྐྱིད།",
    "གཞན་ཡང་རྗེ་ཉིད་ཀྱི་ཞབས་རྗེས་དང་རའི་ཞབས་རྗེས་རང་བྱོན་སོགས་མཇལ་རྒྱུ་འདུག་ལ།",
    "མདང་ནུབ་ཀྱི་མཚན་ཆར་དེས་མཐོ་བ་ནམ་མཁའི་གཡའ་དག་ཅིང་དམའ་བ་ས་གཞིའི་རྡུལ་དག་པར་གྱུར་ནའང་མ་བསམས་ས་ན་དེ་རིང་ཐོ་རངས་དུས་སྤྲིན་ཁ་བྱེར་ཤུལ་ནས་ཁོག་འདར་ཤོར་འདྲའི་ངང་ཚུལ་ཅན་གྱི་སྐར་ཆུང་དག་གསལ་ལ་མི་གསལ་བར་འཆར་བ་ནི་འོང་ཁར་སང་འཁྱུག་འོངས་བའི་སྔ་ལྟས་ཤིག་ཡིན་ཙ་ན།",
    "རྣམ་ཀུན་སད་སེར་ཀྱི་གནོད་པ་མེད་ཙ་ན་ཡང་གོན་པོ་ཐུང་ལ་སོས་དལ་དུ་འདུག་ཁོམ་མེད་དེ།",
    "མཐོ་ཤོས་སུ་སྤྱི་ཁྲེ་ལྔ་ལྷག་འདུག་པ་ལ་བལྟས་ན་སྔོན་ཚེ་ཐོག་སོ་གསུམ་ལྡན་ཡིན་ཚོད་དུ་སྣང་།",
    "རྒྱལ་སྒོ་ཆེ་ཁ་ཤར་བལྟས་སུ་འདུག་ཅིང་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་ཕྱེད་དང་དོ་ཙམ་འདུག་རྒྱལ་སྒོ་འཛུལ་རྗེས་ངེད་ཀྱི་མིག་ལམ་དུ་ཤར་ནས་ནུབ་བར་གྱི་རིང་ཚད་ལ་ཧ་ལམ་སྤྱི་ཁྲེ་༡༤ཙམ་མེད་དམ་སྙམ་པའི་ཁྱམས་རིང་དེ་ནི་ལྷོ་བྱང་གཉིས་ཀྱི་སྐྲུན་དངོས་ཟུང་ཆ་ཤས་གཉིས་སུ་ཕྱེ་བའི་མཚམས་ཐིག་དང་འདྲ་ལ།",
    "བང་རིམ་སོ་སོར་སྤྱིར་ན་སྐར་མ་བཅུའི་གཡས་གཡོན་འདུག་པའི་དབྱིབས་ཚང་མ་གྲུ་བཞིར་མཆིས་པ་ལ།",
    "དེ་གཉིས་སོ་སོའི་རིང་ཚད་ལ་སྤྱི་ཁྲེ་༡༤དང་༡འདུག་པ་དང་ཞེང་ཚད་ནི་སྤྱི་ཁྲེ་༣ཙམ་མཆིས།",
    "སྤོ་བོ་རྫི་བོ་ཁྱེད་རང་།",
