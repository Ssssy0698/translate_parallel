    "མ་རྒན་ཇོ་མོ་ལྷའི་རྒྱལ་མོ་མ་པང་གཡུའི་མཚོ་མོ།",
    "རྒྱལ་བུ་མཆེདཀྱི་ཡུམ་ཆེན་མོ་གསོན་མཛོད།",
    "ལུས་ངག་ཡིད་གསུམ་ཐ་མལ་གྱི་ཞེན་པ་སྤོངས་ལ་ལྷ་མོ་ཡི་གེ་དྲུག་མའི་སྐུ་གསུང་ཐུགས་སུ་བསྒོམས་ལ།",
    "ལྷ་མོ་ཡི་གེ་དྲུག་མའི་སྐུ་གསུང་ཐུགས་སུ་འགྱུར་རོ།",
    "ཡུམ་ཆེན་མོ་ལྟ་སྒོམ་སྤྱོད་པ་གསུམ་དང་མ་བྲལ་བར་མཛོད།",
    "ཕྱི་མ་ལ་འཚེར་མི་དགོས་ལྷ་མོ་ཡི་གེ་དྲུག་མའི་སྐུར་གྱུར་ནས་ནུབ་ཕྱོགས་པདྨ་ཅན་དུ་པདྨ་ལ་རྫུས་ཏེ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཞེ་སྡང་ཤས་ཆེ་བས་ཉོན་མོངས་པ་རགས།",
    "དུག་ལྔ་རང་དགར་སྤྱད་པས་ངན་སོང་དུ་ལྷུང་ངེས་ཀྱང་ཕྱི་མ་ལ་མི་༡༩༦ན་འཇིགས་པར་ད་ལྟ་ཡན་ཆད་ངལ་བ་དོན་མེད་མང་དུ་བྱས།",
    "ད་འགྲོ་བ་རིགས་དྲུག་གིས་མི་འཇིགས་པའི་སྐྱེལ་མ་ལྷ་ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོའི་གདམས་པ་ཟབ་པ་ཅིག་ཞུ་འཚལ་ཞེས་ལུས་ངག་ཡིད་གསུམ་གུས་པས་ཞུས་པས།",
    "བལ་མོ་བཟའ་བུད་མེད་ཉོན་མོངས་པ་རགས་པས་དུག་ལྔ་རང་སར་གྲོལ་དགོས།",
    "བལ་མོ་བཟའི་ཐུགས་འཚེར་མི་འཚལ།",
    "འགྲོ་དྲུག་གི་གཡང་ས་ལ་མི་འཇིགས་པའི་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་པ་ལ་དོན་གསུམ་སྟེ།",
    "རང་སྐད་ཅིག་གིས་ཐུགས་རྗེ་ཆེན་པོར་བསྐྱེད་ལ་ལྷར་གསལ་བ་དེ་ཡང་སེམས་ཀྱི་ལྷ་ཡིན་པས་ལོག་ནས་སྒྲུབ་པ་མི་བྱའོ།",
    "རྟེན་གྱི་གང་ཟག་བུད་མེད་ཡིན་ན་ལྷ་མོ་ཁྲོ་གཉེར་ཅན་མར་སྒོམ།",
    "ཐབས་ཤེས་གཉིས་སུ་མེད་པ་བདེ་བ་ཆེན་པོ་རང་བྱུང་གི་རོལ་པ་དུས་གསུམ་འདུ་འབྲལ་མེད་པ་ཡིན་ནོ།",
    "མོ་ཐམས་ཅད་ཡི་གེ་དྲུག་མ།",
    "དེ་ལྟར་ཉམས་སུ་བླངས་པས་འགྲོ་དྲུག་གི་སྐྱེ་གནས་ཐུགས་རྗེ་ཆེན་པོའི་ཞིང་ཁམས་སུ་འགྲོལ་བར་གདོན་མི་ཟའོ།",
    "བལ་མོ་བཟའ་ཁྲི་བཙུན་གྱིཐུགས་ལ་དེ་ལྟར་ཞོག་ཅེས་ལྟ་བ་ཨ་ཏི་ཡོ་ག།",
    "གདམས་པ་འདི་ཟབ་མོ་རང་ཡིན་ནམ་མིན་སྙམ་པའི་ཐེ་ཚོམ་མ་ཟ་བར་བློ་ལྟེངས་སུ་ཡིད་ཆེས་ལྷང་བ་བསྐྱེད་ལ།",
    "དར་ཟབ་རེ་འབྲི་གྱོན་ཡང་ཤི་ཚེ་མི་གཙང་རོ་གོས་ཡིན།",
    "ཕ་མ་བུ་ཁྱོས་མི་སྟོངས་རང་ཉིད་གཅིག་པུར་འཆི།",
    "དེ་དང་མཉམ་པའི་སྐུ་ཅིག་བདག་གིས་ཐོབ་པར་བྱས་ལ།",
    "ཧྲཱི་དེ་ཡོངས་སུ་གྱུར་པ་ལས་པདྨ་དཀར་པོར་བསམ་མོ།",
    "བུད་མེད་ཡིན་ན་ཡི་གེ་དྲུག་མའམ་སྒྲོལ་མར་བསྒོམས་ལ།",
    "དེ་ནས་ལྷ་འོད་དུ་ཞུ་ནས་བདེ་སྟོང་གི་ངང་ལ་ལྷན་གྱིས་བཞག་གོ།",
    "དེ་ལ་ཡིད་ཇི་ཙམ་གནས་ཚད་དུ་བསྒོམ་མོ།",
    "ཀྲི་ཡ་ཡིན་པས་ལུས་ཁྲུས་དང་གཙང་སྦྲ་ལ་བརྟེན་ཁ་བཀྲུ་བ་ལ་སོགས་པ་བྱ་སྟེ་ངག་གི་ཁ་ན་མ་ཐོ་བ་སྤང་ངོ།",
    "ཡིད་གཙང་སྦྲ་ཉོན་མོངས་པ་དང་རྣམ་པར་རྟོག་པའི་ཁར་མི་བཏང་ངོ།",
    "དེ་ལྟར་ཞག་རེ་ལ་ཐུན་བཞི་ལ་སོགས་པ་སྒོམ།",
    "རྒྱ་མོ་ལྷ་གཅིག་ཀོང་ཇོ་ཤིན་ཏུ་དགྱེས་ཏེ་དྲིན་དུ་གཟོ་ནས།",
    "རྗེ་ལྷ་ཞལ་གདམས་ཟབ་དོན་ཆུང་ཚོའི་སྐོར།",
    "གཅིག་ལགས་བདག་ནི་བུད་མེད་ཀྱི་ལུས་བླངས་པས་དད་པ་ཆུང་དུག་ལྔ་རགས།",
    "ཉོན་མོངས་པ་མ་སྤེལ་བར་རང་ཞི་ལ་ཞོག།",
    "ཆད་པ་མེད་པ་སྲོག་གི་གདམས་ངག་དང་།",
    "ཇོ་མོ་རུ་ཡོངས་བཟའ་རྒྱལ་མོ་བཙུན་གྱིས་རང་གི་གསེར་དངུལ་གྱི་རྒྱན་བཀྲོལ་ནས་མཎྜལ་བྱས།",
    "བདག་ལ་ཐུགས་རྗེ་ཆེན་པོའི་སྔགས་ཀྱི་ལུགས་ཚེ་གཅིག་གིས་སངས་རྒྱ་བ་ཅིག་ཞུ་འཚལ་ཞེས་གསོལ་པས།",
    "དད་༡༩༩བ་པ་སྐྱེས་ནས་གདམས་པ་ཞུ་བ་ལེགས་པས་ཉོན་ཅིག་རྒྱལ་མོ་བཙུན།",
    "མོང་བཟའ་ཁྲི་བཙུན་ལྕམ་ཞེས་བྱ་བ་རྒྱལ་བུ་གུང་སྲོང་གུང་བཙན་གྱི་ཡུམ་གྱིས་ཞུས་པ།",
    "སྐྱེ་བ་དམན་གོ་བ་ཆུང་ཉོན་མོངས་པ་རགས།",
    "བདག་ལ་ཐུགས་རྗེས་གཟིགས་ལ་ངན་སོང་གི་སྒོ་ཁེགས་པ།",
    "ཁྲི་ལྕམ་ཉོན་ཅིག་རང་གི་མདུན་གྱི་ནམ་མཁའ་ལ་ལྷ་ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོ་བསྒོམས་ལ།",
    "ནམ་མཁའིཐུགས་རྗེ་ཆེན་པོ་དེ་བདག་ལ་ཐིམ་པར་བསམ་མོ།",
    "ངན་སོང་གསུམ་གྱི་སྒོ་ཆོད།",
    "རྩ་བའི་ཕྱག་བཅུ་ཉིང་ལག་སྤྲུལ་པའི་ཕྱག་སྟོང་དང་ལྡན་པར་བསྒོམ་མོ།",
    "དེ་ཡང་དོན་དམ་པར་ལྷ་དེ་ལོགས་ནས་སྒོམ་སྒྲུབ་བྱར་ཡོད་པ་མ་ཡིན་བསྒྲུབས་པས་གྲུབ་པ་ལྟ་བུ་མ་ཡིན་ཏེ་རང་གི་སེམས་ཀྱི་སྣང་བ་ཡིན།",
    "ཡེ་ནས་རང་ལ་གནས་པ་ཡིན་པས་དེ་དག་གི་དོན་རྟོགས་ཙམ་ན་ཐུགས་རྗེ་ཆེན་པོའི་ཞལ་མཐོང་ངོ་ཤེས་པ་ཡིན་ནོ།",
    "ཞལ་གདམས་ཟབ་དོན་ཆུང་ཚོའི་སྐོར།",
    "རྒྱལ་བུ་ལྷ་སྲས་ལགས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་རྫོགས་ནས་འགྲོ་དྲུག་གི་སྐྱེ་སྒོ་གཅོད་པ།",
    "འགྲོ་བ་རིགས་དྲུག་གི་སྐྱེ་གནས་ཐུགས་རྗེ་ཆེན་པོའི་ཞིང་ཁམས་སུ་གྲོལ་བར་ཐེ་ཚོམ་མེད་དོ།",
    "འཇིག་རྟེན་གྱི་སྤྱན་གཟིགས་སྣ་ཚོགས་དྲངས་ཏེ་ཕྱག་དང་བསྐོར་བ་བྱས་ནས།",
    "བདག་བུད་མེད་དུ་སྐྱེས་པས་སྐྱེ་བ་དམན་པས།",
    "སེམས་ཉིད་རིག་པ་རང་བྱུང་འདི་ངོ་ཤེས་ན་བུད་མེད་མ་མ་ཎི་བཀའ་འབུམ།",
    "ཞལ་གདམས་ཤིན་ཏུ་ཟབ་པ་ནང་གི་འཁོར་དགུ་གདམས་པའོ།",
    "ཞལ་གདམས་ཟབ་དོན་ཆུང་ཚོའི་སྐོར།",
    "ཉོན་མོངས་པ་བརྒྱད་ཁྲི་བཞི་སྟོང་ཡང་འབྱུང་པོ་ངར་འཛིན་གྱི་ཤེས་པར་འདུས།",
    "ང་བདག་གི་རྩ་བ་བདག་མེད་ཡིན།",
    "ཅིར་ཡང་མ་གྲུབ་གང་གི་ཡང་ངོས་གཟུང་མེད་པར་འདུག་པ་དེ་ཀ་རྟོགས་པ།",
    "ཇི་ལྟར་འཛིན་པ་དེ་ལྟར་ཀུན་ནས་ཉོན་མོངས་བསྟན།",
    "བདག་དང་བདག་གིར་མི་དམིགས་རྣམ་པར་བྱང་བར་གསུངས།",
    "འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་སྤྲུལ་པ་རྗེ་མངའ་བདག་ཆེན་པོ་ལགས།",
    "ཉག་གཅིག་ནི་སྟོང་གསལ་གཉིས་མེད་རང་བྱུང་གི་ཡེ་ཤེས་ཡིན།",
    "རྣམ་རྟོག་གི་འགྱུ་བྱེད་འདི་སེམས་ཡིད་ཀྱིས་སྐྱེད་པ་ཡིན་པས་རང་གྲོལ་དུ་བཞག་གོ།",
    "རང་གི་སེམས་ཉིད་ཐུགས་རྗེ་ཆེན་པོའི་ངོ་བོར་གནས་སོ།",
    "རང་བྱུང་རང་གསལ་དེ་རང་གིས་ངོ་ཤེས་པར་བྱས་ནས།",
    "ཡིད་ཐ་མལ་དུ་མི་བཞག་སེམས་བདེ་སྟོང་གི་ངང་ལ་བཞག་མ་ཎི་བཀའ་འབུམ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་གསུང་ཐུགས་དང་རང་གི་ལུས་ངག་ཡིད་གསུམ་གཉིས་སུ་མེད་པར་ཡེ་གདོད་མ་ནས་གནས།",
    "ཟབ་མོ་སྤྱོད་པའི་ལྟ་སྒོམ་སྤྱོད་པ་གསུམ་ལ།",
    "ཚེ་འདི་ལ་བློ་མ་ལོག་ངན་སོང་ལས་འགྲོ་ས་མེད་པས།",
    "དེ་ནས་ལྷ་ཐུགས་རྗེ་ཆེན་པོ་མདུན་གྱི་ནམ་མཁའ་ལ་བསམས་ལ་མོས་པ་དང་གུས་པ་ཆེན་པོ་བསྐྱེད་ལ།",
    "བདག་གིས་གནམ་རི་སྲོང་བཙན་གྱི་བཀའ་མ་བཅག།",
    "དགེ་སྡིག་ཏུ་འཛིན་མཁན་རང་གི་སེམས་ཡིན་ནོ།",
    "སེམས་སྟོང་པ་ཉིད་དེ་ལ་དགེ་སྡིག་གིས་མ་གོས་དག་པར་ཤེས་པར་གྱིས།",
    "ལྷ་ཐུགས་རྗེ་ཆེན་པོ་ལ་སྐྱབས་སུ་སོང་།",
    "ངན་སོང་སྐྱེ་སྒོ་བཅད།",
    "ནང་གི་བློན་པོ་མགར་སྟོང་བཙན་ཡུལ་ཟུངས་ཀྱིས།",
    "རྟ་མོག་རོ་གཡུ་སེང་ལ་དར་གྱི་སྟན་ཟ་འོག་སྣ་ཚོགས་རིས་བསྟད།",
    "གཡོ་ཁྲམ་སྡིག་ལས་སུ་སོང་བས།",
    "རྗེས་བཀའ་སྩལ་པ་སྟོང་ཞལ་གདམས་ཟབ་དོན་ཆུང་ཚོའི་སྐོར།",
    "དང་པོ་རྟེན་གྱི་སྟོབས་ནི་ཐུགས་རྗེ་ཆེན་པོ་མདུན་གྱི་ནམ་མཁའ་ལ་སྤྱན་དྲོངས་ལ་མོས་གུས་ཀྱི་གདུང་བ་ཆེར་གྱིས་ཤིག།",
    "ༀམ་ཎི་པདྨེ་ཧཱུཾ་ཞེས་བཟླས་པས་བྱེ་མ་ལ་ཆུ་བརྒྱབ་པ་ལྟར་ཧ་ར་ར་སོང་ནས་ཟད་པར་བསམ་མོ།",
    "བདག་གི་ལུས་ངག་ཡིད་གསུམ་ལ་ཕོག་པས།",
    "ངན་སོང་གི་སྐྱེ་སྒོ་གཅོད།",
    "ལྷ་གཅིག་ལགས་བདག་འཆི་བ་ལ་ནི་འཇིགས་པས་ཕྱི་མ་ལ་ངན་སོང་དུ་མི་ལྷུང་བར།",
    "རྗེའི་ཞལ་ནས་སེ་རུ་གུང་སྟོན་ཁྱོད་ཁོ་བོ་རྒྱལ་པོ་ཡིན་སྙམ་ན།",
    "ང་ནི་ཐུགས་རྗེ་ཆེན་པོ་སྤྱན་རས་གཟིགས་དངོས་ཡིན་ནོ་གསུངས་ནས་དབུའི་དར་ཐོད་བཤུས་ཏེ་ཞལ་བཅུ་གཅིག་དངོས་སུ་བསྟན་ནས།",
    "ངན་སོང་དུ་སྐྱེ་དོགས་མེད་ཀྱིས་གསུངས་ནས་སྐུ་ལས་འོད་ཟེར་གྱི་བཀྱེ་སྟེ་སེ་རུ་གུང་སྟོན་ལ་ཕོག་པས།",
    "ཐུན་མོང་གི་ཟབ་དོན་ཞལ་གདམས་ལྔ།",
    "གཅིག་པུར་འདུག་ན་རང་གི་སེམས་ལ་བལྟ།",
    "རང་གི་མགོ་ལུས་ལ་སྐྲ་དཀར་དང་གཉེར་མ་བྱུང་བ་དང་ཁའི་སོ་བུད་པ་དང་།",
    "ལ་རིགས་དྲུག་གི་གཡང་ས་གཅོད་པ།",
    "སེམས་ཐ་མལ་གྱི་ཡིད་ཉོན་མོངས་པ་ཐམས་ཅད་རང་གསལ་རང་གྲོལ་དུ་བསྒོམས་པས་དེ་ལུས་སྐུར་གྲོལ།",
    "ཡིད་ཐུགས་སུ་གྲོལ་དེས་ཚེ་འདིར་ཐུན་མོང་གི་དངོས་གྲུབ་ཐོབ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ཡོན་ཏན་གྱི་སྒོ་ནས་སྐལ་ལྡན་སྤྲོ་བ་བསྐྱེད་པ་དང་གསུམ་མོ།",
    "དང་པོ་རྒྱུན་གྱིས་མི་རྟག་པ་ཆུ་བོའི་རྒྱུན་ལྟ་བུ་ནི་ཚེ་སྐད་ཅིག་མར་རྒྱུན་མཐུད་པས་ཉིན་དང་མཚན་མོ་ཞག་དང་ཟླ་བས་ལོ་སོང་ནས་འཆི་བ་ལ་ཉེར་སོང་ནས་མི་ཞལ་གདམས་ཟབ་དོན་ཆུང་ཚོའི་སྐོར།",
    "དང་པོ་བྱ་སླ་སྟེ་དཀའ་ཐུབ་ཀྱིས་ངལ་དུབ་བྱ་མི་དགོས་པར་འགྲོ་འཆག་ཉལ་འདུག་གི་དུས་ཐམས་ཅད་དུ།",
    "བསམ་གཏན་གྱི་མཁར་ནི་གཡེང་བའི་དམག་གིས་ཕབ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་དོན་དང་བྲལ་ནས་འདུག་པ་གཟིགས་སམ།",
    "པད་བཟོད་པའི་ཕ་རོརོལ་ཏུ་ཕྱིན་པ་སྡུག་བསྔལ་བདེ་བའི་གནས་སུ་༢༩བ་བསྒྱུར་བས་ཉོན་མོངས་པ་ཁོང་ཁྲོ་གནས་སུ་དག་པར་བྱེད།",
    "ཧཱུཾ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཕྱོགས་མེད་ཆགས་སྡང་ལས་གྲོལ་བས་ཉོན་མོངས་པ་སེར་སྣ་གནས་སུ་དག་པར་བྱེད།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་ཞལ་གདམས་སྒྲི།",
    "སྤྲུལ་པས་འགྲོ་འོང་གི་བྱ་བ་བྱས་ཀྱང་དོན་ལ་བྱེད་པ་མེད་པ་ལྟར།",
    "ཞལ་གདམས་ལྔ་པོ་དེ་ཐུན་མོང་གི་ཟབ་དོན་ལྔའོ།",
    "སྡུག་བསྔལ་གྱི་རྩ་བ་ཉོན་མོངས་ཀྱི་སྣོན་པ་འཁོར་ཞལ་གདམས་ཟབ་དོན་ཆུང་ཚོའི་སྐོར།",
    "ངག་དབེན་པས་བྲེ་མོའི་གཏམ་གྱི་བར་ཆད་མི་འོང་།"
  ]
}