    "ཁྱོད་ཡིད་ཆེས་པར་མི་འགྱུར་ལ།",
    "མདུན་ན་འདོན་ཐོག་མར་ཁྱེད་རང་གི་སེམས་ལ་སོ་སོར་རྟོག་ལ།",
    "ཞེས་བྱ་བ་ནི་དཔལ་ཨོ་རྒྱན་གྱི་ཡུལ་དེ་ཉིད་ན་ཞིང་པ་པདྨ་རྡོ་རྗེ་ཞེས་བྱ་བ་སྔ་ནས་བདག་དང་བདག་གིར་འཛིན་པ་ཤས་ཆུང་བ།",
    "དེས་དུས་གཞན་ཞིག་ན་སཱ་ལུའི་ཞིང་རྨོས་པ་ལས་ཞིང་གི་ལས་ཀྱིས་སུན་པར་གྱུར་ཅིང་སྐྱོ་བ་ཤས་ཆེར་སྐྱེས་ནས།",
    "དེའི་ལྷག་པའི་བསམ་པ་རྒྱ་ཆེན་པོ་དེ་རྣལ་འབྱོར་པ་མདུན་ན་འདོན་གྱིས་མཁྱེན་ཞིང་སྐལ་བ་དང་ལྡན་པར་གཟིགས་ནས།",
    "ཞེས་བསྒོས་ནས་རང་གི་རྣལ་འབྱོར་གྱི་གནས་སུ་སོང་བར་གྱུར་ཏོ།",
    "གསང་སྔགས་ཀྱི་ཚུལ་གྱིས་སྤྱོད་པ་སྤྱད་པའི་རྣལ་འབྱོར་པ་དང་རྣལ་འབྱོར་མ་གྲུབ་པ་བརྙེས་པ་འབའ་ཞིག་གིས་ཡོངས་སུ་གང་བར་མཐོང་སྟེ།",
    "ཁོ་མོ་ནི་རྟག་པར་འཇིག་རྟེན་གྱི་བྱ་བ་འཆོར་བར་བྱེད་པའི་ཆང་འདི་ལ་ལོངས་སྤྱོད་ཅིང་།",
    "ཁོ་མོས་ཀྱང་རྣལ་འབྱོར་པ་འགའ་ཞིག་ལས་ཆང་དེ་བཙལ་ལ་ལོངས་སྤྱོད་ཅིང་།",
    "ཁོ་མོ་ལ་ལྷན་ཅིག་སྐྱེས་པའི་ཆང་གི་རོ་བསྟན་དུ་གསོལ།",
    "དེའི་སེམས་རྒྱ་ཆེན་པོ་དེ་དག་རྣལ་འབྱོར་པ་པདྨ་རྡོ་རྗེས་མཁྱེན་ཞིང་ཕྱག་རྒྱ་ཆེན་པོའི་འབྲས་བུ་མངོན་དུ་བྱེད་པར་གཟིགས་ནས།",
    "སྐྱེས་བུ་ཆེན་པོ་ཁོ་མོ་ལ་ལྷན་ཅིག་སྐྱེས་པའི་བཏུང་བ་བསྟན་དུ་གསོལ།",
    "ཁྱོད་ཀྱི་མྱོང་ཞིང་སྐོམ་པ་ལས་སེལ་བར་འགྱུར་རོ།",
    "དེ་དག་གི་ཞབས་ལ་བསྙེན་བཀུར་བྱེད་ན་ཅི་མ་རུང་།",
    "ཐ་ག་པ་ཁྱོད་ཀྱི་བསམ་པ་རྒྱ་ཆེན་པོ་དེ་མཆོག་ཏུ་ལེགས་སོ།",
    "སྐྱེས་བུ་ཁྱོད་ཀྱི་བསམ་པ་རྒྱ་ཆེན་པོ་ཁོ་མོས་མྱུར་དུ་བསྐང་བར་བྱའོ།",
    "རྡོ་རྗེ་དང་ལྡན་བྲམ་ཟེ་མོ།",
    "བྲམ་ཟེ་མོ་དེ་རྗེས་སུ་གཟུང་བར་བཞེད་དེ།",
    "བྲམ་ཟེ་མོ་དེའི་འཇུག་ངོགས་སུ་ཐ་ག་པ་དེ་སོང་བ་དང་།",
    "བྲམ་ཟེ་མོ་དེའང་དེ་ན་ཁྲུས་བྱེད་པ་དང་འཕྲད་དེ།",
    "བྲམ་ཟེ་མོ་དེ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཅི་བྲམ་ཟེ་མོ་ཁྱོད་དེ་ལྟར་ཁྲུས་བྱས་པས་ཕྱིའི་དྲི་མ་འབའ་ཞིག་དག་པར་བལྟའམ།",
    "བྲམ་ཟེ་མོས་སྨྲས་པ།",
    "བྲམ་ཟེ་མོ་ཁྱོད་ཀྱི་ཁྲུས་ཀྱིས་ཕྱིའི་དྲི་མ་འདག་པ་ལ་ནི་ཁོ་བོ་མི་འགེགས་ཀྱི།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ཕྱིའི་ཁྲུས་ཀྱིས་ནང་གི་བདག་ཉིད་ཅན་ཡང་འདག་པར་འདོད་པར་བལྟ་ན་ནི་ཁོ་བོས་འདག་པར་མི་འདོད་དེ།",
    "གཞན་ཡང་སཱ་ལུའི་ས་བོན་ལས་ནི་སཱ་ལུ་ཉིད་འབྱུང་གི།",
    "བྲམ་ཟེ་མོ་དེ་བཞིན་དུ་ཉོན་མོངས་པའི་གཞི་ལས་ཉོན་མོངས་པ་ཉིད་སྐྱེའི།",
    "བྲམ་ཟེ་མོས་སྨྲས་པ།",
    "འོ་ན་གང་གིས་ནང་གི་བདག་ཉིད་ཅན་འདག་པར་འགྱུར་བའི་ཁྲུས་དེ་ཁོ་མོ་ལ་བསྟན་དུ་གསོལ།",
    "གང་ལུས་དང་ངག་གིས་འབད་པ་མེད་པའི་ཁྲུས་ཀྱིས་དག་པར་གྱིས་ཤིག་དང་།",
    "ཁྱོད་ཀྱི་ཕྱི་ནང་མ་ལུས་པ་འདག་པར་འགྱུར་རོ།",
    "སྐྱེས་བུ་ཆེན་པོ་དེ་ལྟ་བུའི་ཁྲུས་དེ་ཁོ་མོས་མི་འཚལ་གྱི།",
    "ཞེས་སྨྲས་ནས་སྙིམ་པ་མེ་ཏོག་གིས་བཀང་སྟེ།",
    "བྲམ་ཟེ་མོ་ནམ་མཁའ་ཡོངས་སུ་དྭངས་པའི་དབྱིངས་ལས་སྤྲིན་དག་བྱུང་ནས་དེ་ཉིད་དུ་ཐིམ་པའམ།",
    "ཆུ་ཀླུང་ཡོངས་སུ་དྭངས་པ་ལས་ཉ་དག་བྱུང་བ་ཅི་ལྟ་བ་བཞིན་དུ་བྲམ་ཟེ་མོ་ཁྱོད་ཀྱིས་སེམས་ལ་བལྟ་བར་གྱིས་དང་།",
    "ཞེས་བསྒོས་ནས་རང་གི་གནས་སུ་དོང་བ་དང་།",
    "བྲམ་ཟེ་མོ་དེའི་ཚུལ་ནི་དེ་འདྲའོ།",
    "བྲམ་ཟེ་མོ་རྡོ་རྗེ་ཞེས་བྱ་བའི་རྣལ་འབྱོར་མ་ཞིག་ཡོད་པར་ཐོས་ནས།",
    "དེ་ལ་གསོ་སྦྱོང་གི་སྡོམ་པ་བྱིན་ཏེ།",
    "དེའི་སེམས་ཀྱི་མོས་པ་དང་ལྷག་པའི་བསམ་པ་རྒྱ་ཆེན་པོ་རྣལ་འབྱོར་མ་དེས་མཁྱེན་ནས།",
    "དཔལ་མོ་བདག་གིས་རྒྱལ་སྲིད་ཀྱི་འབྱོར་པ་སྤོང་བ་ལ་བཀོད་དེ།",
    "དེས་ཀྱང་རྒྱལ་སྲིད་ཀྱི་འབྱོར་པ་མཆིལ་མའི་ཐལ་བ་ལྟར་བོར་ནས།",
    "དུས་དེ་ན་ཁོ་མོ་དཔལ་གྱི་རི་ཞེས་བྱ་བ་ལ་གནས་པ་དང་།",
    "དཔལ་མོ་ལྟོས་ཤིག་ས་བདག་ལྟོས།",
    "ཁོ་མོའི་རྐང་པར་དེས་གཏུགས་ནས།",
    "དེ་ལ་ཁོ་མོས་འདི་སྐད་ཅེས།",
    "དགེ་སློང་གི་དངོས་པོ་ཡོངས་སུ་ཟུགས་ཤིག་ཅེས་བསྒོས་པ་ཡིན་ན།",
    "དགེ་སློང་དེས་ཁོ་མོ་ལ་འདི་སྐད་ཅེས།",
    "སྲིང་མོ།",
    "བདག་གིས་ནི་རྒྱལ་སྲིད་མཆིལ་མའི་ཐལ་བ་ལྟར་བོར་བ་ལགས་ཀྱིས་ཀྱང་།",
    "དེ་ལ་བདག་གིས་ཇི་ལྟར་བསྒྲུབ་པར་བགྱི་བ་གསུངས་ཤིག།",
    "ཁོ་མོས་དེ་ལ་དུར་ཁྲོད་དུ་སོང་ལ་དེ་ཉིད་ཡིད་ལ་བྱོས་ཤིག་ཅེས་བསྒོས་པ་ན།",
    "དགེ་སློང་གིས་བདག་གི་ངག་གི་རྗེས་སུ་ཞུགས་ཏེ།",
    "དེ་དག་གིས་མི་ཚོར་བའི་ཚུལ་དུ་རྐང་པ་ལ་མགོ་བོས་གཏུགས་ནས།",
    "གཙུག་ལག་ཁང་ལ་ལྟོས་པ་མེད་པར་དུར་ཁྲོད་དུ་སོང་སྟེ།",
    "རྒྱལ་པོའི་བཙུན་མོའི་ཚོགས་སྔགས་འཆང་མ་རྣམས་ཀྱིས་དགེ་སློང་དེའི་སེམས་ཀྱི་ལྷག་པའི་བསམ་པ་བརྟན་ནམ།",
    "རྒྱལ་པོས་བཙུན་མོ་རྣམས་མཐོང་བས་མྱ་ངན་གྱིས་གདུངས་ནས།",
