    "གང་དག་ད་ལྟར་བཞུགས་པའི་དེ་བཞིན་པ་སྟོ་རྫོ་པ་པ་ད་པ་བ་པ་པགཤེགས་པ་དང་ཉན་ཐོས་དང་རང་སང་ས་རྒྱས་དེ་དག་ཐམས་ཙད་ཀྱང་ཡོང་ས་སུ་མྱ་ང་ན་ལས་འད་འོ།",
    "དེའི་ཚེ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བཅོམ་ལྡན་འདས་ཀྱི་ཕངས་༡ན་གཟིམས་ཁྲི་ལ་བསྙེས་ནས་ངུས་ཏེ་༢མཆི་མ་བྱུང་སྨྲེ་སྔགས་འདོན་ཅིང་འདུག་གོ།",
    "ཀུན་ད་གའ་བོ་གང་ང་འདུག་པ་ལ་མངོན་སུམ་དུ་བསྟི་སྟང་༤བྱེད་པ་དང་།",
    "སྲད་བུ་ཡང་མཆིལ་པ་དང་འབྲེལ་༡བར་གྱུར་ན་ཆུའི་ནང་ན་འདུག་པ་ཡང་ཡིན་ལ།",
    "ཡུ་བ་སྐམ་ལ་འདུག་ཅིང་ལེགས་པར་ཟིན་ན་ཉ་པ་དེ་འོངས་ནས་སྲད་བུ་དེས་ཉ་ཟིན་པར་ཤེས་ཏེ་དེས་སྲད་བུ་དེས་དྲ་ངས་ནས་ཇི་ལྟར་འདོད་པར་སྐམ་ལ་ཕྱུང་སྟེ་དགའ་མགུར་བྱ་བ་བྱེད་པའི་དུས་དེ་ཡོད་དོ།",
    "ས་བོན་དེ་དག་དུས་དང་ཚིགས་སུ་ཞིང་ལ་བཏ་བ་སྟེ་དུས་དུས་སུ་ཆུས་བཅུས།",
    "འདུག་གནས་རྣམས་ཕྱག་དར་བྱས་སོ།",
    "འོན་ཏེ་བྱེས་དེ་ཉིད་ན་འདུག་གམ།",
    "ཨ་ཙི་པི་༢༢ལི་ལེ།",
    "རིགས་ཀྱི་བུ་དེ་ན་ས་རྒྱལ་པོ་རྩིབས་༨ཀྱི་མུ་ཁྱུད་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་ནས།",
    "དེ་མལ་ནས་ལངས་ཏེ་རྨི་ལམ་དྲན་ཞིང་འདུག་པ་ན་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བྲམ་ཟེ་རྒྱ་མཚོའི་རྡུལ་གྱི་མདུན་དུ་འདུག་ན་ས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་རྒྱལ་པུ་གཞོན་ནུ་མྱུ་ཁྱུད་བཅོམ་ལྡན་འད་ས་ཀྱི་སྤྱན་སྔར་འདུག་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "སང་ས་རྒྱས་ཀྱི་ཞིང་དེ་ནཉན་ཐོས་དང་རང་སང་ས་རྒྱས་རྣམ་པར་སྤངས་པར་གྱུར་ཙིག།",
    "ཡོན་ཏན་བརྒྱས་བལྟམས་བདག་དུས་འདི་གསུངས་འགྲོ་ནའང་བདག་འཚང་རྒྱ།",
    "རིགས་ཀྱི་པུ་དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་སྟོབས་ཆེན་ཤུགས་འཆང་དེ་ཡང་པ་ཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ་གསོལ་པ།",
    "དེ་ན་འཚོ་བ་པ་མི་འགྱུར་འཇིགས་བྱེད་ཅེས་བྱ་བ་གཅིག་ཅིག་འདུག་པ་དེས་སྨྲས་པ།",
    "དེ་ནས་བྲམ་ཟེ་སྐར་མ་ལ་ད་གའ་བ་ཞེས་བྱ་བ་དེ་རྒྱལ་པོ་ནམ་མཁའི་མདུན་དུ་འདུག་སྟེ་སྨྲས་པ།",
    "རྡོ་རྗེའི་གདན་ལ་འདུག་པར་བྱ་བ་ད་ང་པདུད་བཞི་གཞོམ་པར་བྱ་བ་དང་།",
    "རྨོད་པ་དེས་ཐུག་ཆངས་འོག་ཏུ་སྦས་ནས་འདུག་པ་ལ་བསླངས་པས་མ་སྟེར་བར།",
    "གསུང་འདི་དག་ལ་དཔགས་ན་དུས་སྐབས་བཟང་པོ་དེ་དག་ཏུ་ཡང་བླུན་པོས་ཤེས་ལྡན་ལ་གཤེ་བ་འདི་ཡོད་ཚོད་དུ་འདུག་གོ།",
    "ད་ང་རང་ཡང་རྒྱ་གར་དུ་འགྲོ་དགོས་དགོངས་པའི་ཐུགས་སྐྱེས་ཏེ་རང་ཡུལ་དུ་བྱོན།",
    "ཐ་མལ་དུ་འདུག་ཀྱང་ཉམ་ང་མེད།",
    "བ་སྤང་བར་ནན་ཏན་ཆེར་བྱས་ཚེ་མའོ་འདུགགེས་བྱ་བ་བྱེད་དུ་གཞུག་པ་ཡང་ངོ།",
    "མུ་འདུག་ལ་སོགས་པའི་དྲང་སྲོང་མ་ཡིན་གྱི།",
    "ས་འདི་རྣམས་ལྟར་འདུག་པ་རས་རབ་ཏུ་མ་བྱུང་།",
    "གསུམ་ཕན་ཆད་ནི་ཁ་རོག་སྟེ་འདུག་གོ།",
    "གལ་ཏེ་སྔོན་གྱི་གྲལ་གང་བབ་པར་འདུག་ལ།",
    "དགེ་སྦྱོར་གྱི་བར་ཆད་དུ་འགྲོ་བར་གདའ་བས",
    "རྩ་བ་དམར་བ་རྣམས་ཀྱིས་ཤིང་སཱ་ལ་ཟུང་ཉི་མ་འཆར་ཀའི་འོད་ཟེར་སེར་པོ་ཇ་ཧོང་ཁར་འདུག་པ་བཞིན་དུ་བྱས་ནས།",
    "ས་ཕྱོགས་དེ་དག་དེ་ལྟར་དགའ་དགའ་ལྟར་འདུག་ཀྱང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་མ་བཞེས་ནས་ལངས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བདེ་བ་དང་ལྡན་ཞིང་དགའ་དགའ་ལྟར་འདུག་ལ།",
    "དེ་ནས་ལ་ལ་ཞིག་ཕ་མ་གཉིས་ཤི་བ་ལས་ཕྱིར་སོས་ཏེ་གསོན་པོར་འདུག་པ་མཐོང་ན་མཆོག་ཏུ་དགའ་བར་གྱུར་པ་དེ་ཁོ་ན་བཞིན་དུ་མགར་བའི་བུ་སྐུལ་བྱེད་དེ་མཆོག་ཏུ་དགའ་བར་གྱུར་ནས་ལག་པ་བརྐྱང་སྟེ།",
    "སྲིད་པ་དག་ན་འགྲོ་ཀུན་སྲོག་ཏུ་འདུག།",
    "དེ་ནས་སྐུལབྱེད་ཅང་མི་ཟེར་བར་འདུག་གོ།",
    "གཞན་ཡང་ཇི་ལྟར་ནམ་མཁའ་ལ་བྱའི་རྗེས་གདའ་མི་སྲིད་པ་དེ་བཞིན་དུ་བདག་མ་མཆིས་པའི་འདུ་ཤེསབསྒོམས་ན་ལྟ་བའི་རྣམ་པ་ཐམས་ཅད་དང་བྲལ་བར་འགྱུར་ལགས་སོ།",
    "རྫིང་བུ་དེའི་ཆུ་ཡང་ནོར་བུའི་འོད་ཀྱིས་ཟླ་བའི་འོད་བཞིན་དུ་མཛེས་པར་འདུག་སྟེ།",
    "ངས་ལེགས་པར་གསུངས་པས་ཁྱེད་རངས་པར་བྱའོ།",
    "གཅིག་ནི་གསོན་པོར་འདུག་སྟེ།",
    "ཇི་ལྟར་གདའཇི་ལྟར་སྣང་།",
    "འདི་ན་དགེ་སློང་ལ་ལ་མལ་སྟན་སར་པ་ལ་འདུག་ཅིང་དེ་ཟན་ཟོས་ནས་གཅིག་པུ་ཕྱོགས་གཅིག་ན་མི་སྨྲ་བར་འདུག་སྟེ།",
    "ཤ་ཟ་བ་ནི་འགྲོ་ཡང་རུང་འདུག་ཀྱང་རུང་སྟེ།",
    "ཆ་ལུགས་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "ལྷ་དང་རང་བགྱི་བདུད་ཕམ་པར་བྱས་ནས་བདུད་རྩིའི་མཆོག་རྟོགས་སོ།",
    "མྱ་ངན་འདས་པདྲུང་ཁོ་ན་ན་འདུག་གོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་ཁྱིམ་བདག་གདངས་ཅན་ལས་གླེངས་ཏེ་བདུད་ཚར་གཅོད་པ་ན་བཀའ་སྩལ་ལགས་ན།",
    "གང་ཟག་བཞི་པོ་འདི་རྣམས་ཀྱི་ནང་ནས་གཅིག་ཙམ་ཞིག་འདུག་ན་ཡང་དེ་ལ་མགྱིས་ཤིག།",
