    "དེས་ན་འདི་དག་གི་དག་པ་གསུངས་ཤིག་ཅེས་བྱ་བར་དགོངས་སོ།",
    "རིགས་ནི་གང་གི་ཕྱིར་མཆོག་གི་དངོས་གྲུབ་སྟེར་བས་སོ།",
    "གང་གསུངས་པ་ཞེས་པ་བྱ་བ་ནི་ཨ་ནས་ཨཾ་གི་མཐར་ཐུག་པའོ།",
    "མུ་མུ་ཎི་ནི་ཞིང་གི་ཁྱད་པར་རོ།",
    "མ་མོ་རྣམས་ཀྱི་ཞེས་པ་ནི་བཅོམ་ལྡན་འདས་མ་བདག་མེད་མ་ལ་སོགས་པ་གཟུགས་ཀྱིས་ཀྱང་ཞེས་པའི་དོན་ཏོ།",
    "ཕྱི་རོལ་ཚལ་དུ་ཡང་ཞེས་པ་ནི་ཡང་གི་སྒྲས་ནམ་མཁའ་ལ་ཡང་ངོ།",
    "གང་གི་རྟགས་ཤེ་ན།",
    "རེ་རེ་ཞེས་པ་ནི་རྣལ་འབྱོར་མའི་གོ་རིམས་ཇི་ལྟ་བར་རོ།",
    "བུད་མེད་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འདི་རྣམས་ཞེས་པ་ནི་གཟུགས་དང་ཚོར་བ་དང་མིག་དང་།",
    "གང་གི་ཕྱིར་རྟོག་པ་མེད་པ་༢༨༥ཨ་སྟེ།",
    "འདི་དག་གིས་ནི་ག་བུར་མི་སྤང་ཞེས་བྱ་བ་བསྟན་ཟིན་ཏོ།",
    "ཧེ་རུ་ཀའི་རང་བཞིན་ཧཱུྃ་གི་རྣམ་པའོ།",
    "དེ་དང་ཞེས་པ་ནི་གང་གི་ཕྱིར་དེ་ཉིད་ཐམས་ཅད་རིག་པའོ།",
    "རྡོ་རྗེ་བདེ་བ་ཞེས་པ་ནི་ལྟེ་བའི་ཨ་རྡོ་རྗེའི་རྩེ་མོར་སོང་བ་སྟེ།",
    "གསང་བ་ནི་ཨ་དང་ཧཱུྃ་དག་གིས་སྙོམས་པར་འཇུག་པའོ།",
    "ཕྱི་རོལ་གཉིས་སྤྲོས་པ་ནི་བདག་མེད་མ་དང་ཧེ་རུ་ཀའི་ལུས་དེ་དག་གི་སྟེ།",
    "འདབ་མ་བཅུ་དྲུག་གི་རྣམ་པས་སོ།",
    "སྐྱེ་གནས་ནི་སྐྱེ་གནས་ཏེ་བུད་མེད་དང་སྐྱེས་པ་དག་གི་ལྟེ་བའི་འོག་གོ།",
    "ཟླ་བའི་གནས་ཡིན་པ་ཉིད་དང་ཡན་ལག་གི་མཆོག་ཉིད་ཀྱིས་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དེ་ལྟར་ན་འབྲས་བུ་འདི་རྣམས་སུ་ཞིག་གིས་སྤྱོད།",
    "སུ་ཞིག་གིས་སྟེར་སྙམ་པ་ལ་གསུངས་པ་ལས་ཀྱིས་སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ངའི་དེ་ཉིད་ཅེས་པ་ལ་སོགས་པ་ནི་ངའི་དེ་ཁོ་ན་ཉིད་གང་གིས་ཀྱང་མི་ཤེས་པ་དག་པའི་ནམ་མཁའོ།",
    "དེ་དང་དེ་རྣམས་ནི་སྲིང་མོ་ཁྱོད་རྣམས་ཀྱི་རང་བཞིན་བཞི་པོ་ཅི་རིགས་པ་གང་ཡང་རུང་བའི་རང་བཞིན་ཁྱེད་རྣམས་ཀྱིའོ།",
    "སོ་སོ་རང་གིས་རིག་པ་དེའི་དེ་ཁོ་ན་ཉིད་མངོན་སུམ་དུ་མ་བྱས་པ་ཉིད་དོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་བུ་སྔར་མ་རྟོགས་ཤེ་ན་གསུངས་པ།",
    "དེ་དེ་བཞིན་ཏེ་ཞེས་བྱ་བ་སོགས་པ་ནི་ལྷ་མོ་རྣམས་ཀྱི་ཚིག་གོ།",
    "གཏི་མུག་རྣམས་སྤངས་པ་ནི་དུག་གི་དེ་ཉིད་ཤེས་པའོ།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཕྱིར་མི་ཤེས་པ་ནི་མ་རིག་པའོ།",
    "གཏི་མུག་ནི་ཉོན་མོངས་པའི་གཏི་མུག་གོ།",
    "སོགས་པའི་སྒྲས་ཉོན་མོངས་པ་འདོད་ཆགས་ལ་སོགས་པ་སྟེ་དེ་ཉིད་འཆིང་བའོ།",
    "རང་གི་ཞེས་བྱ་བ་ནི་སེམས་ཀྱི་སྟེ་བྱེད་པ་པོའི་དྲུག་པའོ།",
    "མེད་མོད་གང་ཡང་ལྷ་དང་ལྷ་མ་ཡིན་གྱི་ཡང་འདི་ལྟར་བདེ་བར་མི་ཤེས་པ་སྟེ།",
    "ངེས་པར་འཕགས་པ་རྣམས་ཀྱིས་ལྷ་དང་ལྷ་མ་ཡིན་བདེ་བར་མི་གཟིགས་ཏེ།",
    "གཞན་དུ་ཞེས་པ་ནི་རང་གི་སེམས་ལས་གཞན་དུའོ།",
    "རྣམ་པར་སྣང་༢༨༩ཨ་མཛད་ཅེས་པ་ནི་རྣམ་པར་སྣང་མཛད་དུ་གནས་པ་སྟེ།",
    "ཁྲག་ཅེས་པ་ནི་བུད་མེད་ཀྱི་མེ་ཏོག་གོ།",
    "དེ་བས་ན་གཟི་བརྗིད་ཀྱི་རང་བཞིན་ཏེ་ཁ་དོག་གིས་སོ།",
    "འདོད་ཆགས་ཞེས་པ་གཏུམ་མོའོ།",
    "རྐུན་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "གྷསྨརཱིའི་བར་ནི་རིགས་པ་འདི་ཉིད་ཀྱི་དེ་བཞིན་ཞེས་པ་ནི་རི་ཁྲོད་མ་དང་གཏུམ་མོ་དང་གཡུང་མོའི་ཞུས་ཚིག་རྣམས་ལ་ཇི་སྐད་གསུངས་པའི་རིམ་པས་སོ།",
    "འདིས་ནི་དྲིས་ཚིག་གསུམ་མོ།",
    "རིགས་པ་དེས་ཞེས་པ་ནི་རི་ཁྲོད་མ་ལ་སོགས་པ་དེ་བཞིན་དུ་གསུངས་པ་ནི་ལན་གསུམ་མོ།",
    "ཡང་ན་མཱ་ད་ཞེས་པ་ནི་སའི་ལྷ་མོའོ།",
    "མཱཾ་ས་ནི་བདག་གིའོ།",
    "དེ་ལྟར་རང་གི་དོན་བྱས་ནས་ཨཾ་བྷ་ས་བ་ཀ་ཛྫ་སཱདྷ་ཞེས་པ་ནི་ངའི་དགོས་པ་ཐམས་ཅད་སྒྲུབས་ཤིག་པའོ།",
    "ཁ་གཏི་ཁུ་ཎི་ཕཊ་གཱ་ཏ་ནི་བདག་གི་ལུས་ལ་རྨ་དོད་པ་དང་སྣད་ཡར་སོལ་ཅིག་པའོ།",
    "གང་གི་ཚེ་འདིར་གཏོར་མ་བྱིན་ནོ་ཞེས་བྱ་བ་དང་འབྲེལ་ཏོ།",
    "གང་གི་ཕྱག་རྒྱ་ཞེས་པ་ནི་གང་གི་ཕྱག་རྒྱས་སོ།",
    "བདག་གིས་སྔོན་མ་འཚལ་ཞེས་པ་ནི་སྔར་བདག་གིས་ཤེས་པར་མ་བྱས་སོ།",
    "སྟེང་དང་འོག་ཅེས་བྱ་བ་ལ་སོགས་པས་སྟེང་འོག་གོ་རིམས་བཞིན་དུ་སྦྱོར་༢༩ཨ་རོ།",
    "གང་གི་ཕྱིར་སྐུ་རྡོ་རྗེ་མ་ནི་སྐུ་རྡོ་རྗེའི་རང་བཞིན་ཡིན་པས་དེས་ན་སྐུའི་ཕྱག་རྒྱས་གདབ་པོ།",
    "རྒྱུད་ཐམས་ཅད་ཀྱི་ཕྱག་རྒྱ་ཡང་ཡིན་མོད་ཀྱི།",
    "བདག་གི་འཁོར་ལོ་ཞེས་པ་ནི་བདག་གི་དཀྱིལ་འཁོར་རོ།",
    "རྣལ་འབྱོར་མ་བཅོ་ལྔ་རྣམས་ནི་ནང་གི་རིམ་པ་ལ་བཞུགས་པ་ལྔ་དང་།",
    "ཇི་ལྟར་སྔོན་གསུངས་པ་ཞེས་པ་ནི་ཇི་ལྟར་ཁྱོད་ཀྱི་དེ་བཞིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "ཁྱོད་དང་ལྷན་ཅིག་ཅེས་པ་ནི་མཱ་མ་ཀཱི་བདག་མེད་མའི་སྐུ་རུ་མངོན་དུ་གྱུར་པ་དང་ལྷན་ཅིག་ལྡན་པར་བྱས་པའོ།",
    "ཆགས་ཆེན་པོ་དག་རྣམ་པར་ཞུ་བར་བསམ་མོ་ཞེས་པའི་༢༩༡ཨ་དོན་ཏོ།",
    "ལྷ་མོ་ཞེས་པ་ནི་སྤོས་བྱེད་མ་དང་།",
    "རི་ཁྲོད་མ་དང་གཏུམ་མོ་དང་།",
    "གཡུང་མོ་རྣམས་རང་རང་གི་ཕྱོགས་རྣམས་ནས་བྱོན་པས་རང་རང་གི་གནས་རྣམས་ལ་འདུག་པ་རྣམས་སོ།",
    "སྣ་ཚོགས་གླུ་ཞེས་པ་ནི་རེ་རེ་ཞིང་ཚིགས་སུ་བཅད་པ་རེ་རེས་སོ།",
    "ཞུ་བ་ལས་བྱུང་བའི་དགྱེས་པའི་རྡོ་རྗེ་ཁྱོད་བཞེངས་ཤིག་ཅེས་པའོ།",
    "དེ་ནས་གཏུམ་མོའི་སྟེ།",
