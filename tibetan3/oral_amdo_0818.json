    "འདི་བ་ཙམ་གྱི་དོན་ཁོ་ན་ལ་ཞེན་ནས་ཆགས་སྡང་དགག་སྒྲུབ་ཕྱི་ཚེས་རེ་དོགས་ལ་སོགས་པས་དོན་མེད་བྱེད་པར་མང་ལ།",
    "ཐ་ནའང་མཆོག་གསུམ་ལ་ཡིད་ཆེས་པའི་དད་པ་སྲོག་ལ་བབས་ཀྱང་མི་ལྡོག་པ་ཞིག་མེད་ན་དལ་འསྙོར་བཅོ་བརྒྱད་པོ་ཚང་བ་མ་ཡིན་པར་གསུངས་པས་ཚང་བ་ནི་སྲིད་མཐའ་མ་བཀག་ཙམ་མམ་ཉིན་མོའི་སྐར་མ་ལས་དཀོན་བཨཱོཾདེ་ལྟ་བུ་ཚང་མི་ཚང་བརྟག་ཏེ་དཔྱད་འཇོག་བསྒོམ།",
    "སྲོག་ལ་བབས་ཀྱང་དེ་ལྟར་སྒྲུབ་དགོས་སྙམ་པའི་དམ་བཅའ་དང་ཞེ་མནའ་དྲག་ཏུ་བསྐྱལ་དགོས་ཏེ་རང་རེ་རྣམས་ཚེ་འདིའི་བྱ་བྱེད་ཐམས་ཅད་ཟིན་དུས་ནི་མེད་ཅིང་དོན་འབྲས་ཆུང་།",
    "དགྲ་གཉེན་ལ་ཆགས་ལྡང་ལ་སོགས་དུག་ལྔའི་ཉོན་མོངས་ཤིན་ཏུ་རགས་པ་རྣམས་ནི།",
    "དེ་དག་གི་མཉེན་པོ་འདོད་ཆགས་ལ་མི་སྡུག་པ།",
    "ཕྲག་དོག་གི་གཉེན་པོར་རྗེས་སུ་ཡི་རངས་རྣམས་བསྒོམ།",
    "མེད་ན་དེ་དང་འགྲོགས་པ་སྤོངས་ནས་བུད་འགྲོ་དགོས།",
    "ལས་འབྲས་བསླུ་མེད་ལ་ཡིད་ཆེས་བསྐྱེད་ནས་རང་གི་སྔོན་གྱི་ལས་ངན་ལ་འགྱོད་བཤགས་བྱེད་དགོས།",
    "གཉེན་པོ་སྲིད་པའི་ཉེས་དམིགས་ཤེས་ནས་ངེས་འབྱུང་གི་བློ་སྐྱེད་དགོས།",
    "གསུང་གི་དམ་ཚིག་དེ་དག་གི་གསུང་མི་བཅག་ཡི་དམ་ལྷའི་བཟླས་བརྗོད་ལ་འབད།",
    "དེ་ཡན་གྱིས་དལ་འབྱོར་རྙེད་དཀའ་སོང་།",
    "དེ་ནས་གནས་པའི་མགོ་བརྩམས་ཏེ་སྐྱེ་སྒྱེ་རྣམས་ཚེ་ལོ་དཔག་མེད་ནས་བཅུ་བའི་བར་དུ་འགྲིབ་པ་ཡ་ཐོག་རིང་མོ།",
    "གཅིག་གིས་ཇི་ཤིང་ནགས་ཚལ་ཐམས་ཅད་བསྲེགས།",
    "པས་འོད་གསལ་གྱི་ལྷ་གནས་ཐལ་ཕུང་དང་བཅས་པ་ལན་ཚྭ་ཆུར་ཐིམ་པ་ལྟར་འཇིགདེ་ལྟར་ཆུས་འཇིག་པ་བདུན་རྫོགས་ནས།",
    "དེ་ལྟར་གླིང་བཞི་རི་རབ་ལྷ་གནས་དང་བཅས་པ་བྱེ་བ་ཕྲག་བརྒྱ་སྟོང་གསུམ་འཇིག་རྟེན་གཅིག་གི་ནང་དུ་ཆུད་པ་ཐམས་ཅད་མཉམ་དུ་ཞིག་ནས་མཐར་ཐམས་ཅད་ཀྱང་ནམ་མཁའ་གཅིག་ཏུ་གྱུར་ཏེ་སྟོང་སྐབས་ཡོད་ན།",
    "རྟག་འཛིན་ཕྱི་ཚེས་རེ་དོགས་ཁོ་ན་ལ་གཡེངས།",
    "ཐབས་གང་གིས་ཀྱང་བཟློག་སྡོ་ཚེད་པར་འཆི་བདག་གཤིན་རྗེས་ཞགས་ནག་སྐེ་ལ་བཞག་དུས།",
    "མིག་མཆི་མ་སྐྱ་ཙ་རེ།",
    "ཟླ་བ་ཞག་གིས་ཟད།",
    "ཁྱད་པར་རང་རེ་གནས་པའི་ཡུལ་ཕྱོགས།",
    "སྤུན་སྲིང་དུ་མ་ཡང་མིང་གི་ལྷག་མར་གྱུར།",
    "བརྟག་རང་གི་སྒོ་ཕྱུགས་ར་ལུག་རྟ་ཁྱི་བྱ་ཕག་སོགས་ལ་བརྟག་ན་ཤེས།",
    "ད་ལྟ་ས་སྟེང་གི་མི་ཤ་ལ་ཅད་ལོ་བརྒྱ་སོང་དུས་གཅིག་ཀྱང་མི་ལུས།",
    "ཡ་ཀི་སྲིད་པའི་རྩེ་མོ་ནས།",
    "འདུས་བྱས་ཀྱི་རང་བཞིན་ཡིན་པས་སྐད་ཅིག་རེ་རེ་སོང་བས་ཚེ་འཛད།",
    "བློན་འབངས་ལོངས་སྤྱོད་གཉེན་བཤེས་གང་གིས་ཀྱང་མི་ཕན་པར་ཐམས་ཅད་བཞག་ནས་འགྲོ་དགོས་པ་མ་ཟད།",
    "དེ་འདྲ་ཞིག་མི་བྱེད་རེ་ཤི་སྙམ་པ་དང་།",
    "དེ་ལྟ་བུའི་དམ་བཅའ་དེ་གཏོང་རེ་ཤི་སྙམ་པའི་དམ་བཅའི་ལྕགས་ཀྱུ་གཉིས་པ་རེས་ཟིན་པར་གྱེད་པ་ནི་དམ་བཅའ་ཀུན་ལ་གལ་ཤིན་ཏུ་ཆེའོ།",
    "ད་འདུག་ཟ་ཉལ་ཐམས་ཅད་ལ་འཇིག་རྟེན་འདིའི་སྤྱོད་ལམ་གྱི་ཐ་མ་ཡིན་ནོ་ཞེས་ཐལཏུ་ཡང་བརྗོད་ཡིད་ལའང་དུང་ངེ་བསྒོམ་དགོས་པས་གཙོ་བོ་རྗེས་ཐོབ་འ་རྒྱམུན་མཚམས་ཀྱི་ཉམས་ལེན་ཡིན་ཀྱང་།",
    "དབེན་པར་སྡོད་པ་མོས་འདིར་འཆི་སྙམ་པ་དང་།",
    "དེ་བཞིན་ནངས་མོ་ལྡང་བ་གཏམ་སྨྲ་བ་རྩེ་མོ་བྱེད་པ་ལ་སོགས་མོས་ནས་དེ་དང་དེར་འཆི་བ་འོང་ངེས་སྙམ་དུ་བསྒོམ།",
    "མདའ་གྲི་མདུང་སོགས་ཀྱིས་དངོས་སུ་གནོད་པས་འཆི་ལ་ཟུག་པ་མོས་ནས་ད་ཅི་བྱེད་ངེས་པར་དུ་འཆིའོ་སྙམ་དུ་འདུན་པ་དྲག་པོ་ཡིད་ཀུང་ངེ་འགྲོ་བ་རེ་བསྒོམ།",
    "འོང་བར་གྱུར་ཅིག་འོང་བ་ཞིག་བདག་གིས་བྱ།",
    "ནུབ་མོ་ཉལ་དུས་འདི་ལྟ་བུར་ལྡང་བ་བྱ་སྙམ་ན་དེ་དུས་སད་པ་བཞིན་ནོ།",
    "སྤུ་གྲིའི་ཐང་སྲིན་མོའི་གླིང་དུག་སྦྲུལ་གྱི་གཟེབ་ལྟ་བུ་ཡིན་པས་རྨི་ལམ་གྱི་བདེ་སྐྱིད་གཉིད་སད་ཚེ་མེད་པ་ལྟ་བུའི་ཚེ་འདིའི་སྣང་བའི་ཕུན་ཚོགས་ལ་ཡིན་བརྟན་མེད་པས་ཅི་བྱ།",
    "ལྔ་པ་རྒྱུ་གང་གིས་འཁོར་ན།",
    "ཟོ་ཆུན་གྱི་ཁྱུད་མོའམ།",
    "པགས་པ་སྲབ་པ་ཤ་ཚག་དམ་པ་མིག་ལྟར་རེག་བྱ་སྲན་མི་བཟོད་པ།",
    "པའི་ལྷའི་ལོ་སྟོང་ལ་ཟིག་ནག་པའི་ཞག་གཅིག་ཏུ་བྱས་པའི་རང་ལོ་སྟོང་ཐུབ་པའོ།",
    "དེ་ལྟ་བུའི་གནས་སུ་གཅེར་མོ་གྲང་བའི་སྡུག་བསྔལ་གྱིས་ཉམས་པས་ལུས་ལ་ཆུ་བུར་ཐོལ་ཐོལ་ཐེབ་ལྡོག་ཙམ་མང་པོ་རྡོལ་བ་ནི་ཆུ་བུར་ཅན།",
    "ཆུ་བུ་དེ་དག་རྡོལ་ནས་རྨར་སོང་བ་ཆུ་བུར་རྡོལ་བ།",
    "དེ་ལས་ཆུ་བུར་ཅན་གྱི་ལོ་བརྒྱ་རེ་ན་ཏིལ་རེ་རེ་མྱུངས་པས་ཏིལ་ཐམས་ཅད་ཟད་པ་ན་ཆུ་བུར་ཅན་གྱི་ཚེ་ཚད་རྫོགས་པ་ཡིན་ལ།",
    "ལྷག་མ་བདུན་པོར་དེ་ལས་རིམ་པ་ཉི་ཤུ་རེའི་འགྱུར་གྱིས་ཚེ་ཇེ་རིང་སྡུག་བསྔལ་ཇེ་ཆེ་ཡིན་ནོ།",
    "རྩ་རྒྱུས་རྣམས་སོ་མང་གིས་བལ་ཤད་པ་ལྟར་སྐྱ་ཤམ་ཤམ་སོང་།",
    "བུད་མེད་མེ་འབར་བ་འཇིགས་སུ་རུང་བས་འཁྱུད་ནས་མགོ་བོ་ཁར་བཅུག་སྟེ་བལྡད་པས་འགྲམ་ཁུག་གཉིས་ནས་ཀླད་པ་སྐྱ་ཅིར་གྱིས་འོང་བས་སྡུག་བསྔལ།",
    "གཞན་ཡང་ཆུ་ཀླུང་བཟང་པོ་རྒྱང་རིང་ནས་འབབ་པར་མཐོང་སྟེ་ཕྱིན་ནས་འབོག་མ་ཐག་ཐལ་ཚན་གྱི་ཆུ་བོ་རབ་མེད་ནང་སྐེད་ནུབ་ཏུ་ཚུད་དེ་ཤ་རུས་ཚིག་ནས་ཕྱིར་བྲོས་པ་ལས།",
    "ཉེ་འཁོར་ལྷག་པ་བཅུ་དྲུག་གི་ཚེ་ཚད་བར་བསྐལ་ཕྱེད་དུ་སྡུག་བསྔལ་བར་དྲན་པ་ཉེར་བཞག་ལས་གསུངས།",
    "དེས་ན་ད་རེས་དལ་འབྱོར་ཐོབ།",
    "ཕྱིན་ཆད་སྲོག་དམར་པོ་འདི་ལ་བབས་ཀྱང་དེ་དག་ཏུ་སྐྱེ་བའི་ལས་བསགས་རེ་ཤི་སྙམ་པའི་དམ་བཅའ་དང་།",
    "དེ་དག་ཐམས་ཅད་ད་ལྟ་ཉིད་དུ་མྱུར་བ་ཉིད་དུ་ངན་སོང་གི་གནས་རིས་ལས་ཐར་ན་ཅི་མ་རུང་།",
    "སྡིག་ཅན་དབུགས་དབྱུང་འགགས་པ་ཙམ་ཞིག་གི།",
    "ཞེས་གསུངས་གཉིས་པ་ངན་སོང་གི་གནས་གཉིས་པ་ཡི་དྭགས་ནི།",
    "རེས་རྒྱང་རིང་ན་ཆུ་ཀླུང་དང་།",
    "ཚ་གྲང་གོ་ལྡོག་པ་ལ་སོགས་ཕྱིན་ཅི་ལོག་གི་སྣང་བ་དང་ལྡན་བས་སྡུག་བསྔལ་ཡུན་རིང་མྱོང་བའོ།",
    "གཉིས་པ་ནང་གི་སྒྲིབ་པ་ཅན་ནི།",
    "ཁ་ཁབ་མིག་ཙམ་པས་རྒྱ་མཚོའི་ཆུ་འཐུངས་ཀྱང་མགྲིན་པ་རྟ་རྔ་ཙམ་དུ་མ་ཚུད་པའི་བར་ལ་ཁའི་དུག་གིས་སྐམ་པ་དང་།",
    "ཅུང་ཟད་རེ་སོང་ཡང་སྟོ་བ་ཡུལ་ལྗོངས་ཙམ་མི་ཁེངས་པ་དང་།",
    "ཡི་དྭགས་རེ་རེའི་ལུས་ལ་སྲོག་ཆགས་མང་པོའི་ཚང་བཅས་ནས་དེའི་ཁྲག་དང་ཤ་ལ་ཟ་བའམ་ལུས་ལྷ་བས་གང་བ་ཕྲུ་གུ་མང་པོར་སོང་ཏེ་དེ་རྣམས་ཀྱིས་ཟ་བ་ལ་སོགས་པ་དང་།",
    "ཕན་ཚུན་སྟོབས་ཆེ་ཆུང་གཅིག་གིས་གཅིག་གསོད་པ་དང་།",
    "ཕྱིན་ཅི་ལོག་གི་སྣང་བ་སྤྱི་མཐུན་འཆར།",
    "དེ་དག་གི་སྡུག་བསྔལ་སོགས་དང་།",
    "གསུམ་པ་ངན་སོང་གི་གནས་གསུམ་པ་དུད་འགྲོ་ནི།",
    "གླིང་པ་མུན་ནག་གི་རྒྱ་མཚོའི་ནང་དང་ཁ་འཐོར་བ་ལྷ་དང་མིའི་གནས་ས་ཆུ་རི་ལུང་གང་ནའང་ཡོད།",
    "འབུ་སྲིན་ལ་སོགས་པ་ཆང་འགག་གི་སྦང་མ་བཞིན་ཤིན་ཏུ་མང་བ།",
    "ཕན་ཚུན་གཅིག་གིས་གཅིག་ཟ་བ་སྟེ།",
    "ཆུང་བས་ཆེ་བའི་ལུས་ཐལ་མར་འབིགས་ཤིང་ཟ།",
    "ཆེ་བ་རེའི་ལུས་ལ་ཆུང་བ་མང་པོས་ཚང་བཅས་ནས་ཟ་བར་བྱེད།",
    "ཀླུ་རྣམས་ལ་ཉིན་རེ་བཞིན་བྱེ་ཚན་གྱིས་བསྲེགས་ཅིང་མཁའ་ལྡིང་གི་ཟ་བ་སོགས་རྟག་ཏུ་དགྲ་བྱུང་གི་དོགས་པས་སྡུག་བསྔལ།",
    "ད་ལྟ་རང་ཅག་རྣམས་མཛུབ་མོ་མེ་དང་ཡུད་ཙམ་འཕྲད་པའམ།",
    "ཁུར་ཅུང་ཟད་ཡུད་ཙམ་འགེལ་བའི་སྡུག་བསྔལ་སོགས་ལ་མཚོན་དང་ངན་སོང་གི་སྡུག་བསྔལ་བཟོད་ཐབས་གཏན་ནས་མེད།",
    "ད་ལྟ་རང་རེ་གནས་མལ་ལོངས་སྤྱོད་ཟས་གོས་སོགས་འཇིག་རྟེན་གྱི་ཕུན་ཚོགས་བདེ་བར་རློམ་པ་རྣམས་ཀྱང་དངོས་སུ་སྡུག་བསྔལ་ལྟར་མི་མངོན་ཀྱང་དོན་དུ་སྡུག་བསྔལ་གྱི་རྒྱུ་ཁོ་ན་ལས་མ་འདས་ཏེ།",
    "དཔེར་ན་ད་ལྟ་རང་རེ་སྐྱིད་པོར་བཇི་བའི་ཁ་ལ་ཟ་རྒྱུ་ཇ་དང་རྩམ་པ་ཞོ་དང་འོ་མ་མར་དང་ཤ་ཆང་སྦྲང་རྩི་གྲོ་མ་འཆུ་ར་ཚོད་མ་སོགས་བཟའ་བཏུང་གི་རིགས་ཐམས་ཅད་བྱུང་སའི་ཕུག་དང་ལས་ཀ་སོགས་ལ་ལྟོས།",
    "རྒྱབ་ལ་གྱོན་རྒྱུ་འཁྲུག་ཚ་རུ་ཝ་ཞྭ་ཀོ་ལྷམ་སྲམ་གཟིག་སོགས་དང་།",
    "འདི་ཐམས་ཅད་ཀྱི་འབྲས་བུ་མཐར་ནི་ངན་སོང་གི་སྡུག་བསྔལ་མུ་མཐའ་མེད་པ་ལ་སྤྱོད་དགོས་པ་ཡིན་པས།",
    "བརྒྱལ་སངས་པ་ན་ཤི་བ་ངོ་མ་ཤེས་ནས་ཉེ་དུ་སོགས་ཀྱི་དྲུང་དུ་སོང་ནས་ང་འདི་ན་ཡོད་ཟེར་ཀྱང་དེ་རྣམས་ཀྱིས་མི་མཐོང་མི་ཐོས།",
    "དེ་དུས་ལས་དག་པ་རྣམས་དཔའ་བོ་དང་མཁའ་འགྲོའི་བསུ་མས་ཡར་གྱི་ཟང་ཐལ་དུ་འགྲོ།",
    "མཚམས་མེད་སོགས་བྱས་པ་རྣམས་གཤིན་རྗེའི་སྐྱེས་བུ་མང་པོའི་སྣང་བས་མར་གྱི་ཟང་ཐལ་དུ་འགྲོ།",
    "མོར་སྐྱེ་ན་ཕ་ལ་ཆགས་མ་ལ་སྡང་བ་དང་།",
    "གོར་མོ་ལ་སོགས་འགྱུར་བའི་གནས་སྐབས་ཀྱི་སྡུག་བསྔལ་མང་པོ་ཉམས་སུ་མྱོང་།",
    "མངལ་གྱི་ནང་དོགས་ཅིང་དྲི་ང་བ་མུན་ནག་གི་ནང་།",
    "གྲང་མོ་ཟོས་པས་ཆུ་གྲང་དུ་བསྐྱུར་བ་ལྟ་བུ།"
  ]
}