    "རིལ་པོ་གཉིས་པོའི་གྲངས་ཀྱིས་ཀྱང་ཕྲི་བར་བྱས་ན་འགྲིག་ཅིང་།",
    "ཡང་ན་ལྷག་མ་མ་བསྡོམ་པའི་གྲངས་བརྒྱ་ང་བཞི་ལ་བྱས་ན་གཞུང་ནས་གསུངས་པ་ལྟར་འགྲིག་པར་འགྱུར་བས་གང་བྱས་ཀྱང་འགལ་བ་མེད་དོ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དེ་ཁོ་ན་ཉིད་ནི་དགག་བྱ་བཅད་ཙམ་གྱི་སྟོང་རྐྱང་མ་ཡིན་ཏེ་སྣང་སྟོང་ཟུང་འཇུག་ཐབས་ཤེས་གཉིས་སུ་དབྱེར་མེད་པའི་ཕྱིར་ན་རིགས་མེད་པ་བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལོ་ཞེས་སྔར་ཡང་ཡང་གཏན་ལ་ཕབ་པ་དེ་ཉིད་དོ།",
    "ཞེས་སོགས་གསུངས་པ་བཞིན་ནོ།",
    "མ་དག་པའི་སྣོད་བཅུད་དུ་སྣང་བའི་ཁམས་མཐའ་དག་སྒྲིབ་བྲལ་དུ་གྱུར་པའི་ཆ་ནས་དག་པའི་རྟེན་དང་བརྟེན་པར་སྣང་བ་ལ་གཞན་དུས་ཀྱི་འཁོར་ལོ་ཞེས་བྱ་སྟེ།",
    "གཞན་ཡེ་ཤེས་ཀྱི་དུས་དང་གསུམ་དུ་རྣམ་པར་ཕྱེ་བའི་སྒོ་ནས་ཕྱི་ནང་གཞན་གསུམ་དག་པ་གཅིག་ཏུ་སྦྱོར་ཚུལ་གྱི་ངེས་པའི་དོན་འདི་ལྟ་བུ་ནི།",
    "ཚིགས་བཅད་འདིར་ཉི་མའི་ཤིང་རྟ་ལ་བོད་པ་ཡོད་པས་རྩ་རྒྱུད་ཀྱི་མ་ཡིན་པར་འཇམ་དཔལ་གྲགས་པའི་གསུང་དུ་བཞེད་པ་ལེགས་ཟེར།",
    "ཨ་ཨི་ཨུ་ཨེ་ཨོ་ལྔ་ལ་རྩ་བའི་དབྱངས་ལྔར་བྱས་པ་ནི་འཇིག་རྟེན་ན་བརྡ་སྤྲོད་བྱས་པ་རྣམས་ལ་ཡོངས་སུ་གྲགས་པ་སྟེ།",
    "གསུམ་པར་རྀ་དང་མེ་དང་རྒྱལ་བ།",
    "བཞི་པར་ཨུ་དང་ཆུ་དང་སྟོང་པ།",
    "ལྔ་པར་ལྀ་དང་ས་ཁམས་དང་རྫོགས་པ།",
    "གལ་ཏེ་དེ་ལ་ས་སྐྱེས་ལ་སོགས་གཟའ་དག་ལྷན་ཅིག་ཏུ་ཤར་བར་མ་གྱུར་ན༵་མི་ཤིས་པ་མེད་པ་ཤིས་པར་ཤར་བ་ཞེས་བྱའོ།",
    "ཨོ་ཅན་ཨུ་ལ་བསྡུ་བ་སོགས་དབྱངས་གཞན་རྣམས་རྩ་བའི་དབྱངས་ལྔར་བསྡུས་ནས་མིང་ཐོག་ལ་བརྟག་པར་བྱའོ།",
    "རབ་བྱུང་ལ་སོགས་པའི་ལོ་དྲུག་ཅུ་ལ་དབྱངས་ལྔ་ལན་གཅིག་རྫོགས་པར་འཆར་བ་ནི་བཅུ་གཉིས་ཀྱི་ལོ་རྣམས་ལ་ཨ་སོགས་ལྔ་རིམ་པས་འཆར་བ་དག་མི་ཕམ་བཀའ་འབུམ།",
    "རྒན་པོ་དག་ཏུ་གྱུར་པ་ནི་རིམ་པས་མེ་དང་ཆུ་གཏེར་ཉིན་ཞག་ལ་སྟེ་ལྔ་པ་ལ་ནི་སྨིན་ནས་ཤི་བའམ་ནུབ་པར་འགྱུར་རོ་ཞེས་རང་ས་ནས་བགྲང་བའི་གསུམ་པར་དར་བབ།",
    "བཞི་པར་རྒན་པོ།",
    "ལྔ་པར་སྨིན་པ་རྫོགས་ཏེ་ནུབ་པ་ཡིན་ནོ།",
    "ཕྱི་མ་གཉིས་ཀྱི་དུས་སུ་མི་དགེ་ལ་ཁྱད་པར་དབྱངས་ནུབ་པའི་དུས་སུ་ལས་བརྩམ་ན་སྟོབས་མེད་དོ།",
    "གཉིས་བཟང་པོ་སོགས་ནས་རིམ་པར་བསྐོར་བར་བྱའོ།",
    "ལྀ་དར་བབ་སོགས་སུ་ཤེས་པར་བྱ་སྟེ།",
    "དབྱངས་རིང་པོ་དང་དབྱངས་རིང་པོས་བརྗོད་པའི་གསལ་བྱེད་རྣམས་ནི་ནག་པོའི་ཕྱོགས་ལྭ་ཤིན་ཏུ་ངེས་པར་འཆར་བར་འགྱུར་ཏེ་ལྷོ་བགྲོད་དུ་ཐུང་ངུ་སྤྲོ་བ་སྐྱེ་བའི་རིམ་པ་དང་བྱང་བགྲོད་དུ་རིང་པོ་བསྡུ་བའི་རིམ་པའི་སྦྱོར་བས་སོ།",
    "སྔར་ཚིགས་བཅད་བརྒྱད་པར་གསལ་བྱེད་རྣམས་རང་བཞིན་གྱི་དབྱངས་དང་།",
    "ལྷོར་བགྲོད་ཀྱི་ས་བོན་རྣམས་སྐྱེ་རིམ་དང་མཐུན་པར་དབྱངས་ལུགས་འབྱུང་དང་།",
    "བྱང་བགྲོད་ཀྱི་ས་བོན་རྣམས་སྡུད་རིམ་དང་མཐུན་པར་དབྱངས་ཡིག་ལུགས་ལས་ལྡོག་པའི་སྒོ་ནས་གསུངས་སོ།",
    "དེ་ནས་དུས་སྦྱོར་བརྟག་པ་གསུངས་པ།",
    "དེ་ལ་སོགས་པ་དུས་སྦྱོར་གྱི་འབྲས་རྩིས་རྣམས་ཀྱང་ཤེས་པར་བྱའོ།",
    "གཉིས་པར་ཨི་སོགས་ནས།",
    "གཉིས་པར་ཝཱ་སོགས་ནས།",
    "དབྱངས་དེ་དག་ནུབ་པ་དག་ཀྱང་ཡུད་ཙམ་གྱི་ཆ་དེ་ཉིད་ལ་རྩི་བར་བྱ་སྟེ་དབྱངས་གང་ཤར་བ་དེ་ནས་བགྲང་བས་བཅུ་དྲུག་པའི་དུས་སུ་ནུབ་པར་འགྱུར་ཏེ།",
    "དཀར་པོའི་ཚེས་གཉིས་ལ་ཤར་བ་དེ་ནག་པོའི་ཚེས་གཉིས་ལ་ནུབ་པ་ལ་སོགས་སུ་ཤེས་པར་བྱའོ།",
    "འཁོར་ས་སོགས་འབྱུང་ཁམས་དང་གཟའ་ཡི་ཁམས་དང་མཚུངས་པའི་ལས་རྣམས་དེ་དུས་ཤར་བའི་དབྱངས་དེའི་མིང་ཅན་རྣམས་ཀྱིས་བསྒྲུབ་པར་བྱ་སྟེ་དེ་ལྟར་བྱས་ན་འབྲས་བུ་ཡོད་པར་འགྱུར་རོ།",
    "དོན་དེ་ཉིད་རྒྱས་པར་གསུངས་པ་སྣ་བུག་གཡོན་པ༵་དག་ནས་རྐྱང་མ་ཁུ་བ་ཐབས་ཀྱི་ཆར་གྱུར་པའི་ཆ་ནས་ཐུང་ངུའི་དབྱངས་རྣམས་འདིར་ནི་འཆར་བར་འགྱུར་ཏེ་ཨ་ལ་སོགས་པ་རིམ་པར་ལྀའི་བར་དུའོ།",
    "གཡས་ཀྱི་དུས་སྦྱོར་ལ་དེ་ཉིད་ལྔ་ནི་འཛིན་མ་སྟེ་ས་ལ་སོགས་པ་ལྔ་སྡུད་རིམ་གྱིས་འཆར་བ་དང་བདག་པོའི་གཟའ་ཡི་ཚོགས་ནི་ངེས་པར་ཉི་མའི་བུ་ལ་སོགས་པ་ཉིད་ཡིན་ཏེ།",
    "བདག་པོའི་གཟའ་ཡི་གནས་ཆུ་ཚོད་ལྔ་དང་མཉམ་པ་སྟེ་དེ་དང་ལྷན་ཅིག་འཆར་བའི་དབྱངས་གསལ་བྱེད་དང་བཅས་པ་དག་ནི་ལེགས་པར་བརྩིས་ནས་ཆེད་དུ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "གཡུལ་གྱི་སླད་དུ་དྲིས་ན་འབྲས་བུ་ལུང་སྟོན་ཚུལ་གསུངས་པ།",
    "གང་ཞིག་གཡུལ་དུ་དགྲ་ནི་ངེས་པར་རབ་ཏུ་ཉམས་པར་འགྱུར་ཏེ།",
    "འཕེལ་བ་ལྔ་རིང་པོས་བརྗོད་པའི་གསལ་བྱེད་རྣམས་ལྷན་ཅིག་ཏུ་འཆར་བ་དོན་གྱིས་ཤེས་པར་བྱའོ།",
    "ལྔ་པ་ས་ལ་ཀ་འཆར་བ་ཡང་གོང་བཞིན་ཤེས་པར་བྱའོ།",
    "འཁྲིག་པར་ཎ་ཌྷ་ཌ་ཋ་ཊ།",
    "ཡུད་ཙམ་གྱི་དབྱེ་བ་སྔར་བརྗོད་པ་ལས་ཤེས་པར་བྱའོ།",
    "གསལ་བྱེད་འཆར་བ་ནི་དུས་སྦྱོར་གྱི་ཆུ་ཚོད་ལྔ་ཡི་དབྱེ་བས་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ན་གཡོན་དང་གཡས་ཀྱི་སྣ་བུག་ལས་དཀྱིལ་འཁོར་ལྔ་འབབ་པའི་དབྱེ་བས་གསལ་བྱེད་འཆར་བ་ཤེས་པར་བྱའོ།",
