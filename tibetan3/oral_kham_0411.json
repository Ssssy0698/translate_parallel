    "གནས་ཤིང་འདུག་པ་ཡང་ཡོད་དོ་༥།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་རང་བཞིན་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་།",
    "དེ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེར་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་ཐམས་ཅད་འདུག་༡པར་བྱས་ཤིང་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་དོ།",
    "གང་རང་༡བཞིན་སྟོང་པ་ཉིད་ཀྱིས་ཡོངས་སུ་བསྡུ་བ་དེ་དག་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱིས་ཡོངས་སུ་སྡུད་དོ།",
    "འདུག་པའམ།",
    "འདུག་པའམ།",
    "༢སྣར་འདུག་༦༨༤ ༡གཡུང་སུ།",
    "༦ཅོ་ཉན་ཐོས་དང་རང་སང་ས་རྒྱས་རྗེས་སུ་དྲ་ན།",
    "ཁོང་རང་ཞབས་ཞུ་གནང་བརྒྱལ་ནས་ད་བར་གྱི་གནས་ཚུལ་རོབ་ཙམ་གསུངསརྒྱལ་རྗེས།",
    "ང་རང་གཉིས་ཀརྒྱལ་ཆབ་སྲིད་ཀྱི་ཐུགས་འགན་དགོངས་ཞུ་གནང་རྒྱུརྒྱལ་ཡིན་གསུངས་པ།",
    "དེ་མིན་སྐུ་ཕྱར་འགལ་རྐྱེན་བཟློག་ཏུ་མེད་པ་ཞིགརྒྱལ་འདུག་ཅེས་གསལ་བས།",
    "ཆེ་གེགས་ཆུངརྒྱལ་འགྱུར་ཡིན་ངེས་སུ་འདུག་ཀྱང་།",
    "རྭ་སྒྲེང་རིནརྒྱལ་པོ་ཆེ་མཆོག་ཉིད་ཡི་དམ་ཕུར་པའི་བསྙེན་མཚམསརྒྱལ་བཅད་རྒྱ་ཞིག་མཛད་འདུག་པ་དང་།",
    "དེ་སྐབས་ཤན་ཁ་བས་གཟིམ་ལྟསརྒྱལ་ལེགས་པོ་རང་ཨེ་ཡིན་སྙམ་པ་འདུག་ཅེས་ཞུས་པརྒྱལ་གསལ།",
    "དུས་ཕྱིས་བསྟན་འགྲོའི་བདེ་ཐབསརྒྱལ་དང་རང་གཞན་མང་པོའི་ཆེད་དུ་གཏེར་བྱོན་གྱིརྒྱལ་གཏོར་བཟློག་རིགས་དང་ཡི་དམ་ཞི་ཁྲོའི་བཟླསརྒྱལ་སྒོམ་སོགས་བྱེད་དགོས་པ་དང་།",
    "དེའིརྒྱལ་ཕྱིར་ན་དགེ་ལུགས་པ་མཐའ་དག་རྙིང་མར་གྲུབརྒྱལ་མཐའ་འགྱུར་བར་ཁས་ལེན་དགོས་པ་ཙམ་འདུགརྒྱལ་ན་དབྱེ་འབྱེད་ལན་སོགས་གང་འདེབས།",
    "ཉན་ཐོས་རིགས་དང་རང་རྒྱལ་རིགས།",
    "སློབ་དཔོན་གསང་ཞིང་གཅིག་པུར་འདུག་ལ་དགའ།",
    "བདེ་བར་འདུག་པ་རགས་མ་ཡིན།",
    "དེ་ཡང་རང་རྒྱུད་ལ་བརྟག་པ་དང་།",
    "ད་ནི་རྣམ་པ་ཐམས་ཅད་དུ་ནང་དུ་མི་ལྡོག་པ་མཐོང་ཙ་ན།",
    "ཀེང་རུས་འཐོར་བ་ལ་སོགས་པ་མཐོང་ཙ་ན།",
    "དོན་ཤི་བའི་རོ་གཅིག་འདུག་ལོ་ཟེར་བ་ཐོས་ཙ་ན།",
    "སྐྱོས་ཙ་ན་ལྷ་མིའི་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་ཐོབ་སྐྱ་འོང་།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "རབ་ཏུ་དོག་པ་མུནནག་འཐིབས་པོརའདུག་པ་ཡ།",
    "རྒྱགས་ཕྱེ་ཁུར་ནས་འོངས་པར་མི་གདའ།",
    "དེ་ཡང་རང་ལ་མི་མཁོ་བ་བུ་ལ་བྱིན་པ་ལྟ་བུ་མ་ཡིན་ཏེ།",
    "དཀའ་ལས་ཅི་ཡང་ནུས་པའི་ཤད་པོ་ཆ་ཅིག་བྱུང་བར་མི་གདའ།",
    "རང་ལས་གཞན་གཅེས་པར་འཛིན་ཙ་ན།",
    "སྐྱབས་ཐུབ་པ་ནི་ཁོ་རང་འཇིགས་པ་ལས་ཐར་བ་སྡུག་བསྔལ་མེད་པ་ཅིག་དགོས་ཏེ།",
