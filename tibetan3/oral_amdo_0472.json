    "རྒྱལ་པོས་མགོ་བོ་མགོ་བོས་བསླུ་བར་བྱ་ཁྱོད་ཀྱི་མགོ་བོ་བླང་ངོ་ཟེར་བས།",
    "འཇམ་མགོན་ཡོན་ཏན་རྒྱ་མཚོ་མཆོག་ཟུང་གིས་མགྲིན་གཅིག་ཏུ་གསུངས་པ་དང་།",
    "ཁྱད་པར་གཤེད་སྐོར་དམར་ནག་འཇིག་གསུམ་གྱི་རྒྱུད་དང་མན་ངག་གི་ཆུ་བོ་ཀུན་འདུས་པ་སློབ་དཔོན་ཆེན་པོ་དཔལ་འཛིན་སོགས་རིམ་པར་བརྒྱུད་དེ་བོད་ཡུལ་དུའང་ཅི་རིགས་པར་བྱུང་ཞིང་།",
    "རྒྱུད་ཟབ་མོ་བསྟོད་པའི་གླུར་བླངས་ཞུས།",
    "དབྱིངས་ཡེ་གཉིས་སུ་མེད་པ་སྐྱེ་འགག་བྲལ་བའི་དོན་ཉིད་གཉེན་པོ་གཞན་གྱིས་མི་ཤིག་རྐྱེན་གང་གིས་ཀྱང་མི་འགྱུར་དངོས་འཛིན་མཚན་རྟོག་མཐའ་དག་འཇོམས་པར་ཐོག་མེད་མཐུ་དང་ལྡན་པས་འཆི་བདག་གཤིན་རྗེའི་གཤེད་དམ་སྐྱེ་འགག་རྟག་ཆད་སོགས་མཚན་འཛིན་མཐའ་དང་བྲལ་བས་ན་གཤིན་རྗེ་སྟེ།",
    "ངག་གི་རྒྱལ་པོ།",
    "བཀྲ་ཤིས་རིག་པ་ཁུ་བྱུག་གི་རྒྱུད་ལས།",
    "མོས་པའི་བློ་ལ་སོ་སོ་ཉིད་དུ་གསལ།",
    "དེ་ནི་དབྱིངས་ཡེ་ཟུང་འཇུག་གི་ལྟ་བ་ཞེས་བྱ་སྟེ་འཇམ་དཔལ་རྫོགས་པ་ཆེན་པོའི་ལྟ་བའོ།",
    "དེ་ཡང་རེས་ཐམས་ཅད་རང་ལ་བསྡུས།",
    "རེས་སྤྲོས་ལ་བསྒོམས་ཏེ་ཐམས་ཅད་ཀྱང་སྣང་བཞིན་དུ་སྟོང་།",
    "རྩོལ་སྒྲུབ་རེ་དོགས་འཛིན་པ་བྲལ།",
    "འབྲས་བུ་གཞན་ལ་རེ་བ་མ་ཡིན་ནོ།",
    "དེ་ལ་འདས་མ་འདས་ཀྱི་ལྷ་གང་གི་སྲོག་བསྒྲུབ་ཀྱང་།",
    "དེ་ལྟར་ལྟ་སྒོམ་སྤྱོད་པ་དམ་ཚིག་འབྲས་བུ་སྲོག་སྒྲུབ་པ་བཅས་དགོས་དོན་དེ་རྣམས་ནི་དཔེར་ན་ཡིད་བཞིན་གྱི་ནོར་བུ་ལག་ཏུ་གཏོད་པ་དང་འདྲ་སྟེ་ཚུལ་བཞིན་ཉམས་སུ་བླངས་པས་གནས་སྐབས་དང་མཐར་ཐུག་གི་དོན་ཐམས་ཅད་འགྲུབ་ཅིང་དཀའ་བ་མེད་པ་རིག་འཛིན་གྱི་སར་ཕྱིན་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་སྣང་བ་དེ་ནི་རང་གི་སེམས་སྣང་སེམས་ཀྱི་ཆོ་འཕྲུལ་ཙམ་དུ་ཟད་ཅིང་།",
    "སེམས་རང་ཉིད་འཁོར་འདས་ལྟར་སྣང་གི།",
    "རྟགས་ཀྱི་ཕྱག་རྒྱར་བསྟན་པའི་སྐུ་གང་གི་ལྟོ་བ་ན་གནས་ཤིང་ཐ་མལ་པའི་གཤིན་རྗེའི་གཤེད་དུ་གྱུར་པ་འཁོར་འདས་ཐམས་ཅད་ཀྱི་བདག་པོ་དེའི་གོང་ན་གཞན་མེད་པ་ནི་ཡང་དག་ཡེ་ཤེས་ཀྱི་སྐུ་འཇམ་དཔལ་ཡ་མནྟ་ཀ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཤེས་ནས་སྲིད་པའི་འཁོར་ལོ་བསྐོར་བའི་འཕུལ་བྱེད་ཉོན་མོངས་བརྒྱད་ཁྲི་བཞི་སྟོང་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱིས་གནོད་པ་འམ་གཞོམ་པར་བྱེད་པ་ནི་དེའི་ཁམས་ཡིན་ནོ།",
    "ཡ་མཱནྟ་ཀའི་ཕྱག་མཚན་འཁོར་ལོ་ལ་ཕྲིན་ལས་རྣམ་བཞིས་རང་རང་གི་འགལ་ཟླ་གཅོད་པར་བྱེད་དེ།",
    "སྐུ་ཡི་བདག་ཉིད་ཡིན་པས་དེའི་རྒྱུད་མཐའ་དག་གི་དགོངས་པ་སློབ་དཔོན་འཇམ་དཔལ་བཤེས་གཉེན་གྱིས་འཁོར་ལོ་བཞིར་བསྡུས་པ་དེ་དག་ཡ་མཱནྟ་ཀའི་སྐུ་གཅིག་ལ་ཚང་བར་བསྟན་པའི་ཚུལ་གྱིས་གཤེད་རྒྱུད་ཀྱི་དགོངས་པ་གསལ་བར་མཛད་པའི་ཚུལ་ཡིན་ལ།",
    "གནས་པའི་འཁོར་ལོ་ནི་གནས་ལུགས་ངོ་བོ་ཉིད་ཀྱི་གཞི་སྟེ་སྦྱང་གཞི་སེམས་ཉིད་རང་བྱུང་གི་ཡེ་ཤེས་དང་།",
    "ཞེན་པ་སྦྱོང་ཕྱིར་སྔགས་ཀྱི་རྣལ་འབྱོར་རྡོར་བཟླས་བུམ་ཅན་གཏུམ་མོ་གཞན་ལུས་དང་བཅས་པ།",
    "དགྲ་བོ་བསད་པའི་སྐོར་གསུམ་མོ།",
    "དགྲ་བོའི་ལག་ཆ་ཁོ་རང་ལ་ཕར་བསྐོར་ཞིང་རྦོད་གཏོང་གི་གཡུལ་གཤམ་ནས་དམག་དཔོན་གཡུལ་དུ་བསད་པའི་ལས།",
    "དེས་ན་ཐེག་ཆེན་ཐུན་མོང་ལ་ཡོངས་སུ་གྲགས་པའི་གཞི་ལམ་འབྲས་གསུམ་གྱི་གོ་དོན་ལྷོང་ཞིང་།",
    "དེའི་ཕྱིར་རྩ་བ་དང་ཡན་ལག་གི་དམ་ཚིག་ལ་ཡང་དག་པར་གནས་པའི་རྟེན་གྱི་གང་ཟག་གི་བསྒྲུབ་པར་བྱ་དགོས་པ་ཤེས་པར་བྱ་བ་གལ་ཆེ་ཤོས་ཡིན་ལ།",
    "དེ་ནས་ངེས་འབྱུང་གི་བློ་བཅོས་པ།",
    "ཐོག་མར་དལ་འབྱོར་གྱི་མི་ལུས་རིན་ཆེན་རྙེད་དཀའ་འདི་ད་རེས་རྙེད་པའི་དུས་སུ་འཆི་བ་ཐོག་བབ་ནམ་ཡོང་ཆ་མེད་ལ་ཞེ་ཐག་པ་ནས་བསམ་ཞིང་།",
    "ཧཱུྃ་གིས་ཁ་དོག་དྲི་རོ་ནུས་བཅུད་ཕུན་སུམ་ཚོགས་པར་གང་འདོད་དེར་སྣང་ཟག་མེད་བདེ་བསྐྱེད་ཀྱི་བདུད་རྩི་མཁའ་དང་མཉམ་པར་བསམ་ལ།",
    "རྩོལ་སྒྲུབ་རེ་དོག་འཛིན་པ་བྲལ།",
    "དེ་ནི་ལྷ་མཉེས་ཤིང་རང་གི་འདོད་ཡོན་གྱི་རང་བཞིན་ཤེས་པའི་སྒོ་ནས་ལོངས་སྤྱོད་པས།",
    "ཧཱུྃ་གིས་དག་པ་བདུད་རྩིའི་རྒྱ་མཚོར་བསྒྱུར་བས་ཟེག་མ་ལས་འདོད་ཡོན་གྱི་ལྷ་མོ་འཕྲོས།",
    "གཉིས་པ་ཀུན་སྣང་གི་ཏིང་འཛིན།",
    "འབྱུང་ལྔའི་དྭངས་བཅུད་ཡེ་ཤེས་ལྔའི་ཡོན་ཏན་དུ་གནས་པ་བསྡུས་ཏེ་ཞུ་བ་ལས་རྟོག་བྲལ་རང་གི་སེམས་དབུགས་དྲོད་ཁྲག་ཤ་རུས་པ་དང་ཕྱི་ནང་གི་འབྱུང་ལྔ་ཡུམ་ལྔའི་ཀློང་དུ་གསལ་གདབ་པ་ཧཱུྃ་ལས་ཨེ་ཆད་ནམ་མཁར་གྱུར།",
    "མཆོད་རྟེན་གྱི་བུམ་པ་ཡངས་ཤིང་རྒྱ་ཆེ་བའི་ནང་དུ་རྒྱུ་ཡི་ཡི་གེ་ཧཱུྃ་ཆད་པ་དེ་ལས་མར་མེའི་འོད་སྤྲོས་པ་ལྟར་གསེར་གྱི་རྡོ་རྗེ་རྒྱ་གྲམ་རྭ་སྤྲག་གི་དྲྭ་མིག་རྣམས་སུ་རྡོ་རྗེ་ཚྭ་ཚྭ་ཆི་ལི་ལི་འཁོལ་བ།",
    "གནས་ལུགས་ཇི་ལྟ་བའི་དོན་གྱི་འོག་མིན་རང་སྣང་རྣམ་དག་གི་གཞལ་ཡས་བྱང་ཆེན་མཆོད་རྟེན་ཕྱི་ནང་སྒྲིབ་བྲལ་དེའང་གདན་ཁྲི་རི་རབ་དང་བཅས་པ་རྩ་འཁོར་ལྔ་དང་།",
    "ཡ་མ་ཏི་ར་བཾ་ཞེས་པས་གཤིན་རྗེ་ཕོ་མོའི་གདན།",
    "དེའི་སྟེང་དུ་མ་ཧེ་གླང་རྒོད་ཕོ་མོ་གཉིས་གཉིས་ཕྱོགས་བཞིར་བསྣོལ་བའི་གདན་ནི།",
    "དུས་གསུམ་སྒྲིབ་མེད་དབྱིངས་ཡེ་གཉིས་སུ་མེད་པར་གཟིགས་པའི་ཞལ་རེ་རེ་ལ་དམར་ལ་ཟླུམ་པའི་སྤྱན་གསུམ་གསུམ་གཡོ་ཞིང་འཁྲུག་པའི་སྡང་མིག་དང་ལྡན་པ།",
    "དུག་གསུམ་ཉེས་ཚོགས་ཐལ་བར་བརློག་པའི་བརྡར་ཐ་མས་རྡོ་རྗེ་རྩེ་དགུ་པ་བསྣམས་པ།",
    "མ་རིག་ཉོན་མོངས་བསྲེགས་པའི་བརྡར་འོག་མས་སྡིག་མཛུབ་མཛད་པ་རྩེ་མོ་ལས་མེ་འབར་བ།",
    "དེ་ཡང་ཐོད་སྐམ་དབུས་མར་བུདྡྷ་ཁྲག་འཐུང་།",
    "རང་ཕྱག་རྒྱ་ཟིལ་གནོན་གྱི་བ་སྤུའི་རྩེ་མོ་དང་བུ་ག་ཐམས་ཅད་དུའང་ཁྱུང་ནག་མེའི་གཤོག་པ་ཅན་རྡོ་རྗེ་རྩེ་ལྔ་པས་གཏམས་པ་ལས་མེ་སྟག་འཕྲོ་བ།",
    "འཇིག་ཚོགས་ལྟ་ངན་ཉེར་གཅིག་བཅོམ་པའི་བརྡར་ཐོད་པ་ར་རི་ཉི་ཤུ་རྩ་ཅིག་གི་མགུལ་བརྒྱན་བྱས་པ།",
    "དེ་དག་གིས་ཕུད་ཕུད་ཀྱིས་སྒྲ་འབྱིན་ཞིང་།",
    "ཐལ་ཆེན་གྱི་ཚོམ་བུ་བྷནྡྷའི་དབྱིབས་ཅན་གྱིས་སྨིན་མཚམས་དང་སྐུའི་སུལ་བྱུག་པ།",
    "ཞག་གི་ཟོ་རིས་ཀྱི་རྡོ་རྗེ་རྩེ་ལྔའི་དབྱིབ་ཀྱིས་ལྐོག་མ་དང་བྲང་ཤལ་བ།",
    "བདག་མེད་རྟོགས་པའི་ཤེས་རབ་མཚོན་པའི་བརྡར་ཡེ་ཤེས་ཀྱི་མེ་འོད་རང་ལུས་ལས་འཕྲོས་པའི་མེ་རི་དང་མེ་དཔུང་གི་ཚྭ་ཚྭ་འཕྲོ་བའི་ནང་དུ་བཞུགས་པ།",
    "ཧ་ཧ་ཞེས་ཁྲོ་བོའི་གད་མོ་རྒོད་པ།",
    "ཧཱུྃ་ཕཊ་ཞེས་དྲག་ཤུལ་རྔམ་པའི་ཉམས་སྟེ་གསུང་གི་གར་གསུམ་གྱིས་སྲིད་གསུམ་གཡོ་བའི་གསུང་རྡོ་རྗེའི་ང་རོའི་འཇིག་རྟེན་གྱི་ལྷ་ཀླུ་གཟའ་སྲིན་རྒྱལ་ཐེའུ་སྔངས་ཞིང་བརྒྱལ་བ།",
    "ཐུགས་རྗེའི་དཔྱང་ཐག་གིས་མི་གཏོང་བས་ངོ་མཚར་ཆེ་བ་སྟེ།",
    "ཁྲག་ཞག་ཐལ་ཆེན་བྱུག་པའི་རྫས་གསུམ་བཅས་བརྒྱད་དོ།",
    "ཤེས་བྱའི་བློ་གྲོས་པདྨ་ལྟར་རྒྱས་པའི་གཡོན་པའི་ཐེབ་སྲིན་གྱིས་ཨུཏྤལའི་ཡུ་བ་ཐུགས་ཀར་འཛིན་པའི་འདབ་མ་སྙན་གྱི་ཐད་ཀར་ཁ་བྱེ་བ་རྒྱས་པའི་སྟེང་དུ་ཇི་ལྟ་མཁྱེན་ཅིང་ཇི་སྙེད་གཟིགས་པའི་བརྡར་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་པོ་ཏི་བསྣམས་པ།",
    "སྲིད་ཞིའི་མཐའ་ལ་མི་གནས་པའི་བརྡར་ཞབས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་དུ་བཞུགས་ཤིང་།",
    "མར་གྱི་རྭ་ལྔ་ལ་དབུས་རྭ་དབྱིངས་ཕྱུག་དཀར་མོ་ཞལ་ནང་བསྟན།",
    "བྷྱོ་སྨུག་ནག་འོད་དང་བཅས་པ་གཡོན་དུ་ཆད་པ་ལས་འོད་འཕྲོས་དོན་གཉིས་བྱས་ཚུར་འདུས་ཡོངས་སུ་གྱུར་པ་ལས་འདོད་ཆགས་རྣམ་དག་སོར་རྟོག་ཡེ་ཤེས་ཀྱི་རང་གཟུགས་སྦྱོར་ཡུམ་མ་མོ་ཁྲག་མིག་མ།",
    "མཚན་རྟོག་གི་སྒྲིབ་གཡོག་བྲལ་བའི་སྐུ་གཅེར་བུ་རྒྱན་མེད་པ།",
    "ལས་ཀྱི་ཞེ་སྡང་གཅོད་པའི་གཟིག་གི་ཤམ་ཐབས་ཅན།",
    "འཁོར་མ་མོ་བྱེ་བ་ས་ཡས་བསྐོར་བ་དང་བཅས་པ།",
    "མི་ལྤགས་གི་གཡང་གཞི་དམར་ཙ་རེ་བ་སྐུ་ལ་གསོལ་བ།",
    "སྐུ་སྟོད་ལ་གནམ་ལྕགས་གི་ཞུན་ཁྲབ་གསོལ་བ།",
    "ཕྲག་དོག་དག་པ་བྱ་གྲུབ་ཡེ་ཤེས་ཀྱི་རང་གཟུགས་རྒྱབ་ཏུ་གསུང་གི་སྤྲུལ་པ་སྲོག་བདག་ནག་པོ།",
    "སྦྲུལ་ནག་གི་རལ་པ་སྤྱི་བོར་བཅིངས་པ།",
    "འཁོར་དུ་གསུང་གི་སྤྲུལ་པ་བྱེ་བ་ས་ཡས་བསྐོར་བ།",
    "དེ་གཉིས་ཀྱི་ཐུགས་ཀར་ཡ་དམར་ནག་གི་མཐར་སརྦ་ཙིརྟ་གཟེར་ཐུམ་བྷིག་ནན།",
    "དེ་རྣམས་ཀྱི་ཞལ་ཕྱག་ཕྱག་མཚན་སོགས་འདོན་ཆར་གསལ་བ་བཞིན་ལ་དོན་རྟགས་སོགས་གོང་གི་ཡབ་ཡུམ་སྲས་གསུམ་གྱིས་ཤེས་པར་འགྱུར་བས་འདིར་མ་སྨོས།",
    "གཡོན་དུ་མོ་རྒྱུད་ཁྲོ་མོ།",
    "སླར་ཡང་རང་གི་ཐུགས་ཀའི་ཧཱུྃ་ལས་ཧཱུྃ་འཕྲོས་པ་ལས་ཁྲོ་བོ་གཡས་སྐོར་དང་།",
    "བྷྱོ་འཕྲོས་པ་ལས་ཁྲོ་མོ་གཡོན་སྐོར་དང་དེ་རྣམས་གྲངས་མེད་མཚོན་ཆ་སྣ་ཚོགས་ཐོག་པ་བསྲུང་བའི་ཁྲོ་བོ་ཁྲོ་མོ་གཡས་གཡོན་དུ་ཞལ་ནང་དུ་གྱུ་ནས་བསྲུང་བའི་གུར་ཁང་དུ་གྱུར་པར་བསམ་པ་དང་།",
    "རང་གི་མདུན་ཕྱོགས་ནས་བརྩམས་ཏེ་ཕྱོགས་མཚམས་སྟེང་འོག་ཐམས་ཅད་དང་།",
    "དེའི་ཕྱི་རོལ་དུ་ཨོཾ་སྥ་ར་ཎ་ཕཊ་ཅེས་པས་གཟུགས་ཕུང་གནས་དག་རྣམ་སྣང་གི་ངོ་བོ་ཁྲོ་བོ་དཀར་པོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཏྲཾ་སྥ་ར་ཎ་ཕཊ་ཅེས་པས་ཚོར་བ་གནས་དག་རིན་འབྱུང་གི་ངོ་བོ་ཁྲོ་བོ་སེར་པོ་མཉམ་ཉིད་ཡེ་ཤེས་ཀྱི་རང་རྩལ་ནོར་བུ་སེར་པོ་ཆ་དགུ་པ་ཐོགས་པ་དང་།",
    "དེའི་ཕྱི་རོལ་དུ་རཾ་སྥ་ར་ཎ་ཕཊ་རཾ་ཛྭ་ལ་མཎྜལ་ཞེས་པས་འདོད་ཆགས་མེ་ཁམས་རྣམ་དག་གོས་དཀར་མོའི་རང་བཞིན་མེ་དཔུང་འབར་བའི་གུར་ཁང་ནང་དུ་པདྨ་རིགས་ཀྱི་ཁྲོ་བོ་དམར་ནག་མེ་དཔུང་ཐོགས་པས་གང་ཞིང་།",
    "ནམ་མཁའི་རྡོ་རྗེ་ཕྲ་མོའི་ཚོགས་དང་།",
    "མ་སོང་བ་ཐམས་ཅད་ཐལ་བ་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་གྱུར།",
    "སེམས་ཉིད་རིག་སྟོང་གི་གཤིས་ཡེ་ཤེས་སེམས་དཔའ་གདོད་ནས་འདུ་འབྲལ་མེད་པ་ཀུན་ཁྱབ་ཏུ་བཞུགས་ཀྱང་ཚུལ་བཞིན་མ་རྟོགས་པས་གནས་སྐབས་གཉིས་འཛིན་གྱི་དྲི་མ་སྦྱང་བའི་སླད་དུ་བདག་དམ་ཚིག་པའི་ལྷ་ཚོགས་ཐམས་ཅད་ཀྱི་སྤྱི་བོར་འཁོར་ལོ་དཀར་པོ་རྩིབས་བརྒྱད་ཀྱི་ལྟེ་བར་ཨོཾ་དཀར་གྱིས་མཚན་པ།",
    "དད་པ་དང་ནི་དམ་ཚིག་གི་སོགས་ཀྱིས་སྤྱན་དྲངས་ནས་བཞུགས་སུ་གསོལ་བའི་མཐར་ཏིཥྛ་ལྷན་ཞེས་པས་སྔོན་གྱི་ཐུགས་དམ་ལས་མི་འདའ་བར་སྒྲུབ་པོས་དད་དམ་གྱིས་བསྐུལ་བས་སྤྱན་དྲངས་ནས་བཞུགས་སུ་གསོལ་བ་དང་།",
