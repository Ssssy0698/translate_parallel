    "མི་བསྐྱོད་པ་སྒྲུབ་པ་གསུངས་པ།",
    "དེ་ལྟ་བུས་ཕྱག་བྱས་པས་ཁམས་གསུམ་རྡོ་རྗེ་ཆེན་པོའོ།",
    "འོད་དཔག་མེད་ཀྱི་སྒྲུབ་པ་གསུངས་པ།",
    "རྡོ་རྗེ་དཀྱིལ་འཁོར་ནི་མངོན་དགའ་ལ་སོགས་པར་རོ།",
    "དོན་ཡོད་གྲུབ་པའི་སྒྲུབ་པ་གསུངས་པ།",
    "མི་མཆོག་གསང་བ་འཛིན་པར་འགྱུར།",
    "ཨོཾ་ཞེས་པ་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་པས་གོང་དུ་གསུངས་པ་ཨོཾ་ལས་བསྐྱེད་པར་བྱའོ།",
    "དེ་ལྟར་སྣང་བ་མཐའ་ཡས་དང་མི་བསྐྱོད་པའི་ཡང་དེའི་བསྒྲེ་བ་གསུངས་པ།",
    "ད་ནི་གོང་དུ་གསུངས་པའི་འཁོར་ལོ་དེ་ལྷན་ཅིག་པའི་རྣལ་འབྱོར་པས་དང་པོའི་གནས་དེ་ལག་ཏུ་བསྒོམས་ནས་ཇི་སྐད་དུ་གསུངས་པ་ཐོབ་པར་འགྱུར་བ་གསུངས་པ།",
    "མཁའ་དབྱིངས་གསལ་བའི་དཀྱིལ་འཁོར་གནས་པར་ཞེས་པ་ནི།",
    "རྣམ་པར་སྣང་མཛད་རབ་ཏུ་བསྒོམ།",
    "ཞེས་པ་ནི་དང་པོའི་སྐྱེས་བུ་ལས་རྣམ་པར་སྣང་མཛད་བསྐྱེད་པའི་ཆོ་ག་བཞི་རྫོགས་པས་བྱིན་གྱིས་བརླབས་ཏེ་ཞེས་སོ།",
    "ཉི་མ་བདུན་ལ་སོགས་པར་དུ་བ་འཐུལ་བ་དང་།",
    "ལག་ཏེ་འབར་བའི་སྟེང་དུ་སུཾ་བསམས་པས་འབབ་པར་འགྱུར་རོ།",
    "དེ་ནས་དེའི་སྦྱོར་བ་ལ་ལྷག་པར་གནས་པས་ཇི་སྐད་གསུངས་པའི་ཡོན་ཏན་དུ་འགྱུར་རོ་ཞེས་སོ།",
    "ཞེས་ཏེ་དེའི་ལྟེ་བར་དེའི་རིགས་ཀྱི་ལྷ་རྣམས་བསྒོམས་པས་འོད་ཟེར་སྤྲོ་བ་ལཾ་སོགས་པ་གོང་མ་ལྟར་དཔག་པར་བྱའོ།",
    "ཕྱི་མ་རྣམས་ལ་ཡང་དེ་ཁོ་ན་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "མི་བསྐྱོད་པའི་རྣལ་འབྱོར་རྡོ་རྗེ་གཟུང་བ་གསུངས་པ།",
    "འོད་དཔག་མེད་ཀྱི་རྣལ་འབྱོར་པས་པདྨོ་གཟུང་བ་གསུངས་པ།",
    "དོན་ཡོད་གྲུབ་པའི་རྣལ་འབྱོར་པས་རལ་གྲི་གཟུང་བ་གསུངས་པ།",
    "རྡོ་རྗེ་ཁྱད་པར་གྱིས་སྒྲུབས་ན།",
    "རྣམ་པར་སྣང་མཛད་དང་།",
    "ད་ནི་ལས་ཀྱི་ཁྱད་པར་ལས་དགུག་པའི་སྦྱོར་བའི་གནས་གསུངས་པ།",
    "ཐམས་ཅད་རྣམ་པར་འདུ་བ་ནི་འགུགས་པ་ལ་ཤིས་པའི་གནས་ཏེ་གཞན་ལས་ཀྱང་།",
    "དགུག་པ་བསྒྲུབ་པ་ཁྱད་པར་ཤེས།",
    "འགུགས་པ་ཐམས་ཅད་ཀྱི་སྤྱིའི་ཆོ་གས་གསུངས་པ།",
    "ལོངས་སྤྱོད་གསུམ་པའི་རྣམ་པར་མཚན།",
    "རྡོ་རྗེ་གསུམ་གྱིས་དགུག་ཅིང་ལོངས་སྤྱད་པར་བྱའོ་ཞེས་སོ།",
    "ད་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་དང་ལྡན་པར་བསམ་གཏན་གྱི་དགུག་པ་གསུངས་པ།",
    "རྣམ་པར་སྣང་མཛད་ཅེས་པ་ལ་སོགས་པའོ།",
    "རྣམ་པར་སྣང་མཛད་འཁོར་ལོ་མཆོག།",
    "ཅེས་པ་ནི་སྲུང་བའི་འཁོར་ལོ་ལ་སོགས་པས་ཇི་སྲིད་རྣམ་པར་སྣང་མཛད་ཀྱི་འཁོར་ལོ་བསྐྱེད་པའི་ཆོ་ག་ཉི་ཤུ་རྫོགས་པར་བྱས་པའོ།"
  ]
}