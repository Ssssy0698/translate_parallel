    "དེས་མུ་གེ་ལོ་བཅུ་གཉིས་སུ་བྱུང་ན་སྲོག་ཆགས་བརྒྱ་སྟོང་ཕྲག་དུ་མ་དག་གི་ཁ་ཟས་སྦྱར་ཏོ།",
    "ཁྱོད་ཀྱིས་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "ངས་མུ་གེ་ལོ་བཅུ་གཉིས་སུ་བྱུང་བ་ན་སྲོག་ཆགས་བརྒྱ་སྟོང་ཕྲག་དུ་མ་དག་གི་ཁ་ཟས་སྦྱར་ཏོ།",
    "བདག་གི་འབྱོར་པ་མཐོང་ནས་ནི།",
    "གང་གིས་ཕུན་སུམ་འཐོབ་པ་ཡི།",
    "གང་གིས་སྐྱེས་བུ་བརྒྱ་ཕྲག་ཐིབས་མནན་ཅིང་།",
    "བདག་གི་དཔའ་བོའི་དཔའ་རབ་ཡིན་པར་སེམས།",
    "ཡུལ་ཡང་བཟའ་བ་དང་བཏུང་བ་ཤིན་ཏུ་མོད་ལ།",
    "ཡི་ཆད་པས་རང་གི་སྲོག་ལ་ཡང་མི་ལྟ་བར་ཡུལ་ཡོངས་སུ་སྤངས་ཏེ་བྱང་ཕྱོགས་ཀྱི་ལྔ་ལེན་པའི་རྒྱལ་པོའི་ཡུལ་དུ་དོང་ནས་གནས་སོ།",
    "སྐྱེད་མོས་ཚལ་དང་ལྷ་ཁང་རྣམས་ནི་ཞིག་རལ་དུ་གྱུར་པར་མཐོང་ངོ།",
    "སྐྱེད་མོས་ཚལ་དང་ལྷ་ཁང་རྣམས་ནི་ཞིག་རལ་དུ་གྱུར།",
    "དེས་ནས་གཞི་ལྷག་པར་ལོ་ཏོག་དང་ལྡན་པས་ཡུལ་ཡང་བཟའ་བ་དང་བཏུང་བ་ཤིན་ཏུ་མོད་ལགས་སོ།",
    "རྒྱལ་པོས་སྨྲས་པ་ཤེས་ལྡན་དག་གང་གིས་ན་ཀླུའི་བུ་དེ་འདིར་ཁུགས་པར་འགྱུར་བའི་ཐབས་ལྟ་ཅི་ཡོད།",
    "ལྷ་རིག་སྔགས་དང་གསང་སྔགས་འཆང་དག་གིས་དེ་ཁུགས་པར་འགྱུར་གྱིས།",
    "དེ་དག་བཙལ་དུ་གསོལ་དེ་ནས་རྒྱལ་པོས་གསེར་གྱི་ཐུམ་པོ་རྒྱལ་མཚན་གྱི་རྩེ་མོ་ལ་བཅིངས་ནས་ཡུལ་ཐམས་ཅད་དུ་དྲིལ་བསྒྲགས་ཏེ།",
    "གང་གིས་བྱང་ཕྱོགས་ལྔ་ལེན་པའི་ཡུལ་ནས་ཀླུའི་བུ་སྐྱེ་བ་སྣ་ཚོགས་པ་ཁུགས་ན་དེ་ལ་གསེར་གྱི་ཐུམ་པོ་འདི་སྦྱིན་ནོ།",
    "ཇི་ཙམ་ན་སྤྲུལ་ཁས་སྡིགས་བཞིག་བློན་པོ་རྣམས་ཀྱི་དྲུང་དུ་སོང་ནས་སྨྲས་པ།",
    "བདག་ལ་གསེར་གྱི་ཐུམ་པོ་འདི་སྩལ་ན་བདག་གིས་ཀླུའི་བུ་སྐྱེ་བ་སྣ་ཚོགས་པ་ཕྲོགས་ཏེ་ཁྲིད་དེ་མཆིའོ།",
    "དེ་ནས་གཏོར་མ་དང་ཡོ་བྱད་ཀྱི་ཕྱིར་སླར་སོང་ནས་བློན་པོ་རྣམས་ལ་སྨྲས་པ།",
    "སྤྲུལ་ཁས་སྡིགས་པ་ད་ཡང་དེས་མཐོང་ནས་དེ་ནི་བདག་འཕྲོག་ཏུ་འོངས་ཏེ་ཞག་བདུན་གྱི་ཉིན་པར་བདག་ཕྲོགས་ནས་ཕ་མ་དང་བྲལ་བ་ལས་བྱུང་བའི་སྡུག་བསྔལ་ཆེན་པོ་བདག་གིས་མྱོང་བར་འགྱུར་ན་ཇི་ལྟར་བྱ་སུ་ལ་སྐྱབས་བཙལ་སྙམ་པ་དང་།",
    "དེ་ནས་མིའི་ཆ་བྱད་དུ་བྱས་ཏེ་རྔོན་པ་སྤང་ལེབ་ཅན་གྱི་དྲུང་དུ་སོང་ནས་སྨྲས་པ།",
    "སུའི་མཐུ་ལས་གྱུར་པ་ཇི་ག་ཁྱོད་ཀྱིས་ཤེས་སམ།",
    "དེས་ན་ས་གཞི་ལྷག་པར་ལོ་ཏོག་དང་ལྡན་པས་ཡུལ་ཡང་བཟའ་བ་དང་བཏུང་བ་མོད་པར་གྱུར་ཏོ།",
    "སྐྱེ་བ་སྣ་ཚོགས་པས་སྨྲས་པ་གལ་ཏེ་འགའ་ཞིག་གིས་ཀླུའི་བུ་དེ་ཡུལ་འདི་ནས་ཕྲོགས་ན་ཀླུའི་བུ་དེ་ཅིང་འགྱུར།",
    "རྒྱལ་པོ་དང་ཡུལ་མིས་ཕྲོགས་ན་དེ་ལ་ཁྱོད་ཀྱིས་ཇི་ལྟར་བྱ།",
    "ཁྱོད་ཀྱིས་ཀླུའི་བུ་དེ་གང་ཡིན་པ་ཤེས་སམ་མི་ཤེས་སོ་དེ་ང་ཉིད་ཡིན་ན་ལྷོ་ཕྱོགས་ལྔ་ལེན་པའི་སྤྲུལ་ཁས་སྡིགས་པ་ང་འཕྲོག་པར་བྱེད་དེ།",
    "དེ་གཏོར་མ་དང་ཡོ་བྱད་ཀྱི་ཕྱིར་སླར་སོང་ནས་ཞག་བདུན་གྱི་ཉིན་པར་འོང་བར་འགྱུར་ཏེ།",
    "འོངས་ནས་མཚོ་ངོགས་སུ་སེང་ལྡེང་གི་ཕུར་པ་གྲྭ་བཞིར་བཙུགས་ལ་ཚོན་སྐུང་སྣ་ཚོགས་ཀྱིས་བྲེས་ཏེ་གསང་སྔགས་རྗོད་པར་བྱེད་ཀྱིས།",
    "མ་བསྡུས་ན་ཁྱོད་ཀྱི་མགོ་དྲུང་ནས་བཅད་དེ་ས་ལ་བོར་ར་རེ་ཞེས་སྨྲོས་ཤིག།",
    "གལ་ཏེ་ཁྱོད་གཅིག་པུ་ལ་ཕན་ཐོགས་ན་ཡང་དེ་བཞིན་དུ་ཁོ་བོ་ཁོ་ནས་བྱ་ན་ཡུལ་མཐའ་དག་ལ་ཕན་ན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཏེ།",
    "ཁོ་བོས་སྐྱབས་བྱས་སོང་ཤིག།",
    "ཁྱོད་ཀྱིས་ངེད་ཀྱི་ཡུལ་ན་གནས་པའི་ཀླུའི་བུ་གསང་སྔགས་ཀྱིས་དབྲོག་གམ།",
    "གསང་སྔགས་སླར་སྡུས་ཤིག་མ་བསྡུས་ན་ཁྱོད་ཀྱི་མགོ་དྲུང་ནས་བཅད་དེ་ས་ལ་བོར་ར་རེ་དེ་ནས་སྤྲུལ་ཁས་སྡིགས་པ་སྡུག་བསྔལ་ཉམས་སུ་མྱོང་བས་ཉམ་ཐག་ཅིང་འཆི་བའི་འཇིགས་པས་སྐྲག་ནས་གསང་སྔགས་བརྟུལ་བ་དང་།",
    "ཁྱོད་ནི་ཁོ་བོའི་མ་ཡིན་ལ་ཁྱོད་ནི་ཁོ་བོའི་ཕ་ཡིན་ཏེ།",
    "འདི་ལྟར་ཁྱོད་ལ་བརྟེན་པས་ཁོ་བོ་ཕ་མ་དང་བྲལ་བ་ལས་བྱུང་བའི་སྡུག་བསྔལ་མ་སྐྱེས་སོ།",
    "ཚུར་ཤོག་གནས་སུ་འདོང་ངོ་ཞེས་དེས་དེ་གནས་སུ་ཁྲིད་དེ་སོང་ནས་བཟའ་བ་དང་བཏུང་བ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་ཚིམ་པར་བྱས་ཏེ།",
    "དེ་དག་གིས་ཀྱང་དེ་ལ་དམ་པ་སྦྱིན་པར་བྱེད་དེ།",
    "དེ་ནས་རྔོན་པ་དེ་དོན་ཡོད་པའི་ཞགས་པ་ལ་ཆགས་པ་སྐྱེས་ནས་དྲང་སྲོང་གི་ཚིག་མཉན་ཏེ་སླར་ཀླུའི་གནས་སུ་སོང་བ་དང་།",
    "ཁྱོད་ལ་འདི་ཅི་དགོས་ཁོ་བོ་ཅག་ལ་ནི་དགོས་རབ་སྟེ།",
    "གང་གི་ཚེ་ནམ་མཁའ་ལྡིང་གིས་གནོད་པ་བྱས་པ་དེའི་ཚེ་འདིས་ཁོ་བོ་ཅག་བསྲུང་བར་འགྱུུར་རོ།",
    "དོན་ཡོད་པའི་ཞགས་པ་ཁྱེར་ཏེ་ཀླུའི་གནས་ནས་བྱུང་ནས་རང་གི་ཁྱིམ་དུ་སོང་ངོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རྒྱལ་པོ་ནོར་ཅན་བཙུན་མོ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་དགའ་བར་བྱེད།",
    "བུ་མོ་ཡང་མེད་ནས་ལག་པ་ལ་འགྲམ་པ་གཏད་དེ་བདག་གི་ཁྱིམ་དུ་ནོར་རྫས་འདི་སྙེད་ཅིག་བསགས་ཀྱང་བདག་ལ་བུ་ཕོ་ཡང་མེད།",
    "བུ་མོ་ཡང་མེད་པས་བདག་འདས་ན་བདག་གི་གདུང་རྒྱུད་འཆད་ཅིང་ཡུལ་འཆོར་བ་དང་།",
    "ཁྱོད་ལ་སྲས་མཆིས་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་ན་གང་གསོལ་བ་འདེབས་པའི་རྒྱུ་ལས་བུ་ཕོ་དང་བུ་མོ་དག་སྐྱེའོ་ཞེས་བྱ་བའི་གཏམ་དེ་ལྟ་བུ་ཡོད་དེ།",
    "གལ་ཏེ་དེ་ལྟར་འགྱུར་དུ་ཟིན་ན་རེ་རེ་ལ་ཡང་འདི་ལྟ་སྟེ་དཔེར་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་བཞིན་དུ་བུ་སྟོང་སྟོང་ཡོད་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་གནས་གསུམ་པོ་དག་མངོན་དུ་གྱུར་པ་ལས་བུ་ཕོ་དང་བུ་མོ་དག་སྐྱེ་བར་འགྱུར་ཏེ།",
    "གནས་གསུམ་པོ་དེ་དག་མངོན་དུ་གྱུར་པ་ལས་བུ་ཕོ་དང་བུ་མོ་དག་སྐྱེ་བར་འགྱུར་རོ།",
    "ཁྱེའུ་ཤེས་ཤིང་བུ་མོ་ཤེས་པ་སྟེ་གལ་ཏེ་ཁྱེའུ་ཡིན་ན་དཀུ་གཡས་པར་རྟེན་ཅིང་འདུག་ལ་གལ་ཏེ་བུ་མོ་ཡིན་ན།",
    "དེ་ཡིད་དགའ་ཞིང་ཡིད་དགའ་ནས་ཁྱོ་ལ་སྨྲས་པ།",
    "བསྐ་བ་སྤངས་པའི་ཟས་དག་དང་དོ་ཤལ་དང་སེ་མོ་དོ་དང་།",
    "རྒྱན་གྱིས་བཀླུབས་པའི་ལུས་ལྷའི་བུ་མོ་དགའ་བའི་ཚལ་ན་རྣམ་པར་སྤྱོད་པར་ལྟ་བུ་དང་།",
    "བཙུན་མོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་སྨྲས་པ་ལྷ་དགྱེས་པ་བསྐྱེད་དུ་གསོལ།",
    "ཁྱོད་ཀྱི་སྲས་པོ་ཞིག་བལྟམ་མོ།",
    "དེ་མ་མ་བརྒྱད་པོ་དག་གིས་འོ་མ་དང་ཞོ་དང་མར་དང་ཞུན་མར་དང་མར་གྱི་ཉིང་ཁུ་དང་གཞན་ཡང་ཡོ་བྱད་ཀྱི་བྱེ་བྲག་གཙོ་བོ་དག་གིས་སྲིང་བར་བྱེད་སྐྱེད་པར་བྱེད་ཅིང་རྫིང་ན་གནས་པའི་པད་མ་བཞིན་དུ་མྱུར་དུ་སྐྱེད་པར་བྱེད་དོ།",
    "གང་གི་ཚེ་ཆེན་པོར་གྱུར་པ་དེའི་ཚེ་ཡི་གེ་སློབ་ཏུ་བཅུག་སྟེ་ཞེས་བྱ་བ་ནས།",
    "སྐྱེད་མོས་ཚལ་རྣམ་པ་གསུམ་པོ་དགུན་གྱི་དང་།",
    "སྐྱེད་མོས་ཚལ་རྣམ་པ་གསུམ་པོ་དགུན་གྱི་དང་།",
    "དེ་ནས་གཞོན་ནུ་ནོར་བཟངས་སྟེང་གི་ཁང་བཟངས་ཀྱི་གཞི་ལ་སྐྱེས་པ་མེད་པར་སོང་ནས་སིལ་སྙན་རྣམས་ཀྱིས་རྩེ་བར་བྱེད།",
    "དེས་རི་བོ་དེའི་ཤོད་ན་དྲང་སྲོང་གི་བསྟི་གནས་མེ་ཏོག་དང་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ།",
    "སེན་མོ་དང་།",
    "ཤིང་གོས་གྱོན་པ་ཞིག་ཤིང་གི་དྲུང་དུ་གནས་བཅས་ཏེ་རྩྭའི་སྤྱིལ་བུ་ན་འདུག་པ་མཐོང་ངོ།",
    "མཐོང་ནས་རྐྱང་རྐང་པ་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཐལ་མོ་སྦྱར་ནས་དྲིས་པ།",
    "ལེགས་ལྡན་ཕྱོགས་འདིར་ཁྱོད་བཞུགས་ནས་ཡུན་ཇི་སྲིད་ཅིག་ལགས་ལོ་བཞི་བཅུ་ལོན་ནོ།",
    "བཞིན་བཟངས་ཁྱོད་ཀྱིས་མཚོ་འདི་མཐོང་ངམ།",
    "ཤིན་ཏུ་དྲི་ཞིམ་པའི་མེ་ཏོག་གིས་བསྐོར་བའི་ཆུའི་རྫིང་འདིར་ཚེས་བཅྭ་ལྔ་ལ་མིའམ་ཅིའི་རྒྱལ་པོ་ལྗོན་པའི་བུ་མོ་ཡིད་འཕྲོག་མ་ཞེས་བྱ་བ་མི་འམ་ཅི་མོ་ལྔ་བརྒྱས་ཡོངས་སུ་བསྐོར་ནས་མགོ་ཁྲུས་དང་བསྐུ་མཉེ་སྣ་ཚོགས་དང་འོངས་ནས་ཁྲུས་བྱེད་དོ།",
    "གླུ་དང་རོལ་མོའི་སྒྲ་སྙན་པས་བྱ་དང་རི་དགས་རྣམས་ཀྱང་ཡིད་འཕྲོག་པར་བྱེད་དོ།",
    "བདག་གིས་ཀླུ་ལས་དོན་ཡོད་པའི་ཞགས་པ་ཐོབ་པ་སྟེས་ཏེ།",
    "དེ་མིའམ་ཅིའི་བུ་མོ་ཡིད་འཕྲོག་མ་ལ་གདབ་བོ་སྙམ་ནས།",
    "ཅི་ཙམ་ན་ཡིད་འཕྲོག་མ་མིའམ་ཅི་མོ་ལྔ་བརྒྱས་ཡོངས་སུ་བསྐོར་ཏེ།",
    "དེས་མིའམ་ཅི་མོ་ཡིད་འཕྲོག་མ་ཟིན་ཏོ།",
    "མིའམ་ཅི་མོའི་ཚོགས་ལྷག་མས་དེ་ཐོས་ནས་ཕན་ཚུན་བརྒྱུགས་ཏེ་མིའམ་ཅི་མོ་ཡིད་འཕྲོག་མ་ལ་བརྟག་པར་བརྩམས་པ་ལས་བཟུང་བར་མཐོང་ངོ།",
    "རྔོན་པ་དེས་མཆོག་ཏུ་གཟུགས་བཟང་མོ་བལྟ་ན་སྡུག་པ་དེ་མཐོང་ངོ།",
    "མ་རབས་ཁྱོད་ནི་ང་ལ་མ་རེག་ཤིག།",
    "ཁྱོད་ཀྱི་འདི་ནི་ཐོག་ཏུ་བབ་མ་ཡིན།",
    "རྔོན་པས་སྨྲས་པ་གལ་ཏེ་ཁྱོད་ལ་བཟུང་ན་འབྲེས་པར་འགྱུར་རོ།",
    "དེས་སྨྲས་པ་ཁོ་མོ་མི་འབྲོས་ཀྱིས་གལ་ཏེ་ཡིད་མི་ཆེས་ན་འདིའི་མཐུས་ཁོ་མོ་སྟེང་གི་ནམ་མཁའ་ལ་འགྲོས་གཙུག་གི་ནོར་བུ་འདི་ཟུང་ཤིག།",
    "རྔོན་པས་སྨྲས་པ་སུ་ཤེས་དེས་དེ་ལ་གཙུག་གི་ནོར་བུ་བྱིན་ནས་སྨྲས་པ།",
    "དེ་ནས་རྔོན་པས་ནོར་བུ་དེ་བླངས་ཏེ་ཞགས་པས་བཅིངས་བཞིན་དུ་ཁྲིད་དེ་སོང་ངོ།",
    "འདི་ཡང་མཆོག་ཏུ་གཟུགས་བཟང་མོ་བལྟ་ན་སྡུག་པ་ཡིན་ཏེ།",
    "མ་ལ་བདག་གིས་འདི་སྐྱེས་ཀྱི་ཚུལ་དུ་བདག་ཉིད་ཀྱིས་དབུལ་ལོ་སྙམ་ནས།",
    "དེ་ནས་དེ་ཞགས་པས་བཅིངས་བཞིན་རྒྱལ་བུ་གཞོན་ནུ་ནོར་བཟངས་གང་ན་བ་དེར་ཁྲིད་དེ་སོང་ནས་ཕྱིན་པ་དང་རྐང་པ་གཉིས་ལ་གཏུགས་ཏེ་སྨྲས་པ།",
    "རྒྱལ་བུ་གཞོན་ནུ་ནོར་བཟངས་ཀྱིས་མིའམ་ཅི་མོ་ཡིད་འཕྲོག་མ་གཟུགས་བཟང་མོ་བལྟ་ན་སྡུག་པ་མཛེས་པ།",
    "བུད་མེད་ཀྱི་མཚན་བཅྭ་བརྒྱད་ཀྱིས་བརྒྱན་པ།",
    "མཁུར་ཚོས་ལྷག་པར་དགའ་བར་བྱེད་པའི་རི་མོའི་ཐིག་ལེ་ཅན་སྨིན་མ་རིམ་གྱིས་མཛེས་ཤིང་འཇར་ལ་བུང་བའི་ཚོགས་ལྟར་གནག་པ།",
    "ལྟོ་གཉེར་མ་ཟབ་མོ་གསུམ་དང་ལྡན་ཞིང་ཡིད་ཙམ་རྙོང་བ།",
    "སེ་མོ་དེའི་སྒྲས་འགྱིང་ཞིང་འགྲོ་བ།",
    "འདོད་ཆགས་ཀྱི་མདའ་རྟག་ཏུ་ཉོན་མོངས་པ་བསྟེན་པ་གོམས་པའི་འདོད་ཆགས་ཀྱི་བདེ་བ་རོ་མྱོང་བ་ལ་བརྐམ་པ་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་ཡུལ་ངན་འགྲོའི་གཡང་ས་ལས་མི་ཟློགས་པ།",
    "བཟང་མོ་ལ་རྗེས་སུ་ཆགས་པའི་སེམས་ཀྱིས་ཤིན་ཏུ་དྲི་མ་ཅན་དུ་བྱས་པ།",
    "དེ་ནས་གཞོན་ནུ་ནོར་བཟངས་ཡིད་འཕྲོག་མ་དང་ལྷན་ཅིག་སྟེང་གི་ཁང་བཟངས་ཀྱི་གཞིར་དོང་ནས་ལྷན་ཅིག་ཏུ་རྩེ་བར་བྱེད།",
    "གཞོན་ནུ་གང་གི་ཚེ་ཡབ་འདས་ནས་ཁྱོད་རྒྱལ་པོར་བཅུག་པ་དེའི་ཚེ་བདག་ལ་ཅི་ཞིག་བགྱི།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་གྲོགས་པོ་བྲམ་ཟེ་ངའི་ཡབ་ཀྱི་མདུན་ན་འདོན་དུ་བཅུག་པ་དེ་བཞིན་དུ་ཁྱོད་ཀྱང་ངའི་མདུན་དུ་འདོན་དུ་གཞུག་གོ་ཞེས་བྱས་པའི་གཏམ་དེ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་བྲམ་ཟེ་མདུན་ན་འདོན་དེས་ཐོས་ནས་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "ངས་ཅི་ནས་གཞོན་ནུ་ཉིད་ཀྱིས་ཀྱང་རྒྱལ་སྲིང་མི་འཐོབ་པ་དེ་ལྟར་བྱ་ན་མདུན་ན་འདོན་དུ་གཞུག་པ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་སྙམ་མོ།",
    "ལྷ་ཅིའི་སླད་དུ་རང་གི་དཔུང་ཉམས་ཤིག་གཞན་གྱི་མཐུ་སྐྱེད་པར་མཛད།",
    "བཙུན་མོ་རྣམས་ཀྱི་གན་དུ་སོང་སྟེ་ཡིད་འཕྲོག་མ་མཐོང་བ་དག་དེ་ཐམས་ཅད་བརྗེད་པར་གྱུར་ཏོ།",
    "ལྷ་གཞོན་ནུ་ནོར་བཟངས་ནི་ཡིད་འཕྲོག་མ་ལ་ལྷག་པར་ཆགས་པས་མཆི་རྡོ་མི་ཐོག་གིས།",
    "དམག་བསྔོགས་ལ་གཞོན་ནུ་བཙུན་མོ་རྣམས་ཀྱི་ནང་ནས་བྱུང་བ་དང་ཅི་ནས་ཀྱང་ཡིད་འཕྲོག་མའི་དྲུང་དུ་མི་མཆི་བར་ཐལ་བྱུང་གཏང་བར་བགྱིའོ།",
    "ཤེས་ལྡན་དག་དཔུང་གི་ཚོགས་སྟ་གོན་གྱིས་ཤིག།",
    "བློན་པོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལས་མཉན་ནས་དཔུང་གི་ཚོགས་གླང་པོ་ཆེ་དང་།",
    "གཞོན་ནུ་དཔུང་གི་ཚོགས་སྟ་གོན་བྱས་ཀྱིས་སོང་ཤིག།",
    "དེས་ཡིད་འཕྲོག་མའི་གཙུག་གི་ནོར་བུ་ཁྱེར་ནས་མའི་དྲུང་དུ་སོང་སྟེ་རྐང་པ་གཉིས་ལ་གཏུགས་ཏེ་སྨྲས་པ།",
    "གཙུག་གི་ནོར་བུ་འདི་ཁྱོད་ཀྱིས་ཤིན་ཏུ་དབེན་པར་སྦོས་ལ་ཡིད་འཕྲོག་མ་འགུམ་པ་ལ་ཐུག་པ་མ་ལགས་པ་ཇི་ལྟར་གྱུར་ཀྱུང་མ་སྩལ་ཅིག་ཅེས་དེས་དེ་སྐད་མ་ལ་བསྒོ་ནས་མཆི་ཕྱག་བྱས་ཏེ་དམག་གི་ཚོགས་དང་རོལ་མོའི་སྒྲ་སྣ་ཚོགས་དང་ཆས་ཏེ་རིམ་གྱིས་ཡུལ་འདས་ནས་རི་འོར་དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་ཤིང་ལྗོན་པ་ཞིག་གི་དྲུང་དུ་བཏབ་སྟེ་འདུག་གོ་།",
    "བདག་གིས་ལམ་འདི་ནས་ལན་མང་པོ་ཞིག་ཏུ་སོང་ན་བདག་གི་བཞོན་པ་ལན་འགའ་ཡང་ཐོགས་པར་མ་གྱུར་ན་གང་གིས་ན་ད་ལྟར་ཐོགས་པ་འདི་ལ་རྒྱུ་ཅི་ཡོད་སྙམ་པ་ལས།",
    "དམག་ལ་ཆས་པས་ཉོན་མོངས་པར་འགྱུར་རོ།",
    "ཁྱོད་ཀྱིས་གཞོན་ནུ་ནོར་བཟངས་རི་འོར་བ་རྣམས་དང་གཡུལ་མ་བཀྱེ་བར་སྲོག་ཆགས་འགའ་ལ་ཡང་གནོད་པར་མ་བྱ་བར་ཕོབ་ཤིག།",
    "གཞལ་མེད་ཁང་གི་ཚད་ཙམ་གྱི་ཤིང་རྟ་རྣམས་སྤྲུལ་ཏོ།",
    "གནོད་སྦྱིན་རྣམས་ཀྱི་རང་གི་མཐུས་རབ་དག་རལ་བར་གྱུར་ཏོ།"
  ]
}