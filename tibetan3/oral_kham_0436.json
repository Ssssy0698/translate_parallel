    "དེ་ནི་ཁྱེད་རང་ནོར་གྱི་འདུག་དབྱིན་ཇིས་ཁྱེད་རང་ལ་ཁྱེད་ཚོ་རྒྱལ་ཁབ་གཅིག་མིན་པ་དང་།",
    "དེ་བཞིན་བྱང་ཕྱོགས་སུ་ཧརིདཱར་བཅས་ཀྱི་གནས་རྣམས་གནས་སྐོར་ཆེད་ཕྱག་བཏབ་པའི་ཀུན་སློང་ཐད་ཁྱེད་རང་གང་དགོངས་ཀྱི་འདུག་གམ།",
    "དེ་ལ་འཁྲུགས་རྩོད་ཡོང་དགོས་འདུག་གམ།",
    "ཧིན་དུ་ཚོས་བ་ཕྱུགས་ལ་སྡུག་པོ་བཏང་སྟེ་གསོད་སྐབས་སྐྱོབ་མཁན་འདུག་གམ།",
    "ཁྱེད་རང་བཞིན་སྐབས་ཤིག་ངས་ཀྱང་དེ་རང་བསམ་གྱི་ཡོད།",
    "ཁྱེད་རང་དགོངས་པ་བཞེས་དང་།",
    "འོན་ཀྱང་དེ་ནི་ཁོ་རང་ལ་རྨི་ལམ་བཞིན་དུ་གྱུར།",
    "ཁྱེད་རང་ལ་ནོར་འཁྲུལ་དེ་ཞུ་རྒྱུའི་ཐབས་ཤེས་བྱ་རྒྱུ་ཡིན།",
    "འོན་ཀྱང་ཁྱེད་ཀྱི་ཆུ་ཚོད་ཉོ་དགོས་ན་ཁྱེད་རང་ལ་རིན་གོང་སྤྲད་དགོས།",
    "ཁྱེད་རང་ལ་ཞུ་འབོད་བྱེད་དགོས།",
    "ཁྱེད་རང་བཅོས་ཐབས་དེ་ལ་འཇིགས་སྣང་ཡོང་རྒྱུར་བརྟེན།",
    "ཁྱེད་རང་ཡང་ཁོའི་ཁ་གཏད་དུ་གྲ་སྒྲིག་བྱས་ཏེ་བསྡད་ཡོད་པར་བརྟེན།",
    "ཁྱིམ་མཚེས་ཚོས་ཁྱེད་རང་ལ་འཁང་ར་བྱས་པར་བརྟེན།",
    "དེར་གང་ཡང་བསམ་གྱི་མི་འདུག་ཅེས་བཤད།",
    "ཁྱེད་རང་ཐེ་ཚོམ་ནང་དུ་ལྷུང་རུང་།",
    "འོན་ཀྱང་ཁྱེད་རང་ཉམ་ཐག་ལ་བརྩེ་བ་ཡོད་ཅིང་།",
    "ཁྱེད་རང་ལྷོད་ལྷོད་བྱས་ཏེ་བསམ་བློ་བཏང་ན་མཁྱེན་ཐུབ།",
    "ཁྱེད་རང་ཁོང་ཁྲོ་མི་ལང་བ་མ་ཟད།",
    "ཚོད་བལྟ་དེ་ལག་ལེན་བསྟར་ཆེད་ཁྱེད་རང་གང་དུ་མ་རབས་ལས་ཀ་བྱེད་པ་དེར་འབྱོར་ཏེ་མདུན་གྱི་སྲོག་བླང་རྒྱུའི་ཚབ་ཏུ་རང་སྲོག་གཏོང་དགོས་པ་ཡིན།",
    "བྱུང་རབས་ནང་རང་བཞིན་མ་ཡིན་པའི་གནས་ཚུལ་རྣམས་འབྲི་ཞིང་།",
    "ཡང་ན་མཇུག་ཏུ་ལུས་པ་དེའི་ཐོག་ང་རང་གཉིས་སེམས་ཁྲལ་བྱེད་དགོས་དོན་མེད།",
    "འདིའི་ཐད་ཁྱེད་རང་གང་དགོངས་ཀྱི་འདུག་གམ།",
    "དེ་ནི་ཁྱེད་རང་ལྟ་བུའི་སློབ་སྦྱོང་ལྡན་པ་རྣམས་ཁོ་ནའི་ཆེད་དུ་བྱེད་ཐུབ།",
    "ཡིན་ནའང་ངས་ནོར་གྱི་འདུག་མེན་ཅེ་སེ་ཊར་ལ་སྐྱོན་འཛུགས་ཇི་ལྟར་བྱེད་ཐུབ་བམ།",
    "བངྒཱལ་གྱི་དཔའ་རྟགས་སྐོར་ཀློག་དུས་ང་དགའ་པོ་བྱུང་།",
    "གཞན་གྱིས་བཏགས་པའི་རས་རྣམས་བཙོང་ཆོག་གལ་ཏེ་དེ་ལྟར་མ་བྱང་བ་ཡིན་ནའང་མི་མང་རང་ངོས་ནས་འཕྲུལ་ཆས་ཀྱིས་བཟོས་པའི་གོས་བེད་སྤྱོད་བྱ་རྒྱུ་དེ་བཀག་འགོག་ཐུབ་པ་ཡིན།",
    "ཁྱེད་རང་དང་ཁོ་བོས་གཞན་གྱིས་བྱེད་པ་ལ་བལྟས་ནས་བསྡད་མི་དགོས་ཤིང་།",
    "ང་ལས་ཁྱེད་རང་ལ་ཕན་ཐོགས་གང་ཡང་མེད།",
    "རང་ལ་འདོད་པའི་དངོས་པོ་དེ་འཕྲལ་དུ་ཐོབ་པའི་ལམ་ལས་སླ་པོ་དེ་འདྲ་གང་ཡང་རང་བྱུང་ཁམས་ཀྱིས་བཟོས་མེད།",
    "ཁྱེད་རང་ཡང་ནོར་གྱི་འདུག་ཚང་མའི་སེམས་ཁྲལ་ང་ལ་མེད།",
    "ཁྱེད་རང་ལ་ཡང་མི་དགོས་པ་ཡིན།",
    "ངས་ང་རང་ལ་ཕན་ཐོགས་བྱེད་ན།",
    "ང་རང་མ་བསྐྱོད་གོང་དུ་སླར་ཡང་ཐེངས་གཅིག་བསྐྱར་ལྡབ་བྱེད་རྒྱུའི་ཆོག་མཆན་ཞུ་རྒྱུ་ཡིན།",
    "དེའི་ངོ་བོ་ཤེས་མི་འདུག་སྙམ།",
    "རང་རང་གོ་བབ་གཟབ་མཆོར་ལེགས་སྤྲས་ནས།",
    "ང་རང་ཡོང་བ་ཐག་རིང་རྒྱང་ནས་ཡོང་།",
    "ང་རང་ཁྲི་གདུགས་ཉི་མ་ཤར་ལམ་ལ།",
    "འཆི་བདག་བདུད་ཀྱི་ཕོ་ཉ་སླེབས་ཙ་ན།",
    "ཞེས་པ་དེ་དོན་དངོས་དང་མཐུན་འདུག་སྙམ་ཞིང་།",
    "ངང་པས་ཐོག་དྲངས་ཆུ་བྱ་རྣམས་དཀྱིལ་གྲལ་དུ་འཁོད་པ་དང་གཞན་གྱི་བྱ་རིགས་རྣམས་རང་རང་སོ་སོའི་གྲལ་གནས་སུ་བསྡད།",
    "རང་རང་ཕུགས་བསམ་མཛེས་རིས་འབྲི་འདོད་པས།",
    "མི་རིང་རང་ལུས་ཞི་བར་འགྱུར་ངེས་སོ།",
    "བགྲང་བར་དཀའ་བའི་ཐོན་རྫས་སྣ་འཛོམས་གདའ།",
    "མི་སྒེར་སོགས་ཀྱིས་ཐོན་རྫས་མང་པོ་བཏོན་འདུག་པ་དཔེར་ན།",
    "ཁྲོམ་རྭའི་ནང་བཟོ་ལས་ཐོན་རྫས་སྣ་ཁ་བརྒྱད་བརྒྱ་ལྷག་ཙམ་དང་ཡུལ་ཁག་སོ་སོའི་དམིགས་བསལ་ཐོན་རྫས་སྣ་ཁ་བརྒྱར་ཉེ་བ་གདའ།",
    "ཁྲོམ་རྭར་མི་ཚོས་རང་ཉིད་ལ་མཁོ་བའི་དངོས་རྫས་འདེམས་ཉོ་བྱེད་རྒྱུ་ཟམ་མི་འཆད་པར་ཉིན་ལྟར་མི་གྲངས་ཉིས་སྟོང་སུམ་སྟོང་ཙམ་འདུག་པས་དངོས་འབྲེལ་མི་ཚོགས་ཀྱི་འཇིང་དུ་བགྲོད་དཀའ་བ་ཞིག་སྣང་།",
    "རིག་རྩལ་དང་ལུས་རྩལ་ཚོགས་ཆུང་སོགས་བཙུགས་འདུག་ཅིང་།",
    "ཇ་ཁང་སྣ་ཚོགས་བཅས་མང་དག་ཅིག་འདུག་པ་དེས་ཚོང་འདུས་སུ་ཕེབས་མི་ཀུན་གྱི་བཟའ་བཏུང་སྟབས་བདེར་གྱུར་ཡོད་པ་དང་།",
    "ཞེས་སྐད་གསང་མཐོན་པོས་གླུ་དབྱངས་ལེན་བཞིན་འདུག།",
    "བམ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "རང་རང་མི་རིགས་སོ་སོའི་དགོས་མཁོར་བསྟུན།",
    "རྒད་པོ་ང་ཡི་སེམས་ལ་ཐེ་ཚོམ་སྐྱེས་ཞེས་བརྗོད་པས་ཚང་མས་ཡག་པོ་འདུག་ཅེསདགའ་བའི་འབོད་སྒྲ་སྒྲོག་བཞིན་པའི་སྐབས་དེར་རྟ་རྒྱུག་འགྲན་བསྡུརབྱེད་མཁན་ཕོ་རྒོད་ཚོ་གཅིག་མཇུག་གཉིས་མཐུད་དུ་འབྱོར།",
    "ཀ་ཀ་ན་སྦྲང་ནོར་བུ་ནི་སྐྱེས་པ་ནས་མ་ཤི་བར་ཚེ་གང་རིང་རང་འགུལངང་དཀའ་ངལ་ཁྱད་བསད་ཀྱིས་འབད་བརྩོན་ལྷོད་མེད་བྱེད་མཁན་སྲོག་ཆགས་ཤིག་ཡིན་ལ།",
    "དེ་མུར་བལྟས་ན་ཁོང་གཉིས་བདེ་སྐྱིད་ཀྱི་པ་ཕའི་འགྲམ་དུ་བསྐྱོད་ནས་གནས་ལུགས་རྒྱུ་རྐྱེན་གསལ་པོ་ཤོད་རྒྱུའི་སྐད་ཆ་བྱས་ཚོད་འདུག་ལ།",
