    "ཞེས་པ་འང་རང་ལྟོས་ཀྱི་ཇོ་བཙུན་རྣམས་ལ་གདམས་པའོ།",
    "དམིགས་པ་མང་པོ་མི་ཤེས་ནའང་རང་ཡི་དམ་དངོས་ཡིན་སྙམ་པའི་ང་རྒྱལ་བརྟན་པ་ཞིག་ཅིས་ཀྱང་དགོས།",
    "དོན་དུ་སྤང་བྱ་དང་གཉེན་པོ་གཉིས་ཀ་སྔ་ཕྱི་མིང་བཏགས་པ་མ་གཏོགས་དྲན་རིག་ཁོ་རང་ཡིན་པས་སྤང་གཉེན",
    "གཞན་ཡང་དུས་བཞིའི་རང་རང་སྣོད་བཅུད་ཀྱིས།",
    "རིང་ཞིག་དུས་ཀྱི་འགྱུར་བས་དགོན་གནས་སོགས།",
    "འདུག་འགྲོ་དཀའ་ཟླ་གྲོགས་བྱེད་རྣམས་སྡུག།",
    "ཡོངས་བཟུང་རང་སེམས་དྲང་པོར་སྲོང་བྱེད་པས།",
    "བེ་རོ་ཙ་ན་དང་།",
    "གཞན་ཡང་ཁོལ་བུ་མང་པོ་ཞིག་བྱོན་པ་རྣམ་གྲངས་བཀྲ་ཤིས་གྲངས་སུ་བསྒྲིགས་པར་མཛད་འདུག་པའི་གཏེར་འབྱུང་ཐམས་ཅད་ནི་བདག་ལྟ་བུས་བསྒྲིག་པར་མི་ནུས་ནའང་།",
    "རྫོགས་པ་ཆེན་པོ་ཀློང་གསལ་ཉི་མའི་རྒྱུད་སྒོམ་གྱིན་བཞུགས་ཡོད་ཙ་ན།",
    "ཟླ་དུས་ཞག་དུས་ན་མའི་དུས་ཀྱང་ནངས་པར་ནས་ཐེམས་པ་ཡིན།",
    "སྤྲང་ཕྲུག་རྣམས་ཀྱིས་འདིར་ཁྱེར་ནས་འདུག་པས།",
    "ཁྱེད་ཀྱི་འདི་ཐམས་ཅད་མཁྱེན་པ་ཨོ་རྒྱན་གྱི་གསུང་ཡིན་འདུག་གོ།",
    "ཕུང་འཚེངས་གང་ཡིན་ནའང་གཏེར་ཡིན་འདུག་པས།",
    "སྒོ་ཞིག་ཏུ་ཆ་བ་འདུག་པ་ལ།",
    "ད་རུང་འཁོར་ལོ་གཅིག་ཡོད་པས་མ་བྱིན་འདུག།",
    "བྲག་ལ་ཀླུ་འཁྱིལ་བ་ས་ལ་ཁ་བ་བབ་པ་ཙམ་འདུག་པའི་འོག་ཏུ་བརྐོས་པས།",
    "ལྷོ་ནུབ་ཀྱི་བྲག་ངོས་ལ་རྡོ་རྗེ་རྒྱ་གྲམ་འདུག་པའི་འོག་ཏུ་ལྡེ་མིག་རྒྱབ་པས།",
    "དེ་ཡང་ཤར་དུང་མཛོད་དཀར་པོ་ནས་ཀ་དག་རང་བྱུང་རང་ཤར་གྱི་སྐོར།",
    "རྫོགས་པ་ཆེན་པོ་རང་བྱུང་རང་ཤར།",
    "སྐུ་ལ་ལྷུམས་སུ་ཞུགས་མཐར་གཙང་དབེན་རྩ་ཁར་མེ་ཕོ་འབྲུག་ལོ་ས་ག་ཟླ་བའི་ཚེས་བརྒྱད་ལ་འཁྲུངས་སྐབས་ནས་བཟུང་ཐུགས་ལ་དྲན་པའི་ཚུལ་སོགས་ངོ་མཚར་ཅན་མང་དུ་འདུག།",
    "ཡབ་ཀྱི་གདུང་རིལ་དང་སྲས་ཀྱི་གདུང་རུས་རྣམས་ལྷ་ཁང་དུ་འདུག་གོ།",
    "བདག་ནི་བེ་རོ་ཙ་ན་འོད་ཀྱི་ལུས",
    "གཏེར་རྣམས་འདོན་པའི་ལུང་ཁྱེད་ལ་བསྟན་འདུག་ལགས།",
    "ཁོ་བོ་བསྡད་པའི་ས་མི་འདུག་གསུངས་ནས།",
    "དེ་སྐབས་ཀྱི་ལས་ཅན་རྣམས་ཀྱི་ལག་ཏུ་ཡང་སྟོབས་ཆེ་བར་བྱུང་འདུག།",
    "ས་ལ་ངེད་རང་རྣམས་ཀྱི་སྒྲུབ་པ་ལ་བར་ཆད་ཅུང་ཞིག་བྱུང་འདུག་པ་འདི་དངོས་གྲུབ་ཏུ་ལེན་ལུགས་ཤེས་དགོས་པས།",
    "འདི་ཉིད་ལ་ལུང་བསྟན་ངན་པ་ཕྱག་བྲིས་གནང་མ་བདེ་བར་འདི་ནས་ཚིག་བར་ཁ་ཡར་མེད་གསུངས་པ་འདུག།",
    "དེ་ནས་དཀར་པོ་ཀུན་དགའ་གྲགས་པ་ལ་རིམ་པ་བཞིན་བརྒྱུད་པ་ཡིན་ཏེ་དར་རྒྱས་བྱུང་འདུག་གོ། ། བེ་རོའི་སྤྲུལ་པ་རྡོ་རྗེ་གླིང་པ་ནི།",
    "གཏོར་གྲལ་གྱི་ཐ་མ་རང་དུ་འཇོག་པ་ད་ལྟའི་ཕྱག་ལེན་ལ་འདུག་གོ།",
    "རིགས་མི་གཅིག་པ་བརྒྱ་དང་བརྒྱད་ཀྱིས་བསྡམས་འདུག་པས་ཚིག་གཅིག་ཀྱང་མ་གོ་བས།",
    "ངས་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནའི་དུས་ཡིག་རིགས་མི་གཅིག་པ་དང་།",
    "ཚེ་སྒྲུབ་བདུད་རྩི་འདུས་པ་སོགས་བྱུང་འདུག་སྟེ།",
    "རྡོ་རྗེ་གླིང་པའི་སྐོར་ལ་མངའ་བརྙེས་པ་ཡོད་འདུག་པ་ལ།",
    "དོ་ནུབ་ཀྱང་འདི་སྨྱོས་འདུག་སང་། ནམ་ལངས་འཕྲལ་ལ་ཚའུ་དཔལ་ཆེན་གདན་དྲངས་ནས།",
    "ཁྱེད་ངའི་སྐྱེ་བ་སྔ་མར་ཡང་རོགས་བྱེད་མཁན་ཡིན་པར་འདུག།",
    "ཁམས་མི་བདེ་བར་འདུག་པ་ཨེ་ཡིན་ཟེར།",
    "བྲག་ཁུང་ནུབ་བྱང་ན་ཡོད་པར་སྐས་བཅུ་ཙམ་ཞིག་འདུག།",
    "དེའི་གདོང་ན་གནམ་སྒོ་ཞིག་འདུག་གོ།",
    "དེ་ཕྱེ་ནས་ཕྱིན་པས་བྲག་ཁུང་ཆེན་པོ་ཞིག་འདུག།",
    "དེའི་གཡས་ཕྱོགས་ན་བྲག་ཕུག་དེའི་སྐས་བཅུ་ཙམ་ཞིག་འདུག།",
    "ཉི་མ་དྲོ་བ་ཞིག་འདུག་གོ།",
    "སཾ་སྐྲ་ཏའི་ཡིག་རིགས་བཅུ་གསུམ་བྲིས་པ་འདུག།",
    "རྫོགས་ཆེན་སྐོར་བཅུ་གསུམ་གདའ་འོ།",
    "ཁོང་རྣམས་གྲོས་བྱེད་ཅིང་འདུག།",
    "ད་ལྟ་དངོས་གྲུབ་ཡོང་བ་འདུག་ཨང་།",
    "རྒྱ་ནག་རྣམས་ཀྱི་ཡི་གེ་དོམ་སྒྲོམ་ནང་ན་གདའ་འོ།",
    "རྡོར་གླིང་པས་བསྐྱལ་བའི་པོ་ཏི་བཅུ་གཉིས་ཙམ་གདའ་འོ།",
    "དེ་ནས་གདུང་བརྒྱུད་བྱུང་འདུག་ནའང་།",
    "ཤེས་རབ་འབྱུང་གནས་སྐྱེ་བ་དྲན་ཞིང་འདུག་གོ།",
    "དེ་ཡན་སྐུའི་འགྲོ་དོན་ཡིན་ཞེས་པའང་འདུག།",
    "གཅོད་འདུག་པ་རྣམས་བཞག་ནས།",
    "ཙ་རི་གསར་མའི་དཔལ་ཕུག་སོགས་སུ་སྒྲུབ་རྟགས་ཐོན་པ་དག་སྣང་ལུང་བསྟན་མང་པོ་ཐོབ་འདུག་གོ།",
    "གདམས་པ་འདུག་སྟེ་མ་བྲིས་སོ།",
    "དངུལ་སྐྱོགས་རྣ་བ་ཅན་ལ་སོགས་ཀ་ཆའི་རིགས་མཐའ་ཡས་པ་ཞིག་དང་ཡང་གསེར་ལ་སོགས་པ་བཟང་པོ་ནོར་གྱི་གཏེར་ཁ་མཐའ་ཡས་པ་འདུག་སྟེ།",
    "རིགས་བརྒྱུད་ནི་ད་ལྟའི་བར་དུ་བཞུགས་ནའང་འགྲོ་དོན་མཛད་པ་ཆེར་མི་འདུག།",
    "གཏེར་བྱང་དུ་འདུག།",
    "བྲག་ལ་རྡོ་ཆོལ་ཁྲོ་ཆུས་སྦྱར་བ་འདུག།",
    "དེ་ནས་མཁར་ཆུ་ལྕགས་ཕུར་ཅན་གྱི་ཕུག་པའི་གཡས་ཟུར་ནས་ས་ནག་ཏལ་ལེ་འདུག་ཕྱིན་པའི་གཏེར་སྒོ་རྙེད།",
    "དེའི་ནང་ནས་བི་རོ་ཙ་ནའི་ཕྱག་མཚན་རྡོ་རྗེ་ཕུར་པ་བྱོན་ནོ།",
    "རྗེ་དེ་ཉིད་ཀྱིས་མཛད་པའི་བསྟན་བཅོས་ཡི་དམ་ལ་བསྐྱེད་རིམ་ཡང་ཕུར་གྱི་སྐོར་མང་བར་འདུག།",
    "རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན་གསུམ་གྱིས་དབྱེར་མེད་གཅིག་ཏུ་གནང་བ་ཡིན་ཞེས་ཟེར་འདུག་པས།",
