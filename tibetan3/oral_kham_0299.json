    "དེར་ཁྲུང་ཁྲུང་དང་ངང་པ་དཀར་སེར་མང་པོ་འདུག།",
    "མཚོའི་གཡོན་ཕྱོགས་ཀྱི་བྲག་ངོས་སུ་ཡིག་འབྲུ་ཨཱ་དང་ལྷ་སྐུ་འདྲ་མིན་མང་པོ་འདུག།",
    "གནས་དེ་ཡི་དབུ་རྩེའི་ཤར་ཕྱོགས་སུ་གུ་རུ་དང་མཆོད་རྫས་ཆ་ཚང་རང་བྱོན་དུ་བྱུང་།",
    "སིནྡྷ་རའི་ཡིག་འབྲུ་རང་བྱོན་དོད་འདུག།",
    "ཁོག་ཐམས་ཅད་དུ་འཇའ་འོད་ཀྱིས་གང་ཞིང་འཇའ་འོད་ཀྱི་ནང་དུ་ལྷ་སྐུ་ཡིག་འབྲུ་ཡང་མང་དུ་མཇལ་རྒྱུ་འདུག་གསུངས།",
    "རྒོད་ཐང་དཀར་ཞིག་ལ་བྱ་རྒོད་གཞན་ལས་ཁྱད་པར་བ་ཞིག་འཕུར་འོང་ནས་གནས་རིའི་རྩེ་ལ་ལྡིང་སྐོར་མང་དུ་བྱས་ནས་འདུག།",
    "འདན་སྲས་གཡུ་འོད་འབུམ་མེ་སོགས་ཆེས་མང་དུ་འདུག།",
    "རྟ་དང་གླང་པོ་སྟག་དང་སེང་གེ་སོགས་ཆེས་མང་དུ་འདུག།",
    "རི་དེ་ལ་ཁ་བ་ལུང་རིའི་སྲས་རྡོ་རྗེ་དཔའ་བཙན་ཟེར་བ་ཞིག་འདུག།",
    "དེའི་ངོས་སུ་རྡོ་རྗེ་རྒྱ་གྲམ་ནོར་བུ་སོགས་རིགས་ལྔའི་ཕྱག་མཚན་སོགས་འདུག།",
    "ཨ་ར་པ་ཙའི་ཡིག་འབྲུ་རང་བྱོན་ཕྱག་རྗེས་ཆེ་ཆུང་གཉིས་བཅས་འདུག།",
    "ཕྱོགས་ཐམས་ཅད་ན་ཨ་ཡིག་དཀར་སེར་དམར་ལྗང་མང་དུ་འདུག།",
    "གནས་ངོས་སུ་ཡིག་འབྲུ་དང་རང་བྱོན་ངོ་མཚར་བ་དཔེ་མེད་འདུག་གསུངས།",
    "ཤར་ངོས་ན་མཆོད་རྟེན་ཆེ་བ་ཞིག་བཞེངས་ཤུལ་འདུག་པ་འདི།",
    "དེའི་ཉིན་གནས་བརྒྱ་རྩ་བརྒྱད་ཀྱི་སྒོ་ཕྱེས་པས་ཐམས་ཅད་ཀྱིས་ཁ་བ་བབས་པ་མེ་ཏོག་འདབ་མ་དྲུག་དང་བརྒྱད་ཅན་དུ་གྱུར་འདུག་ཅེས་གསུངས།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནའི་ཕྱག་དཔེ་ལ",
    "རྒྱལ་བ་ཞེས་པ་ཞིག་ཀྱང་འདུག།",
    "ཆེས་ངོ་མཚར་བ་ཞིག་ལ་ལོ་རྟག་པར་དུ་དཔྱིད་ཟླ་ཐ་ཆུང་ངམ་དབྱར་ཟླ་མགོ་མའི་ནང་དེར་ཉིན་གཉིས་གསུམ་ཞིག་ལ་གནས་སྒོའི་བྲག་དེ་ལས་ཆུ་ཆེན་པོ་ཞིག་བཞུར་ནས་ཡང་མེད་འགྲོ་བ་ཞིག་འདུག།",
    "གཞན་ཡང་ལོ་ཆེན་བེ་རོ་ཙ་ན་དང་།",
    "ནམ་མཁའ་ནས་འཇའ་ཤར་ཞིང་འཇའ་སྤྲིན་གྱི་ཐིག་ལེ་དང་ཐིག་ཕྲན་བསམ་གྱིས་མི་ཁྱབ་པ་ཟླུམ་འཁྱིལ་དུ་འདུག།",
    "གནས་རིའི་ངོས་སུ་རང་བྱོན་གྱི་ལྷ་སྐུ་ཡིག་འབྲུ་ཞབས་རྗེས་སོགས་ངོ་མཚར་བ་དཔེ་མི་སྲིད་པ་བྱུང་།",
    "ཡིག་འབྲུ་ཨོཾ་ཨ་ཧཱུྃ་མ་ཎི་སིདྡྷི་སོགས་རང་བྱོན་འདུག།",
    "བྱ་ཁྱུང་དུང་དཀར་གཅིག་ལྷ་ངོ་མི་ཤེས་པ་ཡང་མང་པོ་དེ་ཡི་གཡས་ཕྱོགས་ལ་མ་ཎི་རང་བྱོན་དང་ལྷ་ངོ་མི་ཤེས་པ་མང་པོ་འདུག།",
    "དེ་ནས་མར་འགྲོ་དུས་རྡོ་གྲུ་བཞི་མ་ཆེན་པོ་ཞིག་ལ་ཡི་གེ་ཎི་གཅིག་དང་ཞབས་རྗེས་མཐོ་གང་ཙམ་ཞིག་འདུག།",
    "དེ་ནས་མར་ཅུང་ཞིག་འགྲོ་དུས་རྡོ་བརྩེགས་མ་ཡོད་སར་བཞུགས་ཁྲི་མི་ཚད་ལྷག་ཙམ་ཞིག་ཡོད་པ་དེ་ལ་བསྐོར་བ་བསྐོར་ས་ཡོད་པ་སོགས་ཡ་མཚན་ཆེན་པོ་ཞིག་འདུག།",
    "དེ་ལ་ཨོཾ་ཨཱ་ཧཱུྃ་སོགས་རང་བྱོན་མང་པོ་དང་དེ་ཡི་སྟེང་ལ་རང་བྱོན་སྐུ་གཟུགས་མཐོ་གང་ཙམ་ཞིག་དང་འཇམ་དཔལ་དབྱངས་དང་ཡིད་བཞིན་ནོར་བུ་ཨ་རིག་རྡོ་རྗེ་འཆང་སོགས་རང་རང་ལ་མཐོང་སྣང་སྣ་ཚོགས་པ་བྱུང་།",
    "ཉི་ཤར་སྐབས་ཉི་མ་སྔོན་པོ་རུ་གྱུར་པའི་མཐའ་སྐོར་དུ་འོད་ཀྱི་འཇའ་ཁ་དོག་སྣ་ཚོགས་པ་ཀྱི་ལི་ལི་འཁོར་འདུག།",
    "འཇམ་དབྱངས་རལ་གྲི་དང་ཡིག་འབྲུ་ཞབས་རྗེས་ངོ་ཤེས་མི་ཤེས་མང་པོ་ཞིག་འདུག།",
    "རྒྱབ་རི་སྔོན་པོ་དར་སྔོན་གྱི་ཡོལ་བ་འཐེན་འདྲ་ཞེས་དངོས་སུ་འདུག།",
    "དུར་ཁྲོད་བརྒྱད་མཚོ་ཆེན་བཞི་སོགས་ངོ་མཚར་ཅན་མང་པོ་ཡོད་ཟེར་སྲོལ་འདུག།",
    "སྔོན་དཔལ་ཆེན་པོས་རཱུ་ཏྲ་བཏུལ་བ་འོག་ཏུ་མནན་པས་རཱུ་ཏྲའི་རྫས་བརྒྱད་སོགས་འདུག།",
    "རང་རང་ཁྱུ་ཚོགས་དགའ་བའི་རྩེ་བྲོ་འཁྲབ། ཁྱད་པར་དབྱར་གཞུང་བྱེའུས་སྒྲོལ་མཚན་འབོད།",
    "གནས་སྒོ་ཕྱེས་ཤིང་རང་བྱོན་ངོས་འཛིན་དང་།",
    "ལྷོ་ཕྱོགས་ཀྱི་ནམ་མཁའ་ནས་འཇའ་འོད་སྣ་ཚོགས་པ་བྱུང་ནས་གནས་རི་ལ་བསྐོར་བ་བྱས་ཏེ་ནམ་མཁར་ཁྱབ་འདུག་པ་དང་།",
    "སྔོན་ནས་ངོ་མཚར་བའི་གནས་དང་ཟོ་དོར་དུ་བརྩི་འདུག་ཀྱང་།",
    "མི་ཁྱབ་པ་རང་བྱོན་དུ་འདུག་གསུངས།",
    "གནས་ཀྱི་ངོས་སུ་ལྷ་སྐུ་དང་རྡོ་རྗེ་འཁོར་ལོ་སོགས་ཕྱག་མཚན་དང་ༀཨཱ་ཧཱུྃ་སོགས་ཡིག་འབྲུ་བསམ་གྱིས་མི་ཁྱབ་པ་འདུག།",
    "ངོ་མཚར་བའི་རྟགས་མཚན་དུ་མ་བྱུང་འདུག།",
    "བྱ་ཁྱུང་རང་བྱོན།",
    "སྐྱུ་རའི་མགོ་འདི་སྔོན་བེ་རོ་ཙ་ན་ཡི་སྒྲུབ་གནས་དང་བྱིན་གྱིས་བརླབས་པའི་གནས་ཡིན།",
    "ཉི་མ་ཡང་སྔར་ལས་ཆེ་ཞིང་འཇའ་སྤྲིན་དང་འོད་ཟེར་གྱི་མུ་ཁྱུད་ལྟར་བསྐོར་བ་བྱས་འདུག།",
    "སིདྡྷི་རང་བྱོན་མང་པོ་དང་ཕུག་པའི་གཡས་ཕྱོགས་སུ་ལྷ་སྐུ་ཡིག་འབྲུ་མང་དུ་འདུག།",
    "གནས་སྒོ་འབྱེད་སྐབས་གསར་དུ་ཨ་ཡིག་དང་ལྷ་སྐུ་ཡིག་འབྲུ་སོགས་རང་བྱོན་མང་དུ་འདུག།",
    "ལྷ་སྐུ་འདྲ་མིན་སྣ་ཚོགས་པ་དང་ཡིག་འབྲུ་སོགས་ངོ་མཚར་བའི་རང་བྱོན་སྣ་ཚོགས་པ་འདུག།",
    "སྒྲུབ་ཕུག་ནང་དུ་ལྷ་སྐུ་རང་བྱོན་དང་འཇིག་རྟེན་ཆགས་ཚུལ་སོགས་ལྷ་བཟོ་མཁས་པས་སྔོན་དུས་སུ་བྲིས་པའི་གཟུགས་རིས་འདུག།",
    "ནམ་མཁའ་ནས་འཇའ་ཤར་ཞིང་གནས་ངོས་སུ་ཨེ་ཝཾ་དང་ཡིག་འབྲུ་སྣ་ཚོགས་པ་འདུག།",
    "སྒྲུབ་ཕུག་དེའི་གཡོན་དུ་བྲག་དཀར་པོའི་ཕུར་གཟུགས་མ་ཞེས་ཕུར་བུའི་གཟུགས་ལྟ་བུ་འདུག།",
    "གནས་ངོས་སུ་ལྷ་སྐུ་ཡིག་འབྲུ་མང་ཞིག་རང་བྱོན་དུ་འདུག་པ་སོགས་ངོ་མཚར་དཔེ་མེད་པ་བྱུང་།",
    "བྲག་ལ་རྗེ་བཙུན་གྱི་སྐུ་རྗེས་དང་རང་བྱོན་ངོ་མཚར་མཇལ་རྒྱུ་ཡོད།",
    "དྲན་ཤེས་ནི་ག་དུས་ཡིན་ན་ཡང་གདམ་ག་བྱ་རྒྱུ་ཡོད་པ་ཞིག་ཡིན་ཞིང་།",
    "ཁྲལ་པ་མང་པོ་ཞིག་དོན་དངོས་ཐོག་ཕྱུག་པོ་ཡིན་ཞིང་རང་ཉིད་ཀྱི་གཡོག་པོ་ཡང་ཡོད།",
    "གཞུང་རང་ཉིད་བཅས་ལམ་ལུགས་ཀྱི་འབྲེལ་བ་ཞིག་ལ་བརྟེན་ནས་གནས་ཡོད།",
    "ཕྱི་ལོ་༡༩༤༩ ལོར་ལིའུ་སྦོ་ཕྲེང་རང་ལོ་༥༧ ཡིན་པ་ཐང་འཐབ་དམག་ཨང་གཉིས་པའི་དམག་སྤྱི་ཡིན་ལ་ལྷོ་ནུབ་ཅུས་ཀྱི་ཧྲུའུ་ཅི་གཉིས་པ་དང་།",
    "ག་དུས་བྱེད་ཐུབ་ཚོད་ཡོད་ན་ཡང་ནུབ་བྱང་ཅུས་ཀྱིས་ལྷོ་ནུབ་ཅུས་དང་མཉམ་དུ་འཆར་གཞི་བཟོ་བ་དང་།",
    "ལྡིང་དཔོན་གྱིས་དེའི་ལན་དུ་ངས་ཁོ་ཚོ་སྐུལ་ཐུབ་ཀྱི་མི་འདུག་ཅེས་བཤད།",
    "གང་ལགས་ཤེ་ན་ཟླ་༩ ཚེས་༣ ཉིན་བཀའ་ཤག་ལ་རྒྱ་དམར་གཞུང་ནས་བཀའ་ལན་ཡང་བསྐྱར་སྐུལ་ལྕག་བྱེད་འདུག་པས་བཀའ་ལན་འཕྲལ་སྩོལ་ཡོང་བ་ཞུ།",
    "ད་དུང་བཀའ་གསལ་ཕྱིར་འགྱངས་གྱུར་ན་མཐའ་མཚམས་ལ་རྒོལ་གཏོར་ཡོང་བཟོ་འདུག་པས་དེ་ལྟར་བྱུང་ན་སྐུ་ཚབ་ཚོ་པེ་ཅིང་དུ་ཕྱིན་ན་ཡང་གནས་ཚུལ་ཡག་པོ་མི་ཡོང་རྒྱུ་ཉག་ཅིག་ལ་བརྟེན་བཀའ་གསལ་འཕྲལ་སྩོལ་ཡོད་པ་ཞུ་ཞེས་ཞུས།",
    "གློག་འཕྲིན་དེ་ཡང་བོད་གཞུང་རང་ནས་མ་བཏང་བར་ཕྱི་རོལ་ཏུ་ཡོད་པའི་སྐུ་ཚབ་ཚོགས་པ་ནས་བཏང་བ་ཞིག་ཡིན་གཤིས།",
    "ག་དུས་མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ནས་བརྡ་ལན་བྱ་རྒྱུར་སྒུག་ཐུབ་བམ་སྙམ་པ་བྱུང་ཡོད།",
    "མི་ཚང་མ་འཇིགས་སྣང་སྐྱེད་ནས་ག་བྱེད་འདི་བྱེད་མེད་པར་གྱུར་འདུག་མའོ་ཀྲུའུ་ཞིས་བོད་བཅིངས་བཀྲོལ་གཏོང་རྒྱུར་ཐག་གཅོད་གནང་ཡོད།",
    "ང་རང་རྒྱ་ནག་ལ་འགྲོ་དགོས་གསུང་སྐབས་ངས་དེའི་སྐོར་བསམ་བློ་མང་པོ་མ་བཏང་བ་ཡིན།",
    "གྲོས་བསྡུར་བྱ་རྒྱུའི་སྐོར་ཐག་གཅོད་བྱས་མེད་ཚོད་འདུག་པ་མ་ཟད།",
    "ད་ཆ་བོད་ལ་རྒྱུ་དམག་མི་ཡོང་བ་བྱ་རྒྱུ་དེ་ཡོང་ཐབས་གཏན་ནས་མེད་པས་དེ་བསྒྲུབ་པ་བྱེད་པར་ཁོང་རང་ཉིད་ཀྱིས་གནང་དགོས་པར་དགོངས་ཤིང་།",
    "ག་དུས་ལག་ལེན་ཆ་ཚང་བསྟར་རྒྱུ་ཡིན་པའི་གསལ་ཁ་མེད་ཅིང་འགྱུར་བ་དང་སྒྱུར་བཅོས་གཏོང་རྒྱུའི་མྱུར་ཚད་ལ་བོད་པ་ཚོས་ཚོད་འཛིན་བྱ་ཆོག་པ་ཞིག་ཡིན་པའི་ཚོར་སྣང་ཡོང་དུ་བཅུག་ཡོད།",
    "ང་ཕོད་ཁོང་རང་རྒྱ་ལག་ཏུ་ཡོད་པར་ཐུགས་ཁྲལ་གནང་མ་དགོས་ཞེས་བོད་གཞུང་ལ་ཞུ་དགོས་ཞེས་གསུངས་ཡོད།",
    "ཁོང་སྟག་ལྷ་སྤྱན་གྱི་གཉན་ཁ་མ་དྲག་བར་ཀོང་ཀྲའུ་ལ་བཞུགས་དགོས་པའི་གྲོས་འགོ་བཏོན་འདུག་ཀྱང་སྟག་ལྷས་ཞལ་བཞེས་མ་གནང་།",
    "ང་ནི་ང་ཕོད་ཀྱི་ལས་བྱ་གསར་པའི་གྲས་ཤིག་ཡིན་ན་ཡང་ང་རང་ཕྱི་ཙམ་ལ་སླེབས་པ་ཡིན།",
    "ང་རང་གཉིས་ཀ་དེ་གར་སྡོད་འདོད་མེད།",
    "ང་རང་རྒྱ་མདར་ཡོད་སྐབས་རྟ་ལ་རྟ་སྒ་བརྒྱབ་ནས་ཁང་པའི་འཁྲིས་སུ་ཉར་ཏེ།",
    "དམག་དཔུང་འཕར་སྣོན་གཏོང་རྒྱུ་ཡིན་ལུགས་གསུངས་པར་བརྟེན་ང་རང་དེ་གར་སྡོད་དགོས་བྱུང་།",
    "རྒྱ་ནག་དུས་གཏན་དུ་ཁ་འཐོར་འགྲོ་རྒྱུ་དེ་གཡོལ་ཐབས་མེད་པ་གསལ་པོ་ཆགས་པ་དང་།",
    "ཧན་ཌར་སོན་ནས་འདི་སྐོར་ཕྱི་ཟླ་༡ ཚེས་༥ དང་༡༡ ལ་ཡི་གེ་བཏང་ཡོད་པ་དེ་ངས་ཝིལ་ཀིན་སི་དྲན་གསོས་ཀྱི་འདུག་ཅེས་འཁོད།",
    "མཁས་མཛངས་ལྡན་པ་ཞིག་ཡིན་པར་ཡིད་ཆེས་བྱེད་ཀྱི་མེད་ཅེས་གསུངས་འདུག།",
    "ཞྭ་སྒབ་པས་དེ་དག་མངོན་གསལ་གྱི་དམག་འཐབ་མ་ཡིན་པའི་འཇབ་དམག་ནང་བེད་སྤྱོད་བྱ་རྒྱུ་ཡིན་ལུགས་ཟེར་ཡང་ཞིབ་ཕྲའི་འཆར་གཞི་ཧ་ཅང་གསལ་པོ་དེ་འདྲ་ཤེས་ཀྱི་མི་འདུག།་",
    "མི་དམངས་རྣམས་ལ་ཡུད་ཡུད་པོའི་ཚོར་སྣང་ཞིག་འདུག་པས་ཆིབས་ཞལ་བསྒྱུར་གནང་ཡོད་པ་ཞུ།",
    "སྟག་ལྷས་ཁོ་པར་གུང་ཁྲན་ནི་སྔོན་འཇམ་རྗེས་རྩུབ་ཡིན་པ་དེར་ཞེད་ཀྱི་འདུག་ཅེས་གསུངས།",
    "དགོངས་ཚུལ་དེ་ལྟར་ཡོད་བཟོ་འདུག་ཅེས་གསུངས།",
    "ཁོང་རང་ཉིན་གཉིས་ཀྱི་སར་འབྲས་ལྗོངས་སྒང་ཏོག་ལ་བསྡད་ཡོད་རུང་།",
    "གྲོས་མཐུན་དེ་ནི་བོད་མི་རིགས་དང་རང་རྒྱལ་གྱི་མི་རིགས་ཚང་མའི་ཁེ་ཕན་གྱི་ཆེད་དུ་བཞག་པ་ཞིག་ཡིན།",
    "ཁྱེད་ལ་རོགས་རམ་ཞུ་དགོས་འདུག་ན་ཁྱེད་ཀྱི་ཐུགས་འདོད་ལྟར་ཀྲང་ལ་འབྲེལ་གཏུག་གནང་སྐྱོང་ཡོད་པ་ཞུ།",
    "༡༩༩༦༦༦༧༢ མ་འཁྲུལ་གཞི་འགའ་ཤས་ཡོད་པའི་བཟོ་འདྲ་པོ་འདུག་བྱས་ཙང་ང་ལ་ཚོར་སྣང་དེ་འདྲ་ཞིག་བྱུང་བ་དྲན་གྱི་འདུག་ཅེས་འཁོད།",
    "ཀླུ་ཁང་བ་དང་བློ་བཟང་བཀྲ་ཤིས་ནས་དེ་ལྟར་གསུངས་པ་ཞིག་གསལ་པོ་དྲན་གྱི་འདུག་ཅེས་འཁོད།",
    "དེར་སླེབས་དུས་རྒྱ་མི་སླེབས་ཚར་འདུག་ཅེས་འཁོད།",
    "དེ་ནས་ཀ་ལོན་སྦུག་ལ་ཕྱིར་ཕེབས་ནས་དེ་གར་བཞུགས་འདོད་འདུག་གསུངས་བྱུང་།",
    "ནོ་སི་༡༩༩༩༥༡འོན་ཀྱང་ནན་བརྗོད་གནང་བ་དེ་ངེས་གཏན་ཡིན་པར་བརྩི་ཁག་པོ་འདུག་གང་ཡིན་ཞེ་ན་སྐབས་དེའི་ཕྱི་འབྲེལ་གྱི་འགོད་ཐོའི་ནང་རྒྱ་གར་གྱིས་དེ་ལྟ་བུའི་དོ་སྣང་བྱས་ལུགས་ཤིག་འཁོད་མེད།",
    "གང་ཡིན་ཞེ་ན་དེས་ཁོང་རང་ཡང་བྱེད་གཏད་ཁག་པོ་ཞིག་བཟོས་ཡོད།",
    "ང་རང་ལ་ཆ་བཞག་ན་མི་རྒན་ཨ་ར་དཀར་པོ་ཤི་ལ་ཁད་ཅིག་ཡིན་ན་ཡང་།",
    "མི་རྣམས་ལ་བསམ་ཚུལ་འདྲ་མིན་འདུག་པ་དཔེར་ན།",
    "བཀའ་བློན་ཚོའི་ནང་ནས་ང་རང་ལོ་ཆུང་ཤོས་ཡིན་ལོ་སུམ་ཅུ་སོ་བདུན་པས་ངས་ཁ་སངས་པོའི་སྒོ་ནས།",
    "དེ་སྔོན་ང་རང་དང་ཀླུ་ཁང་བ་གཉིས་རྩིས་དཔོན་ཕྱག་སྦྲེལ་ཡིན་པས་ངས་དེ་ཞུ་རྒྱུར་དང་བླངས་དོན་པ་ཡིན།",
    "དེ་ལོ་ག་དུས་ཡིན་ནམ།",
    "ལས་ཀ་གསར་པ་གང་ཞིག་བྱེད་དགོས་པ་ཡིན་ན་ག་དུས་ཡིན་ན་ཡང་གཞོན་ནུས་བྱེད་ཀྱི་ཡོད།",
    "གཞོན་ནུ་ཚོ་བློ་ཁོག་ཆེན་པོ་ཡོད་པས་རྒྱ་མི་ཡིན་ན་ཡང་འདྲ་ནུབ་ཕྱོགས་པ་ཡིན་ན་ཡང་འདྲ་གཞོན་ནུ་ཚོས་ག་དུས་ཡིན་ན་ཡང་དམག་མིའི་ནང་ཞུགས་རྒྱུའི་མིང་ཐོ་འགོད་ཀྱི་ཡོད།",
    "ངའི་བསམ་པར་འགྱུར་བ་གཏོང་དགོས་ཀྱི་འདུག་བསམ་མཁན་མི་ཁག་ཅིག་ཡོད་པ་དེའི་ནང་རིགས་གཉིས་ཡོད་པ་སྟེ།",
    "གོང་གསལ་འདི་ང་ཕོད་ཀྱི་མདུན་དུ་གསུངས་པ་ཡིན་དང་རྒྱབ་ཏུ་གསུངས་ཡོད་མེད་ངེས་བརྟན་མི་འདུག་སློབ་སྟོན།",
    "ང་རང་ཁོང་དང་འདྲིས་གཤིབ་ཆེན་པོ་ཉེ་པོ་ཡོད།",
    "འོན་ཀྱང་རང་ལ་རང་བཞིན་དུ་གྲུབ་པའི་གཤིས་རྒྱུད་གང་ཡིན་པ་དེ་རང་བྱེད་ཀྱི་ཡོད།",
    "ཡབ་གཞིས་ཀྱི་གཞིས་ཀའི་གྲས་ཤིག་ཡིན་པའི་སྣེའུ་གཞིས་ཀའི་གཞིས་སྡོད་ཡབ་གཞིས་ཕྱག་མཛོད་ཀ་ལས་རྒྱལ་ཡབ་ལ་དུག་ཕུལ་བ་ཡིན་ཞེས་ངོས་ལེན་བྱས་འདུག་འདི་ནི་དོ་སྣང་སྐྱེད་འོས་པ་ཞིག་ཡིན།",
    "གལ་ཏེ་གོང་གསལ་དེ་དག་ཚང་མས་མ་ལྡེང་བ་འདུག་ན།",
    "མི་ཚོས་ཁྱེད་རང་ལ་ཆབ་སྲིད་ཨུ་ཡོན་གཞོན་པ་ཟེར་གྱི་ཡོད།",
    "ང་རང་དེ་ལྟར་བྱེད་དགོས་ཀྱི་མེད་རུང་།",
    "ཁྱེད་རང་བོད་པ་ཡིན་པའི་ཆ་ནས་བོད་དམག་ཚོར་འདྲི་རྨེད་བཏང་བ་ཡིན་ནམ།",
    "གྱེན་ལངས་ཀྱི་ཉེན་ཁ་འདུག་པས་དམག་དཔུང་ལན་ཤོག་འཕར་མ་ཞིག་འཕྲལ་གཏོང་བྱ་དགོས་ཞེས་བཤད།",
    "གྱེན་ལངས་ཡོང་སྲིད་པའི་རང་བཞིན་མི་འདུག་དམིགས་བསལ་དུ་ཤོད་རྒྱུར།",
    "སྣེ་ཤན་ཚོས་འདི་བཀའ་ཤག་ལ་ཞུས་ཆོག་ཟེར་གྱི་འདུག་ཅེས་འཁོད།",
    "ཉི་མ་བཞུད་འགྲོ་སྐབས་ཀྱང་སྐར་ལྔའི་རྒྱལ་དར་དེ་ད་དུང་ལྷབ་ལྷུབ་ཏུ་གཡོ་བཞིན་འདུག་ཅེས་འཁོད།",
    "འགོད་དགོས་མིན་ཐོག་མ་མཐུན་པ་བྱུང་ཡོད་པ་བཀའ་བློན་འགའ་ཤས་ཀྱི་བསམ་པར་ཚིག་སྒྲུབ་འདིས་ཕོག་ཐུག་ཡོང་གཞི་འདུག་པས།",
    "སྟག་ལྷ་ཕུན་ཚོགས་བཀྲིས་ཀྱིས་ཕྱི་ཟླ་༨ པའི་ཟླ་དཀྱིལ་དུ་ཀལ་ཀ་ཏར་ཨི་ཨེམ་ཝིལ་སོན་ལ་གནས་འཕྲིན་དེ་མིང་རྟགས་མ་བཀོད་པ་ཡིན་ལུགས་གསུངས་འདུག་ཅེས་གསུངས།",
    "གཞུང་ཚབ་ནས་བློ་དོགས་ཆོད་ཀྱི་མི་འདུག་རྒྱལ་དོན་ཁང་དང་སྤྱི་ཁྱབ་ཕྱི་འབྲེལ་འཐུས་ཚབ་ནས་ཤེས་གསལ་ལྟར་དེ་སྔོན་ཨ་རིའི་ལངས་ཕྱོགས་སྐོར།",
    "ཧན་རི་ཧ་རར་ནས་ཀལ་ཀ་ཏར་ཝིལ་སོན་ལ་བོད་ཀྱི་མཐོ་རིམ་དཔོན་རིགས་གཡུ་ཐོག་ནས་ཁོང་རང་ལྷ་སར་ཕྱིར་ལོག་བྱས་ནས།",
    "ཁོང་རང་ཀལ་ཀ་ཏ་ནས་ཐོན་རྗེས་ཨ་རིའི་ཕྱི་འབྲེལ་འཐུས་ཚབ་ཁང་ནས་ཡི་གེ་དེར་བཟོ་བཅོས་མི་རྒྱག་པ་དང་།",
    "ལན་གསལ་དེ་གཡུ་ཐོག་ལ་སྤྲད་ཡོད་བཟོ་མི་འདུག་ཡིན།",
    "རྒྱ་མིས་གཡུ་ཐོག་ལ་ལྟ་རྟོག་དམ་པོ་བྱས་ནས་ཨ་རི་རྒྱལ་ཕྲན་མཉམ་འབྲེལ་གྱི་གནས་འཕྲིན་དེ་བཀའ་བློན་གཉིས་ལ་ཕྱི་ལོ་༡༩༥༢ ཟླ་༤ པ་བར་བརྒྱུད་འཕྲོད་བྱེད་ཐུབ་མི་འདུག་ཅེས་གསུངས།",
    "ངས་ང་རང་རྒྱ་ནག་ལ་འགྲོ་རྒྱུའི་སྐོར་ཁོང་དང་དགོངས་བཞེད་སྙོམས་སྒྲིག་ཡོང་ཐབས་བྱས་པ་དང་།",
    "ཁོང་བོད་ལ་ཕེབས་དགོས་པའི་གསལ་འདེབས་ཞུ་དགོས་ཞེས་བྲིས་འདུག་དེ་ནི་ངས་རང་ཉིད་ཀྱིས་བོད་ཡིག་བཀླགས་པ་ཞིག་ཡིན།",
    "དུས་ཚོད་ག་དུས་ཡིན་ན་ཡང་དངོས་སུ་རྒྱ་མིར་འཛིང་སྲིད་པ་ཡིན།",
    "ཀྲང་གོ་ཧྭ་དང་ང་རང་།",
    "འོན་ཀྱང་ང་ལ་འབྱོར་བའི་གནས་ཚུལ་གསར་ཤོས་དེའི་ནང་ལོ་རྗེས་མ་ཕྱི་ལོ་༡༩༥༢ ལོའི་ནང་ལམ་འགག་བཟོས་ཚར་ཐབས་མི་འདུག་ཕལ་ཆེར་ལོ་གཉིས་ནས་གསུམ་བར་འགོར་སྲིད།",
    "འོན་ཀྱང་བཀར་འཇུག་བརྒྱབ་པའི་འབྲུ་རིགས་མང་པོ་འདུག་པས།",
    "བཅིངས་འགྲོལ་གཏོང་ལོང་མི་འདུག་བཟ་སསྤང་ལ་སེར་ཤ་བཞག་ནས།",
    "དཀར་ཤ་དགོས་མཁན་མི་འདུག།",
    "བཅིངས་འགྲོལ་གཏོང་ལོང་མི་འདུག།",
    "བཅིངས་འགྲོལ་གཏོང་ལོང་མི་འདུག།",
    "དཀར་ཤ་དགོས་མཁན་མི་འདུག།",
    "བཅིངས་འགྲོལ་གཏོང་ལོང་མི་འདུག།",
    "ཐ་སྙད་དེ་དག་དུས་རབས་བཅོ་བརྒྱད་པའི་སྐབས་སུ།",
    "གཞི་རྐང་ང་རང་ལོ་༡༢ ལས་སླེབས་མེད་ཀྱང་།",
    "ཅེ་འཇིགས་མེད་ཀྱི་ལྟ་ཚུལ་དེ་ལམ་སེང་ཉན་ཤེས་གོ་ཤེས་བྱུང་ནས་མགྱོགས་མྱུར་ཁོང་རང་ཏང་ནང་།",
    "ད་དུང་གང་ཉིད་བོད་ལ་ག་དུས་ཕྱིར་ཕེབས་གནང་རྒྱུའི་གསལ་ཁ་མ་གཏོད་པར།",
