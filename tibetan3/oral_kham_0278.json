    "རྣལ་འབྱོར་པ་བདག་རྟོགས་པས་གཡེངས་ནས་བསྒོམ་དུ་མི་འདོད་པར་འདུག་ཞུ་བ་ལ།",
    "སྨྱོན་པ་ཞིག་འདུག་ཟེར་བ་ལ།",
    "དེས་ན་ཁྱེད་ཅག་དུས་རྟག་ཏུ་བཀྲུ་མི་དགོས་པར་ལན་གཅིག་བཀྲུས་པས་ཆོག་པའི་གདམས་པ་ང་ལ་ཡོད་ན།",
    "རང་ཉིད་ཀྱི་ལུས་ཀྱི་སྣང་བ་ལ་འདུག་པ་མཐོང་ནས།",
    "ཡུལ་ཀོ་ཤནྟི་བྱ་བར་དམངས་རིགས་ཀྱི་གང་ཟག་ཅིག་དུས་རྟག་ཏུ་ཆོ་ལོ་རྩེ་བས་ཟས་ནོར་ཐམས་ཅད་ཟད་ནས་མེད་ཀྱང་།",
    "སྐྱོ་བ་སྐྱེས་ཏེ་དུར་ཁྲོད་དུ་ཕྱིན་པ་ནས་འདུག་པ་དང་།",
    "དེ་ལྟར་རྟོགས་པའི་རིག་པ་དེ་ཡང་རང་བཞིན་མེད་པར་གྱུར་ཏེ།",
    "ཕྱོགས་ཤིག་ནི་བྲག་ཕུག་སྟོང་བ་ཞིག་འདུག་པས།",
    "བྲམ་ཟེ་ཞིག་དུས་རྟག་ཏུ་ཐོས་པ་ལ་བརྩོན་པར་ག་ནས་ཀྱང་།",
    "སྲོག་ཆགས་གང་ཡང་མེད་སྙམ་དུ་ང་རྒྱལ་གྱིས་དུས་རྟག་ཏུ་མནན་ནས་འདུག་པའི་ག་མ་དུ་རྣལ་འབྱོར་པ་ཞིག་བྱོན་ནས་དེ་ལ་བལྟས་ཏེ།",
    "ཨ་ཙིནྟ་ནི་དྲན་པ་མེད་པ་བྱ་བ་ཡིན་ལ།",
    "འཇིག་རྟེན་གྱི་རྣམ་རྟོག་གཞན་གང་ཡང་དྲན་པ་མེད་པར་ནོར་རྫས་འབའ་ཞིག་འདོད་པས་གདུངས་ཏེ་དབེན་པ་ཞིག་ཏུ་འདུག་པ་དང་།",
    "ནོར་སེམས་ཀྱང་ཁུགས་པ་ནི་ཅི་ཡང་མི་འདུག་ཞུས་པས།་",
    "འདི་བྷུ་སུ་ཀུ་ཞིག་འདུག་གོ་ཟེར་བས།",
    "རིག་པ་སློབ་པའི་སྐལ་བ་མེད་ཟེར་ནས་འདུག་པ་ན།",
    "ང་རང་ཤེས་ཟེར་མ་ཉན་པ་ན།",
    "རྒྱལ་པོ་དེ་ཝ་ཕ་ལ་ལ་སོགས་པ་སྐྱེ་བོའི་ཚོགས་ཐམས་ཅད་དད་ནས་མེ་ཏོག་སྟོར་བས་བུས་ནུབ་ཙམ་འདི་ནི་བྷུ་སུ་ཀུ་མ་ཡིན་ཏེ་མཁས་པར་འདུག་གོ་ཟེར་ནས།",
    "དད་བཞིན་དུ་ཕྱག་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་།",
    "ངས་རི་རྐོ་ཡིན་གདའ་ཞེས་ཞུས་པས།",
    "དེ་ཡང་རང་སེམས་གཉུག་མ་འགྱུར་བ་མེད་པ་ནི་རི་དང་འདྲ་ལ།",
    "རིགས་རྒྱུད་ཀྱི་འཚོ་བ་དུས་རྟག་ཏུ་མགར་བ་བྱེད་ཅིང་འདུག་པ་དང་།",
    "ཁྱེད་ཅི་བྱེད་ཀྱིན་འདུག་ཞེས་གསུངས་པ་དང་།",
    "བདག་རིགས་རྒྱུད་ཀྱི་ལས་མགར་བ་བྱེད་ཅིང་གདའ་ཟེར་རོ།",
    "འཚོ་བའི་ཆེད་དུ་སྡུག་བསྔལ་དང་དུ་ལེན་ཞིང་གདའོ་ཞུས་སོ།",
    "ད་རུང་ནམ་མཁའ་ལ་སྤྲིན་ཁ་དོག་ལྔ་འདུས་ནས་ཆར་འོང་བར་གདའ་བས།",
    "ད་འོ་སྐོལ་གྱི་ལས་ངན་པ་འདི་ལ་མི་ཀུན་འཕྱ་བཞིན་འདུག་པས།",
    "ད་ལྟ་ཁྱེད་རང་བུ་དང་ཆུང་མས་ཅི་བྱ།",
    "སྡིག་ཅན་ཞིག་ཁྱེད་སློབ་དཔོན་གྱིས་ང་ལ་ཉེས་པ་མེད་པས་སྐུར་བ་མ་རང་འདུག་སྨྲས་པས།",
    "ཁོང་རང་བདེ་མཆོག་དང་།",
    "འཚོ་བའི་ཆེད་དུ་སྲོག་ཆགས་ལ་དུས་རྟག་ཏུ་རྣམ་པར་འཚེ་བར་བགྱིད་པས་སྐྱོ་ཡིན་གདའ་འོ་ཞུས་པས།",
    "དེ་ལྟ་ན་ཁོ་བདེན་པར་འདུག་ཟེར་ནས་བཟོད་པར་ཕུལ་ཏེ་བྱ་དག་ལོག་ཏུ་ཚུག་ཅིག་ཟེར་ནས།",
    "འོ་ན་འོ་སྐོལ་གཉིས་ཡོན་མཆོད་དུ་འདུག་པ།",
    "གདམས་ངག་དང་རང་སེམས་ཀྱི་གནས་ལུགས་ཉམས་མྱོང་གསུམ་དབྱེར་མེད་དུ་རྟོགས་ནས་གྲུབ་པ་ཐོབ་སྟེ།",
    "བཏུང་བ་ལྔ་ལ་སོགས་པ་རྣམས་རྒྱལ་པོས་འཚོ་བར་ལོངས་སྤྱོད་ཅིང་འདུག་པའི་དུས་གཅིག་ན།",
    "རྒྱལ་པོས་ལྟར་བཏང་བས་དེ་ལྟར་འདུག་པ་དང་།",
    "གང་ཐག་རྫ་མཁན་ཞིག་དུས་རྟག་པར་རྫའི་ལས་ཀྱིས་འཚོ་བའི་ཚེ།",
    "༡ལས་འདི་ཟད་པ་འམ་ཟིན་པའི་མཐའ་ལར་མ་བྱུང་བས་སྐྱོ་བ་སྐྱེས་པར་གདའ་འོ་ཟེར་བས།",
    "དེ་ཡང་དུས་ཐོག་མ་མེད་པ་ནས་ཐ་མ་མེད་པར་སྡུག་བསྔལ་ཅིག་པོ་ལས་མེད་དེ་སྐྱོ་བ་མ་སྐྱེས་པར་གདའ་ན་གསུངས་པས།",
    "དེ་ཀར་འདུག་སྟེ་ཁྱིམ་དུ་ཉི་མ་ཕྱེད་ཀྱི་བར་དུ་མ་འོངས་པས།",
    "ལྟར་ཕྱིན་པ་ན་རྫ་མ་ཆག་པོ་ལ་བལྟས་ནས་འདུག་པས།",
    "དེ་སྐྱོ་བ་སྐྱེས་ནས་མཐར་དུར་ཁྲོད་དུ་ཕྱིན་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པའི་ཚེ།",
    "དེ་ཙ་ན་ང་ལ་མི་སྨྲ་བར་གསང་བའི་ལུགས་ཡོད་དམ།",
