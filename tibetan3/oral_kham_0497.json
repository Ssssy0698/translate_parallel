    "དཔར་བྱང་སྨོན་ཚིག་རྩོམ་པ་པོ་ལ་རྩོམ་པ་པོ་ངོ་མ་ཡིན་པར་འཁྲུལ་བ་སོགས་སྐྱོན་ཆ་མི་ཉུང་བ་ཞིག་འདུག་རུང་།",
    "མི་རིགས་མང་ཆེ་བར་རང་རང་སོ་སོའི་ལུགས་ཀྱི་གྲངས་ཀ་རྩི་ཐབས་ཡོད།",
    "ཕུག་ཆོན་སྟེང་དུ་ཕོ་རོག་ཅིག་ཀྱང་བབས་འདུག་པས།",
    "ཕྱིར་ནང་དུ་ཕེབས་ནས་དུར་ཁྲོད་དུ་གར་འཁྲབ་པར་འདུག་དུར་ཁྲོད་འགྲུབ་ཡོད།",
    "ཁོང་རང་ཉིད་ཀྱང་དེར་བྱོན་ནས་གསན།",
    "སྐུ་གདུང་རང་དགོན་དུ་གདན་དྲངས་ནས་གདུང་རུས་ནང་བཞུགས་ཀྱི་སྐུ་གདུང་མཆོད་རྟེན་ད་ལྟའང་ཀོའུ་བ་དགོན་དུ་བཞུགས།",
    "རང་དགར་འདུག་པའི་ཁོམ་ལོང་མེད་པས།",
    "མཛེས་ཤིང་དགའ་བ་ལ་བསྔགས་བརྗོད་དང་དེ་ལས་ལྡོག་པ་ནི་སྨད་པའི་གནས་སུ་འགྲོ་བ་སོགས་ཀྱང་རང་བཞིན་གྱི་གཤིས་སུ་ངེས་པས།",
    "ཤེས་བྱའི་གནས་ཀུན་ལ་འཇུག་པ་ཡངས་པར་བྱས་ཐོག་བསམ་པ་གུ་དོག་དང་རང་ལུགས་མཁྲེགས་འཛིན་སོགས་ཀྱི་བསམ་སྦྱོར་ཡེ་ནས་སྤངས་ཏེ།",
    "དེར་ཡི་གེ་དག་ཆ་དང་ཞིབ་ཆ་ཡོང་རྒྱུ་ནི་ཧ་ཅང་གལ་ཆེ་བར་གནས་འདུག་ནའང་།",
    "ད་དུང་ཡི་གེ་གསར་བ་མང་དུ་སྐྲུན་དགོས་ཚོད་འདུག་པར་མ་ཟད།",
    "བདག་ནི་འདི་ལྟ་བུ་ཞིག་ན་འདུག་འདུག་གོ་མིང་ནི།",
    "མེ་ཏོག་ཨུཏྤ་ལ་དམར་པོའི་འདབ་མའི་ཁ་དོག་ལྟར་འདུག་ཅིང་ཤིན་ཏུ་ཡངས་པས།",
    "ཕྱལ་ཕྱམ་མེར་འདུག་པ་ཡིན།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་མི་གནས་པའི་ཚུལ་དང་རང་བཞིན་སྟོང་པ་ཉིད་མི་གནས་པའི་ཚུལ་དང་།",
    "ཆུའི་ཆུ་བུར་གསོག་ཏུ་འདུག་པ་སྐྱེ་ཞིང་འགག་པ་ལྟར་ཤེས་པ་སྟེ་དེ་ལྟར་ན།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ལ་སྤྱོད་པ་དང་རང་བཞིན་སྟོང་པ་ཉིད་ལ་སྤྱོད་པ་དང་།",
    "ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཡིན་གྱི།",
    "རྟག་པར་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ལས་མི་འདའ་བ་ཡིན་གྱི།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དེའང་སྔ་ནས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད།",
    "ཕྱིན་ཆད་ཀྱང་རང་བཞིན་། གྱིས་སྟོང་པ་ཉིད།",
    "བར་དུའང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དེ།",
    "དེ་ནམ་ཡང་རང་བཞིན་གྱིས་མི་སྟོང་པ་མ་ཡིན་ནོ།",
    "གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ་ རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་གཟུགས་སོ།",
    "ཚོར་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུ་ཤེས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ་ རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་འདུ་ཤེས་སོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མིག་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་མིག་གོ་རྣ་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་རྣ་བའོ།",
    "སྣ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལྕེ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་ལྕེའོ་ ལུས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཡིད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྒྲ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དྲི་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རོ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལུས་ཀྱི་རྣམ་། པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཆུའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མེའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ནམ་མཁའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མ་རིག་པ་ཉིད་ཀྱང་རང་བཞིན་། སྟོང་པ་ཉིད་དོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མིང་དང་གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཚོར་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲེད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲིད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྒ་ཤི་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
