    "འོན་ཀྱང་རང་དོན་པའི་གོ་སྒྲུབ་ཡིན་མིན་དཔྱད།",
    "བདག་ལ་དེའི་ཆ་ཕྱོགས་ན་མེད་པ་ཞེས་པའི་སྐྱོན་མི་འཇུག་ཚུལ་ལ་དཔྱད་གཞི་ཡདའི་ཆ་ཤས་ཙམ་ཡང་མི་འདུག་སྙམ་དུ་བརྩོན་དགོས་པའི་དོན།",
    "ཁྱེར་ཡོད་པས་སྙོམ་ལས་སུ་ཇི་ལྟར་འདུག་ཅེས་པའི་དོན་དང་ཞེས་སོགས་བདེ་བའི་རྒྱུ་དང་།",
    "དེ་ལ་ཡང་སྒྲུབ་པའི་འདུག་ཀྱང་དཔྱད་དགོས་སྙམ།",
    "ཁོ་རང་ཏིང་ངེ་འཛིན་ལ་འཇུག་ཁར་རལ་བ་རྗེས་སུ་མཛོད་ལས་ཀྱང་ལས་ཕུན་སུམ་ཚོགས་པའི་ཁྱད་པར་ཐོབ་པའི་དོན་ལ་བྱེད་དགོས།",
    "ད་ནི་དབུགས་ཕྱིར་གཏོང་བར་འདུག་ད་ནི་ལམ་ཟིན་རིན་ཆེན་གཏེར་མཛོད།",
    "སེམས་དང་པོ་གཉིས་ལ་བྱིང་རྒོད་ཤས་ཆེ་ཞིང་འགྲོ་འཆག་ཉལ་འདུག་སོགས་ཀྱི་བྱ་བ་བྱེད་ནུས་པའང་འབྱུང་པཏིང་ངེ་འཛིན་ཤས་ཆུང་འདོད་པའི་འཁྲུལ་གཞི་ཡང་ངན་ཤས་ཆུང་བས།",
    "འདི་ལྟར་བྱས་ཁམས་གོང་མའི་སས་བསྡུས་ཀྱི་ཡིད་ལ་བྱེད་པ་ཆུང་དུ་ཐོབ་པ་བབ་པ་ཡིནན་གཞན་དུ་འཕྲོ་བར་འདུག།",
    "བདག་ནི་འརང་བཞིན་མེད་པར་རྟོགས་པའི་ཚེ་ཕུང་བོའང་རང་བཞིན་མེད་པར་རྟོགས་ན་འཇུག་ལྟའི་ཡུལ་དང་།",
    "ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་གཉིས་དང་གཉིས་དང་།",
    "ཐ་སྙད་ཙམ་དུའང་མེད་པ་དང་རང་གཉིས་པ་གནོད་བྱེད་བརྗོདད་ངོ་ཚད་ལྟ་བ་གཉིས་ཀས་དཔྱད་བརྗོད་པ་རྣམས་ཀྱིས་སུན་མི་ཕྱིན་པར་བསྟན་པ་ལ་ས་བཅད་གཉིས་ལ་ཁྱད་པར་ཡོད་པའི་དོན་དང་།",
    "རྩ་ཤེས་ཙདེ་གསུམ་ལ་སུམ་ལ་སྤུ་རིས་སོ་སོར་འབྱེད་དཀའ་བར་འདུག་ཀྱང་།",
    "པར་གསུངས་པ་ཡང་རང་བཞིན་དུ་དྲི་མ་བསལ་ནས་མཛེས་པར་སྒྲུབ་པར་བྱེད་པ་རིགས་པ་དྲུག་ཅུ་བ་ལས་ཕྱོགས་མེད་པར་གསུང་།",
    "དེ་མབདེ་བར་བྱས་ནས་རང་བཞིན་མེད་པར་སྨྲ་བ་ཞེས་པ་ནི་ཐ་པའི་བློ་མངོན་གྱུར་བ་མིན་པ་དང་རང་རྒྱུད་པ་གཉིས་ཀ་ལས།",
    "ཡོད་པ་གང་ཡིན་ང་ལུགས་སུ་མི་འདོད་ཀྱང་རང་ལ་གྲགས་པའི་རྗེས་དཔག་ཏུ་གྱུར་ཚུལ་ནི།",
    "ཞེས་དང་རང་བཞིན་གྱིས་གཅིག་ཏུ་འདོད་པ་ལ།",
    "འགྲེལ་པ་འདི་དག་ལས་གཞན་ཡོད་པར་གསུང་རྒྱུ་ཡང་མི་འདུག་དེས་ན་ད་ལྟའི་ཆར་མཇལ་དུ་ཡོད་པ་དང་ལག་ཏུ་སོན་པ་ནི་དེབ་ཕྲེང་རིམ་པ་གཉིས་པོ་འདིའི་ནང་དུ་གང་བཞུགས་པ་འདི་ཙམ་དུ་འཁུམས་སོ།",
    "ཁག་ཅིག་གཞུང་རང་ནས་གསར་དུ་བཏུས་ཏེ་འདིར་བཀོད་ཡོད།",
    "ཚོར་བའི་རྣམ་འགྱུར་གསོན་པོ་ཟེར་བ་རྣམས་ཀྱང་འདི་ནས་མཐོང་རྒྱུ་འདུག་ལ།",
    "འོན་ཀྱང་དུས་རབས་ཀྱི་རྗེས་ཟིན་དགོས་པ་མ་ཟད་རྗེས་སུ་ཟིན་པར་བྱེད་པ་དེའང་རང་ཉིད་ཡིན་གྱི་དགོས་པ་གཏན་ནས་བརྗེད་མི་རུང་།",
    "དཔེར་ན་བྱ་བ་དང་འདུག་པ་རིགས་པ་ལ།",
    "འདུག་པའི་རིགས་ཞེས་དང་།",
    "དོན་དེ་ལ་ཡང་རང་བཞིན་དང་བཅོས་པའི་སྒོ་ནས་སྙན་ངག་ཕུན་སུམ་ཚོགས་པའི་ཚིག་སྦྱོར་ནི་རྔམ་པའི་ཚིག་རྒྱན་ཡིན་ནོ།",
    "དེ་དང་རང་བཞིན་མཚུངས་པ་དང་།",
    "མུ་སྟེགས་འགའ་ཞིག་གཡོ་སྒྱུ་སྒོ་ནས་ཀྱང་ཕ་རོལ་མི་སྨྲ་བར་འདུག་ན།",
    "ཞེས་གླེང་འདུག་པས།",
    "དེ་དག་ལ་གཟུར་བོའི་བློས་དཔྱད་ན་ཞུ་ཆ་འབུལ་རྒྱུ་འདུག་སྟེ།",
    "འདི་འདྲ་ཅིག་ན་གསུངས་འདུག་པའི་ཕྱིར།",
    "འོན་ཀྱང་དཔེར་བརྗོད་དེ་ལ་བྱ་ཚིག་མང་དུ་འདུག་པས་རིགས་ཀྱི་ཚིགས་བཅད་ལ་བྱ་ཚིག་གཅིག་ཁོ་ནའི་ངེས་པ་ཡོད་ན་དཔེར་བརྗོད་གཞན་ཞིག་འཚོལ་དགོས་པ་འདྲ།",
    "ངེས་པ་མེད་ན་འགལ་བ་མི་འདུག་གོ།",
    "བྱིངས་ལ་མིང་དང་རང་བཞིན་གྱི་བྱིངས་གཉིས།",
    "ནང་པ་དང་ཕྱི་རོལ་པའི་བྱེ་བྲག་དུས་ཀྱི་འཁོར་ལོ་དང་།",
    "རྟོག་པ་འཁྲུལ་པའི་སྟོབས་ཀྱིས་ཤིང་དང་བ་ལང་ཞེས་སྤྱི་གཅིག་ཏུ་བཟུང་ནས་སྤྱི་མཚན་དང་རང་མཚན་གཅིག་ཏུ་ཞེན་པའི་སྒོ་ནས།",
    "དེའང་འཆད་པའི་ཚེ་སྤྱི་དང་རང་སོ་སོར་འབྱེད་ཀྱི།",
    "བྱ་བ་དང་འདུག་པ་རིགས་པ་ལ་བྱ་བའི་རིགས།",
    "འདུག་པའི་རིགས་ཞེས་བྱ་བ་དང་།",
    "ཨ་ར་པ་ཙ་ན་ལ་སོགས་པ་བསྒོམས་པས་དེའི་དོན་ལ་བཟོད་པ་སྐྱེ་བ་ནི་བཟོད་པའི་གཟུངས་སོ།",
    "སྒྲ་རྟག་སྟེ་ཛ་ཝ་ག་ཌ་ད་ཉིད་ཀྱིས་ཕྱིར་ཛྷ་བྷ་གྷ་ཌྷ་དྷ་བཞིན་ནོ་ཞེས་སྒྲུབ་བྱེད་མ་བསྟན་པ་དོན་མེད་པ་དང་ཇི་ལྟ་བའི་དོན་ལན་གསུམ་བརྗོད་ཀྱང་ཕྱིར་རྒོལ་གྱིས་དོན་མི་ཤེས་སྙན་ཚིག་སྔ་ཕྱི་མ་འབྲེལ་བར་བརྗོད་པ་དོན་བྲལ་སྦྱོར་ངག་གོ་རིམ་ལྡོག་དུས་ལ་མ་བབ་དང་།",
    "གཡོ་སྒྱུའི་སྒོ་ནས་ཀྱང་སྐབས་དེར་ཕ་རོལ་མི་སྨྲ་བར་འདུག་ནའང་བདག་རྒྱལ་བ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "རང་རང་ལུང་དང་འགལ་ན་གནོད།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "དེའང་རང་དང་འགལ་བའི་གཞུང་གཞན་རིགས་པའི་སྟོབས་ཀྱིས་དྲང་དོན་ནམ།",
    "དེས་ན་སྐབས་ཀྱི་འགལ་མཚུངས་ཡང་རང་གཤིས་ཀྱི་ངོ་བོ་ལ་བརྟག་སྟེ་ཤེས་པར་བྱ།",
    "ཞེས་གསུངས་ཏེ་དགོད་པའི་རྒྱན་ལའང་རང་བཞིན་གྱི་དགོད་པའི་རྣམ་འགྱུར་ཅན་དང་།",
    "ཞེས་གསུངས་པ་དེ་ཡང་མཐའ་དྲུག་དོན་རྣམས་ཕན་ཚུན་མ་ནོར་བར་དཔྱད་ནས་བླང་དགོས་གསུངས་པ་ལས་རྒྱལ་བ་ཉིད་ཀྱིས་གསུངས་ལ་ནོར་འཁྲུལ་ཡོད་པས་དཔྱད་ནས་བླང་དོར་བྱ་དགོས་ཞེས་གསུངས་པའི་དོན་མིན་པས་དེང་སང་འདི་ལ་གོ་བ་ཞུ་དག་བྱ་དགོས་གསུངས་པར་གོ་ནས་མ་ཡིན་པ་རྣམས་ཡིན་པ་བཟོས་དམིགས་མེད་སྤྲོས་བྲལ་ལ་སྤྲོས་བཅས་བཟོས་ནས་རང་མཁས་མང་པོ་འདུག་པས་སོ།",
    "འདིར་སྐབས་འགར་ཞེས་པས་མགོར་གཉིས་པ་ཡི་གེ་བསྒྱུར་བ་ནི་ཞེས་འཆད་འདུག་གོ།",
    "དངོས་གཞི་རང་རང་བསྟན་པ་བསྲུང་ཕྱིར་རྩོད་པར་བྱ་བ་དང་།",
    "རང་རང་ལུང་དང་འགལ་ན་གནོད།",
