    "དེ་ནི་ཤམྦྷ་ལར་སྤྲུལ་པའི་རྒྱལ་པོས་སྟོན་པ་ཡོད་ཅེས་འདུག་པ་དང་།",
    "སྲིད་ཞིའི་ཁྱབ་བདག་དཔལ་མཆོག་དུས་འཁོར་ལོའི།",
    "སང་ནང་པར་དཀྱིལ་འཁོར་གྱི་ས་གཞིར་མེ་ཏོག་སོགས་ཀྱིས་མཛེས་པར་བྱས་པའི་དབུས་སུ་འདུག་སྟེ།",
    "ཡོངས་སུ་སྨིན་པའི་མཚན་ཉིད་འདོད་དེ་ཡོངས་སུ་སྨིན་པ་ཡང་རྒྱུད་དང་རང་བཞིན་དང་ལས་ཀྱིས་བསྟན་ཏོ་་ཡོན་ཏན་ཤེས་པ་ནི་དི་ལྟར་བཅོམ་ལྡན་འདས་དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱས་པར་འབྱུང་ལྟ་བུ་སྟེ་རྒྱུའོ་་ཤེས་ནས་དད་པ་ཐོབ་པའི་༤",
    "གཞན་དུ་གྱུར་པའི་ཕྱིར་་ཞེས་བྱ་བ་ནི་་ཀུན་གཞི་རྣམ་པར་ཤེས་པར་གཞན་དུ་གྱུར་པའི་ཕྱིར་རོ་་གནས་དང་དོན་དང་ལས་སུ་སྣང་བའི་རྣམ་པར་ཤེས་པ་རྣམས་གཞན་དུ་གྱུར་པ་ནི་ཟག་པ་མེད་པའི་དབྱིངས་ཏེ་་རྣམ་པར་གྲོལ་བའོ་་དེ་ནི་རྟེན་ཏུ་འགྲོ་བ་ཅན་ཏེ་་ཉན་ཐོས་དང་རང་༥",
    "དང་བྲལ་ཕྱིར་ཉེས་པས་དྲི་མ་ཅན་་རྒྱལ་སྲས་ངོ་ཚ་ཤེས་པའི་གོས་ཅན་ནི་་དག་བ་པ་མེད་ཀྱང་ཉེས་པའི་དྲི་མ་བྲལ་འདིས་ནི་ངོ་ཚ་མེད་པ་ནི་དེ་ལས་གཞན་པའི་གོས་གྱོན་ཡང་ཉེས་པས་དྲི་མ་ཅན་ཡིན་པའི་ཕྱིར་ལ་་ངོ་ཚ་དང་ལྡན་པ་ནི་གཅེར་བུར་འདུག་ཀྱང་དྲི་མ་མེད་པའི་ཕྱིར་་ངོ་ཚ་ནི་གོས་༥",
    "ཀུན་བརྟགས་པ་གང་ཡིན་པའོ་་བདག་ཉིད་འདུག་པ་ནི་རང་བཞིན་གྱིས་དམིགས་པར་འགྱུར་གྱི་་འབད་པས་ཀུན་བརྟགས་པ་མ་ཡིན་པ་གང་ཡིན་པའོ་་དེ་རྣམ་པར་འཇིག་པ་ནི་འབྲལ་བ་སྟེ་་དམིགས་པ་མེད་པའི་ངོ་བོའི་་དེའི་ཐབས་ནི་མཚན་མའི་༢",
    "ཀུ་ཤའི་ཁྲེས་ལ་འདུག་ལ་བཟླས་བརྗོད་བརྩམ།",
    "ཞེས་གསུངས་པས་ལོངས་སྐུ་རང་དོན་ཡིན་པས་འཁོར་ཡང་རང་དོན་ཏེ་རང་སྣང་ཡིན་ནོ།",
    "གྲ་ཧ་ཙ་ནི་འཛིན་པའི་སེམས་སུ་འགྲོ་ལ།",
    "ལུས་ཙཎྜ་ལི་དང་རང་བཞིན་གྱིས་གནས་པའོ།",
    "ཡང་ཁྱེད་རང་གནས་གྱུར་པ་ཞེས་བྱ་བ་འདོད་ན་དོན་དམ་པར་གནས་གྱུར་རམ་ཀུན་རྫོབ་ཏུ་ཡོད་པར་གནས་གྱུར།",
    "དེ་བཞིན་དུ་ཁ་ཅིག་དུས་རྒྱུར་སྨྲ་བ་དང་།",
    "ཕྱི་རོལ་པ་དང་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི།",
    "འདུག་དང་ཁྲོ་བ་དང་རྩེ་ཞིང་དགོད་པ་དང་།",
    "ཞེས་གསུངས་ཏེ་འདི་ཤར་ཆེན་གྱི་གསུང་ཡིན་ལ་སྐབས་དོན་རྗེ་བཙུན་གྱི་གསུང་འདིས་འབྲུ་སྣོན་བྱས་ན་ཆོག་པར་འདུག་གོ།",
    "འདུག་སྟངས།",
    "དེ་ཡི་མདུན་དུ་བདག་འདུག་སྟེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ས་ལ་བཞག་པ་རྣམས་ཀྱང་སྣང་བའི་ཕྱིར་རོ།",
    "ཞེས་པའི་དཔེ་དེབ་འདིའི་ནང་རང་ཐོག་དངོས་སུ་མྱངས་པའི་།",
    "བསམ་པ་བྲེང་ཞེས་པའི་རི་ཤུར་དེར་རྒྱུག་པའི་རྫ་ཐུ་སྒྲོལ་བྱེད་ཤིང་གྲུ་འདུག་ཀྱང་དབྱར་ཁ་ཤིན་ཏུ་རྒྱས་ཤིང་རླབས་རྒོད་པས་མི་ཕྱུག་ཟོག་གསུམ་ཚང་མ་གནམ་ཐག་ལ་འཁྲིལ་ནས་བསྐྱོད་དགོས།",
    "བསམ་པ་བྲེང་ཞེས་པའི་རི་ཤུར་དེར་རྒྱུག་པའི་རྫ་ཆུ་སྒྲོལ་བྱེད་ཤིང་གྲུ་འདུག་ཀྱང་དབྱར་ཁ་ཤིན་ཏུ་རྒྱས་ཤིང་རླབས་རྒོདད་པས་མི་ཕྱུག་ཟོག་གསུམ་ཚང་མ་གནམ་ཐག་ལ་འཁྲིལ་ནས་བསྐྱོད་དགོ་ས།",
    "ཇ་སྒམ་འཁྱེར་འདུག་གོ་ལབ་པས།",
    "ཇ་སྒམ་འཁྱེར་འདུག་གོ་ལབ་པས།",
    "༢༩བཅས་ཀྱི་འཚོ་སྐྱོང་ཆེད་སྐུ་ངོ་ཡི་ལྕམ་དང་མཉམ་ཁྱིམ་སྐྱོང་བྱས་ཏེ་སྡོད་དགོས་ཞེས་ཁ་ཆེམས་བཞག་འདུག་པ།",
    "༢༩བཅས་ཀྱི་འཚོ་སྐྱོང་ཆེད་སྐུ་ངོ་ཡི་ལྕམ་དང་མཉམ་ཁྱིམ་སྐྱོང་བྱས་ཏེ་སྡོད་དབོསྟེས་ཞེས་ཁ་ཆེམས་བཞག་འདུག་པ།",
    "འཇྀག་རྟེན་མབུན་འདུགང་ཆུང་དུས་ཕ་ཡུལ་ལ་དབྱར་ཁ་ཞིང་ནང་རྩྭ་འཐུ་བ་དང་།",
    "ངས་ལམ་སེང་ཆོདང་ཡག་པོ་བྱུང་མི་འདུག་བཤད།",
    "མགོ་སྤར་བར་བཀབ་ནས་དཔེ་མི་སྲིད།",
    "མགོ་སྤར་བར་བཀབ་ནས་དཔེ་མི་སྲིད།",
    "གཡོག་པོ་གཡུགས་བཞག་ནས་ང་རང་གཉིས་རྒྱུགས་འགྲོ་ཟེར།",
    "གཡོག་པོ་གཡུགས་བཞག་ནས་ང་རང་གཉིས་རྒྱུགས་འགྲོ་ཟེར།",
    "འཇིགས་མེད་དང་དངུལ་སྐུས་བྲོས་ནས་ཐར་ཐབས་མི་འདུག་པས་རྒྱ་མིའི་ལག་ཏུ་འཆི་རྒྱུ་གཏན་ཁེལ།",
    "འཇིགས་མེད་དང་དངུལ་སྐུས་བྲོས་ནས་ཐར་ཐབས་མི་འདུག་པས་རྒྱ་མིའི་ལག་ཏུ་འཆི་རྒྱུ་གཏན་ཁེལ།",
