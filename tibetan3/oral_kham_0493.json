    "ང་ཟེར་བའི་གཅེས་ཕྲུག་༩རྗེ་ཡབ་སྲས་ཀྱི་གསུང་འདི་མེད་ན་རྒྱུད་ལ་འབྱར་ཐབས་མི་འདུག་གསུངས།",
    "གྲྭ་རྐྱང་སོགས་ཀྱང་རང་དང་གྲྭ་ཐོག་གཅིག་པ།",
    "ངས་ཤམ་ཐབས་དང་གཟན་ཚོས་དམར་པོ་བྱས་པ་གསར་བ་ཞིག་བཟོས་པར་ཕྱི་དམར་པོ་འདུག་སྟེ་དེ་ལས་ནང་དམར་པོ་དགོས་རྒྱུ་ཡིན་གསུངས།",
    "ང་རང་ལ་ཡང་མིས་ཆུ་མིག་བརྒྱ་སྐོར་ལ་ཕྱིན་དོ་ཟེར་བ་ཡང་བྱུང་།",
    "ཁྱད་པར་འཕེལ་ཡང་རང་བཞིན་ཉིད།",
    "བ་ཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "ནང་རང་ངོབོ་ལ་གནས་ཕྱིར།",
    "ཇི་ལྟར་ཨུཏྤལ་དྲི་ཡང་པོ་ལ་སོགས་པ་འཛིན་ཡང་རངེད་པ་གནས་པ་དེ་བཞིན་དུ་འདི་ཡང་ངོ་ཞེས་པའི་དོན་ཏོ།",
    "མི་ཤེས་ཞེས་པ་ལ་སོགས་པ་འགྱུར་ཞེས་པ་ལ་སོགས་པས་སྐྱེས་པ་ལས་ཀྱང་སླར་ཡང་རང་བཞིན་འབྱུང་ལ།",
    "དེ་བཞིན་དུ་གྱུར་རང་དང་རང་ཉིད་སྟོང་པར་རྟོག་པར་བྱེད་དོ།",
    "ཡད་གང་རང་བཞིན་གྱིས་མེད་གང་།",
    "ང་རང་བཞིན་གྱིས་ཡོངས་སུ་གྱུརཔའོ།",
    "དེ་ལྟར་བྱས་ཀྱང་གྲུབ་པ་མེ་ནི་ཇི་ཙུང་རང་བཞིན་གྱིས་རྣམ་པར་རྟོག་པ་གཙང་བ་དང་མི་གཙང་བ་ལ་སོགས་པ་ཉེ་བར་མ་ཞི་ན།",
    "དང་རང་བྱིན་གྱིས་བརླབ་པའི་དམ་པ་བསྟན་ཏོ།",
    "བལ་པོ་ཐུགས་རྗེ་ཆེན་པོ་ཞེས་སོ་སོར་བྱས་འདུག་པ་ཐུགས་རྗེ་ཆེན་པོ།་",
    "ཐར་རྩེ་སྒྲུབ་ཁང་པ་ཤར་པ་གསུམ་གྱི་གསན་ཡིག་ཏུ་དོན་ཡོད་རྡོ་རྗེ་ཡིན་ཚུལ་འདུག་པ་གསང་མཚན་དང་འཁྲུལ་ལམ་དཔྱད།",
    "རྭ་ཚོ་ནུབ་པ་ཟེར་བ་འདུགསྲས་ཡེ་ཤེས་སེང་གེརྭ་འབུམ་སེང་།",
    "མཁན་ཆེན་བཟང་རྒྱན་པས་ལུང་གསན་དུས་ཀྱང་ཕྱག་དཔེ་དེ་ཁ་ཡིན་འདུག་གསུང་ངོ།",
    "ངོར་ཆེན་དང་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་བཀའ་བབ་བདུན་ལས་མི་འདུག་ཀྱང་ཇོ་བོ་ལུགས་གཉིས་སོ་སོར་བགྲངས་གཉོས་ལུགས་བསྣན་པས་དགུ་བྱུང་ངོ།",
    "བུའི་གསན་ཡིག་ན་མ་ན་ཀ་དང་ཤྲཱི་ཛྙཱ་ན་ཞེས་འདུག་པ་ཡིག་སྐྱོན་བྱུང་ངམ་སྙམ།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ན་འདི་ཇོ་བོའི་རྗེས་སུ་འདུག་པ་ཡིག་ནོར་བྱུང་འདྲ།་",
    "འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་དཔྱད།",
    "གསན་ཡིག་ཚོར་འདི་བཞིན་འདུག་ཀྱང་མར་ལོ་སོགས་མ་བྱུང་བས་དམར་ལུགས་ཟེར་རྒྱུ་ཡིན་ནམ་དཔྱད།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་འདི་ཇོ་ལུགས་བརྒྱུད་པའི་རྣམ་གྲངས་སུ་མཛད་འདུག་ཅིང་ཐར་རྩེ་དང་ཤར་པའི་གསན་ཡིག་ན་དཀྱུས་བཞིན་དུ་སོ་སོར་སྣང་།",
    "གསན་ཡིག་འགའ་ཞིག་ཏུ་འདིའི་རྗེས་སུ་ནག་པོ་པ་འདུག་གུ་ཧྱ་པ།",
    "བུ་སྟོན་གོང་དཀར་བའི་གསན་ཡིག་ནའང་མཚན་གསལ་མི་འདུག་རིན་ཆེན་གྲུབ།",
    "མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཨ་བྷྱ་རཀྵི་ཏ་ཞེས་གཅིག་ཏུ་བསྡོམས་འདུག་ཀྱང་གོང་དཀར་བ་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་དཀྱུས་ལྟར་སྣང་ངོ།",
    "ངོར་ཆེན་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་གྲགས་པ་དཔལ་ཞེས་པ་དཀྱུས་སུ་བྲིས་པར་རྡོ་རྗེ་ཡིན་ནམ་འདི་མ་དག་ཟེར་བའི་མཆན་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་འདི་ལྟར་སྣང་ངོ།",
    "དཔལ་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་ཀྱང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་བཞུགས་པས་ཆད་དམ་སྙམ།",
    "ཐར་རྩེ་པ་སོགས་ཀྱི་གསན་ཡིག་ན་མི་འདུག་ཀྱང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་དེར་སྣང་བས་ཆད་དམ་སྙམ།",
    "བྱམས་པ་འདི་མི་འདུག་ཆད་དམ་སྙམ།",
    "གོང་དཀར་བ་དང་ཐར་རྩེ་བའི་གསན་ཡིག་ན་པཎྜི་ཏ་ཨཱ་ཙཱརྻ་ཞེས་པ་འདུག་དུས་ཞབས་པ་ཆེ་ཆུང་།",
    "ཡང་འཕགས་པའི་བསྟོད་པ་གྲགས་ལྡན་མ་ཤློ་ཀ་གཅིག་རྒྱ་ནག་རྒྱལ་པོས་མི་ཉག་པཎ་ཆེན་གྲགས་པ་རྡོ་རྗེའི་བཀའ་འབུམ་ནའང་འདུག་པ་དེས་མཛད་དམ་བརྟག་མཛད་པར་གྲགས་པ།",
    "ཏ་ཏྭ་སྱ་ཛྙཱ་ན་ཀྲྀ་སཱ་ནུ་བྷ་ཝེ་ར་ནུ་དྷ་ར་ཀ་སྱཱཏྨ་བནྡེ་ཤཱི་ལ་རཏྣཾ་ཝ་ཙ་ན་ཝཱ་གྲཏྣ་སྱཱ་བྷི་ཥེ་ཀ་ནཱ་ཡ་ནོ་པ་རི་པཱུརྞཎ་སྟྲི་ཎཱཉྩ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་བི་ན་པ་ཏི་དང་ཐར་རྩེ་བའི་དེར་པཱི་ན་པ་ཞེས་པི་ཝཾ་འཛིན་པ་ཡིན་ཞེས་སྣང་ངོ།",
    "གོང་དཀར་བ་དང་ཐར་རྩེ་བའི་དེར་བཟང་པོའི་ཞབས་སུ་བསྒྱུར་འདུག་གྲུབ་ཆེན་ཏོག་ཙེ་པ།་",
    "གོང་དཀར་བའི་དེར་གྷུ་ཤ་ན་འདུག་དྷ་མ་པ།་",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་ག་ཡ་དྷ་ར་ཟེར་བ་འདུག་པ་བླ་ཆེན་གྱིས་རྒྱ་གར་དུ་དཔའ་བོ་རྡོ་རྗེ་དང་བོད་དུ་ག་ཡ་དྷ་ར་ལས་གསན་པའི་ཁུངས་མཛད་འདུག་འབྲོག་མི་མན་གོང་བཞིན་ནོ།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ཏུ་ལེགས་སྨིན་ཞེས་ཟུར་ཆག་འདུག་རྒྱལ་པོ་ཨིནྡྲ་བྷཱུ་ཏི་ཆུང་བ།",
    "དགེ་སློང་པྲཛྙཱ་ཨིནྡྲ་རུ་ཙི་རྡོ་རྗེ་གདན་པའི་དེར་བཱི་ར་བཛྲ་དང་ཐར་རྩེ་པའི་དེར་དཔའ་བོ་རྡོ་རྗེ་ཞེས་འདུག་པ་དཔྱད།",
    "འབྲོག་མི་ལོ་ཙཱ་བ་རྡོ་རྗེ་གདན་པའི་དེར་བོད་དུ་ཡང་ཤེས་རབ་གསང་བར་གསན་ཟེར་བ་འདུག་མན་སྔར་དང་འདྲའོ།",
    "༡༨ཅོ་མ་རིག་༡༨༡ཅོ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན།",
    "༡༩སྣར་ཞོལ་བྱམས་པ་ཆེན་པོའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
