    "སྐབས་དེར་ཕལ་ཆེར་ཆོདད་རྩིས་བྱས་ན་མི་ཁྲི་བརྒལ་འདུག་བཅདད་ནའང་ཉུང་སྐྱོན་ལས་མང་སྐྱོན་མེད།",
    "༡༨༥སྐབས་དེར་ངས་ཀོ་ཤི་ལན་གྱི་གཏམ་དེར་སྐྱོན་འདུག་བསམ་ནས།",
    "༡༨༥སྐབས་དེར་ངས་སྤོ་ཤི་ལན་གྱི་གཏམ་དེར་སྐྱོན་འདུག་བསམ་ནས།",
    "ང་རང་ནི་རྫུ་འཕྲུལ་གྱི་རྩལ་དང་ལྡན་པ་ཞིག་ཡིན་ན་ཅི་མ་རུང་སྙམ་པ་དང་།",
    "ང་རང་ནི་རྫུ་འཕྲུལ་གྱི་རྩལ་དང་ལྡན་པ་ཞིག་ཡིན་ན་ཅི་མ་རུང་སྙམ་པ་དང་།",
    "དེར་ངའི་བུ་ཡང་གཙུག་ལག་ཁང་དུ་ཡོད་འདུག་པས།",
    "དེར་ངའི་བུ་ཡང་གཙུག་ལག་ཁང་དུ་ཡོད་འདུག་པས།",
    "སྐུ་ཚབ་བོད་ནས་ཕུད་འདུག་ཟེར།",
    "སྐུ་ཚབ་བོད་ནས་ཕུད་འདུག་ཟེར།",
    "ཧཱུ་ཡའོ་ཕང་ཧ་ལས་ཏེ་བོད་མི་རྣམས་དཀའ་ངལ་ཆེན་ལྔ་བྱུང་འདུག་ཅེས་བཤད།",
    "ཧུ་ཡའོ་ཕང་ཧ་ལས་ཏེ་བོད་མི་རྣམས་དཀའ་ངལ་ཆེན་པོ་བྱུང་འདུག་ཅེས་བཤད།",
    "ནང་བལྟ་མཁན་ཉུང་ངུ་ལས་མི་འདུག་ཅིང་ཛ་སག་ཅིས་འཇིགས་མེད་ལ་བལྟ་རྟོག་བྱེད་མཁན་ཧ་ཅང་མང་།",
    "ནང་བལྟ་མཁན་ཉུང་ངུ་ལས་མི་འདུག་ཅིང་ཛ་སག་ཅིས་འཇིགས་མེད་ལ་བལྟ་རྟོག་བྱེད་མཁན་ཧ་ཅང་མང་།",
    "ཁྱེད་རྒྱ་གར་ལ་འགྲོ་ཐུབ་པ་འདུག་ཟེར།",
    "ཁྱེད་རྒྱ་གར་ལ་འགྲོ་ཐུབ་པ་འདུག་ཟེར།",
    "ག་འཁྱེར་སྤྲད་ཀྱི་མི་འདུག་ཅེས་བཤད།",
    "ག་འཁྱེར་སྤྲད་ཀྱི་མི་འདུག་ཅེས་བཤད།",
    "ངའི་བུ་ལ་ཁྱེད་རང་རྒྱ་ཡིག་ཡག་པོ་མཁྱེན་གྱི་ཡོད་ཅེས་ཐོས་བྱུང་བས།",
    "ངའི་བུ་ལ་ཁྱེད་རང་རྒྱ་ཡིག་ཡག་པོ་མཁྱེན་གྱི་ཡོད་ཅེས་ཐོས་བྱུང་བས།",
    "གང་འདྲས་འདུག་ལམ་བར་དུ་དཀའ་ངལ་འཕྲད་མ་བྱུང་ངམ།",
    "གང་འདྲས་འདུག་ལམ་བར་དུ་དཀའ་ངལ་འཕྲད་མ་བྱུང་ངམ།",
    "མཇལ་ཁ་ཞུ་མཁན་མང་ལྔ་འདུག་གམ་ཞེས་དྲིས།",
    "མཇལ་ཁ་ཞུ་མཁན་མང་པོ་འདུག་གམ་ཞེས་དྲིས།",
    "དཔོན་རིགས་ཚོར་སློབ་སྦྱོང་སྒོད་བྱེད་བོད་ཀྱི་ས་ཁམས་ཆགས་ཚུལ་དང་རང་འབྱུང་གཏེར་ཁ་ཇི་ཡོད།",
    "དཔོན་རིགས་ཚོར་སློབ་སྦྱོང་སྤྲོད་བྱེད་ངེ་ད་ཀྱི་ས་ཁམས་ཆགས་ཚུལ་དང་རང་འབྱུང་གཏེར་ཁ་ཇི་ཡོད།",
    "སྐུ་མདུན་ནས་རྟགས་མཚན་གསལ་ཝ་འདུག་ཉིན་ཤས་སྒུག་དང་དེ་ནས་ལན་སྤྲད་ཛདག་ཅེས་བཀའ་ཕེབས་རྗེས།",
    "སྐུ་མདུན་ནས་རྟགས་མཚན་གསལ་པོ་འདུག་ཉིན་ཤས་སྒུག་དང་དེ་ནས་ལན་སྤྲད་ཆོག་ཅེས་བཀའ་ཕེབས་རྗེས།",
    "ད་མི་རྒན་ཆགས་འདུག་སྔོན་མའི་བཟོ་ལ་བསྡད་མི་འདུས།་",
    "ད་མི་རྒན་ཆགས་འདུག་སྔོན་མའི་བཟོ་ལ་བསྡད་མི་འདུས།་",
    "ཡག་པོ་འདུག་ཅེས་ཞལ་པར་གནང་འདུག་པས།",
    "ཡག་ཝ་འདུག་ཅེས་ཞལ་པར་གནང་འདུག་པས།",
    "ཉེ་ཆར་ཐེ་ཝན་གྱི་གསར་འབོ་ད་པ་གཉིས་སྐུ་མདུན་མཇལ་ཁ་དང་གཞིས་ཆགས་ཁག་ལ་ལྟ་སྣར་དུ་བསྐྱོད་དེ་གནས་ཚུལ་རིང་ཝ་ཞིག་རྒྱ་ཡིག་ནང་བྲིས་ནས་བསྐུར་འདུག་པས།",
    "ད་ནམས་སྟོསྟོབས་རྒྱས་ལགས་ཀྱིས་ཞལ་ཅདབ་དང་སྦྲགས་ནམ་རྒྱུན་སྤྱི་ཐབ་ཀྱི་ཇ་དེ་ཙམ་ཡག་ཁྲོད་བསྣ་ཡི་མེད་ཀྱང་དེ་རིང་ཇ་ཡག་པོ་བཟོས་འདུག་པས།",
    "ཁྱེད་རང་ལམ་འགྲོ་ཡག་པོ་རྒྱུགས་པ་འདུག་ཅེས་གསུངས་ཚུལ་སོགས་བུ་ནང་ལ་ལོག་ཡོང་ནས་དགའ་སྒོ་དང་བཅས་ཏེ་བཤད།",
    "གྲོ་ངས་ཕྱིན་ནས་བདུན་ཚིགས་བཞི་པར་ངའི་བུ་ལ་ལན་འགྱོར་འདུག་ཀྱང་།",
    "གྲོངས་ཕྱིན་ནས་བདུན་ཚིགས་བཞི་པར་ངའི་བུ་ལ་ལན་འབྱོར་འདུག་ཀྱང་།",
    "ད་ཆ་ང་རང་བརྩིས་པའི་མི་ཐོག་བཞི་པ་དང་།",
    "ད་ཆ་ང་རང་བརྩིས་པའི་མི་ཐོག་བཞི་པ་དང་།",
    "སྤྱི་ལོ་༡༩༨ ནང་རང་ཡུལ་དུ་འདས།",
    "སྤྱི་ལོ་༡༩༨ ནང་རང་ཡུལ་དུ་འདས།",
    "དབོ་ས་མི་འདུག་གམ།",
    "ངམ་རིང་སོགས་ཀྱི་མི་དམངས་ཀྱི་གསོ་དགོས་མི་འདུག་གམ།",
    "བདེ་བའི་སྟན་ལ་ཀློད་ལ་འདུག་ནས།",
    "སྤྲོས་པ་རྣམས་དང་བྲལ་བར་འདུག་སྟེ།",
    "མཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "དེའི་རང་རང་ཉེ་འཁོར་ན་མཁའ་འགྲོ་མ་གྲངས་མེད་པ་དང་བཅས་པས་བསྐོར་ནས་བཞུགས་སོ།",
    "འཁོར་རྣམས་ཀྱིས་བསྐོར་བ་ལན་བདུན་བྱས་ཏེ་མདུན་དུ་འདུག་ནས་སྟོན་པ་ལ་འདི་སྐད་ཞུས་སོ།",
    "རང་བྱུང་མཐའ་རུ་འདུག་པས་རྐྱེན་གྱིས་འཇིག་བྲལ་མེད།",
    "གཞི་དངགཞི་སྣང་ཆེན་པོའི་འདུག་ཚུལ་ང་ཡིས་སྨྲ་ཡིས་མ་ནོར་ཡིད་ལ་ཟུང་ཞིག།",
    "གཞི་དང་གཞི་སྣང་ཆེན་པོའི་འདུག་ཚུལ་བསྟན་པའི་ལེའུ་སྟེ་བཞི་པའོ།",
    "གནས་ལུགས་དོན་གྱི་ཀུན་གཞི་ནི་འདུག་ཚུལ་བརྒྱད་ཀྱི་དཔེའོ།",
    "གཞན་སེལ་ནི་རིག་པར་འདུག་པས་བེམ་པོ་སེལ།",
    "སྟོང་པར་འདུག་པས་དངོས་པོ་སེལ།",
    "དེ་ཡང་རང་བཞིན་རྣམ་པར་དག་པས་རྟག་པའི་མཐའ་ལས་འདས།",
    "འདུག་ཚུལ་འོད་དུ་འདུག་པས་ཆད་པའི་མཐའ་ལས་འདས།",
    "ཤར་ཀྱང་རང་རིག་གཅིག་པུར་གསལ།",
    "གཞན་ལས་མ་བྱུང་རང་ལས་རང་བྱུང་བས།",
    "ཐམས་ཅད་རང་སྣང་རང་ཤར་ཡིན།",
    "རང་ལས་ཤར་ཞིང་རང་ལས་གྲོལ།",
    "སྒྱུ་མའི་དཔེ་བཞིན་སྣང་ཡང་རང་བཞིན་མེད།",
    "རང་རང་བཞིན་འོད་ལྔ་གསལ་མ་ནུས།",
    "རང་རང་ཕྱག་མཚན་ཐུགས་ལ་གབ།",
    "ང་རང་སྤྲུལ་པའི་སྐུ་ཡིན་པས།",
    "ཚིག་རྣམས་རང་རང་དོན་ལ་སྦྱོར།",
    "རང་རང་དོན་ལ་བསྒོམ་དུས་སུ།",
    "རང་རང་སྐབས་ནས་རྫོགས་པར་འགྱུར།",
    "རིག་པའི་ངོ་བོ་སྟོང་པར་འདུག་པས་ན།",
    "གསལ་བའི་ཕྱོགས་ནས་བལྟས་ན་གསལ་བར་འདུག།",
    "རང་ཤར་རང་སྣང་རང་གསལ་ཡེ་ཤེས་གདངས།",
    "ཕྱི་ཡི་ཡུལ་ལ་སྤྱོད་ཀྱང་རང་སར་གྲོལ།",
    "དེ་ཉིད་གསལ་བར་འདུག་པས་སྟོང་གསལ་ཆེན་པོ་ཡིན།",
