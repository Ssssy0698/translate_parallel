    "ནང་བྱང་སེམས་ཀྱི་བསླབ་པ་ཕྱིན་དྲུག་གི་སྤྱོད་པ་ལས་མི་འདའ་ཞིང་འགྲོ་བ་ཡོངས་ལ་བུ་གཅིག་པའི་མ་ལྟར་བརྩེ་བ་རྒྱལ་སྲས་ཞི་བ་ལྷ་ལྟ་བུ།",
    "གསང་བ་སྔགས་ཀྱི་ལྟ་དགོངས་མཁའ་ལྟར་ཟབ་ཅིང་ཁྱད་པར་འོད་གསལ་རྫོགས་པ་ཆེན་པོའི་ཐུན་མིན་མན་ངག་གི་གཏད་རྒྱ་ཆིག་བརྒྱུད་དུ་བསྩལ་ཅིང་བསྟན་པ་གཏད་པའི་ཐུགས་སྲས་ཀྱི་བུ་ཆེན་གཅིག་པུར་གྱུར་པ་གསང་འཛིན་དགའ་རབ་དཔའ་བོ་ལྟ་བུ་སྟེ།",
    "རེ་དོགས་གཉིས་འཛིན་དང་བྲལ་བའི་འབྲས་བུའི་སྣང་བ་ཐམས་ཅད་དགག་སྒྲུབ་བླང་དོར་གྱི་རྟོག་པས་མ་བསླད་པར་གང་ཤར་གྱི་རང་ངོ་མཐའ་གྲོལ་ཀློང་ཡངས་ཆེན་པོའི་ངང་དུ་བསྐྱངས་པས།",
    "བཞུགས་སྟངས་གསུམ་དང་གཟིགས་འཇིགས་མེད་རྟ་མགྲིན་ཡོན་ཏན་མགོན་པོའི་གསུང་འབུམ།",
    "མཆོག་ཐུན་འབྲས་བུ་ཐོབ་ཏུ་རེ།",
    "ལྟ་སྒོམ་བཅོས་མའི་རེ་དོགས་དགོས་ཚོད་ནི་མི་གདའ།",
    "ངོས་ཀྱང་ལོ་ངོ་བཅུ་ནས་བཅུ་དྲུག་གི་བར་དུ་ཉིན་མཚན་སྐད་ཅིག་ཙམ་ཡང་འབྲལ་བ་མེད་པར་གཟིམས་ཤག་གཅིག་ཏུ་རྣམ་གཉིས་ཀྱི་སྐུ་འཁྲིས་སུ་ཐུགས་བརྩེ་ཆེན་པོའི་དགྱེས་སྐྱོང་དང་བཅས་ཞབས་པད་བསྟེན་རྒྱུའི་སྐལ་བ་བཟང་པོ་བྱུང་ཞིང་།",
    "དེ་ལྟ་བུའི་རྣམ་གཉིས་ཀྱི་སྐུ་དྲིན་དང་ཞལ་ཆེམས་གཙོར་བཟུང་གིས་ད་ལྟའི་བར་གང་གི་བསྟན་པའི་མེ་རོ་སློང་བའི་བྱ་བཞག་སྤྱི་དང་།",
    "དམ་པ་འདི་ཉིད་ཀྱི་སྐུ་འཁྲིས་སུ་ཇི་ཙམ་ཡུན་རིང་གཤིབས་ཀྱང་སྐྱོན་གྱི་ཆ་ཕྲ་མོ་ཙམ་མཐོང་བ་སུ་ཡང་མི་སྲིད།",
    "ཁོ་བོ་མཉམ་བཅར་གྱི་མི་ལོ་དྲུག་རིང་ཉིན་མཚན་ཀུན་ཏུ་གཟིམས་ཁྲི་གྲུ་བཞི་མ་ཞིག་གི་ནང་དུ་མཉམ་བཞག་གིས་བཞུགས་པ་ལས།",
    "ཡང་ནས་ཡང་དུ་ཉན་སྤྲོ་ཞིང་སུན་པ་མེད་པ་ཚངས་པའི་དབྱངས་ཀྱི་ཡན་ལག་གི་ངེས་པ་ཅན་ཞིག་སྟེ།",
    "རྒྱུ་ནོར་ལ་ཞེན་འཛིན་གཏན་ནས་མེད་ཅིང་སྤྲིན་ལྟར་འདུ་བའི་དད་འབུལ་གྱི་དངོས་རྫས་ཐམས་ཅད་མཆོད་སྦྱིན་དང་ཚོགས་འཁོར་གྱི་རྟེན་རྩར་འཕྲལ་བཏང་གནང་བ་དང་།",
    "ཉིན་རེ་བཞིན་ནམ་གྱི་ཆ་སྨད་ཀྱི་ཐུན་མཚམས་ཐོ་རེངས་ལ་སྐུ་དངོས་ཀྱིས་ཕྱག་དར་ནས་མཆོད་ཡོན་དང་མར་མེ་མཎྜལ་འབུལ་བ་སོགས་ཉིན་གཅིག་ལྟར་འཇིགས་མེད་རྟ་མགྲིན་ཡོན་ཏན་མགོན་པོའི་གསུང་འབུམ།",
    "ཕྱོགས་ཀྱི་སློབ་ཚོགས་ཀུན་གདམས་ཁྲིད་དང་མན་ངག་གིས་ཚིམ་པར་མཛད་ཅིང་འགྲོ་ཁར་འབྲལ་མི་ཕོད་པར་མིག་ནས་མཆི་མ་བཀུ་བཞིན་གྱེས་ཕྱག་འབུལ་མཁན་ཤ་སྟག་འབྱུང་།",
    "གསུང་རྩོམ་ཐམས་ཅད་ཀློང་རྡོལ་རང་བབ་ལས་ཉིས་འབྲི་དང་བཅོས་སྣོག་དཔྱད་གཞིར་གཟིགས་པ་སོགས་གཏན་ནས་མི་མངའ།",
    "ས་ཁྱིའི་དུས་འགྱུར་སྐབས་བཙོན་དུ་རྡུང་རྡེག་བྱེད་པ་གཉིས་ལ་དགའ་སྡང་གི་ཁྱད་པར་ཡོད་པ་མ་མཇལ།",
    "སྐབས་སུ་གཉན་ས་གཅོད་པ་དང་མཚམས་རེར་མཚན་མོ་ཐོལ་བྱུང་དུ་འཛིན་གྲོལ་གྱི་ལུས་སྦྱིན་གསུངས་པ་སོགས་མཐོང་ཐོས་ཐུབ་ཅིང་།",
    "སྐབས་རེར་ནམ་ཕྱེད་ཙམ་ལ་གཏད་མེད་དུ་ཕཊ་སྒྲ་དྲག་པོ་བརྒྱབ་པ་དང་སཾ་ཀྲི་ཏའི་སྐད་དང་མཁའ་འགྲོའི་བརྡ་སྐད་སོགས་རང་རྡོལ་དུ་ཡུན་རིང་གསུངས་པ་ཐོས་མྱོང་།",
    "མཚམས་རེར་ནམ་གུང་མུན་པའི་སྨག་ལ་གཟིམས་ཤག་གམ་གཟིམས་གུར་དུ་གསལ་ལྷང་ངེར་ཡོད་པ་ལན་མང་མཇལ།",
    "འབྲེལ་བ་ཙམ་གྱིས་སྲིད་རྩ་ཧྲུལ་པོར་བགྱིས་པ་དེ་བས་མང་བ་སོགས་རྒྱལ་དང་དེ་སྲས་ཀྱི་མཛད་པ་མཐའ་ཡས་ཞིང་དང་རྡུལ་གྱིས་གཏུག་པ་མེད་པའི་འགྲོ་མང་གྱི་ཁམས་ལ་རྟག་ཏུ་ཁྱབ་ཅིང་འཇུག་པ་ཐ་མལ་སྒྲ་ཚིག་གི་ཡུལ་དུ་མ་གྱུར་ཕྱིར།",
    "དགུང་གྲངས་རེ་གཅིག་བཞེས་པ་ས་ཕག་ལོའི་དུས་ཟིང་སྐབས་རེ་ཞིག་ཞིང་འདིར་སྐུ་ལུས་དེའི་མཛད་པ་འཕྲོ་ཅན་དུ་གནང་ནས།",
    "རེ་དོགས་དབྱིངས་སུ་དག་པའི་གླུ་ཆུང་།",
    "རྟོགས་པའི་འདྲ་འབག་སྙན་འགྱུར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་དབྱངས་སྙན།",
    "བློ་འདས་རྒྱ་ཡན་གྱི་ཐོལ་གླུ་རིག་པའི་ཁུ་བྱུག་གི་མགྲིན་སྒྲ།",
    "རྟོགས་གྲོལ་ཤུགས་འབྱུང་གི་དོ་ཧ།",
    "རེ་དོགས་འཛིན་པ་ཟད་པའི་སྣང་གླུ།",
    "གདམས་པ་རང་གྲོལ་ཟང་ཐལ།",
    "རིག་པ་ངོ་སྤྲོད་གཅེར་མཐོང་ཟང་ཐལ།",
    "ཟབ་མོ་ལྟ་ཁྲིད་གཅེར་མཐོང་རང་གྲོལ།",
    "རོ་སྙོམས་བརྟུལ་ཞུགས་ཀྱི་གདམས་པ་རེ་དོགས་ཚར་གཅོད།",
    "བདེ་བར་གཤེགས་པ་སུམ་ཅུ་སོ་ལྔ་ལ་བསྟོད་པ་ལྷའི་རོལ་མོ།",
    "རྒྱལ་བ་ཐམས་ཅད་བསྐྱེད་པའི་ཡུམ་དབྱིངས་ཕྱུག་བདེ་ཆེན་མཚོ་རྒྱལ་མ་ལ་བསྟོད་པ་དཔྱིད་ཀྱི་དཔལ་མོའི་གླུ་དབྱངས།",
    "ཚེ་ཕུར་བསྒྲགས་མའི་རྣལ་འབྱོར་ཟབ་མོ།",
    "ཆོ་འཕྲུལ་ཟླ་བའི་བུམ་སྒྲུབ་ཆེན་མོའི་ཞལ་བཀོད་སྟོང་ཐུན་ཉུང་གསལ།",
    "ཤུགས་འབྱུང་གི་ཉམས་རྟོགས་འདི་འདྲ་སྐྱེས།",
    "རིག་སྟོང་གི་རང་ཞལ་རྗེན་པར་བུད།",
    "ཐ་མལ་རང་ལུགས་སུ་གུ་རེ་ཡངས།",
    "ཀུན་རྟོག་རང་གྲོལ་དུ་བློ་རེ་བདེ།",
    "ཟང་ཐལ་ཐོག་བབས་ལ་རེག་པར་དཀའ།",
    "སྒོམ་བློའི་ཨ་འཐས་དེས་འཆིང་གིས་དོགས།",
    "གཅེར་གྲོལ་རིག་སྟོང་གི་ཁྱུང་ཆེན་ལྡིང་།",
    "ཞེས་ཉམས་མཚར་དུ་སྤྲང་སྨྱོན་ཡོན་ཏན་མགོན་པོས་བྲིས་ཏེ་ཕུལ་བ་དགེ། ། རེ་དོགས་དབྱིངས་སུ་དག་པའི་གླུ་ཆུང་།",
    "ཟང་ཐལ་རིག་པའི་ཐིག་ལེ་གཉིས།",
    "ད་མང་པོའི་རེ་དོགས་བྱ་མ་དགོས།",
    "རང་གནས་ཀ་དག་གི་དགོངས་པ་གཉིས།",
    "ཡེ་གྲོལ་ཟང་ཐལ་གྱི་གཤིས་སུ་གཅིག།",
    "སྤང་བླང་གི་ཨ་འཐས་བྱ་མ་དགོས།",
    "བདེན་གཉིས་རེས་འཇོག་གི་གཞི་རྩ་བྲལ།",
    "འཐོབ་བྱའི་རེ་དོགས་རང་ངོར་དག།",
    "ཟང་ངེ་ཐལ་ལེ་བསམ་ངོ་བྲལ།",
    "མོས་གུས་ཀྱིས་ཕ་ཕོགས་ཐོབ་པས་འཚེངས།",
    "གཟུང་འཛིན་ཐད་ཀར་ཞིག་པ་ལམ་ཁྱེར་གྱི་རྩེ་མོ།",
    "ཟང་ཐལ་གྲུབ་བརྒྱའི་གཤེགས་ཤུལ་ཐག་རིང་ན་མི་འདུག།",
    "འཁྲུལ་བ་གཞི་གྲོལ་རྟོགས་ན་འཁྲུལ་ཞིག་གི་རྒྱལ་པོ།",
    "ཡིན་ལུགས་མངོན་དུ་གྱུར་ན་ཀུན་བཟང་གི་རྒྱལ་ཐབས།",
    "རྣལ་འབྱོར་སྨྱོན་པ་ང་ཚོའི་རྗེས་ཤུལ་ལ་ཕེབས་དང་།",
    "ཐོལ་སྐྱེས་རྟོག་པའི་རི་མོ་རང་མལ་དུ་ཞིག་ནས།",
    "བློ་བྲལ་གཤིས་ཀྱི་མལ་དུ་རང་བྱུང་གི་ཁྱེའུ་ཆུང་།",
    "རེ་དོགས་མཐའ་ལས་གྲོལ་བའི་སྐྱིད་གླུ་འདི་ཐལ་ལོ། ། རྟོགས་པའི་འདྲ་འབག་སྙན་འགྱུར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་དབྱངས་སྙན།",
    "བློ་བྲལ་རིག་པའི་རང་ངོ་ཟང་ཐལ་དུ་བསྐྱངས་པས།",
    "ཆེད་འཛིན་བློ་ཡི་རི་མོ་མཉམ་ཉིད་དུ་དག་སྟེ།",
