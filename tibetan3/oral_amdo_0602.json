    "འཕགས་པ་ཐོགས་མེད་རང་གི་བཞེད་པ་ལྟར།",
    "ཕྲ་མོའང་འབད་པས་སྲོག་དང་བསྡོས་ནས་ཀྱང་།",
    "དེ་རྗེས་ཐུན་མོང་སྔོན་འགྲོའི་བློ་སྦྱོང་དང་།",
    "འབུམ་ལྔའི་བསགས་སྦྱང་ཚད་དུ་འཁྱོལ་བ་དང་།",
    "ལས་བཞི་མཆོག་གི་མཛད་སྤྱོད་རྩལ་དུ་ཐོན།",
    "ཀུན་ལ་བདུན་ཕྲག་རེ་རེའི་མ་མཐའ་ཡི།",
    "མོས་གུས་ཅན་ལ་དོན་བརྒྱུད་མངོན་སུམ་དུ།",
    "གསུང་གི་གསང་བ་བསམ་མི་ཁྱབ་པའི་ཚུལ།",
    "གསུང་གི་བདུད་རྩིས་རིང་དུ་བསྐྱངས་པའི་མཐུས།",
    "ཟང་ཐལ་མཚོན་བརྗོད་བྲལ་བ་རུ།",
    "དམ་པའི་ཞལ་ལུང་རང་གིས་ཕྱོགས་ཙམ་ཞིག།",
    "གོ་ཞིང་མྱོང་བ་ཕྲ་མོའི་གསལ་སྣང་ཙམ།",
    "འཚོ་བའི་འདུ་བྱེད་གཏང་བའི་མོད་ཉིད་ནས།",
    "ཐར་བའི་དུས་མེད་ཉམ་རེ་ཐག།",
    "སྤྲོས་པ་ཕྱོགས་རེ་བཀག་པ་ཙམ།",
    "དགག་སྒྲུབ་གང་གི་ཡུལ་མིན་པས།",
    "ཕལ་ཆེར་རེ་ཞིག་བརྟགས་པར་མཛོད།",
    "ཕྱོགས་རེར་གཞལ་བའི་གོ་དོན་ལ།",
    "བུ་དེ་ཕྱིར་འདོད་ཞེན་འཁྱོག་པོའི་བློ།",
    "སྦྱར་བའི་གཞུང་འགྲེལ་ཕལ་མོ་ཆེ།",
    "ཐོས་དོན་རང་གི་རྒྱུད་ལ་སྦྱོར།",
    "འཁྱོག་པོའི་གཞུང་ལ་བློ་གཏད་པའི།",
