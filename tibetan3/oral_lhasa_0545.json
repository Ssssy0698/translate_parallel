    "དེ་ཕྱིར་ཁྱིམ་བདག་གཞུག་པར་བྱའོ་གསུང་།",
    "གུར་གུམ་ཕུལ་སྟེ་ཡུལ་དེར་བསྐྲུན་པར་བྱས།",
    "དགྲ་བཅོམ་ལྔ་བརྒྱ་རྟག་དུ་བཞུགས་པ་ཡིན།",
    "གསུངས་པས་རབ་ཏུ་མ་བྱུང་ལོག་པར་གྱུར།",
    "ཁྱི་ཡང་བདག་དང་མཉམ་པར་བཀོད་པ་འདིས།",
    "ལྷ་ལུས་གཙང་ཞིང་དག་པའི་མགུལ་པ་འུ།",
    "ལྷ་གཞན་ཀུན་ལགསོལ་བ་བཏབ་གྱུར་ཀྱང་།",
    "དགྲ་བཅོམ་བྱིན་བརླབས་གཞིག་པར་མིནུས་ཀྱིས།",
    "བདུད་ཀྱིས་བར་དུ་གཅོད་པར་མི་ནུས་སྐད།",
    "མཆུ་ཞེང་དཔངས་ཐབས་གཞུ་འདོམ་ཉིའི་ཤུ་པར།",
    "དའ་བར་བྱས་པས་ལྟ་སྤྱོད་མ་མཐུན་སྟེ།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་ཡིན།",
    "འཇིག་རྟེན་འདས་པར་སྨྱོ་བ་ཡི།",
    "ཀུན་བཀྲིས་མཚུངས་པར་ལྡན་པ་ཡིན།",
    "གཉིས་པ་བཏགས་པར་སྨྲ་བ་རྣམས།",
    "དུས་མ་ཡིན་པར་འཆི་བ་མེད།",
    "ཤིང་ལོ་ཡིས་ནི་མཚན་པར་བྱེད།",
    "འདུས་བྱས་ཐམསཅད་མིང་གཟུགས་དང་།",
    "དུས་གསུམ་གྱིས་རྣམ་པར་བསྡུས།",
    "མི་ལྡན་པ་དང་འདུས་བྱས་རྣམས།",
    "ཤེས་བྱ་རྣམ་པར་ཤེས་བྱའང་ཡོན།",
    "འདུས་མ་བྱས་དངོས་དག་ཡིན་སྟེ།",
    "བདུན་པ་རྣམ་པར་ཕྱེ་ནས་ནི།",
    "སྒོ་ལྔའི་རྣམ་པར་ཤེས་པ་ཡིས།",
    "དེ་ལྟར་རྣམ་པ་བཅོ་བརྒྱད་བྱས་པའི་ཚེ།",
    "སླསཔས་བདག་ཉིད་གཅེས་ཕྱིར་ཁས་ལེན་བྱས།",
    "སྤྲེའུ་ཀུན་ལ་མི་གཙང་སྐུད་བྱེདཔ།",
    "རྣམ་པར་གྲོལ་བའི་ལས་ཀྱང་ཉམས་པ་མེད།",
    "དེ་ཡིས་བཟང་པ་ཡིན་པར་ཁས་བླངས་སོ།",
    "༣༣ སྤྲུལཔོ་ལ་ནི་སེམས་མེད་པར་གསུངས་ཕྱིར།",
    "ཞུག་པ་མེད་པའི་ཞིང་ན་རྟག་པར་གནས།",
    "འཇམ་དཔལགས་ནི་འཕགས་མཆོག་ཀླུ་སྒྲུབ་དང་།",
    "དབཞུགས་སུ་གསོལ་ཞེས་གསོལ་བཏབ་གནང་བ་ཐོབ།",
    "རྒྱལ་བའི་སྐུ་གཟུགས་མང་དུ་བྱས་པར་གསུངས།",
