    "དེ་ལྟར་དོན་བྱེད་པས་དངོས་པོ་དེའང་རང་བདེན་པ་ཡིན་ཅིང་།",
    "འོ་ན་རང་ལུགས་དང་རང་ཕྱོགས་ཅུང་ཟད་ཀྱང་མ་བཞག་བཞིན་གཞན་ཁོ་ན་སུན་འབྱིན་པ་ནི་དགོས་པ་མེད་དེ།",
    "ཁོ་བོས་བདག་སྐྱེ་ཡོད་པར་རང་ལུགས་ཚད་གྲུབ་ཏུ་འདོད་པ་དེ་དགག་པར་བྱ་བའི་ཆེད་དུ་སུན་འབྱིན་གྱི་བདག་སྐྱེ་མེད་ཅེས་སྨོས་ཀྱང་རང་༡༧ན་ལུགས་ཚད་གྲུབ་ཀྱི་བདག་སྐྱེ་མེད་པར་མ་བཞག་པའི་ཕྱིར།",
    "འདིར་ནི་རྩོད་པའི་ཆེད་དུ་ངག་ཀྱང་རང་ལུགས་ཀྱི་དེར་གྲུབ་པ་ཞིག་འགོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་སྒྲུབ་པའི་ངག་འགོད་ཀྱང་རང་བཞིན་མེད་པར་སྒྲུབ་པའི་སྒྲུབ་ངག་འགོད་པ་ནི་གཏན་མིན་ཏེ།",
    "རྩོད་པ་བཟློག་པའི་འགྲེལ་པ་མཛད་པ་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་ཀྱང་རང་རྒྱུད་ཀྱི་སྦྱོར་བའི་ངག་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་དངོས་སུ་བྲིས་གདའ་བས་དེའི་ཤུགས་ལ་ལྟ་བས་ཡེ་ཤེས་ཚོགས་སོག་ལ་འཇུག་པ་ན།",
    "རང་ལུགས་ཀྱི་ཕྱོགས་གང་ཡང་མི་འཛིན་པའི་སྐབས་སུ་ལེགས་ལྡན་བྱེད་སྒྲུབ་བྱེད་ཐ་སྙད་དུའང་རང་བདེན་པའམ་རང་རྒྱུད་དེ་ལྟར་སྦྱོར་བར་བྱེད་དོ།",
    "ཁྱེད་རང་ཉན་ཐོས་པ་ལ་དོན་དམ་གཏན་ཚིགས་སུ་བྱེད་ན་མ་གྲུབ་པའི་དོན་ཉིད་དང་།",
    "ཡང་ས་མྱུག་དུས་མཉམ་དུ་མེད་དོ་ཞེས་པ་དེ་མི་རིགས་ཏེ།",
    "ས་མྱུག་དུས་མཉམ་གཞན་དུ་གྲུབ་སྟེ།",
    "དཔེ་སྲང་མདའི་མཐོ་དམན་དུས་གཅིག་ཅར་གྱི་ཚེ་བྱེད་པ་ཡིན་ན་ཡང་འདིར་དོན་རྒྱུ་འབྲས་ཀྱི་སྐྱེ་འགག་དུས་གཅིག་པ་མེད་པའི་ཕྱིར་དཔེ་དེས་དོན་དེ་ཡོད་༡༣༥ན་ཅེས་ལན་འདེབས་བྱེད་པ་ནི་བཟང་པོ་མ་ཡིན་ནོ།",
    "དོན་རྒྱུ་འབྲས་ཀྱི་སྐྱེ་འགག་དུས་གཅིག་པ་ཡོད་པ་མིན་ཅིང་ཞེས་དུས་མཉམ་ཡོད་པ་མིན་ཏེ།",
    "ཁོ་ཁོ་རང་མ་ཡིན་པར་འགྱུར་ལ།",
    "འཁོར་འདས་གཉིས་སུ་མེད་པར་འདུག།",
    "སྣང་སེམས་གཉིས་སུ་མེད་པར་འདུག།",
    "རང་གསལ་ཅིང་ཡང་སྣང་ཞིང་གདའ།",
    "དེ་ཡང་དངོས་སྨྲ་བའི་དོན་དམ་གྱི་མཚན་གཞི་འདིར་ཀུན་རྫོབ་ཏུ་འགྱུར་བ་ཡང་རང་རྒྱུད་ཀྱི་གཞུང་ལས།",
    "སྔོན་པོ་སོགས་ནི་བདེན་པར་སྣང་ཞིང་རང་བཞིན་སྟོང་པ་ཉིད་ནི་དེ་ལ་སྒྲིབ་བྲལ་དུ་མི་སྣང་བས་དོན་དམ་པའི་རང་བཞིན་དང་ལོག་པའི་ཀུན་རྫོབ་ནི་ཀུན་རྫོབ་བདེན་པ་མིན་ཅིང་།",
    "དེར་ཡོད་པས་ཡོད་པར་མ་གྲུབ་ཅིང་རང་ལུགས་ལ་ཡོད་པར་བཞག་མ་ཐུབ་པ་ལ་དོན་དམ་པར་མེད་ཅེས་མིང་དུ་གདགས་པའི་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་ནི་མེད་པར་དགག་ཙམ་ལས་དེ་ལ་རིགས་པས་དཔྱད་བཟོད་པར་གྱུར་ནས་སླར་ཡོད་པར་གྲུབ་སྟེ།",
    "དགོས་ནའང་ཁྱེད་རང་ལ་ནང་འགལ་དུ་འགྱུར་རོ་ཞེས་སྐྱོན་རྒྱས་པར་བརྗོད་ཟིན་པའི་ཕྱིར་མི་འཐད་ལ།",
    "ཡོད་པར་སྣང་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པའི་ཕྱིར།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "འཇིག་པའི་འགགས་པ་དངོས་པོ་བ་ལ་དེ་ལྟའི་ཚེ་སྐྱེ་འགག་དུས་མཉམ་གྲུབ་ཏུ་ཆུག་ཀྱང་ཞིག་པའི་འགགས་པ་དངོས་མེད་ལ་དུས་མཉམ་མི་རུང་སྟེ།",
    "འཇིག་པ་ལ་འཇིག་རྒྱུ་དོན་གཞན་མེད་ཀྱང་རང་ཉིད་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ལས་འཇིག་བྱེད་ཀྱི་རྒྱུར་ཡང་བལྟོས་མེད་དུ་གྲུབ་བོ་ཞེས།",
    "དཔྱད་ན་སྐྱེ་འགག་དུས་མཉམ་ལ་སྐྱེ་བ་མི་འགྲུབ་སྟེ།",
    "འགགས་ཞིག་དུས་ཀྱིས་མ་བསྡུས་པའི་ཕྱིར།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "འདིའང་རང་ལུགས་ལ་སྒྲུབ་པ་ནི་མ་ཡིན་གྱི།",
    "རྣག་འབབ་པའི་ཀླུང་སོགས་དངོས་པོ་གསར་སྐྱེ་འགྲོ་བ་ཕན་ཚུན་ལ་སྒྲིབ་ཀྱང་འགྲོ་བ་རང་རང་ལ་མི་སྒྲིབ་པར་དོན་བྱེད་པ་ཅན་གྱི་དངོས་པོ་རང་བདེན་པར་ཡོད་ཅེས་སྨྲ་དགོས་པར་འགྱུར་ན།",
    "དགོངས་འགྲེལ་གྱི་བསྟན་བཅོས་བརྩམས་པ་ཐམས་ཅད་མིའི་རྟེན་ལ་མཛད་ཅེས་ཐག་ཆོད་ཆེན་པོ་ཞིག་བྱས་འདུག་པ།",
    "གཞན་གྱིས་གཞན་འཛིན་པ་མེད་ཀྱང་རང་རིག་པ་ནི་ཡོད་དེ།",
    "ཡང་རང་རིག་མེད་ན་དེ་ཉིད་ཀྱིས་དེ་མ་མྱོང་བར་ཡང་འགྱུར་བ་དང་།",
    "དོན་དམ་དུ་གྲུབ་པ་འགོག་པ་ཡིན་ན་ཀུན་གཞི་དང་རང་རིག་ལ་ཆེད་དུ་བཀར་ནས་འདི་ཙམ་གྱི་དགག་པ་བྱེད་མི་རིགས་པར་འགྱུར་ཏེ།",
    "དངོས་སྨྲ་བ་དང་རང་༢༣༣བ་རྒྱུད་པའི་བདེན་གཉིས་ཀྱི་འཇོག་ཚུལ་བཀག་ནས།",
    "རབ་རིབ་ཅན་གྱི་སྐྲ་ཤད་ཀྱི་བདེན་འཛིན་བཟློག་པའི་ཆེད་དུ་སྐྲ་ཤད་སྣང་ཡང་རང་བཞིན་མེད་དོ་ཞེས་སྨྲ་བ་ལྟར།",
    "ཀུན་རྫོབ་ཐ་སྙད་དུའང་རང་ལུགས་ཀྱི་ཡོད་མེད་གང་དུ་ཡང་ཁས་མ་བླངས་པའི་ཕྱིར།",
    "དངོས་འཛིན་གྱི་འགལ་འདུ་ཅིར་ཡང་གདའོ།",
    "དེ་ཚེ་འབྲས་བུ་མཐའ་༢༥༢བ་དག་དུས་རྟག་ཏུ་རྒྱུ་ཡིན་མིན་ཐམས་ཅད་ལས་ཀྱང་སྐྱེ་བར་འགྱུར་ཏེ།",
    "འཁོར་འདས་འཆིང་གྲོལ་གྱི་རྒྱུ་འབྲས་འདི་ཐམས་ཅད་ལ་ངོ་བོ་ཉིད་དང་རང་བཞིན་ཡོད་ན་དེ་ལྟར་དེ་བཅོས་མིན་དང་།",
    "ད་འཇིག་རྟེན་སྤྲོས་དང་བྲལ་ཙ་ན།",
    "དེས་ན་དངོས་པོ་འགལ་ཡང་རང་བཞིན་གྱིས་ཁས་མ་བླངས་ཏེ།",
    "དཔྱོད་བྱེད་དཔྱད་བྱ་ཉིད་ཀྱང་རང་བཞིན་གྱི།",
    "དེ་ལྟར་གསུངས་པ་སྐྱེས་བུ་དམ་པ་ཐམས་ཅད་ལ་མཐོང་ཐོས་ཙམ་ཡང་མི་འདུག་པའི་ཕྱིར་རོ།",
    "དངོས་པོའི་འཇིག་ཞིག་ཐམས་ཅད་དངོས་པོ་ཡིན་པར་ཁྱེད་རང་འདོད་ཅིང་ཞིག་དངོས་ལས་འབྲས་ཀྱི་རྟེན་གྱི་གང་ཟག་ཡིན་པར་རིགས་ན་འཇིག་དངོས་དེ་ཡིན་པ་ལའང་གནོད་བྱེད་མེད་ཅིང་སྒྲུབ་བྱེད་མཚུངས་པའི་ཕྱིར།",
    "སློབ་དཔོན་ཆེན་པོ་ཟླ་བ་གྲགས་པས་འཇུག་པ་རྩ་འགྲེལ་འདིར་རྒྱས་པར་བཀག་གདའ་བས་ཐར་འདོད་རྣམས་ལེགས་པར་སོམས་ལ་མིག་མེད་གཡང་ས་ཆེན་པོ་ལ་གོམ་པ་འདོར་བའི་རྗེས་སུ་མིག་ལྡན་དག་བག་གཟོབས་ཤིག་གངས་ཅན་གྱི་ཁྲོད་འདིར་བདག་ཐ་སྙད་དུ་ཡང་མེད་ཅིང་།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "དེས་ན་ཁོ་བོ་ཅག་སུན་འབྱིན་དབྱུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་ཁས་མ་བླངས་པས་རང་ཚིག་ལ་འགལ་བ་མེད་ཅིང་།",
    "སྐྱེད་པར་བྱེད་པའི་རྒྱུ་༣༡༤ན་འབྲས་ལ་རང་བཞིན་ཡོད་པར་རྟོག་ནས་དཔྱད་རིགས་པ་ལྟར་གསལ་བྱེད་ཀྱི་རྒྱུ་འབྲས་ལའང་རང་བཞིན་ཡོད་པར་རྟོག་ནས་དཔྱད་རིགས་པར་མཚུངས་པ་དེ་ཉིད་འཇུག་པའི་གླགས་ཡོད་པའི་ཕྱིར་ཏེ།",
    "སུན་འབྱིན་དབྱུང་རང་བདེན་པ་ཞིག་རང་ལུགས་ལ་ཁས་བླངས་ནས་ལན་དེ་ལྟར་བརྗོད་ན་ད་དུང་ལྟག་ཆོད་ཀྱི་མཚུངས་པ་སྤང་མི་ནུས་པའི་ཕྱིར་ཁྱེད་ཀྱི་ལན་དུ་བྱ་བའི་རྩོད་སྤོང་དེ་མི་རིགས་པ་ཉིད་དོ།",
    "ཐ་སྙད་པར་ཡང་རང་ལུགས་སུ་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་གང་བཞག་པ་དེ་ཉིད་ཀྱི་སྤྲོས་པ་ཉེ་བར་མ་ཞི་བའི་ཕྱིར།",
    "རང་བཞིན་གྱིས་གྲུབ་པའི་རང་བཞིན་ནི་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་དུ་མི་རུང་ངོ།",
    "དེ་ལྟར་བརྗོད་པའི་རང་བཞིན་དེར་རང་བཞིན་དུ་མ་གྲུབ་ཀྱང་རང་བཞིན་དུ་སྒྲོ་བཏགས་ནས་གཞན་བྱིས་པས་བཏགས་པའི་རང་བཞིན་དེ་བཟློག་པའི་དགོས་པའི་ཆེད་དུ་ཀུན་རྫོབ་ཐ་སྙད་དུའང་རང་བཞིན་དེ་ལྟ་༣༢༣ན་བུའི་ཞེས་སྒྲོ་བཏགས་ནས་དགོངས་པ་ཅན་དུ་བརྗོད་པ་ཡིན་ཏེ།",
    "ཐ་སྙད་དུའང་རང་ལུགས་ཀྱིས་གྲུབ་པའི་རང་བཞིན་དང་།",
    "ཤེས་བྱ་དངོས་པོ་རང་རང་ལ་བདག་བདེན་ཡོད་པ་དེ་རྟགས་ཀྱི་དགག་བྱའི་བདག་ཤེས་བྱ་རང་རང་ལ་ཡོད་པ་དེ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཀུན་རྫོབ་ཐ་སྙད་ཚད་གྲུབ་རང་རང་ངོ་བོས་མི་སྟོང་ཞིང་།",
    "རང་རང་རིས་མཐུན་ཕྱོགས་བཅུར་རྒྱས་པ་ལ།",
    "ཀུན་རྫོབ་བདེན་པར་རང་རང་ངོ་བོས་སྟོང་པས་རང་སྟོང་དང་།",
    "རྣམ་རྫུན་པས་ཀྱང་རང་ལུགས་སུ་རང་སྟོང་ཁས་མི་ལེན་ཅིང་།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
    "ཡེ་ཤེས་ཡོད་མེད་གང་ལའང་རང་ཉིད་ཞེ་འདོད་མེད་པའི་ཕྱིར་དང་།",
    "རང་སེམས་མངོན་དུ་གྱུར་ཙ་ན།",
    "གྲངས་མེད་གསུམ་ཡང་བརྫུན་པར་གདའ།",
    "ཀྭ་བློ་གཏད་འདུག་གམ་མི་འདུག་སོམས།",
    "འཕགས་པའི་མཉམ་གཞག་ཡེ་ཤེས་ཀྱི་ངོ་ན་ནི་བལྟོས་ནས་དང་བརྟེན་ནས་འབྱུང་མི་འབྱུང་དང་རང་བཞིན་གྱིས་ཡོད་མེད་དང་།",
    "དེ་ལྟར་འཇིག་རྟེན་གཞན་གྲགས་ཀྱིས་བརྗོད་ཀྱིན་༣༦༧ན་འདུག་པ་ལས།",
    "འོ་ན་བརྗོད་བྲལ་ལའང་འཇིག་རྟེན་པ་ཐམས་ཅད་བརྗོད་ཀྱིན་འདུག་པ་ཇི་ལྟར་ངས་ཤེས་སུ་ཡོད།",
    "རྒྱུན་མེད་པར་འདོད་ན་རྒྱུན་དེ་གཅོད་བྱེད་ཀྱི་གཉེན་པོའི་ཡེ་ཤེས་དེ་ཁོ་རང་ཡིན་ནམ་གཞན་ཞིག་ཡིན་ཅེས་དཔྱོད་པ་དང་།",
    "དགོངས་གཅིག་ལེའུ་དང་པོ་ལ་གཞན་འགྲེལ་དུ་བྱས་པ་དང་རང་རྐང་དུ་འགྲེལ་བ་གཉིས་ལས།",
    "ཞེས་བྲིས་གདའ་བ་དེ་ལྟར་ན་ཁྱེད་དཔོན་སློབ་ལ་འདིར་འགྱུར་ཏེ།",
    "ཁྱེད་འདོད་པའི་རྟགས་ཀྱི་དགག་བྱ་སྟོང་གཞིར་བཟུང་ནས་དེ་རང་རང་ངོ་བོས་སྟོང་པར་གཏན་ལ་དབབ་རིགས་པ་ལས་དེ་ལྟར་གསུངས་པ་མེད་ཅིང་།",
    "འདུག་མིན་འཕགས་ཡུལ་ས་ལའང་སྣང་བྱེད་དུ།",
    "རྟ་མི་གཡོ་བར་འདུག་གོ།",
    "རྣལ་དུ་འདུག་པ་ན་དེ་ལ་སྒ་བསྟད་དོ།",
    "ད་ནིང་ཅིའི་ཕྱིར་ཁྱིམ་དུ་འདུག་འདི་ནི་ངེས་ཏེ་དཀའ་ཐུབ་ཀྱི་ཚལ་དུ་འགྲོའོ།",
    "དེར་དྲང་སྲོང་དེ་དག་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ལས།",
    "གཅིག་པུར་འཁྱམས་ཤིང་འདུག་གོ་ཞེས་ཐོས་ནས།",
    "སྲབ་འཐུག་མེད་པར་གཡས་ཕྱོགས་སུ་འཁྱིལ་ཏེ་འདུག་གོ།",
    "གོས་དང་བྲལ་ཞིང་སྐྲ་གྲོལ་བ་སོགས་འདུག་ཚུལ་སྣ་ཚོགས་པ་མཐོང་བས་དུང་ཁྲོད་ཀྱི་འདུ་ཤེས་སྐྱེས་ནས་བདག་ནི་གཙེས་སོ།",
    "དེ་ནས་རིགས་ཀྱི་གཙོ་བོ་དགའ་སྟེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ང་མེ་ཁང་འདིར་ཞག་གཅིག་ཏུ་འདུག་གོ།",
    "སྟན་ལ་འདུག་ཅིག།",
    "ཅིང་འདུག་གོ།",
    "བཞི་པ་ནི་རི་བོ་གཏུམ་ལྡན་ནས་གླང་པོ་ཆེ་གཞོན་ནུ་མིཞིག་བཟུང་འདུག་པས།",
    "ན་དེ་གཅེར་བུ་པའི་གདོང་དུ་ལྟ་ཞིང་འདུག་པ་ལ།",
    "མ་ལནམ་མ་ལངས་ཏེ་མུན་པར་འདུག་གོ།",
    "སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ལ།",
    "ལམ་མེར་འདུག་པ་སྟེ།",
    "ནནམཉན་ཐོས་དང་རང་རྒྱལ་དུ་སེམས་བསྐྱེད་པ་དང་།",
    "སྟན་བཤམས་པ་ལ་འདུག་གོ།",
    "ཁྱེད་ཅག་ཐམས་ཅད་རབ་ཏུ་འབྱུང་ན་བདག་ཅི་སྟེ་འདུག་ཅེས་སྨྲས་སོ།",
    "སྣམ་ལོགས་སུ་བསིལ་ཡབ་གཡོབ་ཅིང་འདུག་གོ།",
    "དེ་ཟ་ཞིང་འདུག་པའི་ཆ་བཀའ་སྩལ་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གཅུང་པོ་དགའ་བོ་ཞེས་བྱ་བ་ཞིག་ཡོད་པར་འདུག་སྟེ།",
    "འབྱོར་ལེན་ཅི་བདེར་འདུག་པ་ལ་གཞན་རྣམས་ཀྱིས་རྒྱུ་དྲིས་པས།",
    "འབྱོར་ལེན་སྤུན་དང་བཅས་པའི་སྐྱེ་བོའི་ཚོགས་མང་པོ་དང་བཅས་པ་ལྷན་ཅིག་འདུག་གོདེར་ན་ནམ་ལངས་མ་ཐོག་ནས་དགེ་སློང་ལོ་མ་དང་སྣོད་སྤྱད་འབྲིམ་པ་དང་།",
    "ནེ་སིང་ནི་རློག་འདུག་གནས་རྣམས་སྡིབ་བོ།",
    "འདུག་པ་དང་ཉལ་བདག་ཀྱང་ཕན་ཚུན་སྨྲ་སྟེ།",
    "ཞལ་དང་ཕྱག་སྣ་ཚོགས་པར་འདུག་པ་ཤིན་ཏུ་འཇིགས་སུ་རུང་བར་མཐོང་སྟེ།",
    "མིང་པོའི་འདུ་ཤེས་ཀྱིས་འདུག་ཅིག་སྔོ་སངས་མ་ཡང་འདོད་པ་ལ་ཆགས་པ་ཤས་ཆུང་བས།",
