    "གཏམ་འདི་ཡང་རང་གཞན་ལ་ཕན་པའི།",
    "རྒྱུ་ཟང་ཟིང་འར་འུར་མཐོང་ཙ་ན།",
    "བསམ་གཞིག་བཏང་ཚེ་ཁ་ཞེ་འགལ་ནས་གདའ།",
    "མི་ང་རང་ཡང་དབེན་པའི་གནས་ལ་སྨོན།",
    "དབྱར་སོགས་དུས་ཀྱི་དགའ་སྟོན་རྒྱས་འདུག།",
    "མེ་ཏོག་ཐམས་ཅད་འཛུམ་འཛུམ་རྒོད་འདུག།",
    "བྱ་ཚོགས་སྐད་སྙན་དལ་བུར་སྒྲོགས་འདུག།",
    "ས་དེ་ཡང་གནས་ཚུལ་དེ་ལྟར་གདའ།",
    "ཧ་ཅང་རང་མང་ན་སུན་ཏེ་སྐྱུར།",
    "སྐུ་རིམ་གྱི་རྒྱབ་རྟེན་ཆེ་ཙ་ན།",
    "ལོ་ལོན་ཅིང་རྒས་པ་གསུམ་འཛོམ་འདུག།",
    "སེམས་བཞག་ན་མི་འདུག་དུང་དུང་རྒྱུག།",
    "སྡུག་བསྔལ་མྱོང་དགོས་འདི་ཞེད་པོར་གདའ།",
    "དམ་ཚིག་སྡོམ་པ་འདི་ལམ་གྱི་རྩ་བར་འདུག།",
    "ད་ལྟར་ནི་བདེ་བས་ཕོངས་ནས་གདའ།",
    "བདེ་བ་སྤུ་ཙམ་ཡང་མི་འདུག་པས།",
    "ཕ་ཁྱེད་རང་མཁྱེན་སྙམ་བློ་རྩེ་གཏད།",
    "ཕ་ཁྱེད་རང་གཅིག་པུ་མཁྱེན་སྙམ་ནས།",
    "ཕྱོགས་གར་ཡང་འབྲོས་ས་མི་འདུག་ན།",
    "བསམས་ན་སྡུག་བསྔལ་ཁོ་ནར་འདུག་ཀྱང་།",
    "དོན་ལ་སྣང་ཚུལ་ལྟར་དུ་མི་འདུག།",
    "བཀའ་དྲིན་བསམས་ན་འཁོར་ཐབས་མི་འདུག།",
    "ཞེས་པ་འདི་ཡང་སྐལ་ལྡན་རྒྱ་མཚོས་བདེ་བའི་གདན་སྟེང་ན་ལུས་འབོལ་ལེ་ཉལ་ནས་འདི་སྐད་ཟེར་ཞིང་འདུག་གོ།",
    "རང་གཞན་མགོ་སྐོར་གྱི་ཐབས་སུ་འདུག་གོ།",
    "ཐག་རིང་འགྲོ་འདུག་འདི་མ་ནུས།",
    "ཡི་གེ་འདིས་ཀྱང་རང་གཞན་ལ་ཕན་ཞིང་།",
    "གཉེན་མང་ཡང་དགྲ་བོར་འདུག་གོ་བསམ།",
    "བསྐྱོད་ནས་གང་བརྩན་གནས་སུ་འཕུར་བ་ནི་རན་འདུག།",
    "གཅིག་པུར་བསྡད་དེ་དགེ་སྦྱོར་བསྐྱངས་ན་རང་སྐྱིད་མིས་སྨོན་རྒྱུ་རུ་འདུག་གོ།",
    "ལུས་འདུག་ཚེ་ཤེད་ཀྱི་ས་ལ་རྡེག།",
    "ཁ་ཁ་རོག་འདུག་དང་བདེ་བ་འཐོབ།",
    "ཡར་ངོའི་ཟླ་བཟང་འཕེལ་འདུག།",
    "ལུས་ལ་བློ་གཏད་མི་འདུག།",
    "ལུས་སྲོང་བའི་དྲང་སྲོང་འདུག་ཚུལ་དང་།",
    "ང་རྒད་པོ་གཉོམ་ཆུང་གཅིག་པུར་འདུག།",
    "བསྙེན་བཀུར་འདོད་པའི་བསམ་པ་འདུག།",
    "འཆི་བདག་བསུ་མ་སླེབ་ཙ་ན།",
    "ལར་རྒས་རྟགས་ཀྱི་མཚན་མ་བྱུང་ཙ་ན།",
    "སྤྱོད་པ་ལ་གུ་ཡངས་ཀྱི་ཞད་ཅིག་འདུག།",
    "འཕྲལ་མཐུན་རྐྱེན་ཕྱོགས་ལ་ང་རང་ཤེས།",
    "ད་བསམས་ན་གདམས་པའི་མཐིལ་དུ་འདུག།",
    "དགྲ་འཆི་བདག་ནམ་འོང་ཆ་མི་འདུག།",
    "ཉིན་གཅིག་ཞྭ་སེར་ལེགས་པ་ཞིག་བཞེས་ནས་ཕེབས་ཏེ་ཞྭ་སེར་དེ་བདག་ལ་གནང་བྱུང་བའི་དེ་ཡང་དགོངས་གཞི་ཅན་དུ་འདུག་དེ་ནས་རྗེ་སྐལ་ལྡན་རས་པའི་གསུང་མགུར་གྱི་པོ་ཏི་ཁ་ཕྱེ་སྟེ་གདངས་དང་བཅས་ནས།",
    "སྐུ་བསྙེལ་འདུག་གསུང་བ་ལས་ཐུགས་དམ་ལ་གཡོ་བ་ཅུང་ཟད་ཀྱང་མེད་པར་ཏིང་ངེ་འཛིན་ལ་རྩེ་གཅིག་ཏུ་གཞོལ་བར་མཛད།",
    "ཁ་ཟས་བསྟེན་པ་དང་ཁྱད་པར་འདུག་གམ་སོམས།",
    "ཡིད་མི་བདེ་མ་མཆིས་བདེ་བར་གདའ།",
    "ན་མ་ཨཱརྱ་ཛྙཱ་ན་སཱ་ག་ར་བེ་རོ་ཙ་ན་བྷཱུ་ཧ་རཱ་ཛ་ཡ།",
    "རང་རང་ཅི་ལྟར་འདོད་པར་ལོངས་སྤྱད་ནས།",
    "དགྱེས་པར་རོལ་ལ་རང་རང་གནས་སུ་དེངས།",
    "ཚུལ་ཅིར་སྣང་རང་གྲོལ་ངང་དུ་ཞོག།",
    "སེམས་གཤིས་ཀྱི་འདུག་ཚུལ་མཚང་རིག་ཀྱང་།"
  ]
}