    "འོད་དེས་རེག་པ་ཙམ་གྱིས་འཕེལ་རྒྱས་བསམ།",
    "རང་གི་ཐུགས་ཀར་སྔགས་ཕྲེང་མཐིང་ནག་ནི།",
    "རང་དང་བསྲུང་བྱ་ལ་གནོད་དགྲ་དང་བགེགས་། འགྲོ་བ་ཀུན་གྱི་བདུད་བཞི་ཉོན་མོངས་ཚོགས།",
    "རང་གི་ཡི་དམ་ལྷ་ཡི་སྔགས་མཇུག་ཏུ།",
    "དགོང་ང་མོ་སརྦ་སིདྡྷི་ཝ་ཤཾ་ཀུ་རུ་ཧོ",
    "མང་ཉུང་ཚད་ནི་གོང་དུ་བསྙེན་སྒྲུབ་ནི་། ཇི་ཙམ་སོང་བའི་དུས་སམ་གྲངས་ཉིད་ཀྱི།",
    "དཔེར་ན་བསྙེན་པ་འབུམ་ཕྲག་གཅིག་གོང་དུ་སོང་ན་ལས་སྦྱོར་ཤམ་བུ་ཁྲི་ཚོ་གཅིག་ཡིན་ཏེ་དེས་རིགས་འགྲེ་ཞེས་གསུངས་མཆན།",
    "ཟླ་དྲུག་ཟླ་གསུམ་ཟླ་གཅིག་ཞག་ཉེར་གཅིག་ཞག་བདུན་ཡན་ཆད་རང་གིས་གང་ལྕོགས་བྱ།",
    "གལ་ཏེ་སྦྱིན་སྲེག་རང་གིས་མ་ཤེས་ན།",
    "ངག་གིས་སྦྱིན་སྲེག་འདོན་ཅིང་ཡིད་ཀྱིས་བསྒོམ།",
    "སྒྱུ་ལུས་བྲོ་འཚལ་ཞག་འགའ་ལུས་པ་ལ་། བཅུ་དགུའི་ནུབ་མོར་སྨྲས་ན་ལེགས་པ་ཡི།",
    "ན་མོ་གུ་རུ་ཤྲཱི་ཧེ་རུ་ཀ་ཡེ།",
    "སྒྲུབ་ཡུན་ཐུང་ན་ཆང་གིས་རུང་བ་ཡིན།",
    "ཟུར་གཉིས་འབྲི་མོག་ཟུར་གསུམ་དྲག་སྣུམ་བྱུག་དཀྱིལ་འཁོར་ཤར་ལྷོ་ནུབ་བྱང་ཕྱོགས་བཞིར་བཀོད།",
    "བྱང་དུ་ལྷ་བཤོས་བྱང་ཤར་རོལ་མོའི་སར།",
    "སྟག་གི་སྒབ་སྐོར་ཕུར་ཆུང་བཅུ་གཉིས་དང་།",
    "རྙིང་མའི་སྒྲུབ་ཆེན་ཆས་ནི་ཡིན་མོད་ཀྱི།",
    "རྨོངས་ཕྱིར་མ་ཡིན་གཞན་ལ་ཕན་ཕྱིར་བྲིས། ། ན་མོ་གུ་རུ་སརྦ་དེ་བ་ཡེ།",
    "ཐུན་བཞིར་བདག་མདུན་གཉིས་ཀ་ཚར་རེ་འདོན།",
    "ཐུན་མཚམས་རང་གཞུང་གཏོར་བསྔོས་ཚར་རེ་བྱ།",
    "ཉི་མའི་གུང་ལ་སྦྱིན་སྲེག་རེ་རེ་སྟེ།",
    "ནུབ་མོ་ཚོགས་འཁོར་རྒྱས་པ་རེ་རེ་འམ།",
    "ཅི་འབྱོར་བློ་སྟོབས་བསྐྱེད་པའི་ཚོགས་རེ་བྱ།",
    "རང་གི་ཡི་དམ་སྐུ་དང་སྔགས་ཕྲེང་དང་།",
    "རང་གི་ཞལ་ནས་ཕར་ལ་འཕྲོ་བའི་དུས།",
    "དེ་བཞིན་དགོང་མོ་ནས་བཟུང་སྔགས་ཕྲེང་དམར།",
    "འཁྱོག་ཅིང་འགུག་པ་ལྕགས་སྒྲོག་དབྱིབས་ཅན་དེ།",
    "རང་གི་ཐུགས་ཀའི་སྔགས་ཕྲེང་ལ་ཐིམ་པས།",
    "རང་གི་དཔྲལ་མགྲིན་ཐུགས་ཀ་ལྟེ་བར་ཐིམ།",
    "མོས་གུས་བསྐྱེད་ཅིང་རང་གི་གནས་བཞིར་གཏུགས་། དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་ངེས་ཤེས་བསྐྱེད།",
    "རང་གིས་གསང་སྔགས་ཉམས་སུ་བླང་ཚུལ་དང་།",
    "ན་མོ་གུ་རུ་ཌཱ་ཀི་ནཱི་སིདྡྷི་ཧཱུཾ།",
    "གསང་སྔགས་ཀུན་གྱི་བདག་མོ་རྣལ་འབྱོར་མ།",
    "རྩ་གསུམ་འཁོར་ལོ་ལྔ་པོ་མོས་ཙམ་བསྒོམ།",
    "རང་གི་ཡི་དམ་གང་ཡིན་དེ་ཉིད་ནི།",
    "སྤྱི་བོར་དཀར་མོ་སུམ་ཅུ་རྩ་གཉིས་ཏེ།",
    "གསང་བར་ལྗང་མོ་ཉི་ཤུ་རྩ་བརྒྱད་དེ།",
    "ཕོ་ལ་གཡས་དང་མོ་ལ་གཡོན་དུ་འཁོར།",
    "འོད་ཟེར་ཞལ་ནས་ཐོན་ཏེ་གྱེན་དུ་སོང་།",
    "འོད་ཟེར་ཞལ་ནས་ཐོན་ཏེ་ཐུར་དུ་སོང་།",
    "རང་ཉིད་བདག་བསྐྱེད་ཞལ་ནས་ཕར་སོང་སྟེ།",
    "གྱེན་དུ་སོང་ནས་སྤྱི་བོའི་ལྷ་དཀར་པོའི།",
    "རང་གི་ཡི་དམ་དེ་ཡི་སྐུ་གཟུགས་ནི།",
    "ཡི་དམ་སྔགས་ཕྲེང་དཀར་སེར་དམར་ལྗང་ཚོགས།",
    "དགོང་མོའི་དུས་སུ་སྔགས་ཕྲེང་དམར་པོར་བསྒྱུར།",
    "ཟླ་གཅིག་ལ་སོགས་རང་གི་ཁམས་དང་བསྟུན།",
    "རཱ་ག་ཨ་སྱས་རང་རང་གི་མྱོང་བ་དང་།",
    "ན་མོ་གུ་རུ་པྲ་ཝ་ཀཱ་ར་ཡེ།",
    "བསྡུས་པ་ལ་ཡང་སྤྲོས་བཅས་སྤྲོས་མེད་གཉིས་། སྤྲོས་བཅས་མདུན་མེ་འབུད་སར་ཐབ་བརྩེག་གམ།",
    "བུད་ཤིང་ལས་བཞི་སོ་སོའི་དབྱིབས་ལྟར་བརྩེག་ཁ་ཁྱེར་ཀུ་ཤ་བཀོད་པ་ཀུན་ལ་དགོས།",
    "བདུན་ནམ་ཉེར་གཅིག་ཙམ་རེ་འབུལ་བས་ཆོག།",
    "བསྲེག་རྫས་མཆོད་བསྟོད་ཆ་རེ་གང་འགྲུབ་འབུལ།",
    "བ་མོར་ཉི་ཟེར་ཕོག་ལྟར་དག་གྱུར་ཏེ།",
    "དགྲ་བགེགས་དངོས་ཉིད་རྐང་རྟིང་སྐྱ་ལྷག་ལྷག་མགོ་མཇུག་ལོག་སྟེ་ཞལ་དུ་སོང་བར་བསམ།",
    "རང་ཉིད་ཡི་དམ་བདག་བསྐྱེད་སྔོན་སོང་ནས།",
    "དངོས་བཤམས་མེད་ནའང་སྔགས་དང་ཚིག་གིས་ཆོག།",
    "གཏོར་མ་བསྔོས་ཕུལ་འདོད་དོན་གསོལ་བ་ང་བསོང་བ།",
    "ཆོ་ག་བསྡུས་པའི་གསུང་རམ་ཁྱོག་པ་ཡི།",
    "སྦྱིན་སྲེག་རེ་རེར་སྔགས་གྲངས་བརྒྱ་རྩ་རེ།",
    "ཆོ་ག་ཚང་མའི་རམ་བུ་མི་ཁྱོག་ཀྱང་།",
    "སྔགས་དེའི་རྗེས་ཟློས་རམ་བུ་ཁྱོག་ཚད་བརྩི།",
    "དེ་ནང་ཕུལ་དམིགས་སྔགས་རེ་ཏིལ་འབྲུ་རེ།",
    "ཆང་གི་གླུམ་དང་འབྲི་མོག་སིནྡྷུ་ར།",
    "ཞལ་དང་སྐུ་ལུས་མེ་ཡི་རང་བཞིན་ཅན་། ཡུངས་འབྲུ་རེ་རེ་དགྲ་བགེགས་དངོས་བསམ་སྟེ།",
    "རྐང་མཐིལ་སྐྱ་དང་ལྷག་ལྷག་ཞལ་དུ་སོང་།",
    "འབྲུ་རེ་སྔགས་རེ་སྤྲད་ལ་བརྒྱ་རྩ་འབུལ།",
    "གཞན་ལ་སྤེལ་ཕངས་བརྩོན་འགྲུས་ཁྱོད་ལ་གདམས།",
    "ན་མོ་གུ་རུ་དེ་ཝ་ཌཱཀི་ནི་ཡེ།",
    "བདེ་དགྱེས་གསང་གསུམ་ཕག་མོ་སེང་གདོང་མ་། རྒྱལ་བ་རྒྱ་མཚོ་ལ་སོགས་གང་ཡང་རུང་།",
    "སྣེ་མོ་སྣ་བུག་གཉིས་སུ་ཡོད་པར་བསམ།",
    "རྩེ་མོ་ཡར་ལ་གུག་པ་ཨེ་ཡིག་མཚོན།",
    "མ་ཐུབ་གྲུ་མོ་གཡས་གཡོན་མཆན་བརྡབ་བྱ།",
    "མགྱོགས་པར་ལག་གཡས་པུས་མོ་གཡས་དང་གཡོན།",
    "དཔྲལ་བར་རེག་ཅིང་སེ་གོལ་གཅིག་བརྡབ་སྟེ།",
    "གཏུམ་མོ་བསྒོམ་ཡང་དྲོད་སོགས་སྐྱེ་བ་ཡིན།",
    "གཏུམ་མོའི་རང་གནས་ལྟེ་འོག་སོར་བཞིའི་ཐད།",
    "སུམ་འཁྱོགས་དམར་པོ་ཨ་ཡིག་འཕྲེད་བསྟན་དབྱིབས།",
    "ལྟེ་འོག་བསྒོམ་ན་རེ་ཞིག་ཕྱིར་ལ་འབར།",
    "ངན་སོང་གསུམ་དང་ལྷ་དང་ལྷ་མིན་གཅིག་ཏུ་རྩི་བ་ཡིན་ཀྱང་འདིར་ལྷ་མི་གཉིས་གཅིག་ལ་བརྩི་༥ མཆན་། འོད་ཟེར་ལྔ་ཡི་ཚུལ་དུ་ཚུར་བསྡུས་ཏེ།",
    "རྩ་འདབ་རེ་ལ་ཌཱ་ཀི་ལྗང་མོ་རེ།",
    "དེ་ནས་གཏུམ་མོ་ཡར་ལ་སྤར་བ་ཡིས།",
    "རྩ་འདབ་གྲངས་ཀྱི་ཌཱཀི་སེར་མོ་རྣམས།",
    "གཏུམ་མོ་ཡར་འབར་མགྲིན་པའི་རྩ་འདབ་གང་།",
    "རྩ་འདབ་གྲངས་ཀྱི་ཌཱཀི་དམར་མོ་ནི།",
    "ཨོཾ་ཡིག་བསྲེགས་ནས་ཡི་དམ་དཀར་པོར་བསྒྱུར་། རྩ་འདབ་གྲངས་ཀྱི་ཌཱ་ཀི་དཀར་མོ་ནི།",
    "འཁོར་རྣམས་ཐམས་ཅད་གཙོ་བོར་ཞལ་གཟིགས་བསྒོམ།",
    "འཁོར་རྣམས་ཐུགས་ཀར་ཡིག་འབྲུ་རེ་རེ་སྟེ།",
    "དཀར་མོའི་ཐུགས་ཀར་ཧྲི་ཡིག་དཀར་པོ་དང་།",
    "སྔོན་མོའི་ཐུགས་ཀར་ཧ་ཡིག་སྔོན་པོ་དང་།",
    "སེར་མོའི་ཐུགས་ཀར་རཾ་ཡིག་སེར་པོ་དང་།",
    "དམར་མོའི་ཐུགས་ཀར་ནི་ཡིག་དམར་པོ་རེ།",
    "ལྗང་མོའི་ཐུགས་ཀར་ས་ཡིག་ལྗང་གུའོ།",
    "ཁྲིད་ལྟར་བྱེད་ན་རྩ་གནས་རེ་རེ་ལ།",
    "ལྷ་ཚོགས་ཐམས་ཅད་གཏུམ་མོའི་མེ་ཡིས་ཞུ།",
    "རྒྱུན་ཁྱེར་བྱེད་ན་ཐུན་རེ་སྒོམ་ཡང་རུང་།",
    "ཕྱིས་ནི་རྒྱུན་ཁྱེར་ཆག་མེད་ཐུན་རེ་སྟེ།",
    "རང་གི་དལ་ཁོམས་བསྟུན་ཏེ་གང་འདོད་རུང་།",
    "རང་གི་ཉམས་མྱོང་དང་བསྟུན་གོ་བདེ་བར།",
    "རྒྱ་གར་གྲུབ་ཆེན་ཐམས་ཅད་ཞལ་གཟིགས་ཏེ།",
    "མི་རེས་གདམས་ངག་སྣ་རེ་བྲི་བར་གཟིགས།",
    "འདི་ནི་ཟབ་མོའི་བསྐྱེད་རིམ་ཞེས་ཀྱང་བྱ།",
    "ཞག་རེའི་ནང་དུ་གཏོར་བསྔོས་རེ་བྱས་ཏེ།",
    "ན་མོ་མ་ཧཱ་གུ་རུ་ཌཱ་ཀི་ནཱི་ཡེ།",
    "རང་གི་སེམས་ཉིད་ཡེ་ཤེས་སེམས་དཔའ་སྟེ།",
    "དེ་སྐད་རྡོ་རྗེ་འཆང་གིས་བཀའ་སྩལ་པ།",
    "འོན་ཀྱང་གོང་གི་དེ་དག་ཀུན་དང་མཐུན།",
    "ཉོན་མོངས་ཐམས་ཅད་ཤུགས་ཀྱིས་འགག་པར་གསུངས།",
    "ལྟེ་འོག་གཏུམ་མོ་ཡེ་ཤེས་མེ་ཡིན་ཏེ།",
    "ཆ་ལུགས་རང་གི་ཡི་དམ་གང་ཡིན་བསྒོམ།",
    "སྐུ་ཡང་སྲིད་པའི་རྩེ་མོ་ཡར་བརྒལ་བ།",
    "བརྟེན་ནས་སྒྲུབ་པའི་མན་ངག་ཟབ་མོ་སྟེ།",
    "བདེ་མཆོག་ཕག་མོ་ལ་སོགས་སྒྲུབ་པའི་ཚེ།",
    "དེ་ཁོ་ན་ཉིད་སྒྲུབ་ཐབས་ཟབ་མོ་འདི།",
    "བདག་ཀྱང་ད་ནི་ན་སོ་སོང་བ་དང་།",
    "མཁས་ཤིང་ཆེན་པོར་རློམ་པ་འགའ་ཞིག་གིས།",
    "ཆ་ཚང་མི་འདུག་སྨྲ་བ་ཐོས་མོད་ཀྱི།",
    "ན་མོ་གུ་རུ་དྷེ་ཝ་ཌཱ་ཀི་ནཱི་སིདྡྷི་ཕ་ལ་ཧཱུཾ།",
    "ཉིན་ཕྱེད་མདུན་བསྐྱེད་དགོང་མོ་ཚོགས་གཏོར་བསྔོས་། རྙིང་མ་ཡིན་ཅིང་ལས་བྱང་ཉུང་ན་ནི།",
    "ཉིན་གུང་ནང་སྒྲུབ་ནང་གི་དམིགས་པ་བྱ།",
    "དགོང་མོ་གསང་སྒྲུབ་དམིགས་པ་ཅི་ལྕོགས་བྱ།",
    "དམིགས་པ་གསལ་གདབ་ཉམས་ལེན་ངང་ལ་བཞག་བདུན་དང་བཅུ་བཞི་ཉེར་གཅིག་ཞག་གི་ཚད།",
    "འདི་ནི་ཡི་དམ་མཆོག་གི་དྲིལ་སྒྲུབ་ཡིན།",
    "རྩ་བའི་དམིགས་པ་རེ་རེ་རེས་མོས་ཆོག།",
    "རྒྱ་གཞུང་སྒྲུབ་ཐབས་ཟབ་མོ་དུ་མའི་བཅུད།",
    "རང་གིས་ཡང་ཡང་ཉམས་བླངས་མྱོང་བས་སྦྱར།",
    "དམར་པོའི་ཚེས་དགུ་ལྷ་མོ་རྒྱུ་བའི་ཉིན།",
    "ན་མོ་གུ་རུ་ཛྙཱ་ན་ཌཱ་ཀི་ཡེ།",
    "གཏུམ་མོའི་ཁྲིད་རིམ་ཀུན་ལ་སྦྱར་རུང་བའི།",
    "བདག་གི་སྐྱབས་གནས་རྒྱལ་བ་འོད་དཔག་མེད།",
    "ཐལ་མོ་གསུམ་ཕུར་མགོ་བོ་དང་། རོ་སྟོད་རྒྱབ་མདུན་རོ་སྨད་འཕུར།",
    "པུས་མོ་གཡས་པར་འཇུས་ནས་ནི།",
    "རྩ་བ་འདི་ཡིས་ཆོག་པའི་ཕྱིར་། བདག་གི་འདྲེན་མཆོག་རྒྱལ་བ་ཡིས།",
    "འདི་ཡི་འབུད་པ་དགུ་སྤྲུག་དང་།",
    "ཐུན་རེ་ཐུན་གཉིས་ཡུད་རེས་ཀྱང་།",
    "སྒོམ་བཟླས་ཕན་ཡོན་ཡོད་མོད་ཀྱི།",
    "ན་མོ་གུ་རུ་དེ་ཝ་ཌཱ་ཀི་ནཱི་སིདྡྷི་ཧཱུྃ།",
    "མ་ཡལ་ཇེ་གསལ་སོང་ན་ལྷ་ཡི་རྟགས།",
    "འགལ་ཞིང་ལོག་པར་སོང་ན་བདུད་ཡིན་ནོ།",
    "དེང་སང་དེ་འདྲ་འོང་བ་རེས་འགའ་ཙམ།",
    "རོལ་མོའི་སྒྲ་དང་སྔགས་སྒྲ་ཡང་ཡང་ཐོས་། སྔར་དུས་ཡོད་པའི་སྲོ་ཤིག་ཐམས་ཅད་མེད།",
    "དེ་ནི་མཆོག་གི་རྟགས་སུ་གསུངས་ན་ཡང་།",
    "དེ་དུས་ལྷ་སོགས་ཞལ་གཟིགས་གང་བྱུང་བ།",
    "ཞལ་གཟིགས་གོ་ཆོད་ཀརྨ་པཀྴིས་བཞེད།",
    "ཡེངས་པ་ལྟར་སོང་དྲག་སྔགས་བཟླ་བ་དང་།",
    "ཉམས་དེ་ཡལ་རྗེས་རང་གི་སེམས་ལ་བརྟགས།",
    "འཕྲལ་དུ་ཐིག་ཀྱང་རང་གི་དགེ་སྦྱོར་འགྲིབ།",
    "དར་ཕྱར་དུང་འབུད་ཁྲོམ་འདུ་ཁྲི་ལ་འདུག།",
    "མུན་རུབ་གོས་ངན་གྱོན་ཞིང་ཐུར་དུ་སོང་། ལམ་ངན་འགྲིམ་རྨིས་ཚེ་བསོད་ཟད་པའི་རྟགས།",
    "བུད་མེད་རྒྱན་ཅན་མང་པོས་གླུ་གར་བཅས།",
    "ལྷ་མོ་སྒྲུབ་དུས་ཡིན་ན་སྐྱོན་ཆེར་མེད།",
    "རང་ལུས་རང་གིས་གཏོར་ནས་རྗེས་མེད་བྱས།",
    "རང་གིས་ཡི་དམ་གང་སྒྲུབ་དེའི་རྟགས་ཏེ།",
    "རང་གི་སྐྱུར་ནས་གཞན་དེ་འདོན་མི་དགོས་། དེ་དག་བསྐྱེད་རིམ་འབྱོངས་པའི་རྟགས་ཡིན་ནོ།",
    "དེ་ནི་གཏུམ་མོ་དྲོད་ཀྱི་དུས་ཡིན་ལ་། དྲོད་ཀྱི་སྟོབས་ཀྱིས་ཐིག་ལེ་འཕེལ་བའི་རྟགས།",
    "མཆོག་གི་དངོས་གྲུབ་མྱུར་དུ་ཐོབ་པར་གསུངས།",
    "ཡང་ན་རང་གི་བྱ་བ་འགྲུབ་མི་འགྲུབ།",
    "གཡས་ནས་རྒྱུ་དང་ཕྱིར་འབུད་ངན་ཐག་ཆོད།",
    "གཡོན་རྒྱུ་ཕྱིར་འབུད་དེ་བཞིན་བཟང་ངན་འདྲེས།",
    "རང་གིས་ཅི་བྱས་ལམ་དུ་མ་སོང་ཞིང་།",
    "རང་གིས་ཉེས་པ་རྡུལ་ཙམ་མ་བྱས་པར།",
    "ཐུན་མོང་ཞི་གནས་སྐྱེས་པའི་རྟགས་ཡིན་ནོ།",
    "སོ་སོར་དཔྱད་པས་གཅིག་ཀྱང་མ་རྙེད་པ་། ཐུན་མོང་ལྷག་མཐོང་ཤར་བའི་རྟགས་ཡིན་ནོ།",
    "ལྟོ་གོས་གཏམ་སོགས་འདོད་པ་ཆུང་དུ་སོང་།",
    "རང་གི་ཉམས་ལེན་ངེས་ཤེས་ཐེ་ཚོམ་མེད།",
    "སྔོན་གྱི་ཉམས་མྱོང་ཐམས་ཅད་ཤུན་པར་བུད།",
    "སེམས་ཀྱི་ཉམས་མྱོང་ངག་གིས་བརྗོད་མི་ཤེས།",
    "ངེས་འབྱུང་སྐྱོ་ཤས་མོས་གུས་ཇེ་ཆེར་འབར།",
    "དགོང་མོའི་ཐུན་མཚམས་འགའ་ཞིག་ལ་སྨྲས་པ།",
    "ན་མོ་གུ་རུ་མཉྫུ་གྷོ་ཥ་ཡེ།",
    "ཟང་ཟིང་འདོད་ཡོན་སྲེད་པས་བཅིངས་། ཉོན་མོངས་འདོད་པ་མེ་ལྟར་འབར།",
    "ད་ནི་བདག་གིས་ལྷ་འདི་འགྲུབ་། ཇི་ལྟར་བྱས་ཀྱང་བདག་གི་དཔལ།",
    "བདག་ལ་མི་སྒྲིབ་ཁྱོད་ཀྱང་འདྲེན།",
    "འབྲིང་གིས་སྤུན་དང་ཤ་རོག་ཚུལ།",
    "རང་གི་རིག་པའི་རང་རྩལ་ལས།",
    "དུས་ངན་སྙིགས་མར་དགྲ་རྐུན་མོད།",
    "བདག་གིས་བསྒྲུབས་ནས་འགྲུབ་བྱས་ཏེ།",
    "རང་གིས་འདྲེན་མ་ཐུབ་ཀྱང་བཟོད།",
    "དེ་འདྲའི་ནུས་པ་རང་རེར་མེད་ན་ཡང་།",
    "མ་ཐུབ་བསྐྱེད་རྫོགས་རེས་མོས་བྱ་བར་གསུངས།",
    "རེ་ཞིག་དེ་རུ་སྐྱེ་བ་ལེན་པའི་དོན།",
    "དེ་ལ་དགོངས་ནས་མཁས་པ་འགའ་ཞིག་གིས།",
    "རབ་ཀྱིས་ཟླ་གསུམ་འབྲིང་གིས་ཟླ་བ་དྲུག།",
    "རང་གི་ལུས་ཀྱང་མེད་དམ་སྙམ་པ་འབྱུང་།",
    "ཟས་ཀྱང་ནང་གི་སྦྱིན་སྲེག་ཚོགས་འཁོར་སོགས།",
    "བྱེད་ན་དགོང་ལའང་ཉེས་པ་མེད་མོད་ཀྱི།",
    "ཕྱིར་ནུབ་དང་བཅས་དགོང་མོའི་ཐུན་སྐབས་གཉིས།",
    "ན་མོ་བཛྲ་པཱ་ཎི་ཡེ།",
    "གེགས་སེལ་གདམས་པ་ཟབ་མོ་མ་ཤེས་ན།",
    "གང་ཟག་ཚིག་གི་བརྒྱུད་པ་མ་ཆད་ཀྱང་།",
    "རང་གི་གནས་གསུམ་འབྲུ་གསུམ་མཐའ་རུ་འཁོར།",
    "རང་གི་ངེས་ཤེས་བརྟན་པོ་ཐོབ་པ་ན།",
    "སྤྱན་རས་གཟིགས་དང་རྟ་མགྲིན་སྒྲོལ་མའི་རིགས།",
    "ཤགཤིན་རྗེའི་རིགས་དང་ལྷ་མོ་རྣམ་སྲས་རིགས།",
    "ཀུན་ཐུབ་རྒྱལ་མོ་སྐབས་སུ་བསྐུལ་ན་ལེགས།",
    "སྒྲུབ་པ་བྱེད་ཚད་ཀུན་ལ་འཚེ་བའི་བགེགས་། མང་པོ་རིག་པ་མཆོག་གི་རྒྱུད་ལས་གསུངས།",
    "ཉི་མར་ཁ་བལྟས་ཐལ་མོ་སྦྱར་བྱས་ནས།",
    "ཨོཾ་ཨ་མྲྀ་ཏེ་ཧཱུཾ་ཕཊ།",
    "ཅེས་བརྗོད་ཆུ་གཙང་ཁྱོར་གང་ལན་བདུན་སྔགས།",
    "ཤར་དུ་གཏོར་ཞིང་དེ་འདྲ་སྐབས་རེར་བྱ་། སྒྲུབ་པ་མ་གྲོལ་བར་དུ་བགེགས་བཅིང་འགྱུར།",
    "བགེགས་རེ་ཡོད་པས་ཕུལ་ཡང་ལྷ་མི་མཉེས།",
    "སྒྲུབ་པའི་དབུ་ལ་ལན་རེ་བྱས་པས་ཆོག།",
    "ནུབ་མོ་ལ་སོགས་དངོས་ཉམས་རྨི་ལམ་དུ།",
    "ས་ལས་ལངས་ཏེ་ལུས་ལ་རེག་པར་བྱེད།",
    "དེ་ཡིས་རེག་གྲིབ་གེགས་རྣམས་སེལ་བར་བྱེད་། ཟས་ཀྱི་གྲིབ་དང་སྡིག་ཅན་འབུལ་བ་སོགས།",
    "ལག་པ་གཡོན་པས་རང་གི་སྤྱི་བོར་བཀབ་། དེ་ཉིད་ཟླ་བའི་དཀྱིལ་འཁོར་ཉ་གང་བ།",
    "རང་གི་ཁོག་ནས་ཧ་ཡིག་ལྗང་གུ་རྣམས།",
    "འོག་སྒོ་ནས་ཐོན་ས་འོག་རིམ་དགུར་སོང་།",
    "དེ་བཞིན་རྟག་ཏུ་གསུམ་རེ་རེས་མོས་ཏེ།",
    "མཐེ་བོང་གིས་ནི་རྐེ་རྩིས་དམ་དུ་མནན།",
    "ཕྱི་རུ་མི་འབུད་ནང་དུ་བཟུང་བ་གཅེས།",
    "ཕར་ལ་འབུད་དུས་ཤེད་སྐྱེད་ལྷག་མེད་འབུད།",
    "གསང་གནས་ཡན་དང་བྱ་མོ་ལྷེན་འདབས་མན།",
    "གནོད་བྱེད་བཅིངས་བསམ་སོར་མོས་མཐེ་བོང་བཅིངས།",
    "སྲེ་མོང་རྒྱུས་པསསྲིན་ལག་གཉིས་པོ་བཅིང་།",
    "པུས་མོ་གཡས་རེག་གཡོན་རེག་དཔྲལ་བར་རེག།",
    "བུམ་ཆེན་ཚད་དུ་འཁྱོལ་བ་ཡིན་ནོ་ཞེས།",
    "མགོ་བོ་ཇེ་སྲབ་ཇེ་སྲབ་ལེབ་མོར་སོང་།",
    "མིག་གཉིས་མེད་ཅིང་ལྟག་ཁུང་ཧར་རེ་བུག།",
    "བུག་པ་ཧ་རེར་ཡོད་ལ་དམིགས་པ་གཏད།",
    "ལྕེ་ན་རང་གི་ཕོར་པ་ཆུ་གཙང་བླུགས།",
    "ཆུ་ནང་སོང་དམིགས་ལྕེ་ནི་ཆུ་ནང་སྦང་།",
