    "ཛ་ཧཱུྃ་བཾ་ཧོ་གཏོར་མ་མགོན་པོར་གསལ་བ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཇི་ལྟར་བཅོལ་བའི་ལས་འགྲུབ་པར་མཛོད་ཅིག་ཅེས་བཀའ་བསྒོ་བྱ།",
    "དེས་ལེགས་ལྡན་བྱ་རོག་ཞལ་གྱི་རྗེས་གནང་ཕུལ་གྲུབ་པས།",
    "སྤྱི་དང་ཁྱད་པར་གྱི་དམ་ཚིག་གཡར་དམ་དུ་འཆང་བ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་ལྟར་ན་དེ་རྣམས་ཀྱི་སྒོ་ནས་རང་གཞན་གྱི་དོན་རྒྱ་ཆེར་མཛད་པར་ཞུ།",
    "དེ་ལྟར་རྩྭ་མི་དང་རྒ་ལོ་ནས་ཕག་གྲུ་ལ་བརྒྱུད་པའི་ཐེལ་ལུགས་གཙང་མ་སོར་བཞག་བཀོད་པའོ།",
    "ལུང་རིགས་ཀྱི་ལུས་སྟོབས་ལྷག་པར་རྒྱས་ཤིང་ཕུས་རྒོལ་གླང་པོའི་སྤོབས་པ་འཕྲོག་པ་ལ་མཆོག་ཏུ་དཔའ་བའི་གདོང་ལྔ་པ།",
    "རབ་བྱེད་བཅུ་གཅིག་པ་ཕུལ་དུ་བྱུང་བའི་མཛད་འཕྲིན་སྐྱེ་འགྲོའི་མཆོད་སྡོང་དམ་པར་ལྷུན་གྱིས་གྲུབ་པ་༡ཤེ་",
    "རབ་བྱེད་བཅོ་ལྔ་པ་མཐའི་དམག་དཔུང་ཐུགས་རྗེའི་ཟེར་གྱིས་བཟློག་པར་མཛད་དེ་བོད་ཡུལ་གྱི་སྐྱེ་འགྲོ་ཕན་བདེའི་དཔལ་ལ་བཀོད་པ་༡བུ་",
    "རབ་བྱེད་བཅུ་དྲུག་པ་ཕུལ་དུ་བྱུང་བའི་མཛད་འཕྲིན་རྣམ་པར་དཀར་བས་མ་དག་པའི་གདུལ་བྱ་འགའ་ཞིག་རྗེས་བཟུང་བ་༡གྱི་",
    "རྫོགས་པར་ཤར་བའི་བློ་གྲོས་སྣང་བས་མ་རིག་མུན་པའི་དཔུང་བཅོམ་ནས།",
    "ཀུན་མཁྱེན་ཚངས་པ་དགྱེས་པའི་ཞལ་ལུང་ལས།",
    "ཛུརྨི་གསུམ་དུ་གཤེགས་པའི་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་མཁྱེན་བརྩེ་ནུས་པའི་སྤྱི་གཟུགས།",
    "འདྲེན་པ་ཟས་གཙང་སྲས་ཀྱི་རིང་ལུགས་འཛིན་པ་ལ་དེ་ཉིད་གཉིས་པ་ལྟ་བུ།",
    "མཁྱེན་རྟོགས་ཟུང་ལྡན།",
    "ཁྱེད་ཀྱི་བསམ་པའི་བབས་གཅིག་པར་སྣང་བས་ཟིན་བྲིས་བཏབ་ཆོག་ཅེས་བཀའི་རྗེས་སུ་གནང་བ་ཐོབ་པའི་མཐུས།",
    "དེ་བཞིན་གཤེགས་པ་རིན་༥་གྲགས་པར་གྱུར་ཏོ།",
    "མིར་གྱུར་པའང་རྙེད་པར་དཀའ།",
    "སློབ་དཔོན་ལྷ་རིག་པའི་སེང་གེ་དང་ཡིག་མཁན་ལི་བྱིན་ལ་སྒྲ་དང་ཡི་གེ་ལེགས་པར་བསླབས།",
    "དབྱེབས་ཁ་ཆེའི་ཡི་གེ་དང་བསྟན་ནས་ལྷ་སའི་སྐུ་མཁར་མ་རུར་བཅོས།",
    "ལོ་ཙཱ་བ་ཕོ་མི་དང་སྡའི་སློབ་བུ་དྷརྨ་ཀོ་ཥ་སོགས་ཀྱིས་བྱས།",
    "ཡེར་པར་སྒོམ་གྲྭ་བཙུགས།",
    "དེའི་ཚེ་བོད་སི་། ཡུལ་གངས་རིའི་ལྗོངས་འདིར་རྒྱལ་བའི་བསྟན་པ་ཡོངས་སུ་རྫོགས་པ་དར་ཞིང་རྒྱས་པར་བྱ་བའི་ཕྱིར།",
    "བློ་གྲོས་ཀྱི་ནོར་བཙུན་པ་དབྱིག་གཉེན་ལ་བདོ་བས་གནས་བརྟན་བསྟན་པ་འཇིན་པར་གྲགས།",
    "དེར་མུ་སྟེགས་མང་པོ་རྩོད་པས་ཕམ་པར་མཛད་པས་སྨྲ་བའི་སེང་གེ་རྩོད་མེད་དུ་གླེང་།",
    "དེ་ནས་དྭགས་ལྷ་སྒམ་པོར་བྱོན་ཏེ་ལོ་བཅུ་གཉིས་སྒྲབ་པ་དང་འགྲོ་དོན་སྟབས་སུ་མཛད།",
    "གཞན་དུས་གསུམ་མཁྱེན་པ་དང་།",
    "ཡུལ་དང་གདུང་དང་ན་བཟའ་ལས་མཚན་དུ་གསོལ་བ་གཙང་པ་རྒྱ་རས་པ་དེ་ཉིད།",
    "བསྟན་པ་བྱ་རྒོད་ཀྱི་ཉིན་ལམ་བཅོ་བརྒྱད་ཁྱབ་པར་དབུགས་ཕྱུང་།",
    "ལྷག་པར་རྗེ་བཙུན་རས་ཆུང་པ་ཀུན་གྱིས་མཐོང་བར་རས་པ་གཞོན་ནུའི་ཚུལ་དུ་བྱོན་ཏེ།",
    "མངའ་བདག་མེ་ཏྲི་པའི་ལུགས་ཀྱི་བདེ་མཆོག་སྙན་རྒྱད་ཀྱི་གདམས་པ་ཁྱད་པར་ཅན་། སྩལ།",
    "གཙང་ཤོད་དགོན་ཞེས་བྱ་བར།",
    "མི་ཕམ་པདྨ་དཀར་པོ་ཕྱོགས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བའི་ལྷ་ཞེས་གྲགས་པའི་ཀུན་མཁྱེན་ཆེན་པོ་སྟེ།",
    "ངོ་མཚར་གྱི་ཕོ་ཉས་རིམ་པར་མཚམས་སྦྱར་ཏེ།",
    "སྦྱངས་སྟོབས་ཀྱི་ངལ་བ་ལ་མ་ལྟོས་པར་མཁས་པའི་བྱ་བ་རྣམ་པ་གསུམ་ལ་ས་སྟེང་ན་འགྲན་ཟླ་མེད་པའི་པཎྜི་ཏ་ཆེན་པོར་གྱུར།",
    "བྱར་རྗེས་ཕུའི་ནགས་ཁྲོད་དབེན་པ་དེར་གཟིམ་སྤྱིལ་དྭངས་སྤྲོ་བ་ཞིག་བཟོས་ཤིག་ཅེས་ཞལ་བཀོད་གནང་།",
    "སྤྱན་འདྲེན་ཞུས་པ་ཐམས་ཅད་དུ་ཕེབས།",
    "སྲོང་བཙན་གྱི་རྩིག་མིང་ལ་ཕྱག་ནས་ཞུས་དུས་འདིར་ངེད་ཀྱི་གཟིམས་ཆུང་བཀོད་པ་བདེ་བ་ཞིག་མཛད་པར་ཞུ།",
    "ད་ཡང་དབུས་པ་ཞིག་བྱེད་པས་མགྱོགས་པར་སློབ་འོང་གསུངས།",
    "ངེད་འགྲོང་རྒྱས་ཕྱོགས་སུ་སྐྱེ་བ་ལེན་པས་བར་ཆད་མི་འབྱང་བའི་འཕྲིན་ལས་སྒྲུབས་ཤིག་གསུངས་བཀའ་བསྒོས།",
    "དྲེས་བཞིན་ཟླ་བའི་ཚེས་བདུན་ལ་གསང་གླིང་དུ་ཕེབས།",
    "དེ་ཐོག་ནས་དབྱེ་བ་ཕྱེད་ཡོང་གསུངས་བཀྲ་ཤིས་ལྷས་སྟེངས་སུ་ཕྱགས་ཕབ།",
    "སྨྱུ་འཕྲལ་གཟུགས་སྐུའི་བཀོད་པ་མངོན་བྱང་འོད་གསལ་གྱི་མཁའ་ཀློང་དུ་སྙོམས་པར་ཞུགས་པར་གྱུར་ཏོ།",
    "ལེགས་བྱས་ཡལ་འདབ་མཆོག་ཏུ་དགོད་པའི་ས་ཧོར་རྒྱལ་གོ་། རིགས་སཱ་ལའི་ཚལ།",
    "དཔའ་བ་དང་བརྟུལ་ཕོད་པས་ཕ་རོལ་རྣམ་པར་གནོན་པ་ཞིག་བྱུང་ལ།་",
    "དྷརྨ་རཱ་ཌཱུ་སྲས་གསུམ་གྱི་དང་པོ་དྷརྨ་པཱ་ལ་འོས་པར་དགོངས།",
    "ཕྱིས་དཔལ་ཆུ་བོ་རིར་ཐེག་། པ་བླ་ན་མེད་པའི་སྒྲུབ་པ་ལ་བཞུགས།",
    "ཕོ་ཡོང་བཟའ་ཁབ་ཏུ་བཞེས་པ་ལ་སྲས་དཔལ་གྱི་རྡོ་རྗེ་དང་རིན་ཆེན་རྡོ་རྗེ་གཉིས་བྱུང་།",
    "གཅེན་གྱིས་པ་ཚབ་མ་ཁབ་ཏུ་བཞེས་པ་ལ་བཛྲ་ཀིརྟི།",
    "གཡུ་སྲིང་སྨོན་མཁར་དུ་བཞུགས།",
