    "བསོད་སྙོམས་ཀྱི་དོན་དུ་འགྲེང་བ་ལ་སོགས་པ་སྦྱར་བའི་ཕྱིར་ཁྱིམ་པ་མོ་དང་ལྷན་ཅིག་སནས་པ་འདི་མི་བཟུང་ངོ་ཞེས་དང་།",
    "འདིར་དགེ་སློང་མ་ཉིད་བྱེད་པ་པོ་ཡིན་གྱི་བུད་མེད་ནི་མིན་ནོ་ཞེས་གསུངས།",
    "དངོས་པོ་དུས་རུང་གི་བཟའ་བའམ་བཅའ་བ་རུང་བ་མགྲོན་གཅིག་གི་ཚད་དུ་ལོངས་པ།",
    "དགེ་སློང་མས་ཚིག་གིས་བཅོལ་ཞིང་ངག་གི་རྣམ་པར་རིག་བྱེད་ཀྱིས་སྦྱོར་དུ་བཅུག་པ་ཉིད་ལའོ།",
    "དགེ་སློང་གང་སྦྱིན་བདག་གིས་སྔར་མགྲོན་དུ་མ་བོས་པ་ལ་སྦྱོར་དུ་བཅུག་ནའོ།",
    "སྦྱིན་བདག་གིས་སྔར་བཤམས་པ་ལས་ལྷག་པའམ།",
    "དགེ་སློང་གིས་དགེ་སློང་གཞན་གྱི་དོན་དུ་སྦྱོར་དུ་བཅུག་པ་ཟོས་ན།",
    "དགེ་སློང་གིས་གཙུག་ལག་ཁང་དུ་མ་ཟད་ཁྱིམ་གཞན་དུ་ཡང་སྦྱིན་བདག་གིས་ཟན་ལ་བོས་པ་དང་དུ་བླང་བར་བྱའོ།",
    "ཁྱིམ་གཞན་དུ་མགྲོན་དུ་བོས་པ་དེའི་ཕྱིར་དུས་ལ་བབ་པར་གཎྜི་བརྡུངས་ཏེ་གནས་བརྟན་རྣམས་ཀྱིས་རང་རང་གི་འཁོར་ལ་ཚང་མ་ཚང་ལྟ་བར་བྱའོ།",
    "ལེ་ལོ་ལ་སོགས་པས་གྱ་ཚོམ་དུ་རང་གི་ཟན་བཅད་པར་མི་བྱའོ།",
    "དགེ་སློང་གིས་ཉི་མ་གཅིག་ལ།",
    "ལས་མ་བྱས་པ་དང་ལམ་དུ་མ་སོང་བ་ལ་བྱེད་པ་པོ་ཡིན་ནོ།",
    "༡༩༧བ་གོས་ཀྱི་ཆུང་བའི་མཐར་གྱུར་པའི་ཚད་ནི་ཁྲུ་གང་གི་ཁྱོན་ནོ།",
    "གང་བྱས་པས་ཡང་ཡང་ཟ་བ་དང་འདུས་ཤིང་ཟ་བ་སོགས་ཀྱི་ཉེས་པར་མི་འགྱུར་བའི་ལས་ནི་ཕྱག་དང་རེ་ལྡེ་ཙམ་མམ།",
    "དེ་ནས་ཕྱི་མ་ལ་འགྲོ་བར་བྱའི་ཟན་སྔ་མ་ལ་སྤངས་ན་ཕྱི་མར་སོང་ཡང་བཟའ་བར་མི་བྱའོ།",
    "འདི་ལ་མཐོ་འཚམས་མོ་སྙམ་དུ་མཐོ་འཚམ་པའི་བསམ་པས་མགྲོན་དུ་བོས་༡༩༨ན་པ་ནི་བསམ་པ་ཐག་པས་མགྲོན་དུ་བོས་པ་ཉིད་མིན་པས་མགྲོན་དུ་བོས་པ་གཞན་ཟ་བ་ལ་ཉེས་པ་མེད་དོ།",
    "དེའི་ཕྱིར་དུ་ཡིན་ན་ནི་ཡིན་ནོ།",
    "མུ་གེ་བྱུང་ན་མགྲོན་དུ་བོས་པ་ཇི་སྙེད་བྱུང་བ་བདག་གིར་བྱའོ།་།",
    "མིན་པ་ཡང་ཐམས་ཅད་ལ་མིན་གྱི་སྦྱིན་བདག་གིས་འདིར་བཞུགས་ལ་བསོད་སྙོམས་གསོལ་ཅིག་ཅེས་གནས་སུ་བསོད་སྙོམས་མ་བསྟབས་པ་ལ་བྱེད་པ་པོ་ཡིན་གྱི།",
    "དགེ་སློང་མིན་པས་དེ་ལྟ་བུའི་འདུག་གནས་སུ་སྦྱིན་བདག་གིས་མ་སྟབས་པར་ཉི་མ་གཉིས་པ་དེའི་བསོད་སྙོམས་ཟོས་ན་གང་གིས་ཟོས་པ་ལ་དངོས་གཞིའི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "གང་གིས་སྟོབས་པའི་བསོད་སྙོམས་ཤེ་ན།",
    "བསོད་སྙོམས་ལྷག་པ་དེའི་བྲེའུ་ཆུང་དག་གི་ཚད་ནི།",
    "དགེ་སློང་གྲོགས་ཇི་སྙེད་ཡོད་པ་རེ་རེས་ཀྱང་དེ་ཙམ་བླང་ངམ་ཞེ་ན།",
    "ལྷག་པ་དེ་གང་གི་ཚེ་བྱེད་པ་པོ་ཡིན་ཞེ་ན།",
    "རང་གིས་བསྐོས་པ་གཞན་གྱིས་མནོས་པ་ཟོས་ན་ཡབ་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "ཡན་ལག་གི་མཚན་ཉིད་དོ།",
    "གང་གི་འདུག་པའི་གནས་ཤེ་ན།་",
    "ཟ་བ་པོ་དགེ་སློང་གི་འདུག་པའི་གནས་སོ།",
    "རེ་ཞིག་གཞན་ལ་བྲིམས་ཤིག་ཅེས་སོགས་རེ་ཞིག་གི་སྒྲ་ཉེ་བར་སྦྱར་ན་ནི་སྤངས་པ་མིན་ནོ།",
    "རེ་ཞིག་ཆོག་གོ་ཞེས་པའི་སྒྲ་སྦྱར་ན་ཡང་སྤངས་པ་མིན་ནོ།",
    "དགེ་སློང་ལ་འགའ་ཞིག་གིས་མཐོ་འཚམ་པས་བྱིན་ལེན་སྟོབས་པ་ནི།",
    "བྱིན་ལེན་སྟོབས་པ་ཉིད་མིན་པས་དགེ་སློང་གིས་དེ་ཤེས་ནས་འདི་མི་དགོས་ཞེས་སྤངས་པས་ཀྱང་བཏང་བར་མི་འགྱུར་རོ།",
    "དངོས་པོ་དུས་རུང་གི་བཟའ་བའམ་བཅའ་བ་རུང་ཚད་ལྡན་བྱིན་ལེན་ཅན་ལྷག་པོར་བྱས་མ་ཟིན་པ།",
    "དགེ་སློང་གང་གིས་ཟས་ཀྱི་གནས་མ་བཏང་བས་ལྷག་བོར་བྱ་བ་ཉིད་དོ།",
    "ཁྱོད་ཀྱིར་གྱུར་གྱི་བཞུད་ཅིག་ཅེས་བྱ་བའི་ཚིག་གིས་བྱའོ།",
    "དེ་གཉིས་གང་གིས་བྱས་ཀྱང་རུང་ངོ།",
    "ཟས་ཀྱི་བྱ་བ་བཏང་བས་ནི་བཟའ་བར་མི་བྱ་བར་སྔར་གྱི་ཚིག་གང་རུང་གིས་ལྷག་༢་༡བ་པོར་བྱའོ།",
    "ལྷག་བོར་བྱས་པ་ཟས་དགེ་སློང་གཅིག་གིས་བླངས་པ་དེ་དགེ་སློང་གཞན་གྱིས་ཀྱང་བཟའ་བར་བྱ་སྟེ།",
    "བཞི་པ་ཡན་ལག་གི་མཚན་ཉིད་ལ་གཉིས་ལས།",
    "དངོས་པོ་དུས་རུང་གི་བཟའ་བའམ་བཅའ་བ་རུང་ཚད་ལྡན།",
    "ཟས་དུས་རུང་གི་བཟའ་བ་དང་བཅའ་བ་ཙམ་མོ།",
    "ཤ་ཁ་ར་ལ་སོགས་པ་དག་ལ་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "སྟན་ཅིག་པའི་སྦྱངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་པའི་དགེ་སློང་གིས་སྤང་བ་ཉིད་ཡིན་ཡང་རུང་སྤངས་པ་ཉིད་མིན་ཡང་རུང་སྟེ།",
    "ཉོན་མོངས་པ་ཉེས་རྩོམ་མོ།",
    "དངོས་པོ་དུས་རུང་གི་བཟའ་བའམ་བཅའ་བ་རུང་ཚད་ལྡན།",
    "འདུས་ཤིང་ཟ་བ་སོ་སོར་ངེས་པའི་ཟས་ཀྱི་གནས་ཅན་གྱི་དགེ་སློང་མཚམས་ཀྱི་ནང་ན་ཟན་ཟ་བ་དག་གི་ཟན་ལྷན་ཅིག་མིན་པ་ཉིད་ལ་འདུ་ཤེས་གཙོ་ཆེར་བྱེད་པ་པོ་ཡིན་ནོ།",
    "མཚམས་གཅིག་གི་ནང་ན་གཞིའི་འདུག་གནས་ལོགས་གཅིག་ན་ཡོད་ཅིང་།",
    "རེས་ཁང་ཁྱིམ་དུ་བྱེད་པ་ལས།",
    "དེའི་ཚེ་གཞིའི་འདུག་གནས་པ་དག་གིས་གཞིའི་འདུག་གནས་དེར་ཟས་ཀྱི་ཕྱིར་འདོད་པར་བྱ་བ་ཉིད་དུ་གནས་པ།",
    "དེ་དག་གི་འོང་བ་ཉིད་མ་དྲིས་པར་ཟན་བསླབ་པའི་གཞི་འདི་ལས་འདའ་བའི་ཕྱེད་ཡིན་པས་ཉེས་བྱས་སུ་འགྱུར་ཏེ།",
    "ཐམས་ཅད་ཀྱི་ཟས་ཕྱོགས་གཅིག་ཏུ་སྤུངས་པའི་སྤྱི་བུངས་ལས་རང་གི་སྐལ་བ་མནོས་ཏེ་ཁྱེར་ནས་བཟའ་བར་མི་བྱའོ།",
    "རང་གི་གླེང་གི་ཕྱེད་ཡོལ་ནས་སྐྱ་རེང་མ་ཤར་བའི་བར་ཡིན་པ་དང་མུ་གེའི་དུས་མིན་པའོ།",
    "དགེ་སློང་རང་གང་ན་གནས་པའི་གླིང་གི་ཉི་མ་ཕྱེད་ཡོལ་ནས་སང་གི་སྐྱ་རེང་འཆར་པའི་བར་ནི་དུས་མིན་ནོ།",
    "གུང་ཚིགས་ཀྱི་སྐད་ཅིག་ཕན་ཆད་སྐྱ་རེང་ཤར་བའི་མདུན་རོལ་གྱི་བར་དེ་ནི་དུས་མིན་པར་རིག་པར་བྱའོ་ཞེས་གསུངས།",
    "བཞི་པ་ཆོ་ག་ལས་འདས་པ་ལ་གཉིས་གསོག་འཇོག་གི་དང་།",
    "ཡན་ལག་གི་མཚན་ཉིད་༢༤ན་བྱིན་གྱིས་བརླབས་པའི་དགོས་པ་ལ་དོགས་པ་བཅད་པ།",
    "གསོག་འཇོག་གི་མཚན་ཉིད་ཇི་ལྟ་བུ་ཞེ་ན།",
    "སྐྱ་རེངས་ཤར་ནས་གུང་ཚིགས་ཀྱི་སྐད་ཅིག་གི་བར་ནི་སྔ་དྲོ་ཡིན་ལ་དེར་རུང་བའི་ཟས་བྱིན་ལེན་བྱས་པ་བྱིན་ལེན་དེ་ཉིད་མ་བཤིག་པར་གུང་ཚིགས་ཡོལ་ཕན་ཆད་ཀྱི་ཕྱི་དྲོ་ཡང་རུང་བའི་ཟས་ཀྱི་དུས་སུ་གྱུར་པ་དང་།",
    "དགེ་སློང་གི་གནས་ཀྱི་མཚམས་ཀྱི་ནང་དུ་བཙོས་པ་དང་ཞག་ལོན་པ་ཡང་བཟའ་བར་མི་བྱའོ།",
    "མཚམས་ཀྱི་ནང་ངམ་ཕྱི་རོལ་ཏུ་ཡང་རུང་དགེ་སློང་གིས་བཙོས་པ་བཟའ་བར་མི་བྱའོ།",
    "སྦྱིན་བདག་གིས་རུང་བ་མིན་པའི་གཞིར་བཙོས་པའམ་ཞག་ཏུ་བཞག་པ་འབུལ་བར་བྱེད་པ་དེ་ལ་ནི་ཉེས་པ་མེད་དོ།",
    "སྦྱིན་བདག་གིས་མར་དང་འབྲས་ལ་སོགས་པ་ཕུལ་ལ་རང་འོང་ནས་བྲིམ་མོ་ཞེས་ཟེར་བ་དེ་ལ་ནི་ཉེས་པ་ཁོ་ནར་འགྱུར་ཏེ།",
