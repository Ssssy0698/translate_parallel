    "ཁ་མ་བཀྲུས་པར་རེག་པ་ལྟ་བུའོ།",
    "རེག་པའི་དང་།",
    "ཡོད་པར་རྗེད་པས་བཟའ་བར་བྱ་བ་ལ་རེག་པས་ཀྱང་ལག་ཉར་འགྱུར་བ་མིན་ནོ།",
    "ནོར་བ་དང་བརྗེད་པ་དེ་གཉིས་ཀྱིས་ཟས་གནས་ནས་སྤོས་པ་རང་གནས་སུ་བཞག་པའི་ཕྱིར་རེག་པ་ཡང་ལག་ཉར་འགྱུར་བ་མིན་ནོ།",
    "སྡོམས་པས་མཉམ་པ་ལྟ་བ་ཐ་མི་དད་པ་དག་གིས་གསོག་འཇོག་བྱས་པ་དང་།",
    "ལག་ཉར་བླངས་པ་དག་ནི་གཅིག་པ་ཉིད་ཡིན་པས་དགེ་སློང་གཅིག་གི་བྱིན་ལེན་བྱས་པ་དེ་གཞན་དག་གི་བྱིན་ལེན་བྱས་པ་ཡང་ཡིན་ནོ།",
    "མཆོག་མིན་པ་བསླབ་པ་བྱིན་པ་ལྟ་བུར་གཅིག་པས་དགེ་སློང་གི་བྱིན་ལེན་གསོག་འཇོག་གིས་བསླབ་སྦྱིན་གྱི་བྱིན་ལེན་གསོག་འཇོག་ཏུ་ཡང་འགྱུར་རོ།",
    "སྡོམས་པས་མཉམ་པ་མཚན་མི་མཐུན་པ་དག་གི་ཡང་བྱིན་ལེན་གསོག་འཇོག་ཕན་ཚུན་གཅིག་པ་ཉིད་དུ་འགྱུ་ར་རམ་ཞེ་ན།",
    "དགེ་སློང་གིས་དགེ་ཚུལ་དག་གི་ཟས་ལ་རེག་པ་ནས་སྦེད་པའི་བར་ལ་ཉེས་པར་འགྱུར་བ་ནི་དགེ་སློང་གི་ཟས་ལ་དགེ་ཚུལ་གྱིས་རེག་པས་ཉེས་པར་མི་འགྱུར་བ་དེ་བཞིན་ནོ།",
    "ཞིང་གི་ཐོག་ཤས་ནོད་པ་དང་།་",
    "དེ་གྲུབ་པའི་ཕྱིར་རེག་པ་ནི་ཆུད་ཟ་བའི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ན་དེ་ལ་རེག་པ་རུང་བ་ཟིན་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཟས་བཀལ་བའི་ཤིང་རྟ་ལ་ནི་རྐྱེན་དེ་ལྟ་བུ་ཡོད་ན་ཁ་ལོ་བའི་སྟན་མ་གཏོགས་པ་ལ་རེག་པར་བྱ།",
    "འབྲས་ལ་སོགས་པས་གང་བའི་ཤིང་རྟ་ལ་ཡང་མི་རེག་ཏུ་མི་རུང་བའི་རྐྱེན་དེ་ལྟ་བུ་ཡོད་ན་ཁ་ལོ་བའི་སྟན་མ་གཏོགས་པ་ལ་རེག་པར་བྱའོ།",
    "སོགས་པ་བཅུག་པའི་གྲུ་ལ་ནི་རུ་སྐྱ་མ་གཏོགས་པ་མ་རེག་གོ།",
    "རུ་སྐྱ་དེ་འཛིན་པའི་སྟན་ལ་ཡང་༢༨ན་རེག་པར་མི་བྱའོ།",
    "སྐྱམ་པ་སོགས་ལ་དང་པོ་ནས་རེག་པར་བྱའམ་ཞེ་ན།",
    "གང་གི་ཚེ་རུང་ཞེ་ན།",
    "དེ་གཉིས་ཀྱི་དུས་སུ་བསྙེན་པར་མ་རྫོགས་པར་རང་གི་ལུས་སམ་དེ་དང་འབྲེལ་བའི་ཐག་པ་ལ་སོགས་པ་ནས་འཛིན་པའི་ཆོ་ག་མ་འབྱོར་ཏམ།",
    "ལམ་བརྒྱགས་ཁྱེར་བའི་ཁུར་ཚ་བ་གཞན་མེད་ན་སྦྱིན་བདག་གིས་དེ་གཞན་ལ་བཀུར་བ་སོགས་སྤྲོ་བར་བྱའོ།",
    "སྦྱིན་བདག་ལ་བཅོལ་ཡང་མ་གྲུབ་པས་ཁྱེར་བ་མེད་ན་ལམ་བརྒྱགས་རང་གིས་བསྐུར་བར་བྱའོ།",
    "རང་གིས་ཁྱེར་བ་དེ་ཉིད་ལས་ཚ་བ་གཞན་ལ་སྦྱིན་པས་བསྙེན་པར་མ་རྫོགས་པ་དང་བསྐལ་པ་བརྗེ་ཞིང་བླང་བ་སྒྲུབ་པར་བྱའོ།",
    "བྱིན་ལེན་སྟོབས་པར་བྱེད་པ་མེད་ན་བྱིན་ལེན་མ་བྱས་པ་རང་གིས་ཁྱེར་བ་དེའམ།",
    "དེ་གཉིས་དགེ་སློང་གང་གི་བཟའ་བྱ་ཡིན་ཞེ་ན།",
    "ཉིན་གཅིག་ཟན་བཅད་པར་བྱས་པའི་དགེ་སློང་གི་བཟའ་བྱའོ།",
    "ཟན་མེད་པའི་དགེ་སློང་གིའོ།",
    "ཟན་མེད་ཅིང་ཤིན་ཏུ་བཀྲེས་ན་རང་གིས་ཀྱང་ཤིང་ཐོག་སོགས་བཏོག་པ་དང་རྩ་བ་ནས་དབྱུང་བ་ཉིད་དང་།",
    "གཞན་གྱི་བདག་གིར་བྱ་བའི་ཐ་སྙད་མེད་པར་བྱང་གི་སྒྲ་མི་སྙན་ན་གྲགས་པའི་ཡིད་ལ་བྱེད་པ་མངོན་དུ་བྱའོ།",
    "ཡན་ལག་གི་མཚན་ཉིད་དམིགས་བསལ་དང་བཅས་པའོ།",
    "སྦྱིན་བདག་གིས་བསམ་པ་ཐག་པས་དགེ་སློང་ལ་བསྔོས་ཏེ་བཏང་བའི་བསོད་སྙོམས་ལ་དགེ་སློང་རང་གིས་བླངས་ཏེ་སྒྲ་མི་སྙན་གྱི་དུས་བྱིན་གྱིས་བརླབས་ནས་བཟའ་བར་བྱའོ།",
    "སྦྱིན་པར་༢༩བ་འདོད་པས་དེའི་ཡན་ལག་གིས་སམ་ལག་པ་དེ་དང་འབྲེལ་བས་བྱིན་པ་མནོས་པ་ནི་བྱིན་ལེན་ཡིན་ནོ།",
    "བྱིན་ལེན་སྟོབས་པ་པོ་རང་གི་ཡུལ་དེ་ན་འགའ་ཡང་དེའི་ལག་ནས་ཟན་མི་ཟ་བའི་མི་སྨད་པར་བྱ་བ་རིགས་ངན་སོགས་ཡིན་ན།",
    "ཁྲི་དང་ཁྲིའུ་དང་ཐུ་བ་དང་ལྷུང་བཟེད་ཀྱི་གཞི་དག་གིས་བྱིན་ལེན་ནོད་དུ་མི་རུང་བ་ཉིད་མིན་ནོ།",
    "ཤིང་ཐོག་འབྲིམ་པར་བྱེད་པ་དག་གིས་སྙོམས་པར་འབྲིམ་པར་བྱ་བར་མོས་པར་བྱའོ།",
    "གོས་དག་མ་རུངས་པ་སྤང་བའི་ཕྱིར་རྩྭ་དང་ལོ་མ་ལ་སོགས་པ་བདག་གིས་གོས་དག་བསྐྱབ་པར་བྱའོ།",
    "ཨ་མྲ་ཞིམ་པོ་དག་ལོགས་ཤིག་ཏུ་བསལ་ཏེ་བྲིམ་པར་བྱ་སྟེ་མི་སྙོམས་པ་བསལ་བའི་ཕྱིར་རོ།",
    "དེ་གཉིས་ཤིན་ཏུ་རྒན་པས་འབྲིམ་བྱེད་ཀྱིས་མི་འཐོབ་པའི་ཟས་བཟང་པོ་ཐོབ་ན་འབྲིམ་བྱེད་རང་གི་དྲུང་ན་འདུག་པའི་གྲོགས་དག་གིས་ནོད་པར་བྱའོ།",
    "འབྲིམ་པར་བྱེད་པ་དུ་མ་ཉིད་ཡིན་ན་དྲུང་ན་འདུག་པའི་དགེ་སློང་རང་སྟན་ལས་མ་འཕགས་པས་དེ་དག་གི་སྐལ་བ་ཇི་ཙམ་ལེན་ནུས་པ་དེ་ཙམ་ནོད་པར་བྱ་ཞིང་ལྷག་མ་ནི་གཞན་དག་གིས་ནོད་དོ།",
    "བྱིན་ལེན་བྱས་པའི་འོག་ཏུ་སྦྲང་བུ་དང་གྲོག་སྦུར་ལ་སོགས་པ་དག་གི་རེག་པས་ཀྱང་བྱིན་ལེན་མ་ཞིག་གོ།",
    "དགེ་སློང་གིས་འཛིན་པ་མ་བཏང་བ་ལ་གཞན་གྱིས་རེག་པས་ཀྱང་བྱིན་ལེན་མི་འཇིག་གོ།",
    "བྱི་བས་རེག་པས་ནི་བྱིན་ལེན་ཞིག་པར་བྱས་སོ།",
    "རང་དང་འབྲལ་བ་བྲལ་བ་ལ་མ་རྫོགས་པས་རེག་པ་དང་།",
    "འི་ཟས་ལ་གཞན་གྱིས་རེག་གམ་སྙམ་པའི་ཐེ་ཚོམ་བསལ་བའི་ཕྱིར་དུ་བྱིན་ལེན་སྟོབས་པ་ནི་རིགས་པ་ཉིད་མིན་ནོ།",
    "གང་གིས་བྱེད་ལེན་མ་བསྟབས་པ་ལ་ཞེ་ན།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་ཟ་བ་ནི་མ་གཏོགས་སོ།",
    "སྦྱོར་བ་རང་གི་ལག་ཏུ་བསམ་པའི་དོན་གསལ་པོར་མངོན་སུམ་དུ་སྨྲས་པའོ།",
    "ཡན་ལག་གི་མཚན་ཉིད་ནི་ཟས་བསོད་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "གང་གི་ཚེ་དེ་གཉིས་བྱེད་པ་པོ་ཡིན་ཞེ་ན།",
    "རང་གི་ལག་གིས་བླངས་ཏེ་ཟོས་ན་དངོས་གཞིའི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "དགེ་སློང་གིས་བསོད་པ་འཐོབ་པ་ན།",
    "ཁོ་བོ་ལ་འདི་མི་དགོས་སོ་ཞེས་ཕྱིར་སྤོང་བ་ལ་འོ་ན་ཅི་སློང་ཞེས་དྲིས་པ་ནི་སྦྱིན་བདག་གིས་ཟས་ཅི་བདེར་བསྟབས་པ་ཉིད་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་བག་མེད་པའོ།",
    "གང་གི་སྲོག་ཆགས་དང་བཅས་པ་ཞེ་ན།",
    "ཞོ་ཁ་ཆུ་དང་རྩབ་མོ་དང་ཤིང་ཏོག་དང་བཅའ་བར་བྱ་བ་ལ་སོགས་པ་རང་གི་ལུས་ཀྱི་ཡོ་བྱད་དུ་ཉེ་བར་སྦྱར་བར་བྱ་བའི་སྲོག་ཆགས་དང་བཅས་པའོ།",
    "དུད་འགྲོར་གྱུར་པའི་སྲོག་ཆགས་རེ་རེའི་སྲོག་འགགས་པ་ན།",
    "སྤྱད་པ་ནི་རང་གི་ལུས་ཀྱིར་ཉེ་བར་སྤྱད་པ་ཡིན་ནོ།",
    "ས་དང་ལྕི་བ་དང་ཚོན་དང་།",
    "དགེ་སློང་གིས་ཆུ་བཙགས་པའི་ཕྱིར་སྤྱད་ཚགས་བཅང་བར་བྱའོ།",
