    "དེའི་ཕྱིར་སྟོང་པ་ཉིད་ཀྱི་ལས་བསྒོམས་པ་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "མཐུན་པ་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ་གཅིག་ཏུ་ན་བྱ་བ་ཐམས་ཅད་ལས་སྨོས་ངཔ་སྤྲོས་པ་མེད་པ་ཉིད་མ་ཡིན་ཏེ་དེ་ལ་མཐུན་པ་མེད་དེ་བདག་དང་བདག་གི་བ་ལ་སོགས་པའི་འཇིག་རྟེན་ཀྱི་དངོས་པོ་ལས་སྐད་ཅིག་གནས་པ་སྤངས་པ་སྟེ་ཐོག་མ་ནས་སྐྱེ་བ་མེད་པས་ཨེའི་ཡི་གེ་གསུངས་པ་ཡིད་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་རྣམས་ལས་ཐམས་ཅད་ཀྱི་འཇིག་རྟེན་གསུམ་ན་གང་སྲིད་པའི་མི་ལ་སོགས་པར་སྐྱེ་བ་དེ་རྣམས་སུ་འཇིག་རྟེན་དུ་བདེ་བ་རང་གི་ཁ་ཡིས་དྲངས་ནས་རང་བྱིན་གྱིས་བརླབས་པ་རང་བཞིན་མེད་པའི་གཟུགས་ཀྱི་སྦྱོར་བའི་བདག་ཉིད་ཀྱིས་སོ།",
    "ཕྱི་མོ་ཞེས་བྱ་བ་ལ་སོགས་པས་དེའི་ཕྱི་མོ་ཞེས་བྱ་བ་ནི་ས་བོན་གྱི་ཡི་གེའོ།",
    "དེའི་ཞེས་བྱ་བ་ནི་རྣལ་འབྱེར་པས་འོག་གི་གནས་པ་ལས་གཞན་ནོ།",
    "འདིར་འོག་གི་སྒྲས་སྔོན་གྱི་རང་བཞིན་གྱི་རང་གི་སེམས་ལས་བྱུང་བ་ནམ་མཁའི་བདག་ཉིད་ཅན་ཀྱང་ངོ།",
    "ལས་ཞེས་བྱ་བ་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་དུ་བྱའོ།",
    "ད་ནི་ཀའི་ཡི་གེ་ལ་སོགས་པ་ནས་མའི་ཡི་གེའི་བར་དུ་ཉི་ཤུ་རྩ་ལྔའི་དེ་ཁོ་ན་ཉིད་ཀྱི་དབྱེ་བས་ལས་རྣམས་གསུངས་པ་སླར་ཡང་རེ་རེའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་མགོ་བོ་པུལླཱི་ར་ལ་སོགས་པ་ནས་པུས་མོའི་བར་དུ་ཉི་ཤུ་རྩ་བཞི་དང་ཡན་ལག་ཐམས་ཅད་དེ་ཉི་ཤུ་རྩ་ལྔའོ།",
    "སྟོང་པ་ཉིད་དེ་ཁོ་ན་ཉིད་རིག་བྱེད་པ་ཞེས་བྱ་བ་ནི་རང་གི་སེམས་ཀྱི་ཀུན་དུ་སྤྱོད་པར་མགོ་བོ་ལ་སོགས་པའི་དབུས་མར་རབ་ཏུ་ཞུགས་པར་སྟོང་པ་ཉིད་མཁས་པ་རྣམས་ཀྱིས་མཚོན་པར་བྱའོ།་།",
    "ཡི་གེ་ཌ་བཅུད་ལེན་གྱི་དེ་ཁོ་ན་ཉིད་སྣའི་རྩེ་མོར་རོ།",
    "ཡི་གེ་ཕ་རིགས་ཀྱི་རིམ་པ་ལ་སོགས་པའི་དེ་ཁོ་ན་ཉིད་སོར་མོ་རྣམས་ལའོ།",
    "ཡི་གེ་བྷ་ལུང་རྗེས་སུ་རིག་གྲུཔའི་དེ་ཁོ་ན་ཉིད་པུས་མོ་གཉིས་དག་ལའོ།",
    "རེངས་པ་དང་།",
    "ཇི་སྲིད་ཉི་ཤུ་རྩ་ལྔའི་བར་ཏེ་རེ་རེ་ལ་ལྔ་ལྔར་འགྱུར་བས་སོ།",
    "ལེའུ་རེ་རེར་རོ།",
    "ཨ་ཕ་ཨི་ཙ་རི་ཊ།",
    "རགས་པའི་དུས་ཀྱིས་དབྱེ་བས་ཕྲ་མོ་ཉིད་དུ་འགྱུར་བའོ།",
    "སླར་ཡང་དག་གོ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྡོ་རྗེ་ཕག་མོའི་དྲི་བའོ།",
    "ཕྱི་དང་ནང་གི་བདག་ཉིད་དུའོ།",
    "དེ་ནས་ལྷ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གསུངས་ཞེས་བྱ་བ་ལ་སོགས་པས་རྡོ་རྗེ་ཕག་མོས་འདྲི་བའོ།",
    "གཟའ་དང་རྒྱུ་སྐར་ལ་སོགས་པའི་འཆར་བའི་དུས་ཀྱི་བདག་པོ་ཁྱབ་བདག་གསུངས་ཤིག་བདག་གི་ཐེ་ཚོམ་སོལ་ཅིག་པའོ།",
    "ལྷ་མོ་ཉོན་ཞེས་བྱ་བ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་ཀྱིས་ལན་གསུངས་པའོ།",
    "འདིར་ཐོག་མ་ཉིད་དུ་ལྷའི་དགྲའི་མིང་གི་ཡི་གེའི་སྒོ་ནས་རྣལ་འབྱོར་ལ་སོགས་པར་འཇུག་པ་གསུངས་ཏེ།",
    "སྲིད་གསུམ་གང་གི་ཁྱེཐིམ་པ་ཞེས་བྱ་བ་ནི་དཔེའི་མིང་ལྷན་བྱུག་སྐྱེས་པ་དེ་ཐོབ་པས་ན་དེའི་ཏིང་ངེ་འཛིན་གྱི་སྐད་ཅིག་སྟེ་དུས་མི་ཤེས་པས་དབྱེ་བ་མེད་པའོ།",
    "དབྱངས་དང་གསལ་བྱེད་ཐམས་ཅད་ཕན་ཚུན་ཕྱི་མོ་ལ་སོགས་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་སོ།",
    "བསྐྱོད་མ་སྐྲག་མ་གཏུམ་མོའོ།",
    "གཏུམ་མོ་དེ་བཞིན་དཔལ་ཆེན་མོ།",
    "སྒྲ་དང་དྲི་དང་རོ་དང་རེག་ང་།",
    "ཡིད་དང་ཉོན་མོངས་ཅན་དེ་བཞིན།",
    "ཨ་ཕྱྭཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དགུ་ལྔ་བཞི་བཅུ་རྩ་ལྔའི་བར་དུའོ།",
    "ཉི་མ་ཅན་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་ཐམས་ཅད་རེ་རེ་ལ་ཡང་ཆུ་སྲང་གི་དབུགས་ཀྱི་དབུས་སུ་འགྱུར་རོ།",
    "རྒྱུ་སྐར་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་རེ་རེའི་རྐང་པ་ལ་སོགས་པས་གཉིས་རྣམས་བཅུ་གཉིས་རྣམས་ཀྱིས་ཉི་ཤུ་རྩ་བདུན་ནོ།",
    "རཱ་སི་རྒྱུ་བ་རྣམས་བུགསུམ་གང་གི་ཕྱིར་ཞེས་བྱ་བ་ནི་ནང་གི་བདག་ཉིད་དུ་རྡུལ་དང་ཁུ་བ་དག་གོ།",
    "འདིའི་རེ་རེའི་དུས་རྣམས་རྟོགས་པར་གཟུང་ཁྱབ་རྣམས་ཀྱིས་སོ།",
    "རང་རང་གི་ཞིང་མ་རྣམས་ཀྱིས་ཀྱང་རབ་ཏུ་རྟོགས་ནས་འཆར་ཏེ་རཱ་སེ་དེ་རྣམས་ཀྱིས་སོ།",
    "དེ་ལྟར་ཐུཞག་གསུངས་པ་ནག་མོ་དང་གཅིགས་མ་དང་འཇིགས་བྱེད་མ་དང་དགའ་ལས་འདས་མ་དང་ལོག་འདྲེན་མ་དང་ཙཱ་མུཎྜི་དང་དྲག་པོའི་གཟུགས་ཅན་མ་དང་ལྷ་མོ་ཨུ་མ་དང་།",
    "ཇི་ལྟར་དཔལ་རྡོ་རྗེ་མཁའ་འགྲོར་ནག་མོ་དེ་བཞིན་འཇིགས་བྱེད་དང་།",
    "རྩེ་མོ་ནག་མོ་གཞན་མི་ཐུབ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རྡོ་རྗེ་ཕག་མོ་ཕྱོལ་སོགས་པའི་རྣལ་འབྱོར་མའི་ཚོགས་ཐམས་ཅད་འདུས་ནས་འདྲི་བའོ།",
    "བཅོམ་ལྡན་འདས་རང་གི་ཐུགས་དགོངས་མཛད་པའོ།",
    "འོན་ཀྱང་རང་གི་རང་བཞིན་གྱིས་བདག་གི་ཞེས་བྱ་བ་ནི་བདག་ཤཱཀྱ་ཐུབ་པ་ལ་སོགས་པ་རྣམས་མེད་དོ་ཞེ་ན།",
    "རང་གི་རང་བཞིན་ཡོན་ཏན་དེ་བཞིན་ཞེས་བྱ་བ་ནི་ལས་སུ་སྨྲ་བར་རབ་ཏུ་གྲགས་ཏེ།",
    "བདག་ཀྱང་ལས་ལས་བྱུང་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཚིག་གིས་སོ།་།",
    "དེ་ལྟར་ལས་དང་འབྲས་བུ་རྣམས་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པས་ཕག་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་འདྲི་བ་སྟེ་གླུ་འདིས་མཉེས་པར་བྱེད་དོ།",
    "གླུ་དེ་ཉིད་གསུངས་པ་ཨ་མི་ཏཱ་བྷ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་ཏིང་ངེ་འཛིན་བདག་ལ་སྤྲུལ་བྱེ་ཅིག་ས་རི་རེ་ལུས་ཅན་རྣམས་ལ་སྟེ་སཱ་རཱི་རཱི་ནི་ཏིང་ངེ་འཛིན་ཉམས་སུ་མྱོང་བའོ།",
    "དེ་ཉིད་གསུངས་པ་འོད་དཔག་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ་མིང་གི་ཡི་གེའི་རབ་ཏུ་སྦྱོར་བས་ཞེས་བྱ་བའོ།",
    "ཨུ་ཞེས་བྱ་བ་ནི་བྱང་གི་འདབ་མ་ལའོ།",
    "མ་ཀ་ཞེས་བྱ་བ་ནི་ཆུ་སྲིན་དང་བུ་མོ་གཉིས་ཏེ་འདྲི་མེད་ཅེས་བྱ་བ་ནི་བདེན་བྲལ་གྱི་གྲྭར་རོ།",
    "གཟའ་ལྷག་གི་མཐར་ཕུར་བུ་དང་པ་བསངས་དང་།",
    "དེའི་ཕྱིར་ཟླ་བ་ལ་སོགས་པ་རང་རང་གི་རཱ་སེས་བརྒྱན་པར་གོ་བར་བྱའོ།",
    "དེ་རྣམས་ཀྱི་ཡན་ལག་སུམ་ཅུ་ཞེས་བྱ་བ་ནི་བ་ཐག་གི་སྣལ་མའི་གཟུགས་མ་རྣམས་སྲོག་འབབ་པའི་རྩ་ཆེན་པོ་སྟེ།",
    "གཙོ་བོ་བཅུ་གཉིས་ཉིད་ཅེས་བྱ་བ་ནི་དབྱངས་བཅུ་གཉིས་རྣམས་ཀྱི་ཨའི་ཡི་གེ་ལ་སོགས་པ་བཅུ་གཉིས་རྣམས་ཀྱི་རྨྱེབགྲོད་པ་དཀར་པོའི་ཕྱོགས་རྣམས་སུ་རྐང་པ་གཡོན་པའི་མཐེ་བོང་དང་རྐང་པའི་བོལ་གོང་དང་བྱིན་པ་དང་པུས་མོ་དག་ཏུ་གསང་བ་དང་རླིག་པ་དང་མཆན་ཛུཁུང་དང་ལག་ངར་དང་དཔུང་པ་དང་ཐལ་གོང་དང་དཔྲལ་བའི་སྟེང་དང་དབུས་སུ་ཡང་སྟེ་བཅུ་གཉིས་སོ།",
    "དེ་ལྟར་ཉི་མ་དྲུག་ཅེས་བྱ་བ་ཕྱིན་ཅི་ལོག་གིས་འཁོར་ལོ་དབུས་མར་དུམ་བུ་ཐོག་མ་ནས་བརྩམས་ནས་དུམ་བུ་དྲུག་གི་བར་དུ་བདུན་དང་བརྒྱད་དང་དགུ་དང་བཅུ་དང་བཅུ་གཅིག་དང་བཅུ་གཉིས་ཀྱི་ཨང་ཀ་རྣམས་སོ།",
    "ད་ནི་འདི་རྣམས་ཀྱི་འཆི་བའི་མཚན་མ་ལས་བྱུང་བའི་བསླུ་ཉྫུབའི་མན་ངག་གི་རབ་ཏུ་སྦྱོར་བ་གསུངས་པ།",
    "རྡོ་རྗེ་འོད་ཀྱི་འཆད་པར་འགྱུར་བའི་མིང་གི་ཡི་གེ་རྣམས་སོ།",
    "རྡོ་རྗེའི་ལམ་ནི་ཨ་ཝ་དྷཱུ་ཏཱིའི་ལམ་ནས་སོན་པ་སྟེ་སྲོག་གི་ཚོགས་ཐམས་ཅད་དོ།",
    "སླར་ཡང་བའི་ཡི་གེ་ལ་སོགས་པ་རེ་རེའི་དོན་གསུངས་པ།",
    "དེས་དངོས་པོ་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་རྣམ་པར་གནས་ཏེ་ཇི་ལྟར་སྲོག་དང་སེམས་འབབ་པ་དེ་བཞིན་དུ་ཐམས་ཅད་དུ་བ་ཐག་གི་བགྲོད་པ་དེ་ཐོབ་པར་བྱའོ།",
    "རང་གི་སྔགས་དང་རྒྱུད་རྣམས་སུ།",
    "དེ་ལྟར་གང་གིས་རབ་ཏུ་སྦྱོར་བས་ཞེས་བྱ་བ་ནི་སླར་ཡང་དེ་ལྷ་ལ་སོགས་པ་གང་གི་རབ་ཏུ་སྦྱོར་བས་འགྲུབ་ཅེས་དྲིས་པའོ།",
    "ལྷ་ལ་སོགས་པའི་སྒྲུབ་ཐབས་ལ་ཁྱོད་ཀྱིས་སྒྲུབས་ཤིག་ཅེས་བྱ་བ་དགོངས་པའི་དོན་ཏོ།",
    "དེའི་མ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "མ་མོ་ཞེས་བྱ་བ་ནི་ཚངས་པ་མོ་ལ་སོགས་པ་བརྒྱད་རྣམས་སོ།",
    "རིག་༢པའི་སྔགས་ཞེས་བྱ་བ་ནི་སྔགས་ཉིད་རིག་པ་སྟེ་མཆོག་ཏུ་དེས་སྒྲུབ་པ་སྟེ་སྲིད་པ་དག་པས་ཞེས་བྱ་བ་ནི་སྲིད་པའི་དག་པ་སྟེ་གང་གིས་རྣལ་འབྱོར་རྣམས་འགྱུར་བའོ།",
    "ནང་གི་བདག་ཉིད་དུ་ནི་དོན་ཇི་ལྟ་བའོ།",
    "འདི་ལྟར་བདག་གིས་གཞུང་ཆེ་བའི་འཇིགས་པས་མ་བརྗོད་དོ།",
    "དེ་ལ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རི་མོ་ཟླུམ་པོ་གསུམ་སྦྱིན་ཞེས་བྱ་བའོ།",
    "རྩེ་མོ་གསུམ་པའི་རྡོ་རྗེའི་རྣམ་པ་འོག་དང་སྟེང་དུ་རྩ་རྣམས་ཏེ་རྩའི་ཕོ་ཉ་དྲུག་རྐང་པ་དྲུག་གིས་འགྲོ་བ་ཅན་གཡོན་པ་དང་གཡས་པ་ནས་སོ།་།",
    "རཱ་ཧུ་དང་ཀེ་དུ་དང་དུས་མེ་ནི་འོག་གི་ཆ་རྣམས་སུའོ།",
    "དེ་ལྟར་རྡོ་རྗེའི་དོན་ནི་སོང་ཟིན་ཏོ།",
    "ལྷག་མ་སྔགས་ཀྱི་ཡི་གེ་རྣམས་ལས་བྱུང་བ་ནི་རང་རང་གི་མིང་གི་ཡི་གེ་དང་པོ་ལས་ཏེ།",
    "གཟའ་ལྷག་གི་ཆུའོ།",
    "ཀེ་ཏུ་དང་ཟླ་བ་དག་གི་གཟའ་ལྷག་ཇི་ལྟ་བའོ།",
    "དེ་ཐམས་ཅད་རང་གི་དམ་ཚིག་ལས་བྱུང་བ་སྟེ་ནང་གི་བདག་ཉིད་དུ་རང་རང་གི་དཀྱིལ་འཁོར་ལས་བྱུང་བའོ།",
    "དེའི་ཕྱིར་རེ་རེ་བསྒྲུབ་པར་བྱ།",
    "ཞེས་བྱ་བ་ནི་པདྨའི་དབུས་སུ་རང་རང་གི་འཆར་བའི་དུས་རྣམས་སུ་གཙོ་བོ་བྱ་བ་སྟེ་འདིས་ཀུན་དུ་སྤྱོད་པ་ཡང་གསུངས་པའོ།",
    "ཁང་སྟོང་དང་ནི་འཐབ་མོའི་གནས།",
    "གནས་གཞི་རང་གི་ཁྱིམ་དེ་བཞིན།",
    "རྡུལ་ཅན་མཆོག་ཅེས་བྱ་བ་ནི་རང་བྱུང་༧གིས་ཡོངས་སུ་གང་བའི་ཐོད་པའོ།་།",
    "བདེ་བའི་རྒྱལ་པོ་ཞེས་བྱ་བ་ནི་བདེ་བས་མཛེས་ཤིང་འབར་བས་ན་འདིས་ཞེས་བྱ་བ་ནི་བདེ་བའི་རྒྱལ་པོ་དཔལ་རྡོ་རྗེ་ཐུམཁའ་འགྲོ་དང་མཉམ་པའི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་ཕག་མོ་ལ་སོགས་པས་སད་པར་བྱེད་པ་སྟེ།",
    "ཀྱེ་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མ་ཐམས་ཅད་གང་སྤྱོད་༥ཀྱིས་འདྲི་བའི་དུས་དེ་ནི་ཁྱོད་ཉིད་ཀྱི་གཟུགས་ཅན་ནི་འདིའི་དུས་ཏེ།",
    "དེ་ལྟར་འཇིག་རྟེན་པའི་ནི་འཇིག་རྟེན་གྱི་རང་གིས་སོ་སོར་སྣང་བར་འགྱུར་བའི་༤དུས་ཙམ་སྟེ་དེ་དེ་བཞིན་དུ་གསུངས་སོ།",
    "ས་བོན་རྣམས་སུ་མཚན་ཉིད་ཅེས་བྱ་བ་ནི་རང་གིས་༧རིག་པའི་ས་བོན་གྱི་མྱུ་གུ་ཅན་དུ་རྣམ་པར་བརྗོད་དོ།",
    "འདིར་ཡི་གེ་རེ་རེའི་བརྗོད་པར་བྱ་སྟེ།",
    "མོ་བུ་མ་ཞེས་བྱ་བ་ནི་མོ་ཧི་ཏ་དང་གཟའ་ལྐུལྷག་དང་མཆུ་སྟེ་ཚེས་གྲངས་དེ་ནི་བཟང་པོའི་རིགས་བཀྲ་ཤིས་པར་འགྱུར་རོ།",
    "ར་བུ་ཨ་ཞེས་བྱ་བ་ནི་ཡུགས་ས་མོ་དང་གཟའ་ལྷག་དང་གལ་ཏེ་བྱེ་དེ་དེ་བཞིན་ནོ།",
    "དེ་ལྟར་སླར་ཟླ་བ་དང་ཉི་མ་འབྱུང་པོའི་རི་མོ་ཞེས་བྱ་བ་ནི་ཟླ་བ་བགྲོད་པ་དང་ཉི་མ་བགྲོད་པའི་གྲིབ་མ་ཡོངས་སུ་འཛོམ་པས་བུ་བཞིན་དུ་སྟེ་མཉམ་པའི་ལྟ་བར་འགྱུར་རོ།",
    "ཞེས་བྱ་བའི་གཏུམ་མོའི་ནང་དུ་སོན་པའི་དཀྱིལ་འཁོར་འཁོར་ལོ་སྔོན་ལྟ་བུ་དེའི་གཟུགས་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་དེ་བཞིན་དུ་གསུངས་སོ།",
    "ཇི་ལྟའི་བདག་གི་བློ་ཡོད་པས།",
    "རྡོ་རྗེའི་གར་ཞེས་བྱ་བ་ནི་སྒེག་པ་ལ་སོགས་པ་གར་གྱི་ཉམས་དགུ་རྣམས་དང་ལྡན་པ་སྟེ་བྱས་ནས་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་རྡོ་རྗེ་སེམས་དཔའ་ལ་དེའི་ཚེ་དྲི་བ་འདི་གསུངས་པ་སྟེ།",
    "གང་གི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱི་ཚིག་གིས་སོ།",
    "ཉོན་ཞེས་བྱ་བ་ནི་ཁྱེད་ཕག་མོ་ལ་སོགས་པ་ཐོས་པ་ལ་སྤྱོར་བའོ།",
    "རེ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདིར་གང་གི་ཚེ་སྒྲུབ་ཐབས་གཅིག་བསྒོམས་པར་གྱུར་པའམ་རྣལ་འབྱོར་མའི་མན་ངག་ཀྱང་རུང་དེའི་ཚེ་མཐའ་མེད་པའི་རྣལ་འབྱོར་རྣམས་སུ་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་སེམས་ཀྱི་རྒྱུན་གཅིག་ཀྱང་གཟུགས་མང་པོར་འབྱུང་ངོ།་",
    "སྒྲ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དོན་དམ་པ་ནང་གི་བདག་ཉིད་ཀྱི་དྲིལ་བུ་བསྒྲུབས་ནས་ཞེས་བྱ་བ་ནི་དེ་ལ་ཡང་དག་པར་བརྟེན་ནས་བདེ་བ་དམ་པར་གྱུར་པ་ཉིད་ཀྱིས་ནཱ་དའོ།",
    "དེ་ལྟར་རྩེ་མོ་དགུ་པ་ཞེས་བྱ་བ་ནི་རྩེ་དགུའི་བདག་ཉིད་ཅན་ནོ།",
    "དང་ནིའི་ཡི་གེས་རྩེ་མོ་གཉིས་པ་སྟེ་འོག་དང་སྟེང་དུ་འབབ་པ་ཅན་ནོ།",
    "རྩེ་མོ་གསུམ་པ་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་བདག་ཉིད་ཅན་ནོ།",
    "གང་གི་བྱེད་པ་གང་དག་བྱུང་།",
    "གང་གིས་ཐུརྟག་ཏུ་འཚོ་བར་འགྱུར།",
    "རང་གིས་རིག་པའི་མངོན་སུམ་མོ།",
    "དེ་ནི་དེ་ཉིད་ཡང་དག་འབྱུང་་། མངོན་སུམ་དང་ནི་རྗེས་དཔག་གིས།",
    "གཏུམ་མོ་སྟོང་ཕྲག་ཞལ་ཅན་གྱི།",
    "དེ་ཡང་དཔའ་བོ་ཆེན་པོའི་སྦྱོར་བས་ཞེས་བྱ་བ་ནི་མིང་གི་ཡི་གེའི་རིག་པ་སྟེ།་",
    "དེ་ལྟར་ཉོན་ཞེས་བྱ་བ་ནི་ཕག་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་ཐམས་ཅད་ཐོས་པ་ལ་ངེས་པར་སྤྱོར་བའོ།",
    "གང་རྣམས་དེ་རྣམས་ཀྱི་རེ་རེ་ལ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་འགྱུར་གྱིས་སྟོང་ཕྲག་གཅིག་ལ་ཉི་ཤུ་རྩ་བཞིས་ལྷག་པ་རྣམས་སུ་འགྱུར་རོ།",
    "དེ་རྣམས་ཀྱི་ཕྱི་མོ་རྣམས་ཀྱིས་དབྱེ་བ་ཁྱེཞེས་བྱ་བ་སྟེ།",
    "དེ་ལྟ་ར་འབར་བ་ཚིགས་ཐམས་ཅད་དུ་གནས་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་་རང་གི་སེམས་ཀྱིས་བལྟས་པར་གྱུར་པས་འོད་ཀྱི་རང་བཞིན་གྱི་ཡི་གེ་གཏུམ་མོ་སྟོང་ཕྲག་གི་བདག་ཉིད་ཅན་ཞེས་བྱ་བ་སྟེ།",
    "ད་ནི་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་རང་གི་ལུས་ཀྱི་བཅུད་ལེན་སྒྲུབ་པའི་ཆོ་ག་གསུངས་པ།",
    "ཅིའི་གཟུགས་ཀྱིས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཆང་གི་གཟུགས་ཀྱིས་སོ།",
    "འདིར་གང་གི་བྱེརྡོ་རྗེ་སེམས་དཔའ་སོ་སོར་སྣང་བར་མཛད།",
    "ཞེས་བྱ་བ་ནི་འདིར་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཏིང་ངེ་འཛིན་ལ་རྗེས་སུ་སྤྱོད་པའི་དུས་སུ་སེམས་དང་ལྷན་ཅིག་རང་གིས་རིག་པར་འགྲོའོ།",
    "ནང་གི་བདག་ཉིད་དུ་ཤིན་ཏུ་བཟང་པོའི་ཡི་གེའི་རབ་ཏུ་སྦྱོར་བ་གསུངས་པ།",
    "དེ་ལྟར་བྷའི་ཡི་གེའི་དོན་སོང་ཟིན་པས་སོ།",
    "ཞེས་བྱ་བ་ནི་དེ་བྱེཡང་རང་གི་སེམས་ཞུ་བའི་གཟུགས་སོ་སོར་མི་སྣང་ངོ།",
    "སྨིན་དྲུག་དང་མཆུ་དང་སྐག་དང་མོན་གྲུ་དང་ནག་པ་དང་ས་ག་དང་སྤྱོན་འུདང་སྣྲུབས་༧དང་མོན་གྲེ་མཆོག་གོ།",
    "དེ་བཞིན་དུ་སྟོབས་ཀྱིས་བདག་ཏུ་བྱེད་པར་ཕྱི་མ་ཕྱི་མར་གང་གི་ཚེ་མི་རྣམས་ལ་འགྱུར་བ་དེ་རྣམས་ཀྱི་རིགས་ཀྱི་ཁྱད་པར་གསུངས་པ།",
    "བཅུ་བཞི་པ་དང་བཅུ་དྲུག་པ་དེ་ནག་པ་དང་ས་ག་ནི་སྟག་གི་རིགས་སོ།་།",
    "བཅུ་གཉིས་པ་དང་བཅོ་ལྔ་པ་དེ་དབོ་དང་ཁྲུམས་སྟོད་ནི་ཁྱུ་མཆོག་གི་རིགས་སོ།་།",
    "ཉི་ཤུ་རྩ་གསུམ་པ་དང་ཉི་ཤུ་རྩ་བཞི་པ་དེ་ནི་མིའི་རིགས་ཏེ་མོན་གྲུ་དང་མོན་གྲེའོ།",
    "ཉི་ཤུ་རྩ་གཅིག་པ་ཆུ་སྨད་ནི་སྲིན་མོའི་རིགས་ཏེ།",
    "རྒྱུ་སྐར་སྲོག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ་གང་ཞིག་གང་གི་རྒྱུ་སྐར་གྱི་མིང་རྣམས་ཀྱི་དེ་རྣམས་སུ་དེའི་སྲོག་ཏུ་རབ་ཏུ་ཐོབ་བོ།",
    "ཞེས་བྱ་བ་ནི་འདི་ལ་གང་གི་ཚེ་རྒྱུ་སྐར་གནས་པའི་ཉི་མ་དང་མུན་པ་ཐོག་མར་བྱས་ནས་ཕྲེང་གསུམ་རྣམས་གཞག་པར་བྱ་སྟེ་དགུ་པོ་གསུམ་གྱི་བར་དུའོ།",
    "རྩེན་ཞེས་བྱ་བ་ནི་རྩེད་མོ་ཙམ་དུའོ།",
    "འཇིགས་བྱེད་ཆེན་པོའི་སྤྱོར་བས་ཞེས་བྱ་བ་སྟེ་འཆད་པར་འགྱུར་བའི་མིང་གི་ཡི་གེའི་དངོས་པོས་སོ།",
    "ས་རྣམས་ཀྱི་དུམ་བུ་ཅན་གནས་རྣམས་ཞེས་བྱ་བ་ནི་དེ་ལ་དང་པོ་འཁོར་ལོ་དྲུག་གི་རྣམ་པའི་རི་མོ་ཟླུམ་པོའི་རྣམ་པར་བྱའོ།",
    "དེ་རྣམས་རེ་རེ་ལ་ལེའུ་ཚེ་བརྒྱད་བརྒྱད་རྣམས་བྱའོ།",
    "དེ་ལ་རྐང་པ་བཞི་བཅུ་རྩ་བརྒྱད་བྲི་བར་བྱའོ་ཞེས་བྱ་བ་སྟེ་རེ་རེར་ངུརེ་རེ་འཆད་པར་འགྱུར་བའི་རིམ་པས་སྔགས་ནི་ཐམས་ཅད་དུ་རྐང་པ་རྐང་པ་རྣམས་ལེའུ་ཚེ་ལེའུ་ཚེ་རྣམས་སུ་བྲི་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྔགས་ཀྱི་ཡི་གེ་དེ་རྣམས་ཀྱི་སྲོག་གི་གཟུགས་སུ་ཡང་སྐྱེས་པར་གྱུར་པ་ནི་ཐིམ་པར་བྱའོ།",
    "དེ་རྣམས་སུ་གང་ཞིག་གང་གི་བྱེམིང་གི་ཡི་གེ་སྔོན་དུ་སོང་བ་སྟེ་སོགས་པའི་སྒྲས་སྣ་ཚོགས་པའི་སྔགས་རྣམས་སུ་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་དེ་རབ་ཏུ་སྦྱར་བར་བྱའོ།",
    "སེམས་ལ་སོགས་པའི་བཟླས་པ་ཞེས་བྱ་བ་ནི་སེམས་དང་ཡེ་ཤེས་དང་ལུས་དང་ངག་གི་བཟླས་པའོ།",
    "གཏུམ་མོའི་གཟུགས་ཀྱིས་སོ།",
    "ཐམས་ཅད་ལ་རིམ་པ་ཇི་ལྟ་བས་རྐང་པ་རྣམས་རེ་རེའི་མཐར་སྦྱར་བར་བྱའོ།",
    "དེ་ཡང་མིག་མི་བཟང་གི་རབ་ཏུ་སྦྱོར་བ་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་མིང་གི་ཡི་གེའི་རབ་ཏུ་སྤྱོར་བས་སོ།",
    "དེར་མིག་གིས་བལྟ་བར་བྱ་ཞེས་བྱ་བ་ནི་ནོར་བུའི་ཞེསྒུད་པ་ལྟ་བུར་སེམས་ཀྱིས་མིག་ཤེས་པར་བྱའོ།",
    "སྐྱེ་འགྲོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་འདིར་གང་གི་ཚེ་སྐྱེ་འགྲོའི་ནང་དུ་སོན་པའི་གཟུགས་སུ་འགྱུར་ཏེ་དེའི་ཚེ་ཡིད་ཀྱིས་སྒྲ་ཉན་ནོ།",
    "གང་གི་ཚེ་ཡིད་ཀྱི་དངོས་པོ་ཡུལ་ལ་འགྲོ་བར་འགྱུར་ཏེ་བརྟེན་པ་ཉིད་ཀྱི་ཕྱིར་ཡུལ་ལས་སྤངས་ནས་འོང་བའོ།",
    "རེག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདིར་ཡང་གང་གི་ཚེ་ཡིད་ཀྱི་༡དངོས་པོ་ཐམས་ཅད་རེག་བྱའི་རྣམ་པ་ཉམས་སུ་སྩོང་བར་བྱེད་དོ།",
    "རེག་བྱའི་ས་ཞེས་བྱ་བ་ནི་མཆོག་ཏུ་ཟག་པ་མེད་པར་འགྱུར་རོ།",
    "སྔོན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་གང་གིས་༣༧ཚེ་འདིར་ཡིད་ཐམས་ཅད་དུ་འགྲོ་བ་དང་བྲལ་བ་དག་དང་འདིར་ཐམས་ཅད་དུ་མི་འོང་བ་དག་མ་ཡིན་པ་དག་སྟེ་དེའི་ཕན་ཚུན་རང་བཞིན་ཉིད་ལགས་མིསོ།",
    "དཀྱིལ་འཁོར་གང་རྒྱུ་བ་དེ་དག་གི་ཚུལ་རྣམ་པར་དག་པའི་དབུགས་རྒྱུ་བ་ཅན་ནོ།",
    "དེ་ལྟར་འདིའི་མིང་གི་ཡི་གེ་རྣམས་ཀྱིས་བྱུརབ་ཏུ་སྦྱོར་བའི་ཁྱད་པར་གསུངས་པ།་",
    "ཁྱོན་ཅིག་སྦྱིན་སྲེག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ་མཁས་པས་ཞེས་བྱ་བ་ནི་གོ་བར་གྱེས་ཤིག་པའོ།",
    "དམོད་པ་འདོར་༤བ་རྗེས་སུ་འཛིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཧའི་ཡི་གེའི་དོན་ཏོ།",
    "གང་གིས་ཨ་ཝ་སྒྲུ་ཏཱི་པ་འཛིན་པ་ཐམས་ཅད་ཡོངས་སུ་སྤངས་ནས་གནས་པའི་རྣལ་འབྱོར་པ་རྣམས་ལ་དངོས་གྲུབ་ཏུ་འགྱུར་རོ།",
    "རྟ་མགྲིན་གྱི་རབ་ཏུ་རི་སྦྱོར་བས་ཞེས་ཤྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་མིང་གི་ཡི་གེ་རྣམས་ཀྱི་རྔུབསྒྲུབ་པར་བྱ་བ་སྟེ།",
    "དེ་ཉིད་ལྷ་མ་ཡིན་ཞེས་བྱ་བ་སྟེ་བདག་མེད་པའི་རྣལ་འབྱོར་མ་ལྟར་དེ་ཉིད་ལྷ་མ་ཡིན་གྱི་བུ་མོ་སྟེ་དེ་དང་ལྷན་ཅིག་རོལ་བ་འགྱུར་བས་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་མཆོག་ཏུ་གཉིས་སུ་མེད་པའི་སྦྱོར་བར་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟར་རང་གི་རང་བཞིན་ཅན་སྐྱེས་འཛག་ཅེས་རྒྱབྱ་བ་ནི་ཐ་མལ་པ་རྣམས་ལ་སྡུག་བསྔལ་ལ་སོགས་པ་འཛག་པའོ།",
    "ད་ནི་ཡི་གེ་རེ་རེ་རྣམས་ཀྱི་ངེས་པའི་ཚིག་ཛེེགསུངས་པ།",
    "ནམ་མཁའ་ཞེས་བྱ་བ་ནི་རང་གིས་རིག་པའོ།",
    "རང་རིག་རང་བཞིན་ཁྱབ་བདག་གི།",
    "དེ་ནས་ལྷ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་རབ་ཏུ་སྦྱོར་བས་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའི་མིང་གིས་གེ།",
    "རྣལ་འབྱོར་ཟླ་བའི་བགྲོད་པ་རང་གི་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་ཟླ་བའི་དཀར་པོའི་ཚེས་གཅིག་ལ་སོགས་པར་ཆ་འཕེལ་ལོ།",
    "བེེར་ཀྱེཡང་འདིའི་རིམ་པ་ཇི་ལྟ་བས་ཡི་གེ་རེ་རེའི་དོན་གསུངས་པ།",
    "འདིར་གང་གི་ཚེ་བསྟན་བཅོས་ཐམས་ཅད་དུ་རྣམ་པར་སྣང་མཛད་གཟུགས་ཀྱི་ཕུང་པོར་གསུངས་སོ།",
    "དེའི་ཕྱིར་མིང་གི་ཡི་གེ་རྣམས་ཀྱིས་གསུངས་པ།",
    "དེ་ལྟར་རོའི་ཡི་གེའི་དོན་གྱིས་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་བ་སྤུའི་ཁུང་བུའི་རྩེ་མོ་ལས་བརྟན་པ་དང་སྐྱེ་འགྲོ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱི་གཟུགས་སུ་ངེས་པར་འགྲོ་བ་སྟེ།",
    "མི་བོ་མི་མོ་ལ་སོགས་པ་ནི་རྐང་གཉིས་དང་རྐང་བཞི་རྣམས་ཀྱི་དང་འདི་རྣམས་ཐམས་ཅད་ཀྱི་གཟུགས་སུ་སྟེ་ཇི་ལྟར་པདྨའི་འདབ་མ་ལ་ཆུས་མི་གོས་སོ།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཡེ་ཤེས་ཡོངས་སུ་བསྒོམས་པས་ན་རང་གི་བདག་ཉིད་ཡོངས་སུ་ཤེས་པ་ཙམ་གྱེས་ཀྱང་བག་ཆགས་དང་བཅས་པས་འཆིང་བ་སྟེ།",
