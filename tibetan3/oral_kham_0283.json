    "སློབ་དཔོན་ལྷའི་འདུག་སྟངས་སུ་གནས་པས།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལག་ན་འདུག།",
    "འདི་ལ་བསྟན་པ་གཏད་དོ་ཞེས་ཅ་ཅོར་སྨྲ་བར་བྱུང་ཡོད་པར་འདུག་ལ།",
    "གསེར་གསོལ་རན་ཙ་ན།",
    "ཐབ་ཁ་དང་བང་རྣམ་རྒྱལལེའི་ཁྲིགས་མལ་རྣམས་བྱས་ཙ་ན།",
    "དེ་འདྲ་མ་བསམ་པར་རྐོས་ཤིག་ངས་རྐོས་ཟེར་ན་བྲག་ལ་བརྐོས་ཀྱང་ཕེད་གསུངས་པས་བརྐོས་ཙ་ན།",
    "ཡང་ཁོས་སྐུ་སྐེད་ཀྱི་གཅོང་དེ་སོས་འདུག་ཤ།",
    "ཨིཏྟཾགསོལ་བ་ཨེ་ཡིན་སྙམ་ཙ་ན།",
    "གདུང་མ་ལ་ལྕགས་ཕུར་ཨ་ལོང་ཅན་སྔར་ནས་བཏབ་འདུག་པ་དང་འགྲིག་སྐུ་འདའ་བའི་དགུན་དེ་ཀ་བཅུར་སིག་ལྐོགས་མང་པོ་ཡོང་བ་ལ་ཕྱག་འཁར་གཏད་ནས།",
    "བཀྲ་ཤིས་དཔལ་འབར་གྱི་སེང་ཁྲིའི་པདྨ་ཕྱིན་མ་ཚར་འདུག་པས།",
    "ཁོང་རང་གཅིག་པུར་བྱོན།",
    "རི་ཤིན་ཏུ་ཆེ་བ་གཉིས་ཀྱི་བར་དུ་ཆུ་བོ་འབབ་པ་རིའི་རྐེད་པ་ཙམ་ནས་སྦ་ཟམ་གྱིས་སྦྲེལ་བ་གཅིག་འདུག་པ་སོགས་ལ་བདེ་བར་བྱོན།",
    "ས་ལ་དོང་གྲུ་བཞི་པ་སྒོ་ཙམ་ཞིག་སྣང་བ་དེའི་ནང་དུ་མཁའ་འགྲོ་མའི་གནས་བང་མཛོདབརྒྱད་ཡོད་བྱ་བ་ཞིག་འདུག་པ་སོགས་ལ་ཚོགས་བརྒྱ་བཏང་།",
    "ཕྱག་ཕྱིར་མུ་སྟེགས་ཀྱི་སྟོན་པ་གཅིག་སྣ་ཁྲིད་ལ་ཡོད་པས་ནམ་མཁའ་ལ་ཆར་སྤྲིན་ཡང་ཀླུའདུག་ད་བྱོན་པ་དྲག་ཟེར།",
    "ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་ཙ་ན་དུས་གསུམ་གྱི་ཤེས་བྱའི་དཀྱིལ་འཁོར་མ་ལུས་པ་ཡིད་ལ་གསལ་བར་འཆར་གྱིན་ཨིཏྟཾསྣང་ཡང་མ་སྨྲས་གསུངས།",
    "ལར་སྔོན་གྱི་བག་ཆགས་ཀྱིས་ཇི་ལྟར་བྱས་ཀྱང་བདེ་བར་གདའ།",
    "ད་ལྟ་ཡང་ཁོ་བོ་ལས་ཞེན་པ་ཆེ་བ་མི་གདའ་ངེས་དོན་འདི་ལ་འབད་རྩོལ་མ་བྱས་ཀྱང་ནང་ནས་ལྷུན་གྲུབ་ཏུ་འཆར་བར་སྣང་།",
    "འཞིང་དམིགས་པ་གསལ་བར་གདའ་གསུངས་ནས་བསྐྱེད་རིམ་གྱི་གཙོ་བོ་བདེ་མཆོག་ལ་མཛད།",
    "ད་བང་མཛོདརང་མི་འཕྲད་པར་འདུག་རྒྱ་མ་བ་རང་ལའང་ཅི་འདྲ་ཡོང་མི་ཤེས་གསུངས་པའི་ཕྱི་ལོ་རྒྱ་མ་བ་ལ་ནང་ཟིང་བྱུང་ཞིང་སི་ཏུ་བ་འདས།",
    "གཟིམས་གུར་སྒྲིལ་གྱིན་ཡོད་ཙ་ན།",
    "བུམ་པ་དེའི་ལུང་ཐག་ཆད་ནས་བྲུལ་ལ་ཁད་ཡོད་པ་དེ་ཐུགས་ཀྱིས་མཁྱེན་པར་འདུག་པས་བརྗེས་ཤིག་གསུངས་པ་ལྟར།",
    "སྐབས་ཤིག་བོད་ཀྱི་རྒྱལ་ཁམས་འདི་ལ་མ་རུངས་བ་ཆེན་པོ་ཞིག་འོང་བར་གདའ་གསུངས་ནས་སྐུ་རིམ་ཆེན་པོ་མཛད།",
    "གཙུག་ཏོར་གྱི་གཏོར་མ་དེ་འགྱེལ་བར་ཨེ་འདུག་གསུངས།",
    "སྟོན་དུས་ཤར་ནས་འགྲུལ་ཚན་ཆེན་པོ་གཅིག་འདུག་པའི་སྣ་ལ་མི་མ་ཡིན་གདུག་པ་ཅན་ཞིག་སྣང་ཨཉྙོགསུངས་ནས་སྐུ་རིམ་བཙུགས་པས་ཞག་འགའ་ན་ཏཱ་ཞིང་གཉིས་ཀྱི་མགོས་བྱས་པའི་རྒྱ་འགྲུལ་ཆེན་པོ་བྱུང་།",
    "ད་ལམ་ཐུགས་བྲེལ་གྱི་སྟབས་སོགས་ནས་ཡུན་རིང་དུ་བཞུགས་པར་ཞུ་མི་ནུས་པར་འདུག་རྟིང་སོར་ཉམས་ཁྲིད་གཅིག་སྩོལ་བ་ལ་གདན་འདྲེན་གཏོང་བས་ཅིས་ཀྱང་ཕེབས་པར་ཞུ་གསུངས་ཀྱང་ཞལ་བཞེས་མ་གནང་གོང་མས་བྱ་ས་གདོང་བར་སྐྱེལ་ཐུང་མཛད།",
    "ཡར་བྱོན་པ་མིག་དང་འདྲ་ཟེར་བ་གདའ་སྟེ་ཁྱག་པ་ཆེ་བ་དང་།",
    "ཤེལ་ཁ་དོག་སྣ་ཚོགས་པ་སོགས་ཀྱི་ཞ་པ་ཕུར་མ་ཆུང་དུ་གདའ་བ་བདག་བྱིས་པའི་སྐབས་སུའང་མཐོང་།",
    "འདུག་སྟངས།",
    "གསོལ་མཛོ་མ་བོར་ན་ཅུང་ཟད་མཉམ་པར་བཞག་སྟེ་འདིར་འདུག་གསུང་བ་དང་།",
    "ཁོ་རང་མི་ཉག་རལ་པ་ཅན་དང་གུར་དཀར་མ་རང་གཟུགས་སུ་བགྱིས་ཏེ་འཁོར་དང་བཅས་པས་སེམས་བསྐྱེད་ཞུས།",
    "བརྒྱད་སྟོང་པ་ལ་རྒྱ་དཔེ་གསུམ་ལ་བརྟེན་ནས་བཅུ་ཐམ་པ་རྔོག་འགྱུར་ལ་གཞི་བླངས་ཏེ་བེ་རོ་ཙ་ན་ལ་སོགས་པའི་འགྱུར་གཞན་ལྔ་ལ་གཏུགས་ནས་ཞུས་ཆེན་མཛད།",
    "། སྐབས་ཤིག་ཏུ་གདུགས་དཀར་གྱི་རྒྱུན་བཙུགས་པས་མནལ་ལམ་ངོ་མཚར་བ་ཞིག་བྱུང་སྟེ་བསྙེན་སྒྲུབ་ཆེད་དུ་མ་བྱས་ཀྱང་རྗེས་སུ་འཛིན་པར་འདུག་གསུངསབརྒྱ།",
    "འདི་འབྲི་གུང་པའི་གཞི་བདག་ཏུ་འདུག་གསུངས།",
    "གཞིས་ཀ་སྣེལ་པ་དེ་སྔོན་མི་གུས་ཀྱང་དེ་ཙ་ནས་ཡོན་མཆོད་འབྲེལ་ཟབ་ཏུ་གྱུར།",
    "ང་རང་མིང་འཇིག་རྟེན་འགྲོ་བའི་མཆོག་ཟེར།",
    "ད་ཡར་ཤོག་གསུངས་བས་སྤྱན་སྔར་ཕྱིན་ཙ་ན་ཐབ་དང་སྣོད་སྤྱད་གང་དགོས་ཐམས་ཅད་འདུག་པས་ནོར་བཞི་། གསོལ་ཇ་བསྐོལ།",
    "བརྒྱ་ཉིན་གཅིག་གཟིམས་མལ་ན་བསྙལ་བ་ཁྲུ་དོ་ཙམ་གྱི་ནམ་མཁར་འཕགས་ནས་རླངས་ཕྱུ་རུ་རུ་འདུག་བཙས་ནས་མི་རིང་བར་གསུང་བྱོན།",
    "སྐུ་མི་སྣང་མཚན་ནས་བོས་ཙ་ན།",
    "ཡུམ་དཔོན་གཡོག་སྤྱན་སྔར་ཕྱིན་ཙ་ན།",
    "གཞན་ཡང་དབུ་ལ་གཙུག་ཏོར་གདའ་བ་དང་།",
    "གསུང་གླེང་མཛད་ཀྱིན་ཕྱག་མགྱོགས་པ་འདི་བཞིན་མཛད་པ་ལ་ནོར་བ་ཡོང་ངམ་བསམ་ཙ་ན།",
    "དབས་ཀྱི་ཚོང་འདུས་ལྟག་ནས་ཕྱིར་བྱོན་ཙ་ན།",
    "ཁྱེད་ཀྱི་ཇོ་སྲས་ཀྱི་ཁར་རྡོ་རྗེ་འཇོག་པར་འདུག་གསུངས།",
    "ཕ་ཟད་དུ་སྤོས་ཙ་ན་སྔ་མའི་མལ་དུ་རྦབ་ཆེན་པོ་བྱུང་།",
    "ཡུལ་གཅིག་ཏུ་བཀྲ་ཤིས་རྣམ་རྒྱལརྒྱལ་མཚན་གྱི་བུ་ཡིན་ཟེར་བ་བུ་ཚ་རལ་བུ་ཅན་ཞིག་འདུག་དཔའ་བོ་དང་མཁའ་འགྲོ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབས་པ་ཞིག་ཡིན།",
    "འདིར་བསྡད་ན་ཚེ་རིང་པོ་མི་འོང་བ་འདུག་གསུང་བ་ལ།",
    "ཉམས་སུ་ལེན་པ་ཁྱེད་རང་རྣམས་གཉེར་ཆེ་བ་ཡིན།",
    "ས་སྟོང་འདིར་མི་སུས་འཕྱ་ཞུས་ཙ་ན།",
    "ད་ཁྱེད་རང་སྒོ་གྱིས་གསུངས།",
    "ཕྱི་ནང་གུར་གྱི་ཀ་བ་ལ་ཁྲག་བསྒོས་འདུག་པ་རིག་ལོ་དེ་ཉིད་ཀྱི་ཁོངས་སུ་ཚེའི་དུས་བྱས།",
    "གཞན་ལ་གནོད་པ་ཞི་ནས་ཐམས་ཅད་ཐར་བ་ཡིན་ཟེར་ནས་འགྲོ་ཡིན་འདུག་སྐད་དོ།",
    "གསལ་ཞེས་མཛེས་ཞེས་ཞད་ཅིག་གདའ།",
    "ཡང་སྦྱར་ཡུལ་ལ་མི་ལྟོས་པར་ཡང་རང་ཉིད་ཀྱི་བརྗོད་དོན་གསལ་བར་མཚོན་པ་ཅན་གྱི་ཕྲད་ནི།",
    "ཡང་ན་འཆད་དུས་འཇུག་དུས་ཀྱི་བརྗོད་བྱ་མཆིས་པའང་ཡུལ་གྱི་ཞར་བྱུང་དུ་རྣམ་པར་གཞག་གོ།",
    "འབྲི་མཁན་ལ་ཁོ་རང་ཇི་ལྟར་འདོད་པའི་ཡོན་ཕབ་པ་བཞིན་སྦྱིན་པར་བྱའོ།",
    "ཉི་ཤུ་རྩ་ལྔ་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡི་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "མཐུན་པར་མི་དགོས་རང་རང་དབྱིབས་བཞིན་བྱ།",
    "དཔའ་བོའི་འདུག་སྟངས་ཞེས་བྱའོ།",
    "བཟོ་མཐའ་མ་འདྲེས་རང་རང་བརྒྱུད།",
    "བཞི་པ་རིགས་དང་མཐུན་པའི་རང་གནས་སུ་འདུག་ལྔ་པ་སློབ་དཔོན་འཁོར་ལོའི་མགོན་པོར་བསྐྱེད་ལ་གཞན་སྲས་ཀྱི་བྱ་བས་དཀྱིལ་འཁོར་རྫོགས་པར་སྤྲོས་ལ་བསྐུར་བརླབ་དྲང་བསྟིམ་མཆོད་བསྟོད་བྱ།",
    "བཞི་དྲུག་དུས་བཅུ་དངོས་པོ་བཅུ་བདུན་དང་།",
    "སྤྱོད་ལམ་གྱི་ཡལ་ག་རང་རང་དང་སྦྱར་བའི་གཉེན་པོ་གསུམ།",
    "འདི་དག་སོ་སོ་ལ་རང་རང་ལུགས་ཀྱི་གཞི་ལམ་འབྲས་བུའི་རྣམ་གཞག་གཞལ་བྱ་འཇལ་བྱེད་ཀྱི་རིགས་པ།",
    "ནང་པའི་ཐེག་དམན་ཉན་ཐོས་དང་རང་རྒྱལ་རྣམས་ཀྱིས་ཀྱང་དོན་དུ་གཉེར་བྱ་དང་བསྒྲུབ་བྱའི་མཆོག་ཡིན་ལ།",
    "ས་བོན་དང་རང་བཞིན་དེ་དག་ནི་ཕྱོགས་ཀྱི་གླང་པོའི་བཞེད་པའོ།",
    "བག་ཆགས་ལྷན་སྐྱེས་བློར་སྣང་རང་བཞིན་དང་།",
    "མེད་དང་ཡོད་དང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གཉིས་ཀྱིས་ནི་ཕྱོགས་ཙམ་ཡང་རིག་པ་མ་ཡིན་ནོ།",
    "ཁམས་གསུམ་གྱི་ས་དགུ་པོའང་རང་ས་དང་འོག་ས་དང་གོང་ས་གསུམ་མམ་འཆི་ས་དང་སྐྱེ་ས་དང་ས་གཉིས་ཀ་མ་ཡིན་པ་དང་གསུམ་དུ་འདུའོ།",
    "དེ་ཡང་རང་བཞིན་འོད་གསལ་དེ་ནི།",
    "རང་རང་ངོ་བོར་མི་བསླུ་བདེན་པར་བརྗོད།",
    "རང་རིག་གཞན་རིག་དུས་གསུམ་བཏགས་དངོས་སོགས།",
    "དེ་ཡང་གང་ཟག་སྟེ་ཕུང་པོ་དང་གཅིག་ཐ་དད་རྟག་མི་རྟག་སོགས་སུ་བརྗོད་དུ་མེད་ཀྱང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་དུ་འདོད་ལ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ཡིད་ལ་བྱེད་ལ་སྤངས་པ་དང་།",
    "དེའང་རང་རྒྱུད་པ་རྣམས་ནི་ཀུན་རྫོབ་ཀྱི་རྣམ་གཞག་འཇིག་རྟེན་པའི་ཐ་སྙད་ཀྱི་རྗེས་སུ་མི་འབྲང་སྟེ།",
    "སྐྱེ་མེད་དང་སྤྲོས་བྲལ་ལ་སོགས་པ་རྣམས་ཀྱང་རང་རྒྱུད་ཀྱི་དམ་བཅའ་འགོད་པ་མ་ཡིན་ཏེ།",
    "ཐ་སྙད་དུའང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ཁས་མི་ལེན་པ།",
    "ཐ་སྙད་དུའང་རང་རིག་ཁས་མི་ལེན་པ།",
    "གཞན་སྟོང་རང་སྟོང་ཀུན་རྫོབ་སྟོང་ཚུལ་དང་།",
    "དོན་དམ་བདེན་པའང་རང་བཞིན་མ་གྲུབ་པའི།",
    "དེའང་རང་བཞིན་གྱིས་འོད་གསལ་བ།",
    "གལ་ཏེ་ཉམས་ནའང་རང་བཞིན་གྱིས་སྐོང་བར་འགྱུར་བའི་ཁྱད་པར་རོ།",
    "རྡོ་རྗེའི་གདན་ལ་འདུག་ནས་ནི།",
    "དེའང་རང་ཉིད་རང་རིགས་ཀྱི་ལྷ་དམ་ཚིག་པ་བསྐྱེད་པ་རྣལ་འབྱོར།",
    "དེའང་རང་བྱུང་ཞབས་ཀྱིས།",
    "མ་རྒྱུད་རིགས་དྲུག་མཐར་ཐུག་དུས་འཁོར་ཏེ།",
    "སྣང་བ་ཤར་ཙ་ན་མཆེད་པའི་རང་བཞིན་ཐིམ་པ་དང་།",
    "ཡིད་རྟོག་དང་རང་བཞིན་བརྒྱད་ཅུ་སོགས་ཕྲ་བ།",
    "ལུས་དང་རང་བཞིན་མེད་རྣམས་སོ།",
    "ཞེས་གསུངས་པའི་དང་པོ་རང་བཞིན་གྱི་དཀྱིལ་འཁོར་ལའང་རང་བཞིན་གྱི་དཀྱིལ་འཁོར་དང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པའི་དཀྱིལ་འཁོར་གཉིས་སུ་ཕྱེ་བས་བརྒྱད་དོ།",
    "དེ་ལྟར་ཡང་རང་ཤར་ལས།",
    "སྐུ་གསུང་ཐུགས་དང་རང་བྱུང་འོད་གསལ་གྱི་ནུས་པ་འཇུགབསྐྱེད་རིམ་དང་།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་ཅིང་གཏན་ལ་ཕབ།",
    "ས་གོས་དང་རྒྱན་དང་ཅོད་པན་དང་བདེ་བའི་སྟན་མཐོན་པོ་ལ་འདུག་སྟེ།",
    "དེ་ནས་ལེགས་པར་བརྟགས་ཤིང་ཤིན་ཏུ་མཉམ་པའི་སའི་ཆར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་རས་རིས་འུ་ལ་སོགས་པ་བརྩམ་ཡིཔར་འདོད་པའི་སྔགས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་སྔགས་པས་ཡོངས་སུ་བརྟགས་ཤིང་ཤིན་ཏུ་འཇམ་པའི་ས་ཕྱོགས་སུ་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དུས་སྦྱོར་བཟང་པོ་འཛོམ་པའི་ཉིན་ཞག་བཟང་པོ་ལ་ཁྲུས་དང་གཙང་སྦྲ་བྱས་ཏེ་གོས་དང་རྒྱན་བཟང་པོ་དབུ་རྒྱན་མེ་ཏོག་དང་བཅས་པས་གྲོགས་བཟང་བོ་དང་ལག་པ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པས་སྟན་ཐོག་མཐོན་པོ་འཇམ་པ་ལ་འདུག་སྟེ།",
    "ཞེས་བྱ་བས་བྱིན་གྱིས་བརླབས་པ་སྟེགས་བུའི་སྟེང་དུ་འདུག་སྟན་གཙང་མ་ལ་བཞག་ནས་དྲི་མ་སེལ་བ་རྣམས་ཀྱིས་དྲི་མ་བསལ་བར་བྱའོ།",
    "དེ་ནས་གོ་རོ་ཙ་ནའི་ཐིག་ལེ་བྱས་ཏེ་མེ་ཏོག་དང་བདུག་སྤོས་དང་།",
    "འདུག་ནས་གཏོར་མ་ཡང་དག་སྦྱིན།",
    "གོས་སོགས་རང་རང་སྔགས་ཀྱིས་ནི།",
    "དགང་གཟར་སྦྱིན་སྲེག་ཤིང་རང་བཞིན།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་ཀྱང་།",
    "ཤྲཱི་སརྦ་དུརྒ་ཏི་པ་རི་ཤོ་དྷ་ན་ཏརྗ་ཏ་ཨུད་ཌྷོ་ཏྱ་ལོ་ཙ་ནཱ་ཡཱ་དུརྒ་ཏི་ཤོ་དྷ་ན་བི་བྱེ།",
    "འཇམ་ཞིང་མཐོ་བའི་སྟན་འདུག་ལ།",
    "དེ་རྗེས་འདུག་པ་ལངས་ནས་ནི།",
    "རྒྱ་ཆེན་མཐོན་པོ་བདེ་བའི་སྟན་ལ་འདུག།",
    "དེ་རྗེས་ལངས་ནས་འདུག་པ་བལྟ་བར་བྱ།",
    "གཞན་གྱི་ཆེད་དུ་གླེང་བ་ནི་སྤྱན་སྔར་འདུག་ནས་བརྗོད་པ།",
    "ད་ནི་གཞན་སྤྲོ་བའི་ཕྱིར་ཙ་ནའི་འབྲུ་ཙམ་ནི་སྲན་ཙ་ན་ཀའོ།",
    "རང་རང་གཙོ་བོར་གྱུར་པའི་གནས་སུ་བསྒོམས་ན།",
    "གཞི་དང་ཐབས་དང་རང་བཞིན་གསུམ།",
    "ཨོཾ་རུ་རུ་ཞེས་པ་ལ་སོགས་པ་ལོ་ཙ་ན་ལ་སོགས་པ་རིམ་པའི་སྔགས་གསུངས་པ་རྗེས་སུ་དྲན་ཞེས་ཏེ།",
    "སྤྲེའུའམ་ཉ་ཁྱི་བ་དང་ཁྱེ་གུ་ལ་སོགས་པ་བྱུང་ནས་འདུག་པ་དེ་བརླག་པར་བྱའོ།",
    "དེས་གང་དགུག་པ་རྒྱན་རྣམས་རྫོགས་ཤིང་སེར་ལ་འཀྱིང་བག་ཏུ་འདུག་པ་རལ་པའི་དབུ་རྒྱན་ཅན་དགུག་པའི་ཆོ་གས་སོ།",
    "འདུག་གོ་ཞེས་པའི་བར་རྣམས་ནི་ཡོངས་སུ་གཏད་༤པ་སྟེ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་ཅིང་གཏན་ལ་ཕབ་པ།",
    "དེ་ལ་སེམས་ནི་དངོས་པོ་ཐམས་ཅད་དང་རང་བཞིན་གྱིས་བྲལ་བར་ཡང་མཁྱེན་ལ།",
    "དེ་བཞིན་དུ་ཕྲག་དོག་ཀྱང་རང་བཞིན་མེད་དོ།",
    "འཇམ་པའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ལ་འདུག་ནས།",
    "རང་རང་དག་ནས་གནས་ཕྱིར་རོ།",
    "རང་རང་ལྷ་དག་རང་བཞིན་སྐྱེ།",
    "རྟ་ཤ་ནི་རཏྣ་ལོ་ཙ་ན་དང་རིན་ཆེན་འབྱུང་ལྡན་གྱི་ཚུལ་དུ་སྤྱད།",
    "ཡང་ན་ཡན་ལག་མི་གཉིས་ཞེས་པ་ནི་གཟུངས་མ་དང་གཉིས་སུ་མེད་པའི་ཚུལ་དུ་འདུག་ནས་བཟླ་བའི་ཊྭཱདོན་ཏོ།",
    "འདུག་སྐུནས་ཞེས་པ་ནི་༧སྟན་དེ་གསུམ་གྱི་སྟེང་དུ་བདག་གོང་དུ་བསྟན་པའི་ཚུལ་དུ་འདུག་པའོ།",
    "དང་བ་ནི་ཤེལ་ལྟ་བུར་འདུག་ཅིང་འོད་གསལ་བའོ།",
    "དབུས་སུ་གནས་པ་ནི་རྣལ་འབྱོར་པ་དེའི་དཀྱིལ་དུ་འདུག་པའོ།",
    "ཡང་ན་གསང་བ་ནི་ལོ་ཙ་ན་ལ་སོགས་པ་ཡུམ་གྱི་རང་བཞིན་དུ་གནས་པ་རྣམས་སོ།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་ནི་འདུག་སྟངས་སོ།",
    "ཞེས་པ་ནི་དབུ་སྐྲ་རལ་པར་འདུག་ཉིད་ཅོད་པན་དུ་བྱས་པའམ།",
    "ཞེས་པ་ལ་དེ་ལ་ཕྱག་གཡས་ཀྱི་དང་པོ་ཡེ་ཤེས་ལྔའི་རང་བཞིན་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཁ་དོག་ཨིནྡྲ་དཱི་ལ་ལྟར་འདུག་པ་ཕྱག་ཏུ་བསྒོམ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "ཟླ་བ་རྩིབས་བརྒྱད་ལྟ་བུས་ནི་དབྱིབས་དང་ཁ་དོག་བསྟན་ཏེ་འཁོར་ལོ་དེ་རྩིབས་བརྒྱད་ལྡན་ཞིང་ཟླ་བ་བཞིན་དུ་དཀར་ལ་ཟླུམ་པོར་འདུག་པའོ།",
    "ཨུཏྤལ་སྔོན་པོའི་ལོ་མ་བཞིན་དུ་ཞེས་པ་ནི་ཕྱག་ཐ་མ་ན་རལ་གྲིའི་ཁ་དོག་ཨུཏྤ་ལའི་འདབ་མ་བཞིན་དུ་འདུག་པ་རྣམས་ལའོ་༡།",
    "ཞེས་པ་ནི་སྒྲུབ་པ་པོ་བདག་ཀྱང་དེ་དང་ལྷན་ཅིག་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་དུ་འདུག་ལ་བདག་ཉིད་དད་པའི་ལྷ་གང་ཡང་རུང་བ་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བསྒོམ་ཞེས་པའི་དོན་ཏོ།",
    "ཅེས་པ་ནི་སྒྲུབ་པ་ཆེན་པོ་བྱེད་པའི་འདུག་ཐབས་བསྟན་ཏེ།་",
    "ཞེས་པ་ནི་དེ་ལྟར་འདུག་ནས་ཐབས་དང་ཤེས་རབ་ཀྱི་ཕྱག་རྒྱ་གཉིས་གོང་དུ་བསྟན་པའི་ཏིང་ངེ་འཛིན་གསལ་བར་དམིགས་ལ་སྦྱོར་ཞེས་པའོ།",
    "འོད་ཟེར་སྣ་ཚོགས་པས་བརྒྱན་ཞེས་པ་ནི་སྐུ་ལས་དཀར་པོ་ལ་སོགས་པའི་འོད་ཟེར་སྣ་ཚོགས་དཀྲིགས་ཤིང་བསྐོར་བའི་ཚུལ་དུ་འདུག་པའོ།",
    "འབར་བའི་དབུ་ནི་གྱེན་དུ་བཅིངས་པ་ནི་དབུ་སྐྲ་སེར་སྐྱར་འདུག་པ་འབར་ཞིང་གྱེན་དུ་འཁྱིལ་པས་ཐོར་ཅོག་དུ་འདུག་པའོ།",
    "ཞབས་གཡས་བརྐྱང་བར་གནས་པ་ནི་འདུག་སྟངས་ཡིན་ཏེ།་",
    "གཡས་བརྐྱང་འགྱིང་བའི་ཚུལ་དུ་གནས་པ་ནི་འདུག་སྟངས་སོ།",
    "ཅེས་པ་ནི་ཤིན་ཏུ་འཇིགས་པར་བྱེད་པའི་ཁྲོ་བོའི་ཆ་ལུགས་ཞལ་གསུམ་ཁྲོ་གཉེར་རིམ་པ་མང་བ་ལྗགས་ཀློག་༡བཞིན་བསྐྱོད་ཅིང་ཤིན་ཏུ་རྣོ་བའི་མཆེ་བ་གབྱུགས་པར་འདུག་པ།",
    "ཞེས་པས་༡ནི་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་འདུག་པ་བསྟན་ཏེ།",
    "ལོ་ཙ་ན་དང་།",
    "སེམས་ཚིག་བརྗོད་པ་ལྟ་ཞེས་པ་ནི་སེམས་ཙམ་དེ་ཡང་རང་བཞིན་མེད་དོ་ཞེས་པ་སྟེ།",
    "ནམ་མཁའ་ལྟ་བུར་སྦྱར་ནས་ཤེས་པ་སྐྱེད་ཅིག་ཅེས་བཀའ་སྩལ་པ་དེ་རང་རང་དང་རྡོ་རྗེ་འཆང་བ་གཉིས་སུ་མེད་པར་སྦྱར་བས་བཀའ་མཉན་ཏེ་ཞེས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ཡང་རང་བཞིན་མེད་པ་སྟེ་དེ་ལས་བྱུང་བའི་དོན་ཏོ།",
    "ཡང་ན་གཟུང་བ་ལ་སོགས་པའི་རིམ་པས་སའི་དབུས་ན་འདུག་པའི་སློབ་དཔོན་ལ་གྲོགས་པོས་གསོལ་བ་བཏབ་པའི་དེ་མ་ཐག་ཏུ་ཐིག་ལ་སོགས་པའི་ལས་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ཙ་ན་ཀ་ཞེས་པ་ནི་སྣང་བ་མཐའ་ཡས་ཀྱི་ཡིན་ནོ།",
    "བྲིས་པའི་སྟེང་དུ་འདུག་སྟེ།",
    "ཀུན་དུ་སྤྱོད་པའི་ངོ་བོ་གང་ཡུལ་རྣམས་འདོད་པའི་ངོ་བོ་ལྟར་རང་རང་གནས་པས་ཕྱི་རོལ་གྱི་ངོ་བོ་སྤོང་བ་སྟེ།",
    "འབྲུ་ཙ་ན་ཀའི་ཐིག་ལེའི་འབྲས་བུ་ཞེས་སོ།",
    "ཞེས་པ་ནི་ཛྭཡིག་འབྲུ་དེ་དག་ཙ་ན་ཀའི་ཚད་ཀྱི་ཐིག་ལེའི་དབུས་སུ་གནས་པའོ།་།",
    "ཡིག་འབྲུའི་ཚད་ཙ་ན་ཀའི་ཚད་ཙམ་ཐིག་ལེའི་དབུས་སུ་གནས་པ་ལས།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་སྣར་ལ་ཆད་འདུག་པས་ཅོ་སྟནང་དཔེ་བསྡུར་བྱས་ཡོད།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་དབུས་སུ་འདུག་སྟེསྐེ།",
    "དེ་བཞིན་དུ་འོད་དཔག་མེད་ཀྱི་སྦྱོར་བས་ཀྱེ་འོད་དཔག་མེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ།",
    "གཟུགས་ལྕགས་གསུམ་གྱིས་དཀྲིས་པ་ཙ་ན་ཀའི་འབྲུ་ཙམ་གྱི་རི་ལུ་བྱས་ལ།",
    "དེའི་སྟེང་དུ་མི་བསྐྱོད་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་ལ་ཡི་གེ་ཧཱུཾ་ལས་ལག་པ་གཡས་པར་རྡོ་རྗེ་བསྐྱེད་ལ་བསྒོམས་ན་རྡོ་རྗེའི་ཞུརིག་པ་འཛིན་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་དུ་འདུག་སྟེ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱོར་བས་ཡི་གེ་ཨོཾ་ལས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་ལས་བསྒྲུབས་པ་ལས་འཁོར་ལོའི་ལྕགས་ཀྱུ་ལག་པ་གཡས་པར་བསྒོམས་ལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དགུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འོད་དཔག་མེད་ཀྱི་རྣལ་འབྱོར་པས་འོད་དཔག་མེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ་ཡི་གེ་ཨཱ་ལས་ལྕགས་ཀྱུ་པདྨ་རིགས་ཀྱི་གཟུགས་སུ་རྣམ་པར་བསམས་ལ་འོད་དཔག་མེད་ལ་སོགས་པ་དགུག་༧པར་བྱའོ།",
    "ནམ་མཁའི་དབྱིངས་སུ་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ་གཡས་པའི་འཁོར་ལོ་ནམ་མཁའ་དང་མཉམ་པར་རྣམ་པར་བསམས་ལ།",
    "གཤིན་རྗེའི་ཧཱུཾགཤེད་ཀྱི་སྦྱོར་བ་བྱས་ལ་རྡོ་རྗེ་ནམ་མཁར་བཅོམ་ལྡན་འདས་ཀྱི་དཀྱིལ་འཁོར་རྣམ་པར་བསམས་ལ་གནས་ལྔར་གཤིན་རྗེའི་གཤེད་ཀྱི་སྦྱོར་བས་འདུག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་འཕགས་པ་བདུད་རྩི་འཁྱེལ་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་དེའི་སྦྱོར་བས་འདུག་ལ་དེའི་སྔགས་ཀྱིས་ཁྲོ་བོ་བདུད་རྩི་འཁྱིལ་པ་རྡོ་རྗེ་ཕུར་བུར་བསམས་ཏེ།",
    "དཀྱིལ་འཁོར་དེར་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་དབུས་སུ་ཛོའདུག་ལ།",
    "ཨོཾ་རུ་རུ་སྒུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིདྷེ་ལོ་ཙ་ནེེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཁྲོ་བོ་གང་ཡང་རུང་བའི་སྤྱོར་བ་བྱས་ལ་དེའི་དཀྱིལ་འཁོར་ནམ་མཁའ་ལ་རྣམ་པར་བསམས་ནས་དཀྱིལ་འཁོར་དེའི་དབུས་སུ་འདུག་སྟེ།",
    "དེའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ་རྣམ་པར་སྣང་མཛད་དགུག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་སྦྱོར་བ་བྱས་ལ་དེའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རྣལ་འབྱོར་པ་འདུག་སྟེ།",
    "ཤར་ཕྱོགས་སུ་མི་བསྐྱོད་པའི་སྤྱོར་བས་འདུག་པའི་རྣལ་འབྱོར་པས་དབུས་སུ་ཡི་གེ་ཛེེ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་དེའི་སྟེང་དུ་ཡི་གེ་ཛེེ་ལས་གསེར་གྱི་ཁ་དོག་ཅན་འོད་ཟེར་སེར་པོའི་ཚོགས་ཀྱིས་ནམ་མཁའ་གང་བའི་འོད་ཟེར་དེ་རྣམས་ཀྱི་སྒོ་ལ།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་དེབ་འདིའི་ལྡེབ་༨༩༣པའི་བསྡུར་མཆན་ཀྱེ་པའི་མཚ་མས་སུ་པེ་སྣར་སྔགཉིས་ལ་ལྷག་མ་འཁོད་བྱེད་འདུག་ཤེ་པེ་སྣར་རྣམ་པར།་",
    "དེ་ནས་ཆར་དབབ་པའི་ས་ཕྱོགས་སུ་འདུག་ལ་གདུགས་དང་རྒྱལ་མཚན་དང་།",
    "ཡང་ན་མགོ་ལ་ཏྭེ་བདུད་རྩིའི་ཚོགས་འོ་མ་ལྟ་བུར་འབབ་པ་བཀོད་ལ་ལུས་ལ་གནས་པའི་དུག་ངོ་བོ་ཉིད་ཀྱིས་ནག་པོར་འདུག་པའི་དྲི་མ་རིམ་གྱིས་སེལ་བར་བྱེད་པའི་འོད་ཀྱི་རྒྱུན་བསམས་ལ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་གཟུགས་ཇི་ལྟ་བ་བཞིན་དུ་གསང་བའི་གནས་སུ་བྱས་ལ་རབ་གནས་བྱ་ཞིང་རང་དེ་ལྟ་བུའི་སྦྱོར་བ་དང་ལྡན་པས་བསྟན་པ་ལྟར་བྱའོ།",
    "དགྲའི་༤རོ་ཙ་ན་ཞེས་བྱ་བ་ནི་དགྲའི་དྲི་ཆེན་ནོ།",
    "སྣང་མཛད་ནི་བེ་རོ་ཙ་ནའོ།",
    "སྐལ་བ་དང་ལྡན་པ་གང་ཞིག་རྒྱུད་འདིར་སློབ་པ་དེ་ཡང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་རིམ་གྱིས་ཞེ་འགྱུར་བ་ནི།",
    "གལ་ཏེ་འདུག་ཀྱང་བགེགས་བྱེད་ན།",
    "བསྒྲུབ་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་མཚན་ཐོག་ཐག་བཟླས་ནས་ཐོ་རངས་ནམ་མཁའ་ལ་བྱ་ཁྱུང་ལྟར་འགྲོ་བར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་བཟླས་ན་དེའི་ཐོ་རངས་དེ་མི་སྣང་བར་འགྱུར་ཏེ་ལྷས་ཀྱང་མི་མཐོང་བར་འགྱུར་རོ།",
    "འདིར་ཡང་སྔ་མ་ལྟར་བྱ་བ་བྱས་ཏེ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་ཆུའི་སྣོད་ལ་རྡོ་ལ་སོགས་པ་བོར་བ་མི་འབྱིང་བ་ཐོ་རངས་གྲུབ་པ་ན་དེས་དེ་གྲུབ་བོ།",
    "ཚངས་པ་ཆེན་པོའི་སྟོབས་ཀྱིས་ཡུལ་བཀོད་པའི་བྱེན་གྱི་རླབས་ཀྱིས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཚེ་དཔག་མེད་ཀྱི་སྤྱན་སྔ་ན་འདུག་གོ།",
