    "གོང་ལྟར་གཏོར་མ་དེ་ཉིད་ནང་མཆོད་ཆུ་ཆང་གིས་སྦྱངས།",
    "གི་བར་གྱི་རྗེས་སུ།",
    "ཚོགས་ལྷག་མ་རྣམས་སྣོད་དུ་སྤུངས་ལ་སྒྲུབ་ཐབས་རྒྱས་པའི་མཇུག་གི་ལྷག་མའི་ཆོ་ག་དབྱངས་རོལ་བཅས་བྱའོ།",
    "དེ་རྣམས་ཀྱི་དྲག་པོའི་སྦྱིན་སྲེག་གི་ཆོ་གའི་ལག་ལེན་རྣམས་མ་ཚང་བ་མེད་པར་བསྟན་ཟིན་ཏོ།",
    "དེ་རྣམས་ཀྱི་སྒོ་ནས་དཔལ་ཆེན་རྡོ་རྗེ་གཞོན་ནུའི་ཕྲིན་ལས་བཞིའི་སྦྱིན་སྲེག་གི་ཆོ་ག་ཡེ་ཤེས་འབར་བའི་མེ་ཆེན་ཞེས་བྱ་བ་མ་ཚང་བ་མེད་པར་བསྟན་ཟིན་ཏོ།",
    "ཁྱད་པར་བདག་གི་ཚེ་རབས་ཀུན་གྱི་མགོན།",
    "དེ་ལྟ་མོད་ཀྱི་མཆོག་གསུམ་བཀའ་དྲིན་གྱིས།",
    "རང་གིས་རང་ཉིད་བསླུས་པར་མ་གྱུར་ན།",
    "དེ་དག་ཐམས་ཅད་མིང་གི་ལྷག་མ་ཙམ།",
    "འོན་ཀྱང་བདག་གི་དམ་པའི་བཀའ་དྲིན་ལས།",
    "རང་གི་བློ་གྲོས་སྤོབས་པ་ཅི་མཆིས་ཀྱིས།",
    "འདི་ལའང་བདག་བློ་གཏི་མུག་གིས་རྨོངས་པས།",
    "རང་གི་བློ་གྲོས་ཀྱིས་ཀྱང་དཔྱད་དེ།",
    "། ཨོཾ་ན་མོ་སརྦ་གུ་རུ་མཎྜལ་བྱུ།",
    "ཁོང་གི་ཐུགས་ལ་ང་དགེ་སློང་དེ་འདྲ་ག་ལ་རུང་།",
    "ཡང་དགོངས་པ་ཁྱབ་བདག་གནས་གསར་བ་མཁས་གྲུབ་ཆེན་པོ་རེད།",
    "ན་ལེནྡྲ་གཟིམ་འོག་མཐོང་སྨོན་གྲྭ་ཚང་གི་བླ་ཚབ་མཛོད།",
    "རྗེས་སུ་ན་ལེནྡྲ་ཚང་མས་ཁྱབ་བདག་གནས་གསར་བ་དང་བོད་འབྲུག་པ་ས་ཆེན་ཀུན་བློའི་ཐུགས་སྲས་ཡིན་པས་ཁོང་གཉིས་འདྲ་འདྲ་རེད།",
    "ཁོང་གི་སྐུ་མཆེད་མང་པོ་ཡོད་པ་ནས་གཅེན་པོ་བགྲེས་པ་གདུང་པ་ཞིག་བཅས་སྐྱ་སེར་གཉིས་ན་ལེནྡྲར་ཕེབས།",
    "ཁོང་གི་ཧ་ཅང་གི་བཙུན་པོ་སྡོམ་པ་གསུམ་གྱིས་ཉེས་ལྟུང་ཕྲ་མོས་མ་གོས་པ་མཛད་པས་མནལ་ལམ་དུ་ངོ་མཚར་བའི་ལྟས་བྱུང་།",
    "གཙང་ཟབ་བུ་ལུང་ནས་ཨོ་རྒྱན་ཡབ་ཡུམ་གྱི་དག་སྣང་གཟིགས་པས་རྐྱེན་བྱས་གཏེར་བཞེས་རྒྱུའི་ལུང་བསྟན་གྱིས་བཙུན་མོ་བཞེས།",
    "ན་མོ་གུ་རུ་ཤྲཱི་ཧེ་བཛྲ་མཎྜལ།",
    "རྗེ་བཙུན་རིན་ཆེན་དམ་པ་བིརླུ་པ་ས་སྐྱ་དབུ་རྩེ་རྙིང་པར་དངོས་སུ་མཇལ་ཏེ་གསུང་གང་ཞིག་མུན་པ་དང་བྲལ་བའི་ཟླ་བ་ཤར་བ་ལྟ་བུས་འོད་ཟེར་གང་ཞིག་གིས།",
    "བདག་ཏུ་ལྟ་བའི་བློ་ཡི་མུན་པ་བྲལ་བར་གྱུར་ནས་རང་གི་སེམས་ལ་སྣང་བ་ཅུང་ཟད་ཐོབ་པས་དོན་མ་ནོར་བ་སྟོན་པའི་ནུས་པ་ཡོད་སྙམ་འོང་ངོ།",
    "བདག་མེད་ལྷ་མོ་བཅོ་ལྔས་དངོས་སུ་བྱིན་གྱིས་བརླབས་པས་ས་དྲུག་གི་རྟོག་པ་མངོན་དུ་གྱུར་པ་གྲུབ་ཆེན་བིརླ་པ།",
    "འཁོར་འདས་ཐུན་མོང་གི་ལམ་བསྟན་པ།",
    "དང་པོ་འཁོར་འདས་ཐུན་མོང་གི་ལམ་ལ་ལྔ་སྟེ།",
    "ཉོན་མོངས་པ་ལ་ཞེས་པའི་དལ་འབྱོར་རྙེད་དཀའ།",
    "ཉམས་ཀྱི་སྣང་བ་ལ་རྣལ་འབྱོར་པ་ལ་ཞེས་པའི་ལམ་ལ་ཐུན་མོང་གི་རྣལ་འབྱོར་པས་བྱམས་པ་དང་།",
    "གསང་སྔགས་ཐུན་མོང་མ་ཡིན་པའི་རྣལ་འབྱོར་པས་སྐྱེ་འགྱུར་ཉམས་རྣམས་སྒྲོ་འདོགས་ཆོད་པར་བྱས་ནས་ནམ་ཞིག་ཉམས་དེ་ཚོ་སྐྱེ་ན་བཟང་ངན་གྱི་རེ་དོགས་མི་བྱ་བར་རྟོག་མེད་བྱུང་རྒྱལ་དུ་བསྐྱང་པའོ།",
    "མོས་གུས་ཀྱི་བསམ་པ་ཚིམ་པའོ།",
    "ལས་འཕྲོ་ཅན་རང་གི་ངང་གི་ཁམས་འདུ།",
    "མོས་གུས་ཅན་བྱིན་བརླབ་ཀྱིས་ཁམས་འདུ།",
    "གཏུམ་མོ་ཕྱོགས་མེད་དུ་འབར།",
    "རྩ་ཁམས་ཕྱོགས་མེད་དུ་སད་པ་སྟེ་བདུན་བདག་གི་ཁམས་འདུ་ཚེ་གདམས་ངག་མེད་པ་ཚོས་ཁམས་འདུས་མ་རེད་ཅེས་བསྐུར་པ་འདེབས།",
    "མོས་གུས་ཅན།",
    "སེམས་ལ་ཉོན་མོངས་བྱུང་ན་ཉོན་མོངས་རང་དགའ་བར་འཆད་པས་ཏིང་ངེ་འཛིན་དུ་མི་ཤེས་ལ།",
    "རྣམ་རྟོག་སྔོན་སོང་གི་དྲོད།",
    "དེད་དཔོན་དེས་རང་གི་འཁྲིད་པར་བྱ་བའི་ཚོང་པ་ཐམས་ཅད་གཞན་ལ་རག་མ་ལས་པར།",
    "ལམ་འཁྲིད་ལུགས་གསུམ་པོ་དེ་དག་གིས་ཁྲིད་པར་བྱ་བ་སེམས་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་དེ་གཞན་ལ་རག་མ་ལས་པར་ཁྲིད་ལུགས་གསུམ་པོ་དེ་དག་གི་སྒོ་ནས་བཅུ་གསུམ་རྡོ་རྗེ་འཛིན་པའི་སར་ཁྲིད་པར་བྱེད་པས་ན་དེ་སྐད་བྱའོ།",
    "འདུས་པ་བར་པ་ལ་ངེས་པ་མཐོང་སྣང་དུ་འཆར་བ་རིགས་དྲུག་གི་མཐོང་སྣང་རྣམས་དང་།",
    "རེ་དོགས་བྲལ་ཚུལ་གྱི་མཐོང་སྣང་ལ་རྒྱལ་བ་རིགས་ལྔའི་སྐུ་སོགས་མཐོང་བ་དངོས་གྲུབ་ཀྱི་རེ་བ་མི་བྱ།",
    "སྲུང་བ་སུམ་ཅུའི་གེགས་སེལ་བསྟན་པ་མན་ངག་གི་གནས་བདུན་ཅུའི་བསྟན་པ་དང་།",
    "གདམས་ངག་དྲུག་གི་བསྟན་པ་དང་།",
    "ཟུང་འཇུག་གི་རྣལ་འབྱོར་པ་གསུམ་ལས།",
    "ཐུན་མོང་གི་སྲུང་བ་བསྟན་པའོ།",
    "དེ་དག་ཚང་མ་ཉམས་ཡིན་ན་རེ་དོགས་མེད་པ་བྱུང་རྒྱལ་དུ་བསྐྱངས།",
    "བར་ཆད་ཡིན་ན་ངོ་ཤེས་པ་ཙམ་གྱིས་སྐྱེངས་ནས་འགྲོ་གལ་ཏེ་མ་སོང་ན།",
    "བར་ཆད་སོ་སོ་བསྲུང་བ་བསྟན་ནས་གཉིས་པ་ཐུན་མོང་གི་བསྲུང་བ་ནི་བཅུ་བཞི་སྟེ།",
    "གསུམ་པ་གདམས་ངག་དྲུག་གི་གེགས་སེལ་བ་ནི།",
    "འཁོར་འདས་ཐུན་མོང་གི་ལམ་འབྲས་བུ་དང་བཅས་པ་ཡོངས་རྫོགས་བསྟན་སྐབས་གེགས་སེལ་རྣམས་ཤེས་པའི་ཆེད་དུ་བསྟན་ལ།",
    "རྣམ་པ་གསུམ་དག་གི་བདེ་སྟོང་མཆོག་ཏུ་གྱུར།",
    "བྱང་སེམས་གྱེན་ལ་ལྡོག་ཅིང་གླང་ཆེན་ཧིང་དང་སྟག་མོ་ངུར་གཅན་གཟན་སྐྱགས་དང་ཝ་ལྟར་བསྣོམས་པ་སྟེ་དུད་འགྲོའི་འགྱུར་བ་བཞི་ཡིས་བྱང་སེམས་གྱེན་དུ་བཟློག་པ་ཡིན།",
    "བུ་ཆུང་སྤྱོད་ལམ་ནི་ལུས་ཕར་འགྱེལ་ཚུར་འགྱེལ་བྱ་བ་དག་གིས་ནི་ཁམས་ཁྱབ་ཅིང་བརྟན་པར་འགྱུར་རོ།",
    "ལམ་གྱི་གེགས་སེལ་བའི་སྐོར་རྒྱས་པ་སོང་ནས།",
    "ལྟ་གྲུབ་བརྒྱད་པོ་འདི་དག་གིས་བསྡུས་པ་ཡིན་ནོ།",
    "གྲོགས་དམ་ཚིག་ལྡན་པ་ཨ་སེང་གི་བཀའ་འཕྲིན་བཅག་གྱུར་ཏེ་རི་བ་དོན་མེད་བྱས་ཀྱང་མི་འགྲིག་པས་བཀའ་རྒྱ་ཐེམས་སྙམ་ཡང་ཕྱི་ནང་མཁའ་འགྲོས་ལེགས་ཉེས་དཔངས་པོ་མཛོད་ལ།",
    "འབུལ་ལམ་ཞུས་པའོ། ། ན་མོ་གུ་རུ་བཛྲ་ཡོ་གི་ནཱི་ཡེ།",
    "བྱིན་བརླབ་ཟབ་མོས་རྒྱུད་སྨིན་པའི་གང་ཟག་གིས།",
    "རང་གི་སྤྱི་བོར་པདྨ་ཟླ་བའི་སྟེང་།",
    "བདག་གི་སྔོན་བསགས་སྡིག་སྒྲིབ་ཉེས་ལྟུང་ཀུན།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "མཉམ་མེད་བཀའ་དྲིན་ཅན་གྱི་ཐུགས་རྗེ་གཟིགས།",
    "བདག་གི་ཉོན་མོངས་རང་གཟུགས་ལུས་ལོངས་སྤྱོད།",
    "རེག་པ་ཙམ་གྱིས་ཐོད་པ་ལིང་གིས་བཀོག།",
    "ལེགས་བཀལ་སྟོང་གསུམ་ཁྱོན་དང་མཉམ་པར་གྱུར།",
    "བདུད་རྩི་མཐོང་རེག་མྱང་བས་སྒྲིབ་གཉིས་བྱང་།",
    "འོད་ཀྱི་ཕུང་པོར་གྱུར་ལས་སྐད་ཅིག་གིས།",
    "དམར་གསལ་སྤྱན་གསུམ་ནམ་མཁའི་དབྱིངས་སུ་གཟིགས།",
    "རྡོ་རྗེ་བཙུན་མོའི་ཞིང་སྐུར་ལམ་གྱིས་གསལ།",
    "ཐུགས་ཀའི་ལུས་དཀྱིལ་གཙོ་མོའི་སྔགས་ཕྲེང་ལས།",
    "ཨོཾ་ཨོཾ་ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནི་ཡེ།",
    "དཔག་མེད་བདེ་ཆེན་ཞིང་གི་མགོན་པོས་སྐྱོངས།",
    "མཆོག་གི་སྤྲུལ་པའི་བཟློས་གར་ངེས་རྙེད་པའི།",
    "མཁྱེན་པས་ཤེས་བྱ་ཀུན་གཟིགས་པཎྜི་ཏ།",
    "མི་རྗེ་གུང་རྒྱལ་ཞེས་བྱ་བ་དེས་གནམ་ལ་ཡར་གཟིགས་པས་གནམ་འཁོར་ལོ་རྩིབས་བརྒྱད་དུ་གཟིགས།",
    "ས་ལ་མར་གཟིགས་པས་ས་པདྨ་འདབ་བརྒྱད་དུ་གཟིགས།",
    "ལོགས་ལ་ཕར་གཟིགས་པས་ལོགས་རིན་ཆེན་ཟུར་བརྒྱད་དུ་གཟིགས།",
    "དེ་ནས་རྒྱལ་རབས་རིམ་པར་བྱོན་ཏེ་འཕྲིན་ལས་ནམ་མཁའ་དང་མཉམ་པའི་རྒྱལ་རབས་དྲུག་ཅུ་རེ་གཅིག་པ་སྟག་སེངྒེ་འབུམ་གྱི་སྲས།",
    "ལུགས་ཟུང་གི་སྙན་གྲགས་རྒྱ་མཚོའི་མཐའ་བར་ཁྱབ།",
    "ས་སྐྱ་པ་ཨ་མེས་ཞབས་དང་།",
    "ཕྱི་ནང་གི་དགྲ་བགེགས་མངོན་སྤྱོད་ཀྱི་ཚར་གཅོད་པའི་རྟོགས་པ་མངའ།",
    "རྗེ་བཙུན་དེས་རྩེ་བྲང་གི་མཆོད་རྟེན་དང་ཁྲེད་མཁར་གྱི་མཆོད་རྟེན་རྣམས་བཞེངས།",
    "ནང་ངོ་ལོག་གིས་དུས་ཟེང་ཆེན་པོ་བྱུང་སྐབས་ཕེབས་དགོས་བྱུང་།",
    "ཁེངས་ལྡན་སྐྱེས་བུ་སུ་ཞིག་གིས་མཇལ་ཡང་འཇིགས་ཟིལ་མི་བཟོད་པས་ཞུམ་པ་ཞིག་གོ་ཞེས་གྲགས་སོ།",
    "དུས་ཟིང་གི་འཕོ་འགྱུར་མང་པོ་བྱུང་ནས་སྐབས་འགར་སྐུ་ངལ་ཕྲན་བུ་བྱུང་ཡང་།",
    "བསམ་འགྲུབ་གླིང་སོགས་སུ་ནང་གི་ཉམས་བཞེས་ཐུགས་དམ་ལ་བརྩོན་པར་མཛད།",
    "མཆུན་མ་ཛུམ་ལང་རྒྱལ་པོའི་སྐུ་བརྒྱུད་སྐག་མཁར་གྱི་སྲས་མོ་ལྷ་ལྕམ་གཉིས་ལས།",
    "སྤྱི་ཁྱབ་གཉེར་པ་གཡུང་དྲུང་ཚེ་བརྟན་གྱི་བུ་མོ་ཉི་ཟླ་ཞེས་པ་བཞེས་ཏེ་བསླབ་སྐྱོན་བྱུང་།",
    "སྲས་མོ་མ་གཏོགས་སྲས་མ་འཁྲུངས།",
    "ཨ་མགོན་འཇམ་དབྱངས་དཔལ་འབར་ལ་སྔོན་མ་རྒྱལ་མོ་པདྨ་བུ་ཁྲིད་ཀྱི་ཚ་མོ་ཕུག་སྟོད་བླ་བྲང་གི་སྲས་མོ་བདེ་སྐྱིད་བཞེས་པར་སྲས་ཨ་མགོན་འཇམ་དཔལ་བསྟན་འཛིན་དགྲ་འདུལ་དང་།",
    "སྲས་མོ་འཆི་མེད་འཁྲུངས།",
    "ཡུལ་གྱི་མི་མང་མཉམ་གྲོས་མཐུན་པར་གོར་གཞུང་རྒྱལ་ཁབ་ཆེན་པོར་སྙན་ཁུར་ཆེད་བཅར་གྱིས་རྒྱལ་པོ་ཁྲི་འཛིན་རང་གི་རིགས་སྲས་འཇམ་དཔལ་བསྟན་འཛིན།",
    "གཅེན་མོ་རྒྱལ་མོ་ཡུམ་སྲས་སྟོན་འཁོར་ཕྲན་ལྕེ་བཙུན་ཁྲི་མིང་སེར་སྐུ་མཆེད་མཇལ་འཕྲད་ཟླ་ཤས་ལྷོད་བཞུགས་གནང་།",
    "ཡབ་སྲས་དབུས་གཙང་དུ་གནས་གཟིགས་ལྷན་དུ་ཕེབས་སྐྱེལ་བསུ་བཞེས།",
    "རྒྱལ་མོ་བདེ་སྐྱིད་ལགས་ནས་བུ་མོ་གཉིས་སུ་མག་པ་ཁག་ལེན་དང་།",
    "ལྟ་སྤྱོད་གཏད་སོ་མེད་པས་གང་དྲན་ཐལ་གནང་གིས་མཐར་སྔོན་མའི་བག་ཆགས་ཀྱིས་དོལ་པོར་ཕེབས་ཏེ་ཆུ་སྟོན་པ་དང་།",
    "དྲི་མེད་འཕན་མཆོག་བཟང་མོ་རྩེ་བྲང་གཟིམ་ཁང་ལ་གནང་།",
    "རྒྱལ་ཐོག་ཉེར་གཉིས་པ་ཨ་མགོན་འཇིགས་མེད་དཔལ་འབར་ནི།",
    "འཛང་ཤིང་རྟུལ་ཕོད་པ་སོགས་སྐྱེས་སྟོབས་ཀྱི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པས་ཡབ་ཡུམ་གཉིས་ནས་ཀྱང་རྒྱལ་ཁང་རྟེན་རྫས་ནང་རྡོ་ལ་ཨོཾ་ཨཱ་ཧཱུྃ་གི་རང་བྱོན་ཡོད་པ་སྔོན་མའི་ཞལ་རྒྱུན་ཡབ་སྲས་རིམ་པར་བརྟག་དཔྱད་ལ།",
    "རྒྱལ་མོ་བདེ་སྐྱིད་སྒྲོལ་དཀར་ཁམས་ཕྲག་པས་བསྐོས་པའི་ཕ་མར་གུས་འདུད་ནམ་ཡང་མ་མཛད་པས་ཡབ་ཡུམ་ཐུགས་ཡིད་གཏིང་ནས་ཡིད་ཆེད་ཀྱིས།",
    "སྔར་ལམ་ཕུག་སྟོད་རྒྱལ་མོ་པདྨ་བུ་ཁྲིད་ཀྱི་ཚ་མོ་སྲས་ཀྱི་སྲས་སུ་བཞེས་ཏེ་འཕྲོད་ལམ་ལེགས་བྱུང་ལྟར།",
    "ལྷག་པར་ལྷ་བྲིས་རི་མོ་བི་ཤོ་དངོས་བྱོན་ལྟ་བུ་སུ་གང་གིས་འགྲན་ཟླ་བྲལ་བ་ཕྱག་རྩལ་མང་པོ་སྤྱོད་ཕུལ་ཡོད་པ་དེའི་སྲས་མོ་འཆི་མེད་སྲིད་སྒྲོལ་ཞེས་དེས་འཛིང་རང་བཞིན་བཟང་བ་ལྟ་ན་སྡུག་པ་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་དེ་ཡབ་ཡུམ་ནས་བཙུན་མོར་བསུ་བཞེས་མཛད།",
    "ལྕགས་ཀྱི་གྲབ་པ་སོགས་སྡུག་བསྔལ་བཟོད་མེད་འུ་ཐུག་གིས་བསམ་དགོངས་ཡོང་མིན་ཇི་ལྟར་ཡང་ཞུ་དགོས་སྙམ་ལྷས་གང་གསུངས་ལྷུག་པར་ཞུས་པས་ཚང་མ་ངོ་མཚར་བ་མང་པོ་བྱུང་།",
    "ཡུལ་མི་ཚོས་ཞིང་བདག་ཟུང་གིས་ཕུ་ཏོག་འབུལ་མི་དགོས་པའི་རྙོག་ཕྲ་བྱུང་སྐབས་ཀྱང་།",
    "ས་ཆ་ཞུས་སྩལ་སྐབས་སོགས་སྔ་རྟིང་གྲངས་མེད་སྐབས་འགར་ཞབས་ཐང་གིས་ཉིན་འཁོར་གནང་དགོས་པ་ཡང་མང་པོ་བྱུང་བ་དང་།",
    "དཔྱད་ལེགས་གང་འཛོམས་གཙོ་བོར་བཟུང་ལྡེབ་ནང་ཕྱོགས་དེའི་རྒྱལ་པོ་བློན་པོ་སོགས་ས་ཡི་བདག་པོར་ཚིག་གིས་སམ་རིན་གྱིས་སྣང་བ་ལས་བསླངས་ཏེ་ཞེས་པའི་དོན་ལ།",
    "དེ་ནས་མི་སྣང་སའི་ལྷ་མོར།",
    "དཔྱད་པས་བརྟག་པ་སྔོན་སོང་ནས།",
    "བརྐོས་པའི་བརྟག་པ་པུས་མོ་ནུབ་ཙམ་དོང་བྲུས་ཏེ།",
    "གོམ་བརྒྱའི་སར་སོང་སྟེ་འོང་བལྟས་ཆུ་དེ་ཉིད་མ་ཕྲི་ཁེངས་བྱུང་ཤིན་ཏུ་བཟང་ཞེས་པའང་བྱུང་སོང་།",
    "ལོ་འཁོར་ཟླ་བ་ལོ་ཞག་དང་མཚུངས་པའི་རེ་མིག་དོད་ཐོག་ལྟོ་ཕྱེའི་གཟུགས་བྲིས་ཏེ་ས་དམིགས་དངོས་གྲུབ་བླངས་པའི་གནས་སྟ་ཟུར་གཡོན་ཕྱོགས་ས་དམིགས་གྲུ་བཞི་བསྐོས་ཚུལ་རྒྱབ་སྤྲོད་སོགས་ལག་ལེན་བཞིན་བརྐོས་ཏེ་སྐྱོན་བསལ།",
    "ངོས་གསུམ་ལ་ཁྱམས་བརྟགས་པ་སྤྲོ་ནའང་བྱ་ཞིང་གསུངས་པ་ནང་དུ་མེད་ཀྱང་རྗེས་སུ་ཕྱི་ནས་ཤག་སྐོར་ཁྱམས་རྒྱག་ཐུབ་རེ།",
    "རྩིག་རྨང་གི་སྟེང་རྩིག་ཆེན་ཚང་མའི་ཕྱོགས་བཞི་མཚམས་བརྒྱད་དུ།",
    "གཙུག་ལག་གི་ནང་ཀ་བ་བཞི་པོ་དབྱིན་ཇི་ནེ་ཡར་མཁས་པས་བཀོད་པ་བཞིན་རྩིག་རྨང་ས་དོང་བྲུས་ཏེ་སི་མན་ཀྲིའི་རྩིག་པ་གྲུ་བཞི་རྒྱ་ཆེན་པོ་དང་རིམ་པས་ཆུང་དུ་བཏང་ནས་རྩེ་བར་ལྕགས་སུཀྲི་བྱས་པ་མང་པོ་ཐལ་བཏང་དང་།",
    "མཐའ་ནས་སྒོར་མོ་རིམ་བརྩེགས་ཕྱི་ནས་སྒྲོམ་བཟོས།",
    "ཀ་བའི་མགོར་པད་སྒོར་དང་བྲེ་ཆུང་དེ་སྟེང་གཞུ་རིང་གཞུ་ཐུང་དང་གཞུ་རིང་ལ་རྒྱལ་སྲིད་སྣ་བདུན་མཚོན་པའི་རི་མོ་འབུར་བཀོད་དེ་སྟེང་ལྕགས་དང་སི་མན་ཀྲིའི་བྷིལ་ཐལ་གདུང་བཏང་།",
    "ཀ་གདུང་གི་སྒྲོམ་བཙུག་དུས་སོ་སོ་ནང་བྱིན་རྟེན་དང་སྐུ་འདྲ་སོགས་བོད་དུ་སྒམ་རྫས་ཞེས་ཕུལ་སྲོལ་ལྟར་ཕངས་མེད་ཕུལ།",
    "འདུ་ཁང་གི་གཡས་གཡོན་དུ་མགོན་ཁང་དང་ལྷ་ཁང་།",
    "གཙུག་ལག་གི་ཕྱི་བརྩིགས་ཕུ་ཀྲུ་མན་ཚོན་སེར་པོ།",
    "དེ་སྟེང་སྤེན་བརྫུས་ཉིས་བརྩེགས་སོ་སོར་སྐར་མ་འབུར་བརྐོས་ཁོར་མོར་ཡོད།",
    "རྟེན་གཙོ་བཞེངས་སྐབས་བཞེངས་མི་ཚང་མ་བོད་མིར་སོང་དབུ་ལས་ཚང་མར་དར་དང་གནང་སྦྱིན་སོགས་བོད་སྲོལ་དང་མཐུན་པའི་འབུལ་སྟོན་བྱས།",
    "རྟེན་གཙོ་གསེར་ཟངས་ལས་གྲུབ་པའི་སྟོན་པ་མཐོང་གྲོལ་ཆེན་མོ་ཕུ་ཀྲུ་ལྷག་ཙམ་རྒྱུ་འགྲོན་ལ་མ་འཛེམས་པར་ཚ་གསེར་སོགས་སྤུས་ལྡན།",
    "གཙུག་ལག་གི་གཡས་གཡོན་དུ་ལོག་བྲིས།",
    "བདག་ཅག་གི་སྟོན་པའི་མཛད་པ་བཅུ་གཉིས་ཆ་ལག་ལྷ་བབས་ཆོ་འཕྲུལ་བསྟན་པ་སོགས་དང་།",
    "བྱུང་སོང་དཀར་ཆག་དང་།",
    "ནེ་གཞུང་གི་ས་གནས་སྐུ་ཚབ་བཅས་མི་སྟོང་ཕྲག་གི་རྟེན་འབྱུང་སྒོ་འབྱེད་ཕུན་སུམ་ཚོགས་པ་བཅས་ཐོག་མཐའ་བར་གསུམ་ཚང་མ་བསྟན་འཛིན་མཁོ་དེབ་གཞིར་བཟུང་བ་ཤ་སྟག་ཡིན།",
    "ཀུན་མཁྱེན་གང་གི་རིང་ལུགས་འཁྲུལ་མེད་མཆོག།",
    "དེ་ཡང་གནས་ཀྱི་ཁྱད་པར་སྤོར་ཐང་གཙུག་ལག་གི་ས་དཔྱད་ལྟར་གནམ་ས་བར་གསུམ་དུ་མ་བཅོས་ལྷན་སྐྱེས་ཀྱི་ས་བཀྲ་ཕུན་སུམ་ཚོགས་པ།",
    "དབེན་ཞིང་ཉམས་དགའ་ལ་བསིལ་དྲོད་སྙོམས་པ་སོགས་ཀློག་སྤོང་ཐོས་བསམ་པ་ལ་འོས་པའི་དྲང་སྲོང་གི་གནས་ཀྱི་ཡོན་ཏན་མཐའ་དག་རང་ཆས་སུ་མངའ་བ་དེར།",
    "དེའི་ཚེ་ལུང་པའི་ཕུ་ན་རྒྱུན་དུ་ཡོད་པའི་སྒོམ་ཆེན་པ་རྡོ་རྗེ་བཀྲ་ཤིས་བྱ་བ་ཞིག་གིས་འབྲུ་སྣ་དང་།",
    "ཁྱེད་ཀྱི་མིང་ལ་ཅི་ཟེར་གསུངས་པས་རྡོ་རྗེ་བཀྲ་ཤིས་ཟེར་བ་ལགས་ཞུས་པས།",
    "ནཱ་ལེནྡྲ་ལ་ཁྲི་མཆོད་ཆེན་མོ་བཙུགས།",
    "དགུང་ལོ་བཅུ་དགུའི་དུས་སུ་བཀའ་སྲུང་དུར་བདག་གི་བསྐང་གསར་སྙན་ངག་གི་ཉམས་འགྱུར་ཕུན་སུམ་ཚོགས་པ་བརྩམས་གནང་བ་ད་ལྟ་མཇལ་རྒྱུ་ཡོད།",
    "མགོན་ཁང་དུ་རོང་སྟོན་ཆེན་པོའི་ཕྱག་བཟོ་མགོན་པོའི་སྐུ་མི་ཚད་ཙམ་ཡོད་པ་དེ་ཐུགས་ཀར་བཞུགས་པའི་གུར་མགོན་ཐོག་ཚད་གཉིས་གཡས་གཡོན་དུ་ཞལ་དང་ལྷ་མོ་སོགས་ལྷ་བརྒྱད་ཆ་ཚང་བཞུགས།",
    "རྟེན་སྒམ་ནང་ཀུན་མཁྱེན་བཀྲ་ཤིས་རྣམ་རྒྱལ་གྱི་དབུ་ཐོད་བདེ་མཆོག་གི་སྔགས་རང་བྱོན་ཡོད་པ་དང་བཀྲ་ཤིས་རྣམ་རྒྱལ་གྱི་ཞབས་རྗེས་ཡོད་པའི་རྡོ་དང་ཕྱག་དམ་སོགས་མང་།",
    "མགོན་ཁང་དུ་ལྷ་མོ་རྡོ་རྗེ་རབ་བསྟན་པའི་ཞལ་འབག་དུས་དུས་སུ་ཞལ་མདངས་འགྱུར་བ་དང་ཟིལ་པ་ཆགས་པ་སོགས་ངོ་མཚར་ཅན་གྱི་གཙོས་རྟེན་མང་།",
    "ཞེས་རྗེ་རང་གི་ཕྱག་ནས་ཅན།",
    "དངུལ་གྱི་ཚེ་ལྷ་རྣམ་གསུམ་ཁྲུ་ཚད་རེ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་གཡས་གཡོན་དུ་གསེར་ཟངས་ལས་གྲུབ་པའི་འཇམ་དབྱངས་དང་ཕྱག་རྡོར་ཁྲུ་རེ་སོགས་བཞུགས།",
    "སྲུང་མའི་གཙོ་བོ་ལྷ་མོ་རབ་བརྟན་མའོ།",
    "གཞན་བཀའ་གདམས་མཆོད་རྟེན་དང་ལི་མ་དང་གསེར་ཟངས་སོགས་ཀྱི་སྐུ་ཆེ་ཆུང་སྣ་ཚོགས་པ་ནི་ཁང་ཚན་དང་གྲྭ་ཚང་རེ་རེ་ལ་ཡང་གྲངས་མེད་པ་བཞུགས།",
    "བླ་བྲང་གཉིས་ལ་དཔེར་མཚོན་ན་གཟིམ་འོག་ཏུ་ཀུན་མཁྱེན་བཀྲ་ཤིས་རྣམ་རྒྱལ་གྱི་ཐུགས་དམ་རྟེན་ཚོགས་བདག་གི་སྐུ་ལི་མ་དང་།",
    "རྡོ་རྗེ་ཕག་མོའི་ཞབས་ལ་གུས་པས་འདུད།",
    "གང་གི་གནས་མཆོག་ཙཱ་རི་ཊ་གཉིས་པ།",
    "དེ་དག་གི་བཞུགས་གནས་བྲག་ཕུག་དང་མཚམས་ཁང་གི་ཤུལ་དུ་མ་ད་ལྟ་ཡང་མཇལ་རྒྱུ་ཡོད།",
    "ཉི་ཟེར་ཡིན་ནམ་དགོངས་ནས་གཟིགས་པ་ན།",
    "ཞལ་དངོས་སུ་བསྟན་ཏེ་གསུང་གི་བདུད་རྩི་དངོས་སུ་བསྩལ་བ་དང་།",
    "ཡང་དུས་གཅིག་གི་ཚེ་སྤྲིན་དཀར་གྱི་གསེབ་ནས།",
    "རབ་བྱུང་བཅུ་དྲུག་པའི་ལྕགས་སྤྲེལ་ལོའི་ཟླ་བ་ལྔ་པའི་ཚེས་བཅོ་ལྔའི་མཐོ་རེངས་ལ་རི་འདིའི་ཐོག་ཏུ་འཇའ་འོད་ཀྱིས་ཁྱབ་པ་མི་མང་པོས་མཇལ་བ་དང་།",
    "ཟླ་མེད་རྣམ་དཔྱོད་གཟིང་གིས་ལེགས་བླང་ཤིང་།",
    "གང་གི་རྒྱལ་ཚབ་མཐོན་པོར་ཉེར་བཀོད་པས།",
    "དེའང་རྒྱལ་བས་ལུང་གིས་བསྔགས་པའི་བོད་དང་བོད་ཆེན་པོའི་ལྗོངས་སུ།",
    "ས་དྲུག་གི་ལམ་རྟགས་བརྙེས་པར་ཞལ་གྱིས་བཞེས་པ་སོགས་གྲུབ་པའི་གོ་འཕང་མཐོན་པོར་གཤེགས།",
    "ཞལ་སློབ་ཡོངས་ཀྱི་ཀྱང་ཀུན་མཁྱེན་ཡབ་སྲས་ཞེས་ཁྱད་མེད་ཀྱི་གཙུག་ཏུ་བསྐུར་ཞིང་གསུང་གི་བདུད་རྩི་ལེན།",
    "སྦྱོར་དྲུག་གི་རྟོག་པ་བརྙེས་པས་སྒྲོན་མེར་བལྟོས་མི་དགོས་པ་འོད་གསལ་གྱིས་འཕྲིན་ལས་རྣམས་མངོན་དུ་གཟིགས།",
    "རིམ་གཉིས་ཐུགས་དམ་ཟབ་མོ་ལ་རྩེ་གཅིག་ཏུ་གཞོལ་བས།",
    "གུ་རུ་པདྨས་ཡང་ཡང་དུ་ཞལ་གཟིགས་ཤིང་དངོས་གྲུབ་བརྙེས།",
    "འོད་གསལ་གྱིས་ཕྱི་ནང་ཀུན་ཏུ་སྒྲིབ་མེད་དུ་གཟིགས།",
    "ཏིང་ངེ་འཛིན་ཟབ་མོར་རྩེ་གཅིག་ཏུ་བཞོལ་བའི་ལམ་གྱི་དྲོད་རྟགས་མངོན་དུ་གྱུར།",
    "རྗེ་བཙུན་འཇམ་དབྱངས་སོགས་ལྷག་པའི་ལྷ་དུ་མའི་ཞལ་གཟིགས་རྗེས་སུ་བཟུང་སྟེ་གྲུབ་པའི་མཚན་མ་རྙེད།",
    "ཀ་ཐོག་དབོན་སྤྲུལ་རིན་ཆེན་སོགས་སྐྱེས་ཆེན་མང་པོས་འཕགས་པའི་རྒྱུ་འཕྲུལ་དུ་གཟིགས་པས་མཚན་གྱིས་རྣམ་གྲངས་དུ་མས་བསྔགས་བསྟོད་ཕུལ།",
    "བདག་གི་ལུས་ངག་ཡིད་གསུམ་ནི།",
    "འགྲོ་རྣམས་ཕྱག་གི་ཡལ་གས་ཉེར་འཛིན་པའི།",
    "མ་འདྲེས་ཕྱག་གིས་འདྲེན་ལ་བསྙེངས་པ་བྲལ།",
    "གང་གི་ཞབས་པད་བཀྲ་ཤིས་འཁོར་ལོ་ལ།",
    "ང་ཚོའི་གནས་ཆེན་ལུམ་བྷི་ཚལ་བཀྲ་ཤིས་རབ་བརྟན་གླིང་དགོན་དང་།",
    "ང་ཚོའི་ཞབས་དྲུང་།",
    "གེགས་བར་ཕྲ་མོ་ཙམ་མེད་ཚང་མས་ཐུགས་འདོད་ཁེང་པ་བྱུང་སོང་བ་དང་།",
    "དེ་འོག་དགོན་ཁག་གཉིས་ཀྱི་འགན་འཛིན་འོས་པ་ཆེན་མོ་ལགས་དང་།",
    "ཕྱི་ནང་གི་དངོས་པོར་བལྟ་རྟོགས་ཚག་ཚུད་བྱེད་མི་གཅིག་ལྕོག་སྟངས།",
    "དམ་ཅན་རྒྱ་མཚོར་འཕྲིན་བསྐུལ་ཞུ་གི་ཡོད།",
    "ལྕེ་བཙུན་ཤ་སྟག་གི་ཁྲི་ཐོག་བཅོ་བརྒྱད་པ་ལུམ་བྷི་ཚལ་བཀྲ་ཤིས་རབ་བརྟན་གླིང་དང་།",
    "གང་གི་ཐུགས་བཞེད་བལ་ཡུལ་གནས་ཆེན་ནང་།",
    "སླར་ཡང་ད་ལམ་ཕྱི་ལོ་ཟླ་ཚེས་ཉིན་བཀའ་སློབ་བཟང་མོ་སྩལ་བ་སོགས་ལ་བརྟེན།",
    "ད་མཚམས་ཕྱི་ནང་གང་སར་གཟིགས་གཞིག་མཛད་རྒྱུར་ཐུགས་དམ་ལ་གནོད་སྐྱོན་ཆེ་བ་དང་།",
    "ལྷག་པར་དུ་སྐུ་ན་སྨིན་སྟབས་དགོན་གྱི་ཕྱི་ནང་གང་སར་མཐུས་ཤོར་འགྲོ་ཞིག་གཟིགས་ཏེ་གཤམ་འོག་དགོན་ནང་ཞབས་ཞུ་རྣམས་ལ་གང་ལ་གང་འོས་ཀྱི་ལས་འགན་རེ་ལེན་དགོས་ཞེས་བཀའ་སློབ་སྔ་རྗེས་སྩལ་བར་བརྟེན།",
    "བསྐོ་ཤག་སྩལ་ཟིན་པ་ལྟར་ལས་དོན་བྱེད་སྒོ་གཙོ་བོ་༧སྐྱབས་རྗེ་མཆོག་གི་དགོངས་གཞི་དང་བསྟུན་པས་དོན་ཆེ་རིགས་ལ་འགོ་འཛིན་ནས་དགོངས་བསྐོར་ཞུས་ཏེ་ཆོག་ཅན་ཞུ་དགོས།",
    "དངུལ་འབབ་ནས་གཙུག་ལག་ཁང་གི་ཉམས་གསོ་ཞུ་བྱ་སོགས་དམ་དོན་དགོས་རྒྱུ།",
    "འཕྲོ་བརླག་སུ་འགྲོ་རིགས་བག་མེད་ཆུ་ཟོས་སུ་མ་སོང་བ་གཉེར་པའི་མིང་དོན་མཚུངས་པའི་ལས་འགན་རྐང་ལེན་གནང་རྒྱུ་དང་།",
    "མཆོད་མེ་ལྷ་ཁང་གི་འགན་འཛིན་གྱི་ལས་འགན།",
    "མཆོད་མེ་ལྷ་ཁང་གི་འགན་འཛིན་ནས་མཆོད་མེ་ལྷ་ཁང་འདི་ནང་ཤི་གསོན་ཇི་མང་གི་མཆོད་འབུལ་ཞུ་ཡུལ་གལ་ཆེ་ཡོད་པ་ཚང་མས་ངོས་འཛིན་གནང་བཞིན་ཡོད་ན།",
    "འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱིས་བྱིན་གྱིས་བརླབས་པའི་གནས་བོད་ཁ་བ་ཅན་གྱི་ཞིང་ཁམས་འདིར།",
    "ཚེ་འདིར་ལན་རེ་ཟུང་རེ་ཐོས་ཙམ་གྱིས།",
    "མཚན་མོ་བརྩོན་པས་གྲོལ་བརྙེས་པ།",
    "ཡོས་ལོའི་འཇུག་དུ་ཉིད་ལ་གཟིམས་ཁང་གི་རྨང་བཏེང་།",
