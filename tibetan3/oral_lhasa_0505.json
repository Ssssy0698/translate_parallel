    "སུ་ཏྲཱ་ན་ཡ་ཧཱུཾ་ཞེས་པས་རྣམ་པར་སྣང་མཛད་ལ་གསོལ་བ་གདབ་པར་བྱའོ།",
    "མ་ལས་ཉི་མའི་མིག་བསམ་པར་བྱའོ།",
    "འབར་བའི་ལྟ་བས་ཕྱོགས་རྣམས་ཁྱབ་པར་བལྟས་ལ།",
    "བཅོམ་ལྡན་འདས་སུ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "སོ་སོའི་ཁྱད་པར་གྱི་ཐིག་སྐུད་ནི་གཅིག་ཏུ་བསྡུས་ཏེ།",
    "ཨོཾ་ཨ་ནྱོ་ནྱ་ག་ཏ་སརྦ་དྷརྨ་པར་སྤ་ར་ཨ་ནུ་ག་ཏཱ།",
    "གཅིག་ཏུ་བསྒྲིལ་ནས་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་དང་ཐ་མི་དད་པར་བྱས་ནས་རིང་ཐུང་དཀྱིལ་འཁོར་གྱི་ཉིས་འགྱུར་ཚད་དུ་བྱས་ཏེ།",
    "ཕྱོགས་ཐམས་ཅད་དུ་མཉམ་པར་ཚངས་ཐིག་གདབ་པར་བྱའོ།",
    "ཚངས་ཐིག་གདབ་པར་བྱའོ།",
    "དེ་ནས་བསྐོར་ཏེ་ལྷོ་དང་བྱང་ཕྱོགས་སུ་བལྟས་ལ་ནུབ་ཀྱི་ཆ་ལ་གདབ་པར་བྱའོ།",
    "སྲིན་པོའི་མཚམས་ནས་ཤར་དུ་བལྟས་ལ་ལྷོའི་ཆ་ལ་གདབ་པར་བྱའོ།",
    "དེ་ནས་སྒོའི་ཆ་སུམ་འགྱུར་རྟ་བབས་སྒོའི་སྟེང་དུ་ཇི་ལྟར་མཛེས་པའི་ཐིག་གདབ་པར་བྱའོ།",
    "ཐིག་སྐུད་དེ་ཉིས་ཁུག་ཏུ་བྱས་ལ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རྡོ་རྗེ་ར་བས་བསྐོར་བའི་ཐིག་དྲང་ངོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་ཕྱི་རོལ་དུ་གྲྭ་ཐིག་རྡོ་རྗེའི་ལྕགས་རིའི་ནང་དུ་ཆུད་པར་དུར་ཁྲོད་བརྒྱད་ཀྱི་ཐིག་གདབ་པར་བྱའོ།",
    "ཀ་བ་བརྒྱད་ལ་སོགས་པའི་ཐིག་ནི་དེ་དང་མཚུངས་པར་གདབ་པོ།",
    "དེའི་རྟགས་ནི་ཚངས་ཐིག་འདེབས་པའི་དུས་སུ་བརྟག་པར་བྱའོ།",
    "ཡང་ན་ཚངས་པ་ལ་སོགས་པའི་ཐིག་ཐམས་ཅད་ཀྱི་དབུས་སུ་བརྟག་པར་བྱའོ།",
    "གཞན་སྒོ་འགྲམ་སོ་སོའི་ལྷ་སྣམ་ལ་སོགས་པའི་ཐིག་རྐང་ཚད་ཙམ་དུ་དབྱི་བར་བྱའོ།",
    "དེ་ལྟར་ཐིག་བཏབ་པའི་དཀྱིལ་འཁོར་ཤིན་ཏུ་མཉམ་པར་ལེགས་པར་བྲིའོ།",
    "རྟ་བབས་བཞི་ཡིས་རྣམ་པར་མཛེས།",
    "ཁ་དོག་ལྔ་ཡིས་རྣམ་པར་མཛེས།",
    "ཚོན་གསུམ་གྱིས་ནི་ལྷག་པར་གནས།",
    "དབུས་སུ་མཉམ་པར་བལྟ་བར་བྱ།",
    "འཁོར་ལོའི་ནང་དུ་བཀོད་པར་བྱ།",
    "ཁྲོ་བོའི་ལྟ་བས་ཕྱོགས་ཐམས་ཅད་དུ་མཉམ་པར་བལྟས་ལ།",
    "དེ་དག་ཞིབ་པར་བཏགས་ཏེ་རས་ཚགས་ལ་བཙགས་ལ་སྤོས་ཀྱིས་ལེགས་པར་བདུགས་ལ།",
    "དག་པའི་སྣོད་དུ་བླུགས་ཏེ་སོ་སོའི་ཕྱོགས་སུ་གཞག་པར་བྱའོ།",
    "དེ་ནས་ཐུགས་ཀའི་འོད་ཟེར་གྱིས་རང་བཞིན་མེད་པར་བྱས་ལ།",
    "བྷྲཱུཾ་ཛྲཱཾ་ཁཾ་ཧཱུཾ་ཡོངས་སུ་བསྐྱེད་པར་བྱའོ།",
    "ཇི་ལྟར་སྔོན་དུ་གསུངས་པ་བཞིན་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱི་འབར་བའི་ལྟ་བས་ལྕགས་ཀྱུའི་སྦྱོར་བས་བཀུག་སྟེ་ས་བོན་དང་གཅིག་ཏུ་གྱུར་པ་ལས།",
    "འོད་ཟེར་འབར་བ་ཡེ་ཤེས་ཀྱི་རང་བཞིན་དུ་བལྟས་ལ་གསང་སྔགས་འདིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "འདི་ལྟར་གསུངས་ཏེ།",
    "འདི་ནི་ཚོན་གྱི་རིམ་པར་བཤད།",
    "ནས་ཀྱི་ཚད་ཙམ་དུ་བར་མ་འདྲེས་པར་སོ་སོར་དྲང་བར་བྱའོ།",
    "དེ་ནས་སྔགས་པ་མཉམ་པར་གཞག་པས་ལྟས་བལྟ་བར་བྱ་སྟེ།",
    "ཡོན་པོས་རྣམ་པར་འཆད་པ་ཡི།",
    "གཡས་སྐོར་མིན་པར་བཀྱེ་བ་ཡིས།",
    "སྒོ་རྣམས་ཀྱི་ཆ་ལ་ཤར་ཕྱོགས་སུ་དཀར་པོ་དགོད་པར་བྱའོ།",
    "ལྷོའི་ཆ་ལ་སེར་པོ་དགོད་པར་བྱའོ།",
    "ནུབ་ཀྱི་ཆ་ལ་དམར་པོ་དགོད་པར་བྱའོ།",
    "བྱང་ཕྱོགས་སུ་ལྗང་གུ་དགོད་དཔར་བྱའོ།",
    "དབུས་སུ་ནག་པོ་དགོད་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བ་ལ་ཐོད་པ་དཀར་པོ་ནང་དམར་པོ་སྣ་ཚོགས་རྡོ་རྗེས་མཚན་པར་བྱའོ།",
    "ལྷའི་རྣམ་པ་དང་མི་བྲལ་བར་དགོད་པར་བྱའོ།",
    "དེ་ཉིད་འདུས་པ་ལས་འདི་ལྟར་གསུངས་ཏེ།",
    "སེམས་ཀྱིས་བཏེག་ནས་སྤྱོད་བྱས་ན།",
    "བྱང་ཕྱོགས་སུ་གསལ་ཤིང་ལ་བཙུགས་པར་བྱ་བའི་རིགས་འུར་འུར་འབར་བས་ཁྱབ་པ་ཞེས་བྱ་བའི་དུར་ཁྲོད་དུ་བྲིའོ།",
    "ཕྱག་ན་དབྱུག་པ་དང་རྩེ་གསུམ་འཛིན་ཅིང་མ་ཧེ་ལ་ཁྲོས་པའི་ཚུལ་གྱིས་བཞུགས་པ་བྲིའོ།",
    "སྦྲུལ་གྱི་ཞགས་པ་དང་དུང་འཛིན་པ་ཆུ་སྲིན་ལ་བཞུགས་པའོ།",
    "དབྱུག་པ་འཛིན་པ་རའི་སྟེང་ན་བཞུགས་པའོ།",
    "དེའི་གཡོན་དུ་ཀླུ་ཆེན་པོ་བརྒྱད་གདེངས་ཀ་དང་བཅས་པར་བྲིའོ།",
    "གཞན་ཡང་དཀྱིལ་འཁོར་གྱི་རྒྱན་དུ་གྱུར་པ་ཐམས་ཅད་ཀྱིས་ལེགས་པར་སྤྲས་ཏེ་བརྒྱན་པར་བྱའོ།",
    "གལ་ཏེ་དཀྱིལ་འཁོར་གྱི་གནས་སུ་ཆར་དབབ་པར་གྱུར་ན།",
    "དེའི་འོད་ཟེར་ཡེ་ཤེས་ཀྱི་མེ་ལྟ་བུས་སྤྲིན་གྱི་ཚོགས་ཡོངས་སུ་གཏོར་བའི་བསམ་པ་དང་ལྡན་པར་བྱའོ།"
  ]
