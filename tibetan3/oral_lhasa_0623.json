    "སྲིད་གསུམ་འཕེན་པར་བྱེད་པ་ཡི།",
    "གནའ་རབས་རྣམས་ཀྱིས་གསལ་བ་ཉིད་དུ་བྱས་གྱུར་པ།",
    "སན་འདིར་ནི་དེ་ཉིད་བསྟན་པར་འདོད་པ་ཡིནནོ།",
    "འདི་བསྒྲུབ་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པ་དང་།",
    "འགྲོ་བའི་ཚོད་མམེད་པསན་དེ་དག་ནི་རྗེས་སུ་དཔག་པ་ལ་ལོག་པར་རྟོག་པ་ཡིན་ནོ།",
    "དེ་ལྟ་༣་འོན་སྒྲུབ་པར་མི་ནུས་པ་བཞི་པ་ལ་ཕྱོགས་པ་དངོས་པོ་ལ་དར་ཆས་ཁྱབ་པ་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་མ་དེས་ནི་རྟོགས་པར་མ་འགྱུར་རོ།",
    "འོནགཏི་ག་དགོས་པ་རང་རྒྱུད་པར་འགྱུར་རོ་ཞེ་ན།",
    "༡༩༡ པེ་བཏགས་པར་རྟོགས་པར་བྱ་བ་དེ་ཡང་དང་པརྟེན།",
    "དེས་ན་སྤྱི་ཙམ་བརྗོད་པ་ཚོ་ནི་སྐྱོ་དགོས་པ་མེད་པར་འགྱུར་རོ།",
    "༡༩༡ པེ་སྒྲུབ་བྱེད་ཀྱིས་འཛིན་པར་ཁྱད་པར་མེད་པའི་རི་རོ།",
    "གལ་ཏེ་བསྒྲུབ་པ་འབྲས་བུ་མེད་པ་ཉི་མ་ཡིན་པའི་པའི་བརྙན་པར་དོགས་པ་ཉིད་མེད་པ་མ་ཡིན་ནམ།",
    "འབད་པས་ཐོབ་པར་བྱ་བའི་དོན་ངེས་པའི་ཚིག་སྦྱར་བ་ནི་སླ་བ་ལ་གཟོ་བམ་ཡིན་ནོ།",
    "དེས་ན་རྟོགས་པར་དཀའ་བ་ཡོངས་སུ་སྤུང་བ་ཕྱིར་ཡང་ཕྱོགས་ཞེས་སྨོས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་བསྒྲུབ་བྱའི་ཚོས་རྟོགས་པར་ཡང་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དེ་ནི་ཁྱད་པར་གྱི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱད་པར་ལ་ཁྱབ་པ་མི་ཚུགས་པ་དེ་ཡང་པ་ནམ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ཡང་ཁྱད་པར་ལ་པ་སྲིད་པའི་ཕྱིར་རོ།",
    "དེས་ན་ཁྱབ་པར་བྱེད་པའི་ཁྱད་པར་ཇི་ལྟ་བུ་ཡིན་པ་དེ་ཉིད་དེ་ལྟར་བརྗོད་པ་ཡིན་གྱི།",
    "ཡོད་པ་ཁོ་ན་ཞེས་བྱ་བ་རྣམ་གསུམ་སྲིད་པར་འགྱུར་རོ།",
    "དེ་ལ་བྱབ་པར་བྱེད་པ་གོ་བར་བྱ་བ་ལ་ཁྱབ་པར་བྱ་བ་གོ་བར་བྱེད་པ་ཉིད་དུ་འཐད་པས་ན།",
    "དེ་ག་ཉིད་སྒྲུབ་པར་བྱེད་ཕྱིར་རོ།",
    "ཁྱབ་པར་བྱ་བ་ཉེ་བར་གནས་པ་ལ་ཁྱབ་པར་བྱེད་པ་ཡཨུན་པ་ཡོདཁྱད་དེ་ཡོད་པ་ལ་ས་སོར་ངེས་པར་གྱུར་པའི་ཁྱབ་པར་བྱེད་པའི་རྟོགས་པ་མི་འགལ་བའི་ཕྱིར་རོ།",
    "མི་རྟག་པ་ཉིད་ཕྱོལ་བ་ལས་བྱུང་བ་ཉིད་མེད་པར་འགྱུར་ཡང་རྩོལ་པ་ལས་བྱུང་བ་ལ་ངེས་པར་ཡོད་པའི་ཕྱིར་དེ་ལས་མ་རྟོགས་པར་ཇི་ལྟར་འགྱུར།",
    "དེས་ནཱམ་ལྡན་པ་རྣཆན་པ་གཅོད་པ་ཉིད་འཐད་པ་ཡིན་ཏེ་བརྗོད་བྱ་ཇི་ལྟ་བར་རྗོད་པར་བྱེད་པ་སྦྱོར་བའི་ང་རོ།",
    "གཟུང་བ་རྣམ་པ་གསུམ་སྲིད་པ་ལས་གཞན་དང་ལྡན་པ་རྣམ་པར་གཅོད་པ་ཏིང་བྱབ་པར་བྱེད་པ་སྤང་དུས་ང་།",
    "ཀཱན་ཡོདོན་དེ་པ་མ་བརྟེན་པས་རྗེས་སུ་དཔོག་པར་མི་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེ་དེ་ལ་གནས་པར་མི་རྟག་པས་ཁྱད་པར་ཡོད་དུ་ཆུད་པར་མི་འགྱུར་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་དེ་བུས་པ་མེད་པར་རྟོགས་པ་ཉིད་དེ།",
    "གསུམ་ལ་ཚུལ་གསུམ་འབྲེལ་པས་གྲུབ་པར་སྟོན་པ་ན།",
    "གསུམ་པ་རྣམས་ལས་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ཚང་ཞིག་འགྲེལ་པས་བསྒྲུབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "ོབར་བྱཕོ་དང་གོ་བར་བྱེད་པ་ཁྱད་པར་མེད་པར་རྩོད་པའི་སྐབས་ནི་ཡོད་པས་ཡིན་ནོ།",
    "དེ་ལྟ་ན་འོ་ན་དངོས་པོ་ལ་ཁྱད་པར་མེད་པའི་སྦྱརི།",
    "གོ་བར་བྱ་བ་དང་གོ་བར་བྱེད་པའི་དེས་པོ་ནི་རྣམཔར་རྟོག་པ་ལག་བྱས་པ་ལ་བལྟོས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ལ་མི་གནས་པའི་དངོས་པོ།",
    "རྟོགས་པར་བྱེད་པ་ལ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཆོ་རྔུལ་གང་ཡིན་པ་དེཇུལ་ཉིད་ཡིན་ནོ་ཞེས་ལུགས་ལོག་པར་བསྟན་ཏོ།",
    "དེས་ན་དེའི་རིགས་ཅན་ནི་གཅད་པར་མནུས་སོ།",
    "བསྒྲུབ་བྱ་སྤྱི་བྱེད་ཀྱི་དངོས་པོར་རྣམ་པར་གནས་པའི་ཕྱིར་རོ།",
    "ཐ་དད་ཀྱང་གནོད་པ་བྱེད་པ་ཉིདཀྱིས་མི་མཐུན་པ་ཕྱོགས་ལ་འཇུག་པ་རྣམ་པར་བཅང་པ་ན་བར་བྱེད་པ་ཁོ་ན་ཡིན་ལ།",
    "༡༩༡ པེ་དཔར་སྒྱུ་ལ་འཁྲུལ་པ་ཡིན་པ་བཞིནནོ།",
    "དེས་ན་དེ་ལྟར་ཡངདེའི་རང་བཞིན་གང་ཡིན་པ་དེ་གཞན་ལ་མེད་པ་ཡིན་གྱི་བྱས་པ་ཉིད་ནི་ཡོད་པ་ཉིད་དོ།",
    "བྱས་པ་མི་རྟག་པ་དང་འཁྲུལ་པར་འགྱུར་ཏེ།",
    "དཔེ་ན་སྒྲ་འམ་བུམ་པ་རྟག་པར་ཐེ་ཚོམ་ཟ་བ་ན།",
    "མི་རྟག་པ་ཉིད་ལས་དེ་བསྟན་པར་མི་འགྱུར་རོ།",
    "དངོས་པོ་ཐ་མི་དད་པ་ལ་ནི་ང་ལྟར་བཡཔས་སྟོང་ཡང་སྒྲ་བྱས་པ་ཡིན་པ་དེ་བཞིན་དུ།",
    "འདི་ལྟང་འཁྲུལ་པ་དང་མ་འཁྲུལ་བ་རྣམ་པར་དཔྱོད་པ་ན་གདོན་མི་ཟ་བར་བྱས་པ་ཉིད་ལ་ཕྱོགས་པའི་དད་བཞིན་བསྟན་པར་བྱ་བ་ཡིན་ཏེ།",
    "དགལ་ཏེ་དེ་ལྟ་ན་ཐམས་ཅད་གཉིད་གཤ་ཀ་ཕམ་ཡིན་ཡང་པ་དེ་ཡོངས་སུ་སྤངས་ནས་ཡོད་པར་འགྱུར་བའི་ཕྱིར་དེའི་བདག་ཉིད་འཁྲུལ་པར་འགྱུར་ཏེ།",
    "འདི་ནི་མདུན་དུ་འཆད་པར་འགྱུར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་དང་བསྒྲུབ་པར་བྱ་བདོག་ཕན་ཚུན་འགལ་བའི་ཕྱུར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་ནི་རང་བཞིན་ཞི་གྲུབ་པ་ཡིན་ལ་བསྒྲུབ་པར་བྱ་བ་འདི་ལས་བཟློག་པ་ཡིན་ཏེ།",
    "བརྟེའུདཀོ་དེའི་དངོསཔོ་ཉིད་དེ་དེ་ཡིན་ན་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་བྱེབྲུག་མེདཞེ་ན།",
    "རྟོག་པ་ནི་རྣམ་པར་རྟོག་པའི་བྱེའུ་རིག་བ་སྟེ།",
    "དེ་ལྟ་བུ་ན་དྲུག་བུ་དང་བསྒྲུབ་པར་བྱ་བའི་རྣམ་པར་དབྱེ་བ་འཐོབ་པའི་ཕྱིར་བསྒྲུབ་བྱ་དང་སྒྲུབ་པའི་དངོས་པོའཐདཔ་ངོསན་དེ་ལྟར་རྟོགས་པའི་དངོས་པོ་ཉིད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པའི་དྲི་རྟོགས་པ་མ་ཡིན་མངོན་སུམ་ཉིད་དོ།",
    "བྱས་དུས་ད་ཞེས་བྱའོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ཤེས་པ་ཞེས་སྨོས་སོ།",
    "འོན་ཀྱང་མ་རྟོགས་པའི་དོན་རྟོགས་པར་བྱ་བའི་ཕྱིར་རྗེས་སུ་དབག་བའི་ཀུས་པ་རྩོལ་བ་ཡི་ཚུནོ།",
    "ཆ་ཤས་ཀྱིས་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པར་ཡིན་པར་འགྱུར་རོ།",
    "དངོས་པོ་ཉིད་ལ་སོགས་པ་རྒྱུ་ལ་གནས་པ་སྐྱེད་པར་བྱེད་བམ་ཡིན་ལ།",
    "འོན་ཀྱང་ཚེས་བ་དད་པ་ངེས་པའི་རྣམ་པར་རྟོག་པ་མེའི་ཆ་ལས་ཁྱད་པར་གྱི་ཆ་ཐ་དད་པར་བྱེད་པར་ཟད་དོ།",
    "དེ་བཞིན་དུ་སྤྱི་དང་ཁྱད་པར་གྱི་ཚོས་གཞན་དག་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "འཇིམ་པ་ལས་ཀྱང་དབྱིབས་ཀྱི་ཁྱད་པརམཱནིན།",
    "དེར་འཇིམ་བཡོད་ཀྱང་རྫ་མཁན་མེད་པའི་ཕྱིར་བུམ་པའི་དབྱིབས་མེད་པ་ནི་མ་ཡིན་པ་ར་རྫ་མཁན་དོན་ཉིད་དོཞེས་བྱ་བར་ནུས་པར་འ་གྱུར་རོ།",
    "དེ་བཞིན་དུ་མིག་ཀྱང་མིག་ལ་སོགས་པའི་ཚོགས་པ་ཁྱད་པར་ཅན་ལ་སྐྱེལ།",
    "པར་བྱ་བ་དང་གོ་བར་བྱེད་པའི་དངོས་པོའི་སྐབས་ཡིན་པས།",
    "སྐྱེ་བོ་ཉིད་ལ་སོགས་པ་གང་ཡིན་པ་དེ་དག་ཀྱང་རྟགས་ཀྱི་བ་ཁྱད་པར་གང་མས་ཏེ།",
    "ཁྱད་པར་ཅན་གྱི་རྟགས་ཀྱི་ཁྱད་པར་རྣམས་རྟོགས་ན་གཏནཚིགས་ཀྱི་དངོས་པོར་འདོར་བ་ཡིན་ཏོ།",
    "འདི་དག་ནི་རྟགས་ཀྱི་ཁྱད་པར་དུ་གྱུར་པ་ཡནི་ཏེ།",
    "འཇིག་པ་རྒྱུདང་ལྡན་པར་སྨྲ་བ་རྣམས་ཀྱི་བྱས་བ་ཉིད་བཞིན་ནོ།",
    "དེ་ལྟར་སླ་བ་ནི་དེའི་བདག་ཉིད་ལས་བྱས་པ་གོ་བརབྱེད་བསྨྲ་བ་ནི་མ་ཡིན་ཏེ།",
    "དདི་ལྟར་ཕྱིས་ཀྱང་ཡོད་པར་འགྱུར་ཞེས་བཤད།",
    "ཞེས་བྱ་བའི་ཐ་ཚིག་གོདྨར་ནི་འབྲལ་བ་རྟོགས་པསྤྱི་པ་རང་བཞིན་གྱི་གཏན་ཚིགས་ལས་ཐ་དད་པར་བྱེད་པ་མེད་པ་ལ་དམིགས་པའི་རང་བཞིན་བརྗོད་པ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཚང་མ་རྣམས་ནིཞེས་སྨོས་སོ།",
    "ཞེས་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་སྟོན་པར་བྱེདཔ།",
    "དེས་ན་འཇུག་པ་བཀག་ན་དེ་ལུས་འཇུག་པ་བཞིན་དུ་ནུམ་པ་རྟོགས་པ་དེའི་རྩ་བ་ཅན་གྱི་སྒྲ་ཡང་བཀག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་ལྟ་མེད་ཀྱི་དམིགས་པ་ཡོད་པར་བརྗོད་པ་ཡིནནོ།",
    "རྣམ་པར་ཤེས་པའི་ཡུལ་གྱི་རང་བཞིན་གྱི་དངོས་པོ།",
    "རྫོགས་པ་ཁྱད་པར་མང་པའི་ཕྱིར་རོ།",
    "དེས་ན་ཤེས་པ་ལ་ཤེས་བྱའི་མཚན་ཉིད་མི་དམིགས་པ་གྲུབ་པ་ཡིན་ལ་ཤེས་པ་མེད་པང་ཀྲུབ་པཉིན་དོན་མེད་པར་གྲུབ་པའི་ཕྱིར་པོ་ལོགས་སུ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "ཤེས་པ་རྣལྟར་སྒྲུབ་པར་བྱེད་པ་དེ་ལྟར་བསྟན་པས་གཏན་ཚིགས་ཀྱི་བྱེ་བྲག་མ་བལྟོསནས་ཁྱད་པ་ཅན་དུ་སྟོན་པར་བྱེད་དོ།",
    "བྱེདྲུག་དེ་དག་ལས་ཁྱད་པར་དང་ལྡན་པ་ཡིན་ན་འགྱུར་རོ།",
    "དེའིཤུགས་ཀྱིས་ཐོབ་པའི་འབྲས་བུ་ནི་འབྲེལཔདེའི་བྱེ་བྲག་ནི་ཁྱད་པར་ཏེ་ཞེས་བསྟན།",
    "ཁྱད་པར་ཡང་མི་དམིགསཔའི་མཚན་ཉིད་ཀྱིར་གྱུར་བའི་ཡོད་པ་ཅན་ཡིནནོ།",
    "དེས་ནི་ཁྱད་པར་རབ་ཏུ་སྦྱར་བའི་དོན་ལ་གནས་པ་ཉིད་དུ་ཡང་བསྒྲུབ་པར་ནུས་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་གྲུབ་པ་འདིའི་འབྲས་བུ་ཡིན་ན་འདིར་དེ་མེད་པ་སྒྲུབ་པ་བྱེད་པར་འགྱུར་རོ།",
    "རྟོགས་པ་ཡར་ཐུག་པ་ཡོད་ན་འགྱུར་བ་ཡིན་པའི་ཕྱིར་མི་རྟོགས་པར་འགྱུར་རོ།",
    "མ་དེར་པརྟོགས་ན་མེད་པ་རྟོགས་པར་འགྱུར་བ་ཡིན་ལ།",
    "དེའགོག་པ་ནི་དེ་བཞིན་དུ་སྟེ་རྣམ་པ་གཉིས་པོ་རྣམ་པ་དེ་ཉིད་བརྗོད་པརནི་བུམ་པ་ལ་སེམས་པ་དག་པར་བྱ་པ་ལས་གཞན་ཤེས་པར་བྱ་བ་ཕྱོགས་ཡོད་ཀྱང་མེད་པ་ཅི་སྟེ་མི་འགྲུབ།",
    "མིགས་པ་གཞན་མྱོང་ཡང་དམིགས་གཞན་དག་མེད་པར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་ལ་མངོན་སུམ་གྱི་བྱེད་པ་མེད་པ་ཉིདདེ།",
    "དངོས་པོ་མེད་པ་ནི་ངོ་བོ་མེད་དོ་ཞེས་བྱ་བ་དེ་ཉིད་ལྟད་མཱ་པར་བཞག་ཅེན།",
    "༡༩༡ པེ་ན་སྔོན་མ་མཐོང་བས་ཐ་ལ་སོགས་པ་གང་ལ་ཤེས་པ་མེད་པ་དེ་ལ་ཡང་མ་འོང་པ་ལསཔཟློག་པ་ཤེས་པར་བླ་བའི་ཕྱིར།",
    "ཐམྱུད་ནི་དེ་མེད་ན་མི་འབྱུང་པའི་ཐ་སྙད་བསྒྲུབ་པར་བྱ་བཉིད་དུ་བསྟན་ཏེ།",
    "དེཉིད་ཀྱི་ཕྱིར་གལ་ཏེ་གཅིག་ཡོངས་སུ་བཅད་པ་ཉིད་ཀྱིས་གཞནརྣམ་པར་བཅད་པ་འགྲུབ་ན།",
    "ཁྱད་པར་ཡོད་པས་དེ་ལས་གཞན་ཐམས་ཅད་མེད་པར་འགྲུབ་པར་འགྱུར་སྤྱི་མཚུངས་པར་རུང་བའི་རང་བཞིནལེ་ནི་ནིམ་ཡིན་ནོ།",
    "ཁྱད་པར་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱབ་ལ་སགས་པ་ཚོ་ད་པ་བཀོད་དེ།",
    "བལྟར་མི་རུང་བ་དེའི་དག་ཉིད་ལེན་པ་འགག་པར་བྱེད་པའི་ཕྱིར་འགལ་བ་མེད་དོ།",
    "དེས་ན་གཞན་དམིགས་ན་མི་དམིགས་པ་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ལ་གཞན་ཡོད་པར་ཡང་མེད་པ་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "པའི་བྱེད་པ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "འདིརི་ཡ་གཉིས་དང་གཉིས་ཉིད་དུ་རྣམ་པར་འཇོག་པ་ན་མངོན་སུམ་ཉིད་ཀྱིས་ཐ་སྙད་བྱེད་པའི་ཕྱིར་མ་སྡོམིགས་པ་དོན་མེད་དོ།",
    "དེ་དྲབ་ཏུ་བསྟན་པས་མེད་པའི་ཤེས་པ་དང་སྒྲ་དང་བ་སྙདབསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་མ་དམིགས་པ་དོན་མེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དོན་གཞན་ཡོད་པ་དངོས་པོའི་ངོ་བམེད་པར་བསྒྲུབ་པར་བྱ་བ་ཡིན་པར་འགྱུར་ངོ།",
    "དངོས་པོ་དངོས་པོ་མེད་པ་ནམ་མགས་པརཚདམ་མེད་པ་ཅན་ཡན་ལ་དངོས་པོ་དངོས་པོ་མེད་པ་ཡང་དངོས་པོ་གཞན་ཡོད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དས་པོ་དངོས་པོ་མེད་པ་སྒྲུབ་པ་ལ་མི་དམིགས་པ་གྲུབ་པ་ལ་བལྟོས་པའི་ཤེས་པ་དཤེས་བྱའི་མཚན་ཉིད་དེ་གྲུབ་པ་ཉིདན་གྲུབ་པའི་དངོས་པོ་མེད་པ་ནི་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "རྨོངས་པས་དོར་ཐ་སྙད་ཡོ་བྱེད་པ་ནི་ཡོད་པ་མི་དམིགས་པར་མི་སྲིད་པའི་ཕྱིར་དམིགས་སུ་རུང་བ་མེད་པར་ཉེ་བར་བསྡུ་བའི་སྒོ་ནས་དངོས་པོ་མེད་པར་ངེས་པའི་མི་དམིགས་པས་འཇུག་པར་བྱེད་དོ།",
    "རྟོགས་པ་འདི་སྔར་ཀྱི་ད་རྟོགས་པ་དང་མི་འདྲ་པའི་ཕྱིར་དེ་ཙམཁྲིད་གྲུབ་པར་འགྱུར་བས་ཐ་སྙད་བསྒྲུབ་པར་བརྗོད་པ་ཡིན་གྱི།",
    "༡༩༡ པེ་པཙམཉིད་གྲུབ་པར་འགྱུར་རོ།",
    "བདག་ཉིད་ཨཱན་པའི་ཕྱིར་དུས་དེ་སྒྲུབ་པ་ན་དེ་ཡང་གྲུབ་ཟིན་པའི་ཕྱིར་ཤིང་ངོ་ཞེས་བྱ་རྟོགས་པའི་མཐར་ཐུག་པ་ཅན་གྲུབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "འོན་ཀྱང་བལྟར་རུང་བའི་བུམ་པས་རྣམ་པར་བཙད་པའི་ཕྱོགས་ལས་གཞན་དུ་གྲུབ་པས་ཕྱོགས་དྲག་པ་ཡརིན་",
    "དེས་ན་གཞན་གྱི་ཐ་སྙད་ཀྱི་དབསྒྲུབ་པར་བྱ་བར་འགྱུར་རོ་།",
    "འོནཀྱང་དངོས་པོ་གཞན་ཉིད་རྣམ་པར་དཔྱོད་པ་ཉིད་ཀྱིས་ཡིན་པ་དེའི་ཕྱིར་དེ་ཉིད་དེར་སྒྲོ་བཏགས་པ་རྟོགས་པ་ཡིན་པར་བསྟན་ཏེ།",
    "དེས་ན་རྟོགས་པ་པོའི་རྟོགས་པ་ལ་ལྟས་ཏེ་གཞན་ཡོདཔ་དངོས་པོ་དངོས་པ་མེད་པར་བརྗོད་དོ།",
    "འདི་བརྗོད་པར་བྱ་སྟེ།",
    "པོ་མེད་པ་ཡིན་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "༡༩༡ པེ་པར་གསུངས་སོ།",
    "འོན་ཀྱང་རྟོགས་པ་ཉིད་སྐྱེས་པར་ཟད་དོ།",
    "དེའི་ཕྱིར་མངོན་སུམ་ཉིད་ཡིན་ཡངཛ་ཡེགས་པ་ལ་བལྟོས་པ་ཡོད་པའི་ཕྱིར་གང་ལས་དཔེ་མ་གྲུབ་པར་འགྱུར་ས་དེ་གཅིག་པུ་ནི་སྒྲུབ་བྱེད་དུ་བརྗོད་པ་མཛདྷིའོ།",
    "ཕྱི་མར་ཡང་བཟློག་པའི་རྟོག་པར་ཡོདཔ་ཉིད་ཀྱིས་བཟློག་པའི་རྒྱུ་ཡོད་པར་བསྒྲུབས་པ་ཡོད།",
    "དེ་ལྟོམན་རྟོགས་པར་བྱེད་པ་ཉིད་དུ་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་མ་ནུས་པ་ལ་བལྟོས་སམ་གནས་པར་འགྱུར་བ་ཡི།",
    "ཕྱོགས་སམ་སྣང་བ་དེ་ཉིད་དེས་དབེན་པ་ཡིན་པལས་གཞན་ཉིད་ཀྱིས་དེ་ལྟར་རྣམ་པར་བཞག་གོ།",
    "བལྟར་མི་རུང་བ་བསྐྱུང་རུང་བ་དང་འགལ་བའི་བལྟར་བྱུང་བ་ལས་གཞན་ཉིད་ཀྱིས་རྟོགས་པར་བྱེད་དོ།",
    "འདི་ལ་གཞུང་ལུགས་ཤེས་པར་རློམ་པ་ད་དག་ཀྱང་གྲོལ་བའི་ཕྱིར།",
    "དེ་ནི་རྣམ་པ་གཅིག་ཏུ་ཟད་དོ་ཞེས་ཤིས་པར་མི་འགྱུར་བར་བྱ་བའི་ཕྱིར་རོ།",
    "དེར་ཡང་གཞན་ཡོད་པ་ཉིད་ཀྱིས་མེད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "མེད་ན་རིགས་པ་མེད་པར་འགྱུར་གྱི།",
    "སྔ་མ་ལ་དེ་བསྒྲུབས་པར་འགྱུར་རོ།",
    "དེས་ན་དེ་ལྟར་གཞན་པ་སྒྲུབས་པས་གཏན་འགོག་པ་ལ་ནི་འགལ་བ་ཉིད་འགོག་པར་བྱེད་པ་ཡིན་ལ།",
    "དེས་ན་དེ་ལྟ་བུར་བ་པ་བཀག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེས་ན་འགུལ་བ་རབ་ཏུ་བསྟན་པས་ཀྱང་ཡུལ་བསྟན་པ་ཀྱི་སྒོནས་མེད་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བར་གྲུབ་བོ།",
    "དེསན་བཟློག་པར་བྱ་བ་དང་ཟློག་པར་བྱེད་པ་དངོས་བ་ལས་འབུལ་བ་བཞིན་དུ་མྱུལ་སོགས་པ་མེད་པ་ཡང་སྡོད་པར་སྲད་བ་བཟློག་པ་ཙམ་གྱིས་ནི་སྒྲུབ་པ་མ་ཡིན་པ་ཉིད་དོ།",
    "རྒྱུ་དང་འབྲས་བུ་མ་ཡནེ་པ་འདོན་རྒྱུདང་འབྲས་བུ་མ་ན་པ་མེད་པར་འགྱུར་རོ།",
    "དགག་པར་བྱ་བ་དེ་འབྲེལ་པའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་བཀག་པ་སུན་འ་འདྲེསཱའི་ཡུལ་ཕྱུག་པ་འགྲུབ་སྟེ་ཁྱབ་པར་བྱ་བ་མེད་ཀྱང་ཁྱབ་པར་བྱེད་པ་མེད་པ་འགྲུབ་པའི་ཕྱིར་རོ།",
    "དེས་ན་འབྲེལ་བ་ན་དགག་པར་བྱ་བ་ཡིན་ལ་འབྲེལ་པའི་ཡུལ་ནི་འགོག་པར་བྱེད་པ་ཡིན་ནོ།",
    "གཅུག་བཀག་པས་གཞན་མེད་པར་རྟོགས་པར་བྱ་བ་གང་ཡིན་བ་དེ་ནཙྩམི་དམིགས་པ་ཁོ་ནས་གོ་བར་བྱེད་ཀྱི་གཞན་གྱིས་ན་པ་ཡིཛ་ནོ།",
    "འདི་ནི་རྣམ་པ་བཞཡིན་པར་བསྟན་ཏོ།",
    "ཁྱབ་པར་བྱེད་པ་དང་འབྲེལ་པའི་རང་བཞིན་ནེ།",
    "ལོ་མ་ལ་སོབ་པ་འངན་པའིང་པོས་ཀྱང་རྟོགས་པས་མ་རྟོགས་ན་མེད་པར་ཁོང་དུ་ཆུད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་འདིར་ཁྱབ་པར་བྱེད་པམེད་པ་ལ་སོགས་པ་འགལ་བ་མ་ཡིན་པ་དེ་ལྟ་ན་ཡང་དབྱིག་ཐོགས་འགྲོའོ་ཞེས་བྱ་བ་བཞིན་དུ་འགལ་བའགླུའདུཔ་ཡིན་ཏེ།",
    "གང་ལས་གཏན་ཚིགས་གྲུབ་པར་འགྱུར་བ་ཇི་ལྟ་ན་འདི་བསྟུད་ང་དུང་བའི་བདག་ཉིད་དག་ཁོ་ན་མ་གྲུབ་པ་ཡིན་ཞེན།",
    "ོན་འགལ་བའི་འཁྲུས་བུ་དམིགས་པ་ཉིད་གོ་བར་བྱེད་པར་འགྱུར་རོ།",
    "དཔོན་ཕྱོགས་འདིན་པ་སྤུ་ལངས་པ་ལསོགས་པའི་བྱ་དཔར་དང་ལྡན་པ་ཡང་ཡིན་ལ་སྐྱེས་བུ་ཡང་ཡིན་པ་དེ་ལྟ་བུ་ཅན་མ་ཡིན་ཏེ།",
    "དུས་ལ་སོགས་ལ་བལྟོས་པར་འདོང་།",
    "འཕེལ་བ་དང་མ་བྲལ་བ་དེ་ལྟར་འཕེལ་པ་རྟེན་པར་མ་བརྗོད་པ་རྟོགསཞས་རྟོགས་པར་བྱེད་དོ།",
    "༡༩༡ པེ་ཡི་ནུས་པ་གྲང་བ་མེད་པ་སྒྲུབ་པར་བྱེད་བ་མ་ཡིན་ནོ།",
    "འོན་ཞེས་རྩོད་པར་བྱེད་དོ།",
    "རྗེས་སུ་དཔོག་པར་བྱེད་པ་གང་ཡིན།",
    "འབྲས་བུ་ལ་སོགས་པའི་གཏན་ཚིགས་སྟོན་པར།",
    "དེསན་རྒྱུ་ཚོགས་པས་འབྲས་བུ་སྐྱེ་བ་རྗེས་སུ་དཔོག་པར་བྱེད་པ་གང་ཡིན་པ་དེ་གང་དུ་འང་ཞེས་བྱ་བས་ནི་གཏནཙགས་དེ་ཉིད་ཀྱི་ཁོངས་སུ་འདུ་བ་བཅད་པ་ཡནརོཚོགས་པ་ལས་འབྲས་བུ་སྐྱེ་བར་རྗེས་སུ་དཔོག་པ་ནན་དུ་མིགས་པའི་ཕྱིར་འབྲས་བུ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་རྗེསསུ་ང་པག་ལོར་བྱ་བར་འགྱུར་རོ།",
    "རྒྱུ་ཚོགས་པ་ཡིས་འབྲས་བུ་སྐྱེ་བར་རྗེས་སུ་དཔག་པ་གང་ཡིན་པ་དེ་ན་རང་བཞིན་ཡིན་པར་བརྗོད་དོ།",
    "རྒྱུ་ལ་གནས་པའི་རང་བཞིན་ཕྱི་ཁྱད་པར་ཡིན་ནོ།",
    "མི་མཐུན་པ་ཉིད་ལས་སྐྱེའོ་ཞེས་ངེས་པར་བྱེད་དོ།",
    "དེ་ལས་ཁྱད་པར་མི་སྐྱེན་ཕྱིས་ཀྱང་མེད་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེས་སྲིད་པའི་ནི་རུང་བ་ཉིད་ཡིན་ནོཞེས་བརྗོད་པར་འགྱུར་རོ།",
    "དེམྱུ་གུ་ལ་སོགས་པ་བསྐྱེད་པར་བྱ་བའི་འབྲས་བུ་ཡིན་ལ།",
    "དེ་དང་འབྲེལ་བ་སྤྱོད་པར་བྱེད་པའི་མཚན་ཉིད་ཀྱི་ནུས་པ་ནི་འབྲས་བུ་གནས་པའོ།",
    "ཁོ་ནའི་སྒྲ་ནི་ངེས་པར་གཟུང་བ་ཡིན་ཏེ།",
    "ཚོགས་པ་ཙམ་ཉིད་ན་འབྲས་བུ་དང་མཐུན་པའི་ཁྱད་པར་སྒྲུབ་པ་གང་ཨར་པ།",
    "ཁྱད་པར་སྐྱེ་བར་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རུང་ཉིད་དུ་རྗེསསུ་དཔོག་པ་ལོ་ཚོགས་པརྣམས་མ་འཁྲུལ་པ་ཡིན་ཏེ་རུས་པ་འབྲས་བུ་ལ་འཁྲུལ་པ་མེད་པའི་ཕྱིར་རོ།",
    "འོ་ན་འདི་དང་རྒྱུའི་ཚོགས་པ་སྔ་མ་ལས་ཕྱི་མ་ཁྱད་པར་ཅན་དུ་གསབ་ཉིད་དང་ལྡན་པོ་རྗེས་སུ་དཔག་པར་བྱ་བར་འགྱུར་རོ།",
    "དེས་ན་ཇི་ལྟར་རོ་ཡོད་པན་གཟུགས་ཡོད་པ་དེ་ལྟ་བུ་ཉིད་དུ་མ་རྟོགས་ན་དེཡསདི་ལྟར་རྟོགས་པར་མི་འགྱུར་རོ།",
    "མེ་ཡང་ངུ་བུ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ན་རོགཟུགས་བབ་ལྟོས་པར་མ་བརྗོད་པའི་ཕྱིར་རོ།",
    "སྨྱུ་འབྲས་བུ་ལ་ངེས་པ་མེད་པའི་ཕྱིརདུ་ཡོད་ཀྱང་ཤེས་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "གཟུགས་ཀྱི་རྒྱུ་ཡང་གཟུགས་སྐྱེད་པར་ངེས་པཙན་བས་གཟུགས་ཀྱང་གདོནམི་ཟ་བར་ཡོད་པ་ཉིད་དོ།",
    "དེས་ན་དེའི་འབྲས་བུ་དུས་མཚུངས་པར་ཡོད་པའི་གཟུགས་མེད་པས་ན་དེའི་འབྲས་བུ་ཉིད་མེད་པར་རོ།",
    "རོའི་རྣམ་པ་དེ་ལྟ་བུ་ལས་གཟུགས་ཀྱི་ཀྱི་རྒྱུ་ནུས་པ་ཞུགས་པ་ཡོད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "དེས་ན་གཟུགས་རྟོགས་པ་ནི་གཟུགས་ཀྱི་རྒྱུར་གྱུར་པའི་རོའི་རྒྱུ་ཡོད་པར་རྟོགས་པར་བྱ་བ་གཟུགས་སྐྱེད་པ་ལ་གྲོགས་ཀྱང་མིང་བློ་རུས་པ་དང་ལྡན་པ་རྟོགས་པའི་ནང་དུ་འདུས་པ་ཁོ་ནའོ།",
    "དྲི་རྣམ་པར་ཤེས་པ་ཞེས་རྟོགས་པའི་ཕྱིར་རོ།",
    "རྗོད་པར་འདོད་པ་སྤྱིའི་ཞེས་སྨོས་སོ།",
    "བརྗོད་པར་འདོད་པ་ཙམ་ཡིན་ན་འདོདཆགས་ཡིན་ན།",
    "༡༩༡ པེ་པའི་རྒྱུན་མིན་པར་འགྱུར།",
    "གལ་ཏེ་སྡུག་བསྔ་ལ་པེའི་ཕུང་པོ་རྣམས་ལ་ཆགས་པར་མི་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དེ་ཡང་ང་རོ་ཞེས་ཕུང་པོ་ལྔ་ལས་ཐ་དད་པར་རྟོགས་བ་ཡིན་ནོ།",
    "དེ་ལ་ཡང་འདི་འདོད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ཡང་ངའོ་སྙམ་པར་རྟོགས་པ་ཡིན་ནོ།",
    "དེས་ན་གསུམ་པོ་འདི་གཅིག་ཏུ་རྟོགས་པར་འགྱུར་བ་ཡིནནོ།",
    "དེ་བས་བརྗོད་པར་འདོད་པ་ཉིད་ཡིན་ཡང་གཉེན་པོ་དང་བཅས་པའི་སྡུག་བསྔལ་དག་པའི་བདག་ཉིད་ཡིན་ནོ།",
    "ཤོགས་པ་གསུང་པར་རྟོགས་པ་ཞེས་རྒྱས་པར་བརྗོད་པ་ཡིན་ནོ།",
    "གཞན་ཡང་ལྷག་པར་ཞེན་པ་འགྲུལ་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་འཁྲུལ་པར་བརྗོད་དོ།",
    "རྟགཔལ་སོགས་པར་ཕྱིན་ཅི་ལོག་པམེད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ལ་ནི་མ་ཡིན་ཏེ།",
    "༡༩༡ པེ་བསུནས་ཁྱབ་པ་མངོན་སུམ་གྱིས་གྲུབ་ཀྱང་ང་ཚིགས་ཉིད་མ་ཡིན་པར་བརྗོད་པ་མི་མཐུན་པའི་ཕྱོགས་ལ་མཐོང་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ་",
    "པར་མ་ནུས།",
    "དེ་ལ་ཡང་ཐམས་ཅད་ཉིད་ལ་མེདབར་རྟོགས་པར་བྱ་བ་ཡིན་གྱི་འགའ་ཞིག།",
    "འདི་ལ་བརྗོདཔར་མི་བྱ་བའམ།",
    "དེསཞི་ངེས་པ་གདོན་མི་ཟབར་འདོད་པར་བྱའོ།",
    "དེསན་ཐེ་ཚོམ་ཟ་བ་གཏནམིགས་ཡིན་པར་འགལ་བ་གཏན་ནས་མ་ཡིན་ནོ།",
    "འདི་ལྟརཚོསམཐུན་པ་ཉིད་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "ཟླ་བ་གཉིས་ལ་སོགས་པར་ཤེས་བཞིན་དུ་འཁྲུལ་པ་ལ་འཁྲུལ་པར་རྟོགས་ཀྱང་མི་ལྡོག་པའི་ཚེསཔན་ཉིདཀྱིས་དེ་ཚོ་ལ་མཐོ་བོས་ལ་དེས་པ་ཡིན་ཡང་སྔོན་གྱི་མ་མཐོང་བ་ལ་བལྟོསནས་ངས་པའི་རོ།",
    "འདི་ཉིད་རྣམ་པར་འགྲེལ་པབཞི།",
    "འབྲས་བུ་གཞུ་ལས་སྐྱེས་པར་དམིགས་པའི་ཕྱིར་རོ།",
    "དེས་ན་པ་སྒྲུབ་པར་བྱེདཔ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བདགམེད་པཡེདིན་སྲོག་ལ་སོགས་བ་མེད་པ་ཡོད་པ་ཕྱིར་འདིར་བསྒྲུབ་པར་བྱ་བ་མེད་པ་ལ་སྒྲུབ་པར་བྱེད་པ་མེད་པ་ལྡོག་པ་གྲུབ་པོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་སྲོག་ལ་སོགས་པ་ངང་ལྡན་པ་ཉིད་བདག་མེད་པ་ལ་མ་མཐོང་བ་ཙམ་གྱིས་ཁྱབ་པ་མ་གྲུབ་པར་བརྗོདཔ་ལེའགྱུར་རོའ་ཞིན།",
    "གལ་ཏེ་ཡང་བདག་རམིགས་པའི་མཚན་ཉིད་དུ་གྱུརཔ་མཡིན་པའི་ཕྱིར་བུམ་པ་ལ་སོགས་པ་བདག་ཅདཡོད་པར་པ་གྲུབཔདོལྟ་ན་ཡང་བདག་མེདཔར་སྨྲ་བ་ལ་བུམ་པ་ལ་སོགས་པ་བདག་མེད་པར་གྲུབ་པ་ཡིན་ལ་དེ་དག་ལ་སྲོག་ལ་སོགས་པ་མེད་པར་གྲུབ་བ་ཡིནཔ་དེསན་ལྟར་ཁྱབ་པ་མ་ཡིན་ཞེས་སྨྲས་པའི་གལ་ཏེ་ཁས་བླངས་པའི་ཕྱིར་ཞེས་བྱུང་ཡིནནོ།",
    "གསེན་པའི་ལུས་ནི་བདག་ཅག་བག་དང་བཅས་པར་འདོད་པ་ངེས་ན་དེ་ལ་རྩོད་པ་ཡིན་ན།",
    "དེསནཁསབླངས་པའི་བདག་མེད་པ་ལ་སྲོག་ལ་སོགས་པ་མེད་པའི་ཕྱིར་དེ་བར་བྱེད་པཉིང་དུ་བརྗོད་པས་རི་ངག་ལུང་ལས་གྲུབ་པར་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "ལུངཙམ་འ་ས་ཁས་བླངས་པ་ནི་ཚོང་པས་སྟོང་པར་འགྱུར་རོ།",
    "ལར་བངག་མེད་པར་གྲུབ་པ་ཡིན་པ་དེ་ལྟ་ན་ཡང་འགའ་ཞིག་ལབདག་དེ་ལོག་སྟེ།",
    "འདིའི་ཡུལ་ནི་བསྟན་པར་བྱའོ་ཞེས་སོ།",
    "ཇི་ལྟུང་ཞེན་པ་ལགས་པ་ཞེས་སྨོས་སོ།",
    "དེ་བས་ན་རྒྱུ་གཞན་གྱི་བྱེད་པ་ནི་དེ་ལ་བརྟེན་པར་འགྱུར་རོ།",
    "ལ་ལར་ཨུཞན་ལསའགྲུབསཁྱད་པར་སྒྲུབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་འདིདག་ཐམས་ཅད་ཀྱི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པར་རྣམ་པར་བཞག་པ་འམ།",
    "འདིར་ནི་ཁྱད་པར་གྱི་རྒྱུ་ཡོདན་དེད་ཀྱི་འདོད་པ་འགྲུབ་པ་ལྟར་རྒྱུ་ཁྱད་པར་མེད་པར་བརྗོད་དོ།",
    "ཁྱད་པར་དུ་འགྱུར་བ་ཡིནནོ།",
    "གཉི་ག་ལྟར་ཡང་འཛིན་པ་བཀག་པམེད་པའི་ཕྱིར་རོ་སྐྱེས་ཤིང་སྐྱེས་པ་འཛིན་པས་གཞན་དང་གཞན་བཟུང་བ་ཟུག་པམེད་པའི་ཕྱིར་ཐམས་ཅད་འཛིན་པར་མི་འགྱུར་བ་དེ་ཡིན་པ་དེ་དལ་གྱིས་འཇུག་ཀྱང་བ་ཡོད་པའི་དུས་ལ་ལྟོས་པ་མ་ཡིནནོ།",
    "སྐྱེས་བུའི་ཁྱད་པར་བཞིན་དུ་ཚིག་རྣམས་ནི་ཁྱད་པར་སྤང་བར་འོས་བ་མ་ཡིན་པ་མ་ཡིནནོ།",
    "དེས་ན་འགྲོ་བ་མཐའ་ཡས་པ་ཡོད་ཚད་ངེས་པར་རྣམ་པར་གཞག་ནས་ཐམས་ཅད་རྟོགས་བར་ནཱིམི་སྨྲའི།",
    "འབྲས་རྒྱུའི་གཏན་ཚིག་གས་ཀྱིས་ནི་འདོད་ཆགས་རྗེས་སུ་དཔག་པའོད་ཀྱིས་འདོད་ཆགས་དང་བྲལ་བ་འགོག་པའི་ཕྱིར་འདོ་ཆགས་ལ་སོགས་པའི་འབྲས་བུ་འཁྲུལ་པ་མེད་པ་ཅན་མེད་པར་བརྗོད་དེ་ཚིག་ལ་སོགས་པ་ནི་དེ་ལྟམ་ཡིན་པས་ཡདསྲིད་པའི་ཕྱུར་རོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གནོད་པར་བྱེད་པ་ལུང་པ་སོ།",
    "དེའི་ཕྱིར་མདུན་ན་གནས་པའི་མེ་ལ་མཆོད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཁྱད་པར་མེད་ང་བཞིན་གྱི་ངག་ཐམས་ཅདསྐྱེས་བུས་བྱེད་དོ།",
    "དེའི་ཁྱད་པར་ནི་ཚོགས་པའི་ཁྱད་པར་ལས་འགྱུར་བ་ཡིན་པ་དོསན་སྐྱུ་རུ་ལ་སོགས་པ་དང་སྐྱེས་བུ་དག་ལ་ཁྱད་པར་ཡང་མ་ཡིནལ།",
    "སོགས་པའི་སྒྲའི་དོན་ནིརང་ཉིད་སྟོན་པར་འགྱུར་རོ།",
    "རྟེན་ཡོད་པ་མ་ཡིན་པར་འགྱུར།",
    "རྟེན་མེད་པ་ཉིད་ཀྱིས་གཏན་ཚིགསསྟོན་པས་བདག་ཏུ་སྨྲ་བརྟན་ལ་དམིགས་པ་མེད་པར་འཆདཔའི་གར་ཤཱམངོནསུམ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "འབྲེལ་པ་ནི་གཞལ་བྱ་ཡང་ཁྱད་པར་ཡོད་པ་མ་ཡིནནོ།",
    "དེ་ནི་རྣམ་པར་རྟོགས་པ་ཡིན་ཞེ་ན།",
    "དེའི་ཕྱིར་བྱ་བ་ལ་སོགས་པ་འབྲེལ་པ་ལྡེད་པ་དྨེ་ལྟར་སྣང་བཞིན་བ་ཉིད་ལ་ངའོ་སྙམ་པར་རྟོགས་པ་ཡིནནོ།",
    "རྗེས་སུ་དབག་པད་བྱ་བ་མ་ཡིན་པ་ཉིད་ཀྱང་འདིས་གྲུབ་པས་ཡར་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་པ་ཉིད་དུ་བརྗོད་པ་དོན་ཅི་ཡོད་པ་སྟེ་ཡང་མི་མཐུན་པའི་ཕྱོགས་ལ་གཏན་ཚིགས་ཀྱི་དམིགས་པ་མཐའ་དག་ལྡོག་པའི་ཕྱིར་དེ་ལ་དེ་མེདཔན་འཐད་པ་ཁོ་ནའོ།",
    "འདི་ནི་ནམ་ཡང་མི་མཐུན་པའི་ཕྱོགས་ལ་རྟོགས་པར་མ་གྱུར་ཏེ།",
    "གསལ་དུ་ཟིན་ཀྱང་བདག་ཡོད་པར་ཁས་ལེནབའི་ཕྱིར་རོ།",
    "དེ་ནི་པ་རོལ་པོ་དག་སྲོག་ལསོགས་པའི་འབྲས་བུ་ཉིད་ལས་རྗེས་སུདཔག་པར་འདོད་པས་དེ་བཀག་པ་མ་ཡིན་ནོ།",
    "ང་གེཤིང་དེ་ལས་རྗེས་སུདབག་པར་འགྱུར་བ་དེ་ཡོད་ན་སྔོན་མ་བྱུང་བའི་སྲེག་ལ་སོགས་པ་འམ་གཞན་འགའ་ཞིག་ཡོད་པར་རྟོགསཔ་ནི་མེད་དོ།",
    "དེ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་ལ་ཡང་རྟོགས་པར་བྱ་སྟེ།",
    "གཟུགས་དང་སྣང་བ་དང་ཡིད་ལབྱེད་པ་རྣམས་ཡོད་ན་ཡོད་པ་མ་གྲུབ་ཀྱང་མེད་གཙང་པ་གྲུབ་པ་ཁོ་ནའོ།",
    "ཞེས་བྱ་བ་ཡིན་ནོཔའི་རང་བཞིན་གྱི་ཁྱད་པར་ནི་ལུང་ལས་རྟོགས་པ་ཡིན་གྱི་དོར་ཡང་རྗེསསུ་དཔགཔརུས་པ་ནི་མ་ཡིན་ནོ།",
    "མེ་དང་དུ་བ་བཞིན་དུ་དངོས་པོ་གཞན་ལས་ལོག་པའི་དངོས་པོ་ཡོད་ན་ཡོད་པར་ཁྱད་པར་ཉིད་ཀྱིས་རྟོགས་པ་ཡིནནོ།",
    "ལ་སོགས་བས་ནུས་པའི་གེགས་བྱས་པའི་འབར་བའི་རང་བཞིན་ནུསཔ་གེགས་མ་བྱས་པ་ལས་མི་མཐུན་པར་མི་རྟོགས་པའི་ཕྱིར་དེ་ཡངམངོན་སུམ་གྱིས།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོའི་རྟོགས་པར་འགྱུརོ་ཞན།",
    "མེའི་སྲེགཔར་ནུས་པ་ནི་དྲོ་བའི་ནུས་པ་ཉིད་ཡིན་ལ།",
    "དྲོ་བའི་ནུས་པ་ཡོད་ཀྱང་སྲེག་པར་བྱེད་པ་དེ་མེ་ཡལ་ནརྩུམ་ཡིན་པ་ཉིད་དུ་འགྱུར་བ་ཁོ་ནའོ།",
    "དེས་ན་དེ་ལྟར་འདི་ལ་མངོན་སུམ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཡང་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་དང་རྗེསསུ་དཔག་པ་ཡོད་པ་ཡིད་པ་ཁོ་ནའི།",
    "དེན་འདི་དང་ལྷན་ཅིག་གཞི་གཅིག་པར་མི་འགྲུབ་སྟེ་བདེ་བ་ལ་སོགས་པའི་རྒྱུ་བྱེད་པ་པོ་ལ་སོགས་པར་མ་གྲུབ་པའི་ཕྱིར།",
    "དེ་ཉིད་ཀྱིའཕྱིར་ངེས་པ་ཅི་ཡོད་ཅེས་གསུངས་སོ།",
    "ཞོ་ཡོད་པར་འདོད་པས་འོ་མ་ཙམ་གྱི་རང་བཞིན་ལ་གུས་པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "དམིགས་པར་ཁས་ལེན་པས་ན་ཞོའི་བདག་ཉིད་ཉམས་པའི་ཕྱིར་འཚོལཔ་མ་གྲུབ་པོ།",
    "དེ་ལྟར་འདི་ནི་ལམཐོང་བས་ལྡོག་པ་གྲུབ་པར་སྨྲ་བ་འདི་དག་ནི་ཕན་ཚུན་འགལ་པ་སྟེ།",
    "དེ་ཡོད་པས་ཟློག་པར་བྱེད་པ་འམམེད་པས་ཡིན།",
    "འདི་ལ་ཇི་ལྟར་རྒྱུ་ཟློག་པར་བྱེད་པ་ཡིན་པ་དེ་སྟོན་པའི་འཁྲུལ་པ་མེད་པོའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "རྒྱུ་ཡང་ལྡོག་པ་ཉིད་ཀྱི་འབྲས་བུ་ལྡོག་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་རྒྱུ་ཉིད་ཀྱིས་ངེས་པ་ཡིན་ཏེ།",
    "ཡོད་པ་ཉིད་ནི་ལྡོག་པར་བྱེད་པ་མ་ཡིན་ཌོ་སྒྱུ་རྒྱུ་ཉི་ཉིད་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་འབྲེལ་པ་ཁས་མི་ལེནན་བསྒྲུབ་པར་བྱ་བབ་ཅིག་ལོག་པས་ཇི་ལྟར་གཏན་ནི་ཞེསབྱ་བ་སྒྲུབ་པར་བྱེད་པ་ལྡོག་པར་འགྱུར།",
    "དེ་ལྟརམའབྲེལ་བ་ལ་ལྡོག་མེད་པར་བསྟར་ནས་རྗེས་སུ་འགྲོ་བ་ཡང་མེད་པར་བརྗོད་པ་ནི་དེ་བཞིན་གཅིག་ཅིག་ཅེས་བྱ་བ་ཡིནོ།",
    "རང་བཞིན་འབྲེལ་པ་ཁོ་ནས་གཏན་ཚིགས་ཀྱིས་བསྒྲུབ་བྱ་ཀོ་བྱེད་དེ་དེ་རྟོགས་པའི་རྒྱུམཚན་ལ་བརྟན་པར་འགྱུརོ།",
    "གལ་ཏེ་གང་བྱས་པ་དེ་ཐམས་ཅབམི་རྟག་པ་སྤྱི་དཔེ་ལྟ་བུམ་པ་བཞིན་ནོ་ཞེས་བསྟན་པ་ཉིད་ཀྱིས་ལྟར་འགྲུབ་ན་གཞན་མཚོན་པར་བྱེད་པ་ལ་མི་ལྟོས་པར་འགྱུར།",
    "༡༩༡ པེ་། བྱེད་པ་ཉིད་ཀྱིས་ངེས་པར་བྱེདཔ་ཡིན་པ་ན་གཞི་ཡོད་པ་དང་མེད་པ་ག་ལ་ཁྱད་པར་ཡོད་པ་མ་ཡིནནོ།",
    "ཀླདེ་ལྟར་ན་ཕྱོགསལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ་ནི་དག་ཙམ་གྱི་རང་བཞིན་ཉིད་མ་ནོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་རྣམ་ལ་མི་བརྟེན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ནའོན་རྗེས་སུ་འགྲོ་ལྡོག་བཞིན་དུ་འབྲེལ་པ་ཡང་གཞན་གྱི་དོན་གྱི་རྗེས་དཔག་པར་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཚིག་ཡན་ལག་གསུམ་པར་མའགྱུརོ་ཞེ་ནམ་ཡིན་ཏེ་ཁྱབ་པའི་ཚིག་རྟོགས་ན་འབྲེལ་པ་དོན་གྱི་བྱེ་བའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་རིག་པའི་མཁས་པ་དེ་རྣམས་ལ་ཉེར་སྟོན་པའི་ཐབས་དང་བྲལ་བ་གནཚོགས་འབའ་ཞིག་བརྗོད་པར་ཟད་དོ།",
    "གལ་ཏེ་གང་བྱས་པ་དེའི་མི་རྟག་པའོ་ཞེསསྨྲས་ན་འདིའི་ངོ་བོ་ཉིད་དོ་ཞེས་རྟོགས་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "གང་བྱས་པ་དེ་མི་རྟག་པའོ་ཞེས་བྱ་བ་ལ་མི་རྟག་པ་ཉིད་ཡོད་པ་ངེས་པར་རྟོགས་ཏེ།",
    "གང་བྱས་པ་ཞེས་བྱས་པ་མཐའ་དག་ཡོངས་སུ་བཟུངས་བསྟན་པའི་སྤྱི་དོ།",
    "དེས་ན་དེའི་ངོ་བོར་ཤེས་པ་ཞེས་བརྗོད་པར་བྱ་བ་ཁོ་ནའོ།",
    "གལ་ཏེ་དེ་ལྟར་བརྗོད་པ་ཙམ་གྱིས་དེ་ལྟ་ཡིན་པར་འགྱུར་ན་ཁྱབ་པ་བརྗོད་པས་ལྡོག་པ་དཔེར་པར་འགྱུར་རོ།",
    "དེས་ན་གལ་ཏེ་བྱས་པ་ཐམས་ཅད་མི་རྟག་ཅེས་བྱ་བས་ལྡོག་པ་འཕེན་པ་དེ་ལྟ་ན་ཡང་ཐབས་གད་ལས་འོས་སགྲུབ་པ་ཐུབས།",
    "དེས་ན་དེ་ལྟར་རྗེས་སུ་འགྲོ་བས་འབྲེལ་པ་རྟོག་པར་བྱེད་པར་ལྡོག་པའཕེན་ཏེ།",
    "གསུངས་སོ།",
    "འོ་ན་འདི་ཇི་ལྟར་སློབ་དཔོན་གྱིས་ལྡོག་པོ་དང་ལྡན་པ་གསུངས།",
    "བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་མེད་པ་ཡང་ཐེ་ཚོམ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ན་བའི་ཤེས་པ་ཉིད་ལ་འབྲས་བུ་ཉིདམེདཔ་དོནསལྡོག་པ་མེད་པར་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་གཞན་མེད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ལ་ཁྱབ་པར་བྱ་བ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེས་ན་ངེས་པར་བྱེད་པ་ལ་བརྫུནས་དྲིས་པ་ཡིན་པ་དེ་འདིའི་བདག་ཉིད་དང་དེ་ལས་བྱུང་བ་དག་ཁ་ལས་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ཏུ་འགྱུར་བ་ཡིན་ནོ།",
    "༡༩༡ པེ་འབྲེལ་ཁྱེད་ཁྱེདཔར་བརྗོད་དོ།",
    "དེས་ན་དེ་མེད་པར་བསྟནཔའི་ཕྱིར་རོ།",
    "ཞིས་འདི་ནི་འཆད་པར་འགྱུར་རོ།",
    "སྲིད་པས་རྣམ་པར་བཞག་ཀྱང་དུང་སྟེ་ཕུང་པོ་གཉིས་སུ་ངེས་པའི་ཕྱིར་ཏེ།",
    "དེསན་ཁྱད་པར་འགའ་ཡང་མེད་དོ།",
    "དངོས་པོ་ཡང་ཡུལ་དབུས་དང་རྣམཔར་ངེས་པ་ཡིན་ནོ།",
    "དུ་ཡང་འབར་བར་ནུས་པར་འགྱུར་ཏེ།",
    "མིང་ཐ་དད་པར་ཟད་དེ་རྣམ་པར་ཐ་དདཔལ་སོགས་པའི་དོན་ཁས་བླངས་ནས་དེ་སྐད་བརྗོད་བའི་ཕྱིར་རོ།",
    "འཇིག་པ་དོན་གཞན་གྱི་རྒྱུན་ན་ཐང་ག་ལྔ་པད་བར་བདཔ་དེ་ལྟ་ན་ཡདས་པོ་མི་རྟག་པ་ཉིད་ནི་ཉམས་པ་མ་ཡིན་ཏེ་བྱས་པའི་བདག་ཉིད་ཀྱི་མི་རྟག་པ་ཉིད་ཡོད་པ་ཡིན་ཡང་འཇིག་པ་མེད་པའི་ཕྱིརནོ།",
    "པར་མི་འགྱུར་ཏེ།",
    "ཡུལ་དུ་གྱུར་པའི་དངོས་པོ་ཅིག་ཉིད་ལའདི་ཇི་ལྟར་ཐ་དད་ན་འོག་ཏུ་སྟོན་པར་འགྱུར་རོ།",
    "ཕྱིས་འདི་ངེས་པའི་དུས་ཡིན་པ་དེས་ན་དེའི་ཚེ་རྟོག་པ་ཉིད་དུ་རྣམ་པར་བཞག་གོ།",
    "སྐདཅིག་མ་སྐུདག་སྔ་མས་དབེན་པར་རྟོགས་པ་མ་ཡིན་ཞེས་ཀྱང་བརྗོད་པར་མི་འུས་ཏེ།",
    "༡༩༡ པེ་ཉིས་པས་ན་སངྒ་བདུ་སྐད་ཅིག་མ་རྟོགས་པར་འགྱུར་བ་ཁོ་ན་སྟེ།",
    "གལ་ཏེ་གྲོལ་ལས་ཀས་བ་དག་ལ་ཡོད་པ་དམིགས་པ་ཡོད་ཀྱང་བུམ་པ་ལ་གནས་པར་རྟོགས་པམེད་པ་མ་ཡིན་རྣམ་འགྱུར་མེད།",
    "དེ་ལ་ཡང་མེད་པར་དམིགས་པ་མི་རྟག་པ་ཉིད་དུ་ངེས་པའི་རྒྱུར་འཁྲུལ་བ་མེད་དོ།",
    "དེས་ན་བུ་པ་རྣམས་དད་ལྔར་ཡོད་པར་དོགས་པ་འཁྲུལ་པ་ཡིནནོ།",
    "འན་ཀྱང་ངའི་དངོས་པོའི་ས་པ་ཉིད་ཡིན་པར་བསྟན་ཏོ།",
    "དེས་པ་ཞེས་བྱ་བའི་དངོས་བོ་མེད་པ་ཡོད་པའི་ཕྱིར་དོན་དེ་ངེས་པར་མི་འགྱུར།",
    "དེ་ལྟ་བུའི་རང་ཤུནནི་མ་ཡོད་ཀྱང་དེ་ལྟ་མ་ཡིན་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་དོན་གཞན་དང་ལྡན་པར་གཡོ་བ་ཉིད་དུ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "ཡང་ན་བྱས་པས་བསྐྱེད་བའིཕྱིར་འབྲས་བུ་ཡིན་པ་ཞིག་ཏུ་འགྱུར་གྲང་།",
    "གང་ཞིགརྒྱུ་ཡང་མ་ཡིན་ལ་འབྲས་བུ་ཡང་མ་ཡིན་པ་དེ་ནི་འབྲེལ་པ་མེད་པའི་ཕྱིར་ཇི་སྐད་བརྗོད་པའི་རྣམ་པར་རྟོག་པ་ཉིད་འཐད་པ་ཡིན་ནོ།",
    "འབྲེལ་པ་མེད་ན་སྐབས་ཀྱི་དོར་དང་འགལ་བ་ཅི་ཞིག་རྒྱུ་དང་འབྲས་བུ་མ་ཡིན་པ་དེ་ལ་འབྲེལ་པ་མེད་པ་ལུས་མེད་པར་རྗེས་སུ་དཔག་པ་རྟགས་པ་མཐོང་བ་ལས་ད་ཡོད་པ་ཉིད་དུ་རྟོགས་པ་མིསྲིད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཕྱོགས་གཉིས་ཉིད་དོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "རྗེས་ས་སུ་དཔག་པས་ནི་ཡོད་པའི་རྗེས་སུ་དཔག་པར་བྱ་བ་རྟོགས་པ་ཡིན་ནོ།",
    "དོན་མ་ཟ་བར་ཡོད་པ་མ་ཡིན་པས་ཡོད་པར་རྗེས་སུ་དཔག་ཏུ་མེད་དོ་རྟགས་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་བྱ་བ་ནི་འཇུག་བསྡུ་བའོ།",
    "གནོད་པར་བྱེད་པ་མེད་པའི་ཕྱིར་མ་ཡིན་ནོའི་ན།",
    "དེས་ན་འདི་ཡོད་པར་མ་གྱུར་པ་ལས་ར་དོང་ཡོད་དོ་ཞེས་བྱ་བ་འདང་ག་ལ་འགྱུར།",
    "ཞེསམརྟག་པར་སྨྲ་བས་ཀྱད་ཁཙྪཱ་བླང་བར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་མྱོང་བ་རྟག་པ་ཉིད་ནི་ཡན་ལགམ་ཡིནནོ།",
    "གཞན་ལ་སོར་པོར་ཤེས་པ་ཞེསབྱི་བ་ལ་སོགས་པ་རྗེས་སུ་རྟོགས་པར་བྱའོ།",
    "སྔ་ཕྱི་རྣམ་པ་འབྱེད་པར་མི་ནུས་པས་རྣམ་པར་མི་རྟོག་པ་པོ་འོ།",
    "སྔར་ཉེ་བར་གནས་པ་ཡོད་ཀྱང་མེད་པའི་འབྲས་བུ་ཕྱེས་ལྷོ་བར་འོས་པོས་བལྟོས་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་པའི་ཕྱིར་དེ་བྱེ་བ་ཉིད་ཀྱིས་བསྐྱེད་པ་ཡིན་ནོ།",
    "དེ་སྟེ་སྔ་དྲོ་བར་གནས་པ་དག་པ་དེ་ཉེ་བར་བལྟས་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པས་ཡིན་ཞེས་ཐེ་ཚོམ་ཟ་བ་ཕྱིས་ཀྱི་མ་དམིགས་པས་ཟློག་པ་ཡི།",
    "འདིལས་ཇི་ལྟར་འཁྲུལ་པ་མེད་པརབསྟུན་པའི་དེ་མེད་པར་ཡང་ཞེས་སྨོས་སོ།",
    "མི་མེད་པར་ཡང་དུ་བ་ཡོད་དེ།",
    "ཇི་ལྟར་མེ་མེད་པར་ཡང་ཡོད་པའི་ཕྱིར་རྒྱུ་དང་ལྡན་པ་ལས་འདས་པར་འགྱུར་ཞེན།",
    "དེ་སྤྱད་པའི་ནུས་པ་མེད་པར་ཇི་ལྟར་ཡད་ཡོད་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "༡༩༡ པེ་ངབྲས་བུ་དག་དང་བཞིན་ཁྱད་པར་ཅན་གྱི་བདག་ཉིད་ཡིན་ན་ལན་ཅིག་ཞུགས་པའི་མངོན་སུམ་ཉིད་གྱིས་དེ་ལྟར་འཛིན་པའི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པའི་དུ་བཞིན་ལྟ་བུའོ།",
    "དེས་ན་རྒྱུདང་འབྲས་བུའི་དངོས་པོནལནག་དམིགས་པས་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "མེ་མེད་པར་ཡང་དུ་བ་ཡོད་དེ།",
    "པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་མིའི་འབྲས་བུ་ལས་འདས་པར་འགྱུར་བདེ་བཞིན་དུ་གཞན་གྱི་འབྲས་བུ་ཉིད་ལས་ཀྱད་ངོ།",
    "མེ་ཡོད་ན་ཡང་དེ་ཡོད་པའི་ཕྱིར་འདི་ལ་སྔ་ན་མེད་པའི་ཡོད་པ་ཐོབ་པའི་སྐྱེ་བུའི་དོན་ཡིད་བའི་ཕྱིརང་ཞོན་ལས་ཀྱང་ཡོད་པར་མི་འཐད་དེ།",
    "དེས་ན་གཞན་སྐྱེད་པར་བྱེད་པ་ཡིན་ན་དེ་འམ།",
    "གཞནའ་དེ་ཡང་དུ་བ་ཡིན་གྱི་བུམ་པ་ནི་མ་ཡིན་པ་གང་ཡིན་པ་དེ་བསྟན་པར་བྱའོ།",
    "མ་ཡིན་ཏེ་མི་འཁྲུལ་མ་སྤངས་ན་དེའི་རྒྱུན་མ་ཡིན་པར་མི་འཁྲུལ་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པའི་ཚུལ་གྱིས་དཔང་དུ་བྱས་ན་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་གཅིག་ཟད་དེ།",
    "གྱུར་པ་ལ་དམིགས་པའི་ཕྱིར་འདི་མེ་ལ་སོགས་པ་ཉེ་བའི་སྔོན་རོལ་ཏུ་དེ་ནམེད་པར་རྟོགས་པ་ལ་ཡོན་ནམ་ཞེན།",
    "རྟོགས་པ་བ་ཀྱི་འོན་ཀྱང་གཞན་གྱི་ཚེ་ཡང་མེ་མེད་ཀྱང་ཡོད་པར་ཁས་བླངས་པའི་སྤྱི་འབྱུལ་པར་འགྱུར་རོ།",
    "སྐད་ཅིག་སྔོན་མེད་པཉིད་ཀྱིས་སྔོན་མེད་པའི་ཕྱིར་རྒྱུས་བྱེད་པར་ནུས་པ་ཡང་མ་ཡིན།",
    "དུ་བ་ཙམ་ལ་བལྟོས་པའི་ཡོད་པ་སྔ་ན་མེད་པར་བརྗོད་པའི་ཕྱིར་རོ།",
    "དུ་བ་ཙམ་ལ་བལྟོས་ཏེ་རྣམ་པར་འཇོག་པའོ།",
    "འོན་ཏེ་དུ་བ་ཉིད་ལས་ཁྱད་པར་རྒྱལ་གྱི་རྒྱུད་ན།",
    "སྐྱ་པའི་རངག་ངོ་བོ་ངེས་པར་གཟུང་བ་ཉིད་ལན་དུ་བཏབ་པ་ཡིན་ནོ།",
    "འདིརའཐད་པའི་ཁྱད་པར་ཅི་ཞིག་ཡོད་ཅེ་ན།",
    "༡༩༡ པེ་དགའཏེ་དེའི་དུས་དང་ཡུལ་དྲག་ཏུ་ཡང་འགྱུར་བ་ཡིན་པ་དེ་ལྟ་ན་ཡང་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
    "ང་བས་དུ་བ་སྐྱེད་པར་བྱེད་པ་ནམེས་ཀྱང་དུ་བ་བསྐྱེད་པར་བྱེད་པ་ཁོ་ནའོ།",
    "རྒྱུན་ཡུན་རིང་དུ་གནས་ཀྱང་དེ་དང་ལྡན་པ་འཕེན་པར་བྱེད་པའི་འབྲས་བུ་སྐྱོད་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་རྒྱུ་ནཱན་ལས་འདྲའ་བ་ནི་མ་ཡིནོ།",
    "མིང་མེད་ངེས་པར་ཡོད་པ་འགའ་ཞིག་ནི་བྱེད་པར་འགྱུར་རོ།",
    "རྗེ་ལ་ཇིག་སྐྱིད་སྟོད་པ་བྱུད་བ་ཡོད་པར་དམིགས་པས་འབྲས་བུ་ཉིད་དུ་རྟོགསན་དོན་མེད་དེ།",
    "རྟག་ཏུ་ཡོད་པ་ལ་མེད་པར་འགྱུར།",
    "དེས་ན་ཇི་ལྟར་ཡོད་པར་འདོད་པའི་དུས་བཞིའི་དུགཏན་དུ་དེ་ལྟར་འགྱུར་རོ།",
    "མེད་པའིགཏན་ཚིགས་བཤ་པ་ནི་མེད་པའིདུས་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེས་ན་རྟག་ཏུ་ཡོད་པ་འམ་མེད་པར་འགྱུར་རོ།",
    "དེཥཱ་ཏེ་པར་མཚོན་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ན་དེས་ཉེ་བར་མཚོན་པའི་དངོས་པོ་དུད་དངོས་པོ་མེད་པ་ཉིད་ཁྱད་པར་མེད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིད་ན་འདི་དེ་ལྟ་བུ་ཡིན་པར་གསལ་བར་འགྱུར་རོ།",
    "མདུ་པ་རྒྱུ་དང་ལྡན་པ་ཡིན་ནོ་ཞེས་བརྗོད་པར་འགྱུར་རོ།",
    "རྒྱུད་པ་ཡི་ཡོད་ན་ཡོད་པ་མ་བཀག་པས་ནུས་པ་ནི་འ་དི་ཁོ་ནའོ་ཞེས་བརྗོདཔར་མི་སམ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ལྟ་ན་ཡང་དེས་འགའ་བ་ཉིད་བཙེས་པས་བྱས་པར་བརྗོད་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "འགའ་ཞིག་ཡོད་ན་ཡོད་པ་དེ་ཡང་ཡོད་པར་འདོད་བ་ཙམ་ལ་ནི་མ་ཡིན་གྱི།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འདི་ཁྱབ་པར་བྱ་བ་ཉིད་དུ་ཉེ་བར་བཀོད་པ་ནི་མ་ཡིན་གྱི།",
    "༡༩༡ པེ་། བྱ་བར་ངེས་པར་འགྱུར་རོ།",
    "འདི་ཡང་བསྐྱེད་པར་བྱ་བ་ཁོ་ན་ལ་ཡོད་པ་ན་ཕྱི།",
    "དེས་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ནི་ལརིཅིག་མཐོང་བས་རྟོགས་པར་བྱ་བ་ཡིནནོ།",
    "དེ་བས་ན་དུ་བ་སྐྱེད་པར་བྱང་བ་ཞེས་བྱ་བ་ནངུ་བའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་རྗེས་སུ་བྱེད་པ་ཡིན་ལ།",
    "དུ་བ་སྐྱེད་པར་བྱེད་པ་ཡང་མཉིད་ཡིན་ནོ།",
    "པར་འགྱུར།",
    "དེས་ན་ཇི་ལྟར་སྟེ་མི་མ་ཡིན་པར་མི་འགྱུར་བ་དེ་བཞིན་དུ།",
    "དེ་ལས་གཞན་ཡང་འཇིག་པར་འགྱུར་བ་ཡིན་ན་དྲ་ཡང་སྐད་ཅིག་པར་འགྱུར་རོ།",
    "བསྐྱེད་པའི་དུ་བདེ་བ་བྱེད་དུ་འགྱུར་ཞེ་ན་ཉེ་བ་འདི་མེད་དེ་མེ་དང་དུ་བའི་ཁྱད་པར་དེ་ལྟར་ཁས་བླངས་ཀྱི་ལེ་ཙམནི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ངུ་པ་སྐྱིད་པར་བྱེད་པ་མ་ཡིན་པའི་མེ་ཡང་ཡོད་པས་ན།"
  ]
}