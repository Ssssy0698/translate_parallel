    "ཤེས་པ་ལ་ཡང་འདུས་བྱས་འདུས་མ་བྱས།",
    "རིག་པ་ལ་ཡང་འདུས་བྱས་འདུས་མ་བྱས།",
    "ཡེ་ཤེས་ལ་ཡང་འདུས་བྱས་འདུས་མ་བྱས།",
    "འདུས་བྱས་འདུས་མ་བྱས་སུ་ཕྱེ་ནས་གསུངས།",
    "མི་རྟག་པ་དང་རྟག་པར་ཕྱེ་ནས་གསུངས།",
    "རང་སྟོང་གཞན་སྟོང་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "བཅོས་མ་རང་བཞིན་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "ཀུན་བཏགས་ཡོངས་གྲུབ་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "རྗེས་ཐོབ་མཉམ་བཞག་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "ཤན་འབྱེད་ལ་ཟློ་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "དབྱེར་ཡོད་དབྱེར་མེད་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "འཁྲུལ་ལུགས་གཤིས་ལུགས་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "འདོད་ལུགས་ཡིན་ལུགས་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "སྲོལ་འབྱེད་སྲོལ་འགོག་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "ཕུང་གསུམ་ཡོད་མེད་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "དུས་བཞི་ཆེ་ཆུང་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "གསུམ་ལྡན་མར་བཅད་དམན་པར་རབ་ཕྱེ་ནས།",
    "དཔང་དུ་རུང་དང་མི་རུང་ཕྱེ་ནས་གསུངས།",
    "ངོ་བོ་ཉིད་གསུམ་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "བདག་གསུམ་རྣམ་དབྱེ་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "ཕྱི་ནང་གཞན་མཆོག་ལེགས་པར་ཕྱེ་ནས་གསུངས།",
    "རྒྱལ་བ་སྲས་བཅས་ཐམས་ཅད་དགྱེས་པར་འགྱུར།",
    "རྒྱལ་བའི་གོ་འཕང་མྱུར་དུ་ཐོབ་པར་འགྱུར།",
    "རིགས་ཀྱི་དབྱེ་བསྡུ་ཇི་སྙེད་གསུངས་པ་ཀུན།",
    "དབྱིངས་རིག་དབྱེར་མེད་དོན་དམ་འདུས་མ་བྱས།",
    "དེ་རྣམས་ཐམས་ཅད་འདུས་བྱས་ཡིན་ནོ་ལོ།",
    "འོ་ན་དེ་རྣམས་ཀུན་རྫོབ་ཡིན་པར་འགྱུར།",
    "མཐར་ཐུག་གཏན་གྱི་སྐྱབས་མཆོག་མིན་པར་འགྱུར།",
    "རྟག་བརྟན་ཐེར་ཟུག་གཡུང་དྲུང་འདུས་མ་བྱས།",
    "དོན་དམ་བདེན་པར་ཡང་ཡང་གསུངས་པས་གནོད།",
    "གསུངས་པ་དེ་རྣམས་དྲང་དོན་ཡིན་ཞེ་ན།",
    "གཙང་བ་ཁེགས་ན་མི་གཙང་ཁེགས་འགྱུར་ལ།",
    "རང་བྱུང་མེད་ན་གཞན་བྱུང་མེད་པར་འགྱུར།",
    "གཞན་མཆོག་མེད་ན་ཕྱི་ནང་མེད་པར་འགྱུར།",
    "འགོག་བདེན་མེད་ན་བདེན་པ་མེད་པར་འགྱུར།",
    "སྦྱངས་འབྲས་ལ་སོགས་གང་ཡང་མེད་པར་འགྱུར།",
    "ཤེས་བྱ་ལ་ནི་འདུས་བྱས་འདུས་མ་བྱས།",
    "བེམ་པོ་ལ་ཡང་འདུས་བྱས་འདུས་མ་བྱས།",
    "རིག་པ་ལ་ཡང་འདུས་བྱས་འདུས་མ་བྱས།",
    "འདུས་མ་བྱས་དང་འདུས་བྱས་ཡེ་ཤེས་སུ།",
    "ལེགས་པར་འབྱེད་པ་རྫོགས་ལྡན་ལུགས་ལ་ཡོད།",
    "རྟག་པ་འདུས་མ་བྱས་ཀྱི་ཡེ་ཤེས་དང་།",
    "རྟག་པ་འདུས་མ་བྱས་ཀྱི་ཡེ་ཤེས་དང་།",
    "རྟག་པ་འདུས་མ་བྱས་ཀྱི་རྒྱལ་བ་ལྔ།",
    "ཤེས་རབ་གང་ཡིན་འདུས་བྱས་དངོས་པོ་ཡིན།",
    "འདུས་བྱས་མི་རྟག་སྐད་ཅིག་མར་ཡང་འདོད།",
    "དེའི་ཀྱང་ལྟ་བའི་སྙིགས་མ་བདོ་བར་བྱས།",
    "རྒྱལ་ཁམས་གཉིས་སུ་འབྱེད་པ་མི་ཤེས་པར།",
    "རྒྱལ་ཁམས་གཉིས་སུ་འབྱེད་པ་མ་ཤེས་པར།",
    "འདུས་མ་བྱས་ཀྱི་རྒྱུ་འབྲས་མི་འདོད་ལ།",
    "འདུས་བྱས་འདུས་མ་བྱས་སུ་འབྱེད་པ་དང་།",
    "དེས་ཀྱང་ལྟ་བའི་སྙིགས་མ་བདོ་བར་བྱས།",
    "གསང་འདུས་ལ་སོགས་ལྷ་སྔགས་རྒྱུད་ཀུན་དང་།",
    "གཙང་བདག་བདེ་དང་རྟག་པའི་འགོག་བདེན་དང་།",
    "དེས་ཀྱང་ལྟ་བའི་སྙིགས་མ་བདོ་བར་བྱས།",
    "དོན་དམ་འདུས་མ་བྱས་ལ་གསུངས་ཕྱིར་དང་།",
    "རང་བཞིན་གཉུག་མ་འདུས་མ་བྱས་ཀྱང་མིན།",
    "གཙང་བདག་བདེ་ཆེན་རྟག་པའི་མཆོག་ཀྱང་མིན།",
    "ལྷ་སྔགས་རྒྱུད་དང་དཀྱིལ་འཁོར་གང་ཡང་མིན།",
    "རང་བཞིན་འོད་གསལ་འདུས་མ་བྱས་ཡིན་ཕྱིར།",
    "ཉམས་པར་བྱས་ཀྱི་གསལ་བར་བྱས་པ་མིན།",
    "དེ་ལྟར་གསུངས་ཀྱང་དེ་ལ་མི་མཁས་པ།",
    "ཀུན་གཞི་ཡེ་ཤེས་འདུས་མ་བྱས་ཡིན་ལ།",
    "སྦྱང་བྱ་དྲི་མ་འདུས་བྱས་ཡིན་པའི་ཕྱིར།",
    "དེ་གཉིས་གཅིག་གམ་མི་གཅིག་དགོངས་པར་ཞུ།",
    "དེ་གཉིས་གཅིག་གམ་མི་གཅིག་དགོངས་པར་ཞུ།",
    "དེ་གཉིས་གཅིག་གམ་མི་གཅིག་དགོངས་པར་ཞུ།",
    "དེ་གཉིས་གཅིག་གམ་མི་གཅིག་དགོངས་པར་ཞུ།",
    "ངོ་བོ་ཉིད་གསུམ་ཡང་ཡང་གསུངས་ཕྱིར་དང་།",
    "སེམས་ཙམ་གཞུང་དུ་དེ་སྐད་མ་གསུངས་ཤིང་།",
    "རྣམ་པར་འཁྲུགས་པས་ལྟ་བའི་སྙིགས་མ་བྱུང་།",
    "དོན་དམ་མེད་པའི་ཀུན་རྫོབ་སྲིད་ལགས་སམ།",
    "ཁྱབ་བྱེད་མེད་པའི་ཁྱབ་བྱ་སྲིད་ལགས་སམ།",
    "གཞི་རྟེན་མེད་པའི་བརྟེན་པ་སྲིད་ལགས་སམ།",
    "དེ་འདྲ་རྫོགས་ལྡན་གཞུང་དུ་མ་གསུངས་ཀྱང་།",
    "དེས་ཀྱང་ལྟ་བའི་སྙིགས་མ་བདོ་བར་བྱས།",
    "དོན་དམ་མཚན་བརྗོད་རྒྱུད་དུ་ལེགས་གསུངས་པའི།",
    "དབྱེ་བ་ཇི་སྙེད་གསུངས་པ་ཐམས་ཅད་ཀྱང་།",
    "འདི་ལ་འདུས་བྱས་གཅིག་ཀྱང་འདྲེས་པ་མེད།",
    "རྣམ་པར་དག་པའི་གཟུགས་ནས་རྣམ་མཁྱེན་པར།",
    "འདུས་མ་བྱས་ཀྱི་སྟོབས་བཅུ་ལ་སོགས་པ།",
    "གཙང་བ་ཡིན་གྱི་མི་གཙང་གཏན་མ་ཡིན།",
    "དེ་ལྟ་ཡིན་ན་འདུས་བྱས་མི་རྟག་པའང་།",
    "དེ་ཡང་འདོད་ན་འདུས་མ་བྱས་སུ་འགྱུར།",
    "དེ་ཕྱིར་རྟེན་ཅིང་འབྲེལ་འབྱུང་གསུངས་པ་ལ།",
    "ཡུམ་དང་ཕལ་ཆེན་སྔགས་ལས་གསུངས་པ་ཡིན།",
    "རྫོགས་ལྡན་མཁས་མཆོག་རྣམས་ཀྱིས་གསུངས་པ་ཡིན།",
    "འདུས་བྱས་མ་ཡིན་འདུས་མ་བྱས་དབྱིངས་ཡིན།",
    "མ་འདྲེས་བཅོ་བརྒྱད་མཁྱེན་གསུམ་འཕགས་རྣམས་ཀྱང་།",
    "ཀུན་རྫོབ་འདུས་བྱས་ལམ་བདེན་འདི་མིན་གྱི།",
    "ནམ་མཁའ་འདུས་མ་བྱས་ཀྱི་དཔེ་ཡིས་གསུངས།",
    "གྲོང་སྟོང་བུམ་པ་སྟོང་སོགས་དཔེ་ཡིས་གསུངས།",
    "མངོན་སུམ་སྣང་བ་པྲ་ཕབ་དཔེ་ཡིས་གསུངས།",
    "ཀུན་ཏུ་རུ་སྐྱེས་བདེ་བའི་དཔེ་ཡིས་གསུངས།",
    "དྲི་མའི་སྦུབས་སུ་ཆུད་པར་དཀའ་བ་སོགས།",
    "དར་ཡུག་ཆེན་པོའི་དཔེ་ཡིས་གསལ་བར་གསུངས།",
    "ཁྲོན་པ་རྐོ་བ་ལ་སོགས་མང་པོས་གསུངས།",
    "དཔེར་བྱ་ཀུན་ལས་འདས་ཞེས་ལེགས་པར་གསུངས།",
    "དབུལ་པོའི་གཏེར་ཆེན་ལ་སོགས་མང་པོས་གསུངས།",
    "ཆུ་ཁམས་གསེར་དང་ནམ་མཁའ་ལ་སོགས་གསུངས།",
    "དཔེ་ཡང་ནམ་མཁའ་ལ་སོགས་མང་པོས་གསུངས།",
    "སྤྲིན་ཡོད་སྤྲིན་མེད་ནམ་མཁའི་དཔེ་ཡིས་གསུངས།",
    "ནམ་མཁའི་སྤྲིན་སངས་གྱུར་པ་དཔེ་ཡིས་གསུངས།",
    "ཇི་བཞིན་རྫོགས་པར་སྟོན་པའི་དཔེ་མེད་མས་པའཤུལ་བཞག་ལས།",
    "རྒྱུ་འབྲས་སླུ་བ་མེད་པར་རྟོགས་པ་ཡིས།",
    "སྟོང་པར་རྟོགས་ནས་མེད་བཞིན་སྣང་བ་ཡི།",
    "ལེགས་པར་རྟོགས་ནས་ཞེན་ཆགས་མི་མཛད་པའི།",
    "རྣམ་པར་མི་རྟོག་གཉིས་མེད་ཡེ་ཤེས་ཀྱི།",
    "སྣང་བ་མངོན་དུ་གྱུར་ལ་བདག་དད་ལགས།",
    "ཇོ་ནང་ཀུན་མཁྱེན་དལ་པ་པ་ཤེས་རབ་རྒྱལ་མཆན་གྱི་གསུང་འབུམ། ༡",
    "ལེགས་པར་སྒྲུབ་ཅིང་བསྒྲུབ་ཏུ་འཇུག་པ་དང་།",
    "གཞན་དག་བསྐུལ་བར་མཛད་པར་རྣམས་ལའང་དད།",
    "ཕྲག་དོག་མེད་པར་དད་གུས་མཛད་ལའང་དད།",
    "ལེགས་པར་ཕྱེ་ནས་སྟོན་མཛད་རྣམས་ལའང་དད།",
    "ལེགས་རྟོགས་ལེགས་སྒྲུབ་ལེགས་པར་སྟོན་མཛད་པ།",
    "རང་སྟོང་དོན་དམ་ཡིན་པར་བཞེད་པ་དང་།",
    "དོན་དམ་རང་སྟོང་ཡིན་པར་བཞེད་པ་དང་།",
    "དུག་ལྔ་ཡེ་ཤེས་ཡིན་པར་བཞེད་པ་དང་།",
    "དེ་ལྟར་གསུངས་པའི་ལུང་རིགས་མན་ངག་ཀྱང་།",
    "ཆ་མེད་ཀུན་འགྲོ་ཀུན་ཁྱབ་ཡིན་པར་ནི།",
    "ཁ་ཚོན་ཆོད་པར་བཞེད་པ་ཐམས་ཅད་དང་།",
    "དབུས་མ་བར་མ་མ་ནིང་མཆོག་ཏུ་གསུངས།",
    "འདུས་མ་བྱས་ཀྱི་བདེ་བ་ཤེས་པ་དང་།",
    "འདུས་མ་བྱས་ཡིན་འདུས་བྱས་དངོས་པོ་མིན།",
    "དངོས་པོ་དངོས་མེད་གང་ཡང་མ་ཡིན་པར།",
    "བདེན་པ་ཡང་དག་མེད་པར་བཞེད་རྣམས་ལའང་།",
    "འགོག་བདེན་བདེན་པའི་མཆོག་ཏུ་གསུངས་པ་དང་།",
    "རྟག་པར་རྟོགས་ཚད་རྟག་ལྟའི་སྐྱོན་ཅན་དང་།",
    "ཆད་པར་རྟོགས་ཚད་ཆད་ལྟའི་སྐྱོན་ཅན་དང་།",
    "ཡོད་པར་རྟོགས་ཚད་ཡོད་ལྟའི་སྐྱོན་ཅན་དང་།",
    "རྟག་པར་རྟོགས་ལ་སྐྱོན་དང་ཡོན་ཏན་གཉིས།",
    "གཙང་བར་རྟོགས་ལའང་སྐྱོན་དང་ཡོན་ཏན་གཉིས།",
    "མི་གཙང་རྟོགས་ལའང་སྐྱོན་དང་ཡོན་ཏན་གཉིས།",
    "ཡོད་པར་རྟོགས་ལའང་སྐྱོན་དང་ཡོན་ཏན་གཉིས།",
    "མེད་པར་རྟོགས་ལའང་སྐྱོན་དང་ཡོན་ཏན་གཉིས།",
    "ཆད་པར་རྟོགས་ལའང་སྐྱོན་དང་ཡོན་ཏན་གཉིས།",
    "གཤིས་ལ་ཡེ་ཤེས་མེད་པར་འདོད་པ་དང་།",
    "རང་བྱུང་ཡེ་ཤེས་རྟག་པར་མི་བཞེད་པ།",
    "དེ་བཞིན་ཉིད་ཀྱང་དྲང་དོན་ཡིན་པར་འགྱུར།",
    "ངོ་བོ་ཉིད་སྐུའང་དྲང་དོན་ཡིན་པར་འགྱུར།",
    "རང་བཞིན་རིགས་ཀྱང་དྲང་དོན་ཡིན་པར་འགྱུར།",
    "ཕྱག་རྒྱ་ཆེན་པོའང་དྲང་དོན་ཡིན་པར་འགྱུར།",
    "འོད་གསལ་ཆེན་པོའང་དྲང་དོན་ཡིན་པར་འགྱུར།",
    "ངེས་དོན་ཡིན་པར་སྟོན་པའི་ལུང་རིགས་དང་།",
    "རྟག་པར་གསུངས་པ་དྲང་དོན་ཡིན་ཞེ་ན།",
    "འོ་ན་འདུས་མ་བྱས་སུ་གསུངས་པ་ཡང་།",
    "འདུས་མ་བྱས་དང་རྟག་པ་ཁྱབ་མཉམ་གཅིག།",
    "མི་རྟག་པ་དང་འདུས་བྱས་ཁྱབ་མཉམ་གཅིག།"
  ]
}