    "བསྙེན་པར་རྫོགས་པར་བྱེད་པ་དང་།",
    "ཁྱིམ་པ་ཡིན་པར་ཁས་བླངས་པའོ།",
    "དེའི་ཆད་པའི་ལས་ལ་ངས་དགོངས་ཏེ་གསུངས་སོ།",
    "བཙུན་པ་བསྙེན་པར་རྫོགས་པར་བགྱིད་པ་ཁྱིམ་པ་ལགས་པར་ཁས་བླངས་ན་བསྙེན་པར་རྫོགས་པ་ཞེས་བགྱི་འམ་བསྙེན་པར་མ་རྫོགས་པ་ཞེས་བགྱི།",
    "ཨུ་པཱ་ལི་བསྙེན་པར་རྫོགས་པར་བྲིན་ཀྱང་ཁྱིམ་པ་ཡིན་པར་ཁས་བླངས་ན།",
    "དེ་ཡང་བསྙེན་པར་མ་རྫོགས་པ་ཞེས་བྱན་བསྙེན་པར་རྫོགས་པར་བྱེད་པའི་ཚེ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "འཕགས་པ་དག་ཅི་ཁྱེད་རིག་པ་མཁྱེན་ནམ།",
    "འཕགས་པ་དག་རྒྱལ་པོའི་བལ་གླང་མཆོག་དག་བྲོས་པར་གྱུར་ནས།",
    "ཁྱེད་ཀྱིས་རྒྱལ་པོ་ལ་གནོད་པ་བྱས་པར་མི་འགྱུར་རམ་ཞེས་སྨྲས་ནས་དེ་དག་ཉེས་པ་ངོར་བརྗོད་ཅིང་འཕྱས་འདོགས་ཏེ་མི་སྙན་པར་ཟེར་རོ།",
    "དེ་ལྟ་བུ་དག་ལའང་ཐོས་པར་གྱིས་ཤིག།",
    "སྙོམས་ཞུགས་དང་ནི་མི་གནང་བ།",
    "དེ་ལྟ་བུའི་རྐྱེན་ཅིག་བྱུང་ན་གནང་ངོ།",
    "དེ་ལྟ་བུའི་རྐྱེན་ཅིག་བྱུང་ན་གནང་ངོ་དེ་བཞིན་དུ་སྟན་གཅིག་གམ།",
