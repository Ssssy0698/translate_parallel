    "དེ་དག་ཀྱང་ཡི་གེ་གསུམ་སྟེ་སྦྱོར་བ་དང་དངོས་དང་མཇུག་གི་བདེ་བའི་རྒྱུར་ངེས་པའི་ཚིག་ཏུ་གྲུབ་པར་རྟོགས་པར་བྱའོ།",
    "བཅུག་པའི་ཁྱིམ་གྱི་སྒོར་བ་ཐག་ཤིན་ཏུ་ཕྲ་བ་ལྟ་བུའི་ས་བོན་གྱི་ཡི་གེ་ཐིག་ལེ་ཅན་ནཱ་དའི་རོ་མའི་གཟུགས་སྟེང་དུ་སོང་ཡང་རུང་མ་མོ་ལྟར་སོང་བ་སྟེ།",
    "ཡང་འཁྱོག་པོར་འགྲོ་བར་མགྲིན་པའི་ཁྲོད་ཀྱི་བུ་གའི་ཕུག་ནི་ཁྱིམ་སྟེ་ལྕེ་ཆུང་འཕྱང་བའི་རྩེར་གནས་པ་དཔལ་ཧེ་རུ་ཀའི་ངོ་བོ་ཧཾ་ཡིག་ལ་བདག་མེད་མས་རེག་པར་བལྟའོ།",
    "ཆོ་ག་ནི་དབེན་པའི་ཁྱིམ་ལ་སོགས་པར་སྟན་འཇམ་ཞིང་བདེ་བར་འདུག་སྟེ་བདག་ཉིད་བདག་མེད་མར་མོས་པར་བྱས་ལ་དག་པའི་སྔགས་བརྗོད་དོ།",
    "དེ་ཡང་སྣ་ཚོགས་དང་ནག་པོ་དང་དམར་པོ་དང་དཀར་པོའི་ཁ་དོག་ཏུ་རྣམ་པར་བསྒོམ་མོ།",
    "དེ་ནས་དེའི་སྟེང་དུ་གྱུར་པའི་རྡོ་རྗེའི་དབུས་ཀྱི་རའི་རྩེ་མོ་ནས་འཇིག་པའི་དུས་ཀྱི་མེ་འབར་བ་ལྟར་ལངས་པ་དང་།",
    "འཚེ་བ་མེད་པའི་ཁང་པ་ལ་སོགས་པ་རུ་སྟན་བདེ་བ་ལ་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་བསྡམས་པས་བདག་མེད་མར་མོས་ལ་རྣམ་པར་དག་པའི་སྔགས་བརྗོད་དོ།",
    "དེ་ནས་སྤྲུལ་པའི་འཁོར་ལོའི་དབུས་སུ་སྲོག་སོང་བའི་སེམས་ཀྱི་གཞིར་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་སྔར་གསུངས་པའི་རང་གི་མཚན་ཉིད་ཅན་གྱི་བདག་མེད་མ་རྣམ་པར་བསྒོམས་ལ།",
    "དེ་ནས་ཡེ་ཤེས་ལྔའི་བདག་ཉིད་ཅན་དོན་དམ་པའི་ཤེས་རབ་ཀྱི་རང་བཞིན་དུ་ཐིག་ལེའི་གཙོ་བོ་འབར་བར་ཇི་ཙམ་འདོད་པ་བསྒོམ་མོ།",
    "དེ་ནས་སྣའི་རྩེ་མོའི་གཙུག་ཏོར་དུ་ཁྱེར་ལ་དུས་རིང་མོར་བདེ་བར་གནས་པར་བསམ་པར་བྱའོ།",
    "དེ་ནས་དེའི་ཐིག་ལེ་བ་ཐག་ལྟར་རང་ལས་བྱུང་བའི་སྐུད་པའི་རི་མོའི་རྒྱུན་གྱིས་སྐས་ཀྱི་ཁྲེམ་གཉེར་གྱི་ལམ་ལ་སོང་བ་དང་།",
    "རང་གི་སྤྲུལ་པའི་རྩིབས་དང་ལྡན་པར་བདག་མེད་མ་སྔར་བསྐྱེད་པ་གསུངས་པ་བཞིན་བསྐྱེད་ལ།",
    "དང་པོའི་མཆོག་གི་རང་བཞིན་ཅན་འོད་གསལ་བར་བཅུ་དྲུག་ཆ་ཞག་གི་གཙོ་བོ་དང་།",
    "དེ་ལས་བྱུང་བའི་ཡོངས་སུ་རྩོམ་པ་དང་སོ་སོར་འབྱེད་པ་དང་རྣམ་པར་སྤྱོད་པ་རྣམས་སུ་སྟོན་པ་ཁབ་ལྟ་བུ་ཤིན་ཏུ་རྣོ་བའི་ཉི་མའི་འོད་ཟེར་ལྟར་ཕྲ་བ་ལྟ་བུ་ཤིན་ཏུ་དམར་པོ་དེ་ཁ་སྦྱོར་ལན་གསུམ་དུ་དགྲོལ་ཏེ་དེར་ནང་དུ་སོང་བར་བསམ་པར་བྱའོ།",
    "དེ་ནས་དེ་དག་དགའ་བས་བསྐྱོད་པས་གཟུགས་བརྙན་རེག་པ་ལས་བྱུང་བའི་ཆགས་པས་ཞུ་བར་གྱུར་ཏེ།",
    "སྟོབས་སུ་སྨིན་པས་རྒྱས་པ་ལས་སྤྲོ་ཞིང་མ་རྒུད་ཅིང་ལེགས་པ་མཆོག་གི་དགའ་བ་ཚོགས་བསྡུ་བ་བྱས་པས།",
    "དེ་ཉིད་དུ་རྗེས་སུ་ཆགས་པ་བསྒོམ་མོ།",
    "དེ་ཡང་སྤྲུལ་པའི་འཁོར་ལོར་པདྨ་འདབ་མ་ནང་དུ་བཞི་ཕྱིར་བཅུ་བསྒོམ་མོ།",
    "བདེན་བྲལ་དུ་རིང་དུ་སོང་བ་དང་མིག་གཡོ་བའི་རང་བཞིན་ཅན་གཏུམ་མོའི་ངོ་བོ་དབྱངས་ཡིག་བརྒྱད་པའོ།",
    "དེ་ནས་ཉི་མའི་འོད་དམར་པོ་སྤྲོས་པས་མཐོང་བས་གསལ་ཏེ་ཐོ་རངས་ཀྱི་སྐར་མ་ལྟར་ཐིམ་པར་དབྱངས་ཡིག་བཅུ་བཞི་པོ་དེ་དག་རྣམ་པར་བསྒོམ་མོ།",
    "དང་པོ་དབྱངས་ཡིག་ཀྱང་ཉིན་མོས་འཇིགས་པ་ལྟར་ཐིག་ལེ་ཕུག་ཏུ་ཞུགས་པར་བསམ་མོ།",
    "དེ་ཡང་ཐིག་ལེ་ཕུག་གི་བུར་པར་ཞུགས་པ་དང་ཉི་མའི་འོད་ཀྱིས་གདུངས་པས་བསྲེག་པར་བྱ་སྟེ།",
    "དེ་ནས་དེའི་ནཱ་དས་བསྐུལ་བས་སྔགས་དང་ཁྱུ་མཆོག་གི་རྭ་ཡིས་བརྡུངས་པས་ཞུ་བ་ཐག་པ་འཕྱང་བ་ལྟར་ངང་པ་སྐྱུགས་པ་སྟེ།",
    "ཤིང་སྐམ་པོའི་ཡལ་གའི་ཚོགས་ལ་ཕུལ་དུ་གྱུར་པའི་ཤེས་རབ་མེའི་ཚོགས་སུ་འབར་བས་ཡང་བདག་མེད་མའི་རང་བཞིན་གཏུམ་མོ་ལྟར་མི་རེག་པ་གཏུམ་ཞིང་རབ་ཏུ་གཏུམ་པ་བལྟའོ།",
    "མི་དམིགས་པ་དང་བསམ་དུ་མེད་པ་དང་བརྗོད་དུ་མེད་པར་གྱུར་ཏེ་དེར་ཅི་ནུས་ཙམ་གྱི་བར་དུ་བསྒོམ་མོ།",
    "རང་གི་ལུས་ཉིད་ས་དང་ཕ་རོལ་ཏུ་ཕ་ཕྱིན་པ་བསྡུས་པའི་རང་བཞིན་གནས་ལ་སོགས་པ་བསྡུས་ཏེ།",
    "དེར་གནས་པའི་རྩ་ཀུན་ཡང་དག་པར་བརྟེན་པའི་རྩ་གསུམ་པ་ནི་བདག་མེད་མར་མོས་སོ།",
    "དེ་ལ་མགྲིན་པ་ན་བརྩམས་ཏེ་གཡོན་ན་གནས་པའི་ཁ་འོག་ཏུ་བལྟས་ནས་ལྟེ་བའི་འཁོར་ལོར་སོང་ཞིང་ཆུ་འབབ་བརྐྱང་མ་ཞེས་བྱ་བའི་རྩ་སྟེ།",
    "སྐུ་དང་ཟླ་བ་དང་ཨཱ་ལི་དང་སྟོང་པ་ཉིད་དང་ལམ་དུ་འཇུག་པ་དང་མཚན་མོ་དང་ནུབ་པ་དང་བྱང་དུ་རྒྱུ་བ་རྨི་ལམ་དང་གཟུང་བ་དང་ཤེས་བྱ་དང་དོན་དམ་པ་དང་ཕྲ་བ་དང་ཨེ་ཡིག་དང་དངོས་པོ་མེད་པས་བསྡུས་པའི་རང་བཞིན་བདག་ཉིད་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུའི་རང་བཞིན་དུ་མོས་པར་བྱའོ།",
    "ལྟེ་བ་ནས་བཟུང་སྟེ་ཁ་སྟེང་དུ་བལྟས་ཏེ་གཡས་ནས་རྒྱུ་བའི་མགྲིན་པའི་མཐར་ཐུག་གི་བར་དུ་སོང་ནས་ཁྲག་འབབ་པ་རོ་མ་ཞེས་པའི་རྩ་སྟེ།",
    "བཾ་ཡིག་དངོས་པོར་བསྡུས་པའི་རང་བཞིན་ཐམས་ཅད་ཀྱི་བདག་ཉིད་ཅན་སྤྲུལ་པའི་སྐུའི་ངོ་བོར་མོས་པར་བྱའོ།",
    "སྤྲུལ་པའི་འཁོར་ལོར་སོན་པའི་རྩ་གསུམ་པོ་གཅིག་གི་རང་བཞིན་དེ་ཁོར་སྟོང་ཆ་གསུམ་པ་ལྟ་བུའི་བུ་གུ་ཅན་རྭ་བསྡོམས་པ་ལྟ་བུ་རྡོ་རྗེའི་རྣམ་པ་ལྟ་བུ་འམ།",
    "བསྲུང་བ་དང་དཀྱིལ་འཁོར་ལ་སོགས་པའི་ཆོ་ག་བྱས་ནས་མཉམ་པར་གཞག་པའི་ཡིད་ཀྱིས་བདག་མེད་མར་མོས་པར་བྱའོ།",
    "དེ་ནས་སྤྲུལ་པའི་ཁང་པ་རྒྱུན་དུ་གནས་པ་ཅན་རང་གི་འོད་ཀྱི་དཀྱིལ་འཁོར་གྱིས་བསྐོར་བ་བརྩེ་བ་དང་བྲལ་བས་གདུངས་ཏེ།",
    "བརྩེ་བ་དང་ཕྲད་པས་འདོད་པའི་ཡི་གེ་མཆོག་གི་རང་བཞིན་དུ་བཙུན་མོ་ཆེན་མོ་བདག་མེད་མ།",
    "དེ་ནས་འོད་ཟེར་གྱི་ཕོ་ཉ་བཀུག་ནས་ཁྱེར་བ་དང་ཆགས་པ་ལྟ་བུར་རྗེས་སུ་ཆགས་པའི་དགའ་བས་རྙེད་དེ་འཁྱུད་པས་ཀྱང་ཐོབ་པ་ནི་དབུལ་མོས་གཏེར་རྙེད་པ་ལྟ་བུའམ།",
    "བཀྲེན་པས་དགོས་པ་ཁྱད་པར་ཅན་གྱི་སྟོན་མོ་ཟོས་པ་ལྟ་བུའམ།",
    "མཆོག་གི་བདེ་བ་ཐོབ་པར་གྱུར་པས་བསྒོམས་པའི་སྟོབས་ཀྱིས་དོན་དམ་པ་མངོན་དུ་བྱའོ།",
    "དེ་ནས་དེ་དབྱུག་པས་རེག་པའི་སྦྲུལ་མོ་ལྟར་དབྱུ་གུའི་རྣམ་པ་ལྟར་ལངས་ཏེ་ཁའི་བུ་ག་ནས་མེ་འབར་བ་ལྟར་བལྟའོ།",
    "དེ་ནས་བདག་མེད་མ་དེ་ནུ་མ་ནང་དུ་ཐིམ་པར་གྱུར་ཅིང་རང་གི་པདྨའི་ཟེ་འབྲུ་ལས་སྐྱེས་པ་རྡོ་རྗེ་འགྲམ་གཉིས་ནི་དྲིལ་བུ་སྟེ་ཆགས་པ་དང་བཅས་ཤིང་ཆགས་པའི་ལྟ་བས་བལྟས་པས་གང་ཡང་རུང་བ་སྟེ་ཌོམྦི་ནཱིར་བལྟའོ།",
    "རྣམ་པར་སྤྲོས་པ་ཐམས་ཅད་བདག་གི་རང་བཞིན་དུ་བྱའོ།",
    "སེམས་ཙམ་གྱི་བདག་ཉིད་དུ་རྣམ་པར་བསམ་མོ།",
    "བརྟན་པར་གྱུར་པ་དང་སེམས་ཀྱི་མཚན་མ་བརྟག་སྟེ་མཚན་མ་ཡང་ལྷུན་གྱིས་གྲུབ་པར་སྐྱེས་པའི་དགའ་བའི་ཤུགས་ཀྱིས་རྒྱུན་གང་གི་ཚེ་མངོན་སུམ་དུ་གསལ་བར་སྣང་བར་གྱུར་པ་དེ་ཡིན་ཏེ།",
    "དེ་ལྟར་ཤེས་ཤིང་མཚན་མ་རྙེད་པ་མཉམ་པར་གཞག་པའི་སྔགས་པས་ས་བོན་གྱི་གཟུགས་སམ་ཐིག་ལེའི་གཟུགས་སམ་མཚན་མ་ཕྲ་མོའི་གཟུགས་ཏེ།",
    "དེ་ལ་སེམས་ལྷ་མོའི་མཁར་དུ་བཀོད་དེ་ཁམས་གསུམ་དུ་སོང་བས་ཁ་དོག་ལེགས་པའམ་མི་ལེགས་པའི་གཟུགས་མངོན་སུམ་དུ་མཐོང་བར་འགྱུར་རོ།",
    "གཉི་གའི་དབྱེ་བས་ཕྱེ་བའི་སྒྲ་ཐམས་ཅད་ཐོས་ཤིང་སྒྲ་མ་ལུས་པ་གང་གི་ཡིན་པ་ཤེས་པར་འགྱུར་རོ།",
    "དེ་བཞིན་ཏྲི་ཤ་ཀུ་ནེར་ལྷའི་བཙུན་མོ་དགུག་པ་སྤྲུལ་པ་ལོངས་སྤྱོད་དོ།",
    "པོ་ལ་གི་རི་རུ་ལྷ་ཐམས་ཅད་མཐོང་ཞིང་བདག་གི་བཀའ་བསྒོ་བ་ཡང་འགྲུབ་པར་བྱེད་དོ།",
    "དེ་ལ་མདུན་དུ་དག་པར་སྦྱངས་པའི་བདུད་རྩིས་མཎྜལ་བྱུགས་ལ་མེ་ཏོག་གི་ཚོམ་བུ་བྱས་ལ་དེའི་དབུས་སུ་མཆོག་གི་སྣོད་གཞག་པར་བྱའོ།",
    "དེའི་སྟེང་ནས་མཉམ་པའི་སྣོད་ཆེ་བས་ཁ་བཅད་དེ་དབུས་སུ་བདེ་བྱེད་ཀྱི་མིག་གི་གྲྭའི་འཁོར་ལོའི་རྣམ་པ་ལ་བདུད་རྩི་དང་སྒྲོན་མའི་ཕྱེ་མ་ཆོ་གས་སྦྱངས་ཏེ་བཏབ་ལ།",
    "ཡང་གླུ་དང་གར་དང་རོལ་མོའི་ཁྱད་པར་གྱིས་བསྐོར་བ་དང་ཕྱག་དང་བསྟོད་པས་ཀྱང་ཅི་ནུས་པས་ཡོངས་སུ་མཆོད་དོ།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་མ་སྟེ་ནག་པོ་འམ་པྲི་ཡང་ཀུ་སྔོན་མོ་སྟེ་ཆོ་ག་བཞིན་མཆོད་ནས་མཆོག་ཏུ་གྱུར་པའི་སྟོན་མོ་དང་ཆང་ཡང་བཏུང་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་མའི་འཁོར་ལོ་ཡང་མུ་ཞེས་བརྗོད་ལ་གཤེགས་སུ་གསོལ་ཏེ་རང་ཉིད་སྟོན་མོ་བྱའོ།"
  ]
}