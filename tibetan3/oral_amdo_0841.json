    "གཉིས་ཀ་ཡང་རང་གི་ངོ་བོ་རྟོགས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྤྱི་དང་ཞེས་བྱ་བའོ་། ཁྱོད་ཀྱི་ལུགས་ཀྱིས་ཡུལ་དུ་མ་བྱས་པ་ལ་འཇུག་པ་མི་འཐད་དོ་ཞེས་ལན་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ།",
    "སྤྱི་དང་ཁྱད་པར་དག་ལ་རང་བཞིན་གཅིག་ཉིད་ཀྱིས་རྟོགས་པའི་སྐྱེས་བུ་ནི་དེ་དག་གིས་གཅིག་ཉིད་རྟོགས་པར་འགྱུར་བ་ཡིན་གྱི་གཉིས་ཀ་མ་རྟོགས་པར་ནི་མ་ཡིན་ནོ།",
    "དཔེར་ན་སྒོང་གི་ཐ་དད་པ་བཞིན་ནོ།",
    "རང་གི་ངོ་བོས་ཞེས་གསུངས་སོ།",
    "འོ་ན་འདས་པ་ཉིད་དུ་ཐ་སྙད་གང་གིས་དགོས་སོ་སྙམ་ན།",
    "གང་གི་ཕྱིར་གཉིས་ཀ་འདས་པ་དང་།",
    "དེ་ལྟ་མོད་ཀྱི་ཞེས་གསུངས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དུས་གཞན་དུ་གནས་པ་ཉིད་འཛིན་པར་མི་འཐད་པ་དེའི་ཕྱིར་རོ།",
    "འདི་དངོས་པོའི་རང་བཞིན་གཅིག་གི་རྗེས་སུ་འབྲང་བའམ།",
    "གང་གིས་ལྡོག་པ་ཐམས་ཅད་ངེས་པར་འགྱུར་བ་ཇི་ལྟར་ནི་དེ་ཁོ་ན་བཞིན་དྲན་པར་འགྱུར་ཞེ་ན།",
    "འཇིག་པ་གཞན་མི་རྟག་པ་ཡིན་པར་འགྱུར་མོད།",
    "རང་གི་ངོ་བོ་ཙམ་གྱིས་ནི་མི་རྟག་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རིགས་པའི་ལྟར་ན་སྟེ།",
    "ནམ་མཁའ་ལ་སོགས་པ་ཡང་མི་རྟག་པ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རེ་ཞིག་ཅེས་བྱ་བ་ནི་འཆད་པའོ།",
    "ཁྱད་པར་མེད་པར་ཞེས་བྱ་བ་ནི་མཐའ་གཉིས་ཀྱི་ཁྱད་པར་མེད་དོ་། མི་རྟག་པ་དང་ཐལ་བའི་ཕྱིར་རོ་ཞེས་འབྲེལ་ཏོ།",
    "ཡང་ན་ཡོད་པ་དང་དེ་དང་འབྲེལ་བའི་དུས་ན་ནི་དངོས་པོ་མེད་པ་ཁོ་ན་ཡིན་ན། དེ་ཇི་ལྟར་འདི་ཡོད་པ་དང་དེ་དང་འབྲེལ་པ་དག་གི་ཁྱད་པར་དུ་འགྱུར།",
    "དེ་ཉིད་མི་རྟག་པ་ཡིན་མོད།",
    "བཟློག་མེད་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་ཡང་འདུ་བ་ལ་སོགས་པའི་འབྲེལ་པ་གང་གིས་ཟློག་པར་བྱེད་ཅིང་དྲུག་པ་ལ་སོགས་པའི་སྦྱོར་བཡང་གང་གིས་བཟློག།",
    "འོན་ཏེ་རྟག་པ་ཕྱིར་ན་ཡོད་པ་དང་དེའི་འབྲེལ་པ་མཐའ་དག་གི་ཁྱད་པར་དུ་འགྱུར་བ་མ་ཡིན་མོད་ཀྱི་། འོན་ཀྱང་དོན་གང་ལ་དེ་གཉིས་ཡོད།",
    "དེ་ཉིད་མཐའ་དག་གི་ཁྱད་པར་དུ་བྱེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལྟར་སྔ་ན་མེད་པ་དང་ཞིག་ནས་མེད་པའི་བར་ནས་ཡོད་པའི་ཡོད་པ་ཉིད་མི་རྟག་པ་ཉིད་དུ་མི་འཐད་ལ་དེར་ཁས་ལེན་ན་ཡང་དེ་གཉིས་ཉིད་མི་རྟག་པར་ཐལ་ལོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ད་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་གང་གི་འབྲེལ་པ་ཁས་མི་ལེན་པའི་ཕྱིར་མེད་པ་གཉིས་ཀྱི་དབུས་ན་གནས་པའི་ཡོད་པ་མི་རྟག་པ་ཉིད་མ་ཡིན་ལ།",
    "དེ་ཁས་བླངས་པ་སྔོན་དུ་སོང་བ་ཅན་གྱི་སྔ་ན་མེད་པ་ལ་སོགས་པ་ཉིད་ཀྱང་མི་རྟག་པ་ཉིད་མ་ཡིན་གྱི།",
    "འབྲས་བུ་ནི་གྱོ་མོ་ལ་སོགས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་ཡིན་དུ་ཟད་མོད།",
    "རྒྱུ་དང་འབྲས་བུ་དེ་དག་གིས་། ཞེས་གསུངས་སོ།",
    "རང་གི་ངོ་བོ་ཉམས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་རྒྱུ་དང་འབྲས་བུ་དངོས་པོའི་ཡིན་པར་ཇི་ལྟར་མི་འགྱུར་ཞེ་ན།",
    "དེས་ན་ཡོད་པའི་ཡོད་པ་ཉིད་མི་རྟག་པ་ཡིན་ནོ་ཞེས་བྱ་བར་རང་གི་གཞུང་ཉམས་པ་དང་།",
    "གང་གི་ཕྱིར་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་འབྲེལ་པར་ཁས་མི་ལེན་ན་ཉེས་པ་འདི་ཡོད་པ་དེས་ནའོ།",
    "འོན་ཀྱང་འབྲེལ་པ་མེད་མོད།",
    "འབྲས་བུ་རང་གི་རྒྱུ་དང་འབྲེལ་པའི་འདུ་བ་དེ་བྱེད་པའི་ཕྱིར་ན་རྒྱུ་ཡིན་ནོ་ཞེས་གྲག་གོ།",
    "རེ་ཞིག་དངོས་པོའི་རང་བཞིན་ནི་བྱེད་པ་མ་ཡིན་ལ་ཡོད་པ་དང་འབྲེལ་པ་ཡང་རྟག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རྣམ་པ་གཞན་བརྗོད་པའོ།",
    "འོ་ན་འདིར་འབྲས་བུ་གང་ཞེས་བྱ་བ་ནི་འདོད་པ་དང་འབྲེལ་པ་དང་རྒྱུ་དང་འབྲེལ་པ་ལ་སྐྱེ་བར་ཁས་ལེན་ན་ཡོད་པ་ནི་རེ་ཞིག་བྱེད་པ་མ་ཡིན་ཏེ་རྟག་པའི་ཕྱིར་རོ།",
    "སྐྱེ་བཞིན་པའི་འབྲས་བུ་ཉིད་རང་གི་རྒྱུ་དང་འདུ་བ་ཡིན་ནམ།",
    "རང་གི་ངོ་བོ་ཁོ་ནས་སྔ་ན་མེད་པའི་ཁྱད་པར་མེད་པར་རོ།",
    "ཁྱོད་ཀྱི་འདོད་པ་དང་སྦྱར་ན་ནི་དེ་ལྟར་ཡང་མ་གྱུར་ཏེ་ཞེས་བརྗོད་པ་ནི་དངོས་པོ་སྔར་མེད་ཅེས་བྱ་བའོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡིན་མོད།",
    "དེ་ལྟ་ན་ཡིན་མོད་ཅེ་ན་ཁས་ཀྱང་ཞེས་གསུངས་སོ།",
    "གང་གི་ཚེ་དེ་ལྟར་དངོས་པོ་སྔ་ན་མེད་པ་ལ་སོགས་པ་དང་མ་འབྲེལ་ན་ཉེ་བར་ེའགྱུར་བ་ཁོ་ན་གང་གི་དངོས་པོའི་དངོས་པོ་མེད་པ་དེ་མི་རྟག་པ་ཉིད་དུ་འགྱུར་བ་སྔ་ན་མེད་པ་དང་ཞིག་ནས་མེད་པའི་མཚན་ཉིད་ཅན་དངོས་པོའི་དུས་ན་ཡོད་པ་མ་ཡིན་པའི་དངོས་པོ་མེད་པ་དང་།",
    "དོན་མེད་སྒྲོ་འདོགས་པ་ནི་དོན་ལ་རེག་པ་དང་བྲལ་བའི་སྟེ་བླའོ།",
    "ཕྱེད་ཕྱི་མ་ནི་བླ་ིབའི་ཕྱིར་མ་བཀྲོལ་ཏོ་། གང་གི་ཕྱིར་རྣམ་པར་དཔྱད་ན་མི་གནས་པ་དེའི་ཕྱིར་འདི་ནི་འབྲེལ་པའོ།",
    "གང་གི་ཕྱིར་དོན་དམ་པ་མིན་པ་དེའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་མེད་སྙམ་ན་ཁ་དོག་གི་སྤྱི་ལ་མི་རྟག་པ་ཉིད་ཀྱི་སྤྱི་སྦྱོར་བའི་ཕྱིར་ཏེ།",
    "གང་གི་ཕྱིར་ཁ་དོག་ལ་སོགས་པ་ནི་མི་རྟག་པའོ་སྙམ་པའི་ཤེས་པས་ནི་ཁ་དོག་གི་སྤྱི་ལ་མི་རྟག་པའི་སྤྱི་སྦྱར་བ་ཡིན་ཏེ།",
    "མི་འདོད་པར་ཐལ་ཕྱིར་ཞེས་གསུངས་སོ།",
    "རང་གི་ཞེས་གསུངས་སོ།",
    "མེ་ལ་སོགས་པའི་དོན་བྱེད་པ་དང་འབྲེལ་པ་ནི་མངོན་སུམ་དང་མི་དམིགས་པ་དག་གིས་སྔར་མཐོང་བ་ཡིན་ཏེ།",
    "དངོས་པོ་པའི་རང་གི་ངོ་བོ་འཛིན་པའི་ཕྱིར་རོ་ཞེས་དོགས་པ་བསུ་ནས།",
    "༢་དྷཎྜ་༣༨༨ཐལ་བ་མེད་དོ་ཞེས་བྱ་བར་བསམས་པའོ།",
    "བགྲོད་པར་བྱ་བ་མ་ཡིན་པར་མ་ལ་སོགས་པར་བགྲོད་པར་ལུང་ལས་ཉེ་བར་བསྟན་པ་ནི་སྐད་ཅིག་གི་རྒྱུར་མ་ལྟོས་པ་ཡིན་གྱི།",
    "སྐད་ཅིག་གཅིག་ྱགི་ཡུལ་ཅན་ནི་མ་ཡིན་ནོ།",
    "ཉེ་བར་ལེན་པ་དང་ཉེ་བར་ལེན་པ་ལས་བྱུང་བའི་རྒྱུ་ནི་གཅིག་གི་ཐ་སྙད་ཀྱི་ཡུལ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི་བགྲོད་པར་བྱ་བ་མ་ཡིན་པར་བགྲོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེ་ནི་གང་ལས་ཡུལ་རྣམ་པ་གཉིས་ངེས་པར་འགྲུབ་པ་སྟེ་ལས་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གི་ཡུལ་ངེས་པའི་མཚན་ཉིད་ཀྱི་ངེས་པར་གྲུབ་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་དེས་ན་ཞེས་བྱ་བའོ།",
    "སྐད་ཅིག་དེ་རང་གི་ངོ་བོས་དེའི་ཡུན་ནི་མ་ཡིན་གྱི་འོན་ཀྱང་མངོན་སུམ་གྱིས་མཐོང་བའི་སྐད་ཅིག་དང་།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ནི་འཆད་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ན་ནི་བརྗེད་པ་ཉིད་ཀྱི་ཕྱིར་ནའོ་། རེ་ཞིག་རྩོད་པའི་ཆ་རྣམ་པར་འགྲེལ་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "རང་གི་གཞན་གྱི་རྗེས་སུ་དཔག་པ་ལྟར་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གང་གི་རྗེས་སུ་དཔག་པར་འགྱུར་བ་རྗེས་སུ་རྣམ་པ་གཞན་དུ་འགྱུར་བར་སྲིད་སྙམ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་རང་གི་དུས་ཀྱི་མཐར་ཐུག་པའི་རང་བཞིན་མི་འཛིན་ནའོ།",
    "དུས་ནི་རང་གི་དུས་ཀྱི་མཐར་ཐུག་པའི་རང་བཞིན་ཉིད་མངོན་སུམ་གྱིས་འཛིན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་འཆི་བའི་མཐའ་དང་བཅས་པར་འཛིན་པར་ཐལ་བ་ལས་ཇི་ལྟར་ཐར་སྙམ་ན།",
    "རེ་ཞིག་རྩོད་པའི་ཆ་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གཅིག་གྲུབ་པ་ན་ཞེས་བྱ་བ་ནི་གཉིས་ཀྱི་ནང་ནས་གཅིག་ཁོ་ན་གྲུབ་མོད།",
    "རང་གི་ངོ་བོ་འཛིན་པའི་ཕྱིར་ཇི་ལྟར་སྤྱིའི་ཡུལ་ཅན་ཞེ་ན་གང་ཞིག་ཅེས་བྱ་བའོ།",
    "སྐབས་ཉེ་བར་སྡུད་པ་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བའོ་ཤེས་པ་གང་གིས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཁྱད་པར་མཐོང་བ་སྤྱིའི་ཡུལ་ཅན་ཡིན་པ་དེའི་ཕྱིར་དེ་ལྟ་ཡིན་པ་ཞེས་བྱ་བའོ།",
    "དེ་དང་བྲལ་བ་ཉིད་སྒྲུབ་པའི་དོན་དུ་རྟོག་པ་དང་འཁྲུལ་པའི་རང་གི་ངོ་བོ་གསུངས་པ་ནི་ཁྱད་པར་ཞེས་བྱ་བའོ།",
    "དཔེ་མེད་པར་ཐལ་བའི་ཕྱིར་རོ་ཞེས་ཀྱང་བསྟན་ཟིན་ཏོ།",
    "ཐལ་བར་འགྱུར་བའི་སྒོ་ནས་འཆད་པ་ནི།",
    "ཉམས་སུ་མྱོང་བ་ནི་རང་གི་ཡུལ་ལ་རང་གི་བྱེད་པའི་རྗེས་སུ་འབྲང་བའི་རྣམ་པར་རྟོག་པ་བསྐྱོད་པས་ན།",
    "གང་གིས་དེ་དགག་པར་བརྗོད་པ་ཡིན་ིཔའི་ཐ་སྙད་དུ་བྱེད་པའི་རྣམ་པར་རྟོག་པ་ཡོད་ན་ཅི་ཉེས་སྙམ་ན།",
    "རྣམ་པར་རྟོག་པ་མེད་པ་དང་ཅིག་ཤོས་དག་རེ་རེ་མེད་ཀྱང་ཡོད་པའི་ཕྱིར་གཅིག་ཉིད་མ་ཡིན་ནོ།",
    "་ འབའ་ཞིག་པ་དག་གི་ནང་ནས་སྔོན་པོ་དང་སེར་པོ་གཅིག་པར་མི་བཟོད་ནས་གཞན་དག་དོགས་པར་བྱེད་པ་ནི་ཅི་སྟེ་ངོ་ཤེས་པའི་ཕྱིར་ཏེ་ཞེས་བྱ་བའོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་དེ་བརྗོད་པ་ཉིད་ཀྱི་ཞེས་བྱ་བ་སྟེ་རང་གི་མཚན་ཉིད་བརྗོད་པའོ།",
    "རང་གི་མཚན་ཉིད་ལ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་དང་།",
    "དེ་ལ་རེ་ཞིག་རང་གི་མཚན་ཉིད་བརྡའི་ཡུལ་མ་ཡིན་པར་སྒྲུབ་པ་ན་གཅིག་ཏུ་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཞེས་གསུངས་སོ།",
    "ཅིའི་ཕྱིར་མི་མཐོང་སྙམ་ན་དེ་ན་ཞེས་གསུངས་ཏེ་མངོན་སུམ་མོ།",
    "གང་གི་ཕྱིར་ཁྱད་པར་གཅིག་ཏུ་མཐོང་བ་ནི་གཞན་དུ་མཐོང་བ་དེའི་ཕྱིར་རོ།",
    "ཁྱད་པར་སྒྲའི་ཡུལ་མ་ཡིན་མོད།",
    "ཤེས་པ་གང་གིས་ཐ་སྙད་ཀྱི་དུས་སུ་རྟོགས་པར་བྱ་བ་ཡིན་ཏེ།",
    "རེ་ཞིག་རྣམ་པར་རྟོག་པ་ཐ་མ་སེལ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "འོན་ཏེ་ཡང་གང་གི་ཚེ་དོན་འདས་ཏེ་མེད་པ་ན་ཡང་བརྡ་བྱེད་པ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གང་གི་ཕྱིར་དེ་ལྟ་མ་༤ཡིན་པ་དེའི་ཕྱིར་ཐ་དད་པ་ནི་ཐམས་ཅད་དུ་ཞེས་བལྟའོ།",
    "དོན་རྐྱང་བ་ཙམ་ཞེས་བྱ་བ་ནི་རྟགས་ཀྱི་དོན་ཙམ་མོ།",
    "རེ་ཞིག་འདི་ནི་ཁས་བླངས་ནས་བརྗོད་པ་ཡིན་ཏེ།",
    "བློའི་ཡུལ་གྱི་དོན་ལས་རེས་འགའ་སྒྲེ་འབྱུང་སྟེ་སྐྱེ་ལ།",
    "རེས་འགའ་ནི་སྒྲ་ལས་བློ་ལ་གནས་པའི་དོན་ཡིན་པའི་ཕྱིར་ཏེ་རྣམ་པ་དེ་ལྟར་བློའི་རང་བཞིན་དང་ངག་གི་རྣམ་པར་རིག་བྱེད་དེ་གཉིས་སོ།",
    "མིག་ལ་༤ སོགས་པ་སྐྱེད་པའི་ཤེས་པ་ལ་སྣང་བའི་ངང་ཚུལ་གང་ལ་ཡོད་པ་དེ་ལ་བརྡ་བྱེད་པ་ཡིན་ན་དེའི་ཚེ་རང་གི་མཚན་ཉིད་དེ་ནི་ཐ་སྙད་ཀྱི་དུས་ན་སྒྲ་བརྗོད་པའི་རྗེས་སུ་སྣང་བར་འགྱུར་རོ།",
    "དེ་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་དོ།",
    "རྣམ་པར་རྟོག་པ་ཡང་ཡིན་ལ་བདེན་པ་ཉིད་ཀྱང་ཡིན་མོད་འགལ་བ་ཅི་ཡོད།",
    "རང་གི་མཚན་ཉིད་ཅེས་བྱ་བ་ནི་བ་ལང་ལ་སོགས་པའི་རརང་གི་མཚན་ཉིད་འཛིན་པ་ལྟུང་གྱུར་པའོ།",
    "ཁོ་བོ་ཅག་གི་ལྟར་ན་འཛིན་པ་ཡིན་པར་འགྱུར་རོ་ཞེས་བསམས་པའོ།",
    "ཇི་ལྟར་བ་ལང་གི་མཐོང་བ་རྒྱུན་འཆད་པ་མིན་ཞེས་བྱ་བ་ནི་ལྟོས་པའོ།",
    "རིགས་མི་མཐུན་པའི་རྣམ་པར་རྟོག་པའི་དུས་སུ་ཡང་བར་དུ་གཅོད་པ་ནི་སྲིད་པ་མ་ཡིན་ནོ་། བར་ཆོད་རྟོགས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ཁའི་རོ་མྱང་བ་ཞེས་བྱ་བ་ནི་རེག་བྱ་དང་རོ་དག་གོ།",
    "གང་གི་ཞེ་ན་ཉེ་བར་གནས་པ་ཐམས་ཅད་ཀྱི་རྣམ་པར་ཤེས་པ་བསྐྱེད་པའིའོ།",
    "དེ་སྐད་སྨྲ་བའི་བྲམ་ཟེ་དེ་དག་གི་ལུགས་ལྟར་ན་མངོན་སུམ་ཁོ་ནར་འགྱུར་གྱི་རྣམ་པར་རྟོག་པ་༤མ་ཡིན་ཏེ།",
    "འགྱུར་མོད་ཅེས་བྱ་བ་ལ་སོགས་པས་གཞན་༏",
    "གྱི་ཚིག་གི་དོགས་པ་བསུ་ིནས་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ་།",
    "འོ་ན་ཁྱོད་ཀྱང་མངོན་དུ་བྱེད་པ་ཉིད་ལ་རྣམ་པར་རྟོག་པ་མེད་པ་འགྲུབ་པར་འདོད་པ་ཉིད་མ་ཡིན་ནམ།",
    "དེས་ན་ཚིག་གང་གིས་རྟོག་པ་མེད་པ་འགྲུབ་པར་བྱ་བའི་དོན་དུ་མངོན་དུ་བྱེད་པ་སྒྲུབ་པར་བྱེད་པར་སློབ་དཔོན་གྱིས་གསུངས་ཤེ་ན།",
    "གང་གིས་གཞན་གྱི་ལུགས་ལ་ལྟོས་པའི་མཚན་ཉིད་ལ་མ་འཁྲུལ་བ་ཉིད་མེད་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་རེ་ཞིག་རྣམ་པར་རྟོག་པ་མེད་པའི་ཚིག་གིས་མངོན་དུ་བྱེད་པ་ཉིད་ཉེ་བར་མཚོན་ནས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "འོན་ཏེ་གང་གིས་དེ་ལ་རྟོགས་ན།",
    "གང་གི་ཚེ་སྔོན་པོ་ལ་སོགས་པ་ཉེ་བ་ལས་བདེ་བ་༤སོགས་པའི་རང་བཞིན་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་ལ་རང་ལ་བརྟེན་པའི་ཁྱད་པར་ཡོད་པ་དེས་ན་ཅི་དེ་རྣམ་པར་རྟོག་པ་དང་བཅས་པར་འགྱུར་རམ་ཞེས་བྱ་བའོ།",
    "ཐ་སྙད་ཙམ་ཞེས་བྱ་བ་ནི་ལྷག་པར་ཞེན་པ་ཙམ་མོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་གྲུབ་པའི་མཐའ་སྟེ་གཅིག་གི་ཚིག་དང་གཉིས་ཀྱི་ཚིག་ལ་སོགས་པའོ། ། ཐ་སྙད་།་",
    "གཅིག་གི་ཚིག་བསྟན་པ་འདིས་ནིའོ།",
    "སྔར་སོ་སོར་མཐོང་བ་དེ་ཉིད་སྦྱོར་བ་གང་གི་༤སྔོན་དུ་འགྲོ་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་བའོ།",
    "དོན་ནི་འགའ་ཞིག་གི་ཡང་ཞེས་བྱ་བ་ནི་བཞོན་པ་ལ་སོགས་པའི་ཡང་སྟེ།",
    "འོ་ན་ཇི་ལྟར་སྤྱི་མེད་པར་གསལ་བ་ཐམས་ཅད་སྒྲ་གཅིག་གིས་བརྗོད་ཅེ་ན།",
    "ཉན་པས་ཉན་པ་གང་ཡིན་པ་དེ་དག་གི་ཡུལ་གྱི་བརྡའོ།",
    "དོན་དམ་པར་ནི་གང་ལ་སོགས་པ་དེ་དག་གི་ནང་གི་དབྱེ་བ་ལ་ལྟོས་ཏེ་མཐའ་ཡས་པའི་ཕྱིར་རོ།",
    "རྭ་ནི་བརྟེན་པ་ཉིད་དུ་རྟོག་གི།",
    "འཕྲོད་པ་འདུ་བའི་སྟོབས་ཀྱིས་རིགས་ལ་སོགས་པ་ཐ་དད་པར་མི་སྣང་དུ་ཆུག་མོད།",
    "༤༢ ༧བདུན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "རེ་ཞིག་རྫས་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "རིགས་མི་མཐུན་པའི་ཡན་ལག་གི་རྫས་མི་རྩོམ་པའི་ཕྱིར་ལྡན་པ་ཉིད་དུ་འགྱུར་རོ་ཞེ་ན།",
    "དེ་དག་གི་འབྲས་བུ་གང་ཡིན་པ་འདི་ལའོ་སྙམ་པའི་བློ་དང་ཕན་ཚུན་ལྡོག་པའི་བློ་དེ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཉེ་བར་བཏགས་པ་ཉིད་དུ་མ་གཏོགས་མོད།",
    "རེ་ཞིག་གཙོ་བོ་ནི་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་ཞེས་བྱ་བ་གཅིག་ཏུ་འཛིན་པ་བསྐྱེད་པར་ནུས་པའི་མངོན་སུམ་མོ།",
    "ཐལ་བ་སྤོང་བ་བརྗོད་པ་ཅི་སྟེ་ཞེས་བྱ་བའོ།",
    "རེ་ཞིག་ཕྱི་རོལ་བདེ་བ་དང་སྡུག།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་རྟོགས་པའི་ནུས་པ་མེད་པ་ནང་གི་བྱེད་པ་ལ་རག་ལས་པ་དེ་བཞིན་དུའོ།",
    "གང་ལ་འབྲས་བུ་ཐ་མི་དད་པར་ཞེན་པ་ཡོད་པ་བ་ལང་ལ་སོགས་པ་དེ་དག་གི་དངོས་པོ་ཉིད་དེ་དེས་སོ།",
    "ཅི་སྟེ་ཡང་རང་གི་ངོ་བོ་ལས་ཐ་དད་པར་དེའི་འབྲས་བུ་ཅན་གྱི་སྤྱི་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདིས་ནི་རེ་ཞིག་བློའི་རྣམ་པ་གདོན་མི་ཟ་བར་ཁས་བླང་བར་༤བྱ་བ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ།",
    "སྤྱི་མི་སྣང་མོད་དེ་དེ་ལྟ་ན་ཡང་དེ་ཡུལ་དུ་ཇི་ལྟར་མི་འགྱུར་ཞེ་ན།",
    "དེའི་འབྲས་བུ་མེད་པ་ལས་ལྡོག་པ་ཡོངས་སུ་གཅོད་མོད།",
    "གལ་ཏེ་ཕྱི་རོལ་གྱི་མཐར་ཐུག་པ་ཡིན་ན་དེའི་ཚེ་ཕྱི་རོལ་ལ་རེག་པར་ཅི་སྟེ་མི་འགྱུར་སྙམ་ན།",
    "འགལ་བ་ཅི་ཡོད་ཅེས་བྱ་བ་ནི་ཁ་དོག་དང་དབྱིབས་སུ་སྣང་བ་དང་ལྡན་པ་རྣམ་པར་རྟོག་པ་ལ་སྣང་བ་ྲགལ་ཏེ་དངོས་པོ་ཡིན་མོད།",
    "འདི་ལ་བརྗོད་པ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བའོ་། རྣམ་པར་རྟོག་པའི་གཟུགས་བརྙན་ཕྱི་རོལ་གྱི་དངོས་པོ་མ་ཡིན་མོད།",
    "བློའི་མཚན་ཉིད་ནི་དངོས་པོ་ཡིན་པས་དེ་ཉིད་སྒྲ་དག་གི་བརྗོད་པར་བྱ་བར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་དེ་ལྟ་ཡིན་མོད་ཅེས་བྱ་བའོ།",
    "མི་འགྱུར་མོད་ཀྱི་ཅི་སྐྱོན་སྙམ་ན་གཞན་སེལ་བ་ནི་ཞེས་བྱ་བའོ།",
    "གཞན་སེལ་བའི་དངོས་པོ་ཆའི་རང་བཞིན་དུ་ཡང་ཁྱོད་ཀྱིས་བརྗོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་གནོད་བྱེད་ཡོད་པ་དང་མེད་པ་དག་གིས་མ་རྟོགས་པ་དང་།",
    "ཤེས་པ་གཞན་ཡིན་མོད་ཅི་སྐྱོན་སྙམ་ན།་",
    "གང་གི་ཚེ་སྨིག་རྒྱུ་༤ལ་ཆུར་སྒྲོ་བཏགས་པ་དེ་ཉིད་ཀྱི་ཚེ་སྒྲོ་འདོགས་པར་བྱེད་པའི་ཤེས་པ་དེ་ཉིད་ཀྱིས་གཞན་ན་གནས་པའི་ཆུ་འཛིན་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དེ་དག་གི་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "དོན་དེ་ལྟར་འགྱུར་མོད་ཅི་སྐྱོན་སྙམ་ན།",
    "དེའི་ཤེས་པའི་རང་བཞིན་ཡིན་པས་ན་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་དགོངས་པའོ།",
    "རང་གི་རྣམ་པར་རྟོག་པ་ཡིན་ཡང་།",
    "ཐོབ་པར་བྱ་བ་མ་ཡིན་པ་རང་གི་རྣམ་པའི་ཐ་སྙད་མི་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་མཚན་ཉིད་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་གཞན་ན་མེད་པའི་ཕྱིར་རོ་ཞེས་དགོངས་པའོ་ཾ།",
    "དེ་ལྟར་རེ་ཞིག་གང་ཞིག་དངོས་པོ་ཁོ་ནར་བརྡ་འཛིན་པ་བརྗོད་པ་ཡིན་ནོ།",
    "འགའ་ཞིག་གིས་འདི་འོན་ཅིག་ཅེས་བརྗོད་པ་ལས་སོ།",
    "ནང་གི་ཁྱད་པར་ཞེས་བྱ་བ་ནི་ཐུང་ངུ་དང་རིང་པོ་ལ་སོགས་པའི་རང་བཞིན་གྱི་ཁྱད་པར་རྟོག་པ་ནི་མི་སྲིད་པའོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་རྟོགས་པ་གང་ཞིག་གཞན་གྱི་བརྡ་འཛིན་དུ་བཅུག་པ་དེ་ལ་ལྟོས་ནས་རྣམ་འགྲེལ་སྦྱར་བ་ཡིན་ནོ།",
    "འདི་ཉིད་སྟོན་པ་ནི་རེ་ཞིག་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་འདི་ལ་མེ་ཡོད་དོ་ཞེས་ངེས་པར་རྟོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལ་ནི་རེག་པའི་ཁྱད་པར་ལའོ།",
    "སོ་སོར་འགྱུར་བ་དང་འདི་གཉིས་ཀྱི་ནང་ནས་གཅིག་གིས་བདག་ནི་འབྲས་བུ་བྱེད་མཁན་ཡིན་ནོ་ཞེས་དེ་ལྟར་རྟོགས་པ་གསུམ་སྲིད་པ་ན་ལྡན་མེད་རྟོགས་པར་འདོད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟར་ལྡན་པ་མི་སྣང་བའི་ཕྱིར་རྫས་འབྲེལ་པའི་རྟོགས་པ་མ་ཡིན་མོད།",
    "རེ་ཞིག་བརྡ་འཆད་པ་ནི་འདི་ལ་བ་ལང་ངོ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་འདི་བ་ལང་གི་སྒྲ་མ་ཡིན་ན།",
    "འོ་ན་ཇི་ལྟར་ན་འདི་འདི་ཞེས་བྱ་བ་དང་བ་ལང་གི་སྒྲ་དང་།",
    "དེ་དང་འབྲེལ་བ་ནི་བ་ལང་གི་སྒྲ་དང་འབྲེལ་བའོ།",
    "གལ་ཏེ་འདི་ལ་བ་ལང་གི་སྒྲའོ་ཞེས་རྣམ་པ་དེ་ལྟར་ན་བརྡ་མི་བྱེད་ཀྱི།",
    "དེ་ལ་ཚིག་གི་ཞེས་གསུངས་ཏེ།",
    "བ་ལང་གི་སྒྲ་ཞེས་བྱ་བ་འདིའོ།",
    "ཚིག་གི་ཕྱོགས་གཅིག་གི་རྣམ་པ་བརྗོད་པ་ནི་བ་ལང་རོ་ཞེས་བྱ་བའོ།",
    "དེ་ནི་མངོན་སུམ་མོ་། དེ་ནི་ཞེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་ཤེས་པའོ།",
    "ད་ལྟར་བྱུང་བ་ནི་གསལ་བའི་རང་བཞིན་དང་གཅིག་ཏུ་འགྱུར་མོད།",
    "གལ་ཏེ་སྔོན་ེམཐོང་བ་འདི་དང་གཅིག་པར་མངོན་སུམ་གྱིས་ཁོང་དུ་ཆུད་པར་མི་འགྱུར་མོད།",
    "གལ་ཏེ་དྲན་པ་མེད་པར་མཐོང་བ་འབྱུང་མོད།",
    "ཧ་ཅང་ཐལ་བར་ཡང་ཞེས་བྱས་པ་ནི་སྔོན་པོ་དང་སེར་པོ་དག་ཀྱང་གཅིག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "བྱ་བ་ནི་བ་ལང་གི་རྣམ་པར་རྟོག་པ་བདེ་བའི་འབྲས་བུ་ཡིན་པས་ཇི་ལྟར་མི་འཛིན་ཏེ།",
    "བ་ལང་གི་རྣམ་པར་རྟོག་པ་དེ་ཡང་ཡོད་པ་ཁོ་ནའོ་ཞེས་བྱ་བར་བསམས་པའོ།",
    "སྒྲ་སྦྱོར་བར་བྱེད་པ་ཞེས་བྱ་བ་ནི་བ་ལང་གི་རྣམ་པར་རྟོག་པའོ།",
    "དཔེར་ན་བ་ལང་གི་རྣམ་པར་རྟོག་པའི་དེ་མ་ཐབཞིན་ནོ།",
    "ོརང་གི་རིག་པའི་རྣམ་པར་ཤེས་པ་ལས་རྟོགས་ན་ཞེས་དེ་ལྟར་གྲུབ་པའི་མཐའ་སྨྲ་བས་བརྗོད་པ་ལ་གཞན་གྱིས་དེ་ཡང་འཐད་པར་དཀའ་ཞེས་སྨྲས་སོ།",
    "ཐེ་ཚོམ་གྱི་རྣམ་པ་བརྗོད་པ་ནི་རེས་འགའ་མེ་མེད་ཀྱང་ཞེས་བྱ་བའོ།",
    "དུ་བའི་རང་བཞིན་ལས་མེ་རྟོགས་པ་གང་ཡིན་པ་དེའི་དུས་ཕྱིས་ཀྱི་རེག་པའི་རྣམ་པར་ཤེས་པའམ་གྲང་བ་བཟློག་པའི་ཐ་སྙད་གང་ཡིན་པ་དེས་སོ།",
    "རེག་པའི་རྣམ་པར་ཤེས་པའི་མཚན་ཉིད་དམ།",
    "གནོད་པར་བྱེད་པ་གཞན་ཡང་བརྗོད་པ་ནི་རེག་པས་ནི་ཞེས་བྱ་བ་སྟེ།",
    "དྲོ་བའི་རེག་པས་སོ།",
    "རེག་པའི་ཤེས་པ་ནི་གཟུགས་ཙམ་གྱི་སྒྲུབ་བྱེད་ཡིན་གྱི།",
    "ཾ་། གལ་ཏེ་རེག་པའི་རྣམ་པར་ཤེས་པ་འཁྲུལ་ན་འོ་ན་གཞན་གྱིས་མེ་འདེ་བའི་ཐ་སྙད་ལས་རྟོགས་སོ་སྙམ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་གཞན་གྱིས་ཅིའི་ཕྱིར་མ་དམིགས་དེས་ན་རྣམ་པར་རྟོག་པ་ཡོད་ཀྱང་རེས་འགའ་དམིགས་པར་མི་འགྱུར་ཞེ་ན།",
    "གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁོ་བོ་ཅག་གི་བརྗོད་པ་གང་ཡིན་པ་དེ་ནི་གཞན་དུ་མ་ཡིན་ཏེ་མི་བརྫུན་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོ་ན་མ་གོམས་པའི་གནས་སྐབས་ན་རྗེས་སུ་དཔག་པས་རང་གི་རྒྱུད་ཀྱི་ཐ་སྙད་རྟོགས་པར་འགྱུར་རོ་ཞེ་ན་། མཐོང་བ་དེ་ཉིད་ལ་བརྟེན་ཏེ་དམིགས་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེའི་ཞེས་བྱ་བ་ནི་བ་ལང་གི་མཚན་ཉིད་ཀྱིའོ།",
    "རྟོགས་པ་འདི་ཉིད་ཀྱི་དོན་བརྗོད་པ་ནི་བ་ལང་གི་སྒྲ་ནི་ཞེས་བྱ་བའོ།",
    "བདག་གིས་ཞེས་བྱ་བའོ།",
    "འདི་ནི་དེའོ་ཞེས་བྱ་བ་ནི་ཤེས་པ་འདི་ལ་འདིའོ་ཞེས་བྱ་བར་སྣང་བ་ཡང་མདུན་ན་གནས་པ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་རང་བཞིན་གང་ཡིན་པ་ལྷག་པར་ཞེན་པ་ཡིན་ཏེ།",
    "ཐུན་མོང་བའི་དངོས་པོ་མེད་པས་ན་དངོས་པོ་ལ་རེག་པ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་གང་གི་ཚེ་མདུན་ན་གནས་པའི་དངོས་པོ་གཅིག་ལ་ལྷག་པར་ཞེན་པར་བྱེད་པ་དེའི་ཚེ་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ཐུན་མོང་བ་ཉིད་དང་བྲལ་ན་ནི་ཞེས་གསུངས་སོ།",
    "རང་གི་ངོ་བོ་ལ་རེག་ན་ནི་ཞེས་གསུངས་སོ།",
    "འོན་ཏེ་སྒྲ་ཡང་རང་གི་མཚན་ཉིད་ཁོ་ན་ལ་འཇུག་པ་ཡིན་ལ།",
    "དེ་ལྟར་ན་རེ་ཞིག་འཇུག་པའི་ཡུལ་དེ་ལ་རྣམ་པར་རྟོག་པ་མེད་ཀྱང་ཐ་སྙད་ཡོད་པར་བསྟན་ནས།",
    "རྗེས་སུ་དཔག་པ་མེད་པར་ཐལ་བ་ཞེས་བྱ་བས་ནི།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་ནི་གཟུགས་མཐོང་༤དུས་ནའོ་། བདག་གི་གཟུགས་མཐོང་བའི་ཞེས་བྱ་བའི་རྣམ་པ་ཅན་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་མངོན་སུམ་དེའོ།",
    "བརྟག་པར་བྱ་བ་བདག་ཉིད་ཅེས་བྱ་བ་ནི་བདག་གིས་གཟུགས་མཐོང་བ་ཞེས་བྱ་བའི་རྣམ་པར་བརྟག་པར་བྱ་བ་བདག་ཉིད་རྟོག་པ་ནི།",
    "རང་གི་ངོ་བོའི་རྣམ་པར་རྟོག་པའོ།",
    "གཟུགས་ལ་སོགས་པ་ཉམས་སུ་མྱོང་བའི་བདག་ཉིད་ཅན་དང་རང་གི་ངོ་བོ་མྱོང་བའི་བདག་ཉིད་ཅན་ནོ། ། དེའི་ཚེ་རིམ་པ་ཡང་རིམ་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ནི་བློ་ལྟ་ཡིན་པའི་ཕྱིར།",
    "གང་གིས་རིམ་མ་ཡིན་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "ཾ་ཡྰ་རྣམ་པར་རྟོག་པ་གཉིས་སུ་འགྱུར་མོད་སྙམ་ན་ཉམས་སུ་མྱོང་བའི་གནོད་པ་བཞག་ནས་སུན་འབྱིན་པ་གཞན་ཉིད་བརྗོད་པ་ནི་དེས་ན་དེ་ལ་ཡང་ཞེས་བྱ་བ་ནི་འདི་ནི་གཟུགས་ཀྱི་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དེ་ལྟ་བུའི་རྣམ་པ་ཅན་ལའོ་། གཞན་ལ་དུ་ཞེས་བྱ་བ་ནི་འདི་ནི་གཟུགས་ཀྱི་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཅན་དུའོ།",
    "འདི་ནི་གྲངས་ཅན་གྱི་ལུགས་ཡིན་ཏེ་དེ་དག་གི་ནི་རིག་པ་རྟག་པ་ཉིད་དུ་ཁས་བླང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གཟུགས་ཉམས་སུ་མྱོང་བར་བགྱི་བས་མ་བཟུང་མོད།",
    "གང་གིས་གཟུགས་འཛིན་པའི་རང་བཞིན་མ་བཟུང་༤བར་བློ་གཟུང་བར་འགྱུར་བ་གཟུགས་འཛིན་པ་ལས་གཟུགས་ཀྱི་བློ་གཞན་ཡང་ཡོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཟུགས་འཛིན་པའི་རང་བཞིན་མ་བཟུང་༩མོད་ཅི་སྐྱོན་སྙམ་ན་དེས་ན་ཞེས་སྨོས་སོ།",
    "མངོན་སུམ་གྱིས་སྔོན་པོའི་རང་བཞིན་དུ་གཟུང་༧བ་ཡང་སྔོན་པོ་མ་ཡིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "རྗེས་སུ་དཔག་པའི་རང་བཞིན་ཡིན་ཡང་རུང་སྟེ་མེད་པ་ཁོ་ནར་ཐལ་ལོ།",
    "མྱོང་བ་འདིའི་རང་གི་ངོ་བོས་རྟོགས་པ་མེད་མོད།",
    "འདི་ནི་རང་གི་བློ་ཡིན་ནོ་ཞེས་རྟོག་པར་མི་འགྱུར་རོ།",
    "གཞན་གྱི་རྟོག་པ་གང་ཡིན་པ་དང་བདག་གི་༤བློ་གང་ཡིན་པ་ཉིད་གང་ཡང་འདས་པ་དྲན་པ་རང་བཞིན་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "རང་གི་བློ་ཡང་ཡོངས་སུ་གཅོད་པར་འདོད་པ་ཉིད་དོ།",
    "དེས་ན་ཇི་ལྟར་དེ་ལ་འདི་ཧ་ཅང་ཐལ་བར་འགྱུར།",
    "རང་གི་བློ་ཡོངས་སུ་མཚུངས་པ་ཉིད་ཡིན་ན། དེ་ལ་གཞན་གྱིས་སྨྲས་པ་ནི་དེ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ་། གཞན་གྱི་བློ་ཡོངས་སུ་གཅོད་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་གཞན་གྱི་བློ་ཡོངས་སུ་གཅོད་པ་དང་།",
    "རང་གི་བློ་ཡོངས་སུ་གཅོད་པ་ནི་མཚུངས་པ་ཉིད་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་ཡོངས་སུ་གཅོད་ཅེས་པ་ནི་རང་གི་བློའོ།",
    "ཡང་ཇི་ལྟར་ན་རྗེས་སུ་དཔག་པ་ཉིད་དུ་ཁྱད་པར་མེད་ན་གཞན་གྱི་བློ་བཞིན་དུ་རང་གི་བློ་ཡང་གཞན་འབྲེལ་པ་ཉིད་མི་རྟོག་སྙམ་པ་གཞན་དུ་ཞེས་བྱ་བའོ།",
    "༢ དྷཟླ་༦ཊ་༤༥༨གཞན་ནི་ཞེས་བྱ་བ་ནི་རང་གི་བློའི་རང་བཞིན་ནོ།",
    "ོརང་གི་བློའི་རང་བཞིན་ངེས་པ་འདི་སྲིད་པར་འགྱུར་རོ།",
    "རང་གི་ཕྱོགས་ལ་སྐྱོན་སྤོངས་པ་ནི་རང་རིག་པ་ཉིད་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་ཞེས་པ་རང་གི་ལུས་དང་འབྲེལ་པ་ཉིད་དུ་རྗེས་སུ་དཔག་ན་ནི་གཞན་ཡིན་ནོ་ཞེས་བྱ་བ་རང་གི་བློའོ་། འདི་ལ་ལན་ནི་བདག་གི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རྩོད་པ་འདི་ལ་རེ་ཞིག་རང་ཉིད་ཀྱི་སྐྱོན་བརྗོད་པ་ནི།",
    "གཅིག་སྣང་བ་ན་གཉིས་པ་སྣང་བ་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཡིན་དང་གང་གི་ཚེ་བློ་སྔ་མ་གཅིག་སྣང་བ་དེའི་རྗེས་ཐོགས་ལ་བློ་གཞན་སྣང་བ་དེའི་ཚེ་བློ་སྔ་མ་མི་སྣང་བའི་ཕྱིར་དེ་ལ་ལྟོས་ནས་བློའི་བློ་དྲན་པར་འགྱུར་རོ་ཞེས་སྔར་བརྗོད་ཟིན་ཏོ།",
    "ཀྱང་གི་སྒྲ་ནི་དེ་ལྟར་ན་ཡང་ཞེས་བྱ་བའི་དོན་ལ་ཡིན་ཏེ་དེ་ལྟ་ན་ཡང་འགལ་བ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་པ་གང་གིས་བརྡར་བྱ་མི་ནུས་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་གཟུང་བར་བྱ་བ་རང་གི་ངོ་བོ་འཛིན་པ་གང་ལ་ཡོད་པ་ཞེས་དེ་ལ་ཡང་འབྲུ་མང་པོས་བསྡུ་བའོ།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོའི་གསུམ་པའོ།",
    "རང་གི་ངོ་བོས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རང་གི་ངོ་བོས་སྣང་བ་མ་ཡིན་པ་ཞེས་གསུངས་སོ།",
    "མི་སྣང་བ་ལ་ནི་རང་གི་ངོ་བོ་རྟོགས་པ་ཉིད་མེད་པར་དེ་སྦྱོར་བར་ཅི་ལྟར་འགྱུར།",
    "རྟོགས་པ་མེད་པར་མེད་པ་ནི་ཁྱད་པར་གང་གིས་རྟོགས་པར་འགྱུར་ཞེས་བྱ་བ་འདི་ལ་གཞན་གྱི་ལན་གྱི་དོགས་པ་བསུ་བ་ནི་ཅི་སྟེ་ཞེས་བྱ་བའོ།",
    "དཔེར་ན་ཨུཏྤ་ལ་སྔོན་པོའི་རང་བཞིན་གང་གི་༤ རང་གི་ཤེས་པ་ལ་སྣང་བ་དེ་ཉིད་དེའི་དེ་ཁོ་ན་ཡིན་ཏེ།",
    "རྟོག་པ་མེད་པ་དག་གི་རྒྱུ་གཅིག་ཁོ་ན་ཡིན་ཏེ།",
    "ཕྱོགས་ལ་ཡང་རེ་ཞིག་སྒྲ་དང་འདྲེས་པ་ནི་མེད་དོ་ཞེས་བརྗོད་པ་ནི།",
    "ག་གལ་ཏེ་སྣམ་བུ་ལ་སོགས་པ་ལ་མེད་པའི་ཕྱིར་སྒྲ་ལ་སོགས་པ་མངོན་སུམ་ལ་མི་སྣང་མོད་མཚུངས་པའི་རྣམ་པ་ཉིད་ནི་འགྱུར་རོ་སྙམ་པ་ནི་མཚུངས་པའི་རྣམ་པ་ཉིད་དུ་ན་ཞེས་བྱ་བའོ།",
    "ལྷན་ཅིག་བྱེད་པ་གཞན་དག་ཀྱང་བསྟན་པའི་ཕྱིར་བརྗོད་པ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བའོ།",
    "རེ་ཞིག་སྔར་ཉམས་སུ་མྱོང་བ་ཡོད་པ་ཡིན་ནོ་ཞེས་བསྒྲུབས་ནས་དྲན་པ་ཡང་ཡོད་དོ་ཞེས་སྟོན་པ་ནི་སོ་སོར་པའི་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་མངོན་སུམ་གྱིས་མེ་མ་བཟུང་བ་དེ་ལྟ་ན་ཡང་དེ་སྦྱོར་བ་ནི་མངོན་སུམ་དུ་འགྱུར་རོ་ཞེ་ནགང་གི་ཕྱིར་མ་བཟུང་༤བ་ནི་སྦྱོར་བ་མ་ཡིན་ནོ།",
    "དེ་དང་ལྡན་པས་ནི་ཕྱོགས་དང་ལྡན་པར་རྟོགས་སོ་ཞེས་བྱ་བ་ནི་རང་གི་ཚིག་དང་འགལ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་གྲུབ་པའི་མཐའ་བས་མངོན་སུམ་གྱིས་ནི་སྦྱོར་བ་མི་སྲིད་དོ་ཞེས་བསྟན་པ་ན།",
    "གལ་ཏེ་དོན་དང་འབྲེལ་པ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པར་མི་བྱེད་མོད།",
    "མདུན་ན་གནས་པའི་གཟུགས་ཙམ་ེལ་མི་འཇུག་པར་རྟོགས་ཏེ་ཤེས་པ་ཡིན་ནོ། ༉། མདུན་ན་གནས་པ་ཙམ་ལ་མི་འཇུག་པ་མཐོང་གི་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་མོད་དེ་ལྟ་ན།",
    "མངོན་སུམ་དུ་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཟུགས་ཉིད་སྒྲའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ་ཞེས་དོགས་པ་བསུ་ནས་གང་གིས་དེ་སྣང་བ་ན་དེ་དག་ཀྱང་སྣང་བར་འགྱུར་བ་དོན་ལ་སྒྲའི་ཡོད་པའམ་དེའི་བདག་ཉིད་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་ཏེ།",
    "གང་གིས་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་འཇིག་རྟེན་ན་དེ་ལྟར་རྟོགས་མོད།",
    "ཡུལ་བརྟེན་པ་ཟླ་བ་གཅིག་གིས་ཤེས་པ་ཡང་མངོན་སུམ་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "མངོན་སུམ་ཁོ་ནར་བརྗོད་ལ་རག་མོད།",
    "ཕྲ་མོ་མ་ཡིན་པ་རགས་པ་ནི་དེ་མཐོང་བ་དག་ལ་དེ་སྐད་ཅེས་བྱའོ་༤།",
    "ཐམས་ཅད་ཀྱིས་བསྐྱེད་མོད།",
    "རང་གི་རྒྱུ་ལ་སོགས་པ་གང་ཡིན་པ་རང་གི་རྣམ་པ་གཏོད་པའི་ནུས་པ་༧མེད་པ་དེའི་ཕྱིར་ཏེ།",
    "༢ རྨ་ཆ། ༤༧༦གི་མཚན་ཉིད་དོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་སྐྱེ་མཆེད་ཀྱི་རང་གི་མཚན་ཉིད་ཅེས་བྱ་ལ་སོགས་པའོ།",
    "གཅིག་གི་ཚེ་ཁོ་ནར་ཞེས་བྱ་བ་གཅིག་ཉིད་ཀྱིས་དུ་མ་མཐོང་ངོ་སྙམ་ན།",
    "དེ་ལྟར་ན་རེ་ཞིག་གཅིག་གི་ཚེ་རྡུལ་ཕྲ་རབ་དུ་མ་འཛིན་པ་མེད་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་ཉིད་དུ་བསྒྲུབས་ནས་རྣམ་པར་མི་རྟོག་པ་ཉིད་གྲུབ་པའི་དོན་དུ་རྡུལ་ཕྲ་རབ་རྣམས་ལ་ཡན་ལག་ཅན་གྱི་རྫས་གཅིག་ཉིད་ཁོ་ནར་ངེས་དགོས་སོ་ཞེས་༦སྟོན་པ་ནི་ཡང་ན་༧ནི་ཞེས་བྱ་བའོ།",
    "འདི་ལ་བརྗོད་པ་ནི་དངོས་པོ་དུ་མ་ཤེས་པ་གཅིག་གིས་མི་འཛིན་པ་ག་ལས་ཡིན་ཞིང་།",
    "༧ཏེ་གཅིག་གིས་ཀྱང་ཤེས་པ་དུ་མ་བསྐྱེད་པ་ལ་འགལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "གཅིག་ལ་ཟླ་བ་གཉིས་ཀྱི་ཤེས་པ་འཁྲུལ་པའི་ཕྱིར་ཐམས་ཅད་འཁྲུལ་པ་ཁོ་ནར་ཐལ་ལོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ནི་ཧ་ཅང་ཐལ་བའོ།",
    "ཐམས་ཅད་རྣམ་པར་རྟོག་པ་དང་བཅས་པ་ཡིན་མོད།",
    "རྣམ་པར་དབྱེ་བ་མེད་པར་ཁྱད་པར་མེད་པའི་རེག་པ་སོགས་པ་གང་ཡིན་པ་དེ་དང་ལྷན་ཅིག་རྒྱུ་བ་ནིའོ།",
    "ཆ་༤༨ བཅོས་མའི་དངོས་པོ་རྣམས་ལ་ཡོད་པའི་ཡོན་ཏན་སྔོན་པོ་ལ་སོགས་པ་གང་ཡིན་པ་དེ་གང་གི་དམིགས་པ་ནི་རིམ་གྱིས་ཁོ་ནར་འགྱུར་བ་ཡིན་ལ།",
    "༤༨ ༡མཚུངས་པ་ཙམ་མོ།",
    "རྒྱུའི་རྐྱེན་སྐྱོ་བ་བརྒྱ་ཕྲག་གིས་ཀྱང་བློ་རྣམ་པ་གཞན་དུ་ཇི་ལྟར་འཐད་དེ།",
    "མི་འཐད་པ་ཁོ་ནའོ་། རིམ་པ་དང་ལྡན་པའི་སྣང་བའི་རང་གི་ངོ་བོ་བཅོས་མའི་ཕྱེ་མ་ལེབ་ཁྲ་བོ་ལ་སོགས་པ་དག་ལ་ནི།",
    "གལ་ཏེ་རེ་ཞིག་མི་སྣང་བ་འཁྲུལ་པ་ཡིན་ན།",
    "གལ་ཏེ་ཚུལ་གཞན་གང་ཡིན་མེད་སྣང་ཉིད་བརྗོད་པར་འདོད་པའི་ཚུལ་ལ་འཁྲུལ་པར་བརྗོད་ན་དེའི་ཚེ་བརྗོད་པར་འདོད་པ་དེའི་རང་གི་ངོ་བོར་སྣང་བར་ཇི་ལྟར་འགྱུར།",
    "རང་གི་ངོ་བོ་མི་སྣང་ན་ཡང་སྣང་བ་དེ་མེད་པས་ཇི་ལྟར་འཁྲུལ། འཆད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དངོས་པོའི་རང་གི་ངོ་བོའི་བློ་གང་ཡིན་པ་དེ་ལ།",
    "བློ་གཞན་ཉིད་རིམ་མ་ཡིན་པར་སྣང་མོད་དངོས་པོའི་ཡུལ་ཅན་རིམ་པ་དང་ལྡན་པའི་བློ་གོ་ཇི་ལྟར་རིམ་མ་ཡིན་པར་སྣང་བར་འགྱུར།",
    "འཁྲུལ་མེད་ཡིན་པར་ཐལ་ཏེ་ང་རང་གི་ངོ་བོར་འཛིན་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་བློའི་བློས་རིམ་མིན་པར་འཛིན་པ་དེ་བཞིན་དུ་དངོས་པོའི་བློ་དེའི་གཞལ་བྱ་འཛིན་པ་དེ་དེ་ལྟར་དེ་རིམ་མ་ཡིན་པའི་རང་བཞིན་དུ་ཡིན་པ་གང་གིས་བཟློག།",
    "གཅིག་གིས་ནི་བློའི་བློས་སོ།",
    "དངོས་པོའི་ཡུལ་ཅན་གྱི་བློའི་རང་བཞིན་དུ་མི་འཛིན་པར་ཐལ་ལོ།",
    "འོན་ཏེ་དངོས་པོའི་ཡུལ་ཅན་གྱི་བློ་ཾནི་རང་བཞིན་དུ་མི་འཛིན་པར་ཐལ་ལོ།",
    "དུ་མ་འཛིན་པར་ཇི་ལྟར་ཐལ་སྙམ་ན།",
    "རང་གི་ངོ་བོས་གཅིག་ཉིད་མ་ཡིན་མོད།",
    "དེས་ན་གཅིག་ཉིད་གང་གིས་རྟོགས་པ་ཞེས་༤དགོངས་པའོ།",
    "གཞན་རང་གི་ཕྱོགས་ལ་སྒྲིབ་པ་འཐད་པར་སྟོན་པ་ནི།",
    "རང་གི་ཕྱོགས་ལ་ཉེས་པ་མེད་པར་བརྗོད་པ་ནི།",
    "ལྕགས་དང་ཁབ་ལོང་རེག་པ་ཡོད་པའོ།",
    "མིག་གི་འོད་ཟེར་མེད་པ་ཉིད་དོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་མིག་གི་འོད་ཟེར་གྱིས་རེག་པ་ཉིད་དོ།",
    "ཤིན་ཏུ་ཡང་ཞེས་བྱ་བ་ནི་། ཤིན་ཏུ་ཡང་ཆད་པ་གཞན་དག་གིས་ཞེས་བྱ་བ་དང་།",
    "སྔགས་ཀྱི་བདེན་པ་ལ་འགྱུར་མོད་ཉེས་པ་ཅི་ཡོད་སྙམ་ན།",
    "དེས་འགུགས་པ་སྟེ་སྔགས་ཀྱི་འབྲས་བུ་ལ་སོགས་པ་འགུགས་པ་ལ་ཡང་སྔགས་དང་རེག་པར་ཐལ་བས་ན་འདྲེན་པ་ལ་ཐལ་ཆེས་པར་འགྱུར་རོ།",
    "སྔགས་དང་རེག་༧པར་གྱུར་པ་ཁོ་ནའོ་ཞེ་ན།",
    "རེག་པ་ནི་ཁྱེད་ཀྱི་ལྟར་ན་ལྡན་པའི་མཚན་ཉིད་ཀྱི་ཡོན་ཏན་གྱི་ངོ་བོ་ཡིན་ན།",
    "མར་མེའི་འོད་མ་ཆོད་པ་རེགཔར་བྱེད་པ་བཞིན་དུ་མིག་གི་འོད་ཁོ་ན་དུས་སུ་མ་ཁྱབ་ན།",
    "ལན་ནི་དེ་ལྟ་ཡིན་ན་བློ་ཕྱི་མ་གཅིག་གིས་བློ་སྔ་མའི་རང་བཞིན་དུ་མ་འཛིན་པར་འགྱུར་རོ།"
  ]
}