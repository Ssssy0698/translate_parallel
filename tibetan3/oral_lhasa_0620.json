    "འོན་ཀྱང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་འམ་གསུང་ངམ་ཐུགས་ལས་ཕྱིར་བྱུང་བའམ་ལྡོག་པར་མི་མངོན་ཞེས་པ་ལས་འགའ་ཞིག་རྟོག་པ་སྐྱེ་བ་གདུལ་བར་བྱ་བའི་འགྲོ་བ་རྣམ་པ་བཞི་སྟེ།",
    "དེ་བས་ན་གཞུང་ལས་གསུངས་པ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུའི་ལས་ཀུན་དང་།",
    "འདི་ཉིད་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཞེས་པའི་སྔགས་ཀྱི་ཚིག་རྣམ་པར་དག་པ་འདི་ཉིད་ཀྱིས་ཞེས་པར་དགོངས་པའོ།",
    "སྔགས་ཀྱི་ཚིག་རྣམ་པར་དག་པ་ཞེས་པ་ནི་ཕྱག་ན་པདྨོ་དང་།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ལུས་ཀྱི་ལས་ཐམས་ཅད་དང་།",
    "གསུངས་པ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལུས་ཀྱི་ལས་ཐམས་ཅད་དང་།",
    "དེ་ལས་ཐམས་ཅད་དུ་ཞེས་པ་ནི་འཇིག་རྟེན་གྱི་ཁམས་རྒྱས་པ་ཐམས་ཅད་པར་ཤེས་པར་བྱའོ།",
    "དེར་བྱིན་གྱིས་བརླབས་པ་ཉིད་ཡི་གེ་དང་ཚིག་བྱེད་པ་རྣམས་ཀྱང་སྔགས་ཀྱི་ཚིག་ཏུ་གསུངས་སོ།",
    "གང་གསུངས་པ།",
    "བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་ཞུགས་མ་ཐག་ཏུ་ཡང་བཅོམ་ལྡན་འདས་ཇི་ལྟ་བ་བཞིན་དུ་ལས་དང་ཚེའི་རྣམ་པར་སྨིན་པ་དང་།",
    "དེའི་བྱིན་གྱིས་བརླབས་ཀྱི་ཕྱིར་གསུངས་པ་དང་།",
    "དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་གསུངས་ཏེ།",
    "རྟོག་པ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་ཏེ།",
    "རྩ་བ་ནི་གང་མཐར་ཐུག་པ་ནི་གང་ལགས་ཞེས་པའི་བར་དུ།",
    "ཐབས་སྣ་ཚོགས་སུ་འཆད་པ་དེ་དག་ཇི་ལྟར་མཐོང་བ་བཅོམ་ལྡན་འདས་ལ་སླར་བཟླས་ནས་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེའི་རྒྱུ་དང་རྩ་པ་དང་མཐར་ཐུག་པ་དྲིས་པ་ལ་བྱ་སྟེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་རྒྱུ་དང་རྩ་བ་དང་མཐར་ཐུག་པ་དྲིས་པའི་ཚིག་སྦྱོར་སྨོས་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི་ཀུན་རྫོབ་དང་དོན་དམ་པ་རྣམ་པ་གཉིས་ཏེ།",
    "དོན་དམ་པར་ནི་སྟོང་པ་ཉིད་དུ་མཁྱེན་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པར་རོ་གཅིག་ཏུ་གྱུར་ཅིང་རྫོགས་པ་མཚན་ནི་འོག་ནས་འཆད།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཆ་ཤས་ཡོད་པས་ན་རྒྱུར་འགྱུར།",
    "དེ་རྣམས་སོ་སོར་རྣམ་པར་གྲོལ་བའི་ལས་ལ་བྱའོ།",
    "སོ་སོའི་སྤྱོད་ལམ་དུ་རྣམ་པར་འཇུག་པར་སྟོན་པ་ནས་ཐབས་ཀྱི་ཡང་ཐབས་སུ་བལྟའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེ་ནི་རོ་གཅིག་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་གྲོལ་བའི་རོ་ལགས་སོ་ཞེས་པ་ནི་དེ་ལྟར་ཚུལ་སྣ་ཚོགས་དང་།",
    "སྤྱིའི་དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་གྲོལ་བ།",
    "དཔེར་ན་བུ་རམ་ཤིང་རྣམ་པ་མང་པོའི་ཁུ་བ་ལས་བུ་རམ་དུ་བྱས་ན།",
    "དེ་ནི་འདི་ལྟ་སྟེ་དཔེར་ན་བཅོམ་ལྡན་འདས་ནམ་མཁའི་ཁམས་ནི་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བ་སྟེ་ཞེས་པ་ནས་དེ་ནས་ལྷ་དང་འཇིག་རྟེན་དུ་བཅས་པ་ལ་ཚིམ་པར་བྱེད་དོ་ཞེས་པའི་བར་དུ་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེའི་རང་། བཞིན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "མ་ལུས་པའི་བདེ་བ་ཐོབ་པའི་ཕ་རོལ་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་ཐོབ་པར་བསྟན་པའི་དཔེ་སྟེ།",
    "ནམ་མཁའ་ཇི་ལྟར་རྟོག་པ་དང་དཔྱོད་པའི་བག་ཆགས་ཀྱི་གནས་མེད་པ་དེ་བཞིན་དུ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེ་ལ་རྟོག་པ་མེད་དོ།",
    "རྣམ་པར་རྟོག་པ་དང་རྣམ་པར་དཔྱོད་པ་མེད་ཅེས་པའི་དོན་ཏོ།",
    "དེ་ལ་ཐེ་ཚོམ་དོགས་པ་དེ་ལྟར་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་རྣམ་པར་མི་རྟོག་སྟེ།",
    "དེ་བཞིན་དུ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེ་ཡང་རྟོག་པ་དང་རྣམ་པར་རྟོག་པ་མེད་བཞིན་སྔགས་ཀྱི་ལྷ་ལ་སོགས་པའི་སྒོར་སྟོན་ཏེ།",
    "ཇི་ལྟར་མེས་རྩི་ཤིང་ལ་སོགས་པ་ཐམས་ཅད་བསྲེགས་ཀྱང་སྲེག་པར་འགྱུར་བའི་མཐུ་མི་ཟད་དོ།",
    "ལྷ་དང་འཇིག་རྟེན་དུ་བཅས་པ་ལ་ཚིམ་པར་བྱེད་དོ་ཞེས་པ་དེ་དག་ནི།",
    "ཕྱག་ན་རྡོ་རྗེ་ཉིད་ཀྱིས་ཐམས་ཅད་མཁྱེན་པའི་ཚུལ་སྔོན་ཆད་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ་ལས།",
    "མཐར་རྫོགས་པར་བྱེད་པའི་རྒྱུ་གང་ལགས་ཞེས་དྲིས་པ།",
    "དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་གྲོལ་བའི་རོ་གཅིག་པར་ཆུད་པའི་ཤེས་རབ་ཀྱིས་སམ།",
    "དེ་སྟེ་ཆུད་པའི་ཤེས་རབ་ཀྱིས་ཤེས་ན་དེ་བཞིན་གཤེགས་པ་དང་ཁྱད་པར་མེད།",
    "བཅོམ་ལྡན་འདས་ལྟར་རྣམ་པ་ཐམས་ཅད་དུ་ཆུད་པ་ནི་མ་ཡིན་ཏེ་ཁྱད་པར་མེད་པར་མི་འགྱུར།",
    "ཐོས་པ་ཡང་ཆུད་པ་གཙོ་བོ་ཡིན་པར་གྱུར་གྱི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བྱིན་གྱི་རླབས་ཀྱིས་ཕ་རོལ་གྱི་སེམས་ཤེས་པ་བཞིན་དུ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་རྣམ་པ་ཐམས་ཅད་དུ་ཆུད་པར་འགྱུར་རོ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ལ་ཕྱག་ན་རྡོ་རྗེས་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེའི་རྒྱུ་དང་རྩ་བ་དང་མཐར་གྱུར་པ་དྲིས་པ་ལ།",
    "དགེའོ་དགེའོ་ཚིག་ལན་གསུམ་གསུངས་པ།",
    "ཤིན་ཏུ་ཞེས་པ་ནི་སྣོད་མི་གཙང་བས་གང་བ་ལས་བཟློག་པའོ།",
    "གཉིས་སུ་ན་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་བརྟན་པར་གནས་པའི་ཕྱིར་རྩ་བ་ཞེས་བྱ་སྟེ།",
    "ཐུགས་རྗེའི་གཟུངས་ཀྱིས་ལྷག་མ་མ་ལུས་པའི་མྱ་ངན་ལས་མི་འདའ་བར་དུས་ཐམས་ཅད་དུ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པར་གནས་ཤིང་།",
    "སྡོང་པོའི་རྩ་བ་ལྟར་བརྟན་པར་བྱེད་པ་བས་ན་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་རྩ་བའོ།",
