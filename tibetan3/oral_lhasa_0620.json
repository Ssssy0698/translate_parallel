    "བསྐུས་པས་སེལ་ཞིང་འཇིབ་པར་བྱེད།",
    "སྐྲངས་སྦོས་བྱུང་ན་དུགས་བྱས་ཕན།",
    "འདིར་ནི་སྔ་མ་གཉིས་དང་ཁྱད་པར་ལྕ་གཡུང་བསྔགས་སོ།",
    "ཞེས་གསུངས་སོ།",
    "དིང་ཁྲི་པར་མ།",
    "ཡོན་ཏན་བརྒྱད་ལྡན་དིང་ཁྲི་པར་མ་ནི།",
    "ཞེས་གསུངས།",
    "ཐ་མ་མེ་ཏོག་དམར་ནག་ཅན་ཐང་ཤོར་ཉེན་ཆེ་ལ་བཟི་ཡོད་པས་མི་གཏོང་པར་གསུངས།",
    "ཞེས་གསུངས་སོ།",
    "བཙོད་དང་དགོ་བའི་རྭ་ཡིས་ནི་འཁྲུ་བ་གཅོད་པར་བྱེད།",
    "འབྲུག་རུས་ནི་ས་འོག་ནས་ཐོན་པའི་རུས་པ་སྐྱ་སངས་ཚིགས་པ་ལྟར་ལྕེར་འབྱར་བ་ཆེ་ཆུང་སྣ་ཚོགས་ལ་རྭ་དང་མཆེ་བ་སྒལ་པ་རྐང་རུས་སོགས་ཀྱི་དབྱིབས་ཡོད་པ་དེས་རུལ་བ་གཅོད་ཅིང་རྨེན་པ་འདྲུབ་པར་བྱེད།",
    "སྤྲེའུ་ཡི་རུས་པས་བུ་ཕྱིར་མ་ཐོན་པ་འབྱིན་པར་བྱེད།",
    "བྱ་ཝང་ཤ་ཡིས་སྐྱུགས་པ་གཅོད་པར་བྱེད།",
    "སྤྱང་ཀིའི་ལྕེ་ཡིས་ལྕེ་སྐྲངས་པ་རྣམས་འཇོམས་པར་བྱེད།",
    "ཕག་པའི་ལྕེ་ཡིས་ནི་རུས་འཛེར་རྣམས་འགོགས་པར་བྱེད།",
    "ཁྱི་ཡི་ལྕེ་ཡིས་རྨ་རྣམས་འདྲུབ་པར་བྱེད།",
    "བོང་བུའི་ལྕེ་ཡིས་འཁྲུ་བ་གཅོད་པར་བྱེད།",
    "ཁྱི་ཡི་རླིག་པས་བུ་རོགས་ཏེ་ཤ་མ་འབྱིན་པར་བྱེད།",
    "བྱ་ཝང་ཤ་ཡིས་སྐྱུགས་པ་གཅོད་པར་བྱེད།",
    "རྩང་པ་རྒྱ་རྩང་བྲག་རྩང་ཀླུང་རྩང་རྣམས་ཀྱི་ཤ་ཡིས་ལུས་ཀྱི་སྟོབས་དང་ཁུ་བ་སྐྱེད་པར་བྱེད།",
    "མངལ་ཁྲག་རྩ་སྡོམ་ཤའུ་སྐྱེད་པར་བྱེད།",
    "སྦྲུལ་གྱི་ཚིལ་བུས་མདེའུ་འབྱིན་པར་བྱེད།",
    "རི་དྭགས་རྣམས་ཀྱི་ཀླད་པས་འཁྲུ་བ་གཅོད་པར་བྱེད།",
    "བྱི་བའི་པགས་པ་རློན་པ་རྣག་གར་ཡོད་ཀྱི་དམིགས་སུ་སླན་པའམ་སྦྱར་བས་རྣག་སྣ་འདྲེན་པར་བྱེད་དོ།",
    "སོ་བྱ་ཞེས་ཆུ་བྱ་སོ་ཏོ་རོག་པོའི་མཇུག་སྒྲོས་ཆུ་འགགས་འབིགས་པར་བྱེད།",
    "ར་ཐུག་སྟེ་ར་འོག་ཅན་གྱི་རྨོངས་སྤུས་ལྷོག་པ་འཇོམས་པར་བྱེད་དོ།",
    "ཁྱད་པར་ཕུག་རོན་བྲུན་གྱིས་སྐྲངས་པ་རྣམས་རྣག་ཏུ་འགུགས་པར་བྱེད་དོ།",
    "བྱིང་བྱིང་ཐུ་ལུ་ནི་འབུ་མཇུག་མར་ར་གཉིས་ཡོད་པ་རྒྱབ་གཉེར་མ་ཅན་དེ་གཉིས་ཀྱིས་གླང་ཐབས་ཀྱི་རིགས་རྣམས་འཇོམས་པར་བྱེད།",
    "སྤྲུ་མའི་འབུ་ནི་སྟོན་དུས་སྤྲུ་དཀར་གྱི་རྩ་བར་གནས་པའི་འབུ་སྔོ་ཁྲ་དེས་རྩ་ཡི་ཁྲག་ཤོར་བ་རྣམས་སྡོམ་པར་བྱེད།",
    "གཅེས་པར་གདམས་པ།",
    "དྲང་སྲོང་རྣམས་ཀྱིས་འདི་ལ་གཅེས་པར་བཟུང་།",
    "ཞེས་གསུངས་སོ།",
    "ག་དུར་བྱི་ཚེར་དེ་བ་པར་པ་ཏ།",
    "པར་པ་ཏ་དང་།",
    "རྣམ་པར་ཏེ་ཡུ་གུ་ཤིང་དང་།",
    "མུད་ག་མ་ཤ་པར་ནི་དང་།",
    "ཁྱད་པར་དུ་ནི་རྨ་ལ་ཕན།",
    "ཞུ་བའི་ཚད་པར་འཁྲུ་བ་སེལ།",
    "ཞེས་གསུངས་པའོ།",
    "གཉིས་པར་སྦྱར་བ་ལ་མངར་ལྔ་སྐྱུར་བ་བཞི།",
    "བཞི་པར་སྦྱར་བ་དང་གཉིསཔར་སྦྱར་བ་བཅོ་ལྔ་བཅོ་ལྔ་སྟེ་སུམ་ཅུའོ།",
    "རྒྱས་པར་ནི།",
    "རོ་ཆེན་པོ་དང་འབྲིང་དང་ཆུང་ངུ་རྣམ་པ་གསུམ་དུ་དབྱེ་ཞིང་བརྟག་པར་བྱའོ།",
    "ཉེས་གསུམ་འཕེལ་དང་རབ་འཕེལ་མཆོག་འཕེལ་ཟད་པར་སྦྱར།",
    "བད་མཁྲིས་མཉམ་པར་འཕེལ་བ་ལ།",
    "གཉིས་པར་སྦྱར་བ་བཅོ་ལྔས་བསྐྱེད་དེ།",
    "བད་མཁྲིས་མཉམ་པར་ཟད་པར་མངར་སྐྱུར་གྱིས་སྐྱེད།",
    "དེ་བཞིན་ཏུ་ཐམས་ཅད་ལ་རྟོགས་པར་བྱའོ།",
    "གཅིག་ཟད་གཉིས་འཕེལ་གོ་ལོག་བྱས་པ་དྲུག་ཅེས་པ་དེའི་གཉེན་པོ་ནི།",
    "མཉམ་པར་འཕེལ་བ་གསུམ།",
    "འདུ་བ་སྤྱི་སྙོམས་སུ་ཤེས་པར་བྱའོ།",
    "གཅིག་ལ་གཅིག་ཉེ་བར་ཞི་བ་ཅིའི་ཕྱིར་མི་བྱེད་ཅེས་བརྟག་པར་མི་བྱ་སྟེ།",
    "ཞེས་སོགས་ཀྱི་ཤུགས་བསྟན་ལས་ལེགས་པར་རྙེད་ནས་ཅུང་ཟད་བཀོད་པ་སྟེ།",
    "བློ་དང་ལྡན་པ་རྣམས་ཀྱིས་དཔྱད་ཅིང་གཞིགས་པར་བྱའོ།",
    "སྦྱང་བའི་ངོ་བོ་ནི་ཉེས་པ་གཞན་གནས་སུ་འཁྲུགས་པ་ཕྱིར་འདོན་ཞིང་མཚན་ཉིད་སྙོམས་པར་བྱེད་པའོ།",
    "གྱེན་དུ་འདྲེན་པ་སྐྱུག་འོག་ནས་བསུ་ཞིང་འདྲེན་པར་ནི་རུ་ཧ་ཡིན་ནོ།",
    "གང་ཞིག་ཚགས་སུ་མ་བྱས་ན།",
    "སྔ་ནས་གྲབས་སུ་མ་བྱས་ན།",
    "ཞེས་གསུངས་པ་འདི་དག་ཡིད་ལ་ཆོངས།",
    "ལི་ཤི་ཡིན་པ་ཤེས་པར་བྱ།",
