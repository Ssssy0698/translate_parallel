    "ག་ཟླ་ཤེལ་སྐཱཅན་ཟླ་བའི་སྲིང་མོ་བདག་མགྲིན་ལ་འཁྱུད་ངག་གི་མཆོག་སྦྱིན་མཛོད།",
    "དུར་སྨྲིག་གར་གྱིས་ཞིང་འདིར་ཟབ་མོའི་ལྟ་དང་ཉེར་འབྲེལ་སྔགས་ཀྱི་ལམ།",
    "རིམ་པར་བྱོན་རྣམས་བསྔགས་པའི་རོལ་མོ་ཅི་ཡང་འཁྲོལ།",
    "གང་གི་ཡོན་ཏན་ཕུང་པོ་མཐའ་དག་པ།",
    "ངོ་མཚར་གཏམ་གྱི་རིམ་པའི་གངྒཱ་མོ།",
    "བྱེ་བྲག་བརྗིད་ལྡན་བྱང་གི་ཕྱོགས།",
    "དེ་ལྟ་བུའི་ཁྱིམ་དུ་རགས་དང་རུས་དང་ཚོ་འབྲང་ཕུན་སུམ་ཚོགས་པའི་ཡབ་ཁྱིམ་བདག་ཚོང་དཔོན་པ་སངས་ཞེས་པ་དད་པ་དང་གཏོང་བའི་དཔལ་གྱིས་མཛེས་པ་དང་།",
    "ཡུམ་ཆུང་སྐྱིད་ཅེས་བྱ་བ་བུད་མེད་ཀྱི་རྟེན་ལ་གཡོ་སྒྱུ་ཆུང་བ་སོགས་ཡོན་ཏན་དུ་མ་དང་ལྡན་པ་གཉིས་ལ་༴",
    "དེ་ལྟར་རྒྱལ་སྲས་རྡོ་རྗེ་འཆང་འདི་ཉིད་ཀྱིས་སྙིགས་དུས་ཀྱི་གདུལ་བྱ་རྣམས་གདུལ་བའི་སླད་དུ་ཐུགས་རྗེ་ཆེན་པོས་ཉེ་བར་དགོངས་ཏེ་འོག་མིན་གྱི་ཞིང་ནས་གཟགས་པ་རྣམ་པར་དག་པས་ཉེ་བར་གཟིགས་ནས་ཡུམ་གྱི་ལྷུམས་སུ་ཞུགས་པ་དང་།",
    "མཆོག་གི་བདག་ཉིད་རྡོ་རྗེ་འཆང་ཞེས་གྲགས།",
    "འོག་མེན་ཞིང་ནས་གཟིགས་པ་རྣམ་པ་ལྔས།",
    "ཁྲུས་དང་གཙང་སྦྲ་ཆེན་པོས་ནུ་ཞོ་དང་བཟའབཅུང་བསོད་པ་དུ་མས་གཅེས་པར་བསྐྱངས་པའི་མཐུ་ལས་ཉིན་རེ་བཞིན་ཡང་ལང་ཚོའི་འཕེལ་བ་ཡར་ཟླའི་དཔལ་ལ་འགྲན་བཟོད་པ་ལྟར་གྱུར་ཅིང་།",
    "དེ་ནས་བྱས་པའི་རོལ་གར་གྱིས་དུས་འདའ་བ་དེ་དག་གི་ཚེ་ན་ཡང་བྱིས་པ་ཐམལ་བ་དག་གི་ངང་ཚུལ་བགམེད་པ་དང་ཉོན་མོངས་པའི་སྤྱོད་ཚུལ་མཐའ་དག་ལས་ངང་གིས་ལྡོག་ཅིང་།",
    "ཡུལ་དེར་ཐུབ་པའི་རིང་ལུགས་པ་ངུར་སྨྲིག་གི་རྒྱལ་མཚན་གསོལ།",
    "འཆི་བའི་དགྲ་ཡིས་དེའུ་རེ་བསད།",
    "ན་ཚད་སྲ་མོའི་རྒྱལ་སྲས་དཔག་བསམ་ལྗོན།",
    "གཟིགས་ཚེ་ཐུགས་མཚོར་རབ་དགའི་རྦ་རླབས་གཡོས།",
    "གང་གི་ཞབས་པད་ཐགོ་མར་བཀོད་པའི་ཚེ།",
    "དེ་ལྟར་དབུས་གཞས་བསྐོར་བར་ཕེབས་པ་དེ་དག་གི་ཚེ་ན་ཡང་།",
    "ཆང་དང་མཚན་མོ་རྒྱུ་བ་ངན་སོང་བ།",
    "ཞེས་གསུངས་པ་ལྟར་སྔོན་ཆད་ཉེས་པར་སྤྱད་པས་ནོངས་ཀྱང་རྗེས་སུ་སྟོབས་བཞི་ཚང་བའི་བཤགས་སྡོམ་ལ་འབད་ནས་རྒྱལ་བ་དགྱེས་པའི་ལམ་བཟང་པོར་ནན་གྱིས་བསླབ་ན་འགྲོ་བ་ལྷ་དང་བཅས་པའི་ཕྱག་བྱ་ཞིང་ཐལ་མོ་སྦྱོར་བའི་འོས་སུ་གྱུར་པ་ཁོ་ཁོ་ལྟ་བུར་འགྱུར་རོ།",
    "དེ་ལྟར་རྗེ་ཉིད་དགུང་ལོ་བཅུ་གསུམ་ནས་བཟུངས་ཉེར་དྲུག་གི་བར་བཀའ་བོད་ཆེན་པོ་རྣམ་པ་ལྔའི་གཞུང་ལུགས་རྣམས་ལ་ཐོས་བསམ་ཕུ་ཐག་ཆོད་པ་ལེགས་པར་མཛད་པའི་གཞུང་གི་དོན་རྣམས་ཁ་ཕྱིར་ལྟ་འབའ་ཞིག་ཏུ་མ་སོང་པར་རང་རྒྱུད་འདུལ་ཐབས་སུ་ཁྱེར་ཤེས་པའི་སྒོ་ནས་གཞུང་དོན་གདམས་ངག་ཏུ་འཆར་བའི་ཕྱིར་ཉིད་ཀྱི་བཞུགས་ཤགགི་རྟེན་དང་།",
    "དེས་ཞགང་ཞིག་བླངས་ཏེ་ལེགས་པར་བསྲུངས་ན་ཕན་ཡོན་གྱི་ཚོགས་དཔག་ཏུ་མེད་པཐོབ་པའི་བསྙེན་པར་རྫོགས་པའི་སྡོམ་པ་ཐོབ་ན་ཅི་མ་རུང་སྙམ་དུ་སྐོམ་པས་ཆུ་འདོད་པ་ལྟར་དགེ་སློང་གི་སྡོམ་པ་དོན་དུ་གཉེར་བས་རྗེ་ཉིད་དགུང་གྲངས་བདུན་ལྷག་བཅུ་ཕྲག་གཉིས་སུ་སོན་པ།",
    "དོན་ལྡན་བདུད་རྩིའི་བུམ་བཟང་ཁྱོད་ཀྱིས་རྙེད།",
    "རྒུན་མོང་སྐྱེ་བོ་རྗེས་སུ་བཟུང་བའི་སླད།",
    "རྣ་བའི་བཅུད་ལེནམཆོག་ཏུ་སོང་།",
    "ཉེ་བར་འཁོར་དེ་བྱོན་སྙམའཕྱང་མོ་ཉུག།",
    "སྤྱནརས་གཟིགས་བཅུ་གཅིག་ཞལ།",
    "གྲུབ་ཆེནཉི་སྦས་ལུགས་ཀྱི་སྒྲོལ་མ་ཉེར་གཅིག་ལས་མཆོག་སྩོལ་སེར་མོ་ཡན་ཆད་ཡོངས་རྫོགས།",
    "སྤྱནརས་གཟིགས་ཕྱག་བཞི་པ་དང་།",
    "དེ་མཚུངས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་གཟིགས་ཆེན་པོ་བློ་བཟང་དཔལ་ལྡན་བསྟན་པའི་ཉི་མ་མཆོག་གི་སྐུ་བཅར་ནང་མ་འགའ་ཞིག་དང་།",
    "འདི་དགགི་སྐབས་སྔ་ཕྱི་ཅི་རིགས་པར་དཔུང་བཟང་གིས་ཞུས་པ་ལས།",
    "དེ་དག་གི་ལྷག་པའི་ལྷ་དུ་མའི་ལྗགས་བསྙེནལ་འགྲུས་པར་མཛད་ཅིང་།",
    "ཕྱོགས་རེ་ཙམ་མིན་ལེགས་པར་སྦྱངས་པའི་མཐུས།",
    "སྦྲུས་དོནགསལ་བའི་ཀླུ་སྒྲུབ་མན་ངག་གིས།",
    "རྒྱུད་རྒྱལགདམས་པར་ཤར་བའི་ཉམས་ལེན་དང་ཌརིགས་ལམ་ཕྲ་མོ་འབྱེད་པའི་རྣམ་དཔྱོད་ཀྱི།",
    "སྲུབ་ཤིང་མཆོག་གིས་ཡང་ཡང་བསྲུབས་པ་ལས།",
    "དེ་ལྟར་གྲྭ་ཚང་གི་ཁྲིལ་བཞུགས་རིང་འཁོར་ལོ་གསུམ་གྱི་མཛད་བཟང་ཅི་རིགས་པའི་སྒོ་ནས་ཐུབ་། བསྟན་སྤྱི་དང་ཁྱད་པར་ཞྭསེར་ཅོད་པཎ་འཆང་བའི་རིང་ལུགས་དང་།",
    "དེ་བས་དབེན་པ་བསྟེན་ལ་སྒྲུབ་ལ་རེམ།",
    "དེས་ན་བདག་གི་ཀྱང་དབེན་པའི་གནས་སུ་སོང་ནས་ཉམས་ལེན་ནལ་མ་ཞིག་ཅིས་ཀྱང་བྱའོ་དགོངས་པའི་ཞི་དམ་མང་དུ་མཛད་ནས་སྐྱེས་བདག་ཅེས་པ་ལྕགས་ལུག་ལོ་ལ་གྲྭ་ཚང་གི་ཁྲི་འཤོལ་གནང་།",
    "གཅོང་རོང་ཟབ་མོས་བསྐོར་བའི་ནགས་ཚལ་སུཾ་ཅུ་རྩ་གསུམ་གྱི་དགའ་བའི་ཚལ་ལྟར་ཉམས་དགའ་ཞིང་མཛེས་པ།",
    "ལྷག་པར་གྲྭ་ཚང་གི་ཁྲིར་ཕེབས་ནས་ཀྱང་རིང་པོར་མ་ཐོགས་པར་ཁྲི་བཤོལ་ཏེ་རྙེད་བཀུར་ཕུན་སུམཚོགས་པ་དེ་ལྟ་བུ་ཡང་བཙན་ཆོད་དུ་སྤོང་བརམཛད་ན་རྙེད་བཀུར་ངན་ངོན་དག་ལྟ་ཅི་སྨྲོས།",
    "རོལ་མོ་ལ་སོགས་པའི་མཆོདཔའི་བྱེ་བྲག་དངོས་སུ་བཤམས་པ་དང་།",
    "བཞད་མཛད་སྨྲབའི་ཉིན་བྱེད་ཁྱོད་ལས་གང་།",
    "ཁྱོད་ཡིན་གཞན་མིང་འདོད་རྒྱལ་སྒྲ་རུ་ཐལ།",
    "གཞན་ཡང་ཁྱོད་ཐུགསམ་དྲོས་མཚོ་ཆེན་ལས།",
    "དབྱར་གྱི་དཔལ་མོའི་ཆུ་འཛིན་རྗེས་སུ་རྟོག།",
    "དེ་ནས་པཎཆེན་ཐམས་ཅད་མཁྱེན་གཟིགས་ཆེན་པོ་དགུང་གྲངས་བཅུ་ཕྲག་གཉིས་དང་འདོད་ཡོན་གྱི་གྲངས་སུ་སོན་པ་མྱོས་ལྡན་ཅེས་པ་ས་ཡིས་ལོ་དགུང་སྐག་གི་ཚུལ་དུ་ཕེབས་པར་ཚུལ་བསྟན་གྱི་སྐག་རྩུབ་ཀྱི་རྣམ་པ་མང་ཙམ་ཡང་མི་བཞེས་པརཞབས་ཟུང་བསྐལ་བརྒྱའིབར་དུ་བརྟན་པ་དང་།",
    "འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོ་ཞལ་བཅུགཅིག་པ་དཔལ་མོ་ལུགས།",
    "བཀྲས་ལྷུནསྔགསཆོག་པོད་གཉིས་ཀྱི་ལྗགས་ལུངསོགས་ཞག་ཉི་ཤུ་སྐོར་ཟབ་ཆེས་རྒྱ་ཆེར་སྩལ་ཅིང་སཟླའི་གནམ་གང་ཉིན་ཐེག་ཆེན་གསོ་སྦྱོངགི་སྡོམ་པ་ཡང་སྩལ།",
    "ཁྱོད་སྐུའི་ཉིན་བྱེད་སྒྲིབཚེ་སྒྲུབ་བསྟན་གྱི།",
    "གསུང་གི་བདུད་རྩིར་རྟག་ཏུ་སྤྱོད་པར་ཤོག།",
    "ཁྱད་པར་རི་ཁྲོད་སྤོང་བ་པ་རྣམས་ལ་བསྙེན་བཀུར་སྐུ་འགྱེད་སོགས་སྐུ་མཆོདས་སོདང་བསྟུན་ནསརྒྱ་ཆེརབསྒྲུབས་ཏེ་ཟག་མེད་ཐུགས་ཀྱི་དགོངས་པ་ཟབ་མོ་ཡོངས་སུ་རྫོགས་པའི་ཐབས་བླ་ན་མེད་པ་མཛད་ཅིང་།",
    "དེ་ལྟར་ལུང་གི་ཡོན་ཏན་རྒྱཊ་ཚོ་ལྟ་བུ་ལམངའ་བརྙེས་པ་ཙམ་དུ་མ་ཟད་རྟོགསཔའི་ཡོནཏན་མཐའ་དག་གི་ཡང་རྩེ་མོར་སོན་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་རྣམཔར་དག་པ་གཞིར་བཟུང་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་ལམ་གྱི་རིམ་པ་རྣམས་ཐུགསཉམས་སུ་བསྟར་བའི་སྒོནསགོང་མའི་ཡོན་ཏེན་གྱི་རིམ་པ་ཇེ་མཐོཇེ་མཐོར་གྱུར་བའི་ཚུལ་བསྟན་ཏེ།",
    "བྱ་བ་ལས་ཀྱི་འཁོར་ལོས་བསྟན་འགྲོའི་དོན་ཇི་ལྟར་མཛད་པའི་ཚུལ་ཡང་རེ་ཟུང་ནི་གོངདུ་སྨོས་པ་ལྟར་དང་།",
    "གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའཞག་གི།",
    "ནོར་འཛིན་ཁྱོན་འདི་དོག་པོར་བྱེད་གྱུར་ཆིག།",
    "ཕྱོགས་བྲལ་དབྱིག་འཛིན་སྒེག་མོའི་ཁུར་ཚོས་ལ།",
    "མགོན་པོ་ཁྱོད་ཀྱིས་འབྲལམེད་རྗེས་འཛིན་ཅིང་།",
    "སྤྱིར་བཏང་གི་ཆོ་གརས་སུ་འབོར་པ་རྣམས་བཀག་པ་ཡིནལ།",
    "ཚིགས་གཅིག་གིས་ལྡ་བརྒྱ་བསྙེན་པར་རྫོགས་པ་བྱར་རུང་བ་ཡོད་དེཉ་པ་ལྔ་བརྒྱ་ལ་ཚུར་ཤོག་མཛད་པ་ལྟ་བུའོ།",
    "རེ་རེ་ནས་སམ།",
    "གཞན་ཡང་རྣམ་བཤདཆེ་བ་རྣམས་ནས་བྱེ་བྲག་གི་ཆོ་ག་ཇི་སྙེད་ཅིག་གསུངས་ཀྱང་།",
    "ཉནགཅིག་ལ་དགེསློང་དྲུག་ཅུ་རེ་དྲུག།",
    "རྒྱལ་མཆོག་བསྐལ་བཟང་རྒྱ་མཚོས་ཀྱྀང་དགེ་ཚུལ་བརྒྱད་ཅུ་གྱ་བདུན་དང་དགེ་སློང་ཉིས་བརྒྱ་དྲུག་ཅུ་རེ་གསུམཉིན་རེར་སྩལ་བར་མ་ཟད།",
    "འདི་རྣམས་ནིམཚོན་བྱེད་རེ་བྲིས་པ་ཡིན་གྱི།",
    "གནམ་གྱི་ལྷ་གོང་མ་ཆེན་པོའི་དབུ་བླས་མཚོན་བསྟན་པ་ཡོངས་རྫོགས་ཀྱི་བདག་པོ་སུས་ཀྱང་སྐུར་འདེབས་སྦྲང་བུའི་སྐད་ཙམ་མེད་པ་ནི་དོན་གནས་ཁོ་ན་ཡིན་མོད་ཀྱང་།",
    "མཁས་གྲུབ་ཆེན་པོ་དེ་དག་གིས་ཀྱང་མངོན་སུམ་དང་ལྐོག་གྱུརགང་ལའང་བཀའ་ཇི་སྩལ་ལ་ཐུགས་ཐག་རྦད་ཆོད་ཀྱིས་མངོན་བསྟོད་མཛད་རྐྱང་ལས།",
    "གཟུར་གནས་དག་གིས་དགོངས་ཤིག།",
    "ཉོན་མོངས་སྟོབས་ཆེན་དག་འདིས་ནི།",
    "ཞོ་ནི་དུས་རུང་གི་ལྡེ་གུའི་ནང་ཚན་ནས་ཀྱང་བསོད་པའི་གྲས་ཡིན་པས་ཕྱི་དྲོ་ལོངས་སྤྱོད་དུ་མི་རུང་ཞིང་།",
    "སྐྱོ་མའི་ཐུག་པ་ལ་སོགས་པ་དུས་རུང་གི་ལྡེ་གུ་དང་བཏུང་བ་གང་ཡང་རུང་བ།",
    "ལྷག་པར་སྔགས་ལ་བསྙད་བཏགས་ནས་འདུལ་པའི་བཅས་མཚམསལསའགལ་ཡང་ཐེག་བགོང་མསའོག་མཟིལ་གྱིས་གནོན་པསཉེས་པར་མི་འགྱུར་ཟེར་ནས་བག་ཡངས་སུ་འཇུག་པ་ནི་རང་གིས་རང་བསླུ་བ་ཡིན་པས་ངལ་བའི་རྟེན་ལན་ཆིག་ཐོབ་པའི་སྐབསའདིར་རང་གིས་རང་བསླུ་བའི་ལས་མི་བྱ།",
    "དགེ་ཚུལ་སློང་གིས་ཕྱི་དྲོ་ཞོལ་སྤྱད་མི་ཆོག་པོ་བདེ་བླག་ཏུ་མཁྱེན་པར་འགྱུར་རོ། ། ལྕང་གནང་བའི་སྐོར་ཀྱང་གཏན་ནས་བདེན་དོགས་མེད་སྙམ་རུང་།",
    "འདི་ལ་བདག་གི་རྗེས།",
    "བསྟན་འགྲོའི་གཙུག་རྒྱན་བེ་རོ་ཙ་ན་བསྟནཔའི་ཆོམ་རྐུན་དུ་སྤྱན་འདྲེན་འདྲོདཔ་ཞིག་གིས་བྱས་པར་གདོན་མི་ཟ་སྟེ།",
    "དྲི་བ་པོདག་གིས་ཀྱང་རྐུ་ཐབསསུ་གནས་པ་མ་ཡིནནམ་ཞེས་དྲིས།",
    "མགོན་ཁྱོད་བགྲང་ཡས་བསྐལ་པའི་སྔོན་རོལ་ནས།",
    "ཞེས་གསུངས་པས་རགས་ཙམ་སྟོན་མོད་ཀྱི།",
    "བོད་ཁམས་ལྷོ་མོན་ཁྱབ་པར་འགྲོ་དོན་སྐྱོང་།",
    "ཅེས་ཐུན་མོང་མ་ཡིན་པའི་མཛད་པ་དང་བཅས་ཤིན་ཏུ་གསལབར་ལུང་སྟོན་པར་མཛད་ཅིང་།",
    "ཞེས་གང་གསུངས་པ་མངོན་སུམ་དུ་གཟིགས་པ་འདིདག་མཟད།",
    "གཙང་གི་ཕྱོགས་སུ་རབ་འབྱོར་སྤྲུལ་པ་འབྱུང་།",
    "མ་འདི་ལ་པ་ཕ་ཟེར་སོང་ཞེས་མངོན་ཆུང་དུམཛད་དགོས་པའི་བཀའ་སྩལ།",
    "ལུངགི་ཉི་མའི་མིང་ལྡན་པའི།",
    "ཁྲམསའཆལ་བྱོལ་སོང་སྐྱོང་བར་བྱེད།",
    "དེང་སྐབས་ཀྱང་ལུང་བསྟན་དེ་རྣམས་ཀྱི་དོན་ཇི་ལྟ་བབཞིན་གཟུར་གནས་མཐའ་དག་གིས་མངོན་སུམ་དུ་གཟིགས་པ་འདི་གལགས་གཤིས།",
    "དེ་དག་གི་ཕྱག་རྗེས་ཀྱང་ཡོངས་འཛིན་རྡོ་རྗེ་འཆང་ནོ་མིན་ཧྭན་ཆེན་པོའི་རང་རྣམ་གཟིགས་ན་མཁྱེན་ལ།",
    "དཔལ་ལྡན་རྡོ་རྗེ་འཇིགསབྱེད་མངོན་སུམ་གཟིགས།",
    "གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའ་ཞིག་གི།",
    "མཚོ་ཊཱིཀ་ཏུང་ར་ཆོག་གི་སྐབསའདི་ཞེས་བྱབ་མངོན་སུམ་ན་ཡོད་པ་ལ་འཇུག་ཚུལ་གསུངས་པའི་མཐར།",
    "ད་ལྟ་སྔོན་ཆོག་གིས་བསྙེན་རྫོགས་བྱརམི་རུང་ཡང་བྱསན་སྐྱེ་བར་མངོན་ཏེ།",
    "ཞེས་གསུངས་པ་ལྟར་སྔོན་ཆོག་གིས་ཀྱང་དེང་སང་སྡོམ་པ་སྒྱེ་ན་འཕྲིན་ཆོག་ནི་ང་ཉིད་ལས།",
    "སྔོན་བྱོན་ཡབ་སྲས་རིམ་པས་བདག་གིར་མཛད།",
    "གཙང་གི་ཕྱོགས་སུ་རབ་འབྱོར་སྤྲུལ་པ་འབྱུང་།",
    "འབྲེལཚོད་དོན་ལྡན་ཞིག་གིས་བསྟན་པ་སྐྱོང་།",
    "ནམམཁའ་དང་ལག་མཐིལ་དུ་མཚུངས་པའི་ཟབ་མོའི་ལྟ་བ་ཐུགས་སུ་ཚུད་ཅིང་།",
    "ཁྱོད་སྐུ་འོད་ཟེར་བྱེ་བ་བརྒྱ་ཕྲགགས།",
    "འཕགས་པ་འོད་སྲུང་གི་དགེ་ཚུལ་པདྨའིངད་ལྡངདང་།",
    "ཕལ་ཆེར་གསུངརབ་བལྟ་ལ་ཕྱོགས་རེའི་མིག།",
    "ཐུབ་བསྟན་ཡོངས་སུ་རྫོགས་པ་རང་གི་ཉམས་ལེན་དུ་འཁྱེར་ཤེསཔའི་ཁོང་འཛུམགྱི་གེ་སར་རྒོད་པ།",
    "རྫས་ལྡོགགི་རྣམ་གཞགཕ་རོལ་བོའི་ལོག་རྟོག་འགོག་པའི་ཆེད་དུ་བཀོད་པའི་ཐལ་འགྱུར་གྱི་རྣམ་གཞག།",
    "གལ་ཏེ་ཡང་དག་དམ་བཅའཙམཞིག་གིས།",
    "རབ་མཛེས་ལྷ་མོའི་གཟུགས་སུ་ལེགས་ཤའ་བ།",
    "ཕྱག་ནཔདདཀར་འཆང་བ་ངུར་སྨྲིག་གིས།",
    "སྔང་དགྲ་གནོད་བྱེད་ཐལ་བར་རླག་མཛད་པའི།",
    "གནོད་བྱེད་དགྲ་བགེགས་ཐལ་བའི་རྡུལ་དུ་རློག།",
    "ཞེས་ཤིས་པ་བརྗོད་པའི་ཚིག་གི་སལམ་ཡངས་པར་བྱས་ཏེ།",
    "གཞུང་ལུགས་རབས་འབྱམས་སྨྲ་བའི་ངགེ་བའི་བཤེས་གཉེན་ཆེན་པོ་ཡོངས་འཛིན་མཆོག་གི་ཞབས་རྡུལ་དྲི་མ་མེདཔ་བསམ་སྦྱོར་གཉིས་ཀྱི་སྒོ་ནས་ཚུལ་བཞིན་དུ་བསྟེན་ཏེ་ཤེས་བྱ་རིག་པའིགནས་མཐའདག་ལ་མངདུ་ཐོས་པ་ལྷུར་བཞེས་མཛད་ཅིང་།",
    "རིང་མོ་ཞིགནས་གོམས་པའི་བག་ཆགས་བཟང་པོའི་སའོན་འབར་ལེན་པའིརྐྱེན་དུ་མའི་དྲོད་གཤེར་གྱིས་སྨིནཔའ་བྱས་པ་ལས།",
    "དེ་ལྟར་རིང་མོ་ཞིག་ནས་གོམས་པའི་ཐུགས་བསྐྱེད་རླབས་པོ་ཆེའིམཐུ་གྲུབ་པས་ཕྱོགས་བཅུའི་། རྒྱལ་བ་སྲསདང་བཅས་པཐམསཅད་ཀྱིགསང་བགསུམ་གྱི་མཛད་པ་རྨད་དུ་བྱུངབ་མཐའདག་རང་ཉིད་གཅིག་པུའིཕྱག་མཚན་དུ་བཞེས་ཏེ།",
    "ཕུན་ཚོགས་ལང་ཚོ་རྒྱས་པའིའཇོ་སྒེག་ཅན།",
    "ཞེས་ཤིས་པས་སྐྱོང་བའི་ཚིག་གི་མེ་ཏོག་འཐོར་བ་སྔོན་དུ་བཏང་ནས།",
    "ཐུབ་བསྟཞགངས་ཀྱི་རེ་སུལ་སྐྱོང་བའི་རྣམ་དཔྱོད་གདོང་ལྔའི་ལུས་རྩལ་ནི་ཡོངས་སུ་རྫོགས།",
    "རང་གི་ཆེད་དུ་ཡོངས་སུ་དག་པའི་ཞིང་གི་འབྱོར་པ་ཡང་རྨི་ལམ་གྱི་དགའ་སྟོན་ལྟར་གཟགསནས་དེ་དག་ལ་ལྟོས་པ་མེད་པར་བདེ་གསང་འཇསགསུམ་ལ་སོགས་པའིཡིདམགྱི་ལྷ་དུ་མའིབསྐྱེད་རྫོགས་ཀྱི་ཏིང་ངེ་འཛིན་ཤིན་ཏུ་བརྟན་པ་བརྙེས་པས་ཐུནམོང་དང་ཐུན་མོང་མ་ཡིན་པའི་མངོནཔར་རྟོགས་པའི་ཡོན་ཏན་གྱི་ཚོགས་ལ་འགྲན་པའི་ཟླ་ཐམས་ཅད་དང་བྲལ་བར་གྱུར་ཏེ།",
    "གཞན་གྱིས་བགྱིས་པ་ལ་རྗེས་སུ་ཡི་རང་བ་ཐམས་ཅད་ལྷག་མ་མ་ལུསཔར་བྱང་ཞིང་དག་པར་མཛད་དེ་ཚེ་རབས་ཀུན་ཏུ་མགོན་པོ་མཆོག་བརྒྱདགིས་ལུས་དང་གྲིབ་མ་བཞིན་དུ་སྐད་ཅིག་ཀྱང་འབྲལ་བ་མེད་པར་རྗེས་སུ་བཟུངནས་སྐུགསུང་ཐུགསཀྱི་གསང་བ་མ་ལུསཔ་འཛིན་པའིསྲས་ཀྱི་མཐུབར་འགྱུར་བ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ། རང་ཉིད་འདེབས་ཡུན་འཚོའི་སྨོན་ཚིག་འདོད་འཇོའི་བུམ་བཟང་ཞེས་བྱ་བ། ཨོཾ་སྭསྟི།",
    "ཕྱྀནང་གསངབའི་སྤྱན་གཟིགས་སྣ་ཚོགས་དང་།",
    "ལྗོན་དམར་ལས་གྲུབ་སྟོང་གསུམ་ལྟར་ཡངས་དཀྱིལ་ཟུར་སློབ་དཔོན་ངོ་གཡོག་གིས།",
    "གཡེན་པས་མཉམ་གཞག་སྟེང་ན་དྲང་སྲོང་གི།",
    "བདག་གི་ལུས་ངག་ཡིད་གསུམ་ལོངས་སྤྱོདདང་།",
    "དེ་ལྟར་མོས་པ་བྱས་ཏེ་བསྒྲུབས་ཀྱང་མ་གྲུབ་ན་སྤོགས་པའི་ཆོ་ག་ཇི་ལྟར་བྱ་བ་དང་།",
    "དེ་བཞིན་དུ་གང་ཟག་གི་མོས་པའི་བྱེ་བྲག་གིས་སྤྱན་མ་ལ་སོགས་པ་ནི།",
    "དེ་དག་རེས་འགའ་ནི་སྔ་མ་མི་གསལ་བ་གསལ་བའི་ཚུལ་གྱིས་སྟོན་ལ།",
    "རེས་འགའ་ནི་སྔ་མའི་ཁ་བསྐང་གི་ཚུལ་གྱིས་ཅི་རིགས་སུ་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་བཅད་གཅིག་གིས།",
    "རིག་མ་ཆེན་མོ་བདག་མེད་དང་།",
    "ས་སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པས་གནས་གང་དུ་ཆོ་ག་གང་གིས་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་བརླབ་པ་བསྟན་ཏོ།",
    "འདོད་ཆགས་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལྷ་མོ་དེ་དག་དག་ཅིང་ལྷར་བསྐྱེད་པ་བསྟན་ཏོ།",
    "ཧེ་རུ་ཀ་གཞན་དག་གི་བསྡུས་པའི་དཀྱིལ་འཁོར་ཡང་དོན་གྱིས་ཤེས་པར་བྱའོ།",
    "སེམས་ཀྱི་རྗེས་སུ་དྲན་བྱ་བ་ལ་སོགས་པས་ནི་རྒྱལ་བ་རིགས་ལྔའི་ཐོག་མར་དམ་ཚིག་གི་འཁོར་ལོ་བསྒོམ་ཞིང་།",
    "ཕྱོགས་ཀྱི་ལྷ་མོས་དགུག་གཞུག་བྱ་བ་དགོས་པ་དང་བཅས་པ་བསྟན་ཏོ།",
    "གང་གིས་སྔགས་ཀྱི་རིམ་ཐོབ་པ།",
    "བསྐྱེད་པའི་རྣལ་འབྱོར་གྱི་ཏིང་ངེ་འཛིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བསྐྱེད་པའི་རིམ་པ་ཡན་ལག་དྲུག་གི་བདག་ཉིད་བྱིན་གྱིས་བརླབ་པའི་སྔགས་དང་བཅས་པ་བསྟན་ཏོ།",
    "ཁྱོད་ནི་ཞེ་སྡང་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྐུལ་བའི་གླུ་བསྟན་ཏོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་བུད་མེད་ལ་སྨད་པ་སྤང་བ་དང་།",
    "སྐྱེས་བུ་ཞེས་བྱ་བ་ལ་སོགས་པས་སྒྲུབ་པ་པོའི་གང་ཟག་གི་མཚན་ཉིད་དམ་ཚིག་ལ་གནས་པར་བསྟན་ཏོ།",
    "རིགས་གཞན་དག་གི་དྲག་ཤུལ་གྱི་བསྒྲུབ་པ་ནི་དོན་གྱིས་བསྟན་ཏོ།",
    "མ་མོའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྒྱལ་བ་རིགས་ལྔ་སོ་སོའི་ཕྱག་རྒྱ་དང་།",
    "ལྷ་མོ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཡུམ་གྱི་ཕྱག་རྒྱ་དང་ཕྱག་མཚན་བསྟན་ཏོ།",
    "དེ་ལ་ཡང་ཕྱག་བཞི་པ་དང་ཞེས་པ་ལ་སོགས་པས་ནི་ལྷ་གང་གི་རྣལ་འབྱོར་གྱིས་བསྒྲུབ་པ་བསྟན་ཏོ།",
    "ཧྃ་གིས་ས་བོན་ཞེས་པ་ལ་སོགས་པས་ནི་བསྒྲུབ་པར་བྱ་བ་གང་བསྒྲུབ་པ་བསྟན་ཏོ།",
    "དེ་ནས་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ཀྱི་དོན་དུ་ཕྱག་རྒྱ་ལྷ་གང་གི་རྣལ་འབྱོར་དུ་བྱ་བ་དང་།",
    "ལྷ་གང་གི་དངོས་གྲུབ་འགྲུབ་ལ་བསྟན་ཏོ།",
    "རྩ་བའི་རྒྱུད་དུ་ཐུན་མོང་དུ་རྟོགས་པར་བྱ་ལ།",
    "རྫོགས་པའི་རིམ་པའི་རྟེན་ཡིན་པས་བསྐྱེད་པའི་རིམ་པ་གཉིས་པའི་གསུམ་པ་ནས་གསུམ་པ་དངོས་ཀྱི་བར་རབ་བྱེད་དྲུག་གིས་བསྟན།",
    "རིམ་པ་གཉིས་ལ་གནས་པ་དེས་དྲོད་ཐོབ་ནས་རང་གི་སེམས་ཀྱི་བརྟན་གཡོ་བརྟག་པའི་ཕྱིར་སྤྱོད་པ་ནི་ལྔ་པའི་གསུམ་པ་ནས་སྤྱོད་པའི་མཚན་ཉིད་བསྟན།",
    "དེ་ལྟར་རབ་ཏུ་བྱེད་པ་ཉི་ཤུ་བདུན་པའི་དང་པོའི་ཆ་དང་ཉི་ཤུ་རྩ་གཅིག་གིས་གཙོ་བོར་མཆོག་སྒྲུབ་པའི་མངོན་རྟོགས་ལྔ་བསྟན་ཏེ།",
    "དམན་པ་ལ་མོས་པའི་རྟེན་གྱི་གང་ཟག་རྗེས་སུ་གཟུང་བའི་ཕྱིར་ཕྲིན་ལས་རབ་འབྱམས་ནི་བདུན་པའི་དང་པོ་ནས་ལྟ་སྟངས་ལ་སོགས་པའི་ཡེ་ཤེས་བདུན་བསྟན་ལ།",
    "གཉིས་པ་དངོས་ཀྱི་སྟོད་ལས་ཀྱང་ལས་རྒྱས་པའི་ལྷ་མོ་གསུམ་བསྟན་ཏོ།",
    "ཁ་ཅིག་ཏུ་ཚིག་གི་དོན་རྣམ་པར་ཕྱེ་སྟེ་གསལ་བར་བྱེད་པའོ།",
    "གླེང་གཞི་ཕུན་སུམ་ཚོགས་པའི་ཚུལ་གྱིས་རྒྱུད་ཀྱི་ལུས་རྣམ་པར་གཞག་པའི་དོན་རྩ་བའི་རྒྱུད་དང་ཐུན་མོང་དུ་རྟོགས་པར་བྱའོ།",
    "ཤེས་རབ་ཡི་གེ་བཅུ་དྲུག་གིས་དྲངས་ལ།",
    "ཚིག་གི་དོན་ལ་དང་པོར་ཞེས་པ་ལམ་ཐམས་ཅད་ཀྱིའོ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་ཡན་ལག་གི་དོན་གཙོ་བོ་ཡིན་ལ།",
    "ཡན་ལག་བརྒྱད་ལ་ཡི་གེ་བརྒྱད་དགོད་པ་བདག་གི་གདན་གྱི་རབ་བྱེད་བཞི་པར་བསྲུང་བར་གསུངས་པ།",
    "གང་ཞིག་གང་གི་ཕྱག་རྒྱ་ཡིན་པའང་དེ་བཞིན་དུ་སྦྱར་རོ།",
    "དེ་ནས་འོག་ཏུ་སྦྱར་ལ་མ་མོ་ནི་ཨཱ་ལི་ཡིན་ལ།",
    "དེ་ལ་རིང་ཐུང་གཉིས་རེ་རེར་བརྩིས་པའི་ཕྱེད་ཨ་ཐུང་ཡིན་པས་ཨ་ཤད་ལྟ་བུ་མཆོག་ཏུ་ཕྲ་བ་དེ་ཉིད་ཐིག་ལེའི་གཟུགས་སོ།",
    "འཛག་པ་ཤས་ཆེ་བ་སྙམ་བྱེད་ན་ཨྃ་ལ་ཤེས་པ་གཏད་ལ་བསྒོམ་མོ།",
    "ལྟེ་བ་ན་རོ་རྐྱང་གི་མདུད་པའི་དབྱིབས་སུ་གནས་པ་བསྟན་ཏོ།",
    "ཐག་པ་གཅིག་ནི་རྣམ་འབྱུང་ཞེས་པ་ཧྃ་ལས་བྱང་སེམས་དགའ་བ་བཅུ་དྲུག་གི་རྣམ་པར་འབབ་པའོ།",
    "ལྷ་མོ་རྣམས་བསྐྱེད་པའི་ས་བོན་དུ་འགྲོ་བ་དང་།",
    "ཤེས་རབ་ཡེ་ཤེས་ཀྱི་དུས་སུ་རང་ཉིད་ཀྱིས་བསྟེན་པས་སྲིང་མོ།",
    "འོག་ནས་ཀྱི་བྲམ་ཟེ་མོ་ལ་མ།",
    "གར་མ་ལ་སྲིང་མོ།",
    "གདོལ་པ་མོ་ལ་བུ་མོ།",
    "གཡུང་མོ་ལ་གཉེན་མོ་སྟེ།",
    "ཚ་མོའི་བརྡས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཡང་གཞུང་དུམ་བུ་བདུན་དུ་གནས་པ་ལས་རེ་རེ་ལ་ཡང་དམིགས་པའི་ཡུལ་གང་ཡིན་པ།",
    "རང་གི་ངོ་བོ།",
    "དེ་ཡང་དྲན་པ་ཉེར་གཞག་གི་དམིགས་པའི་ཡུལ་ལུས་ལ་སོགས་པ་བཞི།",
    "རང་གི་ངོ་བོ་དྲན་པ་དང་ཤེས་རབ་ཀྱིས་རྣམ་པར་ཕྱེ་སྟེ།",
    "དེ་ལྟར་ཉེས་པ་བཞི་ལ་འདུ་བྱེད་རེ་རེའོ།",
    "ཤེས་རབ་ཀྱིས་རབ་ཏུ་འབྱེད་པའི་ཚུལ་གྱིས་བསྒོམ་མོ།",
    "ཤིན་ཏུ་སྦྱངས་པ་དང་ཏིང་ངེ་འཛིན་དང་བཏང་སྙོམས་ནི་ཉོན་མོངས་པ་མེད་པའི་ཡན་ལག་སྟེ་དེ་ཡང་གང་གིས་ཉོན་མོངས་པ་མེད་པ་ན་ལུས་དང་སེམས་ཤིན་ཏུ་སྦྱངས་པས་གནས་ངན་ལེན་འཇིག་པས་སོ།",
    "གང་གི་ཚེ་ཉོན་མོངས་པ་མེད་ན་ཏིང་ངེ་འཛིན་ལ་དེ་རྩེ་གཅིག་ཏུ་གནས་པའི་ཚེ་མེད་དེ།",
    "ངག་གིས་རྟོགས་པ་དང་མཐུན་པར་གཞན་དག་འདྲི་བ་དང་ལུང་སྟོན་པ་ལ་སོགས་པ་འབེལ་བའི་གཏམ་གཏན་ལ་ཕབ་པས་གཞན་གྱི་ལྟ་བ་རྣམ་པར་དག་པར་ཤེས་སོ།",
    "ཡང་དག་པའི་དྲན་པ་ནི་ཉེ་བའི་ཉོན་མོངས་པ་མེད་པའི་ཡན་ལག་སྟེ།",
    "བརྗོད་བྱ་ཡན་ལག་གི་གཙོ་བོ་ཡིན་ལ།",
    "མིང་གི་དབྱེ་བ་ཆ་མཐུན།",
    "ཐུན་མོང་གི་མཚན་ཉིད་བསྡུས་ནས་གསལ་བར་བསྟན།",
    "རྒྱུད་ཕྱི་མ་དང་བཅས་པའི་ཚིག་གི་དོན་ཕྱེ་སྟེ་གསལ་བར་བཤད།",
    "ཐུན་མོང་མ་ཡིན་པ་འབྲས་བུའི་རྒྱུད་ཀྱི་མཚན་ཉིད་ཀྱང་རྟོག་པ་ལྔ་པ་དང་ཆ་མཐུན་ཞིང་།",
    "དེར་བཞུགས་པ་པོ་ཡེ་ཤེས་ཉིད་ལོངས་སྐུ་མཚན་དང་དཔེ་བྱད་ཀྱིས་བརྒྱན་པ་བཙུན་མོའི་འཁོར་གྱི་ནང་དུ།",
    "དེ་རྣམས་ལས་བུད་མེད་བྲམ་ཟེ་མོ་ལ་སོགས་པར་སྤྲུལ་པ་ལ་བརྟེན་ནས་ཟག་པ་མེད་པའི་བདེ་བ་མངོན་དུ་བྱས་པ།",
    "བུད་མེད་སྒྱུ་མས་ཐམས་ཅད་འགྲུབ།",
    "ཅེས་པས་བུད་མེད་དུ་སྤྲུལ་པ་ལ་བརྟེན་ནས་སོ།",
    "གཡུང་མོ་མཱ་མ་ཀཱིར་བསྐྱེད་པ་ལ་བརྟེན་ནས་རྡོ་རྗེ་འཛིན་པ་ཉིད་ཅེས་བྱ་བ་མི་བསྐྱོད་པའི་དངོས་གྲུབ་ཐོབ་ཅེས་པའོ།",
    "ཐུན་མོང་མ་ཡིན་པ་འབྲས་བུའི་རྒྱུད་ཀྱི་མཚན་ཉིད་ལས་དེ་བཞིན་གཤེགས་པ་ནི་འདུས་པ་ལ་སོགས་པ་མན་ངག་གིས་ཐོབ་བྱ་ས་བཅུ་གཉིས་པ་མན་ཆད་དོ།",
    "དོན་དམ་པར་རྣམ་རྟོག་གི་སྤྱོད་ཡུལ་གྱི་དངོས་པོ་མ་ཡིན་པའི་ཕྱིར་སྟོང་པ་མིན་པའང་མིན་ནོ།",
    "རྣམ་རྟོག་མེད་པར་ལྷག་མོས་ལ།",
    "མིག་གི་ཡུལ་གཟུགས་ལ་སོགས་པའོ།",
    "དངོས་པོ་གཅིག་པོ་དེ་ཐབས་གང་གིས་རྟོགས་ཤེ་ན།",
    "སྤྱི་དང་སྦས་པ་མཐར་ཐུག་གསུམ་ཀ་དེ་རེ་རེ་ལའང་གཉིས་གཉིས་ཡོད་པའི་དྲུག་ཀ་ཚང་དུ་རུང་།",
    "བྲམ་ཟེའི་རིགས་ཀྱི་བུ་མོ་སྤྱན་དུ་བསྐྱེད་པ་ལ་སོགས་པ་ལ་བརྟེན་ནས་ལྷན་སྐྱེས་མངོན་དུ་བྱས་པ་ལས་ཐོབ་པའོ།",
    "དེ་ལས་ཀྱང་བུད་མེད་ཀྱི་རྟེན་ལའོ།",
    "ཐབས་ཀྱིས་མ་ཟིན་པ་དང་ཟིན་པའི་བྱེ་བྲག་གིས་འཁོར་འདས་གཉིས་ཀ་བསྐྱེད་པས་རྒྱ་ཆེན་ནོ།",
    "ཡང་ན་ལས་ལ་སོགས་པས་ཐུན་མོང་སྟེ་དེ་གཉིས་ཀྱིས་ཐོབ་བྱ་ཐོབ་པ་ལས་གཏི་མུག་ལ་སོགས་པ་སྤང་བྱ་སྤོང་བ་སྟེ།",
    "དེ་རྣམས་ཀྱི་རང་གི་དོན་འགྲུབ་པའི་ཕན་ཡོན་ནོ།",
    "གདུལ་བྱ་ཉོན་མོངས་པ་གང་དང་གང་གིས་གནས་གྱུར་པ་སྟེ་ཤས་ཆེ་བ་ལ་རྡོ་རྗེ་འཛིན་པ།",
    "དེའང་སྦྱང་གཞིའི་མིང་གིས་གཉེན་པོ་ལ་བཏགས་པ་བསྟན་ཏོ།",
    "དེ་གཡས་ཀྱི་རོ་མ་ནས་སོང་།",
    "སྔོན་བྱུང་གི་རྣམ་པར་འཕྲུལ་པ་ཡང་འབྲས་བུའི་རྣམ་པ་ཡིན་པས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་དེ་བཞིན་ཉིད་ལ་གང་གི་ཚེ་ལ་སོགས་པ་དབྱེར་མི་ཕྱེད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་བཞུགས་པ་པོ་རྡོ་རྗེ་འཛིན་པ་བསྟན་ལ།",
    "རྟེན་གྱི་གང་ཟག་ཇི་ལྟ་བུ་ཅིག་གིས་འགྲུབ་པ།",
    "ཐབས་གང་གིས་འགྲུབ་པ།",
    "རྗོད་བྱེད་ཡན་ལག་གི་དོན་གཙོ་བོ་ཡིན་པ།",
    "བསྡུས་པའི་དོན་ཡང་བྲམ་ཟེ་མོ་ལ་མའི་བརྡས་བསྟན་པ་ལ་སོགས་པ་ཅུང་ཟད་ཙམ་མོ།",
    "རིག་མ་བཟང་མོ་རྣམ་པར་གཞུག།",
