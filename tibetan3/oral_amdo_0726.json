    "གང་གིས་ན་རྣལ་འབྱོར་པས་སྟོང་མིན་ཏེ་རིག་པ་གསལ་བ་མི་སྤང་ངོ།",
    "དེའི་སྒྲུབ་པའི་ཕྱག་རྒྱ་བྲམ་ཟེ་མོ་སྤྱན་དུ་བསྐྱེད་པ་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱའི་བརྡས་བསྟན་པ་ལ་སོགས་པའོ།",
    "གཏི་མུག་ཅེས་པ་རྣམ་སྣང་གི་སྒྲུབ་པ་པོས་བྲམ་ཟེ་མོ་སྤྱན་དུ་བསྐྱེད་པ་ལ་བརྟེན་ནས་ཞི་བ་ཞེས་པ་རྣམ་སྣང་གི་དངོས་གྲུབ་འཐོབ་པར་བྱ་སྙམ་པའོ།",
    "བྱོལ་སོང་ཞེས་པ་ཏིརྻ་ཀ་བྱ་བའི་སྒྲ།",
    "ཡང་མ་རྙེད་ན་ནི་མའི་ནུ་མོའོ།",
    "ལོགས་མ་ཕྱག་རྒྱ་དགུག་པའི་ནུས་པ་ཡོད་པས་ལྷའི་བུ་མོ་ལ་སོགས་པ་ལའང་གོམས་པར་བྱའོ།",
    "རབ་ཏུ་བྱེད་པ་དྲུག་གིས་བརྗོད་པར་བྱ་བའི་དོན།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་ཡན་ལག་གི་དོན་གཙོ་བོ་ཡིན།",
    "ཧེ་རུ་ཀ་གསུམ་བསྐྱེད་པའི་ཆོ་ག་བརྟག་པ་གཉིས་པའི་དང་པོའི་གསུམ་པར་ཐུན་མོང་གི་ཆོ་ག་ཕལ་ཆེར་ཆ་མཐུན་པ་ཡིན་ལ།",
    "ཕྱག་བཞི་བའི་འཁོར་གྱི་ལྷ་མོ་གོ་རཱི་ལ་སོགས་པ་ཉིད་ཡིན་ལ།",
    "བྷ་ག་ཉིད་དུ་ཞེས་པ་ལ་སོགས་པ་འཁོར་གྱི་ལྷ་མོ་དབྱུང་བ་དང་འབྲེལ་བ་ཞར་ལས་དཀྱིལ་འཁོར་འཁོར་ལོའི་ཐབས་ཀྱང་བསྟན་ཏོ།",
    "རྡོ་རྗེ་དྲག་མོ་ལ་སོགས་པ་ནང་གི་འཕར་མའི་ལྷ་མོ་བརྒྱད་ཀྱི་མིང་བསྟེན་ཏོ།",
    "ལས་རྒྱས་པའི་ལྷ་མོ་གསུམ་མངོན་རྟོགས་དམན་པ་ལ་མོས་པའི་རྟེན་གྱི་གང་ཟག་རྗེས་སུ་གཟུང་བའི་ཕྱིར་ཕྲིན་ལས་རབ་འབྱམས་དང་འབྲེལ།",
    "གཞུང་དེ་གསུམ་ཀར་དུ་ཡང་ལྷ་མོ་གསུམ་གྱི་སྒྲུབ་ཐབས་ཕན་ཚུན་ཁ་བསྐངས་པ་ཡིན་གསུང་ངོ།",
    "དེ་ལ་བརྟེན་ནས་མཆོག་གི་དངོས་སྒྲུབ་བསྒྲུབ་ཏུ་བཏུབ་པ་ཅིག་ཡིན་གསུང་ངོ།",
    "ཚིག་གི་དོན་ལ་ཡང་གང་གི་ཞེས་པ་ཧེ་རུ་ཀའོ།",
    "གཞལ་ཡས་ཁང་འོག་གི་བདག་མེད་མའི་སྐབས་ལ་ལྟོས་ནས་མ་གསུངས་སོ།",
    "རྡོ་རྗེ་སྟེ་དམ་ཚིག་གི་འཁོར་ལོ་ལ་དབབ་ཅེས་པ་གཞུག་པའོ།",
    "འཁོར་གྱི་ལྷ་མོ་མངལ་སྐྱེས།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་དཔའ་བོའི་ཉམས།",
    "ཕྱག་རྒྱ་དྲུག་གི་རྒྱན་རྣམས་མི་སྡུག་པའི་ཉམས།",
    "སྐྲ་སེར་པོ་གྱེན་དུ་བརྫེས་པ་དང་ཉི་མར་བཞུགས་ཤིང་རོལ་མོ་དང་བཅས་པ་འཇིགས་སུ་རུང་བའོ།",
    "གདན་ཐོག་ཏུ་ཕྱིན་པ་དང་ལྷ་མོར་བསྐྱེད་དེ་མཐར་བདག་ཉིད་གཙོ་མོ་ལ་བསྟིམ་མོ།",
    "ས་བོན་ཡང་གཙོ་མོའི་ཧཱུྃ།",
    "བར་དུ་རང་རང་གི་ས་བོན།",
    "ཐིག་ལེ་སྟེ་ཨྃ་གི་ཟླ་ཚེས་ཀྱི་སྟེང་དུ་ཐིག་ལེ་བྱེད་ལ།",
    "དེར་གཙོ་མོ་ཕྱག་གཉིས་མ་ལས་འདིར་ཕྱག་བཞི་མར་གསུངས་པ།",
    "ཕ་གིར་ཕྱག་མཚན་གྱི་དག་པ་སྟེ།",
    "སྟོང་པ་ཉིད་ཀྱི་ནམ་མཁར་རྃ་ལས་ཉི་མ་ལ་ཧཱུྃ་ལས་སྣ་ཚོགས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་བསམས་པ་ལས་འོད་འཕྲོས་པས་སྲུང་འཁོར་སྔར་བཞིན་བསྒོམ་མོ།",
    "གཡས་ན་དཀར་དང་ཞེས་པས་ལྷོ་ཕྱོགས་ཀྱི་གསང་བའི་དཀར་མོ་དངོས་སུ་བསྟན་ལ།",
    "ཤུགས་ལས་ལྷོ་ཤར་གྱི་ཤ་བ་རཱི་ཡང་དཀར་མོ་སྔོ་བ་ཞེས་པ་ཕྱིའི་འཕར་མའི་ཆོམ་རྐུན་མ་དངོས་སུ་བསྟན་ལ།",
    "ལྷོ་ནུབ་ཀྱི་ཙེཎྜཱ་ལཱི་ཡང་ཤུགས་ལས་སྔོན་མོར་བསྟན་ཏོ།",
    "ནུབ་བྱང་གི་གཡུང་མོའང་ཤུགས་ལས་མརྒད་ལྟ་བུར་བསྟན་ལ།",
    "ལྷ་མོ་བདུན་པོ་ནག་མོ་ཡིན་ནོ།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་སྔོན་བྱུང་གི་རྣམ་པར་འཕྲུལ་པ།",
    "དེར་རྣམ་སྣང་གིས་གཙོ་བྱས་པ་འདིར་རྡོ་རྗེ་སེམས་དཔའ་གཙོ་བོར་བྱས་པ་དང་།",
    "སྟོང་པའི་ངང་ལས་རྃ་ལས་ཉི་མ་ལ་ཧཱུྃ་ལས་སྣ་ཚོགས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ལས་འོད་འཕྲོས་པ་དང་།",
    "མངོན་བྱང་དང་པོ་གཉིས་ལ་རང་གི་ངོ་བོ།",
    "ཧཱུྃ་གི་སྔགས་འདིས་ཞེས་པ་ལ་སོགས་པས་བསྟན་ཏེ་བཀའ་གདམས་སུ་ཐམས་ཅད་མངོན་བྱང་ལྔས་བསྐྱེད་གསུངས་ལ།",
    "དེའི་ཐུགས་ཀར་ཡང་ཏིང་ངེ་འཛིན་སེམས་དཔའ་ས་བོན་སོ་སོར་བསམ་མོ།",
    "དེ་ཡང་གཞལ་ཡས་ཁང་བདག་གིས་བསྐྱེད་པ་དང་མདུན་གྱི་ཐ་མི་དད།",
    "དེར་ཡིག་འབྲུ་རེ་ལས་ལྷ་བསྐྱེད་པར་བྱའོ།",
    "དེ་ལྟར་ན་ལས་རྒྱས་པའི་ལྷ་མོ་གསུམ་བོར་ནས།",
    "ཌ་ལ་སོགས་པའི་ཡི་གེ་རེ་རེའི་བརྡ་ནི།",
    "ངག་གི་བརྡ་ཞེས་པས་ཡི་གེ་འདུས་པའི་བརྡ་ནི་བདེ་མཆོག་གི་ལེའུ་ཉི་ཤུ་རྩ་བཞི་དང་ཆ་མཐུན།",
    "ཡུལ་དེ་དག་གི་དུར་ཁྲོད་གང་དག་ན་ཤིང་དེ་དག་གནས་པ་མ་ཚང་བ་ཁ་བསྐང་།",
    "འདིར་དམ་པའི་བརྒྱུད་པའི་གདམས་ངག་གིས་གཙོ་བོར་སྤྱོད་པ་བྱེད་པའི་སྔོན་དུ་དྲོད་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཟླ་བ་ཕྱེད་དུ་ཉིན་མཚན་བྱེ་བྲག་མེད་པར་རང་བྱིན་བརླབ་བསྒོམས་ཏེ།",
    "མཚན་ཉིད་ནི་དེར་མཚོན་ཅིང་མངོན་དུ་བྱ་བའི་རང་བྱུང་གི་ཡེ་ཤེས་སོ།"
  ]
}