    "ལུས་ཀྱི་ཉམས་འགྱུར་དང་རྐང་བའི་སྟངས་སྟབས་གཙོ་བོར་བྱས་ཤིང་།",
    "ནམ་མཁའ་ཁྱབ་པར་གར་བྱེད་པ།",
    "རི་ཤོད་དུ་མཆོད་རྟེན་འབུམ་ཁང་བརྩིགས་ན་ཡུལ་ཁམས་བཀྲ་ཤིས་པར་ལུང་བསྟན་པ་ལྟར་བསྒྲུབས་པས་རྒྱ་བོད་གཉིས་ཀར་བཀྲ་ཤིས་དང་བདེ་སྐྱིད་བྱུང་ཚུལ་སོགས་བཀོད་པར་བལྟས་ན་གནའ་བོའི་དུས་སུ་བོད་དུ་དར་བ་ཞིག་ཡིན་པ་རྟོགས་སླ་ཞིང་།",
    "མིང་ཡང་ལ་རྫི་དང་ལབ་ཙེ་ཞེས་པ་སོ་སོ་ཡིན་ཡང་རིམ་བཞིན་སྐད་ཟུར་གྱིས་གཅིག་ཏུ་འདྲེས་པར་སྙམ་སྟེ།",
    "ཞེས་གསུངས་པ་ལྟར་ཡིན་ལ།",
    "འཕོ་སྦྱང་སོགས་ཀྱི་ཁྲིད་གནང་།",
    "རྡོར་སེམས་དང་ཞི་ཁྲོ་སོགས་ཀྱི་ལུང་གནང་།",
    "གསང་སྔགས་དར་རྒྱས་གླིང་ལ་རབ་གནས་ལེགས་པར་གནང་།",
    "སྤྱི་ལོ་༡༩༩༧ལོར་ཨ་ལགས་ཁ་སོ་བློ་བཟང་འཇིགས་མེད་འཕྲིན་ལས་ཚང་གདན་ཞུས་ཀྱིས་འདུ་ཁང་ལ་རབ་གནས་དང་།",
    "ཆོ་ག་ཕྱག་ལེན་དང་སྒྲུབ་འཕྲིན་ཕྱག་བཞེས་ཀྱི་ངོས་གཙང་བ།",
    "འདི་ལ་དདད་ཞེན་ཆེ་བའི་གྱི་མི་སྣ་འགའ་ཤས་ཀྱིས་སྐབས་དེར་རང་སྲོག་ལ་མ་འཛེམ་པར་གནའ་རྫས་སྐུ་གསུང་ཐུགས་རྟེན་ལ་བདག་གཉེར་དང་དོ་དམ་གནང་མཁན་འགའ་ངོ་སྤྲོད་ཙམ་བགྱི་བ་ལ།",
    "རྡོར་སེམས་ས་ལུང་ཐབཅས་ཀྱི་པར་ཤིང་སོགས་ཉར་ཚགས་བྱས།",
    "ཚེ་དང་སྒྲུབ་པ་སྙོམས་པར་བྱས་ནས་དགུང་ལོ་གྱ་ལྔ་བ་རབ་བྱུང་གསུམ་པའི་མེ་རྟ་སྤྱི་ལོ་༡༡༨༦ལོར་ལྟས་སྣ་ཚོགས་དང་བཅས་ཏེ་སྐུ་མྱ་ངན་ལས་འདས།",
    "དགུང་ལོ་དྲུག་པར་ཡི་གེ་འབྲི་ཀློག་ལ་སྦྱངས་པའི་འགོ་བཙུགས་ཏེ་བཅུ་གཅིག་པར་རོང་བོ་བཀའ་གདམས་དགོན་ཆེན་དུ་ཚོགས་ཞུགས་གནང་།",
    "ཕྱིས་སུ་དབུས་གཙང་གཉིས་པ་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་དུ་ཕེབས་ནས་དཀོན་ལེའུ་གཉིས་པ།",
    "བསྟན་འཛིན་གྱི་སྐྱེས་བུ་དམ་པའི་རིགས་རྟགས་མཚན་དང་ངེས་པར་ལྡན་པ་སྔགས་འཆང་རྡོ་རྗེ་འཛིན་པ་ཆེན་པོ་བཀྲ་ཤིས་དཔལ་ལྡན་འཇིགས་མེད་དོན་གྲུབ་འཕྲིན་ལས་དཔལ་འབར་འདི་ཉིད་གོང་མ་གནམ་གྱི་ལྷ་མཆོད་ཡོན་དང་།",
    "ཁྱད་པར་དུ་སྙན་བརྒྱུད་ཀྱི་མན་ངག་ཐམས་ཅད་བུམ་པ་གང་བྱོའི་ཚུལ་དུ་རྫོགས་པར་བླངས།",
    "དུད་ཚང་སོགས་ལ་གནང་སྦྱིན་ཁོ་ན་མཛད།",
    "གཞན་ཡང་མགོན་ཤུལ་དང་ཧོར་གཙང་།",
    "ཀུན་བཟང་ཞལ་ལུང་ལ་སོགས་པའི་ལྗགས་ཁྲིད་ཡང་གནང་།",
    "ཞོ་འོང་གཉན་རྒྱ་ནས་ཞབས་དཀར་བའི་འཁྲུངས་ཡུལ་ལ་རྗེས་དྲན་མཆོད་རྟེན་གསར་བཞེངས་ཀྱི་སྐབས་ནང་བཞུགས་སྲོག་ཤིང་འཛུགས་པའི་དུས་སུ་ནམ་མཁའ་ནས་འཇའ་འོད་ཀྱི་གུར་ཕུབ་ཅིང་།",
    "དགུང་ལོ་བརྒྱད་ཅུར་བཞེས་པའི་གྱ་སྟོན་གྱི་མཛད་སྒོ་རྒྱ་ཆེར་སྤེལ་ནས་ཞབས་པད་བརྟན་བཞུགས་ཀྱི་གསོལ་བ་རྩེ་གཅིག་ཏུ་བཏབ་པས།",
    "རྗེ་ཉིད་ཀྱིས་ཀྱང་སྐུ་ཚེ་ཡུན་རིང་འཚོ་བར་ཞལ་གྱིས་བཞེས་ཏེ་བསྙུན་ཚུལ་གྱི་རྣམ་པ་རིང་དུ་དོར།",
    "རྗེ་འདི་ཉིད་ལ་ཞབས་པད་རྟག་པར་བརྟན་རྒྱུའི་ཐུགས་འདུན་བཏོན།",
    "ལོ་དེར་སླར་ཡང་སྐུ་ལ་བསྙུན་བཞེས་ཀྱི་ཚུལ་བསྟན་པ་ན་ཀུན་གྱིས་ཞབས་བརྟན་ལ་སོགས་པ་སྔར་བཞིན་གསོལ་བས།",
    "ཞབས་དཀར་སྐུ་སྐྱེས་ངོས་འཛིན་མ་བྱས་ན་ཁོ་བོའི་བྱ་བའི་མཇུག་མ་བསྒྲིལ་གསུངས་ནས་ལོ་ཁར་ཟླ་བརྩེགས་ཀྱི་དུས་ཡུན་རིང་བོ་འདས་པ་ན།",
    "གླིང་རྒྱ་བཅས་ཀྱི་སྔགས་འཆང་རྣམས་ལ་སྙན་བརྒྱུད་གདམས་པ་གཅིག་ཤེས་ཀུན་གྲོལ་དང་སེམས་ཁྲིད་ཡིད་བཞིན་ནོར་བུ་སོགས་ཀྱི་གདམས་པ་མན་ངག་དང་བཅས་པའི་རིག་པ་ངོ་སྤྲད་དེ་རྣལ་མའི་དོན་ལ་སེམས་པའི་གྲོལ་བྱེད་ཁྲིད་ཀྱི་ཐུགས་རྗེས་བཀའ་དྲིན་ལེགས་པར་བསྐྱངས།",
    "དེས་ན་ལུང་ཚིག་སྔ་མའི་ནང་དུ་སྐབས་དེར་ཞེས་པ་ལ་གོ་རྒྱུ་ཆེན་པོ་ཡོད་པས་ཡབ་ཡུམ་འདི་གཉིས་ལ་སྲས་མིང་སྲིང་གསུམ་ཡོད་པར་འདོད་དོ།",
    "དགུང་ལོ་བཅོ་བརྒྱད་པར་ཡབ་ཆེན་གྱི་ཁུར་བླངས་ཏེ་དཔོན་སར་བཞུགས་པར་བཤད།",
    "དགུང་ལོ་བཅོ་བརྒྱད་པར་འཇམ་བཟའ་མཁའ་འགྲོ་སྐྱིད་ཆུང་མར་བསུས།",
    "དགུང་ལོ་དྲུག་ཅུ་བ་ལ་ཁོང་ཉིད་དབུས་གཙང་དག་པའི་ཞིང་དུ་ཆིབས་ཁ་བསྒྱུར།",
    "གཏན་ནས་མ་འཁྲུངས་པར་བཞེད་པ་ནི་ནོར་བ་ཆེན་པོའོ།",
    "དགུང་ལོ་སོ་དྲུག་སྟེང་མེས་པོ་དམ་པ་དགའ་རབ་རྡོ་རྗེ་སྐུ་གཤེགས་པའི་གདུང་རུས་དབུས་གཙང་དུ་ཁྱེར།",
    "བར་སྣང་ན་སྤྲིན་མེད་པར་འབྲུག་སྒྲ་འུར་འུར་དུ་གྲགས་པ་དང་སྦྲང་ཆར་ཟིལ་མ་ཤག་ཤག་ཏུ་བབས་པ་དང་ལྷན་དུ་འཁྲུངས།",
    "བློ་མྱུར་ཞིང་ཡ་རབས་སྤྱོད་བཟང་དང་ལྡན་པ་ཞིག་ཡིན་པར་མ་ཟད།"
  ]
}