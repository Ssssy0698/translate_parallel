    "མཐའ་འཁོར་དུ་མིའི་རྐང་རྗེས་མང་པོ་ཕབ་འདུག་ཐོག་མར་ཁོ་ཚོས་རྐང་རྗེས་དེ་དག་གང་ལ་འཐེན་ཡོད་པར་བལྟས་པ་དང་།",
    "ང་རང་ཁྱེད་ཅག་དང་ཁ་བྲལ་ཏེ་དབྱར་དགུན་གསུམ་ལྷག་འགོར་ཡང་།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "དེ་དག་དུས་རིམ་གྱིས་གསུངས་སམ་ཅིག་ཅར་གསུངས་སྙམ་ན།",
    "དེ་བསྒྲུབས་པས་མ་འགྲུབ་ནས་ཆུ་འགྲམ་ཞིག་ན་ངུ་ཞིང་འདུག་པ་དང་།",
    "དེ་མ་ཤི་བར་འདུག་པ་དང་དེ་དེ་བཞིན་དུ་བསྐོས་པས་གོ་པཱ་ལ་ཞེས་བྱ་བའི་རྒྱལ་པོར་གྱུར་ཏོ།",
    "དབེན་པར་འདུག་སྟེ་མི་ཕམ་པ་མཉེས་པར་བྱས་པས་དེ་གྲུབ་ནས་དེ་ལས་གདམས་པ་ཐོབ་ནས།",
    "སྤྲུལ་པའི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་རྒྱུད་ལ་སྐྱེས་པ་ཡིན་ནོ་ཟེར་ན།",
    "ཀུན་ཤེས་པ་ཐོབ་ནས་ཉན་ཐོས་དང་རང་རྒྱལ་དུ་མ་གྱུར་པ་ནི་མི་སྲིད་དོ།",
    "རྣལ་འབྱོར་ཅན་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་ལོ།",
    "འོ་ན་ཐམས་ཅད་ཤེས་པ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི།",
    "འོ་ན་ཐམས་ཅད་ཤེས་པ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ཡིན་ལ།",
    "ཐམས་ཅད་ཤེས་པ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་ལ་གཙོ་ཆེ་སྟེ།",
    "དེས་ནི་ཕྱི་རོལ་པ་དང་ཉན་ཐོས་དང་རང་རྒྱལ་ལས་ཁྱད་པར་དུ་གྲུབ་པའོ།",
    "དེ་ཉིད་རྟོག་པ་ཡིན་པས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་སྤོང་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཚེ་དེ་ལ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་སེམས་སྤངས་པ་དང་།",
    "དེ་གཉིས་ཀྱི་དོན་ནི་གཉེན་པོའི་དེ་ཤེས་པ་ཉན་ཐོས་རང་རྒྱལ་གྱི་དེ་ཤེས་པ་ལས་བཟློག་པ་དངོས་སུ་བསྟན་པས་བཟློག་པས་སྒོ་ནས་ཉན་ཐོསདང་རང་རྒྱལ་གྱི་དེ་གཙོ་བོར་བསྟན་པ་ཡིན་ནོ་བྱ་བ་དང་།",
    "འོ་ན་དེ་ལ་མི་གནས་པས་ཉན་ཐོས་དང་རང་རྒྱལ་བཞིན་དུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་རོ་སྙམ་ན།",
    "དེ་ལས་བཟློག་པས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་ཤེས་པའི་ངོ་བོ་ནི་ཤེས་རབ་ཆེན་པོ་དང་བྲལ་བས།",
    "དེ་ཉིད་མི་རིགས་ཏེ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་རྒྱུད་ལ་སྐྱེས་པའི་དེ་ཤེས་པ་དང་།",
    "དེ་ཡང་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་ནི་མི་མཐུན་པའི་དྲི་མ་དང་འདྲེས་པས་དེར་བཞག་གོ་ཞེས་སོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ནི་དངོས་སུ་མ་གསུངས་སོ་འདིར་དོན་གྱིས་འཕངས་པ་ལ་དགོངས་ནས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་སྨོས་པ་ཡིན་ནོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ངེས་འབྱེད་ནི་ལམ་ཤེས་སུ་བསྟན་པའམ།",
    "དེ་ཡང་རང་བཞིན་གྱི་ལྔ་དང་།",
    "གཉིས་པ་ནི་ལས་དང་པོ་པ་ཞིག་སྔར་གྱི་སྦྱོར་བ་དེ་ལྟ་བུ་གཅིག་བསྒོམ་ན་གནས་སྐབས་དེ་ཙ་ན་ཚེགས་ཆེན་ཡུན་རིང་རྟོགས་པ་ཞེས་བརྗོད་པ་ནས།",
    "བཞི་པ་ཡུལ་ཅནནི་ཉན་ཐོས་དང་རང་རྒྱལ་དང་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་ལས་དག་པརྣམས་ཀྱི་ཡུལ་དུ་གྱུར་པའོ།",
    "དོན་བརྗོད་པར་མི་འདུག་པས་ཞར་ཙམ་ལ་ཡིན་ནོ།",
    "ང་རང་ཚེགས་ཆུང་ངུས་འབྲས་བུ་ཐོབ་པའི་ཉན་ཐོས་རང་རྒྱལ་གྱི་དེ་སྒྲུབ་སྙམ་ནས་ལམ་གཞན་དུ་འགྲོ་འདོད་པ་ལ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ནི་རྟོག་པ་མི་སྤོང་བས་དེ་ལ་དེ་ལྡན་པ་དང་།",
    "དེ་ཡང་རང་བཞིན་མེད་པར་རྟོགས་པའི་རྟོག་པ་ཡིན་པས་ཉན་ཐོས་དང་རང་རྒྱལ་ལ་དེ་ལྟ་བུའི་རྟོག་པ་མེད་པས་ཁྱད་པར་དུ་གྲུབ་པ་ཡིན་ནོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ལ་གཟུང་འཛིན་རང་བཞིན་མེད་པ་གཏན་མི་སྣང་བས་མི་གསལ་བར་སྣང་བ་ཞེས་པའི་ཁྱད་པར་དེ་མི་སྲིད་དོ།",
    "གཟུགས་ལ་སོགསཔ་བཏགས་ཤིང་བློས་བཞག་པ་ཙམ་ཡིན་གྱི་དེ་ཁོ་ནར་མ་གྲུབ་བྱ་བ་ཡིན་ཡང་སྲིད་པར་འདུགགོ།",
    "འོན་ཀྱང་དེ་ན་སྒྲོ་འདོགས་གསར་དུ་གཅོད་པར་འདོད་པར་འདུག་སྟེ་དེའི་གཅོད་བྱེད་བརྟགས་པ་ན་རྙེད་པར་དཀའོ།",
    "འོག་མ་དག་ལ་ཡང་ཞེས་པ་ནི་ལམ་ཤེས་ཀྱི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ངེས་འབྱེད་ཀྱི་རྣམ་པ་ལ་སོགས་པའོ།",
    "ས་བཅུའི་སྟོང་པ་ཉིད་ཐམས་ཅད་རྟོགས་པའི་ཡེ་ཤེས་ཉན་ཐོས་དང་རང་རྒྱལ་ཐམས་ཅད་ལས་ཁྱད་པར་དུ་གྱུར་པའོ།",
    "དེ་ཡང་གཞན་དོན་འབའ་ཞིག་ནི་མ་ཡིན་གྱི་གཞན་དོན་ཀྱང་ཡིན་ཏེ་དེ་དང་རང་དོན་ཐམས་ཅད་ཀྱི་རྟེན་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་དང་པོ་ནི་དབྱིངས་ཀྱི་དོན་དུ་འདུག་གོ།",
    "ཆེན་པོ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ལས་ཁྱད་པར་དུ་འཕགས་པའོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ལ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཀུན་ཏུ་བཏགས་པའི་རིགས་ཡིན་ཞེས་པའི་དོན་ནི་ད་ལྟ་གྲོགས་པོ་ངན་པ་ལ་སོགས་པའི་སྟོབས་ཀྱིས་འཕྲལ་དུ་བཏགས་པ་ཁོ་ནའི་ངེས་པ་མེད་ཀྱི་དེའི་དང་པོའི་རྒྱུའི་རྩ་བ་དེ་ལྟ་བུར་འདུག་པའོ།",
    "གྱ་གྱུ་མེད་པའི་སེམས་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ཡིད་ལ་བྱེད་པ་སྤངས་པའོ།",
    "འདོད་པར་འདུག་གོ།",
    "འདིའི་འབྲས་བུ་དང་རང་བཞིན་རྒྱུ་གསུམ་ཤེས་པར་བྱར་ཡོད་པ་ལས།",
    "སྔ་མ་བཞིན་དུ་ཞེས་པ་ནི་རང་རང་ངོ་བོས་སྟོང་པ་ཞེས་པ་ཡིན་ལ།",
    "འབུམ་པ་ལྟར་ན་གཟུང་བ་རང་བཞིན་མེད་པ་ཤེས་པའི་ངེས་འབྱེད་ཡིན་པས་འདི་ཡང་རང་རྒྱུད་པའི་དེ་བསྟན་པ་ཡིན་སྐད་དོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་མཐོང་ལམ་རྟོག་པ་དང་བཅས་པ་ཡིན་ན།",
    "རང་རང་གཞན་གྱི་ལམ་དམིགས་འདོད།",
    "དེའི་ནང་ན་འདུག་པའམ།",
    "དེའི་རྩ་བ་ན་འདུག་པའི་དུད་འགྲོའི་སྐྱེ་གནས་སུ་གཏོགས་པ་ཡན་ཆད་ལ་ཡང་འཚེ་བའམ་ཐོ་འཚམ་པར་མི་ནུས་ཏེ།",
    "དེ་བཞིན་དུ་སྔར་གྱི་ས་ཕྱོགས་ན་འདུག་པ་ལ་ཡང་འཚེ་བ་ལ་སོགས་པ་མི་ནུས་ཏེ།",
    "དེས་ཐོབ་པའི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དག་པ་ནི་ཤིན་ཏུ་བ་ལས་གཅིག་ཤོས་སུ་བཞག་གོ།",
    "འབྲོམ་གྱིས་སྔར་བསྟན་པའི་རྒོལ་བའི་ལན་དུ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་རྣམ་དག་ཅིག་ཤོས་སུ་བྱེད་པ་དང་།",
    "དེ་ལྟ་ན་གཞི་ཐམས་ཅད་ཤེས་པའི་ཤེས་པ་མེད་ན་ཞེས་རིགས་པ་ལས་དེ་ལྟར་མི་འདུག་པ་དང་།",
    "དེ་ཡང་གཉེན་པོའི་དེ་ཤེས་པ་དངོས་སུ་བསྟན་པས་ཟློག་པའི་སྒོ་ནས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་ཤེས་པའི་ངོ་བོ་སྟོན་པ་ཡིན་པས།",
    "ས་བདུན་པ་མན་ཆད་ན་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་སྤང་དུ་ཡོད་པས་དེའི་སྦྱོར་བ་དེ་ན་ཡོད་དོ།",
    "ཟློག་པའི་སྒོ་ནས་བསྟན་པས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་ནི་དངོས་པོར་དམིགས་པའི་སྒོ་ནས་སྦྱོར་བ་ཡིན་ལ།",
    "དེ་སྐྱེད་པའི་ཡན་ལག་སྦྱོར་བ་དང་རྣམ་པ་གཉིས་ཀྱིས་དངོས་སུ་བསྟན་པས་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་དེ་ཟློག་པའི་སྒོ་ནས་གོ་བར་བྱས་ནས།",
    "གལ་ཏེ་འདུག་པའི་དུས་ལ་ཀཱ་བྱས་པས་མ་བྱས་པ་བྱེད་པར་གྱུར་པ་དང་།",
    "ལས་དང་རང་བཞིན་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "ཡུལ་ངེས་པའི་ཕྱིར་ཡུལ་དག་དང་རང་བཞིན་ཐ་དད་པ་དང་།",
    "དེ་ལས་མིག་དེ་དང་ཐ་མི་དད་པར་འདུག་པའི་ངང་ཚུལ་ཡོད་པས་ཐ་མི་དད་པར་འདུག་པའོ།",
    "རྒྱུན་ཆགས་པར་འདུག་པ་མ་ཡིན་པའི་ཕྱིར་གཟུགས་ལ་སོགས་པ་རྣམས་དང་ལྷན་ཅིག་རྒྱུན་ཆགས་སུ་གནས་པ་མ་ཡིན་ཏེ།",
    "ཆ་ཤས་དང་བཅས་པ་ཉིད་ཀྱི་ཉེས་པ་སོ་ན་འདུག་པ་ཉིད་དོ།",
    "དུས་གཞན་གྱི་བར་དུ་འདུག་པའི་ཞེས་བྱ་བ་ལ།",
    "གནས་པའི་ངང་ཚུལ་ཅན་ནི་འདུག་པ་སྟེ།",
    "འདི་དག་ནི་སོ་སོའི་སྐྱེ་བོའོ་ཞེས་བྱ་བའི་རྣམ་པར་གཞག་པ་མེད་པ་སོ་ན་འདུག་གོ།",
    "ཉན་ཐོས་ལ་སོགས་པ་རྣམས་འཕགས་པ་མ་ཡིན་པ་ཉིད་ཀྱི་ཉེས་པ་ནི་འདི་ན་ཡང་སོ་ན་འདུག་པ་ཉིད་དོ།",
    "སྤྱོད་པ་དང་རང་བཞིན་མཚུངས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མིའི་སྐལ་བ་མཉམ་པ་ཉིད་དེ་སོ་ན་འདུག་པའི་ཕྱིར་རོ།",
    "མངལ་ན་འདུག་པ་ནུར་ནུར་པོ་དང་།",
    "རྐང་ལག་འགྱུས་པའི་གནས་སྐབས་ན་འདུག་པ་དང་།",
    "སྒོ་ང་ན་འདུག་པ་རྣམས་ལ་བདག་ཉིད་འཆི་བ་མེད་པའི་ཕྱིར་རོ།",
    "སེམས་ཀྱི་རྗེས་འཇུག་དུས་དང་ནི།",
    "རྣམ་པར་སྨིན་པ་དག་དུས་ཡོངས་སུ་ཆད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཟུགས་ཅན་རྣམས་ལ་འགྲོ་བ་དང་འདུག་པ་ལ་སོགས་པ་ཡོད་པའི་ཕྱིར་སྤྱོད་ལམ་པ་ཡོད་དོ།",
    "གཞན་དག་ནི་མདུན་ན་འདོན་ལྟ་བུར་འདུག་པས་མདུན་ན་འདོན་ཏེ་ཞེས་འདོན་ཏོ།",
    "༦༨ ༣འདུག་པ་ལ་གྲིབ་མ་སྣང་ན།",
    "འདི་ལྟར་གལ་ཏེ་རལ་གྲི་བསགས་ིཀར་བསྙལ་ཏེ་འདུག་པ་ཡིན་ན་ནི་གཟུགས་བརྙན་ཡང་བསགས་ཀར་རིང་བར་སྣང་ལ།",
    "གལ་ཏེ་གྱེན་ལ་བསྒྲེང་སྟེ་འདུག་པ་ཡིན་ན་ནི་གཟུགས་བརྙན་ཡང་དེ་ལྟར་སྣང་ངོ།",
    "དུས་གཞན་གྱི་བར་དུ་གསོན་པོར་འདུག་ནས་ནི་མ་ཡིན་ཏེ།",
    "གང་ཞིག་དུས་དང་སྐྱེ་བ་ངེས་པས་ཡུལ་མ་ངེས་པར་འཕེན་པ་དེ་ནི་དེ་ལས་གཞན་པའི་ཡུལ་དང་སྐྱེ་བ་དེར་སྐྱེའོ།",
    "འདི་ལྟར་འཛམ་བུའི་ཚལ་ན་འདུག་པ་མ་གཏོགས་པའི་ཕྱི་རོལ་པ་རྣམས་ལས་ཞེས་བྱ་བ་རྒྱས་པར་འབྱུང་ངོ།",
    "འོ་མ་བསྐོལ་མ་སྤྲིས་མ་ཆགས་པ་ཞེས་བྱ་བ་ནི་ཞུ་བ་དང་འཐས་པའི་ངོ་བོར་འདུག་པའི་ཕྱིར་རོ།",
    "རྣམ་ཕྱེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཕྱེ་ནས་འདུག་པའོ།",
    "པེ་སྣར་འདུགས།",
    "པེ་སྣར་འདུག་༤༥༣ པེ་སྣར་འདི།",
    "གང་ན་བྱ་རོག་འདུག་པའོ་ཞེས་སྨྲ་སྟེ།",
    "གཟེགས་གཟན་ལ་སོགས་པའི་མུ་སྟེགས་བྱེད་ཁ་ཅིག་དུས་རྟག་པ་དང་།",
    "ཚད་དེ་ཉིད་རྫས་དང་དུས་དང་རང་བཞིན་དང་ལུས་ཀྱི་གནས་སྐབས་ལ་ལྟོས་ནས་མྱོས་པར་འགྱུར་བ་ཡང་ཡིན་ལ།",
    "དངོས་ལྟར་སྦྱོར་བ་དང་མཇུག་དང་རང་བཞིན་གྱིས་ཁ་ན་མ་ཐོ་བ་ལྟར་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་དག་ལས་ཀྱང་འཐོབ་ལ།",
    "སྦྲུམ་མའི་གན་དུ་འགྲོ་ན་དེའི་ལྟོ་ན་འདུག་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "དེར་རྒྱུ་དང་འབྲས་བུ་དག་དུས་སྔ་ཕྱིར་ངེས་པའི་ཕྱིར་རོ།",
    "ཐ་མལ་པའི་ཚེ་ནི་ཐ་མལ་པར་འདུག་པའོ།",
    "ཤིང་དྲུང་ན་འདུག་ཀྱང་རུང་།",
    "ཁང་སྟོང་ན་འདུག་ཀྱང་རུང་།",
    "བདག་འདི་ཇི་སྲིད་གསོན་ཞིང་འདུག་ལ།",
    "འདི་སྙམ་དུ་དེར་མེད་དོ་སྙམ་པའི་བློ་ནི་ད་ལྟར་བ་དེ་མེད་དོ་སྙམ་པ་དེ་ལྟར་འདུག་གོ་སྙམ་ན་དེའི་ཕྱིར་མ་ཡིན་ཏེ།",
    "ད་ལྟར་བར་བྱས་པས་འདི་ལ་ཁྱད་པར་ཡོད་པ་མ་ཡིན་པས་ལས་ཀྱི་ནུས་པ་མེད་པས་སོ་ན་འདུག་པ་ཉིད་དོ་། གལ་ཏེ་སྐྱེ་མཆེད་བཅུ་གཉིས་ཡོད་ཀྱི།",
    "གནས་པར་གྱུར་པའི་ཞེས་བྱ་བ་ནི་ནང་དུ་ཡང་དག་འཇོག་པར་འདུག་པའམ་འཆག་པའི་འོ།",
