    "དེ་ལྟར་ཡིན་པ་ལ་གཉེན་པོ་སྐྱེ་ལ་རྐྱེན་ངན་བྱུང་ཙ་ན་གཉེན་པོ་དྲན་པ།",
    "བརྩོན་འགྲུས་ཆེ་ན་འདི་ལ་སྤྲོ་བ་ཅི་འདུག་བལྟ།",
    "འདི་ཙམ་གྱིས་མི་ཡོང་རང་ལ་ཕྱར་ཀ་གཏོང་བ་ལ་སོགས་པ་ལ་བཀའ་དྲིན་ཆེ།",
    "དཔེར་ན་ནམ་མ་ལངས་པར་ཤིང་འཐུ་རུ་འགྲོ་སྙམ་ཙ་ན་གཉིད་སྔར་སད་ནས་ཡོང་བ་དང་འདྲ།",
    "གྲོགས་པོས་ཀྱང་བློ་རྩ་བླངས་ཙ་ན་བཏུབ་པར་ཡོང་སྟེ།",
    "དེ་ཙ་ན་ལི་སྒོམ་གཞོན་ནུ་གྲགས་གསུངས་པའི་ང་དང་ལ་གཉིས་ཀྱིས་སྡུག་ཏུ་བཅུག་གསུང་བ་བཞིན་དུ་འགྲོ།",
    "སོ་སོ་སྐྱེ་བོ་ཡིད་མི་བདེ་བའི་རང་བཞིན་དུ་འདུག་པ་ཡིན།",
    "གཉིས་པ་གཅིག་ཏུ་འདུག་པའི་བྲང་གྲོགས་པོ་འདུ་ཚོགས་སྟབས་སུ་བྱེད་ཅིང་།",
    "གསུམ་པ་རང་དང་འགྲན་ངེས་སུ་འདུག་པ་སྟེ།",
    "ཞེས་བྱ་བ་འདི་ལྟ་བུ་ཉམས་སུ་བླངས་པར་མི་ནུས་པར་འདུག་སྙམ་ན།",
    "འབྱོར་ཙ་ན་ངའི་གོང་ན་མི་མེད།",
    "ཁ་ཅིག་འབྱོར་ཙ་ན་བཏུབ་པ་ལ།",
    "རྒུད་ཙ་ན་ཁྱེད་རང་ཉམས་ལ་མ་བབས་པ་ཡིན།",
    "སྨད་ར་བཏང་ཙ་ན་མི་བཟོད་པ་འདི་ལ་དུག་གཅིག་བཏང་རྒྱུ་ལ་སྙམ་པ་ཡོང་།",
    "ཕྱི་ནང་སྣོད་བཅུད་རང་གཞན་གྱི་རྟེན་ལ་ཆགས་ཞེན་བཏང་ནས་ལོག་ཙ་ན་ཡིན་ཏེ།",
    "དེ་ཡང་དབུགས་འགྲོ་ཙ་ན་གང་དུ་སྐྱེ་བའི་ལུས་གཅིག་བྱུང་བ་སྙམ་བྱེད་པ་ལས་ཤེས་པ་འཕོ།",
    "ཤུལ་ན་འདུག་པས་ངུས་ཙ་ན་ཤི་སྙམ་པའི་འདུ་ཤེས་སྐྱེ།",
    "གཞན་གྱི་གྱོད་ལ་སོགས་པ་བྱུང་ཙ་ན་མད་མད་ལགས།",
    "འདིའང་ལུས་ངག་ཇི་ལྟར་འདུག་ནའང་འདུག་སེམས་ཁོ་ན་ལ་བལྟ་བ་ཡིན།",
    "འདི་མེད་ན་བསྒོམ་བཟང་ཟེར་བ་ཐམས་ཅད་འདོམ་ཐུག་བྱུང་ཙ་ན།",
    "འདི་རྒྱུད་ལ་ལན་ཅིག་དྲན་པའམ་བསྒོམ་ཙ་ན།",
    "ཚིག་ངན་བསྣུན་པ་ལ་སོགས་པ་ཅི་བྱས་ཀྱང་རང་ལ་གྱོད་གདའ།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "ཇ་སུན་མཐོ་དམན་དང་འདུག་ས་ལེགས་ཉེས་ལ་ཀོ་ལོང་མི་བསྡམ།",
    "ལན་བྱེད་པ་མ་བྱུང་ན་ངས་དཀའ་སླ་སྐྱིད་སྡུག་དེ་ཙམ་བྱས་ཀྱང་འོར་ཆེན་ཙམ་ཡང་ཁ་ནས་མི་ཐོན་པ་འདུག་མི་ལ་བྱས་མ་བྱས་མེད་ཟེར་བ་ལྟ་བུ་བསམ་དུ་མི་རུང་།",
    "འདི་ཡོད་རིང་ལ་དེ་གཉིས་ཡོད་མི་སྲིད་པས་ཡང་རང་ལ་གཞན་གྱིས་ངན་བྱས་པས་ངན་ལན་མ་གྲུབ་པ་ཞེ་ལ་བཅངས་ནས་གྲུབ་ཙ་ན་བྱེད་པ་སྟེ།",
    "འདོད་པ་སྤྱི་སོ་ན་འདུག་པ་ལ་རྩེ་གཏོད་པ་འདི་ངན་པ་ཁོ་ན་ལ་ཡོད་པའི་ངེས་པ་མེད།",
    "ཕྱིས་ངས་དེ་ཙ་ན་བྱས་ཏེ་མ་བཏུབ་པས།",
    "སྔོན་རྒྱ་སྟོན་བྱིས་པ་ཙ་ན་གཞན་གྱི་རྟ་དཀྲོགས་ནས་བྲག་ལ་མཆོངས་ནས་བསད་པས།",
    "དེ་ཐམས་ཅད་ནོར་ཟེར་བར་གདའ།",
    "དེ་ལ་ཡང་རང་དོན་དང་མ་འདྲེས་པ་གཅིག་དགོས་པས།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "བདག་ལ་ཆུས་བྱེད་ཅིང་རང་ལ་ཐིམ།",
    "བདུད་བགེགས་ལོག་པའངྒེནཔ་ཐམས་ཅད་ཟིལ་གྱིས་མནན་པས་བག་ཁུམས་ཏེ་འདུག་ལ།",
    "ཐོད་རློན་གྱི་དོ་ཤལ་པ་ཕྱག་འདུག་ཞབས་གདུབ་ལ་སོགས་པ་དང་ལྡན་པ།",
    "བག་མ་ཞུང་འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "གོ་རོ་ཙ་ནའི་མར་ཁུས་གཏམས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་སྦྱར།",
    "གོལ་སའི་གཡང་རང་གཞན་ཅིག་ཅེས་པ་བཞིར་སྐབས་ཀྱི་ཚིགས་སུ་བཅད་པའོ།",
    "མི་ཡི་བཞིན་དབྱིབས་རང་རང་གླིང་དང་འདྲ།",
    "ལྷ་གནས་བཞི་པོ་མཚོ་ནས་རང་རང་བར།",
    "འདོད་གཟུགས་ཀུན་ནའང་རང་རང་རྒྱལ་པོ་གནས།",
    "སླར་ཡང་རངས་བྱེད་བུ་ནི་ལྷག་སྤྱོད་ཀྱི།",
    "རང་རང་ལོ་འདབ་མེ་ཏོག་འབྲས་བུ་རྒྱས།",
    "བུར་ཤིང་ལ་སོགས་རང་རང་བཅུད་རྣམས་འཛག།",
    "འདི་རུ་འདུག་ནས་འཚང་རྒྱ་ཞེས་དགོངས་ཚེ།",
    "འཁོར་ཀུན་གྱིས་ཀྱང་རང་རང་ལས་ཀུན་བཤད།",
    "ཅིག་ཅར་ཉིད་དུ་རང་རང་སྐལ་བ་ལྟར།",
    "འགོག་སྙོམས་ལས་ལངས་ཞི་བར་འདུག་པ་ལ།",
    "སྐྱོ་སྟེ་རང་རང་ཁྲི་ལས་བབས་སྟེ་འཁོད།",
    "ཅེས་སྨྲས་སེང་གེའི་ཁྲི་ལས་བབ་སྟེ་འདུག།",
    "གསེར་གྱི་རི་བོ་ལྟ་བུར་ལྷང་ངེ་འདུག།",
    "ཕུང་པོ་རྣམས་ནི་བརྟན་པར་འདུག།",
    "རང་རང་ཡུལ་དུ་སོ་སོའི་སྐད་རྣམས་ཀྱིས།",
    "ཁ་དོག་སྣ་ཚོགས་འཇའ་འོད་ལྟ་བུར་འདུག།",
    "གང་ཟག་ཟླ་མེད་གཅིག་ནི་སྐྱེས་པར་འདུག།",
    "གོས་མཆོག་གྱོན་ཏེ་སྟན་མཆོག་ལ་འདུག་པ།",
    "ཅི་ཡང་མ་ཉེས་ཟིལ་པ་ཕྲོམ་མེ་འདུག།",
    "ནོར་རྫས་ཆུར་ཤོར་རང་རང་རྐྱལ་ཏེ་ཐར།",
    "བཟང་ངན་མེད་པར་ཆུ་སྟེང་མཉམ་པར་འདུག།",
    "དེ་ཡི་བློན་པོ་བྲམ་ཟེ་ཙ་ན་ཀས།",
    "བ་ལང་རྫི་བོ་ཞིག་ལ་གནས་བཅས་འདུག།",
    "སྡོང་པོ་ཞིག་ནི་འདུག་པ་ལ།",
    "ཅུང་ཟད་སེམས་ཤིང་འདུག་པ་ལས།",
    "སྒྲིབ་སེལ་དགའ་ཞིང་རངས་པ་ཡིས།",
    "རྒྱལ་ཁམས་བདེ་བ་བློན་པོས་བྱས་ཟེར་བ་འདུག་པ་དེ་མ་ཡིན།",
    "བོད་ཀྱི་རྒྱལ་པོ་དེ་དད་པ་ཅན་ཞིག་ཡོད་པར་འདུག་ཀྱང་།",
    "རང་རང་ཕྱོགས་ནས་གཤེགས་མཐོང་བསུ་ཞིང་སྐྱེལ།",
    "མཚལ་གྱི་གཡུང་དྲུང་ཡང་གདའ་སྐད།",
    "ཁྱེད་རང་རིག་༣བ་པ་ཅན་ཡིན་པས་ཐབས་ཅི་ཡོད་ཟེར་བ་ལ།",
    "རྡོའི་རྩ་ལས་མི་འདུག་ཅེས་བྱུང་བས་རྒྱལ་པོ་ཐུགས་མ་བདེ་ནས་ཁོང་རང་ལ་དྲིས་དུས་ང་ཤི་ནས་རྒྱ་ཡུལ་དུ་མི་ཤིས་པ་ཆེན་པོ་འོང་།",
