    "གང་གིས་དུས་གསུམ་འཇིག་རྟེན་སྐྱེས་པ་ཡི་ཉ།",
    "བདག་གི་ལུས་དང་སྲོག་ཡོངས་སུ་བཏང་སྟེ།",
    "རང་གི་༨ལུས་ཀྱང་དྲལ་ཅིང་༩སློང་བ་ལ་ཁྲག་ཡོངས་སུ་གཏོང་བ་འམ།",
    "རྐ་༡༩ལག་ལས་སོར་མོ་ཡོངས་སུ་གཏོང་བ་འམ།",
    "ཡི་གེ་འབྲུ་གཅིག་གི་ཕྱིར་ཡང་རྒྱ་མཚོའི་༢༥མཐར་ཐུག་པའི་ས་ཆེན་པོ་ཡོངས་སུ་གཏོང་བ་འམ།",
    "རང་གི་ལུས་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ལ་༡རིམ་གྲོ་བྱེད་པ་འམ།",
    "སློང་བ་ལ་བུ་དང་བུ་མོ་དང་ཆུང་མ་དག་ཡོངས་སུ་གཏོང་བ་འམ།",
    "བཟའ་ཤིང་གི་ར་བ་སྦྱིན་པ་འམ།",
    "བསྐ་བ་སྣ་ཚོགས་ཀྱི་རོ་མཆོག་དང་ལྡན་པ་ཤིན་ཏུ་འཇམ་པའི་རོ་མཆོག་གི་རྣམ་པ་དང་ལྡན་པ།",
    "སེམས་དགའ་བ་༡་དད་ཅིང་མོས་པ་དང་།",
    "ཡེ་ཤེས་མཆོག་གི་རོ་ལ་སེམས་རྣམ་པར་གཞོག་པར་གྱུར་ཅིག།",
    "ལུས་ཀྱིས་ཁྱུད་ན་༡་ལུས་ལ་བདེ་བར་རེག་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཕ་དང་མ་རྣམས་ལ་སྦྱིན་པ་བྱེད་པའི་ཚེ་ཆུང་ངུ་ན་༦བདག་གི་ལུས་དང་དེ་མ་ཡིན་པའི་གཞན་བཀྲེན་པ་ཕོངས་པ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་རྟེན་ལ་སྤྱོད་པ་དང་།",
    "མོས་པ་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "འཕགས་པའི་སྐྱེ་བོ་ལ་ཤིན་ཏུ་མོས་པའི་སེམས་ཀྱིས་གང་ཟག་གི་རྣམ་པ་༡༢ཉན་ཐོས་དང་སྐེ།",
    "ཁྱུ་མཆོག་གི་ནེརིམཐུ་འབྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྫུ་འཕྲུལ་ཆེན་པོའི་ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནིཐོབ་པར་གྱུར་ཅིག།",
    "སེམས་བསྐྱེད་པས་མོས་ཤིང་བསྟབས་པ་ཐམས་ཅད་གཏོང་བས་ཤིན་ཏུ་རེ་བའི་ཡིད་ཅན་དེ་དག་འོངས་པ་མཐོང་ནས།",
    "འདི་ལྟར་བདག་ཉིད་ཕྱོགས་དེ་དག་ཏུ་༡༧ཁྱོད་ཀྱི་དྲུང་དུ་སོང་སྟེ་རིམ་གྲོ་ནབྱ་བ་ཞིག་ན།",
    "དེ་འདི་ལྟར་ཁྱོད་འདིར་ཕྱིན་ཏེ་ཤིན་ཏུ་ངལ་བར་གྱུར་ཏོ།",
    "ངལ་བ་བསྟིས་༥ནས་ཅི་འདོད་པ་སྦྱིན་པ་དེ་དག་གིས་ཤིན་ཏུ་རིམ་གྲོར་༦བྱེད་དེ།",
    "འདི་ལྟ་སྟེ་བེེ་ཌཱུརྱའི་༡་ཤིང་རྟ་ཆུང་༡༥མའི་འཁོར་༡་གླུ་དང་རོལ་མོ་བརྡུང་ཞིང་དཀྲོལ་༡༥བ་དང་ལྡན་པས་ཡོངས་སུ་བཀང་བ་དང་།",
    "འདི་ལྟ་སྟེ་དངུལ་གྱི་ཤིང་རྟ་ཤིན་ཏུ་མཛེས་པ་བུད་མྱེད་གཞོན་ནུ་ལྷའི་བུ་མོ་ལྟ་བུས་ཡོངས་སུ་གང་༡༧བ་དང་།",
    "འདི་ལྟ་སྟེ་ཤེལ་གྱི་ཤིང་རྟ་བུད་མྱེད་བཟང་མོ་བཞིན་བཟང་བ་༢་ཆ་བྱད་སྡུག་གུ་ཤིན་ཏུ་བརྒྱན་པ་གཟུགས་མཛེས་པ་ལྟ་ཉན་སྡུག་ཅིང་མྱི་མཐུན་པ་མེད་པས།",
    "འདི་ལྟ་སྟེ་སྤོས་དམ་པའི་ཤིང་རྟ་བུ་དང་༢་བུ་མོས་ཡོངས་སུ་བཀང་བ་དང་།",
    "དེ་རྣམ་པ་འདི་ལྟ་བུའི་ཤིང་རྟ་གྲངས་མྱེད་པ་རྣམ་པ་སྣ་ཚོགས་སློང་མོ་སྣོཔ་ཐམས་ཅད་ལ་སྦྱིན་ཞིང་ཡོངས་སུ་གཏོང་བས་སློང་བ་འདོད་པར་བྱ་བའི་དངོས་པོ་རབ་ཏུ་ཐོབ་པས་ཡིད་ལ་བསམ་པ་ཤིན་ཏུ་རྫོགས་ནས་སློང་བ་དེ་དག་ཐམས་ཅད་སྦྱིན་པ་ཐམས་ཅད་སྦྱིན་པའི་ཚུལ་གྱིས་ཡང་དག་པར་བཟུང་རིསྟེ།",
    "ཁ་དོག་པད་མོ་ལྟ་བུ་གདོང་རྣམ་པར་དག་པ།",
    "གསེར་ལྟར་བལྟ་༧རིན་མཛེས་པ་དཔག་ཚད་སྟོང་གི་ནཁྱོན་དུ་ངལ་བ་མྱེད་པར་འགྲོ་བ་སྦྱིན་ཞིང་གཏོང་བ་འམ།",
    "དེ་དང་དེ་དག་གི་རྒྱལ་པོ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གྲངས་མེད་པ་ལ་ཁྲི་སྟན་༢བཟང་པོའི་རྣམ་རྣ་པ།",
    "ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་༧བ་ཡང་དག་པར་སྟོན་པའི་ཕྱིར།",
    "ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ལས་ཡོངས་སུ་འདས་ཏེ།",
    "གདུགས་གཅིག་གིས་ནམ་མཁའ་༡ཐམས་ཅད་༥ཀྱི་དབྱིངས་ཀྱིས་ཀླས་པ།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱིས་༡༧ཡེ་ཤེས་མཆོག་གི་གདུགས་རབ་ཏུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "རྒྱལ་མཚན་གྱི་རྩེ་མོ་ཟླ་ཁམ་༢་གྱིས་མཛེས་པར་བརྒྱན་པ།",
    "རྒྱལ་མཚན་གྱི་རྒྱན་རྣམ་པ་དུ་མ་འོད་དང་ལྡན་པས་རབ་ཏུ་བརྒྱན་པའི་རྒྱལ་མཚན་རྣམ་པ་སྣ་ཚོགས་བསྒྲེང་བའི་མུནརྒྱན་དེ་ལྟ་བུ་དག་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལ་༦མོས་པའི་རྒྱལ་མཚན་གྱི་རྒྱན་༧གྱིས་ཀུན་ཏུ་ཁྱབ་པར་བྱ་བ་དང་།",
    "ཡངས་པ་ཀུན་ཏུ་རྒྱལ་མཚན་གྱི་སྦྱིན་པ་ཡོངས་སུ་གཏོང་༡་བར་མོས་པས་༡༡འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རྒྱས་པར་བྱ་བ་དང་།",
    "གང་ཟག་གི་རྣམ་པ་གཞན་སུའང་༡༥རུང་སྟེ།",
    "ཟབ་མོ་ཐམས་ཅད་དང་ལྡན་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།་",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱི་རྒྱན་དུ་རེད་པར་གྱུར་ཅིག།",
    "མྱི་ཟད་པའི་མཛོད་དང་ལྡན་ཞིང་ཚིག་གི་རྒྱན་གྱིས་ཤིན་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "ལྟུང་གི་བཅིང་བས་ལབཅིངས་པར།",
    "ལུས་ལྕགས་ཐག་གིས་བཏགསས་པ།",
    "སྐྱེ་བོ་བརྒྱ་ཕྲག་སྟོང་གིས་ཀུན་ནས་བསྐོར་ཅིང་འཛམ་བུའི་མེགླིང་དུ་གཏོགས་པ་སྣ་ཚོགས་ནས།",
    "སྙམ་ནས་བདག་གི་ལུས་དང་སྲོག་ཡོངས་སུ་བཏང་སྟེ།",
    "ཀྱེ་ཚུར་ཤེག་བདག་གི་སམགོ་ལས་གཙུག་ཕུད་དང་།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་༥ཏེ།",
    "རིམ་གྲོ་དང་བཅས་པའི་ལུས་ཀྱིས་སོར་མོ་བཅུའི་ཐལ་མོ་སྦྱར་ནས།",
    "རྒྱས་པར་རང་གི་སྐྲ་ལས་འོད་གཟེར་༧རབ་ཏུ་འགྱེད་པར་གྱུར་ཅིག།",
    "འདོད་པ་སྣ་ཚོགས་མཐོང་བས་རང་གི་དགའ་བ་ཁོང་དུ་ཆུད་པར་བྱེད་པ་དང་།",
    "མྱིག་གི་དམ་པར་གྱུར་ཅིག།",
