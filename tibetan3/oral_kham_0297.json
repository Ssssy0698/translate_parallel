    "གར་ལན་ཀླུ་སྒྲུབ་དགོངས་རྒྱན་དུ་ཡང་རང་ཡུལ་གཉིས་མེད་ཀྱི་ཤེས་པ་རིག་པ་མིན་ན་སོ་སོ་རང་རིག་ཅེས་པ་འབྲེལ་མེད་ཅེས་ཕྱོགས་སྔའི་རྩོད་པ་བཀོད་ནས།",
    "དགོས་པ་ཡང་རང་དང་གཞན་ཞེས་ཐ་དད་དུ་ཕྱོགས་གཉིས་བཟུང་བ་འདི་ཡང་ལོག་པར་གོམས་པའི་བློ་འཁྲུལ་བས་བྱས་པ་ཙམ་ཡིན་གྱི།",
    "སྣོད་སྐད་ཅིག་མ་ཞེས་པ་ལྟ་བུ་སྣོད་སྟོང་པར་འཇུག་ལྷས་སྦྱིན་སྐད་ཅིག་མ་ཞེས་པ་ལྟ་བུ་བྱ་བ་མེད་པར་འཇུག་དུས་སྐད་ཅིག་མ་ཞེས་པ་ལྟ་བུ་དུས་མཐའ་ལ་འཇུག་པའི་ཕྱིར།",
    "མང་པོ་འདུག་ཅེས་དཀའ་འགྲེལ་ལས་ཐ་དད་དུ་མཛད་ཀྱང་དཔྱད་དགོས་པར་གསུངས་པའི་དཔྱད་ཚུལ་དེ་ཡིན་ནོ།",
    "ཨིདེ་ཡང་རང་དོན་དོན་དམ་པའི་སྐུ་དང་།",
    "སྦྲུལ་ཁོ་རང་སྦྲུལ་འཛིན་གྱི་གཞིར་རང་མཚན་གྱིས་ཡོད་པས་དཔེ་མ་ངེས་ལ།",
    "ཞེས་པ་ལྟ་བུའི་དགོངས་པ་རླིང་པོ་ཞིག་ཡོད་པར་འདུག་ཀྱང་།",
    "དེ་ཡང་ཉན་ཐོས་དང་རང་རྒྱལ་གྱིས་ནི་མ་སྤངས་ཀྱི།",
    "ལང་གཤེགས་དང་རང་འགྲེལ་ལས་དྲང་དོན་དུ་གསུངས་པ་འདི་ནི།",
    "དེས་ན་ཀུན་དཀྲིས་ཆེན་པོའི་ཡན་ལག་མ་ཚང་བའི་ཉེས་དམིགས་སུ་ལྟ་བ་འདུག་ན་ལྷག་མ་ཐམས་ཅད་ཚང་ཡང་ཆུང་ངུར་ཤེས་པར་བྱ་ལ།",
    "ཉེས་དམིགས་སུ་ལྟ་བ་མི་འདུག་ན་འབྲིང་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་པ་ལྟར་ཁོ་རང་གཉིས་ཕན་ཚུན་རྒྱུ་འབྲས་སུ་སྦྱར་ཏེ་རྒྱུའི་སེམས་བསྐྱེད་དང་།",
    "ཊཱིཀ་ཆེན་ཤོག་གུང་ལྔ་པར་གསལ་པོར་འདུག་འདིས་ནི་བརྡའ་དང་ཐ་སྙད་ཀྱི་ཁྱད་པར་ཀྱང་ཤེས་སྟེ།",
    "དབྱིག་འགྲེལ་དུ་ཉེར་གསུམ་བྱུང་ཡང་རྩ་བར་ཚིགས་བཅད་སོ་དྲུག་འདུག་པས་བསྡུ་ལུགས་དཔྱད་དགོས།",
    "ཐམས་ཅད་ཀྱང་རང་ཉིད་ལ་དགྱེས་པའི་ཉམས་དང་བཅས་ཏེ་བཞུགས་པར་བསམ།",
    "འདི་རྣམས་ཐོག་མེད་ནས་སྡུག་བསྔལ་གྱི་རྒྱུ་འབའ་ཞིག་བསྒྲུབས་པས་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་མྱངས་ཤིང་ད་ལྟའང་མྱོང་བཞིན་དུ་དེའི་རྒྱུ་སྒྲུབ་པར་འདུག་པས་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་དང་བྲལ་ན་ཅི་མ་རུང་།",
    "རྫས་ཐབས་སྣ་ཚོགས་ཤིག་གསུངས་འདུག་པ་རྣམས་ཀྱང་།",
    "ལན་དུ་དཔེར་ན་ཁྱིམ་མཐའ་མེས་བསྐོར་བའི་ནང་ན་བྱིས་པ་མནོ་བསམ་མེད་པ་ཞིག་རྩེ་བཞིན་དུ་ཡོད་པ་ཕས་མཐོང་ནས་ཁྱིམ་མེས་འཚིག་པར་འདུག་ཚུར་ཤོག་བྱས་ཀྱང་མི་ཉན་ལ།",
    "པའི་ཐབས་མི་འདུག་དགོངས་ནས།",
    "དེར་མ་ཟད་ཕྱི་དོན་ཡང་རང་བཞིན་གྱེས་གྲུབ་བོ།",
    "ལུས་འདི་མི་གཙང་བའི་རང་བཞིན་ཅན་ཡིན་པར་མངོན་སུམ་གྱེས་གྲུབ་པར་འདུག་ཀྱང་ད་དུང་རྟོགས་མི་ནུས་ཤིང་།",
    "འདི་ལ་དོགས་པ་འདི་ཡོད་དེ་རང་ངོས་ནས་མེད་བྱས་ན་ཆད་མཐར་འགྲོ་ཉེན་འདུག་པས།",
    "འདིར་ནི་རང་ངོས་ནས་ཡོད་ན་འདི་འདྲ་ཞིག་ཏུ་ཡོད་རྒྱུ་ལ་མི་འདུག་སྙམ་དུ་དགག་བྱ་བཅད་ཙམ་དེ་ཀ་ཁོ་ན་འཆར་དགོས་པས་སྒྲུབ་པ་དངོས་ཤུགས་གང་ལའང་བསྒྲུབ་མི་རུང་།",
    "རྗེ་དང་མཇལ་བ་ན་བྱེ་མའི་འཆང་བུ་ལྟར་ཞིག་འགྲོ་བ་ཤ་སྟག་ཏུ་འདུག་ཅེས་མཁས་གྲུབ་རྗེ་རང་ཉིད་ཀྱིས་གསུངས་པ་དང་།",
    "དེ་ལྟར་ལས་རང་རང་དང་ཚར་གཅིག་པའི་སྲེད་ལེན་སོགས་ལས་དེས་རྣམ་སྨིན་འབྱིན་པའི་གྲོགས་སུ་མི་འོང་ཞིང་།",
    "ཁ་ཅིག་དུས་ཀྱི་ཀུན་སློང་ལ་མ་རིག་པ་དགོས་ཟེར་ན།",
    "འོན་ཀྱང་རང་རྒྱུད་པ་ལྟར་ན་ལས་ཐམས་ཅད་ཀྱི་བག་ཆགས་བསྒོ་གཞི་གཅིག་ཁོ་ན་མ་ཡིན་ཏེ།",
    "དེ་ལས་ཉེས་པ་ཆེས་མངོན་སུམ་པ་སྒྲུབ་སླ་བ་འདི་སོན་འདུག་སྟེ།",
    "ལྷག་པར་རིགས་རྒྱན་གྱི་ཚིག་རྣམས་དཀའ་བ་ཞིག་འདུག་གསུང་པར།",
    "ཤིན་ཏུ་གོམས་པའི་ལམ་སྲང་ལ་བསམ་མནོ་བཏང་བ་བཞིན་དམིགས་འོག་ཏུ་རུག་གེ་ཚུད་པ་ཞིག་བྱུང་ན་ཀུན་སློང་རང་ལ་ལམ་རིམ་ཚང་བ་དང་།",
    "ལྷ་གཞན་ལའང་དེའི་རིགས་པ་སྦྱར་ན་ཚོགས་རྒྱ་ཆེན་གསོག་པའི་རྐྱེན་དུ་འགྲོ་བ་ལས་དགག་བྱ་ཡོང་དོན་མི་འདུག།",
    "ཉན་རང་རྣམས་ཀྱིས་ཞི་བདེ་བསྒྲུབས་པ་བཞིན་དུ་རྒྱུ་དང་འབྲས་བུའི་གནས་སྐབས་གང་དུའང་རང་དོན།",
    "ཞེས་གསུངས་འདུག་ནའང་།",
    "དེ་ཐམས་ཅད་ཀྱང་རང་དོན་ཡིད་བྱེད་ཀྱིས་མ་བསླད་པར།",
    "ད་དུང་རང་ཉིད་ཀྱིས་ནན་ཏན་དུ་གོམས་པར་མཛད་པ་ནི་གདུལ་བྱ་ལ་ཡིད་ཆེས་སྐྱེད་པའི་ཐབས་དང་།",
    "ཁོང་དུས་ཕྱིས་ཡི་གེའི་རྣམ་དབྱེ་སོགས་ལ་རྩོད་མེད་ཀྱི་པཎྜི་ཏར་བྱེད་ཀྱིན་འདུག་པས་གོ་ཚུལ་གཅིག་ཡོད་ལས་ཆེའང་།",
    "རང་རང་འདི་ཕྱིའི་བདེ་ཐབས་འཆུག་མེད་སྒྲུབ་པ་དང་ཆབས་ཅིག་སྔ་དུས་ཤར་གླིངཨེ་ཤ་ཡའི་ནང་སྙན་གྲགས་ལྡན་པའི་རླབས་ཆེན་བོད་རྒྱལ་ཁབ་དང་།",
    "ད་ལྟ་འདིར་ང་རང་སྟོ་བོད་རིགས་སེར་སྐྱ་རྒན་བྱིས་ཚོ་དང་།",
    "རྩ་བ་ང་རང་ལ་ཆ་བཞག་ན།",
    "ང་ལ་གཞན་དག་ཟེར་རྒྱུ་གང་ཡང་མི་འདུག་ཚང་མར་བཀྲ་ཤིས་བདེ་ལེགས།",
    "ང་རང་ཡང་འདིའི་ཐོག་ལ་དོ་སྣང་ཡོད་མཁན་ཞིག་དང་།",
    "སྤྱི་འགྲེ་སྤྱི་མཚུངས་ཀྱི་མི་གྲལ་ལ་ཚུད་ཐབས་འབྲེལ་བ་འཛུགས་པའི་ཐབས་ཤེས་མང་པོ་བྱེད་ཀྱི་འདུག་ཐབས་ཤེས་དེ་བྱེད་ཀྱི་ཡོད་པའི་རྐྱེན་གྱིས་རྒྱ་མིས་ཕྱི་རྒྱལ་ལ་རྣམ་འགྱུར་མཛེས་པོ་དང་།",
    "འོག་དེར་འཇའ་ཆེན་ཞིག་བཞག་འདུག་དེའི་མདུན་དེར་རྡོ་ཇེ་དྲིལ་བུ་དང་།",
    "སློབ་ཕྲུག་སྐད་ཆ་ཤོད་མཁན་དེ་འདྲ་འདུག་དེ་ཚོའི་རྣམ་འགྱུར་ལ་ལྟོས་དང་།",
    "སྐད་ཆ་དྲི་མཁན་ཕྱི་རྒྱལ་གྱི་མི་དེའི་གདོང་ལ་མ་བལྟས་པར་ཟུར་ཞིག་ལ་བལྟ་བཞིན་སྐད་ཆ་ཤོད་ཀྱི་འདུག་དེའི་ཟུར་དེར་རྒྱ་མིའི་སྐད་བསྒྱུར་ཡིན་ནའང་རུང་།",
    "སོ་སོགེ་གད་མི་རིགས་ཡིན་པའི་ཆ་ནས་སོ་སོའི་མི་རིགས་ཀྱི་ཞབས་འདེགས་གང་འདྲ་ཞིག་བསྒྲུབས་འདུག་གམ།",
    "ལག་ལེན་ཐོག་ཁ་ཐབས་གང་འདྲ་ཞིག་འདུག་གམ།",
    "དམིགས་སྒོ་འདི་འདྲ་ཞིག་འདུག་ཅེས་གྲ་སྒྲིག་ཆ་ཚང་བྱས་ནས་བསམ་འཆར་འདོན་དགོས།",
    "སྤྱིའི་སྒྲིག་འཛུགས་ཀྱི་ནུས་པ་ལ་ཡང་གནོད་ན་ཡག་པོ་མི་འདུག་སྐད་ཆ་ཞིག་གོ་བ་ཙམ་ལ་ཆ་མ་བཞག་པར་སོ་སོས་དགེ་སྐྱོན་བརྟག་དཔྱད་བྱེད་དགོས།",
    "གཞོན་སྐྱེས་ཚོས་ད་ལྟ་བར་དུ་སེམས་ཤུགས་ཆེན་པོ་བྱས་པ་ཡག་པོ་འདུག་ད་དུང་ཡིན་ཀྱང་ཁ་སང་གཞོན་ནུ་ཁ་ཤས་ཐུག་པའི་སྐབས་ལ་སྐད་ཆ་བྱུང་བ་བཞིན།",
    "དུས་རྒྱུན་གཏན་ནས་རང་རང་སོ་སོས་བོད་དོན་སྐོར་དོ་སྣང་བྱས།",
    "འབོད་བསྐུལ་བྱས་ན་ཧ་ཅང་ཡག་པོ་འདུག་དགའ་པོ་བྱུང་།",
    "དཔེར་ན་ང་རང་ཆ་བཞག་པ་ཡིན་ན་ཡང་།",
    "ཡ་རབས་བྱེད་རྒྱུའི་བསམ་བློའི་གོམས་པ་གང་འཚམས་ཤིག་སྐུསྒོད་ན་གྲ་མ་འགྲིགས་ཤིག་དོན་པ་ཡིན་ན་ཡང་སྐབས་དེར་ཅ་མ་མིང་བསམ་པ་དྲན་གྱི་འདུག་སྟེ།",
    "གྲོགས་པོའི་རྣམ་འགྱུར་བཟང་པོ་ཡོད་པ་ཧ་ཅང་ཡག་པོ་འདུག་རྒྱ་མི་དང་།",
    "ཨ་ཙི་གང་དྲག་ཟེར་བ་འདྲ་པོ།",
    "གྲོགས་ཝའི་རྣམ་འགྱུར་བཟང་པོ་ཡོད་མཁན་ཡག་པོ་འདུག་ཅེས་ཟེར་གྱི་འདུག་དེ་བཞིན་རྒྱ་གར་ནང་ལའང་བོད་རིགས་ཚོར་སྤྱིར་བཏང་མཐོང་སྣང་ལ་ལྟོ་གོས་ཐོག་གྲུང་པོ་དང་།",
    "ལྟོག་ཤི་ཐེབས་པ་ལ་དོ་སྣང་གང་ཡང་བྱེད་ཀྱི་མི་འདུག་གམ།",
    "དོ་སྣང་དང་འབད་བརྩོན་བྱས་ཏེ་མ་འགྲུབ་ནའང་འགྱོད་པ་མི་འདུག་གམ།",
    "དེ་རིང་ཁྱེད་རང་སྟོ་ཚང་མར་བཀྲ་ཤིས་བདེ་ལེགས་ཡོད།",
    "ང་རང་སྒེར་ལ་ཆ་བཞག་ན་ཡང་།",
    "ང་རང་སྒེར་ལ་ཆ་བཞག་ན་ཡང་།",
    "ད་བོད་པའི་གནས་ཚུལ་འདི་ཁྱད་མཚར་པོ་ཞིག་འདུག་ཅེས་དང་།",
    "རང་ཉིད་ཚུར་ཙམ་དེར་ཁ་འདོན་བྱེད་ཀྱི་ཡོད།",
    "ང་རང་ཡིན་ན་ཡང་ཚེ་རིང་པོ་དང་།",
    "སེམས་སྦུག་སྲུབ་དྭོགས་པོ་གང་ཡང་མི་འདུག་ལུས་སེམས་གཉིས།",
    "ཁྱེད་རང་ཚང་མ་དངོས་གནས་གྲུང་ཧྲིལ་ཧྲིལ་གཟུགས་པོའི་ཆ་ནས་སོས་རིལ་རིལ་ཡོད་པ་ཙམ་དུ་མ་ཟད།",
    "ཁྱེད་རང་རློ་འདིར་ད་ལྟ་བོད་ནས་སླེབས་མ་ཐག་པའི་བོང་པའི་བཟོ་འདྲ་པོ་མིན་པར།",
    "མིའི་གཤིས་ཀ་བཟང་པོའི་ཡོན་ཏན་དེ་མེད་ན་མི་ལ་སྐྱིད་པ་མི་འདུག་བསམ་པ་དང་།",
    "འདིས་བོད་སྤྱི་པའི་དོན་དག་ལ་ཡང་ཕན་གྱི་འདུག་སོ་སོ་སྒོར་ལ་ཡང་ཕན་གྱི་འདུག་སོ་སོས་དོ་གལ་ཆེན་པོ་དང་།",
    "འདིས་བོད་སྤྱི་པའི་དོན་དག་ལ་ཡང་ཕན་གྱི་འདུག་སོ་སོ་སྒོར་ལ་ཡང་ཕན་གྱི་འདུག་སོ་སོས་དོ་གལ་ཆེན་པོ་དང་།",
    "ད་ལྟ་ཁྱེད་རངཚོ་ཐུག་པ་ཡིན་ཙང་ངས་ལབ་པ་ཡིན།",
    "རྒྱབ་བསྟན་ནས་སྐད་ལོག་རྒྱབ་པས་ཕན་ཐོགས་མི་འདུག་ཡང་ན་འཁྲུག་པ་རྒྱག་དགོས།",
    "ཁོས་འདི་འདྲ་ཟེར་གྱི་འདུག་ང་རྒྱ་ནག་ལ་ཚར་མང་པོ་ཕྱིན་པ་ཡིན།",
    "རྒྱ་མིས་ཡག་པོ་བྱས་འདུག་བསམ་པའི་མཐོང་ཚུལ་བྱུང་།",
    "ཡུན་རིང་ཙམ་བསྡད་དེ་གཞི་ནས་གནས་ཚུལ་མང་པོ་ཞིག་ལ་ཞིབ་འཇུག་བྱེད་པའི་སྐབས་སུ་རྒྱ་མིས་བོད་ནང་ལ་གཏོར་བཤིག་ཤིན་ཏུ་ཆེན་པོ་བྱས་འདུག་བོད་མིར་གྱོང་གུན་ཆེན་པོ་ཕོག་པ་དང་།",
    "དཀའ་སྡུག་ཆེན་པོ་བྱུང་འདུག་ད་ཆ་ངའི་སེམས་ནང་ལ་འགྱུར་བ་ཕྱིན་ཏེ་བོད་མི་ལ་ཤ་ཚ་དང་རྒྱབ་སྐྱོར་ཡོད།",
    "རྒྱ་གར་ལ་ང་གཅིག་ཐུག་ན་བསམ་ཏེ་ཡོང་པ་ཡིན་ཞེས་ཟེར་གྱི་འདུག་དཔེར་ན།",
    "ཚགས་དཔར་ནང་ལ་གནས་ཚུལ་ཁ་ཤས་མགོ་མ་འཚོས་པར་མང་པོ་བྲི་རྒྱུ་དེར་དགེ་མཚན་མི་འདུག་ཚང་མས་ཧུར་ཐག་བྱེད་དགོས།",
    "ཡག་པོ་འདུགཚང་མས་དཀའ་ཐུབ་སྤྱད་དེ་ལས་འགན་ལྷག་བསམ་རྣམ་དག་ངོ་ལྐོག་མེད་པ་བྱས་པ།",
    "ང་རང་སྟོ་བོད་པའི་དཔེ་ལ་མཆོད་རྟེན་མགོ་མཇུག་ལོག་ཀྱང་བང་རིམ་སྐེད་པར་གནས་ཟེར་བ་བཞིན།",
    "ང་རང་ཆོག་ངད་པའི་མི་རིགས་ཀྱི་ལ་རྒྱ་ཤ་ཞེན་ཡོད་པ།",
    "ང་རང་ལ་ཆ་བཞག་ན།",
    "གཞན་དག་ཞུ་རྒྱུ་གང་ཡང་མི་འདུག་ཅེས་བཀའ་སླབ་༤སྐོར།",
    "དེ་རིང་ང་རང་ས་ཆ་འདིར་དངོས་སུ་སླེབས་དུས་དགའ་པོ་བྱུང་བ་མ་ཟད།",
    "དེ་རིང་ངས་འདིར་བསྐྱར་ནན་ཡང་ནན་དམིགས་བསལ་ལབ་དགོས་པ་མི་འདུག་རུང་།",
    "དེ་འདྲ་ཡིན་དུས་ཚང་མས་ད་ཕན་ཧུར་ཐག་བྱས་འདུག་ལ་ད་དུང་ཡིན་ནའང་ཧུར་ཐག་བྱེད་རོགས་ཞེས་ཟེར་རྒྱུ་ཡིན།",
    "རང་རང་སོ་སོའི་བདེ་བ་སྒྲུབ་པའི་ཐབས་ཤེས་དང་།",
    "དེ་བཞིན་འབྲུ་རིགས་འདྲ་མི་འདྲ་འདེབས་ལས་ཐོག་ནས་ཡར་རྒྱས་གཏོང་རྒྱུ་གང་འདུག་གམ།",
    "མ་འོངས་པ་ག་དུས་ཡིན་ན་ཡང་བོད་རིགས་རྩམ་པ་ཟ་མཁན་དང་།",
    "མ་འོངས་པ་ག་དུས་ཡིན་ན་ཡང་བོད་རིགས་རྩམ་པ་ཟ་མཁན་དང་།",
    "ཁྱེད་རང་ཚང་མར་ཐུགས་རྗེ་ཆེ་ཟེར་གྱི་ཡིན།",
    "ཡིན་ན་ཡང་ང་རང་སྟོ་ཚང་མ་སྡོད་ས་མིའི་ལུང་པར་བསྡད་ཡོད་ཀྱང་།",
    "དྲང་པོས་གཞུང་བསྲངས་བྱེད་མཁན་ཞིག་ལ་ངོས་འཛིན་བྱེད་ཀྱི་འདུག་དཔེར་ན་རྒྱ་གར་ནང་ལ་ཆ་བཞག་ན་ཡང་།",
    "དེ་གལ་ཆེན་པོ་འདུགཡུལ་པ་ཚོ་ལ་མཐུན་པོ་བྱེད་དགོས།",
    "ལྷག་དོན་ད་རིང་ཕྲུ་གུ་ཚོ་ཐུག་པའི་སྐབས་ལ་ཚང་མ་གྲུང་ཏོག་ཏོག་ཡག་ཐག་ཆོད་འདུག་དགའ་པོ་བྱུང་།",
    "ཡར་རྒྱས་གང་ལ་གང་འཚམས་ཕྱིན་འདུག་ད་དུང་ཚང་མས་ཧུར་ཐག་བྱེད་དགོས།",
    "རང་རང་སོ་སོའི་སེམས་རྒྱུད་ལ་ཞུ་དག་གཏོང་རྒྱུ་དང་།",
    "ཁྱེད་རང་ཚང་མ་སེམས་སྐྱིད་པོ་བྱས་ནས་སྡོད་རོགས་བྱེད།",
    "ད་རིང་ངས་ནང་པའི་ཞབས་འདྲེན་རང་ཞུས་མི་འདུག་ཨའུ་ཙམ་བྱས་འདུག་བསམ་ན་ཕོ་རྒོད་པོ་ངས་ད་རིང་གོ་ཆོད་པོ་བྱས་འདུག་བསམ་ནས་དགའ་བ་སྒོམ།",
    "ཡང་ད་རིང་ངས་ནང་པའི་ཞབས་འདྲེན་ཞུས་འདུག་ངས་མི་ལ་དོན་དག་མེད་པར་ཁ་རྩོད་བྱས།",
    "མགོ་སྐོར་བཏང་བ་སོགས་སོ་སོས་འགྱོད་པ་སྐྱེས་གཞིའི་གནས་ཚུལ་བྱུང་འདུག་ན།",
    "ཁོས་ཐབས་སྡུག་འདི་ལྟ་བུ་བྱས་འདུག་བསམས་ནས་སོ་སོས་སོ་སོར་དམའ་ཕབ།",
    "ང་སྐྱབས་འ་འན་མཁན་ག་ན་བསམ་པ་ལམ་སང་འདྲེན་ཞུས་འདུག་གམ་མི་འདུག་བསམ་བློ་ཡག་པོ་ཞིག་བཏང་།",
    "ད་རིང་ངས་ནང་པའི་ཞབས་འདྲེན་རང་ཞུས་མི་འདུག་ཨའུ་ཙམ་བྱས་འདུག་བསམ་ན་ཕོ་རྒོད་པོ་ངས་ད་རིང་གོ་ཆོད་པོ་བྱས་འདུག་བསམ་ནས་དགའ་བ་སྒོམ།",
    "ཡང་ད་རིང་ངས་ནང་པའི་ཞབས་འདྲེན་ཞུས་འདུག་ངས་མི་ལ་དོན་དག་མེད་པར་ཁ་རྩོད་བྱས།",
    "མགོ་སྐོར་བཏང་བ་སོགས་སོ་སོས་འགྱོད་པ་སྐྱེས་གཞིའི་གནས་ཚུལ་བྱུང་འདུག་ན།",
    "ཁོས་ཐབས་སྡུག་འདི་ལྟ་བུ་བྱས་འདུག་བསམས་ནས་སོ་སོས་སོ་སོར་དམའ་ཕབ།",
    "ང་རང་ལ་ཆ་བཞག་ན་དཀའ་ངལ་དང་འགན་ཆེན་པོ་ཞིག་འཁྲི་ཡོད་ནའང་།",
    "ང་རང་ཡང་གང་ཐུབ་ཀྱི་བསམ་པ་བཟང་ཝའི་ཉམས་ལེན་བྱེད་ཀྱི་ཡོད།",
    "དེང་སང་བོད་སྐད་ཐོག་ནས་བྱ་དགོས་ཀྱི་འདུག་བོད་སྐད་དེ་གསལ་ཤོས་དང་ཁུངས་བཙན་ཆགས་ཡོད།",
    "རུས་རྩི་ས་ཡོད་པ་ཞིག་འདུག་ཅེས་གང་དུ་ཡིན་ནཡང་ཕལ་ཆེ་བར་བསྔགས་བརྗོད་ཐོབ་མཁན་ཞིག་ཆགས་བསྡད་ཡོད།",
    "རུས་རྩི་ས་ཡོད་པ་ཞིག་འདུག་ཅེས་གང་དུ་ཡིན་ནཡང་ཕལ་ཆེ་བར་བསྔགས་བརྗོད་ཐོབ་མཁན་ཞིག་ཆགས་བསྡད་ཡོད།",
    "ང་རང་ཆོརྭ་ད་པའི་རིག་གཞུང་ལ་བོད་པས་གཅེས་སྤྲས་མ་བྱས་ན་སུས་བྱེད།",
    "ཁྱེད་རང་སྟོ་ཚང་མར་ཐུགས་རྗེ་ཆེ་ཟེར་གྱི་ཡིན།",
    "དེ་རིང་ང་རང་དགའ་པོ་བྱུང་།",
    "ང་རང་བོ་ད་མི་རྣམས་ལ་ཆ་བཞག་ནའང་ལྷན་སྐྱེས་སུ་སེམས་པ་བཟང་པོ།",
    "མི་ཞིག་ཤི་ནའང་ཨ་ཙི་ཁོ་ཤི་འདུག་ཅེས་ཚང་མས་སེམས་ཁྲལ་དང་།",
    "ཨ་རིར་ཡང་དེ་འདྲ་ཞིག་བྱུང་འདུག་བོད་པ་དངུལ་སྐྱེལ་བར་བཏང་སྟེ་བློས་བཀལ།་",
    "ཤ་སྐམ་པོ་ཟ་མཁན་གྱི་ཟ་ཁང་མི་འདུག་ཀྱང་།",
    "དེར་བརྟེན་ཆེས་མུན་ནག་དང་ཆེས་གདུག་རྩུབ་སུ་ཆེ་བ་འདུག་རྩིས་རྒྱག་རྒྱུ་ཡོད།",
    "དེང་སང་རྒྱ་མིས་སྙིགས་དོར་བཅུད་ལེན་ཞེས་ཤོད་ཀྱི་འདུག་པར་ལྟར།",
    "ཡུལ་ལ་བསྡད་ན་སྐྱིད་པོ་འདུག་རྒྱ་མི་ཁོ་རང་ཙོ་ངང་པ་དང་།",
    "འདི་ལས་སྡུག་ཏུ་མ་ཕྱིན་ན་ཡག་ཐག་ཆོད་འདུག་ཟེར་མཁན་དེ་འདྲ་འདུགདེ་ནི་ཁག་མེད།"
  ]
}