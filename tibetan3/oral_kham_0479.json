    "དེས་སྤྲུལ་པའི་སྐུ་རིགས་གསུམ་མགོན་པོ་ལ་གསུངས་ཏེ་དེ་ཡན་ཆད་རྒྱལ་བ་མ་དགོངས་པའི་བརྒྱུད་པ་ཡིན་པར་གདའ།",
    "རྒྱལ་པོས་རི་སྔོན་པོ་གཅིག་འདུག་པ་ཅིའི་རི་ཡིན་དྲིས་པས།",
    "ཉམས་དགའ་ཞིང་རིག་པ་འུར་འགྲོ་བ་ལྟ་བུ་ཡོང་བའི་གནས་ཅིག་འདུག་གོ།",
    "འདབ་མ་འདོམ་གང་བསམཉམར་། ཡོད་པ་ཅིག་འདུག་གོ།",
    "འདི་ནི་སྤྲུལ་པའི་སྐུ་ཅིག་ཡིན་འདུག་པས་ངའི་བུ་སྐལ་དང་མཆོད་གནས་བྱའོ་གསུངས་ཏེ།",
    "སྲིན་པོར་འདུག་ཟེར་ནས་དེར་སྲིན་པོ་ཤཱནྟ་རཀྵི་ཏ་བྱ་བར་མཚན་བཏགས་སོ།",
    "ཞག་དགུ་རུ་དུ་བ་མ་ཆད་ནས་བལྟས་ཙ་ན།",
    "དེར་མུ་སྟེགས་ཀྱིས་སློབ་དཔོན་ལ་མཐུ་བྱེད་ཀྱིན་འདུག་པ་ལ།",
    "དེ་ལ་ཨོ་ཏནྟ་པུ་རིའི་གཙུག་ལག་ཁང་ཞེས་ཀྱང་གྲགས་འདུག་གསུངས་པས།",
    "རྒྱལ་པོས་འོ་ན་ཅིས་ཀྱང་ལེགས་འདུག་པས་དེ་ཅི་འདྲ་ཞིག་ཡོད་ཞུས་པས།",
    "རོ་སོག་ཕོན་ཙམ་པ་གཅིག་དཀྱིལ་འཁོར་སོ་གཉིས་གྱི་སྟེང་ན་འདུག་གོ།",
    "ཁྱེད་བོད་ཀྱི་ལྷ་འདྲེ་མི་མ་ཡིན་པ་རྩུབ་པོ་འདུག་པས།",
    "བོད་ཀྱི་ལྷ་འདྲེ་གདུག་རྩུབ་ཅན་འདི་རྣམས་མི་ཐུལ་བ་འདུག་པ་ལ་ཐབས་གཅིག་ད་ཡོད་ཀྱིས་གསུངས་ནས།",
    "བོད་ཀྱི་ཀླུ་སྲིན་གདུག་པ་ཅན་འདི་རྣམས་དྲག་པོས་འདུལ་དགོས་པར་འདུག་པས།",
    "ངས་ཁྱེད་བོད་ཀྱི་དད་པ་ལ་རྒྱུ་ཟོག་འདུག་གམ་མི་འདུག་བལྟས་པ་ཡིན།",
    "བང་ཆེན་པའི་སེམས་ལ་ངེད་ལ་བྱིན་པའི་གསེར་གཡུ་ཚོ་ཅི་ཡིན་ནམ་སྙམ་ནས་སོ་སོའི་ཕག་ཏུ་ཕྱིན་ནས་བལྟས་ཙ་ན།",
    "དེ་ནས་འུ་ཡུག་ན་མར་བྱོན་ཙ་ན་ཡ་མ་བཅུ་གཉིས་ལ་སོགས་པ་རྣམས་ཀྱིས་རི་བར་དུ་བར་བར་བསམ་ནས་ཆོ་འཕྲུལ་བྱས་པ་ལས།",
    "དེ་ནས་བྱང་འཕན་ཡུལ་དུ་བྱོན་ཙ་ན།",
    "སློབ་དཔོན་གྱིས་གྲོ་བཞེས་བྱེད་རན་འདུག་པས།",
    "བློན་པོས་གྲབ་གྱིས་ཤིག་གསུངས་པ་ལ་བློན་པོས་ཆུ་མི་འདུག་པས་ཅི་དྲག་ཞུས་པས།",
    "དོན་ལ་སྔགས་འཆང་ཉིད་རང་བེ་རོ་ཙ་ནའི་སྐུའི་སྤྲུལ་པ་ཡིན་པར་གདོན་མི་ཟ་བས།",
    "དེ་ལ་ཀླུའི་གཏེར་བཞུགས་དགོས་པར་འདུག་གསུངས་ནས།",
    "བཤིག་པའི་གླགས་མི་གདའ།",
    "ཚ་ཚ་སྐར་ལྟར་འཕྲུག་ཅིང་གདའ་ཟེར་རོ།",
    "ཁྱུང་ཆེན་པོ་འཇིགས་སུ་རུང་བ་ཞིག་འདུག་པས།",
    "ཀླུ་འདིའི་ཡིད་དམ་ལ་མ་ཐོགས་འདུག་པས་དམ་ལ་བཏགས་སྙམ་པ་ལགས་ཏེ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན།",
    "དེ་བཞི་ཕུར་པ་རྩ་བ་འདི་ལ་ཚང་འདུག་། པར་དགོངས་ནས།",
    "བལ་ཡུལ་དུའང་ཉི་མ་ལ་ཁ་རུ་གཟེར་བ་ལ་བྱོན་གདའ་སྐད།",
    "དེ་རྣམས་རིག་འཛིན་རིག་པའི་བརྒྱུད་པ་ཡིན་པར་གདའ།",
    "ཀཱི་ལ་ཡའི་སྒྲ་སྒྲོགས་པ་དང་བཅས་པ་སྐྱེས་འདུག་པས།",
    "སྭ་བྷ་ཝ་ནི་ཡུལ་ཅན་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ།",
    "དེ་ལྟར་ཧཱུཾ་ལས་བྱུང་བའི་ཨེ་ལ་སོགས་པའི་ཡི་གེ་དེ་དག་རང་རང་སོ་སོའི་གནས་སུ་འཕྲོས་པས་རྟེན་གྱི་དཀྱིལ་འཁོར་དུ་གྱུར་པར་བསམས་པ་ནི་ཏིང་ངེ་འཛིན་གྱི་སྒོའོ།",
    "དེང་སང་བློ་ཆུང་རང་བློའི་རྩལ་ཞན་འགའ།",
    "ཐབས་དང་ཤེས་རབ་སྙོམས་འཇུག་དུས།",
    "རྒྱ་མདུད་གོང་མ་རྒྱ་ཕིབས་སམ་སྤེན་བད་ཀྱི་ཚུལ་དུ་འདུག་པའོ།",
    "འོག་མིན་དང་རང་བཞིན་གྱི་གནས་ནས།",
    "དེ་ཡང་རང་འདྲའི་ཡེ་ཤེས་པ་སྤྱན་དྲངས་པ་ལ།",
    "དེ་ཡང་རང་ལ་གཙོ་བོ་བསྟིམ་པ་ནི།",
    "དེ་ཡང་རང་བྱུང་ནི་སྣོད་རང་ལས་བྱུང་བ་བནྡྷ་ཀ་པཱ་ལ།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་རང་སར་དག་པར་བྱེད་པ་ནི་སྦྱོར་སྒྲོལ་ཡིན་ལ།",
    "ནང་རང་ལ་ཡོད་པའི་དུར་ཁྲོད་ནི་རྐང་ལག་བཞི་མགོ་བོ་དང་ལྔ།",
    "གདུག་པ་ཅན་གྱི་དགྲ་བགེགས་བསྒྲལ་བ་ལ་སོགས་པའི་ལས་མཛད་པར་གཞན་གྱིས་མ་བཅོལ་ཡང་རང་ཉིད་ཀྱི་ཞལ་མཆེས་མ་སྟེ་ཁས་བླངས་པའི་དམ་ཚིག་རྣམས་དྲན་པར་མཛོད་ལ།",
    "ཞིང་ཁམས་མ་རང་ལ་འགལ་པ་ཆེར་མི་འདུག་གཞན་དཀྱིལ་ཐང་སོགས་བྲི་ཆ་ལ་ཞོན་པ་མེད་པ་ཐོབ་རྒྱུ་ཡིན།",
    "དེར་སློབ་དཔོན་རྣམ་པ་གསུམ་གྱིས་འདི་དཔལ་རྡོ་རྗེ་གཞོན་ནུའི་སྤྲུལ་པའི་ཕོ་ཉར་འདུག་པར་གསུངས་ནས།",
    "བཞིན་ཆགས་ལ་འོད་འཕྲོ་བ་བཞི་འདུག་པ་ལ།",
    "མ་མ་ག་ཡི་ཞེས་པས་སྒྲ་ལས་ང་རང་ཉིད་ཀྱི་ཆུ་བཛྲ་ཛྷཱ་ནཀཱི་ལི་ཀཱི་ལ་ཡ་ཞེས་བརྗོད་སམ་ལརང་ཉིད་ཀྱི་ཧཱུྃ་བཛྲ་ཛྙཱ་ན་ཀཱི་ལི་ཀཱི་ལ་ཡ་ཞེས་བརྗོད་པས།",
    "སྔགས་འཆང་ཉིད་པཀྱིས་ངེད་རང་རང་གནས་སུ་འགྲོ་བ་ལ་ཁྱེད་ལ་ཁྱད་ཅི་ཡོད་ཕར་སོངས་གསུང་བ་སོགས་ཀྱིས་བཀའ་སྒོ་མཛད་པས།",
    "མི་ལ་མི་འཛེམས་པར་གྲལ་བསྒྲིགས་ཏེ་ལངས་ནས་སྔགས་འཆང་ཉིད་ལ་བསུ་བའི་ཚུལ་དུ་འདུག་པ་ནི།",
    "དེ་དུས་ཞབས་དྲུང་ན་འདུག་པ་ཀུན་གྱིས་མཐོང་བར་གྲགས་ལ།",
    "ལྷག་པར་ད་དུང་ལོ་དུ་མའི་བར་དུ་བསྟན་འགྲོའི་དོན་དཔག་ཏུ་མེད་པ་འགྲུབ་པར་འདུག་ཅིང་།",
    "ཡང་ཕུར་གཉིས་གསལ་ཞིང་གཞན་རྣམས་གོང་ཉིས་བཞིན་མཁའ་འགྲོ་རྣམས་ཀྱི་ནང་ནས་བདེ་བའི་འཁོར་ལོ་གསལ་ཏེ་རིག་འཛིན་བརྒྱུད་པའི་ཟླ་ལ་འདུག་གཞན་རྣམས་གོང་བཞིན།",
