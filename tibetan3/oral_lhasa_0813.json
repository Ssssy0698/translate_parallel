    "ཐབས་ཀུན་རྫོབ་བདེན་པ་སྒྱུ་ལུས་དང་ཤེས་རབ་འོད་གསལ་གཉིས་དུས་གཅིག་ཏུ་འདུས་ནས་དབྱེར་མེད་རོ་གཅིག་ཏུ་གྱུར་པ་ནི་སྙོམས་པར་འཇུག་པ་སྟེ་ཟུང་འཇུག་གོ།",
    "འོད་གསལ་ལས་ལངས་ནས་སེམས་གསུམ་ལུགས་ལྡོག་ཏུ་ཤར་བའི་མཐར་ལྷ་སྐུ་འགྲུབ་པ་ཙམ་ནས་ཟུང་འཇུག་ཏུ་མི་འཇོག་ལ།",
    "དྲུང་འཁོར་ཉི་ཤུ་རྩ་ལྔ་ལ་གསང་འདུས་རིམ་ལྔའི་ཁྲིད་གནང་དུས།",
    "སློབ་དཔོན་དཀའ་བཅུ་པ་དར་མ་རིན་ཆེན་གྱིས་ཟིན་བྲིས་སུ་མཛད་ཅིང་བཀའ་རྒྱ་ཤིན་ཏུ་དམ་པར་མཛད་དོ།",
    "རྗེ་ཙོང་ཁ་པ་ཆེན་པོའི་གསུང་འབུམ་བཞུགས་སོ།",
    "འགྲེམས་སྤེལ་ཁ་པར།",
    "འདྲི་རྩད་ཁ་པར།",
    "མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་པར་སྐྲུན་འགྲེམས་སྤེལ་པུའུ།",
    "པར་འདེབས།",
    "ཧྲེན་ཀྲེན་ཧྭ་ཞིན་ཚོན་པར་པར་བཟོ་ཚད་ཡོད་ཀུང་སི།",
    "ཁྲི་དཔར་ཤོག་དཔར་གྲངས།",
    "པར་གཞི།",
    "ལོའི་ཟླ་པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "དཔར་ཐེངས།",
    "ལོའི་ཟླ་པར་དཔར་ཐེངས་དང་པོ་དཔར།",
    "༡ སྟོན་པ་པོས་ཇི་ལྟར་གསུངས་ཚུལ།",
    "༣ བསྟན་པའི་ཚད་རྣམ་པར་བཞག་པ།",
    "༢ སྔགས་མཚན་ཉིད་ཀྱི་ཁྱད་པར་བསྟན་པ།",
    "རྩ་རྒྱུད་དང་བསྡུས་རྒྱུད་ཀྱི་ཁྱད་པར་བསྟན་པ།",
    "བརྩམ་པར་དམ་བཅའ་བ་ལ་བཞི།",
    "༡ ཁེངས་བསྐྱུངས་ཏེ་འགྲེལ་པ་བརྗོད་པར་འདོད་པ།",
    "༡ རྒྱུད་དོན་ལོག་པར་འགྲེལ་བ་གཞོམ་པའི་དོན་དུ་རྒྱུད་འགྲེལ་རྩོམ་པར་བསྟན་པ།",
    "༢ ཐར་ལམ་རྣམ་དག་བསྟན་པའི་དོན་དུ་རྒྱུད་འགྲེལ་རྩོམ་པར་བསྟན་པ།",
    "། གཞི་ལམ་འབྲས་བུའི་ངོ་སྤྲོད་ཡང་དག་དོན་གསལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དེ་དག་ལ་ནི་མི་འཐད་པར་སེམས་པའི་ལོག་པར་རྟོག་པ་བསལ་བ།",
    "ལམ་རིམ་པ་གཉིས་ཀྱི་ཁྱད་པར་ལ་གསུམ།",
    "སྟོང་གཟུགས་མངོན་དུ་བྱེད་པའི་ལྟ་སྟངས་ཀྱི་ཁྱད་པར་བསྟན་པ།",
    "དེ་ཉིད་རྒྱལ་བའི་ཡུམ་ལ་སོགས་པར་ཡང་གསུངས་པའི་ཚུལ་ལ་གཉིས།",
    "ཡུམ་བར་པར་གསུངས་པའི་ཏིང་ངེ་འཛིན་གྱི་རྣམ་གྲངས་བསྟན་པ།",
    "༢དེ་ལས་རྣལ་འབྱོར་པ་ལ་ཡེ་ཤེས་ཕེབས་པའི་ཚུལ་བསྟན་པ།",
    "ལམ་གྱི་རིམ་པ་མི་ཉམས་ཤིང་ཁྱད་པར་དུ་འགྱུར་བའི་ཡན་ལག་བསྟན་པ་ལ་གསུམ།",
    "༢ ལྟོས་མེད་རྣམ་བཞི་བསྟེན་པར་གདམས་པ།",
    "། བདེན་གཉིས་ཤན་འབྱེད་བཞུགས།",
    "། རྡོ་རྗེ་ཤུགས་དང་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་ཤན་འབྱེད་བཞུགས་སོ།",
    "། དཔལ་ཤམ་བྷ་ལའི་བཀོད་པ་གསལ་བར་བྱེད་པ་ཤམ་བྷ་ལའི་རྒྱན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "པར་བྱང་སྨོན་ཚིག་",
    "༧ མཁན་ཨ་ཤག་འོད་ཟེར་སྦྱིན་པ་ཕུན་ཚོགས།",
    "གཡུང་དྲུང་ལས་རྣམ་པར་དག་པའི་རྒྱུད།",
    "སྟོན་པའི་སྒྲོན་མ་གཤེན་རབ་མི་བོ་ལགས།",
    "རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རང་བཞིན་མེད་པའི་གསུངས་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ལས་བཟང་པོའི་འཕྲོ་ལེན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "སྣ་ཡི་རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཡང་དག་པའི་དོན་ལ་འདུད་དོ།",
    "རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སྟོན་པའི་ཐུགས་རྗེས་གཟུང་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "ཤེས་རབ་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉི་མ་དགུ་ཤར།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སྐྱེ་བ་མེད་པའི་དོན་ལ་འཇོག་པའོ།",
    "རྣམ་པར་ཤེས་པ་མཚན་མ་དང་བྲལ་བའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་མཚན་མ་དང་བྲལ་བའོ།",
    "སྣ་ཡི་རྣམ་པར་ཤེས་པ་མཚན་མ་དང་བྲལ་བའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་མཚན་མ་དང་བྲལ་བའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་མཚན་མ་དང་བྲལ་བའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མཚན་མ་དང་བྲལ་བའོ།",
