    "ཡོངས་སུ་འདྲེན་པར་༡་འགྱུར་བ་ནས་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་རྟེན་པའི་བར་དུ་འགྱུར་སྙམ་སྟེ།",
    "དེ་འདོད་ན་སྐད་ཅིག་ཡུད་ཙམ་ཐང་ཅིག་༢་ཏུ་ཏིང་ངེ་འཛིན་བརྒྱ་སྟོང་རབ་ཏུ་ཐོབ་ཅིང་དེ་དག་ལ་སྙོམཉེཔར་འཇུག་པ་དང་།",
    "བསྐལ་པ་བརྒྱ་སྟོང་དུ་གནས་པར་བྱ་བ་དང་།",
    "ཡེ་ཤེས་འདོད་པས་ལྟོས་པ་མེད་པར་འགྲོ་དོན་ས་བྱེད།",
    "དེ་ལྟར་ཤེས་ནས་ཐོས་དོན་སྤྱད་པར་བརྩོན་འགྲུས་རྩོམཁསྙེ།",
    "ཉིན་མཚན་ཉན་པའི་རྒྱུར་སྤྱོད་བྱ་བ་གཞན་མྱེད་པར།",
    "ཆུང་མ་དག་དང་བུ་དང་མཐུན་པར་སྤྱོད་པའི་འཁོར།",
    "སྲབས་ནི་པར་གྱུར་ཅིང་ལོག་བྲལ་ཡོངས་སུ་དག་པར་འགྱུར།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྣམ་པར་དཔྱད་པ་སྣང་བ་ལ་འཇུག་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་རྣམ་པར་དཔྱད་པ་སྣང་བ་ལ་འཇུག་པ་དང་།",
    "འདོད་པའི་ཁམས་རྣམ་པར་དཔྱད་པ་སྣང་བ་ལ་འཇུག་པ་དང་།",
    "གཟུགས་མེད་པའི་ཁམས་རྣམ་པར་དཔྱད་པ་སྣང་བ་ལ་འཇུག་པ་དང་།",
    "ཡེ་ཤེས་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཚོ།",
    "ཡིད་མི་བདེ་བ་རྣམ་པར་སྤངས་ཏེ།",
    "ཡོངས་སུ་སྤྱོད་པ་༡་དང་ལྡན་ཞིང་ཤེས་བཞིན་ཅན་དྲན་པ་དང་ལྡན་པར་ཉུགེའཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་༡སྤངས་ཏེ།",
    "སྤྱོད་པ་དང་༢༡ལྡན་ཞིང་ཤེས་བཞིན་ཅན་དྲན་པ་དང་༢༢ལྡན་པར་འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་སྤངས་ཏེ།",
    "ཡིད་མི་བདེ་བ་རྣམ་པར་སྤངས་ཏེ་ལྷ།",
    "ཡོངས་སུ་སྤྱོད་པ་ལྷ་དང་ལྡན་ཞིང་ཤེས་བཞིན་ཅན་དྲན་པ་དང་ལྡན་པར་འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་༣",
    "ཡིད་མི་བདེ་བ་རྣམ་པར་སྤངས་ཏེ་༤༥།",
    "དང་ལྡན་ཞིང་ཤེས་བཞིན་ཅན་དྲན་པ་དང་ལྡན་པར་འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་སྤངས་ཏེཁྱ།",
    "བྱམས་པ་ཆེན་པོ་དང་ལྡན་པར་བྱ་བ་དང་།",
    "རྣམ་པར་དཔྱད་པ་དང་དྲན་པ་དང་།",
    "གོང་ནས་གོང་དུ་ཁྱད་པར་ཡོངས་སུ་ཚོལ་བའི་སེམས་དང་ལྡན་པ་ཡིན།",
    "ཐིབས་པོ་མེད་པར་སྤྱོད་པ་ཡིན།",
    "མཐུན་པར་འཛིན་ཅིང་ང་ལོ་བདེ་བ་ཡིན་ཏེ།",
    "ཟློག་པར་མི་ནུས་པའི་བརྩོན་འགྲུས་དང་ལྡན་པ་ཡིན།",
    "ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་བརྩོན་འགྲུས་དང་ལྡན་པ་ཡིན་ཚུལ་དང་མི་ཚུལ་བ་བྱེ་བྲག་ཕྱེད་པའི་བརྩོན་འགྲུས་དང་ལྡན་པ་ཡིན་ཏེ།",
    "ཕྱིར་ཞིང་དེའི་བསམ་པའི་ཁམས་ཡོངས་སུ་དག་པར་འགྱུར་རོ།",
    "ལྷག་པའི་བསམ་པའི་ཁམས་དང་རྣམ་པར་༤༧མི་འབྲལ་ལོ།",
    "ནེམ་ནུར་མེད་པ་ཚལ་མངོན་སུམ་དུ་གྱུར་པ་ཡང་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "དགའ་བ་དང་བག་ཡངས་ཀྱང་ཡང་དག་པར་འབྱུང་ངོ།",
    "འཛིན་ཏོ་ཐོས་ནས་ཀྱང་ཅི་ཚུལ་དུ་ནན་ཏན་གྱིས་ཡང་དག་པར་སྒྲུབ་༡༢བོ།",
    "གསེར་གྱིཤེས་ལེ་སྦྲམ་དེ་ཉིད་མགར་བ་མཁས་པས་རྒྱན་དུ་བྱས་པ་ནི།",
    "དེ་མ་ཡིན་པའི་གསེར་གྱི་ས་ལེ་སྦྲམ་གཞན་རྒྱན་དུ་མ་བྱས་པས་མི་འཕྲོགས་ཤིང་མི་ཐུབལྒེཔ་ཡིན།",
    "ཕུལ་དུ་འགྱུརསདམ་པར་འགྱུར།",
    "བླ་ན་མེད་པར་འགྱུར།",
    "འདྲེན་པར་འགྱུར།",
    "ཡོངས་སུ་འདྲེན་པར་འགྱུར་བ་ནས།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་རྟེན་པའི་བར་དུ་འགྱུར་སྙམ་སྟེ།",
    "དེ་འདོད་ན་སྐད་ཅིག་ཡུད་ཙམ་ཐང་ཅིག་ཏུ་ཏིང་ངེ་འཛིན་ཁྲག་ཁྲིག་རབ་ཏུ་ཐོབ་ཅིང་དེ་དག་ལ་སྙོམས་པར་འཇུག་པ་དང་།",
    "བསྐལ་པ་ཁྲག་ཁྲིག་དུ་གནས་པར་བྱ་བ་དང་།",
    "བསྟནཚྭ་པར་བྱ་བའི་ཕྱིར་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་སྨྲས་སོ།",
    "ས་གསུམ་འོད་བྱེད་པ་ལ་ཤིན་ཏུ་སྦྱངས་བྱས་ཤིང་།",
    "རྒྱན་དུ་བྱས་པའི་གསེར་ལྟར་མི་འཕྲོགས་ཐུབ་པ་མེད།",
    "རྣམ་པར་བཟློག་པར་བདུད་རྣམས་བྱེ་བས་མི་ནུས་ཏེ།",
    "གཞན་དུ་མི་སེམས་ཤིན་ཏུ་མཉམ་པར་གཞགརྭ་པས་མཐོང་།",
    "དེ་ལ་མཆོད་བྱས་བདེ་འགྲོའི་ལམ་དུ་འགྲོ།",
    "དེ་ལ་མཆོད་བྱས་སྡུག་བསྔལ་ཐམས་ཅད་འབྱང་སྟེ།",
    "དེ་ལ་མཆོད་བྱས་རྒྱལ་བའི་ཡེ་ཤེས་འཐོབ།",
    "རྒྱལ་བ་མཁའ་ལྟར་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་སྐད་དབྱངས་སུ་བརྗོད་བྱས་ནས།་",
    "དེ་སེམས་ཀྱི་བསམ་པ་རྣམ་པར་དག་པའིཁུམཉམ་པ་ཉིད་བཅུས་འཇུག་གོ།",
    "སེམས་ཀྱིསཅབསམ་པ་རྣམ་པར་དག་པ་མཉམ་པ་ཉིད་དང་།",
    "ལྟ་བ་དང་ནེམ་ནུར་དང་དོགས་པ་བསྩལསྙིབས་བསམ་པ་རྣམ་པར་དག་པ་མཉམ་པ་ཉིད་དང་།",
    "ལམ་དང་ལམ་མ་༧ཡིན་པ་ཤེས་པས་བསམ་པ་རྣམ་པར་དག་པ་མཉམ་པ་ཉིད་དང་།",
    "ནན་ཏན་དང་སྤོང་བ་ཤེས་པས་བསམ་པ་རྣམ་པར་དག་པ་མཉམ་པ་ཉིད་དང་།",
    "ལྷག་པའི་བསམ་པ་ཤིན་ཏུ་སྦྱངས་པས་དེའི་གོང་དུ་ལམ་གྱི་ཁྱད་པར་ཚོལ་ཞིང་དེ་བཞིན་ཉིད་ཀྱི་རྗེས་སུ་ཞུགས་པ་དང་།",
    "འདི་ནི་སྡུག་བསྔལ་འགོག་པར་འགྲོ་བའི་ལམ་འཕགས་པའི་བདེན་པ་ཞེས་བྱ་བར་ཡང་དག་པ་ཉེཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་ཏེ།",
    "རྣམ་པར་དབྱེ་བའི་བདེན་པ་ལ་མཁས་པ་ཡིན།",
    "ཕུང་པོ་དང་ཁམས་དངསེསྐྱེ་མཆེད་རྣམ་པར་དགོདསཔས་རྟོག་པའི་བདེན་པ་ཡང་རབ་ཏུ་ཤེས་སོ།",
    "བྱིས་པ་འདྲིད་པར་ཡང་དག་པ་ཏུཉེཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་ཏེ།",
    "དེ་ལྟར་ལུས་གྲངས་མེད་པ་ཞིག་འགགས་ལ་འགག་༧༧པར་འགྱུར་ཞིང་འགག་བཞིན་ཏེ།",
