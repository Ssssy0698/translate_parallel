    "ཧོར་དམག་བོད་དུ་འབྱོར་ནས་མོན་མཁར་མགོན་པོ་གདོང་བཅོམ།",
    "མན་ངག་གི་བེའུ་བུམ།",
    "དེར་སྐྱ་རའི་གནས་དྲུག་གི་ཡ་གྱལ་ཁྲི་འདུ་སྐལ་བཟང་ཇོ་བོ་གཟི་འོད་འབར་བ་བཞུགས།",
    "དཔོན་ཆེན་ཤཱཀྱ་བཟང་པོས་ས་སྐྱའི་ལྷ་ཁང་ཆེན་མོ་བཞེངས་མགོ་ཚུགས།",
    "རྒྱ་ནག་རི་བོ་རྩེ་ལྔ་རྟག་བདེ་གླིང་གི་དགོན་བདག་མཛད་ནས་ལོ་གཉིས་བཞུགས། འཕགས་པས་སོག་ཡིག་གསར་བཏོད་མཛད།",
    "རྒྱལ་པོས་མོ་རྩིས་བྱས་ཏེ་དམ་པ་སྤྲུགས་པའི་བྱད་ཁར་ཤེས་ནས་སླར་གདན་དྲངས།",
    "ཟླ་བཞི་པར་ཧོར་སེ་ཆེན་འདས་ནས་ཨོལ་ཇོ་ཐུའམ་ཁྲིན་ཙུང་གིས་རྒྱལ་ས་བཟུང་།",
    "རབ་མདའ་ཤིང་ཡོས་ལ་སྐྱེད་ཚལ་བླ་༡༨༢ རབས་བཞི་བ་སྐུ་ཕྲེང་གཉིས་པ་རྒྱ་རོང་མཁྱེན་རབ་ཡེ་ཤེས་དགུང་གྲངས་བཅུ་དགུ་པར་འདས། སྐྱེད་ཚལ་བླ་རབས་ལྔ་བ་སྐུ་ཕྲེང་གསུམ་པ་དུང་གི་ཞལ་ཚོམཅན་འཁྲུངས།",
    "སྐྱེད་ཚལ་བླ་རབས་ལྔ་བ་སྐུ་ཕྲེང་གསུམ་པ་དུང་གི་ཞལ་ཚོམ་ཅན་དགུང་གྲངས་དྲུག་ཅུ་ཐོག་འཇའ་དམར་དང་དབྱེ་བྲག་གནས་སྒོ་ཕྱེས།",
    "མི་ཉག་གི་གདུང་རིགས་དང་ཡབ་རྨ་སེ་རྒྱ་གར།",
    "སྐྱེད་ཚལ་བླ་རབས་༡༨༥ ལྔ་པ་སྐུ་ཕྲེང་གསུམ་པ་དུང་གི་ཞལ་ཚོམ་ཅན་དགུང་གྲངས་བརྒྱ་དང་བརྒྱད་ལ་འདས།",
    "དུལ་མོ་བཀྲ་ཤིས་འོད་ཟེར་སོགས་ཀྱིས་བསུ་མ་རྒྱ་ཆེན་མཛད།",
    "ཞོམ་དགོན་ས་འོག་སོང་སྐབས་མཉན་པའི་སྐུ་ལ་ཅི་ཡང་མ་གནོད་པས་གྲུབ་ཐོབ་མཉན་པ་ཞེས་རྒྱ་བོད་གཉིས་ལ་གྲགས།",
    "འཇམ་དབྱངས་བཞད་པའི་རྡོ་རྗེ་བསྟན་རྩིས་རེའུ་མིག་བརྩམས་ཤིང་བཀྲ་ཤིས་འཁྱིལ་དུ་རྒྱུད་གྲྭ་༡༩༤ བཙུགས།",
    "སོག་པོ་ཇུན་གར་བའི་དམག་གིས་བོད་དུ་ཡོད་པའི་རྙིང་དགོན་མང་ཆེ་བ་གཏོར།",
    "སྦྱིན་བདག་དྲག་ཞན་ཀུན་གྱིས་གདན་ཞུ་འབུལ་བ་དང་ལྷག་པར་འཛོམ་ཉག་རྒྱ་པ་ཚང་གིས་གདན་དྲངས་ཏེ་ཞག་ལྔ་ལ་རབ་གནས་དང་བུམ་གཏེར་འཇུག་པ།",
    "དེའི་ཞོར་དུ་འབྲུག་པ་ལྷ་ཁང་ཚང་གི་པད་དཀར་ལྷུན་གྲུབ་སོགས་ཀྱིས་ལྷ་ཁང་བསམ་འགྲུབ་རྒྱ་མཚོར་གདན་དྲངས་ནས་ཞབས་ཏོག་འབུལ་བ་སོགས་ལ་བསྔོ་སྨོན་བཀྲ་ཤིས་མཛད་ནས་སླར་འཛོམ་ཉག་ཏུ་ཕེབས།",
    "ཞིག་གཉིས་བཞུགས་ཏེ་མཆོད་རྟེན་ལ་ཉམས་གསོ་དང་སྐོར་ལམ་དུ་མ་ཎི་ལག་སྐོར་བརྒྱ་ཚར་ཞིག་གི་ཉམས་གསོའི་སྦྱིན་བདག་བསྐུལ།",
    "དྭའུ་སྟོད་ཀྱི་སྤར་ཐང་གི་ཚེ་ལུང་དང་སྦི་དིས་སུམ་འབུམ་མདའི་ན་ཁ།",
    "དེ་ནུབ་ཁོང་གི་མཆོད་དཔོན་སོགས་ལས་ཚན་རྣམས་བབ་ཐོབ་ལ་གཞིགས་པའི་གནང་སྦྱིན་དགའ་མགུ་ཡི་རངས་བ་མཛད།",
    "སྒར་པ་ཚོ་བགོས་པ་ལས་ཁོང་གི་སྒར་ཐོག་ཏུ་དཔོན་གཡོག་དོན་ལྔ།",
    "ཚེས་ཉེར་དྲུག་ཉིན་གཞི་ནས་སྒར་རྗེས་མ་རྣམས་འབྱོར་ཏེ་རི་ཀླུང་ཐམས་ཅད་རྟ་དྲེའུ་དང་མཛོ་གཡག་གིས་གང་བས་ཐམས་ཅད་ཧ་ལས་པ་བྱུང་།",
    "ཟླ་བརྒྱད་པའི་ནང་གོང་ས་མཆོད་ཡོན་ལྷན་རྒྱས་གཙང་དུ་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་གཟིགས་དང་ཡབ་སྲས་ཞལ་འཛོམས་དུ་ཕེབས་པར་ཆིབས་བསུ་སེར་སྦྲེང་དང་ཞབས་བརྟན་སོགས་ལེགས་པར་འབུལ་དགོས་པའི་བཀའ་འབྱོར།",
    "ཟླ་ལྔ་པའི་མགོར་ཨེ་ནས་བྱུང་བ་དང་ཞ་ལུའི་ལྷ་བཟོ་གཅིག་བཅས་ལ་མགོན་ཁང་སོགས་སུ་ལྷ་གྲངས་མང་བཞེངས་སུ་བཅུག་པ་ལས་ཁམས་ལྡན་མའི་སྤྱི་ཁང་དུ་ཉིད་དང་སྒ་ཨ་མཉན་དམ་པའི་སྐུ་བརྙན་མདའ་ཚད་ཙམ་ཞིག་ཀྱང་བཞེངས་སུ་བཅུག།",
    "བསྟན་པ་ཚེ་རིང་གི་སྲས་ཕུན་ཚོགས་བསྟན་པ་ལྷ་ལྡན་དུ་འབྱོར།",
    "ཁྲི་འདུ་སྐལ་བཟང་དགོན་དང་གདོང་འཕྲེད་བསམ་གཏན་གླིང་གི་ཆིབས་བསུ་འབྱོར།",
    "སྒ་ཁྲི་འདུ་སྐལ་བཟང་དགོན་དང་གདོང་འཕྲེད་བསམ་གཏན་གླིང་གི་བསུ་བ་འབྱོར།",
    "རག་སྣར་ཡོན་བདག་མི་རྒན་ཞིག་གི་བུ་འཆི་ལ་ཁད་ཡོད་སར་ཞུ་ནན་ཕུལ་བས་ཕེབས།",
    "བླ་བྲང་གིས་གཙོས་འབྱོར་ལན་ཟླ་བ་གཉིས་པའི་ནང་འབྱོར།",
    "ཟླ་གཉིས་པའི་ནང་ཁོང་གི་ཞབས་གཉིས་ལ་སྐྲངས་པ་ཐོར་བུ་བྱུང་ནས་ཟླ་ཕྱེདགཉིས་ཙམ་བསྙུང་།",
    "རྒྱབ་སོར་ས་ཐག་གིས་ཆོད་པས་ཤིན་ཏུ་འགྱོད་པ་བྱུང་གསུངས།",
    "གཙུག་ལག་ཁང་གི་ལྡེབས་རིས་གཙོ་བོར་བླ་ཆེན་འཕགས་པ་དང་།",
    "སྦྱིན་བདག་ཁེས་པ་ཁག་དང་སྤུ་རུ་ཁག་གིས་ཞབས་ཏོག་ཞུས།",
    "ཁམས་ཇོ་རག་ཉག་གི་གཙུག་ལག་ཁང་དུ་ཞག་གཅིག་བཞུགས།",
    "གཙང་ཁང་ཆེན་མོར་འཁོར་ལོ་བདེ་མཆོག་ཐོག་དཔངས་དང་མཉམ་པ་ལ་ཕྱག་ཆེན་བླ་བརྒྱུད་མི་ཚད་ཆུང་ཙམ་གཟི་འོད་འབར་ཞིང་ཉམས་དོད་པས་བསྐོར་བ།",
    "རག་ཞུལ་ཁར་སྟག་གིས་གདན་ཞུ་དང་མཚོ་ནག་མར་མཚོ་རྫས་ཕུལ།",
    "ཟླ་གཉིས་པའི་མཇུག་ནང་གི་ལྷ་རྟེན་དང་ལྡེབས་རིས་སོགས་རན་པ་ལ།",
    "བྱམས་པ་གསུམ་ཐོག་ཚད་ཕྱེད་གཉིས་རེ།",
    "སྐྱེ་རྒུ་དོན་གྲུབ་གླིང་གི་ལྷ་ཁང་རབ་གནས་སུ་འབྱོན་དགོས་པའི་དགོངས་ཞུ་མཛད།",
    "རིམ་བཞིན་གྲུ་ལས་བུད་དེ་འཇོག་གེ་དང་ཐང་ལེ་བ་རྨིས་མུ་བ་འགག་ལ་སྐྱོར་གེ་དགོན།",
    "སྐྱེ་རྒུ་དོན་གྲུབ་གླིང་པའི་དགེ་སློང་ཚེ་མཚམས་རུས་ལུམ་མོ་ཅན་རིན་ཆེན་བཟང་པོ་ཞུ་བ།",
    "བྲག་དངོས་གཞི་ལ་མའི་པང་དུ་ལོན་ཙམ་ལ་སྐུ་རྟེན་དེ་ཉིད་ཁྱུད་གང་གི་ཚད་ཙམ་འབུར་དུ་ཡོད་པ་ཤིན་ཏུ་སྒྲོས་པ་ཞིག་མཆིས་གསུངས།",
    "བཙུན་མ་ཀུན་དགའ་དཔལ་མོ་ལ་ནལ་བུ་ཞིག་ཡོད་འདུག་པ་ཕ་སྐོར་རྣམས་ཀྱིས་སླར་ཡང་མ་བུ་གཉིས་ཆ་ལ་སྐྲ་ཕུད་དགོས་ཚུལ་དང་མཉམ་དུ་བྱས་ན་ངོ་གནོང་ཚུལ་ཟེར་འདུག་པས།",
    "ཁོང་གི་གཉེར་རྒན་ཀུན་དགའ་དཔལ་ལྡན་ལ་བསྙུང་གཞི་ཐུ་མོ་ཕོག་པ་ཕྱག་མཛོད་སྒར་དུ་བཞག་ནས་རྗེས་ཀྱི་བྱ་བ་རྣམས་བསྒོས།",
    "ཁུ་ཐོག་ཡོན་བདག་རབ་བརྟན་དང་བསྟན་འཛིན་ཁག་གིས་ཞབས་ཏོག་ཞུས།",
    "དཔོན་སློབ་ཉུང་ཤས་ཀྱི་ལ་སྔོན་ལ་བརྒལ་ཏེ་དཔལ་འབྲི་གུང་ཀའི་བཀྲ་ཤིས་སྒང་གི་གཙུག་ལག་ཁང་ནས་མཆོད་འབུལ་དང་སེར་སྐྱ་བྱིངས་ལ་རྗེས་གནང་མཛད་དེ་ཀྲེ་ཁུའི་གྲོང་དུ་བཞུགས།",
    "ཕྱི་ཉིན་འབྲི་ཆུ་གྲུ་ལ་བུད་དེ་འཛོམ་ཉག་བླ་དགོན་གྱིས་རྟ་བསུ་སེར་ཕྲེང་ཞུས་ཤིང་གྲུབ་ཆེན་སྤྱི་ཏི་ཛྙཱ་ནའི་མཆོད་རྟེན་མོའི་ལྷ་ཁང་གསར་བཞེངས་སུ་སྒར་བབས་ཡོནབདག་རྒྱ་ཚང་དང་།",
    "ཡོན་བདག་རྨེ་ཤིས་ཚང་གི་མི་ཞིག་ཤི་བར་ལམ་སྟོན་མཛད།",
    "ལ་ཕར་ནང་དུ་སྤྱང་ཁུ་བུ་ཚང་གི་མི་ཞིག་ཤི་བར་ཁྲུས་ཆོག་གནང་།",
    "མི་ངན་ཞིག་གི་དོན་དུ་གླིང་བར་པའི་སྐུ་ཚབ་ཁ་ཤས་བཅས་སོ་སོའི་འདོད་པ་མ་གཅིག་པའི་འཁྲུག་རྩོད་འོང་གྲབས་དེ་བར་མཚམས་དང་ཆོད་ཁྲུས་བདེ་བར་བཏང་།"
  ]
}