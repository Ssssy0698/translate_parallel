    "ཕན་ཐོགས་ཀྱང་ཆེན་པོ་བྱུང་ཞེས་ཡིག་ངག་གཉིས་ཐོག་ནས་སྔ་ཕྱིར་ཞུས་འདུག་ཁ་",
    "བློ་བདེ་བག་ཕེབས་མི་ཡོང་བའི་དཀྲོག་གཏམ་མང་དག་ཅིག་ཆགས་འདུག་ཅ་",
    "ཐའེ་ཝན་ནི་ལོག་སྨོན་དགྲ་བོ་གོ་མིན་ཏང་ཞེས་བཀོད་འདུག་ཀྱང་།",
    "བོད་ནང་རང་རིགས་སེར་སྐྱ་མང་བོས།",
    "ཐུགས་སྣང་ཆེན་པོས་རྩད་གཅོད་དང་བརྟག་ཞིབ་ནན་ཏན་གནང་འདུག་ལ།",
    "གོང་ཞུས་ལ་ཧེ་བག་མེད་པ་མནའ་ཡང་བསྐྱལ་འདུག་པར།",
    "ས་གཞི་རྡུལ་དག་བྱུང་ཡོད་འདུག་ང་",
    "༦༥ བྱུང་ཡོད་འདུག་ཅིང་།",
    "བོད་དང་རྒྱ་ནག་པོ་གཉིས་འདྲ་མཉམ་ལོས་ཡིན།",
    "ཡང་༨༩ ཟླ་༨ཚེས་༡ ཉིན་རྡ་སར་བཅར་དགོས་བཀའ་ཕེབས་འདུག་པ་དུས་ཐོག་བཅར་ཐུབ་མིན་གྱིས་སྔོན་ནས་ལྕགས་འཕྲིན་ཕུལ་ཏེ་༨༩ ཟླ་༨ ཚེས་༡༩ སོ་སོར་སྔ་སར་སྤྱི་འཐུས་ལྷན་ཁང་དུ་སྐུ་བཅར་ཞུས།",
    "ཡིན་ནའང་ང་རང་བོད་མི་གཅིག་ཡིན་པ་དང་།",
    "འདིའི་ཐོག་ང་རང་བོད་མི་མང་སྤྱི་འཐུས་ནས་བཀའ་འགུགས་གནང་བ་ལྟར།",
    "༨༩ ཟླ་༡ ཚེས་༣ བར་སྒུག་དུས་ཞུས་པ་ཡིན།",
    "དེ་ནུས་མེད་དུ་གཏོང་རྒྱུའི་གདོང་ལེན་བྱེད་པ་བཅས་ཀྱི་སླད་དུ་ང་རང་སྒེར་གྱིས་རང་སྲོག་ཕུལ་ཏེ་དང་བླངས་ཀྱིས་ཞུས་པ་ཞིག་ཡིན།",
    "ཁོ་པ་རྒྱ་རི་ཚང་དཀར་པོ་བཟོ་ཐབས་ཡིན་པ་གསལ་པོ་འདུག་གང་ཡིན་ཟེར་ན།",
    "དེ་ནས་ཚོགས་གཙོས་ད་ཆེ་པདྨ་རྒྱལ་པོ་ཁྱེད་རང་ནས་ཡིན་མིན་གྱི་གནས་ཚུལ་གསལ་ཞུ་དགོས་ལུགས་གསུངས་སྟབས།",
    "ཁོ་རང་སྒེར།",
    "སྐུ་ངོ་ཁྱེད་རང་ཐུགས་ཁག་མེད།",
    "ད་ཆ་གནས་ཚུལ་འདི་ངོ་བོ་ཇི་འདྲ་ཞིག་ཆགས་མིན་ཤེས་ཐུབ་པ་ཁག་པོ་འདུག་ཅེས་ཞུས།",
    "སླད་ནས་ཀྱང་འཇུ་ས་འཆང་ས་མེད་པ་ཆགས་རྒྱུ་རང་མིན་ནམ་སྙམ་སྟེ་རྒས་པོ་གཉིད་མི་ཁུག་པ་བྱེད་ཀྱི་འདུག་ལས་འགན་མེད་པ་ཆགས་ཚར་ནས་བར་ལམ་དེར་ཨ་འོ་ཙམ་མི་ཡོང་ངམ་སྙམ་པས་བློ་བདེ་པོ་ལྟ་བུ་སྡོད་ཆོག་པ་བྱུང་།",
    "ད་ལྟའི་ཡུལ་ཐང་ཛ་འབབ་ལ་གཞིག་ན་ཧིན་སྒོར་འབུམ་དགུ་ལྷག་ཙམ་བྱུང་འདུག་པ།",
    "སྐབས་ནས་བྱུང་འདུག་དེ་མིན་འབོར་ཆེ་བ་རྒྱ་རི་པདྨ་རྒྱལ་པོ་སྒེར་གྱིས་ཉར་ནས་འདུག་པ་བཅས་དང་།",
    "གསང་བ་ཕྱིར་བསྒྲགས་ཀྱི་གཏམ་ཤོད་ཕྱོགས་བཅས་ཀྱི་ནག་ཉེས་འགལ་འཛོལ་ཞིབ་འབྲི་བྱ་ཚོད་མེད་པ་ལྟ་བུ་ཆགས་འདུག།",
    "ཞུ་བ་ཀྲེབ་ཐོག་ཏུ་བླངས་འདུག་པ་དང་།",
    "འགྲིགས་མི་འདུག་ཅེས་ཞུ་དགོས་བཀའ་ཤག་ནས་མཁྱེན་དགོས་པ་ཞིག་ཆགས་ཡོད་ལུགས་གསུངས་པར།",
    "ང་རང་བཅས་མི་བཞི་ཡོད་ཟེར།",
    "གོ་ལག་སྤྲད་འཐུས་ཟེར་འདུག་ཀྱང་།",
    "དེ་རྗེས་དངུལ་སྤྲོད་འཐུས་ཟེར་བ་ལས་གོ་ལག་ཉོ་དགོས་ཟེར་འདུག་པ་ལྟར་གོ་མཚོན་ཕྲན་བུ་ཉོས་ཡོད་པ་དང་།",
    "ཐའེ་ཝན་ནས་རྒྱ་མི་རིགས་གཅིག་ནས་གཅིག་གསོད་འདོད་མེད་ལུགས་ཟེར་འདུག་འབར་མ་དང་།",
    "ཚུར་ཡག་པོ་བྱེད་ཀྱི་མི་འདུག་ལུགས་དང་།",
    "རྩ་བའི་ང་རང་དང་།",
    "མི་དགོས་ཀྱི་འདུག་པ་མིང་ཐོར་ཁྱེད་རང་བཅུག་ན་ཟེར་འདུག་པར་བློ་བཟང་སྦྱིན་པ་འཇུག་དགོས་བརྗོད་པ་དྲན་བྱུང་ཟེར།",
    "པདྨ་རྒྱལ་པོ་ནས་མ་འགྲིགས་པའི་སྐོར་བདེ་སྲུང་དྲུང་ཆེ་ནས་གསུང་དགོས་པ་བྱུང་མི་འདུག་གསུངས།",
    "ངས་བྱས་ན་ཚོགས་པ་བཙུགས་ན་དགེ་མཚན་འདུག་ཅིང་།",
    "མི་འགྲོ་པདྨ་རྒྱལ་པོ་དགོས་གལ་མི་འདུག་པདྨ་རྒྱལ་པོ་ནས།",
    "བདེ་སྲུང་བར་དུ་ལྷག་པ་ལྟ་བུ་འདུག་ཅིང་གང་ལྟར་བཀའ་ཤག་ནག་ཁུང་ནང་བཞག་འདུག་ཟེར་ནས།",
    "པདྨ་རྒྱལ་པོ་ཁྱེད་རང་ནས།",
    "རྩ་བའི་འཆར་གཞི་ཁག་ལྔ་ཕུལ་འདུག་ཀྱང་།",
    "འཆར་གཞི་ཆེ་བའི་རིགས་གང་ཡང་མི་འདུག་ཟེར།",
    "༧གོང་ས་མཆོག་ལ་བཅར་ཏེ་བཀའ་འཁྲོལ་ཐོབ་བྱུང་ལ་ང་རང་ཕྱིན་ནི་སྐད་མི་ཤེས་པའི་ཆ་ནས་པདྨ་རྒྱལ་པོས་མགོ་སྐོར་གཏོང་དོགས་ཡོད་ཅེས་བཀའ་ཤག་ལ་ཡང་བཅར་ཏེ་འགྲོ་མ་དགོས་པ་ཞུས་ཤིང་།",
    "གྲོང་གསར་བློ་བཟང་ནས་རྡ་སར་ཡོང་སྟེ་གོང་ས་མཆོག་མཇལ་བཅར་དང་དེ་བཞིན་བཀའ་ཤག་ཏུ་བཅར་ཆོག་པ་ཞུ་འདུག་པ་དང་།",
    "གཟིམ་ཆུང་ནས་དྲིལ་བསྒྲགས་སུ་གཏོང་དགོས་བཀའ་ཕེབས་འདུག་པར།",
    "ཕྱི་ནང་ཚང་མས་ཤེས་ཀྱི་ཡོད་སྟབས་བཀའ་ཤག་དེ་བས་ཀྱང་བློ་བདེ་མི་འདུག་ཅེས་གསུངས།",
    "པདྨ་རྒྱལ་པོས་བཀའ་ཤག་ལ་ཞུ་ལོག་བྱུང་ལུགས་བློ་ཕམ་བྱེད་ཀྱི་འདུག་པར།",
    "ར་སྤྲོད་བྱས་ན་ཇི་འདྲ་འདུག་ཅེས་དྲིས་པར་ཁོང་གཉིས་ཐུག་སྟེ་ལམ་རོབ་ར་སྤྱོད་བྱས་པ་ཡིན་གསུངས།",
    "མཚན་ཤས་བྱུང་འདུག་གསུངས།",
    "༧གོང་ས་མཆོག་ནས་ངོ་བཤུས་བཀའ་ཤག་ཏུ་སྩལ་ཡོད་ཅེས་བཀའ་ཕེབས་པ་ལྟ་བུ་ཞིག་ལམ་རོབ་དྲན་གྱི་འདུག་ཀྱང་།",
    "ཅིག་ཞུས་པ་དྲན་མཁན་ལྟ་བུ་བྱེད་ཀྱི་འདུག་སྐུ་སྒེར་ཡིག་ཚང་ནས།",
    "དྲིས་པར་གསང་བ་ཐུབ་ལུགས་ཞུ་ཡི་འདུག་ཅེས་གསུངས་བྱུང་བ་ལྟར་གསང་རྒྱུ་བྱས་པ་ཡིན།",
    "དེ་རྗེས་པདྨ་རྒྱལ་པོས་སྤྱི་འཐུས་ལྷན་ཚོགས་སུ་དངུལ་བླངས་མེད་ལུགས་ཞུས་མི་འདུག་པ་དང་།",
    "རྒྱ་རི་བློ་གྲོས་རྒྱལ་མཚན་ནས་ཀྱང་ཨ་ཐར་ཅན་ལ་གསུངས་འདུག་པ་བཅས་གསང་བ་ཕྱིར་བསྒྲགས་བྱེད་འདུག་ལུགས་གསུངས།",
    "གོ་མིན་ཏང་གཅིག་པུར་ཟུར་དུ་ལས་དོགས་ཀྱིས་ཡིན་ཚོད་འདུག་ཟེར།",
    "བྷོམ་འབེས་ནས་ལེན་འཐུས་ཟེར་འདུག་པར་ལག་ལེན་འཁེལ་མེད།",
    "པདྨ་རྒྱལ་པོ་ནས་ཀྱང་འཆར་གཞི་སྤྲད་རྗེས་དངུལ་ཇི་བྱུང་གསལ་པོ་བརྗོད་དེ་བདེ་སྲུང་ལ་འབུལ་དགོས་པ་བཅས་བྱུང་མེད་པ་གཉིས་ཀས་ནོར་འདུག་འགྲིགས་མི་འདུག་གསུངས།",
    "བདེ་སྲུང་ནང་འཆར་གཞི་དང་རྩིས་ཁྲ་བྱུང་འཛིན་བཅས་མེད་པ་ནོར་འདུག་གསུངས།",
    "དེ་བཞིན་དྲུང་ཆེ་གཉིས་ནས་རྩིས་ཞིབ་ཡག་པོ་བྱུང་མི་འདུག་ཅིང་།",
    "ང་རང་ཉམས་མྱོང་མེད་པས་སྐྱོན་བྱུང་འདུག་ཅིང་།",
    "བྱམས་པ་སྐལ་ལྡན་གྱིས་ཁྱེད་རང་ལ་ཡིད་ཆེས་ཡོད་གང་འདྲ་གཏོང་དགོས་ནའང་གཏོང་འཐུས་གསུང་བྱུང་།",
    "ལག་ཐོག་ཏུ་ཨ་སྒོར་༣༧ ༩༨ ཡོད་འདུག་པའི་ཐོག་ཨ་སྒོར་ལྔ་ཁྲིའི་འཕྲོས་ཨ་སྒོར་༣༥༦༨ ཡང་ཡོད་འདུག་པ་སོགས་ཞིབ་གནས་རྩིས་ཁྲ་ཡིག་ཁག་ནས་གསལ་མཁྱེན་ཡོང་རྒྱུར་འདིར་འགོད་ངལ་མ་བྱས།",
    "དངུལ་དང་པོ་༡༩༨༣ ཟླ་༩ ཚེས་༢༢ ལ་བྱུང་འདུག་པ་བདེ་སྲུང་ལ་མ་གནང་པར་པདྨ་རྒྱལ་པོ་ནས་ཉར་ཚགས་བྱས་པ་འགྲིགས་མི་འདུག་ཅིང་།",
    "༡༩༨༤ དང་༡༩༨༥ དངུལ་ཁོངས་ནས་དེབ་པར་བསྐྲུན་ཐོག་བཏང་འདུག་བདེན་པ་ཡིན་སྲིད་ནའང་འགྲིགས་མི་འདུག་གསུངས།",
    "རྩིས་ཐོག་སྒེར་ལ་ཕྱིན་པའི་རིགས་བྱུང་ཚེ་ང་རང་སྒེར་ཐོག་ནས་འགན་འཁྱེར་རྒྱུ་ལས།",
    "རྩིས་ཁྲ་ཉར་སྟངས་ཀྱང་ཉམས་མྱོང་མེད་པས་སྐྱོན་བྱུང་འདུག་ཟེར།",
    "བདེ་སྲུང་དང་འབྲེལ་བ་བྱེད་སྟངས་སོགས་འགྲིགས་མི་འདུག་པ་དང་།",
    "དངུལ་བདེ་སྲུང་ལ་བཏང་བའི་བྱུང་འཛིན་དགོས་ལུགས་ཟེར་འདུག་པ་ལྟར་བདེ་སྲུང་ལ་ཞུས་པ་ཡིན་ཞུས།",
    "པདྨ་རྒྱལ་པོ་ལའང་ཐའེ་ཝན་ནས་འབྲེལ་བ་ཉུང་དུ་ཕྱིན་འདུག་ཐའེ་ཝན་ནས་བྱུང་འཛིན་དགོས་ལུགས་ཟེར་བ་དང་།",
    "ཐའེ་ཝན་གྱིས་བྱུང་འཛིན་དགོས་ལུགས་ངག་ཐོག་ནས་ཟེར་འདུག་པ་དང་།",
    "གསུམ་ཆ་གཉིས་དོན་གཅོད་ནས་བཏང་འདུག་པ་སོགས་ཉིས་ཟློས་ཡོད་མེད་ཀྱང་ཞིབ་འཇུག་དགོས་ཀྱི་འདུག་གསུངས།",
    "༡༩༨༢ ལོ་ནས་བཀའ་འཁྲོལ་དང་གལ་ཆེའི་རིགས་བཀའ་བློན་ལ་ཞུ་དགོས་པའི་ཆ་ནས་ཞུས་མི་འདུག་གསུངས་པར།",
    "དངུལ་གྱི་གྲངས་འབོར་ཇི་འདྲ་འདུག་སོགས་ཞིབ་རྩིས་མུ་མཐུད་ནས་གནང་རྒྱུ་ཡིན་ལུགས་ཞུས་པ་ཡིན།",
    "བདེ་སྲུང་བཀའ་བློན་འཇིགས་མེད་ལྷུན་གྲུབ་ཀྱི་ཕྱག་ཏུ་དངུལ་ལྷག་འདི་ཙམ་འདུག་རྩིས་ཁྲ་གཙང་མ་འདུག་ཅེས་ཞུ་ཕྱོགས་གནང་བ་ཡིན།",
    "བྱེད་སྟངས་མ་འགྲིགས་པས་སྐྱོན་འདུག་མ་འོངས་པར་བཀའ་ཤག་ནས་འགན་འཁུར་དགོངས་བཞེས་བཀོད་སྒྲིག་ལམ་སྟོན་གནང་དགོས་པ་ལས།",
    "དངུལ་དགོས་ཀྱི་འདུག་ལ་དངུལ་ལ་དགའ་པོ་ཡང་ཡོད།",
    "རང་གཞུང་གཙང་མ་ཡིན་པ་གསལ་པོར་འཁོད་འདུག་སྟབས་ཤིན་ཏུ་དགའ་པོ་བྱུང་ཞུ།",
    "དྲིལ་བསྒྲགས་མཚན་ཐོག་ནས་གནང་དགོས་ཕེབས་འདུག་པ་དགོངས་མཇགས་ཞུ།",
    "གངས་ཅན་སྐྱིད་གཤོངས་བྱང་ཐང་སྟོང་པ་དང་མཚུངས་པ་བྱེད་འདུག་ང་རང་ཐའེ་ཝན་དུ་འགྲོ་མྱོང་།",
    "དེའང་གཞུང་འབྲེལ་ཐོག་ནས་ཞུ་རྒྱུ་ཡིན་ཞེས་བཀོད་འདུག་ཀྱང་།",
    "ད་དུང་རང་ཉིད་ནས་ངོས་ལེན་མ་བྱས་པ་དང་།",
    "རྒྱ་རི་བློ་གྲོས་རྒྱལ་མཚན་ཁོ་རང་བཀའ་བློན་ཡིན་ན།",
    "ཨ་ཁ་ཟེར་གྱི་འདུག་ཨེ་བདེན་ལྟོས་དང་།",
    "ཁོ་རང་༧གོང་ས་མཆོག་མཇལ་ཁ་ཞིག་ཐོབ་ཐབས་ཡང་ཡང་ཞུས་པ་དང་།",
    "ངོས་ཀྱིས་ཁྱེད་རང་མཇལ་ཁ་ཡོང་ཐབས་ངའི་ཐོག་ནས་ཞུ་ཕོད་ཐབས་མེད་གནས་དང་།",
    "ཁུངས་སྐྱེལ་མ་ཐུབ་ན་ཁྱེད་རང་མི་སྒེར་ལ་དེ་ཙམ་ཁྱད་པར་མེད་ནའང་།",
    "ཤར་ཨེ་ཤ་ཡའི་དོན་གཅོད་བཅས་ཀྱི་སྲུང་སྐྱོབ་ཆེད་བདེ་སྲུང་ནས་སྲུང་བྱ་བྱེད་དགོས་པའི་བཀའ་མངགས་གནང་ཡོད་འདུག་དེ་ནི་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་དང་།",
    "ཚེས་༢༩ ཉིན་ཉི་ཧོང་དུ་ཡོད་པའི་ཐའེ་ཝན་རང་བཙན་ཚོགས་པའི་རྒྱུན་ལས་པ་འགོད་པ་བཅས་ཟ་ཁང་ཞིག་ཏུ་ཐུག་ཚགས་འགོད་པ་གཉིས་ནས་དྲི་བ་དྲིས་ལན་བྱས་པའི་གནས་ཚུལ་ཚགས་ཤོག་ནང་འདོན་སྤེལ་བྱ་འདོད་བྱས་འདུག་ཀྱང་།",
    "འབྲེལ་བའི་གནས་སྟངས་དང་དངུལ་གྱི་རྩ་འབོར་ཙམ་ཡང་ད་བར་ཤེས་རྟོགས་མེད་པའི་འགལ་འཛོལ་ནོར་འཁྲུལ་ཆེ་ཙམ་བྱུང་འདུག་གསལ་བ་དངོས་འབྲེལ་ཡིན་ཡང་།",
    "གལ་ཆེ་འདི་རིགས་ལ་ཐུག་དུས་འཛེམས་ཟོན་སྤང་པའི་མཛད་འཁུར་བསྐྱེད་གལ།",
    "དམིགས་ཡུལ་བཟུང་འདུག་པ་དང་།",
    "སེན་ཊི་བརྒྱད་ཅུ་ཐམ་པ་བྱུང་ཡོད་འདུག་པ་དང་།",
    "གོང་གསལ་དངུལ་འབོར་ནས་ལས་བྱེད་སྒེར་གྱིས་ཟ་བེད་བྱེས་རིགས་བྱུང་མི་འདུག་ཀྱང་སྐབས་དེའི་དྲུང་ཆེ་བྱམས་པ་སྐལ་ལྡན་ནས་ཐོག་མའི་དགོས་དོན་མིགས་ཡུལ་དང་མཐུན་པའི་སྟངས་འཛིན་དང་།",
    "དངུལ་གྱི་རྩ་འབོར་བསྡོམས་གྲངས་ཙམ་ཡང་ད་བར་ཇི་བཞིན་ཤེས་རྟོགས་ཐུབ་མེད་པ་བཅས་ལས་བྱེད་རྒན་གྲས་ཤིག་ནས་དམིགས་དོན་དང་མཚུངས་པའི་ལས་དོན་བྱེད་སྒོ་ཇི་བཞིན་མ་བྱུང་བའི་འགལ་འཛོལ་ནོར་འཁྲུལ་ཆེ་ཙམ་བྱུང་འདུག་ཀྱང་།",
    "གོང་གསལ་དངུལ་འབོར་ནས་བདེ་སྲུང་ལ་ཨ་སྒོར་༥༨༥༤ བྱུང་བ་དེ་ལས་དངུལ་གྱི་རྩ་འབོར་བསྡོམས་གྲངས་བདེ་སྲུང་ནས་ཤེས་རྟོགས་བྱུང་མི་འདུག་པ་དང་།",
    "ལས་དོན་སྐོར་གྱི་གནས་ཚུལ་དགོས་ལུགས་པདྨ་རྒྱལ་པོར་ཡི་གེ་བཏང་འདུག་ཀྱང་།",
    "༢༣ ལས་དོན་ཐོག་བེད་གཏོང་གནང་འདུག་པ་ལས།",
    "སྒེར་བེད་གནང་རིགས་བྱུང་མི་འདུག་ཅིང་།",
    "ལས་དོན་དངོས་སུ་ལག་ལེན་བསྟར་སྐབས་འགན་གང་ཡང་གནང་བ་བྱུང་མི་འདུག་ཅིང་།",
    "ལས་དོན་ལག་ལེན་དངོས་སུ་བསྟར་སྐབས་ཀྱང་འགན་ཁུར་གང་ཡང་བྱུང་མི་འདུག་པས་ཉེས་འཛོལ་མེད་པར་ངོས་འཛིན་གནང་རྒྱུ།",
    "བདེ་སྲུང་དྲུང་ཆེ་བྱམས་པ་སྐལ་ལྡན་ནས་ཀྱང་ངག་ཐོག་ནས་པདྨ་རྒྱལ་པོར་བཀའ་འཁྲོལ་སྤྲད་ཚུལ་ཞུ་བ་ལས་ལུགས་མཐུན་ཡིག་ཐོག་སྤྲད་རིགས་བྱུང་མི་འདུག་༣",
    "འཆར་གསལ་ལྟར་ཐའེ་ཝན་གསང་ལས་ནས་ཨ་སྒོར་༩༤༧༢ པདྨ་རྒྱལ་པོར་སྤྲད་འདུག་ཀྱང་།",
    "བདེ་སྲུང་ལ་ཨ་སྒོར་༢༨༥༤ ལས་བྱུང་མི་འདུག་པ་མ་ཟད།",
    "འཆར་གཞི་དང་པོའི་ནང་སྒོར་༩༣༣༤༥ འཁོད་ཀྱང་དངུལ་འབབ་སྔ་རྗེས་གཉིས་ཁོངས་ཨ་སྒོར་༩༤༧༢ བྱུང་འདུག་པ་ཨ་སྒོར་༡༣༧༥ འཕར་ཐོལ་བཅས་བྱུང་ཁོངས་ནས་ཨ་སྒོར་༦༦༡༨ པདྨ་རྒྱལ་པོར་ཡོད།",
    "ལོ་གཉིས་པའི་འཆར་གསལ་སྒོར་༩༨༥༧ ལ་ཨ་སྒོར་ར་༧༧༧ པདྨ་རྒྱལ་པོར་བྱུང་འདུག་པའི་ཁོངས་ནས་བདེ་སྲུང་ལ་སྔ་རྗེས་གཉིས་བསྡོམས་ཨ་སྒོར་༣ བྱུང་བ་དང་འཕྲོས་སྒོར་༥༧༧༧ ཉི་ཧོང་དུ་པདྨ་རྒྱལ་པོར་བསྡད་འདུག་གོང་ཁག་གཉིས་བསྡོམས་ཨ་སྒོར་༡༢༣༧༥ པདྨ་རྒྱལ་པོར་ཡོད།",
    "དངོས་པོ་ད་ལྟའང་བེད་མེད་དུ་ལུས་འདུག་པར་ཆས་དང་།",
    "༢ བྱུང་ཡོད་པའི་འབོར་གྱི་རྩིས་ཁྲའི་ཁ་ཤོག་ནང་གསལ་རྩིས་འབོར་འགོ་ཐུག་བྱེད་འདུག་ཅིང་།",
    "དངུལ་ཁང་དུ་བཅུག་ན་གཞན་གྱིས་ཤེས་དོགས་ཀྱིས་འགྱིག་ཤོག་ནང་བཅུག་སྟེ་ཉར་ཚགས་བྱས་པ་ཡིན་ཞེས་ཞུ་འདུག་༡༩༨༦ ཕྱི་ཟླ་༡༡ ནས་བཟུང་ཐའེ་ཝན་ནས་དངུལ་འབྱོར་རིགས་བྱུང་མི་འདུག་ཅིང་།",
    "འབྱོར་ལན་ཞིག་གང་མགྱོགས་གཏོང་དགོས་ཞེས་གསལ་འདུག་ཀྱང་།",
    "གནས་ལན་གང་ཡང་བཏང་རིགས་བྱུང་མི་འདུག་པའི་ཁར།",
    "ད་དུང་འཆར་གཞི་ཁག་གཉིས་བཏང་འདུག་པར་འཆར་དོན་དངུལ་འབབ་བཏང་འབྱོར་བྱུང་མི་འདུག་པ་བཅས་ལ་བརྟེན།",
    "པདྨ་རྒྱལ་པོ་ཁྱེད་རང་ནས་ཚོགས་པ་ཚུགས་མ་ཐུབ་པའི་རྐྱེན་གྱིས་གསང་ལས་དང་འབྲེལ་བ་ལ་ཤུགས་བསྐྱེད་མ་ཐུབ་པ་དང་།",
    "རྒྱལ་ཁབ་དང་མི་རིགས་ཀྱི་དོན་དུ་ཁ་ཞེ་མི་མཚུངས་པ་བཀའ་བློན་གྱི་མིང་འཁུར་མཁན་ངན་བྱུས་ཀྱི་གཙོ་བོའི་ཕུགས་འདུག་རྒྱ་རི་བློ་གྲོས་རྒྱལ་མཚན་དང་།",
    "ད་དུང་མུ་མཐུད་དངུལ་བཟས་པའི་རྐུབ་བརྡོལ་རྒྱུ་ཡོད་འདུག་པ་མ་ཟད་ཁོ་ཚོས་དངུལ་ནག་ཚོང་བརྒྱབ་ཀྱི་ཡོད་པ་ཤེས་ཀྱི་ཡོད།",
    "ཁོང་རྣམ་པ་ཡང་སྔ་དུས་དང་མི་འདྲ་ཙམ་དུ་རྣམ་འགྱུར་འཇིང་པ་སྦོམ་པོར་གྱུར་པ་ལྟ་བུ་འདུག་སྟབས།",
    "འདི་འདུག་སེ་བྱེད།",
    "འདི་འདུག་སེ་མ་བྱེད་ཅེས་བརྗོད་འདོད་མེད་ལ།",
    "ཡག་པོ་འདུག་ཅེས་ཕྱི་ལོ་༡༩༧༥ ལོ་ཀུན་བདེ་གླིང་དང་།",
    "ན་ཡག་པོ་མི་འདུག་ཟེར་སྟངས་འདི་ལ་གཞིགས་ན་རྒྱ་མིར་ཕྲན་བུ་གནོད་ཀྱི་ཡོད་པ་དང་།",
    "འབྲེལ་བ་བྱུང་ནས་ལོ་ག་ཚོད་ཕྱིན་འདུག་དེ་དག་ཆ་ཚང་ཤེས་ཐུབ་པ་ཞིག་ཡོང་མིན་མི་ཤེས་ཀྱང་།",
    "གང་ཞིག་གལ་ཆེན་པོ་འདུག་ཅེ་ན།",
    "ཤེས་ཀྱི་འདུག་གམ།",
    "དཔེ་མི་སྲིད་པའི་གོ་སྐབས་བཟང་པོ་ཞིག་ཆགས་ཡོད།",
    "ད་དུང་ཚང་མས་ཧུར་ཐག་བྱས་ཏེ་དུས་ཚོད་རྩ་ཆེན་སྐབས་བཟང་པོ་ཞིག་ངོ་ཚོའི་མིག་སྔར་ལག་པར་ལེན་ཆོག་ཏུ་སླེབས་པའི་སྐབས་ལ་དུས་ཚོད་རྗེས་ལུས་མ་ཐེབས་པ་བྱ་རྒྱུ་འདི་གལ་ཆེན་པོ་འདུག་དེ་འདྲ་ཞིག་མིན་ནམ།",
    "གསལ་པོ་མ་བྱུང་བ་སོགས་ནོར་འཁྲུལ་ཏན་ཏན་བྱུང་འདུག་ཅེས་བཀའ་ཕེབས་ཡོད་པ་དང་།",
    "ཁྲག་ལག་ཆུ་སྦྲེལ་གྱིས་ཨ་སྒོར་ལྔ་ཁྲི་བརྒྱད་སྟོང་ལྷག་ཙམ་བྱུང་འདུག་ཟེར་བ་དེར་ཧ་ཅང་བློ་ཕམ་ཡོད།",
    "ཡང་དེ་མ་ཐག་ཏུ་རྩིས་ཁྲ་ལུགས་མཐུན་མི་འདུག་རྩིས་ཞིབ་བྱེད་རྒྱུ་ཡིན་གསུང་ཡོད་སྟབས་ཡིད་ཆེས་དང་ངོས་ལེན་ཡོང་ཐབས་དེ་བས་ཀྱང་ག་ལ་ཡོད།",
    "འབྲེལ་ཡོད་ཕྱི་མིའི་ནང་ལའང་ཕྲན་གྱི་སྐོར་ལ་འཆལ་གཏམ་འདྲ་མིན་མང་ཙམ་ཡོང་འདུག་ཕྲན་ཕྱི་དྲིལ་བཀའ་བློན་དང་།",
    "ཕྲན་ནས་ལས་ཀ་གང་ཡིན་ཁྱད་པར་མེད་ལུགས་ག་དུས་ཡིན་ཡང་ཞུས་ཡོད།",
    "ཕྱི་དྲིལ་དྲུང་གཞོན་བསམ་འཕེལ་ནས་སྒེར་གྱི་མགྲོན་བརྡ་ཞིག་འབྱོར་འདུག་པ་དང་།",
    "ལྡི་ལི་དོན་གཅོད་དམིགས་གསལ་གྱིས་ཡོད་བཟོ་མི་འདུག་༧གོང་ས་མཆོག་ཚོགས་ཕེབས་གནང་ཕྱོགས་སྐོར་རྒྱུན་བཞུགས་བཀའ་བློན་ཞེ་བོ་བློ་བཟང་དར་རྒྱས་དང་ཕྲན་གཉིས་བཅར་སྐབས་དེའི་སྐོར་བཀའ་རྩད་ཕེབས་ལན་དུ།",
    "དོན་གཅོད་ཁག་ནས་ཕེབས་སྒྲིག་ཞུས་པའི་ཐོག་ཏུ་རྒྱ་རི་བློ་གྲོས་ཁོ་རང་འགྲོ་ཐབས་ཀྱི་སྲིད་བྱུས་ངན་པ་ཁོ་ན་ཡིན་པའི་ར་འཕྲོད་དེ་རྒྱ་རི་བློ་གྲོས་ཀྱི་ངན་རྐུབ་རྡོལ་བ་ཡིན་སྟབས་བཀའ་བློན་ཚང་མ་བློ་ཤས་ཆགས་པ་དང་།",
    "ངོས་རང་ཨ་རི་ནས་ཉི་ཧོང་དུ་ཐོན་ཕྱོགས་ཙམ་གྱི་ཁྱད་པར་ཡང་འདུག་ཅེས་གསུངས།་",
    "ཨ་རིར་ཕེབས་ཐོན་གྱི་ཨ་རི་ནས་ཉི་ཧོང་དུ་དུས་ཐོག་ཕེབས་རྒྱུའི་གོ་སྒྲིག་ཕྱི་ཟླ་༣ པའི་ཟླ་འཇུག་ཏུ་ཉི་ཧོང་དུ་ཕེབས་འབྱོར་ཐུབ་པ་བྱུང་འདུག་ཅིང་།",
    "སྐུ་ཚབ་དོན་གཅོད་ཁང་ཞེས་དེབ་སྐྱེལ་ཟུར་དུ་བྱས་པ་ནི་གང་ཡང་མི་འདུག་ཅེས་སོགས་ཀྱི་གནས་ཚུལ་ལྡི་ལི་དོན་གཅོད་ཁང་དུ་འབྱོར་བྱུང་།",
    "ད་ཆ་ཕྱི་ནང་གོ་ལྡོག་བྱུང་བའི་སྐབས་གཞི་ནས་ནན་ཏན་གནང་དུས་ཕྱིས་དྲགས་པ་ཆགས་ཀྱི་འདུག་པ་མ་ཟད།",
    "རྒྱལ་དར་ཕྱེད་ཀ་བསྒྲེངས་འཛུགས་ཟེར་བ་འདུག་སྲོལ་རྩ་བ་ཉིད་ནས་མེད་ཅིང་།",
    "ང་རང་གཙང་པ་ཞིག་ཡིན་ཞུས་པར།",
    "འབྲེལ་ཡོད་རྣམས་ལ་བཀའ་བསྡུར་ལྷུག་པོར་མ་གནང་བར་ལམ་འཕྲུལ་ཡིག་ཐོག་བཀོད་དེ་འགྲེམས་སྤེལ་གནང་བ་དང་གཅིག་སྐྱོན་བརྗོད་རྣམས་ཐུག་དོགས་འདུག་ཅེས་མ་གསུངས་བར་ཐག་བཅད་དེ་གསུང་པ་དང་གཉིས།",
    "༢ སྐྱོན་བརྗོད་རྣམས་ཐུགས་དོགས་འདུག་ཅེས་མ་གསུང་བར་ཐག་བཅད་དེ་གསུང་པ་དང་གཉིས་ཞེས་བཀོད་ཡོད་པ་འདིའི་ཐད།",
    "རྒྱ་རི་གསུམ་ཡིན་ལུགས་གསུང་པ་དེ་ཚིག་ཐོའི་ནང་བཀོད་འདུག་པ་བཅས་ལ་བརྟེན་དེ་ལས་ལྷག་ཅིག་གང་དུའང་གསུང་དགོས་དོན་མི་འདུག་ཅིང་།",
    "གང་འདྲ་ཞིག་འདུག་གམ།",
    "ཤ་རིག་དུས་ས་ལ་བབས།",
    "གཞུ་རིག་དུས་གནམ་ལ་འཕུར།",
    "རང་རང་སོ་སོས་ཟུར་འཐེན་གྱི་ལས་དོན་གྱིས་སྒེར་གྱི་ཁེ་ཕན་སྒྲུབ་པའི་རྙོག་གླེང་ཆགས་པ་དང་།",
    "ཐེ་གཏོགས་བྱེད་ཐབས་རྩོལ་སྒྲུབ་བྱེད་ཀྱི་འདུག་དེ་ཙམ་མ་ཟད།",
    "ཕྱི་ཟླ་༩ ཚེས་༢༧ ཉིན་ང་རང་བོད་ཀྱི་ལྷ་སར་ཡོད།",
    "འདིར་ཕེབས་མ་ཐུབ་པའི་གྲོགས་པོ་རྣམ་པ་བཅས་ལ་ང་རང་སྒེར་གྱི་མིང་ཐོག་ནས་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "དེ་འདྲའི་གནས་ཚུལ་དང་ཤུགས་རྐྱེན་འོག་ནས་ཐབས་ཤེས་གང་འདུག་བལྟས་ཏེ་ཕན་སེམས་དང་།",
    "དངོས་གནས་ངོ་མཚར་སྐྱེ་འོས་པ་འདུག་ཅེས་དེ་འདྲའི་ཐོག་ནས་བོད་པར་བསྔགས་བརྗོད་བྱས།",
    "དད་པ་དམ་ཚིག་གཡོ་བ་མེད་པ་ཡོད་དུས་ང་རང་ཡང་ཤིན་ཏུ་དགའ་པོ་བྱུང་བས་ཚང་མར་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།་",
    "བཀག་སྡོམ་བྱེད་མཁན་མེད་པ་བཅས་ཀྱི་གནས་ཚུལ་བྱུང་འདུག་གསུམ་པ།",
    "དངོས་རྫས་གཞུང་བཞེས་བཏང་ཡང་བྱུང་འཛིན་མི་འབྲི་བར་རང་འགར་དངུལ་བསྡུ་བ་སོགས་བྱེད་མཁན་འདུག་པས་དེ་ལྟར་བྱས་ན།",
    "ལ་དྭགས་སླེ་བྱང་བཅས་ནས་ཛ་དྲག་ཞལ་འདེབས་རྒྱ་ཆེ་བསྡུ་བཏང་བྱས་འདུག་དེ་མིན་སྤྱི་འཐུས་རྣམ་པ་དང་།",
    "ལུས་ཧ་ཅང་རྒྱབ་ཏུ་མི་དགྱེ་ཧ་ཅང་མདུན་དུ་མི་རྒྱུ་བར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པ།",
    "བོད་མི་ཆིག་སྟོང་གཏོང་ལེན་གནང་འཆར་འདི་དག་བོད་མི་ཉམ་ཆུང་རང་འགོ་མི་ཐོན་མཁན་ཚོའི་ཆེད་དུ་འབད་རྩོལ་བྱས་པ་ལྟར་ལས་ནང་མི་ཟླ་སྒྲིལ་གྱི་འཆར་གཞི་ཡོང་ཐབས་མེད་ཅེས་བརྗོད་པ་ཡིན།",
    "དོ་སྣང་གང་ཡང་བྱུང་མེད་པས་ད་སྐབས་བློ་འགྱོད་ཀྱི་རང་བཞིན་དུ་གྱུར་ཀྱང་བྱ་ཐབས་མི་འདུག།",
    "བོད་ཀྱི་གཏམ་དཔེ་ལ་རྒྱ་ཞག་གཅིག་འདུག་སར་མཁར་བརྩིགས་ཞེས་ཟེར།",
    "ཕྱོགས་ཕྱོགས་ནས་དངངས་འཚབ་ཀྱིས་བརྒྱུགས་ཡོང་བ་ན་ཁོ་རང་འབྲོང་ཁྱུས་གསོད་པ་ལྟ་ཅི།",
    "སྔོན་གླིང་རྗེ་གེ་སར་གྱིས་བཟུང་ཡུལ་མཛོད་དགེ་ཕྱོགས་དེ་མི་རབས་དུ་མར་འདུག་ཀྱང་།",
    "དེ་དང་མཉམ་དུ་བོད་སོག་བར་གྱི་རྩྭ་ས་འཕྲོག་རྩོད་ཀྱི་རྣམ་པ་དེ་ཡང་རང་བཞིན་གྱིས་འཇགས་ལ།",
    "དེ་ཙམ་གྱིས་མཚོ་སྔོན་བོད་སོག་སྤྱིའི་འགྱུར་ལྡོག་ཁག་དུས་རིམ་གསུམ་དུ་བགོས་ཏེ་ངོ་སྤྲོད་བྱས་པ་ཡིན་ལ།",
    "རང་རང་བུ་རྒྱུད་སྲ་མཁྲེགས་དཔུང་བར་གཞོམ་གཞིག་བྲལ་བའི་ཟོ་དོར་ཉིད།",
    "དེ་ཉིད་ཀྱིས་རྟ་བཟང་གཅིག་དང་བཅས་པའི་མཇལ་དར་ཕུལ་བར་ཨོ་ད་ང་རང་ལོ་ཡང་ལོན།",
    "ཉེར་འཚེ་མེད་ཅིང་རང་གཞན་ཐམས་ཅད་ལ་ཕན་པ་རྒྱ་ཆེན་པོ་ཡོང་གསུངས།",
    "ཁྱད་པར་འདི་སྐབས་སུ་རི་གྲོང་ཐམས་ཅད་བརླགས་ཐག་ཆོད་འདུག་ཞུས་ཚེ།",
    "འབུམ་པ་ཁོ་རང་ཡང་སྔགས་འཆང་ནུས་ལྡན་དུ་གྲགས་ཆེ་ལ།",
    "ཁོ་རང་སྤུན་སྲིང་སོགས་ཀྱི་བུ་རབས་ཚ་རྒྱུད་ལ་ཧོང་བོ་འབུམ་ལོའི་སྐོར་རམ།",
    "སྟག་རྒན་ལ་ཁོ་རང་ཐེ་བའི་སྤུན་དྲུག་ཡོད་པ་དང་།",
