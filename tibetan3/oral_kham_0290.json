    "ངོར་ཆེན་དང་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་བཀའ་བབས་བདུན་ལས་མི་འདུག་ཀྱང་ཇོ་བོ་ལུགས་གཉིས་སོ་སོར་བགྲངས་གཉོས་ལུགས་བསྣན་པས་དགུ་བྱུང་ངོ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་ལཱུ་ཧི་པ་དང་འདི་གཉིས་གཅིག་པར་མཛད་འདུག།",
    "བུའི་གསན་ཡིག་ན་མ་ན་ཀ་དང་ཤྲཱི་ཛྙཱ་ན་ཞེས་འདུག་པ་ཡིག་སྐྱོན་བྱུང་ངམ་སྙམ།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ན་འདི་ཇོ་བོའི་རྗེས་སུ་འདུག་པ་ཡིག་ནོར་བྱུང་འདྲ།",
    "འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་དཔྱད།",
    "གསན་ཡིག་ཚོར་འདི་བཞིན་འདུག་ཀྱང་མར་ལོ་སོགས་མ་བྱུང་བས་དམང་ལུགས་ཟེར་རྒྱུ་ཡིན་ནམ་དཔྱད།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་འདི་ཇོ་ལུགས་བརྒྱུད་པའི་རྣམ་གྲངས་སུ་མཛད་འདུག་ཅིང་ཐར་རྩེ་ཤར་པའི་གསན་ཡིག་ན་དཀྱུས་བཞིན་དུ་སོ་སོར་སྣང་།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ཏུ་འདིའི་རྗེས་སུ་ནག་པོ་པ་འདུག།",
    "མི་འདུག།",
    "ཞེས་གཅིག་ཏུ་བསྡོམས་འདུག་ཀྱང་གོང་དཀར་བ་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་དཀྱུས་ལྟར་སྣང་ངོ།",
    "ངོར་ཆེན་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་གྲགས་པ་དཔལ་ཞེས་པ་དཀྱུས་སུ་བྲིས་བར་རྡོ་རྗེ་ཡིན་ནམ་འདི་མ་དག་ཟེར་བའི་མཆན་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་འདི་ལྟར་སྣང་ངོ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་མི་འདུག་པ་བརྟག།",
    "འ་ཙ་ན་བཛྲ།",
    "འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་ཀྱང་ཐར་རྩེ་བའི་གསན་ཡིག་ན་སྣང་བས་ཆད་དམ་སྙམ།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ན་སྣང་བས་གོང་དཀར་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་འདི་གཉིས་ཀྱི་ཚབ་ཏུ་འཁོན་དཀོན་ཅོག་རྒྱལ་པོ་སྣང་ཞིང་ཕྱི་མ་འདི་མཁྱེན་བརྩེ་དང་ཐར་རྩེའི་གསན་ཡིག་ན་དཀྱུས་ལྟར་འདུག་པ་དགྲ་ལྷ་འབར་མིན་ནམ་དཔྱད།",
    "ཐར་རྩེ་བའི་གསན་ཡིག་ཏུ་མི་འདུག་ཀྱང་མཁྱེན་བརྩེའི་དེར་སྣང་བས་༡༩༣བ་ཆད་དམ་སྙམ།",
    "མཁྱེན་བརྩེ་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་མི་འདུག་ཀྱང་ཤར་བའི་དེར་སྣང་བ་ཆད་དམ་སྙམ།",
    "ཐར་རྩེ་དང་ཤར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "འདིའི་མཇུག་ཏུ་མཁས་གྲུབ་རྗེས་སྒྲུབ་ཐབས་རྒྱ་གཞུང་འདི་ལ་ཡི་གེ་རྙིང་པ་ན་མཆན་ཆུང་ཉག་ཉོག་མང་པོ་བཏབ་འདུག་ནའང་དགོས་པ་ལྷག་པོ་ཅི་ཡང་མི་སྣང་བས་མ་བྲིས་སོ།",
    "ཞེས་གསུངས་འདུག་གོ།",
    "ཞེས་པ་འདུག་ཅིང་ཤོག་དྲིལ་ཕྱི་མ་ཕལ་ཆེར་ལའང་དེ་ལྟར་སྣང་ངོ།",
    "རྡོར་བཟླས་ཀྱི་ཤོག་དྲིལ་གཞན་དུ་གསལ་ཞེས་ཁ་འཕངས་འདུག་ཀྱང་དཔེ་ཟུར་པ་མ་རྙེད།",
    "སྒྲིབ་སེལ་དང་གནས་སྦྱོང་འབྱམས་གཅོད་ཀྱི་ཟ་བྱེད་མཁའ་འགྲོའི་སྦྱིན་སྲེག་ཀླུ་སྒྲུབ་པའི་ཁོག་འབུབས་སུ་འདི་སཱཙྪའི་འཇུག་ཏུ་འདུག།",
    "དཀར་ཆག་ཏུ་ཡི་གེ་ཚན་པ་ཉི་༢༢༨བ་ཤུ་རྩ་གཉིས་ཡོད་གསུངས་ཀྱང་ཀ་ཐོར་ཡ་ཡན་གྱི་ཉེར་བཞི་འདུག་པ་དཔྱད།",
    "འདི་གསུང་ཡིན་མིན་ལ་རྩོད་པ་བྱུང་ནའང་བཀའ་སྒྲུབ་བསྟན་པའི་སྐབས་བསྒྲུབས་ཟིན་ཞེས་པ་དཀར་ཆག་ཏུ་འདུག་གོ།",
    "ཐོག་མར་རྩོམ་པའི་དུས་འདི་རྣམས་འཁོར་འདས་དབྱེར་མེད་ཀྱི་འགོར་བྲིས་ཡོད་འདུག།",
    "མཛད་བྱང་ན་ཧྲིད་དྷཱ་ཛ་ཞེས་རྒྱ་སྐད་དུ་བྲིས་འདུག།",
    "པོད་དམར་ན་འདིའི་མཇུག་ཏུ་བརྟག་གཉིས་ཀྱི་ལུང་སོགས་འགའ་ཞིག་དྲངས་པའི་མཐར་ཞང་འཕགས་པ་ལྷས་བསྐུལ་ནས་རྗེ་བཙུན་གྱིས་མཛད་ཚུལ་འདུག།",
    "པོད་དམར་ན་གཉུག་མ་དྲན་གསལ་དངོས་འདི་ལ་ངོས་བཟུང་འདུག།",
    "འདི་བརྒྱུད་པ་འགངས་ཆེ་བ་གཅིག་ཏུ་འདུག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་མི་འདུག་པ་བརྟག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་དྷརྨ་ཡེ་ཤེས་ཞེས་འདུག་པ་བརྟག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་བི་ན་པ་ཏི་དང་ཐར་རྩེ་བའི་དེར་བཱིན་ཞེས་པི་ཝཾ་འཛིན་པ་ཡིན་ཞེས་སྣང་ངོ།",
    "མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཟུར་ཆག་འདི་བཞིན་འདུག་རྡོ་རྗེ་གདན་པའི་དེར་ལཀྵ་དང་ཐར་རྩེ་པའི་དེར་ཕུན་ཚོགས་ཞབས་ཞེས་བསྒྱུར་འདུག་གོ།",
    "གོང་དཀར་བ་དང་ཐར་རྩེ་པའི་དེ་བཟང་པོའི་ཞབས་སུ་བསྒྱུར་འདུག།",
    "གོང་དཀར་བའི་དེར་གླུ་ཤ་ན་དང་ཐར་རྩེ་བའི་དེར་བྷུ་ཥ་ཎ་འདུག།",
    "གོང་དཀར་བའི་དེར་པདྨ་པ་ཟེར་བ་འདུག།",
    "ཐར་རྩེ་བའི་གསན་ཡིག་ན་འདིས་གོང་མ་གཉིས་ཀ་ལ་གསན་ཟེར་བ་འདུག།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་གྷ་ཡ་དྷ་ར་ཟེར་བ་འདུག་པ་བླ་ཆེན་གྱིས་རྒྱ་གར་དུ་དཔའ་བོ་རྡོ་རྗེ་དང་བོད་དུ་གྷ་ཡ་དྷ་ར་ལ་གསན་པའི་ཁུངས་མཛད་འདུག།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པ་དང་ཐར་རྩེ་པའི་དེར་འདི་གཤམ་དུ་ཨིནྡྲ་བྷཱུ་ཏི་འདུག་པས་ཚིགས་བཅད་ལྟར་ན་དཔལ་བདེ་བར་ཨིནྡྲ་བྷཱུ་ཏི་ཆེ་བ་གཉིས་གཅིག་པ་འདྲ།",
    "གསན་ཡིག་གཞན་གཉིས་ན་ཚངས་པའི་ཞབས་ཞེས་བསྒྱུར་འདུག།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ཨུ་པ་ལ་ཟེར་བ་འདུག་པ་དཔྱད།",
    "ཐར་རྩེ་པའི་དེར་ལེགས་སྨིན་ཞེས་ཟུར་ཆག་འདུག་གོ།",
    "ཐར་རྩེ་པའི་དེར་མི་ཐུབ་ཟླ་བར་རྗེ་གདན་པའི་དེར་བཱི་ར་བཛྲ་དང་ཐར་རྩེ་པའི་དེ་དཔའ་བོ་རྡོ་རྗེ་ཞེས་འདུག་པར་དཔྱད།",
    "རྡོ་རྗེ་གདན་པའི་དེར་བོད་དུ་ཡང་ཤེས་རབ་གསང་བར་གསན་ཟེར་བ་འདུག།་།",
    "དཀར་ཆག་ན་མི་གསལ་ཡང་འཇམ་དབྱངས་མཁྱེན་བརྩེས་སྒོ་རུམ་པར་གསན་པའི་ཡི་གེར་བསྟོད་པ་དང་བཅས་ཟེར་བ་འདུག་པས་བརྩེ་བས་རྗེས་ཆགས་མ་ཞེས་པའི་ཤོ་ལོ་ཀ་གཅིག་བུ་དེའོ།",
    "བརྒྱུད་པ་སྒྲུབ་པ་ཆར་དབབ་པ་སྟེ་དོན་གསུམ་གྱིས་བསྟན་པའི་ཀླུའི་རྒྱལ་པོ་ཝ་རུ་ཎའི་ཆར་འབེབས་རྒྱ་གར་བེ་རོ་ཙ་ནའི་རང་འགྱུར་དུ་མཛད་པ།",
    "རྡོ་རྗེ་གདན་པའ་༢༧༦བ་གསན་ཡིག་ན་རིག་པའི་སེང་གེ་ཟེར་བ་འདུག།",
    "རྡོ་རྗེ་གདན་པའི་ཕྱག་བྲིས་ན་འདི་མི་འདུག་པ་ཆད་དམ་དཔྱད།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་བར་འདིར་ལུང་མང་པོ་ཟེར་བ་ཞིག་འདུག་ཀྱང་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་མི་འདུག་པ་བརྟག།",
    "དཀར་ཆག་ན་བར་འདིར་ཚོགས་བདག་དཀར་པོ་ཤ་བའི་གདོང་ཅན་གྱི་སྒྲུབ་ཐབས་ཟེར་བ་ཞིག་འདུག་ཀྱང་དཔེ་མ་འབྱོར་བས་ལུང་མ་ཐོབ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཧཱུྃ་ཀ་ར་ཟེར་བ་འདུག།",
    "རྡོ་རྗེ་གདན་པ་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་འདི་དང་ས་པཎ་གྱི་བར་ན་འཕགས་པ་མི་འདུག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ནའང་འདི་ཉིད་ལ་གྲགས་པས་དངོས་སུ་གསན་འདུག།",
    "མུ་སྟེགས་གསད་པས་ལོ་བཅུ་གཉིས་ཀྱི་བར་རྡོ་རྗེ་གདན་པས་ལོ་ཙཱ་བ་མཇལ་ཁར་མི་བཏང་ཟེར་བ་འདུག།",
    "འདུག་སྟངས།",
    "ཞེས་ཆེད་དུ་བརྗོད་པའང་རང་བཞིན་བརྗོད་པའི་རྒྱན་ཁོ་ན་ཡིན་ལ།",
    "གསེར་པོད་ཀྱི་དེ་ལྟར་བརྒྱད་དང་སྦྱར་བའི་འདི་དང་ཞུས་དག་ཡེ་མི་ཕེར་ཞིང་བརྗེད་ཐོ་ལྟ་བུའི་འདྲ་མིན་གཉིས་འདུག་པ་ཟུར་པ་ཞིག་ཡིན་པར་སྣང་ངོ།",
    "དཀར་ཆག་ན་ཆུང་ངུ་ཟེར་བ་འདུག་ཅིང་གསེར་པོད་ཀྱི་དེ་ཡིག་སྐྱོན་ཡིན་ནམ་དབུ་ནསཅུང་ཟད་མ་མཐུན།",
    "བདག་བཞིན་མཛད་འདུག་པ་དོན་ལ་གཅིག།",
    "གསུང་ཡང་རང་ལུགས་ལ་མི་བཞེད།",
    "འདི་མལ་དང་འཕགས་པའི་དུས་གང་དུ་བྱུང་དཔྱད་དགོས་འདུག་གོ།",
    "མུས་སྲད་པ་སོགས་ལ་ལ་དམ་པས་མཛད་པར་བཞེད་ཅིང་སེར་པོད་ན་གཟུངས་པས་མཛད་ཟེར་བ་འདུག་ཀྱང་བླ་ཆེན་བསོད་བློའི་མན་ངག་ཚིགས་བཅད་ཀྱིས་མིན་པར་ཤེས་ནུས་སོ།",
    "སེར་པོད་ཀྱི་དེར་མཛད་བྱང་ཆད་འདུག།",
    "དཀར་ཆག་དང་གསན་ཡིག་ན་མཛད་ཅེས་སྣང་ཡང་ཡི་གེ་ན་བཤུས་ཟེར་བ་འདུག།",
    "དཀར་ཆག་ན་གཞན་གྱི་རྩོད་གཏོང་ཟློག་པ་ཙམ་ལས་མི་འདུག་ཀྱང་བརྗོད་བྱ་ལ་དཔགས་ན་འདི་བཞིན་ཚང་ངམ་སྙམ་ཞིང་།",
    "དཀར་ཆག་ན་གཉིས་ཡོད་གསུངས་ཀྱང་གཅིག་མ་རྙེད་མལ་ལོའི་དབོན་པོས་མཛད་ཟེར་བ་བྱུང་འདུག་རུང་དེ་ལྟར་མིན་ཚུལ་ཡར་ཀླུངས་པ་གསུང་།",
    "རྒོད་ཁ་འདོམ་པ་རྣམས་སོ་སོར་ཕྲལ་འདུག་གོ།",
    "དཀར་ཆག་ན་འདི་ལྟར་འདུག་པ་ཡུམ་བཞིའི་བསྐུལ་ལ་དགོངས་སམ་སྙམ་བཀའ་གཏེར་གང་ཡིན་མ་ངེས།",
    "ཁ་སྐོང་ན་ཡོད་པའི་འཕགས་པས་མཛད་པ་དེ་འདི་ལས་རྒྱས་སུ་བཏང་འདུག།",
    "ཁ་སྐོང་པོ་ཏི་ནའང་ཡོད་མེ་འབར་གླེགས་བམ་ལ་ལར་བསྟོད་པ་བདེ་དགའ་རྒྱ་མཚོ་སོགས་བསྣན་པའི་མང་ཙམ་འདུག་པ་ལྷད་ཡིན་མིན་བརྟག།",
    "འདི་རྒྱ་བོད་སུ་ཡིན་ལ་དཔྱད་གཞི་མཛད་མཁན་མང་ཡང་རང་ལུགས་རྒྱ་གར་བར་བཞེད།",
    "འདི་ཐོག་མར་བཞུགས་རིགས་པ་འདྲ་ཞིག་འདུག་ནའང་།",
    "འཛུགས་བསྟན་པ་དྲི་མེད་མ་ཟེར་བ་ཞིག་སྣང་བ་དཀར་ཆག་ཏུ་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "བཅོལ་བའི་འཕྲིན་ལས་མཛོད་ཀྱི་མཐའ་ཅན་མེ་འབར་མའི་ས་པཎ་གྱིས་མཛད་པ་དེ་འདི་ལས་ཉུང་བ་འདུག།",
    "སེར་པོད་ན་ཨི་དཾ་དུཏྟཾ་ཡ་ན་རྡོ་རྗེ་འཆང་ཀུན་དགའ་བཟང་པོས་འགྲོལ་བར་མཛད་དེ་མན་ཞབས་ཏོག་ཏུ་བྲིས་ཟེར་བ་འདུག།",
    "དཀར་ཆག་ན་གུར་ཞལ་ལས་མཁན་དང་བཅས་པའི་སྔགས་བྱང་ཟེར་བ་ལས་ངོར་པ་དང་ས་བཟང་པ་སོགས་ནང་གསེས་ཀྱི་དབྱེ་གསལ་མི་འདུག།",
    "འདིའི་མཇུག་ན་དེ་ལྟ་བུའི་མན་ངག་གླེགས་བམ་འདི་ཞེས་སོགས་ཀྱི་ཤོ་ལོ་ཀ་དྲུག་ཙམ་ཞིག་ས་སྐྱའི་ཕྱག་དཔེར་བྲིས་འདུག་ཀྱང་གནས་གསར་དང་བོད་མཁར་བ་གཉིས་ཀའི་ཕྱག་དཔེར་མི་འདུག་ཅིང་ལུང་ཡང་མ་ཐོབ།",
    "འདི་དྷམ་གཟི་བརྗིད་ཀྱིས་མཛད་ཅེས་དཀར་ཆག་ན་འདུག་གོ།",
    "ནས་ཡིག་འཕྲེང་གཉིས་ཙམ་མི་གཅིག་པའི་དེ་ཕྱིན་མེ་འབར་མའི་དེ་དང་ཞུས་དག་ཕེར་བ་ཞིན་འདུག།",
    "འདི་དང་མེ་འབར་མའི་ཕྱི་པ་ལྟར་སྒྲུབ་པ་གཉིས་ཁྱད་པར་མེད་ཅེས་དཀར་ཆག་ཏུ་གསུང་པ་ལྟར་ཞུས་དག་ཀྱང་ཕེར་བ་འདུག་གོ།",
    "འདིའི་རྗེས་སུ་རྔོག་ཞེ་སྡང་རྡོ་རྗེས་མཛད་པའི་དུད་སོལ་མའི་གཏོར་ཆོག་ལག་ལེན་དུ་བསྒྲིགས་པ་ཞིག་ཡོད་འདུག་པ་ནི་མ་ཐོབ།",
    "འདིའི་འོག་ཏུ་ཟོར་དང་གཏོར་མནན་གྱི་ཡི་གེ་ཞིག་ཡོད་འདུག་པ་ནི་མ་ཐོབ།",
    "གོང་དཀར་བའི་གསན་ཡིག་ཏུ་ཞེ་སྡང་རྡོ་རྗེ་ཞེས་གསང་མཚན་བྲིས་འདུག།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་དབུགས་ཟེར་བ་འདུག་པ་དཔྱད།",
    "འདི་གཉིས་ལ་བར་ཐང་པ་ཡབ་སྲས་ཟེར་བ་དཀར་ཆག་དང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་འདུག།",
    "རྗེས་གནང་འགའ་ཞིག་ཚར་ཆེན་རང་ལའང་གསན་འདུག་གོ།",
    "ཀྱི་པའི་ཕྱོགས་མཛད་འདུག་ཀྱང་ཅུང་ཟད་ཐུགས་སྣང་ལ་མ་ངེས་པ་ཞིག་བྱུང་བར་སེམས་སོ།",
    "སྒོ་རུམ་པར་གསན་པ་དེར་མི་གཅིག་པར་བགྲངས་འདུག་པ་འདིར་གཉིས་ཀའི་དོན་ལ་དཔྱད་ནས་གསལ་བར་བགྱིས་ཡོད་དོ།",
    "སྙན་བརྒྱུད་ཀྱི་ཕྱིར་གཏོང་བ་དང་བཤན་པ་རོ་འཁུར་གཉིས་ནི་མི་འདུག།",
    "ཅུང་ཟད་ཡོད་པ་ཞིག་འདུག།",
    "ཕལ་ཆེར་སྙན་བརྒྱུད་ཀྱི་ཞལ་བཞེས་ལ་རག་ལས་ཞེས་དཀར་ཆག་ན་སྣང་བས་ཡི་གེ་འདི་ལས་མང་བ་ཞིག་ཐོག་མ་ནས་མེད་ཚོད་དུ་འདུག།",
    "༣༧༩ན་སློབ་དཔོན་པདྨས་མཛད་པའི་ཁ་གསལ་མི་འདུག།",
    "སྔགས་བྱང་གསུམ་པོ་དཀར་ཆག་ཏུ་སྔགས་བྱང་ཞེས་པ་ལས་སོ་སོའི་གསལ་ཁ་མི་འདུག།",
    "ངོར་ལུགས་ལ་འདི་ས་ཆེན་གྱིས་མཛད་པའིསྒྲུབ་ཁྲིགས་དང་སྦྲེལ་འདུག།",
    "འགོར་མན་ངག་འདིའི་འཁོར་ལོ་བྲི་བར་འདོད་ན་ཞེས་ཡོད་པའི་འཁོར་ལོའི་བྲི་ཐབས་འདི་གོང་དཀར་བའི་གླེགས་བམ་དུ་ཉིས་ལྡབ་འདུག། སྒོ་༡ཉི་",
    "ཀ་གསུམ་དང་ཚིག་གཅིག་རྣམས་འཐོལ་འདུག།",
    "འདིར་བསྐྲད་འཁོར་འདྲི་ཚུལ་ཞིག་འདུག།",
    "ངོར་ལུགས་ལ་སྒབ་འདྲེ་གནོན་ཐབས་ཞེས་སྣང་བ་ནོར་བར་འདུག་གོ།",
    "པོའི་གཏོར་ཆེན་གྱི་མན་གོང་དཀར་བའི་གླེགས་བམ་ན་ཚང་བ་གཅིག་དང་བསྐལ་མེ་མ་མན་མེད་པ་ཞིག་དང་བཅས་འདུག།",
    "བཀང་བསྟོད་ལ་ལར་འདི་དང་ཁྱད་བཞུགས་མ་གཉིས་ཁ་ཕྲལ་ནས་བྲིས་པ་ཡོད་འདུག་ཀྱང་དོན་དུ་འདི་ཁའི་འཕྲོས་ཡིན།",
    "འདིའི་རྗེས་སུ་དམ་པ་ཀུན་དགའ་གྲགས་ཀྱིས་མཛད་པའི་བསྟོད་པ་ཞིག་ཡོད་འདུག་པ་མ་ཐོབ།",
    "གཏོར་ཆོག་བསྟོད་བསྐུལ་དང་བཅས་པ་ཞེས་མཛད་བྱང་ན་འདུག།",
    "རྗེ་བཙུན་ཀུན་སྤངས་རྡོ་རིང་པ་ཆེན་པོ་ཡན་ཆད་དུ་ཡི་གེར་གསལ་བར་བཀོད་པ་མེད་འདུག་ནའང་།",
    "སྐུ་ཚེའི་སྨད་ལ་སྤྱན་སྔ་དང་མཇལ་ཟེར་བ་རྡོ་རྗེ་གདན་པ་དང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདུག་ཅིང་།",
    "འདི་སྐོར་ཐུགས་རྩོམ་གྱི་ལྗགས་དཔོད་གནང་བའི་དྲུང་ཡིག་བྱམས་པ་དོན་གྲུབ་ཀྱིས་ཚིག་གཅིག་ཀྱང་མ་ལུས་པ་གུས་པ་ཆེན་པོའི་སྒོ་ནས་གསན་འདུག་པར་བརྟེན།",
    "བརྒྱུད་ལུགས་འདི་ལོ་པ་སྤྱན་ལྔའི་གསན་ཡིག་ན་འདུག།",
    "ཚར་ལུགས་བེའུ་བུམ་གྱི་ཡང་ངོའི་བརྒྱད་དང་ཞེས་པ་མིན་མི་འདུག།",
    "ཚར་ལུགས་དང་གོང་དཀར་ལུགས་གཉིས་ཀ་ལས་ཉུང་བ་འདུག་པ་ཡིག་རྙིང་སོར་བཞག་ཏུ་མངོན།",
    "མན་ངག་ལ་ཡི་གེ་གཅིག་ཀྱང་ཁྱད་མི་འདུག་གོའི་མཐའ་ཅན།",
    "པ་ལྕམ་དྲལ་གྱི་སྐྱེ་རྒྱུས་རྒྱ་བོད་དུ་དར་ཚུལ་གདམས་ངག་གཉན་གྱི་ལུགས་ཆེ་བར་གདའ་འོའི་མཐའ་ཅན་རྣམས།",
    "འདི་གཉིས་ལ་བོང་ཁ་པའི་ཕྱག་དཔེར་མཚན་ཞིབ་པར་འདུག་པའི་ལུང་ཡང་བྱུང་།",
    "འདི་གཉིས་ཕ་བོང་ཁ་བའི་ཕྱག་དཔེར་མཚན་འདུག་པའང་ནོས།",
    "གྲུབ་པ་གནས་གསར་གྱི་ཕྱག་དཔེར་ང་ཡི་ནོར་གྱི་རྟིང་ལ་རྒྱུག་མན་འབྲི་འཕྲོ་ལུས་འདུག།",
    "གནོད་སྦྱིན་གདུག་པའི་ལས་སྦྱོར་ལ་བརྟེན་ནས་དགྲ་ལ་ཁྱི་དམག་དྲང་བ་བེ་རོ་ཙ་ནས་པཎྜི་ཏ་དྷ་ཙཎྜ་ལ་གསེར་སྲང་གང་ཕུལ་ནས་ཞུས་པ།",
    "བྷི་དྷར་ཀྲ་ཤུའང་ཟེར་འདི་ལམ་འབྲས་པའི་གྷ་ཡ་དྷ་ར་ནི་མིན་པར་འདུག།",
    "ཁྱེད་རང་སེམས་མ་གཡེང་།",
    "ཁྱེད་རང་སེམས་མ་གཡེང་།་",
    "འདི་ལ་འགྲེལ་པ་མི་འདུག།",
    "ལྕི་ལྕི་ལྟར་འདུག་ཁྱབ་འཇུག་བྱིན་ཡང་སྟོབས་ཆེན་སྡུག་བསྔལ་གནས་སྐབས་གྱུར།",
    "ཤིན་ཏུ་ལྕི་ལྕི་ལྟར་འདུག་པ་དེ་ཉིད་ཁྱབ་འཇུག་ལ་བྱིན་ན་ཡང་།",
    "འོན་ཀྱང་རང་ཉིད་འཆི་ཁ་ཡང་།",
    "དེ་ཡང་རང་མཉམ་འགའ་ལ་ཕན་སྙམ་པའི།",
    "སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་ཞིང་།",
    "སྲིད་ཀྱང་རང་བཞིན་ལས་འདས་མིན་པར་སྤོང་བའོ།",
    "གཉིས་པ་སྲིད་ཀྱང་རང་བཞིན་ལས་འདས་མིན་པ་སྤོང་བ་ལ་གསུམ་སྟེ།",
    "ཕྱི་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་གྲུབ།",
    "རྣམ་པ་བརྫུན་ཡང་རང་རིག་འབྲས་བུར་གྲུབ་པའོ།",
    "གསུམ་པ་ཕྱི་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་གྲུབ་པ་ནི།",
    "བཞི་པ་རྣམ་པ་བརྫུན་ཡང་རང་རིག་འབྲས་བུར་གྲུབ་པ་ནི།",
    "སྣང་རུང་རང་བཞིན་མ་དམིགས་པ་གྲུབ་པའོ།",
    "འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་ཐབས་ཉམས་སུ་ལེན་པར་འདོད་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སྣང་བ་མཐའ་ཡས་ཀྱི་ཐུགས་དང་རང་སེམས་དབྱེར་མེད་དུ་གྱུར་པར་བསམ།",
    "ག་འགྲོ་གར་འདུག་བསྟན་པ་སྤེལ་བར་བརྩོན།",
    "། ཁྱེད་རང་སེམས་མ་གཡེང་། རྒྱུན་དུ་དལ་འབྱོར་གྱི་ལུས་རྙེད་པར་དཀའ་བ་དང་།",
    "སྐུ་ལ་གསོལ་ཞིང་རང་ཉིད་སྤྱོད་པར་ཤོག།",
    "དེ་ཡང་སྣང་བ་རང་སེམས་ཡིན་པའི་གོ་བ་ཡོ་ལེ་བ་དེ་འདྲ་མ་ཡིན་པར་སྣང་བ་རང་སེམས་སུ་ཇི་ལྟར་ངོ་འཕྲོད་ཙ་ན།",
    "ཡིན་ཡང་རང་ཞོགས་པའི་ཚོགས་པ་གྲོལ་བ་དང་།",
    "སླར་ཡང་རང་ལོ་སོ་གསུམ་ཐོག།",
    "ཚོགས་དང་གཏོར་མ་བཅས་བཤམ་འདུག།",
    "ཁྱེད་རང་དེ་རིང་ས་ལུགས་ལྟར་གྱིས།",
    "ས་སྐྱ་པའི་བླ་གྲྭ་ཡང་མང་པོ་འདུག།",
    "རས་གུར་དཀར་པོའི་ཁྲ་ལིང་ཞིག་ཕུབ་ནས་བཞུགས་འདུག་པ་དང་།",
    "འདི་ན་སྐྱིད་པོ་འདུག་པས།",
    "བླ་གྲྭ་ཚང་མ་དེ་བཞིན་འཚང་ཀ་རྒྱག་འདུག།",
    "མི་ཕམ་སེང་གེ་རབ་རྒྱས་ཀྱི་ཞལ་སྔ་ནས་གསན་པ་ཡིན་འདུག།",
    "ལོ་བཅུ་ལྷག་གམ་བཅོ་ལྔ་ཙམ་ལོན་པ་གཉིས་མ་གཏོགས་སུ་ཡང་མི་འདུག།",
    "དེ་འདྲའི་རིགས་ཁ་ཤས་འདུག་ཀྱང་ག་ལེར་ཡོ་བསྲང་མཛད་འགྲོ་ཡོང་སྙམ།",
    "དེ་མིན་ཞལ་ལག་དུས་གསུམ་གཏོང་རན་པ་ན་ཚྭ་བྲོ་མིན།",
    "ཕྱི་རྒོལ་གྱིས་ཉན་ཚོད་ཀྱང་མེད་པ་འདུག།",
    "ཕྱི་རྒོལ་བ་མང་པོ་ཞིག་ཕུང་གསོག་བྱས་པ་དེ་མཛེས་པོ་མི་འདུག།",
    "གྲྭ་ཚང་ཚིམ་དང་མ་ཚིམ་སོགས་ཚང་མ་དངོས་སུ་ང་རང་འགྲོ་ནུས་དུས་འགྲོ་ནས་དང་།",
    "ད་ལྟ་ང་ལངས་འདུག་མི་ནུས་པ་འདི་འདྲ་གྱུར་དུས་སུའང་ཉིན་མཚན་ཀུན་ཏུ་མི་དང་འབྲེལ་བའི་སྐོར་བྲེལ་ཟིང་བྱ་དགོས་པའང་དེ་སྔར་གྱི་འཚོ་རྟེན་དང་།",
    "ཁ་ཤས་ནི་ཚིག་རྒྱན་སྦྱར་སྟངས་དེ་ཙམ་མ་ལེགས་པས་གོ་དཀའ་བའི་རྣམ་པ་འདྲ་ཅི་རིགས་འདུག་ལ།",
    "དེ་ཡར་བླངས་རྗེས་དཔྱད་ཞིབ་ཟིན་པ་ན་ག་ལེར་འདེམས་རྒྱུའི་སྲོལ་འདུག།",
    "ཚིག་འགྲེལ་འདྲ་ཐབས་ཆག་ཤེས་མི་འདུག་ན།",
    "ཉིན་ཞག་དུས་ན་བསླབ་པ་གཅིག་བཟུང་བ།",
    "ཞེས་གསུངས་པའི་དོན་ཅི་ལགས་ཞུ་ཡིན་འདུག་པར།",
    "གནས་འདི་འདྲ་ན་འདུག་པ་ལ་གདམས་ངག་བཟང་པོ་ལ་བརྟེན་པའི་སྒོམ་སྒྲུབ་ཅིག་དགོས་པ་ཡིན་ཏེ།",
    "རྟོགས་ལྡན་ཁྱེད་ཀྱིས་འདི་དག་ཐུགས་ལ་ཞོག་ལ་སྒྲུབ་པ་མཛོད་དང་ཕན་ཐོགས་པ་ཆེན་པོ་ཅིག་འོང་གསུངས་ནས་ཆེད་གཉེར་མཛད་ཅིག་འདུག།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་རྗོད་བྱེད་གཉིས།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་ལ།",
    "འཇུག་དུས་ཀྱི་རྗོད་བྱེད་ལའང་གཉིས་སུ་ཕྱེ་བ་མེད་དེ།",
    "ཞེས་བཀོད་འདུག།",
    "འབྲིང་རང་རྒྱལ།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོགས་པའི་སྒོ་ནས་ནི་མངོན་སུམ་དུ་བྱ་བའོ་། དུས་སུ་གཏམ་རྨྱེཞེས་བྱ་བ་ནི་ཕ་རོལ་པོ་སྟན་དམའ་བ་ལ་འདུག་པ་ལ་སོགས་པའི་སྒོ་ནས་ཉན་པ་དང་འདོད་པ་དང་ཉན་པར་འོས་པར་ཤེས་ཤིང་འདི་ནི་སྔར་གཏམ་བྱ་བའི་དུས་ཡིན་ནོ།",
    "རངས་པར་བྱེད་པ་ནི་ཡང་དག་པར་བླངས་ཏེ་འདུག་པ་རྣམས་ལའོ།",
    "ཞིག་པ་ནི་གང་ཞིག་ཕྱེན་ལུས་རོར་འདུག་པའོ།",
    "རྒྱགས་པར་འགྱུར་བ་ནི་རྒྱགས་པའི་རྒྱུ་ཀུན་ཏུ་བསླངས་ནས་འདུག་པའོ།",
    "ནང་སྟེ་འདུག་པ་ནི་འཁྲུགས་པའི་མཇུག་ཏུ་གདོང་ཁྲོ་གཉེར་དང་བཅས་པར་གནས་ཤིང་ཚིག་ཏུ་མི་སྨྲ་བའོ།",
    "ཇི་ལྟར་འདུག།",
    "ཕྱི་རབས་རྣམས་ཀྱིས་ཕ་མེས་ཀྱི་བྱ་བ་དང་བྱེད་པ་ཇི་ལྟར་བྱས་པ་སོགས་ཡིད་ལ་ངེས་པར་བྱ་བའི་ཕྱིར་དུ་ཁོ་བོས་ཀྱང་རང་ཚུལ་ཅུང་ཟད་གླེང་བར་འདོད་དོ།",
    "དེ་སྐབས་ཡབ་གཅིག་ལྷ་ལྡན་དུ་ཕེབས་འདུག་ཐོག་ནས་བསུ་མི་གནང་བྱུང་བར་ལྷ་སར་ཕྱིན།",
    "ས་ཁྱི་ལོ་ལྗོངས་འདིར་ཡུན་རིང་འདུག་དགོས་ཤར་ན་མཐར་ཉམས་ཉེས་ཇི་ཡོ་ང་མ་ཤེས་པས་དགོངས་ཁྲོལ་ཞུས་ཏེ།",
    "ལྷ་སར་ཕེབས་མ་ཐག་ཁོ་བོ་རྩད་གཅོད་མཛད་འདུག་པ་བཅས་མཇལ་ཁར་བཅར་སྐབས་དགྱེས་འཛུམ་མུལ་བཞིན་པར་སྔར་འདྲིས་ཀྱི་བག་ཆགས་བཟང་པོའི་གསུང་གླེང་དང་།",
    "སྐུའི་ཉེ་བའི་གམ་ཁོ་ནར་འདུག་ཏུ་སྩལ་ནས།",
    "ཡང་རང་བབས་སུ་འཇོག་པ་བང་འདོད་བྱེད་རྒྱུ་ཡིན།",
    "ད་སྙེད་རྒྱུ་འདི་ཚོ་ཐམས་ཅད་ང་མ་འདོད་པས་བྱས་པ་ལོས་ཡིན།",
    "བདག་ཅག་ཀྱང་རང་ཉིད་ཀྱིས་ཉེས་པར་སྤྱད་པའི་ནོང་འ་སྤྱོད་དང་འགྲོགས་པ་མེད་ཀྱང་།",
    "ཆི་རིང་ལ་གླང་ཆེན་སྨྱོན་པ་བྱིན་ཚར་བའི་ངོས་གཏུགས་མི་ཡོང་བ་འདུག་དེ་རིགས་མ་རྒྱས་ངེས་ཁུངས་རྡོལ་མེད་ན་དེ་གས་འཐུས་ཚུལ་བྱུང་བ།",
    "ཏ་པོ་ཏ་ལར་བཞུགས་མུས་ཡིན་འདུག་ཀྱང་།",
    "དེར་གོང་གསལ་དཔོན་པོ་རྣམས་ཚང་མ་འཛོམས་འདུག་ཐོག་བན་ཨམ་བན་ནས་སོག་སྐད་མཛད་དེ་གསུང་རིགས།",
    "འགྱུར་མེད་རྣམ་རྒྱལ་གྱི་རྭས་གང་ལའང་བྱ་བ་ངན་པ་མ་བྱས་ཤིང་བསམ་པ་དྲང་པོར་བཟུང་འདུག་ད་དུང་ཡང་བོད་ཀྱི་བཀའ་བློན་ལས་ཁུར་བྱེད་དགོས་ཡོད་གོང་མའི་བཀའ་ལས་མི་འགལ་བའི་ཧུར་ཐག་ཐོང་།",
