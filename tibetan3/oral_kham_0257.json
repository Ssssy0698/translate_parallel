    "དེ་ཡང་ཡི་གེ་འབྲི་མཁན་ཁོ་རང་བྱེད་པ་པོ་གཙོ་བོ་དང་།",
    "ཡིག་མཁན་ཁོ་རང་དང་འབྲེལ་ནས་ཡོད་པའི་བྱེད་པ་སྨྱུ་གུ།",
    "ད་ལྟ་ང་རང་སྡོད་སའི་ཁང་ཤག་དང་མྱུ་གུ་སྐྱེ་བཞིན་པའི་སྔོ་ལྷང་ངེ་བ་ལྟ་བུའོ།",
    "འགུལ་སྐྱོད་དང་འཕོ་འགྱུར་གྱི་རང་བཞིན་དང་ལྡན་པའི་ཐོག་དུས་གསུམ་གྱི་རྣམ་གཞག་མཛད་དུ་ཡོད་པ་ཞིག་ཡིན།",
    "འོན་ཏེ་སྔོན་འཇུག་བ་ཡིག་དུས་ད་ལྟ་བ་དང་།",
    "གསར་བུ་པ་རྣམས་ཀྱིས་ནི་དེ་ལྟ་ན་སྙན་ངག་ཅེས་པ་ཤིན་ཏུ་ཤེས་དཀའ་བ་དང་རྩོམ་དཀའ་བ་ཞིག་ཡིན་པར་འདུག་སྙམ་སྟེ་སྙན་ངག་ལ་འཇུག་པའི་བློ་འདོར་བའི་རྐྱེན་དུའང་འགྱུར་བཞིན་ཡོད།",
    "ཉེ་བའི་ཆར་ཡང་འདུག་སྟེ།",
    "དེ་སྙེད་ལས་རང་རང་རྣམ་དཔྱོད་ཀྱི་རྩལ་དང་བསྟུན་པའི་མཚན་ཉིད་དང་མཚན་གཞི་གསུང་འཇོག་མང་པོ་གནང་ཡོད།",
    "བེ་རོ་ཙ་ན་ཨོ་རྒྱན་དངོས་དང་མཉམ།",
    "དེ་ཡང་རང་བློ་དང་འཚམས་པར་ཅུང་ཟད་ཞུ་ན།",
    "དེ་ཡང་རིགས་བྱ་བ་ཡོན་ཏན་རྫས་བཞི་པོ་གང་ཡིན་རང་རང་བརྗོད་བྱའི་གཙོ་བོར་བྱས་པའི་ཆ་ནས་དེ་དང་དེའི་དཔེར་བརྗོད་དུ་འགྲོ་བ་ཡིན་གྱི།",
    "ཞེས་པ་གཉིས་ཀར་ཁྱད་གཞི་ཐ་དད་པ་གསུམ་གྱིས་བྱ་བ་གཅིག་དུས་མཉམ་དུ་བྱས་པར་སྟོན་པའོ།",
    "འདིར་སྔོན་འཇུག་རྣམས་རང་རང་འཇུག་ཡུལ་གྱི་མིང་གཞི་གང་རུང་ལ་ཞུགས་པའི་ཚེ་སྒྲ་དྲག་ཞན་ཅི་འགྱུར་གྱིས་དབྱེ་བ་ཕྱེ་བས་ན་གྲོགས་ཀྱིས་སྒོ་ནས་དབྱེ་བ་ཞེས་བྱའོ།",
    "བརྗོད་དོན་གང་ཞིག་རྗོད་བྱེད་ཚིགས་བཅད་རྐང་བར་ཚེག་ཁྱིམ་མང་ཉུང་མི་མཉམ་པའི་ལམ་ནས་ཚིག་རྒྱན་དང་བརྡ་རྙིང་སོགས་ཀྱིས་རྒྱས་སྤྲོས་བྱེད་མི་བྱེད་རང་ལག་དང་རང་འདོད་ལྟར་བྲི་ཆོག་ལ།",
    "ཡོངས་རྫོགས་ཀྱིས་འདི་ཉིད་སྙན་ངག་གསར་པ་ལ་ངོས་འཛིན་བྱེད་ཀྱི་འདུག་པས།",
    "དེ་ལྟར་རྩོམ་ཚུལ་འདི་ནི་སྲོལ་རྒྱུན་སྙན་ངག་ལས་ཐ་དད་གསར་པ་ཞིག་ཏུ་ངོས་འཛིན་བྱུང་འདུག་སྙམ།",
    "ད་དུང་དར་སཀུད་གསར་པའི་ཆུན་འཕྱང་ཞིག་ཞལ་ནས་ནར་མར་སྐྱུག་བཞིན་འདུག་༡༩༨༧ ལོའི་སྦྲང་ཆར་དེབ་གསུམ་པ།",
    "དར་སྲིན་གྱིས་དར་སཀུད་སྐྱུག་དུས་ཀྱི་ལུས་སེམས་ཀྱི་འགུལ་བསྐྱོད་གསལ་བར་མཚོན་ཐུབ།",
    "རྣམ་སྨིན་འདིར་སྨིན་པ་ཡིན་ཞེས་བག་འཁུམས་ཏེ་འདུག་མི་རུང་ཞིང་།",
    "གཞོན་སྐྱེས་རྣམས་རྐང་ལག་བསཀུམས་ཏེ་ཅི་ཡང་མི་བྱེད་པར་འདུག་མི་རུང་བ་བཅས་མཚོན་ཞིང་།",
    "གསར་རྩོམ་བྱེད་མཁན་ཞིག་ལ་མཚོན་ན་འཚོ་བའི་ཉམས་མྱོང་དང་རང་སྐད་ཀྱི་བརྡ་སྤྲོད་ཤེས་བྱ་སོགས་རྩོམ་རིག་འགྲུབ་བྱེད་ཀྱི་རྒྱུ་འགའ་ཞིག་ངེས་པར་དུ་འཛོམས་དགོས་པ་སྨོས་མེད་ཐོག་ལྷག་པར་དུ་རྩོམ་སྟངས་སྣ་ཚོགས་ལ་བྱང་གོམས་དགོས་པ་ནི་མ་མཐའི་ཆ་རྐྱེན་ཡིན།",
    "བོད་ཀྱི་རྩོམ་འབྲིའི་ལག་ལེན་དངོས་དང་ཕན་ཚུན་མཐུན་སྦྱོར་གང་ལེགས་ཡོད་པར་བརྟེན་གཞུང་དེ་ལས་གཞན་ཞིག་བོད་ཀྱི་མཁས་པ་ཚོས་སྒྲིག་རྩོམ་མ་མཛད་པ་ལོས་ཡིན།",
    "མི་སྣའི་སེམས་ཁམས་དང་རང་གཤིས་མཚོན་ཕྱིར་མི་སྣའི་བྱ་བ་བཀོད་འབྲི་བྱེད་ཚུལ་བསྟན་ཏེ།",
    "ལུས་རྒྱན་གྱི་རྣམ་གཞག་ཁོང་དུ་ཆུད་རྗེས་སྐྱོན་སེལ་གྱི་ཚུལ་ཤེས་གལ་ཆེ་བར་བརྟེན་ལེའུ་གསུམ་པའི་མཇུག་ཏུ་སྐྱོན་གྱི་སཀོར་བསྟན་པའང་རང་དགར་འདོར་མི་རིགས་པས་སོ།",
    "ནག་ཚོ་ལོ་ཙཱ་བའི་ཇོ་བོ་རྗེའི་བསྟོད་པ་སོགས་གསར་རྩོམ་མཛད་པར་བརྟེན་སྔར་ལས་ལྷག་པའི་རྩོམ་རྩལ་མྱུར་ཚད་གདེང་འཇོག་མཐོ་བའི་གནས་སུ་སླེབས་འདུག་པ་མཚོན།",
    "འདི་ནི་དཀའ་ངལ་བྱུང་ན་མ་གཏོགས་བེད་སྤྱོད་མི་བྱེད་རྒྱུ་ཞིག་ཡིན་འདུག་༤",
    "ནམ་ཞིག་ན་ཅ་བ་ཨ་ཞང་།",
    "དེའི་བུ་ཅ་བ་ཨ་ཞང་ར་རུ་བ་རྨ་ཆུ་ཁ་ན་ཡོད་སྐབས་ཁྱིམ་ཚང་བཅོ་ལྔ་ཚུར་རྨེའུ་རུ་མའི་ནང་དུ་ཡོང་བའི་གྲས་ཡིན།",
    "རུ་དང་དམག་གཉིས་ལ་བརྡ་གསར་རྙིང་ཙམ་ལས་དོན་ལ་ཁྱད་པར་མེད་ཚུལ་བཞེད་འདུག་པས་ཞིབ་ཚགས་ཆེར་མ་ཐོན་པར་སྣང་།",
    "གོ་མཚོན་རིགས་ཀྱི་སྤུས་ཀ་དང་དམག་ཤུགས་ཀྱི་རྩལ་སྟོབས་གང་ལའང་གཞན་གྱི་དོ་ཟླ་མེད་པའི་ཚད་དུ་སླེབས་འདུག་གོ།",
    "དེ་དུས་གླིང་ཆེན་ཡོངས་རྫོགས་འདི་ན་བོད་དང་མཉམ་པའི་རྒྱལ་ཁབ་སྟོབས་ཆེ་བ་སུ་ཡང་མེད་པར་ཡོངས་སུ་གྲགས་ལ་ལྷག་པར་ཡང་རྗེ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་སཀུ་དུས་ཙ་ན།",
    "འོ་ན་ནང་བསྟན་བོད་དུ་དར་བའི་མགོ་ག་དུས་ཚུགས་པ་ཡིན་ཞེ་ན།",
    "འདི་འདྲ་ཞིག་ལོས་ཡིན།",
    "བོད་མི་ནང་ཚགས་ལ་དབྱེན་སྦྱོར་དཀྲུག་ཤིང་བཟོ་བཞིན་འདུག་པས་དེ་དག་གཅིག་ཀྱང་མེད་པ་འཕྲལ་དུ་ཕྱིར་འཐེན་ཡོང་བ་དང་།",
    "འབྲི་བའི་ལས་ལ་ང་རང་དགའ་བས་ཞུགས།",
    "ཞེས་པའི་ཡི་གེ་ནན་ཏན་ཅན་ཞིག་སླེབས་པར་བརྟེན་ཀོང་ཇོ་བོད་ལ་མི་འདུག་ཀ་མེད་བྱུང་བ་དང་།",
    "ཁོ་རང་ལ་སྲས་མེད་པས་མ་འོངས་པར་ཞིག་གསོ་དང་།",
    "ཡིད་མུག་པ་ཁོ་ན་ལས་མི་འདུག་ཟེར་བ་དེ་དང་།",
    "བཙན་པོ་ལ་བཀའ་ལན་ཞུ་ཡིག་ཐོག་བསཀུར་རྒྱུ་ནི་ཅང་མི་འདུག་འདི་བཙན་པོ་ལ་ཕུལ་ཅིག་ཟེར་ནས་དམ་ཆས་རྒྱ་ཡིས་མནན་པ་ཞིག་བསཀུར་བ་བཅས་ཁྱེར་ནས་ཕྱིར་བློན་པོ་བཙན་པོ་སྲོང་བཙན་གྱི་གམ་དུ་སླེབས་ཏེ།",
    "དབྱིན་ཇི་རྒྱ་གར་ནས་དམག་སྣོན་ཕོགས་རྫས་བྱ་སྤུ་ནོན་ཚུལ་བྱེད་ཀྱིན་འདུག་ཅེས་གསལ་བོར་གོ་ཐོས་བྱུང་།",
    "ཕྱི་ལོ་༡༩༤ ཟླ་གསུམ་པའི་ཚེས་སུམ་ཅུ་སོ་གཅིག་ཉིན་སྔ་དྲོ་ཙམ་ལ་དབྱིན་དམག་ཚོ་ཁག་གཅིག་རུ་བསྒྲིགས་ཏེ་ལམ་གཞུང་རང་དུ་ཡོང་བར་ལྷ་ལྡིང་ཅན་དང་རྣམ་སྲས་གླིང་བ་ཨབ་ཕྲུག་ཁ་ཤས་བཅས་འཛིང་རགས་ནས་ཐོན།",
    "དྲུང་ཡིག་མདུན་འདུག་པ།",
    "དེ་བར་ཕ་མ་དག་པ་མི་འདུག་པས།",
    "དེ་བར་ཕ་མ་དག་པ་མི་འདུག་པས།",
    "དེས་ན་གོང་གསལ་རྩོམ་ལུས་ཀྱི་གོ་དོན་དེ་གཉིས་ཀ་དོན་གྱིས་རྩོམ་ལུགས་སམ་རྩོམ་རྣམ་གྱི་གོ་དོན་ཞིག་ཡིན་འདུག་པས་དེ་དག་ལ་རྩོམ་ལུས་མི་ཟེར་ཞིང་།",
    "རྒྱ་གར་ལའང་ཤིན་ཏུ་གྲགས་ཆུང་ཞིང་སྦྱོར་བ་ཉུང་བ་ཞིག་ཡིན་འདུག་གཤིས་མང་དུ་རྩོད་པ་ལ་དགོས་པ་མེད་པས་བཞག་ན་ལེགས་སོ།",
    "ཁ་ཅིག་བརྩེ་མ་དང་བརྗོད་ནས་སྐྱིད་པའི་དབྱིངས་ན་བཟི་འདུག་པ་དང་།",
    "གླང་དར་ཡར་སྔོན་གྱི་རྩོམ་རིག་ལ་གནའ་རབས་རྩོམ་རིག་དུས་རས་བཅུ་གསུམ་པའི་དུས་ནས་ལོ་རབས་བརྒྱད་ཅུ་པའི་བར་ཉེ་རབས་རྩོམ་རིག་དེ་ནས་ད་བར་དེང་རབས་རྩོམ་རིག་ཟེར།",
    "གཞུང་རང་ཐོག་ནས་སློབ་སྦྱོང་ཐོན་མཁན་དང་།",
    "དཀྱུས་མའི་སྐད་ཆ་གཉིས་སུ་གྱེས་འདུག་དེ་གཉིས་གང་ཡིན་ནའང་མིའི་རིགས་ལ་ཞབས་འདེགས་ཞུ་ཞིང་།",
    "སྲིད་པ་ཆགས་གླུ་སོགས་འདྲེན་གྱི་འདུག་ན།",
    "སྙན་ངག་མང་དག་ཅིག་གཅིག་འདྲའི་རང་བཞིན་ཤུགས་ཆེ་བ་ཞིག་ཏུ་འགྱུར་བཞིན་འདུག་ཅེས་པ་ཕྱོགས་མང་པོ་ནས་གླེང་བཞིན་འདུག་ལ།",
    "ལག་ལེན་གྱིས་རིང་ལུགས་དེ་བདེན་དཔང་བྱེད་ཐུབ་ཀྱི་མེད་པའི་ལག་ལེན་གྱི་ཞན་ཆ་ཉིད་ལ་ཐུག་འདུག་སྙམ།",
    "ང་རང་ཁྱེད་ལ་གདོང་ཐུག་བརྒྱབ་མྱོང་ཡང་།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་ལྟའོ།",
    "དེ་ནི་ཁྱེད་དང་རྩོད་སྐབས་འབྱེད་པའི་ཆེད་དུ་ཁྱེད་ཀྱིས་དེར་འདོགས་ཀྱིན་འདུག་པའི་རྗེས་བརྗོད་བྱས་པ་མ་གཏོགས་དེ་ལྟ་བུའི་རྩོད་པས་མི་བརྫི་བའི་རྩོད་པ་ལས་གྲོལ་སྐབས་ན།",
    "དེ་ཁོ་ན་ཉིད་ལའང་རང་བཞིན་ཡོད་མེད་ཚུལ་བཞིན་དུ་དཔྱོད་པའི་རིགས་པས་གནོད་པ་མི་འབབ་པ་ཞིག་ནི་ཐ་སྙད་དུ་ཡོད་པར་འདོད་ལ།",
    "སོ་སོའི་ལུགས་ཀྱི་གཞན་ངོར་ཡོད་པ་དང་ཐ་སྙད་ཚད་གྲུབ་ཀྱི་དོན་འཇོག་ཚུལ་ཇི་བཞིན་ཤེས་ཚེ་དོན་ལ་གཅིག་ཏུ་གྲུབ་འདུག་སྙམ།",
    "ཁྱེད་དང་ང་གཉིས་སྟན་གཅིག་ལ་འདུག་པ།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པའི་འགྲེལ་པ་དང་།",
    "བལ་བོའི་སློབ་དཔོན་དེ་བ་ཤྲཱི་སོགས་ལས་ལེགས་པར་གསན་འདུག་པ་དང་།",
    "ལོ་ཙཱ་བ་རང་ཉིད་གང་ལ་དད་འདུན་ཆེ་བའི་ལྷག་པའི་ལྷ་འདྲ་མིན་ལ་འགྱུར་ཕྱག་མཛད་པ་སོགས་བྱུང་འདུག་པས་གཅིག་ཏུ་ངེས་པ་མེད།",
    "བསྔོ་བའི་ལེའུ་བསྟན་པ་ཡིན་ཚུལ་བཀོད་འདུག་གཞན་ཡང་།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏ།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏ།",
    "སྤྱིར་བདག་མེད་ཡིན་ན་རང་རང་འཛིན་པའི་རྟོག་པས་བཏགས་པས་ཁྱབ་ལ།",
    "ས་རྡོ་ཡང་རང་ཉིད་ཀྱི་ཉེར་ལེན་གྱི་རྒྱུར་གྱུར་པའི་སའི་རྡུལ་ཕྲན་དང་རྡོའི་རྡུལ་ཕྲན་ལས་བྱུང་བ་དང་།",
    "སའི་རྡུལ་ཕྲན་དང་རྡོའི་རྡུལ་ཕྲན་ཡང་རང་ཉིད་ཀྱི་ཉེར་ལེན་གྱི་རྒྱུར་གྱུར་པའི་ས་རྡུལ་ཕྲ་རབ་དང་།",
    "དུ་མའི་དབུས་ན་འདུག་པའི་ཕྱིར།",
    "ཡང་དེ་ཉིད་ཀྱི་རྩ་བ་དང་རང་འགྲེལ་ལས་ཀྱང་།",
    "རང་རང་ཁམས་དང་བསྟུན་གྱུར་ན་།",
    "གནས་དང་ཡུལ་དང་རང་མཚན་སྒོས།",
    "རིགས་དང་རང་བཞིན་སེམས་བསྐྱེད་བསམ།",
    "ཤིན་ཏུ་སྤེལ་བསྒོམས་འོག་མིན་འགྲོ།",
    "གླང་པོ་ཆེའི་ཐོད་པའི་སྟོད་དུ་འདུག་ནས།",
    "འདི་རྣམས་ཐམས་ཅད་དུ་བྱས་ནས་རི་དྭགས་ཀྱི་པགས་པའི་སྟེང་དུ་ཉེ་བར་འདུག་ནས།",
    "ཡིད་བཟླས་མ་བྱས་ཀྱང་གསལ་བ་བརྟན་པོ་འདུག་ན་མ་བྱས་ཀྱང་ཆོག།"
  ]
