    "ཉན་ཐོས་དང་རང་རྒྱལ་བ་དག་ལ་ཁུར་ཁྱེར་བ་དེ་མེད་པས་བཞོན་པ་དམན་པ་ཞེས་བྱའོ།",
    "རྞ་ཏཱཾ་ཞེས་པའི་དཔྱད་རྩོམ་འདི་ངོ་མཚར་ཆེ་པོ་འདུག་དེ་ཡང་སྟབས་བདེ་པོ་བྱས་བརྗོད་ན་ཡང་དག་པར་ལྡན་པའི་ལུང་དང་གཅིག་ལས་འཕྲོས་པའི་ལུང་དང་།",
    "སྐབས་དེར་གསུང་འབུམ་ལ་རྒྱས་པར་བལྟ་འདོད་པ་ལས་ང་རང་ལ་པར་པར་སྐྲུན་གྱི་འགན་འཛིན་པའི་སྤོབས་པ་དང་འདུན་པ་གཏན་ནས་སྐྱེས་མ་བྱུང་།",
    "ཁང་དཀར་མཆོག་ནས་ཀྱང་ཐུགས་དགྱེས་བཞིན་ང་རང་བྱ་བ་སྒྲུབ་པ་ལ་ནན་ཏན་ཡིན་པ་དང་།",
    "ཁྲི་གང་ལ་འདུག་པའི་དགེ་སློང་འཆག་པའི་མགོ་ས་ལ་ཐུག་པར་འགྱུར་བའི་ཁྲི་དེ་ལྟ་བུ་ལ་ཉལ་བར་མི་བྱ་བ་སྟེ།",
    "མལ་སྟན་མཐོན་བོ་དང་མལ་སྟན་ཆེན་པོ་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "འདུག་པའམ་ཉལ་བར་མི་བྱའོ་ཞེས་ཚིག་གཉིས་སྨོས་པའི་སྔ་མ་ཤོས་འདུག་པ་ཞེས་བྱའི།",
    "ཁྲི་བརྩེག་ཁྱེམའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་ཁྲི་བརྩེག་མ་ཞེས་བྱ་བ་ནི་ཁྲིའི་སྟེང་དུ་ཁྲི་བཞག་པ་སྟེ་དེ་ལ་འདུག་པར་མི་བྱའོ།",
    "འདུག་ན་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་གལ་ཏེ་དགེ་སློང་ལམ་པོ་ཆེ་ན་འདུག་པས་དགེ་སློང་མ་གང་ཡང་རུང་བ་ན་འདུག་པ་དེ་ལས་བཅའ་བ་དང་བཟའ་བ་ལེན་ཅིང་ཟ་བར་བྱེད་ན་དངོས་གཞིར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་དགེ་སློང་ལམ་པོ་ཆེ་ན་འདུག་པ་མ་ཡིན་པས་དགེ་སློང་མ་ལམ་པོ་ཆེ་ན་འདུག་པ་དེ་ལས་བཅའ་བ་དང་བཟའ་བ་ལེན་ཅིང་ཟ་བར་བྱེད་ན་ནི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དགེ་སློང་གཙུག་ལག་ཁང་ན་འདུག་པས་དགེ་སློང་མ་གྲོང་ན་འདུག་པ་དེ་ལས་བཅའ་བ་དང་བཟའ་བ་ལེན་ཅིང་ཟ་བར་བྱེད་པ་དེ་ལ་ནི་རྩང་བ་མེད་དོ།",
    "ཡོད་དེ་དགེ་སློང་གནས་ན་འདུག་པས་དགེ་སློང་མ་ཁྱིམ་གཞན་ན་འདུག་པ་ལས་ལེན་ནའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེའམ་དགེ་སློང་གཞན་ལ་འདི་ལ་བཅའ་བའམ་བཏུང་བའམ་སྲན་ཚོད་དམ་བཟའ་བའམ་ཡང་བྱིན་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པས་སྐོ་ཤམ་བྱེད་པ་ལ་ཞུགས་པའི་དགེ་སློང་མ་འདུག་པ་ནི་བྱེད་པ་པོ་ཡིན་ནོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཅི་དགེ་སློང་མ་དེ་ལྟར་གྱུར་པ་ཐམས་ཅད་ཀྱི་འདུག་པ་དེ་བྱེད་པ་པོ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "འདིར་དགེ་སློང་མ་ཐག་ཇི་སྲིད་ན་འདུག་པར་གྱུར་པ་ཁ་ན་མ་ཐོ་བ་ཇི་ལྟ་བུའི་བྱེད་པ་པོ་ཡིན་ཞེ་ན།",
    "གལ་ཏེ་དེ་སྐད་ཉེ་བར་གདགས་ཤིང་བསྒོར་མི་རུང་བའི་ཐག་དེ་ཙམ་ན་འདུག་པ་ལ་ཉེ་བར་མ་བརྟགས་ཤིང་མ་བསྒོ་ན་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་མཐའི་ཁ་མཉམ་པར་འདུག་པའོ།",
    "ལྟེ་བའི་གོང་རོལ་དུ་ཏ་ལའི་ལོ་མ་ལྟར་ལྟེབས་ཤིང་འདུག་པ་དེ་ལྟ་བུ་མ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "ཕུར་མ་ལྟར་འདུག་པར་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "གློ་ནས་ཕྱི་རོལ་གྱི་རིམ་པའི་གྲྭ་ཕུར་མ་ལྟར་འདུག་པ་དེ་ལྟ་བུ་མ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།་།",
    "དང་པོ་གསུམ་ཞེས་བྱ་བ་ནི་ཟླུམ་པོར་འདུག་པ་དང་ཧ་ཅང་རྩེངས་པ་མ་ཡིན་པ་དང་ཧ་ཅང་འཇོལ་བ་མ་ཡིན་པ་ཞེས་བྱ་བ་དེ་དག་གོ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "དེར་མ་བསྒོ་བར་སྟན་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཅི་སྲིད་དུ་མ་བསྒོ་བ་དེ་སྲིད་དུ་སྟན་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཁྱེམ་གཞན་དེར་སྟན་ལ་མ་བརྟགས་པར་འདུག་པར་མི་བྱ་བའོ།",
    "ཁྱེམ་གཞན་དེར་སྟན་ལ་ཟོན་ཡོད་པར་དལ་བུས་ལུས་ཕབ་སྟེ་འདུག་པར་བྱའི།",
    "རྐང་པའི་སྟེང་དུ་རྐང་པ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བའོ།",
    "བརླའི་སྟེང་དུ་བརླ་བཞག་སྟེ་འདུག་པར་མི་བྱའོ།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་སྟེ་འདུག་པར་མི་བྱའོ།",
    "ཐད་ཀར་གདངས་ཏེ་འདུག་པར་མི་བྱ་བ་བསྟན་ཏོ།",
    "ལག་པ་ལ་འགྲམ་པ་བརྟེན་ཧུནིཏེ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་རྐོམ་ཚུགས་བཅས་ཏེ་སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "སྟན་གང་ལ་འདུག་འདུག་འུ་པ་དེ་རྒྱབ་ཀྱིས་ཁྱེར་ཞིང་འགྲོ་བར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྟན་ལ་འདུག་པའི་གྲལ་གྱི་རིམ་བཞིན་དུ་ཟན་བླང་བར་བྱའོདུ།",
    "འདིར་རྒན་རིམས་སུ་བྱ་བ་ནི་མ་ཡིན་གྱི་སྟན་ལ་འདུག་པའི་གྲལ་གྱི་རིམ་དུ་བྱ་བ་ཡིན་ཏེ།",
    "རྒན་རིམས་མ་ཡིན་པར་འདུག་པར་གྱུར་ན་ཡང་ཇི་ལྟར་འདུག་པ་བཞིན་རྒན་རིམས་མ་ཡིན་པར་བྲིམས་པར་བྱ་བའི་རྒན་རིམས་ལྟག་འོག་ན་འདུག་པ་ལ་ཐོད་རྒལ་དུ་བྲིམས་པར་མི་བྱ་སྟེ།",
    "དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་རོ་ཞེས་བྱ་བ་ལ་འདིར་ཡང་དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དོ།",
    "ཁྱིམ་ན་འདུག་པ་ལ་མ་དྲིས་པར་དེའི་ཁྱིམ་དུ་མི་དབོའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་སྟན་ཞེས་བྱ་བས་ནི་འདུག་པའི་ས་ཕྱོགས་ཀྱང་གཟུང་བར་རིག་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "བྱེད་དེར་སྟན་ལ་འདུག་པ་དང་།",
    "གལ་ཏེ་དུས་དེའི་ཚེ་དགེ་སློང་མ་དེ་ལ་སྐྱེས་པའི་འདོད་པའི་འདོད་ཆགས་ཀྱི་བདག་ཉིད་ཀྱི་སེམས་དེ་ཡོད་པར་དགེ་སློང་མ་དེས་སྐྱེས་པ་འདི་བདག་ལ་ཆགས་སོ་སྙམ་དུ་ཤེས་པས་དུན་འདི་ལྟར་དགེ་སློང་མ་དེ་ལ་འདོད་པའི་འདོད་ཆགས་ཀྱི་སེམས་མངོན་སུམ་དུ་མ་གྱུར་དུ་ཟིན་ཀྱང་རང་ལ་བསམ་པའི་ཉེས་པ་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "གང་ན་དགེ་སློང་མ་དེ་འདུག་པ་དེར་འོང་བའོ།",
    "འདུག་པ་དང་འགྲེང་བ་དང་།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "མ་བསྒོ་བར་ཁྱིམ་པའི་མལ་སྟན་ལ་འདུག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྟན་ལས་གྱུར་པ་ཡིན་ནོ།",
    "དེ་ལ་བདག་ཉིད་འདུག་ཏུ་འཇུག་པའི་བསྙེན་བཀུར་གང་ཡིན་པ་དེ་ཉམས་སུ་མྱོང་བར་བྱེད་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "ཁྱེམ་གཞན་དུ་མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཕྱིས་གནོན་བྱེད་པ་ཞེས་བྱ་བ་ནི་ཟིལ་ཀྱིས་གནོན་ཅིང་འདུག་པ་ལའོ།",
    "མ་བཤམས་པ་ལ་འདུག་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "སོག་མའི་བུར་མ་ལ་སོགས་པ་རས་ཀྱིས་དཀྲིས་པའི་སྟན་འདུག་པར་བྱ་བའི་ཆེད་དུ་བོར་བ་དེ་ལ་འདུག་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "དེ་ལ་འདུག་པ་དང་ཉལ་བ་དག་ལ་ཡང་ཁ་ན་མ་ཐོ་བ་རྫོགས་པར་འགྱུར་ཏེ།",
    "འདུག་པས་དེ་འགྲེང་བས་ཧ་ཅང་ཡུན་རིང་དུ་འདའ་བར་བྱེད་ན་སྟན་ལ་འདུག་ཏུ་གཞུག་གོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་སྟན་ལ་འདུག་པས་དགེ་སློང་མ་དེ་འགྲེང་བའི་སྤྱོད་ལམ་ཀྱིས་ཧ་ཅང་ཡུན་རིང་དུ་འདའ་བར་བྱེད་ན་སྟན་ལ་འདུག་ཏུ་གཞུག་པའོ།",
    "མི་བྱེད་ན་འདུག་པའི་ཕྱིར་ཞུས་ཏེ་དེ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་མ་ཉིད་ཀྱིས་སྟན་ལ་འདུག་པར་བྱ་བའི་ཕྱིར།",
    "དགེ་སློང་ལ་ཞུས་ཏེ་གནང་ན་སྟན་དེ་ལ་འདུག་པར་བྱའོ།",
    "གལ་ཏེ་དགེ་སློང་ཡེངས་སམ་མི་དྲན་ན་དགེ་སློང་མས་འཕགས་པ་སྟན་ལ་མཆིས་སོ་ཞེས་ཞུས་ཏེ་འདུག་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གང་ལ་དོགས་པ་དང་བཅས་པ་ཡང་ཡིན་ལ་མི་མཐུན་པ་དང་བཅས་པ་ཡང་ཡིན་པའི་ཕྱོགས་དེར་འགྲོ་བ་ལ་ནི་རྩང་བྱེད་གཉི་ག་དུས་གཅིག་ཏུ་འབྱུང་ངོ།",
    "མུ་སྟེགས་ཅན་ཀྱི་གནས་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སོ།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "མ་བསྒོ་བར་ཁྱེམ་པའི་ཁྱིམ་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དེ་ཉིད་མ་གཏོགས་པ་དེ་ཡན་ཆད་དག་གོ།",
    "མ་བསྒོ་བར་ཁྱིམ་པའི་ཁྱེམ་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་བཞིན་དུ་གོས་ཀྱི་དུམ་བུ་ཚད་དུ་མི་ཆོག་པ་དུས་མ་ཚང་བར་བཅངས་ཏེ་གཏོང་བར་བྱེད་ཅིང་ཡང་གོས་ཀྱི་དུམ་བུ་གཞན་ཞིག་དུས་གཞན་དུ་བཅངས་ཏེ་གཏོང་བར་བྱེད་པ་དང་།",
    "དེ་དག་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "མིའི་འགྲོ་བ་པ་ཡིན་ཡང་རང་བཞིན་ཉམས་པ་སྦྱོས་པ་དང་།",
    "དེ་ལྟ་བུའི་འདུག་གནས་སུ་ཉི་མ་གཉིས་པར་ཟན་ཟ་བ་དང་།",
    "དེ་ལྟ་བུ་དག་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "གླེ་འདམས་པ་དང་མཚན་གཉིས་པ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་དང་།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་ནི།",
    "དེ་དག་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "དབེེན་པ་ན་འདུག་པ་དང་།",
    "འདུག་པའི་ཆེད་དུ་སའི་སྟེགས་བུ་དག་དང་ཁྱེའུ་ཡང་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདུག་པར་བྱ་བའི་ཆེད་དུ་ས་ལས་བྱས་པའི་སྟེགས་བུ་དག་དང་ཁྲིའུ་ཡང་བྱ་བའོ།",
    "འདིར་གཞུང་ནི་འདི་ལྟར་དེ་དག་དུས་རྟིང་སྤུལ་ཐུག་པ་ན་ཅི་བདེར་བྱེད་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "བསླབ་པ་བྱིན་པ་དེ་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་གན་དུ་འདུན་པ་ལེན་པ་འོངས་ན་ཡང་དེ་ལ་འདུན་པ་དབུལ་དུ་མི་རུང་ལ།",
    "ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།་",
    "ནམ་མཁའ་ལ་འདུག་པའམ་འགྲོ་བར་མི་བྱ་བའོ།",
    "འདིར་གཞུང་ནི་དེས་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཚེ་དང་ལྡན་པ་དགེ་སློང་མ་ལྷགས་བྱེཔ་རྣམས་ལ་འདུན་པ་དང་ཡོངས་སུ་དག་པ་བརྗོད་དོ།",
    "མཐོན་པོར་འདུག་སྟེ་ཕྱོགས་སུ་བལྟ་བ་ཞེས་བྱ་བ་ནི།",
    "ཤེས་པ་ཕྱིར་བཅོས་ཏེ་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འོན་ཏེ་མི་འོང་ན་ཕྱོགས་ཆེས་མཐོན་པོ་གང་ཡིན་པ་དེར་འདུག་སྟེ་ཕྱོགས་བཞི་ཀུན་དུ་རྣམ་པར་བལྟ་བར་བྱའོ།",
    "དེ་འབའ་ཞིག་ན་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་གཅིག་པུ་འདུག་ན་སྟན་དེ་ལ་འདུག་སྟེ།",
    "དགེ་སློང་ལྷག་མ་གཞན་ཅིག་ཡོད་ན་དེའི་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་སྟེ།",
    "འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་དེ་གནས་བརྟན་ཡིན་ན་ནི་གྲལ་གྱི་གཙོ་བོར་འདུག་པར་བྱ་སྟེ།",
    "འདི་དག་ནི་ཁྲི་སྟན་དུ་མ་བཤམས་པར་སྤྱིར་འདུག་པའི་ཆོ་ག་ཡིན་ནོ།",
    "འདི་ལྟར་ཤིང་ལྗོན་པ་གཅིག་པུ་ཞིག་ཕྱོགས་ཕྱོགས་ཀྱི་ཁྱམཚམས་འདོམ་པའི་དབུས་ན་འདུག་ན་ཤར་ཕྱོགས་པའི་ནུབ་ཕྱོགས་ཀྱི་མཚམས་ཀྱི་མུ་ཐུག་ཀྱང་དེ་ཡིན།",
    "དེའི་ནང་དུ་དགེ་སློང་གཞན་འདུག་པར་ཤེས་བཞིན་དུ་འདུན་པ་ལ་སོགས་པ་མ་བླངས་པར་ལས་བྱེད་ན་མི་མཐུན་པ་ཉིད་དུ་འགྱུར་རོ།",
    "འདུག་པ་དང་།",
    "ལ་ལར་སྔ་དྲོ་དང་དུས་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་དེ་ལ་སྦྱར་བར་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གཞུང་ཁ་ཅིག་ལས་ནི་ལ་ལར་སྔ་དྲོ་འདུག་པར་བྱ།",
    "ལ་ལར་གུང་ཚིགས་ལ་འདུག་པར་བྱ།",
    "ལ་ལར་ཕྱི་དྲོ་འདུག་པར་བྱ།",
    "ཇི་ལྟར་བྱིན་གྱིས་བརླབས་ཆ་པ་དེ་ལས་ལྷག་པར་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་འདུག་པར་མི་བྱའོ།",
    "རྩྭ་དྲུར་བ་བྲིམས་པ་དང་མདུན་དུ་འདུག་པ་ཡང་དགག་དབྱེ་བྱེད་པའི་ཡུལ་ཡིན་ནོ།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་བྱས་ཏེ་འདུག་པ་དེ་བཞིན་དུ་དགག་དབྱེ་བྱེད་པ་ཡང་འདུག་པར་བྱའོ།",
    "དགག་དབྱེ་བྱེད་པ་དེས་ཁབ་ལ་སོགས་པ་དེ་ལག་ཏུ་བླངས་ནས་རྒན་རིམས་ཀྱི་མདུན་དུ་འདུག་སྟེ།",
    "འདུག་པ་ཞེས་བྱ་བ་ནི་འཁོད་པའོ།",
    "གང་ཟག་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་ཀྱི།",
    "གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པའི་འོ་ཞེས་བྱ་བ་ཡང་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་ཏེ།",
    "གཞི་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པས་ཅི་ནས་ཀྱང་གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "དེས་ཇི་སྲིད་དུ་སྲ་བརྐྱང་འབྱིན་པར་མི་བྱེད་པ་དེ་སྲིད་ཀྱི་བར་དུ་ཡུལ་གཞན་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "དེ་དག་ནི་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དག་དང་རིས་མི་མཐུན་པ་ཡིན་པས་དེ་དག་ལ་ཡང་སྲ་བརྐྱང་གདིང་བ་མི་འབྱུང་ངོ།",
    "ཡ་ཡོར་མ་གྱུར་པ་ཞེས་བྱ་བ་ལ་ཡ་ཡོར་ཞེས་བྱ་བ་ནི་གྲྭ་དག་འཕྱངས་པའི་ཕྱིར་མི་མཉམ་པར་འདུག་པའོ།",
    "མནོས་པ་དང་རང་བྱེད་པ་དང་དེའི་མཇུག་དག་ཏུ་གོ་རིམས་བཞིན་དུ་འདིང་བར་འགྱུར་རོ།",
    "དེ་ལྟར་སྲ་བརྐྱང་འདིང་བར་བྱེད་པའི་དགེ་སློང་དེས་གནས་བརྟན་མན་ཆད་ནས་དགེ་སློང་ཐམས་ཅད་ཀྱི་མདུན་དུ་རྒན་རིམས་ཀྱིས་འདུག་སྟེ།",
    "བླ་གབ་མེད་པར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ཡང་དེ་ཁྱེར་ཏེ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེའི་ཕྱིར་འདུན་པ་མ་ཡུལ་བ་ལ་ནི་འདུག་ཏུ་ཟིན་ཀྱང་གཉིད་ལོག་གམ་སྙོམས་པར་ཞུགས་ན་མ་ཐོས་ཀྱི་བར་དུ་བཏིང་བ་དང་ཕྱུང་བ་མི་འབྱུང་ངོ་ཞེས་བྱ་བ་ནི།",
    "གདིང་བ་ཁྲ་བོ་བཀྲ་བ་ཁྲ་ཁྲ་བོར་འདུག་པར་བཅང་བར་མི་བྱའོ།",
    "གལ་ཏེ་གཙུག་ལག་ཁང་ན་དགེ་སློང་གཅིག་པུ་འདུག་པར་གྱུར་ལ།",
    "དེ་ལ་ནི་གང་ཟག་དུས་ཆེས་ཡུན་རིང་དུ་དབྱར་གྱི་ནང་ན་གནས་གནས་ན།",
    "གསར་བུ་ཞེས་བྱ་བ་ནི་གྲལ་ཐ་མ་ན་འདུག་པ་སྟེ།",
    "གང་ན་བྱིན་གྱིས་བརླབ་པ་བྱ་བ་འདུག་པ་དེ་ནི་མཚམས་སུ་གཏོགས་པ་རྣམས་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "གནས་གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་དངོས་པོ་འདུག་པ་དེའི་མཚམས་སུ་གཏོགས་པའི་རབ་ཏུ་བྱུང་བ་རྣམས་ནི་དེ་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གནས་གཞན་དུ་ཤི་བ་དེའི་ཡོ་བྱད་མཚམས་འདི་ན་འདུག་པ་ནི་མཚམས་འདི་ན་གནས་པའི་དགེ་སློང་རྣམས་ཀྱིས་སྙེབྱིན་གྱིས་བརླབ་ཏུ་རུང་བ་ཉིད་དོ།",
    "དེ་དག་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་འདུག་པ་ནི་མཚམས་ཀྱི་བར་ན་འདུག་པའོ།",
    "མི་བཤེས་པ་དང་མི་དྲན་པ་དང་རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་དག་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི།",
    "མི་བཤེས་པ་དང་དྲན་པ་དང་མི་ལྡན་པ་དང་རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་དག་ལ་ཡང་ཁབ་རལ་དེ་རག་ལས་པར་མི་བྱ་བའོ།",
    "ལྷས་མ་གྲུ་བཞིར་འདུག་པའོ།",
    "སྐུད་པ་མང་པོ་ལས་བཏགས་པ་ཉིད་ཡིན་པ་དབུས་ཁོང་སྟོང་དུ་འདུག་པའོ།",
    "དད་པ་སྦྱིན་པར་བྱ་བ་ཆུད་གཟན་པར་མི་བྱ་ཀྱེ་བར་འདི་ལྟར་སྟན་ནང་ཚངས་ཅན་ལ་འདུག་པར་བྱའོ།",
    "འདིར་སྟན་ནང་ཚངས་ཅན་ནི་དཔེ་ཙམ་དུ་ཟད་དེ་སྟན་གཞན་ལ་ཡང་འདུག་པར་བྱའོ།་།",
    "དེ་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྣམ་སྦྱར་དེའི་སྟེང་དུ་འདུག་པ་དང་ཉལ་བར་མི་བྱ་བ་སྟེ།",
    "སྣམ་སྦྱར་གྱི་སྟེང་དུ་འདུག་པར་མི་བྱ།",
    "ཁྲ་ཁྲ་བོ་མ་ཡིན་པ་ལས་གཞན་པ་ཁྲ་ཁྲ་བོར་འདུག་པ་དང་ཡུ་བ་རྩི་ཅན་དང་ཁྲ་བོ་ཡང་བཅང་བར་བྱ་སྟེ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་མ་དྲས་པ་དེས་གྲོང་དང་ཁྱེམ་གཞན་དུ་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གནང་བ་མ་ཡིན་པ་དང་སྲ་བརྐྱང་མ་བཏིང་བས་སྣམ་སྦྱར་མེད་པར་གར་ཡང་འགྲོ་བར་མི་བྱའོ་ཞེས་སྔར་འབྲལ་བའི་སྤང་བའི་རྣམ་པར་འབྱེད་པའི་སྐབས་སུ་བསྟན་པ་དེ་ལྟ་བུའི་རྐྱེན་དེ་དག་མེད་པར་སྣམ་སྦྱར་མ་དྲས་པ་དེས་གྲོང་དང་ཁྱིམ་གཞན་དུ་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་འཇུག་པ་དང་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "སྣམ་སྦྱར་མ་དྲས་པས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་དག་ཉེ་བར་མི་འཁོད་ཀྱང་འཇུག་པ་དང་འདུག་པར་མི་བྱ་བར་དགོངས་སོ།",
    "གལ་ཏེ་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་དག་ཉེ་བར་མི་གནས་སུ་ཟིན་ཀྱང་རྐྱེན་དེ་ལྟ་བུ་དག་མེད་ན་སྣམ་སྦྱར་མ་དྲས་པ་དེས་དེར་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "འཁོད་ན་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་དག་ན་མུ་སྟེགས་ཅན་དག་འཁོད་ན་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེར་སྣམ་སྦྱར་མེད་པར་འཇུག་པ་དང་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "འདིར་གཞུང་ནི་བཙུན་པ་ཀུན་དུ་རྒྱུ་བའི་འདུག་གནས་སུ་སྣམ་སྦྱར་མ་མཆིས་པས་མཆིར་རུང་ངམ།",
    "སྤུ་དམའ་བ་ཞེས་བྱ་བ་ནི་སྤུ་ཐུང་ངུ་སྟུག་པོ་ཕྱིང་ངེ་འདུག་པ་སྟེ་བེེའུ་རས་ལ་བྱའོ།",
    "ལ་བ་སྲུ་ཕྱིར་བསྟན་སྟེ་གྱོན་ལ་འདུག་པར་བྱ་ཞིང་ཉལ་བར་ཡང་བྱའོ།",
    "ཁྱིམ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་སྟན་གཞན་མེད་ན་ཀོ་ལྤགས་ཀྱི་སྟེང་དུ་འདུག་པར་བྱའོདུ།",
    "ཀོ་ལྤགས་ཁོ་ན་ཡིན་པས་དེའི་ཕྱིར་ཀོ་ལྔགས་ཀྱིས་བརྒྱུས་པའི་ཁྲི་དང་ཁྲིའུ་ལ་སོགས་པ་ལ་ཡང་འདུག་པར་མི་བྱའོ།",
    "དེའི་རྗེས་སུ་འབྲང་བས་རྐང་པའི་གནས་སུ་གདིང་བ་དང་འདུག་པ་དང་ཉལ་བར་རིགས་ཏེ་ཕན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་བསྟན་པའི་ཕྱིར་ཤིང་ཀན་ཙ་ན་དང་ཀཱ་སྤྲུ་དུཏ་ལ་དང་།",
    "དུས་སུ་རུང་བའི་ནང་ན་འདུག་པའི་ཐུན་ཚོད་དུ་བྱེད་རུང་བ་དུས་སུ་རུང་བ་དང་མ་འདྲེས་པ་ནི་ཐུན་ཚོད་དུ་རུང་བ་ཉིད་དུ་ཡོངས་སུ་ལོངས་སྤྱད་དུ་རུང་ལ།",
    "དེ་བཞིན་དུ་ཐུན་ཚོད་དུ་རུང་བའི་ནང་ན་འདུག་པའི་ཞག་བདུན་པ་ཐུན་ཚོད་དུ་རུང་བ་དང་མ་འདྲེས་པ་ནི་ཞག་བདུན་པ་ཉིད་དུ་ཡོངས་སུ་ལོངས་སྤྱད་པར་རུང་བ་དང་།",
    "ཞག་བདུན་པའི་ནང་ན་འདུག་པའི་འཚོ་བའི་བར་དུ་བཅང་བ་ཞག་བདུན་པ་དང་མ་འདྲེས་པ་ནི་འཚོ་བའི་བར་དུ་བཅང་བ་ཉིད་དུ་ཡོངས་སུ་ལོངས་སྤྱད་པར་རུང་སྟེ།",
    "སྟན་ལ་སོགས་པ་འདུག་པར་བྱ་བ་ཇི་སྲིད་དུ་མ་བཤམས་པ་ཚུན་ཆད་དོ།",
    "རྩྭ་བམ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྒྲ་བསྐྱུངས་པ་དང་ཤིན་ཏུ་བསྡམས་པ་དང་སྤྱོད་ལམ་མཛེས་པ་དང་མཛེས་པས་ཟས་ཀྱི་ཆེད་དུ་འདུག་པར་བྱའོ།",
    "གཞན་གྱིས་མགྲོན་དུ་བོས་པ་ནི་འདུག་པ་ལས་དེས་གནང་ན་གཞན་གྱིས་བྱིན་པ་ནི་དེའི་རྗོཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་གཞུང་ནི་ཕྱོགས་དབེེན་པར་འདུག་སྟེ་ལག་པ་དག་བསྙལ་དུ་བཅུག་ནས་སྣོད་མི་གཏོང་བར་བཟའ་བར་བྱ་སྟེ།",
    "ཟན་གྱི་ཕྱིར་འདུག་པས་འདིའམ་འདི་ནས་བྱིན་ཅིག་ཅེས་འདྲིམ་མཁན་ལ་གོ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཆབ་ཁུང་སའི་ར་བའི་སྒོའི་ལོགས་གཅིག་ནང་དུ་བསྣོལ་ལ་སྒོའི་ལོགས་གཅིག་ཕྱི་རོལ་ཏུ་བསྣོལ་ཞིང་ཅི་ནས་ཀྱང་སྒོ་དྲང་པོར་མི་འདུག་པས་ནང་དུ་ཞུགས་པའི་ཕྱི་རོལ་ནས་མི་སྣང་བ་དེ་ལྟར་སྒོ་གདོད་པར་བྱ་བའོ།",
    "ཆབ་ཁུང་ས་དེར་སྔར་ཞུགས་པའི་གང་ཟག་དེ་ན་འདུག་པས་ཀྱང་འཇུག་པར་འདོད་པའི་གང་ཟག་ཕྱིས་འོང་བས་སྒྲ་བྱས་པ་ཐོས་ན་སེ་གོལ་དང་ལུད་པ་ལ་སོགས་པའི་སྒྲ་དབྱུང་བའོ།",
    "དཀྱིལ་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་དང་འབྱེལ་པའི་དོན་ལས་གཞན་པས་དེའི་དྲུང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདུག་པར་མི་བྱ།",
    "ལྟོ་འཛག་པས་ནི་ཐ་མའི་མདུན་དག་ཏུ་ཕྱི་བ་ཙམ་བྱས་ཏེ་འདུག་པ་ལ་ཉེས་པ་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་ཡང་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "སྤྱོད་ལམ་ཐ་དད་པ་འདུག་པས་ཐ་དད་པ་ཉིད་དུ་སྣང་བའི་ཕྱིར་རོ།",
    "བསླབ་པ་མང་པོ་རྣམས་ལས་བཤགས་པར་བྱ་བ་རྣམས་ནི་ལེན་པར་བྱེད་པ་ཡོད་ན་ངེས་པ་ཁོ་ནར་བཤགས་པར་བྱ་སྟེ་འདུག་པར་བྱ་བའོ།",
    "ལེན་པར་བྱེད་པ་མེད་ན་ནི་བྱིན་གྱིས་བརླབས་ཏེ་འདུག་པར་བྱའོ།",
    "བསྡམ་པར་བྱ་བ་རྣམས་ནི་བསྡམས་ཏེ་འདུག་པར་བྱ་བའོ།",
    "མི་འདུག་པར་འགྲེང་བ་དང་།",
    "དེ་ལྟ་བུའི་དགེ་སློང་དེ་འདུག་པར་རྗེས་སུ་མ་ཞུགས་པ་ཉིད་དོ།",
    "སྤྱོད་ལམ་ལས་མ་ཉམས་པ་དང་རང་བཞིན་དུ་གནས་པ་དང་ངག་ཡང་དག་པར་བསྡམས་པས་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གཞན་ཡང་བྱ་བ་མ་ཡིན་པར་རྗོརྩང་བར་གྱུར་པ་དག་ལྷག་པར་སྤྱོད་པའི་རྗེས་སུ་མཐུན་པ་ཉིད་ཀྱང་རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་ཞེས་བྱའོ།",
    "འདུག་པ་ཞེས་བྱ་བའི་སྤྱོད་ལམ་དེ་བརྩམས་ཤིང་སྔར་འདུག་པར་གྱུར་པ།",
    "ལྷག་པོར་ཡང་མདུན་དུ་ཙོག་པུར་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བ་ལ་སོགས་པའི་སྐབས་ཐམས་ཅད་དུ་བསྙེན་པར་རྫོགས་པར་བྱ་བའི་གང་ཟག་དེ་ཕ་གུའི་སྟེང་དུ་རྟིང་པ་གཉིས་ཀྱིས་འདུག་ཏུ་གཞུག་པར་བྱའོ།",
    "ཙོག་པུར་འདུག་ཏུ་ཡང་མི་གཞུག་གོ།",
    "འདུག་ཏུ་གཞུག་ཅིང་འདུག་ཏུ་བཅུག་ནས་བསྙེན་པར་རྫོགས་པ་གསོལ་དུ་གཞུག་གོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གསོ་སྦྱོང་དང་དགག་དབྱེ་དག་བྱིན་གྱིས་བརླབ་པ་ནི་ཙོག་པུར་འདུག་སྟེ་བྱ་བར་གསུངས་པས།",
    "དེ་དེ་གཉི་ག་ཡང་འདུག་སྟེ་བྱའོ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ་ཞེས་བྱ་བ་ནི།",
    "གསོལ་བ་དང་གསོལ་བ་དང་གཉིས་དང་གསོལ་བ་དང་བཞིའི་ལས་ཐམས་ཅད་ནི་འདུག་པ་ཉིད་ཀྱིས་བྱའི།",
    "དེ་ལྟ་བས་ན་ཉམས་པའི་ཉེས་པ་སྤང་བའི་ཕྱིར་འདུན་པ་ལ་སོགས་པ་ལེན་པ་དེས་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བབེེབ་པའི་གཞི་བཅའ་བ་མཛད་དོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་རིག་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "ཉེ་བ་འཁོར་རང་བཞིན་དུ་གནས་པ་མཚམས་ཀྱི་ནང་དུ་འདུག་པ་ལའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་མ་རྫོགས་པ་མ་བསྙིལ་བ་ཡང་དག་པར་སྡོམ་པ་དང་ཁྱེམ་པ་ཡང་དག་པར་སྡོམ་པ་ཡང་རང་བཞིན་དུ་གནས་པ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "འདིར་གཞུང་ནི་མི་གནས་པར་འདུག་པར་མི་བྱའོ་ཞེས་གསུངས་པ་དེའི་དོན་ཅི་ལགས།",
    "གང་ཟག་གང་ལ་ལ་འགྲོགས་བཤེས་སམ་གུས་པའམ་ངོ་ཚ་ཤེས་པའམ་ཡིད་དུ་འཐད་པའི་སེམས་ཉེ་བར་གནས་པར་ཡོད་པ་དེ་ལ་གནས་ཏེ་འདུག་པར་བྱའོ་ཞེས་གསུངས་པའི་གཞུང་གནང་བ་ཡིན་ནོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དེ་དང་ལྷན་ཅིག་ཏུ་གོམ་པ་བསྲི་བ་ཉིད་མ་གཏོགས་པར་གོམ་པ་མཉམ་དུ་འདོར་བ་དང་།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་པས་འདུག་པར་ཡང་ངོ་ཞེས་བྱ་བ་ནི།་",
    "རྨྱེསྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་པ་མཉམ་པའམ་མཐོ་བས་འདུག་པར་ཡང་མི་བྱ་ན།",
    "དེ་གཉིས་འདུག་པས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་དུ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་པར་བྱའི།",
    "མཉམ་པའམ་མཐོན་པོ་ལ་འདུག་པར་མི་བྱའོ།",
    "སྤོ་བ་དང་མགུ་བར་བྱ་བ་སྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་བྱུག་ཏུ་ངོས་དང་སྟེང་གཡོགས་གཅིག་པའི་གནས་ཀྱི་ནང་ལ་མལ་བཅའ་བར་མི་བྱ་བའོ།",
    "འདིར་གཞུང་ནི་དགེ་སློང་ཐ་དད་པར་གནས་པས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་གདམས་ངག་གཞག་པར་མི་བྱ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དེ་དང་བསྟེན་པར་མི་བྱ།",
    "དེ་གཉིས་ཀྱིས་འདུག་པ་ལ་སོགས་པ་ནི་བསྙེན་པར་རྫོགས་པ་ཐམས་ཅད་ཀྱི་མཐའ་ཉིད་ཡིན་པ་སྟེ།",
    "དེ་ལྟར་ཡང་འདིར་གཞུང་ནི་སྤོ་བ་གསུམ་དང་རང་བཞིན་དུ་གནས་པ་གཅིག་གམ་སྤོ་བ་གཉིས་དང་རང་བཞིན་དུ་གནས་པ་གཉིས་སམ།",
    "སྤོ་བ་གཅིག་དང་རང་བཞིན་དུ་གནས་པ་གསུམ་ལ་སྒོ་བ་དང་མགུ་བ་བྱ་བ་དང་།",
    "གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྦྱོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བར་རིག་པར་བྱའོ།",
    "འདའ་བར་བྱ་བའི་གནས་གང་ན་མི་མཐུན་པ་ཞེས་བྱ་བར་དགྲ་བོ་ཡོད་པ་དེར་དེ་དང་ལྷན་ཅིག་ཏུ་འཁོད་པ་ཞེས་བྱ་བ་འདུག་པ་དང་།",
    "ཕྱོགས་གཉིས་པར་ཡང་རང་འགྲོ་བར་ཡང་མི་བྱ།",
    "ལོགས་ཤིག་ན་འདུག་ཤིག་ཅེས་ཟེར་བ་ཡིན་ནོ།",
    "ལྷན་ཅིག་འགྲེང་བ་དང་འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆགས་པ་དང་།",
    "འདུག་པ་དང་ཉལ་བར་བྱས་པས་གླེང་བ་བསྡུས་སོ།",
    "ཁྱིམ་གཞན་ན་འདུག་པ་དང་།",
    "ཟས་ཀྱི་གྲལ་ན་འདུག་པ་ཀྱིམ་གཏོགས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཁྱེམ་གཞན་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཁྱིམ་པའི་ཁྱིམ་ན་འདུག་པའོ།",
    "ཟས་ཀྱི་གྲལ་ན་འདུག་པ་ཞེས་བྱ་བ་ནི།",
    "ཁྱིམ་གཞན་ན་ཡང་འདུག་པ་ཡང་མ་གཏོག་པར་མི་རིགས་ཏེ།",
    "རབ་ཏུ་བྱུང་བ་ཁྱིམ་རྗོགཞན་ན་འདུག་པ་དག་ལ་ཡང་ཁྱིམ་པས་ཕྱག་བྱ་དགོས་སོ།",
    "ཁྱེམ་གཞན་ན་འདུག་པའོ།",
    "ཟས་ཀྱི་གྲལ་ན་འདུག་པ་དག་ནི་གཞུང་གཞན་ལས་བསྡུས་སོ།",
    "འདུག་པ་དང་ཉལ་བ་ན་འདུག་པའིའོ་ཞེས་བྱ་བ་ནི།",
    "ལུང་འབོགས་པར་བྱེད་པ་འདུག་པ་དང་ཉལ་བ་ན་ལུང་ནོད་པར་བྱེད་པས་འདུག་པའི་སྤྱོད་ལམ་བསྟེན་པར་བྱ་བའོ།",
    "གང་དུ་འདུག་པའི་སྤྱོད་ལམ་བསྟེན་པར་བྱ་ཞེ་ན་དེའི་ཕྱིར།",
    "འདིར་ཆེས་རྒན་པས་ནི་རྗེས་སུ་གནང་བ་ལ་མི་ལྟོས་པ་ཉིད་ཀྱིས་རང་འདུག་པར་བྱའོ།",
    "གསར་བུས་ནི་རྗེས་སུ་གནང་བ་ལྟོས་ཏེ་འདུག་པར་ཀྵེབྱ་བ་བསྟན་པའི་ཕྱིར།",
    "ལུང་འབོགས་པར་བྱེད་པས་བསྒོ་ཞིང་རྗེས་སུ་གནང་ན་འདུག་པར་བྱའོ།",
    "འདུག་པ་བསྟན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "འདུག་པའི་ཕྱིར་ལུང་འབོགས་པར་བྱེད་པ་ལ་ཞུ་བར་བྱའོ།",
    "གལ་ཏེ་གསར་བུ་ཡིན་ལ་མང་དུ་མནོད་ན་སློབ་དཔོན་ལ་ཞུ་བ་སྟེ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་ནས་ལུང་མནོད་པར་བྱའོ།",
    "ཇི་སྟེ་ལུང་མནོད་པ་སྤྱོནི་ཙོག་པུས་འདུག་སྟེའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཐོས་པའི་ཉེན་ཀོར་མ་གཏོགས་པ་སྣང་བའི་ཉེན་ཀོར་དུ་འདུག་སྟེ་ཁ་དོན་བྱའོ་ཞེས་བྱ་བ་ནི་ལུང་འབོགས་པར་བྱེད་པའོ།",
    "ཁྲིའུ་ལ་གཅིག་མ་ཡིན་པས་མི་བྱའོ་ཞེས་བྱ་བ་ནི་གཅིག་པོ་ཁོ་ན་དེ་ལ་འདུག་པར་བྱའོ།",
    "ལོ་གསུམ་ལས་ལྷག་པས་བར་དུ་ཆོད་པ་དང་ལྷན་ཅིག་སྟན་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་རྫོགས་པར་བསྙེན་པའི་དུས་ལོ་གསུམ་ལས་ལྷག་པས་བར་དུ་ཆོད་ཅིང་ཁྱད་ཞུགས་པ་རྒན་པ་དང་ལྷན་ཅིག་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱ་སྟེ།",
    "འདི་ལྟར་གཞོན་པ་ཆེས་རྒན་པ་དང་ལྷན་ཅིག་ཏུ་འདུག་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་དག་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་དང་མི་བྱའོ་ཞེས་བྱ་བ་ཡང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "བྱུག་རིས་མ་ཡིན་པར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེར་འདུག་པར་མི་བྱའོ་། བྱ་བ་བྱས་ན་འཁོར་ཞིང་སྤྱད་པར་འདོད་པ་ཡོད་ན་བཅང་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཆར་པ་ཆད་ན་དེའི་ཚེ་དྲུང་ན་འདུག་པའི་ཁྱེམ་གང་ཡིན་པ་དེར་གདུགས་དེ་བརྟགས་ཏེ་གཞག་པའོ།",
