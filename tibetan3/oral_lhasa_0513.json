    "དགུང་ལོ་བདུན་པར་གདན་སར་བཀོད་སྐབས་སྐྱ་སེར་རྣམས་ལ་དགའ་ལྡན་ལྷ་བརྒྱ་མའི་ཁྲིད་གནང་བས་ཀུན་ངོ་མཚར།",
    "བཅུ་གསུམ་པར་རོང་བོའི་གྲྭ་ཚང་དུ་ཚོགས་བཞུགས་གནང་།",
    "མཚན་གླེང་ཙམ་རོང་བོའི་གདན་རབས་སྐབས་སུ་བཀོད་པ་དེ་ལགས་ལ།",
    "དེ་དབོན་མཁས་མཆོག་བསྟན་འཛིན་འཕྲིན་ལས་སོགས་ཟམ་མ་ཆད་པར་བྱོན་པའི་རྒྱུད་དུ་རབ་བྱུང་བཞི་བའི་ཆུ་ཁྱི་ལ་སྐུ་འཁྲུངས།",
    "དགུང་ལོ་བཅུ་བར་མཁན་ཆེན་འཇིགས་མེད་ལུང་རིགས་རྒྱ་མཚོ་ལས་རབ་ཏུ་བྱུང་སྟེ་དགེ་ཚུལ་གྱི་སྡོམ་པ་བཞེས།",
    "མཁས་པར་བྱ་བའི་གནས་ལ་ཕྱོགས་མེད་དུ་སྦྱངས་མཐར་བཅད་ཅིང་།",
    "རྩ་ཤེས་སྤྱོད་འཇུག་སོགས་གསུངས་པའི་གྲངས་ཀྱང་བློས་མི་དཔོགས་པ་ལྟ་བུར་སྣང་།",
    "ཅེས་གསུངས་པས་ན་ཐམས་ཅད་དག་པའི་འཁོར་ལོར་འབྱམས་པའི་འབྲས་རྟགས་དང་།",
    "འཇིགས་བྱེད་ཀྱི་བསམ་གཏན་བདག་འཇུག་དང་བདེ་མཆོག་བདག་འཇུག་རྣམས་ཆག་མེད་གནང་ཞིང་།",
    "ཞལ་དངོས་སུ་བཞུགས་སྐབས་ལྟ་ཅི།",
    "ལྟ་བ་ཞིག་མེད་ན་འགྲུབ་དཀའ་གསུངས།",
    "ཨ་ལགས་འཇིགས་མེད་བསམ་གཏན་ཚང་ལ་ཞུས་དང་།",
    "འཕྱར་མི་ཉན་པའི་དར་ཞིག་འཕྱར་རྒྱུ་ཡོད་སོགས་མང་བོ་ཞིག་ལབ་པར།",
    "འཕྱར་མི་ཉན་པ་དེ་མ་ཕྱར་བ་ཨེ་ཡིན་གསུངས།",
    "ཞེས་ཐུགས་སྐྱོ་ཉམས་དང་བཅས་རྒྱུན་མར་གསུངས་པ་སོགས་རྗེས་སུ་ངོ་འཕྲོད་དོ།",
    "སྤྱན་དམིགས་གནང་བ་དང་།",
    "བཀའ་བཀྱོན་གནང་བ་དང་།",
    "ཁྱད་པར་མན་ངག་རྣམ་གསུམ་གྱི་ཁྲིད་སྔ་ཕྱིར་བརྒྱ་ལྷག་སོགས་རྒྱུ་ཆེར་སྤེལ།",
    "གསུང་རྩོམ་པོད་གཉིས་བཞུགས་ལ།",
    "དེ་ཕྱིར་མེས་པོས་བསྐལ་པར་བསམས་བྱས་ཀྱང་།",
    "མཐོན་པོའི་བྲག་རི་ཟད་པར་བྱེད་པ་བཞིན།",
    "ཞེས་གསུངས་པ་ལྟར་དམ་པ་འདིའི་རྣམ་པར་ཐར་བ་རྗེ་ཉིད་དང་མཉམ་པའི་ཡེ་ཤེས་ཁོ་ནས་གཞལ་བྱར་གྱུར་ན་ཡང་།",
    "དམུ་རྒོད་སྙིགས་དུས་འགྲོ་བའི་ལྷ་སྐལ་དུ།",
    "གཞུང་གང་ནས་གསུངས་ཀྱང་ནམ་མཁའ་ལ་མདའ་འཕངས་པ་བཞིན་ཐོགས་ཐུག་མེད་པ་དང་།",
    "སྐུ་ཚེ་གང་བོར་ལམ་ཁྲིད་ཚར་ལྔ་བཅུ་ལྷག་གནང་ཞིང་།",
    "སྐབས་བབ་ཀྱི་དམིགས་རིམ་དང་ཐོབ་བརྡ་འཕྲོད་པ་སོགས་ཆ་གང་ནས་ཀྱང་སྟོན་པ་འདི་ལྟ་བུ་གང་དུ་བཙལ་ཀྱང་མི་རྙེད་པའི་གནས་ལགས་པས།",
    "གསུངས་པ་དེ་ཁོ་ན་ལྟར་རོ།",
    "དགག་སྒྲུབ་གང་གནང་ལ་ཆེ་གསལ་མྱུར་ཟབ་ཀྱི་རྣོ་དབལ་ཁྱད་དུ་ཞུགས་ལ།",
    "འཇིགས་བྱེད་བཅུ་གསུམ་མ་ལ་ངོར་བ་ཀུན་བཟང་རྗེས་འབྲངས་བཅས་པས་དགག་པ་ལྟར་སྣང་མང་དུ་བྱས་པ་རྣམས་ལ་རིམ་ལྔའི་དཀའ་འགྲེལ་དང་།",
    "ཞེས་གསུངས་པ་ངེས་པའི་དོན་ལ་གནས་སོ།",
    "ཨེ་ཝཾ་གཟིམ་ཁང་གསར་བསྐྲུན་གྱི་སྐབས་སུ་གཙང་ཁང་ཁྱམས་སུ་སྲིད་པའི་འཁོར་ལོ་ཆ་ལྔ་བ་དང་།",
    "རྒྱུད་ནས་གསུངས་པའི་རྣལ་འབྱོར་པའི་ཡོ་བྱད་དང་།",
    "གྲུབ་དགུའི་མེས་པོར་ལྷུན་གྱིས་གྲུབ་པས་ཤར་ཆུ་བོ་གངྒཱའི་ཚུན་ན་འགྲན་ཟླ་མེད་པར་གྱུར་ཏོ།",
    "དེ་ཡང་སྲས་ཀྱི་ཐུ་བོ་ཕྱག་ན་པདྨོའི་སྒྱུ་འཕྲུལ་གོང་ས་ཐམས་ཅད་མཁྱེན་པ་སྐལ་ལྡན་བློ་བཟང་འཕྲིན་ལས་ལུང་རྟོགས་རྒྱ་མཚོ་དང་།",
    "སོ་སྐྱེའི་བློ་ལས་འགོངས་པའི་མཛད་པའི་ཆ་ཤས་ཙམ་ཞིག་གསང་རྣམ་རིན་ཆེན་དང་བོའི་སྦྲུམ་བུ་སོགས་ལ་མཇལ་ནས་རྟོགས་པར་བྱ།",
    "ཅེས་འཇིགས་མེད་གྲུབ་པའི་བདེན་གཏམ་དུ་བརྗོད་པ་རྒྱལ་བ་སྲས་དང་བཅས་པ་རྣམས་ཀྱིས་ཀྱང་ལགས་སོ་འབུལ་རུང་ཁོ་ནར་ངེས་སོ།",
    "དེ་ལྟར་དགུང་གྲངས་ཞེ་དགུ་བཞེས་པའི་ཧོར་ཟླ་དགུ་བའི་ཚེས་བདུན་ལ་བསམ་བཞིན་ལོངས་སྤྱོད་རྫོགས་པའི་ཞིང་དུ་རྒྱལ་བ་སྲས་བཅས་ཀྱིས་གདན་དྲངས་པ་ལྟར་གཤེགས་པ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་སློབ་དཔོན་ལ་བཞུགས་ཤིང་ལྕགས་མཁར་ལ་ལོ་ཉེར་ལྔར་བཞུགས།",
    "འདིའི་ཤོག་གྲངས་འགའ་མ་གཏོགས་མི་བཞུགས།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པའི་ཕྱག་ཚའི་འཇམ་དབྱངས།",
    "འཚོ་བྱེད་སྔགས་རམས་པ་བློ་བཟང་རྒྱ་མཚོས་ས་ཆོག་བྱས།",
    "བ་སོ་ལས་བྱས་པའི་དུར་ཁྲོད་ཀྱི་བདག་པོ་སོགས་བཞུགས་པའི་ལྷ་ཁང་ཞིག་ཀྱང་ཡོད།",
    "དགེ་སློང་བསམ་འགྲུབ་བཅས་ནས་འགན་སྐྱོང་གནང་།",
    "སྔགས་རམས་པས་ས་སྐྱ་ནས་ཁྱེར་ཡོང་བའི་རོལ་ཆས་ཆ་ལང་འབྲུག་རིས་མ་སོགས་ད་ལྟ་ཕྱིར་ཕེབས།",
    "གྱང་ར་ནས་དོམ་ལུང་ལྷ་སྐྱབས་ཟེར་བའི་གྲུབ་ཆེན་པ་ཞིག་འཁྲུངས་ཟེར།",
    "འདིར་སྔོན་རྟིས་ཚང་མ་ཎི་བ་ཤེས་རབ་བཀྲ་ཤིས་ཀྱིས་མཚམས་ཁང་བརྩིགས་ཏེ་ཐུགས་དམ་ཡུན་རིང་གནང་།",
    "གདན་ས་རང་ནས་རྒྱུན་བཞུགས་དང་ཐུགས་དམ་ཉམས་བཞེས་ལ་འགྲུས།",
    "དགེ་སྦྱོར་ལ་བརྩོན་ཞིང་རིག་པའི་གནས་ཐམས་ཅད་མཁྱེན།",
    "སེ་འབྲས་དགེ་གསུམ་སོགས་ལས་སྒྲུབ་པ་ཅི་རིགས་གནང་།",
    "གྲུབ་ཆེན་བརྒྱད་ཅུའི་ཐང་གམཆོད་རྫས་སོགས་ཕུལ་བ་བསྣམས་ཏེ་རང་ཡུལ་དུ་ཕེབས་པའི་ལམ་ཁར་རྒྱལ་མེ་ཏོག་ཐང་ནས་ཞག་བཞུགས་མཛད་ཚེ།",
    "འཇམ་དབྱངས་བཞད་པའི་རྡོ་རྗེས་ཀྱང་ཁོང་ཡང་རྗེས་ནས་ཕེབས་རྒྱུའི་སྐོར་གྱི་ཞལ་ཏ་ཡང་གནང་།",
