    "ཟུང་དུ་འཇུག་བྱ་གཉིས་ཀ་མེད་པར་དེ་ཉིད་ཟུང་དུ་འཇུག་པ་ནི་མིང་ཙམ་ལས་ཟུང་འཇུག་ཏུ་འཇོག་དཀའ་སྟེ།",
    "གང་ཟག་དེས་བུམ་པ་དང་ཆུ་ལྟ་བུ་བདེན་པར་མེད་ཀྱང་ཆུ་སྐྱོར་བ་ལ་སོགས་པའི་བྱ་བྱེད་རུང་བ་ཡང་ཤེས་ནུས་པ་ཡིན་པས།",
    "ཞེས་རྩ་ཤེ་ལས་གསུངས་པ་ལྟར་བྱེ་བྲག་སྨྲ་བ་སོགས་ཀྱིས་རྩོད་དོན་མེད་དེ།",
    "༢ ཞེས་གསུངས་ཤིང་རྣམ་འགྲེལ་ལས་ཀྱང་།",
    "༥ ཞེས་དངོས་པོ་རྣམས་རང་བཞིན་གྱིས་གཞན་དང་མ་འདྲེས་པར།",
    "སེམས་ཙམ་པས་གཟུང་བ་གཟུགས་ལ་སོགས་པར་སྣང་བ་ཐམས་ཅད་སྣང་ཡང་དེ་ལྟར་མ་གྲུབ་པ་སྒྱུ་མ་རྨི་ལམ་ལྟར་ཤེས་པས་ཕྱི་དོན་བདེན་མེད་དུ་ཤེས་པའི་གོ་མི་ཆོད་ན།",
    "སེམས་ཙམ་པས་གཟུང་བ་ཕྱི་དོན་དུ་མེད་པར་རྟོགས་ན།",
    "ཕྱི་དོན་ཞེས་པ་དེ་བདེན་པ་གྲུབ་པར་འདོད་དམ་མི་འདོད།",
    "ཞེས་གསུངས་ཤིང་།",
    "ཇི་ལྟར་སྒྱུ་མ་དེ་ལ་སྒྱུ་མ་བྱས་པ་རྟ་དང་།",
    "འཛིན་པ་ཉིད་དུ་སྣང་བ་ཀུན་བརྟགས་པའི་ངོ་བོ་ཉིད་ཀྱི་རྣམ་པར་རིག་པར་བྱའོ།",
    "ཤེས་རབ་ཀྱིས་རྣམ་པར་དཔྱད་ན།",
    "ཤོག་༡༩ ན་༤ དོན་དམ་བདེན་པར་འདོད་ལ།",
    "ཕྱི་རོལ་གྱི་གཟུགས་ལ་ཡོད་མེད་ཀྱི་ཁྱད་པར་འདོད་པ་ལ།",
    "དེ་བསལ་བའི་ཕྱིར་སེམས་བྱེད་པ་པོ་ཉིད་དུ་འདོད་པ་གཉིས་ཀ་ལ་ཉེ་བར་མཁོ་བའི་ཕྱིར་གཟུགས་ལ་རྟག་ཏུ་གནོད་པ་མེད་པས་གཟུགས་ཡོད་པ་ཁོ་ན་ཡིན་པ་ངེས་པར་བྱ་དགོས་པ་ནི།",
    "དེའི་ཕྱིར་གཙོ་བོ་ལ་སོགས་པ་བྱེད་པ་པོ་ཉིད་དུ་དོགས་པར་བྱས་པ་དེའི་མཚན་ཉིད་མེད་པ་ཁོ་ན་བསལ་བའི་ཕྱིར་བྱེད་པ་པོ་ཉིད་དུ་ནུས་པར་མཐོང་བའི་སེམས་ཙམ་ཞིག་བྱེད་པ་པོར་བརྗོད་པ་ན།",
    "དེ་བཞིན་དུ་འདིར་ཡང་གཉིས་ཀ་ལ་ཉེ་བར་མཁོ་བའི་ཕྱིར་གཟུགས་ལ་རྟག་ཏུ་གནོད་པ་མེད་པས་གཟུགས་ཡོད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བར་ངེས་པར་བྱའོ།",
    "ཞེས་གསུངས་སོ།",
    "སེམས་ཙམ་ཞེས་གསུངས་པའི་དོན་གཙོ་བོ་ལ་སོགས་པ་སེམས་ལས་གཞན་པའི་བྱེད་པ་པོ་བཀག་པ་ཡིན་གྱི།",
    "ཙམ་གྱི་སྒྲས་དོན་དེ་ཙམ་ལས་གཞན་སེམས་ཙམ་ཞིག་ཡོད་ཀྱི་གཟུགས་སམ་ཕྱི་རོལ་གྱི་གཟུགས་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གཟུགས་འགོག་པ་མི་རིགས་པར་གསུངས་ཏེ།",
    "རྒྱུན་དང་རགས་པ་དོན་དམ་པར་མེད་ན་མི་འཐད་ཅེས་རྩོད་པ་ག་ལ་ཡིན་ཏེ་རྒྱུན་དང་རགས་པ་འདི་པས་ཀྱང་ཀུན་རྫོབ་ཏུ་འདོད་པ་མིན་ནམ་སྟེ།",
    "དེས་ན་རྟག་བདག་སོགས་མེད་པར་ཤེས་སོ་ཞེས་ཀྱང་སྨྲ་བར་མ་བྱེད་ཅིག།",
    "གལ་ཏེ་རྟག་བདག་སོགས་མེད་པར་ནི་ཤེས་ཀྱང་།",
    "རྒྱུན་དང་རགས་པའི་རྩོམ་གཞི་སོགས་བདེན་པར་འདོད་པས་ན།",
    "གང་ཉིད་ཀྱི་ལྟར་ན་དེ་ལྟར་ཡོད་པ་ཤེས་པར་དཀའོ།",
    "རྒྱུན་དང་རགས་པ་སོགས་དོན་དམ་པར་མེད་ན་དེ་དག་མི་འཐད་ཅེས་རྩོད་པ་མ་ཡིན་གྱི།",
    "རྒྱུན་གྱི་རྩོམ་གཞི་སྐད་ཅིག་མ་ཉིད་མེད་ན་དེ་དག་མི་འཐད་ཅེས་རྩོད་པ་ཡིན་གྱི་རྒྱུན་དང་རགས་པ་དོན་དམ་པར་མེད་ན་མི་འཐད་ཅེས་རྩོད་པ་ག་ལ་ཡིན་ཏེ་རྒྱུན་དང་རགས་པ་འདི་པས་ཀྱང་ཀུན་རྫོབ་ཏུ་འདོད་པ་མ་ཡིན་ནམ་སྟེ།",
    "ཞེས་གསུངས་པ་ཡང་དཔྱད་གཞི་སྟེ།",
    "བདེན་པར་གྲུབ་པར་འདོད་པས་སོ།",
    "དེ་དག་ཀུན་དོན་དམ་པར་གྲུབ་པའམ་རང་ངོས་ནས་ཡོད་པའི་སྟོང་པའི་ཕྱིར་ཞེས་འགོག་པ་ཡིན་གྱི།",
    "ཡང་རྟག་བདག་མེད་པར་ཤེས་ན་རྟག་བདག་བདེན་པར་མེད་པར་ཤེས་དགོས་ཀྱང་།",
    "རྟག་བདག་མེད་པར་ཤེས་ཀྱང་བདག་བདེན་པར་མེད་པར་ཤེས་མི་དགོས་པའི་ཁྱད་པར་ཕྱེ་དགོས་ཏེ།",
    "དེ་ལྟར་ཁྱད་པར་མ་ཕྱེ་ན།",
    "འདུས་བྱས་རྣམས་མི་རྟག་པར་རྟོགས་ན་འདུས་བྱས་རྣམས་རྟག་པར་མི་བདེན་པའམ་བདེན་པར་མེད་པ་ཤེས་པ་ཡིན་པས།",
    "ཉན་རང་འཕགས་པའི་རྟོགས་རིགས་གསུམ་མངོན་རྟོགས་རྒྱན་ན་གསུངས་པ་བཞིན་ནོ།",
    "ཉན་ཐོས་པས་རགས་པ་རྣམས་མི་བདེན་པར་ཆ་མེད་ཙམ་དུ་རྟོགས་པ་དང་།",
    "རང་རྒྱལ་གྱིས་གཟུང་ཡུལ་རྡུལ་ཆ་མེད་ཀྱང་མེད་པར་རྟོགས་པ་དང་།",
    "མཁས་པ་གཞན་འགའི་བཞེད་པ་ལྟར་དེ་གཉིས་སོ་སོར་ཕྱེ་དགོས་པ་ནི་གལ་ཆེ་ལགས།",
    "སེམས་ཙམ་པས་ཕྱི་རོལ་གྱི་དོན་མེད་པར་བསམས་ཀྱང་།",
    "ཕྲ་བའི་རྡུལ་བདེན་པར་མ་གྲུབ་པ་དང་།",
    "སྔ་མས་བཞག་པ་ཕྱི་མས་མི་བཤིག་པར་རིམ་གྱིས་སྔ་མའི་མ་རྟོགས་པའི་ཆ་གོང་མས་སུན་ཕྱུང་བ་ཡིན་ནམ་མིན།",
    "ཡིན་ན་ནི་རགས་པ་བདེན་པར་མ་གྲུབ་པར་རྟོགས་པ་ཙམ་ལ་གོང་འོག་ཁྱད་མེད་ལ།",
    "གཞན་ཡང་ཆ་མེད་མ་གྲུབ་པར་རང་རྒྱལ་གྱིས་ཀྱང་རྟོགས་ནུས་ན།",
    "།་བརྟགས་པ་དེས་མ་གྲུབ་པར་རྟོགས་ཀྱང་།",
    "རྟ་ཡོད་པས་བ་ལང་མི་ཁེགས་པར་ག་ལ་འགྱུར།",
    "རགས་པ་བདེན་པར་མ་གྲུབ་པར་རྟོགས་པ་ལ་ཁྱད་པར་མེད་པ་མ་གྲུབ་སྟེ།",
    "དེ་ཙམ་གྱིས་རྡུལ་བདེན་པར་མ་གྲུབ་པར་རྟོགས་པའི་གོ་ག་ལ་ཆོད་དེ་མི་ཆོད་ལ།",
