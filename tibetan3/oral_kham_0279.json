    "སྔར་ཡང་ལབ་བྱུང་བ་བཞིན་ཁྱེད་རང་ལ་དགྲ་གཉེན་མང་པོ་ཡོད་པར་འདུག་ནའང་།",
    "དག་པའི་ཞིང་ཁམས་ལའང་དགོས་པ་མི་གདའ།",
    "རྗེ་བཙུན་མ་བྱོན་ནས་བཞུགས་འདུག་པས།",
    "རྗེ་བཙུན་མ་གསུང་འབྱོན་གྱི་གདའ་ལགས་སམ་ཞུས་པས།",
    "ཧེ་དེ་འདྲ་མི་འདུག་སྟེ།",
    "ཡང་དགེ་སྦྱོར་ལགས་སམ་མདང་ཞག་ནི་སྣ་ཚོགས་ཤིག་ལ་ཡེངས་གདའོ་གསུངས།",
    "ཐ་མལ་གྱི་སྣང་བ་ཙམ་མི་འདུག་ཅེས་པ།",
    "མཚན་མེད་ཀྱི་དགེ་སྦྱོར་ལ་མཚན་བཅས་ཀྱིས་མི་གནོད་གདའ་ཞིང་།",
    "སྤུར་ཁང་གཤིག་དུས།",
    "དོན་ཞགས་ཀྱི་སྐུ་བྱོན་འདུག།",
    "དངོས་པོ་གང་འདུག་ཡབ་ཀྱི་དགེ་རྩ་ལ་བཏང་།",
    "བྱིས་པ་གཞན་མིས་བརྡུངས་ཙ་ན་བཤུམ་པ་ཞིག་ཡོད་ཅེས་གྲགས་སོ།",
    "དེ་དུས་ཕར་ཚད་གཉིས་ལའང་ཊིཀྐ་བྱས་ན་ལེགས་རབ་ཡོང་བར་གདའ་སྟེ།",
    "ལེགས་རབ་ཅིག་བྱུང་ནས་འདུག་གསུངས།",
    "དེ་ནས་ཡང་བློ་ལ་གསལ་ལེ་འདུག་པས་ལྡབ་ནས་བྲིས།",
    "ཁང་པ་འདི་གྲུབ་ནས་ཁོང་པས་དགུན་ཅིག་ལས་མ་བཞུགས་འོ་སྐོལ་གྱིས་ལོ་གསུམ་ཅུ་རྩ་གྲངས་ཤིག་ཏུ་བེད་སྤྱད་འདུག་དེ་དུས་མ་འོངས་པའི་མངོན་ཤེས་གསུངས་པར་གདའ་གསུངས།",
    "བྱ་བ་དེར་ནི་སོ་ཆེ་ཤེས་རབ་འབུམ་ཁོང་ལ་ཡོད་པར་གདའ་གསུང་པ་ཡིན།",
    "རང་བཞིན་གྱིས་འདུག་ན་ཉམས་དགའ་ཞིང་།",
    "མི་འདི་དང་འདི་ཞེས་བྱ་བ་ཤི་ཟེར་བ་ཐོས་ཙ་ན་འོ་སྐོལ་གྱི་ལུས་འདི་ལ་ཡང་ཆུའི་ལྦུ་བའམ།",
    "སྐད་ཅིག་གནས་པའི་གདེང་ཡང་མི་འདུག་ན།",
    "སྒྲོལ་མ་སྒྲོལ་མ་འཕགས་མ་འཕགས་མ་གསུངས་ནས་སྤྱན་ཆབ་ཉིལ་ཉིལ་འདུག་པ་དང་།",
    "ཇོ་བོ་འདི་ལ་བྱིན་བརླབས་ཤིག་རང་གདའ་གསུང་ཟེར།",
    "དམག་ལ་འགྲོ་བའི་དུས་རིམ་གྲོ་ལ་གཏོར་མའི་ཆས་མང་པོ་སྐྱལ་ཙ་ན།",
    "སྲང་བར་ཞིག་ཏུ་འཕྲད་པས་ཉིད་ཀྱིས་དོན་གལ་ཅན་གྱི་བཏབ་བཅོག་པ་འདུག་ཟེར་ནས་འཐབ་ཏུ་བྱུང་བས།",
    "ཐབས་མཁས་ལ་ཐུགས་རྗེ་ཆེ་བའི་ཕྱག་ལེན་དུ་གདའོ།",
    "བཙུན་པ་ཐམས་ཅད་འབྱོན་པར་འདུག་དེས་ན་ང་ལ་ལྟོ་གཏེར་མི་མི་ཡོང་ཟེར།",
    "དེ་ཁོང་པ་མད་པར་གདའ་གསུང་ནས་སྤྱན་ཆབ་ཉིལ་ཉིལ་མཛད་ཅིང་འདི་ལྟར་གསུང་ངོ།",
    "བཤུམས་པའི་མཐར་བརྒྱལ་བརྒྱལ་གྱི་བར་དུ་བཤུམས་འདུག་ཅེས་གྲག་གོ།",
    "ཇ་གསོལ་ཟིན་པའི་རྗེས་ལ་ཡང་ཆུ་འདུག་ཡར་ལམ་ཕྱེད་ཀྱིས་ལྟས་པས་ཆུའི་རྗེས་ཡང་མི་འདུག་ཟེར་རོ།",
    "དྲུང་དུ་ཞིག་ཐོབ་ན་བསམས་པས་སྐུ་ཁམས་ཀྱིས་ལྕོགས་ཙམ་དུ་གདའ་ན་ཐུགས་ལ་འདོགས་པར་ཞུ་ཞུས་པས་དེ་དུས་སྙུང་རབ་འདུག་ཏེ།",
    "ཉིད་ཀྱི་ཤིག་བླངས་པ་མ་ཡིན་ང་རང་ལ་ཡོད་པ་ཡིན་གསུངས་ནས་མ་གནང་།",
    "རང་གྲི་དང་རང་ཐག་འོང་བཅུག་པས་དབེན་ཁྲིས་མཐོང་ནས་རྩ་ར་ཆེན་པོ་བྱེད་པ་ལ་བྱུང་བ་ལ་ཡང་གསུང་བྱོན་པ་ཙམ་གྱིས་གྲོལ་བར་བྱས་ཏེ།",
    "དེ་དུས་མཁན་ཆེན་བུ་སྟོན་པ་བསྙུངས་ནས་གྲོངས་ལ་ཁད་པ་འདུག་པ་ལ་མཇལ་ཏེ།",
    "རྨི་ལམ་བཟང་པོ་ཡིན་ང་ཡང་མདང་ཁམས་བདེ་ཞིང་རིག་པ་དངས་པ་ཞིག་བྱུང་གསུངས་ནས་མཉེས་འདུག་ཟེར།",
    "ཇག་པའི་རལ་གྲི་ཞིག་བཞག་འདུག་པ་ཁྱེར་ནས་བྲོས་ན་བསམ་ཡིན་ཡོད་ཙ་ན།",
    "ཕོངས་ནས་ཐབས་རྡུགས་པས་ཉིད་ལྟ་བུ་ཞིག་དང་ཐུག་ཟེར་ཡིན་འདུག་ཟེར།",
    "ཁོང་རྣམས་པས་འཇམ་དཔལ་དབྱངས་དོན་ཡོད་པའི་དྲུང་དུ་ཕྱིན་ཏེ་འདི་བཞིན་མཛད་ཡིན་གདའ།",
    "ངེད་ཚོས་ཞུ་བ་བྱས་ཀྱང་འདི་སྐད་གསུངས་ནས་མི་གསན་པར་འདུག།",
    "དྲུང་ནས་གསུང་འབྱོན་དགོས་པར་གདའ་ཞུས་པས།",
    "སེམས་དཔའ་ཆེན་པོའི་སྐུ་ལུས་ལ་འཕུངས་ནས་ཞག་གཅིག་ལ་ཤི་འདུག་ཟེར།",
    "ཡར་ལོང་ལ་ཤོག་གསུངས་ཡིན་འདུག།",
    "ཅེས་སོགས་ཀྱིས་བསྟོད་པ་མང་པོ་ཡང་འདུག་གོ།",
    "ངས་ལན་ཅིག་དངུལ་ཆུར་ཕྱིན་པས་ཀྱང་ཁོང་མཚམས་དམ་པོ་ལ་བཞུགས་འདུག་པས་མ་མཇལ།",
    "ཁོངས་མཚམས་དམ་པོ་ཅིག་ཡོད་པར་འདུག་པས།",
    "ཁོས་མ་ཤེས་པར་འདུག་མད་ལགས་ཟེར་རྒྱུ་ཡིན་ཏེ།",
    "དངོས་སུ་མི་ཆེན་གྱི་རིགས་འདུག་པ་ལ་ཡང་།",
    "འདོད་ཡོན་གྱི་སྲེད་པ་སྤངས་ཙ་ན།",
    "ཞེན་ཆགས་མི་མངའ་ཆགས་སྡང་རང་སར་གྲོལ།",
    "ལན་ཅིག་ས་སྐྱ་ན་སྤྲང་པོ་འཆི་ལ་ཁད་ཅིག་འདུག་པ་ལ།",
    "མ་ཤི་བར་ནམ་ལ་ཁྱིས་ཟ་བར་འདུག་ཟེར་ནས་སེམས་ལས་འདུག་པས།",
    "དངུལ་ཆུར་ཉེ་གནས་མེད་པའི་ཤུལ་དུ་གསེར་སློང་ལ་བྱང་དང་ར་ནས་ཡོང་བའི་མི་གསུམ་ཙམ་ཅིག་སློང་དུ་བྱུང་བ་ལ་ན་བཟའ་བེར་ཐུལ་ཅིག་དང་རྩམ་པ་གང་ཡོད་གནང་འདུག་ཟེར།",
    "གསུངས་པ་ལ་སློབ་དཔོན་ཡོན་ཏན་འོད་ཀྱིས་ཅི་གདའ་ལགས་ཞུས་པས།",
    "དེ་མ་ཡིན་པའི་མདར་ཞིང་འདེབས་ཕུར་འབྲོག་འཛིན་ལས་སུ་ཚོང་ཁེ་སྐྱེད་པ་འདི་རྣམས་ལ་ཁྲལ་མི་འགེལ་ན་དེ་ནས་སུ་ལ་འགེལ་དུ་འདུག་ཟེར་ནས་བྱུང་བས་འོ་སྐོལ་གྱིས་ཀྱང་ཟེར་ས་མ་རྙེད་གསུངས།",
    "མི་གནོད་གདའ་ཞིང་ཐབས་ཤེས་ཟུང་འབྲེལ་ཕྱིར།",
    "དེ་ཉིན་ཐུགས་ཁྲལ་ཆེན་པོ་མཛད་ཡིན་འདུག་ཟེར།",
    "གཟིམ་མལ་ན་གཡི་དཀར་གྱི་གདན་ཅིག་འདུག་པ་མཐོང་བ་དང་།",
    "ཐོ་རངས་ཁ་གསང་ནས་དངུལ་ཆུ་བཞུད་འདུག་ཅེས་གྲག་གོ།",
    "རྟིང་ལ་དྲངས་པས་ཧ་ཅང་ཡང་རོ་ཞིམ་དྲགས་འདུག་པས།",
    "ཧ་ཅང་རོ་ཞིམ་པ་དང་དང་མངར་བའི་སྲེད་པས་མཐུང་ན་ཡང་ཉེས་པར་འགྱུར་བ་ཡིན་གསུངས་ནས་མི་གསོལ་བར་འདུག་ཟེར་རོ།",
    "བསྙུང་གཞི་ཡོད་པ་ལ་ཕན་པར་འདུག་གསུངས་ནས་གསང་ཆབ་གསོལ་བ་དང་།",
    "དེ་ཀུན་འོ་སྐོལ་ཐུགས་རྗེ་ཆེན་པོ་དངོས་སུ་མཐོང་ཟེར་ནས་དག་སྣང་ཆེན་པོ་གདའ་གསུངས།",
    "གཉིད་སད་ནས་དེ་ཅི་ཡིན་སྙམ་ནས་ཡོད་ཙ་ན།",
    "དང་པོ་དངུལ་ཆུ་ཕྱིན་པའི་དུས་སུ་མཇལ་ཁ་མ་བྱུང་པར་སྒུག་དགོས་པ་བྱུང་བའི་ནུབ་ཅིག་རྨི་ལམ་དུ་ཆུ་ཆེན་པོ་ཅིག་ལ་མ་ཐར་བར་ལུས་འདུག་པ་ལ།",
    "ལར་ཡང་ཐུགས་རྗེ་ཆེན་པོ་ཟེར་ཙ་ན།",
    "ཁྱད་པར་དུ་རྒྱལ་བུ་ཆེན་པོ་དེ་ནི་བློ་གྲོས་ཀྱི་ནོར་བུ་ལྡན་པ་ཅིག་ཡོད་པར་འདུག་པས།",
    "ཁྲིད་པ་རྣམས་འཚོགས་ནས་གདའ་ཞུས་ན།",
    "ད་ལྟའི་སློབ་དཔོན་ཚོ་ལ་ལྟས་དེ་ལྟ་བུའི་མཛད་སྤྱོད་རང་དཀའ་བར་གདའོ།",
    "གཡེང་བ་ཆེས་འདུག་སྙམ་ཡོད་པ་ལ།",
    "ཁྱེད་ལ་ནོར་ཡོད་པར་འདུག་པས།",
    "ཡང་དེའི་ཟླ་གོང་དུ་གདན་འདྲེན་པའི་གསེར་ཡིག་པ་ཡོད་པ་འདུག་ཟེར་བ་ཅིག་ཐོས་ནས་སློབ་དཔོན་ཡོན་ཏན་འོད་ཀྱི་དྲུང་དུ་ཞུས་པས།"
  ]
}