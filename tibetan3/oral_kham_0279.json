    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "སྟོང་བ་ཉིད་ཀྱིས་རྒྱས་མ་ཐེབས་པའི་སྣང་བ་རང་ག་བ་ཆེར་མི་འཆར་བར་འདུག་ཅེས་གསུངས་ཤིང་།",
    "གསུངས་ནས་བཞག་ངའི་རིཊ་པ་འདི་གཞན་གྱིས་མ་ནོར་བར་མི་ཤེས་པར་འདུག་དགོངས་ནས་རྣམ་འགྲེལ་དུ།",
    "དེ་དག་རྣམས་ལ་རང་རང་སྐལ་བ་དང་།",
    "ཁྱེད་རང་ལམ་གྱི་ཡོན་ཏན་ཤིན་ཏུ་ཟབ་ཅིང་མཐོ་བ།",
    "རང་རང་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཡི།",
    "སྔར་གྱི་ཡིག་རྙིང་དཀར་ཆག་ཏུ་དེ་ལྟར་འཁོད་འདུག་པས་དགོས་པ་ཞིག་ཡོད་ཤས་ཆེ་སྙམ་དེ་ནང་ལྟར་བཀོད་པ་ཡིན་ནོ།",
    "དྲི་བའི་ཚུལ་དུ་ཞུས་པར་དགག་པའི་རིམ་པ་འགའ་ཞིག་གནང་འདུག་པ་ལས།",
    "དེ་ཡང་སློབ་དཔོན་པདྨའི་གསུང་ལ་ཁ་གཡར་བའི་ལུང་བསྟན་ཡིན་ཚུལ་ཚིག་དམ་དུམ་ཁ་ཤས་ཡོད་འདུག་པའི་ནང་ནས་སྔོན་ཆད་མིག་ལམ་དུ་སོན་པར།",
    "བེ་རོ་ཙ་ནའི་སྐྱེ་བ་ཞིག།",
    "དེ་ལ་བརྟེན་ནས་ཉི་ཟླ་བབས་པ་སོགས་ཀྱི་ངན་ལྟས་བྱུང་ཚུལ་ལབ་ན་རྒྱབ་སྐྱོར་དུ་ཨེ་འགྲོ་སྙམ་པ་ཡིན་འདུག་ཀྱང་།",
    "སྔཪ་ཇོ་བོ་ས་འོག་ཏུ་སྦསཔའི་དུས་སུའང་རབ་གནས་ཉམས་ནས་ཉི་ཟླ་མར་བབས་སྙམ་པའི་དོགས་པ་ནི་ཁྱི་རྒན་རྒྱ་བོ་ལ་ཡང་མ་བྱུང་འདུག་པས་སོ།",
    "དེ་ཡང་གྲངས་ངེས་འདོགས་ཁ་བོ་བྱས་ན་བདེན་པར་འཛིན་ཨེ་ཡོངབསམས་པ་ཡིན་འདུག་ཀྱང་།",
    "ཁོ་རང་དང་རིགས་མཐུན་བྱུང་ན་མ་གཏོགས་སུས་བདེན་པར་འཛིན།",
    "པདྨ་གླིང་པ་གཉིས་ལ་ཁག་བྱུང་བ་ལྟར་ཕལ་ཆེར་མིན་ནམ་དགོངས་པ་ཞིག་ཀྱང་བྱུང་འདུག་རུང་།",
    "པདྨ་གླིང་པ་ལ་ངོ་འདྲ་གཉིས་བྱུང་ཚུལ་ཞིག་ཀྱང་འདུག་པ་ལྟར་ན་འདྲ་མིན་དེས་མ་བྱས་པའི་ངེས་པ་ནི་ག་ལ་མཆིས་ཀྱང་།",
    "ཤཱཀ་མཆོག་པ་དེ་རྫེ་ཐམས་ཅད་མཁྱེན་པ་ལ་མ་གུས་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "གཞུང་ལུགས་ལ་སྦྱངས་པ་མཛད་ཅིང་མཁས་པའི་ཁུར་ཆེ་ཙམ་བཞེས་པ་ཞིག་ཡིན་འདུག་ན།",
    "རང་རང་རིགས་མཐུན་མགྲིན་པ་བཟང་བོའི་ཁྱུར།",
    "ཁ་སང་ནུབ་སྔོན་མ་ལ་བུམ་པ་ཆུས་བཀང་བ་སྟེར་རྩིས་བྱེད་པའང་འདིའི་ལྟས་སུ་འདུག་དགོངས་པ་བྱུང་ཞེས་གསུངས་ཏེ།",
    "བཞེངས་ནས་བསྐོར་བ་འགའ་ཡར་ཞིག་མཛད་ནས་བཞུགས་གདན་ལ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་ཏེ།",
    "དེའི་སྟོབས་ཀྱིས་བར་ཆད་ཀྱི་མཚན་མ་དེའང་མྱུར་དུ་ཞི་འགྲོ་བ་ཞིག་འདུག་ཅེས་གསུང་ངོ།",
    "ཤིང་རྟ་ལོ་ཟླ་བ་དང་པོའི་ནང་ཡིན་པར་གསུངས་འདུག་གསང་རྣམ་དུ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡང་དག་མཐའ་མངོན་སུམ་དུ་བྱེད་ཚུལ་དཔྱིས་ཕྱིན་པ་ཞིག་གོ་བ་ནི་སྔགས་ཀྱི་སྤྱོད་པའི་སྐབས་ཤིག་ལེགས་པར་གོ་བ་ལ་རག་ལས་པར་འདུག་ཅེས་གསུང་ངོ།",
    "མཆོད་རྟེན་གྱི་གོ་ས་གཅིག་འདུག་པ་དེར་གསོལ་བྱས་པས་ད་ལྟ་མཆོད་རྟེན་མི་འདུག་པ་ཟེར།",
    "གཞན་མང་པོ་ལ་གསོལ་བྱས་པས་བཅོས་དགོས་པར་འདུག་པས་མི་གསོལ་ཟེར།",
    "བདེ་མཆོག་སྟེ་གཙོ་བོ་གསུམ་ཡང་རང་བྱོན་ལྟ་བུར་བྱོན་ཞིང་།",
    "གྲོགས་ཁྱད་པར་ཅན་མཛད་པ་ཡིན་པར་འདུག་ཅེས་གསུངས།",
    "དབྱངས་ཀྱི་ང་རོ་དང་བཅས་ན་ཤིན་ཏུ་དགྱེས་པར་འདུག་པས་འདི་བཞིན་བྱེད་པ་ཡིན་གསུངས་ནས།",
    "ཨ་ར་པ་ཙ་ན་བདུན་སྟོང་།",
    "རྐང་རྟེན་བཅས་པའི་ཁྲི་ལ་རབ་འདུག་ཅིང་།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "དམའ་བའི་སྟན་ལ་འདུག་པ་དང་།",
    "འཆད་པར་མཛད་པ་འདུག་སྟེ།",
    "ཞེས་ཟེར་བ་འདུག་ཅེས་བྱུང་སྟེ་དེ་དག་ནི་རྗེ་ཉིད་ཀྱིས་འཇམ་དབྱངས་ལ་བསྟོད་པ་མཛད་པ་ལས།",
    "སྣ་ཚོགས་ཚོན་དང་ཕྲད་པའི་ཤེལ་བཞིན་གྲངས་མེད་གདུལ་བྱའི་རང་རང་སྐད་དང་མཐུན་པར་ནི།",
    "གང་ཟག་གཅིག་ལ་སྔགས་དང་མཚན་ཉིད་ཀྱི་ཐོསབསམ་གཞི་མཐུན་དུ་འདུག་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "གྲུབ་ཐོབ་ཡིན་པའི་རྟགས་སུ་འདུག་ཟེར་བ་དང་།",
    "མཁས་གྲུབ་ཡིན་པའི་རྟགས་སུ་འདུག་ཟེར་བ་བྱུང་ཡང་བློ་ཆུང་བ་དང་།",
    "དེ་ཕྱིར་འདྲེན་པ་འདིས་ཀྱང་རང་གཞན་ཀྱི།",
    "ད་ལྟའི་དུས་ནའང་རང་ཅག་རྣམས་ཀྱིས་ཉན་སེམས་ཀློག་པའི་སྤྱོད་ཡུལ་དུ་གྱུར་པ་འདི་ལྟར་བྱུང་བ་དང་།",
    "ལུགས་དེ་ཉིད་གཞིར་བྱས་པ་ལའང་རང་ཚིག་འགལ་བའི་ཉེས་པ་ལན་གཅིག་མ་ཡིན་པར་འབབ་པ་དག་མཐོང་བ་ལགས་ན།",
    "ཡང་རང་ཚིག་དངོས་ཤུགས་འགལ་བ་དང་།",
    "པཎ་ཆེན་གྱིས་ནི་དཔྱད་གཞི་ཙམ་དུ་མཛད་པ་ཡིན་པ་ལས་སྐྱོན་ཅན་གྱི་དགག་པ་མཛད་པ་མི་འདུག་གཞན་དགག་ཚིག་བྱེད་པ་དུ་མ་ནི།",
    "དེ་ནི་ང་རང་ལ་སྔ་ཕྱིའི་བར་ཆད་ཆེས་པ་དང་།",
    "ཞེས་པའི་ཚིགས་བཅད་གཅིག་བྲིས་པའི་དཔེ་ཞིག་བཞུགས་འདུག་པ་ལ་བསམས་ན་བཟོ་རིག་རྣམ་དག་མཁྱེན་པའི་རྟགས་དང་།",
    "ཞེས་སོགས་ཞུ་ཡིག་རྒྱས་བསྡུས་གཉིས་ཕུལ་འདུག་པ་ལ་བསམས་ན་ཡང་།",
    "ཁོང་ལ་ཡང་ཉམས་མྱོང་དང་གོ་བ་བཟང་པོ་ཞིག་འདུག་སྟེ།",
    "ཞེས་མགུར་ཞིག་གསུངས་འདུག་པ་དང་།",
    "དེ་ཉིད་ཀྱིས་འཇམ་དབྱངས་བཀྲ་ཤིས་དཔལ་བཟང་ལ་གསུངས་ཚུལ་ཁོང་ནས་ང་རང་ལ་གསུངས་བྱུང་བ་དང་།",
    "སྡོམ་པའི་སྲུང་སྡོམ་སོགས་ལ་མ་འབད་པར་དང་པོ་ཉིད་ནས་ཀུན་རྟོག་བཟང་ངན་ཐམས་ཅད་བཀག་ནས་དམིགས་པ་གང་ཡང་ཡིད་ལ་མི་བྱེད་པའི་ཙམ་འཇོག་བྱས་པ་ཁོ་ན་ལས་མཆོག་ཏུ་གྱུར་པ་མེད་འདུག་སྙམ་དུ་སེམས་པ་མང་ལ།",
    "མི་གསལ་བའི་བྱིང་བ་དང་བྲལ་བ་ཞིག་དགོས་པས་ན་དྲན་ཤེས་བཞིན་གྱི་བྱ་ར་དང་མ་བྲལ་བ་ཞིག་ངེས་པར་དགོས་རྒྱུ་ཡིན་འདུག་པ་ལས།",
    "རྒྱ་ཧོར་གྱི་ཡུལ་གྲུ་རྣམས་སུའང་གདན་ས་པ་ཆེན་པོ་རྣམས་ཀྱི་རྗེས་སུ་ཞུགས་པའི་དགེ་དགོན་མང་ཙམ་ཡོད་འདུག་པ་ལས།",
    "གཟན་ཤམ་སྟོད་འགག་སོགས་རབ་ཏུ་བྱུང་བའི་རྟགས་ཆ་ལུགས་ཙམ་ལ་ངེས་པར་སྐྱབས་བཅོལ་བ་མང་དུ་འདུག་པ་དེ་གང་ཞིག་ཡིན།",
    "དེས་ན་ཁྱེད་རང་ཡང་མཛེས་སེ་ཁབ་ཏུ་བཞེས།",
    "སྐྱེས་མཆོག་མར་པ་ལོ་ཙཱ་ཁོང་ནི་འགྲོ་བའི་དོན་དུ་ཡུམ་བཞེས་འདུག་དེ་ལྟ་བུའི་ཡོན་ཏན་དང་ནུས་པ་བདག་ལ་མེད་པས།",
    "ཕོ་ལས་བྱས་པར་འཛིན་ཞིང་འདམས་པ་བྱུང་འདུག་ལ།",
    "གཟི་བརྗིད་ཀྱི་ཟིལ་ཤིན་ཏུ་ཆེ་བར་འོང་བ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "བཅས་དང་རང་བཞིན་ཉེས་པས་ཆ་ཙམ་ཡང་།",
    "བའི་མི་ཉེ་རིང་དུ་སྲིད་པར་འདུག་ཀྱང་དེ་ལྟ་བུ་མ་ཡིན།",
    "མྱུར་དུ་འཚང་རྒྱ་བའི་ཐབས་སུ་འགྱུར་བར་འདུག་སྟེ།",
    "སྤྲོ་སྣང་རྣམ་དག་འཆར་གྱིན་འདུག་ཅེས་དང་།",
    "ལུག་ལོ་སྟོན་ང་རང་ན་བ་ཕྱིན་ཆད་དཔེ་ཕལ་ཆེར་འཐོར་བ་དང་།",
    "དམ་ལྡན་རྣམས་ནི་ཅི་སེམས་ཀྱང་དམ་ཉམས་ཚོ་ནི་དགའ་བདེརའདུག་གོ།",
    "ཡང་རང་ཉིད་ལ་ཕྱོགས་འབུལ་བྱེད་མི་དུ་མ་གོང་འོག་ནས་བྱུང་བ་དང་།",
    "ང་རང་རྣམས་ཀྱིས་བྱས་པ་ཡིན་ལ།",
    "གཞན་གྱི་དགེ་དང་མི་དགེའི་ཡུལ་ཅི་ཞིག་མངོན་དུ་གྱུར་ཀྱང་བདེ་སྟོང་སྒྱུ་མ་ལྟ་བུའི་བློས་མ་ཟིན་པ་ནི་མི་འོང་འདུག་ཅེས་གསུངས་པ་དང་།",
    "གྲུབ་ཆེན་ཕལ་ཆེ་བ་དག་མཐུན་པ་ཉིད་དུ་ཡིད་ལ་བརྣགས་ཏེ་འདུག་གོ།",
    "བདག་ཅག་བཏང་སྙོམས་འདུག་པ་མི་རིགས་ཞེས།",
    "ཕྱག་རྒྱ་བ་གཉིས་ཀ་ལ་མ་བྱུང་འདུག་སྙམ་དུ་རྗེའི་སྐུ་ཆེ་བའི་ཡོན་ཏན་དྲན་ནས་དད་པ་ཆེན་པོ་བསམ་གྱིས་མི་ཁྱབ་པ་འཁྲུངས།",
    "ཁྱེད་རང་གང་དུ་བཞུགས་པའི་ཞིང་ཁམས་དེར།",
    "ད་ལྟ་འཕགས་པའི་ཡུལ་གྱི་ཕྱི་ནང་ཀླ་ཀློ་ཐམས་ཅད་ཤིན་ཏུ་གུས་ཤིང་འཇིགས་པར་བྱེད་གདའ་ཞེས་གསུངས་ཏེ།",
    "ངེས་བརྗོད་པ་མི་འདུག་ཅེས་གསུངས་པ་ལྟར་ཡིན་ལ།",
    "ལྷོ་བ་ནམ་མཁའ་བཟང་པོ་སྟེ་བདུན་ལ་ངོས་འཛིན་གྲངས་འདྲེན་མཛད་པ་ཡང་ཡོད་འདུག་པར།",
    "དོན་གཉིས་རྣམ་དག་འགྲུབ་པའི་སྐྱེས་བུ་ཆེན་པོ་ཡིན་པར་འདུགསེམས་དཔའ་དེ་རི་བོ་དགའ་ལྡན་དུ་བཞུགས་མུས་ནས་སྟོད་ཕྱོགས་ལ་འབྱོན་གྲབས་ཡོད་པའི་དུས་ཉིན་གཅིག་ཐུགས་དགོངས་ལ།",
    "སྔགས་ཆོག་དུས་འཁོར་དང་།",
    "སྐུ་འཁོར་རྣམས་ཀྱིས་ཉིན་གང་སོ་བཙུགས་པར་མཐོང་རྒྱུ་ཅི་འདྲ་འདུག་གསུང་བ་ལ།",
    "ལུགས་གཉིས་ཀྱི་ཆེ་ཐང་བྱུང་ཚུལ་སོགས་ཡ་མཚན་པ་མང་པོ་ཞིག་འདུག་སྟེ།",
    "གྲངས་ཀྱི་འདྲེན་ལུགས་སོ་སོ་བ་ཡང་སྔོན་དུས་སུ་བྱུང་བ་དཔེ་ན་འདུག་པ་དང་།",
    "དེ་ལྟར་འདུག་པའི་སྐལ་མེད་དང་།",
    "རས་ཆེན་འདི་རྗེ་ལ་དད་པས་དམིགས་བརྩེ་མའི་མཚོན་སྲུང་མཛད་པས་མཚོན་ཡང་ཐུབ་ངེས་སུ་འདུག་ཅིང་།",
    "མང་བར་འདུག་ཀྱང་འདིར་མ་སྨོས",
    "རང་རང་འཁོར་ཚོགས་དུ་མས་བསྐོར",
    "རོ་སོལ་ནང་ན་གཏེར་སྒྲོམ་འདུག",
    "འདུག་པ་ཉིད་ན་སྐད་འཕང་མཐོན་པོས་སྨྲ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་དག་རྣམས་ཀྱང་འཛིན་པར་བྱེད་ཅིང་ཡང་གང་དག་དུས་ཤིན་ཏུ་རིང་བ་ན་དཀའ་བླས་ཆེན་པོས་ལྡང་བར་འགྱུར་ཏེ།",
    "འཆི་བདག་དུས་ནི་ཉེར་བྱུང་ལ།",
    "དེ་དང་ཡང་དག་པར་ལྡན་པའི་དགེ་སྦྱོང་ངམ་བྲམ་ཟེའམ་དེ་དག་དང་རང་བཞིན་མཚུངས་པར་གྱུར་པ་གཞན་རྣམས་ཐམས་ཅད་དང་།",
    "བྱི་དོར་བྱས་ནས་ཀྱང་དམན་ཞིང་དམན་པའི་སེམས་ཀྱིས་སྟན་ལ་འདུག་པར་བྱའོ།",
    "ས་མཚམས་རིགས་པ་མ་ཡིན་པར་ཀུན་ཏུ་གོ་བར་བྱེད་པའི་གནས་མལ་རྣམས་ལ་བརྟགས་ཏེ་འདུག་པར་མི་བྱ་བ་འདི་ཉིད་ནི་རབ་ཏུ་རྟེན་པ་བཞི་པ་ཡིན་ནོ།",
    "ཤིན་ཏུ་སེམས་སྟོབས་ཡང་བར་གྱུར་པ་འདུག་པའི་ས་མི་ཟིན་པས་ཉེ་བར་བཅོམ་པ་རྟག་ཏུ་འཕྲད་པར་བྱེད་པ་རྟག་ཏུ་ཞབས་འབྲིང་བྱེད་པ་ཡིན་ནོ།",
    "དེས་དུ་མ་སྣ་ཚོགས་པར་གྱུར་པའི་ས་གཞི་འདི་མཐོང་ནས་མཆོག་ཏུ་དགའ་ཞིང་རངས་པར་འགྱུར་རོ།",
    "ཙུན་ཙུར་ཀ་ཞེས་བྱ་བའི་ངའི་སྲིན་གྱིས་ཀྱང་རང་བཞིན་དུ་གནས་པའམ་རང་བཞིན་དུ་མི་གནས་པ་ཅི་བྱེད་པ་ཡིན་ན།",
    "དེས་ང་རང་བཞིན་དུ་གནས་པའམ།",
    "གལ་ཏེ་ཡང་རང་ལྟོགས་པར་གྱུར་ན་ནི།",
    "ཡང་གལ་ཏེ་བདག་ཉིད་ལྟོགས་པར་གྱུར་ན་ཡང་རང་བཞིན་དུ་གནས་པའམ།",
    "དེས་བདག་སྤྲོ་བ་མེད་པ་ཉིད་དུ་སྐྱེད་པར་བྱེད་པ་དང་རང་ཡང་རུང་སྟེ།",
    "སྐྱོན་ཡང་དེས་འདུག་པར་བྱེད་དོ།",
    "མྱ་ངན་མེད་དང་རང་བཞིན་གྱིས་དྲི་དང་ཁ་དོག་རྣམས་དགའ་བར་གྱུར་པའོ།",
    "གཡུང་པེ་འདུག་ལི་སྣར་ཅོ་ཞོལ་ཧི།",
