    "བཅོམ་ལྡན་འདས་དེ་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་བསྐོར་བ་བྱས་ནས་མེ་ཏོག་གི་ཕུར་མ་རི་རབ་ཙམ་དེ་དག་གིས་བཅོམ་ལྡན་འདས་དེ་ལ་གཏོར།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་དེ་དག་གིས་རང་རང་གི་གཞལ་མེད་ཁང་དེ་དག་བཅོམ་ལྡན་འདས་དེ་ལ་ཕུལ་ནས།",
    "དེ་སྲིད་ངན་སོང་ས་འདི་རྣམ་པར་འཕེལ།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་དེ་དག་གིས།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་བྱེ་བ་ཁྲགཁྲིག་བརྒྱ་སྟོང་ཕྲག་ལྔ་བཅུ་པོ་དེ་དག་གིས་སྒྲ་སྐད་གཅིག་ཏུ་མཐུན་པར་བརྗོད་དེ།",
    "དག་དེ་ནས་འཇིག་རྟེན་གྱི་ཁམས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་ཕྲག་ལྔ་བཅུ་པོ་དེ་དག་ན་ཚངས་པ་ཆེན་པོ་གང་དག་འཁོད་པ་དེ་དག་ཐམས་ཅད་ལྷན་ཅིག་ཏུ་འདུས་ནས་རང་རང་གི་ཚངས་པའི་གཞལ་མེད་ཁང་དེ་དག་ཏུ་བཞུགས་ཏེ།",
    "ལྷའི་མེ་ཏོག་གི་ཕུར་མ་རི་རབ་ཙམ་དེ་དག་ཐོགས་ནས།",
    "མི་དང་མི་མ་ཡིན་པ་དག་གིས་ནི་ཡོངས་སུ་བསྐོར་ཅིང་མདུན་གྱིས་བལྟས་ཏེ།",
    "མེ་ཏོག་གི་ཕུར་མ་རི་རབ་ཙམ་དེ་དག་གིས་བཅོམ་ལྡན་འདས་དེ་ལ་གཏོར།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་དེ་དག་གིས་ཀྱང་རང་རང་གི་གཞལ་མེད་ཁང་དེ་དག་བཅོམ་ལྡན་འདས་དེ་ལ་ཕུལ་ནས།",
    "ལེགས་གཤེགས་ཁྱོད་ནི་སྲིད་པའི་འདོད་ཆགས་འཇོམས།",
    "འཇིག་རྟེན་གྱི་ནི་རིང་ལོན་ཁྱོད་དེ་མཐོང་།",
    "ཁྱོད་ཀྱི་མཐུས་ནི་དེ་རིང་མཛེས་པར་གྱུར།",
    "དེ་ནས་ཚངས་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་ཕྲག་ལྔ་བཅུ་པོ་དེ་དག་གིས་སྒྲ་སྐད་གཅིག་ཏུ་མཐུན་པར་བརྗོད་དེ།",
    "དེ་བཞིན་དུ་ནུབ་བྱང་གི་ཕྱོགས་དང་།",
    "དེ་བཞིན་དུ་བྱང་གི་ཕྱོགས་དང་།",
    "འོག་གི་ཕྱོགས་ཀྱང་དེ་བཞིན་ནོ།",
    "དེ་ནས་སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་ཕྲག་ལྔ་བཅུ་པོ་དེ་དག་ན་ཚངས་པའི་གཞལ་མེད་ཁང་གང་དང་གང་དག་ཡོད་པ་དེ་དག་ཤིན་ཏུ་མཛེས་ཤིང་ལྷན་ནེ་ལྷང་ངེར་གྱུར་ལ་དཔལ་དང་ལྡན་ཞིང་གཟི་བརྗིད་ཅན་དུ་གྱུར་ཏོ།",
    "གཞལ་མེད་ཁང་རྣམས་གང་གིས་ཡོངས་སུ་ཁྱབ།",
    "རང་རང་གི་ཚངས་པའི་གཞལ་མེད་ཁང་དེ་དག་ཏུ་ཞུགས་ཏེ།",
    "ལྷའི་མེ་ཏོག་གི་ཕུར་མ་རི་རབ་ཙམ་ཐོགས་ནས།",
    "ཕྱོགས་བཞིར་རྒྱུ་ཞིང་འདོང་བ་ལས་འོག་གི་ཕྱོགས་ལོགས་སུ་དོང་བ་དང་།",
    "མི་དང་མི་མ་ཡིན་པ་དག་གིས་ནི་ཡོངས་སུ་བསྐོར་ཅིང་མདུན་གྱིས་བལྟས་ཏེ།",
    "མེ་ཏོག་གི་ཕུར་མ་རི་རབ་ཙམ་དེ་དག་གིས་བཅོམ་ལྡན་འདས་དེ་ལ་གཏོར།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་དེ་དག་རང་རང་གི་གཞལ་མེད་ཁང་དེ་དག་བཅོམ་ལྡན་འདས་དེ་ལ་ཕུལ་ནས།",
    "ཕྱོགས་བཅུར་རྣམ་པར་གཟིགས་མཛད་ཅིང་།",
    "བདག་ཅག་ཁྱོད་ལ་རྗེས་ཡི་རང་།",
    "གཙོ་བོ་ཁྱོད་ཀྱི་མཐུ་ཡིས་ནི་གཞལ་མེད་ཁང་དག་རྣམ་བཀྲ་བ།",
    "དཔའ་བོ་ཆེན་པོ་ཁྱོད་ལ་འབུལ།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་ཕྲག་ལྔ་བཅུ་པོ་དེ་དག་གི་སྒྲ་སྐད་གཅིག་ཏུ་མཐུན་པར་བརྗོད་དེ།",
    "སྲས་རྒྱལ་བུ་གཞོན་ནུ་བཅུ་དྲུག་པོ་དེ་དག་གིས་གསོལ་བ་བཏབ་པ་མཁྱེན་ནས།",
    "འདི་ནི་སྡུགབསྔལ་འགོག་པར་འགྲོ་བའི་ལམ་མོ་ཞེས་བྱ་བ་ལན་གསུམ་དུ་བཟླས་ཏེ་རྣམ་པ་བཅུ་གཉིས་སུ་བསྐོར་རོ།",
    "སྐྱེ་མཆེད་དྲུག་གི་རྐྱེན་གྱིས་རེག་པ།",
    "རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ།",
    "སྐྱེ་མཆེད་དྲུག་འགགས་པས་རེག་པ་འགག།",
    "རེག་པ་འགགས་པས་ཚོར་བ་འགག།",
    "བདག་ཅག་གི་དོན་འདི་ལ་བཅོམ་ལྡན་ལྡན་འདས་ཉིད་མངོན་སུམ་སྟེ།",
    "དགེ་ཚུལ་བཅུ་དྲུག་པོ་དེ་དག་མོས་པར་གྱུར་ཏོ།",
    "བསྐལ་པ་བརྒྱད་ཁྲི་བཞི་སྟོང་གི་བར་དུ་གཙུག་ལག་ཁང་དུ་གནས་ཏེ།",
    "དེ་ནས་དགེ་ཚུལ་བཅུ་དྲུག་པོ་དེ་དག་གིས།",
    "ཁྱེད་མོས་པར་བྱ།",
    "འདི་ལྟར་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་མོས་པར་དཀའ་བའི་ཕྱིར་རོ།",
    "ང་མིང་གཞན་དང་གཞན་དག་གིས་གནས་པ་དེར་དེ་དག་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་འཚོལ་ཞིང་སྐྱེ་བར་འགྱུར་རོ།",
    "བསམ་གཏན་ཆེན་པོ་དང་ལྡན་པའང་གཟིགས་ན།",
    "དེ་དག་གང་ལ་མོས་པ་བཞིན་དུ་དེ་དག་ལ་དེ་བཞིན་གཤེགས་པ་མྱ་ངན་ལས་འདས་པ་དེ་འཆད་དོ།",
    "སྟེང་གི་མཁའ་ལ་དེ་དག་རྔ་བརྡུང་ངོ་རིང་ནས་བླ་ན་མེད་པའི་གནས་རྟོགས་ཕྱིར།",
    "སྲོག་ཆགས་བྱེ་བ་སྟོང་གིས་མདུན་བདར་ཏེ།",
    "སྟེང་གི་ཕྱོགས་དང་ཕྱོགས་མཚམས་དེ་བཞིན་ཏེ།",
    "བསྐལ་པ་བྱེ་བ་མང་ཁྱོད་རྙེད་རབ་དཀའ།",
    "སྐད་ཅིག་གིས་ནི་དེ་ཀུན་ཉན་ཐོས་གྱུར།",
    "རེ་རེ་ལ་ཡང་དེ་དག་མཐར་མི་ཕྱིན།",
    "ཇི་ལྟར་སྐྱེ་དགུ་ཀུན་མཆོག་ཁྱོད་བཞིན་དུ།",
    "དེ་སྲས་གཞོན་ནུར་གྱུར་བ་དེ་དག་གི།",
    "རྒྱུ་ནི་མང་པོ་སྟོང་གིས་ཉེར་བསྟན་ཏེ།",
    "བདེ་གཤེགས་སྲས་པོ་དེ་དག་རེ་རེས་ཀྱང་།",
    "བདག་གིས་རྣམ་པ་ཐ་དད་ཐབས་རྣམས་ཀྱིས།",
    "ཁང་པ་བྱེ་བ་སྟོང་གིས་རབ་བརྒྱན་ཞིང་།",
    "ཀུན་དགའ་དང་ནི་མེ་ཏོག་དག་གིས་བརྒྱན།",
    "སྐྱེས་པ་བུད་མེད་མཚུངས་མེད་རྣམས་ལྡན་པ།",
    "ཤིན་ཏུ་རི་མོ་བྱས་ཏེ་ཡང་སྨྲས་པ།",
