    "ཁྱོད་ལ་ཅི་དང་ཅི་དགོས་པ་ཡང་ན་བུམ་པའི་རིན་ནམ།",
    "ཡང་ན་ཤིང་གི་རིན་ནམ།",
    "དེ་སྟེ་དེའང་ཁྱོད་ལ་དགོས་ནའང་སློངས་ཤིག་དང་།",
    "ཡོ་བྱད་ཀྱི་རྣམ་པ་དེ་ལྟ་བུ་དེ་དག་ཁྱོད་ལ་ཅི་དང་ཅི་དགོས་པ་དེ་དང་དེ་དག་ཐམས་ཅད་ངས་ཁྱོད་ལ་སྦྱིན་གྱི།",
    "མི་ཁྱོད་མྱ་ངན་མེད་པར་བྱོས་ལ།",
    "ཁྱོད་ཀྱི་ཕ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཁྱོད་ཀྱིས་ང་ལ་སོམས་ཤིག།",
    "ཁྱོད་ནི་གཞོན་ཏེ་ཁྱོད་ཀྱིས་ངའི་ཕྱག་དར་གྱི་ཕུང་པོ་འདི་ཕྱགས་ཤིང་ལས་མང་པོ་བྱས་ཏེ།",
    "ཀྱེ་མི་ཁྱོད་ལས་འདི་བྱེད་པའི་ཚེ།",
    "ཁྱོད་ལ་རྣམ་པ་ཐམས་ཅད་དུ་ཉེས་པ་དེ་དག་ལས་གཅིག་ཀྱང་མ་མཐོང་གི།",
    "མི་དབུལ་པོ་དེ་ཁྱིམ་བདག་དེའི་མཆིས་བྲང་གི་སླད་ནང་དུ་མཆི་བ་ལ་འཛེམ་པ་མ་མཆིས་པར་གྱུར་ཏེ།",
    "ཀྱེ་མི་ཁྱོད་ཚུར་ཤོག།",
    "གང་སྦ་བར་བྱ་བ་དེ་དག་ཐམས་ཅད་ཁྱོད་ཀྱིས་ཤེས་པར་འདོད་དོ།",
    "ངའི་འདི་ལས་ཁྱོད་ཀྱིས་ཅུང་ཟད་ཀྱང་ཆུད་མ་གཟན་ཞིག་ཅེས་མཆི་ནས།",
    "བདག་ཉིད་དེ་ལ་རེ་བ་མ་མཆིས་ཤིང་།",
    "ཐ་ན་ཕྱེ་ཕུལ་གང་གི་རིན་ཐང་ཙམ་ཡང་དེ་ལ་ཆུང་ཟད་ཀྱང་སློང་བ་མ་མཆིས་ཏེ།",
    "ཁྱོད་ཉོན་ཅིག།",
    "བདགགི་སྤྱོད་པ་དང་།",
    "ཁོ་བོའི་ནང་གི་ནོར་ཅུང་ཟད་ཅི་ཡོད་པ་དེ་ཀུན་ཀྱང་འདི་ཉིད་ཤེས་སོ་ཞེས་བགྱིས་པ་དང་།",
    "འདི་ལྟར་བདག་གིས་འཕྲལ་ལ་འགྲོན་བུ་དང་།",
    "དེ་བཞིན་གཤེགས་པས་བདག་ཅག་དམན་པ་ལ་མོས་པར་མཁྱེན་ཏོ་དེའི་སླད་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ཅག་ཡལ་བར་བཞག་སྟེ།",
    "བདག་ཅག་དེ་ལ་རེ་བ་མ་མཆིས་ཏེ་འདི་ལྟར་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལས་མྱ་ངན་ལས་འདའ་བ་གདུགས་ཀྱི་གླ་ཐང་བཞིན་དུ་བགྱིས་པ་ནི།",
    "དེ་ཉིད་བདག་ཅག་གིས་མང་དུ་བགྱིས་པར་འཚལ་ཏོ།",
    "བདག་ཅག་དེ་ལ་རེ་བ་མ་མཆིས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐབས་མཁས་པས་བདག་ཅག་གི་མོས་པ་རབ་ཏུ་མཁྱེན་ན་དེ་བདག་ཅག་གིས་ནི་མ་འཚལ།",
    "འདི་ལྟར་བདག་ཅག་དེ་བཞིན་གཤེགས་པའི་སྲས་ཡང་དག་པ་ལགས་མོད་ཀྱི།",
    "བདག་ཅག་དམན་པ་ལ་མོས་པའི་སླད་དུའོ།",
    "གལ་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ཅག་གི་།",
    "མོས་པའི་སྟོབས་གཟིགས་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ཅག་གི་མོས་པའི་སྟོབས་མཁྱེན་ནས།",
    "རྣམ་གྲངས་འདིས་བདག་ཅག་འདི་སྐད་ཅེས་བདག་ཅག་རེ་བ་མ་མཆིས།",
    "དེ་ལྟར་འཕྲལ་ལ་དེ་རིང་བདག་ཅག་གིས།",
    "རིན་ཆེན་ཆེན་པོ་མཆོག་གི་ཕུང་པོ་རྣམས།",
    "བདག་གི་བུ་ནི་འཁྱམས་པར་བཙལ་བས་ན།",
    "སྲོག་ཆགས་བྱེ་བ་སྟོང་གིས་རི་མོ་བགྱིས།",
    "ཉིན་དང་མཚན་མོ་རྟག་ཏུ་བས་པར་གྱུར།",
    "ཅུང་ཟད་ཙམ་ནི་རེས་འགའ་འཚོལ་བ་ན།",
    "ཅུང་ཟད་རྙེད་ཅིང་རེས་འགའ་ཅི་མི་རྙེད།",
    "རང་གི་ཕ་ཡི་ཁྱིམ་དེ་ག་ལ་བར།",
    "དེ་སྟེང་བར་སྣང་ལ་ཡང་བླ་རེ་བྲེས།",
    "ཕྱུག་པོ་དེས་ནི་བདག་གི་བུ་མཐོང་ནས།",
    "དེ་ཡི་མོད་ལ་མི་དེ་བཟུང་བ་དང་།",
    "བྱིས་པ་ལོག་ཡིད་འདི་ནི་དམན་ལ་མོས།",
    "འདི་ནི་བདག་གི་ཕ་ཞེས་ཡིད་མི་ཆེས།",
    "ཁྱོད་ནི་གླ་ཡང་ཉིས་གྱུར་སྦྱིན་པར་བྱ།",
    "དམན་ལ་མོས་པ་བདག་གི་བུ་འདི་ནི།",
    "ཁྱོད་ལས་གླ་ཡང་ཉིས་གྱུར་སྦྱིན་པར་བྱ་དེ་བཞིན་རྐང་པ་བསྐུ་བའང་ཉིས་གྱུར་དུ།",
    "ལན་ཅན་གྱི་ཟས་ནི་ཁྱོད་ལ་སྦྱིན།",
    "རས་དང་ཚོད་མ་དག་ཀྱང་སྦྱིན་པར་བྱ།",
    "ཁྱོད་ཀྱིས་འདིར་ནི་ཤིན་ཏུ་ལས་བྱོས་ཤིག།",
    "དེ་ཡི་མཆིས་བྲང་གི་ནི་སླད་རོལ་ན།",
    "བདག་གི་བུ་འདི་སྟོར་ནས་ཡུན་རིང་སྟེ།",
    "གཞན་ཡང་བདག་གིས་མཐོང་ནས་ཉི་ཤུ་ལགས།",
    "བདག་གི་ནོར་འདི་ཀུན་གྱི་བདག་པོ་སྟེ།",
    "དམན་ལ་མོས་དང་ཕ་ཡི་ཡོན་ཏན་དང་།",
    "དམན་པ་ལ་ནི་མོས་པར་མཁྱེན་པས་ན།",
    "ཁྱོད་ནི་ཉན་ཐོས་ང་ཡི་བུ་ཡིན་ནོ།",
    "རྒྱུ་དང་དཔེ་ཡང་བྱེ་བ་ཁྲག་ཁྲེག་གིས།",
    "དབུལ་པོ་དག་གི་བསམ་པ་རྣམ་པར་སེམས།",
    "བདག་ཅག་ཡུན་རིང་དུས་ནས་མི་རེ་ཞིང་།",
    "བདག་ཅག་གིས་ནི་རྒྱལ་བའི་བསྟན་པ་བགྱིས།",
    "བདག་ཅག་འཇིག་རྟེན་སློབ་དཔོན་རང་བྱུང་གིས།",
    "དམན་ལ་མོས་པའི་སྲས་རྣམས་འདུལ་མཛད་ཅིང་།",
    "ཁྱོད་ལ་ལན་གློན་རྔོ་ཐོགས་ག་ལ་མཆིས།",
    "མགོ་དང་ཕྲག་ལ་གང་གིས་ཁྱེར་བ་དང་།",
    "བྱིས་པ་དག་གི་འདི་འདྲ་ཤིན་ཏུ་བཟོད།",
    "དེ་དག་མོས་པ་སྣ་ཚོགས་མཁྱེན་ནས་སུ།",
    "མོས་པའི་ལེའུ་ཞེས་བྱ་སྟེ་བཞི་པའོ།",
    "དེ་དག་གི་མཐའ་རྟོགས་པར་སླ་བ་མ་ཡིན་ནོ།",
    "ཐམས་ཅད་མཁྱེན་ཅིང་ཐམས་ཅད་གཟིགས་སོ།",
    "བདག་བདག་གི་སོ་སོའི་རིགས་དང་ཚད་དུ་སྐྱེའོ།",
    "འཛུད་པ་དེ་དག་བདག་གིས་བདག་ཤེས་པའམ་རིག་པའམ་རྟོགས་པ་མེད་དོ།",
    "མངོན་སུམ་དུ་གཟིགས།",
    "ཇི་ལྟ་བ་བཞིན་དུ་གཟིགས་པའི་ཕྱིར་རོ།",
    "མོས་པ་རྣམ་པར་མཁྱེན་གྱུར་ནས།",
    "ལག་གིས་སླེབས་པར་འདུག་ནས་སུ།",
    "གང་གིས་ས་བོན་དག་ནི་ཅི་འདྲ་ལས།",
    "ལྷར་བཅས་འཇིག་རྟེན་དག་གིས་མདུན་བདར་ནས།",
    "སྡུག་བསྔལ་དག་གིས་བསྐམས་པ་བདེ་ལ་དགོད།",
    "འཇིམ་པ་ལ་ཐ་དད་པ་མེད་མོད་ཀྱི།",
    "དེའི་ཕྱིར་ཁྱོད་ལ་དཔེ་བསྟན་པར་བྱའོ།",
    "དེ་ནས་མི་གཞན་དགགིས་དམུས་ལོང་དེའི་མདུན་དུ་འདི་སྐད་ཅེས།",
    "འདུས་པ་ལས་གྱུར་པའོ་སྙམ་མོ།",
    "བཞིར་ན་གནས་གང་ན་འདུག་པར་བདེ་བ་སྦྱིན་པ་ཞེས་བྱ་བ་དང་དེ་བཞི་ཡོད་དོ་སྙམ་མོ།",
    "ཐབས་གང་གིས་གངས་ཀྱི་རིའི་རྒྱལ་པོ་ལ་འགྲོ་ནུས་པ་དེ་ལྟ་བུའི་ཐབས་བསམས་ཏེ།",
    "སོང་ནས་ཡར་ཡང་འཇོགས། མར་ཡང་བབས།",
    "དེ་དག་གིས་མི་དེ་ལ་འདི་སྐད་ཅེས་སྨྲས་ཏེ།",
    "མི་ཁྱོད་ནི་མིག་རྙེད་པ་འབའ་ཞིག་ཏུ་ཟད་ཀྱི།",
    "ཁྱོད་གཞན་།",
    "ཅིའང་མི་ཤེས་ན་ཁྱོད་ཀྱི་ང་རྒྱལ་དེ་ཅི་ལས་བྱུང་།",
    "ཁྱོད་ལ་ནི་ཤེས་རབ་ཀྱང་མེད།",
    "དེ་དག་གིས་ཡང་དེ་ལ་འདི་སྐད་ཅེས་སྨྲས་ཏེ།",
    "ཀྱེ་མི་ཁྱོད་གང་གི་ཚེ་ཁྱིམ་གྱི་ནང་ན་འདུག་པ་ན།",
    "རྒྱང་གྲགས་གཅིག་གི་བར་དུ་གོམ་པ་མི་འདོར་བར་འགྲོའང་མི་ནུས།",
    "ཀྱེ་མི་ཁྱོད་ཀྱིས་སྣང་བ་གང་ཡིན་པ་དེ་ནི་མུན་པར་ཤེས་སོ།",
    "ཁྱོད་ཀྱི་བྱ་དགའ་ལ་ཡོན་ཏན་དེ་དག་ཐོབ་པར་གྱིས་ཤིག།",
    "དེ་ནས་དྲང་སྲོང་དེ་དག་གིས་མི་དེ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "སྔོན་བདག་གིས་ལས་གཞན་བྱས་པ་དེས་བདག་གིས་ཡོན་ཏན་གང་ཡང་མ་ཐོབ་བོ།",
    "བདག་གི་ནི་དམུས་ལོང་དུ་གྱུར་པའོ་སྙམ་མོ།",
    "ཇི་ལྟར་དམུས་ལོང་གིས་མིག་མཐོང་བ་དེ་བཞིན་དུ་ཉན་ཐོས་དང་།",
