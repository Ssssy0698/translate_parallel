    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "སྟོབས་རྣམས་སྟོབས་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་འཕགས་པའི་བདེན་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "བསམ་གཏན་རྣམས་བསམ་གཏན་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "སྨོན་པ་མྱེད་པས་སྟོང་པར་བལྟའོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཏིང་ངེ་འཛིན་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "མྱི་འཇིགས་པ་བཞི་མྱི་འཇིགས་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "བྱམས་པ་ཆེན་པོ་བྱམས་པ་ཆེན་པོས་སྟོང་པར་བལྟའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུས་སྟོང་པར་བལྟའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུས་སྟོང་པར་བལྟའོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་ཕྱིར་མྱི་འོང་བའི་འབྲས་བུས་སྟོང་པར་བལྟའོ།",
    "དགྲ་བཅོམ་པ་ཉིད་དགྲ་བཅོམ་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱིས་སྟོང་པར་བལྟའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་རྣ་བའི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་སྣའི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་ལྕེའི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་ལུས་ཀྱི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ནི་རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱིས་སྟོང་།",
    "རྣམ་པར་ཤེས་པ་ནི་རྣམ་པར་ཤེས་པས་སྟོང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ནི་ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱིས་སྟོང་།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ནི་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་སྟོང་།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ནི་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་སྟོང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱིས་སྟོང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྤྱོད་པ་ལགས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྤྱོད་པ་ལགས་ན།",
    "མྱི་དམྱིགས་པའི་ཚུལ་གྱིས་བཟོད་པ་བསྒྲུབ་པར་བྱའོ།",
    "བརྩོན་འགྲུས་བརྩམ་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་པའི་ཚེ།",
    "མྱི་དམྱིགས་པའི་ཚུལ་གྱིས་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་གཞག་པར་བྱའོ།",
    "དམྱིགས་པར་འགྱུར།",
    "ཇི་ཙམ་གྱིས་ན་མྱི་དམྱིགས་པར་འགྱུར།",
    "བཅོམ་ལྡན་འདས་གཉིས་ཤེས་བྱ་བ་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཇི་ཙམ་དུ་རྣམ་པར་ཤེས་པ་དང་།",
    "རྣམ་པར་ཤེས་པར་བྱེད་པ་དང་།",
    "ཇི་ཙམ་དུ་རྣ་བའི་རྣམ་པར་ཤེས་པ་དང་།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཅན་དང་།",
    "ཇི་ཙམ་དུ་སྣའི་རྣམ་པར་ཤེས་པ་དང་།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཅན་དང་།",
    "ཇི་ཙམ་དུ་ལྕེའི་རྣམ་པར་ཤེས་པ་དང་།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཅན་དང་།",
    "ཇི་ཙམ་དུ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཅན་དང་།",
    "ཇི་ཙམ་དུ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཅན་དང་།",
    "སའི་ཁམས་ཡོངས་སུ་ཤེས་པར་བྱེད་པ་དང་།",
    "ཆུའི་ཁམས་ཡོངས་སུ་ཤེས་པར་བྱེད་པ་དང་།",
