    "སྡིག་ལྟུང་ཀུན་བཤགས་དགེ་ལ་རྗེས་ཡི་རང་།",
    "ཚེ་བསོད་རྒྱས་ཞིང་བྱིན་གྱིས་བརླབས་པར་གྱུར།",
    "འབྲལ་མེད་རྗེས་སུ་འཛིན་པར་བྱིན་གྱིས་རློབས།",
    "ཉིན་མཚན་ཀུན་ཏུ་སྤྱོད་པར་བྱིན་གྱིས་རློབས།",
    "སྐྱེས་ནས་བསླབ་གསུམ་ཉམས་ལེན་བྱེད་པར་ཤོག།",
    "ཀླུ་སྒྲུབ་དགོངས་དོན་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "རྣམ་པར་རྩེན་པའི་དགའ་བ་མཉམ་མེད་ཤོག།",
    "བསྐལ་བ་སྙན་པར་བདེ་གཤེགས་ཉི་ཟླའི་འོད།",
    "བསམ་སྦྱོར་དག་པས་ཚུལ་བསྟེན་མཉེས་བྱས་ནས།",
    "འདིས་མཚོན་ལེགས་བྱས་ཇི་སྙེད་སྡོམ་པའི་མཐུས།",
    "རལ་བའི་རྒྱུན་དུ་སྲིད་མཐར་བརྟན་པར་ཤོག།",
    "པའི་གནས་རྣམས་གེགས་མེད་པར།",
    "ཕུལ་བྱུང་བློ་གྲོས་མཁྱེན་པའི་གཏེར་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "སྲས་བཅས་རྒྱལ་བའི་སྤྱན་སྔར་ཞལ་བཞེས་པ།",
    "དུས་ལས་གཡེལ་བ་མེད་པར་བརྩེ་བས་སྐྱོངས།",
    "དད་དམ་ལྷག་བསམ་གཙང་མའི་མཐུ་སྟོབས་ཀྱིས།",
    "ལེགས་པར་བསྟེན་པས་བཞེད་དོན་ལྷུན་གྲུབ་པ།",
    "འཆད་རྩོད་རྩོམ་པའི་འདབ་སྟོང་ལྷུག་པར་གྲོལ།",
    "སྡིག་ལྟུང་ཀུན་བཤགས་དགེ་ལ་རྗེས་ཡི་རང་།",
    "འབྲལ་མེད་སྤྱི་བོའི་རྒྱན་དུ་ལེགས་བཞུགས་ནས།",
    "རྣམ་མཁྱེན་རྒྱལ་བའི་གོ་འཕང་འཐོབ་པར་ཤོག།",
    "གཞུང་ལུགས་གདམས་པར་ཤར་བའི་ཉམས་བཞེས་ཟབ།",
    "ཤེས་བྱའི་གནས་ལ་མཁྱེན་པའི་སྤྱན་དཀྱུས་རིང་།",
    "བཤེས་གཉེན་དཔག་བསམ་ལྗོན་པར།",
    "ཐུབ་བསྟན་ཁུར་དུ་བཞེས་པའི་ལྷག་བསམ་བཅུད།",
    "དེ་ལྟར་འཁྲུངས་རབས་པདྨའི་ཕྲེང་མཛེས་པར།",
    "དོན་བཟང་སྙན་པའི་མདངས་དང་རོ་གཅིག་པར།",
    "འཇམ་དབྱངས་མཁྱེན་པའི་འདབ་སྟོང་ལེགས་གྲོལ་བ།",
    "བློ་གྲོས་མཁྱེན་བཟང་འཇམ་དབྱངས་གཞོན་ནུ་ཡིས།",
    "ཕན་བདེ་དཔལ་དུ་སྲིད་པར་གར་བསྒྱུར་བ།",
    "ཕན་བདེ་གྲུ་ཆར་འདོད་པར་འཇོ་བའི་གཏེར།",
    "བློ་གྲོས་མཁྱེན་བཟང་ལྷ་ལམ་རབ་ཡངས་པོར།",
    "ཐུབ་བསྟན་འཛིན་མའི་རྒྱན་དུ་བཞེས་པར་མཛོད།",
    "སྙིགས་ལྔའི་སྤྲིན་གྱི་སྒྲིབ་གཡོག་བསལ་བྱས་ནས།",
    "བསྐལ་བརྒྱར་གཡོ་བ་མེད་པར་བརྟེན་པར་བཞུགས།",
    "མཛད་འཕྲིན་ཡར་ངོའི་ཟླ་ལྟར་རྒྱས་པར་མཛོད།",
    "འཇམ་དབྱངས་གཞོན་ནུའི་མཁྱེན་པའི་དཔལ་འཛིན་པ།",
    "ཐེག་མཆོག་བཤེས་གཉེན་དམ་པར་གསོལ་བ།",
    "ཐོས་དོན་ཉམས་བཞེས་ལུང་རྟོགས་མཛོད་ཀྱི་བདག།",
    "སྲིད་མཐར་གཡོ་མེད་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "མཁའ་མཉམ་འགྲོ་བའི་དོན་དུ་མངོན་བྱས་ཏེ།",
    "ནམ་ཡང་མི་ནུབ་རིང་དུ་འདེགས་པར་ཤོག།",
    "དགེ་ལེགས་རྒྱ་མཚོས་ས་གསུམ་ཁྱབ་པར་ཤོག།",
    "བསྐྲུན་མཛད་བཤེས་གཉེན་དམ་པར་གསོལ་བ་འདེབས།",
    "ཐོས་དོན་གདམས་པར་འཁྱེར་བའི་ཚུལ་ལ་མཁས།",
    "དུས་མཐར་བསྒྲེངས་པའི་ལེགས་བྱས་ཁུར་འཛིན་པ།",
    "རྣམ་ཀུན་མཁྱེན་པའི་ལམ་གྱི་ས་མཁན་མཛོད།",
    "བསྐལ་པར་མི་ཉམས་རྡོ་རྗེའི་སྲོག་བཟུང་བས།",
    "མྱུར་དུ་སྐུ་བཞིའི་གོ་འཕང་ཐོབ་པར་ཤོག།",
    "བློ་གྲོས་མཁྱེན་རབ་བཟང་བོའི་དཀྱིལ་འཁོར་རྒྱས།",
    "ཞབས་པད་གཡོ་མེད་བསྐལ་བརྒྱར་བཞུགས་སུ་གསོལ།",
    "བཞུགས་པའི་གནས་གསུམ་ཡི་གེ་གསུམ་འོད་ཀྱིས།",
    "སྡིག་ལྟུང་ཀུན་བཤགས་དགེ་ལ་རྗེས་ཡི་རངས།",
    "སྲོག་ལས་གཅེས་པར་འཛིན་པར་བྱིན་གྱིས་རློབས།",
    "སྐྱེ་བ་འདི་རུ་ལམ་སྣ་མ་ཟིན་པར།",
    "དོན་གཉིས་རྩ་བ་ཚུགས་པར་བྱིན་གྱིས་རློབས།",
    "བློ་གྲོས་མཁྱེན་བཟང་ལྷ་ལམ་ཡངས་པའི་ངོས།",
    "སྤྲོ་མཛད་མཆོག་སྤྲུལ་དམ་པར་གསོལ་བ་འདེབས།",
    "རྣམ་པར་རྒྱལ་མ་ལ་སོགས་ལྷག་པའི་ལྷས།",
    "དུས་མཐའི་བསྟན་འགྲོའི་དཔལ་དུ་ལྷུར་བཞེས་མཛོད།",
    "ཇི་ལྟར་སྨོན་དོན་བདེ་བླག་འགྲུབ་པར་ཤོག།",
    "མཁྱེན་རབ་འོད་སྟོང་འགྱེད་པའི་འཕྲིན་ལས་ཀྱིས།",
    "གྲོལ་མཛད་བཤེས་གཉེན་དམ་པར་གསོལ་བ་འདེབས།",
    "ཕུལ་བྱུང་མཁྱེན་རབ་ལུས་ཀྱི་སྟོབས་རྩལ་རྫོགས།",
    "མང་ཐོས་རལ་བའི་ཁུར་གྱིས་ལེགས་པར་བརྗིད།",
    "རོལ་བའི་སྐལ་བཟང་མངོན་དུ་གྱུར་པར་མཛོད།",
    "མཁྱེན་པའི་དཔལ་གྱུར་སྐལ་ལྡན་འགྲོ་བའི་མགོན།",
    "བློ་གྲོས་མཁྱེན་བཟང་འཇམ་མགོན་གཞོན་ནུའི་ཟླ།",
    "འཕྲིན་ལས་ས་གསུམ་རྣམ་པར་རྒྱལ་བའི་མགོན།",
    "དུས་མཐར་འདོད་པར་འཇོ་བའི་འཕྲིན་ལས་ཀྱི།",
    "ཐེག་མཆོག་བཤེས་གཉེན་དམ་པར་གསོལ་བ་འདེབས།",
    "བློ་གཏེར་མཁྱེན་བཟང་འཇམ་དབྱངས་གཞོན་ནུ་ཡི།",
    "མཁྱེན་རབ་ཉི་མའི་རླབས་ཀྱིས་ལེགས་ཕྱེས་ཏེ།",
    "བསླབ་གསུམ་ཉམས་ལེན་གཙང་མའི་བདུད་རྩིའི་གཏེར།",
    "ཐོས་བསམ་པརྨོ་བྱེ་བའི་འཛུམ་གྲོལ་བས།",
    "རྣམ་དཀར་འཕྲིན་ལས་ས་སྟེང་ཁྱབ་པར་ཤོག།",
    "བཞེད་དོན་གེགས་མེད་ལྷུན་གྱིས་འགྲུབ་པར་ཤོག།",
    "མཚུངས་མེད་བཤེས་གཉེན་དམ་པར་གསོལ་བ་འདེབས།",
    "མང་ཐོས་རལ་བའི་ཁུར་གྱིས་ལེགས་པར་བརྗིད།",
    "ཞབས་པད་སྲིད་མཐའི་བར་དུ་རྟག་བཞུགས་གསོལ།",
    "ལེགས་མཛད་དུས་མཐར་ལེགས་པར་བསྒྱུར་བའི་ཚེ།",
    "བཤེས་གཉེན་དམ་པར་བསྟེན་ནས་ཐུབ་པའི་བསྟན།",
    "བློ་གྲོས་མཁྱེན་བཟང་འཇམ་དབྱངས་གཞོན་ནུ་ཡིས།",
    "རྣམ་མཁྱེན་རྒྱལ་བའི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "མཁྱེན་རབ་འོ་མའི་རྒྱ་མཚོ་གཡས་འཁྱིལ་བ།",
    "མཁྱེན་རབ་རྒྱ་མཚོའི་གཏེར་དུ་ལྷུན་གྲུབ་པ།",
    "བློ་གྲོས་མཁྱེན་གསལ་བཟང་པོའི་དཀྱིལ་འཁོར་ལས།",
    "ཇི་སྲིད་ནམ་མཁའི་མཐའ་ཀུན་མ་འཛད་པར།",
    "བསྟན་པའི་བྱ་བ་འབའ་ཞིག་སྤྱོད་པར་ཤོག།",
    "ཇི་སྲིད་བསྐལ་བའི་མཐར་ཡང་མི་ཉམས་པར།",
    "ཚེ་མཐའ་ཡས་པའི་ངོ་བོར་རྟག་བཞུགས་ནས།",
    "ལས་ཉོན་སྲིད་པའི་རྩ་བ་གཅོད་པར་ཤོག།",
    "སྐྱབས་གསུམ་རིན་ཆེན་ཅོད་པན་གཙུག་ཏུ་བཞེས།",
    "བསླབ་གསུམ་རིན་ཆེན་ཉམས་ལེན་མཐིལ་དུ་བཞེས།",
    "བསྟན་པའི་བྱ་བ་རྒྱ་ཆེར་འགྲུབ་པར་ཤོག།",
    "གཡེལ་བ་མེད་པར་རྟག་ཏུ་གྲོགས་མཛོད་ཅིག།",
    "ཅེས་ཏཱ་དབོན་པ་བློ་བཟང་འཕྲིན་ལས་ཀུན་དགའ་སེངྒེ་གཞན་དོན་དུ་དགོངས་པ་གཏད་པར།",
    "ཐ་མལ་ཚུལ་གྱིས་ཞི་བའི་དབྱིངས་གཤེགས་པར།",
    "མ་བཟོད་བློ་ཡིས་གདུང་འབོད་དགོངས་པར་མཛོད།",
    "བློ་ཆེན་འཇམ་དབྱངས་གཞོན་ནུའི་མཁྱེན་རྩལ་ཅན།",
    "ཟུང་འཇུག་ནོར་བུའི་གཙུག་ཕུད་བཞེས་གྱུར་ཀྱང་།",
    "ཇི་ལྟར་སྨོན་པའི་དོན་ཀུན་བདེ་བླག་ཏུ་འགྲུབ་པར་གྱུར་ཅིག།",
    "སྐལ་དམན་གདུལ་བྱའི་སྣང་ངོར་མངོན་བཞེས་པར།",
    "དད་དམ་གཙང་མའི་རྒྱུན་དུ་ཉེར་བཟུང་ནས།",
    "ལུང་རྟོགས་བསྟན་པའི་རྒྱལ་མཚན་ཕྱག་བཞེས་པའི།",
    "པར་སྤེལ་བའི་བྱེད་པོ་ཉིད་གྱུར་ཅིག།",
    "ངེས་ལེགས་ཐར་བའི་མྱུ་གུ་སྨིན་པར་ཤོག།",
    "ལེགས་ལམ་གསལ་ཕྱིར་སྲིད་པར་གར་དུ་བཟློས།",
    "རིགས་རུས་རབ་གཙང་གོ་ལའི་གྲྭ་གཅིག་ཏུ།",
    "མཐའ་དག་མཁྱེན་པའི་དཀྱིལ་འཁོར་ཆ་ཀུན་རྫོགས།",
    "རང་སྲས་འཕགས་བཞིས་ས་འཛིན་དོག་པོར་བྱས།",
    "ལེགས་པར་ཕྱེ་བའི་རྣམ་རིག་གཙོར་འཛིན་པའི།",
    "བྱིན་གྱིས་བརླབས་དང་རྗེས་སུ་གནང་བ་སོགས།",
    "རྨད་བྱུང་ངོ་མཚར་འཕྲུལ་གྱི་པར་འདི་བསྐྲུན།",
    "ཐ་མར་ལེགས་བྱས་ཕ་རོལ་ཕྱིན་པའི་ལས།",
    "ལེགས་བྱས་སྤྲིན་ཀྱི་པདྨོ་འདུ་འགོད་པས།",
    "རྣམ་གསུམ་ལམ་གྱི་གཙོ་བོ་ལ་པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "འདོད་པར་འཇོ་བས་ཐུབ་བསྟན་ཀུ་མུད་ཚལ།",
    "རྙེད་དཀའི་གཙུག་པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "ལེགས་བྱས་རིགས་པའི་འཕྲུལ་གྱི་འདུ་འགོད་ལས།",
    "ཁྱད་པར་བདེ་ལྡན་ཞིང་མགོན་རྣམ་འདྲེན་རྗེ།",
    "དུས་མཐའི་འགྲོ་བའི་ཉེར་འཚོར་མངོན་བཞེས་པས།",
    "བློ་ཆེན་མཁྱེན་བཟང་ཡངས་པའི་ལྷ་ལམ་ནས།",
    "ཐུབ་པའི་བསྟན་པ་སྲུང་བར་ཞལ་བཞེས་ཤིང་།",
    "རྣམ་བཞིའི་འཕྲིན་ལས་གཡེལ་བ་མེད་པར་མཛོད།",
    "བློས་བསླངས་པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "དཀྱིལ་འཁོར་རྟེན་དང་བརྟེན་པར་བཅས།",
    "ངོ་མཚར་ཁང་བཟང་མཛེས་པར་ལེགས་བསྐྲུན་པའི།",
    "འཁོར་གསུམ་རྣམ་པར་དག་པའི་རྒྱས་བཏབ་སྟེ།",
    "ལེགས་པར་བསྐྲུན་པའི་དགེ་ཚོགས་རྒྱ་མཚོའི་མཐུས།",
    "པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "ཇི་ལྟ་ཇི་སྙེད་མཁྱེན་པའི་ཐུགས་མངའ་བ།",
    "བློ་ཆེན་མཁྱེན་བཟང་ཟུར་ཕུད་ལྔ་བའི་མཆེད།",
    "རྣམ་མཁྱེན་ཡེ་ཤེས་ཐོབ་པའི་རྒྱུ་རུ་བསྔོ།",
    "སྙིགས་ལྔའི་སྤྲིན་གྱིས་ནམ་ཡང་མི་སྒྲིབ་པར།",
    "འཇིག་རྟེན་བདེ་སྐྱིད་ཉམས་པ་མེད་པར་ཤོག།",
    "བློ་ཆུང་བྱིས་པའི་རྩེད་འཇོར་མ་ལགས་ཀྱང་།",
    "ལེགས་པའི་དགེ་ཚོགས་མཁའ་ལྡིང་རབ་ཡངས་པར།",
    "མཁྱེན་རྩལ་འཇིགས་མེད་དཔའ་བོའི་ལུས་སྟོབས་རྫོགས།",
    "ཞེས་ཆེད་དུ་བརྗོད་པའི་བསྔགས་ཚིག་པདྨ་དཀར་བོའི་ཆུན་པོ་སྔོན་དུ་འཐོར་ཏེ་བརྗོད་པར་བྱ་བ་ནི།",
    "བཅུ་ཕྲག་རིག་པའི་གནས་ཀྱི་གཞུང་རྒྱ་མཚོ་ལྟ་བུའི་དགོངས་པ་གདུལ་བྱའི་བློ་དང་འཚམ་པར་གསལ་བར་བཀྲལ་པའི་བསྟན་བཅོས་འཛམ་གླིང་རིག་པའི་རྒྱུན་དུ་བརྗིད་པ་བགྲང་ལས་འདས་པ་བཞུགས་པར།",
    "བརྟག་ཞིབ་པ་མཁྱེན་ལྡན་རྣམས་ཀྱི་ཞབས་ཁབ་གསུང་རྩོམ་ཐོར་བུའི་སྐོར།",
    "ངེས་ལེགས་ཐར་བའི་མྱུ་གུ་སྨིན་པར་ཤོག།",
    "པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "དོན་ལྡན་ལེགས་བྱས་གཏམ་གྱི་གཏེར་དུ་གྲུབ།",
    "ངོ་མཚར་པར་གྱི་འཕྲུལ་འདེགས་འདི་སྤེལ་ལོ།",
    "ཕན་བདེ་དགེ་ལེགས་འདོད་པར་འཇོ་བའི་གཏེར།",
    "ལེགས་བྱས་ཟླ་བ་གཞོན་ནུའི་དཀྱིལ་འཁོར་མཆོག།",
    "ཕྱོགས་ཀུན་བདེ་ལེགས་ཆེན་པོས་ཁྱབ་པར་ཤོག།",
    "གཏན་བདེ་གོ་འཕང་མྱུར་དུ་ཐོབ་པར་ཤོག།",
    "ས་ཡ་པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར། ། སྨོན་བྱང་།",
    "དོན་གཉིས་འབྲས་བུ་བདེ་བླག་ཐོབ་པར་ཤོག།",
    "ཕན་བདེ་འདོད་པར་འཇོ་བའི་དགའ་འབུམ།",
    "འདི་བྱས་སྦྱིན་བདག་གཙོ་བྱས་འབྲེལ་ཐོགས་ཀུན།",
    "ཚེས་༣ སྟེ་བོད་ཟླ་༩ པའི་ཚེས་༥ལ་རོང་བོའི་དགོན་ཆེན་ཤར་བླ་བྲང་ནས་འཕྲལ་དུ་བྲིས། ། ཧོར་གཙང་ཡི་གེ་ཐང་དགོན་དུ་དུས་འཁོར་སྣང་བརྙན་དཔར་བསྐྲུན་པའི་སྨོན་ཚིགརྡུལ་བྲལ་སྟོང་གཟུགས་ཕྱག་རྒྱུར་རོལ་བ་ལས།",
    "འཇིག་རྟེན་དགེ་མཚན་ཕུན་སུམ་ཚོགས་པར་ཤོག།",
    "ཁྱད་པར་འདི་བསྐྲུན་འབྲེལ་ཐོགས་སྐྱེ་བོ་ཀུན།",
    "རྣམ་ཀུན་མཁྱེན་པའི་ཡེ་ཤེས་ནོར་བུའི་མཛོད།",
    "རྣམ་མཁྱེན་རྒྱལ་བའི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "ཁྱད་པར་སྦྱིན་པའི་བདག་པོ་གཙོ་བྱས་པའི།",
    "ངོ་མཚར་པར་གྱི་བཀོད་པ་འདི་བསྐྲུན་པའི།",
    "དཔེ་མང་འཚོལ་བའི་ངལ་བ་སྤོང་ཕྱིར་ཕྱོགས་བསྒྲིགས་མཛད་དེ་ལྷན་དུ་དཔར་བསྐྲུན་གྱི་བཀའ་དྲིན་བསྐྱངས་སྐབས་དགེ་ཚོགས་རྫོགས་བྱང་དུ་བསྔོ་བའི་སྨོན་ཚིག་འདི་འདྲ་ཞིག་དགོས་ཞེས་བཀྲ་ཤིས་པའི་ལྷ་རྫས་དང་བཅས་ཉེ་བར་བསྐུལ་བ་ལ་བརྟེན་ནས།",
    "ཁྱད་པར་མ་རྒན་དཀར་འཚོ་གཙོ་བྱས་པའི།",
    "བསྒྱུར་མཛད་མར་མི་ཡབ་སྲས་བརྒྱུད་པར་འདུད།",
    "འཇམ་དབྱངས་ས་པཎ་བརྒྱུད་པར་བཅས་ལ་འདུད།",
    "གངས་དཀར་མེ་ཏོག་ཡབ་པར་བྱང་སོགས་ཀྱི་སྨོན་ཚིག་སྐོར།",
    "ཞགས་པ་མེད་པར་གླིང་ལྔའི་མཐའ་ཡ་བཅིངས།",
    "ལེགས་བྱས་གངྒཱའི་རྒྱུན་དང་སྡོམ་པའི་མཐུས།",
    "ལེགས་བྱས་ཟླ་བ་གཞོན་ནུའི་དཀྱིལ་འཁོར་མཆོག།",
    "ཡུལ་ཀུན་བདེ་ལེགས་ཆེན་པོས་ཁྱབ་པར་ཤོག།",
    "གཏན་བདེ་གོ་འཕང་བདེ་ལེགས་འཐོབ་པར་ཤོག།",
    "འཛད་མེད་པར་གྱི་འཕྲུལ་འདི་སྤེལ།",
    "ཅེས་པ་འདི་ནི་༧བསེ་མིང་བས་སྤེལ་བ་དགེ། ། དབུས་དགའ་ལྡན་དགོན་གྱི་ལམ་རིམ་བསྡུས་དོན་གྱི་དཔར་བསྐྲུན་པའི་སྨོན་ཚིགསྨྲས་པ།"
  ]
}