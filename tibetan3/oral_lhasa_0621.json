    "ཉི་མ་དང་ཚེས་གྲངས་ཀུན་ཤིས་པར་ཞེས་པར་སོ་སོར་སྦྱར་རོ།",
    "དེ་ལྟར་ཐོག་མར་རྩོམ་པ་ལ་སྔ་དྲོའི་དུས་ན་ལྟས་དེ་རྣམས་ལས་གང་ཡང་རུང་བ་ཅིག་བྱུང་ན་བཟང་སྟེ་ས་ཡོངས་སུ་གཟུང་བ་ལ་སོགས་པའི་ལས་རྣམས་བརྩམ་པར་བྱའོ།",
    "དེ་བས་ན་གསུངས་པ།",
    "སྤྱད་པའི་ཚུལ་གྱིས་སྤྱད་པར་ནི།",
    "དེ་ལྟར་གནོད་པར་གྱུར་ན།",
    "ལྷ་ལ་སོགས་པ་དེ་རྣམས་ཀྱང་བག་བྱེད་ཅིང་དེ་ནས་གཞན་དུ་འདོང་སྟེ་ཉེས་པ་མེད་པར་འགྱུར་རོ།",
    "ས་སླར་བསླང་བ་ནི་ཕྱིས་བརྩད་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་རིགས་པར་བརྟགས་ནས་ཡོངས་སུ་གཟུང་བའི་རིམ་པ་འདི་ལྟར་བྱའོ།",
    "དེའི་འོག་ཏུ་དྲིའི་དཀྱིལ་འཁོར་རྣམས་གྲུ་བཞི་ལ་སོར་བཅུ་གཉིས་པར་བྱེད་དེ།",
    "དེ་ནས་རང་བཞིན་གྱི་དཀྱིལ་འཁོར་རྣམས་སྡུད་པར་འགྱུར་པ་སྟེ།",
    "སྔགས་པ་འགྲེངས་ཏེ་བསམ་པ་ནི་མི་གནས་པར་སྟོན་པ་སྟེ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའམ་གང་ཡང་རུང་བའི་སྔགས་ཀྱིས་ས་དེ་ཡོངས་སུ་གཟུང་བར་བྱའོ།",
    "དེ་ཡང་རབ་འབྲིང་གསུམ་དུ་ཤེས་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་མྱུར་དུ་བྲིས་ཤིག་ཅེས་བསྐུལ་མ་འདེབས་པར་མཐོང་ན་རྨི་ལམ་རབ་ཏུ་ཤེས་པར་བྱའོ།",
    "དམིགས་པ་བརྟན་པར་བྱ་བ་དང་།",
    "དེ་ལ་དཀྱིལ་འཁོར་འདིའི་མིང་ཅི་ཞེས་པ་དཀྱིལ་འཁོར་གྱི་དམིགས་བསྟན་པར་བྱ་བ་དྲིས་པའོ།",
    "དེ་ལས་ཀྱང་ཁྱད་པར་དུ་གསུངས་པ་ཁྱབ་པ་ཞེས་པ་སྟེ།",
    "མཆོག་དེ་ལས་གཞན་པ་བཙལ་མི་དགོས་པར་དེས་ཆོག་སྟེ་མི་འགྱུར་བ་ཡོངས་སུ་རྫོགས་པའོ།",
    "གསང་བའི་བདག་པོ་གང་དུ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གྲངས་མེད་པའི་བསྐལ་པར་བསྐྱེད་པ།",
    "དེས་ན་གསང་བའི་བདག་པོ་གཞུང་འདི་ལྟར་རིག་པར་བྱ་སྟེ་ཞེས་པ་ནི།",
    "སྔགས་ཀྱི་སྤྱོད་པ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྤྱོད་པ་དག་སྔོན་གོམས་པར་བྱས་པ་ནི་གཉིས་ཀ་ལ་ཡང་དད་པ་སྐྱེས་ཏེ།",
    "སྔགས་སྤྱོད་ལ་གོམས་པར་བྱས་པས་ཀྱང་།",
    "དེ་ལ་ད་ལར་དང་ཕྱིས་བྱེད་པར་འགྱུར་བ་མི་བྱ་བའི་ཡི་དམ་བཅའ་བའི་རིགས་ན།",
    "སྔོན་བྱས་ཟིན་པ་སླར་བཤགས་པ་ཅི་ཕན་ཞེ་ན།",
    "དུས་གསུམ་དུ་མ་བསྒྲིབས་པའི་ཡེ་ཤེས་ཀྱི་སྡོམ་པ་། འཛིན་དུ་ཆུག་ཅིག་ཅེས་པ་དུས་གསུམ་དུ་སྒྲིབ་པ་མེད་པའི་ཡེ་ཤེས་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཏེ།",
    "དེ་དག་དང་མཐུན་པར་བྱ་ཞིང་གཟུང་བའི་ཕྱིར་དང་།",
    "ཤིན་ཏུ་སེམས་ཐུབ་པར་གྱིས་ལ་འཆར་ཆུག་ཅིག།",
    "བྱང་དང་ཤར་གྱི་མཚམས་སུ་བལྟས་ན་ཞི་བ་དང་རྒྱས་པ་གཉི་ག་འགྲུབ་པར་འགྱུར།",
    "སོ་ཤིང་གཞི་བོར་ཟུགས་ཏེ་རྩེ་པར་སྣང་ལ་བལྟས་ན་བར་སྣང་ལ་འགྲོ་བ་འགྲུབ་པར་འགྱུར།",
    "ཞིབ་ཏུ་ནི་གསང་བའི་རྒྱུད་ལ་སོགས་པར་བལྟའོ།",
    "འདི་སྔགས་ཀྱི་བཟླས་པ་ལ་སོགས་པ་ཁྱད་དུ་ལྷག་པར་སྤྱོད་པ་ལ་མི་མཉམ་པ་སྟེ།",
    "ཞེས་པར་འབྲེལ་ཏེ།",
    "ཁྱེད་རྣམས་ཀྱིས་མཉམ་པ་མེད་པའི་རྙེད་པ་ཐོབ་བོ་ཞེས་པར་འབྲེལ་ཏོ།",
    "འདི་རྣམས་ལས་གང་མཐོང་བ་སང་ནང་པར་སློབ་དཔོན་ལ་ཟློས་སུ་གཞག་པ་སྟེ།",
    "འབྲས་བུ་ཐོབ་པའི་འམ་ཞེས་པ་ནས་བཀྲ་ཤིས་པའི་སྒྲ་འབྲས་བུ་ཐོབ་པར་འགྱུར་བ་ཐོས་ན་ཞེས་པའི་བར་དུ་བར་སྣང་ལས་བྱུང་བའི་ལྟས་སོ།",
    "མ་ལུས་པའི་བདེ་བའི་མཚན་ཉིད་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་རིམ་གྱིས་ཐོབ་པར་འགྱུར་བས་ན་དཔལ་དང་ལྡན་པའོ།",
    "དེ་ལྟར་ལུས་དང་ངག་ཡིད་གསུམ་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་དུ་འགྱུར་ཏེ་དམིགས་སུ་མེད་པས་ཆགས་པར་བྱ་བ་དང་།",
    "ཆགས་པར་བྱེད་པ་ལ་སོགས་པ་ཡང་དམིགས་སུ་མེད་དེ།",
    "དེ་བས་ན་གསུངས་པ་དེ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེ་དག་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྒྲིབ་པ་མེད་པ་ཐོབ་པར་བྱེད་པའི་རྒྱུར་འགྱུར་བ་བསྟན་པའོ།",
    "དེ་ནི་རྡོ་རྗེ་སེམས་དཔར་བྱིན་གྱིས་བརླབས་ཏེ།",
    "དེ་ལྟར་སློབ་དཔོན་དེ་རྡོ་རྫེ་སེམས་དཔའི་སྐུར་བྱིན་གྱིས་བརླབས་པ་ལ་དཀྱིལ་འཁོར་གྱིས་ལྷོ་བྱང་ཤར་ནུབ་ལ་སོགས་པ་བརྟགས་ཏེ་གཏན་ལ་དབབ་པ་དང་ལྷ་རྣམས་གར་དགོད་པའི་གནས་རྣམས་ཀྱང་ཡིད་ཀྱིས་གཏན་ལ་དབབ་པར་བྱའོ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་སྔགས་ཀྱིས་བཏབ་ལ་ཐོག་མར་སྒོར་བཞག་སྟེ།",
    "མི་གཙང་བ་ལ་སོགས་པའི་དོགས་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་སྤོས་ཆུ་བླུད་དོ།",
    "ཀུན་མཁྱེན་ཞེས་པ་ནི་བཅོམ་ལྡན་འདས་ཐམས་ཅད་མཁྱེན་པའོ།",
    "སེམས་དཔའ་ཆེན་པོ་གང་དུས་སུ་བྱིན་གྱིས་བརླབ་པར་འགྱུར་བ་ནི་དཀྱིལ་འཁོར་མཁན།",
    "དེ་བས་ན་བསྒྲུབ་པའི་དཀྱིལ་འཁོར་ཉིན་པར་བྲི་བར་གསུངས་སོ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་བསྒྲུབ་པ་ནི་ནམ་སྲོས་ནས་ནམ་ལངས་ཀྱི་བར་མཚན་རངས་པར་བསྒྲུབ་དགོས་ཏེ།",
    "སྣམ་བུའི་རིམ་པར་དབྱེ་བ་དང་།",
    "ཡེ་ཤེས་ལྔ་པོ་དེ་དག་དང་ལྡན་པར་བདག་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུར་བྱིན་གྱིས་བརླབ་བོ་། བདག་ཉིད་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུར་བྱིན་གྱིས་བརླབས་ལ་ཞེས་པ་ནི་དཀྱིལ་འཁོར་རྣམ་པ་གསུམ་ལ་ཏིང་ངེ་འཛིན་དུ་གནས་པ་ཡང་བྱེ་བྲག་རྣམ་པ་གསུམ་སྟེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་ལ་སོགས་པ་མི་ཟད་པའི་རྒྱན་གྱི་འཁོར་ལོ་དང་བཅས་པ་མངོན་དུ་བསམས་ཏེ།",
    "ཞེས་པ་ནི་དཀྱིལ་འཁོར་མི་འཁྲུལ་པར་གཏན་ལ་དབབ་པའི་ཕྱིར་སྲད་བུ་དབུས་ནས་རྒྱ་གྲམ་དུ་བྲེས་ནས་ཏེ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་བབ་པར་ཕུར་བུ་བཙུགས་ལ་དེ་ནས་སྲད་བུ་དེ་བལྟས་ཏེ།",
    "དབུས་ཀྱི་ཕུར་བུ་བཟུང་ལ་གྲྭ་བཞི་གཏན་ལ་དབབ་པར་བྱའོ།",
    "སྲད་བུ་ཡང་མདུད་པ་མི་བོར་བར་སྐུད་པ་ལ་སོགས་པའི་མཚན་མ་གདག་པར་བྱའོ།",
    "ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཡིད་ལ་བྱས་ནས་ཞེས་པའོ།",
    "ཞེས་པ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་ཏིང་ངེ་འཛིན་ལ་གནས་ཞེས་པའི་དོན་ཏོ།",
    "ཀུན་ཀྱང་གྲུ་བཞི་ལྷམ་པར་ཏེ།",
    "དེ་རྫོགས་པ་ལས་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་རྫོགས་པར་འགྱུར།",
    "གོས་ཀྱི་རིམ་གྲོ་མི་བྱེད་པར་སྣང་བར་བྱ་བའི་ཕྱིར་གདབ་བོ།",
    "དེ་བཞིན་དུ་སྣམ་བུ་། གཉིས་ལ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "དུམ་བུ་གསུམ་དུ་གཅད་པར་བྱ།",
    "དེ་བས་ན་གསུངས་པ།",
    "ངེས་པར་ལྷ་རྣམས་གནས་པར་རོ།",
    "ཞེས་པ་ནི་སྒོ་ཁྱུད་རྣམས་རྣམ་པར་དབྱེ་བ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྲུལ་པའི་སྐུ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པ་ཡང་མི་རྣམས་ཀྱི་གཙོ་བོར་གྱུར་ཅིང་སྒོ་ཁྱུད་ན་བཞུགས་སོ།",
    "ཕྱག་ན་རྡོ་རྗེ་ལྷོ་ཕྱོགས་ན་གནས་པ་ནི་བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་སྣམ་བུ་གསུམ་པ་ལ་ཤར་ཕྱོགས་ཀྱི་སྒོ་ཁྱུད་ཀྱི་ནང་ན་འཕགས་པ་འཇམ་དབྱངས་གཙོ་བོའི་གཟུགས་སུ་བཞུགས།",
    "རིམ་པར་ཕྱེ་སྟེ་ཤིན་ཏུ་བརྟག།",
    "ཅེས་པ་ནི་གོང་དུ་སྨོས་པ་ལྟར་དཀྱིལ་འཁོར་གྱི་སྣམ་བུ་བགོ་བ་དང་སྒོ་ཁྱུད་རྣམས་རྣམ་པར་དབྱེ་བ་དང་།",
    "དཀར་བ་ནི་ཚོགས་དེ་ཉིད་རྣམ་པར་དག་པའོ།",
    "ཆེན་པོར་ཡང་ནི་ཞེས་པ་ནི་དེ་ལས་ལྷག་པར་ཀྱང་རུང་ཞེས་པའོ།",
    "ཡེ་ཤེས་བརྒྱད་དང་ལྡན་པས་འདབ་མ་བརྒྱད་དུ་གསུངས་སོ།",
    "བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་དེ་ཉིད་སྒོ་ལྔའི་རྣམ་པར་ཤེས་པ་ལྔ་ལས་གྱུར་པས་རྣམས་པ་ལྔར་ཕྱེ་སྟེ།",
    "དེ་ལྟར་ཐམས་ཅད་དམིགས་སུ་མེད་པར་ཆུད་པས་སྦྱིན་པར་བྱ་བ་དང་།",
    "སྦྱིན་པར་བྱེད་པ་གསུམ་ཆར་ཡང་དམིགས་སུ་མེད་པར་ཆུད་དེ།",
    "ཆུབ་པར་རྡོ་རྗེ་བྲི་བར་བྱ།",
    "མགོན་པོའི་འོད་ཀྱིས་རིམ་པར་བསྐོར།",
    "ཐོར་ཚུགས་འཆང་བ་ནི་འོག་མིན་གྱི་གནས་ན་བཞུགས་ན་འོག་མིན་གྱི་གནས་ཀྱི་ལྷ་རྣམས་ཐོར་ཚུགས་དང་བཅས་པ་སྟེ།",
    "དེ་དག་དང་མཐུན་པར་བྱ་བའི་ཕྱིར་ཐོར་ཚུགས་དང་ལྡན་པའོ།",
    "མགོན་པོའི་འོད་ཀྱིས་རིམ་པར་བསྐོར།",
    "ན་བཟའ་དཀར་པོ་མནབས་པ་ནི་ན་བཟའ་ནི་གཡོགས་པར་བྱེད་པ་སྟེ།",
    "པདྨོ་དཀར་པོ་ལ་བཞུགས་པ་ནི།",
    "སྦྱོར་བའི་ལས་པདྨོ་དང་དམར་པོར་གསུངས་ལ་འདིར་དཀར་པོར་གསུངས་པ་དེ་ཡང་སྦྱོར་བའི་རྒྱུད་ནི་ཐབས་གཙོ་བོར་གྱུར་པ་སྟེ།",
    "གཞན་ཡང་རྣམ་པ་དུ་མ་རྒྱུད་གཞན་ལས་ཤེས་པར་བྱའོ།",
    "ཞེས་པ་ནི་རྣམ་པར་གྲོལ་བའི་སྒོ་སྣ་ཚོགས་འཛིན་པ་སྟེ།",
    "དེ་བས་ན་ཨུཏྤལའི་འདབ་མ་རལ་གྲི་ལྟ་བུ་ནི་ཤེས་རབ་རྣམ་པར་གྲོལ་བའི་སྒོ་ལྟ་བུར་ཤེས་པར་བྱའོ།",
    "དཀར་བ་ནི་ངོ་ཚ་ཉིད་རྣམ་པར་དག་པའི་མཚན་མའོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པ་ལྡན་པར་བསྟན་པ་སྟེ།",
    "པྲི་ཡང་ཀུ་སྟེ་ཕྱག་གཡོན་པར།",
    "པྲི་ཡང་ཀུ་སྟེ་ཕྱག་གཡོན་པར།",
    "བར་ཆད་མེད་པའི་ལམ་གྱི་རང་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་འདི་དག་ཐམས་ཅད་ནི་རང་བཞིན་གྱི་དཀྱིལ་འཁོར་སྡུད་པའི་སྒོར་གྱུར་པར་ཤེས་པར་བྱའོ།",
    "པདྨོ་དཀར་ལ་གནས་པར་རོ།",
    "གྲངས་མེད་མཐའ་མེད་པས་དེ་རྣམས་སྡུད་པའི་སྒོར་གྱུར་པའི་ཕྱག་རྒྱ་བྲི་བར་ཤེས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ལྷོ་ཕྱོགས་སུ་བྲིའོ།",
    "རྡོ་རྗེ་མཚན་མས་མཚན་བྱས་པའོ།",
    "རྡོ་རྗེ་མཚན་མས་མཚན་བྱས་པའོ།",
    "པདྨོའི་གདན་ལ་གནས་པར་བྲི།",
    "སྤྱན་གསུམ་པ་ནི་ཡེ་ཤེས་ཀྱི་སྤྱན་ལྷག་པར་མངའ་བའམ་ཁྲོ་བའི་མཚན་མའོ།",
    "ཞེས་པ་ནི་རྒོད་པའི་སྒྲས་ཐམས་ཅད་ཁེངས་ཤིང་གནོད་པར་འགྱུར་བའི་སྒྲ་འབྱིན་པའོ།",
    "པདྨོའི་གདན་ལ་གནས་པར་བྲི།",
    "ཞེས་པ་ནི་གོང་དུ་སྨོས་པའི་ཚུལ་དུ་བྲི་སྟེ་འཁོར་ཡན་ལག་། མང་པོ་རྣམས་ནི་ཡིད་ཀྱིས་བསམ་པར་བྱ་སྟེ།",
    "ཉུང་ཟད་ཅི་འོས་པར་བྲི་བར་བྱའོ།",
    "ཞེས་པའི་བར་དུ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཉིད་ཀྱི་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་བར་ཆད་མེད་པའི་ལམ་དུ་གྱུར་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་འོག་མ་ཟད་དུ་འཕགས་པ་མི་གཡོ་མགོན་བྲི་བའི་བྱེ་བྲག་གསུངས་པ་སྟེ།",
    "ཞེས་པའི་བར་དུ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་བར་ཆད་མེད་པའི་ལམ་རྫོགས་པའི་རང་བཞིན་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་བྲི་བའི་བྱེ་བྲག་གསུངས་པ་སྟེ།",
    "ད་ནི་དཀྱིལ་འཁོར་གཉིས་པའི་སྣམ་བུའི་སྐུ་མི་ཟད་པའི་རྒྱན་སྡུད་པར་གྱུར་པ་སྤྲུལ་པའི་སྐུ་ཤཱཀྱ་ཐུབ་པ་དང་།",
    "གཉིས་པོའི་ཆ་ནི་ངེས་པ་རུ་ཤར་ཕྱོགས་ཀྱི་དབུས་སུ་ཆ་གཉིས་རྣམ་པར་བརྟགས་པའི་སྒོ་ཁྱུད་ཀྱི་ནང་རོལ་དུ།",
    "པདྨ་དཀར་པོའི་གདན་ལ་བཞུགས།",
    "ཞལ་རས་ཞི་བའི་ཡིད་འཛུམ་པར།",
    "ལེགས་པར་གཙུག་ཏོར་ལྔ་བྲི་ཞེས་པ་ནས།",
    "གཙང་བར་གནས་དག་ལེགས་པར་བྲི།",
    "ཞེས་པའི་བར་དུ་གཙུག་ཏོར་ལྔའི་གཡོན་རོལ་ལྷོ་ཕྱོགས་སུ་གཟུགས་མེད་པའི་ཁམས་ཀྱི་ལྷ་རྣམས་ལ་སྐུ་མི་ཟད་བའི་རྒྱན་གྱིས་ཁྱབ་པར་མཛད་པའི་སྒོར་གྱུར་པ་གནས་གཙང་མའི་རིས་ཀྱི་ལྷ་རྣམས་བྲི་སྟེ།",
    "གཙུག་ཏོར་ལྔའི་བྱང་ཕྱོགས་ན་ཤཱཀྱ་ཐུབ་པ་ལ་སོགས་པ་བཞུགས་པས་བྲི་བའི་སྐབས་མེད་དེ།",
    "དེ་རྣམས་ནན་ཏན་ལེགས་པར་བྲི།",
    "སྔགས་ནོར་ཐོགས་ཞེས་པའི་བར་དུ་ཤར་དང་ལྷོའི་མཚམས་སུ་འཁོར་མེའི་དྲང་སྲོང་རྣམས་དང་བཅས་པར་བྲི་བའི་བྱེ་བྲག་དེ་རྣམས་ཀྱང་སྐུ་མི་ཟད་པའི་རྒྱན་ཉིད་མེའི་དྲང་སྲོང་ལ་སོགས་པ་གདུལ་བའི་ཕྱིར་མེའི་གཟུགས་སུ་གྱུར་པའོ།",
    "རྒྱལ་དང་རྣམ་པར་རྒྱལ་བ་ཡང་།",
    "ནན་ཏན་ཆེན་པོར་བྱས་ལ་བྲི།",
