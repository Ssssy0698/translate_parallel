    "སྨྲ་ན་མི་གསལ་བར་ཉེས་པ་བྱས་སམ་མ་བྱས་གཏོལ་མེད་ཅིང་ཅི་སྨྲས་གཏོལ་མེད་པར་སྨྲ་བ་ནི་གཡོ་ཞེས་བྱའོ།",
    "ཆགས་ནས་ཞེས་བྱ་བ་ནི་ཆགས་པ་དེས་རྒྱུ་བྱས་ནས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རབ་ཏུ་དགའ་བའི་སེམས་ཀྱིས་ཞེས་བྱ་བ་ནི་མགུ་བ་དང་ལྡན་པའི་སེམས་སམ་རློམ་པ་དང་བཅས་པའི་སེམས་སམ་ཡིད་བདེ་བའི་ཁྱད་པར་དང་ལྡན་པའི་སེམས་ཀྱིས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་༥ཡང་འདོད་ཆགས་ཀྱི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་འཚེ་བའི་རང་བཞིན་བསྟན་པའི་ཕྱིར་རྣམ་པར་འཚེ་བ་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "རྣམ་པར་འཚེ་བའི་རང་བཞིན་དང་མཚན་ཉིད་གང་ཞེ་ན་ཞེས་དྲིས་པའི་དོན་ཏོ།",
    "བསྡིགས་སྐེཔ་ལ་སོགས་པ་རྣམས་གནོད་པ་སྣ་ཚོགས་ཀྱིས་ཐོ་འཚམས་ཤིང་ཐུམི་བདེ་བ་སྐྱེད་པར་ཐུབྱེད་པ་ལ་རྣམ་པར་འཚེ་བ་ཞེས་བྱའོ།",
    "རྣམ་པར་འཚེ་བ་དེ་ཡང་མིང་དུ་ན་བརྩེ་བ་མེད་པ་དང་།",
    "འདི་ཡང་ཁོང་ཁྲོ་བའི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།་།",
    "གང་མ་བྱིན་པར་ལེན་པ་དང་།",
    "མི་ཚངས་པར་སྤྱོད་པ་ལ་འཛེམ་པ་མེད་པར་སྤྱོད་པའི་ཚེ་ནའོ།",
    "ནམ་སྲོག་གཅོད་པ་ལ་སོགས་པའི་ལས་ལ་འཛེམ་པ་མེད་པར་ཞུགས་པའི་ཚེ་ནའོ།",
    "ཁྲེལ་ཡོད་པ་སྔར་བསྟན་ན་ཁྲེལ་མེད་པ་མཇལ་ཆུང་སླ་བར་འགྱུར་བའི་ཕྱིར་ཁྲེལ་ཡོད་པ་ཇི་བསྟན་པར་བྱའོ།",
    "དེ་ཡང་འདོད་ཆགས་ཀྱིས་རྒྱུ་བྱས་ནས་སྔོན་བགད་པ་དང་།",
    "བཏགས་པར་ཡོད་པར་ཀྱེརིག་པར་བྱའོ།",
    "འདིའི་ལས་ནི་ཞི་གནས་དང་མི་མཐུན་པར་བྱེད་པ་སྟེ།",
    "སེམས་རྒོད་པ་མ་ཞི་བའི་མཚན་ཉིད་བྱུང་ནས་སེམས་རྩེ་གཅིག་པའི་ཉིང་ངེ་འཛིན་མེད་པར་འགྱུར་བས་ན་ཞི་གནས་དང་མི་མཐུན་པའི་རྟེན་བྱེད་པ་ཞེས་བྱའོ།",
    "དེ་ལ་ལས་དང་ལྐུའབྲས་བུ་དང་བདེན་པ་ལ་སོགས་པ་ཡོད་པར་ཡིད་མི་ཆེས་པ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ནི་ཐོབ་པར་བྱ་བར་ནུས།",
    "འཕགས་པའི་ལམ་ནི་བསྒྲུབ་པར་ནུས་པ་ལ་གང་འདོད་པ་སྐྱེ་བ་ནི་དད་པ་ཞེས་བྱའོ།",
    "བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "བརྗེད་པར་གྱུར་པ་ལ་ནི་དྲན་པ་ཉམས་པ་ཞེས་བྱའོ།",
    "འདིའི་ལས་ནི་རྣམ་པར་གཡེང་བའི་རྟེན་བྱེད་པའི་ལས་ཅན་ཏེ།",
    "རྣམ་པར་གཡེང་བའི་རང་བཞིན་བསྟན་པའི་ཕྱིར།",
    "རྣམ་པར་གཡེང་བ་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "རྣམ་པར་གཡེང་བའི་རང་བཞིན་དང་མཚན་ཉིད་གང་ཞེ་ན་ཞེས་དྲིས་པའི་དོན་ཏོ།",
    "འདོད་པ་ལྔའི་ཡོན་ཏན་ལ་སེམས་ལ་སེམས་གཡེངས་པར་གྱུར་པ་རྣམས་ལ་ཁམས་གསུམ་གྱི་འདོད་ཆགས་སྤང་བར་བྱ་བ་ལ་བར་དུ་གཅོད་ཅིང་བགེགས་བྱེད་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པ་ལྔ་པོ་དེ་དག་ནི་རང་བཞིན་གྱིས་ནང་དུ་རྩེ་གཅིག་པར་འཇོག་མི་ནུས་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "གཡེང་བ་གཞན་དག་ཀྱང་རྣམ་པར་གཡེང་བའི་མཚན་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "མ་ལེགས་པ་ཞེས་ཧཱུཾབྱས་སོ་ཞེས་ཕྱིས་ཡིད་ལ་གདུང་ཞིང་ཡིད་ལ་གཅགས་པ་དང་།",
    "མ་ལེགས་པ་ནི་བྱས་སོ་ཞེས་ཕྱིས་ཇེམི་དགའ་ཞིང་ཡིད་ལ་གཅགས་པའམ།",
    "བཙེམ་དྲུབ་ལ་སོགས་པའི་ལས་བྱས་པ་མཚར་བྱས་ཤེའམ་མ་བྱས་པ་མཚར་བྱས་སོ་ཞེས་ཕྱིས་ཡིད་ལ་གདུང་ཞིང་ཡིད་ལ་གཅགས་པ་ལ་འགྱོད་པ་ཞེས་བྱའོ།",
    "བབྱུམ་དྲུབ་ལ་སོགས་པའི་ལས་མ་བྱས་པ་མཚར་བྱས་ཤེའམ་དེ་དག་བྱས་པ་ཉེས་པ་ཞིག་བྱས་སོ་ཞེས་འགྱོད་པ་ནི་འགྱོད་པ་ལུང་དུ་མ་བསྟན་པའོ།",
    "མི་མཐུན་པར་བྱེད་པ་སྟེ།",
    "མུན་པའི་འདུ་ཤེས་ཡིད་ལ་བྱས་པ་ལས་གཉིད་སྐྱེ་བར་འགྱུར་རོ།",
    "གཉིད་ཀྱིས་ལོག་ནས་རྨྱེལས་སུ་བྱ་བ་ཐམས་ཅད་མི་འགྲུབ་ཅིང་ཉམས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལ་འདི་གོ་རྫ་མ་ཞིག་ཡིན་ནམ་སྣམ་བུ་ཞིག་ཡིན་ནམ་ཅི་ཞིག་ཡིན་ཞེས་སྤྱི་ཙམ་རྟོག་པའི་རྣམ་པར་ཞུགས་པ་ལ་ཚོལ་བ་ཞེས་བྱའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་གྱི་རྟོག་པའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་རབ་གཉིས་ཀྱིས་བྷུ་བྱེ་བྲག་ལས་རྟོག་པ་གདགས་པས་ན་རྟོག་པ་འདི་ཡང་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "འདི་ནི་མ་ལེགས་ཞེས་ཞིབ་ཏུ་དཔྱོད་པར་བྱེད་པ་ལ་སོ་སོར་རྟོག་པ་ཞེས་བྱའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་ཞིབ་ཏུ་རྣམ་པར་རྟོག་པར་བྱེད་པའི་རང་བཞིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ནི་མ་ལེགས་ཞེས་ཞིབ་ཏུ་སྨྲ་ཞིང་རྟོག་པར་བྱེད་པས་ཡིད་ཀྱིས་བརྗོད་པ་ཞེས་བྱ་སྟེ་དེའི་ལས་བསྟན་ཏོ།",
    "དེ་ཉིད་བྱེཀྱི་ཤས་ལས་འབྱུང་༩བས་ན་འདི་ཡང་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "འདི་ནི་མ་ལེགས་པ་ཞིག་ཡིན་ཞེས་ཕྲར་རྟོག་པར་བྱེད་པས་ན་སེམས་ཞིབ་པ་ཞེས་བྱ་སྟེ་དེས་ནི་རང་བཞིན་བསྟན་ཏོ།",
    "གཞན་ལ་གནོད་པར་བྱ་བའི་ཐབས་ལ་དཔྱོད་པ་ནི་མི་བདེ་བའི་རྒྱུར་འགྱུར་བས་ན་མི་བདེ་བར་གནས་པའི་རྟེན་བྱེད་པའོ།",
    "ཤེས་རབ་ཀྱི་བྱེ་བྲག་ལ་གདགས་པར་འདྲ་ན་ཁྱད་པར་ཅི་ཡོད།",
    "དེ་གཉིས་ལ་ཁྱད་པར་ཡོད་དེ།",
    "ཤེས་རབ་ཀྱི་བྱེ་བྲག་ལ་གདགས་པར་འདྲ་ན་ཡང་རྟོག་པ་ནི་སེམས་རྩིང་བའི་རང་བཞིན་དཔྱོད་པ་ནི་སེམས་ཞིབ་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།་།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་ལྟ་བའི་ཚུལ་གྱིས་དེ་དག་བཏགས་པ་ཙམ་དུ་ཡོད་པར་ཟད་ཀྱི་བྱེརྫས་སུ་ཡོད་པ་ཟུ་མ་ཡིན་པར་བསྟན་ཅིང་།",
    "དེ་དག་བཏགས་པ་ཙམ་དུ་ཡོད་པར་ཡང་ཇི་ལ་གདགས་པ་བསྟན་པའི་ཕྱིར།",
    "དེ་བས་ན་དེ་དག་བཏགས་པར་ཡོད་ཀྱི་རྫས་སུ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དཔེར་ན་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཡང་གཟུགས་དང་།",
    "སེམས་དང་སེམས་ལས་ཧཱུཾབྱུང་བའི་མཐུས་བསྐྱེད་པར་བརྩམས་ཏེ།",
    "ནམ་ཐོབ་པར་གྱུར་པའི་དུས་ཕན་ཆད་སོ་སོའི་ཆོ་མིང་དུ་གདགས་པར་རིག་པར་བྱའོ།",
    "འདི་ལྟར་གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བའི་མཐུས་བསྐྱེད་པའི་འདུ་བྱེད་སེམས་དང་མི་ལྡན་པའི་རྣམས་ཉན་ཐོས་རྣམ་པར་སྨྲ་བ་རྣམས་ནི་གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བ་ལ་མ་གཏོགས་པར་རྫས་སུ་ལོགས་ཤིག་ན་ཡོད་པར་རྟོག་སྟེ།",
    "ཁ་ཅིག་གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བའི་རང་བཞིན་ཉིད་དེ་ཡིན་པར་གདགས་སམ།",
    "རྟེན་དང་བརྟེན་པ་གཅིག་ན་ཡང་སྐྱོན་དུ་གྱུར་པའམ་ཐ་དད་ནའང་སྐྱོན་དུ་གྱུར་པས་དཔེར་ན་བུམ་པ་དང་ས་གཅིག་པར་ཡང་མི་གདགས་ཐ་དད་པར་ཡང་མི་གདགས་པ་དང་།",
    "འདི་ལྟར་བུམ་པ་དང་ས་རང་བཞིན་གཅིག་པར་ཡང་གདགས་སུ་མི་རུང་སྟེ།",
    "བུམ་པ་དང་ཆུ་གཅིག་པར་མི་རུང་བ་བཞིན་དུ་རྟེན་དང་བརྟེན་ཀྱེཔར་རང་བཞིན་གཅིག་པར་ཡང་མི་རུང་བར་རིགས་པའི་ཕྱིར་རོ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བའི་དུས་སུ་གདགས་པ་ཡང་སེམས་དང་མི་ལྡན་པའི་འདུ་བྱེད་ཡིན་པར་བསྡུའོ།",
    "འབྲས་བུ་སྐྱེས་ཁྲུཟིན་པར་གྱུར་པ་ལ་ནི་མངོན་དུ་གྱུར་པ་རྙེད་པ་ཞེས་བྱའོ།",
    "ཅི་རིགས་པར་སྦྱར་རོ་ཞེས་བྱ་བ་ལ་དེ་འདི་ལྟར་སྦྱར་བའི་རིགས་ཏེ།",
    "ཅི་རིགས་པར་སྦྱོར་རོ་ཞེས་བྱ་བ་ནི་འདི་ལྟར་རིགས་ཏེ།་",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པའི་རང་བཞིན་བསྟན་པའི་ཕྱིར།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "འདུ་ཤེས་མེད་པའི་མཚན་ཉིད་དུ་སྙོམས་པར་འཇུག་པའམ་འདུ་ཤེས་མེད་པ་ནི་འདུ་ཤེས་མེད་པའི་ལྷ་རྣམས་ཀྱི་ནང་དུ་སྐྱེས་པ་རྣམ་པར་མིན་པའི་འབྲས་བུ་ཡིན་ཏེ།",
    "རྣམ་པར་སྨིན་པ་འདུ་ཤེས་མེད་པ་དེ་ཐོབ་པར་བྱ་བའི་ཕྱིར་སྙོམས་པར་འཇུག་པ་ལ་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ་སྟེ།",
    "ཤིན་ཏུ་ལེགས་པར་མཐོང་བ་དང་།",
    "གཟུགས་མེད་པའི་སྟོམས་པར་འཇུག་པའི་འདོད་ཆགས་ད་དུང་མ་སྤངས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་ཟག་སོ་སོའི་སྐྱེ་བོ་འདུ་ཤེས་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་པར་འདོད་པ་དེས་དང་པོ་སྙོམས་པར་འཇུག་པའི་ཚེ་ན་འདུ་ཤེས་སུན་འབྱེན་ཏེ།",
    "འདུ་ཤེས་ལ་སོགས་པའི་སེམས་དང་སེམས་ལས་བྱུང་བའི་འགོག་པར་བྱེད་པས་ན།",
    "རྣམ་པར་ཤེས་པ་དེ་དྲུག་འགོག་པའི་སྙོམས་པར་འཇུག་པ་དང་།"
  ]
}