    "ཁ་བའི་བུ་མོ་ཁ་བ་བཞིན།",
    "སྟོན་མཇུག་ཏུ་ང་ཚོའི་གྲོང་ཚོར་བབས་བྱུང་།",
    "འོ་ཁ་བའི་བུ་མོར་བྱུ་རུའི་ཚོས་ཀྱིས་བྱུགས་པའི་འཆོར་སྒེག་དང་།",
    "ཁ་བའི་བུ་མོས་ཕ་མ་ཉེ་དུའི་མངོན་ཞེན་དང་རང་ཡུལ་རྒྱབ་ཏུ་བསྐྱུར་ནས།",
    "ཁ་བའི་འདབ་དྲུག་འོད་གསལ་དབྱིངས་ནས་གྲུ་ཆར་མངར་མོས་བབས།",
    "ཁ་བའི་བུ་མོ་སྦྲང་ཆར་བཞིན།",
    "དབྱར་གཞུང་དུ་ང་ཚོའི་གྲོང་ཚོ་ལ་བབས་བྱུང་།",
    "ཁ་བའི་བུ་མོ་ནི་མིང་མེད་ཀྱི་སྐར་མ་འོད་ཆེན་དང་།་",
    "བུ་ཆུང་གངས་ཆག་གི་ལྷུམས་སུ་བརྒྱལ་ལ་རིངས།",
    "ཁ་བའི་བུ་མོ་འཇའ་ཚོན་བཞིན།",
    "དགུན་དཀྱིལ་དུ་ང་ཚོའི་གྲོང་ཚོ་ནས་ཤར་བྱུང་།",
    "ཁ་བའི་བུ་མོ་སྦྲང་ཆར་བཞིན་བསིལ་ཞིང་བརླན།",
    "སྐྱེས་ཆེན་གནོག་ཆུང་ལས་ཀྱི་འཁོར་ལོའི་རྗེས་སུ་འཁྱོམ་ཞིང་།",
    "ལོ་སར་ཚེས་གསུམ་ལ་ང་ཚོའི་གྲོང་ཚོ་ནས་ལྡང་བྱུང་།",
    "ཁ་བའི་བུ་མོས་སྤྲིན་དཀར་བོའི་འདུ་འགོད་ཐོད་ཕྲེང་ལ་བཅིངས་ནས།",
    "གཡུ་འབྲུག་སྔོན་མོའི་རྒྱབ་རིས་གློག་ཞགས་ཀྱིས་ངོམས་དུས།",
    "ཁྱོད་ཀྱི་མདུན་དུ་ཅི་ཞིག་བཤམས་བྱུང་།",
    "ཁྱོད་ཀྱི་རྗེས་ནས་གང་ཅིས་བཙིར་བྱུང་།",
    "ཁོ་མོས་ཙན་དན་དམར་བོའི་མཆོད་སྡོང་ལ་མཇལ་མིན།",
    "ཁྱོད་ཀྱིས་སྔོ་བསངས་བུ་མོར་ཞལ་མཇལ་ཞུས་དང་།",
    "ང་ཚོས་མཆོད་སྡོང་དམར་བོར་ལྗང་མྱུག་འབུས་ནས།",
    "ལོ་མ་རེ་ལ་གསེར་སྐུ་བབས་པའི་སྐུ་གསུམ་ཞིང་ཁམས་འདིའི་བློས་བསླངས་བྱས་ཆོག་བསམ་བཞིན་བསམ་བཞིན་སྐྱོ་བ་གཏིང་ནས་སྐྱེས།་",
    "དལ་མོར་ཞལ་མཇལ་ཞུས་དང་།",
    "ཁྱོད་ཀྱི་སྣང་ངོར་ངང་གིས་ཆས་འོང་།",
    "དལ་མོར་ཞལ་མཇལ་ཞུས་དང་།",
    "མཁས་པ་གཡོག་ཏུ་ཚུད་པས་མི་ཚེའི་རེ་ཐག་ཆད།",
    "འཁྱོག་པོའི་འཆལ་གཏམ་སྨྲས་ན་རང་གིས་རང་ལ་སྨད།",
    "ཤེས་ཚད་ཁོང་དུ་སྦས་པ་བཟང་མོད་ཀྱང་།",
    "ཚོགས་གཉིས་འོ་མཚོ་བསྲུངས་ལས་ཟུང་འཇུག་གི་གོ་འཕང་།",
    "རང་གི་མྱོང་བས་དཔྱད་ན་ག་ཚོད་ཅིག་ལོངས་སམ།",
    "སྐྱེ་མཆེད་རྣམ་པར་བཀྲ་བ་ཁང་སྟོང་གི་ནང་དུ།",
    "ཐལ་ངག་སྦྱོར་བའི་མེ་སྟག་ལམ་ལམ་དུ་འཕྲོ་ཞིང་།",
    "ང་རྒྱལ་བྲེ་སེར་འབྲོང་གི་རྭ་རྩེ་ལས་གྱེས་ཏེ།",
    "ངན་སོང་སྒོ་བརྒྱ་འབྱེད་པའི་ངག་བཀྱལ་དུ་གོའོ།",
    "དད་པ་མ་ཎི་བགྲང་རྣམས་སྐལ་བཟང་ལ་རེག་འོང་།",
    "འབྱོར་ན་འཛད་ཀྱིས་དོགས་པའི་འཚོ་སྐྱོང་གིས་དུབ་པ།",
    "ལུས་སེམས་དལ་བ་བྲལ་བས་ཨ་ཐང་ནི་ཆད་སོང་།",
    "རེ་བའི་དོན་པོ་འཇིག་རྟེན་རྙེད་པ་ཡིས་མཐུན་ཡོང་།",
    "ཡུན་རིང་འབད་ནས་བསགས་པའི་ཟང་ཟིང་གི་ནོམ་རྫས།",
    "རེས་འབྱོར་རེས་འགར་དབུལ་བའི་འཇིག་རྟེན་གྱི་བྱ་གཞག།",
    "དཀར་ནག་ལས་ཀྱི་རྡེའུ་རྔོ་བགྲང་རེ་བྱས་ནས།",
    "སྤང་བླང་དགེ་སྡིག་དབྱེ་བའི་གཟིགས་མོ་རུ་ཕེབས་དང་།",
    "ད་ནི་ལུས་སེམས་བདེ་བའི་ཞེ་བློ་རེ་ཚིམ་ན།",
    "སྐྱེས་མཆོག་དམ་པའི་གཟིགས་ཚེ་ཁྲེལ་དགོད་རེ་གནང་ངོ།",
    "རང་གི་ལྟོ་འདུན་དཀའ་བའི་རྒས་འཁོགས་ཀྱི་རྒན་པོས།",
    "ཚེ་སྲོག་དར་སྐུད་ཕྲ་མོ་ཆད་པ་ལ་ཉེ་ཡང་།་",
    "འདོད་སྲེད་སེམས་ཀྱི་ཁྱེའུ་ལང་ཚོ་རང་རྒྱས་ཏེ།",
    "བུ་ཆུང་ལང་ཚོ་ཅན་གྱི་ཀེང་རུས་དེ་མཐོང་ན།",
    "རྒན་གཞོན་བར་མའི་གོ་རིམ་སུ་ཞིག་གིས་བརྩི་ནུས།",
    "གཅིག་རྗེས་གཅིག་གིས་བདས་པ་འཇིག་རྟེན་གྱི་བྱ་གཞག།",
    "གསར་རྙིང་གསེར་གྱི་རི་བོའི་ཟོམ་ལས་ལང་ཚོའི་རྦབ་ཆུ་དྲག་ཏུ་ཕབ།",
    "མཁའ་དབུགས་གཙང་མའི་ཡུལ་ལྗོངས་འདི་ན་དྲི་བཞོན་བུ་མོ་ད་དུང་རྒྱུ།",
    "ཁྱེད་ནི་ཕྲན་ཆུང་བདག་གི་སེམས་ན་གཞར་ཡང་འབར་བའི་སྤོབས་པ་ཡིན།",
    "རིན་བྲལ་ཕ་སྐད་བརྗེད་ལ་ཉེ་སྐབས་འབོལ་རྩོམ་ཞོགས་པའི་སྐྱ་རེངས་བཀྱག།",
    "ཡིད་ཕམ་སྐྱེ་བོའི་གདུང་བ་སེལ་ཆེད་རྒྱ་མཚོ་སྔོན་མོའི་གླུ་དབྱངས་བླངས།",
    "མོག་མོག་ཚིག་གི་སྒྲིབ་གཡོགས་དབེན་པའི་སྤྲིན་དཀར་འདབ་མ་དགོད་ཅིང་འཕྱོ།",
    "༡ ལུ་མལ་ཆ་བ་ཞོ་གསར་སྤུངས་འདྲའི་ཕུགས་འདུན་ཟབ་མོར་ས་ཡི་བདག་པོ་མཁའ་ལ་འཕུར།",
    "རྩོམ་རིག་གསར་བའི་སྐྱ་རེངས་བསུ་མཁན་སྒྲ་དབྱངས་ལྷ་མོའི་ཐུགས་སྲས་ཀྱེ།",
    "རེ་ཞིག་འབྱོར་མེད་མཁས་པས་བཀུར་ལ་ལྟོས།",
    "ཡ་རབས་མི་ཡི་ཁྱིམ་སྒོ་འགྲིམ་ཐེངས་རེར།",
    "སྐྱ་རེངས་འཆར་བའི་ལམ་དེར་ངང་གིས་ཞུགས།",
    "མངར་སྐྱུར་ཁ་བའི་རི་མོ་སེམས་ལ་བྲིས།",
    "ཨ་ལ་བདག་གི་ངག་ལས་ཤོར་བའི་ཨཱ་ལིའི་དབྱངས་ཀྱི་གླུ་ཆུང་འདི།",
    "ཨ་མཚར་ཀུ་རེའི་ཚུལ་དུ་མ་ཡིན་ཨ་ཅང་དྲང་མོའི་གཏམ་ལགས་ན།",
    "ཨ་མ་གཅིག་གི་བྱང་ཁོག་འགྲིམ་ཕྱིར་ཨ་གར་ལྟ་བུའི་གཏམ་འདི་ཉོན།",
    "ཨ་མ་སྲིན་མོའི་ཞེ་སྡང་དོར་ལ་དེང་རབས་ཅན་བཞིར་མིག་རྒྱང་ལྟོས།",
    "ཨ་མའི་བུ་མོ་བཙན་གྱིས་བཙོངས་ཏེ་དུས་བཞིར་སོ་ཚིས་དབྱིངས་ལ་བཏགས།",
    "ཨ་ཕའི་བུ་ཆུང་ས་མཐར་འཁྱམ་ནས་ཕ་སྐད་དོར་བའི་གྲོང་ནས་རྒས།",
    "ཨ་མ་རྒན་མོས་མ་ཎི་སྐྱོར་བཞིན་ཨུ་ཚུགས་སྙོག་གཏམ་ངག་སྒོར་འདྲེན།",
    "ཨ་ཕ་སྤྲེའུ་བུ་རབས་ཚ་རྒྱུད་ངའོ་ཁ་ཕོ་མ་ཆེ་བར།",
    "ཨུ་དུམ་ཝ་རའི་གསེར་གྱི་ལང་ཚོ་འདམ་དུ་མནོན་པའི་ལུང་རུབ་གཞོན།",
    "ཨ་རོགས་སློག་ཧྲུལ་བརྗེ་མེད་གྱོན་པའི་ནོར་གནག་ཕྱུགས་ཀྱི་བདག་པོ་ཡ།",
    "ཨ་རོཊ་ཚན་རྩལ་གནམ་གྲུར་སྡོད་ལ་ཡངས་པའི་ཁམས་འདིར་ལྟར་མོར་ཕེབས།",
    "སྟོང་གསུམ་ཞིང་གི་གདུལ་བྱ་ལ།",
    "དུས་ཀྱི་བདུད་མོའི་ཆོ་འཕྲུལ་གྱིས།",
    "ཡང་དར་མེ་རོ་ཁྱོད་ཀྱིས་གསོས།",
    "གང་གི་བྱ་དཀའི་སྤྱོད་པ་འབུམ་རྫོགས་པ།་",
    "ཐུབ་པ་མཆོག་གི་ཞབས་ཟུང་འཁོར་ལོའི་རིས།",
    "མ་དགེ་ལེགས་ཅོང་གིས་དྲན་སྐུལ་བཏང་བ་ན།",
    "མ་འཛིན་འདོད་བསྟན་འཛིན་ཕལ་མོ་ཆེ།",
    "མགོན་ཁྱོད་ངང་བའི་རྒྱལ་བོར་ཀུན་གྱིས་བསྔགས།",
    "སྲིད་པའི་ནགས་མོ་ཚང་ཚིང་འཁྲུགས་པའི་ཀླུང་།",
    "མགོན་ཁྱོད་ཡོན་ཏན་ཅི་དང་གང་གིས་མཚོན།",
    "ཁྱོད་ཡོན་ཉི་ཟླ་འབར་བའི་འོད་དཀར་གྱིས།",
    "རེ་ཞིག་ནུབ་རིའི་ཕག་ཏུ་ཡོལ་བ་འདིས།",
    "ཁྱོད་སྐུ་གཞོམ་གཞིག་བྲལ་བ་རྡོ་རྗེའི་སྐུ།",
    "ཀུན་བཟང་འཕྲུལ་གྱི་འཁོར་ལོའི་རྩིབས་མ་རེར།",
    "ཁྱོད་ཀྱི་བཀའ་དྲིན་པདྨ་དཀར་བོའི་ཁ།",
    "མགོན་ཁྱོད་རྒྱལ་བའི་མཛད་པ་མཐའ་དག་རྒྱུད་ལ་སྦྱར་ཞིང་རྗེས་སུ་དྲན།",
    "འདི་ནི་རླབས་ཆེན་གུང་ཁྲན་ཏང་གི་མཁས་མཛངས་སྟོབས་ལས་གཞན་དུ་ཅི།",
    "བགྲང་བྱ་བརྒྱད་ཅུའི་བགྲོད་ལམ་རིང་མོ་སླར་ཡང་ཕྱིར་དྲན་བྱས་པ་ན།",
    "གསར་བརྗེའི་མེ་ལྕེ་ཕྱོགས་སུ་སྤེལ་མཛད་མཆོག་གི་དཔའ་རྒོད་གྲངས་མེད་ཀྱིས།",
    "རླབས་ཆེན་ཏང་གི་ལ་རྒྱའི་དབུ་འཕང་དགུང་དུ་བསྟོད་ཀྱིན་བདེ་བར་གཤེགས།",
    "དམ་པ་གང་གི་བསྒྲགས་གཏམ་དེ་ནི་གུང་ཁྲན་ཏང་གི་གཟི་བརྗིད་ཉིད།",
    "ཡ་གླིང་ཤར་གྱི་ནོར་འཛིན་ལྟོ་རུ་མེས་རྒྱལ་ལང་ཚོ་ཀུན་ནས་རྒྱས།",
    "ལྗོངས་འདིར་སྟོབས་འབྱོར་དཔྱིད་དཔལ་རབ་བཞད་དཔལ་ཡོན་ཟུང་གི་འབྲས་བཟང་སྨིན།",
    "འཛམ་གླིང་ཤར་ཕྱོགས་ནོར་འཛིན་ལྟོ་རུ་རླབས་ཆེན་ཏང་གི་གྲགས་པ་འབར།",
    "དུས་རབས་གསར་བའི་སྐྱ་རེངས་བུ་མོས་རེ་བའི་འཛུམ་མདངས་སྟོན་བཞིན་དུ།",
    "གང་ས་གང་དུ་སྤྲོ་དགའི་རླབས་འཕྱུར་མཆོག་གི་མཛད་འཕྲིན་གླུ་རུ་ལེན།",
    "བསང་ཆབ་སྔོན་མོ།",
    "ལྷན་ཅིག་ཉི་མ་སྟོང་གི་འཛུམ་དཀར་མདས།",
    "གྲུབ་པའི་བསང་ཆུ་དལ་འབབ་རིང་མོའི་རྒྱུན།",
    "གང་ཁྱེད་གདོད་ནས་བ་ཚྭས་མ་རེག་པར།",
    "ཡང་དག་འཇོག་གི་རོལ་རྩེད་རྙེད་པ་ཡང་།",
    "མརྒད་ཐགས་སུ་བསྐྲུན་འདྲའི་ནེའུ་གསེང་གི།",
    "སྣང་བྱེད་སྟོང་གི་གཟི་མདངས་ཕྱོགས་གཅིག་ཏུ།",
    "བརྩེ་སེམས་ནམ་མཁའི་ཤེ་མོང་དཔལ་ལས་བསྙིལ།",
    "ཡན་ལག་བཞི་ཟུང་ལང་ཚོ་ཉ་གང་བའི།",
    "འབྱུང་འགྱུར་འཇིག་རྟེན་གསར་བའི་ལྟད་མོའི་སྒོ་།",
    "སྤྲུལ་སླད་གང་ཉིད་ལང་ཚོའི་འཕེལ་ཁ་རྫོགས།་",
    "བྲག་བདེ་མཆོག་མཐོ་སྒང་གི་གྲང་རེག་ཁྲོད།",
    "སྦྲ་ནག་གི་འདབས་རོལ་ན།",
    "བདེ་སྐྱིད་མེ་ཏོག་སྐྱ་རེངས་བུ་མོའི་ཡིད་འོང་གི་འཛུམ་མདངས་ཁྲོད།",
    "འབྲལ་མི་འདོད་པའི་གདུང་བ་ཞིག་གིས།",
    "དུས་རྒྱུན་ཉག་ཀ་ཞིག་གི་ཕ་རོལ་ལ།",
    "བདེ་སྐྱིད་མེ་ཏོག་མེ་ཏོག་གིས་དགྱེས་འཛུམ་གྲོལ་ལ།",
    "ཁུ་བྱུག་གི་གསུང་སྐད་སྙན་པའི་དུས་ཚིགས་དེར།",
    "རེ་སྒུག་གི་ཉིན་མཚན་བར་ནས།",
    "ཁྱོད་རང་ངའི་མཛའ་གཞས་ལ་སེམས་པ་ཕྱོགས་ཚུལ།",
    "ཨ་མ་དྲན་པའི་གདུང་སེམས།",
    "རྨ་ཆུའི་གསང་བདག་བདེ་སྐྱིད་མེ་ཏོག་མཚར་སྡུག་གི་ཞལ་ཁྱིམ་སྒོར་མོ།",
    "ཡིད་འོང་གི་སྐྱེས་གཟུགས་ཕྲ་མོ།",
    "ཁྱོད་ཀྱིས་སྦྲ་ནག་གི་སུམ་ཐབ་འགྲམ་ན།",
    "སྐྱོ་གདུང་གི་མིག་ཆུ་ཡ་ཆུང་ལ་བསགས་བཞིན་པ་ཐོས་ཚེ།",
    "ཇི་འདྲའི་བཟོད་དཀའ་བ་ཞིག་རེད་ཨང་།",
    "བཀའ་དྲིན་བརྗོད་དུ་མེད་པའི་བྱམས་ལྡན་གྱི་ཨ་མ།",
    "བརྩེ་ལྡན་ཨ་མའི་ཞལ་རས་ཡིད་སེམས་སུ་ཤར་ཚེ།",
    "སྐྱོ་བའི་ངུ་ངག་ཕྲ་མོ་བྲག་ཅ་དང་འདྲེས་འགྲོ།",
    "མེ་ཏོག་སྣ་ལྔས་བརྒྱན་པའི་མཛེས་སྡུག་གི་ཞིང་དུ།",
    "སྐུ་དྲིན་གཞན་ལས་ལྷག་པའི་ཨ་མ་དེ་དྲན་བྱུང་།",
    "ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན་ལྷང་ལྷང་དུ་གྲག་ནས།",
    "ལེ་བར་སྟོང་ཕྲག་གིས་ཆོད་ཕ་ཡུལ་གྱི་མ་ལོ།",
    "བརྩེ་ལྡན་ཨ་མའི་བཀའ་དྲིན་འཇལ་བ་རུ་བསླེབ་ཡོང་།",
    "གྲང་ངར་རེག་བྱ་མྱོང་བའི་ཨ་མ་ཡི་དུང་སེམས།",
    "བདག་གི་དྲན་པའི་དབུས་སུ་རི་མོ་བཞིན་བཀྲ་བྱུང་།",
    "ཟས་ཀྱི་ལྷག་མ་བཟའ་བའི་གཤིས་འཇམ་གྱི་ཨ་མ།",
    "བརྩེ་སེམས་དྭངས་མོའི་མདངས་ནི་གངས་རི་ལས་དཀར་བས།",
    "སློག་ཧྲུལ་སྐྱ་བོ་གྱོན་པའི་ཉམ་ཆུང་གི་ཨ་མས།",
    "བརྩེ་སེམས་མཚོ་ལས་ཟབ་པའི་ཨ་མ་དེ་དྲན་བྱུང་།",
    "ཁྲུང་ཁྲུང་དཀར་མོའི་སྙན་ལ་འཕྲིན་འདི་སྒྲོན།",
    "ལས་མང་ངལ་དུབ་གོམ་འགྲོས་འཁྱོར་བའི་དུས།",
    "འགྲོ་ལ་ཉེ་སོང་བསམ་མམ་ཞེ་མཐུན་མ།",
    "གོས་ཀྱི་རི་མོ་མཐོང་ངམ་ཞེ་མཐུན་མ།",
    "སྐྱ་རེངས་ལྷ་མོས་བརྩེ་འཛུམ་དགོད་པ་ན།",
    "ན་ཆུང་བུ་མོའི་ཚོགས་ཀྱིས་བསྐོར་དང་ལྷན།",
    "ཨོཾ་ཨ་མི་དྷེ་ཝ་ཧྲཱི་འདི་ཉིད་ཆག་མེད་ཐུགས་དམ་མཛོད།",
    "བདག་གི་ཆུ་བུར་མིག་གིས་མ་མཐོང་ཡང་།",
    "ཐུགས་རྗེའི་སྤྱན་གྱིས་རྒྱང་ནས་བདག་ལ་གཟིགས།",
    "མོས་གུས་ཕྱག་ལ་ཉེ་རིང་ཁྱད་མེད་ཕྱིར།",
    "ཕྱག་གཡས་འོད་ཟེར་ལས་སྤྲུལ་སྤྱན་རས་གཟིགས།",
    "ཐོས་ནས་དད་པས་ཐལ་མོ་སྦྱར་བྱས་ན།",
    "བུད་མེད་མི་སྐྱེ་རིགས་ནི་བཟང་པོར་སྐྱེ།",
