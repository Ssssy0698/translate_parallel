    "གཞལ་ན་རང་དང་གཞན་དང་གཉིས་ཏེ་འདི་རྣམས་ཐམས་ཅད་ཀྱི་སྐྱེ་བ་དང་ལྡན་པར་མི་རིགས་པའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "འདི་དག་ཀྱང་བཅོམ་ལྡན་འདས་དེའི་ཡང་དག་པར་རིག་པར་མི་བྱེད་པ་མ་ཡིན་ཏེ་འདི་དག་གཉིས་ཀ་ཡང་བརྫུན་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་པའོ།",
    "རྒྱས་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྐང་པ་ལ་བརྟེན་པའི་གར་ནི་རྒྱས་པར་བྱེད་པའོ།",
    "བཅོམ་ལྡན་འདས་དོན་དམ་པར་གནས་སྐབས་དེ་བྷགའི་པདྨར་ཡོངས་སུ་བསྒྱུར་བའི་གཟུགས་ལ་ཐིག་ལེའི་མིང་དུ་གསུངས་སོ།",
    "ངེས་པར་འབྱིན་པར་བྱེད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ལ་བརྟེན་ནས་རྣམ་པ་སྣ་ཚོགས་པའི་རྣམ་པར་འགྱུར་རོ།",
    "ཨཱ་ལི་ཀཱ་ལིའི་དཀྱིལ་འཁོར་གཉིས་དང་རྡོ་རྗེ་ལས་བྱུང་བ་མ་མ་ཀཱི་ལ་འཁྱུད་པས་ཡང་དག་པར་བསྐྱེད་པའི་བདེ་བ་ཆེན་པོའི་ངོ་བོ་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་བདུད་རྩི་སྐྱེའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གསུངས་པ་དེ་ལས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསང་བའི་འདུས་པ་ལ་སོགས་པར་ཡང་དག་པར་སྦས་ཏེ་བསྟན་པའོ།",
    "ཚངས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཚངས་པ་དང་ཚངས་པ་མ་ཡིན་པ་ལ་སོགས་པ་དེ་དག་ཀྱང་དེ་ཉིད་ཁོ་ན་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་མ་རྟོགས་པར་བདག་ཉིད་གཞན་དུ་སེམས་པར་བྱེད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་རྣམས་སོ།",
    "དེ་རྣམས་སྐྱེ་བར་འགྱུར་རོ་འཆི་བར་འགྱུར་རོ་ཐིམ་པར་འགྱུར་རོ།",
    "བཟུང་བ་དང་འཛིན་པ་དང་བྲལ་བའི་ཡེ་ཤེས་ལ་ཤེས་བྱའི་ཕུང་པོ་མཐར་ཐུག་པར་རབ་ཏུ་ཞུགས་པས་གཉིས་མེད་པ་ལ།",
    "དངོས་པོ་འདི་དག་ཀུན་ནུབ་པ་དང་འཆར་བ་ལ་སེམས་པར་བྱེད་གོམས་པར་བྱེད་དོ།",
    "དེ་ཉིད་ཀྱི་ཕྱུར་གསུངས་པ།",
    "འབྱིན་པར་བྱེད་པ་ནི་འགྲོ་བ་སྐྱེད་པར་ནུས་པའོ།",
    "བརྗོད་པར་བྱ་ཞེས་བྱ་བའི་ཚིག་འདིས་ཡང་དག་པར་སྤྲེལ་བར་བྱའོ།",
    "ལྷ་ཐམས་ཅད་ཡང་དག་པར་རིག་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཁང་པར་བྱས་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཁང་པ་ནི་དཀྱིལ་འཁོར།",
    "དེ་གང་བར་བྱས་སོ།",
    "ཧེ་རུ་ཀ་ཁྲོ་བོ་བསྐྱེད་པ་གསུངས་པའི་འགྲེལ་པ།",
    "འདིར་སླར་ཡང་ཧེ་རུ་ཀ་ཁྲོ་བོ་བསྐྱེད་པའི་ཤེས་པར་འདོད་པས་བཅོམ་ལྡན་འདས་ལ་ཞུ་བར་བྱེད་དོ།",
    "གཞན་དུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ཞི་བའི་གཟུགས་ཀྱིས་གདུག་པ་ཆེས་དྲག་པོ་རྣམས་གདུལ་བར་བྱ་མི་ནུས་པའི་ཕྱིར་ཞེས་པའོ།",
    "པདྨའི་ལྟེ་བ་ལ་བཞུགས་པར་བསམ་པར་བྱའོ།",
    "བཟླས་པའི་སྔགས་ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམས་ཀྱིས་སྔགས་བཏུ་བ་གསུངས་པ།",
    "སྒྲ་ནི་ལན་གཉིས་བྱས་ནས་སུ།",
    "དེ་ཉིད་ཧཱུཾ་ཡིག་དེ་དེས་ཡང་དག་པར་ལྡན་པའི་ཚིག་གོ།",
    "ཕཊ་ཀྱི་ཡི་གེས་རྣམ་པར་བརྒྱན།",
    "ཨ་ཡིག་དང་པོར་འབྲེལ་པ་ཅན་གྱི་བཅུ་གསུམ་པ་ཨོའི་ཡི་གེ་སྟེ་དེས་ཡང་དག་པར་མནན་པ་ནི་ཀུན་དུ་བཞག་པ་སྟེ་ཡིག་གེ་རྣམས་བསྡུས་པ་བྷྱོ་ཡིག་ཏུ་འགྱུར་རོ།",
    "དང་པོར་རྣམ་པར་སྣང་མཛད་དང་མཐར་སྭཱ་ཧཱ་སྦྱིན་པར་བྱའོ།",
    "བདུད་རྩི་འཁྱིལ་པ་ཉེ་བར་བསྟན་པ་གསུངས་པའི་འགྲེལ་པ།",
    "ད་ནི་ལས་ཀྱི་རིགས་དང་འབྲེལ་བའི་ལས་སྣ་ཚོགས་ཀྱི་སྒྲུབ་ཐམས་ཅད་བཅོམ་ལྡན་འདས་བདུད་རྩི་འཁྱིལ་བ་ཉེ་བར་བསྟན་པ་གསུངས་པ།",
    "སྒོ་སྐྱོང་ཡང་དག་ལྡན་ཞེས་བྱ་བ་ནི་སྒོ་སྐྱོང་བ་རྡོ་རྗེ་ལྕགས་ཀྱུ་ལ་སོགས་པར་རྣམ་པར་ཤེས་པར་བྱའོ།",
    "སླར་ཡང་རྣམ་པར་སྣང་མཛད་ཞེས་བྱ་བ་ནི་འདིའི་སྔགས་སུ་འགྱུར་རོ།",
    "རྣམ་པར་སྣང་མཛད་ཨོཾ་ཡིག་དང་པོར་བྱིན་ནས་སོ།",
    "ཚིག་རྫོགས་པར་བྱ་ཞེས་པ་ནི་སྔགས་བདུན་པོ་ཡོངས་སུ་རྫོགས་པར་བྱའོ།",
    "སླར་ཡང་སྟོང་པ་ཞེས་བྱ་བ་ནི་ཐིག་ལེར་བརྗོད་པར་བྱའོ།",
    "དེ་ཡང་བསྒྲུབ་པར་བྱ་སྟེ།",
    "སྒྲུབ་པ་པོ་རྣམས་ཀྱིས་རྣལ་འབྱོར་དང་རྗེས་སུ་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་ཆེན་པོ་དུ་མའི་ཚུལ་གྱིས་ཐབ་པ་དང་ཤེས་རབ་ཀྱི་བདེ་བའི་ཡེ་ཤེས་དར་བས་བསྒྲུབ་པར་བྱ་སྟེ་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་སོ།",
    "རོ་ལངས་ཀྱི་སྒྲུབ་ཐབས་བསྟན་པ་གསུངས་པའི་འགྲེལ་པ།",
    "ཡན་ལག་མ་ཉམས་མ་གལ་ཏེ་རྙེད་ན་དེའི་ཚེ་སྒྲུབ་པ་བཙམ་པར་བྱའོ།",
    "དེ་དག་མེད་ན་མའམ་དང་པོའི་མ་མ་ཡིན་པ་བགེགས་ནས་ཤི་བ་དེ་ཡང་སྒྲུབ་པར་བྱེད་ནུས་སོ།",
    "སློབ་དཔོན་རང་ཉིད་ཧེ་རུ་ཀའི་ལྷའི་རྣལ་འབྱོར་བྱས་ཏེ་རྩ་བའི་སྔགས་ལ་འཇུག་པ་ལྷུར་བླང་ངོ།",
    "ཕྱི་རོལ་ཏུ་ཡང་ལོགས་བཞི་དང་གྲྭ་བཞི་དང་སྒོ་བཞི་དང་དྲི་བུ་དང་དར་དཔྱངས་དང་བ་དན་ལ་སོགས་པ་དང་རྔ་ཡབ་དང་དོ་ཤལ་དང་དོ་ཤལ་ཕྱེད་པ་དང་ཟླ་བ་ཕྱེད་པས་ཉེ་བར་བརྒྱན་པ་དགོད་པར་བྱའོ།",
    "ཕྲག་པར་ཁ་ཊྭཱཾ་ག་བཀལ་ནས་ཕྱག་གཡོན་པས་ཐོད་པ་འཛིན་པ།",
