    "སྟན་ལས་ལངས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་སོང་ངོ།",
    "དགེ་སློང་གི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཅིང་།",
    "ཐོས་ནས་ཀྱང་མཉན་ཡོད་ནས་བྱུང་ནས་བཅོམ་ལྡན་འདས་གང་ན་བདེར་སོང་སྟེ་ཕྱིན་ནས།",
    "མོ་གཡས་པའི་ལྷ་ང་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་སོང་ངོ།",
    "འཕགས་པ་ཁྱོད་ཅིའི་ཕྱིར་སྐྱ་བོ་བསེང་བསེང་པོར་གྱུར་ཅིང་རིད་པ་དང་།",
    "འཕགས་པ་ཁྱོད་རྒྱུན་ཤེས་ཀྱི་བུས་དཔྱད་མ་བགྱིས་སམ་ལྷ་མ་བགྱིས་སོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་དགེ་སློང་འདིའི་དཔྱད་བྱས་ན་དེ་ལྟ་ན་ལེགས།",
    "མི་གཟིགས་པའམ།",
    "གང་དག་འོག་ཏུ་སོང་བ་དེ་དག་ནི་ཡང་སོས་དང་།",
    "པད་མ་ལྟར་གས་པ་ཆེན་པོ་རྣམས་སུ་ཡང་སོང་སྟེ།",
    "གང་དག་སྟེང་དུ་སོང་བ་དེ་དག་ནི་རྒྱལ་ཆེན་བཞིའི་རིས་དང་།",
    "འོག་མིན་གྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་སོང་ནས་མི་རྟག་པ་དང་།",
    "དེ་ནས་འོད་ཟེར་དེ་དགགིས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོ་འཇིག་རྟེན་གྱི་ཁམས་རྣམས་བྱུལ་ནས་བཅོམ་ལྡན་འདས་ཉིད་ཀྱི་རྗེས་བཞིན་རྗེས་བཞིན་དུ་འགྲོའོ།",
    "མིར་སྐྱེ་བར་ལུང་སྟོན་པར་བཞེད་ན་ནི་ཞབས་ཀྱི་པུས་མོར་ནུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ཀྱི་མཐིལ་དུ་ནུབ་བོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ནས་ཞུས་པ།",
    "ཁ་དོག་སྣ་ཚོགས་སྟོང་གིས་བཀྲ་བ་ཡི།",
    "དམ་པ་བཟང་པོ་དག་གིས་བསལ་དུ་གསོལ།",
    "དེས་དེ་བཞིན་གཤེགས་པ་མང་པོས་བཀུར་བའི་གདུང་རྒྱུད་ནས་བཟུང་སྟེ་སྤྱོད་པ་སྐྱོན་མི་མངའ་བ་ལ་བྲན་མོའ་བུ་ཞེས་སྨྲས་སོ།",
    "དགེ་སློང་གིས་གཞང་འབྲུམ་གཅོད་དམ།",
    "དེ་ནས་བློན་པོ་དག་གིས་རྒྱལ་པོ་གསལ་རྒྱལ་ལ་སྨྲས་པ།",
    "ལྷ་རྒྱུན་ཤེས་ཀྱི་བུས་ནི་བཅོམ་ལྡན་འདས་ལ་ཡང་བྲན་མོའ་བུ་ཞེས་ཚིག་ཏུ་སྨྲས་ལ།",
    "ཡུལ་གནས་བཅས་ན་གནས་པའི་ལྷ་རྣམས་ཀྱིས་སྐྱེས་བུ་གཏི་མུག་གང་གི་ཕྱིར་ཁྱོད་ཁམས་གསུམ་གྱི་མགོན་པོ་ལ་དྲན་མོའ་བུའོ་ཞེས་ཚིག་ཏུ་སྨྲས་པ།",
    "ཁྱོད་འདིར་གནས་སུ་ག་ལ་རུང་ཞེས་མང་དུ་སྤྱོས་ནས་བསྐྲད་དོ།",
    "དེ་ནས་བཱ་རཱ་ཎ་སཱིར་སོང་ངོ།",
    "དེ་ནས་ཀྱང་བསྐྲད་ནས་ཡངས་པ་ཅན་དུ་སོང་ངོ།",
    "དེ་ནས་ཀྱང་བསྐྲད་ནས་ཡུལ་ཙམ་པར་སོང་ངོ།",
    "དེ་ནས་ཀྱང་བསྐྲད་ནས་རྒྱལ་པོའ་ཁབ་ཏུ་སོང་ངོ།",
    "མཚེའུ་དག་གི་འགྲམ་ཤིག་ཏུ་སོང་བ་དང་དེར་ཡང་སྐབས་མ་རྙེད་ནས་དེས་བསམ་པ།",
    "འཛམ་བུའི་གླིང་འདི་ན་རེ་ཞིག་ཝ་དག་གིས་ཀྱང་སྐབས་རྙེད་ན།",
    "བདག་གིས་སྐབས་ཤིང་དྲུང་དང་།",
    "དེ་ལ་གང་གིས་ན་ཁྲག་དྲོན་པོ་སྐྱུགས་ནས་དུས་ལས་འདས་པ་དེ་ལྟ་བུའི་ཀུན་ནས་དཀྲིས་པ་སྐྱེས་སོ།",
    "ཁ་ནས་སྟ་རེའི་ཚིག་འབྱུང་སྟེ།",
    "དེ་ནི་ཁ་ཡི་ཉེས་པས་གང་གིས་ན།",
    "འདིར་ནི་བརྒྱན་པོས་རང་གི་ནོར་ཡལ་བ།",
    "འཕགས་ལ་གནོད་བྱེད་ལུས་དང་ངག་གིས་ལས།",
    "དེ་ནས་བདག་གིས་བགྱིས་ཏེ་བསྒྲལ་བ་ལགས་སོ།",
    "བདག་གིས་མཚམས་ཀྱི་ནང་དུའོ།",
    "ཀུན་དགའ་བོ་མཚམས་ཀྱི་ནང་ཡང་རུང་མཚམས་ཀྱི་ཕྱི་རོལ་ཡང་རུང་སྟེ་དགེ་སློང་གིས་བཙོས་པ་ནི་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ལོངས་སྤྱད་པར་མི་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་བཙོས་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ལོངས་སྤྱད་པར་མི་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་ཡོད་པད་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "དེ་ནས་ཁྱིམ་བདག་དེ་སྟན་ལས་ལངས་ཏེ་བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ།",
    "གནས་མལ་ལ་གཟིགས་པར་བཞེད་པ་དང་།",
    "ངས་རྗེས་སུ་མ་གནང་བ་གང་ཡིན་པ་ཡང་ཁྱོད་ཀྱིས་ཤེས་སོ།",
    "དགེ་སློང་གིས་མཚོས་པ་བྱིན་ལེན་བྱོས་ལ་བཙོས་ཏེ་ལོངས་སྤྱད་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་མ་ཚོས་པ་བྱིན་ལེན་བྱོས་ལ་བཙོས་ཏེ་ལོངས་སྤྱད་པར་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "འོ་མ་ལ་སོགས་པའི་རྫས་ཀྱི་ཁུ་བ་རྣམས་གང་གི་ཚེ་ལན་གཉིས་ལན་གསུམ་དུ་བསྐོལ་བར་གྱུར་པ་དེའི་ཚེ་བྱིན་ལེན་བྱས་ཏེ་བསྐོལ་ནས་སྤྱད་པར་བྱ་སྟེ།",
    "དེའི་མངག་གཞུག་བྱེད་པའི་བུ་མོ་ཞིག་ཡོད་པ་དེས་བསམས་པ།",
    "བདག་གི་ཇོ་བོས་ཐབས་བརྒྱ་སྟོང་དུ་མས་ལོངས་སྤྱོད་རྣམས་བསགས་ན།",
    "ཇོ་བོ་ཁྱོད་ཀྱིས་ཁྱིམ་བདག་འབྱོར་པ་མཁྱེན་ཏམ།",
    "ཆུང་མ་དང་བུ་དག་གིས་ཀྱང་ཡལ་བར་བོར་རོ་ཞེས་ཁྱོད་ཉིད་ཟེར་ན།",
    "དེ་ནས་དེས་བདག་རང་གི་རྒྱགས་ལས་ཀྱང་ཅུང་ཟད་སྦྱར།",
