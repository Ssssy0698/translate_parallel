    "དེ་དག་གིས་གང་པོ་ལ་ཕོ་ཉ་བཏང་སྟེ་ཚོང་པའི་ཚོགས་འབོད་དོ་ཞེས་བྱས་སོ།",
    "དེ་ནས་ཚོང་པའི་ཚོགས་ཐམས་ཅད་འདུས་ཏེ་དེའི་ཁྱིམ་དུ་སོང་ནས་སྒོར་བསྡད་དེ་དེ་ལ་ཕྲིན་བཏང་ནས་གང་པོ་ཚོང་པའི་ཚོགས་སྒོ་ན་སྡོད་ཀྱིས་བྱུང་ཞིག་ཅེས་སྤྲིང་ངོ།",
    "གལ་ཏེ་ཇི་ལྟར་ཉོས་པ་བཞིན་ཟོང་བྱིན་ན་ཁོ་བོ་ཚོང་པ་ཆེན་པོ་ཡིན་མོད།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "གྲུ་བཙས་མེད་པར་རྒྱ་མཚོ་ཆེན་པོར་འཇུག་པར་སྤྲོ་བ་དེ་དག་གིས་རྒྱ་མཚོ་ཆེན་པོར་འདོང་བའི་ཟོང་སྟ་གོན་བྱོས་ཤིག།",
    "དེ་ལྟ་བུར་ལན་དྲུག་གི་བར་དུ་རྒྱ་མཚོ་ཆེན་པོར་ཞུགས་པ་ལས་གྲུ་བོ་ཆེ་གྲུབ་ནས་སླར་འཁོར་ཏོ།",
    "ཕྱོགས་ཀུན་དུ་གང་པོས་ལན་དྲུག་གི་བར་དུ་རྒྱ་མཚོ་ཆེན་པོར་ཞུགས་པ་ལས་གྲུ་བོ་ཆེ་གྲུབ་ནས་སླར་འཁོར་ཏོ་ཞེས་སྒྲ་གྲགས་པ་དང་།",
    "ཤེས་ལྡན་དག་ལན་དྲུག་གི་བར་དུ་རྒྱ་མཚོ་ཆེན་པོ་ནས་གྲུ་བོ་ཆེ་གྲུབ་སྟེ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "བདག་ལ་ནི་ནོར་གྱིས་ཅུང་ཟད་ཀྱང་མི་ཆོག་པ་མེད་ན་འདི་དག་གིས་དོན་དུ་འགྲོ་བར་བྱའོ་སྙམ་ནས།",
    "ཁྱོད་ཀྱི་དོན་དུ་ཚོང་པ་དང་།",
    "དེད་དཔོན་གང་གིས་བུ་མོ་བསླང་བ་ཕུ་བོ་ལ་སྨྲོས་ཤིག།",
    "ཁྱོད་ལ་རིགས་པས་བསྒྲུབ་པའི་ནོར་ཕལ་པོ་ཆེ་ཡོད་ལ་ཁྱོད་ཀྱི་ནུ་བོ་དག་ལ་རིགས་པ་མ་ཡིན་པས་བསྒྲུབས་པ་ཡིན་པས་གལ་ཏེ་དེ་དག་ན་རེ་ལྷན་ཅིག་འཁོད་པར་བྱའོ་ཞེས་ཟེར་ན་འདུག་པར་མི་བྱའོ་ཞེས་སྨྲས་ནས་རིམ་གྲོ་པ་གཅིག་ཁྲིད་དེ་མཉན་ཡོད་དུ་སོང་སྟེ།",
    "མཉན་ཡོད་ཀྱི་སྐྱེད་མོས་ཚལ་དུ་འདུག་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་ལ་ཕྲིན་པ་བཏང་སྟེ།",
    "ཁྱིམ་བདག་དེད་དཔོན་གང་པོ་ཁྱིམ་བདག་བལྟ་བར་འདོད་ནས་སྐྱེད་མོས་ཚལ་ན་སྡོད་དོ་ཞེས་སྤྲིང་བ་དང་།",
    "ད་ནི་ཐང་གི་བཞོན་པས་འོངས་སོ་སྙམ་མོ།",
    "གང་བདག་གིས་སྐྱེས་བུ་དམ་པ་དེ་ལ་བཀུར་སྟིར་མ་བྱས་པར་ཁྱིམ་དུ་བོང་པ་ནི་བདག་རིགས་པ་དང་ལྡན་པ་མ་ཡིན་ནོ་སྙམ་ནས།",
    "དེ་ལ་ནི་ད་སྐྱེས་བུ་གཙོ་བོ་འདི་ལྟ་བུ་ཡང་རང་གི་སྐྱེ་བོ་དང་གཉེན་བཤེས་ཀྱི་ཚོགས་རྒྱ་ཆེན་པོ་དང་།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་དེད་དཔོན་གང་པོ་ཁྲིད་དེ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་སྐྱེས་དང་ཆས་ཏེ་འོང་བ་གཟིགས་སོ།",
    "གཟིགས་ནས་ཀྱང་དགེ་སློང་རྣམས་ལ་བཀའ་སྩལ་པ།",
    "དགེ་སློང་ཚུར་ཤོག་ཚངས་པར་སྤྱད་པ་སྤྱོད་ཅིག་ཅེས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་མོད་ཁོ་ནར་དེ་སྐྲ་བྱི་བ་དང་།",
    "དེ་ནས་དུས་གཞན་ཞིག་ན་ཚེ་དང་ལྡན་པ་གང་པོ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "གང་པོ་མིག་གིས་རྣམ་པར་ཤེས་པར་བྱ་བའི་གཟུགས་སྡུག་པ་དང་།",
    "ལུས་ཀྱིས་རྣམ་པར་ཤེས་པར་བྱ་བའི་རེག་བྱ་དང་།",
    "དེ་དག་གལ་ཏེ་དགེ་སློང་གིས་ཤེས་ནས་ཞེས་བྱ་བ་ནས།",
    "གང་པོ་མིག་གིས་རྣམ་པར་ཤེས་པ་བྱ་བའི་གཟུགས་སྡུག་པ་དང་།",
    "ལུས་ཀྱིས་རྣམ་པར་ཤེས་པར་བྱ་བའི་རེག་བྱ་དང་།",
    "དེ་དག་གལ་ཏེ་དགེ་སློང་གིས་ཤེས་ནས་ཞེས་བྱ་བ་ནས།",
    "གང་པོ་གལ་ཏེ་ཁྱོད་ལ་གྲོ་བཞིན་སྐྱེས་གནས་པའི་མཐའི་མི་རྣམས་མངོན་སུམ་དུ།",
    "དེ་ལ་ཁྱོད་ཇི་སྙམ་བྱེད།",
    "འཕྱ་བ་རབ་གྱིད་ན་དེ་ལ་བདག་གིས་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "འཕྱ་བར་བྱེད་ཀྱང་ལག་པའམ་བོང་པས་མ་བརྒྱབ་སྙམ་མོ།",
    "གང་པོ་གལ་ཏེ་གྲོ་བཞིན་སྐྱེས་གནས་པའི་མཐའི་མི་རྣམས་ཀྱིས་དབྱུག་པའམ་མཚོན་གྱིས་བརྒྱབ་ན་དེ་ལ་ཁྱོད་ཇི་སྙམ་བྱེད།",
    "དེ་ལ་བདག་གིས་འདི་སྙམ་སེམས་ཏེ།",
    "དེ་དག་བདག་ལ་དབྱུག་པའམ་མཚོན་གྱིས་བརྒྱབ་ཀྱང་ཐམས་ཅད་ཀྱིས་ཐམས་ཅད་དུ་སྲོག་དང་བྲལ་བར་མི་བྱེད་དོ་སྙམ་མོ།",
    "གནས་བའི་མཐའི་མི་རྣམས་ཀྱིས་ཁྱོད་ཐམས་ཅད་ཀྱིས་ཐམས་ཅད་དུ་སྲོག་དང་འབྲལ་བར་བྱེད་ན་དེ་ལ་ཁྱོད་ཇི་སྙམ་བྱེད།",
    "དེ་དག་བདག་གི་ལུས་རྣག་ཅན་འདི་ལས་ཚེགས་ཆུང་དུས་གྲོལ་བར་བྱེད་དོ་སྙམ་བསམ་པར་བགྱིའོ།",
    "གང་པོ་ཁྱོད་བཟོད་པ་དང་དེས་པ་འདི་དང་ལྡན་པར་གྲོ་བཞིན་སྐྱེས་གནས་པའི་ཡུལ་གྱི་མཐའ་གནས་པར་ནུས་པ་ནི་ཁྱོད་ཡང་ལེགས་སོ།",
    "གང་པོ་སོང་ལ་མ་བསྒྲལ་བ་རྣམས་ནི་སྒྲོལ་ཅིག།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ནས་སོང་ངོ།",
    "དགེ་སྦྱོང་མགོ་རེག་འདི་མཐོང་བ་ནི་ཁ་རྗེ་མ་རུང་བར་བྱས་སོ་སྙམ་དུ་བསམས་ནས་གཞུ་རྣ་དྲུང་དུ་བཀང་སྟེ།",
    "གང་གི་དོན་དུ་མཁའ་ལ་བྱ་རྒྱུ་རི་དགས་རྙིས་ཟིན་གྱུར།",
    "བཀྲེན་པ་ཉོན་མོངས་ཡུལ་ངན་རྒྱུ་ཞིང་མཆིལ་པས་ཉ་ཟིན་པ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་ཤིང་གི་རྣ་ཆ་ཅན་གྱི་ནུ་བོ་གཉིས་ལོངས་སྤྱོད་སྲབས་ཤིང་ཡོངས་སུ་ཟད་པས་གཏུགས་པར་གྱུར་ནས་དེ་གཉིས་ཀྱིས་སྨྲས་པ།",
    "གང་པོ་ཡིན་མོད།",
    "ཁྱེད་ཅག་གི་ནོར་ནི་རིགས་པར་བསྒྲུབས་པ་མ་ཡིན་ལ།",
    "བྲན་མོའ་བུ་དེས་རྒྱ་མཚོ་ཆེན་པོར་ཡང་སོང་ཡང་སོང་ནས་ཁྱོད་ཀྱི་ལོངས་སྤྱོད་དག་བསྒྲུབས་པས་ཁྱོད་དེ་ལ་སྤྱོད་པས་རྒྱགས་སུ་ཟད།",
