    "བཀོད་མའི་ཆུ་དང་འདྲབར་གདུལ་བྱ་རྣམས་ཀྱིས་འབྲས་བུ་ཐོབ་པར་བྱེད་པ་ལ་ཟད་པ་མེདདོ།",
    "སྤྲིན་ལྟ་བུར་དགའ་ལྡན་ལསོགས་པར་སྤྲུལཔས་དོན་སྟོན་པར་མཛད་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པ་གཞན་དུ་འདོད།",
    "འཇུག་པར་བྱ་བ་ནི་རབ་ཏུའཇུག་པར་བྱབའོ་ཞེས་སློབ་པ་སྒྲུབ་པ་ལ་འདོམས་པའོ།",
    "གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་འདི་ཉིད་ནི་དེ་བཞིན་ཉིད་ཀྱི་ངོ་བོཉིད་ཡིན་པས་དོན་དམ་པར་སྐྱེ་བ་མེད་པའི་ངོ་བོར་རང་བཞིནགཅིག་པའི་ཕྱིར་དབྱེར་མེད་དོ།",
    "རྣམཔ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དོ།",
    "དམིགས་པར་བྱ་བ་དང་དམིགས་པར་བྱེད་པ་མཉམ་པ།",
    "ཉིད་དུ་ཤེས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་ལ་སོགས་པ་དང་།",
    "དེ་ལ་དམིགས་པར་བྱེད་པའི་སེམསདག་ནི་སྣང་བ་མེད་པ་ཙམ་ཉིད་དུ་ཤེས་པའོ།",
    "རྣམ་པར་བྱང་བ་དང་གཟུགས་ལ་སོགས་པའིརྣམ་པ་དེས།",
    "རློམ་པམེད་པ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་ཚོར་བ་མེད་པའིཕྱིར་རོ།",
    "མ་མཐོང་བའི་ཡོན་ཏནམཐོང་བའི་ཐབས་ཉིད་ཡིན་པའི་ཕྱིར་མཐོང་བའི་ལམ་ཞེས་བྱསྟེ།",
    "ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་ནི་གཟུགས་ལ་སོགསཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་མི་རྟག་སོགས་པར་མིགནས།",
    "སྡུགབསྔལ་ལ་སོགས་པར་ཞེན་པ་མེད་པའོ།",
    "ཤེསརབ་ཀྱིས་ནི་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པ་རྣམ་པར་དཔྱོདཔའི་རྒྱུ་སྟེ་ཤེས་པའི་ཁྱད་པར་རོ།",
    "ཐམས་ཅད་དམིགས་སུམེད་པར་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "རབཏུ་བྱེད་པའི་དོན་ནི་ཆུང་ངུའི་དམིགས་པ་ནི་ཞེས་བྱ་བ་ལསོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "བཟོད་པར་རྟོགས་པ་ཆུང་ངུའི་ནིགཟུགས་ལ་སོགས་པའི་མཚན་ཉིད་གཟུགས་སུ་རུང་བ་དང་ཉམས་སུམྱོང་བ་ལ་སོགས་པའོ།",
    "འདི་དགནི་དེ་ཁོ་ན་ཉིད་དུ་ན་སྟོང་པ་ཉིད་ཡིན་པས་ངོ་བོ་ཉིད་མེདཔར་རང་བཞིན་གཅིག་པ་ཉིད་ཀྱིས་ན་གཟུགས་ལ་སོགས་པ་ནི་གཟུགསལ་སོགས་པའི་མཚན་ཉིད་དང་ས་ལ་སོགས་པ་དེའི་མཚན་ཉིདདང་ངོ་བོ་ཉིད་མེད་པ་ཉིདཡིན་ནོ།",
    "འདིར་ངེས་པརའབྱེད་པའི་ཆ་དང་མཐུན་པའི་གནས་སྐབས་སུ་རྣམ་པ་ཐམས་ཅདདུ་དག་པ་སྟེ་མེད་པས་ཅུང་ཟད་ཙམ་གྱིས་དག་པ་ཡིན་པར་བལྟབར་བྱའོ།",
    "རང་བཞིན་ཁོ་ན་གཟུགས་ལ་སོགས་པའི་མཚནམ་རྣམས་ཀྱི་རྟེན་དང་བྲལ་བ་ཉིད་ཀྱིས་ན་གཟུགས་ལ་སོགས་པའིརྟེན་མེད་པ་ཡིད་ལ་བྱེད་པ་སྟེ་ཀུན་རྫོབ་ཏུ་གཟུགས་ལ་སོགས་པཡོད་པར་མངོནཔར་ཞེན་པའོ།",
    "ཁྱདཔར་གཞན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "ཁྱད་པརགཞན་ནི་རིས་མིམཐུན་པའོ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པར་ཡོད་པ་ཡིན་ནོ་ཞེས་བྱ་བརདགོངསསོ།",
    "རྣམ་པར་རྟོག་པ་བཞི་ནི་གཞིདང་ཞེས་བྱ་བ་ལསོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "གཟུང་བར་རྣམ་པར་རྟོག་པ་ནི་གཉིསཏེ།",
    "ཚིག་ལེའུར་བྱས་པའི་དོན་ནི་གཟུང་བར་ཞེས་བྱ་བ་ལསོགས་པ་ཡིན་ཏེ།",
    "མ་རིག་པ་དང་རྣམ་པར་བྱང་བའི་ཕུང་པོ་ལ་སོགས་པའི་རབཏུ་དབྱེ་བས་ཞེས་བྱ་བ་ནི་མ་རིག་པ་ལ་སོགས་པའི་རབ་ཏུ་དབྱེབ་དང་།",
    "འཛིན་པའི་རྣམ་པརརྟོག་པ་གཉིས་ནི་བདག་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིནཏེ།",
    "ཞེས་བྱ་བ་ནི་གངཟག་དང་སྐྱེས་བུ་ལ་གནས་པ་འཛིན་པ་རྣམ་པ་གཉིས་སུ་འདོདཅེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་བྱང་བ་ནིམྱ་ངན་ལས་འདས་པའོ།",
    "རྣམཔར་དག་པ་བསྐྱེད་པ་ལ་སོགས་པ་ནི་འཁོར་གསུམ་རྣམ་པར་དག་པམ་སྐྱེད་པ་སྟེ།",
    "དེ་ལ་གཟུང་བའི་བདག་ཉིད་ཅན་གྱི་རྣམ་པར་རྟོགཔ་གང་ཡིན་པ་དེའི་གཉེན་པོའི་ཕྱོགས་ཀྱི་ལམ་ལ་གནས་པའོ།",
    "དེལ་གཟུང་བའི་བདག་ཉིད་ཅན་གྱི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པནི་དེ་དག་གོ།",
    "དེ་ལྟར་བྱས་ན་གཟུང་བའི་རྣམ་པར་རྟོག་པ་དངཔོ་གང་ཡིན་པ་གཉིས་པ་ཡང་དེ་ཡིན་ནོ།",
    "འདི་ལྟར་གཟུང་པའིརྣམ་པར་རྟོག་པ་གཉིས་པ་ནི་རྣམ་པར་བྱང་བ་ཙམ་ལ་བརྟེནཔ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ད་ནི་འཛིན་པའི་རྣམ་པར་རྟོག་པ་ནི་འཛིན་པར་ཞེས་བྱབ་ལ་སོགས་པ་སྨོས་པ་ཡིནཏེ།",
    "དོན་བྱས་པ་ནི་བྱ་བ་བྱས་པ་ཉིད་དོ།",
    "འཛིན་པའི་རྣམ་པར་རྟོག་པ་དགུཔོ་འདི་དག་གང་ཡིན་པ་དེས་བསྡུས་པ་ཡིན་ནོ།",
    "རྟག་པར་འཛིནཔའི་རྣམ་པར་རྟོག་པ་སྐྱེས་བུ་བཏགས་པར་ཡོད་པའི་རྟེན་ཅནཕུང་པོ་ནི་གཟུགས་ལ་སོགས་པའོ།",
    "རྣམ་པར་བྱང་བ་ནི་མྱ་ངན་ལས་འདས།",
    "དེ་རྣམས་དང་འཛིན་པའི་བདགཉིད་ཅན་གྱི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པ་འདི་རྣམས་ནི་བྱངཆུབ་སེམས་དཔའ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་གཞིའིདྲོ་བལ་སོགས་པ་བཞི་དང་གྲངས་ཇི་ལྟ་བ་བཞིན་དུ་ལྡན་པ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་མཐའ་ཡས་པ་ཡིན་ན་ཡང་མིམཐུན་པའི་ཕྱོགས་ཡིན་པའི་ཕྱིར་ལམ་དུ་གཏོགས་པ་ཁོ་ནའི་རྣམཔར་རྟོག་པ་བསྟནགྱི་དེ་ལས་གཞན་པ་ནི་ཅི་ཡང་མི་བྱེད་པ་ཉིད་ཀྱིས་ན་སྤངབར་བྱ་བ་མ་ཡིན་ཞིང་བླང་བར་བྱ་བ་མ་ཡིན་པས་ཉེས་པམེད་དོ།",
    "ཚིགས་སུ་བཅད་པ་སྦྱར་བ་དང་མཐུན་པར་ཞེས་བྱ་བནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའིརིམ་གྱིས་ཡོངས་སུ་འཛིན་པ་སྔརགསུངས་ནས་ཡང་མཇུག་ཐོགས་སུ་བར་སྐབས་ཀྱི་ཚིགས་སུ་བཅད་པགསུངས་སོ་ཞེས་བྱ་བར་སྦྱར་བའོ།",
    "བཅོམ་ལྡན་འདས་ཉིད་ལམ་དེསྟོན་པར་མཛད་པ་ཡིན་ནོ་ཞེས་ཐོསཔ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་དག་ཡོངས་སུ་གཏུགས་པ་ནི་དེའི་རྣམ་པར་རྟོག་པ་ཟདཔའོ།",
    "ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སོགས་པ་ནིགཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པའོ།",
    "ཡང་དག་པར་གནས་པ་ནི་སྨོན་པའིསེམས་དང་ཉམས་སུ་ལེན་པའི་སེམས་ཀྱི་མཐར་ཐུག་པའི་སེམས་སོ།",
    "དེ་ནིརྣམ་པ་དགུའོ་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "ནང་དང་ཞེས་བྱ་བ་ལསོགས་པ་ནང་དང་ཕྱི་རོལ་ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་ནས་བདེབླག་ཏུ་རྟོགས་པར་བྱ་བའི་ཕྱིརབྲྗོད་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ཁམས་གསུམཔ་ནི་འདུསབྱས་སྟོང་པ་ཉིད་དོ།",
    "མ་སྐྱེས་པ་ལ་སོགས་པ་ནི་འདུས་མ་བྱསསྟོང་པ་ཉིད་དོ།",
    "ཞེས་བྱ་བ་ནི་འདུས་མ་བྱས་ནམ་མཁའ་ལ་སོགས་པ་ནི་དངོས་པོམེད་པའི་སྟོང་པཉིད་དོ།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟར་ན་སྟོང་པརྣམས་ཀྱི་ཁྱད་པར་རྣམ་པ་ཉི་ཤུ་ནི་སྟོང་པ་ཉིད་ཀྱི་རྣམ་པཡིན་ནོ།",
    "དེ་དག་ཀྱངབསམ་པ་ལ་སོགས་པ་བཅུ་པོ་འདི་དག་རང་བཞིན་མི་དམིགས་པ་ཡིན་པརཤེས་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་ས་རབ་ཏུ་དགའ་བ་བསྐྱེད་པར་བྱ་བ་ཡིནཔའི་ཕྱིར་རོ།",
    "དེས་ཁྱད་པར་དུ་བྱས་པའིམཚན་ཉིད་མི་དམིགས་པས་གང་ལ་ཡོངས་སུ་སྦྱང་བ་སྟེ།",
    "འདུསབྱས་པའི་ཁྱད་པར་ཁོ་ནས་བྱའི།",
    "དེ་ཉིད་ནི་ཡང་དག་པར་སྡོམ་པསྟེ།",
    "དེ་བཞིན་དུ་སེམསཅནགྱི་འཁོར་གསུམ་རྣམ་པར་དག་པ་ཉིད་དོ།",
    "དེ་དང་འགལ་བར་བྲྗོད་པའི་ནི་གངདུ་འདོད་པར་ཞིང་གཞན་དུ་མཉམ་པར་འགྲོ་བའོ།",
    "ཉན་ཐོས་ལ་སོགས་པའི་རིགས་དང་ཞེས་བྱ་བ་ལ་སོགསཔ་བདེ་བླག་ཏུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་རིགས་དང་བརྒྱད་པ་དངཞེས་བྱ་བ་ལ་སོགས་པ་དངསྦྱར་བར་བྱ་སྟེ།",
    "དགྲ་བཅོམ་པ་ནིབྱས་པ་རྟོགས་པའི་སའོ།",
    "ཉན་ཐོས་ཀྱི་རིགས་ལ་སོགས་པའི་ཤེས་པའིཁྱད་པར་རྣམས་སོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གཞན་དག་ནི་ཚུལ་ཤེས་པརྣམས་ཀྱིས་གོ་སླའོ།",
    "རྣམ་པཐམས་ཅད་མཁྱེན་པ་ཉིད་རྟོགས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་ལམ་ཤེས་པ་ཉིད་གསུངས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་སྨིན་པའི་འོད་ནི་ལས་ལསསྐྱེས་པའོ།",
    "སྡུག་བསྔལ་གྱི་རྣམ་པ་བདེན་པའི་ཞེས་བྱབ་ནི་མི་རྟག་པ་དང་སྡུག་བསྔལ་བ་དང་སྟོང་པ་དང་བདག་མེདཔ་ཞི་བའི་རྣམ་པ་བཞི་དང་གོ་རིམས་བཞིན་དུ་བྲྗོད་པར་བྱའོཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "སྡུགབསྔལ་བ་ཉིད་མི་རྟག་པ་ཡིན་པར་མཚུངས་སུ་ཟིན་ན་ཡང་ཟག་པདང་བཅས་པ་ཉིད་ནི་མི་མཐུན་པ་ཉིད་ཡིན་གྱི་འཕགས་པའི་ལམགྱི་ནི་མ་ཡིན་ཏེ།",
    "ཟག་པ་མེད་པ་ཉིད་ཀྱིས་ན་འཕགས་པ་རྣམས་དང་རྗེས་སུ་མཐུན་པཉིད་ཡིན་པར་བལྟའོ།",
    "འབྲསདང་ཟུག་རྔུ་ནི་གྲགས་པར་ཟད་དོ།",
    "སྡུག་བསྔལབ་དང་ཞེསབྱ་བ་ལ་སོགས་པར་རྗེས་སུ་སྦྱར་བར་བྱའོ།",
    "རྒྱུ་ལམི་ལྟོསཔར་རང་བཞིན་གྱིས་འཇིག་པ་ཉིད་ཡིན་པས་ན་རབ་ཏུ་འཇིག་པའོ།",
    "འགོག་པའི་ཞེསབྱ་བ་ལ་སོགས་པས་ནི་རྣམ་པ་གཞན་དག་གསུངས་པ་ཡིན་ཏེ།",
    "སེམསཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་པར་བྱེད་པ་ཉིད་ཀྱིས་ན་སྒྲུབ་པ་ཉིདདོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལསོགས་པསནི་ངེས་པར་འབྱེད་པའི་ཞེས་བྱ་བ་ཚིག་ལེའུར་བྱས་པའི་དོན་སྟོནཔ་ཡིན་ཏེ།",
    "དོན་ལྔ་དང་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་དངཉམས་སུ་མྱོང་བ་ལ་སོགས་པ་ནི་དེས་སྟོང་པ་ཉིད་ཡིན་པའི་ཕྱིརདེ་རྣམས་ཀྱི་སྟོངཔ་ཉིད་ནི་གཟུགས་ལ་སོགས་པའི་སྟོང་པ་ཉིད་སྣ་ཚོགས་པ་ཕནཚུན་ཐ་དད་པ་མེད་པ་ནི་གཅིག་ཡིན་ནོ།",
    "གཟུང་བའི་རྟོག་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལེའུར་བྱས་པའིདོན་ནི་གཟུང་བ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "ཡུལ་ཡིན་པ་དེ་ལ་གངརྣམ་པར་རྟོག་པ་སྟེ།",
    "འཛིན་པའི་ཡུལ་གྱི་རྣམ་པར་རྟོག་པ་ནི་མ་སྤངས་པ་སྟེ།",
    "རྣམ་པ་ཇིལྟ་བུར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣམ་པ་བཅུ་དྲུག་གསུངས་པཡིན་ནོ།",
    "ཤེས་པ་དང་རྣམ་པར་སྦྱར་བནིཤེས་པའི་རྣམ་པ་གཞན་དུ་མི་འཐད་པས་རྣམ་པ་འདི་དག་ཉིདཀྱང་བདེན་པ་རྣམས་ཁོ་ནའི་ཡིན་པར་བལྟ་བར་བྱའོ་ཞེས་ཟེར་རོ།",
    "མཐོང་བའི་ལམ་འདིའི་ཡང་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུནཔ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་གསུངས་པ་གཟུང་བརབྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ནི་རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་ཡིན་ནོ་ཞེས་བྲྗོད་པས།",
    "ཅེས་བྱ་བ་ལ་སོགསཔའི་ཚིག་ལེའུར་བྱས་པ་རྣམས་དང་སྦྱར་བར་བལྟའོ།",
    "སྡུག་བསྔལ་གྱི་ཕུང་པོ་ལ་སོགས་པ་དངོས་པོ་ལ་དམིགས་པདག་ནི་ཕན་ཚུན་འགལ་བ་ཡིན་པའི་ཕྱིར་བདག་མེད་པ་གོམས་པའགྲུབ་པར་མི་འགྱུར་བ་མ་ཡིན་ནམ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལེའུར་བྱས་པའི་དོན་ནི་རངདང་གཞན་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "རབ་ཀྱི་མཐར་ཐུག་པ་མེད་པརསློབ་པའི་དུས་སུ་མངོན་སུམ་དུ་བྱ་བ་ནི་སུ་ལ་ཡང་ཡོད་པ་མ་ཡིནནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "སྔོནགྱི་སློབ་དཔོན་རྣམས་ཀྱིས་ཆུང་དུ་དང་འབྲིང་ལ་སོགས་པའི་བདགཉིད་ཅན་འདི་ནི་གཉེན་པོ་ཉིད་ཡིན་པས་མི་མཐུན་པའི་ཕྱོགས་ཆེནཔོའི་ཆེན་པོ་ལསོགས་པ་རྣམ་པ་ཉི་ཤུ་རྩ་བདུན་ཡང་དོན་གྱིས་ཤེས་པར་བྱའོཞེས་འཆད་དོ།",
    "ཐབས་གཅིག་ཏུབཞུགས་སོ་ཞེས་གསུངས་པས།",
    "སྦྱིན་པར་བྱ་བ་ལ་སོགས་པ་མི་དམིགས་པས་མཚན་མམེད་པའོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་དང་མཚན་མ་ནིསྦྱིན་པར་བྱ་བ་ལ་སོགས་པ་འཚང་རྒྱ་བའི་རྒྱུ་ཉིད་དོ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་སྐབས་ཡིན་པས་རྣམ་པར་དགཔ་སྤྱིར་ཡིན་ཏེ།",
    "ཅེས་བྱ་བའི་ཚུལ་གྱིས་དེ་ལྟར་ཐོབ་པ་དངཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིནཏེ་འབྲས་བུ་དག་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལེ་འུར་བྱསཔའི་དོན་ནི་འཕགས་པའི་གང་ཟག་ཅེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "དེ་དང་བྲལ་བ་ཉིདཀྱིས་རྣམ་པར་དག་པ་སྟེ་དྲི་མ་མེད་པའོ།",
    "གང་གཟུགས་ལ་སོགས་པའི་རྣམ་པར་དག་པ་སྟེ་གཟུང་བ་ལ་སོགས་པམེད་པས་གཟུགས་ལ་སོགས་པའི་སྟོང་པ་ཉིད་དོ།",
    "རྒྱུན་ཏུཞུགས་པ་ལ་སོགས་པའི་སྔ་མ་བཞིན་དུ་རྣམ་པར་དག་པ་གང་ཡིནཔ་དང་།",
    "དོནམཚུངས་པ་ཡིན་ན་ཡང་ཁྱད་པར་གྱི་སྒོ་ནས་ཐ་དད་པའི་སྒྲརབྲྗོད་པའི་རྒྱུ་ནི་རང་དང་སྤྱིའི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོསཔ་ཡིན་ཏེ།",
    "དོན་དམ་པར་ནི་སྒྱུ་མ་ལྟ་བུའི་ངོ་བོ་ཉིད་དེ་དེ་དང་འདྲབར་ཐ་དད་པ་ཉིད་མ་ཡིན་པའི་ངོ་བོ་ཉིདཡིན་ནོ།",
    "རྣམ་པར་དག་པའི་ཁྱད་པར་ནི་རྣམཔར་དག་པ་སྤྱིར་བྲྗོད་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིནནོ།",
    "ཚུ་རོལ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལེའུར་བྱས་པརྣམ་པར་འགྲེལ་པ་ནི་དུས་གསུམ་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིནཏེ།",
    "སྐྱེ་བ་མེད་པའི་རྣམ་པར་ཏེ།",
    "ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུཕྱིན་པ་ལ་སོགས་པའི་ཚུལ་ཕྱིན་ཅི་མ་ལོག་པར་ཐོས་པ་ལ་སོགསཔས་ཤེས་པའི་ཕྱིར་རོ།",
    "སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱིས་བགྲོད་པར་བྱ་བ་མ་ཡིན་ཞིངམ་མཐོང་བ་ཉིད་ཀྱིས་མཐའ་རིང་བའི་མྱ་ངན་ལས་འདས་པ་ལམི་གནས་སོ།",
    "སྲིད་པ་དང་ཞི་བ་འདི་དག་རྣམ་གྲངས་གཞནགྱིས་བསལ་བར་བྱ་བ་ནི་གོ་རིམས་བཞིན་དུ་བདག་ལ་སོགས་པར་ལྟ་བདང་མི་ལྟ་བར་གྱུར་པ་ཉིད་ཀྱིས་སྲིད་པ་དང་མྱ་ངན་ལས་འདསཔ་ནི་རྟག་པ་དང་ཆད་པའི།",
    "ཉནཐོས་ལ་སོགས་པ་ལ་དུས་གསུམ་མཉམ་པ་ཉིད་དུ་ཤེས་པ་མེད་པའིཕྱིར་ཞེས་བྱ་བ་དུས་གསུམ་དུ་གནས་པའི་དངོས་པོ་སྐྱེ་བ་མེད་པརཤེས་པ་མེད་པས་སོ།",
    "དེ་ནི་དུས་གསུམ་གྱི་དངོས་པོ་སྐྱེ་བ་མེད་པརཤེས་པའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པར་དམིགས་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བསྟེ།",
    "ཡང་ན་ཡང་དག་པ་ཉིད་དུ་ཕྱིན་ཅི་ལོགཉིད་ཡིན་པས་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་རྣམས་དོན་དམ་པར་དངོསཔོ་ཡོད་པ་ཉིད་དང་།",
    "གཉི་ག་ལྟར་ན་ཡང་ཉན་ཐོས་ལ་སོགས་པ་དམིགས་པ་ཅན་རྣམས་ནིངེས་པར་དངོས་པོ་འགའ་ཞིག་ལ་ཀུན་ཏུ་ཆགས་པས་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་ཡོད་དུ་ཟིན་ན་ཡང་ཉམས་པ་ལ་སོགས་པ་ཡིན་ནོཞེས་བྱ་བར་དགོངས་སོ།",
    "དེའི་མཚན་བཅསཞེས་བྱ་བ་ལ་སོགས་པའི་ལན་གྱིས་ཚིག་ལེའུར་བྱས་པའི་འགྲེལ་པནི་གོ་སླའོ།",
    "སེམས་དཔའ་རྣམས་ཀྱིས་སྤང་བར་བྱ་བ་ཉིད་ཡིན་པའིཕྱིར་མི་མཐུན་པའི་ཕྱོགས་ཡིན་ནོ་ཞེས་འཕགས་པ་བྱམས་པས་མིམཐུན་པའི་ཕྱོགས་ཡིན་པར་གསུངས་སོ།",
    "གཟུགས་སོགས་ཞེས་བྱ་བ་ལསོགས་པའི་ཚིག་ལེ་འུར་བྱས་པའི་དོན་ནི་གཟུགས་ལ་སོགས་པ་ཞེས་བྱབལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱིས་ན་རངབཞིན་ཏེ་རྟོགས་པར་དཀའ་བ་ཉིད་ཡིན་ཏེ།",
    "དེ་ལྟར་མིམཐུནཔའི་ཕྱོགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྦྱོར་བ་གསུངས་པ་ཡིནཏེ།",
    "སྒྲུབ་པ་ནི་གཟུགསལ་སོགས་པ་བདག་མེད་པར་སློབ་པ་ལ་རྩོམ་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ལ་སོགས་པ་ལ་འབད་པསདེའི་བདག་ཉིད་ཅན་གྱི་ཆེད་དུ་བྱ་བ་ལ་སོགས་པས་ནི་བསྒྲུབ་པརདཀའ་བ་ཉིད་ཡིན་པས།",
    "སྐལ་བ་དང་འཚམ་པ་ལས་མི་འདའ་བར་རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་ལ་སོགས་པའི་འབྲས་བུ་འཐོབ་པ་དོན་ཡོད་པ་ཉིདཀྱིས་ན།",
    "སྐལ་བ་ཇི་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིནནོ།",
    "ཅེས་བྱ་བ་ནི་ཐམས་ཅདཀྱི་དམ་པར་འགྱུར་བས་མཆོག་གཞནམེད་པའམ།",
    "ཡང་ན་གཞནགྱི་རྐྱེན་གྱི་བདག་ཉིད་ཀྱི་སྲུང་བ་ལ་སོགས་པའི་ཕྱིར་དངོས་པོརྣམས་དངོས་པོ་མེད་པར་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ཞེསསོ།",
    "རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གྱུར་པ་ཉིད་ཡིན་པས་ན་ཡོངསསུ་འགྱུར་བའོ།",
    "འདིརྣམས་སུ་སྣང་བ་ཞེས་བྱ་བ་གང་ཡིན་པ་ནི་ཡང་དག་པར་ནརྣམ་པར་ཤེས་པ་ལ་སོགས་པ་ཡིན་པར་མི་འདོད་པསདེ་ཡོངས་སུ་གྱུར་པ་ལ་སོགས་པ་ནི་ལོག་པར་སྣང་བ་ཡིན་ནོ་ཞེསབྱ་བའི་བར་དུའོ།",
    "དེ་ལ་རྣམ་པར་ཤེས་པཡོངས་སུ་གྱུར་པ་ཉིད་ཀྱིས་ན་ཡོངས་སུ་གྱུར་པ་ཞེས་བྱ་སྟེ།",
    "གཟུགས་ལ་སོགས་པ་ལ་ཞེས་བྱ་བ་ལསོགས་པ་ཚིག་ལེའུར་བྱས་པའི་དོན་ནི་གཟུགསལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "སྦྱོར་བའི་མཉམ་པ་ཉིད་སོ་སོར་རྟོགས་ནས་ཞེས་བྱ་བ་ལ་སོགསཔ་ནིསྡུག་བསྔལ་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལེའུར་བྱསཔ་ལ་འཇུག་པ་ཡིན་ཏེ།",
    "གཟུགས་རྟག་མ་ཡིན་ཞེས་བྱབ་ལ་སོགས་པའི་བདེན་པའི་རྣམ་པའི་ཚིག་ལེའུར་བྱས་པའི་དོན་ནིངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིནཏེ།",
    "དེ་དང་བྲལ་བའི་ཕྱིརརྣམ་པར་དག་པའོ།",
    "དེ་མེད་པས་རྣམ་པར་བྱང་བ་མ་ཡིན་པའོ།",
    "སྟོང་པ་ཡིན་པའི་ཕྱིར་སྦྱིན་པརནུས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་དག་ནི་ཡང་དག་པར་ན་མེད་པ་ཡིན་པའི་ཕྱིར་དམིགས་པ་མེད་པརབྱེད་པ་སྟེ།",
    "མི་དམིགས་པར་ཤེས་པའོ།",
    "བདེ་བ་དང་གཙང་བསདབེན་པ་ཉིད་ཀྱིས་ན་གྱ་ནོམ་པ་ཡིན་ལ་དེ་མེད་པས་གྱ་ནོམ་པ་མཡིན་པའོ།",
    "དེ་དག་བྲལ་བའི་ཕྱིར་མཐའ་གཉིས་ལས་འདས་པས་རྣམཔར་དག་པ་ཞེས་བྱ་སྟེ།",
    "རྣམཔར་མི་རྟོག་པ་ཉིད་དེ།",
    "རྗེས་སུ་ཤེས་པ་གང་ཡིན་པ་ཀུན་རྫོབ་ཀྱི་བདེན་པར།",
    "དེ་ལྟར་རྒྱས་པར་བསྟན་ནས་ཞེསབྱ་བ་ལ་སོགས་པས་ནི་མངོནཔར་རྟོགས་པ་བརྒྱད་ཀྱི་མཚན་ཉིད་ཀྱི་དོན་གང་ཡིན་པ་དེ་མཐའདག་སྡུད་པར་བྱེད་པ་ཡིན་པས་གཙོ་བོ་ཡིན་པ་ཉིད་ཀྱིས་ན།",
    "བྲྗོད་པར་བྱ་སྟེ་དེ་ནི།",
    "ཉན་ཐོས་ལམ་འདིཤེས་པར་བྱ།",
    "དེ་བས་ན་མི་རྟག་པ་ལ་སོགསཔའི་རྣམ་པ་བཟློག་པའི་སྒོ་ནས་འཕངས་པའི་གཞི་མ་ལུས་པཡོངས་སུ་ཤེས་པར་བྱ་བའི་དོན་དུ་ཐམསཅད་ཤེས་པ་ཉིད་ལོགས་ཤིག་ཏུ་སྨོས་པ་ཡིན་ནོ།",
    "དེརྣམས་ཀྱི་ཡེ་ཤེས་ཀྱིརྣམ་པ་ནི་དེ་ལ་དམིགས་པར་བྱེད་པའི་སེམས་ཀྱི་ཁྱད་པར་རོ།",
    "ཀུན་མཁྱེན་པ་ཉིདནི་རྣམ་པ་ཐམས་ཅད་དང་ལམ་དང་གཞི་སྐྱེ་བ་མེད་པར་མཁྱེནཔས་ཡེ་ཤེས་ནི་རྣམ་གསུམ་ཕྱིར།",
    "ཚིག་ལེའུར་བྱས་པའི་དོན་ནི་རྟག་པ་ཞེསབྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "མི་རྟག་པ་ལ་སོགསཔ་ལ་དམིགས་པའི་ཡེ་ཤེས་ཀྱི་ཁྱད་པར་ལ་རྣམ་པ་ཉིད་དུ་རྣམཔར་གཞག་པ་ནི་རྣམ་པ་ཡིན་ནོ་ཞེས་ངེས་པར་བྱས་པའོ།",
    "དེ་དག་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་འདིས་ཐམས་ཅད་མཁྱེན་པཉིད་གསུམ་གྱི་གཞིའི་ཡུལ་ཅན་ཡིན་པ་ཉིད་ཀྱིས་ན་སྔར་སྨྲསཔའི་རྣམ་པ་རྣམས་གཞི་མེད་པའི་རྣམ་པ་ཡིན་པར་ངེས་པ་གསལ་བཡིན་ནོ།",
    "སྤྱིར་ཞེས་བྱ་བས་རྣམ་པ་རྣམས་ལ་དབྱེ་བ་མ་བྲྗོདཔར་རྣམ་པ་གསུམ་བསྟནནས་ད་ནི་ཁྱད་པར་ཏེ།",
    "བརྩི་བ་ནི་བདེན་པ་སོ་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པཡིན་ཏེ།",
    "དེ་ལཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཚིག་ལེའུར་བྱས་པའི་དོན་སྨོས་པ་ཡིནཏེ།",
    "མི་སྐྱེ་བནི་ཡང་དག་པར་སྐྱེ་བ་མེད་པའོ།",
    "དབེན་པ་ནི་ཡོན་ཏན་སྐྱེད་པརབྱེད་པ་ཉིད་ཀྱིས་ན་བདག་སྟོང་པ་ཉིད་དོ།",
    "མི་བྲྫི་བ་ནི་བདགམེད་པ་ཉིད་ཀྱིས་མུ་སྟེགས་པ་རྣམས་ཀྱིས་འཁྲུགས་པར་མི་ནུས་པསྟེ།",
    "ཡང་དག་པར་ན་མིང་དང་གཟུགསཀྱི་ཕུང་པོ་སྐྱེད་པར་བྱེད་པ་མེད་པའི་དོན་གྱིས་ན་གནས་མེདཔའོ།",
    "ཡང་དག་པར་ན་ཚིག་ཏུབྲྗོདདུ་མེད་པ་ན་བྲྗོད་དུ་མེད་པའོ།",
    "ལམདང་རིག་པ་དང་སྒྲུབ་པ་དང་ངེས་པར་འབྱིན་པའི་བདག་ཉིད་དོ།",
    "ཞེསབྱ་བ་ནི་ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་འཇོམས་པར་བྱེད་པའོ།",
    "རྣམ་པར་བྱང་བ་ནི་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "དེ་མེདཔ་ནི་རྣམ་པར་བྱང་བ་མེད་པའོ།",
    "རྣམ་པར་བྱང་བ་མ་ཡིནཔ་ནི་མྱ་ངནལས་འདས་པ་མ་ཡིན་པའོ།",
    "མི་མཐུནཔའི་ཕྱོགས་ཀྱི་བདག་ཉིད་ཅན་གྱི་རྣམ་པར་རྟོག་པ་འདི་རྣམས་ཀྱིསོ་སོར་ངེས་པའི་གཉེན་པོར་གྱུར་པ་དག་ཡིན་ནོ་ཞེས་སྨོས་ཏེ།",
    "གྲངས་བཞིན་དུ་རྣམ་པ་བརྒྱད་དང་ཞེས་བྱ་བ་ལསོགས་པར་ཁོང་དུ་ཆུད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཀུན་འབྱུང་དངལམ་དག་ལ་རྣམ་པ་བརྒྱདདང་བདུན་རྣམས་སོ།",
    "སྡུག་བསྔལ་དང་འགོག་པ་ལ་རྣམ་པ་ལྔདང་བཅུ་དྲུག་ཏུ་ཤེས་པར་བྱའོ།",
    "འདུན་པ་དང་འདོད་ཆགས་ལ་སོགསཔམི་མཐུན་པར་གྱུར་པའི་ངོ་བོ་གསུམ་དང་གསུམ་ཞེས་བྱ་བ་ནི་འདོདཆགས་དང་བྲལ་བ་ལ་སོགས་པ་དང་།",
    "ཉན་ཐོས་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པདང་མ་འདྲེས་པས་མཆོག་ཏུ་འཛིན་པ་མེད་པའོ།",
    "རྣམ་པར་རྟོག་པཐམས་ཅད་ནི་སྟོང་པ་ཉིད་ཡིན་པར་མཚུངས་པ་ཡིན་པའི་ཕྱིརརྣམ་པར་མི་རྟོག་པའོ།",
    "ཤེས་པར་བྱ་བ་མེད་པས་ན་དཔག་ཏུ་མེད་པའོ།",
    "སེམས་ཕྱིན་ཅི་མ་ལོགཔར་སྒྲུབ་པའོ།",
    "མེད་པའི་དོན་ནི་མི་རྟག་པའི་དོན་ཡིན་ནོ་ཞེསགསུངས་པའི་ཕྱིར་མེད་པས་ན་མི་རྟག་པའོ།",
    "འདུས་བྱས་ཞེས་བྱ་བ་འབུསབྱས་སྟོང་པ་ཉིད་དང་།",
    "འདུས་མ་བྱས་ཞེས་བྱ་བ་འདུས་མ་བྱསསྟོང་པ་ཉིད་དང་།",
    "འདི་རྣམས་སུ་འཁྲུལ་པ་རྣམས་ནི་གང་དེ་ཁོ་ན་ཉིདདུ་ནི་ཡང་དག་པ་མ་ཡིན་ན་ཡང་ཡང་དག་པར་རྣམ་པར་འཁྲུལཔའོ།",
    "ཡང་དག་པར་ན་ཤེས་པའི་སྣང་བ་ལས་གཞན་པའི་དུས་ཀྱང་མིའཐད་པའི་ཕྱིར་མི་དམིགས་པ་ཞེས་བྱ་བ་མི་དམིགས་པ་སྟོང་པཉིད་དེ།",
    "ཀུན་མཁྱེན་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པ་ཐམས་ཅདམཁྱེན་པའི་ཚིག་ལེའུར་བྱས་པའི་དོན་ནི་རྣམ་པ་ཐམས་ཅད་ཅེསབྱ་བ་ལ་སོགས་པ་སྨོས་པཡིན་ཏེ།",
    "དྲན་པ་ཉེར་བཞག་ནས་བཟུང་སྟེ་ཞེས་བྱབ་ནི་ལུས་དྲན་པ་ཉེ་བར་གཞག་པ་དང་པོར་བྱས་ནས་སོ།",
    "ཅིའི་ཕྱིར་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པཉིད་ཀྱིས་འཕགས་པའི་གང་ཟག་ཐམས་ཅད་བསྡུས་པ་ཡིན་ཞེ་ན།",
    "ཐམས་ཅད་མཁྱེན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཐམས་ཅདམཁྱེན་པ་ཉིད་གསུམ་དུགྲགས་པ་དེས་བསྡུས་པའི་ལམ་གང་ལ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལསོགས་པའི་ལམ་གྱི་བདེན་པ་རྣམ་པ་གསུམ་པོ་དེའི་སྒོ་ནས་ཞེས་བྱབ་དེའི་ཐབས་ཀྱིས་སོ།",
    "དེ་ལ་ཞེས་བྱབ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱིས་བསྡུས་པའི་ཐམས་ཅདམཁྱེན་པ་ཉིད་གསུམ་གྱི་ནང་ནས་སོ།",
    "ཐམས་ཅད་ཅེས་བྱ་བ་ལསོགས་པ་ལ་དངོས་པོ་ཡོངས་སུ་རྟོགས་པའི་ལམ་ལ་ཞེས་བྱ་བ་ནིལུས་ལ་སོགས་པ་རྣམ་པར་དབྱད་པའི་ཐབས་ལའོ།",
    "རྣམ་པར་དཔྱད་པ་ནིལུས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "མ་སྐྱེས་པ་དག་ཡང་དག་པར་སྤོང་བར་བྱ་བའིཕྱིར་དང་།",
    "མི་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སེམས་ལས་སུ་རུང་བ་ཉིད་དུ་བྱེད་པ་ནི་སེམས་རྩེ་གཅིག་པརགྱུར་པ་ཡིན་པས།",
    "བདེན་པ་མཐོང་བཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཡངདག་པའི་ལྟ་བ་ལ་སོགས་པ་ནི་ཡང་དག་པར་ངེས་པར་འབྱིན་པའིལམ་ཡིན་ཏེ།",
    "དེ་ནི་ལྟ་བས་བྱས་པ་ཞེས་སྨོས་ཏེ།",
    "བལྟའོ་ཞེས་བྱ་བ་ནི་བདག་ཉིད་བསམ་གཏན་ནམ་གཟུགས་མེདཔའི་སྙོམས་པར་འཇུག་པ་ལ་བརྟེན་ཏེ་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "གཞན་རྣམས་ཀྱི་སྡུག་བསྔལ་གྱི་རྒྱུད་ལས་ལྡོག་པར་འདོདཔ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "གསུམ་ལ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ལ་སོགསཔ་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་བས་ན་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "མཐར་གྱིས་པའི་སྦྱོརབ་ལ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ལ་སོགས་པ་སྔ་མབཞིན་དུ་སྦྱར་བར་བྱའོ།",
    "ངེས་འབྱེད་ཡན་ལག་ཅེས་བྱ་བལ་སོགས་པའི་ཚིག་ལེའུར་བྱས་པས་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དངམཐུན་པའི་སྦྱོར་བའི་ལམ་ལ་གནས་པ་དང་།",
    "དེ་རྣམས་ཀྱི་མཚནཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་དེ་ལ་ངེས་པར་འབྱེད་པའི་ཡན་ལགལ་གནས་པའི་གཟུགས་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་མཚནཉིད་ཀྱི་ཚིག་ལེའུར་བྱས་པའི་འགྲེལ་པ་ནི་གོ་སླའོ།",
    "ཡང་ལྡོགཔ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གཟུགས་ལ་སོགས་པས་ཞེས་བྱ་བ་ལསོགས་པས་མཚན་ཉིད་རྣམ་པ་ཉི་ཤུའི་ཚིག་ལེའུར་བྱས་པའི་དོནནི་ངོ་བོ་ཉིདམེད་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ནོ།",
    "མཐོངབའི་ལམ་ལ་གནས་པ་ཡི་ནི་ངེས་པར་འབྱེད་པའི་ཞེས་བྱ་བ་ལསོགས་པ་ཡིན་ནོ།",
    "མཐོང་བའི་ལམ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པའིཚིག་ལེའུར་བྱས་པའི་དོན་ནི་སྡུག་བསྔལ་ཞེས་བྱ་བ་ལ་སོགས་པཡིན་ནོ།",
    "ཡང་དག་པར་ན་དོན་གྱི་བྱ་བནུས་པའི་ངོ་བོ་མེད་པས་ཡུལ་མེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་གཟུགས་ལསོགས་པའིམངོན་སུམ་གྱི་ཤེས་པ་ལྡོག་པ་ཡིན་ནོ།",
    "སོགས་པའིསྒྲས་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པའོ།",
    "སྤྱོད་པའི་ཁྱད་པར་གངཡིན་པ་དེ་སོ་སོར་བཀག་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་ཤེས་པ་ཡིན་ལ།",
    "དེ་ལ་སྔ་མ་བཞིན་དུ་ཞེས་བྱ་བ་སྟོང་པ་ཉིད་ལ་གནས་པ་ཉིདཀྱི་སྦྱོར་བ་དང་རྗེས་སུ་སྦྱོར་བ་ལ་གནས་པར་མི་བྱའོ་ཞེསའདིའི་ཕྱི་མ་རྣམས་ལ་ཡང་སྒྲའི་དོན་ནི་སྔ་མ་བཞིན་ནོ།",
    "ས་བརྒྱད་པ་ལ་སོགས་པ་ལ་ཇིལྟ་བ་བཞིན་གནས་པ་ནི་ཐེ་ཚོམ་མེད་པར་དམིགས་སུ་མེད་པའི་ཡེཤེས་སུ་ངེས་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ནི་རང་བཞིན་ཡིན་པར་བྲྗོད།",
    "ཅེས་བྱ་བའི་རིགས་པས་འཚམ་པ་ཉིད་ཀྱིས་རྗེས་སུ་དཔག་པས་མཚནཉིད་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི་དེ་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས།",
    "ཐ་སྙད་ནི་རྣལ་འབྱོར་ལ་སོགསཔའི་རང་བཞིན་གྱི་རྫུ་འཕྲུལ་ལ་སོགས་པའི་འཇིག་རྟེན་དངམཐུན་པར་སྤྱོད་པ་ནི་ངེས་པ་ཡིན་ལ་བཅོས་མ་ནི་ངེས་པ་མེདཔའོ།",
    "ཚིག་ལེའུར་བྱས་པརྣམ་པར་འགྲེལ་པ་ནི་སྟོང་པ་ཉིད་ལ་སོགས་པ་སྟོང་པ་ཞེས་བྱབ་སྨོས་པ་ཡིན་ཏེ།",
    "སྟོང་པ་དང་སྟོང་པ་མ་ཡིན་པ་དག་ལ་སྟོང་པ་ཉིད་ལསོགས་པ་དང་གཟུགས་ལ་སོགས་པ་གཅིག་པར་འགལ་བའི་ཕྱིར་རོ།",
    "ངེས་འབྱེད་ཅེས་བྱ་བ་ལ་སོགས་པ་རྣམ་པར་འགྲེལ་པ་ཡིན་ཏེ།",
    "འཇལ་བ་དང་ངེས་པར་རྟོགས་པ་ཞེསབྱ་བ་ནི་ཚིག་གསུམ་ཡིན་ཏེ།",
    "གྲངས་བཞིན་དུ་འདོད་པའི་ཁམསལསོགས་པས་དགུ་དག་ཏུ་ཞེས་བྱ་བ་ནི་འདོད་པའི་ཁམས་དང་བསམགཏན་དང་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་སྟེ།",
    "ངེས་པར་འབྱེད་པའིཡནལག་ལ་སོགས་པའི་དོན་མང་པོ་ལ་དམིགས་པ་ལས་བྱུང་བའི་ཕྱིརརམ་བར་ཆད་མེད་པའི་ལམ་དུ་རྒྱུན་དུ་ཞུགས་པ་ཡིན་པའི་ཕྱིརརོ།",
    "དེ་རྣམས་བསྟན་པརྣམས་ཏེ་དེ་དང་དེར་སྨོས་པ་རྣམས་སོ།",
    "ཚིག་ཏུ་བྲྗོད་པའི་ངོ་བོ་རྣམས་ནི་དོན་དམ་པརམི་འཐད་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ཡང་དག་པར་ན་ཇི་ལྟར་གྲགསཔའི་དོན་དུ་མི་རུང་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཇི་ལྟར་ཞེ་ན་དོན་གཅིག་ཏུ་སྟེ་དོན་གྱི་དབྱེ་བ་གཞན་ལལྟོས་པ་མེད་པས་ངེས་པར་འབྱེད་པའི་ཡན་ལག་ལ་སོགས་པའི་ཡུལགཅིག་པ་ནི་དོནགཅིག་པ་ཡིན་ལ།",
    "དེ་ལ་རབ་ཏུ་སྦྱར་ཞིང་ངེས་པར་ལྡན་པའི་ལྡོགཔའི་དབྱེ་བ་གང་ཡིན་པ་དེ་ལ་ལྟོས་པས་རྒྱུ་དེ་ལས་ཉེ་བརསྐྱེད་པའི་ཐ་དད་པ་ཉིད་ཀྱི་ངོ་བོ་སྟེ།",
    "གྲངས་མེད་པ་ལ་སོགསཔ་གང་ཡིན་པ་དེས་ངེས་པར་འབྱེད་པའི་ཡན་ལག་ལ་སོགས་པའི་ཡུལགཅིག་པ་ཉིད་ལསོགས་པ་ཡིན་པར་གཅིག་ཏུ་ཞུགས་པ་ཡིན་ནོ།",
    "དབྱེ་བ་གཞན་ལ་ལྟོས་ནས་ཡང་ངེས་པར་འབྱེད་པའིཡན་ལག་ལ་སོགས་པ་དོན་སྣ་ཚོགས་པ་དང་རབ་ཏུ་སྦྱར་པའི་ལྡོགཔ་ལ་ལྟོས་པའི་ལས་ཉེ་བར་སྐྱེད་པའི་ཐ་དད་པ་ཉིད་ཀྱི་ངོབོ་བྱེ་བྲག་ཏུ་དབྱེ་བ་ཉིད་ཡིན་ནོ།",
    "བྱིས་པའི་སྐྱེ་བོ་རྣམས་ནི་མ་རིག་པས་ཁྱབ་པ་རྣམས་གཞུག་པརབྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "འབྲས་བུ་ཆེན་པོབསྐྱེད་པར་རབ་ཏུ་སྟོན་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་རྣམ་པ་ཐམསཅད་མཁྱེན་པའི་འབྲས་བུ་སྐྱེད་པར་བྲྗོད་པ་ཡིན་པས་སོ།",
    "ཉེབར་གནོད་ཕྱིར་ཡང་དག་པར།",
    "ངེས་པརའབྱེད་པའི་ཡན་ལག་ལ་སོགས་པའི་ལམ་དང་།",
    "ངོ་བོ་ཉིད་མེད་པ་ཉིད་ཀྱིས་ཡང་དག་པརན་དེ་ཉིད་དང་།",
    "གཉིག་མ་ཡིན་པར་བྲྗོད་དུ་མེད་པ་ལ་ཐོས་པ་ལ་སོགས་པ་མི་ནུས་པ་ནིཅི།",
    "ཡང་དག་པར་ན་གཉིས་སུམེད་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཅན་ནོ།",
    "ཐོས་པ་ལ་སོགས་པརནུས་པ་ཉིད་ཡིན་ཞིང་།",
    "དོན་དམ་པར་ནི་དེ་ལྟར་མ་ཡིན་ཏེ་ཞེསབྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "གལ་ཏེམ་ཐོས་པར་ཡངསྒོམ་འཇུག་འགྱུར་ན་བསྟེན་པ་དོན་མེད་འགྱུར།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྣམ་འགྲེལམཛད་པས་ཀྱང་རྣམ་པར་རྟོག་པ་གཉིས་པོ་དུས་གཅིག་མིན།",
    "རྒྱུ་དེ་བས་ན་ཁྱད་པར་ཅན་ཏེ།",
    "མར་མེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགལེའུར་བྱས་པ་རྣམ་པར་འགྲེལ་པ་ནི་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགསཔ་སྨོས་པ་ཡིན་ཏེ།",
    "རྟག་ཏུ་ཡོད་པའམ་མེད་པར་འགྱུར།",
    "ཡང་ན་སྐད་ཅིག་མདང་པོ་ལ་མ་ལྟོས་པར་སྐདཅིག་མ་གཉིས་པ་སྐྱེ་ན་རྟག་ཏུ་ཡོད་པས་ན་རྒྱུའི་སྐད་ཅིག་མ་མཞིག་པས་སོ།",
    "དེ་མེདཔར་ཡང་དེ་ཡོད་ན།",
    "དེ་ལ་ཉེ་བར་སྦྱོརབ་ནི་དེའི་རྒྱུ་ཉིད་དུ་ཤེས་པར་བྱེད་པ་ནི་སྟོན་པའོ།",
    "དེས་ན་དབེན་པ་ནི་ལྷག་པར་ཁྱད་པརདུ་འཕགས་པ་སྟེ།",
    "ཁམས་གསུམ་པ་ཁྱད་པར་དུ་བྱས་པའི་སྣང་བཉིད་ཀྱིས་ན་ལྷག་པའི་སེམས་ཀྱི་ཁྱད་པར་ཏེ།",
    "རང་བཞིན་མེད་པ་གོམས་བྱས་པས།",
    "རྣམ་པར་གཞག་པ་འཁྲུག་པ་མེད།",
    "གཟུགསམེད་པའི་སྙོམས་པར་འཇུག་པ་བཅུ་སྟེ།",
    "ལྷའིརིས་ཐམས་ཅད་དུ་ཉེ་བར་འགྲོ་བ་ནི་ལྷ་ལ་སོགས་པ་བསྡུས་པརརྟོགས་པར་གཞན་གྱི་དོན་གྱི་ཕྱིར་འགྲོའོ།",
    "དེ་དང་མཚུངས་པར་གནས་པ་ནིབྱ་བ་དེ་ཉིད་ཉམས་སུ་ལེན་པའོ།",
    "ཡང་དག་པར་རྫོགས་པའི་བྱངཆུབ་ནི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་སོ།",
    "ཚིག་ལེའུར་བྱས་པ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "དེ་ལྟར་ངེས་པས་གཏན་ལ་ཕབ་པའིཞེས་བྱ་བ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་བསྒྲུབ་པས་རྫོགས་པརགྱུར་པ་ནི་བསྟན་པར་འགྱུར་བ་སྟེ།",
    "སེམས་ཀུན་ཏུ་གནས་པ་ནི་གླིང་བཞི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངསཔ་ཡིན་ཏེ།",
    "ཚིག་ལེའུར་བྱསཔ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "དེ་ཕ་རོལཏུ་ཕྱིན་པ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་སྦྱིན་པ་ལསོགས་པརྣམས་སོ།",
    "རྟགས་དངརྣམ་པར་འཕེལ་བ་དང་།",
    "དེ་ནི་རྟགས་ལ་སོགས་པར་ཞེས་བྱ་བལ་སོགས་པ་སྨོས་པ་ཡིན་ནོ།",
    "འཇུག་པ་དང་ནི་ཞེས་བྱ་བ་ལ་སོགསཔའི་ཚིག་ལེའུར་བྱས་པའི་དོན་ནི་འཇུག་པ་དང་ནི་ཞེས་བྱ་བ་ལསོགས་པས་རྣམ་པར་འགྲེལ་པ་ཡིན་ཏེ།",
    "དམིགས་པར་བྱ་བ་དག་གོ།",
    "དེ་ལྟར་ན་གཟུང་བའི་རྣམ་པར་རྟོག་པཁོ་ན་བཟུང་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གོ་རིམས་བཞིན་དུ་སོ་སོའི་སྐྱེ་བོ་དང་ཉནཐོས་ལ་སོགས་པའི་སྐྱེས་བུ་རྫས་དང་བཏགས་པར་ཡོད་པ་དེ་དག་ནིཡང་དག་པ་དང་ཐ་སྙད་ཉིད་དུ་བཏགས་པ་ཡིན་ལ།",
    "དེ་ལྟར་ན་འཛིན་པའིརྣམ་པར་རྟོག་པདག་ནི་རྣམ་པར་རྟོག་པ་ཉིད་འཛིན་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐཚིག་གོ།",
    "རྒྱུ་ཉིད་ཡིན་པར་ཤེས་པར་བྱ།",
    "ངོ་བོ་ཉིད་དང་ཞེས་བྱ་བ་ལ་སོགསཔ་གཟུང་བའི་རྣམ་པར་རྟོག་པ་དང་པོའི་ཚིག་ལེའུར་བྱས་པ་རྣམཔར་འགྲེལ་པ་ནི་དབེན་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "སྣང་བརྙན་ཙམ་དུ་ཟད་པས་ཞེསབྱ་བ་རྣམ་པར་རིག་པ་ཙམ་དུ་ཟད་པས་འཁྲུལ་པ་མེད་པའི་ཤེསཔ་ནི་གཉིས་སུ་མེད་པའི་ཤེས་པ་དམིགས་པར་བྱ་བ་ལ་སོགས་པ་ནིདམིགས་པ་དེ་ལ་དམིགས་པའོ།",
    "དྲི་མ་ཐམས་ཅད་ནི་རྣམཔ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱི་ལམ་གྱི་གཟུང་བ་ལ་སོགསཔའི་རྣམ་པར་རྟོག།",
    "མཐོང་བའི་ལམ་གྱི་སྦྱོར་བའི་གནས་སྐབས་ནི་མཐོང་བའི་ལམགྱི་བསམ་གཏན་གྱི་ཁྱད་པར་གང་ཡིན་པ་སྟེ།",
    "སྲིད་དང་ཞེས་བྱ་བ་ལ་སོགས་པགཟུངབའི་རྣམ་པར་རྟོག་པ་ལྡོག་པའི་ཚིག་ལེའུར་བྱས་པའི་རྣམ་པརའགྲེལ་པ་ནི།",
    "དེ་ལྟར་ན་རྟོགས་པ་དམན་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པརསྦྱར་བར་བྱ་སྟེ།",
    "དེ་རྣམས་ཀྱི་གཉེན་པོ་མ་ཡིན་པཉིད་ཀྱིས་འཇོམསཔར་མི་ནུས་པ་ཉིད་ཡིན་ཞིང་།",
    "འབྲས་བུ་དང་པོ་ལ་སོགས་པརྟོགས་པ་སྟེ།",
    "མ་རིག་པའི་བག་ལ་ཉལཐམས་ཅད་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཀྱི་བག་ཆགས་ཏེ།",
    "པར་བྱེད་པ་ཉིད་ཀྱི་རྒྱུ་ཡིན་པས་རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་དེ།",
    "ཐམས་ཅད་མཁྱེན་པ་གསུམ་པ་ཉིད་ཀྱིས་སངསརྒྱས་ལ་སོགས་པའི་མྱ་ངན་ལས་འདས་པ་ཐམས་ཅད་ཀྱི་མྱ་ངནལས་འདས་པ་གང་ཡིན་པ་དེའི་འོག་ཏུ་གང་འཇུག་ཏུ་འགྲོ་ཞིང་རྗེསསུའབྲང་བ་དེ་ལ་དྲང་བའི་ལམ་མེད་པས་ཡོན་པོའི་ལམ་གྱིས་འགྲོ་བནི་འདིར་ཉེས་པ་ཡིན་ནོ།",
    "དེ་རྣམས་ཀྱི་འཇུག་པའི་གནས་སྐབས་ནི་གཟུང་བལ་སོགས་པ་མི་མཐུན་པའི་ཕྱོགས་ཉིད་ཡིན་པས་རྒྱུན་གྱིས་འབྱུངབའིཁྱད་པར་དེས་སྤང་བར་བྱའོ།",
    "འཛིན་པ་དང་ཞེས་བྱ་བ་ལསོགས་པ་སྐྱེས་བུ་རྫས་སུ་ཡོད་པའི་ཚིག་ལེའུར་བྱས་པ་རྣམ་པརའགྲེལ་པ་ནི།",
    "རྫས་སུ་ཡོད་པ་མེད་པས་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་པའིཕྱིར་རོ།",
    "དེས་ནཐམས་ཅད་མཁྱེན་པ་གསུམ་གྱི་ལམ་ནི་གཉེན་པོ་ཡིན་ནོ།",
    "ཆེད་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་འཛིན་པའི་རྣམཔར་རྟོག་པ་སྐྱེས་བུ་བཏགས་པར་ཡོད་པའི་ཚིག་ལེའུར་བྱས་པའིརྣམ་པར་འགྲེལ་པ་ནི།",
    "ཞེས་བྱ་བ་བདག་ཉིད་ཀྱིས་ངེས་པའིལམ་མེད་པས་ལམ་གཞན་ལ་ལམ་མ་ཡིན་པར་ངེས་པར་འཛིན་པ་སྟེ།",
    "མི་དམིགས་པ་ལ་དམིགས་པའི་ཐམས་ཅད་མཁྱེན་པ་གསུམ་ལསཐ་དད་པའི་ལམ་ལ་ལམ་མ་ཡིན་པ་ཁོ་ནའོ་ཞེས་བྱ་བར་ངེས་པརའཛིན་པའོ།",
    "བར་ཆད་མེད་པ་དང་ཅིག་ཤོས་སུསྣང་བ་ཉིད་ཀྱིས་ཞེས་བྱ་བདོན་དམ་པ་ཉིད་དང་ཀུན་རྫོབ་ཏུ་དབྱེ་བ་མེད་པར་རྟོགས་པསདངོས་པོ་མཐའ་དག་སྟེ།",
    "དབྱེ་བ་མེད་པར་རྟོགས་པ་དང་མི་ལྡན་པ་སྟེ།",
    "དབྱེ་བ་གང་ཡིནཔ་དེ་ལ་ཐ་དད་པ་མེད་པར་ཤེས་པ་སྔོན་དུ་འགྲོ་བས་དབྱེ་བཤེས་པའོ་ཞེས་བྱ་བའི་ཐཚིག་གོ།",
    "བཏགས་པའི་དངོསཔོ་སྐྱེས་བུ་ཡོད་པར་བཏགས་པའོ།",
    "གཉེན་པོ་མ་བསྟན་དུ་ཟིན་ཀྱང་འདིར་མི་མཐུན་པའིཕྱོགས་སྨོས་པསཤུགས་ཀྱིས་འཕངས་པར་ལྟའོ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་ན་ཞེས་བྱབ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "འདིར་གཟུང་བའི་རྣམ་པར་རྟོག་པ་ཡིན་ལ་འཛིན་པའི་རྣམ་པརརྟོག་པ་མ་ཡིན་པ་ནི་མུ་བཞི་སྟེ།",
    "དེ་ལ་མུ་དང་པོ་ནི་གང་གཟུངབའི་རྣམ་པའི་ཡུལ་རྟོགཔའི་རྣམ་པར་ཤེས་པའོ།",
    "གཉེནཔོ་ཡང་དག་པར་སྒྲུབ་པའི་དུས་ཀྱི་རིགས་སོ།",
    "རིགས་ཉིད་ཡིན་ལརིགས་ཀྱི་རྣམ་པར་རྟོག་པས་གྱུར་པ་མ་ཡིན་པ་ནི།",
    "འདི་ལྟ་སྟེཡང་དག་པར་སྒྲུབ་པརགྱུར་པའི་རིགས་སོ།",
    "ཡང་དག་པར་སྒྲུབ་པར་གྱུར་པའི་ཡང་དག་པའི་དམིགསཔ་ལ་རབ་ཏུ་སྦྱོར་བའོ།",
    "དམིགས་པའི་རྣམ་པར་རྟོག་པ་ཉིད་ཡངདག་པར་སྒྲུབ་པའི་རྣམ་པར་རྟོག་པ་མ་ཡིན་པར་གྱུར་པ་ནི་འདིལྟ་སྟེ་དམིགས་པ་ཡོངས་སུ་མ་རྫོགས་པའོ།",
    "ཕྱོགས་འདིས་ལྷག་མརྣམསདཔག་པར་བྱའོ།",
    "གོ་རིམས་བཞིན་དུ་ཤེས་པརབྱ།",
    "ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ལ་མགཏོགས་པར་ནི་དེ་དང་བྲལ་བ་སྟེ།",
    "རྒྱུ་དང་འབྲས་བུ་ནི་གྲགས་པརཟད་དོ།",
    "ཡང་དག་པརན་སྐྱེ་བ་མེད་པར་ཤེས་པའོ།",
    "རྣམ་པར་རྟོགཅེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པའི་རིགས་ནི་རྣམཔར་རྟོག།",
    "ཡང་ནརྣམ་པར་རྟོག་པའི་ངོ་བོ་སྐྱེ་མེད་རྣམ་པ་ཅི་ཞིག་འཐོབ།",
    "དེ་ལྡོག་པས་ཀྱང་དེ་ལས་བྱུང་བའི་རྣམཔར་རྟོག་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ཇི་ལྟར་ལྡོག་སྟེ།",
    "དེ་དང་བྲལ་བ་དེ་ནི་དོན་དམ་པར་ཞེས་བྱ་བ་ལ་སོགསཔ་སྨོས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ལ་སོགས་པ་ཟད་ཅིང་འགོག་པར་སྟོན་པགཞན་གྱིས་བྲྗོད་པ་གང་ཡིན་པ་དེ་ནི་འདིར་ཕན་ཚུན་འགལ་བ་ཡིནཔའི་ཕྱིར་ཁོབོས་མཚར་དུ་རྩིས་ཏེ།",
    "བསྟན་པས་འཇུག་པའི་སྒོ་ནས་ཚིགལེའུར་བྱས་པ་ལས་མ་སྨོས་པའི་དོན་གྱི་ཤུགས་ཀྱིས་འཕངས་པབསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཡོད་པར་རིགས་ལ།",
    "དེའི་འོག་ཏུ་དེ་ཡང་རྣམ་པ་མེདཔའི་ཤེས་པ་ནི་ཡུལ་ལ་འཛིན་པར་མི་རིགས་སོ།",
    "ཞེས་སྨོས་པས་གཟུང་བའི་རྣམ་པའི་མཚན་ཉིད་ཀྱང་སེམས་ཙམཉིད་ཡིན་པས་མདུན་དུ་རྣམ་པ་བརྟག་པ་ཡང་སེམས་ཙམ་ཉིད་ཀྱིསརིགས་པ་མ་ཡིནཔས་དེ་ཡང་འཛིན་པའི་རྣམ་པའི་མཚན་ཉིད་ཀྱི་རྣམ་པར་རིགཔ་ཙམ་དེ་ཡང་རྣམ་པར་བསལ་ཞིང་དོར་ཏེ།",
    "གཟུང་བ་ལ་སོགས་པ་སྟོངཔ་ངེས་པར་འབྱེད་པའི་ཆའི་རྣམ་པར་ཤེས་པ་ཙམ་འབའ་ཞིགབདག་ལ་སོགས་པའི་འཛིན་པ་དང་བྲལ་བ་འམ།",
    "དེ་ཁོ་ན་ཉིད་དུ་ནཡོད་པའི་ངོ་བོ་སྟེ་གཉིསསུ་མེད་པའི་ངོ་བོ་ཉིད་ཀྱིས་རང་རིག་པར་འགྱུར་པ་ཉིད་ཀྱིསཡོད་ཅིང་གནས་པ་ཡིན་ནོ་སྙམ་དུ་དེ་ལྟར་ངེས་པར་བྱས་ནསདེའི་འོག་ཏུ།",
    "རངརིག་པ་ཉིད་ཡིན་པ་ཉིད་ཀྱིས་ན་བསྙོནཔར་མི་ནུས་པ་ཡིན་ན་ཡང་རྒྱུ་དང་འབྲས་བུའི་ངོ་བོར་མིའཐད་པས་རང་ཉིད་ཀྱིས་སྟོང་པ་ཡིན་ཞིང་ཡང་དག་པར་ཏེ།",
    "ཤིན་ཏུ་དངོསཔོ་དང་དངོས་པོ་མེད་པ་ལ་སོགས་པར་བརྟགས་པའི་ངོ་བོ་དངབྲལ་བ་ཞེས་བྱ་བ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་གཉི་ག་དང་གཉི་ག་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པའིངོ་བོ་མེད་ཅིང་སྤངས་པ་ཡིན་ནོ་སྙོམ་དུ་བསྒོམས་ཏེ།",
    "རྣམ་པར་མི་རྟོག་པ་ཞེས་བྱ་བ་ནི་འདོདཆགས་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པས་སྟོང་པ་ཉིད་ཀྱིས་ན་མརིག་པ་དང་བྲལ་བའོ།",
    "ཡངདག་པར་སྐྱེས་ན་སྤོང་ངོ་ཞེས་འོག་མ་དང་སྦྱར་རོ།",
    "ད་ནིལྡོག་པའི་སྒོ་ནས་ཚིག་ལེའུར་བྱས་པ་ལས་མ་སྨོས་པའི་དོན་གྱིསའཕགས་པ་ནི་དེ་ལྟ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པཡིན་ཏེ།",
    "རྟག་པ་ཉིད་ཀྱིས་དོན་དམ་པར་ངོ་བོཉིད་དེ་ལྟ་བུར་ཡོད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "འཛིན་པའི་ཤེས་པའི་བདག་ཉིད་ལ་སོགས་པའི་ངོ་བོས་སྟོང་པརྣམས་དང་ཤེས་བྱའི་མཚན་ཉིད་རྣམས་ཏེ།",
    "དེའི་རྒྱུ་གཟུགས་ལསོགས་པ་གཟུང་བའི་བདག་ཉིད་རྣམས་གལ་ཏེ་དོན་དམ་པར་བཅོས་མམ་ཡིན་པའིདོན་གྱིས་ཡོད་པ་ཉིད་དུ་གྱུར་ན་དེའི་ཚེ་ཅུང་ཟད་ཀྱང་མིབྱེད་དོ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "ཕུལ་དུ་བྱུང་བའི་བྱེད་པ་མེད་པ་ན་ཁྱད་པར་ཅི་ཞིགཡོད་དེ།",
    "ཚིག་ལེའུར་བྱས་པ་ལས་སྨོས་པའི་དོན་ནིདེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "ཁོ་བོས་ཏིང་ངེ་འཛིན་མངོན་སུམ་དུབྱས་པས་ཡ་མཚན་དུ་རྩིས་ཏེ།",
    "རྣམ་པར་དག་པའི་རྒྱུལས་ནི།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་འབྱུང་།",
    "བདག་མེད་པའི་གྲུབ་པའི་མཐའ་བརྟན་པོར་མཛདཅིང་ངེས་པར་བྱས་ནས།",
    "ངེས་པ་གྲུབ་པའི་མཐའ་བར་སྐབས་ཀྱི་ཚིགས་སུབཅད་པས་གསུངས་པ་ནི།",
    "བསྣན་པར་བྱ་བ་ཅུང་ཟད་མེད་ཅེས་བྱབས་ནི་ཕྱི་རོལ་པའི་མུ་སྟེགས་པ་རྣམས་ཀྱིས་བདག་ལ་སོགས་པསྒྲོ་བཏགས་པ་གང་ཡིན་པདེས་བསྟན་པར་མི་བྱ་སྟེ།",
    "མེད་པར་ལྟ་བབསལ་བ་ནི་ཡང་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ཡིན་ཏེ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་གྲགས་པའི་གཟུགས་ལ་སོགས་པ་བལྟ་བར་བྱཞིང་ཤེས་པར་བྱའོ།",
    "ཡང་དག་མཐོངན་རྣམ་པར་གྲོལ།",
    "ཚིག་ལེའུར་བྱས་པ་འདི་ཉིད་ཀྱི་དོན་ནི།",
    "བདག་མེད་པ་ལ་གནོད་པ་བྱེད་པའིདོན་དམ་པར་ཡོད་པ་ལ་སོགས་པ་སྒྲོ་འདོགས་པའི་ངོ་བོ་སྟེ།",
    "ཡང་དག་པའི་ཡེ་ཤེསཐོབ་པར་འགྱུར་རོ།",
    "ནམ་མཁས་བྱས་པའིམདུད་པ་འདི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གངགསུངས་པ་ཡིན་ནོ།",
    "སྦྱིན་པ་ལ་སོགས་པཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་འགྲེལ་པ་ཡིན་ཏེ།",
    "ཤིན་ཏུ་མང་བས་མ་བསླབས་པས་དེ་ལྟར་སྲིད་པའི་ཕྱིརཡང་དག་པར་རྣམ་པ་སུམ་ཅུ་རྩ་དྲུག་ཉིད་ཡིན་ན་ཡང་སྦྱིནཔ་ལ་སོགས་པ་ཚོགས་པའི་ཡུལ་གྱིསྐད་ཅིག་མ་གཅིག་ལ་བཟོད་པ་གཅིག་ནི།",
    "མ་རིག་པ་དང་འདུ་བྱེད་དང་རྣམཔར་ཤེས་པ་དང་མིང་དང་གཟུགས་དང་།",
    "དེ་ཡང་མཐོང་བ་ཞེས་བྱབ་ལ་སོགསཔས་སེང་གེ་རྣམ་པར་བསྒྱིངས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རབཏུ་བྱེད་པའི་རྣམ་པར་འགྲེལ་པ་ནི་བསལ་ཏེ།",
    "སེང་གེ་རྣམ་པརབསྒྱིངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཡིན་པར་ཤེས་པརབྱའོ།",
    "ཐོབ་པར་བྱ་ཕྱིར་ཡོངས་རྒྱུག་པའི།",
    "རྣམ་པར་ཤེས་པ་མཉམ་པར་མ་བཞག་པ་ནི་རྣམ་པར་རྟོག་པའིཤེས་པའོ།",
    "མཚམས་བཟུང་སྟེ་ཞེས་བྱ་བ་ནི་འདོད་པའི་ཁམསཔའི་སྐྱེ་བོ་རྣམས་ལས་འཚང་རྒྱ་བ་ཉིད་ཡིན་པའི་ཕྱིར་ཉེབར་བཟུང་ཞིང་རྣམ་པར་གཞག་པས་འགོག་པ་དང་བཅས་པའིསྙོམས་འཇུག་དགུ་ཞེས་གོངམ་དང་སྦྱར་རོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པབཞི་སྟེ།",
    "དེས་ན་དོན་ནི་འདིཡིན་ཏེ་ཐ་མ་འགོག་པ་ནས་བརྩམས་ཏེ་ལུགས་ལས་བཟློག་པ་བསམགཏན་དང་པོའི་བར་དུ་འོངས་ནས་ཡང་སྙོམས་པར་འཇུག་པ་དགུཕོ་དེ་དག་ཉིད་ཀྱི་ནང་ནས་རྣམ་པ་གཉིས་སུ་སྟེ།",
    "རྣམ་པར་ཤེས་པདང་།",
    "བསམ་གཏན་དང་པོའི་བར་དུ་ལུགས་དང་མི་མཐུན་པརའོངས་ཏེ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རིས་མི་མཐུནཔར་གསུམ་པར་འགྲོ།",
    "ལོག་པར་རྟོགས་པ་རྣམས་ཀུནརྫོབ་ཡིན་པའོ།",
    "རྣམ་པ་ཐམསཅད་མཁྱེན་པ་ཉིད་ཀྱི་རྟེན་ཅན་ཞེསབྱ་བ་འཚང་རྒྱ་བ་ཉིད་ལ་བརྟེན་པའོ།",
    "ལོག་པར་རྟོགས་པརྣམ་པ་བཅུ་དྲུག་གོ་ཞེས་བྱ་བ་དམིགས་པ།",
    "དེ་ལསགཞན་པའི་རྒོལ་བ་བྱེད་པར་འདོད་པའི་མཁས་པ་ཆེན་པོ་རྣམསདང་།",
    "དོན་དམ་པར་རྒོལ་བ་ལ་ནི་ཀུན་རྫོབཀྱི་ཐབས་ཀྱིས་ལན་གདབ་པའོ།",
    "དེ་ལ་ཀུན་རྫོབཏུ་གཟུགས་ལ་སོགས་པ་ལ་ཡོད་པས་ན་དམིགས་པ་ཡིན་ལ་དེའི་ངོ་བོཉིད་ངེས་པར་བཟུང་བ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེསཡིན་ནོ།",
    "ལམ་རྣམ་པར་བསྒོམས་པས་ཀྱང་འབྲས་བུ་མངོན་སུམ་དུ་མི་བྱེདཅེས་བྱ་བ་ནི་ཀུན་རྫོབ་ཀྱིས་ཏེ།",
    "རྟོགས་པའི་དོན་རྣམས་ནི་བསྒོམསཔས་ཡུལ་དུ་བྱས་པའི་ཡུལ་ལོ།",
    "གོ་རིམས་སུ་བཀླགས་པ་ནི་རིམ་གྱིསདྲན་པ་ལ་ཡང་དག་པར་བཞག་པའོ།",
    "བསྟན་པར་བྱ་བའི་ཕྱིརཞེསབྱ་བ་ནི་ལྷུན་གྱིས་གྲུབ་པ་དྲན་པ་ལ་འཇུག་པར་བྱ་བའི་ཕྱིརརོ།",
    "ནང་དུ་ངེས་པར་དམིགས་པར་བྱེད་པས་སོ།",
    "ཅེས་བྱ་བ་དེ་ནི་གོ་རིམས་ཀྱི་སྦྱིན་པ་གྲུབ་པ་ཡིན་པརཤེས་པར་བྱའོ།",
    "འཁོར་གསུམ་རྣམ་པར་དག་པས་རབ་ཏུཕྱེ་བ་ནི་སྦྱིན་པར་བྱ་བ་ལ་སོགས་པ་གསུམ་པོ་ཉེ་བར་མི་དམིགསཔ་ལསབྱུང་བའི་སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོགང་ཡིན་པ་དེ་རྣམ་པ་ཐམས་ཅད་དུ་སྟེ།",
    "གང་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པསྨོས་པ་དེར་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་ཤེས་པར་བྱ་སྟེ།",
    "ཅི་ཞིག་རྫོགས་པར་བྱེད་པས་ཤེ་ན།",
    "དེ་ནི་ས་བཅུཡང་དག་པར་བྱེད་པ་ཞེས་བྱ་བ་སྨོས་པ་ཡིན་ནོ།",
    "དེས་གང་དུ་ཡང་བྱེ་བྲག་ཏུའབྱེད་པར་མི་བྱེད་དོ།",
    "དེ་ནི་དོན་དམ་པར་ཞེས་སྨོས་པ་ཡིན་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དག་གོ།",
    "ངན་འགྲོ་ཐམས་ཅད་འཇིག་པར་བྱེད་པ་ཉིད་ཀྱིས་ན་དགའ་བ་སྐྱེདཔར་བྱེད་པགང་ཅི་ཡང་རུང་བ་དེ་ཐམས་ཅད་འདི་ཉིད་ཀྱི་ཁོངས་སུ་གཏོགསཔ་ཡིན་ནོ།",
    "སྐད་ཅིག་མ་དཔག་ཏུ་མེད་པས་རྣམ་པརབསྒོམས་པ་རྣམས་ཤིན་ཏུ་མང་དུ་གོམས་པའི་ཕྱིར།",
    "སྐད་ཅིག་མ་གཅིགཔར་གྱུར་པའི་སྦྱོར་བའི་ཡེ་ཤེས་ཀྱི་ཁྱད་པར་རོ།",
    "ཐོག་མ་ནི་རྣམ་པར་སྨིན་པ་མ་ཡིན་པ་སྟེ།",
    "ལམ་ནིསྦྱིན་པ་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཚིག་ལེའུར་བྱས་པ་དང་འགྲེལ་པ་ནི་གོ་སླའོ།",
    "དངོས་པོ་སོ་སོརངེས་པར་འཛིན་པ་ནི་ཤེས་པ་གང་ལ་སྦྱིན་པར་བྱ་བ་ལ་སོགསཔའི་ཡུལ་ལ་དམིགས་པའོ།",
    "སྐད་ཅིག་མ་གཅིག་པར་གྱུར་པའི་ཡེ་ཤེས་སོ།",
    "ཞེས་བྱ་བ་དེའི་ཚེསྦྱིན་པ་ལ་སོགས་པ་སྐད་ཅིག་མ་གཅིག་པར་གྱུར་པའི་ཡེ་ཤེས་ནིཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་ནོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཚིག་ལེའུར་བྱས་པ་འདི་ཉིད་ཀྱི་དོན་ནི།",
    "སྦྱིན་པ་ལ་སོགསཔའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་སྒྲུབ་པ་ཞེས་བྱ་བ་སྦྱིན་པ་ལསོགས་པ་ཉམས་སུ་ལེན་པས་སྦྱིན་པ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་སྦྱིནཔར་བྱ་བ་ལ་སོགས་པ་གང་ཡིན་པ་དེ་ལ་བདག་མེད་པར་ངེས་པརརྟོགས་པ་ནི་ངེས་པར་བརྟགས་པ་སྟེ།",
    "རྨི་ལམ་ན་ནིཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགལེ་འུར་བྱས་པ་དང་འགྲེལ་པ་ནི་གོ་སླའོ།",
    "དེ་ཡང་ངོ་བོ་ཉིད་ཀྱི་སྐུ་ལ་སོགས་པའིདབྱེ་བས་རྣམ་པ་བཞི་ཡིན་པས་ཞེས་བྱ་བ་ཡང་དག་པར་ན་གཅིགཡིན་དུ་ཟིན་ཀྱན།",
    "ཐུབ་པའི་ངོ་བོ་ཞེས་བྱ་བ་ལ་སོགསཔའི་ཚིག་ལེའུར་བྱས་པའི་དོན་ནི།",
    "ཡང་དག་པར་སྤང་བ་ལ་སོགས་པ་ལའོ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་རྣམ་པར་དག་པ་ནི་ཕྱིདང་ནང་དྲི་མ་མེད་པའོ།",
    "འདིར་ཐོས་པ་མེད་པས་ཀུན་རྫོབ་ཀྱི་ཡུལདུ་བྱས་པ་ཡིན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པསྨོས་ཏེ།",
    "འདིར་ནི་སྒྱུམའི་སྐྱེས་བུ་ལྟར་སྤྱད་པར་བྱའོ།",
    "ཞེས་སྨོས་པས་ཡང་དག་པརན་ཡུལ་དང་ཡུལ་ཅན་མེད་པའི་ཕྱིར་ལམ་གྱི་ཡུལ་ཉིད་མ་ཡིན་ནོ།"
  ]
}