    "ཡང་ཡང་བསྙད་པས་རྒྱལ་པོ་ཡིད་གཉིས་སུ་གྱུར་ཏེ་མཆོད་གནས་ཐམས་ཅད་བོས་ལ་ལྷ་རྟེན་ལ་ཕྱག་ཚོལ་ཞིག་བསྒོ་བ་གཞན་རྣམས་ཀྱིས་བྱས།",
    "དེའི་དབུར་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་གཅིག་བཞུགས་སུ་ཆུག་ཐོག་མར་དེ་ལ་ཕྱག་འཚོལ།",
    "དེ་ནས་ལྷ་རྟེན་ལ་འཚོལ་ཞིག་དེ་ལྟར་མ་བྱས་ན་ཡང་རྟེན་འདི་འགས་པར་འགྱུར་རོ་ཞེས་གསུངས་ནས་ལྷོ་ཕྱོགས་སུ་གཤེགས་པའི་རྗེས་སུ་རལ་པ་ཅན་གཅིག་འབྲངས་པ་ནི་ནག་པོ་པའོ།",
    "དེར་བྱོན་ཏེ་ལྷ་དེ་ལ་རྡོག་ཐོ་གཅིག་བརྒྱབ་ནས་ཕར་འདོང་གསུངས་པས་ལངས་ཏེ་ཕྱི་བཞིན་འབྲངས་སོ།",
    "མ་ཧེ་མི་གསོད་པར་འབྲས་ཆན་ལ་སོགས་པས་མཆོད་ན་འཇོག་གོ།",
    "ཕྱི་རོལ་པའི་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་མི་དེར་ཁྲིད་ནས་དམར་མཆོད་བྱེད་པ་དེར་ཕེབས།",
    "དེ་གཉིས་ཀྱིས་ཤེས་བཞིན་དུ་མི་ཤེས་པ་སྐད་བྱས་ཏེ་གར་འགྲོ་ཟེར།",
    "སོ་མ་ནཱ་ཐ་རླག་པར་བྱེད་དུ་འགྲོ་གསུངས་པས།",
    "དེ་མངོན་དུ་འགྱུར་གྱི་གསུངས་པས།",
    "སློབ་དཔོན་གྱི་ཞབས་ལ་འཇུས་ཕྱག་བྱས་ནས།",
    "ཅི་གསུངས་པ་བཞིན་བགྱིད་དོ།",
    "བསྟན་པ་གནས་ཀྱི་བར་དུ་ངའི་འདིར་བཞུགས་ནས་མཆོད་གནས་མཛད་དགོས་ཟེར་བས།",
    "སློབ་དཔོན་གྱིས་དེ་ལྟར་ཞལ་གྱིས་བཞེས།",
    "དེར་ཆང་འཚོང་མ་ཞིག་ལ་ཆང་ཉོ་གསུངས་པས།",
    "དུག་སྦྲུལ་གྱིས་ནི་རྒྱན་བྱས།",
    "སློབ་དཔོན་ཌོམྦི་ཧེ་རུ་ཀ་ནགས་གསེབ་ཏུ་སྒོམ་གྱིན་བཞུགས་པའི་ཚེ།",
    "ཐམས་ཅད་ཀྱིས་གྲུབ་ཐོབ་ཏུ་ཤེས་ནས་བཟོད་པར་གསོལ་བས་གཅིག་ཕྱི་རབས་ཀྱི་རྣལ་འབྱོར་པ་རྣམས་ལ་ནུས་པ་བསྟན་པར་བཞེད་ནས་བཞག་གཞན་རྣམས་སྔར་བཞིན་བྱས་པས།",
    "བཟོད་པར་གསོལ་༩༣",
    "རྣལ་འབྱོར་གྱི་རྒྱུད་ལེགས་པར་བསླབས།",
    "དེ་དང་བཤེས་སུ་འཐམས་ཏེ་ཟླ་བ་བརྒྱད་ཀྱི་བར་དུ་མཉེས་པར་བྱས།",
    "དེའི་ཞལ་ནས་དེ་ནི་ཁོ་བོས་ཀྱང་མ་རྟོགས་ཞེས་གསུངས་པས་ཐུགས་ཆད་དེ།",
    "བདག་ཀྱང་དེ་ཁོ་ན་ན་གནས་པས་དེ་ལས་ཐར་བར་བྱ་བའི་ཕྱིར་ལྷ་དྲག་ཏུ་བསྐུལ་བའི་ཆོ་ག་ལ་བརྩོན་པར་རིགས་སོ་སྙམ་ནས་ཟླ་བ་དྲུག་ཏུ་འབད་པ་ལ་དེ་ཁོ་ན་ཉིད་སྟོན་པའི་སློབ་དཔོན་བྱི་བའི་ཤམ་ཐབས་ཅན་བྱ་བ་ཡོད་ཟེར་ལུང་བསྟན་བྱུང་།",
    "དེ་ལྟར་བྱས་པ་ན་ངས་རྗེས་སུ་འཛིན་པ་འདི་ཡིན་གྱི།",
    "རྟོག་གེ་པ་བྱ་བ་འདི་ཁ་ཡིན་སོམ་ཉི་མ་བྱེད་པར་ཟོ་ཞིག་ཟེར།",
    "སློབ་དཔོན་གྱིས་དེ་ཁོ་ན་ཉིད་ལེགས་པར་ཁོང་དུ་ཆུད་དེ།",
    "དེ་ནས་འཇམ་པའི་དབྱངས་ཀྱི་ཞལ་གྱི་ལུང་ལེགས་པར་བསྟན་ཞིང་བསྟན་བཅོས་རྩོམ་པར་གནང་བ་སྦྱིན་པས།",
    "རྒྱལ་པོས་མཆོད་དེ་ལྷ་ཁང་དུ་བཞུགས་སུ་གསོལ་བ།",
    "དེས་སྟོན་པར་འགྱུར་རོ་ཞེས་རྨིས་ནས།",
    "དེ་ནས་རྒྱལ་པོ་དེས་དཔལ་མཆོག་དང་པོ་ལས་གསུངས་པ་བཞིན་གྱི་ཆགས་ཆེན་གྱི་སྤྱོད་པ་མཛད་དེ་འཁོར་དང་བཅས་པ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོར་བཀོད།",
    "འདོད་ཡོན་ལྔ་ལམ་དུ་བྱས་པ་གྲུབ་སྟེ།",
    "པྲ་ཛྙཱ་སིདྡྷི་ལ་བརྒྱུད་དེ་རྣམས་ཡང་དག་པར་བསྟན་ཏེ་མཁའ་སྤྱོད་དུ་བྱོན་ནོ།",
    "རིག་པའི་གནས་ལྔ་མཁས་པར་ཐོབ།",
    "རིག་པའི་གནས་ཐམས་ཅད་མཁྱེན་པ།",
    "སློབ་དཔོན་སྒྲ་གཅན་འཛིན་སོགས་ཀྱི་སྙན་པ་ཐོས་ནས་རྒྱ་གར་ཤར་ཕྱོགས་སུ་བྱོན་ནས་སློབ་དཔོན་བཞི་གར་བཞུགས་དྲིས་པས།",
    "ལས་ཀྱི་སྒྲིབ་པ་རྒྱུན་གཅོད་པ་ལ་སོགས་པའི་རྒྱུད་བདུན་འགྲེལ་པ་ཆོ་ག་དང་བཅས་པ་གསུངས།",
    "གཞན་ཡང་གདམས་པ་མང་དུ་གནང་སྟེ།",
    "ཞེས་སོགས་གསུངས་སོ།",
    "རྒྱུད་བརྒྱ་མ་རྙེད་པར་དཔལ་མཆོག་དང་།",
    "དྷརྨ་པཱ་ལ་སོགས་ལ་གནང་བ་ལས་ཕྱི་མ་མཁས་པར་བྱེད།",
    "ཐོས་པ་ཆུང་བའང་བདུད་ཀྱི་ལས་སོ་ཞེས་གསུངས་ཏེ།",
    "འཆད་ཉན་ཡང་ལེགས་པར་མཛད་དོ།",
    "དེ་ནས་ཡང་དག་འཇོག་བཞེད་ནས་དབེན་པར་མཉམ་པར་བཞག་པ་ན་སེམས་བ་འཇོ་བའི་ནུ་མ་འཐེན་པའི་ཡུན་ཙམ་ཡང་གནས་པར་མ་ནུས་ནས་ཐུགས་སྐྱོ་སྟེ།",
    "ཀྱི་ལས་སོ་ཞེས་གསུངས་ཏེ།",
    "དེ་ནས་སྐུ་མ་སྤངས་པར་མཁའ་སྤྱོད་དུ་བྱོན་ནོ།",
    "ཐུགས་ལན་གསུམ་དུ་མཁྱེན་པ་རིག་འཛིན་གྱི་གཙོ་བོ་དགའ་རབ་རྡོ་རྗེས།",
    "སྟོན་པ་ཀུན་ཏུ་བཟང་པོས་དགོངས་པར་བཞུགས།",
    "དུར་ཁྲོད་ཆེན་པོ་བསིལ་བའི་ཚལ་གྱི་མཆོད་རྟེན་བདེ་བྱེད་བརྩེགས་པའི་ནང་དུ་སྦོས་ཤིག་གསུང་བ་བཞིན་བྱས་ཐམས་ཅད་ཀྱིས་མཆོད་དོ།",
    "རིག་འཛིན་ཐམས་ཅད་དང་པོར་རིག་པའི་གནས་ཐམས་ཅད་ལ་མཁས་པར་སྦྱངས་ལ།",
    "རྒྱལ་པོ་ཨིནྡྲ་བྷཱུ་ཏི་ཆེན་པོས་མཁྱེན་ནས་རྒྱ་མཚོར་འགྲོ་བའི་གཟིངས་བཅས་ཏེ།",
    "དེས་གདུལ་བྱ་རྣམས་སྨིན་པར་མཛད།",
    "ནམ་མཁའ་ཇི་སྲིད་སྐྱེ་འཆི་མི་སྟོན་པར་རྡོ་རྗེའི་སྐུར་བཞུགས་པས་པདྨ་འབྱུང་གནས་ཞེས་བྱའོ།",
    "དེའི་དབུས་སུ་པདྨའི་སྡོང་པོ་བྱུང་བ་དེ་ལ་སློབ་དཔོན་ཡབ་ཡུམ་བཞུགས་ཏེ།",
    "བཀའ་འབངས་བགྱིད་པར་རྩིས་ལ་ཕབ།",
    "ལས་ཅན་གྱི་རྒྱལ་པོ་རྗེ་འབངས་སྨིན་པར་མཛད།",
    "གཞན་ཡིད་ལྟར་མྱུར་བའི་རྫུ་འཕྲུལ་གྱི་སྲིན་ཡུལ་རྔ་ཡབ་གླིང་དུ་སྲིན་པོའི་རྒྱལ་པོའི་རྣམ་པར་མཛད་དེ།",
    "པའི་རིང་བཞུགས་སོ་ཞེས་ཐོས་སོ། ད་ནི་ཤམྦྷ་ལར་ཇི་ལྟར་དར་བའི་ཚུལ་ནི།"
  ]
