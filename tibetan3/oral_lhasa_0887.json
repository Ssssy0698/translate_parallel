    "ཤར་ཕྱོགས་བྷཾ་ག་ལར་འཁྲུངས་པའི་ཙནྡྲ་གོ་མི་ཞེས་བྱ་བ་བཅོམ་ལྡན་འདས་སྒྲོལ་མས་རྗེས་སུ་གཟུང་བ་དེ་ཟླ་གྲགས་ལ་རྩོད་པར་འོངས་པའི་ཚེ།",
    "འཇམ་པའི་དབྱངས་ཀྱི་སྐུ་ཤིང་རྟའི་སྟེང་དུ་བཞག་དེའི་རྒྱབ་ཏུ་བཞུགས་ནས་བྱོན་པའི་ལམ་དུ་འཇམ་དབྱངས་ལ་བསྟོད་པ་མཛད་པས།",
    "རྩོད་པ་ཟློག་པའི་འགྲེལ་པ་མཛད་པ་ན་སློབ་དཔོན་གྱིས་ཀྱང་སྦྱོར་བའི་ངག་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་པས་དེ་དེས་མཛད་ན་དེ་སྐད་སྦྱར་མི་དགོས་པར་འགྱུར་བས་སོ།",
    "རྣམ་པར་རབ་ཏུ་མང་པོ་འབྱེད།",
    "ནང་པའི་གཎྜཱིའི་སྒྲ་ལས་འགེམས་ཞེས་པ་ཞིག་སྣང་སྟེ་འོ་སྐོལ་ལ་གནོད་མི་གནོད་བརྟག་པར་རིགས་སོ་ཟེར་ནས་བརྟགས་པས།",
    "ཞེས་པར་རིག་ནས་དམག་དྲངས་ཏེ་བསྣུབས་སོ།",
    "ལྷའི་གྲོ་སྐད་དུ་མི་ལོ་ལྔ་བཅུའམ་ལྔ་བཅུ་རྩ་གསུམ་དུ་བཞུགས་པར་འཆད།",
    "ཟླ་བ་དྲུག་བཞུགས་ཏེ་གསན་ཞེས་བྱུང་ངོ།",
    "དེ་ནས་ས་གསུམ་པར་འཕར་ཞེས་སྦྱར་རོ།",
    "ལོག་སྒྲུབ་དོན་མེད་དུ་འགྱུར་བ་མཁྱེན་ཏེ།",
    "སྲོད་ལ་ཐེག་ཆེན་འདི་རྒྱུ་བཟང་ལ་འབྲས་བུ་གཡེལ་བ་འདྲ་གསུངས།",
    "ང་ལ་དེ་ལྟ་བུ་མེད་པས་ཡི་དམ་ཞིག་ལ་དྲིས་ཤིང་ལན་འདེབས་པ་ཡིན་གསུངས།",
    "དེ་བདག་ལ་བསྟན་པར་ཞུ་བྱས་པས།",
    "རྗེ་བཙུན་ལ་ཞུ་ཡི་གསུངས་ནས་ཞུས་པས།",
    "གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མ་ཐོན།",
    "ཕྱི་མ་མཇལ་བར་འོང་གྱིས་ཤིག་གསུངས་པས་དེ་ལ་དེ་སྐད་བསྙད་དོ།",
    "དེ་ནས་གཅེན་ལ་ལྷག་པར་དད་དེ།",
    "ངའི་སློབ་དཔོན་ག་ན་བཞུགས་ཞེས་དྲིས་པས།",
    "ཕས་ཡུལ་དབུས་སུ་འགྲོ་བའི་ཚོང་པ་ལ་དྲིས་པས་བཞུགས་ཟེར་ནས་ཅུང་ཟད་སྐྱེས་པ་དང་སློབ་དཔོན་དབྱིག་གཉེན་ཅན་དུ་བསྐྱལ།",
    "སློབ་དཔོན་གྱིས་ཡི་གེའི་ཕྱི་མར་སློབ་པ་ནས་བཟུང་སྟེ་རིག་པའི་གནས་ཐམས་ཅད་ལ་མཁས་པར་བསླབས་སོ།",
    "ཆུང་ངུའི་དུས་ན་ནཱ་ལེནྡྲའི་སྒྲོལ་མའི་རྟེན་བཞུགས་པའི་ཕྱག་ཏུ་སྲན་མའི་གང་བུའི་ཕུད་ཕུལ་ལ་ཟ་སྙམ་ནས་འགའ་ཞིག་ཕུལ་བས་འགྲིལ་བྱུང་བས།",
    "འཕགས་མས་མ་བཞེས་པར་རང་ཟ་བ་མི་འོས་སྙམ་ནས་ཟད་ཟད་ཕུལ།",
    "སྒྲ་ལ་སོགས་པ་ཐ་སྙད་ཀྱི་གཙུག་ལག་ལ་ལེགས་པར་སྦྱངས།",
    "དེ་ལས་བསྟན་བཅོས་ཆེན་པོ་ཞིག་བྱུང་སྟེ་མུ་སྟེགས་རྣམས་ལ་གནོད་པར་ཤེས་ནས།",
    "བསུབ་པར་ཡོང་བས་བརྩད་པར་བྱའོ་ཞེས་པ་མཐོང་སྟེ་མ་བསུབ་པར་བསྡད་དོ།",
    "སེམས་ཡོད་བཞིན་དུ་ཅིའི་ཕྱིར་བཏང་སྙོམས་སུ་བྱེད་ཅེས་གསུངས་པ་དང་།",
    "ཉེར་རྟེན་འཇིག་རྟེན་རྒྱས་མཛད་དེ་ནི་རྨོངས་པས་ཅུང་ཟད་སྨད་པར་བྱུང་ན་ཡང་།",
    "ཞེས་གསུངས་སོ།",
    "དེར་ཐུགས་ལ་མུ་སྟེགས་ཐམས་ཅད་ཕམ་པར་བྱེད་པ་ཞིག་བྱའོ་སྙམ་ནས་ནང་པའི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་ནས་སྦྱངས་པ་མཛད་ཅིང་།",
    "འབྲས་བུ་རྒྱུའི་ཁྱད་པར་གྱི་རྗེས་སུ་བྱེད་པ་ལྷག་པར་རྟོགས་ཏེ།",
    "བྲན་དུ་བརྫུས་ཏེ་ཞང་པོའི་ཆུང་མའི་གཡོག་བྱས་ནས་མགུ་བར་བྱས་ཏེ།",
    "དེའི་ཚེ་མུ་སྟེགས་ཀྱི་མཁས་པ་ཡོད་ན་རྩོད་པར་༥༤",
    "ཞེས་གསུངས་སོ།",
    "ཙནྡྲ་གོ་མི་བརྗོད་པ་རྣམ་པར་དག།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བ་ང་མིན་སུ།",
    "ཞེས་གསུངས།",
    "སློབ་དཔོན་འདི་འཁོར་ལོ་སྡོམ་པའི་རྣལ་འབྱོར་པ་མཐར་མཁའ་སྤྱོད་ཆེན་པོ་སྐུ་ཚེ་འདིར་གྲུབ་པར་འཇམ་དཔལ་རྩ་རྒྱུད་ལས།",
    "ལྷོ་ཡི་ཕྱོགས་སུ་རྣམ་པར་གྲགས།",
    "དཀའ་འགྲེལ་འདི་ནི་འདིར་བྱས་སོ།",
    "དུལ་བའི་ལྷ་སྔར་བྱུང་ཞིང་རྒྱན་ཕྱིས་བྱོན་པ་སྟེ།",
    "བོད་ཀྱི་བསྟན་པ་ཕྱི་དར་གྱི་དུས་ཀྱི་ཐོག་མ་ཙམ་ན་བི་ཀྲ་མ་ལ་ཤཱི་ལའི་སྒོ་སྐྱོང་དུ་བཞུགས་པའོ།",
    "ལྷག་པར་བཙུན་པ་དབྱིག་གཉེན་ལ་བརྟེན་ནས་བདག་དང་གཞན་གྱི་གྲུབ་པའི་མཐའ་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོན་པ།",
    "དགུང་ལོ་བཞི་བརྒྱའི་བར་དུ་བཞུགས་ཏེ་སྟོན་པའི་བསྟན་པ་བསྐྱངས།",
    "རྒྱལ་པོ་ཁྲོས་པ་དང་སོར་གདུབ་བསྟན་པས་ཀླུའི་ཡི་གེ་མཐོང་ནས་དེ་ཝ་བཱ་ལ་ཞེས་བཏགས་ཏེ་གཅེས་པར་བསྐྱེད་བསྲིངས་སོ།",
    "དེ་རྒྱལ་སྲིད་ཐོབ་པ་དང་ལྷ་ཁང་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་རྩིག་པར་འདོད་ནས་ལྟས་མཁན་ལ་དྲིས་པས།",
    "དགེ་སྦྱོང་དང་བྲམ་ཟེའི་ཁྱིམ་ནས་རས་བླངས་ཏེ་སྡོང་བུ་བྱས།",
    "དེ་ལྟར་བྱས་པས་བྱ་རོག་གཅིག་བྱུང་ནས་ཀོང་བུ་མཚོ་ལ་བསྐྱུར་བས་ཡི་ཆད་པ་ན།",
    "དགེ་སྦྱོང་འདོད་པ་ཆུང་ཞིང་ཆོག་ཤེས་པར་རིགས་པ་ལས།",
    "ཁྱད་པར་དུ་ཡུམ་གྱི་དོན་ལ་རིང་དུ་གོམས་པ་ཞིག་བྱུང་སྟེ།",
    "དེ་ནས་མུ་སྟེགས་ཀྱི་ལྷ་རྟེན་བཤིག་པའི་དུས་ཀྱང་དེས་བསྟན་པ་བཞིན་བྱས་པས།",
    "དེར་བསྟན་པ་འཇིག་པར་གསུངས་པ་སྔར་བྱུང་བ་སྐད་ཟེར་བ་མི་འཐད།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡུལ་ཡོངས་སུ་སྤྱོད་པ་བསྟན་པར།",
    "སླར་དབུས་སུ་འོངས་ཏེ་དར་བར་གསུངས་པ་དེའི་མཐའ་ལ་འོང་རྒྱུ་ཡིན་ཞེས་གྲགས་སོ། ལིའི་ཡུལ་དུ་བསྟན་པ་ཇི་ལྟར་བྱུང་བ་ནི།",
