    "དེ་ལས་གུད་ན་གཟུང་བ་ཡོད་པར་ཡོངས་སུ་རྟོག་༤པ་ནི་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་ཏུ་རྟོག་པ་སྟེ།",
    "ཡེ་ས་ཀྱང་ཁོང་དུ་ཆུད་པར་བྱ་བ་ལས་གུད་ན་བྱེད་པའི་ངོ་བོར་མེད་པའི་ཕྱིར་རོ།",
    "ཁོང་དུ་ཆུད་པར་བྱེད་པ་པོ་ཡང་བདག་ལ་༨སོགས་པ་བྱེད་པ་པོ་མེད་པའི་ཕྱིཕྱིར།",
    "ཡོངས་སུ་ད་ག་པའི་ཡེ་ཤེས་གཉིས་སུ་མེད་པ་ཉིད་ཁོང་དུ་ཆུད་པར་བྱེད་པ་པོ་ཡིན་ན་ནོ།",
    "༩དེ་ཉིད་ཁོང་དུ་ཆུད་པར་བྱ་བ་ཡིན་ན་ནོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གྲུབ་པ་དང་།",
    "འགྱུར་བ་མེད་པར་ཡོངས་སུ་གྲུབ་པར་བསྟན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མཚན་ཉིད་མེད་པ་ཞེས་བྱ་བ་དེའི་འོག་ཏུ་བཞེངས་པར་འགྱུར་ན།",
    "འཕགས་པ་འཇམ་དཔལ་ལས་བརྩམས་ཏེ་ཐོག་མར་བསྟན་པར་ཇི་ལྟར་འགྱུར།",
    "མཉམ་པར་གཞག་པ་དང་།",
    "དེ་ཉིད་ཀྱིས་ཞུས་པའི་ཕྱིར་དེ་ཉིད་ལ་བཀའ་སྩལ་པར་རིགས་༡པར་ངེས་ཏེ།",
    "དེ་བས་ན་ཐ་སྙད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ས་སོ།",
    "ཐ་སྙད་ལས་ཡང་དག་པར་འདས་པ།",
    "ཡི་གེའི་སྒྲ་སྐད་ལས་ཡང་དག་པར་འདས་པ་ཞེས་བྱ་བའི་ཚིག་གཉིས་པོ་དེ་ལ་ཚིག་དང་པོ་ནི་གོང་དུ་བསྟན་དུ་མེད་པ་ཞེས་གང་སྨོས་པ་དེ་ད་ང་དོན་གཅིག་སྟེ།",
    "སྒྲ་ལས་ཡང་དག་པར་འདས་པ་ཞེས་བྱ་བ་ནི་སྒྲ་མེད་པ་ཞེས་གང་བསྟན་པ་དེ་དང་དོན་མཐུན་ནོ།",
    "དེ་བས་ན་འོག་ནས་ཁམས་གསུམ་པ་ལས་ཡང་ད་ག་པར་འདས་པ་ལ་སོགས་པ་བཞིའི་དོན་ནི་སྔ་མ་བཞིན་ནོ་ཞེས་འཆད་དོ་། ཐ་སྙད་རབ་ཏུ་བརྟགས་ཏེ་རྣམ་པར་གཞག་པ་ཉིད་འཇུག་པ་སྟེ།",
    "གདོད་མ་ཉིད་ནས་འཇུག་པ་མེད་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཐ་སྙད་དུ་༢རབ་ཏུ་བཏགས་༤ནས་གང་སྟོང་པ་ཉིད་རྣམ་པར་གཞག་པ་དེ་ལས་ཤིན་ཏུ་འདས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "དེ་ནི་ཞུས་པ་དེ་ཡང་འཇུག་པ་རྣམ་པར་དག་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "སྤྲོས་པར་བྱེད་པས་སྤྲོས་པ་སྟེ།",
    "རབ་ཏུ་བརྟགས་ནས་རྣམ་པར་གཞག་པ་མེད་པ་ནི་འཇུག་པ་མེད་པ་སྟེ།",
    "ཚིག་སྔ་མས་ནི་གཟུང་བ་དངོས་པོ་མེད་པར་བསྟན་གྱི།",
    "བླ་གབ་མེད་པ་ཞེས་དེར་གང་གསུངས་པའི་བླ་གབ་མེད་པའི་དོན་གང་ཡིན་པ་དེ་འདིར་ཡང་ཞེས་བྱའོ་༡།",
    "ཡང་ད་ག་པའི་མཐའ་དམིགས་པར་གྱུར་པ་དེ་ནི་ཡང་དག་པའི་མཐའ་སྟེ།",
    "གཞག་པ་ནི་བྱིས་པས་ཡོངས་སུ་བརྟགས་ཏེ་ཡོད་པར་སྒྲོ་བཏགས་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པའི་མིག་ཡོར་ལ།",
    "ཐ་སྙད་ལས་ཡང་དག་པར་འདས་པ།",
    "ཡི་གེའི་སྒྲ་ལས་ཡང་དག་པར་འད་ས་པ།",
    "གནས་ནི་ཕྱིའི་སྟེ་དམིགས་པར་གྱུར་པའོ།",
    "གཡོ་མེད་པའི་སྟོབས་ཀྱིས་གདམས་ངག་ལེགས་པར་གཟུང་༢བ་འདུས་བྱས་ལ་ཉེ་བར་རྟོག་སྟེ།",
    "ཤེས་བྱའི་སྒྲིབ་པའི་ཡུལ་ཅི་རིགས་པར་མི་མཐོང་བ་སྟེ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་འདུས་བྱས་ལའོ།",
    "ལུས་དང་ངག་ད་ང་ཡིད་ཀྱི་ལས་རྣམ་པར་དག་པའི་བདག་ཉིད་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟེ།",
    "བག་ཡོད་པའི་ཕྱིར་བྱུང་ངོ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་དང་ཐབས་དང་ལྡན་པ་ནི་༢ཐམས་ཅད་དུ་བག་ཡོད་པར་གནས་པའི་ཕྱིར་རོ།",
    "ལེགས་པར་སྤྱོད་པ་རྣམ་པ་གསུམ་གྱི་ཕྱིར་བྱུང་ངོ་ཞེས་བྱ་བ་ནི་བག་ཡོད་པ་ལ་གནས་པ་དག་ལུས་དང་།",
    "དེ་བས་ན་ལེགས་པར་སྤྱོད་པ་རྣམ་པ་གསུམ་ནི་བག་ཡོད་པའི་འབྲས་བུའོ།",
    "ལེགས་པར་སྤྱོད་པ་རྣམ་པ་གསུམ་དང་ལྡན་ན་ཚོགས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་ཏེ།",
    "གཞན་དུ་ན་ལེགས་པར་སྤྱོད་པ་རྣམ་པ་གསུམ་དང་།",
    "ཕྱིར་མི་ལྡོག་པ་ནི་མི་གཡོ་བ་ལ་སོགས་པར་ར་རོ།",
    "དེ་བཞིན་དུ་གྱུར་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པར་འགྱུར་ར་རོ།",
    "ཁུར་བླངས་པ་ནི་བདག་དང་གཞན་གྱི་དོན་ཡང་དག་པར་སྒྲུབ་པའོ།",
    "རྣམ་པར་མི་རྟོག་༡པར་རྒྱུ་བ་ནི་ངེས་པའི་ཕྱིར་ར་རོ།",
    "དེ་བས་ན་རྩོལ་བའི་རྣམ་པར་རྟོག་༢པས་སྐྱོད་༢པར་མི་ནུས་པའི་ཕྱིར་ས་དེ་མི་གཡོ་བ་ཞེས་བྱའོ།",
    "འདི་ནི་ལེགས་པར་རྣམ་པར་འབྱེད་པའོ།",
    "ངེས་པར་འབྱེད་པ་ཉིད་དུ་གནས་པ་སྟེ།",
    "དེའི་ངོ་བོ་དང་འབྲེལ་པར་རྣམ་པར་གནས་པའོ།",
    "དེས་ས་དང་པོ་ལ་ལྷག་པར་དམིགས་པའི་ཕྱིར་ར་རོ།",
    "ས་རབ་ཏུ་ད་གའ་བས་བསྡུས་པའི་ཡེ་ཤེས་ཡོངས་སུ་སྨིན་པ་ནི་ས་གཉིས་པ་བསྐྱེད་པར་གེགས་༧མེད་པར་ནུས་པ་ཉིད་ད་དེ།",
    "རྒྱུ་དེས་སྦྱོར་བ་ལས་བྱུང་བའི་སྤྱོད་པ་དྲི་མ་མེད་པ་ལ་སོགས་པས་བསྡུས་པ་ལ་ལྷག་པར་དམིགས་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ལས་ཡང་དག་པར་བྱུང་བ་ཞེས་བྱ་བ་ནི་རྒྱུ་ལས་ཡང་དག་པར་བྱུང་བ་གང་ཡིན་པ་དེ་རྒྱུ་ལས་ཡང་དག་པར་བྱུང་བ་སྟེ།",
    "ཡེ་ཤེས་ལས་ཡང་དག་པར་བྱུང་བ་ཞེས་བྱ་བ་ནི་ས་རབ་ཏུ་དགའ་བས་བསྡུས་པའི་ཡེ་ཤེས་ལས་ཡང་དག་པར་བྱུང་བ་ཕྱིན་ཅི་ཧ་མ་ལོག་པ་རྒྱུར་གྱུར་པ་ལས་བྱུང་བ་སེམས་བསྐྱེད་པ་གཉིས་པ་གང་ཡིན་པ་དེ་ཡེ་ཤེས་ལས་བྱུང་བའོ།",
    "སྤོང་བ་ལས་ཡང་དག་པར་བྱུང་བ་ཞེས་པ་༢འདིས་སྤོང་བས་ན་སྤོང་བ་སྟེ།་",
    "ས་བདུན་པས་བསྡུས་པའི་ཡེ་ཤེས་དེ་ལས་ཡང་དག་པར་བྱུང་བ་ཕྱིན་ཅི་མ་ལོག་པ་སེམས་བསྐྱེད་པ་གསུམ་པ་གང་ཡིན་པ་དེ་སྤོང་བ་ལས་ཡང་ད་ག་པར་བྱུང་བའོ།",
    "འབྲས་བུ་ནི་ཏིང་ངེ་འཛིན་གྱིས་རྣམ་པར་རོལ་པ་མཐའ་ཡས་པ་མྱོང་བའོ།",
    "སྒྱུ་མ་༢ིམཐའ་ཡས་པ་རྣམ་པར་གྲོལ་བའི་ཕྱིར་རོ།",
    "ཉན་ཐོས་ལ་སོགས་པའི་བསླབ་པའི་རྣམ་པ་དག་ལས་ཁྱད་པར་དུ་འཕགས་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "དེ་ནི་བསྒོམས་༧པའི་འབྲས་བུ་ཁྱད་པར་དུ་འཕགས་པ་ཞེས་བྱ་བྱ་བའོ།",
    "དེའི་ཁྱད་པར་དུ་འཕགས་པ་ནི་ལྷུན་གྱིས་གྲུབ་པར་ཐམས་ཅད་དུ་ཅིག་ཅར་ཡང་དག་པར་སྒྲུབ་པའོ།",
    "བར་དུ་འོད་རྣམ་པར་ངེས་པའི་འོད་ཟེར་གྱི་འོད་ད་ང་།",
    "ཚོགས་ད་ང་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཚོགས་ཀྱི་ལམ་བསྟན་པ་དང་རྣམ་པར་རིག་པའི་ལམ་བསྟན་པའོ།",
    "ཡང་དག་པའི་མཐའ་དེ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཐབས་བསྟན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "དེ་བས་ན་འོག་ནས་རྣམ་པར་དག་པའི་ལམ་བསྟན་པ་ཡང་རྣམ་པ་བརྒྱད་ཀྱིས་ཞེས་འབྱུང་ང་ངོ།",
    "དེ་དག་སྦྱིན་པས་ཡོངས་སུ་སྨིན་པར་བྱའོ།",
    "ཞེ་སྡང་ཅན་དག་ནི་སྙན་པར་སྨྲ་བས་ས་སོ།",
    "བརྐམ་ཆགས་ཅན་ལ་སོགས་པ་ད་ག་སྦྱིན་པ་ལ་སོགས་པའི་བསྡུ་བས་ཡོངས་སུ་སྨིན་པར་བྱ་བ་ཤེས་ནས་དེ་བཞིན་དུ་སྤྱོད་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར་ལམ་དུ་གྱུར་པ་ནི་ནམ་པར་དག་པའི་ལམ་སྟེ་ཤེས་རབ་བོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་འཇུག་པའོ་ཞེས་བསྡུས་པའི་དོན་ཏོ།",
    "ཤེས་རབ་ནི་རྒྱུ་ཟད་པར་འགྲོ་བའོ་ཞེས་བྱ་བ་ནི་ཉིང་མཚམས་སྦྱོར་བའི་རྒྱུ་ཟད་པར་འགྲོ་བའི་ཕྱིར་ཏེ།",
    "རྣམ་པར་རིག་པ་རྣམ་པར་དག་པའི་མཚན་ཉིད་ནི་སང་ས་རྒྱས་ཀྱི་ཞིང་རྣམས་ཏེ།",
    "དེ་དབྱེར་མེད་པར་ཤེས་པ་ནི་གཅིག་ཏུ་ཤེས་པའོ།",
    "དེ་༡ཡང་དག་པར་གཞོལ་བ་ནི་རྣམ་པར་གཞོལ་བའོ།",
    "ཡང་གཉིས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་དེ་དག་ཉིད་རྣམ་པར་སྟོན་༡ཏོ།",
    "ཚད་ཡོད་པར་བྱས་པའི་ལམ་སྟེ།",
    "གཉིས་པ་༤ལ་གནས་པའི་ཤེས་པ་ནི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "དེ་བས་ན་ཤེས་བྱ་ཐམས་ཅད་ལ་འཇུག་པ་མེད་པས་མཐའ་དམིགས་པའི་ཕྱིར་དེ་ནི་ཚད་ཡོད་པར་བྱས་པ་ཞེས་བྱ་བར་དགོང་ས་པའོ།",
    "ཇི་ལྟར་ན་ཡེ་ཤེས་ཀྱིས་རབ་ཏུ་ཕྱེ་བ་ཡིན་ཞེས་བྱ་བ་ནི་ཡང་དག་པའི་མཐའ་དེ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཐབས་བསྟན་པའི་ཕྱིར་ར་རོ།",
    "སྟོང་པ་ཉིད་ལས་ངེས་པར་སྐྱེས་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "ཡེ་ཤེས་ཀྱི་སྟོབས་ཀྱིས་སྒྲིབ་པ་སྤངས་པར་གྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ་། འཕགས་པ་འཇམ་དཔལ་གྱིས་དོན་ད་ང་ཡེ་ཤེས་ཀྱི་དབྱེ་བ་གསུངས་པ་ད་ང་།",
    "རིགས་ཀྱི་བུ་དོན་ནི་འདུས་མ་བྱས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུ་ད་ང་རྐྱེན་གྱིས་འདུ་བྱ་བ་མེད་པའི་ཕྱིར་འདུས་མ་བྱས་པའོ།",
    "དེ་བས་ན་མི་རྟག་པ་ཉིད་དང་ཕྲད་པ་མེད་པའི་ཕྱིར་དོན་ནི་ལྡན་པ་མེད་པར་གསུངས་ས་སོ།",
    "གཉིས་དང་བྲལ་བ་ཙམ་དུ་རྟག་པར་གནས་པ་ཉིད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "རྟག་ཏུ་ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གྲུབ་ཅེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "དེའི་ཕྱིར་གང་དང་ཡང་ལྡན་པའམ་༡མི་ལྡན་པ་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡེ་ཤེས་ཞེས་བྱ་བ་ནི་ལམ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ས་སོ།",
    "འདིས་ནི་ཡང་དག་པའི་མཐའ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཐབས་རྒྱ་ཆེར་བསྟན་ཏོ།",
    "ཡེ་ཤེས་ནི་སྤོང་བ་ད་ང་ཡང་དག་པར་ལྡན་པ་ཡིན་གྱི་༤ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཉིས་པའོ།",
    "རྣམ་པ་སུམ་ཅུ་རྩ་གསུམ་ཞེས་བྱ་བ་ནི་དེ་ལ་དེ་མ་ཐག་ཏུ་གསུངས་པའི་ཚིག་གསུམ་ད་ང་།",
    "བཅུ་པ་བཞི་པས་ནི་ཇི་ལྟར་ཁོང་དུ་ཆུད་པར་བྱེད་པའོ།",
    "དྲུག་པས་ནི་གང་དུ་གནས་ཏེ་ཁོང་དུ་ཆུད་པར་བྱེད་པའོ།",
    "དེ་ནི་སེམས་ད་ང་ཡང་དག་པར་ལྡན་པ་ཞེས་བྱ་བ་ལ་སེམས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའོ།",
    "སེམས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "མཐོང་བའི་ལམ་གྱི་རང་བཞིན་རྣམ་པར་དག་པ་འབྱུང་ཞེས་པའི་༢ཐ་ཚིག་གོ།",
    "ཅིག་ཤོས་ནི་མངོན་སུམ་དུ་བྱེད་པ་སྟེ་ཁྱད་པར་ནི་དེའོ།",
    "ནམ་དེའི་སྐྱེས་བུའི་ཚུལ་དུ་གྱུར་པ་དེའི་ཚེ་ནི་སྤོང་བ་ད་ང་ཡང་དག་པར་ལྡན་པ་སྟེ།",
    "དེ་ཉིད་ཀྱི་མཇུག་སྡུད་ནི་ཕན་ཚུན་བྱ་བས་༢བྱས་པར་གནས་པ་ཞེས་བྱའོ།",
    "འདིར་ནི་ཤེས་བྱ་ཡང་དག་པར་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་བརྩོན་པ་ནི་ཡང་དག་པར་ལྡན་པ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཤེས་པ་ནི་སྦྱིན་པ་ལ་སོགས་པའི་ནམ་པར་དབྱེ་བ་ཡོངས་སུ་ཤེས་པ་སྟེ།",
    "མཐའ་གཉིས་ཡོངས་སུ་སྤངས་ནས་རྣམ་པར་རིག་པ་ཙམ་དུ་བསྒོམ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ངག་ད་ང་ཡིད་ཀྱི་ཉེས་པར་སྤྱོད་པ་དང་བྲལ་བའི་ཕྱིར་བརྩོན་འགྲུས་བརྩམ་༦པ་ཞེས་བྱའོ།",
    "ལོགས་ཤིག་ཏུ་སྨོས་པས་ལུས་ལ་སོགས་པའི་ཉེས་པར་སྤྱོད་པ་དང་བྲལ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དོན་གྱིས་བད་ག་ལ་བྱ་བར་མངོན་ན་ནོ།",
