    "བསམས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཇི་ལྟར་ཐོས་པའི་དོན་ལེགས་པར་འཛིན་པ་དང་།",
    "འཛིན་དུ་འཇུག་པས་ཡང་དག་པར་༐",
    "དེ་ལ་ཤིན་ཏུ་རྣམ་པར་ཕྱེ་བ་ཞེས་བྱ་བ་ནི་དེའི་ཕ་རོལ་ན་ཡང་རྣམ་པར་དབྱེ་བར་བྱ་བ་མེད་པ་སྟེ།",
    "དེ་རྣམ་པར་འབྱེད་པ་ནི་ཤེས་པའོ།",
    "ཤིན་ཏུ་བརྟགས་པའི་ཡེ་ཤེས་ཀྱི་སྒོ་ལ་འཇུག་པར་བྱ་བའི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "ཕ་རོལ་ཡང་འཇུག་པར་མི་བྱེད་པའོ།",
    "ཡོངས་སུ་སྨིན་པར་བྱེད་པ་ད་ང་།",
    "འཇིག་རྟེན་གྱི་འགྲོ་བ་ཐམས་ཅད་ལས་ཡང་དག་པར་འད་ས་པའི་ཕྱིར་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་སྤོབས་པར་གྱིས་ཤིག་ཅེས་བྱ་བ་བཅུ་པ་འདིས་ས་སོ།",
    "གྱི་རླབས་༧ཀྱིས་ཞེས་གསུངས་སོ།",
    "ཤིན་ཏུ་རྣམ་པར་སྦྱངས་པའི་ཡེ་ཤེས་ཀྱིས་ཤིན་ཏུ་རྣམ་པར་ཕྱེ་བ་ལ་འཇུག་པ་དང་།",
    "ཤིན་ཏུ་རྣམ་པར་ངེས་པའི་བློ་གྲོས་ལ་མཁས་པ་དང་།",
    "ཐོགས་པ་མེད་པའི་སྤོབས་པས་སྟོན་པ་ཞེས་གསུངས་པའོ།",
    "ཤིན་ཏུ་རྣམ་པར་སྦྱངས་པའི་ཡེ་ཤེས་ཀྱི་རྣམ་པར་ཕྱེ་བ་ལ་འཇུག་པ་ཞེས་གསུང་ས་པའོ།",
    "གོ་རིམས་ལ་མི་ལྟོས་པར་གཏམ་གྱིས་བར་དུ་གཅོད་༡ཀྱང་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་དེ་ད་ང་དེ་ནས་ཚིག་འབྲུ་དང་།་",
    "ཤིན་ཏུ་རྣམ་པར་ངེས་པའི་བློ་གྲོས་ལ་མཁས་པ་ཞེས་གསུངས་པའོ།",
    "མི་འཇིགས་པ་ཞུམ་པ་མེད་པ་ཉིད་ཅེས་གསུངས་པའོ།",
    "གཞན་གྱི་དོན་ལ་༢བརྩམས་ནས་རྣམ་པ་བརྒྱད་དུ་རིག་པར་བྱ་སྟེ།",
    "ལྷག་པའི་བསམ་པ་ཤིན་ཏུ་ཡོངས་སུ་སྦྱངས་པའི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "ཡེ་ཤེས་དེ་ནི་མཉམ་པར་གཞག་པས་ནང་དུ་ཀུན་ནས་བཟླུམས་པའི་ཕྱིར་དང་།",
    "གཟུངས་ཀྱི་སྒོ་ཐ་དད་པ་མེད་པ་ལེགས་པར་རྟོགས་པའི་ཕྱིར་ཞེས་གསུངས་༐",
    "དེ་དག་ན་བཞུགས་བཞིན་དུ་ཞེས་བྱ་བ་ནི་མཐུའི་ཁྱད་པར་བསྟན་པའི་ཕྱིར་ཏེ་འདི་ན་བཞུགས་པ་ནི་པོ་མཚར་མི་ཆེའོ།",
    "ལྷན་ཅིག་བྱུང་བ་རྣམ་པར་སྨིན་པའི་རྫུ་འཕྲུལ་གྱིས་ཀྱང་མ་ཡིན་པའོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་གང་འདིས་རྣམ་པར་དགོད་པ་ཤེས་པའི་གནས་འདི་ནི་བསམ་གྱིས་མི་ཁྱབ་པའོ་ཞེས་བྱ་བ་ལ།",
    "ཏིང་ངེ་འཛིན་དེ་ལས་ལངས་ནས་ཞེས་བྱ་བ་ནི་མཐུའི་ཁྱད་པར་ཐོབ་པས་ཏིང་ངེ་འཛིན་གྱི་བྱ་བ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་དང་།",
    "མཉམ་པར་གཞག་བཞིན་དུ་འཆད་མི་ནུས་ས་སོ།",
    "ཅིའི་ཕྱིར་གསོལ་བ་མ་བཏབ་པར་འཆད་པ་རྩོམ་ཞེ་ན།",
    "དེ་ལྟར་མ་བྱས་ན་འཆད་འདོད་པ་ཉིད་ཡིན་པ་ད་ང་།",
    "ཅི་ཞིག་འཆད་འདོད་པར་མི་ཤེས་པའི་ཕྱིར་ར་རོ།",
    "ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ནི་དོན་དམ་པ་ཤེས་པ་ལ་གནས་པའི་ཕྱིར་ར་རོ།",
    "ཤིན་ཏུ་ངེས་པ་ཉིད་ཤིན་ཏུ་རྣམ་པར་ངེས་པའོ།",
    "ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ཀྱང་༢རྣམ་པ་དྲུག་ཏུ་རིག་པར་བྱ་སྟེ།",
    "རྒྱུ་ཉིད་དུ་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ནི་རྣམ་པ་གཉིས་ས་སོ་། རྒྱུ་ཉིད་ནི་ནམ་མཁའ་ལྟ་བུ་སྟེ།",
    "ཤིན་ཏུ་རྣམ་པར་ངེས་པ་བརྗོད་མ་ཐག་པ་དང་།",
    "འདིར་ཡང་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ནི་ཡན་ལག་ག་གོ།",
    "རྒྱས་པ་ནི་རྣམ་པར་དབྱེ་བ་སྟེ། ༐",
    "ཅིའི་ཕྱིར་ས་བཅུ་པོ་རྣམས་རབ་ཏུ་ད་གའ་བ་ཞེས་བྱ་བ་ལ་སོགས་པར་རྣམ་པར་གཞག་ཅེ་ན།",
    "བར་ཆད་དང་བཅས་པར་མང་དུ་མངོན་དུ་བྱེད་པའི་ཕྱིར་མངོན་དུ་གྱུར་ཏོ།",
    "རྣམ་པར་སྨིན་པ་ཁོ་ན་སྟེ།",
    "དེའི་གཉེན་པོར་དེ་བཞིན་གཤེགས་པའི་ས་རྣམ་པར་གཞག་གོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་གང་འདིས་རྣམ་པར་དགོད་པ་ཤེས་པའི་གནས་འདི་ནི་བསམ་གྱིས་མི་ཁྱབ་པའོ།",
    "ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སེམས་ད་པའ་ཆེན་པོ་ནི་ཆེན་པོ་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "གང་འདིས་རྣམ་པར་དགོད་པ་ཤེས་པའི་གནས་འདི་ནི་བསམ་གྱིས་མི་ཁྱབ་པའོ་ཞེས་བྱ་བ་ནི་འདིར་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ས་ཡིན་པར་སྟོན་ཏོ།",
    "འདི་ཀུན་རྣམ་པར་ངེས་པ་སྟེ།",
    "ཉན་པར་འདོད་པས་༢འཇིགས་པ་མེད།",
    "ཅིའི་ཕྱིར་རྣམ་པར་གྲོལ་བའི་ཟླ་བས་ཐོག་མ་ཉིད་དུ་བསྐུལ་བ་བརྩམས་ཤེ་ན།",
    "འཁོར་དེ་ཡང་འདུས་པར་འགྱུར་བའི་ཕྱིར་ར་རོ།",
    "ཞེས་བྱ་བས་གསུངས་སོ།",
    "ཅིའི་ཕྱིར་ཀུན་དུ་རྟོག་པ་ད་ག་པར་འགྱུར་བ་ཉིད་ཀྱིས་སྟོན་ཞེ་ན།",
    "ཀུན་དུ་རྟོག་པ་རྣམས་ནི་རྣམ་པར་རྟོག་པ་ནམས་ཏེ།",
    "སེར་སྣ་ནི་སེམས་ཀྱིས་ཀུན་དུ་འཛིན་པའོ་། དེ་ལ་ཡོན་ཏན་ལྡན་པ་ཉིད་ཀྱིས་ཁྲོ་བ་མེད་པ་ལ་སོགས་པའི་ཡོན་ཏན་ད་ང་ལྡན་པས་ཉེས་པ་དང་པོ་མེད་པར་སྟོན་ཏོ།",
    "ས་བརྗོད་ནས་ཞེས་བྱ་བས་ནི་ཉེས་པ་གཉིས་པ་མེད་པར་སྟོན་ཏོ།",
    "ཁྱབ་བད་ག་ཅེས་བྱ་བས་ནི་ཉེས་པ་གསུམ་པ་མེད་པར་སྟོན་ཏོ།",
    "འདི་ཀུན་རྣམ་པར་ངེས་པ་སྟེ།",
    "རྣམ་པར་ངེས་པ་ཞེས་བྱ་བ་ནི་མཁས་པ་སྟེ།",
    "རྣམ་པར་ངེས་པ་ཉིད་དེ་ཡང་རྣམ་པ་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "འཆད་པ་པོ་དེ་ཉིད་ཀྱིས་དེ་ཁོང་དུ་ཆུད་པས་ཡོང་ས་སུ་ཟིན་པར་རྣམ་པར་ངེས་པ་ཉིད་ད་དོ།",
    "རྣམ་པར་ངེས་སུ་ཟིན་ཀྱང་དོན་དུ་གཉེར་བ་མ་ཡིན་ན་འཆད་པའི་སྣོད་དུ་མི་འགྱུར་ཏེ།",
    "ཉན་པར་འདོད་པ་ཞེས་བྱ་བས་གསུངས་ས་སོ།",
    "དོན་ལྐོག་ཏུ་མ་གྱུར་པ་ནི་འཇིགས་པ་མེད་པར་འགྱུར་ར་རོ།",
