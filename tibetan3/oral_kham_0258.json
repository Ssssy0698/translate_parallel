    "དེ་ཡེ་ནས་ནམ་མཁའ་ལྟར་ཁྱབ་བདལ་དུ་འདུག་པ་དེ་ལ།",
    "ཀུན་འབྱུང་རང་ལ་ཤར་བ་ཅེས་པ།",
    "ཉི་ཟླ་དང་གཟའ་སྐར་ཐམས་ཅད་དུས་གཅིག་ཏུ་ཤར་ནས་འདུག་པ་ལ།",
    "སྒྲ་རུ་གྲགས་པ་དང་རང་བཞིན་མེད་པའི་ཁྱད་པར་ལ་ཡིད་ཆེས།",
    "འོན་ཏང་ན་གསུང་རང་བཞིན་མེད་པའི་སྒོ་ནས་འབྲས་བུ་ཐོབ་ཅེས་བྱའོ།",
    "འགྲོ་ཞིང་འདུག་པའི་འགྱུར་བ་ཡང་མེད་ལ།",
    "གཡུང་ལ་ནམ་མཁའ་ཐམས་ཅད་ཀྱི་དྲུང་ན་འདུག་པས་དྲུང་ངོ།",
    "གཡུང་ལ་ཐམས་ཅད་ཀྱི་དྲུང་ན་འདུག་པས་ནི་དྲུང་ངོ།",
    "ཐམས་ཅད་ཀྱི་དྲུང་ན་འདུག་པས་དྲུང་ངོ།",
    "ལྟམ་མེ་མི་གཡོ་བར་དུ་འདུག་པ་ནི།",
    "བོན་ཉིད་ཀྱི་རང་བཞིན་ཁྱབ་བདལ་དུ་འདུག་པ་ནི་ལེ་ཡིན་ནོ།",
    "དེ་ལ་འདི་ཙམ་ཡོད་པ་གཞན་ཅིས་ཀྱང་རང་བཞིན་གཞལ་ཅིང་དཔག་ཏུ་མེད་པས་ནི།",
    "དེ་ཡང་རང་བཞིན་མེད་ལ།",
    "བསྐལ་པར་མི་འགག་དུས་གསུམ་སྟོན་པར་འགྱུར།",
    "ངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོར་གནས།",
    "འདུག་དང་གནས་པའི་སྣང་ཡུལ་རྣམས།",
    "གནས་འདུག་ཟིན་པའི་གོལ་ས་མེད།",
    "གང་དུ་འདུག་ཀྱང་བདེན་པའི་གནས།",
    "ངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོ་ལས།",
    "བེ་རོ་ཙ་ནས་མནྡལ་གསེར་གྱིས་བརྒྱན་པ་གཅིག་ཕུལ་ནས་ཞུས་པ།",
    "བར་སྣང་ཁམས་སུ་གྲག་སྟོང་རང་སྒྲ་གྲགས།",
    "བི་རོ་ཙ་ན་ཉོན་ཅིག།",
    "གལ་ཏེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "རང་རང་མཐུན་པའི་ཁྲི་ལ་བཞུགས་སུ་གསོལ།",
    "ང་རང་ཚ་བ་རོང་དུ་སྨྱུག་༧ དེའི་ཚེ་སེམས་དཔའི་མཆོག་ཏུ་གྱུར་པའི་ཁོད་སྤུངས་དྲན་པ་ལ་ཞུས་པ།",
    "བསྟན་པའི་དོན་དང་རང་གཞན་དོན་ཆེན་མཛོད།",
    "མི་རུས་ལ་སོགས་རུས་རྙིང་འཚོགས་ཚད་ཐང་བཏང་དབེན་པར་འདུག།",
    "བེ་རོ་ཙ་ནས་གཡུའི་ནེ་ཙོ་སྨྲ་ཤེས་ཕུལ་ནས་ཞུས་པ།",
    "ངོ་བོ་དུས་ལྔ་བརྒྱའི་སྟོན་པ་འགྲོ་བ་རྣམས་དང་ཁྱད་པར་བོད་ཡུལ་གྱི་དཔལ་མགོན་ཁྱེད་ཉིད་དུ་ངེས་པར་གདའ་བས།",
    "ཚོར་ལ་ཞེན་མེད་ཚོར་སྟོང་རང་ཞི་དབྱིངས།",
    "བེ་རོ་ཙ་ན།",
    "ད་ཅིའི་གནས་ལུགས་གསལ་སྟོང་རྗེན་པ་དེ་དང་གཉིས་ལ་ཁྱད་པར་འདུག་མི་འདུག་བལྟ།",
    "བེ་རོ་ཙ་ན་ལེགས་པར་ཉོན་དང་།",
    "རྩེ་གཅིག་དུས་སུ་རྟོགཔ་གང་ཤར་དྲན་པས་ས་ཁྱཤྩ།",
    "རོ་གཅིག་དུས་སུ་རྟོག་པའི་བློ་ཡིས་རྩོལ་བ་ཆེར་མི་དགོས་ཏེ",
    "བྲ་མཁས་པ་བེ་རོ་ཙ་ན་ཐུགས་མ་རྨོངས་དགོངས་པ་རྒྱ་ཆེར་མཛོད།",
    "དེ་མིན་མ་དག་ཞིང་དུ་གདའ་བས་མ་འགྱུར་རོ།",
    "ལུས་དམན་པར་འདུག་ཀྱང་དགོངས་པ་མཐོ།",
    "བསྒོམས་ཤིག་འདུག་ཚུལ་མ་བསླད་བསྒོམ།",
    "བེ་རོ་ཙ་ན་མི་ལུས་རྒྱལ་བའི་ཐུགས།",
    "རྟགས་ནི་སེང་གེའི་ཁྲི་ལ་འདུག་པ་དང་།",
    "མུན་ཁང་དང་བལྟ་སྟངས་ངེས་པ་ཅན་ཡང་ཕྱག་ལེན་ལ་མཛད་པར་གདའ།",
    "གོང་མ་མང་པོ་དག་དུས་ཞབས་སྙན་བརྒྱུད་ལས།",
    "སྔར་གྱི་ལས་རྟགས་སྣང་ཅུང་ཟད་མི་གསལ་དུ་འགྲོ་ཡིན་འདུག་ན།",
    "རྟགས་སྣང་ཡལ་ནས་ལས་སྣང་འདུག་པའམ།",
    "མཚན་ཉིད་ཤེས་ཚུལ་ཡང་རང་སེམས་ཙམ་ཡིན་པར་ཉམས་སུ་མྱོང་བའོ།",
    "རྔུབ་པའི་ཚེ་གཡས་འགེགས་པ་ལག་ལེན་ཁ་ཅིག་ལ་འདུག་ཀྱང་།",
    "ཐོག་མ་ནས་མཉམ་རྒྱུར་འདུག་ན་ལེགས།",
    "རྐང་པ་ཟླུམ་པོའི་འདུག་སྟངས་དང་།",
    "མཉམ་རྒྱུར་འདུག་ན་ལྟ་སྟངས་ཐད་ཀར་བྱས་ལ་མྱུར་བར་རྔུབས།",
    "ནང་དུ་འཇུག་དུས་སེམས་ཉིད་དང་བསྲེ།",
    "འདུག་སྟངས་ལ་བསླབ་པས་སྲོག་ཐུར་བསྲེ་བ་བརྟན་པོར་བྱེད་པ་དང་།",
    "ཁྲོ་བོ་སེང་གེའི་འདུག་སྟངས་ནི།",
    "ཞི་མ་ཁྲོ་གླང་པོ་ཆེའི་འདུག་སྟངས་ནི།",
    "རྣམ་སྨིན་གྱི་ལུས་གནས་མ་འགྱུར་ཡང་རང་སེམས་ལྷ་སྐུར་དངོས་སུ་གྱུར་པ་དང་།",
    "སེམས་འོད་གསལ་དུ་འཇུག་དགོས་པར་འདུག་སྙམ་དུ་འདུན་པས་མཚམས་སྦྱར་ལ།",
    "དེ་ཐིག་ལེ་ཁྲ་བོར་གྱུར་པ་འདར་ཁྲིལ་ལི་ལི་འདུག།",
    "ཁྱད་པར་ཐུན་མཚམས་འགྲོ་འཆག་ཉལ་འདུག།",
    "རྨི་ལམ་དུའང་ཕལ་ཆེར་འཆར་གྱིན་འདུག་ན།",
    "གསལ་མི་གསལ་ལ་སྔར་དང་ཁྱད་མི་འདུག་ན།",
    "འགྲོ་འཆག་ཉལ་འདུག་སྤྱོད་ལམ་ཀུན་ཏུ།",
    "རང་ཡུལ་དང་རང་ཁྱིམ་ལ་ཞེན་པ་དང་།",
    "མཉམ་མེད་བུ་རམ་ཤིང་པས་བདག་ཅག་དུས་ཀུན་ཤིས་པས་བསྐྱངས་དུ་གསོལ།",
    "ལྷོ་ཕྱོགས་སུ་འགྲོ་ཐབས་གཅིག་འདུག་ནས་ཀྱང་།",
    "སླར་ཡང་ལྷོ་ཡི་ཕྱོགས་ཕྱིན་བཏང་སྙོམས་འདུག།",
    "ཀློག་པའི་གྲྭར་ཕྱིན་ལོ་ངོ་གསུམ་དུ་འདུག།",
    "ཀློག་པའི་གྲྭ་རུ་སྔ་མ་འདུག་པའི་ཚེ།",
    "ལྷོ་ཕྱོགས་རི་བོའི་སྤོ་ལ་བདག་འདུག་༡༢༥ཚེ།",
    "བླ་སློབ་ཆེ་གཉེན་སྒྲུབ་འདོད་ཁོ་ནར་འདུག།",
    "ཉམས་རྣམས་སུ་ལའང་མ་སྨྲས་རང་གར་འདུག།",
    "ལོ་གསུམ་འདག་སྦྱར་དམ་པོས་བཅད་དེ་འདུག།",
    "བདག་ཉིད་དབུ་རྩེ་དམར་པོའི་མདུན་འདུག་པའི།",
    "འདག་སྦྱར་ནས་བྱུང་ཞག་འགའ་ཙམ་འདུག་ནས།",
    "གཉའ་གཉའ་ཞེས་བྱར་དབེན་པ་བྱས་ཏེ་འདུག།",
    "རྒྱ་ཡན་གློད་ཅིང་རང་གར་དོར་ན་ཡང་།",
    "བརྐྱང་བསྐུམ་འགྲོ་འདུག་མི་བདེ་ན།",
    "དུག་དུས་ཁུར་ལྕི་བརྡེག་པས་འཁྲུག།",
    "དེ་ལྔ་རང་རང་འདྲེས་པ་དང་།",
    "དྲོ་བའི་གནས་དང་མལ་དུ་འདུག།",
    "རནའ་༡༤རྒྱུས་དད་ཅན་ཁ་ཡིན་འདུག་པ་དང་།",
