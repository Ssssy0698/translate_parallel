    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོའི་གཙུག།",
    "སླར་ཁྱེད་རང་རྣམས་ཀྱིས་ཉམས་སུ་ལེན་པའི་ཚུལ་ནི།",
    "བདེ་བའི་གདན་ལ་བསམ་གཏན་གྱི་སྤྱོད་ལམ་དང་ལྡན་པས་འདུག་སྟེ།",
    "རྐང་པ་གཉིས་བསྣོལ་ཏེ་ཙོག་པུར་འདུག།",
    "ཁྱེད་རང་རྣམས་ལ་ཕོག་པས་རྣམ་སྨིན་གྱི་ལུས་སྦྱངས་ཏེ་འོད་གསལ་སྟོང་པ་ཉིད་ཀྱི་ངང་ལས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྐུའི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་རྗེས་སུ་གནང་བ་ཞུ་བའི་ཡོན་དུ་མཎྜལ་ཞིག་འབུལ་བར་ཞུ།",
    "རྗེ་བཙུན་ས་སྐྱ་པ་ཡབ་སྲས་སོགས་ལས་བརྒྱུད་པ་བར་མ་ཆད་པར་བྱོན་པའི་རྗེས་སུ་གནང་བ་བསྒྲུབ་པ་ལ་སློབ་དཔོན་གྱི་བྱ་བ་གྲུབ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ།",
    "སྟན་བདེ་བ་ལ་འདུག་ལ།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ་བདག་བསྐྱེད་སྔོན་དུ་འགྲོ་བས།",
    "མིའུ་ཐུང་གེལ་པའི་འདུག་སྟངས་ཀྱིས་རོའི་སྟེང་ན་བཞུགས་པ། ། དེའི་གཡས་ན་བྱ་ནག།",
    "སྒོ་རྩར་ཕྱིན་པ་དང་རང་རི་ཁྲོད་མར་གསལ་བའི་སྐུ་ལས་ཡེ་ཤེས་ཀྱི་མེ་འབར་བས་གནས་ཁང་ཕྱི་ནང་ཐམས་ཅད་དང་།",
    "པར་བུ་གཅིག་འདུག་པ་དེའི་ནང་ནས་རྐང་མགྱོགས་ཀྱི་རྫས་བཏོན་ཞིང་རྐང་པ་ལ་བསྐུས་གསུངས་གནང་བྱུང་བས།",
    "ཕུང་པོ་འདོན་པའི་སེམས་ཁྲལ་མི་དགོས་པ་འདུག་སྙམ་ནས།",
    "དེ་བས་འདིར་མ་འདུག་པར་རྟག་སྣ་ཞེས་བྱ་བའི་ལུང་པ་ཞིག་ཏུ་རྒྱུག་དང་།",
    "དྲུང་པ་ཁྱེད་སྐུ་གཟུགས་མ་བདེ་བ་ལ་བཞུགས་མི་ཚུགས་པ་ཞིག་འདུག་ཟེར་བྱུང་བ་ལ།",
    "ང་སྡོད་དང་སྡོད་དེ་འདི་ན་བྲག་ཕུག་ཁ་བྱང་བསྟན་ཞིག་ཡོད་ཟེར་འདུག་པས་དེ་བཙལ་བ་ཡིན་གསུངས་པས།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རང་ཉིད་ཀྱང་ཁ་ནུབ་ལ་ཕྱོགས་ཏེ་སྟན་བདེ་བ་ལ་བ་ལ་འདུག་ནས།",
    "དེ་ནས་ཐུན་བསྡུ་བ་དང་རང་ཉིད་རྩ་སྔགས་ལ་ཐིམ།",
    "ལོ་ཀག་ཟླ་ཀག་ཞག་ཀག་དུས་ཀག་ཐམས་ཅད་ཞི་བར།",
    "འཕྲོ་མཁན་དང་ལྟ་མཁན་གཉིས་སུ་མེད་པར་ཁོ་རང་གཉིས་གཅིག་ལ་གཅིག་ཐིམ་པ་ལྟ་བུར་གྱུར་ནས།",
    "གཞལ་ཡས་ཁང་རང་ལྷ་སྐུར་གསལ་བ།",
    "འགྲོ་འདུག་བསྐོར་བ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "གནས་དབེན་པར་བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་སྤྱོད་ལམ་དང་ལྡན་པས་འདུག་སྟེ།",
    "དབུས་ནས་བེ་རོ་ཙ་ན་ཨོྃ",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་སྐྱབས་སེམས་ནི།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས་ཨོཾ་སུམྦྷ་སོགས་བརྗོད།",
    "ལྷ་རྣམས་རང་རང་སྤྱི་བོར་ཨོཾ",
    "རང་རང་ཐུགས་ཀའི་འོད་ཟེར་གྱིས་ཡེ་ཤེས་པ་སྤྱན་དྲངས་ཏེ།",
    "རང་རང་གཟུགས་མཆོག་མངོན་དུ་བསྟན་ནས་ཀྱང་",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས",
    "འགྲོ་འཆག་ཉལ་འདུག་དུས་ཀུན་ཏུ།",
    "ཟླ་སྟེང་རང་འདྲའི་ཡེ་ཤེས་པའི",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་། མར་དཀྱིལ་འཁོར་དུ་འཇུག་པའི་ཕྱིར་མཎྜལ་ཕུལ།",
    "ཞེས་བརྗོད་། པས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཁྲིད།",
    "རང་རང་སོ་སོའི་གནས་སུ་དེངས།",
    "ལྷ་ཚོགས་རྣམས་ཀྱི་སྐུ་ལས་འོད་ཟེར་དཀར་པོ་བདུད་རྩིའི་རང་རང་བཞིན་ཅན་དཔག་ཏུ་མེད་པ་འཕྲོས་པས་འཕགས་པ་རྣམས་མཆོད།",
    "དེ་དག་དུས་རབས་གང་དུ་བྱུང་ཡོད་པ།",
    "༡༨རྒྱ་གར་གྱི་ཡུལ་དུ་སྐུ་རང་བྱུང་དང་གསུང་རང་བྱུང་༩ བ་༦ང་༩༥༨དང་།",
    "༢༧༡༣༤ང་༢ རང་བྱུང་རང་ཤུགས་ཀྱི་སྤྱོད་པ།",
    "ག་༢ ཉལ་བ་དང་འདུག་པའི་རྣལ་འབྱོར་ལ་གཉིས།",
    "༢༧༢བ་༡ང་༢ང་༢༧༦བ་༦ང་༢༧༧བ་༥ངང་༢ འདུག་པའི་རྣལ་འབྱོར།",
    "༥༤ན་༦ངག་༡༣ འདུག་པ་བཞི།",
    "༨༣བ་༣ང་རང་བཞི་༨བ་༥ང་༨༥ན་༡ངཆ་༢ ལྟ་བའི་ངེས་ཚིག་༨༣བ་༤༣ངཅ་༣ དེ་གཉིས་སུ་མེད་པ་ལ་བསྒྲིབས་པས་ངོ་མ་ཤེས་པ་༥ཏཆ་༣ ལྟ་བའི་དབྱེ་བ།",
    "༦ན་༡ང་༦༡༡ངཆ་༢ གཞི་སྣོད་ཀྱང་རང་བཞིན་གྱིས་འཇིག་པའི་ཚུལ་ལ་ཅ་༢ གནས་པའི་བསྐལ་པ་བསྟན་པ་ལ་གཉིས།",
    "༢༡༩བ་༣ང་རང་རིག་དང་གཞན་རིག་མཚུངས་པ།",
    "ཌ་༩བ་༤ང་༩ ༡ན་༢ང་༨༥ན་༣ང་༨༥བ་༦ངག་༥ སྐུ་གསུམ་ཞིང་ཁམས་དང་བཅས་པ་ཡང་རང་རིག་ག་༣ རང་གནས་དང་རང་ཤར་གཉིས་ལ་བཟང་ངན་༢",
    "པོར་བསྟན་པའི་གྲོགས་སུ་རྐྱེན་སྣང་རང་ཡལ་དག་༩༣ན་༤ང་༩༣བ་༦ང་པའི་གདམས་པ་གཅེས་པ་ལ་བཅུ་གསུམ།",
    "མ་༢ དངོས་པོ་འདུག་ཚུལ་གྱི་གེགས་བསལ་བ།",
    "ན་༢ ཁར་ཕོག་དུས་མེད་པའི་ཁ་གཏམ་པ།",
    "༣༦༣ན་༦ང་༣༦༧ན་༣ང་༣༥༩ན་༥ང་༣༦༣ན་༦ང་ཇ་༡ དབྱིངས་ཀྱི་འདུག་ཚུལ།",
    "༡༢༤ན་༦ང་༡༢༤ནང་༧ངཟ་༢ ཁར་ཕོག་དུས་མེད་པའི་ཁ་གཏམ།",
    "༡༢༧ན་༢ང་༣ང་༡༢༧ན་༣ང་༡༢༧བ་༡ང་ར་༡ འཁྲུལ་པ་རྩད་བཅད་པས་འཁོར་འདས་ལྟོ་བཟློག་༡༢༨ན་༡ང་༣ང་༡༢༨ན་༡ང་༢ང་༡༢༨ན་༢ང་༣ང་༡༢༨ན་༣ང་༡༢༨ན་༣ང་༧ངཡ་༡ དངོས་པོ་འདུག་ཚུལ་གྱི་གེགས་བསལ་བ་ལ་གསུམ།",
    "ང་༧ མེད་པའི་རང་ངོའི་འདུག་ཚུལ་བསྟན་པ།",
    "༤བ་༣ང་༤ངང་༡ ངོ་བོ་འདུག་ཚུལ་ངོས་གཟུང་བ།",
    "༣༦ན་༡ང་༢ང་རང་བཞིན་དུ་རྟོགས་པར་བྱ་བ་ལ་གཉིས།",
    "༣༧ན་༡ང་༣༩ བ་༦ང་རྞ་༣༣བ་༧ང་༣༤ན་༢ངང་༡ སྣང་ཡང་རང་བཞིན་མེད་པའི་གཞི་བསྟན་པ།",
    "༢ན་༢ང་༣ན་༡ང་༡༡ན་༡ང་༡༡བ་༢ངག་༡ གཞི་འདུག་ཚུལ་གྱི་ཕུན་སུམ་ཚོགས་པ།"
  ]
}