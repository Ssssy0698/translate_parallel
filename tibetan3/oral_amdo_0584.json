    "དེ་རེ་རེ་ལ་སྤྲུལ་པའི་རྒྱལ་པོ་ཆེན་པོ་རེ་རེ།",
    "ཡུལ་རེ་རེ་ལའང་ཡུལ་གསོར་བརྒྱ་ཕྲག་རེ་རེ་ཡོད་པ།་",
    "ཡུལ་འཁོར་རེ་ཡང་གྲོང་འབུམ་ཕྲག་རེ་ལ་བྱེད་པས་ཡུལ་ཆེན་པོ་རེར་གྲོང་བྱེ་བ་རེ་ཚང་བ།",
    "ལྷ་ལྡན་གྱི་ཡུལ་ཞེས་བསྔགས་པའི་ཁ་བ་ཅན་གྱི་ལྗོངས་འདི་འཕགས་པ་གང་གི་ཐུགས་རྗེས་ཡོངས་སུ་བཟུང་བའི་ཞིང་ཁམས་ཏེ།",
    "བཙུན་མོ་ཚེ་སྤོང་བཟའམ།",
    "ཕྱག་ན་རྡོ་རྗེའི་སྒྲལ་པ་བློན་པོ་མགར་སྟོང་བཙན་གྱིས་བལ་པོའི་རྒྱལ་པོ་འོད་ཟེར་གོ་ཆའི་སྲས་མོ་སྒྲོལ་མ་ཁྲོ་གཉེར་ཡོ་གྱི་སྔལ་པ་དང་།",
    "རྒྱ་ནག་སྟོང་ཁུན་རྒྱལ་པོ་ཐང་ཐའི་ཛུང་གི་སྲས་མོ་ལྷ་ལྕག་ཡོང་ཇོ་སྒྲོལ་མ་སྔོན་མོའི་སྔལ་པ་གཉིས་བཙུན་མོར་བསུས།",
    "ལྷོ་ནུབ་རྔ་ཡབ་གླིང་གི་ཚུར་རོལ།",
    "ཁ་ཆེ་བདེ་ལྡན་བྱ་བར་འཁོར་ལོ་སྡོམ་པའི་རིག་པ་འབུམ་ཕྲག་གཅིག་སོང་བའི་ཐོ་རངས།",
    "ཕྱིར་ཕེབས་ཁ་ཆེའི་ཡུལ་གུར་ཀུམ་གྱི་ལྗོངས་ཤིང་ཀུན་སྐྱེས་པའི་རི་བོར་པུཥྛ་ཧ་རི་ཞེས་དཔལ་མེ་ཏོག་མདངས་འཕྲོག་གི་གཙུག་ལག་ཁང་བཏབ།",
    "རང་དང་གཞན་གྱི་གྲུབ་པའི་མཐའ་ལ་ཞུགས་པའི་མཁས་གྲུབ་གང་གིས་ཀྱང་འགྲན་པར་མི་ནུས་པས།",
    "བཅོམ་ལྡན་འདས་འཁོར་ལོ་སྡོམ་པས་བསྐལ་པ་བཟང་པོའི་སཇིརྨི་རྒྱས་མོས་པར་ལུང་བསྟན།",
    "གྲུབ་ཆེན་གླིང་གིས་ནཱ་རོ་པ་ཆེན་པོར་བསྔགས།",
    "ཉམཐར་སྐུ་ཚིགས་ཉི་ཤུ་རྩ་གཅིགཤེ་ལ་སྤྱན་རས་གཟིགས་ཉི་ཤུ་རྩ་གཅིག་སོགས་སྐུ་གདུང་ལྷ་སྐུ་དང་རིང་བསྲེལ་གྱི་ཕུང་པོར་བསྟན་ཏེ་ངོ་མཚར་བའི་དགའ་སྟོན་ཅི་ཡང་འགྱེད་པར་མཛད་དོ།",
    "སྐབས་གསུམ་པའི་མཛེས་སྔག་ལ་ཅོ་འདྲི་བའི་སྐྱེས་པ་དང་བུད་མེད་རྣམས་ཕན་ཚུན་ལྟ་བའི་རྩེ་དགས་ཚིམ་པ།",
    "འཁྲལ་ཞིག་ནམ་མཁའི་རྣལ་འབྱོར་གྱི་དྲིན་ལས་གདོད་མའི་གནས་ལུགས་གཟིགས།",
    "མཐའ་དམག་གི་འཇིགས་པ་སྐྱོབ་ཕྱིར།",
    "གུ་རུ་དྲག་པོ་དམར་ཆེན་གྱི་ཞས་གཟིགས་ཏེ་བར་ཆད་ཀྱི་གཡུལ་ལས་རྒྱལ།",
    "རྒྱ་གར་གྱི་གྲུབ་ཐོབ་ཕོ་མོ་བརྒྱད་ཅུ་རྩ་བཞི་ཚོགས་ཀྱི་འཁོར་ལོའི་དགའ་སྟོན་ལ་འདུས།",
    "དྲི་བཟང་པོའི་ལྗོན་ཤིང་གི་ནགས་། ཡའི་ཡུལ་ལྟ་བུ།",
    "མེ་ཏོག་གི་ཆར་བབས་པ་སོགས་ངོ་མཚར་བའི་དགེ་མཚན་དུ་མ་དང་ལྷན་ཅིག་འཁྲུངས་མ་ཐག།",
    "འཁྲུངས་ནས་ཞག་ཉི་ཤུ་ཙམ་སོང་བའི་ཚེ།",
    "མངོན་མཁྱེན་ཐོགས་མེད་དུ་ལུང་སྟོན་པ་སོགས་དམ་པའི་ཀུན་སྤྱོད་འབའ་ཞིག་གིས།",
    "འཇིག་རྟེན་གསུམ་གྱི་གཙུག་གིས་བསྟེན་པའི་སྔར་གྱི་གདན་སེང་གེའི་ཁྲིར་ཕེབས་པའི་ཚེ་ལྟས་ཁྱད་པར་ཅན་མང་དུ་བྱུང་།",
    "བྱང་ཕྱོགས་འགྲོ་བའི་རྩ་ལག་ཐུགས་རྗེ་ཆེན་པོ་རང་བྱོན་བཅུ་གཅིག་ཞལ་གྱི་སྐ་ཡོ་བ་བསྲངས་པས་སྤྱན་རས་གཟིགས་མངོན་སུམ་དུ་ཡིད་ཆེས།",
    "མཐོང་ཐོས་དྲན་རེག་གི་གདུལ་བྱ་མཐའ་དག་སྨིན་གྲོལ་ལ་སི་། བཀོད།",
    "དད་རྟེན་དུ་དཔོན་ས་བདག་མོ་ལ་ཕུལ་ཅིག་གསུངས་ནས་འབུལ་དུ་བྱོན་པས།",
    "ཐུགས་རྗེའི་སྤྱན་རས་གཟིགས་པ་ལྷང་བས་རིགས་དང་ལེཪྴས་ལྡན་བློ་གྲོས་པདྨ་དཀར་པོའི་ཚལ།",
    "ཛམྦུའི་གླིང་གི་ཡུལ་དབུས་རྒྱ་གར་གྱི་རྒྱལ་ཁཟློས་ཡུལ་འཁོར་ཆེན་པོ་བཅུ་དྲུག་གི་ནང་ཚན་ཤར་ཕྱོགས་ཟ་ཧོར་གྱི་ཡུལ་བྷངྒ་ལ་གྲོང་ཤིང་ཐགས་ཅན་དུ་རྒྱལ་པོ་ཤིང་རྟ་བཅུ་པའི་སྲས་མྱ་ངན་མེད་བྱོན།",
    "ཡི་དམ་གྱི་ལྷ་མང་པོའི་ཞལ་གཟིགས།",
    "བོད་ཆོལ་ཁ་གསུམ་ཡོངས་སུ་གང་བས་རྒྱལ་བསྟན་ཝོ་མོར་མཛད་དོ།",
    "བྱ་བཀྲ་ཤིས་དར་རྒྱས་ཀྱི་སྲས་མོ་༣༣་ཡོད་སྒྲོལ་མ་ཁབ་ཏུ་བཞེས་པར།",
    "ཐུགས་རྗེ་ཆེན་པོས་འགྲོ་བ་མཐའ་དག་ལ་གཟིགས་ནས་མཆོག་གི་སྤྲུལ་པའི་སྐུ་ཉིད་བྱོན་ཞིང་།",
    "གཞུ་འདོམ་སྟོང་དང་སོ་གསུམ་ལྷག་པའི་ནོར་འཛིན་གྱི་ཁྱོན།",
    "འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་ཐུགས་རྗེའི་སྒྱུ་འཕྲལ་ལས་གྲུབ་པའི་ཞིང་ཁམས་ཆེན་པོའི་དབུས་འགྱུར་འཆང་།",
    "ཡར་མོ་ཀླུངས་ཞེས་པའི་སའི་ཆ།",
    "ཉྫི་ལྟར་དམ་པ་ཏོག་དཀར་དགའ་ལྡན་ནས་འཕྲུལ་ཆེན་མོའི་ལྕམས་སུ་ཞུགས་པ་ཇི་བཞིན།",
    "མཛེས་ཤིང་ལྟ་ན་སྡུག་པའི་སྐྱེས་པ་དང་བུད་མེད་རྒྱན་གོས་ཅན་མང་པོས་བསྐོར་ཞིང་འདུད་པ་དང་།",
    "ལྷག་པར་བུད་མེད་རྒྱན་ཅན་མཛེས་མ་གཉིས་ཀྱིས་དུས་རྒྱུན་དུ་བསྲུང་བའི་མེལ་ཚེ་དང་རིམ་གྲོ་བྱེད་པ་རྟག་པར་བྱུང་།",
    "ཁང་བཟང་གི་སྟེང་འོག་བར་གསུམ་དཀར་པོར་སོང་བ་སོགས་ཡ་མཚན་པའི་ལྟས་སྣང་མང་དུ་བྱུང་བར་གསལ་ལ།",
    "གཞན་ཡང་ཡུལ་ཕྱོགས་དེར་དགུན་གྱི་གྲང་རེག་གིས་རྩུབ་པའི་དུས་ཀྱང་མེ་ཏོག་པདྨ་མང་པོ་ཤར་བ་དང་།",
    "ར་། དཔལ་ཡེ་ཤེས་ཀྱི་ལྷ་མོ་ལ་གཏོར་མ་རྒྱས་པར་ཕུལ་ནས།",
    "ཕྱི་དེ་ན་བུ་མོ་མང་པོ་འདུག་པ་དེ་རྣམས་ཀྱིས།",
    "དབུས་གཙང་གི་ཆ་ཤས་ཉམས་དགའ་བ།",
    "དེའི་འཁྲིས་ན་བུད་མེད་གཞོན་ནུ་སྒབ་རྩ་རིང་ངེ་བ་ཞིག་གི་གོས་ཀྱི་སྦུབས་ནས་བུ་ཆུང་ཞིག་བསྟན་བྱུང་བ་དང་།",
    "དེ་ན་ཅོག་གྲྭའི་རྟེན་གཙོ་ཐུབ་པ་ཟངས་ཐང་མ་དེ་ཁྲོ་ཁྲི་ཡིན་ནོ་སྙམ་པ་ཞིག་གི་ནང་ན་འགྱེལ་སྟབས་སུ་བཞུགས་འདུག།",
    "ཅི་དྲག་འདི་ཆུད་ཟོས་སུ་སོང་ཡོད་དམ་བྱས་པས།",
    "རེས་གཟའ་ཟླ་བ་དང་།",
    "སྐར་མ་ལག་འགྲོགས་པའི་བདུད་རྩིའི་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པའི་སྐྱ་རེངས་དང་པོའི་དུས་ལ་གནོད་པ་དང་སྙུན་མི་མངའ་བར་བདེ་བར་སྐུ་བལྟམས།",
    "ལྷའི་རོལ་མོའི་སྒྲ་དང་ལྷན་ཅིག་སྤོས་ཀྱི་དྲི་ཞིམ་པོས་ཕྱོགས་ཀུན་ཏུ་ཁྱབ།",
    "མེ་ཏོག་གི་ཆར་དང་།",
    "རྡོ་རྗེའི་རེ་ཁཱ་ཅན་གྱི་སྟན་དཀར།",
    "རྗེ་རང་གིས་དཔལ་ཡེ་ཤེས་ཀྱི་ལྷ་མོ་དུད་སོལ་མའི་ཞལ་དངོས་སུ་གཟིགས་པར་སྣང་ངོ།",
    "དགུང་ལོ་གསུམ་གྱི་ངོར་ཕེབས་པ་མྱས་བྱེད་དེ་ཤིང་མོ་ལུག་ལོ།",
    "བཀྲ་ཤིས་ཁ་བཏགས་རེའི་ཕྱག་རྟེན་དང་བཅས་ཕྱག་འབུལ་བ་འཐད་ཅེས་ཐམས་ཅད་ཞལ་དན།",
    "ཐམས་ཅད་ལ་གཟིགས་ནས་ཞལ་འཛུམ་འཛུམ་མཛད།",
    "ཐམས་ཅད་མོས་གུས་ཀྱིས་བ་སྤུ་གཡོ་བ་དང་།",
    "མི་སྣ་གཉིས་རང་གཟིགས་རྟོག་ལ་བྱོན་གསུངས།",
    "རྗེ་གོང་མའི་གཟིམས་དཔོན་ཆེན་མོ་འཇམ་དབྱངས་པད་དཀར་ཞབས་ཕྱིར་བྱོན།",
    "ཞལ་དཀར་ཉིན་མོ་བདེ་ལེགས་མས་གཙོས་པའི་འབུལ་ཆེན།",
    "མཆོག་གི་སྤྲུལ་པའི་སྐུ་དཔོན་སློབ་སྟག་རྩེར་སྤྱན་དྲངས།",
    "གང་ལ་མོས་པ་ཇི་ལྟར་དེར་འགྱུར་ནས།",
    "ཕྱོགས་འཛིན་གྱི་ཆང་གིས་མྱོས་པའི་རང་གཞན།",
    "ཨེ་མ་སྐད་ཅིག་རེ་རེ་ལ།",
