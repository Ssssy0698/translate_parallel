    "སྒྲ་ཙམ་དག་ཀྱང་དེ་རུ་འདུག་པ་ན།",
    "སྒྲ་ཙམ་དག་ཀྱང་དེ་རུ་འདུག་པ་ན།",
    "ཐམས་ཅད་ཕྱི་པར་འདུག་པས་ཐུགས་སྐྱོ་བའི་ཚེ།",
    "ཐམས་ཅད་ཕྱི་པར་འདུག་པས་ཐུཀས་སྐྱོ་བའི་ཚེ།",
    "རྣལ་འབྱོར་པ་ཨ་ཙིཏྟ་བྱོན་ནས་དེ་ལ་དྲིས་པས།",
    "དེ་ལྟར་ཡོན་ཏན་ཐམས་ཅད་རྫོགས་ཙ་ན་སྟོབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟེ།",
    "དེ་ལྟར་ཡོན་ཏན་ཐམས་ཅད་རྫོགས་ཙ་ན་སྟོབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟེ།",
    "དེ་ཡང་རང་ཆས་སུ་གནས་པའི་ཡེ་ཤེས་ཡིན་ལ།",
    "དེ་ཡང་རང་ཆས་སུ་གནས་པའི་ཡེ་ཤེས་ཡིན་ལ།",
    "ངོ་བོ་སྟོང་པར་འདུག་པ།",
    "ངོ་བོ་སྟོང་པར་འདུག་པ།",
    "དེ་ཐམས་ཅད་ཀྱི་ངོ་བོ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སུ་ལྷན་གྱིས་ཤེས་ཙ་ན།",
    "དེ་ཐམས་ཅད་ཀྱི་ངོ་བོ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སུ་ལྷན་གྱིས་ཤེས་ཙ་ན།",
    "ནམ་མཁའ་དེ་ལ་མཚན་ཉིད་ཡོན་ཏན་བཞི་ལྡན་དུ་འདུག་པ་ལྟར།",
    "གཉིས་མེད་གོམས་པས་དུར་ཁྲོད་གནས་སུ་འདུག་པར་བྱ།",
