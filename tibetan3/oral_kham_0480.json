    "རྒྱ་དམག་མང་པོས་ལམ་དུ་དཀར་ཐིག་ཞིག་འཐེན་ཏེ་འདིའི་མན་ལ་སླེབས་ན་མེ་མདའ་རྒྱག་རྒྱུ་ཡིན་ཞེས་སྡིགས་ར་སྐུལ་འདུག་པ་དང་།",
    "ཟེར་བ་སོགས་ཀྱི་འབོད་ཚིག་སྒྲོག་བཞིན་དུས་ཡུན་ཙམ་གྱི་རིང་ངོ་རྒོལ་བྱས་པའི་གནས་ཚུལ་བྱུང་འདུག་ཅིང་།",
    "བྲོས་བྱོལ་དུ་ཕྱིན་པ་སོགས་བསམ་ཡིད་ལས་འདས་པའི་ཡིད་སྐྱོ་བའི་གནས་ཚུལ་བྱུང་འདུག་པ་དང་།",
    "སྐལ་བཟང་སྒྲོལ་མ་གཉིས་སུ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༥༣ ཡིན་འདུག་པ་དང་།",
    "སྐད་བསྒྱུར་བོད་པ་ཞིག་ལས་གཞན་རྣམས་ཕལ་ཆེར་རྒྱ་མི་ཡིན་འདུག་སྐབས་དེར་དངོས་དག་ལ་དེ་སྔོན་རྒྱ་ཁབ་ལ་ངོ་རྒོལ་བྱེད་དགོས་དོན་དམིགས་ཡུལ་ཇི་ཡིན་འདྲི་སྐབས།",
    "དེ་སྔར་ཁོང་དཀར་མཛེས་བཙོན་འོག་ཏུ་སྡོད་སྐབས་ཡང་རོགས་མང་པོ་ཞིག་དང་མཉམ་དུ་རྒྱལ་བ་བསྟན་འཛིན་རྒྱ་མཚོ་སྐུ་ཚེ་ཁྲི་ལོར་བརྟན་པ་ཤོག་ཅེས་སོགས་ཀྱི་སྐད་འབོད་ཤུགས་ཆེན་བྱས་རྐྱེན་གྱིས་ཉེན་རྟོག་པས་མི་སྤྱོད་ལས་འདས་པའི་རྡུང་རྡེག་བཏང་ཡོད་འདུག་པ་དང་།",
    "བཅས་བཙན་འཕྲོག་བྱས་པ་སོགས་ཀྱི་གནས་ཚུལ་བྱུང་འདུག་༢",
    "ཁོང་ལ་མེ་མདའི་མདེའུ་ཐེབས་ནས་ས་ལ་འགྱེལ་སྐབས་མཆན་འོག་ནས་ཁྲག་ཐོན་གྱིན་ཡོད་པ་མི་མང་པོས་མཐོང་ཡོད་འདུག་ལ།",
    "ཙམ་བྱུང་འདུག་ནའང་།",
    "མཉམ་ཞུགས་བྱས་ནས་སྐབས་དེར་བྲོས་བྱོལ་དུ་འགྲོ་ཐུབ་ཙམ་བྱུང་འདུག་པ་དང་།",
    "ནང་མི་ཉེ་འབྲེལ་རྣམས་ལ་ཕལ་ཆེན་རྒྱ་དམར་གྱི་ལག་འོག་ཏུ་ཐེབས་པ་མིན་འགྲོ་བསམ་པའི་བློ་ཚབས་ཤུགས་ཆེན་སྐྱེས་བཞིན་ཡོད་འདུག།",
    "པར་ལེན་བྱས་པ་སོགས་ཀྱི་གནས་ཚུལ་མང་པོ་བྱུང་འདུག།",
    "མ་དཔལ་བདེ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༤ ཡིན་འདུག་པ་དང་།",
    "རྗེས་སུ་ཐབས་ཤེས་རིམ་པར་བརྒྱུད་བཙོན་དུ་འགྲོ་མ་དགོས་ཙམ་བྱུང་འདུག་པ་དང་།",
    "ཟེར་བ་སོགས་འདྲི་བརྩད་འདྲ་མིན་བྱས་ཏེ་མི་སྤྱོད་ལས་འདས་པའི་ཉེས་རྡུང་བཏང་རྐྱེན་ལས་ཐེངས་གསུམ་བཞི་ཞིག་ལ་དྲན་པ་འཐོར་བ་སོགས་ཀྱི་གནས་ཚུལ་ཡང་བྱུང་འདུག་པ་དང་།",
    "ཕྱི་ལོ་༢༩ ཟླ་༥ ཚེས་༢༥ ཡས་མས་ཤིག་ལ་གློད་གྲོལ་ཐོབ་ཡོད་འདུག།",
    "མ་དུང་མཚོ་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༩ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༡༩ ཡིན་འདུག་པ་དང་།",
    "གཉིས་སུ་ཕྱི་ལོ་༡༩༥༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༥༡ ཡིན་འདུག་པ་དང་།",
    "དུ་གྱུར་ཡོད་འདུག་པ་དང་།",
    "འཇིགས་སྐུལ་སོགས་བྱ་ཐབས་ངན་པ་འདི་འདྲ་སྤེལ་སྐབས་ངེད་ཅག་སྡོད་ཐབས་མི་འདུག་པས།",
    "དེ་མིན་གཞན་མང་པོ་ཞིག་ལ་མེ་མདའ་ཐེབས་ཡོད་འདུག་ནའང་།",
    "བྱེའུ་ཁྲས་བཟུང་བ་ལྟར་ཁྱེར་འདུག་ལ།",
    "ཡུམ་ཡ་ཕྲུག་གཉིས་སུ་ཕྱི་ལོ་༡༩༧ ལོ་ཡས་མས་ཤིག་ལ་འཁྲུངས་ཤིང་ད་སྐབས་རང་ལོ་༣༩ ཙམ་ཡིན་འདུག་པ་དང་།",
    "རྗེས་སུ་བཙོན་ནས་གློད་གྲོལ་ཐོབ་ཙམ་བྱུང་འདུག་ནའང་།",
    "མ་ཡ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༨ ལོར་སྐྱེས་ཤིང་དམར་གཞུང་ནས་རྐྱེན་ལམ་དུ་བཏང་སྐབས་རང་ལོ་༢༡ ཡིན་འདུག་པ་དང་།",
    "ཞེས་འབོད་བཞིན་ས་ལ་འགྱེལ་འདུག་ད་དུང་ཁོ་ཡར་ལངས་རྩིས་བྱས་ཏེ།",
    "ལོའི་འཇུ་བཟུང་བཀའ་རྒྱ་ཨང་༡ ཟེར་བ་ཞིག་བཏང་འདུག་པ་དང་དེའི་ནང་འཁོད་དོན། རིག་འཛིན་ཀརྨ།",
    "རྨ་ཁ་ནས་རུས་པ་ཆུང་ངུ་རྣམས་ཕྱིར་ཐོན་པ་སོགས་ཀྱི་གནས་ཚུལ་བྱུང་སྐབས་རྨ་གྲིས་བཤར་ནས་རྨ་ལས་བྱས་ཏེ་རྣག་ཕྱིར་འདོན་པའི་ཐབས་ཤེས་སྣ་ཚོགས་བྱས་འདུག་ཀྱང་དྲག་བསྐྱེད་མ་བྱུང་བ་དང་།",
    "མ་ཚེ་རིང་སྒྲོལ་དཀར་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་པ་དང་།",
    "མ་སྒྲོན་གུར་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༩ ལོ་སྐྱེས་ཤིང་རང་ལོ་༢ ཡིན་འདུག་པ་དང་།",
    "མ་སྒྲོན་གཡང་གཉིས་སུ་ཕྱི་ལོ་༡༩༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༩ ཡིན་འདུག་པ་དང་།",
    "མ་བསམ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༩ ལོ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣ ཡིན་འདུག་པ་དང་།",
    "མ་པད་ལྷ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨ ལོ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༩ ཡིན་འདུག་པ་དང་།",
    "མ་ལྷ་སྨིན་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༩ ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣ ཙམ་ཡིན་འདུག་པ་དང་།",
    "ལྕག་ར་ཞ་རྒལ་ཆན་མ་ནང་དུ་མཉམ་ཞུགས་བྱས་ནས་བྲས་བྱལ་དུ་ཕྱན་འདུག་པ་དང་།",
    "མ་པདྨ་དབྱངས་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༦ ཡིན་འདུག་པ་དང་།",
    "གཉིས་སུ་ཕྱི་ལོ་༡༩༧༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༦ ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༡ སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༨ ཡིན་འདུག་པ་དང་།",
    "མ་མཁྱེན་ལུ་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༧ སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༢ ཡིན་འདུག་པ་དང་།",
    "མ་སྐལ་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༩ ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣ ཙམ་ཡིན་འདུག་པ་དང་།",
    "གོང་གསལ་བཞིན་ངོ་རྒོལ་བྱས་མཁན་གྱི་གྲས་སུ་ཡོད་འདུག་ཅིང་།",
    "གོང་གསལ་བཞིན་ངོ་རྒོལ་བྱེད་མཁན་གྱི་གྲས་སུ་ཡོད་འདུག་ཅིང་།",
    "མ་ཡ་ཐར་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༦ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༣ ཙམ་ཡིན་འདུག་པ་དང་།",
    "གོང་གསལ་བཞིན་ངོ་རྒོལ་བྱེད་མཁན་གྱི་གྲས་སུ་ཡོད་འདུག་ཅིང་།",
    "མ་བློ་བཟང་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༤ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༥ ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་ལྷ་དབྱངས་གཉིས་སུ་ཕྱི་ལོ་༡༩༧ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༩ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་ལྷ་དབྱངས་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༣ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༦ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ཡ་འབུང་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཡིན་འདུག་པ་དང་།",
    "མ་མཁའ་གཡང་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༤ ཡིན་འདུག་པ་དང་།",
    "མ་བདེ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༧ ཡིན་འདུག་ལ།",
    "མ་ཚེ་འདས་ཀུན་དགའལྷ་འཛོམས་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༦ ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༣ ཡིན་འདུག་པ་དང་།",
    "མ་ལྷ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༢ ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་ལམ་རིང་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༤ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༥ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་ལམ་རིང་གཉིས་སུ་ཕྱི་ལོ་༡༩༦ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ཇོ་བོ་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༧ ཡིན་འདུག་པ་དང་།",
    "མ་རིག་འཛིན་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ནོར་བུ་ཚེ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༦ ཡིན་འདུག་ལ།",
    "མ་ཚེ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༦ ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༣ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་བྱང་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༡ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༨ ཡིན་འདུག་པ་དང་།",
    "མ་བཀྲ་ཤིས་ཚེ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཡིན་འདུག་པ་དང་།",
    "མ་ལམ་ཕྲུག་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོག་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཡིན་འདུག་ལ།",
    "མ་ཚེ་འདས་གཡུ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༦ ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་སྐལ་བཟང་ཚེ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༦ ལོར་སྐུ་འཁྲུངས་ཤིང་ད་སྐབས་རང་ལོ་༤༩ ཡིན་འདུག་པ་དང་།",
    "འཇུ་བཟུང་སྐབས་ལག་ཐོག་ཁ་པར་ཞིག་ཡོད་པ་དེའི་ཨང་གྲངས་བརྗེ་མི་ཆོག་ཅེས་སོགས་མང་དག་ཞིག་བཙན་དཀའ་བཏང་ཡོད་འདུག་༢",
    "མ་ཚེ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཙམ་ཡིན་འདུག་པ་དང་།",
    "ཞེས་སོགས་ཀྱི་འབོད་ཚིག་སྒྲོག་བཞིན་ཞི་རྒོལ་བྱས་འདུག་པ་མ་ཚད།",
    "སྦག་སྦག་རིན་གོང་མཐོ་ཤོས་ལ་རྒྱ་སྒོར་ཁྲི་ཚོ་གཅིག་ལྷག་ཙམ་གྱི་སྦག་སྦག་མང་པོ་ཡོད་འདུག་པ་མ་ཚད་ད་བར་དུ་དོ་བདག་ལ་ཕྱིར་སྤྲོད་བྱས་མི་འདུག་ངང་སྒང་བཙུན་དགོན་དུ་བཙུན་མ་ཁ་ཤས་ཤིག་ལྷག་པ་དེ་ཚོ་དང་ས་གནས་ཀྱི་ཡུལ་མི་སོགས་སེར་སྐྱ་མང་པོ་ཞིག་སྐབས་དེར་བྲོས་བྱོལ་དུ་ཕྱིན་སྟབས།",
    "མ་ཡར་བློ་སྒྲོན་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༦ ༤ ལོར་འཁྲུངས་ཤིང་ད་སྐབས་རང་ལོ་༤༥ ཡིན་འདུག་ལ།",
    "ཡེ་ཤེས་ཁོང་ཁྲོ་ལངས་ཏེ་ཧྲུའུ་ཅི་ལ་ད་ཁྱེད་ལ་འདི་སྦྱིན་ཞེས་གྲིས་བཙུགས་ཏེ་བྲོས་བྱོལ་དུ་ཕྱིན་འདུག་པ་དང་།",
    "མ་ཚེ་སྐྱིད་སྒྲོན་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༦ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༣ ཙམ་ཡིན་འདུག་པ་དང་།",
    "ཕྱིན་འདུག་པ་དང་།",
    "མ་ཨ་ལྡན་གཉིས་སུ་ཕྱི་ལོ་༡༩༦ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༩ ཙམ་སོན་གྱི་ཡོད་འདུག་ཕྱི་ལོ་༢༨ ཟླ་༣ ཚེས་༢༨ ཉིན་དཀར་མཛེས་རིན་ཆེན་རྒྱ་མཚོ་ལ།",
    "མ་བློ་བཟང་སྒྲོན་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༦ ཡིན་འདུག།",
    "༤་ མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༢ ཙམ་ཡིན་འདུག།",
    "དྲག་སྤྱོད་ཉེན་རྟོག་པས་བཀག་འགོག་བྱས་འདུག་པ་དང་།",
    "ཉེན་རྟོག་པས་བཙུན་མ་དེ་ཚོ་དུར་ཁྲོད་དུ་འགྲོ་འཇུག་དགོས་བྱུང་འདུག་ལ།",
    "དུད་ཚང་དཀྱུས་མ་རྣམས་ལ་དངུལ་སྟོང་ཕྲག་ཁ་ཤས་ལེན་རྒྱུ་ལ་ང་ཡོད་ཀྱང་ལོ་ཤས་ནས་ཉུང་དུ་ཕྱིན་འདུག་ལ།",
    "རྒྱང་གྲགས་ནས་མི་སུ་ཡིན་རུང་ཕྱིར་ཐོན་ན་མེ་མདའ་རྒྱག་རྐྱང་ཡིན་ཟེར་བ་སོགས་ཀྱི་སྐད་འབོད་བྱས་ཡོད་འདུག་ཅིང་།",
    "དེ་མིན་གྲངས་ལས་འདས་པ་ཞིག་ལ་རྨས་སྐྱོན་ཕོག་འདུག་པ་ནས་འདིར་ཤེས་རྟོགས་བྱུང་བ།",
    "རྔ་ལ་མདའ་གྲོང་དུ་ཕྱི་ལོ་༡༩༧༣ ལོར་སྐྱེས་ཤིང་ཁོང་རྐྱེན་འདས་སུ་གཏོང་སྐབས་རང་ལོ་༣༥ ཡིན་འདུག་པ་དང་།",
    "ཞི་རྒོལ་སྐབས་མེ་མདའི་འོག་རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་ཏེ་ནང་མི་ནས་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག།",
    "སྐབས་དེར་རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་བཞིན་ཡོད་འདུག་༤",
    "ནང་མི་དང་ཡུལ་མི་ཀུན་གྱིས་འདས་གྲོངས་སུ་ཕྱིན་ཚར་བའི་ཁོངས་སུ་བརྩིས་ཏེ་མཆོད་འབུལ་སོགས་བྱེད་བཞིན་ཡོད་འདུག།",
    "སྐབས་དེར་རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་ཏེ་ནང་མི་ནས་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག་༦",
    "མ་ནོར་འཛིན་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༦ ལོར་སྐྱེས་ཤིང་ཞི་རྒོལ་སྐབས་སུ་རང་ལོ་༢༢ ཡིན་འདུག་པ་དང་།",
    "རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་ཏེ་ནང་མི་ནས་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག་ཆིས་ལོ་རསོ་འཁོག་ན་༧",
    "ཞི་རྒོལ་སྐབས་རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་ཏེ་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག་༨",
    "མ་ཡངས་དགའ་སྒྲོན་མ་གཉིས་སུ་ཕྱ་ལ་༡ ༩༦ ༥ ལར་སྐྱེས་ཤིང་ཞི་རྒོལ་སྐབས་སུ་རང་ལོ་༤༣ ཡིན་འདུག་པ་དང་།",
    "སྐབས་དེར་ཞི་རྒོལ་ནང་མེ་མདའི་འོག་རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་ཏེ་ནང་མི་ཉེ་འབྲེལ་བཅས་ནས་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག་༡",
    "མ་དཔལ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༨ ལོར་སྐྱེས་ཤིང་ཞི་རྒོལ་སྐབས་སུ་རང་ལོ་༢༨ ཙམ་ཡིན་འདུག་པ་དང་།",
    "ད་སྐབས་འདས་གྲོངས་སུ་ཕྱིན་ཚར་བའི་ཁོངས་སུ་བརྩིས་ཏེ་ནང་མི་ནས་འདས་མཆོད་སོགས་ཀྱང་བྱས་ཟིན་ཡོད་འདུག་༡༡",
    "ད་སྐབས་མེ་མདའ་འོག་རྐྱེན་འདས་སུ་བཏང་ཚར་བའི་ཁོངས་སུ་བརྩིས་ཏེ་ནང་མི་ནས་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག་༡༢",
    "ནང་མི་དང་གཉེན་ཉེ་བཅས་ནས་ཞི་རྒོལ་སྐབས་སུ་རྐྱེན་འདས་སུ་བཏང་བའི་ཁོངས་སུ་བརྩིས་ཏེ་འདས་མཆོད་སོགས་བྱས་ཟིན་ཡོད་འདུག་༡༤",
    "ནང་མི་ཉེ་འབྲེལ་བཅས་ནས་ཞི་རྒོལ་སྐབས་འདས་གྲོངས་སུ་ཕྱིན་པའི་ཁོངས་སུ་བརྩིས་ཏེ་འདས་མཆོད་སོགས་ཀྱང་བྱས་ཟིན་འདུག་པ་མ་ཚད།",
    "དུས་ད་ལྟ་ལ་ཡང་དུད་ཚང་སུའི་མི་ཡིན་མིན་ཤེས་གསལ་མ་བྱུང་བའི་གནས་སུ་གྱུར་ཡོད་འདུག་རྗེས་སུ་གོ་ཐོས་བྱུང་བར་གཞིགས་ན།",
    "ཞོགས་པ་ནས་ཉིན་གུང་ཙམ་གྱི་བར་ཤིང་ནགས་གསེབ་ཏུ་མེར་བསྲེག་བཏང་སྟེ་དུ་བཤུགས་ཆེར་བཏང་བ་སོགས་ཀྱི་གནས་ཚུལ་འདུག་པ་དེར་བལྟས་ན་ཞི་རྒོལ་སྐབས་དམར་གསོད་བཏང་བའི་གྲངས་འབོར་ཧ་ཅང་མང་པོ་ཡོད་པ་གསལ་པོ་ཆགས་ཀྱིན་ཡོད་འདུག་ཞི་རྒོལ་སྐབས་མེ་མདའི་འོག་རྨས་སྐྱོན་ཕོག་པ།",
    "མ་སྒྲོན་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༡ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༨ ཙམ་ཡིན་འདུག་པ་དང་།",
    "ད་སྐབས་གཟུགས་པོ་ཐང་པོ་མེད་པ་ཆགས་ཡོད་འདུག།",
    "མ་དབྱངས་ཅན་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༩ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢ ཙམ་ཡིན་འདུག་པ་དང་།",
    "ནས་མདུན་དུ་ཕུག་འདུག་ནའང་།",
    "མ་ཐུབ་བསྟན་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༡ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༨ ཡིན་འདུག་པ་དང་།",
    "ཟེར་བའི་རྒྱ་མི་ཞིག་ལ་ཕྱི་ལོ་༡༩༦༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༤ ཙམ་ཡིན་འདུག་པ་དང་།",
    "སྐབས་དེར་དམར་གསོད་བཏང་བའི་ཕུང་པོ་མང་དག་ཅིག་དང་མཉམ་དུ་རླངས་འཁོར་ནང་བླུགས་ནས་དཀར་མཛེས་ཕྱོགས་སུ་དབོར་ཕྱིན་འདུག་ནའང་ཉེས་རྡུང་སོགས་ཀྱི་རྐྱེན་པས།",
    "རོགས་རྣམས་སུ་ཡིན་མིན་སོགས་ཤེས་ཐབས་གང་ཡང་མེད་པ་ཆགས་ཡོད་འདུག་ཅིང་།",
    "དྲག་སྤྱོད་ཉེན་རྟོག་པས་དྲག་གནོན་གྱིས་མི་མང་དཀྱིལ་དུ་མེ་མདའ་བརྒྱབས་ཏེ་མི་གྲངས་བཅུ་ལ་མེ་མདའ་ཚབས་ཆེན་ཕོག་འདུག་ཅིང་།",
    "རང་ལོ་༢༣ མེ་མདའ་རྣ་རྩར་ཐེབས་འདུག་ཟེར།",
    "བཅས་ལ་མེ་མདའ་འོག་རྨས་སྐྱོན་ཕོག་འདུག་པ་དང་།",
    "དེ་མིན་རྨས་མ་མང་དག་ཞིག་ཡོད་འདུག་ནའང་མིང་སོགས་གསལ་པོ་མ་བྱུང་།",
    "བཙུན་དགོན་བསམ་གཏན་གླིང་ལ་༡༤ ཡིན་འདུག་པས།",
    "གལ་ཏེ་རྒྱ་གཞུང་ནས་བཙན་ཤེད་བྱས་ཚེ་བླ་གྲྭ་ཡོངས་ཀྱིས་མཐའ་གཅིག་ཏུ་ངོ་རྒོལ་བྱེད་རྒྱུའི་གྲ་སྒྲིག་གནང་ཡོད་འདུག་ཅིང་།",
    "སོགས་ཀྱི་གནས་ཚུལ་ཡང་བྱུང་ཡོད་འདུག་༡",
    "མ་སྒྲོན་མ་ཚེ་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༡ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༨ ཡིན་འདུག་ཕྱི་ལོ་༢༨ ཟླ་༤ ཚེས་༡༧ ཉིན་བྲག་མགོ་ནས་མི་སྐྱ་རིན་ཆེན་བཟང་པོ་ཡིས།",
    "མ་ནོར་སྲས་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༡ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རངལོ་༣༨ ཡིན་འདུག་ལ།",
    "མ་ཚེ་འདས་བཀྲ་ལུ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་པ་དང་།",
    "ཟེར་བ་འཛུགས་རྒྱུ་ཡིན་ཞེས་བསྒྲགས་གཏམ་སྤེལ་ཡོད་འདུག་པ་དང་།",
    "ཟེར་བའི་ཆབ་སྲིད་ཀྱི་སློབ་སྦྱོང་སྤྲོད་སྐབས་སུ་རྒས་འཁོགས་ཁ་ཤས་མ་གཏོགས་གཞན་ཡོང་མཁན་རག་མི་འདུག་ལ།",
    "མ་དབྱངས་དབྱངས་གཉིས་ཀྱི་སྲས་སུ་ཕྱི་ལོ་༡༩༦༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༦ ཡིན་འདུག་པ་དང་།",
    "ཁོང་གཉིས་ཟླ་བ་ལྔ་ཙམ་གྱི་རྗེས་སུ་གློད་གྲོལ་ཐོབ་འདུག་ནའང་།",
    "མ་ནོར་འཛིན་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༦༦ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༤༣ ཡིན་འདུག་པ་དང་།",
    "རྒྱ་གཞུང་ནས་སྲོག་ཉེན་ལ་འགན་ལེན་མ་ཐུབ་པར་ལོ་འཁོར་གཅིག་མ་ཟིན་ཙམ་ནས་གློད་གྲོལ་གཏང་དགོས་བྱུང་འདུག།",
    "མ་དགེ་ལེགས་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༥ ཡིན་འདུག་པ་དང་།",
    "སྒུག་འདའ་གྲོང་དུ་ཕྱི་ལོ་༡༩༥༩ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༥ ཡིན་འདུག་ཕྱི་ལོ་༢༨ ཟླ་༥ ཚེས་༡༡ ཉིན་དཀར་མཛེས་བྲག་དཀར་དགོན་གྱི་བཙུན་མ་ཐུབ་བསྟན་སྒྲོལ་མ་དང་།",
    "གཅིག་གློད་གྲོལ་ཐོབ་ཡོད་འདུག་པ་དང་།",
    "མ་བསོད་ཕྲུག་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༦ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༣ ཡིན་འདུག་པ་དང་།",
    "འདུག་པ་དང་།",
    "མ་བདེ་ཆེན་དབྱངས་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་པ་དང་།",
    "མ་མཁའ་ལུ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༧ ཡིན་འདུག་པ་དང་།",
    "ཁོང་རྣམས་ལ་འཚེམ་བཟོ་བའི་ལས་ཀ་བྱེད་དུ་འཇུག་བཞིན་ཡོད་འདུག་༢",
    "བྲག་ཁ་གྲོང་དུ་ཕྱི་ལོ་༡༩༧༧ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཙམ་ཡིན་འདུག་པ་དང་།",
    "བཙོན་འོག་ཏུ་ཡོད་པ་ལྟ་བུའི་སེམས་སྡུག་འོག་གནས་མུས་ཡིན་འདུག་༤",
    "བཙོན་འོག་ཏུ་གནས་པ་ལྟ་བུའི་སེམས་སྡུག་འོག་གནས་མུས་ཡིན་འདུག་༥",
    "བཙོན་འོག་ཏུ་གནས་པ་ལྟ་བུའི་སེམས་སྡུག་འོག་གནས་མུས་ཡིན་འདུག་པ་དང་།",
    "མ་འབུས་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༤ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༥ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢ ཙམ་ཡིན་འདུག་པ་དང་།",
    "བཙུན་མ་མང་ཤོས་གློད་གྲོལ་ཐོབ་འདུག་ནའང་།",
    "དཔྲལ་བར་ཤུགས་ཡོད་ཚད་ཀྱི་རྐང་པས་གཞུས་པ་སོགས་བྱས་འདུག་ལ།",
    "གཉིས་སུ་ཕྱི་ལོ་༡༩༧༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༦ ཡིན་འདུག་པ་དང་།",
    "བྱེད་མུས་ཡིན་འདུག་༤",
    "མ་ཚེ་འདས་མགོ་ཕྲུག་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་པ་དང་།",
    "མ་སྒྲོན་མ་དབྱངས་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་སྒྲ་ལོ་༣༢ ཡིན་འདུག་པ་དང་།",
    "མ་དཔལ་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༧ ཡིན་འདུག་ལ།",
    "ད་ཆར་སེམས་ཁམས་མི་བདེ་བའི་སྨྱོན་པ་ལྟ་བུར་ཆགས་ཡོད་འདུག།",
    "མ་ཡེ་ཤེས་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་པ་དང་།",
    "མ་བཀྲིས་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༦ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༣ ཡིན་འདུག་པ་དང་།",
    "མ་སྐལ་བཟང་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་པ་དང་།",
    "གཉིས་སུ་ཕྱི་ལོ་༡༩༧༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༡ ཡིན་འདུག་ཅིང་།",
    "མ་ཡེ་ཤེས་ལྷ་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༤ ཡིན་འདུག་པ་དང་།",
    "མ་སྒྲོན་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༦ ཡིན་འདུག་པ་དང་།",
    "མ་མིག་མིག་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༩ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣ ཡིན་འདུག་པ་དང་།",
    "མ་ཡེ་ཤེས་མཁའ་འགྲོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༦ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༣ ཡིན་འདུག་པ་དང་།",
    "གཉིས་སུ་ཕྱི་ལོ་༡༩༨༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༤ ཡིན་འདུག་པ་དང་།",
    "མ་མགོན་པོ་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༢ ཡིན་འདུག་པ་དང་།",
    "མ་སྐལ་བཟང་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༤ ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་དུང་མཚོ་སྒྲོལ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༩ ཡིན་འདུག་ལ།",
    "མ་རྡོ་ལུ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༦ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༣ ཡིན་འདུག་པ་དང་།",
    "མ་བསོད་ཕྲུག་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༥ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལ་༢༤ ཡན་འདུག་པ་དང་།",
    "མ་དཔལ་སྐྱིད་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༧ ཡིན་འདུག་པ་དང་།",
    "བྱས་ཏེ་ཉིན་ཤས་རྗེས་སུ་གློད་གྲོལ་ཐོབ་འདུག།",
    "སྟོང་འཁོར་ཟླ་ཁོག་ཏུ་ཕྱི་ལོ་༡༩༨༣ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༦ ཡིན་འདུག་པ་དང་།",
    "མ་ཐུབ་བསྟན་ཚེ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༥ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༤ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་བློ་དབྱངས་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༡ ཡིན་འདུག་པ་དང་།",
    "མ་མི་འཁྲུག་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༧ ཡིན་འདུག་ལ།",
    "མ་དབྱངས་དགའ་སྒྲོན་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༢ ཡིན་འདུག་པ་དང་།",
    "མ་པདྨ་མཁའ་འགྲོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༩༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༡༧ ཡིན་འདུག་པ་དང་།",
    "མ་མཁའ་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༨ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༡ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་མིང་དགའ་གཉིས་སུ་ཕྱི་ལོ་༡༩༩༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༡༧ ཡིན་འདུག་པ་དང་།",
    "ལོ་འཁོར་གཅིག་མ་ཟིན་ཙམ་གྱི་རྗེས་སུ་ཕྱི་ལོ་༢༩ ཟླ་༤ ཚེས་༢༣ ཉིན་གློད་གྲོལ་ཐོབ་ཡོད་འདུག།",
    "མ་གསེར་སྒྲུབ་གཉིས་སུ་ཕྱི་ལོ་༡༩༩ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༡༩ ཡིན་འདུག་པ་དང་།",
    "མ་ཨ་ཟེ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༩ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢ ཡིན་འདུག་པ་དང་།",
    "ཡས་མས་ཤིག་ལ་སྐྱེས་ཞིང་ད་སྐབས་རང་ལོ་༢༨ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་ཚེ་འདས་བདེ་ཆེན་མཚོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༩ ལོ་ཡས་མས་ཤིག་ལ་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣ ཙམ་ཡིན་འདུག་པ་དང་།",
    "མ་བློ་བཟང་ལྷ་སྒྲོན་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༧ ཡིན་འདུག་པ་དང་།",
    "བད་མ་ཆས་ས་རྟགས་བརྒྱ་རྒྱུ་ར་ཡག་ཆ་གང་འདྲ་ཡན་མན་ད་གས་ཐན་དང་བཅས་མུ་མཐུད་ལས་མཚམས་འཇོག་སྟེ་ངོ་རྒོལ་བྱས་པ་སོགས་ཀྱི་གནས་ཚུལ་ཐོན་འདུག་ཕྱི་ལོ་༢༨ ཟླ་༥ ཚེས་༢ ཉིན་གྱི་ཉིན་གུང་ཙམ་ལ་དཀར་མཛེས་རྩིས་ཚང་དགོན་གྱི་གྲྭ་བསྟན་འཛིན་དངོས་གྲུབ་དང་།",
    "མ་དཔལ་བདེ་སྐྱིད་གཉིས་སུ་༡༩༨༤ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༥ ཡིན་འདུག་པ་དང་།",
    "དེ་རྗེས་ནང་མི་ཐུག་འཕྲད་ཕྱིན་འདུག་པ་དང་།",
    "གཉིས་སུ་ཕྱི་ལོ་༡༩༨ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༩ ཡིན་འདུག་པ་དང་།",
    "ཕྱི་ལོ་༢༨ ཟླ་༡༢ ཚེས་༡༨ ཉིན་གློད་གྲོལ་ཐོབ་ཡོད་འདུག་༤",
    "མ་དཔལ་སང་གཉིས་སུ་ཕྱི་ལོ་༡༩༧༢ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༣༧ ཡིན་འདུག་པ་དང་།",
    "དགོས་བྱུང་འདུག་པ་དང་།",
    "མ་ཚེ་རིང་མཁའ་འགྲོ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༧ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༢ ཡིན་འདུག་ཕྱི་ལོ་༢༨ ཟླ་༥ ཚེས་༢༨ ཉིན་ཞོགས་པ་ཕྱག་ཚོད་༩ ཙམ་ལ་དཀར་མཛེས་བྲག་དཀར་དགོན་གྱི་བཙུན་མ་ཡེ་ཤེས་ལྷ་སྒྲོན་དང་།",
    "བསྐྱལ་བ་སོགས་ཀྱི་གནས་ཚུལ་བྱུང་འདུག་པ་དང་།",
    "གཅིག་ཉེས་རྡུང་སོགས་ཀྱི་རྐྱེན་ལས་འདས་གྲོངས་སུ་ཕྱིན་ཡོད་པའི་ཚོད་དཔག་བྱེད་བཞིན་ཡོད་འདུག་༡",
    "མ་དབྱངས་མཚོ་སྒྲོལ་མ་གཉིས་སུ་ཕྱི་ལོ་༡༩༨༤ ལོར་སྐྱེས་ཤིང་ད་སྐབས་རང་ལོ་༢༥ ཡིན་འདུག་པ་དང་།",
    "ཞེས་སོགས་ཀྱི་དྲི་བརྩད་འདྲ་མིན་བྱས་འདུག་པ་དང་།"
  ]
}