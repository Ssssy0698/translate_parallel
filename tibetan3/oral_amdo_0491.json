    "ལྷ་མཆོག་སེང་གེ་བུདྡྷཱ་སི་ཧ་དང་།",
    "ཚོགས་པའི་གཙོ་བོ་ཞིག་གིས་ཕྱག་གསུམ་བྱས་ནས་ཐལ་མོ་སྦྱར་ཏེ།",
    "མ་སྣང་བྱེད་སྐྱེས་བུ་དམ་པ་ཁྱོད།",
    "དེ་ཉིད་ཀྱི་ལུགས་མཆོག་ཕྱོགས་དུས་གནས་སྐབས་ཐམས་ཅད་དུ་གསལ་བར་བྱེད་པའི་སྐྱེས་བུ་དམ་པ་ཁྱོད་ཉིད།",
    "ཐམས་ཅད་ཀྱིས་གཏང་རག་གི་མཎྜལ་འབུལ་བ་ཞུ།",
    "ཨོཾ་ན་མོ་བྷཾ་ཨཱ་ཡུཛྙཱ་ན་དྷཱིཨ་རོ་ལིཀ་ཧཱུྃ་ཧིཞེས་པས་བྱིན་གྱིས་བརླབས་ནས།",
    "རེ་རེ་བཞིན་དུ་ཐོགས་ནས་འབུལ་བའི་ཚུལ་དང་བཅས་ཏེ།",
    "གཟུགས་རེ་རེ་བཞིན་དུ་ཐོགས་ནས་འབུལ་བའི་ཚུལ་དང་བཅས་ཏེ།",
    "སླར་ཡང་རྒྱལ་མཚན་རྩེ་མོ་ལ་སོགས་པ་དང་བཀྲ་ཤིས་ཀྱི་ཚིགས་སུ་བཅད་པ་ཅི་རིགས་པ་རྒྱས་པར་བརྗོད་དེ་མེ་ཏོག་གི་ཆར་དབབ་བོ།",
    "རྟེན་པ་རྨད་བྱུང་ལང་ཚོའི་རིམས་མ་ཡིན།",
    "མཚོ་བྱུང་སྒེག་མོ་མགྲིན་པར་ལྷགས་སམ་སྙམ།",
    "དད་མོས་ཀྱིས་རྩོལ་བ་བྱེད་པ་རྣམས་ཀྱང་གྲྭ་ས་ཆེན་པོའི་ཕྱག་ལེན་མཐོང་ཐོས་མེད་པར་རང་དགར་མུན་ནང་འདོམ་འཇལ་ལྟ་བུའི་ཚོད་འགྲོས་ཀྱི་ཆོ་ག་བྱེད་པ་ཞིག་ལས་མ་བྱུང་བར།",
    "བརྒྱུད་འདེབས་གསར་རྩོམ་མཛད་པ་སོགས་དེ་དག་ལ་སྔར་གོམས་འདྲིས་ཆུང་བ་རྣམས་ལ་ཚིག་གི་ཁྱད་པར་གསར་བསྐྲུན་མང་བའི་ཤུགས་ཀྱིས་འཕྲལ་དུ་ཉམས་སུ་ལོན་བདེ་བ་མ་བྱུང་བར་བརྟེན།",
    "ཉེ་འདབས་སུ་སྦྱར་བ་སྭ་སྟི་བི་ཛ་ཡནྟཾ། ། སྒྲོལ་མ་དཀར་མོ་ཡིད་བཞིན་འཁོར་ལོ་ལ་བརྟེན་པའི་སྐུ་ཚེ་བརྟན་བཞུགས་ཀྱི་ཆོ་ག་ཉི་བུའི་བདུད་ལས་རྒྱལ་བའི་བཞད་སྒྲ་ཞེས་བྱ་བ་བཞུགས། ། གང་བི་དྷརྨའི་མཛེས་པའི་ཡོན་ཏན་བསྔགས་པ་ལ་སྦྱར་བ།",
    "དེ་ཉིད་ནས་བརྩམས་ཉི་བུའི་དཔུང་ཚོགས་ལས།",
    "མྱུར་མ་དཔའ་མོའི་རྣལ་འབྱོར་ལ་བརྟེན་ནས།",
    "འདིར་སྒྲོལ་མ་དཀར་མོ་ཡིད་བཞིན་འཁོར་ལོའི་བདག་མདུན་གྱི་ཆོ་ག་ལ་བརྟེན་ནས་མཛད་པ་ལ་མོས་པ་རྣམས་ཀྱི་ངོར་དེ་ཉིད་ཇི་ལྟར་ཉམས་སུ་བླང་བའི་ཚུལ་ལ།",
    "བྱང་ཤར་ནས་ཤར་ལྷོའི་བར་ཟླུམ་གཏོར་གསུམ་དང་བགེགས་གཏོར་རྣམས་བཤམ་མོ།",
    "སློབ་དཔོན་གྱི་མདུན་དུ་བུམ་པ་རྒྱན་ལྡན་གཅིག་བཤམ་མོ།",
    "རང་གི་བྱ་བ་དང་།",
    "མཆོག་གི་ཡུལ་ལ་བྱ་བའོ།",
    "གཉིས་པ་མཆོག་གི་ཡུལ་ལ་བྱ་བ་ལ།",
    "དེ་ནས་ཨོཾ་གུ་རུ་ཏུ་རེ་སནྡྷ་བུདྡྷ་ས་བསམ་ཡསམ་ས་མ་ཨ་མ་ས་བོ་དྷི་ས་ཏྭ་ས་པ་རི་ཝཱ་ར་ཨརྒྱུ་པྲ་ཏིཙྪ་སྭཱ་ཧཱ་ནས་བཛྲ་ཤཔྟ་ཨཱ་ཧཱུཾ་ཞེས་པའི་བར་གྱིས་མཆོད།",
    "རྩིབས་བརྒྱད་ལ་མདུན་ནས་བརྩམས་ཏེ་གཡས་སྐོར་གྱིས་ཏཱ་རེ་ཏུཏྟ་རེ་ཏུ་རེ་སྭཱ་ཞེས་པ་ལས་འོད་ཟེར་འཕྲོས།",
    "ཨོ་ཏཱ་རེ་ཏུཏྟ་རེ་ཏུ་རེ་ཨཱ་ཡུསྶཅུཛྙཱ་ན་པུཀུ་རུ་སྭཱ་ཧཱ་ཞེས་པའང་ཅི་ནུས་སུ་བཟླའོ།",
    "ༀགུ་རུ་ཏཱ་རེ་སཎྜ་བུདྡྷ་བོ་དྷི་ས་ཏྭ་ས་པ་རི་ཝཱ་ར་ཨནྡྷཾ་པྲ་ཏཱིཙྪ་སྭཱཧཱ།",
    "དེ་བཞིན་དུ་ཞབས་བསིལ་ནས་རོལ་མོའི་བར་འདོན་པ་བསྒྱུར་ལ་བཛྲ་ཤརྡ་ཨཱ་ཧཱུྃ་གི་བར་གྱིས་མཆོད།",
    "ཐལ་མོ་སྦྱར་ཏེ་གདངས་དང་བཅས་པས་འདི་སྐད་དོ།",
    "ཕྲིན་ལས་དར་ཞིང་རྒྱས་པར་བྱིན་གྱིས་རློབས་། ཞེས་པའམ་བཀའ་བབས་དགུ་ལྡན་གྱི་བརྒྱུད་པ་གཞན་གང་ལ་མོས་ནའང་དེས་རིགས་འགྲེ་སྦྱར་རོ།",
    "རིས་བྲལ་སྐྱེ་འགྲོའི་བདེ་སྐྱིད་དཔལ་ཞེས་སོགས་ཀྱི་ཚིགས་སུ་བཅད་པའམ་ལྷག་པ་གང་མོས་བརྗོད་པས་བཀའ་སྩལ་ཞུ་བ།",
    "དགུ་པ་གཏང་རག་གི་མཎྜལ་འབུལ་བ།",
    "རང་གི་དཔྲལ་བར་ཨོ་སོགས་ཀྱིས་གནས་གསུམ་བསྲུང་ཞིང་།",
    "སྔགས་མཐའ་དག་གི་གཟུགས་ཅན་གྱིས་མཛེས་པ།",
    "ལེན་པ་གང་ཚེ་དབྱངས་ཀྱི་རྒྱལ་མོ་དེ།",
    "སམས་ན་གསས་བ་ན་ན་གསལ་ཡམས་ར་ལས་ཁ་༤ ༤  ༧ ཁའཁ་ལབ་སམ་པས་སམ་། ཤསྔགྷོཥདིཝིསརསཱཏཱིཡཾསཾཝརྞཎྜལངྐརཔུཎྜརིཀོབིབུདྡྷཔུཥརབིཧརཏིསྨ། ། སྒྲ་དབྱངས་ལྷ་མོ་དབྱངས་ཅན་མ་ལ་བསྔགས་པ་དོན་རྒྱན་པདྨ་དཀར་པོ་བཞད་པའི་རྫིང་བུ་བཞུགས་སོ།",
    "དྲན་པས་ངག་གི་དངོས་གྲུབ་ཡོངས་སྩོལ་བ།",
    "རྒྱལ་ཡུམ་སྒྲ་དབྱངས་དབྱངས་ཅན་ངག་གི་ལྷར།",
    "དགུ་པ་སྲིད་པ་ཅན་ལས་ཕྱིའི་རྒྱུ་ཅུང་ཟད་དང་བཅས་འབྲས་བུ་རང་གི་ངོ་བོ་ཉིད་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
    "གསུམ་པ་གཟུགས་ཅན་གྱི་རྒྱན་ལས་མཐའ་དག་གི་གཟུགས་ཅན་ནི།",
    "མེ་ཏོག་སེན་མོས་སྤྲས་པའི་ཡལ་ག་དང་།",
    "བྲང་གི་ལོགས་སྐྱེས་མངོན་མཐོ་བཅུ་དྲུག་ལོར།",
    "གནས་པའི་ན་ཚོད་དར་བབ་སྒེག་མོའི་སྐུ།",
    "འབར་བའི་མཚར་སྡུག་ལྷ་མོ་དབྱངས་ཅན་མ།",
    "རྐང་དྲུག་ཁྱོ་ཤུག་མྱོས་པའི་འཕུར་ལྡིང་སྟོང་།",
    "དགུ་པ་ནང་གི་རྒྱུ་ཅུང་ཟད་དང་བཅས་རབ་ཏུ་གྲགས་པའི་རྒྱུ་བཀག་ནས་འབྲས་བུ་རང་གི་ངོ་བོ་ཉིད་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
    "ཚོན་པིར་རྩེ་ཡིས་མ་བྲིས་རྩིབས་སྟོང་གི།",
    "འཁོར་ལོས་མཚན་པ་ཁྱོད་ཀྱི་ཕྱག་ཞབས་མཐིལ།",
    "བཅུ་གཉིས་པ་རབ་བརྟག་གི་རྒྱན་ལས་སེམས་མེད་རབ་བརྟག་ནི་སྐུ་ཡི་སྟོད་སྨད་སྒྲིབ་བྱེད་གཅེར་ལས་སྐྱོབ།",
    "བཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱུན་ལས་ཁྱད་འཕགས་ཕུལ་བྱུང་ནི།",
    "ཞིང་མང་རྒྱལ་བ་མཆིས་སོ་ཅོག་གི་དབྱངས།",
    "བརྒྱད་པ་ལྡོག་པ་ཅན་ལས་ས་མཚམས་པས་སས་པ་མ་བསམས་པ་བསམ་ཡས་མས་ཟ་བསམས་ལས་ས་བབ་ན་ ། གཅིག་གིས་ལྡོགས་པ་ཅན་ནི།",
    "དྲི་ཟའི་རྒྱུད་མངས་སྒྲ་མཚུངས་ཁྱོད་ཀྱི་གསུང་།",
    "ཁྱོད་ཐུགས་རྣམ་པར་མི་རྟོག་ཡེ་ཤེས་ཀྱིས།",
    "དུས་གསུམ་གཟིགས་པས་མ་གཞལ་ཤེས་བྱ་ཞིག།",
    "རེག་པས་དེང་བདག་སྙན་ངག་སྨྲ་བ་ལ།",
    "ཁྱོད་མིན་ལྷ་བརྒྱའི་དྲིན་ལས་ཅི་སླད་ཐོབ།",
    "གང་གི་ཞལ་ཁྱིམ་དྲན་རྣམས་ཀུན་དགའ་བརྒྱས།",
    "ཕམ་མཛོད་དབྱངས་ཀྱི་རྒྱལ་མོའི་ནུས་སྟོབས་ལ།",
    "མཁྱེན་ཡངས་དཔལ་མོ་ཁྱོད་ཀྱིས་འགྲོ་མང་གི།",
    "འཛག་པའི་ཀུན་ཕན་ཉིད་ལ་མི་རེ་བར།",
    "དྲོད་ཀྱིས་རེག་པ་ལན་རེས་རྙིང་བྱེད་པའི།",
    "བཅུ་བཞི་པ་ཕྲ་མོའི་རྒྱན་ལས་ཟུང་གི་ཕྲ་མོ་ནི།",
    "གང་གིས་སྐྲུན་མིན་ཐུགས་རྗེ་ཆེན་པོས་འགྲོར།",
    "ཤར་བ་ཁྱོད་གཅིག་དྲིན་དུ་སྒྲོགས་པ་རྫུན།",
    "འོན་ཏེ་ཡིད་ལ་དྲན་པ་ཙམ་རེས་ཀྱང་།",
    "བསྔགས་པའི་ལྷ་ཁྱོད་སྔོན་ལས་སྐལ་བས་ཐོབ་། ཉེར་གཉིས་པ་རྒྱ་ཆེ་བའི་རྒྱན་ལས་བསམ་པ་རྒྱ་ཆེ་ནི།",
    "དཀར་མཛེས་མཚོ་བྱུང་སྨིན་ལེགས་ལང་ཚོ་ཅན།",
    "རེག་པས་གདུང་བ་ཡོངས་བཅོམ་ནུས་པའི་ཕུལ།",
    "མྱོས་པའི་སྙན་འགྱུར་ཚིག་གི་གླུ་ལེན་ཚེ།",
    "རང་གི་ཁས་བླངས་ཇི་བཞིན་འགྲོ་བའི་ངོར།",
    "ལྷ་ཁྱོད་ཟག་མེད་བདེ་ལ་ཅི་དགར་རོལ།",
    "སུམ་ཅུ་པ་ངེས་བསྟན་གྱི་རྒྱན་ལས་མཆོག་གི་ངེས་བསྟན་ནི།",
    "མེད་འདིས་ཁྱོད་ཀྱི་ཡོན་ཏན་རྫོགས་པའི་གྲངས།",
    "གཟིགས་པ་འཇུག་ཕྱིར་དོན་རྒྱན་དཔེར་བརྗོད་བགྱིས།",
    "ལྷ་མོ་དྲུག་ཁྲོ་བོ་བཅུ་དང་བཅས་མདུན་གྱི་ནམ་མཁར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཞེས་པས་སྤྱན་དྲངས་ནས།",
    "དཀར་མོ་རི་དྭགས་སོགས་ཡིད་བྱུང་གིས་མཆོད།",
    "ཞར་བྱུང་གི་ལྷ་ཉི་ཤུ་རྩ་གཉིས་ཏེ་སྐུ་དཀྱིལ་གྱི་ལྷ་དང་བཅས་པ།",
    "དེའི་ཚེ་གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཞེས་པ་ནས་སྤྱན་དྲངས་ཏེ་རང་གི་སྤྱི་བོ་ནས་ཐིམ་པར་མོས་པ་མཛོད",
    "རང་གི་སྤྱི་བོ་སྣ་ཚོགས་རྡོ་རྗེ་ཞེས་པ་ནས་ལུས་རང་བཞིན་གྱིས་གྲུབ་པའི་རྟེན་དང་བརྟེན་པར་བཅས་པ་ཐམས་ཅད་མངོན་སུམ་ལྟ་བུར་གྱུར།",
    "དེ་དག་གི་གནས་སྐབས་སུ་གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཞེས་པ་ནས་ཐིམ་པས་རང་གི་རྒྱད་ལ་དགའ་བ་བཞི་ལྡན་གྱི་ལྷན་སྐྱེས་ཡེ་ཤེས་ཞེས་དང་།",
    "དེའི་གནས་སྐབས་སུ་གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཞེས་པ་ནས་ཐིམ་པས་རང་གི་རྒྱུད་ལ་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཁྱད་པར་ཅན་སྐྱེས་ཞེས་དང་།",
    "འདི་ན་སློབ་དཔོན་གྱི་ཟབ་མོ་ལུས་ཀྱི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་རྣམ་པར་བཞུགས་ཏེ།",
    "རང་གི་སྤྱི་བོ་སྣ་ཚོགས་རྡོ་རྗེ་ཞེས་པ་ནས།",
    "གསང་ཆེན་ཐབས་རྒྱུད་ཟབ་མོའི་དཀའ་གནས་གཅོང་རོང་ཁར།",
    "དེ་ཡི་སྡུག་བསྔལ་རྟག་ཏུ་མེ་མཚོན་རྒྱ་ཚ་ལ་སོགས་རེག་བསྐྱེད་བཞིན།",
    "དམྱལ་ས་སམ་ནརྨ་བ་རྣམས་ལ་ཚ་གྲང་གི་སྡུག་བསྔལ།",
    "ཕ་མ་བྱས་རེས་ཀྱི་གནོད་པ་མཐའ་ལམ་ས་ས་མཚོསས།",
    "མ་རིག་པའི་ལིང་ཐོག་གིས་ནི་ལྡོང་།",
    "འདི་གཞན་དུ་ངེས་འབྱུང་གི་བསམ་པ་བསྐྱེད་དུ་གཞུག་པའི་དོད་ཡིན་པས་མ་ཆད་པར་བྱའོ།",
    "ཕྱི་ལུས་ངག་གི་བྱ་བ་ཁྲུས་དང་གཙང་སྦྲ་གཙོ་བོར་སྟོན་པ་བྱ་བའི་རྒྱུད་དང་།",
    "ཕྱི་ལུས་ངག་གི་བྱ་བ་དང་ནང་ཏིང་ངེ་འཛིན་མཉམ་པར་སྟོན་པ་སྤྱོད་པའི་རྒྱུད་དང་།",
    "ལམ་གཞན་མ་བསྒོམས་ཀྱང་སྐྱེ་བ་བདུན་ན་མཆོག་གི་དངོས་གྲུབ་འགྲུབ་པར་གསུངས་ཏེ།",
    "རྡོ་རྗེ་རྩེ་མོ་ལས།",
    "བརྒྱ་ནང་ན་འཇིག་རྟེན་པའི་དངོས་གྲུབ་ཕྲ་མོ་ཙམ་ཐོབ་སྲིད་ཀྱང་ཕྱི་མར་ངན་སོང་དུ་སྐྱེ་བའི་རྒྱུར་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་བསྐུར་བའི་དུས་ནི་གཟའ་སྐར་དང་སྦྱོར་བྱེད་བཟང་པོ་འཛོམ་པའི་ཡར་ངོའམ།",
    "རི་མོར་གནས་པའི་ལས་དང་ནི།",
    "དེང་སང་གི་གང་ཟག་ཕལ་ཆེར་སྨིན་བྱེད་དུ་རུང་བའི་དཀྱིལ་འཁོར་ནི།",
    "གང་ཟག་གི་སྒོ་ནས་དུ་མ་ཞིག་ཏུ་འགྱུར་བ་ལས།",
    "དེ་ལ་སའི་ལྷ་མོ་སྟ་གོན་དང་ལྷ་དང་བུམ་པ་ལྷ་གནས་ཏེ།",
    "ཁྱོར་ཆུ་སྲུང་སྐུད་ཀུ་ཤ་མསམས་སམ་ས་ནས།",
    "ཁྱོད་ནི་ཚུལ་ཆེན་སྣོད་ཡིན་ཏེ།",
    "དོན་དེ་རྣམས་ཡིད་ལ་དྲན་པ་དང་བཅས་པས་ཐལ་མོ་སྦྱར་ཏེ་ཡན་ལག་བདུན་པ་འདིའི་རྗེས་ཟློས་ལན་གསུམ་མཛོད།",
    "བདག་གིས་ཐོག་མ་མེད་དུས་ནས་ཞེས་པ་ནས།",
    "རིན་ཆེན་ཏེ་རིན་འབྱུང་གི་དམ་ཚིག་ནི།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་གསད་མི་བྱ།",
    "སྤྱི་བོར་ཨོཾ་ལས་སྣ་ཚོགས་རྡོ་རྗེ་ཨོཾ་གྱིས་མཚན་པ་རྣམས་ལམ་གྱིས་བྱུང་བར་མོས་པ་མཛོད།",
    "ཡང་ཡས་མར་རེག་སྟེ་ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་བརྗོད་པས་བརྟན་པར་བྱས་པའི་མོས་པ་མཛོད།",
    "ཞེས་ལན་བདུན་གྱིས་བྱིན་གྱིས་བརླབས་པ་དེ་ཁྱེད་རྣམས་ཕྱག་ཐལ་མོ་སྦྱར་བའི་བར་དུ་དངོས་གྲུབ་ཀྱི་མཚན་ལྟས་བརྟག་པའི་སླད་དུ་བྱིན་པར་མོས་པ་མཛོད་སྔགས་དེ་ཉིད་ཀྱིས་བྱིན།",
    "ཨོ་བཛྲ་ཧ་ས་ཧཾ་ཞེས་གསུང་ཞིང་ཐལ་མོ་ཁ་ཕྱེ་སྟེ་སོ་ཤིང་གི་རྭ་བར་ཚོམ་བུ་དགུ་བཀོད་པའི་ས་ས་ཡས་མས་མས་མས་བསམ་མ་ས།",
    "དབུས་སུ་ལྟོས་པ་མེད་པར་དོར་ཅིག་ཅེས་སྤྱི་ལྟར་དོར་དུ་བཅུག་དེ་ལྟར་དོར་བའི་རྩེ་མོ་བདག་ཉིད་ལ་ཕྱོགས་ན་མཆོག་འགྲུབ།",
    "མཚམས་རྣམས་སུ་བུམ་པ་བཟང་པོ་ལ་སོགས་པའི་དངོས་གྲུབ་ཕྲན་ཚེག་རེ་འགྲུབ་པར་འགྱུར་རོ།",
    "ཅེས་དང་སྲུང་སྐུད་ཐལ་མོའི་བར་བཟུང་ནས།",
    "དེ་ལྟ་བུའི་གོ་འཕང་དེའང་རང་གི་ངོ་བོ་བདེན་གཉིས་ཟུང་འཇུག་ཡིན་ཞིང་རྟོགས་བྱེད་ཀྱི་ཐབས་ཀྱང་བདེན་པ་གཉིས་ཀྱིས་གསལ་བར་བྱས་པ་ཡིན་ཏེ།",
    "བུ་ཀྱེ་སང་ནི་དཀྱིལ་འཁོར་ས་སམ་སམ་གཡས་པ་གཡས་ཨ་མ་ག་སལ་བ་མ་ས་ལས་མ་དག།",
    "མཆོད་སྡོང་དང་བྱེ་མ་དང་ཐལ་ཕུང་ལ་འཛེགས་པ།",
    "ཕག་དང་རྔ་མོ་དང་མ་ཧེ་ལ་ཞོན་པ།",
    "བུད་མེད་ནག་མོ་གོས་ནག་ཅན་ལ་འདོད་ལོག་སྤྱོད་པ།",
    "དེ་ལ་རང་རེ་རྣམས་ཀྱིས་རྙེད་པར་དཀའ་བའི་དལ་འབྱོར་གྱི་མི་ལུས་རྙེད།",
    "དཀྱིལ་འཁོར་གྱི་མཇུག་གི་བྱ་བ་སྟེ་བཞི་ལས།",
    "ཕྱི་ནང་གི་མཁའ་འགྲོ་མཉེས་པའི་ཕྱིར་འཇིག་མ་ཀ་ས་ས་སམ་ས་ནས་བསགས་པས་ས་གས་ང་མཐ་མག་ག་མ་བབས་པ་གཡས་བས་བདམས་ཐར་ལམ་གསར་རྟེན་ལས་འདས་པའི་གཏོར་མ་འབུལ་བ་དང་བཅས་པ་རྣམས་དགོས་ཏེ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་སྟེ་ཞེས་སོགས་ནས་སློབ་དཔོན་ཆེན་པོ་བདག་ལ་སྩོལ།",
    "གསང་བ་ཆེན་པོ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་རིགས་ཏེ་རྒྱུད་རྣམ་པར་དག་པ་གསང་བའི་ངོ་བོ་དམ་ཚིག་དང་སྡོམ་པ་ཡོངས་སུ་འཛིན་པར་བདག་ཉིད་ཆེན་པོ་ཁྱོད་འདོད་དམ་ཞེས་དྲིས་པ་ལ།",
    "ཞེས་ལན་བཏབ་པར་མོས་ཏེ་འདིའི་རྗེས་ཟློས་ལན་གསུམ་མཛོད།",
    "བདག་གིས་ཐོག་མ་མེད་དུས་ཞེས་པ་ནས་གནས་པར་བགྱི།",
    "ཅེས་པས་དམ་ཚིག་དང་སྡོམ་པ་མ་ལུས་པར་བཟུང་བར་ཁས་བླངས་ནས་སློབ་དཔོན་གྱིས་རྡོ་རྗེ་དང་བཅས་ཏེ་སྨད་གཡོགས་གོས་དམར་པོ་རེ་ཐོགས་ནས་ཁྱེད་རྣམས་ལ་བྱིན་པར་མོས་པ་མཛོད།",
    "སྔོན་ཆད་མཁའ་འགྲོ་ལྔ་རིགས་བསྡུས་པའི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པའམ་ཞུགས་ཀྱང་བསྐྱར་ནས་འཇུག་པའི་མཚོན་བྱེད་དུ་རས་ཡུག་དམར་པོ་རེས་གདོང་བཅིང་བར་མོས་པ་མཛོད།",
    "སློབ་དཔོན་གྱིས་བསྲུང་བའི་ཆེད་དུ་ཨོཾ་བཛྲ་སོགས་བདུད་རྩི་འཁྱིལ་པའི་སྔགས་བརྗོད་ཅིང་ལས་བུམ་གྱི་ཆུས་གཏོར་ནས་བསྲུང་བ་བྱས་པར་མོས་པ་མཛོད།",
    "དེ་རྣམས་ལས་འོད་ཟེར་འཕྲོས་པས་སྒོ་གསུམ་གྱི་སྒྲིབ་པ་སྦྱངས་པར་མོས་ཏེ།",
    "དེ་ལ་དམིགས་ཏེ་སློབ་དཔོན་གྱིས་ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་བཟླས་པས་བྱིན་གྱིས་བརླབས་པར་མོས་པ་མཛོད།",
    "བུ་ཁྱོད་སུ་ཡིན་ཅི་ལ་དགའ།",
    "ཞེས་དྲིས་པའི་ལན་བཏབ་པར་མོས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "སློབ་དཔོན་གྱིས་ཁྱེད་རྣམས་ཀྱི་ལག་པ་བཟུང་སྟེ་དཀྱིལ་འཁོར་གྱི་དྲུང་དུ་ཁྲིད་པར་མོས་པ་མཛད་ནས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཨོཾ་ཀི་ལི་ཀི་ལི་སོགས་ནས་ཡུཾ་སྭཱ་ཞེས་པས་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོའི་ནང་དུ་འཁོད་པར་མོས་པར་བྱ་བ་དེ་རྣམས་ནི་ཕྱིའི་འཇུག་པ་ཡིན།",
    "ནང་དུ་བྱ་བའི་ཆོ་ག་ལ་གསུམ་གྱི་ཐོག་མར་ལུས་དབུལ་བའི་སླད་དུ་ཁྱེད་རང་རྣམས་སྐད་ཅིག་གིས་རྣམ་པར་སྣང་མཛོད་ཀྱི་སྐར་གསལ་བཏབ་ནས་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "ཨོཾ་སརྦ་བུདྡྷ་སོགས་ནས་མི།",
    "སྤྱི་བོར་རྡོ་རྗེ་བཞག་སྟེ་དེང་ཁྱོད་ནས་ཏ་རེ།",
    "སྔོན་དུ་བསྒྲུབས་པའི་དམ་ཚིག་གི་ཆུ་ཨོ་ཨཱ་སྭཱ་ཧཱ།",
    "འདི་ནི་ཁྱོད་ཀྱི་ནས་ཨོ་ཨཱ་སྭཱ་ཧཱ་ཞེས་དང་།",
    "དེང་ཕྱིན་ཆད་ཁྱོད་ནས་ཏ་རེ།",
    "ཁྱེད་རང་རྣམས་ལུས་ཙོག་པུ་གང་ལའང་མ་སྐྱེས་པར་མེ་ཏོག་དང་བཅས་པའི་ཐལ་མོ་སྦྱར་ཏེ་སེམས་གཞན་དུ་མ་ཡེངས་པར་མཛོད་ཅིག་སྤོ་ན།",
    "གཞན་རྒྱུད་ལ་གྲུབ་ཟིན་གྱི་ཡེ་ཤེས་པ་ལྷ་ལ་སོགས་པའི་རྣམ་པ་ཅན་དུ་སྔགས་དང་རྫས་དང་ཏིང་ངེ་འཛིན་ལ་སོགས་པའི་སྒོ་ནས་འབེབས་པའི་ཆོ་ག་བྱས་པ་ལ་བརྟེན་ནས་རང་རྒྱུད་ལ་འབྱུང་རུང་གི་ཡེ་ཤེས་པ་མངོན་དུ་གྱུར་པ་ལ་ཡེ་ཤེས་ཕེབས་པའི་ཐ་སྙད་བྱེད་པ་ལགས་པ་དེའི་སླད་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "སློབ་དཔོན་ལ་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་དངོས་ཡིན་སྙམ་པའི་མོས་གུས་བྱས་པས།",
    "དེའི་ཚེ་སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཡིན་པ་ལ་རྣམ་པ་དང་པོའི་རྡོ་རྗེ་ཕྲ་མོའི་ཚོགས་དཔག་ཏུ་མེད་པ་སྤྱན་དྲངས་ཏེ་ཁྱེད་རྣམས་ཀྱི་བ་སྤུའི་བུ་ག་རྣམས་ནས་རྒྱ་མཚོ་ལ་ཆར་བབས་པ་ལྟར་ཐིམ་པར་མོས་པ་མཛོད།",
    "ཞེས་རོལ་མོ་དང་འབེབས་པའི་རྫས་ཀྱི་དུད་པ་དང་བཅས་པས་དབབ་བོ།",
    "ངོ་བོ་ལ་བཟང་ངན་གྱི་ཁྱད་པར་མེད་མོད།",
    "འོན་ཀྱང་རང་གིས་ལས་བསགས་པའི་ལྷ་ཞིག་ལ་འབབ་པར་ཤོག་ཅིག་སྙམ་པའི་བློས།",
    "ཁྱེད་རྣམས་ཀྱི་མིག་གཉིས་སུ་ཨོ་ཡིག་རབ་ཏུ་འབར་བ་རེ་སྒོམས་ཤིག་ཨོ་ཧེ་རུ་ཀ་ནས་སྭཱ་ཧཱ།",
    "འདབ་མ་བརྒྱད་པོ་རྣམས་དང་ཕྱིའི་དཀྱིལ་འཁོར་གྱི་ལབསམཐདགས་མ་སས་བབས་བཅས་ཟམ་གཡས་གཡབབས་ཕག་ཀ་སྒོ་བཞིར་ཟླ་བ་དང་ཉི་མ་དང་རོའི་གདན་རེ་རེ་དང་བཅས་པ་ནི་རྟེན་གཞལ་ཡས་ཁང་པ་ཡིན་ལ།",
    "དེ་རྣམས་ཀྱི་ནང་གི་ཤར་དུ་ཕན་པའི་དཀྱིལ་འཁོར་གྱི་ཤར་དུ་སྐམ་པ་མ།",
    "བྱང་ཤར་དུ་སྒེག་མོ།",
    "ཤར་ལྷོར་བཞད་པ་མོ།",
    "ནུབ་བྱང་དུ་རྫ་རྔ་མ་སྟེ་བརྒྱད་ཀྱིས་བསྐོར་བའི་དབུས་སུ་རྟ་མགྲིན་པདྨ་རཱ་ག་ལྟར་དམར་བ་ཡུམ་གོས་དཀར་མོ་དང་མཉམ་པར་སྦྱོར་བ་བྱང་དུ་རྟའི་རྒྱལ་པོའི་དཀྱིལ་འཁོར་གྱི་ཤར་དུ་སྒོ་ལྕགས་མ།",
    "ལྷོ་ནུབ་ཏུ་གོས་དཀར་མོ།",
    "ལྷོ་ནུབ་ཏུ་གདོལ་པ་མོ།",
