    "ཞལ་རེ་རེ་ཞིང་སྤྱན་གསུམ་གསུམ་ལྡན་ཞིང་མཆེ་བ་བཞི་བཞི་གཙིགས་པ།",
    "གཡོན་གྱི་གསུམ་པ་ན་རྡོ་རྗེས་མཚན་པའི་ཁ་ཊཾ་ག་བཞི་པ་ན་ཁྲག་གིས་གང་བའི་ཐོད་པ།",
    "ཞབས་ལུས་དཀྱིལ་མ་གཏོགས་པར་གདན་སྔར་ནས་གསལ་བཏབ་ཟིན་པ་རྣམས་ལ་པདྨ་དང་ཉི་མའི་སྟེང་ན་ཞེས་པ་མ་བརྗོད་ཀྱང་ཆོག་གཡས་བརྐྱང་བས་དུས་མཚན་མ་དམར་མོ་དང་།",
    "གཡོན་ན་ཚེས་གཅིག་གི་ཟླ་བ་དང་།",
    "དབུ་རེ་རེ་ལ་མི་མགོ་སྐམ་པོ་ལྔ་ལྔའི་དབུ་རྒྱན་དང་རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་ཅན།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "དེའི་པང་ན་ཡུམ་རྡོ་རྗེ་ཕག་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་མ་སྤྱན་གསུམ་དང་ལྡན་པ།",
    "ཕྱག་གཡོན་པས་བདུད་དང་གདུག་པའི་ཁྲག་གིས་གང་བའི་ཐོད་པ་འཛིན་པས་ཡབ་ལ་འཁྱུད་པ།",
    "གཡས་པས་སྡིགས་མཛུབ་དང་བཅས་པའི་གྲི་གུག་གིས་ཕྱོགས་ཐམས་ཅད་དུ་བསྡིགས་པ།",
    "པདྨའི་འདབ་མ་བཞི་ལ་ཤར་དུ་མཁའ་འགྲོ་མ་སྔོན་མོ།",
    "བྱང་དུ་ལཱ་མཱ་ལྗང་གུནུབ་ཏུ་ཁཎྜ་རོ་ཧཱ་དམར་མོ།",
    "ལྷོར་གཟུགས་ཅན་མ་སེར་མོ།",
    "དེ་ཡི་སྡུག་བསྔལ་རྟག་ཏུ་མེ་མཚོན་རྒྱ་ཚ་ལ་སོགས་རེག་སྐྱེད་བཞིན་ཞེས་གསུངས་པ་ལྟར་སྡུག་བསྔལ་དང་སྐྱོན་དང་ཉེས་དམིགས་ཀྱི་རང་བཞིན་ལས་མ་འདས་པ་ཡིན་ཏེ།",
    "ཚེ་འདིའི་མར་མ་ལ་ས་བབ་མམས་ཁ་གསབ་མ་སབསམ་པས་ཡབ་ལམ་གནས་ལ་མ་ཟབདེ་འབྲས་དང་ཕྱི་མ་ལྷ་མིའི་གོ་འཕང་ལ་སོགས་པ་ཞར་བྱུང་གི་ཚུལ་གྱིས་འགྲུབ་པ་ཡིན་ཏེ།",
    "འོག་ཏུ་ངེས་འབྱུང་གི་བསམ་པ་བསྐྱེད་པ་མེད་པས་འདི་མ་ཆད་པ་གལ་ཆེའོ།",
    "ཕྱི་ལུས་ངག་གི་བྱ་བ་ཁྲུས་དང་གཙང་ས་གཙོ་བོ་སྟོན་པ་བྱ་བའི་རྒྱུད་དང་།",
    "ཕྱི་ལུས་ངག་གི་བྱ་བ་དང་ནང་ཏིང་ངེ་འཛིན་མཉམ་པར་སྟོན་པ་སྤྱོད་པའི་རྒྱུད་དང་།",
    "འདིར་དྲང་བའི་དོན་དུ་ཤེས་རབ་ཟབ་མོའི་དོན་གཙོ་ཆེ་ཞིང་།",
    "སོ་ཤིང་ཀུཤ་ཁྱོར་ཆུ་སྦྱིན།",
    "སྙིམ་པ་མེ་ཏོག་དང་བཅས་པའི་ཐལ་མོ་སྦྱར་ནས་འདིའི་རྗེས་ཟློས་ལན་གསུམ་མཛོད།",
    "དེའི་དོན་ནི་ཁྱེད་རྣམས་ལ་བུ་ཞེས་ཉེ་བའི་ཚིག་གིས་བོས་ནས།",
    "ཨོ་བཛྲ་ཨ་མྲྀ་ཏ་སོགས་གཙོ་བོའི་སྔགས་བརྗོད་པ་དང་།",
    "ཁྱེད་རྣམས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་བསྲེགས་ཤིང་སྦྱངས་ནས་ཁྱེད་རང་རྣམས་པདྨ་དང་ཉི་མ་དང་ཐོད་པའི་གདན་གྱི་སྟེང་དུ་ཧཱུཾ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ལས་སྐད་ཅིག་གིས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་སོགས་ནས།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་རྡོ་རྗེ་དང་བཅས་པའི་དྲིའི་ཆུས་ཁྱེད་རྣམས་ཀྱི་གནས་གསུམ་དུ་མས་ཡར་རེག་སྟེ།",
    "སྤྱི་བོར་ཉི་མ་ལ་གནས་པའི་ཨོ་ལས་སྣ་ཚོགས་རྡོ་རྗེ་རྣམས་ལམ་གྱིས་བྱུང་བར་མོས་ཤིང་།",
    "སླར་ཡང་ཡས་མར་རེག་སྟེ་ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་བརྗོད་པས་ཕྱག་མཚན་དེ་རྣམས་ཡིག་འབྲུ་གསུམ་གྱིས་སོ་སོར་མཚན་པར་གྱུར་མས་མས་ཨ་མ་བ་མ་བ་མ་པར་མོས་པ་མཛོད།",
    "དང་པོར་གསུམ་ལ་སྐྱབས་སོང་སྟེ།",
    "བདག་གིས་ཐོག་མ་མེད་དུས་ཞེས་པ་ནས།",
    "བུ་མོ་གཞོན་ནུས་བཀལ་པའི་སྐུད།",
    "བུད་མེད་ཀྱི་གཡས་པར་ཉིས་བསྐོར་དུ་བཅིངས་ལ་ལས་བུམ་གྱི་ཆུས་གཏོར་ཞིང་།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་སོགས་གཙོ་བོའི་སྔགས་ཀྱིས་བྱིན།",
    "ཞེས་གསུང་ཞིང་ཐལ་མོ་ཁ་ཕྱེ་སྟེ་སོ་ཤིང་གི་རྭ་བ་ཚོམ་བུ་དགུ་བཀོད་པའི་དབུས་སུ་ལྟོས་པ་མེད་པར་དོར་ཅིག་ཅེས་བརྗོད།",
    "དཀྱིལ་འཁོར་གྱི་ཤར་ཕྱོགས་སུ་དྲིའི་མཎྜལ་ཁྲུ་གང་གྲུ་བཞི་པར་ཚོམ་བུ་བཀོད་པའི་སྟེང་དུ་དོར་བཅུག་དེ་ལྟར་དོར་བས་རྩེ་མོ་བདག་ཉིད་ལ་ཕྱོགས་ན་མཆོག་འགྲུབ།",
    "སྟོང་པའི་ངང་ལས་བྷིདང་ཧ་ལས་བྱུང་བའི་ཀུ་ཤ་ཆེ་ཆུང་རྩ་བ་དང་རྩེ་མོ་མ་ཉམས་པ།",
    "ཧ་བཟླས་པས་ཆེ་བ་སྟན་གྱི་ཕྱིར་ཕྱག་གཡོན་པར་བྱིན་པར་མོས་ཞེས་པས་བྱིན་ནོ།",
    "བྱེད་ཁྱོར་ཆུ་སྦྱིན་པ་ནི།",
    "གསང་སྔགས་དག་གིས་སྤོས་ཀྱི་ཆུ།",
    "ཁྱོར་བར་བླུགས་ལ་ལན་གསུམ་སྦྱིན།",
    "བལྟམས་པ་བསམས་ས་མ་ས་ཨ་མས་ན་ཁ་བྱེ།",
    "དཀོན་པས་ཅི་ཕན་རི་བོང་གི་རྭ་དང་ནམ་མཁའི་མེ་ཏོག་ཀྱང་དཀོན་ནོ་སྙམ་ན།",
    "ཐལ་ཕུང་ལ་འཛེགས་པ།",
    "བོང་བུ་ལ་ཞོན་ཏེ་ལྷོ་ཕྱོགས་སུ་སོང་སྟེ་མ་ལོག་པ་དང་།",
    "སྤྲེའུ་ལ་ཞོན་ནས་ཤར་ལྷོ་དང་ཤར་ཕྱོགས་སུ་འགྲོ་བ་ཕག་དང་རྔ་མོ་ཞེས་པ་ཙམ་དང་བདེན་མེད་ཀྱི་སྣང་བའི་རྒྱས་འདེབས་པ་དང་གཙོ་བོའི་སྔགས་བརྒྱ་རྩ་བརྒྱད་ཀྱིས་བསྲུངས་ལ།",
    "དང་པོ་ལ་བདག་བསྐྱེད་སྔོན་དུ་སོང་བས།",
    "དེའི་རྗེས་སུ་ཕྱི་ནང་གི་མཁའ་འགྲོ་མཉེས་པའི་ཕྱིར་དུ་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་གཏོར་མ་དབུལ་བ་དང་།",
    "ནང་གི་སེམས་བསྐྱེད་གསང་བར་གདམས།",
    "ཞེས་པའི་དོན་ནི་ཐུན་མོང་བའི་སྦྱང་བས་རྒྱུད་རྣམ་པར་དག་པ།",
    "རྒྱུད་རྣམ་པར་དག་པ་གསང་བའི་ངོ་བོ་དམ་ཚིག་དང་སྡོམ་པ་ཡོངས་སུ་འཛིན་པར་བདག་ཉིད་ཆེན་པོ་ཁྱོད་འདོད་དམ་ཞེས་བྱ་བ་ཡིན་པས།",
    "ཁྱེད་རྣམས་ཀྱིས་ཀྱང་ཇི་ལྟར་དྲིས་པ་དེ་ལྟར་འཛིན་པར་སྤྲོའོ་ཞེས་ལན་བཏབ་པར་མོས་ཏེ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "བདག་གིས་ཐོག་མ་མེད་དུས་ཞེས་སོགས་ནས་གནས་པར་བགྱི་ཞེས་པས་རྒྱུད་དག་པར་བྱས་ནས་རིགས་ལྔ་སྤྱི་དང་ཁྱད་པར་གྱི་དམ་ཚིག་རྣམས་ཀྱང་འཛིན་སྙམ་པས་འདིའི་རྗེས་ཟློས་ལན་གསུམ་མཛོད།",
    "སློབ་དཔོན་གྱིས་རྡོ་རྗེ་དང་བཅས་ཏེ་སྨད་གཡོགས་དམར་པོ་རེ་ཐོགས་ནས་ཁྱེད་རྣམས་ལ་བྱིན་པར་མོས་པ་མཛོད།",
    "གཡོགས་རེ་ཡང་བྱིན་པར་མོས་པ་མཛོད།",
    "ཡང་སྤྱི་བོར་གཙུག་ཏོར་རེ་ཡང་བཅིང་བར་མོས་པ་མཛོད།",
    "སྔོན་ཆད་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པའམ་ཞུགས་ཀྱང་བསྐྱར་ནས་འཇུག་པའི་མཚོན་བྱེད་དུ་རས་ཡུག་དམར་པོ་རེས་གདོང་བཅིང་བར་མོས།",
    "སློབ་དཔོན་གྱིས་བདུད་རྩི་འཁྱིལ་བའི་སྔགས་བརྗོད་ཅིང་ལས་བུམ་གྱི་ཆུས་གཏོར་ནས་བསྲུང་བ་བྱས་པར་མོས་པ་མཛོད།",
    "ནམ་ས་མནྟ་བུདྡེ་སོགས་བརྗོད།",
    "ཨ་ཁཾ་ཝཱི་ར་ཧཱུྃ་གིས་བྱིན་ནས།",
    "རང་གི་ལུས་ཀྱི་ནང་ཐམས་ཅད་གང་བས་ལུས་ངག་ཡིད་གསུམ་གྱི་སྡིག་སྒྲིབ་ཉེས་ལྟུང་རྣམས་སྦྱངས་པར་མོས་ནས།",
    "སློབ་དཔོན་གྱིས་ཡི་གེ་གསུམ་བརྗོད་ཅིང་ཁྱེད་རྣམས་ཀྱི་གནས་གསུམ་དུ་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་རློབ་པའི་ཕྱག་རྒྱས་རེག་སྟེ་ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་སམ་ཡང་ན་ཧཱུྃ་བརྗོད་ཅིང་འཁོར་ལོའི་ཕྱག་རྒྱས་ཁྱེད་རྣམས་ཀྱི་གནས་གསུམ་ལྟེ་བ་གསང་གནས་རྣམས་སུ་རེག་སྟེ་བྱིན་གྱིས་བརླབ་པར་མོས་པ་མཛོད་ཅེས་དང་ཧཱུྃ་བཟླའོ།",
    "བུ་ཁྱོད་སུ་ཡིན་ཅི་ཁམས་བས་ས་ས་གཡས་བབས་ནས་ངས་ལ་དགའ།",
    "ཞེས་དྲིས་པའི་ལན་བཏབ་པར་མོས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཞེས་དྲིས་པའི་ལན་བཏབ་པར་མོས་ནས།",
    "དེ་ཉིད་གཟུགས་ཀྱི་རྣམ་པར་ལངས་པ་ལས་བྱུང་བ་ཟླ་བའི་སྟེང་དུ་རྡོ་རྗེ་དཀར་པོ་རྩེ་ལྔ་པ་འོད་ཟེར་འཕྲོ་བ་དང་བཅས་པ་ཞིག་གསལ་ལམ་གྱིས་བྱུང་བར་མོས་ཏེ།",
    "ཞེས་པས་སེམས་བསྐྱེད་པ་རྣམས་ཕྱི་འཇུག་གི་གཙོ་བོ་ཡིན་པས་བརྡ་དོན་འཕྲོད་པ་གལ་ཆེ།",
    "དེང་ཁྱོད་ཞེས་པ་ནས་ལའང་མ་ཡིན་ནོ་ཞེས་གསང་བར་གདམས་པ་རྣམས་ནི་ཕྱིའི་འཇུག་པ་ཡིན།",
    "ནང་འཇུག་གི་སླད་དུ་སློབ་དཔོན་གྱིས་ཁྱེད་རྣམས་ཀྱི་ལག་པ་ནས་བཟུང་སྟེ་དཀྱིལ་འཁོར་གྱི་དྲུང་དུ་ཁྲིད་པར་མོས་ནས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་དབུ་འདུད་པ་དང་བཅས་པས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རྣམས་སྐད་ཅིག་གིས་སྐུ་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛོད་ཀྱི་སྐུར་གྱུར་པའི་དཔྲལ་བར་ཨོཾ་ལས་འཁོར་ལོ་ཞེས་པ་ནས་ཉི་མ་ལ་ཧཱུྃ་རྣམས་གསལ་བཏབ།",
    "དེང་ཁྱོད་ཅེས་པ་ནས་གྱུར་ཏ་རེ་ཞེས་དང་།",
    "ཁྱེད་རང་རྣམས་ལུས་ཙོག་པུ་གང་ལའང་མ་སྐྱེས་པར་མེ་ཏོག་དང་བཅས་པས་ཐལ་མོ་སྦྱར་ཏེ་སེམས་གཞན་དུ་མ་ཡེངས་པར་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "སློབ་དཔོན་ལ་རྡོ་རྗེ་སེམས་དཔའ་དངོས་ཡིན་སྙམ་པའི་མོས་གུས་བྱས་པས།",
    "དང་པོའི་རྡོ་རྗེའི་རྣམ་པ་བསམ་གྱིས་མི་ཁྱབ་པས་བྱོན་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་བ་སྤུའི་བུ་ག་རྣམས་ནས་དཔག་ཏུ་མེད་པར་ཞུགས་པར་མོས་པ་མཛོད།",
    "ཞེས་འབེབས་སྔགས་མང་དུ་བརྗོད་ཅིང་རོལ་མོ་བྱ།",
    "སྲོལ་བར་གྱིས་ཤིག་དེ་ནས་དངོས་གྲུབ་ཀྱི་ལྟས་བརྟག་པའི་ཆེད་དུ་ཁྱེད་རྣམས་མིག་རས་དང་བཅས་བཞིན་པས་དཀྱིལ་འཁོར་གྱི་སྟེང་གི་བར་སྣང་ལ་བལྟས་ཏེ་མིག་གི་ལམ་དུ་ཁ་དོག་གང་སྣང་བ་ཞིག་ངེད་ལ་སྨྲ་དགོས་པས།",
    "ངོ་བོ་ལ་མཆོག་དམན་གྱི་ཁྱད་པར་མེད་མོད་རང་གི་ལས་བསགས་པའི་ལྷ་ཞིག་ལ་འབབ་པར་ཤོག་ཤིག་སྙམ་པའི་བློས།",
    "མིག་གཉིས་ལ་འབར་བ་དང་བཅས་པའི་ཨོ་རེ་བསྒོམ་མཛོད་སློབ་དཔོན་གྱིས་ཨོ་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་པ་ནས་སྭཱ་ཧཱ་ཞེས་མ་རིག་པའི་ལིང་ཏོག་དང་མིག་རས་ལྷན་ཅིག་བསལ་ཏེ།",
    "ནུབ་སྒོར་རྡོ་རྗེ་ལྕགས་སྒྲོག་མ་དམར་མོ།",
    "བདེན་བྲལ་དུ་མར་མེ་མ་སེར་མོ།",
    "མེར་པི་ཝང་མ་སེར་མོ།",
    "བདེན་བྲལ་དུ་མུ་ཀུནྡ་དམར་མོ།",
    "ཕྱི་ནང་གི་ལྷ་མོ་བརྒྱད་པོ་ཐམས་ཅད་ཀྱང་ཞལ་གཅིག་ཕྱག་གཉིས་མ།",
    "དཀྱིལ་འཁོར་དང་པོའི་ལྷ་སྣམ་གྱི་ཤར་དུ་རྡོ་རྗེ་དྲག་ཤུལ་མ་དཀར་མོ།",
    "བསམས་གཟུགས་བརྙན་མ་སེར་མོ།",
    "ནུབ་ཏུ་འདོད་ཆགས་རྡོ་རྗེ་མ་དམར་མོ།",
    "བདེན་བྲལ་དུ་སྒྲ་རྡོ་རྗེ་མ་སྔོན་མོ།",
    "དབུས་ཀྱི་ལེ་ཙེ་དགུའི་ཤར་གྱི་རེ་མིག་གི་བ།",
    "མེར་མཱ་མ་ཀཱི་སྔོན་མོ་ཞལ་གཅིག་ཕྱག་བཅུ་གཉིས་མ།",
    "བདེན་བྲལ་དུ་གོས་དཀར་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་བརྒྱད་མ།",
    "དེ་ཉིད་ལ་ཆུ་བཞིའི་སྦྱང་བ་བྱས་པའི་མོས་པ་མཛོད།",
    "སླར་ཆུས་ཀྱང་སྦྱངས་པར་མོས་པ་མཛོད།",
    "སློབ་དཔོན་དཀྱིལ་འཁོར་པ་དང་བཅས་པས་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ཐོགས་ནས་གཡས་སུ་ཡོ་བ་དང་བཅས་ཏེ་བཀྲ་ཤིས་ཀྱི་ཆོ་ག་བྱས་པར་མོས་པ་མཛོད།",
    "སྟོང་པའི་ངང་ལས་པདྨ་དང་ཉི་མའི་སྟེང་དུ་ཧཱུཾ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་དེ་ལས་འོད་ཟེར་འཕྲོས་འདུས་གཅིག་ཏུ་གྱུར་པ་ལས།",
    "དེ་དག་གི་མིག་ཏུ་གཏི་མུག་རྡོ་རྗེ་མ་ནས་ཐུགས་རྡོ་རྗེ་མ།",
    "མདུན་གྱི་ནམ་མཁར་མངོན་སུམ་བཞིན་དུ་བཞུགས་པར་མོས་པ་མཛོད།",
    "ཞེས་པ་ནི་བདག་འཇུག་གི་སྐབས་སུ་བརྗོད་པ་ཡིན་གྱི་འདིར་དཀྱུས་ལྟར་འདོན་ནོ།",
    "མི་བསྐྱོད་པའི་རང་བཞིན་ཅན་གྱི་བུམ་པ་དཀར་པོ་ཡེ་ཤེས་ཀྱི་བདུད་རྩིས་གང་བ་རེ་ཐོགས་ཏེ།",
    "ཆུའི་ལྷག་མར་ཡར་ལུད་པ་ལས་ཁྱེད་རྣམས་ཀྱི་སྤྱི་བོར་མི་བསྐྱོད་པས་དབུར་བརྒྱན་པའི་མོས་པ་མཛོད།",
    "ཧཱུྃ་ཧཱུྃ་ཨོཾ་སོགས་ས་བོན་སུམ་ཅུ་སོ་བདུན་ཙམ་གྱི་མཐར་ཨོཾ་བཛྲ་བྷ་ཝ་ཨ་བྷི་ཥིཉྩ་ཧཱུཾ་ཞེས་གསུང་ཞིང་བུམ་པའི་ཆུས་ནས་རིན་ཆེན་འབྱུང་ལྡན་གྱིས་དབུར་བརྒྱན་པར་མོས་པ་མཛོད།",
    "དེ་ལ་ནམ་མཁར་བཞུགས་པའི་ལྷ་མོ་རྣམས་ཀྱིས་མཆོད་དེ།",
    "བསྐར་བྱེད་ནམ་མཁའི་དཀྱིལ་འཁོར་རྣམས་དང་སློབ་དཔོན་ལྷན་ཅིག་པས་དོན་ཡོད་གྲུབ་པའི་རང་བཞིན་ཅན་གྱི་དྲིལ་བུ་གདན་གསུམ་ཚང་བ་རེ་ཐོགས་ཏེ།",
    "བསྐར་བྱེད་ནམ་མཁའི་དཀྱིལ་འཁོར་རྣམས་དང་སློབ་དཔོན་ལྷན་ཅིག་པས་རྣམ་སྣང་གི་རང་བཞིན་ཅན་གྱི་མིང་གདན་གསུམ་ཚང་བ་རེ་མེ་ཏོག་གང་ལ་ཕོག་པའི་ལྷ་ལས་དྲས་ཏེ་བཏགས་པར་མོས་པ་མཛོད།",
    "བུད་མེད་ལ།",
    "རྡོ་རྗེ་སྒེག་མོ་ལ་སོགས་གང་རིགས་གདགས།",
    "གཙོ་བོ་སྟེ་རང་གི་ལྷག་པའི་ལྷ་ཡིན་ལ།",
    "དེ་ལྟར་ངེས་པར་བྱས་ནས་སྔགས་ཀྱི་བཟླས་ལུང་གི་སླད་དུ་གསོལ་བ་འདེབས་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "སློབ་དཔོན་རྡོ་རྗེ་སེམས་དཔར་གསལ་བའི་ཐུགས་ཀར་ཉི་མ་ལ་གནས་པའི་ཧཱུྃ་གི་མཐར་སྔགས་ཀྱིས་བསྐོར་བ་དང་།",
    "བཅོམ་ལྡན་བདག་གིས་ནས་མཛད་དུ་གསོལ།",
    "སློབ་དཔོན་གྱིས་ཀྱང་མེ་ཏོག་སྤྱི་བོར་བཞག་ལ་སྔགས་ཀྱི་དངོས་གྲུབ་སྩལ་ཞིང་བརྟན་པར་བྱས་པའི་མོས་པ་མཛོད།",
    "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་ཆེན་པོ་དང་།",
    "ཕྱག་རྒྱ་ལ་སོགས་པ་ཐམས་ཅད་སུ་ཡང་རུང་བ་ལ་སྨྲས་ན་ཁྱོད་ཉམས་པར་གྱུར་ཏ་རེ།",
    "ཐོག་མར་རྡོ་རྗེ་ཐུགས་ཀྱི་དམ་ཚིག་གི་སླད་དུ།",
    "དྲིལ་བུ་གསུང་གི་དམ་ཚིག་གི་སླད་དུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངག་སྲིད་པ་ཐམས་ཅད་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་སྟོན་པར་བྱེད་པ་ངེས་དོན་གྱི་དྲིལ་བུ་ཡིན་ནོ་སྙམ་དུ་མོས་པ་མཛོད།",
    "ཕྱག་རྒྱ་ཆེན་པོ་སྐུའི་དམ་མ་བ་ཚིག་གི་སླད་དུ།",
    "སྲིད་པའི་སྡུག་བསྔལ་ཟད་པར་བྱ་བའི་ཕྱིར་རང་གི་ལྷག་པའི་ལྷའི་རྣལ་འབྱོར་བྱ་སྟེ།",
    "རོལ་མོའི་སྒྲ་དང་།",
    "ཕྱིའི་སྐྱེ་མཆེད་ནི་ལྷ་མོའི་གདན།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་ལ་སོགས་པ་ཟད་པར་བྱེད་པ་ནི་ཁྲོ་བོ་དང་ཁྲོ་མོའི་གདན་ཡིན་ནོ།",
    "ཐབས་ཀྱི་མདའ་དྲུག་ཤེས་རབ་ཀྱི་གཞུ་ལ་བཀང་ནས་ཕྱོགས་བཞི་སྟེང་འོག་གཉིས་ཏེ་དྲུག་ཏུ་འཕངས་པས་རང་དོན་ཡིད་བྱེད་ཀྱི་བསམ་པ་བཅོམ་པར་མོས་ལ།",
    "དེ་ལྟར་ངེས་པའི་སྒོ་ནས་འཁོར་ལོ་བསྐོར་བ་དང་དུང་འབུད་པ་དང་དྲིལ་བུ་འཁྲོལ་བ་དང་གླེགས་བམ་ཀློག་པའི་ཚུལ་མཛོད་ཅིག་དེང་ནས་བརྩམས་ཏེ་སེམས་བསྐྱེད་པ་སོགས་ནས་སྲུང་བ་མཛོད།",
    "ཉེ་བར་སྦྱོར་ཞེས་དང་ཁྱེད་རང་རྣམས་དེ་བཞིན་གཤེགས་པ་རྣམ་སྣང་ལ་སོགས་པའི་ང་རྒྱལ་དུ་རིམ་པར་འཕོས་ནས་ཕྱག་རྒྱ་རྣམས་ཀྱི་ལད་མོ་མཛོད།",
    "གཡས་པས་རྡོ་རྗེ་དྲིལ་བུ་དང་བཅས་སྐྱབས་སྦྱིན་གྱི་ཕྱག་རྒྱ་བྱས་ཏེ་ཁྱེད་རྣམས་རང་རང་གི་གསང་མཚན་དང་མཐུན་པའི་དེ་བཞིན་གཤེགས་པར་འགྱུར་རོ་ཞེས་དཀྱིལ་འཁོར་པ་དང་མགྲིན་གཅིག་ཏུ་ལུང་སྟོན་པར་མོས་པ་མཛོད།",
    "ཕྱིན་ཆད་སྲིད་པའི་སྡུག་བསྔལ་སྐྱེ་བ་དང་འཆི་བ་མེད་པས་བདུད་དང་བར་དུ་གཅོད་པ་གང་གིས་ཀྱང་མི་ཚུགས་ཤིང་མི་འཆི་བས་ཅིས་ཀྱང་འཇིགས་པ་མེད་པས་སྨིན་གྲོལ་གྱི་ལམ་འདི་ལ་དགའ་བར་གྱིས་ཤིག་དེ་ལྟར་བྱས་ན་སྲིད་པ་ཤིན་ཏུ་དག་པ་སྐུ་བཞིའི་འབྱོར་བ་ཐོབ་སྟེ།",
    "རྩ་བ་དང་ཡན་ལག་གི་དམ་ཚིག་དང་སྡོམ་པ་གྲུབ་པ་འདི་དག་རྟག་ཏུ་བསྲུང་དགོས་ཏེ།",
    "རྟོགས་བསྐྱེད་སྤྲོ་བསྐྱེད་རྗེས་གསུམ་མོ།",
    "སློབ་དཔོན་རང་རྣམ་པར་སྣང་མཛོད་སོགས་ནས་དཀར་བ་ཁྱེད་རྣམས་ཀྱི་ལྕེ་ཐོག་ཏུ་བཞག་པར་མོས་པ་མཛོད།",
    "དེ་ལྟར་མྱངས་པས་མགྲིན་པ་སོགས་ནས་སྐྱེས་པར་མོས་པ་མཛོད།",
    "དཔོན་སློབ་གཉིས་ཀ་སྐད་ཅིག་གིས་འོད་དཔག་མེད་དུ་གྱུར་པར་མོས་ནས།",
    "སློབ་དཔོན་བགྱི་ཐུགས་ཀ་ནས་མཚན་ཉིད་དང་ལྡན་པའི་རིག་མ་ཡིད་དུ་འོང་བ་ལང་ཚོ་དར་ལ་བབ་པ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ་ཅིག་སྤེལ་ཏེ་དེའི་ལག་པ་ཁྱེད་རང་རྣམས་ཀྱི་ལག་པ་གཡོན་པར་གཏད་པའི་མོས་པ་མཛོད།",
    "དེ་ལྟར་སྤྲོའོ་ཞེས་ལན་བཏབ་པར་མོས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ལྷག་པར་མོས་པའི་ཡིད་ཀྱིས་ཤེས་པར་བྱས་ནས།",
    "ཟབ་མོ་སྟོང་པ་ཉིད་དང་།",
