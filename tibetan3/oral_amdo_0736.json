    "བདབྱངས་དང་འདོགས་ཀྱི་བྱེ་བྲག་རྣམས་ལུས་ཀྱི་མཛེས་རྒྱན་བཞིན་སྟེང་འོག་གང་འོས་སུ་སྦྱར་འདས་ཏིསྟག་གཟིག་གི་སྤུངས་ཡིག་དེ་གཡས་ངོས་ནས་གཡོན་ངོས་སུ་འབྲི་དགོས་པ་དགོས་པ་དང་།",
    "དང་ཞང་ཞུང་གི་ཡིག་རྒན་ནི་ཡིག་རིགས་གཞན་དག་ལྟར་གཡོན་ནས་གཡས་ངོས་སུ་འབྲི་སྲོལ་༢ ཝནྣཱཎཏ་༡༤ ག་༤༣ ས་སྟག་གཟིག་གི་སྤུངས་ཡིག་ལ་དམིགས་བསལ་གྱི་ཡིག་མགོ་འབྲི་བའི་སྲོལ་མེད་ལཡོད་པ་དང་།",
    "སྟག་གཟིག་གི་ཞང་ཞུང་གི་ཡིག་རྒན་དུ་ཤོག་ལྡེབ་རེ་བཞིན་ཡིག་མགོ་འབྲི་དགོས་པ་དང་ངནང་།",
    "༧༣ ཟའ་ཉི་༢སྤུངས་ཡིག་ལ་ཚིག་ཕན་ཚུན་མཚམས་གཅོད་པ་ཙམ་ལས་དམིགས་བསལ་གྱི་ཚེག་འབྲི་སྲོལ་མེད་གབ་ནནསསའ་སསལསད་ཞང་ཞུང་གི་ཡིག་རྒན་དུ་ཚིག་ཕན་ཚུན་མཚམས་གཅོད་པའི་ཆེད་ཚེག་ཡོད་པ་སོགས་ཕྱོགས་པ་སོགས་རུས་ལ།",
    "སྒྲ་ཚིགས་ཀྱི་ཡི་གེསྐད་ཕྱི་མ་རྣམས་ནི་སྐབས་འདི་དང་འབྲེལ་མི་ཆེ་བས་རེ་གད་ངས་ཀྱི་ཡི་གེ་བཅས་ལྔ་རུ་ཕྱེས་པ་ལས།",
    "བྲིས་གཟུགས་བརྡ་རྟགས་སམ་བྲིས་རིས་དག་གིས་བརྗོད་དོན་ཆ་ཚང་ཞིག་ཧྲིལ་གྱིས་སྟོན་ཡང་།",
    "མིང་དོན་རང་རྐྱ་འཕེར་བ་རེ་སྟོན་པའི་བྲིས་རིས་བརྡ་རྟགས་རི་མོའི་བརྡ་རྟགས་ཀྱང་འདུ་ཤིག་ལ་ཟེར་ཞེས་བསྟན་པའི་ཕྱིར་ན།",
    "སྐབས་དོན་སྟོན་པར་བྱེད་པའི་ཡི་གེ་དག་གི་བྱེད་པ་དང་མི་འདྲ་ཕྱིར།",
    "དེའི་སྔ་མ་ལ་རི་མོའི་ཡི་གེ་དང་གནའ་བོའི་གོམས་པ་རྒྱུན་ཀ་འབྱམས་ཀྱི་བརྡ་རྟགས་ཀྱང་འདུ་བར་བསྟན་པ།",
    "རང་རེའི་སྲིད་པའི་ཕྱག་རྒྱུ་དང་།",
    "གཞན་ཡང་བསྲུང་བའི་བྱང་བུ་མང་པོ་ཞིག་གི་སྟེང་ན་ཐོ་བརྩེགས་སུ་ཡོད་པའི་གཟུགས་བྲིས་སྣ་ཚོགས་ཤིག་ཡོད་པ་འདི་དག་ཀྱང་གནའ་དུས་ཀྱི་ཡི་གེའམ།",
    "གོང་གི་བོན་ལ་བརྡ་སྤྲོད་ཡི་གེ་མེད་བདེན་ཡང་།",
    "དེ་ལྟར་ཞང་ཞུང་གི་ཡི་གེ་ནི་ཚིག་སྦྱོར་གྱི་ཡི་གེ་ཞིག་ཡིན་པ་རིགས་པས་གྲུབ་ན་གནའ་དུས་སུ་ཡི་གེ་བརྗོད་བྱ་རགས་ཙམ་བྲི་བ་ལས།",
    "འཇང་གི་ཡི་གེའི་ཐོག་མའི་འབྱུང་ཁུངས་འཆད་པའི་སྐབས།",
    "ཞང་ཞུང་ཡིག་རྒན་དང་འཇང་གི་ཡི་གེ་གཉིས་ཀ་སྟོན་པ་གཤེན་རབ་མཆོག་གིས་བོན་བསྟན་སྤེལ་པའི་དགོས་མཁོ་རུ་གསར་དུ་མཛད་པ་ཡིན་ཚེ།",
    "འཇང་གི་འདྲ་གཟུགས་ཡི་གེ་ནི་རི་མོས་དོན་མཚོན་པའི་འཕེལ་རིམ་དུ་གནས་པའི་རི་མོའི་ཡི་གེ་ཞིག་མ་ཡིན་ལ།",
    "ཞང་ཞུང་གི་ཡིག་རྒན་ནི་སྟག་གཟིག་གི་སྤུངས་ཡིག་ཀ་སོགས་རིམ་གྱིས་འཕེལ་ཏེ་བྱུང་བ་མ་ཡིན་ལ།",
    "ལྷག་མ་དབྱངས་སམ་ཤེས་རབ་མོ་ཡིག་བརྒྱུད།",
    "འཇང་གི་ཡི་གེ་དང་ཆ་མཚུངས་པའི་རི་མོའི་ཡི་གེའི་རྨང་གཞིའི་སྟེང་བྱུང་བའི་ཚིག་སྦྱོར་གྱི་ཡི་གེ་ཞིག་རེད་སྙམ་མོ།་།",
    "བཔ་དཔེ་དེབ་འདི་ནི་སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་ལོའི་ཟླ་པར་དུ་བསྐྲུན་ཏོ།་",
    "ཟླ་བ་དུང་དཀར་ཚིག་མཛོད་ཆེན་མོགསང་བ་ཆ་ནའ་༥༥ཀྲུང་གོའི་བོད་རིག་པ་དཔེ་སྐྲུན་ཁང་པ།",
    "རྗེས་འཇུག་བཅུ་ལས་ག་ད་བ་ས་བཞི་མོ།",
    "རྗེས་འཇུག་གི་གོ་རིམ་གོང་དང་འདྲ་ལ་ཁམས་ནི།",
    "ཞང་ཞུང་འཕྲུལ་ཡིག་གི་གོ་རིམ་ནི།",
    "སྔགས་ཀྱི་བཀླག་ཐབས་དེར་བསྟན་པའི་སྔགས་ཡིག་གི་འབྱུང་ཁམས་བསྡུ་ལུགས་དང་མཐུན་པར་མ་ཟད།",
    "བརྡ་སྤྲོད་ཉི་ཤུ་བདུན་པ་ཞེས་པ་རུ་བསྟན་པའི་ས་ཆུ་མེ་ནམ་མཁའི་དབྱེ་བསྡུའང་རྟགས་འཇུག་ཏུ་བསྟན་པའི་ཕོ་མོ་མ་ནིང་ཤིན་ཏུ་མོའི་རྟགས་ཀྱི་དབྱེ་ལུགས་དང་ཕལ་ཆེར་མཐུན་པོ་ཡོད་པ་དང་།",
    "རྗེས་འཇུག་གི་ས་མེ་ཆུའི་དབྱེ་བ་ནི།",
    "པཎ་ཆེན་སི་ཏུའི་ལུགས་ཀྱི་རྗེས་འཇུག་ལ་ཕོ་མོ་མ་ནིང་གསུམ་དུ་དབྱེ་ཚུལ་དང་ཇི་བཞིན་མཐུན་པ་བཅས་སྒྲུབ་བྱེད་དུ་བཀོད་དེ།",
    "ཨ་ཁ་ཁམས་ཡིག་གི་བྱུང་ཚུལ་ལ་སྟོན་པ་གཤེན་རབ་མི་བོས་མཛད་པར་བཞེད་པའང་ཡོད་པ་བཅས་ལ་བརྟེན་ནས།",
    "དེ་ནི་དེང་གི་འཇང་ཡིག་དང་མཚུངས་པའི་འདྲ་གཟུགས་ཡི་གེ་ཞིག་ཡིན་པར་བསྟན་པ་ཡིས།",
    "ཞང་ཞུང་ཡི་གེ་དང་སྲུང་འཁོར་དང་ཕྱག་རྒྱའི་རི་མོ་སྣ་ཚོགས་ཀྱི་བར་ན་འབྲེལ་བ་དམ་པོ་ཡོད་ལ།",
    "ར་སབ་༧གནམ་སྐྱོང་རྒྱལ་པོའི་བང་སོའི་རྩིག་ངོས་ཀྱི་ཡི་གེ་དང་རི་མོ་ལས་འཕྲོས་པའི་གཏམ་ཆབ་འགག་རྟ་མགྲིནན་མས་ལནགཅིག་གླེང་གཞི།",
    "གནམ་སྐྱོང་རྒྱལ་པོ་རང་གིས་ཀྱང་ཞྭ་སེར་བསྟན་པ་མཆོག་ཏུ་བཟུང་བ་ནི།",
    "མགྱོགས་པོར་སློབ་གླིང་ལ་སྙན་སེང་ཞུས་ཤིང་ཁོང་ཚོས་གྲོན་དངུལ་གྱི་མཐུན་རྐྱེན་སྦྱར་བ་ལ་བརྟེན་ནས་བང་སོ་དེར་མཇལ་བའི་སྐལ་བ་སྨིན་བྱུང་།",
    "ཆིང་རྒྱལ་རབས་ཀྱི་ཤར་ངོས་བང་སོ་དེར་ཆིང་གི་གོང་མ་དང་པོ་ཧྲིན་ཀྲི་དང་།",
    "བཙུན་མོ་ཞའོ་ཀྲོང་དང་ཞའོ་ཧོས།",
    "གླང་མོ་ཆེ།",
    "རྔ་མོང་།",
    "འདད་གཏོང་སྒོ་མོ་ཆེ།",
    "བསྡོམས་པས་སྒོ་ཆེན་བཞི་ལ་སྒོའི་རྡོ་ལེབ་བརྒྱད་ཡོད་པའི་སྟེང་དུ་རྗེ་བཙུན་འཇམ་པའི་དབྱངས་དང་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཁང་རིམ་གཉིས་པའི་གཡས་གཡོན་གྱི་རྩིག་ངོས་སུ་གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་སྟེ་འདོད་ཡོན་ལྔའི་རི་མོ་དང་།",
    "ཁང་རིམ་གསུམ་པའི་རྩིག་ངོས་སུ་བཀྲ་ཤིས་རྟགས་བརྒྱད་ཀྱི་རི་མོ་དང་གདུགས་དཀར་མཆོག་གྲུབ་མའི་གཟུངས་སྔགས་རིང་མོ།",
    "ཁང་རིམ་བཞི་པ་སྟེ་ཆེས་ཕུགས་ཀྱི་ཁང་པའི་དབུས་སུ་གནམ་སྐྱོང་རྒྱལ་པོའི་གདུང་སྒམ་ཡོད་ཅིང་གཡས་གཡོན་དུ་བཙུན་མོ་ཆེན་ཆུང་ལྔའི་གདུང་སྒམ་བཞག་ཤུལ་ཡོད།",
    "བཀྲ་ཤིས་རྟགས་བརྒྱད་ཀྱི་རི་མོ།",
    "འདོད་ཡོན་ལྔའི་རི་མོ་བཅས་བརྐོ་བཞེངས་བྱས་ཤིང་།",
    "བོད་ཡིག་གི་བྲིས་པའི་གཟུངས་སྔགས་ཡིག་འབྲུ་དང་།",
    "མདུན་དུ་མུ་ཏིག་གིས་སྦྲེལ་བའི་མཆོད་ཀོང་ཆ་གཉིས་དང་ཟངས་ཀྱི་མཆོད་ཀོང་ཆ་གཉིས་བསྙེན་བཀུར་ཞུས་ཡོད།",
    "མཆོད་སྟེགས་ཤིག་གི་སྟེང་དུ་བ་སོའི་སྐུ་བརྙན་དགུ་དང་གསེར་གྱི་རྒྱལ་སྲས་སྣ་བདུན།",
    "བར་བཀུར་ཞུས་ཡོད་པ་རེད།",
    "དེ་གང་གིས་ཤེས་ཟེར་ན།",
    "༡ སྐུ་བརྙན་དང་གཟུངས་སྔགས་དེ་དག་གི་ཕན་ཡོན་ལས་ཤེས།",
    "གོང་གི་མགུལ་དུ་འདི་བཏགས་པ།",
    "གང་གི་མགུལ་དུ་འདི་བཏགས་པ།",
    "བཞེངས་པའི་བང་སོའང་གནམ་སྐྱོང་རྒྱལ་པོ་རང་གི་ཐུགས་བཀོད་དང་ཐུགས་མོས་ལྟར་བཞེངས་དེས་ན་གནམ་སྐྱོང་རྒྱལ་པོའི་བང་སོའི་རྩིག་ངོས་སུ་སྐུ་བརྙན་དང་གཟུངས་པ་སྨྲས་མ་འཚལ།",
    "གནམ་སྐྱོང་རྒྱལ་པོ་ནི་མན་ཇུ་རྣམ་མཚོན་པའི་ལྡེབས་རིས་གཅིག་ཀྱང་བཞེངས་མེདསྙརིགས་ཡིན་ཞིང་སྐབས་དེར་གཞུང་ཕྱོགས་སུ་སྤྱོད་པའི་སྐད་དང་ཡི་གེ་ནི་རྒྱ་སྐད་དང་རྒྱ་ཡིག་ཁོང་གིས་བང་སོའི་རྩིག་ངོས་སུ་མན་ཡིག་དང་རྒྱ་ཡིག་གཅིག་ཀྱང་མ་བཀོད་པར་ཡིན་རུང་།",
    "ཐ་ན་ལྷ་སྐུ་རྣམས་ཀྱི་མཚན་བོད་ཡིག་གི་གཟུངས་སྔགས་དང་ལཉྫ་རྐྱང་རྐྱང་འཁོད་པ་དང་།",
    "དེས་ན་བྱུང་ཡང་མན་ཡིག་དང་རྒྱ་ཡིག་གིས་མ་བྲིས་པར་བོད་ཡིག་ཁོ་ནས་བྲིས་ཡོད་པ་རེདནང་བསྟན་གྱི་སྐུ་བརྙན་དང་གཟུངས་སྔགས་རྣམས་ཀུན་ལས་གཙིགས་ཆེན་དུ་བཟུང་བ་འདི་ལས་ཀྱང་གནམ་སྐྱོང་རྒྱལ་པོ་དེ་བོད་བརྒྱུད་ནང་བསྟན་ལ་དད་པ་བརྟན་པོ་དང་དགའ་ཞེན་ཆེན་པོ་ཡོད་པ་ཤེས་ཐུབ།་།",
    "རྒྱ་ཁྱོན་དང་ཚད་གཞི་གང་གི་ཆ་སམ་པད་པ་ཆ་ནས་ཀྱང་རྒྱལ་པོ་སྔོན་མའི་བང་སོ་ལས་ཇེ་ཆུང་དང་ཇེ་ཉུང་དུ་བཏང་ནས།",
    "དུ་སྒྲ་སྒྱུར་ཁང་བཙུགས་ནས་ལོ་བཅོ་བརྒྱད་ཀྱི་རིང་ལ་རྒྱལ་བའི་བཀའ་བསྟན་པོ་ཏི་མན་ཡིག་ཏུ་བསྒྱུར་བ་རེད།",
    "གོང་མ་ཚང་གི་དད་མོས་ཀྱི་དགོས་པ་སྐོང་བའི་ཆེད་དུ་ཡིན་ལ།",
    "གནམ་སྐྱོང་རྒྱལ་པོས་མཛད་པའི་ཁྲིན་ཏེའི་བཀྲ་ཤིས་ལྷུན་པོའི་ལྷ་ཁང་གི་རྡོ་རིང་ཡི་གེ་ལས།",
    "ནང་པའི་བསྟན་པར་དད་མཁན་ཞིག་ཡིན་པའི་ཆ་ནས་རང་གི་ཆབ་སྲིད་བརྟན་ཞིང་རྒྱལ་རྒྱུད་རྣམས་ཀྱི་སྐུ་ཚེ་རིང་པ་དང་།",
    "ཁོང་གི་སྐུ་རིང་ལ་རྒྱལ་སྲིད་བརྟན་ཅིང་རྒྱལ་ཁམས་དར་ཞིང་རྒྱས་པའི་རྒྱུ་རྐྱེན་གཙོ་བོའང་ཡིན་པར་འདོད་དོ།",
    "པདྨ་གནམ་རིམ་པ་བཅུ་གསུམ་གྱི་སྟེང་ནས་ཡབ་བླ་བདལ་དྲུག་གི་སྲས་རྒྱུད་ཁྲི་བར་བདུན་ཚིགས་ཀྱི་སྲས་གཉའ་ཁྲིད་བཙན་པོ་མི་ཡུལ་དུ་སྤྱན་དྲངས་ཏེ།",
    "ཨཱ་བོད་ཀྱི་གནའ་ཤུལ་རྡོ་རིང་གི་ཡི་གེ་ལ་བལྟས་པ་ཙམ་གྱིས་ཤེས་ནུས་པ་མ་ཟད།",
    "དེར་རྒྱལ་བུ་ན་རེ།",
    "ལྷ་རི་རོལ་མོའི་རྩེར་བྱོན།",
    "རྒྱལ་པོ་སྐྱབས་སེང་ཞེས་བྱ་བའི་བུ་ཆུང་བ་ཅིག་དཔུང་གི་ཚོགས་དང་བཅས་གངས་ཅན་གྱི་ཕྱོགས་སུ་བྲོས་པ་ལས།",
    "ཡིག་ཚང་ཕལ་མོ་ཆེའི་ནང་དུ་གཉའ་ཁྲིའི་འབྱུང་ཁུངས་གླེང་སྐབས།",
    "འོན་ཀྱང་དེ་དག་གི་ཁྲོད་དུའང་ཚང་མ་གཅིག་ལྟར་མ་ཡིན་པ་ཕན་ཚུན་ནང་འགལ་ཆེ་ཞིང་།",
    "བཀའ་ཚིགས་ཆེན་མོ་ལས་བྱུང་བའི་ལོ་དུས་བགྲངས་ནས།",
    "གཉའ་ཁྲི་ནི་སྟོན་པ་འདས་ནས་ལོ་མང་སོང་བའི་རྗེས་སུ་བྱུང་བ་དང་།",
    "ཁ་ཅིག་དཔུང་གི་ཚོགས་དང་བཅས་ཏེ་ཡིན་ཟེར་ན།",
    "བཞི་ན་བོད་མི་རྣམས་ཀྱི་དད་མོས་བྱེད་ལུགས་དང་བསམ་པའི་ཀུན་སློང་གི་འཁྱེར་སོ་ལ་ཆ་རྒྱུས་མེད།",
    "བཞི་ན་བོད་མི་རྣམས་ཀྱི་དད་མོས་བྱེད་ལུགས་དང་བསམ་པའི་ཀུན་སློང་གི་འཁྱེར་སོ་ལ་ཆ་རྒྱུས་མེད།",
    "འབྲི་གུང་སོགས་ས་གནས་དུ་མར་གནའ་དུས་བཙན་པོའི་སྐབས་བསྐྲུན་པའི་རྡོ་རིང་གི་ཡི་གེ་བཟོ་བཅོས་ཀྱི་དྲི་མས་མ་གོས་པ་ཁག་ཅིག་ད་ལྟའང་དངོས་སུ་གནས་ཡོད་པ་དེ་དག་གི་ཐོག་ཆབ་སྲིད་དང་།",
    "ཉ་ཁྲི་བཙན་པོ་སྤྱི་ཡུལ་གྱི་རྗེར་ལྷ་རི་གྱང་ཐོར་གཤེགས་པ་ཚུན་ཆདས་བཅ་བང་ཅེས་དང་དབུ་སྟོད་ཞྭ་ལྷ་ཁང་གི་རྡོ་རིང་སྔ་མའི་ཡིག་ཕྲེང་དང་པོ་དང་གཉིས་པར་གནམ་ལྷབ་ཀྱི་རྒྱལ་པོ།",
    "ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་བང་སོའི་མདུན་དུ་བཙུགས་པའི་རྡོ་རིང་གི་ཡི་གེ་ཕྲེང་དང་པོ་དང་གཉིས་པར།",
    "མིན་ཏེ་གོང་དུ་དྲངས་པའི་རྡོ་རིང་གི་ཡི་གེ་དེ་དག་ཇུས་འགོད་གནང་མཁན་ས་ནི།",
    "རིམ་གྱིས་ཡུལ་མང་པོ་བཟུང་སྟེ་རང་གི་རྒྱལ་ཁམས་རྒྱ་༤བསྐྱེད་ཅེས་གསལ་བ་དང་།",
    "རང་རྒྱལ་གྱི་ཐང་དེབ་རྙིང་མ་ནང་ཐུ་བྷོད་ཅེས་བར་བྱདབྱ་བ་ནི་ཁྲང་ཨན་ནུབ་ཕྱོགས་ཀྱི་ལེ་དབར་བརྒྱད་སྟོང་གི་སར་མཆིས་ཤིང་།",
    "དེའི་རིགས་རྒྱུད་དང་ཚོ་པ་རྣམས་ཀྱི་འབྱུང་ཁུངས་མི་ངེས་ཀྱང་།",
    "ཁ་ཅིག་གིས་ནན་ལེང་གི་ཐུའུ་པཱལི་ལོའི་ཀུའི་ཞེས་བྱ་བའི་རྒྱུད་པ་རྒྱུཡིན་ཟེར།",
    "འཕན་མྱི་ནི་ཨན་ཞི་དམག་དཔུང་གི་དཔོན་པོར་བསྐོས་ཧིག་ཝེ་རྒྱལ་རབས་ཀྱི་ཧྲིན་རོས་ཁྲི་ལོ་༥ ན་མི་ནས་༤ནུ་མན་བྱ་བས་རྣམས་བསྡུས་ཏེ་ཆེ་ཆི་མང་སུང་བྱ་བར་གཏད།",
    "མང་སྲུང་གིས་ཁོ་ལ་ལིན་སྲུང་གི་ཐེ་ཧྲིག་བྱ་བའི་ཆོ་ལོ་སྦྱར།",
    "འཕན་མྱིས་རང་གི་འཁོར་རྣམས་ཁྲིད་དེ་ནུབ་ཕྱོགས་སུ་བྲོས།",
    "རི་བོ་ཅི་ཧྲེའུ་ཧྲི་བརྒྱུད་དེ་འཇང་གི་ས་ཆར་རྒྱལ་ཁབ་ཅིག་བཙུགས་ཤིང་།",
    "དེ་ནས་འཕན་མྱིས་རང་གི་རུས་སྤུར་རྒྱལ་དུ་བྱས་ཤིང་།",
    "ཕྱིས་སུ་ཐུ་བྷཞེས་པའི་སྒྲ་འགྱུར་ཏེ་ཐུ་བྷོད་དུ་ཆགས་ཟུརལ་ཞེས་འཁོད་འདུག་དེ་དེ་ལ་བོད་རིགས་འཇང་གི་ཁོངས་སུ་གཏོགས་ཟེར་བའི་ཐད་ལ་བློ་མཐུན་འུད་ཀང་སོགས་ས་རྒྱུན་སཀྱིས་མཐའ་དཔྱོད་རྒྱས་པར་གནང་འདུག་ཅིང་།",
    "བོད་ཀྱི་ཡར་ཆབ་གཙང་པོའི་ལྷོ་ངོས་ཡར་ལུང་གི་ལྟེ་བར་ཡིན་པ་ཀུན་ཤེས་ཡོངས་གྲགས་དང་གཅིག་གཉའ་ཁྲི་ནི་གཅིག་པུར་ཡར་ལུང་དུ་བྱོན་ཞིང་།",
    "གཉའ་ཁྲི་བཙན་པོ་ཡར་ལུང་དུ་བྱོན་པའི་ལོ་ཚད་ནི་བརྩི་ཚུལ་ཉུང་ཤོས་ལའང་སྤྱི་ལོ་འགོ་མ་ཚུགས་གོང་གི་ལོ་གྲངས་བརྒྱ་དང་ཉི་ཤུ་རྩ་དྲུག་པ་སྟེ་བོད་ཤིང་སྟག་ལོར་བརྩི་བ་ཡིན།",
    "ན་མོ་༤ གཉའ་ཁྲི་བཙན་པོ་ནི་བོད་རང་གི་མི་ཞིག་ཡིན་ཞེས་པ།་",
    "རྒྱལ་ཕྲན་བཅུ་གཉིས་ཀྱི་ཁོངས་སུ་གཏོགས་ཟེར་བ་ནི་དོན་དུ་བོད་རང་གི་མི་ཞིག་ཡིན་པར་སྨྲ་བ་ཧ་ཅང་གསལ་ལ།",
    "བོད་རང་གི་མི་ཞིག་ཡིན་པར་ཀླན་ཀ་ཅི་ཡང་མེད་དོ།",
    "ཡུལ་སྤུ་བོའི་ཡུལ་ནས་སྤུའི་མི་མོ་མོ་བཙུན་བྱ་བའི་རུམ་ནས་ཐེ་བྲང་སྤུན་དགུ་སྐྱེས་པའི་ཆུང་དག་ཐེ་རང་མ་སྙ་ཨུ་བེ་ར་བྱ་བ།",
    "ལྕེས་གདོང་གི་དཀྱིལ་འཁོར་ཁེབས་པ།",
    "སྤུ་བོའི་ཡུལ་གྱི་བན་བོན་ནུས་མཐུ་ཅན་རྣམས་ཀྱིས་ཐེ་བྲང་སྐྱས་འདེབས་བྱས་ནས་བོད་དུ་སྤྲུགས་པ་ལ་དེར་བོད་ཀྱི་མི་རྗེ་འཚོལ་བ་དང་ཕྲད་ནས་ཁྱོད་ཅི་འདྲ་ཞིག་ཡིན་བྱས་པས།",
    "ཁོ་ན་རེ་ནུས་མཐུ་དང་རྫུ་འཕྲུལ་ཆེ་གྲགས་པས་བཤུགས་པ་ཡིན་ཟེར།",
    "དེ་ནི་རྗེའི་སྔོན་ནམ་འཚང་ལགས་སོ་ཞེས་འཁོད་འདུགདེ་བཞིན་ལྕང་གླིང་པ་རོལ་པའི་རྡོ་རྗེས་བརྩམས་པའི་ཡུམ་བུ་བླ་སྒང་གི་དཀར་ཆག་འབྲིང་པོ་ཞེས་པའི་ནང་དུའང་།",
    "བོད་རྣམས་རྗེ་བོ་འཚོལ་བ་དང་བྱང་ལམ་གཡའ་ལེ་གོང་དུ་ཕྲད་ནས་ཁྱོད་སུ་ཡིན།",
    "དེ་ན་རེ་ང་ནུས་མཐུ་ཆེ་བས་ཡུལ་མི་ཀུན་གྱིས་སྤྱུགས་པ་ཡིན་ཟེར།",
    "འོ་ན་ཁྱོད་ཀྱིས་བོད་ཀྱི་རྗེ་ཨེ་ནུས་བྱས་པས།",
    "ཁྱོད་རང་རྣམས་ཀྱིས་གཉའ་བར་ཁྲི་ལ་བཏེག་ཅིག་དང་།",
    "འང་ཚོས་བལྟས་ན།",
    "ཁོང་ལ་བུ་ཕྲུག་དགུ་སྐྱེས་པའི་ནང་གི་ཐ་ཆུང་དེ་ཡིན་པ།",
    "ཕ་ཡུལ་དང་ཁ་བྲལ་ནས་བོད་ཀྱི་དབུས་ཕྱོགས་སུ་འབྱོན་པའི་རྒྱུ་རྐྱེན་ཡང་ཁོང་ཐུགས་གྱོང་ཞིང་རྩལ་ཆེ་བས་ཡུལ་དེའི་འགོ་གཙོའི་བརྙས་དམོད་དང་།",
    "འདིར་སྤུ་བོའི་ཡུལ་ལ་དུས་ཕྱིས་སྤོ་ཡུལ་ཞེས་པ་རབས་ན་འབོད་པ་ནི་སྐད་བརྡ་གསར་རྙིང་གི་རིམ་འགྱུར་ཞིག་ཡིན་ཏེར།",
    "ཕྱོགས་གཞན་ཞིག་ནས་གནའི་གཏམ་རིམ་བརྒྱུད་ཀྱི་རིགས་ལ་ལྷ་སྒྲུང་གི་ཤན་ཞུགས་པའི་ཚིག་རྒྱན་ཐོ་རེ་བ་ཞིག་མ་འདྲེས་མི་སྲིད་པ་འདིའང་བོད་ཀྱི་གོམས།",
    "གལ་ཏེ་ལོ་ངོ་སྟོང་ལྷག་གོང་གི་ལྟེབ་མ་དགུ་བརྩེགས་ཅན་ལས་དྲངས་པ་མ་ཡིན་ན།",
    "སིལ་མ་བཞི་བཅུ་སོགས་ཀྱིས་སོ་སོར་གནས་ཡུལ་བཅད་བཟུང་དང་ཕན་ཚུན་འཕྲོག་རེས་བྱེད་པའི་དུས་ཡིན་པ་ནི་ཏུན་ཧོང་གི་ཡིག་རྙིང་ནང་དུས་དེའི་རྒྱལ་ཕྲན་བཅུ་ལྷག་གི་མིང་དྲངས་པའི་མཇུག་ཏུ།",
    "མི་མང་གི་རྗེ།",
    "འབངས་སུ་བཀུག་ན་མཐའི་མ་འོ་ལྡེ་སྤུ་རྒྱལ་གྱི་དབུ་རྨོག་མ་ཐོག་པ་ཅེས་གསལ་བ་ལྟར་རྒྱལ་ཕྲན་ནམ་ཚོ་པ་དེ་དག་ཕན་ཚུན་སྟོབས་ཆེ་བས་ཆུང་བ་ཟོ་རེས་བྱེད་པའི་དམག་འཁྲུག་དང་།",
    "གཉན་པར་བྱེད་པ་སོ་དང་སྤོ་སྟེ་རུས་ཚོ་དྲུག་འདུས་པའི་ཚོ་ཁག་གཅིག་གནས་པ་དེ་ལ་དཔའ་ཞིང་བརྟུལ་ཕོད་པའི་འགོ་འཛིན་ཞིག་མེད་པར་རྒྱལ་ཕྲན་གཞན་དག་གིས་བརྙས་འཕྲོག་ཡ་ང་བ་མྱོང་དགོས་བྱུང་སྟབས་ཁོང་ཚོས་རང་གི་ཚོ་པ་དེ་ལ།",
    "ཁོང་གི་འབྱུང་རྩ་ནི་སྤུ་བོའི་ཡུལ་ནས་ཕྱིར་འབུད་བྱས་པའི་མི་ཞིག་ཡིན་ཞེས་བརྗོད་ན་མི་འཚམས་ལབརྗོད་ཀྱང་མི་ཕོད་པར་རིམ་བཞིན་གྱུར་པ་ལས་དེ་ལ་ཡང་གསང་ཞེས་འབོད་པ་རྟོགས་སླ་ཞིང་།",
    "ཡང་གསང་ཞེས་པའི་ཐ་སྙད་དེ་དག་གི་གོ་དོན་ལའང་ཞིབ་མོར་དཔྱོད་པའི་དགོས་པ་ཞིག་མཐོང་སྟེ།",
    "༧ ཏི་༧ མེད་ཟ་༥ཨིཅེས་མ་དག་པའི་སྣང་ངོར་མི་མིན་ཐེ་རང་དུ་མཐོང་བའི་ལུགས་ལའང་འགལ་བ་མེད་ཨན་ཅེས་ཐབས་མཁས་སམ་ཤུགས་མ་ཐུབ་ཀྱི་ཁས་ཞེས་པའི་རྣམ་འགྱུར་བསྟན་པ་འདི་དག་གི་ཐོག་ཨ་༧ ཙ་ཤུལ་ར་ནས་ཀྱང་།",
    "ནར་ནར་མ་པས་ཀབཅདམའན་ས་ཚང་དཔ་ཐད་ཀར་རམ་བརྒྱུད་པའི་སྒོ་ནས་འཇོག་གནང་མཛད་པའི་ཕྱག་རྗེས་ལ་ང་ཚོས་རྗེས་སུ་ཡི་རངས་ཟས་ལངསཞུ་འོས་པ་ཡིན་ནོ།",
    "རི་གཟིགས་ཀྱི་ནང་ནས།",
    "ཐང་གཟིགས་ཀྱི་ནང་ནས།",
    "ཀོང་ཤུལ་སེ་མོ་གྲུ་བཞི་ལས་རྒྱ་ཆེ་ཞིང་བཤམས་ལེགས་པ་མ་གཟིགས་ཞེས་༧རསས་རབནགསལ་བ་དེ་དག་ལས་གཉའ་ཁྲི་བཙན་པོ་སྤུ་བོའི་ཡུལ་ནས་ནུབ་ཕྱོགས་ཀྱི་རི་བོ་བརྒལ་ཏེ་ཀོང་པོ་ཅི་པ་ལས་བབས་པཉིང་ཁྲིའི་ཤར་རི་ལས་བབས་པ་དེ་མཚོན་པ་ཡིན།",
    "དེ་ནས་ཤིང་མུ་ལེ་གྲུང་ཤིང་གི་རྩར་གཤེགསགཤེགས།",
    "དེ་ནས་ཁྲག་གི་བྲག་དམར་པོར་གཤེགས།",
    "དེ་ནས་དོག་མོ་དག་ཉེན་དུ་གཤེགས།",
    "དེ་ནས་ཉག་གི་རྒྱབ་དམར་དུ་གཤེགསལཚོ།",
    "དེ་ནས་ཀླུ་མོ་སྦྱང་པར་གཤེགས།",
    "དེ་ནས་འཕར་པོ་ཟོ་བྲང་དུ་གཤེགས་སོ་ཞེས་བྱུང་བའི་ས་མིང་རྣམས་ས་གནས་ས་ཐོག་ཏུ་རེ་རེ་བཞིན་ཞིབ་བརྩད་བྱ་རྒྱུར་ལུས་རུང་།",
    "ལམ་བརྒྱུད་ཀྱི་ས་མིང་ཁྲོད་ན་ཉག་ཉི་ཞེས་པ་ནི་དྭགས་ཀོང་གི་ཕྱོགས་སུ་ཡོད་པ་ཏུན་ཧོང་གི་ཡིག་རྙིང་དུའང་གསལ་ཏེ་བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་རིང་ལ།",
    "གོང་དུ་ཡུམ་བུ་བླ་སྒང་གི་དཀར་ཆག་ནང་བྱང་ལམ་གཡའ་ལེ་གོང་བྱ་བའང་དོན་གཅིག་ཏུ་སྣང་བས།",
    "ཡུལ་དང་རིགས་སོགས་གཞན་ལས་ཆད་པའང་མ་ཡིན་པར་གངས་ལྗོངས་སྤུ་བོའི་ཡུལ་ནས་བྱུང་བའི་བོད་རང་གི་མི་ཞིག་ཡིན་བྱ་བ་དེ་ལགས་སོ།",
    "ཁག་གཅིག་གིས་གནམ་གྱི་ལྷ་ལས་མི་ཡུལ་གྱི་རྗེ་བོར་བྱོན་པར་བཞེད་པ་དང་།",
    "ཁག་གཅིག་གིས་རྒྱ་གར་གྱི་ཤཱཀྱའི་རྒྱལ་རྒྱུད་ལས་ཆད་པར་བསྒྲགས་པ།",
    "ཁག་གཅིག་གིས་ཤར་རྒྱ་ནག་གི་ཡུལ་ནས་ཡོང་བར་སྨྲ་བ་དང་།",
    "ཡང་ཁག་གཅིག་གིས་བོད་རང་ཁོངས་སྤོ་བོའི་ཡུལ་ནས་ཡིན་པར་འདོད་པ་སོགས་སྣ་ཚོགས་སུ་སྣང་ལ།",
    "ཡང་གསང་གི་ཁྱད་པར་ཡོད་ཚུལ་སོགས་ཡིག་ལམ་ལ་དངོས་སུ་བཀོད་ཡོད་པ་རེད།་",
    "ཡང་ན་རེ་འགས་འབྲི་ཚུལ་རིགས་དེ་གཉིས་རེས་མོས་ཀྱིས་བཀོལ་སྤྱོད་བྱེད་པ་ཙམ་ལས།",
    "གང་ལྟར་རྒྱུ་དང་དགུ་བྱ་བ་ལ་ཡི་གེ་དང་ཐ་སྙད་གྲུབ་ཚུལ་གང་གི་ཆ་ནས་གཞིགས་ཀྱང་།",
    "དུས་ཕྱིས་ཀྱི་ཚེ་འཕུལ་ཡིག་གིས་འཐུས་པར་བྱས་པ་ནི་བོད་ཀྱི་ཡི་གེའི་སྒྲིག་སྦྱོར་ལ་འཕེལ་འགྱུར་བྱུང་བའམ།",
    "བྱས་པ་གཞི་ཡང་ན་དེའི་འཕུལ་དུ་ད་ཡིག་བྱས་པ་གཉིས་ཀྱི་ཀློག་སྟངས་ལ་ཁྱད་པར་ཧ་ཅང་ཆེ་བར་ཡོད་པ་རྒྱུཏུ་དོན་ལ་ངེས་མོད།",
    "ལྷག་པར་རྡོ་རིང་ཡི་གེ་ལས་བཀའ་བྱ་བ་ལ་བ་སྟེ་སྔ་མའི་སྔོན་འཇུག་གི་ཡི་གེ་དེ་དེང་སང་གི་མགོ་ཅན་ཡི་གེ་འབྲི་ཚུལ་ཇི་བཞིན་བ་ཡིག་སྟེང་དུ་བྲིས་པ་སོགས་ལ་བསམས་ན།",
    "ཡང་ན་ཡི་གེ་འོག་མ་དེ་རང་གི་སྟེང་མའི་ཡི་གེ་དེ་ཉིད་ཀྱི་ཟུར་དུ་བྲིས་པ་སྟེ།",
    "ལེགས་སྦྱར་ཡི་གེའི་ཁྲོད་ཀྱི་འ་ཡིག་གིས་རང་གི་སྟེང་མའི་ཡི་གེ་ལ་རིང་ཆ་བྲིས་པ་བཞིན་གྱིས།",
    "འདོགས་ཀྱི་ཡི་གེ་རྣམས་སྟེང་གི་ཡི་གེ་དེའི་ཕྱི་རྐྱང་སྣེ་ནས་ཅུང་གསེག་ཅིང་བྲིས་པ་ཧ་ཅང་རྒྱུགས་ཆེ་བ་ལ་བསམས་ན།",
    "འདིའི་མིང་གི་འདོགས་ཚུལ་དང་།",
    "ཞྭ་ལྷ་ཁང་གི་རྡོ་རིང་དུ།",
    "དང་ལོ་དྲ་སོགས་རྗེས་འཇུག་གི་ཡི་གེ་རྣམས་འདོགས་ཀྱི་ཡི་གེ་ཇི་བཞིན་རང་འཇུག་ཡུལ་གྱི་མིང་གཞིའི་ཡི་གེ་དེ་ཉིད་ཀྱི་འོག་ཏུ་ས་སཱཀབྲིས་པ་མཐའ་ཡས་པ་དང་།",
    "གྲཧྨ་དང་ན་གྒ་ལྟ་བུར་འབྲི་ཚུལ་སྣ་ཚོགས་པ་རེ་འདུག་པ་འདི་རིགས་ལ་གཞིགས་ན།",
    "པར་ལུགས་ལ་མགོ་འདོགས་ཅན་གྱི་ཡི་གེ་དང་འཕུལ་རྟེན་གྱི་ཡི་གེ་གཉིས་ལ་དེང་སང་གི་ཡི་གེའི་རྣམ་གཞག་ལྟར་གྱི་དབྱེ་མཚམས་གསལ་པོ་ཞིག་མེད་པ་མངོན་ཆེ།",
    "སྔ་མའི་འཕུལ་ཡིག་གི་ནུས་པས་མིང་གཞིའི་ཡི་གེ་དེ་དག་གི་ཀློག་ལ་འགྱུར་བ་བྱུང་བ་མ་ངེས་ཏེ།",
    "མིང་གཞིའི་ཡི་གེ་དེ་དག་གི་སྟེང་དུ་མགོ་ཅན་ཡི་གེ་ར་ལ་ས་གསུམ་གང་རུང་ཞིག་བཞག་ནའང་།",
    "ལྐོག་ཏུ་འཕྱ་དམོད་མ་བྱེད་ཅིག་ལ་དཀོག་ཏུ་དཔྱས་མ་བྱེད་ཆིག་ཅེས་མིང་གཞིའི་ཡི་གེ་ཀ་ཡིག་ལ་འཕུལ་དང་མགོ་ཅན་ཡི་གེ་གང་སྦྱར་ཡང་རུང་བས་ཀ་ཡིག་གི་ཀློག་སྟངས་དེ་གཅིག་འདྲ་ཡིན་པ་ཅུང་མངོན་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "ཡི་གེ་རྣམས་སྐབས་རེར་སྐད་ཆ་རང་ལ་བསྟུན་པ་དང་།",
    "ལན་རེར་ལེགས་སྦྱར་ཀློག་སྟངས་སོགས་ལ་ཕར་བསྟུན་པ་འདྲ་སྟེ།",
    "ཤོག་དྲིལ་ཡི་གེའི་ཁྲོད་དུ་དེང་སང་གི་དྷརྨ་བྱ་བ་ལ་དར་མ་དང་།",
    "བྷ་གི་བྱ་བ་ལ་བ་ག་༧སོགས་སུ་བྲིས་པ་མང་།",
    "མགོ་ཅན་དང་མིང་གཞིའི་ཡི་གེ་གཉིས་རེ་རེ་ནས་ཀློག་ཐོན་པ་ཧ་ཅང་གསལ་ཡང་།",
    "ཡི་གེ་གང་མང་གི་སྦྱོར་ཀློག་ལ་འགྱུར་ལྡོག་བྱུང་བར་མངོན་ཏེ།",
    "མོ་ནི་བདག་དང་མ་འོངས་ཕྱིར།",
    "ཤིན་ཏུ་མོ་ནི་མཉམ་ཕྱིར་རོ།",
    "དེ་བཞིན་འབོད་ཚིག་ཀྱང་ཀ་ཡེ་བྱ་བ་ལ་རེ་འགའ་ཀ་ཡེའི་སྟེང་དུ་བརྩེགས་ནས་ཀྱི་བྱ་བ་བྲིས་འདུག་པ་སྙམ་ཞེས་དང་།",
    "གནའ་དུས་འདོགས་ཅན་གྱི་ཡི་གེ་རྣམས་མིང་གཞིའི་ཡི་གེ་དང་སོ་སོར་འཕྲལ་ནས་ཡི་གེ་རེ་རེ་བའི་ཀློག་སྟངས་གསལ་བར་ཐོན་པ་མ་ཟད།",
    "ད་དུང་རྡོ་རིང་དང་ཤོག་དྲིལ་ཡི་གེ་སོགས་ན་བྲིས་པའི་ཡི་གེ་མང་པོ་ལ་རྗེས་འཇུག་རྣམས་དེང་སང་གི་འདོགས་ཡིག་ཇི་བཞིན་སྔ་མའི་ཡི་གེ་དེའི་འོག་ཏུ་བྲིས་པ་དང་།",
    "མགོ་འདོགས་དང་འཕུལ་རྟེན་ཡི་གེ་སོགས་ཀྱི་འབྱུང་འཕེལ་ལ་དཔྱད་པསྤྱིར་བོད་ཀྱི་ཡི་གེ་བྱུང་འཕེལ་ལ་དུས་སྔ་མོ་ནས་བཟུང་བཞེད་ཚུལ་མི་མཐུན་པ་མང་དུ་ཡོད་ཀྱང་།",
    "ཕྲན་ལྟ་བུས་འོལ་ཚོད་དུ་བརྗོད་པའི་གནས་མ་ལགས་ཀྱང་གོང་གི་ས་བཅད་ཁག་གཉིས་ལས་དྲངས་པ་བཞིན།",
    "ད་དུང་ཡི་གེའི་ཕྱི་མོ་ལས་བསྟན་པའི་།",
    "དོན་དུ་སྔོན་འཇུག་གིས་ད་དུང་དེ་ཙམ་གྱིས་མ་འཐུས་པའི་ནུས་པ་ཁྱད་པར་བ་སྟོན་པ་མང་དུ་འདུག་སྟེ།",
