    "གལ་ཏེ་ཡུལ་གང་ཞིག་ཏུ་རི་མོ་ལམང་ལེགས་པ་ཞིག་ཡོད་ཚུལ་གསན་ན་ངལ་བ་འཛེམས་མེད་ཀྱིས་དེར་བྱོན་ནས་གཟིགས་ཞིབ་མཛད་ནན་ང་ར་པ།",
    "མཐའ་འཁོར་དུ་ལྷ་མགྲོན་རྣམས་རེའུ་མིག་གམ་སྒོ་ཁྱིམ་ཆུང་ངུའི་ནང་དུ་བྲིས་ཏེ་བལ་བྲིས་ཀྱི་ལེགས་ཆ་སོར་བཞག་མཛད།",
    "རྒྱབ་ལྗོངས་སུ་གཞི་ཚོན་མཚལ་ལམ་མཐིང་སྤང་གང་རུང་གི་ཐོག་ཏུ།",
    "བཅད་སྣ་ཕྲ་ལ་གསེར་རིས་ཞིབ་ཚགས་པ་དང་རི་མོ་རིགས་མང་བ།",
    "སྐུ་བལྟམས་པ་དང་ལྷོ་བྲག་གི་མཚལ་ཁ་ཡང་ཐོན་ཞིང་།",
    "སྐབས་དེར་གཙང་སྟོད་དུ་རྡོ་པ་བཀྲ་ཤིས་རྒྱལ་པོ་ཞེས་པ་རི་མོའི་སྒྱུ་རྩལ་གྱི་གནས་ལ་དོ་ཟླ་མ་མཆིས་པ་ཞིག་ཡོད་པ་དེ་དང་མཇལ།",
    "ཁོང་གིས་བྱིའུ་སྒང་ལུགས་ཀྱི་བྲིས་རྒྱུན་ལས་ཟུར་དུ་ཕྱུང་སྟེ།",
    "ལྷ་མོ་རྣམས་ཀྱི་སྐུ་ཤ་ཅུང་ཟད་སྐམ་དུ་བཏང་སྟེ་སྟངས་༥གི་ཞལ་ཁྱིམ་སྒོང་དབྱིབས་ཀྱི་རྣམ་པ་ལ་སྤྱན་ཅུང་ཟད་ཕྲ་ཞིང་ཉམས་སྟབས་བདེ་ཞིང་འཁྱུག་པ།",
    "ངས་ས་ཡུལ་མི་རྣམས་ཀྱིས་མཇལ་མ་ཐག་འཇིགས་སྐྲག་དང་དད་པ་མཉམ་དུ་སྐྱེ་བ་ཞིག་ཡོང་གི་ཡོད།",
    "ཁོང་བྱིས་པའི་དུས་རི་མོ་འབྲི་བར་ཤིན་ཏུ་དགའ་ཞིང་།",
    "དེ་མ་ཐག་སྐོམ་པ་ཆུ་འདོད་ཀྱི་རེ་བ་བཅངས་བཞིན་པར་གཙང་སྟོད་དུ་བྱོན་ནས་སློབ་དཔོན་འཚོལ་དུ་ཕེབས།",
    "འོན་ཀྱང་ཉེ་ལེགས་ཚུལ་གྱིས་བྲིས་འཇུག་གནང་གསལ་འདུག་པ་ནས་གསལ་པོར་མཚོན་ཐུབད་འཛིན་རྗེས་རབརབས་ལོ་ད་བར་མོས་ནང་མ་༤ས་མག་རྒྱུན་གྱི་རྒྱབ་ལྗོངས་སུ་རི་ཆུ་མེ་ཏོག་རྩྭ་ཤིང་སོགས་འབྲི་སྲོལ་ལ་ལད་མོ་བྱས་ནས་ཡུལ་ལྗོངས་ཀུ་ག་༧༤ས་སམན་བཀོད་པ་བྲིས་ཏེ་ཡར་རྒྱས་སུ་བཏང་བར་མངོན་ཡང་སམ",
    "རྒྱ་ནག་གི་ཞིབ་བྲིས་རི་མོའི་ཡུལ་སྣང་གི་བཀོད་པ་རྣམས་ལ་དཔེ་གཟིགས་ཏེ་སྒར་ལུགས་ཞེས་པའི་སྲོལ་ཐོག་མར་བཏོད།",
    "རྒྱང་རིང་གི་ས་གཞིའི་མདངས་མཐའ་རིམ་བཞིན་ནམ་མཁའི་མཐར་ཡལ་བས།",
    "རྒྱང་རིང་གི་སྣང་ཆ་ཚོར་བ།",
    "ལྷ་མོ་སོགས་ཞི་བའི་རིགས་རྣམས་ཀྱི་སྤྱན་དང་ཞལ་ཆུང་བ།",
    "ཐེངས་འདིར་ཡིག་ཚོགས་ལ་འཇིགས་ནས་ཞུ་ཐུབ་མ་སོང་།",
    "སྤྱིར་བོད་ཀྱི་སྲོལ་རྒྱུན་རི་མོའི་བརྩམ་བྱ་གང་ཡིན་རུང་ཇི་མ་ཇི་བཞིན་གྱི་དངོས་བྲིས་ལ་དང་དོད་མི་བྱེད་པར།",
    "ཡུལ་སྣང་གི་བཀོད་པ་གཅིག་གི་ཐོག་ཏུ་གཏམ་རྒྱུད་ཀྱི་སྔ་གེ་ཞཅ་ཕྱིའི་གོ་རིམ་རྣམས་གཙོ་ལྷའི་མདུན་ངོས་ནས་གཡས་བསྐོར་དུ་མུ་འབྲེལ་བྱས་ཏེ་བྲིས་ཡོད།",
    "དཔྱད་རྩོམ་གྱི་ཐོག་མཐའ་བར་གསུམ་དུ་དབྱེ་སྡུད་ཡོད་པའི་ཚན་རིག་གི་ཞིབ་འཇུག་ཐབས་ལམ་བརྒྱུད་ནས་སྤྱི་དང་བྱེ་བྲག་གི་དབྱེ་བ་གསལ་ཞིང་།",
    "དཔྱད་རྩོམ་འདིས་བོད་ཀྱི་སྲོལ་རྒྱུན་གྱི་རི་མོར་ཞིབ་འཇུག་བྱེད་པར་སྐུ་ཐིག་བཏབ་པ་དང་མཚུངས་པས་ན་ཟུར་བསྟན་ལེབ་མཐོང་བྱེད་པའམ་ཡང་ན་རྗེས་ཕྱོགས་བོད་ཀྱི་སྲོལ་རྒྱུན་རི་མོར་ཞིབ་འཇུག་བྱེད་པར་རྨང་གཞི་ལེགས་པོ་ཞིག་བཏིངས་འདུག་གོ།",
    "༡༢ ནསཔསསསསསསསཔ་བན་ཡུལ་ལུང་སྤྱི་དང་བྱེ་བྲག་གིས་མིང་གང་ཞིག་ཡིན་རུང་དེ་ནི་མིའི་རིགས་བྱུང་བ་ནས་མི་རིང་བར་བྱུང་བ་ཞིག་ཡིན།",
    "ཙྩལ་མིང་གི་བྱུང་ཚུལ་དེ་གཉིས་ལའང་དམིགས་ཀྱིས་བཏགས་ནས་ཐོགས་པ་དང་རང་བཞིན་ཞིང་།",
    "གྱིས་ཐོགས་པ་གཉིས་ནི་ངེས་པར་ཡོད་སྲིད་པ་ཡིན་སྙམ་མོ་བ་འདིའི་རང་བཞིན་ཞེས་པ་ནི་རྒྱུ་།",
    "བོད་བཙན་པོའི་དུས་ཀྱི་རྡོ་རིང་གི་ཡི་གེ་དང་ཏུན་ཧོང་ཤོག་དྲིལ་སོགས་ལས་རྭ་སྒྲེང་ཞེས་པའི་ཡུལ་མིང་བཀོད་པ་མིག་ལམ་དུ་མ་མངོན་ཞིང་།",
    "དག་ལས་མང་དག་ཅིག་ནི་འཕན་ཡུལ་དང་རྭ་སྒྲེང་གི་ཕྱོགས་སུ་འཁྲུངས་པའམ།",
    "ས་རྭ་སྒྲེང་ཞེས་པའི་ཡི་གེ་འདི་ཡར་སྔོན་མཁས་པ་དག་གི་འབྲི་ལུགས་རང་གི་མཐོང་བ་རྣམས་གཞིར་བཅས་ན།",
    "དེའི་སྔོན་མ་རྭ་ཞེས་པར་མིང་གཞི་ར་ཡིག་ལ་ཝ་ཡིག་བཏགས་མ་བཏགས་གཉིས་སུ་གཙོ་བོ་བྱུང་ཞིང་གཞན་རོལ་ཞེས་འབྲི་བའི་ལུགས་གཅིག་ཀྱང་འདུག་མོད།",
    "རྭ་སྒྲེང་གི་གླིང་གསེབ་དེར་འཆལ་བ་དང་དམ་ཉམས་ལ་སོགས་པ་མི་གཏོང་ཞེས་དང་།",
    "དེ་ཡང་པོ་ཏོ་བ་རིན་ཆེན་གསལ་ནི་སྤྱི་ལོ་ལོར་འཁྲུངས་ཤིང་འབྲོམ་སྟོན་གྱི་དངོས་སློབ་ཀྱང་ཡིན་པས་དེས་ན་རྭ་སྒྲེང་གི་མིང་ཡིག་དང་པོ་རྭ་ཡིག་ཝ་འདོགས་ཅན་ནི་དུས་དེ་ནས་སམ་ཡང་ན་དེ་ལས་ཆེས་སྔ་བའི་གོང་ནས་འབྲི་མུས་ཡིན་པ་བདེན་དཔང་བྱེད་ཐུབ་སྙམ་མོ།",
    "རྗེ་ཙོང་ཁ་བའི་ལམ་རིམ་ཆེན་མོའི་མཇུག་ཏུའང་ཤར་འ་ན་༣ཙོང་ཁ་བ་བློ་བཟང་གྲགས་པའི་དཔལ་གྱིས་བྱང་རྭ་སྒྲེང་རྒྱལ་བའི་དབེན་གནས་ཀྱི་ཡང་དགོན་བྲག་སེང་གེའི་ཞོལ་གྱི་རི་ཁྲོད་དུ་ལེགས་པར་སྦྱར་བ་ཞེས་བྱུང་བ་བཞིན་མཁས་པ་ཕལ་ཆེར་གྱིས་འབྲི་ཚུགས་དེ་བཞིན་དུ་སྤྱད་འདུག་གོ།",
    "ཕལ་ཆེར་དེ་ཁོ་ན་ཉིད་དུ་ཡོད་པར་སྙམ་སྟེ་འབྲི་ཚུགས་མང་ཉུང་ལ་བསམ་ན་ཡང་ར་ཡིག་ཝ་འདོགས་ཅན་རྐྱང་བ་ལས་མང་བ་དང་ལྷག་པར་དེང་གི་དུས་སུ་ཀུན་གྱིས་ཐུན་མོང་དུ་ར་ཡིག་ཝ་འདོགས་ཅན་ཁོ་ན་འབྲི་བཞིན་པས།",
    "རང་གི་རྒྱུད་ལ་ཅི་ཕན་བྱ་བའི་ཆེད་དུ་འཕངས་འཕངས་རྣམས་བརྗེད་ཀྱི་དོགས་ནས་བྲིས་པ་ཡིན་ཞེས་གསུངས་པ་དང་།",
    "འབྲོམ་སྟོན་འཁྲུངས་ནས་ལོ་བཞི་བརྒྱ་དང་བདུན་ཅུ་སོང་།",
    "ཡུལ་འདིའི་མིང་སྐྱེ་བོ་དག་གི་ངག་ནས་བརྗོད་ཚུལ་གྱི་སྒྲ་གདངས་ལ་བསམས་ན།",
    "རྭ་སྒྲེང་དང་རེ་སྒྲེང་ཞེས་སྒྲའི་རྣམ་པ་གཉིས་སུ་མཆིས་ཤིང་དང་པོའི་འདོན་ཚུལ་ར་ཡིག་ལ་ཝ་འདོགས་ཡོད་མིན་ངག་སྦྱོར་ལས་རྟོགས་དཀའ་ཡང་ར་ཡིག་ལ་དབྱངས་དྲང་པོར་བཞུགས་པ་དེ་ལྟར་བརྗོད་མཁན་ཕལ་ཆེར་ཞིག་ནི་ཡུལ་འདི་ལས་ཅུང་ཟད་ཐག་རིང་ས་ན་འཚོ་བཞིན་པའི་སྐྱེ་བོ་དག་ཏུ་སྣང་ལ།",
    "རང་གི་རྣམ་རྟོག་ལྟར་ན།",
    "འོན་ཏེ་རྭ་སྒྲེང་ངམ་རེ་སྒྲེང་ཞེས་པའི་བརྗོད་ཚུལ་འདི་གཉིས་ལས་གང་ཞིག་སྔོན་གྱི་ཡི་གེའི་སྦྱོར་བ་དང་མཐུན་སྙམ་ན་སྤྱིར་ཁ་སྐད་ནི་ཡིག་སྐད་ལས་ཤིན་ཏུ་སྔ་ཞིང་ཕྱིས་སུ་དེ་དག་ཡི་གེར་འགོད་སྐབས་ཀྱང་ཡི་གེས་ཁ་སྐད་ཀྱི་སྒྲ་འདོན་ཚུལ་ཇི་བཞིན་ལེགས་པར་བསྟུན་པ་ཡིན་པ་སྒྲ་རིག་སྨྲ་བ་ཀུན་ཞལ་གཅིག་མཐུན་ཡིན་ཡང་།",
    "སོ་ན་གནས་པ་དེ་ཡིན་ནམ་སྙམ་མོ།་",
    "ར་ནི་རང་བཞིན་རྣམ་དག་རང་གིས་སྟོང་།",
    "རང་གི་མཚན་ཉིད་རང་རང་ནང་དངས་ག།",
    "རང་རིག་རང་གསལ་རིག་པ་རང་གི་མཆོག།",
    "སྒྲ་སྐད་ཐུན་མོང་མ་ཡིན་གནས་དེར་སྒྲོགས་ཞེས་པའི་སྙན་ངག་གི་ལམ་ནས་སེམས་ཀྱི་གནས་ལུགས་སམ་ངོ་བོ་ཇི་བཞིན་མཚོན་པར་འགྲེལ་ཅིང་།",
    "ས་༣༣ ༣བ་༡༧དེ་བཞིན་མཁའ་འགྲོ་མའི་བརྡ་སྐད་ཐུན་མོང་མ་ཡིན་པ་རྭ་སྒྲེང་ཞེས་བྱ་བ་སོགས་ཀྱང་བྱུང་བས།",
    "ཡུལ་འདིའི་མིང་ནི་མཁའ་འགྲོ་མའི་བརྡ་སྐད་དེ་གོ་རྒྱུ་ཤིན་ཏུ་ཟབ་མོ་ཡོད་སྐོར་ཡང་འཁོད་ཟ་འདུག་གོ།",
    "ཇོ་བོས་གསུངས་པ་ཉིད་དུ་ངེས་པ་ནི་ཐེ་ཚོམ་མི་དགོས་སྙམ་མོ།",
    "དེ་ཡང་རྒྱ་གར་གྱི་སྐྱེས་རབས་ཀྱི་ལུས་བཞིན་བྱས་པའི་བོད་མིའི་སྐྱེས་རབས་བསྟན་བཅོས་ཀྱི་ཐོག་མ་དེ་ཡིན་ཏ་ཀ་པར་སེམས་ས་འདདཔྱད་རྩོམ་གྱི་བརྗོད་བྱ་དང་མ་འབྲེལ་བས་རེ་ཞིག་བརྗོད་འདོད་ཀྱི་ངལ་བ་བོར་རོ།",
    "དེ་ལྟར་མ་ཡིན་ན་བརྗོད་བྱའི་དོན་མང་དག་ཅིག་གང་ཟག་དག་སྣང་ཅན་དག་གི་ངོར་ཙམ་མ་གཏོགས་ཁོ་བོ་ཅག་ཚུལ་རོལ་མཐོང་བ་དག་དང་།",
    "རྭ་སྒྲེང་ཞེས་པའི་མིང་ཡང་ས་བྱུང་ཞིང་ཡུལ་དོད་ནས་མི་རིང་བར་དེ་ན་ལྷགས་པའི་མི་རྣམས་ཀྱིས་འདོད་རྒྱལ་ལམ་རྗེས་གྲུབ་གང་རུང་གི་ལམ་ནས་བཏགས་པ་ཞིག་ཡིན་དགོས་རྒྱུ་ནི།",
    "ཞང་གིས་རྭ་སྒྲེང་གི་གནས་འདིར་བཞུགས་ནས་མཆོད་གནས་གནང་དགོས་པའི་རེ་བ་བཏོན་པའི་སྐོར་སོགས་ལས་ཀྱང་རྟོགས་ནུས་པ་ཡིན་ནོ།",
    "དཙཅས་བཅད་ཆས་ཝན་ལས་ཐད་ཆགས་ཡམས་དང་བློ་བཟོ་ཅི་བས་མང་བ་ཞིག་བསྲེས་ཡོད་པས་རེ་ཞིག་བཏང་སྙོམས་སུ་འཇོག་གོ།"
  ]
}