    "རྒྱུན་མི་འཆད་པར་རབ་བསྲེག་ཁ་ཡང་བགྲད།",
    "ཁ་ཅིག་ལྕགས་ལས་བྱས་པའི་ཟངས་ཆེན་དུ།",
    "མི་འཇིགས་གང་ལགས་རྡོ་རྗེའི་རང་བཞིན་ནོ།",
    "རབ་ཏུ་དྲག་བཏབ་སྡུག་བསྔལ་གང་ལགས་པ།",
    "དེ་ལྟར་ཉིད་ཀྱི་རྩལ་གྱིས་འབད་པར་མཛོད།",
    "མི་གཙང་གྱི་ནར་བོར་བ་ཅུང་ཟད་ཀྱང་།",
    "འཚལ་བའི་མཐུ་དང་ལྡན་པ་མ་ལགས་སོ།",
    "ཏ་ལའི་ཡང་ཏོག་བསྐམས་པ་ལྟ་བུ་ལགས།",
    "ཁྲག་སོགས་མི་གཙང་བ་ཡང་མི་རྙེད་དེ།",
    "བལྟས་པ་ཙམ་གྱིས་ཀླུང་ཡང་བསྐམ་པར་འགྱུར།",
    "བར་ཆད་མེད་པར་སྡུག་བསྔལ་རྟེན་གྱུར་པ།",
    "ཉེས་པར་སྤྱད་པའི་ལས་ཀྱི་ཞགས་པ་ནི།",
    "སྡུག་བསྔལ་རོ་གཅིག་ཐོབ་པ་གང་ལགས་བ།",
    "སྦྲོན་པར་བྱེད་པའི་འཆི་ལྟས་རྣམས་དང་འདྲ།",
    "སྐྱེ་བ་བཟང་པོ་མ་ལགས་སྐྱེ་བ་ནི།",
    "གནོད་པ་དུ་མའི་སྣོད་གྱུར་ལགས་མཁྱེན་མཛོད།",
    "ཡང་སྲིད་མེད་པར་བགྱི་སླད་འབད་འཚལ་ཏེ།",
    "མྱ་ངན་འདས་ཐོབ་བགྱིད་པའི་དགེ་ཚོགས་ལགས།",
    "ཤེས་རབ་མེད་པར་བསམ་གཏན་ཡོད་མིན་ཏེ།",
    "བསམ་གཏན་མེད་པར་ཡང་ནི་ཤེས་རབ་མེད།",
    "ཉི་མའི་གཉེན་གྱིས་རབ་གསུངས་གང་དག་ལགས།",
    "དེ་དག་རྣམས་ལ་བསམ་པར་མི་བགྱི་སྟེ།",
    "དེ་ཡིས་བློ་ནི་ཞི་བར་བགྱིད་མ་ལགས།",
    "སྲེད་ལས་ལེན་པ་བསྐྱེད་པར་འགྱུར་བ་སྟེ།",
    "དེ་ལས་སྲིད་པ་སྲིད་ལས་སྐྱེ་བ་ལགས།",
    "སྐྱེ་བ་འགགས་པས་འདི་ཀུན་འགགས་པར་འགྱུར།",
    "འཐོབ་བགྱིད་འཕགས་ལམ་ཡན་ལག་དེ་བརྒྱད་ལགས།",
    "མཐོང་བར་བགྱིད་སླད་རྟག་ཏུ་བརྩོན་པར་བགྱི།",
    "གནས་ལས་བབས་པ་མ་ལགས་ལོ་ཏོག་བཞིན།",
    "ས་རུམ་ལས་འཐོན་མ་ལགས་དེ་དག་སྔོན།",
    "ཕན་པའི་གདམས་ངག་དོན་པོ་འདི་ལགས་ཏེ།",
    "ཉིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་རྣམ་གསུམ་ཡང་།",
    "སྐྱེ་བ་དཔག་ཏུ་མེད་པར་ལྷ་མི་ཡི།",
    "མགོན་པོ་སྐུ་ཚེ་དཔག་ཏུ་མེད་པར་མཛོད།",
    "བདེ་དགས་དགའ་བ་ངེས་པར་རབ་ཏུ་ཞི་མཛད་དེ།",
    "མི་བགྲེས་ནོངས་མི་མངའི་གོ་འཕང་བརྙེས་པར་མཛོད།",
    "ཉེས་པའི་སྐྱོན་རྣམས་ལྦུ་བའི་རྣམ་པར་ཕྱིར་ལུད།",
    "མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "མགྲིན་པར་ཨཱ་དམར་པོ།",
    "རང་ཉིད་རྡོ་རྗེ་སེམས་དཔའ་རིགས་བསྡུས་ཀྱི་རང་བཞིན་བདེ་སྟོང་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡེ་ཤེས་དང་ལྡན་པར་གྱུར།",
    "བྱང་ཞིང་དག་པར་མཛད་དུ་གསོལ།",
    "རབ་ཏུ་གུས་པའི་ཡིད་ཀྱིས་བསྟོད་པར་བགྱི།",
    "དུས་གསུམ་མཁྱེན་པ་འགྲོ་མགོན་རས་ཆེན་རྗེ།",
    "སྲོག་རྩོལ་ལོངས་སྐུར་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཡི་དམ་ལྷ་ཚོགས་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམ་པར་གྱུར་པར་བསམ་ལ་མཉམ་པར་བཞག།",
    "སྣོད་བཅུད་ཐམས་ཅད་སྟོང་པར་གྱུར།",
    "དཔུང་རྒྱན་ཕྱག་གདུབ་ཞབས་གདུབ་རྣམས་རྣམ་པར་སྣང་མཛད།",
    "རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པ།",
    "ཐོད་པ་སྐམ་པོ་ལྔས་དབུར་བརྒྱན་ཅིང་རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པ།",
    "གཙོ་བོ་བཅོམ་ལྡན་འདས་ཡབ་ཀྱི་སྤྱི་བོར་ཨོཾ་ལས་གཟུགས་ཀྱི་ཕུང་པོ་རྣམ་པར་སྣང་མཛད་དཀར་པོ་འཁོར་ལོ་དང་དྲིལ་བུ་འཛིན་པ།",
    "གཡོན་ཅུང་ཟད་བསྐུམས་པས་རོའི་གདན་ལ་བཞུགས་པ།",
    "གཡོན་ཅུང་ཟད་བསྐུམས་པས་རོའི་གདན་ལ་བཞུགས་པ།",
    "གཡས་ཀྱི་བརླ་ཡབ་ཀྱི་བརླ་གཡོན་པར་འཁྲིལ་ཅིང་བཞུགས་པ།",
    "རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པ།",
    "གཡོན་ཅུང་ཟད་བསྐུམས་པས་རོའི་གདན་ལ་བཞུགས་པ།",
    "རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པའོ།",
    "མགོ་བོར་རྣམ་པར་སྣང་མཛད་ཀྱི་རང་བཞིན་ན་མ་ཧི་སེར་པོ།",
    "མགྲིན་པར་པདྨའི་སྟེང་དུ་ཨཱ་ལས་གསུང་རྡོ་རྗེ་དམར་པོ་པདྨ་དང་དྲིལ་བུ་འཛིན་པ།",
    "ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པའི་བདེ་བ་ཆེན་པོ་དགའ་བའི་སྒྲ།",
    "ཛ་ཧཱུྃ་བྃ་ཧོ་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "པར་ཤུ་པཱ་ཤོདྱཱ་ཏ་ཤཱུ་ལ་ཁ་ཊྭཱཾ་ག་དྷཱ་རི་ཎེ། ༡༤༦",
    "སཔྟ་པཱ་ཏཱ་ལ་ག་ཏ་བྷུ་ཛཾ་ག་པར་པཾ་བཱ།",
    "རྒྱས་པར་དཀྱིལ་ཆོག་ནས་བྱུང་བའི་མཆོད་བསྟོད་རྣམས་བྱ་དགོས་ཀྱང་སྤྲོས་པས་མི་ལྕོགས་ན།",
    "རྒྱས་པར་མདུན་བསྐྱེད་ལྟར་དང་།",
    "གསུམ་པ་ནོངས་བཤགས་ནི།",
    "དེ་ཤིན་ཏུ་ཕྲ་བར་གྱུར་ནས་མི་དམིགས་པར་གྱུར།",
    "འགྲོ་བ་ལྔས་ཀྱང་ཐོབ་པར་ཤོག།",
    "བདག་ཀྱང་དེ་ཉིད་སྤྱོད་པར་ཤོག།",
    "ཁྱད་པར་ཆུའི་གནོད་པ་དགྲ་འདྲེ་བྱུར་སོགས་མི་མཐུན་པའི་རིགས་ཀུན་ཞི་ཞིང་།",
    "རྩ་གསུམ་མཆོག་གསུམ་ཀུན་རྔ་འདི་ལ་བརྟན་པར་བཞུགས་ནས་ལོག་འདྲེན་སྐྲོད་པ་དང་།",
    "ས་ལུ་དང་ནས་ཀྱི་ས་བོན་གྱི་བདག་ཉིད་ཀྱི་སྒོ་ནས་ས་ལུ་བྱེད་མི་བྱེད་ཀྱི་ཁྱད་པར་འགལ་བར་འགྱུར།",
    "རིམ་པ་དེ་ཅི་གཙོ་བོའི་དངོས་པོ་དེ་གཅིག་པུ་ཉིད་ཀྱིའམ་རྣམ་དབྱེ་ཐ་དད་མེད་པ་གནས་སྐབས་སྔ་མ་ལས་ཕྱི་མ་ཁྱད་པར་ཅན་དུ་ཡོངས་སུ་འགྱུར་བ་ཡིན།",
    "འབྲས་བུ་རིམ་ཅན་སྐྱེད་པ་ལ་ནུས་པ་ངེས་པས་སམ་སྔ་ཕྱི་ཁྱད་པར་ཅན་དུ་གྱུར་པས་འབྲས་བུ་བྱེད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཐ་དད་རྣམས་ཐ་དད་མེད་པ་གཙོ་བོའི་བདག་ཉིད་དམ་གཙོ་བོའི་བདག་ཉིད་དེས་ཐ་དད་མེད་པར་འགྱུར་བ་མི་འཐད་དེ།",
    "གང་ལས་ཕན་ཚུན་ཐ་དད་པ་མེད་དེ་མིན་པར་འགྱུར།",
    "སྤྱི་གཅིག་ལས་ཐ་མི་དད་པས་རྣམ་པ་ཐམས་ཅད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "དེ་བདག་ཉིད་ཐམས་ཅད་ཀྱི་ཐ་དད་མེད་པར་ཡང་ངེས་པ་མིན་ཏེ།",
    "ཁྱད་པར་དང་སྤྱི་ཞེས་ཐ་དད་དུ་རྣམ་པར་བཞག་པའི་ཕྱིར།",
    "གལ་ཏེ་ནུས་པ་དང་གསལ་བ་དེར་བཞག་པའི་བདག་ཉིད་དེས་སྤྱི་དང་ཁྱད་པར་བདག་ཉིད་ཐ་དད་དུ་འཇོག་པའི་ཕྱིར་ནའོ།",
    "སྤྱི་ཁྱད་པར་དང་འབྲེལ་བ་མེད་པའི་ཕྱིར།",
    "ཕན་ཚུན་མ་འདྲེས་པར་ཐ་དད་པའི་ཕྱིར།",
    "སྣམ་བུ་ལེན་པ་ལ་འཇུག་པར་འགྱུར།",
    "རྣམ་གཅོད་སེལ་བ་བརྗོད་པར་བྱེད་པར་གྲུབ་སྟེ།",
    "དེས་ན་སྒྲ་རྟོག་ཐམས་ཅད་སེལ་བས་འཇུག་པས་སྒྲ་བྱས་མི་རྟག་པའང་ལྡོག་པ་ཐ་དད་པའི་ཕྱིར་རྟགས་བྱས་པ་ནི་དམ་བཅའི་ཕྱོགས་གཅིག་རྟགས་སུ་བཀོད་པའི་མ་གྲུབ་པ་མིན་ནོ།",
    "དཔེར་ན་སྒྲ་འཇིག་པར་སྒྲུབ་པ་ལ་རྒྱུ་རྐྱེན་གྱི་འབྲས་བུ་བྱས་པ་དང་དངོས་པོར་ཡོད་པ་ཉིད་རྟགས་སུ་བཀོད་པ་བཞིན་ནོ།",
    "ཐ་མི་དད་པའི་ཁྱད་པར་ལ་ལྟོས་པས་སྒྲ་འཇིག་པ་ལ་སྐྱེ་ལྡན་བཀོད་པ་ལྟ་བུའོ།",
    "འདོད་ན་ཡོད་པའི་སྤྱི་སྒྲུབ་ན་གྲུབ་ཟིན་པའི་སྐྱོན་དུ་འགྱུར་བས་ཁྱད་པར་གཙོ་བོ་ཡོད་པ་བསྒྲུབ་བྱའོ་ཞེ་ན།",
    "ཁྱད་པར་གཙོ་བོའི་ཡོད་པ་དཔེ་ལ་རྗེས་འགྲོ་མེད་པའི་ཕྱིར།",
    "ཡོད་པ་རྟགས་སུ་འདོད་པ་ལ་ཡང་ཡོད་ཙམ་དགོས་པ་མེད་པས་ཁྱད་པར་སྒྲའི་ཡོད་པའམ་རང་མཚན་དུ་ཡོད་པ་རྟགས་སུ་བྱེད་ན་དཔེ་ལ་རྗེས་འགྲོ་མེད་པས་བསྒྲུབ་བྱར་མ་ཟད་གཏན་ཚིགས་དག་ལས་ཀྱང་ཉམས་པར་མཚུངས་སོ་ཞེ་ན།",
    "གཙོ་བོ་ཡོད་པར་མ་གྲུབ་པས་སོ།",
    "དེ་ལྡོག་པ་ན་རྟགས་དངོས་པོར་ཡོད་པ་དེ་ལྡོག་པར་བྱེད་ཅིང་དེ་དང་དེ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "དཔེར་བརྗོད་ན་མི་རྟག་པ་ཉིད་ཀྱིས་བྱས་པ་ལ་ཁྱབ་པ་སྟོན་པའི་མཐུན་སྦྱོར།",
    "གང་བྱས་པ་མི་རྟག།",
    "སྒྲ་ཡང་བྱས་ཞེས་པའམ།",
    "སྒྲ་ནི་བྱས་ཞེས་པ་བཞིན་ནོ།",
    "རང་འཇིག་པར་འགྱུར་བ་རང་རྒྱུ་ལས་དོན་གཞན་ཕྱིས་ཀྱི་རྒྱུ་ལ་ལྟོས་པ་དང་བཅས་པའི་ཕྱིར།",
    "འཇིག་མི་སྲིད་པར་འགྱུར།",
