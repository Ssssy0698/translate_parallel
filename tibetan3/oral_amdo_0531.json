    "ཁྱོད་ཉིད་བསྔགས་པའི་གནས་སུ་མཐོ།",
    "འོད་ཀྱི་རྩེ་དགས་ཁྱོད་བཟུང་བས།",
    "དར་གྲོང་གྲུབ་ཆེན་ཚང་གི་སྐུ་རབས་ཐོག་མ་ནི་སྔགས་འཆང་བདུད་འདུལ་འོད་ཟེར་ཡིན་ལ།",
    "ཆུང་དུས་ནས་སྒེའུ་སྟེང་གི་གྲྭ་བ་བྱས།",
    "རྣམ་པ་གསུམ་གྱིས་རས་ཏོ་སྦྲ་ཆུང་ཞིག་ཕུབ་ནས་བཞུགས་སྐབས་ཧོར་དཔོན་པོས་བརྙས་དམོད་བྱས་པར་གཏོར་མ་ནག་པོ་ཞིག་འཐེན་པ་མཛད་པར།",
    "དེ་ནས་རིག་མ་བཞེས་ཏེ་སྲས་མིང་སྲིང་བཞི་འཁྲུངས་པའི་སྲས་མོ་ཕྱོགས་དེར་བཞག་པ་ད་ལྟའི་བར་མི་རྒྱུད་མ་ཉམས་པར་གནས་པ་བོན་གྱའི་ལ་ཁའི་མི་རྩ་དག་ཡིན།",
    "འབྲིང་བོ་དར་གྲོང་གྲགས་པ་ཕྱིར་ཕ་ཡུལ་དང་གྲོང་དུ་མག་པར་སོང་བའི་རྒྱུད་པ་འཕེལ།",
    "དེའི་འོག་མ་གཉིས་ཕྱོགས་འདིར་སྔར་མ་ཐོས་པ་ཞིག་རེད།",
    "སྐྱབས་མགོན་མཆོག་གི་བཀས་རོང་བོ་གསེར་ཁྲི་ཆེན་མོ་ལོ་གསུམ་བར་བསྐྱངས་ནས་བསྙེན་བཀུར་རྒྱ་ཆེན་པོ་བྱས།",
    "སྔགས་ཀྱི་ནུས་པ་ཚད་ལྡན་ཐོན་པས་ཨ་མཆོག་ཚུན་ན་ཚོ་འདུའི་གྲུབ་ཆེན་དུ་གྲགས།",
    "ཨ་མཆོག་གི་རྒད་པོ་ཞིག་གིས་ར་མ་ཞིག་གི་སྐེ་ལ་བསྐོན་ཏེ་མེ་མདའ་ཉི་ཤུ་རྩ་གྲངས་བརྒྱབ་པས་ཀྱང་ར་མ་མ་ཆོད་པར་གྲགས་ལ།",
    "སྐྱབས་རྗེ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོའི་ཞལ་བཀོད་ལྟར་ཀུན་རིག་གི་བདག་འཇུག་བཙུགས།",
    "སྐུ་རྗེས་མ་ཨ་རོལ་རྡོ་རྗེ་འཆང་གིས་ཀྱང་དགྱེས་ཆེར་མཛད།",
    "ཁྱད་པར་དུ་ཀུན་གཟིགས་རྡོ་རྗེ་འཆང་རྒྱལ་སྲས་ཆེན་པོ་དྲང་སྲོང་རྣམ་བརྒྱད་དང་བཅས་པ།",
    "རོང་སྟོན་རྣམ་གཉིས་གཙོ་བྱས་པའི་སའི་སྟེང་གི་རྒྱལ་བསྟན་གྱི་བདག་པོ་ཆེས་མཐོའི་བླ་སྤྲུལ་དང་།",
    "ཁྱད་པར་དུ་ཡང་འཛམ་གླིང་ན་ཟླ་དང་བྲལ་བའི་པཎྜི་ཏ་ཆེན་པོ་འཕགས་བོད་ཀྱི་མཁས་རྒུའི་གསང་གསུམ་ཡོན་ཏན་གྱི་ཕུང་བོ་གཅིག་ཏུ་སྤུངས་པའི་ཚོམ་བུ་ཀུན་གཟིགས་ཡོངས་འཛིན་བློ་བཟང་དཔལ་ལྡན་ནི།",
    "སྒེའུ་སྟེང་གི་ནང་ཆེན་དང་འདུ་ཁང་གསར་བཞེངས་བགྱིད་པ་པོ།",
    "མ་སྒྲོལ་མ་ཞེས་བྱ་བ་བུད་མེད་ཀྱི་མཛེས་པའི་རྒྱན་རྣམས་རྫོགས་པ་རྒྱན་གོས་རིན་ཐང་ཅན་རྣམས་ཀྱང་འདུ་ཁང་དང་།",
    "ཁྱོད་ཚོ་ཐམས་ཅད་ཕྱོགས་སྒྲིལ་གྱིས་ལན་ཐོབས་དང་།",
    "ངེད་ཀྱི་ཐལ་འགྱུར་འདི་ལ་ལན་ཐེབས་པ་བྱུང་ན་མདུན་འདིར་གཟན་ཤམ་ཕུད་དེ་རྒྱལ་དུ་སྟེར་རོ།",
    "ཞྭ་དམར་རྡོ་རྗེ་འཆང་ལ་འགའ་ཞིག་གིས་འོས་མིན་གྱི་ཞུ་ཚིག་ཕུལ་བའི་ལན་དུ་ཕྱག་འཕྲིན་ལས།",
    "ཁོང་བས་རྒྱ་བོད་ཀྱི་གཞུང་ཆེན་མོ་བསྡུར་ནས་ལྟ་རྟོག་བྱེད་མཁན་ཞིག་ཡིན་པས་ལོ་ཤས་འགོར་ན་འཛམ་གླིང་ན་ཟླ་མེད་པའི་མཁས་པ་ཞིག་འབྱུང་སྙམ་པ་ཡོད།",
    "ལམ་རིམ་ཆེན་མོ་སོགས་འཕགས་བོད་ཀྱི་གཞུང་ཆེན་མང་བོའི་དགོངས་པ་ཡིན་ཚུལ་གྱི་དམ་པཅའ་དང་།",
    "ཚུལ་དེ་དག་ལ་བརྟེན་ནས་བདེན་བཞིའི་འཇུག་ལྡོག་གི་བླང་དོར་གསལ་བར་མཚོན་པ་དང་ཆབས་གཅིག་གངས་ཅན་གྱི་རིག་གཞུང་ལ་བྱི་དོར་དང་།",
    "ཚོ་འདུ་མཁན་ཆེན་སོགས་བླ་སྤྲུལ་བཤེས་གཉེན་བཅུ་ཕྲག་བདུན་ཙམ་ལ་ལམ་རིམ་ཆེན་མོ་མཛུབ་ཁྲིད་དང་།",
    "འཇམ་མགོན་ཐུགས་བཅུད་ལམ་རིམ་ཆེན་མོ་ཞེས།",
    "གང་གི་ངོ་མཚར་མཁྱེན་རབ་དབྱུག་གུ་ཡིས།",
    "དགུང་ལོ་ལྔ་བཅུ་བ་ནས་སྐྱབས་མཆོག་མཐོང་བ་དོན་ལྡན་གྱི་སྐུ་ཡོན་གསན་སྦྱོང་གི་ཆེད་དུ་རོང་བོ་དགོན་ཆེན་གྱི་ཤར་བླ་བྲང་ནོར་བུ་གྲུ་འཛིན་གྱི་གཞལ་ཡས་ཁང་དུ་ཡོངས་འཛིན་བདེ་ཡངས་འཇམ་དབྱངས་དགའ་ཚལ་གསར་བསྐྲུན་ནང་དུ་ཕྱག་ཕབ་སྟེ་ཤས་ཆེར་རྒྱུན་བཞུགས་ཀྱི་སྒོ་བཏོད།",
    "དགུང་ལོ་ང་དྲུག་སྟེང་བརྒལ་ལན་ཆུའི་འཕྲུལ་འཁོར་ཞེས་མིང་གིས་ཀྱང་ངོ་མཚར་སྟེར་བ་དེ་བཀའ་རྩོམ་མཛད།",
    "ཁོང་བ་མཁས་ཁུངས་མེད་པར་ཡོན་ཏན་རང་བརྡོལ་བྱུང་བ་རེད།",
    "སྔགས་ཀྱི་སྟོང་ཐུན་ཆེན་མོ།",
    "རྩ་ཤེའི་སྦྱོར་ཊིཀ་སོགས་གཞུང་ཆེན་མོ་དང་།",
    "ཆབ་ཤོག་སྙན་ངག་གི་སྐོར་ཕྱོགས་བསྒྲིགས།",
    "ཚོ་འདུ་མཛོ་གོང་གི་རིགས་ས་སྐྱ་ཡིན་ཟེར་ཞིང་ས་སྐྱ་ཨ་མྱེས་ཀྱི་ཕྱག་འཁོར་ད་ལྟ་ཡང་རྟེན་དུ་བཞུགས་ཡོད།",
    "མཆོད་རྟེན་ནང་གཙུག་ལག་ཁང་གི་བཀོད་པ་ཅན་བཀའ་བསྟན་སོགས་བཞུགས་པ་བསྟན་པའི་ཆག་འཇིག་གིས་མེ་བཞེས།",
    "ཚོ་འདུའི་གཅོད་རྒྱུན་ནི་རྗེ་ཨ་རོལ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོས་སྤེལ་བར་མཛད་ལ་རྗེ་དེ་ཉིད་ཀྱི་གཅོད་ཌར་གྲུབ་ཆེན་དུང་རྣ་བར་གྲགས་པ་ཨུ་རྒྱན་བསྟན་འཛིན་གྱི་ཕྱག་ཌར་ཡིན།",
    "དར་གྲོང་ནས་བླ་བྲང་གི་རྡོ་རམས་པ་སྦྱིན་པ་རྒྱ་མཚོ་འཁྲུངས་ཏེ་ཁོང་རིག་པའི་གནས་ལྔ་ལ་མཁས་ཤིང་བླ་བྲང་ནས་རྡོ་རམས་པ་བླངས་ཤིང་མཁས་པའི་རྩེར་སོན།",
    "ཡུམ་དབལ་ཤུལ་བཟའ་ལྷ་མོ་ཐར་གཉིས་ཀྱི་སྲས་སུ་རབ་བྱུང་བཅུ་གཅིག་པའི་མེ་ཁྱི་ལ་འཁྲུངས།",
    "ཟླ་བ་དྲུག་ཙམ་ན་ཐུ་མེད་ཧོ་ལོ་ཆིའི་དམག་གིས་རུ་བ་བརྒྱབ།",
    "ཡུམ་གྱིས་འདི་བ་རུམ་དུ་བཅུགམཛོ་མོ་ཞིག་ཡོད་པ་ཁྲིད་ནས་བྲོས་པར།",
    "ཨ་མ།",
    "མཛོ་མོ་ཐོངས་གསུངས་པར་བྱིས་པ་ངག་མ་གྲོལ་བ་ཡིན་པས་ཡུམ་ཐེ་ཚོམ་གྱིས་མཛོ་མོ་བཏང་།",
    "དེ་འཕྲལ་དམག་མི་ཞིག་གིས་མ་ཡུམ་གྱི་ལག་པ་ནས་བཟུང་སྟེ་འཁྲིད་གྲབས་བྱས་པ་ལ།",
    "མས་མཛོ་མོ་བཟུང་ལ་ཤོག་དང་ངེད་ཚོ་འགྲོ་བྱས་པས་ཁོ་མཛོ་མོ་འཛིན་པར་སོང་།",
    "མཛོ་མོ་རི་རྩེར་སོང་བ་དམག་ལོག་འཕྲལ་མ་ཡུམ་གྱི་རྩར་བརྒྱུགས་ཏེ་འོངས།",
    "ཆུང་དུས་ནས་བྱིས་པ་རྣམས་ལ་བྱིའུ་ཕྲུག་སོགས་གསོད་པ་ལ་སྲོག་གཅོད་པའི་རྣམ་སྨིན་ངན་སོང་དུ་མྱོང་དགོས་ཚུལ་དང་།",
    "ཉིན་རེ་བཞིན་རྒོད་ཚང་ཉེ་འཁོར་ཤུག་ནགས་ཀྱི་དཀྱིལ་ན་བྲག་ཁུང་ཞིག་ཡོད་པ་དེར་ཚུལ་མཐུན་གྱིས་འཁོད་ནས་མ་ཎི་ཁྲི་ཚོ་གསུམ་རེ་ཆག་མེད་མཛད།",
    "གསུང་གི་བདུད་རྩི་ལ་ལོངས་སྤྱད།",
    "ལྕགས་སྤྲེལ་ལོར་གཅེན་འབྲིང་དཔལ་འབུམ་སྐྱབས་ཀྱིས་མི་ཞིག་བསད་པའི་རྐྱེན་གྱིས་གཙོས་སུ་སོང་།",
    "ཉིད་ཀྱང་རིམ་གྱིས་དེ་དང་ཉེ་བ་སྣ་བུག་ཏུ་རེ་ཞིག་བཞུགས།",
    "ཕྱི་ལོར་ལ་མོ་གྲགས་རྒན་པ་ལ་རྡོར་ཕྲེང་གསན།",
    "རྣལ་འབྱོར་གོས་ཚགས་མཐའ་ནས་བསྔམ་རེ་རན།",
    "རྣལ་འབྱོར་གཏན་གྱི་སོ་ནམ་བྱེད་རེ་རན།",
    "དེ་ལྟར་ཡིན་མོད་ཕྱི་མར་གདུལ་བྱའི་དོན་དུ་འབྱོན་པ་ལ་བཟང་སྤྱོད་མང་དུ་སྒྲུབ་དགོས་གསུངས།",
    "ཕྱོགས་ཕྱོགས་སུ་ཡིག་དྲུག་གི་རྒྱུན་མང་དུ་སྤེལ།",
    "མཁྱེན་བརྩེ་ནུས་པ་གཅིག་བསྡུས་སྤྱན་རས་གཟིགས།",
    "རྗེ་སྐལ་ལྡན་པའི་ཕྱག་བཞེས་བཞིན་ཐུགས་དམ་གྱི་གཙོ་བོ་དཔེ་གཟིགས་ལ་མཛད་པས་དུས་རྒྱུན་པོ་ཏི་ལྔ།",
    "དབུ་ཐོད་པདྨ་འདབ་བརྒྱད་ལྟར་གྱུར་པའི་ངོས་གཅིག་ལ་སྤྱན་རས་གཟིགས་བཅུ་གཅིག་ཞལ་གྱི་སྐུ་འབུར་དོད་སོགས་བྱོན་པ་ནང་སོ་ཀོ་ཤཱིས་བསྣམས་ཏེ་དགོན་ཆེན་དུ་མཆོད་རྟེན་བཞེངས།",
    "སྔོན་དགོན་རྙིང་གི་གཞི་དུང་དཀར་ཐང་ཟེར་བ་དེ་ན་དུང་དཀར་ཆུ་མིག་ཟེར་བ་ཡོད་པའི་སྟེང་དུ་བྱམས་ཁང་རྟེན་བརྟེན་པ་བཞེངས་ལ།",
    "བྱམས་ཁང་གི་མདུན་དུ་རྡོ་རིང་ཞིག་བཙུགས་ཡོད་པར།",
    "འགྲོ་སའི་གོང་ཁའི་ལམ་བཅས་ལས་གཡོར་མི་དགོས་ཞེས་བྲིས་འདུགདེ་ནས་རིམ་བཞིན་དམག་ཁང་ལས་ཤིང་མཁར་བརྩིགས་པའི་ཤུལ་ད་ལྟ་ཐོ་རྒྱའི་དབྱིན་ཧྥང་ཟེར་བའི་ཁང་ཤུལ་དེ་རེད།",
    "བཙན་ཁང་དུ་ལྷ་མོ་དང་།",
    "རྒྱ་ནག་ཏོ་བཀྭང་ཁྲི་ལོ་གཉིས་པའི་སྟེང་བཞེངས་པ་རེད།",
    "ཨ་རོལ་རྡོ་རྗེ་འཆང་གིས་བཙུགས་པའི་རྡུལ་ཚོན་ལ་བརྟེན་པའི་དུས་འཁོར་སྒྲུབ་མཆོད།",
    "ཨ་དཔོན་ཇག་དམག་གིས་མེ་ལ་བཏང་།",
    "ཨ་རོལ་རྡོ་རྗེ་འཆང་རྣམ་པའི་བཀའ་དྲིན་ལས།",
    "ཨ་རོལ་རྡོ་རྗེ་འཆང་གིས་གནང་བའི་ཐུབ་པ་དབྱར་གནས་མ།",
    "རེ་སྐོང་རྡོ་སྦིས་ལྷ་རམས་པ་ཤེས་རབ་རྒྱ་མཚོ།",
    "ཨ་རོལ་རྡོ་རྗེ་འཆང་གིས་ལྷ་མོ་མཚོའི་གྲམ་པར་ཆུ་མིག་ཏུ་ཕེབས་སྐབས་གཅོད་དཔོན་མཛད།",
    "ད་ལྟ་བསྟན་པ་ཡང་དར་གྱི་སྐབས་འདིར་ཡང་ཡརེ་ལྡན་དུ་འགྲོ་བཞིན་པ་ལགས།",
    "འདུ་ཁང་དང་མགོན་ཁང་རྟེན་བརྟེན་པ་གསར་བཞེངས་བྱས་དང་བྱེད་མུར་ཡོད་ལ་གྲྭ་ཚོགས་ཀྱང་བཅུ་ཕྲག་གསུམ་ལྷག་ལ་འབུད།",
    "སྐུ་རྒྱུ་སྤོས་འདམ་ལས་བྱས་པའི་ལྷ་མོའི་སྐུ་བརྙན་དབུས་ནས་གདན་དྲངས་པ་འགངས་ཆེན་ཞིག་བཞུགས་ཤིང་འཕྲིན་ལས་མྱུར་མགྱོགས་ཆེ།",
    "ཁོང་གིས་འདིའི་གྲྭ་བ་བཙུན་ཆུང་རྣམས་ལ་འཚེ་བའི་བགེགས་ཀྱི་རལ་བ་ནས་བཟུང་སྟེ་ཕྱིར་ཕྱུང་བའི་སྐྲའི་ལན་བུ་ཞིག་ཀྱང་འདིར་ཡོད་པར་གྲགས།",
    "ཀུན་གཟིགས་འཇིགས་མེད་པཎྜི་ཏས་ཀྱང་།",
    "དུས་ཆེན་ནམ་ཡོད་ལ་མཆོད་རྡུང་གི་སྒྲ་གྲགས་པའི་མཆོད་རྟེན་ཆེན་པོ་ཞིག་ཀྱང་ཡོད།",
    "གསང་འདུས་ཁང་ཟེར་བའི་འདུ་ཁང་དུ་གསང་འདུས་སྒྲུབ་མཆོད་ལོ་རེར་ཚུགས་དགོས་པ་དང་།",
    "ཐིག་མོ་ཆ་ཀའི་གྲྭ་རྒྱུན་དང་དངོས་རྫས་ཡོད་པ་སོགས་ལ་དཔག་ན་ཐིག་མོ་དགོན་ཐོར་རྗེས་དགོན་གོང་འོག་ཏུ་བགོས་པར་གྲགས་པ་བདེན་པར་ངེས།",
    "ཁོང་གི་ན་བཟའི་སྟེང་བཞེངས་པའི་རྣམ་སྲས་རྟ་བ་བརྒྱད་སོགས་གནང་བ་བཞུགས།",
    "སེང་ཁྲི་རྒྱབ་ཡོལ་ཁྲི་དྲུག་འགྱོགས་གིས་བརྒྱན་ཅིང་།",
    "ཅེས་གསུང་གི་ཕེབས་སྒོ་གནང་ཞིང་།",
    "དབྱངས་སྙན་རོལ་མོ་ལྟར་འཁྲོལ་ལེགས་བྱས་ཀྱི།",
    "ཞེས་བསྔགས་པ་སྙན་ངག་གིས་འུར་བསྟོད་ཙམ་མ་ལགས་སོ།",
    "ཁོང་གིས་ཕྱག་མཛུབ་ཀྱིས་དགུ་འདི་ནས་སོང་ཆོག་ཅེས་བསྟན་པ་ལྟར་དུ་བཞུར།",
    "བྱམས་ཁང་ཁྱམས་རའི་རྒྱལ་ཆེན་བཞིའི་གྱན་ཐང་གི་བྲིས་རྒྱུན་ནི་ཛམ་ཐང་ལྷ་བཟོའི་རྒྱུན་ཡིན་ལ་ཕྱོགས་འདིར་ཁོང་རྡོ་རྗེ་འཆང་འཇིགས་མེད་ཞབས་ཀྱི་དྲིན་ལས་སྤེལ་ནུས་བྱུང་ངོ།",
    "དུས་བཞིར་ཁོང་རྣམ་པ་བཞིས་མཆོད་འབུལ་ཐེངས་གཉིས་རེ་མ་ཆད་པར་འབུལ་དགོས།",
    "རི་དྭགས་ཕོ་མོ།",
    "ཀ་སུ་ལེན་ཇག་དམག་གིས་མ་བཅོམ་གོང་དུ་གྲྭ་བ་སུམ་བརྒྱ་ལྷག་འདུས།",
    "བྲག་དཀར་སྔགས་རམས་པའི་ལྷ་མོའི་རྟེན་ཐང་གདན་དྲངས་ཏེ་ཁོང་རྣམ་པ་སུམ་ཅུས་ཉིན་བདུན་ལ་སྒྲུབ་པ་བྱེད་དགོས་ཀྱི་སྲོལ་ཡོད་པ་དེ་ཡང་ཐིག་མོ་དགོན་གྱི་ཕྱག་ལེན་ཡིན།",
    "ཨ་རོལ་རྡོ་རྗེ་འཆང་བློ་བཟང་ལུང་རྟོགས་བསྟན་པའི་རྒྱལ་མཚན།",
    "འཇམ་མགོན་ཡོངས་འཛིན་ཤེས་བྱ་ཀུན་གཟིགས་བློ་བཟང་དཔལ་བ་སོགས་ཀྱིས་རྗེས་སུ་ཡང་ཡང་བཟུང་ཞིང་།",
    "ཁྱེད་པར་གསེར་ལྗོངས་ཞིང་གི་བསྟན་པའི་བདག་པོ་སྐྱབས་མཆོག་བདུན་པ།",
    "ཀུན་གཟིགས་རྡོ་རྗེ་འཆང་དེ་ཉིད་ཀྱིས་སྔ་ཕྱི་ཅི་རིགས་སུ་རྗེ་ཡབ་སྲས་གསུམ་གྱི་བཀའ་འབུམ།",
    "སྐྱབས་མགོན་སྐུ་ཕྲེང་གི་བཀའ་འབུམ་བཅས་ཀྱི་བཀླགས་ལུང་དང་།",
    "ཁོང་ཞི་བར་གཤེགས་པ་ལ་ཉེ་སྐབས་ཐིག་མོ་ནས་བཟུང་ཁྱོགས་ཀྱི་ནང་ནས་མགུར་དབྱངས་དང་བཅས་ཏེ་གཟིམ་ཁང་ལ་ཕེབས་ནས་ཞག་བཞུགས་མཛད།",
    "ཁྱོད་ཚོས་ཁང་བ་ལས་པ་འདིའི་ནང་དུ་ཁོ་བོ་སྡོད་མ་ཐུབ་པ་ལ་འགྱོད་པ་མ་བྱེད།",
    "ཁོ་བོ་ཡར་མར་དུ་འགྲོ་དུས་སྒོ་དམར་གྱི་ཕྱོགས་ནས་བགྲོད་བདེ་མོད།",
    "ལྷ་བྲིས་པ་ཆེན་པོ་རྒྱ་མཚོས་སྐྱ་རིས་བཏབ་སྟེ་བྱམས་སྐུ་ཆེན་མོ་བཞེངས།",
    "གོས་སྐུ་ཆེན་མོ་སོགས་རྟེན་བརྟེན་པ་མང་བོ་གསར་དུ་བསྐྲུན་ལ།",
    "མགོ་རྒྱན་བྱི་རུའི་པོ་ཐོའུ་ཡང་ལྷ་སའི་བུད་མེད་ཚོའི་མགོ་རྒྱན་སྤ་དྲུག་ཟེར་བའི་དབྱིབས་ཇི་ལྟ་བུ་ཡིན་པ་དང་།",
    "ཡིག་རྙིང་འགར་ལྗོངས་འདིར་རེབ་ཀོང་ཞེས་འབྲི་ཚུལ་ཞིག་ཡོད་པ་ཡང་ཀོང་བོའི་རིགས་རུས་ཡོད་པས་དེ་ལྟར་བྱུང་བར་གྲགས་སོ།",
    "ནག་པོར་སྣང་ཚད་བུང་ནག་ཡིན་པ་ལྟ་བུར་སོང་མཆི་སྟེ།",
    "ཐིག་མོ་དགོན་བཀྲ་ཤིས་རབ་བརྟན།",
    "གྲྭ་ཤག་མང་ཆེ་བར་ལྷ་ཁང་རེ་ཡོད།",
    "དེ་ནས་ཇེ་རྒྱས་སུ་སོང་བ་ན་འདུ་ཁང་ཀ་བ་གོ་དྲུག་ཅན་ཞིག་བཞེངས།",
    "འདུ་ཁང་གིས་མེ་བཞེས་རྗེས་སུ་སླར་ཡང་ད་ལྟའི་འདུ་ཁང་ཀ་བ་གོ་དྲུག་མ་འདི་བཞེངས།",
    "གོས་སྐུ་ཆེན་མོ་སྲིད་དུ་ཁྲུ་༨༤ ཡོད་པ།",
    "ཨ་རོལ་རྡོ་རྗེ་འཆང་བློ་བཟང་ལུང་རྟོགས་བསྟན་པའི་རྒྱལ་མཚན་གྱིས་གནང་བའི་ཙན་དན་གྱི་ཀུན་རིག་དང་རྣམ་སྲས་མེ་ཐུབ་མ།",
    "རྗེ་འཇིགས་མེད་རྡོ་རྗེ་འཆང་གི་བཀའ་འབུམ་གཙོ་བྱས་བཀའ་བསྟན་གསུང་འབུམ་སོགས་སྐུ་གསུང་ཐུགས་རྟེན་གྱིས་འདུ་ཁང་སྟེང་འོག་ཇོ་ཁང་མགོན་ཁང་རྣམས་བྱུར་བུར་གཏམས་སོ།",
    "བཅུ་གཅིག་པའི་སྒྲུབ་མཆོད་འཇིགས་མེད་རྡོ་རྗེ་འཆང་གིས་ཀ་རིང་ལ་བཙུགས་པའི་སྲོལ་ལྟར།"
  ]
}