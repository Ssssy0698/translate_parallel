    "སྒྲུབ་གནས་བརྒྱད་སོགས་དབེན་གནས་མང་བོ་ནས་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་ཉམས་བཞེས་ལ་བརྩོན་པས་བཞུགས་ནས་བསྐུལ་བསྐྱོད་ཙམ་ཡང་མ་མཛད་པ་ལྟ་བུའི་ཏིང་འཛིན་གྱི་ངང་ལ་རོལ།",
    "ཡ་མ་རཱ་ཛ་དུང་ཕྱུར་བགྲངས་པས་མཚོན་ཐུགས་དམ་གྱི་ལྷ་རེ་རེའི་སྔགས་གྲངས་མང་བོ་ལྗགས་བཟླས་གནང་ཞིང་།",
    "རྟོགས་པས་ཡན་ཐུབ་པ་ཟེར་བའི་ཉམས་རྟོགས་མངོན་དུ་གྱུར་པས་གང་སྣང་བདེ་སྟོང་གི་རྒྱས་ཐེབས་ནས་ཟླ་མལ་གྱི་སྣང་བ་རང་འགགས་སུ་སོང་།",
    "བླ་བྲང་ཆེན་མོ་ནོར་བུ་གྲུ་འཛིན་དུ་བཞུགས་སྐབས་དཀོར་གཉེར་གྱིས་ཕྱག་དཔེ་འདི་དག་གདན་སྟེང་ན་བཞུགས་འདུག་ཞུས་པར།",
    "འོ་ཁྱོད་ལ་གདན་དུ་སྣང་བ་རེད་ཨང་།",
    "གསུངས་ནས་འགྲམ་ལྕག་བཏང་སོང་བ་སོགས་ལྷའི་ང་རྒྱལ་དང་གསལ་སྣང་འབྱོངས་པའི་རྟགས་སུ་འཁུམས།",
    "སྟོང་བ་དང་རྟེན་འབྱུང་གི་འགྲོ་ཕྱོགས་གོ་བ་གལ་ཆེ།",
    "ང་ལྟ་བུ་འཕྲུལ་འཁོར་སྒྲུབ་པ་པོའི་རྟེན་གྱི་གང་ཟག་མ་རེད།",
    "ཚད་ལྡན་ཞིག་ཡིན་པ་རེད་ཅེས་གསུངས།",
    "ང་མངོན་ཤེས་ཀྱིས་གཟིགས་པ་ངོ་མཚར་མཛད་པ་རྣམས་བགྲང་བས་མི་ལང་ལ་དཔེར་ན།",
    "དུས་འཁྲུག་གི་སྡོན་ཞིག་མཆོད་རྟེན་སྐྱེད་དང་།",
    "ཀ་ཞར་སྔགས་མང་མ་མཐུན་པར་གྲྭ་ཚང་གིས།",
    "དེ་ཡོད་ན་ལག་ཏུ་འཇོག་རྒྱུ་རེད་ཨང་གསུངས།",
    "རྗེ་འདིས་དུས་ཟིང་གིས་དགོན་གྲོང་ལ་ཉམས་ཆག་བྱུང་སྐབས་ཞལ་ནས།",
    "ད་རེས་འདོན་མི་ཉན་པ་དེ་མ་བཏོན་པ་དང་།",
    "ཁྱོད་ཚོས་ཅི་འདྲ་ཞིག་ཐོས་ཨང་།",
    "མགོ་ལ་ཅི་འདྲ་ཡོང་རྒྱུ་རེད་ཨ་ཧ་བོ།",
    "ཕྱག་ནས་གཏོར་བ་དང་ས་ཚྭ་རེ་གནང་བས་ཀྱང་ཆུ་སྣ་བཟློག་པ་སོགས་ཀྱི་མཚན་གཞི་སྨོས་པས་མང་ལ།",
    "ཁོ་ཚེ་རྡོ་རམས་པའི་ཉེ་གནས་ཡོན་ཏན་དར་རྒྱས་སོགས་ལས་རྩིས་ཀྱི་ལག་ལེན་རི་མོའི་མཛུབ་ཁྲིད་དང་།",
    "ཁྲི་རྒྱ་ནག་པའི་ཡང་སྤྲུལ་སོགས་གོང་མའི་ལས་ལུང་གིས་མཐོ་བའི་བུ་ཆེན་རྣམ་གསུམ།",
    "རེ་སྐོང་མག་སར་ནས་འཁྲུངས།",
    "རེ་སྐོང་སྟོད་ཀྱི་རྟིས་ཚང་ནས་འཁྲུངས།",
    "གཞོན་དུས་ནས་དགེ་ལ་ངང་གིས་གཞོལ།",
    "རེ་ཞིག་ན་རྗེ་མ་ཎི་བ་ཤེས་རབ་བཀྲ་ཤིས་འདི་ཉིད་ཀྱི་དབོན་རིགས་སུ་འཁྲུངས་པ་དགུང་ལོ་བཅུ་གསུམ་པ་ལ་རབ་བྱུང་གི་སྡོམ་བསྩལ།",
    "ཡི་གེ་ཨ་མིང་བདག་ཉིད་ཆེ།",
    "ཡོངས་འཛིན་ཐམས་ཅད་མཁྱེན་པ་ལ་སྒོ་ཀུན་ནས་རྗེ་བཙུན་འཇམ་པའི་དབྱངས་དངོས་ཀྱི་གཟིགས་པ་རྒྱུན་འཇགས་ཀྱིས་སྐུ་ཚེ་གང་བོར་མཉམ་འགྲོགས་ཀྱི་ཚུལ་དུ་བསྟེན་ཏེ་གཞན་གྱིས་དཔག་པར་དཀའ་བའི་བཀུར་བཟོ་གནང་བ་ལ་རྗེ་འདི་ལྟ་བུ་དཀོན་པ་ཡིན་ནོ།",
    "སྙིགས་མའི་སྐྱ་རེངས་འོད་ཀྱིས་རེག་པ་ཡིས།",
    "རྒྱལ་ཀུན་སྤྱི་གཟུགས་ཉི་མ་ཁྱོད་གཅིག་ཤར།",
    "རིག་པའི་གནས་ཆེན་པོ་བཅུ་ཞེས་ཡོངས་སུ་གྲགས་པའི་ཕྱོགས་གཏོགས་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་གཏིང་མཐའ་ཕྱག་མཐིལ་གྱི་རྫས་བཞིན་གཟིགས་པའི་སྦྱངས་འབྲས་ཀྱི་ཉི་མ་མཁའ་ལ་ཤར་ཞིང་།",
    "དོན་འགངས་སོགས་ཤུགས་འབྱུང་གིས་འཇོ་བ་བསམ་དུ་མེད་པ་རང་ཡིན་ལ།",
    "བཀླགས་ལུང་གང་གནང་གསུང་གདངས་ཀྱིས་ཡིད་འགུགས་ཤིང་ཤིན་ཏུ་མྱུར་ཡང་ཆད་ལྷག་གི་སྐྱོན་དང་བྲལ་བ།",
    "གང་གི་ཡོན་ཏན་མཐོང་བ་ཡིས།",
    "ཁྱོད་ལས་མ་ཐོས་སྐལ་བ་ཞན།",
    "རྗེས་སུ་སོང་བ་ཇི་བཞིན་དུ།",
    "བདག་གི་ཡིད་ནི་གཏོང་མི་བྱེད།",
    "ཅེས་གསུངས་པ་ལྟར་བདག་ལྟ་བུར་སྐུ་དངོས་ལས་གསུང་གི་བདུད་རྩི་ཐོབ་པའི་སྐལ་བ་མ་བྱུང་ན་ཡང་།",
    "དེ་ཡང་དེ་དུས་སེམས་སེམས་བྱུང་གི་རྣམ་གཞག་གསུངས་པའི་བབ་ཁོ་ནར་དཔག་ཀྱང་དེ་དུས་ནས་སྐུ་ཡོན་གྱི་རྩལ་རྫོགས་ཟིན་པ་ཅིས་མི་ཤེས།",
    "མཁས་གྲུབ་སུས་ཀྱང་བགྱིས་པ་ལྟ་ཞོག་གི།",
    "གཉིད་མཚོར་ཕྱིན་པའི་རྨི་ལམ་ལྟད་མོ་ཡང་།",
    "ཉམས་སུ་མ་མྱངས་ལས་དེ་བདག་གིས་གྲུབ།",
    "དྲང་ངེས་ཆེན་མོ་པོད་གཉིས་མ།",
    "ལམ་རིམ་ཆེན་མོའི་བསྡུས་དོན་དང་ས་གཅོད་རྒྱས་པ།",
    "ཟ་འོག་གི་སྐུ་འགགགོས་བཟང་ལྷ་དར་སོགས་གནང་སྐྱེས་མང་བོ་དང་བཅས་ཏེ་ཞལ་ནས།",
    "སྙན་ངག་གི་བསྟན་བཅོས་ཆེན་མོ་རིགས་ལྡན་ཉེར་ལྔ་བའི་རྟོགས་བརྗོད།",
    "ད་དུང་གཞུང་ཆེན་མོའི་དཀའ་འགྲེལ་རྣམས་བསྡོམས་ན་ཤོག་གྲངས་བཞི་བརྒྱར་བརྒལ་བ་དང་།",
    "ལམ་རིམ་བརྗེད་བྱང་ཆེན་མོ་སོགས་བསྟན་བཅོས་སུ་མཛད་ཟིན་རྣམས་གསུང་འབུམ་དུ་འཁོད་ན་པོད་སུམ་ཅུ་ལྷག་བཞུགས།",
    "རྒྱུད་འཆད་སྐབས་ཉེ་བར་མཁོ་བ་རྣམས་ཀྱང་སྨད་རྒྱུད་ཕྱག་ལེན་བཞིན་ཆ་ཚང་བར་བསྣམས་པ་འདི་ཙམ་ཡང་བསྟན་པ་འཛིན་པར་ཁས་འཆེ་བ་དག་གིས་འགྲན་པར་བཟོད་པ་མ་ཡིན་ནོ།",
    "དུས་ཀྱི་འཁོར་ལོའི་སྦྱོར་དྲུག་གི་བར་མཛུབ་ཁྲིད་ཉི་ཤུ་ཙམ་གསན་པ་མཐའ་དག་གདུལ་བྱའི་ཆེད་དུ་ཇི་ལྟར་བསྩལ་བ་ནི།",
    "བཀའ་བསྟན་གྱི་བཀླགས་ལུང་ཚར་རེ།",
