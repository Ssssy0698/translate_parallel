    "རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ལ་བདག་མེད་མའོ།",
    "ཐམས་ཅད་ཀྱི་མགོ་བོར་ཡི་གེ་ཨོཾ་གྱིས་སྐུ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "མགྲིན་པར་ཡི་གེ་ཨཱ་ཡིས་ངག་བྱིན་གྱིས་བརླབ་པའོ།",
    "རྣམས་ཀྱི་མཚམས་ན་བཞུགས་རྣམས་ལའོ།",
    "དེས་དེ་རྣམས་ཡོངས་སུ་ལོངས་སྤྱོད་ཅིང་ཚིམ་པར་བལྟའོ།",
    "བདག་ཉིད་དང་དེ་རྣམས་ཀྱི་ཕུང་པོ་ལ་སོགས་པ་རྣམ་པར་དག་པ་དང་།",
    "ཡོངས་སུ་བསྔོ་བའི་མཐར་ཐུག་པར་བྱའོ།",
    "གཏོར་མ་ཡང་འདིས་སྦྱིན་པར་བྱ་སྟེ།",
    "བདག་མེད་མ་སྒྲུབ་པའི་ཐབས་རྒྱས་པར་བསྟན་པ།",
    "གཡས་པར་གྲི་གུག་འཇིགས་ཆེན་མ།",
    "གཡས་པ་མིན་པར་ཁ་ཊྭཱཾ་ག།",
    "རྣམ་པར་ཕུག་པས་སྦྱོར་ལྡན་པ།",
    "དཔའ་གཅིག་མའི་སྒྲུབ་པའི་ཐབས་བསྐྱེད་པ་དང་རྫོགས་པར་ལྡན་པ་ཞེས་བྱ་བ་སློབ་དཔོན་བསོད་སྙོམས་པ་སྒྲ་གཅན་འཛིན་གྱིས་མཛད་པ་རྫོགས་སོ།",
    "ཞེས་བྱ་བ་ལན་གསུམ་བརྗོད་པས་ཕྱག་བྱས་ནས།",
    "ལྷའི་བདེ་བ་རྒྱུན་མི་འཆད་པར་འདོད་པའི་དགའ་བ་དང་།",
    "ཡིད་ལ་འང་བདག་མེད་མ་སྟེ་དེའི་བདག་ཉིད་དུ་བསམ་པར་བྱའོ།",
    "མགྲིན་པར་ཨཱ་འོ།",
    "འགྲོ་རྣམས་ཀྱིས་ཀྱང་ཐོབ་པར་ཤོག།",
    "དེ་བཞིན་དུ་ཐུན་གཞན་ལ་ཡང་ལྷའི་གཟུགས་ཀྱིས་གནས་པར་བྱའོ།",
    "ཉལ་བའི་དུས་སུ་ཡང་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་མངོན་སུམ་དུ་བྱས་ལ་ཉལ་བར་བྱའོ།",
    "དེ་ནས་རྒྱུད་ནས་ཇི་སྐད་བསྟན་པ་བཞིན་བསྒྲུབ་པར་བྱའོ།",
    "དབེན་ཞིང་འཚེ་བ་མེད་པའི་བསམ་གཏན་གྱི་ཁང་པར་ཞུགས་ལ།",
    "དབུས་སུ་གཉེར་མ་གསུམ་པ་གཅེར་བུ་རྒྱས་ཤིང་སྐབས་ཕྱེད་པའི་འཕོངས་ཀྱི་ཆ་ཅན་གར་དགུའི་རོ་དང་ལྡན་པ་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་གྱིས་མནན་པ་འགྱིང་ཞིང་རོལ་པར་ལྡན་པ་ལེགས་པའི་ན་ཚོད་ཅན།",
    "གཡས་པའི་ཁྱིམ་ཡང་ཟླ་བ་ཕྱེད་པའི་རྣམ་པ་ཐུགས་ཀྱི་རྡོ་རྗེའི་ལྕུག་ཕྲན་སྐྱེད་པར་བྱེད་པའི་ཨིནྡྲ་ནཱི་ལ་ལྟ་བུའོ།",
    "གཡོན་གྱི་གྲྭར་ཡང་དག་པར་འདོད་པའི་འབྲས་བུ་བསྐྱེད་པ་ཅན་ནོ།",
    "འོག་གཞིའི་རྩིབས་དང་ལྡན་པ་ནི་མྱ་ངན་མེ་དང་རྒྱ་སྐྱེགས་ཤིང་དང་ཀུ་སུ་མའི་མེ་ཏོག་ལྟ་བུ་ལ་ཤིང་རྟའི་ཡན་ལག་ཅན་གྲུ་གསུམ་པར་སྣ་ཚོགས་རྡོ་རྗེ་ལ་ཆུ་སྐྱེས་ཀྱི་ཟེའུ་འབྲུར་ཟླ་བའོ།",
    "འབར་བས་བསྲེག་པའི་རྣམ་པར་འཁྲུགས་པར་བྱ་སྟེ།",
    "དེ་ནས་རྣལ་འབྱོར་མའི་མཚན་ཉིད་གང་དུ་གསུངས་པས་ཇི་ལྟ་བུའི་བསྲུང་བའི་སྔགས་བྱ་སྟེ།",
    "དེ་ཡང་མེའི་འཁོར་ལོ་གྲུ་གསུམ་པ་དེའི་ནང་དུ་པདྨ་འདབ་མ་བཞི་པ་བསམ་པར་བྱའོ།",
    "དེའི་རྗེས་ལ་དབུས་ཀྱི་ཐིག་ལེ་ལས་རྣམ་པར་སྤྲོས་ཏེ་དྲི་མ་མེད་པའི་བརྒྱད་ཀྱི་ཕྱེད་ཀྱི་འོད་ཟེར་ལྕགས་ཀྱུ་རྣམས་ཀྱིས་ཕྱོགས་ཀྱི་ཐིག་ལེ་བཀུག་པ་རྣམས་ཀྱང་དབུས་ཀྱི་ཐིག་ལེ་ལ་ཞུགས་པར་བལྟ་བར་བྱའོ།",
    "སྐྱེད་པར་བྱེད་པའི་མེ་ལྟར་བདེ་བ་སྐྱེད་པར་བྱེད་པའོ།",
    "དེ་ནས་དེའི་སྦྱོར་བ་ལས་སྐྱེས་པ་ནི་འབར་ཞིང་དགའ་བ་ལས་བསྐྱེད་པ་སྐྱེ་བ་ཅན་ལྟ་བུའི་རྒྱལ་བ་རྣམས་དོན་དམ་པའི་ཡེ་ཤེས་ཀྱི་ཐིག་ལེ་རྣམ་པར་བསམ་པར་བྱའོ།",
    "དགའ་བ་དང་རྗེས་སུ་མཐུན་པའི་ཚུལ་གྱིས་འབབ་ཅིང་རྗེས་སུ་འགྲོ་བའི་ཐིག་ལེའི་གཟུགས་ཅན་དགའ་བའི་འདོད་པ་བསྟེན་པར་བྱའོ།",
    "དེ་ཡང་དེའི་སྦྱོར་བ་ལས་ཡང་དག་པར་བྱུང་བའི་བདེ་བའི་བདུད་རྩི་མྱངས་པ་བཅུད་དང་།",
    "དབྱངས་ཡིག་དེ་དག་ཀྱང་འོད་གསལ་བ་བདུད་རྩིའི་ཆར་བབ་པར་བསམ་པར་བྱའོ།",
    "ནཱ་ད་རིང་པོ་ལེགས་པའི་དབྱངས་ཡིག་རྣམ་པར་བསམ་པར་བྱའོ།",
    "དེ་ནས་མཚན་ཉིད་ཇི་ལྟ་བ་བརྗོད་པའི་སྔགས་པས་སྔར་གསུངས་པའི་བྱ་བ་ཐམས་ཅད་བྱ་སྟེ།",
    "གཞན་གྱི་རྣལ་འབྱོར་མ་རབ་ཏུ་འཇུག་པ་ཡང་འགོག་ཅིང་རྣམ་པར་རྟོག་པ་ཉུང་བ་མ་ཡིན་པ་ཟད་པར་བྱེད་དེ།",
    "དེ་ཡང་ཡིད་ཆགས་པར་གྱུར་པ་དང་བདེ་བའི་འཁོར་ལོ་ནམ་མཁར་གནས་པའི་ངང་པ་ཕྱེ་མ་ལེ་བ་ལྟར་ལེགས་པར་སྣུམ་ཞིང་མར་ཁུའི་མེར་སྣང་བའི་སྲེད་པས་བལྟ་བ་དང་ཆགས་པས་ཞུ་སྟེ་དེར་ཐིམ་པར་རྣམ་པར་བྱའོ།",
    "བསྒོམས་པའི་སྟོབས་ཀྱིས་ཀྱང་དོན་དམ་པར་མངོན་སུམ་དུ་བྱེད་དོ།",
    "ཞེས་བྱ་བ་རྣམ་པར་བསྒོམས་ལ།",
    "དེ་ནས་དེས་ཤིན་ཏུ་ཡང་འབར་བ་དང་འཇིག་རྟེན་གསུམ་ཡང་བསྲེགས་པར་བསམས་ཏེ།",
    "དེའི་སྟོབས་དེ་ལྟ་བུས་བདུད་རྩིའི་རང་བཞིན་རི་བོང་ཅན་དུ་དེ་མ་ཐག་ཏུ་ཞུ་བར་གྱུར་པས་རྒྱུན་གྱི་རྣམ་པར་བླུགས་པར་བསྒོམས་ལ།",
    "རྣམ་པ་སྣ་ཚོགས་ལ་སོགས་པའི་སྐད་ཅིག་མའི་ཁྱད་པར་ལས་སོ།",
    "མངོན་དུ་བྱས་པ་དང་།",
    "དེས་བདག་ཏུ་བྱས་པ་དང་།",
    "དེ་བསམས་པ་དང་རྟོག་པ་མེད་པར་བྱའོ།",
