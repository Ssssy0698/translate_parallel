    "ཉོན་མོངས་པའི་སྒྲིབ་པ་འབའ་ཞིག་ལས་རྣམ་པར་གྲོལ་བའི་མ་ཁྱབ་པའི་ཕྱིར་ཏེ།",
    "འབའ་ཞིག་གིས་སྒྲས་སྙོམས་འཇུག་གི་སྒྲིབ་པ་གཅོད་རྒྱུ་ཡིན་པའི་ཕྱིར་དང་།",
    "དགྲ་བཅོམ་པ་ཡིན་ན་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་ཀྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་བས་ཁྱབ་པའི་ཕྱིར་ཏེ།",
    "བདག་མེད་རྟོགས་པའི་ཤེས་རབ་ཀྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་ན།",
    "དེ་ལ་ཁོ་ན་རེ།",
    "ཅིག་ཅར་བའི་དགྲ་བཅོམ་པ་ལ་ཤེས་རབ་རྐྱངས་པའི་རྣམ་གྲོལ་གྱིས་ཁྱབ་པར་ཐལ།",
    "ཅིག་ཅར་བའི་དགྲ་བཅོམ་ཐོབ་མ་ཐག་པ་དེས་ནམ་ཏིང་ངེ་འཛིན་གྱིས་སྙོམས་འཇུག་གི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་བའི་ཚེ་འགོག་སྙོམས་ཐོབ་སྟེ་གཉིས་ཀའི་ཆ་ལས་རྣམ་གྲོལ་གྱི་དགྲ་བཅོམ་དུ་འཇོག་པའི་ཕྱིར་རོ།",
    "ཁམས་གསུམ་གྱི་འདོད་ཆགས་དང་བྲལ་བ་དག་གིས་ཀྱང་།",
    "གང་ཞིག་བསམ་གཏན་དང་པོའི་ཉེར་བསྡོགས་ཙམ་ལ་བརྟེན་ནས་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་ཀྱི་སྟོབས་ཀྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པ་འབའ་ཞིག་ལས་རྣམ་པར་གྲོལ་བ་དེ་ནི་གཉིས་ཀའི་ཆ་ལས་རྣམ་གྲོལ་ལས་ཅིག་ཤོས་ཤེས་རབ་ཀྱིས་རྣམ་པར་གྲོལ་བ་སྟེ།",
    "ཁམས་གསུམ་གྱི་འདོད་ཆགས་དང་བྲལ་བ་དག་གིས་ཀྱང་ཞེས་པའི་ཚིག་ཟིན་རང་གིས་ཤེས་པའི་ཕྱིར།",
    "སྲིད་མཐའ་ཙམ་ནི་སུ་ཞིག་གིས་འགོག་མི་ནུས་ཀྱང་།",
    "ཁམས་གསུམ་གྱི་འདོད་ཆགས་དང་བྲལ་བ་དག་གིས་ཀྱང་ཞེས་པའི་ལུང་གི་གནོད་པ་སྤོང་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དངོས་བསྟན་ལ་བསམ་ནས་ཤུགས་བསྟན་དོར་བར་བྱ་མི་རིགས་པ་རང་རེ་མཁས་གྲུབ་ཆེན་པོའི་དགོངས་པར་མ་ཟད།",
    "བསམ་གཏན་དང་པོའི་སྙོམས་འཇུག་གིས་འཇིག་རྟེན་པའི་སྒོམ་སྤང་དུ་གྱུར་པའི་འདོད་ཉོན་ལ་ཆགས་བྲལ་སྔོན་དུ་མ་བཏང་བར་བསམ་གཏན་དང་པོའི་ཉེར་བསྡོགས་མི་ལྕོགས་མེད་ལ་བརྟེན་ནས་ཁམས་གསུམ་གྱི་སྒོམ་སྤང་ཉོན་མོངས་སྤོང་བ་དེ་སྔ་མའི་ངོ་བོ་དང་།",
    "མཁས་གྲུབ་ཆེན་པོ་རྣམ་གཉིས་ཀྱི་གསུང་གི་ཞབས་འདེགས་ཀྱི་ཚུལ་དུ་བཀོད་ནས་དཀྱུས་ཀྱི་དོན་ལ་འཇུག་པ་ནི།",
    "ཆགས་བྲལ་སྔོན་སོང་གི་ཕྱིར་འོང་ལ་ཞུགས་པ་དང་།",
    "ཆགས་བྲལ་སྔོན་སོང་གི་ཕྱིར་མི་འོང་ལ་ཞུགས་པ་གསུམ་ལས།",
    "འདོད་པའི་སྒོམ་སྤང་ཉོན་མོངས་གཅིག་ཀྱང་མ་སྤངས་པའི་འཆིང་བ་ཀུན་ལྡན་ནས་ལྔ་པ་ཙམ་གྱི་བར་སྤངས་པའི་ཉན་ཐོས་མཐོང་ལམ་པ་རྣམས་རྒྱུན་ཞུགས་ལ་ཞུགས་པ་ཞེས་བྱ་སྟེ།",
    "དགུ་པ་ཚུན་ཆད་དེ་བརྒྱད་པ་ཙམ་གྱི་བར་སྤངས་པའི་ཉན་ཐོས་མཐོང་ལམ་པ་རྣམས་ནི་ཆགས་བྲལ་སྔོན་སོང་གི་ཕྱིར་འོང་ལ་ཞུགས་པ་དང་།",
    "འདོད་ཉོན་དགུ་པ་སྤངས་པ་ནས་ཅི་ཡང་མེད་མན་ཆད་ཀྱི་ཉོན་མོངས་སྤངས་པའི་ཉན་ཐོས་མཐོང་ལམ་པ་རྣམས་ནི་ཆགས་བྲལ་སྔོན་སོང་གི་ཕྱིར་མི་འོང་ལ་ཞུགས་པ་ཞེས་བྱའོ།",
    "ཆགས་བྲལ་སྔོན་སོང་ནི་ཕྱིར་འོང་དང་ཕྱིར་མི་འོང་གཉིས་ལ་མ་གཏོགས་རྒྱུན་ཞུགས་དང་དགྲ་བཅོམ་པ་གཉིས་ལ་མེད་དོ།",
    "དེ་ལ་ཁོ་ན་རེ།",
    "རྒྱུན་ཞུགས་ལ་ཆགས་བྲལ་སྔོན་སོང་ཡོད་པར་ཐལ།",
    "དེ་ཙམ་གྱིས་ཆགས་བྲལ་སྔོན་སོང་གི་མིང་མི་འཐོབ་ཅིང་།",
    "མཐོང་ལམ་ལ་གནས་པའི་ཞུགས་པ་དེ་དག་རང་རང་གི་འབྲས་བུ་གང་ཐོབ་ཕྱིར་དུ་བརྩོན་པ་ལ་ཞུགས་ནས་ནི་བཅུ་དྲུག་པ་ལམ་རྗེས་ཤེས་ཐོབ་པ་དེའི་ཚེ་ན་རྒྱུན་ཞུགས་སོགས་རང་རང་གི་འབྲས་བུ་ལ་གནས་པ་ཡིན་པས།",
    "ཆགས་བྲལ་སྔོན་སོང་གི་ཞུགས་པ་སྐད་ཅིག་བཅོ་ལྔ་པ་ལ་གནས་པ་དང་།",
    "རང་གི་སྤང་བྱ་སྒོམ་སྤང་ཉོན་མོངས་སྤངས་པའི་སྤངས་པ་ལ་ནི་ཁྱད་པར་མེད་དེ།",
    "དེ་ལ་ཁོ་ན་རེ།",
    "དེ་གཉིས་སྤངས་པ་ལ་ཁྱད་པར་ཡོད་པར་ཐལ།",
    "རང་རང་གི་འབྲས་བུ་ལ་གནས་པ་ཙམ་ལས་འབྲས་བུ་གོང་མ་ཐོབ་ཕྱིར་དུ་བརྩོན་པ་ལ་ཞུགས་པ་མ་ཡིན་པའི་ཕྱིར།",
    "ཕྱིར་མི་འོང་ཞུགས་འབྲས་གཉིས་ཏེ་དྲུག་གི་སྟེང་དུ།",
    "དེ་ནས་སྒོམ་ལམ་ཟག་བཅས་ཟག་མེད་གང་རུང་གིས་སྒོམ་སྤང་རྣམས་རིམ་གྱིས་སྤངས་ཏེ་འབྲས་བུ་བཞི་རིམ་གྱིས་ཚང་བར་ཐོབ་པའོ།",
    "དེ་ལ་ཡང་འབྲས་བུ་རིམ་གྱིས་པ་ནི་ཡོད་མོད།",
    "འོན་ཀྱང་གོང་གི་འགྲེལ་པས་ནི་གང་ཟག་གང་གིས་འབྲས་བུ་བཞི་ལས་རིམ་གྱིས་བརྒྱུད་ནས་ཇི་ཙམ་ཐོབ་པ་ཡོད་པར་བསྟན་པ་ཡིན་ན།",
    "དགྲ་བཅོམ་ཞུགས་གནས་གཉིས་རེ་སྟེ་གང་ཟག་ཟུང་བཞི་ཡ་བརྒྱད་ཡོད་དོ།",
    "འདོད་པའི་སས་བསྡུས་ཀྱི་སྒོམ་སྤང་ཉོན་མོངས་ཆེ་འབྲིང་ཆུང་ངུ་དགུ་ཡོད་པ་བཞིན་དུ།",
