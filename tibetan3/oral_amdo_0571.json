    "ཀུན་ནས་ཉོན་མོངས་པར་མི་འགྱུར་བ་དང་།",
    "མེར་འཇུག་གི་བུ་དེ་ལ་བདག་ནི་ཁ་ཅིག་བཟོད་ལ་ཁ་ཅིག་མི་བཟོད་དོ་ཞེས་ལྟ་བའི་ལྟ་བ་གང་ཡིན་པ་འདི་ལ་ནི་རེ་ཞིག་བདག་ནི་ཁ་ཅིག་བཟོད་དོ་ཞེས་ལྟ་བའི་ལྟ་བ་གང་ཡིན་པ་འདི་ནི་ཀུན་དུ་འདོད་ཆགས་པར་འགྱུར་གྱི།",
    "ཀུན་ནས་ཉོན་མོངས་པར་འགྱུར་གྱི།",
    "ཀུན་ནས་ཉོན་མོངས་པར་མི་འགྱུར་བ་དང་།",
    "མེར་འཇུག་གི་བུ་གསུམ་པོ་འདི་དག་ནི་ཚོར་བ་ཡིན་ཏེ།",
    "མེར་འཇུག་གི་བུ་གང་གི་ཚེ་འཕགས་པའི་ཉན་ཐོས་བདེ་བའི་ཚོར་བ་མྱོང་བར་བྱེད་པ་དེའི་ཚེ་ན་དེ་ལ་སྡུག་བསྔལ་དང་།",
    "གང་གི་ཚེ་འཕགས་པའི་ཉན་ཐོས་སྡུག་བསྔལ་གྱི་ཚོར་བ་མྱོང་བར་བྱེད་པ་དེའི་ཚེ་ན་དེ་ལ་བདེ་བ་དང་།",
    "གང་གི་ཚེ་འཕགས་པའི་ཉན་ཐོས་སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་མྱོང་བར་བྱེད་པ་དེའི་ཚེ་ན་དེ་ལ་བདེ་བ་དང་སྡུག་བསྔལ་གྱི་ཚོར་བ་གཉིས་འགག་པར་འགྱུར་ཏེ།",
    "དེ་འདི་སྙམ་དུ་སེམས་ཏེ་ཚོར་བ་འདི་དག་གི་གཞི་ནི་གང་ཡིན།",
    "ཚོར་བ་འདི་དག་གི་གཞི་ནི་རེག་པ་ཡིན།",
    "རིགས་མཐུན་པ་ནི་རེག་པ་ཡིན།",
    "རབ་ཏུ་སྐྱེད་པ་ནི་རེག་པ་ཡིན་ཏེ།",
    "ནུབ་པར་འགྱུར་རོ་སྙམ་མོ།",
    "ཡོངས་སུ་མི་གདུང་ན་བདག་གི་སྐྱེ་བ་བཟད་དོ།",
    "བྱེད་པ་ན་སྲོག་གི་མཐའ་པའི་ཚོར་བ་མྱོང་ངོ་སྙམ་དུ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་ཤེས་སོ།",
    "སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་མྱོང་བར་བྱེད་པ་ན་ལུས་ཞིག་པར་གྱུར་ན་དེ་ཉིད་སྡུག་བསྔལ་གྱི་མཐའ་ཡིན་ནོ་སྙམ་མོ།",
    "རབ་ཏུ་སྤོང་བར་རྗེས་སུ་ལྟ་ཞིང་གནས་པར་བྱའོ་སྙམ་མོ།",
    "འོ་ན་ཁྱོད་ཀྱིས་དེ་ལྟར་ཤེས།",
    "ཁྱོད་ནི་སྐྱེ་བོ་ཕལ་ཆེན་མཚུངས།",
    "ལུས་དང་ཚོར་དང་ཚོར་གཞི་འགག།",
    "པ་དག་གཞན་སུ་ཞིག་གིས་སོ་སོར་མྱོང་བར་འགྱུར།",
    "ཆུད་མི་ཟ་བའང་ཚོགས་དང་དུས།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་དེའི་བུ་མོ་ཞིག་བྱུང་ནས་དེས་དེའི་མིང་ཞིབ་མ་མོ་ཞེས་བྱ་བར་བཏགས་སོ།",
    "གང་གི་ཚེ་བུ་མོ་ཞིབ་མ་མོ་ཆེན་མོར་གྱུར་པ་དེའི་ཚེ་ན་ཉོན་མོངས་པ་དག་གིས་གནོད་པར་གྱུར་ནས་དེས་སྨྲས་པ།",
    "དེས་སྲིང་མོ་ཁྲིད་དེ་གྲོང་མཐར་སོང་ནས་དེ་གཉིས་ཅིག་ཅར་ཁྱིམ་གཅིག་ཏུ་སློང་མོ་ལ་ཞུགས་པ་དང་བྲམ་ཟེན་ངན་འདུག་པས་བུད་མེད་དང་སྐྱེས་པའི་ཚིག་བརྗོད་པ་ཐོས་སོ།",
    "འདི་ནི་ཁོ་བོའ་སྲིང་མོ་ཡིན་ནོ།",
    "ཞི་བ་མ་མོས་སྨྲས་པ།",
    "འདི་ལྟར་བདག་ནི་ཉོན་མོངས་པ་དག་གིས་གནོད་པར་གྱུར་ཏོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཁྱོད་ཉིད་ཤེས་སོ།",
    "ཞིབ་མ་མོས་སྨྲས་པ་མིང་པོ་ཚུར་ཤོག་དང་ལྷན་ཅིག་འཁོད་དོ།",
    "མིང་པོ་གལ་ཏེ་དེ་ལྟ་ན་ཇི་སྟེ་ཁྱོད་ཀྱིས་ཡོན་ཏན་གྱི་ཚོགས་ཆུང་ཟད་ཐོབ་ན་བདག་ལ་རྗོད་ཅིག།",
    "བདག་གིས་སྲིང་མོ་དེ་ལ་ཁས་བླངས་པས་སོང་སྟེ་ཉེ་བར་བསྟན་པར་བྱའོ་སྙམ་མོ།",
    "འཕགས་པ་ཁྱོད་ཀྱིས་ཡོན་ཏན་གྱི་ཚོགས་འདི་ལྟ་བུ་བརྙེས་སམ།",
    "འཕགས་པ་ཁྱོད་ནི་བསོད་སྙོམས་བཞེས་པ་ལགས་ལ།",
    "བདག་གིས་ཁྱོད་ལ་བསོད་སྙོམས་ཀྱི་མཁོ་བ་བསྟབ་པར་བགྱིའོ།",
    "སྲིང་མོ་ཇེ་ཁྱིམ་ཐབ་ལ་དྲིས་ཤིག།",
    "དེ་ཁྱིམ་ཐབ་ཀྱི་གན་དུ་སོང་སྟེ་སྨྲས་པ།",
    "བདག་གིས་དེ་ལ་བསོད་སྙོམས་ཀྱི་མཁོ་བ་བསྟབ་པར་བགྱིའོ།",
    "རབ་ཏུ་བྱུང་བ་བརྟུལ་ཞུགས་གྲུབ་པ་བདག་ཉིད་ཆེན་པོར་གྱུར་ན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཀྱིས་སོང་ལ་ཅི་བདེར་བསོད་སྙོམས་ཀྱི་མཁོ་བ་སྟོབས་ཤིག།",
    "དགེ་སློང་དགུ་དེ་ལ་དེའི་ཚེ་དེའི་དུས་ན་བྲམ་ཟེའི་བུ་མོ་ཞིབ་མ་མོ་གང་ཡིན་པ་དེ་ནི་དགེ་སློང་ཤཱ་རིའི་བུ་འདི་ཉིད་ཡིན་ཏེ།",
    "ཤཱ་རིའི་བུ་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དག་གཞན་སུ་ཞིག་གིས་མྱོང་བར་འགྱུར།",
    "ཆུད་མི་ཟ་བའང་ཚོགས་དང་དུས།",
    "དེ་རྒྱལ་པོའ་གན་དུ་སོང་སྟེ་ཕྱིན་ནས་སྨྲས་པ།",
    "བུ་གང་གི་དོན་དུ་མཆོད་སྦྱིན་སྦྱིན་པར་བྱེད།",
    "དེས་མི་དབུལ་པོ་ཞིག་ཁར་བ་དང་སློང་ཕོར་ཆག་པ་ཐོགས་ཏེ་སློང་མོ་ལ་རྒྱུ་བ་མཐོང་ངོ།",
    "མཐོང་ནས་ཀྱང་རྒྱལ་བུ་དེ་དེའི་གན་དུ་སོང་སྟེ་སྨྲས་པ།",
    "འཕགས་པ་གལ་ཏེ་ཁྱོད་ཀྱིས་ཡོན་ཏན་གྱི་ཚོགས་ཅུང་ཟད་ཐོབ་ན་བདག་ལ་རྗོད་ཅིག།",
    "བདག་གིས་ཡོན་ཏན་གྱི་ཚོགས་གང་ཅུང་ཟད་ཐོབ་པ་གང་ཡིན་པ་དེ་ཐམས་ཅད་རྒྱལ་པོའ་བུ་དེ་ལ་བརྟེན་ནས་ཐོབ་པ་ཡིན་ལ།",
    "བདག་གིས་དེ་ལ་ཁས་བླངས་པས་སོང་ལ་དེ་ལ་ཉེ་བར་བསྟན་པར་བྱའོ་སྙམ་མོ།",
    "འཕགས་པ་ཁྱོད་ཀྱི་ཡོན་ཏན་གྱི་ཚོགས་འདི་ལྟ་བུ་བརྙེས་སམ།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་ལས་ཇི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་རྫུ་འཕྲུལ་ཆེ་བ་དང་མཐུ་ཆེ་བར་གྱུར།",
    "དགེ་སློང་དག་མོད་གལ་གྱི་བུ་ཉིད་ཀྱིས་ལས་ཚོགས་རྙེད་པ།",
    "འགྱུར་བ་དག་བྱས་ཤིང་བསགས་པས་མོད་གལ་གྱི་བུ་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དག་གཞན་སུ་ཞིག་གིས་མྱོང་བར་འགྱུར།",
