    "འཕགས་པ་ཁྱོད་ཀྱིས་ཡོན་ཏན་གྱི་ཚོགས་འདི་ལྟ་བུ་བརྙེས་སམ།",
    "ཐམས་ཅད་དུ་ཁྱིམ་བདག་ཆེ་གེ་མོ་ཞིག་གི་བྲན་རབ་ཏུ་བྱུང་ནས་ཡོན་ཏན་གྱི་ཚོགས་དེ་ལྟ་བུ་ཐོབ་བོ་ཞེས་སྒྲ་གྲགས་སོ།",
    "ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་ཁྱིམ་བདག་ཆེ་གེ་མོའ་བྲན་རབ་ཏུ་ཕྱུང་ནས་ཡོན་ཏན་གྱི་ཚོགས་དེ་ལྟ་བུ་ཐོབ་བོ་ཞེས་ཐོས་ནས་དེས་བློན་པོ་རྣམས་ལ་བསྒོ་བ།",
    "ཁྱིམ་བདག་འདི་མགུ་དཀའ་བར་གྱུར་པས་བདག་གིས་འདིའི་སེམས་སྲུང་བར་བྱེད་མི་ནུས་ཀྱིས་འབྲོས་སུ་འགྲོའོ་སྙམ་མོ།",
    "དགེ་སློང་གི་གན་དུ་སོང་ནས་སྨྲས་པ།",
    "མཉན་ཡོད་རྒྱ་ཆེ་ལ་རང་གི་སྤྱོད་ཡུལ་དང་ཡབ་ཀྱི་ཡུལ་ཡིན་གྱིས་བསོད་སྙོམས་སྒྲུབས་ལ་འཚོ་བར་གྱིས་ཤིག།",
    "དེ་བདག་གི་འཕྲལ་གྱི་བྱ་བ་ཐམས་ཅད་ལ་སྔོན་དུ་འགྲོ་བ་ཡིན་ན།",
    "བདག་གིས་ཅིའི་ཕྱིར་སྤྱོས་སྙམ་མོ།",
    "བཞིན་བཟངས་ཁྱོད་རབ་ཏུ་བྱུང་ན་ཁོ་བོའ་རིམ་གྲོ་སུས་བྱེད་པར་འགྱུར།",
    "ཁོ་བོ་ཅག་ལ་རྒྱལ་པོས་གཞོན་ནུའི་ཡོངས་སུ་སྤང་བ་བྱིན་ནས་གལ་ཏེ་རེག་པར་བྱེད་ན་ཁྱོད་ཀྱི་ལག་པ་མཁྲིག་མ་ནས་གཅོད་དུ་གཞུག་གོ།",
    "དེ་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་རྣམས་ཀྱི་དགེ་སྦྱོང་གི་ཚུལ་ནི་ཚིག་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་བྲན་རབ་ཏུ་དབྱུང་བར་མི་བྱའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ལ་བུ་ལོན་ཆགས་པ་ཞིག་གིས་དུས་དང་དུས་སུ་དངོས་དང་སྐྱེད་འཇལ་བར་བྱེད་དོ།",
    "ཁྱིམ་བདག་འདི་མགུ་དཀའ་བར་གྱུར་པས་བདག་གིས་དངོས་དང་སྐྱེད་ཅིག་ཅར་འཇལ་མི་ནུས་ཀྱིས་འབྲོས་སུ་འགྲོའོ་སྙམ་མོ།",
    "དེ་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་སྟེ་དགེ་སློང་གི་གན་དུ་སོང་ནས་སྨྲས་པ།",
    "བརྩལ་བར་བྱས་པས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པས་དགྲ་བཅོམ་པ་ཉིད་མངོན་དུ་བྱས་ཏེ།",
    "དེ་བདག་ལ་དུས་དང་དུས་སུ་དངོས་དང་སྐྱེད་འབུལ་བ་ཡིན་ན་བདག་གིས་ཅིའི་ཕྱིར་བཟུང་སྙམ་མོ།",
    "བཞིན་བཟངས་ཁྱོད་རབ་ཏུ་བྱུང་ན་ཁོ་བོ་ལ་དུས་དང་དུས་སུ་དངོས་དང་སྐྱེད་སུས་འབུལ་བར་འགྱུར།",
    "འཕགས་པ་ཁྱོད་ཀྱིས་ཡོན་ཏན་གྱི་ཚོགས་འདི་ལྟ་བུ་བརྙེས་སམ།",
    "ཐམས་ཅད་དུ་ཁྱིམ་བདག་ཆེ་གེ་མོ་ཞིག་གི་བུ་ལོན་ཆགས་པ་རབ་ཏུ་བྱུང་ནས་ཡོན་ཏན་གྱི་ཚོགས་དེ་ལྟ་བུ་ཐོབ་བོ་ཞེས་སྒྲ་གྲགས་སོ།",
    "ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་ཁྱིམ་བདག་ཆེ་གེ་མོ་ཞིག་གི་བུ་ལོན་ཆགས་པ་རབ་ཏུ་བྱུང་ནས་ཡོན་ཏན་གྱི་ཚོགས་དེ་ལྟ་བུ་ཐོབ་བོ་ཞེས་ཐོས་ནས།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ལ་བུ་ལོན་ཆགས་པ་ཞིག་གིས་དུས་དང་དུས་སུ་དངོས་དང་སྐྱེད་འཇལ་བར་བྱེད་དོ།",
    "ཁྱིམ་བདག་འདི་མགུ་དཀའ་བར་གྱུར་པས་བདག་གིས་དངོས་དང་སྐྱེད་ཅིག་ཅར་འཇལ་མི་ནུས་ཀྱིས་འབྲོས་སུ་འགྲོའོ་སྙམ་མོ།",
    "དེ་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་སྟེ་དགེ་སློང་གི་གན་དུ་སོང་ནས་སྨྲས་པ།",
    "མཉན་ཡོད་རྒྱ་ཆེ་ལ་རང་གི་སྤྱོད་ཡུལ་དང་ཡབ་ཀྱི་ཡུལ་ཡིན་གྱིས་བསོང་སྙོམས་སྒྲུབས་ལ་འཚོ་བར་གྱིས་ཤིག།",
    "བདག་གིས་ཅིའི་ཕྱིར་གཟུང་སྙམ་མོ་དེས་བསམས་པ།",
    "བཞིན་བཟངས་ཁྱོད་རབ་ཏུ་བྱུང་ན་ཁོ་བོ་ལ་དུས་དང་དུས་སུ་དངོས་དང་སྐྱེད་སུ་འབུལ་བར་འགྱུར།",
    "ཁོ་བོ་ཅག་ལ་རྒྱལ་པོས་གཞོན་ནུའི་ཡོངས་སུ་སྤང་བ་བྱིན་པས་གལ་ཏེ་རེག་པར་བྱེད་ན་ཁྱོད་ཀྱི་ལག་པ་མཁྲིག་མ་ནས་གཅོད་དུ་གཞུག་གོ།",
    "དེ་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་རྣམས་ཀྱི་དགེ་སྦྱོང་གི་ཚུལ་ནི་ཚིག་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་བུ་ལོན་ཆགས་པ་རབ་ཏུ་དབྱུང་བར་མི་བྱའོ།",
    "ཕ་འདི་མགུ་དཀའ་བར་གྱུར་པས་བདག་གིས་འདིའི་སེམས་སྲུང་བར་བྱེད་མི་ནུས་ཀྱིས་འབྲོས་སུ་འགྲོའོ་སྙམ་མོ།",
    "དེ་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་སྟེ་དགེ་སློང་གི་གན་དུ་སོང་ནས་སྨྲས་པ།",
    "དེས་སྐྱབས་སུ་འགྲོ་བ་དང་བསླབ་པའི་གཞི་དག་བྱིན་ནས་གང་གིས་དེ་ཞུ་བར་བྱེད་པའི་དགེ་སློང་ལ་ཡང་གསོལ་བ་བཏབ།",
    "གང་གིས་དེའི་སྐྲ་དང་ཁ་སྤུ་དག་འབྲེག་བར་བྱེད་པའི་དགེ་སློང་ལ་ཡང་གསོལ་བ་བཏབ་གང་གིས་དེའི་ཁྲུས་བྱེད་པའི་དགེ་སློང་ལ་ཡང་གསོལ་བ་བཏབ།",
    "གང་གིས་དེ་དགེ་ཚུལ་ཉིད་དུ་ཉེ་བར་སྒྲུབ་པར་བྱེད་པའི་དགེ་སློང་ལ་ཡང་གསོལ་བ་བཏབ་སྟེ།",
    "གང་གིས་དེ་ལ་གསང་སྟེ་སྟོན་པའི་དགེ་སློང་ལ་ཡང་གསོལ་བ་བཏབ།",
    "དེ་བསྙེན་པར་རྫོགས་པར་བྱེད་དོ་ཞེས་དེ་དག་གིས་དེ་བསྙེན་པར་རྫོགས་པར་བྱས་ནས་གྲིབ་ཚོད་གཞལ་ཞིང་ཉིན་མཚན་གྱི་ཆ་དང་།",
    "ཤེས་རབ་མཆོག་གི་བསྟན་པ་ལ།",
    "ཁྱོད་ནི་བསྙེན་པར་རྫོགས་པར་གྱུར།",
    "འཕགས་པ་དག་ཅི་ཁྱེད་ཅག་སྤུ་གྲི་ཐོགས་པ་འབའ་ཞིག་གིས་སྡོད་དམ།",
    "བཟང་མོ་ཡུ་བུ་ཅག་གི་བུ་ལོན་འཇལ་བར་བྱེད་པ་དང་།",
    "དེ་ཟོང་ཐོགས་ཏེ་ཡུལ་གཞན་དུ་སོང་བ་དང་།",
    "དེའི་མ་ཡིག་དཔོན་གྱི་གན་དུ་སོང་སྟེ་ཕྱིན་ནས་སྨྲས་པ།",
    "ཇོ་བོ་ཁྱེའུ་འདིའི་ན་ཟླ་ཁྱེའུ་དག་གིས་ཁྱོད་ལ་ཅི་འབུལ་བ་དེ་བདག་ཀྱང་ཁྱོད་ལ་འབུལ་ན།",
    "ཁྱེའུ་འདིའི་ན་ཟླ་ཁྱེའུ་དག་གིས་ནི་ཡི་གེའི་ཡིག་འབྲུ་དག་ལོབས་ནས་ཕྱི་རོལ་གྱི་བསྟན་བཅོས་དག་བཀླག་པར་བརྩམས་ན།",
    "འདི་ལྟར་ཁྱོད་ལ་ཡང་ཉེས་པ་ཡོད་དེ།"
  ]
