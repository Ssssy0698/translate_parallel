    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་།",
    "དེ་ལ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་གང་ཞེ་ན།",
    "དེ་དག་གི་རང་བཞིན་དེ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "འདི་ནི་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱའོ།",
    "བམ་པོ་རེ་གསུམ་པ།",
    "འཁོར་གསུམ་། ཡོངས་སུ་དག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་རྒྱན་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "རྒྱུན་གྱི་རྗེས་སུ་སོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཉོན་མོངས་པ་སྤོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་རྣམ་པར་སྣང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "གློག་གི་སྒྲོན་མ་ཞེས་བྱ་བའི་ཟད་མི་ཤེས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "གློག་གི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "གདུང་བ་མེད་པའི་གློག་གི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་འཛིན་དང་།",
    "ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཉོན་མོངས་པ་དང་བཅས་པ་ཐམས་ཅད་ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྲེག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ངག་གི་སྐྱོན་རྣམ་པར་འཇིག་པས་ནམ་མཁའ་ལྟར་གྱུར་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་ངག་གི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "དེ་ལ་རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་རྒྱན་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་རྒྱན་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "འདི་ནི་རྒྱུན་གྱི་རྗེས་སུ་སོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཉོན་མོངས་པ་སྤོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན་ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་དྲི་མ་རབ་ཏུ་སེལ་བ་སྟེ།",
    "འདི་ནི་ཉོན་མོངས་པ་སྤོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་གློག་གི་སྒྲོན་མ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན་ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་།",
    "འདི་ནི་གློག་གི་སྒྲོན་མ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ངེས་པའི་ཚིག་ཐམས་ཅད་ནི་ཡང་དག་པར་དམིགས་སུ་མེད་ཅིང་ཐ་སྙད་ལ་བལྟོས་པ་ཙམ་མོ་ཞེས་རྟོག་པར་འཇུག་པ་སྟེ།",
    "དེ་ལ་གློག་གི་འོད་ཟེར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "གཞན་ཡང་ཡོན་ཏན་མཐའ་ཡས་པ་བརྒྱ་འགོད་པ་སྟེ་འདི་ནི་གློག་གི་འོད་ཟེར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཉོན་མོངས་པའི་བག་ཆགས་སྤོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཉོན་མོངས་པའི་བག་ཆགས་མཐའ་ཡས་པ་སྤོང་བ་སྟེ།",
    "འདི་ནི་ཉོན་མོངས་པའི་བག་ཆགས་སྤོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་གློག་གི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་གློག་གི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་གདུང་བ་མེད་པའི་གློག་གི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་གདུང་བ་མེད་པའི་གློག་གི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་། འཛིན་ཏོ།",
    "དེ་ལ་ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཉོན་མོངས་པ་མེད་པར་འགྱུར་བ་སྟེ།",
    "འདི་ནི་ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་ཞེས་བྱ་བའི་ཏིང་།",
    "དེ་ལ་ཉོན་མོངས་པ་དང་བཅས་པ་ཐམས་ཅད་ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཉོན་མོངས་པ་དང་བཅས་པ་ཐམས་ཅད་ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་འཐོབ་པར་འགྱུར་བ་སྟེ།",
    "འདི་ནི་ཉོན་མོངས་པ་དང་བཅས་པ་ཐམས་ཅད་ཉོན་མོངས་པ་མེད་པར་ཡང་དག་པར་གཞོལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཉོན་མོངས་པ་ཐམས་ཅད་སྲེག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་། ན།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་ཐ་བ་མ་ལུས་པར་སྲེག་པ་སྟེ།",
    "འདི་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་སྲེག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ངག་གི་སྐྱོན་རྣམ་པར་འཇིག་པས་ནམ་མཁའ་ལྟར་གྱུར་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ངག་གི་ལས་མི་དམིགས་པ་སྟེ།",
    "འདི་ནི་ངག་གི་སྐྱོན་རྣམ་པར་འཛིན་ཏོ།",
    "དེ་ལ་ངག་གི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ངག་གི་ལས་མི་དམིགས་པ་སྟེ།",
    "འདི་ནི་ངག་གི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
