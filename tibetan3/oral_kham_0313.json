    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་ཚེ་ཐོག་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་བསྲེགས་ཤིང་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར།",
    "ཞེས་ཤེས་པའི་ཕྱིར་དུ་སྤྲོ་བ་བསྐྱེད་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ཨོཾ་ཨཱ་ཧཱུཾཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཧེ་རུ་ཀར་གསལ་བའི་དཔྲལ་བར་ཨོཾ་ལས་འཁོར་ལོ་ཨཾ་གྱིས་མཚན་པ་ལས་སྐུ་རྡོ་རྗེ་མ།",
    "ཁས་བླངས་ཀྱི་སྒོ་ནས་ཐོབ་པར་བྱ་བ་ལ་འཛིན་རྒྱུའི་དམ་ཚིག་ངོ་ཤེས་པར་བྱ་བའི་ཆེད་དུ་སྡོམ་པ་བསྒྲག་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མི་བསྐྱོད་པ་ཀྱེེ་རྡོ་རྗེ་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱུྃ་བཾ་ཧོ་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "གཉིས་ཀའང་རུས་པའི་རྒྱན་གྱིས་བརྒྱན་པའི་མིག་ཏུ་སོགས་ནས་ཐུགས་ཀའི་ཨཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རིན་ཆེན་འབྱུང་ལྡན་ཀྱེེ་རྡོ་རྗེ་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱུྃ་བཾ་ཧོ་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཐུགས་ཀའི་དྲྀ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འོད་དཔག་མེད་ཀྱེེ་རྡོ་རྗེ་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱུྃ་བཾ་ཧོ་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཐུགས་ཀའི་ཁཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དོན་ཡོད་གྲུབ་པ་ཀྱེེ་རྡོ་རྗེ་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱུྃ་བཾ་ཧོ་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གཟུགས་ཀྱི་ཕུང་པོ་མི་དམིགས་ཏེ་སྟོང་པར་གྱུར།",
    "ཐུགས་ཀའི་བྷཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རྣམ་པར་སྣང་མཛད་ཀྱེེ་རྡོ་རྗེ་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱུྃ་བྃ་ཧོ་ཞེས་པས་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རྡོ་རྗེ་སེམས་དཔའ་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱུྃཧཱུཾ་བཾ་ཧོ་ཁྱེད་རང་རྣམས་ལ་ཐིམ།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རྡོ་རྗེ་འཆང་ཡབ་ཡུམ་གྱི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཛ་ཧཱྃབཾ་ཧོ་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "དེ་ཡི་མདུན་ན་བདག་འདུག་སྟེ།",
    "དེ་གསུམ་ལྡོག་ཚུལ་ཐ་དད་ཀྱང་རང་བཞིན་སོ་སོར་དབྱེར་མི་ཕྱེད་པ་ངོ་བོ་ཉིད་ཀྱི་སྐུ་སྟེ།",
    "སློབ་དཔོན་རང་ཉིད་། ལེགས་པར་བཤམས་པའི་གདན་ལ་ཉེ་བར་འདུག་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཕྱིའི་ཧེ་རུ་ཀ་ཡབ་ཡུམ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལའང་དེ་ལྟར་ཡོད་དེ།",
    "དེ་ཡི་མདུན་ན་བདག་འདུག་སྟེ།",
    "མཆན་འདི་རྣམས་ཀྱང་རང་ཉིད་ཀྱིས་བཏབ་པའོ།",
    "ཕྱག་གསུམ་བཙལ་ནས་གྲལ་ལ་འདུག།",
    "རང་རྡོ་རྗེ་དྲིལ་བུ་བཟུང་ནས་དེ་རྣམས་ཀྱི་མདུན་དུ་འདུག་ལ།",
    "དེ་ནས་གཡས་སྐོར་གྱིས་སློབ་དཔོན་ལྷོར་འདུག་ཁ་བྱང་དུ་བསྟན།",
    "ཡང་སློབ་དཔོན་གཡས་སྐོར་གྱིས་ནུབ་བྱང་དུ་འདུག་ལ།",
    "སློབ་དཔོན་དེ་ཉིད་དུ་འདུག་ཅིང་།",
    "སློབ་དཔོན་དབུས་སུ་འདུག་ལ།",
    "ཅེས་འདུག་གོ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ན་ཡེ་སྭཱ་ཧཱ།",
    "ལན་གཅིག་ནི་པདྨའི་ལྟེ་བར་བདུད་བཞི་བརྩེགས་པའི་གདན་ཡོད་པ་ཞིག་བྲིས་འདུག་གོ།",
    "ཉན་ཐོས་པ་མཁས་པར་འདུག་སྟེ།",
    "ཡང་སྟ་གོན་གྱི་སྐབས་ཟིན་བྲིས་ཅུང་ཟད་ཅིག་རྗེ་བླ་ ། མའི་ཕྱག་དཔེའི་ཁྲོད་དུ་འདུག་པ་དང་།",
    "སྟན་ནང་ཚངས་ཅན་ལ་བསམ་གཏན་གྱི་སྤྱོད་ལམ་གྱིས་འདུག་སྟེ།",
    "དེ་ཡི་མདུན་ན་བདག་འདུག་སྟེ།",
    "ཞེས་པ་འདི་ནི་སྔགས་འཆང་ཆེན་པོའི་གསུང་རྩོམ་འཕྲོ་ཅན་གྱི་དཀྱིལ་ཆོག་ན་ཡང་འདི་བཞིན་གསུངས་འདུག་པས་ཡིད་གཉིས་བྱ་མི་དགོས་པ་ལགས་ཤིང་།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཁ་ཤར་དུ་ཕྱོགས་པས་འདུག་ལ།",
    "ཞེས་བརྗོད་ཅིང་རྡོ་རྗེ་དྲིལ་བུ་འཛིན་བཞིན་པས་ཕྱག་བྱས་ནས་གྲལ་ལ་འདུག་གོ།",
    "ཡུམ་གྱི་ཕྲེང་སྔགས་འདི་བདག་འཇུག་དུས་མི་མཛད།",
    "དེ་ཡི་མདུན་ན་བདག་འདུག་སྟེ།",
    "སླར་ཡང་རང་བཞིན་གྱི་གནས་ནས་ཡེ་ཤེས་པ་སྤྱན་དྲངས་ལ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཇི་ལྟར་བསྐྱར་བ་ཆོ་གའི་མཚན་ཉིད་རྣམས་ཀྱང་ཐུགས་ལ་མངའ་བཞིན་ཡིན་པར་འདུག་པ།",
    "དེའང་རང་ཉིད་གཅིག་པུའི་དོན་དུ་མ་ཡིན་ཏེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་ཚེ་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་བསྲེགས་ཤིང་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར།",
