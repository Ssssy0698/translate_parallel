    "དྷརྨམི་ཏ་ཅིག་གིས་ལོངས་སྤྱད་ནས།",
    "བདག་གི་ཤ་རུས་སྲན་ཚདཡུངས་འབྲུ་རེ།་།",
    "ཞེས་ལྷ་ཁང་གི་ཞབས་ཏོག་གལ་ཆེ་བ་སོགས་ཀྱི་ཞལ་ཆེམས་ཁྱད་པར་བ་མཛད་སྟེ་དགུང་ལོ་ང་དགུ་པ་ལ་མྱངན་ལས་འདས།",
    "གྱེན་དེ་ན་རི་བོང་ཞིག་སོང་བ་ལས་ལ་རི་བོང་གི་གཟུགས་བྲིས་ཏེ་ཁབ་ལ་སྔགས་ལན་བདུན་བགྲངས་ཏེ་གཟུགས་ལ་བརྒྱབ་པས་རེ་བོད་ཐུར་ལ་འདྲིལ་བྱང་།",
    "འདི་པ་དུད་འགྲོར་སོང་བས་དྲངས་པ་ཡིན་མོད།",
    "ཐལ།",
    "ང་ཡང་ཁྱོད་ཀྱི་ཡུལ་ཕྱོགས་པ་ཅིག་ཡིན་སྟེ་ཁྱོད་ཀྱི་ལུསདང་གྲིབ་མ་ལྟར་མི་འགྲོགས་ཀ་མེད་པ་ཅིག་ཡིན་ཟེར།",
    "རེས་ལོང་མེད་པའིདུསན་ཡང་མ་ཞུས་པར་གསུང་།",
    "ཕྱི་ཞིག་ན་རབ་བྱུང་གི་གདུལ་བྱ་མང་བར་འབྱུང་ངོ་ཞེས་ལུང་བསྟན།",
    "ཡང་གཙུག་ལག་ཁང་ཞིག་ན་བྱམས་པ་དགེ་སློང་གི་ཆ་བྱད་ཏུ་འདུག་པའི་དྲུང་དུ་འབྱོན་པར་བརྩམས་པས་འདི་རབ་ཏུ་བྱུང་རང་བཞིན་གྱི་རྣལ་འབྱོར་མ་ཞིག་དང་མཇལ་བས་ཀྱང་ཨ་ཝ་དྷུ་ཏིའི་སྤྱོད་པ་མ་བྱེད་འདི་ལ་བདེན་པ་མི་མཐོང་བར་ཆད་འོང་རབ་ཏུ་བྱུང་ན་བསྟན་པ་ལ་ཕན་ཞེས་གསུང་བས་བསྐུལ་སྟེ་དགུང་བའིས་ཡིན་ཁྱོད་ཁམིཔའི་སཡིན་པས་མ་འོད་ཞིག་གསུང་བ་བརྨིས།",
    "བསྟན་པའི་སྒོ་འབྱེད་བློ་སྦྱོང་གི་རིམ་པ་སྟེར་བ་གསེར་གླིང་པ་སྟེ་བཀའ་དྲིན་ཆེ་བ་དགུ།",
    "ཐུགས་དམ་གྱི་ལྷ་དཔག་མེད་ཞལ་གཟིགས།",
    "ཡང་བདུད་འལ་མཚོད་རྟེན་གྱི་དྲུང་ན་བུད་མེད་གཉིས་དང་།",
    "སྒྲོལ་མའི་ལྷ་ཁང་དུ་བུད་མེད་རྒན་གཞོན་གཉིས་ཀྱི་དྲི་ལན་དང་།",
    "བ་རུ་གི་པའི་གླིང་ན་གྲུབ་ཐོབ་ཤ་སྟག་ཡིན་ཟེར་ནས་ངས་བལྟར་ཕྱིན་པས་མི་བདེན་པར་འདུག་ཟེར།",
    "དེའི་ཚེ་རྒྱལ་བོ་མཧཱ་པཱ་ལས་བྲཀ་མ་ལ་ཤི་ལར་སྤྱན་དྲངས་སྟེ་ལྟ་བའི་སྣ་བཞི་པཎྜི་ཏ་ལྷ་བཅུ་རྩ་བདུན་དང་བཅས་པའི་གཙུག་གི་ནོར་བུ།",
    "ཁྱོད་རང་གི་རྒྱལ་ཁམས་མུ་སྟེགས་ལ་འགོད་ན་བྱ་དགའ་ཆེན་པོ་སྟེར།",
    "དགྱེས་པ་རྡོ་རྗེའི་རྣལ་འབྱོར་པ་དུ་ཧ་ར་ནག་པོས་ཇོ་བོ་ལས་དཔྱད་འཕྲུལ་གྱི་ཨ་ལོང་ཞེས་བྱ་བ་གནང་སྟེ་ཁྱོད་བོད་དུ་འགྲོ་བར་འདུག་ཁྱོད་ལ་གང་ནས་བྱད་བསབས་པ་ལྟ་ཉིལ་བག་ལེགས་ཚུལ་ཞིག་འོང་།",
    "མངའ་རིས་པ་བློ་གསལ་ཞེས་བྱ་བ་བློ་གྲོས་ཟླ་མེད་པ་ཅིག་གིས་གནས་ཉིད་ཀྱི་བཞེད་པ་མ་གསུང་བར་ཀུན་ལ་མཐུན་འགྱུར་གནང་བ་ཇི་ལྟར་ལགས་ཞུས་བས།",
    "༢ཡོངསག་རྒྱསཀྱི་རྗེས་སུ་སློབ་པ་ཡིན་པས་གདུལ་བྱའི་བསམ་པ་དང་མཐུན་པར་ལན་བཏབ་པ་ཡིན་གསུང་གཞན་ཞིག་གིས་འོ་ན་འདི་ཇི་ལྟར་བཞེད་ཞུས་པས།",
    "རྒྱ་གར་ན་པཎྜི་ཏ་མཁས་པ་ཇི་ལྟ་བུདེནས་གཟིམས་ཁང་དུ་བྱོན་སྟེ་བུམ་པ་དབུ་ཐོག་དུ་བཞག་སྟེ་བྱིན་གྱིསབརླབས།",
    "ཇོ་བོ་དང་མཇལ་བས་དེ་མ་ཐག་དམ་ཚིག་གསུམ་བཀོད་གནང་ནས་བཟླས་པ་སྟོང་བརྒྱད་བརྒྱ་སོང་བ་དང་ཞལ་གཟིགས།",
    "ཡད་སྐབསཅིག་རེ་གཉིས་བྱོན་ནས་སྒྱུ་མ་ལྟ་བུའི་ཐང་ཀ་གཟིགས་པར་འཚལ།",
    "དཀོརམཛོད་གླིང་དུ་རྒྱ་དཔའི་དཀོར་མཛོད་ཅིག་ཁཕྱས་གཟིགས་པས་སྔར་མ་གཟིགས་པའི་རྒྱུད་སྨད་དུ་ལྷུང་བས་ངས་མི་ཡུལ་གྱི་རྒྱུད་རྣམས་དུ་མ་ཟདམཁའ་འགྲོ་མས་བསྟན་པ་ཡང་དཔག་མེད་མཐོང་སྟེ་དེ་རྣམས་ན་ཡང་འདི་ཀུན་མི་འདུག་གསང་སྔགས་འདི་ལ་མཐའ་མངོན་རྒྱུ་ཡོང་ཡོད་མ་ིའདྲ་གསུང་ནས་མི་ཡུལ་ན་ཡོད་པའི་གསང་སྔགསམོ་ལུས་པ་མཁྱེན་དགོས་པའི་ཐུགས་རྒྱལོ་ཡང་དེར་ཆོག།",
    "ངའི་མགོ་འདི་ལྟར་སོང་བ་ཞིག་ཁྱོད་ཀྱིས་འཇོག་ཡོད་ན་ཉེ་གནས་ཀ་མ་བྱེད་གསུངས་པས་མཆི་མ་ཐུལ་བྱུང་སྟེ་འོ་ནཇི་སྲིད་བཞུགས་ཀྱི་བར་དགྱོད་པར་ཞུ་ཟེར།",
    "བར་བཅས་ལྕང་ལོ་ཅན་བོ་༣ བདེ་བ་ཅན་ལྕང་ལོ་ཅན་བོནལ་རི་བོ་རྩེ་ལྔ་རྣམས་སུ་ལོ་ལྔ་བརྒྱ་རེ་བཞུགས་ནས་འོད་དཔག་མེད་ལ་སོགས་པའི་ཐུགས་དམ་གྱི་རྟེན་མཛད།",
    "ཀླུ་མོ་རྣལ་འབྱོར་མ་རྣམསཀྱིས་ལོ་ལྔ་བཅུ་རེ་མཆོད།",
    "དགོ་བཤེས་སྟོན་པས་ཇོ་བོ་ལ་ཟླ་གྲགས་ལུགས་ཀྱི་རྟོགས་པ་ཕུལ་བས་ཇོ་བོ་ཐལ་མོ་ཤར་ཕྱོགས་སུ་སྐྱུར་སྟེ་ད་ལྟ་རྒྱ་གར་ཤར་ཕྱོགས་ན་ལྟ་བ་འདི་ཁོན་འཛིན།",
    "འབྲོམ་ལ་དགུན་མེ་ཏོག་འཆར་བ་ཞིག་ཡོད་ཟེར་བ་དེ་ག་རེ་གསུང་།",
    "ཁྱད་པར་ཁྱི་གུ་རྣམས་ཕྲག་དུ་བསྣམས་རང་ཁྱིའི་བུ་ཆུང་སྐུ་ཁམས་བདེ་འམ་ལུས་ངན་འདི་ལྟ་བུ་ལེན་པ་ཁྱེད་རང་གིས་ནོངས་ཁྱེད་རང་གི་ནོངས་གསུང་།",
    "ཉིན་གཅིག་དེ་རིང་སུ་ཡང་མ་གཏང་ཞིག་གསུང་སྟེ་རྒྱ་གར་ནག་ཆུང་གིས་འབུལ་བ་བྱེད་ཏུ་བཏང་ཟེར་བའི་མ་ཁྲིས་ཆུང་ཅན་ཞིག་བྱུང་བ་དེ་བཏང་བས་ཁྲེས་པོའི་ནང་ནས་ལྕགས་ཀྱི་སྦར་མོ་ཞག་འུར་གྱིས་ཡོང་བས་ངོ་བོའི་སྐུ་རྒྱབ་རྩིག་ངོས་ལ་ཐམཱ་སདནས་ཕྲི་ལོ་ལི་འདུག་སྟེ་མུ་སྟེགས་ཀྱི་ངན་སྔགས་ཀྱིས་མ་ཚུགས་གསུང་།",
    "ཡང་རྒྱ་གར་ནས་དགེ་སློང་ཤིན་ཏུ་བཙུན་པ་སྦྱངས་ཡོན་དང་ལྡན་པ་གཉིས་བྱུང་ངོ་བོས་གང་ཟག་གི་བདག་མེད།",
    "བོད་ཀྱི་བསྟན་བཅོས་མང་པོ་གཟིགས་སུ་ཕུལ་བས་ཨ་རོའ་ཐེག་ཆེན་རྣལ་འབྱོར་མ་གཏོགས་གཞན་ལམ་མཉིས་པས།",
    "སྤྱིར་སྙེ་ཐང་དུ་ཞལ་གཟིགས་མང་།་",
    "རྣལ་འབྱོར་པས་ཇོ་བོ་དང་ད་མམཛལ་སྙམ་ནས་མཚན་རངས་བཤུམས་པས་སྤྱན་ཀུན་ཐོ་བ་ཙམ་དུ་སོང་སྐདབར་ཆད་ལན་གསུམ་དུ་བྱུང་ཡང་སྐྱོན་མེད་ཏུ་བི་ཀྲ་མ་ལེར་འཁྱེལ།",
    "དན་གུང་ཐང་པ་ཡང་ཡར་ལ་སོང་།",
