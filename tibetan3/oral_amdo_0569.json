    "ཐོག་རེ་རེ་ཞིང་ཐང་གིབྱ་མདབ་དང་ཕ་གུ་དྲ་ཕྱེད་ཤར་བུ་མདའ་ཡབ་ཀྱིས་མཛེས་པ།",
    "ཐོག་རེ་རེ་ཞིང་གློ་འབུར་གྱི་སྒོ་དང་སྒོ་ཁྱམས་དང་རྟ་བབས་ཀྱིས་མཛེས་པ།",
    "ཡང་རྩེའབྱ་མདབ་ཀྱི་རྩེར་གསེར་གྱི་གྷཎྜིར་རྩེ་མོ་རྒྱབ་རིམདུན་མའི་རྩེ་དང་མཉམ་པའི་གཡས་གཡོན་དུ་གཡུ་འབྲུག་གིས་སྤྲས་པ།",
    "ནུབ་སྟག་གཟིག་གི་ས་མཚམས་སྦ་སྟག་ཤ་དུང་གི་སྒོ་མོ་ལ་གཏུགས།",
    "བྱས་རྣམས་རང་གི་དོན་ལ་བརྩོན་པ་ཡིས།",
    "ཁྱེད་རང་སུབས་གཙམཐོང་ཙ་ན་ལག་ན་འདུག་ཟེར་སྐད་སྟེ་ཐེ་རང་གི་སྤྲུལ་པ་ཡིན་པས་བྱིས་པས་ཤེས་ནས་ཞོ་བཞག་བྱས།",
    "ཨ་མཛུབ་མཆང་མས་བཀའ་བསྩལ་ཏོ།",
    "གསུང་སྟེ་ལྷོ་བྲག་ཁོ་ཐང་གི་བར་དུ་བྱོན།",
    "དེར་སྣ་ནམ་བཟའ་མང་རྗེས་དུག་གིས་བགྲོས་སྐད།",
    "ལོང་བས་དྲི་ལ་བརྟགས་པས་སྒོ་བརེད་ནས་ཟས་སྐོམ་སློངས།",
    "མི་སྨྲ་བའི་རྔན་པར་གོས་རེ་བྱིན་པས་ལོང་བའི་གོས་རྩུབ་པར་ཤེས་ནས་ཁོས་སྨྲས་ཏེ་དབངས་སྟག་རྣ་ཅན་ལ་སོགས་པས་བློན་ཆེན་པོ་བཟུང་ནས་མཚོན་ཅི་བཏབ་ཀྱང་མ་ཕེད།",
    "ཤིན་ཏུ་སྡུག་ཡུན་རིང་བ་ན་སྐྱོ་སྟེ་སྤྱི་བོན་སོར་བཞི་མ་གྲུབ་པར་ཡོད་པས་དེར་ཁབ་ཚུག་ལ་སོདཅེས་ཁོང་རང་གིས་སྦས་པ་ལྟར་བྱས་པས་ལྟག་པ་སྒར་གྱིས་སོང་སྟེ་ཤི།",
    "ཉེ་དུ་རྣམས་ཀྱིསརོ་ལྷག་མ་བསྡུས་ཏེ་ཡེར་པར་བསྲེགས་པས་དུ་བའི་ནང་ནས་འོང་དཀར་པོ་རྫ་མ་ཙམ་ཞིག་ན་མཁའ་ལཛེམཐོ་ཇེ་མཐོར་སོང་བས་ཁོང་རང་གི་སྲང་མོ་ཞིག་གིས་དུས་རྩིང་བོས་ཏེ་བློན་ཆེན་པོ་ཁྱེད་གར་འབྱོན།",
    "བཤིག་པའི་མོད་ལ་ཐོག་བབས་འཇིག་མཁནཤ་སྐྲག་སྟེ་ལྷག་མ་མ་བཤིག་ལུས་པར་གྱུར།",
    "བློན་པོ་དབའས་སྟག་རྣ་ཅན་གྱིས་བྱསགྱིས་སྔ་བའི་ཆུ་མོ་ལུག་ལ་ཁྲི་དར་མ་ཨུ་དུམ་བཙན་འཁྲུངས།",
    "བཙུན་མོ་ཆེ་ཆུང་གཉིས་ཁབ་ཏུ་བཞེས།",
    "བ་ལང་གི་ཤ་ཚུགས་འདྲ་ཞིང་མཁྱེན་པ་ཆུང་ལ་རྒྱུད་གྱོང་བས་འཕོངས་རྣམས་ཀྱིས་གླང་དར་མར་བཏགས།",
    "བསམ་གཙང་ཁང་གི་སྒོ་བརྩིགས་ནས་བཙུན་པ་ཆང་འཐུང་བའི་རི་མོ་བྲིས་ཏེ་བཞག་རླབས་ལྷག་པར་ཆེ།",
    "ཡབ་མེས་ཐམས་ཅད་ཀྱི་ཡིག་ཚངས་དང་དཀར་མཛོད་ཀྱི་སྒྲོམ་བུ་རྡོ་རིང་གི་ཡི་གེ་ཐམས་ཅད་གཟིགས་ཅིག་ཞེས་མགྲིན་གཅིག་དུ་ངུ་འབོད་ཆེན་པོ་",
    "རྒྱལ་པོ་ནུབ་ཕྱོགས་གླ་བའི་ཚལན་མིག་མང་རྩེ་ཞིང་ཡོད་པ་ལ་འབངས་རྣམས་ཀྱི་དུ་འབོད་ཐོས་པས་སེམས་མ་བདེ་སྟེ་རྡོ་རིང་གི་ཡི་གེ་ཀློགཞིང་ཡོད་པས་མཐོང་སྟེ་མགོན་པོ་ནག་པོ་བྱུང་ཟེར་སྐད།",
    "དེར་རྟ་བབས་རྒྱལ་པོ་རྡོ་རེད་གི་རུསསླལ་ལསྒྲ་སྟེགས་སུ་འདུག་པ་ལ་ཕྱག་བྱེད་པ་ལྟར་བཅོས་ཏེ་ཕྱག་དང་པོ་ལ་ཕུ་ཐུང་གི་ནང་དུ་ཐབལྟོང་སྤང་གཉིས་པ་ལ་མའ་བཀང་གསུམཔ་ལ་འཕངས་པས་སྨིན་མཚམསསུ་ཕོག་སྟེ་མདེའུ་ལྟག་པར་བྱུང་།",
    "ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་ལ་ཁྱད་མར་ཤོག་ལ་སྣོན་པ་དང་ཉ་པའི་དཔོན་གྱིས་ཟེར་ཞིང་ཕྲིན་བསྐུར་བྱུང་བ་ལ་མ་ཕྱིན་པར་ཡི་དམ་གྱི་ག་ར་འབངས་གཡོག་ལྔ་ལ་རྒོད་མ་དཀའ་མོ་ཞིག་དབྱར་རིལ་གྱིས་ལེགས་པར་གསོར་བཅུག།",
    "ལྷ་སའི་ནེ་ཐང་དུ་རྒྱལཔོ་ང་ལྷག་གིས་བྱུང་།",
    "གྲིབ་ཀྱི་མཱཚ་ལ་རྟེ་ཉལ་བྱས་པས་བློ་དཀར་རྟ་དཀར་ཅན་དུ་སོང་བས་དེ་མ་མན་ངེས་ཟེར་ནས་ལོག་རྒོད་མ་སྒྲགས་སུ་བསྐྱལ་བས་རྒོད་མ་ཐང་དུ་མིང་ཐོགསམ་ཡོང་ད་བདུད་ཡབ་ནག་པོ་ཡིན་ནོ་བྱས་པས་ཅུང་ཟད་འཚོམསདེ་ནས་མཆོག་གི་དངོས་གྲུབ་ཐོབ།",
    "བལ་གོ་ལོས་ལབཙུན་མོ་ཆུན་མ་ཚེ་སྤོང་བཟའ་བཙན་མོ་འཕན་ལལྟོ་བོར་གྱིསས་གཅིག་བྱུང་བ་ཆེན་མས་བསད་པ་བཞི་བཅུ་རྩགཉིས་སེང་ངོ།",
    "རྟགས་རང་གིས་བླངས་ནས་ཤམ་ཐབས་གོང་བ་ཅན་གོན།",
    "འོད་སྲུང་གིས་གཡོ་རུ་བཟུང་ནས་དབུ་གཡོར་འཁྲུག་པ་བྱས།",
    "བཙན་པོ་གཉིས་ལོཉིརགསུམ་རོ་ལོན་པའི་ས་གླང་ནས་བཟུང་སྟེ་འབངས་ཀྱི་ཁོངལག་རྣམས་རིར་བྱུང་སྟེ་དེ་ཡང་བར་སྣང་གི་བྱ་གཅིག་ལ་ཀུན་རུབ་པ་མཐོང་བ་ལ་དཔོ་བྱས་དང་པོ་དབས་ཁོ་བཞེར་ལེགས་སྟོང་གིས་ལག་དཔོན་བྱས་མཱདོ་ཁམས་རུ་ཁེང་ལོག་བྱས།",
    "དེ་ནས་ཀོང་ཡུལ་བྲེས་སྣ་འབེ་མོའི་གཡོ་སྒྱུས་ཕབ་པོ།",
    "ལྷ་ཕོའི་རྩ་རུ་རྗེ་དཔོན་ཚན་རེ་ཞུས།",
    "མྱངདང་སྣང་གིས་མ་ཕྱར་བྱས་ནས་ནི།",
    "ཚེ་སྤོང་ཞང་གིས་རྒྱལ་ཆེན་བང་སོ་བྲུས།",
    "དེ་ཡང་ཁྲི་ལྡེ་ཡུམ་བརྟན་གྱི་སྲས་ཁྲི་ལྡེ་མགོནམོརྟེན།",
    "ཆུང་བ་ལྡེ་གཙུག་མགོན་གྱིས་ཞང་ཞུང་བཟུང་ལྡེ་གཙུག་གི་ལས་སྤྱོད་དེ་དད་འཁོརལེགས།",
    "ཕྱིས་ཡབཞེས་ཀྱི་ཡགཚངས་གཟིགས་པས་ཐུགས་སྐྱོ་ནས་རབ་བྱུང་མཛད་པས་ལྷ་མ་ཡེ་ཤེས་འོད་ཏུ་གྲགས་མ་ལིང་དཔལ་གྱི་ལྷ་ཁང་བཞེངས།",
    "བཀྲ་ཤིས་མགོན་གྱི་སྲས་ཁོར་རེ་དང་སྲོང་དེ་ཞེས་སོགས་སྣང་ངོ།",
    "སྲས་དྲུག་ལས་ལྔ་བྱང་དུ་གཤེགས་ཏེ་གཡས་རུ་དང་རུ་ལག་གི་བཙན་པོ་རྣམས་ཡིན།",
    "གསུམ་པ་ཤོག་ལྡེའི་རྒྱུད་གཡས་རུའི་སྐྱེ་མཁར་བཙན་པོ་ལ་ཐུག་བཞི་པ་ཁྲི་ཆུང་གིས་ཡར་ལུངས་སུ་བྱོན།",
    "གཅེན་ལ་སྲས་དྲུག་གི་གཡུ་ཐོག་གརྒྱུད་སྣ་མོབ།",
    "བཞེངས་ཅན་འབར་གྱི་རྒྱུད་མོན་མཁར་བ།",
    "ལྷ་སྟོན་དཀར་མོའི་རྒྱུད་བྱི་ཆུང་བའོ།",
    "བཙན་པོ་གཡུ་ཅན་གར་མ་ཡོན་ཏན་གཡུང་དྲུང་གིས་བྱ་སར་སྤྱན་དྲངས།",
    "གཅུང་པོའང་རབ་ཏུ་བྱུང་སྟེ་ལྷ་ཞི་བར་གྲགས་ཏོ་ལོམོ་སྒོམ་ཁང་དུ་བཞུགས།",
    "གཞེས་པ་ཤཱཀྱམགོན་པོས་རང་གི་སྲིད་བསྐྱངས་ཏེ་ཡར་ལུངས་ལོ་ཙཱ་བ་གྲགས་པ་རྒྱལ་མཚན་བསྟེན།",
    "ཕྱི་མ་འདི་རྣམས་ཡར་ལུངས་ཇོ་བོས་བསྒྲིགས་པའི་ཚོསབྱུངལས་བསྡུས་པ་སྟེ་འདི་ཕྱིན་ཡང་དཔྱོད་ལྡན་རྣམས་ཀྱིས་སྟོད་སྨད་བར་གསུམ་གྱི་རྒྱལ་བརྒྱད་ལས་བསྟན་པ་ལ་བྱ་བ་བྱས་པ་དང་ཕན་བདེའི་སྲོལ་གཏོད་པ་མཐོང་ན་རང་རང་གི་ཕྱོགས་བཟུང་བ་མ་ཡིན་པར་གཟུ་བོར་གནས་པའི་བློ་འདི་སྐབས་སུ་བསྣན་པར་བྱས་ཅིག།",
    "གདུང་གི་དམ་པ་གོ་ཏཾཤཱ་ཀྱའི་བརྒྱུད།",
    "ཉེས་སྐྱོན་ཀུན་བསལ་གནས་སྐབས་མཐར་ཐུག་གི་། ཡོན་ཏན་བདེ་ལེགས་ཀུན་ལ་བཀོད་པ་ཡི།",
    "དེང་སང་དུས་ན་མིང་གི་ལྷག་མ་ཙམ།",
    "རྒྱལཔོ་གླང་གི་དགོངས་པ་ད་རྫོགས་སམ།",
    "དེ་དག་གི་བླམའི་གནས་རྣམས་ཀྱང་རྒྱལ་བོ་དང་བློན་པོ་དག་དྲན་པས་མགུ་བར་བྱས་པའམ།",
    "ཁྱོད་ལ་བདག་ཅག་གནོད་པ་མི་བགྱིད་ཏོ།",
    "སྲིན་མོའི་བུ་རྣམས་ཀྱིས་མི་འདི་བདག་ཅག་བཟང་སྩོལ་ཞིག་ཞུས་སྨྲས།",
    "དེ་བཞིན་དུ་སྲན་མ་བོང་བུའསདང་ཁྲོ་གཉེར་དཔྲལ་ས་ཅན་དང་མཚོན་ཆའི་གདོང་རྣམས་རེ་རེ་བཞིན་འཁོར་ལྔ་བརྒྱ་དང་བཅས་པརེ་ལྷགས་ཏེ་སྔ་མ་བཞིན་གནོད་པ་སྤངས་ཏེ་ཕྱག་བསྐོར་དང་ངུར་སྨིག་ལ་བསྟོད་པ་བྱས།",
    "འཁྲུག་པ་འདི་ཁྱོད་ཀྱིས་མི་བསྣམན་སུས་བསྡུམ་ཞེས་གསུང་བ་སྐུ་འཁོར་ཐམས་ཅད་ཀྱིས་ཐོས།",
    "ཆུ་རགས་ཆེན་མོ་སོགས་ཞབས་ཏོག་དཔག་མེད་བྱས།",
    "ས་རྒྱུས་མཁསཙང་ཡན་ཏན་དང་ལྡན་པའི་སྟོན་པ་རིན་རྡོར་དང་མཛོད་པ་ཨར་ཛུ་ལསོགས་བ་མངགས་ཏེ་བངས་ཁལ་བོ་བརྒྱད་ལ་ངོས་རེར་བྱས་བའི་ཟངས་དོས་བརྒྱུདང་བཞི་གསེརཡཱང་ལྔ་བརྒྱ་རྣམས་ལས་ལྕགས་ཕོ་ཁྱི་ལོ་ལ་ཇོ་བོའི་དབུ་བའ་སྐུ་ལ་མུ་ཏིག་གི་སྣམ་སྦྱར་རིན་ཐང་མེད་པ་གསལ་བར་མཛད་ཏོ།",
    "ཀྱེ་ཧུད་བོད་འབངས་ཉོན་རེ་ཡོངས།",
    "འདི་ཞིག་མུན་པ་གང་གིས་སེལ།",
    "གཙང་པོ་འདི་གཙུག་ལག་ཁང་གི་རྩར་འོང་བ་ཡིན་ལ་ཕྱི་མའི་དུས་ཀྱི་མི་རྣམས་དེའི་ཆེད་དུ་ཆུ་འགས་བྱེད་ཏོ།",
    "ངག་གིས་ཁ་བཀོད་བྱེད་པ་རྣམས་ནི་གསུང་ལོངས་སྐུ་ཐོབ་པར།",
    "དེ་ཚོམ་ཡིགང་ཟག་གིས།",
    "མུ་ཟླཡེར་པ་མ་ཞིག་ན་ལུས་གསོ་མཁན་རེ་ཡང་རྒྱུན་དུ་འོང་གས་མཁན་དེ་ཡང་རྒྱལ་བའི་ཞབས་ཏོག་རྒྱལ་བས་བྱས་པ་ཡིན་ནོ།",
    "ཚེ་ཐུངན་མཚོད་རྟེན་གྱི་སྲོག་ཤིང་ཤུག་པའི་སྡོང་པལ་རིན་པོ་ཚེལྡན་འབྲུ་ཙནྡན་ཨ་ག་རུ་སོགས་དང་དར་སྣ་དང་ཚོན་སྐུད་ཀྱིས་བཀྲུས་པས་གསོ།",
    "ཞེས་སོགས་རྒྱལ་པོས་གསུངས་ནས་ཇོ་མོ་གོང་ས་དཀར་ཆག་དུ་བཏབ་པོརེས་བྱུང་ངོ།",
    "ཐུན་མོང་མན་པར་གདུལ་བའི་ཁུར་བསྣམས་ནས།",
    "དབུས་ན་ཀླུ་མེས་འབྲིང་ཚོ་ཆ་རག་གསུམ།",
    "ཇི་བཞིན་གང་གི་རྒྱུད་ལ་གནས་པ་ཡི།",
    "ཕལ་ཆེར་ཞིག་ཚུར་ཤོག་གིས།",
    "དང་པོར་བདག་གིས་རབ་ཏུ་བྱུང་བར་བྱ།",
    "ཡོན་ཏན་མཆོག་གི་ནོར་བྱིན་ཡང་།",
    "དང་པ་བུད་མེད་སྒོག་ཚོང་མ།",
    "དེ་ལ་ཁྱོད་ཀྱི་བུ་རབ་ཏུ་བྱུང་ནས་དབུསན་ཡོད་ཀྱིས་ཅིག་བྱས་ཏེ་བཏང་བས་ཚོང་ལེགས་པར་བྱུང་།",
    "དེ་ཕྱིན་མགུར་མོར་ཚོང་འདུས་ཆག།",
    "ཚོང་འདུས་གཞིས་བཞེངས་ཕྱིས་ཚེ་སྦྱོང་གི་སེ་ར་ཕུག་པར་བཞུགས་རྣས་ཐང་དུ་བྱོན་པའི་ལམ་དུ་གྲོངས་ཏེ་ཀླུ་མེས་དང་གྲུ་མེར་གཉིས་ཀའི་གདུང་མཆོད་རྟེན་འོད་འབར་ནས་ཉམས་པར་བཞུགས།",
    "དགུང་ལོ་དོན་དགུ་ལ་མཁན་བུ་ཅིག་གིས་སྟེང་ཐུར་བརྒྱབ་པ་ཐལ་ནས་གཤེགས།",
    "ཐོག་མ་ལྷ་ཁང་དང་མོན་གྲ་བཟུང་།",
    "རག་ཤེས་ཕུང་འོག་གི་ལྷ་ཁང་བརྩིགས།",
    "ལ་བློ་གྲོས་གཞོན་ནུས་ཇོ་མོ་བརྩིགས།",
    "མགོ་བ་ཡེ་ཤེས་གཡུང་དྲུང་གིས་སྦེ་ལྷ་ཁང་བཟུང་།",
    "ཕྱིས་སྟག་ཚལ་དཀྱུས་ཐང་བཞེངསནས་ཨ་མས་ལ་ཕུལ།",
    "དེའི་མཁན་བུ་སྤང་འདུལ་འཛིན་གྱིས་སྟག་གི་སྐྱེན་ན་བཟུང་།",
    "འདིས་བལ་པོ་ཛ་ཡ་ཀཱ་ར་ལས་དག་སློང་གི་ཀཱ་རི་ཀ་དང་ཁ་ཆེ་པ་ར་ཧི་ཏ་དང་མདཱཛན་ལས་དགེ་ཚུལ་གྱི་བསླབཔའི་གཞི་མང་གསན།",
    "དགའ་བ་གདོང་དུ་ཐལ་ཉལ་བྱས་ནས་ཀློག་བསླབས།",
    "གྱུངམོ་ཆེ་པ་ལ་སེང་གེ་ཟིལ་གནོན་གྱིས་ཐུག།",
    "འཇམ་དབྱངས་རྟ་མགྲིན་སྒྲོལ་མ་གསུམ་རང་རང་གི་རྩ་སྔགས་ཟླ་བ་གསན།",
    "མུ་སྟེགས་དང་རྩོད་ཚེ་ཉིན་མོརྩོད་འན་མ་ཐེབས་པརྣལ་ལམ་དུ་སྒྲོལ་མས་ལུང་བསྟན་ནས་རྒྱལ།",
    "རྒྱལ་པོ་སེགས་ཐམས་ཅད་ཀྱིས་གཙུག་གི་ནོར་བུར་བསྐུར།",
    "གར་ལོག་གི་དམག་གིས་ཡུལ་དབུས་བརླག་ཚརྗེ་བཙུན་མས་རིགས་ཀྱི་བུ་ཁྱོད་ཤར་ཕྱོགས་སུ་སོང་ཞིག་གསུང་སྟེ་བྱིན།",
    "རིང་ཞིག་དུས་ནས་ཁྱོད་ཀྱི་མཚན་ཙམ་ཐོས་པས་ཀྱང་།",
    "ཀྱེ་མ་ཁྱོད་ཐབས་ཐུགསརྗེ་གང་ལགས་བདག་ལ་གསུངས།",
    "ཐུགས་རྗེ་ཆེན་པོའི་སྐུའང་ཤིང་རྟའི་གཟེར་ཆག་སྟེ་ཞབས་གོང་བོར་སོང་།",
    "གི་དགྲ་བཅོམ་པའི་ཞལ་འ་ས་ཧ་ཨམ་བན་ཡང་བལྟས་དགྲ་བཅོམ་པ་ཡིན་ནམ་མ་ཡིན་གཏན་ལ་འབེབས་པའིརབམཆོག་རབམཆོག་བརྟག་དཔྱད་མར་དུ་སྦྱར་ཡོད་པ་ལེགས་པར་བྱས་ནས་ཡིད་ཆེས་ཏེ་དེ་ཉིད་ཏུ་དབྱར་ཟླ་བ་གསུམ་ཚུལ་དུ་ཞུགས་སོ།",
    "ཐལ་སྦྱར་གདུགས་དང་རྒྱལ་མཚན་ཐོགས།",
    "རང་གི་ཚོགས་ཀྱི་འཁོར་དང་བཅས།",
    "མུ་སྟེགས་ཀྱི་བསྐྲད་ལས་བྱུང་ཀྱང་ཟེར་སྟེ་མངའ་རིས་སུ་ལོ་ཙཱ་བ་ཐོག་གིས་ཤི་པཎྜི་ཏ་གཉིས་བོད་། དུ་སྐད་མི་མཁྱེན་པསའཁྱམས་སྨྲི་ཏིས་རྟ་ཤག་དུ་རྫི་བོ་མཛད།",
    "ཛ་གདྡྷི་ཏ་སཾ་ནན་འདི་ནི་སྤྱན་རས་གཟིགས་ཀྱི་སྤྱན་གཡས་པའི་སྤྱན་ཆབ་ལས་བྱུང་།",
    "ཝ་ར་ཎ་སིའི་རྒྱལ་པོའི་བཙུན་མོ་ཆུབ་མ་འོད་ཟེར་ཀུནནུ་མཛེསཾ་མའི་སྲས་སུ་འཁྲུངས།",
    "དེས་མཁས་པ་མང་པོ་སྤྱན་འདྲེན་ཞིང་ཁྱོད་ཀྱང་སྤྱནུའདྲེན་བ་འགྱུར་བས་སོང་ལམ་ནས་ཐུགས་རྗེ་ཆེན་པོ་དང་གསང་བ་པགས་ཀྱི་ཏིང་ངེ་འཛིན་གྱིས་ཐུལ་ཞིག་། ཞེས་གསུངས་ནས་སློབ་དཔོན་པདྨ་ཉིད་ལ་ཐིམ་པའི་སྣང་བ་བསྟན།",
    "ཙཀྲ་ཝཎྜིམ་ཆུང་བྱ་བཏ་པ་སི་གཉིས་ཀྱིས་ཕྱུགས་བདགལ་ཕྱག་གསེར་གྱི་སྒོ་ལའི་རྩེ་མོར་སྐྱིལ་ཀྲུང་བཅས་སྟེ་མུ་སྟེགས་ཀྱི་རྣལ་འབྱོར་པ་ནུས་པ་ཅན་རྩོད་པ་འཛནུས་པས་ཕམ་པར་མཛདསྐོར་བ་ལ་བྱོན།",
    "གུ་ལང་དུ་མུ་སྟེགས་ཀྱི་རྟེན་ཕྱུགས་བདག་རང་བྱུང་གི།",
    "ལ་སྟོད་གཙངམོའི་མིན་པོ་གདོང་གི་གནས་སུ་སྟོན་པ་ངད་པ་བྱ་བ་ལ་རྗེ་བཙུན་མི་ཏྲ་ཛོ་གི་གནས་ཁང་གཡར་དུ་འབྱོན་གྱིས་ཁྱིམ་བྱི་དོར་གྱིས་བྱ་བ་སྒྲུབ་གསུམ་དུ་བྱུང་།",
    "མཇལ་ནས་ལོ་ངོ་གཉིས་སོང་བ་ན་ཝཱ་ར་ཎ་སིའི་རྒྱལཾ་པོ་ཛ་ཡ་ཙན་བྱ་བ་ཛམ་གླིང་ན་ཆེ་བ་དེ་དང་དེའི་མག་པ་དབུས་འགྱུར་འཆང་གེ་རྒྱལ་པོ་ཤར་རྟཅན་བྱ་བ་དེ་གཞི་གས་ཏི་ར་ཧུང་ཏིའི་རྒྱལ་པོ་ལ་བཀའ་ཕབ་ནས་དེས་རྗེ་བཙུན་སྤྱན་འདྲེན་པའི་ཕྱརཕོ་ཉ་བ་རལ་སོར་མཁན་ལ་སོགས་པའི་དམག་དཔུང་ཆེན་པོ་སླེབ་སྟེ་སྤྱན་དྲངས་ནས་ཕམ་ཐིང་དུ་གཤེགས།",
    "རྗེ་བཙུན་ཕམ་ཐིང་གི་ཁང་བརྩེགསཅིག་གི་ཡང་ཐོག་གསོལ་ཁང་ན་བཞུགས་པའི་དྲུང་དུ་ཏོལ་ནས་གྲུབ་ཐོབ་འདི་ལྟ་བུ་དང་མཇལ་རྗེས་སུ་བཟུང་།",
    "ང་ནི་ད་ལྟ་ལུས་སྲོག་དོར་སྟེ་ཤི་མ་ཐག་པོ་ཊ་ལར་རྗེ་བཙུན་ཉིད་ཀྱི་དྲུང་དུ་སྐྱེ་བ་བྱའོ་སྙམ་དུ་ཚོམ་ཚོམ་མེད་པར་གྱུར་སྟེ་གསེར་གང་ཡོད་སྐུལ་གཏོར་ནས་གཡང་ཆེན་པོ་ལ་རྒྱང་གིས་འཕྱོངས་པ་དང་རྗེ་བཙུན་གང་ནས་བྱིན་ཆ་མེད་པར་བར་སྣང་ལ་རྒྱང་བྱོན་སྟེ་ལོ་ཙཱ་བ་ཆེན་པོའིཕྱག་ནས་བཟུང་སྟེ་ཨ་ཧ་ཧ་དེ་ཙུག་མ་བྱེད་ཁྱོད་ཀྱི་འདོད་པ་ངས་སྙབ་གསང་ལུ་རྒྱལ་པོ་ཟླ་བ་ལ་ཕན་བདེ་མཛད།",
    "ཡོ་བྱད་བྱ་བ་དང་ཏི་ཏི་ར་ཀུ་ར་བྱ་བའི་གྲོང་པ་གཉིས་ཀྱིས་ཡུལ་ལོག་བྱས་སྟེ་མི་ཏྲ་ཡེ་གི་འདི་སྔར་ཡང་བསད་པས་ཡང་ཡང་ལོག་ཟེར་བས་ད་རེས་མི་ལྡོག་པར་བྱ་ཟེར་ནས་སྐུ་སྟོད་སྨད་ཕྲལ་དབུ་བྱེ་མའི་གསེབ་ཏུ་སྦསཔས་ཞག་བདུན་ན་སྐུ་སྟོད་སྐུ་སྨད་དབུ་དང་བཅས་པ་འདུས་ལྟ་ཅེར་བུར་བྱོན་ནས་བྱག་པ་རྣམས་ལ་ཟས་སློངས་པས་བྱག་པའི་ལག་ནས་ནོར་རྣམས་ཆ་མེད་ཏུ་སོང་བ་ཁོང་རང་གི་ཕྱག་ཏུ་འདུས་ནས་གསེ་ཕང་ཏུ་བཏུམས་དབྱུག་པའི་ངོས་གཉིས་སུ་བཀལ་སྟེ་རྣམས་བགོས་མི་ཏཱ་རྫོག་སྒྱུ་མའི་མི།",
    "མཁས་པའི་རྒྱ་སྐར་འགའ་ཞིག་གིས།",
    "ང་དཔྱོད་ལྡན་མང་ཞིག་གི་ལྟ་བ་དྲང་པོར་མཛད་ནས་བལ་པོར་གཤེགས་སྟེ་པཎྜིཏ་ཚད་ལྡན་བོད་ཏུ་བྱན་པ་དེང་སང་ཡན་ལའདི་རྟིང་མ་སྣང་ངོ་དྷརྨ་ཀོ།",
    "སྦྲང་རྒྱ་ར་ལེགས་གཟིགས།",
    "བྲན་ཀ་མོ་ཏིཀ་་ཁོན་ནཱ་གིནྡྲ་རཀི་ཏ།",
    "དེའི་ལོ་ཆུང་ལེགས་པའི་ཤེས་རབ་ཀྱིས་ཀྱང་བདེ་མཆོག་གི་སྐོར་མར་དུ་སྨུག་དུང་སྒྲུབ་པ་རྩེ་གཅིག་མཛད་སྟེ་སྐུ་ལུས་འདིས་མཁའ་སྤྱོད་ཏུ་བྱོན་ནོ།",
    "དོན་ཞགས་ལ་གཙོ་བོར་མཛད་ནས་ཐུག་། ཟེརྨ་པོ་ཞལགཟིགས།",
    "བདེ་མཆོག་གི་བསྙེན་པ་བྱས་པས་ཡི་དམ་གྱི་ལུང་བསྟན་བྱུང་ནས་སྦྱོད་པ་ལ་དུར་ཁྲོད་གསིལ་བ་ཚལ་དུ་ཕྱིན།",
    "ཉི་མ་རེ་རྫོགས།",
    "རོག་བུདྡྷ་པཱ་ལ།",
    "མཆོག་གི་རིག་པ་གྲུབ་པ་ཐམས་ཅད་ལ།",
    "གསང་སྔགས་སྔ་འགྱུར་གྱི་ཕྱོགས་ལ་འགོས་ཁུག་པ་ལྷ་བཙས་སོགས་ཀྱིས་མཛད་ཏོ་བར་གྲགས་པའི་སྔགས་ལོག་སུན་འབྱིན་དུ་འདོད་པ་དུ་མར་བཀའ་བསྟན་བཅོས་ཁུངས་མ་མིན་པར་སྨྲ་བ་བྱུང་བ་རྣམས་ནི་བདག་གིས་ཀྱང་གཞན་དུ་ལན་བཏབ་ཟིན་ཅིང་སྤྱིར་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྔགས་ལོག་སུན་འབྱིན་དང་ལྷ་ཞི་བ་འོད་ཀྱི་འཛམ་ཡིག་སོགས་ནི་ར་རྙིང་གང་གི་འང་རུང་སྟེ་སྦྱོར་དགྲོལ་ལ་སོགས་པའི་སྔགས་སྦྱོང་ས་སྐྱེས་སྒྲ་ཇི་བཞིན་དུ་སྤྱོད་པ་འགོག་པ་ཡིན་གྱི་གསང་སྔགས་རྙིང་མའི་རྩ་བ་འགོག་པ་མ་ཡིན་ལ།",
    "ཡེ་ཤེས་སེམས་དཔའ་གང་རེག་པ།",
    "ཇོ་བོ་རྗེས་བསམ་ཡས་སུ་རྒྱ་དཔེའི་དཀོར་མཛོད་གཅིག་ཁ་ཕྱེ་ནས་གཟིགས་པས་སྔར་གསན་གཟིགས་མེད་པའི་རྒྱུད་ཤིན་ཏུ་མང་བར་གཟིགས་ཏེ་ས་ཛམ་གླིངན་གྲགས་པའི་རྒྱུད་རྣམས་སུ་མ་ཟདམཁའ་འགྲོམས་བསྟན་པ་ཁོན་ཡང་མཐའ་ཡས་པར་མཐོང་སྟེ་དེ་ཀུན་ལ་ཡང་རྒྱུད་འདི་རྣམསམི་གདའ།",
    "གལསྟེརྙིང་མ་བཀའམོན་ནམ་འོངས་པ་གསང་སྔགས་རྙིང་མའམ་རྫོགས་ཆེན་བྱ་བ་བཀའ་མ་ཡིན་པ་བཀའ་ལྟར་བཅོས་པ་འབྱུང་ཞེས་ལུང་སྟོན་རིགས་པལས་ད་ལྟར་བསྟན་པ་མུ་ཙུང་བའི་ཕྱིར་དང་།",
    "སྐད་ཅིག་གཅིག་གིས་བྱེ་བྲག་ཕྱེད།",
    "རང་གི་འདུལ་ལ་སྣང་ཕྱིར་དང་།",
    "སྲོལ་པའི་རྡོ་རྗེ་ཀརྨར་བཞུགས་དུས་ཀུན་བཟང་གི་དགོངས་པ་མཐར་ཐུག་རྫོགས་ཆེན་ཐོད་གྱི་རྟོགས་པ་མངོན་དུ་གྱུར་ནས།",
    "སྦྱན་རས་གཟིགས་ཀྱིས།",
    "ང་དང་ཁྱོད་གཉིས་ཁྱད་པར་མེད།",
    "དུད་འགྲོས་སེང་གེ་ལ་སོགས་པ་རང་རང་གི་གཙོ་བོར་མཐོང་སྟེ་སྐག་པས་དེས་བསྟན་པ་ལས་འགོང་མི་ནུས་པ་དང་།",
    "ཡི་དགསརྣམས་ཀྱིས་གཙོ་མོ་ཁ་འབར་མ་ལྟ་བུར་སྣང་སྟེ་སེར་སྣའི་ཉེས་པ་སྟོན་པ་དང་།",
    "དེའི་སྣང་ཆ་ལ་མཚན་དཔེ་ཕུན་སུམ་ཚོགས་པ་རྡོ་རྗེ་འཆང་གི་སྐུར་བྱུང་སྟེ་སྟོན་རྡོ་རྗེ་ཕུལ་ནས་སེམས་སྐྱེད་པའི་རྒྱ་ལས་སོ།",
    "འདི་སྐད་བདག་གིས་བསྟན་པའི་དུས་གཅིག་ན།",
    "དེ་ལྟར་བསྟན་པའི་བཙས་དེ་དག་ནི་རང་བཞིན་རྫོགས་པ་ཆེན་པོའི་ལུང་རྟོགས་ཀྱི་བསྟན་པ་གར་ཡོད་ཏུ་གནས་པ་སྟེ་ཐལ་འགྱུར་ལས།",
    "གེ་སློང་དག་གིས་འཛིན་པར་འགྱུར།",
    "བློ་གྲོས་བཟང་པོ་ནི་འདི་འཛིན་པ་ཐམས་ཅད་དང་ལེ་ལྔ་བརྒྱ་ནི་ལོ་ཆེན་སྟེ་ལྔ་བརྒྱ་ལྔ་བརྒྱར་ལོངས་པའོ་ཞེས་ཀློང་ཆེན་པས་བཤདཔ་ལྟར་ན་ལྔ་བརྒྱ་ཕྲག་རེ་ལལོ་རེར་བརྩི་བ་ཡིན་ནམ་སྙམ་མོ།",
    "ཐལ་འགྱུར་ལས།",
    "ཛམྦུ་གླིང་གི་ནུབ་ཕྱོགས་སུ།་།",
    "རྒྱལ་པོ་ལག་པ་སོར་མོ་དྲུག།",
    "དེ་ནས་གངྒཱའི་འགྲམ་དུ་རྒྱུལ་པོ་དཔུངཔ་ལྗང་གུ་ལྔ་རབ་བྱུང་གི་གཟུགས་སོར་བཞི་ཡོདཔས་ལོ་དྲུག་བརུ་མུན་པ།",
    "དེནས་བྲོག་མ་ལའི་གཙུག་ལག་ཁང་གིས་བདག་བ་གཞོན་ནུའི་མགོན་གྱིས་སྒྲོན་མེ་ལོ་སྟོང་།",
    "སྒྲོན་མེའི་བསྟན་པ་ཐམ་ད་ལྟའི་འདི་ཉིད་འཛིན་པ་པོ་ལུད་བསྟན་པ་ནི་ཐལ་འགྱུར་ལས།",
    "ནུབ་ཕྱོགས་ཨོ་ཅན་དག་གི་ཡུལ།",
    "དེ་འོག་ཡོ་གི་པྲ་བས་འཛིན།",
    "དེ་ནས་བློ་གྲོས་མཆོག་གིས་འཛིན།",
    "དེ་ཡང་སྤྱིར་ཚེ་ལོ་དཔག་མེད་ནས་ཚེ་ལོ་སྟོང་གི་བར་ནི་སྐུའི་བསྟན་པའི་དུས།",
    "དེནས་བདུན་བཅུའི་བར་གསུང་གི་བསྟན་པ།",
    "རྒྱུད་ཀྱི་རྒྱལ་པ་ཐལ་འགྱུར་བཤད།",
    "གཉིས་པ་ལོ་བྱེ་བ་གཅིག་གི་ཚེ་སྟོན་པ་ཁྱེའུ་འོདམི་འཁྲུགས་པ་ཉིད་འོདལྔའི་སྒོ་ང་ལས་འཁྲུངས་ཏེ་འཁོར་མཁའ་འགྲོ་མ་འབུམ་ཕྲག་གཉིས།",
    "དེ་ལྟར་སྐུ་གསུམ་པོ་རེ་རེ་ལ་ཡང་སྐུ་གསུང་ཐུགས་ཀྱི་མཛད་པ་གསུམ་རེ་དང་དེ་རེ་རེ་ལ་ཕྱི་ནང་གསང་བ་ཡང་གསང་གི་མཛད་པ་བཞི་རེ་ཡོད་པས་སྐུ་གསུམ་པ་རེ་རེ་ལ་སོ་སོའི་མཛད་པ་ས་དྲུག་རེར་རྣམ་པར་འཇོག་ལ།",
    "ཛམ་གླིང་གི་གྲུབ་པའི་གནས་དེ་ཐམས་ཅད་ཏུ་བཱིམ་ལས་སྤྱོད་པ་མཛད་ལ་ཙརིན་ཡང་མུ་སྟེགས་ཀྱི་རྣལ་འབྱོར་པ་བཏུལ་བའི་བཱི་མ་ལའི་ཞབས་རྗེས་ཡོད་ཏོ།",
    "དེས་གཞོའི་ལྡངམ་དགེ་མཆོག་གི་བུ་གནས་བརྟན་ལྡང་མ་ལྷུན་རྒྱལ་ལ་བཤད།",
    "གསུང་གི་མངའ་བདག་ཐམས་ཅད་ཀྱིས།",
    "ཐུགས་རྗེའི་རང་བཞིན་ཁྱོད་ཡིན་པས།",
    "གསུང་གི་མངའ་བདག་ཐམས་ཅད་ཀྱི།",
    "ཚིག་གི་སྤྱོད་ཡུལ་མ་ཡིན་པས།",
    "བདག་གིས་སྒྲོགས་པར་ཤིན་དུ་དཀའ།",
    "ཆུ་ཆུན་མ་ལ་ཕྲན་དུ་མང་བསྲིངས་ཀྱངམ་གྲུབ་ནས་བརོས་ལྟ་སྟངས་ཀྱིས་ཆུ་བན་ས་ལ་སྦྱར་བས་འཁུར་མ་ནུས་ནས་ཁྱོད་ཀྱང་རྫུ་འཕྲུལ་དང་ལྡན་པར་གདའ་སྟེ་བདག་ལའང་འདི་ལྟ་བུ་ཡོད་ཟེར་ནས་མེས་རང་གི་བྱང་ཁོག་བྱ་བས་རྡོ་རྗེ་དབྱིངས་ཀྱི་ལྷ་ས་བདུན་བཀྲ་ལམ་མ་བསྟན་ཐབས་ཀྱིས་ནང་དུ་གཏོལ་བར་གྱིས་ལ་བཱི་མ་ལ་ལ་སོགས་པའིམཁས་པ་རྣམས་བཞུགས་པ་ལ་ཕྱག་གྱིས་བརྡ་འདི་བསྟན་པ་ལ་ལན་འདི་གྱིས་བསླབས།",
    "ཞེསས་བརྒྱད་པའི་བྱང་སེམས་གཅིག་གིས་བླངས་ཏེ་ཐ་ཁེབརྒྱལ་པོ་སྤྱན་རས་གཟིགས་ཀྱི་སྤྲུལ་པ་ལ་སྟོན།",
    "ལ་ལ་བྲོལ་ཞིང་བཀའ་ཉམས་ནས་གླེགས་བམ་མང་པོ་བྲིས་ཏེ་སྣོད་མིན་གྱི་ལག་དུ་འགྲིམས་ནས་དེས་མན་ངག་ཉམས་ལྷ་སྲིན་རྣམས་འཁྲུགས་ཏེ་བསྐལ་པ་ཕྲ་མོ་འཇིག་གོ།",
