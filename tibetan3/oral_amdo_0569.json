    "རྟ་རེས་བང་རེ་བརྒྱུགས་པ་ཡནི།",
    "གཉེར་སྟག་བཙན་གདོང་གཟིགས།",
    "སེང་མགོ་ལྷ་ལུང་གཟིགས།",
    "མཆིམས་ལེགས་གཟིགས་སོགས་མང་ཞིག་གིས་མཤེས་སོ།",
    "སད་མི་བདུན་ཡིན་ཟེར་རོ་ཞེས་ཁྲི་གཟིགས་དང་པོ་དང་གསུམ་པ་གཉིས་ཀར་ལན་རེ་གྲངས།",
    "མྱུར་དེ་དུས་སུ་མི་སུམ་བརྒྱ་རབ་ཏུ་བྱུང་ནས་དབུ་རྩའི་བྱ་འདབ་དང་མཆོད་རྟེན་ཆེན་པོ་བཞིའི་རྩ་མོ་ལྕགས་ཐག་གིས་སྦྲེལ་དེ་ལ་འཕནམགོ་བཏགས་ཏེ་ན་མཁའ་དར་ལ་བཀྱིག།",
    "སླན་ཆད་ཆབ་འོག་གི་འབངས་ལས་ཕོ་མིག་མི་དབྱུང་མོ་སྣ་མི་བཅད།",
    "ཇོ་མོ་ལྷ་རྒྱལ་གྱི་ཞལ་ནསཀྱངདལྟརཆས་པ་ཟས་སུ་ཅི་གསོལ་གསུང་།",
    "གདན་ནོན་པ་དང་རྒྱས་པ་བམ་པོར་ལ་ཤོག་དྲིལ་རེ་བྱས་ནས་འདོན་སྟེ་ན་མ་རེ་ལ་འབུམ་ཚར་རེ་བཀའ་སྒྲོག་གོ།",
    "དེར་མ་ཚིག་པ་ཤས་ཅིག་མ་བསྒྱུར་བར་ཡོད་པ་འི་ཡིད་ལ་གཅགས་སོ་གསུང་ཞེས་བྲིས་སྣང་མོད་དཔྱད་པའི་གཞིའོ།",
    "ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་ནི་འབྲོམ་སྟོད་གུང་མོ་ཆེར་འཁྲས།",
    "བནགཅིག་གོ་ཆ་ཕུད་པའི་རྨོག་གི་ནང་ན་ཏོག་གི་གཟུངས་བཞུགས་པ་བཀླགས་པས།",
    "ཡར་གྱི་གནམ་སྒོ་བྱ་བས་གྲུབ་པ་ཐོབ་པའི་གནས་སུ་བཟང་བར་གཟིགས་ནས་ཡབ་མཆེད་རྣམས་ཚུར་སྤྱན་དྲངས།",
    "བྲག་ལྷ་བྲག་ཕུག་བྲུས་པས་བྲག་སྲིན་མོལངས་པ་དང་རྣལ་འབྱོར་སཕག་གི་མཆོད་རྟེན་བཞེངས།",
    "མཚོད་རྟེན་བཞེངས་ཏེ་དབྱར་ཟླ་འབྲིང་པོཉའི་ཉི་ཤར་ལ་ཏོག་གི་གྲབསོ་ཕོག་སར་ཡབཀྱི་མྱུར་བཞུགས།",
    "སྦལ་དགེ་རགས་ཀྱིས་ཐུན་མོང་གི་དངོས་གྲུབ་ཐོབལྟས་ནི་མཁའ་ལ་འཕུར་ནས་འཁར་བུམ་དང་ལྷ་ལ་ཆགས་པས་ས་ལ་ལྷུང་།",
    "ངན་ལམ་གྱི་རྩར་ཕྱིན་པས་ངན་ལམ་གྱིས་གྲོགས་པར་ཤེས་ཏེ་སྟབས་སུ་བསྡད་པས་ཡང་རྔ་མོང་ཆུང་བ་ཞིག་དུ་བྱས་ནས་བསྐོར་བ་ལན་གསུམ་བྱས་ནས་ངན་ལམ་ལ་སྣང་རབ་འདུག་ཟེར་སྐད།",
    "དེའིཆོའབངས་རྣམས་ཚང་མང་རིང་མོ་ལ་བད་གཡམ་གཏོང་ཙམ་ན་ལྷ་ལུང་རབ་འབྱོར་དབྱས་བང་ས་ཕུག་ནབཞུགས་པས་སེར་རྗེ་འཕངས་པབང་ལ་ཕོག་པ་དང་།",
    "ལྷ་ལུང་དཔལ་རྡོར་གྱི་ཐུགས་དགོངས་ལ་རབ་འབྱོར་དབྱངས་འདི་རེད་དཔུན་གསུམ་ཀྱི་ཆེ་ཤོག་ཡིན།",
    "འོན་ཁྱོད་ང་ལ་ཟ་མ་རེ་བར་འདུག་པས་ཚ་ལམ་བཏོང་བར་སྣང་རྙེད་ཚང་ཁྲུས་ལ་ཚེས་གཅིག་ནས་བརྒྱད་ཀྱི་བར་དུ་ཁ་མ་འབྱེདཔར་ཞོག།",
    "དེ་ཕྱིར་དང་ལྡན་ཁྱོད་ལ་བསོད་སྙོམས་སློང་།",
