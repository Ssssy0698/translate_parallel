    "འགྱོ་ཡྤྱིན་ན་ངྱེས་འབྱུང་གྤྱི་བསམ་པས་ཟྤྱིན་པས་ཁབ་པར་གྲུབ་ལ།",
    "ངྱེས་འབྱུང་གྤྱི་ཚུལ་ཁྤྱིམས་གསུམ་ཡྱོད་པར་སྨྲ་བ་དག་ནྤྱི་མཆུའྤྱི་རྣམ་འགྱུར་ཉུང་ན་ཁ་མཛེས་པ་ཡྤྱིན་ནྱོ།",
    "ཆྱོས་དགྱེ་བ་བཅུ་སྱོད་པ་ཞྱེས་གསུངས་པའྤྱི་དགྱོངས་པ་ཡང་ཡྤྱིན་ལ།",
    "གཏན་ཁྤྱིམས་བདུན་ཆར་མྤྱི་དགྱེ་བ་བཅུ་སྱོང་དུ་གསུངས་པའྤྱི་དགྱོངས་པ་ཡང་དྱེ་཈ྤྱིད་ཡྤྱིན་ནྱོ།",
    "བསྱེན་པར་རྱོགས་པ་དང་མ་རྱོགས་པའྤྱི་སྱོམ་པའྤྱི་ཁད་པར་སྱོང་བདུན་ཀུན་མཁྱེན་གྱོ་རམས་པ། ༣༤",
    "དང་སྱོང་བཞྤྱི་ལ་འཇྱོག་པ་ཡང་མྤྱི་འཐད་པར་འགྱུར་ཏྱེ།",
    "དང་པྱོར་ཡང་དག་པར་བངས་པའྤྱི་ཚེ་ལུས་ངག་གྤྱི་རང་བཞྤྱིན་གྤྱི་ཁ་ན་མ་ཐྱོ་བ་བདུན་ཆར་སྱོང་བ་དང་།",
    "བཞྤྱི་སྱོང་བ་ཡང་དག་པར་བངས་པའྤྱི་སྱོ་ནས་འཇྱོག་པ་ཡྤྱིན་པའྤྱི་ཕྤྱིར་ཏྱེ།",
    "ལུས་དང་ངག་གྤྱི་ལས་སྱོང་བར་བ་བ་ཐམས་ཅད་སྱོང་བ་ཡང་དག་པར་བངས་པས་ནྤྱི་དགྱེ་སླྱོང་ཡྤྱིན་ནྱོ།",
    "ཞྱེས་གསུངས་པས་སྱོ།",
    "གཞྤྱིའྤྱི་དྱོན་གཞྤྱི་བསམ་སྦྱྱོར་བ་མཐར་ཐུག་གྤྱི་ནང་ཚན་དུ་གྱུར་བའྤྱི་གཞྤྱི་ལ་འཆད་པ་ནྤྱི་རྣམ་པར་འཁམས་ཏྱེ།",
    "བུ་སྟྱོན་ཁ་ཆྱེ་སྱོགས་མཁས་པ་རྣམས་ཀྤྱིས་མགྤྱིན་གཅྤྱིག་ཏུ་གསུངས་པ་སྱོམ་གསུམ་སྤྱི་དྱོན།",
    "ཡྱོན་ཏན་དྱེ་དང་དྱེར་སྱོང་བའྤྱི་སྟྱོབས་གྤྱིས་མཚུངས་ལྡན་གཞན་རྣམས་ཀང་ཡྱོན་ཏན་དྱེ་དང་དྱེར་སྱོང་བ་ལ་དགྱོངས་ནས་འདྤྱི་འདའྤྱི་རྤྱིགས་ཅན་མང་དུ་གསུངས་པ་ལས་འདྤྱིར་ནྤྱི་སྱེམས་པ་གཙོ་བྱོ་ཡྤྱིན་པས་དྱེ་དང་མཚུངས་ལྡན་རྣམས་ཀང་སྱོམ་པར་སྱོང་བའྤྱི་དྱོན་ཏྱོ།",
    "འགྱོག་པ་ལ་སྱོམས་པར་འཇུག་པའྤྱི་ཚེ་དགྱེ་སླྱོང་གྤྱི་སྱོམ་པ་མྱེད་པར་འགྱུར་རྱོ་ཞྱེ་ན།",
    "འདྤྱི་དག་ནྤྱི་འྱོག་མ་དག་གྤྱི་སབས་སུ་ཡང་དན་པར་བའྱོ།",
    "སྱེམས་ཅན་ཐམས་ཅད་ཀྤྱི་དྱོན་དུ་རྱོགས་པའྤྱི་ཀུན་མཁྱེན་གྱོ་རམས་པ། ༣༦",
    "སྱེ་སྣྱོད་རྣམ་དབྱེ་མྱེད་པར་ཟད།",
    "ཆྱོས་རྱེ་ས་པཎ་གྤྱིས་སྱེམས་བསྱེད་ཀྤྱི་ཆྱོ་ག་ལས་ཡང་དག་པར་བངས་བ་བརའ་ལས་བྱུང་བའྤྱི་ཀུན་རྱོབ་པའྤྱི་སྱེམས་བསྱེད་པ་འདྤྱི་ལ་མྤྱི་མཐུན་ཕྱོགས་སྱོང་བའྤྱི་སྱེམས་པ་རྒྱུན་ཆགས།",
    "བསླབ་པར་བ་བ་གསུམ་གྤྱིས་ངྱེས་པར་བའྱོ།",
    "རྱོགས་པའྤྱི་བང་ཆུབ་གྤྱི་སྒྲུབ་པ་ཁད་པར་བ་མྤྱི་མཐུན་ཕྱོགས་སྱོང་བའྤྱི་སྱེམས་དཔའ་རྒྱུན་ཆགས་པའྱོ།",
    "ཞྱེས་གསུངས་པ་ནྤྱི་ལུང་ཆྱོས་ལ་འདྤྱིས་ཆུང་བར་ཟད་དྱེ།",
    "དྱེའྤྱི་དྱོན་དུ་སྱོད་པ་སྒྲུབ་པར་འདྱོད་པའྱོ།",
    "སྱོན་པ་མྤྱི་཈མས་པར་བསྲུང་བ་གསུམ་དང་།",
    "འཇུག་པ་མྤྱི་཈མས་པར་བསྲུང་བ་དང་གསུམ་ཡྱོད་དྱོ།",
    "ཞྱེས་གསུངས་པ་ནྤྱི་མདྱོ་རྒྱུད་ཀྤྱི་དགྱོངས་པ་ཕྤྱིན་ཅྤྱི་མ་ལྱོག་པར་ངྱེས་པའྱོ།",
    "དྱེའྤྱི་རྱེས་སུ་འབྲངས་ནས་སྱོན་འཇུག་གྤྱི་སྱེམས་རྐྱང་པ་སྱོམ་པ་མ་ཡྤྱིན་ལ་སྱོན་འཇུག་གྤྱི་སྱེམས་བསྱེད་པ་ལ་མྤྱི་མཐུན་པ་གཞྤྱི་དང་བཅས་པའྤྱི་སྱོང་སྱེམས་ཡྱོད་ན་ག་཈ྤྱིས་ཀ་ལ་ཡང་སྱོམ་པར་འགྱུར་ཏྱེ།",
    "སྱོམ་པའྤྱི་མཚན་཈ྤྱིད་དང་ལྡན་ཡང་སྱོམ་པར་མྤྱི་འགྱུར་ན་སྱོམ་པ་གཞན་ཐམས་ཅད་ཀང་སྱོམ་པར་མྤྱི་འགྱུར་རྱོ།",
    "དྱེས་ན་བང་ཆུབ་སྱེམས་དཔའྤྱི་རྒྱུད་ཀྤྱི་གྱོང་འྱོག་གྤྱི་བསླབ་བ་ཐམས་ཅད་ཀང་བང་སྱེམས་ཀྤྱི་སྱོམ་པར་འདུས་པ་ཡྤྱིན་ཏྱེ།",
    "གྱོང་དུ་གསུངས་པའྤྱི་མཚན་཈ྤྱིད་རྣམས་ཚང་བའྤྱི་ཕྤྱིར་རྱོ།",
    "ཞྱེས་གསུངས་སྱོ།",
    "རྱོགས་པའྤྱི་བང་ཆུབ་ཀྤྱི་སྒྲུབ་པ་ཁད་པར་བ་གང་ཞྤྱིག་མྤྱི་མཐུན་ཕྱོགས་སྱོང་བའྤྱི་སྱེམས་པ་མཚུངས་ལྡན་དང་བཅས་པའྱོ།",
    "གཞན་ལ་ཕན་པ་ཁད་པར་ཅན་བསྒྲུབ་པ་ལ་གཞན་ལ་གནྱོད་པ་སྱོང་བས་ཁབ་པའྤྱི་ཕྤྱིར་རྱོ།",
    "གསུམ་པར་རྤྱིག་འཛིན་གྤྱི་སྱོམ་པའྤྱི་ངྱོ་བྱོ་ནྤྱི།",
    "འདྤྱི་ལ་འགལ་བ་ཅྤྱི་ཀུན་མཁྱེན་གྱོ་རམས་པ། ༤",
    "ཞྱེས་གསུངས་ལ།",
    "ཞྱེས་གསུངས་པ་ནྤྱི་རྒྱུད་སྱེ་བཞྤྱི་ཆར་ལ་འཇུག་སྟྱེ།",
    "དྱེའྤྱི་སྔགས་ཡྤྱིན་ལ་དྱེ་འཛིན་པ་ནྤྱི་བསྱོམ་བཟླས་ཀྤྱི་སྱོ་ནས་དྱེ་མ་཈ྱེས་པར་བྱེད་པའྱོ།",
    "ཞྱེས་གསུངས་པ་ནྤྱི་རྤྱིག་པ་འཛིན་པའྤྱི་཈མས་ལྱེན་ཙམ་ལ་དགྱོངས་པར་སྣང་ཞྤྱིང་།",
    "དྱེ་འཛིན་པ་ནྤྱི་སྒྲུབ་པར་བྱེད་པ་དང་།",
    "བསྒྲུབ་པར་བས་པ་ག་཈ྤྱིས་ལ་འཇུག་གྱོ།",
    "ཡྤྱིད་མཚན་རྱོག་ལས་སྱོབ་པའྤྱི་ཐབས་ཁད་པར་ཅན་གང་ཞྤྱིག་མྤྱི་མཐུན་ཕྱོགས་སྱོང་བའྤྱི་སྱེམས་པ་མཚུངས་ལྡན་དང་བཅས་པའྱོ།",
    "སྱོབ་པའྤྱི་ཐབས་ཞྱེས་པ་སྱོབ་པར་བྱེད་པ་དང་།",
    "དཔྱེར་ན་རྱོགས་པའྤྱི་བང་ཆུབ་ཀྤྱི་སྒྲུབ་པ་ཁད་པར་བ་དྱེ་བསྒྲུབ་བ་དང་སྒྲུབ་བྱེད་ག་཈ྤྱིས་ཀ་སྱོམ་གསུམ་སྤྱི་དྱོན།",
    "རྱོག་པ་ནྤྱི་དྱེ་དང་དྱེར་མངྱོན་པར་ཞྱེན་པ་སྟྱེ་འདྤྱི་ལ་ཐ་མལ་གྤྱི་མཚན་མ་ལ་མངྱོན་པར་ཞྱེན་པ་དང་ལྷའྤྱི་མཚན་མ་ལ་མངྱོན་པར་ཞྱེན་པ་ག་཈ྤྱིས་ཡྱོད་དྱོ།",
