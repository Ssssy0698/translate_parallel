    "རྗེ་སེམས་དཔའ་ཆེན་པོ་རང་གི་མནལ་ལམ་དུ་ཡང་།",
    "དེ་ཉིན་ནས་གཟུང་ཉི་མ་གཉིས་གསུམ་གྱི་བར་ལ་བླ་བྲང་གི་ཕྱི་ནང་གི་རྫས་རྣམས་རྩིས་སྤྲོད་ཀྱི་ཞལ་བཀོད་གནང་སྟེ།",
    "དུས་ཁོར་མོ་ཡུག་ཏུ་ཕྱི་ནང་གི་སྤྲོས་པ་ཐམས་ཅད་བཅད་དེ་གཅིག་ཏུ་དབེན་པ་ལ་ཐུགས་གཞོལ་བའི་ཚུལ་གྱི་ཐུགས་དམ་ཉམས་བཞེས་རྣམས་ལ་སྔར་ལས་ཀྱང་བརྩོན་པ་ཆེས་ཆེ་བའི་ཉིན་མཚན་ཀུན་ཏུ་རྟག་འགྲུས་སུ་མཛད་པ་ཡིན་ལ།",
    "དེར་སྐབས་ཞལ་སློབ་འགའ་ཞིག་གིས་ཞབས་དྲུང་དུ་མཇལ་བར་ཕྱིན་པ་ན།",
    "རྗེ་ཉིད་ཤིན་ཏུ་དགེས་པའི་གསུང་གིས།",
    "ལུགས་གཉིས་ཀྱི་མཁྱེན་རབ་སོགས་གང་ས་ནས་ངེད་གདན་ས་པ་རྣམས་རེ་ཆེ་བ་རང་ཞིག་ཡོད་པ་ཡིན་ཏེ།",
    "དོན་ལ་ཡང་ཁོང་ཚོ་ཇི་ལྟར་ཟེར་བ་བཞིན་བདེན་གྱི་ཡོད་པ་འདུག་པས།",
    "རང་རེ་རྣམས་ཀྱིས་ཐོབ་པ་འདི་སྐལ་བ་བཟང་པོར་ཤེས་པ་དང་།",
    "དེ་འདྲ་རྟོགས་མཁན་རེ་རེ་ཙམ་ལས་ཡོད་པ་དཀའ།",
    "དེ་དག་གི་རྒྱ་བོད་ཀྱི་ཡི་གེ་མན་ངག་རྣམ་གྲངས་མང་པོ་དང་བཅས་པ།",
    "ནོར་ལྷ་དབྱུ་གུ་མ་མཆེད་གསུམ་སོགས་ཀྱི་ཚེ་སྒྲུབ་དང་ནོར་སྒྲུབ་ཀྱི་མན་ངག་གི་རིགས་དུ་མ།",
    "མཚན་བརྗོད་ལ་སོགས་ཏེ་བཀའ་དང་བསྟན་བཅོས་བགྲང་བ་ལས་འདས་པ་ཞིག་གི་དག་གསལ་ལུང་གི་བཀའ་དྲིན་མུ་མཐའ་མེད་པ་ཞིག་སྩལ་ཅིང་།",
    "དེ་ནས་ས་སྐྱ་པའི་ཐུན་མོང་མ་ཡིན་པའི་བློ་སྦྱོང་ཞེན་པ་བཞི་བྲལ་གྱི་ཁྲིད་དང་།",
    "གཞུང་དྲུག་གི་མཆན་རྣམས་མལ་ལོ་ནས་ས་ཆེན་ཡབ་སྲས་ཀྱི་བར་གྱི་གསུང་མཆན་ཁོ་ན་དང་།",
    "རིམ་བཞི་ལམ་སློང་གི་མཆན་རྣམས།",
    "རྫོགས་རིམ་ཟབ་མོ་རིམ་པ་ལྔའི་ཁྲིད།",
    "དེའི་དྲུང་དུ་བདག་ཅག་གིས་ཐོབ་པར་བྱས་པ་ལགས་ཤིང་།",
    "སེམས་དཔའ་ཆེན་པོ་གཞོན་ནུ་རྒྱལ་མཆོག་གིས་བསྒྲིགས་པའི་བློ་སྦྱོང་གླེགས་བམ་གྱི་ལུང་།",
    "རྗེ་བཙུན་རྡོ་རྗེ་འཆང་གི་ཐུགས་དམ་ཐང་ག་ལམ་འབྲས་བརྒྱུད་པ་སོགས་མཐའ་དག་ལ་གཟིགས་ནས་བཀོད་པ་རྣམས་ཀྱང་རེ་རེ་ནས་ཡི་གེར་འགོད་པར་མཛད་ཅིང་།",
    "ཁྱད་པར་ཨེ་ཝྃ་དཔེ་ཁང་གི་རྗེ་རྡོ་རྗེ་འཆང་གི་ཕྱག་དཔེ་མ་ལུས་པ་ལ་དགོངས་པའི་ཆ་རྨད་དུ་བྱུང་པའི་ལེགས་པར་མཐའ་ཆོད་པའི་གཟིགས་ཡུལ་ལ་ནན་ཏན་དུ་འགྲུས་པར་མཛད་དེ།",
    "ཕྱིས་དགུང་གི་ལོ་མཐོན་པོར་སོན་པ་ན་ཡང་ཡིག་ཕྲེང་ཕྲ་མོ་ཚུན་འདི་ན་འདི་ཡོད་ཀྱི་ཚུལ་མ་བསྙེལ་བ་གསུང་རྒྱུ་ཡོད་འདུག་ཅིང་།",
    "རྗེ་རྡོ་རྗེ་འཆང་གི་གཟིམ་ཆུང་དུ་སྐུ་མཚམས་ཤིན་ཏུ་དམ་པའི་ཐུགས་དམ་ཞིག་གནང་བའི་དུས་ཀྱི་མནལ་ལྟས་ལ་ས་སྐྱའི་དཔོན་པོ་རི་ཡིན་ཟེར་བ་མངའ་རིས་ཚུན་མཐོང་བ་ཞིག་གི་རྩེར་ཕེབས་པ་ན།",
    "བརྩོན་ལྡན་ལ་ཚེ་གཅིག་གིས་གྲོལ་བ་སྟེར་བའི་ལམ་མཆོག་རྨ་མེད་པ།",
    "དེ་རང་གི་འགྲེལ་བྱེད་དུ་གྱུར་པའི་རྒྱ་བོད་ཀྱི་མཁས་གྲུབ་གོང་མ་དག་གི་ཕྱག་བཞེས་ལས་བྱུང་བའི་རྒྱུན་མ་ཉམས་ཤིང་།",
    "དེའི་དུས་ཀྱི་གསུང་རྒྱུན་ལ་སླར་ཞུ་དག་མགོ་མཇུག་གི་ཚིགས་སུ་བཅད་པས་བརྒྱན་པ།",
    "ཚུལ་དང་པོ་གཉིས་ཀྱི་གསལ་བྱེད་དུ་གྱུར་པའི་བསྟན་བཅོས་སྤྱི་རྣམ་ཟུར་འདེབས་ཟབ་དོན་ཉིན་མོར་བྱེད་པའི་སྣང་བ་དང་།",
    "རྗེ་ལྕགས་ཐང་པ་སོགས་མང་པོ་ལ་གནང་ཚོད་དུ་གདའོ།",
    "ས་སྐྱ་པ་ཀུན་གྱིས་རེ་ལྟོས་འཆོལ་བ་ཞིག་འོང་བས།",
    "དེ་དུས་འཁོར་ལོ་བདེ་མཆོག་གི་རྒྱུད་འདི་རྣམས་གསང་སྔགས་བདེ་ཆེན་གླིང་དུ་རྒྱུད་འདོན་ཐབས་རྒྱས་པ་རེ་རྩོམ་ལ་ཚུགས་མཛོད་ཅིག་གསུངས་བྱུང་པ།",
    "དེ་དག་གི་ཆོ་ག་ཐུན་མོང་པ་རྣམས་མི་འགལ་ཞིང་།",
    "ཐུན་མོང་མ་ཡིན་པ་རྣམས་མ་འདྲེས་པའི་ཚུལ་ལས་བརྩམས་ཏེ།",
    "དེ་དུས་མུས་ནང་གི་འབྲུམ་པ་མྱུར་དུ་ཆད་ཅིང་།",
    "སྐུ་གདུང་བཏུལ་མ་མཚོན་ཙམ་ཞིག་རྗེ་འདི་ལ་ཕྱག་ཚ་ཞུ་འདོད་ཀྱིས་བདག་གིས་མུས་སུ་ཁྱེར་བ་དེ་ཉིན་གཅིག་འཇིམ་པ་བུང་ཆེ་བ་དང་བསྲེས་ནས་རྗེའི་ཞབས་དྲུང་དུ་ཁྱེར་དེ་འདི་ལ་ཕྱག་ཚ་གནང་དགོས་ཚུལ་ཞུས་པས།",
    "ཕྱག་ཚ་མཆོད་དགུ་མ་ཆེ་བ་བརྒྱད་གནང་སོང་བས།",
    "བསམ་པ་ལ་རང་གི་མོས་དད་ཀྱི་སྐུ་གདུང་ཆེད་གཏད་ཁྱེར་ནས་འཇིམ་པ་བུང་ཆེ་བ་བྱས་པ་དེ་ལ་ཕྱག་ཚ་ཡང་གྲངས་མང་ཙམ་ཞིག་གནང་ན་བློ་ཁ་རྫོགས་པ་ཞིག་ཡོང་བ་འདུག་པ་ལ་སྙམ་པ་ཤར་བའི་ཚེ།",
    "དེ་མ་ཐག་བདག་ལ་སྤྱན་ཆེར་གཟིགས་ནས་ཚ་ཚ་བརྒྱད་པོ་འདི་ལས་གྲངས་མང་ཉུང་མེད་པ་རང་ལེགས་པ་འོང་བས།",
    "དེ་ནས་བླ་བྲང་གི་མཆོད་ཁང་གང་རིགས་ཤིག་ཏུ་སྒྲིག་པ་ཞུ་གསུངས་བྱུང་པས།",
    "དེ་དུས་བཀའ་ཕེབས་དང་མཐུན་པར་བླ་བྲང་གི་ལྷ་ཁང་བར་མར་རེ་ཞིག་བཞུགས་སུ་གསོལ་ནས།",
    "གདུང་ཚ་དེ་ལས་གཅིག་གིས་མང་ན་མི་ཤོང་ཞིང་།",
    "དེས་ན་ཕྱག་ཚ་བརྒྱད་ཁོ་ན་མཛད་པ་དེ་ཡང་མ་འོངས་པ་ལྐོག་གྱུར་གྱི་དོན་མཐའ་དག་ཡེ་ཤེས་ཀྱི་སྤྱན་གྱིས་གསལ་བར་གཟིགས་པའི་ཐེ་ཚོམ་དང་ཡིད་གཉིས་མི་དགོས་པ་ཡིན་ནོ།",
    "བདག་གི་སེམས་ལ་ཨེ་མ་མི་ལུས་ལན་ཅིག་ཙམ་ཐོབ་པའི་ནམ་འཆི་ཆ་མེད་འདི་ལ།",
    "དགོས་མེད་ཀྱི་ཚེ་འདིའི་བྱ་བ་རྣམས་རྒྱབ་ཏུ་བསྐྱུར་ནས་ནམ་མཁའ་ལ་འཕུར་བ་སོགས་གྲུབ་རྟགས་སྟོན་ཐུབ་པ་ཞིག་གི་མ་བྱུང་བར།",
    "ཟང་ཟིང་གི་འབུལ་བ་བསྙེན་བཀུར་སོགས་བཟང་འགྲན་ལྟ་བུའི་ཤིན་ཏུ་གྱ་ནོམ་པ་བྱུང་པ་བཞིན།",
    "དེ་ནས་དཔལ་ངམ་རིང་གི་རྒྱལ་ཁབ་ཆེན་པོར་འབྱོར་པའི་ཚེ།",
    "བདག་གིས་ངམ་རིང་རྩེར་བགས་བསང་གི་ཚུལ་དུ་ཞག་བཞི་ལྔ་ཞིག་བསྡད་པའི་དེའི་བར་ལ།",
    "དེ་དུས་མཆོག་ཏུ་དགེས་པའི་གསུང་གིས།",
    "བདག་གི་བསམ་པ་ཡང་དེ་ཀས་རྫོགས་རྒྱུ་ཡིན་པས།",
    "སེར་ཇ་ཡང་འདི་ཀ་ནས་སྔ་མོར་སྦྱར་ཟིན་པས།",
    "དེ་ནས་གདན་ས་གཞུང་གིས་ཆིབས་བསུ་རྒྱས་པ་སེར་འཕྲེང་དང་བཅས་པས་བསུ་བར་མཛད་དེ།",
    "གཟིགས་མ་ཐག་ཞལ་འཛུམ་བག་དང་ལྡན་པས་བསུས་ཏེ།",
    "སྐུ་བརྩེ་བའི་སླད་དུ་བདག་གི་མགོ་བོ་འཐེན་པར་མཛད་ཅིང་བཞད་སྒྲ་སྒྲོག་བཞིན་པ་དང་བཅས་དགྱེས་པའི་མདངས་དུ་མ་ཞིག་མཛད་ཀྱིན་འདུག་པས་ཡིད་ལ་བདེ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་བྱུང་ཞིང་།",
    "ཡབ་རྗེ་ཉིད་ཀྱང་ཐུགས་སྤྲོ་བ་ཆེན་པོའི་གསུང་གིས།",
    "ངེད་ཀྱི་སར་ཁ་ཏོན་གྲུབ་མཚམས་ཁོར་ཙམ་ཞིག་ཡོང་ལུགས་གྱིས་ཤིག་གསུངས་བྱུང་བ་བཞིན་བདག་གིས་ཞབས་དྲུང་དུ་ཕྱིན་པས།",
    "བཀྲས་ཐགས་ཟུང་གཅིག་གོས་ཆེན་ལུ་ཧང་སྤྲིན་ཆེན་གྱི་རི་མོ་ཅན་ཡུག་གཅིག་ཀར་ཡུག་སྤུས་གཙང་རྣམས་གནང་ནས།",
    "ངེད་རང་གི་གཟུགས་པོས་ནམ་ལྕོགས་བར་ཁུར་ཡང་ལེན་པ་དང་།",
    "དེ་ལྟར་བྱས་ན་རང་རེ་ལ་དགྲ་གཉེན་གྲོགས་གསུམ་སུས་ཀྱང་བསམ་ངན་སྦྱོར་རྩུབ་ཀྱིས་མི་ཚུགས་ཤིང་།",
    "བཞི་ཐོག་བླ་བྲང་གི་གཙུག་ལག་ཁང་རྟེན་གསར་བཞེངས་ངེད་ཀྱི་བློ་ལ་ཇི་ལྟར་ཡོད་པ་འདི་རྣམས་ཀྱི་མཇུག་ཁྱེད་ལ་བསྒྲིལ་དགོས་པ་ཡོང་ཞེས་སོགས་གསུངས་བྱུང་པས།",
    "དེ་ནས་མིག་མཆི་མས་གང་ཞིང་སྐད་འདར་བ་དང་བཅས་བདག་གི་ས་ནས་གོང་བཞུགས་ཞབས་དྲུང་གི་བཀའ་གང་ཕེབས་ཞུ་བ་ལས་མ་འདས་འདུག་ཀྱང་།",
    "ལུང་གི་སྐོར་སོགས་གང་ལ་ཅི་འཚམས་སུ་བགྱིས་ཏེ་གནས་པའི་སྐབས།",
    "ས་སྐྱ་ཟེར་བའི་མིང་ཡོང་མོང་ལ་རྒྱས་བྱུང་བས།",
    "དེ་དག་གི་སྐབས་མཚམས་རྣམས་སུ་ཐུགས་དམ་སྒྲིག་རིམ་བྱ་ཚུལ།",
    "ཚིག་གི་ཁྱད་པར་གཅོད་མཚམས་ལ་སོགས་པ་དང་།",
    "དམིགས་ཁྲིད་རྣམས་གནང་བའི་དུས་རང་རང་གི་རྟགས་དང་ཡོན་ཏན་ལ་སོགས་པའི་སྐབས་སུ།",
    "འོན་ཀྱང་བརྡ་ཆིག་བརྒྱུད་ཐུན་མོང་མ་ཡིན་པ་ནི་སླར་བསམ་གཏན་ཕུར་བདག་ཁོ་ན་ལ་གནང་བ་ཡིན་ལ།",
    "ད་རེས་ཀྱང་མགྲོན་གྱི་གཙོ་བོ་ཨ་ཕོ་མཐུ་ཆེན་གྱི་དཔེས།",
    "བདག་གི་སེམས་ལ།",
    "སྔོན་ངོར་པ་རྡོ་རྗེ་འཆང་གིས་གསུང་ངག་བརྒྱད་བཅུ་གྱ་གསུམ་ཙམ་གནང་འདུག་པ་དང་།",
    "བདག་གིས་ད་དུང་བདག་སོགས་ལྟོས་བཅས་དང་།",
    "ཟང་ཟིང་གི་གནང་བྱིན་རྒྱ་དཔངས་ཤིན་ཏུ་ཆེ་བ་སོགས་ཕྱག་ན་ཡོད་པའི་དངོས་པོ་ཡོད་དོ་ཅོག་ཐམས་ཅད་སྦྱིན་གཏོང་དུ་མཛད་ནས།",
    "ངུར་སྨྲིག་འཛིན་པ་མཆོག་གི་ཟློས་གར་མཁན།",
    "ས་སྐྱའི་ཡོངས་འཛིན་མཆོག་གིས་དགོངས་པའི་ཚེ།",
    "མྱུར་དུ་བགྲོད་ནས་གསུང་གི་བདུད་རྩིའི་རྒྱུན།",
    "ཡོངས་འཛིན་ཐུགས་རྗེའི་ལྕག་གིས་ཉེར་བསྐུལ་ནས།",
    "འོད་གསལ་ངང་ནས་གསལ་བར་གཟིགས་པའི་ཚུལ།",
    "བག་དྲོ་གསུང་གི་གདངས་སྙན་དང་བཅས་པ།",
    "ཧྲུལ་པོར་ཞིག་ནས་རེ་ཞིག་ཧད་དེ་ལུས།",
    "ཡིད་ལ་རེ་བ་ཇི་བཞིན་འགྲུབ་པའི་ཚུལ།",
    "ལྷར་བཅས་འགྲོ་བའི་སྐྱབས་གནས་མཆོག་གི་བཀས།",
    "བདག་ལ་རྗེ་བཙུན་གང་གི་སྲས་ཐུ་བོའི།",
    "དུས་དེར་མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་ཚོགས།",
    "ཚེ་འདིར་མཆོག་གི་དངོས་གྲུབ་འགྲུབ་ངེས་པའི།",
    "རྫོགས་ཤིང་སྨིན་པའི་གསུང་གི་གསང་བ་ཆེ།",
    "ཟབ་མོའི་ཏིང་འཛིན་ཏིང་འཛིན་ལ་གཞོལ་བས།",
    "ད་རེས་བྱོན་ཀྱང་ཐུགས་བསམ་འགྲུབ་པ་ཞིག་མི་ཡོང་ཚུལ་སོགས་མཛད་ནས།",
    "འབྲི་གཡག་ལྔ་བཅུ་བསྐོར་གྱིས་གཙོས་པའི་ཟང་ཟིང་གི་འབུལ་བ་རྒྱ་ཆེན་པོ་ཕུལ་ནས་གསོལ་བ་བཏབ་པའི་ངོར།",
    "མ་གཅིག་ཁྲོས་མ་ནག་མོ་ཟབ་དོན་ལུགས་དང་རྒྱལ་ལྡང་པ་བསམ་གཏན་འོད་ཟེར་ནས་བརྒྱུད་པའི་གཅོད་ཁྲིད་རྣམས་སྨིན་རྒྱས་སུ་གནང་བར་མཛད་པ་ཡིན་ཞེས་ཐོས་ལ།",
    "ནཱ་རོ་མཁའ་སྤྱོད་ཀྱི་སྒྲུབ་ཐབས་ཆུང་ངུ་སོགས་རྒྱ་གཞུང་གི་སྐོར་དང་།",
    "བློ་སྦྱོང་གི་ཁྲིད་ཡིག་དཔལ་ཡ་མའི་ལུང་།",
    "གསེར་རྣམས་ཀྱི་ཁྲོད་ནས་ས་སྐྱར་ཞབས་དྲུང་གོང་མ་རྣམས་ལ་གསེར་ཕུད་དུ་ཞོ་རེ་ཞོ་དོ་ཙམ་འབུལ་བར་མཛད་ནས།",
    "ལྷག་མ་ཐམས་ཅད་མུས་ནང་གི་དགོན་ཆེ་ཆུང་རྣམས་སུ་གསེར་འགྱེད་དུ་སྩལ་ཅིང་།",
    "བདག་ཉིད་ཆེན་པོའི་གསུང་གིསདེ་བཞིན་ཅིས་ཀྱང་ཞུ་ཞིང་།",
    "དེ་ནས་ནགས་དགོན་དུ་འཁོར་ལོ་བདེ་མཆོག་གི་གསུང་བསྙེན་ཟླ་བ་དྲུག་པ་ཞིག་མཛད་པའི་ཚེ།",
    "དེ་ནས་རྗེ་འདི་དགུང་ལོ་དོན་ལྔར་སོན་པ་ཨ་ན་ལ་ཞེས་པ་མེ་ཕོ་འབྲུག་གི་ལོ་གསར་དུ་ཤར་བ་ན།",
    "ཕྱི་ནང་གི་བསྐྱེད་རིམ།",
    "དེ་དུས་རང་གི་བློ་ལ་སྣང་གསུམ།",
    "ཕྱག་ལེན་ཕྲ་མོ་ཚུན་ཆད་ཁྱེད་ཀྱི་ཐུགས་ལ་སྤར་བཏབ་པ་བཞིན་བྱུང་འདུག་པ་ཤིན་ཏུ་ངོ་མཚར་ཆེ།",
    "རང་གི་དོན་གོ་བ།",
    "ཞབས་དྲུང་དུ་ཡུན་རིང་དུ་སོང་བ་ན།",
    "དེ་ཡང་སྔོན་རྗེ་ངོར་པས་གྲུབ་ཆེན་བུདྡྷ་བ་ལ་རྟ་ལོ་ཞིག་ཤར་བའི་ཚེ།",
    "བདག་གིས་ལོ་གཅིག་ཙམ་དབུས་ལ་ཕྱིན་ན་འཆིའམ་ཞུས་པས།",
    "ཁྱོད་ན་ནིང་ནས་ཡང་ཡང་འགྲོ་ཟེར་གྱིན་འདུག་ནའང་།",
    "བྱ་ལོ་ཟླ་བ་ལྔ་པ་ལ་རྗེ་ངོར་ཆེན་གྱིས་ས་སྐྱར་ཕེབས་དུས་རྗེ་བུདྡྷ་བ་སྐུ་ཁམས་སྙེལ་པོ་ཡོད་ཟེར་བ་གསན་ནས།",
    "དེ་དོན་གྱི་ཁྱོད་སླེབ་བམ་སྙམ་པ་ད་སླེབས་པ་དེ་ལེགས།",
    "ཁྱོད་ཀྱིས་མགོན་པོ་གདོང་བཞི་པའི་བསྐང་གསོ་ཞིག་གྱིས།",
    "དེ་རིང་རང་རེ་གསུང་གླེང་མང་བ་ཙམ་གྱིས་ཁམས་ལྡོག་དོགས་མཛད་མི་དགོས།",
    "ཁོ་བོ་ཅག་གིས་རྗེའི་དྲུང་དུ་ཉམས་ལེན་གྱི་ཁ་གསོ་རྣམས་ཞུས་ནས།",
    "རང་ལོ་ཉེར་གཅིག་པའི་དུས་བསྒོམས་པའི་ཉམས་མྱོང་གི་སྟེང་ནས་འཆད་རྒྱུ་ཁོ་བོ་ལ་མ་མཆིས་ཀྱང་།",
    "སྔ་མོར་རང་གིས་ནན་ཞུས་བྱས་པ་ལྟར་རྒྱུན་པར་མཇལ་བའི་ཚེ་བཞེངས་པ་སོགས་མི་མཛད་པ།",
    "ངོས་ཅག་ཕྱག་འབུལ་བའི་བར་ལ་ཕྱག་ཐལ་མོ་སྦྱར་ནས་སྤྱན་ལྟ་སྟངས་ཀྱི་ངང་ལ་བཞུགས་པ་ཞིག་འདུག་པ་ལ།",
    "བཞུགས་གདན་ལ་བཞུགས་ནས་ཐུགས་བདེ་ཉམས་དཔག་ཏུ་མེད་པ་དང་བཅས་བཀའ་ལས་ངེད་ཀྱིས་སྔ་མོ་ནས་བསམ་པ་ལ།",
    "མུས་ནང་གི་དགོན་མ་བུ་འདི་རྣམས་ས་སྐྱ་པའི་ཕྱག་ཏུ་འཕྲོད་ཅིང་།",
    "ཁྱེད་རང་གི་ཡབ་ནས་ས་སྐྱ་པ་ཆེན་པོའི་བར་སོགས་ཀྱི་རྗེ་བཙུན་གོང་མ་བརྒྱུད་པ་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་དགོངས་རྫོགས་ཡོད་པས།",
    "ལྷག་པར་ད་རེས་ལམ་འབྲས་ཐོག་མར་གནང་བ་དེ་ལ་བར་ཆད་མ་བྱུང་བས།",
    "དེའི་སྐབས་ཤིག་ན་སྔ་མོ་ནས་དངོས་དང་བརྒྱུད་པའི་སྒོ་ནས་ནན་ཏན་དུ་གསོལ་བ་བཏབ་པ་དེ་ཉིད་ཐུགས་ལ་བཞག་པར་འདུག་པས།",
    "ལན་ཅིག་ཁོ་བོ་ཅག་ཞབས་དྲུང་ན་ཡོད་པ་ཞིག་གི་ཚེ།",
    "དེ་ནས་རང་ཉིད་ལ་སྤྱན་ཆེར་ཏེ་གཟིགས་ནས།",
    "རྗེས་སུ་དེ་དུས་ཞབས་དྲུང་ན་ཡོད་པའི་གྲོགས་དག་ལའང་དེ་སྐབས་རྗེས་འདི་ལྟར་གསུང་གི་ཨེ་འདུག་ཅེས་ཡང་ཡང་དུ་དྲི་བ་ཡང་ཤོར་བ་ཡིན་ལ།",
    "ཁྱེད་རང་གི་ད་ལྟའི་བྱེད་སྤྱོད་གང་ནས་བསམས་ཀྱང་།",
    "དེ་བཞིན་མི་བྱེད་ན་ཕྱི་ནང་གི་གནས་ཚུལ་གང་ལ་བལྟས་ཀྱང་སྐྱོ་བ་སྐྱེ་བའི་རྒྱུ་ལས་མི་འདུག་པ་ཁྱེད་རང་གི་བློ་ལ་མངའ་བ་ལྟར་ཡིན་པས།",
    "ང་ནི་བཞི་ཐོག་བླ་བྲང་གི་རིག་འཛིན་བརྒྱུད་པའི་རྟེན་བཞེངས་སོགས་འདི་རྣམས་གྲུབ་འཕྲལ།",
    "དེ་སྔ་མ་ལས་བསྟན་པ་ལ་མི་ཕན་རེ་ཞེས་དབུ་སྙུང་བཞེས་བྱུང་བས།",
    "སེམས་ཀྱང་སྐྱོ་ལ་དགའ་ཆེ་བའི་རྣམ་པས་མིད་པ་འཁྱིལ་བའི་གོང་གི་གསུང་རྣམས་ལ་ལན་ཡང་གང་ཡང་ཞུ་མ་ཐུབ་པ་ཞིག་བྱུང་ལགས་པ།",
    "གླིང་ག་གཞིར་བཞུགས་ཀྱི་གྲྭ་རིགས་ཕྱོགས་ནས་བྱོན་པ་དང་བཅས་པའི་བསྙེན་རྫོགས་དོན་གཉེར་གྱི་གང་ཟག་གྲངས་མེད་པ་ཞིག་ལ་ཡང་དབེན་བསམ་གཏན་ཕུའི་རྗེ་སེམས་དཔའ་ཆེན་པོའི་གཟིམ་ཕུག་གི་སྟེང་།",
    "དེ་ནས་བདག་ཅག་འགའ་ཞིག་གིས་གསོལ་བ་བཏབ་པའི་ངོར།",
    "གསང་འདུས་འཕགས་སྐོར་གྱི་རྒྱ་གཞུང་འདི་རྣམས་གང་ཟག་གཅིག་གིས་ཉམས་སུ་ལེན་པ་ན།",
    "ཀླུ་བྱང་གིས་མཛད་པའི་ཆོ་ག་ཉི་ཤུ་པ་པ་ཚབ་ཉི་མ་གྲགས་ཀྱི་འགྱུར།",
    "རིམ་ལྔའི་རིམ་པ་རེ་རེ་ལ་ཡང་རིམ་པ་ལྔ་རེ་ཚང་བར་བསྟན་པ་ཀླུ་བྱང་གིས་མཛད་པའི་རིམ་པ་ཁོང་དུ་བསྡུས་པ་པ་ཚབ་ཉི་མ་གྲགས་ཀྱིས་འགྱུར།",
    "བུ་སྟོན་གྱི་བཞེད་པ་རེས་འཐད་པ་དང་།",
    "ཕྱིས་ཀྱི་འདུས་པ་ལ་སྦྱངས་ཤིང་མཁས་པར་རློམ་པ་དག་གི་རྟོག་བཏགས་ལ་དགག་སྒྲུབ་ཆེར་མཛད།",
    "དེ་ཡང་རྒྱུད་ཀྱི་ལུང་གི་བསྒྲུབ་པ་དང་།",
    "དེ་དུས་སྔ་གཟིགས་ལ་རྗེ་འགོས་ཀྱི་སྟོང་ཐུན་ཆེན་མོ།",
    "རིམ་ལྔ་འགོས་ལུགས་དེ་ལས་ཀྱང་པཎྜི་ཏ་བཙུན་མོ་ཅན་གྱི་ཤོག་རིལ་ལ་ཐུགས་རྩིས་སུ་མཛད་དེ།",
    "དིང་སང་གི་འདུས་པ་བར་གྲགས་པ་རྣམས་ཀྱི་གསུང་ལ་ཡི་གེར་བྲིས་པ་ལ་ནོར་བ་འདི་འདྲ་ཡོད་ཅིང་།",
    "གུང་ཇའི་བར་ལ་རྗེ་འགོས་ཀྱི་མཆན་ཆེན་པོ་ལ་སྔ་གཟིགས་མཛད་ཅིང་།",
    "ཚིག་དོན་གཉིས་ཀའི་མཐའ་དྲུག་གི་ཆིངས་ཀྱིས་བཅིངས་ནས་སོ།",
    "དེ་ནས་འགྲེལ་པའི་འབྲུ་སྣོན་རྒྱ་ཆེ་བ་རེ།",
    "མན་ངག་ལུགས་ཀྱི་ཡང་ཐུན་མོང་དུ་གསུངས་པ་དང་ལམ་འབྲས་ཀྱི་ལུང་སྦྱོར་མི་བསྲེ་བ་ཡོད།",
    "དེར་རྟིང་དེས་གོ་ཆོད་མོད།",
    "ཡང་དེ་བཀག་ནས་སྔ་རབས་པའི་བཞེད་པ་རེ།",
    "ཡང་ན་སྔ་རབས་པ་ལ་ཐུགས་རྩིས་མཛད་རྟིང་བུ་ཊིཀ་གི་གང་མཛད།",
    "ཉུང་བ་འདུག་པ་དེ་ཀ་གནང་བས་ཆོག་མོད།",
    "ཕྱོགས་སྔ་ལ་ཡང་ཁ་ཅིག་ན་རེ་ཞེས་མི་ཆེན་གྱི་ཚིག་སྦྲམ་པོ་མཛད་པས་ཆོག་པ་ལ།",
    "ཨ་ཕ་ཕ་ཞེས་གསུངས་པ་སོགས་དེ་འདྲ་གསུང་ག་ལ་དགོས།",
    "དེ་དུས་སྲད་པ་ཀུན་བློ་རང་གི་ཐུགས་བསམ་ལ་ནི།",
    "ཏིང་ངེ་འཛིན་འདིས་ཉམས་ལེན་འདི་སྟོན་གསུངས་པ་དེས་བརྡ་ཆད་ལམ་པ་རེ་ཆགས།",
    "བུ་ཊིཀ་ཕྱག་ཏུ་བསྣམས་ནས་འཆད་ཅིང་ཚིག་རེ་རེ་བཞིན་འབྲུ་མནན་ཏེ་གསུངས་པ་ནི།",
    "དིང་སང་དར་བས་རྗེས་ཀྱང་དགེ་ལྡན་དུ་སྐུ་མདུན་དུ་ཡང་ཁོང་ཚོའི་ལུགས་དཔྱིས་ཕྱིན་པར་ཞུས།",
    "དེ་གསུམ་དོན་འདུས་པ་རྣམ་དག་གཙུག་གི་ནོར་བུ།",
    "ཁྱོད་ཀྱི་བསམ་ཡུལ་དེས་ནི་ཅིར་མི་ཕྱིན།",
    "ཐམས་ཅད་མཐུན་པ་སྤྱན་གཟིགས་མགྲིན་གཅིག་ཏུ།",
    "ཞེས་གསུངས་མོད་ལ་གདུང་བའི་མཆི་མ་བླགས།",
    "གར་བསྒྱུར་རེས་འགའ་ས་ལ་གོམ་པ་འདོར།",
    "མཚར་སྡུག་འོད་དུ་ཆགས་པའི་བུད་མེད་གཉིས།",
    "ད་ནི་རེ་ཞིག་རྒྱ་གར་དབུས་སུ་སོང་།",
    "ནངས་པའི་དུས་སུ་རང་གི་སྲས་གྱུར་པའི།",
    "བདག་གི་གཏམ་འདི་དབེན་པར་སྙན་དུ་ཞུས།",
    "དཱི་པྃ་ཁྱོད་ཀྱིས་བསྟན་པའི་ལྟ་བ་ཡིས།",
    "ད་དུང་ཤོག་ཅེས་བསྒོ་བའི་གསུང་གི་འཕྲིན།",
    "ཁྱོད་ཐུགས་དགྱེས་པ་བསྐྱེད་པར་གྱུར་ཅེས་ཐོས།",
    "མ་རིག་མུན་པ་སེལ་ཕྱིར་མྱུར་དུ་སོང་།",
    "ཁྱོད་ཀྱིས་འཕྲིན་ལས་ལྟ་ཕྱིར་ཡོང་བར་འཁུམས།",
    "ཁྱོད་ཐུགས་འགལ་སྙམ་བགྱི་བ་ཅུང་མ་ནུས།",
    "ཁྱོད་ཕྱིར་བདག་གིས་སྲོག་ཀྱང་ལྟོས་མེད་བཏང་།",
    "སྤྱི་བོར་ཐལ་སྦྱར་ཨེ་མའོ་སེམས་དཔའ་ཆེ།",
    "མེ་ཏོག་བསིལ་མ་ཡིད་འོང་དྲི་བཟང་གིས།",
    "གཅིག་གིས་བསླངས་ནས་མྱུར་དུ་སོང་ཞེས་གསུངས།",
    "སྤྲང་ཕྲུག་གི་གཟུགས་ཀྱིས།",
    "བྱིས་པ་དང་བུ་མོའི་གཟུགས་ཀྱིས།",
    "སྐྱ་རེངས་དང་པོ་ཙམ་ལ་སྒོ་འབྱེད།",
    "དེ་བར་སྒོ་དྲུང་གི་བྱིས་པ་དེ་ལ་ནོར་བཅོལ་བདེ་བར་ཉོལ་གསུངས།",
    "རྒྱལ་པོ་ཡེ་ཤེས་འོད་ཁོང་འོ་རེ་རྒྱལ།",
    "ཚངས་དབྱངས་གསུང་གིས་ལུང་བསྟན་འདི་ལྟར་མཛད།",
    "དཱི་པྃ་ཁྱོད་ཀྱི་གདུལ་བྱ་བོད་ན་འདུག།",
    "རང་གི་བདོག་པའི་དངོས་ཀུན་ཕོངས་པ་ཡི།",
    "ལྗོན་ཤིང་དུ་མ་མྱ་ངན་འཁྱོག་ཡིད་ཅན།",
    "གུས་པས་ཐལ་སྦྱར་གདུང་བའི་ཚིག་འདི་ཞུས།",
    "སྲིད་མཐའི་བར་དུ་ཁྱོད་ཞབས་བརྟན་གྱུར་ཅེས།",
    "ངོ་མཚར་རྫུ་འཕྲུལ་དེ་ནི་གང་དུ་ཐལ།",
    "ཁྱོད་ཉིད་ཞི་བའི་དབྱིངས་སུ་རབ་བཞུད་ནས།",
    "མིག་འཕྲུལ་མངའ་བ་རང་གིས་ལེགས་དགོངས་ནས།",
    "ཉམ་ཐག་རེ་བའི་འབྲས་བུ་མཐུ་ལྡན་ཞུ།",
    "ཟུར་གྱིས་གཟིགས་ནས་བརྩེ་བའི་གསུང་བྱོན་པ།",
    "ཁྱོད་ཀྱང་སྐྱེ་བ་འདི་ཡི་འོག་རོལ་ཏུ།",
    "གང་གི་ཐུགས་རྗེས་དིང་འདིར་སྤྲུལ་པ་སྙམ།",
    "དད་མོས་རྟེན་དུ་ལྷུང་བཟེད་མཁར་གསིལ་དང་།",
    "དིང་སང་དུས་ནའང་འགྲོ་བའི་མིག་གི་དཔལ།",
    "དེ་ནས་གོང་གི་སེམས་པའི་རིམ་པས་མཇུག་གི་ཤ་ཁྲག་སྦྱིན་གཏོང་གི་སྐབས་དང་།",
    "མཚོན་བྱ་འཁོར་ལོ་རྨ་བྱ་དུག་འཇོམས་གཉིས་ཀྱི་རང་གི་རྒྱུ་དགེ་མི་དགེ་ལས་འབྲས་བུ་བདེ་སྡུག་འབྱུང་ཚུལ་དང་།",
    "མཐར་ཐུག་བདག་ཏུ་འཛིན་པའི་བུད་ཤིང་བསྲེགས་ནས།",
    "ཚེ་གཅིག་གི་ཉམས་ལེན་བསྟན་ཟིན་ཏོ།",
    "བདག་གི་བདེ་དགེ་གཞན་ལ་འབུལ་བའི་བསམ་བསྒོམ་རྩེ་གཅིག་པའི་བློས།",
    "དཔལ་གླང་རི་ཐང་པའི་ཚིག་རྐང་བརྒྱད་མ་ཉིད་ཀྱི་ནང་ལྟར་ལ་ནན་ཏན་དུ་བྱེད་པ་ནི་བློ་སྦྱོང་གི་བསླབ་པ་བྱ་མཚོན་ལ།",
    "གཞན་ཡང་དུས་དེར་སུམ་པ་ལོ་ཙཱ་བ་ནས་བརྒྱུད་པའི་མན་ངག་གི་ཁྲིད་དང་།",
    "བདག་གིས་ཀྱང་ཐུབ་བསྟན་མཁན་ཆེན་དང་།",
    "ཁ་སིང་ནས་ངེད་ཀྱི་རྨི་ལམ་དུ་ཞབས་དྲུང་རང་གི་རྒྱུན་བཞེས་ཀྱི་དབུ་ཞྭ་དེ་ཡང་ཡང་ངེད་ཀྱི་ལག་ཏུ་གནང་བ་ཞིག་བྱུང་བ།",
    "ཞལ་ངོ་ཆེ་མོས་ཤིག་ལ་སྐུ་དོག་ཡོད་པའི་རྟགས་སུ་འདུག་པས།",
    "ད་རེས་ངམ་རིང་ཕྱོགས་སུ་ཕེབས་འགོར་གང་ཆུང་མཛད་ནས་གདན་སར་མྱུར་དུ་འབྱོར་པ་མཛད་དགོས་སོ།",
    "གཟིམ་ཆུང་རབ་གསལ་ཀ་བཞི་མའི་དབུས་ན་ཞལ་བྱང་གཟིགས་ཀྱི།",
    "དབུ་ནུབ་ཕྱོགས་སུ་ཅུང་ཟད་ཡོ་བ་དང་བཅས་བཞུགས་འདུག་པ་མཐོང་བའི་མོད་ལ།",
    "ངག་གིས་སྨྲ་བརྗོད་གང་ཡང་མི་ནུས་པ་དང་།",
    "ནམ་མཁའི་ཁྱོན་ཀུན་འཇའ་དང་འོད་ཀྱིས་གང་།",
    "མགོན་ཁྱོད་བཞུགས་དུས་བདག་ལ་ཐུགས་བརྩེ་བས།",
    "ངེས་པར་ཁྱོད་ཀྱི་ཕྲག་པར་ལོངས་ཤིག་གསུངས།",
    "བློ་དམན་ཞུམ་པའི་སེམས་ཀྱི་རེ་ཞིག་འགྱངས།",
    "དུས་དེར་ཁོ་བོ་བྱང་གི་མཐར་གནས་པའི།",
    "མོད་ལ་འཛམ་གླིང་རྒྱན་ཁྱོད་གཤེགས་པའི་གཏམ།",
    "ཐོས་པས་ཡིད་གདུང་ལུས་སྟབས་གོམ་པ་འཁྱོར།",
    "གཞན་མིན་རང་གི་ལས་ངན་འབྲས་བུར་ཟད།",
    "མགོན་ཁྱོད་བདེ་ནས་བདེ་བར་གཤེགས་པས་ན།",
    "དེ་ཕྱིར་ཉིད་བདེ་བདག་ཀྱང་བདེ་མོད་ཀྱི།",
    "དེ་ལྟར་ཐུན་མོང་སྣང་བའི་གཟུགས་ཀྱི་སྐུ།",
    "ཡང་ཡང་མཐོང་བས་སྤྲོ་བ་ངང་གིས་འཕེལ།",
    "སྐུ་གདུང་གི་ཞུ་འབུལ།",
    "དཀྱིལ་འཁོར་སྒྲུབ་མཆོད་སོགས་རྒྱས་པར་འཛུགས་པར་མཛད་པའི་རྒྱུན་དེང་སང་གི་བར་དུ་མ་ཉམས་ཤིང་ཡར་ལྡན་དུ་ཡོད་པ་འདི་ལེགས་ཤིང་།",
    "གཞན་ཡང་རྒྱུ་ཚོགས་རྨད་དུ་བྱུང་བ་ལས་གྲུབ་པའི་བྲིས་ཐང་གཙོ་བསྡུས་ཆེན་མོ།",
    "སྦྱོང་དཀྱིལ་སོགས་ཀྱིས་མཚོན་པའི་དཀྱིལ་ཐང་གི་གྲ་མང་བ་སྔགས་འཆང་ཉིད་ཀྱི་གསུང་འབུམ་གླེགས་བམ་སོགས་སྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་གསར་པ་དུ་མ་བཞེངས་པ་དང་།",
    "དམ་པ་ཁྱོད་དང་ཚེ་རབས་དུ་མའི་བར།",
    "སྐལ་བཟང་ཁྱོད་ཀྱི་སྒྲུབ་པའི་གནས་གང་དེར།",
    "དུས་དེར་ཡོངས་འཛིན་མཆོག་གིས་ཉེར་བཟུང་བས།",
    "ཡེ་ཤེས་མཁའ་འགྲོ་བདག་མེད་ལྷ་མོ་ཡིས།",
    "རྒྱ་ཆེན་ལུང་གི་རྒྱབ་རྟེན་དང་བཅས་ནས།",
    "ཁྱེད་ཀྱི་ན་ཚོད་ཕྲ་མོ་འདི་ཙམ་ལ།",
    "བསྟན་པ་ཡོངས་རྫོགས་གླེགས་བམ་གསུང་ངག་གི།",
    "ཁྱོད་ཀྱི་བློ་གྲོས་གཉིས་སུ་མེད་པར་གོ།",
    "བདེན་ནམ་བརྫུན་སྙམ་ཡིད་གཉིས་ཁྱོགས་ལ་འཕྱངས།",
    "དགེ་སློང་མཆོག་གི་སྡོམ་རྒྱུན་དྲི་མེད་ཀྱིས།",
    "དཔལ་ལྡན་གསང་བ་འདུས་པའི་མན་ངག་གི།",
    "དུག་གསུམ་རྟོག་པ་ངང་གིས་ཞི་གྱུར་ནས།",
    "འཛིན་མའི་ཁྱོན་ཀུན་ཁྱབ་པའི་མུས་པ་རྗེ།",
    "མཛད་པའི་འཕྲིན་ལས་ཀྱིས་རྒྱལ་བའི་བསྟན་པ་ཉིན་མོ་ལྟར་གསལ་བར་མཛད་པའི་སྙན་པའི་གྲགས་པས་རྒྱ་མཚོའི་གོས་ཅན་འདི་ཡོངས་སུ་ཁྱབ་པར་གྱུར་པ་ལ་བརྟེན་ནས་སྐལ་བ་དང་ལྡན་པའི་གདུལ་བྱ་རྣམས་མཉེས་གཤིན་པའི་བུས་མ་བསྙེགས་པ་ལྟར་མ་བསྡུས་པར་ཡང་རང་གི་ངང་གིས་འདུ་ཞིང་།",
    "ཁྱད་པར་དུ་ཡང་བདག་ཉིད་ཆེན་པོ་འདིའི་གསུང་གི་བདུད་རྩི་ངོམ་པར་གསོལ་བ་དང་།",
    "ཚིག་གི་ཚོགས་གཞན་གྱིས་གཟུང་སླ་ཞིང་རྣ་བར་སྙན་པ་དང་།",
    "ཡིད་ཆགས་སྡང་གི་དྲི་མ་ཅན་དང་།",
    "དེ་རང་གི་སྐབས་སུ་བབས་པའི་སྤྱི་དང་ཁྱད་པར་གྱི་འཆད་པར་འོས་པ་རྣམས་ཅུང་ཟད་ཀྱང་མ་ལུས་པ།",
    "དེ་དག་གི་བཞེད་སྲོལ་སོ་སོའི་འདི་ལྟར་བཞེད།",
    "ཤར་སྦྱང་གི་ལུང་ཉན་ཙམ་མ་ཡིན་པར།",
    "དམིགས་པའི་མཚམས་མཚམས་སུ་འདི་ལྟར་བྱེད་ཅེས་རྗེ་ཉིད་ཀྱང་ལྟ་སྟངས་དང་བཅས་པའི་སྒོ་ནས་ཅུང་ཟད་རེ་མཉམ་པར་འཇོག་པ་མཛད་པ་ན་དུས་དེ་ཉིད་དུ་ཇི་སྐད་གསུངས་པ་བཞིན་རྒྱུད་ལ་སྐྱེས་བྱུང་སྙམ་པ་དང་།",
    "ཀུ་རེ་དང་བཞད་གད་ཉམས་མཚར་བ་དག་གི་སྒོ་ནས་ཀྱང་སྤྲོ་བ་བསྐྱེད་པར་མཛད་ལ།",
    "འདིར་དེ་དག་གི་ཁྲོད་ནས་རགས་པ་ཙམ་ཞིག་གི་མཚན་བརྗོད་ན།",
    "གདན་ས་ཆེན་པོའི་ཐུབ་བསྟན་ལྷ་ཆེན་གྱི་མཁན་རབ་བཅུ་པ་སྔོན་སྔགས་འཆང་ཆེན་པོ་བྱས་འགྱུར་དུ་སྐུ་མཚམས་ལོ་གསུམ་ལ་བཞུགས་པའི་སྐབས་ཤིག་གསོལ་ཆུ་འདྲེན་པའི་དྲེའུ་རྒྱུན་དུ་ཐུགས་རྩིས་མོ་མཛད་པ་ཞིག་ཡོད་པ་དེ་ལན་ཅིག་ཆུ་རོང་དུ་ལྷུང་ནས་ཤི་བའི་ཚེ།",
    "ངེད་ཀྱི་ཆུ་དྲེལ་དེའི་སྐྱེ་བ་ཁའུ་རུ་ཁྲོད་ཀྱི་ཁུ་ཡོ་འདི་པ་ཚང་གི་བུར་འོང་བ་ཡོད་པས།",
    "ཟབ་མོ་བསྐྱེད་རིམ་གྱི་གསལ་སྣང་ཐོབ་པ།",
    "དེ་དག་གིས་ཁ་བའི་ལྗོངས་འདིར་གནས་པའི་སྐྱེ་དགུ་ཐམས་ཅད་སྐལ་བ་བཟང་པོར་བྱས་པ་ཡིན་ནོ།",
    "དམིགས་མེད་ཐུགས་རྗེའི་རྟ་ལྗང་གིས་དྲངས་ནས།",
    "མགོན་པོ་ཁྱོད་ཀྱི་ཞབས་སེན་རིན་ཆེན་ཕྲེང་།",
    "འཛིན་པར་སྣང་ཡང་མཁས་རྣམས་གད་མོའི་གནས།",
    "གངྒཱའི་ཀླུང་གི་རྡུལ་སྙེད་གྲངས་ལྡན་པས།",
    "དིང་སང་ཁ་ཅིག་རང་གི་སྔོན་བསགས་ཀྱི།",
    "དོན་གཉེར་འདུས་པའི་ཚོགས་ལ་ཟང་ཟིང་གི།",
    "རང་གི་སྒོ་གསུམ་ལྷ་སྔགས་ཡེ་ཤེས་སུ།",
    "ཡོངས་འཛིན་ཁྱོད་ཀྱི་ཞབས་སེན་རྒྱུ་སྐར་བདག།",
    "ཀོ་ལོང་ཐོ་ཅོ་ཉོན་མོངས་སྤོངས།",
    "བཅུ་གསུམ་པ་ཐུན་མོང་དུ་སྣང་བའི་གཟུགས་ཀྱི་སྐུའི་བཀོད་པ་བསྡུ་བའི་ཚུལ་གྱི་འབྲས་བུ་མངོན་དུ་མཛད་པའི་ཚུལ་ནི།",
    "རེ་ཞིག་གཟུགས་སྐུ་བསྡུ་བའི་ཚུལ་གྱིས་འབྲས་བུ་མངོན་དུ་མཛད་པར་བཞེད་པའི་ཚེ།",
    "ནམ་མཁའ་ལས་ཀྱང་ལྷ་རྣམས་ཀྱིས་སྤྱན་འདྲེན་པའི་ལྟས་སུ་རོལ་མོའི་སྒྲ་ཡང་ཡང་དུ་སྒྲོག་པ་དང་།",
    "ལོ་དེའི་གསོ༵ས་པོ༵་ཟླ་བ་གསུམ་པའི་ཚེས་བརྒྱད་ལ་བདག་གིས་ཞབས་དྲུང་དུ་སླེབས་པ་ན།",
    "རྗེ་རང་གིས་མཛད་པའི་ཡིག་སྣའི་སྟེང་ནས་ལུང་མ་ཁྲིད་ཤིན་ཏུ་རྒྱས་པ་ཞིག་གནང་ཞིང་།",
    "ནཱ་རོ་མཁའ་སྤྱོད་ཀྱི་བསམ་མི་ཁྱབ་ཐུན་མོང་མ་ཡིན་པའི་མན་ངག་དེ་དང་།",
    "ཁྱད་པར་ཞལ་གཟིགས་ཀྱི་བརྒྱུད་པ་བར་མ་ཆད་པའི་སྤྱན་རས་གཟིགས་གཙོ་འཁོར་གསུམ་པའི་རྗེས་གནང་སྔོན་དུ་འགྲོ་བས་ཐུགས་རྗེ་ཆེན་པོ་ཚེམ་བུ་ལུགས་ཀྱི་སྨར་ཁྲིད།",
    "ཁོང་གིས་བདེན་པར་བཟུང་ནས་ལོག་ཙམ་བྱུང་ཞེས་གསུངས་བྱུང་པས།",
    "བདག་གི་བསམ་པ་ལ།",
    "ས་སྐྱ་ནས་ཞབས་དྲུང་བླ་བྲང་གི་ཡང་རྩེ་ན་བཞུགས་པས།",
    "དེ་ན་ཡོད་པའི་མི་འགའ་ཞིག་ན་རེ།",
    "མགོན་ཁང་གི་ཞལ་འབག་འགྱེལ་བ་འདི་ཀ་ད་ལོ་གྲུབ་ཆེན་ཏེ་ལོ་པ་གནས་གཞན་དུ་གཤེགས་པའི་སྔ་ལྟས་སུ་འདུག་ཟེར་བྱུང་བས།",
    "འདི་ཕྱིར་ཕན་པའི་གསུང་གི་བདུད་རྩི་ཅི་ཡང་ཞིག་སྩལ་ཅིང་།",
    "ལྷག་པར་སྐུ་བེམས་ཀྱི་སྦུབས་ནས་སྐུ་སྟོད་གཟིངས་མཛད་དེ་བདག་གི་གདོང་ལ་ཆེར་གཟིགས་ནས།",
    "འདི་ནས་ས་སྐྱར་ཕེབས་འཕྲལ་བདེ་མཆོག་གི་བསྙེན་པ་ཟླ་བ་དྲུག་པ་ཞིག་གནང་བ་དང་།",
    "གཞན་སུས་གང་བྱས་ཀྱང་རང་རེ་དཔོན་སློབ་ལ་དམ་སེལ་གཏན་ནས་མི་ཡོངས།",
    "དེ་ནས་རྗེའི་གཟིམ་ཕུག་གི་གནམ་སྒོའི་རྡོ་སྐས་ཀྱི་འོག་ནས་ཕྱིར་མིག་ཅིག་བལྟས་པས་རྗེའི་ཞལ་འཛུམ་སྔར་གྱི་རྣམས་ལས་ཀྱང་ཆེས་ངོ་མཚར་བ་ཞིག་མཛད་ནས་གཟིགས་བྱུང་བས།",
    "གཟིམ་ཕུག་གི་གནམ་སྒོ་སོགས་སྒོ་རྣམས་ཁྲིག་གེ་འདུག་པས།",
    "ཅེས་གསུངས་པའི་མོད་ལ་དབོན་པོ་དྲུང་དུ་སླེབ་སྟེ་སྒོ་ཡོལ་ཕྱེ་བས།",
    "ཁྱོད་ཡོང་བ་སྔས་བྱུང་གསུངས་པ་སོགས་བཀའ་སྐྱོན་པའི་རྣམ་པ་མཛད་ཀྱིན་འདུག་ཅེས་ཐོས་ལ།",
    "རོལ་མོའི་སྒྲ་ནི་སྣ་ཚོགས་དང་།",
    "བཅུ་སོགས་ལ་མེ་ཏོག་གི་ཆར་ཆེན་པོ་དང་།",
    "ལྷའི་སྒྲ་རོལ་མོ་སོགས་ཀུན་གྱིས་མཐོང་ཞིང་ཐོས་པ་བྱུང་འདུག་ཅིང་།",
