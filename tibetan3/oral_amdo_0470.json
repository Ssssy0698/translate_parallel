    "རྡོ་རྗེ་རྩེ་མོ་ལྷུན་གྱིས་གྲུབ་དབྱིངས་ལས།",
    "ཟབ་མོ་ཡང་ཏིག་དཀར་ཆག་གསལ་བར་བྱ།",
    "སྨིན་གྲོལ་ཟབ་མོའི་དེ་ཉིད་མངོན་དུ་བྱེད།",
    "ཐུན་མོང་སྔོན་འགྲོ་རིན་ཆེན་པྲ་ཁྲིད་ཀྱིས།",
    "ཟབ་མོའི་དོན་རྣམས་རིམ་ཀྱིས་འཇུག་པར་བསྟན།",
    "མཚན་མོའི་རྣལ་འབྱོར་མཆོག་ཏུ་གསང་བ་བསྟན།",
    "ཟབ་མོའི་བཅུད་བསྡུས་དགོངས་པའི་ཡིན་ཚུལ་བསྟན།",
    "ཟབ་མོ་ཡང་ཏིག་གི་དཀར་ཆག་ཉི་ཟླ་གཟའ་སྐར།",
    "མཆོག་ཏུ་གསང་བའི་ལམ་ཁྲིད་ཆེན་མོས་ཏེ།",
    "ཕྱི་ཟབ་མོ་ཡང་ཏིག་གི་དཀར་ཆག་ཉི་ཟླ་གཟའ་སྐར།",
    "ལྟ་དགོངས་ཏིང་འཛིན་རྟོགས་པ་ངང་གིས་འཆར།",
    "ཟབ་མོ་ཡང་ཏིག་གསང་བའི་ཐེམས་འདི་རྣམས།",
    "ཟབ་མོ་ཡང་ཏིག་བསྟན་པ་དར་བར་ཤོག།",
    "ཟབ་མོ་ཡང་ཏིག་གི་དཀར་ཆག་ཉི་ཟླ་གཟའ་སྐར་ཞེས་བྱ་བ།",
    "གསང་ཆེན་ངེས་པའི་རྒྱུད་ལུང་མན་ངག་གི་དོན་ལ་ལེགས་པར་སྦྱངས་པའི་བློ་མིག་ཅན།",
    "། ཟབ་མོ་ཡང་ཏིག་གི་དཀར་ཆག་དཔག་བསམ་པ་ལྗོན་པ་བཞུགས་སོ།",
    "ཁྱོད་ལས་གཞན་དུ་མི་དམིགས་ཡི་རངས་འབུལ།",
    "གང་གིས་བཀའ་དྲིན་གྲིབ་མ་སྣུམ་པོ་ལ།",
    "ཕྱོགས་རེའི་བློ་ཅན་ཁྲོན་པའི་འཕར་འགྲོ་ཡིས།",
    "དགའ་རབ་རྡོ་རྗེ་ནས་བརྩམས་དེང་གི་བར།",
    "ཟབ་མོ་ཡང་ཐོག་ཀུན་མཁྱེན་ཀློང་ཆེན་པའི།",
    "དྲི་མེད་ལྷ་ལམ་ཡངས་པར་བརྒྱ་ཕྲག་གི།",
    "དེ་ཚུལ་ཡི་གེའི་ཕྱི་མོ་པར་གྱི་འཕྲུལ།",
    "གླེག་བམ་ཟབ་མོ་ཡང་ཐིག་གིས་དཀར་ཆག་དཔག་བསམ་ལྗོན་པ།",
    "ཡང་ཟབ་གདམས་ཟབ་མོ་ཡང་ཐིག་གིས་དཀར་ཆག་དཔག་བསམ་ལྗོན་པ།",
    "དལ་འབྱོར་དོན་ཡོད་མཛོད་ཅེས་ཐལ་མོ་སྦྱར།",
    "རྫོགས་ལྡན་བསྐལ་པའི་བདེ་སྐྱིད་འཕེལ་གྱུར་ཅིག་རྒྱལ་བསྟན་རི་མོ་གཡས་སུ་འཁྱིལ་བའི་དུང་།",
    "སྲིད་གསུམ་ཀུན་ཏུ་ཁྱབ་པའི་ལྷའི་རོལ་མོ།",
    "ཅེས་ཟབ་མོ་ཡང་ཐིག་པོད་གཉིས་པར་དུ་བསྒྲུབས་པའི་དཀར་ཆག་དཔག་བསམ་ལྗོན་པ་འདི་རྒྱལ་རིགས་ཤིང་ས་ལ་ཆེན་པོ་ལྟ་བུར་འཁྲུངས་པ་ལེགས་བྱས་ཡོན་ཏན་གྱིས་སྤ་བ་ལྷ་སྲས་དམ་ཚིག་རྡོ་རྗེའི་བཀའ་གནང་བཞིན་ཞེ་ཆེན་པ་ཤཱཀྱའི་དགེ་སློང་མཐུ་སྟོབས་རྣམ་པར་རྒྱལ་བས་ཉུང་ངུའི་ཚིག་གིས་འདོམ་པ་དོན་དང་ལྡན་པར་གྱུར་ཅིག།",
    "སྐབས་འདིར་ཡང་རིང་མོ་ནས་རྣམ་དཀར་གྱི་བྱ་བ་ལ་ཆེས་གོམས་པའི་དད་ལྡན།",
    "ངོ་མཚར་པར་གྱི་ཕྱི་མོར་བསྐྲུན་པའི་ལེགས་བྱས་ལ་རྗེས་སུ་ཡི་རང་དྲགས་པོས་ཐུགས་རྗེ་ཆེ་ཞུ་བ་དང་ཆབས་ཅིག།",
    "རྒྱལ་མོ་འབྲུག་པ།",
    "༡༢༢༦དཔལ་བརྩེགས་བོད་ཡིག་དཔེ་རྙིང་ཞིབ་འཇུག་ཁང་གིས་བསྒྲིགས།",
    "ཀྲུང་གོའི་བོད་རིག་པ་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ཏེ་བཀྲམ།",
    "འཆར་ཁའི་ཉིན་བྱེད་མདངས་འཛིན་ཡིད་འོང་གཞོན་ནུའི་ལང་ཚོ་མཚན་དཔེའི་གཟི་འབར་སྐུ།",
    "ཆུ་ཐིགས་གཅིག་གིས་ཆུ་གཏེར་རོ་ཤེས་ལྟར།",
    "མོས་ལྡན་དག་གིས་བསྐུལ་བ་དོན་ཡོད་ཕྱིར།",
    "རྗེ་བཙུན་ཐམས་ཅད་མཁྱེན་གཟིགས་དམིགས་པ་མེད་པའི་ཐུགས་རྗེའི་གཏེར་ཆེན་པོ་དང་ལྡན་པ་འདི།",
    "གར་མཁན་རྔ་མཁན་གྱད་དང་རོལ་མོ་མཁན།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་རབ་འབྱམས་རྣམས་སུ་གཅིག་ཅར་དུའང་མཛད་པ་བཅུ་གཉིས་ཀྱི་ཚུལ་སྟོན་པ་མཆོག་གི་སྤྲུལ་པའི་སྐུ་དང་།",
    "རེ་ཞིག་གདུལ་བྱ་ཕྱོགས་རེའི་མིག་ཅན་གྱི་བློ་ཡིས་མཐོང་ཚུལ་དང་སྦྱར་ཏེ།",
    "གྲུབ་ཆེན་ཤ་བ་རི་པས་རྗེས་སུ་བཟུང་སྟེ་མཆོག་གི་དངོས་གྲུབ་བརྙེས་པ་པཎ་ཆེན་ནགས་ཀྱི་རིན་ཆེན་ལ་། སོགས་པ་རྣམས་དང་།",
    "དཔལ་ལྡན་བྲང་ཏིའི་གདུང་རིགས་ལས་བྱོན་པའི་ངོར་ཆེན་རྡོ་རྗེ་འཆང་གི་སེང་གེའི་ཁྲིར་འཁོད་པ་མཁྱེན་བརྩེ་ནུས་པའི་བདག་ཉིད་བྱམས་པ་ནམ་མཁའ་འཆི་མེད།",
    "ཁ་ཆེ་པཎ་ཆེན་གྱི་ཐུགས་སྲས་དཔྱལ་ཨ་མོ་གྷ་བཛྲ།",
    "གཏེར་ཆེན་རྡོ་རྗེ་གླིང་པའི་གསང་བའི་གཟུངས་མ་ལྷོ་བྲག་ནས་རྡོ་རྗེ་འཚོ་བྱ་བ་ཞིག་སོགས་རྣལ་འབྱོར་ཕོ་མོ་སྣ་ཚོགས་པའི་རྣམ་པར་ཡང་སྟོན་པའི་སྔོན་གནས་རྗེས་སུ་དྲན་པ་དང་།",
    "བདག་གིས་བྱིན་བརླབས་གདམས་པ་ཉམས་བླངས་པས",
    "གསང་སྔགས་ནང་གི་ས་ལམ་མ་ལུས་བགྲོད",
    "བདག་གིས་བྱིན་གྱིས་བརླབས་པའི་སྲས་ཡིན་གསུངས",
    "མཐོང་ཐོས་དྲན་རེག་དོན་དང་ལྡན་པ་སྟེ",
    "གྲིབ་མས་རེག་ཙམ་ཏིལ་འབྲུ་ཙམ་ཞིག་ཉེ",
    "ངན་སོང་འགྲོ་ངེས་ཤེས་ཀྱང་མཐོ་རིས་སྐྱེས",
    "མཁས་པ་དང་གྲུབ་པར་བསྙེམས་པ་གང་གིས་ཀྱང་སྤོབས་པའི་སྟོབས་མི་ཆོམ་པས་འཇིགས་བྲལ་གྱི་རྡོ་རྗེ་སློབ་དཔོན་ཆེན་པོ།",
    "ཉོན་མོངས་བསལ་བར་གྱུར་ཀྱང་སྐྱེ་བ་སྟོན་པར་བྱེད།",
    "བྱེ་བྲག་ཏུ་མངའ་བདག་ཉང་གི་གཏེར་ལུང་། ལས།",
    "བཅུ་གསུམ་ཟབ་མོའི་གཏེར་ལ་སྤྱོད",
    "ཤར་གྱི་ཕྱོགས་ནས་འབྲུག་གི་ལོ་པ་འབྱུང་",
    "མངའ་བདག་མྱང་གི་གདུང་བརྒྱུད་ནི",
    "ཞེས་པའང་མངའ་བདག་ཉང་གི་གདུང་བརྒྱུད་མི་རབས་བཅུ་གསུམ་རྫོགས་ཟིན་པའི་རྗེས་སུ་འབྱོན་པའི་དུས་དང་།",
    "སྟག་ཚང་མིང་ཅན་བཅུ་གསུམ་ལས་རོང་རྨེ་དཀར་མོ་སྟག་ཚང་ལས་ཟབ་ད་ཡལ་བའི་ཚེ",
    "ཞེས་སོགས་གཏེར་རྙིང་འགའ་ཞིག་ལས་རང་གིས་མཐོང་ཚོད་བཀོད་པ་སྟེ།",
    "ལུང་ཟིན་གྱི་སྐྱེས་བུ་ལ་འདྲ་མིན་དང་མི་ནོར་བའི་མཚན་རྟགས་ཀྱང་དགོངས་འདུས་ལུང་བསྟན་ཆེན་མོ་ལས།",
