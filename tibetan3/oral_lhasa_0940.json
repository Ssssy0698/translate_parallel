    "ལེགས་སྨོན་དགའ་སྟོན་དེང་འདིར་འགྲུབ་པར་མཛོད།",
    "གཞན་དོན་ཐུགས་བསྐྱེད་དྲ་མིག་མ་འདྲེས་པར།",
    "ཀུན་མཁྱེན་བུ་རམ་ཤིང་པའི་འཁོར་གྱི་མཆོག།",
    "གྲུབ་ལ་མངའ་བརྙེས་གཙང་པ་རྒྱ་རས་དང་།",
    "བློ་བཟང་མཁྱེན་རབ་ཉི་མར་གསོལ་བ་འདེབས།",
    "བསྐལ་པ་རྒྱ་མཚོའི་བར་དུ་བརྟན་བཞུགས་ནས།",
    "རྒྱལ་ཀུན་མཁྱེན་བརྩེའི་འཕྲིན་ལས་གཅིག་བསྡུས་དཔལ།",
    "ཀུན་མཁྱེན་རྒྱལ་བསྟན་འཛིན་ལ་ཟླ་བྲལ་བ།",
    "རྣམ་པར་དཀར་བའི་རྒྱལ་བསྟན་སྲི་ཞུའི་ཚོགས།",
    "སྒྲུབ་པ་ལེགས་སྦྱངས་ཀུན་མཁྱེན་མྱུར་ཐོག་ཤོག།",
    "ཇི་ལྟར་སྨོན་པའི་དགེ་འབྲས་ཅི་མཆིས་པར།",
    "ཁྱད་པར་ཅན་གྱི་གདུལ་བྱ་ཉེར་བཟུང་བའི།",
    "དཔག་པར་དཀའ་བའི་རྒྱལ་སྲས་སྤྱོད་པའི་ཁུར།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པ་རིན་ཆེན་གྲུབ།",
    "ཡབ་སྲས་བརྒྱུད་པར་བཅས་ལ་གསོལ་བ་འདེབས།",
    "ཟས་གཙང་སྲས་གང་མི་མཇེད་འཇིག་རྟེན་འདིར།",
    "ཁྱིམ་བཞུགས་ཤཱཀྱའི་རིགས་སྲས་སྒྲ་གཅན་འཛིན།",
    "གསལ་མཛད་ངུར་སྨྲིག་འཛིན་པར་རིམ་བྱོན་རྣམས།",
    "ལྷག་བསམ་རྣམ་པར་དཀར་བའི་བགྱི་བ་ཀུན།",
    "དོན་གཉིས་ཕུལ་བྱུང་བདེ་གཤེགས་ཟས་གཙང་སྲས།",
    "རྒྱལ་སྲས་ལོ་པཎ་གྲུབ་བརྙེས་གཅིག་མཐུན་པར།",
    "ཚོགས་ཐུན་གཉིས་པར།",
    "དུས་སྙིགས་མར་ལུས་ལ་ལྷག་པར་དགོངས།",
    "ཚུལ་འདི་ན་སྲིད་པར་ཞེན་ལོག་སྐྱེ།",
    "གནས་ཁ་བའི་ལྗོངས་ཀྱི་ལྷ་སྐལ་ཆེའི།",
    "ཞིང་གྲུ་འཛིན་དམ་པར་བརྫུས་སྐྱེས་ཏེ།",
    "བདག་ལས་སྨོན་འཛོམས་པའི་ལེགས་བྱས་མཐུས།",
    "གཙུག་ཏུ་བསྟེན་ནོ་མཐུན་རྐྱེན་ཤིས་པར་སྩོལ།",
    "དགོངས་དོན་རྣམ་པར་གྲོལ་བའི་གཞུང་ལུགས་ཀྱི།",
    "ཁྱད་པར་རྒྱལ་ཡུམ་དགོངས་དོན་གཏན་ཕབ་པའི།",
    "དེ་འཛིན་སྐྱེ་འཕགས་གང་ན་སུ་བཞུགས་རྣམས།",
    "རིས་མེད་སྐལ་ལྡན་ཞིང་བཟང་སྨིན་པར་ཤོག།",
    "ཁྱད་པར་ཕྱག་ན་པདྨོའི་བཞེད་པའི་དོན།",
    "འགྲུབ་མཛད་བདེ་ལེགས་ས་སྟེང་ཁྱབ་པར་མཛོད།",
    "༢༨ན་འདོད་སྨོན་བདེན་ཚིག་ཚངས་པའི་ཤིས་བརྗོད་ཅེས་བྱ་བཞུགས་སོ།",
    "བསྟན་འགྲོའི་ལེགས་བྱས་སྤེལ་བའི་ཐུགས་བསྐྱེད་ཀྱི།",
    "ཚད་ལྡན་བཤེས་ཀྱི་རྗེས་སུ་འཛིན་པར་༢༨བ་ཤོག།",
    "བཟང་པོའི་བསྐལ་པར་ལུགས་གཉིས་ནོར་བུའི་མཛོད།",
    "བཀྲ་ཤིས། རང་འཚོའི་སྨོན་ཚིག་བཞུགས་སོ།",
    "དགའ་ལྡན་ཞིང་བཞུགས་བྱམས་མགོན་རྒྱལ་གྱུར་ཅིག།",
    "བསྟན་པ་འཛིན་ལ་བྱམས་མགོན་མཚུངས་པར་ཤོག།",
    "བདེ་གསལ་མི་རྟོག་ཐུགས་རྗེས་ལྷག་པར་བཟུང་།",
    "དགེ་སྦྱོང་ཆེན་པོའི་ཆ་ལུགས་རྣམ་པར་དག།",
    "གང་དག་རྣམ་པར་དཀར་བའི་མཛད་པའི་ཚོགས།",
    "ཀུན་མཁྱེན་རྒྱལ་བསྟན་ཡུན་རིང་གནས་པར་ཤོག།",
    "འཁོར་གྱི་ཐོག་མར་རྗེས་སུ་འཛིན་པར་ཤོག།",
    "བདག་སོགས་བྱང་ཆེན་གོ་འཕང་མ་འགོད་པར།",
    "ཕུལ་བྱུང་རྒྱལ་ཀུན་མཁྱེན་བརྩེའི་རང་མདངས་དཔལ།",
    "སྔོན་ཚེ་རྒྱལ་བའི་སྤྱན་སྔར་ཞལ་བཞེས་བཞིན།",
    "མཧཱ་རཱ་ཛར་བརྟག་པ་བགྱིས་པར་ངེས་རྙེད་མ་ཟད་ངོས་ཀྱི་ཡོངས་འཛིན་དམ་པའི་བཀའ་༦ན་དྲིན་དྲན་ཞིང་།",
    "གདུལ་བྱའི་ཕྱི་མཐའ་མ་རྫོགས་པར་དེ་སྲིད།",
    "མཛད་འཕྲིན་ནམ་མཁའི་མཐའ་དང་མཚུངས་པར་ཤོག།",
    "རིས་མེད་འགྲོ་བའི་ཞིང་སར་དབབ་པར་ཤོག།",
    "དེ་ལྟར་སྨོན་པའི་དོན་འབྲས་ཅི་མཆིས་པར།",
    "ངོམས་པས་བསྟན་འགྲོའི་ཐུགས་བཞེད་འགྲུབ་པར་ཤོག།",
    "སྐལ་བཟང་ལེགས་བྱས་རྒྱན་དུ་ཉེར་དབབ་ནས།",
    "ཅེས་བརྟན་བཞུགས་སྨོན་ཚིག་འཆི་བདག་གཡུལ་རྒྱལ་ཞེས་བྱ་བ་འདི་ཡང་།",
    "ཅེས་བརྟན་བཞུགས་སྨོན་ཚིག་འདོད་པའི་མཆོག་སྩོལ་ཞེས་བྱ་བ་འདི་ཡང་།",
    "ཚེ་ཡི་མཆོག་སྦྱིན་རྣམ་པར་རྒྱལ་མའི་མགོན།",
    "ཅེས་བརྟན་བཞུགས་འདོད་དོན་སྨོན་ཚིག་འཕྲིན་ལས་ལྷུན་འགྲུབ་ཅེས་བྱ་བ་འདི་ཡང་།",
    "མཁས་༩ན་བཙུན་བཟང་སོགས་ཐུགས་བཞེད་ཅི་མཆིས་པར།",
    "བཅོམ་ལྡན་རྣམ་པར་རྒྱལ་མ་མགོན་བཅས་ཀྱིས།",
    "བསླབ་གསུམ་གཅེས་པར་འཛིན་ལ་གསོལ་བ་འདེབས།",
    "བཀྲ་ཤིས་བདེ་དགེའི་རྩེད་དགར་རོལ་པར་ཤོག།",
    "ཅེས་བརྟན་བཞུགས་སྨོན་ཚིག་ཚེ་ཡི་དཔལ་སྩོལ་ཞེས་བྱ་བ་འདི་ཡང་།",
    "རབ་འབྱམས་རྒྱལ་བའི་མཁྱེན་བརྩེའི་བདག་ཉིད་ཅན།",
    "མི་མཐུན་ལོག་པར་འགྲན་པའི་བདུད་ཀྱི་གཡུལ།",
    "༡༡ན་གཟི་བྱིན་ཆེས་ཆེར་དར་བས་འཇོམས་པར་ཤོག།",
    "ལེགས་བྱས་འཆི་མེད་དཔལ་གྱི་བུམ་པ་བཟང་།",
    "རབ་བྱུང་བཅོ་ལྔ་པའི་གོང་མ་ཀྭོང་ཞུའི་ཁྲི་བཞུགས་སོ་བཞི་པ་ས་ཕོ་སྤྲེལ་ལོའི་སྨིན་ཟླའི་དཀར་ཕྱོགས་ཀྱི་རྒྱལ་བ་གཉིས་པར་སྦྱར་བ་འདིས་ཀྱང་ཕན་བདེའི་དཔལ་ཡོན་བཞད་པའི་རྒྱུར་གྱུར་ཅིག། གནམ་བསྐོས་ཙི་ནའི་རྗེ་བོ་རིམ་བྱོན་གྱི་སྐུ་ཚེ་བརྟན་ཅིང་།",
    "ཆབ་སྲིད་རྒྱས་པའི་སྨོན་ཚིག་དོན་གཉིས་ལྷུན་གྲུབ་ཞེས་བྱ་བ་བཞུགས་སོ། ཨོཾ་སྭསྟི།",
    "མི་འགྱུར་བདེ་ཆེན་རྒྱལ་རྣམས་མཁྱེན་བརྩེའི་དཔུང་།",
    "རྗེ་བཙུན་ཟུར་ཕུད་ལྔ་པར་གསོལ་བ་འདེབས།",
    "ཆབ་སྲིད་དབུ་འཕང་སྲིད་རྩེར་སྙེགས་པར་ཤོག།",
    "ཕུལ་བྱུང་སྲས་བཅས་ཀུན་གྱི་མཁྱེན་བརྩེའི་བཅུད།",
    "བདེ་གཤེགས་ཟས་གཙང་སྲས་པོས་དགེ་ལེགས་སྩོལ།",
    "ལྟ་སྤྱོད་ཀུན་གཙང་འཇམ་དཔལ་རིང་ལུགས་ཉིད།",
    "ཡབ་རྗེ་རྒྱལ་བ་མཆོག་དང་མཚུངས་པར་ཤོག།",
    "ཐུགས་བསྐྱོད་དམ་བཅའི་རྒྱལ་ས་འགོང་མིན་པར།",
    "ཐུགས་ཀྱི་བུམ་བཟང་ཕྱུར་པོར་གཏམས་པར་ཤོག།",
    "བསྟན་འགྲོའི་ལེགས་བྱས་ནམ་མཁའི་མཐའ་ལྟར་སྐྱོང་།",
    "དཔག་དཀའི་མཁྱེན་བརྩེ་དབྱེར་མེད་སྤྲིན་རུམ་ནས།",
    "ཉོན་ཤེས་སྒྲིབ་སྤངས་རྣམ་མཁྱེན་གོ་འཕང་མཆོག།",
    "བགྲང་ཡས་སེམས་ལྡན་འགྲོ་ཁམས་མཐའ་ཀླས་པར།",
    "ངོམས་མེད་ཅི་དགར་སྒྲོགས་ཤིང་ལྟ་སྤྱོད་གཙང་།",
    "རབ་འབྱམས་མི་མཇེད་ཞིང་མཆོག་མཐའ་ཀླས་པར།",
    "མཆོག་བསྟན་འཛིན་ཅིང་རྨད་བྱུང་མཁྱེན་རབ་མཛོད།",
    "བཅས་རང་ཉེས་པས་ཆ་ཙམ་དབེན་པར་ཤོག།",
    "ཁྱེད་ཉིད་བསྟན་འགྲོའི་ལེགས་བྱས་ཡུན་བཞད་ཕྱིར།",
    "ཉན་ཐོས་སྤྱོད་པ་གཙང་དང་རིམ་གཉིས་ཀྱིས།",
    "རབ་འབྱམས་རྒྱལ་ཀུན་མཁྱེན་བརྩེ་གཅིག་བསྡུས་ཐུགས།",
    "རྩི་འགྲེལ་དག་ལ་འོལ་སྤྱི་ཙམ་མིན་པར།",
    "གྲོ་ལགས་བྲག་དཀར།",
    "ངོ་མཚར་འཆི་མེད་ལེགས་བྱས་མཁའ་དབྱིངས་སུ།",
    "གཏན་བདེའི་དཔལ་དེར་མྱུར་དུ་འགོད་པར་ཤོག།",
    "འཕྲལ་ཡུན་དགེ་མཚན་ལྷུག་པར་གྲོལ་གྱུར་ཅིག།",
    "དགེ་མཚན་བཟང་པོའི་དཔལ་རབ་རྒྱས་པར་ཤོག།",
    "རབ་མངའ་རྣམ་པར་རྒྱལ་མས་མཆོག་སྦྱིན་སྩོལ།",
    "མཁས་བཙུན་བཟང་གྲུབ་ལྟ་སྤྱོད་གཙང་མ་ཡིས།",
    "རྒྱལ་བསྟན་ནུབ་མཐའ་ཆེས་ཆེར་བསྲིངས་པར་ཤོག།",
    "ཕུལ་བྱུང་ཕྲ་རགས་གནས་ལུགས་རྗེན་འཆར་མཁྱེན།",
    "གཏན་བདེའི་ལམ་བཟང་དམ་པར་འཛུད་པ་ཡིས།",
    "སྤེལ་བའི་གྲགས་སྙན་རྣམ་པར་རྒྱལ་བའི་མགོན།",
    "ཚེ་སྦྱིན་རྣམ་པར་རྒྱལ་མས་དགེ་ལེགས་སྩོལ།",
    "མཐའ་ཀླས་སྐྱེ་རྒུའི་ལེགས་བྱས་ཤར་རིའི་རྩེར།",
    "བཀའ་བརྒྱུད་གཙང་མའི་ཉམས་བཞེས་ཅི་མཆིས་པ།",
    "ལྟ་སྤྱོད་ཀུན་གཙང་མི་ནུབ་འཕྲིན་ལས་མགོན།",
    "བགྲང་ཡས་རྒྱལ་བའི་མཁྱེན་༢༨ན་བརྩེ་མཐར་སོན་ཅིང་།",
    "ལྷུར་བཞེས་རྗེ་བཙུན་དམ་པའི་གསུང་སྤྲུལ་དུ།",
    "གཏན་བདེའི་ལེགས་ཚོགས་ཅི་དགར་འབྱེད་པར་ཤོག།",
    "རྣམ་པར་རྒྱལ་མས་རྨད་བྱུང་དགེ་ལེགས་སྩོལ།",
    "མ་དག་ཞིང་ཁམས་ལྷ་ཡི་ལམ་ཡངས་པར།",
    "ཁྱད་པར་བློ་གྲོས་གསེར་གྱི་ས་བཟང་པོར།",
    "རྒྱལ་སྲས་དཔའ་བོའི་དབུས་ན་མཛེས་ལགས་སམ།",
    "ཕན་བདེ་ཀུནྡའི་ཚལ་ཡངས་བཞད་པར་མཛོད།",
    "ཕྱི་ནང་གེགས་ཀྱིས་ནམ་ཡང་མི་འགོག་པར།",
    "འགྲོ་བློའི་ལེགས་བྱས་ཀུ་མུད་རབ་༢བ་བཞད་དེ།",
    "ཐུགས་རྗེ་ལྷག་པར་བསྐྱེད་དེ་དེང་འདིར་དགོངས།",
    "སྐལ་བཟང་གདུལ་བྱའི་ལེགས་བྱས་ལྷ་ལམ་དུ།",
    "སྤྱོད་པ་རྒྱ་མཚོ་ལྷུར་དུ་བཞེས་པ་ཡི།",
    "ངང་པའི་ཁྱུ་ཚོགས་དབུས་ན་མཛེས་ལགས་སམ།",
    "བསྐྱུར་བའི་གོ་སྐབས་འཚོལ་བ་གནས་མ་ལགས།",
    "རིགས་རུས་ཆོ་འབྲང་ལྡན་པར་མྱུར་བལྟམས་ཏེ།",
    "ཞབས་ཟུང་ལེགས་བཀོད་ཕན་བདེ་བཞད་པར་མཛོད།",
    "དཔའ་པོ་ཁྱེད་ཀྱིས་ཐུགས་བསྐྱེད་དོར་ལགས་སམ།",
    "གནས་པར་སླ་བའི་དམ་བཅའི་བཞེད་དོན་དེ།",
    "དོར་ན་འཕགས་ཚོགས་དབུས་ན་མཛེས་ལགས་སམ།",
    "དགྱེས་ཞལ་བཟང་པོ་མྱུར་དུ་ངོམས་པར་ཤོག།",
    "མཁས་པའི་བྱ་བ་མཐའ་དག་ལྷུར་བཞེས་ཤོག།",
    "ལེགས་གསུངས་ཟབ་རྒྱས་ལུང་རྟོགས་གདམས་པའི་མཛོད།",
    "རྟག་འཛིན་དོན་དུ་ཞི་བར་གཤེགས་ལགས་ཀྱང་།",
    "མཆོག་སྐུའི་ཞལ་བཟང་མྱུར་དུ་ངོམས་པར་ཤོག།",
    "གཟུགས་སྐུའི་བཀོད་པ་དབྱིངས་སུ་མནལ་ལགས་ཀྱང་།",
    "དོན་གྱི་འོད་གསལ་ཆེན་པོའི་དབྱིངས་བཞུགས་ཏེ།",
    "དགོས་པའི་ཁྱད་པར་དུ་མས་ཞི་དབྱིངས་མནལ།",
    "བསྟན་འགྲོའི་བཞེད་དོན་ལྷོད་པར་མི་འགྱུར་བས།",
    "ཕན་བདེའི་ཟབ་དགོངས་མ་ལུས་རྫོགས་པར་ཤོག།",
    "རྣམ་མང་ལེགས་བྱས་དར་བའི་སྔོན་མེད་སྲིད།",
    "བསྟན་འགྲོའི་དཔྱིད་དུ་མཛེས་པར་གཏམས་པ་ལས།",
    "རྒྱུད་བསྡམས་མཁས་བཙུན་ལྟ་གྲུབ་གཙང་བཟང་སྐྱོང་།",
    "ཕྲ་ཞིབ་བློ་གྲོས་བཟང་པོའི་མཁྱེན་པ་ཡིས།",
    "རྒྱལ་ཀུན་མཁྱེན་བརྩེ་བྱམས་པའི་བསིལ་བའི་རྒྱུན།",
    "ལེགས་གསུངས་ཟབ་རྒྱས་བརྒྱད་ཁྲི་བཞི་སྟོང་བཅུད།",
    "མཁྱེན་རབ་མཚུངས་མེད་དགེ་ལེགས་འཕྲིན་ལས་ཀྱི།",
    "དེ་ཕྱིར་ལྟོས་པར་ཐོག་པའི་སྐྱེ་བོ་འགས།",
    "སླར་ཡང་སྐལ་ལྡན་ལེགས་བྱས་ཤར་རིའི་རྩེར།",
    "སྣ་ཚོགས་འཕྲིན་ལས་རྒྱལ་དང་མཉམ་པར་འཇུག།",
    "གདོད་ནས་ཐུགས་རྗེའི་དབྱིངས་སུ་བཟོད་བཞེས་ལ།",
    "བསྟན་པ་སྲུང་བར་ཞལ་བཞེས་གཡར་དམ་དང་།",
    "ལོག་པར་འཁུ་བའི་ཆོ་འཕྲུལ་ཅི་མཆིས་ཀྱང་།",
    "སྔོན་ཚེ་རྒྱལ་བའི་སྤྱན་སྔར་ཞལ་བཞེས་ཀྱི།",
    "དུས་འདའ་ལྟ་སྤྱོད་གཙང་ཞིང་རྒྱལ་བསྟན་ལ།",
    "འདིར་སྣང་སྲིད་པར་མངོན་ཞེན་སྐལ་ངན་རྣམས།",
    "དག་ཚངས་བཀྲུ་བས་བཟོད་པ་ལྷུར་བཞེས་གསོལ།",
    "ཇི་ལྟར་ཐུགས་བསྐྱེད་ཆ་ཙམ་མི་འགོངས་པར།",
    "སྙིགས་དུས་བསྟན་འགྲོར་དུང་དུང་བརྩེ་བ་བཞེས།",
    "གང་ཤེས་གསལ་འདེབས་ཇི་ལྟར་སྤེལ་བ་ལ་ངོ་མ་བཟློག་པའི་ལོ་ཤས་བསྲིངས་ཐབས་དང་བསྐྱེད་བཞེས་རུང་།",
    "ཀུན་མཁྱེན་བུ་རམ་ཤིང་ལྟར་ཞིང་མཆོག་གཞན།",
    "དངོས་འཛིན་རྟག་པར་འཁྲུལ་བའི་བྱིས་པའི་ཚོགས།",
    "དེ་ཕྱིར་དམན་ལ་ལྷག་པར་བརྩེ་བ་ཡི།",
    "ཐུགས་རྗེའི་འཇུག་པ་བསྐྱུད་པར་ག་ལ་བཟོད།",
    "སྐྱོང་བའི་ཞལ་བཞེས་དམ་བཅས་ཅིས་ཀྱང་དགོངས།",
    "མཚན་དཀྱིལ་ཟླ་ཞལ་མྱུར་བར་ངོམས་པར་མཛོད།",
    "བསམ་སྦྱོར་གཙང་མས་གུས་བསྟེན་རྗེས་གཟུང་མཐུས།",
    "རྩེ་ཕྱག་ལས་བྱ་རྗེ་དྲུང་རྣམ་རྒྱལ།",
    "ཀུན་མཁྱེན་ཟས་གཙང་སྲས་པོས་དུས་ཀུན་སྐྱོངས།",
    "བསྟན་དང་འགྲོ་བའི་ལེགས་བྱས་མཆོག་ཏུ་སྨིན།",
    "ཀུན་མཁྱེན་བུ་རམ་ཤིང་པས་དགེ་ལེགས་སྩོལ།",
    "བསླུ་མེད་སྐྱབས་གསུམ་བདེན་པས་ཤིས་པར་སྩོལ།",
    "ལྷག་པར་དར་བས་མི་མཐུན་གཡུལ་ལས་རྒྱལ།",
    "མཁས་བཙུན་རྣམ་པར་རྒྱལ་བའི་དགེ་ལེགས་ནི།",
    "གོང་མ་རིམ་པའི་མྱུར་བྱོན་སྨོན་ཚིག་འབུལ་དགོས་འཚོ་འཛིན་སྲིད་བློན་ཡབ་གཞིས་གུང་བརྒྱུད་དྲི་བརྩད་བགྱིས་པར།",
    "གང་ཉིད་དངོས་ཀྱི་གདུལ་བྱས་དབེན་པ་ན།",
    "ལེགས་གསུངས་ཟབ་རྒྱས་ལུང་རྟོགས་བསྟན་པའི་མཛོད།",
    "བསྟན་དང་འགྲོ་བའི་ལེགས་བྱས་མ་ལུས་པ།",
    "རྣམ་མང་ལེགས་བྱས་འབུམ་ཕྲག་དཔལ་མངའི་མཛོད།",
    "གཟུགས་སྐུ་ཞི་བའི་དབྱིངས་སུ་མནལ་ལགས་ཀྱང་།",
    "རིགས་རུས་ཆོ་འབྲང་ལྡན་པར་སྐྱེ་སྤྲུལ་གར།",
    "རྗེ་བཙུན་རྣམ་སྣང་མཁྱེན་པའི་གཏེར་ལ་འདུད།",
    "འོད་དཔག་མེད་མགོན་ཟུར་ཕུད་ལྔ་༢ན་པར་འདུད།",
    "འདོད་གསོལ་སྨོན་ཚིག་རྒྱས་པར་སྤྲོ་ན་ཤེས་བྱའི་མཁའ་དབྱིངས་མ་འདོན།",
    "སེར་སྣ་མེད་པར་དངོས་པོ་ཀུན་གཏོང་ཞིང་།",
    "ཚོགས་གཉིས་རྣམ་པར་རྫོགས་པའི་གྲུ་ཆེན་གྱིས།",
    "གནས་མཆོག་རི་བོ་རྩེ་ལྔའི་འཇམ་དབྱངས་རིགས་ལྔའི་ལྷ་ཁང་སོགས་སུ་ཡོད་པའི་འཇམ་དབྱངས་རིགས་ལྔའི་སྐུའི་ཆ་བྱད་སྣ་ཚོགས་པས་མི་མཐུན་པར་སྣང་ཞིང་།",
    "རིགས་ཀུན་བདག་པོ་མཁྱེན་གཏེར་འཇམ་པའི་དབྱངས།",
    "དངོས་གྲུབ་ས་པར་བསྔགས་པའི་གནས་ཆེན་ལྔའི།",
    "དགའ་སྤྲོའི་ཡིད་ཀྱང་དགའ་བ་ཉམས་པར་དོགས།",
    "ཀུན་ནས་མ་ཉམས་གསེར་འོད་རྣམ་པར་འཕྲོ།",
    "ཕྱེ་ལས་བེ་ཌ་ཱུར་བུམ་པར་འོད་འཚེར་བའི།",
