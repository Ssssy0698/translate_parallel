    "གཞན་ལའང་མ་བཅོལ་བར་བླ་གབ་མེད་པར་བོར་བས་ཆུད་ཟོས་སམ་མ་ཟོས་ཀྱང་དེའི་ཉེ་འཁོར་ནས་འདོམ་ཞེ་དགུ་ག་གསམ་ཡག་ནས་ཀར་ཡག་འདས་ཏེ་ཕྱིན་པ་ན་དང་།",
    "གཙུག་ལག་ཁང་ཟླདུ་སྔར་ཞུགས་པའི་དགེ་སློང་གཞན་ལ་ཐོ་འཚམས་པའི་བསམ་པས་ཕྱིས་གནོན་བྱས་ཏེ་ལུས་ངག་ཟིལ་གྱིས་གནོན་པ་ན་དང་།",
    "རྩྭ་སོགས་ཆུར་འདེབས་པར་བྱེད་དམ་བྱེད་དུ་བཅུག་པས་སྲོག་ཆགས་ཇི་སྙེད་ཤི་བ་དེ་སྙེད་ཀྱི་དང་།",
    "སྔར་བཞིན་དགེ་སློང་མ་དང་ལྷན་ཅིག་གྲུར་ཞུགས་ནས་ཐད་ཀ་དེ་ཉིད་དུ་མིན་པར་རྒྱུན་ལས་ལྡོག་སྟེ་གྱེན་དང་།",
    "འདིར་བྱིན་ལེན་བྱས་པའི་ཟས་ཟ་བའི་འཕྲོ་མ་རྫོགས་པར་ལོང་ནས་ཡང་ཟ་ན་བརྩམས་ལྡང་ངོ།",
    "ན་བ་སོགས་གནང་བའི་དུས་མིན་པར་མཚམས་ནང་དུ་བསམ་པ་མི་མཐུན་པས།",
    "མུ་གེའི་དུས་མིན་པར་ཟོས་ན་ཉེས་བྱས་སོ།",
    "མཚམས་གཞན་གྱིས་མ་ཆོད་པར་མདུན་དུ་སྟོབ་པ་པོས་ལག་གཉིས་བཀན་ཏེ་བསྟབ་ཅིང་ནོད་པ་པོས་ཀྱང་ལག་གཉིས་གན་རྐྱལ་དུ་བཀན་ནས་བླང་ངོ།",
    "དེ་ལྟར་བྱིན་ལེན་བྱས་པ་འཇིག་པའི་རྒྱུ་ནི་ལུང་རྣམ་འབྱེད་ལས།",
    "སྲོག་ཆགས་ཡོད་པའི་རྩྭ་ཤིང་སོགས་མེར་འཇུག་པ་སོགས་བྱས་ཏེ་ལོངས་སྤྱོད་ན་སྲོག་ཆགས་སོགས་ཇི་སྙེད་ཤི་བ་དེ་སྙེད་ཀྱི་དང་།",
    "ཁྲོས་པས་དགེ་སློང་གཞན་ལ་རྡེག་པར་ཆརྒྱུབརྩམ་པ་སྟེ་རྡེག་ཚུལ་བྱས་པ་དེས་གོ་བ་ན་དང་།",
    "ཆུ་ཚགས་མ་གཏོགས་རུང་བའི་ཚོན་གསུམ་གྱིས་ཁ་བསྒྱུར་བ་མིན་པའི་ཁྲུ་གང་ཡན་ཆད་ཁ་དོག་དཀར་པོ་ཅན་གྱི་གོས་གཡོགས་མེད་པར་གྱོན་པ་ན་དང་།",
    "དགེ་སློང་གཞན་དངངས་པར་བྱེད་འདོད་པས་ཡིད་དུ་མི་འོང་བའི་འཇིགས་པ་སྣ་ཚོགས་སྟོན་ནམ་སྟོན་དུ་བཅུག་པས་དེས་གོ་བ་ན་དང་།",
    "དེའི་ཕྱེད་ལ་ཉེས་བྱས་ཞེ་བདུན་སུ་འགྱུར་བ་རྣམས་སོ།",
    "འཇིག་རྟེན་ལ་གྲགས་པའི་ས་སྲ་ཞིང་འཐས་པར་གནས་པ་སོར་བཞི་ཡན་ཆད་དགོས་པ་ཁྱད་པར་ཅན་མེད་གྷགསུམ་ཁ་བཝཆམ་དལ་ཉག་མས་ཞ་ཆ་ཀན་མ་མཐ་མ་ས་འགག་པཐཙམཚ་པར་རྐོའམ་རྐོར་བཅུག་པ་ན་དང་།",
    "འདི་དག་བཤགས་པའི་ཚེ།",
    "ཤམ་ཐབས་ཡ་མཐའ་དང་མ་མཐའ་མཐོ་དམན་མི་མཉམ་པས་ཟླུམ་པ་མིན་པར་དང་།",
    "ཧ་ཅང་ཐུང་བ་མ་ཡིན་པ་སྟེ་སྟོད་ཀྱི་གྱོན་ལུགས་གསུམ་དང་བཅས་པའི་གོས་ཀྱི་བགོ་ཚུལ་ཅེས་པའི་ཆ་བཅུ་པོ་དེ་རྣམས་སྤངས་ཏེ་ལེགས་པར་བགོ་བ་ལ་བསླབ་པར་བྱའོ།",
    "དྲན་ཤེས་ཀྱིས་ལུས་ངག་མ་བསྡམས་པར་དང་།",
    "བླ་གོས་དང་མཐང་གོས་མེད་པར་རམ་ལེགས་པར་བགོ་བ་མ་ཡིན་པ་དང་།",
    "རྒྱབ་ནས་ལྟག་པར་བསྣོལ་ནས་དང་།",
    "གཞན་དང་ལག་པ་སྦྲེལ་ནས་འགྲོ་བ་རྣམས་མི་བྱེད་པར་ཞི་དུལ་གྱིས་ཁྱིམ་དུ་འགྲོ་བའི་སྤྱོད་ཡུལ་ཉི་ཤུ་པོ་རྣམས་ལྔ་བཅུ་ཐམ་པ་གསུམ་ལ་བསླབ་པར་བྱའོ།",
    "སྲོག་ཆགས་ཡོད་མེད་སོགས་མ་བརྟགས་པར་དང་།",
    "ཟས་འདྲེན་པ་མ་སླེབས་པར་སྣོད་བཟེད་སྔས་པ་དང་།",
    "དེ་ལྟར་སྐྱོན་རྣམས་སྤང་བར་བྱས་ཏེ་ཟས་བླང་བ་ལ་བསླབ་པར་བྱ་བ་བརྒྱད་དོ།",
    "རང་ངམ་འཇིག་རྟེན་དང་མཐུན་པའི་ཁམ་རན་པར་མིན་པ་དང་།",
    "ཁམ་ཁ་སྒོར་མ་སླེབས་པར་ཁ་གདངས་པ་དང་།",
    "ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཟས་དང་འབགས་པའི་ཆུ་དེའི་ཁྱིམ་དུ་མི་འབོ་བར་བྱེད་པ་དང་།",
    "ལྷུང་བཟེད་འོག་གཞི་མེད་པར་ས་རྗེན་དང་།",
    "འབབ་ཆུ་དྲག་པོའི་རྒྱུན་ལས་ལྡོག་སྟེ་ལྷུང་བཟེད་ཀྱིས་ཆུ་མི་བཅུ་བ་སྟེ་བཅུ་བཞི་པོ་ལ་བསླབ་པར་བྱའོ།",
    "གོས་ཕྲག་པར་གཟར་བ་དང་།",
    "ལྟག་པར་བསྣོལ་བ་དང་།",
    "གཞན་དུ་འདོར་ས་མ་རྙེད་པའི་རྐྱེན་མེད་པར་ཆུའི་ནང་དང་།",
    "འོ་ཞོ་མར་ཞུན་སློང་བ་སོགས་ཐུན་མིན་བཅུ་སྟེ་སོར་བཤགས་བཅུ་གཉིས་པོ་དང་།",
    "ཆགས་པས་ཁྱིམ་གཞན་དུ་འགྲོ་བ་སྟེ་ཐུན་མིན་གཉིས་དང་བཅས་ཉེས་བྱས་བརྒྱ་མས་དང་བཅུ་གཉིས་ཏེ།",
    "སོགས་ཀྱི་སྒྲས་འདིར་བསྟན་པའི་ལྷག་མ་རྣམས་གཞུང་གཞན་དུ་ཤེས་པར་བྱ་ཞེས། པའོ།",
    "དེ་ལས་དང་པོ་གསོ་སྦྱོང་ལ་སྔར་བསགས་ཀྱི་སྒྲིབ་པ་སྦྱོང་ཞིང་ལྷག་པ་སེམས་དང་ཤེས་རབ་དག་པར་བྱ་བའི་ཕྱིར་ཞི་གནས་ཀྱི་གསོ་སྦྱོང་སྟེ།",
    "རྣམ་པར་གནག་ཟོས་འཐོར་བ་དང་།",
    "དམིགས་པ་གཏད་ནས་སེམས་འཇོག་པར་བྱེད།",
    "དེའི་རྒྱུན་གཡེང་བར་མི་འགྱུར་བསཀུན་ཏུ་འཇོག་པར་བྱེདཾ།",
    "རྣམ་པར་གཡེང་ན་སླར་ཡང་ངེས་པར་འཇོག་པར་བྱེད།",
    "ཡང་ཡང་སེམས་ནང་དུ་བསྡུ་བས་ཉེ་བར་འཇོག་པར་བྱེད།",
    "འདུ་བྱེད་པ་མེད་པར་མཉམ་པར་འཇོག་པར་བྱེད།",
    "ཅེས་པ་ལྟར་སེམས་གནས་པའི་ཐབས་དགུས་འདོད་པའི་སེམས་རགས་པ་ཞི་བར་བྱས་ནས།",
    "རང་ཉིད་གཅིག་པུ་ལས་མེད་ན་སྔོན་གྱི་གསོ་སྦྱོང་ཚིགས་སུ་བཅད་པ་ཕྱེད་དང་བཞི་ཙམ་འདོན་པར་བྱའོ།",
    "ཅེས་པའི་སྡོམ་གྱིས་བསྟན་པ་ལ་སོགས་པརྣམས་སོ།",
    "བྱས་ཟིན་པའི་རྙིང་པ་དང་།",
