    "བཟུང་ནས་ཀྱང་སྡོམ་པ་དང་དམ་ཚིག་བསླབ་པ་རྣམས་སྲུང་བ་ལ་འབད་པར་བྱ་དགོས་སོ།",
    "བར་དུ་མི་ཉམས་པར་སྲུང་བའི་ལྷག་བསམ་ཁྱད་པར་ཅན་གྱིས་བསྲུང་བར་བྱ་དགོས་ཏེ།",
    "དམ་ཚིག་དང་སྡོམ་པ་ནི་སྔགས་ཀྱི་བསླབ་པ་ཐམས་ཅད་ཀྱི་གཞི་རྟེན་ཡིན་པས་དེ་ཉམས་ན་བསླབ་པ་ཐམས་ཅད་དོན་མེད་པར་འགྱུར་བའི་ཕྱིར།",
    "ཐོག་མར་དམ་ཚིག་དང་སྡོམ་པ་ཀུན་གྱི་རྟེན་དུ་གྱུར་པ་རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་ཡན་ལག་བརྟུལ་ཞུགས་ཉེར་ལྔ་པོ་འདི་དཔལ་ལྡན་དུས་ཀྱི་འཁོར་ལོ་ལས་གསུངས་ཏེ།",
    "འདི་རྣམས་སྲུང་ནུས་ཤིང་འདོད་ན་བརྟུལ་ཞུགས་ལྷག་མ་ཉི་ཤུ་སྦྱིན་པར་བྱ་བ་ཡིན་པས་བསླབ་པའི་གཞི་ལྔ་སྤང་ངོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་གསོད་པ་ལྔ་རུ་གྲགས་པ་ལས་ལྡོག་པར་བྱའོ།",
    "ཉི་ཤུ་པོ་དེ་རྣམས་འཕྲལ་དུ་སྤྱོད་ལམ་གྱི་སྒོ་ནས་སྤོང་ཞིང་ལྡོག་པ་ལ་འབད་པར་བྱའོ།",
    "རྫོགས་རིམ་སོ་སོར་སྡུད་པའི་རྣལ་འབྱོར་གྱིས་འཇུག་པ་གཅོད་པ་སོགས་དྲན་ཤེས་ཀྱི་གཉེན་པོ་ཀླུབསྟེན་པ་ལ་འབད་པར་བྱའོ།",
    "དངོས་བསྟན་ལྟར་ན་ཕྱི་མཚན་མ་རྫས་ཀྱི་རྡོར་དྲིལ་བཟུང་ནས་རང་ཉིད་ལྷ་སྐུ་ཕྱག་རྒྱ་ཆེན་པོར་བསྐྱེད་ནས་དག་དྲན་བྱ་བ་སྟེ།",
    "ཕྱག་རྒྱ་ནི་ཕན་ཚུན་རྒྱས་བཏབ་ནས་མཉམ་པར་སྦྱོར་བའོ།",
    "ཐབས་ཤེས་གཉིས་མེད་ཀྱི་ཐུགས་མཚོན་པར་བྱེད་པ་མཚན་མ་རྫས་ཀྱི་དང་།",
    "སྦྱིན་སྲེག་སོགས་ལས་བཞིའི་རིམ་པ་ཐམས་ཅད་ཅི་ནུས་སུ་འཛིན་པར་བྱེད་ཅིང་།",
    "དང་པོ་སྲོག་གཅོད་པ་ནི་ཞེ་སྡང་རྣམ་པར་དག་པ་རྡོ་རྗེའི་རིགས་མི་སྐྱོད་པའི་དམ་ཚིག་ཡིན་ཏེ།",
    "མཁས་པས་བརྒྱ་བསྒྲིམས་ཏེ་གསད་པར་བྱ།",
    "ཡང་ན་སྲོག་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་སེམས་ཡིན་ལ།",
    "དེ་བཅད་པ་ནི་དེའི་རྒྱུན་སྐྱེ་མེད་ཀྱི་དབྱིངས་སུ་དག་པར་བྱ་བའོ།",
    "སྦྱིན་ཡུལ་གྱི་དབུལ་བ་སེལ་བ་སོགས་ཕན་པར་གྱུར་ན་སྔགས་ཀྱི་མཐུས་གཞན་ནོར་བླང་བ་དང་།",
    "དེས་མཆོད་སྦྱིན་སོགས་བྱས་ན་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "བཞི་པ་ཕྲག་དོག་རྣམ་པར་དག་པ་ལས་ཀྱི་རིགས་ཀྱི་དམ་ཚིག་ལ་རྫུན་དུ་སྨྲ་བར་གསུངས་པ་ནི།",
    "དྲང་དོན་དུ་གཞན་ལ་ཕན་པར་གྱུར་ན་རྫུན་དུ་སྨྲ་བར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་བདུད་རྩི་ལྔ་མཚདང་གཟུགས་སོགས་ཡུལ་ཀུན་ཅི་དགར་སྤྱོད་པའི་བདེ་བར་བསྟེན་པར་གསུངས་པ་དང་།",
    "བདུད་རྩི་ལྔ་ནི་འབྱུང་ལྔའི་དྭངས་མ་བཅིངས་པ་ལས་ཞུ་བའི་ཐིག་ལེ་རྡུལ་ཕྲ་རབ་ཀྱི་ཚོགས་དག་པར་བྱེད་པ།",
    "ཡང་ན་དེ་དག་བསྟེན་པ་དེ་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་མཉམ་པ་ཉིད་ཀྱི་དབྱིངས་སུ་རོ་གཅིག་ཏུ་བྱེད་པའོ།",
    "དེ་ནས་ཁྱད་པར་རིགས་ལྔའི་དམ་ཚིག་བསྟན་ཏེ།",
    "འདིར་ཁྱད་པར་གྱི་སློབ་དཔོན་རྣམ་པ་གསུམ་སྟེ།",
    "བཀུར་སྟི་མི་བྱེད་པར་བརྙས་པ་སོགས་བྱེད་པ་དང་།",
    "རྡོ་རྗེ་སློབ་དཔོན་ནི་སངས་རྒྱལ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཡིན་པས་ཡུལ་གཉན་པར་མ་ཟད།",
    "ཅི་མཉེས་སྒྲུབ་པའི་སྦྱོར་བ་ལ་བསླབ་པར་བྱའོ།",
    "རྩ་ལྟུང་དང་པོའི་འོག་ནས་ཉེས་པ་ཆེ་བས་ན་གཉིས་པར་བཞག་གོ།",
    "དེའང་ནང་འདྲེས་པའི་སྤུན་ལ་འཐབ་པ་སོགས་ནི་རྡོ་རྗེའི་ནང་དམེ་ཡིནཔས་ཤིན་ཏུ་ལྕི་ཞིང་ཉེས་པ་སྦྱང་དཀའ་བས་གཟབ་པར་བྱའོ།",
    "ཞེས་པ་ལྟར་འདོད་ཆགས་ཀྱི་སེམས་ཀྱིས་གནང་བའི་གནས་སྐབས་བདུན་མ་ཡིན་པར་བསླབ་པ་ཁྱད་གསོད་ཀྱིས་མི་འགྱུར་བའི་བདེ་བ་ལ་མ་དད་ཅིང་།",
    "ཞུ་བདེ་འགྱུར་མེད་ལ་དགོས་པ་མེད་པར་བལྟས་ནས་བསམ་བཞིན་དུ་ཁུ་བ་འབྱིན་པ་དང་།",
    "ཁ་ཤགས་ཙམ་བྱེད་པ་དང་།",
    "སྔགས་ཀྱི་ལྟ་སྤྱོད་ལ་སྐུར་བའི་ཉན་ཐོས་དངོས་སམ་རྟོག་གེ་བའི་ནང་དུ་ཞག་བདུན་ལོངས་པར་བསྡད་པ་དང་།",
    "གསང་སྔགས་ཀྱི་རྣལ་འབྱོར་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡེ་ཤེས་བཅུ་བདུན་དང་མི་ལྡན་པར་རང་ཉིད་སྔགས་འཆང་རྡོ་རྗེ་འཛིན་པར་སྨྲ་ཞིང་རློམ་པ་དང་།",
    "ཡན་ལག་གང་རུང་མ་ཚང་བའི་ཉེས་བྱས་སོགས་དུ་མ་རྣམས་ཡོད་ཀྱང་ཉེས་པ་ཆུང་བའི་ཚུལ།",
    "བསྲུང་བར་བྱ་བ་གང་གསུངས་པ།",
    "གསུམ་པ་ནི་འོག་ཏུ་འཆད་པར་འགྱུར་ལ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "དང་པོ་སྐུའི་དམ་ཚིག་གསུམ་ཚན་གསུམ་ནི་རིམ་པར་མ་བྱིན་པར་ལེན་པ།",
    "ཡི་དམ་གྱི་ལྷ་ཡིད་ལ་མ་བྱས་པ་དང་།",
    "མཆེད་ལྕམ་ལ་བརྩེ་གདུང་ཡིད་ལ་མ་བྱས་པ་རྣམས་སྤང་བ་ཐུགས་ཀྱི་གསང་བའི་དམ་ཚིག་སྟེ་ཉི་ཤུ་རྩ་བདུན་དང་།",
    "བརྗོད་མེད་རྟོགས་པས་གབ་སྦས་མེད་པར་སྨྲ་བའི་བརླང་ཚིག་རྣམས་ནི་སྤྱད་པར་བྱ་བ་ལྔའོ།",
    "མ་ཟད་རྣམ་པར་གྲོལ་བའི་མྱུར་ལམ་ཡིན་པས་ཀྱང་མི་སྤང་སྟེ།",
    "གཏི་མུག་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་སྟེ།",
    "ཁ་དོག་ལྔ་རིགས་ལྔ་ཡེ་ཤེས་ལྔ་སོགས་ལྔ་ཚན་གྱི་རྟོག་ཚོགས་རྣམས་ཀྱི་རང་བཞིན་ལྷ་རུ་དག་པས་སྐུ་དང་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་དུ་ཤེས་རབ་ཀྱིས་སྒྲོ་འདོགས་བཅད་ནས་ཤེས་པར་བྱེད་པ་སྟེ་དེ་དག་ནི་ཤེས་བྱ་ལྔའོ།",
    "ལས་ཀྱི་རིགས་ཏེ་ལྔའི་སྒོ་ནས་རང་རྒྱུད་ལ་ཚུལ་བཞིན་དུ་བསླབ་པར་བྱ་ཡབཅསམ་བ་སྟེ་དེ་དག་ནི་བསྒྲུབ་བྱ་ལྔའོ།",
    "དུས་ཚོད་ཀྱི་གནས་སྐབས་བརྩིས་ནས་དེ་དང་འབྲེལ་བའི་སྒོ་ནས་སྤྱོད་དགོས་པས་དངོས་བསྟན་དང་སྦས་དོན་གྱི་ཚུལ་དུ་གསུངས་པའི་དགོངས་པ་བླང་བར་བྱའོ།",
    "རབ་ཏུ་ལྷག་པར་བསྲུང་བར་བྱ།",
    "ཅེས་སློབ་དཔོན་གཙུག་ཏུ་ཁུར་བ་ལས་ཉམས་པར་མི་བྱ་བའོ།",
    "ལྷག་པར་གཅེས་པའི་དམ་ཚིག་ཡིན།",
    "མི་གཏོང་ནའང་ཡན་ལག་ཉམས་པར་བྱེད་པའི་རིགས་གཉིས་སུ་འདུས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུའི་དམ་ཚིག་རྣམས་མ་ཉམས་པར་སྲུང་བ་ལ་འབད་ཅིང་།",
    "སྤྱིར་གུས་ཀྱང་ཉེས་དམིགས་མ་མཐོང་བའམ་དྲན་ཤེས་མེད་པས་གཟོབ་པར་མི་བྱེད་པས་བག་མེད་པར་སྤྱོད་ཅིང་།",
    "དགྲ་ཆེ་སར་ཟོན་བྱེད་པ་ལྟར་ཉེས་དམིགས་ལ་འཇིགས་ནས་སེམས་སྒྲིམ་སྟེ་རྟག་པར་དྲན་ཤེས་དང་བག་ཡོད་བསྟེན་པ་དང་།",
    "ཤེས་བཞིན་མེད་པས་དྲན་པ་མི་གསལ་བ་གཉིས་བསྣན་ཏེ་དམ་ཚིག་ཉམས་པའི་རྒྱུ་དྲུག་ཅེས་དཔལ་ལྡན་སྡོམ་པའི་རྒྱུད་ལས་གསལ་བར་གསུངས་ཏེ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཡིད་ཀྱིས་འགྲུབ་པ་རྣམས་ཉིན་མཚན་གྱི་དྲུག་ཆའི་ནང་དུ་གཉེན་པོས་མ་སླེབས་པར་ཐུན་ཚོད་ཀྱིས་བར་ཆོད་ཉེར་བཞིགནམ་བམཔ་དང་།",
    "བཤགས་པས་མ་ཟིན་པར་ཐུན་ཚོད་ལས་འདས་པ་སྟེ།",
    "ལྷག་པའི་ལྷ་ལྟ་བུའི་ཡུལ་ཁྱད་པར་ཅན་གྱིས་གནང་བ་ཐོབ་པ་དང་།",
    "རང་སྲོག་སྲུང་བའི་ཕྱིར་གཞན་གསོད་པ་སོགས་ལ་ཉེས་པ་མེད་ཅེས་པའི་དོན་མ་ཡིན་པར་ཤེས་པར་བྱ་དགོས་སོ།",
    "དུས་དྲུག་ཆའི་ནང་དུ་གཉེན་པོས་མ་སླེབས་པར་འདས་ན་ཐུན་ཚོད་འདས་པ་ཞེས་བྱ་བ་དང་།",
    "དུས་ལ་ལྟོས་པ་ཐུན་འདས་ཞེས་འགལ་ཉམས་སོགས་ཀྱི་བཤགས་བྱའི་ལྕི་ཡང་ཤེས་པར་བྱའོ།",
    "ཉམས་པར་གྱུར་པ་གང་ཞེ་ན།",
    "དད་འདུན་དྲག་པོས་གནོང་འགྱོད་དང་བཅས་པས་བཤགས་པ་འདུན་པ་དང་།",
    "མཚན་མ་མེད་པའི་ངང་ལ་འཇོག་པ་དེ་ཁོ་ན་ཉིད་ཀྱིས་བསྐང་བ་སྟེ་རྣམ་པ་ལྔར་གསུངས་ཏེ།",
    "ཚོགས་ཞིང་སྤྱན་དྲངས་ལ་དེའི་དྲུང་དུ་སྟོབས་བཞི་ཚང་བས་བཤགས་པ་དང་།"
  ]
}