    "རྒྱུད་སྨད་གྲྭ་ཚང་སོགས་སུ་ཕེབས་ནས་གསང་སྔགས་ལ་སྦྱངས་ཚུལ།",
    "རབ་བྱུང་དགུ་པའི་ས་གླང་ལོར་དགའ་ལྡན་གསེར་ཁྲིར་ཕེབས་ནས་ལོ་བརྒྱད་ཀྱི་རིང་བསྐྱངས།",
    "ཀུན་མཁྱེན་བློ་གྲོས་རིན་ཆེན་སིང་གེས་ཕྱོག་བཏབ་པའི་བྱེས་མཁས་མང་གྲྭ་ཚང་བཅས་དྲུག་བྱུང་ཡོད་པ་ལས།",
    "ཀུན་མཁྱེན་བློ་གྲོས་རིན་ཆེན་སེང་གེ་ཡིན།",
    "དགུང་ལོ་བཅུ་གསུམ་ཐོག་བཀྲ་ཤིས་ལྷུན་པོར་ཐུགས་གཉེཪ་ལ་འཕེབས་ཏེ།",
    "རྩ་འཇུག་ཊཱིཀྐ་སོགས་ལེགས་པར་གསན་པ་དང་མཁན་ཆེན་ཤེས་རབ་བཟང་པོའི་དྲུང་ནས་བསྙེན་རྫོགས་ཀྱི་སྡོམ་ཡང་དག་པར་བཞེས།",
    "དགུང་ལོ་ཉི་ཤུའི་ཐོག་ཡང་མཁན་ཆེན་དེ་ལས་བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་ཡང་དག་པར་བཞེས།",
    "བཙན་པོ་བསྡུས་གྲྭ་སོགས་སྔར་སྲོལ་གནང་ན་དེ་གས་འཐུས།",
    "ལེགས་འབབ་དྭངས་གཙང་ཡན་ལག་བརྒྱད་ལྡན་ཆུ།",
    "འདུས་བྱས།",
    "༢ ༡ རྣམ་པར་མི་འཚེ་བ་དང་བཅུ་གཅིག་གོ། བཞི་པ།",
    "༢༧ རྣམ་པར་འཚེ་བ།",
    "བེམ་ཤེས་གང་རུང་མ་ཡིན་པའི་འདུས་བྱས་དེ།",
    "གནས་པར་གྱུར་ཚེ་ལུང་དང་རིགས་པ་ཡིས།",
    "གཟུགས་དང་བེམ་པོ་དོན་གཅིག་ཤེསཔར་བྱ།",
    "མི་སྲིད་རྣམ་པར་གཅོད་པའི་སྒྲ་རྣམས་སོ།",
    "རོ་ལ་བརྒྱ་དང་བརྒྱད་དུ་ཤེས་པར་གྱིས།",
    "སྒྲ་དང་རྟོག་པས་བཏགས་ཙམ་མ་ཡིན་པར།",
    "འཇིག་པ་འདུས་བྱས་སྐྱེད་བྱེད་རྒྱུ་ཡི་དོན།",
    "དངོས་སུ་རྟོགས་པར་བྱ་བ་ལྐོག་གྱུར་དོན།",
    "ཀུན་རྫོབ་བདེན་པའི་དོན་དུ་ཤེས་པར་གྱིས། སོ་སོ་བ་དེ་ཐ་དད་མཚན་ཉིད་དང་།",
    "ལྡན་མིན་འདུ་བྱེད་མཚན་ཉིད་ཡིན་ཞེས་གསུངས།",
    "གསུངས།",
    "རྣམ་བཅད་ཡོངས་གཅོད་སྒོ་ནས་མི་མཐུན་པར།",
    "ཕན་ཚུན་དངོས་སུ་མི་མཐུན་པར་གནས་དེ།",
    "མི་མཐུན་པར་གནས་པ་བརྒྱུད་འགལ་དོན།",
    "གཅད་བྱ་གཅོད་བྱེད་སྒོ་ནས་མི་མཐུན་པར།",
    "བུམ་དང་བུམ་པའི་ལྡོག་པ་ལྟ་བུར་གསུངས།",
    "གཞི་གྲུབ་ན་ནི་དེ་མེད་པར་རྟོགས་པའི།",
    "དངོས་པོ་མ་ཡིན་ན་ནི་དངོས་མིན་པར།",
    "འདི་ཡིས་ཀུན་ལ་རིགས་བསྒྲེ་ཤེས་པར་གྱིས།",
    "ཤེས་པ་དེ་ནི་གཉིས་ཀའི་མཚན་གཞིར་གསུངས།",
    "སྐལ་མཉམ་མཚུངས་པར་ལྡན་པ་དང་།",
    "ནུས་ལྡན་ནུས་མེད་གཉིས་སུ་གསུངས།",
    "ལྔ་པ་བྲལ་བའི་འབྲས་བུར་གསུངས།",
    "འདས་དང་མ་འོངས་རྟག་པར་འདོད།་།",
    "རྒྱུ་འབྲས་ཆེ་བ་དང་ཞར་བྱུང་དུས་གསུམ་དོན་ལ་རང་ལུགས་རྣམ་པར་བཞག་པ་སྟེ་ས་བཅད་དྲུག་པའོ།",
    "ལྡོག་ཁྱབ་ཉིད་ཀྱི་ལྡོག་ཁྱབ་ལགས།",
    "དབྱེ་བ་རྣམ་པ་གཉིས་སུ་གསུངས།",
    "འདུས་བྱས་ཡིན་ཕྱིར་སྐད་ཅིག་ཕྱིར།",
    "བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་པའི།",
    "ཁས་བླངས་ཀྱིས་གྲུབ་བཞི་ཡོད་གསུངས།",
    "བཀོད་ཚོད་ཀྱིས་ནི་བཅུ་བཞིར་གསུངས་། རྒོལ་བ་གང་ཞིག་སྒྲུབ་བྱེད་འགོད།",
    "གཞན་སེལ་ཡང་ཡིན་དོན་དམ་པར།",
    "དོན་བྱེད་ནུས་པར་དམིགས་པ་དེ།",
    "དོན་གཅིག་ཏུ་ནི་གསུངས་པའོ།",
    "རྟོག་མེད་ལོག་ཤེས་དོན་གཅིག་གསུངས།",
    "ཡུལ་ཅན་མཚན་ཉིད་ཡིན་པར་གསུངས།",
    "ཡུལ་ཅན་ཤེས་པས་ཁྱབ་ཅེས་གསུངས།",
    "བཀའ་དང་བསྟན་བཅོས་གཉིས་པར་འདོད།",
    "ཡུལ་ཅན་ཡིན་ཏེ་རྣམ་མཁྱེན་གྱི།",
    "སྡོམ་ལ་ངལ་བ་མ་བྱས་སོ།",
    "རྣམ་མཁྱེན་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "རྟགས་ལ་བརྟག་དཔྱད་བྱས་ནས་ལན་འདེབས་པའི་ཚུལ་དང་།",
    "གསལ་བ་ལ་བརྟག་དཔྱད་བྱས་ནས་ལན་འདེབས་ཚུལ་ལོ།",
    "དང་པོ་རྟགས་ལ་བརྟག་དཔྱད་བྱས་ནས་ལན་འདེབས་པའི་ཚུལ་ལ་གཉིས།",
    "གཉིས་པ་གསལ་བ་ལ་བརྟག་དཔྱད་བྱས་ནས་ལན་འདེབས་པའི་ཚུལ་ལ་གཉིས།་",
    "བུམ་པ་དངོས་པོ་ཡིན་པར་འདོད་ཅེས་རྩི་དགོས།",
    "ཨཱུ་ཌ་་ད་ནི་རྟགས་གསལ་གཏོང་སྲོལ་དང་སྦྱར་ནས་ལན་འདེབས་ཚུལ་འཆད་པར་བྱའོ།",
    "གཟུགས་ཀྱི་མཚན་ཉིད་གཞོག་རྒྱུ་ཡོད་པར་འདོད་ཅེས་ལན་འདེབས་དགོས།་",
    "ཕྱི་གཟུགས་དང་ནང་གཟུགས་གཉིས་ཀྱི་ཁྱད་པར་ཞོག་ཟེར་ན།",
    "རོ་དྲུག་པོ་གང་རུང་ཡིན་ན་རོ་ཡིན་པས་ཁྱབ་པར་འདོད་ཅེས་ལན་ཐོབ།",
    "དངོས་པོའི་གཞི་ལྡོག་ཡིན་ན་དངོས་པོའི་ལྡོག་པ་མ་ཡིན་པས་ཁྱབ་པར་འདོད་ཅེས་ལན་ཐོབ།་",
    "ཡིན་པ་མི་སྲིད་པའི་ཤེས་བྱ་ཤེས་བྱ་ཡིན་པར་འདོད་ཅེས་ལན་ཐོབ།"
  ]
}