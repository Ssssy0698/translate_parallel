    "སྤྱོད་ཡུལ་རུས་པར་སྣང་བ་དང་མཚུངས་པའོ།",
    "དེ་མ་གྲུབ་པར་སྟོན་ཏོ།",
    "བག་ཆགས་རྟས་ཤིང་སད་པར་བྱེད་པའི་རྐྱེན་ཡང་རྣམ་པ་སྣ་ཚོགས་ཏེ།",
    "གུ་མལང་ལ་སོགས་པ་མཆོད་ལེགས་པས་མཐོ་རིས་སུ་གཏོང་བར་བྱེད་པར་འདོད་དེ་དེ་དག་རྒྱུར་ལྟའོ།",
    "དེ་མི་བདེན་པར་སུན་དབྱུང་བའི་ཕྱིརལམ་དེ་མི་ཞི་གྲོལ་མི་འགྱུར།",
    "གདེང་མེད་པར་བྱེད་པའི་རྒྱུ་ཡང་ཤེས་པ་བརྒྱད་པོ་ཉིད།",
    "དེས་ན་དེ་ལ་གནས་པར་མི་བྱའོ།",
    "བདག་ཏུ་བརྟགས་པས་བསྒྲིབས་ཏེ་འཕགས་པའི་རིགས་དང་རྣམ་པར་བྲལ།",
    "བདག་མེད་པར་འདོད་པའི་ཉན་ཐོས་ཀྱི།",
    "ཞེས་པ་སེམས་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ནི།",
    "ཕྱི་མས་ཡུལ་དུ་བརྟགས་པས་མཐུ་བརྟས་པའི་ཕྱིརཤེས་པ་ཕྱི་མ་སྔ་མ་མཐུ་བརྟས་པ་ལས་འབྱུང་ཞིང་རྒྱུད་མཐུན་པར་སྣང་བའོ།",
    "དེ་བས་ན་བྱང་འགྲེལཆུབ་སེམས་ནི་གཅིག་དང་དུ་མ་ལས་གྲོལ་བས་འདི་ཞེས་བརྗོད་དུ་མི་བཏུབ་པ་ལཉན་ཐོས་ལྟར་ཡུལ་དང་ཤེས་པ་རང་རྒྱུད་པར་གྲུབ་པ་མེད་པས་སྒྲིབ་པ་བས་བསལ་ཏོ།",
    "རྒྱུན་རྟག་ལ་དེ་ལྟར་མཐོང་བའི་དུས་ན་དངོས་པོ་ཡུལ་རིལ་ཤེས་པ་སྣང་བས་བཟང་ང་ངན་མེད་པར་པར་མཐོང་བ་ཡུལ་ལོགས་སུ་གྲུབ་པས།",
    "ཤེས་པའང་སྐྱེ་བོ་པ་ལྟར་རྒྱ་ཆད་པར་མ་གྲུབ་པའོ།",
    "ཤེས་པ་འཁྲུལ་པ་ཐག་སྦྲུལ་ལྟར་སྣང་བའི་གཏན་ཚིགས་ཀྱིས་ཡུལ་མ་གྲུབ་པར་འདོད་དོ།",
    "ཚོགས་དྲུག་ཀྱང་ཡུལ་རིག་ཅིང་ཤེས་པར་མི་རིགས་པའོ།",
    "དེ་ལྟར་ཡུལ་དང་ཤེས་པ་རྒྱ་མ་ཆད་དང་གཅིག་པར་འདོད་པ་དེ་ཉིད་ཀྱི་གཏན་ཚིགས་ཀྱིས།",
    "ཀུན་རྫོབ་ཏུ་འཁྲུལ་པའི་ཤེས་པ་སྐད་ཅིག་བཅོསགསེར་མའང་མ་གྲུབ་པར་སུན་བཏོན་ཏོ།",
    "རྒྱལ་བ་རྣམས་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ལས་མ་གཡོས་པར།",
    "སྤྲོས་པ་རྣམ་པར་དག་པའི་ཡེ་ཤེས་བཞི་པོ་རྣམས་ལས་ཀྱང་།",
    "དེ་ཡོད་ན་འདུས་བྱས་སུ་འགྱུར་བས་མི་བདེན་ནོ།",
    "སྐད་ཅིག་མེད་པར་རྒྱུན་དང་བཅས་པར་རང་སྣང་བའོ།",
    "དག་པའི་འཇིག་རྟེན་པའི་ཡེ་ཤེས་ཀྱང་མ་གྲུབ་པར་ཞུན་སུན་འབྱིན་པ་བསྟན་པའི་ཕྱིརདག་པའི་དགེ་རྩ་གཟུགས་བརྙན་མེད་པས་འཇིག་རྟེན་ཡེ་ཤེས་ཡོད་མི་འགྱུར།",
    "རིགས་པ་མབཞིས་ངེས་པར་ཤེས་བྱའི་ཡུལ་དམ་པར་བཞག་པ་ནི་མི་བདེན་ཏེ།",
    "བསྡུ་བའི་སྒྲས་མཚན་གཞན་ཇི་སྙེད་པ་བསྡུ་སྟེདེའི་ངོ་བོ་མ་སྐྱེས་པ་ནི་དོན་དམ་པར་འདོད་ལ།",
    "དེ་ལྷག་མས་མི་བདེན་པར་སུན་འབྱིན་པ་སྟེདོན་དམ་མེད་ཅིང་ཀུན་སྒྲིབ་མེད།",
    "མཐའ་རྣམས་མེད་ཕྱིར་དབུས་མེད་དབུས་ལའང་གནས་པར་མི་བྱེད་དོ་ཞེས་པ།",
    "དེ་ལྟར་གདེང་ཆུད་པར་བྱ་བ་ཐོག་མར་གཅེས་པར་བསྟན་ཏོ།",
    "བདག་ཉིད་ཆེན་པོར་མངའ་བརྙེས་པས་ཡུལ་མེད་པར་དུས་ཅིག་ཏུ་བསྟར་ལ་ཟིན་ཆགས་བྲལ་བས།",
    "ཐམས་ཅད་ལ་དོར་བ་མེད་དེ་ལྷུན་གྱིས་གྲུབ་པའི་ངོ་བོར་བཞུགས་པའོ།",
    "ལྷག་མ་ནི་གང་ཡང་མ་འཁྲུལ་བཅོསགསེར་པས་སྤོང་ལེན་མི་བྱེད་པར་བསྟན་པའོ།",
    "ཡུན་ཇི་ཙམ་དུ་བདག་འཛིན་གྱིས་མུ་པསྟེགས་རྒྱལ་ཐབས་པར་གྱུར་པས།",
    "གཡོ་དང་མི་གཡོ་ཐ་སྙད་མི་གནས་གནས་ལའང་གནས་པར་མི་བྱེད་དོ།",
    "དེ་ལྟ་བུའི་རྟོག་པ་དག་རིག་པ་ཇི་བཞིན་པར་རང་སྣང་བའི་དུས་ན།",
    "དེ་ལ་འདིར་མི་གནས་པར་བསྟན་པའི་ཕྱིར།",
    "ངེས་པར་འཛིན་པ་དང་།",
    "ཞེས་པ་ཤིན་ཏུ་རྣལ་འབྱོར་གྱི་སྐབས་འདིར་བདག་ཉིད་རྣམ་པར་མི་རྟོག་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར།",
    "བློ་གཤིས་སུ་འགྲེལཕེབས་པའི་ཚེ་ཆེད་དུ་དམིགས་པའི་བྱ་བའང་མེད།",
    "རྡོ་ལ་ཚོགས་བསགས་ལ་སྒྲིབ་པ་བྱ་བའི་དྲན་རྩོལ་མི་གཡོ་སྟེ་ཇི་བཞིན་པར་སྣང་བའོ།",
    "བདག་མེད་པས་གཅེས་པར་འཛིན་པའི་འདུ་ཤེས་བྲལ་བ་དང་རྟོག་པའི་ཡེ་ཤེས་སུ་གསལ་བ་དང་ངར་འཛིན་བྲལ་བ་དང་སྤང་བྱ་མ་མཐོང་བ་དང་།",
    "པ་ཡུལ་དུ་མེད་པར་བརྟན་པའི་ཕྱིར།",
    "ཞེས་གསུངས་བཤེས་ནིཔའི་གཏན་ཚིགས་ཀྱིས་འཐོབ་ཏུ་བཏུབ་བོ།",
    "བྱས་ན་འཆིང་བ་ཆེན་པོར་འགྱུར།",
    "སྤྱོད་པར་གསུངས།",
    "སྦྱིན་གནས་དམ་པར་རབ་ཏུ་བསྔགས།",
    "ཞེས་རྒྱལ་བས་གསུངས།",
    "སྒྲ་ཇི་བཞིན་པར་རང་ཐད་དུ་འཛིན་ཅིང་རྟོག་པ་ནི་མ་ནོར་བའི་དོན་མཐོང་བ་མ་ཡིན་པའོ།",
    "དེ་ཕྱིར་རྒྱལ་བས་གསུངས་པའི་ཐུགས་ཀྱི་གསང་བ་དམ་པ་འདི།",
    "ཕྱོགས་མཐོང་བཀྲོལ་བས་དམན་ཕྱིར་བརྩམ་བྱས་པའི།",
    "ཟུང་འཇུག་འདུས་མ་བྱས་པའི་དབྱིངས།",
    "གང་ལ་བརྟགས་ཏེ་རྟོགས་པར་བྱ་བ།",
    "བརྒྱུད་པའི་ཐབས་ཀྱིས་སྔ་ངེས་པའི་དོན་རྟོགས་པར་བྱ་བའི་ཐབས།",
    "སྤྱི་དོན་གཉིས་པ་ཅིའི་ཕྱིར་རྟོགས་པར་བྱ་བ་ལ་ཕན་ཡོན་དང་ཆེ་བ་གཉིས་ལས།",
    "མངོན་གྱུར་འབྲས་བུའི་ཕན་ཡོནརྣམ་པར་གྲོལ་བའི་འབྲས་བུ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་བསྟན་པའོ།",
    "ཡུལ་ཤེས་བྱ་ཐམས་ཅད་ཤེས་པར་བྱེད་པའི་ནང་ན་ཤེས་བྱེད་དམ་པར་གཅིག་པུར་གྱུར་པ་སྟེ་མཚན་། དེའི་ཡུལ་ནི་ཤེས་བྱ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གྱུར་པས་ན་ཡུལ་ཅན་དེའང་ཤེས་རབ་སྤྱན་ཞེས་ཀྱང་ནི་དེ་ལ་བྱ་སྟེ་ཤ་ཡི་སྤྱན་སོགས་ལས་ཁྱད་པར་དུ་འཕགས་ཤིང་བླ་ན་མེད་པའོ།",
    "སྤྱི་དོན་གསུམ་པ་ཅི་ཞིག་རྟོགས་པར་བྱ་བ་ནི།",
    "སོ་སྐྱེ་དེ་དག་ན་འཆི་སོགས་དུས་ཀྱི་དགྲས་འཇོམས་པ་དང་སྡུག་བསྔལ་གསུམ་དང་བརྒྱད་ཀྱིས་ཉེན་པ་ལས་དེས་འཁྲུལ་པ་ཡིན་པར་གསལ་བའམ་མངོན་རྡོ་ལ་གསེར་ཞུན་བློས་རྒྱམ་པར་འགྱུར་རོ།",
    "དོན་དམ་པ་རང་བཞིན་མ་གྲུབ་པར་བསྟན་པའོ།",
    "ཀུན་ཏུ་རྟོག་པ་ཅན་ན་ཡིན་པ་དེ་ཡང་ཡང་དག་མ་ཡིན་པ་གཟུང་འཛིན་དུ་རྟོག་པའི་ཀུན་ཏུ་རྟོག་པས་ཐོག་མེད་ནས་ཀྱང་རྩོལ་བ་མེད་པར་རང་བཞིན་གྱིས་ཉམས་ཏེ་འཁྲུལ་བའོ།",
    "ཀུན་གཞི་བག་ཆགས་སྣ་ཚོགས་བསགས་པ་དང་བཅས་པའི་རྒྱུན་ལ་ངའོ་སྙམ་པའི་དམིགས་པ་སྐྱེས་པ་ཡིན་གྱི་ངའོ་སྙམ་པའི་ཡིད་ཙམ་ལས་ནན་ལྟར་ཞུན་བརྟགས་པའི་ཡུལ་བདག་ནི་མེད་དེ་ཐག་པར་སྦྲུལ་དུ་འཁྲུལ་བ་ན་སྦྲུལ་འཛིན་ཙམ་ལས་སྤྲུལ་མེད་པ་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་དེ་ཡང་མཚན་གཟུགས་སྒྲ་སོགས་འདུ་བྱེད་རྒྱུན་ལ་མཚན་ཉིད་སོ་སོའི་མཚན་མ་ཐ་དད་དུ་འཛིན་པས་ན།",
    "དཔེར་ན་ཚིག་པའི་ས་བོན་ལས་འབྲས་བུ་མི་སྐྱེ་བ་བཞིན་དུ་རྒྱུ་བདེན་པ་མེད་པ་ལས་འབྲས་བུ་མེདྭ་པ་ཞིག་དོན་དམ་པར་ན་མི་འབྱུང་ཏེ་དེས་ན་འདི་ནི་རྒྱུ་འདི་ནི་འབྲས་འགྱུར་སྔ་བུ་ཞེས་བཞག་ཏུ་འང་མེད་དོ།",
    "གཉིས་པ་སྣང་གཞི་སེམས་ཉིད་དོན་དམ་པར་མ་འགྲུབ་པར་བསྟན་པ་ནི།",
    "དངོས་པོའི་གནས་ཚུལ་དང་མི་མཐུན་པས་ཡང་དག་པར་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པས་བསྐྱེད་ཕྱིར་བག་ཆགས་ཡོད་པ་མ་ཡིན་པ་དང་།",
    "གོང་ལྟར་ཕྱོགས་རྣམས་མེད་ཕྱིར་དམིགས་པ་བག་ཆགས་དང་དེ་གནས་པའི་གནས་ཀུན་གཞི་གཉིས་ཀ་མེད་ན་དེམབཅུ་བརྟེན་པའི་རྣམ་པར་ཤེས་ཤིང་རིག་པ་རྣམས་ཇི་ལྟར་སྐྱེ།",
    "གཉིས་པ་ལ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་མ་གྲུབ་པར་བསྟན་པ་དང་།",
    "གཞི་བདེན་གཉིས་མཉམ་པས་བླང་དོར་མེད་པར་བསྟན་པ།",
    "ཐ་སྙད་ཙམ་མིན་པར་དོན་དམ་ཚུལ་གྱི་ལམ་ཉིད་འདི་འགྲེལའདྲའོ་ཞེས་པ་དམིགས་སུ་ཡོད་ན་དེ་ཉིད་ཀུན་སྒྲིབ་ཡིན་གྱི་དོན་དམ་ཡང་དག་པར་ན་ཀུན་རྫོབ་དང་དོན་དམ་ཞེས་བདེན་པ་གཉིས་སུ་དབྱེར་ག་ལ་ཡོད་དེ་མེད་དོ།",
    "ཞེས་དམ་པར་བྱས་ཏེ་ཀུན་ལས་རྒྱལ་ཏེ་ལྟ་བ་དེས་བསྙེམས་པ་སྐྱེན།",
    "འོ་ན་མི་གཡོ་བར་གནས་སོ་ཞེ་ནརྟོག་པ་དང་མཚན་མ་གཡོ་འོ་ཞེས་དང་མི་གཡོའོ་ཞེས་པའི་ཐ་སྙད་ཙམ་ཡང་མི་གནས་པའི་དེ་ལ་འང་གནས་པར་མི་བྱེད་དེ་དེས་ན་རྒྱམམི་གཡོ་ཞེས་པ་དེ་ལ་མི་གནས་པ་ལྟ་ཅི་སྨོས།",
    "མ་གྲུབ་པས་གནས་པར་བྱ་བའི་གཞི་མེད་པས་ན་དེར་ཡང་མི་གནས་སོ།",
    "སྤྱི་དོན་བརྒྱད་པ་བརྒྱུད་པའི་ཐབས་ཀྱིས་ངེས་ལ་བསྟན་བཅོས་གསེར་ཛཔའི་དོན་རྟོགས་པར་བྱ་བའི་ཐབས་བསྟན་པ་ནི།",
    "གནས་འདི་ལ་སྐད་ཅིག་ཙམ་དུ་དད་པའི་ཤུགས་ཀྱིས་གང་ཟག་དེ་བཀའ་བཅོ་བརྒྱད་ཡང་མི་ཐོགས་པར་མྱུར་དུ་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་ཏེ་ངེས་དོན་གྱི་འཇམ་དཔལ་དང་རོ་མཉམ་པར་འགྱུར་བའོ།",
    "ནམ་མཁའ་བར་སྣང་མུ་ཐུག་པ་མེད་པ་འདི་ཡང་སྣོད་རྡོ་ལ་གསེར་ཞུན་བློས་རྒྱམ་དུ་བྱས་ན་ཆུང་བ་ལྟ་བུའོ་ཞེས་ཕྱོགས་དུས་གྱི་རྒྱལ་བས་མཚུངས་པར་གསུངས་སོ།",
    "བཤགས་ན་དྭག་ཚངས་ཁྲུས་ཀྱི་དངོས་གྲུབ་སྩོལ།",
    "སྔ་འགྲེལ་ཨ་༡ ལ་ན་མ་རྩབཀའ་གཅིག་། ཨ་ཏི་རྣལ་དགོངས་ཀྱི་གཞུང་བཞུགས་སོ།",
    "རང་གནས་མ་ཡེངས་བྱས་པ་མེད་པའི་གཞི།",
    "ཁྱད་པར་མཐོང་བ་སུས་ཀྱང་དམིགས་པ་མེད།",
    "སྒོམ་བྱའི་བློ་ཡི་འགྱུར་བཅིངས་པས་བདག་ཏུ་མེད་པར་ནུས་ཀྱང་འཛིན།",
    "དངོས་པོར་སྨྲ་ཕྱིར་ཁྱད་པར་ངས་མ་མཐོང་།",
    "དངོས་པོ་རྣམས་ལས་འཕགས་པར་ནུས་མ་ཡིན།",
    "གང་ལ་མཉམ་པར་ཡིན་པར་མ་ཤེས་སེམས་ཀྱིས་ལེན།",
    "རྫོགས་དོན་གཞན་དུ་མ་ཡིན་ཁྱད་པར་མི་རྙེད་དོ།",
    "དེ་ལ་རྣམ་པར་རྒྱལ་བའི་གཟུགས་མེད་གྲོལ་བ་ག་ལ་ཡོད།",
    "དེས་ན་ཡུལ་སེམས་འབྲེལ་བ་མེད་པར་ངས་རིག་གོ།",
    "ལུས་ཀྱི་བྱ་སྤྱོད་མ་བཅོས་པ་མེད་པར།",
    "རྣོ་བའི་ངར་བསད་ཡོད་སོ་མེད་པར་བྱས།",
    "མ་སྦྱངས་མཁྱེན་ཆེ་ཤེས་པ་གཏི་མུག་ཉིད།",
    "སྲོག་གཅོད་མ་བྱིན་བླངས་དང་མི་གཙང་སྤྱོད།",
    "མ་སྒྱུར་ལམ་དུ་ཡང་དག་ཉིད་གསུངས་པ།",
    "མ་བཞག་བྱས་རྩོལ་རྫོགས་པ་ཆེན་པོའི་སེམས།",
    "རྣམ་པར་དག་པ་ལ་ཉེ་རིག་འཛིན་སུ།",
    "དེ་ཉིད་མ་ཟད་ཀུན་གྱིས་རྟོགས་པར་ཤོག།",
    "མངྒ་ལཾ། ། ཨ་ཏིའི་ས་བཅད་བཞུགས་སོ།",
    "རིམ་གྱིས་རྟོགས་པར་བྱ་བའི་ཕྱིར་གཞུང་བསྟན་པ་ལ་གཉིས་ཏེ།",
    "གཞན་དངོས་ལ་བརྟན་པའི་རིག་པ་དེ་ཉིད་དོན་རིམ་གྱིས་ཕྱེ་ནས་རྟོགས་པར་བསྟན་མ་ལ་པའོ་ དེ་ལ་བསྡུས་པའི་དོན་དྲུག་སྟེ།",
    "ཤེས་བྱ་ཕྱིན་ཅི་ལོག་ཏུ་རྟོགས་པའི་བརྩོན་འགྲུས་ཅི་བྱས་ཀྱང་ཁམས་གསུམ་ལས་མི་གྲོལ་བར་བསྟན་པ་དང་།",
    "ཕ་རོལ་གྱི་འདོད་གཞུང་སུན་འབྱིན་པར་བསྟན་པ་དང་།",
    "སྔ་འགྱུར་བཀའ་མ་ཤིན་ཏུ་རྒྱས་པ་བཞུགས་སོ།",
    "༢༩ལོའི་ཟླ་༩པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "བདག་འཛིན་བློ་ཡིས་ཐོངས་པར་བྱིན་གྱིས་རློབས།",
    "འཕྱུག་མེད་མཁའ་སྤྱོད་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "མངྒ་ལཾ། ། རྣལ་འབྱོར་མའི་ཀུ་སཱ་ལིའི་ཚོགས་བསགས་ཀྱི་ངག་འདོན་བཞུགས། ། རང་སེམས་བྃ་ཡིག་རྡོ་རྗེ་རྣལ་འབྱོར་མ།",
    "ཕན་ཚུན་བདེ་བ་ཆེན་པོས་མཉེས་པར་གྱུར།",
    "མངྒ་ལཾ། ། རྣལ་འབྱོར་མའི་ལུས་དཀྱིལ་ངག་འདོན་ནི། ། བདུན་པ་འགྲོ་བ་དག་པའི་རྣལ་འབྱོར་གྱི་རྗེས་སུ་བསྒོམས་ཀྱང་ཆོག་གསུངས།",
    "ཡེ་ཤེས་པ་བཅུག་པའི་རྗེས་སུ་བསྒོམས་ཀྱང་ཆོག་གསུངས།",
    "ལྷ་སུམ་ཅུ་རྩ་བདུན་པོ་ཐམས་ཅད་ཀྱང་རྒྱན་ཆ་ལུགས་ཡོངས་སུ་རྫོགས་པའི་ཕྱིའི་རྣལ་འབྱོར་མ་དང་མཚུངས་པ།",
    "མཐུན་རྐྱེན་འཛོམ་ཞིང་གནས་དབེན་པར་བསམ་གཏན་གྱི་སྤྱོད་ལམ་དང་ལྡན་པས།",
    "དེ་ལ་ཐིམ་པར་བསམ།",
    "དེ་ནི་གྲངས་ཅན་གྱི་བསྟན་བཅོས་རྩོམ་པར་བྱེད་པ་ཡིན།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར།",
    "གཉེན་པོ་སྐྱེས་པ་ན་སྤང་བྱ་འགགས་པར་བསྟན་པས།",
    "དེས་ན་མཁས་གྲུབ་ཐམས་ཅད་མཁྱེན་པའི་གསུང་ལས།",
    "ལི་ཙ་བྱི་གཞོན་ནུ་མཐོང་ན་དགའ་བ་འདི་ང་མྱ་ངན་ལས་འདས་ནས་ལོ་བཞི་བརྒྱ་ལོན་པ་ན་ཀླུ་ཞེས་བྱ་བའི་དགེ་སློང་དུ་གྱུར་ནས་ངའི་བསྟན་པ་རྒྱས་པར་བྱས་ཏེ།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར།",
    "སྟོན་པ་ཞལ་བཞུགས་དུས་ཀྱི་བྲམ་ཟེ་ཀོའུ་དི་ནྱ་ལ་རིང་བསྲེལ་གྱི་གཏམ་བྱེད་པའི་ལི་ཙ་བྱི་མཐོང་ན་དགའ་བ་དེ།་",
    "སླར་ཡང་འཇིག་རྟེན་འདིར་ཕེབས་ཏེ།",
    "རྒྱ་གར་ལྷོ་ཕྱོགས་སུ་ཤཱཀྱའི་རིགས་རྒྱུད་དུ་སྐུ་འཁྲུངས་ཤིང་ལོ་དྲུག་བརྒྱ་བཞུགས་པ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར།",
    "ཞེས་གསུངས་པའི་ཕྱིར།་",
    "ནར་སོན་པ་ན་ཡུམ་གྱིས་བསྐུལ་ཏེ་དཔལ་ནཱ་ལེནྡྲར་ཕེབས་ནས་རབ་ཏུ་བྱུང་།",
    "འཛམ་གླིང་འདི་ན་ཀུན་མཁྱེན་གཉིས་པར་གྲགས།",
    "སྟོན་པ་དགོངས་པ་མྱ་ངན་ལས་འདའ་བའི་ཚུལ་བསྟན་པའི་རྗེས་སུ་སློབ་དཔོན་འདི་ཉིད་ལས་མང་དུ་ཐོས་པ་མེད་པར་གྲགས་སོ། ༴།",
