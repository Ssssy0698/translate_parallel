    "བ་ལང་གནག་ཕྱུགས་དྲུག་ཅུ་བསད་པ་ལ་ཨེ་འདུག་ལྟོས་དང་།",
    "འབུལ་ལ་ཁྲོ་བཟང་པོ་གཅིག་ཟོས་འདུག།",
    "དཀར་པོ་ཅུང་མང་བར་འདུག་སྟེ་རྒྱ་མར་བཏེག་པས་ལྗིད་ནག་པོ་ཆེ་བར་འདུག་གོ་ཟེར་བ་ན།",
    "དེ་ནས་ཡང་མི་སྔོན་པོ་ཕྱིང་པ་གྱོན་པ་གཅིག་ལ་དྲི་བ་བྱེད་ཀྱིན་འདུག་པས།",
    "ཤ་དང་མར་ཐུད་རྩམ་པ་ན་བཟའ་སོགས་ང་རང་འདིར་མ་འོང་བར་དུ་ཕུལ་ཡོད་ལགས།",
    "མ་དག་ཀྱང་འགྱོད་པ་མེད་ཟེར་འདུག་པས།",
    "ད་ཁོང་བྱོན་བྱུང་ཟེར་ཞིང་འདུག་པས།",
    "ང་རང་སྐྱེས་པ་ཡིན་བསམ་པའི་ལྟ་བ་མཐོན་པོ་བྱས།",
    "འབྲེལ་མཁན་ཉུང་བར་གདའོ།",
    "ལས་ཀ་སོ་ནམ་མ་བྱས་པར་སུས་ཀྱང་བྱེད་མཁན་མི་འདུག་བསམས་ནས་སུ་ལའང་བྱིན་མ་མྱོང་།",
    "རང་ཟས་ཟ་ཞིང་རང་སར་བསྡད་པ་ཡིན།",
    "ཡང་མི་གོས་དཀར་པོ་ལ་གོང་རྒྱན་སྨུག་པོ་བྱས་པའི་མི་གཅིག་ལ་དྲི་བ་བྱེད་ཅིང་འདུག་གོ།",
    "ང་འགྲོ་བའི་ས་དེ་ལ་རི་དྭགས་མང་པོ་འདུག་པས།",
    "ལ་ལ་ངན་ཕྲོགས་བྱས་ནས་ལོ་བཅུ་གཉིས་ཀྱི་བར་དུ་འཕྲོག་བཅོམ་དེ་ཙམ་བྱས་འདུག།",
    "རི་དྭགས་དུད་འགྲོ་བསད་པ་རྣམས་ཀྱིས་ལུས་བླངས་ཏེ་སྲོག་ལན་མཇལ་དགོས་པ་འདུག།",
    "ནམ་འཆི་ཆ་མེད་ངེས་འདུག།",
    "ཐམས་ཅད་འཆི་བ་མིན་པ་གཞན་འགྲོ་ས་མི་འདུག།",
    "ལ་ལས་ནི་དད་ལོག་བྱེད་མི་ཡང་འདུག།",
    "ཕྱི་རོལ་གྱི་གཟུགས་བཟང་ངན་ཇི་ལྟར་སྣང་ཡང་རང་སེམས་འཕྲུལ་བའི་རང་གཟུགས་ཡིན།",
    "དཔོན་གཡོག་རྣམས་ཀྱང་རང་སེམས་ཀྱི་བརྡ་ཙམ་ཡིན།",
    "སེམས་ལ་ཁ་དོག་དང་གཟུགས་ངོ་བོ་གཟུང་རྒྱུ་ཅི་ཡང་མ་གྲུབ་པས་བཙོ་སྲེག་ཤ་གཏུབས་བྱེད་རྒྱུ་ཡང་མི་འདུག།",
    "ཕྱག་དང་སྐོར་བ་ཉལ་ཕྱག་ལང་ཆགས་མེད་བྱས་འདུག།",
    "ཟས་དང་གོས་སློང་མི་བྱུང་ན་མི་སྟེར་བ་བྱས་མི་འདུག།",
    "བསོད་སྙོམས་པ་སུ་བྱུང་ལ་ལེགས་པར་བྱིན་འདུག།",
    "ཕ་མའི་ཚོར་བ་མང་པོ་བྱིན་འདུག།",
    "རྩི་ནས་དང་ཚི་ལུ་དུམ་བུ་མང་པོ་བྱིན་འདུག།",
    "ལུག་དང་བདུན་བསད་འདུག།",
    "བཞི་ཆ་བསད་མཁན་དེར་ཐོབ་པར་འདུག་གསུངས་པ་ན།",
    "སྐྱེས་པ་མང་བར་འདུག་གོ།",
    "ཡང་བཙུན་མ་པགས་རྩག་གྱོན་པ་ལུས་བྲང་མིག་ཐད་དུ་བགྲད་ནས་སྡོད་མི་གཅིག་ལ་དྲི་བ་བྱེད་ཀྱིན་འདུག་པས།",
    "བ་ཉམ་ཆུང་གཅིག་རྐང་པ་ལ་ཁྱིས་ཟོས་འདུག།",
    "སེམས་དྲང་པོ་བྱས་པ་ཨེ་འདུག་ཡི་གེ་འདི་ལ་ལྟོས་དང་ཟེར་གྱིན་འདུག་པས།",
    "ལྷ་དང་མིའི་ལུས་གང་དགའ་ལ་ལོངས་སྤྱོད་ཆེན་པོ་གཅིག་ཏུ་སྐྱེ་བ་འདུག་པས།",
    "རྟགས་བཟང་པོ་མང་པོ་འདུག།",
    "ངོ་ཤེས་ཚོ་ལ་དད་པ་བྱེད་པར་འགྲོ་མི་དགོས་ཅི་བྱེད་ནས་འགྲོ་ཟེར་ཞིང་འདུག།",
    "ད་རྡེའུ་རྣམས་བཏེག་དགོས་པ་མི་འདུག།",
    "བཀྲག་མདངས་ཀྱང་ལེགས་པར་འདུག།",
    "གསེར་གཡུ་བྱུ་རུ་སོགས་མང་པོ་འདུག་སྟེ།",
    "འབྲེལ་བ་ཕུལ་བའི་མི་ནི་ཉུང་བར་གདའ།",
    "ནུས་པའི་མི་རྣམས་ཉུང་བར་གདའ།",
    "ཐུགས་རྗེ་ཆེན་པོ་ལ་གསོལ་བ་ཐོབ་ལ་མ་ཎི་དུང་ལ་སྦུངས་ནས་བགྲོངས་ཤིག་གསུང་འདུག།",
    "ད་ལྟ་བྱུང་བ་རྣམས་ནི་ཕ་རི་ཚུར་རི་དེ་ན་སྡོད་གསུངས་འདུག།",
    "སྔོན་ལ་ང་མ་གཏོགས་སུ་ཡང་མི་འདུག།",
    "རྫུན་སྨྲས་ན་ནི་མི་ཡོང་བར་འདུག།",
    "ཅི་འདྲ་འདུག་ཡིད་ལ་བཞག་ནས་མགྱོགས་པར་ཤོག་གསུངས་པས།",
    "ང་རང་ཕྱིན་དུས་མགོ་འཁོར་ཞིང་ལག་པ་སྐས་ལ་འཆང་ནས་ཕྱིན་པས་སྐས་མགོར་སླེབས་ནས་བལྟས་པས།",
    "བར་མཚམས་སུ་ལྕགས་རི་ཐེན་ནས་འདུག།",
    "ཡང་སོས་པར་གྱུར་ཅིག་ཟེར་འདུག་པས་ཡང་སྔར་བཞིན་མི་ཤི་བར་འདུག།",
    "ཡང་གཏུབ་ཀྱིན་འདུག།",
    "མནན་པ་བྱེད་ཀྱིན་འདུག།",
    "ཡང་དེའི་འོག་ཏུ་མེ་ཕུང་ཆེན་པོ་འབར་བའི་ནང་དུ་མི་མང་པོ་བསྲེགས་འདུག་པས།",
    "ཉེ་བའི་མིང་ནས་བོས་ནས་སྨྲེ་སྔགས་འདོན་ཅིང་ངུ་འབོད་བྱེད་ཀྱིན་འདུག།",
    "ཕྱི་ནང་གཉིས་ནས་མེ་འབར་ཏེ་གཞོབ་ཐུལ་ལུ་ལུ་བསྲེགས་འདུག།",
    "རྒྱལ་ཁམས་ཀྱི་གནས་སྐོར་བ་ལ་འཕྲོག་བཅོམ་བྱེད་མི་ཡིན་ཟེར་ཞིང་འདུག།",
    "ཆུ་ཁོལ་བའི་སྐད་ནི་ས་སྟེང་ཁྱབ་པའི་སིལ་སྒྲ་ཆེན་པོ་འདུག།",
    "གཤིན་རྗེ་རྣམས་ཀྱི་འབོད་སྒྲ་ནི་ས་སྟེང་ཁ་ནོན་ལོག་འདྲ་འདུག།"
