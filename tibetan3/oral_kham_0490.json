    "དེ་འབུལ་དགོས་ཚུལ་ཞུས་པས་ཁྱེད་རང་གཅིག་པུ་ཕུལ་གསུངས་པས་ང་རང་གཅིག་པུས་ཕུལ།",
    "འབང་རྒྱས་ཤར་གླིང་ག་ལའང་འཇའ་འོད་ཕྱོགས་གང་ནས་ཟུག་འདུག།",
    "རྗེས་སུ་གཅོད་ཀྱི་བསྙེན་མཚམས་ཤིག་ཀྱང་བསྡད་ནས་གྲོལ་དུས་གཅོད་ཀྱི་སྦྱིན་སྲེག་བྱེད་སྐབས་དཀྱིལ་འཁོར་སྟེང་ནས་བྲག་རྡོ་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཟག་པས་དཀྱིལ་འཁོར་ཀུན་བཀབ་ཀྱང་ང་རང་ལ་སྐྱོན་མ་བྱུང་།",
    "འོ་དེ་ལྟར་ལོས་ཡིན་གསུངས།",
    "ངེད་རྣམས་ཤིན་ཏུ་སྐྲག་ཀྱང་ང་ཡར་བཅར་བས་བཞུགས་གདན་ཞིག་དང་ཅོག་ཙེ་ཆུང་ངུ་ཞིག་བཀྱོན་འདུག།",
    "ཕྱག་ནང་ལྷུང་བཟེད་བསྣམས་ནས་བཞུགས་འདུག།",
    "མར་བལྟས་པས་གདིང་བ་གྲྭ་ཆས་རྣམས་གྲོགས་པོ་ན་ཁར་སྤུང་ངེ་ལུས་འདུག།",
    "སྐྱབས་མགོན་དྷར་སེང་བུམ་པ་རིར་བཞུགས་འདུག།",
    "འདུག་ཟེར་མི་མང་འཚོགས་ལ་ཡིན་ཚུལ་བཤད།",
    "ཁམ་བུ་གསར་པ་མང་འདུག་ཨེ་ཟོས་གསུངས།",
    "འབྲུ་ཁལ་ལྔའི་སྟེང་རང་གཉིས་ཁུར་པོ་ཁུར།",
    "མ་སྐྱོན་ཀུན་གྱིས་ངོ་མཚར་བྱེད་ཀྱིན་འདུག།",
    "ཁྱེད་རང་གཅིག་པུས་ཕུལ་གསུངས་གུས་ནས་ཕུལ།",
    "རྗེས་སུ་མཇལ་ཚེ་ང་རང་མཇལ་ཁ་བཀ་ག།",
    "ང་རང་གཅིག་པུས་བཞེངས་རྗེས་འཇའ་མང་པོ།",
    "གང་ཤར་ཆུང་ཆུང་གསོལ་ཅོག་ལ་འཁྱུད་འདུག།",
    "ཁྱེད་རང་རི་ཁྲོད་ཡིན་སྟབས་མ་བསྒྲུབས་ཀྱང་།",
    "མ་སྤྲུལ་མདུན་ཞུས་ལོས་ཡིན་གསུངས་ཏེ་དགྱེས།",
    "གྲྭ་ཆས་སྤྲས་པའི་ཨ་ཅེ་གཉིས་འདུག་ཟེར།",
    "ཁྱི་ཞིག་ཡོད་པ་དེ་ང་དང་མཉམ་དུ་འཁྲབ་འདུག།",
    "ངས་ལམ་དུ་གང་ལབ་པ་ཤེས་འདུག་ཟེར་ནས་དད་པ་ལྟ་བུ་ཡག་པོ་བྱེད་འདུག།",
    "གར་སྟབས་སོགས་མི་དང་མི་མཐུན་པ་ཞིག་འདུག་འདི་སྨྱོ་བ་ཡིན་ནམ་གང་ཡིན་ཧ་མི་གོ་ཁྱེད་ནས་ཐུགས་བརྟན་པོ་གནང་མ་གཏོགས་སྨྱོ་ཡང་སྲིད་ཟེར།",
    "ངའི་ལག་ནས་བཟུང་བྱུང་བ་དང་མཉམ་དུ་རྐང་ཞབས་ས་ལ་མ་ཐུག་ཙམ་གྱིས་ཡུལ་ངོ་མི་ཤེས་པ་འགའ་བགྲོད་ཅིང་ལ་ཁ་ཞིག་ལ་ཕྱིན་འདུག།",
    "ངག་ནས་སྐྱབས་སུ་མཆིའོ་སྨྲས་པས་དེ་རྣམས་ཀྱང་གསུང་འདུག།",
    "གསོན་གྲང་ང་ཁམས་ལ་འདུག་པའི་དུས།",
    "ངེད་རྣམས་ཀྱང་རང་སྣང་ཞི་ཁྲོ་ཡིན།",
    "སྡུག་བསྔལ་ཡང་རང་ཤར་རང་གྲོལ་ཡིན།",
    "བཅས་ཀྱིས་ཉ་ཆུང་མང་པོ་ཤི་ལ་ཁད་འདུག་པ་རྣམས་ཚེ་ཐར་བཏང་སྟེ་ཉིན་གང་ཉ་ཆུང་བསལ།",
    "གུ་རུ་གཙོ་འཁོར་གསུམ་གསར་བཞེངས་དང་འབྲེལ་སྔོན་ཤུག་གསེབ་འདུ་ཁང་པ་ཚང་བྱས་འདུག།",
    "རྗེས་འཇུག་གནང་འདུག་ང་ལ་བསམ་ཡས་དང་།",
    "བབས་པ་མ་ཤེས་འདུག་པས་ང་དང་ནི།",
    "འཇིགས་ཀྱང་ཐོག་མེད་མཚམས་ཁང་ནང་དུ་འདུག།",
    "ལྷ་ཕེབས་ལུང་བསྟན་ཁྱེད་རང་འདིར་བཞུགས་དང་།",
    "བཏང་འདུག་རྟ་དེ་མ་ཎི་འཛུགས་རྟེན་བྱས།",
    "ཡིན་འདྲ་རི་ཕུག་ཡོད་ཚད་ལ་འདུག་ནས།",
    "རང་བཞིན་མིན་འདུག་གང་ལབ་ཤེས་འདུག་ཟེར།",
    "ཟེར་བས་ཁྱེད་རང་ཕེབས་རྒྱུ་ཨེ་ཡོང་ན།",
    "ཆུ་རས་བསྐྱོན་འདུག་གཙང་པའི་རྗེ་བཙུན་མ།",
    "ཤུག་གསེབ་འདུ་ཁང་བ་ཚང་བྱས་འདུག་ཅིང་།",
    "ཟངས་ཡག་བྲག་སྐར་ལྔ་བཅས་གནང་འདུག།",
    "ཁ་ཤས་བུ་དང་ལྡན་པ་མང་པོ་འདུག།",
    "ད་ནི་ཡུན་རིང་སྡོད་པ་མི་འདུག་བདེ་ཅན་ཞིང་ནས་བསུ་མ་ཡང་ཡང་བྱུང་།",
    "པའི་རྣལ་འབྱོར་ཞིག་འདུག་པས་དེ་མདུན་བསྡད་པ་དགའ་གསུངས་ནས་ཟླ་བ་བཞི་པའི་ཚེས་བརྒྱད་ཉིན་ཁྱེད་རྣམས་ཀྱང་ཁ་ནུབ་ཏུ་ལྟོས།",
    "བཞུགས་གདན་བཏིངས་སྐུ་བསང་བདུགས་ཟེར་འདུག་ཅེས་བཤད།",
    "ང་མཐོང་བས་ཁོ་ཧ་ལས་ཏེ་ཁྱེད་རྣམས་ཀྱིས་སྦས་ཏེ་མི་སྟོན་པ་ཁག་མི་འདུག་དེ་འདྲའི་ཡག་པོ་ཟེར།",
    "འདི་ལ་ངོས་བཟུང་བྱས་ཙ་ན།",
    "འགྲོ་འོང་འདི་གང་ལ་བལྟས་ཙ་ན།",
    "མི་རྟག་རྩ་བ་ཐུག་ཙ་ན།",
    "བརྩམས་ན་མཐའ་རུ་ཐོན་འདུག་ཀྱང་།",
    "ཁ་ནང་དུ་ལོག་ནས་བལྟས་ཙ་ན།",
    "དེ་ནས་རིམ་བཞིན་སྔོན་འགྲོ་ཕྱི་ནང་ཁྲིད་སྐབས་ཁོ་རང་ཡང་ཤེས་རབ་དད་བརྩོན་དང་ལྡན་པ་ཞིག་འདུག།",
    "དེ་མ་ཐག་ང་རང་སྒྲོལ་དཀར་གྱི་བསྙེན་པ་ལོ་མཚམས་ཤིག་བསྡད་དེ་མཚམས་གྲོལ།",
    "ཐུགས་ཀར་དྲོད་བསྡད་འདུག་གསུངས་ནས་མར་བཞག་པས་ཞུ་བ་དང་ང་གསོས་གསུངས།",
    "དབྱིངས་རིག་ཡེ་ནས་འདུ་འབྲལ་མི་འདུག།",
    "ཁྱེད་རང་ཞལ་མངོན་སུམ་མཇལ་བར་ཤོག།",
    "གང་མཐོང་འདུག་སྨྲས་པས་དབུ་དང་ཕྱག་སོགས་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་མཇལ་ཟེར།",
    "ཡང་ཅུང་ཟད་བགྲེས་ཚུལ་གྱི་རྣམ་པར་གྱུར་ནས་ཞལ་ཕྱག་རྣམས་གཅིག་ལ་གཅིག་ཐིམ་མཐར་ང་རང་དུ་གྱུར་འདུག་ཟེར།",
    "སྐུ་ཞབས་བློ་གྲོས་ལགས་ནས་རིག་འཛིན་སྲོག་སྒྲུབ་འཁྲུལ་འཁོར་ང་རང་སྐྱོར་གསོས་བྱས་ནས་སློབ་བགྲེས་འགའ་ལ་འཁྲུལ་འཁོར་ཁྲིད།",
    "ཟ་ཉལ་འགྲོ་འདུག་ཀུན་ཏུ།",
    "རྒྱལ་གདོན་འདུག་གམ་ཞུས་པས་འདི་འདྲ་ཞིག་འདུག་གསུངས་ནས་ཤུག་གསེབ་རྒྱལ་གསོལ་ཤ་མར་རྩམ།",
    "གསུངས་པ་དེ་བདེན་པར་འདུག།",
    "ཀུན་མཁྱེན་གྱི་གདུང་འབུམ་འཇིག་འདུག་ཟེར།",
    "སྔར་གྱི་མཆོད་རྟེན་དེ་ཉིད་ལ་ལས་ཤར་དུ་ཁེལ་འདུག།",
    "འབུ་བསད་སྐྱེ་བ་ཡིན་འགྲོ་གསུངས་པ་ལ།",
    "ང་སླེབས་འདུག་གསུངས་དེ་སྐབས་ངས་བྲིས་པ།",
    "མཇལ་རྒྱུ་འདུག་ཟེར་དེ་སྐབས་དགོངས་པ་གཤེགས།",
    "ཟེར་འདུག་བདུན་གཅིག་ཞི་ཁྲོའི་སྦྱངས་ཆོག་བྱས།",
    "ཁྱེད་རང་འདས་ན་ང་ལ་དམག་རྒྱག་འདྲ།",
    "མཇལ་མ་ཐག་ཏུ་མཐོང་མྱོང་ལྟ་བུར་འདུག།",
