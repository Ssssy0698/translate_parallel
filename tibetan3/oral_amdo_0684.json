    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་ན་གང་ཟག་འདི་ལྟ་བུ་ལ་མི་གཟིགས་ཞེས་པའོ།",
    "འདོད་པའི་ཡོན་ཏན་ལྔ་དག་གིས་རོལ་དགྱེས་པ་ཡོངས་སུ་སྤྱོད་པ་ཡོད་ཀྱང་ཞེས་ཏེ།",
    "སྐྱེ་བ་གཅིག་གིས་ཐོགས་པའི་རྣལ་འབྱོར་པ་ལྷ་མོའི་གཟུགས་ལ་སོགས་པ་ལ་ཟླ་བ་དྲུག་ལ་སོགས་པའི་རིམ་པ་དང་རབ་ཏུ་སྤྱོད་པ་ཡོད་པའོ།",
    "དེ་ལ་མི་གཟིགས་པའི་རྒྱུ་གསུངས་པ།",
    "གང་གི་ཚེ་རྣམ་པར་རྟོག་པ་ལ་སྤྱོད་པའོ།",
    "ཚིག་གི་ལམ་ངེས་པར་བརྗོད་པས་ཞེས་པ་ནི་ཚིག་གི་བརྗོད་པ་མེད་པའི་ངོ་བོ་ལ་རྣམ་པར་འགྱུར་བའི་དབྱེ་བས་བཅོམ་ལྡན་འདས་མ་གནས་སུ་ཞུགས་པས་སྔགས་བསྡུས་པ་སྟེ།",
    "ཞེས་པ་ནི་སྒྲུབ་པ་པོ་ལ་མི་གཟིགས་པ་སྔགས་དེས་དམ་ཚིག་ལས་བསྙེངས་པའི་འཇིགས་པ་ཡོད་པས་ན་དེ་ལྟར་འགྱུར་བའོ།",
    "རང་གི་གཟུགས་སུ་རབ་ཏུ་བརྟག།",
    "རྟག་པ་ལ་སོགས་པའི་རྣམ་པར་དག་པའི་ཕྱིར་འོག་དང་གོང་གི་ཚུལ་རྩེ་ལྔ་དང་ལྡན་པ།",
    "ད་ནི་ཟླ་བར་ཞུ་བའི་ཆོ་ག་རྫོགས་པའི་དེ་མ་ཐག་ཏུ་རང་གི་ས་བོན་ལས་རང་གི་འཁོར་ལོ་བསྐྱེད་པ་ཆོ་ག་གཉིས་པ་གསུངས་པ།",
    "རང་གི་ཞེས་པ་ལ་སོགས་པའོ།",
    "རང་གི་འཁོར་ཞེས་པ་ནི་རང་གི་ལྷའི་འཁོར་ལོའོ།",
    "རང་གི་སྔགས་ལས་སྐྱེས་པའི་སྐྱེས་བུ་ནི་ལྷ་རྣམས་ཏེ།",
    "ཞེས་ཏེ་རིག་མ་དང་ལྡན་པར་དཀར་པོ་ལ་སོགས་པའི་ཁ་དོག་གསུམ་དུ་བསྒོམ་མོ་ཞེས་སོ།",
    "རྡོ་རྗེ་མཆོག་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "ཕྲ་མོའི་དཀྱིལ་འཁོར་ཞེས་པ་ནི་ཕྱག་རྒྱ་བཞི་སྟེ།",
    "ས་བོན་དང་མཚན་མ་ཕྲ་མོ་ལས་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "དེ་བསམས་ལ་ཡི་གེ་མཆོག་ཏུ་གྱུར་པའི་ཚིག་ནི་རང་རང་གི་ས་བོན་ནོ།",
    "དེའི་དབུས་སུ་ཞེས་པ་ནི་དེ་རྣམས་ཀྱི་ཐུགས་ཀར་ཟླ་བའི་དབུས་སུ་རང་གི་ས་བོན་བསམ་པར་བྱ་ཞེས་སོ།",
    "དེའི་དབུས་སུ་ཡང་ཧཱུཾ་གིས་མཚན་པའོ།",
    "ཐུགས་ཀྱི་རྡོ་རྗེ་བསྟན་ནས་སྐུ་དང་གསུང་གི་རྡོ་རྗེ་ཡང་གསུངས་པ།",
    "གསུང་གི་རྡོ་རྗེ་ནི་པདྨའི་རིགས་ཀྱི་ཀྱོ་བའོ།",
    "རང་གི་ལྷའི་རྣམ་པ་ལྟ་བུ་ནི་སོགས་ཀྱི་སྒྲས་བསྡུས་པའོ།",
    "དེའི་གསང་བ་ནི་སྐུ་དང་གསུང་དང་ཐུགས་ཏེ་སྐུ་གསུམ་མོ།",
    "མཆོག་སྩོལ་བས་ནི་རྣམ་པར་གཟིགས།",
    "རང་གི་བྱ་བ་ཆད་པས་བཤིག་པར་དོགས་པའི་ཕྱིར།",
    "དེ་རྣམས་ཀྱི་གནས་རྣམས་སུ་རྡོ་རྗེ་གསུམ་ནི་སྐུ་གསུམ་ཐུགས་གསུམ་མོ།",
    "རིག་མ་ནི་རང་གི་རིག་མའོ།",
    "འཛེམ་པ་མེད་པའི་རྣལ་འབྱོར་པས་དེ་དང་ལྷན་ཅིག་ཏུ་སྒྲུབ་པ་པོ་ཞེས་ཐུན་མོང་དུ་གསུངས་སོ།",
    "ཞེས་པ་ནི་ཐུན་མོང་གི་ལུང་ངོ།",
    "བུད་མེད་ཇི་སྙེད་ཡོད་པ་ཀུན།",
    "ཞེས་ཏེ་གང་ན་དེ་ཡོད་པའི་འཇིག་རྟེན་གྱི་ཁམས་ན་དེ་གནས་པ་རྣམས་ཕྱག་རྒྱ་ཆེན་པོ་ཞེས་པ་ནི་ལྷ་མོའི་སྐུར་བསྐྱེད་པའོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་གཞུང་གི་ལེའུ་སྟེ་བཅུ་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་ཞེས་པ་ནི་ཡི་གེ་གསུམ་མོ།",
    "དེ་ལས་སྐྱེས་པའི་རང་གི་ལྷ་ནི་སྐྱེས་བུ་མཆོག་ཅེས་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "ཡེ་ཤེས་རྡོ་རྗེ་དག་གིས་བྱ།",
    "ད་ནི་སྣ་ཚོགས་རྡོ་རྗེའི་བུམ་པར་གཞལ་ཡས་ཁང་གི་ས་བོན་གསུངས་པ།",
    "བྷྲཱུཾ་བསམ་མོ་ཞེས་པ་ནི་དཀར་པོའོ།",
    "དེ་བཞིན་དུ་གསུང་གི་རྡོ་རྗེ་ཡང་བེམས་པོ་མ་ཡིན་པས་ན་གསལ་བའི་དཀྱིལ་འཁོར་རོ།",
    "དེ་རྣམས་ཀྱི་ཐུགས་ཀར་གོང་མ་ལྟར་ཡི་གེ་བཀོད་ནས་ལེའུ་བཅུ་གསུམ་པར་གསུངས་པ་ལྟར་བཟླས་བརྗོད་བྱའོ་ཞེས་ཏེ་ངག་གི་བཟླས་པའོ།",
    "དེ་དབུས་ཀྱི་གདན་ལ་བབས་པར་བསྒོམས་ལ་བདེ་བར་གཤེགས་པ་ལ་སོགས་པ་གཟིགས་པ་ལ་སོགས་པ་ནི་གོང་མ་ལྟར་ཤེས་པར་བྱའོ།",
    "དམ་ཚིག་གསུམ་ཉིད་གསང་བ་སྟེ་ཡི་གེ་གསུམ་མོ།",
    "ཨོཾ་ནི་ཞེས་པ་ནི་སྤྱི་བོར་ཨོཾ་ལས་བསྐྱེད་པའི་འཁོར་ལོའི་ལྟེ་བར་ཟླ་བ་ལ་གནས་པའི་ཨོཾ་མོ།",
    "དེའི་རང་བཞིན་གསུང་གི་རྡོ་རྗེ་སྟེ་དེའི་ས་བོན་ཞེས་སོ།",
    "དམ་ཚིག་དག་གིས་ཞེས་པ་ནི་མིག་ལ་སོགས་པ་བྱིན་གྱིས་བརླབས་པའོ།",
    "རང་གི་སྔགས་ཀྱིས་ཞེས་པ་ནི་དང་པོའི་ཆོ་ག་བཞི་རྫོགས་པའི་འོག་ཏུ་ཡི་གེ་ཨོཾ་དུ་གྱུར་པའོ།",
    "ཁ་དོག་སྣ་ཚོགས་པའི་འོད་ཟེར་འཕྲོས་པས་བདེ་བར་གཤེགས་པ་ཐམས་ཅད་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུར་བྱས་པས་བཀུག་ནས་རང་གི་བ་སྤུའི་བུ་གར་བཙུད།",
    "རང་གི་སྦྱོར་བ་ལ་ལྷག་པར་གནས་པར་བྱས་པས་ཇི་སྐད་དུ་གསུངས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "དང་པོའི་མགོན་པོ་ནི་ཡེ་ཤེས་ལྔ་ལྡན་ཏེ་དེས་རང་གི་ལྷར་གྱུར་པའོ།",
    "རང་གི་སྔགས་ཀྱིས་སྐྱེས་བུ་བསྐྱེད།",
    "ཅེས་པ་ནི་ཡི་གེ་ཨཱས་དེ་བསྐྱེད་པའི་ཆོ་གས་རྫོགས་པར་བྱས་ནས་ཡི་གེ་ཨཱ་ངག་གི་ལམ་སྟེ།",
    "ཞེས་པ་ནི་དམ་ཚིག་དང་ལྡན་པའི་རྣལ་འབྱོར་པས་ཡེ་ཤེས་ཀྱི་རང་བཞིན་སྣང་བ་མཐའ་ཡས་བསྐྱེད་ནས་ཚིག་གི་དམ་ཚིག་ཅེས་པ་ནི་མི་འདའ་བས་ན་ཨཱའོ།",
    "ཡི་གེ་ཧཱུཾ་གིས་ཐུགས་རྡོ་རྗེ་དང་མཉམ་པའི་སྒྲུབ་པ་གསུངས་པ།",
    "ཞེས་པ་ནི་ཡི་གེ་ཧཱུཾ་གིས་དེ་བསྐྱེད་པའི་ཆོ་ག་རྫོགས་པར་བྱས་ནས་སེམས་ལ་ཞེས་ཏེ་ཐུགས་ཀར་ཟླ་བ་ལ་མཚན་མའི་དབུས་སུ་ཧཱུཾ་གནས་པར་བསམ་མོ།",
    "དམ་ཚིག་གི་དེ་ཉིད་དེ་ནི་རྡོ་རྗེ་འཆང་ཆེན་པོའོ།",
    "རྡུལ་ཕྲན་རྡོ་རྗེ་ལུས་ངག་གིས།",
    "ཞེས་པ་ནི་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་གྱི་ཨོཾ་མོ།",
    "དམ་ཚིག་ཨོཾ་ཞེས་པ་ནི་མི་འདའ་བས་ཏེ་བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་གྱི་ཨོཾ་མོ།",
    "ལུས་དང་ངག་དང་སེམས་ནི་སྒོ་གསུམ་མོ།",
    "སྲོག་སོང་བ་བསྐྱལ་བའི་ས་ནི་དུར་ཁྲོད་དོ།",
    "སྨད་འཚོང་མ་ལ་སོགས་ཀུན་གྱི་ཐུན་མོང་དུ་གྱུར་པ་ནི་ཀླུང་དང་འབབ་ཆུའོ།",
    "གདོལ་བ་མོ་ལ་སོགས་པ་སྨད་པ་ནི་དུར་ཁྲོད་དོ།",
    "སོགས་ཀྱི་སྒྲས་བསྡུས་པ་ས་ལྷ་མོ་ལ་སོགས་པའོ།",
    "རང་གི་ལྷ་བསྡུའོ།",
    "རང་སྔགས་ཞེས་པ་ནི་རང་གི་སྔགས་ཀྱི་ལྷར་གྱུར་པ་ལས་ཞེས་སོ།",
    "ད་ནི་ཕྲ་མོར་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་གསུམ་གསུངས་པ།",
    "བདག་གི་ལུས་ལ་ཞེས་པ་ནི་བདག་ཉིད་དེ་ལྟར་སྣང་བ་སྟེ།",
    "དམ་ཚིག་སེམས་དཔའ་ཕྲ་མོའོ།",
    "ཐིག་ལེའི་གཟུགས་ཅན་ལ་རང་གི་རྣམ་པར་ཤེས་པ་དེའི་ཡན་ལག་གཉིས་པས་གཟུང་བའོ།",
    "ནམ་ཞིག་དེ་ལ་རེག་འགྱུར་ན།",
    "རང་གི་མོས་པས་གནས་པར་བརྟན་པའི་ཕྱིར་གྲངས་ཀྱི་ངེས་པ་མ་གསུངས་པར་ཡང་ནས་ཡང་དུ་གསུངས་པའོ།",
    "རྡོ་རྗེ་གསུམ་ཁོ་ན་གཙོ་བོས་སྦྱོར་བ་སྟོན་པའི་ཕྱིར་རྡོ་རྗེ་གསུམ་མོ།",
    "དེ་ཁོ་ན་ཉིད་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "དེ་གྲུབ་པར་བྱེད་པའི་གཞུང་གི་ལེའུ་སྟེ་བཅུ་གཅིག་པའོ།",
    "རྡོ་རྗེ་གསུམ་གྱི་ངོ་བོ་ལས་མི་འདའ་ཞིང་སྐྱོན་མེད་པས་ན་དམ་ཚིག་ཡང་དག་པ་རྡོ་རྗེ་གསུམ་མོ།",
    "དེས་རྡོ་རྗེ་གསུང་གི་ལེའུ་བཅུ་གཉིས་པ་བཀའ་སྩལ་ཞེས་བྱའོ།",
    "རོལ་མོ་འདི་དག་རབ་ཏུ་བསྒོམ།",
    "ཞེས་ཏེ་ཀུན་རྫོབ་ཏུ་གར་མཁན་ལྟར་དངོས་གྲུབ་ཀྱི་ཐབས་ཀྱི་ཆོ་ག་འདི་དག་རབ་ཏུ་བསྒོམ་མོ་ཞེས་དོན་དམ་པའི་བདེན་པ་ལ་གནས་ནས་བྱ་བར་བསྟན་པའོ།",
    "ཅེས་པ་ནི་རེ་རེར་ཡང་དངོས་གྲུབ་ཐམས་ཅད་འགྲུབ་ཏུ་རུང་བས་དེ་སྐད་དོ།",
    "ཞེས་པ་ནི་རང་གི་ལུས་ལ་སོགས་པ་ཡི་གེ་མཾ་ལས་གོང་མ་ལྟར་དབྱེར་མི་ཕྱེད་པའི་རྡོ་རྗེ་འཇམ་དཔལ་ཆོ་ག་བརྒྱད་ཀྱིས་རྣམ་པར་བསྒོམས་ཏེ།",
    "རྡོ་རྗེ་འབར་བ་ནི་འོད་ཟེར་འབར་བའི་འཇམ་དཔལ་དེའི་འོད་དག་གིས་ཞེས་སོ།",
    "རང་གི་སྔགས་ཀྱིས་རབ་བསྒོམས་ན།",
    "ཡོན་ཏན་ཅན་ནི་བདག་གིར་འགྱུར།",
    "ད་ནི་རང་རང་གི་ཕྱག་མཚན་གྱི་སྒོ་ནས་ཁྲོ་བོའི་རིག་འཛིན་སྒྲུབ་པ་གསུངས་པ།",
    "འཁོར་ལོ་དང་ལྡན་པ་ནི་རང་གི་ངོ་བོ་ཁོ་ནས་སྒྲུབ་པ་ཡང་མི་འགལ་ལོ།",
    "ཁྱད་པར་གྱིས་ཞེས་པ་ནི་རང་རང་གི་ལྷའི་རིམ་པ་སྒྲུབ་པ་པོས་ནི་རྟག་ཏུ་བསྒྲུབ་ཅེས་སོ།",
    "དགུག་བྱ་ཡང་མིང་གི་ཡི་གེ་དང་པོས་བསྐྱེད་ལ།",
    "རྒྱལ་བ་དག་གིས་ཞེས་པ་ནི་དེས་མཚན་པའི་ལྷའི་སྐུའོ།",
    "ཞེས་ལྷན་ཅིག་གི་ཏིང་ངེ་འཛིན་གྱི་བྱ་བ་བསྟན་པའོ།",
    "དེ་རབ་ཏུ་བསྒྲུབ་པ་ནི་འོད་ཟེར་གྱིས་ལྷ་མོ་དགུག་པ་ལ་སོགས་པ་རྒྱས་པར་སྦྱར་རོ།",
    "གསང་བ་ཆེན་པོ་ནི་བདུད་རྩི་ལྔ་དང་ལྷ་མོ་བཅུའོ།",
    "དམ་ཚིག་དག་གིས་ཞེས་པ་ནི་སྔོན་དུ་བསྟེན་པའི་ཕན་ཡོན་དང་།",
    "ཁྱི་ཤ་དག་གིས་ཞེས་པ་ལ་སོགས་པའོ།",
    "གོང་མ་ལྟར་བདག་དང་ལྷ་ཐམས་ཅད་ཀྱི་ལྕེ་དག་པར་བྱས་ནས་རང་གི་ས་བོན་གྱིས་བསྐུལ་བའི་བྷནྡྷ་པདྨ་སྤྲོས་ཏེ།",
    "ཡི་གེ་ཨས་བྷནྡྷ་བསྐྱེད་པ་ནི་གསུང་གི་དམ་ཚིག་གོ།",
    "སྟོང་ཁམས་དག་ནི་ཞེས་པ་ནི་སྟོང་ཆུང་ངུའི་འཇིག་རྟེན་གྱི་ཁམས་རང་གི་ཡོན་ཏན་གྱིས་སྣང་བར་བྱེད་ཅེས་སོ།",
    "དེ་བཞིན་དུ་ལྷའི་བུ་མོ་མཆོག་ལ་སྤྱོད་ནུས་ཞེས་པའོ།",
    "གང་གིས་ཤེ་ན་སྐུ་གསུང་ཐུགས་ཀྱིས་མཚན་པའོ།",
    "རང་གི་མིང་དང་།",
    "དེ་ཉིད་ཟབ་མོ་དང་ཡང་དག་པར་གསལ་བ་བསྲེས་པས་ན་སྦྱོར་བའོ།",
    "རྡོ་རྗེ་བྱེ་བྲག་ཅེས་པ་ནི་ཆུང་ངུ་དང་འབྲིང་པོ་དང་ཆེན་པོ་ཡེ་ཤེས་ཀྱི་བྱེ་བྲག་གི་སྔོན་དུ་བསྙེན་པར་བྱས་ལ་དེ་ལས་ཇི་སྐད་དུ་གསུངས་པའི་དངོས་གྲུབ་ཀྱི་ལས་རྣམས་བསྒྲུབ་པར་བྱའོ་ཞེས་སོ།",
    "ཏིང་ངེ་འཛིན་ནི་རང་གི་སེམས་འཇུག་པ་ལ་སོགས་པས་རང་གི་ལྷར་གྱུར་པའོ།",
    "གྲུབ་མཆོག་ལ་ཞེས་པ་ནི་རང་གི་ལྷ་ནི་གྲུབ་པ་མཆོག་སྟེ།",
    "རང་སྔགས་ཞེས་པ་ནི་རང་གི་ས་བོན་གྱིས་བསྐུལ་བའི་བདེ་བར་གཤེགས་པ་ལས་བྱུང་བའི་འོད་ཟེར་ལས་ལྷ་མོ་བཅུ་འཕྲོས་པ་ལས་རང་གི་སྤྱི་བོར་ཐིམ་པ་ལས།",
    "དེ་ཡང་གོང་མ་ལྟར་བར་གྱི་སྲིད་པའི་སེམས་འཇུག་པ་སྔོན་དུ་བྱས་པའི་ཟླ་བར་ཞུ་བས་མཆོག་གི་བསྙེན་པ་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ལོངས་སྤྱོད་བཞི་པོ་འདི་ནི་སྔར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ངོ་བོར་རང་གི་ལྷའི་སྔགས་ཀྱི་དེ་ཉིད་དོན་སྒྲུབ་པའོ་ཞེས་སོ།",
    "ལྷ་གཙོ་བོ་གཅིག་པུ་གཏོགས་པའི་ཕྱིར་ན་དེ་རྣམས་ལ་མཆོག་གི་སྒྲས་ཁྱད་པར་དུ་བྱས་པའོ།",
    "ཐུན་མོང་མཆོག་གི་བྱེ་བྲག་གིས།",
    "རྡོ་རྗེ་རྣམ་བཞི་ཐུན་མོང་སྟེ།",
    "བློ་དམན་པ་རྣམས་ཉོན་མོངས་པའི་གཅན་གཟན་ལ་འཇིགས་པས་ན་ནགས་འདབས་སོ།",
    "རང་གི་ལྷའི་བཞིན་དུ་གཞན་ལ་ཞེས་པའི་དོན་ཏོ།",
    "རྡོ་རྗེ་བཞི་དག་གིས་ཞེས་པ་ནི་རང་གི་ས་བོན་གྱིས་བསྐུལ་བའི་བདེ་བར་གཤེགས་པ་ཞལ་དུ་ཞུགས་པ་ལས་བྱུང་བའི་པདྨའི་ནང་ནས་ཟླ་བར་ཞུ་བའི་ཆོ་ག་སྟེ་དང་པོའོ།",
    "དེ་ཉིད་གོང་མའི་ལྟར་བཛྲ་དྷྲྀཀ་ལ་སོགས་པའི་སྔགས་ཀྱིས་ཕྱུང་ནས་རང་རང་གི་གདན་ལ་དགོད་པ་ནི་ཆོ་ག་བཞི་པའོ།",
    "རྡོ་རྗེ་རྣམ་བཞི་འདི་དག་གིས།",
    "ཐུན་མོང་བསྙེན་པ་བསྒྲུབ་པའོ།",
    "ལྷ་ཐམས་ཅད་ལ་གཏོགས་པའི་ཕྱིར་ཐུན་མོང་གི་བསྙེན་པ་ལ་སོགས་པར་བྱའོ།",
    "ཟླ་བ་གཉིས་ལ་སོགས་པའི་རིམ་པས་རྒྱུའི་ཆོ་ག་རྫོགས་པ་ལས་བར་གྱི་སེམས་འཇུག་པ་ལ་སོགས་པས་རང་གི་ལྷ་མོ་ལྟ་བུ་བསྐྱེད་ནས་བྱིན་གྱིས་བརླབ་པ་ནི་བར་མའི་བསྙེན་པའོ།",
    "ཡེ་ཤེས་རྡོ་རྗེ་ཞེས་པ་ནི་ལེའུ་བདུན་པ་ལྟར་ཧཱུཾ་ལས་ཡེ་ཤེས་ལྔའི་ངོ་བོ་རྩེ་ལྔའི་རྡོ་རྗེ་རང་གི་རྡོ་རྗེ་བསམས་ནས་ཡི་གེ་ཨོཾ་ཞེས་པ་ནི་དེའི་ནོར་བུ་དམར་བ་ཨོཾ་གྱི་རྣམ་པར་བསྒྲུབས་ལ།",
    "ཞག་བདུན་ལ་སོགས་པ་ནི་བློའི་བྱེ་བྲག་གིས་ཤེས་པར་བྱའོ།",
    "དེའི་བློའི་བྱེ་བྲག་གིས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་མྱུར་དུ་སྟེ་དེ་སྐད་ཅིག་གིས་ཐོབ་པར་འགྱུར་རོ་ཞེས་སོ།",
    "ཞེས་པ་ནི་ཞིང་དག་པའི་གྲངས་དང་ཟླ་བ་དང་ཞག་བདུན་ལ་སོགས་པའི་བྱེ་བྲག་གིས་དངོས་གྲུབ་བསྐུལ་བ་ནི་ངས་རྒྱུད་འདི་ལས་རྒྱས་པར་རབ་ཏུ་བསྟན་ཞེས་སོ།",
    "ངན་སོང་ལས་གཡོགས་པས་ན་སྡོམ་པའོ།",
    "ཞེས་པ་ནི་དེ་རིག་དག་བསྒོམས་པ་ཁྱོད་ཀྱིས་བྱིན་གྱིས་བརླབས་ལ་བདག་རྡོ་རྗེ་སྐུ་དང་ལྡན་པར་མཛོད་ཅེས་རང་གིས་བསྒོམས་པ་ལ་གསོ་ལ་བ་གདབ་པའོ།",
    "རྡོ་རྗེ་སྦྱོར་བ་ནི་རང་གི་ལྷའི་སྦྱོར་བའོ།",
    "ཉོན་མོངས་པས་ནོན་པའི་ལུས་ངག་གི་ལས་མི་བྱེད་པས་ན་ཐུབ་པའོ།",
    "མོས་པ་ལ་སོགས་པ་ལྟ་བུ་མ་ཡིན་པས་ན་ཡང་དག་མཁྱེན་པའོ།",
    "གང་གི་སྲིད་པ་ཇི་སྲིད་ཀྱི་བར་དུ་འགྲོ་བའི་དོན་མཛད་པ་དེ་ནི་ཚུལ་ཏེ་རྒྱུན་མི་འཆད་པས་ན་བརྟན་པའོ།",
    "ཐུན་མོང་གི་བཟླས་པ་གསུངས་པ།",
    "སྤྲོས་པ་རྣམ་གསུམ་དག་བྱ་ཞེས་པ་ནི་ཨོཾ་ལ་སོགས་པ་བརྗོད་པའི་སྐད་ཅིག་དེ་ཁོ་ན་ལ་རང་རང་གི་ས་བོན་ལས་སྐུ་རྡོ་རྗེ་ལ་སོགས་པའི་འཁོར་ལོ་སྤྲོ་ཞེས་པའོ།",
    "བསྒོམས་ནས་ཞེས་པ་ནི་གཞན་དང་གཞན་གྱི་གཟུགས་ལྷག་པར་མོས་པས་ལོངས་སྤྱོད་དང་ལྡན་པར་བྱས་པའོ།",
    "ཡེ་ཤེས་རྡོ་རྗེ་ཞེས་པ་ནི་རང་གི་སེམས་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོར་སྣང་བ་ལ་སོགས་པར་སྣང་བ་མ་གཏོགས་པ་ཕྱི་རོལ་གྱི་གཟུགས་མེད་པར་ཤེས་པར་བྱས་ནས་ནི་ཞེས་སོ།",
    "ནི་ཞེས་པ་ནི་སྐད་ཅིག་གི་མཐར་རང་གི་ས་བོན་ལ་འཇུག་པར་ཡང་བསྟན་ཏོ།",
    "སོ་སོ་དག་ཏུ་སྤྲོ་བསྡུ་ཞེས་པ་ནི་ཡི་གེ་རེ་རེ་བརྗོད་པའི་སྐད་ཅིག་ལ་གཞན་རྣམས་ལ་ཡང་རྣམ་པར་སྤྲོ་བ་གང་ཡིན་པ་སྟེ།",
    "གསུང་གི་བཟླས་པ་གསུངས་པ།",
    "གསུང་གི་ཞེས་པ་ལ་སོགས་པའོ།",
    "གསུང་གི་དམ་ཚིག་ནི་སྣང་བ་མཐའ་ཡས་སོ།",
    "དེ་ཉིད་བདག་གི་རང་བཞིན་དུ་བསྡུ་བའི་ཕྱིར་བཞུད་ཅིང་བྱོན་པའི་རྡོ་རྗེའི་བདག་ཅེས་སོ།",
    "རང་གི་རྡོ་རྗེ་དཀྱིལ་འཁོར་ཞེས་པ་ནི་དཀྱིལ་འཁོར་གཅིག་པ་ཞེས་པའི་དོན་ཏོ།",
    "ཉོན་མོངས་པ་གསུམ་གྱི་བཟླས་པ་གསུངས་པ།",
    "ཞེས་པ་ཉོན་མོངས་པའི་འདོད་པས་མྱོས་པར་འགྱུར་བ་རྣམས་སོ།",
    "ལྷ་མོ་དྲུག་གི་ངོ་བོ་གསུངས་པ།",
    "རྡོ་རྗེའི་བདག་པོ་ནི་གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་སྟེ།",
    "ལྷ་མོ་བཞིའི་ངོ་བོ་གསུངས་པ་རིག་མ་ཞེས་པ་ལ་སོགས་པའོ།",
    "མ་ནིང་དག་གི་གནས་བསྒྲུབས་ན།",
    "ཞེ་སྡང་གནས་ལས་སྐྱེས་ཞེས་པ་ནི་ཞེ་སྡང་གི་གནས་ནི་ལུས་ཏེ་ལུས་ཁྲོ་བོར་བསྟན་པའི་ཕྱིར་དེ་སྐད་བྱ་སྟེ།",
    "ཟླ་བའི་སྟེང་གི་དབུས་སུའོ།",
    "འཁོར་ལོའི་སྔགས་ཨོཾ་མོ།",
    "འོད་ཟེར་ལྔའི་བྱེ་བྲག་གིས།",
    "ལྷ་མོ་དེ་རྣམས་ཀྱང་སྤྲོ་བའི་དུས་སུ་དབུ་རྒྱན་དང་ལྡན་པར་སྤྲོ་བའོ།",
    "དེས་བདེ་བ་མཆོག་གི་རྐྱེན་དུ་གྱུར་པའི་ཕྱིར་རང་གི་ལྷ་མོ་ལ་ཐིམ་པའོ།",
    "དེའི་དབུས་སུ་བདག་པོ་ལས་ཀྱི་བྱེ་བྲག་གིས་གང་ཡང་རུང་བ་བསམས་ནས་དེ་ཡང་རྡོ་རྗེ་གསུམ་དང་ལྡན་པའི་རང་བཞིན་པས་ན།",
    "སྐུ་གསུམ་རྡོ་རྗེ་དག་གི་གཟུགས།",
    "ཞེས་ཏེ་རང་གི་སྔགས་ལས་སྐྱེས་པའི་འཁོར་ལོའི་གཟུགས་བསྒོམས་ནས་རྟག་པ་ལ་སོགས་པར་དཀྱིལ་འཁོར་རྣམ་པ་བཞི་དག་དང་།",
    "གཞན་དང་ཐུན་མོང་མ་ཡིན་པས་ན།",
    "དེའི་དོན་དུ་སྤྱོད་པ་ཉིད་རོལ་མོ་སྟེ་དེས་རྒྱས་བཏབ་པའི་ཕྱིར་ན་མཚན་མའོ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་ཁ་བཞིས་ཞེས་པ་ནི་རྩེ་གཅིག་ལ་ཕྱོགས་བཞིར་གདེངས་ཀའི་རྩེ་མོར་ལྡན་པའོ།",
    "དེའི་འོད་ཟེར་གྱིས་བདེ་བར་གཤེགས་པ་ལ་བསྒྲུབ་བྱའི་སྐྱོན་བརྗོད་པས་ཐམས་ཅད་མི་བསྐྱོད་པ་ཁྲོས་ནས་སླར་བསྡུས་ཏེ་ཐིམ་པ་ལས་གྱུར་པའི་མི་བསྐྱོད་པ་ཤིན་ཏུ་ཁྲོས་པར་བསྒོམ་མོ།",
    "དེ་ཡང་སེམས་ཁྲོ་བས་འཁྲུགས་པའི་ཁྲོ་བོ་ཤིན་ཏུ་མི་སྡུག་ཅིང་འཇིགས་སུ་རུང་བ་སྲིན་པོ་ལ་སོགས་པའི་གཟུགས་སྟ་རེ་དང་ཐོ་བ་ལ་སོགས་པ་མཚོན་ཆ་སྣ་ཚོགས་འཛིན་པ།",
    "ཞེས་པ་ནི་ཇི་སྐད་གསུངས་པའི་གཞལ་ཡས་ཁང་དུ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་གང་གིས་ཀྱང་མི་ཤིགས་པ་རྣམ་པར་བསམས་ལ།",
    "དེའི་དབུས་སུ་རྣམ་པའི་མཆོག་དང་ལྡན་པའི་རྣམ་པར་སྣང་མཛད་ཅེས་པ་ནི་རང་རང་གི་སྦྱོར་བ་དང་མཐུན་པར་མཛད་པ་སྟེ་རང་གི་ལྷའོ།",
    "ལུང་གི་བསྒོ་བ་ནི་སྐུ་གསུང་ཞེས་པ་ལ་སོགས་པའོ།",
    "འཇིག་པའི་དུས་ཀྱི་འབྲུག་ལྟ་བུའི་ཧཱུཾ་གི་སྒྲ་སྒྲོགས་པ་ནི་གསུང་གི་སྦྱོར་བའོ།",
    "དངོས་པོ་ཐམས་ཅད་ཟབ་མོར་དམིགས་པ་ནི་ཐུགས་ཀྱི་སྦྱོར་བའོ།",
    "དེས་གཙོ་བོ་བྱས་པའི་ལྷ་བཅུ་དགུ་དང་ལྡན་པའི་འཁོར་ལོ་བསྒོམ་སྟེ་དེ་ཐམས་ཅད་ཀྱང་གཤིན་རྗེ་གཤེད་ལས་བྱུང་བའི་ཕྱིར་ན་རང་གི་རྡོ་རྗེ་ཡིན་པར་བརྟག་ཅེས་སོ།",
    "དམ་ཚིག་གསུམ་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "ཉོན་མོངས་པའི་ཚ་བ་བསིལ་བར་བྱེད་པ་དང་།",
    "ཡེ་ཤེས་དམ་ཚིག་ཅེས་པ་ནི་ཇི་ལྟར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དེ་ལྟར་བདག་གིས་རང་བཞིན་ནོ་ཞེས་བསྡུ་བའི་དེ་མ་ཐག་ཏུ་ཡེ་ཤེས་ཀྱི་ཚིག་བརྗོད་པའོ།",
    "ཞེས་པ་ནི་སྒྲུབ་པ་ཆེན་པོའི་སྐབས་སུ་ཆུང་ངུའི་རྡུལ་ཕྲ་མོའི་སྟེང་དུ་བདག་ཉིད་བསྒོམ་མོ་ཞེས་པའོ།",
    "དེ་དག་གི་རྐང་པས་གནོན་པ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེའི་སྟེང་དུ་ཧཾ་ལས་ལས་ཀྱི་རྡོ་རྗེ་པདྨ་ལ་གནས་པར་བཞག་ལ་གཞལ་ཡས་ཁང་བསམས་ནས་དེའི་དབུས་སུ་ཁྲོ་བོའི་རིགས་ཁ་དོག་སེར་པོ་འཁོར་ལོ་དང་ལྡན་པར་བཞག་ནས་གནོན་པར་བསྒོམ་མོ།",
    "གལ་ཏེ་དཔུང་ཕྱིར་ལོག་ནས་ལྷ་མདུན་གྱིས་བལྟས་ན་རེངས་པར་འགྱུར་རོ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "རྩེ་མོ་ལྔ་པའི་ཚད་དུ་སྟེང་རྩེ་ལྔ་པ་འོག་རྩེ་གཅིག་པ་ཚད་སོར་བརྒྱད་པ་བསམས་ཏེ།",
    "བར་སྣང་གི་རྡོ་རྗེ་ལས་བྱུང་བས་ན་དེ་སྐད་དོ།",
    "བསམ་གཏན་གྱི་བསྲུང་བ་ལ་ནི་ཧཱུཾ་ལས་བྱུང་བའི་འོད་ཟེར་གྱིས་བསྐྱེད་ནས་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་གཏམས་པར་བསམ་མོ།",
    "བདག་གི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་ཟླ་བ་ལ་འདོད་པ་གཞག་ཅེས་ཏེ།",
    "དེ་བཞིན་དུ་མཚན་སྔགས་སམ་ས་བོན་བཟླས་པས་སྤྱན་མ་ལ་སོགས་པས་ནམ་མཁའི་དབྱིངས་གང་བར་བསྒོམ་མོ།",
    "ཡང་ཨོཾ་ཨཱ་ཨཱ་རོ་ལྀ་ཀ་ཆེ་གེ་མོ་པུཥྚིཾ་ཀུ་རུ་ཧཱུཾ་ཞེས་པའི་སྔགས་སམ།",
    "དམ་ཚིག་ནི་དཀར་མོའོ།",
    "ཞེ་སྡང་གི་རང་བཞིན་པས་ན་འཇིག་རྟེན་ཁམས་རྣམས་འཁྲུག་བྱེད་པའོ།",
    "མཛེས་པའི་གཟུགས་ནི་ལྷའི་བུ་མོའི་ཆ་ལུགས་འཛིན་ཅིང་འཇོ་སྒེག་གི་རོས་རྣམ་པར་བརྒྱན་པའོ།",
    "མཁས་སྐྱེས་སྤྱན་ནི་རྒྱལ་མོ་ཆེ།",
    "ཞེས་པ་དེ་བཞིན་ཉིད་ལས་བྱུང་བའི་ལྷ་མོའི་ཤེས་བྱའི་རྣམ་པ་མཁྱེན་པར་བྱེད་པའི་ཕྱིར་མཱ་མ་ཀཱིའོ།",
    "བཟང་མོ་འཕགས་མ་སྒྲོལ་མའོ།",
    "རང་བཞིན་དུ་གཏོགས་པའི་ཁྲོ་བོ་རྣམས་ནི་བསམ་གཏན་དང་རི་མོའི་དཀྱིལ་འཁོར་གཉིས་བསྲུང་བ་ལ་དགོད་པ་དང་།",
    "གང་གིས་གནོན་པར་མི་ནུས་པའི་གཙུག་ཏོར་མངའ་བས་ན་གཙུག་ཏོར་རྒྱལ་པོའོ།",
    "ཁྲོ་བོ་དག་ནི་རེ་རེ་ཡང་།",
    "ད་ནི་འདོད་པའི་ལྷའི་རྣལ་འབྱོར་པས་རྡོ་རྗེ་འཛིན་པ་ལ་བྱུང་བའི་རང་གི་ལྷས་སྔོན་དུ་བསྙེན་པ་བྱ་བའི་ཆོ་ག་གསུངས་པ།",
    "ལྷ་མོའི་གླུས་བསྐུལ་བས་ས་བོན་ལ་སོགས་པའི་རིམ་པས་རྣམ་པར་སྣང་མཛད་རབ་ཏུ་བསྒོམ།",
    "དེ་ལ་མི་བསྐྱོད་པ་ནི་ཞེ་སྡང་གི་རང་བཞིན་པས་ན་མཆེ་བ་ཅུང་ཟད་གཙིགས་པས་ན་ཁྲོ་བོའོ།",
    "སྦྱོར་བ་འདིས་ཉོན་མོངས་སེལ་བས་ན་ཞི་བའི་བསམ་གཏན་ནོ།",
    "བྱམས་པའི་སྤྱན་གྱིས་འགྲོ་བ་ཐམས་ཅད་ཉི་ཚེ་བར་གཟིགས་པས་ན་སྤྱན་ནི་རབ་ཏུ་ཡངས་སོ།",
    "སྤྱན་ཞེས་བྱ་བ་མི་འདའ་བས་ན་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་མཆོག་གི་དམ་ཚིག་ཅེས་པ་ནི་རྡོ་རྗེའི་རིགས་རྣམས་ཀྱིས་འདའ་བར་བྱས་པ་མ་ཡིན་པ་མཱ་མ་ཀཱི་ཟླ་བའི་གདན་ལ་བསྒོམ་མོ་ཞེས་པའོ།",
    "དམ་ཚིག་སྒྲོལ་མཆོག་ནི་ལྷ་མོ་དེའོ།",
    "ལྷག་པར་མོས་པ་མ་གཏོགས་པའི་ཆོ་ག་སུམ་བརྒྱར་ཤེས་པར་བྱའོ།",
    "གང་གིས་ཤེ་ན་གོང་དུ་གསུངས་པའི་ཁྲོ་བོ་རྡོ་རྗེ་ཡིས་ཞེས་སོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་གཞུང་གི་ལེའུ་སྟེ་བཅུ་གསུམ་པའོ།",
    "རྡོ་རྗེ་སྐུ་ཁྱོད་ཅེས་པ་ལ་སོགས་པའི་གླུས་བསྐུལ་བའོ།",
    "ཡེ་ཤེས་ལྷ་མོའི་ཐུགས་ཀར་ཟླ་བའི་སྟེང་དུ་ཤི་བའི་རོ་བཞག་ལ།",
    "དེ་ལ་སྤྱན་མའི་མིང་བཀོད་ནས་དེའི་འོད་ཟེར་གྱིས་རོ་དེ་མི་སྣང་བར་བྱས་ནས་བསྒྲུབ་བྱ་དེ་མིང་གི་ཐ་མའི་ཡི་གེ་ལས་བསྐྱེད་པ་སྤྱན་མ་ལྟ་བུར་བསམས་ཏེ་གང་བ་རྣམས་རྒྱས་པར་བྱས་ནས།",
    "དེ་ལ་སྙོམས་པར་ཞུགས་ནས་དེའི་རིགས་ཀྱི་ལྷ་མོ་ཕྱུང་ངོ་ཞེས་པ་ལ་སོགས་པ་གོང་མ་ལྟར་རོ།",
    "དེའི་ལྟེ་བར་མཱ་མ་ཀཱི་བསྒོམས་ལ་དེའི་ཡེ་ཤེས་ལྷ་མོའི་ཐུགས་ཀར་མཚན་མ་ལ་གནས་པའི་ཟླ་བ་ལ་མཱཾ་བསྒོམས་ཏེ།",
    "དེའི་སྐྱབས་ཏེ་རྟགས་སྟོབས་སུ་འགྱུར་བ་སྟེ་སྔགས་པ་གང་གིས་བསྲུང་བ་ལ་ཤིགས་པར་དཀའ་བའོ།",
    "ན་བཟའ་དཀར་མོས་རྒྱས་པར་བྱ་བ་གསུངས་པ།",
    "དམར་བའི་མཚན་མ་རྣམས་ཀྱི་འོད་ཟེར་གྱིས་བསྒྲུབ་བྱའི་མིང་གི་ཡི་གེ་དང་པོས་བསྐྱེད་ལ།",
    "བུད་མེད་ཀྱི་པདྨ་ནས་བསྐུལ་བས་དེའི་སྒོ་ནས་ཞུགས་པས་དེའི་སེམས་ཟླ་བ་དམར་པོ་ལྟ་བུ་བླངས་ནས་སྒོ་དེ་ནས་ཕྱིར་ལོག་ནས་པདྨ་གཉིས་སུ་ཞུགས་ནས་བཟླས་བརྗོད་བྱའོ།",
    "དེ་ལྟར་སྡོང་པོ་འགྱེལ་ནས་རྐང་པ་གཉིས་ཀྱི་འོག་ཏུ་ཆུད་པར་བསམ་མོ།",
    "གལ་ཏེ་ལེའུ་བཅུ་གསུམ་པ་ལྟར་བྱེད་ན་ཡང་དེ་ཡེ་ཤེས་ལྷ་མོའི་ཐུགས་ཀར་བཞག་ལ་ཕྱི་མ་རྣམས་གོང་མ་ལྟར་ཤེས་པར་བྱའོ།",
    "གཤིན་རྗེ་གཤེད་ཀྱིས་བུ་མོ་དགུག་པ་གསུངས་པ།",
    "དེ་ནས་བུད་མེད་ཀྱི་ཐོད་པ་མ་ཆག་པ་མ་གས་པ།",
    "དེའི་ལྟེ་བར་དགུག་པར་བྱ་བའི་བུད་མེད་ཀྱི་གཟུགས་བརྙན་གུར་གུམ་མམ།",
    "རོ་བསྲེགས་པའི་སྨྱོ་བྱེད་ཀྱི་ཤིང་གི་སོལ་བ་དང་།"
  ]
}