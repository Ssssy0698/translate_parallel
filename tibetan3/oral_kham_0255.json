    "སྡིགས་མཛུབ་བསྟད་དེ་ཕཊ་ཅེས་གསུངས་པ་ཙམ་གྱིས་ཆུ་ཐིགས་པ་ཙམ་ཡང་མ་ལྷུངས་པར་ཕྱིར་ལོག་པ་སོགས་ཐམས་ཅད་ཀྱི་མཐུན་གྲུབ་ཏུ་མཐོང་གདའ།",
    "གཙོ་བོ་རྣམས་ཆ་ལུགས་འདི་ལྟ་བུས་རྣམ་འགྱུར་འདི་འདྲ་སྟོན་གྱི་འདུག་གསུང་པ་དང་མིས་བསྲེག་མཁན་མེད་པར་སྤོས་ཕོར་སྟོང་པའི་ནང་ནས་ཚིལ་ཆེན་གྱི་དུ་བ་འཕྱུར་བ་དང་།",
    "རང་བཞིན་རྫོགས་པ་ཆེན་པོའི་རྒྱུད་དང་མན་ངག་ལ་མཁས་པའི་སྐྱེ་བོས་ལྟས་ན་ནི་བསམ་གྱིས་མི་ཁྱབ་པའི་ལམ་རྟགས་སུ་གདའ།",
    "བདག་ཅག་མིང་སྲིང་ཁ་ཡར་སྐྱེས་འདུག་ནའང་ཕན་ཐོགས་པ་བདག་ཅག་ལྔ་བྱུང་བ་ལས།",
    "ཨ་ཞེས་བྱ་བའི་སྐད་དྲག་པོ་འདོན་བཞིན་དུ་བཙས་འདུག།",
    "དེའི་ཚེ་ལ་ལས་བཙན་གྱི་ཞགས་པ་ཐེབས་པ་ཡིན་མི་འཚོ་ཟེར་བ་སོགས་ཆལ་ཆོལ་མང་པོ་ལབ་འདུག་ནའང་།",
    "སྨེ་བ་དཀར་པོའི་ག་ཤ་ཡོད་ཙམ་བྱས་པ་ཞིག་འདུག་ཅེས་ཐོས།",
    "བདག་རང་བྱིས་པའི་དུས་ཤ་ཁ་ལ་མི་ཁྱེར་བ་ཞིག་ཡོད་འདུག།",
    "དེ་དྲན་གྱི་གདའ་འམ་དགོད་དྲོ།",
    "ང་རང་ཡང་ཁུར་བཞེས་བྱེད།",
    "གྱི་ནར་མ་འདུག་སྐྱེད་མི་འདོན་ནམ།",
    "ཚིགས་བཅད་ཅིག་འདོན་གྱི་འདུག་པ་ཡིད་ལ་མ་ཟིན།",
    "གཞན་བྲིས་སྐུ་ཤོབ་བེ་བ་ཉན་ངེས་འ་ཡང་རང་རྡོལ་ལ་ཤེས་པ་ལགས་ཤིང་།",
    "ལོ་བཅུ་ལ་ཁ་ལྟས་ཙ་ན་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་དཀྱིལ་ཇོ་ནང་ཕྱོགས་ལས་རྣམ་རྒྱལ་གྱིས་མཛད་པ་ལ་བསླབ་གཉེར་བྱས།",
    "ཁྱེད་ཤེས་རབ་ཆེའི་གདའ་གསུང་པ་ལས་གཞན་མི་གསུང་།",
    "ཁྱེད་བྱས་ན་ཡོང་བ་ཞིག་གདའ་སྟེ་གསུང་བ་ད་ལྟའི་བ་མ་གླང་འདི་ཡོང་བ་དགོངས་པའི་གསུང་དུ་གདའ།",
    "ཡང་ངེད་རྣམས་བླ་བྲང་ནས་གནས་ཚང་དེར་བསྐྱས་པའི་ཚེ་བླ་བྲང་པའི་ཁྲོལ་ཁྱི་རྒྱ་བོ་ཞིག་གདའ་བ་དེ་ངེད་ཀྱི་ཕྱི་ལ་སླེབ་བྱུང་ནས་སྒོ་འགག་ཏུ་སྡོད།",
    "སྟེར་བྱིན་འདི་ལ་གནང་དཔངས་ཤིག་མི་གདའ་སྟེ་གོ་བ་ཞིག་ཡོད་པ་ཡིན་གསུང་ངོ།",
    "བཀའ་ལུང་ལ་ད་ལམ་ཨཊྚ་ལས་གུར་གྱི་མགོན་པོ་བསྙེན་པ་བྱས་ན་ལེགས་པ་འདུག།",
    "ད་དུང་མཐོང་མཐོང་ལ་ཐག་རྒྱང་ཆེན་རྒྱང་པ་ཡོད་ངེས་སུ་གདའ་འོ།",
    "ཡི་ཆད་ཐང་ལ་ཡུན་རིང་འཁྱམས་ཉེན་གདའ།",
    "གཉིད་བྲོའི་འདུག་ན་བརྡ་ཙམ་མཛད།",
    "ནང་ཐམས་ཅད་བསེབ་དྲིས་ཁེངས་འདུག།",
    "བསམ་དུས་ཐའི་དབར་ཞིག་བྱུང་བ་ཡིན་ན་དེ་དང་དེ་འདྲ་ཞིག་ཡིན་པ་འདུག་སྟེ་སྙམ་པའི་གོ་བ་ཞིག་བྱུང་ངོ།",
    "བྷུ་ཊུ་བ་སོགས་ཀྱི་ཡོ་བྱད་ལ་ཞེན་པ་ཆེན་པོ་ཡོད་ཞིང་འདུག།",
    "ལེགས་གཤད་གསེར་ཐུར་ན་བྲིས་འདུག་པའི་རྙིང་མའི་དགག་པ་དེ་ཚོ་མཐོང་བ་དང་།",
    "སློབ་དཔོན་པདྨའི་སྐུ་གསུམ་སྒྲུབ་ཐབས་ཞུས་པས་རཏྣ་གླིང་པའི་གཏེར་མ་དང་དོན་ལ་ཁྱད་ཡེ་མི་འདུག་པས་གཏེར་རྫུན་ཡིན་ཟེར་བའི་ལོག་རྟོག་དེར་ཁེགས།",
    "དེ་མ་ཐག་ཟངས་གྲི་ཅན་གྱི་གཏོར་མ་ལ་བསྟེན་པའི་བསྙེན་པ་བྱས་དུས་རྒྱ་འདྲེ་ཤེད་ཀ་ཡིན་ནམ་རྒྱལ་པོའི་ཆོ་འཕྲུལ་དུ་ནི་གདའ།",
    "ཁྱད་པར་བླ་ཆེན་སྐུ་དྲིན་ཅན་དེའི་དྲུང་དུ་སྐུར་ཞུས་བྱེད་ཀྱི་འདུག་ཟེར་གཞི་མེད་ཀྱི་ཞུ་ལོག་ཁམས་ཆེན་པོ་ཞིག་ཕུལ་གདལ་བས་ཐུགས་འུར།",
    "ངས་ག་ལེ་ལྟས་པས་བཞིན་འགྱུར་ཙམ་ཡང་མི་འདུག།",
    "དམ་ཚིག་དང་དྲིན་སོམ་པར་གདའ་བས་བཟང་གསུང་།",
    "སྨྱོ་འདུག་ཟེར་བ་སོགས་གཏམ་མང་པོ་ལབ།",
    "ཐ་ཆད་བདག་ཀྱང་དམ་པ་ཡིན་ཚོད་འདུག།",
    "ཀུན་མཁྱེན་ཆེན་པོ་སྡོར་དཀར་བ་དེ་ལ་ཕྱག་ཤན་ཡོང་བ་དགོད་བྲོ་ཞུས་པས་སྐྱེངས་ནས་མུན་ནེ་བཞུགས་འདུག།",
    "དགྲ་སྦྱད་པས་འདུལ་མཁན་དུ་གདའ་བས་སྟོན་ཤོམས་དེ་ཚོ་བཟའ་ཆེན་པོ་གདའ།",
    "ད་སྲུང་མཁན་ཡེ་མི་གདའ་བས་གྲངས་ཀ་མང་ཉུང་གང་ཡོད་ཀྱང་ཁྱད་ཅིག་མི་གདའ་བྱས་པས།",
    "ང་རང་ཡང་བསམས་ཙ་ན་འདི་ཡིན་མེད་པ་ལ་སྣང་ཡུལ་ལམ་ལམ་མང་པོ་བྱས་པ་ཞིག་ནི་བྱུང་།",
    "ཡང་སྲིད་སློང་ལ་ཐེ་ཚོམ་མི་འདུག་སྙམ།",
    "ཞུས་ན་སྦྲེག་བཏང་བས་ཨེ་ཡོང་ཞུས་ཀྱང་མི་ཡོང་གསུང་བ་དེ་སྲོལ་དུ་གདའ་བ་དང་།",
    "སྒོ་དེའི་ནང་ན་ཆུ་གཏེར་ཆེན་པོ་ལྗོངས་། ལྗོངས་དེར་དེ་དང་དེ་འདྲ་འདུག་པ་མཐོང་།",
    "བྲང་ཁང་སོ་སོ་ལ་འཚང་དྲག་བྱས་སྐད་ཆ་ཤོད་ཐེབས་མེད་པ་མ་པོ་ཞིག་བྱེད་ཀྱི་གདའའོ།",
    "ཆིབས་སྒ་ཚུན་སྒྲོན་གྲུབ་འདུག་པ་ལ།",
    "དམག་རྣམས་སྤྲེའུ་ཞིག་ལ་འཚང་ཞིང་འདུག་ནས།",
    "དེ་ནས་ཐུ་བསྟན་དུ་འདུག་པའི་ནུབ་ཅིག་ཉང་སྟོད་རྒྱལ་ཁང་དེ་རྨི་ལམ་དུ་གསལ་པོ་བྱུང་།",
    "སྐོར་དགོས་པའི་ལྟས་འདྲའང་འདུག་པ་དང་།",
    "མེད་ངེས་དབྱངས་སུ་ལེན་པའི་རྡོ་བཅལ་སྒྲིགས་། སྒྲིག་པ་འདི་ལ་བསྟད་སོ་ཅི་འདུག་སོམས།",
    "སེམས་ཧད་དེ་བ་ཞིག་མིན་པ་འདི་ཡིན་ཞིག་མི་འདུག།",
    "ཀོག་ཆུང་མའི་གྲུ་ཁ་སོགས་ན་ཐབ་འཛིན་པ་རིམ་བཞིན་འཇོག་པ་མཛད་འདུག་ནའང་ངེད་རྣམས་མཚན་འགྲིམས་བྱས་པས་ཚོར་མཁན་ནི་སུ་ཡང་མ་བྱུང་།",
    "གཉིད་སད་ནས་ཀྱང་ནང་ཐམས་ཅད་ཁྲག་དྲིས་ཁེངས་གདའ།",
    "གནས་གསར་བ་མི་མིན་ཟེར་བ་བདེན་པར་འདུག།",
    "མི་ཕན་ན་ནི་མི་ཆུག་པ་མཛོད་ཞུས་ཏེ་བསྟན་པ་ལ་ཕན་པ་ཡིན་ནམ་ཆུག་འདུག་པ་གསུང་བས་དགའ་བ་དང་བྲེད་པ་ལྷན་ཅིག་པ་བྱུང་།",
    "ཞལ་རས་བྱུ་རུ་ལྟར་དམར་ཞིང་གཞོན་ཤ་ཆགས་ལ་ཞལ་རྒྱན་སོགས་ཡེ་མེད་པའི་རྣམ་པ་ཅན་ཞིག་ཏུ་འདུག་ནས།",
    "དགོད་གྲོ་སྔར་ཕན་ནི་ཞལ་རྒྱན་ཡེ་གཞོར་གྱི་མི་འདུག།",
    "སེམས་བདེ་ཐག་ཆོད་ཅིག་བྱུང་འདུག།",
    "ཁོ་རང་ནི་རྣམ་པར་འགྱིང་།",
    "ད་ཐབས་ཆེར་མི་འདུག་ཅིས་ཀྱང་རུ་ལག་རྒྱང་ལ་རྒྱུག།",
    "བློ་ཆུང་རང་མཐོང་ལངས་པས་འགྱིང་ཞིང་འདུག།",
    "རྒྱང་མཉེས་པའི་རྟགས་འདུག་ཟེར་དཀོན་གཉེར་དེ་ལབ་ཀྱི་འདུག།",
    "དེ་ནས་སྐྱེས་པ་བརྗིད་ཆགས་ཤིག་འདུག་པ་དེས་བདག་ལ་བ་ཆེན་པོ་ལ་གཞིས་ལེན་གྱིས་ཟེར་འཁུར་བ་ཤས་ཆེ་བའི་བཟའ་བཏུང་མང་པོ་བྱིན།",
    "བདག་ཅག་ཛམ་བྷ་ལའི་ནང་དུ་བཅུག་གདའ་གསུང་དགྱེས་དྲགས་པའི་གསུང་མང་པོ་བྱོན།",
    "སླར་ཕེབས་བཞེད་ཀྱང་འདུག་པ་བཞིན།",
    "མདུན་གྱི་ནམ་མཁར་ལྷ་དམར་སྨུག་ཞལ་གསུམ་ཕྱག་དྲུག་པ་ཡུམ་ཅན་ཕྱག་གཉིས་ཉི་ཟླ་ཆ་ལང་རྡེབ་པའི་རྣམ་པ་ཅན་ཞིག་འདུག་པ་ལ།",
    "བབས་ནི་དངོས་དང་རྨི་ལམ་གྱི་ཁྱད་མ་གཏོགས་མཐོང་སྙམ་དུ་ནི་འདུག་གསུང་།",
    "ཞེས་ལུང་བསྟན་པ་དེའི་དུས་སུ་སླེབ་འདུག་པ་དང་།",
    "བོད་དཀྲུག་མཁན་འགོང་པོས་བྱེད་པར་གསུངས་འདུག་པས་ཕན་ནམ་སྙམ།",
    "འདིར་ཡང་མི་མཛད་འདུག།",
    "བདེ་གཟར་ལངས་ན་ཁེ་ཡོད་དགོངས་པར་གདའ་ནའང་།",
    "མི་ཉན་ཙ་ན་བྱ་ཐབས་མི་གདའ།",
    "ཁྱེད་རང་ཡང་འདི་ལས་སྔ་བ་ཞིག་འཕྲད་ན།",
    "དམག་བོ་དོང་ལ་ཆས་གྲུབ་འདུག་པ་ལ།",
    "མཆི་མས་སྔས་བངས་འདུག་ཅིང་།",
    "ད་ནང་རང་ནས་དགེ་སྦྱོར་སྒྲིགས་བཅུར་ཞིག་བྱེད་དགོས་སྙམ།",
    "ཇི་སྲིད་མ་ཤིའི་བར་དུ་མ་བརྗེད་པར་གསོལ་བ་འདེབས་པ་ལས་ཐབས་གཞན་མི་གདའ།",
    "སྤྱན་འདྲེན་ཡན་ལ་ནི་ཟླ་བོ་ཚོས་གྱིར་བ་མ་གཏོགས་སྐད་ཐོན་རྒྱུའང་མི་གདའ།",
    "ཁང་པ་ཆུང་ངུ་འོས་ཙམ་ཞིག་འདུག་པ་དེ།",
    "ངེས་ཀྱི་སྡོད་ས་ཡིན་ཟེར་གྱི་འདུག་པ།",
    "གཞན་ཕྱག་ཕྱི་དྲག་པ་ཚོ་ནི་དེར་བཞུགས་མི་ཉན་འདུག་པས།",
    "ཟ་རུ་མ་ཉན་པ་དཀོན་ཅོག་མཆོད་བྱས་གནང་བར་གདའ།",
    "བྱ་ཞིག་འདུག་པ་ན་ངོ་མཚར་ཆེ་སྙམ་མགོན་པོའི་སྔགས་རྣམས་ཀྱང་སྔར་ཁོ་ན་བཞིན་བཟླས།",
    "ཆུ་ཁོལ་བ་ལྟར་ལོང་ལོང་བྱེད་པ་ཞིག་འདུག་པས་ལག་པས་བྱུགས་པས་སྲེབ་ཐུག་ཐུག་འདུག།",
    "ང་རང་གདོན་གྱིས་ཟིན་བཞིན་དུ་གཞན་ལ་ཕན་པ་སྙམ་པའང་བྱུང་།",
    "འདིར་གནས་སྐོར་བ་མང་པོ་བྱུང་སྟེ་ཐང་ཆད་སྐུམ་སྟེ་ཉལ་མཁན་རྐྱང་མིན་པ་མི་ཡོང་བ་འདུག།",
    "ཁ་ཏོན་བྱེད་ལུགས་སོགས་ཨ་ཐོ་ཞིག་འདུག།",
    "ཕ་རྒན་ཀྱང་སྐུ་ཁམས་གས་མེད་དུ་དྭངས་འདུག་པས་གོ་བཅད་པར་བྱུང་།",
    "ངེད་ཚོ་དང་བསྡོངས་ལོག་འགྲོའི་འདུག་པ་ལ།",
    "ངེད་ཀྱི་ཟླ་བོ་འདྲས་གང་ལ་ནི་འབྱོན་བྱས་པས་དོན་མི་གཅིག་བདོག་སྟེ་ད་ཡོང་བ་གདའ་ཟེར་ཞིང་དགོད།",
    "ད་དུང་བཟུང་ན་ཁེ་ཆེ་བ་འདུག་སྟེ།",
    "བློ་ཐེ་ཚོམ་ལས་མི་འདུག།",
    "ལུང་པ་སོགས་རྨི་ལམ་ཇི་ལྟ་བར་འདུག།",
    "བབས་སུ་འདི་འདྲ་ཞིག་ལས་ཀྱིས་བསྐོས་ཡོད་གདའ་བས།",
    "འོ་ཡུག་ཏུ་སླེབ་དུས་གཞན་ཐམས་ཅད་རྨི་ལམ་བཞིན་འདུག་པ་ལ་འདུ་ཁང་དམར་པོར་བྱས་པ་ལ་ས་ཁྲ་དང་།",
    "རྒྱབ་ཀྱི་མཆོད་རྟེན་དེ་མི་འདུག་པས་ཅི་ཡིན་སྙམ།",
    "རྒན་པོ་འགའ་ལ་དྲིས་ཙ་ན།",
    "དང་ཐོག་ས་ཁྲ་དང་མཆོད་རྟེན་གཉིས་ལ་ཅར་ཡོད་ཟེར་གྱི་གདའ།",
    "ཆོ་ག་འདི་ཙམ་ལའང་བཅས་བཅོས་དགོས་པ་མང་པོ་ཞིག་འདུག་སྙམ་པ་བྱུང་ངོ།",
    "དེ་པ་དང་ཡོད་མཆོད་ཡིན་ཟེར་འབྲེལ་ཆེན་པོ་བྱས་པ་ཞིག་འདུག་པ་དང་།",
    "ཁམས་པའི་ཡོན་བདག་རྣམས་ལའང་བཞུགས་གྲལ་སོགས་འཕྲལ་དུ་དགོས་པའི་བསུན་པོ་ཞིག་འདུག་པ་ནས།",
    "གྱོད་རྒན་གཏམ་ལབ་པ་ཞིག་འདུག་པ་དེ་སོགས།",
    "ཇོ་ནང་ཀུན་མཁྱེན་ཆེན་པོ་དེ་ལྟར་བཞེད་ཟེར་བརྒྱལ་འགྲོ་བ་ཙམ་བྱེད་ཀྱི་འདུག་པ་ལ།",
    "མི་འཐད་ཟེར་མཁན་སུ་ཡང་མ་འདུག་པས།",
    "སེམས་ལ་ཚེ་རིང་ཙ་ན་སྐད་ཆ་ཅི་ཡང་ཞིག་ཚོར་གྱི་འདུག།",
    "འདི་མི་འཐད་ཚུལ་འདྲ་ལབས་ན་རུང་བ་ཙམ་འདུག་སྟེ་གཡེམ་མ་མུ་ཅོར་གྱི་རྒྱལ་པོར་འདུག་པས་དགག་སྒྲུབ་ཀྱི་ཡུལ་དུའང་མ་འདུག་ལ།",
    "སེམས་ལ་ང་རང་ལ་རྩ་བའི་ཆ་ལུགས་ཞིག་ཡོད་པ་བོར་བས་ཡོང་བ་མེད་སྙམ་པ་ཤར་ནའང་།",
    "དེ་ག་བགྱིད་ཞུས་པས་ཐུགས་མཉེས་པའི་རྣམ་འགྱུར་མང་པོ་ཞིག་མཛད་ཀྱི་གདའ།",
    "གཉིས་ལ་དབུགས་རྒྱུ་ཙམ་འདུག་པས་ད་དུང་དྲག་པོའི་སྦྱིན་སྲེག་གཅིག་གྲུབ་ན།",
    "ཕྱོགས་དེར་ཕན་པ་འདུག་སྟེ་ད་བར་མ་ཐུབ།",
    "ཐོད་པའང་སྔར་བཞིན་སླེ་འདུག་ཅིང་།",
    "བསྟན་དགྲ་འདི་རིགས་ལ་གཏམ་འདྲེས་ནའང་དངོས་གྲུབ་ཡལ་འགྲོ་བ་དེར་གདའོ།",
    "མི་སྒོམ་ན་ངལ་བ་ལས་མི་འདུག་པས་ཕར་མི་འགྲོ་དགོས་སྙམ།",
    "སྐལ་དམན་གཉིས་གསུམ་ཞིག་མ་གཏོགས་ཁྲིད་པ་བྱིངས་དང་ཁྱད་པར་ཁམས་པ་རྒད་པོ་དེ་རྣམས་སྡུག་རུས་བྱས་སྒོམ་ཞིང་འདུག་ནས་ཞག་ལྔ་ལས་མ་འགོར་བ་ཕྱིན།",
    "དམ་པ་བསླུ་བ་མེད་པ་གསུམ་ཞལ་འཛོམ་བྱུང་བས་དེ་ལ་ལྟོས་པར་མི་གདའ་ནའང་།",
    "རིག་འཛིན་ཆེན་པོ་བསྟན་གཉིས་གླིང་པའི་དབོན་པོ་ཡིན་པར་གདའ་བས།",
    "སྐྱིལ་ཀྲུང་བཅས་བཞིན་དུ་མི་རྣམས་གྲལ་ལ་འདུག་པའི་སྟེང་ནས་ཡུད་ཀྱིས་འོངས་ཏེ་འཕག་པ་ལ་སོགས་ཀྱང་བྱུང་།",
    "མགོན་ཁང་ན་འཆམ་སྐུ་ལེགས་པོ་གཉིས་བཞུགས་ཀྱི་གདའ་བ་ལ་ཞལ་ཁེབས་བསལ་ནས་བལྟས་པས་འཚུབ་ཡོད་ཟེར་དཀོན་གཉེར་དེ་འཇིགས་འཇིགས་བྱེད་ཀྱི་གདའ་བས་ཐུགས་འཚབ་མི་དགོས་ལྷ་འདིའི་རྒྱུས་ངེད་ཆེ་བ་ཞིག་ཡིན་བྱས།",
    "དེའི་ཚེ་རི་ཕུག་བླ་བྲང་ན་མཁན་ཆེན་འཇམ་དབྱངས་པ་བཞུགས་ཀྱི་གདའ་བ།",
    "དེའི་སྤྲོས་པ་ནི་ཆོད་འདུག།",
    "ཚུར་ཡོང་བའི་དུས་རྒྱ་ཕིབས་སྟེང་ནས་བྱ་རོག་ཞིག་འཕུར་བྱུང་སྟེ་རགས་ནག་པོའི་འོ་ཙམ་ནས་བསུས།",
    "སྐུ་མཚམས་དམ་པོ་ཡོད་འདུག་ནའང་བརྩེ་བས་བཟུང་སྟེ་མཇལ་ཁ་བྱུང་།",
    "བོད་ཡུལ་གྱི་དྲེགས་ལྡན་ཐམས་ཅད་ཀྱི་ཅོད་པན་བརྟུལ་ཞུགས་སྤྱོད་པའི་རྡོ་རྗེ་བཅུ་གཅིག་པ་གློ་ཆེན་ཐམས་ཅད་མཁྱེན་པའི་དྲུང་གདན་ཆགས་འདུག་པ་བཞིན།",
    "ཆེད་དུ་འབོད་པར་གནང་བར་འདུག།",
    "ངེད་ཀྱི་ལག་ལ་རྡར་ཕུལ་བ་ཙམ་དུ་འདུག་པ་ནས་བསམ་པ་མ་རྫོགས།",
    "ཚོགས་འཁོར་དུ་མིང་བཏགས་པའི་ཆང་འཐུང་མང་པོ་བྱེད་པ་ཞིག་གདའ་བ་དེ་ལ་ཅུང་ཟད་ཕན་ནམ་བསམ།",
    "འཁྲིས་རྒྱལ་པོ་དེས་ཅུང་ཟད་བར་ཆད་བྱེད་ཀྱི་འདུག་ནས་རྨི་ལམ་དུ་ལེགས་པར་བཏུལ།",
    "ནང་དེ་ན་བཅུད་འཕྲོག་མ་མཚན་ཉིད་ཐམས་ཅད་ཚང་བ་ཞིག་གདའ་བ་དེ་ཁམས་བཟང་རིང་བར་ཚོགས་ཁང་པས་ཇི་ཙམ་འབད་ཀྱང་ལུགས་གཉིས་ནས་གོ་ཚུགས་མི་ཡོང་བ་ཐག་ཆོད་གདའོ།",
    "ངེད་ཡོན་ཏན་གྱི་ཆ་ཤས་ཁྱི་ལ་འདུག་ཀྱང་ལེན།",
    "ག་ཤེད་དུ་བསྡད་ཀྱང་ལྷག་པོར་འུ་ལག་འཕེལ་བ་ལས་མི་འདུག་པས་ཉེ་འཁོར་ཤིག་ཏུ་དབེན་དགོན་ཆུང་ངུ་ཞིག་བཏབ་པའི་དགེ་སྦྱོར་དང་།",
    "དེའི་ཚེ་རྗེ་བཙུན་དམ་པ་པ་རྣམ་ན་ཕེབས་འདུག་པ་ནས་མཇལ་དུ་ཕྱིན།",
    "ཁྱད་པར་འདི་ད་ལྟ་འདི་ཕྱོགས་བཀའ་ཆད་འདུག་པ་གསོ་ཐུབ་པ་ན་ལེགས་ཕེབས་པ་ལ།",
    "བཀའ་རྒྱ་འཇིགས་འཇིགས་གང་ཡང་འདུག་པ་ནས་སྔར་ཕན་ནི་གསུམ་ལས་མང་བ་ལ་མ་བགྱིས།",
    "འཇིག་རྟེན་ཕྱོགས་ཀྱི་ཤེས་མྱོང་རྒྱུ་ཆ་རྐྱེན་སོགས་གང་ནས་བསམ་ཀྱང་བློས་ལྕོགས་པའི་ཡུལ་མི་འདུག་ཀྱང་།",
    "དེ་ཚེ་ཆར་པ་ཤིན་ཏུ་ཆུང་བའི་གཙང་པོ་སོགས་ཀྱང་ཆེན་པོ་ཡེ་མི་གདའ་བ་ལ།",
    "ཞྭ་ལུ་པའི་དྲུང་ཆེན་ལྷོ་པ་ཐབ་འཛིན་ལ་བྱོན་འདུག་ཅིང་།",
    "ཁོང་རང་རྣམས་ལའང་ལྷ་འདྲེ་འདི་ཚུགས་ཟེར་གྱི་གདའོ།",
    "ཁམས་གསུམ་རྣམ་རྒྱལ་གྱི་སྒྲུབ་མཆོད་ཀྱང་ཆག་འདུག་པ་ནས།",
    "དེ་སྔ་མཆོད་གར་འདི་རྒྱུན་དུ་མི་འདུག་པས།",
    "གཙུག་ལག་ཁང་སོ་སོའི་གནམ་རྒྱན་གྱི་འདེགས་སོགས་གང་དང་ཅི་ཐམས་ཅད་ལ་ཤེས་ལྡན་གཟུ་བོར་གནས་པ་ཐམས་ཅད་དགའ་མགུར་ངས་ཐུབ་ངེས་འདི་གྲུབ་འདུག་པ་བཞིན།",
    "པཎ་གྲུབ་མང་པོ་ལ་གསུང་བྱོན་པའི་ངོ་མཚར་ཅན་དུ་འདུག་པའི་གསོལ་བ་འདེབས་པར་ཕྱིན་ཏེ།",
    "རིགས་ལྔའི་ལི་མ་སྐུ་ཚད་ཆེན་པོ་འདྲ་འདུག་པ་རྣམས་མཇལ།",
    "སྒམ་ཞིག་ན་རྒྱལ་པོའི་རྟེན་རྫས་ཤེལ་སེང་གེ་སོགས་ཁ་ཡར་འདུག་པ་རྣམས་ཀྱང་བལྟས།",
    "ད་དིའི་བཙུན་པ་དེ་ཤིན་ཏུ་གུས་པའི་རྣམ་པས་ཉན་ཞིང་བསྡད་འདུག།",
    "གྲོལ་བའི་བསྔོ་བ་ཚུགས་མ་ཐག་འཕུར་འགྲོ་བ་ཇི་སྲིད་ཁྲིད་ལུང་མ་རྫོགས་ཀྱི་བར་བྱུང་བས་ཐམས་ཅད་ང་མཚར་དུ་འཛིན་གྱི་འདུག།",
    "ཕྱག་བྲིས་འཕྲོ་མར་ལུས་པས་བར་འདིར་མ་ཚང་བ་འདུག་པ་མཆན་བུའི་འདི་རྗེས་སུ་བཏབ་པ་ཡིན་ནོ་། དེ་དག་ནི་རང་ཉིད་སྐྱེས་ནས་ད་ལྟའི་བར་གྱི་བྱས་བྱུང་རགས་པ་སྟེ།",
    "སྦས་པས་སྦས་གོ་ཆོད་པར་ཡང་མི་འདུག་སྟེ་ཐོགས་མེད་དུས་ནས་གོམས་པའི་བག་ཆགས་ཤུགས།",
    "སྐུ་རྒྱལ་སོགས་གང་ཅི་ཐམས་ཅད་ཁོ་རང་རྣམས་ལ་བྱིན།་",
    "གང་ལ་གང་འཚམ་པའི་ཆད་པས་གཅོད་ཀྱི་འདུག་པ་མ་གཏོགས།",
    "བར་ཆད་བཟློག་པ་ཁོ་ན་ལ་དམིགས་ནས་གཏོར་མ་དྲག་པོ་འདི་དག་བགྱིས་པ་ཡིན་པས་ཚེ་ལ་མི་གནོད་ཀྱི་སྟེང་དུ་ཕན་པ་མྱོང་བས་ཐོན་གྱི་འདུག།",
    "ང་རང་ཤི་ནའང་ཤི།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "རང་ཉིད་ཀུན་སྤྱོད་དང་ཡོན་ཏན་གང་ཅི་མཐོང་བས་གསལ་བ་འདི་གར་འདུག་ལ།",
    "དེའི་བར་ལ་འཆད་རྩོམ་སྒོམ་སྒྲུབ་སྔར་ལས་ཀྱང་རྒྱ་ཆེ་བ་མཛད་འདུག་ནའང་ད་ལྟ་ཡི་གེར་འཁོད་པ་མེད་པས།",
    "རྟེན་འབྱུང་ལེགས་པར་དམིགས་ནས་དུར་ཁྲོད་ཅིག་ཡོད་པར་མཛད་པའི་རྣམ་པ་ད་ལྟའང་འདུག།",
    "ཡོལ་ནས་དབོན་པོ་ཡིན་པར་འདུག་ཞུས་པས།",
    "འདི་བཞིན་བྱུང་ཟེར་བ་ལབས་འདུག་གོ།",
    "ཉམས་དེའི་ངང་ནས་བུག་སྒོ་ལ་ཐོན་ཐུབ་པ་སྙམ་བྱེད་པ་འདུག་གསུང་།",
    "སྐུ་དངོས་ལ་ཞབས་ཏོག་འབུལ་བ་དེ་ལྷ་བཟོ་བ་གཞན་གྱིས་མ་བྱས་པར་རྗེའི་དྲུང་རང་ཕྱག་བཟོ་བོ་འདུག་པས་ཕྱག་བདར་མ་རང་མཛད་ན་བར་ཆད་ཀྱང་མི་ཡོང་གསུང་བ་ཕེབས་ནས།",
    "གུ་གུལ་བཏུལ་བའི་མེ་ཡལ་ཟིན་ནས་གཏོར་སྒྲོམ་གྱི་འོག་ནས་དུད་པ་ཆེན་པོ་རང་བྱུང་དུ་འཐུལ་ཞིང་འདུག་པས་ཕྱག་ཕྱི་བ་ལ་སྟོན་པ་མཛད་དུས།",
    "ཐུགས་རྟོག་བཅུག་དུས་སྐུ་དེ་གང་ལའང་བརྟེན་མེད་དུ་བཞུགས་པའི་ཞབས་མཐིལ་དང་གདན་གྱི་བི་ན་ཡ་ཀ་བསྣོལ་བའི་བར་ལ།",
    "ཞབས་ཀྱི་རྨ་བསྟན་ནས་འདི་ལ་ཕན་པའི་ཐབས་གྱིས་ཤིག་པའི་སྐད་ནི་མི་གོ་བ་ལྟར་བྱེད་ཀྱི་འདུག།",
    "ཕྱོགས་ནས་ཡོང་མཁན་རྣམས་གྱེས་འདི་ཁའི་རྒྱུན་པ་རྣམས་མིན་པ་མི་འདུག་ཞུས་པས།",
    "ད་དུང་འགོལ་བར་བྱས་ཉུང་བསྡུས་ཤིག་ལ་བྱེད་དགོས་པ་འདུག་གསུངས་དེ་ཀ་བཞིན་ཁྲིད་བཀའ་ཞག་ཉི་ཤུ་རྩ་གྲངས་ལ་རྫོགས་པ་གནང་།",
    "རྗེའི་དྲུང་ལའང་གསུང་ལེགས་པོ་འདུག།",
    "སླར་ཡང་འདི་ནས་གནོད་སྦྱིན་བེད་ཙེའི་བཀའ་བབས་ཀྱི་འབྱུང་ཁུངས་ཡིན་འདུག་པས་ཅིས་ཀྱང་གནང་དགོས་ཞུས་པས།",
    "སློབ་དཔོན་པདྨ་དང་གྲུབ་ཐོབ་འདར་ཕྱར་ཡིན་པ་འདུག།",
    "ད་ལམ་རང་ཐེགས་ནས་ལོ་གསུམ་མཁན་ཐོག་ཏུ་བཞུགས་པ་འདུག་ཟེར་བ་བཞིན།",
    "མ་འོངས་པ་ན་ཉིད་ཡར་ཀླུངས་པ་སེང་གེ་རྒྱལ་མཚན་གྱི་ཚབ་མ་མཛད་དོ་ཨང་གསུང་བ་ཞིག་གནང་བྱུང་བས་མངའ་གསོལ་དུ་འདུག།",
    "དེའི་གོང་དུ་མིས་ཕྱིན་པའི་ཤུལ་རྗེས་ནི་མི་སྣང་མདའ་དར་བླངས་ནས་ཡོངས་ཏེ་མགོན་ཁང་དུ་ཕྱིན་ཐུགས་དམ་གྲོལ་མཚམས་ལ་ཕྱག་ཏུ་ཕུལ་བས་ག་ན་འདུག་གསུང་པ་ལ།",
    "མཐའ་འཁྲིས་ཀྱི་ལྷོའི་ཁང་ཤུལ་ན་འདུག་ཞུས་པས།",
    "ངེས་པ་ཡོད་ད་དུང་ཡང་འདུག་པས་ཚོལ་གསུང་བ་བཞིན་ཞིབ་པར་བཙལ་བས་རྙེད་རྗེའི་ཕྱག་ཏུ་ཕུལ་བས་འོ་འདི་ཡིན་གསུང་།",
    "ད་རབ་གནས་ལ་ཡོང་ཐུབ་པ་མ་འདུག་གསུང་ཞིང་།",
    "སྤྱན་ཆབ་མང་པོ་བསིལ་བ་ཞིག་བྱུང་བས་མནལ་སད་དུས་ཀྱང་སྤྱན་ཆབ་མང་པོ་ཕེབས་འདུག།",
    "གྲ་པ་རྣམས་སྟོན་དུས་སྐྱིད་འཕན་ཚུན་བསོད་སྙོམས་བཏེག་དུས།",
    "གྲུང་པོའི་བསྟོད་ར་གཏོང་བ་འདུག་རུང་།",
    "ཐུགས་དམ་ཇེ་མཐོར་ཕེབས་པའི་དྲོད་རྟགས་ཁྱད་པར་ཅན་བྱུང་ཡོད་འདུག་རུང་།",
    "འཕྲལ་གཏམ་དོན་ཆེ་རུང་ཕུགས་སེལ་དུ་འགྲོ་བ་འདུག་པས་མ་སྩལ་རུང་།",
    "སྔ་ཕྱིར་བདེ་གཟར་གང་འདུག་གང་ཡོད་དུ་ཞུ་ཆིངས་གནང་བས་ཆེ་སར་ཞབས་འདེགས།",
    "བསམ་བཞིན་སྐྱོ་བ་སྐྱེ་ཡིན་གདའ།",
    "གསུང་བ་ཞིག་ཕྱག་བྲིས་ལ་བཀོད་པ་མཛད་འདུག།",
    "སླར་ཡང་དགོན་དུ་ཤར་རྒྱག་སུ་ལ་ཡང་སྔ་འཕྲོས་མེད་པར་ཕེབས་གྲུབ་འདུག་པས།",
    "ད་ནས་ཡོལ་ཕུའི་རི་ཁྲོད་རང་དུ་ཕྱོགས་ཀྱི་འགྲོ་འདུག་སྤངས་ཏེ་སྡོད་བསམས་རུང་།",
    "བཞུགས་གནས་ས་དམིགས་ལེགས་པར་བཙུག་ལག་ཁང་བསྟན་པའི་མིག་རྐྱེན་དུ་འགྱུར་བ་བཞེང་དགོས་པ་འདུག་པས།",
    "ཁྱེད་རང་དཔོན་སློབ་གྱི་མགོན་དབྱངས་གཅོད་འཕྲོར་ཡོད་པ་ཡང་གང་འགྲོ་བྱེད་དགོས་འདུག་པས་མགྱོགས་པ་ཞིག་ཕེབས་མཛོད་གསུང་བ་བྱུང་།",
    "ཉེར་དགུ་ལ་བསྐུལ་བ་མཛད་ལྟས་ལེགས་པ་རང་བྱུང་འདུག།",
    "འོད་གསལ་གྱི་རྟགས་སྣ་ཟིན་ཙམ་དུ་འདུག་གསུང་།",
    "ཡར་སྟོད་དུ་འཕྲལ་ཡུན་གྱི་མཐའ་སེལ་གནང་བར་འདུག་ཅིང་།",
    "ཨར་པོ་སྤུས་གཙང་བ་དང་གྲུབ་མྱུར་བའི་ཁྱད་ཀྱང་འདུག།",
    "ངེད་དང་ད་ལྟའི་སློབ་དཔོན་དྲུང་རམ་པ་སོགས་དང་མང་ཞིག་ཡོད་པས་གཞིས་བྱེས་ཀྱི་ཚོགས་ལ་མང་ཇ་བཟང་པོ་ཞིག་སྦྱར་འདུག་པ་གྲོལ་འཕྲལ།",
    "སྔར་མགོན་ཁྲིད་གསན་འདུག་པས།",
    "མདང་ཞག་བྱུང་བོ་རྣམས་བསྙེན་པའི་ལྟས་སུ་ངོས་བཟུང་ཆོག་ཙམ་ཡིན་པ་འདུག་གསུང་།",
    "དེ་དུས་གྲ་པ་སྟོང་ཕྲག་གཅིག་གསོག་ཟེར་བ་འདུག་ཀྱང་།",
    "སུམ་བརྒྱ་ལས་མི་ཉུང་བ་རང་འཛུད་རྩིས་འདུག།",
    "དེར་ཡང་གཟིམས་ཆུང་ཀ་བཞི་མ་ཡངས་པོ་ཞིག་འདུག་པ་དེར།",
    "ཚུལ་བསླབ་སྟོན་མང་པོ་གནང་བ་ལ་བཀའ་དྲིན་བསྐྱངས་ཞུས་འདུག་པས།",
    "དེ་དུས་གཡེང་རྐྱེན་ཟ་ཟི་མངས་པའི་ཨར་པོ་ཉོག་གེ་བ་འདུག་པས།",
    "རྟེན་ཆེན་ཞལ་སྒོ་ལ་འཕུལ་བཟོ་བྱེད་པའི་སྒང་ལ་འདུག།",
    "ངེད་ཚོ་འཐོགས་གཞི་ཆེ་ཡང་ད་ལེགས་པོ་མ་བྱུང་དོགས་མི་དགོས་པ་འདུག་ཟེར།",
    "ནན་ཏན་གྱིས་དག་པར་སྒྲུབ་ཏུ་འཇུག་པར་གནང་བས་ལེགས་པར་བརྟགས་ན་ཡིད་ཆེས་གཞན་ལས་ཕུལ་དུ་བྱུང་བར་འདུག་གོ།",
    "ནང་སེལ་ཞིག་ཡོད་འདུག་པའི་སྐྱོན་ཡིན་ནམ་ཐམས་ཅད་ཐུགས་འཁྲུག་པ་ཙམ་འདུག།",
    "དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་གྱི་རིང་བསྲེལ།",
    "མྱུར་བར་ཁོང་ཉིད་ལྔ་པའི་ལམ་དུ་ཞུགས་འདུག་ཟེར།",
    "བར་སྐབས་སུ་ཐོག་སྟེང་མའི་རྩེར་མཚན་དུས་བམ་བསྒྱུར་གྱི་སྒྲ་འཇིགས་ཤིང་སྐྱི་གཡའ་བ་མང་དུ་བྱུང་འདུག།",
    "ཡོལ་ཕུ་རི་གོང་དུ་བརླག་རྒྱག་བྱུང་འདུག་ཟེར་བའི་སྐད་ཆ་སླེབ་པ་དང་།",
    "དེར་ཡང་གྲྭ་ཚང་གསར་འཛུགས་ཀྱི་ལེགས་ཚོགས་ཀྱི་སྐབས་ཡིན་འདུག་པ་དང་།",
    "ཁྱད་པར་ལུང་རྣམས་མིག་ཚག་ན་མི་བདེ་བའི་སྐྱོན་གྱིས་འབུལ་དཀའ་བར་འདུག་པས་དགོངས་མི་ཁྲེལ་བ་མཁྱེན་ཅིང་།",
    "བདག་ཀྱང་ཡས་ཕྱོགས་སུ་ཡོང་གདོང་རྗེ་མཁན་ཆེན་བསམ་སྡིངས་སུ་ཕེབས་བཞུགས་གནང་འདུག་པའི་ཞབས་དྲུང་དུ།",
    "མ་སྤངས་བཀའ་ཕེབས་དང་འགལ་མེད་ཅིག་ཞུ་དགོས་རྒྱུར་འདུག་རུང་།",
    "དེ་མིན་ཡས་མས་ཀྱི་བྱེད་དགོས་འདི་རྣམས་ཀྱང་འཕྲལ་དུ་འཇོག་ཀྱང་དཀའ་འཛིན་ཀྱང་དཀའ་བ་ཞིག་འདུག་པས།",
    "གཞན་ཡང་མ་རུངས་པའི་སེམས་འཆང་བའི་ཆེ་ཕྲ་ཐམས་ཅད་ལ་བཀའ་ཆད་མྱུར་བར་ཡོང་བ་ལ་ཆེད་དུ་བསྐུལ་མི་དགོས་པ་ཞིག་འདུག་གོ།",
    "དེ་ཡང་རང་ཉིད་མའི་མངལ་དུ་ཆགས་པའི་ཚེ་མའི་རྨི་ལམ་དུ།",
    "ཁོ་བོ་ལ་ཨ་ཇོ་བི་རི་ཟེར་བས།",
    "བུ་ཚ་འདི་སྐུ་གཅོད་པ་འཐད་པར་འདུག་ཟེར་བས་ཉེ་བའི་རྐྱེན་དེ་ཁོ་ནས་བྱས་པར་སྣང་ངོ།",
    "དམག་ཟོར་མའི་སྤྲུལ་པ་ཡིན་པ་འདུག་ཟེར་བའི་འུད་བྱས་ཀྱང་ཆོག་པ་ཙམ་འདུག།",
    "དེ་ནས་ལ་འགར་སླེབ་ཙ་ན།",
    "གྲགས་པ་ཆེ་བ་འདོད་གསུང་རང་འདོད་ཞུ་མ་སྤོབས་པ་ལ་ཡོན་ཏན་ཆེ་བ་འདོད་ན་ཀླུ་སྒྲུབ་རྒྱ་མཚོ།",
    "དེ་ཡང་འདས་མ་འོངས་སུ་ཀླུའི་མིང་ཅན་ཅིག་ཡིན་པའི་མངོན་མཁྱེན་དུ་འདུག།",
    "ད་ཁྱེད་ལོ་བཅུ་གཉིས་ལས་སྡོད་ལོང་མ་འདུག་གོ་གསུང་དེ་ནས་བདག་གང་དུ་འགྲོ་བ་གདའ་ཞུས་པས།",
    "མ་འོངས་པ་ན་གདན་སའི་ལུང་བསྟན་ཡིན་ཟེར་བའི་སྒྲའུད་བྱས་ཀྱང་ཆོག་པ་ཙམ་འདུག།",
    "དེ་འཕྲལ་ཤོག་གསུང་ཁོང་སྤོབས་པ་མཐོ་སྟེ་ཁྱེད་ཡོན་ཏན་ཆེ་བ་འདུག་གོ་གསུང་།",
    "བྱི་བའི་ལོ་ཀུན་མཁྱེན་ལྕགས་ཐང་པ་ཆེན་པོ་དག་པའི་ཞིང་དུ་གཤེགས་པ་དེ་ལ་ལྟ་བ་འདུག།",
    "ཁྱེད་ལ་དུས་གསུམ་ཁེགས་པའི་ཡོན་ཏན་ཞིག་ཡོང་བ་འདུག་གསུང་།",
    "འབྲོག་པ་རྣམས་ཀྱི་ཤ་དམར་པོ་ནང་ལ་ཁུར་ཡོངས་ཙ་ན་ངེད་ལ་སྦེད་དགོས་པ་ཞིག་ཡོད་ཟེར་མཚམས་ཀྱི་སྐབས་དེ་ནས་གཉིད་ཀྱི་རྨི་ལམ་ན་སྔར་གྱི་སྣང་བ་དེ་འདྲ་ཤར་བ་ལ་འཇིགས་པའི་སྣང་བ་མེད་པར་བདེ་ཆམ་འགྲོ་བ་དང་།",
    "དགའ་ལྡན་དུ་བྱམས་མགོན་མཇལ་བ་ལ་འགྲོ་སྙམ་ཙ་ན་སྟེང་ཕྱོགས་ལིང་ལིང་འཕུར།",
    "ངས་ཀྱང་ཡིན་བྱས་བླངས་ནས་བལྟས་པས་བིརླ་པ་དང་གོང་མ་ལྔའི་བསྟོད་པ་པར་མ་ཁྲ་གསལ་ལེ་འདུག་པས།",
    "དེ་སངས་ཙ་ན་སྔས་མགོ་མཆི་མས་བངས་འདུག་པ་ཞིག་མཐོང་།",
    "གཞན་སྟོང་ཡིན་བྱས་ཀྱང་ཆོག་ཙམ་འདུག་ཀྱང་།",
    "བར་པ་གསུམ་སེམས་ཙམ་དུ་གནས་ཟེར་བ་སོགས་ཅལ་ཅོལ་དང་འར་འུར་མང་དུ་སྒྲོགས་པ་ཞིག་འདུག་ཀྱང་།",
    "ཁྱེད་ཀྱི་དེ་མ་གོ་བ་བརྒྱ་རྩ་རུ་མི་འདུག།",
    "རྩོད་ཟླ་ཐུགས་གཟུ་བོར་གནས་པ་རྣམས་ཀྱང་ཁྱེད་དང་བགྲོ་གླེང་བྱས་པས་བློ་སྐྱེད་མི་ཡོང་བ་མི་སྲིད་པ་འདུག་ཟེར་བ་ཁོ་ན་བྱུང་།",
    "འོན་ཀྱང་རང་གཞོན་ནུ་ནས་ས་པཎྜི་ཏ་མཚན་ཐོས་པ་ཙམ་གྱིས་བ་སྤུ་གཡོ་བའི་དགའ་སྤྲོ་བྱུང་བ་དང་།",
    "སྒོམ་ཤ་སྟག་བྱེད་པ་གང་དགའ་ཞེས་བརྟག་པ་ལན་གསུམ་ཙམ་བྱས་འདུག་ཀྱང་།",
    "ཡང་བདག་ལོ་ཉི་ཤུ་རྩ་གསུམ་ལོན་པའི་སྐབས་ཤིག་བོ་དོང་ཕྱོགས་ན་འབྲུམ་པ་འདུག་པས་བདག་དཔོན་ཆེན་བྱམས་པ་བློ་གྲོས་གཉིས་ཀྱིས་འབྲུམ་འཛེམ་འདར་དུ་ཟླ་བ་གཉིས་ཙམ་སྐྱིད་གཤོངས་དང་རུ་སྤྱི་གཉིས་སུ་བསྡད།",
    "ཁྱེད་རང་ཤེས་འདོད་ཆེན་པོ་འདུག་པས་ཐོག་མར་རྗེ་དཔལ་འབར་ལ་ན་རྒྱལ་མཚན་དྲུང་དུ་ནི་གུ་ཞིག་ཞུ་བ་ལ་ཕྱིན་ཆོག་གསུང་།",
    "ནག་པོ་ཚང་དུ་གོ་མེ་མཆེད་སྙམ་སྐེད་པ་ལ་གཟན་དཀྲིས་ནས་ལྟར་ཕྱིན་པས་ཐབ་ཁ་ནི་སྐམ་ཀྲོག་གེ་འདུག།",
    "ཚུར་ལོག་ནང་དུ་སླེབ་ཙ་ནའང་དུ་འཚུབ་མ་བསངས་བ་ཞིག་བྱུང་སྟེ་ཕྱི་རོལ་གྱི་དུ་བ་མ་ཡིན་པར་ནང་ནས་འོད་གསལ་དུ་བ་ལྟ་བུའི་ཉམ་ཤར་བར་འདུག།",
    "ལམ་འབྲས་པ་གཞན་རྣམས་གྱེལ་འགྲོ་ཡིན་འདུག།",
    "གཞན་ཡང་ངའི་མགོན་པོའི་མན་ངག་འདི་ཁྱེད་སྣོད་ལྡན་དུ་འདུག་པས་རྫོགས་པ་རང་གཅིག་བྱེད་དོ་གསུང་བཀའ་གནང་ཕེབས།",
    "སྐབས་ཤིག་ཁོ་བོ་ལ་ཤོག་གསུང་ཁྱེད་ལམ་འབྲས་པ་འདི་རྣམས་ཀྱི་ནང་ནས་ལམ་འབྲས་འཆད་མཁན་གཅིག་ཡོང་བ་འདུག་གོ་གསུང་བ་ཕེབས་ཏེ།",
    "ཁྱེད་རང་མཚན་ཉིད་པ་རྣམས་ཀྱི་སྐོར་ཐོངས་པ་དང་འདྲ་གསུང་པས་བཀའ་ལུང་དེ་མ་འོངས་མཁྱེན་པའི་མངོན་མཁྱེན་འདུག།",
    "དེ་ཙ་ན་ལམ་འབྲས་འཆད་ཐུབ་པ་ཡང་དཀའ་བ་འདུག།",
    "འདི་ཡང་མ་དག་པའི་ཞིང་ཡིན་པ་འདུག།",
    "མཚན་དུས་རྨི་ལམ་ཟིན་ཙ་ན་སྔགས་འདྲེན་པའི་འདུན་པ་བྱས་པས།",
    "གསེར་དཔོན་ལྔ་དར་གྱི་བུ་འདི་བསྟན་པ་ལ་ཕན་པ་ཞིག་ཡོང་བ་འདུག་གསུངས་ཟེར།",
    "བློ་གཟུར་གནས་རྣམས་དོན་གྱི་ཡོན་ཏན་འདུག་ཟེར་བར་ཐག་གཅོད་པ་བྱུང་།",
    "ཁོང་པ་རྒྱལ་བའི་རྒྱལ་ལུགས་ཀྱི་རྫུན་མང་པོ་བྲིས་འདུག་ཟེར་རོ།",
    "ཀུན་གྱི་རྒྱུད་མི་འཁྲུག་པ་གཡག་འཁྲུག་ལྟ་བུ་རྒྱུན་རིང་བྱས་ན་ཡོན་ཏན་གྱི་བཤན་མི་ཕྱེད་ཀ་མེད་ཡོང་བ་འདུག་ཟེར་བ་བྱུང་ངོ།",
    "བྱ་གཤོངས་ལུགས་ཀྱི་བར་ཤུན་གྱི་བགྲོ་གླེང་ཡང་ཤེས་པས་ཁྱེད་ཀྱི་ཁ་ཡ་བྱེད་པ་འཇིགས་པོར་འདུག་ཟེར་རོ།",
    "རྗེ་བློ་གསལ་རྒྱ་མཚོ་ལ་བདག་ཟླ་གཅིག་སྡོད་ལོང་ཡོད་བ་འདུག་པས།",
    "དེ་འདུས་ཀྱི་ཕྱག་དྲིལ་ཧོར་ལོག་ར་ལོག་རྩེ་ལྔ་མ་ཞིག་འདུག་པ་དེ།",
    "ང་དང་དཀར་བཅོལ་བཟང་པོ་བྱེད་ཀྱིན་འདུག།",
    "སྤྱིར་མཁན་སློབ་གཉིས་གཉིས་བྱས་པ་འདི་ལེགས་ཚོགས་ཆེ་རྒྱུ་ཡང་མི་ཡོང་འདུག་སྟེ།",
    "གཞན་མཐུན་མི་མཐུན་ཡོང་བའི་ཚད་དུ་མི་འདུག་གསུང་བྱུང་བས།",
    "ཁྱེད་འདི་ལྟ་བུ་ལ་དགྱེས་འདུག་གསུང་ནས་གཟིམས་ཆུང་མཆོད་གྲལ་ནས་གོང་མ་ལྔ་ཚར་གྱི་སྐུ་ཤིན་ཏུ་ལེགས་ཞིག་གནང་།",
    "ལན་གསུམ་པ་དེ་བདག་བྱ་གཤོངས་ན་ཡོད་པའི་སྐབས་སུ་གནང་བར་འདུག་སྟེ།",
    "གཞན་ནི་ཅི་ཡང་འགུལ་བ་མི་སྣང་དེ་ཡང་སྨིག་རྒྱུའི་ཉམས་ཡིན་པར་འདུག་སྟེ།",
    "ཡང་ལན་གཅིག་བླ་བྲང་ཀ་བཞི་མའི་ཀ་བ་བཞི་པོ་ཕར་ཡོམ་ཆུར་ཡོམ་བྱས་ཀ་བ་དང་གཞུ་བྲལ་འགྲོ་བ་སྙམ་བྱེད་པའི་ཉམས་ཤར་དེའང་སྨིག་རྒྱུའི་ཉམས་ཡིན་པར་འདུག།",
    "ས་སྐྱའི་གྲ་དགོན་གཞན་གང་ན་ཡང་དེ་འདྲ་ཡོད་པར་མི་འདུག།",
    "དེ་ག་རང་དུ་འདུག་སྟེ།",
    "དེ་ཡང་རིམ་གྲོ་དེ་པའི་ནུས་པ་ཡིན་པར་འདུག།",
    "ཡང་ནུབ་ཅིག་ལུང་པ་རྩ་བཟང་པོ་བྱས་པ་ཞིག་ན་གཡག་མང་པོ་འདུག་པ་དེ་རྣམས་འགྲངས་ཀྱང་ཤིན་ཏུ་སྐོམ་ཟེར་བ་བྱུང་སྟེ།",
    "ཡང་ནུབ་ཅིག་གཡག་རོག་པོ་ཞོལ་ཆེན་དར་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་ཞིག་འདུག་པ་དེ་ལ་ཞོན་པའི་འདུན་པ་བྱས།",
    "ནུབ་ཅིག་རྨི་ལམ་དུ་ཨ་ཇོ་ཐེར་སློག་གྱོན་ངོ་ནོང་ངེ་བྱས་བྱུང་བས་ཆགས་ཞེན་ཞིག་ཡོད་པ་འདྲ་སྙམ་ཨ་ཇོ་རང་ག་ལ་ཡང་ཆགས་མི་དགོས།",
    "མཆོད་གནས་འདྲ་ཡོད་བ་རྣམས་ཨ་ཇོ་མཐོ་རིས་སུ་སྒྲོལ་ཐུབ་པ་འདྲ་ཟེར།",
    "ཨ་ཇོའི་བུ་སྤུན་གཉིས་སོགས་གཉེན་འཁོར་ཀུན་གྱིས་འབྲུམ་པ་ཐར།",
    "ཁོ་བོས་རྗེས་ལ་ཡོངས་པས་བྱ་གཤོངས་མདུན་དེ་ན་ལོ་ཏོག་ཆེལ་ལེ་སྨིན་པ་ཙམ་འདུག།",
    "གནམ་གང་ལ་བྱེད་གསུང་པའི་སྒྲུབ་བྱེད་གསུངས་པའི་སྒྲུབ་བྱེད་ལྟར་སྣང་བ་མང་དག་མཛད་འདུག་པ་དང་།",
    "དེང་སང་མར་ངོའི་གསོ་སྦྱོང་འཇིག་རྟེན་ལུགས་ཀྱི་གནམ་གང་ལ་མཛད་པ་འདི་ཕྱག་ལེན་ལ་འདུག་གོ།",
    "ཐོག་འདི་སྤོ་ལེན་བྱེད་པ་ཚེགས་མི་འདུག་ཟེར་ཏེ།",
    "ཕྱིས་འདུ་ཁང་གསར་བཞེངས་གྲུབ་པའི་སྔ་ལྟས་སུ་འདུག།",
    "སྐུ་མདུན་ཞིང་དེ་ཐུགས་གཅག་དག་པོ་ཞིག་ཡིན་འདུག་པས་ངེད་དྲུང་ཆེན་གཉིས་ཆར་ལ་རྟ་དང་།",
    "སྤྲོ་སེག་ཤིན་ཏུ་ཆེ་བ་ཞིག་འདུག།",
    "ནང་ན་གདན་བཟང་པོ་བཏིང་མཆོད་གནས་དགའ་ལྡན་པའི་གནས་བརྟན་བགྲེས་པོ་ཞིག་འདུག།"
  ]
}