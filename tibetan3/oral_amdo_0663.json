    "གང་གླིང་ལས་སྐྱེས་ལ་སོགས་པ་རྣམས་ཀྱིས་བྷ་ར་ཏ་ལ་ས་མས་སོགས་པ་ལ་སྨྲས་པ་ནི་ཕལ་ཆེར་གཞན་དག་གིས་སྨྲས་པ་དེ་སྨྲ་བར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཐུན་མོང་མ་ཡིན་པ་ཞེས་བྱ་བ་ནི་གཞན་དག་གིས་མ་སྨྲས་པའོ།",
    "རང་གི་ཐུགས་སུ་ཆུད་ནས་ཞེས་བྱ་བ་ནི་རང་ཉིད་ཀྱིས་གཞན་གྱིས་རྗེས་སུ་བསྟན་པ་ལ་མ་ལྟོས་པར་ཐུགས་སུ་ཆུད་པ་སསྟེ།",
    "ཁྱོད་ཀྱིས་བསྒྲགས་ནས་སེངྒེ་ཡི།",
    "གཅེར་བུ་པའི་དགེ་སྦྱོང་གི་སྐར་མའི་བསྟན་བཅོས་དགེ་སྦྱོང་གཅེར་བུ་པ་མ་ཡིན་པ་ལ་མི་སྦྱིན་པ་དང་།",
    "ཁྱབ་འཇུག་པའི་མཚན་མོ་ལྔ་པ་ལ་སོགས་པའི་བསྟན་བཅོས་རྣམས་ནི་གཞན་དག་ལ་སྨྲ་བར་མི་བྱའི།",
    "ཡོངས་སུ་ཆགས་ཀྱི་གཙོ་ཁྱོད་ཀྱི།",
    "དེ་འདི་ལྟ་བུའི་དཀའ་ཐུབ་སྤྱོད་པ་ལས་ནི་བདག་ཅག་རྣམས་ཀྱིས་བགེགས་བྱེད་པར་ནུས་པར་འགྱུར་དུ་འོང་གི་མ་ལ་བདག་ཅག་གིས་འདི་དཀའ་ཐུབ་ལས་ཉམས་པར་བྱའོ་སྙམ་ནས་དཔྱིད་ལྡན་མ་ཞེས་བྱ་བའི་ལྷའི་བློབུ་མོ་དེར་བཏང་བ་དང་།",
    "ལྷ་མོ་དེ་མཐོང་བ་ཙམ་གྱིས་འདོད་ཆགས་རག་བསགས་ལས་སམ་ཏུ་གཡོས་པས་ཡིད་གདུངས་ཤིང་གཟིར་བར་གྱུར་པས་དེ་བླངས་ཏེ་ལོ་མའི་སྤྱིལ་བུར་ཞུགས་ནས།",
    "དུས་ཤིན་ཏུ་ཡུན་རིང་མོར་དེ་དང་ལྷན་ཅིག་འདོད་པའི་བདེ་བ་ལ་ལོངས་སྤྱད་པ་རྗེས་སུ་མྱོང་བར་གྱུར་ཏོ།",
    "དེ་ལྟར་ན་བྷ་ར་དྷ་ཛ་ཞེས་བྱ་བ་དེ་ནི་དཔྱིད་ལྡན་མ་ཞེས་བྱ་བའི་ལྷའི་བུ་མོ་ལ་ཡོངས་སུ་ཆགས་ཤིང་ཞེན་པ་དང་ལྡན་པ་ཡིནནོ།",
    "གཙོ་ཁྱོད་ཅེས་བྱ་བ་ནི་བོད་པ་སྟེ།",
    "ཁྱོད་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མགོན་པོ་ཁྱོད་ནི་ཐུགས་རྗེ་ཡིས།",
    "ཀྱེ་མགོན་པོ་སྐྱབས་སུ་གྱུར་པ་ཁྱོད་ཀྱིས་ནི་ཁྱིའི་བར་ལའང་སྦྱིན་པར་བྱའོ་ཞེས་གསུངས་སོ།",
    "གང་ཞིག་སྐྱེ་བོ་དམན་དང་ཕོངས་པ་རེ་བའི་བསམ་ལྡན་མཐོང་ན་ཡང་།",
    "དེ་སླད་ཁྱོད་ནི་ཐུགས་རྗེས་སློང་བ་རྣམས་ལ་སྦྱིན་པར་བཞེད་ལ་ཞུགས།",
    "ཁྱོད་ནི་ཐུགས་ཀྱི་དཀའ་ཐུབ་ཀྱིས།",
    "ལུས་ཀྱི་དཀའ་ཐུབ་ནི་ཉོན་མོངས་པའི་གདུང་བ་ཞེས་བྱ་བའི་དོནཏོ།",
    "ཉོན་མོངས་པའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཉོན་མོངས་པ་ཟད་པར་བཞེད་པ་ལགས་ཀྱི།",
    "བདག་ཉིད་ཉོན་མོངས་སྐྱེ་བོ་བྱིས་པ་འདོད།",
    "གང་གི་ཕྱིར་ཀུན་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་གནས་ཡིན་པས་སེམས་ཉིད་གནོད་པ་ཐམས་ཅད་བྱེད་པ་ཡིན་ལ།",
    "དེ་བས་ན་དེ་ཉིད་ཅི་ནས་ཀྱང་ཕྱིས་ཉོན་མོངས་བསམ་མམསམས་ས་ས་བསགས་པས་ས་མཆ་ཅ་ས་པ་ས་ཀ་ཀ་ནན་ཐལགཅགསལ་བསམས་སམ་བདམས་༥ ཡས་མས་ལས་པས་ཐབས་། པ་རྣམས་ཀྱི་རྟེན་དུ་གྱུར་པ་མི་བྱེད་པ་དེ་ལྟར་ཡོངས་སུ་སྦྱང་བར་བྱ་སྟེ།",
    "གནས་མེད་པ་ལས་ནི་ཉོན་མོངས་པ་སྐྱེ་བར་མི་འགྱུར་ལ།",
    "ཉོན་མོངས་པ་མེད་པར་ལས་རྣམས་མི་འབྱུང་ཞིང་དེ་དག་མེད་པ་ལས་ནི།",
    "དེ་ཡང་ཕྱིན་ཅི་ལོག་གི་མིག་དང་།",
    "དེ་ཡང་གང་བ་ལང་གི་རྒྱུ་ལས་བྱུང་བ་ནི་འོ་མའི་རྒྱུ་ཡིན་ཏེ།",
    "དེ་བས་ན་བ་ལང་གི་ལྕི་བ་ཡང་འོ་མའི་རྒྱུ་ཡིན་ནོ།",
    "འདིར་མི་ཤེས་པ་དག་ནི་འོ་མའི་རྒྱུར་བ་ལང་གི་ལྕི་བ་ཉིད་ཡིན་པ་མི་སྲིད་དུ་ཟིན་ཀྱང་དེ་ལྟ་དེ་ལྟར་ཁས་ལེན་པ་ལ་དགའ་བར་འགྱུར་ལ།",
    "དེ་ཡང་གང་དང་གང་གི་བྱ་བ་དམིགས་སུ་ཡོད་པ་དེ་ནི་ཡོད་པ་ཡིན་ཏེ།",
    "དཔེར་ན་རི་བོང་གི་རྭ་དང་འདྲའོ།",
    "བདག་གི་བྱ་བ་ཡང་བྱེད་པ་པོ་དང་།",
    "ཁྱོད་ནི་མྱ་ངན་འདས་བརྙེས་ལ།",
    "གང་གི་ཕྱིར་མི་གཙང་བའི་ཕུང་པོ་ཆེན་པོ་ཡང་མི་གཙང་བ་ཡིན་ཞིང་།",
    "དེ་ལྟར་ན་གང་སྲིད་པའི་རྩེ་མོའི་ཕུང་པོ་དེ་ཡང་སྐད་ཅིག་མ་རེ་རེ་ཞིང་འདུ་བྱེད་དང་ལྡན་པའི་ཕྱིར།",
    "རྒྱལ་པོ་སྐྱེད་པ་པོའི་མན་ངག་གིས་རྫུ་འཕྲུལ་ཐོབ་ནས་ནམ་མཁར་འཕགས་ཏེ།",
    "ཉོན་མོངས་ཟད་པས་ཞི་བ་ཁོ་ནར་ཟད།",
    "ནེ་ཙོས་ལམ་གཉན་སོང་བར་གྱུར།",
    "ཁྱོད་ནི་ལམ་གང་ནས་གཤེགས་པ།",
    "རྣལ་འབྱོར་གྱི་ལམ་ལ་སློབ་དཔོན་ཉིད་ཐོབ་ནས་དུས་ལ་བབ་ཅིང་ལུས་དང་བྲལ་ནས་མྱ་ངན་ལས་འདས་པ་ང་སོང་ལ།",
    "ཁྱབ་འཇུག་དག་གིས་བུད་མེད་ནི།",
    "སྟོན་པ་འཇིག་རྟེན་འདས་ཁྱོད་ལ།",
    "བདག་གི་མེད་ཅིང་ཡོངས་འཛིན་མེད།",
    "བུད་ཨ་མ་ཡང་དག་མ་དག་ལས་ས་བསམབསམ་པས་བསགས་སམ་མ་བསམས་པ་དང་མ་ཡས་ཡས་ཡས་མས་ཨ་མས་བསམས་པས་ས་པགས་པས་ན་མསསངས་གསལ་ཁག་གསལ་། མེད་སྟོང་ཕྲག་དྲུག་ཅུ་ནི་བུད་མེད་གྲངས་དེ་སྙེད་པའོ།",
    "བདག་གི་མེད་ཅིང་ཞེས་བྱ་བ་ནི་རྣམ་པ་མེད་པར་གྱུར་པ་དེ་ནི་བདག་གི་མེད་པའོ།",
    "འདིས་ནི་འཇིག་ཚོགས་ལ་ལྟ་བ་སྤངས་པའི་སྒོ་ནས་ཉོན་མོངས་པ་དང་བྲལ་བ་ཉིད་དུ་སྟོན་ཏོ།",
    "ཡོངས་འཛིན་མེད་ཅེས་བྱ་བ་ནི་བཙུན་མོ་ལ་སོགས་པ་དང་འབྲེལ་བའམ།",
    "འདིས་ནི་ཉོན་མོངས་པའི་དངོས་པོ་སྤང་བ་ཉིད་དུ་སྟོན་ཏོ།",
    "དེ་ཡང་ཉོན་མོངས་པའི་དངོས་པོ་ལ་ཡོངས་སུ་འཛིན་པ་མེད་པས་ན་དེ་སྐད་ཅེས་བྱའོ།",
    "ཀཱཤི་མཛེས་དགའ་མོ་ལ་ནི།",
    "ཁྱོད་ཁབ་བཞུགས་ནའང་ཕུང་ཁྲོལ་བའི།",
    "བྷ་ར་ཏའི་འཐབ་མོ་འདས་ནས་ཡུན་རིང་པོ་མ་ལོན་པ་ན།",
    "ཡོངས་སུ་འཁྱམས་ཤིང་ཝཱ་རཱ་ཎ་སཱིར་སོང་བ་དང་།",
    "དེ་ལྟད་མོ་ལ་ཞེན་པའི་ཡིད་ཀྱིས་དེའི་ཐད་དུ་སོང་སྟེ་དྲིས་པ།",
    "འདི་སུ་ཞིག་གི་ཁྱིམ་ཡིན་ཞེས་དྲིས་ནས།",
    "དེ་ནས་མངག་གནུག་པའི་སྐྱེ་བོ་ཞིག་གིས་ག་ཤི་མཛེས་དགའ་མོ་ལ་སྨྲས་པ།",
    "དེ་ཡང་དམོད་པས་འཇིགས་ཤིང་སྐྲག་ནས་མཆོད་ཡོན་དང་།",
    "དེ་ནས་དེས་ཇི་ལྟར་ནའདོད་པའི་སྐྱེ་བོ་ཁྱད་པར་ཅན་དུ་མ་དང་རེག་པར་གྱུར་ཀྱང་དེ་ལྟ་གལབུའི་རེག་པ་སྔོན་ཆད་ཉམས་སུ་མྱོང་བར་མ་གྱུར་པ་དེ་ལྟར་ཚོར་བར་བྱས་སོ།",
    "ཀཱཤི་མཛེས་དགའ་མོ་ལ་སྟེ།",
    "སྨད་འཚོང་མའི་གཙོ་མོ་ལའོ།",
    "རྣམ་པར་འགྱུར་ཞེས་བྱ་བ་ནི་དུས་ཤིན་ཏུ་ཡུན་རིང་མོར་ཡང་འདོད་པ་རྗེས་སུ་མྱོང་བས་རྣམ་པར་འགྱུར་པ་ཉིད་དུ་གྱུར་པའོ།",
    "ཁྱོད་ཁབ་བཞུགས་ནའང་ཞེས་བྱ་བ་ནི་རབ་ཏུ་མ་བྱུང་བ་ན་ཡང་ངོ།",
    "བུད་མེད་ཀྱི་ནི་རྡོག་པས་བསྣན།",
    "བུད་མེད་ཀྱི་རྡོག་པས་བསྣུན་ཞེས་བྱ་བ་ནི་བུད་མེད་ཀྱི་རྡོག་པ་དག་སྟེ།",
    "དེ་ཡང་འདི་ལྟར་དྲང་སྲོང་རྒྱས་པ་ཀ་ཤི་མཛེས་དགའ་མོ་དང་ལྷན་ཅིག་བག་ཕེབས་པར་འདོད་པའི་བདེ་བ་རྗེས་སུ་མྱོང་ཞིང་འདུག་པ་ན།",
    "གང་གི་ཕྱིར་གཞོན་ནུ་རྣམས་ཀྱང་ཉིན་གཅིག་ལ་འོབས་ཁྲུ་བཅུ་བཅུ་སྐོར་བཅུག་པའི་ལུང་བསྒོ་བ་ན་གཞན་དག་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "དེ་ནས་ཀ་ཤི་མཛེས་དགའ་མོ་ལའང་ལུང་བསྒོ་བ་དང་།",
    "རྒྱས་པས་སྨྲས་པ་ཅིའི་ཕྱིར་ཁྱོད་མི་དགའ་བར་བྱེད།",
    "ཏོག་ཙེ་དང་སྐོན་པ་བྱིན་ཅིག་ངས་འོབས་བརྐོ་བར་བྱའོ་ཞེས་སྨྲས་ནས་ཇི་ཙམ་ན་སོང་སྟེ།",
    "ཆུ་ཚོད་ལ་སོགས་པའི་མཚན་མས་ཉིན་མོ་རྫོགས་པར་གྱུར་ཅིད།",
    "ཇི་ཙམ་ན་བྲམ་ཟེ་གཞན་ཞིག་གིས་འོབས་བརྐོ་བ་ལ་གཡེངས་པའི་སེམས་ཀྱིས་རྒྱས་པ་མཐོང་བ་དང་།",
    "ཡུན་རིང་མོ་ཞིག་ན་ངོ་ཤེས་པར་གྱུར་ཏོ།",
    "དེ་ཡང་དམོད་པས་འཇིགས་ཤིང་སྐྲག་པ་དང་།",
    "འདིས་ནི་ཀཱཤི་མཛེས་དགའ་མོའི་སྐལ་བ་རྐོ་བར་ཤེས་ནས་དེ་ལ་ཕྲིན་དུ་བསྐང་བ།",
    "དེས་བུ་མོ་མངག་གཞུག་མ་ཞིག་ལན་གསུམ་གྱི་བར་དུ་བཏང་ཡང་དེ་ལངས་སུ་མ་འདོད་དོ།",
    "གང་གི་ཕྱིར་ད་ནི་སྐྱོ་བར་གྱུར་པས་ངས་ས་མ་ཡ་ས་ལན་གསུམ་གྱི་བར་དུ་ཕྲིན་བསྐུར་ན་ཅིའི་ཕྱིར་ལྡང་བར་མི་བྱེད།",
    "གང་གི་ཕྱིར་འདི་ལྟར་རབ་ཏུ་བརྩེ་བས་ན་ཤིན་ཏུ་རྗེས་སུ་བཟུང་བ་ཡིན་ནོ།",
    "ཡང་ཁྱེད་ནི་ཁྱིམ་པར་བཞུགས་པ་ནའང་ཞེས་བྱ་བ་ནི་བཙུན་མོའི་འཁོར་སྟོང་ཕྲག་དྲུག་ཅུས་ཡོངས་སུ་བསྐོར་དུ་ཟིན་ན་ཡང་།",
    "འདི་ལྟར་བཙུན་མོ་ལ་ཡིད་རྣམ་པར་བསྐྱོད་སས་ལས་བསམ་མས་མས་མ་སས་ས་མས་མས་སསགས་ས་སར་ས་ས་ཨ་ཡ་ལ་ས་མས་ལ་ས་མ་ས་ལ་ས་མ་ས་ལ་ས་མ་ས་ལ་ས་མ་ས་ལ་ས་མ་འདས་པ་དག་པས་པས་མ་མཔའང་མེད་ན་འདི་ལྟ་བུའི་གནས་སྐབས་སུ་འགྱུར་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་མི་སྲིད་པ་ཉིད་དུ་སྟོན་པ་ཡིནནོ།",
    "ཁྱོད་ཀྱིས་བུད་མེད་སྟོང་ཕྲག་ནི།",
    "རྒྱལ་པོ་ཤིང་རྟ་ཡས་མས་ནས་གསལ་བཅུ་པའི་བཙུན་མོ་གཞོན་པ་ཀེ་ཀེ་ཡི་ཕྲག་དོག་གིས་དགའ་བྱེད་ལོ་བཅུ་གཉིས་ཀྱི་བར་དུ་ནགས་སུ་བརླངས་པར་གྱུར་ཏོ།",
    "སླར་ཡང་རང་གི་ཆུང་མ་ལོན་པའི་དོན་གྱི་ཕྱིར་དུ།",
    "ད་ཡམས་ཡས་མས་མས་ཡཡས་ཡས་ཡ་ས་མ་ཡ་མ་མ་། ཁྱབ་འཇུག་གིས་ནི་གནོད་པ་བརྩམསཔར།",
    "ཁྱོད་ཀྱིས་སྲོག་ཀྱང་བཏང་བར་མཛད།",
    "ཀུན་ཏི་བོ་ཛ་ཞེས་བྱ་བའི་རྒྱལ་པོ་ཞིག་ཡོད་གཡབས་ལམ་མཟཔ་དེ་ལ་ཀུན་ཏི་ཞེས་བྱ་བའི་བུ་མོ་གཟུགས་དང་ལང་ཚོ་ལ་སོགས་པ་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡོད་པ་དང་།",
    "སྐད་ཅིག་མ་དེ་ཉིད་ལ་ཉི་མ་ཤིང་རྟ་དང་བཅས་ཤིང་གོ་ཆ་དང་ཆག་ཆག་གཏརྩམསམས་ས་ཨ་མ་ནས་ཨ་སས་མམ་པ་མ་བསམས་པ་ལས་མ་གཡས་མས་ཡབ་མས་བསམ་བཅས་པར་དྲུང་ན་འདུག་པ་དང་།",
    "ཡང་ན་ཁྱེད་ཀྱི་རིགས་མ་ལུས་པ་རྣམ་པར་བརླག་པའི་དམོད་པ་གདབ་པར་བྱའོ།་",
    "ཇི་ལྟར་ན་རང་གི་རིགས་སུན་པར་བྱེད་ཅེས་སྨྲས་པ་དང་།",
    "སླར་ཡང་གཞོན་ནུ་ཉིད་དུ་གྱུར་པའི་མཆོག་བྱིན་ནས་དེ་དང་ལྷན་ཅིག་འདོད་པའི་བདེ་བ་སྤྱད་ནས་ཉི་མ་སོང་ངོ།",
    "ཇི་ཙམ་ན་གྲོགས་མོ་ཞིག་གིས་སྦྲང་རྩི་དང་མང་གྱིས་ཁ་བཀང་སྟེ་ཤིན་ཏུ་འཇམ་པའི་གོས་ཀྱིས་ལུས་དཀྲིས་ནས་སྒོམ་གྱི་ནང་དུ་བཅུག་སྟེ།",
    "དེ་བླངས་ནས་གངྒའི་ངོགས་སུ་མཚན་མོ་སོང་སྟེ་ཉི་མའི་བུ་ནི་མཛེས་པ་ཡི།",
    "གངྒཱ་དང་ཐག་མི་རིང་བ་ན་ཡུལ་འཁོར་སྲུང་གི་རྟའི་སྤྱན་ལྷག་པའི་ཤིང་རྟ་ཞེས་བྱ་བ་རྟ་འཚོ་ཞིང་འདུག་པས་གངྒའི་ཆུ་བོས་སྒྲོམ་ཁྱེར་ཞིང་འགྲོ་བ་མཐོང་བ་དང་།",
    "དེའི་གན་དུ་སོང་ནས་བྲམ་ཟེའི་མཚོན་ཆའི་སྦྱོར་བ་བསླབས་སོ།",
    "དེས་མཚོན་ཆའི་སྦྱོར་བ་ལེགས་པར་བསླབས་ནས་འཐབ་དཀའི་ཐད་དུ་སོང་སྟེ།",
    "ད་ནི་འཐབ་པའི་དུས་དང་ཉེ་བར་གྱུར་གྱི་རྣ་ཅན་འདི་དང་སྲིད་སྒྲུབ་རྩོད་པ་བྱེད་པར་འགྱུར་རོ་སྙམ་ནས་བརྒྱ་སུམ་ཅུ་ཐམ་པ་བབྱིན་བྲམ་ཟེའི་ཆ་ལུགས་སུ་བྱས་ཏེ་རྣ་ཅན་གྱི་གན་དུ་སོང་ངོ།",
    "ཁྱོད་ཀྱི་གོ་ཆ་འདོད་དོ་ཞེའོ།",
    "ཅིའི་ཕྱིར་སྡར་ཁྱེད་མི་སྨྲ་ཐེ་ཚོམ་མེད་པར་ཁྱོད་ལ་སྦྱིན་པར་བྱའོ་ཞེས་སྨྲས་ནས།",
    "གང་གིས་སློང་བ་མགུ་བྱའི་ཕྱིར།",
    "རང་གི་སྲོག་ལའང་མི་དཔྱོད་པར།",
    "འདི་དག་གི་ལས་གཏམ་ནི་ཤིན་ཏུ་མང་མོད་ཀྱི།",
    "ཡནལག་བཀྲ་སྦྱིནནི་དྲི་ཟའི་རྒྱལ་པོ་ཡན་ལག་བཀྲ་སྦྱིན་ཞེས་བྱ་བས་མིང་གི་འཁོན་གྱིས་གཡུལ་ངོར་བསད་དོ།",
    "ཡུ་བུ་ཅག་གི་རབས་ཆད་པར་འོང་བས་བུ་སྐྱེད་པའི་རྩོལ་བ་གྱིས་ཤིག་དེས་སྨྲས་པ།",
    "ངེད་གཉིས་སྤུན་ཡིན་མོད་ཀྱི།",
    "སྐྱ་བསེང་གིས་ས་ཆེན་པོ་ཀུན་མས་བསག་ས་པ་བསམ་བསམ་གང་བསམ་ཕམསམཡས་། ཏུ་རྒྱལ་བར་བྱས་ཏེ།",
    "གུང་གིས་འབྲས་བུ་ཆུང་འགྱུར་བ།",
    "སྐྱ་བསེང་ནི་ནགས་སུ་དཀའ་ཐུབ་ལ་སོང་ངོ།",
    "སྲིད་སྒྲུབ་ཀྱིས་དཔུང་གི་ཚོགས་ཐམས་ཅད་ལ་བལྟས་ནས།",
    "བདག་གི་ལུས་ནི་ཞུམ་གྱུར་ཅིང་།",
    "གང་གི་དོན་དུ་རྒྱལ་སྲིད་དང་།",
    "ཇི་ཙམ་ན་ཁྱབ་འཇུག་གིས་དེ་སྤྲོ་བ་དང་བྲལ་བར་མཐོང་བ་དང་།",
    "གང་གིས་འདི་ཀུན་རྒྱལ་འགྱུར་བ།",
    "དེའི་ཚིག་གིས་རྗེས་སུ་འབྲངས་ཏེ་སྲིད་སྒྲུབ་ཀྱིས་གཡུལ་བཀྱེ་བ་ནས་སྲོག་ཆགས་བརྒྱ་སྟོང་དཔག་ཏུ་མེད་པ་བསད་པར་གྱུར་ཏོ།",
    "ཁྱབ་འཇུག་གིས་ནི་སྒྱུ་བྱས་ནས།",
    "ཁྱབ་འཇུག་གིས་སྒྱུ་བྱས་སཔའི་གཏམ་གང་ཡིན་པ་དེ་ནི་སྔར་ཁྱབ་འཇུག་མིའུ་ཐུང་གཟུགས་བསྒྱུར་ནས།",
    "དེ་བ་ལང་གི་ཚོགས་ཀྱི་གནས་སུ་སོང་བ་དང་།",
    "ངན་སྤོང་གི་རིགས་ལས་བྱུང་བའི་དགའ་བྱེད་ཀྱིས་ཕ་རོལ་གནོན་པ་དང་།",
    "སའ་སྐྱེས་ནས་བསྟི་གནས་སུ་སོང་སྟེ།",
    "བརྟུལ་ཞུགས་ཅད་མ་ནི་ངང་ཚུལ་བཟང་པོ་ཅན་ཡིན་པས་འདེ་མེ་ཏོག་འཐུང་སོང་བ་ན་པསཤིང་རྣམས་རང་ཉིད་འདུད་པར་བྱེད་དོ།",
    "དེས་ཀྱང་བདག་གི་མ་སླར་འཚོ་བར་མཛོད་ཅིག་པའི་མཆོག་བསླངས་ནས་དེ་འཚོ་བར་གྱུར་ཏོ།",
    "བདག་གིས་འཇིག་རྟེན་དུ་རྒྱལ་རིགས་གཅིག་ཀྱང་མེད་པར་བྱའོ།",
    "དེ་ཡང་འདི་ལྟར་ཁྱོད་ཀྱི་བསྟན་པ་ལ་སྲོག་ཆགས་གྲོག་སྦུར་ཙམ་བསད་པ་ཡང་སྨད་པར་བྱ་བའི་གནས་ཡིན་ན།",
    "གང་གི་ཕྱིར་ནི་གཡུལ་བཀྱེ་བའི།",
    "དཔལ་དེ་ཁྱོད་ཀྱིས་འཁྲི་ཤིང་ནི།",
    "གང་གི་ཕྱིར་ནི་གཡུལ་བཀྱེ་བ་ཞེས་བྱ་བ་ནི་རྒྱལ་སྲིད་ཀྱི་དཔལ་གང་གི་དོན་དུ་གཡུལ་འགྱེད་ཅིང་འཐག་པར་བྱེད་པའོ།",
    "བཅོམ་ལྡན་འདས་ཉེས་པར་སྤྱོད་པའི་སྦྲུལ་གྱི་དུག་གིས་རྨས་ཤིང་།",
    "ཐང་ཤིང་ནགས་ན་ཞེས་བྱ་བ་ནི་ཐང་ཤིང་གི་ནགས་ཚལ་ཏེ།",
    "ཁྱོད་ཀྱིས་འབྲས་བུ་མཆོག་བརྙེས་པའི།",
    "ཡང་ཁྱོད་ཀྱི་ཡོན་ཏན་གྱི་གྲགས་པ་ནི་བརྒྱ་བྱིན་ཉིད་སྒྲོགས་ཤིང་གསལ་བར་བྱེད་དོ།",
    "ཁྱོད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།་",
    "བྱེད་འཐོམས་གྱུར་ནས་ཀུན་གཏོང་གི།",
    "གཙོ་ཁྱོད་ཀུན་ཏུ་བསྙེངས་མི་མངའ།",
    "བརྩོན་པ་ནི་ཁྱབ་འཇུག་གིས་དེའི་བརྩོན་པ་མི་བཟོད་པས་གསོད་པའི་ཐབས་ལ་བརྩོན་པར་བྱེད་དོ།",
    "ཇི་ཙམ་དུ་དུས་གཞན་ཞིག་གི་ཚེ་ཁྱབ་འཇུག་འཁོར་ལོ་ཐོགས་ཏེ།",
    "ནག་ཁྲ་བོའི་གན་དུ་སོང་ནས་དེ་དང་ལྷན་ཅིག་འཐབ་པ་ལ་ཞུགས་པ་དང་།",
    "གཞན་གྱི་བརྙས་པ་ཆེན་པོ་འདི་ལྟ་བུ་སུ་ཞིག་གིས་བཟོད་པར་ནུས་ཞེས་སྨྲ་ཞིང་།",
    "ཀུན་གཏོང་ཁྲིའི་འོག་ཏུ་ཞུགས་པར་གྱུར་ཅེས་བྱ་བ་ནི་ལྷ་མ་ཡིན་ཀུན་གཏོང་གི་ཁྲིའི་འོག་ཏུ་འཇིགས་པས་ཞུགས་པར་གྱུར་པའོ།",
    "གཙོ་ཁྱོད་ཅེས་བྱ་བ་ནི་བོད་པ་སྟེ།",
    "བུ་མོ་དང་ནི་འཁྲིག་ཅེས་ཐོས།",
    "ཇི་ཙམ་ན་བུ་མོ་བརྟུལ་ཞུགས་བཟང་མོ་ཞེས་བྱ་བ་གཟུགས་ལ་སོགས་པའི་ཡོན་ཏན་རྣམས་ཀྱིས་ལྷའི་བུ་མོ་གཞན་རྣམས་ཟིལ་གྱིས་མནན་ནས་གནས་པ་ཞིག་སྐྱེས་ཏེ།",
    "གང་གིས་ན།",
    "ངས་འདི་ལྟ་བུ་འབྱིན་ཅིང་སྐྱེད་པར་མི་ནུས་སོ་སྙམ་མོ།",
    "དེ་ནས་དེ་བླངས་ཏེ་ཚངས་པའི་འཇིག་རྟེན་དུ་སོང་བའི་བར་དུ་སྦྱར་རོ།",
    "ངའི་བུ་མོ་དཔལ་མོ་ཡང་ཟཟིལ་གྱིས་གནོན་པ་འདི་ལ་ལྟོས་ཤིག་ཅེས་སྨྲས་ནས་དེ་ཉིད་དུ་འདུག་གོ།",
    "རང་གི་ཡིད་འཛིན་པར་མ་ནུས་ནས་དེ་དང་ལྷན་ཅིག་ལོག་པར་ཞུགས་སོ།",
    "དེའི་འོག་ཏུ་གཟུགས་དང་མཐུན་མཐུན་དུ་རང་རང་གི་བུ་ཡོངས་སུ་བླངས་བར་གྱུར་ཏོ།",
    "བུ་མོ་ནི་བདག་ཉིད་ཀྱིའོ།",
    "ཐུབ་པ་ཁྱོད་ཅེས་བྱ་བ་ནི་བོད་པའོ།",
    "ཞེས་པའི་འང་གི་སྒྲ་ལས་ཤེས་པར་བྱའོ།",
    "ཁྱོད་ཀྱིས་བྱས་ཆུད་མི་ཟ་དང་།",
    "ཁྱོད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "ལེགས་པར་སྤྱོད་པ་དང་ཉེས་པར་སྤྱོད་པ་བྱས་ནས་རྣམ་ཁམསམ་མཔར་སྨིན་པ་མ་སྨིན་པར་ཆུད་ཟ་བར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཉེས་པར་སྤྱོད་པ་མ་བྱས་པ་དང་ནི་ཕྲད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་གལ་ཏེ་གཞན་གྱིས་བྱས་པ་གཞན་སྤྱོད་པར་འགྱུར་ན་ནི།",
    "གལ་ཏེ་རང་གི་རྟོགས་པ་གཞན་ལ་སྐྱེ་ན་ནི་བསྟན་བཅོས་ལན་གཅིག་ཐོས་པས་བསྟན་བཅོས་ཐམས་ཅད་འཛིན་ཅིང་ཤེས་པར་ཇི་ལྟར་མི་འགྱུར།",
    "རང་གིས་ཐོབ་པས་བྱས་ཆུད་མི་ཟ་ཞིང་།",
