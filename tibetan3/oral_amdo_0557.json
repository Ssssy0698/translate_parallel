    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འདོད་ཆགས་དང་བྲལ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འགག་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བས་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འདོད་ཆགས་དང་བྲལ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འགག་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བས་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འདོད་ཆགས་དང་བྲལ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འགག་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བས་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འདོད་ཆགས་དང་བྲལ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་། ཚོར་བ་འགག་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རེག་པ་བས་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རེག་པ་འགག་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རེག་པ་མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་བས་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་འདོད་ཆགས་དང་བྲལ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་འགག་པར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སློབ་པ་ལགས་སམ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་མི་སྐྱེ་བར་བགྱི་བའི་སླད་དུ་སློབ་ན།",
    "རེག་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རེག་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རེག་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རེག་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སློབ་པ་ཡིན་ནམ་སྣའི་འདུས་ཏེ་རེག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "སྣའི་འདུས་ཏེ་རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "སྣའི་འདུས་ཏེ་རེག་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "སྣའི་འདུས་ཏེ་རེག་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སློབ་པ་ཡིན་ནམ་ལྕེའི་འདུས་ཏེ་རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སློབ་པ་ཡིན་ནམ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་འདོད་ཆགས་དང་བྲལ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་འགག་པར་བྱ་བའི་ཕྱིར་སློབ་ན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་མི་སྐྱེ་བར་བྱ་བའི་ཕྱིར་སློབ་ན།",
