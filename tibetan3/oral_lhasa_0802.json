    "དེ་ཉིད་ཀྱི་ཕྱིར་ཕྱི་ནས་གསུངས་པ་ནི་བདག་དང་གཞན་གྱི་དོན་དུ་གྲུབ་པ་དམ་ཚིག་དང་སྡོམ་པའི་སྒོ་ནས་ཡིན་ཏེ།",
    "དགོངས་པ་དང་དགོངས་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདི་ནི་རྒྱན་རྣམ་པ་བདུན་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་བ་ཁོ་ནའོ་ཞེ་ན།",
    "སྨྲ་བའི་རྒྱན་ནི་སོ་སོར་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཇི་སྲིད་སྨྲ་བ་པོ་མེད་པ་དེ་སྲིད་དུ་སྒྲ་དང་དོན་བསྒྲུབ་པར་མི་ནུས་ཏེ།",
    "དེ་ཡང་གཞི་མེད་པར་ནི་མ་ཡིན་ཏེ།",
    "ཉན་པ་པོའི་རྒྱན་ཡང་ཐ་དད་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཐ་དད་པར་བརྗོད་ན་ནི་སྨྲ་བ་པོ་དོན་མེད་པ་ཡིན་ཏེ་དེ་ཡང་། ཉན་པ་པོ་ལ་ལྟོས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "བསྡུས་པའི་རྒྱན་ཡང་བསྟན་བཅོས་མཐའ་དག་ལ་ཁྱབ་པར་བྱེད་པ་ཁོ་ནས།",
    "གཉི་གས་ཀྱང་མིང་ཐོབ་པར་གྱུར་པ་དེ་ནི་གཞན་དང་གཞན་དག་ལ་ཡང་ཐ་སྙད་ཆགས་ཏེ།",
    "མཐའ་དྲུག་མི་ཤེས་པ་སྨད་པར་བསྟན་པ་ཡིན་ནོ།",
    "སྤྱིའི་དོན་གྱི་ཕྱོགས་ནི་ཕྱོགས་སྔ་མ་སེལ་བའི་སྒོ་ནས་སྐབས་སྟོན་པར་བྱེད་དོ།",
    "ཁ་ཅིག་གཅིག་ནི་ཆ་གཉིས་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་མཚམས་སྦྱར་གྱི་ཡི་གེ་ཨ་དགག་པའི་ཚིག་ཏུ་བྱས་ནས།",
    "དེ་ཡང་ཚིགས་བཅད་དུ་ཤེས་པར་བྱའོ།",
    "སེམས་རྣམ་པར་དག་པའི་རིམ་པ་ཡིན་ནོ།",
    "ཡེ་ཤེས་གསུམ་རྣམ་པར་འབྱེད་པ་ནི་གཅིག་ཏུ་སྦས་པའི་དོན་ནོ།",
    "ལྷའི་སྐུ་རྣམ་པར་དག་པ་སྔོན་དུ་འགྲོ་བའི་རྡོ་རྗེ་བཟླས་པའི་རིམ་པ་བསྟན་ཏོ།",
    "ཐུབ་པ་ཆེན་པོ་བཞུགས་པར་མཛད།",
    "དེ་ལྟར་བཞུགས་པའི་ཚིག་ཉིད་ཀྱི་རྒྱུད་མ་ལུས་པའི་དགོངས་པ་བསྟན་ནས་ཞེས་གསུངས་སོ།",
    "རྡོ་རྗེའི་སྐུ་ལ་བཞུགས་པར་གྱུར་ཏེ་ཞེས་བྱ་བ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་མི་བསྐྱོད་པ་ནི་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ཅན་ནོ་ཞེས་པ་ནི།",
    "སྤྲུལ་པའི་སྐུ་འཛིན་པ་བསྟན་པར་མཛད་པ་ཡིན་ཏེ།",
    "ད་ནི་རྡོ་རྗེ་འཆང་ཆེན་པོ་བསྐྱེད་པའི་རིམ་པའི་དོན་དུ་དང་པོར་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པར་གྱུར་ཏོ།",
    "དེའི་ངོ་བོ་ཉིད་ནི་གནས་པར་གྱུར་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་གནས་སོ།",
    "དེ་ལྟར་གསོལ་བ་བཏབ་པ་དང་ཞེས་བྱ་བ་ནས་མཐར་ཐུག་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་བཅོམ་ལྡན་འདས་འདུས་པ་འཆད་པར་བཞེད་ནས།",
    "སྤྲུལ་པའི་འཁོར་ལོ་སྤྲོ་བའི་ཕྱིར་དང་པོའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པར་གྱུར་ཏོ།",
    "ཡང་དག་པར་འབྱིན་པར་མཛད་པ་སྟེ་སྒྲ་ཇི་བཞིན་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་སྤྲོ་བ་བསྟན་ཏོ།",
    "བཛྲ་དྷྲྀཀ་ཅེས་བྱ་བ་ནི་ཞེས་པ་ནས་དེ་ལྟར་སྒོ་རྣམ་པར་བཞིར་བཀོད་ནས་བྱ་བའི་བར་གྱིས་ནི།",
    "ཁ་ཅིག་ནི་ཞལ་གྱི་སྒོ་ནས་སྔགས་གསུངས་པ་ཡིན་ཞེས་ཟེར་ཏེ།",
    "དེ་ནི་རིགས་པ་མ་ཡིན་ཏེ་ཡིག་འབྲུ་རྣམས་ནི་བརྗོད་མ་ཐག་ཏུ་རྣམ་པར་འཇིག་པ་ཡིན་པའི་ཕྱིར་ལ།",
    "བདེ་བ་ཆེན་པོ་རྗེས་སུ་མྱོང་བའི་དུས་སུ་སྔགས་བརྗོད་ཅིང་ཡང་དག་པར་བྱུང་བ་ནི་རིགས་པ་ཉིད་དེ།",
    "འདུས་པའི་དོན་ཐེ་ཚོམ་མེད་པ་ལ་འཇུག་པར་བྱ་སྟེ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སེམས་ཀྱིས་གཞན་ནི་མི་བསམ་པར།",
    "དོན་གང་ཡིན་པ་བསྟན་པ་ནི་ཡང་དག་པར་བསྟན་པ་ཡིན་ཏེ་དེ་ཉིད་དུ་རྒྱུད་ཀྱི་དོན་མཐའ་དག་བསྟན་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་འགྲེལ་པ་བྱེད་པས་དེ་ལྟར་བཞུགས་པའི་ཚིག་ཉིད་ཀྱིས་རྒྱུད་མ་ལུས་པའི་དགོས་པ་བསྟན་ནས་ཞེས་པ་ལྟ་བུའོ།",
    "གཞན་དུ་ན་ལེའུར་བཅད་པ་ལ་སོགས་པའི་དོན་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་གཞུང་དང་དོན་རྫོགས་པ་ལས་ལེའུ་ལ་སོགས་པར་ངེས་པར་བརྗོད་དོ།",
    "ཁྱེད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་ངེས་པའི་དོན་ཏོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་གསུང་ཐུགས་དབྱེར་མེད་པར་བསྟན་ཏོ།",
    "ལུས་སེམས་ལྟ་བུ་དང་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱིས་འོད་གསལ་བ་དེར་ལུས་ཐིམ་པར་གྱུར་པ་ནི་ལུས་སེམས་ལྟ་བུ་ཡིན་ནོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་ཞེས་བྱ་བ་ནས།",
    "དགོངས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་རྣམ་པར་སྣང་མཛད་ཀྱིས་གསུངས་སོ།",
    "མི་བསྐྱོད་པས་གསུངས་པའི་ཚིགས་སུ་བཅད་པ་ཡིན་ཏེ།",
    "ཡང་དགོངས་པ་མ་ཡིན་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་རིན་ཆེན་འབྱུང་ལྡན་གྱིས་གསུངས་པའི་ཚིགས་སུ་བཅད་པ་ཡིན་ཏེ།",
    "ཡང་དགོངས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་འོད་དཔག་མེད་ཀྱིས་གསུངས་པའི་ཚིགས་སུ་བཅད་པ་ཡིན་ཏེ།",
    "ཡང་དགོངས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་དོན་ཡོད་གྲུབ་པས་གསུངས་པའི་ཚིགས་སུ་བཅད་པ་ཡིན་ཏེ།",
    "འོ་ན་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཡིན་པས་དེས་གསུངས་པར་རིགས་ན།",
    "ཅིའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་གཞན་རྣམས་ཀྱིས་གསུངས་ཤེ་ན་དེ་ལ་ནི་ཉེས་པ་མེད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་སྤྲུལ་པའི་སྐུ་ཡིན་པས་རྒྱུ་དང་འབྲས་བུ་ཐ་མི་དད་པའི་ཕྱིར་དེ་ལྟར་གསུངས་པ་ཡིན་ནོ།",
    "རྒྱུ་དང་འབྲས་བུ་ཐ་མི་དད་པའི་ཕྱིར་དེ་ལྟར་གསུངས་པ་ཡིན་ནོ།",
    "མཇུག་སྡུད་པར་བསྟན་པ་ནི།",
    "ཚིགས་བཅད་བཞིས་བསྟན་པར་ཤེས་པར་བྱའོ།",
