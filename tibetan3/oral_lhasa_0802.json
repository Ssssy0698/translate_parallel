    "དེ་མ་བྱས་ན་ནི་དོན་མེད་དོ།",
    "རིམ་པ་གཉིས་ལ་བསླབ་པ་ལ་ཞེས་པ་ལ་སོགས་པས་ལེའུ་སྐབས་སྟོན་པར་བྱེད་དོ།",
    "ལས་རྣམ་པ་བཞིའི་ནང་ནས་ཞེས་པ་ནས་དེ་ཡོངས་སུ་གྱུར་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེའི་འཁོར་རྣམས་ཀྱིས་ཡང་བསྟན་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནས་སྒྲ་ཇི་བཞིན་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྦྱོར་བ་ཡང་དག་པར་བསྟན་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "བདུད་ལ་སོགས་པའི་རྣམ་པར་འཚེ་བ་ཞེས་པ་ནས་ཏིང་ངེ་འཛིན་དེ་ལ་ཡང་དེ་སྐད་ཅེས་བྱ་བའི་བར་གྱིས་ནི་ཞི་བ་ཆེན་པོར་བསྟན་ཏོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྐུར་བྱས་ལ་བསྒྲུབ་བྱ་བསྡུ་བ་སྔོན་དུ་བྱས་ནས།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་འཁོར་དང་བཅས་པའི་ཞལ་དང་།",
    "ད་ནི་རྫོགས་པའི་རིམ་པའི་ལྷ་རྣམས་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནས།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་རང་བྱིན་གྱིས་བརླབ་པའི་རིམ་པ་བསྐྱེད་པ་བསྟན་ཏོ།",
    "དེ་ལྟར་རིམ་པ་གཉིས་ཀྱི་ཏིང་ངེ་འཛིན་རིམ་པར་བསྟན་ནས་ཞེས་པ་ནས་། ངེས་པའི་དོན་ཏོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ཁྱད་པར་ཏེ་ཞེས་བྱ་བའི་པར་གྱིས་ནི་ཕྱོགས་དང་།",
    "ད་ནི་ལེའུ་ལ་འཇུག་པར་བྱ་སྟེ་ཞེས་པ་ནས།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྒྲུབ་པ་པོས་བཟླས་ཤིང་བཏོན་པ་ཙམ་གྱིས་ཀྱང་བྱེད་པར་འགྱུར་བའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ངེས་པར་སྐྲོད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྔགས་བརྗོད་ན་བདེ་བར་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ཁྲོ་བོ་གཞན་གྱིས་མི་ཐུབ་པའི་སྔགས་སྲིན་པོ་ལ་སོགས་པ་མ་རུངས་པ་སྲེག་པར་བྱེད་པ་སྔ་མ་བཞིན་དུ་བསྟན་ཏོ།",
    "ཁྲོ་བོ་དབྱུག་སྔོན་གྱི་སྔགས་གསོད་པར་བསྟན་ཏེ།",
    "གལ་ཏེ་འཇིག་པར་མི་འགྱུར་ན་ཞེས་བྱ་བ་ནི་སྨྲས་པའི་ལས་ཀྱི་གྲོགས་བསྟན་པའོ།",
    "ཀླུ་རྣམས་ཆར་འབེབས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་ཁྲོ་བོ་སྟོབས་པོ་ཆེའི་སྔགས་ཀྱི་གཙོར་ཆར་འབེབས་པའི་ཆོ་ག་བསྟན་ཏོ།",
    "དེ་རྣམས་འགུགས་པའི་བྱ་བ་བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "འགུགས་པར་བྱེད་པ་ལ་གཙོར་བསྟན་ཏོ།",
    "དུས་གསུམ་དུ་བཟླས་པས་འགུགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ཁྲོ་བོ་མི་གཡོ་བའི་སྔགས་ཀྱིས་འགུགས་པར་བྱེད་པ་བསྟན་ཏོ།",
    "སྔ་མ་བཞིན་དུ་འགུགས་པར་བྱེད་པ་བསྟན་ཏོ།",
    "ཕྱག་རྒྱའི་ཁྱད་པར་དང་ཞེས་པ་ནས།",
    "གནས་སྐབས་ཐམས་ཅད་དུ་དམིགས་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ན།",
    "ཉེ་བར་སྤྱད་པར་བྱའོ་ཞེས་གསུངས་སོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "མནན་ནས་སྔགས་བཟླས་ན་ཁུགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྡོ་རྗེ་བཟླས་པས་སྔར་བསྟན་པའི་སྔགས་གྲུབ་པར་བསྟན་ཏོ།",
    "མངོན་སྤྱོད་བྱ་བའི་ཡུལ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཞེས་པ་ནས་འོག་མའི་སྡུད་པ་པོའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "མྱུར་ཞིང་རིངས་པར་འཆི་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྡོ་རྗེ་དང་པདྨ་མཉམ་པར་ཞེས་པ་ནས།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྙོམས་པར་ཞུགས་པའི་སྒོ་ནས་བསྒྲུབ་བྱའི་ལུས་ངག་ཡིད་གསུམ་ལ་ཕུར་བུས་གདབ་པར་བསྟན་ཏོ།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་ལས་ཀྱི་སྦྱོར་བ་གསུངས་པ་ལ།",
    "ལེའུའི་སྐབས་སྟོན་པར་བྱེད་དོ།",
    "འདི་དག་ཐམས་ཅད་རྫོགས་པར་བྱ།",
    "དེ་བསྒོམས་པས་དགྲ་གསད་པར་བསྟན་ཏོ།",
    "ཧཱུཾ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཞེས་པ་ནས་བསམ་གཏན་ཉིད་ཀྱིས་ཐམས་ཅད་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "མ་ལུས་པ་འཇིག་པར་བྱེད་པའོ།",
    "ལས་ཀྱི་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཞེས་བྱ་བ་ནས་ཆར་གནོན་པ་ལ་མཆོག་ཏུ་ཁྱད་པར་། དུ་འཕགས་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་ཁྲོ་བོ་བདུད་རྩི་འཁྱིལ་པའི་བསྒོམས་པས་ཚར་གཅོད་པ་བསྟན་ཏོ།",
    "སྙོམས་པར་ཞུགས་པའི་སྒོ་ནས་དེ་བཞིན་གཤེགས་པ་ལྔ་གྲུབ་པར་བསྟན་ཏོ།",
    "སྒྲུབ་པ་པོའི་ཟས་བསང་པར་བྱ་བ་ཡིན་ནོ།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེ་སྒྲུབ་ཅིང་སྐྱེད་པར་བྱེད་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྲིན་པ་དུ་མ་གསོད་པར་བྱེད་པ་བསྟན་ཏོ།",
    "སྦྲུལ་ནག་ཅེས་བྱ་བ་ལ་སོགས་པ་ཞེས་པ་ནས་རྡོ་རྗེ་འཆང་ཆེན་པོས་གསུངས་སོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་རྣལ་འབྱོར་བ་གཤིན་རྗེ་གཤེད་དུ་བསྐྱེད་ནས།",
    "སྤྲུལ་ལ་སོགས་པ་སྤྲོས་པས་མ་རུངས་པ་གསོད་པར་བསྟན་ཏོ།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "གསོད་པ་རྣམ་པར་དག་པས་ཀྱང་།",
    "གསོད་པར་བྱེད་པ་བསྟན་ཏོ།",
    "མ་རུངས་པ་གསོད་པར་བྱེད་པ་བསྟན་ཏོ།",
    "དེ་ལས་དངོས་གྲུབ་ཐམས་ཅད་རྗེས་སུ་རྟོགས་པར་བྱ་ཞིང་ཁོང་དུ་ཆུད་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་སྟེ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "གཞན་དེ་བཞིན་གཤེགས་པ་གཉིས་ཀྱི་གཙོར་བྱས་པའི་དཀྱིལ་འཁོར་རམ།",
    "ཡང་དེར་འདུས་པར་བྱ་བའི་ཕྱིར།",
    "ལེའུ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་སྤྲོས་པ་ཡིན་ནོ་ཞེས་རང་ཉིད་ཀྱིས་བསྟན་ཏོ།",
    "རིམ་གྱིས་རྣམ་པར་བརྟག་ཅིང་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རྣལ་འབྱོར་དང་།",
    "དེ་ལྟར་ལེགས་པར་བསླབས་པའི་ཞེས་པ་ནས།",
    "བགེགས་བྱེད་པར་མི་ནུས་སོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་ཞེས་བྱ་བ་ནས།",
    "དེ་ལ་རྡོ་རྗེ་སློབ་དཔོན་གྱིས་ཞེས་པ་ནས་ཞེས་ཀྱང་གསུངས་སོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱོར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེའི་ལྷ་སྦྱིན་པ་བསྟན་ཏོ།",
    "སྤྱན་ལ་སོགས་པར་ཡོངས་སུ་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དཀྱིལ་འཁོར་གྱི་དེ་ཁོ་ན་ཉིད་མ་བསྟན་ཀྱང་བརྟག་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་དམ་ཚིག་སྦྱིན་པའི་དུས་སུའོ་ཞེས་བྱ་བ་ནས་འདི་སྐད་ཅེས་ཀྱང་གསུངས་སོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ཉིན་པར་ལ་སོགས་པའི་དབྱེ་བས་རི་ལུ་བྱས་ཏེ།",
    "ལས་བྱས་པའི་ཟས་ཀྱི་དམ་ཚིག་སྦྱིན་ནོ།",
    "དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ནས་དེ་སྐད་ཅེས་བཀའ་སྩལ་ཏོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་སྔགས་ཀྱིས་ཀྱང་ལྷག་པར་མངག་གཞུག་ལ་བསྐུལ་བར་བསྟན་ཏོ།",
    "སྙོམས་པར་ཞུགས་པའི་ཛམ་ྦྷལ་བསྒོམས་པས་རྒྱས་པའི་ལས་གྲུབ་པ་བསྟན་ཏོ།",
    "དེ་ལྟར་བྱ་བ་བྱས་པའི་ཞེས་པ་ནས།",
    "སྙོམས་པར་འཇུག་པར་རབ་ཏུ་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེ་དང་ལྷན་ཅིག་ཏུ་གནས་པར་བྱའོ།",
    "སྡུད་པར་བྱེད་པས་དེ་ནས་ཞེས་པ་ནས།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོ་དགྱེས་ནས་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་མངོན་དུ་ཕྱོགས་པར་བསྟན་ཏོ།",
    "ཚངས་པ་ལ་སོགས་པའི་དམ་ཚིག་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ངོ་པོར་བསྟན་ཏོ།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མ་མཉེས་པར་བྱ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནས།",
    "ཉེ་བར་སྡུད་པར་བྱེད་དོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་རྡོ་རྗེ་མཁའ་འགྲོ་མ་རྣམས་ལ་ཇི་ལྟར་འདོད་པར་ཉེ་བར་ལོངས་སྤྱོད་པར་བསྟན་ཏོ།",
    "ལས་ཀྱི་ལམ་རྣམ་པར་དག་པ་བསྟན་ཏོ།",
    "ད་ནི་བསྒྲུབ་པ་རྩོམ་པར་བྱེད་པའི་སྔགས་སོ་ཞེས་པ་ནས།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་སྙོམས་པར་ཞུགས་པ་སྤྲོས་པའི་མཚན་ཉིད་ཀྱི་དམ་ཚིག་བསྟན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་མ་ཉེས་པར་བྱེད་པའི་དམ་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སེམས་ནི་མཉམ་པར་གཞག་པར་འགྱུར།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ལས་ཀྱི་སྦྱོར་བ་ཐམས་ཅད་འོད་གསལ་བ་ཉིད་ལ་འཇུག་པ་ཉིད་རྣམ་པར་དག་པར་བསྟན་ཏོ།",
    "ཞུབ་བྱས་པ་ན།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་དེ་ཁོ་ན་ཉིད་ནི་རྙེད་པར་དཀའ་སྟེ།",
    "རྣམ་པར་བརྟག་པ་ནི་མ་རྙེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེ་ལྟར་རྡོ་རྗེ་འཆང་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ངེས་པར་བྱས་ནས་ཞེས་པ་ནས།",
    "ངོ་མཚར་དུ་གྱུར་པའི་གནས་སྐབས་བསྟན་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "ངོ་མཚར་གྱི་རྒྱུའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་དེ་ཁོ་ན་ཉིད་ལ་འཁོར་རྣམས་ཀྱི་རྗེས་སུ་ཡི་རང་བར་བསྟན་ཏོ།",
    "དེ་ལྟར་མཚན་མ་མེད་པའི་ཏིང་ངེ་འཛིན་ངེས་པར་བྱས་ནས།",
    "ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་དང་སྙོམས་པར་ཞུགས་པ་ནི་ཞེས་པ་ནས།",
    "ལྷན་ཅིག་སྙོམས་པར་ཞུགས་པ་བསྟན་ཏོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་མཉམ་པར་གཞག་པའི་ཞེས་པ་ནས།",
    "སྡུད་པར་བྱེད་པའི་ཚིག་གོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེ་ལྟར་རྣམ་པར་སྣང་མཛད་ལ་སོག་པ་ཞེས་པ་ནས་དོན་དམ་པའི་བདེན་པ་ལ་ཞུགས་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་དུའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "བཅོམ་ལྡན་འདས་འོད་གསལ་བ་ཉིད་ལ་བཞུགས་པར་བསྟན་ཏོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ཞེས་པ་ནས།",
    "དེ་ལྟར་བྱམས་པ་ཅང་མི་སྨྲ་བར་གྱུར་བས་ཞེས་པ་ནས་ཞེས་གསུངས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོས་གསུངས་སོ།",
    "སྦྱོར་བའི་ཕུལ་དུ་བྱུང་བའི་ཁྱད་པར་བསྟན་པའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་ཕྱག་དྲུག་པ་བསྒོམས་པས་མ་རུངས་པ་ཚར་བཅད་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྣལ་འབྱོར་པ་སྐྱོ་བར་གྱུར་ན་བདུད་རྩིས་བདའ་ཞིང་ཚིམ་པར་བྱ་བ་བསྟན་ཏོ།",
    "རྫོགས་པའི་རིམ་པ་རྟོགས་པར་གྱུར་བ་ཞེས་པ་ནས།",
    "ལེའུ་བཅོ་ལྔ་པ་ལས་གསུངས་པ་ཞེས་པ་ནས།",
    "དེ་ཁོ་ན་ཉིད་ལས་གནས་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "དེ་ནས་སྡུད་པར་བྱེད་པ་ཞེས་པ་ནས་ཅང་མི་གསུང་བར་གྱུར་ཏོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་འཁོར་གྱིས་ཞུས་པས་བཅོམ་ལྡན་འདས་ཀྱི་རྒྱུད་ཀྱི་བདག་ཉིད་བསྟན་ཏོ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་ཐེ་ཚོམ་དང་བྲལ་བའི་ཞེས་པ་ནས།",
    "ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "སྔོན་དུ་གྱུར་བའི་སྒོ་ནས་སྔོན་བྱུང་བ་རྙེད་པར་དཀའ་ལ་དེ་ལྟར་ནི་རྒྱུད་འདི་རྙེད་པར་སླ་བར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་དོན་བྱས་ཟིན་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་ལ་རབ་ཏུ་ཞུགས་པར་གྱུར་ཏོ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོས་རྒྱུད་གཏད་པར་མཛད་པ་ཡིན་ནོ།",
    "རྒྱུད་གཏད་པའི་འོག་ཏུ་ཞེས་པ་ནས་ཞེས་མཐར་ཐུག་བ་གསུངས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི།",
    "རྣམ་པར་སྣང་མཛད་དང་།",
    "ངག་དང་སེམས་ལ་དེའི་བདག་ཉིད་དུ་རྣམ་པར་ཞུ་ནས།",
    "འོད་གསལ་བ་ལ་དམིགས་པར་བསྟན་ཏོ།",
    "སློབ་དཔོན་གྱི་ཞལ་སྔ་ནས་ཀྱི་བཀའ་དྲིན་གྱིས་རྒྱུད་ཀྱི་དོན་དང་ཚུལ་ཞེས་པ་ནས་ཕ་རོལ་གྱི་མཐའ་ངེས་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱིས་ནི་འཕགས་པ་ལང་ཀར་གཤེགས་པ་ལས།",
    "བདེ་བ་དམ་པའི་གནས་མཆོག་ཟླ་བའི་བྲོ་དང་འགྲོ་བ་རྣམས་ནི་ལྡན་པར་ཤོག།",
    "མཐའ་དྲུགས་གཅོད་བྱས་པ་ཡིས།",
    "སྟོན་པ་གཙོ་འཁོར་གསུམ་གྱི་སྐུ་པར།",
    "བློ་སྤོབས་བསྐྱེད་ནས་དཔེ་སྐྲུན་བྱ་ཆེད་ཞིབ་འཇུག་ལ་ཤུགས་སྣོན་རྒྱག་རྒྱུ་ཕྲག་ལ་བབས་པའི་འགན་འཁྲི་ཞིག་ཀྱང་ཡིན་པར་ཤེས་ནས།",
    "བརྒྱུད་ཡིག་ཕྱོགས་བསྒྲིགས་འདིའི་ཡིག་རྒྱག་པ་ཞུ་དག་པ་མ་དཔེ་མཁོ་འདོན་གནང་མཁན་རྣམས་ཀྱི་མཚན་ཐོ་དེབ་སོ་སོའི་གཤམ་དུ་བཀོད་ཡོད།",
    "དེར་མ་ཟད་བརྒྱུད་ཡིག་ཕྱོགས་བསྒྲིགས་ཀྱི་ལས་ཀ་ལ་ཐུགས་ཁུར་ཆེར་བཞེས་དང་རྒྱབ་སྐྱོར་དང་མཛུབ་སྟོན་གནང་བའི་གྲོགས་པོ་ཡོངས་ལ་ཐུགས་རྗེ་ཆེ་ཞུ་བ་ཙམ་དུ་མ་ཟད་ཁྱེད་རྣམས་ཀྱི་ཐུགས་བསྐྱེད་བཞིན་ཡོངས་སུ་འགྲུབ་པར་སྨོན་ནོ།",
    "དཔེར་ན་རྒྱལ་པོའི་བཀའ་བཞིན་མ་བསྒྲུབ་ན་ཡུལ་བརླག་པར་འགྱུར་ལ།",
    "གནས་བརྟན་འོད་བསྲུང་ཆེན་པོས་སྟོན་པ་ལས་ཐོས་པ་རྣམས་ཀུན་དགའ་བོ་སོགས་དགྲ་བཅོམ་པ་རྣམས་ལ་སྟོན་པར་གསུང་མཛད་པ་ཡིན་ལ།",
    "འོན་ཀྱང་ཐན་བྱ་འུག་པ་ནི་འུག་པ་རང་ཡིན་པས་ད་དུང་ཡང་མང་དག་ཞིག་གྲགས་པར།",
    "བློ་ལྡན་རྣམས་ཀྱི་ནོར་བ་ཁོ་ན་ཡིན་པར་ཤེས་དགོས་སོ།"
  ]
