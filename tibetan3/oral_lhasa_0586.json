    "འོ་ན་སེམས་བསམ་པ་ཐམས་ཅད་དང་རྣམ་པར་བྲལ་བའི་དུས་གང་ཞིག་ཅེ་ན།",
    "ཐོས་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཡང་དག་པར་རིག་པར་གྱུར་པ་དེ་མ་འོངས་པའི་དུས་ན་དྲན་པ་སྐྱེ་བའི་གནས་སྐབས་སུ་ཇི་ལྟར་འགྱུར།",
    "ཅྰྡི་ལ་བརྗོད་པར་བྱ་སྟེ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པའི་ལས་གཟུང་བར་བྱ་བས་དུས་གང་ཞིག་ཏུ་ངེས་པར་རབ་ཏུ་གནས་པའི་དངོས་པོ་ལ་ཡིད་འདུ་བྱེད་པ་ལས་མ་གཏོགས་པའི་གཞན་ཚིག་དང་དོན་རྣམས་ལ་བསམ་པ་མེད་པ་ཡིན་ནོ།",
    "གང་དེའི་དུས་སུ་ན་ནི་གཟུང་བ་དང་འཛིན་པ་ལ་སོགས་པར་རིག་པ་ཐམས་ཅད་རབ་ཏུ་ཞིག་པ་དང་།",
    "དེས་ན་དེའི་འཁོར་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཞུགས་པ་དང་དེ་བཞིན་དུ་མཱ་མ་ཀཱི་ལ་སོགས་པའི་རྡོ་རྗེ་རྣལ་འབྱོར་མ་རྣམས་ཀྱང་བཞུགས་ཤིང་དེ་བཞིན་དུ་འཕགས་པ་ཀུན་དགའ་བོ་ལ་སོགས་པ་དེ་དག་དཀྱིལ་འཁོར་ན་བཞུགས་པ་ཡིན་ནོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནི་དེ་མ་ཐག་པར་རོ།",
    "རྡོ་རྗེའི་གོ་འཕང་ཆེན་པོས་ཤེས་པར་བྱ་བ་ནི་རོལ་རྩེད་མཛད་པའོ།",
    "གསང་སྔགས་ཀྱི་ཚུལ་འདི་དག་བཅོམ་ལྡན་འདས་ཀྱིས་ཁྱད་པར་དུ་ཡང་བསྟན་པ་ཡིན་ནོ།",
    "དེ་རྣམས་དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་མཆོག་ཏུ་རྣམ་པར་དག་པ་ཉིད་ཀྱི་ཕྱིར་ནའོ།",
    "དེ་རྣམས་རང་བཞིན་ཇི་ལྟ་བར་ཉམས་སུ་མྱོང་བར་བྱས་ན་ཞེས་སོ།",
    "གང་དང་གང་ཉིད་བཅིངས་པར་བྱུང་བ།",
    "ཡོངས་སུ་ཞུ་བའི་རྒྱུ་གསུངས་པ།",
    "དེ་བས་ན་བཅོམ་ལྡན་འདས་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་གནས་སོ།",
    "དེའི་དོན་དུ་དེ་ལྟ་བུ་འདི་བཅོམ་ལྡན་འདས་ཀྱི་ཁྱད་པར་ཅན་གྱི་རྒྱུད་གཞན་དག་དང་།",
    "གཞན་ནའང་འཆད་པར་མཛད་པ་ཡིན་ནོ།",
    "རྫུ་འཕྲུལ་ཐོབ་པར་མི་འགྱུར་ཞིང་།",
    "འདི་ལ་གསུངས་པ་རྣལ་འབྱོར་མའི་རྒྱུད་ཉིད་བྱེ་བ་ཕྲག་དྲུག་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གཞན་ཡང་གང་དེ་རྣམས་ཀྱི་སྔགས་རྣམས་གསུངས་པ་གང་ཡིན་པ་དག་ཀྱང་དངོས་གྲུབ་རྣམས་སྩོལ་བ་ཡིན་ནོ།",
    "དེ་ཉིད་ནི་བྱེ་བར་བཟླས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱུ་ཡིན་པས་སྟོན་པར་གསུངས་སོ།",
    "ད་ནི་འདི་རྒྱུད་གཞན་རྣམས་ལས་ཇི་ལྟ་བ་བཞིན་དུ་ཁྱད་པར་དུ་གྱུར་པ་དེ་ཉིད་རབ་ཏུ་གསལ་བར་བྱ་བའི་ཕྱིར།",
    "གྲངས་ངེས་པར་གཞག་པ་མེད་པའི་ཕྱིར་ནའོ།",
    "ཤིན་ཏུ་རིང་བ་ཡང་མ་ཡིན་པར་སྔགས་བཟླས་པ་ཅུང་ཞིག་ཐོས་ཙམ་དུ་བརྗོད་པར་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཤིན་ཏུ་ཡང་སེམས་ཐིམ་པར་གྱུར་ན།",
    "དེ་བཞིན་དུ་ཡང་སེམས་སྐྱོ་ཞིང་ཞུམ་པས་དེར་བཟླས་པས་ནི་བསྐལ་བ་བྱེ་བ་བརྒྱར་བཟླས་པ་བྱེ་བ་ཕྲག་བརྒྱ་བྱས་ཀྱང་འགྲུབ་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ན་རྒྱུད་གང་རྣམས་སུ་བྱེ་བར་བཟླས་པ་ལ་སོགས་པས་འགྲུབ་པར་གསུངས་པ་དེ་རྣམས་སུ་དེ་རྣམས་འགྲུབ་པར་ཇི་ལྟར་འགྱུར།",
    "འོ་ན་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱུད་གཞན་དང་གཞན་རྣམས་ཡང་དག་པར་གསུངས་པ་མ་ཡིན་ཏེ།",
    "རྒྱུད་གཞན་པ་རྣམས་ཡང་དག་པ་མ་ཡིན་པར་རབ་ཏུ་གསལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "རྒྱུད་དེ་རྣམས་ཡང་དག་པ་མ་ཡིན་པར་གནས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལ་བརྗོད་པར་བྱ་བ་སྟེ།",
    "སླར་ཡང་བཅོམ་ལྡན་འདས་ཉིད་ཀྱི་དབུའི་ཐོད་པར་ཞུགས་སོ།",
    "དེ་ལྟ་བུའི་རིམ་པ་འདི་ནི་རྣལ་འབྱོར་བས་ཀྱང་སྔགས་འདོན་པའི་དུས་སུ་ཡང་བྱ་བ་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "དེས་ན་རྣ་བས་རྟོགས་པར་བྱས་ཏེ་ཕྱིས་ཁར་ཞུགས་ནས་པདྨའི་ནང་དུ་བྱུང་ངོ་ཞེས་བྱ་བ་ལ་ནི་སུན་དབྱུང་བར་བྱ་བ་མེད་དོ་ཞེས་པ་དེ་དག་ཀྱང་བཟང་པོ་མ་ཡིན་ལ།",
    "དེ་ནས་ཡང་རྣ་བས་བཟུང་བར་བྱ་བ་མ་ཡིན་ནའང་ཡིད་ཀྱིས་སྔགས་ཀྱི་བདག་ཉིད་རང་རིག་པ་ཡིན་པར་གྱུར་པ་ཡིན་ཏེ།",
    "བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པའི་རང་བཞིན་ཉིད་ནི་ཡིད་ཀྱིས་ཡང་དག་པར་རིག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཡིན་ན་ནི་འོན་པ་དང་ལོང་བ་ལ་སོགས་པ་མི་སྲིད་པར་གནས་པར་འགྱུར་རོ།",
    "དེ་ལ་འདིར་མེའི་སྲེག་པར་བྱེད་པའི་རྡུལ་ཕྲ་རབ་ཀྱང་གཞན་ཡིན་ལ་བལྟ་བར་བྱ་བའི་རྡུལ་ཕྲ་རབ་ཀྱང་གཞན་ཡིན་པ་དེ་ལྟར་གནས་སོ།",
    "དེ་ལ་འདིར་བརྗོད་པར་བྱ་སྟེ་ཡིད་ཀྱི་ཤེས་པ་འདི་ཉིད་ཀྱིས་སྔགས་རྣམས་རྟོགས་པ་ཡིན་པ་ལ་ནི་འདིར་སྐྱེན་འགའ་ཞིག་ཀྱང་ཡིན་ན་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་ཅན་རྣམས་ཀྱི་ཡང་དེ་ལྟར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "ཡང་བརྒལ་བ་འདི་ལྟར་སེམས་ཏེ་རང་ཡང་དག་པར་རིག་པའི་མཚན་ཉིད་ལས་མ་རྟོགས་པའི་ཡིད་གཞན་པའི་རང་བཞིན་ནི་འགའ་ཡང་མ་མཐོང་སྟེ།",
    "དེ་འདི་ལྟར་སོ་སོ་ཡང་དག་པར་རིག་པའི་བདག་ཉིད་ཙམ་གྱི་རང་བཞིན་ཡིན་པའི་ཕྱིར་ན་ཡིད་ཀྱི་ཁྱད་པར་འགའ་ཞིག་ཀྱང་མ་མཐོང་ངོ་ཞེ་ན།",
    "འདིར་ཡང་སྐྱེས་བུ་ཙམ་དུ་གཅིག་པར་ཁྱད་པར་འགའ་ཡང་མི་དམིགས་ན།",
    "དེ་ལྟར་ཇི་ལྟར་གཟུགས་ཀྱི་ཁྱད་པར་འགྲུབ་པ་འདི་ལྟར་མཐོང་སྟེ།",
    "འོ་ན་ཡིད་འདིའི་ཁྱད་པར་ཅི་ལྟ་བུ་ཞིག་ན་ཅི་ལྷ་རྣམས་ཀྱི་ཁྱད་པར་གྱིས་དེ་བཞིན་དུ་འདིའི་རང་བཞིན་ཉིད་དམ།",
    "ཡིད་ཀྱི་རང་བཞིན་ཡིན་པ་དེས་ན་དེ་བཞིན་དུ་ཁྱད་པར་འགའ་ཡང་མེད་པ་ཡིན་ཏེ།",
    "དེ་ནས་ཡང་རྒྱུ་ལས་བྱུང་བའི་ཁྱད་པར་ཡོད་པ་དེ་ལྟ་ན་ཡང་ཁྱད་པར་འགའ་ཡང་མེད་པ་ཡིན་ཏེ།",
    "དེ་ལ་རྒྱུ་ཡོད་ན་ཡང་རྒྱུའི་ཁྱད་པར་གྱི་རང་བཞིན་ནི་སྲོག་ཆགས་ཐམས་ཅད་ཀྱིས་མ་རྟོགས་པ་དེས་ན་སྲོག་ཆགས་ཐམས་ཅད་ཀྱི་ཡིད་ཁྱད་པར་ཅན་དུ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "དེའི་ཁྱད་པར་དུ་བྱེད་པའི་རྒྱུ་ཅི་ཡིས་རྟོགས་པར་བྱེད།",
    "ཡོད་ན་ནི་དེ་བཞིན་དུ་གཞན་རྣམས་ཀྱང་དེ་ལྟར་རབ་ཏུ་རྟོགས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལ་བརྒྱུད་ཅིང་བརྒྱུད་པ་ལས་རྟོགས་པར་འགྱུར་ན་ཡང་ཐུག་པ་མེད་པའི་སྐྱོན་དུ་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ན་བཅོམ་ལྡན་འདས་ཀྱིས་ཡིད་ཁྱད་པར་འཕགས་པར་གྲུབ་པ་ཇི་ལྟར་ཡིན་པ་དང་།",
    "རྒྱུ་གཞན་གྱིས་བྱེད་པ་ཡིད་ཁྱད་པར་ཅན་དུ་བྱས་པ་ཡིན་ན།",
    "ཡིད་བཞིན་དུ་དེ་ཐམས་ཅད་དུ་བརྟན་པ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "རྒྱུ་ལས་བྱུང་བའི་བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་བརྟན་པའི་རང་བཞིན་མ་ཡིན་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ན་ཡིད་ཁྱད་པར་ཅན་དུ་རབ་ཏུ་གྲུབ་པའི་དགོས་པ་དེ་ནི་འགའ་ཞིག་ཏུ་ཡང་གྲུབ་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་བརྗོད་པར་བྱ་སྟེ་ཡིད་ཁྱད་པར་ཅན་འདི་ཉིད་ནི་རང་བཞིན་ཡང་ཡིན་ལ།",
    "དེ་ཁྱད་པར་ཅན་གྱི་རང་བཞིན་དུ་སྐྱེ་བ་མ་ཡིན་ལ།",
    "འོ་ན་ཐམས་ཅད་ཐུག་པ་མེད་པར་འགྱུར་བ་ཇི་ལྟར་མིན་ཏེ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ན་བག་ཆགས་རྣམས་དུས་ཐམས་ཅད་དུ་སྐྱེ་བར་འགྱུར་བ་ཉིད་དམ་ཡང་ན་དུས་ཐམས་ཅད་དུ་གདོད་ནས་མི་སྐྱེ་བར་གནས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གྲོལ་བ་དང་མི་གྲོལ་བའི་སེམས་ཀྱི་གནས་སྐབས་ཀུན་ལ་འཇུག་པར་ཇི་ལྟར་འཐད།",
    "མེད་པར་འགྱུར་བ་ཞེས་བྱ་བའི་སྐྱོན་མེད་དེ།",
    "ཡང་ན་སྲིད་པ་ཉིད་འབའ་ཞིག་ཏུ་གནས་པར་འགྱུར་རོ།",
    "དེ་ནི་ཡིད་དེ་ཉིད་ཀྱི་རྣམ་པའི་དངོས་པོར་རྟོགས་པར་བྱ་བ་ལ།",
    "འོད་གསལ་མ་ཡིན་ཞེས་བྱ་བ་ཡང་མེད་པས་ཁྱད་པར་མེད་པར་འགྱུར་རོ།",
    "དེ་བྱེད་ན་ནི་དུས་ཐམས་ཅད་དུ་བདེན་པར་གྱུར་པ་ཡང་དག་པར་ཤེས་པ་སྐྱེ་བ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་ནི་དེའི་ཚེ་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་མེད་པར་གྱུར་བས་དེ་བཞིན་ནོ་ཞེའོ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་མི་མཐུན་པ་དེ་ཉིད་ཀྱང་གང་ཞིག་ལས་སྐྱེ་བར་འགྱུར་ཞེ་ན།",
    "དེས་ན་སེམས་དེ་ཉིད་བག་ཆགས་ཀྱི་སྤྲུལ་པར་སྐྱེ་བ་ལ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་སྔགས་ཀྱི་མཐུ་གསུངས་ནས་རྒྱུད་ཀྱི་དོན་ཇི་ལྟར་ཡིན་པའི་གླེགས་བམ་ཕྱུང་བ་གསུངས་པ།",
    "བྱེད་པར་ཉེ་བར་སྤྱོད་དོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་འདི་ཇི་ལྟར་འབྲེལ་ཞེ་ན།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ་གང་ཐམས་ཅད་ཀྱི་དོན་དམ་པ་དེ་ཁོ་ན་ཉིད་ནི་རང་བཞིན་གཅིག་པ་ཁོ་ན་སྟེ།",
    "དེ་རྣམས་ཀྱི་ཡང་དག་པར་རིག་པ་ཡང་དངོས་པོ་སྣ་ཚོགས་སུ་སྐྱེ་བ་དང་།",
    "ཆུ་སྟེང་དང་བ་མང་ན་ཟླ་བ་གཅིག་པོའི་གཟུགས་བརྙན་ཡང་མང་པོར་དམིགས་པར་འགྱུར་བ་དེ་བཞིན་དུ་མི་ཤེས་པ་ཡང་ཀུན་དུ་སྣང་བར་གནས་པ་ཉིད་ཀྱི་ཕྱིར་ན་རྣམ་པར་བཅིངས་པ་ཡང་བརྫུན་ཙམ་གྱིས་ཀྱང་སྡུག་བསྔལ་གྲུབ་པ་ཡིན་ཏེ།",
    "དཔེར་ན་མཁའིའོ་ཟིལ་ལ་ཐག་པ་ལ་སྤྲུལ་གྱི་དངོས་པོར་གཟུང་བ་དེས་འཇིགས་པ་ལས་ཤིན་ཏུ་སྡུག་བསྔལ་བ་མངོན་དུ་ཉམས་སུ་མྱོང་བ་ཡིན་ཡང་དེ་ཡང་དག་པར་ནི་སྡུག་བསྔལ་དེ་སྤྲུལ་ཉིད་ཀྱིས་བསྐྱེད་པ་མ་ཡིན་ནོ།",
    "བདག་དང་གཞན་དུ་སོ་སོར་རིག་པ་དག་དེའི་ཚེ་ནུབ་པར་གྱུར་བའི་ཕྱིར་ནའོ།",
    "ནམ་མཁའ་ལྡིང་དང་ཆར་འབབ་པ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་པས་ནི་དངོས་གྲུབ་གང་ཡང་རུང་བ་དེ་ཐམས་ཅད་བསྐྱེད་པའོ།",
    "དེ་བཞིན་དུ་ཧེ་རུ་ཀའི་དེ་ཁོ་ན་ཉིད་ཆེན་པོ་དེ་ཉིད་འདིར་བསྒྲུབ་པར་བྱ་བར་གསུངས་སོ།",
    "དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་དེ་ཉིད་དངོས་པོ་དང་དངོས་པོ་མེད་པའི་རང་བཞིན་དུ་རྟོགས་པར་བྱའོ།",
    "འདི་ལ་གསུངས་པ་སྤྲོས་མེད་དང་གོས་མེད་ཅེས་བྱ་བ་སྟེ།",
    "དོན་དམ་པར་ནི་བཅོམ་ལྡན་འདས་འདི་ལ་སྤྲོས་པ་མེད་པས་དངོས་པོ་མེད་པའི་སྤྲོས་པས་མི་རིག་གོ།",
    "འདི་ལ་སྲིད་པར་སྤྱོད་པ་དང་།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཇི་སྲིད་དུ་བཅོམ་ལྡན་འདས་དེའི་རང་བཞིན་སྲིད་པའི་རྗེས་སུ་འཇུག་པར་རབ་ཏུ་ཤེས་སམ།",
    "ཟླ་བ་གཅིག་པུ་མེད་ན་གཉིས་ཀྱི་གཟུགས་སུ་དེས་ཇི་ལྟར་རིག་པར་འགྱུར།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་འདི་ཤེས་ནས་སྲིད་པར་འཇུག་ན་ནི་དེའི་ཚེ་དེ་རང་རིག་པའི་རང་བཞིན་གྱིས་འཇུག།",
    "དངོས་པོ་མེད་པའི་འགྲོ་བ་རྐུན་གྱི་རང་བཞིན་དེས་རབ་ཏུ་གསལ་བར་མི་འགྱུར་ཏེ་དེའི་རང་བཞིན་གཉིས་པོ་རྣམས་དང་རྣམ་པར་བྲལ་བ་དེའི་ཕྱིར་ནའོ།",
    "དེ་ནས་ཡང་དེ་གཞན་གྱི་རང་བཞིན་དུ་རིག་པར་འཇུག་གོ་ཞེས་སྨྲ་ན།",
    "དེའི་ཚེ་སྲིད་པ་རྣམས་འདིར་རིག་པར་མི་འགྱུར་ཏེ།",
    "འགའ་ཞིག་ཏུ་ཡང་གཞན་ཉིད་དུ་རིག་པར་སྐྱེས་པ་མིན་ཏེ་གཞན་གྱི་རང་བཞིན་དུ་རིག་པར་ནི་དེ་དེའི་ངོ་བོ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་དེ་བཞིན་དུ་གྱུར་ན་ནི་དེ་སྲིད་པར་ཡང་ཇི་ལྟར་འགྱུར།",
    "སྔོན་གྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པའི་སྟོབས་ལས་སྐྱེ་སྟེ།",
    "དེའི་ཕྱིར་ན་སྨིག་རྒྱུ་བའི་དངོས་པོ་ལ་ཆུའི་རྣམ་པར་ཤེས་པ་ལྟར་འདིར་དེ་ཁོ་ན་ཉིད་རང་བཞིན་སྲིད་པའི་དངོས་པོར་སྣང་བ་ལ་འགལ་བ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཡུལ་ན་རི་ཀེ་ལའི་གླིང་ནས་འོངས་མ་ཐག་པའི་མིས་མེ་འདིའི་རང་བཞིན་ནི་སྲེག་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བར་མི་ཤེས་ཀྱང་དེ་ཡང་དག་པར་རིག་ཅིང་མྱང་བ་ན་གྲང་བ་སེལ་བར་མི་འགྱུར་རམ།",
    "མིན་ཏེ་དེ་ཁོ་ན་ཉིད་ཉམས་སུ་མྱོང་བ་ཙམ་གྱིས་སྲིད་པའི་དངོས་པོ་མེད་པའི་མཚན་ཉིད་མྱ་ངན་ལས་འདས་པར་འགྱུར་བར་བརྗོད་པ་ནི་མིན་ཏེ།",
    "གང་དེ་ཙམ་གྱིས་ནི་མྱ་ངན་ལས་འདས་པར་སྦྱོར་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེ་ཁོ་ན་ཉིད་ཤེས་པས་མྱ་ངན་ལས་འདས་པར་མི་འགྱུར།",
    "ཅི་ཞིག་ན་དེའི་ཚེ་ཡང་ཐམས་ཅད་དུ་སྲིད་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "མིན་ཏེ་ཇི་བཞིན་པའི་རང་བཞིན་དུ་དེ་ངེས་པར་རིག་པར་མ་བྱས་པས་ཏེ།",
    "འོ་ན་མྱ་ངན་ལས་འདས་པ་ལས་མ་རྟོགས་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་དགོས་པར་བྱ་བ་ཇི་ལྟ་བུ་ཞིག་འཐོབ།",
    "སེར་པོ་ལ་སོགས་པའི་རྣམ་པ་བྱེ་བྲག་ཏུ་རྟོགས་པའི་ཁྱད་པར་ཉིད་དོ།",
    "དེའི་དགོས་པ་ཁྱད་པར་ཅན་ནི།",
    "མྱ་ངན་ལས་འདས་པའི་མཚན་དེ་དོན་གྱི་རང་བཞིན་པ་ཁྱད་པར་དུ་རྟོགས་པ་ཡིན་པ་འདི་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "མིན་ཏེ་མིག་དང་རྣ་བ་དང་ཡིད་ལ་བྱེད་པ་དང་ཡུལ་རྣམས་ཀྱི་རྐྱེན་གྱིས་བུམ་པའི་རྣམ་པའི་ཤེས་པ་ཡང་དག་པར་སྐྱེས་ནས་རིག་པ་ལས་བུམ་པར་རིག་གོ་ཤེས་སོ་ཞེས་ཟེར་ཡང་དེ་ཉིད་བེམས་པོ་ཡིན་པའི་ཕྱིར་ན།",
    "ཅི་ད་ནི་མྱ་ངན་ལས་འདས་པ་ཡང་བེམས་པོའི་བདག་ཉིད་དུ་སྨྲའམ་དེ་ལྟ་བུ་བདག་ཉིད་ཡིན་པར་སྨྲའོ་ཞེ་ན།",
    "འོ་ན་བུམ་པ་ལ་སོགས་པའི་བདག་ཉིད་ཐམས་ཅད་ཀྱང་མྱ་ངན་ལས་འདས་པ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ལྟར་གྱུར་ན་ནི་འགྲོ་བ་ཐམས་ཅད་འབད་པ་མི་དགོས་པར་ཡོངས་སུ་གྲོལ་བར་འགྱུར་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་ནི་ཁྱད་པར་འགའ་ཡང་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ནས་ཡང་མྱ་ངན་ལས་འདས་པ་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཡིན་ན་ཡང་སྲིད་པའི་དངོས་པོ་དུས་ཐམས་ཅད་དུ་ཡེ་མེད་པའི་སྐྱོན་དུ་གནས་པ་ཉིད་དེ་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་རྣམས་དེ་བཞིན་པར་དུས་ཐམས་ཅད་དུ་ཡོད་པ་སྟེ།",
    "མྱ་ངན་ལས་འདས་པའི་ཤེས་པ་དག་ལ་འགའ་ཞིག་དང་ཁྱད་པར་དུ་འཇུག་པ་མེད་པས་ནའོ་ཞེ་ནའོ།",
    "འཇིབ་ལས་སྣོད་དུ་བྱས་ན་ཟངས་ཀྱི་སྣོད་དུ་འགྱུར་བ་མེད་པ་དེས་ན་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་དགོས་པ་རང་རིག་པའི་མཚན་ཉིད་དང་།",
    "དེ་ལས་གཞན་ཡང་ཁྱད་པར་ཅན་གྱི་མྱ་ངན་ལས་འདས་པའི་མཚན་ཉིད་ཇི་ལྟ་བའི་རང་བཞིན་ཁོང་དུ་ཆུད་པའོ་ཞེས་གཞག་པར་བྱ་བ་འདི་དག་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "ཅི་རང་རིག་པ་ལས་གཞན་པ་ན་རང་རིག་པ་མ་ཡིན་པར་འགྱུར་བ་ཡིན་པས་འགལ་ལོ་ཞེ་ན།",
    "དེ་ཁོ་ན་ཉིད་ཀྱི་རང་བཞིན་ཇི་ལྟ་བ་བཞིན་དུ་རྟོགས་པ་ལས་མྱ་ངན་ལས་འདས་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་སྨྲ་ན།",
    "གང་ཡང་དོན་དམ་པ་ལ་ནི་ཁྱད་པར་མེད་པ་དེ་བཞིན་ན་ཡང་ཀུན་རྫོབ་ལ་བརྟེན་ནས་ཀུན་རྫོབ་ཙམ་དུ་གཞག་པའི་རྟོག་པ་ཉིད་བྱ་བ་དང་བྱེད་པ་ལ་སོགས་པར་དབྱེ་བ་ཐམས་ཅད་ཀུན་རྫོབ་ཙམ་དུ་གནས་ཀྱི་དོན་དམ་པ་ལ་ནི་བྱ་བ་དང་བྱེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གཉིས་སུ་དབྱེ་བ་རྣམས་འགའ་ཡང་མེད་དེ།",
    "དེ་ཡང་ཇི་ལྟར་རབ་ཏུ་དགའ་བ་ལས་འདྲངས་པར་འགྱུར་རོ་ཞེས་པའི་ཀུན་རྫོབ་ཏུ་གྲུབ་པ་དེའི་རབ་ཏུ་དགའ་བ་དང་འདྲངས་པ་དག་ནི་མྱ་ངན་ལས་འདས་པ་གཞན་ན་འགའ་ཡང་མེད་ཀྱང་དེ་ལྟར་གྲུབ་པ་ཡིན་ནོ།",
    "རིག་པའི་རང་བཞིན་དེ་མི་ཤེས་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་བུམ་པའི་མགྲིན་པ་ལ་སོགས་པ་རྣམས་མི་ཤེས་པར་བུམ་པ་ཤེས་སོ་ཞེས་བྱ་བར་མི་འགྱུར་བས་འདིའི་རང་བཞིན་དངོས་པོ་ཅན་ཞིག་ཏུ་དམིགས་པར་འགྱུར་བའམ།",
    "འོན་ཏེ་དངོས་པོ་མེད་པ་ཅན་ཞིག་ཏུ་དམིགས་པར་འགྱུར་བ་སྟོན་ཅིག།",
    "དེ་ལ་དངོས་པོའི་ཕྱོགས་སུ་གནས་ན་ནི་གཅིག་དང་དུ་མའི་རང་བཞིན་དང་རྣམ་པར་བྲལ་བའི་སྦྱོར་བས་དེ་ཁོ་ན་ཉིད་ཀྱང་རབ་ཏུ་མི་གནས་པ་ཁོ་ནར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པར་རྗེས་སུ་གནས་ན་ཡང་དངོས་པོ་མེད་པ་ནི་དངོས་པོ་སྔོན་དུ་འགྲོ་བ་ཡིན་པའི་ཕྱིར་ན།",
    "དངོས་པོ་ཉིད་དེ་ལྟར་མེད་པས་དངོས་པོ་མེད་པའི་རང་བཞིན་ཇི་ལྟར་ཡོད་པར་སྟོན།",
    "དེ་ནས་གཉིས་ཀའི་རང་བཞིན་རྣམ་པར་བྲལ་བ་ཞེས་བྱ་བ་དེ་ཁོ་ན་ཉིད་ཡིན་པར་སྟོན་ནོ་ཞེ་ན།",
    "དེས་ན་མྱ་ངན་ལས་འདས་པ་དེ་ནུས་པ་ཐམས་ཅད་དང་རྣམ་པར་བྲལ་བ་ཁོ་ནའི་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "དེ་ལྟ་བུ་ཡིན་བཞིན་དུ་ཡང་དེ་ལ་རང་རིག་དེ་ངེས་པར་ཡོད་པ་ཡིན་ན་ནི་ཡེ་ཤེས་དེ་བྱ་བ་དང་བྱེད་པ་ལ་སོགས་པ་ཅན་དུ་ཁས་བླངས་དགོས་སོ།",
    "དེ་ནས་དེ་བཞིན་དུ་གཉིས་ཀྱི་རྣམ་པ་དང་རྣམ་པར་བྲལ་བའི་རང་བཞིན་གྱི་ཕྱིར་ན།",
    "མྱ་ངན་ལས་འདས་པར་ཡང་སོ་སོར་རིག་པ་མེད་པའི་སྐྱོན་དུ་འགྱུར་རོ་ཞེ་ན།",
    "ཇི་ལྟར་ལྐུགས་པ་ལ་སོགས་པས་རོ་མཆོག་མྱངས་པ་ན་སྟོན་པར་མི་ནུས་པའི་དངོས་པོ་ལས་རོ་མྱོང་བ་མེད་དམ་ཅི།",
    "ནུས་པ་རྣམ་པར་མང་གསུངས་པ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྒྱུད་གཞན་དག་ལས་རྒྱུད་འདི་ཉིད་ཁྱད་པར་དུ་འཕགས་པར་གསུངས་པ་ཡིན་ཏེ།",
    "རྒྱུད་འདིར་གང་གསུངས་པའི་སྔགས་ལ་སོགས་པའི་དེ་ཁོ་ན་ཉིད་ནི་ཐོས་པ་ཙམ་གྱིས་འགྲུབ་པར་བརྗོད་དེ།",
    "ལན་ཅིག་བརྗོད་པ་དེ་ཉིད་ཀྱིས་དངོས་གྲུབ་སྩོལ་པར་མཛད་པ་དང་།",
    "འདིར་སྔོན་དུ་བསྙེན་པ་ཡང་མི་དགོས་ཤིང་དེ་བཞིན་དུ་བཟླས་པ་འབུམ་ལ་སོགས་པ་མེད་པར་ཡང་འགྲུབ་པོ།",
    "སྐུ་གཟུགས་དག་ནི་དགས་པ་དང་།",
    "དེ་ནས་སྦྱོར་བ་བཅོ་བརྒྱད་གསུངས་ཞིས་བྱ་བ་ནི་ཟོས་ཏེ་མྱོང་བར་བསླད་པར་བྱ་བ་གསུངས་པ།",
    "དེ་ནས་རབ་ཏུ་སྦྱོར་བ་བྱས་མ་ཐག་ཏུ་ཟོས་པ་རྣམས་འཚོའོ།",
    "རྒྱན་པོ་འགྱེད་དང་ཞེས་བྱ་བ་ནི་གང་དུ་ཟོས་པ་འདི་ཡོད་པ་དེ་ལ་བསམ་གཏན་དང་ལྡན་པའི་སྔགས་པས་རྒྱན་པོ་རྩེ་བར་བྱས་པ་ལས་དེ་ནས་ཟོས་པ་འདི་འཚོ་བར་འགྱུར་རོ།",
    "དེ་ཉིད་ཤེས་རབ་ཀྱི་པདྨར་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་དེ་བཞིན་པའི་ཆོ་གས་ཡང་དག་པར་རིག་པ་ལས་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་ལྷ་རྣམས་ཚོགས་པར་ཉམས་སུ་མྱོང་བར་བྱ་བ་སྟེ།",
    "དེ་ཉིད་དུ་དེ་བཞིན་པར་དམིགས་པ་མེད་པའི་ཡེ་ཤེས་ཀྱི་མཆོག་ཡང་དག་པར་རིག་པ་ལས་བཅུད་ཀྱིས་ལེན་ལ་སོགས་པ་ཐམས་ཅད་དུ་འགྱུར་ཏེ།",
    "ད་ནི་སྔགས་ཀྱི་དངོས་གྲུབ་གསུངས་པ།",
    "རྣལ་འབྱོར་མ་རྣམས་གྲུབ་པར་བྱེད་པའི་སྤོས་ལ་སོགས་པ་སྦྱིན་པའི་སྔགས་དེ་སྲིད་པ་གསུངས་པ།",
    "ཡང་དག་པར་བྱོན་ནི་བྱིན་གྱིས་རློབ་པའི་ཕྱིར་རོ།",
    "དེ་ནི་མི་སྣང་བར་བྱེད་པའི་རབ་ཏུ་སྦྱོར་བ་གསུངས་ཏེ།",
    "དེའི་ལག་པའི་མཚོན་ཆ་གསུངས་པ།",
    "ཇི་སྐད་དུ་གསུངས་པ་དེ་དག་ཉིད་ཆོ་ག་བཞིན་དུ་བླངས་ཏེ་རྣལ་འབྱོར་བས་བརྒྱ་རྩ་བརྒྱད་དུ་སྔགས་ཀྱི་བཟླས་པ་བྱའོ།",
    "བཟླས་པར་བྱ་བའི་སྔགས་ཀྱང་སུངས་པ།",
    "དེ་བཞིན་དུ་སེམས་ཀྱིས་བྱས་པ་ཙམ་གྱིས་སྨྱོ་བར་བྱེད་དོ།",
    "བཀྲུས་པ་ཙམ་གྱིས་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་པའི་མཐེ་བོ་དེ་འོ་མས་བཀྲུས་བར་བྱས་ན་དགྲ་བོ་རྣམས་སླར་ཡང་འཚོ་བར་འགྱུར་རོ།",
    "ལྕགས་ཀན་ཏེ་ཞེས་བྱ་བ་ཕྱེ་མར་བྱས་པ་ཡང་དེར་བླུགས་སོ།",
    "དེ་ནས་གཞན་ཡང་གཞོན་ནུ་མའི་རྡོ་རྗེའི་རྩིས་ཀྱི་དོན་གྱི་རབ་ཏུ་སྦྱོར་བ་གཞན་དག་གསུངས་པ།",
    "གཞོན་ནུ་མ་དེ་ལྟ་བུའི་དེའི་རབ་ཏུ་སྦྱོར་བ་འདི་བྱས་ནས།",
    "གཞན་ཡང་གྲུབ་པའི་རལ་གྲི་བདུན་པོ་ཁ་ནས་འཐོན་པར་འགྱུར་བའི་སྦྱོར་བ་གཞན་དག་སྦྱར་བར་བརྗོད་པ།",
    "རབ་ཏུ་སྦྱོར་བ་འདིས་རིག་པ་འཛིན་པའི་དངོས་གྲུབ་སྐྱེད་པར་བྱེད་དོ།",
    "ལྕགས་གསུམ་གྱིས་དཀྲིས་ནས་རི་ལུར་བྱས་ཏེ་ཞེས་བྱ་བ་ནི་ཟངས་མ་དང་།",
    "ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་གཏན་ལ་དབབ་པ་གསུངས་པའི་འགྲེལ་པ།"
  ]
}