    "སྔ་མ་ནི་གཟུགས་ཀྱི་སྐུའི་བྱེ་བྲག་གིས་ས་སོ།",
    "ཕྱི་མ་ནི་མིང་གི་ཚོགས་ཀྱི་བྱེ་བྲག་གིས་ས་སོ།",
    "རྒྱུན་ཆགས་སུ་ཐོགས་པ་མེད་པ་༦སྟོན་པས་ཐོགས་པ་མེད་པའི་སྤོབས་པ་ནི་གང་གི་ཕྱིཕྱིར།",
    "རིག་༧པ་རྣམ་པ་བཞི་ཤེས་པ་ཤིན་ཏུ་རྣམ་པར་བྱང་བར་བྱས་པས་རིག་༨པ་གང་གིས་༩གང་རིགས་སམ་མི་རིགས་པ་བུ་དེ་ཁོང་དུ་ཆུད་པའི་ཕྱིར་རིགས་པའི་སྤོབས་པ་ནི།",
    "གང་གི་ཕྱིར།",
    "དོན་རྗེས་སུ་དྲན་པས་གྲོལ་བའི་སྤོབས་པ་ནི་གང་གི་ཕྱིཕྱིར།",
    "གྱི་རླབས་༢དེ་ནི་གང་གིས་དེ་ལ་བྱིན་གྱིས་རློབས་༢པའོ།",
    "གདུལ་བྱ་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་གྲངས་དང་དཔེ་སྣ་ཚོགས་ཀྱི་ཐེ་ཚོམ་གཅོད་པས་གོ་བར་བྱེད་པའི་སྤོབས་པ་ནི་གང་གི་ཕྱིཕྱིར།",
    "སྤྱིའི་མཚན་ཉིད་རྣམ་པ་གསུམ་གྱིས་༥རྣམ་པར་ཤེས་པ་རྒྱུན་མི་འཆད་པར་མངོན་དུ་བྱེད་པས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་སྤོབས་པ་ནི་གང་གི་༦ཕྱིར།",
    "ཐམས་ཅད་ཀྱི་རྗེས་སུ་སོང་བའི་བློ་མི་འདོར་བ་ཞེས་གསུངས་པའོ།",
    "གྱི་ཡོན་ཏན་༤ཡོངས་སུ་འཛིན་པ་ནི་ཏིང་ངེ་འཛིན་གྱི་རྟེན་གྱི་ཡོན་ཏན་ཡོངས་སུ་འཛིན་པ་དི་ཡང་རང་གི་དོན་དང་།",
    "ཚེ་རབས་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ད་ག་ན་ཚོགས་ཤིན་ཏུ་རྫོགས་པར་བྱས་པས་རྒྱུད་ཡོངས་སུ་སྨིན་པར་ནམ་པར་དག་པ་ནི་གང་གི་ཕྱིར་ཚོགས་ཤིན་ཏུ་བསགས་པ་༡ཞེས་གསུངས་པའོ།",
    "གང་གི་ཕྱིར་ཡོངས་སུ་སྦྱང་བ་ལེགས་པ་བྱས་པའི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "གང་གི་ཕྱིར་མོས་པ་འོད་གསལ་བ་རྣམ་པར་སྦྱངས་པའི་ཕྱིར་ཞེས་གསུངས་པ་སྟེ།",
    "གཟུངས་ཀྱི་སྒོ་འགལ་བ་མེད་པ་ཤིན་ཏུ་རྟོགས་༤པས་སྤོབས་པ་རྣམ་པར་དག་པ་ནི་གང་གི་ཕྱིཕྱིར།",
    "དེ་ལ་ཡི་གེའི་ཕྱི་མོ་རྣམས་ཇི་སྙེད་པར་གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱང་དེ་སྙེད་དོ་༦།",
    "དེའི་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་རྒྱུ་བསྟན་༦ཏེ།",
    "མོས་པ་འོད་གསལ་བ་རྣམ་པར་སྦྱངས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་འདུན་པར་བྱེད་པའི་རྒྱུ་ཡིན་ཏེ།",
    "མཐུའི་ཁྱད་པར་ཡང་ད་ག་པར་བསྟན་པས་བསམ་གྱིས་མི་ཁྱབ་པའི་གནས་ལ་མོས་པས་འཇུག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གདུལ་བྱ་རྣམས་ཀྱི་རང་གི་དོན་ཐོབ་པ་ཆུད་མི་ཟ་བའི་ཕྱིར་ར་རོ་། ཐུགས་ཀྱི་༧བྱིན་གྱིས་བརླབས་པ་༐",
    "ཕྱག་གིས་རེག་པར་མཛད་པ་སྟེ་གང་གི་ཕྱིཕྱིར།",
    "གང་ལས་བསམས་༡ནས་བད་ག་གིས་དེ་སྐད་དུ་སྨྲས་པ་དེ་དག་ནི་འདས་པ་ད་ང་།",
    "རིང་དུ་སོང་ཞེས་བྱ་བ་དང་།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ས་དང་པོར་ཆུད་པ་ཡིན་གྱི་མོས་པས་སྤྱོད་པས་བསྡུས་པ་ནི་མ་ཡིན་ན་ནོ།",
    "དེ་བཞིན་ཉིད་ལ་དམིགས་པ་རོ་གཅིག་པའི་རྣམ་པ་ཡིན་པས་དམིགས་པའི་རྣམ་པ་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ནི་གང་གི་ཕྱིར་ཐ་དད་པ་མེད་པ་ཞེས་གསུངས་པའོ།",
    "འཇིག་རྟེན་ལས་འདས་པ་ཉིད་ཡིན་པའི་ཕྱིར་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་ཡུལ་མ་ཡིན་པས་ངོ་བོ་ཉིད་ཀྱིས་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ནི་གང་གི་ཕྱིར་བལྟར་མི་མཐོང་བ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་བརྟེན་ནས་བྱུང་བའི་གཟུགས་རྣམས་ཀྱིས་ཟད་པ་མེད་པའི་ཕྱིར་འབྲས་བུ་མི་རྟག་པ་སྡུག་༡པ་འགྲུབ་པའི་རྒྱུ་ཉིད་དུ་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ནི་གང་གི་ཕྱིར་ནམ་མཁའི་མཐས་གཏུགས་པ་ཞེས་གསུངས་པའོ།",
    "མྱ་ངན་ལས་འད་ས་པ་ལ་གཞོལ་བའི་ཕྱིར་འབྲས་བུ་རྟག་པའི་རྒྱུ་ཉིད་དུ་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ནི་གང་གི་ཕྱིར་ཕྱི་མའི་མཐའི་མུར་ཐུག་པ་ཞེས་གསུངས་པའོ།",
    "ཡན་ལག་གི་དངོས་པོ་བསྟན་པའི་ཕྱིར་ར་རོ།",
    "ཉེ་བའི་༢ཡན་ལག་གི་རྣམ་པ་བསྟན་པའི་ཕྱིར་ཏེ།",
    "རང་གི་ཡིད་ལ་བྱེད་པ་ལ་དམིགས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཉོན་མོངས་པའི་ཤིང་བསྲེགས་༧པའི་ཡེ་ཤེས་དང་ལྡན་པའི་ཕྱིར་འོད་འཕྲོ་བ་༨ཅན་ན་ནོ།",
    "འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་དམན་པ་ལས་ཤིན་ཏུ་འདའ་བའི་ཕྱིར་རིང་དུ་སོང་བའོ།",
    "ལུང་གི་དོན་དུ་བསྟན་པ་ད་ང་།",
    "ཅིའི་ཕྱིར་ཚིགས་སུ་བཅད་༥པའི་ད་བྱངས་ཁོ་ན་ཞེ་ན་ཡི་གེ་ཉུང་ངུ་དག་གིས་དོན་མང་དུ་བསྡུ་བའི་ཕྱིར་དང་།",
    "དེ་ལ་ཞལ་ནས་གསུངས་པའི་ཚིགས་སུ་བཅད་པའི་གཞུང་ནི་ཕལ་ཆེར་དུབ་པས་གཞུང་གང་གིས་དེ་ཤེས་པ་རྣམས་ཀྱིས་དོན་དེ་དམིགས་པ་ཉིད་གཞུང་ཡིན་ནོ།",
    "ཉེས་པ་དང་བྲལ་བ་གཉིས་ཀྱིས་རབ་ཏུ་ཕྱེ་བ་ཡིན་ཏེ་དེ་ལ་དྲན་ད་ང་ཡེ་ཤེས་ལྡན་པ་ཉིད་ཀྱིས་ནི་ཀུན་དུ་རྟོག་པ་ཉོན་མོང་ས་པ་ཅན་རྣམས་དང་།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ནི་ཀུན་དུ་རྟོག་པ་ཉོན་མོངས་པ་ཅན་གྱི་གཉེན་པོ་སྟེ།",
    "དེ་ལ་གང་གིས་འཆད་པར་མི་འགྱུར་བའི་ཉེས་པ་ནི་རྣམ་པ་གསུམ་སྟེ།",
    "གཞན་ད་ག་གིས་ཤེས་པ་མི་བཟོད་པའོ།",
    "གཞན་ད་ག་གི་༢དེ་བཞིན་དུ་ཡིད་ཆེས་པས་རྣམ་པར་གྲགས་པར་རྣམ་པར་ངེས་པ་ཉིད་ད་དང་།",
    "དེ་དག་གི་གཉེན་པོར་རྙོག་པ་མེད་པ་རྣམ་པ་དྲུག་ཡོད་པར་རིག་པར་བྱའོ།",
    "ཡེ་ཤེས་དང་ལྡན་པ་ཞེས་བྱ་བ་ཚིག་དྲུག་པོ་དེ་དག་གིས་ནི་དེ་དག་གོ་རིམས་བཞིན་དུ་ཡོངས་སུ་བསྟན་ཏོ།",
    "དེ་ལྟར་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་ནི་རང་གི་རིགས་ཡོངས་སུ་ད་ག་པ་བསྟན།",
