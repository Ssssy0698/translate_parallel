    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱིས་ནི་དོན་བརྒྱད་བསྡུས་ལ་བསྡུ་བྱ་དེ་དག་ཀྱང་ཤེར་ཕྱིན་ཡུམ་མ་ཚང་བ་མེད་པ་ཡིན་ཞིང་ཞེས་པའོ།",
    "དགོས་པ་ནི་མཁྱེན་གསུམ་དེས་ནི་ཚིག་དོན་གྱི་སྐབས་ནས་འཆད་པར་འགྱུར་བའི་ཚུལ་གྱིས་སྲས་བཞིའི་བཞེད་དོན་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་སྒྲུབ་ནུས་པ་ཡིན་ནོ་ཞེས་གཞན་ལ་བསྟན་པའི་ཕྱིར་ཏེ།",
    "འོ་ན་མཁྱེན་གསུམ་གྱིས་དངོས་བརྒྱད་བསྡུས་ཚུལ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དངོས་པོ་བརྒྱད་དུ་ཕྱེ་བ་དེ་དག་དངོས་ཀྱི་ཚུལ་དུ་དཔྱད་ན་རྣམ་མཁྱེན་གྱི་སྐབས་ཞེས་གཅིག་ཁོ་ནར་གདགས་རིགས་ཏེ་ལམ་ཐམས་ཅད་ཀྱིས་དེ་དངོས་དང་།",
    "དེ་ལྟར་ཐམས་ཅད་དེ་གསུམ་དུ་འདུས་པའི་སྐབས་བརྒྱད་དུ་ཕྱེ་བ་ཡང་སྐབས་གསུམ་དུ་བསྡུ་བར་ཤེས་པར་བྱ་བའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱིས་དོན་བརྒྱད་བསྡུས་ཞེས་སོགས་སྨོས་སོ།",
    "སྐབས་བཞི་པའི་རྣམ་མཁྱེན་གྱི་རྣམ་པའི་ནང་ནས་བྱང་ཕྱོགས་སོ་བདུན་ལམ་བདུན་དུ་བསྡུས་པ་འདི་གཞིར་བསྟན་ཏོ།",
    "སྐབས་གཉིས་པ་ལས་སྦྱོར་ལམ་དང་མཐོང་ལམ་ཁྱད་པར་དང་བཅས་པར་བསྟན་ཅིང་སྐབས་བཞི་པར་སྒོམ་ལམ་རྣམ་པའི་སྒོ་ནས་བསྟན་ཏོ།",
    "གཙོ་བོར་མ་བྱས་པའི་ཕྱིར་རོ།",
    "ཡང་སྐབས་དྲུག་པ་སྦྱངས་དེ་ནས་སྒོམ་ལམ་ཁྱད་པར་ཅན་ལྔ་པ་ལས་བསྟན་པ།",
    "བདུན་པར་དངོས་ཁོ་ནར་བསྟན་པ་རྣམ་པ་དང་བཅས་ཤིང་ངེས་འབྱུང་སྒྲུབ་པའི་ངོ་བོར་གྱུར་པ་དེ་རྫོགས་པར་བྱེད་དེ།",
    "སྐབས་དྲུག་པ་ནི་འབྲས་བུ་ཐོབ་པར་བྱ་བ་ལ་འདྲིས་པར་བྱེད་པས་ལམ་སྤྱིར་སྦྱར་རོ།",
    "དེ་ལྟར་རྣམ་མཁྱེན་གྱི་སྐབས་སུ་སྐབས་ཀྱི་དོན་ཐམས་ཅད་འདུས་པར་དགོངས་ནས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་ལམ།",
    "ཞེས་ལམ་གཅིག་པུ་ཁོ་ན་འབྲས་བུ་དང་བཅས་པར་བསྟན་ཏོ་ཞེས་སོགས་དང་།",
    "གཞན་ཡང་སྐབས་ཀྱི་འཇོག་ཚུལ་དུ་མ་ཞིག་བྱས་ནས་འཆད་དོ།",
    "འབྲས་བུ་ཉིད་ལ་སོགས་པའི་སྒོ་ནས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱིས་དོན་བརྒྱད་བསྡུས་པར་དགོངས་ནས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསྟོད་དོ་ཞེས་སྐབས་གསུམ་དང་དྲུག་དང་།",
    "བརྒྱད་དུ་བཞག་པའི་དོན་བརྒྱད་མཁྱེན་གསུམ་དུ་འདུས་པར་འཆད་དོ།",
    "སྐབས་གསུམ་དུ་བསྟན་པའི་ཕྱིར་དུ་གསུངས་པར་བྱས་ནས།",
    "ས་བརྒྱད་ཀྱི་བྱས་པ་རྟོགས་པའི་ས་དང་སྦྱར་རྒྱུ་ཡིན་པ་ལ་དེ་ལྟར་མ་ཤེས་པ་དང་།",
    "སློབ་དཔོན་གྱི་དགོངས་པ་ཅུང་མིན་པར་གོའོ།",
    "ཚུལ་དེ་མ་རྟོགས་པར་བསྡུ་བྱ་སྡུད་བྱེད་ཐ་དད་ཁོ་ནར་བཟུང་ནས་སྐབས་དོན་ལས་ཉམས་པར་མི་བྱའོ།",
    "སྲས་བཞིའི་བཞེད་དོན་སྒྲུབ་པར་བསྟོད་པའི་སྒོ་ནས་སོ།",
    "ཐོབ་པར་མཛད་པ་གང་ཡིན་པ་ཉན་ཐོས་ཀྱི་ཡུམ་ཞེས་སྦྲེལ་ཏེ་དང་ཞེས་པ་འོག་མ་བསྡུ་བའི་ཚིག་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་པ་ལྟར་རང་ཉིད་ཀྱིས་ཀྱང་སྒྲ་བཅས་སུ་མཉན་དགོས་ཤིང་གདུལ་བྱ་ལ་ཡང་སྒྲ་བཅས་སུ་ཐོས་པར་བྱེད་པའི་ཉན་ཐོས་དང་།",
    "རང་རྒྱལ་གྱིས་ཀྱང་ཐབས་དེ་ཁོ་ན་ལ་བརྟེན་ནས་འབྲས་བུ་དེ་ཐོབ་པར་བྱེད་དགོས་པའི་ཕྱིར་རོ།",
    "ཉན་ཐོས་ལས་ལྷག་པའི་ཁྱད་པར་ཡོད་དོ།",
    "འོ་ན་དེ་གཉིས་ཀྱི་ཁྱད་པར་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ཁ་ཅིག་ཀུན་འབྱུང་མ་ལུས་པར་སྤངས་ཀྱང་སྡུག་བསྔལ་མ་སྤངས་པ་དང་།",
    "སྡུག་བསྔལ་ཡང་མ་ལུས་པར་སྤངས་པ་ཁྱད་པར་ཡིན་ཞེས་འཆད་པ་ནི་མི་འཐད་དེ།",
    "དགྲ་བཅོམ་ལ་ཡང་སྲིད་འཕེན་ངེས་ཀྱི་ལས་ཉོན་མ་ལུས་པར་ཟད་ཀྱང་ཊཱི་ཀ་དོན་གསལ་དུ།",
    "ཕུང་པོའི་རྒྱུན་ཆད་པ་གཉིས་ཁྱད་པར་དུ་འདོད་དེ།",
    "རིགས་པ་དྲུག་ཅུ་པའི་འགྲེལ་པར།",
    "འདུས་མ་བྱས་པ་འགོག་གཉིས་དང་།",
    "ཅེས་བཀོད་ནས་དེའི་འགྲེལ་པར།",
    "དེ་ལྟར་འདུས་མ་བྱས་བཞི་ལས།",
    "རྫས་སུ་ཡོད་པར་སྨྲ་བ་ནི།",
    "དངོས་པོ་ཡིན་པར་སྨྲ་བ་སྟེ།",
    "རྫས་སུ་ཡོད་པ་མ་ཡིན་པར་སྨྲ་བ་ནི།",
    "དངོས་པོ་མེད་པ་ཡིན་པར་སྨྲ་བ་སྟེ།",
    "ཕུང་པོའི་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་ལ་གནས་པ་ལ་ནི་སྒྲིབ་པ་དང་བཅས་པ་དང་སྒྲིབ་པ་མེད་པའི་རྣམ་པར་བཞག་པ་ཡོད་ཀྱི་ཕུང་པོའི་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་ལ་གནས་པ་ལ་ནི་སྒྲིབ་པ་རྣམ་པར་བཞག་པ་མེད་དོ།",
    "སྐུ་ཚེའི་འདུ་བྱེད་བཏང་བ་ན་སྡུག་བསྔལ་གྱི་ཕུང་པོ་རགས་པ་དོར་ཞིང་དག་པའི་འཇིག་རྟེན་གྱི་ཁམས་སུ་པདྨའི་སྦུབས་སུ་ཡིད་ཀྱི་ལུས་ཀྱིས་གནས་པ་ན་ལྷག་མེད་དུ་བཞེད་པར་མངོན་ནོ།",
    "སྒྲུབ་པར་མཛད་དོ།",
    "ལམ་གསུམ་པོ་ཐམས་ཅད་དོན་དམ་པར་སྐྱེ་བ་མེད་པར་དང་ཐ་སྙད་དུ་རྒྱུ་ངོ་བོ་འབྲས་བུ་རྣམས་རྟོགས་པའི་ངོ་བོ་ཉིད་ཀྱིས་སོ།",
    "རྣམ་པ་ཐམས་ཅད་སྐྱེ་བ་མེད་པར་ཐུགས་སུ་ཆུད་པའི་རྣམ་མཁྱེན་གང་དང་ལྡན་ན་སྟེ་དེ་ཡིས་སོ།",
    "གང་སྤྱི་སྒྲ་ཡིན་པའི་ཕྱིར་བྱེ་བྲག་རྣམ་མཁྱེན་ལ་ཇི་ལྟར་གོ་ཞེ་ན།",
    "སྤྱི་སྒྲ་ཡིན་ཡང་ཁྱད་པར་གྱི་ཚིག་ཐུབ་རྣམས་དང་འབྲེལ་བའི་ཕྱིར་གོའོ།",
    "མཁྱེན་པ་གསུམ་ལ་བསྟོད་པ་ལས།",
    "དོན་གྱི་ཤུགས་ཀྱིས་ཀྱང་རྣམ་མཁྱེན་ལ་གོ་སྟེ།",
    "མཐོང་ལམ་གྱིས་བདེན་པ་མྱུར་དུ་རྟོགས་པར་བྱེད་པས་མྱུར་དུ་འགྲོ་བ་དང་།",
    "དེ་ཡང་གཞན་དག་ལ་མཐུན་པར་སྐོར་བར་འགྱུར་བ་དང་དེ་དག་ཀྱང་གཞན་དག་ལ་མཐུན་པར་སྐོར་བར་འགྱུར་ཏེ།",
    "དེ་བས་ན་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་མཐུན་པར་བསྐོར་བའི་དོན་གྱིས་འཁོར་ལོ་ཞེས་བྱའོ།",
    "དེ་ལྟར་ཡན་ལག་བཅུ་གཉིས་གསུངས།",
    "དེ་ལྟར་བྱས་ན་དྲིན་ལན་བསབ་པ་ལས།",
    "རྣམ་པར་དག་ཚུལ་གང་ཡིན་ཀླུ་མགོའི་གདེངས་ཀ་ཅན།",
    "གལ་ཏེ་མཁྱེན་གསུམ་དང་གང་ཟག་བཞི་ཡུམ་སྲས་སུ་འདོད་ན།",
    "ཕྱི་མས་ནི་གནས་སྐབས་ཀྱི་བཞེད་པ་སྒྲུབ་པས་ཡུམ་དུ་བཞག་པར་སྣང་ཞིང་།",
    "ཡུམ་དང་སྲས་རྣམ་པར་གཞག་འཇོག་ཡིན་པའི་ཕྱིར་ཏེ།",
    "མཁྱེན་གསུམ་གྱི་རྟོགས་པ་རྒྱུད་ལ་ལྡན་པས་རིམ་པ་ལྟར་ཉན་རང་།",
    "ཡུམ་གྱིས་བཞེད་དོན་གསུམ་སྒྲུབ་པ་ནི་ཕན་འདོགས་པ་དང་གཞི་ཤེས་ལམ་ཤེས་རྒྱུན་མཐའ་མན་ཆད་ཀྱི་རྣམ་མཁྱེན་རྗེས་མཐུན་པ་གསུམ་ནི།",
    "རྣམ་མཁྱེན་བརྙེས་པས་དེ་བཞིན་གཤེགས་པའི་གྲངས་སུ་འགྲོ་ཞེས་གསུངས་ཀྱི་ཡུམ་སྲས་སུ་མ་གསུངས་པ་དང་།",
    "གཞན་དག་གཉེན་པོ་དང་ལ་ལ་རྣམ་པ་བརྗོད་བྱ་ཡིན་ནོ་ཞེས་ཕྱོགས་སྔར་བྱས་ནས་ཕྱོགས་དང་པོ་ལྟར་ན་མན་ཆད་ལན་དུ་བྱེད་དོ།",
    "འདིར་ཡང་བརྟག་པ་བྱས་པ་ལྟར་ཁས་བླངས་ན་སྐྱོན་འཇུག་པར་འདོད་པས་དེ་མི་འགོག་པའི་ཕྱིར་རོ།",
    "གང་བརྗོད་བྱར་བསྡུས་ནས་རྒྱན་དུ་བྱེད་ཅེས་འདྲི་བའི་ཕྱིར་བརྩམ་པར་དམ་བཅའི་གཞུང་ལ་རྩོད་དོ།",
    "དེའི་གཞུང་དུ་སྡུད་པར་རིགས་སོ།",
    "མཆོད་བརྗོད་ཀྱིས་བརྩམ་པར་དམ་བཅས་པ་ལས་འཕྲོས་ཤིང་དགོས་འབྲེལ་གྱི་མཚམས་སྦྱོར་གྱི་སྔོན་དུ་བཀོད་པའི་ཕྱིར་སྔ་མ་རིགས་སོ།",
    "ཅི་ཕྱོགས་སྔ་མར་བརྟག་པ་ཇི་ལྟར་བྱས་པ་དེ་ལྟར་ཁས་བླངས་ན་སྐྱོན་དེ་དག་འོང་ངམ་མི་འོང་།",
    "རྒྱན་གྱི་སྣང་བར་ཕྱོགས་དང་པོ་ལྟར་ན་མན་ཆད་རང་གཞུང་དུ་བྱས་པ་དང་འགལ་བ་དང་།",
    "མི་མཐུན་པའི་ཕྱོགས་སྤང་བར་བྱ་བའི་ཕྱིར་གཉེན་པོའི་ཕྱོགས་མ་ལུས་པ་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཤེས་བྱ་མ་ལུས་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རྣམ་པ་མ་ལུས་པ་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཤེས་བྱའི་རྣམ་གྲངས་མ་ལུས་པ་ཤེས་པར་བྱ་བ་ཙམ་གྱི་ཕྱིར་དུ་རྫས་བཏགས་ལ་སོགས་པའི་རྣམ་པ་མ་ལུས་པ་བསྟན་པར་འདོད་དོ།",
    "ཁ་ན་མ་ཐོ་བ་དང་བཅས་མ་བཅས་ལ་སོགས་པའི་འགྲེས་དུ་མ་ཞིག་གསུངས་པ་རྣམས་སོ།",
    "མཆོད་བརྗོད་ཀྱི་སྐབས་སུ་མཁྱེན་གསུམ་གྱི་སྒོ་ནས་བསྟོད་པས་བརྗོད་བྱ་དང་མཐུན་པའི་བསྟོད་ཕྱག་ཡིན་པའི་ཕྱིར་ཤུགས་ལ་དེ་གསུམ་བརྗོད་བྱར་བྱེད་པའི་བསྟན་བཅོས་རྩོམ་པར་ཁས་བླངས་པ་ལ།",
    "མཁྱེན་གསུམ་ངོ་བོའི་སྒོ་ནས་མཚོན་མི་ནུས་པས་ཡུལ་གསུམ་པོ་འདི་འདི་ལྟར་རྟོགས་པ་མཁྱེན་པ་འདིའོ་ཞེས་ཡུལ་དང་འབྲེལ་བར་བསྟན་དགོས་ལ།",
    "དེ་ལྟ་ན་གྲུབ་ཟིན་བསྒྲུབས་༡པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "དེས་ན་སྤང་གཉེན་གང་ཡིན་རྟོགས་པ་མེད་པའི་ཉེས་པར་འགྱུར་རོ།",
    "འདི་དང་འོག་མ་གཉིས་ཀྱི་ཡང་སྒྲས་འབད་པ་དོན་མེད་བསྡུ་བ་རུ་སྦྱར་ཡང་བརྟག་པ་སྔ་མ་སྔ་མ་ལ་སྐྱོན་ཡོད་པར་མ་ཟད་པའོ།",
    "འོ་ན་རང་ལུགས་ལ་ཡང་རྣམ་པ་གཞི་བཅས་སུ་བསྟན་དགོས་པའི་ཕྱིར་ཟློས་པར་འགྱུར་ཞེ་ན།",
    "དེ་ཡང་འདོད་ན་དེའི་ཕྱིར་ཡུམ་གསུངས་པ་ལ་དོན་ནམ་དགོས་པ་མེད་པ་ཡིན་ནོ་སྙམ་དུ་ཟུར་ན་གནས་པའི་རྒོལ་བ་དཔྱོད་ལྡན་གཞན་དག་སེམས་ཤིང་དོགས་པར་འགྱུར་བ་མིན་ནམ་སྟེ་ཡིན་ནོ་ཞེ་ན་ཞེས་པ་སྟེ།",
    "གཞི་གཉེན་རྣམ་པའི་ཕྱོགས་གསུམ་ཆར་གྱི་དོན་རྣམས་བརྗོད་བྱར་བསྡུས་པའི་སྒོ་ནས་ཀྱང་མཁྱེན་པ་གསུམ་གའི་རྒྱན་དུ་བྱེད་པའི་ཕྱིར་རོ།",
    "དོན་ནི་མཁྱེན་གསུམ་ཤེས་པའི་ཕྱིར་དུ་གསུམ་ཆར་བསྡུས་ཞེས་པའོ།",
    "ཀྱང་ནི་གཞི་བསྡུས་པས་གཞི་ཤེས་ཀྱི་རྒྱན་དུ་བྱེད་པའམ་དེ་གསལ་བར་བྱེད་པར་མ་ཟད་ཅེས་པའི་ཚུལ་གྱིས་ཕན་ཚུན་བསྡུ་བའོ།",
    "གོ་རིམས་ཇི་ལྟ་བ་བཞིན་ནི་མངོན་རྟོགས་བཞི་དང་མཁྱེན་གསུམ་སོ་སོ་སྦྱོར་བའོ།",
    "འབྲུ་གཉེར་ཚུལ་ཚིག་དོན་གྱི་སྐབས་འདི་ལྟར་འཆད་ཤེས་པ་ཡང་དཀོན་པར་སྣང་ངོ།",
    "གང་ཟག་བཞིའི་༢མངོན་རྟོགས་རྣམས་མཁྱེན་གསུམ་གྱིས་བསྡུས་པར་ཅིས་གྲུབ་ཅེ་ན།",
    "ཞེས་རྣམ་པར་སྦྱར་ཏེ་གཞན་གཉིས་ལ་ཡང་དེ་བཞིན་དུའོ།",
    "མཁྱེན་པ་ཡིན་ལ་ལམ་ཤེས་དང་རྣམ་མཁྱེན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དྲི་བ་ནི་བཅོམ་ནས་ལགས་ཀྱི་བར་རོ།",
    "གཞན་དོན་འབད་མེད་དུ་འགྲུབ་པར་གྱུར་ཅིག་ཅེས་པ་གྲུབ་པའོ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་གཞན་དོན་ཅི་ཙམ་ཞིག་ལ་འབད་པས་འཚང་རྒྱ་བའི་གཞན་དོན་དེ་དག་རྫོགས་པར་བྱས་པའོ།",
    "ཡང་དག་མཐའ་ངོས་གཟུང་བ་དང་བཞིས་རིག་པར་བྱའོ།",
    "ཡང་ཁ་ཅིག་ཐེག་དམན་གྱི་རྟོགས་པ་ས་དང་པོར་རྫོགས་ལ་སྤངས་པ་ས་བརྒྱད་པར་རྫོགས་ཏེ།",
    "དེས་ན་ས་ལྷག་མར་དེའི་གོམས་པ་ཁྱད་པར་དུ་འགྲོར་ཡོད་ཀྱང་སྔར་མ་རྟོགས་པ་རྟོགས་པར་བྱར་མེད་དེ།",
    "སྔ་རོལ་ཏུ་དེ་དག་རྫོགས་ན་ཉེས་པ་ཀུན་ཟད་ཡོན་ཏན་ཀུན་ལྡན་ཡང་ཡིན་པའི་སློབ་པ་ཡོད་པར་འགྱུར་རོ།",
    "རྣམ་མཁྱེན་ངོས་བཟུང་བར་ཡང་དག་མཐའ་མངོན་དུ་བྱས་པར་འཆད་པའི་ཕྱིར་རོ།",
    "དེ་སྟོན་པར་བྱེད་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་དེ་སྐད་ཅེས་བྱའོ་ཞེས་དང་།",
    "ཡང་དག་མཐའ་ནི་འདུས་བྱས་ཀྱི་རྣམ་པ་ཐམས་ཅད་དབེན་པ་སྟེ།",
    "ཚོགས་ཡོངས་སུ་མ་རྫོགས་པར་རང་ཉིད་ཞི་བའི་དབྱིངས་སུ་རྟག་ཏུ་གནས་པ་ན་རྗེས་ཐོབ་ལ་གཟུགས་ཀྱི་སྐུ་སྣང་ནས་དོན་མཛད་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ས་བརྒྱད་པ་ལ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་མ་བསྐུལ་ན་མྱ་ངན་ལས་འདའ་བར་གསུངས་པ་ཡང་དེ་ལ་དགོངས་སོ།",
    "དྲི་བ་ནི་བཅོམ་ལྡན་འདས་ནས་ལགས་ཀྱི་བར་རོ།",
    "རྒྱས་པ་སྟོང་ཕྲག་བརྒྱ་པ་ལས་ཀྱང་གསུངས་སོ།",
    "རྣམ་པར་ཤེས་པ་དྲུག།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དོ།",
    "རྣམ་མཁྱེན་ངོས་གཟུང་བའོ།",
    "དེ་ལྟ་བུའི་བག་ཆགས་ཀྱི་མཚམས་སྦྱོར་བ་ཟད་པར་སྤངས་པ་ཅན་ནི་རང་དོན་ནོ།",
    "བདག་མེད་མངོན་སུམ་དུ་བྱས་པ་ཡང་དག་མཐའ་མངོན་དུ་བྱས་པའི་དོན་དུ་འཆད་དོ།",
    "གལ་ཏེ་དོན་གཉིས་གྲུབ་པ་དེ་རྣམ་མཁྱེན་གྱི་ངོ་བོ་ཡིན་པས་འབྲས་བུ་ཇི་ལྟར་འཐད་ཅེ་ན།",
    "རྒྱུན་ཆགས་པར་འཇུག་པས་སྔ་མ་སྔ་མ་ཕྱི་མ་རྣམས་ཀྱི་རྒྱུར་འཐད་དོ།",
    "མཁྱེན་གསུམ་དུ་མངོན་རྟོགས་ཐམས་ཅད་འདུས་པ་དེ་ལྟ་བས་ནའོ།",
    "བསྟན་བཅོས་འདི་ནི་བརྩམ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "གང་དགོས་སོགས་བཞི་དང་ལྡན་པ་ནི་བརྩམ་པར་བྱ་བ་ཡིན་ཏེ།",
    "འོན་ཀྱང་དགོས་སོགས་བཞི་དང་ལྡན་པར་བསྟན་པ་ན་རྩོམ་པ་ལ་དོན་མེད་དམ་སྙམ་པའི་དོགས་པ་བཟློག་ནས་དོན་འགྱུར་གྱི་ཐེ་ཚོམ་སྐྱེད་པའི་ཕྱིར་གཉིས་པ་དགག་མི་རིགས་སོ།",
    "གསུམ་པ་ལ་མཛེས་པ་ཁོ་ན་དགོས་པར་འདོད་ན་དགག་རིགས་ཏེ།",
    "མཛེས་པ་ཕལ་པའི་དགོས་པར་འདོད་ན་མི་རུང་བ་མེད་དེ།",
    "དགོས་འབྲེལ་བཀོད་པས་ཀྱང་རབ་ཏུ་བྱེད་པའི་ལུས་མཛེས་པར་བྱེད་ནུས་པས་སོ།",
    "འོན་ཀྱང་མཛེས་པ་དགོས་པར་འཆད་པ་སྐབས་སུ་མ་བབ་བོ།",
    "དེ་སྐྱེས་པ་ན་འདི་སྙམ་དུ་ངག་འདིས་ཇི་ལྟར་དམ་བཅས་པ་ལྟར་བསྟན་བཅོས་ལ་ཞུགས་ཏེ་ཡོད་མེད་བརྟོགས་ལ་ཡོད་ན་ནི་འཇུག་ཅིང་མེད་ན་ནི་ལྡོག་པར་བྱའོ་སྙམ་དུ་བསམས་ནས་འཇུག་པར་འགྱུར་བར་ལུས་ཀྱི་སྔོན་དུ་དགོས་འབྲེལ་གྱི་ངག་དགོད་ཀྱི་བར་དང་མཐར་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་རིམ་པ་ལྟར་བྱ་རོག་སོ་རྟོག་ལྟ་བུ་མིན་པར་སྤྱིར་དགོས་པ་ཡོད་པ་དང་།",
    "དགོས་པ་དེ་ཡང་འཇོག་པོའི་གཙུག་རྒྱན་ལེན་པའི་བསྟན་བཅོས་ལྟ་བུ་མིན་པར་སྒྲུབ་ནུས་པ་དང་།",
    "སྒྲུབ་ནུས་ཀྱི་དགོས་པ་དེ་ཡང་མ་བག་མར་ལེན་པ་ལྟ་བུ་མིན་པར་སྐྱེས་བུའི་དོན་མཆོག་དང་།",
    "དགོས་པ་མཆོག་དེ་སྒྲུབ་པའི་ཐབས་ཀྱང་བསྟན་བཅོས་ལ་མ་འབྲེལ་བ་མཐོ་རིས་ཀྱི་དོན་དུ་ཕྱུགས་ཀྱི་མཆོད་སྦྱིན་བྱེད་པ་ལྟ་བུ་མིན་པར་བསྟན་བཅོས་འདི་ལ་འབྲེལ་བར་མཐོང་བ་ཙམ་གྱིས་འཇུག་པས་བཞིར་གྲངས་ངེས་ཏེ།",
    "ཡང་ན་སྒྲུབ་ནུས་ཀྱང་བསྟན་བཅོས་འདི་ལས་སྒྲུབ་མི་ནུས་པར་མཐོང་ནས་མི་འཇུག་གོ།",
    "དེ་ལྟར་འབྲས་བུ་དེ་ནི་འདོད་ལ་དེའི་ཐབས་ཀྱང་བསྟན་བཅོས་སུ་མཐོང་ཡང་འཇུག་པར་མི་བྱེད་ན།",
    "སྒྲུབ་པར་མི་ནུས་པ་དང་།",
    "འདོད་པར་བྱ་བ་མ་ཡིན་པ་དང་།",
    "འབྲེལ་བ་མེད་པ་ཞེས་བྱ་བའི་མཐའ་བཞི་རྣམ་པར་བསལ་བ་ཉིད་ཡིན་ནོ།",
    "བདེ་མཆོག་སྟོད་འགྲེལ་དུ་རྗོད་བྱེད་ཕུན་སུམ་ཚོགས་པ་དང་ལྔ་གསུངས་པ་དང་ཀ་ཤཱིས།",
    "རྟོག་ལྡན་གྱི་འཇུག་པ་ལ་རྗོད་བྱེད་སྒྲིག་ལེགས་པ་ཙམ་གཙོ་བོ་མིན་པ་དང་གསུམ་དུ་བསྟན་པ་ནི་དགོས་པ་གཉིས་བསྡུས་ནས་བསྟན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "མཆོད་བརྗོད་ཀྱི་ཤུགས་ལ་མཁྱེན་གསུམ་སྟོན་པའི་བསྟན་བཅོས་རྩོམ་པར་དམ་བཅས་པ་ན།",
    "མཁྱེན་གསུམ་གྱིས་དངོས་བརྒྱད་བསྡུས་པའི་ཕྱིར་དོན་གྱིས་ན་དངོས་བརྒྱད་སྟོན་པའི་ཕྱིར་དུ་རྩོམ་པར་དམ་བཅས་སོ།",
    "འབྲེལ་བ་སྒྲས་མ་ཟིན་པས་དགོས་པ་ཡོད་པར་དོན་གྱི་ཁོང་ན་ཡོད་པ་རྣམས་གསུངས་པ་ཡིན་ནོ།",
    "ཏེ་ནི་རྩ་བ་འདྲེན་པ་སྟེ་གཞན་དུ་ཡང་དེ་ལྟར་རིག་པར་བྱའོ།",
    "གང་རྣམས་ཐུབ་པས་གསུངས་དེ་དག།",
    "ཚིག་ཡིན་ན་གཟུགས་སུ་འདུས་ཞེས་ངེས་པར་མི་བྱའོ།",
    "རྟོག་གེ་བ་རྣམས་ནི་དངོས་ཀྱི་རྗོད་བྱེད་སྒྲ་སྤྱི་དང་ཞེན་པའི་རྗོད་བྱེད་སྒྲ་རང་མཚན་པར་འདོད་དོ།",
    "རྐྱང་པ་དང་ཚིགས་སུ་སྦྱར་བའི་སྒྲར་སྣང་བ་འདོད་པའི་དོན་གྱི་རྣམ་པའི་རྗེས་སུ་འཇུག་པ་ཉན་པའི་རྣམ་པར་རིག་པའི་ཚོགས་སོ།",
    "མིང་དང་ཚིག་དང་ཡི་གེའི་ཚོགས་སུ་སྣང་བའི་རྣམ་པར་རིག་པ་རྣམས་ནི་བསྟན་བཅོས་སོ།",
    "ཡང་ན་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་ཐོབ་པར་བྱེད་པའི་སྒྲའི་ཁྱད་པར་དུ་སྣང་བའི་རྣམ་པར་རིག་པ་རྣམས་ནི་བསྟན་བཅོས་སོ།",
    "ཞེས་གཉིས་བྱུང་བའི་སྔ་མ་ནི་བསྟན་བཅོས་ཙམ་ཞིག་དང་ཕྱི་མ་ནི་ཁྱད་པར་ཅན་གྱི་ངོས་འཛིན་ནོ།",
    "དབྱུང་དུ་རུང་བའི་ལས་ལ་འཇུག་པར་བྱེད་པའོ།",
    "ཕྱིར་ཞེས་པ་ནས་དགོས་པ་ཡིན་གྱི་བར་གྱིས་དགོས་པ་བསྟན་ཅིང་འབྲེལ་བ་ནི་བརྗོད་བྱ་བསྟན་པ་དེ་རྟོགས་པའི་དོན་དུ་ཡིན་ལ་དེ་རྟོགས་པས་ནི་མཐར་ཐུག་པར་འགྱུར་རོ་ཞེས་དངོས་སུ་བསྟན་པའི་ཤུགས་ལ་ཐབས་དང་ཐབས་བྱུང་དུ་འབྲེལ་བར་བཞེད་དོ།",
    "རྟོགས་དཀའི་སྣང་བར་དགོས་པ་གཉིས་དངོས་སུ་བསྟན་པའི་ཤུགས་ལ་འབྲེལ་བ་དང་བརྗོད་བྱ་བསྟན་པར་འཆད་པ་ནི་སློབ་དཔོན་གྱི་དགོངས་པ་མ་ཡིན་ཏེ།",
    "བརྗོད་བྱ་དངོས་སུ་བསྟན་པར་བཞེད་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་ཐོབ།",
    "གཞན་ཡང་བསྟན་བཅོས་བརྩམས་པ་མངོན་རྟོགས་ཤེས་པར་བྱ་བ་ཙམ་གྱི་ཆེད་མིན་གྱི་ལམ་རྒྱུད་ལ་སྐྱེད་པའི་ཆེད་ཡིན་པ་ལ།",
    "བརྗོད་པར་བྱ་བ་ཉིད་དུ་བསྟན་པ་གང་ཡིན་པ་ནི་འདི་ཡི་བརྗོད་བྱའོ།",
    "སྲིད་པར་འགྲོ་ལས་འདས་དང་ཤེས་རབ་དང་།",
    "དེ་ནས་ཐུགས་ཀུན་བརྗོད་པའི་ཆོ་འཕྲུལ་གྱིས་ཁམས་དང་བསམ་པ་དང་བག་ལ་ཉལ་མཁྱེན་ནས་སེམས་ཀྱི་རྒྱུ་བ་བསྟན་པས་དད་པར་བྱེད།",
    "དེ་ནས་གསུང་རྗེས་སུ་མཐུན་པའི་གདམས་ངག་སྦྱིན་པའི་རྗེས་སུ་བསྟན་པའི་ཆོ་འཕྲུལ་རྣམ་པ་གསུམ་གྱིས་འགྲོ་བ་མཐའ་དག་ལ་ལམ་རྗེས་སུ་སྟོན་པར་མཛད་པ་དེ་ཉིད་ཀྱིས་སོ།",
    "ལམ་དང་རྣམ་མཁྱེན་སོ་སོར་འཆད་པ་གཉིས་ཀའི་དགོངས་པ་མིན་ནོ།",
    "ཚུལ་ཇི་ལྟར་ན་དངོས་བརྒྱད་ཤེས་བྱའི་ཐབས་དང་རྒྱན་ཤེས་བྱེད་ཀྱི་ཐབས་ཀྱིས་ཏེ་དེས་བསྒྲུབ་པར་བྱ་བའི་བྱ་བྱེད་ཀྱི་ཚུལ་གྱིས་སོ།",
    "མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་རོ།",
    "ཟློས་པར་འགྱུར་བས་སོ།",
    "ཚིག་གསལ་དུ་ནི་འདིས་དོན་གྱི་བརྗོད་བྱའི་ཆེ་བ་བསྟན་པར་བྱས་ནས་བརྗོད་བྱ་ལ་སྦྱར་རོ།",
    "ཐོས་པའི་ཤེས་པས་བདེ་བླག་ཏུ་ངེས་པར་བཟུང་སྟེ་ཤིན་ཏུ་གསལ་བར་ཉམས་སུ་མྱོང་བས་བསྐྱེད་པའི་བག་ཆགས་ལས་བྱུང་བའི་དྲན་པའི་ཤེས་པ་ལ་བཞག་ནས་ཞེས་མ་མྱངས་པ་དེ་ཐོས་པས་ཡུལ་དུ་བྱས་པ་དང་སྦྲེལ་ནས་འཆད་པ་ནི་འདི་དང་མི་མཐུན་ནོ།",
    "བྱང་སེམས་ཞེས་པ་སྤྱིར་སེམས་བསྐྱེད་པ་ཐམས་ཅད་ཡིན་ལ་ཁྱད་པར་དུ་རིགས་ལ་གནས་པའི་བཅུ་གསུམ་པོ་ཡིན་ཏེ་༢།",
    "ཉིང་དགོས་ཏེ་རྣམ་པ་ཐམས་ཅད་དེ་ཡོངས་སུ་རྫོགས་པར་རོ།",
    "ཚིག་གསལ་དུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཅེས་འཆད་དོ།",
    "བག་ཆགས་ལས་བྱུང་བའི་དྲན་པའི་ཤེས་པ་གྲོགས་ཤེས་བཞིན་དང་ལྡན་པ་ལ་ལེགས་པར་ཏེ་ཚེ་རབས་གཞན་དུ་ཡང་མི་བརྗེད་པར་བཞག་ནས་སོ།",
    "བསྟན་བཅོས་འདི་མཉན་པ་ལས་དེའི་ཚིག་དོན་ཉམས་སུ་མྱོང་བ་ཤིན་ཏུ་གསལ་བ་སྟེ་མ་རྟོགས་ལོག་རྟོག་ཐེ་ཚོམ་གསུམ་དང་བྲལ་བའི་སྒོ་ནས་ཡུམ་གྱི་མིང་དོན་སེམས་ལ་གསལ་བར་བྱས་པའི་ཤེས་རབ་གསུམ་གྱིས་བཞག་གོ།",
    "དེ་ལྟར་ན་དྲན་པ་ལ་བཞག་པའི་དོན་ནི་ཐོས་པའི་དོན་མི་བརྗེད་པར་བྱེད་པ་ཡིན་པས་ཉམས་ལེན་གྱི་དམིགས་རྣམ་མི་བརྗེད་པར་འཛིན་པ་ཡིན་ནོ།",
    "རྟོགས་པར་འགྱུར་བ་ནི་བསྟན་བཅོས་རྩོམ་པའི་དགོས་པ་ཡིན་ནོ།",
    "ལུས་རྣམ་པར་བཞག་པ་དང་།",
    "རིགས་ཐིགས་ཀྱི་འགྲེལ་པར།",
    "བརྒྱད་ཚན་གསུམ་གྱི་ཁྱད་པར་དཔྱད།",
    "མཆོད་བརྗོད་དུ་བརྗོད་བྱ་ལ་བསྟོད་ཕྱག་བྱས་པའི་ཤེར་ཕྱིན་དེ་ཇི་ལྟར་བྱས་པས་འཆད་ཅེ་ན།",
    "གང་ན་གཞུང་གཙོ་བོར་བྱས་པའི་ལམ་དང་འབྲས་བུའི་ཤེར་ཕྱིན་ཏོ་༡།",
    "གཉིས་པ་ཡང་བསྟན་བཅོས་འདིས་ཡུམ་དོན་མ་ལུས་པར་སྟོན་ན།",
    "སྐད་ཅིག་སྦྱོར་འཕགས་པ་ཁོ་ནའི་རྟོགས་པར་རྩ་བ་ལས་ཆེས་གསལ་ཞིང་གཞན་གསུམ་ལ་འཕགས་པའི་མངོན་རྟོགས་ཡོད་པར་ཡང་བཞེད་དགོས་པས་དེ་ལ་འཕགས་པ་ཐོགས་མེད་འཁྲུལ་པ་ག་ལ་སྲིད།",
    "བར་པ་བཞི་ལ་སྦྱར་བ་ཙམ་གྱིས་བྱས་སོ།",
    "ཞེས་པ་ནི་ཤཱནྟི་པའི་གཞུང་ལ་གསལ་ཁ་མི་སྣང་ཡང་དེ་བཞིན་དུ་འདོད་པར་བྱའོ།",
    "རྣམ་པར་རྟོག་པ་དང་།",
    "ཤེས་པར་བྱ་བ་དང་རྣམ་པ་འདི་དགུའི་ཕ་རོལ་ཏུ་སོན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་རྣམ་པར་མི་རྟོག་པ་རྡོ་རྗེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་གྱིས་བསྡུས་པ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱའོ།",
    "འདིར་སྔ་མ་རྣམས་ཀྱིས་རྡོ་རྗེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་འཁྲུལ་ནས་ཤེར་ཕྱིན་དངོས་རྒྱུན་མཐའི་ཡེ་ཤེས་ལ་བཞེད་པར་འཆད་པ་ནི་དགོངས་པ་མིན་ཏེ།",
    "ཁྱད་པར་དུ་ཕྱི་མ་ལས།",
    "རྗེས་ཐོབ་སྣང་བཅས་གཉིས་ལས་ཕྱི་མའི་རྟོག་བཅས་དང་རྟོག་མེད་ཀྱི་ཡེ་ཤེས་བཞི་རྣམས་ནི་ཤེར་ཕྱིན་བཏགས་པ་བ་ཡིན་ལ་སྔ་མ་མཚན་ཉིད་པར་བཞེད་དོ།",
    "ཤེར་ཕྱིན་ཡི་གེ་མ་ཡིན་ཏེ་དེ་ལ་སུ་ཡང་སྟོན་པ་དང་ཉན་པ་དང་ཤེས་པར་བྱེད་པ་མེད་དོ།",
    "འདི་མ་རྟོགས་ན་ཤེས་རབ་ཡིན་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པར་ག་ལ་འགྱུར།",
    "དེ་མེད་ན་དེ་ཐོབ་པའི་ཆེད་དུ་སྦྱོར་བའི་ལམ་དང་གཞུང་དག་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "འདིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་༢ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཏེ།",
    "རྣམ་པར་གཡེང་བའི་རྣམ་པར་རྟོག་པ་བཅུའི་གཉེན་པོའོ་ཞེས་སོ།",
    "འདི་དང་འདི་འདོད་པས་ཤེར་ཕྱིན་ལ་བསླབ་པར་བྱ་ཞེས་དུ་མ་ཞིག་གསུངས་པའོ།",
    "དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དོན་མཐའ་དག་ནི་མི་མཐུན་པའི་ཕྱོགས་དང་གཉེན་པོ་དང་བཅས་པར་རིག་པར་བྱའོ།",
    "ཞེས་པའི་རྗེས་སུ་འབྲངས་པར་མངོན་ནོ།",
    "དེ་ལྟ་བས་ན་གང་དག་དེ་ལྟ་བུའི་ཕ་རོལ་དེའི་བདག་ཉིད་དུ་གྱུར་པ་དེ་དག་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དེས་ན་ལམ་ནི་ཕལ་པ་ཡིན་ཀྱང་མཚན་ཉིད་པར་མི་འགལ་ཏེ་མི་ཕལ་པ་བཞིན་ནོ།",
    "ཤེས་རབ་རྣམ་པར་བཤིག་ནས་རྡུལ་ཙམ་མི་དམིགས་ཚེ།",
    "རྒྱལ་བ་འདས་དང་མ་བྱོན་ཕྱོགས་བཅུར་གང་བཞུགས་པ།",
    "འདོད་པར་ཡང་མི་ནུས་ཏེ།",
