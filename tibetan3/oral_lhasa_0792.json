    "རྒྱས་འབྲིང་བསྡུས་པ་ཀུན་གྱི་རྒྱན་དུ་རྟོགས་པར་འགྱུར་བའི་ཕྱིར་དུའོ།",
    "དེའི་རྒྱན་ཚིག་ལེའུར་བྱས་པ་ཞེས་པའི་ཚིག་ཙམ་ཡང་མ་མཐོང་བར་གསལ་ལ་ཕྱི་མ་ཡང་རྩོམ་པ་པོའི་དགོངས་པ་དང་འགལ་ལོ།",
    "སྒྲའི་བརྗོད་བྱ་ཚིག་ལེའུར་བྱས་པ།",
    "དོན་གྱི་བརྗོད་བྱ་རྒྱལ་བ་སྐྱེད་མ་རྩ་བའི་དོན་ལེགས་པར་བསྟན་པ་དགོས་པ།",
    "གཞན་དག་ནི་ཚིག་ལེའུར་བྱས་པའི་དོན་ལེགས་པར་བསྟན་པས་དེ་རྒྱན་ཉིད་དུ་གྲུབ་པ་ནི་དགོས་པ་ཡིན་ལ།",
    "ཚིག་ལེའུར་བྱས་པ་ལེགས་པར་བསྟན་པ་ནི་འགྲེལ་པ་ལེགས་པར་བརྩམས་པ་ཡིན་ལ།",
    "འགྲེལ་པ་བརྩམས་པ་འགྲེལ་པ་བརྩམས་པའི་དགོས་པར་མི་འཐད་པའི་ཕྱིར།",
    "ཀུན་གྱི་རྒྱན་ཡིན་པར་གང་ལས་རྟོགས་ཤེ་ན།",
    "རྣམ་པར་དབྱེ་ཞེས་རྩོམ་པར་དམ་བཅས་པ་ལ།",
    "དེ་ཡང་ཁྱད་པར་ཅན་རྒྱལ་བའི་ཡུམ་རྣམས་སོ།",
    "སློབ་དཔོན་འདི་ཡོན་ཏན་གྱི་ཁྱད་པར་ཅི་ལྟ་བུ་ཞིག་དང་ལྡན་ཞེ་ན།",
    "དེའི་ཚེ་རྗེ་བཙུན་གྱིས་ཐོགས་མེད་ཀྱི་དོན་དུ་མངོན་རྟོགས་རྒྱན་ལ་སོགས་པ་རྣམས་མཛད་པར་མཁས་པ་རྣམས་ལ་གྲགས་ཏེ།",
    "ཟབ་པ་ཉིད་ཀྱིས་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དོན་དཔོག་པར་མ་དཔྱོད་ནས།",
    "ཡིད་མི་བདེ་བ་རྗེས་སུ་ཐོབ་པར་གྱུར་ཏེ།",
    "དེ་ནས་དེའི་དོན་དུ་བཅོམ་ལྡན་འདས་འཕགས་པ་བྱམས་པ་མཉེས་པར་བྱས་ནས།",
    "འཕགས་པ་ཐོགས་མེད་ཀྱིས་བསྒྲུབས་ནས་དུས་ཕྱིས་བྱས་ཞེས་པ་ནི་སེང་གེ་བཟང་པོ་ལ་སོགས་པ་རྣམས་ཀྱི་འཁྲུལ་པ་སྟེ།",
    "ཞེས་འཆད་ཀྱང་མི་འཐད་པར་གོ་སྟེ།",
    "རྣམ་པར་བཀྲོལ་ཞེས་དྲང་ངོ།",
    "འགྲོ་བ་རྣམས་ཀྱི་ཐོབ་བྱའི་དོན་མངོན་མཐོ་དང་ངེས་ལེགས་ཀྱི་རྒྱུ་ཁ་ན་མ་ཐོ་བ་མེད་པའི་ལམ་བསྟན་ནས་འདོད་པ་རྫོགས་པར་བྱེད་པས་རྩ་ལག་མཚན་དབྱིག་གཉེན་ཞེས་པ་དེས་སོ།",
    "དངོས་དང་དངོས་མེད་རྣམ་དབྱེའི་ཕྱོགས་ལ་མཁས་པར་ཤེས་པའི་མངོན་རློམ་གྱིས་མཐོ་བ།",
    "ཕྱི་རོལ་མེད་ཅིང་ཤེས་བྱ་ཡུལ་དུ་སྣང་བ་ཐམས་ཅད་ནང་སེམས་ཀྱི་སྣང་བ་ཙམ་ཡིན་ཞིང་སེམས་དེ་ཉིད་གཤིས་ལ་གྲུབ་པར་འདོད་པ་རྣམ་རིག་པའི་ཚུལ་ལ་ཡང་དག་པར་བརྟེན་ནས་སོ།",
    "ཕྱི་མཐའི་བར་དུ་གནས་པར་བགྱི།",
    "ཞེས་གསུངས་པའི་རྗེས་སུ་འབྲངས་པས་སོ་ཞེས་འབྱུང་ཞིང་རྟོགས་དཀའི་སྣང་བ་དང་།",
    "དབྱིག་གཉེན་གྱིས་ནི་རྣམ་པར་བཀྲོལ།",
    "དེ་ལྟ་མ་ཡིན་པར་འཕགས་པ་རྣམས་ཀྱང་འདོད་པ་ཐ་དད་པར་སྟོན་ན་མ་འབྲེལ་བ་ཆེན་པོ་སྨྲས་པར་འགྱུར་རོ།",
    "དེ་རྣམས་ལ་དགོངས་ནས་འཇུག་པའི་འགྲེལ་པར།",
    "རྣམ་པར་ཕྱེའོ།",
    "རྣལ་འབྱོར་གོམས་པས་དོན་གྱི་དེ་ཉིད་བསྲུབས་པས་འཇིག་རྟེན་འདས་པའི་ཤེས་ལྡན་པར།",
    "ཞེས་པ་ལྟར་ཉི་ཁྲིའི་འགྲེལ་པར་རོ།",
    "སྔ་མ་གཉིས་པོ་དེས་འགྲེལ་པ་བྱས་པ་རྣམ་རིག་ཙམ་གྱི་གཞུང་དང་མཐུན་པའི་ཕྱིར་རམ།",
    "ཡུམ་དོན་ཇི་ལྟ་བ་བཞིན་བྱས་པ་མིན་པར་མཐོང་ནས་ཕྱེ་བས་ཉེས་པ་མེད་དོ།",
    "ཁ་ཅིག་ཡུམ་མཐའ་དག་མ་རྙེད་ཟེར་བས་ནི་ལེགས་པར་མ་སྨྲས་སོ་ཞེས་དང་།",
    "རྟོག་པ་བཞི་ལ་ནི་དང་པོ་ལ་བདུན་བརྒྱད་གཉིས་མ་གཏོགས་པ་བདུན་འོལ་སྤྱི་གཅིག་སྣང་ཞིང་ལྷག་མ་གསུམ་ལ་སྤྱི་མིང་ཙམ་ལས་མ་གཏོགས་པའི་དབྱེ་བ་མ་བྱས་པར་བཞི་པའི་སྐབས་སུ་འདི་དང་སྐབས་གཞན་དུ་ཡང་བསྟན་བཅོས་དང་སྦྱར་བར་བྱ་སྟེ།",
    "གཞུང་དུ་མ་ཚོལ་བ་རྣམས་ལ་ཕན་གདགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "བསྟན་བཅོས་ཀྱི་དོན་མཐའ་དག་འདི་རྙེད་དོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "རྙེད་པ་ནི་ཞེས་པའི་བར་དུ་གསུངས་སོ།",
    "ཡུལ་མིན་ན་རྩོམ་པར་མི་རིགས་ཤེ་ན།",
    "རང་དང་གཞན་ལ་ཕན་གདགས་པར་འདོད་པའི་ལྷག་པའི་བསམ་པས་ཀུན་ནས་བསླང་པའི་ཕྱིར་ཉེས་པ་མེད་དོ།",
    "འདིས་རང་ཉིད་བསམ་པ་དག་པར་བསྟན་ཅིང་བསམ་པ་འདི་ལྟ་བུའི་སྒོ་ནས་རྩོམ་པ་ལ་སྤྲོ་བ་སྐྱེད་ཅིག་ཅེས་གཞན་ལ་གདམས་ངག་ཏུ་སྦྱར་རོ།",
    "དེ་ཡང་དམ་པས་བྱས་པའི་བསྟན་བཅོས་ལ་གཞན་འཇུག་པའི་ཆེད་དུའོ།",
    "དེའི་དགོས་པ་ནི་ཐོས་སོགས་ཀྱིས་འཇུག་པར་བྱ་བའི་ཕྱིར་ཡིན་ལ།",
    "ཅིའི་ཕྱིར་དང་བ་བསྐྱེད་པའི་ཆེད་དུ་མཆོད་བརྗོད་གསུངས་ཤེ་ན།",
    "གཞན་གྱིས་ཀྱང་བསྟན་པ་ལས་རྟོགས་པར་བྱ་མི་ནུས་ལ།",
    "ནས་ཞེས་པ་ལྷག་མ་ཅན་ཡིན་པས་བཟུང་ནས་ཞེས་བྱ་བ་གསུངས་སོ་ཞེས་སྦྲེལ་དགོས་པས་སོ།",
    "གང་ལ་ན་ཡུམ་མཁྱེན་གསུམ་དེ་ལའོ།",
    "འགྲོ་བ་ལ་ཕན་འདོགས་པར་བྱེད་པའི་བྱང་སེམས་རྣམས་འཇིག་རྟེན་གདུལ་བྱའི་དོན་སྒྲུབ་པར་མཛད་པ་གང་ཡིན་པ་སྟེ་དེའི་ཡུམ་ཡིན་ལ་ལམ་གསུམ་ཤེས་པ་ཉིད་ཀྱིས་དེ་མཛད་པས་སོ།",
    "ཐུབ་པ་རྣམས་བརྗོད་བྱའི་རྣམ་པ་ཀུན་དང་ལྡན་པའི་རྗོད་བྱེད་སྣ་ཚོགས་པ་འདི་དག་གསུང་བར་འཇུག་བྱེད་དེ་དེའི་ཡུམ་ཡིན་ལ་ཇི་ལྟ་ཇི་སྙེད་ཀྱི་རྣམ་མཁྱེན་གང་དང་ཡང་དག་པར་ལྡན་པས་དེ་གསུངས་པས་སོ།",
    "དེ་མཁས་པའི་དགོངས་པར་སྒྲུབ་པའོ།",
    "མཁྱེན་པ་གསུམ་ནི་འདིར་ཡུམ་དུ་བསྟན་ལ།",
    "དེ་ལྟ་ན་ཡང་རྗེ་བཙུན་གྱིས་མཁྱེན་གསུམ་ཉིད་ལ་བསྟོད་པ་ནི།",
    "མངོན་རྟོགས་ཐ་མ་ལྔ་དང་པོ་གསུམ་དུ་འདུས་པར་དགོངས་ནས་སོ།",
    "གྲོལ་བ་དོན་གཉེར་རྣམས་དང་བ་སྐྱེས་ཏེ་ཚིག་ལེའུར་བྱས་པ་ལ་འཇུག་པར་འགྱུར་བས་དེའི་ཕྱིར་མཛད་དེ།",
    "འདིས་འཁྲུལ་གཞི་བྱས་ནས།",
    "དེས་ན་དེ་སྐད་གསུངས་པ་ནི་སྲས་ཀྱི་གཙོ་བོ་བརྗོད་པར་འདོད་ནས་ཡིན་གྱི་ཚོགས་སྦྱོར་བ་སྲས་མིན་ནས་མ་ཡིན་ཏེ།",
