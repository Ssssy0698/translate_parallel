    "འོ་ན་འཇིག་རྟེན་པ་རྣམ་ཀྱང་རྣམ་རྟོག་རང་གར་འདུག།",
    "རྣལ་འབྱོར་པ་ཡང་རང་ག་ཐུ་མལ་གྱི་ཤེས་པར་འདུག་པ་ལ་དེ་གཉིས་ལ་ཁྱད་པར་ཅི་ཡོད་ཁྱད་པར་མེད་ན་འཇིག་རྟེན་པ་ལ་ཡང་རང་གྲོལ་དུ་མི་འགྲོ་འམ་སྙམ་ན།",
    "འོ་ན་བསྒོམས་པས་དྲན་པས་ཟིན་ནམ་མ་བསྒོམས་པས་དྲན་པས་ཟིན་བྱས་པས་བསྒོམས་ན་བློར་འགྲོ་མ་བསྒོམས་ན་རང་གྲོལ་ལམ་བྱས་ན་ཡང་རྡུགས་ནས་འགྲོ་བར་འདུག།",
    "སེམས་ཁོ་རང་རྟོག་མེད་དུ་བདེ་འམ།",
    "དགག་སྒབ་ཀྱི་རྩོལ་བ་མི་བྱ་བར་མི་རྟོག་པར་འདུག་ཀྱང་རུང་།",
    "རྣམ་རྟོག་སྣ་ཚོགས་སུ་འཆར་ཀྱིན་འདུག་ཀྱང་རུང་།",
    "འདུག་ཚུལ་ངོ་ཤེས་པ་ཡན་ནོ།",
    "སེམས་ཉིད་ཁོ་རང་སྤང་བྱ་དང་གཉེན་པོ་ཐམས་ཅད་དུང་བྲལ་བར་འདུག་པ་དེ་ཡིན།",
    "ཨ་ཧཾ་དང་རང་ཕོ་ཡིན་ན་རྡོ་རྗེའི་མཚན་མ་དོད།",
    "བི་བྷུ་ཏི་ཙནྡའི་མཆན་ལ་ལྔ་བརྩེགས་སུ་འདུག་ཟེར།",
    "རིང་པོ་ལ་ཡི་གེ་བརྩེགས་པ་འདུག་ནའང་འོག་མ་རྣམས་ལ་མི་འདུག་པས་མི་དགོས་པ་འདྲའོར་ཡིག་ལས་གྲུབ་པ་ཤེས་རབ་མཐར་བྱེད་དམར་པོ་ནི་མིག་གཡོན་པའི་སྒོ་ནས་ཕྱུང་སྟེ་ལྷོའི་རྩིབས་སུ་ཟླ་བའམ་ཉི་མའི་གདན་ལ་གཞག་པར་བྱའོ།",
    "མགྲོན་རྣམས་རང་རང་ཞིང་ཡུལ་གཤེགས།",
    "མགོན་མེད་འདུག་གནས་སུ་ནི་འདུག་གྱུར་ལ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "དེ་བཞིན་དུ་ནང་པར་ཁས་འཆེ་བ་འགའཞིག་ཀྱང་ཀུན་རྫོབ་སྣ་ཚོགས་སུ་སྣང་བ་འདི་ཐམས་ཅད་ནི་རང་རང་ངོ་བོས་སྟོང་པའོ་ཞེས་བྱ་བར་བསྟན་ཏོ།",
    "རིགས་དེ་ནི་ས་བོན་དང་ཁམས་དང་རང་བཞིན་ཞེས་ཀྱང་བྱའོ་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "སའི་དཀྱིལ་འཁོར་གསེར་གྱི་རང་བཞིན་ཅན་རྔམས་སུ་སུམ་འབུམ་ཉི་ཁྲིར་འདུག་པ་ཞིག་ཆགས་ཤིང་།",
    "མགོན་མེད་འདུག་ནས་སུ་ནི་འདུག་གྱུར་ལ།",
    "དེ་ལྟར་ན་དྲི་མ་དང་རང་བཞིན་དག་པ་རྣམ་པ་དགུ་དགུར་ཕྱེ་ནས།",
    "ངོ་བོ་ཉིད་དང་རང་བཞིན་དང་།",
    "དཔེར་ན་མི་བརྟན་ཞིང་རང་བཞིན་མེད་པ་སྤྲིན་གྱི་རྣམ་པ་ཇི་ལྟ་བ་བཞིན་དང་།",
    "ལོངས་སྤྱད་ཅིང་ཉམས་སུ་མྱོང་ཡང་རང་བཞིན་མེད་པ་རྨི་ལམ་གྱི་སྣང་བ་ཇི་ལྟ་བ་བཞིན་དང་།",
    "སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པ་སྒྱུ་མའི་གཟུགས་བརྙན་ཇི་ལྟ་བ་བཞིན་དུ།",
    "སྤྲིན་དང་རྨི་ལམ་དང་སྒྱུ་མ་བཞིན་དུ་སྣང་ཡང་རང་བཞིན་མེད་པའོ་ཞེས་གསུངས་པའི་དགོངས་པ་གང་ཡིན་ཞེ་ན།",
    "དཔེར་ན་ས་ལ་འདུག་པའི་མི་ལྷའི་མིག་མེད་པས་ནམ་མཁའ་ལ་བྱ་འཕུར་བའི་རྗེས་མི་མཐོང་བ་བཞིན་དུ།",
    "ཀུན་རྫོབ་ས་བཟང་རྒྱུད་བླ་སྣང་ཙམ་དུ་ཡོད་ཅིང་རང་བཞིན་དུ་མེད་པ་དང་།",
    "སྣང་ཡང་རང་བཞིན་མེད་པ་སྤྲིན་དང་རྨི་ལམ་དང་སྒྱུ་མ་ལྟ་བུའོ་ཞེས་དེ་ལྟར་ངོ་བོ་ཉིད་མེད་པ་གཙོ་ཆེར་སྟོན་པའི་རྣམ་གཞག་མཛད་ནས།",
    "དེ་ལྟ་ན་ཡང་རང་ཉིད་ཉམས་པའི་རྒྱུ་ཡིན་པས་མཁས་པ་རྣམས་ཀྱིས་དེ་ལྟར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་པའི་དོན་ནོ།",
    "ལུས་བཆུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "མཐའདུག་མྱུར་དུ་འགུགས་པའི་ལྕགས་ཀྱུའང་ཡིན།",
    "རིགས་བ་གཞན་གྱིས་ཀྱང་རང་རིག་མི་འཐད་པརབསྟན་བ།",
    "རང་རང་འགྲེལ་ལས།",
    "ཞེསཡུལ་ཅན་དྲན་ཚུལ་གཉིས་ཡོད་པསསྔར་གྱི་མྱོང་བྱེད་ལའང་ཡུལ་མྱོང་དང་རང་མྱོང་གཉིསངེས་པར་འཇོག་དགོས་ལ།",
    "དེ་ཡང་རང་རིག་ཡོད་དེ་ཞེས་ནི་མི་འགོད་དེ།",
    "སེམས་དེདག་དུས་མཉམ་དུ་འབྱུང་ཡང་།",
    "དེའི་ཕྱིར་གཟུགས་སོགས་དེ་དག་རང་མཚན་གྱིས་ཡོད་པའཇོག་བྱེད་ཀྱི་ཡུལ་ཅན་ཤེས་པ་རྣམསཀྱང་རང་མཚནགྱིསཡོད་པ་འཇོག་བྱེད་མངོན་སུམ་ཞིག་མེད་ན་མི་འགྲུབ་པས་མཐའ་གཞན་ཁེགས་པའི་རིགས་པ་ལ་བརྟེན་ནས་ཤེས་བ་གང་ཞིག་རང་གསལ་བ་དང་།",
    "དུས་ཕྱིས་འབྲུག་སྒྲ་ཐོས་པན་སྔར་རྨུགས་པའི་ཆེ་དུག་ཞུཌ་འདུག་སྙམ་དུ་དྲན་པ་སྐྱེ་བ་བཞིནནོ་ཞེས་པའོ།",
    "དེའི་རྒྱུད་ཀྱི་སྔོ་འཛིན་མིག་ཤེས་ཀྱང་རང་ཡུལ་སྔོན་བོལ་འཁྲུལ་བ་དང་།",
    "བུམ་པའི་ནང་ན་མརམེ་འདུག་པ་བཞིན་དུ་བུམ་པ་བཅག་ན་མར་མེརབ་ཏུ་འབར་ཞིངམཛེས་ཏེ།",
    "གཞན་གྱིས་མ་མཐོང་བ་ཡིན་མིན་ནི་ཐེ་ཚོམགྱི་གནས་ཡིན་པའི་ཕྱིར་ཞེསཔའོ་། དེ་བཞིན་དུ་མངོན་སུམདུ་མ་མཐོང་བ་ཡང་རང་ལ་མངོན་སུམ་ཡིན་ན།",
    "ཡང་ན་དེ་དག་དུས་ནམ་དུ་ཡང་མེད་བར་འགྱུར་ཏེ།",
    "སོགས་པས་བསྡུས་པ་དུས་དང་རྡུལ་དང་རང་བཞིན་དང་སྐྱེས་བུ་དང་།",
    "སྤོབས་བ་ས་སོཡང་དག་པར་རིག་པ་བཞིའི་ངོབོཡང་རང་འགྲེལ་དུ།",
    "ཞབས་གཉིས་མཉམ་པའི་སྟབས་ཀྱིས་བུ་སྟོན་གྱིས་མཉམ་པའི་འདུག་སྟངས་ཀྱིས་བཞུགས་ཞེས་གསུངས།",
    "སླར་ཡང་རང་ཉིད་ལས་ཡུམ་གྱི་པདྨར་སྤྲོས་ཏེ་སྣ་ཚོགས་ཡུམ་ལ་ཞུགས་པར་གྱུར།",
    "འདིར་རང་རིགས་ཀྱི་ཡུམ་གྱིས་འཁྱུད་པའི་མི་བསྐྱོད་པ་ཡབ་ཡུམ་ཁོ་ན་ཕྱིར་སྤྲོ་ཞིང་རང་ལ་གཞུགས་པས་ཆོག་ཅིང་།",
    "འཁོར་རྣམས་ཀུན་ཀྱང་རང་རང་གཙོ་བོ་ལ།",
    "འབྲི་གཡག་ཅེས་རྒྱུད་ན་འདུག་ཡི་སྟེང་དུ་འཁོར་ལོའི་གདན་ལ་གནས།",
    "ལོ་ཟླ་ཞག་དུས་ཀྱི་ཆ་རྣམས་དང་།",
