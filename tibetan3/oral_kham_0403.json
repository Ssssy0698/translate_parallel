    "བཛྲ་མུ་ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་ནས་ཞུགས།",
    "བྱེ་བྲག་ཕྲན་ཚེགས་ནི་འགྲངས་ཤིང་ངོམས་པར་འདུག་པའི་རྗེས་ཐོག་དེར་དྲག་ཤུལ་གྱི་རིགས་བྱས་པ་ལས་འབྱུང་།",
    "དོན་ལ་ཐུག་དུས་ཚ་གྲང་གཉིས་ཁོ་ན་སྟེ་ཉུང་ངུ་བསྡུས་ལ་ལག་ལེན་ཡང་དེ་གཉིས་ཀྱི་གཉེན་པོ་སྒོས་སྒོས་སུ་དྲིལ་ཞེས་གསུངས་སོ།",
    "ལམ་དུ་འཁྱགས་ནས་འགགས་ན་གར་འདུག་པ་དེའི་སྲུབས་ཀྱི་གཡོན་དུ་རྡེའུ་ལ་བསྟེན་པ་བྱས་ལ་གཙགས་བུས་དྲས་ལ་བཙིར།",
    "སྐྱིད་པ་ཞེས་ཤ་ཚིལ་སྣུམ་བག་ཆང་སོགས་དང་དལ་བར་འདུག་པ་དང་།",
    "རུས་ལ་ཞེན་ན་རུས་པ་ལྷང་ལྷང་ན་བ་དང་ཚིགས་དམིགས་རྣམས་ན་ཞིང་བརྐྱང་བསྐུམ་དང་འགྲོ་འདུག་དཀའ་ལ་ཚིགས་པའི་ཁ་རྣམས་སྐྲངས་ཤིང་ཟ་ལ་ཤུ་ཐོར་འབྱུང་།",
    "སྤྱོད་ལམ་གྱི་རིགས་བསིལ་སར་དལ་བར་འདུག་ཅིང་གནས་པར་བྱ་བ་དང་།",
    "གཟེར་བ་བདེར་གནས་གོང་བུར་འདུག།",
    "སྟན་སྲབ་པོར་ཙོག་པུར་འདུག་པ་དང་།",
    "ཙོག་པུར་འདུག་པ་རླན་གྲང་མེ་ཉིས་གདུང་བ་སོགས་སྤྱོད་ལམ་ལོག་རིགས་དང་གྲང་དྲོ་མི་སྙོམས་པ་རྣམས་རྟག་ཏུ་སྤང་དགོས་ཞེས་གསུངས་སོ།",
    "རྒྱུ་རྐྱེན་གཞི་མཐུན་ནི་སྟན་སྲབ་པོའི་ཁར་ཙོག་པུར་འདུག་པ་དང་།",
    "དེས་ཀྱང་མ་ཚུད་ན་ཕྱིང་པའི་ཡོག་ཐོད་མཐོ་གང་པ་ཕྲུ་མ་རློན་པས་དྲིལ་བ་དེའི་རྩེ་ལ་མར་བྱུགས་པར་རྒྱ་ཚ་གླན་ཏེ་ཕུགས་སུ་བསྐྱལ་ནས་རྐང་པ་བཏེག་ལ་གསིག་ཅིང་མཚན་ཁར་ཕྱིང་པ་བསྲོས་པས་བདུག་དེ་རྗེས་འཕོངས་གྱེན་སྟོད་ལ་འོང་བ་བྱས་ནས་ཉལ་ཏེ་འགྲོ་འདུག་དང་ལངས་པ་སྤང་།",
    "འབྱུང་པོའི་གཟུགས་དང་རང་བཞིན་དང་།",
    "ཡོན་པོར་བལྟ་ཞིང་རང་བཞིན་ངན།",
    "འདུག་མཐོང་ན་ནི་འཇིགས་པ་བྱེད།",
    "འདུག་ཅིང་ཚིག་རྩུབ་སྨྲ་བ་དང་།",
    "བྱད་སྟེམས་ཀྱི་གདོན་གྱིས་ཟིན་པ་ནི་ཤིང་སོགས་འཛིན་ཅིང་གཅེར་བུར་རྒྱུག་པ་དང་གནས་སྟོང་དུ་འདུག་པར་བྱེད་དེ།",
    "དེ་རྗེས་བསྡིགས་པས་སྐྲག་སྟེ་ཡིད་ལམ་ལོག་པ་ནས་ཐོན་ཏེ་རང་གནས་སུ་འདུག་པ་སྲིད་དེ་བསྡུས་པར་ཡང་།",
    "དེ་འདྲ་དུ་འདུག་ལས་ལོ་གྲངས་ཙམ།",
    "སེམས་ཀྱང་རང་བཞིན་མ་གྲུབ་སྟེ་དངོས་པོ་དང་མཚན་མར་མ་གྲུབ་པས་ཡོད་མེད་སོགས་དང་བྲལ་ལོ།",
    "གདོན་ཡང་རང་བཞིན་མ་གྲུབ་སྟེ།",
    "ཟས་དམན་སྨྱུང་བ་སྟེ་ཟས་ཉུང་བར་འདུག་པ་དང་།",
    "མི་འགྲིག་ཅིང་རང་ལུགས་ངོས་འཛིན་ནི་བརྒྱད་པ་ལས།",
    "རྟུལ་ཞེས་རྨ་མི་བཟོ་བའི་ཟུར་མ་དེ་ལྟ་བུ་ཕོག་པར་འདུག་ན་རུས་པ་དང་ཕྲད་པར་མ་གྱུར་ཀྱང་།",
    "ཤིན་ཏུ་སྐྱོན་ཆེ་བ་འདུག་ཚེ།",
    "ནང་རྩར་བྱེར་ན་ཚིགས་པ་དྲུག་པ་དང་འཁོར་ལོ་གསུམ་ཞེས་པ་འདི་ལ་གཡུ་ཐོག་པའི་ཕྱག་དྲེག་མ་སོགས་ཁུངས་འགའི་མཆན་བུར་གཙུག་མཐིལ་སྲིན་ལག་ཅེས་གསུངས་འདུག་ལ།",
    "ཁོ་བོ་ནི་ནམ་དུ་ཡང་རང་བཟོའི་སྤྱི་བརྟོལ་མི་བྱེད་དེ་མཁས་རློམ་གྱིས་མ་དྲེགས་པའི་ཕྱིར་རོ་གསུངས་པ་དང་།",
    "ཕྱི་ཞེས་པ་དེའི་ནང་པར་བལྟས་པས་ཁྲག་རོ་ལུག་ཤིག་ཙམ་ཅོལ་ལེ་འདུག་ན་ལྷ་སྐྱོན་ཐུན་བུར་བཏུ་སྟེ་དེ་དུས་ལྷ་བས་མི་འབྱེར་བའི་མནའ་བསྐྱལ་པ་ཡིན་པས་ཕྱིར་མི་ལྡོག་གོ།",
    "རྒྱུས་པ་སྐམ་པོའི་རྩེ་བལྡད་པ་ནང་དུ་བཅུག་ལ་རྣག་ཆུ་ཨེ་འདུག་བཙལ་ཏེ།་",
    "གཞན་ཡང་རང་རང་གསང་ལ་མེ་དང་ཁྲག་ཤས་ཆེ་ན་གཏར་ག་ཕྱེ་མ་སོགས་གང་དགོས་རིགས་པས་སྤྱི་དང་སྦྱོར་རོ།",
    "དོན་ལྔ་གང་ལ་ཟིན་ཀྱང་ཕོག་དུས་ཤེས་པ་ཟི་ཞིང་འཚུབ་པ་དང་།",
    "ཅོག་གེ་འདུག་པར་མི་ཚུགས་པ་དེ་ནི་ཞག་འགུའི་དུས་ན་འཆིའོ།",
    "སྨྲ་བར་འདོད་ཅིང་སྙན་མིང་ནས་འབོད་པའི་ཞེ་ས་མཁས་ལ་འགྲོ་འདུག་བྱེད་པ་དང་།",
    "སྦྲིད་པ་མང་ལ་འཆག་པ་སྟེ་ཕར་ཙམ་ཚུར་ཙམ་བྱེད་འདོད་ཅིང་མཆན་འོག་གཟེར་ལ་ལོགས་གཉིས་ཀྱིས་ཉལ་བ་མི་ཤེས་ཤིང་ཙོག་པུ་སྟེ་ཙོག་གེར་བདེ་བ་དང་།",
    "ཕྱེ་མས་བསད་པ་ཁྲག་དུས་ཀྱིས་སྐེམ་དང་འདྲ་སྟེ་འོག་ཏུ་བསྟན་པ་ལྟར་རྟོགས་དགོས་ཤིང་།",
    "དེ་ནང་ནས་དང་པོ་ཁྲག་དུས་བྲམ་ཟེ་ལྟ་བུར་བཅོས་པ་དེ་ལའང་ཐུག་གཝེར་བཅག་པ་དང་།",
    "ཚེས་ཡར་ངོའི་གསུམ་ལྔ་སོགས་ཆ་མ་ཡིན་པ་བཟང་བའི་སྔ་སྐད་དུས་སུ་ཁད་མཉམ་པའི་སྟན་ལ་ལུས་དྲང་པོར་བསྲང་སྐྱིལ་ཀྲུང་དུ་འདུག་པ་དང་།",
    "༩༩༣འཕྲུལ་ཐེམ་ནི་དམར་ཁྲིད་དུ་རྣག་ཤ་ཐོན་རྣག་ཆུ་ལྟར་འོང་ཙ་ན་ཞ་ཉེའི་སྦུབས་ཐུར་ཁ་ཁྱེར་ཅན་ནང་བརྡར་ཤ་བཅད་པ།",
    "རྐང་ནང་བརྡོལ་ནས་རྐང་མར་དུ་སླེབ་ན་ཟུག་རྔུ་སྟེ་མདེའུ་བྱ་འདས་པས་ཕྱི་རུས་ཀྱིས་བསྣམས་ནས་གདོན་པ་དཀའ་སྟེ་དེ་ཡང་སྤྱིར་མདའ་ནི་བར་སྣང་ལ་འཁོར་ཞིང་འགྲོ་བས་འདོན་དུས་ཀྱང་ལུས་ལ་ཕོག་དུས་ཀྱི་འདུག་ལུགས་གང་ཡོད་ལྟར་ལ་གདོན་པ་དང་།",
    "གཞུག་དུས་དང་།",
    "ཤ་སྟེང་རང་སར་སྡོམ་པའི་ཁྲ་དང་།",
    "གཞུག་དུས་ནི་རྨའི་སྐྲངས་དང་ཚ་བ་ཆོགས་པ་དང་།",
    "བར་དུ་རྣག་དུས་དབུག་ཐ་མ་ཤ་གསོ་རྨེན་པ་རྟས་པར་བྱེད་པ་སྟེ་དུས་གསུམ་དཔེ་དང་སྦྱར་བའི་བཅོས་ཚུལ་ཡིན་ཏེ།",
    "བཙའ་བའི་ཐབས་ལ་རྨ་གསར་དང་པོ་མདའ་ཕོག་དུས་ཀྱི་སྡོད་ལུགས་གང་ཡོད་ལྟར་བསྡད་ལ་རྨའི་བཟོ་དབྱིབས་དང་ཆ་བྱད་བསྟུན་ཏེ་བཙལ་བ་དང་།",
    "ཁྲུས་ཀྱིས་བཅད་པ་ནི་དང་པོ་རྣག་དུས་བུལ་ཏོག་ཆུས་བཀྲུས་ལ་རུལ་འདོན།",
    "ཚིགས་ཤོར་གང་ཡང་གཞུག་དུས་ཚིགས་ཁ་བྲལ་པར་བྱ་དགོས་ཏེ་ལུས་མི་གཞན་གྱིས་བཟུང་ནས་གང་ཤོར་བའི་ཡན་ལག་ཐག་པས་དྲག་ཏུ་འཐེན་ལ་ཤོར་བའི་ངོས་སུ་ཕྱིར་རུས་པའི་ཨཕོ་འཔ་བ་དེ་ནས་མཐེ་བོང་ངམ་དྲུ་བུའི་ནང་དུ་ཕུལ་བ་དང་།",
    "འོག་ཏུ་ཤོར་ན་ཡང་གོང་ལྟར་འཐེན་ལ་ཐད་ཀར་ཐེ་གུ་ལྷུག་ལྷུག་མིན་པའི་ཐང་ཐང་བྱུང་བ་དང་བསྟུན་དེ་ལ་འབེམ་དྲུ་བུ་ཁུ་ཚུར་ཙམ་ཞིག་བཅུག་ལ།",
    "སྐྲངས་སམ་ཚའམ་དྲེག་པ་ཆགས་པའམ་ཐོར་པ་ལ་སོགས་པ་གར་འདུག་པ་དེའི་སྟེང་དུ་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ལུམས་བྱ་ཞིང་།",
    "རྩ་རྒྱུད་མ་ངེས་པའི་ཇི་ལྟར་དུ་འདུག་གྱུར་ཀྱང་འགྱུར་ལྡོག་མང་ལ་ཁྱད་པར་༡༨  མན་ངག་རྒྱུད།",
    "ཡང་ན་ཆུ་དེ་སྔ་མ་ལས་ཁ་དོག་དངས་སངས་པ་འདུག་ན་དུག་ཏུ་ངེས་པ་ཡིན་ཞིང་།",
    "མེ་དང་ཉི་མ་དང་བསིལ་གྲིབ་འདོད་ནས་སྙེག་ཅིང་དེ་རྣམས་སུ་ཡུན་རིང་དུ་འདུག་མི་ཚུགས་པ་དང་།",
    "རྨ་བྱའི་ཤ་མ་རྙེད་ན་བྱ་མཚའ་ལུའི་ཤ་རྣམས་སྦྱར་བ་དེའི་སྟེང་ཁྱད་པར་དུ་རང་རང་ལ་ཁ་བསྒྱུར་སྦལ་རྒྱབ་ལ་སྦྱར་བ་དང་།",
    "ཅེས་འདུག་པས་ཉ་ཁྲག་རང་འགལ་བ་ཆུང་བར་སེམས་པ་དང་།",
    "གང་ཞེ་ན་ཚད་ལྡན་གྱི་སློབ་དཔོན་བསྟེན་དགོས་ཤིང་དེ་ཉིད་ཀྱི་ཞལ་ལས་ཤེས་དགོས་པའི་དོན་གྱིས་གསུངས་པ་ཡིན་ཀྱང་འདིར་རྗེས་འཇུག་རྣམས་རྟོགས་སླ་བའི་ཆེད་དུ་དཀྱུས་སུ་གང་འདུག་ལྟར་བྲི་བར་བྱ་སྟེ།",
