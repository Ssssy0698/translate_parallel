    "ཁོང་རང་ཉིད་ཀྱི་ཞལ་ནས་ཀྱང་།",
    "ལྟ་དགོངས་རིགས་དེ་དག་ཀྱང་རང་རིགས་ལ་ཞེན་པའི་ཀུན་སློང་གཙང་མ་ཡིན་མིན་ཅི་རིགས་མཆིས་ཀྱང་།",
    "དེ་ནས་མི་ལོ་བརྒྱ་ཙ་ན།",
    "སྒྲ་གཅན་འཛིན་བཟང་བོའི་སྐུ་དུས་ནས་བརྩིས་ཏེ་ལོ་ཉིས་བརྒྱ་ལོན་ཙ་ན།",
    "འདིའང་ཐ་སྙད་དུ་ཕྱི་དོན་མེད་ཅིང་རང་རིག་བཞེད་པ་སོགས་ཀྱི་ཆ་ལ་རྣལ་འབྱོར་སྤྱོད་པའི་སེམས་ཙམ་པའི་གཞིའི་རྣམ་བཞག་འདོད་ལུགས་དང་མཐུན་པས་ན།",
    "འདི་པས་དཔལ་མགོན་ཀླུ་སྒྲུབ་ཀྱི་རྩོད་ཟློག་དང་རང་འགྲེལ།",
    "ང་རང་ཤི་མ་ཚར་བར་རྩོད་པ་མི་ཡོང་།",
    "ཁྱེད་རང་གཟབ་གཟབ་ཀྱིས།",
    "འགོག་པའི་ཡོ་ལང་བཤམས་ཀྱིན་གདའ།",
    "ང་རང་ཤི་མ་ཚད་བར་དུ་རྩོད་པ་མི་ཡོང་།",
    "ཐ་སྙད་ཚད་གྲུབ་འཇོག་ལ་བློ་མ་བདེ་ཞེས་པའི་ཚིགས་བཅད་བར་བྲིས་འདུག་པ་ཞེས་པ་དེ་གནང་ནས་འདི་ལ་ལྟོས་གཉིད་འགོག་པ་ཡིན་གསུངས་ནས་གནང་བྱུང་བ་ཤིན་ཏུ་ཕན་པོ་བྱུང་།",
    "སྔ་ཕྱི་ཕྱོགས་གཉིས་ནས་ཀྱང་རང་རང་ལ་རྒྱབ་རྟེན་གྱི་ལུང་དང་དགོངས་པའི་བབ།",
    "དགེ་ལྡན་ཕྱོགས་ཀྱི་མཁས་གྲུབ་ཉམས་མྱོང་ཅན་ཚོས་ཀྱང་གསལ་བ་དགོངས་འདུག་སྟེ།",
    "དགག་རྒྱུ་རྭ་ཅན་ཞིག་འཚོལ་བར་འདུག་སྟེ།",
    "དོན་ལ་ཀུན་བཏགས་ཀྱི་མ་རིག་པའི་ཡུལ་གྱི་ཁྱད་པར་འགའ་ཞིག་དགོས་པ་རྒྱ་ཆེན་པོའི་དོན་དུ་མཁས་པ་རྣམས་ཀྱི་རྟོག་གེའི་རིགས་པས་ཆེས་གསལ་དུ་བཏང་བ་ཞིག་འདུག་ལ།",
    "ཐ་སྙད་དུ་ཡོད་པ་སྣང་རུང་རང་བཞིན་གྱིས་གྲུབ་པ་དབེན་པས་ཡོད་གོ་མི་ཆོད་པ་དང་།",
    "མེད་གོ་མི་ཆོད་པ་ཙམ་དུ་མ་ཟད་ཀྱིས་ཡོད་གོ་ཆོད་པར་འདུག་ཅེས་དོན་དམ་པར་མེད་པས་མེད་གོ་མི་ཆོད།",
    "དགག་རྒྱུ་རྭ་ཅན་ཞིག་འཚོལ་འདུག་སྟེ།",
    "ཡོད་པ་མིན་པ་ལ་སྤྱོད་ན་མཚན་མ་ལ་སྤྱོད་དོ་སོགས་ཀྱི་ལྷན་པ་མཛེས་པོ་དེ་ཚོ་སྣང་མེད་དུ་བཞག་འདུག་པས།",
    "དེ་དག་རྣམས་ཕྱོགས་གཅིག་ཏུ་བཀོད་ནས་བལྟས་ན་ཚིག་དོན་གཉིས་ཆ་ནས་རོ་བཅུད་མྱོང་རྒྱུ་འདུག་པས་གཤམ་དུ་འགོད་པར་བྱའོ།",
    "སྲེད་པ་སྐྱེད་ལ་ཁྱད་པར་མི་འདུག་པས།",
    "རང་རང་ས་ན་བདེན་པའི་སྟོབས་རྫོགས་པས།",
    "རང་རང་ལུགས་ཀྱི་བརྟག་དཔྱད་བྱས་པར་ངེས།"
  ]
