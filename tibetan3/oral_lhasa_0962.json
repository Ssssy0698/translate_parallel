    "མིག་མདུན་དུ་ལྷ་རུ་སྣང་ཞིང་དངོས་ཡོད་འཚོ་བའི་དངོས་གཞི་ལས་བརྒལ་པར་སྙམ་ཕྱིར།",
    "ང་། ཕྱིར་འོང་འདོད་ཅེས་རྟོགས་སད་ཅིག་ལས་ཐོན་པའི་དམ་བཅའ་འདི་ནི་རང་དོན་ཕྲན་བུ་ཙམ་འགྲུབ་པར་འཇོག་པའམ།",
    "འོན་ཀྱང་རྩོམ་པ་པོས་ཐབས་མཁས་ཀྱིས་སྙན་ཚིག་ཁྲོད་བརྗོད་གཞིའི་བཅོལ་ཡུལ་དུ་གྱུར་པའི་ཡིད་བརྙན་དུ་མ་སྒྱུ་རྩལ་གྱིས་ཚོགས་གྲུབ་བྱས་པས།",
    "ཆུ་འདིའི་སྟོད་བརྒྱུད་གདོད་མའི་ནགས་ཚལ་ལགས།",
    "ནགས་ཚལ་ལྷག་ལུས་མེད་པར་བཅད་དེ།",
    "གཙང་ཆབ་ཉི་འོད་ཁྲོད་དུ་བཞུར་ལ་ཀུན་ནས་ངལ།",
    "ཙམ་བྱས་ནའང་རྩོམ་མཁན་དང་ལྷན་དུ་ཉམས་འུར་འབྱུང་སླ་བ་ཡིན།",
    "རབ་བཏགས་ཀྱི་སྒོ་ནས་སྤེལ་པས་སྙན་ངག་ལ་མཚོན་སྟོབས་ཀྱིས་ཕྱུག་པར་མ་ཟད།",
    "ཅུང་ཟད་དྭངས་གཙང་དང་ལྡན་པའི་སེམས་ཀྱིས་ཀྱང་།",
    "རྔམ་བརྗིད་ཀྱི་ངང་ནས་ཁེར་འགྱིང་གནང་ཡོད་པའི་ཚུལ་ལ་ཡིད་ཆེས་བརྟས་པས།",
    "བྱེད་འདོད་ཨང་ཞེས་ཁས་ལེན་དེ་སྟོང་བར་མ་བསྐྱུར་པར།",
    "མིའི་རིགས་པའི་ངོས་ཟིན་ཞིག་གམ་ཤེས་རྟོགས་ཁྱད་པར་བ་ལས་བསླངས་ཤིང་།",
    "ཡང་ཕྱོགས་གཞན་ཞིག་ནས་བལྟས་ན་སྲིད་པའི་ལྷ་ཆེན་ཞེས་པ་འདི་ལྷའི་རིགས་ཙམ་དགར་བ་རྐྱང་རྐྱང་ཞིག་མིན་པར།",
    "མཚམས་སྤྲིན་གྱི་ཀློང་ལ་བཞུགས་དུས།",
    "རི་ཁྲོད་ཀྱི་པང་ལ་ཕེབས་དུས།",
    "མཚམས་སྤྲིན་གྱི་ཀློང་ལ་བཞུགས་དུས།",
    "སྐྱེས་ཆེན་ག་འདྲ་ཞིག་ཡིན་ཀྱང་དུས་ཕྱིས་ཀྱི་བརྩོན་པར་བརྟེན་པ་ལས་བྱུང་བ་ཁོ་ཐག་ཡིན་ཕྱིར།",
    "ང་གཙང་པོའི་ཁ་གཏད་དུ་ལངས་ནས།",
    "ངའི་མི་གཙང་བའི་དྲི་མ་དང་ངའི་མི་མཛའ་བའི་རྒས་གཉེར།",
    "གཙང་འགྲམ་དང་གཙང་ཆུའི་ཡུར་རླབས་ཀྱི་སྟེང་ན།",
    "ཆ་རྐྱེན་དང་ཁས་ལེན་ཅི་ཡང་མེད་པར།",
    "སྙན་སྙན་ངག་རང་ངོས་ཀྱི་སྒྱུ་རྩལ་ལ་འཚོལ་སྙེག་བྱེད་པའི་དུས་རིམ་འདིརངག་རྩོམ་མཁན་མང་བོ་ཞིག་ལ་ད་དུང་སྙན་རྩོམ་དངོས་གཞིའི་སྒྱུ་རྩལ་ལ་དོ་སྣང་བྱེད་པའི་རང་འགུལ་གྱི་འདུ་ཤེས་མེད་པར།",
    "རང་སེམས་སུ་ཉར་བའི་སྡུག་ཡུས་སྣ་ཚོགས་ཀྱི་ཚོར་ཤེས་དེ་གཉིས་ཆུ་ལ་ཆུ་བཞག་པ་བཞིན་སྙན་ངག་ནང་ངོས་ཀྱི་འགྱུར་ཁུགས་ལས་ཕྱིར་མཚོན་པར་གདེང་ཐོབ་ཡོད་པར་སྙམ།",
    "སྡུག་ཡུས་ངེས་མེད་དམ་བསྟན་བྱ་ངེས་ཅན་མེད་པའི་ཞིག་སློང་སྐྲུན་བྱས་ཐོག་ཚོར་བའི་རིགས་དེ་དྲོད་འཇམ་དང་ཁུ་བྱུག་ཁྲུང་ཁྲུང་།",
    "ཀློག་མཁན་གྱི་བསམ་ཡུན་དེ་ཇེ་རིང་ལ་བསྲིངས་ཡོད་པར་སྙམ།",
    "འདི་ལྟ་བུར་ད་བཟོད་སྙན་ངག་ནང་ངོས་ཀྱི་འགྱུར་ཁུགས་ཞེས་པར་ངེས།",
    "སྙན་ངག་པས་གསར་གཏོད་བྱས་པའི་སྣང་བརྙན་ཞིག་ལ་བརྟེན་ནས་གནས་ལུགས་དེ་ཕྱིར་མཚོན་བཞིན་ཡོད།",
    "ཏུ་མཛེས་པར་མི་སེམས་སུ་བབས་བྱུང་།",
    "གོ་དཀའ་སླའི་ཁྱད་པར་དེ་སྙན་རྩོམ་འདི་ལྟ་བུའི་སྟེང་ནས་གོ་འབྱེད་བྱས་ན་ལྷག་པར་དུ་རང་ངོ་གསལ་བ་ཡིན།",
    "ཀློག་མཁན་གྱི་རྟོག་འགྱུ་ལ་ཚད་བཀག་བྱས་ཡོད་པར་སྙམ།",
    "དེའི་རྗེས་ཀྱི་ཚན་པ་གཉིས་ཀ་སྙན་ངག་སྒྱུ་རྩལ་གྱི་ཐད་ནས་དཔྱད་ན་དགོས་མེད་ཀྱི་འགྲེལ་བརྒྱབ་པར་སྙམ་པའི་རྣམ་རྟོག་བསྐྱལ་བྱུང་།",
    "ཟིལ་བ་དེ་གཏན་ཆགས་ཀྱི་གནས་གཞི་ཞིག་ཏུ་བཙན་འགོག་བྱས་པས།",
    "ཕ་མ་བུས་ཕྲུག་དང་བཤེས་གཉེན་ཉེ་གྲོགས་ཚང་མ་ཚོང་འདུས་ཀྱི་མགྲོན་པོ་བཞིན་ནམ་འཐོར་ལ་ངེས་པ་མེད་ལཐོབ་མངའ་ཐང་དང་མཚན་སྙན་གྲགས་ཀྱང་བྲག་ཅའི་སྟོང་སྐད་དང་མཚུངས་པར་རྟོགས།",
    "ཐ་ན་རང་ལུས་ཀྱང་གཤིན་རྗེས་གཡར་མ་ཡིན་པར་ངེས་ཤེས་གཏིང་ནས་སྐྱེས་ཀྱང་།",
    "ངས་ད་གཟོད་མཛེས་པ་མཛེས་པར་ཤེས་ཤིང་བདེན་པ་བབདེན་པར་རྟོགས།",
    "བྱས་ལེགས་ན་ལག་པ་འགུལ་སྟངས་ཙམ་གྱིས་ཀྱང་།",
    "མི་མཇེད་འཇིག་རྟེན་གྱི་ཁམས་འདིར་མངོན་དུ་བྱེད་པར་སྟ་གོན་བྱེད་ངེས་པས།",
    "ཐོབ་དཀའ་དོན་ཆེ་མི་ལུས་གཅེས་པར་སྐྱོངས་ཞེས་ཡང་ཡང་གསུངས་ཡོད་པས།",
    "ལྷག་པར་དུ་གཏིང་ཟབ་པའི་གནས་ལུགས་ལ་དེ་བས་ཀྱང་ཡ་མེད་ཀྱི་ཟིལ་ཤུགས་ལྡན།",
    "མཐའ་དག་ལྷུང་ལྷུང་འབབ་པའི་གཙང་བོ་བཞིན་རང་བཞིན་གཤིས་སུ་བབས་པས།",
    "དེ་ལས་འཕྲོས་པའི་རང་ཉིད་ཀྱི་ཐོད་བརྒལ་གྱི་བསམ་བློ་ཞིག་གནས་ལུགས་ཀྱིས་རྒྱབ་རྩར་མནན་ནས་མཚོན་ཡོད་པར་མ་ཟད།",
    "ང་ནམ་ཡང་གཙང་པོའི་ཚུ་རོལ་ཡིན།",
    "ས་ཆེན་གྱི་ཐོང་ག་གཤགས་ཏེ།",
    "ལྷད་མེད་ཀྱི་ཕྱི་བཀོད་དང་སེམས་གཤིས་དག་ལས་དཔེ་གཞི་ཅན་དུ་མངོན་ཡོད་པར་སྙམ།",
    "མཐོང་ཡུལ་དུ་སྣང་བའང་ཞིང་ས་རྨོ་བ་ཙམ་མིན་པར།",
    "བསམ་བཀོད་ཁྱད་པར་ཅན་ཞིག་འདྲེན་བྱེད་དུ་གྱུར་ཏེ།",
    "སྙན་རྩོམ་ལ་བརྗོད་བྱའི་ཐད་ནས་ཀྱང་དོན་བཟང་འབྲས་བུས་ལྕི་བར་བྱས་ཡོད་པར་སྙམ།",
    "རྩོམ་མཁན་རང་ཉིད་ཀྱིས་ཀྱང་ཉིང་དོན་ཞིག་བརྗོད་ཁག་པར་སྙམ།",
    "རྒྱང་རིང་ནས་ཕེབས་བྱུང་།",
    "མཛའ་དུངས་ཀྱི་འཛུམ་པར།",
