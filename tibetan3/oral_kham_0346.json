    "མུ་སྟེགས་རྒྱལ་པོའི་བཀའ་ལ་འདི་སྐད་འདུག།",
    "ནམ་མཁའི་མཐོངས་ནས་གཟུགས་མེད་པར་མཁའ་འགྲོའི་གདངས་དབྱངས་འུར་སྒྲ་ཆེ་བ་ཞིག་འདུག་པས།",
    "དེ་ནས་དཔག་ཚད་གཅིག་ཙམ་འདས་པ་ན་སྨྲ་མཁན་གྱི་ནེ་ཙོ་དེ་མིག་ནས་མཆི་མ་འདོན་ཅིང་འདུག་པས།",
    "ཀླུ་རྒྱལ་གདོལ་པ་དཀར་ནག་ཁྲོས་ནས་འདུག།",
    "ལ་ལས་ཟླ་གྲོགས་དང་བུ་ཚ་བོས་ཤིང་འདུག་པས།",
    "ཁྱེའུ་ཆུང་ལ་མཐུ་རྩལ་ཆེ་བ་འདུག།",
    "དེ་ནས་ཀླུ་ཡུལ་པད་མ་ཅན་གྱི་རྒྱ་ཕིབས་སེར་ཐིང་ངེར་མཇལ་གྱི་འདུག་པས་པད་མ་འོད་འབར་གྱི་ཐུགས་ལ།",
    "ནོར་བུ་ལོན་པའི་སྐལ་བ་མི་འདུག་པས།",
    "ཁྱེའུ་ཆུང་ལ་མཐུ་རྩལ་ཆེ་བ་འདུག།",
    "བྱེའུ་ཚང་བསགས་ཤིང་བཞུགས་འདུག་པས།",
    "ང་རང་མ་ཤི་གསོན་པོ་འདི་གར་ཡོད།",
    "མཐའ་གླིང་རྒྱ་མཚོ་ཆེ་ནས་འཁོར་འདུག་ཟེར།",
    "རྒྱལ་པོའི་བློན་པོ་རྐང་མགྱོགས་འབྱོར་ནས་འདུག།",
    "ཀླུ་རྒྱལ་གདོལ་པའི་ཁ་ནས་ཐར་ཏེ་འདུག།",
    "ནོར་བུ་ལོན་ནས་ཁོ་རང་སྐྱོན་མེད་ཡོང་།",
    "བློན་འབངས་རྒྱལ་པའི་གོང་ལ་ཤོར་ཉེན་འདུག།",
    "ལོན་འདུག་ཟེར་ན་ང་ཡིས་མཚར་དགའ་སྟེར།",
    "པད་མ་འོད་འབར་གྱི་ཐུགས་དགོངས་ལ་ཚོང་ཕྲུག་ལྔ་བརྒྱ་འདི་དག་རྣམས་སྲིན་པོའི་ཡུལ་དུ་འཁྲིད་པ་ལ་སྲིན་པོའི་ཁ་ནས་ཐར་དཀའ་བ་འདུག་པས།",
    "སྲིན་པོའི་ཁ་ནས་ཐར་བ་མི་འདུག་པས།",
    "ཕ་ཡུལ་དུ་ལོག་ན་མུ་སྟེགས་རྒྱལ་པོ་ཁོ་ཡི་མིག་འོག་ནས་ཐར་བ་མི་འདུག་སྲིན་པོའི་ཡུལ་དུ་ཕྱིན་ན་སྲིན་པོའི་ཁ་ནང་ནས་ལོས་མི་ཐར།",
    "འཐག་སྨད་ལུང་པའི་མདའ་རུ་བཅོལ་ཞིང་འདུག་པས།",
    "ཁྱེའུ་ཆུང་ལ་མཐུ་རྩལ་ཆེ་བ་འདུག།",
    "ཁྱེའུ་ཆུང་ལ་མཐུ་རྩལ་ཆེ་བ་འདུག།",
    "ཁ་ནང་ལ་མི་མགོ་སྐམ་པོ་མུར་མུར་བྱེད་པ་མཐོང་བ་ཙམ་གྱིས་འཇིགས་ཤིང་སྐྲག་པ་ཞིག་འདུག་དེ་མདུན་དུ་པད་མ་འོད་འབར་གྱིས་བྱོན་ནས་འདི་སྐད་ཅེས་ཞུས་སོ།",
    "ཁྱེའུ་ཆུང་ལ་མཐུ་རྩལ་ཆེ་པ་འདུག།",
    "ད་ལྟ་སྲིན་པའི་ཡུལ་ནས་འཁོར་འདུག་ཟེར།",
    "གསེར་སླང་རྔ་ཡབ་བཅས་པ་ལོན་འདུག་ཟེར།",
    "ད་ལྟ་སྲིན་པོའི་ཡུལ་ནས་འཁོར་འདུག་ཟེར།",
    "བླ་གནས་ཀྱི་གསེར་སླང་མེད་པའི་གཉིད་གཏད་ཀྱིས་མནན་འདུག་པས།",
    "གནས་སྐབས་ནི་ཏིང་ངེ་འཛིན་ལ་འདུག་ཀྱང་རུང་།",
    "སེམས་མྱལ་མྱལ་པོར་འདུག་པ་དང་།",
    "གཉིད་ཀྱིས་ནོན་པ་ལྟ་བུར་འདུག་པ་དང་།",
    "བསམ་གཏན་དང་གཉིད་དབྱེ་བ་མེད་པར་འདུག་པའོ།",
    "རྒྱུ་དང་རང་བཞིན་སློབ་ཚུལ་དང་།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་སྟེ།",
    "སྣང་ཙམ་ཉིད་ནས་ཆུ་ཟླ་ལྟར་སྡོད་ཚུལ་དང་འདུག་ཚུལ་དང་།",
    "སྨིག་རྒྱུའི་དཔེ་ལ་སོགས་པ་གཞན་ལ་བརྟེན་ནས་ཀྱང་རང་བཞིན་མེད་པའི་དོན་རྟོགས་པར་བྱའོ།",
    "འདུག་གོ་སྙམ་པ་དང་།",
    "ཧ་ཅང་ཡང་མི་དགྱེ་བར་སྒལ་ཚིག་དོང་ཙེ་རྩེགས་པ་ལྟར་དྲང་པོར་སྲང་ལ་ཡིད་ཀྱི་དྲན་པ་ཕྱི་རོལ་དུ་ཧ་ཅང་མི་འཕྲོ་བར་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "རྣལ་འབྱོར་པ་དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཏིང་ངེ་འཛིན་ལ་ཡང་དག་པར་བཞག་ནས་སྦྱོར་བའི་དུས་སུ་ཇི་ལྟར་ལེགས་པར་བསམས་པའི་དོན་དེ་དག་ཉིད་ཡིད་ལ་བྱེད་ཅིང་།",
    "དེའི་ཚེ་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་མཉམ་གཞག་ཏུ་འདུག་པར་བྱའོ།",
    "དེ་ཡང་རང་ཐིམ་འོད་གསལ་དང་།",
    "རང་ཉིད་ཅེས་པར་ཁྱེད་རང་རྣམས་ཞེས་བསྩར།",
    "གཞན་ཡང་རང་གཞན་གྱྀ་ལེགས་ཉེས་བདེ་སྡུག་ཀྱང་རྨི་ལམ་གྱི་སྐབས་སུ་ལུང་བཅུབརྡ་རྟགས་མི་རིགས་པ་འབྱུང་སྲིད་པས།",
    "བཛྲམུས་ཚོགས་ཞིང་རང་བཞིནགྱི་གནས་སུགཤེགས་པར་བསམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་རྣམ་པར་མི་རྟོག་པའི་ངོ་བོ་ཡི་གེ་ཏཱཾ་ལྗང་གུསོགས་ནས།",
    "དེ་ཐམས་ཅ་ད་ཀྱི་ཐུགས་ཀནས་ཐུགས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་རྗེ་བཙུན་མའི་སྐུའི་རྣམ་པ་བསམ་གྱིས་མི་ཁྱབ་པ་སྤྱན་དྲངས་ཏེ་ཁྱེད་རང་རྣམས་ལ་སཾབ་སིབ་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབས་པའྀ་མེས་བམཛོད།",
    "ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཚུར་འདུས་པ་ལས་ཁྱེད་རང་རྣམས་རྗེ་བཙུན་སྣོལ་མ་སོགས་ནས།",
    "མཐར་དེ་དག་ཐམསཅད་ཀྱང་རང་བཞིནམེད་ོབཀའ་པ་རྨི་ལམ་གྱི་ཚུལ་དུ་སྒོམ་སྟེ།",
    "གདའ་འོད་ཟེར་གྱིརྣམ་པར་གྱུར་ཏེ་རང་ལ་ཐིམ་ཞེས་པའི་རྗེས་གཏོར་མ་ལཆབ་བཱན།",
    "ཉེན་ལ་ཁ་ཕྱོགས་པར་འདུག།",
    "དབེན་ཞིང་ཡིད་དང་མཐུན་པའི་བསམ་གཏན་གྱི་ཁང་བུར་འཇམ་པའི་སྟན་ལ་ང་འདུག་སྟེ།",
    "ཉན་ཐོས་དང་རང་སངས་རྒྱན་ཝཱཐམས་ཅད་ཀྱིས་དགོངས་པར་འགྱུར་བ་དང་།",
    "ཨ་ར་པ་ཙ་ན་ལ་སོགས་པ་བསྣམས་བ་ནི་བཟོད་པའི་གཟུངས་སོ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ཀྱིནང་ཐམས་ཅད་གང་།",
    "ཞའ་གཅིག་ཕྱག་གཉིས་མ་ཆགས་པའི་འདུག་སྟངས་ཅན།",
    "ཁྱེད་རང་རྣམས་ལུས་བསམ་གཏན་གྱི་སྐྱེད་ལམ་སོགས།",
    "ཐོག་མར་ཁྱེད་རང་རྣམས་ཀྱིས་ཕྱོགས་ཐམས་ཅད་ལ་མེས་གུས་གདུང་ཤུགས་དྲག་པོས་གསོལ་བ་བཏབ་པས་མདུན་གྱི་ཨཁྱེནབཅས་ཏེ་འདི་གསུང་རར་ཞུ།",
    "རང་རང་མིང་ནས་སྨོས་ཏེ།",
    "རྗེས་འབྲེལ་དུ་ག་ཏོར་མའབུལ་བ་ནི་སློབ་དཔོན་གྱིས་བགྱི་བར་གདའ་སྟེ།",
    "ཚིག་འདི་རྣམས་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོདསྤྱད་ན།",
    "འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "དེ་ནས་དཔོན་སློབ་གཉིས་ཀ་འདུག་ནས།",
    "འགྲེ་འཆག་ཉལ་འདུག་སྤྱོད་ལམ་ཐམས་ཅད་དུ།",
    "འདུས་མ་བྱས་པ་དང་རང་རིག་པའི་ཕྱིར་རོ།",
    "སྤྱོད་ལམ་ཐམས་ཅད་དུའོ་ཞེས་པ་ནི་ལྡང་བ་འདུག་པ་དང་ཉལ་བའི་སྟེ་འཆག་པ་ཞེས་བྱ་བ་སྟེ་བཞི་ལའོ།",
    "སྔགས་དང་བྱེད་དང་འདུག་སྟངས་སྦྱིན་སྲེག་དང་།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་གོས་དང་ལྡན་པ་ཡིད་དགའ་བ་བྱང་དུ་ཁ་བལྟས་པ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་གནས་པ་རྐང་པ་གཡོན་པས་རྐང་པ་གཡས་པ་མནན་ཞིང་མིག་མི་གཡོ་བ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་པ་ལ་སོགས་པའི་གཟུགས་བླངས་ཏེ་ཀླུའི་མཚོ་ལ་སོགས་པའི་འགྲམ་དུ་འདུག་ནས་སྔོན་གྱི་བསྙེན་པ་སྔོན་དུ་འགྲོ་བར་འོ་མ་ལ་སོགས་པའི་ལྷ་བཤོས་དབུལ་ཏེ།",
    "དེ་རྣམས་ཀྱི་མཆོག་ནི་ཉན་ཐོས་པ་དང་རང་རྒྱལ་བ་རྣམས་སོ་ཞེས་པ་ནི་འདོད་ཆགས་དང་བྲལ་བ་ཡིན་པས་སོ།",
    "དཔེར་ན་ས་ལ་འདུག་པ་དང་།",
    "ཤིང་རྟ་ལ་འདུག་པ་དང་རྫ་མར་འཚེད་པའོ།",
    "པེ་སྣར་འདུག་པེ་སྣར་ཡང་།",
    "རང་རང་ཐུགས་བཞེད་ཇི་བཞིན་འབུལ་ལགས་ན།",
    "ཞེས་བརྗོད་ལ་མཆོད་གཏོར་ཕུལ་བས་སྲུང་མ་ཐམས་ཅད་དགའ་མགུ་ཡི་རངས་ནས་ཅི་བཅོལ་བའི་ཕྲིན་ལས་བསྒྲུབ་པར་ཞལ་གྱིས་བཞེས་ཤིང་རང་རང་གནས་སུ་གཤེགས་པར་དམིགས་ལ།",
    "གྲང་སར་འགྲོ་འདུག་བྱེད་ན་ལུས་མེ་དཔུང་དུ་བསྒོམ་ལ།",
    "སྤྱིར་འོད་གསལ་ལམ་དང་རང་བཞིན་གཉིས་སུ་འདུས་པའོ།",
    "སྣང་བཞིན་དུ་མི་བདེན་པར་སྣང་སྟོང་རང་བཞིན་མེད་པའོ།",
    "ཟུང་འཇུག་ལ་བརྟན་པ་མ་ཐོབ་པར་སྐྱེ་བ་ལེན་པར་འདུག་ན་མངལ་སྒོ་དགག་པའི་གདམས་ངག་ཉམས་སུ་ལེན་པའོ།",
    "དེ་ལ་ཡང་བརྟན་པ་མ་ཐོབ་པར་སྐྱེ་བར་ལེན་པ་འདུག་ན།",
    "བསྒོམ་དང་རང་བཞིན་འོད་གསལ་གཉིས།",
    "ནང་རང་ལུས་ལུང་མ་བསྟན་དུ་བཟུང་བའི་བར་དུ་རང་སེམས་འདི་ཉིད་སྟོང་པ་རུ་ཐག་བཅད་ནས་རྣམ་པར་རྟོག་པ་ལ་ལམ་བྱས་པའམ།",
    "ནང་རང་ལུས་ལས་བྱུང་བ་ཨེ་ཡིན་སྙམ་ན།",
    "ནང་རང་ལུས་ལ་བརྟགས་ན་ཡང་མགོ་ལ་ནི་མགོ་ཟེར་བ་ལས་ང་མི་ཐོགས།",
    "ཀུན་བྱེད་རྒྱལ་པོ་རང་བྱུང་རང་ལ་ཐིམ།",
    "ཆུ་སྣོད་དུ་བླང་ཚེ་ཁ་དོག་སྐྱ་བོར་འདུག་པ་ཡིན།",
    "དེའི་ཕྱིར་ན་མགོ་ཞེས་བྱ་བ་བརྗོད་པ་ཙམ་གྱིས་བརྗོད་གཞི་ཡུལ་མེད་དུ་འདུག་པའི་ངང་ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པར་བྱེད་དགོས་པ་ཡིན་ནོ།",
    "འགྲོ་འདུག་བྱེད་མཁན་འདི་རྐང་པ་ཡིན་པས།",
    "རྐང་པ་མེད་ན་འགྲོ་འདུག་བྱེད་མཁན་མེད་སྙམ་ན།",
    "མདང་རྨི་ལམ་གྱི་སྐབས་ཡུལ་ནས་ཡུལ་དུ་འགྲོ་འདུག་དང་གར་བྱེད་པ་སོགས་བྱས་ཀྱང་།",
    "རྨི་ལམ་གྱི་འགྲོ་འདུག་བྱེད་མཁན་ཞིག་ཡོད་ཀྱང་།",
    "བར་སྲིད་དང་ཕྱི་མའི་དུས་ཀྱི་འགྲོ་འདུག་བྱེད་མཁན་དེ།",
    "རྐྱེན་ཕ་རོལ་བའི་ཐབས་ཀྱིས་དཀྲུགས་པ་དང་རང་བཞིན་རླབས་ཀྱིས་དཀྲུགས་པ་ལ་རྐྱེན་བྱས།",
    "ནང་རང་ལུས་ལ་གཅེས་འཛིན་དུ་གོལ་ནས།",
    "དགེ་སྡིག་གཏན་ལ་ཕབ་པ་ལ་དགོས་པ་མི་འདུག་སྙམ་ན།",
    "སྟོང་པ་ཕན་མེད་གནོད་མེད་དུ་འདུག་པ་འདི་ཅིའི་ལན་པ་ཡིན་ཞེས་ཞུས་པས།",
    "དེ་དག་རྣམས་ཀྱིས་ལུགས་སུ་ནི་སྣང་བོ་ཐམས་ཅད་རྣམ་རྟོག་དང་རང་སེམས་དངོས་སུ་སྟོན་ཀྱང་སྣང་བ་དང་སེམས་གཉིས་གཅིག་མ་ཡིན།",
    "དེས་ཀྱང་རང་ལམ་ནས་བདེན་པ་དང་།",
    "སྟོང་པར་འདོད་ཀྱང་རང་ངོས་ལས་སྟོང་པ་ཙམ་ལས་མི་འདོད་ན།",
    "དེ་བཀག་ཀྱང་རང་ཡལ།",
    "བཞག་ཀྱང་རང་ཡལ་དུ་འགྲོ་བ་ལས་མེད་དེ།",
    "ལུས་ཀྱི་སྒོ་ནས་ཕྱིའི་བྱ་བ་རང་བཞིན་འགྲོ་འདུག་འགུལ་བསྐྱོད།"
  ]
}