    "ཤེས་པར་བྱ་བའི་རྒྱུ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
    "སེམས་གང་འགགས་པ་དེ་ཕྱིར་སྐྱེ་བར་འགྱུར་བའམ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་སེམས་དངོས་པོ་མེད་ཅིང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་དེ་དངོས་པོ་ཡོད་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གསོལ་པ་བཅོམ་ལྡན་འདས་ཡིད་ལ་བགྱི་བ་དེ་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་དང་བྲལ་བ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དེ་ལྟར་གོང་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ་དེ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པས་དེ་ཉིད་ལ་མི་སྤྱོད་དོ་ཞེས་བསྟན་པའོ།",
    "ཉན་ཐོས་དང་རང་པར་བྱ་བའམ་སྙམ་དུ་རྟོག་པ་བསལ་བའི་ཕྱིར་ཞུས་པ་དང་།",
    "སྒྲུབ་པར་བྱེད་པ་གཉི་ག་ཡང་རང་བཞིན་མེད་ན།",
    "གང་ན་འདུག་༢༢༣ པེ་སྣར་བྱེད་པ།",
    "རང་རང་༣༧༢ ཨེ་པེ་སྣར་བའི།",
    "དཔག་ཏུ་མེད་པ་གང་ཡིན་པ་དེ་དག་དུས་དཔག་ཏུ་མེད་པའི་བར་རབ་ཏུ་ཡང་མི་བརྗེད་པར་འཛིན་པའི་དྲན་པ་དང་།",
    "དེ་ལྟར་དབྱིབས་དང་གཟུགས་ལ་སོགས་པ་ཅིཐམས་ཅད་ཀྱི་ལུས་དང་འདྲ་ཡང་རང་བཞིན་མི་ཤེས་ཤིང་།",
    "ང་རང་བཞིན་གྱིས་ིམྱ་ངན་ལས་འདས་པ་དང་།",
    "གླང་པོ་ཆེའི་ལྟ་སྟངས་ཞེས་བྱ་བ་ནི་དམ་པ་རྣམས་ཀྱི་ལྟ་སྟངས་ཏེ་དེ་དག་ནི་སྟེང་ན་འདུགེ་པ་ལ་བསྐྱེད་དེ་མི་ལྟ།",
    "འོག་ནས་འདུག་པ་ལ་བཏུད་དེ་མི་ལྟ།",
    "གཡས་གཡོན་ན་འདུག་པ་ལ་ནི་མིག་བཟུར་ཏེ་མི་ལྟ།",
    "རྒྱབ་ན་འདུག་པ་ལ་ནི་མཇིང་པ་བསྒྱུར་ཏེ་མི་ལྟ།",
    "ཐག་རིང་པོ་ནི་༧འདུག་པ་ལ་བསྒྲིམས་ཏེ་མི་ལྟ།",
    "ཐག་ཉེ་བ་ན་འདུག་པ་ལ་བསྒྲིམས་པ་མེད་པར་ཡང་མི་ལྟའི།",
    "ཇི་ལྟར་འདུག་པའི་སྤྱོད་ལམ་དང་།",
    "འདམ་བུ་ཁོང་སྟོང་དུ་འདུག་ལ་ཚེར་མ་མང་ཞིང་དེ་དག་ཉིད་རབ་ཏུ་སྡུག་ཅིཔའི་ཕྱིར་སྔར་བསྟན་ཏེ།",
    "༨ ༡༧པའི་དེ་བཞིན་ཉིད་ཀྱི་བདག་ཉིད་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཁོ་ནའོ།",
    "དེ་བས་ན་སྟོང་པ་ཉིད་དང་གཟུགས་ལ་སོགས་པ་ལ་ཐ་དད་པ་མེད་པར་གཟུགས་ཀྱང་རང་བཞིན་མ་ཡིན་ལ།",
    "འདི་ལྟར་གཟུགས་ཀྱི་ཡོངས་སུ་གཟུང་ིབ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་སླད་དུ་གཟུགས་མ་ལགས་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བ་ཞེས་བྱའོ།",
    "འདུག་པ་དང་།",
    "མ་གསུམ་ཞེས་བྱ་བའི་གྲངས་ཀྱི་བྱེ་བྲག་ཡོད་པ་མ་ཡིན་ཏེ་དེ་བས་ན་མི་སྐྱེ་བ་ལ་བྱེ་བྲག་མེད་པའི་ཕྱིར་ཡོངས་སུ་གྲུབ་པའི་ཚེ་གཟུགས་ལ་སོགས་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གཅིག་ཏུ་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "༡༨ ཁོ་བ་དང་༡༢ ༡ ༡ཀར་གལ་ཏེ་མི་སྨྲ་བར་འདུག་པས་ཆོག་ན་དེ་ལྟར་ན་ནི་དཀའ་བ་མ་ཡིན་པར་འགྱུར་ན།",
    "བཅོམ་ལྡན་འདས་ཡིད་ལ་བགྱི་བ་དེ་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་དང་བྲལ་བ་སྟེ་ཞེས་བྱ་བ་ནི་ཉི་ཤུ་པའོ།",
    "གཡས་གཡོས་སུ་ིའདུག་སྟེ་བལྟས་ཀྱང་ཞབས་ཀྱི་མཐིལ་སྣང་ཞིང་འགྲོས་སྡུག་གོ།",
    "རྫི་མ་གཉིས་ིགནས་པའི་སྐབས་སྣུམ་ཞིང་མཐིང་ཀར་འདུག་པ།",
    "ནང་སྟོང་པ་ཉིད་ལ་སོགས་པ་སྟོང་པ་ཉིད་བཅུ་དྲུག་པོ་དག་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཡིན་པར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དེ་ཡང་སྔོན་གྱི་མཐར་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པས་དུས་གསུམ་ཅར་དུ་ཡང་སྟོང་པ་ཉིད་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "ན་ཚོད་འདུག།",
    "༢ ང་རང་དད་༩༣ པེ་སྣར་བྱའོ།",
    "ཀྱིན་འདུག།",
    "འདིས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་བརྗོད་པ་ཡིན་ནོ།",
    "རྟོགས་པའི་རང་བཞིན་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པོ།",
    "གང་ལ་བལྟས་ཀྱང་ནི་མི་འདུག།",
    "གར་བསྡད་ཕ་ཡུལ་དུ་འདུག་ཅིང་།",
    "སུ་བྱམས་གཉེན་བཤེས་སུ་གདའ་ལ།",
    "དབུགས་ཙམ་རྒྱུ་གྱུ་བ་འདི་ལས་མི་འདུག་ན།",
    "འདི་ལྟའི་ངང་ཚུལ་དེ་སེམས་ལ་དྲན་ཙ་ན།",
    "སྔར་བཞིན་ཡལ་ཡོལ་དུ་སྟོང་བར་འདུག་བྱེད་ན།",
    "རང་དང་རང་འདྲ་ཡི་གྲོགས་པོ་གཞན་དག་ཀྱང་།",
    "བློ་གཏད་ཐུབ་གཅིག་ཀྱང་མི་འདུག་པས།",
    "ཕན་ནུས་གཅིག་ཀྱང་ནི་མི་འདུག།",
    "ཁོ་འཆི་བདག་རྒྱལ་པོ་བྱུང་ཙ་ན།",
    "རང་གཞན་ཕུང་འདྲེན་དུ་འདུག་གོ།",
    "ཐོག་ཏུ་ཁེལ་དུས་ཤིག་མི་འདུག།",
    "མི་ལུས་དོན་ལྡན་ཞིག་མི་འདུག།",
    "ཚེ་འདི་ཕྱིའི་འདུན་མ་ཁྱེད་རང་མཁྱེན།",
    "དུས་ཡང་ཡང་རང་རྒྱུད་བསྐུལ་བ་ལས།",
    "ཁྱེད་རང་ལ་བརྩེ་བའི་གྲོགས་པོ་དག།",
    "འཕྲང་རང་སར་གྲོལ་བར་བྱིན་གྱིས་རློབས།",
    "དེང་རང་ཡུལ་བགྲོད་ལ་ཉེ་བ་ན།",
    "ཁྱི་བཞིན་ཉུལ་ནས་འདུག་པ་འཐད་དམ་སོམ།",
    "འཕྲང་རང་སར་གྲོལ་བར་བྱིན་གྱིས་རློབས།",
    "ཞྭ་སེར་གྱི་རིང་ལུགས་དྲི་མེད་འདི་ཡིན་འདུག།",
    "ལམ་རིམ་དུ་གྲགས་པ་འདི་ཉིད་རང་ཡིན་འདུག།",
    "ངེས་པ་རུ་སྟེར་བ་བསྐྱེད་རྫོགས་གཉིས་ཡིན་འདུག།",
    "དོན་ག་ཤིས་ལ་གྲུབ་པ་མི་འདུག་པས།",
    "ཁྱེད་རང་དོན་དོར་ནས་བསྟན་འགྲོར་དགོངས།",
    "ཕ་ཁྱེད་རང་གཅིག་པུའི་དྲིན་དུ་ངེས།",
    "རི་སུལ་ཉམས་དགའ་དེ་དྲན་ཀྱང་འགྲོ་ཐབས་མི་འདུག།",
    "ཚེ་ཐུང་ཡུད་ཙམ་ལ་ལྷན་དུ་འདུག་རིང་།",
    "ཝ་བཞིན་འབྲོས་ཤིང་རང་རྒྱུད་མ་རུང་བ།",
