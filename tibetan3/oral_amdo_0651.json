    "དེ་ནས་བུད་མེད་དེ་རྣམས་གར་དང་གླུ་དང་རོལ་མོས་དུབ་ནས་ཁ་ནས་ཁ་ཆུ་འཛག་ཅིང་སྐྲ་ཞིག་ལ་གོས་དང་ལག་པ་དག་ལྷུག་པར་བཏང་ནས་བསླ་བའི་ཚིག་བྱུང་རྒྱལ་དུ་བརྡོལ་ཞིང་གཉིད་ལོག་གོ།",
    "གཟིགས་ནས་ཀྱང་བཙུན་མོའི་འཁོར་ལ་དུར་ཁྲོད་ཀྱི་འདུ་ཤེས་སྐྱེས་ནས་དེས་ཚིགས་སུ་བཅད་དེ་གསུངས་པ།",
    "ཤཱཀྱའི་སྲས་ཀྱིས་གཟིགས་ནས་རང་བཞིན་སྐྱོ་བར་གྱུར།",
    "ཚུལ་དང་བྲལ་བའི་བུད་མེད་ན་ཆུང་ཚོགས་འདི་དག།",
    "བར་སྐབས་དེར་སྐྱེ་དགུའི་བདག་མོ་ཆེན་མོའི་རྨི་ལམ་དུ་བཞི་རྨིས་པ།",
    "བྱ་ཀུན་ནས་དཀར་ལ་མགོ་གནག་པ་རྣམས་ཀྱིས་ཞབས་གཉིས་ལ་གཏུགས་ནས་པུས་མོའི་ལྷ་ང་ལ་ཐུག་གི་བར་དུ་ལྡག་པ་དང་བྱ་སྣ་ཚོགས་ཕྱོགས་བཞི་ནས་འོངས་ནས་མདུན་དུ་ཁ་དོག་གཅིག་ཏུ་འདུག་པ་དང་།",
    "ལྷ་ད་གཟོད་བདག་གིས་གཡར་ལམ་དུ་བརྒྱད་རྨིས་པ།",
    "བདག་གི་སྡུམ་པའི་གདུང་ཆག་པ་དང་།",
    "བདག་གི་ཁྱིམ་གྱི་གདུང་ཆག་གོ་ཞེས་སྨྲས་པ་གང་ཡིན་པ་དེ་མི་འདུག་གམ།",
    "བདག་གི་བཀྲ་ཤིས་ཀྱི་མལ་ཁྲི་ཆག་གོ་ཞེས་སྨྲས་པ་གང་ཡིན་པ་དེ་ཡང་མ་ཆག་སྟེ་འདུག་པའོ་ནི་ཡིན་མོད།",
    "བདག་གི་ལན་བུ་ཞིག་གོ་ཞེས་གང་སྨྲས་པ་དེ་ཡང་ཁྱོད་ཀྱིས་སོ་སོ་རང་གིས་རིག་པར་བྱ་བ་ཡིན་པས་ཅི་ཞིག་གམ་མ་ཞིག་རྟོགས་ཤིག།",
    "ཁྱིམ་ནས་དཔལ་བྱུང་ངོ་ཞེས་སྨྲས་པ་གང་ཡིན་པ་དེ་ནི་བུད་མེད་རྣམས་ཀྱི་དཔལ་ནི་ཁྱོ་ཡིན་ལ་ང་ནི་འདུག་པ་ཉིད་དོ།",
    "རེ་ཞིག་ཤར་ཀྱང་མ་ཤར་ན་ནུབ་པར་ལྟ་ག་ལ་གྱུར་ཅེས་དེ་ལྟར་བརྡ་སྤྲད་ནས་བཙུན་མོ་གྲགས་འཛིན་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལྷ་ཁྱོད་གང་དུ་བཞུད་པ་དེར་བདག་ཁྲིད་ཅིག།",
    "གང་དུ་འགྲོ་བ་དེ་དང་དེར་ཁྱོད་བཀྲིའོ།",
    "དེ་ནས་ཤིན་ཏུ་གསལ་བའི་སྣང་བ་གཟིགས།",
    "རྟ་གླང་ཤིང་རྟ་དཔུང་ཚོགས་མང་པོ་ཡིས།",
    "ཁྱོད་ཀྱི་སྔོན་གྱི་དམ་བཅས་དགོངས་མཛོད་ལ།",
    "ཇི་ལྟར་ཁྱོད་ནི་བགེགས་མེད་པར།",
    "ལྷ་ཁྱོད་སྐྱེད་མོས་ཚལ་གྱི་དུས་མ་བབ།",
    "དེས་པ་ཁྱོད་དང་འགའ་ཡང་ཁོ་ན་མ་མཆིས།",
    "ཁྱོད་ལ་དགྲ་བོ་སུ་ཡང་མ་མཆིས་ན།",
    "དགུང་ཕྱེད་ཁྱོད་ལ་བཅིབས་པས་ཅི་ཞིག་བགྱིད།",
    "འདུན་པ་ཁྱོད་ཀྱིས་ལན་འགའ་ཡང་།",
    "གཞོན་ནུ་མཚན་མོ་འདི་ནི་འཇིགས་པ་དང་འཇིགས་སུ་རུང་བ་མཆིས་པས་བདག་བཅིབས་པ་མི་ལེན་ནོ།",
    "ལན་དང་ཡང་ལན་གྱིས་གདོན་མི་ཟ་བར་སྐྱེ་བོ་སད་པར་འགྱུར་གྱིས་བདག་ཉིད་སོང་ལ་རྟའི་རྒྱལ་པོ་བསྔགས་ལྡན་སྟ་གོན་བྱའོ་སྙམ་ན།",
    "བདག་ཅག་གིས་བཀུར་ལགས་སོ།",
    "གཅིག་གིས་གསོལ་པ།",
    "གཞོན་ནུ་བདག་གིས་ནི་སའི་རྡུལ་ཇི་སྙེད་མཆིས་པ་ཁུར་དུ་ཐོགས་ཏེ་མཆིའོ།",
    "བདག་གིས་ནི་རྒྱ་མཚོ་ཆེན་པོ་བཞི་དང་།",
    "བདག་གིས་ནི་ས་ལ་རི་ཇི་སྙེད་མཆིས་པ་དེ་ཐམས་ཅད་ཁུར་དུ་ཐོགས་ཏེ་མཆིའོ།",
    "བདག་གིས་ནི་ས་ལ་རྩྭ་དང་ཤིང་དང་ཡལ་ག་དང་ལོ་མ་ཇི་སྙེད་མཆིས་པ་དེ་ཐམས་ཅད་ཁུར་དུ་ཐོགས་ཏེ་མཆིའོ།",
    "ང་བུད་མེད་དང་ལྷན་ཅིག་ཁྱིམ་ན་ཉལ་བའི་ཐ་མ་ནི་འདི་ཡིན་ནོ་སྙམ་མོ།",
    "ཡང་དགོངས་པ་གལ་ཏེ་ང་ཤར་སྒོ་སྤངས་ཏེ་སྒོ་གཞན་ནས་བྱུང་ན་གཞོན་ནུས་ནི་བདག་ལ་ཐ་མའི་དུས་ན་ཡང་མ་བལྟས་སོ་སྙམ་དུ་རྒྱལ་པོ་མི་དགའ་བར་འགྱུར་རོ་སྙམ་མོ།",
    "ཇི་ཙམ་ན་རྒྱལ་པོ་ཟས་གཙང་གཉིད་སྟུག་པོས་ནོན་པ་གཟིགས་ནས་དེས་དེ་ལ་བསྐོར་བ་མཛད་དེ་གསུངས་པ།",
    "རེ་བ་འབྲས་བུ་མེད་པར་གྱུར།",
    "དེ་བཞིན་བཙུན་མོའི་འཁོར་རྒྱས་པའང་།",
    "སྡུག་བསྔལ་ཉམ་ཐག་དུར་འོང་གིས།",
    "ཁྱོད་ཀྱིས་ཁྱིམ་ཐབ་གཤེགས་འགྱུར་འདི་ནི་མཐོང་དཀའ་སྟེ།",
    "ཁྱོད་ཀྱིས་འདི་ལྟོས་ཁྱིམ་ཐབ་མཐོང་བའི་ཐ་མ་ཡིན།",
    "ཀྱི་ཧུད་ཕོངས་པས་བདག་གིས་མཚན་མོ་ཀུས་བཏབ་ཀྱང་།",
    "སུས་ཀྱང་ལན་མ་སྟེར་བས་བདག་གིས་མཉེས་སོ།",
    "དེ་ནས་ཤཱཀྱ་མིང་ཆེན་སྡུག་བསྔལ་ཞིང་ཡིད་མི་བདེ་བས་གདུངས་ནས་དེ་རིངས་པར་རྒྱལ་པོ་ཟས་གཙང་གི་དྲུང་དུ་སོང་ནས་རྒྱལ་པོ་ཟས་གཙང་བསླང་སྟེ་སྨྲས་པ།",
    "གཡོན་ཕྱོགས་ནས་འདོད་པ་ན་སྤྱོད་པའི་ལྷ་རྣམས་ཀྱིས་རྒྱལ་མཚན་དང་བ་དན་བསྒྲེང་ནས་ལྷའི་རོལ་མོའི་ཁྱད་པར་སྣ་ཚོགས་དང་།",
    "མདུན་ནས་བརྒྱ་བྱིན་དང་ཚངས་པ་ལ་སོགས་པ་རང་རང་གི་སྤྱོད་ལམ་གྱིས་དོང་ངོ།",
    "ལྷའི་རོལ་མོའི་ཆ་བྱད་སྣ་ཚོགས་ཀྱང་བརྡུངས་སོ།",
    "དགའ་བའི་ཡིད་ཀྱིས་གོས་ཀྱི་གཡབ་མོས་འདེབས་བྱེད་ཅིང་།",
    "ནམ་མཁའ་ལ་ནི་སོར་མོ་བརྒྱ་ཕྲག་སྒྱུར་བར་བྱེད།",
    "གྲོགས་པོ་ཁྱོད་ཡུན་རིང་པོ་ནས་ནམ་ཞིག་ནང་བགེགས་ལས་ཐར་ཏེ་དཀའ་ཐུབ་ཀྱི་ནགས་སུ་འགྲོ་བར་འགྱུར་སྙམ་དུ་དགོངས་པ་སྐྱེད་པ་གང་ལགས་པ་དེ་དེང་དུ་ཡོངས་སུ་རྫོགས་པ་ལགས་ཀྱིས།",
    "འདུན་པ་རྒྱན་དང་རྟ་ཁྱེར་ལ་སླར་སོང་ཤིག།",
    "ཁ་ལོ་སྒྱུར་ཁྱོད་ང་ཡི་རྟ་འདི་དང་།",
    "སེང་གེ་སྟག་གིས་བལྟམ་པ་དང་།",
    "ཀྱེ་ཧུད་གཞོན་ནུས་སྡུག་བསྔལ་མ་གཟིགས་ཏེ།",
    "གཞོན་ནུ་ནི་རྒྱལ་རིགས་ཀྱི་ང་རྒྱལ་ཅན་ཡིན་པས་འདི་ཕྱིར་བཟློག་པར་མི་ནུས་སོ་སྙམ་མོ།",
    "བསྔགས་ལྡན་སོང་ཤིག་དང་།",
    "གལ་ཏེ་ལྷན་ཅིག་ཏུ་དོང་ན་སྨྲེ་སྔགས་ཆེན་པོས་བདག་ཤི་བར་འགྱུར་རོ་སྙམ་ནས་དེས་སྐྱེད་མོས་ཚལ་དུ་འདུག་ནས་བསྔགས་ལྡན་བཏང་ངོ།",
    "དེ་དག་གི་མ་རྒན་མོ་དེས་དེ་དག་ལ་ཤ་ནའི་གོས་དག་ཅིག་བྱིན་པ་དང་།",
    "དེས་ན་ཁྱོད་ཀྱིས་འབྲས་བུ་ཆེན་པོ་ཐོབ་པར་འགྱུར་རོ་ཞེས་སྨྲས་ནས་འབར་བ་དང་།",
    "རྒན་མོ་དེས་ཀྱང་འཆི་ཁར་གོས་དེ་དག་བུ་མོ་ལ་གཏད་ནས་ཇི་ལྟར་གྱུར་པ་རྣམས་སྨྲས་སོ།",
    "གཟིགས་ནས་ཀྱང་མི་དེ་ལ་གསུངས་པ།",
    "གཞོན་ནུ་བདག་ལ་གཞན་དག་ཁྱོད་ཀྱིས་རྒྱལ་བུ་གཞོན་ནུ་བཀྲོངས་ནས་ཀ་ཤི་ཀའི་རས་ཕྲན་གྱི་གོས་འདི་དག་བླངས་སོ་ཞེས་གཞི་དེས་གཡར་མཆི་བར་འགྱུར་ལགས་པས་བདག་འདི་དག་མི་འབུལ་ལོ།",
    "ཀྱེ་ནང་རྗེ་ང་ནི་མཐུ་ཇི་ལྟ་བུ་དང་ལྡན་པ་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཤེས་ཏེ་སུ་ཞིག་གིས་ང་དགྲོངས་པར་ནུས།",
    "ཁྱོད་ཀྱིས་ང་དགྲོངས་པར་སུ་ཞིག་ཡིད་ཆེས་ཀྱིས་བག་ཚ་བ་མེད་པར་བྱིན་ཅིག།",
    "འགྲོ་བ་རྣམས་རྗེས་སུ་གཟུང་བར་བྱའོ་སྙམ་མོ།",
