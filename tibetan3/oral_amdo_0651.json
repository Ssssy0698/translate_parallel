    "དེ་ནས་སའི་ལྷས་ས་བརྟོལ་ནས་ཐལ་མོ་སྦྱར་ཏེ་སྐད་ཕྱུང་བ།",
    "བདག་གིས་ཤཱཀྱ་ཟས་གཙང་གི་བུ་ལ་དེ་ལྟར་བྱས་ཀྱང་གླགས་མ་རྙེད་ཀྱིས།",
    "མ་ལ་འདི་ལ་བདག་གིས་ཡང་བགེགས་ཤིག་བྱའོ་ཞེས་སྨྲས་ནས་སོང་ངོ།",
    "དེ་ནས་དེས་བུ་མོ་གསུམ་པོ་སྲེད་མ་དང་།",
    "བདུད་ཀྱིས་དེ་རྣམས་དེ་ལྟ་བུའི་རྣམ་པར་མཐོང་ནས་ཡི་ཆད་ནས་ལག་པ་ལ་འགྲམ་པ་གཏད་དེ་གང་གིས་ན་ཤཱཀྱ་ཟས་གཙང་གི་བུའི་དཀའ་ཐུབ་ལ་བགེགས་བྱེད་པར་འགྱུར་བའི་ཐབས་ལེགས་པ་ཅི་ཡོད་སྙམ་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "དེས་འབྱུང་པོའི་དཔུང་ཚོགས་དང་ལྡན་པ་གླང་པོ་ཆེ་དང་།",
    "རྔ་མོ་དང་།",
    "མ་ལ་བདག་གིས་གཉེན་པོའི་ཕྱོགས་ལ་སྦྱར་བར་བྱའོ་སྙམ་དུ་དགོངས་ནས་དེ་ཞི་བར་འགྱུར་བའི་ཐབས་ལ་དགོངས་པར་བརྩམས་སོ།",
    "བདག་གིས་ནམ་དུ་ཡོངས་སུ་བསྐོར་ཏེ་འདུག།",
    "དེ་ནས་དེ་རྣམས་ཀྱིས་ལོ་མ་རེ་རེ་བཟུང་ན།",
    "སྣང་བར་གྱུར་ཅིང་མི་སྣང་བར་གྱུར་པ་ཡེ་ཤེས་གཟིགས་པས་ཉམས་སུ་མྱོང་བར་མཛད་དོ།",
    "ནམ་མཁའ་ལ་ཡང་སྐྱིལ་མོ་ཀྲུང་གིས་གཤེགས་པར་མཛད་དེ།",
    "བསམ་གཏན་གྱི་ཚེར་མ་སྒྲ་ཡིན་པས་མ་ལ་བདག་གིས་རྒྱང་རིང་པོ་ཁོ་ནར་འདུག་ལ་སྒྲ་དབྱུང་བར་བྱའོ་སྙམ་ནས་དེས་འབྱུང་པོ་བྱེ་བ་ཕྲག་སུམ་བཅུ་རྩ་དྲུག་དང་།",
    "དགྲར་གྱུར་པ་དེ་དག་ཇི་ལྟར་ཤེས་པར་བྱ་སྙམ་མོ།",
    "ཚེ་ནི་འདི་སྲིད་ཅིག་ལོན་ཏེ་གནས་དེ་ནས་བདག་ཤི་འཕོས་ཏེ་ཆེ་གེ་མོ་ཞིག་ཏུ་སྐྱེས་སོ།",
    "དེ་ནས་ཀྱང་ཤི་འཕོས་ནས་ཆེ་གེ་མོ་ཞིག་ཏུ་སྐྱེས་སོ།",
    "བདུད་ཀྱི་མངག་གཞུག་འདི་རྣམས་ལས་སུ་དག་ནི་ངན་སོང་དུ་འགྲོ།",
    "སུ་དག་ནི་མི་འགྲོ་བ་དེ་དག་ཇི་ལྟར་ཤེས་པར་བྱ་སྙམ་མོ།",
    "མ་རིག་པའི་ཟག་པ་དེ་ཇི་ལྟར་སྤང་བ་དེ་ཇི་ལྟར་ཤེས་པར་བྱ་སྙམ་མོ།",
    "རྣམ་པར་གྲོལ་ནས་བདག་གི་སྐྱེ་བ་ཟད་དོ།",
    "བཙུན་མོའི་སྤྲོ་བསྲིང་བའི་སྐྱེ་བོ་དག་ནི་མིག་མཆི་མས་གང་ལ་མྱུར་བ་མྱུར་བར་དབུགས་བརྫགས་ཤིང་དལ་བུས་དལ་བུས་སྨྲེ་སྔགས་འདོན་ཅིང་འདུག་གོ།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་གིས་ཕུན་སུམ་ཚོགས་པ་དེ་མཐོང་ནས།",
    "གྱོ་མོ་རྣམས་བསལ་ནས་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ།",
    "སློང་མོ་བ་རྣམས་ལ་སྦྱིན་པ་དག་གཏོང་ངོ།",
    "བཙུན་མོའི་འཁོར་གྱི་སྐྱེ་བོས་སྨྲས་པ།",
    "ཉེ་དུ་དག་གིས་སྨྲས་པ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདུད་ཀྱི་འཁོར་འབྱུང་པོ་བྱེ་བ་ཕྲག་སུམ་བཅུ་རྩ་དྲུག་བྱམས་པའི་མཚོན་གྱིས་མངོན་དུ་བཏུལ་ནས་བླ་ན་མེད་པའི་ཡེ་ཤེས་བརྙེས་པ་དེའི་ཚེ་ས་ཆེན་པོ་འདི་ཤིན་ཏུ་གཡོས་པར་གྱུར་ཏོ།",
    "ཚངས་རིས་ཀྱི་ལྷ་གཉིས་ལས་གཅིག་གིས་ཚིགས་སུ་བཅད་དེ་གསོལ་པ།",
    "ཁྱོད་ཀྱི་ཐུགས་ནི་ཤིན་ཏུ་རྣམ་དག་ལགས།",
    "སྐྱིལ་མོ་ཀྲུང་གཅིག་གིས་ཞག་བདུན་འདས་པར་མཛད་པ་ན།",
    "སྐྱིལ་མོ་ཀྲུང་གཅིག་གིས་ཞག་བདུན་འདས་པར་མཛད་པ་ན།",
    "མ་ལ་བདག་རང་གིས་འདི་གཉིས་འདི་ལྟ་སྟེ།",
    "དེ་ནས་ལྷ་དེས་ཤིང་རྟ་དང་ཚོང་པ་ཐམས་ཅད་སྣང་བ་རྒྱ་ཆེན་པོས་གསལ་བར་བྱས་ནས་ཚོང་པ་ག་གོན་དང་།",
    "བདེ་བ་སྐུ་ཉམས་སུ་བཏར་བ་ན་སྐྱིལ་མོ་ཀྲུང་གཅིག་གིས་ཞག་བདུན་འདས་པར་མཛད་དེ།",
    "དེ་ལ་ཁྱེད་ཀྱིས་དེར་ཐོག་མར་བསོད་སྙོམས་ཕུལ་ན་དེ་ནི་ཁྱེད་ཀྱི་ཡུན་རིང་མོའི་དོན་དང་ཕན་པ་དང་བདེ་བར་འགྱུར་རོ་ཞེས་སྨྲས་ནས་ལྷ་དེ་དེ་ཉིད་དུ་མི་སྣང་བར་གྱུར་ཏོ།",
    "གང་གི་ཕྱིར་འདི་ལྟར་ལྷས་ཀྱང་འདི་ལྟ་སྟེ།",
    "བཅོམ་ལྡན་འདས་དེ་ལ་བསོད་སྙོམས་དབུལ་བའི་ཕྱིར་བརྩོན་པར་བྱེད་དོ་སྙམ་དུ་བསམས་ནས་སྦྲང་རྩི་དང་ལྡེ་གུ་མང་དུ་ཁྱེར་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ནས་ཕྱིན་པ་དང་།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཆེད་དུ་འདིར་བདག་ཅག་གིས་སྦྲང་རྩི་དང་ལྡེ་གུ་མང་དུ་འཚལ་ཏེ་མཆིས་ཀྱིས།",
    "གལ་ཏེ་བདག་གི་ཕྱག་གིས་བསོད་སྙོམས་བཞེས་ན་དཔེར་ན་མུ་སྟེགས་ཅན་བཞིན་དུ་འགྱུར་བས་དེ་ནི་བདག་གི་ཆ་མ་ཡིན་གྱིས།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་ལ་ལྷུང་བཟེད་ཀྱིས་ལྷུང་བཟེད་ཀྱི་མཁོ་བ་བྱུང་བར་བདག་ཅག་གིས་འཚལ་ནས་རི་བྲགས་ཅན་ཞིག་ལས་རྡོའི་ལྷུང་བཟེད་མི་མ་ལགས་པས་བགྱིས་ཤིང་མི་མ་ལགས་པས་ལེགས་པར་བགྱིས་པ་གསལ་བ།",
    "གལ་ཏེ་བདག་གིས་རྒྱལ་པོ་ཆེན་པོ་གཅིག་ལས་ལྷུང་བཟེད་གཅིག་བཞེས་ན་གསུམ་གྱི་སེམས་མི་དགའ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་གསུམ་ལས་ན་ནི་གཅིག་གི་སེམས་མི་དགའ་བར་འགྱུར་གྱིས།",
    "མ་ལ་བདག་གིས་རྒྱལ་པོ་ཆེན་པོ་བཞི་ལས་ལྷུང་བཟེད་བཞི་བཞེས་ལ་ལྷུང་བཟེད་གཅིག་ཏུ་བྱིན་གྱིས་བརླབ་པར་བྱའོ་སྙམ་ནས།",
    "གང་གི་དོན་དུ་སྦྱིན་པ་བཏང་།",
    "ལྷ་དང་བདུད་ཀྱི་རིགས་དག་གིས།",
    "རྣམ་པར་མཐོང་ཞིང་རེག་པར་འགྱུར།",
    "རང་གི་སྨྲ་བ་གསལ་བར་བྱེད་ནུས་པའི་དགེ་སློང་དང་།",
    "རོ་དང་ལྡན་པའི་ཨ་རུ་ར་བླངས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "དེ་ནས་བདག་གིས་ཁ་དོག་དང་།",
