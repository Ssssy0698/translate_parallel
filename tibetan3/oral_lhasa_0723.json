    "འདི་དག་ནཱ་རོ་པས་རྗེས་དྲན་དངོས་གཞི་ལ་སྦྱར་ནས་གསུངས་ཀྱང་ཏིང་ངེ་འཛིན་གྱིས་འཆད་པ་ལྟར་སྤོགས་ཆོག་ཏུ་རིགས་སོ།",
    "གཡོན་པ་དང་གཡས་པར་གནས་པའི་སྲོག་རྣམས་བསད་ནས་རྒྱལ་བའི་བདག་པོ་སྟོང་པ་ཉིད་ཀྱི་གཟུགས་ལ་འཇུག་སྟེ་ལོའི་སྦྱོར་བས་རྣལ་འབྱོར་པ་བཟང་པོ་ཨ་ཝ་དྷཱུ་ཏཱི་ལ་གནས་པའོ།",
    "འདར་དང་སྨྱོ་དང་རབ་ཏུ་རྨོངས་པར་འགྱུར་དང་ཡིད་ནི་རྣམ་པར་འཁྲུལ་དང་དྲུག་ཏུ་བརྒྱལ་བ་དག།",
    "གནས་སྐབས་སུ་རང་དང་ཕྱག་རྒྱ་འོད་ལུས་ཀྱི་གཟུགས་དང་དེའི་བ་སྤུའི་ཁུང་བུ་ནས་འོད་ཟེར་ལྔ་འཕྲོ་བས་ནམ་མཁའི་ཁམས་རྒྱས་པར་འགེངས་པའི་སྣང་བ་འབྱུང་སྟེ།",
    "རྗེས་སུ་དྲན་པ་ལེགས་པར་དག་པ་དྲི་མེད་འོད་ཀྱི་དཀྱིལ་འཁོར་དག་ཀྱང་ཡེ་ཤེས་གཟུགས་ལས་སོ།",
    "རྗེས་སུ་དྲན་པ་ལེགས་པར་དག་པ།",
    "ཞེས་པ་ལ་འདིར་རྗེས་སུ་དྲན་པ་ནི་གཟུགས་ལ་འཁྱུད་པའི་སེམས་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའོ།",
    "ཁེངས་བྱེད་དང་རྨུགས་བྱེད་མ་དྲུག་འགྲུབ་པར་བྱེད་དོ།",
    "འདིར་གཟུང་བ་དང་འཛིན་པའི་སེམས་དག་གཅིག་པ་ཉིད་ཀྱི་གང་ཞིག་འགྱུར་བ་མེད་པའི་བདེ་བར་གྱུར་པའི་བདེ་བ་དེ་ནི་ཏིང་ངེ་འཛིན་དུ་གསུངས་ཏེ།",
    "འདིར་གསང་བ་ལ་གནས་པའི་སྐུའི་ཐིག་ལེ་སྲ་བའི་རང་བཞིན་གྱི་དང་གཞན་པའི་ཁུ་བ་གང་ཡིན་པ་དེ་ནི་གཡོ་བའི་ཁུ་བར་གསུངས་ཏེ།",
    "དེ་ནི་རྡོ་རྗེ་ནོར་བུ་ལ་གནས་རྒྱལ་མཚན་རྩེ་ལ་ཏེ་རྟགས་ཀྱི་སྒོ་ལ་ཡང་དག་པར་འགོག་པའོ།",
    "ཤེས་རབ་ཐབས་ཀྱི་བདག་ཉིད་ཀྱིས་ནི་ཞེས་པའང་ཤེས་བྱ་དང་ཤེས་བྱ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པས་ཏེ།",
    "འཆད་པར་འགྱུར་བ་འདི་དག་གོམས་པས་གསེར་བཟང་པད་མ་ལ་ནི་ཞེས་པ་ལྟེ་བའི་པད་མ་ལ་སྐུ་གསུང་ཐུགས་ཀྱི་རྣལ་འབྱོར་ཏེ།",
    "ཤིན་ཏུ་དགའ་བའི་དགའ་བ་ལ་གནས་འཇིག་ན་ལམ་ལས་རབ་གྲོལ་ཞེས་སྔར་གྱི་ལུང་དུ་གསུངས་པས་སོ།",
    "དེ་བཞིན་དུ་ཞེས་པས་སྐྱིལ་ཀྲུང་ལ་གནས་པར་བསྟན་ཞིང་།",
    "གཞན་ཡང་འདུས་པར།",
    "ལུས་མེད་བལྟ་བས་ཞེ་སྡང་མཐའ་ཉིད་དུ་ནི་བྱེད་པར་འགྱུར་ཏེ་ཁུ་བ་དྲི་མེད་བདེ་བ་ལས།",
    "སྲོག་ནི་ཐིག་ལེར་བཞུགས་པར་བྱ།",
    "གཡོ་བ་རྡོ་རྗེ་དགག་པར་བྱ།",
    "དེ་ནི་རྡོ་རྗེ་ནོར་བུ་ལ་གནས་རྒྱལ་མཚན་རྩེ་ལ་ཏེ་རྟགས་ཀྱི་སྒོ་ལ་ཡང་དག་པར་འགོག་པའོ།",
    "དེ་ཉིད་ལུས་རྩོལ་དང་རྟོག་སྒོམ་ལ་ལྟོས་མི་དགོས་པར།",
    "སྦྱིན་སྲེག་སྔགས་ཀྱི་རབ་གནས་རྡུལ་ཚོན་ལ་ནི་རྒྱལ་བའི་རིགས་རྣམས་སྤྱན་དྲངས་བསྐུལ་བ་མེད་པར་ཡང་།",
    "དེ་ལྟ་བུ་ལ་སོགས་པ་རྣམས་ཀྱིས་བསླང་བ་བདེ་བ་ཆེན་པོ་དྲི་མ་དང་བྲལ་བར་གྱུར་བས་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ལ་སོགས་པ་ཐམས་ཅད་སྒྲིབ་པ་མེད་པར་བྱེད་དོ།",
    "དེ་ལས་རྣལ་འབྱོར་པ་རྣམས་ཀྱང་ཐམས་ཅད་མཁྱེན་པའི་གནས་སུ་འགྱུར་ཏེ་བརྟགས་པའི་དཀྱིལ་འཁོར་ལ་རྣལ་འབྱོར་མའི་གླུ་ཡིས་བསླང་བས་ནི་མ་ཡིན་ནོ།",
    "ནམ་མཁའི་ལྟ་བས་གཏི་མུག་མཐའ་ཉིད་དུ་ནི་བྱེད་པར་འགྱུར་ཏེ་སྟོང་པ་ཉིད་ནི་མཐོང་བས་སོ།",
    "ལུས་མེད་ལྟ་བས་ཞེ་སྡང་མཐའ་ཉིད་དུ་ནི་བྱེད་པར་འགྱུར་ཏེ།",
    "གཞོམ་དུ་མེད་པའི་བདེ་བ་ཆེན་པོའི་སྒྲའི་ཡང་དག་པར་རོལ་པ་ལས་སོ།",
    "འབྲས་བུ་བཞི་འགྲུབ་པར་ཡང་།",
    "སྟེང་དུ་ཁ་བ་རྣམས་ཀྱི་རྨི་ལམ་གྱི་གནས་སྐབས་ཟད་པ་ལས་མགྲིན་པར་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་སྐྱེས་བུ་བྱེད་པའོ།",
    "མེད་པར་བདེ་བ་སྨྲ་མི་ནུས།",
    "དེ་བཞིན་དུ་ཡིད་སྐྱོབ་པར་གྱུར་པ་ཉིད་ཀྱི་ཕྱིར་སྔགས་ཀྱང་མཆོག་ཏུ་མི་འགྱུར་བའི་ཡེ་ཤེས་སུ་བརྗོད་དོ།",
    "དེ་ལྟར་གཟུགས་ཀྱི་མཐར་ཐུག་པར་བསྒོམས་ཏེ་རྩ་ནི་ཟླ་བ་ཉི་མ་འགོག་པ་ལས་ཤེས་པ་གཡོན་དང་གཡས་ཀྱི་སྲོག་འགོག་པ་ལས་བདེ་མཉམ་སྟེར་ཏེ་ཞེས་པ་མཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བ་སྟེར་རོ།",
    "འབིགས་པར་བྱེད་པ་ཞེས་པ་འཇོམས་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་སྟོང་པ་གཅིག་པུ་དྲི་མ་དང་བྲལ་བ་ནི་ས་ལ་སོགས་པའི་ལུས་ཀྱི་ཁམས་རྣམས་ཀུན་ནས་འབིགས་པར་བྱེད་དོ།",
    "སྟོང་པ་ཉིད་ཀྱི་གཟུགས་བརྙན་དེ་ནི་ཐོག་མ་མེད་ཅིང་མཐའ་མེད་དབུས་ཀྱང་མེད་ལ་ཡུལ་མེད་ཡུལ་ཞེས་པ་ནི་ཡུལ་རྣམས་མེད་པར་ཡུལ་དུ་སྣང་བ་སྒྱུ་མ་དང་རྨི་ལམ་དང་པྲ་ཕབ་པ་ལྟ་བུ་བསྒྲུབས་པ་ནི་དུས་ཀྱི་འཁོར་ལོ་སྟེ།",
    "ཞེས་པ་དང་འདུས་པར།",
    "བྱས་ཏེ་གོང་བུའི་སྦྱོར་བ་ཡིས།",
    "ཞེས་ཏེ་དེའི་དོན་ནཱ་རོ་པས་ཡན་ལག་དྲུག་པ་གསུངས་པ་ཤེས་རབ་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "དེའི་ཕྱིར་ཁྲོ་བོའི་རྒྱལ་པོ་ཕེབས་པ་ངོ་ཚ་མེད་ཅིང་དོགས་པ་མེད་པར་འགྱུར་ཏེ།",
    "འདིར་ཡང་རྒྱ་ཆེར་གཞན་ཁྲོ་བོ་བཅུ་པོ་རྣམས་ཀྱི་རང་བཞིན་བཅུ་པོ་རྣམས་ནི་ཕྱག་རྒྱ་བཅིང་བས་རིག་པར་བྱའོ།",
    "དེ་ནི་དེ་ཡིས་ཤེས་པར་བྱའོ་ཞེས་པ་ངེས་པའོ།",
    "གསུང་ཕེབས་པས་ནི་ལྷ་དང་འབྱུང་པོ་ལྷ་མིན་རྣམས་ལས་རྣམ་པར་རྒྱལ་བའི་སྨྲ་བ་པོ་རུ་འགྱུར།",
    "དཀྱིལ་འཁོར་ལ་སོགས་པ་མ་མཐོང་བར་བསྐྱེད་པར་བྱེད་དེ།",
