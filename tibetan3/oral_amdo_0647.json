    "རྗེ་དཔོན་རང་གི་དོན་ལས་ཀྱི་བྱ་བ་ལེགས་པོ་མི་འགྲུབ་ཏེ་འགྲུབ་པར་མི་འགྱུར་བའི་དཔེ་དེ་ལྟ་བུ་ཡིན་པར་གསུངས།",
    "ཚ་གྲང་བཀྲེས་སྐོམ་ལ་སོགས་པའི་སྡུག་བསྔལ་གང་ཇི་སྙེད་ཅིག་ཡོད་པར་གྱུར་པ་དེ་དག་ཀུན་ཀྱང་བདག་མེད་པ་ལ་བདག་ཏུ་འཛིན་པའམ་བདག་གིར་འཛིན་པ་དེ་ལ་བརྟེན་ནས་བྱུང་པ་ཡིན་ན།",
    "ལུས་དང་སེམས་ལ་བདག་དང་བདག་གིར་འཛིན་པའི་བློ་དེ་ཉིད་རིམ་པ་བཞིན་དུ་ཡོངས་སུ་གཏོང་དགོས་པ་ལས།",
    "དེ་མ་བཏང་ནས་སྤོང་མ་ནུས་ན་རང་གི་ལུས་སེམས་ལ་ཡོད་པའི་སྡུག་བསྔལ་དེ་དག་ཐམས་ཅད་གཏན་ནས་སྤོང་བར་མི་ནུས་ཏེ།",
    "ཡིད་ཁྱོད་ངེས་པར་ཤེས་གྱིས་ལ།",
    "ད་ནི་ཁྱོད་ཀྱིས་གཞན་མི་བསམ།",
    "བདག་འཛིན་ཅན་གྱི་སེམས་ཁྱོད་ཀྱིས་གཞན་རང་གི་དོན་བསམ་པ་ནི་བྱ་མི་རུང་བ་དེས་ན་གཞན་གང་ཡང་མི་བསམ་མོ་གསུངས།",
    "བདག་གི་ལུས་ལ་ཅི་མཐོང་བ།",
    "བདག་གི་ད་ལྟའི་ལུས་འདི་ཉིད་ལ་ཟས་གོས་སོགས་ཡིད་འོང་གི་དངོས་པོ་ཅི་དང་ཅི་ཞིག་མཐོང་བར་གྱུར་པ་དེ་དང་དེ་ཐམས་ཅད་ནི་བློའི་སྒོ་ནས་ཕྲོགས་ནས་ཀྱང་།",
    "དེ་ཡང་བརྗེ་བའི་སྔོན་མར་རང་གིས་ཕར་ང་རྒྱལ་དང་འགྲན་སེམས་དང་ཕྲག་དོག་བྱ་བའི་ཡུལ་དེ་རྣམས་དང་གཙོ་བོར་བརྗེ་བར་བྱ་བ་ཡིན་ཞིང་།",
    "དེ་ཡང་རང་གིས་སྔོན་མ་གཞན་ལ་ཕྲག་དོག་དང་འགྲན་སེམས།",
    "འདི་བཞིན་བདག་གིས་མ་རྙེད་ཅིང་།",
    "སྔོན་མ་རང་གིས་མར་ཁྱད་གསོད་བཏང་བའམ་བརྙས་བཅོས་བྱ་བའི་ཡུལ་ཁོ་རང་གིས་ང་ལ་བསམ་པ་མ་དགའ་བའི་སྒོ་ནས་ཕྲག་དོག་བྱེད་མཁན་དེ་འདྲ་གཅིག་ཏུ་རང་ཉིད་བརྗེས་ནས།",
    "བདག་གསར་པ་རང་གིས་ནི་དེ་ལྟ་བུ་མ་ཡིན་པ་ཀུན་གྱིས་བརྙས་བཅོས་སོགས་བྱེད་པ་ཡིན་ནོ་སྙམ་པ་དང་།",
    "བདག་རང་གིས་ནི་དེ་བཞིན་དུ་ཟས་གོས་ནོར་ལ་སོགས་པ་མ་རྙེད་ཅིང་།",
    "མཁས་པ་དང་བཙུན་པ་ལ་སོགས་པའི་ཡོན་ཏན་མེད་པས་བདག་རྙིང་པ་ཁྱོད་ཀྱིས་ང་རྒྱལ་ཅི་ཞིག་བྱ་སྟེ་བྱ་མི་འོས་ཏེ།",
    "གནོད་པའང་བདག་གིས་དང་དུ་བླང་།",
    "གང་གིས་རང་ཉིད་ལྷག་བྱའི་ཕྱིར།",
    "བདག་གི་རྙེད་དང་བཀུར་སྟི་ནི།",
    "རིགས་སམ་ལོངས་སྤྱོད་ཅི་རིགས་པའི་སྒོ་ནས་ཕལ་ཆེར་མཉམ་པ་ཡིན་པ་ལ་སྔར་ཕན་ཆད་རང་གིས་ཕར་ལ་ཡང་མི་དགའ་བའི་སྒོ་ནས་ཅུང་ཟད་འགྲན་བསྡོ་བ།",
    "ཚུར་ཡང་ཁོ་རང་གིས་བསམ་པ་ཅུང་ཟད་མ་དགའ་བའི་སྒོ་ནས་རང་ལ་འགྲན་འཚོལ་མཁན་དེ་ལྟ་བུ་གཅིག་དང་བརྗེས་ནས་དེ་ལ་ལྟོས་ནས་ནི།",
    "ཡང་མཁས་བཙུན་བཟང་གསུམ་ཡོན་ཏན་སོགས་སམ་རྙེད་པ་དང་བཀུར་སྟི་ལྟ་བུ་གང་གི་སྒོ་ནས་བདག་གསར་པ་རང་ཉིད་ལྷག་པར་བྱ་བའི་ཕྱིར་དུའམ་རྒྱལ་ཁ་ཐོབ་པར་བྱ་བའི་ཕྱིར་དུ་བདག་གསར་པ་རང་གི་རྙེད་པ་དང་བཀུར་སྟི་དེ་དག་ཐམས་ཅད་ནི་ཐ་ན་འཐབ་མོའམ་རྩོད་པ་ཡིས་ཀྱང་ངེས་པར་དུ་རང་ཉིད་ལྷག་པར་འགྱུར་བ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་སྙམ་དུ་བསམ།",
    "ཅི་ནས་བདག་གི་ཡོན་ཏན་ནི།",
    "བདག་གི་སྐྱོན་ཡང་སྦ་བྱ་ཞིང་།",
    "བདག་གསར་པ་རང་གི་ཅུང་ཟད་བྱ་སྤྱོད་ངན་པའི་སྐྱོན་ཡོད་པ་ཐམས་ཅད་ནི་སུས་ཀྱང་མི་ཐོས་པ།",
    "ཉོན་མོངས་འདི་ཡང་བདག་དང་ནི།",
    "ཉོན་མོངས་པ་དམན་པ་བདག་རྙིང་པ་འདི་ཡང་བདག་གསར་པ་རང་ཉིད་དང་ནི་ལྷན་ཅིག་ཏུ་འགྲན་པ་ཡིན་ཞེས་འཇིག་རྟེན་ན་དེ་འདྲ་གྲགས་ཀྱང་།",
    "བདག་གི་ཡོན་ཏན་ཐོས་ནས་ནི།",
    "བདག་རྙིང་པ་ཁོ་དང་བདག་གསར་པ་གཉིས་པོ་རིགས་རུས་ཤེས་རབ་ལོངས་སྤྱོད་གང་གི་སྒོ་ནས་མི་མཉམ་པ་ཡིན་པ་དེ་ལྟར་དུ་འཇིག་རྟེན་པ་ཀུན་ལ་གྲགས་པ་ཡི་ཁྱབ་པའི་སྒོ་ནས་བདག་གསར་པ་རང་གི་ཡོན་ཏན་དེ་ཉིད་འཇིག་རྟེན་པ་གཞན་གྱིས་ཐོས་ནས་ནི་ལུས་ལས་བ་སྤུ་ལྡང་ཞིང་སེམས་ལ་དགའ་བའམ་སྤྲོ་བ་སྐྱེ་བར་འགྱུར་བའི་ལུས་དང་སེམས་བདེ་སྐྱིད་ཀྱི་གནས་སྐབས་དེ་ལ་བདག་ཡོངས་སུ་ལོངས་སྤྱོད་པ་ཡིན་ནོ་སྙམ་དུ་བསམ།",
    "བདག་གི་སྟོབས་ཀྱིས་དེ་བླང་བྱ།",
    "ཞེས་པ་ནི་ཅི་སྟེ་བདག་རྙིང་པ་འདི་ཉིད་ལ་ལོངས་སྤྱོད་ཀྱི་རྙེད་པ་ཐོབ་པ་སྐབས་འགའ་རེ་ལ་ཡོད་ཀྱང་།",
    "ལྷག་པོ་འདྲ་གང་ཡོད་པ་དེ་དག་ནི་བདག་གསར་པ་རང་གི་སྟོབས་ཀྱི་སྒོ་ནས་ཡར་བསྡུས་ཏེ་བླང་བར་བྱའོ་སྙམ་དུ་བསམ།",
    "བདག་གིས་གནོད་དང་རྟག་སྦྱར་བྱ།",
    "བདག་རྙིང་པ་འདི་ནི་ལུས་དང་སེམས་ལ་བདེ་བ་ཐོབ་ན་དེ་ལས་རྣམ་པ་ཀུན་ཏུ་བདག་གསར་པ་རང་གི་སྟོབས་ཀྱིས་སྒོ་ནས་ཉམས་པར་བྱ་ཞིང་།",
    "དེ་ཡང་བདག་གསར་པ་རང་གིས་བདག་རྙིང་པ་འདིའི་ལུས་དང་སེམས་ལ་སྡུག་བསྔལ་བའི་གནོད་པ་དང་རྟག་ཏུ་སྦྱར་བར་བྱའོ་སྙམ་དུ་ཡང་ཡང་སེམས།",
    "རྩུབ་མོའི་སྒོ་ནས་ཚར་གཅོད་པའོ།",
    "ཡིད་ཁྱོད་རང་དོན་བྱེད་འདོད་པས།",
    "ཁྱོད་ཀྱིས་སྡུག་བསྔལ་འབའ་ཞིག་བསྒྲུབས།",
    "ཡིད་དམ་སེམས་མ་རུངས་པ་ཁྱོད་རང་གི་དོན་ཁོ་ན་བྱེད་པར་འདོད་པས་དུས་ནི་བསྐལ་པ་གྲངས་མེད་པ་དུ་མ་འདས་པར་གྱུར་ཀྱང་།",
