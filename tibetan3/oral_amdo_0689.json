    "བྲལ་བམ་ཡིན་པའི་སྐྱེས་པ་དང་བུད་མེད་དག་ལསྲིད་པའི་ཕྱིར་དགེ་སློང་དང་།",
    "དེ་བཞིན་དུ་སྐྱེ་དགུའིབདག་མོ་ལ་སོགས་པ་དགེ་སློང་མ་རྣམས་དང་།",
    "དད་པའི་བྱེ་བྲགརྣམ་པ་གསུམ་མོ།",
    "སྒྲིབ་པ་དང་ཉོན་མོངས་པའི་དྲི་མ་རྣམས་སོ།",
    "དེ་དག་ཉིད་ལུསདང་ངག་དང་ཡིད་ཉོན་མོངས་པར་བྱེད་པས་ན་ཉོན་མོངས་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་སྤྱིའི་སྒྲར་གསུངས་མོད་ཀྱི།",
    "དེ་ལྟ་བས་ནལམ་ཤེས་པ་ལ་ནི་ལམ་ཐམས་ཅད་ཤེས་པར་བྱ་དགོས་པས་ཉན་ཐོསལསོགས་པའི་ལམ་སྟོན་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་གང་ཞིག་རིག་པ་ན་གང་རིག་པའིཐབས་མེད་པ་དེ་ནི་རིགཔ་མ་ཡིན་ཏེ།",
    "ཤིན་ཏུ་ཐལ་ཆེས་པའི་ཕྱིར་གཞན་གྱི་རྣམཔས་ཀྱང་མ་ཡིན་ནོ།",
    "གཅིག་ལ་དཔག་ཚདཕྱེད་དང་བཞི་བཅས་པ་ནི་ཆུ་ཞེང་གི་ཚད་དེ།",
    "སྨྲས་པ་གང་གི་ཕྱིར་ཕྱིའི་དངོས་པོ་ཡོངས་སུ་མ་གྲུབ་པས་ཀུནརྫོབ་ཀྱི་སོ་སོར་སྣང་བ་ལ་གླིང་རྣམ་པར་བཞག་སྟེ།",
    "ཆུ་ཀླུང་གི་བྱ་བ་ཇི་ལྟ་བུ་ཅན་ཡིན་པ་ནི་མེ་ཏོགའབྲས་ལྡན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངསཏེ་མེ་ཏོག་དང་འབྲས་བུ་དང་ལྡན་པ་དག་ནི་ཨཨ་མྲ་ལ་སོགས་པའིཤིང་ངོ།",
    "གང་གི་མཐུས་འབབ་ཅེ་ན།",
    "ལུང་གི་ཚདམ་དང་ལྡན་པ་ཉིད་ནི་རིག་པ་དག་དང་ལྡན་པ་སྟེ་ཐོས་པདང་།",
    "ཉན་ཐོས་ཀྱི་རང་དབངགིས་ཀྱང་དོན་སྟེ་སྟོན་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལྟ་བས་ནརང་གི་ནུས་པ་ཉིད་ཀྱིས་རང་གིས།",
    "ཅིའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ནང་གིརྒྱུས་ནུས་པ་ཡིན་པར་རྟོགས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེབས་ན་དེ་བཞིན་གཤེགས་པ་ཉིད་ཀྱི་མཐུ་ཡིན་གྱི་རང་གི་མཐུས་མཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་རྟོགས་པའི་རྗེསའབྲངས་ནས།",
    "ཀྱངགི་སྒྲ་ནི་རིམ་པ་གཞན་དུ་སྦྱར་ཏེ།",
    "ཆེན་པོའི་བྱེ་བྲག་གིསཁྱད་པར་དུ་འཕགས་པ་བྲྗོད་པར་བྱའོ།",
    "དེ་ཁོ་ན་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ཚིག་གིལྷག་མའོ།",
    "འང་གི་སྒྲ་ནི་ངེས་པར་བཟུང་བའི་དོན་ཏོ།",
    "མི་རེག་པ་ནི་མི་དམིགསཔའོ།",
    "གཟུགས་ཞེས་བྱ་བ་འདི་དག་གི་ནང་ན་གངཡིན།",
    "དེ་ལྟ་ཡིན་ན་ཕྱིའི་དོན་འདོད་པའིགཞུང་གིས་ཀྱང་ཉན་ཐོས་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་སྤོངབར་འགྱུར་རོ།",
    "འོན་ཏེ་ཁས་མི་ལེན་ན་དེའི་ཕྱིར་རྣམ་པར་རྟོགཔའི་བག་ཆགས་མི་སྤོང་བས་ཕྱོགས་གཅིག་དག་པར་ཐལ་བར་འགྱུརརོ།",
    "ཁྱོད་ཀྱི་ལུགས་ཇི་ལྟ་བུཡིན་ཞེ་ན།",
    "སྐྱོན་མེད་དེ་གང་གི་ཕྱིར་དངོས་པོའི་ངོ་བོ་གངཅུང་ཟད་ཇི་སྙེད་པ་ཀུན་བརྟགས་པ་ཡིན་ཏེ།",
    "དམིགས་པ་འདི་ལ་བྲྗོད་པར་བྱ་བ་མང་དུ་ཡོད་མོད་ཀྱི།",
    "ཧ་ཅངཐལ་ཆེས་པས་གཞག་གོ།",
    "འཇུག་པའིསྒྲུབ་པ་ནི་མོས་པས་སྤྱོད་པའི་ས་ཡིན་པར་རྟོགས་པར་བྱའོ།",
    "ཆོགས་ཀྱི་བསྒྲུབ་པ་ནི་རྩེ་མོ་དང་སྦྱིན་པ་ལ་སོགས་པ་དྲུགདང་།",
    "གཉེན་པོའི་བདག་ཉིད་ཅནཡང་ཚོགས་ཀྱི་བསྒྲུབ་པ་ནི་ལམ་གཉིས་ཀའི་སྤྱོད་ཡུལ་ཅན་ཡིནནོ།",
    "གང་གི་ཚེ་བྱངཆུབ་སེམས་དཔའ་དེས་འགྲོ་བ་ཀུན་ལས་དང་ཉོན་མོངས་པས་སྤྲུལཔ་ཡིན་པར་ཐོས་པ་ལ་སོགས་པའི་ཤེས་པ་སྐྱེས་པ་རབ་ཏུ་ཤེསཔ་དེ་བས་ན།",
    "གང་གིཕྱིར་གཟུགས་ལ་སོགས་པ་ཡང་དག་པ་མ་ཡིན་ཏེ་མེད་པ་མ་ཡིན་ནོ།",
    "རྒྱུ་གང་གིས་ཤེ་ན།",
    "གཞན་གྱིས་ཇི་སྐད་བསྟནཔའི་རིམ་པ་ལས་བཟློག་པ་མ་རིག་པའི་ནུས་པས་བཅིངས་པ་ཡིནཔའི་ཕྱིར་དེ་བས་ན་དེ་དག་གི་རྗེས་ལ་གོ་ཆ་བསྟན་ཏོ།",
    "བདེན་པ་གཉིསལ་བརྟེན་པའི་ཐུན་མོང་མ་ཡིན་པའི་ལམ་ཡིན་ནོ།",
    "མྱ་ངན་ལས་འདསཔར་འགྲོ་ཞེས་བྱ་བ་འདིར་ཡང་ཕྱིན་ཅི་ལོག་གི་ངོ་བོ་བཟློག་པཉིད་ལ་མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་བའི་རིགས་པས་འགྲོ་བ་ནིམི་དམིགས་པའོ།",
    "འཇིག་རྟེན་པས་ཀྱང་རང་གི་ངོ་བོ་དགག་པཙམ་ཉིད་ལ་མྱ་ངན་ལས་འདས་ཞེས་བྱ་བརགྲགས་པར་བསྟན་པའི་ཕྱིར།",
    "རྒྱུ་དེས་ན་རང་གི་ངོ་བོ་ལོག་པཙམ་ལ་འཇིག་རྟེན་པས་ཀྱང་མེ་ཤི་ཞེས་རྗོད་པར་བྱེད་དོ།",
    "དེ་ལྟར་གྲུབ་པ་ལ་རྣམ་པར་བཀགནས་ཞེས་བྱ་བའི་སྒྲ་ནི་རབ་ཏུ་གྲགས་པའི་མིང་གི་རྣམགྲངས་སོ།",
    "དེ་དག་གིས་ནི་རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་བསྟན་ཏེ།",
    "སྟོང་ཕྲག་བརྒྱ་པའི་དོན་ཐམས་ཅད་བསྡུས་པའི་ཕྱིར་དེ་དངམཐུན་པར་ལེའུ་སྦྱར་བར་རིགས་མོད་ཀྱིས་བློ་དམན་པ་རྣམས་ཀྱིསམི་རྟོགས་པའི་ཕྱིར་མ་བྱསཏེ་དེ་བཞིན་དུ་སྟོང་ཕྲག་ཉི་ཤུ་ལྔ་པོ་དང་ཡང་མཐུནཔར་མ་བྱས་སོ།",
    "དོན་གཅིག་པར་ཤེས་པར་བྱ་བའི་ཕྱིར་བརྒྱདསྟོང་པ་དང་མཐུན་པར་ལེའུ་ཐ་མའི་དབྱེ་བ་འདིར་ལེའུ་རྫོགསཔར་བདག་གིས་བྱས་སོ།",
    "འདི་ལྟར་འོད་ཀྱིས་མོག་མོགཔོར་མཛད་པས་རྒྱུད་ལ་ཡོད་པའི་ང་རྒྱལ་བཅོམ་པ་ནི་རྟེན་ཡིནནོ།",
    "གང་གི་ཕྱིར་གནས་མེད་གནས་ཡིན་འདི་ནི་རྒྱལབ་དེ་བཞིནགཤེགས་པས་གསུངས་སོ།",
    "ཉན་ཐོས་ཀྱི་ལམ་གྱི་རྗེས་ལ་རང་སངསརྒྱས་རྣམས་ཀྱི་ལམ་བྲྗོད་པར་རིགས་མོད་ཀྱི།",
    "སྒྲ་བྲྗོད་པ་མེདཔར་གཞན་གྱི་དོན་བྱེད་པ་དག་གིས་ཡེ་ཤེས་ཟབ་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་མི་ལྡོག་པའི་ཕྱིར་བདེ་གཤེགསནི་ཉན་ཐོས་སོ།",
    "པར་རྟོག་པའི་ཤེས་པས་རང་གི་རྒྱུད་ལ་བག་ཆགས་གཞགཔ་སད་པ་ལས་སྐྱེ་བའི་ཕྱིར་བཟུང་བའི་རྣམ་པར་རྟོག་པ་ལསངེས་འབྱུང་ཞེས་བྱ་བའི་ངེས་པ་མེད་དོ།",
    "སྤྲུལ་པའི་སྐུགཉིས་པོ་དག་གིས་འཇིག་རྟེན་མགོན་གྱི་དབྱེ་བ་རྣམ་པ་གཉིས་སོ།",
    "གང་གི་བརྡ་ཅུང་ཟད་གྲུབ་པས་དོན་མ་གྲུབ་པ་སྒྲུབཔར་བྱེད་པའི་དཔེ་སྒྱུ་མ་ལྟ་བུབསྟན་པས་དེའི་ཚེ་ཡང་ཉེས་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "དེ་ལ་ཤེས་རབ་འབྲིང་གི་ལྟ་བ་དང་ལྡན་པ་ཀུནརྫོབ་དང་དོན་དམ་པའིདབྱེ་བ་ཡོངས་སུ་ཤེས་པའི་མཁས་པ་ནི་རྒྱལ་སྲས་སོ།",
    "དེ་དག་གི་རྟེན་བསྟན་ཏོ།",
    "ཉོན་མོངས་པ་སྤོང་བཡང་དེ་བཞིན་ནོ།",
    "རིམ་གྱིས་བྱ་བ་ནི་ཚིག་གི་ལྷགམའོ།",
    "འོན་ཀྱང་ནམ་མཁའི་ཁམས་དང་མཚུངས་པར་དེདག་གིས་སྟོང་སྟེ།",
    "དེ་དག་གི་རངབཞིན་གང་ལ་ཡོད་པ་དེ་ནི་གང་གི་ཕྱིར་རིགས་པས་ཕ་མཐའ་མེདཔའོ།",
    "རང་བཞིན་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིནཔ་ནི་འདིར་མཐོང་བའི་ལམ་ལ་གནས་པར་འགྱུར་གྱི་གཞན་ཕྱིན་ཅིལོག་གི་རང་བཞིན་ལ་མི་རྟེན་ཏོ།",
    "དེ་བས་ན་དངོས་པོཡོད་པ་ཞེས་བྱ་བ་ཕྱིན་ཅི་ལོག་གི་རང་བཞིན་ཡིན་པའི་ཕྱིརསྔར་ཇི་སྐད་བསྟན་པ་དེ་ལྟར་ཤེས་རབ་ཕ་རོལ་ཕྱིན་མཆོག་ནིམཐོང་བའི་ལམ་གྱི་བདག་ཉིད་དོ།",
    "གཏི་མུག་གིས་གྲང་བ་དང་དྲོ་བ་མེདཔར་བྱེད་པས་ཆུའོ།",
    "གངགི་སྐབས་བཟུང་བས་ཀྱང་གནོད་པར་མི་འགྱུར་རོ།",
    "ཟག་པ་མེད་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་སོ།",
    "དེ་ལཟག་པ་དང་བཅས་པ་ཡང་མོས་པ་དང་།",
    "དེ་ཡང་རང་གི་དོན་དང་།",
    "གཞན་གྱི་དོན་དང་གསུམ་ལས་ངའོསྙམ་པའི་ང་རྒྱལ་གྱི་བག་ཆགས་མ་སྤངས་པའི་ཕྱིར་རང་གིདོན་དུ་མོས་པ་ཡིན་ནོ།",
    "སེམསཅན་གང་ཡང་རུང་བ་ཞིག་གིས་མུ་སལ་གརྦྷ་དང་།",
    "ཡང་འགྲོ་བགཞན་གང་ཞིག་གིས་རང་གི་དོན་ཕུན་སུམ་ཚོགས་སའི་ཆེད་དུ།",
    "མོས་པ་བསྐྱེད་དེ།",
    "གཞུང་གི་བདག་ཉིད་བདེ་བར་གཤེགས་པའི་ཡུམ་འདི་གླིགས་བམ་ལབྲིས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཤེས་རབ་ཀྱིཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་དེབཞིན་དུ་རང་གི་དོན་འདོད་པས་མོས་པ་བསྐྱེད་པར་བྱའོ་ཞེས་བསྟནཔར་འགྱུར་རོ།",
    "དེའི་རྗེས་ལ་བདག་དང་གཞན་མཉམ་པའི་ཕྱིརབདག་དང་གཞན་གྱི་དོན་དུ་མོས་པ་ཡིན་ཏེ།",
    "དེབསན་དེ་དག་གི་དོན་བྱེད་པར་བསྟན་པར་འགྱུར་རོ།",
    "ཡང་ཇི་ལྟར་གཅིགགིས་དུ་མའི་ངོ་བོ་བྱེད་ཅེ་ན།",
    "དཔེདེ་བཞིན་དུ་ལྷན་ཅིག་བྱེད་པའི་བྱེ་བྲག་གི་དབྱེ་བས་དེ་བཞིན་དུགཅིག་གིས་ཀྱང་རྒྱལ་བ་དེ་བཞིན་གཤེགས་པ་དུ་མའི་དོན་བྱེད་པརདགོངས་སོ།",
    "དེ་དག་གི་ཡང་རྗེསསུ་འབྲང་བ་མ་ཡིན་ནམ་གང་གི་ཕྱིར་དེ་སྐད་སྨྲ་ཞེ་ན།",
    "དེའི་དབངགིས་བྱུང་བ་མ་ཡིན་པའི་ཕྱིར་ཡོན་ཏན་ཀུན་ཏེ།",
    "ཡུལ་ནིགང་ཅུང་ཟད་ཅིག་གི་རྗེས་སུ་མི་འགྲོ་སྟེ།",
    "དེ་ནས་དེའི་རྗེས་ལ་བདག་གིརང་བཞིན་དུ་འགྲོ་བ་རྣམས་བྱས་པའི་ཕྱིར་གཞན་གྱི་དོན་དུ་མོསཔ་ཡིན་ཏེ།",
    "ཀོ་ཤི་ཀ་ཁྱོད་ཆགང་ལེན་ཞེས་རྒྱལ་བས་དྲི་བ་རྨས་པ་དང་།",
    "དེ་བཞིན་གཤེགསཔའི་སྐུ་གདུང་ལེན་པ་ལ་མ་གུས་པ་གང་གི་རྒྱུ་ཡིན་ཞེ་ན།",
    "ཀྱང་གིསྒྲ་ནི་གབ་ཙེ་ལ་ཡང་ངོ།",
    "དུའོ་དེ་དག་གིས་གཞན་གྱི་དོན་ལ་མོས་པ་བསྟན་ནས།",
    "ཅིསྟེ་སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གཞན་ལ་ཡང་མོསཔ་ཡོད་པ་མ་ཡིན་ནམ་ཅིའི་ཕྱིར་རྒྱལ་བ་སྐྱེད་མ་ཉིད་ཁོ་ནགཙོར་བྱས་ནས་མོས་པ་རྣམ་པ་གསུམ་དུ་བསྟན་ཅེ་ན།",
    "གང་གི་ཕྱིར་བྱེདཔ་པོ་དང་།",
    "ལས་དང་བྱ་བའི་བྱེ་བྲག་གི་དམིགས་པར་སྦྱིན་པ་ལསོགས་པའི་རང་བཞིན་ལ་དང་པོར་འཇུག་པས་སྔོན་དུ་འགྲོ་བ་ཤེསརབ་སྟེ།",
    "དེ་བས་ན་དེ་ལ་མོས་པ་རྣམ་པགསུམ་བསྟན་ཏོ།",
    "དེའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལམོས་པནི་ཁྱད་པར་མེད་པ་ཐམས་ཅད་ལ་ཡིན་ཏེ།",
    "གང་གི་ཚེ་གྲིབ་མཞེས་གྲངས་སུ་བྲྗོད་པ་འབའ་ཞིག་ཏུ་འགྲོ་ཞིང་རབ་ཏུ་འཐོབསྟེ།",
    "ཁྱད་པར་མེད་པར་གྲིབ་མ་མ་ཡིན་པ་གཞན་ལས་ལྡོགཔས་གྲིབ་མ་ཙམ་མོ།",
    "ཡང་དག་པར་མོས་པས་བཅོས་མ་སྤངས་ཞེས་བྱབའི་བར་དུའོ།",
    "གང་གིས་ཤེས་རབཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ལྟ་སྟེ་གཞུང་གི་བདག་ཉིད་ལ་མོསཔར་བྱེད་པ་གང་ཡངརུང་བ་ལ་ཡི་གེར་བྲིས་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདིར་མཉན་པས་ཉནཐོས་ཀྱི་རང་གི་རྣམ་པར་གྲོལ་བ་དང་།",
    "མེ་ཁྱེར་ལ་སོགས་པའི་སྲོག་ཆགས་སུ་གྱུར་པཀུན་གྱིས་འགྲོ་བ་སྣང་བར་བྱ་བའི་ཕྱིར་འོད་རྣམས་ཕྱུང་བབས་ཡང་གང་གི་ཚེ་ཉི་མའིདཀྱིལ་འཁོར་འོད་དང་ལྡན་པར་གྱུར་པ་གཅིག་གི་འོད་ཟེར་ཕྱུང་བདེའི་ཚེ་སྔར་བསྟན་པའི་སྐར་མ་ལ་སོགས་པའི་ཚོགས་ཀྱི་འོདཀྱིས་ཆ་ཙམ་དུ་ཡང་མི་ཕོད་དོ།",
    "ཡང་གང་གིཚེ་བདག་ཉིད་ཀྱི་སེར་སྣ་ལ་སོགས་པའི་སེམས་ཚར་བཅད་ནས་གཞནགྱིས་སྦྱིན་པ་ལ་སོགས་པ་བྱས་པ་ལ་རྗེས་སུ་ཡི་རང་བར་བྱེད་པདེའི་ཚེ་ན་ནི་གཉིས་པར་གྱུར་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཡང་བདག་ཉིད་ཀྱི་སྦྱིན་པ་ལསོགས་པ་མི་ཟད་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་སྔོ་བར་བྱེད་པ་དེའིཚེ་ནི་གཉིས་པ་ཡིན་ནོ།",
    "མོས་པས་སྤྱོད་པའི་ས་གཉིས་ནས་བཟུང་སྟེ་ཕནཚུན་ལྷན་ཅིག་བྱེད་པ་ནི་བཅས་པའོ།",
    "དེ་བས་ན་ཚདམས་གནོད་པའི་ཕྱིར་དམིགས་པ་ནི་ཕྱིན་ཅི་ལོག་གི་རང་བཞིན་ཡིནཔའི་ཕྱིར་ཡོངས་སུ་བསྔོ་བ་མ་ཡིན་ནོ།",
    "དེ་ལྟས་འདི་ལྟར་རྣམ་པགང་དང་གང་གིས་ཀྱང་རུང་སྟེ།",
    "གཅིག་དང་དུ་མའི་རང་བཞིན་དང་བྲལ་བའིམཚན་ཉིད་གང་ཡིན་པ་རབ་ཏུ་མཁྱེན་པ་དེ་ལྟར་བདག་གིས་རྗེས་སུཡི་རང་བར་བྱ།",
    "དེ་ལྟར་བདག་གིས་ཡོངས་སུ་བསྔོ་བར་བྱའོ་ཞེསདེ་བཞིན་དུ་རྗེས་སུ་ཡི་རང་བ་དང་།",
    "གང་གི་ཚེ་མཐོང་བ་དང་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལམ་གཉིསཀྱི་དབུས་མཚམས་ཟག་པ་མེད་པའི་རྒྱུའི་གནས་བསྒོམས་པའི་སྟོབས་སུགང་གྱུར་པའི་ཤེས་རབ་ཀྱིས་སྦྱིན་པ་ལ་སོགས་པ་བཟུང་བ་དེའིཚེ་དེརཐམས་ཅད་ཕུན་སུམ་ཚོགས་པའི་རྒྱུ་ཤེས་རབ་ཀྱི་མིག་རྙེད་པསྟེ།",
    "གཞན་དུ་ན་མིག་མེད་པས་དཔེར་ན་རི་མོའི་ལས་ནི་ཡོངསཟིན་ཏེ་ཐམས་ཅདརྫོགས་ཀྱང་རི་མོ་མཁན་གྱིས་དེའི་མིག་མ་བྲིས་པ་དེ་སྲིད་གླརྔན་མི་འཐོབ་པ་བཞིན་ཏེ།",
    "གང་གི་ཚེ་འདོད་པའི་ཁམས་ལ་སོགས་པའདུས་བྱས་དང་།",
    "དེའིཚེ་རྩེ་མོའི་གནས་སྐབས་སུ་འབྲས་བུ་གཟུགས་དག་སྟེ།",
    "སྟོང་པཉིད་ཀྱི་རང་གི་མཚན་ཉིད་ལ་དབྱེར་མེད་དེ་ཐ་དད་པ་མེད་དོ།",
    "བྱེད་པ་དང་ནི་མོས་པདང་།",
    "དེ་ལྟ་མོད་ཀྱི་རྒྱལབའི་སྲས་རྣམས་ཀྱི་གཉེན་པོ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "དེ་དག་གིས་ཐམས་ཅད་ཤེས་པ་ཉིད་བསྟན་ཏོ།",
    "རང་བཞིན་དེ་རང་གི་ངོ་བོ་བསྒོམས་པསསྒྱུ་མ་ལྟ་བུར།",
    "གང་གི་རྒྱུས་དེ་ལྟར་བརྩོན་ཞེ་ན།",
    "གཟུགས་ལ་སོགས་པ་རང་གིརྒྱུ་ལས་སྒྱུ་མ་བྱེད་པས་སྤྲུལ་པ་དང་།",
    "གང་གི་ཕྱིར་གོམས་པར་བྱས་ནས་འདི་དག་གྲོང་དང་གྲོངཁྱེར་གྱི་སྔོན་གྱི་མཚན་མ་ལ་བ་ལང་རྫི་ལ་སོགས་པ་མཐོངབ་དེ་བཞིན་དུ།",
    "གང་གིཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གང་གིས་མཉན་པ་ནི་ཉེབར་མཚོན་པ་སྟེ།",
    "གང་གི་ཕྱིར་ཡུམ་མཉན་པ་ལསོགས་པའི་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པ་ན་དགྲ་བཅོམ་ས་ལ་མི་གནསརྐྱེན་རྟོགས་ཀྱི་ས་ཐོབ་པ་ཡིན་ནོ།",
    "ཡང་གང་གི་ཚེ་ཅི་སྟེ་ཤིང་ལ་སོགས་པའིརྟགས་མ་མཐོང་ན་དེའི་ཚེ་རྒྱ་མཚོ་ཆེན་པོ་ནི་ཉེ་བར་གྱུརཏེ།",
    "རིང་པོར་མི་ཐོགས་བདག་རེགའགྱུར་རོ།",
    "དཔེར་ན་བུད་མེད་ན་ཆུང་མངལ་སྐྱེ་བ་ནིསྦྲུམ་མའོ།",
    "གང་གི་ཚེ་དེ་ནི་བཙའ་བའི་དུས་ལབབ་ཅེས་བྱ་བ་སྟེ།",
    "ལོག་གི་ཞེན་པ་སེལ་བ་ལ་མཁས་པས་སྨྲ་བའི་ཟླ་བའོ།",
    "དེབས་ན་རེ་ཞིག་ཡོངས་སུ་བྲྗོད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ལན་ཏོ།",
    "རྒྱལབའི་ཤེས་རབ་ཕ་རོལ་ཕྱིན་འདི་ཡིག་འབྲིའི་ཚེ་ནི་གཞུང་གི་དོནབྲི་བ་དང་།",
    "སྔ་མ་དང་ཕྱི་མ་དཔྱད་པས་མི་བསྟན་པར་གྱུར་པའིཕྱིར་དེ་ཡང་གློག་བཞིན་དུ་མྱུར་དུ་ཉམས་པར་འགྱུར་བ་འདི་ཉིདནི་རེ་ཞིག་བདུད་ཀྱི་ལས་སོ།",
    "དེས་ཡོངས་སུ་མ་ཤེས་པར་འདྲེན་པ་བཅོམ་ལྡན་འདསཀྱིས་འདིར་ནི་བདག་གི་མིང་ཡང་མ་བྲྗོད།",
    "གླང་པོརྙེད་ནས་དཔེར་ན་འགའ་ཞིག་གི་དོན་དུ་གླང་པོའི་རྗེས་ནི་ཚོལ་བལྟར།",
    "གངགི་ཚེ་བདུད་རྣམས་རྒྱལ་བ་སྐྱེད་མ་ལ་ཇི་ལྟར་བགེགས་བྱ་ཞེསབརྩོན་པ་དང་ལྡན་པས་སྤྲོ་བར་འགྱུར་ཏེ་བར་ཆད་ལ་ཞུགས་ནསགཅོད་པར་ཞུགས་སོ།",
    "དེ་ལ་རེཞིག་མཚོན་པར་བྱེད་པ་གང་ཡིན་པ་བྱེད་པར་སྒྲུབ་པར་བྱེད་པཡོངས་སུ་འཛིན་པའི་ཤེས་པ་དང་།",
    "བྱེད་པའི་དབྱེབས་མཚན་ཉིད་མཚོན་པར་བྱེད་པ་ནི་གསུམ་མོ།",
    "དེ་ལ་རེ་ཞིག་ཤེས་པའི་མཚནཉིད་ནི་ཀུན་མཁྱེན་གསུམ་གྱི་དབྱེ་བས་གསུམ་ཡོང་པ་ལས་ཐམས་ཅདཤེས་པའི་སྒོ་ནས།",
    "རང་གི་ངོ་བོར་བྱེ་བྲག་མེད་པར་རྟོགས་པ་ནི་གཞན་མིན་ཏེ་དེབཞིན་ཉིད་དེ།",
    "ཕྱིན་ཅིལོག་གི་རང་བཞིན་ཡིན་པའི་ཕྱིར་གྲོལ་བར་མི་རིགས་སོ།",
    "ཞུམ་པ་མེད་པར་གནས་ནས་རི་དགས་ཕྲ་མོ་མངསྐྲག་བྱེད་ཅིང་སྒྲ་སྒྲོགས་ལྟར།",
    "གང་གི་ཕྱིརམཐོང་བ་མེད་པ་ནི་གཅིག་ཏུ་ངེས་པའི་རང་བཞིན་མཐོང་བར་མིནུས་ཏེ།",
    "ཡང་གང་གི་ཚེ་སངསརྒྱས་ཀྱི་ཡོན་ཏན་ཁྱད་པར་ཅན་རྣམས་ཐོབ་ཅེ་ན།",
    "དེཐང་ལ་གནས་པར་དེ་ལྟར་དད་ལྡན་དང་བ་ཙམ་ཐོབ་པ་གངཞིག་གིས་ནི་ཤེས་རབ་ཕ་རོལ་ཏུ་ཕྱིན་ཡུམ་རྗེས་སུ་མི་འཇུག་སྟེ།",
    "རང་གིརིགས་མཐུན་པའིརྒྱུན་ཆད་པས་ན་འཆི་བའོ།",
    "བུ་དང་བུ་མོ་ལ་སོགས་པ་དངབྲལ་བས་ཡིད་མི་བདེ་བ་ནི་མྱ་ངན་ནོ།",
    "པས་ཤེས་རབ་ཕ་རོལ་ཕྱིན་མཆོག་གིས་ཟིན་པ་སྟེ།",
    "དམིགས་པ་དང་དམིགས་པ་མེད་པའི་དཔེས་རིམ་པ་ཇི་ལྟ་བབཞིན་དུ་རེསའགའ་བྱེད་པ་དང་།",
    "དཔེར་ན་སྐྱེསབུ་གང་ཞིག་རྒས་ཤིང་གཉེར་མ་དང་ལྡན་པས་འཁོགས་པ་ཟསལ་སོགས་པ་དང་མི་ལྡན་པས་སྡུག་བསྔལ་བ་ལོ་བརྒྱ་དང་ཉིཤུ་ལོན་པས་གང་གི་ཡང་ཇི་སྲིད་ན་སྟན་ལས་ལངས་ཀྱང་།",
    "དེབཞིན་དུ་ཡང་རང་གིས་རྒྱང་གྲགས་ཕྱེད་དམ།",
    "དེ་ནི་གཡས་གཡོན་གཉིས་ཀྱི་ལག་པགཉིས་མི་དག་གིས་བརྟེན་བྱས་པར་གྱུར་ན་དེའི་ཚེ་འགྱེལ་བའིའཇིགས་པ་མེད་ཅིང་ཇི་སྲིད་དུ་འགྲོ་བར་བྱ་བའི་གནས་སུ་བདེབླག་ཏུ་ཕྱིན་པར་འགྱུར།",
    "དེ་ཉིད་ཐབས་དང་ཤེས་རབ་མཆོག་གིས་ཡོང་ཟིནན།",
    "རང་གི་དོན་ཕུན་སུམ་ཆགས་པ་ལས་ལྡོག་པ་མེད་པའི་ཕྱིར་མིལྡོག་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གཞན་གྱི་དྲིང་མི་འཇོག་ཅིངརང་གི་ས་ལས་ལྡོག་པ་མེད་པས་ནིཕྱིར་མི་ལྡོག་པར་རིག་པར་བྱའོ།",
    "སྦྱོར་བའི་ངོ་བོ་རང་གིམཚན་ཉིད་ལས་མ་གཏོགས་པའི་གྲོལབ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "བྱང་གི་ཕྱོགས་དང་།",
    "རང་གི་མཚན་ཉིད་དང་བྲལ་བ་ས་ཡངབྱེ་བྲག་ཏུ་གྱུར་པ་མེད་དོ།",
    "གང་གི་ཕྱིར་ཤེས་རབ་མེད་པནི་ཉེ་བར་མཚོན་པ་སྟེ།",
    "ཡོན་ཏན་དཔག་ཏུ་མེད་པའི་རང་བཞིན་གྱི་སྐུ་མངའབའི་ཕྱིར་ཡོན་ཏན་ཕྱོགས་ཙམ་མོ།",
    "དུས་གཅིག་ལ་བཅོམ་ལྡན་འདསཁྱོད་ཀྱིས་བསྟན་དུ་གསོལ།",
    "གཉེནཔོའི་མི་མཐུན་པའི་ཕྱོགས་ཡིན་པའི་ཕྱིར་གཟུགས་ལ་སོགས་པ་རྣམསལས་ལོག་པ་ནི་ཡོན་ཏན་ཕྱོགས་ཙམ་མོ།",
    "དེ་ལརེ་ཞིག་ངེས་པར་འབྱེད་པའི་ཆ་ལ་གནས་པའི་ཕྱིར་མི་ལྡོག་པའིམཚན།",
    "ངན་སོང་གསུམ་ནི་ཉེ་བར་མཚོན་པ་སྟེ།",
    "འདོད་པའི་ལས་ཅན་དེབྱས་པར་གྱུར་པས་སྐྱེས་པའམ་བུད་མེད་དུ་ངེས་པར་འགྱུར་རོ་ཞེསབྱ་བ་ལ་སོགས་པ་ལུང་སྟོན་པར་མིབྱེད་དོ།",
    "ལུས་དང་ངག་གི་ཁྲོ་བདང་བྲལ་བའི་ཕྱིར་འཐབ་དང་རྩོད་དང་བྲལ་ལོ།",
    "སྐུར་པ་འདེབསཔའི་མཐའ་དང་བྲལ་བ་ངེས་པར་བརྟགས་ན་གང་གི་ཕྱིར་བརྟགསཔས་གཏིང་ཡོད་པ་མི་རྙེད་པས་ཟབ་མོ་དང་ལྡན་པ་ནི་ཟབ་པ་སྟེ།",
    "བུད་མེད་དང་ལྷན་ཅིག་ཏུ་ཁྱོད་ཆེ་གེ་མོར་ཤོག་ཤིག་ཅེས་སྨྲསནས་དུས་བཏབ་དེ་དང་མ་ཕྲད་དེ།",
    "ཡང་ལམ་ཆེན་པོ་སྐྱེསཔ་ན་ཉོན་མོངས་པ་ཆེན་པོ་མེད་པའི་ཕྱིར་རོ།",
    "ལམ་འབྲིངགི་དོན་བསྟན་པའི་ཕྱིར།",
    "ཤེས་རབ་འབའཞིག་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་བྲྗོད་མོད་ཀྱི།",
    "ཀྱང་གི་སྒྲས་སྦྱིནཔ་ལ་སོགས་པ་ཡང་ཕརོལ་ཏུ་ཕྱིན་པ་སྟེ།",
    "སྒྱུ་མ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་མིང་ཙམ་མོ།",
    "ཡོད་ན་ནི་རྟག་ཏུ་ཡོད་པར་ཐལ་བར་འགྱུར་བས་ཀུནརྫོབ་ཏུ་ཡང་སྐྱེ་བ་མེད་པའི་ཕྱིར་རྒྱུ་དང་འབྲས་བུའི་ངོབོའི་མཚན་ཉིད་བསྲེག་པར་བྱ་བ་དང་།",
    "སེམས་གཉིས་པ་དེ་ཡིས་ཀྱང་བྱངཆུབ་ལ་རེག་པའི་རང་བཞིན་དུ་རྣམ་པ་ཐམས་ཅད་དུ་མེད་པའིཕྱིར་རོ།",
    "དམིགསཔའི་རེག་བྱར་གྱུར་པ་ལས་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "ཟབ་མོ་བསྐྱེད་པའི་སྦྱོར་བའི་འཛིན་པ་ཡང་བའི་ཕྱིར་འབྲས་བུདང་།",
    "དེའི་རྗེས་ལ་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "འཕོང་ལེགས་པར་བསླབ་པའི་ཕྱིར་འཕོང་གི་ཕ་རོལ་ཏུཕྱིན་པའོ།",
    "རི་མོ་ལ་སོགསཔའི་ལས་ཀྱི་གནས་ཀྱི་བྱ་བ་ལ་མཁས་པའི་ཕྱིར་བཟོ་གནས་མངབའོ།",
    "བུ་དང་བུ་མོ་ཡོངསསུ་བསྡུས་ནས།",
    "དེ་བཞིན་དེ་ཚེ་ནི་གང་གི་ཚེ་སྟེ།",
    "རང་གི་སྨོནནས་ཤེས་པའི་རྒྱུ་དེ་གཉིས་ཙམ་གྱི་བྱིན་གྱི་རླབས་ཅན་ནི་རྟེནཅན་ནོ།",
    "ཇི་སྐད་བསྟན་པའི་ཐབས་ལ་མཁས་པའི་སྟོབསཀྱིས་མྱ་ངན་ལས་འདས་ལ་མི་རེག་པར་དངོས་པོའི་མཚནཉིད་ལས་འདས་པས་སྟོང་པ་ཉིད་གནས་པ་མེད་དེ།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ལསོགས་པ་གསུངས་ཏེ།",
    "མཐུན་མོང་མ་ཡིན་པའི་ཐབས་ལ་མཁས་པ་བསྟན་པའི་ཕྱིར།",
    "ཐུན་མོང་མ་ཡིན་པའིཐབས་ལ་མཁས་པ་ཡིན་ནོ་ཞེས་བསྟནཔར་འགྱུར་རོ།",
    "དཔེར་ན་འཕོང་ལེགས་པར་ལོབས་པའི་སྐྱེས་བུ་འགའ་ཞིག་གིསལེགས་པར་གནམ་དུ་མདའ་འཕངས་ཏེ།",
    "ཉོན་མོངས་པ་དང་བྲལ་བས་ན་དགེསློང་ངོ།",
    "རེ་རེའི་རྣམ་པ་མངབས་མཐའ་ཡས་སོ།",
    "གང་གི་ཚེཡང་དེར་ནི་དེད་དཔོན་འབའ་ཞིག་བདེ་བར་འཚོ་བྱེད་ཅིང་།",
    "འཚོང་བ་དང་ཉོ་བའི་ཟོང་གི་རིན་ཐང་ཤེས་པར་བྱ་བའིཕྱིར།",
    "གང་གི་ཚེ་བདེ་བ་ལ་སྦྱོར་བར་བྱེདཅིང་འགྲོ་ལབྱམས་པ་རྗེས་སུ་འབྲེལ་བྱས་ནས།",
    "དེ་ནི་གང་གིས་ཀྱང་ནི་གདགས་པར་ནུས་པཡིན་ཞེས་བྱ་བར་འབྲེལ་ཏོ།",
    "བདུད་ཀྱི་བྱིནགྱི་རླབས་ཀྱིས་སོང་བ་ནི་རྟགས་མ་ཡིན་པའི་ཕྱིར།",
    "མིང་གི་ཞེསབྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ནི་ཁྱོད་དང་ཕ་དང་མ་དང་།",
    "ཁྱོད་ཀྱིགཞན་ཡང་བརྒྱུད་པ་བདུན་མེས་བརྒྱུད་ཀྱི་བར་གྱི་མིང་འདི་ཡིནཞིང་།",
    "ལྗོན་ཤིང་གི་སྐྱེ་བ་འཇིག་པའི་ཕྱིར།",
    "གང་གི་ཕྱིར་ལོ་མང་བྱེ་བར་གནས་བྱེདཀྱང་གནས་ནི་ཁྱིམ་མོ།",
    "གང་གིཕྱིར་བསྟན་མ་ཐག་པའི་ཉེས་པས་དབེན་ཞིང་འགྲོ་དོན་ཞུགས་པརྣམས་ཀྱི་སྟེ།",
    "གང་གིས་ཡོངས་སུ་མ་ཤེས་པ་དེ་ཉིད་ཉེས་པ་སྟེ།",
    "གང་གི་ཕྱིར་བསྟན་མ་ཐག་པའི་ང་རྒྱལ་ཉེས་པ་ཡིན་པ་དེ་ལྟ་བས་ན་ངེས་པར་བཅོམ་སྟེ།",
    "གང་གི་ཚེ་ཉོན་མོངས་པའི་སྒྲིབཔའི་མུན་པ་བསལ་བས་ནབསལ་བའོ།",
    "གང་གི་ཚེཇི་སྐད་བསྟན་པའི་རྟགས་ལ་སྤྱོད་པ་དེའི་ཚེ་དེ་ལྟར་སྤྱོད་པབདེ་གཤེགས་ཤེས་རབ་སྤྱོད་པ་ཡིན།",
    "བདག་དང་བདག་གིར་ཞེན་པས་ཁམ་གྱི་ཟས་ལསོགས་པ་འདོད་བྱེད་ཅིང་།",
    "ཕྱིན་ཅི་ལོག་གི་སྟོབས་ཀྱིས་ནམ་མཁའ་ལ་མདུད་པ་བོརརོ།",
    "དེསནི་ཀུན་ནས་ཉོན་མོངས་པའི་དངོས་པོར་རྣམ་པར་གཞག་གོ།",
    "ཅི་འདིདག་ཕྱིན་ཅི་ལོག་གི་སྟོབས་ཀྱིསཀུན་དུ་སྟོན་པར་རྣམ་པར་གཞག་ཅེ་ན།",
    "དཔེར་ན་དུག་མེད་པ་ལ་ཕྱིན་ཅི་ལོག་གི་སྟོབསཀྱིས་དུག་ཏུ་ཤེས་པ་ཉིད་ཀྱིས་དུག་ལངས་ཏེ་མི་ལ་ཁྱབ་པའོ།",
    "དུག་དེ་ཁོང་དུ་སོང་བ་མེད་ཀྱང་བརྒྱལ་བར་འགྱུར།",
    "ཕྱིན་ཅི་ལོག་གི་སྟོབས་ཀྱིས་ལེགསཔར་སྦྱར་ཏེ།",
    "སྒྱུམ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་ཕྱིན་ཅི་ལོག་མེད་པས་གང་ཞིག་ཉོནམོངས་རྣམ་དག་འགྱུར་མེད་པ།",
    "རང་གི་འོད་ཀྱིསའཕྲོ་བ་སྲིན་བུ་མེ་ཁྱེར་སྲོག་ཆགས་འབྱུང་པོ་ཐམས་ཅད་དང་།",
    "དེ་ལྟར་གཉེན་པོཤིན་ཏུ་འཕེལ་བས་རང་གི་སྤྱོད་ཡུལ་ལས་འདས་པས་བདུད་བརྩོན་པཆེན་པོ་བྱེད་པར་བསྟན་པའི་ཕྱིར།",
    "གངགི་ཚེ་གཉེན་པོ་སྐྱེས་པ་དེའི་ཚེ་བདུད་ནི་ཟུག་རྔུ་ལྡན་པརའགྱུར་ཏེ།",
    "འཇིགས་པ་བསྟན་ཕྱིར་ཕྱོགས་དངཕྱོགས་མཚམས་རྣམས་སྲེག་ཅིང་སྐར་མདའ་གཏོང་མོད་ཀྱི།",
    "ཡང་དེ་གཉིས་འཐབ་མོ་ལ་སོགས་པ་བྱེད་པས་དེའི་བྱིན་གྱི་རླབསཀྱིས་རྒྱལ་བའི་ཤེས་རབ་ལས་ནི་རིང་འགྱུར་སྙམ།",
    "དེ་བས་ན་ཡང་དེ་གཉི་ག་བཀག་པའིའཐབ་མོ་ལ་སོགས་པ་བྱེད་ཅིང་བདག་ཉིད་བསྟོད་པས་དམ་བཅས་པཉམས་པ་བྱེད་པར་འགྱུར།",
    "གང་གི་ནམ་མཁའི་ཁམས་དེདང་ནི་ནམ་མཁའ་དེར་ཡུལ་འགའ་ཞིག་ཏུ་རྣམ་པ་འགས་འགལ་བ་ཐོབཔ་ལྟ་ཅི་སྨོས།",
    "གང་གི་སྒྲས་འཕངས་པའི་བྲྗོད་པར་བྱ་བ་ནིརང་ལ་རངབྱེད་པ་འགལ་བས་མི་སྲིད་དོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དཔེར་ན་སྒྱུ་མ་བྱེདཔས་སྤྲུལ་པའི་སྐྱེས་བུ་འདི་སྙམ་དུ་ཉེ་བར་གནས་པའི་སྐྱེས་བུལྟད་མོ་པའི་ཚོགས་འདི་དག་མགུ་བར་བྱའོ་སྙམ་དུ་མིསེམས་ཏེ།",
    "ཡང་སྤྲུལ་པའི་སྐྱེས་བུ་དེ་ལ་ལུསམེད་སེམས་མེད་ངག་གི་རང་བཞིན་ཡང་མེད་མིང་ཡང་ཡོད་པ་མ་ཡིནནོ།",
    "སོགས་པའི་ལྷའི་ཚོགས་གཙོ་བོ་མང་པོ་དག་ཐལ་མོ་སྦྱརབ་བཏུད་ནས་ཡང་དང་ཡང་དུ་ལུས་དང་ངག་དང་ཡིད་ཀྱིས་ཕྱགཀྱང་འཚལ་བར་བྱེད་དོ།",
    "རེ་ཞིག་ཉན་ཐོས་རྣམས་དང་།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་པའི་བྱེད་པ་ཉིད་ནིཞི་བའོ།",
    "ཇིསྙེད་དེ་དག་གི་མཆོག་ཏུ་འདི་གནས་པ་ཡིན་ཏེ།",
    "རང་གི་ལས་ལས་སྐྱེས་པའི་གཤོགཔ་གཉིས་ལ་ནུས་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུ་ཉིད་ཉེ་བར་གཟིགས་ནས་མྱ་ངན་ལས་འདསཔའི་ཕྱིར་འདས་པའོ།",
    "རེ་ཞིག་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པར་དཔེ་སྔོན་དུ་འགྲོ་བས་བསྟན་པའི་ཕྱིར།",
    "གང་གིས་གཟུགསམེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "ཡང་གི་སྒྲས་འགོག་པའི་སྙོམས་པར་འཇུག་པ་གཅིག་ཀྱང་ངོ།",
    "ཕྱིས་རྫུ་འཕྲུལ་ལ་སོགས་པསསོང་སྟེ།",
    "དེ་ལ་རེ་ཞིག་གལ་ཏེརྟེན་མེད་ན་དམིགས་པ་ལ་སོགས་པ་ཇི་ལྟར་ཞེ་ན།",
    "རང་གི་སེམས་ཡོངས་སུ་སྦྱངས་པས་ནི་སངསརྒྱས་ཀྱི་ཞིང་སྦྱངས་པ་དང་།",
    "དེ་ལྟ་མོདཀྱི་དོན་དེའི་ཕྱིར་དམིགས་པ་དང་ལྡན་པ་ལ་སོགས་པའི་ཁམས་སུམོས་ཏེ།",
    "བླངསནས་ཁྱིམ་དུ་སོང་ནས་ཆགས་པ་མེད་པར་རང་གི་གཉེན་རྣམས་ལདགོད་དོ།",
    "པ་ཙམ་འབའ་ཞིག་གིས་སྐྱེ་བ་མ་ཡིན་པ་མཉམ་པརགཞག་པ་ཐབས་དང་ཤེས་རབ་ཀྱི་སྟོབས་ཡིན་ནོ་ཞེས་བྱ་བརདགོངས་སོ།",
    "རྩེ་མོའི་མངོནརྟོགས་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དཔེར་ན་རྗེ་བོ་དེས་ཉེས་པའི་ཚིག་གིས་སྤྱོས་སམ་སྟེ།",
    "སླརཡང་བསད་པར་གྱུར་དུ་འོང་སྙམ་སེམས་ནས་ཞེས་བྱ་བའི་ཚིག་གིལྷག་མའོ།",
    "དེ་དག་ནི་བསླབ་པར་འདོད་པས་བྱེ་བྲག་གི་དོན་རབ་ཏུསྦྱར་མོད་ཀྱི།",
    "ཇི་སྟེདེའི་ཡང་བློ་སྐྱེས་པ་འདི་ཕྱིན་ཅི་ལོག་གི་བག་ཆགས་ཀྱིས་ཀུན་དུབསྐྱེད་པའི་ཕྱིར་ཡང་དག་པའི་ཡེ་ཤེས་སྐྱེས་པས་རྡུལ་ཙམ་རིརབ་ཡིན་པས་སྐད་ཅིག་ཙམ་ལ་ཐལ་བར་བྲླག་སེམས་བསྐྱེད་ནས།",
    "རྫུའཕྲུལ་དང་ཀུན་བྲྗོད་པས་ནི་འགྲོ་བ་ཡོངས་སུ་སྨིན་པར་བྱས་ནསརྗེས་སུ་བསྟན་པའི་ཆོ་འཕྲུལ་གྱིས་བདག་གི་དོན་བྱ་སྙམ་པའིབསམ་པ་ལ་སོགས་པས་གལ་ཏེ་ལུས་དང་ངག་དང་ཡིད་ཀྱིས་ཕ་རོལགནོན་པའི་བསམཔ་དང་བཅས་པས་བརྩོན་པར་བྱེད་ན།",
    "དེའི་ཚེ་ཉོན་མོངས་པ་ཤསཆེ་བས་ལེ་ལོ་ཐོབ་པར་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་སྒྱུ་མ་ལྟ་བུ་ཉིད་ཀྱི་ཕྱིར་ལུས་སུ་མ་ཡིན།",
    "དེས་འདི་ལྟར་འདུ་ཤེས་རྣམ་པར་བཟློག་ནས་གང་གིཚེ་གནས་པ་ན་དངོསཔོ་དང་དངོས་པོ་མེད་པ་ཡིད་ལ་བྱེད་པ་དང་བྲལ་བའི་ཕྱིར།",
