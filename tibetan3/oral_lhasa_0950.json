    "སྒྲུབ་པ་དོན་དུ་གཉེར་བ་རྣམས་འགའ་ཞིག་ཁོ་ན་ལ་འཇུག་པ་ནི་དགོས་པའི་ཁྱད་པར་འདོད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དགོས་པའི་ཁྱད་པར་དོན་དུ་གཉེར་བ་ཉིད་ཀྱི་སྐྱེས་བུ་དགོས་པའི་ཁྱད་པར་ལ་ཐེ་ཚོམ་སྐྱེ་བའི་རྒྱུ་སྔར་ཡོད་པ་ཉིད་མ་ཡིན་ནམ།",
    "དགོས་པའི་ཁྱད་པར་སྟོན་པར་བྱེད་པའི་བསྟན་བཅོས་གཞན་དམིགས་པའི་ཕྱིར་རོ།",
    "དེས་ན་དགོས་པའི་ཁྱད་པར་གྱིས་ལྐུཡུལ་ལ་ཐེ་ཚོམ་སྔར་ཡང་ཡོད་པ་ཉིད་ཡིན་པའི་ཕྱིར་དགོས་པའི་ཚིག་ཉེ་བར་བཀོད་པ་དོན་མེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དགོས་པའི་ཁྱད་པར་འདོད་པ་མངོན་དུ་མ་གྱུར་པ་རྣམས་ནི་དགོས་པའི་ཁྱད་པར་གྱི་ཡུལ་ལ་ཐེ་ཚོམ་སྐྱེ་བའི་༥རྒྱུར་རིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་སྒྲུབ་པར་བྱེད་པ་གཞན་སྤངས་ནས་སོ་སོར་ངེས་པའི་སྒྲུབ་པ་ཉེ་བར་ལེན་པའི་རྒྱུ་ཐེ་ཚོམ་གྱི་ཁྱད་པར་གྱི་རྒྱུར་མི་འགྱུར་རོ།",
    "དེ་ཙམ་གྱེས་འཇུག་པར་རིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་སོ་སོར་ངེས་པའི་སྒྲུབ་པ་ཡོངས་སུ་འཛིན་པའི་རྒྱུད་རྨྱེདགོས་པའི་ཁྱད་པར་གྱི་ཡུལ་ལ་ཟེ་ཚོམ་བསྐྱེད་རྟཔའི་ཕྱིར་ཤིན་ཏུ་སྒོག་ཏུ་གྱུར་པའི་དོན་གྱི་ཡུལ་ལ་ལུང་བྱེད་པ་བཞིན་དུ་འབྲས་བུའི་ཁྱད་པར་དོན་དུ་གཉེར་བ་རྣམས་སོ་སོར་ངེས་པའི་སྒྲུབ་པ་གཟུང་བའི་ཕྱིར་དགོས་པའི་ངག་བརྗོད་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "འདི་ལྟར་དེས་ནི་བསྟན་བཅོས་འདིའི་དོན་གྱི་ཁྱད་པར་བསྟན་གྱི་གཞན་ཀྱི་ནི་མ་ཡིན་ནོ།",
    "དེས་ན་འདིས་སོ་སོར་ངེས་པའི་སྒྲུབ་པའི་བསྒྲུབ་ཐུབྱ་འབྲས་བུའི་ཁྱད་པར་གྱེ་ཡུལ་ཅན་གྱི་ཐེ་ཚོམ་སྐྱེད་པར་༥བྱེད་དོ།",
    "འདི་ནི་གདོན་མི་ཟ་བར་དེ་ལྟ་བུ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཤིན་ཏུ་སྒོག་ཏུ་གྱུར་པའི་དོན་ཀྱི་ཡུལ་ཅན་ལ་ལུང་བྱེད་པ་ཡང་དོན་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་རྒྱུར་འགྱུར་བའི་འབྲས་བུའི་ཁྱད་པར་དོན་དུ་གཉེར་བ་མངོན་དུ་མ་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ཡོངས་སུ་སྤངས་ནས་སྦྱིན་པ་ལ་སོགས་པ་སོ་སོར་ངེས་པར་ཡོངས་སུ་འཛིན་པའི་རྒྱུར་མི་འགྱུར་རོ་སྙམ་ནས་དེའི་དོན་དུ་ལུང་བྱེད་པ་བོ་རྣམས་ཀྱེས་བྱེད་པ་དེ་བཞིན་དུ་བསྟན་བཅོས་བྱེད་པ་རྣམས་ཀྱིས་དགོས་པའི་ངག་ཀྱང་བཀོད་པའི་ཕྱིར་གླན་རྨྱེཀ་འདི་མེད་དོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་གཞན་དམིགས་ན་ཡང་བརྗོད་པར་འདོད་པའི་དགོས་པའི་ཁྱད་པར་ལ་ཐེ་ཚོམ་གྱི་རྒྱུར་མི་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ཉན་པ་པོའི་སྐྱེ་བོ་འཇུག་པར་བྱ་བའི་དོན་དུ་དགོས་པ་ལ་སོགས་པའི་ངག་ཉེ་བར་བཀོད་དོ་ཞེས་བྱ་བར་གནས་སོ།",
    "དོན་མེད་པ་དེ་ནི་བརྩམ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "དེས་ན་མཉན་པའམ་བྱ་བ་བརྩམ་པར་མི་བྱའོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པས་རྩོད་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་གཏན་ཚིགས་མ་གྲུབ་པར་བསྟན་པར་བྱ་བའི་དོན་དུ་དང་པོར་དགོས་པ་ལ་སོགས་པའི་ངག་ཉེ་བར་བཀོད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་ན།",
    "གལ་ཏེ་ཕ་རོལ་པོ་དེ་ཚིག་འདི་ལས་འཇུག་པར་འགྱུར་བ་དེ་ལྟ་ན་དེ་དོན་དང་ལྡན་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་མ་གྲུབ་པར་བསྟན་པ་འབྲས་བུ་མེད་པ་ཉིད་ཡིན་ནོ།",
    "ཉེཔར་བྱེད་པ་མེད་པ་ལེན་ཅིང་གཞན་དག་ཀྱང་ལེན་དུ་འཇུག་སྟེ།",
    "དེའི་ཕྱིར་དེ་ལ་མ་གྲུབ་པར་བསྟན་པར་བྱའོ་སྙམ་ན་དེ་ཡང་མི་རིགས་ཏེ།",
    "གལ་ཏེ་དེ་ངག་དེ་དག་བསྟན་བཅོས་ལ་འཇུག་པའི་ཡན་ལག་མ་ཡིན་པ་དེའི་ཚེ་དེ་ལ་མ་གྲུབ་པར་བསྟན་པ་དགོས་པ་མེད་པ་ཉིད་དེ།",
    "དེ་དག་ལ་ཡང་མི་རིགས་པ་བརྗོད་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་བསྟན་བཅོས་ལ་འཇུག་པའི་ཉེ་བར་མི་མཁོ་བ་ཆེས་མང་པོ་དག་ཀྱང་བརྗོད་པར་བྱ་དགོས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་གདོན་མི་ཟ་བར་བསྟན་བཅོས་བརྩམ་པ་ལ་གཏན་ཚིགས་མ་གྲུབ་པར་བསྟན་པ་འདི་ནི་འབྲས་བུ་མེད་པ་དང་།",
    "དེ་ལྟ་བས་ན་གང་ཡང་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པས་མི་རྩོད་པ་དང་།",
    "དགོས་པ་མ་ཐོབ་པར་རྔུ་མི་འཇུག་པ་དེ་ལ་ཅིའི་ཕྱིར་དོན་དང་བཅས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟ་བས་ན་ཉན་པ་པོའི་སྐྱེ་བོ་འཇུག་པའི་དོན་དུ་བརྗོད་པར་བྱ་བ་ལ་སོགས་པ་བསྟན་ཏོ་ཞེས་བྱ་བར་གནས་སོ།",
    "གང་ཡང་སློབ་དཔོན་གྱིས་རིགས་པའི་ཐིགས་པ་རྔུ་རང་ཉིད་ཀྱང་དེ་ལྟར་རྟོགས་པར་འགྱུར་ཞེས་བསམས་ནས།",
    "ཤེས་རབ་ལ་སོགས་པའི་ཡོན་ཏན་གོམས་པས་ཁྱད་པར་དུ་འཕགས་པར་འགྱུར་བ་དང་།",
    "དེ་ལ་བརྟེན་པའི་བསྟན་བཅོས་ལ་སོགས་པ་ལ་བརྟག་པ་སྔོན་དུ་འགྲོ་བས་འཛིན་པ་ལ་སོགས་པའི་དོན་དུ་གུས་པར་བྱེད་དོ།",
    "ཞེས་པ་འདིས་ནི་བརྗོད་པར་བྱ་བ་དང་།",
    "འོན་ཏེ་ངག་ཉིད་བརྗོད་པར་བྱ་བ་དང་ལྡན་པ་ཡིན་ཀྱི་སྒོགཞན་ནི་མ་ཡིན་ནོ་ཞེས་རིགས་པ་མ་ཡིན་ནམ།",
    "དེས་ན་འདི་ལ་བརྗོད་པར་བྱ་བ་ག་ལ་སྲིད་ཅེ་ན།",
    "འོན་ཀྱང་ངག་དེ་ནི་པྱཕན་ཚུན་ལྟོས་ནས་འབྲེལ་པར་གནས་ཏེ།",
    "འདི་ལྟར་བསྟན་བཅོས་ལ་འཇུག་པར་འདོད་པ་རྣམས་ཀྱི་ཙུདགོས་པ་ཉེ་བར་བསྟན་པ་ན་དེ་ལྟར་གཏོགས་པ་ཉིད་བསྟན་པར་བྱའིབྱེ།",
    "སྨྲ་བ་པོ་བསྟན་བཅོས་ལ་སོགས་པའི་དགོས་པ་བརྗོད་པ་ཡང་བསྟན་བཅོས་ལ་གཞན་དག་གཞུག་པར་འདོད་པས་ཡིན་གྱི་ཞེས་པས་ནི་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་ན་གཞན་དག་དགོས་པ་བསྟན་པས་བསྟན་བཅོས་ལ་འཇུག་པར་འགྱུར་བ།",
    "ཁྱད་པར་ཅན་གྱི་དོན་སྟོན་པར་ནུས་པའི་ཚིག་ནི་བསྟན་བཅོས་སུ་བརྗོད་ཀྱི།",
    "དེ་ལྟ་བས་ན་བརྗོད་པར་བྱ་བ་ལ་སོགས་པར་གཏོགས་པའི་དགོས་པ་ནི་བསྟན་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་ཡང་སློབ་དཔོན་ཀྱིས་ཡང་དག་པའི་ཤེས་པ་ནི་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པའི་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པས་ན་ཞེས་གང་བསྟན་པ་དེ་ནི་དགོས་པ་བསྟན་པ་ཡིན་གྱེ་བརྗོད་པར་བྱ་བའི་དགོས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཡང་དག་པའི་ཤེས་པ་རྟོགས་པ་ཉིད་ཡང་དག་པའི་ཤེས་པའི་སྒྲར་བརྗོད་པར་འདོད་པའི་ཕྱིར་ཏེ།",
    "འདི་ལྟར་ཕ་རོལ་རྟོགས་པར་བྱ་བའི་དོན་དུ་བརྩམས་པའི་བསྟན་བཅོས་ནི་བྱེད་པ་ཉིད་དམ་བྱེད་པ་པོ་ཉིད་དུ་འགྱུར་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་ནི་བྱ་བ་ལ་ལྟོས་པའི་ཕྱིར་དང་།",
    "དངོས་དང་བརྒྱུད་པས་བྱས་པའི་ཁྱད་པར་ནི་ཡོད་དོ།",
    "དེ་ཡང་ཤིན་ཏུ་གྲགས་པའི་ཕྱིར་དགོས་པ་ཉིད་དུ་བསྟན་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་བརྗོད་པར་བྱ་བ་མེད་པར་དོགས་པ་བསལ་བའི་དོན་དུ་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "བརྗོད་པར་བྱ་བའི་ཁྱད་པར་་བསྟན་པ་ཉིད་ཀྱིས་དོགས་པ་བསལ་ཟིན་པའི་ཕྱིར་རོ།",
    "བརྗོད་པར་བྱ་བའི་ཁྱད་པར་བསྟན་པར་འདོད་པའི་དོན་དུ་དེ་བསྟན་པ་ཡང་མ་ཡིན་ཏེ།",
    "བརྗོད་པར་བྱ་བའི་ཁྱད་པར་བསྟན་པ་ཉིད་ཀྱིས་དེ་བསྟན་ཟིན་པའི་ཕྱིར་རོ།",
    "དེ་ཁོ་ན་ཉིད་བསྦུས་པའི་བྱ་བ་འདིའི་འབྲས་བུ་ནི་སྙེབསྟན་པར་བྱ་བའི་རྒྱུད་དུ་གཏོགས་པའི་དེ་ཁོ་ན་ཉིད་བདེ་བླག་ཏུ་རྟོགས་པ་ཡིན་ཏེ།",
    "དེ་ཡང་བསྡུས་པའི་སྒྲས་བསལ་རྒྱབར་བྱས་པ་ཉིད་ཡིན་ནོ།",
    "དེ་ཁོ་ན་ཉིད་གཅིག་ཏུ་བསྡུས་པ་ནི་རྟོགས་པ་པོས་བདེ་བླག་ཏུ་རྟོགས་པར་འགྱུར་གྱེ།",
    "རྣམ་པར་འཐོར་བ་ནི་དཀའ་བས་འཛིན་པའི་ཕྱིར་བདེ་བླག་ཏུ་འཛིན་པའི་རྒྱུར་བསྡུས་པའི་སྒྲས་བསྡུས་པ་སྟོན་པ་ན་དེ་ཁོ་ན་ཉིད་བདེ་བླག་ཏུ་རྟོགས་པར་བྱ་བའི་དོན་དུ་འདི་བརྩམས་སོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཕ་རོལ་རྗེས་སུ་འཛིན་པ་ཁྱད་པར་ཅན་མེད་པའི་ཕྱིར་དང་།",
    "དེའི་ཕྱིར་སྔོན་གྱི་སློབ་དཔོན་རྣམས་ཀྱིས་དེ་ཁོ་ན་ཉིད་བསྟན་ཟིན་ན་ཡང་བློ་དམན་པས་ཤིན་ཏུ་འཐོར་བ་ཉིད་ཀྱིས་བདེ་བླག་ཏུ་གཟུང་སྙེབར་མི་ནུས་པ་གང་ཡིན་པ་དེ་ལ་བདེ་བླག་ཏུ་གཟུང་བར་བྱ་བའི་ཕྱིར་དེ་ཁོ་ན་ཉིད་བསྡུས་པ་བརྩམ་རྗོཔ་ནི་འབྲས་བུ་མེད་པ་མ་ཡིན་པར་འདོད་དོ་སྙམ་དུ་བསམས་ནས་བསྟན་བཅོས་འདི་བརྩམས་སོ།",
    "ཞེས་དེ་སྐད་དུ་བསྟན་པར་བྱ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་བརྗོད་པར་འདོད་པའི་དོན་ཇི་ལྟ་བ་བཞིན་གསལ་པོར་བསྟན་པར་བྱས་པར་ཀྱེའགྱུར་རོ།",
    "དཔེར་ན་སྐོམ་པས་ཆུ་འོན་ཐུཅིག་ཅེས་བྱ་བ་འདི་ལ་ཆུ་འཐུང་བ་དེ་ནི་ལེན་པའི་བྱ་བའི་འབྲས་བུ་ཡིན་པར་རྟོགས་པ་དེ་བཞིན་དུ་འདི་ལ་ཡང་ངོ།",
    "དེའི་ཕྱིར་དེའི་རྒྱུ་ལས་བཟློག་པ་འདིའི་རྒྱུ་ཡིན་པར་གནས་སོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ཐུཡང་ལས་དང་འབྲས་བུའི་འབྱེལ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡིད་ཆེས་པ་དང་།",
    "འབྱེལ་པ་ཡང་འབྲས་བུ་མེད་པའི་ཕྱིར་བརྗོད་པར་བྱ་བ་དང་།",
    "དགོས་པ་དག་ལས་ལོགས་ཤིག་༧ཏུ་བསྟན་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་དེ་སྟོན་པ་ན་བསྟན་བཅོས་དང་དགོས་པ་གཉིས་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་ངོ་བོའི་མཚན་ཉིད་བསྟན་པར་བྱ་བ་ཡིན་གྱི།་",
    "བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་ངོ་བོ་དེ་ཡང་དགོས་པ་བརྗོད་པ་ཉིད་ཀྱིས་བསྟན་ཏེ།",
    "འདི་ལྟར་འདི་ནི་འདིའི་དགོས་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ན་འདི་ནི་འདིའི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "གང་ཞིག་གང་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དེ་ནི་དེའི་དགོས་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་ཤུགས་ཀྱིས་ཐོབ་པའི་ཕྱིར་འདིའི་བརྗོད་པར་བྱ་བ་དང་།",
    "དགོས་པ་དག་ལས་ལོགས་ཤིག་ཏུ་བརྗོད་པར་མི་བྱའོ།",
    "གང་ཞིག་གང་བརྗོད་རྔུ་ན་ཡང་མི་རྟོགས་པ་ནི་དཔེར་ན་བརྗོད་པར་བྱ་བ་དང་།",
    "དགོས་པ་གཉིས་གང་ཡང་རུང་བ་བརྗོད་ཀྱང་ཅིག་ཤོས་མི་རྟོགས་པ་ཡིན་པ་བྱེལྟར་དེ་དེ་ལས་ལོགས་ཤིག་ཏུ་བསྟན་པར་འོས་སོ།",
    "བརྗོད་པར་བྱ་བ་དང་དགོས་པ་གཉིས་ཁོ་ན་བརྗོད་པར་བྱའོ།",
    "ངག་གཙོ་བོས་དོན་དུ་མ་རྗོད་པར་བྱེད་པ་ནི་འགལ་གྱི།",
    "ཡང་ན་རྣམ་པ་གཞན་དུ་ཡིན་པའི་ཕྱིར་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་བརྗོད་པ།",
    "དེའི་དོན་ངེས་པར་བཟུང་བ་ལས་ཀྱེབདེ་འགྲོའི་རྒྱུ་ལས་དང་འབྲས་བུ་ཕྱིན་ཅི་མ་ལོག་པ་ལ་ཡིད་ཆེས་པ་སྐྱེ་ཞིང་།",
