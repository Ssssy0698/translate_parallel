    "རྨོངས་པ་ལ་སོགས་པའི་རིགས་དང་ལྡན་པར་དམིགས་སོ།",
    "རྣམ་པར་འཚེ་བ་དང་།",
    "རྨོངས་པ་རྣམ་པ་གསུམ་པོ་རྣམས་ཀྱི་གནས་ལུགས་ཀྱི་ཁྱད་པར་ཡིན་ནོ་ཞེས་ངེས་པར་བྱའོ།",
    "དེའི་ཕྱིར་གང་ལ་ནུས་པ་འཇུག་པར་བྱེད་པའི་གཙོ་བོ་ཡོད་དོ།",
    "འདི་ལྟར་བུམ་པ་ནི་སྦྲང་རྩི་དང་ཆུ་དང་འོ་མ་འཛིན་པར་ནུས་ཀྱི།",
    "དེ་ལྟར་ན་ཆེན་པོ་ལ་སོགས་པའི་འབྲས་བུ་འདི་མཐོང་ནས་གང་ལས་ཆེན་པོ་ལ་སོགས་པའི་འབྲས་བུ་འདི་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་གཙོ་བོ་ཡོད་དོ་ཞེས་བསྒྲུབ་པོ།",
    "འདི་དག་ནི་འཇིག་པའི་དུས་ན་འགའ་ཞིག་ཏུ་དབྱེར་མེད་པར་འགྱུར་ཏེ།",
    "བློ་ནི་གཙོ་བོ་ལ་དབྱེར་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ན་འཇིག་པའི་དུས་སུ་འཇིག་རྟེན་གསུམ་དབྱེར་མེད་པར་འགྱུར་རོ།",
    "དབྱེར་མེད་པར།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་དབྱེ་བར་མི་ནུས་པའོ།",
    "དེ་ལྟ་བས་ན་གང་དུ་ཆེན་པོ་ལ་སོགས་པ་ཞུམ་པར་དབྱེར་མེད་པར་འགྲོ་བའི་གཙོ་བོ་ཡོད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་སོ།",
    "དེ་ལྟར་རྗེས་སུ་འགྲོ་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་གྲུབ་པར་བསྟན་ནས།",
    "བུམ་སོགས་བྱེ་བྲག་བཞིན་ཞེས་བྱ་བ་ནི་བུམ་པ་ལ་སོགས་པའི་ཁྱད་པར་བཞིན་ནོ།",
    "དེ་ཕྱིར་འདི་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་འུལན་འདེབས་པར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་འབྲས་བུའི་ཁྱད་པར་འདི་དག་གཙོ་བོའི་རང་བཞིན་ཁོ་ན་ཡིན་ན་དེའི་ཕྱིར་ཇི་ལྟར་འདི་དག་ལས་འབྲས་བུ་ཉིད་དུ།",
    "ཀྱེའཇུག་པར་འགྱུར།",
    "འདི་ནི་རྒྱུའོ་ཞེས་བྱ་བའི་མ་འདྲེས་པའི་རྣམ་པར་གཞག་པ་བྱས་པ་གང་ཡིན་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་ཙམ་རྣམས་ནི་སྔ་མ་དང་ཕྱི་མ་ལ་ལྟོས་ན་རྒྱུ་ཡང་ཡིན་ལ་འབྲས་བུ་ཡང་་ཡིན་ནོ་ཞེས་རྣམ་པར་གཞག་པ་བྱས་པ་གང་ཡིན་པ་དེར་མི་འགྱུར་རོ།",
    "ལྟོས་པར་བྱ་བ་ངོ་བོ་གཞན་བྱེ་ཡང་མི་སྲིད་པའི་ཕྱིར།",
    "སྐྱེས་བུ་བཞིན་དུ་ཐམས་ཅད་རང་བཞིན་ཡང་མ་ཡིན་ལ་འགྱུར་བ་ཡང་མ་ཡིན་པར་འགྱུར་རོ།",
    "གང་ཞིག་གང་ལས་རང་བཞིན་ཐ་མི་དད་པ་དེ་ནི་དེ་ལས་བཟློག་པར་མི་རིགས་ཏེ།",
    "ཐ་མི་དད་པར་རྣམ་པར་གཞག་པའི་མཚན་ཉིད་ནི་གྲུབ་པ་དང་བདེ་བ་གཅིག་པ་ཡིན་པའི་ཕྱིར་རོཤི།",
    "ཆེན་པོ་ལས་ང་རྒྱལ་ཞེས་བྱ་བ་ལ་སོགས་པ་འགྲུབ་པར་འགྱུར་བ་གཙོ་བོ་ལ་སོགས་པ་ལས་ཆེན་པོ་ལ་སོགས་པ་སྐྱེ་བར་ངེས་པ་ལ་རྗེས་སུ་འགྲོ་བ་དང་།",
    "འདི་ལྟར་འབྱེལ་པར་འགྱུར་ན་ཡོད་པ་ལ་འམ།་",
    "དེ་ནི་རང་བཞིན་ཕུན་སུམ་ཚོགས་པ་མ་ལུས་པ་ཐོབ་པས་ལྟོས་པ་མེད་པ་ཉིད་ཀྱིས་འགའ་ལ་ཡང་རག་ལས་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "སྐྱོན་མཚུངས་པར་བསྟན་པའི་ཟོལ་གྱིས།",
    "འབྲས་བུ་ཡོད་པར་སྨྲ་བའི་ཕྱོགས་ལ་ཡང་མཚུངས་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་འདི་ལ་འདི་སྐད་དུ་བརྗོད་པར་ནུས་ཏེ།",
    "ཇི་ལྟར་འདི་མཚུངས་པར་འགྱུར་ཞེ་ན།",
    "ངེས་པའི་རྒྱུ་ལེན་པ་ལ་སོགས་པ་ཙམ་བརྗོད་པར་འདོད་ནས་འདི་བརྗོད་ལ།",
    "འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ལ་ཡང་མི་བྱེད་པ་ལ་སོགས་པ་མཚུངས་པའི་ཕྱིར་རོ།",
    "དེ་དག་དང་མཚུངས་པར་འཇུག་པའི་ཕྱིར་རྒྱུ་རིག་བཞིན་ནོ།",
    "སྐྱེད་པར་བྱེད་པའི་རྒྱུའི་ཐ་སྙད་དུ་རུང་བར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བསྒྲུབ་པར་བྱ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ནི་གྲོལ་བ་ཡིན་པའི་ཕྱིར་ལོངས་སྤྱོད་པར་བྱེད་པ་པོ་གཉིས་འུམ་ཡིན་པའི་ཕྱིར་དཔེ་མ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "གཞན་གྱི་ལུགས་ཀྱིས་གཏན་ཚིགས་མ་གྲུབ་པ་དོགས་པར་བྱེད་དེ།",
    "ཅི་སྟེ་སྤྱིར་ཁྱད་པར་མེད་པ་ཡིན་པ་དེའི་ཚེ་མ་ངེས་པ་ཡིན་ཏེ།",
    "གསལ་སོགས་མཚན་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པའི་སྒྲས་ཤས་ཆེ་བ་དང་ཤས་ཆུང་བ་ལ་སོགས་པའི་གནས་སྐབས་ཀྱི་ཁྱད་པར་བཟུང་དུངོ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་རོ།",
    "བསྒྲུབ་བྱ་མེད་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཉེས་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་དེ་ལྟར་སྔར་དེ་ཡོད་ཅེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "བསྒྲུབ་པར་བྱ་བའི་འབྲས་བུ་དེ་འདོད་པ་ཉིད་ཀྱིས་དེ་དག་རྟོག་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་ལེན་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།"
  ]
}