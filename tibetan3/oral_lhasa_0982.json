    "འདིས་ནི་ནོར་དང་འབྲུ་ཐམས་ཅད་འགུགས་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་རྗེས་སུ་ཆགས་པར་བྱ་བ་ལ་ནི་པི་ཝང་བརྡུང་བ་དང་བཅས་པའི་ཀ་ཀ་ལེའི་གླུ་ལེན་པས་བཟླས་བརྗོད་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ཐམས་ཅད་འབིགས་ཤིང་རྗེས་སུ་ཆགས་པར་བྱ་བ་ལ་ནི་རྡོ་རྗེ་མདའི་ཕྱག་རྒྱས་སོ་ཞེས་བྱ་བ་ལ།",
    "རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བ་ནི་འབིགས་པའོ།",
    "ཡིད་བདེ་བ་བསྐྱེད་པ་ནི་རྗེས་སུ་ཆགས་པར་བྱ་སྟེ།",
    "རྗེས་སུ་ཆགས་པར་འགྱུར་རོ།",
    "ཡིད་ཀྱིས་བཟླས་བརྗོད་བྱ་སྟེ་དེས་ནི་ཐམས་ཅད་མཉེས་པར་འགྱུར་རོ།",
    "དེས་མ་རུངས་པ་རྣམས་རབ་ཏུ་སྒྲུབ་པར་བྱེད་པར་འགྱུར་རོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ཡིད་ཀྱིས་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཞུགས་ཏེ།",
    "བདག་ཉིད་དེ་དང་ལྷན་ཅིག་ཏུ་གྱུར་པར་བསམས་ལ།",
    "བསྒྲུབ་པར་བྱ་བ་འདུད་པར་བྱེད་པའི་བསམ་པས་གདུད་དེ།",
    "དྲེགས་པ་འཕྲོག་པར་འགྱུར་རོ།",
    "དེས་ནི་ཐམས་ཅད་ཡིད་ཚིམ་པར་འགྱུར་རོ།",
    "ལུས་ཀྱི་སྡུག་བསྔལ་གཞིག་པར་བྱ་བའི་ཕྱིར་བཟླས་བརྗོད་བྱ་སྟེ།",
    "གཡོགས་ནས་བྱའོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་གཟུགས་ཐམས་ཅད་ཡང་དག་པར་སྟོན་པའི་བསམ་པ་གར་ལས་བྱུང་བའི་རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ།",
    "འདིས་གཟུགས་ཐམས་ཅད་ཡང་དག་པར་སྟོན་པར་འགྱུར་རོ།",
    "དེ་ཐོས་པར་བྱ་བ་ལ་ནི་ཞེས་བྱ་བ་ནི་གཞན་རྣམས་ཀྱིས་ཐོས་པར་བྱ་བའོ།",
    "དེ་ལྟར་ན་རྡོ་རྗེ་སྤྲོ་བ་བྱས་པར་འགྱུར་རོ།",
    "ལག་པ་གཉིས་ཀྱིས་སེ་གོལ་རྡེབས་ཤིང་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་འོད་ཟེར་འབར་བས་ཀུན་ནས་འཁྲིགས་པས་བསྒྲུབ་པར་བྱ་བ་ཀུན་དུ་གང་བར་བསམ་ཞིང་།",
    "དེས་ནི་པྲ་སེ་ན་ལ་སོགས་པ་དབབ་པ་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་གར་བྱེད་དུ་གཞུག་པ་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཡིད་ཀྱིས་ཞུགས་པའི་བསྒྲུབ་པར་བྱ་བ་གར་བྱེད་པའི་བསམ་པས་བདག་ཉིད་གར་བྱེད་ཅིང་།",
    "དེས་ན་ཐམས་ཅད་གར་བྱེད་དུ་འཛུད་པར་འགྱུར་རོ།",
    "དེ་རྫོགས་པར་བྱ་བའི་བསམ་པས་ལྕེ་བསྐྱོད་ཅིང་བཟླས་བརྗོད་བྱ་སྟེ།",
    "དེས་ནི་ཐམས་ཅད་གླུ་ལེན་དུ་འཛུད་པར་འགྱུར་རོ།",
    "སྤོས་ཆུའི་རྡུལ་ཕྲ་རབ་རྡོ་རྗེ་སྨྲ་བ་ལྟ་བུར་རྣམ་པར་བསམས་ལ།",
    "ཁར་བླུད་ན་དེས་ནི་ཐམས་ཅད་སྨྲར་འཛུད་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་འབེབས་པས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "བབས་པར་འགྱུར་པ་དང་།",
    "གར་ལས་བྱུང་བའི་བ་དན་གསུམ་པའི་ཕྱག་རྒྱ་གཉིས་བྱས་ལ།",
    "ཁྲོས་ཤིང་གདོང་མཆེ་བ་གཙིགས་པ་འོད་ཟེར་འབར་བས་ཀུན་དུ་འཁྲིགས་པའི་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་བསྒྲུབ་པར་བྱ་བའི་སྟེང་དུ་བསམས་ལ།",
    "དེའི་ཚེ་དེ་གདོན་གྱིས་ཟིན་པར་འགྱུར་རོ།",
    "དེ་ནས་རིམས་ཀྱིས་འཛིན་པར་འགྱུར་རོ།",
    "དེས་བྱ་བས་པས་རིམས་ཐམས་ཅད་སེལ་ནུས་པར་འགྱུར་རོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་རྡོ་རྗེ་སེམས་དཔའི་སྦྱོར་བ་བྱས་ལ་མིག་གཡས་པར་མ་ལས་ཉི་མའི་དཀྱིལ་འཁོར།",
    "དེ་དང་ཧཱུཾ་ཞེས་བྱ་བ་ཟློས་ཤིང་བསྒྲུབ་པར་བྱ་བའི་སྤྱི་བོ་ནས་བརྩམས་ཏེ།",
    "བྱབས་ལ་མིག་གཉིས་ལས་བྱུང་བའི་རྡོ་རྗེའི་འོད་ཟེར་རྣམས་ཀྱིས་རིམས་ལ་བསྣུན་པར་བྱས་ན།",
    "དེས་ནི་རིམས་ཐམས་ཅད་བསལ་ནུས་པར་འགྱུར་རོ།",
    "བེམས་པོ་མ་ཡིན་པར་བྱ་ཞིང་།",
    "འདིས་དུག་ཐམས་ཅད་འབར་བར་བྱེད་པར་འགྱུར་རོ།",
    "འདིས་ནི་དོན་འདི་སྐད་དུ་སྟོན་པར་འགྱུར་ཏེ།",
    "ཧཱུཾ་ཞེས་བྱ་བ་ལས་མིག་གཉིས་སུ་ལྟ་བའི་དུག་ཅན་གྱི་ཁྲོ་བོ་གཉིས་འབར་བའི་འོད་རྣམ་པར་འཁྲུགས་པར་བསྐྱེད་ལ།",
    "ཆུན་པོ་ངེས་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་བྱ་བ་པར་བྱ་ཞིང་།",
    "དེས་ཀྱང་བཅོམ་ལྡན་འདས་དུག་ཐམས་ཅད་རྣམ་པར་གཡེང་བར་བྱེད་པས་བསྒྲུབ་པར་བྱ་བའི་ལུས་བཀྲུས་པར་གྱུར་པར་བསམས་ལ།",
    "དེས་ནི་དུག་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་ན་བཞུགས་ཤིང་།",
    "བདུད་ལ་སོགས་པ་མ་རུངས་པ་ཐམས་ཅད་བརླག་པ་ལ་ནི་འཁྲུགས་པས་དཔག་ཏུ་མེད་པར་བཟླས་པས་སོ་ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔའ་ཞལ་མཆེ་བ་རྣམ་པར་གཙོགས་པ།",
    "རྡོ་རྗེ་གསོར་བ་ལ་སོགས་པ་ལ་བརྩོན་པར་རྣམ་པར་བསམས་ལ།",
    "དེས་བགེགས་ཐམས་ཅད་སྐྲག་པར་བྱ་ཞིང་བསྐྲད་པར་བྱའོ།",
    "དེ་ཡང་རྡོ་རྗེ་མེ་ལྟར་རབ་ཏུ་འབར་བར་བདག་ཉིད་རྣམ་པར་བསམས་ལ།",
    "དེ་ནས་རྡོ་རྗེ་ལས་བྱུང་བའི་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱིས་མཁའ་འགྲོ་མའི་གདོན་རྣམས་གསོད་ཅིང་འཇོམས་པར་བྱེད་བར་བསམ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཚེ་རྡོ་རྗེ་སེམས་དཔའ་ཁྲོས་པར་བདག་ཉིད་རྣམ་པར་བསམས་ལ།",
    "རྡོ་རྗེ་འབར་བའི་སྟེང་དུ་ངེས་པར་བབ་པར་བསམ་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ན་ཕྱག་རྒྱ་དེས་འཇིག་པར་འགྱུར་རོ།",
    "དེ་དག་འཇིག་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་ཡི་གེ་ཕཊ་ཀྱིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གསང་བ་རྣམས་འཇིག་པར་བྱས་པར་བསམ་པར་བྱའོ།",
    "བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔའ་ཁྲོས་པར་རྣམ་པར་བསམས་ལ།",
    "འདི་ཉིད་བཅིངས་ལ་བཟླས་པའི་དུས་སུ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་གཟུགས་བདུད་ཐམས་ཅད་ཟ་བར་བྱེད་པར་བསམ་པར་བྱ་སྟེ།",
    "དེ་ལྟ་བུ་ནི་བདུད་ཐམས་ཅད་ཡང་དག་པར་འཇོམས་པར་འགྱུར་རོ།",
    "གཡོན་དུ་ཧཱུཾ་ཞེས་བྱ་བ་ལས་ཁྲོ་བོ་རྡོ་རྗེ་རྣམ་པར་བསམས་ལ།",
    "དེ་ལྟ་བུས་ནི་གཞན་གྱི་དཔུང་ཐམས་ཅད་འཇོམས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་དྲན་པར་བདག་ཉིད་རྣམ་པར་བསམས་ལ།",
    "དེས་གཞན་གྱི་དཔུང་བཅོམ་ཞིང་གཞིག་པར་བྱ་སྟེ།",
    "ཧཱུཾ་ཞེས་བྱ་བས་གོས་ཀྱི་མཐའི་རྡོ་རྗེའི་ཐག་པར་བསམས་ལ།",
    "བསྐྲད་པ་ལ་སོགས་པ་སྔགས་ཀྱི་སྦྱོར་བ་བྱས་ལ་དེ་ཐམས་ཅད་ནི་ཧཱུཾ་མུ་ཞེས་བྱ་བ་བཟླས་ན་བཅིང་བ་ཐམས་ཅད་ལས་གྲོལ་ཞིང་ཐར་བར་འགྱུར་རོ།",
    "འཁྲུལ་འཁོར་ནི་ལྷ་མ་ཡིན་གྱིས་བྱས་པའམ།",
    "དེ་རྣམས་ནི་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་ཕྱག་རྒྱས་འཇིག་པར་འགྱུར་ཏེ།",
    "འཁྲུལ་འཁོར་རྣམས་ལ་འབབ་པར་བསམ་པར་བྱ་སྟེ།",
    "མེ་ཡང་དག་པར་སྐྱེད་པ་ལ་ནི་རྡོ་རྗེ་མེ་ཤེལ་གྱིས་སོ་ཞེས་བྱ་བ་ནི།",
    "ཧཱུཾ་ཞེས་བྱ་བ་ཉིད་ཟློས་ཤིང་མེ་བསྐྱེད་པར་བྱའོ།",
    "ཆུ་བསྐྱེད་པར་འགྱུར་ཏེ།",
    "ནམ་མཁའ་ལ་ཧཱུཾ་ཞེས་བྱ་བ་ལས་ནམ་མཁའི་མཛོད་ཟས་དང་སྐོམ་ཐམས་ཅད་འབེབས་པ་ལ་བརྩོན་པར་བསམས་ལ།"
  ]
}