    "ནམ་མཁའ་འཕྲུལ་མཛོད་དྲང་ངེས་གཉིས་ཀྱི་གཞུང་དང་ཆ་ལགགཉིས་པ་འཆི་རྐྱེན་མང་བས་ཀྱང་ནམ་འཆི་ཆ་མི་འདུག་སྟེ།",
    "མཚོན་དང་དུག་དང་མཐུས་ཀྱང་འཆི་བའི་རྐྱེན་བྱེད་པར་འདུག་འགྲོ་བ་གཞན་དག་དུག་སྦྲུལ་དང་སྟག་དང་རྟ་ལས་སོགས་པས་འཆི་བའི་རྐྱེན་བྱེད།",
    "རྩ་ཆད་པ་དང་མིད་པ་འགགས་པ་ལས་སོགས་པས་ཀྱང་འཆི་རྐྱེན་བྱེད་པར་འདུག་པས།",
    "ནམ་འཆི་ཆ་མི་འདུག་སྙམ་དུ་བསམ།",
    "གསུམ་པ་འཆི་ཚེ་ཅིས་ཀྱང་མི་སྡོང་པར་འདུག་པས།",
    "རང་འཆི་བའི་ཚེ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དམག་ཏུ་སྦྲན་ཀྱང་མི་སྡོང་བར་འདུག་ལུང་ཐམས་ཅད་གསེར་གཡུས་བཀང་ནས་བླུས་ཀྱང་མི་སྡོང་པར་འདུག་རྒྱལ་ཁམས་གླིང་བཞི་གཞན་དུ་བྲོས་ཀྱང་མི་སྡོང་བར་འདུག་པས།",
    "ཅིས་ཀྱང་མི་སྡོང་པར་འདུག་སྙམ་དུ་བསམ།",
    "བསམ་ཞིང་རང་རྒྱུད་ལ་འདྲེས་པར་བྱའོ།",
    "བདག་ཀྱང་བོན་ཅན་དེ་ལས་མ་འདས་པ་རུ་འདུག་གོ་སྙམ་དུ་བསམ།",
    "གྲོགས་ངེས་པ་མེད་པ་གང་འདུག་འདུག་ཟས་ངེས་པ་མེད་པ་གང་བྱུང་བྱུང་།",
    "བར་ན་འདུག་པ་ལ་བར་ཞེས་བྱ།",
    "ཤེས་པ་རྟེན་མེད་དོ་བོར་འདུག་པས་དོ་ཞེས་བྱ།",
    "ཆགས་སྡང་རང་སར་གྲོལ་ཞིང་ཐམས་ཅད་རང་དུ་ཤེས་པས་ཆོད་གསུངས་སོ།",
    "བསྟན་པ་བཞག་དུས་དཔྱིད་ཟླ་ར་བའི་ཉ་ཡིན་པས་ཀོང་རྩེ་འཕྲུལ་རྒྱལ་ཡིན་ནོ།",
    "སྲིད་པའི་བག་ཆགས་ཀྱི་བར་ན་འདུག་པས།",
    "གཞན་གྱིས་རང་ལ་ཁྲེལ་ཞིང་རང་རྨ་འབེབ།",
    "དེ་ག་ལྟར་བྱམས་པ་སྒོམ་བྱས་ཙ་ན་ཡང་ལོག་པར་སྨྲ།",
    "སྦྱིན་པ་བཏང་བྱས་ཙ་ན་སེར་སྣའི་གཏམ་ལོག་པར་སྨྲ།",
    "ཞི་བ་སྒོམ་བྱས་ཙ་ན་ང་རྒྱལ་གྱི་གཏམ་ལོག་པར།",
    "དཀའ་ཐུབ་དགོས་བྱས་ཙ་ན་ཡང་ལོག་པར་སྨྲ།",
    "ཙ་ཏྲ་སྤྱི་རིང་མི་འདུག་གམ་ཞེས་འདྲི་བར་བྱེད་དེ།",
    "འདུག་བྱས་པ་ཙམ་གྱིས་གནོད་མི་ནུས་པར་གྱུར་ཏོ།",
    "ཕྱི་མ་ཀུན་གྱིས་ཀྱང་གཤེན་འདི་ཉིད་དང་པོ་གསང་རིན་ཆོག་པ་དོན་དང་ལྡན་པ་ཞིག་འདུག་གོ་ཞེས།",
    "རྣག་ཁྲག་ཤིན་ཏུ་སྐྱུག་བྲོ་བ་འདུག་བྱས་པས།",
    "དེ་ཡི་གཉེན་པོ་ཕུང་པོ་ལྔ་ལ་བདག་ཅེས་བྱ་བ་ཕྱི་ན་འདུག་གམ།",
    "ནང་དང་བར་ན་འདུག་གམ་བལྟས་པས་མི་འདུག་པས།",
    "ཏིང་ངེ་འཛིན་རང་ཡང་རང་བཞིན་མེད་པར་ཤེས་པར་བྱ།",
    "འདུག་ས་སྤོས་ལ་བསྒོམ།",
    "རྟོག་པ་ཆུང་ལ་འདུག་པ་ཡུན་རིང་དུ་ཚུགས་ན་རྟགས་ཡིན་ནོ།",
    "གསུམ་པ་གཉིས་མེད་བཞི་པ་རང་བྱུང་རང་ཞི་ལྟར།",
    "བྲག་སྲིན་པོའི་འཕྲ་སྐས་ཅན་དུ་སྒོམ་གྱིན་ཡོད་ཙ་ན།",
    "བེ་རོ་ཙ་ནས་མཛད་པ་ལ་བེ་རོ་ཙ་ན་མ་ཞེས་པའམ།",
    "གཉིས་སྣང་རང་གྲོལ་རིག་པ་བོན་ཉིད་ཀྱི་ནམ་མཁའོ།",
    "ངོ་བོའི་ངོས་ནས་འགྱུར་མེད་དུ་ཡང་འདུག་རོལ་པའི་ངོས་ནས་ཁྲ་བོ་ཁྲ་སྟག་ཏུ་ཡང་འདུགདེ་ལ་དཔེ་རྣམ་པ་གསུམ་གྱིས་མཚོན་ཏེ།",
    "རང་རང་ཐོབ་བྱ་མངོན་གྱུར་ཏེ།",
    "དེས་སློབ་དཔོན་བེ་རོ་ཙ་ན་ལ་བཤད།",
    "ལྷ་མི་ནམ་མཁའ་འཕྲུལ་མཛོད་དྲང་ངེས་གཉིས་ཀྱི་གཞུང་དང་ཆ་ལགདང་རང་རྟོགས་སོ།",
    "བཞི་པ་ཡིན་ལུགས་གང་ལྟར་ཡང་དམིགས་སུ་མེད་པས་བོན་ཉིད་ཀྱི་ཀློང་རང་འབྱུང་དུ་བརྡོལ་བའི་དོན་བསྟན་པ་དང་།",
    "རང་རང་ཐོབ་བྱ་མངོན་གྱུར་ཏེ།",
    "བག་ཆགས་དེ་ལ་ཞེན་པས་ཀུན་འབྱུང་རང་ལ་ཤར།",
    "ཀུན་འབྱུང་རང་ལ་ཤར་བས་བདག་དང་གཞན་དུ་བཟུང་།",
    "དུ་བ་འདུག་པས་ཟེར་བ།",
    "གཉིས་ཀ་ཡང་རང་གྲོལ་ཏེ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་དང་།",
    "ཐམས་ཅད་རང་དུ་ཤར་ཅིང་རང་གྲོལ་བའི་དཔེ།",
    "ཅི་བྱས་ངོ་བསྲུང་དང་སྡུག་བསྔལ་ཞིག་ལས་མི་འདུག་པས།",
    "གནས་ཡུལ་མི་གསེབ་ཏུ་འདུག་ཀྱང་།",
    "ཅོ་ཟ་ནམ་མཁའ་ལ་ལྟོས་དང་སྤྲིན་རང་འབྱུང་རང་གྲོལ།",
    "ཅིར་སྣང་རང་སྣང་དུ་ཤར་བ་ཤེས་རབ་ཀྱི་ཡིད་གསུངས་སོ།",
    "སྣང་བ་རྣམས་ཀྱང་རང་སར་གྲོལ།",
    "ཀུན་ལ་སྨོད་ཅིང་རང་ཤེས་སྨྲ།",
    "ང་རང་གྲོལ་བ་ལ་ནི་སྣང་བ་གཟུང་ཡུལ་དུ་སྣང་བ་དང་།",
    "སྐྱེ་འགག་དུས་གསུམ་མཉམ་པ་ཉིད་དུ་རྒྱུན་ཆད་མེད་པར་གྲོལ་བའོ།",
    "བོན་ཉིད་ཀྱི་ཀློང་རང་འབྱུང་དུ་ཕྱེད་པའོ།",
    "གོ་ཚད་རྟོགས་ཚད་ཡིན་པས་བྱེར་མེད་གཅིག་ཏུ་འདུག་གོ།",
    "བོན་ཉིད་ཀྱི་ཀློང་ན་བློ་བདེ་འབོལ་ལེ་ལྷོད་དེ་ཤིག་གེར་འདུག་པ་ལ།",
    "འོད་དེ་རང་ཆས་དང་རང་སྣང་དུ་ཤེས་སོ།",
    "ཕྱེ་ནས་རང་རང་སོ་སོར་ལྡོག་སྟེ།",
    "ཀུན་ལ་སྨོད་ཅིང་རང་ཤེས་སྨྲ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་ཞུས་པ།",
    "འདུག་པ་ལས་སོགས་པ་ཅི་ཡང་གནས་པ་ཡིན་ནོ།",
    "བཞི་པ་ཡིན་ལུགས་གང་ལྟར་ཡང་དམིགས་སུ་མེད་པས་བོན་ཉིད་ཀྱི་ཀློང་རང་འབྱུང་དུ་བརྡོལ་བའི་དོན།",
    "མཚན་མའི་ཡུལ་དང་བྲལ་བས་བོན་ཉིད་ཀྱི་ཀློང་རང་འབྱུང་དུ་བརྡོལ་ལོ།",
    "ངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོ་གསུམ་སྟེ།",
    "རང་ཤར་རང་གྲོལ་གོང་མ་ལྟར་རང་རང་འཐད་སོར་གྲོལ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་གྲོལ་ཙ་ན་ལུས་ངག་ཡིད་གསུམ་གར་དགའ་ལ་གཉེན་པོས་བཅོས་སུ་མེད་པས།",
    "ཅིར་སྣང་ཅི་སྲིད་ཐམས་ཅད་རང་སྣང་རང་གྲོལ་གྱི་འབྲས་བུ་ཡིན་པས།",
    "མཐའ་གང་ཡང་མ་སྤངས་པར་གཅིག་ཏུ་འདུག་པ་འགྱུར་མེད་དུ་གྲོལ་བ་དང་བཞི།",
    "ཐོག་བབས་སུ་འདུག་པས་ཅར་ཕོག་ཏུ་གྲོལ་བ་དང་བདུན།",
    "གཞི་ཡེ་ནས་ཇི་ལྟར་གནས་པར་འདུག་ངེས་མེད་དུ་གནས་པར་ནམ་མཁའ་འཕྲུལ་མཛོད་དྲང་ངེས་གཉིས་ཀྱི་གཞུང་དང་ཆ་ལགའདུག་པས་ཡེ་ནས་ཕྱོགས་མེད་ཀྱི་ཀློང་དུ་གྲོལ་བ་དང་།",
    "གཞི་ཡེ་ནས་འཛིན་མེད་དུ་གནས་པར་འདུག་པས་ཡེ་ནས་རང་ཤར་བའི་ཀློང་དུ་གྲོལ་བ་དང་ཡོ་ལ་སྦྱར།",
    "གཞི་དབྱེར་མེད་དུ་གནས་པར་འདུག་པས།",
    "གཞི་ཇི་བཞིན་པ་ལྷུན་གྲུབ་ཏུ་གནས་པར་འདུག་པས་ཡེ་ནས་འགྱུར་མེད་དུ་གྲོལ་བ་དང་།",
    "གཞི་སྐྱེ་མེད་དུ་གནས་པར་འདུག་པས་ཡེ་ནས་རང་གྲོལ་དུ་གྲོལ་བ་དང་།",
    "གཞི་ཡེ་ཡིན་དུ་འདུག་པ་ལ་ཡེ་ནས་ཆིག་ཚོད་དུ་གྲོལ་བ་དང་།",
    "གཞི་ཐོག་བབས་སུ་གནས་པར་འདུག་པས་ཡེ་ནས་ཅར་ཕོག་ཏུ་གྲོལ་བ་དང་།",
    "གཞི་བྱ་བྲལ་དུ་གནས་པར་འདུག་པས་གཉིས་འཛིན་ལས་སོགས་པའི་བྱ་བཙལ་ཐམས་ཅད་དང་བྲལ་བའི་དབྱིངས་སུ་གྲོལ་བ་དང་དགུ་རུ་ཐམས་ཅད་འདུས་པ་ཡིན་དེ་ཡང་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ན་ལ་བླ་བོན་དྲན་པ་ནམ་མཁས་གསུངས་པ།",
    "ཤུགས་འབྱུང་རང་ཤར་སྤྱོད་པའི་དབྱིངས་ཆེན།",
    "དྲན་པ་ནམ་མཁའ་ང་རང་ཡིན།",
    "མེ་ཡོད་དེ་ཞེས་དམ་བཅའ་གཏན་ཚིགས་དུ་བ་འདུག་པ་ལས་སོགས་པ་དེས་ཅི་ལ་ཡང་མི་ཕན་ཏེ།",
    "ཇི་ལྟར་བྱས་ཀྱང་རང་ཤར་རང་གྲོལ་གྱི་དབྱིངས་ལས་ཡུལ་དང་ཡུལ་ཅན་དུ་མི་གནས་ཏེ།",
    "དཔེར་ན་རྫ་འབའ་ཞིག་འདུག་པ་རྫ་ཀླུང་ཟེར།",
    "ཆུ་འབའ་ཞིག་འདུག་པ་ཆུ་གླིང་ཟེར།",
    "བྱེ་མ་འབའ་ཞིག་འདུག་པ་བྱེ་ཀླུང་ཟེར་བའམ།",
    "གསེར་འབའ་ཞིག་འདུག་པ་ལ་གསེར་གླིང་ཟེར་བ་ལྟར།",
    "གཞན་གྱི་སེལ་མེད་པས་གོལ་ས་དང་རང་སར་དབྱེར་མེད་དོ།",
    "རྫོགས་པ་ཆེན་པོ་ཁྱད་པར་ཡང་རྩེའི་རྒྱན་ནམ་རོལ་པའམ་ཤར་ལུགས་སུ་འདུག་པས།",
    "སྒོམ་མེད་ཕྱོགས་གཅིག་པར་སོ་སོའི་སྐྱེ་བོ་མི་བསྒོམ་རང་ཁ་མར་འདུག་པས་གོ་ས་ཡང་ཤུགས་ཆོད་དོ།",
    "རྫོགས་པ་ཆེན་པོ་ཁྱད་པར་ཡང་རྩེའི་རྒྱན་ནམ་རོལ་པ་ཤར་ལུགས་སམ་གཡོས་སུ་འདུག་པས་ན།",
    "འདི་སྤྱོད་འདི་མི་སྤྱོད་བྱ་བ་མེད་དེ་ཤུགས་འབྱུང་རང་ཤར་གྱི་སྤྱོད་པ།",
    "གང་ལྟར་སྤྱོད་ཀྱང་རྫོགས་པ་ཆེན་པོ་ཁྱད་པར་ཡང་རྩེའི་སྤྱོད་པའི་རྒྱན་ནམ་རོལ་པའི་ཤར་ལུགས་སུ་འདུག་པས།",
