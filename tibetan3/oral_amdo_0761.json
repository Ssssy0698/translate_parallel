    "འོ་ན་བར་སྐབས་དེར་ལས་རང་གི་ངོ་བོ་ཡོད་པ་ཡིན་ནམ་ཞེ་ན།",
    "རྟག་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ཐ་སྙད་དུ་ཞིག་པ་དང་འགགས་པའི་དོན་ཐ་སྙད་པའི་བློ་ལ་དེ་ལྟར་སྣང་ཡང་གཏན་མེད་རྒྱུན་ཆད་དུ་མ་སོང་བ་ཡིན་ལ་རང་བཞིན་གྱིས་ཞིག་པ་དང་འགགས་པའི་དོན་སྔར་རང་བཞིན་གྱིས་ཡོད་པ་ཕྱིས་གཏན་མེད་དུ་སོང་བའོ།",
    "འདི་ནི་སྐད་ཅིག་ལ་སྦྱར་བའི་ཚེ་སྐད་ཅིག་སྔ་མ་ཕྱི་མའི་དུས་སུ་གཏན་མེད་དུ་སོང་བ་ཡིན་ལ།",
    "རྒྱུན་ལ་སྦྱར་བའི་ཚེ་རིགས་འདྲ་སྐྱེ་བ་གཏན་མེད་དུ་སོང་བའོ།",
    "མེད་པ་ཡང་མ་ཡིན་པ་བློར་མི་ཤོང་བ་དག་གིས་ནི་འདིའི་དོན་བསྐལ་པའི་བར་དུ་བཙལ་ཡང་མི་རྙེད་དེ།",
    "དེ་སྲིད་འཚོ་ཞེས་བརྗོད་མོད་ཀྱི།",
    "སྔོན་པོ་ལ་སོགས་པ་སྐྱེ་མཆེད་རེ་རེ་བའི་དངོས་པོ་དང་བུམ་པ་ལ་སོགས་པ་རང་གི་ཆ་ཤས་ཀྱི་དངོས་པོ་ཚོགས་པ་གང་ཡང་ཞིག་པ་དེའི་མཚན་གཞི་མི་རུང་བའི་ཕྱིར་དངོས་པོ་ནི་མིན་ནོ་སྙམ་པའོ།",
    "ལུགས་ཕྱི་མ་ལ་ནི་དཔེར་ན་ཉེར་སྦས་ཀྱི་ཕུང་པོ་ལྔར་རེ་རེ་བ་དང་ཚོགས་པ་གཉིས་ཀ་དང་།",
    "ཉེར་སྦས་ཀྱང་དེ་གསུམ་གྱི་མཚན་གཞི་མི་རུང་ཡང་རང་གི་ཕུང་པོ་ལ་བརྟེན་ནས་ཉེར་སྦས་སུ་བཏགས་པ་དངོས་པོ་ཡིན་པར་མི་འགལ་བ་བཞིན་དུ་ཞིག་པ་ཡང་ཞིག་རྒྱུའི་དངོས་པོ་དང་།",
    "རྟོགས་དགོས་པས་དགག་པ་ནི་ཡིན་ལ་མེད་དགག་ནི་མ་ཡིན་པས་མ་ཡིན་དགག་སྟེ།",
    "དངོས་པོ་རང་བཞིན་གྱིས་བསྒྲུབ་པར་འདོད་པའི་ཕྱོགས་ཐམས་ཅད་ལ་ཞིག་པ་དངོས་པོར་མི་རུང་ཞེས་པ་ནི་གཟིགས་རྒྱ་ཆུང་བ་སྟེ།",
    "ལེགས་པར་སོམས་ཤིག་ལུང་གི་སྒྲུབ་བྱེད་ལ།",
    "དེ་བཞིན་དུ་ཡན་ལག་བཅུ་གཉིས་པོ་རེ་རེ་ཞིང་སེམས་༡༡༨",
    "དངོས་པོ་ཡིན་ན་རང་གི་སྐད་ཅིག་སྔ་མ་དེ་ཞིག་པའི་ཞིག་པ་ཡིན་པས་ཁྱབ་པར་འགྱུར་ཏེ།",
    "རྒྱུས་བསྐྱེད་མི་སྐྱེད་ཀུན་ནས་མཚུངས་པ་ཅིས་ཀྱང་ཡིན་མོད།",
    "སྐད་ཅིག་མ་གཉིས་པར་མ་བསྡད་པ་རྣམས་ལ་དེ་གཉིས་མཚུངས་ན་ཧ་ཅང་ཐལ་ཏེ།",
    "འདིར་བཀོད་པའི་རྣམ་རྟོག་གི་བཟོ་རྒྱ་འདི་ཙམ་གྱིས་ངེས་འབྱུང་སྐྱེ་བའི་རྒྱུ་ཆོག་པར་སྣང་ངོ།",
    "གཉིས་པ་ལ་གཞན་སྐྱེ་ཡོད་པར་ཐལ་བ།",
    "མ་ཕྲད་པར་སྐྱེད་པ་ཡོད་པར་ཐལ་བ།",
    "ཞིག་པས་ནམ་མཁའ་གང་བར་ཐལ་བ།",
    "གཅིག་དང་ཐ་དད་བཏགས་པའི་ཉེས་པ་སྟེ་རེ་ཞིག་བརྒྱད་ལས་དང་པོ་ནི།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བས་ཀྱང་ཉོན་མོངས་སྤངས་པའི་འགོག་པ་དངོས་པོར་འདོད་ཀྱང་།",
    "བརྒྱད་དུ་འགྱུར་བ་སོགས་ཁྱོད་ཀྱི་ཞིག་པ་འདི་དག་གཟུགས་སུ་གྲུབ་ན་རྡུལ་ཕྲན་ཙམ་ལས་མེད་ཀྱང་།",
    "ངོ་བོ་ཉིད་སྐུ་དེ་འདུས་བྱས་ཡིན་པར་ཐལ།",
    "སྣུམ་ཟད་པ་དེ་མར་མེ་ཟད་པའི་རྒྱུ་ཡིན་པར་ཁྱོད་སྒྲུབས་ཤིགབདུན་པ་ནི།",
    "ཡོད་ན་ལས་གཅིག་གི་རྣམ་སྨིན་ཕྱུང་ཟིན་པའི་རྗེས་སུ་ཡང་།",
    "མེད་ན་རྣམ་སྨིན་ཕྱུང་ཟིན་པའི་ཚེ་ལས་མ་ཞིག་པར་ཐལ།",
    "ཁྱོད་ངོ་བོ་གཅིག་དང་ཐ་དད་གང་རུང་ཡིན་པར་ཐལ།",
    "ཁྱོད་ཀྱི་ངོ་བོ་གྲུབ་པའི་ཕྱིར།",
    "གོང་དུ་ཐལ་འགྱུར་བའི་ལུགས་ཀྱིས་ནི་ཐ་སྙད་གདགས་པ་ཙམ་གྱིས་མ་ཚིམ་པར་མྱུ་གུ་སྐྱེ་ཞེས་པ་ལྟ་བུ་ལ་དེ་ལྟར་བཏགས་པའི་བཏགས་དོན་བདག་གམ་གཞན་ལས་སྐྱེ་ཞེས་ཚོལ་བ་ན་དེ་ཁོ་ན་ཉིད་ལ་དཔྱོད་པར་འཇོག་གོ་ཞེས་ཁས་བླངས་པ་དང་འགལ་ཏེ།",
    "རྗེས་འཇུག་རྣམས་ཀྱིས་གསུངས་རབ་ཚད་ལྡན་དང་བསྒྲིགས་ནས་བརྟག་དཔྱད་རེ་ཅིས་ཀྱང་གྱིས།",
    "གཉིས་པ་དེ་ལ་ཧ་ཅང་ཐལ་བ་རྣམ་གཉིས་སྤོང་བ་ལ་གཉིས་ཏེ།",
    "རྣམ་སྨིན་ཐུག་པ་མེད་པར་ཐལ་བ་སྤང་།",
    "རྣམ་སྨིན་ངེས་པ་མེད་པར་ཐལ་བ་སྤང་པའོ།",
    "ཆེས་ཐོག་མར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་བསྟན་པ་ནི་མུ་སྟེགས་ཀྱི་ལུགས་བསལ་ནས་དེ་དག་གི་དོན་ཆེན་པོ་འདྲེན་པར་འགྱུར་ཞིང་།",
    "ནང་གི་ཤེས་པ་གཉིས་ཡོད་མེད་མཚུངས་པར་གསུངས་ལ་གཞུང་འདིར་ཡང་དོན་ཤེས་གཉིས་དོན་དམ་དུ་མེད་མཉམ་དང་།",
    "འོ་ན་སེམས་ཁས་མི་ལེན་པར་ཐལ།",
    "མིན་ན་གཟུགས་སྒྲ་སོགས་སྣང་བ་ཙམ་ལ་ཕྱི་རོལ་གྱི་དོན་ཅེས་བཏགས་པའི་བཏགས་དོན་བཙལ་བའི་ཚེ་ཐ་སྙད་དུ་རྙེད་པར་ཐལ།",
    "ཐ་སྙད་དུ་ཡང་མེད་པར་ཐལ་བ་ལས།",
    "རི་བོང་རྭའི་ཁྲེས་པོ་རུས་སྦལ་གྱི་སྤུའི་ཐག་པས་བསྡམས་ནས་མོ་གཤམ་གྱི་བུ་བར་པས་ཁུར་བ་ཞིག་ཡིན་ནམ་ཅི།",
    "དྲུང་ཙོང་བ་ན་རེ།",
    "ཡུལ་ཅན་ལ་ཡང་ལོག་ངེས་པར་ཕྱེ་བའི་སློབ་དཔོན་འདིའི་ལུགས་ཐུན་མོང་མ་ཡིན་པ་མ་རྟོགས་པ་སྟེ།",
    "དེ་ལས་ཀྱང་ཁྱོད་བློ་གྲོས་ཀྱི་༡༣༦",
    "ཞེས་གསུངས་པའི་དོན་སློབ་དཔོན་ལེགས་ལྡན་འབྱེད་ཀྱིས་སྔར་གྱི་དཔེ་མ་གྲུབ་པའི་ལན་མཛད་པ་ནི་རྨི་ལམ་གྱི་གཟུགས་དེ་ལེགས་ལྡན་གྱི་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པ་ཞལ་གྱིས་བཞེས་པར་གསལ་བས།",
    "རྨི་ལམ་གྱི་གླང་པོ་ཆེའི་གཟུགས་ཐ་མལ་པ་དངོས་པོ་ཐམས་ཅད་བདེན་པར་བཟུང་བ་དག་གིས་ཀྱང་མི་བདེན་པའི་ཐ་སྙད་བྱས་ན།",
    "ལེགས་ལྡན་འབྱེད་དེ་ལས་ཀྱང་ལོད་པར་ཐལ་བའི་ཕྱིར་རོ། ༡༣༧",
    "ཡུལ་མེད་ཤེས་པ་སྐྱེ་ན་ཧ་ཅང་ཐལ།",
    "ཧ་ཅང་ཐལ་བ་དགོད།",
    "དེ་གསུམ་གང་རུང་དུ་ཡོད་མེད་ཀྱི་ཁྱད་པར་ཡོད་ན་ཧ་ཅང་ཐལ་བ་འགོད་པའོ།",
