    "དགག་བྱའི་སྒོ་ནས་འབྱེད་པ་མ་ཡིན་ནོ་ཞེས་གྲགས་པའི་རྔ་སྒྲ་ཕྱོགས་བཅུར་སྒྲོག་པ་དེ་ཉིད་ཀྱིས་རང་ཉིད་གང་དུ་འདུག་པའི་ཚུགས་མ་ཐུབ་ལ།",
    "ཞེས་གསུངས་པ་དེས་ཀྱང་རང་རྒྱུད་ཀྱི་ཕུང་པོ་ཁོ་ན་ངར་འཛིན་གྱི་དམིགས་པར་བསྟན་པ་ཡིན་ཏེ།",
    "དངོས་པོར་སྨྲ་བ་རྣམས་ཀྱིས་ཀྱང་རང་རང་འདོད་པའི་དོན་དམ་བདེན་པ་དེ་དག་བདེན་མེད་དུ་རྟོགས་པར་པཎ་ཆེན་ཤཱཀ་མཆོག་བཀའ་འབུམ་བ་འགྱུར་ཏེ།",
    "ཡུལ་དུས་གྲུབ་པའི་མཐའ་གང་ན་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་ནམ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་པའི་རྟོག་པ་ལྷན་སྐྱེས་ཀྱིས་གཞན་སྐྱེ་ཁས་བླངས་ཀྱང་རང་ལུགས་ཀྱི་ཀུན་རྫོབ་བདེན་པ་ལ་རིགས་པས་དཔྱད་པའི་ཉེས་པ་མེད་པ།",
    "དེ་སྐད་དུ་ཡང་རང་བཞིན་དག་ནི་བཅོས་མིན་དག།",
    "དེའི་ཤེས་བྱེད་ཀྱང་རང་བཞིན་གྱི་སྐྱེ་བ་བཀག་ཤུལ་དུ།",
    "བདེན་མེད་དེ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་པར་སྒྲུབ་བྱེད་ཀྱི་རིགས་པ་ཕྱི་མ་དེས་ཀྱང་།",
    "ཞེས་དང་རང་བཞིན་གཞན་དུ་འགྱུར་བ་ནི།",
    "དེ་ཡང་རང་བཞིན་བརྟག་པའི་རབ་ཏུ་བྱེད་པ་འདིར་ནི་སྟོང་པ་ཉིད་བདེན་གྲུབ་བཀག་པ་མ་ཡིན་གྱི་འོ་ན་ཅི་ཞེ་ན།",
    "ཞེས་སོགས་ཀྱི་རིགས་པས་དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་བཀག་པ་དེའི་ཚེ་ཆད་པའི་ལྟ་བར་མི་འགྱུར་བ་ཅི་ཞེ་ན།",
    "འཇིག་རྟེན་གྱི་རྟོག་པ་ལྷན་སྐྱེས་ལ་ཇི་ལྟར་གྲགས་པའི་དོན་དེ་ཉིད་གནས་སྐབས་སུ་ཁས་བླངས་ཀྱང་རང་ལུགས་སུ་མི་འགྲུབ་པ་བཞིན་ནོ།",
    "སྤྱིར་ཡང་རང་མཚན་ཞིག་པར་ཁས་བླངས་པ་ལ་ཆད་པའི་མཐར་མི་འདོད་ལ།",
    "སླར་ཡང་འདི་སྐད་ཅེས་བྱ་སྟེ་སེམས་ཙམ་པ་དང་རང་རྒྱལ་ལ།",
    "དེའི་ཕྱིར་ས་སྨྱུག་གཅིག་དང་ཐ་དད་གང་དུ་ཡང་རང་ལུགས་ལ་ཁས་བླང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "རང་རང་ལས་གཞན་དེ་ལྷག་པར་ཁས་མི་ལེན་ཏེ།",
    "གནས་ལུགས་དང་རང་བཞིན་ལ་སོགས་པའི་ལྡོག་པ་ནས་ནི།",
    "རྟའི་མགོ་ལ་ཡོད་བརྟགས་པ་ན་ང་བདུན་དེ་གཉིས་ཀ་ལ་མི་འདུག་པར་མཐོང་བ་དེ་རཱ་མ་མཐོང་བ་ཡིན་པར་འདོད་པ་དང་ཁྱད་པར་མེད་དོ།",
    "ཁ་ཅིག་སེམས་དེ་དབྱིབས་དང་ཁ་དོག་ཏུ་འདུག་བརྟགས་པས།",
    "མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "ཅེས་བཙལ་བས་དེ་དག་གང་ན་ཡང་འདུག་པ་མ་རྙེད་པའི་ཚེ།",
    "ང་ལུས་ཀྱི་སྟོད་སྨད་དང་ཕྱི་ནང་བར་གསུམ་འདི་འདྲ་གཅིག་ན་འདུག་ཅེས་མ་རྙེད་ཀྱང་།",
    "ང་ཡོད་ན་ཁོ་རང་གང་ལ་འདོགས་པའི་གདགས་གཞིའི་གསེབ་ན་ཡོད་མི་དགོས་པའི་ཕྱིར་དང་།",
    "དེ་བཞིན་དུ་ངའི་པཎ་ཆེན་ཤཱཀ་མཆོག་བཀའ་འབུམ་ཁ་དོག་ཇི་ལྟ་བུ་ཞིག་འདུག་ཅེས་དཔྱོད་པ་ཡང་ལྟར་སྣང་འབའ་ཞིག་ཡིན་ཏེ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "དོན་དམ་པའི་བདེན་པ་ཡང་རང་སྟོང་དུ་བཞག་དགོས་ཏེ།",
    "བ་ལང་རང་མཚན་ལ་མི་སླུ་བའི་རིག་པ་ལྟ་བུའོ།",
    "དེ་ལྟ་བུའི་གནས་གྱུར་གྱི་ཡེ་ཤེས་དེ་ཡང་རང་༧ རིག་པའི་ཡེ་ཤེས་ཁོ་ན་ཡིན་གྱི།",
    "དེ་གཅིག་ཏུ་དབེན་པར་འདུག་སྟེ།",
    "ཚོགས་པ་རྙེད་ནས་དབེན་པའི་གནས་སུ་སྤྱོད་ལམ་ཇི་ལྟ་བུས་འདུག་པ།",
    "ལམ་བྲལ་གཞན་དང་རང་རིག་རྣམ་དཔྱོད་ཀྱང་།",
    "རྒྱལ་པོ་བཏང་སྙོམས་འདུག་ཅིང་བློན་པོ་ཀུན་བྱེད་ལྟར།",
    "གཞན་ཡང་བེ་རོ་ཙ་ན་དང་།",
    "བཎྜི་ཏ་ཤྲྰི་སིདྷ་དང་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་སིངྒ་ཁའི་ཡི་གེཁས་བསྒྱུར་བ་ལས།",
    "མཚུར་སྟོན་རིན་རྡོར་ཁེང་རང་དང་།",
    "རབ་གནག་དུས་ཐ་མའི་ཆོ་ག།",
    "མཁའ་འགྲོ་ཕྱོགས་སྐྱོང་རང་གནས་སུ་གཤེགས་སུ་གསོལ།",
    "བཆང་བའི་དམ་ཚིག་དུས་རྟག་ཏུ་གཉིས་མེད་ཀྱི་དོན་ལ་གནས་བར་བྱེད་ག་བསྲུང་བའི་དམ་ཚིག་གང་ཤར་ཡེ་ཤེས་ལྔ་ལས་མི་འདའ་བར་བསྒོམ་བ་རྣམས་ས།",
    "ཡཀྵེ་ཡ་ཙ་ནི་ར་མ་བ",
    "གུ་གུལ་གྱིས་འདུག།",
    "རྒྱུན་དང་རང་བཞིན་ལྟ་བ་འརྗོད་མེད་དོན་རྟོགས་པ་དང་།",
    "འཁྲུལ་སེམས་ངན་པར་འདུག་པ་སྟེ།",
    "ཨ་ཀྲོ་བཅུ་གཅིག་པ་འདི་ལྷ་བསྐྱེད་པའི་སྔགས་ཡིན་པར་གཤིན་རྗེ་དམར་ནག་འབར་བའི་དམ་རྒྱུད་དུ་གསུངས་འདུག་གོ།",
    "མཚོན་ཆའི་ཆར་འདེབས་ཤིང་རང་གཤེད་རང་ལ་དབབ་བའི་ལས་བྱས།",
    "བྱད་པ་ལྷ་སྲུང་རང་གཤེད་རང་ལ་ཡོབ།",
    "བྱད་མ་ལྷ་སྲུང་རང་གཤེད་རང་ལ་ཡོག།",
    "རང་ཉིད་སྟན་བདེ་བར་འདུག་ལ།",
    "ལོ་ཟླ་ཞག་དུས་ཕ་མ་སྤར་སྨེ་བདུན་ཟུར་དགྲ་གཤེད་སྐག།",
    "ཁྱེད་རང་ཡང་ནི་དེ་ཡི་ག།",
    "ཐུགས་རྗེའི་གཟི་ལྡན་གདུག་བ་ཐབས་ཀྱིས་འདུག་",
    "ཨེ་ཨ་ར་བ་ཙ་ནས་མ་ཡ་ཏིཥྛ་བཛྲ།",
    "སུམ་དྲི་ཞིམ་པོས་བྱུགས་ལ་གོས་རྒྱན་དཀར་པོ་དང་ལྡན་པས་ཀུ་ཤའི་ཁྲི་ལ་པདྨའི་འདུག་སྟངས་ཞེས་པ།",
    "གོས་སེར་པོ་དང་འཅས་ལས་ཁྲི་མཐོན་པོ་ལ་བཟང་པོའི་འདུག་སྟངས་ཞེས་པ།",
    "ཏིང་ལོ་འདི་ལམ་སྒྲོན་གྱིས་ལ་གནས་འདིར་མ་འདུག་པར་ད་ལྟ་ཉིད་དུ་ཕྱིར་དེངས་ཤིག།",
