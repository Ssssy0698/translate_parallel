    "དེ་ཏིང་སྐབས་དྲུང་ན་འདུག་པའི་མི་ལ་དམིགས་པ་གཏད་ནས་འགའ་སྟེ་གཅིག་གཉིས་གསུམ་ཙམ་གྱི་སེམས་ཤེས་པ་དང་།",
    "མཐར་འོད་ཕུང་དེ་ཉིད་ཕྱོགས་བཅུའི་སྟོང་ཁམས་ཐམས་ཅད་ལ་ཁྱབ་པར་བརྡལ་ཏེ་སྤྱོད་ཡུལ་ཐམས་ཅད་འོད་ཕུང་དུ་བསམ་ཞིང་སྟོང་པའི་ངང་ལ་འདུག་གོ།",
    "ཡས་བགྲངས་གསུམ་པའི་དོན་དུ་གདའ་འོ།",
    "དང་པོ་བློ་རབ་ལ་རང་བྱུང་རང་ཤར་དུ་གྲོལ་བ།",
    "དུས་དང་རང་བཞིན་འཁྲུལ་པ་དང་།",
    "རང་དང་ལྷན་ཅིག་ཏུ་དྲུང་ན་འདུག་པའི་གང་ཟག་ཕ་རོལ་པོ་དེ་ཡི་སེམས་ལ་དམིགས་གཏད་ཏིང་འཛིན་ལ་བཞག་པ་ཙམ་གྱིས།",
    "འགྲོ་ཉལ་འདུག་སྡོད་སྤྱོད་ལམ་བཞི་རྣལ་དུ་མ་འབྱོར་བའི་སྐྱོན་རྣམས་དོར་ཞིང་གཏང་བར་བྱ་བའོ།",
    "འདུག་ཅིང་སྡོད་པ།",
    "སྐྱོན་འདུག་པ་དེ་བས་ལྷའི་བསྒོམ་བཟླས་ལ་བར་ཆད་ཅིང་བརྩོན་འགྲུས་མེད་པར་གྱུར་ན་དཔེར་ན་ས་བོན་མེས་ཚིག་པ་བཏབ་པ་ལས།",
    "ཡས་བགྲངས་པའི་ལྔ་པའི་དོན་དུ་གདའ་འོ།",
    "བདག་གཞན་གྱི་ནང་ནས་དམ་པར་འདུག་པ་མཐོང་བའམ།",
    "ནམ་མཁའ་ལ་ས་ལ་བྱེད་པ་བཞིན་དུ་འཕུར་ནས་འགྲོ་ཞིང་འདུག་ནུས་པ་དང་།",
    "གཉིས་པ་མཚན་མའི་སྐྱོན་བཅོས་ཐབས་དཔེ་དང་བཅས་སྨིག་རྒྱུ་ལ་སོགས་ལྔ་མཚན་མ་ཅི་བྱུང་རང་རིག་པའི་ཆོ་འཕྲུལ་དུ་སྣང་བ་ཡིན་པས།",
    "འགྲོ་བ་དང་འདུག་པ་དང་ཉལ་བ་ལ་སོགས་པའི་ཚེ་ན།",
    "འདིར་ཡས་བསྒྲངས་དྲུག་པའི་དོན་དུ་གདའ་འོ།",
    "རིན་ཆེན་སྣ་ཚོགས་ཀྱི་རྒྱན་མཛེས་པར་སྤྲས་པའི་སྒྲུབ་གནས་གཞལ་ཡས་ཁང་དང་རང་ཉམས་དགའ་ཞིང་ཡིད་དུ་འོང་བར་བྱ་བ་ཤིན་ཏུ་གཅེས་སོ།",
    "འདོད་ཡོན་ལྟ་རུ་གསལ་བ་མ་འགགས་པ་ཐབས་དང་རང་བཞིན་མེད་པའི་ཤེས་རབ་ཀྱི་ཚུལ་དུ་གནས་པ་སྤྱད་པས།",
    "འབྲུའི་འདུག་ས་བསྒྱུར།",
    "དངོས་གྲུབ་གཉིས་སྒྲུབ་པའི་དོན་དུ་སྦྱོར་བ་དང་སྒྲོལ་བའི་བྱ་བ་ཀུན་བྱས་ཀྱང་རང་མཚན་ལྟར་བྱས་པའི་དྲི་མ་རྡུལ་ཕྲ་རབ་ཀྱི་ཆ་ཤས་ཙམ་ཡང་བྱས་པ་མེད་པས་ན།",
    "འགྲོ་ཉལ་འདུག་སྡོད་ལ་སོགས་སྤྱོད་ལམ་བཞི་པོ་ཐམས་ཅད་དུ།",
    "ཡས་བགྲངས་བདུན་པའི་དོན་དུ་གདའ་འོ།",
    "མི་འདུལ་ན་འདུག་པར་ཡང་བྱེད་དོ།",
    "དེ་དག་ལས་གཞན་པ་ཡང་རང་ཉིད་ཀྱི་ཡོད་ལ་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་འགྲུབ་སྟེ་གང་ཞེ་ན།",
    "ལྷ་ཀླུ་ལ་སོགས་རང་རང་དང་མཐུན་པ་སྣ་ཚོགས་པའི་ལུས་ཅན་དམ་པའི་རིགས་ཅན་ལྔ་ལ་། སོགས་པ་རྣམས་ལ།",
    "ཡས་བགྲངས་བརྒྱད་པའི་དོན་དུ་གདའ་འོ།",
    "ཉན་ཐོས་འགོག་པའི་སྙོམས་འཇུག་དང་རང་རྒྱལ་ཞི་བ་ཕྱོགས་གཅིག་པའི་བདེ་བ་དང་།",
    "གདུལ་བྱ་རྣམས་རང་རང་སོ་སོས་ཇི་ལྟར་དོན་གོ་བ་དང་།",
    "སྣ་ཚོགས་བའི་འོད་ཟེར་ཕྱོགས་བཅུར་འཕྲོ་བའི་སྣང་བས་ཁྱབ་ཅིང་རང་བཞིན་གསལ་བར་བྱེད་པའོ།",
    "ཡོ་ག་མ་ཧཱ་དང་རང་ས་བཞིའི་རྒྱལ་བ་ཀུན་ཏུ་འོད།",
    "གཉིས་ཀ་སྤྱོད་པ་ཨུ་པ་ཡའི་རྒྱུད་ལ་སོགས་པར་རང་རང་སོ་སོའི་གཞུང་ལས་ཇི་ལྟར་གྲགས་པ་བཞིན་དུ་གཤེགས་པ་ཡིན་ནོ།",
    "ཀྲྀ་ཡས་རྡོ་རྗེ་འཛིན་པའི་ས་མངོན་དུ་བྱས་ཙ་ན།",
    "ཡོ་གས་སྟུག་པོ་བཀོད་པའི་ས་མངོན་དུ་བྱས་ཙ་ན།",
    "ཀྲྀ་ཡས་རྡོ་རྗེ་འཛིན་པའི་ས་མངོན་དུ་བྱས་ཙ་ན།",
    "ཡོ་གས་སྟུག་པོ་བཀོད་པའི་ས་མངོན་དུ་བྱས་ཙ་ན།",
    "མ་ཧཱ་ཡོ་གས་པདྨ་སྤྱན་གྱིས་མངོན་དུ་བྱས་ཙ་ན།",
    "ཡས་བགྲངས་དགུ་པའི་དོན་དུ་གདའ་འོ།",
    "བྲམ་ཟེ་ལྐོག་ནག་ཅེས་བྱ་བ་ཞིག་དང་དུས་བཏབ་བྱས་ཤིང་དུས་བཅག་པ་ལས་ཁོས་བེར་རྒས་བརྡུང་ཙ་ན།",
    "དེའི་མཆོད་གནས་ཤིག་འདུག་པ་དེས།",
    "ངས་མ་སྦྱིན་པ་ལེན་པ་སྤང་བ་ཡིན་ཟེར་ཞིང་གཞན་ལ་མེ་བསླང་ཙ་ན།",
    "ནེ་ཚོ་ཁ་ན་གཤོག་པའི་སྒྲོ་བཅུག་ནས་ཆུ་འཐུང་ཞིང་འདུག་པ་མཐོང་བ་ལས།",
    "ཆུ་ལ་སྲོག་ཆགས་འདུག་པ་ཤི་ཡིས་དོགས་པ་ཡིན་ཟེར།",
    "མི་མི་འདུག་ཚེ་ན་སྲོག་ཆགས་མཐོང་ཚད་བཏུ་ཞིང་ཟ་བ་མཐོང་།",
    "བུ་ལ་ནུ་མ་བླུད་ཙ་ན།",
    "དྲིའི་བྱུག་པའི་རྫས་དག་ཀྱང་རང་བཞིན་གྱི་ངོ་བོར་སྣང་བ་དང་།",
    "ཕྱོགས་གང་ཐད་ནས་ཉམས་མྱོང་མེད་པས་ང་རང་གཙོ་སྒྲིག་པར་གདན་ཞུ་བྱས་པ་ཡིན་ཟེར་ནས་ཅུང་ཟད་ཚད་གཞི་ལས་བརྒལ་བའི་བརྩི་མཐོང་གནང་བྱུང་།",
    "ང་རང་ལོ་ངོ་ཉི་ཤུའི་ཡར་སྔོན་ནས་ལྷུག་རྩོམ་ལ་འཇུག་མཁན་ཞིག་ཡིན་པའི་ཆ་ནས།",
    "འཇིག་རྟེན་བྱེད་པོ་གཤེགས་མི་འདུག་གཤེགས་ལ་ཁད་དུ་འདུགཉིན་འདི་གའི་སེམས་གཏམ།",
    "གསར་འགྲོག་ཆེ་ཞིང་རང་ཚུགས་མི་བརྟན་པའི་སྐྱེ་བོ་དེ་ཚོ་དང་།",
    "དེ་སྔའི་འགྲོ་རོགས་དང་འདུག་རོགས།",
    "བཞིན་པ་མཐོང་འདུག་ལ།",
    "གལ་སྲིད་ཁྱེད་རང་ཡུད་ཙམ་རིང་མངོན་སུམ་གྱི་རྩིས་ཁྲར་བྱོལ་ཏེ་ཆང་ཁང་དེའི་ཟུར་ཅིག་ཏུ་བསྡད་ཚེ།",
    "གོ་ལ་འདིར་ཁེར་རྐྱང་དུ་སྡོད་པའི་སེམས་པ་རྣམས་ཀྱང་རང་སར་གྲོལ་འགྲོ་བ་འདྲ།",
    "ཞིབ་ཏུ་བསམ་ན་འཇིག་རྟེན་གྱི་མྱོང་བ་དང་མི་ཚེའི་གོ་རྟོགས་ཀྱི་ཕྱོགས་ནས་ངེད་ཅག་ནི་འབྲོག་ཕྱོགས་ཀྱི་ཕ་མ་སྤུན་མཆེད་དེ་ཚོ་ལ་དོ་བར་མི་འདུག་ཅེས་སྨྲས་པ་ཡིན།",
    "སྤྱིར་བཏང་རང་ཉིད་སྤྱང་པོར་རློམ་པར་གོམས་པའི་ངེད་ཅག་ངེད་ཅག་དངོས་གནས་སྤང་པོ་ཡོད་དམ།",
    "གསར་གཏོད་སོགས་ཐ་སྙད་དེ་དག་ལ་འབྲེལ་བ་མེད་པ་ལྟ་བུ་ཞིག་ཏུ་སྒྱུར་གྱིན་འདུག་པ་དང་།",
    "ང་རང་ལ་མཚོན་ན།",
    "དེ་ལྟར་ང་རང་ངག་རྩོམ་གྱི་ནགས་ཁྲོད་དུ་འཁྱམ་བཞིན་པའི་སྒང་ལ་གཉེན་ཉེ་ཚོས་ང་ལ་འཕྲུལ་འཁོར་གྱི་རྩེད་ཆས་སྣ་ཚོགས་ཉོས་ཡོང་བ་དང་།"
  ]
