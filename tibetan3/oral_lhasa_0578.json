    "མི་ཁོ་བོའི་བསུ་མར་ལོས་ཀྱང་ཕེབས།",
    "གང་བྱས་ཀྱང་གཞན་ལ་ཕན་པར་དཀའ།",
    "བར་ཆད་མེད་པར་ཐུགས་རྗེས་ཟུང་།",
    "ལར་རང་མཐོང་དང་ང་རྒྱལ་མ་ལགས་ཏེ།",
    "བསྟན་པར་ཟད་ཀྱི་གཉུག་མའི་རང་བཞིན་ལ།",
    "མེད་པའི་གནས་ལུགས་ལྐོག་ཏུ་མ་གྱུར་པར།",
    "བློས་བྱས་ལྟ་སྒོམ་རྫུན་ཕུགས་རྡིབ་པ་ཡིན།",
    "གོ་ཡུལ་ཉམས་ཀྱི་ཤུན་པ་ཟད་པ་ལགས།",
    "ཡིན་རློམ་གྱི་སྟོང་འུད་བྱས་ཀྱང་བྱས།",
    "བློས་བྱས་ཀྱི་ལྟ་སྒོམ་ཡས་ལ་བོར།",
    "བསླུ་བྲིད་ཀྱི་བདུད་དུ་ཆེ་ལགས་ཀྱང་།",
    "སྒོམ་བློས་བྱས་དང་ཡིད་དཔྱོད་ལ་ནོར་དུ་འཛིན།",
    "རྗེ་མཁྱེན་བརྩེ་ནུས་ལྡན་སྤྲུལ་པའི་སྐུ།",
    "ཞེས་ཀྱང་སྣང་བ་ཅུང་ཞིག་འུར་ལངས་ཏེ་ཞེ་དམ་བཅས་པ་ལགས། ། ཀློང་རྡོལ་རྟོགས་པའི་སྐྱིད་གླུ།",
    "སྤྱི་གཙུག་འཁོར་ལོའི་རྒྱན་དུ་བཞུགས།",
    "འདུ་འབྲལ་མེད་པར་ཐུགས་རྗེས་ཟུང་།",
    "གང་ལྟར་བྱས་ཀྱང་ཆོག་པར་བྱུང་།",
    "བློས་བྱས་ཐམས་ཅད་ཕྱམ་མེར་གྲོལ།",
    "གཅིག་གཉིས་གསུམ་བྱས་ནས།",
    "གསུམ་དྲུག་དགུ་བྱས་ནས།",
    "གང་ལྟར་བྱས་ཀྱང་རྒྱ་ཁྲོལ་ཁྲོལ།",
    "ཞེས་ཀྱང་ཉམས་མཚར་དུ་སྨྲས་ཏེ་སྐྱིད་པའི་མལ་དུ་གུ་ཡངས་ཤིང་བློ་བདེ་བ་ལགས་སོ། ། གང་ཤར་རིག་པའི་རྩེད་འཇོ།",
    "སེམས་གཉུག་མའི་རང་ཞལ་རྗེན་པར་མཐོང་།",
    "ཀུན་རྟོག་ཤར་གྲོལ་གྱི་བཞུགས་ཚུལ་འདི།",
    "སྤང་གཉེན་རིས་མེད་ཆེན་པོ་ལགས།",
    "གང་ལྟར་བྱས་ཀྱང་ཆོག་པ་བྱུང་།",
    "ཡན་པ་བློ་བདེའི་བུ་རྒྱུད་ལགས།",
    "བློས་བྱས་ལྟ་བསྒོམ་གོག་པོས་རྒྱས་འདེབས་དེས་ཅི་བྱ།",
    "ཁྱབ་གདལ་ཕྱོགས་རིས་བྲལ་བ་མཉམ་ཉིད་ཀྱི་བཞུགས་ཚུལ།",
    "གཅིག་གཉིས་གསུམ་བྱས་ནས།",
    "གསུམ་དྲུག་དགུ་བྱས་ནས།",
    "བློས་བྱས་ཀྱི་གཏད་སོ་འབྲལ་མ་མྱོང་།",
    "ཡིད་དཔྱོད་བློས་བྱས་ཀྱི་གཏད་འཛིན་ཞིག།",
    "རང་ཆས་ལྷུན་གྱིས་རྫོགས་པ་ལགས།",
    "ཡོན་ཏན་མགོན་པོ་གཉིས་མེད་གསུངས།",
    "ཆེ་བ་ཡོད་ཅེས་དབུགས་དབྱུང་གནང་།",
    "གསུང་ཅི་གནང་སྒྲུབ་པའི་དམ་བཅའ་ཞུས།",
    "དྲན་འཛིན་དང་དམིགས་གཏད་རིག་པར་དག།",
    "སྔོན་ཆད་བློས་བྱས་ཀྱི་གོ་ཡུལ་ཙམ།",
    "གནས་འབྱམས་ལུང་མ་བསྟན་གྱི་འདྲ་ཅོག་ནི་མ་ལགས།",
    "མཁའ་ཁྱབ་གདུལ་བྱའི་དོན་ཀུན་རྫོགས་པར་ཡང་ཤོག་ཅིག། ། ཀློང་གྲོལ་བྱར་མེད་རྒྱལ་པོའི་མཚར་གླུ།",
    "དུས་རྟག་པར་སྤྱི་བོའི་རྒྱན་དུ་བཞུགས།",
    "ཡང་ཡང་དུ་བསྐུལ་མ་གནང་བ་ལས།",
    "གང་ཤར་ལྷུག་པར་བརྗོད་པ་ལགས།",
    "བཅོས་མའི་ལྟ་སྒོམ་སྒྲིན་པོ་བློས་བྱས་ཀྱི་འཆིང་བ།",
    "ངོ་བོ་ཉིད་ཀྱི་བཞུགས་ཚུལ་རྩོལ་སྒྲུབ་དང་བྲལ་བ།",
    "ཡོད་དང་མེད་པའི་སྤྲོས་པ་ཀུན་བྲལ་འདུས་མ་བྱས།",
    "སོ་སོར་རང་རིག་རྣམ་པར་མི་རྟོག་ལྷུན་གྱིས་གྲུབ།",
    "རང་བཞག་ཡེ་བབས་བསལ་བཞག་བྲལ་བ་ལགས།",
    "ཡིན་ལུགས་གཤིས་ལ་བཙན་ས་ཟིན་པ་ལགས།",
    "རྟག་ཏུ་མི་འགྱུར་སྤྲོས་དང་བྲལ་བ་ལགས།",
    "ཕ་མཁྱེན་བརྩེའི་ནུས་ལྡན་སྤྲུལ་བའི་སྐུ།",
    "ཡེ་གྲོལ་མཁའ་མཉམ་དག་པར་གྲོལ།",
    "གང་ཤར་ལྷུག་པར་བརྗོད་པ་འདི།",
    "སྤྱི་གཙུག་འཁོར་ལོའི་རྒྱན་དུ་བཞུགས།"
  ]
}