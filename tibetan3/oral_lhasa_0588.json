    "གཏན་ཚིགས་བརྒལ་ལན་སྒྲོ་འདོགས་གཅོད་པར་བྱེད།",
    "དང་པོ་རྒྱུད་ཀྱི་རྣམ་གྲངས་བཅོ་བརྒྱད་དུ་གསུངས་པ་ལ།",
    "ད་ནི་རྒྱུད་ཀྱི་དོན་ལ་འཇུག་པར་བྱ་སྟེ།",
    "ཐམས་ཅད་བདག་ཉིད་རྟག་ཏུ་བཞུགས།",
    "ཞབས་སུ་ཡི་རང་ཞིང་བསྟོད་པ་ཐོགས་ཤིག་ཅེས་གསུངས་པ་ལ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་དགོངས་མཛད་རྒྱ་ཆེར་སློབ་པའི་རིམ་པ་རྩ་བའི་རྒྱུད་རྟོག་པ་བཞི་བཅུ་རྩ་གཉིས་པར་རྒྱས་པར་གསུངས་པ་དང་།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ཆེན་པོའི་རང་བཞིན་དུ་རྟག་ཏུ་བཞུགས་ཏེ།",
    "འོ་ན་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་དངོས་པོ་དང་ཁྱད་པར་མེད་པས་ལོགས་སུ་གཞག་མི་དགོས་སོ་ཞེ་ན།",
    "ཕྲིན་ལས་རྒྱ་ཆེན་པོའི་སྒོ་ནས་གཞན་ལས་ཁྱད་པར་དུ་གྱུར་བ་དང་།",
    "དེ་ཉིད་ལས་མི་གཞན་པར་འཕྲུལ་བ་དང་།",
    "ཐམས་ཅད་བདག་ཉིད་རྟག་ཏུ་བཞུགས།",
    "ཁྱད་པར་གླེང་གཞིའི་དོན་གསལ་བྱེད།",
    "དེ་མཚོན་པར་བྱེད་པ་ནི་བྷག་གྲུ་གསུམ་པ་གསང་བའི་གནས་ཀྱི་དབྱིབས་སོ།",
    "ཆགས་པ་ཆེན་པོའི་བདག་ཉིད་རྟོག་པའི་དྲི་མ་དང་བྲལ་ཞིང་དག་པར་བྱེད་པས་ན་མཆོག་ཏུ་གྱུར་པ་སྟེ།",
    "གདུལ་བྱའི་དོན་དུ་རྟག་ཏུ་བཞུགས་པའོ།",
    "གསང་བའི་བརྟེན་པ་གཉིས་སུ་མེད་པར་གནས་པའི་ཡེ་ཤེས་ཆེན་པོའི་རང་བཞིན་ཏེ་སེམས་དཔའོ།",
    "ཞེས་གསུངས་སོ།",
    "འབྱུང་ཁམས་འཁོར་ལོའི་རྣམ་པར་གནས།",
    "དེ་ཡང་ཡུལ་དང་ཡུལ་ཅན་གཉིས་སུ་མེད་པའི་ཚུལ་དུ་བདེ་བ་ཆེན་པོའི་སྐུར་བཞུགས་ཤིང་།",
    "སྣང་ཁྱབ་གསལ་བའི་ཚུལ་དུ་བཞུགས།",
    "གཞན་ཡང་རྐྱེན་མེད་པར་ནི་རྒྱུ་ཚོགས་པས་ཀྱང་མི་འབྱུང་སྟེ།",
    "དེའི་ཕྱིར་གསུངས་ཏེ།",
    "འོད་ཟེར་གྱི་སྣང་བས་སྟོང་གསུམ་ལ་སོགས་པའི་གནས་རྣམས་གསལ་བར་བྱས་ཏེ།",
    "དེ་ལས་རྣམ་པར་འཕྲུལ་པའི་ཐུགས་རྗེ་ཆེན་པོ་རབ་ཏུ་ཆེ་བའི་ལྷ་དག་ནི་སོ་སོར་རིགས་ཀྱི་དཀྱིལ་འཁོར་མཛད་པའི་ཚུལ་དུ་ཕུན་སུམ་ཚོགས་པར་བཞུགས་སོ།",
    "སྒྱུ་མའི་དཀྱིལ་འཁོར་སྣ་ཚོགས་ཀྱིས་གདུལ་བྱའི་དོན་དང་མཐུན་པར་སྤྲུལ་ཅིང་།",
    "ཁྱད་པར་གྱི་ལམ་གཉིས་ཀྱིས་ངེས་པར་ལེགས་པའི་བདེ་བ་མཆོག།",
    "ཚིག་དྲུག་རྣམ་པར་བསྟན་པ་གང་།",
    "ཁྱད་པར་སྒྲ་ཡི་ཚིག་ལམ་གྱིས།",
    "དངོས་པོ་ཐམས་ཅད་ཀྱི་དེ་ཁོ་ན་ཉིད་ལ་མཉམ་པར་སྦྱོར་ནས་ཉམས་སུ་མྱོང་བའི་ཁྱད་པར་གྱིས་སྲོག་སྩོལ་སྔགས་ཀྱི་རྣམ་པས་མཁའ་འགྲོ་སྒྱུ་མའི་རང་བཞིན་ཨ་ཝ་དྷཱུ་ཏཱིར་ཞུགས་ཏེ།",
    "དབྱིབས་ཀྱི་ཚུལ་གྱིས་ལྷན་ཅིག་སྐྱེས་པའི་བྱང་སེམས་འཁོར་ལོའི་གནས་ལ་བཞུགས་པའི་སྣང་བ་ལས།",
    "ད་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་དངོས་པོ་འབྲིང་དུ་བསྟན་ཏེ།",
    "དེ་རྣམ་པར་སྤངས་པའི་དགའ་བདེ་དང་།",
    "ཤས་ཅིག་གཟུང་ཞིང་ཤས་ཅིག་གཏོང་བའི་རྣམ་པར་མི་དམིགས་ཏེ།",
    "སླར་གྱེན་དུ་དྲངས་ཏེ་ལྷན་ཅིག་སྐྱེས་པའི་གནས་ལ་གཞག་པར་བྱའོ།",
    "དམིགས་པ་ཀུན་ལས་རྣམ་པར་གྲོལ།",
    "དེས་ཐམས་ཅད་ཀྱི་དོན་མཚོན་ཞིང་མཚན་པར་བྱེད་པས་ན་སྒྱུ་མའི་ཕྱག་རྒྱ་སྟེ།",
    "དངོས་པོའི་དེ་ཁོ་ན་ཉིད་སྟོན་པར་མཛད་པས་སྒྱུ་མའི་ཕྱག་རྒྱ་སྟེ།",
    "དགའ་བདེ་སྒྱུ་མ་འཇོམས་པར་བྱེད།",
    "དེ་རྣལ་འབྱོར་པས་རྟོགས་པར་བྱ་བའི་ཐབས་ཏེ།",
    "ཟབ་པའི་སྒོ་ནས་རྣམ་པར་ཕྱེ་བས་རྒྱ་ཆེའི་ཚོགས་ཀྱིས་ནི་མ་ཡིན་ནོ།",
    "འདིས་ནི་ལེའུ་གཉིས་པའི་སྟོབས་ལྟ་བ་རྣམ་པར་བསྡུས་པ་སྟེ།",
    "བདེ་བ་ཆེན་པོའི་རོས་རྒྱས་པ་ནི་ཁྱད་པར་ཆེ་སྟེ།",
    "ཏིང་འཛིན་སྤྱོད་པར་བྱ་བའང་དེ།",
    "གུས་པར་བྱེད་པ་དག་ཏུ་འགྱུར།",
    "གཞན་དུ་ཆེ་བའི་ཡོན་ཏན་གྱི་རྣམ་གྲངས་བདག་ཉིད་ཆེན་པོ་གུས་པར་བྱེད་པའོ།",
    "ངན་པར་སྤྱོད་པའང་འགྲུབ་པར་འགྱུར།",
    "སྦྱོར་ཐབས་དྲུག་ཅུ་རྩ་བཞིའི་སྒོ་ནས་འཇུག་པར་བྱའོ།",
    "ལས་སུ་བྱ་བའི་འཇིག་རྟེན་ན་སྨོད་ཅིང་ངན་པའི་ལས་དག་སྤྱོད་པས་འགྲུབ་པར་འགྱུར་བའོ།",
    "ཡང་དག་ཡེ་ཤེས་རྙེད་པར་འགྱུར།",
    "ཁྱད་པར་གྱི་དོན་དུ་སྟོང་པ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ལ་སོགས་པས་ཐ་མལ་པའི་རྣམ་པར་རྟོག་པ་བཟློག་སྟེ།",
    "དེས་ན་ངོ་མཚར་སྒྱུ་མ་ཞེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "ལེའུ་བཞི་པ་རྣམ་པར་བསྡུས་ཏེ་གནའ་བུ་བྲག་ལ་གནས་པའི་དཔེས་བསྟན་ཏོ།",
    "དེ་ལས་ཁྱད་པར་གྱི་ལས་རྩོམ་པའི་དོན་དུ་རྡུལ་ཚོན་དང་།",
    "རྟེན་དང་ཡུམ་གྱི་ཕྱག་རྒྱས་མངོན་དུ་བརྟགས་ཏེ་ནམ་མཁའ་སྤྱོད་པའི་ལས་མཐའ་དག་འགྲུབ་པར་བྱེད་དོ།",
    "ཅེས་གསུངས་སོ།",
    "ཁམས་གསུམ་འདི་ནི་རྣམ་པར་བརྟག།",
    "ཅི་སྔ་ན་མེད་པ་ཅིག་གཟུགས་བརྙན་གྱིས་ཐོབ་པར་བྱེད་དམ་ཞེ་ན།",
    "འདིས་ནི་དཀྱིལ་འཁོར་ཀུན་གྱི་མཚན་ཉིད་ལས་ཁྱད་པར་དུ་གཟུགས་བརྙན་གྱི་རིམ་པ་སྟེ།",
    "སྒོ་གསུམ་གྱི་དྲི་མ་འཁྲུ་ཞིང་བདེ་བ་བསྐྱེད་དེ་ནུས་པ་ཁྱད་པར་ཅན་བསྐྱེད་ཅིང་སྐད་ཅིག་མའི་རྣམ་པས་རྒྱུད་ཡོངས་སུ་སྨིན་ནས་གྲོལ་བའི་ལམ་ལ་སྦྱོར་ཞིང་།",
    "རྟེན་ཁྱད་པར་ཅན་དུ་འགྱུར་ཏེ།",
    "རྟེན་གྱི་ཏིང་འཛིན་རྣམས་བསྒོམས་ནས་སྦྱོར་བའི་དོན་བསམ་པར་བྱ་སྟེ།",
