    "གཅིག་པུ་འདུག་པའི་ལྷུང་བྱེད་དོ།",
    "འདུག་པའི་སྐབས་དང་འདྲའོ།",
    "གཞན་གྱིས་མགྲོན་དུ་བོས་པ་ན་འདུག་པ་ན་དེས་གནང་ན་ཞེས་གསུངས་པས་སོ།",
    "གཉིས་པ་འདུག་གནས་སུ་ཟ་བ་ལ།",
    "མུ་སྟེགས་ཅན་ཁོ་ནའི་འདུག་གནས་ཡིན་པ་སྟེ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ཞེས་པ་དང་།",
    "ཡ་མཚན་ཅན་ཐམས་ཅད་མ་ཡིན་པའི་འདུག་གནས་སོ་ཞེས་གསུངས་པས་སོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཞེས་གསུངས་སོ།",
    "གཞན་དུ་གནས་ཤིང་འདུག་གནས་དེར་ཟ་ན་གཞན་དུ་གནས་པ་ལ་སྣང་བ་མེད་ལ།",
    "བསླབ་པའི་གཞི་འདི་ལ་དགེ་སློང་ལ་སོགས་པ་རབ་ཏུ་བྱུང་བ་འདི་པ་འདུག་གནས་ཀྱི་བདག་པོ་ཡིན་པ་ནི།",
    "དགེ་སློང་དེའི་ཉེ་དུས་རྩིག་ཏུ་བཅུག་པའི་འདུག་གནས་ཉེ་དུ་བདག་པོ་གང་ཡིན་པ་དེར་ཞག་གཅིག་ལས་ལྷག་པར་གནས་ཤིང་བསོད་སྙོམས་གཅིག་ལས་ལྷག་པར་ཟོས་ན་ཡང་ངོ་ཞེས་ཏེ།",
    "མནོས་པའོ་ཞེས་པའི་སེལ་བ་ནི་མནོས་ཏེ་ཁྱེར་བ་ལས་གཞན་གནས་དེ་ཉིད་དུ་འདུག་སྟེ་ཟ་བ་ལ་ནི་ཉུང་བ་མེད་དོ།",
    "སྤངས་པ་ནི་དགེ་སློང་ཟས་ཟ་ཞིང་འདུག་པའི་གནས་བཏང་བའོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ལངས་པའོ་ཞེས་གསུངས་སོ།",
    "འདུག་པའིའོ་ཞེས་པ་ནི་འདུག་པའི་གནས་བཏང་བ་སྟེ།",
    "དགེ་སློང་ཟས་ཟ་ཞིང་འདུག་པའི་གནས་དེའི་ཉེ་འཁོར་འདོམ་གང་འདས་པའོ་ཞེས་གསུངས་སོ།",
    "རྩ་བ་ལ་སོགས་ཀྱི་སྡོང་བུ་འདབ་མ་མེ་ཏོག་འབྲས་བུ་བཅའ་བར་བྱ་བ་དག་བསྡུས་པ་ལ་བཅའ་བར་བྱ་བ་ལྔ་པོ་དེ་དག་ལ་སོགས་ཀྱིས་བཟའ་བ་ལྔ་བསྡུས་པའི་ཟས་བརྩམས་ཏེ་འདུག་པའི་གནས་བཏང་ནའོ།",
    "དང་པོ་གནོད་བྱེད་བརྗོད་པ་ནི་འདྲེན་པ་པོ་འདུག་སྟེ།",
    "མདུན་ན་འདུག་དང་ཆོ་ག་ཤེས།",
    "བྱིན་ལེན་སྟོབ་པ་འཐོབ་པའི་ཕྱོགས་ན་གནས་པ་ལ་སྤང་བར་བྱས་ནས་སོ་ཞེས་འདུག་པ་ལ་སྤང་བར་བྱས་ནས་སྤང་བར་འགྱུར་བར་གསུངས་པས།",
    "འདུག་པ་ལས་བྱིན་ལེན་ཐོབ་པར་ཤེས་སོ།",
    "དེ་ཡང་འགྲེང་བ་མཚོན་པ་ཙམ་སྟེ་འདུག་པ་ལ་སྤངས་ན་ཡང་སྤང་བར་འགྱུར་ཏེ།",
    "མི་འཐོབ་པའི་ཕྱོགས་ནི་ཁྲུ་གང་བས་མཐོ་བ་ཡན་ཆད་ནི་འདུག་པ་དང་།",
    "མདུན་ན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ལྷག་པོར་བྱ་བ་མི་འབྱུང་ངོ།",
    "ཡང་འདུག་ནས་ཟ་བ་གཞན་གྱི་མིག་ཏུ་མི་མཇེས་པའི་ཕྱིར་སྣང་བྱེད་དུ་བཅས་སོ།",
    "དགེ་སློང་རང་དང་དགེ་སློང་གྲོགས་གསུམ་སྟེ་དགེ་སློང་བཞི་དུས་གཅིག་ཟ་ན་ཐོང་བ་འདིར་འགྱུར་རོ།",
    "མདུན་དུ་མི་འདུག་པར་ལེན་པ་དང་།",
    "ཤིང་ཏོག་ལ་སོགས་པ་རུང་ཁང་བཅད་པའི་ས་ན་འདུག་པའི་རུང་བའི་སར་འགྲུབ་པ་ཉིད་རྩ་བ་དང་སྡོང་བུ་རུང་ཁང་མ་བཅད་པའི་ས་ན་འདུག་པ་ལས་སྐྱེ་བ་ལ་རག་ལས་པ་ནི་འབྲས་སུ་དེ་ཞག་མ་ལོན་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་པས།",
    "བཙོ་བར་བྱ་བའི་རྫས་གཉིས་ཀ་མཚམས་ནང་ན་འདུག་པ་ཁོ་ནར་མ་ཟད་པའོ།",
    "བཙོ་བྱ་རྫས་དེ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་བཙོས་ན་ཕྱེད་པར་བྱེད་པའི་གང་ཟག་མཚམས་ཀྱི་ནང་དེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་རྫས་དེ་མཚམས་ཀྱི་ནང་དུ་བཙོས་པར་མི་འགྱུར་རོ།",
    "དེས་ན་དགེ་སློང་རང་བཞིན་དུ་གནས་པས་བྱིན་ལེན་བྱས་པ་ནི་དགེ་སློང་བསླབ་པ་བྱིན་པས་བཟར་རུང་ལ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པས་གསོག་འཇོག་བྱས་པ་དང་།",
    "དེས་ཆུ་ཀླུང་ལ་མི་ཐར་ན་ཆུ་ཀླུང་བརྒལ་བའི་ཕྱིར་འགྲོ་བར་ཆས་པའི་དགེ་སློང་རང་ཉིད་འདུག་པའི་གནས་དེ་ལས་གཞན་ཞིག་ན་ཁུར་ཚ་བ་ཡོད་ན།",
    "ཁུར་ཚ་བ་དེའི་གན་དུ་མི་སླེབས་པའི་བར་དུ་དགེ་སློང་རང་ཉིད་ཀྱིས་ལམ་རྒྱགས་ཁུར་དུ་རུང་ངོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེའི་དོན་ཡང་སྟོབ་པ་པོའི་རྒྱབ་དང་གློ་གཡས་གཡོན་ན་འདུག་པ་མ་ཡིན་པ་ལ་འཆད་དགོས་པའི་ཕྱིར།",
    "དེ་ལྟར་ན་ནོད་པོའི་རྒྱབ་ན་སྟོབ་པོ་འདུག་ཀྱང་ཡན་ལག་གཞན་རྣམས་ཚང་ན་བྱིན་ལེན་ཐོབ་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "དེའི་ནོད་པོའི་རྒྱབ་དང་གློ་གཡས་གཡོན་ནས་འདུག་པ་མ་ཡིན་པ་ལ་འཆད་དགོས་པའི་ཕྱིར།",
    "དེ་ལྟར་ན་སྟོབ་པོའི་རྒྱབ་ན་ནོད་པ་པོ་འདུག་ཀྱང་ཡན་ལག་གཞན་རྣམས་ཚང་ན་བྱིན་ལེན་ཐོབ་པ་ཡིན་ཅེས་མཚུངས་ན།",
    "དཔེར་ན་ལྷུང་བཟེད་བཞིན་ཅེས་བྲིས་གདའ་བ་ལས།",
    "ཐོབ་པའི་ཕྱོགས་ནི་ཟས་ལེན་པ་པོ་དེ་ཟས་སྟོབ་པ་པོ་བས་ཁྲུ་གང་དུ་ལོངས་པས་དམའ་བ་ན་འདུག་པ་མ་ཡིན་པ་སྟེ།",
    "མི་འོས་པ་བཟང་པོ་འཐོབ་ན་འབྲིམ་པོའི་གྲལ་གར་བབ་པའི་ལྟག་འོག་དྲུང་ན་འདུག་པ་གྲལ་ཟླ་སུ་ཡིན་པས་མནོད་པར་བྱའོ།",
    "གལ་ཏེ་བསླངས་ན་ཡང་ངོ་ཞེས་པ་འདི་ནི་མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པའི་སྐབས་ཀྱི་ལུང་རྣམ་འབྱེད་དང་།",
    "ཟ་བ་ལ་ཡང་ཉེས་བྱས་ཉིད་དུ་འགྱུར་རོ་ཞེས་མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པའི་རྣམ་འབྱེད་ལས་གསུངས་པ་དེ་སྐབས་འདིར་བསྡུས་པའོ།",
    "ཤིང་བུ་གསུམ་ལ་བཏགས་ན་ཡང་འདུག་ཏུ་བཏུབ་བོ།",
    "ཀྱེ་བཞིན་བཟང་ཞེས་བོས་ནས་མིག་ལམ་ན་མ་འདུག་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཉལ་པོ་བྱེད་པའི་ཁྱིམ་ན་འདུག་པ།",
    "ཉེས་པ་འདི་ནི་དེ་གཉིས་ལ་གནོད་པར་འགྱུར་བ་ལས་བཞག་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་དང་རང་ཆགས་པའི་རྒྱུར་འགྱུར་བའོ།",
    "གང་དང་འདུག་པའི་ཡུལ་དང་།",
    "གང་དུ་འདུག་པའི་གནས་སོ།",
    "གསུམ་པ་གང་དུ་འདུག་པའི་གནས་ལ་ལྔ་ལས།",
    "ཀུན་སློང་ནི་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་རང་གར་འདུག་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "སྦྱོར་བ་ནི་མངོན་སུམ་དུ་འདུག་པར་རྩོམ་པའོ།",
    "མཐར་ཐུག་ནི་མངོན་སུམ་དུ་འདུག་པ་རྫོགས་པ་སྟེ།",
    "དབེན་པར་བརྣག་པས་འདུག་ན་ཉེས་བྱས་སོ་ཞེས་སོ།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པའི་ལྷུང་བྱེད་དོ།",
    "ཁྱད་པར་ནི་འདུག་ནའོ་ཞེས་པའི་གནས་སུ་འགྲེང་བའོ་ཞེས་གསུངས་ལ།",
    "དགེ་སློང་སེམས་གཏོད་ནས་འདུག་པ་དང་འགྲེང་བར་བྱེད་པ་ཡང་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོའོ།",
    "དེ་ནས་མཛོད་དུ་ཉལ་པོ་བྱེད་པའི་ཁྱམས་སུ་དགེ་སློང་འདུག་གམ་འགྲེང་ན་ཉུང་བྱེད་དོ།",
    "སུ་ལ་རུང་ན་དགེ་སློང་རང་དང་གཅེར་བུ་དེ་ལ་རུང་བའི་ཟས་སོ།",
    "འཐབ་པའི་སྟ་གོན་དུ་གནས་པ་ལ་དགེ་སློང་རང་ཉིད་གནས་ཁང་ན་འདུག་གམ།",
    "དབྱེ་ཐང་ཀ་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "རང་གང་ན་འདུག་པ་དེའི་ཉེ་འཁོར་ལས་འདས་ཏེ་བལྟས་པ་ལས་གྱུར་པའི་ཅིང་བ་དངོས་གཞིའོ།",
    "རང་གང་ན་འདུག་པ་དེ་ནས་འཕགས་ཤིང་ཉེ་འཁོར་ལས་འདས་པ་ཡིན་པ་སྟེ།",
    "དབྱེ་ཐང་ཀ་ལ་སོགས་པ་གང་ན་དགེ་སློང་རང་ཉིད་འདུག་པའི་གནས་དེ་ནས་འཕགས་ཏེ།",
    "ལོངས་སྤྱོད་ཆེ་བ་ལས་གཞན་ཐ་ན་རྩི་སྐམ་ཙམ་གྱིས་འགྲུལ་སྤྲུལ་ཅེས་པ་འདི་ལ་ཡི་གེ་ལ་ལར་བསྲུལ་ཅེས་པ་འདུག་འགྲོགས་པའི་བརྡ་རྙིང་ལ་འགྲུལ་ཅེས་པ་འབྱུང་སྣང་བས་བསྲུལ་ཡང་འགྲོགས་པའི་དོན་ཡིན་པ་འདྲ།",
    "དམར་ཊཱིཀ་ཏུ་བསྲུལ་ཅིང་འདུ་འཛིར་བྱེད་ན་ཞེས་བྲིས་གདའོ།",
    "ཁ་མ་བསྒྱུར་ཡང་རང་བཞིན་གྱི་ཁ་དོག་རུང་བ་གསུམ་ཡིན་ན་ཉེས་པ་མེད་དེ།",
    "ཤིང་བུ་ལས་བྱས་པ་རྒྱུད་གཅིག་པར་འདུག་པ་བྱིས་པ་དག་རྩེ་བའི་ཆ་བྱད་དོ་ཞེས་སོ།",
    "མི་མ་ཡིན་པའི་གནས་ན་འདུག་པའི་ཕྱིར་མལ་ཆ་དང་སྟན་ལ་ཡང་ཉེས་པ་མེད་དོ།",
    "ཁྱིམ་དུ་ཁྱིམ་པ་དེས་བཤམས་པ་ན་གསེར་དངུལ་གྱིས་སྤྲས་པའི་དྲིལ་བུ་གཡེར་ཁས་གཤིབས་པའི་གོས་དག་ལ་ཁྱིམ་པའི་ཡིན་ནོ་སྙམ་དུ་ཤེས་པར་བྱས་ནས་ཀྱང་མི་རྟག་པས་ཉེན་པར་འགྱུར་བའི་ཡིད་ལ་བྱེད་པས་འདུག་པར་བྱའོ།",
    "སེང་གེའི་ཁྲི་དེ་ལ་ནོར་བུས་སྤྲས་པ་གསེར་དངུལ་གྱིས་བརྒྱན་པ་དག་ལ་ཡང་མི་རྟག་པས་ཉེན་པ་ཡིད་ལ་བྱེད་པས་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "དེས་ན་བྲམ་ཟེའི་ཚངས་སྐུད་ལ་མཆོད་སྦྱིན་དག་པའི་སྔགས་ཆོག་ཡོད་པར་འདུག་གོ།",
    "ཡིད་འོང་རང་གང་ཞེ་ན།",
    "མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པ།",
    "ཀུན་སློང་ནི་མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་ཅིང་ཟ་བར་འདོད་པ་རྒྱུན་མ་ཆད་པའོ།",
    "མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པའི་ཉུང་བྱེད་དོ།",
    "འདི་ལྟར་དགེ་སློང་དེ་ནི་དགེ་སློང་མེད་པའི་གནས་ན་འདུག་པའོ་ཞེས་གསུངས་ཏེ།",
    "དགག་བྱ་ནི་དོན་དང་བྱ་བ་མང་བ་དང་རང་འདོད་པ་ཆེ་བའོ།",
    "ཁྲི་གང་ལ་འདུག་པའི་དགེ་སློང་གཉིད་ཡུར་པའི་མགོ་ས་ལ་ཐུག་པར་འགྱུར་བའི་ཁྲི་དེ་ལྟ་བུ་ལ་ཉལ་བར་མི་བྱ་བ་སྟེ།",
    "ས་བྱས་པ་ལ་འདུག་པ་དང་ཉལ་བར་མི་བྱའོ།",
    "མལ་སྟན་མཐོན་པོ་དང་མལ་སྟན་ཆེན་པོ་ལས་སྔ་མགོས་ལ་འདུག་པར་བྱའོ།",
    "ཁྲི་བརྩེགས་མ་སྟེ་ཁྲིའི་སྟེང་དུ་ཁྲི་བཞག་པའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ།",
    "ཉེར་དྲུག་དུས་སུ་གཡོ་མེད།",
    "ལམ་པོ་ཆེ་ན་འདུག་པས་དགེ་སློང་མ་གནས་དེ་གསུམ་གང་ཡང་རུང་བ་ན་འདུག་པ་ལས་ཟས་བླངས་ཏེ་ཟོས་པ་ལས་གྱུར་པའི་ཅིང་བ་དངོས་གཞིའོ།",
    "བདག་ཉིད་གྲོང་ན་འདུག་པས་བླངས་ཏེ་ཞེས་གསུངས་པ་དང་།",
    "དགེ་སློང་ལམ་པོ་ཆེ་ན་འདུག་པས་དགེ་སློང་ཕ་གང་ཡང་རུང་བ་ན་འདུག་པ་དེ་ལས་བཅའ་བ་དང་བཟའ་བ་ལེན་ཅིང་ཟ་བར་བྱེད་ན་དངོས་གཞིར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལམ་པོ་ཆེ་ན་འདུག་པ་ཞེས་གསུངས་པས།",
    "དགེ་སློང་དབྱར་ཁང་དུ་འདུག་པས་དགེ་སློང་མ་གནས་གང་ཡང་རུང་བ་ན་འདུག་པ་ལས་ཟས་བླངས་ཏེ་ཟ་ན་ཅིར་འགྱུར་ཞེ་ན།",
    "དབྱར་ཁང་ནི་དགེ་སློང་མའི་གཙུག་ལག་ཁང་སྟེ་དགེ་སློང་དབྱར་ཁང་ན་འདུག་པས་ནི་དགེ་སློང་མ་གནས་གང་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "འོ་ན་དགེ་སློང་གཙུག་ལག་ཁང་ན་འདུག་པས་དགེ་སློང་མ་གནས་གང་ཡང་རུང་བ་ན་འདུག་པ་ལས་ཟས་བླངས་ཏེ་ཟ་ན་ཅིར་འགྱུར་ཞེ་ན།",
    "དགེ་སློང་གཙུག་ལག་ཁང་ན་འདུག་པས་ནི་དགེ་སློང་མ་གནས་གང་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "ནམ་མཁའ་དང་ལམ་པོ་ཆེ་ལ་སོགས་པ་གང་ན་འདུག་པ་ལས་ཟས་བླངས་ཏེ་ཟོས་པ་ལས་ཉུང་བ་འདི་མི་བསྐྱེད་པ་སྟེ།",
    "ནམ་མཁའ་ནི་ཕྱེད་ཉིད་དོ་ཞེས་པ་ནི་ནམ་མཁའ་ལ་འདུག་པས་དགེ་སློང་མ་གྲོང་ལ་སོགས་པ་གནས་གང་ཡང་རུང་བ་ན་འདུག་པ་ལས་ཟས་བླངས་ཏེ་ཟོས་ན་ཉུང་བའི་དངོས་གཞིའི་ཕྱེད་ཉིད་དེ་ཉེས་བྱས་བསྐྱེད་པས་ཉེས་བྱས་བརྒྱད་དང་།",
    "ལམ་པོ་ཆེ་གསུམ་པོ་གང་ཡང་རུང་བ་ན་འདུག་པས་དགེ་སློང་མ་གནས་དེ་གསུམ་ལས་གཞན་པའི་གནས་དྲུག་སྟེ།",
    "དེས་ན་ཟས་འདྲེན་པའི་བསྐོ་ཤམ་བྱེད་པ་ལ་ཞུགས་པའི་དགེ་སློང་མ་འདུག་པ་ནི་སྣང་བྱེད་འདི་སྐྱེད་པའི་བྱེད་པ་པོ་ཉིད་ཡིན་ནོ།",
    "ཤམ་ཐབས་ནི་ཅི་ནས་ཀྱང་སྐུམ་པོར་འདུག་པར་འགྱུར་བ་དེ་ལྟར་བགོ་བར་བྱའོ།",
    "སྐུམ་པོ་ནི་མཐའི་ཁ་མཉམ་པར་འདུག་པའོ་ཞེས་སོ།",
    "ལྟེ་བའི་གོང་དུ་ཤམ་ཐབས་མ་བལྟེབ་པར་ཏེ་ཏ་ལའི་ལོ་མ་ལྟར་བལྟེབ་ཅིང་འདུག་པ་མ་ཡིན་པར་རོ།",
    "ནས་འབྲུའི་བུམ་བུ་བརྩམས་པ་ལྟར་འདུག་པ་མ་ཡིན་པར་རོ།",
    "ཙོག་ཙོག་པོར་འདུག་པ་ལས་མཆོང་ཞིང་མི་འགྲོ་ཞེས་སོ།",
    "རྐང་པ་མི་བསྣོལ་བར་འདུག་པར་བྱའོ།",
    "བརླ་མི་བསྣོལ་བར་འདུག་པར་རོ།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་བཞག་པར་འདུག་པར་རོ།",
    "ཁྲི་སྟེང་དུ་འདུག་སྟེ་ཁྲི་འོག་ཏུ་རྐང་པ་མི་འགུག་པར་འདུག་པར་བྱའོ།",
    "རྐང་པ་གཉིས་ཐད་ཀུར་མི་གདང་བར་འདུག་པར་རོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་རྒྱབ་ཀྱིས་ཁྱེར་ཞིང་འགྲོ་བར་མི་བྱ་བའི་ཐ་ཚིག་གོ་ཞེས་སོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུབ་མི་གཏོར་རོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ལྷུང་བཟེད་ཀྱི་ཆུ་དེ་ཁྱིམ་དུ་མི་དབོའོ།",
    "དགེ་སློང་མ་འདི་བདག་ལ་ཆགས་ནས་འདུག་གོ་སྙམ་དུ་ཤེས་པའི་འདུ་ཤེས་གཉིས་པོ་དེ་དགེ་སློང་མའི་འདུ་ཤེས་ཀྱིས་ཤེས་ཀྱང་རུང་དོགས་ཀྱང་རུང་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་ཞེས་བསྟན་པ་ཡིན་པར་ཤ་སྦལ་རྣམས་འཆད་དོ།",
    "གླེང་གཞི་ནི་དགེ་སློང་མ་མང་པོ་ཆུའི་ཕ་རོལ་ཏུ་འགྲོ་བར་འདོད་པ་ན་ཕ་རོལ་གྱི་འགྲམ་ན་གྲུ་ཕུར་པ་ལ་བཏགས་ཏེ་འདུག་གོ།",
    "ཟལ་བའི་ཕྱིར་མི་རིགས་པས་མ་དད་པར་འགྱུར་བ་དང་རང་འདོད་པ་ཆེ་བའོ།",
    "དབེན་པ་ན་འདུག་པ་ལ་ཡང་ཚུལ་དེ་བཞིན་དུ་སྦྱར་རོ།",
    "ཁྱད་པར་དུ་ཡང་འདུག་པ་དང་འགྲེང་བ་དང་ཕྱིར་མ་བླངས་པར་སྤྱོད་པ་དང་ཞེས་གསུངས་པའི་ཉུང་བ་འདི་གསུམ་ལ་ནི་རྣམ་པར་བཞག་པ་ལུགས་གཉིས་ཡོད་དེ།",
    "ཉལ་སར་འདུག་དང་འགྲེང་བ་དང་།",
    "ཁྱད་པར་དུ་ཡང་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་དང་ཕྱིར་མ་བླངས་པར་སྤྱོད་པ་དང་ཞེས་པའི་ཊཱི་ཀ་ལས།",
    "ཡང་དགེ་སློང་མ་གང་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་འདུག་པར་བྱེད་ན་ཉུང་བྱེད་དོ།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་འདུག་པའི་སྣང་བྱེད་ཀྱི་ལུང་ཞུ་བ་ལས་ཀྱང་།",
    "དགག་བྱ་ནི་ཆགས་པ་འཕེལ་བ་དང་རང་ལ་གནོད་པའོ།",
    "ཏིལ་འབྲུས་ཁྲ་བོར་བྱས་པའི་སེན་རྩེ་ལྟར་འདུག་པ་ལ་སྟོས་ཞེས་སྨྲས་པ་དང་།",
    "འོ་ན་དགེ་སློང་མས་སྐྱེས་པ་དང་དབེན་པ་ན་འདུག་པ་ལ་ཅིར་འགྱུར་ཞེ་ན།",
    "དེ་དག་ལ་ནི་འདུག་པ་ལ་ཡང་ཅིང་བྱེད་ཁོ་ནར་འགྱུར་ཏེ།",
    "དབེན་པ་ན་འདུག་པའི་སྐབས་ཀྱི་ལུང་ཞུ་བ་ལས།",
    "དགེ་སློང་མ་གང་གཅིག་པུ་སྐྱེས་པ་དང་ལྷན་ཅིག་དབེན་པ་སྐྱབས་ཡོད་པ་ན་འདུག་ན་ཉུང་བྱེད་དོ།",
    "དགེ་སློང་མ་གང་གཅིག་པུ་དགེ་སློང་གཅིག་དང་དབེན་པ་སྐྱབས་ཡོད་ན་འདུག་ན་ཐོང་བྱེད་དོ།",
    "དགེ་སློང་མ་གང་གཅིག་པུ་སྐྱེས་པ་གཅིག་དང་ལྷན་ཅིག་བླ་གབ་མེད་པར་དབེན་པར་འདུག་ན་ལྷུང་བྱེད་དོ།",
    "ཐ་དད་པ་མ་ཡིན་པར་སྣང་བའི་ཐག་དེ་ཙམ་ན་གྲོགས་དེ་འདུག་ན།",
    "ཁྲིའུ་དེ་ལ་བདག་ཉིད་འདུག་ཏུ་འཇུག་པའི་བསྙེན་བཀུར་ཁྲིའུ་ཡང་ཡང་དུ་ཤོམ་འཇུག་པ་ཉམས་སུ་ཅང་བར་བྱེད་པའི་དགེ་སློང་མ་ལ་ཅིང་བྱེད་དུ་འགྱུར་རོ།",
    "དགེ་སློང་མ་ཁྲི་ཐོག་ན་འདུག་ལ་ཁྲིའི་ཕ་རོལ་ཚུར་རོལ་ན།",
    "དགེ་སློང་མས་ཁྱིམ་གཞན་དུ་བདག་པོས་མ་བསྒོ་བར་དར་སྟན་ལ་འདུག་པ་ལ་སྣང་བྱེད་དུ་འགྱུར་རོ།",
    "རྩྭ་དང་སོག་མ་ལ་སོགས་པ་འདུག་པའི་ཆེད་དུ་ཁང་པའི་ཕྱི་རོལ་ཏུ་བཤམས་པ་དེ་དག་ལ་ནི་མ་བསྒོ་བར་འདུག་ཀྱང་སྣང་བ་མེད་དེ།",
    "རྩྭ་དང་སོག་མ་ལ་སོགས་པ་དེ་ཡང་མ་བཤམས་པ་ལ་འདུག་ན་ནི་ཉེས་བྱས་སོ།",
    "སོག་མ་ལ་སོགས་པ་ཡིན་ཀྱང་རས་ཀྱིས་གཡོགས་པའི་སྟན་ལ་འདུག་པའི་དོན་དུ་ཕྱི་རོལ་ཏུ་བཤམས་པ་ལ་ནི་མ་བསྒོ་བར་འདུག་ན་ཉེས་བྱ་ས་སོ།",
    "སོག་མ་ལ་སོགས་པ་རས་ཀྱིས་གཡོགས་པ་དེ་ཡང་མ་བཤམས་པ་ལ་ནི་མ་བསྒོ་བར་འདུག་ན་ཁ་ན་མ་ཐོ་བ་རྫོགས་པར་འགྱུར་རོ།",
    "དགག་བྱ་ནི་རང་རིས་ལ་གནོད་པ་དང་རང་བཞིན་གྱི་དགག་བྱར་གྱུར་པའོ།",
    "དགེ་སློང་མ་དེ་ཡང་ཆུ་སྣོད་གཅིག་ལག་ཏུ་ཐོགས་ཏེ་དེའི་མདུན་ན་སྡོད་ཅིང་འདུག་གོ།",
    "དགེ་སློང་སྟན་ལ་འདུག་པས་དགེ་སློང་མ་དེ་འགྲེང་བ་ཧ་ཅང་ཡུན་རིང་དུ་འདའ་བར་བྱེད་ན་སྟན་ལ་འདུག་ཏུ་གཞུག་གོ།",
    "དགེ་སློང་མ་ཉིད་ཀྱིས་སྟན་ལ་འདུག་པའི་ཕྱིར་དགེ་སློང་ལ་ཞུས་ཏེ་གནང་ན་སྟན་དེ་ལ་འདུག་པར་བྱའོ།",
    "སྲིན་བལ་བརྟད་བྱུང་དབེན་པར་འདུག་པ་བཞིན།",
    "ཉལ་བར་འདུག་རགྲེང་གཉིས་དང་གདེང་མེད་སྤྱོད།",
    "ཁྱིམ་དུ་མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་དང་།",
    "མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པའི་ཊཱི་ཀུར།",
    "གནས་དེར་འདུག་ན་དགག་བྱ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
    "འདུག་གནས་འདུག་ཟ་ཉལ་ཤོམ་གཉིས།",
    "མི་སྨྲ་མ་གུས་དུས་མིན་འགྲོ།",
    "རིམ་གཉིས་འདུག་གནས་ཕྱེ་དང་ནི།",
    "རིང་དུ་འདུག་པའི་སྐབས་སུ།",
    "དབེན་པར་འདུག་འགྲེང་ལ་སོགས་པ་རྣམས་ནི་ཆ་དེར་གཏོགས་པ་ཡིན་གྱི།",
    "ཉལ་ཤོམ་འདུག་འགྲེང་ལྷན་ཅིག་ཉལ།",
    "ཐག་རིང་པ་ན་འདུག་ཀྱང་ཟིན་པའི་མངོན་ཞེན་རྫོགས་པ་ལྟར་ཛུ་འཕྲུལ་གྱི་ཕྱོགས་གཅིག་ཐོབ་པར་བྱ་ལྟ་བུ་འཛིན་པར་འདོད་ན།",
    "རྫུ་འཕྲུལ་མི་བྱེད་པར་དྲུང་ན་འདུག་ཀྱང་ཟིན་པའི་མངོན་ཞེན་མི་རྫོགས་པར་མྱོང་བས་གྲུབ་བོ།",
    "པར་རང་སེམས་སྐྱོ་བར་གདའ།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཉལ་ཤོམ་འདུག་འགྲེང་གཉིས་ནི་གཉིས་ཀ་ལས་གྱུར་པའོ།",
    "འདུག་པ་མ་གཏོགས་དགུ་དག་དང་།",
    "འདི་དག་ཀྱང་རང་དོན་ཡན་ལག་ཏུ་དགོས་པར་འདུས་སོ།",
    "གོས་སེར་དང་ནི་འདུག་གནས་ཟ།",
    "འདུག་པ་དང་བྱ་བ་དང་གསོ་སྟོང་བྱ་བར་རྗེས་སུ་གནང་ངོ།",
    "འདུག་པའི་ཆེད་དུ་ས་ལས་བྱས་པའི་སྟེགས་བུ་གྲུ་བཞི་དག་དང་།",
    "ས་གཞི་མཚམས་མ་བཅད་ཀྱང་རང་བཞིན་གྱི་མཚམས་རྒྱ་ཆེན་པོའི་ནང་དུ་ཡང་མི་འབྲལ་བའི་གནང་བ་སྦྱིན་རུང་སྟེ།",
    "ནམ་མཁའ་ལ་འདུག་པ་དང་འགྲོ་བར་མི་བྱའོ།",
    "ནམ་མཁའ་ལ་འདུག་པ་དང་།",
    "འདིར་དགེ་སློང་ལ་བརྗོད་ན་ནི་འདུག་སྟེ་ལན་གསུམ་བརྗོད།",
    "དགེ་སློང་འགའ་ཞིག་རྒྱལ་པོ་ལ་སོགས་པས་བཟུང་སྟེ་མཚམས་ཀྱི་དང་ན་འདུག་ན་ཞེས་སོ།",
    "མཚམས་ཆེན་པོ་བཅད་པ་དེར་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ་གསོ་སྦྱོང་དགག་དབྱེ་བྱའོ་ཞེས་གསུངས་ལ།",
    "སོ་སོར་བརྟགས་ནས་ཇི་ལྟར་འདུག་པར་བྱ་ཞེ་ན།",
    "ཅིང་བ་ངེས་པར་ཤེས་པའམ་ཡིད་གཉིས་དང་བཅས་པ་ཕྱིར་བཅོས་ཏེ་ལས་ཀྱི་གནས་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ།",
    "གནས་དེ་ན་དགེ་སློང་རང་གཅིག་པུ་འབའ་ཞིག་ཡོད་ན་སྤྱོད་ལམ་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་བོ།",
    "དགེ་སློང་རང་ཉིད་མ་གཏོགས་པ་ལྷག་མ་ཟླའུ་དགེ་སློང་གཞན་གཅིག་དང་བཅས་པ་སྟེ།",
    "དགེ་སློང་གཉིས་འདུག་པ་ཉིད་ཡིན་ན་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "གནས་དེ་ན་དགེ་སློང་གསུམ་ཡོད་ན་གསུམ་ཆར་འཁོད་དེ་འདུག་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཁྱིམ་ལོ་སོ་གསུམ་འདས་ཙ་ན།",
    "དེ་མེད་པ་ཉིད་ཀྱིས་ཀྱང་རང་གྲོལ་བར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "མུ་སྟེགས་པའི་འདུག་གནས་ཀྱང་མཚོན་པ་དག་དང་།",
    "དེས་ན་དབྱར་གནས་སྔས་ནའང་དབྱར་གནས་དབྱར་ལ་མ་བྱས་ཀ་མེད་འདུག་གོ།",
    "ལྡེའུ་མིག་ཐོགས་ཏེ་མདུན་དུ་འདུག་ནས་ཡོན་ཏན་ཇི་ལྟ་བ་བཞིན་དུ་བརྗོད་ཅིང་བསྟབ་པའོ།",
    "ལག་ཏུ་བླངས་པས་དང་པོར་གནས་བརྟན་གྱི་མདུན་དུ་འདུག་སྟེ།",
    "འདུག་པ་དང་།",
    "ཕྱི་དྲོ་འདུག་པས་གནས་ཁང་ཐམས་ཅད་ལོངས་སྤྱད་པས་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "བསྙེན་པར་རྫོགས་སུ་ཟིན་ཀྱང་མི་གནས་པར་འདུག་པའི་ལོ་མ་ཚང་བ་དགེ་སློང་བསྙེན་པར་རྫོགས་ནས་ལོ་མ་ལོན་པ་འབའ་ཞིག་ཡིན་པའམ།",
    "མཚམས་ཆེན་པོ་བཅད་པ་དེར་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ་གསོ་སྟོང་དང་དགག་དབྱེ་བྱའོ་ཞེས་གསུངས་ལ།",
    "དེང་སང་ནི་དགེ་སློང་གསུམ་གསུམ་གྱི་མདུན་དུ་འདུག་པར་བྱེད་དེ།",
    "གང་ཟག་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་གནས་གཅིག་ཏུ་བསྡུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "གཞི་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱིས།",
    "གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པ་དེའི་དོན་དུ་འདུག་ཅིང་འདུས་པ་མ་ཡིན་གྱི།",
    "མཚམས་གཞན་དུ་ནི་སྲ་བརྐྱང་རང་འཇུག་བྲལ་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྲ་བརྐྱང་བཏིང་ནས་ཟླ་བ་ལྔ་ལས་འདས་ན་ཡང་རང་ཞིག་ཏུ་གྱུར་པ་སྟེ།",
    "སྲིད་དུ་བཏང་བའི་ཚལ་བུ་རྣམས་ཀྱི་སྣ་མཐོ་དམན་དུ་འདུག་པས་སྣམ་ཕྲན་སྣྲེལ་ཞི་ཉིད་དུ་གྱུར་པའོ།",
    "གཅེར་བུ་ཉིད་དུ་འདུག་པ་དང་།",
    "གཙུག་ལག་ཁང་ལ་སོགས་པའི་གནས་གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་དངོས་པོ་དེ་འདུག་པའི་གནས་དེའི་མཚམས་སུ་གཏོགས་པའི་རབ་ཏུ་བྱུང་བ་རྣམས་ནི་དངོས་པོ་དེ་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "གང་ན་ནོར་རྫས་དེ་འདུག་པའི་མཚམས་དེར་གཏོགས་པ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གཙུག་ཁང་བཞིའམ་གསུམ་གྱི་བར་ན་འདུག་པའམ།",
    "ཁྱིམ་གཞན་ན་འདུག་པའི་རྫས་དེ་ལ་ལེན་པ་མེད་པ་ཉིད་ཡིན་ཅིང་ཞེས་པ་ནི་མཚོན་པ་སྟེ།",
    "ལྷས་མ་གྲུ་བཞིར་འདུག་པའོ་ཞེས་སོ།",
    "རྒྱ་ཅང་ངམ་ཞེས་པ་ནི་སྐུད་པ་མང་པོ་ལས་བཏགས་པ་ཉིད་དབུས་ཁོངས་སྟོང་དུ་འདུག་པའོ་ཞེས་ཊཱི་ཀ་ལས་སོ།",
    "སྣམ་སྦྱར་དེ་ལ་དེའི་སྟེང་དུ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "གདོང་ཕྱིས་ཀྱི་མཐའ་དྲིལ་ཏེ་བཙེམ་ཞིང་རང་ཆགས་བྱའོ་ཞེས་སོ།",
    "ཁྱིམ་གཞན་དུ་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་སོ།",
    "སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་གནས་སུ་ཡང་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་སྔ་མ་དེ་བཞིན་ནོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་དག་འཁོད་ཅིང་།",
    "མུ་སྟེགས་ཅན་ཉེ་བར་གནས་ན་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་འདུག་ནས་དེར་སྣམ་སྦྱར་མེད་པར་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "དགེ་ཚུལ་ཕ་ཞིག་འོང་ན་ཡང་དེར་འདུག་ལ་ཟོ་ཞིག་ཅེས་སོ།",
    "གཙུག་ལག་ཁང་དུ་ནི་ཀོ་པགས་ཀྱི་སྟན་ལ་འདུག་པར་མི་བྱ།",
    "ཀོ་པགས་ཀྱིས་བརྒྱུས་པའི་ཁྲི་དང་ཁྲིའུ་ལ་སོགས་པ་ལ་ཡང་འདུག་པར་མི་བྱའོ།",
    "དམིགས་བསལ་ནི་ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་ཀོ་པགས་ལས་སྟན་གཞན་མེད་ན་དགེ་སློང་ཀོ་པགས་ལ་འདུག་པར་བྱའོ།",
    "ཡུལ་མཐའ་འཁོབ་དག་ཏུ་ནི་ཉལ་བའི་མལ་དང་འདུག་པའི་སྟན་གཉིས་ཀ་ཡང་ཀོ་པགས་གནང་ངོ་ཞེས་སོ།",
    "བདག་ཀྱང་རང་ལོ་ཉེར་བདུན་ངོ་མཐོང་ཡང་བརྩོན་སྐལ་ཞན་པས་རབ་འབྱམས་རྒྱ་མཚོའི་ཞིང་།",
    "བཏུང་བ་བརྒྱད་པོ་འདི་དག་དུས་སུ་བྱིན་ལེན་བྱས།",
    "ལུང་དང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "འདུག་བྱ་སྐབས་ཀྱི་ཞར་བྱུང་བཅས།",
    "གཏན་གཞན་མེད་ན་རྩྭ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ།",
    "ཟན་གྱི་ཕྱིར་འདུག་པས་དངོས་པོ་འདི་བྱིན་ཅིག་ཅེའམ།",
    "དང་པོ་སྦྱོར་བའི་དུས་སུ་ལུས་ཀྱིས་ཚུལ་བཞིན་དུ་འདུག་པ་དང་།",
    "བདག་ནི་ལེན་པའོ་སྙམ་དུ་དྲན་པ་ཉེ་བར་བཞག་པ་སྟེ་དེ་བཞིན་དུ་འདུག་པར་བྱའོ།",
    "སྟོ་འཛག་པ་དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་འདུག་པར་མི་བྱའོ།",
    "དེ་ཡང་མི་འདུག་པར་འགྲེང་བ་མ་ཡིན་པ་དང་།",
    "འདུན་པ་ཡོངས་དག་འབུལ་བ་ཙམ་མ་ཡིན་པ་སྟེ་མི་འདུག་པར་འགྲེང་བ་ནི་ཞེས་དང་།",
    "འདུག་པའི་དམིགས་བསལ་མགྲོན་པོ་མི་སྡོད་ན་འགྲོ་བཞིན་དུ་བྱའོ་ཞེས་པ་དང་།",
    "སྟན་ལ་འདུག་པ་དང་།",
    "འདི་གསུམ་ལ་གསོལ་གཉིས་ཀྱི་ལས་ཀྱི་ཆོ་ག་བྱེད་དོ་ཟེར་ཡང་རང་གར་སྨྲ་བའོ།",
    "རྒྱལ་མ་ཐོས་པའི་ཉེན་ཀོར་ནས་བཀར་ཏེ་མཐོང་བའི་ཉེན་ཀོར་དུ་འདུག་ཏུ་བཅུག་ནས་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙིལ་བར་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "འདུག་པའི་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་དང་།",
    "འདུག་པའི་སྤྱོད་ལམ་དེ་བརྩམས་པ་སྟེ་འདུག་པ་ལས་འགྲོ་བའི་སེམས་ཀྱིས་འདུག་པའི་སྤྱོད་ལམ་བཏང་བ་སྟེ་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ།",
    "འདུན་པ་དགེ་སློང་ལ་བརྗོད་ན་འདུག་སྟེ་ལན་གསུམ་བརྗོད་པར་གསུངས་པ་ལྟ་བུའོ།",
    "གསངས་ཏེ་སྟོན་པས་བར་ཆད་དྲི་བའི་སྐབས་མ་གཏོགས་པར་བསྙེན་རྫོགས་ལེན་པ་པོ་དེ་ཕ་གུ་རྩྭ་བཏིང་བ་ལ་རྟིང་བ་གཉིས་ཀྱིས་གཟེར་ཏེ་འདུག་པར་བྱའོ།",
    "དེ་ལ་ཅི་བདེར་འདུག་ཏུ་གཞུག་པ་ཡིན་གྱི།",
    "ཙོག་པུར་འདུག་ཏུ་མི་གཞུག་གོ།",
    "གང་ཟག་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་བརྗོད་ཅེས་དོན་གྱིས་གོ་བར་བྱའོ།",
    "གསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་ལ་ནི་འདུག་པ་ཉིད་ཀྱིས་བྱའི།",
    "ཕྱོགས་བཞིའི་མཚན་མ་བརྟན་པོའི་ས་ཁོངས་སུ་དགེ་སློང་རྣམས་འདུག་སྟེ་མཚམས་གཅོད་དགོས་སོ།",
    "ཤིང་དྲུང་ལ་སོགས་པ་འདུག་པའི་གནས་ཐམས་ཅད་ལ་རྒན་རིམ་དུ་བསྐོ་བར་བྱའོ།",
    "དེའི་སྟེང་དུ་འདུག་ནས་ལས་བྱའོ།",
    "སྣང་བ་འབྱིན་པ་པོ་གནས་སྐབས་ཇི་ལྟར་འདུག་པ་ལ་བྱ་ཞེ་ན།",
    "གང་ཟག་གང་ལ་མཛའ་བའམ་ངོ་ཚ་ཤེས་པའམ་ཁྲེལ་ཡོད་པར་འགྱུར་བ་དེ་ལ་གནས་ཏེ་འདུག་པར་བྱའོ་ཞེས་གསུངས་ཏེ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "སྤོ་མགུ་སྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དེ་དག་དང་ལྷན་ཅིག་ཏུ་འཆགས་པ་ན་གོམ་པ་སྲི་བ་ཉིད་ཀྱིས་ཕྱི་ནས་འགྲོ་བ་དེ་ལས་གཞན་གོམ་པ་མཉམ་དུ་ཐད་ཀུར་འགྲོ་བའམ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ཉིད་ལ་འདུག་པར་བྱའི།",
    "དེ་ལས་གཞན་སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་ཡང་མི་བྱའོ།",
    "སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་ཡང་མི་བྱ་ན་སྟན་གཅིག་ལ་ལྟ་ཅི་སྨོས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཁྱིམ་དུ་འགྲོ་བ་ན།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ངོས་དང་སྟེང་གཡོགས་མ་གཅིག་ཏུ་ཉལ་བར་མི་བྱ་ཟས་དེར་མལ་བཤམ་པར་མི་བྱའོ།",
    "ས་རང་བཞིན་དུ་གནས་པ་ཐམས་ཅད་ཀྱི་གྲལ་གྱི་མཐའ་བསྙེན་པར་མ་རྫོགས་པ་རྣམས་ཀྱི་གོང་ཉིད་དུ་འགྲོ་འདུག་ལ་སོགས་པ་བྱའོ།",
    "དགེ་སློང་སྤོ་མགུ་སྤྱོད་པ་དེ་བསྙེན་རྫོགས་ས་རང་བཞིན་དུ་གནས་པའི་གྲལ་གོང་དུ་འདུག་ཏུ་རུང་བའང་ཡོད་དེ།",
    "དགེ་སློང་མ་རྣམས་ཀྱི་གྲལ་གོང་དུ་འདུག་པའོ།",
    "དགེ་སློང་མ་དག་འབའ་ཞིག་ཚོགས་ན་ཡང་རྟག་ཏུ་གྲལ་གྱི་དང་པོར་སྟན་ཅིག་ལྷག་པོར་ཞོག་ལ་འབོད་ཅིག་དེ་སྟེ་དགེ་ཚུལ་ཕ་ཞིག་འོང་ན་ཡང་དེ་དེར་འདུག་ལ་ཟོ་ཞིག་ཅེས་གསུངས་པས།",
    "དགེ་སློང་མགུ་བ་སྤྱོད་པ་ནི་དགེ་སློང་སྤོ་བ་སྤྱོད་པའི་གྲལ་གོང་དུ་འདུག་རུང་ལ།",
    "སྤོ་མགུ་སྤྱོད་པ་གཉིས་ཀ་ཡང་བསླབ་པ་བྱིན་པའི་གྲལ་གོང་དུ་འདུག་ཏུ་རུང་ངོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ།་",
    "གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྟོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ལྷན་ཅིག་འགྲེང་བ་དང་འདུག་པ་དང་།",
    "རྒན་རིམ་ཇི་ལྟ་བ་བཞིན་དུ་འདུད་པར་བྱས་ལ་ཙོག་ཙོག་པོར་འདུག་སྟེ་ཚིག་འདི་སྐད་ཅེས།",
    "ཕྱོགས་ཉིས་ཀ་ཕ་ཟད་ཚུ་ཟད་གྲལ་མཉམ་དུ་འདུག་ལ་མཐོལ་བཤགས་བྱ་ཞེས་སོ།",
    "གལ་ཏེ་སྦྱིན་པའི་ལས་ཡིན་ན་ནི་རྒན་པའི་མཐར་འདུག་སྟེ།",
    "ཁྱིམ་གཞན་ན་འདུག་པ་དང་།",
    "ཟས་ཀྱི་གྲལ་ན་འདུག་པ་མ་གཏོགས་སོ།",
    "དགེ་སློང་རང་ཉིད་ལ་དད་པའི་རྙེད་པ་ནི་གཙུག་ལག་ཁང་ཉིད་ཀྱི་རྙེད་པ་མ་ཡིན་ནོ།",
    "འབོགས་པོ་འདུག་པ་དང་ཉལ་བ་ན་ནོད་པོ་འདུག་པའིའོ།",
    "ཉན་པ་གསར་བུ་ནི་འཆད་པོས་བསྒོ་ན་སྟན་ལ་སྟོད་ཕབ་སྟེ་འདུག་གོ།",
    "མནོད་པར་བྱ་བ་མང་བ་ཉིད་ཡིན་ན་གསར་བུ་དེས་ལྷོད་ཕབ་ཏུ་འདུག་པའི་ཕྱིར་འབོགས་པོ་ལ་ཞུ་བར་བྱའོ།",
    "ཁ་ཏོན་བྱེད་པ་ན་མཁན་སློབ་ཀྱིས་ཐོས་པའི་ཉེན་ཀོར་མ་གཏོགས་པར་སྣང་བའི་ཉེན་ཀོར་དུ་འདུག་སྟེ་ཁ་ཏོན་བྱའོ།",
    "བསྙེན་པར་རྫོགས་པའི་དུས་ལོ་གསུམ་ལས་ལྷག་པ་བར་དུ་ཆོད་པ་ཁྱད་ཞུགས་པའི་བསླབ་པ་རྒན་གཞོན་དང་ལྷན་ཅིག་སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་དང་དགེ་སློང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "ཕམ་པ་འཆབ་བཅས་བྱུང་བ་དག་དང་སྟན་གཅིག་ཏུ་འདུག་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་དང་སྟན་གཅིག་ཏུ་འདུག་པར་མི་བྱའོ།",
    "སྟན་གཅིག་ལ་འདུག་པ་སྔར་བཀག་པ་དེ་རྣམས་ཐམས་ཅད་ལ་ཡང་དོག་པའི་གནོད་པར་གྱུར་ན་ཉུང་བ་མེད་དོ།",
    "མི་གཙང་བའི་སྐྱབས་དང་ཉེ་བར་འདུག་པར་མི་བྱའོ།",
