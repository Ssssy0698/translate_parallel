    "སྤྱན་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ཀྱིས་ནི།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་གསུང་སྟེ་ཀུན་ལ་ཕན་ཞིང་ཐུགས་བརྩེ་བ།",
    "འཇིག་རྟེན་དག་གི་དོན་དང་དགོས་པ་མཛད་ལ་རབ་ཏུ་བརྩོན།",
    "ཁྱོད་ནི་རྡོ་རྗེ་འདོད་པ་དམ་ཚིག་མཆོག་གི་ཕན་དོན་ཆེ།",
    "རྡོ་རྗེ་གསུང་གིས་མཛད་དུ་གསོལ།",
    "ཐུབ་པའི་མཆོག་གི་འོད་ཟེར་ལས་བྱུང་བའི།",
    "རང་གི་རིགས་ཀྱི་གཙོས་བརྒྱན་ཅོད་པན་གྱུར།",
    "ཧཱུཾ་གིས་འདབ་མ་བརྒྱད་པ་རྣམ་པར་སྤྲུལ།",
    "ཧཱུཾ་གི་རྡོ་རྗེ་ལས་བྱུང་དྲི་མ་མེད་པ་ཡི།",
    "རང་གི་དཀྱིལ་འཁོར་པ་ཡི་གཟུགས་བསམས་ལ།",
    "རིན་ཆེན་མཆོག་གི་འོད་ཟེར་འབར་བས་བརྒྱན།",
    "མོ་ཧ་ར་ཏཱི་ཞེས་པས་ལྷ་མོ་སྤྱན།",
    "ཕྱོགས་ཀྱི་ཚོགས་ཁེབས་རང་གི་ངོ་བོ་ནི།",
    "ལྷ་མོ་འདི་རྣམས་ངེས་པའི་ཕྱག་མཚན་ནི།",
    "ཕྱག་ལ་སོགས་པར་གསུང་གི་རྡོ་རྗེ་འདྲ།",
    "དེ་བཞིན་བྱང་གི་སྒོ་རུ་བསམ་པར་བྱ།",
    "ཙནྡན་བཟང་སོགས་མེ་ཏོག་གིས་མཛེས་དབུལ།",
    "པད་ནང་རང་གི་ས་བོན་འདི་རྣམས་ཀྱིས།་།",
    "ཤེས་རབ་བ་སྤུ་རེ་རེ་༢ལས་བྱུང་བའི།",
    "གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་དང་ནི།",
    "རང་བཞིན་འོད་གསལ་མཆོག་གི་མཆོག།",
    "རང་གི་གསང་སྔགས་ནང་དུ་ཆུད་པར་བྱ།",
    "བདག་དང་བདག་གི་རྣམ་རྟོག་རྒྱུན་གྱི་ནི།",
    "མ་ལུས་ལྷ་མོའི་ཚོགས་ཀྱི་ངོ་བོ་ཉིད།",
    "ནང་གི་ལུས་དང་དེ་བཞིན་ཐམས་ཅད་ཀྱང་།",
    "བ་སྤུ་རེ་རེའི་ཁོང་ལས་བྱུང་བ་ཡི།",
    "ཡང་ན་རང་གི་མཚན་མ་ཕྲ་མོ་ནི།",
    "ནང་གི་ཤེས་རབ་དམ་པ་ཉིན་མཚན་བསྒོམ།",
    "རང་གི་སྔགས་ནི་སྣ་ཚོགས་འོད་ལྡན་པར།",
    "མཐར་ནི་རང་གི་ལུས་ལ་གཞུག་པར་བྱ།",
    "ལངས་ནས་དག་པའི་སེམས་དཔའ་རང་གི་ལྷའི།",
    "རང་རང་གི་ནི་ངོ་བོ་རྣམ་དག་པ།",
    "ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་སྤངས་པ་ཡིས།",
    "འཁོར་ལོའི་གཙོ་བོ་རང་གི་གསང་སྔགས་ཀྱིས།་།",
    "རང་གི་ཟས་ལ་དེ་ཉིད་གསུམ་བཟླས་ཏེ།",
    "ཕུང་པོའི་བུད་ཤིང་རྣམ་པར་བསྲེག་པ་ཡི།",
    "བདག་ཉིད་དམ་ནི་གཞན་དག་རང་རང་གི།",
    "ལྡང་བའི་དུས་སུ་དམ་ཚིག་ལྷ་མོ་ཡི།",
    "དེ་ཉིད་གསུམ་མཆོད་བྱས་ནས་རང་གི་སེམས།",
    "རང་གི་མི་མཐུན་ཤིན་ཏུ་འགག་པར་བྱེད།",
    "ཐ་མལ་པ་ཡི་རང་གི་ངོ་བོ་ལས།",
    "ཡེ་ཤེས་བསམ་ཡས་སྐད་ཅིག་གིས་སྒྲུབ་པ།",
    "དཔལ་ལྡན་ཀུན་དུ་བཟང་པོའི་རང་གི་ནི།",
    "རྣམ་པར་བསྟན་པས་མཛད་པ་འདིས་མཆོག་གི།",
    "༧པེ་སྣར་གི།",
    "པེ་སྣར་བྱེང་གིས་བྱིན་བརླབས།",
    "བྱེད་བསྡུར་འབྲས་རེའུ་མིག་རྒྱུད།",
    "ཡན་ལག་བཞི་པའི་སྒྲུབ་ཐབས་ཀུན་དུ་བཟང་མོ་ཞེས་བྱ་བ།",
    "ཡན་ལག་བཞི་པའི་སྒྲུབ་ཐབས་ཀུན་དུ་བཟང་མོ་ཞེས་བྱ་བ།་",
    "གཏོང་བ་ལ་སོགས་ཡོན་ཏན་བརྒྱད་པ་ཟབ་མོའི་ཚུལ་ལ་མོས་པའམ།",
    "བདག་གི་ཡིད་༦ལ་གནས་པའི་བདེ་བར་གཤེགས་ལ་རྟག་ཏུ་སྐྱབས་སུ་མཆི།",
    "འཕགས་པར་གནས་པའི་གྲུ་གསུམ་ནང་གི་མཁའ་ཡི་རང་བཞིན་རྡོ་རྗེ་འཛིན།",
    "ཧཱུཾ་གིས་རྡོ་རྗེ་བརྒྱན་པའི་ས་ལ་ཀུན་དུ་བཟང་པོ་ལས་བྱུང་བསྒོམ།",
    "དགའ་བའི་རྫུ་འཕྲུལ་སྒྲ་ཡིས་རྒྱལ་བའི་ཚོགས་རྣམས་རང་གི་ལུས་ནང་བཞུགས།",
    "དེ་ནི་སྤྱན་ལ་སོགས་པའི་ལྷ་མོ་གཟུགས་སོགས་ཡུལ་གྱི་རང་བཞིན་པས།",
    "རྣམ་སྣང་མཛད་སོགས་བདེ་གཤེགས་ཛ་ཁྱེཧཱུཾ་བཾ་ཧོ་གེཁཾ་རེ་བརྗོད་པས་གཟུགས་ཀྱི་རྡོ་རྗེ་ལ་སོགས་སོ།",
    "འདི་ལྟར་སྤྱན་ལ་སོགས་པའི་ལྷ་མོའི་ཞེདབྱངས་ཀྱི་སྒྲ་ཡིས་བསྐུལ་བར་བསམ།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་གསུང་སྟེ་ཀུན་ལ་ཕན་པའི་ཐུགས་བརྩེ་བ།",
    "འཇིག་རྟེན་དག་གི་དགོངས་པའི་དོན་མཛད་པ་ལ་རྟག་ཏུ་བརྩོན།",
    "བྱེད་ནི་རྡོ་རྗེའི་འདོད་པ་དམ་ཚིག་མཆོག་གི་ཕན་དོན་ཆེ།",
    "ཧཱུཾ་གི་ཐུགས་ཀྱི་རྡོ་རྗེ་ཁ་དང་མགོ་ལ་པདྨ་འཁོར་ལོའི་དཀྱིལ་དུ་ཡང་།་",
    "ཨདང་ཕྱག་མཚན་གཉིས་ཀྱིས་གསུང་གི་རྡོ་རྗེ་སྐུ་ཡི་རྡོ་རྗེའང་བསམ་པར་བྱ།",
    "དེ་ཐུགས་འོད་ཟེར་རྒྱུན་གྱིས་རང་གི་ཤེས་རབ་དང་སྦྱོར་སྣང་བས་ཀུན་དུ་ནི།",
    "གསུང་གི་རྡོ་རྗེས་མཛད་དུ་གསོལ།",
    "གསུང་གི།",
    "ཏྟྭཾ་གི་རྡོ་རྗེར་བྱུང་ནས་དྲི་མེད་པདྨ་ལ་གནས་དམ་པའི་ཡིད་ཀྱི་གཟུགས།",
    "བསམས་ནས་རང་གི་སྙེང་བོས་བསྐྱེད་པ་ཐམས་ཅད་གཞི་ཡི་དཀྱིལ་འཁོར་ལྷ་གཟུགས་སུ།་",
    "ཊུམཆོག་གི་རྗེས་སུ་དཀར་མོ་ཞེས་པར་མཐའ་ཡས་ཡོན་ཏན་རིན་ཆེན་མ།",
    "དེ་དག་གི་ནི་རིམ་པའི་ངེས་པའི་ལྷག་མའི་ཇི་ལྟར་འདོད་པའི་ཕྱག་བསྣམས་ཡིན།",
    "གཟུགས་སོགས་རྡོ་རྗེ་ལྷ་མོ་སྐུ་ལ་སོགས་དང་གསུམ་གྱིས་སོ།",
    "གསུང་གི་བཞིན་དུ་ཕྱག་ལ་སོགས་པ་དུ་མས་སྡང་བ་འཇིགས་བྱེད་ཞལ།",
    "པདྨའི་ནང་གི་རང་གི་ས་བོན་འོད་ཀྱིས་དྲངས་ནས་གཟུགས་སོགས་ཐམས་ཅད་ནི།",
    "རྟོག་པ་ཐམས་ཅད་ངེས་གྲོལ་མཆོག་གི་བདེ་བ་འབྱུང་རྒྱུའི་དངོས་ལྡན་པའི།",
    "གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ཀྱིས་དེ་བཞིན་ཕྱི་མའི་དྲི་སོགས་ཐམས་ཅད་ཀྱིས།",
    "གང་གི་ངོ་བོ་གང་ཡིན་དེ་ཡིས་སྒོ་དདེ་ཉིད་རྟོགས་པའི་གཞི་སྟེ་ཅི་ཕྱིར་དངོས།",
