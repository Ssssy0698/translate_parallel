    "ཚིག་མཛོད་རྙིང་པ་རེ་གཉིས་ལ་མ་གཏོགས་མི་གསལ་བའི་གནས་སུ་གྱུར་འདུག།",
    "དེ་མཚུངས་དེ་དག་གི་མིང་བརྡ་དང་ཐ་སྙད་མང་པོ་ཞིག་ཀྱང་མི་རབས་རྗེས་མར་བརྒྱུད་སྤྲོད་སྦྱང་སྤྱོད་བྱེད་མ་ཐུབ་པས་ན།",
    "ཞིབ་ཏུ་འོག་ནས་འཛམ་བུ་གླིང་ཞེས་པར་གཟིགས།",
    "དང་པོ་ལྟར་ན་བོད་ཡིག་སྟེང་གི་སྔོན་མེད་གསང་བ་མང་པོ་ཞིག་ཤེས་རྟོགས་ཐུབ་པར་ཁེ་ཕན་ཆེ་ལ།",
    "གཉིས་པ་དེས་ཀྱང་བོད་ཀྱི་ཐ་སྙད་གསར་བཟོ་ལ་ཕན་ནུས་འདོན་ཐུབ་པས་ཞིབ་འཇུག་གི་རིན་ཐང་ལྡན་ནོ།",
    "སྤྱིར་བོད་ཀྱི་ཐ་སྙད་ནི་བགྲང་གིས་མི་ལང་ལ་ཐེངས་འདིའི་ལས་གཞི་ཡང་བོད་ཀྱི་ཐ་སྙད་ཀྱི་བྱུང་བའམ་འབྱུང་རྩའི་ཤེས་བྱ་ཀུན་ཁྱབ་ཤོག་ངོས་༤ པར་གསལ།",
    "བོད་ཀྱི་ཐ་སྙད་ཀྱི་འབྱུང་ཁུངས་དང་ཐ་སྙད་འབྱུང་ཁུངས་རིག་པ་འདིར་ངེས་པར་དུ་ཞིབ་འཇུག་བྱ་དགོས་པར་སྙམ་མོ།",
    "བོད་ཀྱི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་ཞིབ་འཇུག་གི་ལས་འགན།",
    "བོད་ཀྱི་ཐ་སྙད་འབྱུང་ཁུངས་རིག་པའི་ཞིབ་འཇུག་གི་ལས་འགན་གཙོ་བོ་ནི།",
    "བོད་ཀྱི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་ཀྱི་ཞིབ་འཇུག་གི་ཐབས་ལམ།",
    "བོད་ཀྱི་ཐ་སྙད་ནི་བགྲང་གིས་མི་ལང་ཞིང་།",
    "དེའི་འབྱུང་ཁུངས་འཚོལ་བའི་རིག་པ་དེ་སྔ་བོད་ལ་མེད་པས་ང་ཚོས་བོད་ཀྱི་ཐ་སྙད་ཀྱི་འབྱུང་ཁུངས་བཙལ་འཚོལ་བྱེད་པར་ངེས་པར་དུ་ཐབས་ལམ་གཞན་ཞིག་ལ་མི་བརྟེན་ཀ་མེད་རེད།",
    "དེས་ན་ང་ཚོས་རྒྱལ་ཁབ་དང་མི་རིགས་གཞན་པའི་ཐ་སྙད་འབྱུང་ཁུངས་རིག་པའམ་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་ལ་དཔེ་བལྟས་ཏེ་བོད་རང་གི་ཐ་སྙད་འབྱུང་ཁུངས་ལ་ཞིབ་འཇུག་བྱ་དགོས།",
    "གཞན་གྱི་ལག་རྩལ་སྤྱད་དེ་རང་གིས་དངོས་པོ་གསར་བསྐྲུན་བྱ་རྒྱུ་དེ་རེད།",
    "རང་རེའི་ཁྱིམ་མཚེས་རྒྱ་ནག་ལ་མཚོན་ནའང་མཁས་མངས་བསྡུ་བསྐོང་གིས་ལོ་མང་རིང་ཐ་སྙད་འབྱུང་ཁུངས་རིག་པའམ་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་ཞིབ་འཇུག་ལེགས་གྲུབ་བྱུང་སྟེ།",
    "བདག་གིས་དཔྱད་ཞིབ་དང་འཚོལ་སྒྲུབ་བྱས་པའི་བོད་ཀྱི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་ཅེས་པའི་དེབ་ཆུང་འདི་ནི་དུས་ཡུན་ལོ་གསུམ་གྱིས་རྒྱས་བཅད་ཀྱི་དེབ་ཅིག་ཡིན་པ་དང་།",
    "བདག་གིས་དཔྱད་ཞིབ་མེད་དོ།",
    "གོང་ཞུས་ལྟར་བོད་ཀྱི་ཐ་སྙད་ལ་བགྲང་གིས་མི་ལང་བ་ཡོད་ཕྱིར།",
    "དེ་ལ་ཞིབ་འཇུག་བྱེད་པའི་ཐབས་ལམ་འདི་འདྲ་ཞིག་རེད་ཟེར་བའི་མཛུབ་མོ་རི་སྟོན་ཙམ་བྱ་རྒྱུ་དེ་ཡིན།",
    "ང་ཚོས་ཚིག་མཛོད་འདི་ལྟ་བུ་ཞིག་རྩོམ་སྒྲིག་བྱ་བར་འབྱུང་འགྱུར་མི་རྒྱུ་དུས་གསུམ་གྱི་སྟོབས་ཤུགས་བཀོལ་དགོས་པར་སྙམ་ལ།",
    "ང་ཚོས་ཚིག་མཛོད་འདི་ལྟ་བུ་སྒྲིག་པར་ངེས་པར་ལོ་མང་འགོར་སྲིད་དེ།",
    "རྒྱ་ནག་ལྟ་བུར་མཚོན་ན་མཁས་པ་མངས་པོས་ལོ་མངས་པོར་ངལ་བ་ལྷུར་བླངས་རྗེས་ད་གཟོད་ཚིས་ཡོན་ཚིས་ཏེའན་ཞེས་པའི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་གྲུབ་པ་རེད་ལ།",
    "རྩོམ་སྒྲིག་གི་ཕྱག་ལས་ལོ་ངོ་ཧྲིལ་བོ་སོ་དྲུག་ལྷག་ལ་གནང་བ་དང་།",
    "བདག་ལྟ་བུའི་ཤེས་པ་དམན་པའི་ལས་དང་པོ་བ་ཞིག་གིས་དུས་ཐུང་ལོ་གསུམ་ཙམ་གྱི་རིང་ལ་སྔ་ན་མེད་པའི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་གསར་རྩོམ་གྱི་བྱ་བ་འདི་གང་འདྲ་ཞིག་ཐོན་མིན་ནི་རང་ལའང་ད་ལྟ་ཧ་ཅང་ལྐོག་གྱུར་གྱི་གནས་ཡིན་ཀྱང་།",
    "སྐྱ་ཐིག་ཙམ་བཀོད་ཐུབ་པ་འདི་ནི་ཤེས་དམན་བདག་གིས་མཁས་པར་བཀའ་འདྲི་དང་རང་གིས་བསམ་ཞིབ་བྱས་པའི་གྲུབ་འབྲས་ཆེན་པོ་ཞིག་ལ་བསམས་ཀྱིན་ཡོད།",
    "འོན་ཀྱང་བོད་ཀྱི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་འདི་ལྟ་བུ་ནི་དེ་ལྟ་མིན་པར་མིང་དང་ཚིག་རེ་རེའི་འབྱུང་ཁུངས་དང་མ་ཚིག་གར་ཡོད་ལ་ཁུངས་གཏུགས་ཏེ་དེའི་འགྲེལ་བཤད།",
    "རྗེས་ཕྱོགས་བདག་གི་ལས་གཞི་འདི་ལ་རྒྱབ་སྐྱོར་དང་ལམ་སྟོན་གང་མང་གནང་རོགས་ཞུ།",
    "དེས་ན་ཐོག་མར་ང་ཚོས་ཡིག་རྙིང་དེ་དག་ལས་བོད་ཀྱི་སྐད་བརྡའི་མིང་ཚིག་དག་འཚོལ་དགོས་ལ།",
    "གོང་དུ་ཞུས་པ་བཞིན་བོད་ཀྱི་ཐ་སྙད་འབྱུང་ཁུངས་ཚིག་མཛོད་འདི་བཞིན་རྩོམ་སྒྲིག་བྱ་བར་བདག་ལྟ་བུའི་ཤེས་པ་དམན་པ་ཞིག་གིས་དུས་ཡུན་ལོ་གསུམ་ཙམ་གྱི་རིང་ལ་གྲུབ་འབྲས་བཟང་པོ་ཞིག་ལོན་རྒྱུ་ཆེས་དཀའ་ནའང་།",
    "མ་རྟོགས་ལོག་རྟོག་གི་ཆ་མང་དུ་ཡོད་ངེས་པས་དཔྱོད་ལྡན་རྣམས་ཀྱིས་འཛེམ་ཟོན་མེད་པར་དགེ་སྐྱོན་ཅི་ཡོད་ཐད་ཀར་ཡོ་བསྲང་གནང་རྒྱུ་དང་།",
    "རྒྱ་ཀུན་དོང་ནི་བཙོང་ངམ་ཙོང་སྒོག་རིགས་ཤིག་གི་མིང་ཡིན།",
    "གྱིམ་ཤིང་ཀོང་ཇོ་འདིའི་ཚ་མོ་ཡིན་ཞེས་དེབ་སྔོན་ལས་གསུངས་པ་བརྟག་པར་ཞུ་གི་ཁྲི་ལོའི་མིང་ཡིན་ཞིང་།",
    "དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱིས་ཐང་རྒྱལ་རབས་ཀྱི་གོང་མ་ཐང་ཀྲུང་ཙུང་གི་ཁྲི་ལོའི་དག་ཡིག་ལི་ཤིའི་གུར་ཁང་།",
    "ཐ་སྙད་འདི་ནི་བོད་རྒྱལ་ཁྲི་རལ་གྱི་སྐབས་སུ་བཞེངས་པའི་ཁྲང་ཆིང་མཐུན་འབྲེལ་རྡོ་རིང་གི་ཡིག་ཕྲེང་༢༧ པར་ཀེང་ལུང་ལ་ཀིམ་ཤེང་ཀོང་ཅོ།",
    "ཞེས་ཡིག་རྙིང་གི་མཆན་དུ་བཏབ་པ་ནི་ཤིན་ཏུ་མད་དོ།",
    "སྐབས་དེ་ནི་སྟག་གི་ལོ་སྟེ་ཕྱི་ལོ་༧༦༢ལོར་བོད་ཀྱིས་དམག་དྲངས་ཤིང་།",
    "༧༦༣ ལོར་བོད་དམག་གིས་རྒྱའི་རྒྱལ་ས་ཁྲང་ཨན་མཁར་ཉིན་བཅོ་ལྔར་བཟུང་ཞིང་རྒྱ་རྗེ་གསར་དུ་བསྐོས་རྗེས་བོད་དམག་ཕྱིར་འཐེན་བྱས་སྐོར་ཡིག་རྙིང་དག་ལས་འབྱུང་ངོ།",
    "ལོ་མ་རིང་ལ་ལེབ་མོ་དང་མེ་ཏོག་དཀར་པོ་ལ་ས་བོན་ནག་པོ་འཁྲུངས་པ་ཡིན།",
    "རྒྱ་ཀེའུ་ལེའམ་ཀའུ་ལི་ཞེས་པའི་ཐ་སྙད་འདི་ནི་དེང་གི་ཁོ་རི་ཡ་ཞེས་པའི་རྒྱལ་ཁབ་ཀྱི་མིང་ཡིན་ལ།",
    "སྔ་མོ་ཞིག་ནས་ཡུལ་དེའི་མིང་ལ་ཀའོ་ཅུས་ལི་ཟེར་ཞིང་།",
    "ཐ་སྙད་འདི་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་སླེབས་ནས་ད་བར་དུ་ཧ་ལམ་མི་ལོ་ཆིག་སྟོང་ཉིས་བརྒྱ་ཙམ་སོང་ཟིན།",
    "ཞེས་སོགས་ཐང་གི་གོང་མ་ཐང་ཐའི་ཙུང་གིས་ཀའོ་དེབ་དཀར།",
    "ཀའི་སུའུ་ཝེན་གྱིས་ངོ་ལོག་གིས་རྒྱལ་པོ་ཅན་ཝུ་དང་བློན་པོ་བརྒྱ་ཕྲག་ཙམ་བསད་པའི་ནང་འཁྲུག་བསླངས་ཏེ་རང་ཉིད་རྒྱལ་པོར་བསྡད།",
    "རྒྱའི་གོང་མ་ཐང་ཐའི་ཙུང་གིས་གོ་སྐབས་དེ་དང་བསྟུན་ནས་དཔུང་འཇུག་བྱས་ཀྱང་ཕམ་ཁ་བྱུང་སྟེ་ཕྱིར་ལོག་བྱས་པ་གོང་ཞུས་དང་།",
    "གོང་གི་ཡིག་རྙིང་དེ་ཉིད་ལས།",
    "ཞང་ལེགས་བཟང་གིས།",
    "ཞེས་དང་ཁང་སཾ་གྱིས་བདག་པོར་བསྐུར་བའི་རེ་ཞུ་ཡི་གེ་ལས་འབྱུང་ཞིང་།",
    "ཁོང་གིས་བཀའི་འཕྲུལ་བློན་བཞིའོ་ཞེས་པའི་བཀའ་ཡི་འཕྲུལ་བློན་ཟེར་བ་དེ་བསྡུས་མིང་ལ་བཀའ་བློན་ཞེས་ཆགས་པ་དང་།",
    "སྔ་རབས་བོད་བཙན་པོའི་སྐབས་ཀྱི་དགུང་བློན་ཆེན་པོའི་འོག་གི་བློན་ཆེན་རིམ་པ་གཉིས་པའི་གྲས་ཡིན།",
    "ཇ་པ་ཤོག་ངོས་ཉེར་གཅིག་གི་མདུན་ངོས་སུ་གསལ།",
    "སྦྱར་ར་བ་བློ་གྲོས་རྒྱལ་པོ་གཉིས་བཀའ་བློན་ལ་བསྐོས་རྗེས་སུ་རིམ་པས་ལས་དོན་བྱེད་ཕྱོགས་སྐོར་ལ་བཀའ་བློན་རྣམས་མི་མཐུན་པ་ཆེ་རུ་སོང་བར་བརྟེན།",
    "༧གོང་ས་བདུན་པ་མཆོག་གིས་བཀའ་བློན་ཚོར་པའི་སེ་ཁང་ཆེན་པས་བཀའ་བློན་གཙོ་བོ་དང་།",
    "སེར་མོ་བ་མགྲོན་གཉེར་དར་ཧན་ཉི་མ་རྒྱལ་མཚན་འབྲོང་རྩེ་བ་བཅས་ལ་བསྐོ་བཞག་དང་།",
    "བཀའ་ཤག་དམ་ཕྲུག་ཁ་རིས་སུ་སྲིད་ཞིའི་བདེ་སྐྱིད་འཁོད་པ་༧གོང་ས་བདུན་པ་མཆོག་གིས་ཐུགས་སྨོན་མཚམས་སྦྱོར་དང་བཅས་བཀའ་བློན་ཐུན་མོང་གི་ཕྱག་ཏུ་གསོལ་རས་སྩལ་ཅིང་།",
    "བཀའ་བློན་ལས་འཁུར་འདི་བཞིན་དོན་དུ་སྲིད་སྐྱོང་གི་གནས་དང་ཁྱད་པར་མེད་གཤིས།",
    "ཁོང་ཚོའི་ལས་འགན་ནི།",
    "ཞེས་པ་ནི་དེ་སྔ་བདག་གིས་མཐོང་བ་ཐོག་མ་དེ་ཡིན་ལ།",
    "སྐར་མ་ནི་ནམ་མཁའི་དབྱིངས་ནས་རང་གིས་འོད་འབྱིན་པའམ་གཞན་གྱི་འོད་ཕོག་པར་བརྟེན་ནས་འོད་འཕྲོ་བའི་གནམ་གཟུགས་རྣམས་ཀྱི་སྤྱི་མིང་ཡིན།",
    "བོད་ཀྱི་བློན་ཆེན་པོ་ཁྲི་འབྲིང་བཙན་བྲོད་ཀྱི་ཁ་དོར་གྱི་ཚིག་བཀོད་པ་སྐར་མ་གནམ་གང་ཡོད་པ་ཡང་ཉི་མ་གཚིག་གི་འོད་ལ་མྱེད་དོ།",
    "ནམ་རྒྱུན་མཚན་མོ་མཁའ་དབྱིངས་སུ་འོད་འཕྲོ་བར་བྱེད་པའི་གནམ་གཟུགས་ལ་སྐར་མ་ཟེར་བ་ཡིན།",
    "རྒྱ་ནག་གི་སྒོར་མོའི་གྲས་སུའང་རྒྱུ་ཧ་ཡང་གིས་བཟོས་པ་ཞིག་ཡོད་པ་དེ་ལ་སྐར་མ་ཟེར་ཞིང་།",
    "དམག་དཔོན་ཚོའི་ཞྭ་མོའི་སྟེང་དང་ལཱ་བའི་ཕྲག་སྟེང་དུ་རྩེ་ལྔ་འདོགས་པ་དེར་ཡང་སྐར་མ་ཟེར་སྲོལ་ཡོད།",
    "སྟོང་དཔོན་དུ་གཞན་སུ་ཡང་མི་བཞུག་པར་བློན་སྟག་སྒྲ་ཀླུ་ཁོང་གི་སྐྱེས་པོ་གསས་སླེབས་གྱི་བུ་ཚ་རྒྱུད་པེལད་ལས་གང་རྔོ་ཐོག་པའ།",
    "འཕན་པོའི་སྐུ་སྲུང་དམག་གི་སྟོང་དཔོན་གྱི་གོ་གནས་དེ་ནི།",
    "བློན་སྟག་སྒྲ་ཀླུ་ཁོང་གི་མེས་པོ་མིང་ལ་གསེས་སླེབས་ཟེར་བ་དེའི་ཕ་ཚ་བུ་རྒྱུད་རྣམས་ཀྱི་ནང་ནས་གང་ཞིག་གིས་གོ་གནས་འཛིན་ཐུབ་ཅིང་དམངས་ཀྱིས་ཀྱང་ཡིད་མཐུན་བྱེད་པ་དེ་ལ་འཕན་པོའི་སྐུ་སྲུང་དམག་གི་སྟོང་དཔོན་གྱི་གོ་གནས་དུས་གཏན་དུ་སྤྲད་ཆོག་པའི་བཀའ་གནང་།",
    "ཐ་སྙད་འདི་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་བཀོད་ནས་ད་བར་ཧ་ལམ་མི་ལོ་གཅིག་སྟོང་ཉིས་བརྒྱ་ནས་སུམ་བརྒྱ་ལྷག་སོང་ཟིན་ཅིང་།",
    "གནམ་རིའི་བློན་པོ་ཞང་སྣང་གི་མགུར་ཚིག་ལས།",
    "དབྱི་ཚབ་ནི་པངས་ཏོ་རེ།",
    "བདག་གིས་ནི་སྐྱི་ཞེས་པ་དག་པར་སེམས་ཤིང་།",
    "ཆུ་སོགས་འཆུ་བྱེད་ཀྱི་ཡོ་བྱད་ཅིག་གི་མིང་སྟེ།",
    "སྔ་མོའི་དུས་སུ་ཤིང་གིས་བཟོས་པ་མང་ཞིང་།",
    "སྐབས་དེར་རྒྱལ་པོའི་བླ་ནས་བོན་རྗེ་དང་བོན་པོ་དག་ལ་ཉིན་རེའི་ཟས་ཐོབ་ཅི་ཡོད་བརྗོད་སྐབས་བོན་པོ་རེ་ལ་ཆང་སྐྱོགས་བཅུ་སྟེ་ཐུལ་གསུམ་རེ་ཏུན་ཧོང་ནས་ཐོན་པའི་གནའ་བོའི་བོད་ཡིག་ཤོག་དྲིལ།",
    "ཆང་འཁྱོར་བའི་ནང་དུ་བླུགས་ཏེ་བཏུང་།",
    "ཆང་འཁྱོར་བར་འཐུང་དགོས་དོན་ཨེ་ཡོད་སྙམ་པས་དཔྱད་པར་ཞུ།",
    "ཁབ་ནི་ལཱ་བ་ཚེམ་དྲུབས་ཀྱི་ཡོ་བྱད་རྣོ་ལྕགས་རིགས་ཤིག་གི་མིང་ཡིན།",
    "ལས་གནའ་བོའི་བོད་ཀྱི་སྙན་ངག་གི་ཚིགས་བཅད་གདངས་སུ་གྱེར་ནས་ཤགས་འགྱེད་སྲོལ་ཡོད་པ་དང་།",
    "བོད་རྒྱལ་གནམ་རི་སྲོང་བཙན་གྱི་བློན་པོ་མྱང་ཞང་སྣང་གི་མགུར་ཚིག་ལས།",
    "ཀོམ་རྩེ་ནི་གཟིག་མོ་རྒྱལ།",
    "རྒྱུས་ཀྱི་ནི་རེ་མྱི་སུགས།",
