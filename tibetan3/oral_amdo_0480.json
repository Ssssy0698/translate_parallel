    "ཕྱི་ལོ་༧༣ ལོར་བོད་དང་མཛའ་མཐུན་བྱས་ནས་བོད་ཀྱི་རྒྱལ་པོ་ཁྲི་ལྡེ་གཙུག་བརྟན་གྱི་སྲས་མོ་ཞིག་ཡུ་གུར་རྒྱལ་པོ་ཟུ་བློ་བྱ་བའི་བཙུན་མོར་སྩལ།",
    "ཞེས་གིལ་གིད་དང་ཡུ་གུར་ཞེས་སོ་སོར་འཁོད་ཀྱང་དོན་ལ་གར་ལོག་མིན་ནམ་སྙམ་ཞིང་།",
    "ཕྱི་ལོ་༧༣༦ དང་༧༣ ཞེས་ལོ་དྲུག་གི་ཁྱད་པར་ལས་ཁྲི་ལྡེ་གཙུག་བརྟན་གྱི་སྲས་མོ་ཡིན་པ་གཅིག་མཚུངས་དང་།",
    "གུ་གེ་གུ་གེ་ནི་གནའ་བོའི་ཞང་ཞུང་གི་རྒྱལ་སའི་མིང་སྟེ།",
    "སྒམ་པོའི་སྐབས་སུ་ཁོང་གི་སྲང་མོ་ཞང་ཞུང་རྒྱལ་པོ་ལིག་མི་སྐྱའི་བཙུན་མོར་གཤེགས་ཤིང་།",
    "བཙུན་མོ་སད་མར་ཀར་གྱིས་གཅེན་པོ་སྲོང་བཙན་ལ་ངག་འཕྲིན་གྱི་མགུར་བཞེངས་སྐབས་ཀྱི་ཚིག་དུམ་ཞིག་ཡིན་པས་ན།",
    "གུ་གེ་ནི་ཞང་ཞུང་གི་རྒྱལ་ས་སྟེ།",
    "མངའ་རིས་མགོན་སྐྱིད་བདེ་ཉི་མ་མགོན་གྱི་བུ་ཆུང་བ་ལྡེ་མཚོ་མགོན་གྱིས་ང་ནུབ་ཀྱི་གཡའ་རི་སྔོན་པོས་འཁོར་རེ་བསྐོར་བ།",
    "དེའི་སྔོན་མེད་པར་འདོད་དགོས་པས་གོང་གི་ཏུན་ཧོང་ཡིག་རྙིང་དང་ཡང་འགལ་བས་ཁས་ལེན་པའི་ཐབས་མེད་དོ།",
    "གནམ་རི་སྲོང་བཙན་སྐབས་སུ་ཡོངས་གྲགས་བོད་ལ་ཡི་གེ་མེད་ཀྱང་ཞང་ཞུང་གི་ཡི་གེའམ་གང་ལྟར་ཡི་གེ་ཞིག་བེད་སྤྱོད་བྱེད་བཞིན་པ་སྐབས་དེའི་རྒྱལ་བློན་བར་གྱི་མགུར་ཚིག་དང་།",
    "གསེར་གྱི་ཡི་གེ་ལས་སྨད་རེའ།",
    "སྲོང་བཙན་གྱི་སྲང་མོ་སད་མར་ཀར་གྱི་སྐོར་གླེང་སྐབས།",
    "བཙན་མོས་བཀའ་ལན་ཡི་གེར་གསོལ་པ་ནི་ཆང་མ་མཆིས།",
    "དབྱི་ཚབ་ལ་ཡི་གེ་སྩལ་སྐབས་ཀྱང་ཡར་ཀླུང་གཅིག་གྱུར་བྱས་མེད་པས་ཐོན་མི་རྒྱ་གར་དུའང་མ་སོང་བའི་སྔོན་ཡིན་པ་དང་།",
    "རྒྱའི་ཐང་གི་ལོ་ཙཱ་བ་ཐང་སན་ཙང་ངམ་ཞོའོན་ཙང་ཕྱིར་རྒྱ་ཡུལ་དུ་ལོག་རྗེས་ཀྱི་ལོ་བཞིའི་ཕྱིས་པ་བཅས་ཀྱིས།",
    "སྐབས་དེར་བོད་རང་ལ་ཡི་གེ་མེད་ཀྱང་ཞང་ཞུང་གི་ཡི་གེའམ་གང་ལྟར་ཡི་གེ་ཞིག་བེད་སྤྱོད་བྱེད་བཞིན་ཡོད་པ་སུས་ཀྱིས་བསྙོན་དུ་མེད་དོ།",
    "བོད་བཙན་པོའི་རྒྱལ་རབས་མ་ཚུགས་གོང་གི་ཞང་ཞུང་རྒྱལ་རབས་ཀྱང་ས་གནས་འདིར་ཆགས་པར་གསུངས་ཀྱང་།",
    "ཞང་ཞུང་ནི་སྐབས་དེའི་ཞང་ཞུང་རྒྱལ་ཁབ་སྤྱི་དང་གུ་གེ་ནི་སྐབས་དེའི་ཞང་ཞུང་གི་རྒྱལ་ས་ལྟ་བུར་འདོད་ན་ཤིན་ཏུ་ལེགས་སྟེ།",
    "བཙན་མོ་སད་མར་ཀར།",
    "ཞང་ཞུང་གི་རྒྱལ་པོ་ལ་དྲངས་སྟེ།",
    "ཞང་ཞུང་གི་རྒྱལ་པོ་ལིག་མི་རྟ་སྲིད་བརླག་སྟེ།",
    "ཞེས་བོད་ཀྱི་བཙན་པོ་སྲོང་བཙན་གྱི་རང་གི་སྲང་མོ་ཞང་ཞུང་དུ་ཆབ་སྲིད་ལ་གཤེགས་པ་དང་ཞང་ཞུང་བོད་འབངས་སུ་བཀུག་ཟེར་པ་སོགས་ལས་གུ་གེ་མི་ཟེར་ཞིང་།",
    "གུ་གེ་ནི་ཞང་ཞུང་གི་རྒྱལ་ས་ཡིན་ལ་ཞང་ཞུང་ནི་རྒྱལ་ཁམས་སྤྱིའི་མིང་ཡིན་པ་ཤེས་དགོས་སོ།",
    "དེའི་ལྷ་ཆེན་མོ་ནི་ཧི་མ་ཅལ་དང་།",
    "ལྷ་འདི་ལ་རྒྱ་གར་པས་གུ་གར་དེའུ་འམ་གུ་གར་སིར་ཞེས་མཚན་བཏགས་པ་རེད།",
    "ནགས་ཚལ་གྱི་རྒྱ་ཁྱོན་ཅི་ཡོད་སོགས་ཞིབ་ཏུ་ནི་དུང་དཀར་ཚིག་མཛོད་ཤོག་ངོས་༤༩༤ པར་གསལ་བས་དེར་གཟིགས་པར་ཞུ།",
    "སྤྱིར་ཐ་སྙད་འདི་དུས་ནམ་ཞིག་ནས་བོད་ཀྱི་སྐད་བརྡའི་སྟེང་དུ་སླེབས་པ་མི་ཤེས་མོད།",
    "ཆུ་གཞའ་གསང་དུ་སོང་བ་ཡང་།",
    "གྲུ་འདོམ་གང་གིས་སྐ་ཆིག་ཆོད་དོ།",
    "ཆུ་མོ་ཁ་ཞེང་ཆེ་ན་ཏུན་ཧོང་ནས་ཐོན་པའི་གནའ་བོའི་བོད་ཡིག་ཤོག་དྲིལ།",
    "༡༩༨༣ ལོར་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྐྲུན།",
    "ན་རྩི་ཞེས་པ་ནི་དེ་སྔ་བདག་གིས་གླ་རྩི་ཞེས་པའི་ཐ་སྙད་ཡིག་ཐོག་ནས་མཐོང་བ་སྔ་ཤོས་དེ་ཡིན།",
    "གྲུ་ཆུང་གཅིག་གིས་ཕ་མཐར་བཅད།",
    "ཅེས་པའི་ཚིག་དུམ་ལས་ལོ་ངོ་སྟོང་གི་ཡར་སྔོན་ནས་བོད་མིས་ཆུ་བོ་བརྒལ་བར་གྲུ་གཟིངས་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད་པ་རྟོགས་ཐུབ་ལ།",
    "ཐ་སྙད་འདི་དུས་དེ་ནས་ད་བར་མི་ལོ་ཆིག་སྟོང་སུམ་བརྒྱ་ལྷག་སོང་ཟིན་ཅིང་།",
    "དེ་སྔོན་བདག་གིས་མཐོང་བའི་གླ་རྩི་ཚོང་བསྒྱུར་བྱེད་མཁན་ཚོས་ཉོ་འཚོང་བྱེད་བཞིན་པའི་གླ་རྩི་ནི་རི་དྭགས་གླ་བའི་ལྟེ་བ་ལས་ནང་གི་རྫས་ནག་པོ་དེའི་མང་ཉུང་གིས་གོང་ཚད་འཇལ་གྱི་འདུག་པས་གླ་རྩི་ཞེས་པ་གླ་བའི་ལྟེ་བ་ལ་ཟེར་བ་ཡིན།",
    "ངར་ཐུག་གི་ནང་དུ།",
    "༡༩༨༣ ལོར་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྐྲུན།",
    "འང་གི་ཚེ་ཁྱུང་པོ་སྤུང་སད་ཀྱི་ཀླུ་བླངས་པ་འི་ཚིག་ལ།",
    "ཞང་སྣང་གིས་མཆིད་འཚལ་ཞེས་གསློ་ཏོ།",
    "ཞང་སྣང་གིས་ཀླུ་བླངས་པ།",
    "ཞིབ་ཏུ་ནི་ཡིག་རྙིང་རང་ལ་གཟིགས་པར་འཚལ།",
    "ཤིང་ཐོག་གི་རིགས་ཤིག་སྟེ་རོ་མངར་ལ་སྐྱུར་བ།",
    "དབྱིབས་རིལ་མོའམ་འཇོང་བོ་ཡིན།",
    "སྤྱིར་བོད་དུ་ཚྭ་ཟ་བའི་སྲོལ་དུས་ནམ་ཞིག་ནས་བྱུང་མིན་མི་ཤེས་མོད།",
    "ལྷང་ཞེས་པ་ར་རྒང་འདི་ཡིན་མོད།",
    "རྐང་ཅི་འདྲ་ཡོད་མེད་སྐོར་གོང་གི་ཡིག་རྙིང་དེར།",
    "མཐེབ་བུ་ས་ཚམ་རེ་རེ་དཀར།",
    "སྣའི་ཐོག་མ་ནས་མཇུག་ཐོག་གི་བར་དུ།",
    "ཀོག་ཉོ་ཡོག་ཆེས་པའ་ཞེས་གྲུ་གུའི་སྐད་དུ་ཅི་ཟེར་ཡང་བཀོད་ཡོད།",
    "སྒལ་གཞུང་གི་སྤུ་ཁ་ཤས་ཚེར་མ་བཞིན་དུ་རྣོ་ལ་སྲ་ཞིང་།",
    "རྒང་གི་རུ་ཐུར་ཞེས་དངོས་རྫས་རྩ་ཆེན་དུ་བརྩི།",
    "ལོ་གཅིག་ཅན་ལ་རྟེའུ་དང་མོ་རྟེའུ།",
    "ལོ་གཉིས་ཅན་ལ་ཐོ་རུ་ཐོར་མོ་དང་།",
    "ལོ་གསུམ་ཅན་སྒྱེའུ་དང་སྒྲ་མོ་ཟེར།",
    "བོད་རྒྱལ་གནམ་རི་སྲོང་བཙན་གྱི་བློན་པོ་ཁྱུང་པོ་སྤུང་སད་ཟུ་ཙེའི་མགུར་ཚིག་བཀོད་སྐབས་འུང་ནས་ཁྱུང་པོ་སྤུང་སད་ན་རེ།",
    "ཁྱོད་འདའས་འདྲས་དམག་པོ་འོང་ངམ།",
    "གོ་ན་འགྲིག་པ་ལས་ཡུལ་མིང་གི་ཆ་ནས་གཅིག་ཏུ་ངེས་པ་ཡིན།",
    "རང་རེའི་མཁས་པ་འགའ་ཞིག་གིས་ཞང་ཞུང་དང་མངའ་རིས་ཡུལ་ལྗོངས་སོ་སོ་ཡིན་ཞེས་དང་།",
    "ཁ་ཅིག་གིས་མངའ་རིས་ཀྱི་མིང་ཚིག་ཙམ་གོ་དོན་མ་ཤེས་པར་གང་དྲན་བྱུང་རྒྱལ་དུ་བཀོལ་བཞིན་པ་བཅས་ཀྱི་སྐོར་ཞང་ཞུང་ཞེས་པར་གཟིགས་འཚལ།",
    "དེ་ཡང་མངའ་རིས་ཞེས་པའི་ཐ་སྙད་འདིའི་མངའ་དང་རིས་ཞེས་ཐ་སྙད་དམ་མིང་རྫས་རེ་རེ་སྔ་མོ་ནས་ཡོད་སྲིད་ཀྱང་།",
    "འོན་ཀྱང་འདི་ལ་དོགས་པ་ཅུང་ཙམ་ཡོད་པ་ནི་སྲོང་བཙན་ཁོང་གི་ཡབ་ཀྱིས་རྒྱལ་སར་བཏོན་ཞེས་པ་འདི་ཡིན་ལ།",
    "གང་ལྟར་མངའ་རིས་ཞེས་པའི་ཐ་སྙད་འདི་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་སླེབས་ནས་ད་བར་མི་ལོ་གྲངས་༡༣༥ ལྷག་སོང་ཟིན་ཡང་ད་དུང་སྒྲ་དོན་མ་ཉམས་པར་སྤྱོད་བཞིན་ཡོད།",
    "ཅང་ཀེང་ལོ་དང་པོ་ལྕགས་མོ་གླང་༨༢༡གི་ལོའི་དགུན་སླ་ར་བ་ཚེས་བཅུ་ལ་དཀྱིལ་འཁོར་ལ་འཛེགས་ནས།",
    "ཅུང་རྡོག་ཅུང་རྡོག་ཅེས་པ་ནི་འབྲུ་རིགས་ཀྱི་ཕྱེ་རྡོག་རླངས་བཙོས་བྱས་པའི་གོ་རེའི་མིང་སྟེ།",
    "རྒྱུ་ནོར་གྱི་གོ་རེ་ཅུང་རྡོག་དེ།",
    "ཅུང་པེང་ཞེས་པའི་ཐ་སྙད་འདི་ནི་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་བྲིས་ནས་ད་བར་ཧ་ལམ་མི་ལོ་གཅིག་སྟོང་ཉིས་བརྒྱ་ཙམ་སོང་ཟིན་ནའང་།",
    "ཞེས་པ་ནི་དེ་སྔ་བདག་གིས་ཅུང་པེང་ཞེས་པའི་ཐ་སྙད་འདི་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་མཐོང་བ་སྔ་ཤོས་དེ་ཡིན་ལ།",
    "སྐབས་དེར་བོད་མིས་གོ་རེ་ཅུང་པེང་བཟོ་ཡི་ཡོད་མེད་མི་ཤེས་ཀྱང་།",
    "ཐ་སྙད་ནི་ཡོད་པ་གོང་གི་ཡི་གེ་དེ་ལས་ཤེས་སོ།",
    "གྲོ་ཕྱེ་རྡོག་རྡོག་རླངས་བཙོས་བྱས་པའི་གོ་རེའི་མིང་སྟེ།",
    "བོད་རྒྱའི་ལོ་ཙཱའི་གཞུང་ལུགས་ལ་མཁས་པ་ཤ་བོ་ཚེ་རིང་ལགས་ཀྱིས་ཅུར་ནིས་ཞིབ་མོ་དང་ཕྱི་ཉིལ་བརྡ་སྤྲོད་པ་སོགས་ཞང་ཞུང་གི་ཐ་སྙད་ལ་སོགས་པ་མང་ཞེས་གསུངས་པ་དག་ལ་དཔྱད་པར་ཞུ།",
    "དེང་སང་གི་རྒྱའི་སྐད་དུ་ཀྲེང་ཀོན་ཟེར་བ་དེ་བོད་སྐད་དུ་སྒྲ་བསྒྱུར་བྱས་པ་ཡིན།",
    "རྒྱུ་ཁྲོ་དང་ལི་སོགས་ལྕགས་རིགས་ཀྱིས་བཟོས་པའི་རོལ་ཆས་ཁོང་སྟོང་ཞིང་བརྡུངས་ན་སྒྲ་ཆེན་པོ་གྲག་པ་ཞིག་གི་མིང་།",
    "ཐ་སྙད་འདི་ནི་དུས་རབས་བརྒྱད་པའི་སྨད་ནས་ཕྱི་ལོ་༧༦༧ ལོར་བསམ་ཡས་རྡོ་རིངས་བཙུགས་པའི་རྗེས་སུ་བཙུན་མོ་གསུམ་པོས་ལྷ་ཁང་རེ་བཞེངས་པའི་སྐབས་སུ་བླུགས་སམ་སྙམ་པས་དཔྱད་གཞིར་ཕུལ།",
    "ལྕི་བ་ནི་ཕྱུགས་ཟོག་གི་སྐྱག་པ་རློན་པ་ལ་ཟེར་ཞིང་།",
    "ལྕི་བ་ཡ་རི་མའི་ཐལ་བ་རྒྱ་སྐམ་བཁུས་པའི་ཁུ་བ་དང་དེ་རྣམས་བསྲེས་ཏེ་ཁུར་བ་དོ་གསུམ་ཙམ་འཐུངསྣ་སྤྱི་འཛད་མྱི་སྲིདོ།",
    "རི་ལ་ཡོད་པའི་ན་ནིང་གི་ལྕི་བ་སྐམ་པོ།",
    "ཆུ་མྱིག་གཚིག་གི་དངོའ་ནས།",
    "རི་ཐང་གི་ཤིང་རྩེ་ཀུན་ཁྱེར་བ་ཡང་སྲིད་དོ།",
    "བོད་བཙན་པོའི་དུས་སྐབས་སུ་ཆང་གི་མིང་ལ་ཏུན་ཧོང་ནས་ཐོན་པའི་གནའ་བོའི་བོད་ཡིག་ཤོག་དྲིལ།",
    "སུམ་རྣམ་རེའི་འགྱེད་བཅས་གནང་ཞིང་།",
    "ཆུ་ཟངས་གང་གི་ནང་ན།",
    "ལན་ཙ་ཁྱོར་གང་བཏབ་ན།",
    "ཞེས་པ་དེ་སྔ་བདག་གིས་མཐོང་བའི་ཆུ་ཟངས་ཀྱི་ཐ་སྙད་ཡི་གེ་ཐོག་མ་དེ་ཡིན་ཞིང་།",
    "རྒྱའི་གོང་མ་ཆེན་པོ་ཆིན་ཧྲི་ཧོང་གིས་པཱ་ཧྲུའུ་གཉིས་མ་བསྣུབས་གོང་ནས་བོད་དུ་ཇ་འཐུང་སྲོལ་ཡོད་སྐོར་ཇ་ཡི་བསྟན་བཅོས་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "བོད་དབུས་ཀྱི་གྲྭ་ས་ཁག་གི་ཇ་ཟངས་ནི་འཛམ་གླིང་སྟེང་གི་ཟངས་ཆེ་ཤོས་དེ་ཡིན་པ་ཁ་ཚོན་གཅོད་ཐུབ་སྟེ།",
    "དུས་རབས་བརྒྱད་པའི་སྐབས་བོད་རྒྱལ་ཁྲི་འདུས་སྲོང་གི་སྐབས་སུ་ཡོད་པ་ཧ་ཅང་གསལ།",
    "ཞེས་པ་ནི་ཆུ་སྲིན་ཞེས་པའི་ཐ་སྙད་འདི་ཡིག་ཐོག་ཏུ་མཐོང་སྔ་ཤོས་དེ་ཡིན་མོད།",
    "འདིའི་འགྲེལ་བ་ནི་དུས་རབས་དགུ་བར་བརྩམས་པའི་སམ་བོད་ཤན་སྦྱར་གྱི་ཚིག་མཛོད་ཆེན་མོ་སྒྲ་སྦྱོར་བམ་པོ་གཉིས་པ་ཡོངས་གྲགས་སུ་སྒྲ་སྦྱོར་བམ་གཉིས་ཟེར་བ་ལས།",
    "འགའ་ཞིག་ཏུ་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་གཉིས་བག་ཆགས་དང་བཅས་པ་མ་ལུས་པ་བཅོམ་པ་སྤངས་པ་ཕུན་ཚོགས་ནི་ངོ་བོ་ཉིད་སྐུ་དང་།",
    "ཉི་མ་ཞེས་པའི་ཐ་སྙད་འདི་མ་མཐར་ཡང་དུས་རབས་བདུན་པའི་དཀྱིལ་ཙམ་དུ་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་ཡོད་པའི་ཐ་སྙད་ཅིག་ཡིན་པར་སྙམ་སྟེ་བོད་རྒྱལ་གནམ་རི་སྲོང་བཙན་གྱི་བློན་པོ་དང་སྲོང་བཙན་སྒམ་པོའི་སྐུ་ཚེ་སྟོད་ཀྱི་བློན་ཆེན་དབའས་ཕངས་ཏོ་རེ་དབྱི་ཚབ་ཀྱི་སྐོར་བཀོད་པའི་ཡི་གེ་ལས།",
    "ལུང་གི་རྗེས་ལ།",
    "དབའས་ཕངས་ཏོ་རེ་དབྱི་ཚབ་རྒས་ཏེ།",
    "ཁྲི་འདུས་སྲོང་ཕྱི་ལོ་༦༧༦༦༩༨གི་བློན་པོ་མགར་ཁྲི་འབྲིང་བཙན་བྲོད་ཀྱི་མགུར་ཚིག་ལས་ཀྱང་།",
    "ཉེ་འུ་མང་མང་ཡང་སྲམ་ཚིག་གི་ཉོད་པ།",
