    "དེ་མ་རྙེད་ན་ཕྱི་པི་ལིང་དང་ན་ལེ་ཞམ་དང་གྲུམ་པའི་སྣ་ནགུ་དང་རེའུ་ལྕགས་གྱི་ཐོག་མ་དཀར་པོ་དང་རའི་ཚིལ་དང་དེ་རྣམ་སླ་ངའི་ཐོག་ཏུ་བསྲེགསྟེ་འཛཾ་བའི་ཁང་བུ་བགྱིསྟེ་སྤྱི་གུ་བཙུགསྟེ་བཀའ་ཆེམས་མཐོང་བ་དོན་ལྡན།",
    "ཞེས་པ་ནི་དེ་སྔ་བདག་གིས་ཐ་སྙད་འདི་མཐོང་བ་ཐོག་མ་དེ་ཡིན།",
    "ནས་ནི་ལོ་ཏོག་ཅིག་གི་མིང་སྟེ།",
    "ནས་ཀལ་ཕྱེད་དང་བཆུ་བདུན་དང་བྱེ་གསུམ་དཀར་གྱི་ཁྲེ་ཁལ་ཕྱེད་དང་བྲེ་བཞི་ཕུལ་བཞི་ཁྱོར་དོད་ཞེས་པ་ནི་ནས་ཞེས་པའི་ཐ་སྙད་འདི་ཡིག་ཐོག་ནས་མཐོང་བ་ཐོག་མ་དེ་ཡིན།",
    "མ་ཡར་མོ་དང་མནའ་མ་དང་ཁྱོ་མོ་དང་།",
    "བུ་སྲིང་ཁྱོ་མོ་མཆིས་པ་འདི་རྣམས།",
    "གླང་གི་རྭ་དང་རྣ་བའི་རྭ་དང་རའི་ཏུན་ཧོང་ནས་ཐོན་པའི་གནའ་བོའི་བོད་ཡིག་ཤོག་དྲིལ།",
    "དེ་སྔ་བདག་གིས་མཐོང་བའི་རྣ་བ་ཞེས་པའི་ཡི་གེ་ཐོག་མའང་དེ་ཡིན།",
    "པི་པི་ལིང་ནི་ཟུར་ཆག་གི་སྐད་དེ།",
    "ཞེས་པ་ནི་མ་དག་རྒྱུན་འབྱམས་སུ་སོང་བར་སྙམ།",
    "དེ་མ་རྙེད་ན་ཕྱི་ཕྱི་ལིང་དང་ན་ལེ་ཞམ་དང་གྲུམ་པའི་སྣ་ནགུ་དང་རེའུ་ལྕགས་གྱི་ཐོག་མ་དཀར་པོ་དང་རའི་ཚིལ་དང་དེ་རྣམ་སླ་ངའི་ཐོག་ཏུ་བསྲེགསྟེ་འཛཾ་བའི་ཁང་བུ་བགྱིསྟེ་སྤྱི་གུ་བཙུགསྟེ་དབུས་ནས་སོ་ལ་བདུགས་ན་རྩི།",
    "བཙུན་མོ་གནང་ཆེན་ཡང་ཡཾ་འཆད།",
    "གང་གི་སྲིད་པ་ཇི་སྲིད་པར།",
    "ལོངས་སྐུའི་བདག་རྐྱེན་ལས་བྱུང་བའི་དག་མ་དག་གི་གདུལ་བྱ་རྣམས་ལ་སྣང་ཞིང་དེ་དག་གི་དོན་མཛད་པར་བསམ་བཞིན་སྲིད་པར་བཟུང་བའི་གཟུགས་སྐུའོ།",
    "གནས་བྱ་རྒོད་ཕུང་བོའི་རི་ལ་སོགས་པ་འཁོར་ཐུན་མོང་བ་དགེ་སློང་ཕ་མ་གཉིས།",
    "བྲེ་གང་ལ་ཁྱོར་བ་ཉི་ཤུ་རྩ་གཅིག་ཡོད་པས་དེ་དུམ་བུ་དྲུག་ཏུ་བགོས་པའི་གཅིག་སྟེ་ཡ་ཁྱོར་གསུམ་དང་ཕྱེད་ཀ་ལ་ཕུལ་གང་རྩི་བ་དེར་དྲུག་ཕུལ་ཟེར་ཞིང་།",
    "ཡ་ཁྱོར་ཉི་ཤུ་རྩ་གཅིག་པོ་དེ་ཉིད་དུམ་བུ་བདུན་ལ་བགོས་པའི་ཆ་གཅིག་སྟེ་ཡ་ཁྱོར་གསུམ་ལ་ཕུལ་གང་རྩི་བ་དེ་ལ་བདུན་ཕུལ་ཟེར།",
    "དཀར་ཁྲེ་ཁལ་ཕྱེད་དང་གཉིས་དང་བྲེ་བཞི་ཕུལ་བཞི་ཁྱོར་དོ།",
    "ཞེས་པ་ནི་བདག་གིས་མཐོང་བའི་ཕུལ་ཞེས་པ་སྔ་ཤོས་དེ་ཡིན་ལ།",
    "ཕུལ་བྱུང་གི་མི་སྣ་ཞེས་པ་ལྟ་བུ་སོགས་མང་ངོ།",
    "ཡང་ཏུན་ཧོང་བོད་ཡིག་ཤོག་དྲིལ་ཨང་པ་ཏེང་རེ་བྱེ་པུར་ཁ་གན་གྱི་བཀའ་ཡིག་ལས།",
    "ཡིག་རྙིང་དུ་བཙན་པོ་དང་བཙན་མོ་བྱ་བ་ལ།",
    "བཙན་ཕོ་དང་བཙན་མོ་ཞེས་བྲིས་ཏེ།",
    "བྲིལངྒའི་ལྷོ་ཤར་ཕྱོགས་སུ་སོང་བ་ན་རི་བོ་པོ་ཏ་ལ་ཡོད་ཅིང་།",
    "གནས་དེར་སྤྱན་རས་གཟིགས་དངོས་སུ་ཞལ་བཞུགས་སྲོལ་ཡོད་པ་དང་།",
    "འམ་དངུལ་པོར་གི་ནང་དུ་བརྒངས་ཏེ་ནང་ནུབ་འཐུངས་ན་རྩི།",
    "ཕྲ་མེན་ཀྱི་ཡི་གེ་པ་དང་སྟོང་མཉམ་བཡན་ཅདགཡགི་འོག་དུ་ཆུད་པ་ལ།",
    "རྒྱུ་དེང་སང་གི་རྒྱ་སྐད་དུ་ཝུན་ཝུའུ་ཧྲེང་ཧོང་ཏི་ཟེར་ཞིང་།",
    "ཐང་རྒྱལ་རབས་ཀྱི་གོང་མ་ཐང་ཐའི་ཙུང་གི་མིང་ཡིན།",
    "ཁོང་ཐང་གི་སྲིད་ཁྲི་ལ་འཁོད་པ་དང་བློན་ཆེན་རྣམས་ཀྱིས་ཁོང་ལ་ཝུན་ཝུའུ་ཞའོ་ཏེ་ཧོང་ཏི་ཞེས་བའི་མཚན་གསོལ།",
    "བོད་རྒྱལ་ཁྲི་རལ་པ་ཅན་གྱི་སྐབས་སུ་བཞེངས་པའི་ཁྲང་ཆིང་མཐུན་འབྲེལ་རྡོ་རིང་གི་ཡི་གེ་ངོ་བཤུས་ལས།",
    "བོད་རྗེ་ཁྲི་རལ་དང་རྒྱ་རྗེ་འདི་གཉིས་ཀྱིས་ཆབ་སྲིད་གཅིག་ཏུ་མོལ་ཅིང་།",
    "བོད་ཅེས་པའི་ཐ་སྙད་འདི་བོད་རྒྱལ་ཐོག་མ་གཉའ་ཁྲི་བཙན་པོ་ཡུལ་ཡར་ཀླུང་ཚོ་བ་བོད་ཀ་གཡག་དྲུག་གི་ཚོ་དཔོན་ནམ་རྒྱལ་པོར་བཞུགས་པ་དང་།",
    "མེ་ལུགས་ཕྱི་ལོ་གོང་གི་ལོ་༡༣༤ ལོར་བྱོན་པར་བཞེད།",
    "ཤིང་སྟག་ཕྱི་ལོ་གོང་གི་༡༡༧ ལ་འདོད།",
    "ཕུག་ལུགས་ལྟར་ན་ཤིང་སྟག་ཕྱི་ལོ་གོང་གི་༡༢༧ ལོར་བྱོན་པར་བཞེད།",
    "ས་སྤྲེལ་ཕྱི་ལོ་གོང་གི་༢༡༣ ལོ་འཁྲུངས་པར་འདོད།",
    "ཤིང་བྱི་ཕྱི་ལོའི་གོང་གི་ལོ་༢༣༧ ལོར་བཞེད།",
    "འདི་ལྟ་བུའི་བཞེད་པ་མང་བས་བོད་ཅེས་པའི་ཐ་སྙད་འདི་བྱུང་ནས་ད་བར་ལོ་ཅི་ཙམ་སོང་ཡོད་པ་ཁ་ཚོན་གཅོད་དཀའ་སྟེ།",
    "༡གཡས་རི་སྟག་ཚང་བ་ལྟར་ན་ད་བར་དུ་ལོ་གྲངས་༢༥༤༥ སོང་ཡོད་པ་དང་།",
    "གཉའ་ཁྲི་བཙན་པོ་ཐོག་མར་བོད་ཀ་གཡག་དྲུག་གི་ཚོ་དཔོན་ནམ་རྒྱལ་པོར་བཞུགས་པས་ན།",
    "དེ་ཡང་རང་རེའི་ཡུལ་འདི་ལ་ཆེས་སྔ་མོ་ཞིག་ནས།",
    "རྒྱ་གར་བ་རྣམས་རང་རེ་ལ་བྷོ་ཊ་བྱ་བར་འབོད།",
    "རྒྱ་གར་བས་ཚུར་བཏགས་པ་ཞིག་ནི་མིན་པར་སེམས་ཞེས་གསུངས་པ་བཞིན་བོད་ཅེས་པའི་མིང་གི་སྒྲ་ཕར་རྒྱ་གར་སྐད་ལ་གྷོ་ཊ་ཞེས་ཟུར་ཆག་ཅིང་།",
    "བོད་དང་བོན་གཉིས་དོན་གཅིག་ཡིན་ཟེར་བ་འདི་ངེས་པར་བཞད་གད་སློང་བའི་གཏམ་དུ་སྣང་མོད་ཀྱི།",
    "དེར་མ་ཟད་གནའི་ཐ་སྙད་ལ་རྗེས་འཇུག་གི་ད་ན་གཉིས་ཕན་ཚུན་བརྗེས་པའང་ཤིན་ཏུ་མང་སྟེ།",
    "ཆུན་པོ་དང་ཆུད་པོ་སོགས་རེ་མོས་སུ་བྲིས་པ་བཞིན་བོན་དང་བོད་གཉིས་ཀ་ཡང་ཕན་ཚུན་བརྗེ་སྲིད་པས་སོ།",
    "གཉའ་ཁྲིའི་གོང་ནས་བོད་དུ་བོན་ལུགས་དར་འདུག་པ་གཉའ་ཁྲི་དང་ལུག་རྫི་བཅུ་གཉིས་འཕྲད་པའི་སྒྲུང་ལས་ཤེས་ཐུབ་མོད།",
    "ཡུལ་ཉི་ཚེ་བ་བོད་ཀ་གཡག་དྲུག་གི་བོད་ཅེས་པའི་མིང་དེའང་ཁྱབ་རྒྱ་ཇེ་ཆེར་སོང་ནས་མཐར་སྤུར་རྒྱལ་བོད་ཀྱི་ཆབ་འོག་ཏུ་འདུས་པའི་བོད་མི་རིགས་སྤྱིའི་མིང་དུ་འཇགས་པར་མངོན་ནོ།",
    "ཡང་དེང་གི་མཁས་པ་ལ་ལས་བོད་ཅེས་པའི་མིང་འདི་ལྷ་སའི་ཁ་སྐད་དུ་རོང་མ་འབྲོག་ཟེར་བ་ལ་བོད་མ་འབྲོག་ཅེས་འབོད་ཚུལ་ཡོད་པ་ཁུངས་བཙལ་ནས།",
    "དེ་མིན་ད་ལྟ་རྒྱ་རིགས་མ་གཏོགས་མི་རིགས་གཞན་པ་ཕལ་ཆེ་བས་རང་རེ་ལ་ཐིབྷད་ཐ་ཞེས་འབོད་པ་ཡིན་ལ།",
    "དེ་ཡང་སྔོན་དུས་རྒྱ་ནག་སྐད་དུ་རང་རེ་རྣམས་ལ་ཐུ་བྷོད་དང་ཏཱ་བོད་ཞེས་གྲགས་ཤིང་།",
    "བོད་མི་རྣམས་ཀྱིས་རང་ཉིད་ལ་བོད་ཆེན་པོ་ཞེས་འབོད་པ་དེ་རྒྱ་སྐད་དུ་དང་ཐོག་ཏཱ་བོད་ཅེས་བྲིས་པ་ཕྱིས་ཏཱ་སྟེ་ཆེན་པོ་ཞེས་པའི་དོན་ལ་ཁོང་ཚོའི་ཡུལ་སྐད་དུ་སྒྲ་གདངས་ཐུ་ཞེས་བརྗོད་པས་རིམ་གྱིས་ཏཱ་བོད་ཐུ་བྷོད་དུ་གྱུར་བ་མཁས་པ་ཕལ་ཆེར་གྱིས་བཞེད་ལ།",
    "ཕྱིས་བོད་ཀྱི་མངའ་ཐང་ཇེ་རྒྱས་སུ་སོང་བར་བརྟེན།",
    "དེ་ནས་བཟུང་རིམ་པས་དེང་སང་ཡང་འཛམ་གླིང་མི་རིགས་ཕལ་ཆེར་གྱིས་བོད་ལ་ཐུ་བྷོ་ཐུ་ཞེས་རྒྱུན་འབྱམས་སུ་འབོད་པ་ཡིན་ནམ་སྙམ་མོད།",
    "འོན་ཀྱང་བོད་ཀྱི་བརྡ་སྤྲོད་རིག་པའི་ཞིབ་འཇུག་པ་ཚེ་རིང་ལྷ་མོ་ལགས་ཀྱིས།",
    "ཕྱིར་བསྐྱལ་ན་དེ་སོ་སྲིན་གྱི་རྔོ་མོས་སྲིན་བུ་ཀུན་ངོག་གོ།",
    "ཞེས་པ་ནི་ད་སྔ་བདག་གིས་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་མཐོང་བ་སྔ་ཤོས་དེ་ཡིན་ལ།",
    "རྒྱ་རྩིས་ལས་ལོ་སྐོར་བཅུ་གཉིས་རྩི་སྐབས་བྱི་བའི་ཐ་སྙད་འདི་ཡོད་མོད།",
    "བྲུ་ཤ་ཞེས་པ་ནི་བོད་ཀྱི་ནུབ་ཕྱོགས་མཐའ་མཚམས་ཀྱི་ཡུལ་ལུང་བྱེ་བྲག་པ་ཞིག་གི་མིང་རྙིང་ཡིན་ལ།",
    "ཞིབ་ཏུ་ནི་མངའ་རིས་ལ་གཟིགས།",
    "བྱེ་ཁུངས་སུ་ལྕགས་ཀྱི་ཀ་བ་བཙུགས་འདིའི་སྐོར་སྲིད་དོན་རྒྱལ་རབས་སྟོད་ཆའི་ཤོག་ངོས་༡༨༩ པར་གཟིགས་པའི་རྗེས་སུ་བྲུ་ཤ་དང་འབྲེལ་བ་བྱུང་།",
    "སྟག་གཟིག་གམ་ཨ་རབ་རྒྱལ་ཁབ་དབར་བོད་ཀྱི་དྲག་པོའི་སྟོབས་ཤུགས་སླེབས་འདིའི་སྐོར་ཏ་ཞིག་ཞེས་པར་གཟིགས་མྱོང་ཞིང་།",
    "གླིང་གི་ལོ་ལ།",
    "ཕྱིས་སུ་བྲུ་ཤའི་དམག་གིས་དེ་བཤིག་པས་མ་ཤིག་ནས་མེར་བཞུ་བའི་འཕྲོ་ཡོད་དོ་ཞེས་སྐབས་དེར་བྲུ་ཤའི་དམག་རྒྱ་གར་ནུབ་ཕྱོགས་སྟག་གཟིག་གི་ས་མཚམས་ནས་རྒྱ་གར་ཡུལ་དབུས་མ་ག་དྷ་བར་སླེབས་ཐུབ་པ་དེས།",
    "སྐབས་དེའི་བྲུ་ཤའི་དམག་གི་སྟོབས་ཤུགས་ཅི་འདྲ་ཡོད་མེད་མཚོན་ཐུབ་ཅིང་།",
    "དེས་ན་བྲུ་ཤ་ཞེས་པའི་ཐ་སྙད་འདི་བོད་ཀྱི་ཡིག་ཐོག་ཏུ་སླེབས་ནས་ད་བར་དུ་མི་ལོ་ཆིག་སྟོང་བརྒྱ་དང་ཉི་ཤུ་ནས་སུམ་ཅུ་ཙམ་སོང་ཟིན་པའི་གལ་ཆེའི་ཐ་སྙད་རྙིང་པ་ཞིག་ཡིན།",
    "བོད་རྒྱ་ཚིག་མཛོད་ཆེན་མོ་ལས།",
    "དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཚང་གིས་བྲུ་ཤ་འདི་མངའ་རིས་ལྷོ་རྒྱུད་ཀྱི་ས་ཆ་ཞིག་མིན་ནམ་སྙམ་ཞིང་ཞེས་ཕྱོགས་ཙམ་གླེང་རྗེས་གོང་གི་རྦ་བཞེད་ཀྱི་ལུང་དེ་དྲངས་འདུག་མངའ་རིས་སྐོར་གསུམ་གྱི་སྔོན་བྱུང་ལོ་རྒྱས།",
    "ད་དུང་མཁས་བླུན་མང་པོས་ས་ཕྱོགས་འདྲ་མིན་ལ་ངོས་འཛིན་བྱས་དང་བྱེད་བཞིན་ཡོད་མོད།",
    "བདག་གིས་ནི་སྔ་མོའི་ལི་དང་སྦལ་ཏེ་གཉིས་ཀྱི་དབར་དུ་ཡོད་པར་འདོད་དོ།",
    "གོང་དུ་བོད་ཀྱི་ནུབ་ཕྱོགས་སྟོད་མངའ་རིས་ཀྱི་ཆ་སྦལ་ཏེ་དང་ལི་ཡུལ་གཉིས་ཀྱི་དབར་ན་བྲུ་ཤ་སྟེ་དེང་གི་ཕ་ཁིསཐན་གྱི་ཁོངས་ཞེས་པ་དེ་དང་དེའི་མཐའ་སྐོར་ལ་བྲུ་ཤ་ཟེར་བ་ཡིན་ལ།",
    "རབསལ་བྲིས་ཡོད་པས་བྲུ་ཤ་དང་གིལ་གིཏ་གཉིས་གཅིག་ཡིན་པར་ངེས་ལ།"
  ]
}