    "ཐ་མར་འབྲལ་དགོས་པའི་ཚེ་ནའང་རང་ཉིད་འཆི་མི་ཐུབ་པའི་སྡུག་བསྔལ་གྱི་རྒྱུར་འགྱུར་བར་མ་ཟད།",
    "སྔོན་བྱོན་ཡ་རབས་དམ་པའི་སྲོལ་བཟང་སོགས་ཉམས་པ་ལས་བྱུང་འདུག་པ་མངོན་སུམ་དུ་གྲུབ་ནའང་།",
    "མཚང་ལ་རྒོལ་ཡང་རང་གཤིས་དངོས།",
    "སླར་ཡང་རང་གཤིས་སྲོང་བོའི་གཏམ།",
    "པས་མཁ་ག་དུས་རབས་ཀྱི་གཏམ།",
    "ཁོ་ཚོས་ཞེན་ཐག་མ་ཆོད་ཀྱི་བར་དུ་མགོ་བོ་བསྒུར་ནས་བཟང་ངན་ཅི་མཐོང་རང་ཉིད་ལ་བཀལ་ནས་འདུག་པ་ལས་གཞན་གང་ཡང་མི་སེམས།",
    "ཅེས་གསུངས་པ་བཞིན་དུ་མཐོ་བ་རྒྱལ་ཁབ་ཀྱི་ཀྲུའུ་ཞི་ལྟ་བུ་དང་དམའ་བ་གྲྭ་སྨྱོན་ང་རང་ལྟ་བུའི་མཐོ་དམན་བར་མའི་སྲོག་ལྡན་འགྲོ་བ་སུ་ལ་མཚོན་ནའང་ཞི་བདེ་འདོད་པའི་བློ་མཉམ་དང་།",
    "དེའི་ཕྱིར་མི་རང་རང་ལ་འཚོ་བའི་གནས་སྟངས་ལེགས་པོ་ཞིག་དང་འཛམ་གླིང་ཞི་བདེ་ཡོངས་དགོས་ཕྱིན།",
    "མི་རང་རང་ལ་ལས་འབྲས་ཀྱི་ལྟ་བ་སོགས་ཉམས་ལེན་དང་ལག་ལེན་གྱི་ཨ་ལོང་ཡོད་ན།",
    "བཟའ་བཏུང་དང་འདུག་གནས་སོགས་ཀྱི་འཚོ་བའི་རྒྱུ་རྐྱེན་ཡོད་ཚད་ཞིང་བ་དང་བཟོ་བ།",
    "ལྷག་པར་དུ་ང་རང་བདེན་དོན་ལ་དགའ།",
    "ལྷག་པར་ཡང་རྗེ་ཁྲི་སྲོང་ལྡེ་བཙུན་གྱི་སྐུ་དུས་ཙ་ན།",
    "ཀྲུང་ཧྭ་མི་སེར་རྒྱལ་ཁབ་ཀྱི་དུས་དཀྱིལ་ནས་བཟུང་རྒྱ་སྐད་ཀྱི་ཀོའོ་སྐྱ་དང་བོད་སྐད་ཀྱི་རྒྱལ་ཁབ་ཅེས་ཤན་སྦྱར་བྱས་ནས་གཏན་འཁེལ་ལྟ་བུར་བྱས་འདུག་པ་དང་།",
    "ཡིད་ཀྱི་ཚོར་མཁན་མི་འདུག་པས།",
    "ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ལས་འགག་པ་ལས་འབྲས་བུ་འབྱུང་ན་དེ་འདྲའི་རྣམ་སྨིན་གྱི་འབྲས་བུ་ཐུག་མེད་དུ་འགྱུར་བ་དང་འཆོལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "གཞན་རྣམས་ཀྱིས་ནི་འདུས་བྱས་ལྟ་བུའི་སྟེང་དུ་མཚན་ཉིད་གསུམ་གྱི་རྣམ་བཞག་བྱེད་ཚེ་འདུས་བྱས་ཁོ་རང་རྟེན་དུ་ཡོད་དགོས་པའི་ཕྱིར་དང་།",
    "གཏན་ཚིགས་རིག་པ་འདི་ཡིན་ཞེས་སྨྲ་ཆོག་གཏན་ཚིགས་རིག་པ་ནི་སྤྱི་སྒེར་གྱི་ལས་དོན་གང་ལ་གཞིགས་ཀྱང་བཀོལ་ཆོག་ཆོག་ཏུ་མཁས་འདུག་སྟེ།",
    "ལུས་དལ་བར་འདུག་པ་དང་མེ་དྲོད་ཆུང་བ་ལ་ལྟོ་བའི་གཞི་ཆ་གཉིས་ཁ་ཟས་ཀྱིས་དགང་ལ་བཞི་ཆ་གཅིག་སྐོམ་གྱིས་དགང་བ་དང་ཆ་བཞི་བ་ནི་མེ་དྲོད་གསུམ་གྱི་གནས་སུ་བཞག་ལ།",
    "ཁང་བའི་ནང་དྲི་ཆག་ཆག་བཏབ་སྟེ་གནས་བསིལ་སར་དལ་བུར་འདུག་གོ།",
    "སྔགས་མང་ལས་ཤག་དུས་རབས་ཀྱི་བསམ་གཞིག་དེབ་གཉིས་པ་ཞང་ཀང་གྱི་ལིང་དཔེ་སྐྲུན་ཚད་ཡོད་ཀུང་ཟིས་བསྐྲུན་ཞིང་བཀྲམ།",
    "ང་རང་ཐད་སོར་རང་དགོས་ཐུབ་པ་ཙམ།",
    "ང་རང་སྣང་བ་གར་བསྒྱུར་བྱེད་པ་ཡིན།",
    "ང་རང་ད་ལྟ་ཡུད་ཙམ་ཡིན་ལགས་ཀྱང་།",
    "དེ་ཡང་ང་རང་དྲག་ཤུལ་གཏུམ་ལས་བྱུང་།",
    "བདག་ནི་ང་རང་འདིར་བདེན་མ་གཏོགས་པ།",
    "རྒྱལ་སར་འདུག་ན་ཀུན་གྱིས་ཞབས་འདེགས་དང་།",
    "ཁོ་རང་སྤྱོད་པ་རང་ཁར་གཏོང་བ་ལ།",
    "ང་རང་སྣང་བ་འཁྲུལ་པ་ནི་མིན།",
    "གཞན་དག་དམངས་དང་ཕལ་པ་རྣམས་ལ་ངའི་བ་སྤུ་ཉག་གཅིག་ཡང་མི་དོ་བ་རྣམས་ནི་བདེ་བ་དང་བཅས་ནས་འདུག་པ་འདི།",
    "ཡབ་རྒྱལ་པོ་འདི་ནི་ཅིས་ཀྱང་མི་འཚོ་བར་འདུག་པས།",
    "མི་འཚོ་ལུས་སེམས་འབྲལ་བར་འདུག་སྙམ་ནས།",
    "ཞིང་ཁམས་དེ་རུ་འདུག་ས་མ་བདེ་ནས།",
    "ཐམས་ཅད་ཀུན་གྱིས་ཕྱོགས་མཚམས་ནས་བསྐོར་ནས་འདུག་གོ།",
    "མི་འཆི་འཚོ་ནས་འདུག་སྙམ་ད་མི་གདའ།",
    "ཀུན་རིག་སྒྲོན་མའི་ཆོ་གབསྐོར་ནས་འདུག་པ་དེ།",
    "ང་རང་དག་ལ་བཟོད་ཚུགས་མིན་ལགས་ཏེ།",
    "འཇིག་རྟེན་འདིར་ཡང་རང་ལ་ལག་ལེན་ཡོད།",
    "ལུས་འདིར་ཞུགས་ནས་འོང་སྙམ་ད་མི་འདུག།",
