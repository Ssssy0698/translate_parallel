{
  "type": "oral_amdo",
  "data": [
    "སྣར་ཁུ་ཞོལ་རེ།",
    "ལི་པེ་ཅོ་གིས།",
    "ལི་ཅོ་མོ་ལི་པེ་ཅོ་ཡི་རྩེ་མོ་དེ་ལ།",
    "སྣར་ཞོལ་རེར།",
    "གཡུང་རེ་རྗོད།",
    "སྣར་ཞོལ་རེར་བརྗོད།",
    "ལི་ཅོ་གི་ཡོངས།",
    "སྣར་ཞོལ་རེ།",
    "གཡུང་ལི་པེ་སྣར་ཅོ་ཞོལ་རེ།",
