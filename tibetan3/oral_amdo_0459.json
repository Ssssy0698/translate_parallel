    "རྣམ་པ་ཐམས་། ཅད་མཁྱེན་པ་ཉིད་དང་ལྡན་པའི་ཡིད་ལ་བྱ་བ་མེད་པར་རེག་པ་དོར་བ་མེད་པ་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "རེག་པ་རང་བཞིན་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ་དམིགས་པའི་ཚུལ་གྱིས་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ་སྟོང་པ་ཉིད་ཀྱིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "རེག་པ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ།",
    "རེག་པ་དངོས་པོ་མེད་པ་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "རེག་པ་ངོ་བོ་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ་དམིགས་པའི་ཚུལ་གྱིས་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ་སྟོང་པ་ཉིད་ཀྱིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "རེག་པ་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "ཚོར་བ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ།",
    "སྲེད་པ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ།",
    "རྣམ་པ་ཐམས་ཅད་ལེན་པ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ་སྟོང་པ་ཉིད་ཀྱིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "སྲིད་པ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དང་ལྡན་པའི་ཡིད་ལ་བྱ་བ་མེད་པར་སྐྱེ་བ་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ་དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་བ་ཉིད་ཀྱང་དམིགས་ལ།",
    "རྒ་ཤི་རང་གི་མཚན་ཉིད་སྟོང་པ་ཞེས་བྱ་བར་ཡིད་ལ་བྱེད་དེ།",
    "དམིགས་པའི་ཚུལ་གྱིས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་དམིགས་ལ།",
    "དམིགས་པའི་ཚུལ་གྱིས་དྲན་པ་ཉེ་བར་བཞག་པ་དེ་དག་ཀྱང་དམིགས་དྲན་པ་ཉེ་བར་བཞག་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "ཡང་དག་པར་སྤོང་བ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "སྟོབས་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "འཕགས་པའི་བདེན་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "བསམ་གཏན་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "སྨོན་པ་མེད་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "གཟུངས་ཀྱི་སྒོ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "མི་འཇིགས་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་དེ་དག་གིས་ཀྱང་རློམ་སེམས་སུ་བྱེད་དོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པ་མོས་པ་མེད་པར་བྱེད་ཅིང་ཟློག་པར་བྱེད་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པ་མོས་པ་མེད་པར་བྱེད་ཅིང་ཟློག་པར་བྱད་པའོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པ་མོས་པ་མེད་པར་བྱེད་ཅིང་ཟློག་པར་བྱེད་པའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པ་མོས་པ་མེད་པར་བྱེད་ཅིང་ཟློག་པར་བྱེད་པ་སྟེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལས་ཟློག་ཅིང་མོས་པ་མེད་པར་བྱེད་དེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་པས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་པས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་པས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་པས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་པས་ཁྱོད་ལ་ཅི་ཞིག་བྱ་ཞེས་ཟེར་བ་འོང་ངོ་ཞེས་བདུད་ཀྱི་ལས་མི་སྟོན།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ལ་ནི།",
    "ཁྱོད་ནི་ཕྱིར་མི་ལྡོག་པའང་མ་ཡིན།",
    "གཟུགས་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ཚོར་བ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "འདུ་ཤེས་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "འདུ་བྱེད་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "མིག་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "རྣ་བ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "སྣ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ལྕེ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ལུས་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ཡིད་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "གཟུགས་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "སྒྲ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "དྲི་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "རོ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "རེག་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་། གིས་སྟོང་ངོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་བདག་གམ་བདག་གིས་སྟོང་ངོ།",
