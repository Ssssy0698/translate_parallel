    "བུད་མེད་དང་ལྷན་ཅིག་ཉལ་བ་དང་།",
    "སྐྱེས་པ་མེད་པར་བུད་མེད་དང་འགྲོགས་ནས་ལམ་འགྲོ་བ།",
    "དགེ་སློང་གིས་བཙོས་པ་ཟ་བའོ།",
    "དཔེར་ན་དགེ་སློང་གི་སྟན་གཅིག་ལོ་དྲུག་མ་ལོན་པར་ལོ་དྲུག་པ་དེ་ཉིད་ཀྱི་ནང་དུ་སྟན་གཉིས་པ་བརྩམས་ནས་ཁྱིམ་པར་བབས།",
    "དེའི་འོག་མ་ཡིན་པ་ཁོ་ནར་བརྩམས་པ་གྲུབ་པར་བྱས་པ་དེས་ནི་སྤང་ལྟུང་གི་བྱེད་པ་པོ་མིན་པ་ལྟ་བུའོ།",
    "ཡང་དུས་གཞན་དུ་སྤྱིར་བསྡོམས་ན་འཆང་བའི་དུས་ལས་ལྷག་ཏུ་ཟིན་ཀྱང་བཅངས་པའི་ཞག་དེ་དག་གི་འབྲས་བུ་ཐ་དད་པའི་ཕྱིར་སྤང་ལྟུང་དུ་མི་འགྱུར་རོ།",
    "ལམ་ན་བལ་ཐོགས་པ་ཡང་ཉིན་རེ་བཞིན་ཅུང་ཟད་ཅུང་ཟད་ཁྱེར་བའི་ལམ་ཞག་བསྡོམས་པས་རྒྱང་གྲགས་ཀྱི་མཐའ་འདས་སུ་ཟིན་ཀྱང་སྤང་ལྟུང་དུ་མི་འགྱུར་བ་དང་།",
    "ཞག་བརྒྱུད་མ་མ་ཡིན་པར་སྐབས་སུ་གཞན་དུ་སོང་བའི་ཞག་ཕྱིར་བསྡོམས་པས་ཞག་དྲུག་ལས་ལྷག་ཏུ་ཟིན་ཀྱང་ཞག་དྲུག་གི་འབྲལ་སྤང་དུ་མི་འགྱུར་བ་དང་།",
    "ཕམ་པར་འགྱུར་བ་ལ་སོགས་པ་དངོས་གཞིའི་ཁ་ན་མ་ཐོ་བ་ལས་ན་སྨད་པའི་སྦོམ་པོའི་ཁ་ན་མ་ཐོ་བ་དག་གི་ཆ་ཉིད་ནི་ན་སྨད་པ་ཡིན་ཏེ།",
    "ཉེས་བྱས་དག་གི་སྐུར་པ་བཏབ་པ་ལ་ཉེས་བྱས་སུ་འགྱུར་བ་ལྟ་བུའོ།",
    "བུད་མེད་འདི་ལ་སྤྱད་དོ་སྙམ་ནས་གཞན་ལ་འཁྲུལ་ནས་སྤྱད་ཀྱང་ཕམ་པར་འགྱུར་བ་དང་།",
    "གོ་རིམ་བཞིན་མ་བསྟན་པར་ཐུན་མོང་དུ་ཅི་རིགས་པར་བསྟན་པས་སྤྱིར་བསྟན་ཡིན་ཏེ།",
    "ཅི་རིགས་ཐུན་མོང་བསྟན་པས་སྤྱིར་བསྟན་གསུངས།",
    "མུ་སྟེགས་ཅན་བལྟའོ་ཟེར་ནས་དེར་སོང་བ་དང་།",
    "དགེ་སློང་གིས་འདུག་པ་དང་།",
    "གཅིག་གིས་གསོལ་བ་དང་ལས་བྱའོ།",
    "ཚེ་དང་ལྡན་པ་ཁོ་བོས་ཕྱོགས་ག་གེ་མོ་ཞིག་ཏུ་ལྡེ་མིག་སྦས་ཀྱི།",
    "ངོས་ཡ་རེར་གནས་ཁང་བརྩིགས་ལ་བར་དུ་སྲང་གདོད་པ་འདི་ནི་སྤོང་ཁང་ཆུང་ངུ་ཡིན་ནོ།",
    "དེ་བཞིན་ལྔ་ལྔའམ་དྲུག་དྲུག་གི་བར་དུ་སྲང་གདོད་པ་ཆེན་པོའོ།",
    "གློས་ཕབ་སྟེའོ་ཞེས་པའི་བར་ཡང་འཕངས་མོད་ཀྱང་རྒྱས་པར་མ་སྤྲོས་སོ།",
    "སོར་མོའི་ཚིགས་ཀྱི་ཚད་དག་གི།",
    "རྩེ་མོ་གཉིས་ནེའུ་ལེའི་མགོ་བཞིན་དུ་ཡོད་པའོ།",
    "རྒྱུད་རེ་རེ་ཡང་།",
    "བཅུ་དགུ་ནས་སོ་དྲུག་གི་བར་ཇེ་ཆུང་ཇེ་ཆུང་དུ་འགྲོ་བའི་རྒྱུད་གསུམ་སྟེ།",
    "རྒྱུད་གཅིག་དང་ཏོག་གསུམ་མོ།",
    "ཤི་བའི་དོན་དུ་འདུས་ཤིང་ཁྱོགས་ཕྲག་པ་ལ་འདེགས་པ་ལ་སོགས་པའི་ཆེད་དུ་མཇུག་ཏུ་ཏོག་མེད་པའི་རྒྱུད་ཉི་ཚེ་བརྡུང་བ་ཡིན་ནོ།",
    "འདུས་པ་ཆེན་པོའི་ཚེ་གཎྜི་བརྡུང་བར་གོ་བར་མི་འགྱུར་བ་ལྟ་ན་དུང་བསྒྲིལ་ཏེ་འབུད་པའམ་རྔ་བོ་ཆེ་བརྡུང་ངོ།",
    "ཕྱོགས་མཐོན་པོ་གང་ཡང་རུང་བ་དག་གི་དཔེ་ཡིན་ནོ།",
    "གསོ་སྦྱོང་གི་ནི་གནས་ལ་བློ་མཐུན་བྱ།",
    "གནས་གང་དུ་གསོ་སྦྱོང་མངོན་དུ་བྱེད་པའི་གནས་དེ་ནི་གསོ་སྦྱོང་གི་གནས་ཞེས་བྱ་སྟེ།",
    "གསོ་སྦྱོང་གི་ཚེ་དགེ་སློང་རྣམས་དེ་ལ་སྡོད་པ་དང་།",
    "དེའི་རྟོག་པ་སྟོན་པས་མཁྱེན་ནས་སྐད་ཅིག་གིས་དེར་བྱོན་ནས།",
    "ཁྱོད་ལ་རྟོག་པ་འདི་ལྟ་བུ་མ་བྱུང་ངམ།",
    "ཁྱོད་གསོ་སྦྱོང་ལ་མི་འགྲོ་ན་གཞན་སུ་འགྲོ་གསུངས་ནས་དེ་ཁྲིད་ནས་ཕྱིན་ཏེ་གསོ་སྦྱོང་གི་གནས་སུ་བྱོན།",
    "བཙུགས་པ་གོ་བྱས་གཅིག་གིས་གསོལ་བ་དང་།",
    "སྔར་མཚམས་ཆེན་པོ་བཅད་ཟིན་ནས་དེའི་འོག་ཏུ་གསོ་སྦྱོང་འབའ་ཞིག་གི་ཆེད་དུ་མ་ཟད་ཀྱི།",
    "གཅིག་གིས་གསོལ་བ་དང་ལས་ཀྱི་མཚམས་ཆེན་དགྲོལ་བར་བྱའོ།",
    "དེའི་འོག་ཏུ་དགེ་སློང་གནས་པ་དང་གཉུག་མར་གནས་པ་རྣམས་ཀྱིས་མཚམས་བུ་ཆུང་གི་ཕྱོགས་བཞིའི་མཚན་མ་བརྟན་པོར་སེང་ལྡེང་གི་ཕུར་པ་བཏབ་པའམ།",
    "གཅིག་གིས་གསོལ།",
    "ཚིག་གིས་མཚམས་གཉིས་ཅིག་ཅར་དཀྲོལ་བ་དང་།",
    "རེ་ལྡེས་གནན་ནས་གསོལ་བ་བྱས་ཏེ།",
    "གནས་པ་དང་གཉུག་མར་གནས་པ་རྣམས་ཀྱིས་མཚམས་ཆེ་ཆུང་གི་མཚན་མ་བཙུགས་ནས་བཙུགས་པ་བརྗོད་པའི་བར་སྔར་བཞིན་ལ།",
    "རེ་ལྡེས་གནན་ནས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "མེད་ཕུལ་གྱུར་དང་སྐྱ་རེངས་ལས་ཀྱིས་འཇིག།",
    "ཕྱི་རོལ་སྐྱ་རེངས་ཤར་བ་དང་།",
    "གསོ་སྦྱོང་གི་ཚེ་མཚམས་མ་བཅད་པ་མ་ཡིན་ལ།",
    "སྲོག་དང་ཚངས་པར་སྤྱོད་པའི་བར་ཆད་ཀྱི་རྐྱེན་གྱིས་གསོ་སྦྱོང་གི་གནས་སུ་འདུ་བར་མི་ནུས་པ་ཡོད་ན།",
    "གསུམ་ཚིག་གིས་བསྐོ་བར་བྱ་ཞིང་།",
    "མཐོན་པོར་འདུག་སྟེ་ཡོངས་སུ་བལྟ་བ་ལ་སོགས་པ་དག་གིས་བསམ་པ་ཐག་པ་ནས་མཚམས་ཀྱི་ཕྱིར་འདུག་པ་ལ་བླངས་ཀྱང་མི་ཆགས་པས་མཚམས་ཀྱི་ནང་དུ་བཙལ་ཏེ་མ་ལྷགས་པ་རྣམས་ལ།",
    "ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ལུས་དང་ངག་གི་རྣམ་པར་རིག་བྱེད་ཀྱིས་ཡོངས་སུ་དག་པ་འབུལ་བར་བྱེད་ན།",
    "ལུས་སམ་ངག་གིལུས་དང་ངག་གི་རྣམ་པར་རིག་བྱེད་ཀྱིས་ཡོངས་སུ་དག་པ་འབུལ་བར་བྱེད་མི་ནུས་ན།",
    "སྟེང་གི་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱ།",
    "གོམ་པ་གཅིག་གིས་སྐས་ཀྱི་རིམ་པ་གཉིས་ལ་ཐོག་རྒལ་དུ་འཛེག་པར་མི་བྱ།",
    "གཅིག་གིས་དུ་མའི་ལེན་པའི་ཚེ་མིང་བརྗོད་ནུས་པའི་ཚིགས་ཚུན་ཆད་དོ།",
    "བསླབ་པ་བྱིན་པ་དགེ་སློང་གི་འདུ་ཤེས་ཡོད་པ་ལ་བླང་དུ་རུང་ཞིང་།",
    "དགེ་སློང་འདི་བདག་ཅག་གི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ཡིན་གྱི།",
    "མཚམས་གཅིག་གི་ནང་དུ་ཚོགས་ཐ་དད་པས་ལས་ཐ་དད་པ་མང་པོ་སོ་སོ་ན་བྱེད་ན།",
    "འདུན་པ་དང་ཡོངས་སུ་དག་པ་ཕན་ཚུན་འབུལ་བ་དག་གི་དེ་དང་མཐུན་པ་འགྲུབ་བོ།",
    "མ་ལྷགས་པ་མཚམས་ནང་ན་འཁོད་ཅིང་དེ་དག་གི་འདུན་པ་སོགས་མ་བླངས་སུ་ཟིན་ཀྱང་མཐུན་པ་ཡིན་ནོ།",
    "གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "སོང་ཡང་བཟློག་པར་མི་བྱ།",
    "ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་ཚེ་དང་ལྡན་པ་དགོངས་སུ་གསོལ།",
    "འཆགས་པས་སྡོམ་མོ་ཞེས་ལན་གསུམ།",
    "མ་མོ་འཛིན་པ་རྣམས་ལ་དྲིས་ཏེ།",
    "བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་གང་ཡང་རུང་བ་ཞིག་ཤེས་ན་རང་གི་སེམས་ཀྱིས་བསྡམ་པར་བྱའོ།",
    "དགེ་སློང་གཅིག་མཚམས་གཞན་གྱི་དགེ་སློང་གི་དྲུང་དུ་བཏང་ལ།",
    "གལ་ཏེ་ཆོ་ག་མ་གྲུབ་ན་དགེ་སློང་གཅིག་གིས་གསོལ་བ་འབའ་ཞིག་པའི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "མ་མོ་འཛིན་པ་རྣམས་ཀྱི་དྲུང་དུ་བཏང་སྟེ།",
    "ཆོ་ག་དེ་མ་གྲུབ་ན་དགེ་སློང་གཅིག་གིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "འགྲོགས་ཤེས་པ་གང་ཡིན་པ་དེའི་དྲུང་དུ་སོང་སྟེ།",
    "གཅིག་གིས་གསོལ་བ་འབའ་ཞིག་པའི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་བོ།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གཞན་གྱི་དྲུང་ན་མོ་དང་ལས་བྱེད་ཡིད།",
    "ཡང་རང་གི་སེམས་ཀྱིས་བྱིན་གྱིས་བརླབ་པའི་ཆོ་ག་བྱའོ།",
    "དེ་ནི་མཐུན་པའི་གསོ་སྦྱོང་གིས་སྡོམ་པར་བྱེད་དོ།",
    "དེ་ནི་ཞི་གནས་ཀྱི་གསོ་སྦྱོང་གིས་སྡོམ་པར་བྱེད་དོ།",
    "དགེ་སློང་ཉིན་མོ་འདུག་པ་དང་།",
    "ཞེས་གསུངས་པའི་དུས་ཚིགས་དྲུག་པོ་དག་གི་ཟླ་བ་བཅུ་གཉིས་ལ་གསོ་སྦྱོང་ཉི་ཤུ་རྩ་བཞི་དགོས་པ་ལས།",
    "དེས་ཀྱང་མི་ནུས་པ་ཉིད་ཡིན་ན་ཐམས་ཅད་ཀྱིས་རེ་མོས་ཀྱི་གདོན་པར་བྱའོ།",
    "རེས་བབ་པའི་ཚེ་དེས་འདོན་མི་ནུས་ན་གཞན་ལ་བཅོལ་བར་བྱའོ།",
    "འདོན་པ་དེ་དག་གིས་ཚིག་ཕྱེད་ཀྱང་མ་འཁྲུལ་བར་ལེགས་པར་ཐོན་པ་ཉིད་ཡིན་ན་གདོན་གྱི།",
    "དེའི་དུས་དེ་ཁོ་ན་བཞིན་ཉེ་བར་མ་གཟུང་བ་ནི་གསོ་སྦྱོང་གི་དུས་ལས་གཞན་པའི་དུས་སུ་འདོན་པའོ།",
    "དེ་དག་གི་དོན་དུ་དགེ་སློང་སྔ་མ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱས་ཟིན་པ་རྣམས་ཀྱིས་ཡང་གསོ་སྦྱོང་དང་དགག་དབྱེ་དེ་གཉིས་བྱར་རུང་བའོ།",
