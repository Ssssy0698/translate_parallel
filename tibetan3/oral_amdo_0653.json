    "ཚེ་དང་ལྡན་པ་གང་པོ་རང་གི་སྟན་ཇི་ལྟ་བ་ལ་འདུག་གོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "མ་ལ་བདག་གིས་ཇི་ལྟར་སེམས་མཉམ་པར་གཞག་ན་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ལ་ལྟ་བར་འགྱུར་བ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་པར་བྱའོ་སྙམ་མོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་ཇི་ལྟར་སེམས་མཉམ་པར་བཞག་ན་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ལ་ལྟ་བར་འགྱུར་བ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཏེ།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ལ་བལྟས་ན་ངའི་རིམ་གྲོ་དགེ་སློང་ཀུན་དགའ་བོས་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "རང་གི་དོན་ཡང་ཉམས་པར་མི་འགྱུར་བ་ཡིན་ནོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་གཏད་པ་མཐོང་ངོ།",
    "རང་གི་དོན་ཡང་ཉམས་པར་མི་འགྱུར་བ་ཡིན་ནོ་ཞེས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་གཏད་དོ།",
    "རང་གི་དོན་ཡང་ཉམས་པར་མི་འགྱུར་བ་ཡིན་ནོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་གཏད་ཀྱིས་ཚུར་བདག་ཅག་དོང་ལ་སྤྲོ་བར་བྱའོ།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "མོད་གལ་གྱི་བུ་གཉིས་ཕྱོགས་གཅིག་ཏུ་འཁོད་དོ།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ཁྱོད་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་པར་སྤྲོའམ།",
    "བདེ་བར་གཤེགས་པ་ལ་བསྙེན་བཀུར་བྱ་བ་ནི་ཁྱོད་ལ་དོན་ཆེན་པོར་འགྱུར་རོ།",
    "བྲང་གི་ཕེལ་ཀ་ཆེ་བ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "རང་གི་དོན་ཡང་ཉམས་པར་མི་འགྱུར་རོ་ཞེས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་ཐུགས་གཏད་དེ་དཔེར་ན་ཁང་པ་བརྩེགས་པའམ།",
    "རང་གི་དོན་ཡང་ཉམས་པར་མི་འགྱུར་རོ་ཞེས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་ཐུགས་གཏད་ན་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ཁྱོད་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་པར་སྤྲོའམ།",
    "བདེ་བར་གཤེགས་པ་ལ་བསྙེན་བཀུར་བྱ་བ་ནི་ཁྱོད་ལ་དོན་ཆེན་པོར་འགྱུར་རོ།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་བདག་གིས་དེ་བཞིན་དུ་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཕྱིར་གང་ཟག་པའི་མགྲོན་དུ་འབོད་ན་བདག་གིས་བདག་གིར་མི་བྱ་བ་དང་།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་གལ་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ལ་མཆོག་གསུམ་གནང་བ་ལྟ་ན་བདག་དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་བགྱིད་པར་སྤྲོའི་གཞན་དུ་ན་མ་ལགས་སོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་དང་།",
    "ཕྱོགས་གཅིག་ཏུ་འཁོད་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་བགྱིད་པའི་དགེ་སློང་བདག་ཅག་གིས་སྤྲོ་བ་བསྐྱེད་པ་ནི་འདི་ལྟ་སྟེ།",
    "དེའི་མཆིད་ནས་འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་བདག་གིས་དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ཀྱི་རིམ་གྲོ་བགྱིད་པར་སྤྲོ་བར་བགྱི་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཕྱིར་གང་ཟག་པའི་མགྲོན་དུ་འབོད་ན་བདག་གིས་བདག་གིར་མི་བྱ་བ་དང་།",
    "མོད་གལ་གྱི་བུ་ཆེན་པོ་ལེགས་སོ་ལེགས་སོ།",
    "མོད་གལ་གྱི་བུ་ལེགས་སོ།",
    "མོད་གལ་གྱི་བུ་ལེགས་སོ་ལེགས་སོ།",
    "དུས་ཤེས་ཤིང་དུས་རིག་པས་དེ་འདི་ནི་བདག་གིས་བཅོམ་ལྡན་འདས་ལ་བལྟ་བའི་ཕྱིར་འགྲོ་བའི་དུས་ཡིན།",
    "མོད་གལ་གྱི་བུ་དགེ་སློང་ཀུན་དགའ་བོ་ནི་མཁས་པ་ཡིན་ཏེ།",
    "དུས་ཤེས་ཤིང་དུས་རིག་པས་དེ་འདི་ནི་བདག་གིས་བཅོམ་ལྡན་འདས་ལ་བལྟ་བའི་ཕྱིར་འགྲོ་བའི་དུས་ཡིན་ནོ།",
    "མོད་གལ་གྱི་བུ་ལེགས་སོ་ལེགས་སོ།",
    "རང་གི་དོན་ཡང་ཉམས་པར་མི་འགྱུར་རོ།",
    "མོད་གལ་གྱི་བུ་དེ་བཞིན་གཤེགས་པའི་རིམ་གྲོ་དགེ་སློང་ཀུན་དགའ་བོས་བྱས་ན་ཐུགས་ལ་མི་འཐད་པ་མ་ཡིན་གྱི་ཐུགས་ལ་འཐད་པ་དང་།",
    "གང་གི་ཚེ་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་དང་།"
  ]
}