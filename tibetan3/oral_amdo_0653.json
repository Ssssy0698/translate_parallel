    "དེས་མུ་ཏིག་གི་དོ་ཤལ་དེ་མཐོང་ནས།",
    "དེ་སྐྱེད་མོས་ཚལ་ཉིད་དུ་ཤིང་གི་ཡལ་ག་ཞིག་ལ་བཏགས་ཏེ་བཞག་གོ།",
    "ཇི་ཙམ་ན་བཙུན་མོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་གསོལ་པ།",
    "ལྷ་བཙུན་མོ་ཆེ་གེ་མོ་ཞེས་བགྱི་བའི་མུ་ཏིག་གི་དོ་ཤལ་སྐྱེད་མོས་ཚལ་དུ་ལུས་ལགས་སོ།",
    "ཤེས་ལྡན་དག་མུ་ཏིག་གི་དོ་ཤལ་སྐྱེད་མོས་ཚལ་དུ་ལུས་པ་ཚོལ་ཅིག།",
    "དེ་རྣམས་སྐྱེད་མོས་ཚལ་དུ་དོང་ནས་བཙལ་བར་བརྩམས་པ་དང་།",
    "ཇི་ཙམ་ན་ཤིང་གི་ཡལ་ག་ཞིག་ལ་བཏགས་པ་མཐོང་ནས་དེ་རྣམས་ཀྱིས་བསམས་པ།",
    "རེ་ཞིག་འདི་སུས་བཏགས་དཔྱད་པར་བྱའོ་སྙམ་ནས་དེ་རྣམས་སྐྱེད་མོས་ཚལ་ན་རྒྱུ་བར་བརྩམས་པ་དང་།",
    "ཀྭའི་ནང་རྗེ་མུ་ཏིག་གི་དོ་ཤལ་འདི་སུ་ཞིག་གིས་ཡལ་ག་ལ་བཏགས་ཏེ་བཞག།",
    "བློན་པོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་མུ་ཏིག་གི་དོ་ཤལ་ཕུལ་ནས་ཇི་ལྟར་གྱུར་པ་སྨྲས་སོ།",
    "ཀྭའི་ནང་རྗེ་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་མུ་ཏིག་གི་དོ་ཤལ་ཤིང་གི་ཡལ་ག་ལ་བཏགས་ཏེ་བཞག་ནས་རང་གིར་མ་བྱས།",
    "ཀྭའི་ནང་རྗེ་ཁྱོད་ནི་དམ་པ་འོས་པ་ཡིན་པས་དམ་པ་གང་འདོད་པ་གསོལ་ཅིག་སྦྱིན་ནོ།",
    "གལ་ཏེ་ལྷ་བདག་ལ་དགྱེས་པར་གྱུར་ན་མུ་ལྟོ་བ་རྣམས་འཚལ་མ་སྩལ་ཅིང་དེ་རྣམས་རེ་རེ་ལ་རས་ཟུང་རེ་བསྐོན་ནས་བདག་དཔོན་པོར་བསྐོ་བར་གསོལ།",
    "ཤེས་ལྡན་དག་ཁྱེད་ཅག་གིས་མུ་ལྟོ་བ་ཐམས་ཅད་ཟན་བྱིན་ལ་རེ་རེ་ལ་རས་ཟུང་རེ་བསྐོན་ཏེ་འདི་དེ་རྣམས་ཀྱི་དཔོན་པོར་ཆུག་ཤིག།",
    "ལྷས་བཀའ་སྩལ་གྱིས་བཱ་རཱ་ཎ་སཱིའི་མུ་ལྟོ་བ་ཇི་སྙེད་པ་ཐམས་ཅད་སྐྱེད་མོས་ཚལ་ཆེ་གེ་མོ་ཞིག་ཏུ་འདུས་ཤིག།",
    "ངས་མུ་ལྟོ་བ་རྣམས་ལ་ཟས་སྦྱིན་ཞིང་རེ་རེ་ལ་ཡང་རས་ཟུང་རེ་བསྐོན་ནོ་ཞེས་བསྒྲགས་པ་དང་།",
    "དེ་དག་ཐམས་ཅད་འདུས་ནས་བློན་པོ་རྣམས་ཀྱིས་ཁ་ཟས་བསོད་པས་ཚིམ་པར་བྱས་ནས་རེ་རེ་ལ་ཡང་རས་ཟུང་རེ་བསྐོན་ཏེ་བསྒོ་བ།",
    "དེང་ཕན་ཆད་ཁྱེད་ཅག་གི་རྒྱལ་པོར་མུ་ལྟོ་བ་འདི་བསྐོས་ཀྱིས།",
    "ཁྱེད་ཅག་གིས་འདིའི་ཚིག་བཞིན་དུ་བྱོས་ཤིག།",
    "རས་ཟུང་རེ་བསྐོན་པས་ཡི་རངས་ནས་སྨྲས་པ།",
    "ཇི་ཙམ་ན་མི་ཞིག་སྣུམ་ཁུར་དག་ཁྱེར་ནས་ཚོང་འདུས་ཀྱི་དབུས་ནས་སོང་བ་ལས་མུ་ལྟོ་བའི་དཔོན་པོ་དེས་དེ་ལ་ཕྲོགས་ནས་དེ་ཁྱེར་ཏེ་ཕྱོགས་དབེན་པ་ཞིག་ཏུ་སོང་བ་དང་།",
    "མུ་ལྟོ་བ་རྣམས་ཀྱིས་ཕྱིར་འབྲངས་ཏེ་དེ་རྣམས་ཀྱིས་དེ་ལ་གླགས་བལྟས་པ་ན་འབབ་ཆུ་བ་རི་ཀ་རྒལ་ནས་ཤིང་ཞིག་གི་དྲུང་དུ་འདུག་གོ།",
    "གདོན་མི་ཟ་བར་བདག་གིས་ཡོན་གནས་དམ་པ་འདི་ལྟ་བུ་ལ་བྱ་བ་མ་བྱས་པ་དེས་ན་བདག་མི་ཐོབ་ན་ཡང་མུ་ལྟོ་བར་སྐྱེས་ཀྱིས།",
    "གལ་ཏེ་བདག་ཉིད་ཆེན་པོ་འདི་བདག་ལས་སྣུམ་ཁུར་བཞེས་པར་གྱུར་ན་བདག་གིས་དེ་དབུལ་ལོ་སྙམ་མོ།",
    "བདག་ཅག་ཁོ་ན་ཁྱོད་ཀྱི་མི་གཙོ་བོ་རྣམས་སུ་གྱུར་ཅིང་།",
    "དེ་རྣམས་ཀྱི་རྒྱལ་པོར་ཁྱོད་གྱུར་ཅིག།",
    "བདག་ཅག་ཁྱོད་ཀྱི་མི་གཙོ་བོ་རྣམས་སུ་གྱུར་ཅིང་དེ་རྣམས་ཀྱི་རྒྱལ་པོར་ཁྱོད་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "དེ་ནས་སྤྲེའུ་ཤིག་ཤིང་སཱ་ལ་ལས་བབས་ནས་ལྷུང་བཟེད་རྣམས་གང་ན་ཡོད་པ་དེར་སོང་བ་དང་།",
    "དེ་ནས་སྤྲེའུ་དེ་བཅོམ་ལྡན་འདས་ཀྱི་ལྷུང་བཟེད་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "དེ་ནས་སྤྲེའུ་དེས་མཐའ་གཅིག་ཏུ་སོང་ནས་སྲོག་ཆགས་བསལ་ཏེ་བཅོམ་ལྡན་འདས་ལ་ཕུལ་བ་དང་།",
    "དེ་ནས་སྤྲེའུ་དེ་མཐའ་གཅིག་ཏུ་སོང་སྟེ་ཆུ་གྲང་མོས་བཏབ་ནས་བཅོམ་ལྡན་འདས་ལ་ཕུལ་བ་དང་།",
    "དེ་ནས་སྤྲེའུ་དེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་གི་སྦྲང་རྩིའི་ལྷུང་བཟེད་བཞེས་སོ་སྙམ་དུ་རིག་ནས།",
    "གང་གི་ཉི་མ་ཁོ་ན་ལ་ཉིང་མཚམས་སྦྱོར་བ་བླངས་པ་དེ་ཁོ་ནའི་ཉི་མ་ལ་སྦྲང་རྩིའི་ཆར་བབ་བོ།",
    "ཇི་ཙམ་ན་བྲམ་ཟེ་མོ་དེ་ཟླ་བ་བརྒྱད་དམ་དགུ་འདས་ནས་ཁྱེའུ་ཞིག་བཙས་སོ།",
    "གང་གི་ཉི་མ་ཁོ་ན་ལ་བཙས་པ་དེ་ཁོ་ནའི་ཉི་མ་ལ་སྦྲང་རྩིའི་ཆར་བབ་བོ།",
    "ཁྱེའུ་འདི་གང་གི་ཉི་མ་ཁོ་ན་ལ་མའི་རུམ་དུ་ཞུགས་པ་དེ་ཁོ་ནའི་ཉི་མ་ལ་སྦྲང་རྩིའི་ཆར་བབ་ལ།",
    "གང་གི་ཉི་མ་ཁོ་ན་ལ་བཙས་པ་དེ་ཁོ་ནའི་ཉི་མ་ལ་ཡང་སྦྲང་རྩིའི་ཆར་བབ་ལ།",
    "གནས་འཇོག་དང་ཡང་རུས་གཅིག་པས་དེ་བས་ན་ཁྱེའུའི་མིང་གནས་འཇོག་གི་བུ་སྦྲང་རྩི་ཅན་ཞེས་བྱ་བར་གདགས་སོ་ཞེས་དེའི་མིང་གནས་འཇོག་གི་བུ་སྦྲང་རྩི་ཅན་ཞེས་བྱ་བར་བཏགས་སོ།",
    "དེ་རབ་ཏུ་བྱུང་ནས་ཀྱང་ཉི་མ་རེ་རེ་ཞིང་སྦྲང་རྩི་ལྷུང་བཟེད་གསུམ་གསུམ་གྲུབ་པར་གྱུར་ཏེ།",
    "བཙུན་པ་ཚེ་དང་ལྡན་པ་གནས་འཇོག་གི་བུ་སྦྲང་རྩི་ཅན་གྱིས་ལས་ཅི་ཞིག་བགྱིས་ན།",
    "ལས་དེའི་རྣམ་པར་སྨིན་པས་གདུགས་རེ་རེ་ཞིང་སྦྲང་རྩི་ལྷུང་བཟེད་གསུམ་གསུམ་གྲུབ་པར་གྱུར་ལགས།",
    "དགེ་སློང་དག་གནས་འཇོག་གི་བུ་སྦྲང་རྩི་ཅན་ཉིད་ཀྱིས་ལས་ཚོགས་རྙེད་པ།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་སྤྲེའུ་གང་ཡིན་པ་དེ་ནི་གནས་འཇོག་གི་བུ་སྦྲང་རྩི་ཅན་འདི་ཉིད་ཡིན་ཏེ།",
    "འདི་ལྟར་ད་ལྟར་ཡང་ཉི་མ་རེ་རེ་ཞིང་སྦྲང་རྩི་ལྷུང་བཟེད་གསུམ་གསུམ་འགྲུབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དགེ་སློང་གནས་འཇོག་གི་བུ་སྦྲང་རྩི་ཅན་གྱིས་ཤར་གྱི་རྒྱ་མཚོ་ཆེན་པོ་ལ་སྦྲང་རྩིར་མོས་ཤིང་།",
    "བྱང་གི་རྒྱ་མཚོ་ཆེན་པོ་སྦྲང་རྩིར་མོས་ན་དེ་དག་ཀྱང་སྦྲང་རྩིར་འགྱུར་ཏེ།",
    "དགེ་སློང་དག་ཉེ་བ་འཁོར་འདི་ཉིད་ཀྱིས་སྔོན་གྱི་ཚེ་རབས་གཞན་རྣམས་སུ་ལས་བྱས་ཤིང་བསགས་པ་དང་ཚོགས་རྙེད་པ་ནི་ཞེས་བྱ་བ་ནས།",
    "ཚ་བོ་རབ་ཏུ་བྱུང་བ་འདིའི་དབུ་རེགས་ཤིག།",
    "ཇི་ལྟར་རྒྱལ་པོ་ལ་བྱ་བ་དེ་བཞིན་དུ་རེགས་ཤིག།",
    "བུ་མོ་ཡང་མེད་པས་བདག་ཤི་ན་བདོག་བ་ཐམས་ཅད་བུ་མེད་དོ་ཞེས་རྒྱལ་པོས་མངའ་མཛད་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དེ་ཁྱིམ་བདག་དེས་མཐོང་ནས་སྨྲས་པ།",
    "བུ་མོ་ཡང་མེད་པས་ཁོ་བོ་ཤི་ནས་འདི་དག་ཐམས་ཅད་རྒྱལ་པོས་མངའ་མཛད་པར་འགྱུར་ན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་པར་མི་འགྱུར།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཁོ་བོའི་བུ་འདི་དག་ཐམས་ཅད་ཀྱི་ནུ་བོ་ཤོས་དེ་ཁོ་བོས་ཁྱོད་ལ་སྦྱིན་ནོ།",
    "དེའི་བུ་དེ་རྣམས་གང་གི་ཚེ་ཁ་ཅིག་དང་ལྷན་ཅིག་འཐབ་མོ་འགྱེད་པ་དེའི་ཚེ་དེས་གང་དག་གི་སྤུ་འབྲེག་མཁན་ཡིན་པ་ཁྱེད་ཀྱང་འཐབ་མོ་རྒོལ་ལམ་ཞེས་ཁ་ཟེར་བར་བྱེད་དོ།",
    "ཁྱིམ་བདག་ཆེ་གེ་མོ་ཞེས་བྱ་བའི་བུ་རྣམས་ཀྱི་ཁ་སྤུ་བཅོས་པའི་ལས་སུས་ཀྱང་མི་བྱའོ་ཞེས་བཅས་སོ།",
    "སེན་མོ་རིང་པོར་སྐྱེས་པ་དེ་རྣམས་རྒྱལ་པོས་མཐོང་ནས་སྨྲས་པ།",
    "སེན་མོ་རིང་པོར་འདུག།",
    "ཕས་བུ་བྱིན་ན་ཁྱེད་ཅག་གིས་ཅིའི་ཕྱིར་དབྲོག།",
