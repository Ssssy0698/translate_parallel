    "རྒྱལ་པོ་འཐབ་མོ་སྐྱེས་བཙུན་མོ་དང་།",
    "རྒྱལ་པོ་འཐབ་མོ་སྐྱེས་གང་ཡིན་པ་དེ་ནི་དགེ་སློང་ཀོཎྜི་ནྱ་འདི་ཉིད་ཡིན་ཏེ།",
    "ཇི་ལྟར་འདས་པའི་དུས་ན་ཡང་ངས་འདི་རྣམས་ཚོང་པ་བརྒྱད་ཁྲིར་གྱུར་པ་ན་ཟང་ཟིང་གིས་ཡང་དག་པར་བསྡུས་ནས་བརྟུལ་ཞུགས་ལྔའི་གཞི་རྣམས་ལ་རབ་ཏུ་བཀོད་པ་དེ་ཉོན་ཅིག།",
    "གང་གི་ཚེ་རྣམ་པ་ཐམས་ཅད་དུ་མ་རྙེད་པ་དེའི་ཚེ་དེད་དཔོན་ཐམས་ཅད་སྐྱོབ་ཀྱི་དྲུང་དུ་དོང་ནས་སྨྲས་པ།",
    "བདག་ཅག་གིས་བཙལ་ན་ཡང་མ་རྙེད་ན་དེ་ལ་ཇི་ལྟར་བསྒྲུབ་པར་བགྱི།",
    "དེད་དཔོན་ལེགས་གྲུབ་སྐྱེད་མོས་ཚལ་དང་།",
    "ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་ཚོང་པ་རྣམས་སྤངས་ཏེ་རབ་ཏུ་བྱུང་།",
    "ངག་གིས་མ་ཡིན་པས་དེད་དཔོན་འཁོར་དང་བཅས་པ་དེ་ལ་འབར་བ་དང་།",
    "དེས་ཚོང་པ་བརྒྱད་ཁྲི་པོ་དེ་ཟང་ཟིང་གིས་བསྡུ་བས་བསྡུས་ནས་སྨྲས་པ།",
    "དེ་ན་ཡང་ངས་ཟང་ཟིང་གིས་ཉེ་བར་བསྡུས་ནས་བརྟུལ་ཞུགས་ལྔའི་གཞི་རྣམས་ལ་རབ་ཏུ་བཀོད་དོ།",
    "འདྲེན་མ་རྣམས་ཀྱི་ནི་འདྲེན་མ་ཡིན་པས་ཞེས་བྱ་བ་ནས་དགེ་སློང་ཁྱོད་ཀྱིས་དེ་ལྟ་བུ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "དེད་དཔོན་བདག་ཅག་ནི་ཁྱོད་དང་བྲལ་ན་དགའ་བར་མི་འགྱུར་ལགས་སོ།",
    "གང་གི་ཚེ་གྲུ་ཞིག་པར་གྱུར་པ་དེའི་ཚེ་བདག་གི་མགུལ་དུ་འཇུས་ཤིག་དང་།",
    "བདག་གིས་ཁྱེད་ཅག་གདོན་ཏོ།",
    "དེས་དེ་རྣམས་ལུས་དུ་བཅིང་སྲོག་གི་ལྷག་མ་ཅུང་ཟད་ཅིག་ལུས་ཏེ་རྒྱ་མཚོའི་འགྲམ་དུ་ཕྱིན་པར་བྱས་སོ།",
    "ཡང་གང་གི་ཚེ་ཚེ་དང་ལྡན་པ་ཀུན་ཤེས་ཀོཎྜི་ནྱ་རྒན་པའི་ངང་ལ་འདུག་པ་དེའི་ཚེ་འཁོར་ལ་གདུགས་ལྟ་བུར་བྱས་ཏེ་འདུག་གོ།",
    "རྒྱལ་པོ་ཚངས་སྦྱིན་གྱིས་རང་གི་ཡུལ་དུ་དྲིལ་སྒྲོགས་སུ་བཅུག་པ།",
    "གང་གི་ཚེ་མུ་གེའི་དུས་ཀྱི་འཆི་བའི་འཇིགས་སུ་རུང་བས་སྐྱེ་བོའི་ཚོགས་སྐྲག་ནས་ཀུན་དུ་དོང་བ་དེའི་ཚེ་དེ་རྣམས་ཀྱི་བསོད་སྙོམས་ཆད་ནས་དེ་དག་ཐམས་ཅད་འདུས་ཏེ་ཁྱིམ་བདག་སྡུམས་བྱེད་གང་ན་བ་དེར་དོང་ནས་སྨྲས་པ།",
    "ཀྱེ་ནང་རྗེ་བདག་ཅག་གི་བང་མཛོད་ན་བདག་ཅག་དང་རབ་ཏུ་བྱུང་བ་ལྔ་བརྒྱ་པོ་གང་ཡིན་པ་འདི་རྣམས་ཀྱི་ལོ་བཅུ་གཉིས་ཀྱི་བཟའ་བ་དང་བཏུང་བ་ཡོད་དམ།",
    "ཀྱེ་ནང་རྗེ་བདག་ཅག་གི་བང་མཛོད་ན་བདག་ཅག་དང་རབ་ཏུ་བྱུང་བ་སྟོང་པོ་གང་ཡིན་པ་འདི་རྣམས་ཀྱི་ལོ་བཅུ་གཉིས་ཀྱི་བཟའ་བ་དང་།",
    "དེ་ནས་ཁྱིམ་བདག་སྡུམས་བྱེད་ཀྱིས་སྦྱིན་གཏོང་གི་ཁང་པ་རྩིག་ཏུ་བཅུག་ནས་སྦྱིན་གཏོང་གི་ཞལ་ཏ་བྱེད་པའི་མི་དང་དུས་ཚོད་སྦྲོན་པ་ཡང་བཞག་ནས་དེ་རྣམས་ཉི་མ་རེ་རེ་ཞིང་ལྷགས་ནས་ཟས་ཀྱི་བྱ་བ་བྱེད་དོ།",
    "ཁྱིམ་བདག་སྡུམས་བྱེད་ཀྱི་བུ་མོ་གང་ཡིན་པ་དེ་དགེ་སློང་ཀུན་ཤེས་ཀོཎྜི་ནྱ་འདི་ཉིད་ཡིན་ཏེ།",
    "དེས་ན་ད་ལྟར་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཏེ་དགྲ་བཅོམ་པ་མངོན་སུམ་དུ་བྱས་ནས་ཀྱང་འཁོར་ལ་གདུགས་ལྟ་བུར་བྱས་ཏེ་གནས་སོ།",
    "དགེ་སློང་དག་གང་གི་ཕྱིར་ད་ལྟར་ང་འདོད་ཆགས་དང་བྲལ།",
    "དུད་འགྲོ་བྱོལ་སོང་གི་ལུས་སུ་སྐྱེས་པ་ན།",
    "ཀོཎྜི་ནྱ་སྲིན་བུ་ཀི་ཏ་ཀར་གྱུར་པ་ལ་བརྟེན་ནས་སྲིན་བུ་ཀི་ཏ་ཀ་བརྒྱད་ཁྲི་རང་གི་ཤས་ཚིམ་པར་བྱས་པ་གང་ཡིན་པ་དེ་ཉོན་ཅིག།",
    "དེ་དེ་རྣམས་ཀྱི་དྲུང་དུ་སོང་ནས་སྨྲས་པ།",
    "དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་སྲིན་བུ་ཀི་ཏ་ཀ་རྣམས་ཀྱི་ཚང་ཡོད་པས་དེ་ནས་ཀི་ཏ་ཀ་གཅིག་རྒྱུ་ཞིང་སོང་བ་ན་དྲི་ཚོར་ཏེ་དེའི་དྲུང་དུ་སོང་བ་དང་།",
    "རང་རང་གི་བརྡས་ཀི་ཏ་ཀ་རྣམས་ལ་གོ་བར་བྱས་ནས་སྲིན་བུ་ཀི་ཏ་ཀ་བརྒྱད་ཁྲི་དེད་དེ་རུས་སྦལ་གྱི་དྲུང་དུ་དོང་ངོ།",
    "གང་གི་ཚེ་དེའི་ཤ་ཆེན་པོ་རྣམས་ལས་ཟོས་ནས་ངལ་བས་དུབ་སྟེ་གཉིད་སྟུག་པོས་ནོན་པས་མ་ཚོར་རོ།",
    "དེ་ལ་བརྟེན་ནས་ཤ་དང་ཁྲག་གིས་ཚིམ་པར་བྱས་པའི་སྲིན་བུ་ཀི་ཏ་ཀ་བརྒྱད་ཁྲི་པོ་གང་དག་ཡིན་པ་དེ་དག་ནི་ལྷ་བརྒྱད་ཁྲི་པོ་འདི་དག་ཉིད་ཡིན་ཏེ།",
    "དེ་ན་ཡང་ངས་རང་གི་ཁྲག་གིས་ཚིམ་པར་བྱས་སོ།",
    "འདི་དག་ལ་རང་གི་ཁྲག་གིས་ཚིམ་པར་བྱས་ནས་བརྟུལ་ཞུགས་ལྔའི་གཞི་རྣམས་ལ་བཀོད་པ་གང་ཡིན་པ་དེ་ཉོན་ཅིག།",
    "ལམ་དུ་འཇུག་པའི་སློང་མོ་པ་གང་དག་ཅི་དོན་དུ་གཉེར་བ་དེ་དག་བྱིན་ཅིག།",
    "གཡས་སུ་འཁྱིལ་བ་ལ་སོགས་ཏེ་ནོར་མང་པོས་སློང་མོ་པའི་སྐྱེ་བོ་ཚིམ་པར་བྱ་བའི་ཕྱིར་ཕུང་པོར་སྤུངས་སོ།",
    "ཤེས་ལྡན་དག་ཁྱེད་ཅག་ཁོ་བོ་ཅག་གིས་མི་འཇིགས་སམ།",
    "སོང་ནས་རྒྱལ་བ་དང་ཚེ་སྤེལ་བ་དག་རྒྱལ་པོ་ལ་བྱས་ནས་སྨྲས་པ།",
    "ལྷ་བདག་ཅག་ནི་མོད་ལ་བཀུམ་པའི་ཤ་དང་ཁྲག་འཚལ་ན།",
    "མོད་ལ་བཀུམ་པའི་ཤ་དང་ཁྲག་གིས་རྗེས་སུ་གཟུང་བར་མཛོད་ཅིག།",
    "གཞན་ལ་གནོད་པ་མ་བྱས་པར་མོད་ལ་བསད་པའི་ཤ་དང་ཁྲག་ག་ལ་རྙེད་ཀྱིས་ཅི་ནས་ཀྱང་འདི་རྣམས་ལ་བདག་གིས་རང་གི་ཁྲག་སྦྱིན་པར་བྱའོ་སྙམ་སྟེ།",
    "ཤེས་ལྡན་དག་ངའི་ཡན་ལག་གི་རྩ་ཐམས་ཅད་ཆོད་ཅིག་དང་།",
    "སློང་མོ་པའི་སྐྱེ་བོ་ཚིམ་པར་བྱའོ།",
    "དེ་ན་ཡང་ངས་འདི་རྣམས་རང་གི་ཁྲག་གིས་ཚིམ་པར་བྱས་ནས་བརྟུལ་ཞུགས་ལྔའི་གཞི་རྣམས་ལ་བཀོད་དོ།",
    "འདི་རྣམས་རང་གི་ཤས་ཚིམ་པར་བྱས་ནས་བརྟུལ་ཞུགས་ལྔའི་གཞི་རྣམས་ལ་བཀོད་པ་གང་ཡིན་པ་དེ་ཉོན་ཅིག།",
    "ཤེས་ལྡན་དག་ཁྱེད་ཅག་ཁོ་བོ་ཅག་གིས་མི་འཇིགས་སམ།",
    "འདི་ལྟར་བདག་ཅག་གི་རྒྱལ་པོ་བྱམས་པའི་སྟོབས་དགོངས་པ་གང་ཡིན་པ་དེ་སེམས་པས་སོ།",
    "འདིར་རྒྱུ་འདིས་ན་ད་ལྟར་བདག་ཅག་གིས་གླགས་མ་རྙེད་དོ་སྙམ་ནས་དེ་རྣམས་བཱ་རཱ་ཎ་སཱིའི་སྒོ་ནས་སྒོར་རྒྱུ་ཞིང་རྒྱལ་པོ་བྱམས་པའི་སྟོབས་ནམ་ཞིག་མཐོང་སྙམ་མོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རྒྱལ་པོ་བྱམས་པའི་སྟོབས་ཕྱི་རོལ་དུ་སྐྱེད་མོས་ཚལ་དུ་ཆས་པ་དང་།",
    "ལྷ་བདག་ཅག་ནི་མོད་ལ་བཀུམ་པའི་ཤ་དང་ཁྲག་འཚལ་ན་མོད་ལ་བཀུམ་པའི་ཤ་དང་ཁྲག་གིས་རྗེས་སུ་གཟུང་དུ་གསོལ།",
    "ཅི་ནས་ཀྱང་འདི་རྣམས་ལ་བདག་གིས་རང་གི་ཁྲག་སྦྱིན་པར་བྱའོ་སྙམ་སྟེ།",
    "ཤེས་ལྡན་དག་ངའི་ཡན་ལག་གི་རྩ་ཐམས་ཅད་ཆོད་ཅིག་དང་སློང་མོ་བའི་སྐྱེ་བོ་ཚིམ་པར་བྱའོ།",
    "དེ་ན་ཡང་ངས་འདི་རྣམས་རང་གི་ཁྲག་གིས་ཚིམ་པར་བྱས་ཏེ་བརྟུལ་ཞུགས་ལྔའི་གཞི་རྣམས་ལ་བཀོད་དོ།",
    "མོ་ཕྱོགས་ནས་དག་པ།",
    "ཕྱི་མོའི་ཕྱོགས་ཟུང་བདུན་རྒྱུད་ཀྱིས་བཟུང་སྟེ་རིགས་ལ་གཏམ་གྱིས་མ་ཕོག་པ།",
    "བྱི་བྲུན་མ་གཏོགས་པ་རང་གི་ལག་གིས་ས་མི་རྐོ་ཞིང་བརྐོར་མི་འཇུག་གོ།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་གང་ནས་འདིར་འོངས།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་རབ་ཏུ་བྱུང་ཡང་རུང་མ་བྱུང་ཡང་རུང་།",
    "རེ་ཞིག་ཁོ་བོ་ནི་རབ་ཏུ་འབྱུང་ངོ།",
    "དེ་ནས་རྒྱལ་པོ་ཀྲྀ་ཀཱིས་དེ་ཉིད་ཀྱི་ནུབ་མོ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་སྟ་གོན་བྱས་ནས་ནང་པར་སྔར་ལངས་ཏེ་གདན་བཤམས་ནོར་བུའི་ཆུ་སྣོད་བཞག་ནས།",
    "རྣམ་གྲངས་དུ་མར་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་རང་གི་ལག་ནས་བསྟབས་ཤིང་ཚིམ་པར་བྱས་སོ།",
    "བྱི་བྲུན་མ་གཏོགས་པར་རང་གི་ལག་གིས་ས་མི་རྐོ་ཞིང་བརྐོར་མི་འཇུག་གོ།",
    "མོན་སྲན་གྲེའུ་ལ་སོགས་པ་མཐའ་གཅིག་ཏུ་ཞོག་ལ།",
    "རིམ་གྱིས་བསོད་སྙོམས་ལ་རྒྱུ་བ་ན་རྫ་མཁན་དགའ་སྐྱོང་གི་ཁྱིམ་གང་ན་བ་དེར་གཤེགས་ཏེ་བྱོན་ནས་སྒོ་འཕར་ལ་མི་དྲག་པར་དལ་བུ་དལ་བུས་བརྡབས་པ་དང་།",
    "དེའི་ཚེ་རྫ་མཁན་དགའ་སྐྱོང་ནི་དགོས་པ་འགའ་ཞིག་གི་ཕྱིར་ཕྱི་རོལ་དུ་སོང་བར་གྱུར་ནས།",
    "རྫ་མཁན་དགའ་སྐྱོང་གི་ཕ་མས་སྒོ་འཕར་བརྡབས་པའི་སྒྲ་ཐོས་སོ།",
    "རྫེའུ་ན་སྲན་ཚོད་མཆིས་མོད་ཀྱི་ཁྱོད་ལ་བསྙེན་བཀུར་བགྱིད་པ་ནི་སླད་རོལ་དུ་མཆིས་ལགས་ཀྱིས།",
    "རྒྱལ་པོ་ཆེན་པོ་ངས་བྱང་གི་སྒྲ་མི་སྙན་གྱི་དུས་བྱིན་གྱིས་བརླབས་ནས་ཉིད་ཁོ་ནས་ཕྲུ་བའི་ནང་ནས་ཟན་དྲོན་དང་།",
    "དེ་ནས་ཕྱི་ཞིག་ནས་རྫ་མཁན་དགའ་སྐྱོང་འོངས་ནས་རྫ་མཁན་དགའ་སྐྱོང་གིས་ཕྲུ་བའི་ནང་ན་ཟན་དྲོན་དང་།",
    "རྫེའུ་ན་སྲན་ཚོད་མཆིས་པ་འདི་སུ་ཞིག་གིས་གསོལ།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་འདིར་སྒོ་འཕར་ལ་རྡེབས་པའི་སྒྲ་ཞིག་ཐོས་སོ།",
    "རྫེའུ་ན་སྲན་ཚོད་མཆིས་མོད་ཀྱི།",
    "ཁྱོད་ལ་བསྙེན་བཀུར་བགྱིད་པ་ནི་སླད་རོལ་དུ་མཆིས་ལགས་ཀྱིས་གལ་ཏེ་བཞེད་ན་ཉིད་ཀྱིས་བཞེས་ཏེ་ཡོངས་སུ་ལོངས་སྤྱད་དུ་གསོལ་ཞེས་གསོལ་པ་དང་།",
    "དེའི་ཚེ་རྫ་མཁན་དགའ་སྐྱོང་དགོས་པ་འགའ་ཞིག་གི་ཕྱིར་ཕྱི་རོལ་དུ་སོང་བར་གྱུར་ཏོ།",
    "རྫ་མཁན་དགའ་སྐྱོང་གི་ཕ་མ་ལོང་བས་ལས་ཀྱི་ཁང་པ་ཐོག་འཆུ་བའི་སྒྲ་ཐོས་སོ།",
    "རྫ་མཁན་དགའ་སྐྱོང་གི་ལས་ཀྱི་ཁང་པ་རྩྭ་སར་པས་གཡོགས་པ་འཆུ་བའི་འཕགས་པ་དེ་སུ་ཞིག།",
    "དེ་ནས་ཕྱི་ནས་རྫ་མཁན་དགའ་སྐྱོང་འོངས་ནས་རྫ་མཁན་དགའ་སྐྱོང་གིས་ལས་ཀྱི་ཁང་པ་གཡོགས་པའི་རྩྭ་སར་པ་བཤུས་པར་མཐོང་ངོ།",
    "ཡབ་ཡུམ་ལས་ཀྱི་ཁང་པ་གཡོགས་པའི་རྩྭ་སར་པ་དེ་རྣམས་སུ་ཞིག་གིས་བཤུས་ལགས།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་འདིར་ལས་ཀྱི་ཁང་པ་གཡོགས་པའི་རྩྭ་སར་པ་འཆུ་བ་ཐོས་སོ།",
    "དེ་དག་གིས་འདི་སྐད་ཅེས།",
    "བཙུན་པ་རྫ་མཁན་དགའ་སྐྱོང་གིས་ནི་རྙེད་པ་ལེགས་པར་རྙེད་དེ།",
    "ཁྱོད་ཀྱིས་འབྲས་སོག་མའི་སྦུབས་སུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་ཁོང་ལ་རྫ་མཁན་དགའ་སྐྱོང་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་རྫ་མཁན་དགའ་སྐྱོང་ལ་འདི་སྐད་ཅེས།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་ལ་རྒྱལ་པོ་ཀྲྀ་ཀཱིས་འབྲས་སོག་མའི་སྦུབས་སུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་པོ་བསྐུར་བ་འདི་དག་ཡིན་གྱིས།",
    "དེ་ལས་ཁྱོད་བདག་ཉིད་དང་ཁྱོད་ཉིད་ཀྱི་ཕ་མ་ཡང་དག་པའི་བདེ་བས་ཚིམ་པར་བྱ་བ་དང་།",
    "རྫ་མཁན་དགའ་སྐྱོང་གང་ན་བ་དེར་སོང་ནས་ཕྱིན་པ་དང་།",
    "དེས་པ་དགའ་སྐྱོང་ཁྱོད་ལ་རྒྱལ་པོ་ཀྲྀ་ཀཱིས་འབྲས་སོག་མའི་སྦུབས་སུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་པོ་བསྐུར་བ་འདི་དག་ཡིན་གྱིས།",
    "དེ་ལས་ཁྱོད་བདག་ཉིད་དང་ཁྱོད་ཀྱི་ཕ་མ་ཡང་དག་པའི་བདེ་བས་ཚིམ་པར་བྱ་བ་དང་།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཀྱིས་དཀའ་བ་སྤྱད་པ་དོན་མེད་པར་ཐུགས་སུ་ཆུད་ནས་ཅི་བདེར་དབུགས་འབྱིན་པ་དང་།",
    "མར་དང་ཏིལ་མར་གྱིས་སྐུ་བྱུགས་ནས་ཆུ་འཇམ་པོས་སྐུ་འཁྲུ་བར་མཛད་པ་དེའི་ཚེ་བཙུན་མོ་ཡང་ཅི་བདེར་དབུགས་འབྱིན་པ་དང་།",
    "ཇི་མངོན་ཁྱོད་ཡིད་ཆེས་པར་བྱའོ།",
    "ཉི་མ་གཅིག་ནི་བཙུན་མོའི་ནང་དུ་གསོལ་བ་དེའི་ཚེ་གྲགས་འཛིན་མ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བུ་ཁྱོད་ཀྱི་ཡབ་གང་ཡིན་པ་དེ་ལ་ཕུལ་ཅིག།",
    "མི་གཟིགས་པ་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་བཙུན་མོའི་བུད་མེད་དང་ཤཱཀྱ་རྣམས་དང་བཅས་པ་ངོ་མཚར་སྐྱེས་ནས།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་ཐོས་ནས་དེ་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་དུ་སོང་སྟེ་ཕྱིན་ནས།",
    "དེང་གི་གདུགས་གཅིག་ལ་མཆིས་སུ་གསོལ་ཅིག་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྒྲ་ཅན་ཟིན་གྱི་སྐྱེ་བོའི་དུས་སྟོན་ཆེན་པོ་བྱས་སོ།",
    "བཟང་མོ་བདག་ཅག་གིས་བུ་ལོན་དེད་པ་དང་ནོར་འཕྲོག་པ་སྐྱེས་ཀྱིས་ཟོང་ཐོགས་ཏེ་རྒྱ་མཚོ་ཆེན་པོར་འཇུག་ཏུ་འགྲོའོ།",
    "དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་ཐག་པ་རང་གི་བཟོ་ལ་མཁས་པ་ཞིག་གནས་ཏེ།",
    "དེ་རང་གི་བཟོས་ཐམས་ཅད་གྲུབ་པར་འགྱུར་རོ།",
    "དེས་དེའི་རང་གི་བཟོས་འབྱོར་པ་འགྲུབ་པ་མཐོང་ནས་སྨྲས་པ།",
    "དེར་སོང་ན་ཚུལ་མ་ཡིན་པས་སྡུག་བསྔལ་བར་འགྱུར་རོ།",
    "རུང་གིས་དེ་བཞིན་དུ་བྱའོ་ཞེས་དེས་དེ་ལ་བསླབ་པར་བརྩམས་པ་ན་དེ་སྒྲིན་པོ་གཡེར་བག་ཅན་ཞིག་པས་དེས་དུས་ཐུང་ངུ་ཞིག་གིས་ཐ་ག་པའི་ལས་རྣམས་ལོབས་སོ།",
    "ཞང་པོ་ཁྱོད་ཀྱང་ལས་འདི་ཁོ་ན་བྱེད་ལ་བདག་ཅག་ཀྱང་འདི་ཁོ་ན་བྱེད་པ་ལས་ཅིའི་ཕྱིར་ཁྱོད་ནི་བཟང་པོས་འཁྲུ།",
    "ནུབ་མོ་ནི་རྐུན་པོ་བྱེད་དོ།",
    "ཚ་བོ་ཁྱོད་ཀྱིས་རྐུན་པོ་བྱེད་མི་ནུས་སོ།",
    "རེ་ཞིག་འདི་བགམ་པར་བྱའོ་སྙམ་ནས་དེ་ཁྲིད་དེ་ཚོང་འདུས་སུ་སོང་ནས་དེས་དེར་རི་བོང་ཞིག་ཉོས་ཏེ་དེ་ལ་གཏད་ནས་ཚ་བོ་རེ་ཞིག་སྲེགས་ཤིག་དང་།",
    "དེའི་བར་དུ་བདག་ཁྲུས་བྱས་ནས་འོང་ངོ་ཞེས་དེ་ཁྲུས་བྱེད་དུ་སོང་བ་དང་།",
    "ཚ་བོ་རི་བོང་འདིའི་གཟུགས་བཞི་པ་ཤོས་གར་སོང་།",
    "རེ་ཞིག་བདག་ཀྱང་རྐུན་མ་ཡིན་ན།",
    "དེས་དེ་དང་རི་བོང་གཟུགས་གསུམ་པོ་ཁྱེར་ཏེ་ཆང་འཚོང་གི་ཁྱིམ་ཞིག་ཏུ་ཞུགས་ནས་ཚ་བོ་ཆང་བཏུང་ངམ།",
    "བདག་གིས་ནི་མ་འཐུངས་པས་གྱ་གྱུ་བྱར་ཅི་ཡོད།",
    "ཞང་པོ་ཁྱོད་རྐུན་མ་བྱེད་ཀྱང་ཐབས་མི་ཤེས་ཏེ།",
    "དེ་ནི་གཅིག་པུ་ཡིན་པས་སླར་འདྲེན་མ་ནུས་ནས་མགོ་བཅད་དེ་ཁྱེར་ཏེ་སོང་ངོ།",
    "དེའི་མགོ་གཅིག་གིས་བཀུམ་ནས་འཚལ་ཏེ་མཆིས་སོ།",
    "ཤེས་ལྡན་དག་མགོ་བཅད་དེ་ཁྱེར་ཏེ་སོང་བ་གང་ཡིན་པ་དེ་ནི་རྐུན་ཆེན་ཡིན་ནོ།",
    "བདག་གིས་ཞང་པོའི་མགུལ་ནས་འཇུས་ཏེ་དུང་མོས་མི་གདབ་པ་ལྟ་མི་སྲིད་དོ་སྙམ་ནས།",
    "དེས་བདག་ཉིད་སྨྱོན་པའི་ཆ་བྱད་དུ་ཞུགས་ནས་བུད་མེད་ཀྱི་མགུལ་ནས་ཀྱང་འཇུས།",
    "ཁྱིའི་མགུལ་ནས་ཀྱང་འཇུ་བར་བརྩམས་ནས་གང་གི་ཚེ་འཇིག་རྟེན་གྱིས་སྨྱོས་པར་ཤེས་པ་དེའི་ཚེ་རོ་མགོ་རྡུམ་པང་དུ་བླངས་ཏེ་ཇི་ཙམ་འདོད་ཀྱི་བར་དུ་ངུས་ནས་སོང་ངོ།",
    "སྨྱོན་པ་ཞིག་གིས་རོ་མགོ་རྡུམ་དེ་པང་དུ་བླངས་ཏེ་ཇི་ཙམ་འཚལ་གྱི་བར་དུ་ངུས་ནས་མཆིས་སོ།",
    "བདག་གིས་ཞང་པོ་ལ་བསྐུར་སྟི་མི་བྱ་བ་ལྟ་མི་སྲིད་དོ་སྙམ་ནས་དེས་ཤིང་རྟ་པའི་ཆ་བྱད་དུ་བྱས་ནས་ཤིང་རྟ་ཤིང་སྐམ་གྱིས་བཀང་སྟེ།",
    "ཕྱོགས་དེར་འོངས་ནས་དེའི་སྟེང་དུ་ཤིང་རྟ་ཤིང་སྐམ་གྱིས་བཀང་བ་བཞག་སྟེ་གླང་བཀྲོལ་ནས་ཤིང་རྟ་མེས་བཏང་སྟེ་སོང་བ་དང་།",
    "སུས་དེ་དག་གིས་ཇི་ལྟར་གྱུར་པ་རྣམས་སྨྲས་པ་དང་རྒྱལ་པོས་སྨྲས་པ།",
    "བདག་གིས་ཞང་པོ་ལ་དུར་ཁྲོད་དུ་མཚུན་གྱི་བྱ་བ་མ་བྱས་པ་ནི་མི་སྲིད་དོ་སྙམ་ནས།",
    "དེས་བྲམ་ཟེའི་ཆ་བྱད་དུ་བྱས་ནས་ཁྱིམ་ནས་ཁ་སློང་ཞིང་བརྒྱུས་ཏེ་བསླངས་པ་དེ་ལས་དེའི་ཕངས་ཤ་ལྔ་བྱས་ནས་དུར་ཁྲོད་དུ་བཞག་སྟེ་སོང་ངོ།",
    "ལྷ་བྲམ་ཟེ་ཞིག་གིས་ཁྱིམ་ནས་སློང་ཞིང་བརྒྱུས་ཏེ་ཕྱོགས་གང་དུ་རོ་མགོ་རྡུམ་བསྲེགས་པ་དེར་དེས་ཕངས་ཤ་ལྔ་བགྱིས་སྟེ་བཞག་སྟེ་མཆིས་ལགས་སོ།",
    "བདག་གིས་ཞང་པོའི་རུས་པ་རྣམས་གང་གཱར་མི་འདོར་བ་ལྟ་མི་སྲིད་དོ་སྙམ་ནས།",
    "དེས་ཐོད་པ་ཅན་གྱི་ཆ་བྱད་དུ་བྱས་ཏེ་ཕྱོགས་དེར་སོང་ནས་དེས་དེར་ལུས་ཐལ་བས་བྱུགས་ཤིང་རུས་པ་དང་ཐལ་བས་ཐོད་པ་བཀང་ནས་གང་གཱར་ཕོ་སྟེ་སོང་ངོ།",
    "ངས་དེ་གཟུང་ངོ་ཞེས་རྒྱལ་པོས་གང་གཱའི་གྲུའི་ནང་དུ་སྐྱེད་མོས་ཚལ་བྱེད་དུ་བཅུག་སྟེ།",
    "འགྲམ་གཉིས་སུ་སྲུང་མའི་མི་དག་བཀོད་ནས་རྒྱལ་པོའི་བུ་མོ་གཟུགས་བཟང་བ།",
    "བལྟ་ན་སྡུག་པ་ཞིག་ཆུའི་སྐྱེད་མོས་ཚལ་དེར་བཞག་སྟེ་བསྒོ་བ།",
