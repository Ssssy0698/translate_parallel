    "ལྷ་ཁྱོད་འདུད་པའི་ཚུལ་མ་ཡིན།",
    "ཆུད་མི་ཟ་བའང་ཚོགས་དང་དུས།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "ཕྱི་ནས་ལྔ་ཡང་བབས་ནས་བཱ་རཱ་ཎ་སཱི་ཉིད་དུ་འཇུག་པར་བརྩམས་པ་ན་ཇི་ཙམ་ན་ཤིང་རྟས་འཚོ་བའི་ཚོང་པ་དག་འགྲོ་བ་ན་ཤིང་རྟས་འཚོ་བ་ཅིག་གི་གླང་དག་ཉམ་ཆུང་བཞིན་དུ་དེ་དག་ལ་དེས་ལྕག་གཟེར་བུ་ཅན་གྱིས་ཡང་ནས་ཡང་དུ་གཞུས་ཏེ།",
    "ཀྱེ་ཤིང་རྟས་འཚོ་བ་ཁྱོད་ཀྱི་གླང་ཉམ་ཆུང་བ་འདི་རྣམས་ལ་ལྕག་གཟེར་བུ་ཅན་གྱིས་ཡང་ནས་ཡང་དུ་གཞུས་ཏེ་ཅི་རུང་།",
    "གལ་ཏེ་འགྲོ་མི་ནུས་ན་དལ་བུས་འགྲོར་ཆུག་ལ་ཕྱི་ནས་སོང་ངོ་ཅོག།",
    "མ་ལ་བདག་ཅག་གིས་བརྩོན་འགྲུས་བརྩམ་པར་བྱའོ་ཞེས་སྨྲས་ནས་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "ཐུབ་པ་ཆེན་པོ་འོད་སྲུང་གི།",
    "བདག་ཅག་གི་ནི་ཟག་པ་ཡང་།",
    "དེར་ཐོག་མར་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཏེ་དགྲ་བཅོམ་པ་མངོན་སུམ་དུ་བྱས་ནས།",
    "དེ་དུས་གཞན་ཞིག་ན་བཙུན་མོ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "ཡན་ལག་གི་མཆོག་ཐམས་ཅད་དང་ལྡན་པ་ཞིག་བཙས་སོ།",
    "གཞན་ཡང་ཡོ་བྱད་ཀྱི་བྱེ་བྲག་གཙོ་བོ་གཙོ་བོ་དག་གིས་སྲིང་བར་བྱེད།",
    "གང་གི་ཉི་མ་ལ་བཙས་པ་དེ་ཉིད་ཀྱི་ཉི་མ་ལ་བཱ་རཱ་ཎ་སཱིར་ཡུལ་མི་དང་གྲོང་མི་འཐབ་མོ་ཆེན་པོ་བྱུང་ངོ།",
    "བཙུན་མོའི་ཚོགས་ཀྱིས་སྨྲས་པ།",
    "ལྷ་འདི་བཙས་པ་ན་བཱ་རཱ་ཎ་སཱིར་གྲོང་མི་དང་ཡུལ་མི་རྣམས་འཐབ་མོ་ཆེན་པོ་བྱུང་བས་དེའི་སླད་དུ་ཁྱེའུའི་མིང་འཐབ་མོ་སྐྱེས་སུ་གདགས་སོ་ཞེས་བཏགས་སོ།",
    "དཀའ་ཐུབ་ཀྱིས་གདུང་བར་བྱེད་པའི་རྒྱལ་སྲིད་ཁྱོད་ཀྱི་ལག་ཏུ་འོངས་ན་ཅིའི་ཕྱིར་རྒྱལ་སྲིད་སྤངས་ཏེ་རབ་ཏུ་འབྱུང་།",
    "ཁྱོད་ནི་ངའི་བུ་གཅིག་པ་སྡུག་པ།",
    "ང་ཤི་བར་གྱུར་ན་མི་འདོད་བཞིན་དུ་ཁྱོད་དང་འབྲལ་གྲང་།",
