    "ཡུལ་གྱི་དབྱེ་བར་རྣམ་པར་གཞག་ིཔར་གོ་ཇི་ལྟར་བྱེད་སྙམ་ན།",
    "རྟོག་པའི་དབྱེ་བ་ཡང་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "གཅིག་ཐ་དད་པ་ན་གཞན་ཐ་དད་པར་སྒྲུབ་པར་བྱེད་པའི་འབྲེལ་པ་དེ་ཉིད་སྟོན་པ་ནི་ཤེས་པ་དང་ཤེས་བྱ་དག་ནི་ཞེས་བྱ་བའོ།",
    "དེས་ན་ཤེས་པའི་ཚུལ་ཐ་དད་པ་ལས་ཡུལ་ཐ་དད་པ་༤རྣམ་པར་གཞག་༧གོ་ཞེས་རིགས་ཏེ།",
    "བེམས་པོའི་བདག་ཉིད་ཅན་དོན་གྱི་རྣམ་པར་གཞགཔ་ནི་དེ་ལ་རག་ལས་པའི་ཕྱིར་རོ།",
    "དེས་ནི་འདི་ནི་གཞལ་བྱ་གཉིས་ཀྱིས་རྣམ་པར་གཞག་པ་ཡིན་ཏེ།",
    "༡༥འཛིན་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ནི་རིགས་པར་ཡང་མཐོང་ངོ་སྙམ་ན།",
    "འདི་བཟློག་པའི་ཕྱིར་ན་མ་ཡིན་པར་འཇུག་པས་ཞེས་གསུངས་སོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་གལ་ཏེ་དོན་བྱ་བ་མི་ནུས་པ་ཉིད་སྤྱིའི་མཚན་ཉིད་ཡིན་པར་བརྗོད་ན།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་གཞན་ལ་ལྟོས་ནམཚན་ཉིད་ཡིན་པར་ཉེ་བ་༤ཆེན་པོ་ཡིན་ནོ།",
    "དེས་ན་ཡུལ་གསུམ་པར་དོགས་པ་ན།",
    "སྐྲ་ཤད་ལ་སོགས་པ་དོན་མིན་ཏེ་ཞེས་བྱ་བས་འཇུག་པར་བྱེད་པ་ཡང་མི་འཐད་དེ།",
    "དེས་ན་སྐབས་ལས་སམ་ཉེ་བ་ལས་བརྒྱུད་ནས་ཤེས་པ་སྐྱེད་པར་ནུས་པ་ཉིད་དོན་བྱེད་མི་ནུས་པར་བརྗོད་པ་ཡིན་ནོ།",
    "གཞུང་ནི་རྟོགས་པར་སླ་བ་ཉིད་དོ།",
    "དོན་འདི་ཡིན་པ་ཡང་སྟེ་གང་དང་གང་དུ་གསལ་བ་དང་མི་གསལ་བར་སྣང་བ་ཡོད་པ་དེ་དང་དེར་དེ་ལྷག་པར་ཞེསབྱས་པ་དངོས་སམ་བརྒྱུད་པས་ནུས་པ་ནི་མ་ཡིན་གྱི།",
    "རབ་རིབ་ཅན་གྱིས་དམིགས་པ་ཞེས་བྱ་བ་ནི་དམིགས་པ་ཉིད་དུ་ལྷག་པར་ཞེན་པའོ།",
    "སྒྲ་ལས་བྱུང་བ་ལ་སོགས་པར་ནི་ངེས་པ་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ཡང་ལྷག་པར་ཞེན་པར་བྱ་བའི་ཡུལ་ལ་ལྟོས་པ་ཁོ་ནས་སྦྱར་བ་ཡིན་ནོ།",
    "ིདེས་བྱས་པ་འཇུག་པ་ངེས་པ་ལ་སོགས་པ་ལ་གོ་རིམས་བཞིན་དུ་དངོས་དང་བརྒྱུད་པས་ནུས་པ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ནི་ལྷག་པར་ཞེན་པར་བྱས་པའི་འཆིང་བའི་ནུས་པ་ཉིད་མེད་པ་ཡིན་གྱི་། རྣམ་པ་ཐམས་ཅད་དུ་དེའི་འབྲས་བུ་ལ་དེའི་ནུས་པ་མེད་པ་ནི་མ་ཡིན་ནོ།",
    "དེའི་དོན་བྱ་བ་དོན་དུ་གཉེར་བ་དེ་དག་ནི་དེ་ལ་འཇུག་པར་བྱ་བའི་དོན་དུ།",
    "མཐོང་བ་དང་ལྷག་པར་ཞེན་པ་དང་འཇུག་པ་རྣམས་ནི་དེ་ལ་ཡང་ཡོད་པའི་ཕྱིར་རོ་སྙམ་ན།",
    "བརྫུན་པའི་ཁྱད་པར་ཅན་དུ་ངེས་ཀྱང་དེའི་ཡུལ་ཙམ་ཞིག་སྙམ་དུ་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཁྱད་པར་ཅན་གྱི་ཡུལ་ཉིད་ནི་བདེན་པའི་ཁྱད་པར་ཅན་དུ་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "ལན་གདབ་པར་རིགས་པ་ཡིན་ནོ།",
    "དེས་དེ་ལྟར་དངོས་སམ་བརྒྱུད་པས་ནུས་པ་ཐ་དད་པ་ན་ཡུལ་རྣམ་པ་གཉིས་སུ་རྣམ་པར་གཞག་ནས།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་མཚུངས་པར་བརྗོད་པ་དང་།",
    "འདིར་ནི་ངོ་བོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཡང་རིག་པ་ཡོད་པ་ཡིན་ཏེ།",
    "ལྷག་པར་ཞེན་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གྲུབ་པའི་མཐའི་དགོངས་པ་ནི་འདི་ཡིན་ཏེ།",
    "ཐ་དད་པར་མཐོང་བ་མེད་ན་ཡང་དེ་ཁས་བླངས་པའི་སྐབས་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྤྱི་དང་ཁྱད་པར་གྱི་རྣམ་པ་མེད་པའི་ཁྱད་པར་གྱི་ཤེས་པ་འདི་ལ་ཡོད་པ་སྟེ།",
    "འགྲེལ་པར་ནི་རྟོགས་པས་ནི་ཞེས་བྱ་བ་བྱེད་པ་པོའི་གསུམ་པར་བྱས་སོ།",
    "དེས་ན་བག་ཆགས་ཙམ་ལས་འབྱུང་༤བའི་རྣམ་པར་རྟོག་པ་ལ་སྣང་བ་ཡིན་ཡང་།",
    "གནོད་པར་བྱེད་པ་ལས་ེཁྱད་པར་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "དངུལ་བཞིན་དུ་སླུ་ཾབ་དང་ལྡན་པའི་ལྷག་པར་ཞེན་པ་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "༢༣གཞན་འཛིན་པར་རློམ་པ་ནི་མེད་དོ།",
    "དེ་ཁོ་ན་སེམས་པར་བྱེད་པ་ནི་རྣམ་པར་རྟོག་པ་ལ་དངོས་པོ་སྣང་བར་མ་མཐོང་བ་དང་།",
    "དངོས་པོ་སྣང་བ་ལ་ཡང་བརྟག་༤པའི་རྣམ་པར་སྒྲོ་མི་འདོགས་པ་ན།",
    "སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ངེཔར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "ཁྱད་པར་ཅན་ནམ་དེར་བརྟེན་པའི།",
    "རྗེས་སུ་དཔག་པའི་རྟོག་པ་ལ་ནི་ཞེས་གསུངས་སོ།",
    "དེ་རྟོགས་པར་བྱས་པ་མིང་དང་མིང་ཅན་གྱི་འབྲེལ་པའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་ཉེས་པར་འགྱུར་བ་ཉིད་དོ།",
    "༢༧ལ་སྤྱིའི་ཐ་སྙད་ཡིན་པ་དེ་ལྟ་ན་ཡང་གང་ལ་ལྷག་པར་ཞེན་པར་བྱས་པའོ།",
    "དངོས་པོ་ཡོད་པར་ཞེན་པ་དེར་དེ་ཁོ་ནར་སྤྱི་ཉིད་དུ་རྣམ་པར་གཞགགོ།",
    "གལ་ཏེ་སྒྲ་བསྒྲུབ་པར་བྱ་བའི་ཡུལ་ཅན་ཉིད་ཀྱིས་སྤྱིའི་ཡུལ་ཅན་མ་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཚུལ་གསུམ་པའི་ཡུལ་ཅན་ཉིད་ཀྱིས་༧སྤྱིའི་ཡུལ་ཅན་ཡིན་པར་འགྱུར་ཏེ།",
    "དེས་བསྟན་པར་བྱ་བ་ནི།",
    "མ་ཡིན་ཏེ་དེ་ལ་ཡང་དེས་བསྟན་པ་ཙམ་བྱས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཡུལ་དངོས་པོ་ཉིད་ཡིན་པར་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ།",
    "ཡུལ་མ་ཡིན་པར་ཡང་ཞེས་བྱ་བའི་དེས་ན་འདི་ལ་སྐྱོན་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "ཕྱིན་ཅི་ལོག་ཏུ་ངེས་པར་བཟུང་བས་བྱས་ཏེ།",
    "དེ་ནི་སྤྱི་ཉིད་དོ་ཞེས་ནི་ངེས་པར་མི་བཟུང་སྟེ།",
    "འདིས་ནི་གལ་ཏེ་རུང་བའི་ཡུལ་ན་དེ་གནས་པར་ན་བློ་ཡོད་ན་དེའི་ཚེ་སྤྱི་ལ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ནི་ཡུལ་འཛིན་པར།",
    "ཇི་ལྟར་མངོན་སུམ་གྱིས་༧རྟོགས་པ་ནི་མངོན་སུམ་ཡིན་ལ་རྗེས་སུ་དཔག་པས་རྟོགས་པ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་པ་དེ་བཞིན་དུ་རིག་བྱེད་ཀྱིས་རྟོགས་པ་ནི་ཉེ་བར་བསྟན་པར་བྱ་བ་ཉེ་བར་འཇལ་བས་ནི་ཉེ་བར་གཞལ་བར་བྱ་བ་དོན་གྱིས་གོ་བ་ལ་སོགས་པས་ནི་དོན་གྱིས་གོ་བའི་ཡུལ་བསྒྲུབ་པར་བྱ་བ་མིན་པའི་ཕྱིར་བླར་ེའགལ་བ་ཉིད་དོ།",
    "གལ་ཏེ་དེས་ལྐོག་ཏུ་གྱུར་པ་ཡང་རྟོགས་པར་མི་ནུས་ན་ནི་དེའི་ཚེ་རྗེས་སུ་དཔག་པར་ཡུལ་རྣམ་པ་གཉིས་གྲུབ་པར་ཇི་ལྟར་འགྱུར་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "༣༡རྗེས་སུ་དཔག་པ་དོན་མེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྟོགས་པར་སླའོ།",
    "མིག་མེད་མཐོང་བ་ཞེས་བྱ་བ་བཞིན་ཞེས་བྱ་བ་ལ་ཇི་ལྟར་ཞེས་བྱ་བ་བསྣན་པར་བྱའོ་། དེའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མཇུག་བསྡུ་བའི་ཐབས་ཀྱིས་རྣམ་པར་རྟོག་པ་དང་པོ་ཡང་བསལ་བར་བརྗོད་པ་ཡིན་ནོ།",
    "མངོན་སུམ་ནི་ཁྱབ་པ་གྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཉེ་བར་བསྟན་པ་ཅུང་ཟད་ཀྱང་མི་ནུས་སོ།",
    "རྗེས་སུ་དཔག་པ་དོན་མེད་པར་ཇི་ལྟར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྟོག་༤པ་གང་ཡིན་པ་དེ་ཡང་ཤེས་པའི་རྣམ་པར་གྱུར་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེས་ན་ཡུལ་གཉིས་སུ་འགྲུབ་པར་ཇི་ལྟར་འགྱུར།",
    "རྗེས་སུ་དཔག་པའི་རྣམ་པར་རྟོག་པའི་རྣམ་པ་ཉིད་ལ་དེ་ལྟར་ངེས་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "ཡུལ་ལ་བརྟེན་པ་ཡང་རིག་པ་ཉིད་ཀྱིས་གྲུབ་པར་བརྗོད་པ་ཡིན་ལ་རྗེས་སུ་དཔག་པ་དོན་མེད་པ་ཡང་མ་ཡིན་ནོ།",
    "གང་ཞིག་ཕྱི་རོལ་གྱི་དོན་དུ་ལྷག་པར་ཞེན་པ་ན་ཡུལ་གཉིས་སུ་གྲུབ་པར་འགྱུར་སྙམ་ན།",
    "ཞེས་གསུངས་སོ།",
    "ཅི་འདི་རྒྱལ་པོའི་བཀའ་འམ་སྙམ་ན་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བརྗོད་པར་བྱ་བའི་ཁྱད་པར་གྱི་ཡིད་ཀྱི་འགྱུར་བ་ཉམས་སུ་མྱོང་ལ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འབྲེལ་མེད་རྟེན་ལ་ཞེས་གསུངས་སོ།",
    "དེ་བས་ན་གཞལ་བྱ་གཉིས་ནི་རང་རིག་པར་ཚུུགྲུབ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་གནོད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བ་ནི་བཟོད་ནས་མིན་ནམ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་འདིའི་ཐ་སྙད་ཀྱང་གྲུབ་པ་ཟིན་པ་ཉིད་མ་ཡིན་ནམ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པས་གྲུབ་པའི་མེ་གཉིས་ལ་རྗེས་སུ་དཔག་པ་དང་མངོན་སུམ་གྱིས་གྲུབ་པར་ནི་གཞན་ཡང་མི་སེམས་སོ་སྙམ་ན།",
    "རིགས་ལ་སོགས་པས་ཁྱད་པར་ཅན་གྱི་དོན་གསལ་བར་སྣང་བ་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་ཤེས་པ་གཅིག་ཉིད་ནི།",
    "གསལ་བར་སྣང་བ་རྣམ་པར་རྟོག་པ་མེད་པ་ནི་གཞན་གྱི་ཡིན་ལ།",
    "ནུས་པ་གཟུང་བ་མེད་པར་ནི།",
    "དངོས་པོ་དོནགཉེར་བའི་ངང་ཚུལ་ཅན་རྟོགས་པར་འདོད་པ་དེ་བསྙོན་པ་མ་ཡིན་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པས་ཤེས་པའི་དུས་ལའོ།",
    "འོ་ན་དེ་རྣམ་པ་གཉིས་སུ་ག་ལས་འགྲུབ་སྙམ་ན་རྟོགས་པའི་རྣམ་པ་ཐ་དད་པས་ནི་ཞེས་གསུངས་སོ།",
    "དེས་ན་ཤེས་པ་ཉིད་ཀྱི་ཁྱད་པར་དུ་བྱས་པ་ཡིན་ན།",
    "དེ་ལ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཤེས་པ་ལ་ལྟོས་ཏེ།",
    "དེ་ཉིད་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་མངོན་སུམ་ལ་ལྟོས་ན་རྣམ་པར་རྟོག་པ་ཉེ་བར་མཁོ་བ་མེད་པ་ཡིན་ནོ།",
    "དེ་མེད་པར་ཡང་མངོན་སུམ་འཇུག་པར་བྱེད་པར་ཇི་ལྟར་མི་འགྱུར།",
    "རྗེས་སུ་དཔག་པ་ནི་འཇུག་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་སྦྱར་རོ།",
    "འདི་ལྟར་ནུས་པའི་རྣམ་པར་རྟོག་པ་ནི་ཡོད་ཀྱང་མངོན་སུམ་ཙམ་ལས་སྐྱེས་པ་ཡིན་གྱི་དེའི་རང་བཞིན་གྱི་རྟགས་ལ་བརྟེན་པ་ནི་མ་ཡིན་ཏེ།",
    "དོན་ནི་འདི་ཡིན་ཏེ་གལ་ཏེ་ཡང་གོམས་པའི་གནས་སྐབས་ན་རྟགས་དང་རྟགས་ཅན་གྱི་དངོས་པོར་ལྷག་པར་ཞེན་པར་མ་ཚོར་བར་དེ་ལྟ་ན་ཡང་།",
    "གཞན་དག་བསམ་པ་མི་རིག་ནས་རྣམ་པ་ཐམས་ཅད་དུ་མངོན་སུམ་འཇུག་པར་བྱེད་པ་ཉིད་ཡིན་པ་འགོག་པ་ཡིན་ནོ་སྙམ་པས་དང་པོ་མ་ཡིན་ཡང་ཞེས་སོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དམིགས་པ་མེད་པར་ཡང་དང་པོ་འཇུག་པ་ཉིད་མེད་པའི་ཕྱིར་ན་གོམས་པ་མེད་ལ།",
    "༣༩མཇུག་བསྡུ་བའོ་། འཇུག་པར་བྱེད་པ་ཉིད་དོ་ཞེས་བྱ་བ་འདིས་ནི་མི་ལྡན་པ་རྣམ་པར་གཅོད་པ་བརྗོད་པ་ཡིན་ནོ།",
    "གོམས་པའི་གནས་སྐབས་ན་ཡང་དེའི་རང་བཞིན་ཅན་གྱི་རྗེས་སུ་དཔག་པ་ཉིད་འཇུག་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ། ། གཞན་མཁོ་བ་མེད་ཅེས་ཏེ་གཞན་ཚེའི་མཁོ་བ་མེད་པ་ཡིན་ཞེས་དེ་མ་ཐག་ཁོ་ནར་འཆད་པར་འགྱུར་རོ།",
    "ཊཱི་ཀཱ་མཛད་པ་དེ་ནི་ཚེ་ཡང་མངོན་སུམ་ཁོ་ནར་འཇུག་པར་བྱེད་པ་ཡིན་གྱི་དེའི་རང་བཞིན་ཅན་རྗེས་སུ་དཔོག་པ་ནི་མ་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བའི་མེའི་ཡུལ་ཅན་མེད་པར་རོ།",
    "དེ་མེད་པར་ནི་རྗེས་སུ་དཔག་པ་མེད་པར་རོ།",
    "དེ་མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པ་མེད་པར་ཡང་ངོ།",
