    "སྒྱིད་པར་གོས་སྒབ་ནི་རྐང་པར་གོས་བཀབ་པ་སྒྲོ་གུས་སྒྲོག་ནི་གོས་ཀྱི་སྒོའམ་ལྷམ་སྒྲོ་སོགས་ཀྱིས་བཅིངས་པ།",
    "བརྒྱུགས་ཤིང་ནི་ཐང་ཁ་སོགས་ཀྱི་བརྒྱུགས་ཤིང་བརྒྱུངས་པར་ནི་སྐལ་ཚིགས་བརྒྱུད་མར་ནི་རྒྱུན་ཆགས་སུ་བརྒྱབ་ནི་བརྡུང་ལ།",
    "ཐུགས་སྤྱོད་ལམངའ་ནི་སེམས་ལ་བཞག་པའི་ཞེ་ས་ལ་སོགས་ཇ་སྔོན་འཇུག་མས་འཕུལ་བའི་ངའོ། རྔོན་པའི་ནིཤ་ར་བ་རྔ་ཡབ་ནི་རྔམ་ལས་བྱས་པའིབསིལ་ཡབ་རྔ་ནི་བརྡུང་བའི་རྔ་རྔེའུ་ཆུང་ནི་རྔ་ཆུང་།",
    "རྣམ་པར་བསྔོས་ནི་བམ་པའམ་རུལ་བ་དང་བསྔོགས་པ་ནི་སྐྱོན་མཚང་སྔོགས་ཟིན་པ་ལ་སོགས་པ།",
    "རྡོ་བཅག་ནི་དུམ་བུར་བཅག་པྰ་ཤིང་བཅེར་ནི་ཕུང་པོར་སྲུང་འགྲོས་བཙེམ་ནི་སྲེས་བྱས་པ་བཅུམ་ནི་ཆུང་ངུར་བཏང་བའམ་ཁ་བསུམ་ལའང་འཇུག།",
    "ཆུད་ནི་མཁྱེན་པ།",
    "ལ་སོགས་པ་བས་འཕུལ་ར་མགོ་ལྡན་པའི་ཇའོ། ཡུལ་ལྗོངས་ནི་ཡུལ་ཁམས་ལྗང་བུའི་ནི་སྔོ་ལྗང་མྱུ་ཐུ་ལྗན་ལྗིན་ཁྲོད་ནི་མི་གཙང་བའི་ཉམ་ཉིམ་དབུས་སུ།",
    "སྤོས་ཉུག་ནི་ལུས་ལ་དྲི་བཟང་ཕྱུག་པ་ལག་ཉེས་ནི་སྟེར་མཁན་མེད་པར་ལེན་པ་ཉན་ཧྥེས་ནི་འཁོརོ་རྣམ་བཞིའི་ཡམལ་ཉམས་ནི་རྒུད་པའམ་ཟྭ་། བྲི་བ།",
    "བསྙེན་བསྒྲུབ་ནི་ལྷག་པའི་ལྷ་སྒྲུབ་ལ་བསྙེན་བཀུར་ཞི་ཞབས་ཏོག་ཕྱེ་མར་བསྙིལ་ནི་ཕྱེ་མར་འཇག་པ།",
    "བསྙེམས་པའི་ནི་ང་རྒྱལ་བྱས་ཟིན་པ་རྗེས་བསྙེགས་ནི་རྗེས་འབར་བ་ཁྲེ་གཉེར་བསྙེར་ནི་ཞལ་ཟྭ་། ཁྲོ་བེའི་གཉེར་མ་བསྡུས་པ།",
    "ཞན་ཏུར་ནི་ཆད་ལས་གལ་ཏེ་ནི་མི་འཐད་པ་འཐད་པར་འདྲེན་པའི་ཚིག་གོའུ་ཏ་མ་ནི་ཤཱཀྱའི་རུས་ཀྱི་མིང་།",
    "ཏམ་བུ་ར་ནི་པི་ཝང་ངམ་སྦ་བརྙན་དང་ཏིང་ཏིང་ཤག་ནི་ཆུ་གཏོར་གྱི་ཏིང་ཤག།",
    "གཏན་ལ་འབེབས་ནི་ཡོན་ཏན་རང་རྒྱུད་ལ་དབབ་པ་ལ་སོགས་པ་གས་༧ འཕུམ་བའི་ཏའོ། སྒྲོ་བཏགས་ནི་མེད་པ་ལ་ཡོད་ཅེས་སྒྲོ་འདོགས་ལ་མིང་བཏགས་ནི་ཀ་བ་བུ་མ་སོགས་ལ་མིང་གདགས་པ་ཁ་བཏགས་བཏགས་ནི་དབྲ་ཕམ་པར་བྱེད་པ།",
    "མི་རྟོགཞི་ཅི་ཡང་མི་བསམ་པ་ཡིད་རྟེན་ནི་ཆབཞག་པ་རྟོགས་ལྡན་ནི་ཡོན་ཏན་ཅན་རྟོགས་ནི་ཤེས་པའམ་མཁྱེན་པ།",
    "མི་གཙང་རྟུག་ནི་ཕྱག་ཕལ་སོགས་པ་རར་བཏགས་པའི་ཏའོ། ལྟོས་འགྲོའི་ནི་སྤྲུལ་ལྟག་པ་ནི་གཉའ་བའི་ལྟག་པའམ་འཇིང་པ་དེ་ལྟ་བུ་ནི་དེ་བཞིན་དུ།",
    "བུར་ལྟང་དབུརམ་འབྲས་སོགས་ཀྱི་ལྟང་འགྲང་ལྟོགས་ནི་ཟས་ཞུ་མཐུའི་ཁྱད་པར་ད་ལྟ་ནི་དུས་ལྟོས་ནི་བལྟ་བའི་བསྐུལ་ཚིག།",
    "སྟོན་པའི་བཞུགས་སྟངས་ནི་སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱི་བཞུགས་ཚུལ་བཀུར་སྟི་ནི་སྲི་ཞུ་སྟོབས་ནི་ཕུལ་བ།",
    "སྙིམ་བྱེད་ནི་ཡེ་ཤེས་པ་སྟིམ་པར་བྱེད་པ་སེ་སྟོར་ནི་སོ་གྲམ་མི་འགྲིགས་པ་སྟོར་ཁུང་ཞི་མི་གཙང་བ་དོར་ས་གསང་སྤྱོད་ཟེར་བ་དང་།",
    "སྡུམ་པར་ནི་རང་ཁྱིམམཆོད་སྡོང་ནི་གཙུག་ལག་ཁང་སྡོམ་བུས་བསྐོར་ཞེ་ཁང་པས་བསྐོར་བ།",
    "ཚིག་ཕྲད་ནི་རྗེས་འཇུག་ལ་ལྟོས་པའི་ཚིག་ཐད་རྣམ་པར་ནི་ངེས་པ་ལ་སོགས་པ་རར་བཏགས་པའི་ནའོ།",
    "སྣང་བ་ནི་མཐོང་སྣང་སྣ་ཚོགས་ནི་དུ་མ་ཚོགས་པ་སྣ་ཡི་ནི་སྣོམ་རྩེད་སྣ་སྣབས་ནི་མི་གཙང་སྐབས་ལུད།",
    "མང་དུ་བསྣན་ནས་ནི་ཁ་སྐོར་མང་ངུ་མྱེད་པ་འདྲེས་པར་བསྣོས་ཞི་ཕན་ཚུན་འདྲེས་པར་བསྲེས་པ།",
    "པར་གྱིས་འཕར་ནི་ལཕར་ཚུལ་ལ་སོགས་པ་རྐྱང་ངོ།",
    "སྒོས་ནི་སྤྱི་དང་ཁྱད་པར་སྤེལ་མར་ནི་འདྲེས་མ་འཕྲིན་སྤྲིང་ནི་ཡི་གེའམ་ཐེན་བཏར་བ་སྤྲིངས་ནི་ཟིན་ལ།",
    "བཏགས་པའི་པའོ། སྟག་ལྤགས་ནི་གཞི་དང་འབྲེལ་ན་མ་མགོ་ཅན་དང་གཞི་དང་འབྲེལ་ཀྱང་ཇུག་སྨྲ་ཡོད་ན་པ་རྐྱང་དང་གཞི་དཔམ་འབྲེལ་བའི་མིང་རྐྱང་ལ་པ་རྐྱང་ངོ་ལ་སོགས་ལར་བཏགས་པའི་པའོ། ཕང་པར་ནི་བང་པར་ཕུན་ཚོགས་ནི་ཕུན་སུམ་ཚོགས་པ་ཕུན་ཚུགས་ཤིང་ནི་གཞི་ཚུགས་པ།",
    "མི་ཕམ་ནི་བྱམས་པའི་མཚན་ཚིག་ཕྲད་ནི་ཡི་གེའི་ཕྲད་རྣམ་དབྱེ་ནི་ལས་དང་ཁྱ་བ་སོ་སོར་རྣམ་པར་དཅེ་བ་ཕྱེད་ནི་ཕྱེད་ཀཕྲུ་མ་ནི་དམག་སྒར་ཕྱར་གཡེང་ཞི་རྣམ་གཡེང་ལ་སོགས་པ་པ་རྐྱང་ངོ།",
    "ད་བྱིད་ནི་གངས་སྦལ་རོ་༣། ། དྲེ་ནི་བྲོབ་ཞིམ་པ་བྲ་བའི་ནི་གྱི་བ་ཕྱེ་བྲག་ཕ་བྲུན་ནི་མི་གཙང་བ།",
    "ཁས་བླངས་ནི་ཁས་ལེན་པ་བླ་ཐབས་ནི་བདེ་བླག་ས་བླས་ཁྱེར་ཞི་ས་སྟེང་ནས་བྱས་ཁྱེར་བ།",
    "རྒྱལ་བློན་ནི་རྒྱལ་པོ་དང་བློན་པོ་བློ་མིག་ནི་རིག་པའམ་རྣམ་དཔྱོད་བདེ་བླག་བྱེད་ནི་བཀའ་ཚོགས་མེད་པར་བྱེད་པ།",
    "ལྟེ་གེས་བྲང་ང་ནི་ལྟོ་གོས་ངན་ངོན་བྱ་དགར་བྱིན་ནི་གནང་སྦྱིན་སྩོམཔ།",
    "དབྲེ་བཙོག་ནི་མི་གཙང་བ་ཁ་དབྲི་ནི་ཁ་ཐི་ཕའམ་ཉམས་པ་ཞེ་སའི་དབའ་ནི་ལགས་ཟེརཞུ་བ།",
    "རྦོད་མ་སྐྱེལ་ནི་ཚབ་སྩལ་བ་ལ་སོགས་པརར་བཏགས་པའི་བའོ། ལྦུ་བ་ནི་ཆུའི་དབུ་བ་ལྦ་བ་ནི་མགྲིན་པའི་ལྦ་བ་ལ་སོགས་པ་ལར་བཏགས་པའི་བའོ། ནོར་སྦྱིན་ནི་ཛམ་ལྷ་གནོད་སྦྱིན་ནི་བདོན་སྦྱིན་བདག་ནི་ཡོན་བདག་སྒྲོན་ནི་ཞུ་བ་དང་ཆབ་སྒྲོན་པ།",
    "གཙང་དམེ་ནི་གཙང་བཙོག་འཛུམ་དམུལ་ནི་དགའཔའི་འཛུམ་མདངས་དམིགས་པ་གཏོད་ནི་དམིགས་གཏོད་པ།",
    "ནེ་ཙོ་ནི་བྱ་དེ་ཙམ་ནི་ཚད་དེ་ཙུག་ལགས་ནི་དེཀ་ལགས།",
    "སྟོབས་རྩ་ལ་ནི་ལུས་རྩལ་འབད་རྩོལ་ནི་རྩོམ་སྒྲུབ་རྩོམ་པ་རྩོམ་ནི་བསྟན་བཅོས་སོགས་རྩོམ་པར་བྱེད་པ།",
    "སྨེ་དང་འཚམ་པར་ནི་མཐུན་པར་སྐྱིན་པ་འཚབ་ནི་འཇལ་བ།",
    "བཞེངས་ནི་ལངས་པ་བཞུགས་ནི་སྡོད་པ་འབྱོན་བཞུད་ནི་གཤེགས་པ་བཞོན་པ་ནི་རྟ་ཞོན་ནི་རྟར་ཆིབས་པ།",
    "གཟེགས་མ་ནི་ཉག་ལ་གཟེགས་ཟན་ནི་མུ་སྟེགས་པའི་མིང་གཟིར་བར་ནི་སྐྲག་ཏུ་བཅུག་པ་གཟས་ནི་བརྡེག་པར་བརྩམ་པ།",
    "གཤིན་པོའི་ནི་ཚེ་འདས་གཤགས་འབྱེད་ནི་ཁ་ཐཕག་ཤིན་རྗེ་ནི་གཤིན་པོའི་རྗེ་བོའམ་དཔོན་པོ་གཤེད་ནི་དཐ།",
    "གཤོར་གྱིས་ནི་མ་ཐུབ་པ་ཆུ་གཤོ་ནི་ཕྱིར་གཤོར་བ་ཤིང་གཤོག་ནི་ནིག་གཞོག་པ་བ་གཤགས་ནི་བཀས་ཟིན་པ།",
    "སྡིག་བཤགས་ནི་ཉེས་པ་འཆགས་པ་ཕྱི་བཤོལ་ནི་ཡུན་འགྱངས་པ་བཤུམ་ལམ་ནི་ལམ་ཁ་བཤར་ནི་འགྲོ་བ།",
    "འདོད་པའི་བསོད་ཉམས་ནི་འདོད་པ་ལ་ལྷག་པར་སྤྱོད་པའི་མིང་ལ་སོགས་པ་བས་འཕུལ་ཆི་སའོ། ཧྲལ་ཧྲལ་ནི་སྤྱོད་པ་རྩི་ངས་ཕ་ཧྥུལ་ཧྲུལ་ནི་གོས་ངནཔ་མིག་ཧྲིག་ཧྲིག་ནི་བལྟ་ཚུམ།",
    "མཁྱེན་ཅིང་འཕྲལཅེས་བརྒྱན་ཅེ་འོ།",
    "རྟོག་སྟེ་གཙང་སྟེ་ལྷུན་གྲུབ་སྟེ།",
    "ཁྱད་པར་ནི།",
    "གཤགས་འབྱེད་དང་གཅེན་གཅུང་སྒྲ་གཅན་གཟེགས་གཟན་ལ་གས་པ་རྣམས་ལ་གས་འཕུལམེད་ན་ནོར་བ་དང་།",
    "ཐ་སྙད་ཀྱི་མིང་ཚིག་མཐའ་དག་ཡི་གེར་བརྗོད་ཀྱིས་མི་ལང་བས་ཚུམ་ལྡན་གྱི་སློབ་དཔོན་མཉེས་པའི་ངག་ལས་རྟོགས་པར་བྱའོ།",
    "ཅིའི་ཕྱིར་ཞེ་དཐ་སྙད་ཡི་གེའི་སྦྱོར་བ་ལ་འཁྲུལ་པར་གྱུར་ན།",
    "སྒྲིབ་པའི་དྲི་མ་ཡེན་ས་དབྱིངས་སུ་དག་མཁྱེན་པའིདཀྱིལའཁོར་ཤེས་བྱ་ཀུན་ཁྱབ་ཅན།",
    "འགྲེལ་པས་དོན་བཟང་བཙོམ་འབྱིན་ལགས་ཀྱང་།",
    "མཛད་ནས་དབྱངས་བཞི་ངེས་པར་བསྟན།",
    "རྒྱ་ཆེར་མཚོན་ཏེ་ཤེས་པར་བྱ།",
    "ཀུན་ལ་རྩོད་པ་མེད་པར་འཇུག།",
    "སྦྱོར་ཚུལ་རིམ་བཞིན་ཤེས་པར་བྱ།",
    "དངོས་སུ་བྱས་པར་སྟོན་པའི་སྒྲ།",
    "ཕན་འདོགས་བྱས་པར་གོ་ནུས་པ།",
    "དམན་པར་བརྩེ་སོགས་ལྟ་བུ་ཡི།",
    "མཉམ་པར་བཞག་ལ་སྒོམ་ལྟ་བུ།",
    "བྱེད་པོས་བྱ་བ་བྱས་པ་རུ།",
    "སམཐའ་སྦྱོར་ཚུལ་ཤེས་པར་གཅེས། ། མཐུན་དང་མི་མཐུན་རྒྱན་གཉིས་དང་།",
    "འདིས་མཚོན་མཐའ་ཡས་རྟོགསཔར་གྱིས། ། བསྟན་བྱ་ལྷག་མ་འདྲེན་པའི་དོན།",
    "ལྟ་བུ་མཐའ་ཡས་འདྲེན་པར་བྱ། ། ཚིག་དོན་སོ་སོར་འབྱེད་པ་དང་།",
    "འདུས་མ་བྱས་སོ་ལྟ་བུ་དང་།",
    "འདུས་པར་བྱས་སམ་འདུས་མ་བྱས།",
    "ལྟ་བུ་རྒྱ་ཆེར་སྡུད་པར་བྱ། ། ངོ་བོས་སྟོང་ངམ་བདེན་པས་སྟོང་།",
    "དེ་ཡིས་འཇུག་པར་གཞུང་ལས་བསྟན།",
    "ནས་ཀྱི་སྒྲ་ཉིད་འཇུག་སྟེད་པར།",
    "དབུས་འགྱུར་ཚལ་ནས་ལྷ་སའི་བར།",
    "ཀུན་ཉོན་གཟུགས་ནས་རྣམ་མཁྱེན་བར།",
    "ཞིག་ལ་བསམ་པས་འདས་པར་གྱུར།",
    "སྒེ་ནས་དུས་གསུམ་མཉམ་པར་འཇུག།",
    "བདག་སྒྲ་སོ་སོར་ངེས་པར་བྱ། ། མ་མི་གཉིས་ནི་དགག་སྒྲ་སྟེ།",
    "སྦྱར་བ་འདི་ཡི་ཁྱད་པར་རོ། ། གཞན་ཡང་ཞར་ལས་རྟོགས་དགོས་པའི།",
    "ཡོན་ཏན་དོན་གཉེར་མེད་ལགས་ཀྱང་།",
    "མཆྀན་མེད་ཡི་གེའི་རྣམ་པར་བཞག།",
    "ཅ་ཞ་ཤགསུམ་རྐྱང་འཕུལ་འཇུག།",
    "མི་འཇུག་པ་ཡང་ཤེས་པར་བྱ། ། ད་ནི་བདག་གཞན་དུས་གསུམ་གྱི།",
    "མཉམ་པར་འཇུག་པའི་དོན་ཅན་ནོ།",
    "ཞར་ལས་རྟོགས་པར་བྱ་དགོས་ཏེ། ། དུས་འདས་གཞན་དངོས་བྱེད་པོ་དང་།",
    "བཞེས་དང་བཞོ་བྱ་འཇོ་བྱེད་ཞོས།"
  ]
}