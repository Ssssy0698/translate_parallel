    "མཚན་ཉིད་རྣམ་པར་གཞག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "བདེན་པ་རྣམས་མི་ཤེས་པ་ནི་དོན་ད་མ་པར་མ་རིག་པའོ།",
    "མ་རིག་པས་བྱས་པའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་འདུ་བྱེད་ནམས་སོ།",
    "འདུ་བྱེད་ལ་༢བརྟེན་པའི་སེམས་དང་པོ་ནི་རྣམ་པར་ཤེས་པའོ།",
    "རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་སྐྱེས་པ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་བཞི་ནི་མིང་ད་ང་གཟུགས་ས་སོ།",
    "མིང་དང་གཟུགས་རྣམ་པར་འཕེལ་བ་ནི་སྐྱེ་མཆེད་དྲུག་གོ།",
    "སྲེད་པ་རྣམ་པར་འཕེལ་བ་ནི་ལེན་པའོ།",
    "འཆི་ཞིང་འབྲལ་བའི་ཆེ་མྱོས་ཤིང་ཆགས་པར་གྱུར་ནས་སེམས་ཡོངས་སུ་གདུང་བ་ནི་མྱ་ངན་ནོ་༥།",
    "མ་རིག་པས་བྱས་པའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་འདུ་བྱེད་རྣམས་སོ་ཞེས་བྱ་བ་ནི་མིང་ད་ང་གཟུགས་སུ་སྟོན་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་ལ་རྣམ་པར་ཤེས་པ་བརྟེན་༢པ་དང་།",
    "མིང་དང་གཟུགས་དང་རྣམ་པར་ཤེས་པ་ལྷན་ཅིག་བྱུང་བར་ཡོངས་སུ་བསྟན་པས་རྣམ་པར་ཤེས་པ་དང་།",
    "དོན་ད་མ་པའི་བདེན་པ་རྣམ་པར་གཞག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "འདི་ལྟར་ཁམས་གསུམ་པ་འདི་ནི་སེམས་ཙམ་སྟེ་ཞེས་གསུངས་པ་སྟེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་རྣམ་པར་གཞག་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དེ་ཡང་རྣམ་པ་དྲུག་ཏུ་ཡོངས་སུ་བརྟག་༢པར་རིག་པར་བྱ་སྟེ།",
    "ཉེས་དམིགས་བསྡུས་པར་ཡོང་ས་སུ་བརྟག་པ་དང་། ༐",
    "གཞི་གང་ལ་འདོད་ཆགས་དང་ལྡན་པའི་སེམས་སྐྱེས་པ་དེ་ནི་རྣམ་པར་ཤེས་པའོ།",
    "མིང་དང་གཟུགས་རྣམ་པར་འཕེལ་བ་ནི་སྐྱེ་མཆེད་དྲུག་གོ།",
    "འདི་ནི་བདེན་པ་གཉིས་རྣམ་པར་གཞག་པས།",
    "རྣམ་པར་ཤེས་པ་ཡང་བྱ་བ་གཉིས་སུ་ཉེ་བར་གནས་པ་ཡིན་ཏེ།",
    "ཕན་ཚུན་རྟོག་པར་ཡང་བྱེད་པ་ད་ང་།",
    "གཉིས་ཀ་ལས་ནམ་པར་གྲོལ་བ་མྱོང་བར་བྱེད་པ་དང་།",
    "ཆགས་པར་འགྱུར་བའི་དངོས་པོ་ལ་ཀུན་དུ་ཆགས་པར་ཡང་བྱེད་པ་ད་ང་།",
    "སྲིད་པའི་རྒྱུ་གཞན་ཡང་གནས་པར་བྱེད་པ་དང་།",
    "འདུ་བྱེད་འཇིག་པར་ཡང་བྱེད་པ་ད་ང་ཡོངས་སུ་མི་ཤེས་པས་རྒྱུན་མི་འཆད་པའི་རྒྱུ་ཡང་འབྱིན་པའོ་ཞེས་གསུངས་པ་སྟེ།",
    "དེ་ལ་ས་བོན་གྱི་གནས་སྐབས་ཀྱིས་ནི་འདུ་བྱེད་རྒྱུན་མི་འཆད་པར་བྱེད་དེ།",
    "དེ་མ་སྤངས་པར་མི་སྤོངས་པའི་ཕྱིར་ར་རོ།",
    "འབྲས་བུའི་གནས་སྐབས་ཀྱི་ས་ནི་སྟོན་༢པར་བྱེད་དེ།",
    "མ་རིག་པ་མེད་པར་འདུ་བྱེད་རྣམས་རྟག་ཏུ་ཡོད་པར་མི་འགྱུར་ར་རོ།",
    "ལྷག་མ་རྣམས་ནི་སྡུག་བསྔལ་གྱི་ལམ་གྱི་རྒྱུན་མི་འཆད་པར་རབ་ཏུ་རྣམ་པར་ཕྱེ་བའོ།",
    "འབྲས་བུ་མ་བསྐྱེད་པར་འགགས་༢ིཔས་ལས་རྣམས་ཆུད་ཟ་བའི་ཉེས་པའོ།",
    "ཉེས་པ་རྣམ་པ་དེ་གསུམ་ཡང་སྔོན་གྱི་མཐའ་ལ་སོགས་པའི་རྒྱུའི་ཁྱད་པར་ལ་ལྟོས་པས་སྐྱེས་༤ནས་མྱོང་བར་འགྱུར་བ་ལ་སོགས་པ་ཐ་དད་པའི་ཕྱིར་ཡོང་ས་སུ་སྤོང་སྟེ།",
    "རྣམ་པར་ཤེས་པ་ནས་ཚོར་བ་ཞེས་བྱ་བའི་བར་དེ་ནི་ད་ལྟར་བྱུང་བའི་ལྟོས་པའོ།",
    "མ་རིག་པ་འགགས་པས་འདུ་བྱེད་རྣམས་འགག་ཅེས་བྱ་བ་དེ་ནི་ལྟོས་པ་རྒྱུན་ཆ་ད་པ་སྟེ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་མ་རིག་པའི་རྐེན་གྱིས་འདུ་བྱེད་རྣམས་ཞེས་བྱ་བ་དེ་ནི་སྔོན་གྱི་མཐའ་པའི་ལྟོས་པ་ཞེས་བྱ་བ་ནི་ཚེ་འདིའི་ཕྱིར་སྔར་བྱས་པའི་ཕྱིར་རོ།",
    "ལྟོས་པའི་དོན་རྒྱུའི་དོན་དུ་རིག་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་ནས་ཚོར་བ་ཞེས་བྱ་བའི་བར་དེ་ནི་ད་ལྟར་བྱུང་བའི་ལྟོས་པའོ་ཞེས་བྱ་བ་ནི་དོན་གང་ལ་ཚེ་རབས་སྔ་མའི་ལས་གང་ཡིན་པ་དེའི་འབྲས་བུ་རྣམ་པར་ཤིས་པ་༐",
    "རྒྱུ་གསུམ་གྱིས་ཡང་སྲིད་པའི་ལས་རྣམ་པར་སྨིན་པ་མི་སྐྱེད་༢པར་སྟོན་ཏེ།",
    "དེ་ལ་མ་རིག་པའི་རྐྱེན་གྱིས་འདུ་བྱེད་རྣམས་ཞེས་བྱ་བས་ནི་བྱས་པ་ཉིད་དང་འབྲས་བུ་མ་རྙེད་པ་ཉིད་དུ་སྟོན་ཏོ།",
    "རྣམ་པར་ཤེས་པ་ལ་སོགས་པས་ནི་བྱས་པ་ཉིད་དང་འབྲས་བུ་བསྐྱེད་ཟིན་པ་ཉིད་སྟོན་ཏོ།",
    "སྲིད་པ་ལ་སོགས་པས་མ་སྤངས་པར་སྟོན་ཏོ།",
    "གཞན་གྱི་སེམས་ཀྱི་རྒྱུད་ལ་དེ་མ་བྱས་པའི་ཕྱིར་ར་རོ།",
    "དེ་ལྟར་ཉེས་པ་རྣམ་པ་གསུམ་པོ་ཡོངས་སུ་སྤངས་པར་གྱུར་པ་ཡིན་ན་ནོ།",
    "མ་རིག་པ་འགགས་པས་འདུ་བྱེད་འགག་ཅེས་བྱ་བ་དེ་ནི་སྡུག་བསྔལ་བ་གསུམ་གྱི་རྒྱུན་འཆད་པའོ་ཞེས་གསུངས་པའོ།",
    "ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པའོ།",
    "མ་རིག་པ་འགགས་པས་འདུ་བྱེད་འགག་༡ཅེས་བྱ་བ་དེ་ནི་ཟད་པའི་རྗེས་སུ་མཐུན་པར་ཡོངས་སུ་བརྟག་པ་སྟེ།",
    "ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པའོ།",
    "གཞན་དུ་ན་སྲིད་པའི་རྗེས་སུ་༢མཐུན་པར་མི་འགྱུར་ར་རོ།",
    "བདེན་པ་རྣམ་པར་གཞག་པས་ཡོངས་སུ་བརྟག་པས་བསྟན་ཏེ།",
    "སྐྱེ་བ་དང་འཇིག་པ་ད་ང་འབྲེལ་པ་ད་ང་མེད་པས་ཟད་པར་སོ་སོར་རྟོག་པ་ཞེས་གསུང་ས་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་ཡོང་ས་སུ་རྟོག་པས་འདི་སོ་སོར་རྟོག་པར་རིག་པར་བྱའོ།",
    "སེམས་གཅིག་ལ་གནས་པ་དག་གོ་ཞེས་གསུངས་པ་ལ་སོགས་པའོ།",
    "ལམ་གྱི་༤རྒྱུན་མི་འཆད་ཅེས་གསུངས་པ་ལ་སོགས་པའོ་། སྔོན་གྱི་མཐའི་བར་དང་།",
    "འདུས་མ་བྱས་པའི་མཚན་ཉིད་དང་།",
    "སྐྱེ་མཆེད་དྲུག་ཅེས་བྱ་བའི་བར་དེ་ནི་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཉིད་དོ་ཞེས་གསུངས་པའི་ཕྱིར་ར་རོ།",
    "ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་ར་རོ།",
    "ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་ར་རོ།",
    "ལྷག་མ་༢རྣམས་ཀྱང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་ར་རོ།",
    "འཇིག་པ་ལ་རྣམ་པར་ལྟ་བའི་ཚེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "རྟོན་༤པའོ་ཞེས་གསུངས་པ་ལ་སོགས་པའོ།",
    "ལྷག་མ་རྣམས་ནི་སྡུག་བསྔལ་གྱི་ལམ་གྱི་རྒྱུན་མི་འཆད་ཅེས་གསུངས་པ་ལ་སོགས་པའོ།",
    "ཕྱི་མའི་མཐའ་ཡོངས་སུ་སྨིན་པར་བྱ་བའི་ཁྱད་པར་གྱི་༦ཕྱིར་ནུས་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་ནས་ཚོར་བ་ཞེས་བྱ་བའི་བར་དེ་ནི་དེ་ལྟར་བྱུང་བའི་ལྟོས་པའོ།",
    "སྲེད་པ་ནས་སྲིད་པ་ཞེས་བྱ་བའི་བར་དེ་ནི་ཕྱི་མའི་མཐའི་ལྟོས་པ་སྟེ་ཞེས་གསུངས་པ་ལ་སོགས་པའོ།",
    "ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པ་ལ་སོགས་པའོ།",
    "དེ་ལྟར་མི་གནས་པའི་ལམ་སྒྲུབ་པའི་ཁྱད་པར་བསྟན་ན་ནས།",
    "གཉེན་པོའི་ཁྱད་པར་ཐོབ་པ་དང་།",
    "མི་མཐུན་པའི་ཕྱོགས་ཉམས་པའི་ཁྱད་པར་དང་།",
    "ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་ཐོབ་པ་དང་།",
    "བསམ་པའི་ཁྱད་པར་ཐོབ་པ་དང་།",
    "ནུས་པའི་ཁྱད་པར་ཐོབ་པ་དང་།",
    "རྣམ་པ་ལྔས་དེའི་འབྲས་བུའི་ཁྱད་པར་ཡོངས་སུ་སྟོན་ཏེ།",
    "དེ་གཉི་གའི་བྱ་བ་མེད་པས་བྱེད་པ་པོ་མེད་པར་མཐོང་བ་དང་།",
    "ཚོར་བ་པོ་མེད་པར་སོ་སོར་རྟོག་པའི་ཚེ།",
    "དེ་ལ་གང་ཟག་ལ་བད་ག་མེད་པར་མཐོང་བ་ནི་བདག་མེད་པ་དང་།",
    "སྲོག་མེད་པ་དང་གང་ཟག་མེད་པ་ཞེས་གསུངས་པའི་ཕྱིར་ར་རོ།",
    "བྱ་བ་མེད་པས་བྱེད་པ་པོ་མེད་པར་མཐོང་བ་ནི་བྱེད་པ་པོ་ད་ང་།",
    "ཚོར་བ་པོ་མེད་པ་ཞེས་གསུངས་པའི་ཕྱིར་ར་རོ།",
    "སྐྱེ་བ་༤ཡིན་ནོ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་མི་མཐུན་པའི་ཕྱོགས་ཡིད་ཙམ་ཉམས་པ་ནི་སྲིད་པའི་ཡན་ལག་རྣམས་ཀྱི་རང་བཞིན་འགག་༡ཅེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དང་རྣམ་པ་གསུམ་གྱིས་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་མི་མཐུན་པའི་ཕྱོགས་ཉམས་པའི་ཁྱད་པར་ནི་འདུ་ཤེས་རྣམ་པ་གསུམ་དང་བྲལ་བ་སྟེ།",
    "ཡོད་པ་དང་མེད་པའི་འདུ་ཤེདང་བྲལ་བས་ཞེས་གསུངས་པ་སྟེ།",
    "ས་བཞི་པ་ལས་༦ལྷག་པར་གཡོ་བ་ལ་སོགས་པ་དང་བྲལ་བ་ད་ང་།",
    "དེ་ལ་སྒྲུབ་པའི་ཁྱད་པར་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་བས་ཀྱང་ཤས་ཆེར་ཤིན་ཏུ་བརྩོན་པར་བྱེད་དོ།",
    "ཀུན་དུ་སྦྱོར་བ་ལས་ནི་འདུས་བྱས་འབྱུང་ང་ངོ།",
    "བྲལ་བ་ལས་ནི་འདུས་བྱས་མི་འབྱུང་ངོ།",
    "ཚོགས་པ་ལས་ནི་འདུས་བྱས་འབྱུང་ངོ།",
    "སྐྱེས་བུའི་བྱེད་པའི་སྒྲུབ་པ་ནི་རྣམ་པར་༨སུན་འབྱིན་པའི་གཉེན་པོས་ཉེས་པ་མང་པོའི་སྐྱོན་ཆགས་པར་སོ་སོར་རྟོག་པ་ད་ང་།",
    "སྤོང་བའི་གཉེན་པོས་རང་དང་སྤྱིའི་མཚན་ཉིད་རང་བཞིན་གྱིས་མེད་པ་སོ་སོར་རྟོག་པར་རིག་པར་བྱ་སྟེ།",
    "མ་སྐྱེས་མ་འགགས་པར་སོ་སོར་རྟོག་པ་ན་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་གནས་པའི་ཁྱད་པར་ནི་ཡེ་ཤེས་དང་།",
    "འདུས་བྱས་དང་མྱ་ང་ན་ལས་འདས་པ་གཉིས་མཉམ་པ་ཉིད་དུ་རྟོགས་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་ཡང་མི་གནས་ཏེ་ཞེས་གསུངས་པའོ་། དེ་ལ་ཆགས་པ་མེད་པའི་ཡེ་ཤེས་ནི་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་སུ་རིག་པར་བྱའོ།",
    "དེ་ལ་ཏིང་ངེ་འཛིན་གྱི་༦ཁྱད་པར་ནི་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་དེའི་འཁོར་དང་བཅས་པ་རྣམ་པ་བཅུ་སྟེ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ད་ང་མཚུངས་པར་ལྡན་པ་སྟོང་པ་ཉིད་ད་དང་།",
    "ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་མི་རྟོག་པ་སྟོང་པ་ཉིད་ད་དང་།",
    "སྨོན་པ་མེད་པའི་ཏིང་ངེ་འཛིན་ས་ཡ་དག་མངོན་༡དུ་འགྱུར་རོ་ཞེས་གསུངས་པའོ།",
    "སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་དེ་ཡང་རྒྱུ་བཞིས་རྣམ་པར་གཞག་པར་རིག་པར་བྱ་སྟེ།",
    "དེའི་གནས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་དམིགས་པས་ཆེན་པོ་སྟོང་པ་ཉིད་ད་དོ།",
    "འཇུག་པའི་ནམ་པར་ཤེས་པ་ལ་དམིགས་པས་མཚུངས་པར་ལྡན་པ་སྟོང་པ་ཉིད་དོ།",
    "བག་ཡོད་པ་ཡོངས་སུ་འཛིན་པས་བཞི་པ་རྣམ་པར་གཞག་སྟེ།",
    "ཁྱད་པར་ཞུགས་པ་ཐོབ་པས་ནི་བདུན་པ་སྟེ།",
    "རྒྱུ་ཉིད་ཀྱིས་ནི་ལྷག་མ་རྣམས་ཏེ་ཤེས་བྱའི་སྒྲིབ་པ་རྣམ་པར་ད་ག་པའི་རྒྱུར་གྱུར་པས་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་དག་པའི་མི་རྟོག་པ་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་བསམ་པའི་ཁྱད་པར་ནི་བརྟན་པའི་ཕྱིར་མི་ཕྱེད་པའི་བསམ་པ་སྟེ།",
    "མི་ཕྱེད་པའི་བསམ་པ་ཉིད་དེ་ཡང་དོན་རྣམ་པ་ད་གུར་རིག་པར་བྱ་སྟེ།",
    "ཐོས་ནས་ཀྱང་ཇི་ལྟ་བ་བཞིན་དུ་སྙོམས་པར་འཇུག་པ་དང་།",
    "ཤེས་རབ་དང་ཡེ་ཤེས་ཀྱི་སྣང་བས་རབ་ཏུ་སྤྱོར་རོ་ཞེས་བྱ་བ་ནི་དོན་གྱི་གཟུངས་ཐོབ་པར་ཡོངས་སུ་སྟོན་ཏེ།",
    "གཟུང་ས་དེ་ནི་ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་ལ་བརྟེན་པའི་ལྷག་མཐོང་དང་།",
    "ཐབས་དང་ཤེས་རབ་ཀྱིས་རྣམ་པར་དཔྱད་པ་ཞེས་བྱ་བ་ནི་མི་གནས་པའི་ལམ་གྱིས་༤བསྡུས་པའི་ཤེས་རབ་ཀྱིས་ས་སོ།",
    "ལྷག་མ་རྣམས་ནི་སྔ་མའི་ཚུལ་གྱིས་ཅི་རིགས་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཡེང་བའི་གཉེན་པོ་རྣམ་པར་གཞག་པ་དང་།",
    "ཟུང་དུ་འབྲེལ་པའི་ལམ་འཐོབ་པ་རྣམ་པར་གཞག་པ་དང་།",
    "ས་སྔ་ཕྱི་ལས་ཁྱད་པར་རྣམ་པར་གཞག་པ་ད་ང་།",
    "དེའི་འབྲས་བུ་རྣམ་པར་གཞག་པ་ད་ང་།",
    "ཡོན་ཏན་རྣམ་པ་བཞིས་ཁྱད་པར་དུ་འཕགས་པ་སྟེ།",
    "དེའི་ཁྱད་པར་འཐོབ་པའི་རྒྱུ་འཕེལ་བའི་ཕྱིར།",
    "གཟུགས་བརྙ་ན་དང་སྤྲུལ་པའི་རང་བཞིན་ལྟ་བུར་གཉིས་སུ་མེད་པར་ཡང་ཁོང་དུ་ཆུད་ལ།",
    "བསྐལ་པ་འགྲངས་པའི་མཚན་ཉིད་ཐ་ད་ད་པ་ཤེས་པ་ལ་ཡང་འཇུག་པ་ཡིན་ཏེ་ཞེས་གསུངས་པའོ་། དེ་ད་ག་ནི་ལམ་གཞན་རྩོམ་པའི་ཁྱད་པར་བཅུ་པོ་གཉེན་པོ་ཡོངས་སུ་འཛིན་པ་དང་བཅས་པ་ཡིན་ན་ནོ།",
    "དེའི་འོག་ཏུ་དེའི་རྣམ་པར་ག།",
    "ཡེང་བའི་གཉེན་པོ་རྣམ་པ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ད་ག་ཐ་དད་པས་རྣམ་པ་བཅུར་རིག་པར་བྱའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པར་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་ི་ངོ་བོ་ཉིད་དང་བྱེ་བྲག་ལ་རྣམ་པར་རྟོག་པ་མེད་པས་ལྷུན་གྱིས་གྲུབ་པ་ཉིད་དེ་རྟོག་པ་མེད་པ་ད་ང་།",
    "རྣམ་པར་རྟོག་པ་མེད་པ་ཞེས་བྱ་བའི་ཚིག་འོག་མ་གཉིས་ཀྱིས་སྟོན་ཏོ།",
    "དེ་ལྟར་ལེགས་པར་སོ་སོར་བརྟག་༡པའི་ཡེ་ཤེས་དང་།",
    "ཡེང་བའི་གཉེན་པོ་རྣམ་པར་གཞག་པས་ས་འདི་བསྟན་ནས་ཟུང་དུ་འབྲེལ་པའི་ལམ་འཐོབ་པ་རྣམ་པར་གཞག་པ་རྣམ་པ་བཞིས་སྟོན་ཏེ།",
    "འདུ་ཤེས་ཡིད་ལ་བྱ་བ་རྣམ་པ་དེ་ལྟ་བུ་དག་ད་ང་མི་འབྲལ་བ་ཡིན་ནོ་ཞེས་གསུངས་པའོ།",
    "མངོན་དུ་འདུན་པར་བྱེད་པའི་ཕྱིར་ཡིད་ལ་བྱེད་པར་རིག་པར་བྱའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེམངོན་སུམ་དུ་བྱ་བའི་ལམ་ལས་མི་འཕྱར་བ་གང་ཡིན་པ་དེ་ནི་དེའི་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "བསྡུ་བའི་དངོས་པོ་བཞི་ཡང་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ་ཞེས་གསུངས་པའོ།",
    "ཤེས་བྱའི་སྒྲིབ་པ་རྣམ་པར་དག་པར་༐",
    "ས་སྔ་ཕྱི་ལས་ཁྱད་པར་རྣམ་པར་གཞག་པ་ནི་ས་འོག་མ་དང་།",
    "དམའ་བ་གཉིས་ཀྱིས་ས་བདུན་པའི་ཁྱད་པར་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "འོན་ཏེ་ས་བྱ་ཅ་བཅུ་པོ་ཐམས་ཅད་ལ་ཡང་དེ་བཞིན་དུ་ཡོངས་སུ་རྫོགས་པར་འགྱུར།",
    "ཡེ་ཤེས་ནི་ཇི་སྐད་དུ་བསྟན་པར་རིག་པར་བྱའོ།",
    "ལྔ་པ་ལ་ནི་འཇིག་རྟེན་གྱི་བྱ་བ་དང་མཐུན་པར་འཇུག་པས་ས་སོ།",
    "དེ་ལྟར་ས་འོག་མ་ལས་ཁྱད་ཞུགས་པས་སྔ་ཕྱི་ལས་ཁྱད་པར་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་བྱང་བ་ཞེས་བྱ་སྟེ།",
    "ས་འདི་ནི་རྣམ་པར་སྨིན་པ་ལ་མི་གནས་པའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ས་སྔ་ཕྱི་ལས་ཁྱད་པར་རྣམ་པར་གཞག་པ་བསྟན་ནས།",
    "ལས་རྣམ་པར་དག་པ་དང་།",
    "ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་འཐོབ་པ་དང་།",
    "གནས་པའི་ཁྱད་པར་འཐོབ་པ་དང་།",
    "རྣམ་པ་བཞིས་ས་འདིའི་ཟུང་དུ་འབྲེལ་པའི་ལམ་གྱི་འབྲས་བུ་ནམ་པར་གཞག་པ་ཡོངས་སུ་སྟོན་ཏོ།",
    "དེ་ལ་ལས་རྣམ་པར་དག་པ་ནི་རྣམ་པ་བཞིས་ཡོང་ས་སུ་སྟོན་ཏེ།",
    "དེ་མི་ད་གེ་བའི་ལས་ཀྱི་ལམ་གང་དག་དེ་བཞིན་གཤེགས་པས་སྨད་པ་དེ་དག་ལས་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ཡང་དག་པར་འདས་པ་ཡིན།",
    "བསམ་གཏན་ལ་སོགས་པ་མངོན་སུམ་དུ་བྱེད་པའི་ཁྱད་པར་གྱིས་ནུས་པའི་ཁྱད་པར་འཐོབ་པ་ནི།",
    "སྙོམས་པར་འཇུག་པ་རྣམས་ད་ང་།",
    "ཞི་བའི་བདེ་བ་ལ་གནས་པར་བྱ་བའི་ཕྱིར།",
    "སྙོམས་པར་འཇུག་པ་དང་གོ་རིམས་བཞིན་ན་ནོ།",
    "དེ་ལྟར་ཟུང་དུ་འབྲེལ་པའི་ལམ་གྱི་འབྲས་བུ་རྣམ་པ་བཞི་ལས་ཡང་དག་པར་འདས་པ་ཡོངས་སུ་བསྟན་ནས་ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་འཐོབ་པ་ཏིང་ངེ་འཛིན་རྣམ་པ་བཅུས་ཡོངས་སུ་སྟོན་ཏེ།",
    "དེ་ཡང་ནམ་པར་མི་རྟོག་པ་དང་།",
    "དོན་ཤིན་ཏུ་བསམ་༡པ་ཞེས་བྱ་བ་ཞེས་གསུངས་པའོ།",
    "དོན་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བ་ཞེས་གསུངས་པའོ།",
    "རྩ་བ་ཤིན་ཏུ་གནས་པས་བརྟན་པ་ཞེས་བྱ་བ་ཞེས་གསུངས་པའོ།",
    "ཤེས་རབ་དང་ཡེ་ཤེས་ཀྱིས་རྣམ་པར་དཔྱད་པའི་ས་ཡང་མངོན་དུ་གྱུར་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལ་ཉན་ཐོས་དང་།",
    "ཤེས་རབ་ད་ང་ཡེ་ཤེས་ཀྱིས་རྣམ་པར་དཔྱད་པའི་ས་ཞེས་བྱ་བ་ནི་བརྒྱད་པའོ།",
    "རྣམ་པར་ད་པྱད་པ་འབའ་ཞིག་ཏུ་ཟད་ད་དོ།",
    "ཡང་དག་པར་འདས་པ་དེ་ཡང་ལས་ཀྱི་ཁྱད་པར་གྱིས་རབ་ཏུ་སྟོན་ཏེ།",
    "དེ་ལ་མཉམ་པར་གཞག་པ་ཉིད་ཀྱི་༤མཚན་མ་དང་བྲལ་བའོ།",
    "རྒྱལ་པོའི་བུའི་དཔེས་ནི་ས་འདི་ཡང་ད་ག་པར་འདས་པའི་ཁྱད་པར་སྟོན་ཏེ།",
    "ནམ་དེ་ནར་སོན་པར་གྱུར་པ་དེའི་ཚེ།",
    "གོང་དུ་ཡོངས་སུ་ཚོལ་བའི་བརྩོན་པ་ཡང་མི་གཏོང་ངོ་ཞེས་གསུངས་པའོ།",
    "དེ་ཙམ་ལ་གནས་པར་ཡང་ཟད་ད་དོ།",
    "དེ་ལྟར་ས་ལས་ཡང་དག་པར་འདས་པས་ཟུང་དུ་འབྲེལ་པའི་ལམ་གྱི་འབྲས་བུ་བསྟན་ན་ནས།",
    "འགོག་པ་མངོན་སུམ་དུ་བྱས་ཞེས་ནི་མི་བྱའོ།",
    "ཡང་ད་ག་པའི་མཐའ་ལ་གནས་པས་ཀྱང་གནས་ལ་འགོག་པ་ཡང་མངོན་སུམ་དུ་མི་བྱེད་དོ་ཞེས་གསུངས་པའོ།",
    "དེ་ལྟར་སྙོམས་པར་འཇུག་པ་ཐོབ་པའི་གནས་པའི་ཁྱད་པར་བསྟན་ན་ནས།",
    "སྦྱོར་བ་གཉེན་པོ་ཡོངས་སུ་འཛིན་པ་དང་བཅས་པ་རྣམ་པར་༢བརྒྱད་ཀྱིས་རྒྱུ་བ་ཐོབ་པའི་གནས་པའི་ཁྱད་པར་སྟོན་ཏོ་༢།",
    "བསམ་པ་མྱ་ངན་ལས་འདས་པ་ལ་གནས་པ་ཡང་ཡིན་ཞེས་གསུངས་པའོ།",
    "རྟག་པར་རྒྱུན་དུ་ཤིན་ཏུ་དབེན་པའི་སེམས་ཐོབ་པ་ཡང་ཡིན་ཞེས་གསུངས་པའོ།",
    "འཇིག་རྟེན་གྱི་ཉེས་པས་ཀྱང་མི་གོས་པ་ཡིན་ཞེས་གསུངས་པའོ།",
    "དེ་ལྟར་འབར་ཡང་ཚིག་པར་མི་འགྱུར་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "བདུད་བཞིའི་ལམ་ལས་ཀྱང་ཡང་དག་པར་འདས་ལ།",
    "འཇིག་རྟེན་གྱི་བྱ་བ་ཐམས་ཅད་དང་ལྡན་པར་ཡང་སྣང་ལ།",
    "འཇིག་རྟེན་སྐྱོང་བ་ཐམས་ཅད་ལས་ལྷག་པའི་བཀོད་པ་རྣམ་པར་སྒྲུབ་པ་ཡང་ཐོབ་ལ།",
    "བསྟན་པ་འཛིན་པར་ཡང་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་སྤྱོར་བའི་སྤྱོད་པ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར།",
    "ཉི་མའི་འོད་ཀྱི་དཔེས་ནི་སྔ་མ་བཞིན་དུ་ཁྱད་པར་ཡོངས་སུ་སྟོན་ཏེ།",
    "འཛམ་བུའི་གླིང་ན་རླན་གྱི་བག་ཡོད་པ་ཐམས་ཅད་ཀྱང་ཤིན་ཏུ་སྐེམ་༢པར་བྱེད་ད་དོ།",
    "ས་བརྒྱད་པ་ནི་ཡོངས་སུ་སྦྱང་བ་བྱས་པའི་ས་བསྡུ་བ་དང་།",
    "རྣམ་པར་དག་པའི་བཟོད་པ་ཐོབ་པ་དང་།",
    "གནས་པའི་ཁྱད་པར་ཐོབ་པ་དང་།",
    "རྣམ་པ་བདུན་གྱིས་༥རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "སྦྱོར་བས་བསྡུས་པའི་ཚོགས་ཡོང་ས་སུ་རྫོགས་པར་བྱེད་པ་སྟེ།",
    "ཚོགས་ཤིན་ཏུ་བསགས་པ་ཞེས་གསུངས་པའོ།",
    "དེ་ལྟར་ས་བརྒྱད་པའི་ཡོངས་སུ་སྦྱང་བ་བྱས་པའི་ས་བསྡུས་པ་༢རྣམ་པར་གཞག་པ་བྱས་ནས།",
    "རྣམ་པར་དག་པའི་བཟོད་པ་ཐོབ་པ་རྣམ་པར་གཞག་པ་ཡོངས་སུ་སྟོན་ཏེ་༢།",
    "དེ་རྣམ་པར་དག་པ་ཉིད་ལྷུན་གྱིས་གྲུབ་པར་རིག་པར་བྱ་སྟེ།",
    "བཟོད་པ་དེ་ཡང་མི་སྐྱེ་བ་རྣམ་པ་བཞི་ལ་རིག་པར་བྱའོ།",
    "མཚན་ཉིད་ཡོད་པ་དེའི་གཉེན་པོར་མཚན་༢མེད་པ་ཉིད་ཅེས་གསུངས་ས་སོ།",
    "ཐ་མ་མཉམ་པ་ཉིད་ཅེས་གསུངས་པའོ།",
    "རྣམ་པར་སྨིན་པ་དང་།",
    "ཡུལ་རྣམ་པར་རིག་པས་བསྡུས་པའི་རྣམ་པར་རྟོག་པའི་རང་བཞིན་གྱི་འདུ་ཤེས་དང་བྲལ་བས་འཇུག་པ་སྟོན་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་རྣམ་པར་རྟོག་པའི་འདུ་ཤེས་ད་ང་བྲལ་ཞིང་ཞེས་གསུངས་པའོ།",
    "དེ་ནི་རྣམ་པ་གསུམ་གྱིས་༡ས་འོག་མ་ལས་ཁྱད་པར་དུ་འཕགས་པ་སྟེ།",
    "དེ་ལྟར་ས་བརྒྱད་པའི་རྣམ་པར་དག་པའི་བཟོད་པ་འཐོབ་པ་རྣམ་པར་གཞག་པ་བསྟན་ན་ནས།",
    "གནས་པའི་ཁྱད་པར་འཐོབ་པ་སྟོན་ཏོ།",
    "དེ་ནི་ཟབ་པ་ཉིད་རྣམ་པ་བདུན་དུ་རིག་པར་བྱ་སྟེ།",
    "མཚན་མ་ཐམས་ཅད་དང་བྲལ་བ་འདུ་ཤེས་ཀྱི་འཛིན་པ་ངན་པ་ཐམས་ཅད་ལས་ཕྱིར་ལོག་པ་ཞེས་གསུངས་པ་སྟེ།",
    "ཐམས་ཅད་ལས་དབེན་པ་མངོན་དུ་གྱུར་པ་རྗེས་སུ་ཐོབ་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་སྟེ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པའི་དཔེས་ནི་གནས་པ་དེའི་ཞི་བ་ཉིད་ཡོངས་སུ་སྟོན་ཏེ།",
    "སེམས་ཀྱི་རྩོལ་བ་དང་བྲལ་ནས་རྣམ་པར་སྨིན་པ་ལ་གནས་པ་ཡིན་ནོ་ཞེས་གསུངས་པའོ།",
    "འབད་པ་ཐམས་ཅད་དང་བྲལ་བ་ནི་འབད་པ་དང་བཅས་པའི་ས་ལས་ཡང་དག་པར་འདས་པའི་ཕྱིར་ར་རོ།",
    "རྣམ་པར་སྨིན་པ་ལ་གནས་པ་ཉིད་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ལ་ཤིན་ཏུ་གནས་པ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདུ་ཤེས་ཡོད་དུ་ཟིན་ཀྱང་བཟོད་པ་དེ་ནི་དེ་ཁོ་ན་ཤེས་པ་དང་ལྡན་པར་སྟོན་ཏོ།",
    "བྱས་པ་བསྔགས་པ་དང་།",
    "རྣམ་པར་རྟོག་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་ག།",
    "ཡེ་བུ་ཤེས་ཀྱི་སྒོ་བསམ་གྱིས་མི་ཁྱབ་པ་དྲན་པར་གྱིས་ཤིག་ཅེས་གསུངས་པའོ།",
    "ཡང་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་བདེ་བར་གནས་པའི་ཁྱད་པར་",
    "དེ་ལ་མཐའ་ཡས་པར་གྱུར་པ་དག་ནི་སྒོ་ཐ་ད་ད་པའི་ཕྱིར་ར་རོ།",
    "དེ་དག་ཐམས་ཅད་ཇི་ལྟ་བ་བཞིན་དུ་ཁོང་དུ་ཆུད་པར་གྱིས་ཤིག་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེའི་དེ་ཉིད་ཡོངས་སུ་མྱ་ང་ན་ལས་འདས་པར་འགྱུར་ཏེ།",
    "ཅད་ཀྱི་བྱ་བ་ཡང་རྒྱུན་གཅད་༡པར་འགྱུར་རོ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་དེ་ཉིད་ཡོང་ས་སུ་མྱ་ངན་ལས་འདས་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་ཉེ་བར་སྒྲུབ་པའི་དགོས་པ་སྟོན་ཏོ་༢།",
    "པར་སྒྲུབ་༢པ་ལ་དང་པོའི་སེམས་བསྐྱེད་པ་ནས་བཟུང་སྟེ།",
    "ངག་དང་ཡིད་ཀྱི་ལས་སུ་རིག་པར་བྱའོ།",
    "མི་གཡོ་བའི་ཚུལ་གྱིས་ཞེས་བྱ་བ་ནི་རྒྱུན་མི་འཆད་པར་བུ་སོགས་པའོ།",
    "༥དེ་ལྟར་གནས་པའི་ཁྱད་པར་ཐོབ་པས་ས་བརྒྱད་པ་རྣམ་པར་གཞག་ནས།",
    "ད་བང་བའི་སྦྱོར་བ་རྣམ་པ་གསུམ་གྱིས་རིག་པར་བྱའོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་འཇིག་པ་ལ་ཡང་རྣམ་པར་དཔྱོད་ད་དོ།",
    "རྣམ་པར་ཆེ་བ་ཡང་རབ་ཏུ་ཤེས་ས་སོ།",
    "རྣམ་པར་ཕྱེ་བ་ཡང་རབ་ཏུ་ཤེས་སོ་། དེ་མེའི་ཁམས་ཆུང་བ་ཡང་རབ་ཏུ་ཤེས་ས་སོ།",
    "རྣམ་པར་ཕྱེ་བ་ཡང་རབ་ཏུ་ཤེས་སོ།",
    "རྣམ་པར་ཕྱེ་བ་ཡང་རབ་ཏུ་ཤེས་སོ།",
    "རྣམ་པར་ཕྱེ་བ་ཡང་རབ་ཏུ་ཤེས་སོ།",
    "ལུས་རྣམ་པར་ཕྱེ་བ་ཡང་རབ་ཏུ་ཤེས་ས་སོ།",
