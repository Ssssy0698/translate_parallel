    "མེ་རིས་སོགས་སྣེ་ཅན་གྱི་རི་མོ་གཞོག་མ་ཐུབ་པས་སྣེ་མོ་སྦོམ་པའི་སྐྱོན་སོགས་སྤངས་ནས་རི་མོའི་ཉམས་ཐོན་པ་ནི་གལ་ཆེ་སྟེ།",
    "རི་མོ་རྡུགས་ན་འདྲེ་དང་འདྲ་ཟེར་བས་ཧམ་པས་གང་བྱུང་དུ་བརྐོ་མི་རུང་ངོ།",
    "ཡོ་འདུག་གིས་ལག་འགོ་འཇོག་སྟངས་ངན་པར་གོམས་ན་ཡི་གེ་ཡོར་འགྲོ་བས།",
    "ལྷ་རིས་ཀྱི་རི་མོ་ཕྲ་ཞིབ་དང་རྒྱན་སོགས་རྐོ་སྐབས།",
    "མི་ལོ་ལྔ་སྟོང་གོང་ནས་བྲག་ལ་སྲོག་ཆགས་ཀྱི་གཟུགས་བརྙན་དང་མཚོན་བྱེད་གཡུང་དྲུང་སོགས་ཀྱི་རི་མོ་བརྐོས།",
    "མི་གཅིག་ན་དེས་མཚོན་བྱ་དང་དབྱིབས་ཇི་ལྟ་བུ་ཞིག་ཡིན་པ་སོགས་དཔྱད་གཞི་ཞིག་ཏུ་སྣང་མོད་ཀྱང་།",
    "རང་རེའི་མེས་པོ་རྣམས་ཀྱི་རྣམ་དཔྱོད་དང་བརྩོན་འགྲུས་ལ་བརྟེན་ནས།",
    "དེང་དུས་འཛམ་གླིང་ཐོག་གི་ཆེས་ཆེ་བར་བསྔགས་པའི་རྒྱུ་ནག་ཆུའི་བྱམས་ཆེན་དང་།",
    "རྒྱ་ཁྱོན་དང་།",
    "འོ་ན་བོད་ཀྱི་གཟུགས་བཟོའི་ལག་རྩལ་གཞན་དག་དང་བཟོ་དངོས་ཐམས་ཅད་མི་རིགས་སུ་འདྲ་ཞིག་དང་བསྡུར་ནའང་མི་དམན་པ་ཞིག་ཡོད་མོད།",
    "སྤྱིར་བཏང་གི་རྡོ་སྐུ་ལ་དེ་ཙམ་གྱིས་ངལ་བ་བྱེད་འདོད་མེད་པ་དང་།",
    "གནས་སོ་སོའི་གཟུངས་དང་སྲོག་སྔགས་བཅས་ཆ་ཡོངས་སུ་ཚང་བ་ཞིག་དགོས་མོད།",
    "གཟིགས་པ་པོ་རྣམས་ལ་གྲོས་སུ་འདེབས་ཡུལ་ཙམ་བཏོན་པའོ།",
    "ཚིགས་སུ་བཅད་པ་རེ་ལའང་ཡིག་འབྲུ་སུམ་ཅུ་རྩ་གཉིས་ཉིད་དོ།",
    "ཨཱ་ཧུ་པའི་ཡི་གེ་དང་བཅུ་གཅིག་རྩུབ་མོའི་ཡི་གེ་དང་བཅུ་གཉིས།",
    "འགྲོ་ལྡིང་གི་ཡི་གེ་དང་བཅུ་གསུམ།",
    "མོན་ཡུལ་གྱི་ཡི་གེ་དང་བཅུ་བཞི།",
    "ཀྟ་སྩའི་ཡི་གེ་དང་ཉེར་གཅིག་རྒྱ་ནག་གི་ཡི་གེ་དང་ཉེར་གཉིས།",
    "མཁའ་ལྡིང་གི་ཡི་གེ་དང་སོ་གསུམ།",
    "བྱང་གི་ཡི་གེ་དང་སོ་དགུཤར་གླིང་གི་ཡི་གེ་དང་བཞི་བཅུ།",
    "དྲང་སྲོང་གི་ཡི་གེ་དང་དགུ།",
    "གསལ་བའི་ཡི་གེ་དང་རེ་གཅིག་ས་རབ་ཏུ་བལྟ་བའི་ཡི་གེ་དང་རེ་གཉིས།",
    "ཟངས་གླིང་གི་ཡི་གེ།",
    "ཡུལ་གླིང་སོ་སོར་ཡི་གེའི་རིགས་འདྲ་མིན་མཐའ་ཡས་པ་མཆིས་པ་ཀུན་གྱི་མཆོག་ནི་ལཉ་ཝར་ཡིན་ལ་དེ་དག་གི་འབྲི་ཚུལ་ཤེས་ན་ན་ག་རའི་ཡི་གེ་སོགས་ལའང་དཀའ་བ་མེད་ཅེས་གསུངས་སོ།",
    "ཡི་གེ་རེ་རེའི་ཞེང་ལ་རང་ཁམ་གསུམ་སྟེ།",
    "ལྟོ་བའི་དཔངས་དང་ཞེང་ཁྱོན་མཉམ་དགོས་ཀྱང་དཀྱིལ་དུ་མཚམས་གྲོན་ཡོད་པ་ལ་ཕྱེད་བཞི་དང་མེད་པ་ལ་གསུམ་སྟེ།",
    "རྟིང་མའི་སྐེའི་བར་ཐག་ལ་ཧ་ཅང་བཅང་མ་དྲགས་པར་ཉེ་འགྱང་ཁམ་ཚད་ཀྱིས་གཞལ་བའི་མཚམས་གྲོན་ཅན་དེ་ཨ་ཨི་རི་ལི་ཨེ་ཨོ་རྣམས་རིང་ཐུང་གིས་དབྱེ་བ་བཅུ་གཉིས་དང་།",
    "ཀ་ཚ་ཛ་ཉ་ཕ་ཀླུ་བརྩེགས་མང་གི་སྐེ་ཐིག་གོང་དུ་རིམ་པས་བསྐུམ་ཞིང་སྟེང་འོག་གཉིས་གཞི་མཐུན་དུ་བྲིར་རུང་ཞིང་།",
    "ཥ་པ་ཡང་དཀྱིལ་དུ་སྨྱུག་ཚག་གི་ཁྱད་ལས་མེད་ཅིང་།",
    "ཚེ་ཏན་ཞབས་དྲུང་གིས་མཛད་པའི་ལཉྫའི་མ་ཕྱི་དང་།",
    "དྲག་ཤུལ་ཤེར་གྲགས་གཉིས་ཀྱིས་བརྩམས་གནང་མཛད་པའི་ལཉྩ་དང་ཝརྟུའི་ཕྱི་མོ་ཀེ་ཏ་ཀའི་དོ་ཤལ་སོགས་ཐིག་དང་བྲིས་དཔེ་རྣམས་ལའང་གཟིགས་པར་འཚལ་ལོ།",
    "ཚངས་ཐིག་གཡས་གཡོན་དུ་ཆ་ཆེན་དྲུག་རེའི་གཞུང་ཐིག་གདབ།",
    "རྐང་པའི་བར་སྟོང་གི་ཆར་ཐིག་ཆེན་གཅིག་གི་བརྒྱད་ཆ་རེ་སྟེ།",
    "རྐང་པའི་གཞུང་ཐིག་རྣམས་ཀྱི་ནང་ངོས་ནས་ཆའི་གཞུང་ཐིག་རེ་བྱ།",
    "སྲིད་དུ་ནཱ་ད་སུམ་འཁྱོགས་ཅན་ལ་ཆ་ཆེན་གཅིག་ཐིག་ལེའམ་ཉི་མ་ལ་ཆ་ཆེན་གཉིས།",
    "ཉི་མའི་རྩེ་དང་མཉམ་པས་མཐོ་སྐྱོན་ཡོད་པས་གཉིས་སུ་ངེས་ཤིང་རྩེ་གཉིས་ཀྱི་རྒྱར་ཆ་ཆེན་གསུམ་མོ།",
    "གཡས་ནས་ཆ་གཉིས་སོང་མཚམས་ཧ་ཡིག་གི་སྐེ་བཏོན།",
    "མ་དང་ལ་གཉིས་པོར་ཕྱེད་གསུམ་རེ།",
    "ཡི་གེའི་རྐང་པའི་མས་ཐིག་ནས་དུས་མེའི་གདན་ལ་ཆ་ཆེན་གཅིག་དེ་འོག་ཉི་མ་དང་ཟླ་བའི་གདན་ལ་ཆ་ཆེན་གྱི་བཞི་ཆ་རེ།",
    "ཁམས་དྲུག་གི་རང་བཞིན།",
    "བོད་ཡིག་གི་མཆོག་གཟབ་ཆེན་མའམ་དབུ་ཅན་ལ།",
    "ལྡན་མ་རྩེ་མང་གི་ལུགས་ཡིན་པས་སམ་ཡི་གེ་ཚད་དང་ལྡན་པས་ལྡན་ལུགས་ཞེས་པ་ཐིག་ཚད་ཆེ་བའི་ཁོངས་ནས་དྲངས་པ་འབྲུ་ཆེན་དང་།",
    "འབྲིང་དུ་མཚལ་སོགས་བཟང་ཚོན།",
    "ཤེས་བྱ་སྣ་ཚོགས་ཀྱི་མཛོད་ལ་སོགས་ཕྱོགས་སྒྲིག་གི་སྐོར་དུ་མ་དང་ཐོར་བུ་ལ་སོགས་པའི་བསྟན་བཅོས་ཕལ་མོ་ཆེ་བཞུགས་པ་ལས།",
    "རྒྱལ་པོ་སྲོང་བཙན་ནས་གླང་དར་གྱིས་བསྟན་པ་མ་བསྣུབས་བར་ལོ་ཉིས་བརྒྱ་བཅུ་དྲུག་ཙམ་གྱི་རིང་ལ་བོད་ཀྱི་ལོ་ཙཱ་བ་ཐོག་མ་ཐོན་མི་སམ་བྷོ་ཊ་ནས་ནམ་མཁའ་སྐྱོང་གི་བར་ལོ་ཙཱ་བ་ལྔ་བཅུ་རྩ་གཅིག་བྱུང་བ་དང་།",
    "རྒྱུ་ནག་གི་སྐད་དང་།",
    "རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་དུས་ལ་བསམ་ཡས་སུ་རྒྱ་གར་སྒྲ་བསྒྱུར་གླིང་བཙུགས་ནས་བཀའ་དང་བསྟན་བཅོས་ཕལ་མོ་ཆེ་བོད་ཡིག་ཏུ་བསྒྱུར་ཅིང་ལོ་ཙཱ་བ་སྐ་བ་དཔལ་བརྩེགས་དང་།",
    "ཡང་འཇམ་དགག་གིས་སོག་ཡུལ་ནས་སྣག་ཤོག་སོགས་གང་དགོས་བསྐུར་ནས།",
