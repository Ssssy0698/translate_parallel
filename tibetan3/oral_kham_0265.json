    "ཁོ་རང་ཉིད་ཀྱི་སེམས་སུ་ཕན་ཚུན་འཆམ་མཐུན་ལས་འགལ་ཟླ་གང་ཡང་མེད་དོ།",
    "ཧིན་རྡུ་བཞིན་རང་རང་སོ་སོའི་འགྲེལ་བརྗོད་དང་གླེང་སློང་ལས་འདས་ཏེ།",
    "ཁྱེད་རང་མི་སྒེར་གྱི་ཉམས་མྱོང་དང་།",
    "ཁྱེད་རང་འདིར་འཚོ་བཞིན་ཤེས་བྱའི་ཡན་ལག་སྣ་ཚོགས་དང་།",
    "ཁྱེད་རང་ཡང་ཡོན་ཏན་ཅན་ཞིག་ཏུ་འགྱུར་ཞིང་དེ་ནས་སྐབས་ཐོག་དེར་རྣམ་དཔྱོད་རྒྱུད་ལ་སྐྱེ་ངེས་སམ།",
    "གལ་སྲིད་ཁྱེད་རང་ཕྱོགས་ལྷུང་ཅན་དུ་གྱུར་ཅིང་།",
    "དེ་ཡང་རང་བྱུང་ཁམས་ལ་བཅངས་པའི་ཚོར་ཤེས་སྐྱེན་པོ་དང་།",
    "ཁྱེད་རང་ལ་དེ་ལྟར་ཡོད་དམ།",
    "ཁྱེད་རང་རྣམ་དཔྱོད་དང་ལྡན་པ་ཞིག་བགྱི་བར།",
    "ངས་ཁྱེད་རང་རྣམ་དཔྱོད་དང་ལྡན་པར་འགྱུར་བར་རམ་འདེགས་བྱེད་འདོད།",
    "དེ་ལྟར་ཁྱེད་རང་ས་ཆ་འདི་དང་ཁ་འབྲལ་དུས།",
    "ཁྱེད་རང་ཆེས་ཁྱད་དུ་འཕགས་པའི་མི་ཞིག་སྟེ།",
    "དེ་ཡིས་ཁྱེད་རང་ཕྱོགས་ལྷུང་བྲལ་ཞིང་གསོན་ཤུགས་རྒྱས་པ།",
    "ཁྱེད་རང་རྣམ་དཔྱོད་ལྡན་པ་ཞིག་ཡིན་ན།",
    "དེ་ནས་ཁྱེད་རང་རི་ཤིའི་ལུང་པ་འདི་དང་ཁ་འབྲལ་དུས།",
    "ཅིའི་ཕྱིར་ཁྱེད་རང་ལྟོས་བཅས་ཀྱི་རང་བཞིན་ཡིན་པ་འཚོལ་བར་གྱིས།",
    "ཁྱེད་རང་ལ་མཚོན་ན།",
    "ཐབས་ལམ་འདི་བཞིན་ཁྱེད་རང་ལ་མཚོན་ན།",
    "ཁྱེད་རང་ལ་མཚོན་ན་དེ་ཤེས་ཐུབ་བམ།",
    "ཁྱེད་རང་འདི་ལ་ཡིད་ཆེས་བྱེད་ཅིང་གན་ལ་ཡིད་ཆེས་མི་བྱེད།",
    "དེའི་རྐྱེན་གྱིས་ཁྱེད་རང་ལྷ་ཁང་དུ་འགྲོ་ལ།",
    "ཁྱེད་རང་ལྟོས་བཅས་རང་བཞིན་དང་གོ་རྟོགས་ཅན་ཞིག་ཏུ་གྱུར་ན།",
    "ལྟོས་བཅས་རང་བཞིན་ཅན་དུ་གྱུར་བར་ཅི་ཞིག་འཆུག་འདུག་གམ།",
    "གནས་སྟངས་འདི་ལས་ང་རང་ཇི་ལྟར་གཉིད་སད་དགོས་སམ།",
    "ངས་ནམ་ཡང་རང་ཉིད་ལ་ཇི་ལྟར་བྱས་ནས་གཉིད་སད་པར་དྲི་བ་འདྲི་མ་མྱོང་།",
    "ཁྱེད་ཀྱི་ལྟོསབཅས་རང་བཞིན་གྱི་ཆ་ཤས་དེའི་རྐྱེན་གྱིས་ཁྱེད་རང་ཕྱོགས་ལྷུང་བར་གྱུར་ཅིང་།",
    "ཇི་ལྟར་ཉན་པར་ཤེས་པར་བྱ་རྒྱུ་དེས་ཁྱེད་རང་བློ་རྩེ་གཅིག་སྒྲིམ་ཅན་ཞིག་ཏུ་འགྱུར་བར་བྱེད།",
    "ཁྱེད་རང་གཙང་པོའི་འགྲམ་དུ་བསྡད་ནས་ཆུ་བོ་བཞུར་བར་ལྟ་མྱོང་ངམ།",
    "དེ་ནི་གོ་རིམ་མེད་པ་ཞིག་བཟོས་འདུག་ཁྱེད་ཀྱིས་མི་གཞན་པས་ཅི་ཞིག་འདོད་པར་བསམ་བློ་གཏོང་དགོས་ལ།",
    "དོན་དག་བག་ཕེབས་པོའི་ངང་བསྒྲུབ་ན་ཁྱེད་རང་དུས་ལྟར་ཐོན་དགོས།",
    "ཁྱེད་རང་བློ་རྩེ་གཅིག་སྒྲིམ་དང་ཁུ་སིམ་མེར་སྡོད་དུས་ད་གཟོད་ཁྱེད་ཀྱིས་གསལ་ཐིང་ངེར་གོ་བར་བྱེད།",
    "གལ་སྲིད་ཁྱེད་རང་བལྟ་བ་དང་།",
    "ད་དུང་རང་ཉིད་ཀྱིས་ཅི་ཞིག་སྨོན་པ་དེ་བསྒྲུབ་འདོད་ཡོད།",
    "ཁྱེད་རང་འཚོ་ངེས་པ་ཡིན་པར་བརྟེན་ཁྱེད་ཀྱིས་ཡང་དག་པའི་སྒོ་ནས་བྱ་བ་སྒྲུབ་འདོད་ཡོད།",
    "ཐོག་མར་ཁྱེད་རང་གཞན་ལ་བརྟེན་མི་ཐུབ་སྟེ།",
    "ཁྱེད་ཀྱིས་ཅི་ཞིག་སྒྲུབ་དགོས་པ་དེ་གླེང་བར་ཁྱེད་རང་གཞན་ལ་བརྟེན་དགོས་ལ།",
    "ཁྱེད་རང་ཧ་ཅང་ཆུང་བས་ཆེས་ཐག་རིང་ལ་ཕྱིན་མེད་སྙམ།",
    "དེའི་ཆེད་དུ་ཁྱེད་རང་ངེས་པར་དུ་ཚོར་ཤེས་སྐྱེན་པོ་ཅན་ཞིག་ཡིན་དགོས་ལ་ཁྱེད་ལ་ཡོད་པའི་ཚོར་ཤེས་སྐྱེན་པོས་མཛེས་སྡུག་ལ་རྗེས་སུ་ཡི་རང་བྱེད།",
    "ཁྱེད་རང་ལམ་སྲོལ་དེའི་ནང་དུ་ཚུད་པར་ངེས།",
    "དེ་རུ་སྦྲང་ཆར་སིམ་སིམ་འབབབཞིན་འདུག་དེར་རྣོ་ངར་ལྡན་པའི་ཆར་ཞོད་ཆེ་ལ།",
    "ཁྱེད་རང་ན་གཞོན་ཡིན་པའི་དུས་དང་།",
    "ཁྱེད་རང་ལོ་ན་རྒན་པར་གྱུར་བ་དང་བསྟུན་མི་ཚེས་ཁྱེད་རང་མཇུག་བསྡུ་བར་རྩོམ་ཞིང་།",
    "ཁྱེད་རང་ལོ་ན་རྒན་པར་ཆགས་པ་དང་བསྟུན།",
    "ཁྱེད་རང་ཞེད་སྣང་སྐྱེ་བར་འགྱུར་ལ།",
    "ཁྱེད་རང་ལོ་ན་རྒན་པར་ཆགས་པ་དང་བསྟུན་ནས།",
    "ཁྱེད་རང་ཧ་ཅང་ཁུ་སིམ་པོའི་གནས་བབ་ཁྲོད་འཚོ་བར་ངེས།",
    "ཁྱེད་རང་ཞེད་སྣང་ལས་གྲོལ་བའི་སྐབས་སུ།",
    "ཁྱེད་རང་དེ་ལས་རྒྱང་རིང་དུ་བགྲོད་ཐུབ་ཅིང་།",
    "གལ་སྲིད་ཁྱེད་རང་ཧ་ཅང་ཁུ་སིམ་ལ།",
    "གལ་སྲིད་ཁྱེད་རང་ཞེད་སྣང་སྐྱེས་ཏེ་རྒྱང་ལ་བྲོས་ན།",
    "ང་རང་ལྟོགས་ཀྱིན་འདུག་ང་ལ་ཐ་སྙད་ཙམ་མིན་པར་ཟ་མ་བྱིན་ཏེ་གསོས་ཤིག་ཁོ་བོས་ཁྱེད་ལ་ཡིད་ཆེས་མི་བྱེད་དེ་དེ་བས་ཁོས་འདྲི་རྒྱུར།",
    "ཁྱེད་རང་ཅིའི་ཕྱིར་འཐམ་བཞིན་པ་ཁྱེད་ཀྱིས་ཤེས་སམ།",
    "ཁྱེད་རང་བྱ་དངོས་དེར་འཐམ་པར་བྱེད།",
    "ཁྱེད་རང་འགྲོར་འཇུག་པ་ལ་ཞེད་སྣང་སྐྱེ་ངེས་ཏེ།",
    "དེ་ནས་ཁྱེད་རང་འབྱུང་འགྱུར་གྱི་མི་རབས་ཤིག་ཏུ་འགྱུར་ཐུབ།",
    "ཁྱེད་རང་གཞན་དུ་བསྒྱུར་ཞིང་།",
    "ཁྱེད་རང་འཕྲུལ་ཆས་རང་བཞིན་ཅན་དུ་འགྱུར་མི་རུང་བར་རྟོགས་དགོས་ཤིང་།",
    "ཁྱེད་ཀྱིས་རྟོག་ཞིབ་ནན་ཏན་ག་དུས་བྱེད་ཀྱིན་ཡོད་དམ།",
    "ཁྱེད་རང་ཅུང་འཚར་ལོངས་བྱུང་བའི་སྐབས་དང་།",
    "ཁྱེད་རང་ཞེད་སྣང་བྲལ་ཞིང་གྲུང་ཤ་དོད་པའི་འཚོ་བ་དང་འཕྲད་པ་ཡིན།",
    "དེ་རྟོགས་པར་ཁྱེད་རང་ཧ་ཅང་གཞོན་པའི་དུས་ཡིན་དགོས།",
    "ཁོ་རང་སུ་ཡིན་མིང་སྨྲོས་མི་དགོས་ལ།",
    "ཁོང་རང་རྣལ་འབྱོར་བ་ཞིག་ཡིན་པར་ཀུན་ལ་སྒྲོག་པར་མི་བྱེད།",
    "ཁོ་རང་སྒོམ་ཆེན་པ་ཞིག་བྱེད་འདོད་ལ།",
    "ཁོ་རང་དད་ལྡན་པ་ཞིག་བྱེད་འདོད་ལ།",
    "ཁྱེད་རང་འཚར་ལོངས་བྱུང་བ་དང་བསྟུན།",
