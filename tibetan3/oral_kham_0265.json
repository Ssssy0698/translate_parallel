    "བྱ་རྒོད་ཕུང་པོ་ནས་ཕར་ཙམ་བར་སྣང་སྟོང་པ་ལ་མི་དབྱིབས་ལུས་ཚད་ཁང་པ་གཉིས་ཙམ་བྱས་པ་ལ།",
    "ལུས་ཀྱི་ཕྱི་ནང་ཐམས་ཅད་མེ་འབར་བའི་སྡུག་བསྔལ་མྱོང་བ་ཞིག་འདུག།",
    "དེ་ནས་ཚུར་ཙམ་གྱི་བར་སྣང་ལ་མིའི་རྣམ་པ་ལུས་བོང་ཆེ་ཞིག་ལ་འབྲས་བུ་རིའི་གཏོས་ཙམ་ཐུར་དུ་འཕྱང་བ།",
    "གླ་རྣམས་དུས་ལ་མ་བླངས་པར་ལན་ཅིག་རྩིས་བྱས་པས་མང་པོ་བྱུང་འདུག་པ་ཐམས་ཅད་ཁོང་ལ་ཕུལ།",
    "དེ་དག་ཀྱང་བཟོད་པའི་བླག་མི་འདུག་པས་ཅིས་ཀྱང་དེར་མ་སྐྱེས་པ་ཞིག་བྱ་དགོས་པར་འདུག་པ་སོགས་གོང་བཞིན་བསམ་པར་བྱའོ།",
    "ཟན་གྱི་རི་བོ་ཆེན་པོ་འདུག་པ་མཐོང་།",
    "སྡུག་བསྔལ་དེ་ཙམ་སྤྱད་ནས་ཕྱིན་པས་འཁྲིས་སུ་སླེབས་ཙ་ན།",
    "སའམ་དཀར་གོང་ལྟ་བུའི་ཕུང་པོར་གྱུར་ནས་ཟན་ལ་སོགས་པ་བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས་ངུ་ཞིང་འགྲེ་ལྡོག་པ་དང་།",
    "སྔར་ཕན་ཆད་གང་ལ་འདུག་པ་དེར་འདོད་ཡོན་ལ་ཡེངས་ནས་ལྷོད་དེ་གནས་པ་ལ།",
    "སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་ལ་ལོངས་སྤྱོད་ཀྱིན་འདུག་པས།",
    "དེ་དག་ལས་ལྷག་པའི་ཉན་རང་འཕགས་པ་དེ་བས་ཀྱང་ཆེས་ལྷག་པའི་བྱང་སེམས་རྣམས་ལའང་རང་དོན་དུ་སྤངས་རྟོགས་ཀྱི་ཡོན་ཏན་མ་རྫོགས།",
    "དེ་ལྟར་གཞག་པའི་ཚེ་ན་སེམས་དང་མེ་ཏོག་འདྲེས་པ་ཆམ་མེ་ཤིག་གེ་འདུག་ན་རང་སོ་གཟུང་བ་ཞེས་བྱ་སྟེ།",
    "ཕ་མ་རྣམས་ཧ་ཅང་སྡུག་ཡུས་རིང་དྲག་འོང་འདུག་པས།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་རོལ་པས་འདུག་སྟེ།",
    "མེད་ན་ནི་བེམས་པོ་དང་ཁྱད་མེད་དུ་འདུག་པ་ལས།",
    "ད་ལྟ་གྱ་གྱུ་ཧྲིག་ཧྲིག་འདུག་པ་འདི་ཡིན།",
    "དཔེ་མེད་ཀྱི་ཐུགས་དམ་པར་བྱེད་པ་ཚོ་ཡུལ་དུ་སླེབས་ཙ་ན།",
    "འོན་ཀྱང་འདི་འདྲའི་ཚོད་ན་ཅུང་མི་ཟབ་པར་གདའ་གསུངས།",
    "དེས་ན་སྣང་གསུམ་གྱི་སྐབས་ཀྱི་ཞི་ལྷག་དེ་ལེགས་པོ་ལོས་ཡིན་ནའང་།",
    "ལམ་དུ་ཐག་པ་ཞིག་ཡོད་པ་མཐོང་མ་ཐག་སྦྲུལ་འདུག་གོ་སྙམ་དུ་འཇིགས་སྐྲག་པས་བྲོས་པའི་ཚེ།",
    "རྗེས་ཙམ་ཡང་མི་འདུག།",
    "དགྲ་ལ་ཞེ་སྡང་སྐྱེས་ན་ང་རང་འཁྲུལ་པ་ཡིན།",
    "འཁྲིས་ན་ཡོད་རྣམས་ཀྱིས་མེད་པ་ལ་མེད་པར་ཤེས་ནས་ཇི་ཙམ་སྨྲས་ཀྱང་མི་ཉན་པར་ཁོ་རང་འཁྲུལ་པ་དང་འཇིགས་པས་གད་མཆོངས་གཡང་མཆོངས་དུ་མ་བྱེད།",
    "འདི་ཞེས་བརྗོད་མ་ཤེས་པས་བརྗོད་བྲལ་དུ་འདུག་སྙམ་ཐག་གཅད་དོ།",
    "ཤར་ཙམ་ནས་སྐྱེ་འགག་དང་བྲལ་བའི་སྟོང་པ་ཉིད་གང་དུའང་མ་གྲུབ་པར་འདུག་སྙམ་དུ་གོ་ལྟར་བསམ་ཞིང་ཉམས་སུ་ལེན་པར་བྱེད།",
    "སྔ་མར་ཁོ་རང་འབར་བཞིན་དུ་གནས་པའོ།",
    "གཡའ་བ་དེ་ཚུལ་འདི་ལྟར་འདུག་ཅེས་བརྗོད་མི་ཤེས་པ་ལྟ་བུའོ།",
    "གང་ཟག་དེའི་བློ་ཡུལ་དུ་ཟླ་བ་དེ་འདི་འདྲ་ཞིག་ཡོད་པར་འདུག་སྙམ་དུ་དོན་སྤྱིའི་རྣམ་པར་འཆར་བ་བཞིན།",
    "རྟེན་འཁོར་ལོ་བཞིའང་སེམས་ཁོ་རང་འཁྲུལ་བའི་སྣང་བ་མ་གཏོགས་ཕྱི་རོལ་ན་གྲུབ་པ་མེད་ལ།",
    "སེམས་ཀུན་གཞི་ཁོ་རང་ངོ་མ་ཤེས་པའི་ཚེ།",
    "སེམས་ཀྱི་ངོ་བོ་གསལ་སྟོང་ཟུང་འཇུག་བརྗོད་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བར་འདུག་སྙམ་དུ་ཐག་གཅད།",
    "ངོ་བོ་ཟུང་འཇུག་ལས་མ་འདས་པར་འདུག་སྙམ་དུ་ངེས་ཤེས་སྐྱེ་བ་ཡིན་གསུངས།",
    "བསྒོམ་བྱའི་དོན་ལ་ཐོས་བསམ་གྱིས་སྒྲོ་འདོགས་གཅོད་པ་ཙམ་ཞིག་བྱས་པའི་ཚེ་ཡིན་པར་འདུག་སྙམ་པའི་ཡུལ་ལམ་མེ་བ་ལས་རྒྱུད་ལ་མ་སྐྱེས་པ།",
    "གསལ་ཐེབས་པ་ན་དེ་དང་རང་སེམས་དབྱེར་མེད་དུ་བསྲེས་ནས་ཆམ་མེར་འཇོག།",
    "ཡང་སྔར་བཞིན་ཞི་གནས་དང་འདྲེས་ནས་རྟོག་མེད་དུ་ཆད་དེ་གནས་ཀྱིན་འདུག་ན་སྤོ་མི་དགོས།",
    "ཟླ་བ་འབུམ་ཕྲག་དུས་གཅིག་ཏུ་ཤར་བ་ལྟ་བུ།",
    "མདུན་གྱི་ལྷ་དང་རང་སེམས་བསྲེས་ནས་བརྗོད་མེད་དུ་ཆམ་ཆམ་འཇོག།",
    "ང་ཤི་བ་ཡིན་པ་འདུག།",
    "ད་ང་ཤི་འདུག་སྙམ་དུ་སྡུག་བསྔལ་བསམ་གྱིས་མི་ཁྱབ་པ་འབྱུང་།",
    "དེ་ལྟར་རྨི་ལམ་བཟུང་བས་རྨི་ལམ་གྱི་སྐབས་སུ་འདི་ལྟར་ལམ་གྱི་སྣང་བར་འདུག་སྙམ་པ་ཤར་བའི་ཚེ།",
    "བདག་རྒྱུད་བྱིན་གྱིས་བརླབ་པར་གསོལ་བ་འདེབས་ཤིང་རང་ལ་བསྟིམ།",
    "རིག་མས་ཀྱང་རང་གསང་གནས་དངོས་གཞི་སྒྲུབ་ཐབས་ལྟར་ལ།",
    "འདུག་སྟངས་སྔར་ལྟར་ལས།",
    "ཞེས་སོགས་ཀྱིས་ཚོགས་ཞིང་རང་ལ་བསྟིམ།",
    "པུས་འཁྱུད་དང་བཅས་པའི་ཙོག་པུ་རྐང་པ་གཉིས་ཅུང་ཟད་བསྣོལ་བ་རིག་བྱེད་འདོན་པ་ལྟ་བུའི་སྤྱོད་ལམ་གྱིས་འདུག་གོ། རྩ་བའི་གཉིས་པ་དངོས་གཞི་ལ།",
    "མ་གྲུབ་ན་རས་སམ་ཤོག་བུ་ལ་བྲིས་པའང་བྱེད་ཅིང་འདུག།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཁྱེད་རང་རྣམས་རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་སྟོབས་འཕྲོག་གདོང་བཞི་པ་ཞེས་པ་ནས།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་ནས་ཡི་དམ་ལྷའི་རྣལ་འབྱོར་བསྒོམ།",
    "དེ་རྣམས་ཀྱི་སྟེང་དུ་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཀྱི་ངོ་བོ་དབུས་སུ་ཧཱུྃ་མཐིང་ནག་གཡས་སུ་སྔོན་པོ།",
    "ཁྱེད་རང་རྣམས་དབུས་སུ་རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་རྡོ་རྗེ་གདོང་བཞི་པ་དགྲ་བོའི་སྟོབས་འཕྲོག་པའི་གཟུགས་ཅན།",
