    "རྫས་གཅིག་ལ་དོན་དམ་པར་སྤྱི་དང་བྱེ་བྲག་མི་འཐད་པའི་ཕྱིར་ཏེ།",
    "དོན་དམ་པར་སྤྱི་དང་བྱེ་བྲག་གཉིས་འཐད་པར་མི་རུང་བའི་ཕྱིར་ཏེ།",
    "དོན་དམ་པར་འཐད་ན་རྫས་གཅིག་ཏུ་འགྱུར་ལ།",
    "དེ་ཉིད་དོན་དམ་ཡིན་པར་འདོད།",
    "རྣམ་འགྲེལ་གྱི་ལེའུ་གསུམ་པར་ཡང་རྒྱས་པར་བཀག་ཅིང་།",
    "རང་དང་སྤྱི་དང་འགལ་བ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "རྟོག་གེའི་བརྡ་ཆད་མི་ཤེས་པར་འཁྲུལ་པ་ཁོ་ནའོ།",
    "འོ་ན་དངོས་པོའི་མཚན་ཉིད་རང་མཚན་ཁོ་ན་ཡིན་པར་ཁས་བླངས་ན།",
    "འདུས་མ་བྱས་ཀུན་རྫོབ་དོན་དམ་དུ་མི་རིགས།",
    "རྣམ་མཁྱེན་ཕྱི་དངོས་ཀྱི་སྤྱོད་ཡུལ་ནི་སྒྲོ་བཏགས་ཡིན་པས་ཀུན་རྫོབ་ཡིན་གྱི་རྣམ་གྲངས་པའི་དོན་དམ་ཙམ་དུ་ཡང་མི་རུང་ངོ།",
    "རྫས་གཅིག་ན་སྐྱེ་འཇིག་གཅིག་པར་འགྱུར་ཞེས་པའི་རིགས་པ།",
    "འོ་ན་གྲངས་ཅན་གྱིས་གཙོ་བོ་དང་དངོས་པོ་ཀུན་རྫས་གཅིག་ཏུ་འདོད་པ་ལ་ཡང་གནོད་པར་འགྱུར་ཏེ།",
    "རྫས་གཅིག་དང་གཅིག་ལ་ཐ་དད་མེད་པར་འདོད་དགོས་པས་སོ་ཞེ་ན།",
    "གྲངས་ཅན་གྱིས་རྫས་གཅིག་དང་གཅིག་ལ་ཁྱད་པར་མེད་པར་མི་འདོད་དེ།",
    "གཙོ་བོ་དང་དངོས་པོ་ཀུན་རྫས་གཅིག་ལ་གནས་སྐབས་ཐ་དད་པར་འདོད་པའི་ཕྱིར།",
    "དེས་ན་སྐྱེ་འགག་གཅིག་ཏུ་བྱེད་པར་འགྱུར་རོ་ཞེས་པའི་དོན་དུ་བསམས་ནས།",
    "མུ་སྟེགས་པས་སྒྲ་རྟོག་སྒྲུབ་པས་འཇུག་པར་འདོད་པ་ཡོད་ལ།",
    "རྫས་ལ་སྐྱེ་འཇིག་ཅིག་ཅར་བྱེད་པར་འགྱུར་དགོས་པས།",
    "ཕྱི་ནང་སུས་ཀྱང་ཁས་མི་ལེན་པས་སུ་ཞིག་ལ་རྩོད་པ་བྱེད་པར་བརྗོད།",
    "དོན་དམ་པར་དོན་བྱེད་ནུས་པ་ལ་རང་མཚན་དང་དོན་དམ་དུ་གསུངས་ལ།",
    "ཀུན་རྫོབ་བདེན་པ་ལའང་ཡང་དག་པ་དང་ལོག་པའི་ཀུན་རྫོབ་བདེན་པ་གཉིས་སུ་རྣམ་པར་ཕྱེ་ཞིང་།",
    "ཡོད་མེད་གཉིས་ཀའི་ཚུལ་གསུམ་གསུངས་པ་ལས།",
    "འདི་ལ་དགོངས་ནས་སྒྲ་རྟོག་ཐམས་ཅད་ལ་ཡུལ་ཡོད་པར་གསུངས་ཏེ།",
    "ཡོད་ཅེས་ཐ་སྙད་བརྟེན་པར་འདོད།",
    "ཡུལ་མེད་པ་ཉིད་དུ་གསུངས་ཀྱི།",
    "རྗེས་སུ་དཔག་པའི་རྣམ་པར་རྟོག་པ་ནི་ཡུལ་མེད་པ་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་པ་ལྟར་རོ།",
    "འགའ་ཞིག་ལ་མེད་པའི་ཚུལ་གཉིས་གསུངས་སོ།",
    "སེལ་བའི་ངོར་བྱས་ནས་སྤྱི་དང་གཞན་གྱི་རྣམ་གཞག་བྱེད།",
    "སྤྱི་ཡོད་པར་ནི་རབ་ཏུ་བསྒྲགས།",
    "རིགས་སྤྱི་ནི་རང་མཚན་ལ་རྗེས་སུ་འགྲོ་ཞིང་བུམ་པ་མིན་པ་རྣམ་པར་བཅད་ཙམ་ཞིག་བུམ་པའི་རིགས་སྤྱི་ཡིན་ལ།",
    "བུམ་སོགས་རྣམས་དོན་ལ་བུམ་མིན་ལས་ལོག་པར་གནས་པའི་ཕྱིར་རོ་ཟེར་རོ།",
    "སྒྲ་མིན་རྣམ་པར་བཅད་པ་དེ་ཉིད་སེལ་ངོར་གསལ་བ་ལ་རྗེས་སུ་འགྲོ་བར་བཞག་ཏུ་རུང་བའི་ཕྱིར།",
    "ཤིན་ཏུ་རྣམ་པར་དཔྱད་པའི་ཚེ་མི་རུང་སྟེ།",
    "སྒྲ་དང་གསལ་བ་རྣམས་སྒྲ་མིན་ལས་ལོག་པར་སྣང་བ་ཙམ་ལ་བརྗོད་ན་ནི།",
    "སྒྲའི་གསལ་བ་རྣམས་དེ་མིན་ལས་ལྡོག་པར་འདྲ་ཡང་རྟོག་པས་བཟུང་བ་ཙམ་ལ་བརྗོད་ན་ནི།",
    "དོན་དམ་པར་དངོས་སུ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཕྱིས་ཀྱི་རྟོག་པས་དངོས་ཡུལ་དུ་བྱས་པའི་ཆ་ནི་ཀུན་རྫོབ་བོ།",
    "འཆད་ཚེ་རྣམ་པར་ཕྱེ་བའི་རྣམ་གཞག་དང་།",
    "རྟགས་དང་བསྒྲུབ་བྱ་འགལ་འབྲེལ་སོགས་ཀྱི་ཆ་སྒྲ་རྟོག་དངོས་མེད་ལ་འཇུག་པ་རྣམས་འཆད་ཚེ་རྣམ་པར་ཕྱེ་བའི་རྣམ་གཞག་གོ།",
    "རང་མཚན་ལ་དགག་སྒྲུབ་བྱེད་པ་སོགས་ཀྱི་རྣམ་གཞག་མང་པོ་དངོས་པོའི་གནས་ལུགས་སུ་བཟུང་ནས་སྨྲ་བ་ནི་རྟག་པར་སྨྲ་བའི་མུ་སྟེགས་པ་དང་མཚུངས་པར་པཎྜི་ཏ་དྷ་ན་ཤཱི་ལ་སོགས་པའི་མཁས་པ་རྣམས་ཀྱིས་གསུངས་སོ།",
    "དེ་ཡི་རྗེས་འབྲངས་ཤེས་པར་གྱིས།",
    "དེས་ན་བློ་གསལ་དོན་གཉེར་རྣམས་ཀྱིས་འདི་ལ་བསྟེན་པར་བྱ་སྟེ།",
    "ཡུལ་དུས་སོགས་ཅུང་ཟད་ཙམ་ཡང་མི་འབྱེད་པར་སྣང་བ་ལ་དོན་དུ་བཟུང་ནས་ཞུགས་པས།",
    "དོན་རང་མཚན་རྟོགས་པའི་ཆེད་དུ་རྟགས་ཀྱི་རྣམ་གཞག་བྱས་པ་ཡང་འཁྲུལ་ཚུལ་གྱི་རྣམ་གཞག་ལ་བརྟེན་ནས་བྱས་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་དོན་ནི་མ་བརྟགས་པར།",
    "གཞན་སེལ་ཕྱིན་ཅི་མ་ལོག་པའི་རྟགས་དང་བསྒྲུབ་བྱ་དང་སྤྱི་དང་བྱེ་བྲག་སོགས་ཅིའི་ཕྱིར་ཡོད་པར་མི་འགྱུར།",
    "གལ་ཏེ་གཞན་སེལ་ཕྱིན་ཅི་མ་ལོག་པ་ཐམས་ཅད་ཀྱི་དངོས་ཡུལ་ཡོད་པར་འགྱུར་རོ།",
    "མེད་པར་གཞན་འཁྲུལ་བ་དང་མ་འཁྲུལ་བའི་རྣམ་དབྱེ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འཛིན་སྟངས་དོན་དང་མཐུན་མི་མཐུན་གྱི་སྒོ་ནས་རྣམ་པར་འབྱེད་པས་ཉེས་པ་མེད་དོ།",
    "བྱེ་བྲག་སྨྲ་བའི་ཚུལ་དང་མཚུངས་ལ་ཁྱད་པར་ཅུང་ཟད་འདིར་བརྗོད་པར་བྱ་བ་ནི་ཤེས་བྱ་གཞི་ལྔ་ལས།",
    "བྱེ་བྲག་སྨྲ་བས་སྐོར་བ་བར་བཅས་ཀྱིས་རྩོམ་པར་འདོད་ཅིང་།",
    "གཞན་ས་བོན་གྱི་ཚུལ་དུ་ཡོད་པར་འདོད་དོ།",
    "ཐམས་ཅད་རྫས་སུ་གྲུབ་པར་འདོད་ཅིང་།",
    "འདུས་མ་བྱས་ཀྱི་གཞི་ལ།",
    "བྱེ་བྲག་སྨྲ་བས་རྫས་སུ་གྲུབ་པར་འདོད་ཅིང་།",
    "འདུས་མ་བྱས་གསུམ་རྟག་པ་སྟེ།",
    "ཕྲ་མངོན་རིག་པར་རྡུལ་གྱི་ཚོགས།",
    "བློ་ལྡན་ཞར་བཞེས་ཁས་འཆེ་བའི།",
