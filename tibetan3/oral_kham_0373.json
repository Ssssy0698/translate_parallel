    "མཐོན་དམན་གྱི་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་ཡོད་ཀྱི་ས་བོན་དང་མྱུ་གུ་ད་ལྟར་བ་དང་མ་འོངས་པ་དག་ལ་ནི་དུས་གཅིག་མེད་པས་འདི་ནི་སྲང་དང་མཚུངས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་དུ་མི་རིགས་པ་ཁོ་ནའོ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་སྟེ།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "བདེན་པ་གཉིས་སུ་འང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་བདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་ཏེ་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རྟག་པ་དང་ཆད་པ་མེད་པ་ཉིད་དོ།",
    "དེ་ཕྱིར་དེ་ལྟར་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་མེད་པས་རྟག་པ་དང་ཆད་པར་ལྟ་བ་རྒྱང་རིང་དུ་སྤངས་པ་འགའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་འབྱུང་གཉིས།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པ་ནི་ཡོད་པ་ཡིན་ནོ།",
    "འདི་ལས་ཀྱང་རང་རིག་པ་ཡོད་པ་མ་ཡིན་པས་དེ་ཉིད་ཀྱིས་དེ་འཛིན་པ་མ་ཡིན་ནོ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ལྟར་ཕར་འདུག་ཅིག།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམས་འཇོམས་པ།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་ཏུ་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
    "ཇི་ལྟར་ཉིད་ཀྱི་སྤྱོད་པ་དང་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་སྤྱོད་པ་དག་དུས་གཅིག་ཏུ་རང་ཉིད་ཀྱི་བ་སྤུའི་ཁུང་བུར་སྟོན་པར་མཛད་པ།",
    "མཁྱེན་པ་ནུས་མཐུ་ཐོགས་མེད་སོ་སོར་འདུག་འགྱུར་ལ།",
    "འཇིག་རྟེན་ཡང་རང་བཞིན་གྱི་བདག་ཉིད་དང་།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ཡང་།",
    "ལྷ་སྦྱིན་གདིང་བ་འཇམ་པོ་བཏིང་བའི་མལ་ཆ་ལ་ཉལ་ལམ་འདུག་ཀྱང་རུང་སྟེ།",
    "འདུག་གོ།",
    "བཟུང་སྟེ་མི་གཙང་རང་བཞིན་ཉིད།",
    "དེ་ནས་ཡུལ་མི་དེ་ཆུ་དེས་བྱ་བ་བྱས་ནས་སྨྱོ་བར་གྱུར་ཀྱང་རང་བཞིན་གཅིག་ཉིད་ཀྱི་ཕྱིར་ན་བདག་ཉིད་ཁོ་ན་རྣལ་མར་གནས་ལ་རྒྱལ་པོ་སྨྱོ་བར་སེམས་པར་གྱུར་ཏོ།",
    "བདག་དབྱུང་བའི་ཕྱིར་ཐབས་བཤམས་ཀྱིས་དགའ་བར་སྡོད་ཅིག་ཕྱིན་ཆད་ཁྱིམ་འདིར་མི་འདུག་གོ་ཞེས་སྨྲས་ཏེ་ཕྱིར་བྱུང་བར་གྱུར་ཏོ།",
    "སྡུག་བསྔལ་གཞན་ལྟ་ཡང་འདུག་ཤིག།",
    "སྐྱེས་བུ་འགའ་ཞིག་དུས་བྱས་པ་དང་།",
    "འགྲེང་བའི་སྡུག་བསྔལ་ཡང་འདུག་པས་ཡིན་ལ།",
    "འདུག་པའི་སྡུག་བསྔལ་ཡང་འགྲེང་བས་སོ།",
    "གལ་ཏེ་ཡང་འདུག་པའི་སྡུག་བསྔལ་གྱིས་ཡོངས་སུ་དུ་བ་སྟེ་དེ་བཏང་ནས་སྤྱོད་ལམ་གཞན་མི་རྩོམ་ན་ནི་དེའི་ཚེ་འདི་ལ་སྤྱོད་ལམ་ལས་བྱུང་བའི་སྡུག་བསྔལ་གཏན་ལྡོག་པ་སྲིད་པ་ཞིག་གོ།",
    "སྐྱེས་བུ་འགའ་ཞིག་ལ་ཆུང་མ་གཉིས་ཡོད་ཅིང་དེ་ལས་གཅིག་ནི་བུ་དང་ལྷན་ཅིག་འདུག་ལ།",
    "ཙ་ན་ཀས་གསེར་ཡོངས་སུ་དོར་བ་བཞིན་ནོ།",
    "དངོས་པོ་དང་རང་བཞིན་དང་བདག་དང་རྟག་པ་དང་བརྟན་པ་ཞེས་བྱ་བ་རྣམ་གྲངས་དག་གོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་གང་ཞིག་དུས་ལས་སྐྱེས་པ་དེ་ནི་མ་བྱུང་བ་ལས་བྱུང་བ་ཞིག་སྟེ།",
    "རྒྱུ་དང་རྐྱེན་ལ་ལྟོས་པ་མེད་པར་འགྱུར་ཞིང་རང་ཉིད་འབྱུང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནི་ཤེས་པ་ཡོད་པ་ཉིད་ཀྱང་རང་བཞིན་ཡིན་པའི་ཕྱིར་དང་།",
    "ལྷ་སྦྱིན་འདུག་གོ་ཞེས་བྱ་བ་ལ་སོགས་པ་བྱེད་པ་པོ་ལ་གནས་པ་མི་འགུལ་བའི་མཚན་ཉིད་ཅན་གྱི་བྱ་བ་དངོས་པོའི་བདག་ཉིད་ཅན་གང་ཡིན་པ་དེ་ཡང་སྔར་གྱི་བྱ་བ་བཅོམ་ནས་རྩོམ་པ་ན་སྔར་བདག་ཉིད་དེས་ལུས་བཀོད་པ་མི་སྲིད་པའི་ཕྱིར།",
    "རང་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་མ་ཡིན་པ་རང་བཞིན་མེད་ཅིང་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ་དེ་བཞིན་དུ་མཁས་པས་དཔེ་འདི་དངོས་པོ་གཞན་རྒྱུ་དང་འབྲས་བུའི་གནས་སྐབས་མི་སྣང་བ་ཆོད་པ་དང་ཕྲ་བ་རྣམས་དང་།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་གང་ཞིག་དུས་ཐམས་ཅད་ཡོད་པ་ཉིད་དུ་སྨྲ་བའི་ཕྱིར་ཐམས་ཅད་ཡོད་པའི་སྨྲ་བ་ཉིད་བསྔགས་པར་བྱེད་པ་དེ་ལ་སླར་ཡང་བརྒལ་ཞིང་བརྟག་པར་བྱ་སྟེ།",
    "གཉིས་ཀ་ཡང་རང་བཞིན་མེད་པ་ཉིད་དུ་མཚུངས་བཞིན་དུ་དེས་གཅིག་མཐོང་ལ་ཅིག་ཤོས་མ་ཡིན་ནོ་ཞེས་བྱ་བར་མི་རིགས་སོ།",
    "དེའི་ཕྱིར་དེ་ལས་གཞན་པའི་བཅོམ་ལྡན་འདས་ཀྱི་གསུང་མངོན་སུམ་མ་ཡིན་པའི་དོན་སྟོན་པར་བྱེད་པ་ཡང་རང་ཉིད་ཀྱི་ཚུལ་གྱིས་དོན་ཇི་ལྟ་བ་བཞིན་ནོ་ཞེས་བྱ་བར་རྟོགས་པར་བྱ་སྟེ།",
    "དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་བརྟག་པར་མི་ནུས་ཏེ།",
    "དངོས་པོ་གང་དག་སྐྱེ་བ་དང་ལྡན་པ་དེ་དག་ཀྱང་རྟག་པའི་ངོ་བོར་མེད་པས་རང་བཞིན་གྱི་མཚན་ཉིད་དང་མཚན་ཉིད་མི་མཐུན་པ་ཡོད་པ་ཡིན་དང་རང་བཞིན་ཡོད་པ་མ་ཡིན་པས་ཡོད་པ་དང་མེད་པའི་རྟོག་པ་དག་རྣམ་པར་གཞག་པར་མི་ནུས་སོ།",
    "དེ་ཁོ་ན་ཉིད་ཀྱང་རང་བཞིན་དང་ངོ་བོ་ཡིན་ནོ།",
    "དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་མཆོག་ཏུ་རྗེས་སུ་ཚོལ་བ་ཉིད་ནི་དེའི་ཕྱིན་ཅི་མ་ལོག་པའི་ལམ་དེ་ཡང་རང་བཞིན་མེད་པ་སྐྱེ་བ་མེད་པའི་རང་བཞིན་གྱི་ཕྱིར་སྣང་བ་མེད་པའོ་ཞེས་བྱ་སྟེ།",
    "དེ་ཡང་རང་བཞིན་ནི་དངོས་པོའི་ངོ་བོའི་ཕྱིར་དང་།",
    "འདུས་བྱས་ལ་ཡང་རང་བཞིན་མི་འཐད་དེ།",
    "འོ་ན་གཉི་ག་ཡང་རང་བཞིན་གྱིས་མ་སྐྱེས་པར་མཉམ་ལ།",
    "འོན་ཀྱང་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་ལྔ་ཆར་ཡང་རང་བཞིན་མེད་པར་བསྒྲུབ་པའི་དོན་དུའོ།",
    "དེ་སྤོང་བའི་ཐབས་ཀྱང་རང་བཞིན་ཁས་མ་བླངས་པ་ཡིན་ནོ་ཞེས་བྱ་སྟེ།",
    "གང་མི་རྟག་པ་དེ་ཡང་རང་བཞིན་མེད་པའོ་ཞེས་གསུངས་པར་འགྱུར་ཏེ།",
    "དེ་ནི་མི་རྟག་པ་དང་རང་བཞིན་ཡོད་པ་འགལ་བའི་ཕྱིར་རོ།",
    "བདག་ཏུ་འཛིན་པའི་མིང་ཅན་དེ་ཡང་རང་བཞིན་མེད་པའི་ལས་ཀྱིས་བསྐྱེད་པའི་ཕྱིར་རང་བཞིན་མེད་པའོ་ཞེས་གསལ་བར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "གང་ཡང་བདག་ཏུ་འཛིན་པ་དང་འཛིན་པའི་མཚན་ཉིད་ཅན་འདི་ཡང་རང་བཞིན་མེད་པའི་ལས་ཀྱིས་བསྐྱེད་པའི་ཕྱིར་རང་བཞིན་དང་བཅས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གང་ཡང་འདི་བདག་ཏུ་སྒྲོ་བཏགས་པས་བསྐྱེད་པའི་ངར་འཛིན་པ་དེ་ཡང་རང་བཞིན་མེད་པའི་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པའི་མཚན་ཉིད་ཅན་གྱི་རྣམ་པར་རྟོག་པས་བསྐྱེད་པའི་ཕྱིར་རང་བཞིན་མེད་པ་ཁོ་ནའོ་ཞེས་བྱ་བ་གྲུབ་བོ།",
    "གང་ཡང་རང་བཞིན་དང་བྲལ་བའི་ཕྱིར་ལས་སྟོང་པའོ་ཞེས་ཁོང་དུ་ཆུད་པ་དེ་ནི།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་མེད་པ་ཡང་རང་བཞིན་མེད་པའི་འབྲས་བུ་རྫོགས་པར་བྱེད་པ་པོ་ཉིད་དུ་གསལ་བར་བྱེད་པ་ཤིན་ཏུ་གསལ་བར་དཔེར་ཉེ་བར་བསྟན་པས་གསུངས་པ།",
    "དེ་ཡང་གང་རང་བཞིན་མེད་པ་མཐོང་བ་དེ་ནི་དོན་དམ་པ་མཐོང་ལ་ངོ་བོ་མི་དམིགས་པས་ཀྱང་དེ་ལ་མི་བདེན་པ་ལས་སྐྱེས་པ་ལ།",
    "དེ་ཡང་རང་བཞིན་མེད་པ་ཉིད་དུ་ཡོད་པས།",
    "གང་ཡང་རང་བཞིན་མེད་པ་སྟེ་དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་བཞིན་དུ་རྟོག་པ་མེད་པ།",
    "སླར་ཡང་ཅིའི་ཕྱིར་ན་འདི་དག་ཀྱང་རང་བཞིན་མེད་པ་དང་རྟོག་པ་ཙམ་དུ་ཡོད་པ་གཉིས་ཁས་ལེན་པར་བྱེད།",
    "གལ་ཏེ་སླར་ཡང་རང་བཞིན་ཡོད་པ་ཉིད་པས།",
    "གཟུགས་ནི་ཤིན་ཏུ་ཡང་རང་བཞིན་མེད་དོ།",
    "དེ་ཡང་རང་བཞིན་དུ་སྒྲོ་འདོགས་པ་ལ་ཞུགས་པའི་ཕྱིར་དང་།",
    "དེ་ཡང་རང་བཞིན་གྱིས་མི་དམིགས་པའི་ཕྱིར་མི་བརྟེན་པའོ།",
    "འདི་རྒྱུ་ལས་བྱུང་ན་ཡང་རང་ངམ་གཞན་ནམ་དེ་གཉི་ག་ལས་འགྱུར་ཞེས་བརྟག་སྟེ།",
    "སེམས་ཀྱི་རྗེས་འཇུག་དུས་དང་ནི།",
    "རང་ཁོ་ན་ལས་སྐྱེ་བའི་བདག་ཉིད་དུ་ཁས་བླངས་པ་དེར་ཡང་རང་བཞིན་མེད་མི་འབྱུང་སྟེ་ནམ་ཡང་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "དེ་དག་ཀྱང་རང་ལས་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་གཟུགས་ནི་འབྱུང་རང་བཞིན།",
    "མ་ཞུ་བ་གཉིས་ཀྱི་བར་ན་འདུག་པའམ།",
    "སྟན་གཅིག་པ་ནི་སྟན་གཅིག་ལ་འདུག་ནས་ཅི་ཙམ་ཟ་བར་བྱེད་པ་དེ་ཟ་བ་སྟེ།",
    "ཕྱིས་མི་ལེན་པ་ནི་སྟན་ལ་འདུག་སྟེ་ཅི་ཙམ་ཟ་བར་ནུས་པ་དེ་ཙམ་བྱིན་ལེན་བྱས་ནས་ཟའི་བྱིན་ལེན་མ་བྱས་པར་མི་ཟ་བའོ།",
    "འོ་ན་ཅི་ཡང་མི་སྨྲ་བར་འདུག་ཅིང་ཞེ་ན།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ཀྱི་ཕྱོགས་ལ་གལ་ཏེ་གཏན་ཚིགས་དང་།",
    "དཔེ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉིད་ལས་གྲུབ་པས་སོ།",
    "གཞན་ཡང་རང་རིག་དེ་དངོས་པོར་གྱུར་པ་ཞིག་གམ་དངོས་པོ་མ་ཡིན་པ་ཞིག།",
    "གཉིས་དུས་གཅིག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་འཇིག་པ་དང་སྐྱེ་བ་དག་དུས་མཉམ་པའི་ཕྱིར་རོ།",
    "ས་བོན་དང་མྱུ་གུ་དག་ཀྱང་དུས་མཉམ་པར་འགྱུར་ལ་ཞེས་བྱ་བ་ནི་འགག་བཞིན་པའི་ས་བོན་དང་སྐྱེ་བཞིན་པའི་མྱུ་གུ་དག་དུས་མཉམ་པར་འགྱུར་བའོ།",
    "སྐྱེ་བཞིན་པའི་མྱུ་གུ་དག་དུས་མཉམ་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "འགག་བཞིན་པའི་ས་བོན་དག་དུས་མཉམ་པ་ཉིད་རིགས་པ་མ་ཡིན་ཏེ།",
    "མྱུ་གུ་དག་དུས་གཅིག་པ་ཉིད་མ་ཡིན་གྱི།",
    "འདིའི་དོན་ནི་གལ་ཏེ་ས་བོན་དང་མྱུ་གུ་དག་ལ་རང་བཞིན་ཡོད་པར་གྱུར་ན་དེའི་ཚེ་གཅིག་པ་ཉིད་དང་ཐ་དད་པ་ཉིད་རིགས་པ་ལས་འོན་ཀྱང་རང་གཞན་ལས་སྐྱེ་བ་བཀག་པའི་རང་བཞིན་བཀག་པ་ཡིན་པས་གཅིག་དང་བདག་ཉིད་ག་ལ་སྲིད།",
    "གལ་ཏེ་དངོས་པོ་རྣམས་ལ་ཡང་རང་བཞིན་ཡོད་པར་གྱུར་ན་དེ་དུས་ཇི་སྲིད་དུ་གནས་ནས་ཕྱིས་འཇིག་པར་འགྱུར་ན་ཆད་པར་འགྱུར་བ་ཡིན་ལ།",
    "གཟུང་བར་བྱ་བའི་དོན་མེད་པས་ཤེས་པ་གང་འཛིན་པར་བྱེད་པ་ཉིད་དོན་ཐ་དད་པར་རྟོགས་པའི་མཚན་ཉིད་ཅན་མ་མཐོང་ཞིང་རང་གསལ་བ་ཙམ་དུ་ཁོང་དུ་ཆུད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདུ་བྱེད་ཀྱི་སྐད་ཅིག་དུས་གསུམ་པའི་ཉེ་བར་ལེན་པ་ཅན་ལ་བྱ་བ་ཞེས་བྱ་བ་ནི་འདུ་བྱེད་རྣམས་ཀྱི་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བའི་སྐད་ཅིག་མ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་ལེན་པ་ཅན་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཕན་ཚུན་ལྟོས་པ་ཡིན་པས་རིང་པོ་དང་ཐུང་ངུ་དག་བཞིན་དུ་ཤེས་པ་དང་ཤེས་བྱ་དག་ཀྱང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བཅོམ་ལྡན་འདས་ཁྱེད་ཀྱིས་གསུངས་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "མེ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཅི་ལྟར་མེ་དེ་དང་མེ་དེའི་རྒྱུ་ཅན་གྱི་དུ་བ་མངོན་སུམ་གྱིས་གྲུབ་པ་དེ་བཞིན་དུ་གལ་ཏེ་རང་རིག་པ་གྲུབ་པར་གྱུར་ན་དེའི་ཚེ་དེའི་རྒྱུ་ཅན་གྱི་དྲན་པ་འགྲུབ་པར་འགྱུར་བ་ལས་འོན་ཀྱང་རང་རིག་པ་ཉིད་མ་གྲུབ་པས་དེའི་རྒྱུ་ཅན་གྱི་དྲན་པ་ཡང་མ་གྲུབ་པའི་ཕྱིར་དྲན་པའི་སྒོ་ནས་རང་རིག་ཅི་ལྟར་རྗེས་སུ་དཔོག་པར་བྱེད་ཅེས་པའོ།",
    "གལ་ཏེ་ཤེས་པ་རྣམས་སྐད་ཅིག་མ་ཡིན་པ་དང་རང་རིག་མེད་པས་ངས་མཐོང་ངོ་སྙམ་དུ་ཇི་ལྟར་དྲན་ཞེ་ན།",
    "རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ལྟ་བུ་འདུག་ཤིག་ཅེས་བྱ་བ་ནི་རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་མི་བྱའོ་ཞེས་པའོ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་བཞིན་ཡོད་པར་ཁས་མི་ལེན་པས་སོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་བྱེད་པ་པོ་དེས་ལས་གང་ཅུང་ཟད་བྱེད་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཡིན་ཏེ།",
    "རང་བཞིན་སྐྱེ་བ་ནི་མ་ཡིན་ཏེ་ཕྱོགས་གཉིས་ཆར་ཡང་རང་བཞིན་སྐྱེ་བར་འགེགས་པར་འདོད་པས་སོ།",
    "གང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་གལ་ཏེ་སྔོན་གྱི་བདག་ལས་བདག་འདི་གཞན་ཉིད་ཡིན་པར་གྱུར་ན་ནི་དེའི་ཚེ་གཞན་ཡིན་པའི་ཕྱིར་བུམ་པ་སྐྱེས་ནས་སྣམ་བུ་མ་ཞིག་པ་བཞིན་དུ་ཕྱིས་ཀྱི་བདག་སྐྱེ་ཙ་ན་སྔར་གྱི་བདག་འགག་པར་ཡང་མི་འགྱུར་ལ།",
    "བྱེད་པ་པོ་དང་རང་བཞིན་དུ་གྱུར་པ་བཀག་པ་ཤེས་པར་བྱ་བའི་ཞེས་བྱ་བ་ནི་བཅོས་མ་མ་ཡིན་པ་གཞན་ལ་མི་ལྟོས་པ་བྱེད་པ་པོ་བཀག་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "རྒྱུ་དང་འབྲས་བུ་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་གང་ཡང་རང་བཞིན་གྱིས་རྒྱུ་ཉིད་དུ་ཡོད་པའམ་འབྲས་བུ་ཉིད་དུ་ཡོད་པ་ཡིན་ནོ་ཞེས་པའི་རྒྱུ་དང་འབྲས་བུའི་རང་བཞིན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་རང་རྒྱུད་པ་ལ་སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཉིས་ཀ་ལ་གྲགས་པའི་དཔེ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་མེད་པ་དང་རང་བཞིན་དང་བཅས་པར་སྨྲ་བ་དག་ལ་གྲགས་པའི་དཔེས་རང་བཞིན་དང་བཅས་པའི་དཔེ་མེད་པས་སོ།",
    "གལ་ཏེ་མ་སྐྱེས་པའི་སྔ་རོལ་དུ་དངོས་པོ་འགའ་ཞིག་ལ་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ཏེ།",
    "བྱས་པ་དང་རང་བཞིན་དག་ནི་ཕན་ཚུན་འགལ་བའི་ཕྱིར་མི་རིགས་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་རྒྱུ་དང་རྐྱེན་དག་ལས།",
    "ཞེས་བྱ་བ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་བ་དག་ལའོ།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ཇི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག།",
    "རྐང་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
    "མི་གཙང་རང་བཞིན་གཞན་གྱི་ལུས།",
    "ལུང་གཞན་ལ་ཡང་རང་གཞན་དག།",
    "གནས་པ་མ་ཡིན་འགྲོ་མ་ཡིན།",
    "འདུག་ཀྱང་རུང་།",
    "འདུག་པ་དང་།",
    "བྱི་དོར་བྱས་པ་ནི་རོ་ཙ་ན་ལ་སོགས་པའི་ནོར་བུས་ཕྱི་བདར་བྱས་པའོ།",
    "རྫོད་ལ་བརྟེན་ནས་གལ་ཏེ་འདུག་ན་བདག་ལ་ག་ལ་བདེ།",
    "མདུན་ན་འདུག་པའི་ཕྱིར་མངོན་སུམ་དུ་སྒྲོས་བཏགས་ན་འདི་ཞེས་བསྟན་ཏོ།",
    "འདུག་ན་བདག་འདུག་གོ་སྙམ་དུ་རབ་ཏུ་ཤེས་སོ།",
    "འདུག་པ་དང་།",
    "དངོས་པོ་ཐམས་ཅད་ལྟར་བདག་ཀྱང་དེ་རྣམས་ཀྱི་སྤྱན་སྔ་ན་འདུག་པ་ཉིད་ཡིན་ནོ་ཞེས་ཡིད་ལ་བཞག་ལ།",
    "ལུས་ཀྱིས་འདི་ལྟར་ཞེས་བྱ་བ་ནི་འགྲེང་བས་སམ་འདུག་པས་གནས་པར་བྱ་སྟེ།",
