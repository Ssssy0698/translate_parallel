    "དེ་ཕྱིར་ཁྱོད་གཅིག་རྒྱལ་བ་ཀུན་གྱི་སྤྱི་གཟུགས་ལགས་སོ་ཀློང་ཆེན་ཞབས།",
    "ངོ་བོ་ཉིད་གཟིགས་མཁའ་ལྟར་རྣམ་མི་རྟོག།",
    "བསམ་ཡས་བློ་མངའ་རྒྱལ་སྲས་ཐུ་བོ་བསམ་ཡས་པ་ཞེས་གྲགས་ཁྱོད་རྒྱལ།",
    "མ་འདྲེས་བློ་གྲོས་དྲི་མ་མེད་བརྙེས་ཇི་བཞིན་གཟིགས་པའི་རྗེས་འགྲོ་བ།",
    "རྣམ་པར་རྒྱལ་བའི་རྒྱལ་བ་ཁྱོད་ལ་འདུད།",
    "བརྩོན་དང་ཏིང་འཛིན་རབ་ཏུ་དགའ་སོགས་ཀུན་ནས་ཉོན་མོངས་འཇོམ་བྱེད་ཕུལ།",
    "མི་འཁྲུགས་ཟབ་མོའི་ཕ་རོལ་སོན་པའི་བཟོད་ཆེན་རྒྱ་མཚོ་གཏིང་ཟབ་ལས།",
    "བསམ་གཏན་མཆོག་གི་རིན་ཆེན་ལྷུན་པོ་ཡོན་ཏན་ལྷ་གནས་འབྱོར་བ་ཅན།",
    "ཤེས་བྱ་ཀུན་གཟིགས་བློ་གྲོས་མཆོག་ལྡན་རྒྱལ།",
    "སོ་སོ་རང་རིག་བློ་གྲོས་མཆོག་གི་ཕ་རོལ་ཕྱིན་ནས་མངོན་སུམ་ཡང་།",
    "ཀུན་ནས་ཉོན་མོངས་བག་ལ་ཉལ་ཀུན་ལན་བརྒྱར་གཅོད་བྱེད་ཆེས་རྣོ་བའི།",
    "ཤེས་བྱའི་དྲི་མ་ཤིན་ཏུ་ཕྲ་བ་གང་གིས་བཅད་ནས་གཏོར་གྱུར་པས།",
    "དེ་ཡི་མོད་ལ་ཡེ་ཤེས་རྒྱ་མཚོའི་ཕ་རོལ་ཕྱིན་ལ་རབ་འཇུག་པའི།",
    "རྒྱལ་སྲས་ཐུ་བོ་ཟུར་ཕུད་ལྔ་པ་མངོན་སུམ་བཤེས་གཉེན་ཚུལ་བཟུང་ཁྱོད།",
    "ས་ལམ་ཡོན་ཏན་རྩེ་མོར་སོན་གྱུར་གདོད་མའི་མགོན་དང་མཚོ་སྐྱེས་རྗེའི།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་གངས་ཆེན་མཚོ་ནི་ནམ་མཁའི་མུ་ཁྱུད་ལས་ཀྱང་བརྒལ།",
    "དེ་ཕྱིར་ཁྱོད་གཅིག་བསམ་ཡས་པ་ཞེས་གྲགས་པ་དོན་ལྡན་ཀློང་ཆེན་ཞབས།",
    "བསམ་བཞིན་བསྟན་པའི་མངའ་བདག་ཁྱོད་ཁོ་ནའི།",
    "སྤེལ་མཁས་ཁྱོད་གཅིག་བསིལ་ལྡན་ལྗོངས་ཀྱི་ཤིང་རྟ་ཆེན་པོར་བསྙོན་དང་བྲལ།",
    "མང་ཐོས་རྒྱ་མཚོའི་ཐུ་བོ་ཁྱོད།",
    "དབྱིག་གི་གཉེན་དང་སོམ་ཉིར་གྱུར།",
    "ཁྱོད་བློའི་དོ་ཟླར་བཟོད་པ་མིན་ཞེས་ཕྱོགས་ཀྱི་གླང་པོའི་སྤོབས་པའི་མཐུ།",
    "ཇི་ལྟ་ཇི་སྙེད་མ་འདྲེས་མངོན་སུམ་གཟིགས།",
    "སྨྲ་མཁས་བྱེ་བའི་གཙུག་གི་རྒྱན་གཅིག་འཛམ་གླིང་ལྗོངས་ན་མཛེས་པའི་རྒྱན།",
    "ཞབས་ཁྱོད་རྣམ་གསུམ་དད་པས་གཙུག་ཏུ་བཀུར།",
    "རྟོགས་གྲོལ་དུས་མཉམ་གོ་འཕང་ལ་སྦྱོར་རྒྱལ་བ་གཉིས་པ་ཁྱོད་མིན་སུ།",
    "རྒྱས་མཛད་བསྟན་པའི་སྒྲོན་མེ་ཁྱོད་ལ་འདུད།",
    "ཅིར་ཡང་འབེབ་མཁས་གདེངས་ཅན་གཙོ་བོ་ཁྱོད་མིན་སུ།",
    "ཀུན་གྱིས་རྟོགས་དཀའ་མཆོག་གསང་རྨད་བྱུང་རྡོ་རྗེ་རྩེ་མོའི་སྙན་བརྒྱུད་གསེར་གྱི་ཡང་ཞུན་བཅུད།",
    "ས་འདི་རེར་བཅས་སྲང་ལ་གཞལ་བའི་གྲངས།",
    "མཛེས་པ་མེད་ཀྱང་ལྷག་བསམ་འོ་མས་ཉེ་བར་དྲངས་ནས་ཁྱོད་ཀྱི་མདུན་སར་ལན་བརྒྱར་ཡང་།",
    "གང་ཞིག་ཐོབ་དེས་སྲིད་གསུམ་འགྲོ་བློའི་ཉོན་མོངས་མེ་ཚོགས་ཞི་བྱེད་ཅིང་།",
    "མཐར་ཐུག་ཁྱོད་ཀྱི་ཐུགས་ཀློང་རོ་གཅིག་ཤོག།",
    "བླ་ན་མེད་པའི་གསུང་གི་བདུད་རྩིས་ཡོངས་སུ་སྐྱོང་བའི་སྐལ་བཟང་ཐོབ་དང་ལྷན་ཅིག་པར།",
    "བདག་མཐོང་ཐོས་དང་དྲན་རེག་འགྲོ་བ་རྣམས།",
    "ཐམས་ཅད་བདག་གི་གདུལ་བྱ་ཉིད་གྱུར་ཏེ།",
    "ན་མོ་གུ་རུ་བྷྱ།",
    "ངག་ལ་ངག་གི་དཔལ་སྟེར་སྨྲ་བའི་ལྷ།",
    "ལྔ་རིག་ཀུན་མཁྱེན་བུདྡྷའི་མཚན་ཅན་སོགས།",
    "དོན་གྱི་འོད་གསལ་མ་བུ་འདྲེས་པའི་མོད།",
    "འཁྲུལ་རྟོག་ཉོན་མོངས་ཧྲལ་བོར་གྱུར་ལ་འདུད།",
    "ཁྱོད་ཞབས་སེན་མོའི་གེ་སར་སྤྱི་བོས་མཆོད།",
    "ཐུན་མོང་ལམ་གྱི་ཡོན་ཏན་ཡོངས་སུ་རྫོགས།",
    "ཕྱོགས་རེའི་ལྟ་གྲུབ་ལ་ཞེན་རྟོག་གེའི་ཁྱུ།",
    "ལེགས་འདོམས་རྒྱལ་བ་གཉིས་པ་ཁྱོད་ཁོ་ན།",
    "ཁྱོད་ཀྱི་གསང་གསུམ་སྣོད་དུ་ཡོངས་འདུ་བས།",
    "ཡོན་ཏན་རྒྱ་མཚོའི་གཏེར་གྱུར་ཁྱོད་མཚུངས་གཞན།",
    "དེ་སླད་དམ་པའི་ཡོན་ཏན་ཀུན་གསལ་ཁྱོན།",
    "ཚུལ་འདི་མོས་ལྡན་རེ་བསྐང་སླད།",
    "རྣམ་འབྱེད་ཁྱོད་བློའི་ཉི་མ་ནི།",
    "ཉོན་མོངས་གདུང་སེལ་མཛད་ལ་འདུད།",
    "ཁྱོད་ཀྱི་ཞལ་ལས་ཉེར་འོངས་པའི།",
    "ཁྱོད་ཐུགས་ཡངས་པའི་གོ་སྐབས་ལ།",
    "ཕྲ་མོའང་གང་དུ་ཤོང་བ་མིན།",
    "རྗེས་འགྲོ་ཁྱོད་ཐུགས་བསམ་མི་ཁྱབ།",
    "ཕལ་ཆེར་ཕྱོགས་རེའི་གཞུང་ལུགས་ཏེ།",
    "ཡེ་ཤེས་གཟིགས་པའི་སྤྱོད་ཡུལ་ཉིད།",
    "སྤྱོད་ཡུལ་མིན་ཞེས་ཁྱོད་ཀྱིས་བསྟན།",
    "བགོས་པའི་རྙོག་མ་ཁྱོད་ཀྱིས་བསལ།",
    "གང་གིས་མི་ཤིགས་གོ་ཆ་ཅན།",
    "དགྲ་དང་ཉོན་མོངས་ཉེར་ཞི་བའི།",
    "གུས་བཅས་སོར་མོའི་འདབ་ཕྲེང་ལས།",
    "གང་འདོད་འཇོ་བའི་དྲི་བསུང་གིས།",
    "གདུལ་བྱའི་བུང་བ་སྡུད་ཁྱོད་བསྔགས།",
    "སྙན་སྒྲོག་གང་གིས་སྐལ་བཟང་ཡིད།",
    "ཐུན་མོང་ལམ་གྱི་རིམ་པ་ཀུན།",
    "ཁྱོད་ཀྱི་གསང་གསུམ་ཡོན་ཏན་གྱི།",
    "གཅིག་ཏུ་བསྡོམས་ཏེ་ཁྱོད་བསྔགས་ཀྱང་།",
    "བདག་བློ་ཉི་ཚེས་ཕྱོགས་རེའི་མཐའ།",
    "ནམ་ཞིག་ཁྱོད་ཀྱི་གདུལ་བྱར་འགྱུར།",
    "སྒྲིབ་གཉིས་མུན་པའི་དཔུང་ཚོགས་ཕམ་མཛད་ཅིང་།",
    "སྲིད་ཞིའི་དགེ་ལེགས་ཉིན་མོར་བྱེད་དེར་འདུད།",
    "ལེགས་པར་སྨྲ་བའི་རྒྱལ་པོ་ཁྱོད་ལ་དད་བརྒྱས་བསྔགས་པའི་མེ་ཏོག་འཐོར།",
    "སྙིགས་མའི་མཐར་ཡང་རྒྱལ་བའི་འཕྲིན་ལས་ཆུད་མི་གསོན་པའི་བྱེད་པོ་ཁྱོད།",
    "མཁས་དང་གྲུབ་པའི་འཁོར་ལོའི་སྒྱུར་ཞེས་གཅམ་བུ་མིན་པའི་ངག་གིས་བསྟོད།",
    "བདུད་དང་བགེགས་སོགས་མ་རུང་སྡང་ལྡན་དེ་དག་ཀྱང་ནི་ཁྱོད་ཀྱི་ཞལ།",
    "ལན་དང་རྣམ་སྨིན་བདག་གིར་འཛིན་བློ་གཞར་ཡང་ཉེ་བར་མི་གནས་ཤིང་།",
    "སྦྱིན་ལ་རབ་དགྱེས་འཕགས་མཆོག་ཁྱོད་ལ་རྣམ་གསུམ་དད་པས་རྟག་ཏུ་འདུད།",
    "ཁྱོད་འདྲ་སྲིད་འདིར་སྲིད་པའི་སྐྱོན་བྲལ་སྐྱེ་དགུའི་བཤེས་སུ་གྱུར་པ་ལགས།",
    "ཕུལ་བྱུང་གང་གིས་ནམ་མཁའི་མཐའ་དང་སྲིད་པའི་ལས་ཉོན་མཐའ་དེ་སྲིད།",
    "འགའ་ཡང་སྲིད་མིན་སྡང་ཞེན་མ་ཡིན་མོད་ལ་ཟ་བའི་སྤོབས་པ་ཅན།",
    "འཇམ་དཔལ་གཞོན་ནུའི་ཐུགས་ཀྱི་མཛོད་གཏོལ་ཁྱོད་ལ་བྱིན་སྙམ་འཕྱང་མོ་ཉུག།",
    "ཇི་བཞིན་མི་གཡོ་ཡེ་ཤེས་གཟིགས་པས་ཡེ་མཉམ་ཕྱམ་གདལ་ཆེན་པོ་རུ།",
    "རང་བཞིན་འདི་ཞེས་བསམ་པར་མི་ནུས་ཁྱོད་ཀྱི་གསང་བ་འདི་རེ་ཟབ།",
    "གསུང་གི་དབྱིངས་སུ་འདུ་འབྲལ་མེད་བརྙེས་རྒྱལ་ཀུན་གསུང་གི་རྡོ་རྗེ་ཞེས།",
    "བསྟན་པ་རྒྱ་མཚོའི་མགོན་དུ་ཕེབས་པ་ཁྱོད་གཅིག་ཁོ་ནར་ངེས་པ་རྙེད།",
    "དོན་ཀུན་གྲུབ་པའི་མཚན་གྱི་རོལ་མོས་ཞིང་མང་མཐའ་ཡས་མཛེས་བྱས་གང་།",
    "ལུས་ཅན་ཡོངས་སྒྲོལ་བདེན་གསུང་ལུང་གི་རྔ་ཆེན་གསལ་བར་བསྒྲགས་པའི་དོན།",
    "མཁྱེན་རབ་མཆོག་གི་བུམ་པ་བཟང་པོ་ཟག་བྲལ་ཡོན་ཏན་བཅུད་ཀྱིས་གཏམས།",
    "མཁྱེན་བཟང་ཉི་ཟླ་མཆོག་ཏུ་གསལ་བས་སྐྱེ་དགུའི་ནང་གི་མུན་པ་སེལ།",
    "མཚུངས་མེད་བཤེས་གཉེན་ལྷ་བརྒྱའི་མགོན་ཁྱོད་དེང་བདག་དྲན་པས་ཐལ་མོ་ཟུམ།",
    "སྣང་བ་དེ་ལྟར་བདག་བློས་ཉེས་མོད་ཁྱོད་ཀྱི་རང་བཞིན་འཕོ་འགྱུར་བྲལ།",
    "དམ་པའི་ངང་ཚུལ་མ་ལ་ཡར་འཁྲུངས་རྐང་འཐུང་མཆོག་གི་རྗེས་འགྲོ་བ།",
    "གཅིག་ཏུ་གུས་པས་དད་བརྒྱའི་ཐལ་མོ་སྤྱི་བོར་ཟུམ་བཞིན་ལན་བརྒྱར་འདུད།",
    "ནམ་ཞིག་མགོན་པོ་ཡེ་ཤེས་སྒྲིབ་མེད་རྒྱལ་བ་མཆོག་གི་མཚན་དཔེའི་སྐུ།",
    "བདག་གི་ལུས་དང་ངག་དང་ཡིད་ཀྱིས་བརྩམས་པ་ཇི་སྙེད་དེ་ཀུན་ཀྱང་།",
    "བགྱི་བ་ཕྲ་མོའང་ནམ་ཡང་མི་འབྱུང་རྟག་ཏུ་གཞན་ལ་ཕན་བརྩོན་པ།",
    "ལེགས་པར་བསྟར་བའི་བསྟོད་དབྱངས་རྒྱ་མཚོའི་རིན་ཆེན་མཆོག་གི་འཕྱང་འཕྲུལ་འདིས།",
    "དད་བརྒྱའི་བློ་མིག་ཤིན་ཏུ་གསལ་ལྡན་སྐལ་བཟང་ཚོགས་རྣམས་དགྱེས་པར་མཛོད།",
    "གང་གིས་བརྙེས་པ་དེ་ལ་འདུད།",
    "ཁྱོད་ཐུགས་ཟབ་ཡངས་ནམ་མཁའི་ཀློང་།",
    "གཞོན་ནུའི་དུས་ནས་ཟབ་མོའི་དོན།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་གཏེར་མཐོང་ནས།",
    "ཐུན་མོང་རིག་གཞུང་ཀུནྡའི་ཚལ།",
    "ཁྱོད་བློའི་ཟླ་ཟེར་གྱིས་ཕྱེ་ནས།",
    "བློ་གསལ་ཚིམ་མཛད་ཁྱོད་ལ་འདུད།",
    "ལེགས་པར་གསན་པའི་མོད་ཉིད་ནས།",
    "དེ་ལྟར་ན་ཡང་གང་གི་སྤྱོད།",
    "སྤྲོ་བསྡུའི་བྱེད་པོ་ཁྱོད་ཉིད་ཀྱང་།",
    "འབད་པའི་ཚུལ་འདི་ཐབས་རེ་ཟབ།",
    "ལེགས་གསུང་ཇི་བཞིན་ཁྱོད་ཀྱིས་བཤད།",
    "ཕལ་ཆེར་ཕྱོགས་རེའི་མིག་ཅན་ཏེ།",
    "རྣམ་པར་འཁྱམས་ཞེས་ཁྱོད་ཀྱིས་བསྟན།",
    "ཁྱོད་ཀྱིས་གང་བཞེད་ཟབ་མོའི་དོན།",
    "དེ་ཕྱིར་ཁྱོད་གསུང་དྲི་མ་མེད།",
    "འགྲོ་བའི་མུན་སེལ་ཁྱོད་ལ་འདུད།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་བསུང་ཞིམ་ལ།",
    "གྲགས་པ་མཐའ་ཡས་ཁྱོད་ལ་འདུད།",
    "ཁྱོད་ཐུགས་དྲི་མེད་ནམ་མཁའ་བཞིན།",
    "ཁྱོད་ཀྱི་གསུང་གསང་ལྷའི་རོལ་མོ།",
    "ཁྱོད་སྐུ་དྲི་མེད་ལྷའི་ཟླ་བ།",
    "མ་ལུས་གང་གི་སྣོད་དུ་གྱུར།",
    "ཕྱོགས་ལྷུང་མི་མངའ་ཁྱོད་ལ་འདུད།",
    "ཁྱོད་བྱིན་ཉིན་བྱེད་འཆར་ཁའི་ཟེར།",
    "དམ་པའི་ངང་ཚུལ་འདི་རེ་རྨད།",
    "ཁྱོད་འདྲ་དག་པའི་ཕུལ་དུ་གྲུབ།",
    "ཁྱོད་ཀྱི་མཁྱེན་རབ་མཆོག་ཏུ་བསྔགས།",
    "ཁྱོད་སྐུ་མཚུངས་པའི་གཟི་བྱིན་འབར།",
    "རྒྱུ་སྐར་དག་གི་རྗེས་སུ་བསྙེགས།",
    "ཁྱོད་ཀྱི་བློ་གྲོས་ཉི་ཟེར་གྱིས།",
    "ཁྱོད་མཛད་ཟླ་ཟེར་འབུམ་གྱིས་སོ།",
    "ཁྱོད་བྱིན་རྩེ་མོ་བརྒྱ་བས་སོ།",
    "དམ་པའི་ཐུགས་རྗེ་ཉིན་མོའི་དཔལ།",
    "རང་གི་ཡེ་ཤེས་དག་བྱེད་རྒྱུན།",
    "རིན་ཐང་ཆེན་པོར་བྱས་པ་ཁྱོད་ཀྱི་དྲིན།",
    "གདེངས་ཀས་བསྒྲིབས་པའི་མོད་ལ་གངས་རིའི་ཁྲོད།",
    "ཚངས་པའི་མེ་ཏོག་གསར་པའི་དྲིན་ལས་སོ། ། དབེན་པའི་ཡོན་ཏན་ལ་བསྔགས་པ་ལྷའི་རོལ་མོ།",
    "མཆིལ་མའི་ཐལ་བ་བཞིན་ཏུ་རབ་སྤངས་ནས།",
    "སྙན་ཚིག་ལྷ་ཡི་རོལ་མོ་རྣ་བའི་བཅུད།",
    "རྩོད་དང་ཉོན་མོངས་འདུ་འཛིའི་རྐྱེན་བྲལ་ཞིང་།",
    "ཆུ་བུར་མིག་གིས་ལྟ་བར་མི་བཟོད་པའི།",
    "ཚུལ་མིན་བགྲོད་པ་ངང་གིས་སྲུང་བ་ཡོད།",
    "མིག་ལ་ཡ་མཚན་ལྟད་མོ་སྦྱིན་པ་ཡོད།",
    "རབ་དཀར་གོས་བཟང་བླ་རེ་བྲེས་པ་བཞིན།",
    "རེག་ན་བདེ་བའི་བསིལ་བ་སྟེར་བ་དང་།",
    "རྣམ་གསལ་གློག་གི་སྒྲོན་མེ་འདེགས་པའི་ཚེ།",
    "མཚན་མོའི་དུས་ཀྱང་ཉིན་དཔལ་བཞིན་དུ་བྱེད།",
    "རྐང་འཐུང་ལང་ཚོས་རྒྱགས་པའི་སྙེམས་དང་བཅས།",
    "རེག་ན་བདེ་བའི་དཔལ་སྟེར་མཚོ་སྐྱེས་ཚལ།"
  ]
