    "དེས་ན་སྤྲུལ་པའི་སྐུ་ཁྱེད་རང་ལྷ་སར་ཕེབས་དུས་དགུན་ཁ་པོ་ཏ་ལ་དང་དབྱར་ཁ་ནོར་བུ་གླིང་ཁར་བཞུགས་ན་སྤྲོ་པོ་ཡོད།",
    "གཡུ་འབྲུག་ལགས་སུ་དཔེ་མི་སྲིད་པའི་ཐུགས་གདེང་དགྱེས་ཚོར་དང་།",
    "འཕན་པོ་སྣ་མར་རྟ་ར་ཟེར་བ་དེ་ནས་ཡིན་པའི་ཕོ་གསར་གཅིག་འདུག་ཁོ་པས་ཕར་ཚུར་བྲོས་ཏེ་རྩྭ་ཁང་དང་།",
    "ལམ་སང་གཱའུ་འབྲལ་སྤང་དེ་བཤུས་ཤོག་ཟེར་མཚོན་འགོག་སྲུང་བ་དེ་ཚོ་བཤུས་ཏེ་ཕར་ཙམ་དེར་བཞག་ནས།",
    "སྔོན་མ་ཡིན་ན་རི་དེར་དབྱར་དགུན་གཉིས་ལ་རྒྱུན་མཐུད་དེ་གངས་ཆགས་ཡོང་ཟེར་སྲོལ་འདུག་དེ་ནས་མར་གཤམ་ལའང་ཤུག་རི་དང་།",
    "སུས་ཁྱེད་ཚོར་དམག་རྒྱོབས་ཤོག་དམག་མི་གསོད་ཤོག་ཟེར་གྱི་འདུག་ཅེས་དྲིས་བྱུང་ན།",
    "ཁྱེད་རང་སུ་ཡིན་ནམ་བཀའ་འདྲི་གནང་དུས།",
    "ཁོ་ཚོས་རུབ་རུབ་བཟོ་མ་ཐུབ་ན་ཁོས་རྫུན་ཤོད་ཀྱི་འདུག་སང་ཉིན་ནས་བཟུང་ལྷ་བརྫུས་ཁོག་བརླམ་གྱིས་མི་གཞན་མགོ་བསྐོར་བཏང་མི་ཆོག་ཅེས་བཀས་བཅད།",
    "རྟ་དེའི་འགྲོས་ལ་ཆ་བཞག་ནའང་དཔེ་མི་སྲིད་པའི་ཡག་པོ་ཡོད།",
    "རྟ་ཟག་པ་འཁྲིད་རྒྱུ་ཡོད་པ་ཞིག་སླེབས་འདུག་ཟེར་བ་ཁྱེད་རང་ཡིན་པས་གསུངས་བྱུང་།",
    "ང་རང་ཡང་བླ་བྲང་ལ་མགོ་འབུལ་ལུས་འབུལ་ཞུ་རྒྱུ་ཡིན།",
    "ཁྱེད་རང་གང་འདོད་གྱིས།",
    "ཆིབས་གསོའི་རུ་བ་དེ་རྣམས་བླ་བྲང་རང་ལ་མུ་མཐུད་ཐུགས་ཉར་གནང་དགོས།",
    "དཔེ་མི་སྲིད་པའི་སྡང་ཟུག་དང་རྡུག་པོ་ཞེ་དྲག་བཏང་།",
    "བོད་ནང་ཇ་རིལ་གྱི་རིན་གོང་འཕར་ཁ་མཐོ་པོ་བྱུང་གཤིས་ལྷ་ས་བ་ཚོས་མིང་ཆད་འདི་ལྟར་བཟོས་འདུག་ཇ་ལ་སྲང་གང་བྱེད་ཀྱིས།",
    "ག་ཚོད་ཚ་ཡི་མི་འདུག་གམ།",
    "ཟེར་བ་དེ་འདྲ་ཞིག་བཏང་འདུག་ཟེར།",
    "ཁྱེད་རང་ལ་ལམ་རྒྱུས་ཡོད་པས་གསུངས་བྱུང་།",
    "སྐུ་གཟུགས་དཔེ་མི་སྲིད་པའི་ཐང་པོ་ཡོད་པ་དང་།",
    "ཡིན་ནའང་སྐུ་གེགས་ཀྱི་རྣམ་པ་འདྲ་པོ་ཞིག་བྱུང་འདུག་པ་ནི།",
    "དེའི་སྐབས་སྐུ་མཚམས་གནང་ནས་མི་སུ་གང་དང་མ་འཕྲད་པར་ལོ་གསུམ་ཕྱོགས་གསུམ་ཞིག་གནང་དགོས་ཀྱི་འདུག་དེ་ལྟར་གནང་ན་བར་ཆད་ཀྱང་བཟློག་ཡོང་།",
    "བཟློག་ཏུ་མེད་པའི་འཚུབ་ལྷོང་ཞིག་ཡོད་ན་ཞབས་བརྟན་གནང་དགོས་རྣམ་གྲངས་མང་པོ་ཞིག་ཚུར་བཀའ་ལན་གནང་བ་སོགས་བྱུང་འདུག་རྗེས་མ་མཁར་སྙུང་གཉིས་དང་།",
    "གཟིམ་ཆུང་ནང་ནས་ཕེབས་ལམ་བཞུགས་གདན་འབོལ་གདན་ཆ་གཉིས་ཀྱི་འོག་ནས་གནམ་སྒོ་བཅོས་ཏེ་ཕྱི་རོལ་ལ་ཕེབས་ས་བཟོས་འདུག་ཟེར།",
    "ཤོད་ལ་བབས་བྱས་སྒོ་རྒྱ་ཐེལ་གནོན་བྱེད་དགོས་དུས་གྲ་འགྲིག་ཐབས་མི་འདུག་ཤོད་དེར་དྲུང་འཁོར་གཅིག་བཞུགས་འདུག་དེ་ལ་ངས།",
    "གཡུ་ཐོག་ཟམ་པའི་འོག་ལ་མི་ཁ་ཤས་བསད་བཞག་འདུག་དེ་ནས་ལམ་སང་རྩེ་ལ་ཕྱིན་པ་ཡིན།",
    "ཨུ་རུ་སུས་དེང་སང་ཤོད་ཀྱི་མི་འདུག་གམ།",
    "ཡིན་ནའང་རང་ངོས་ནས་གོ་རྟོགས་བྱུང་བར་གཞིགས་ན།",
    "སྐུ་ལུས་ཀྱི་གནས་གཞན་ཞིག་ལ་སྨུག་ཐིག་ཏོག་ཙམ་ཆགས་འདུག་ཟེར་བ་ཞིག་གོ་ཐོས་བྱུང་།",
    "མ་གཞི་ངས་ཁོང་གཉིས་ཡར་སླེབས་སྟངས་བརྒྱུད་རིམ་དེ་ད་ཆ་དྲན་གསོས་པོ་ཞིག་མི་འདུག་གང་ལྟར་བཙོན་སྲུང་ནང་མ་དེ་ལ་ལུང་ཤར་སྲས་བགྲེས་པ་སྤོར་ཀློག་དང་།",
    "བྱས་ཙང་ཁྱེད་རང་ཧོར་སྤྱིའི་ལས་བྱ་སེར་སྐྱ་གཉིས་པོ་ཡར་རྒྱལ་ཁབ་ལ་བཅར་མི་དགོས།",
    "ཡ་ནས་མར་ཉེ་རོའི་ཕུ་སྟག་རི་ཟེར་ས་དེའི་ཕུ་ནས་མར་བང་རིམ་བྱས་ཏེ་མཚོ་རིམ་པ་གསུམ་ཙམ་མུ་སྦྲེལ་ཏེ་ཁ་རལ་འདུག་ཟེར་གྱི་འདུག་གང་བྱས་མཚོ་རིགས་གསུམ་མགོན་པོའི་རྣམ་པར་ཆགས་ཏེ་དཔེར་ན།",
    "རྭ་སྒྲེང་རང་ཡིན་པ་ཡོད།",
    "མེ་མདའ་དེ་དག་བློས་འཁེལ་པོ་ཞིག་བྱུང་མི་འདུག་ཕན་ཐོགས་ཡོང་བ་མི་འདུག་ཅེས་ཕྱིར་སློག་བཏང་ལུགས་གསན་ཐོས་དེ་ལྟར་ཡིན་མིན་དྲི་བ་གནང་ཐད།",
    "སྤྱིར་བཏང་རས་ཆ་འཐག་རྒྱུ་ཟེར་བ་དེ་ཚོ་ལས་སླ་པོ་ཞེ་དྲག་འདུག་གང་ལགས་ཞུས་ན།",
    "ཀ་ཤོད་པ་ཁོང་རང་རྣམ་ཀུན་དབུ་བདེ་པོ་ཞིག་ཡིན་ཙང་དེ་འདྲ་གནང་བ་མིན་ནམ།",
    "སྤྱིར་བཏང་སྐུ་ངོ་ཀ་ཤོད་པ་ཁོང་རང་ཐུགས་གཤིས་གནས་བབས་བཟང་པོ་ཞིག་ཡོད།",
    "གནས་ཚུལ་དེ་འདྲ་ཞིག་ཕྱི་ལོགས་ནས་ཟེར་གྱི་འདུག་སྐད་ཆ་དེ་ཏན་ཏན་ཁོ་བོས་གོ་མྱོང་།",
    "དེ་མུར་བོད་དུ་རྒྱ་མིས་བཙན་འཛུལ་དྲག་གནོན་ཛ་དྲག་དུས་ཟིང་ཆེད་བསླངས་རང་གཞན་ཀུན་ལ་བཟོད་བདེ་བག་ཕེབས་མ་བྱུང་སྟབས་༧སྐྱབས་མགོན་རྒྱལ་བའི་ཕེབས་རྗེས་སུ་འབྲངས་ཏེ་རྒྱ་གར་དུ་བཙན་བྱོལ་ལ་ཕེབས་དགོས་བྱུང་གཤིས།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "ཆག་ཅེས་པའི་འགྱུར་མཆན་འདུག་ཅེས་པ་དང་།",
    "རྟོག་པ་ཞེས་འདུག་པ་དེ་འཐད་དམ་སྙམ།",
    "འདུག་པ་དེའི་དོན་གསལ་བར་སྣང་བ་ཡིན་ཡང་སྐབས་ཐོབ་རྟོགས་ཞེས་མིན་ནམ་སྙམ།",
    "ཤློཀ་འདི་བོད་འགྱུར་དུ་མི་འདུག་ཀྱང་རྒྱ་དཔེར།",
    "དུག་ལྔ་རང་བྱུང་རང་གྲོལ་ལྷ",
    "རང་སྟོང་རང་གསལ་རང་གྲོལ་གྱིས",
