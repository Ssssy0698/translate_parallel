    "འོག་མ་ནི་གསང་སྟེ་སྟོན་པས་བར་ཆད་མེད་པར་ངེས་པར་བྱས་ཟིན་པ་ལ་བལྟོས་ནས་ལས་ཐོས་པ་གནང་བའི་ཕྱིར་རོ་ཞེས་ཁ་ཅིག་ཟེར་རོ།",
    "དག་ན་གནང་མ་དག་ན་མི་གནང་བའི་དོན་ནོ།",
    "གསང་སྟེ་སྟོན་པས་བར་ཆད་བྲིས་ནས་བར་ཆད་དང་མི་ལྡན་པར་བརྡ་སྤྲད་ཟིན་པས་འདིར་དྲི་ཅི་དགོས་སྙམ་ན་བར་ཆད་སྔར་མ་དྲན་པ་ཕྱིས་དྲན་པ་ཡང་སྲིད།",
    "བསྙེན་པར་རྫོགས་པའི་འོག་ཏུ་ཅི་བྱ་ཞེ་ན་བསྙེན་པར་རྫོགས་ཟིན་པའི་དེ་མ་ཐག་ཏུ་གྲིབ་ཚོད་རིག་པར་བྱའོ།",
    "ཐ་སྙད་དེ་ལྟར་བཏགས་པའི་དགོས་པ་ནི་རྐུ་ཐབས་སུ་ཞུགས་པ་སོགས་ཀྱིས་ཐ་སྙད་དེ་མི་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།་།",
    "ལ་སོགས་པ་ཉི་ཤུ་རྩ་གཉིས་ཀྱང་རིག་པར་བྱའོ།",
    "ཉི་མ་སྤྲིན་ལ་སོགས་པས་བསྒྲིབས་པའི་ཚེ་དུས་ཀྱི་ཁྱད་པར་མི་ཤེས་པའི་སྐྱོན་ཡོད་པའི་ཕྱིར།",
    "ཉི་མའི་བརྒྱད་ཆ་ཤར་བ་ཞེས་བྱ་བ་ནི་ནམ་མཁའི་ཕྱོགས་ལ་འགྲོ་བའི་ལམ་གྱི་བརྒྱད་ཆ་ཆོད་པའོ་ཞེས་གསུངས་སོ།",
    "དེར་མ་ཟད་དུས་ཚིགས་ཀྱང་རིག་པར་བྱའོ།",
    "དེ་ནི་དམན་པ་ཕྱག་དར་ཁྲོད་ཀྱི་ཚད་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཞེ་སྡང་ཅན་ལ་མ་གནང་བའི་ཕྱིར་དང་།",
    "ཕམ་པ་བཞིའི་བསླབ་པ་མ་བཅས་པའི་ཚེ་བསྙེན་པར་རྫོགས་མ་ཐག་པ་ལ་ཕམ་པ་བཞི་བརྗོད་མི་དགོས་སོ།",
    "མཚང་བྲུས་ཀྱང་སླར་མཚང་མི་འབྲུ་བ་རྣམས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "དེ་རིང་བསྙེན་པར་རྫོགས་པ་དང་།",
    "དེ་དག་༢༥ན་ཇི་ལྟར་བསྒྲུབ་པ་ལ་སློབས་ཤིག་ཅེས་ངེས་པར་སྦྱར་བར་བྱའོ།",
    "དེ་ཙམ་བྱས་པས་ཆོག་གམ་སྙམ་ན།",
    "བསླབ་པ་གསུམ་མ་ཐོབ་པ་ཐོབ་པ་དང་ཐོབ་པ་མི་ཉམས་པར་བསྲུང་བ་རྗེས་སུ་བསྒྲུབ་པ་ལ་ཡང་སྦྱར་བར་བྱའོ།་།",
    "ཞེས་གུས་པ་ལ་ཡང་ངེས་པར་སྦྱང་བར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཞེས་སོགས་ཀྱིས་བསྟན།",
    "མ་བརྗོད་པ་ཡང་དག་པར་བླངས་པ་ཞེས་སོགས་ཀྱིས་བསྟན་ནོ།",
    "བཞི་པ་ནི་གནས་རྣམས་བརྗོད་པར་བྱའོ་ཞེས་པས་བསྟན།",
    "འདི་རྣམས་རྒྱས་པར་ནི་འོག་ནས་འཆད་དོ།",
    "བསྙེན་པར་རྫོགས་པའི་ཆོ་གའོ།",
    "ཐོབ་པ་མི་ཉམས་པར་བསྲུང་བའི་ཐབས་བསྟན་པ།",
    "མི་ཉམས་པར་བསྲུང་བའི་ཐབས་ལ་གཉིས།",
    "བསྙེན་པར་རྫོགས་མ་ཐག་ཏུ་རང་ཉིད་བླང་དོར་ལ་མ་བྱང་པས་དང་པོར་གནས་ལ་བརྟེན་ནས་བསྲུང་ཚུལ་སྟོན་པ་ནི།",
    "ཀུན་ཏུ་སྤྱད་པར་རུང་བ་དག་བགྱིད་པར་ཞུ་འཚལ་ཞེས་ཞུ་སྟེ།",
    "ཀུན་ཏུ་སྤྱད་པར་རུང་བ་དག་བགྱིའོ།",
    "གཞན་བྱེད་དུ་གཞུག་གོ་ཞེས་བརྩོན་པ་ཤས་ཆེན་པོས་བསྒྲུབ་པར་བྱཞོ།",
    "སྐྱོན་མེད་དེ་ནན་ཏུར་མ་བྱས་ཀྱང་ཉེས་པ་ལས་བཟློག་པར་འགྱུར་བའི་ཚེ་ནན་ཏུར་བྱེད་པ་དགག་པའམ།་",
    "ནན་ཏུར་མི་བྱ་བར་འབད་ཀྱང་ནན་ཏུར་བྱས་ན་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "ཡང་ན་གལ་ཏེ་ནན་ཏུར་བྱས་ན་ཞེས་བརྟག་པ་མཐའ་བཟུང་ཡིན་པའི་ཕྱིར་རོ།",
    "བ་སྤྱད་ནས་དབྱུང་བར་འདོད་པ་ལ་འདི་དབྱུང་བར་བྱའོ་ཞེས་བརྩོན་པ་ཤས་ཆེན་པོས་བསྒྲུབ་པར་བྱའོ།",
    "གནས་ཀྱིས་གནས་༢༧བ་པའི་བྱ་བསྒྲུབ་པར་གསུངས་པ་ནི།",
    "དེས་ན་དེ་གསུམ་རུང་བ་ལ་བརྟན་པའི་ཡན་ལ་ཏུ་བསྙེན་པར་རྫོགས་ནས་ལོ་བཅུ་ལོན་དགོས་ལ་མ་ལོན་པ་ནི་གནས་པའི་རིགས་ཡིན་ནོ།"
  ]
}