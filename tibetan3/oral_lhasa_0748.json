    "ཁྱད་པར་དུ་ཤེས་རྒྱལ་པོ་རཱ་མ་ཎའི་གཏམ་རྒྱུད་ཀྱི་སྒྱུ་རྩལ་སྐོར་རགས་ཙམ་གླེང་བ།",
    "ཤིན་ཏུ་ཐག་ཉེ་ཞིང་ཕང་བ་ན་གནས་པའི་བྲང་འགྲོའམ་དུག་སྦྲུལ་དང་གཉིས་སུ་མེད་པའི་སྟོབས་ཆེན་སྤྲེའུ་འབའ་ལེ་ཁོ་གཞོག་པར་བྱ།",
    "དེ་ནས་སི་ཏཱ་འཕྲོག་པའི་དགྲ་ཡི་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བ་གཉིས་པ་ནི།",
    "འབངས་ཁོལ་དྲག་བློན་གྱི་ཁོངས་སུ་བཞག་གནང་བ་ནི་འཁྲབ་གཞུང་ཧྲིལ་པོར་དགོས་མཁོ་ཤིན་ཏུ་ཆེ་བ་འོག་ཏུ་གསལ་བར་གྱུར།",
    "བློ་རྒོད་ཐར་ལེགས་ལས་མི་སྣ་གཞན་ཉུང་འཕྲི་མཛད་པ་ནི་དགོས་མེད་དོར་བ་ཞིག་ཡིན་པས་ཤིན་ཏུ་འོས་པར་མཐོང་ངོ།",
    "འོན་ཀྱང་སྲིད་པའི་རྒྱན་གྱི་རྒྱལ་ཁབ་ཕྱོགས་ནས་དེའི་བར་དུ་འཛུལ་ཏེ་གཡོ་སྒྱུས་ཡིད་འོང་མ་བསླུ་བྲིད་བྱས་པ་རྒྱལ་ཁབ་ཕན་ཚུན་འཁོན་པའི་ས་བོན་ཏུ་གྱུར།",
    "གཞོན་ནུ་ཟླ་མེད་མཆོག་ནས་ཡིད་འོང་མ་དང་མཛའ་གཅུགས་དམ་བཅའ་ནམ་ཡང་མི་འགྱུར་བའི་ཆེད་རིན་ཆེན་རྡོ་རྗེ་ཕ་ལམ་ཡིད་འོང་མར་ཕུལ་ཚུལ་ཞུས་མ་ཐག་ཡབ་རྒྱལ་པོ་ཐུགས་ཤིན་ཏུ་ཁྲོས་ནས་བརྒྱལ་ལ་ཉེ་བར་བྱས།",
    "འོན་ཀྱང་གཞོན་ནུ་ཟླ་མེད་ཀྱི་ཐུགས་ཡིད་འོང་མར་སྐད་ཅིག་གཡོ་བ་མེད་པར་ཕྱོགས་པ་ནི་ཇི་ལྟར་ཆུ་ཀླུང་ཆེན་པོ་འབབ་པ་ལྟར་ལྡོག་ཏུ་མེད་པས་བཀོད་ལེགས་འོད་སྣང་ཕྱོགས་སུ་བསྐྱོད་འདོད་ཆེ་ཡང་བློན་ཆེན་པད་མའི་མྱུ་གུ་སོགས་ཀྱིས་བཀག་འགོག་བྱས་མཐར་སྲིད་པ་གཞོན་ནུ་དང་འབངས་འཁོལ་བཀོད་ལེགས་འོད་སྣང་ཕྱོགས་སུ་མངགས་སོ།",
    "གང་ལགས་ཤེ་ན།",
    "རྒྱལ་པོ་གསལ་ལྡན་གྱིས་སྔར་གྱི་དམ་བཅའ་ལྟར་ཡིད་འོང་མ་བག་མར་གནང་རྒྱུའི་ཞལ་བཞེས་བཟང་པོ་ཐོབ་ཅིང་།",
    "དང་པོར་རྒྱལ་པོའི་ལྐོག་ཏུ་ཡིད་འོང་མ་དང་འབྲེལ་བ་བྱས།",
    "འཁྲབ་ཚན་འདི་ནས་འགལ་བའི་མཐོ་རླབས་ཀྱི་ཕྱོགས་སུ་སླེབས་པ་སྟེ་ད་ཀོ་རྒྱལ་སྲས་གཞོན་ནུ་ཕྱི་ནང་གང་ཐད་ནས་གནང་དཀའ་གནང་གཏད་དུ་གྱུར་པ་ནི།",
    "སྣང་བ་འབུམ་ལྡན་གྱི་རྒྱལ་ཁབ་ནས་འབངས་ཁོལ་ལ་བྱ་དགའ་གྱ་ནོམ་པ་ཐོབ་པ་དང་སྔ་ཕྱི་འབངས་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགཁོལ་དང་ལྷ་ལས་ཕུལ་བྱུང་དང་མཉམ་དུ་སྲིད་པ་གཞོན་ནུའི་སྲོག་ལ་འཚེ་བའི་བྱ་བ་མང་པོ་བརྩམས་ཀྱང་ཡིད་འོང་མས་འཇམ་པོའི་ཐབས་ཀྱིས་ལྷ་ལས་ཕུལ་བྱུང་འཁྲུལ་བར་བྱས།",
    "གློག་བརྙན་སོགས་ཀྱི་འཁྲབ་གཞུང་འབྲི་སྟངས་ལྟར་འགལ་བ་མང་པོ་བསྣན་ཡོད་པ་ནི་བཅོས་སྒྲིག་པར་སྒྱུ་རྩལ་གྱི་ཉམས་མྱོང་ཆེས་ཕུན་སུམ་ཚོགས་པོ་ཡོད་པའི་མཚོན་རྟགས་ཤིག་ཡིན་ནོ།",
    "འཁྲབ་ཚན་འདིའི་ནང་ཡིད་འོང་མ་སྣང་བ་འབུམ་ལྡན་རྒྱལ་ཁབ་ཏུ་བཙན་ཁྲིད་བྱས་རྗེས་བརྩེ་བའི་ཕ་མ་དང་།",
    "མ་རྩོམ་ནང་སྲིད་པ་གཞོན་ནུས་གཡོ་ཐབས་སྣ་ཚོགས་སྤྱད་དེ་འབངས་ཀྱི་མཚོན་ཆ་མེད་པར་བཟོས་པ་དང་།",
    "འབངས་ཁོལ་བསད་ངསོགས་སྣ་ཚོགས་ཡོད་ཀྱང་དེ་དག་གར་སྟེགས་ཀྱི་ཐོག་མཚོན་སྟབས་མི་བདེ་བས་ཐམས་ཅད་བསྡུས་པ་ནི་འོས་ཤིང་འཚམས་པ་ལགས་ཀྱང་མཇུག་ཏུ་སྲིད་པ་གཞོན་ནུས་བཙོན་ནས་བྲོས་ཏེ་བསྐྱོད་སྐབས་གཞོན་ནུ་ཟླ་མེད་དང་ཁ་ཐུག་འཁེལ་བ་དང་།",
    "ཁོང་གཉིས་གཅིག་པུས་སྣང་བ་འབུམ་ལྡན་གྱི་སྟོབས་ཆེའི་དཔུང་ཕམ་པར་བྱས་ནས་བདེ་བླག་ངང་ཡིད་འོང་མ་སྐྱོབ་པ་དེ་ལ་མི་རྣམས་ཅུང་ཟད་ཡིད་མི་ཆེས་པའི་དོགས་པ་ཞིག་མི་སྐྱེ་ཀ་མེད་ལ་ཐུག་གོ།",
    "འཁྲབ་ཚན་འདིའི་ནང་གཞོན་ནུ་ཟླ་མེད་དང་ཡིད་འོང་མ་སྲིད་པའི་རྒྱན་དུ་འཁྲུངས་སའི་མཛད་སྒོ་གནང་ལ་ཁད་ཀྱི་སྐབས་དེར་པད་མའི་མྱུ་གུས་ངན་ཇུས་བཤམས་ཏེ་ཡིད་འོང་མ་ཡུམ་ཆེན་ཟླ་འོད་མ་བསྟུན་གཞི་དྲག་པོས་གཙེས་པའི་ཡི་གེ་རྫུན་མ་ཕུལ་ཏེ་འཁྲུངས་ས་ནར་འགྱངས་སུ་བཏང་བ་མ་ཟད་གཞོན་ནུ་ཟླ་མེད་ཡིད་འོང་མ་དང་ལྷན་དུ་ཐད་རྒྱུར་བཀག་འགོག་མཐའ་གཅིག་ཏུ་བྱས་པ་དང་།",
    "གཞོན་ནུ་ཟླ་མེད་ཡིད་འོང་མའི་ཕེབས་སྐྱེལ་དུ་བསྐྱོད་རྒྱུར་བཀག་འགོག་བྱས་པ་སོགས་འགལ་བ་གཅིག་ཐོག་ཉིས་བརྩེགས་བཀོད་པ་ནི་འཚོ་བ་དང་མཐུན་ཞིང་།",
    "སྲིད་པ་གཞོན་ནུས་གཞོན་ནུ་ཟླ་མེད་ཀྱི་བཀའ་བཞིན་སྣང་བ་འབུམ་ལྡན་གྱི་རྒྱལ་ཁབ་ཕྱིར་གནང་ནས་སྲིད་པའི་རྒྱན་དུ་ཕེབས་དུས་རྒྱལ་སྲས་མེད་པས་མྱུར་དུ་རྒྱལ་སྲས་ཀྱི་རྗེས་སུ་བསྙེགས་ནས་ཞམ་འབྲིང་དུ་འབྲངས།",
    "འོན་ཀྱང་གཏམ་བརྗོད་ཟློས་གར་ཡིད་འོང་མའི་མཇུག་བསྡུ་བཅོས་སྒྲིག་ཤུགས་ཆེན་གནང་ནས་སྲིད་པ་གཞོན་ནུ་རང་སྲོག་ལྕེབས་པ་དང་ཡིད་འོང་མ་སྐུ་ཚེ་འདས་པ་རྒྱལ་སྲིད་ཐོར་བ་སོགས་ཤིན་ཏུ་སྐྱོ་སྣང་ཆེ་བ་དང་།",
    "སྒྱུ་རྩལ་གྱི་ལས་དོན་ཞིག་ཀྱང་ཡིན་པར་སྙམ་ཞེས་གསུངས་པ་དང་།",
    "འདིས་གསུངས་པ་དེ་ཡིན།",
    "ཡང་ན་རྟོག་བཟོ་བྱས་པའི་མི་སྣ་ཞིག་ཡིན།",
    "རི་མིང་སོགས་ཧ་ཅང་མང་པོ་དུས་ད་ལྟའང་མ་ཉམས་པར་ཡོད་པ་དང་།",
    "སྲིད་ཀྱི་ཁྱབ་ཁོངས་སོགས་གཏན་ནས་མི་མཐུན་པ་མཁས་པ་རྣམས་ཀྱིས་མང་དུ་གསུངས་ཡོད་པས་བདེན་རྫུན་ཡོད་ཚད་ལ་རྣ་བ་ཉན་པའི་ངལ་བ་བྱ་མི་དགོས་སོ།",
