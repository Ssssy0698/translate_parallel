    "སྣ་ཡི་རྣམ་པར་ཤེས་པའི་ཁམས་དང་།",
    "ལྕེ་ཡི་རྣམ་པར་ཤེས་པའི་ཁམས་དང་།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་དང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་མྱ་ངན་ལས་འདས་པའི་གསུང་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པ་དེ་དག་ནི།",
    "བསྲུང་དུ་མེད་པའི་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "མི་འཁྲུལ་བར་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "བསྲུང་དུ་མེད་པའི་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "མི་འཁྲུལ་བར་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "བསྲུང་དུ་མེད་པའི་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་འགག་པ་མེད་པའོ།",
    "མི་འཁྲུལ་བར་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་མྱ་ངན་ལས་འདས་པའི་གསུང་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པ་དེ་དག་ནི།",
    "བསྲུང་དུ་མེད་པའི་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "མི་འཁྲུལ་བར་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "མི་འཁྲུལ་བར་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་ནས་མྱ་ངན་ལས་འདས་པའི་གསུང་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པ་དེ་དག་ནི།",
    "བསྲུང་དུ་མེད་པའི་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
    "མི་འཁྲུལ་པར་བྱ་བ་ནན་ཏན་གྱི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་མ་བཅོས་པ་ལ་ཡོངས་སུ་འགག་པ་མེད་པའོ།",
