    "ལྟོས་པ་ཁོང་ན་ཡོད་པ་བྱས་པ་བཀོད་པ་ལྟ་བུ་དང་",
    "གཉསེ་པ་འགྲེལ་པ་གཞན་ལལྟོས་པ་སྐྱེ་བ་དང་ལྡན་པ་བཀོད་པ་ལྟ་བུ་སྐྱེ་བས་ཁྱད་པར་བྱས་པའི་ངོ་བོ་དབྱེར་། མེད་བཀོད་པའོ།",
    "རྒྱུཚོགས་པ་ཚང་བ་ལས་འབྲས་བུ་སྐྱེ་རུང་དཔོག་པ་དང་རུ་རྒྱུ་ནུས་པ་ཐོགས་མེད་ཀྱིས་འདུས་བྱས་ཀྱི་དུ་བ་བསྒྲུབ་པོ་ལསོགས་པ་དོན་གཞན་སྒྲུབ་ཁདག་ཉིད་ཀྱིའབྲེལ་པ་དགོས་ན་རྒྱུནུས་པ་ཐོགས་མེད་ཀྱིས་མི་རྟག་པའི་དུ་བ་སྒྲུབ་པ་ལྟ་བུ་ལ་མ་ཁྱབ་སྟེ་རྫས་ཐ་དད་པའི་ཕྱིར་འཐེན།",
    "དེ་ལྟ་མ་ཡིན་པར་སྒྱུཉིད་ལ་སེམས་ན་རང་བཞིན་གྱི་རྟགས་མ་ཡིན་ནོ།",
    "སྨྲ་བའི་ལྟགོས་ལས་བརྗོད་པར་འདོད་པའི་དོན་དཔོག་པ་དང་།",
    "དུ་བ་ཁྱད་པར་བས་མེ་ད་ལྟའ་བ་སྒྲུབ་པ་དང་།",
    "ཁྱད་པར་བྱ་བྱེད་དུ་གྲགས་པ་འགའ་ཞིག་གོ་བྱེད་དུ་གྲོན་དེ་ལས་བྱུང་བར་འདུའོ།",
    "ཁྱད་པར་བྱ་བྱེད་འགྲོལ་པོ་ཡི་སྟོབས་ཀྱིས་བསྒྲུབ་བྱ་གོ་བམིན།",
    "དེའི་ངོ་བོའམ་དོན་གྱི་གཞན་གྱི་འབྲེལ་པའི་སྟོབས་ཀྱིས་རྟོགས་པར་ཟད་ཁར་སྐབས་ཀྱི་ཚིགས། ། ཁཅད་དོ།",
    "གཉིས་པ་སྲིད་ཀྱང་ཤེས་འདོད་དང་འགྲེལ་པར་མ་གྲུབ་པ་ལ་གཉིས་ཀྱི་དང་པོ་ངོ་བོ་མཡ།",
    "གཉིས་པ་ལྡོག་པ་ཐ་དར་མེར་ནས་མ་གྲུབ་པ་ལ་གཉིས་ལས་གཞི་རྟགས་ཐ་དད་མེད་པ་སྒྲ་སྒྲ་པ་ཞེས་གསུངས་སོ།",
    "འདི་ལ་ཁ་ཅིག་རྟགས་ཀྱི་རི་བོ་མ་གྲུབ་པའམ་གྲུབ་པར་མཚོན་མི་ནུསི་ཏམཚན་གཞི་མི་སྲིད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་ནམིད་པ་གཞན་སེལ་གྱི་རྣམ་གཞག་མ་མཁྱེན་པར་ཟད་དོ།",
    "དེ་ལྟ་མ་ཡིན་ན་སྒྲ་མཉན་བྱ་མ་ཡིན་པར་དམ་བཅས་པ་ལམཉན་བྱས་བསལ་བའར་བསལ་བའི་བྱེ་བྲག་དུ་མཚོན་མི་ནུས་པར་འགྱུར་རོ་གསུམ་པ་དེ་དག་གྱི་ཕྱོགས་ལ་མ་གྲུབ་པ་ལ་གཉིས་ཏེ།",
    "ངེས་རུང་མེད་ནས་ཐེ་ཚོམ་ཟ་པ་འདོད་ཆགས་དང་བྲལ་བས་བྱས་པའི་ཕྱི་ལྟ་བུ།",
    "གཉིས་པ་དེས་རུང་ཡོད་ཀྱང་ཐེ་ཚོམ་ཟ་བ་དུ་བ་འམ་ཟླངས་པར་ཐེ་ཚོམ་ཟ་བ་ན་དུ་བ་རྟགས་སུ་བཀོད་པ་ལྟ་བུའོ།",
    "ཡང་དག་པར་ན་ཆོགཅན་ལ་གྲུབ་ན་ཁྱབ་པའི་སྐྱོན་ཡིན།",
    "འཛམ་མེད་པས་ཤུན་པ་བཤུས་༨ བབ་ཞེས་བསྟན་པར་ཟད་དོ།",
    "གལ་ཏེ་སྤྱི་དང་བྱེ་བྲག་རྩོད་བཞི་དང་དཔེའི་རུ་ན་མཉེན་བྱས་མི་རྟག་པ་སྒྲུབ་པ་ནའང་སྒྲ་ཙམ་དང་རྔ་སྒྲ་དེ་ལྟར་འགྱུར་རོ་ཚོ་ཅན།",
    "གཏན་ཚིགས་མཉན་བྱས་མ་ཁྱབ་པའི་སྒྲ་ཙམ་དགས་པའི་ཕྱིའི་འོན་ན།",
    "དེ་བཞིན་དུ་སྒྲ་མི་རྟག་སྟེ་སྒྲའི་བྱིས་པ་ཡིན་པའི་ཕྱིར་རྭ་སྒྲ་བཞིན་ཞེས་སྒྲུབ་པ་ན་བྱེ་བྲག་དཔར་འགྱུར་བ་ལསོགས་པ་རྒྱས་པར་ཤེས་པར་བྱའོ།",
    "དེས་ན་གཞན་སེལ་གྱི་སྒྲོནས་བློ་ངོར་གྲུབ་མ་གྲུབ་ཀྱི་ཁྱར་པར་ཡོད་ན།",
    "འཐུན་ཕྱོགས་ལ་ཡོད་ཀྱང་མ་མཐོང་བ་སྒྲ་མི་རྟག་སྟེ་བྱས་པའི་ཆུཕྱིར་རིག་བྱེད་ཀྱི་སྒྲ་བཞིན་ལྟ་བུའོ།",
    "མི་མཐུན་ཕྱོགས་ལ་ཡོད་ཀྱད་མ་མཐོང་བ་གདུ་བྱས་པ་མི་རྟག་སྟེ་རིག་བྱེད་བཞིན་ནམ་མཁའ་ནི་མ་བྱས་སོ་ཞེས་བཀོད་པོ་ལྟ་བུའོ།",
    "གཉིས་ག་ལ་ཁྱབ་པར་མཐོང་ན་བ་སྒྲ་མི་རྟག་པ་ལ་གཞོལ་བྱ་བཀོད་པ་ལྟ་བུ་འཐུན་ཕྱོགས་ལ་ཁྱབ་པར་མཐོང་བ་སྒྲ་རྩོལ་བ་ལས་བྱུང་བ་ལ་མི་རྟག་པ་བཀོད་པ་ལྟ་བུ།",
    "གཉིས་པ་དབྱེ་ན་གསུམ་སྟེ་རྟགསའཐུན་ཕྱོགས་ལ་ཡོད་ཀྱང་མ་མཐོང་བ་དཔེར་ན་ཐམས་ཅད་མཁྱེན་པ་ཡིན་ཏེ་སྨྲ་བའི་༤ ཕྱིར་ལྟ་བུ།",
    "མད་ཀྱང་མི་འགལ་བ་སྔོ་བསངས་མ་ཡིན་ཏེ་ལྷ་སྦྱིན་གྱི་བུ་ཡིན་པའི་ཕྱིར་ལྟ་བུ།",
    "འགལ་ཡང་མ་ངེས་པ་བྱས་པ་རྟག་པ་དང་འགལ་བར་མ་ཤེས་པ་ལ་རྟག་སྟོ་བྱས་པའི་ཕྱིར་ལྟ་བུའོ།",
    "དང་པོ་ལྟར་ན་ཡུལ་ལ་ཁྱད་པར་བསྐྱེད་ནི་རྟག་པར་འགྱུར་ལ་མ་སྦྱོང་ན་བསྒྲིབས་པ་འགལ་ལོ།",
    "མི་དམིགས་གསུམ་པར་འབྱེད་ན་ནིབ་ཟློག་པ་འགལ་བའང་གསུམ་དུ་འགྱུར།",
    "སློབ་དཔོན་གྱི་དགོངས་པ་མ་མཁྱེན་པར་ཟད་དོ།",
    "བྱས་པའི་ཕྱིའི་ནམ་མཁའ་བཞིན་ནོ།",
    "ཐ་སྙད་ཁྱད་པར་ཡོད་ཀྱི་མི་རྟག་པ་ཉིད་དུ་ཅིག་གོ།",
    "དེ་གཉིས་ཀའངསྒྲ་མི་རྟག་པ་ཉིད་དུ་རྟོག་པར་འདོད་པར་དོན་ལ་ཁྱད་པར་མེད་དོ།",
    "དེ་དག་བྱས་བའི་རྟགས་ཀྱིས་རྟོགས་པར་ནུས་པས་ཡང་དག་ཡིན་ལ་འདུས་ཤིང་བསགས་པའི་ཡེ་ཤེས་བྱ་བ་ལསོགས་པས་རྟོགས་པར་མི་ནུས་པའི་ཕྱིར་འགལ་བ།",
    "དང་པོ་ནི་མེད་ལས་མཚན་ཉིད་ལྔ་ལྡན་གསུངས།",
    "། ཅེནཱ་མ་གྲུབ་ཅེས་གསུངས་པ་ལྟར་རོ།",
    "གཏན་ཚིགསམ་གྲུབ་ལ་སོགས་འགོག་ཅེས་གསུངས་པ་ལྟར་རོ།",
    "སྐབས་སུ་བབ་པའི་བསྒྲུབ་བྱའི་འོས་པ་ཞིག་ལ་ཕྱིར་རྒོལ་གྱིསན་གཏོད་བར་འོས་ལ་ལས་གཞན་དུ་ཚར་བཅད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བསལ་བའི་རབ་ཏུ་དབྱེ་བ་རིགས་པའི་སྒོར་ལྔར་གསུངས་ལ།",
    "ཀུན་ལས་བཏུསཱ་སུ་བཞིར་གསུངས་པ་དེ་སློབ་དཔོན་གྱིས་ལྔ་པབཞི་རུ་བསྡུས་ཏེ་བཤད།",
    "དོན་གྱིས་ཚུར་བཞག་པར་འགྱུར་ལ།",
    "རྗེས་དཔག་ཉི་རི་ཡིན་པས་ཁོངས་སུ་བསྡུ་བར་གསུངས་པའང་མི་འཐད་བོར་འགྱུར་རོ།",
    "ཅེས་གསུངས་སོ།",
    "ཡོད་པ་དཔར་རྗོད་པའི་འབྲས་བུ་འདི་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་ཡོད་པ་ནི་འགལ་།",
    "གཉིཀྐོ་མ་བྱས་ཀྱང་རུང་།",
