    "ཉོག་ཚེ་ནི་བོད་ཀྱི་སྒྲུང་ཐུང་ཕལ་མོ་ཆེ་དང་བསྡུར་ན།",
    "སྒྲུང་ཐུང་དེའི་མགོ་རྩོམ་སྟངས་ཅུང་ཁྱད་པར་པ་པོ་ཞིག་གི་ངོས་ནས་སྒྲུང་ཐུང་འདི་བཀླགས་པ་བ་ཞིག་ཏུ་སྣང་སྟེ།",
    "གྲིབ་གཟུགས་ཞེས་པའི་མཚོན་དོན་ཅན་གི་ཚིག་མཛོད་མཐུག་པོ་དེའི་ཁ་བསུམས་པ་དང་།",
    "མཛེས་རྟོག་གི་ལྟ་བ་ཡོངས་སུ་ཉམས་དོད་པོས་འབྲི་ཐུབ་ཡོད་པ་རེད།",
    "རྩོམ་པ་པོས་ཐུན་མོང་མ་ཡིན་པའི་འདུ་ཤེས་རབས་འདིར་འགྲན་རྩོད་རང་བཞིན་གྱི་བྱ་གཞག་འཛིན་སྟངས་དང་སྒྱུ་རྩལ་གྱི་ལྟ་བ་ཁྱེར་ནས་གྲིབ་ཅིག་ཏུ་ངོས་འཛིན་གྱི་ཡོད་ལ།",
    "ལྷག་པར་བཀྲ་ཤིས་ཀྱིས་ལག་པ་ཉི་འོད་ཁྲོད་ཚུགས་ཐུབ་བརྟན་བརླིང་གི་གཤིས་ཀ་ཞིག་ཏུ་ངོས་དུ་བསྲིངས་ནས་གྲིབ་གཟུགས་སྣ་ཚོགས་འབེབས་བཟུང་ཡོད་ལ།",
    "རང་གིས་རང་ལ་འཇུན་སྡོམ་འབྲལ་མེད་དུ་གནས་པ་ཡིན་ལ།",
    "དེ་ནས་བཟུང་བཀྲ་ཤིས་ལ་ཡང་གཤིས་ཀ་འབྲི་བཞེང་བྱས་པ་བརྒྱུད་ནས་བདེན་རང་གི་གྲིབ་གཟུགས་བོར་བའི་སྔངས་སྐྲག་བྱུང་བ་ལུགས་ལ་བརྩི་མཐོང་བྱེད་ཅིང་།",
    "མི་འདོད་བཞིན་རྨེག་མེད་དུ་འགྲོ་བཞིན་རང་གཤིས་ཤིན་ཏུ་གསལ་བའི་ཐར་རྡོ་རྒྱ་གར་ལ་ཡོད་པའི་དེ་སྐབས་ཀྱི་སྐྱོ་ངལ་དང་ན་ཟུག་དེ་རེད།",
    "བཀྲ་ཤིས་ནི་རང་༢་སྐུ་ཉིད་འཚོ་སྡོད་བྱེད་སའི་ཁོར་མོ་ཡུག་ཏུ་གཅུན་གཉིས་པ།",
    "མི་སྣའི་གཤིས་ཀ་འབྲི་བཞེང་གི་ཆ།",
    "གི་ངོ་བོ་དང་མུན་ནག་གི་ཆ་དེ་ལ་ཐེར་འདོན་དང་ང་ཚོས་ཕྱིར་དྲན་ཐེངས་ཤིག་བྱས་ཚེ།",
    "མི་སྣ་གཙོ་བོ་དགག་སྒྲུབ་བྱས་ཡོད་པ་ཞིག་རེད།",
    "ཤོ་ཁྱོད།",
    "འཕོ་འགྱུར་གྱི་གོ་རིམ་ཁྲོད་དུ་བརྗོད་དོན་གང་དེའི་འཕེལ་འགྱུར་རམ་རྒྱུ་འབྲས་ཀྱི་བྱུང་བའི་ཁེར་རྐྱང་གི་སྣང་བ།",
    "བཀྲ་ཤིས་ཆུང་འབུར་དུ་ཐོན་ཡོད་པ་རེད།",
    "ལས་ཀར་ཞུགས་ཞིག་གི་ངོས་ནས་གླེང་ན།",
    "བདེན་རྫུན་གོ་ལྡོག་སྣེ་མང་མོར་དགའ་བ་དང་།",
    "རྩོམ་རིག་གི་སྐད་ཆར་ཞུན་ཐར་ཆོད་པ་གཤིས་ཀ་འཕོ་འགྱུར་ལ་རྒྱུ་ཕུན་སུམ་ཚོགས་པ་ཞིག་བཅས་ཀྱི་དགེ་མཚན་གྲ་རྒྱས་འཛོམས་པོ་ཡོད་པས།",
    "ཤུལ་དུ་ལྷག་པ་ནི་སྔོན་ཞིག་རེད།",
    "ང་ཚོས་མི་སྣ་གང་དེའི་གཤིས་སྤྱོད་ལ་རྒྱུས་ཡིན་ལ།",
    "མི་སྣ་ཐར་རྡོ་འབྲི་བཞེང་བྱེད་སྐབས་དོན་ཕལ་མོ་ཆེ་དང་བསྡུར་ན།",
    "གོང་དུ་བརྗོད་ཟིན་པ་བཞིན་སྒྲུང་གིས་ཕ་སྐད་ཤུལ་ཙམ་ཡང་རྒྱུན་འཛིན་བྱས་མེད་པ།",
    "ང་ཚོའི་རུས་པའི་རྐང་ལ་འབྲེལ་བའི་དོན་འགངས་ཟད་སྤྲོ་བར་འདོད་དེ།",
    "སྒྲུང་ཐུང་ཞིག་གི་ཤོང་རྒྱའི་ཆེན་ཞིག་ཡིན་མོད།",
    "མི་སྣ་བཞེང་སྐྲུན་བྱེད་པ་དེ་ཧ་གི་དུངས་ཞེན་གྱི་ཚོར་འདུ་ཤུགས་དྲག་པོ་དེ་མ་ནོན་ཅང་ཁག་པོའི་གནས་ཤིག་ཡིན་མོད།",
    "མཐའ་འཁོར་ན་སྒྲུང་ཐུང་ཞིག་གི་ཤོང་ཚད་ལས་བརྒལ་པ་དང་།",
    "ཕན་ཚུན་གྲོགས་སུ་མ་སོང་བར་མི་སྣ་སོ་སོ་བར་གྱུར་བ་ཕྱི་རུ་མངོན་ཐབས་སུ་གློག་བརྙན་གྱི་པར་གླིང་ཞིག་ཡོད་པར་སྣང་།",
    "གཙོ་ཕལ་དང་ལྕི་ཡང་གི་ཁྱད་པར་ཆེར་མ་ཕྱེད་པས་སེམས་ཀྱི་འཇིག་རྟེན་དང་རིང་དུ་གྱེས་འདུག་གོ།",
    "དེང་གི་དུས་འདིར་མི་སྣར་རང་གཤིས་བྲལ་མཚོན་ནའང་།",
    "གཞན་བརྒྱུད་ཀྱི་ཉམས་མྱོང་དང་ཅིང་ལྷ་བརྒྱ་གདོང་གཅིག་ཏུ་གྱུར་པའི་གཏམ་རྒྱུད་ཀྱི་རང་གི་རྟོག་འཆར་ལ་བརྟེན་ནས་བྲིས་པ་ཡིན་ངེས།",
    "རང་གཤིས་ཀྱི་སྟེང་ནས་ཀྱང་ཁྱད་པར་འབྱེད་སླ་བ་སྣང་ནི་གཏམ་རྒྱུད་དེ་དག་རང་གི་འཚོ་བ་དང་ཐག་ཡིན།",
    "སྒྲུང་གཏམ་འདིའི་བྱུང་རིམ་བའི་ཟུར་རེ་མཐོང་ནུས་པར་མ་ཟད།",
    "དེ་དག་དང་འབྲེལ་གསུམ་གས་ཁྱིམ་ཚང་གི་འཚོ་བ་ཇེ་ལེགས་སུ་གཏོང་།",
    "གཤིས་རེ་རེ་རང་རང་གི་བྱ་སྤྱོད་བྱེ་བྲག་པའི་སྟེང་རྩོམ་མཁན་གྱིས་སྒྲུང་གཏམ་བརྒྱུད་ནས་ཡུལ་ནས་ཕྱིར་མངོན་དུ་བཅུག་པས།",
    "མི་སྣ་དེ་ཀྱི་དཀའ་ཁག་ཡང་ན་དབྱར་རྩྭ་དགུན་འབུ་ཚད་གསུམ་ག་རྩིག་ལྡེབས་ངོས་ཀྱི་རི་མོའམ་བསྐྱར་དཔར་ལས་བརྒལ་པར་བརྐོས་ན་འབྱུང་འགྱུར་ཞིག་ལ་བརྒྱབ་པའི་འདྲ་པར་ཙམ་དུ་སོང་མེད་པར།",
    "དེ་ལས་གཞན་ཨ་ཁུ་གཡང་བྱམས་བརྗོད་བྱས་པར་བརྟེན་ནས་ཐད་ཀར་མི་སྣའི་དཀའ་དང་དེའི་བུ་སྙན་ངག་པ་གཉིས་གོ་བསྡུར་བྱས་པ་ལ་སྡུག་གི་གནས་བབ་དེ་ཕྱིར་མཚོན་དུ་བཅུག་པས་སྒྲུང་ལས།",
    "ཁམས་ཅི་རིགས་བྱུང་རིམ་གྱི་འཕེལ་རྒྱས་དང་བསྟུན་བྱས་པའི་མི་སྣ་དང་གཏམ་རྒྱུད་ལ་གསོན་ཤུགས་ལྡན་ནས་རེ་རེ་བཞིན་རི་མོའི་རྣམ་པ་ལས་གསོན་ཉམས་མིན་གྱི་སྟེང་ན་གནས་ཡོད།",
    "གཏམ་རྒྱུད་ཅིག་ཀྱི་རིན་ཐང་དང་བརྗོད་བྱའི་ལྗིད་ཚད་དེ་དོན་དམ་ཡོད་ན་སྒྲུང་གཏམ་ཞིག་ཀྱང་འཁྱོངས་ངེས་པ་ཡིན།",
    "སྒྲུང་གཏམ་འདིར་ཆ་དེ་གཙོ་བོར་བཟུང་ནས་མི་སྣ་སོ་སོའི་དབྱར་རྩྭ་མཚོན་ན་འཚོ་བའི་གནས་བབ་དངོས་གཞིར་ཁ་དགུན་འབུ་རྐོ་བའི་བྱེ་བྲག་གི་ངལ་རྩོལ་རྣམ་པ་གཏད་དེ་གཏམ་རྒྱུད་བཀོད་སྒྲིག་བྱས་སྟབས།",
    "དེ་ལས་དགའ་རོགས་རྒྱ་མོ་དེ་གཉིས་བསླེབས་པས།",
    "རྩོམ་ཡོངས་ཀྱི་མགོ་མཇུག་བར་གཤིས་ཀྱི་ཟབ་སར་བསྒྱུར་སླད་ཨ་ཁུ་གཡང་བྱམས་གསུམ་ལྷུ་རྐང་འགྲིག་པོར་འོངས་འདུག་དེར་བརྟེན་ཚུར་བསུས་བྱུང་།",
    "སྙན་ངག་པ་དེ་ཞིང་པ་རྒན་པོ་ང་ཚོས་གཏམ་རྒྱུད་ཀྱི་བྱུང་རིམ་དང་བསྟུན་ནས་མི་དེའི་བུ་ཡིན་པ་ཤེས་རྗེས་སླར་ཡང་ཁོང་ཁྲོ་ཞིག་གིས་སྣ་སོ་སོས་དབྱར་རྩྭ་དགུན་འབུ་བརྐོས་པ་ལས་བྱུང་མནར་འོང་།",
    "སྤྱིར་བཏང་གི་ཀློག་མཁན་ཞིག་ལ་མཚོན་ན།",
    "དེའི་མཛེས་དཔྱོད་ཀྱི་རིན་ཐང་མངོན་བྱེད་ཀྱི་རྒྱུ་གཙོ་བོ་ནི་ངོ་མཚར་བའི་གཏམ་རྒྱུད་དེ་ཡིན་ཅེས་ནའང་ཐལ་མི་དྲགས་སྙམ།",
    "དབྱར་རྩྭ་དགུན་འབུ་བཙོངས་ཏེ་སྒོར་རྡོག་འགའ་ལག་ཏུ་སོན་མ་ཁད་ཀྱི་མི་རེ་རེའི་སྤྱོད་སྟངས་ལས།",
    "ཡང་ན་ཕ་སེམས་བུ་ཐོགས་དང་བུ་སེམས་རྡོ་ཐོགས་ཞེས་པའི་སྣང་ཚུལ་དེ་བརྗོད་འདོད་པ་གང་ཡིན་ཆ་མི་འཚལ་མོད།",
    "སྒྲུང་གཏམ་སྒྲུང་གཏམ་དུ་མ་གྲུབ་པར་གནས་ལུགས་གཏམ་ཞིག་གི་རིན་ཐང་དེ་ལྟ་ཀློག་གི་བརྒྱུད་རིམ་ཁྲོད་གང་མང་ཞིག་གི་བྲན་གཡོག་ཏུ་གྱུར་ཏེ།",
    "རྩོམ་དངོས་གཞི་ལས་བརྒལ་པའི་གཞུང་མང་མང་ཞིག་གིས་གཏམ་རྒྱུད་ལས་ཐོད་རྒལ་བྱེད་འགྲེལ་ལ་མུན་ནག་ལག་སྙོབ་བཞིན་ལག་ཏུ་གང་ཡོང་དགོས་ཞེས་གཏམ་རྒྱུད་ཀྱི་ཆ་དེ་སྣང་མེད་དུ་བཞག་སྟེ།",
    "སྒྲུང་གཏམ་དངོས་དང་འབྲེལ་གནས་ལུགས་སྤྱི་མཚན་པ་རེར་བསྙེགས་དྲགས་ཏེ་མེད་ཀྱི་གནས་ལུགས་ཡ་མ་བརླ་ཐེག་ཚོད་ཅིག་རྩོམ་མཁན་རང་གི་གསར་རྩོམ་གྱི་འདུན་པ་དང་ལྟ་བ་བཙན་ཚུགས་ཀྱིས་དཔྱད་གཞིའི་སྒྲུང་གཏམ་སྟེང་སོགས་སྡོམ་ཚིག་རང་བཞིན་དུ་སོང་བས།",
    "མང་མང་ཞིག་གིས་འཛེམ་བཞིན་པ་ནི་དཔྱད་གོལ་ལམ་དུ་ཞུགས་དང་འཇུག་བཞིན་ཡོད་པར་སྙམ།",
    "དེང་གི་དུས་འདིར་ཀློག་པ་པོ་གང་མང་ལ་ཤིང་གཏམ་རྒྱུད་ཙམ་མིན་པའི་སྒྱུ་རྩལ་བཞེང་སྐྲུན་སྒྲུང་གཏམ་ཀློག་པའི་འདུན་པ་ཉམས་བཞིན་པའི་བྱེད་མཁན་དེ་བས་ཀྱང་མི་མཁོའམ།",
    "དཀར་ནག་འདྲེས་མའི་རྡོ་ཐལ་གྱིས་བྱུགས་ངོས།",
    "ཀུན་རྟོག་རི་མོར་འདྲི་བ་ཅི་ཞིག་མཚུངས།",
    "མོ་དག་བཅོས་མའི་ར་གན་ལྷད་ཀྱི་ཟོང་།",
    "སྒྲོ་བཏགས་གླེང་མོའི་མི་གཙང་ཕུང་བོའི་ལུས།",
    "རྫུན་ཕུགས་བགྲང་བྱའི་མཚན་མོའི་ཐུན་མཐར་རྡིབ།",
    "རྫོགས་པའི་བཤེས་གཉེན་འབོད་སྒྲོག་ཟླ་ག་ཞོན་ནུའི་ལང་ཚོ་དར་བའི་དཔྱིད་ཀྱི་དུས།",
    "༡དང་པོར་བརྡུངས་པའི་འཁྱོག་ཚིག་རྒྱུད་མངས་སྒྲས།",
    "མི་ཀུན་གྱི་གཟིགས་མོར་མཚར་བའི་གནས།",
    "འདིར་སྣང་དགེ་ལ་གཞོལ་བ་ཕྲ་མོའི་བློའི།",
    "སྐྱེས་མོད་གཞན་ལ་འཚེ་བ་ལྷུར་ལེན་པའི།",
    "མ་རུངས་ཡལ་ག་འཁྱོག་པོ་མི་ལྡན་པ།",
    "ཚེ་འདིའི་ཟ་འོག་བདེ་སྡུག་རི་མོ་ཅན།",
    "གཟིགས་པའི་ཟོལ་གྱིས་ཞལ་བཞི་སྤྲུལ།",
    "དྲང་སྲོང་དམོད་པར་སྒྲོ་བཏགས་ཏེ།",
    "རྣམ་བཀྲ་དཔྱོད་ལྡན་གཟིགས་མོར་འདི་ན་མཚར།",
    "དེ་རང་གི་ངང་ཚུལ་གཟུགས་བརྙན་འཆར་བཞིན་དུ།",
    "དེ་དག་སྐང་ཆད་གནའ་རྩོམ་པགཟིགས་མོར་ཕྱོགས་འདིར་ཡང་ཡང་འཁོར།",
    "ལྷའི་བུ་མོའི་མངོན་བརྗོད།",
    "བསྟིང་ཚིག་ཚིག་རྩུབ་མོའམ་འཕྱ་སྨོད་ཀྱི་ཚིག་འདུ་ཀུ་ལ།",
    "སྙན་ངག་གི་འགྲེལ་བ།",
    "སྐྱེས་ཁམས་རྩོམ་རིག་གི་འགན་འཁྲི།",
    "རང་གི་མི་རིགས་ལ་ཤ་ཞེན་ཆེ་དགོས་ན།",
    "རང་གི་མི་རིགས་ཞེས་པའི་མི་རིགས་ཀྱི་འཇོག་བྱེད་གང་ཡིན་ཞེ་ན།",
    "མི་རྒྱུད་ཀྱི་སྟེང་ནས་ཀྱང་བཞག་ཆོག་མོད་ཀྱང་།",
    "དེའི་སྟེང་དུ་རང་གི་སྲོལ་རྒྱུན་རིག་སུ་ལོག་ཟེར་བ་དང་།",
    "དོན་དམ་དུ་རང་ཉིད་མ་འཁྱོངས་པའོ།",
    "དེ་ལོ་ལྔ་སྟོང་གི་ཡན་ཆད་ཡིན་ཞིང་།",
    "གཉིས་པ་རེ་ཏེ་མགོ་པས་དགྲ་སྟ་ཁ་ཆེ་ཞེས་ཡུ་བ་རིང་ཞིང་།",
    "གསུམ་པ་སྲིན་པོ་རིགས་ཤིག་གི་མིང་ཡིན་ཞིང་།",
    "དེ་ས་ཆ་དང་མིའི་སྲིན་པོ་གཉའ་རེངས་ཁྲག་མིག་ཅེས་དེ་དུས་ཕལ་རིགས་ཤིག་གི་མིང་ཡིན་ངེས།",
    "དམག་འཁྲུག་གི་སྐབས་སུ་ཞེས་པ་ནི་སྒྱོགས་རྡོ་ཡིན་ཞིང་།",
    "མི་ལ་ལ་འདྲེ་འདྲ་འདྲ་ཞིག་རེད་ཅེས་བསམ་པ་བཙོག་པའམ་སྤྱོད་པ་ངན་པ་ལ་འདྲེ་ཟེར་བས།",
    "རྫ་ཆུའི་རྒྱུན་དེད་དེ་སོང་ན་འབྲི་ཆུ་ཡིན་ཞིང་།",
    "དོང་ནི་གི་ཤུབས་ཀྱི་མིང་སྟེ།",
    "ཀླུ་ཡུལ་ཞེས་པ་ཞིན་ཅང་གི་ས་ཆ་སྟེ།",
    "རང་རེའི་བོད་ཀྱིས་ཉེར་གཉིས་སྟེང་འདས་པ་ཡིན་ན།",
    "ས་གླང་དང་མེ་གླང་ཞེས་པ་དེ་དུས་ལོ་ལྔ་སྟོང་དང་དྲུག་སྟོང་གི་ཡན་ཆད་ཡིན་སྲིད།",
    "ས་སེམས་དཔའ་དང་བྲག་སྲིན་མོ་གཉིས་ལས་མཆེད་གླང་ཡིན་ན་དགུང་ལོ་གྱ་གཉིས་ཡིན་པས་ཡིག་ཚང་།",
    "རེན་ནའེ་ཆང་གི་འབྱུང་ཁུངས་བོད་ཀྱི་གཏམ་རྒྱུད་དེར་ཐུག་གིས་ཀྱང་འདིར་དཔྱད་པ་བཏང་ཡོད།",
    "སྤྱི་ལོའི་གོང་གི་ལོ་ཡིན་སྙམ་ནས་དཔྱད་པ་བཏང་།",
    "དེའི་ལོ་བཞི་སྟོང་ལྔ་སྟོང་གི་སྔོན་དུ་པ་མང་བོས་ཁས་ལེན་བཞིན་ཡོད་ཀྱང་།",
    "དེ་དག་གིས་ལྡོག་ཕྱོགས་པ་གཏང་དགོས།",
    "མི་ལུས་ཐོབ་ཏུ་རུང་བའི་དུས་གཟིགས་ནས།",
    "ཆུབ་སེམས་དཔའ་དང་བྲག་སྲིན་མོ་གཉིས་ལས་མི་ད་ལྟ་ང་ཚོས་བསམ་བློ་བཏང་ན།",
    "ཁྱོད་རྐང་རྗེན་ཡིན་པས་རྐང་བ་མི་གྲང་བ་ཨེ་ཡིན།",
    "ཞིལ་མཛེས་པ་ལྷ་དང་ལྷ་མོ་ལྟ་བུ་ཞེས་ཧ་ཅང་མཛེས་པ་ཞིག་ཏུ་བརྩི་བ་དེ་བཞིན་ཡིན།",
    "ཡི་དྭགས་ཀྱི་རིགས་ནི་དེང་སང་གི་ཧྥེ་གླིང་།",
    "ཀློ་དང་མོན་ལྟར་སྤྱོད་པའི་བོད་ཡུལ་གང་།",
    "བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་གྱི་ཨ་ཁུ་བསམ་འགྲུབ་རྒྱ་མཚོ་ཚང་ཡང་མཇལ་སྐོར་དུ་གནས་དེར་ཕེབས།",
    "གླ་རྩི་སོགས་ལ་བརྗེ་རེས་བྱེད་བཞིན་ཡོད།",
    "དངོས་པོ་རྣམས་གནས་དེར་ཚོང་ཁང་ལྟ་བུར་བསྒྲིགས་ནས་མི་རྣམས་ཐག་རིང་དུ་སོང་ཤུལ་ནས།",
    "ཉོན་མོངས་ཆེ་ཞིང་འགྲན་སེམས་ཕྲག་དོག་རྒྱས།",
    "སྐབས་དེར་ནུབ་ཕྱོགས་ན་ཆང་གི་རིགས་བརྒྱ་དང་ལྔ་བཅུ་ཡོད་པར་བརྗོད་ཡོད།",
    "དེས་ན་སྐབས་དེའི་སློབ་དཔོན་པདྨ་འབྱུང་གནས་དང་སྤྱན་རས་གཟིགས་སོགས་ལྷ་རྣམས་ཀྱི་མིང་ནང་དུ་དྲངས་པ་རེད་བསམས།",
    "སྟག་གཟིག་རྒྱལ་པོ་བྱ་ལ་ཁྲ་ལྟར་རྒྱུགས།",
    "ཁྲོམ་གེ་སར་ནི་ཕལ་ཆེར་ཐུར་ཁེ་ཡིན་རྒྱུ་རེད་བསམས།",
    "ཤིང་ལ་སྟ་ལྟར་འཚབ་ཅེས་པ་ཤིང་སྟེང་དུ་སྟ་རེས་གཙེས་པ་བཞིན་དུ།",
    "དེའི་རྗེས་ཀྱི་གནམ་རི་སྲོང་བཙན་ནི་སོ་གཉིས་པ་ལ་མཛུབ་མོས་བསྟན་པ་ནི་ནམ་མཁའ་ཡིན་པ་དང་སྲོང་བཙན་སྒམ་པོ་སོ་གསུམ་པ་ཡིན།",
    "སྲོང་བཙན་རིང་གི་རྩོམ་ཞང་ཞུང་རྒྱལ་པོ་ལིག་མི་རྒྱལ་གྱི་བག་མར་སོང་།",
    "དེའི་མི་ཚད་བཙན་སྒམ་པོས་ཕྱི་ནས་དམག་སྐོར་ཞིག་གྲ་སྒྲིག་དེང་སང་གི་དཔྱད་བརྗོད་པ་ལ་ལས་སུམ་རྟགས་ས་བྱས་པ་དང་།",
    "སྐབས་དེ་ནས་བཟུང་མ་སྲོང་བཙན་རང་གི་བཙུན་མོ་བྱས་པ་ཨེ་ཡིན་སྙམ།",
    "དམག་འཁྲུག་གི་མགོ་བརྩམས།",
    "དེའི་ནང་ནས་ཐོན་མིས་རྒྱ་གར་གྱི་རིག་རེད་ཟེར་ན།",
    "ར་ད་བ་པར་ཕན་ཚུན་གསོད་རེས་འཐབ་རེས་བྱས་ནས་ཕྱག་རྗེས་གསུམ་པ་ནི་ལྷ་རྟེན་ཇོ་བོ་རྣམ་ནང་མི་མཐུན་པའི་གནས་ཚུལ་ཆགས་ཤིང་།",
    "ཆབ་སྲིད་ཀྱི་བྱུང་བ་ཡིན་མོད།",
    "སོག་པོ་ཟེར་བ་དེང་སང་གི་བཙུགས་པ་ཡིན་ཡང་།",
    "གི་སོག་པོ་ཡིན་པའི་ངེས་པ་མེད།",
    "དེས་ན་སོག་པོ་ཟེར་བའི་མི་རིགས་ཞེས་པ་རྒྱ་གར་དུ་སོང་ནས་གྲྭ།",
    "སོང་བ་མ་གཏོགས།",
    "ཨ་ལགས་དུང་དཀར་ཚང་གི་དར་ནག་པོ་ཅན་གྱི་བོད་ཀྱི་དམག་རྒྱུད་ཡིན་ཅེས་ཚིག་མཛོད་དུ་ཚིག་འགྲེལ་བརྒྱབ་ཡོད་དེ།",
    "དེ་ནི་དེང་སང་གི་མཚམས་སུ་ས་ཆ་སྲུང་བ་དེའི་མིང་ལ་ནང་སོ་དང་།",
    "ཞིང་བདག་དང་ཕྱུག་བདག་གི་སྐོར་རོ།",
    "ཀྲུང་གོའི་ཀྱི་ཆུ་རྒྱུན་རིང་མོ་ནས་ཆགས་པའི་གཤིས་སྤྱོད་དང་།",
    "སྤྱི་ལོ་གོང་འོག་གི་ལོ་ངོ་སྟོང་ཕྲག་ཁ་ཤས་རྒྱུན་བཏོན་པས་འཇར་པན་གྱི་གནམ་བསྐོས་གོང་མའི་།",
    "གློག་སྒྲོན་མག་མོག་གི་འོག་ཏུ་སེམས་ཀྱིས་མྱོང་དུས།",
    "དཀའ་བ་དེ་དག་གིས་ཁྱོད་ལ་སེམས་ཀྱི་ནུས་ཤུགས་ཀྱི་གསོང་གཏམ་ཏག་ཏག་ཡིན་ཅེས་བརྗོད་པ་ལྟར།",
    "ང་ཚོས་སྣང་མེད་དུ་བཏང་བས་མང་བོ་ཞིག་བོད་ཀྱི་སྐྱེ་འཆིའི་དེབ་ཐེར་རྩབོར་བརླགས་སུ་ཕྱིན་ལ།",
    "དུས་རབས་པའི་དུས་མགོར་འབྲས་ལྗོངས་པ་ཡིན་མོད།",
    "འོན་ཀྱང་ཚན་རིག་ཆེས་ཆེར་དར་ནས་གྲྭ་བཙུན་ཟླ་བ་བསམ་འགྲུབ་ཀྱིས་དབྱིན་ཡིག་བའི་དེ་རིང་ང་ཚོ་བོད་ཀྱི་ན་གཞོན་དག་གིས་ཀྱང་ཏུ་ཕབ་ཅིང་།",
    "རྩོམ་པ་པོར་རྣམ་དག་གི་རིག་གཞུང་འདུ་ཤེས་དང་།",
    "དེ་སྔ་ང་ཚོའི་རྒྱུན་མཐོང་དད་ལྡན་པ་མང་བོའི་མིག་གི་བདུད་རྩི་རུ་གྱུར།",
    "དེས་འུ་ཅག་གི་སེམས་ཀྱི་རྨ་ཁ་ཡ་དེ་དག་ལས་བོད་བཙན་པོའི་རྒྱལ་རབས་ཀྱི་སྒྲིག་གསོ་དཔྱད་གང་ལ་གང་འཚམ་ཞིག་འོང་སྲིད།",
    "ཁོང་གིས་གསུངས་པ་ལྟར་ཐོག་པར་བ་ཞིག་ཡིན་པར་མ་ཟད།",
    "གཉིས་ཀ་མི་ཉན་པ་གསུམ་ནི་རང་གི་ཉེ་འབྲེལ་དང་།",
    "དེ་ཡང་ཚིག་ཀྱང་སྔ་ས་ནས་ཆོད་གཏམ་མེད་པར་ནན་ཏན་གྱིས་གི་སྦྱོར་བ་བབ་ཆགས་ཤིང་རང་བཞིན་ཡུལ་སྐད་ཀྱི་བཀླག་རྒྱུ་ནི་ཤིན་ཏུ་ནས་གལ་ཆེ།",
    "འཇིག་རྟེན་མི་སྐོར་གྱི་བྱ་དགའ་ཡོད་པའི་རྩོམ་སྡུད་བྱ་འགུལ་ཕུན་ཡིས་སའི་གོ་ལ་དང་སའི་གོ་ལའི་ཚེ་སྲོག་གི་འཚོ་སུམ་ཚོགས་པའི་ངང་མཇུག་བསྡུས་ནས།",
    "སྦྲང་ཆར་གྱིས་བྱ་དགའ་ཐོབ་པའི་རྩོམ་པ་པོ་རྣམ་པར་ལྷག་བསམ་བོད་ཀྱི་རྩོམ་རིག་གི་མཚོན་སྟངས་རྣམ་པའི་ཁྲོད།",
    "སྦྲང་ཆར་ཞེས་པའི་བོད་ཡིག་གི་རྩོམ་རིག་སྒྱུ་རྩལ་གྱི་ཆུ་ཚད་ཅུང་མཐོ་བ།",
    "མཚོ་སྔོན་རྨ་ལྷོའི་བུད་མེད་རྩོམ་པ་པོ་བདེ་སྐྱིད་སྒྲོལ་མས་བྱ་དགའ་ཨང་གཉིས་པ་བླངས་སོ།",
    "ངས་དཔྱད་འདེམ་པ་རྣམ་པའི་དགོངས་འཆར་དང་རང་ཉིད་ཀྱི་མྱོང་ཚོར་ལྟར།",
    "དེང་གི་དུས་འདིར་རང་རེར་རྒྱུས་ཆེ་ཞིང་བརྩོན་སྙེག་གི་དམིགས་བྱར་གྱུར་པ་སྟེ།",
    "རང་ལ་མངའ་བའི་ཞིང་ཁམས་དང་རང་གི་དད་མོས་བྱ་ཡུལ།",
    "རང་གི་འཚོ་བའི་སྤྱོད་སྟངས་བཅས་འཛམ་གླིང་ཡོངས་ལ་སྔ་མོ་ནས་མངོན་སུམ་དུ་བསྟན་ཡོད།",
    "བོད་ལྗོངས་ཀྱི་རྩོམ་པ་པོ་ཀརྨ་ཀུན་ཁྱབ་ལགས་ཀྱི་སྔོ་ཡི་བུ་མོ་སྤུན་བདུན་གྱི་སྨྲེ་སྔགས་ཞེས་པ་དང་།",
    "དར་ཆེ་མི་རུང་བའི་གོ་རྟོགས་ཟབ་མོ་བྱུང་ཞིང་།",
    "མིའི་རིགས་ནི་རང་བྱུང་ཁམས་ཆེན་པ་ལགས་ཀྱི་ར་སྤུའི་འུར་རྡོ་ར་ཡི་མཇིང་བར་ཕོག་པོར་འཚོ་བའི་འགྲོ་བ་མཐའ་དག་གི་བྱེ་བྲག་ཡིན་ཅེས་པ་དང་།",
