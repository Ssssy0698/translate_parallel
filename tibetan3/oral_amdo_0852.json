    "ཟླ་བ་ནི་དངུལ་ཏེ་ར་ཏི་གསུམ་དང་བཅས་པའི་མན་ཆ་ཤྱི་གསུམ་མོ།",
    "བསྒྲུབས་ན་མཚན་གཅིག་གིས་འགྲུབ་པར་འགྱུར་རོ།",
    "སྦྲུལ་གྱི་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རི་མོ་དཀར་ནག་དུམ་བུ་སོ་སོར་ཕྱེ་ཞེས་བྱ་བ་ལ།",
    "དཀར་པོ་དང་ནག་པོ་ནི་དཀར་ནག་སྟེ་སྦྲུལ་གྱི་ལུས་ཀྱི་རི་མོ་དཀར་ནག་གི་ཆ་རྣམས་སོ་སོར་དབྱེ་བའོ།",
    "སྒྲུབ་པ་པོ་བདག་ཉིད་ཀྱི་འདོད་པའི་ཡུལ་རྒྱལ་པོའི་བུ་མོ་ལ་སོགས་པ་ལ་སྤྱོད་པར་འགྱུར་བའོ།",
    "ཞིབ་མོར་བཏགས་ཏེ་ཞེས་བྱ་བ་ནི་ཁ་དེ་ནས་ལིག་བུ་མིག་དལ་བུས་བླངས་ལ་ཕྱེ་མར་བྱས་ཏེ།",
    "རང་གི་ལྷའི་སྔགས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཕག་མོའི་སྔགས་ཏེ།",
    "རང་གི་ལྷའི་སྒྲས་དེའི་རྣལ་འབྱོར་བྱ་བར་སྟོན་ཏོ།་།",
    "སྐྱེས་བུ་གང་གི་ལུས་ལས་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "སྐྲ་གཡས་སུ་འཁྱིལ་བ་ཞེས་བྱ་བ་ནི་སྐྲའི་རི་མོ་གཡས་སུ་འཁྱིལ་བ་དང་ལྡན་ཞིང་རྩེ་མོ་འདུས་པའོ།",
    "གང་གི་ལུས་དེ་དག་གི་ལུས་ལ་དྲི་ཞིམ་པོ་དང་ལྡན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ལྷ་མོ་ཞེས་བྱ་བ་ནི་བོད་པའོ།",
    "སྐྱེ་བ་བདུན་པའི་མཐུ་གཞན་ཡང་གསུངས་པ་ལྷ་མོ་དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་དེ་ནི་རོའོ།",
    "དོན་དེ་གསལ་བར་བྱེད་པའི་གཞུང་གི་ཚོགས་ནི་རིམ་པར་ཕྱེ་བ་སྟེ་དྲུག་པའོ།",
    "འདིས་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "གལ་ཏེ་སྐྱེས་པ་ནང་གི་སྟོན་པ་དེའི་ཚེ་མཐེ་བོ་དང་མཛུབ་མོ་རྣམས་ཀྱི་རྩེ་སོ་སོར་སྤྲད་ལ་སོར་མོ་ལྷག་མ་ཅུང་ཟད་བསྐུམ་པའི་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།",
    "ཉི་མ་ཞེས་བྱ་བ་ནི་ཁ་ཅིག་ན་རེ་གཞོགས་གཡས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཆུ་བོ་ཞེས་བྱ་བ་ནི་ལག་པས་ནམ་མཁའ་ལ་རི་མོ་གྱ་གྱུ་འབྲི་བའོ།",
    "རྒྱ་མཚོ་ཞེས་བྱ་བ་ནི་སོར་མོ་རྣམས་བརྐྱང་སྟེ་སྤྲུག་ཅིང་ནམ་མཁར་བསྐྱོད་པའོ།",
    "དེ་ནས་ཞེས་བྱ་བ་ནི་ཐུན་མོང་གི་བརྡ་བསྟན་པའི་འོག་ཏུའོ།",
    "དེ་དག་གི་བརྡ་བསྟན་པའོ།",
    "ཁྲག་གི་གནས་ཞེས་བྱ་བ་ནི་སྙིམ་པས་ཁྲག་འཐུང་བ་ལྟར་བྱེད་པའོ།",
    "ད་ནི་དེ་དག་གི་རང་བཞིན་གྱེས་གྲུབ་པའི་མཚན་མ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁ་ཅིག་ན་རེ་བཟློག་སྟེ་བལྟ་བའོ་ཞེས་ཟེར་རོ།",
    "སྨད་ནི་རྣམ་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ལྟེ་བའི་འོག་གི་ཆ་མི་གསལ་བ་ཡིན་ནོ།",
    "རི་མོ་གསུམ་པོ་ཡོངས་སུ་ཟླུམ།",
    "ཞེས་བྱ་བ་སྟེ་ལྟེ་བའི་འོག་ན་རི་མོ་གསུམ་སྦས་ནས་ཡོད་པའོ།",
    "ལྟེ་བ་ཅུང་ཟད་འཕྱང་ཞིང་རི་མོ་གསུམ་དུ་གསལ་ལ་གཡས་ནས་ཀུན་དུ་འཁྱིལ་བ་སྟེ།",
    "རི་མོ་གསུམ་ཟླུམ་པོར་འཁྱིལ་བས་ཀུན་དུ་བརྒྱན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "སོང་བའི་ས་ལས་ཞེས་བྱ་བ་ལ།",
    "གང་དུ་སོང་བའི་ས་དེ་ནས་ཐ་མལ་པར་སླར་མི་ལྡོག་པའོ།",
    "ཞེས་བྱ་བ་ལ་སྒྱུ་མ་ཆེན་མོ་ནི་རྡོ་རྗེ་ཕག་མོ་སྟེ་དེ་དང་མཉམ་པར་སྦྱོར་བ་ནི་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ཡིན་ལ་དེ་ལས་སྐྱེས་པའི་མཁའ་འགྲོ་མ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ལག་པའི་ཕྱག་རྒྱའི་སྦྱོར་གྲུབ་ནི་སྤྱི་གཙུག་ཏུ་རེག་པའི་བརྡ་ལ་སོགས་པའོ།",
    "དོན་དེ་གསལ་བར་བྱེད་པའི་གཞུང་གི་ཚོགས་ནི་རིམ་པར་ཕྱེ་བ་སྟེ་བདུན་པའོ།",
    "དེ་དག་ཉིད་ལྷ་མོ་སྟེ་གཟུགས་སྣ་ཚོགས་སུ་གསལ་བའི་ཕྱིར་རོ།",
    "གང་ཞིག་ཅེས་བྱ་བ་ནི་གང་གི་ཆེའོ།",
    "སོར་མོས་སོར་མོ་སྟོན་པ་ནི་སོར་མོ་ནང་ཕན་ཚུན་དུ་སྟོན་པའོ།",
    "གང་ཞིག་ཁྲོ་གཉེར་ལ་རེག་པ་ཞེས་བྱ་བ་ནི་སྨིན་མའི་དབུས་སུ་ལག་པ་བརྡེགས་པའོ།",
    "ཁ་ཅིག་ན་རེ་པུས་མོ་གཉིས་ས་ལ་བཙུགས་ཏེ།",
    "ངག་གི་བརྡ་ཞེས་བྱ་བ་ལ་ངག་ནི་ཚིག་ཏུ་བརྗོད་པའོ།",
    "པོ་ཏང་གི་ཞེས་བྱ་བ་ནི་པོ་ཏང་གི་ཞེས་བྱ་བ་ཚིག་ཏུ་འདོན་པའོ།་།",
    "པྲ་ཏི་པོ་ཏང་གི་ཞེས་བྱ་བ་ལ་པྲ་ཏི་སླར་བཟློག་པ་སྟེ་ལན་ནོ།",
    "ག་དུམོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡང་ཚིག་ཏུ་བརྗོད་པར་བལྟ་བར་བྱའོ།",
    "འདའ་ཀི་ནི་སྲིང་མོའོ་ཞེས་བྱ་བ་ལ་འདའ་ཀི་ནི་དང་ཏ་ལི་ཀ་དང་སྲིང་མོ་རྣམས་ནི་དོན་གཅིག་གོ།",
    "མེ་ཏ་ཀ་ནི་གླུམ་མོ་ཞེས་བྱ་བ་ལ་གླུམ་ནི་སྦང་མའོ།",
    "ཆེ་གེ་མོ་ནས་ཞེས་བྱ་བ་ནི་གནས་ཆེ་གེ་མོ་ནས་འོངས་པའོ།",
    "དེ་རྣམས་ཀྱི་བརྡ་ནི་དེ་རྣམས་ཀྱི་ལུས་དང་ངག་གི་མཚན་མའོ།",
    "དོན་དེ་གསལ་བར་བྱེད་པའི་གཞུང་གི་ཚོགས་ནི་རིམ་པར་ཕྱེ་བ་སྟེ་བརྒྱད་པའོ།",
    "ལྷ་མོ་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པའི་མཁའ་འགྲོ་མ་རྣམས་སོ།",
    "གང་གི་རང་བཞིན་ཡང་དག་པར་སྐྱེ་བ་དང་འགག་པ་མེད་པ་དེ་ནི་ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟེ་དོན་དམ་པར་རོ།",
    "སྡང་བ་ཐམས་ཅད་ནི་ཉོན་མོངས་པ་རྣམས་སོ།་།",
    "རྟ་ནི་རྟ་ཉིད་དེ་འཁྲུལ་འཁོར་གང་དུ་སྔགས་རྣམས་རིགས་ལྡན་དང་རྟའི་འགྲོས་དག་གིས་དགོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་བཞིན་དུ་རོ་ལངས་ཟུང་ནི་རོ་ལངས་ཟུང་གི་ཚུལ་དུ་བྲིས་པའོ།",
    "ཞེས་བྱ་བ་ལ་སྟོང་པ་ནི་ཕྱི་རོལ་པདྨའི་རི་མོའོ།",
    "རེའུ་མིག་བཞི་བཅུ་དགུར་ལྡན་པ།",
    "རེའུ་མིག་ནི་རེའུ་ཆའོ།",
    "བཞི་བཅུ་དགུ་ནི་གྲངས་ཏེ་ལྔ་བཅུར་གཅིག་གིས་མ་ཚང་བར་བྲི་བའོ།",
    "དབུས་ཀྱི་རེའུ་མིག་སྟོང་པ་ལ།",
    "ཞེས་བྱ་བ་ནི་ཕྱོགས་མཚམས་ཀུན་དུ་རེའུ་མིག་གསུམ་གསུམ་བོར་བའི་དབུས་མ་གང་ཡིན་པ་ནི་སྟོང་པའི་རེའུ་མིག་སྟེ་དེར་བྲི་ཞེས་བྱ་བ་དང་འབྱེལ་ཏོ།",
    "འཁོར་ལོ་རི་མོ་གཉིས་བསྐོར་ལ།",
    "ཞེས་བྱ་བ་ནི་དེའི་འོག་ཏུ་ཕྱི་རོལ་རི་མོ་གཉིས་ཀྱིས་བསྐོར་བའོ།",
    "ད་ནི་རེའུ་མིག་བཞི་བཅུ་རྩ་དགུ་པའི་ཕྱི་རོལ་དུ་ཡི་གེ་རྣམས་དགོད་པ་གསུངས་པ།",
    "རི་མོའི་བར་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "རི་མོ་གཉིས་པོ་བསྐོར་བའི་བར་དུའོ།",
    "འཕེལ་བ་ལ་སོགས་པ་ཞེས་བྱ་བ་ནི་མ་ནིང་གི་ཡི་གེ་བཞི་མ་གཏོགས་པ་དབྱངས་ཀྱི་ཡི་གེ་བཅུ་གཉིས་རིམ་པ་བཞིན་དུ་བྲི་བའོ།་།",
    "རྀ་ཛཱ་ལོ་ཤཱ་ཞེས་བྱ་བ་ནི་དབྱངས་ཀྱི་ཡི་གེ་མ་ནིང་གི་མིང་ཅན་བཞིའོ།",
    "ཞེས་བྱ་བ་ལ་ཆོ་ག་ནི་ཡི་གེའི་གནས་ཀྱི་འཁྲུལ་འཁོར་རེའུ་མིག་བཞི་བཅུ་རྩ་དགུ་ནས་གྲུ་བཞིའི་བར་གྱི་ཆོ་ག་བྱའོ།",
    "དང་པོ་ནི་སྔགས་ཀྱི་འཁྲུལ་འཁོར་གྱི་རེའུ་མིག་དང་པོའོ།",
    "གཉིས་པ་ཡང་སྔགས་ཀྱི་འཁྲུལ་འཁོར་གྱི་རེའུ་མིག་གཉིས་པ་སྟེ།",
    "རེའུ་མིག་གསུམ་པ་ལ་གནས་པ།",
    "དེ་བཞིན་སྔགས་ཀྱི་རེའུ་མིག་གསུམ་པ་ལ་གནས་པ་སྟེ།",
    "རེའུ་མིག་བཞི་པར་གནས་ཞེས་བྱ་བ་ལ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "རེའུ་མིག་ལྔ་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཡང་སུ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "རེའུ་མིག་ལ་གནས་ཞེས་བྱ་བ་ནི་རེའུ་མིག་ཉིད་ཀྱི་བརྡའོ།",
    "མ་ནིང་གི་དང་པོ་ནི་རྀའོ།",
    "སུམ་ཅུ་དྲུག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཨོཾ་མོ།་",
    "བཞི་བཅུ་གཅིག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཨོཾ་མོ།",
    "ཡི་གེ་བཞི་བཅུ་རྩ་བརྒྱད་བཀོད་པའི་དབུས་ཀྱི་རེའུ་མིག་སྟོང་པ་ལ་ལྷ་སྦྱིན་བནྟ་ཁྱམོ་ཧ་ཡ་ཞེས་དགོད་པའོ།",
    "ཁ་ཅིག་ན་རེ་ག་ཎ་ཞེས་བྱ་བ་ནི་ལས་མང་པོའི་ཚོགས་ལ་བྱའོ་ཞེས་ཟེར་རོ།",
    "འདི་དག་ཀྱང་རེའུ་མིག་བཞི་བཅུ་རྩ་དགུ་ལ་བྲི་བ་སྟེ།",
    "རེའུ་མིག་དང་པོ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "ཧཱུཾ་གི་ལྟེ་བར་ནི་བསྒྲུབ་པར་བྱ་བའི་མིང་བསྐུལ་ཚིག་དང་བཅས་པར་བྲིས་ལ།",
    "རང་གི་ལག་པ་གཡས་པར་ཧཱུཾ་ལས་སྐྱེས་པའི་རྡོ་རྗེ་འབར་བར་བསམས་ནས་དེ་ལ་ཡང་དང་ཡང་དུ་བརྡེགས་པར་བསམས་ན་འཆི་བར་འགྱུར་རོ་ཞེས་སྟོན་ཏོ།",
    "ལྷ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྟ་དང་མ་ཧེའི་བུམ་པ་ཞེས་བྱ་བ་ནི།",
