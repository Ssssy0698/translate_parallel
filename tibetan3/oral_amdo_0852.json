    "དེ་ཉིད་སྒྱུ་མ་ཆེན་མོའི་རྣམ་པར་འཕྲུལ་པ་སྟེ་རྡོ་རྗེ་མཁའ་འགྲོས་རྣམ་པར་སྤྲོས་པའོ།",
    "དོན་དེ་གསལ་བར་བྱེད་པའི་གཞུང་གི་ཚོགས་ནི་རིམ་པར་བྱེད་པ་སྟེ་གཉིས་པའོ།",
    "འདི་ལྟར་སྡོང་པོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཡང་ལྗོན་ཤིང་གི་ངར་བ་ཁྱོ་འབའ་ཞིག་སྟོན་པ་མཐོང་ལ།",
    "གཞན་དུ་གཞུང་བསྙུས་པ་ཡིན་ན་དོན་རྒྱས་པར་སྟོན་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་ལུང་གི་གཙུག་ལག་ཐམས་ཅད་ཚེགས་ཆེ་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ལས་རྣམས་རྣམ་པར་འཕྲུལ་བ་ནི་གང་གིས་ལས་རྣམས་ཡོངས་སུ་སྤྲུལ་པ་སྟེ།",
    "དེ་རྣམས་ཀྱི་རིག་པ་ཆེན་མོ་ནི་སྔགས་ཀྱི་ཚིག་རྣམས་སོ།",
    "མར་ངོའི་ཚེས་བརྒྱད་དམ་བཅུ་བཞིའི་ནུབ་མོ་རོ་བསྲེགས་པ་ལ་ཤ་ཟའི་ཤིང་བུས་བསྐུལ་ཞིང་བྱས་ཏེ།",
    "དེའི་རྩེ་མོའི་ཆ་སོར་བརྒྱད་ཙམ་བཟུང་ནས་བ་སེར་སྐྱའི་རྭའི་ནང་དུ་བཅུག་སྟེ།",
    "མེ་དེ་ཉིད་ཀྱི་ནང་དུ་ཇི་སྲིད་ཤིང་ཐལ་བར་མ་གྱུར་གྱི་བར་དུ་རུ་བསྲེགས་ལ་དེ་བླངས་ནས་མིང་བཟུང་བ་སྔོན་དུ་འགྲོ་བས་དེ་ལ་ལན་བདུན་སྔགས་བཟླས་ཏེ།",
    "ཁང་པའི་ཕྱམ་མདུང་གི་གསེབ་ཏུ་སྦས་ན་ཇི་ལྟར་བསྟན་པ་བཞིན་དུ་འགྱུར་ཏེ་འདི་ནི་མན་ངག་གོ།",
    "ཡང་སྔ་མ་ལྟར་བསྲེགས་པའི་རྭ་ཁྲུདེ་ཉིད་ཀྱི་ནང་དུ་ཤ་ཟའི་ཤིང་གི་ཚེར་མས་བཀང་སྟེ་དེ་ཉིད་ཀྱི་ཉིན་པར་ཁང་སྟེང་དུ་བཞག་ན་ཤ་ཟའི་འཚེ་བ་དང་དྲན་པ་མེད་པར་འགྱུར་རོ།་།",
    "དེ་ཉིད་ཀྱིས་ན་བ་ལང་གི་གདོང་ཞེས་བྱ་སྟེ།",
    "གང་གི་སྔགས་ཀྱི་བཀའ་ཙམ་གྱིས་སྤྲིན་ཕྱིར་བཟློག་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ར་ཏི་ཞེས་བྱ་བ་ནི་དོན་མེད་པ་སྟེ་ལུང་ཙམ་མོ།",
    "བ་ལང་གི་གདོང་གི་ཆོ་ག་གསུངས་པ།",
    "ཁྱུ་མཆོག་གི་རྭ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བ་ལང་གི་གདོང་གི་ཆོ་ག་ཡང་འདི་ཉིད་དོ་ཞེས་བྱ་བ་ནི་བ་ས་ཧ་ཏོ་ལིའི་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་ཀྱིས་ཀྱང་སྦྱོར་བ་འདི་བྱའོ།",
    "ན་ཡ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྔགས་གསུམ་པ་ཡིན་ཏེ།",
    "དེ་ལ་ན་མོ་བྷ་ག་བ་ཏི་ཞེས་བྱ་བ་ལ་སོགས་པ་རྐང་པ་བརྒྱད་པ་དང་།",
    "ཨོཾ་བི་ག་ལེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་གསུམ་མོ།",
    "ཡན་ལག་གི་ཆ་ཤས་ཐམས་ཅད་ནས་རྡོ་རྗེ་མཁའ་འགྲོ་མ་སྤྲོ་ཞེས་བྱ་བ་ནི་རང་གི་ལུས་ཀྱི་ས་བོན་ལས་རྡོ་རྗེ་མཁའ་འགྲོ་མ་རྣམས་སྤྱོ་སྟེ།",
    "མེའི་དཀྱིལ་འཁོར་གྲུ་གསུམ་ལ་རྩེ་མོ་བདུན་རྨིས་ཉེ་བར་མཚན་པའོ།",
    "རེ་མིག་དགུ་པར་ཏེ།",
    "རི་མོ་ཟླུམ་པོ་ལ་ཐིག་བཞི་བྲིས་པས་རེའུ་མིག་དགུར་འགྱུར་ཏེ།",
    "དབུས་ཀྱི་རེའུ་མིག་ཏུ་ཀླུ་ལྷག་མ་ཅན་གདེངས་ཀ་བདུན་ལ་སོགས་པ་དང་ལྡན་པར་བྲི་སྟེ་གོ་སླའོ།",
    "ཐམས་ཅད་ཀྱི་ལག་པ་གཡས་ན་རལ་གྲི་ཐོགས་པའོ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ཀྱི་ཐུན་མོང་དུ་གཡས་ཀྱིས་རལ་གྲི་བཟུང་ལ།",
    "གཡོན་གྱིས་གདེངས་ཀ་གསུམ་དང་ལྡན་པའི་ཀླུ་མོ་ལ་འཁྱུད་པའོ།",
    "མཐེ་བོ་ཁ་སྦྱར་ཏེ་བཅིངས་ལ་ཞེས་བྱ་བ་ནི་མཐེ་བོ་དང་མཛུབ་མོ་རྩེ་སྤྲད་པའོ།",
    "ཞེས་བྱ་བ་ཁམ་ཕོར་ཀྱི་སྟེང་དུ་བསྒོམས་པའི་རྡོ་རྗེ་མཁའ་འགྲོའི་ཚོགས་ལ་འཐོར་དུ་བར་བསམ་མོ་ཞེས་བྱ་བ་ནི་དེར་ཆུའི་སྦྱིན་སྲེག་བྱའོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་བཅིངས་པའི་མཛུབ་མོའི་རྩེ་མོར་ཧཱུཾ་གཉིས་བསྒོམས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "མཐེའུ་ཆུང་གཉིས་བསྒོགས་གེཏེ་མཛུབ་མོ་གཉིས་བསྒྲེང་བའོ།",
    "དེ་ལྟར་བདག་ཉིད་རྡོ་རྗེ་མཁའ་འགྲོར་བསྒོམས་པའི་འུ་བསམ་གཏན་འབའ་ཞིག་གིས་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་གང་གི་ཟིལ་གྱིས་གནོན་པར་བྱེད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "བླ་རེ་དམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "བླ་རེ་དམ་པ་ཞེས་བྱ་བ་ནས།",
    "ཀླུ་མོ་དང་ནི་བཅས་པར་དགོད།",
    "དེའི་གཡས་གཡོན་གཉིས་ཀར་ཀླུ་མོ་གདེངས་ཀ་གསུམ་གསུམ་དང་ལྡན་པར་བྲིའོ།",
    "སྤྲིན་རྣམས་ཀྱི་བར་དུ་ཀླུ་ཕལ་པ་བརྒྱད་གསུངས་པ་ནི་མན་ངག་གིས་ན་དཀྱིལ་འཁོར་གྱི་སྣམ་བུ་གཉིས་པའི་སྒོ་བཞི་དང་གྲྭ་བཞིར་མགོ་བོ་གཉིས་གཉིས་དང་མཇུག་མ་གཉིས་གཉིས་ཀྱི་བར་བར་དུ་བཞི་བཞིར་བྲི་བར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "བདག་ཉིད་འཐོར་ཐུང་དང་ཉེ་རེག་བྱས་ཏེ།",
    "དེ་ཡང་དམ་ཚིག་གི་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བྱ་བས་དགུག་པ་ལ་སོགས་པ་བྱས་ལ།",
    "ལག་པ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཐེའུ་ཆུང་དང་མཐེ་བོ་བརྐྱང་ལ་མཐེ་བོའི་སྟེང་དུ་གཡས་པའི་གྲུ་མོ་བཙུགས་ཏེ།",
    "གཡས་པའི་སོར་མོ་རྣམས་སྦྲུལ་མགོ་ལྟར་བྱས་པ་འདི་ནི་ཀླུ་རྣམས་ཀྱིའོ།",
    "བུད་མེད་གཉིས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "མིང་དང་ལྡན་པ་ཞེས་བྱ་བ་ནི་བུད་མེད་ཀྱི་ཐོད་པར་ངེས་པར་ཤེས་པས་ན་མིང་སྟེ།",
    "ཤེས་པ་དེ་དང་ལྡན་པ་ནི་ཐོད་པ་སྟེ་རང་གི་རྐྱེན་ཅན་ནོ།",
    "མེའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་གྲུ་གསུམ་པ་རྩེ་མོ་བདུན་པར་གཉི་ག་ཞུལ་བྲི་བའོ།",
    "དབུས་སུ་བསྒྲུབ་པར་བྱ་བའི་བུ་མོའི་མིང་བྲིས་ཏེ་ཞེས་བྱ་བ་ནི་དགུག་པར་བྱ་བའི་ཁྲུ་བུ་མོའི་མིང་ཆེ་གེ་མོ་ཨཱ་ཀཱཪྵ་ཡ་ཞེས་བསྐུལ་ཚིག་དང་བཅས་པར་བྲིའོ།",
    "རི་མོ་གསུམ་གྱིས་བསྐོར་ནས་ཞེས་བྱ་བ་ཉིད་མོ་ཛའི་ས་བོན་ནམ་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྟན་ཏེ།",
    "ཡི་གེ་མོ་ཛའི་རེ་ཕས་དཀྱིལ་འཁོར་གཉི་ག་སུམ་རིམ་དུ་བསྐོར་བའོ།",
    "སྟེང་འོག་གི་བྱེ་བྲག་ཤེས་པར་བྱས་ལ་ཞེས་བྱ་བ་ནི་ཀོ་ཁྱརོ་ཙ་ན་དང་ཁྲག་གིས་འདི་ནི་སྟེང་ངོ།",
    "སྔགས་ནི་ཨོཾ་ན་མོ་བྷཱ་ཛེེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ནམ་མཁའ་ལ་བཞག་ལ་ཞེས་བྱ་བ་ནི་ཀ་ཏམ་པ་ལ་སོགས་པའི་ཤིང་གི་མེ་འབར་བའི་སོལ་བ་ལ་མ་རེག་པར་སྟེང་དུ་ཁམ་ཕོར་གཉིས་བསྲོ་བའོ།",
    "གང་གིས་ཤེ་ན།",
    "ནོར་བུ་བསྣམས་ཤིང་ཉི་མའི་གདན་ལ་གཡས་བརྐྱང་གིས་བཞུགས་པ།",
    "སྐྲ་ཁམ་པ་གྱེན་དུ་འབར་ཞིང་སྦྲུལ་གྱི་རྒྱན་ཅན་སྟག་གི་པགས་པའི་ན་བཟའ་བགོས་པའི་སྟོབས་པོ་ཆེར་བསྒོམས་ལ་ཁམ་ཕོར་ལ་བརྒྱད་བརྒྱ་བཟླས་ཏེ།",
    "ཨོཾ་ན་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དོན་དེ་གསལ་བར་བྱེད་པའི་གཞུང་གི་ཚོགས་ནི་རིམ་པར་ཕྱེ་བ་སྟེ་གསུམ་པའོ།",
    "ཡང་ན་མཚན་ཕྱེད་ན་ཇི་སྲིད་འོང་གི་བར་དུ་བཟླའོ།",
    "ཨོཾ་ཙ་མུཎྜི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ལྷ་མོ་ཙ་མྱུཎྜིའི་སྔགས་སོ།",
    "སྟེང་གི་ཆ་ཞེས་བྱ་བ་ཆ་སྟེང་མ་སྟེ།",
    "འོག་གི་ཆ་ཕུར་པའི་གཟུགས་རྩེ་གཅིག་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཁ་ཅིག་ན་རེ་བ་འུ་སུ་ཀའི་གཟུགས་ཁམ་ཕོར་གྱི་སྟེང་དུ་བཞག་ལ་ཨ་ཤོ་ཀའི་ཡལ་གས་བཀབ་སྟེ།",
    "དཀར་གསུམ་གྱི་གཏོར་མ་དུས་གསུམ་དུ་བྱིན་ལ་སྟེང་ན་གནས་པའི་བུམ་པ་བུ་ག་ཕྲ་མོ་ལས་ཆུ་རྒྱུན་འཛག་པས་རྒྱུན་མི་འཆད་པར་བཀྲུ་ཞིང་སྐབས་སྐབས་སུ་གུ་གུལ་གྱིས་བདུག་པ་དང་།",
    "ཇི་ལྟར་གཞུག་ཅེ་ན་ཆེ་གེ་མོའི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "གླང་གི་ལྕི་བ་ནི་ཁྱུ་མཆོག་གི་ལྕི་བ་སྟེ།",
    "འདིས་ནི་ཁྱུ་མཆོག་གི་ལྕི་བ་ས་ལ་མ་ལྷུང་བ་ལ་སྔགས་ལན་བདུན་བཟླས་ཏེ་བྱི་བའི་ཁུང་སྒོ་གནམ་དུ་བལྟས་པའི་ནང་དུ་བཅུག་ན་ཇི་སྐད་སྨོས་པ་བཞིན་དུ་འགྱུར་རོ།",
    "བློ་གྲོས་ཆེན་མོ་ཞེས་བྱ་བས་ནི་ལྷ་མོ་ལ་བོད་པ་སྟེ།་",
    "གང་ལ་བློ་གྲོས་ཆེན་པོ་ཡོད་པ་དེ་ནི་བློ་གྲོས་ཆེན་མོ་སྟེ་བཅོམ་ལྡན་འདས་མའོ།་།",
    "མདུན་ནས་ཏེ་ཞེས་བྱ་བ་ནི་གདོང་གིས་བལྟས་པ་སྟེ་སྤྲིན་གྱི་ཕྱོགས་སུ་གདོང་པ་བལྟས་པའོ།",
    "དེ་དག་གིས་ནི་",
    "བུད་མེད་ཉལ་བའི་སྔས་ཀྱིས་གཞི་ལ་ཟི་བའོ།",
    "ཆགས་པར་བྱ་བའི་བུ་མོ་ལ་སོགས་པའོ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པའི་རང་གི་ལྷར་བྱས་ལ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ལ་སོགས་པ་རྡོ་རྗེས་མཚན་པའི་རང་གི་ལུས་ཀྱི་གཟར་བུས་ཆུ་གཏོར་བར་བྱའོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "རྡོ་རྗེ་སོ་ཅན་གྱི་ཁྲག་གིས་བྲིས་ལ་སྐུད་པ་དམར་པོས་དཀྲི་བར་བྱའོ་ཞེས་བྱ་བ་དང་འབྱེལ་ཏོ།",
    "རྡོ་རྗེ་སོ་ཅན་ཞེས་བྱ་བ་ནི་མཛུབ་མོ་སྟེ་རྡོ་རྗེ་མཆེ་བ་ཅན་ཞེས་ཟེར་བའི་ཕྱིར་རོ།",
    "ཨོཾ་ཞེས་བྱ་བ་ནི་མན་ངག་གིས་ཤེས་པར་བྱའོ།",
    "སོ་ཕག་གི་དབུས་སུ་ཞེས་བྱ་བ་ནི་སོ་ཕག་ཁ་སྦྱར་བའི་དབུས་སུའོ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ།",
    "ལྷག་མའི་ཕྱག་གིས་ལྕགས་ཀྱུ་དང་།",
    "ནོར་བུ་བསྣམས་ཤིང་རོལ་པའི་གཟུགས་ཅན་པདྨའི་སྟེང་དུ་ཉི་མ་ལ་གཡོན་བརྐྱང་གིས་བཞུགས་པ་ལྷའི་རྒྱན་ཅན་སྤྱན་གསུམ་པ།",
    "ཊཀྐི་རཱ་ཛར་བསྒོམས་ལ་གྲོ་གའམ་རས་ལ་མཛུབ་མོའི་ཁྲག་དང་ཤིང་ཛཱ་ཏིའི་སྨྱུ་བླུ་གུས་ཡི་གེ་ཡརི་དབུས་སུ་ཨོཾ་ཊཀྐི་ཛཚོཧཱུཾ།་",
    "ལྷ་སྦྱིན་ཕྱྭན་ཡ་ཨོཾ་ཊཀྐི་ཛ་ཧཱུཾ་ཞེས་བྱ་བ་བྲིས་ལ་སོ་ཕག་ཁ་སྦྱར་བའི་དབུས་སུ་བཅུག་སྟེ་སྐུད་པ་དམར་པོས་དཀྲིས་ནས་གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་གཡས་པ་མནན་ལ།",
    "བདག་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་བདག་ཉིད་ནི་སྒྲུབ་པ་པོ་བདག་ཉིད་དང་བསྒྲུབ་པར་བྱ་བའི་བུ་མོའོ།",
    "བུ་མོའི་ཁ་ནས་ཞེས་བྱ་བ་ལ།",
    "དེའི་སྣ་སྒོ་གཡོན་པ་ནས་བདག་གི་སྣ་སྒོ་གཡས་པར་འཇུག་པའོ།",
    "བདག་ཉིད་རྨ་དམར་པོ་ལས་ཡིད་དུ་འོང་བའི་བུ་མོའི་གཟུགས་སུ་བསྐྱེད་དེ།",
    "བསྒྲུབ་པར་བྱ་བ་ཡང་དེ་བཞིན་དུ་བསྐྱེད་ནས་བདག་གི་སྣ་སྒོ་གཡོན་པ་ནས་འོད་ཟེར་ཕྱུང་སྟེ།་",
    "བུད་མེད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "བུད་མེད་ཀྱི་གཅི་བའི་ཤུལ་གྱི་ས་ཞེས་བྱ་བ་ནི་གང་དང་གང་དུ་གཅི་བ་བྱས་པའི་ས་སྟེ།",
    "དེ་དང་རང་གི་གཅི་བའི་ཤུལ་གྱི་ས་གཅིག་ཏུ་བྱས་ལ།",
    "སྔགས་ལན་བདུན་བཟླ་ཞེས་བྱ་བ་ནི་ཙ་མུཎྜི་ལ་སོགས་པའི་སྔགས་རང་གི་མཚན་མ་ལ་ལན་བདུན་བཟླ་བའོ།",
    "ལྷའི་འཇིག་རྟེན་ཞེས་བྱ་བ་ནི་ལྷའི་བུ་མོ་རྣམས་སོ།",
    "ཁ་ཅིག་ན་རེ་དུག་དང་སྐེ་ཚེས་ཆེ་གེ་མོ་ཨུ་ཙ་ཏ་རྒྱ་ཡ་ཞེས་བྱ་བའི་བསྐུལ་ཚིག་བྱཱ་མ་ཝནྟ་ཡ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་དང་སྤེལ་ཏེ་བྲིས་ལ་སྔགས་དེ་ཉིད་བཟླས་ན་བསྐྲད་པར་འགྱུར་རོ་ཞེས་ཟེར་ཏེ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་ནག་པོ་ཆེན་པོའི་རྣལ་འབྱོར་ལ་གནས་ཏེ།་",
    "ཁ་ཟས་དེ་བསྒྲུབ་པར་བྱ་བའི་གཟུགས་སུ་བསམས་ནས་ཁྲོ་བ་དང་བཅས་ནས་ཆང་བུ་གཅོད་པའི་ཚེ་ཆེ་གེ་མོའི་མགོ་བཅད་པར་བསམ་ཞིང་བུཁར་འཇུག་པའི་ཚེ་ཆེ་གེ་མོའི་མགོ་ཟ་བར་བསམས་ནས་སོས་བཏབ་སྟེ་ཕྱེད་ཁར་ལྡད་ཁྱེཅིང་ཕྱེད་བསྒྲུབ་བྱའི་ཕྱོགས་སུ་འཕངས་པའི་ལས་འདི་ཉི་མ་བདུན་དུ་བྱས་ན་ཇི་སྐད་སྒོས་པ་བཞིན་དུ་འགྱུར་རོ།",
    "ཨོཾ་ཨ་ལི་བྷི་ཁྱེལི་བྷ་ར་ཙུ་ལི་ཆེ་གེ་མོ་སྟེ་བྷ་ན་ཀུ་རུ་སྭཱ་ཧཱ་ཞེས་སྤེལ་ཏེ་བྲིའོ།",
    "དཔའ་བོ་གཡུལ་དུ་བསད་པའི་རས་ལ་བུ་མོ་བྲིས་ན་འོང་བར་འགྱུར་རོ་ཞེས་བྱ་བ་དང་འབྲེལ་ཏོ།",
    "རི་མོ་སྟེ་ཚོན་གྱིས་བྲི་བའོ།",
    "བ་ལང་གི་རྡུལ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་བ་ལང་གི་རྡུལ་ནི་བ་ལང་གི་སྤུའོ།",
    "འདིར་མན་ངག་གིས་ན་རང་གི་དབྱེབས་དང་ཁ་དོག་ཇི་ལྟ་བ་བཞིན་དུ་པིར་གྱིས་བྲི་བ་ལ་བྱའོ།",
    "ལག་པ་གཡས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཕྱག་དང་པོ་གཉིས་ཏེ་མན་ངག་གིས་ནི་ཕྱག་དྲུག་པ་ན་ཐོ་བ་དང་།",
    "ལན་སྟོང་དུ་བཟླས་ན་རེངས་པར་འགྱུར་རོ།",
    "མེད་ན་ལུས་དང་ངག་གི་བྱ་བ་ལྟ་ཅི་སྨོས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕ་རོལ་གྱི་དཔུང་གི་ཚོགས་དང་སྤེལ་ན་ཞེས་བྱ་བ་ལ།",
    "རྒྱལ་མཚན་གྱི་རྩེ་མོ་ལ་བཏགས་ནས་སྒྲུབ་པ་པོ་རྟ་ལ་སོགས་པ་ལ་ཞོན་ཏེ་གཡུལ་དུ་ཞུགས་པ་ལ་ཕ་རོལ་ཀྱི་དཔུང་གི་ཚོགས་ཀྱི་སྟེང་དུ་སྣ་ཚོགས་རྡོ་རྗེས་མཚན་པའི་རི་རབ་ཀྱིས་མནན་པར་བསམས་ལ།",
    "ཕྲེང་གཉིས་པའི་མཐར་བསྒྲུབ་བྱའི་མིང་གི་ཡི་གེ་དང་སྤེལ་ཏེ་ཞེས་བྱ་བ་ནི་ཨོཾ་དེ་བ་དཏྟ་སྟམྦྷ་ཁྲུཧྲི་དེ་བ་དཏྟ་ཏྲི་ཞེས་བྱ་བ་ལ་སོགས་པའམ།",
    "ཡང་ན་སྔགས་ཀྱི་ཡི་གེ་རེ་རེའི་མཐའ་མར་བསྒྲུབ་བྱའི་མིང་གི་ཡི་གེ་རེ་རེ་སྤེལ་བ་སྟེ།",
    "ཁམ་ཕོར་ཞེས་བྱ་བ་ནི་རྩ་བ་ནག་པོ་རི་མོ་མེད་པའོ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་སྔ་མ་ལྟར་བྲིས་པའི་ཤིང་ལོ་ལ་སོགས་པ་ཁམ་ཕོར་དུ་བཞག་སྟེ།",
    "ལྕོ་སྐམ་གྱི་ཐལ་བས་བཀང་ལ་ཁམ་ཕོར་གཞན་གྱིས་བཀབ་སྟེ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་རང་གི་ལྷའི་རྣལ་འབྱེར་གྱིས་གྲོ་ག་ལ་སོགས་པ་ལ་གོ་རོ་ཙ་ནས།",
    "ཨོཾ་ན་མོ་བྷ་ག་ལ་ཏེ་ཙ་མུཎྜ་སུ་ཁ་མུ་ཁི་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་ཀྱི་ཚིག་དང་ཆེ་གེ་མོ་བ་ཤཾ་༢།",
    "སྔགས་བཟླས་ཞེས་བྱ་བ་ནི་ཨོཾ་ན་མོ་བྷ་ག་ཝ་ཏི་སུ་ཁ་མུ་ཁི་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྔགས་བཟླས་ཏེ།",
    "བུད་མེད་དངོས་ཀྱི་ཞེས་བྱ་བ་ནི་ཐ་མལ་པའི་བུ་མོ་དངོས་ཀྱིའོ།",
    "ནིམ་པའི་ལོ་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རང་གི་ཁྲག་ཅེས་བྱ་བ་ནི་སྒྲུབ་པ་པོའི་སྲིན་ལག་གི་ཁྲག་གོ།",
    "དགོངས་མོ་ཚང་དུ་འགྲོ་ཁ་མ།",
    "ཨོཾ་མུ་ནི་ཀ་སེ་མུ་ནི་བ་སེ་མུ་ནི་ཧ་ཏ་ལང་ག་ལེ་ཧི་བ་དེ་ཆེ་གེ་མོ་ཨུ་ཙ་ཏ་ཡ་སྭཱ་ཧཱ་ཞེས་སྤེལ་ཏེ་བྲིས་ལ་བག་ཟན་ལ་སོགས་པའི་ཆང་བུའི་ནང་དུ་བཅུག་ནས་སྔགས་དེ་ཉིད་ཟློས་ཤིང་།",
    "གང་གིས་ཤེ་ན།",
    "དེ་བཞིན་དུ་ལྟེ་བའི་པདྨའི་ཟླ་བ་ལ་ཡི་གེ་ཨ་ནས་ཀྱི་འབྲུ་ཙམ་བཀོད་ལ་པདྨ་གཞན་དང་ཁ་སྦྱར་ཏེ་དེ་དག་གི་བདུད་རྩིའི་འོད་ཀྱིས་བསྒྲུབ་བྱའི་ལུས་ཀྱི་ནང་ཐམས་ཅད་བཀང་སྟེ།",
    "ག་དང་ཨོཾ་ཁ་སྦྱར་བ་ཞེས་བྱ་བ་ནི་ཏཱ་ལའི་ཀྱེའདབ་མ་ལ་ཚེར་མས་ཨོཾ་ག་ཆེ་ལྡུགེ་མོ་སྟམྦྷ་ཧེ་ཨོཾ་ག་ཞེས་བྲི་བའོ།",
    "རང་གི་ལག་པ་གཡོན་པས་ལྡོང་རོས་ཀྱིས་གྲོ་ག་ལ་བསྒྲུབ་བྱའི་གཟུགས་བྲིས་ཏེ།",
    "ཁ་ཅིག་ནི་གུར་ཀུམ་མོ།",
    "དམར་པོ་ཞེས་བྱ་བ་ནི་ཡང་གུར་ཀུམ་མོ།་།",
    "རྩ་བའི་སྔགས་འབུམ་དུ་བཟླས་ན་སྔགས་གཞན་དག་གིས་ཀྱང་སྔར་མ་བཟླས་བཞིན་དུ་གྲུབ་པོ་ཞེས་སྟོན་ཏོ།",
    "ཞེས་པ་ནི་མ་བཟླས་བཞིན་དུ་ཡང་ཞེས་བྱ་བའི་ཚིག་གི་ལྷག་མའོ།",
    "རྒྱས་པ་ནི་སྐད་སྣ་ཚོགས་ཀྱི་ཉེ་བར་གཞག་པའི་དོན་དེ་སྟོན་པར་བྱེད་པའི་གཞུང་ཚིག་གི་ཚོགས་ནི་རིམ་པར་ཕྱེ་བ་སྟེ་བཞི་པའོ།",
    "མཁའ་དབྱིངས་དབུས་གྱུར་པ་ཞེས་བྱ་བ་ནི་སྔར་གསུངས་པའི་སྒྲུབ་ཐབས་ཀྱིས་རིམ་གྱིས་བསྐྱེད་པའི་ཁང་བུ་བརྩེགས་པའི་ནང་གི་ནམ་མཁར་རོ།",
    "གང་གི་འོད་ཟེར་ཀླུའི་གཟུགས་ཀྱིས་ཕྱོགས་མཚམས་ཀྱི་ནམ་མཁའ་ཁྱབ་པར་འཕྲོ་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "རང་གི་ས་བོན་མཚན་མ་ནི།",
    "ཞེས་བྱ་བ་ནི་དེར་ཧཱུཾ་གིས་བསྐྱེད་པའི་རྡོ་རྗེའི་ལྟེ་བར་དེ་ཉིད་ཧཱུཾ་གིས་མཚན་པའོ།",
    "བཞད་པའི་ཚེམས་ཀྱི་འོད་ཀྱིས་བླ་རེ་གྱེན་དུ་འདེགས་པའི་ལྷ་མོའི་དཀྱིལ་འཁོར་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "ལྷ་མོ་དེ་གང་དག་ཡིན་ཞེ་ན།",
