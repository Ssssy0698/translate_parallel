    "འདི་ལྟར་ཕན་ཚུན་དུ་རིམ་པ་བཞིན་ཟིག་གཉིས་གཉིས་བཏབ་ལ་སླར་ཡང་གྲྭ་བཞིར་ཐིག་རེ་རེ་བཏབ་པས།",
    "དབུས་ཀྱི་སྟེ་བ་མ་གཏོགས་པ་རེའུ་མིག་བཅུ་གཉིས་སུ་འགྱུར་རོ།",
    "དབུས་ལ་སོགས་པའི་མཚན་མ་རི་མོར་བྲི་བའོ།",
    "ཡུགས་ས་མོ་དང་འདོད་པ་ལའང་ལྔའི་འོ།",
    "ཤར་ཕྱོགས་ཀྱི་རེའུ་ཆ་ལ་ནི་གསུམ་མོ།",
    "ཡང་བདེན་བྲལ་དུ་ནི་གསུམ་མོ།་།",
    "དབྱངས་ཀྱི་བྱེ་བྲག་ཅེས་བྱ་བ་ནི་མ་ནིང་གི་ཡི་གེ་སྤངས་པའི་ཨ་ལ་སོགས་པའི་དབྱངས་ཀྱི་ཡི་གེ་བཅུ་གཉིས་པོ་ཉིད་གོ་རིམས་བཞིན་འཕེལ་བ་ལ་སོགས་པ་མིང་དུ་བརྗོད་པའོ།",
    "དུག་གི་དུས་ཞེས་བྱ་བ་ནི་མཆེ་བ་ལ་སོགས་པའི་དུག་གི་དུས་ཀྱི་དབྱེ་བ་བཅུ་གཉིས་སོ།",
    "སྐད་ཅིག་དེ་ཡང་སྔར་བསྟན་པའི་ཆུ་ཚོད་ཀྱི་རི་མོས་ཤེས་པར་བྱའོ།",
    "ཁྱུ་མཆོག་གི་ཡང་དེ་བཞིན་ནོ།",
    "དེའི་འོག་མ་ལྔ་ནི་ཡུགས་ས་མོའོ།",
    "དེའི་འོག་མ་བདུན་ནི་རྨི་ལམ་མོ།",
    "ཡུགས་ས་མོ་ནི་སྲང་ངོ།",
    "དེ་ལ་ལུག་གི་ཆུ་ཚོད་གསུམ་ལ།",
    "སྨིན་དྲུག་གི་བཞི་ཆ་གཅིག་སྟེ་དགུའོ།",
    "དེའི་འོག་མ་ཁྱུ་མཆོག་གི་ཆུ་ཚོད་བཞི་ལ་སྨིན་དྲུག་བཞི་ཆ་གསུམ་དང་།",
    "ལག་དང་ནབ་རྔོ་སོའི་བཞི་ཆ་གསུམ་མོ།",
    "དེའི་འོག་ཏུ་བུ་མོའི་ཆུ་ཚོད་གསུམ་ལ་དབོའི་བཞི་ཆ་གསུམ་དང་མེ་བཞི་དང་ནག་པའི་ཕྱེད་དོ།",
    "དེའི་འོག་ཏུ་སྲང་གི་ཆུ་ཚོད་ལྔ་ལ་ནག་པའི་ཕྱེད་དང་ས་ག་དང་ས་རིའི་བཞི་ཆ་གསུམ་མོ།",
    "མོན་གྲུའི་ཕྱེད་དོ།",
    "དེའི་འོག་ཏུ་བུམ་པའི་ཆུ་ཚོད་བདུན་ལ་མོན་གྲུའི་ཕྱེད་དང་མོན་གྲེ་དང་ཁྲུམས་སྟོད་ཀྱི་ཆ་གསུམ་མོ།",
    "ཚངས་པར་སྤྱོད་ཅིང་ཞེས་བྱ་བ་ནི་ཆང་དང་བུད་མེད་ལ་སོགས་པ་སྤོང་བའོ།",
    "བཟོ་ཤེས་པ་དང་ཞེས་བྱ་བ་ནི་གླུ་དང་གར་དང་རོལ་མོའི་སྦྱོར་བ་ལ་མཁས་པའོ།",
    "རྒྱས་པ་ནི་དེ་དག་གི་སྦྱོར་བ་ལ་མཁས་པའོ།",
    "གང་གིས་བརླང་པོ་སྨྲ་བར་བྱེད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "རང་གིས་བསྒྲུབ་བུཔའི་ཡོ་བྱད་ལ་ལོངས་སྤྱོད་པའོ།",
    "ཅུང་ཟད་ཙམ་གྱིས་ཁྲོ་བ་ཞེས་བྱ་བ་ནི་སྐད་ཅིག་གིས་ཁྲོ་ཞིང་སྐད་ཅིག་གིས་ཞི་བའོ།",
    "རང་གི་རིགས་བསྟོད་ཅིང་ཞེས་བྱ་བ་ནི་རིགས་མཐོན་པོར་སྐྱེ་བའོ།",
    "དོར་ཐབས་ཀྱི་བཟོ་ཞེས་བྱ་བ་ནི་རོལ་མོ་ལ་སོགས་པ་འཁྲུལ་འཁོར་གྱི་བཟོའོ།",
    "གང་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "གང་གི་མཆེ་བས་མངོན་ཟིན་ན།",
    "ཞེས་བྱ་བ་ནི་གསོར་མི་རུང་བ་བསྟན་པ་ཡིན་ཏེ་རྭ་སྟིཅན་བཞི་ལ་ཟིན་པ་དག་འཆི་བདག་གིས་སྒོར་གཞོལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དུག་གིས་ཟིན་པ་དུགསོར་རུང་བ་གཞན་དག་ལ་དུག་བསྡུ་བའི་ཆོ་ག་ཇི་ལྟར་བགྱི་ཞེས་གསོལ་བ་བཏབ་པ་སྟོན་ཏོ།",
    "ཅེས་བྱ་བ་ནི་ཞབས་བརྟན་ཞིང་རི་མོ་སྔོན་པོ་དང་བྲལ་བ་སྟེ།",
    "བུམ་པ་ཞེས་བྱ་བ་ནི་རིགས་ཀྱིས་ན་གཅིག་གི་ཚིག་ཏུ་བྱས་པ་ཡིན་ཏེ།",
    "ཆུ་ཡིས་བཀང་ཞེས་བྱ་བ་ལ་ཕྱོགས་མཚམས་ཀྱི་བུམ་པ་བརྒྱད་ནི་དྲི་ཞིམ་པོའི་ཆུས་བཀང་ལ་དབུས་ཀྱི་བུམ་པ་ཞི་བའི་ཐབ་ཁུང་གི་རྣམ་པ་ལྟ་བུ་ཡེལས་བྱས་པའི་བུམ་པ་ནི་དྲི་ཞིམ་པོའི་ཆུ་དང་འོ་མར་བསྲེས་པས་དགང་ངོ།",
    "ཤིང་གི་ལོ་མས་ཁ་བརྒྱན་པ་ལ་སོགས་པ་གཟུང་བར་བྱའོ།",
    "ལྷ་མོ་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་དང་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་སོགས་པའོ།",
    "ཞེས་བྱ་བ་ནི་ལྷ་མོ་རྣམས་ཀྱི་ཁ་དོག་སྟེ་བསམ་པར་བྱ་ཞེས་ཧྲ་བ་སྐྱེ་དང་འབྱེལ་ཏོ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་སྒྲུབ་ཐབས་ཀྱི་རིམ་གྱིས་བདག་ཉིད་ཡེ་ཤེས་མཁའ་འགྲོ་མར་བྱས་ནས་དབུས་ཀྱི་བུམ་པའི་སྣོད་ལ།",
    "བྱང་དུ་ནི་དྲག་མོ་སྟེ་ས་བོན་ཧཱུཾ་གིས་བསྐྱེད་དོ།",
    "ནུབ་ཏུ་ནི་རོ་ལངས་མ་སྟེ་ས་བོན་ཡཱི་གིས་བསྐྱེད་དོ།",
    "ལྷོར་ནི་གཏུམ་མོ་སྟེ་ས་བོན་ཧཱུཾ་གིས་བསྐྱེད་དོ།",
    "མེ་མཚམས་སུ་སྟག་མོ་སྟེ་ས་བོན་སྦྱོ་གིས་བསྐྱེད་དོ།",
    "བདེན་བྲལ་དུ་ནི་ཅེ་སྤྱང་མོ་སྟེ་ས་བོན་ཧཱུཾ་གིས་བསྐྱེད་དོ།",
    "གཡས་པའི་ཁུ་ཚུར་དེའི་སྟེང་དུ་བཞག་པ་དེ་ནི་ཐུན་མོང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་ནས་ཉེ་བའི་ལོངས་སྤྱོད་ཀྱི་གཏོར་མ་ལ་སོགས་པ་ཕུལ་ནས་སྔགས་དེ་ཉིད་ཀྱིས་མེ་ཏོག་དཀར་པོའི་ནང་དུ་དྲུར་ཊྭཱབ་སར་པའི་རྩ་བ་བཙུགས་ལ་སྔར་བསྟན་པའི་ཆུ་སྣོད་དུ་བསྒོམས་པའི་ཡེ་ཤེས་མཁའ་འགྲོ་མའི་རྡོ་རྗེ་དབུ་རྒྱན་གྱི་རྩེ་མོར་བསྣུན་པའི་སྦྱིན་སྲེག་བྱས་ན་རྒྱས་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "སྔོན་དུ་བསྒྲུབ་པར་བྱ་བ་རྡོ་རྗེ་མཁའ་འགྲོ་མར་བསྒོམས་ཏེ་དུག་གིས་ཟིན་པའི་ཡན་ལག་བརྒྱད་ལ་མཁའ་འགྲོ་མའི་ས་བོན་བརྒྱད་དགོད་པར་བྱའོ།",
    "ས་བོན་དེ་དག་ཁ་དོག་སྣ་ཚོགས་ཡིན་དུ་ཟིན་ཀྱང་དུག་བསྡུ་བའི་སྐབས་སུ་ནི་ཐམས་ཅད་དཀར་པོར་བསམས་ལ་འོད་ཀྱི་ཁྱེབདུད་རྩིའི་ཆུ་རྒྱུན་གྱིས་བསྒྲུབ་བྱའི་ལུས་ལ་བཀྲུས་ཏེ་དུག་སེལ་བར་བསམ་མོ།",
    "ཨོཾ་བ་སུ་ཀི་ཏྲི་ཏ་ཌནྡ་ཏྲོར་ཆེ་གེ་མོ་ནི་རྔི་ཤཾ་ཙོཀུ་རུ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "དེ་ལྟར་ཀླུ་གཞན་གང་དག་གི་སྔགས་སྤེལ་བ་ཡང་བལྟ་བར་བྱའོ།",
    "མཚན་མ་ནི་གྲངས་ཀྱི་རི་མོའོ།",
    "ཟླ་བ་དང་པོ་དེ་ཉིད་ཀྱི་ཉིན་མོའི་ཆུ་ཚོད་ནི་བཞི་དང་བཅུ་གཉིས་བསྒྱུར་ཞེས་བྱ་བ་ལ།",
    "ཞེས་བྱ་བ་ནི་དཔྱིད་ཟླ་འབྲིང་པོ་ཟླ་བའི་མགོ་ལ་ཉིན་མོ་དང་མཚན་མོའི་ཆུ་ཚོད་མཉམ་པའོ།",
    "དགུན་ཟླ་འབྲིང་པོའི་དང་པོ་ལ་ཉིན་མོ་དང་མཚན་མོ་མཉམ་པའོ།",
    "ཆུ་ཚོད་གཅིག་གི་དབུགས་ཀྱི་གྲངས་ཀྱི་ངེས་པ་བསྟན་པའི་ཕྱིར་སུམ་བརྒྱ་དྲུག་ཅུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།་",
    "ཞེས་བྱ་བ་ནི་བྱེ་བྲག་དེ་དག་གི་རིམ་པ་ཇི་བ་བཞིན་དུ་གཟུང་བ་སྟེ་ཤེས་པར་བྱའོ།",
    "འདི་དག་ནི་འོག་ནས་སྟོན་མོད་ཀྱི་འདིར་ཅུང་ཟད་ཅིག་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་ཕན་ཚུན་དུ་ཐིག་གཉིས་གཉིས་བྲིས་པས་རེའུ་མིག་དགུར་འགྱུར་ལ་དེ་ནས་ཡང་མཚལས་ཀྱི་རེའུ་མིག་བཞི་ལ་ཐིག་རེ་རེ་བྲིས་པས་རེའུ་མིག་བཅུ་གསུམ་དུ་བྱའོ།",
    "དེ་ནས་ཕྱི་རོལ་ཀུན་དུ་བསྐོར་བས་འཁོར་ལོ་རིམ་པ་གསུམ་དུ་བྱས་ལ་དེ་ལས་ཕྱི་རོལ་གྱི་རིམ་པའི་རེའུ་མིག་དང་པོ་ལ་གྲངས་ལྔའི་མཚན་མ་བྲིའོ།",
    "དབུས་སུ་ནི་སུམ་ཅུ་གསུམ་མོ།",
    "རིམ་པ་གཉིས་པའི་རེའུ་ཆ་དང་པོ་ལ་གསུམ་མོ།",
    "ལྔ་པ་ལ་ཡང་གསུམ་མོ།",
    "བཅུ་གཅིག་པ་ལ་ཡང་གསུམ་མོ།",
    "ཉི་མ་ཉི་ཤུ་དྲུག་གིས་ནི་ཟླ་བ་གཉིས་ཀྱིས་ཛེེའཆིའོ།",
    "ཉི་མ་སུམ་ཅུ་གཅིག་གིས་ནི་ཉི་མ་གསུམ་ན་འཆིའོ།",
    "འདི་དག་གི་དོན་ཡང་ལྔ་དང་ཞེས་བྱ་བ་ལ་སོགས་པས་འོག་ནས་བསྟན་པས་དེར་ཤེས་པར་བྱའོ།",
    "དྲུག་ཕྲག་གཉིས་ཀྱི་མཚན་མ་དག་གཅིག་ཏུ་བསྲེས་ཏེ་སུམ་ཅུ་རྩ་དྲུག་གི་མཚན་མ་བྱ་བའོ།",
    "བཅུ་དྲུག་ཕྲག་བརྒྱད་པ་གཉིས་ལས་བཅུའི་མཚན་མ་དང་དྲུག་གི་མཚན་མ་སོ་སོར་བྱས་ལ་བཅུ་དྲུག་གི་མཚན་མ་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་འདྲི་བ་པོའི་ངག་གི་ཡི་གེའི་གྲངས་ཇི་སྙེད་ཡོད་པའི་མཚན་མ་བྱ་བ་སྟེ།",
    "དེས་ནི་ངག་གི་ཡི་གེ་དེ་རྣམས་དྲུག་འགྱུར་དུ་བྱ་བ་སྟོན་ཏོ།",
    "ཅེས་ཚེབྱ་བ་ལས་ནི་རེའུ་མིག་བཅུ་གཉིས་སོ།",
    "རི་མོ་དེའི་འབུར་བ་རྣམས་སུ་རྔུའབུར་བ་ཐ་མའི་བར་དུ་བརྩིས་ཏེ།",
    "མེ་ཏོག་དེ་སྙེདབྱངས་ཡིག་གི་གནས་སུ་གང་ལྷུང་བ་དེའི་ཕན་ཡོན་བསྟན་པར་བྱའོ།",
    "སྔ་དྲོ་ཞེས་བྱ་བ་ནི་སྔར་ཐལ་བའི་ཕྱི་རོལ་གྱི་མཚན་མས་བརྩིས་བུཔ་ཐམས་ཅད་སྔ་དྲོའི་ཆུ་ཚོད་གསུམ་གྱི་དུས་སུ་བརྩིའོ།",
    "དེའི་ཆོ་ག་ནི་གནས་བཅུ་གཉིས་སུ་ལག་པས་སྣེརེག་པའི་བྱེ་བྲག་གིས་དེའི་སེམས་ཀྱི་རྒྱུ་བ་ཤེས་པར་བྱ་བའོ།",
    "མོས་པ་སྤྱོད་པའི་ས་ནི་འཕེལ་བའོ།",
    "མངོན་དུ་གྱུར་པ་ནི་ཡུགས་ས་མོའོ།",
    "རིང་དུ་སོང་བ་ནི་སྨེ་བའོ།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟར་ཕོ་ཉ་གནས་གང་དང་གང་དུ་རེག་པ་ལས་ནོར་རྒྱས་ཀྱི་བུ་ལ་སོགས་པའི་དུག་གིས་ཟིན་པ་གསོར་རུང་བ་དང་།",
    "འབྲལ་དང་འདུ་ཞེས་བྱ་བ་ནི་སོང་བ་བེེར་དགུག་པ་སྟེ།",
    "མ་ནིང་གི་རྟགས་སུ་བྱ་བ་ནི་ལུང་གི་དོན་ཏོ།",
    "དུས་དང་ཚོད་ལ་སོགས་པ་ཉིད།",
    "དེ་དག་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་འཕེལ་བ་ལ་སོགས་པའི་དུས་ཀྱི་བྱེ་བྲག་གི་བྱ་བར་བསྟན་པའི་ཕྱིར།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་མ་གཏོགས་པར་རགས་པས་དོན་མི་འགྲུབ་པས་ཕྲ་མོའི་རྣལ་འབྱོར་བསྟན་པར་བྱ་བའི་ཕྱིར་ལེའུ་བཅུ་གཅིག་པ་གསུངས་པ།",
    "གང་གི་ཕྱིར་ཕྲ་མོ་མ་གཏོགས་པར་རགས་པས་མི་འགྲུབ་པ་དེའི་ཕྱིར་རོ།",
    "དངོས་གྲུབ་མཆོག་གི་རིག་པ་ལས།",
    "བདག་ཅག་གིས་ཤེས་པ་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "དངོས་གྲུབ་མཆོག་གི་རིག་པ་སྟེ།",
    "གཞན་དག་ཏུ་ནི་གཏུམ་མོ་ཞེས་པ་བསྟན་ཏོ།",
    "ཤར་ལ་སོགས་པའི་འདབ་མ་རྣམས་ལ་ནི་ཟླ་བ་ལ་གནས་པར་ཨ་ཀ་ཙ་ཊ་ཏ་པ་ཡ་ཤ་རྣམས་ཟླ་ཚེས་དང་ཐིག་ལེ་དང་བཅས་པར་བསྒོམ་མོ།",
    "རྙོག་པ་མེད་ཅེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་བག་ཆགས་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "དུང་དང་ཟླ་འདྲ་ཞེས་བྱ་བས་ནི་དེ་དག་གི་ཁ་དོག་བསྟན་ཏོ།",
    "ཐིག་ལེས་སྟེང་དུ་བརྒྱན་པ་ནི་ཟླ་ཚེས་དང་བཅས་པ་སྟེ་དེ་དག་གིས་ཧཱུཾ་བྱེ་བྲག་ཏུ་བྱའོ།",
    "རང་གི་མགྲིན་དབུས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལཁྲུ།",
    "འཁོར་ལོ་ཞེས་བྱ་བ་ནི་འདབ་མ་སུམ་ཅུ་རྩ་གཉིས་པའི་པདྨ་བཅུ་དྲུག་གི་ཁ་ཡར་བལྟས་ལ་བཅུ་དྲུག་ནི་མར་བལྟས་པའི་ཁ་དོག་སྣ་ཚོགས་པའོ།",
    "རང་གི་ཕྱག་རྒྱར་མངོན་ལྡན་པ་སྟེ་ཐིག་ལེ་དང་ཟླ་ཚེས་སུ་ལྡན་པའོ།",
    "ལྟེ་བར་གཏུམ་མོ་འབར་བྱས་པས།"
  ]
