    "རྐང་པ་གཉིས་ཀྱི་སོར་མོ་ཕན་ཚུན་སྦྱར་བ་ནི་མཉམ་པའི་རྐང་སྟབས་སོ།",
    "ལྔ་པོ་འདི་རྣམས་བྱེད་པ་ན་སོ་སོར་བསྐོར་བ་ལན་རེ་རྫོགས་པར་བྱའོ།",
    "རྟིང་པ་གཉིས་ཀྱི་བར་དུ་སོར་མོ་བཞི་བྱས་ཤིང་རྐང་པ་གཡོན་དྲང་པོར་བྱས་ཏེ་གཡས་པ་མཐོ་གང་གི་བར་དུ་འགྱིང་པ་དང་བཅས་པས་ལོགས་སུ་གནས་ནས་ཡངས་པ་ཅན་གྱི་སྒྲོལ་མའི་རྐང་སྟབས་ལྟར་བྱས་པ་ནི་སྐྱེས་པའི་རྐང་སྟབས་སོ།",
    "རྐང་པ་གཅིག་བཏེག་སྟེ་རྐང་པ་གཅིག་གིས་བསྐོར་བ་ནི་རྐང་གཅིག་གི་རྐང་སྟབས་སོ།",
    "རང་རང་གི་གཡས་པ་དང་གཡོན་པ་དག་གི་ལག་པའི་སོར་མོ་དང་བཅས་པ་ཀུན་ནས་གཡོ་བ་ནི་བུང་བའི་རྐང་སྟབས་སོ།",
    "དེའི་རྗེས་སུ་གཡས་བརྐྱང་གིས་གར་བྱས་ལ།",
    "དེ་ནས་པུས་མོ་གཡས་པ་བསྐུམ་ལ་དབྱུག་པའི་ཕྱག་རྒྱས་འཕང་བར་བྱའོ།",
    "གཡོན་པ་རྡོ་རྗེའི་རྐང་སྟབས་བྱས་ནས་པུས་མོ་གཡས་པ་བསྐུམ་ལ་རྐང་པ་བཏེག་སྟེ་ཁྲོ་བ་དང་བཅས་པས་ཅིག་ཅར་གཡོན་པས་འཁོར་ལོ་ལྟར་བསྐོར་བར་བྱའོ།",
    "པུས་མོ་གཡོན་པ་བསྐུམ་སྟེ་གཡས་པ་རྡོ་རྗེའི་རྐང་སྟབས་བྱས་ནས་གཡོན་དུ་འཕངས་ཤིང་ཅིག་ཅར་ཉིད་དུ་གཡས་སུ་བསྐོར་བར་བྱའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་བསླང་ནས་རྐང་པ་གཉིས་མཐོ་གང་ཙམ་གྱི་བར་དུ་བྱས་ཏེ་གྲུ་གསུམ་བྱ་ཞིང་པུས་མོ་གཡས་པ་ཅུང་ཟད་བསྐུམ་ལ་པུས་མོ་གཡོན་པ་སྨད་པར་བྱའོ།",
    "དེ་ཉིད་ཀི་ལཱི་ཀི་ལ་ཆེན་པོ་སྟེ་གང་གི་ཚེ་དབྱུག་པ་གནས་པ་ལ་བལྟ་བ་ན་དབྱུག་པ་ཕྲག་པ་གཡས་པའི་ཕྱོགས་ནས་རང་གི་རྒྱབ་ཏུ་དགྱེད་པར་བྱ་ཞིང་མིག་གཡོན་པ་བཙུམས་ཏེ་ཁྲོས་པས་རྐང་པ་རྣམ་པར་བསྐྱོད་པར་བྱའོ།",
    "སོར་མོ་བཞིའི་རྩེ་མོ་ཡང་དག་པར་བསྐུམ་པས་མཐེ་བོང་མནན་པ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་རོ།",
    "རྡོ་རྗེའི་གར་སྔོན་དུ་འགྲོ་བས་དཀུ་གཉིས་སུ་བཙུགས་ཏེ་མགོ་གཡོན་དུ་སྨད་པ་ནི་བུད་མེད་སྒྱུ་མ་བྱེད་པའོ།",
    "དཀུར་བཙུགས་པ་ནི་རྡོ་རྗེ་སྒེག་མོའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པས་གཟུང་བའི་གཏུན་ཤིང་གིས་བགེགས་རྡུང་བར་བྱེད་པ་ནི་གཏུན་ཤིང་གི་ཚུལ་ལོ།",
    "ཐལ་མོ་སྦྱར་བ་བཅིངས་ནས་སོར་མོའི་རྩེ་མོ་ཕན་ཚུན་སྦྱར་བ་ནི་རྡོ་རྗེའི་ཐལ་མོའོ།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་དང་གུང་མོ་དག་འགྱིང་བ་དང་བཅས་པས་བརྐྱང་ནས་སྟེང་དུ་བཟུང་བ་ནི་བ་དན་གྱི་ཚུལ་ལོ།",
    "ཐལ་མོ་སྦྱར་བ་པདྨ་བཞིན་དུ་ཁ་ཕྱེ་བ་ནི་པདྨའི་ཚུལ་ལོ།",
    "ཁུ་ཚུར་གཡས་པའི་མཐེ་བོང་ནང་དུ་བཅུག་སྟེ་མཛུབ་མོ་བརྐྱང་ནས་དཔུང་པའི་སྟེང་དུ་དབྱུག་པ་ལྟར་བསྒྲེང་བ་ནི་དབྱུག་པའི་ཚུལ་ལོ།",
    "གཡས་པའི་མཛུབ་མོ་འགུགས་པའི་ཚུལ་གྱིས་གཟུང་བ་ནི་ལྕགས་ཀྱུའི་ཚུལ་ལོ།",
    "ལག་པ་གཡས་པའི་སོར་མོ་རྣམས་བརྐྱང་ལ་བསྐུམ་པ་ནི་གདེངས་ཀའི་ཚུལ་ལོ།",
    "གཡས་པའི་མཛུབ་མོ་དང་གུང་མོ་དག་གི་རྒྱབ་ནས་མདའ་དྲང་བར་བྱ་བ་ནི་མདའ་དྲང་བའི་ཚུལ་ལོ།",
    "རྡོ་རྗེ་ངེས་པར་བསྒྲིལ་བར་བྱས་པའི་འོག་ཏུ་རྡོ་རྗེ་ངེས་པར་བསྐོར་ནས་འགྱིང་བ་དང་བཅས་པས་སྟེང་དུ་རྡོ་རྗེ་གཡོ་བར་བྱའོ་ཞེས་པ་ནི་ཁ་ཅིག་གིའོ།",
    "རང་གི་གདོང་འོག་ཏུ་ཕྱོགས་པས་ལག་པ་གཡོན་པ་དེའི་འོག་ཏུ་རབ་ཏུ་བརྐྱང་སྟེ།",
    "དཔུང་པ་གཡོན་པའི་རྒྱུད་ས་ལ་ཕབ་སྟེ་ལག་པ་གཡས་པས་འགྲམ་པར་ཐལ་ལྕག་རྡེག་པའི་ཚུལ་བྱས་ནས་སྟེང་དུ་ང་རྒྱལ་གཟུང་བ་ནི་སེང་གེས་གནོན་པའོ།",
    "དེ་ཁོ་ན་བཞིན་དུ་འཕྲུལ་ཞིང་འཕེན་པའི་ཚུལ་བྱ་བ་ནི་འཕྲུལ་ཤིང་གི་ཚུལ་ལོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་མདུང་གིས་འབིགས་པའི་ཚུལ་བྱ་བ་ནི་མདུང་གི་ཚུལ་ལོ།",
    "ས་གཞི་ལ་རིག་པ་འཛིན་པའི་རྐང་སྟབས་ཀྱིས་ལྷུང་ནས་གཡོན་པ་དང་གཡས་པ་དག་གི་ལག་པས་ཀ་པཱ་ལ་དང་རྡོ་རྗེ་འཛིན་པའི་ཚུལ་བྱ་བ་ནི་རྡོ་རྗེ་རིག་པ་འཛིན་པའོ།",
    "རྐང་པ་གཡས་པས་ཏཱ་ཎྜ་བ་བྱས་ལ་རྐང་པ་གཡོན་པ་ཕྱིན་ཅི་ལོག་གི་སྟེང་དུ་དཔུང་པ་གཡོན་པར་སླེབ་པར་བྱ་ཞིང་ལག་པ་གཉིས་ཀྱི་རྡོ་རྗེ་ཁུ་ཚུར་བཅིངས་ཏེ་མཐེའུ་ཆུང་གཉིས་ལྕགས་སྒྲོག་ལྟར་བྱས་ནས་མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་ཕྱིན་ཅི་ལོག་ཏུ་བྱས་ནས་སྤྱི་བོར་གཟུང་བ་ནི་ཛ་ལནྡྷ་རའོ།",
    "དཔལ་ཀྱེ་རྡོ་རྗེ་ལ་སོགས་པ་རྣལ་འབྱོར་མའི་རྒྱུད་དུ་ནི་ཧཱུཾ་ཡིག་གི་སྔགས་བརྗོད་པ་ཉིད་ཀྱིས་བགེགས་ཐམས་ཅད་ཉེ་བར་ཞི་བར་འགྱུར་རོ་ཞེས་ཏེ།",
    "དཔལ་འདུས་པ་ལ་སོགས་པ་རྣལ་འབྱོར་ཆེན་པོའི་རྒྱུད་དུ་ནི་ཉུང་བ་ལ་དགའ་བ་རྣམས་ལ་སོ་སོ་རེ་རེ་ཞིང་རྡོ་རྗེའི་རྐང་སྟབས་ཀྱི་སྔགས་རྣམས་གསུངས་པས་དེ་ཡང་འདིར་བརྗོད་པར་བྱའོ།",
    "ཨོཾ་བུདྡྷ་བ་ལ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་ཨཱ་ཀྵེ་པ་ཡ་ཨ་ཀྵེ་པ་ཡ་སརྦ་མཱ་རཱན་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་ལ་ཨཱ་ཧེ་ཧེ་གྲ་ས་གྲ་ས་ཀ་རཱ་ལ་བ་ད་ན་མ་ཧཱ་ཀྲོ་དྷ་བི་མོ་ཧ་ཡ་བི་མོ་ཧ་ཡ་ཧཱུཾ་ཚ།",
    "དམ་ཚིག་ཀྱང་འདི་རྣམས་ཏེ་དམ་ཚིག་གི་ངེས་པ་འབའ་ཞིག་བྱའོ།",
    "སྤྲིན་ནི་ཟབ་མོ་སྒྲོགས་པར་བྱེད་པའོ་དགའ་བ་དང་བཅས་འབར་བས་ཀུན་ནས་ཁྱབ་པ་དེར།",
    "བདེ་འབྱུང་ངེས་པར་རྫུ་འཕྲུལ་ཆེ་ལྡན་གླང་གི་གདོང་ཅན་དཀར་པོ་འཁྲི་ཤིང་ལ་གནས་ཤིང་།",
    "བསྲེགས་དང་ཀུན་ནས་བསྲེགས་ཤིང་དུ་མ་བུར་བྱས་སོགས་རོ་རྣམས་མདུང་གིས་ཕུག་དང་བཅིངས་གྱུར་པ།",
    "མཆོག་གི་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་ནི་ངེས་པར་བཅད་ནས་རང་གི་མེ་ལ་འཚེད་པར་བྱེད།",
    "འགའ་ཞིག་རང་གི་མགོ་པོ་བཅད་ནས་ཕྲག་པ་དག་ལས་འཛག་པའི་ཁྲག་ནི་འཐུང་བར་བྱེད།",
    "འགའ་ཞིག་རྩེད་མོ་བྱེད་ཅིང་ཨེ་མའོ་འགའ་ཞིག་ཤུགས་བཅས་ལུས་ནི་གསུམ་དུ་སྤྲུལ་བར་བྱེད།",
    "ཉལ་བ་དང་ནི་ཟ་བ་ཉིད་འདོད་གྲུབ་པ་ཞི་བའི་ལྷ་ཡང་མཆོག་གི་བདེ་བའི་རོ་དང་ལྡན།",
    "ཌོ་མྦི་པ་ནི་སྟག་ལ་ཞོན་ཞིང་རང་རིག་བུད་མེད་དག་དང་ལྷན་ཅིག་ཀུན་ནས་འཁྱུད་པར་ལྡན།",
    "རྒྱལ་པོ་ཨིནྡྲ་བྷཱུ་ཏི་བསམ་གཏན་མཆོག་གི་བདེ་བའི་རང་བཞིན་ནམ་མཁར་སེང་གེའི་ཁྲི་ལ་བཞུགས།",
    "ཀུ་ཀུ་རི་བའི་ཞབས་འདིར་རང་ཉིད་ཁྱི་མོ་རྣམས་དང་ལྷན་ཅིག་བྱིས་པ་བཞིན་དུ་རྩེ་བ་སྟེ།",
    "འོད་ལྡན་ལྷ་མོ་རྣམས་ཀྱི་ཆུ་སྐྱེས་འདབ་མའི་ཆུ་ཡིས་སོ་ཡི་སྒྲིབ་བྱེད་རྣམ་པར་བྱུགས།",
    "ཆུ་སྐྱེས་སྣོད་དུ་ཀུན་ནས་བཞག་པའི་ཆང་དང་དེ་ནས་ཤ་ཆེན་རྣམས་དང་ཚོད་མ་འཐུང་བྱེད་པའི།",
    "དཔལ་ལྡན་སྐལ་བར་ལྡན་པ་རྣམས་ནི་འདུ་བ་ཡོངས་སུ་སྤངས་མིན་དམ་པའི་རེག་མིན་རྣམས་དང་ལྡན།",
    "འགའ་ཞིག་སྲད་བུ་དག་དང་སྣོད་ལྡན་པད་པར་གནས་པའི་རྒྱུད་མངས་རོལ་མོ་ལ་བརྟེན་རོ་མྱང་ཞིང་།",
    "རང་གི་འདུན་པས་དཔལ་ལྡན་ཀུན་དུ་རུ་ནི་ཡོངས་སུ་བསགས་ཀྱང་ངོམས་པ་མེད་པས་གླུ་དབྱངས་ལེན།",
    "བྱིན་པ་གཡོན་པར་བྱིན་པ་གཡས་པ་བཞག་སྟེ་པུས་མོ་གཉིས་སྨད་པ་ནི་པདྨའི་གདན་ནོ།",
    "རྐང་པ་གཡོན་པ་སྐྱིལ་ཀྲུང་ཕྱེད་པར་བྱས་ཏེ་དེ་དང་ཉེ་བར་པུས་མོ་གཡས་པ་སྟེང་དུ་དྲང་པོར་བཞག་པ་ནི་དཔའ་བོའི་འདུག་སྟངས་སོ།",
    "གཡོན་པ་སྐྱིལ་ཀྲུང་ཕྱེད་པར་བྱས་ནས་དེའི་སྟེང་དུ་པུས་མོ་གཡས་པ་བསྙལ་ཏེ་བཞག་ལ་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་མཐིལ་དུ་གན་རྐྱལ་དུ་བཞག་པ་ནི་དཔའ་བོའི་འདུག་སྟངས་སོ་ཞེས་ཁ་ཅིག་གོ།",
    "རྐང་པ་གཉིས་མཐོ་གང་གི་བར་དུ་སྟན་ལ་བཀོད་ནས་ཙོག་པུར་གནས་པ་ནི་ཙོག་པུའི་འདུག་སྟངས་སོ།",
    "རྐང་པ་གཡས་པ་སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་ཡང་དག་པར་གནས་ཤིང་གཡོན་པ་འགྱིང་བ་དང་བཅས་པས་རབ་ཏུ་བརྐྱང་པ་ནི་རལ་པའི་འདུག་སྟངས་སོ།",
    "ལག་པ་གཡོན་པ་བང་བར་ཡང་དག་པར་བཞག་སྟེ་ལག་པ་གཡས་པ་ས་ལ་རེག་པར་གཟུང་བ་ནི་མི་བསྐྱོད་པའིའོ།",
    "པདྨའི་གདན་ལ་སྒེག་མོ་ལ་སོགས་པའི་ཕྱག་རྒྱ་བཅིང་བར་བྱ་སྟེ།",
    "ཧཱུཾ་གི་ཡི་གེ་དང་གླུ་བླང་བ་དང་གར་བྱ་བ་སྔོན་དུ་འགྲོ་བས་དཀུའི་གནས་སུ་གཡོན་པ་དང་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཞག་ནས་འགྱིང་བ་དང་བཅས་པས་གཡོན་དུ་མགོ་ཅུང་ཟད་སྨད་པར་བྱ་བ་ནི་རྡོ་རྗེ་སྒེག་མོའི་འོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་དབྱུག་པ་ལྟར་བླང་བ་དང་གཡས་བའི་མཛུབ་མོས་གར་གྱི་རྣམ་པར་བྱས་ནས་གླུ་བླངས་ཏེ་སྒེག་ཅིང་རྣམ་པར་གཡོ་བས་བི་ཝང་དཀྲོལ་པ་ནི་གླུ་མའི་འོ།",
    "བཀྲོལ་བའི་ཐལ་མོ་གཙུག་ཏོར་གནས།",
    "གུང་མོའི་རྩེ་མོ་དང་མིང་མེད་ཀྱང་དེ་བཞིན་དུ་རྡོ་རྗེ་བསྡམས་པ་ལ་གནས་པ་དང་།",
    "ལག་པ་གཉིས་ཀྱིས་རྡོ་རྗེ་ཁུ་ཚུར་བྱས་ལ་མཐེ་ཆུང་དག་ལྕགས་སྒྲོག་གི་མདུད་པར་བཅིངས་ཏེ་མཛུབ་མོ་དག་གི་རྩེ་མོ་སྦྱར་བ་ཡོངས་སུ་བསྐོར་ནས་སྨིན་ཕྲག་དུ་གཟུང་བ་ནི་རྟ་མགྲིན་གྱིའོ།",
    "མཐེ་བོང་དག་གིས་མཐེ་ཆུང་གི་སེན་མོ་མནན་ཏེ་སོར་མོ་ལྷག་མ་རྣམས་རྡོ་རྗེའི་མཚན་ཉིད་ཅན་དཔུང་པར་རྡོ་རྗེ་བསྡམས་པས་མཆན་ཁུང་གི་རྩ་བར་གཟུང་བ་ནི་བདུད་རྩི་འཁྱིལ་པའི་འོ།",
    "ཨོཾ་ཨ་མྲྀ་ཏ་ཀུཎྜ་ལི་བིགྷྣཱནྟ་ཀྲྀ་ཏ་ཧཱུཾ།",
    "ཐལ་མོ་ཡང་དག་པར་སྦྱར་བ་བྱས་ནས་མཛུབ་མོ་དག་གིས་མིང་མེད་མནན་ཏེ་རྣམ་པར་རྒྱས་པའི་ཨུཏྤལའི་རྣམ་པར་གཟུང་བ་ནི་འཇམ་དཔལ་གྱིའོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་སྟེང་དུ་བཀུག་ལ་དེའི་འོག་ཏུ་ལག་པ་གཡས་པས་བ་དན་འཛིན་པའི་ཚུལ་བྱས་པ་ནི་ཡེ་ཤེས་ཏོག་གིའོ།",
    "ལག་པ་གཉིས་རབ་ཏུ་བརྐྱང་ནས་སོར་མོ་ཐམས་ཅད་རིམ་པས་དགུག་པའི་ཚུལ་བྱ་བ་ནི་རྒྱ་མཚོའི་བློ་གྲོས་གྱིའོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་པང་པར་བཞག་ནས་ལག་པ་གཡས་པས་རྡོ་རྗེ་ཁུ་ཚུར་བྱས་ཏེ་མཐེ་བོང་དང་མཛུབ་མོ་དག་གིས་སེ་གོལ་སྦྱིན་པར་བྱ་བ་ནི་སྤོབས་པ་བརྩེགས་པའིའོ།",
    "ལག་པ་གཡས་མཆོག་སྦྱིན་བྱས་ཏེ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་དང་མཐེ་བོང་རབ་ཏུ་བརྐྱང་བའི་བར་ཟླ་ཚེས་ཀྱི་རྣམ་པར་བྱས་པ་ནི་ཟླ་འོད་ཀྱིའོ།",
    "ལག་པ་གཡོན་པས་ལ་རེག་པའི་རྣམ་པར་བཞག་ནས་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་དང་མཐེ་བོང་སྦྱར་བས་འདྲི་བའི་རྣམ་པར་གཟུང་བ་ནི་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའིའོ།",
    "ཨོཾ་སཱ་ག་རེ་མ་ཧཱ་སཱ་ག་རེ་ཧཱུཾ།",
    "ཨོཾ་སརྦ་ཤོ་ཀ་ཏ་མོ་ནི་རྒྷཱ་ན་མ་ཏི་ཧཱུཾ།",
    "ཨོཾ་ཨ་མི་ཏ་པྲ་བྷེ་ཨ་མི་ཏ་མ་ཏི་ཧཱུཾ།",
    "ཙོག་པུའི་འདུག་སྟངས་ལ་ཕོ་ཉ་དང་ཕོ་ཉ་མོ་དང་བྲན་པོ་དང་བྲན་མོའི་ཕྱག་རྒྱ་བཅིང་བར་བྱ་སྟེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཛུབ་མོ་ལྕགས་ཀྱུ་བཅིངས་ནས་མཐེ་ཆུང་ལྕགས་ཀྱུ་ཆེན་པོ་དང་།",
    "ལག་པ་དག་མདུད་པ་དང་གྲི་གུག་གི་རྩེ་མོ་དག་དང་རྒྱབ་དག་ཀྱང་བསྡམ་པར་བྱའོ།",
    "ལག་པ་གཉིས་རབ་ཏུ་བརྐྱང་ནས་ཐལ་མོ་སྦྱར་བར་བྱས་པའི་བར་དུ་རང་རང་གི་མཐེ་ཆུང་གི་སེན་མོ་མཐེ་བོང་དག་གིས་བསྒྲིབས་ཤིང་སོར་མོ་ལྷག་མ་རྣམས་སོ་སོར་རྩེ་མོ་སྦྱར་བར་བྱ་སྟེ་གཟུང་བ་ནི་ཁྲོ་གཉེར་ཅན་གྱིའོ།",
    "ལག་པ་གཉིས་སོ་སོ་རེ་རེར་བརྐྱང་ཞིང་རྡོ་རྗེ་ཁུ་ཚུར་བྱས་ནས་མཐེ་ཆུང་དང་མཛུབ་མོ་དག་ལྕགས་སྒྲོག་ལྟར་བཅིངས་ཏེ་ཁྱེར་བ་ནི་རྡོ་རྗེ་ལྕགས་སྒྲོག་མའི་འོ།",
    "ཞེས་པ་ཕོ་ཉ་མོ་རྣམས་ཀྱི་ཕྱག་རྒྱའི་སྔགས་སོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཕན་ཚུན་རྒྱབ་སྦྱར་བར་བྱས་ནས་མཐེ་ཆུང་ལྕགས་སྒྲོག་ལྟར་མདུད་མཛུབ་མོ་དག་རབ་ཏུ་བརྐྱང་བས་ཞགས་པ་བྱ་བ་ནི་འདོད་པའི་རྒྱལ་པོའི་འོ།",
    "འདོད་པའི་རྒྱལ་པོའི་ཕྱག་རྒྱ་བཞིན་ལ་མཛུབ་མོ་གཉིས་བསླང་བ་ནི་གནོད་མཛེས་རྒྱལ་པོའིའོ།",
    "ལག་པ་གཉིས་པོ་དག་གི་མཐེ་ཆུང་དང་མཐེ་བོང་ཕན་ཚུན་ལྕགས་སྒྲོག་ལྟར་བྱས་ནས་སོར་མོ་ལྷག་མ་རྣམས་བ་དན་གསུམ་པའི་རྣམ་པས་སྟེང་དུ་བརྐྱང་སྟེ་གཡོ་བ་དང་བཅས་པས་ཧཱུཾ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ས་འོག་གིའོ།",
    "དེ་ཁོ་ན་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རྒྱབ་བསྟན་ཏེ་གུང་མོའི་སོར་མོ་བླངས་ནས་སྤོས་འབུལ་བའི་ཚུལ་བྱ་ཞིང་ལག་པ་བསྐོར་བ་ནི་བདུག་སྤོས་མའིའོ།",
    "བྲན་མོ་དེ་རྣམས་ཀྱི་ཕྱག་རྒྱའི་སྔགས་ཀྱི་ཚིག་རྣམས་ནི་འདི་དག་ཏུ་འགྱུར་རོ།",
    "ལག་པ་གཡས་པའི་མཛུབ་མོ་ཐབ་ཀྱི་རྣམ་པས་བཀུག་ནས་གུང་མོའི་རྩེ་མོའི་ཚིགས་གསུམ་པར་བཟུང་སྟེ་མཐེ་བོང་མཛུབ་མོའི་ལོགས་ལ་བརྟེན་ནས་བསྟན་པ་ནི་མེ་ལྷའིའོ།",
    "ལག་པ་གཡས་པ་ཁུ་ཚུར་བྱས་ལ་གུང་མོ་དང་མཛུབ་མོ་བཀུག་ནས་ལག་པ་གཡོན་པ་དཀུའི་གནས་སུ་བཞག་སྟེ་རལ་གྲིའི་རྣམ་པར་གཟུང་བ་ནི་བདེན་བྲལ་གྱིའོ།",
    "ལག་པ་ཐལ་མོ་སྦྱར་བའི་རྣམ་པས་ཡང་དག་པར་བཟུང་སྟེ་སྟེང་དུ་བལྟ་བ་ནི་ཚངས་པ་ལ་སོགས་པ་རྣམས་ཀྱིའོ།",
    "ལག་པ་གཉིས་གཅིག་ཏུ་སྦྱར་ནས་རྣམ་པར་ཕྱེ་ལ་སོར་མོའི་རྩེ་མོ་རྣམས་ཕན་ཚུན་ཡང་དག་པར་སྦྱར་ནས་མཐེ་བོང་ཟླུམ་པོའི་རྣམ་པར་བྱ་ཞིང་འོག་ཏུ་བལྟ་བ་ནི་སའི་ལྷ་མོ་ལ་སོགས་པ་རྣམས་ཀྱི་ཕྱག་རྒྱའོ།",
    "ན་མོ་བཛྲ་ལཱ་སྱ་དེ་ཤི་དེ་ཤི་བཛྲ་པཱ་ཎི་ར་ཀྵ་ར་ཀྵ་སྭཱ་ཧཱ།",
    "ཨོཾ་ཨ་སུ་རེ་བྷྱ་སྭཱ་ཧཱ།",
    "ཞེས་པ་ནི་སའི་ལྷ་མོ་ལ་སོགས་པ་རྣམས་ཀྱི་ཕྱག་རྒྱའི་སྔགས་སོ།",
    "ཟུར་བཞི་དང་སྒོ་བཞིར་སྤོས་ཕོར་ལ་སོགས་པ་དང་གར་དང་གླུ་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ནས་ལག་པས་རེག་ཅིང་དཀྱིལ་འཁོར་གྱི་བདག་པོའི་སྔགས་བརྒྱ་རྩ་བརྒྱད་དང་ཡི་གེ་བརྒྱ་པ་ལན་བདུན་ཡོངས་སུ་བཟླས་ཏེ་དེ་ཉིད་དུ་ལྷའི་འཁོར་ལོ་སྤྲོ་ཞིང་བསྡུ་བས་ཉལ་བར་བྱའོ་ཞེས་པས་ཡོངས་སུ་གཟུང་བའི་ཆོ་གའོ།",
    "དེ་ནས་སྔ་བར་ལངས་ལ་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ལ་དགོད་པའི་ཆེད་དུ་སླར་ཡང་བགེགས་མེད་པར་བྱའོ་ཞེས་རྣམ་པར་བསམ་སྟེ་སྐད་ཅིག་གིས་སྟོང་པ་ཉིད་ཀྱི་རྗེས་ལ།",
    "རེ་ཕས་སྔོན་དུ་ཉི་མ་རྣམ་པར་བསྒོམས་ནས།",
    "དེའི་རྗེས་ལ་དཀྱིལ་འཁོར་ལ་འཆད་པར་འགྱུར་བའི་ཆོ་གས་དཀྱིལ་འཁོར་ཇི་ལྟ་བའི་རྗེས་སུ་འབྲངས་ཏེ་ཐིག་འདེབས་པ་དང་འབྲི་བའི་དཀྱིལ་འཁོར་གྱིས་གཞིར་བསྡད་ལ་དབས་སུ་དྲིའི་མཎྜལ་བྱས་པར་པཾ་ལས་བྱུང་བའི་སའི་ལྷ་མོ་རྣམ་པར་བསྒོམས་ནས་ལག་པ་གཡས་པར་ཟླ་བ་ལ་ཧཱུཾ་གསུམ་བསམས་ཏེ།",
    "སོར་མོའི་རྩེ་མོ་ས་ལ་ལན་གསུམ་བསྣུན་པ་དང་དེའི་སྒྲ་དང་ཧཱུཾ་གི་འོད་ཟེར་རྣམས་ཀྱིས་ཡང་དག་པར་བསྐུལ་བ་ལས་འཐོན་པའི་སའི་ལྷ་མོ་ཡེ་ཤེས་སེམས་དཔའ་དང་གཅིག་ཏུ་གྱུར་པ་དགྱེས་པའི་ཐུགས་ཅན་སེར་མོ་ཞི་ཞིང་གོས་དཀར་མོ་མནབས་པ་རྒྱན་ཐམས་ཅད་དང་ལྡན་པ།",
    "ལྷ་མོ་ཆེན་མོ་འཇིག་རྟེན་ཡུམ།",
    "དེ་ཡང་དེ་བཞིན་དུ་གྱིས་ཤིག་ཅེས་གསུངས་ནས་དེ་ཉིད་དུ་ཐིམ་པར་བསམ་མོ་ཞེས་པ་ནོར་འཛིན་མ་ལྷག་པར་གནས་པའི་ཆོ་གའོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་ས་གཞིར་བདུད་རྩི་ལྔ་དང་བཅས་པའི་དྲི་བཟངས་ལ་ཨོཾ་ཨཱ་ཧཱུཾ་གིས་སྔགས་པས་ཉེ་བར་བྱུགས་ཅིང་མེ་ཏོག་བཟང་པོ་གཅལ་དུ་བཀྲམ་དུ་བཅུག་སྟེ།",
    "ཞེས་པའི་གསུང་གི་ཕྱིར་སྦྱིན་པའི་བདག་པོས་ཕུལ་བའི་དོ་ཤལ་དང་རྐང་གདུབ་དང་དཔུང་རྒྱན་དང་ལག་གདུབ་དང་།",
    "ཇི་ལྟ་བར་དམ་ཚིག་གི་འཁོར་ལོ་རྣམ་པར་བསྒོམས་ནས།",
    "དེ་ལྟར་ཡང་ཞི་བ་དང་རྒྱས་པ་དག་གི་བུམ་པའི་ལྟོ་བའི་ཟླུམས་སུ་ནི་སོར་བཅུ་དྲུག་གོ།",
    "ཆ་གཅིག་གིས་ནི་མཆུ་གཉིས་ཀྱི་ཞེང་ངོ།",
    "དབྱེ་བ་དང་བསྐྲད་པ་དག་གི་བུམ་པའི་ལྟོ་བའི་ཟླུམ་པོ་ནི་སོར་བཅུ་གཉིས་སོ།",
    "མཆུ་དག་ནི་སོར་རེ་རེའོ།",
    "རེངས་པའི་བུམ་པ་ནི་ཐུང་བ་སྟེ་ཟླུམས་དང་དཔངས་སུ་སོར་བཅུ་དྲུག་གོ།",
    "ནས་དང་གྲོ་དང་མོན་སྲན་དང་།",
    "ཨ་མྲ་ཨུ་དུམྦཱ་ར་དང་།",
    "ཞེས་པ་དེ་ལྟ་བུའི་རང་བཞིན་ཅན་གྱི་བུམ་པ་རྣམས་བླ་རེའི་འོག་ཏུ་འཆད་པར་འགྱུར་བའི་རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་ལ་མཚན་མ་དགོད་པའི་རིམ་པས་སོ་སོར་རེ་རེར་དྲི་བཟང་པོ་ལ་སོགས་པའི་མཎྜལ་གྱི་སྟེང་དུ་རྗེས་སུ་མཐུན་པའི་གདན་ལ་དཀྱིལ་འཁོར་གྱི་རྣམ་པའམ་གྲལ་དུ་དངར་ཏེ།",
    "དེ་ལས་གཞན་པའི་བུམ་པ་རྣམས་ལ་ནི་སྣ་ཚོགས་ཆུ་སྐྱེས་ལ་གནས་པའི་ཟླ་བ་འམ་ཉི་མར་རང་གི་མཚན་མའམ་ས་བོན་ནམ།",
    "གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པ་དྲུག་གི་གཅིག་དང་།",
    "རང་ཕྱོགས་སྲས་གཉིས་དག་གི་གཅིག།",
    "ཁྲོ་དྲུག་བཙུན་མོ་རྣམས་ཀྱི་ཡང་།",
    "བགེགས་དགྲའི་རེ་རེ་ཉི་ཤུའོ།",
    "ཞེས་པ་ཁ་ཅིག་གིའོ།",
    "ཕྱོགས་བརྒྱད་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་དང་།",
    "ཟུར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་དང་།",
    "རིགས་ཀྱི་ཡུམ་རྣམས་དང་སྒོ་སྐྱོང་རྣམས་ཀྱི་བུམ་པ་རེ་རེ་དང་།",
    "རིམ་པ་གཉིས་པའི་ཕྱོགས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་དང་།",
    "ཕྱོགས་བྲལ་གྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་དང་།",
    "དེ་ལྟར་ཉི་ཤུའོ་ཞེས་པ་ནི་ཁ་ཅིག་གིའོ།",
    "དཔལ་བདེ་མཆོག་གི་དཀྱིལ་འཁོར་ལ་ནི་འཁོར་ལོ་ལྔ་ལ་སོ་སོར་རེ་རེ་སྟེ་ལྔའོ།",
    "དེ་བཞིན་དུ་གསུང་གི་འཁོར་ལོ་དང་སྐུའི་འཁོར་ལོ་ལ་ཡང་སྟེ་བཅུ་དགུའོ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཨུ་ད་ཀ་ཧཱུཾ་ཞེས་པ་འདི་དང་ཡི་གེ་གསུམ་གྱིས་ཀྱང་ལན་བདུན་བསྔགས་པས་ཡེ་ཤེས་ཀྱི་བདུད་རྩིར་བྱ་ཞིང་།",
    "དེ་ནས་དམ་ཚིག་གི་འཁོར་ལོ་ལ་རབ་ཏུ་བཅུག་སྟེ།",
    "མཚན་མ་ཡང་དམ་ཚིག་གི་ལྷ་ཡེ་ཤེས་ཀྱི་ལྷ་དང་གཅིག་ཏུ་གྱུར་པར་བསམ་མོ།",
    "གཞན་ཡང་བུམ་པ་གང་ཞིག་ལྷ་གང་གི་ཡིན་པ་དེ་ལ་ནི།",
    "འདིར་ཇི་སྲིད་དཀྱིལ་འཁོར་གྱི་བྱ་བ་མ་རྫོགས་པ་དེ་སྲིད་དུ་བགེགས་རྣམས་བཟློག་པར་མཛོད་ཅིག་ཅེས་བརྗོད་ཅིང་གཏོར་མ་ཕུལ་ནས་ཉེ་བར་རེག་ལ།",
    "པུས་མོ་གཡས་པ་ས་ལ་བཙུགས་ཤིང་ལྕེ་ཧཱུཾ་ལས་སྐྱེས་པའི་རྡོ་རྗེ་རྩེ་གཅིག་པར་བྱས་པ་ཧཱུཾ་བཀོད་ནས་ལག་པ་གཡས་པས་སྤོས་ཕོར་ཐོགས་ཏེ།",
    "རིག་པའི་རྒྱལ་པོ་ཁྱོད་ལ་འདུད།",
    "བྷྲཱུཾ་ཨཱཾ་ཛྲཱྀཾ་ཁཾ་ཧཱུཾ་གི་ཡི་གེ་རྣམས་ལས་བསྐྱེད་པའི་དེ་བཞིན་གཤེགས་པ་ལྔའི་ངོ་བོར་གྱུར་པར་བསྒོམས་ཏེ།",
    "ནམ་མཁའ་ལ་བཞུགས་སུ་གསོལ་བའི་རང་རང་གི་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་བསྡུས་པར་གྱུར་པ་དེ་བཞིན་གཤེགས་པ་ལྔའི་ཐུགས་ཀར་བྷྲཱུཾ་ཡིག་ལ་སོགས་པ་ལས་གྲུབ་པའི་ཡེ་ཤེས་ཀྱི་སྐུད་པ་འོད་ཟེར་དང་བཅས་པར་བལྟ་ཞིང་།",
    "ཨོཾ་དཱི་པྟ་དྲྀཥྚྀ་ཨཾ་ཀུ་ཤ་ཛ་ཞེས་བརྗོད་ཅིང་རབ་ཏུ་མྱུར་བར་གཡོ་བའི་མིག་གི་རྫི་མ་འདེགས་ཤིང་འགུགས་པ་འབར་བའི་ལྟ་སྟངས་ལྕགས་ཀྱུ་ལྟ་བུས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་བསྐུལ་བས་དེ་རྣམས་རང་གི་ཁ་དོག་ཅན་གྱི་ཐིག་སྐུད་ལག་པར་གནས་པ་རྣམས་ལ་ཐིམ་པར་བསྒོམ་མོ།",
    "མེ་ཏོག་དང་བདུག་སྤོས་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ནས་ལག་པས་རེག་ལ་ལས་ཐམས་ཅད་པའི་སྔགས་ཀྱིས་བསྲུང་བར་བྱའོ།",
    "འཁྱིལ་པ་བཟླས་པའི་བདུད་རྩིའི་ཆུ་དང་ཡུངས་ཀར་དང་དྲིའི་ཆུས་གཏོར་ནས་རྡོ་རྗེ་དང་བསམ་པའི་ལག་པ་གཡས་པས་ཡང་དག་པར་རེག་ཅིང་།",
    "རང་དང་དེའི་གཡས་པ་དང་ཅིག་ཤོས་ཀྱི་མིག་དག་ཛྫ་ཡིག་ལས་སྐྱེས་པའི་ཟླ་བ་དང་ཉི་མ་འོད་ཟེར་སེར་པོ་ཅན་དུ་བསམ་མོ།",
    "རྡོ་རྗེ་དང་བཅས་པའི་ལག་པ་གཡས་པའི་མཐེ་བོང་དང་སོར་མོ་དག་གིས་ཐིག་སྐུད་གཟུང་བ་འདེབས་ཤིང་སེ་གོལ་གྱི་སྒྲ་བྱའོ།",
    "ཐིག་གི་སྒྲས་སྤྱན་དྲངས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མཉམ་པར་བྱོན་ནས་ཐིག་རྣམས་ལ་ཐིམ་པར་བསྒོམ་མོ་ཞེས་པའི་བརྡ་དོན་ནོ།",
    "ཐམས་ཅད་དུ་ཡང་སློབ་དཔོན་དང་སྒྲུབ་པའི་གྲོགས་པོ་གཡས་སྐོར་གྱིས་འགྲོ་ཞིང་དཔལ་བདེ་མཆོག་གི་དཀྱིལ་འཁོར་དང་དཔལ་རྡོ་རྗེ་ཕག་མོའི་དཀྱིལ་འཁོར་ལ་ནི་གཡོན་སྐོར་གྱིས་ཏེ་ཕྱོགས་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་ལྷག་པར་མོས་པར་བྱའོ་ཞེས་པ་ནམ་མཁའ་ལ་ཐིག་གདབ་པའི་ཆོ་གའོ།",
