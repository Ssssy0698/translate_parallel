    "དགུང་ལོ་ཁྲི་ལྡན་གྱི་རི་བོ་སྐྱེད་མོས་ཚལ་དང་།",
    "རང་རེ་གངས་ཅན་གྱི་ལྗོངས་འདིར་བཟོ་གནས་ཇི་ལྟར་དར་བའི་ཚུལ་གླེང་སློང་ཙམ་ཞིག་ཐོག་མར་བརྗོད་པར་བྱ་སྟེ།",
    "ལར་ཕྱི་སྣོད་ཀྱི་འཇིག་རྟེན་འདིར་ནང་བཅུད་མིའི་འགྲོ་བ་བྱུང་ནས་ཡུན་མི་རིང་བར་ཡི་གེ་མ་དར་གོང་གི་ཆེས་སྔ་མོ་ཞིག་ནས་ཕན་ཚུན་འཕྲིན་བརྡ་གཏོང་བ་དང་།",
    "མི་བརྗེད་པའི་ཐབས་སུ་རྟགས་ཀྱི་རི་མོ་རྡོ་དང་ཤིང་གི་སྟེང་དུ་བྲིས་པ་དང་རྐོ་བ་དང་།",
    "འོ་ན་ས་དཀར་གྱིས་ལུས་ལ་རི་མོ་བྲིས་པ་སོགས་ཀྱང་བཟོ་གནས་ཀྱི་གྲས་སུ་བགྲང་བར་འོས་སམ་སྙམ་ན་འོས་ཏེ།",
    "རི་མོ་རྒྱས་བསྡུས་དང་རྒྱུའི་ཁྱད་པར་ཙམ་ལས་སྐབས་དེར་ས་དཀར་གྱི་རི་མོས་ལུས་མཛེས་པར་བྱས་པ་དང་།",
    "རི་མོ་རྒྱས་བསྡུས་དང་ལག་རྩལ་མཐོ་དམན་ཙམ་ལས་གོང་གི་རི་མོས་ཀྱང་དོན་ངེས་ཅན་ཞིག་མཚོན་ལ།",
    "དེང་དུས་འཛམ་གླིང་དུ་གྲགས་པའི་རི་མོ་བས་བྲིས་པའི་རི་མོ་ལའང་དེ་ལས་ལྷག་པའི་ནུས་པ་མ་མཐོང་བའི་ཕྱིར་དང་།",
    "རི་མོ་བསྡུས་དྲག་པས་བཟོའི་གྲལ་དུ་གཏོགས་དཀའོ་ཞེ་ན།",
    "རང་རེ་བསིལ་ལྡན་གྱི་ལྗོངས་འདིར་ཐོག་མར་མིའི་འགྲོ་བ་བྱུང་སྟེ་བཟོ་དངོས་མཚོན་ཆ་སོགས་ཇི་ལྟར་དར་བའི་ཚུལ་ལ་འདི་ལྟར་སྣང་སྟེ།",
    "བློ་དང་མོན་ལྟར་སྤྱོད་པས་བོད་ཡུལ་གང་།",
    "ལྡོང་དང་སྟོང་གི་རུས་ཚན་བཞི་བྱུང་བ་དང་།",
    "གཉིས་པ་རེ་ཏེ་མགོ་གཡག་བདུད་ཀྱིས་བྱས།",
    "སྟ་རེ་དགྲ་སྟ་དེ་ཡི་དུས་སུ་བྱུང་།",
    "གསུམ་པ་སྲིན་པོ་གཉའ་རེང་ཁྲག་མིག་བྱས།",
    "སྲིན་མོ་རྐང་པ་གྱོགས་གཉིས་ལག་ཆར་བྱུང་།",
    "དེ་ནས་རིམ་བཞིན་འཕེལ་བ་དང་རིགས་རྒྱུད་དང་ཚོ་བའི་བར་འཁྲུག་རྩོད་རྒྱུན་མི་ཆད་པ་བྱུང་བའི་རྐྱེན་གྱིས་རྒྱལ་ཕྲན་སིལ་མ་བཅུ་གཉིས་སུ་གྱུར་ནས་རྒྱལ་ཕྲན་རེ་ལ་རྒྱལ་པོ་གཅིག་དང་བློན་པོ་གཉིས་རེའི་སྲོལ་དར་སྟེ།",
    "དེ་ནས་ཡང་ཡུལ་ནི་འབྲོག་མོ་རྣམ་གསུམ་ན།",
    "དེ་ལས་ཆེས་སྔ་མོ་ཞིག་ནས་བོད་དུ་གཟུགས་བཟོ་ལག་རྩལ་དར་བ་ཤིན་ཏུ་རྟོགས་སླ་ལ།",
    "འཕགས་ཡུལ་དང་བལ་པོ་སོགས་སུ་སྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་བཞེངས་ཐབས་ཀྱི་བསྟན་བཅོས་ཆེས་སྔ་མོ་ནས་ཡོད་ཅིང་།",
    "གསུམ་པ་བསམ་ཡས་སོགས་བཞེངས་པའི་སྐབས་སུ་བོད་ལ་བཟོ་བོ་མཁས་པ་ཡོད་ནའང་གྲངས་ཉུང་བའི་རྐྱེན་གྱིས་རྣམ་པ་རྒྱུ་ཆེ་བའི་གཙུག་ལག་ཁང་བཟོ་སྐྲུན་བྱེད་པ་ལ་བཟོ་བོ་ཉུང་ཤས་ཤིག་གིས་འགྲུབ་དཀའ་བ་ཙམ་ལས་བོད་དུ་ལག་ཤེས་ཅན་མེད་པ་མ་ཡིན་པ་བཅས་ནི།",
    "སྐབས་དེར་སྐྱུ་ར་ལྷ་ཆེན་ཞེས་པའི་རི་མོ་བ་མཁས་ཅན་བྱུང་མྱོང་བའི་བཟོ་ཁྱད་དང་བཅས་པ་གསལ་བ་ལྟར་དང་།",
    "བཙན་པོ་འདིའི་སྔོན་རྗེས་སུ་སྐུ་གསུང་ཐུགས་ཀྱི་བཟོ་ལ་མཁས་པ་བྲམ་ཟེ་དུང་གི་རྣ་ཆ་ཅན་དང་།",
    "རྗེ་བློན་འདི་དག་གི་བཀའ་དྲིན་ལ་བརྟེན་ནས་རྒྱ་གར་ལུགས་ཀྱི་བཟོ་རྒྱུན་གཙོ་བོར་གྱུར་པའི་བཟོ་རྩལ་འཕེལ་རྒྱས་ཆེན་པོ་བྱུང་།",
    "བོད་གསུམ་གྱི་བཟོ་རྒྱུན་སོ་སོ་མ་འདྲེས་པ་རང་རང་གི་རྒྱུན་སྤེལ།",
    "ལུགས་གསུམ་དུ་བྱས་ནས་བསམ་ཡས་སྤྲུལ་པའི་གཙུག་ལག་ཁང་རྟེན་དང་བརྟེན་པ་ཇོ་མོ་གླིང་གསུམ་དང་བཅས་པ་བཞེངས།",
    "གོང་མ་ཐང་མིང་ཙུང་གི་སྐབས་བཞེངས་པའི་གནས་བརྟན་བཅུ་དྲུག་གི་སྐུ་བརྙན་བཤུས་ཏེ་བོད་དུ་བསྣམས་ནས་བྲག་ཡེར་པའི་གནས་བཅུ་ལྷ་ཁང་དུ་གནས་བརྟན་གྱི་འབུར་སྐུ་རྣམས་བཞེངས།",
    "གསང་ཕུ་སོགས་སུ་བཞེངས་པ་ལས་མཆེད་དེ་བོད་ཁམས་ཀུན་ཏུ་གནས་བཅུ་བྲིས་འབུར་གྱི་སྐུ་ཐམས་ཅད་རྒྱ་ནག་གི་ལུགས་སུ་བཞེངས་སྲོལ་དར།",
    "ཐུབ་པའི་བསྟན་པ་ཉིན་མོ་ལྟར་གསལ་བར་མཛད་པ་དང་ལྷན་གཅིག་ཏུ།",
    "རི་མོ་མ་བསླབས་པར་མཁྱེན།",
    "རི་མོ་དང་རི་མོའི་བསྟོད་ཚོགས་ཀྱང་གསར་རྩོམ་མཛད།",
    "གོང་དཀར་སྒང་སྟོད་ནས་མཁྱེན་བརྩེ་ཆེན་མོ་རྣམ་གཉིས་བྱོན།",
    "བོད་ཀྱི་རི་མོ་བ་གྲགས་ཅན་རྡོ་པ་བཀྲ་ཤིས་རྒྱལ་པོ་སོགས་སྔོན་བྱོན་དམ་པ་རྣམས་ཀྱི་སོར་མོ་འདུ་བྱེད་ལས་བྱུང་བའི་བོད་སྔར་ཡོད་ཀྱི་རི་མོ་གཞི་བྱས།",
    "དེ་ནི་བོད་རང་ཉིད་ཀྱིས་བརྩམས་པའི་བཟོ་གཞུང་གི་ཐོག་མའང་ཡིན་པས།",
    "གྲུབ་ཐོབ་ཆེན་པོས་རང་ཉིད་ཀྱིས་གསོལ་བ་བཞེས་རིང་རེ་ལའང་རང་གི་འདྲ་སྐུ་རེ་ཕྱག་བཟོ་མཛད་པ་སོགས་ངོ་མཚར་སྙན་པའི་སྒྲ་དབྱངས་རྒྱ་བོད་ཀུན་ཏུ་བསྒྲགས།",
    "པིར་དང་ཤོག་བུ་འབྲལ་མེད་དུ་བསྣམས་ཤིང་རི་མོ་ཞིག་ཡོད་ཚད་ལ་ཉུལ་གཟིགས་མཛད་པས།",
    "ལུགས་གསུམ་དུ་གྱེས་ནས་རང་རང་གིས་རྒྱུན་སྤེལ།",
    "ཚོན་དང་རི་མོ་ཉམས་རྣམ་འགྱུར།",
    "ཞེས་གོང་གི་བཟོ་རྒྱུན་ཐམས་ཅད་ཀྱི་ལེགས་པའི་ཆ་གཅིག་ཏུ་ལྡེབ་པའི་སྒར་ལུགས་གསར་མའི་སྲོལ་བཏོད།",
    "དེ་ཕྱིས་ཁམས་ཀྱི་ལྷ་བཟོ་ནམ་མཁའ་རྒྱན་ཞེས་སྤྲུལ་བའི་ལྷ་བཟོར་བསྔགས་པ་དེས་མཐོང་བ་དང་སྒྲིབ་པའི་རིག་པ་བོད་རིས་སུ་བེད་སྤྱད་པས་རི་མོ་འབུར་ཚུགས་ཅན་དུ་གྲགས།",
    "རྒྱ་ནག་གི་སྣག་ཆུའི་རི་མོའི་ལུགས་ལ་སྦྱངས་ནས་གནས་བརྟན་ཆུ་རིས་མ་སོགས་བྱུང་།",
    "འཇམ་དབྱངས་བློ་གསལ་གྱིས་མཛད་པའི་བོད་ཀྱི་རི་མོ་འབྲི་ཚུལ་དེབ་གསར་ཀུན་ཕན་ཉི་མ་ལས།",
    "མོ་འགབ་ལྷ་བྲིས་པ།",
    "ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་དང་རྒྱ་སྟག་ར་མོ་ཆེ།",
    "མ་ས་གོང་གི་གཙུག་ལག་ཁང་ལྔ་ལ་སོགས་པ་བཞེངས།",
    "གཙང་ཁང་གི་སྒོ་བརྩིགས་ནས་ཞལ་བ་བྱས་ཏེ་བཙུན་པ་ཆང་འཐུང་བའི་རི་མོ་བྲིས་ནས་བཞག་ཅེས་བྱུང་བ་ལྟར་ཐབས་ཚུལ་སྣ་ཚོགས་ཀྱིས་གཙུག་ལག་དང་རྟེན་གསུམ་ལ་བདག་གཅེས་བྱས།",
    "རྔོག་ལེགས་པའི་ཤེས་རབ་ཀྱིས་གསང་ཕུར་གྲྭ་ཚང་བཅུ་གཉིས་སོགས་བཀའ་གདམས་བཤེས་གཉེན་རྣམས་ཀྱིས་བསྟན་པའི་ཞལ་གསོས་སུ་གཙུག་ལག་ཁང་བྲེ་ཙམ་རེ་ཡང་བཞེངས་ཅི་ཐུབ་ཀྱི་ཐུགས་འདུན་ལ་བརྟེན་ནས་གཙུག་ལག་ཆེ་ཕྲ་མང་དུ་བཞེངས།",
    "དེ་རྗེས་ས་སྐྱའི་སྤྲུལ་པའི་ལྷ་ཁང་ཆེན་མོ་བཞེངས།",
    "མཁས་གྲུབ་ཐམས་ཅད་མཁྱེན་པས་གོང་གི་མཆོད་རྟེན་གྱི་དྲི་གཙང་བཞེངས།",
    "དེ་རྗེས་རྒྱ་ནག་གི་ཐང་ཡིག་ཏུ་འཁོད་པ་ལྟར་ན།",
    "ཆུ་མོ་བྱི་ལོའི་དཔྱིད་མགོ་བཙུགས་ཏེ།",
    "ཤིང་ཕོ་སྟག་གི་ལོའི་སྟོན་ཚད་སྟོན་ཟླ་འབྲིང་པོ་ལ།",
    "ད་ལྟར་ཧྥ་རན་སིས་ཉར་ཞིང་འཛམ་གླིང་དུ་བསྒྱུར་ཡིག་ལ་ཆེས་སྔ་བར་གྲགས་པའི་བོད་ཡིག་གི་རཱ་མ་ཎའི་རྟོག་བརྗོད་ཏུན་ཧོང་ནས་ཐོན་པ་སོགས་དང་།",
    "ཨ་མེ་རི་ཀ་ཨུ་རུ་སུ་སོགས་ཕྱི་གླིང་གི་རྒྱལ་ཁབ་མང་པོ་ཞིག་གིས་དཔེ་མཛོད་དུ་ཡུལ་དེ་ནས་ཐོན་པའི་བོད་ཡིག་གི་དཔེ་དེབ་མང་པོ་བཞུགས་ཤིང་དེ་དག་ལ་མཐོང་ཆེན་གྱི་ཞིབ་འཇུག་དང་པར་སྐྲུན་བྱས་སྐད་དེ།",
    "རྒྱ་བོད་ཧོར་སོག་གི་ཡུལ་གྲུ་མང་པོར་གཙུག་ལག་གི་ལྡེབས་རིས་བོད་ལུགས་སུ་བྲིས།",
    "པེ་ཅིང་ཧྥ་ཡོན་དགོན་དུ་གུ་གུ་ཤ་ལས་གྲུབ་པའི་རྒྱ་བལ་བོད་ལུགས་ཀྱི་མཆོད་རྟེན་རྣམ་གསུམ་གྱི་ཡ་གྱལ་སོགས་མཆོད་རྟེན་གྲགས་ཅན་ཕལ་མོ་ཆེ་ཞིག་བོད་ལུགས་སུ་བསྐྲུན།",
    "རི་མོ་བ་གྲགས་ཅན་གཅིག་དང་།",
    "རང་གི་ཡུལ་ནས་རང་རིགས་ཀྱི་རིག་པ་དང་ལག་རྩལ་ལས་བྱུང་ཞིང་མི་རིགས་དང་ཡུལ་གྲུ་གཞན་གྱི་བཟོ་ཡིས་ཤན་ཞུགས་མ་སོང་བ་དེ་ཡིན།",
    "བཟོ་རྒྱུན་གཞན་གྱི་ལེགས་ཆ་བསྡུས་པ་དེས་སྔར་ཡོད་ཀྱི་ལག་རྩལ་དང་བསྟན་བཅོས་ཐམས་ཅད་ཇེ་བཟང་ཇེ་རྒྱས་སུ་སོང་ནས་དོན་ཅི་ཡང་མཚོན་ནུས་པའི་ལག་རྩལ་འཐུས་སྒོ་ཚང་བའོ།",
    "སྔར་ཡོད་ཀྱི་བཟོ་རྒྱུན་གང་ཡིན་པ་ཞིག་གི་རྨང་གཞི་ཐོག་བཟོ་བོ་རང་གི་རིག་པ་དང་ལག་རྩོལ་ལས།",
    "རང་རང་གི་རིག་པ་དང་རྩལ་ལས་སྔར་མེད་ཀྱི་སྲོལ་ཁྱད་པར་ཅན་ཚུགས་ཤིང་།",
    "འོ་ན་བོད་དུ་ཆེས་སྔ་མོ་ཞིག་ནས་དར་བའི་བཟོ་རིག་གི་དངོས་པོ་ཇི་ལྟ་བུ་ཞིག་ཡོད་སྙམ་ན།",
    "བོད་དུ་ཕྱིས་སུ་བྱུང་བའི་རིགས་བརྒྱུད་ཆེ་བ་རེ་འགའ་དང་།",
    "རིག་དངོས་ཀྱི་མཛོད་དུ་ཡ་ཐོག་གི་རྡོའི་ལག་ཆས་དང་འདམ་གྱི་རྫ་མ་ལ་སོགས་ཀྱི་དངོས་པོ་མ་མཐོང་ངོ་ཞེ་ན།",
    "ཕྱིར་མི་སློག་པ་ཙམ་དུ་མ་ཟད་སའི་བཅུད་མི་ཉམས་པའི་ཆེད་དུ་ནོར་གཏེར་དང་བུམ་གཏེར་སྦས་སྲོལ་སྔ་མོ་ནས་ཡོད་པ་མ་འོངས་རྒྱལ་རྒྱུད་རྣམས་ལ་ནོར་སྐལ་གཏེར་དུ་སྦས་ཚུལ་ལས་བྱུང་བ་ལྟར་རོ།",
    "དེང་དུས་སུ་ཤར་རྒྱལ་མོ་རོང་དང་ཁམས་བྲག་འགོ།",
    "རྩེ་མོ་སེན་ཁ་རྩ་བ་གཟོང་ཁ་སྟེ།",
    "གོན་ཁྲུབ་འདི་ནི་སྨར་ཁམས་དེ་མོ་ནས།",
    "བཟོ་རིས་ཉ་འདྲ་ཡིན་མོ་དེ་ལས་ཆུང་།",
    "ཞེས་བོད་བཟོ་དངོས་འདི་དག་གི་མིང་ཙམ་དུ་མ་ཟད།",
    "དངོས་པོ་འདི་དག་གི་འབྱུང་ཁུངས།",
    "མིང་ཐོགས་ཚུལ་ཐམས་ཅད་གསལ་ཞིང་བསྟན་བཅོས་འདིར་འཁོད་པའི་དངོས་པོ་ཐམས་ཅད་རྩོམ་པ་པོས་དངོས་པོ་ལ་བལྟས་ཤིང་ཞིབ་ཏུ་བརྟགས་པ་དང་གནའ་རྫས་ལྟ་བར་མཁས་པའི་རྒན་པོ་དག་ལ་བསྙད་དེ་ཁུངས་བཙན་པར་བགྱིས་ཚུལ་ཡང་གོང་གི་མཇུག་བྱང་དུ་འཁོད་ཡོད་དོ།",
    "དེ་ནས་གོང་གི་རྨང་གཞིའི་སྟེང་བོད་ཀྱི་རིག་པའི་སྒོ་ཆེར་ཕྱེ་སྟེ།",
    "ཆུང་གི་སྲིད་གནོན།",
    "སྲོང་བཙན་གྱི་སྐབས་སུ་སྐྱུ་ར་ལྷ་ཆེན་གྱིས་བོད་སྔར་ཡོད་ཀྱི་རི་མོ་དང་བལ་པོའི་བཟོ་རྒྱུན་གཅིག་དུ་འདྲེས་པའི་རྒྱུན་གསར་དུ་སྤེལ་བ་ལ་སྔ་འགྱུར་སྐྱུ་ར་ལྷ་ཆེན་གྱི་ལུགས་སུ་གྲགས་ཞེས་འཁོད་པ་ལས།",
    "དེའི་སྔོན་དུ་བོད་ལ་གཅིག་གི་རྗེས་སུ་གཅིག་འཇུག་པའི་སྲོལ་ཚུགས་པ་དང་བཟོའི་བསྟན་བཅོས་སོགས་ཡོད་མེད་མ་ངེས་ཀྱང་།་",
    "ཕྱིས་བོད་ཀྱི་རི་མོ་ལ་རྒྱ་ནག་ལུགས་ཀྱི་ཤན་ཞུགས་ཆེ་ཞིང་།",
    "འོན་ཀྱང་དེང་གི་རྒྱ་བོད་ཀྱི་རི་མོ་བ་འགའ་ཞིག་གིས་བོད་ཀྱི་རི་མོ་ནི་རྒྱ་ནག་གི་ཞིབ་བྲིས་རི་མོ་ཡིན་ཚུལ་དང་།",
    "བཟོའི་བསྟན་བཅོས་ལ་བསམས་ན་གཞུང་འདིའི་ལེའུ་བརྒྱད་ཀྱི་ནང་དུ་རྒྱ་ནག་གི་བཟོའི་བསྟན་བཅོས་དང་འདྲ་ས་བཅད་རིས་རིགས་གཉིས་དང་ཚོན་གྱི་རྒྱུ་འགའ་ཞིག་མདངས་རྒྱག་སྟངས་གཅིག་ཁོ་ན་ཙམ་སྟེ།",
    "པིར་འཛིན་སྟངས་ཀྱིས་རི་མོ་ལ་ཁྱད་པར་ཆེ་སྟེ།",
    "རི་མོ་དངོས་ལ་བསམས་ན།",
    "རྒྱ་དཀར་ནག་གི་བཟོ་ལ་མ་དར་བའི་གངས་ཀྱི་སེང་གེ་དང་།",
    "སྐྱོ་འབུར་གྱི་རི་མོ་དང་།",
    "མི་མཐུན་གཡུལ་ལས་རྒྱལ་བའི་རི་མོ་དང་།",
    "གཞན་ཡང་གླུད་གཏོར་གྱི་རིགས་སུ་སྤྱོད་པའི་ཤིང་གི་ཟན་པར་ལས་བསྒྲུབས་པའི་སྲོག་ཆགས་ཀྱི་གཟུགས་བརྙན་སྣ་ཚོགས་སོགས་གླུད་རྫས་ཡར་མཆོད་ཡས་སྟགས་ཀྱི་རིགས་དང་།",
    "དེའང་ཕྱི་གླིང་པ་མཁས་ཅན་འགའ་ཞིག་གི་ངག་ལས་འདི་སྐད་ཐོས་ཏེ།",
    "རྒྱ་ནག་པས་མི་ལོ་ཉིས་སྟོང་ལྷག་གི་རིང་རང་གིས་རང་རིགས་ཀྱི་གོམས་གཤིས་ཐེངས་མང་བསྒྱུར་ཀྱང་ཀོང་ཙེ་འཕྲུལ་རྒྱལ་གྱི་བསམ་བློའི་ཤུགས་རྐྱེན་ཆེན་པོ་ཞིག་ད་ལྟར་ཡང་གནས་ཡོད་པ་ལྟ་བུའོ།",
    "དུས་སྐབས་རེ་རེ་བཞིན་གྱི་འགྱུར་ཚུལ།",
    "བོད་ཀྱི་བསྐལ་པ་ཡ་ཐོག་གི་བཟོ་དངོས་རྣལ་མ་བཅས་མངོན་གསལ་ཙམ་མཐོང་ཐུབ་པའོ།",
    "ཐོ་ཐོ་རི་སྙན་ཤལ་ཡང་འབོད་དེ་ཡབ་ཁྲི་རྗེ་ཐོག་བཙན་དང་ཡུམ་རུ་བཟའ་སྟོང་རྒྱལ་ན་མོ་ཚོ་གཉིས་ཀྱི་སྲས་སུ་སྤྱི་ལོ་༣༧༤ལོར་སྐུ་འཁྲུངས།",
    "བཙན་པོ་དགུང་ལོ་དྲུག་ཅུ་བཞེས་སྐབས་སྐུ་མཁར་ཡུམ་བུ་བླ་སྒང་གི་རྩེར་བཞུགས་པའི་ནངས་གཅིག་གི་ཚེ་ནམ་མཁའི་མཐོངས་ཐམས་ཅད་འཇའ་ཚོན་ཁ་དོག་སྣ་ཚོགས་བཀྲ་བའི་གསེབ་ནས་མེ་ཏོག་གི་ཆར་བབས།",
    "ལྷའི་རོལ་མོ་སྒྲ་རང་བྱུང་དུ་གྲག་ཉི་མའི་ཟེར་དང་འགྲོགས་ནས་གསེར་གྱི་ཤོག་བུ་ལ་བེཌཱུརྱ་ཞུན་མས་བྲིས་པའི་སྤང་ཀོང་ཕྱག་རྒྱ་པ་དང་།",
    "གསེར་སྐྱེམས་གཡུ་སོགས་ཀྱིས་མཆོད་ཅིང་ཕྱག་བསྐོར་བཀུར་སྟི་རྒྱ་ཆེར་བྱས་པས་རྒྱལ་པོ་དགུང་ལོ་དྲུག་ཅུ་སོན་པ་དེ་བཅུ་དྲུག་གི་ན་ཚོད་དང་ལྡན་པར་གྱུར།",
    "བྲག་ལ་སྤྱན་རས་གཟིགས་ཁ་སར་པ་ཎི་དང་།",
    "དཔལ་རྟ་མགྲིན་སོགས་རང་བྱུང་དུ་བྱོན་པ་ལ་ཡུན་དུ་གནས་པའི་ཆེད་དུ་བལ་པོའི་ལྷ་བཟོས་འབུར་དུ་དོད་པ་བརྐོས་ཏེ་རྣམ་པ་གསལ་སྟོང་གི་ལྷ་ཁང་ཚུལ་དུ་མཛད་ལ།",
    "བཟོ་བོ་དེ་ནི་སྲོང་བཙན་རང་གི་སྤྲུལ་པ་ཡིན་པས།",
    "གྲུབ་པའི་རང་བྱུང་སྤྱན་རས་གཟིགས།",
    "དེ་ནས་ལྷ་མོ་ཁྲོ་གཉེར་ཅན་གྱི་སྤྲུལ་པར་གྲགས་པའི་བལ་བཟའ་ཁྲི་བཙུན་དེ་ཉིད་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེ་གཙོས་པའི་རྟེན་དང་ནོར་རྫས་མཐའ་ཡས་པ་དང་བཅས་བོད་ཀྱི་རྒྱལ་པོའི་བཙུན་མོར་ཕེབས་ནས་ཡུན་རིང་མ་སོང་བའི་དུས་གཅིག་གི་ཚེ།",
    "གནོད་སྦྱིན་ཕོ་མོ་ལ་སོགས་པའི་བཟོ་བོ་མང་པོ་བྲན་དུ་བཀོལ་ཏེ་དམར་པོ་རི་ཁོངས་སུ་བཅུག་པའི་སོ་ཕག་གི་ལྕགས་རི་ལོགས་རེར་རྒྱང་གྲགས་རེ་རེ།",
    "དཔངས་སུ་གྱང་ཕྲེང་སུམ་ཅུ་རྩ་དྲུག་གི་ཚད་བསྐོར་བ་སྒོ་བཞི་སྒོ་སྤེ་རྟ་བབ་དང་བཅས་པ།",
    "དེའི་རྩེར་ཡང་དར་དམར་རྐེད་ཁྲ་ཅན་བཏགས་པའི་མདུ་དམར་བཅུ་རེ་བཙུགས་ཤིང་མཚོན་ཆ་སྣ་ཚོགས་པ་གཟིངས་པ་དར་གྱི་ཆུན་འཕྱང་སྣ་ཚོགས་བྲེས་པ་བྱས།",
    "ཁོང་འབིས་སུ་ཀོང་ཇོས་བཞེངས་པའི་རྣམ་སྣང་གི་སྐུ་དང་།",
    "རྣམ་སྣང་གི་ཞལ་བྱང་བཀླགས་པས།",
    "སྐབས་དེར་རྒྱ་བལ་བཙུན་མོ་གཉིས་ཀྱི་རྟེན་སྐལ་ཇོ་བོ་རྣམ་གཉིས་གཙོས་ཡུལ་གྲུ་དུ་མ་ནས་རྟེན་མང་པོ་བོད་དུ་དྲངས་ཟིན་པས་རྒྱལ་པོའི་དགོངས་པ་ལ།",
    "ཇུ་ཡག་གི་རྩིས་དང་ས་དཔྱད་བྱས་པས་ཡུལ་དེ་ན་བཀྲ་ཤིས་པའི་རྟགས་བརྒྱད་ལ་སོགས་པ་དགེ་མཚན་དུ་མ་ཚང་ནའང་།",
    "སྤྱིར་བོད་ཡུལ་འདི་སྲིན་མོ་གན་རྐྱལ་དུ་འགྱེལ་བ་དང་འདྲ་སྟེ་དེའི་ཚིགས་ཆེན་བརྒྱད་དང་མཐིལ་བཞི་པོ་གནོན་པའི་ལྷ་ཁང་རེ་དང་པོར་ཐོབ་ལ།",
    "བཙན་པོ་ཉིད་དགུང་ལོ་ཉི་ཤུ་རྩ་གཅིག་གི་དུས་སུ།",
    "འོ་ཐང་མཚོའི་སྟེང་དུ་ར་སའི་འཕྲུལ་སྣང་གཙུག་ལག་ཁང་གི་རྨང་འདིང་མཛད་པ་ལ།",
    "རྡོ་རྗེ་ཀླུ་འབྱིམ་བྱུགས་པའི་ཤིང་གིས་ཕུབ།",
    "ཐུགས་ཀའི་དབུས་སུ་ཐལ་མོ་མཉམ་པར་སྦྱར།",
    "ལོངས་སྐུ་ཡན་ལག་གི་ཕྱག་སོ་བརྒྱད་དང་།",
    "སྐབས་དེའི་བལ་བཟོའི་རི་མོ་ནི་གཞི་རྒྱ་གར་གྱི་བཟོ་རྒྱུན་ཏེ།",
    "དབུ་རྒྱན་དང་ཞབས་ཕྱག་གི་གདུ་བུ་ཙམ་ལས་རྒྱན་གོས་གཞན་མེད་པས་ཕལ་ཆེར་གཅེར་ཚུགས་ཅན་སྐུ་ཤ་ལ་ཚོན་གར་སླའམ་ཡང་ན་མདངས་ཀྱིས་འབུར་ཚུགས་དོད་ཙམ་ལས་བཅད་རིས་དང་ཞིབ་ཚགས་སོགས་མེད་ཀྱང་ཉམས་འགྱུར་བཟང་བ།",
    "པད་གདན་སོགས་རི་མོ་རེ་འགའ་ལ་སྦྱར་མཐིང་སྦྱར་ལྗང་ཙམ་ལས།",
    "སྤང་མཐིང་གི་ཚོན་ཆེས་ཉུང་བ།",
    "རྒྱལ་པོས་རང་བྱུང་གི་རྟེན་ལ་གསོལ་བ་བཏབ་པས་ཁྲོ་ཞལ་ལས་འོད་དམར་ལྗང་གཉིས་ཀྱི་རྩེར་ཁྲོ་བོ་རྟ་མགྲིན་དང་བདུད་རྩི་འཁྱིལ་བ་གཉིས་བྱུང་བའི་ཞལ་ནས་མེ་ཕུང་ཐོག་ལྟ་བུས་འདྲེ་འདུན་རྟེན་གནས་དང་བཅས་པ་གཏོར།",
    "ཐོག་མར་སྲིན་མོའི་ཚིགས་དང་མཐིལ་གནོན་དགོས་པར་དགོངས་སོ།",
    "དེ་ནས་སྲིན་མོའི་དཔུང་མགོ་གཡོན་གནོན་པའི་ཕྱིར་ཡར་ལུངས་སུ་བོད་གངས་ཅན་གྱི་ལྗོངས་སུ་བརྩིགས་པ་ལ་ཆེས་སྔ་བའི་ལྷ་ཁང་སྟེ།",
    "གནོད་སྦྱིན་ཕོ་མོ་བྲན་དུ་བཀོལ་ཏེ་དེའི་སྟེང་དུ་གསང་བ་འདུས་པའི་ལྷ་བཅུ་དགུ་པའི་ལུགས་སུ་བཞེངས།",
    "གཙོ་བོ་གསུམ་རྡོ་སྐུ་རང་བྱུང་ཟོ་དང་གོང་པོ་རི་ནས་སྤྱན་དྲངས་པ་སླར་བཟོ་བོས་རྣམ་པར་དོད་པར་བརྐོས་པས་རྡོ་ཕྱེ་རྣམས་རིང་བསྲེལ་དུ་སོང་སྐད།",
    "བོད་འབངས་ཀྱི་དུས་མ་ཡིན་པའི་འཆི་བ་ཟློག་པའི་ཕྱིར་ལྷ་མོ་ཡིད་བཞིན་འཁོར་ལོ་དང་།",
    "ཚངས་པ་དུང་གི་ཐོར་ཚུགས་ཅན་ལ་གཉེར་དུ་གཏད།",
    "ཡང་གཙུག་ལག་དེ་ལ་ཚེ་སྤོང་བཙན་འདྲ་དོང་ཆུང་ཟེར་བའི་བློན་པོ་ཞིག་གིས་ལྷ་ཁང་གློ་འབུར་ཞིག་ཀྱང་བྱས་སོ།",
    "དེ་ནས་རིམ་བཞིན་ཁྲ་འབྲུག་གི་ཡན་ལག་དུ་བཙན་ཐང་བཏབ།",
    "དཔྱི་གཡས་གཡོན་གནོན་པ་ལ་རྩེ་ཕུག་དང་བརྒྱད་ཕུག་ཏུ་སྒྲུབ་པ་བྱས་ཏེ་གཡས་སུ་གཙང་འགྲམ་དང་ཡན་ལག་ཏུ་དགེ་དྲུང་གི་ལྷ་ཁང་དང་།",
    "གྲུ་མོ་གཡས་པ་ལ་ཤར་སྟག་གི་མགོར་ཀོང་པོ་བུ་ཆུ།",
    "ལག་མཐིལ་གཡས་གནོན་པ་ལ་མི་ཉག་གིས་ལག་དཔོན་བྱས་ཏེ་ཁམས་ཀློང་ཐང་སྒྲོན་མ་དང་གཡོན་ལ་ཐོ་གར་གྱིས་ལག་དཔོན་བྱས་ཏེ་མོན་སྐྱོར་ཆུ།",
    "བོད་འབངས་རྣམས་ཀྱིས་འོག་ཁང་གི་རྩིག་པ་ཟིན་པ་དང་།",
    "རྒྱལ་པོ་སྐུ་ལུས་ཀྱི་སྤྲུལ་པ་བརྒྱ་རྩ་བརྒྱད་མཛད་དེ་ལྷ་ཁང་གི་སྒོ་སྲུང་ནས།",
    "བསང་བུ་ཡང་བལ་མོ་བཟའ་མིན་པ་གཞན་གྱིས་མི་སྐྱེལ་ལོ།",
    "རྒྱལ་པོའི་བསང་བུ་གཡོག་མོ་ལ་བསྐུར་བར།",
    "གཡོག་མོས་སྒོ་ཕྱེས་ནས་ཕྱིན་པས།",
    "སེང་གེ་བརྒྱ་རྩ་བརྒྱད་ཀྱི་སྣའི་བཟོ་བྱེད་ཀྱིན་འདུག་པས་བསང་བུ་གང་ལ་འདྲེན་ངོ་མ་ཤེས་པས་ཕྱིར་ལོག་ནས་བསང་བུ་བལ་མོ་ལ་གཏད་དོ།",
    "དེར་གཡོག་མོའི་བསམ་པ་ལ་རྒྱལ་པོ་འདི་ལ་སྤྲུལ་པ་ཡོད་ཟེར་པ་དེ་ཨེ་བདེན་ནམ་བསམས་ནས།",
    "ཁྲི་བཙུན་རྒྱལ་པོ་ལ་བསང་བུ་འདྲེན་སོང་བའི་རྗེས་སུ་འབྲངས་ཤིང་།",
    "སྒོ་ཕག་ནས་བལྟས་པས་བལ་མོས་ཀྱང་བརྒྱ་རྩ་བརྒྱུད་དུ་སྤྲུལ་ནས་ཤིང་བཟོ་བརྒྱ་རྩ་བརྒྱད་ལ་དུས་གཅིག་ཏུ་བསང་བུ་དྲངས་པ་མཐོང་ནས།",
    "ཧེ་ཧེ་ཞེས་གད་མོ་ཤོར་བ་དང་།",
    "རེའུ་མིག་རིས་སུ་བྱས་པས་བོད་འབངས་དགའ།",
    "ལྷ་ཁང་གི་སྒོ་ཡང་ནུབ་ཕྱོགས་བལ་པོའི་ཡུལ་ལ་གཏད་དོ།",
    "སྤྲུལ་པའི་གཙུག་ལག་ཁང་དེའི་བཟོ་བཀོད་ནི་མཐིལ་ཞལ་ཐམས་ཅད་བེཌཱུརྱ་སྔོན་པོ་ལྟར་ངང་པ་ཆུའི་རི་མོ་ཅན་ལ་སྟེང་གི་ཉ་དང་ཆུ་སྲིན་དང་བྱ་ལ་སོགས་པའི་རི་མོ་དང་འཕྲུལ་གྱི་གཟུགས་བརྙན་སྣང་བ།",
    "ཀ་ཞུ་གདུང་དང་གདུང་ཁེབས་སོགས་བརྩེགས་ལེགས་ཤིང་དབྱིབས་སྣ་ཚོགས་ཅན་སྟེང་འོག་གི་མཐོངས་ཀའི་ཕྱམ་སྣ་ཐམས་ཅད་ལ་སེང་གེ་དཀར་མོ་གཡུ་རལ་ཅན་བརྒྱ་རྩ་བརྒྱུད་འཕྱོང་བ་ལྟར་གནས་པ།",
    "དར་ཟབ་སྦྱར་ནས་རྒྱལ་པོས་ཇི་ལྟར་ཞལ་གཟིགས་པ་བཞིན་སོ་སོར་བཞེངས་ཏེ་སྒོའི་དཀྱིལ་འཁོར་གཡས་སུ་གནོད་སྦྱིན་ཁང་པ་དང་གཡོན་དུ་ཀླུའི་ཁང་པ་མཛད།",
    "ཤར་ལྷོའི་གཡུང་དྲུང་ཁུགས་སུ་ལྕོག་སྟེང་ཁང་གྲུ་སྐས་དང་བཅས་པ་བྱས་ཏེ་དཔལ་ལྡན་ལྷ་མོའི་རྟེན་བཙུགས།",
    "ལྷོ་ཕྱོགས་སུ་རབ་བྱུང་གི་རི་མོའི་གླིང་གཉིས་ཀྱི་ཁར་འཇམ་དབྱངས་དང་བདེ་བ་ཅན་གྱི་ཞིང་བཀོད།",
    "ཤར་ལོགས་ལ་སྒྲོལ་མ་སྤྱན་རས་གཟིགས་ཐུབ་པ་བདུད་འདུལ་སེམས་དཔའི་ཚོགས་བཅས།",
    "བར་ཁང་དུ་རྟ་མགྲིན་དཀར་པོ་དང་ཇོ་མོ་སྒྲོལ་མ་སོགས་བྲིས།",
    "ཕྱི་སོ་ཕག་གི་ལེགས་པར་བརྩིགས་ཏེ་རྒྱ་ཕིབས་སྟག་ལྟར་བཀྲ་བས་རྒྱ་སྟག་ར་མོ་ཆེའི་ལྷ་ཁང་དུ་གྲགས།",
    "དེ་དུས་ཙ་ན་བཙུན་མོ་གཞན་གསུམ་གྱིས་ཀྱང་ལྷ་ཁང་རེ་བཞེངས་པ་སྟེ།",
    "རུ་ཡོང་བཟས་བྲག་ལྷ་ཀླུ་ཕུག་གི་རང་བྱུང་རྣམས་གསལ་བར་བརྐོས་ཏེ་ཚྭ་དང་འབྲུ་རིགས་བརྒྱད་ཅུ་ལྡེའི་དུས་བྲག་ཕྱེ་བྲེ་རེ་ཕེད་པ་ལ་ཚྭ་བྲེ་རེ་བྱིན་ནས་བྲག་ལ་སྐོར་ཁང་བརྐོས།",
    "མོང་བཟའ་ཁྲི་ལྕམ་གྱིས་ཡེར་པའི་གཙུག་ལག་ཁང་བཞེངས།",
    "དེ་ནས་བལ་མོ་བཟས་རྒྱལ་པོ་ར་སར་སྤྱན་དྲངས་ཏེ་ལྷ་ཁང་གི་གཟིགས་འབུལ་ཕུལ་བས།",
    "སྟེང་གི་ལྷ་ཁང་རྣམས་སུ་བྱོན་ཏེ་གཟིགས་ནས་ཁྱེད་ཀྱི་ཤིན་ཏུ་ལེགས་ངའི་འཕྲུལ་གྱི་བཟོ་དང་ཁྱད་པར་མི་སྣང་གསུངས་པས་འཕྲུལ་སྣང་དུ་མཚན་ཐོགས་ཤིང་དང་པོ་ར་ལ་ས་བསྐུལ་བས་ར་ས་འཕྲུལ་སྣང་དང་།",
    "དེ་ནས་ཀོང་ཇོས་ར་མོ་ཆེ་དང་བཙུན་མོ་གཞན་གསུམ་གྱིས་ཀྱང་རང་རང་གི་ཐུགས་དམ་གྱི་རྟེན་ལྷ་ཁང་གཟིགས་སུ་ཕུལ་བས་རབ་ཏུ་དགྱེས་པ་ཐོབ་ཅིང་བསྔགས་བརྗོད་ཀྱི་མེ་ཏོག་འཐོར་རོ།",
    "སྐབས་ཤིག་ཏུ་བློན་པོ་མགར་གྱིས་སྤྱི་འདོམས་མཛད་དེ་ཤར་རྒྱལ་མོ་རོང་གི་ཕྱོགས་སུ་གཡུལ་འགྱེད་པར་ཕེབས་ཁར་རྒྱལ་པོ་རང་ཉིད་ཀྱི་ཕྱག་བཟོ་སྐུ་རྒྱུ་རྡོ་ལས་གྲུབ་པའི་སྤྱན་རས་གཟིགས་ཕྱག་བཞི་པ་མཐོ་གང་བ་ཞིག་བློན་པོ་ལ་ཕྱག་རྟེན་དུ་བསྩལ་བ་དེ།",
    "སྤྱན་རས་གཟིགས་ཕྱག་བཞི་པའི་སྣང་བརྙན་ད་ལྟར་དད་ལྡན་སྐྱེ་བོ་ཀུན་གྱི་སྐྱབས་ཡུལ་དུ་གྱུར་པ་དེ་སོགས་བོད་ཀྱི་བཙན་པོ་འདི་ཉིད་ཀྱིས་ཕྱག་བཟོ་དང་བཀོད་པ་མཛད་པ་ལས་བྱུང་བའི་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་བཟོ་ཁྱད་དང་ལྡན་པའི་བཟོའི་དངོས་པོའང་ཤིན་ཏུ་མང་པོ་ད་ལྟའི་བར་མཇལ་རྒྱུ་ཡོད་དོ།",
    "གཞན་ཡང་བཙན་པོ་འདིའི་རིང་བོད་ཀྱི་ཡུལ་གྲུ་ཆེན་པོར་ས་ཁྱོན་དུ་བསྐྱེད།",
    "སྐབས་དེར་བྲམ་ཟེ་དུང་གི་རྣ་ཆ་ཅན་དང་བི་ཤྭ་ཀརྨ་སརྦ་ཛྷ།",
    "སྐྱུ་ར་ལྷ་ཆེན་སོགས་རང་རང་གི་བཟོ་ཁྱད་ཐོན་པའི་བཟོ་བོ་ཕུལ་བྱུང་ཅན་མང་པོ་བྱོན།",
    "ནང་འཁོར་རྣམས་ཀྱིས་རྒྱ་བལ་བཙུན་མོ་གཉིས་པད་མ་དང་ཨུཏྤལར་གྱུར་ཏེ་རྒྱལ་པོའི་སྐུ་ལ་ཐིམ།",
    "ཡུལ་ལྷ་ལྡན་གྱི་རྒྱ་སྟག་ར་མོ་ཆེའི་གཙུག་ལག་ཁང་ནི་ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་དང་རྒྱ་སྟག་ར་མོ་ཆེའི་གཙུག་ལག་ཁང་ཞེས་གྲགས་པ་བོད་དུ་བཞེངས་པ་ལ་ཆེས་སྔ་ཞིང་གངས་ལྗོངས་གཙུག་ལག་ཡོངས་ཀྱི་རྒྱན་ལྟ་བུ་གཉིས་ཀྱི་ཡ་གྱལ་ཡིན་ཞིང་།",
    "སྤྱི་ལོ་༦༤༡ ལྕགས་གླང་ལོར་རྒྱ་ནག་རྒྱལ་པོའི་སྲས་མོ་འུན་ཤིང་ཀོང་ཇོ་བོད་ཀྱི་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་བཙུན་མོར་ཕེབས་སྐབས་ཡབ་རྒྱལ་པོ་སེང་གེ་བཙན་པོའམ་ཐང་ཐའེ་ཛུང་གིས་མོ་ལ་རྟེན་སྐལ་དུ་བསྩལ་བའི་ཇོ་བོ་ཤཱཀྱ་མུ་ནི་བཞུགས་སུ་གསོལ་བའི་གཙུག་ལག་ཁང་བཞེངས་པ་དེ་ཡིན་ལ།",
    "བདག་གི་མཆོད་གནས་སྟོན་པའི་སྐུ་གཟུགས་འདི།",
    "ང་ཡི་མིག་ལྟར་བུ་མོ་ཁྱོད་ལ་བརྫངས།",
    "མཛེས་པའི་བུ་མོ་ཉི་ཤུ་རྩ་ལྔ་དང་བཅས་རང་རང་གི་རྟ་ལ་ཆིབས།",
    "ལྷ་གཅིག་སྤོར་ཐང་གི་གབ་རྩེ་བཏིང་ནས་བརྩིས་པར།",
    "དེ་ནས་བལ་བཟའ་ཁྲི་བཙུན་གྱིས་བཙན་པོའི་བཀའ་བཞིན་ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་བཞེངས་འགོ་ཚུགས་པའི་རྗེས་སུ།",
    "ཀོང་ཇོས་ཀྱང་རྒྱ་བོད་ཀྱི་བཟོ་བོ་མང་པོ་བོས་ཏེ་སྒོ་རྒྱ་ནག་ཏུ་བསྟན་ཅིང་བཟོ་ཡང་རྒྱ་ནག་གི་ལུགས་སུ་བྱས་པའི་གཙུག་ལག་ཁང་འདི་རྨང་བཏིང་བས་ཟླ་བ་བཅུ་གཉིས་ཀྱི་ནང་ར་ས་འཕྲུལ་སྣང་དང་དུས་མཚུངས་སུ་ལེགས་པར་གྲུབ།",
    "ཐོག་མར་ཇོ་བོའི་ཞལ་ནུབ་ཏུ་གཟིགས་པ་ལ་ཤར་ཏུ་རང་འགྱུར་དུ་བྱུང་།",
    "གཙུག་ལག་ཁང་གི་རྒྱ་ཕིབས་སྟག་ལྟར་བཀྲ་བས་རྒྱ་སྟག་མོ་ཆེའི་ལྷ་ཁང་དུ་གྲགས་སྐད་དོ།",
    "སྐབས་དེར་བོད་རྗེའི་བཙུན་མོ་ལྔ་པོས་རང་རང་གི་རྟེན་སྐལ་གྱི་གཙུག་ལག་ཁང་རེ་བཞེངས་པ་ལས་འདི་ནི་འུན་ཤིང་ཀོང་ཇོའི་རྟེན་སྐལ་གྱི་གཙུག་ལག་ཁང་ཡིན་ནོ།",
    "བོད་རྒྱལ་སྲོང་བཙན་སྒམ་པོ་དང་རྒྱ་ནག་གི་ཐའེ་ཛུང་རྒྱལ་པོ་འདས་འོག་ཏུ།",
    "རྒྱུ་དང་བོད་ཀྱི་རྒྱལ་པོ་གཉིས་རེས་འགའ་མཐུན་ཞིང་།",
    "རེས་འགའ་དམག་དང་ས་ཆའི་རྩོད་པ་རྒྱལ་ཕམ་དུ་མ་བྱས།",
    "རྒྱ་ནག་ཏུ་ཐང་ཐའེ་ཛུང་གི་བུ་དགུ་པ་ཆི་ཀའོ་ཙུང་གིས་སྲིད་འཛིན་པའི་སྐབས་ཤིག་ཏུ།",
    "ཐང་གི་རྒྱལ་ཁམས་ལ་བོད་ཀྱི་དམག་དྲངས་ནས།",
    "ར་ས་འཕྲུལ་སྣང་ནས་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེ་ཤར་བྲག་གདོང་གི་བར་དྲངས་པར།",
    "དེ་ནས་ཇོ་བོའི་སྐུ་གཉིས་བརྗེས་ཏེ་ཇོ་བོ་ཤཱཀྱ་མུ་ནི་ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་དང་མི་བསྐྱོད་རྡོ་རྗེ་ར་མོ་ཆེར་བཞུགས་སུ་གསོལ་ལོ་ཞེས་ཀྱང་སྣང་།",
    "སྲོང་བཙན་དགུང་ལོ་བཅུ་གསུམ་པ་ས་མོ་གླང་གི་ལོར་རྒྱལ་སྲིད་གསེར་གྱི་ཁྲི་ལ་མངའ་གསོལ་བའི་སྙན་པ་ཕྱོགས་མེད་དུ་ཁྱབ་སྟེ།",
    "ས་ཁྱོན་སོགས་གཞན་ལས་མི་དམན་པ་ཞིག་ཡོད་ཀྱང་།",
    "ཅི་ནས་ཀྱང་བོད་འདི་རྨོངས་པའི་མུན་པ་རྩད་ནས་འབྱིན་པའི་གཞི་རྩ་ཡི་གེ་ཞིག་དགོས་པས་ཁྱོད་རྒྱ་གར་དུ་ཡི་གེ་སློབ་འགྲོ་ཐུབ་བམ་མི་ཐུབ་གསུངས་པར།",
    "སློབ་སྦྱོང་གི་དཀའ་བ་དང་ཚད་པ་དང་ས་ཆུ་མི་འཕྲོད་པའི་དཀའ་བ་ལ་སོགས་པར་བཟོད་བསྲན་དང་བརྩོན་འགྲུས་ཆེན་པོ་ལོ་བདུན་དུ་བགྱིས་ཏེ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་རིག་པའི་གནས་མང་པོ་སྦྱངས་ཤིང་།",
    "ནོར་བུ་ཀི་རུ་ཞེས་མཚན་མོར་འོད་གསལ་བ་བཅས་བསྣམས་ནས་རང་ལོ་ཉེར་གསུམ་པར་བོད་དུ་འཁོར།",
    "ཕྱག་སྟོང་སྤྱན་སྟོང་གི་གཟུངས།",
    "བཞི་པར་ཐོན་མི་བགྲང་མོད་ཀྱང་།",
    "ཁོང་གི་སྲས་ཐུ་མ་ཧཱ་སཱསྟ་ཞེས་ལོ་ཙཱ་ལ་མཁས་པར་མཁྱེན་པ་ཞིག་བྱུང་།",
