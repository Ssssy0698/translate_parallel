    "བཙུན་མོ་ཅོག་བཟའ་དཔལ་གྱི་ངང་ཚུལ་སོགས་ཆེ་ཆུང་ལྔ་བཞེས།",
    "སྟེང་ཐོག་གསུམ་ཤིང་གི་འཕྲུལ་གྱིས་བཏེགས་ཏེ་ཐུགས་དམ་གྱི་རྟེན་རྣམས་བཞུགས།",
    "ཐོག་རེ་རེར་མཐིང་གི་བྱ་འདབ་དང་ཕ་གུ་དྲ་ཕྱེད་ཤམ་བུ།",
    "རྩེའི་བྱ་འདབ་ཀྱི་རྩེར་གསེར་གྱི་གཉྫ་ར་རྩེ་མོ་རྒྱབ་རི་མདུན་མའི་རྩེ་དང་མཉམ་པའི་གཡས་གཡོན་དུ་གཡུ་འབྲུག་གིས་སྦས་པ།",
    "གསེར་གྱི་དྲིལ་ཕྲེང་གིས་ཀུན་ཏུ་འཁྲོལ་བ།",
    "བཙུན་མོ་ཅོག་བཟའ་དཔལ་གྱི་ངང་ཚུལ་གྱིས་བཙན་ཐང་གཡུའི་ལྷ་ཁང་དང་།",
    "ཉང་བཀའ་མཆོག་གི་ལྷ་མོ་སྨོན་ཁྲོལ་སྟག་ཚལ་གྱི་ལྷ་ཁང་བཞེངས།",
    "དེའི་བཙུན་མོ་བཙན་མོ་འཕན་གྱིས་ཡར་ལུང་དཔག་བསམ་ལྗོན་ཤིང་དང་ཕུག་པོ་ཆེའི་ལྷ་ཁང་སོགས་བཞེངས།",
    "ཚེ་སྤོང་སྟག་བཟང་གིས་ར་འདོད།",
    "བཙན་པོ་དེ་ཉིད་དགུང་ལོ་སུམ་ཅུ་སོ་དྲུག་པར་ཅོག་རོ་ལེགས་སྒྲ་ལྡོང་བཙན་གྱིས་བཙན་པོ་མལ་གྲོ་ཞམ་པའི་ལྷ་ཁང་གི་རྡོ་སྐས་ལ་བྱོན་པ་ལ་འབྲས་ཆང་གསོལ་ནས་གཟིམས་པའི་དུས་ལྟག་པ་བསྐོར་ནས་བཀྲོངས་པའང་བཤད།",
    "ཁྲི་རལ་པ་ཅན་འཁྲུངས་པ་ལས་ལོ་གསུམ་སྔ་བའི་ཆུ་མོ་ལུག་གི་ལོ་ལ་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་སྲས་གཉིས་པར་འཁྲུངས།",
    "རང་ལོ་སོ་དགུ་པར་གཅུང་ཁྲི་རལ་གྲོངས་ནས་ཁོང་གིས་རྒྱལ་སྲིད་བཟུང་།",
    "བཙུན་མོ་ཆེ་ཆུང་གཉིས་ཁབ་ཏུ་བཞེས།",
    "བྲོས་མ་ཐར་བ་རྣམས་ལས་འགའ་ཞིག་མོན་དུ་བཙོངས།",
    "མ་ཉན་པ་བསད་ཅིང་ལ་ལ་ཁྲིད་ནས་རྒྱལ་བློན་རྣམས་ཀྱི་རྟ་འབབ་འཛེག་གི་ཚེ་སྒུར་དུ་བཅུག་ནས་སྟེགས་བྱས།",
    "ཆག་སྒོ་ཆེ་བའི་ལོ་བཅུའི་སྐབས་ཀྱང་གོང་གི་གནས་ཚུལ་དང་ཕྱོགས་མཚུངས་སུ་གྱུར་པས་རབས་ཆད་གཉིས་པར་འདོད་དོ།",
    "ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་ནི་འབྲོམ་སྟོད་གུང་མོ་ཆེར་སྐུ་འཁྲུངས།",
    "རྒྱ་བོད་ཀྱི་མཚམས་བསྲུངས་ཏེ་ཕ་རོལ་གྱི་རྒོལ་བ་ཅན་རྣམས་བཏུལ་བར་ལན་གཅིག་གོ་ཆ་ཕུད་པའི་རྨོག་གི་ནང་དུ་ཏོག་གི་གཟུངས་བཞུགས་པ་བཀླགས་པས།",
    "ཞེས་བྲིས་པ་མཐོང་ནས་རང་གི་རྐང་མཐིལ་ལ་བལྟས་པས་རྨེ་བ་དམར་པོ་ཅིག་འདུག་གཞན་ལ་བཀླག་ཏུ་བཅུག་པས་ཀྱང་དེ་བཞིན་དུ་སྣང་ཟེར་བས།",
    "ཁོང་གི་ཡབ་མཆེད་གཉིས་དང་།",
    "བཙུན་པ་དཔལ་གྱི་དབྱངས་ཏེ་མཆེད་གསུམ་པོ་གྲིབ་ཀྱི་དཀར་མོ་རོང་ཏུ་བསྒོམས་པའི་སྐབས་ཤིག་ཏུ།",
    "བྲག་ལྷ་བྲག་ཕུག་བྲུས་པས་བྲག་སྲིན་མོ་ལངས་པ་དང་རྣལ་འབྱོར་ཕུག་གི་མཆོད་རྟེན་བཞེངས།",
    "སེང་གེ་སྒང་དུ་མཆོད་རྟེན་བཞེངས་ཏེ་དབྱར་ཟླ་འབྲིང་པོ་ཉའི་ཉི་ཤར་ལ་ཏོག་གི་གྲིབ་སོ་ཕོག་སར་ཡབ་ཀྱི་སྤུར་བཞུགས།",
    "གཅེན་པོ་ལྷ་ལུང་རབ་འབྱོར་དབྱངས་ཀྱིས་བང་གི་ས་ཕུག་ནས་དཔལ་གྱི་རྡོ་རྗེ་དང་གཡོག་པོ་གཉིས་ལ་ཁམ་ས་ཐུམ་གསུམ་ཡེར་པར་བསྐུར་བ་གཅིག་གསེར་དུ་གྱུར་པ་དེ་ལས་གཡོག་པོས་མཆོད་རྟེན་གོང་ན་མེད་པ་བཞེངས་ཏེ་རིང་བསྲེལ་ལྷུང་བཟེད་གང་བཞུགས།",
    "ཆུ་བོ་རིའི་གྲུབ་ཐོབ་རྣམས་ཀྱིས་ལྷ་ལ་རབ་གནས་ལན་ཉི་ཤུ་རྩ་གཅིག་བསམ་གྲུབ་དང་དཔལ་གྱི་ལྷ་མོར་ལན་གསུམ་གསུམ།",
    "བྲག་ལྷར་ལན་ཉི་ཤུ་རྩ་ལྔ་རེ་མཛད་དེ་སྤྲུལ་བའི་སྐུ་དངོས་དང་ཁྱད་པར་མེད་པར་གསུངས་ནས་འབྲུ་དཀྱིལ་འཁོར་ལ་བཏབ།",
    "བློན་དང་སྐུ་སྲུང་པ་མང་པོས་རྗེས་བསྙེགས་པས་ཕྱོགས་བཞི་ལ་འདེད་རྒྱུ་རེ་བྱུང་སྟེ།",
    "ཤར་ཕྱོགས་པ་རྣམས་ཀྱིས་ཟིན་ལ་ཁད་ལ་དགའ་མོ་གདོང་ནས་ས་སྲོས་ནས་མ་མཐོང་བས་ཤོར་ཟེར།",
    "བྱང་པ་རྣམས་མོང་མཁར་གདོང་ནས་ས་སྲོས་ཏེ་ཤོར་ཟེར་བས་ཁ་མ་འཆམས།",
    "ངེས་པ་ཅན་དུ་གྲིབ་ཀྱི་མདར་གདོང་གི་ཆུ་ལ་ལྟོ་ཉལ་བྱས་པས།",
    "རྟ་ལ་སོལ་བ་བྱུག་པ་དག་སྟེ་དཀར་པོར་སོང་།",
    "གདོང་གི་སྣུམ་བཀྲུས་ནས་ང་ནི་ལྷ་གནམ་ཐེལ་དཀར་པོ་ཡིན་ཟེར་ནས་བྲོས་པས་མི་མ་ཡིན་པར་དོགས་ནས་འདེད་མི་རྣམས་ཀྱང་ཚོམ།",
    "རྒན་མོ་ན་རེ།",
    "ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེའི་ཞལ་ནས་བདག་གིས་རྒྱལ་པོ་སྡིག་ཅན་བསད་པས་སྡོམ་པ་མེད།",
    "༡༧ཡུམ་བརྟན་དང་འོད་སྲུང་གི་གདུང་རབས་ཀྱི་བཟོ་དངོས་ཤུལ་བཞག་གླང་དར་བཀྲོངས་པའི་ཕྱི་ལོར།",
    "བཙུན་མོ་ཆུང་བ་ཚེ་སྤོང་བཟའ་བཙན་མོ་འཕན་ལ་ལྟོ་བོར་སྲས་གཅིག་བྱུང་བ་ཆེན་མས་བསད་དམ་ཕྲོགས་ཀྱིས་དོགས་ནས་འོད་དང་མ་བྲལ་བར་བསྲུངས་པས་གནམ་ལྡེ་འོད་སྲུང་དུ་ཐོགས།",
    "དེའི་ཚེ་ཆེན་མ་སྣ་ནམ་བཟས་ཀྱང་བུ་ཆུང་སོ་སྐྱེས་པ་ཞིག་ང་ལ་མདང་སྐྱེས་སོ་ཞེས་བསྟན་པས་བློན་པོ་ན་རེ།",
    "དེ་ནས་ཡུམ་བརྟན་དང་འོད་སྲུང་གཉིས་ནར་སོན་པ་དང་བཙུན་མོ་གཉིས་སོ་སོའི་ཕྱོགས་བློན་འབངས་ཐ་དད་དུ་བཟུང་སྟེ།",
    "ཡུམ་བརྟན་གྱིས་དབུ་རུ་དང་འོད་སྲུང་གིས་གཡོ་རུ་བཟུང་ཞིང་ཡུན་རིང་མ་སོང་བར་དབུ་གཡོར་གཉིས་འཁྲུགས།",
    "དེའི་བག་ཤན་བོད་ཡུལ་ཕལ་ཆེར་ཁྱབ་སྟེ་ཡུལ་གྲུ་རེ་རེ་ལའང་ཆེ་སྲིད་དང་ཆུང་སྲིད།",
    "བཙུན་མོ་ཁབ་ཏུ་བཞེས་པ་ལས་སྲས་གཉིས་བྱུང་།",
    "ཁོང་གིས་ཡབ་མེས་ཀྱི་ཡིག་ཚང་ལ་གཟིགས་པས་ངེས་འབྱུང་སྐྱེས་ཏེ་སྲས་དང་བཅས་པ་རབ་ཏུ་བྱུང་།",
    "ལྷ་སར་ཟངས་ཁལ་བཅོ་བརྒྱད་ལ་དོས་རེར་བྱས་པའི་ཟངས་དོས་བརྒྱ་དང་བཞི།",
