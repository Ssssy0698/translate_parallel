    "རྣམ་པར་ཤེས་པར་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འབད་པ་འདི་ལ་ཞེས་བྱ་བ་ནི་དམིགས་པ་མེད་པར་བསྒྲུབ་པའི་མཚན་ཉིད་ལས་སོ།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ནི་དམིགས་པ་དང་བཅས་པར་རོ།",
    "རིག་བྱེད་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་དུ་བསྒྲུབ་པའི་འཐད་པའི་ལམ་འབྲས་བུ་ཅི་ཡོད་དེ་ཅི་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྐྱེས་བུས་མ་བྱས་པ་མ་ཡིན་ན།",
    "དེའི་ཚེ་མཆོད་སྦྱིན་ལ་སོགས་པའི་ཐ་སྙད་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་སྐྱེས་བུས་བྱས་པ་མེད་ནའོ། ། དེ་ཉིད་ཅེས་བྱ་བ་ནི་མཆོད་སྦྱིན་ལ་སོགས་པ་ལའོ་། རྣམ་པར་དཔྱད་པ་ཞེས་བྱ་བ་ནི།",
    "སྐྱེས་བུས་མ་བྱས་པ་ཉིད་དུ་ངེས་པས་སོ།",
    "དེ་ཉིད་བརྗོད་པ་ནི་སྐྱེས་བུས་མ་བྱས་པ་ཞེས་བྱ་བའོ།",
    "དེ་ངེས་པར་རྟོག་པའི་རྣམ་པ་ཞེས་བྱ་བ་འདི་ཉིད་ཀྱི་དོན་ནི་མཐོང་བའི་རྣམ་པ་ཞེས་བྱ་བའོ་།",
