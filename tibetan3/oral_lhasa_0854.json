    "སྔར་རྟོགས་པ་ལས་ལྷག་པར་རྟོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ལྷག་པར་མ་བརྟགས་པ་ནི།",
    "འཆད་པར་འགྱུར་བའི་ཚུལ་དུའོ།",
    "ལྷག་པར་བརྟགས་པ་ནི་དུ་བ་འདི་ནི་ཐམས་ཅད་དུ་མེ་མེད་པར་མི་འབྱུང་ངོ་ཞེས་བྱ་བའི་རྣམ་པ་ཅན་ནོ།",
    "མཐོང་བ་དོན་དུ་གཉེར་བའི་སྐྱེས་བུ་ལ་འདི་ནི་མེ་ཡོད་དོ་ཞེས་སྟོན་པར་མི་འགྱུར་རོ།",
    "གཞན་དུ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྣང་བ་ཉིད་དུ་མ་རྟོགས་པར་ནི་དོན་གཉེར་བ་མ་ཡིན་ནོ།",
    "གང་ལ་སྔར་གྱི་མེ་སྒྲོ་འདོགས་པར་བྱ་བ་ལ་གནས་པའི་མེ་དེ་ནི་ལྐོག་ཏུ་གྱུར་པ་ཡིན་ནོ་ཞེས་འདི་འགོག་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ།",
    "རི་ལ་ཡོད་པའི་མེ་དེ་མ་རྟོགས་པའི་ཕྱིར་དེ་ཡོད་ཅེས་ཅི་ལྟར་རྟོགས་དེ་ཉིད་ཅེས་བྱ་བ་ནི་སྒྲོ་བཏགས་པར་བྱ་བའི་མེ་རང་བཞིན་ཉིད་དོ།",
    "ཇི་ལྟར་འགྱུར་ཞེས་བྱ་བ་ནི་ཤེས་པ་ལས་ཐ་དད་པའི་དོན་གཞན་ཡོད་པར་རྟོགས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྐྲ་ལ་སོགས་པར་སྣང་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་དོན་མེད་ཀྱང་མིག་ཙམ་ལས་འཁྲུལ་པར་འདོད་པའི་ཤེས་པ་རྣམས་ལ་སྐྲ་ལ་སོགས་པར་སྣང་བ་དེ་བཞིན་དུ་ཀ་བ་ལ་སོགས་པ་ཡང་ཡིན་ནོ།",
    "འདི་ལ་ལན་དུ་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ལས་མ་འཁྲུལ་བར་འདོད་པའི་ཤེས་པ་རྣམས་ཡང་མིག་ལ་སོགས་པ་ཉམས་པ་བརྟག་པར་བྱའོ་ཞེས་བྱ་བའོ།",
    "འབྲས་བུ་ལྡོག་པ་དེའི་ཚེ་གྲུབ་པའི་དོན་དུ་མིག་ཉིད་བརྟག་པ་བླའོ་། གལ་ཏེ་མིག་ལ་སོགས་པ་ཡང་རྣམ་པར་ཤེས་པར་སྨྲ་བ་རྣམས་ཀྱི་འདོད་པ་མ་ཡིན་ནམ།་",
    "དེ་ཡང་ཞེས་གསུངས་སོ།",
    "འོ་ན་རྣམ་པར་ཤེས་པར་སྨྲ་བ་རྣམས་ཅི་ཞིག་འདོད་སྙམ་ན།",
    "དེ་མ་ཐག་པའི་ཞེས་གསུངས་སོ།",
    "དེར་ཞེས་བྱ་བ་ལུས་སུ་སྣང་བ་ཡོད་ན་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་ཕྱིའི་དོན་མེད་ན་དེ་མ་ཐག་པའི་རྐྱེན་གྱི་ཁྱད་པར་ཙམ་ལས་ཇི་ལྟར་ཡུལ་ལ་སོགས་པ་ངེས་པར་འགྱུར་སྙམ་ན།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "ཡང་སད་པར་བྱེད་པ་དེ་ཡོད་པ་མ་ཡིན་ཡང་རྣམ་པར་རྟོག་པ་རྣམས་ངེས་པར་མཐོང་བ་དེ་བཞིན་དུ་དམིགས་པའམ་སད་པར་བྱེད་པ་མེད་པ་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ངེས་པ་དང་འབྲེལ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་ཡང་ཕྱི་རོལ་ཉིད་ཡིན་པའི་ཕྱིར་ཕྱི་རོལ་ན་ངེས་པར་སྣང་བ་སྐྱེ་བར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ཕྱི་རོལ་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "སྔོན་གྱི་དོན་ཉིད་ལས་ངེས་པ་ཡིན་པར་རྟོག་ན།",
    "མི་སླུ་བ་ཡང་ཞེས་བྱ་བ་ནི་ལན་ནི་མི་སླུ་བའི་མཚན་ཉིད་ཀྱི་སྣང་བ་གང་ཡིན་པ་དེ་ཉིད་བརྒྱུད་པར་རིགས་ཀྱི་དོན་ནི་མི་འགྲུབ་བོ།",
    "དོན་བྱེད་པ་ལ་ཞེས་གསུངས་སོ།",
    "རྣམ་པ་གཉིས་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་རིག་པ་དེ་ནི་འདོད་པ་དང་མི་འདོད་པ་དེ་ལྟར་མྱོང་བ་ཡིན་ནོ།",
    "འོ་ན་རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་ཡང་དོན་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་གྱི།",
    "དེའི་ཚེ་དངོས་ཀྱི་འཇུག་པས་དོན་རིག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ཕྱིའི་དོན་ཉིད་རྟེན་མེད་པར་ཅི་སྟེ་ཁས་མི་ལེན་གལ་ཏེ་ཕྱི་རོལ་མེད་ན་གང་ཞིག་རིག་ཅེས་དྲིས་པ་ན།",
    "རྟོགས་པར་བྱེད་པས་གསུངས་སོ།",
    "རང་བཞིན་དུ་མ་ཞེས་བྱ་བ་ནི་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པར་མེད་པའོ།",
    "དོན་ཐ་དད་པར་ཁས་བླངས་ཀྱང་གཅིག་ལ་གཉིས་ཀྱིས་ཉམས་སུ་མྱོང་བར་མི་འགྱུར་རོ། ། འོ་ན་ཇི་ལྟར་སྐྱེས་བུ་གཉིསཀྱིས་དོན་གཅིག་ལ་མྱོང་བར་འགྱུར་སྙམ་ན།",
    "སྐྱེས་བུ་གཅིག་ལ་སྣང་བའི་བདེ་བའི་རྣམ་པར་སྡུག་བསྔལ་ལ་སོགས་པའི་རྣམ་པ་ཡང་ཞུགས་པར་སྣང་བ་ཡིན་ན་ནི།",
    "ཐམས་ཅད་ཅེས་གསུངས་སོ།",
    "བཏུདད་ེཔའི་ཡུལ་ན་གནས་པའི་དོན་རྣམ་པ་དུ་མར་འགྱུར་བ་རྟོགས་པས་སྒྲིབ་པར་ཇི་ལྟར་ནུས་པར་བརྗོད་དགོས་སོ།",
    "སྡུ་གུ་ལ་སོགས་པ་ཞེས་བྱ་བ་ནི་བདེ་བ་ལ་སོགས་པར་རོ་ཞེས་བྱ་བའི་བར་དུ་ཞེས་བྱ་བ་འདིས་ནི་འདིའི་མཐའ་ཐུག་པ་ནི་སློབ་དཔོན་གྱིས་གཞུང་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "༧༤༨པར་ཞེས་བྱ་བ་ནི་འཛིན་པའི་རྣམ་པ་དང་རྗེས་སུ་མཐུན་པའོ།",
    "མངོན་སུམ་གྱི་འབྲས་བུ་ཞེས་གསུངས་སོ།",
    "དོན་རིག་པས་བག་ཆགས་ཁྱད་པར་ཅན་སྟོན་པ་ནི་བག་ཆགས་ནི་ཞེས་བྱ་བའོ།",
    "དོན་དམ་པར་མཐོང་བ་ནི་སྣང་བ་མེད་དོ་ཞེས་བྱ་བ་འདི་ནི་སྨིག་རྒྱུ་ལ་ཆུར་ཤེས་པ་ཉིད་ཀྱིས་འཁྲུལ་ཏེ།",
    "འོན་ཏེ་ཀ་བ་ལ་སོགས་པ་ལ་ནི་དོན་བྱ་བ་ཐོབ་ཀྱི་སྨིག་རྒྱུ་ལ་ཆུར་ཤེས་པ་ལ་སོགས་པར་ནི་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་འཇིག་རྟེན་པ་མ་ཡིན་པར་ཇི་ལྟར་འགྱུར་སྙམ་ན།",
    "ཀ་བ་ལ་སོགས་པ་ལ་ཐོབ་པའི་ཁྱད་པར་ཡོད་དོ་ཞེ་ན།",
    "འོན་ཏེ་ཀ་བ་ལ་སོགས་པ་ནི་གཞན་གྱིས་མཐོང་བ་ཟླ་བ་གཉིས་ལ་སོགས་པ་ནི་ོམ་ཡིན་པ་དེས་ན་ཁྱད་པར་ཡོད་པ་ཁོ་ནའོ་སྙམ་ན།",
    "ཾཇི་ལྟར་ཀ་བ་ལ་སོགས་པའི་ཤེས་པ་རང་ཉིད་ཁོ་ན་ཐོབ་པའི་རང་བཞིན་ཡིན་པ་དེ་བཞིན་དུ་ཀ་བ་ལ་སོགས་པ་དང་ཟླ་བ་གཉིས་ཀ་ཡང་མི་བདེན་པར་འགྱུར་རོ།",
    "དེའི་ཤེས་པ་ཡང་ཞེས་བྱ་བ་ནི་རྒྱུ་དག་པར་འཛིན་པའི་ཤེས་པ་ཡང་ངོ།",
    "རྒྱུ་དེས་ན་ཀ་བ་ལ་སོགས་པའི་ཤེས་པ་དེ་དག་ཀྱང་དེ་ལྟར་ཞེས་བྱ་བ་བག་ཆགས་ལས་བྱུང་བ་ཞེས་བྱ་བར་བརྟག་པར་བྱའོ།",
    "ཐོག་མ་མེད་པའི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་རྣམ་པར་ཤེས་པར་སྨྲ་བ་རྣམ་པར་གནས་པ་ན།",
    "ཐ་སྙད་དུ་ནི་སྔོན་ཉམས་སུ་མྱོང་བ་ཡང་དྲན་པ་འདི་སྐྱེས་སོ་ཞེས་ལྷག་པར་ཞེན་པ་ལས་རྒྱུ་དང་འབྲས་བུ་རྣམ་པར་གནས་པ་ཡིན་ན་ིཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ཉིད་ནི་དྲན་ནོ་ཞེས་བྱ་བའི་དོན་རྟོགས་པར་ཡོད་པ་ཡིན་ལ།",
    "དེ་ལ་གནོད་པར་བྱེད་པ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཕྱི་རོལ་གང་ལ་རྣམ་པར་ཤེས་པའི་འབྲས་བུ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་བའོ།",
    "༧༥ ༡དུ་ཞེས་བྱ་བ་ཕྱི་རོལ་མེད་པར་སྐྱེ་བའི་ཕྱིར་རོ།",
    "ཕྱི་རོལ་གྱི་འབྲས་བུའི་ཕྱོགས་ལ་ནི་དུ་བ་དང་ཆུ་མེད་པར་ཡང་དུ་བ་དང་ཆུའི་བློར་འགྱུར་བའི་ཕྱིར་འཁྲུལ་པར་འགྱུར་རོ་། ཕྱི་རོལ་ཞེས་མིང་ཙམ་བྱས་པར་འགྱུར་ཏེ།",
    "མིང་ཙམ་དེ་ཡང་འཇིག་རྟེན་པ་ཉིད་ཀྱིས་བྱས་པ་ཡིན་པས་སོ།",
    "ཇི་ལྟར་རྨི་ལམ་མཐོང་བ་རྣམས་ཡུལ་ཕྱོགས་གཅིག་ཉིད་ལ་སྣང་བ་སྣ་ཚོགས་པར་འགྱུར་ཏེ།",
    "གཅིག་ཏུ་ལྷག་པར་ཞེན་པ་ཡང་ཡོད་པ་ཡིན་ནོ།",
    "རྣམ་པར་གྱུར་པ་ཡིན་གྱི་གཙོ་བོ་ལ་སོགས་པ་འབའ་ཞིག་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "གང་ལ་སོག་སོགས་པའི་དོན་སྐྱེ་བ་དེ་ལ་ཉེ་བར་བསྟན་པར་བྱེད་པའོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་ཇི་སྲིད་ཅིག་རུང་རུང་མ་བྱས་པ་དེ་སྲིད་དུ་ལོགས་པར་བྱ་བ་མི་ནུས་སོ།",
    "ཕྱིའི་དོན་དུ་སྨྲ་བ་དེའི་བསམ་པ་མཐར་ཐུག་པར་བསྐྱལ་ཏྲ།",
    "ཡང་ཅིའི་ཕྱིར་འདི་བསྒྲུབ་པར་མི་ནུས་སྙམ་ན་ཤིན་ཏུ་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་དབྱེར་མེད་ཀྱང་ཞེས་བྱ་བ་ནི་གཟུང་བ་དང་འཛིན་པའི་རང་བཞིན་དང་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་རྣམ་པར་རོ།",
    "འོན་ཀྱང་རྟོགས་པ་ཉིད་དོ་ཞེས་བྱ་བ་ལྷག་པར་ཞེན་པ་ཉིད་དོ།",
    "གཟུང་བ་ལ་སོགས་པ་བསལ་བ་ནི་མ་ཡིན་གྱི་འོན་ཀྱང་དེ་ནི་ལྷག་པར་ཞེན་པ་ཙམ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ད་མེད་ཀྱང་ཞེས་གསུངས་སོ།",
    "དུ་བ་ལ་སོགས་པ་ཞེས་གསུངས་སོ།",
    "ཁྱད་པར་ཅན་སྔོན་པོའི་རང་བཞིན་དུ་མཐོང་བ་ལ་སེར་པོའི་རང་བཞིན་དུ་ཡང་ཐེ་ཚོམ་ཟ་བར་འགྱུར་ན།",
    "རྣམ་པར་ཤེས་པ་ལྐོག་ཏུ་གྱུར་པའི་ཡུལ་ཅན་ནི་རྣམ་པ་ཐམས་ཅད་དུ་སྲིད་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ་། མི་རིགས་པ་ཉིད་སྟོན་པ་ནི་གལ་ཏེ་ཤེས་པ་དེར་ལྐོག་ཏུ་གྱུར་པར་འདོད་པའི་དམ་པའི་དོན་སྣང་ན།",
    "འོན་ཏེ་ཉེས་པ་འདི་རྣམ་པར་ཤེས་པར་སྨྲ་བ་ལ་ཡོད་པ་ཉིད་དོ་སྙམ་ན།",
    "དེ་ཁོ་ན་བཞིན་ཞེས་བྱ་བ་ནི་གཞན་གྱིས་རིག་པར་བྱེད་པ་ཉིད་དུའོ།",
    "བཟློག་པ་ལ་ཡང་ཞེས་བྱ་བ་ནི་གཞན་གྱིས་རིག་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ལ་ཡང་ངོ།",
    "བྱ་བ་མ་ཡིན་པར་རོ།",
    "ཡང་ན་ཞེས་བྱ་བ་ནི་རྣམ་པ་གཞན་གྱིས་རིག་པར་བྱ་བ་ཉིད་འགོག་པའོ། ། ཇི་ལྟར་རྗེས་སུ་སྣང་བཞིན་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་ལྷག་པར་ཞེན་པ་བཞིན་ནོ།"
  ]
}