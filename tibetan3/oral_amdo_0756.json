    "དེས་ན་ང་ཚོས་སྔར་ལས་ལྷག་པའི་སྒོ་ནས་བོད་ཀྱི་དམངས་ཁྲོད་གཏམ་དཔེར་ཞིབ་འཇུག་དང་།",
    "ཨིབ་སེན་དང་ཁོང་གི་ཟློས་གར།",
    "དཔའ་མཛངས་ལྡན་པའི་མི་རིགས་ཀྱི་དཔའ་བོ་ཞིག་ཀྱང་རེད།",
    "ཧེང་རུའེ་ཨིབ་སེན་གྱི་སྐུ་ཚེ་ཧྲིལ་པོའི་གསར་རྩོམ་གྱི་ལོ་ཚིགས་རེའུ་མིག་ཟུར་བཀོད་གཉིས་པ།",
    "ཨིབ་སེན་དང་ཁོང་གི་ཟློས་གར་ཞེས་པའི་དཔྱད་གཞིའི་དཔེ་དེབ་ཀྱི་དཀར་ཆག་ནོར་ཝེ་དང་དེང་རབས་ཟློས་གར་གྱི་ཕ་མེས།",
    "ཧེང་རུའེ་ཨིབ་སེན་ནི་དུས་རབས་བཅུ་དགུ་པའི་སྐབས་ཀྱི་ནོར་ཝེའི་མཆོག་ཏུ་གྱུར་བའི་ཟློས་གར་མཁས་ཅན་ཞིག་རེད།",
    "ཁོང་གི་སྐུ་ཚེ་ཧྲིལ་པོའི་རིང་ཟློས་གར་གྱི་འཁྲབ་གཞུང་ཉི་ཤུ་རྩ་དྲུག་དང་སྙན་ཚིག་མི་ཉུང་བ་ཞིག་བརྩམས་གནང་བ་དེ་རྣམས་རྒྱལ་ཁབ་མང་པོའི་ཡི་གེར་བསྒྱུར་པ་དང་།",
    "འཛམ་གླིང་གི་རྩོམ་རིག་ནོར་བུའི་བང་མཛོད་ནང་གི་རྩ་ཆེའི་དངོས་པོ་ཞིག་ཏུ་གྱུར།",
    "མི་སེར་རྒྱལ་ཁབ་ཀྱི་ཐོག་མའི་སྐབས་སུ་ཁོང་གི་ཟློས་གར་འཁྲབ་གཞུང་འགའ་ཞིག་ཀྲུང་གོར་མཚམས་སྦྱོར་བྱས་པ་མ་ཟད།",
    "ཁོང་ནི་རང་རྒྱལ་གྱི་ཀློག་པ་པོས་དགའ་ཞེན་བྱེད་ཅིང་ཆ་རྒྱུས་ཡོད་པའི་ཕྱི་རྒྱལ་གྱི་རྩོམ་རིག་མཁས་ཅན་གྱི་གྲས་ཤིག་རེད།",
    "དེ་སྔ་ཨིབ་སེན་གྱིས་ཁོང་གི་ལུའོ་སི་མོ་ཀློང་ཞེས་པའི་རྩོམ་རིག་དེར་གོ་བ་ལེན་མི་ཐུབ་པའི་འཇར་མན་གྱི་མི་ཞིག་ལ་སྨྲས་པར་ཁྱེད་ཀྱིས་ང་གསལ་པོར་རྟོགས་འདོད་ན།",
    "ཐ་ན་འཚོ་བ་སྐྱེལ་སྟངས་ཐད་ལའང་ཏེན་མག་སྐབས་འགར་འཇར་མན་གི་ཤུགས་རྐྱེན་མངོན་གསལ་དོད་པོ་ཐེབས་ཡོད།",
    "དུས་རབས་བཅུ་དགུ་པའི་དུས་འགོར་ནོར་ཝེའི་ཡར་ཐོན་རྩོམ་པ་པོ་རྣམས་ལ་ཡོ་རོབ་མི་རིགས་བཅིངས་འགྲོལ་ལས་འགུལ་གྱི་ཤུགས་རྐྱེན་ཐེབས་ཏེ་ནོར་ཝེའི་མི་རིགས་རྩོམ་རིག་ལས་འགུལ་བླངས་པ་རེད།",
    "སྐབས་དེར་གལ་ཆེའི་སྔོན་བསྐྱོད་པའི་གྲས་སུ་ཧེང་ལེ་ཝེ་ཀོ་ལན་ཏེ་དང་ཁོང་གི་གཅུང་མོ་ཁོ་ལའི་ཏེ་དང་ཡུའོ་ཀེན་མའོ།",
    "ཁོང་ཚོའི་གཟིགས་ཚུལ་དུ་རྩོམ་རིག་དེ་རིགས་ནི་ཁམས་ཤུགས་དང་ལྡན་ལ་དྭངས་སང་།",
    "ལུང་ཙམ་འཛིན་པའི་ཀུན་སྤྱོད་ཀྱི་འཆིང་རྒྱ་ལས་གྲོལ་བ་ཞིག་རེད།",
    "རྩོམ་པ་པོ་འགའ་ཞིག་གིས་སྣེ་འཁྲིད་གྲོས་འགོ་བཏོན་པར་བརྟེན་མི་རིགས་ཀྱི་སྤོབས་ཉམས་གོང་དུ་ཤུགས་ཆེན་འཕེལ་བ་རེད།",
    "འཇར་མན་གྱི་མཉམ་འབྲེལ་རྒྱལ་ཕྲན་ཁག་གི་བཟོ་པས་ལས་མཚམས་བཞག་པ་དང་།",
    "ཨིབ་སེན་གྱིས་མ་འོངས་པའི་གཞོན་ནུའི་མི་རབས་ལ་རེ་བ་ཆེན་པོ་གནང་བ་མ་ཟད།",
    "རྟག་ཏུ་རང་གིས་རང་ལ་དུས་རབས་ཀྱི་གོམ་སྟབས་རྗེས་ཟིན་དགོས་པའི་སྐུལ་མ་ཡང་ཡང་གནང་གི་ཡོད་ཅིང་།",
    "ཁོང་གིས་གསུང་དོན་གཞོན་ནུ་ཚོའི་རྒྱབ་སྐྱོར་དེ་ང་ལ་ཆ་མཚོན་ན་དགའ་སྤྲོ་དཔག་མེད་སྐྱེས་འོས་པ་ཞིག་རེད།",
    "ས་ཆེན་བྱུང་བ་རེད།",
    "རང་ཉིད་ཀྱིས་མིག་དཔེ་གཞན་སྟོན་གནང་གི་ཡོད།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཁོང་ལ་དབྱིན་ཇིའི་གྲོགས་པོ་ལེ་ལེན་ཨ་ཆིན་ཟེར་བ་ཞིག་ཡོད་པ་དེས་ཁོང་གི་འཁྲབ་གཞུང་ལ་ཞིབ་འཇུག་གཏིང་ཟབ་གནང་བ་མ་ཟད།",
    "དཀལ་ངལ་ལ་མ་འཛེམས་པར་ཁོང་གི་རྩོམ་རིག་མང་ཆེ་བ་དབྱིན་ཇིའི་ཡི་གེར་བསྒྱུར་གནང་བ་རེད།",
    "དེར་བརྟེན་ཝེ་ལེན་ཨ་ཆིར་གྱིས་ང་ཚོས་ཨིབ་སེན་ཆ་རྒྱུས་ཡོང་བར་ཆུ་ཐོག་ཟམ་པ་ལྟ་བུའི་ནུས་པ་ཐོན་ཡོད།",
    "ལེ་ལེན་ཨ་ཆིར་གྱིས་བསྒྱུར་པའི་ཨིབ་སེན་གྱི་གཅེས་བསྡུས་ཀྱི་གླེང་གཞིའི་ནང་ཁོང་གིས་དཀལ་ངལ་ཆེ་ལ་སྣ་མང་འབོར་ཆེན་གྱི་ཡིག་བསྒྱུར་ལས་ཀ་དེའི་སྐོར་གླེང་སྐབས་གསུངས་དོན་ཨིབ་སེན་ནི་ཕུགས་བསམ་ཡོད་པ་དང་།",
    "དུས་ཆེན་ཆེ་མོ་ཁག་ལ་རྒན་སྐྱོར་ཆུང་འཁྲིད་དང་།",
    "གནའ་བོའི་ཉམས་འགྱུར་ལྡན་པའི་རིག་རྩལ་བྱེད་སྒོ་དེ་རིགས་ནི་མཛའ་བརྩེ་རོ་བཅུད་ལྡན་པ་ཞིག་ཡིན་སྟབས་ས་གནས་དེ་གའི་མང་ཚོགས་ཀྱིས་ཧ་ཅང་དགའ་པོ་བྱེད་ཀྱི་ཡོད།",
    "ཨིབ་སེན་ནི་ཤིང་ཚོང་བ་འབྱོར་པ་ཅན་ཞིག་གི་ཁྱིམ་དུ་སྐྱེས།",
    "ཁོང་གི་མེས་པོ་མང་ཆེ་བ་གྲུ་བདག་གམ་ཡང་ན་ཚོང་པ་རེད།",
    "བུ་ཕྲུག་མང་པོ་གསོ་ཡས་ནི་དར་ཁྱབ་ཆེ་བས་ཨིབ་སེན་གྱི་ཕ་མའང་དེ་ལྟར་རེད།",
    "ཁོང་ཚོའི་ཁྱིམ་དུ་གཅེན་གཅུང་དྲུག་དང་གཅུང་མོ་ཞིག་ཡོད།",
    "ལས་ཀ་ཚང་མ་ཁོང་གི་བློ་དང་བསྟུན་པས་ཆུང་དུས་ནས་སྤོབས་སེམས་ཆེ་ལ་རང་ཤེད་སླ་ཡོད་ཚ་བ།",
    "ཁོང་གིས་རྟག་ཏུ་འགོ་གཙོ་ཡིན་སྙམ་ནས་རང་གི་གཅུང་པོ་དང་གཅུང་མོར་བཀོད་འདོམ་གཏོང་བ་མ་ཟད།",
    "ཁོང་རི་མོ་འབྲི་ཡས་ལ་ཧ་ཅང་དགའ་པོ་ཡོད།",
    "འདི་ནི་རི་མོ་འབྲི་ཡས་ལ་དགའ་བའི་ཁོང་གི་ཡུམ་དང་རི་མོ་མཁས་ཅན་སྲུ་མོ་གཉིས་ཀྱིས་མཛུབ་འཁྲིད་གནང་བའི་འབྲས་བུ་ཞིག་ཡིན་པ་གསལ་པོར་རྟོགས་ཐུབ།",
    "ཁོང་གིས་སྨྱུག་གུ་འཁྱེར་ནས་རས་ཀྱི་ཕྲུ་གུ་ཆུང་ཆུང་གི་མགོ་སྟེང་དུ་གདོང་རིས་འདྲ་མིན་བྲིས་པ་དང་།",
    "སྐབས་འགར་དགོད་བྲོ་བའི་གདོང་རིས་འགའ་ཞིག་འབྲི་སྐབས་ཚང་མ་དགད་མོ་ཤོར་གྱི་ཡོད།",
    "སྐབས་འགར་སྤང་ལེབ་རྙིང་པ་ཁ་ཤས་འཁྱེར་ནས་གཅུང་པོ་དང་གཅུང་མོ་ཚོ་མཉམ་དུ་ཟློས་གར་གྱི་གར་སྟེགས་བཟོས།",
    "དེའི་དབུས་སུ་ཤིང་ཟོམ་ཆེན་པོ་ཞིག་བཞག་ཁོང་རང་ཤིང་ཟོམ་ཆེན་པོ་དེའི་ཐོག་བསྡད་ནས་ཁོག་སྐད་ཟློས་གར་ཟེར་བ་དེ་ལྟད་མོ་བའི་བསམ་པར་སྐད་སྒྲ་ནི་སྐད་ཆ་ཤོད་མཁན་གྱི་ཁ་ནས་མ་ཐོན་པར་ཐོག་ཀའི་སྟེང་ངམ་ཡང་ན་གྱོན་པ་བླུགས་སའི་སྒམ་ནས་ཐོན་པའི་སྣང་བ་འཆར་གྱི་ཡོད།",
    "ཁོང་ཚོའི་འཁྲབ་སྟོན་དངོས་འབྲེལ་ཡིན་པ་ལྟ་བུ་ལས་མི་སུས་ཀྱང་སྐྱོན་མཐོང་མི་ཐུབ།",
    "ཁོང་གིས་ཟློས་གར་སྣ་ཚོགས་འཁྲབ་ཏེ་ལྟད་མོ་བ་ཚོ་མགོ་བསྐོར་གྱི་ཡོད།",
    "ཁྲོམ་ལམ་དུ་ཡོད་པའི་མི་རྒན་པ་མང་པོ་བགད་མོ་ཤོར་བཞིན་མཐའ་བསྐོར་ནས་ལྟད་མོ་ལྟ་བཞིན་གནས།",
    "བགད་མོ་འཚེར་འཚེར་བྱས་ནས་སྡོད་ཀྱི་ཡོད།",
    "ཁོང་གི་གཅུང་མོས་ཡ་མཚན་ཅན་གྱི་བཟོ་ལྟ་འདི་ལྟ་བུ་མཐོང་དུས་ཕར་རྒྱུགས་ཕྱིན་ནས་མ་ལ་གཅེན་པོ་ཡང་འདི་ལྟར་ལངས་བསྡད་བཞག་ཅེས་བརྗོད།",
    "ཐེངས་ཤིག་བུ་རྫི་བས་ཁོང་པང་དུ་འཁུར་ནས་མཆོད་ཁང་གི་ཡང་སྟེང་དུ་རྩེད་མོ་རྩེ་བར་བསྐྱོད།",
    "བུ་རྫི་བས་སྒོ་སྒོར་སྒོར་དེར་བསྡད་ནས་ལག་གཉིས་ཀྱིས་ཁོང་མཐོན་པོར་བཏེགས་ཏེ་ཐང་ཆེན་ལ་ལྟད་མོ་ལྟ་རུ་བཅུག་ལོ་ན་ཆུང་བའི་ཨིབ་སེན་གྱིས་རང་ཉིད་ཁྱིམ་ཚང་གི་ཐོག་དང་།",
    "ད་དུང་སྒོ་རའི་རྒྱབ་ཀྱི་ཤིང་སྡོང་ལ་བཏགས་བཞག་པའི་རྟ་རྐྱང་པོ་དེའང་མཐོང་བ་རེད།",
    "ཐང་ཆེན་ཐོག་གི་མི་ཕུང་དང་།",
    "ཁོང་གིས་དྲན་གསོ་གནང་སྐབས་གསུངས་དོན།",
    "དུས་དེར་ཁོང་གི་སྐྱེས་མས་སྒེའུ་ཁུང་ནས་གཟིགས་སྐབས་ཕྲུ་གུ་མཆོད་ཁང་གི་ཡང་རྩེར་ཡོད་པ་གཟིགས་འཕྲལ་བུ་རྫི་བར་ཕྱག་བརྡ་གནང་ནས་མར་བབས་ཤོག་གསུངས་པ་དང་།",
    "དངངས་སྐྲག་ལངས་ནས་དྲན་པ་འཐོར་བ་རེད།",
    "ཁོང་ན་སོ་ལོངས་པའི་རྗེས་སུ་ཐང་ཆེན་དེ་བརྒྱུད་ནས་འགྲོ་སྐབས་རྟག་ཏུ་མགོ་བོ་བཏེགས་ཏེ་བྱ་བྱིའུ་ཡིས་མར་ལྟ་ས་དེར་ཡང་ཡང་གཟིགས་པར་ཤོར།",
    "སེམས་ཁམས་སྣང་ཚུལ་འདི་ལྟར་བཀོད་པ་ནི་ཁོང་གིས་འཇིག་རྟེན་ཁམས་དེར་ཐོག་མར་ཡུད་ཙམ་གཟིགས་པའི་འཆར་སྣང་རེད།",
    "ཨིབ་སེན་གྱི་ཡབ་ཁོ་ལུའུ་ཏེ་ནི་ཤིང་ཚོང་གི་ལས་ཀ་གཉེར་ནས་ལོངས་སྤྱོད་མངའ་ཐང་རྒྱས་པར་གྱུར།",
    "ནོར་ཝེ་ཕུད་པའི་སུའེ་ཏེན་དང་སི་ཏེ་ཀོར་མུའུ་རུ་ཤིང་ཚོང་ལས་བྱེད་ཡུལ་བཙུགས་ཡོད།",
    "བཙོན་པ་ཚོར་ད་དུང་ཤིང་སྒོ་ལྕི་པོ་རེ་རེ་གཡོགས་པ་དེ་ནི་ཁོང་གི་ཁྱིམ་ཚང་གྲ་རྒྱས་འགྲོ་ཡས་ཀྱི་ཤིང་ཆ་ལས་བཟོས་པ་ཞིག་རེད།",
    "ཁོང་གི་མཚན་གནས་ཀྱང་ཧ་ཅང་མཐོ་བའི་དུས་སྐབས་རེད།",
    "ཁང་པའི་མདུན་དུ་མེ་ཏོག་ལྡུམ་རའི་ནང་ཧ་ཅང་དཀོན་པའི་ཤིང་དང་མེ་ཏོག་སྣ་ཚོགས་བཏབ་པ་དེས་དུས་བཞི་དབྱེར་མེད་མེ་ཏོག་གི་དྲི་མངར་ཕྱོགས་བཞི་གང་སར་ཁྱབ་བཞིན་གནས་སོ།",
    "དུས་ཆེན་སྐབས་སུ་གཉེན་གྲོགས་འགའ་ཞིག་ཁོང་གི་གཟིམ་ཁང་དུ་བཞུགས་ཀྱི་ཡོད།",
    "ཚོང་པ་ཆེ་ཁག་འབྱོར་ལྡན་པ་མང་པོ་རྟག་ཏུ་ཁོང་གི་ཁྱིམ་ཚང་དུ་བཅར་ནས་སྣེ་ལེན་ཞུས་མི་ཚར་བ་ལྟ་བུར་གྱུར།",
    "ཁོང་གི་ཕྲུ་གུ་དྲུག་གི་ནང་ནས་ཨིབ་སེན་ཕུད་དེ་བྱིངས་ཚང་མ་དཔེ་དེབ་ལྟ་བར་མི་དགའ་བ་དང་།",
    "ཁོང་གི་ཡུམ་ནི་ངག་འཇམ་ལ་གཤིས་བརྒྱུད་བཟང་བ།",
    "རི་མོ་འབྲི་བར་དགའ་བ།",
    "ཨིབ་སེན་གྱི་རྩོམ་རིག་འཁྲབ་གཞུང་ནང་ནས་ང་ཚོས་ཁོང་གི་ཕ་མ་གཉིས་ཀྱི་གྲིབ་གཟུགས་མཐོང་ཐུབ།",
    "ཧེང་ཏེ་ཝེ་ཏེ་ཞེས་པའི་ས་གནས་དེར་ལོ་ལྟར་ཟླ་བ་གཉིས་པར་ཚོང་ཟོག་འགྲེམས་སྟོན་ཚོང་བསྒྱུར་བྱེད་སྐབས་ཁོང་གི་ཁྱིམ་དུ་སྐུ་མགྲོན་དེ་བས་མང་བ་དང་།",
    "ཁོང་ལ་སྐུ་དྲག་གི་ཕྲུ་གུའི་གཤིས་རྒྱུད་ཅིག་འཇགས་ནས།",
    "མི་གཞན་ལ་མཐོང་ཆུང་བྱས་ཏེ་ཕལ་པའི་ཕྲུ་གུ་དང་མཉམ་དུ་རྩེད་མོ་རྩེ་ཐབས་བྲལ་ཞིང་།",
    "ལོ་ན་ཆུང་དུས་ནས་བག་མེད་ལོངས་སྤྱོད་ཀྱི་འཚོ་བ་བསྐྱལ་སྟབས་ཁོང་གི་གཤིས་ཀར་རྟགས་དམ་གཏིང་ཟབ་ཅིག་ཕོག་ཡོད།",
    "ཡོ་རོབ་ནུབ་མའི་མཚོ་ཐོག་གི་སྐྱེལ་འདྲེན་བདེ་བླག་བྱུང་བ་དང་།",
    "དེར་བརྟེན་ཁོ་ལུའུ་ཏེའི་ཤིང་ཆ་ཉོ་ཚོང་གི་ལས་ཀ་དེ་ཉིན་བཞིན་ཇེ་སྡུག་ཏུ་ཕྱིན།",
    "ཐེངས་གཅིག་རྒྱུན་གཙུགས་ཏེ་རྩེད་མོ་རྩེད་སྐབས་ནང་ཆས་ཡོངས་རྫོགས་ཤོར།",
    "སྤྱི་ལོ་ལོར་ཁྱིམ་ཚང་གི་གཏོང་ཡོང་ཁ་མ་ཐུགས་པར་ཉེང་ཏེ་ཝེ་ཏེ་ལ་ཡོད་པའི་གཟིམ་ཁང་འདི་ནས་སི་ཅི་ཨེན་བྱང་ངོས་ཀྱི་ཞིང་གྲོང་ཆུང་ངུ་ཞིག་ཏུ་སྤོས་ཏེ་སྡོད་དགོས་བྱུང་བ་རེད།",
    "ལོ་ཤས་རིང་གི་འབྱོར་ལྡན་པའི་འཚོ་བ་དང་།",
    "ཁྱིམ་ཚང་ཉམས་རྒུད་དུ་ལྷུང་བ་དེས་ཨིབ་སེན་ལ་རྡུང་རྡེག་ཤུགས་ཆེན་ཕོག་དེ་རྗེས་ཁོང་གིས་འཚོ་བ་དངོས་ཀྱི་ཚོད་བགམ་ནང་ཡོངས་སུ་མྱོང་ཚོར་ཤེས་རྟོགས་བྱུང་བ་རེད།",
    "འོན་ཀྱང་ཡུན་རིང་མ་སོང་བར་འབྲེལ་ཐག་རིང་དུ་གཏོང་བ་དང་།",
    "ཐ་ན་ཁོང་གི་ཁྱིམ་ལ་དཀྲོག་གཏམ་བཟོས་ཏེ་དམའ་འབེབས་གཏོང་བ།",
    "འཇིག་རྟེན་གྱི་ཐ་ཤལ་ཉམས་ཐག་གི་གོམ་སྲོལ་གྱིས་ཁོང་གི་སེམས་པར་འགྱུར་ལྡོག་ཧ་ཅང་ཆེན་པོ་བྱུང་ཞིང་།",
    "ཁྱིམ་ཚང་ནི་འབྱོར་ལྡན་ཕུན་སུམ་ཚོགས་པ་ནས་ཉམས་ཐག་གི་གནས་སུ་གྱུར་སྟབས་དེ་སྔ་རི་མོ་སྦྱངས་ཡས་ཀྱི་བསམ་འདུན་དེ་སྟོང་པར་གྱུར།",
    "ཨིབ་སེན་གྱི་རྩོམ་རིག་དང་འཁྲབ་གཞུང་ནང་ཁྱིམ་ཚང་ཉམས་རྒུད་ཐ་ཤལ་དུ་གྱུར་པའི་སྐོར་ཞིབ་གསལ་ཐེངས་མང་བཀོད་པ་དེ་དངོས་ཡོད་འཚོ་བའི་མྱོང་ཚོར་གཏིང་ཟབ་བྱུང་བའི་རྐྱེན་གྱིས་ཡིན་པ་གསལ་པོར་རྟོགས་སོ།",
    "ཕ་མ་གཉིས་ཀྱིས་ཞིང་ར་ཆུང་ངུ་ཞིག་ནང་ཁྱིམ་ཚང་ཆེན་པོ་ཞིག་གི་འཚོ་བ་སྐྱོང་ཐབས་མེད་པས་བུ་རྒན་ཤོས་དེ་ཕྱི་རོལ་དུ་འཚོ་ཐབས་བྱེད་པར་མི་གཏོང་ཀ་མེད་བྱུང་།",
    "ཨིབ་སེན་གྱིས་རྡོག་ཁྲེས་རྒྱབ་ཏུ་འཁུར་བཞིན་སྐྱོ་སྣང་གི་སེམས་པ་བཅངས་ནས་ཕ་མ་དང་།",
    "གཅུང་པོ་གཅུང་མོ་རྣམས་དང་ཞལ་གྱེས་ཤིང་།",
    "ཨེའེ་ཨེར་སི་པོ་ཁེ་ཏེར་ཞེས་པའི་ཁྱིམ་མཚེས་ཀྱི་གཡོག་མོ་ཞིག་ཡོད།",
    "ཁོང་མོ་ནི་ལོ་སུམ་ཅུར་སླེབས་གྲབས་ཡོད་ལ།",
    "ཁོང་མོས་ཨིབ་སེན་གྱི་གྱོན་ཆས་ལ་ལྷན་པ་བརྒྱབ་པ་དང་།",
    "མཚན་མོ་ཁོང་གཅིག་པུར་སྡོད་སྐབས་ནང་ལ་ཡོང་ནས་སྐད་ཆ་ཤོད་རོགས་བྱེད་ཀྱི་ཡོད།",
    "ཕོ་ལོ་དྲུག་གསུམ་བཅོ་བརྒྱད་ལ་སླེབས་པའི་ཨིབ་སེན་ནི་ནལ་ཕྲུག་ཧན་སི་ཡུའེ་ཁོ་པོ་ཡི་པ་ཕ་ཆགས་པ་རེད།",
    "ཁོ་པ་ཚོའི་མཚན་གནས་གང་ལའང་གནོད་ཀྱི་མ་རེད།",
    "ཨའེ་ཨེར་སི་ཞེས་པའི་བུད་མེད་དེ་ནི་མི་ཐ་ཤུལ་ཐ་ནག་ཅིག་ཡིན་པས།",
    "དེར་བརྟེན་ཁོང་གཉིས་མཐུན་ཐབས་རྩ་བ་ནས་མེད་པར་ཁ་བྲལ་བ་རེད།",
    "ལོ་བཅུ་ཉི་ཤུ་ཙམ་རིང་ཕྲུ་གུའི་འགྲོ་སོང་གཏོང་དགོས་བྱུང་བར་བརྟེན་ཨིབ་སེན་མི་ཚེ་གཅིག་རིང་བསམ་པའི་རྡོག་ཁྲེས་སུ་གྱུར།",
    "ཨིབ་སེན་གྱི་ཟློས་གར་འཁྲབ་གཞུང་ནང་ཕ་མེད་ཀྱི་ཕྲུ་གུ་རྣམས་སྡུག་བསྔལ་མྱོང་བའི་གནས་ཚུལ་བཀོད་པ་དེ་ནི་ཁོང་རང་གི་མྱོང་ཚོར་དང་འབྲེལ་བ་ཧ་ཅང་ཆེན་པོ་ཡོད།",
    "ཚོང་ཁང་གི་སྦྱིན་བདག་ལོ་ན་ཆུང་ལ་འཇོན་ཐང་ཆེ་བ།",
    "དུས་དེར་ཨིབ་སེན་དགུང་ལོ་ཉི་ཤུར་སླེབས་ལ་ཉེ་བས་ཤེས་བྱ་སྦྱང་བའི་རེ་འདུན་དེ་བས་མཐོ་རུ་ཕྱིན།",
    "ཁྱིམ་ཚང་ཉམས་རྒུད་དུ་སོང་བ་དང་དགེ་ཕྲུག་གི་གནས་བབས་དམའ་བ།",
    "དེར་བརྟེན་སྐབས་འགར་སྙན་ཚིག་བརྩམས་ཏེ་ཁོག་ནང་གི་སྡུག་བསྔལ་མཐའ་དག་མཚོན་པ་བྱེད་བཞིན་གནས།"
  ]
}