    "འཁྲབ་གཞས་ཁག་བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར།",
    "དེ་ཡང་ཁོང་གིས་བརྩམས་གནང་བའི་འཁྲབ་བཞས་དེ་དག་འཁྲབ་སྟོན་གནང་བ་ཁོ་བོའི་འདྲེན་བྱེད་ཡུལ་དུ་མ་གྱུར་ཡང་འཁྲབ་གཞུང་རི་མོར་ཞིབ་ཏུ་བལྟས་རྗེས་ཁོ་བོར་མྱོང་ཚོར་བྱུང་བ་འཁྲབ་ཚན་རེ་རེ་བཞིན་བརྗོད་ན་འདི་ལྟ་སྟེ།",
    "ཏང་གི་སྐབས་བཅུ་གཅིག་པའི་ཚང་འཛོམས་གྲོས་ཚོགས་ཐེངས་གསུམ་པ་འཚོགས་ཚུན་མང་ཚོགས་ཀྱི་འཚོ་བའི་ཆུ་ཚད་ཡར་ངོའི་ཟླ་བཞིན་གོང་ནས་གོང་དུ་འཕེལ་ཡོད་པ་བསྟན་པ་སྟེ།",
    "ཏང་གི་ཚང་འཛོམས་གྲོས་ཚོགས་གསུམ་པའི་རྗེས།",
    "འཁྲབ་གཞས་གཏམ་བཟང་ཞེས་པའི་ནང་དོན་གཙོ་བོ་ནི་ང་བཞད་གད་དཔྱིད་ཀྱི་ཕོ་ཉར་བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར་འདོད་ཡོན་སྣ་ལྔ།",
    "སློབ་ཕྲུག་བཅས་ཀྱིས་རང་རང་གི་ལས་གནས་སམ།",
    "ཕུགས་འདུན་སྐོར་ཕན་ཚུན་གླེང་མོལ་བྱས་ནས་ཐུན་མོང་ཐོག་འབད་བརྩོན་བྱེད་དགོས་པའི་སྐུལ་མ་བཏང་བ་ཤུགས་ལས་རྟོགས་པའོ།",
    "སྨྱུག་རོལ་མགྱོགས་གཏམ་ལྷ་ས་སྐོར་བ་ཞེས་པའི་བརྗོད་བྱའི་ནང་དོན་གཙོ་བོ་ནི་གངས་ཅན་སྤྱི་དང་བྱེ་བྲག་ལྷ་སའི་འགྱུར་ལྡོག་མངོན་མངོན་རྗེན་རྗེན་པར་རྒྱག་མཁས་ཅན་གྱིས་པར་བརྒྱབ་པ་བཞིན་ཀུན་གྱི་འདྲེན་བྱེད་གཟིགས་མོར་བཤམས་ཡོད་དོ།",
    "ཁོ་བོས་གཞད་གད་དཔྱིད་ཀྱི་ཕོ་ཉ་ལ་བལྟས་རྗེས་སྐུ་ཞབས་ཁོང་གིས་བོད་ཀྱི་སྒྱུ་རྩལ་སྤྱི་དང་།",
    "དགོད་བྲོའི་གཏམ་གླེང་ཇ་ཆང་གི་རྩོད་གཞི་ཞེས་པ་ནི་གྲགས་ཅན་གྱི་གནའ་རྩོམ་ཇ་ཆང་ལྷ་མོའི་བསྟན་བཅོས་གཞིར་བཟུང་ནས་སྣོན་འཕྲི་གནང་བར་མངོན།",
    "ད་དུང་འཁྲབ་གཞས་གཏམ་བཟང་ཞེས་པ་སོགས་ཀྱི་བརྩམ་བྱ་ལེགས་བཞད་གད་དཔྱིད་ཀྱི་ཕོ་ཉར་བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར་འདོད་ཡོན་སྣ་ལྔ།",
    "འཛམ་གླིང་ཡང་རྩེའི་གནས་མཆོག་ཏུ་ཆེད་ལས་གཞས་མ་གཏམ་ཚོགས་པ་ཞིག་མི་རིང་བར་འཛུགས་ཐུབ་རྒྱུའི་སྨོན་འདུན་བཅས་བཞད་གད་དཔྱིད་ཀྱི་ཕོ་ཉ་བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར་ཞེས་པའི་རྩོམ་ཐུང་དེ་རེ་ཞིག་རྫོགས་སོ།",
    "སྤྲིན་གྱི་སྒྲ་དབྱངས་བལྟས་རྗེས་ཀྱི་དྲན་འཆར་ཕྲན་བུ་གངས་ཅན་རྩོམ་རིག་ཀུན་གསལ་སྒེག་མོའི་ངོས།",
    "སྙན་རྩོམ་མིག་གི་དགའ་སྟོན་སྲིད་ན་རྒྱལ།",
    "མཛེས་པ་ཡིད་འཕྲོག་ལྷ་མོའི་མཆོར་སྒེག་དང་།",
    "སྙན་པ་དྲི་ཟའི་བུ་མོའི་པི་ཝང་སྒྲ།",
    "ཇུས་མེད་ཇུས་འཁྲི་བདག་གིས་འདི་ན་གཏོར།",
    "ཞེས་པའི་མགོ་རྩོམ་ཤོ་ལོ་ཀ་ལྔ་ཚར་གཅིག་གིས་མདུན་བསུས་ནས་འདིར་ཐོག་མར་གླེང་སློང་བའི་གཞི་མ་ཐུང་ངུ་ཞིག་བྲི་བར་བྱ་སྟེ།",
    "དེ་ཡང་ལོ་ཤས་གོང་ནས་སྦྲང་ཆར་རྩོམ་སྒྲིག་ཁང་གིས་གུས་པར་བླ་ན་མེད་པའི་ཐུགས་ཁུར་གནང་སྟེ་བོད་ཀྱི་དེང་རབས་རྩོམ་རིག་དཔེ་ཚོགས་དེབ་བཞི་བསྐུར་གནང་མཛད་འདུག་ཁོ་བོས་དེ་དག་ལ་ཞིབ་ཏུ་བལྟས་རྗེས་ངོ་མ་དགའ་ཚོར་ཧ་ཅང་ཆེན་པོ་བྱུང་།",
    "ལྷག་པར་དུ་ཁོང་གི་སྔོན་འགྲོའི་གཏམ་ནང་གི་དུམ་བུ་གཅིག་སྟེ།",
    "རིག་རྩལ་དཔྱད་འཇོག་ནི་རྩོམ་རིག་གསར་རྩོམ་བྱ་འགུལ་ནང་གི་ལས་ཚན་གལ་ཆེན་ཞིག་ཡིན་ལ།",
    "ང་ཚོའི་རིག་རྩལ་གསར་རྩོམ་དང་།",
    "རིག་རྩལ་དཔྱད་འཇོག་གི་ལས་ཀ་ནི་ད་དུང་དོ་མི་མཉམ་པའི་གནས་སུ་ལུས་ཤིང་།",
    "རིག་རྩལ་དཔྱད་འཇོག་ནི་རིག་རྩལ་གསར་རྩོམ་གྱི་རྗེས་སུ་ལུས་ཏེ་བོད་ཀྱི་དེང་རབས་སྒྱུ་རྩལ་བྱ་བའི་འཕྲུལ་འཁོར་ཧྲིལ་པོའི་ནང་གི་ལྷུ་ཚིགས་ནུས་མེད་ཅིག་ཏུ་གྱུར་འདུག་ཅེས་གསུངས་པ་ནི་ཐུགས་ཤིན་ཏུ་མད་པའི་གཏམ་མོ།",
    "མ་གཞི་ཁོང་གི་བཀའ་མོལ་དེ་ནི་རིག་པའི་གནས་ལ་སྤྱན་དཀྱུས་རིང་བའི་མཁས་པ་ཚོར་རྩོམ་རིག་སྒྱུ་རྩལ་དར་རྒྱས་ཡོང་ཆེད་དཔྱད་རྩོམ་མང་ཙམ་མཛད་རྒྱུའི་ཐུགས་རེ་གནང་བ་ཞིག་ཡིན་པ་ལས་བློ་དམན་བདག་ལྟ་བུར་གསུངས་པ་ཞིག་ག་ལ་ཡིན་མོད།",
    "ཁོང་གི་བཀའ་མོལ་དུམ་བུ་དེས་ང་ལ་སྟོབས་ཤུགས་སམ་བློ་ཁོག་ཆེན་པོ་ཞིག་སྤྲད་གནང་བྱུང་བས།",
    "བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར་ཟིན་བྲིས་བརྒྱབ་ཟིན་མོད་བར་ལམ་སྟོང་བྲེལ་གྱི་ཆོམ་པོས་དུས་ཀྱི་ནོར་ཕྲོགས་པས་བྱ་བ་དེ་ད་ལྟའི་བར་ནར་འགྱངས་སུ་ལུས།",
    "སྙན་རྩོམ་གྱི་ཁ་བྱང་ཁག་ལ་བལྟས་པའི་མྱོང་ཚོར།",
    "དེ་ཡང་སྤྲིན་གྱི་སྒྲ་དབྱངས་ནང་གི་དཀར་ཆག་ལྟར་ན་སྙན་རྩོམ་གྱི་ཁ་བྱང་ཡོད་པ་ལས་རིང་ཤོས་ཡིག་འབྲུ་སུམ་ཅུ་བྱས་པ་བློ་དང་སྤོབས་པའི་སྟོབས་ལ་འཇུས་ནས་གྱི་ནར་མ་འདུག་ལྡང་ཞིག་ཅེས།",
    "ད་དུང་སྙན་རྩོམ་གཞན་རྣམས་ཀྱང་དཔྱིད་ཀྱི་བདག་མོ་ལྷ་ལས་བབས་པ་དང་།",
    "དུང་སེམས་ཀྱི་འཆར་སྣང་སྤྲིན་གྱི་ས་འཛིན་སྐྱེད་མོས་ཚལ་གྱི་དྲི་བ་སོགས་ཀྱང་སྒྱུ་རྩལ་གྱི་ཚད་གཞི་མཐོ་ལ་ཁ་བྱང་གསར་བ་ཡིན་པས་ཀློག་པ་པོས་དཀར་ཆག་མཐོང་མ་ཐག་ཁ་བྱང་དེ་དག་གི་སྙན་རྩོམ་ལ་བལྟ་ངེས་ཡིན།",
    "ལྷོད་ཀྱིས་འཕངས་པའི་ཉག་ཕྲན་ཞེས་པའི་ཁ་བྱང་མཐོང་མ་ཐག་དལ་བུར་འཕངས་པའི་མདའ་མོ་ཞིག་ཟེར་བ་གོ་མོད་མདའ་མོ་དེ་གང་ལ་འཕངས་ཡོད་མིན་དང་།",
    "ད་དུང་མདའ་མོ་ནི་མྱུར་བའི་དཔེ་རུ་འཇོག་ཀྱང་འདིར་ལྷོད་ཀྱིས་སམ་དལ་བུར་འཕངས་པ་ཞེས་བརྗོད་དགོས་དོན་གང་ཡིན་ནམ་སྙམ་པ་སོགས་ཁ་བྱང་དེས་ཀློག་པ་པོར་དྲི་བ་ཞིག་འདོན་ངེས་རེད།",
    "དོན་དུ་རྩོམ་པ་པོས་བརྗོད་པར་འདོད་པའི་དམིགས་བྱ་དེ་ལ་མདའ་མོ་ནན་དུ་འཕངས་ཡོད་མོད་ཚིག་ཐལ་དྲགས་པའམ་དམར་དྲགས་མེད་པར་ཐབས་མཁས་པོའམ་ཅུང་འཇམ་པོས་བརྗོད་ཡོད་པ་ནི་རྩོམ་དེའི་མཇུག་གི་ཚིག་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགརྐང་གཅིག་སྟེ།",
    "ཚིག་གི་མཐེབ་ཤེད་ཡོངས་སུ་མ་སྤྱད་ལྷོད་ཀྱིས་ཐལ་ལོ།",
    "འདི་ལྟའི་ཁ་བྱང་ནི་དཔེར་འོས་པ་ཞིག་རེད་སྙམ།",
    "དེ་དག་གི་ཁ་བྱང་རྐང་རྗེས་ཞེས་པ་ཕུད།",
    "འབག་སྐུའི་ཞལ་རས་ལྟ་བུ་ནི་སྔར་ནས་ཅུང་ཁྱབ་ཆེ་བའི་ཐུན་མོང་གི་ཁ་བྱང་ཡིན་པ་དང་།",
    "བོད་ཀྱི་དམངས་གཞས་ཕལ་མོ་ཆེ་དང་།",
    "ཚངས་དབྱངས་རྒྱ་མཚོའི་མགུར་གླུ་ལ་སོགས་པའི་གླུ་གཞས་མང་པོ་ཞིག་གི་ཁ་བྱང་དུ་གཞས་ཚིག་ནང་ནས་ཚིག་རྐང་རེ་ཁ་བྱང་དུ་བཀོད་ཡོད་པ་ཚང་མས་མཁྱེན་གསལ་ལགས།",
    "རེ་ཞིག་ཡིག་རྫོབ་ལ་འཇིགས་ནས་རྒྱས་པར་མི་སྤྲོའོ།",
    "བློ་བཟང་དཔལལྡན་གྱི་སྙན་རྩོམ་མམ་ཆབ་ཤོག་གི་ཁ་བྱང་ལྟ་བུར་སློབ་སྦྱོང་དང་དེ་དག་རྒྱུན་འཛིན་བྱེད་དགོས་པ་དང་།",
    "གཉིས་ནས་རང་གི་རིག་པའི་རྩལ་ལས་ཐོན་པའི་ཁ་བྱང་གསར་རྩོམ་བྱེད་དགོས་པ།",
    "བརྗོད་བྱའི་དོན་ལ་བལྟས་པའི་མྱོང་ཚོར།",
    "སོན་འདེབས་ཞེས་པ་གཉིས་ཀྱི་ནང་དོན་ལ་བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར་འགའ་ཞིག་གླེང་བར་བྱའོ།",
    "རང་རེ་བོད་ཡིག་གི་ཐུན་མིན་རྩོམ་སྲོལ་ཀ་རྩོམ་མམ་ཀ་སྤྲིན་གྱི་སྒྲ་དབྱངས་བལྟས་རྗེས་ཀྱི་དྲན་འཆར་ཕྲན་བུ།",
    "དེང་གི་ཆར་ཚང་མས་དངུལ་གྱི་དོན་དུ་འབད་བརྩོན་བྱེད་ཀྱི་ཡོད་པ་དང་།",
    "དངུལ་མེད་ན་བྱ་བ་ཅི་ཡང་སྒྲུབ་མི་ཐུབ་པ་ཞིག་ཡིན་མོད།",
    "ལྟ་བུའི་གནས་ཚུལ་གཟིགས་དུས་ཐུགས་ཀྱིས་མ་བཟོད་པར་རྩོམ་འདི་འབྲི་གནང་མཛད་པ་ཡིན་ཤས་ཆེ།",
    "ཀ་ཁ་ག་ང་སློབ་པའི་བྱིས་པ་ཚོས་དབྱངས་གསལ་མི་ཀློག་སྒོར་མོ་ཀློག།",
    "ཇ་ཆང་ཧབ་ཐོབ་བྱེད་པའི་མགོ་འདྲེན་པས་གསར་བརྗེའི་བདེན་དོན་སྒོར་མོ་རྙེད།",
    "ཉ་མོ་མགོ་བདེར་འཁྱུག་པའི་ཏང་ཡོན་དག་རྒྱང་རིང་དམིགས་འབེན་སྒོར་མོ་རྙེད།",
    "ད་ནིང་བཙོན་ནས་བཏང་བའི་ཉེས་ཅན་རྣམས་སྒོར་མོ་ཡོད་ན་གཟི་བརྗིད་ཡིན།",
    "ཨ་ཅང་ཀུ་རེ་ཡིན་མོད་ཨ་ཁུ་རྣམས་ཕལ་ཆེར་དེ་ཚོད་ཡིན་པ་འདྲ།",
    "ཧ་ཅང་ཞིབ་མོར་དཔྱད་ན་ཁྱིམ་པ་ཚོ་འགའ་ཞིག་དེ་འདྲ་མིན་ལས་ཆེ།",
    "ཞེས་གསུངས་ཡོད་པས་ཁོང་གིས་མི་ཉུང་ཤས་ཤིག་ལ་སུན་འབྱིན་གནང་བ་ལས།",
    "བརྗོད་བྱའི་ནང་དོན་ནི་གཟུགས་ཆུང་ཡང་གསེར་གི་མདེའུ་ཞེས་པ་དང་ཡོངས་སུ་མཚུངས།",
    "ནང་གི་མཆོད་ཀོང་མར་ཁུས་བརྒྱངས་པ་དགའ།",
    "དེ་ལས་གངས་རིར་ལོག་སྟེ་དབྱར་དགུན་དབྱེ་བ་མེད་པའི་ཐང་ཤིང་སྔོན་མོ་ལེགས་པར་བསྐྱངས་ན།",
    "འཚོ་བའི་ནང་ཁོང་གིས་ལྷག་བསམ་རྣམ་དག་ངང་ཐུགས་ནུས་ཡོད་རྒུས་བྱ་བ་འགའ་ཞིག་སྒྲུབ་པར་བརྩམས་ཀྱང་།",
    "རྗོད་བྱེད་ཚིག་དང་རྒྱན་ལ་བལྟས་པའི་མྱོང་ཚོར།",
    "འདིར་མཐའ་དག་རི་མོར་བཀོད་པར་མི་ལང་བས་ཚིག་སྦྱོར་ཚར་དུ་དངར་ཞིང་།",
    "རྩོམ་པ་པོས་ཐོག་མར་རང་གི་བརྗོད་པར་འདོད་པའི་དཔྱིད་ཀྱི་བདག་མོ་དེ་ལ་ཆེས་འོས་ཤིང་འཚམ་པའི་རྒྱན་རབ་བཏགས་སམ་རབ་རྟོག་གི་རྒྱན་མ་འཁྲུལ་མ་ནོར་བར་འདེམས་གནང་མཛད་འདུག་པ་ནི།",
    "ཀ་ཡེ་ཆུ་འཛིན་རེ་ཞིག་ཁྱོད་ནི་ལམ་ལ་བགྲོད་པའི་ཐབས་ཀྱི་གཏམ་ནི་མཉན་པར་མཛོད།",
    "དེ་ཡི་རྗེས་སུ་བདག་གི་འཕྲིན་ནི་རྣ་བའི་བདེ་སྐྱེས་ཁྱེད་ཀྱིས་རྣ་བས་གཟུང་བར་མཛོད།",
    "ཤིན་ཏུ་ངལ་ཞིང་རབ་ཏུ་ངལ་ཚེ་རི་བོའི་རྩེ་མོར་རྐང་བཀོད་ངལ་བ་བསལ་ནས་གཤེགས།",
    "ལམ་དུ་ཇི་ལྟར་བགྲོད་དགོས་པ་སོགས་ཀྱི་ཐབས་ལམ་མཆོག་གི་སྐད་ཆ་འདི་ལ་སོགས་པར་གསན་ནས་ཐུགས་ལ་ལེགས་པར་གཟུང་བར་མཛོད།",
    "ཤིན་ཏུ་ངལ་ཞིང་རབ་ཏུ་ཐང་ཆད་པའི་དུས་རི་བོའི་རྩེ་མོར་རྐང་པ་བཀོད་པའམ་ཙོག་པུར་བཞུགས་ལ་རེ་ཞིག་ངལ་གསོས་ཤིང་།",
    "དེ་ལྟར་ཆུ་འཛིན་ལ་འཕྲིན་ཡིག་སྐུར་སྐབས་རྩོམ་པ་པོས་རྟོག་པ་འཆར་ཡན་གྱི་སྨྱུག་རྩལ་སྤྱད་ནས་རབ་དཀར་སྤྲིན་ལ་འདུ་ཤེས་དང་དྲན་རེག་ཡོད་ལ།",
    "རབ་དཀར་བ་མོ་ས་གཞིར་བབས་སམ་སྙམ།",
    "དོན་དུ་ས་གཞིར་ཟླ་འོད་འཕྲོས་པ་དང་བ་མོ་བབས་པ་ནོར་ག་ལ་པ་སྲིད།",
    "དེར་བརྟེན་རྩོམ་པ་པོས་ཟླ་འོད་བ་མོ་བབས་པ་དང་ནོར་བར་ཐག་བཅད་མེད་པར།",
    "རབ་དཀར་བ་མོ་ས་གཞིར་བབས་སམ་སྙམ་ཞེས་རབ་བཏགས་ཀྱི་རྒྱན་སྦྱར་ཡོད་དོ།",
