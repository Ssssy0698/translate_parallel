    "དེ་ཡང་ཁོང་གིས་བརྗོད་དོན་དེ་འདྲ་ཞིག་འདེམས་གནང་མཛད་དགོས་དོན་ཅི་ཡིན་ཞེ་ན།",
    "དེ་ནི་རྩོམ་པ་པོ་སྐུ་ངོ་མས་མ་གཏོགས་ལན་ཆ་ཚང་འདེབས་མི་ཐུབ་པ་ཞིག་ཡིན་མོད།",
    "ཁོང་གིས་བརྗོད་དོན་དེ་འདྲ་ཞིག་འདེམས་གནང་མཛད་དགོས་དོན་ནི།",
    "གཅིག་ནས་བསིལ་དུས་ཀྱི་བོད་ལྗོངས་ཞེས་པའི་ནང་གི་བསིལ་དུས་ནི་དགུན་དུས་ཀྱི་མངོན་བརྗོད་ཡིན་ཞིང་།",
    "ག་བུར་རྡུལ་གྱིས་དབྱིག་འཛིན་སྒེག་མོའི་བཞིན་གྱི་ར་རི་མ་ལུས་བཀྲུས།",
    "ཞེས་དགུན་དུསཀྱི་བོད་ལྗོངས་ས་མཐོ་ཁྱོན་ཡོངས་ཀྱི་ཕྱི་སྣོད་རང་བྱུང་གི་མཛེས་ལྗོངས་ཇི་མ་ཇི་བཞིན་གསལ་བར་བསྟན་པ་དང་།",
    "ཅ་གས་རབ་བསྐྱངས་གསར་དུ་བཙུགས་པའི་འབྲས་ལྡན་ཤིང་དང་སྐྱེད་མོས་ཚལ།",
    "ཐ་རམ་གྲང་བའི་རེག་བྱ་འགོག་ཆེད་གངས་དཀར་ཕྱིང་པའི་མལ་ཆས་གྱོན།",
    "སྐྱེས་མོས་ཚལ།",
    "དྭངས་བསིལ་ཡན་ལག་བརྒྱད་ལྡན་གྱི་ཆུ་བོ་དག་ཀྱང་རང་གི་བརྩེ་གྲོགས་ཉ་ཆུང་གསེར་མིག་ཅན་དང་ལྷག་ཅིག་གཡང་ཊིའི་ཁང་སྟེ།",
    "མཐའ་མེད་རྩྭ་ཐང་ཁྱོན་དུའང་ལེ་དབར་སྟོང་ལྡན་རྩྭ་ར་བསྐོར།",
    "ཞིང་ཐང་གི་ས་རྒྱུ་ལེགས་བཅོས་བྱེད་པ།",
    "ཕྱུགས་རིགས་དཀར་ནག་འཕེལ་རྒྱས་གཏོང་བའི་རྦ་རླབས་འཕྱུར་བ་སོགས་གསལ་པོར་བསྟན་ཡོད་པས་མཚོན་སྙན་རྩོམ་བསིལ་དུས་ཀྱི་བོད་ལྗོངས་ལ་ཁྱོན་ཤོ་ལོ་ཀ་དགུ་ལས་མེད་ཀྱང་བརྗོད་དོན་ཧ་ཅང་མང་པོ་ཞིག་ཆུ་བརྒྱ་ཟམ་འདུས་ཀྱིས་གསལ་པོར་བསྟན་ཡོད།",
    "དེ་བཞིན་སྐབས་དེ་དང་དེའི་གོང་དུ་རི་བོ་གང་སར་རྫས་མེ་བརྒྱབ་ནས་རྡོ་བརྐོ་གི་ཡོད་པས་སྙན་རྩོམ་དེའི་ནང་རྫས་མེའི་ཤུགས་ཀྱིས་རང་བྱུང་རི་བོ་མགོ་བོ་དུད་པ་གསལ་པོར་བསྟན་ཡོད།",
    "ཞེས་སྐབས་དེའི་གོང་དུ་བོད་ཀྱི་ས་ཆ་ག་ས་གར་ལ་ལུང་ཁོད་སྙོམས་ནས་ཞིང་ཁ་བཟོ་གི་ཡོད་པ་དེ་གསལ་པོར་བསྟན་ཡོད།",
    "ས་གཞིར་གང་བབས་པ་ལ་གྲང་བའི་རེག་བྱ་འགོག་ཆེད་གངས་དཀར་ཕྱིང་པའི་མལ་ཆས་གྱོན་ཞེས།",
    "དེ་བཞིན་དགུན་གྱི་དུས་ཆུ་དང་ཉ་མོ་འཁྱགས་པའི་འོག་ནས་རྒྱུ་བའམ་འཁྱགས་པའི་འོག་ཏུ་བསྟི་བ་ལ་ད་དུང་དྭགས་བསིལ་ཡན་ལག་བརྒྱད་ལྡན་ཆུ་དང་ཆུ་ཕྲན་ཐམས་ཅད་ཀྱང་།",
    "ཚང་མས་མཁྱེན་གསལ་ལྟར་ལག་སྐྱོར་འདྲུད་འཐེན་འཁོར་ལོ་ནི་ལམ་དུ་བསྐྱོད་དུས་མི་འ་འུར་རམ་མི་ཆང་གིས་བཟི་བའི་གོམ་བགྲོད་དང་འདྲ་པོ་ཡོད་པསསྔར་ནས་དམངས་ཁྲོད་དུ་ལག་འཁྱེར་འདྲུད་འཐེན་འཁོར་ལོ་ལ་སུམ་སྟོང་ར་བཟི་ཞེས་ཟེར་བ་དང་ཡོངས་སུ་མཚུངས།",
    "དེ་བཞིན་ས་མཐོའི་མི་རིགས་ཀྱི་ཐུན་མིན་དྲི་བསུང་འཐུལ་བའི་མེ་ཏོག་སོས་པ་ཞིག་མ་ཡིན་པར་ཕྱི་མཛེས་ནང་སྟོང་འགྱིག་གི་མེ་ཏོག་བྱིས་པའི་མགོ་བོ་འཁོར་ལོ་ལྟར་བསྐོར་བྱེད་ཅིག་རེད་ཅེས་ཁོ་བོས་མགྲིན་པ་གཟེངས་སུ་བཏེགས་ནས་སྨྲ་བར་བྱའོ།",
    "སྙན་རྩོམ་དེའི་རྩོམ་འགོ་དང་རྩོམ་འཇུག་གི་སྐོར།",
    "ལྷག་པར་དུ་རྩོམ་མཇུག་བསྡུ་སྟངས་ཐུན་མོང་མ་ཡིན་པ་ཞིག་ཏུ་མཐོང་བ་དཔེར་ན།",
    "ག་བུར་རྡུལ་གྱིས་དབྱིག་འཛིན་སྒེག་མོའི་བཞིན་གྱི་ར་རི་མ་ལུས་བཀྲུས།",
    "ཚིག་སྦྱོར་རྒྱ་ཆེ་བ་བཅས་རྒྱ་ཆེ་བ་གསུམ་གྱི་སྟེང་ནས་བརྗོད་པར་འདོད་པའི་བོད་ཀྱི་དགུན་དུས་ཀྱི་མཛེས་ལྗོངས་གསལ་བར་སྟོན་པའི་རྩོམ་འགོ་གནམ་གྲུའི་བབས་ཐང་ལྟར་ཤིན་ཏུ་ཡངས་པོར་ཕྱེ་རྗེས་རིམ་བཞིན་མཚོ་མཇལ་གྱི་ཞལ་ཁེབས་ཕྱེ་བ་ལྟར་ས་མཐོའི་དགུན་དུས་ཀྱི་ཡངས་པའི་ནོར་འཛིན་དཔལ་མོ་དང་།",
    "རྩོམ་མཇུག་སྔོན་མ་སྟེ་ཨ་ལ་ལ་ཞེས་འཛམ་གླིང་ཡང་རྩེར་དེང་རབས་ཅན་གྱི་བོད་གསར་འཛུགས་ཞེས་ཚིག་གི་སྟེང་ནས་ཀ་མད་སུམ་ཅུའི་ཨ་ཡིག་གིས་མཇུག་བསྡུས་པ་དང་།",
    "དཔྱིད་དབྱཪ་སྟོན་གྱི་དུས་སུ་དེ་བས་མཛེས་ཤིང་ཡིད་དུ་འོང་བ་ནི་སྨོས་མི་དགོས་པ་ཞིག་རེད་ཅེས་སྙན་རྩོམ་འདིའི་བརྗོད་བྱ་དངོས་དགུན་དུས་ཀྱི་བོད་ལྗོངས་ས་མཐོའི་མཛེས་ལྗོངས་ལ་བསྔགས་པ་ལས་ཆེས་ཆེར་བརྒལ་ཏེ་དུས་བཞིའི་བོད་ལྗོངས་ལ་བསྔགས་པ་བརྗོད་དེ་རྩོམ་མཇུག་བསྐྱར་མ་བསྡུས་པ་དེ་ནི་རྩོམ་པ་པོའི་ཐུན་མིན་བློ་གྲོས་ལས་འཁྲུངས་པའི་ཐུན་མིན་གྱི་རྩོམ་མཇུག་བསྡུ་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགསྟངས་ཤིག་ཡིན་ནོ།",
    "ད་འོ་ན་སྙན་རྩོམ་བསིལ་དུས་ཀྱི་བོད་ལྗོངས་ལ་སྐྱོན་ཕྲ་མོ་ཙམ་ཡང་མེད་དམ་ཞེ་ན་དེ་འདྲ་འཇིག་རྟེན་ཐོག་ཡོང་མི་སྲིད་པས་མཁས་པ་གཞན་གྱིས་གཟིགས་ན་སྐྱོན་ཆུང་ཁ་ཤས་ཡོད་སྲིད་ཀྱང་།",
    "ངག་རྒྱུན་གཏམ་དཔེ་ཐོ་རེངས་སྐར་ཆེན་བཞིན།",
    "གནའ་སྔ་མོ་ནས་ད་ལྟ་བར་རྒྱ་ཆེའི་ཞིང་འབྲོག་མང་ཚོགས་ཁྲོད་དུ་གཏམ་དཔེ་དར་སོ་ཤིན་ཏུ་ཆེ།",
    "ཇི་ཙམ་ཉན་པ་དེ་ཙམ་བྲོ་བ་ལྡན་ཞིང་དེ་ཙམ་དགོད་བྲོ་བ་ཞིག་ཡོང་གི་ཡོད་པ་རེད།",
