    "ཐུན་ཚད་ལ་སོགས་པ་ཐམས་ཅད་སྔར་དང་འདྲའོ། ། དེ་བརྟན་ཞིང་བོགས་དབྱུང་བའམ་ཁྱད་པར་དུ་ལུས་བརྟས་ཤིང་རྒྱས་པར་འདོད་ན་མཛོད་སྤུ་སྐྲ་དཀར་ས་བོན་ནི།",
    "དེ་ནས་ལུས་ཐམས་ཅད་ལ་ཁྱབ་པརདེས་མི་རྟོག་པ་སྐྱེའོ་གསུང་།",
    "དེས་དང་པོར་ལྟེ་བར་དྲོད་དང་བདེ་བ་སྐྱེ་ཞིང་དེ་ནས་ལུས་ཐམས་ཅད་ལ་ཁྱབ་པར་སྐྱེ་སྟེ་ལྟེ་བར་དུ་བ་ལ་སོགས་པའི་རྟགས་རྣམསམཐོང་ཡོན་ཏན་བརྒྱད་འཆར་རོ།",
    "ཐུན་ཚད་དང་ཐུན་གྲངས་མེད་པར་བྱ།",
    "གྲངས་མེད་ཉི་ཤུ་རྩ་གཉིས་ཏེ་བཞི་བཅུ་རྩ་བཞི་ཐུན་དུ་བྱས་ཏེ།",
    "མེ་དེ་རྣོ་བ་མྱུར་བ་དྲག་པ་རྩུབ་པར་གྱུར་ཏེ།",
    "ཞེས་གསུངས་སོ།",
    "ཡང་རྣམ་པར་རྟོག་པ་རང་བྱུང་ནི།",
    "སྲིད་པས་སྲིད་པ་དག་པར་བྱེད།",
    "ཅེས་གསུངས་སོ།",
    "དེ་དག་ཀྱང་ཁམས་འདུས་པ་དང་པོ་ལ་མི་གསལ་ཞིང་མི་བརྟན་པའི་རྣམ་པར་སྐྱེ།",
    "ཁམས་འདུས་པ་བར་པ་ལ་ཅུང་ཟད་གསལ་ཞིང་བརྟན་པའི་རྣམ་པར་སྐྱེ།",
    "ཁམས་འདུས་པ་ཐ་མ་ལ་ཤིན་ཏུ་གསལ་ཞིང་བརྟན་པའི་རྣམ་པར་སྐྱེ།",
    "ཐ་སྙད་ལ་རྣམ་པར་སད་དེ་དྲི་བ་དང་དྲིས་ཤིང་ལུང་སྟོན་ནུས་པ་འབྱུང་།",
    "ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་ནི་སྒྲ་སྐྱོན་མེད་དུ་༣། སྟོན་ཤེས་པ་དང་།",
    "དོན་སོ་སོ་ཡང་དག་པར་རིག་པ་ནི་ཚིག་དོན་འབྲེལ་པ་ཅན་དུ་སྟོན་ཤེས་པའོ།",
    "མི་ཉམས་པར་བསྲུང་བའི་ཐབས་ལ་མཁས་པའོ།",
    "ཡབ་ཀྱིས་ཡུམ་གྱི་མཁའ་མི་དམིགས་པ་ལས་ཨཱ་ལས་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་ཟེའུ་འབྲུ་ལ་ཨཱ་ས་མཚན་པར་བྱིན་གྱིས་བརླབས།",
    "གསང་རྩ་ཁྱད་པར་ཅན་དང་ལྡན་པའོ།",
    "ལྟ་སྟངས་སྒྲུབ་པ་པོ་མཐོང་ན་མིག་དང་འཛུམ་མི་བྱེད་པར།",
    "དེ་རྣམས་གསང་རྩ་ཁྱད་པར་ཅན་དང་ལྡན་པའི་རྟགས་སོ།",
    "ཁྱད་པར་དུ་བུང་བས་སོ་བཏབ་ནས་སྐྲངས་པའོ།",
    "དང་པོར་གསོ་སྦྱོང་སྦྱིན་པར་བྱ།",
    "རྟེན་ཡོངས་སུ་དག་པ་དངོས་སམ་ཡིད་ཀྱི་ཕྱག་རྒྱ་མདུན་དུ་ཉེ་རིང་རན་པར་དངོས་སམ་ཡིད་ཀྱི་ཡུལ་དུ་བྱས་ལ།",
    "དེས་བདེ་བ་སྐྱེ་སྟེ་བདེ་བ་དེ་ཉམས་སུ་མི་གཞུག་པར་བསྒོམ།",
    "གསང་ཐུབ་པར་བྱ་བ་ནི།",
    "གསང་ཐུབ་པར་བྱ་སྟེ།",
    "གསང་ཐུབ་པར་བྱ་བ་ནི་དེའི་དུས་སུ་རྡོ་རྗེ་པདྨ་ཁ་མི་སྦྱར་བའོ།",
    "དེ་རྣམས་ཀྱི་དུས་སུ་བདེ་བའི་ཟུག་མི་བཟོད་པར་ལུས་ཐམས་ཅད་ལ་འོང་བ་སྲིད་དེ་ཉམས་ཐམས་ཅད་བྱུང་རྒྱལ་དུ་གཏང་ངོ།",
    "གཟུང་ཡང་མི་ཐུབ་པ་འདྲ་ན་བགྲད་པའི་མཐས་བཟློག་སྟེ་དེ་རྣམས་འབྲེལ་བ་ཅན་དུ་བྱས་པས་བདེ་བ་ཉམས་སུ་མི་གཞུག་པར་སྤེལ་ཏེ།",
    "བདེ་བ་དེ་གོང་ནས་གོང་དུ་བསྐྱེད་ཅིང་ཉམས་སུ་མི་གཞུག་པར་བསྒོམ།",
    "གསང་ཐུབ་པར་བྱ་སྟེ་དངོས་སུ་སྙོམས་འཇུག་མི་བྱའོ།",
    "དེ་ནས་ཅུང་ཟད་བསྲུབ་པ་དང་བསྲུབ་པའི་སྦྱོར་བ་བྱས་པས་བདེ་བ་མི་རྟོག་པ་དང་ལྡན་པ་རང་གཞན་ངོ་མི་ཤེས་པ་ཟས་ཀྱི་རོ་ལ་སོགས་པ་ཡང་མི་ཚོར་བ་ལ་སོགས་པ་དང་མིག་བཟློག་མི་ཤེས་པ་ལ་སོགས་པ་འོང་སྟེ།",
    "གསང་ཐུབ་པར་བྱ་བ་ནི་ཐིག་ལེཉམས་སུ་མི་གཞུག་པའོ།",
    "རྣམ་པར་ཉེད་པའི་སྐད་ཅིག་མ་སྟེ་དགའ་བ་ལས་དགའ་བྲལ་གྱི་དགའ་བ་ཞེས་པ་མི་རྟོག་པ་དང་ལྡན་པས་དགའ་བྲལ་ལ་དེའི་དུས་སུ་བདེ་བ་དང་ལྡན་པས་དགའ་བའོ།",
    "ཐིག་ལེ་གཉིས་ཁ་སྤྱི་འཛོམས་པའི་གནས་སུ་བྱོན་ཏེ་ཡུམ་གྱི་ཐིག་ལེ་དམར་པོའི་འོད་ཀྱིས་ཡབ་ཀྱི་དཀར་པོ་མི་གསལ་བར་བྱས།",
    "ཡབ་ཀྱི་དཀར་པོའི་འོད་ཀྱིས་ཡུམ་གྱི་དམར་པོ་མི་གསལ་བར་བྱས་ཏེ།",
    "དེ་ནས་ཁྱབ་པར་བྱ་བ་ནི་དུད་འགྲོའི་འགྱུར་བ་བཞིས་བྱ་སྟེ།",
    "མི་ཉམས་པར་བསྲུང་བ་ནི་འོག་ཏུ་ཐིག་ལེ་འཛག་པ་ལ་སོགས་པའི་སྐབས་སུ་ཤེས་པར་བྱའོ།",
    "ལུས་ཀྱི་སྤྱོད་ལམ་ལྡན་བྱས་ནས།",
    "སྦ་བ་སྦུབས་སུ་ནུབ་པར་འགྱུར།",
    "ཧཱུཾ་ཞེས་བརྗོད་ཅིང་མདུན་དུ་གུག་ཙམ་བྱས་ལ།",
    "བྱིན་གྱིས་བརླབས་སོགས་བྱས་ནས་ནི།",
    "མིག་གཉིས་སྟེང་དུ་བགྲད་པར་བྱ།",
    "འདིས་ནི་ཐིག་ལེ་ཟིན་པར་འགྱུར།",
    "འདིས་ཀྱང་ཐིག་ལེ་ཟིན་པར་འགྱུར།",
    "ཁྱབ་པར་བྱ་བ་ལ་མཁས་པ་རྣམ་གྲོལ་གྱི་ཕྱག་རྒྱའོ།",
    "རྟག་ཏུ་ཐིག་ལེ་ཟིན་པར་འགྱུར།",
    "ལུས་ཐམས་ཅད་ལ་ཁྱབ་པར་སྐྱེ་ན་དགའ་བྲལ་གྱི་དགའ་བའོ།",
    "ཞེས་གསུངས་སོ།",
    "སྙོམས་པར་འཇུག་པའི་དུས་སུ་དང་པོ་ཐིག་ལེ་སྤྱི་བོར་འདུས་ཏེ།",
    "སྤྱིར་གཟུང་འཛིན་གྱི་རྣམ་རྟོག་ཆེ་འབྲིང་བཅུ་གཉིས་སྤོང་བ་ལས་བདག་དང་གཞན་དང་བཤེས་པ་ལ་སོགས་པར་འཛིན་པའི་གཟུང་འཛིན་གྱི་རྣམ་རྟོག་རགས་རིམ་འགོག་པ་དགའ་བ།",
    "ཕྱག་རྒྱའི་བྱད་དང་དབྱིབས་ལ་སོགས་པར་འཛིན་པའི་རྣམ་རྟོག་འགོག་པ་དགའ་བྲལ།",
    "དེ་ཚེ་སྲོག་ནི་འགག་པར་འགྱུར།",
    "དང་པོ་ཐབས་རྒྱུད་། དག་པར་བྱ་བ་ནི།",
    "དེ་ལྟར་བསམ་པའི་ཡིད་ཀྱི་ཕྱག་རྒྱ་མངོན་དུ་བྱས་ཏེ།",
    "དེ་བཞིན་དུ་གཡོན་དུ་ཡང་བྱས་ཏེ།",
    "རྣམ་པར་ཐར་བའི་སྒོ་སྟོང་པ་ཉིད་ཅེས་མིང་ཐོབ་སྟེ་འབྲས་བུ་གསུམ་པའོ།",
    "དེ་ཡང་མི་རྟོག་པས་གྲོགས་བྱས་ནས་སྐྱེ།",
    "ཤེས་རབ་ཀྱི་རྒྱུད་ལ་ཡང་དེ་བཞིན་དུ་བྱསཏེ་དེའང་དངོས་ཀྱི་ཕྱག་རྒྱ་ཡིན་ན་ཐབས་རྒྱུད་དག་པའི་དུས་སུ་གཉིས་ཀའི་ས་མ་ཏིས་ཐབས་ལ་བྱ།",
    "རྣ་བ་གཉིས་ནས་ནང་དུ་ལྡོག་ཙམ་ན་མགྲིན་པར་བྱོན།",
    "མགྲིན་པར་བརྟན་ཙམ་ན་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་རོ་ཐམས་ཅད་ལ་ལོངས་སྤྱོད་པ་སྙམ་བྱེད་པ་འབྱུང་སྟེ།",
    "སྐབས་སུ་ཅང་མ་ཟོས་ཀྱང་ཚིམ་པ་ཁྱད་པར་ཅན་འབྱུང་།",
    "ཡི་གེ་ལ་གོམས་པར་བྱ་བའོ།",
    "ཕྱིའི་ཡི་གེ་ལ་གོམས་པར་བྱ་བ་དང་།",
    "དམ་ཚིག་ཉམས་པ་ཚོར་བ་དང་མ་ཚོར་བ་ཐམས་ཅད་བཤགས།",
    "ཉིན་ཞག་གཉིས་པ་ལ་དེ་གནས་དབེན་པར་བཞག་ལ་དམ་ཚིག་མཁའ་འགྲོ་སྤུན་གྲོགས་དང་ཤ་ཟ་མཁའ་འགྲོ་དུར་ཁྲོད་ཀྱི་བདག་པོ་ཞིང་སྐྱོང་བརྒྱད་ལ་སོགས་པ་ལ་ཚོགས་དང་གཏོར་མས་མཉེས་པར་བྱ།",
    "འབྲས་བུ་ངོ་བོ་ཉིད་ཀྱི་སྐུ་ནི་འབྲས་བུའི་སྐབས་ཉིད་དུ་འཆད་པར་འགྱུར་རོ།",
    "མི་ཉམས་པར་བསྲུང་བའི་ཚུལ་དང་།",
    "བཟའ་བའི་དམ་ཚིག་ལུས་སེམས་རྟས་པར་བྱེད་པ་སྟེ་དེའི་ཏིང་ངེ་འཛིན་བརྟན་ན་འོང་མི་བརྟན་ན་མི་འོང་སྟེ་མཐུན་རྐྱེན་བསྒྲུབ་པའོ།",
    "དེ་དག་མི་ཉམས་པར་བསྲུང་བའི་ཚུལ་ནི་བཞི་སྟེ།",
    "ཚུལ་ཇི་ལྟ་བ་བཞིན་རྒྱུད་ལ་སྐྱེས་པས་མི་ཉམས་པར་བསྲུང་བ་དང་།",
    "ཉམས་སུ་མྱོང་བ་ཞིག་རྒྱུད་ལ་སྐྱེས་པས་མི་ཉམས་པར་བསྲུང་བ་དང་།",
    "རྣམ་གྲངས་རྗེས་སུ་དྲན་པས་མི་མཛོད་ཉམས་པར་བསྲུང་བ་དང་།",
    "དེ་ཡང་སྤང་བྱ་རྣམ་པར་རྟོག་པ་རྩོལ་བའི་དུག་དང་ཤེས་བྱའི་སྒྲིབ་པ་གཉིས་ལས་དང་པོ་ནི་ཞི་གནས་དང་པོའི་རོ་གང་ཡང་རུང་བ་ལ་སེམས་གནས་པས་སེལ་བས་སོ་གསུང་།",
    "མདུན་དུ་སྤྱན་དྲངས་པའི་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ཚིམ་པར་བྱ།",
    "དམ་ཚིག་དང་ལྡན་པའི་སྐྱེ་བོ་ཚོགས་ཀྱི་ལོངས་སྤྱོད་ཀྱིས་ཚིམ་པར་བྱ་འབྱུང་པོའི་ཚོགས་ཤ་ཟ་ཌཱ་ཀི་གཏོར་མས་ཚིམ་པར་བྱ།",
    "ཀུནྡུ་རུ་ཡིས་ཚིམ་པར་བྱའོ།",
