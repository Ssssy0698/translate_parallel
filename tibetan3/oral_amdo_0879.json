    "དང་པོ་དུས་ལ་གཟིགས་སོ།",
    "ཉོན་མོངས་པ་ཤིན་ཏུ་ཆེ་བས་གདམས་པ་བྱིན་ནོ།",
    "། གདམས་པ་ལ་མི་གནས་ནནུ་ལ་དབྱུག་པ་བརྒྱབ་པའི་རི་མོ་བཞིན་མྱུར་དུ་འགག་གོ།",
    "དེནས་སེམས་དཔའ་ཆེན་པོ་སྐྱེ་བར་རིགས་སོ་ཞེས་དུས་ལ་གཟིགསསོ།",
    "དེ་ནས་རིགས་ལ་གཟིགས་པ་ཞེས་བྱ་བ་ནི།",
    "བདག་གི་ཡབ་ནི་ཟས་གཙང་མ་ཞེས་བྱ་བའི་རྒྱལ་པོ་ཡིན་ཏེ་རིག་ལ་གཟིགས་སོ།",
    "དེ་ནས་ཡུམ་ལ་གཟིགས་ཏེ།",
    "ཞག་བདུན་དུ་གཟིགས་སོ།",
    "འ་དི་ནི་ཆེན་པོ་ལྔ་ལ་གཟིགས་སོ།",
    "ཤི་འཕོས་ནས་ལྷ་མོ་སྒྱུ་འཕྲུལ་མ་ཆེན་མོའི་མངལ་དུ་ཞུགས་སོ།",
    "ལྷ་མོ་སྒྱུ་འཕྲུལ་ཆེན་མོ་ཡང་ཉའི་སྔུན་དུ་ཞགབདུནནས་མེ་ཏོག་འབྲང་བ་དང་སྟོས་ཀྱི་འབྱོར་པ་དང་ལྡན་པས་རྒྱུ་སྐར་ལ་རྩེ་ཞིང་ལོངས་སྤྱོད་དོ།",
    "དཔལ་གྱི་མལ་ཆ་ལ་ཉལ་ཏེ་གཉིད་དུ་སོང་ནས་འདི་ལྟ་བུའི་རྨི་ལམ་མཐོང་ངོ།",
    "རྒྱལ་པོ་ཆེན་པོ་བཞི་པོས་མལ་སྟན་དང་བཅས་པ་ཉིད་བླངས་ནས་གངས་ཅན་གྱི་ནང་དུ་སོང་ངོ།",
    "དེ་ནས་དེའི་ལྷ་མོ་འོངས་ནས།",
    "ལྷ་མོ་སྒྱུ་འཕྲུལ་མ་ཆེན་མོམཚོས་དྲོས་པར་ཁྲིད་དོ།",
    "བྱང་གི་ཕྱོགས་ནས་འོ་ངས་ཏེ།",
    "རང་གི་མལ་ཆའ་ལན་གསུམ་དུ་བསྐོར་བ་བྱས་ནས་གློ་གཡས་པ་ཕུགནས་ལྟོར་ཞུགས་པ་བཞིན་དུ་གྱུར་ཏོ།",
    "ཉིམ་གཉིས་པ་ལ་དེའི་སྔ་དྲོ་སད་དེ་ལྷ་མོས་རྒྱལ་པོ་ལ་རྨི་ལམ་རྣམས་སྐྱསསོ།",
    "རྒྱལ་པོས་བྲམ་ཟེ་དྲུག་ཅུ་རྩ་བཞི་བོས་ནས་མེ་ཏོག་གི་འཕྲང་བ་ལ་སོགབ་། པས་བཀྲ་ཤིས་དང་བསྟི་སྟང་བྱེད་ཅིངས་ལ་མལ་སྟན་ཆེན་བོ་བཤམས།",
    "དེ་ཡང་ནང་གི་དེ་སྐྱེས་བུའོ།",
    "མངལ་གྱི་ནང་གི་དེ་བུ་མོ་ནམ་ཡིན་ནོ།",
    "དེ་ཁྱོད་ཀྱི་སྲས་པོར་འགྱུར་རོ།",
    "རོལ་མོ་རྣམས་རང་བྱུང་རང་བྱུང་གི་སྒྲ་སྒྲོགས་སོ།",
    "ཐམས་ཅད་དུ་མ་ཏོག་གི་ཆར་བབ་བོ།",
    "ནམ་མཁའ་ལ་ལྷའི་རོལ་མོའི་སྒྲ་སྒྲོགས་སོ།",
    "ཇི་ལྟར་ཡང་བུད་མེད་གཞན་ཟླ་བ་བཅུ་ལས་དམན་པའམ།",
    "རུས་ཡོངས་སུ་རྫོགས་ནས་གཉེན་གྱི་གྲོསྨཱ་གྲུབ་ཞེས་རྒྱུ་ལ་བོ་ཆེན་པོ་ཟས་གཙང་གི་དྲུང་དུ་སྨྲས་སོ།",
    "བ་དན་ལ་སོགས་པའི་རྒྱན་འཛུགས་སུ་བཅུག་ནས་ལྷ་མོ་གསར་གྱི་དོད་ལ་བཞུགས་ཏེ།",
    "བློན་པོ་སྟོང་ཕྲག་གཅིག་གིས་བཏོག་སྟེ།",
    "དེའི་དུས་སུ་རྩ་བ་ནས་རྩེ་མོའ་ི་ཡལ་གའི་བར་ཐམས་ཅད་དུ་བར་མ་ཆད་པགམ་ཏོག་ཁ་བྱེ་བར་གྱུར་ཏོ།",
    "ཕྱགཞི་རྒྱལ་བོའི་མཛེས་བར་བྱས་པའི་འདུནས་ལྟ་བུ་དེ་ལྷ་མོས་གཟིགས་ནས་ཤིང་ས་ལའི་ཚལ་དུ་རྩེ་ཁར་བསམས་པ་སྐྱེས་སོ།",
    "དེའི་ལག་པ་བརྐྱང་ནས་ལ་གའི་རྩེ་མོ་བཟུང་ངོ།",
    "ལྷ་མོ་སུམ་རྫག་བསྔལ་བར་མ་བྱེད་ཅིག།",
    "ཁྱོད་ཀྱི་སུ་རང་ཕྱུག་དང་གྲགས་པ་དང་བཅས་པ་བལྟམས་སོ་ཞེས་སྨྲས་སོ།",
    "བདེ་བ་ལ་རེག་པར་གནས་པར་བྱ་བའི་ཕྱིར་གཟིག་གི་པགས་པས་སྔར་གྱི་བཞིན་དུ་བླངས་སོ།",
    "སྤོས་ལ་སོགས་པས་མཆོད་ཅིང་སྐྱེས་བུ་ཆེན་པོ་ཁྱོད་ལྟ་བུ་འདི་ན་ཡོད།",
    "ཁྱོད་ཀྱི་གོང་ན་གཞན་སུ་ཡང་མེད་དོ་ཞེས་སྨྲས་སོ།",
    "དེ་ནས་བྱང་གི་ཕྱོགས་སུ་གོམ་པ་བདུན་བགྲོད་དོ།",
    "དེ་ནས་དེའི་མས་བུ་འབྱོར་པ་དང་ལྡན་པའི་རིགས་སུ་ཁྱོད་སྐྱེས་སོ།",
    "ཉིན་མོ་ཉི་མ་ལ་མི་གནས་པའིཕྱིར་སུམ་ཅུ་རྩ་གསུམ་གྱི་གནས་སུ་འགྲོ་ཞིང་དེ་བདེ་བར་འདུག་ནས་ལྷ་དེ་རྣམས་བལྟའོ།",
    "དྲང་སྲོང་ཆེན་པོ་རྒྱལ་པོ་ཆེན་པོ་ཟས་གཙང་གི་སྲས་བལྟམས་སོ།",
    "བུ་རྣམས་རྒྱལ་པོ་ཆེན་པོའི་སྲས་སུ་གྱུར་པ་དེ་བདག་གིས་བལྟའོ་ཞེས་སྨྲས་སོ།",
    "རྒྱལ་པོས་ཡ་མཚན་ཆབ་གཟིགས་ནས་རང་གི་སྲས་ལ་ཕྱག་བྱས་སོ།",
    "འདི་ལྟ་བུའི་ཚུལ་གྱིས་ཡ་མཚན་ཆེ་བའི་སྐྱེས་བུ་མཐོང་བར་མི་ནུས་སོ་སྙམ་སྟེ་བདག་གི་སེམས་ཤིན་ཏུ་སྡུག་བསྔལ་བར་གྱུར་ནས་དུས་སོ།",
    "བདག་ཅག་གི་སྲས་འཕགས་བ་ལ་བར་དུ་གཅོད་པ་འོང་ངམ་ཞེས་དྲིས་སོ།",
    "འོ་ན་གང་གི་ཕྱིར་ངུ་ཞེས་དྲིས་སོ།",
    "འདི་ལྟ་བུའི་ཚུལ་གྱིས་སྐྱེས་བུ་སངས་རྒྱུ་བར་འགྱུར་བ་བདག་གིས་མཐོང་བར་མི་འགྱུར་བས་བདགཤིན་ཏུངེསཔར་སྡུག་བསྔལ་ལོ།",
    "དེའི་ཕྱིར་རང་གི་ཆེད་དུ་མྱ་ངན་གྱིས་དུའོ་ཞེས་སྨྲས་སོ།",
    "དེ་སྲིང་མོའི་ཁང་པར་སོང་སྟེ།",
    "དེ་རང་གི་གནས་སུ་འོངས་ནས་ནཱ་ལཀལ་སྨྲས་སོ།",
    "ཚབོ་རྒྱལ་པོ་ཆེན་པོ་ཟས་། གཙང་གི་རིགས་ཀྱི་བུ་འཁྲུངས་སོ།",
    "ཁྱོད་ཀྱིས་འདི་མཐོང་བར་འགྱུར་བས་ད་ལྟ་ཉིད་དུ་རབ་ཏུབྱུང་།",
    "དེ་མ་ཐག་ཏུ་རང་གི་ཚོང་གནས་སུངུར་སྨིག་གི་གོས་ཉིད་དང་སའི་ལྷུང་བཟེད་བླངསཞས།",
    "སྐྲ་དང་ཁ་སྤུ་བྲེགས་ཏེ་ངུར་སྨིག་གི་གོས་གྱོན་ནས།",
    "གང་ཞིག་འཇིག་རྟེན་པའི་གང་ཟག་གི་མཆོག་གི་མཆོག་ལ་བསམས་ཤིང་བདག་རབ་ཏུ་བྱུང་བར་ཚོ་འགྱུར་རོ་ཞེས་བསམས་ཏེ།",
    "དེ་རྣམས་ལས་བྲམ་ཟེ་བདུན་གྱིས་མཛུབ་མོ་གཉིས་བསྒྲུངས་ཏེ་དོན་གཉིས་ལུང་བསྟན་ནོ།",
    "མཛུབ་མོ་གཅིག་བསྐྱངས་ཏེ་འདི་ལྟར་ལུང་བསྟན་ནོ།",
    "དེའི་ཕྱིར་མཛུབ་མོ་གཅིག་བསྒྲེངས་ཏེ་འདི་ལྟར་ལུང་བསྟན་ནོ།",
    "དེནས་བྲམ་ཟེ་དེ་རྣམས་རང་གི་ཁྱིམ་དུ་འ་གྲོ་ཞི་དེབ་རྣམས་བོས་ཏེ།",
    "རྒྱལ་པོ་ཆེན་པོ་ཟས་གཙང་གི་སྲས་ཐམས་ཅད་མཁྱེན་པ་ཐོབ་པར་གྱུར་བན་བདག་ཅག་དང་མཇལབར་འགྱུར་རམ་མི་འགྱུར་ཆམེད་ཀྱིས།",
    "ཁྱོད་དེའི་སྲས་ཀྱིས་ཐམས་ཅད་མཁྱེན་པ་ཐོབ་པར་གྱུར་ནས།",
    "སྐྱེསབུཆེན་བོ་རབ་ཏུ་བྱུང་ངོ་ཞེས་ཐོས་ནས་བྲམཟོའི་བུའི་གནས་སུ་ཉེ་བར་སོང་ངོ་ཞེས་སྨྲས་སོ།",
    "གཞན་ཡང་དེའི་ཚེ་རྒྱལ་པོ་འདི་སྐད་དུ་གང་མཐོང་ནས་བདག་གི་བུ་རང་ཏུ་འབྱུང་ཞེས།",
    "རྒྱལ་པོས་འདི་རྣམས་བཟུང་ནས་འདི་ལྟ་བུའི་ཚུལ་བདག་གི་དུ་དང་ཉེ་བར་འོང་དུ་མ་འཇུག་ཅིག།",
    "དེའི་ཉིན་ལ་ཡང་བཀྲ་ཤིས་བའི་གནས་སུ་འདུས་པའི་རིགས་ཀྱི་འདུ་སྟོང་ཕྲག་བརྒྱད་ཅུ་པོ་རེ་རེའི་བུ་བརྒྱ་ཡོངས་སུ་སྟ་བར་བསམས་སོ།",
    "གླང་གི་རྭ་གཉིས་ལ་གསེར་གྱིས་བསྐུས་སོ།",
    "གཞིས་ཁགི་གནས་ནི་ཤིང་འ་ཛམྦུ་གཅིག་ལ་ལོ་མ་མང་པོས་གྲིབ་མ་སྟུག་པོར།",
    "གྱུར་བ་ཞིག་ཡོད་པའི་འོག་ཏུ་གཞོན་ནུའི་མལ་སྟན་ཆེན་པོ་བྱས་ནས་སྟེང་དུ་བླ་རེས་གསར་གྱི་སྐར་མ་དང་མཚུངས་པ་ཟོས་ཏེ།",
    "འཕྲུལ་མཐོང་མ་སོང་སྟེ་རྒྱལ་པོ་ལ་ཞུས་སོ།",
    "བུ་ཁྱོད་ཀྱི་ཉེ་དུ་རྣམས་དོན་གྲུབ་བཟོ་རུང་ཟད་ཀྱང་མི་སློབ་ཅིང་རྩེད་མོས་གཤགས་ནས་འགྲོའོ་ཞེས་ཟེར་རོ།",
    "གཞུ་ཐོགས་པས་འདུས་པར་བྱས་ནས་སྐྱབོ་མང་པོའི་ནང་དུ་གཞན་གཞུ་ཐོགས་པ་དང་ཐུན་མོང་མ་ཡིན་པ་ཉེ་དུ་རྣམས་ལ་བཟོ་བཅུ་གཉིས་བསྟན་ནོ།",
    "སླར་ཡང་བཟློག་ནས་རང་གི་ཁང་བཟངས་སུ་གཤེགས་སོ།",
    "སླར་ཡང་བསྲུང་བ་སྤེལ་ཏེ་ཀུན་ནས་བསྐོར་བར་དཔག་ཚད་གཅིག་གི་ཚོད་ལ་བསྲུང་བ་བཞག་གོ།",
    "སླར་ཡང་ཉི་མ་གཞན་ལ་སྤྱོད་མོས་ཚལ་དུ་གཤེགས་པ་ན་དེ་བཞིན་དུ་ལྷས་སྤྲུལ་བའི་གོས་བཟང་པོ་ལེགས་པ་གྱོན་བའི་རབ་ཏུ་བྱུང་བ་ཞིག་གཟིགས་ནས།",
    "དེ་ལ་ཉིན་མོའི་ཆར་རྩི་ཞིང་བཀྲ་ཤིས་པའི་རྫིང་བུར་ཁྲུས་བྱས།",
    "གང་ཞིག་བདག་གི་གནས་འདོར་བའི་སེམས་སུ་ཞིག་ལ་སྐྱེས་པར་གྱུར་ཅེས་བརྟགས་སོ།"
  ]
}