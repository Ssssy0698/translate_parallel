    "རྫས་རྒོད་ཤམ་འདི་མཁས་གྲུབ་ཕྱག་ལེན་ལགས།",
    "འདས་ཏེ་འཇིག་རྟེན་པའི་མེ་ལྷ་བསྐྱེད་ཅིང་སྤྱན་དྲངས་ཏེ་མཆོད་བསྟོད་བསྲེག་རྫས་སྤྱི་དང་ཁྱད་པར་ལིངྒ་འབྲུ་ཁུང་བཅས་བསྐྱེད་ཅིང་དགུག་འདྲེན་བསྒྲལ་བའི་ལས་ལས་བྱས་ཏེ་དྲག་པོའི་ཐུན་རྫས་གཞན་རྣམས་དང་ལྷན་ཅིག་ཏུ་ཕུལ་ཏེ།",
    "གནས་དང་ཡོ་བྱད་རྣམས་ལ་རྡོ་རྗེའི་རྩེས་ནང་མཆོད་འཐོར་ཚུར་བྱས་ལ།",
    "གདུག་པ་ཅན་ཐམས་ཅད་སྐད་ཅིག་ལ་འཇོམས་པའི་ནུས་པ་དང་ལྡན་པར་གྱུར།",
    "དེའི་དབུས་སུ་པཾ་ལས་པདྨ་དང་རཾ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རཾ་ལས་བགྲང་ཕྲེང་རཾ་གྱིས་མཚན་པ་ལས་འོད་ཟེར་འཕྲོས་འདུས་ཡོངས་སུ་གྱུར་པ་ལས་མེ་ལྷ་རབ་ཏུ་ཁྲོས་པའི་གཟུགས་ཅན་ར་སྐྱེས་ཁམ་བུའི་སྟེང་ན་བརྐྱང་བསྐུམ་ཁྲོ་འཁྲུགས་རྔམ་པའི་རོལ་པས་བཞུགས་པ།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཁར་ཧ་ཱུྃ།",
    "འབར་བའི་ནང་དུ་བཞུགས་ནས་བརྟན་པར་བཞུགས།",
    "སྐྱོན་ཐམས་ཅད་དག་པར་བྱས།",
    "ཞེས་པའི་རྗེས་སུ་གཞན་ཡང་མི་བསྐྱོད་པར།",
    "མུ་ཁྱུད་རྡོ་རྗེ་རྭ་བས་རྣམ་པར་སྤྲས།",
    "དཀྱིལ་འཁོར་ཡོངས་སུ་རྫོགས་པར་བཛྲ་ས་མཱ་ཛ་འི་བར་གྱི་ཞི་བ་བཞིན་ལས།",
    "དེ་ནས་འཐེན་རྐང་གཉིས་ཆེ་བ་གཅིག་བྱས་ལ་བཞག་འདི་ནས་ཤུར་ཏེ།",
    "རྡོ་རྗེ་ཕུར་པའི་སྲུང་མར་ཞལ་བཞེས་པའི།",
    "ལ་ལ་ནམ་མཁའི་མཐའ་ལྟར་ཁྱབ་པར་གནས།",
    "འོན་ཀྱང་རྫས་སྔགས་རྣམས་མི་བརྗོད་པར།",
    "དེ་ནས་ཁྱད་པར་གྱི་རྫས་ལིངྒ་འབྲུབ་ཁུང་བཅས་བསྐྱེད་ཅིང་དགུག་འདྲེན་བསྒྲལ་བའི་ལས་བྱས་ཏེ་དྲག་པོའི་ཐུན་རྫས་གཞན་དང་ལྷན་ཅིག་ཏུ་འབུལ་བ་ནི།",
    "སློབ་དཔོན་གྱིས་རྡོ་རྗེའི་རྩེས་ནང་མཆོད་ནས་ལིངྒ་སྣོད་དང་བཅས་པ་ལ་འཐོར་ཚུལ་བྱས་ལ།",
    "དེ་ཉིད་ལ་འཇུག་འདོད་ཀྱི་བསམ་པ་དྲག་པོ་དང་ལྡན་པར་བསམ་སྟེ།",
    "གསང་སྔགས་རིག་སྔགས་གཟུངས་སྔགས་ཀྱི་ལྷ་ཚོགས་རྣམས་ཀྱི་༞ ཁྱད་པར་དུ་ཡང་བཅོམ་ལྡན་རྡོ་རྗེ་གཞོན་ནུ།",
    "ད་དགྲ་སྡང་ཞིང་གནོད་པར་བྱེད་པའི་དགྲ་བགེགས་ལོག་པར་འདྲེན་པའི་ཚོགས་ཕྱི་ནང་གསང་གསུམ་གང་ན་མཆིས་པ་དེ་དག་ཐམས་ཅད་སྐད་ཅིག་ཉིད་ལ་ཁུག་ལ་གཟུགས་དང་ལིངྒ་འདི་ཉིད་ལ་མཆིས་པར་གྱུར་ཅིག་ཅེས་བརྗོད་ཅིང་ཌཱ་རོལ་དྲག་ཏུ་བརྡུང་དྲག་དུང་བུས་དཔོན་སློབ་ཐམས་ཅད་ཀྱིས་ངག་ཏུ།",
    "ཞེས་བརྗོད་པས་རྡོ་རྗེ་འཇིགས་བྱེད་མ་རབ་ཏུ་ཁྲོས་པས་དགྲ་བགེགས་དེ་ལིངྒའི་སྤྱི་བོ་ནས་བསྟིམ་ཡན་ལག་ཐམས་ཅད་ཞགས་པ་ནག་པོས་དམ་དུ་བཅིངས་པས་སའི་ཁམས་ཉམས་པར་བྱས།",
    "གཟི་བརྗིད་ནུས་པ་སྔར་བས་ཀྱང་ཆེས་ཆེར་ལྷག་པར་གྱུར་པ།",
    "དྲིལ་བུ་དཀུ་གཡོན་པར་འགྱིང་ཞིང་བཟུང་ལ་རྔ་ཕྱིར་བརྡུང་མགོན་པོའི་དཔང་གཟུགས་ཀྱི་དབྱངས་དང་བཅས་པས།",
    "ཁྱད་པར་ཕུར་པའི་ལྷ་ཚོགས་རྣམས།",
    "བདག་ལ་དགོངས་པར་མཛད་དུ་གསོལ།",
    "དམ་ཚིག་ཅན་གྱི་སྡང་དགྲ་ལགས།",
    "འདུས་བྱས་ཟས་ཀྱི་ལོངས་སྤྱོད་བྱིན།",
    "སྣ་ཚོགས་ཐབས་ཀྱིས་ཁྲིད་བྱས་ནས།",
    "དེ་ལྟར་ལེགས་པར་གཟུང་དུ་གསོལ།",
    "དེ་ལྟར་མཁྱེན་པར་མཛད་ནས་ཀྱང་།",
    "ལྷ་དང་གཉིས་སུ་མེད་པར་བསྒོམ།",
    "དགྲ་བགེགས་ལ་བསྣུན་ཅིང་བསད་བཅད་བསྒྲལ་བའི་ལས་མཛད་པར་བསམ་ལ་སློབ་དཔོན་གྱིས་ཕུར་པ་ཀླད་ལ་བསྐོར་ཞིང་ཀཱི་ལ་ཡ་བརྗོད་ལ་དཔྲལ་བར་བསྒྲིལ་བས་སྐུའི་ལྷ་ཚོགས་མདུན་གྱི་ནམ་མཁར་སྤྱན་དྲངས།",
    "དེའི་ནང་དུ་རྩའི་དངས་མ་དར་དཀར་གྱི་སྐུད་པ་ལྟ་བུས་དྲིལ་ནས་དབུགས་ཀྱི་དངས་མ་དྲོད་ཀྱི་རྣལ་པར་གནས་ཤིང་།",
    "དེའི་ནང་དུ་འོད་ཀྱི་དངས་མ་ཉ་མིག་ཙམ་གྱི་དབུས་སུ་ཚེའི་རྟེན་སྡོམ་གྱི་རྒྱ་ལྟ་བུ་དྲིལ་ནས་རྣལ་པར་ཤེས་པའི་ངོ་བོ་ལ་དཀར་པོའི་རྣམ་པར་གནས་པ་ནི་ཀུན་གཞིའི་གནས་ལུགས་སོ།",
    "སྔར་གྱི་ཤུལ་དུ་བཏབ་པས་ཁོའི་རྣམ་པར་ཤེས་པ་ཨ་དཀར་པོ་དེ་ཕུར་པའི་རྩེ་ལ་བླངས་ཏེ་ཕུར་རྩེ་ནམ་མཁའ་ལ་བསྟན་ཏེ།",
    "བགེགས་ལ་ལོག་པར་འདྲེན་པའི་བདུད།",
    "ཟུངས་ཤིག་སྡོམས་ཤིག་རྣམ་པར་ཆིངས།",
    "ཕོབ་ཅིག་རྣམ་པར་གཟིར་བར་གྱིས།",
    "བསྒོ་བའི་བཀའ་ཉན་ནུས་པར་གྱིས།",
    "མཐུ་དང་རྫུ་འཕྲུལ་མེད་པར་མཛོད།",
    "ལུས་སེམས་རྡུལ་བཞིན་བརླག་པར་མཛོད།",
    "རྡོ་རྗེ་ཐོ་བས་བརྡུངས་བྱས་ནས།",
    "ལྷ་ཡང་རུང་སྟེ་བསྒྲལ་བར་བྱས།",
    "དེ་ནས་རོ་མ་ཐམས་ཅད་དུམ་བུ་བརྒྱ་སྟོང་ལ་སོགས་པར་གཏུབ་པ་ནི།",
    "འཇིགས་བྱེད་རྔམས་སྟབས་བརྐྱང་བསྐུམ་ཚུལ་དུ་བཞུགས།",
    "དྭངས་བའི་སེམས་ཀྱིས་འབུལ་ལོ་བཞེས་སུ་གསོལ།",
    "ཨོཾ་ཞེས་བརྗོད་པས་རྫས་རྣམས་ཀྱི་འབགས་པ་དང་མ་དག་པ་ཐམས་ཅད་བསངས་ཤིང་སྟོང་པར་སྦྱངས།",
    "ཧ་ཧོ་ཧྲཱི་ཞེས་བརྗོད་པས་རྫས་དེ་དག་ཟད་མི་ཤེས་པའི་རང་བཞིན་ཅན་དུ་གྱུར་པར་བསམ།",
    "རྫས་སྣོད་སློབ་དཔོན་གྱི་ལག་པ་གཡོན་པར་བཟུང་།",
    "བནྡྷ་འབར་བའི་སྣོད་ཡངས་པར།",
    "ཟད་མི་ཤེས་པར་བྱིན་བརླབས་འདི།",
    "རྔམས་པའི་སྟབས་ཀྱིས་འབུལ་ལགས་ན།",
    "རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་མཛོད།",
    "ཁྱེད་རྣམས་ལ་མཁྱེན་པའི་ཡེ་ཤེས།",
    "མཛད་པའི་ཕྲིན་ལས་བསམ་གྱིས་མི་ཁྱབ་པ་མངའ་བ་ལགས་ན།",
    "ཐུགས་ཀྱིས་དགོངས་པར་མ་གྱུར་ཏམ།",
