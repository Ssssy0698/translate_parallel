    "དེས་ན་དེ་ནི་རྒྱུ་གང་ལས་ཀྱང་མ་སྐྱེས་པ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་དུ་མི་གནས་པར་གྱུར་པ་དང་།",
    "རང་རང་ཚེ་འདིའི་ནོར་དང་ལོངས་སྤྱོད་སོགས་ཀྱི་དངོས་པོ་འདི་དག་ལ་ཆགས་ཤིང་ཞེན་ནས་དེ་ལ་སྤྱོད་པར་བྱས་ན།",
    "རང་རང་ལ་ཚེ་འདིར་ལྷན་ཅིག་ཏུ་བསྡད་པའི་གཉེན་ཉེ་འབྲེལ་གྲོགས་དགའ་མཛའ་སོགས་ཐམས་ཅད་རང་ལ་བཤེས་ལྟར་ཡིད་སེམས་མཐུན་ན་ཡང་ཐམས་ཅད་ཐ་མ་སོ་སོར་འབྲལ་བར་འགྱུར་བ་མ་གཏོགས་གང་ཡང་མེད་པ་ཡིན་ལ།",
    "རང་རང་ཚེ་འདི་ལ་ཇི་ལྟར་སྡོད་པའི་ཁོམ་པ་ཡོད་ན་དེའི་བར་ལ་དོན་ཡོད་ཅིང་ཕྱི་མར་རང་ཉིད་གཅིག་པུར་འགྲོ་བར་བྱེད་པའི་ཚེ་ན་ཐར་བ་བླ་ན་མེད་པ་ཐོབ་པའི་འབྲས་བུ་དང་བཅས་པ་ཡིན་ལ།",
    "ནམ་ཡང་རང་རྒྱུད་ལ་ངེས་འབྱུང་སྐྱོ་ཤས་དྲག་པོས་བསྐུལ་ནས་འབད་བརྩོན་བྱེད་པར་བྱ་དགོས།",
    "ནམ་ཡང་རང་རྒྱུད་ཀྱི་དྲི་མ་མཐའ་དག་བསལ་བར་བྱས་ནས།",
    "དེ་ལ་ཐོག་མ་སྐྱེ་བ་དང་བར་དུའམ་དབུས་སུ་གནས་པ་དང་ཐ་མར་འགག་པ་སོགས་གང་ཡང་བདེན་པར་གྲུབ་པ་མེད་པ་དང་རང་བཞིན་གདོད་མ་ནས་རྣམ་པར་དག་པ་ཡིན་པར་ཤེས་པར་བྱ་དགོས་པ་ཡིན་ནོ།",
    "དེ་དག་ལ་ཕྱི་གཟུང་བའི་ཡུལ་ཡང་རང་བཞིན་གྱི་དངོས་པོ་གང་ཡང་གྲུབ་པ་མེད་པ་དཔེར་ན་སྤྲུལ་པ་དང་མིག་ཡོར་བཞིན་དུ་སྣང་བ་དང་།",
    "ཐ་སྙད་དུ་དགེ་དང་མི་དགེའི་སྣང་བ་ཡིད་ཀྱི་བསམ་མཁན་དེ་བཙལ་ན་ཁོ་རང་ཡིན་པར་ངེས་པ་ལ།",
    "སེམས་ཞེས་བྱ་བ་དེ་ཉིད་ནི་ནམ་ཡང་འཕྲོ་བའི་འཕྲོ་ས་མི་འདུག་ན་ཡུལ་ཡང་རང་སེམས་ལས་གཞན་དུ་མེད་པར་ངེས་སོ།",
    "ཡུལ་དུས་གང་ན་ཡང་ལྟ་མཁན་ཁོ་རང་ཇི་ལྟར་བཙལ་བས་མ་རྙེད་པ་ཡིན་པར་ངེས་པས་སོ།",
    "མ་ཟད་དེ་ལྟར་གཅེར་མཐོང་རང་གྲོལ་འདི་ཉིད་རབ་ཏུ་ཟབ་པར་འགྱུར་བ་ཡིན་ལ།",
    "སྒོམ་ཆེན་པ་བཟང་པོ་ཁ་ཤས་བྱུང་མྱོང་འདུག།",
    "ཞེས་པའི་ཡིག་འབྲུ་དེ་དག་ཆེན་པོ་ཞིག་བྲིས་པ་ད་དུང་མིག་ལམ་དུ་གསལ་པོར་འཆར་རྒྱུ་འདུག།",
    "འོན་ཀྱང་དེ་ཉིན་ཅི་ཡིན་མི་ཤེས་པ་ཞིག་ལ་ང་རང་བྲེ་མའི་ཚལ་ཞིག་ནས་གཉིད་ལ་ཤོར་ནས་ཕལ་ཆེར་ཉི་མ་ནུབ་རག་བར་མ་སད་པ་དང་།",
    "དེའི་རྗེས་སུ་ང་རང་ད་དུང་སྔོན་མ་ནང་བཞིན་རྣམ་རིག་གསལ་བོ་མི་འདུག་པས།",
    "ན་མཉམ་གྱི་བྱིས་པ་ཚང་མ་ལོ་རིམ་བཞི་བར་སླེབས་འདུག་པས།",
    "གལ་ཏེ་ནན་ཏན་གྱིས་རང་ཉིད་ལ་གཤགས་བཅོས་དང་རང་ཉིད་ངོས་འཛིན།",
    "ཨ་རག་འཐུང་ཚད་ཆེ་བའི་སྐབས་སུ་ཉིན་ཁ་ཤས་ལ་ཉལ་ནས་འདུག་ཅིང་།",
    "རླངས་འཁོར་ཁ་ལོ་པ་དང་གཞན་དག་ཚོ་ག་བྱེད་འདི་བྱེད་མེད་པར་གྱུར་འདུག།",
    "གྱོད་ཁ་མཆུ་ཐུག་དུས་ཁ་ལྕེ་མེད།",
    "ཚིག་དང་དོན་གྱི་འགྲེལ་བར་བསླབས་ཀྱང་རང་རྒྱུད་ལ་ལེན་པར་ད་དུང་དཀའ་ཙམ་དུ་གདའ་ན།",
    "སྐབས་བསྡུ་བ་བཅས་གཞན་ལུགས་དགག་ཅིང་རང་ལུགས་བཞག་པའི་ཚུལ་གྱིས་འགྲེལ་པར་མཛད་དོ།",
    "ཁམས་གང་དུ་འཐོབ་ཚུལ་སོགས་ཁ་ཅིག་དང་རང་ལུགས་ཐོག་ནས་ཆ་ཚང་བ་ལེགས་པར་བཀྲལ།",
    "ཉིན་མཚན་འགྲོ་འདུག་གང་ལ་ཡང་ངག་ནས་ཤར་ཤར་གྱེར་རྒྱུ་བྱུང་ན་རྩོམ་པའི་ཐོག་མའི་དུས་ལ་ཕན་ཐོགས་ངེས་ཅན་ཞིག་འབྱུང་ཞིང་།",
    "རྒྱུ་ཆ་འཚོལ་སྡུད་སོགས་བཟང་ཕྱོགས་ཀྱི་དགེ་མཚན་མི་དམན་པ་འདུག་ན།",
    "༡༤རང་ཅག་སོ་སྐྱེ་ཐ་མལ་བའི་གང་ཟག་རྣམས་ལ་ཁྲོ་བ་མེད་པ་སྲིད་མཐའ་ཙམ་དུ་འདུག་སྟེ།",
    "ཁ་ཅིག་ནོར་སྒྲུབ་པར་འདུག།",
    "ཁ་ཅིག་དཔོན་ལ་རྟེན་ནས་མི་ཚུགས་སྒྲུབ་པར་འདུག་སྟེ།",
    "ལེགས་ཀྱང་ལེགས་པར་འདུག་པས་ཐག་རྦད་དེ་བཅད་པ་ཡིན།",
    "མ་གཞི་ནས་མི་རྟག་སྟོང་བ་སྡུག་བསྔལ་གྱི་རང་བཞིན་དུ་གསུངས་པས་དུས་ཚོད་ཀྱིས་ཡོད་ཚད་ར་སྤྲོད་བྱེད་ཀྱིན་འདུག།",
    "དེ་ལས་བློ་ཕམ་པ་མི་འདུག།",
    "སུ་ལ་ཕོག་འགྲོ་མ་བསམ་ས་ནས་ཕོག་ཐུག་བཟོས་པ་ཧ་ཅང་མང་པོ་འདུག།",
    "དེས་ན་མང་པོ་ཉོས་པས་གོ་མི་ཆོད་ཅིང་ཉུང་ཉུང་ཀློག་རྒྱུ་གལ་ཆེ་འདུག།",
    "ག་དུས་ཡིན་རུང་མི་ཞིག་ཡིན་ཕྱིན་རང་ཉིད་ཀྱི་བསམ་ཚུལ་གྱི་བྲན་གཡོག་བྱེད་མི་རུང་བ་དང་།",
    "དེ་ཡང་རང་ཅག་འགྲོ་བ་མི་ཞིག་ལ་མཚོན་ན་ཟས་ཟ་ཤེས་པ་དང་གོས་གྱོན་ཤེས་པ།",
    "ཞེས་བཀོད་འདུག།",
    "ད་ལྟ་བཞེངས་བཞིན་པའི་ལྷ་ཁང་ཡང་འདུག།",
    "དུས་ཕྱིས་སུ་འབྲུག་རྒྱལ་རྒྱལ་པོའི་དབུ་བླ་དུས་འཁོར་མཁྱེན་བརྩེ་སོགས་སྐྱེས་ཆེན་མང་པོ་བྱོན་ཡོད་འདུག།",
    "ཡུལ་འདིའི་མི་རྣམས་བློ་རིག་བཀྲ་ཞིང་དགེ་ལ་གཞོལ་བ་དང་འཚོ་བ་ཞིང་ལས་ཕྲན་བུ་བྱེད་པ་དང་གཙོ་བོ་ཕྱུགས་ལས་ལ་བརྟེན་པ་ཡིན་འདུག།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "སྐུ་གསུང་ཐུགས་རྟེན་རྣམས་ཀྱང་གནའ་སྲོལ་མ་ཉམས་པ་མང་པོ་བཞུགས་འདུག།",
    "མཁའ་དབུགས་ཀྱང་དྭངས་པས་བག་ཕེབས་པ་ཞིག་འདུག།",
    "བར་བར་དག་ཏུ་དོས་སྐྱེལ་རླངས་འཁོར་ཆེ་བ་ཁ་ཤས་མཉམ་དུ་བགྲོད་བཞིན་པས་ལམ་རྒྱ་ཆུང་བར་བརྟེན་ཕན་ཚུན་ལམ་གཟུར་དུས་གཟབ་དགོས་པར་འདུག།",
    "ཆབ་སྲིད་ཀྱི་ལྟེ་བ་ཡིན་པའི་ཆ་ནས་དཀར་མཛེས་དང་བསྡུར་ན་མི་ཚོགས་མང་པོའི་འདུ་འགོད་ཀྱང་མི་འདུག།",
    "ལྷ་ཁང་དེ་ནི་ཧ་ཅང་རྙིང་པ་ཞིག་ཏུ་འདུག།",
    "ཞེས་པའི་བསྟོད་ཚིག་ཅིག་ཀྱང་ཕུལ་འདུག།",
