    "བྱས་པ་མི་རྟག་པ་ཁོ་ན་ལ་འཇུག་པར་མ་ངེས་པའི་ཕྱིར་ཅེ་ན།",
    "རྣམ་འགྲེལ་མཛད་པས་མི་དམིགས་པ་ཐམས་ཅད་ནི་མེད་པ་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཅིག་ལོག་པས་གཞན་ལྡོག་པར་འདོད་པས་ནི་དེ་གཉིས་རང་བཞིན་འབྲེལ་བ་འགའ་ཞིག་ཀྱང་འདོད་པར་བྱ་དགོས་སོ།",
    "ཚིགས་གོ་བར་བྱེད་པ་མ་ཡིན་པར་འགྱུར་རོ་ཞེས་དང་།",
    "འབྲེལ་བ་མེད་པར་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པ་མེད་དེ།",
    "ཡང་མེ་དུའི་རྗེས་འགྲོ་མངོན་སུམ་གྱིས་ངེས་ཀྱང་གཞི་འགར་མེ་ཡོད་མེད་ཀྱི་ཐེ་ཚོམ་ལྡོག་པར་བྱེད་པ་ལ་འབྲས་བུའི་གཏན་ཚིགས་དགོས་སོ།",
    "མི་རྟག་པ་ལོག་པའི་སྟོབས་ཀྱིས་བྱས་པ་ལྡོག་པའི་ཚུལ་ནི་མི་རྟག་པ་ལོག་པའི་གཞི་ལ་བྱས་པ་འགོག་པའི་གནོད་པ་ཅན་གྱི་རྟཊ་ལ་བརྟེན་ནས་བསྒྲུབ་པ་ཡིན་ཏེ།",
    "རྟགས་ཀྱི་མཚན་གཞི་བྱས་པ་ལྟ་བུ་གཞིར་བཟུང་ནས་དེ་ཉིད་མཐུན་ཕྱོཊ་ཁོ་ན་ལ་ཡོད་པར་ངེས་པ་དང་།",
    "གལ་ཏེ་རྟག་པ་བྱས་སྟོང་དུ་ངེས་ན་བྱས་པ་མི་རྟག་པ་ཁོ་ན་ལ་འཇུག་པ་༢ ༣ན་མ་ངེས་པ་འགལ་བས།",
    "རྟག་པ་བྱས་སྟོང་དུ་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་པའི་ཕྱིར།",
    "གནོད་པ་ཅན་གྱི་རྗེས་དཔག་སྐྱེས་ཤིང་བསྒྲུབ་བྱ་མ་ངེས་པའི་ཕྱིར་རྒོལ་དེ་རྟག་པའི་གསལ་བའི་དབྱེ་བ་འགའ་ཞིག་ལ་བྱས་པ་འཇུག་པར་དོགས་སམ་མི་དོགས།",
    "རྟོགས་ཟིན་གྱི་དོན་ལ་འཇུག་པར་ཡང་ཁས་ལེན་དགོས་ཏེ།",
    "ངེས་ན་བྱས་པ་ཡིན་ན།",
    "དེ་ལྟ་ན་རྗེས་༢༤ན་ཁྱབ་ངེས་པ་ན་དགག་བྱ་ཁེགས་པར་འགྱུར་རོ།",
    "ཤེས་བྱ་ཇི་སྙེད་ཡོད་པའི་གྲངས་དང་མཉམ་པའི་རྟག་པ་ཡང་དེ་སྙེད་ཡོད་པས་སྒྲ་རྟག་པས་སྟོང་པར་རྟོཊ་པའི་རྗེས་དཔག་སྐྱེས་པ་ན་རྟག་པ་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "ཙམ་གྱིས་སྟོང་པར་ངེས་ཀྱང་།",
    "སྒྲ་དེ་སྒྲ་མ་ཡིན་ཙམ་ལས་ལོག་པར་གོ་ཡང་སྒྲ་མ་ཡིན་པའི་བུམ་པ་དང་སྣམ་བུ་སོགས་ལས་ལོག་པར་མ་གོ་བས་མཐའ་གཅིག་ཏུ་སྒྲ་ཁོ་ནར་མི་ངེས་པར་འགྱུར་རོ་ཞེས་སྨྲས་ན་ལན་ཅི་ཡོད།",
    "གཞི་སྒྲ་ལ་རྟག་པ་ཙམ་དུ་འཛིན་པའི་སྒྲོ་འདོགས་ཆོད་ན་རྟག་པའི་ལྡོག་པས་ཁྱད་པར་དུ་བྱས་པའི་རྟག་པའི་གསལ་བའི་དབྱེ་བ་མཐའ་དག་ལ་དམིགས་པའི་སྒྲོ་འདོགས་༢༤བ་ཆོད་དགོས་ལ།",
    "གཞན་དུ་ན་ཚུ་རོལ་མཐོང་བས་ཡུལ་གང་ལ་ཡང་སྒྲོ་འདོགས་ཆོད་པ་མི་སྲིད་པར་འགྱུར་ཞིང་།",
    "རྟགས་མ་མཐོང་ཙམ་གྱིས་ལྡོག་ཁྱབ་འགྲུབ་པར་འདོད་པའི་གཞུང་ལེགས་པར་བཙུཊ་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྣམ་པ་ཀུན་ཏུ་མཚུངས་པས་ཁྱེད་ཀྱིས་ལེགས་པར་ཕྱེ་ཞིག།",
    "རྟགས་གྲུབ་ན་བསྒྲུབ་བྱ་ལ་ཐེ་ཚོམ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྟག་ན་བྱས་པ་མ་ཡིན་པའི་ཁྱབ་པ་ངེས་ན་བྱས་པ་ཡིན་ན་མི་རྟག་པ་ཡིན་པའི་ཁྱབ་པ་ངེས་པར་འགྱུར་བས།",
    "རྟག་པར་ངེས་ན་མ་བྱས་པར་ངེས་དགོས་ན་བྱས་པར་ངེས་ན་མི་རྟག་པར་ངེས་དགོས་པར་འདོད་ཀྱི།",
    "རྟག་ན་མ་བྱས་པའི་ཁྱབ་པ་ངེས་ན་བྱས་ན་མི་རྟག་པའི་ཁྱབ་པ་ངེས་དགོས་པར་མི་འདོད་དོ།",
    "འཐད་པའི་ཕྱོགས་རྣམ་པར་བཞག་པའོ།",
    "མི་མཐུན་སྦྱོར་གྱིས་དངོས་སུ་བསྟན་པའི་རྟག་ན་མ་བྱས་པས་ཁྱབ་པ་མི་མཐུན་དཔེའི་སྟེང་དུ་གྲུབ་པར་བསྟན་པ་ལྡོག་ཁྱབ་ཀྱི་མཚན་གཞི་ཡིན་གྱི།",
    "ཚུལ་གསུམ་གྱི་མཚན་ཉིད་དུ་ངེས་པ་སྨོས་པར་འདོད་པ་ནི་རྣམ་པར་འཁྱམས་ཏེ།",
    "བྱས་པ་འདུས་མ་བྱས་ཀྱི་ནམ་མཁའི་སྟེང་དུ་བུམ་པ་འགོག་པའི་རྟཊ་སུ་ཁས་བླངས་པ་ལ་ཉེས་པ་མེད་པར་འགྱུར་རོ།",
    "བྱས་པ་མཚན་གཞིར་བཟུང་ནས་སྒྲ་མི་རྟག་སྒྲུབ་ཀྱི་རྟགས་ཡང་དག་ཏུ་མཚོན་པ་ལ།",
    "མི་མཐུན་དཔེ་ཁོ་ན་ལ་གྲུབ་པའི་ལྡོག་ཁྱབ་ཀྱི་མཚན་གཞི་དེ་གང་ཡིན་རྟག་ན་མ་བྱས་པས་ཁྱབ་པའི་ཁྱབ་པ་དེ་ཡིན་ནོ་ཞེ་ན།",
    "རྟག་ན་མ་བྱས་པས་ཁྱབ་པའི་ཁྱབ་པ་དེ་འདུས་མ་བྱས་ཀྱི་ནམ་མཁའ་ཁོ་ན་ལ་ཡོད་པ་ཉམས་ཏེ།",
    "མི་མཐུན་དཔེ་ལ་ཁྱབ་པ་གཉིས་དངོས་ཤུཊ་ལ་གཞལ་བའི་དོན་མིན་གྱི་ལྡོག་ཁྱབ་མི་མཐུན་དཔེ་ལ་ཡོད་པར་དངོས་སུ་གཞལ་ན་རྗེས་ཁྱབ་གཞི་གཞན་མཐུན་དཔེ་ལ་ཡོད་པར་ཤུགས་ལ་གྲུབ་པའི་དོན་ཡིན་ནོ་ཞེ་ན།",
    "བྱས་པ་ཚུལ་གཉིས་ཀའི་མཚན་གཞིར་རུང་ངོ་ཞེ་ན།",
    "པར་བལྟོས་ཏེ།",
    "བྱས་པ་གཞིར་བཟུང་བའི་སྟེང་དུ་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པ་དང་།",
    "མི་མཐུན་ཕྱོགས་ལ་མེད་པར་བསྟན་དགོས་ཀྱི།",
    "འོ་ན་རྟག་ན་མ་བྱས་པས་ཁྱབ།",
    "དེས་རྟག་པ་ལ་བྱས་པ་མེད་པར་བསྟན་པའི་ཕྱིར་ཅེ་ན།",
    "སྒྲས་ནི་བྱས་པ་དངོས་སུ་བརྗོད་ནས་རྟག་པ་ལ་དེ་མེད་པར་བརྗོད་པ་ཉིད་ཀྱིས་དེ་ཉིད་རྟག་པ་ལ་མེད་པར་གོ་བར་བྱེད་དོ།",
    "མཐུན་དཔེའི་སྟེང་དུ་རྗེས་ཁྱབ་གྲུབ་པར་རྟོགས་པ་ན་མི་མཐུན་དཔེའི་སྟེང་དུ་ལྡོག་ཁྱབ་གྲུབ་པར་ཤུཊ་ལ་རྟོགས་པ་མི་འཁྲུལ་བའི་དོན་ཡིན་ནོ་ཞེ་ན།",
    "ཡོད་དང་མེད་ལ་མེད་པར་ནི།",
    "ངེས་པ་ཞེས་གསུངས་པ་ནི།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ནི་ཕན་ཚུན་རྣམ་པར་གཅོད་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་པ་ནི།",
    "དེ་མ་སྨོས་ཀྱང་རྟོགས་པར་འགྱུར་བའི་ཕྱིར།",
    "གལ་ཏེ་ཇི་ལྟར་སྒྲུབ་ངག་དེས་འབྲེལ་བ་བརྗོད་པ་དེའི་ཚེ་དེ་ལ་བརྟེན་ནས་མི་༢༨བ་མཐུན་ཕྱོགས་ལ་མེད་ཅེས་བྱ་བར་རྟོགས་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བས་ལྡོག་ཁྱབ་གྲུབ་པར་འགྱུར་ན།",
    "ཤིང་ཕུང་འདི་ལས་སྐྱེས་པར་མཚུངས་པའི་ཕྱིར།",
    "གནོད་པ་མེད་པར་ངེས་པ་ལ་བྱེད།",
    "བསྒྲུབ་བྱ་གྲུབ་ཟིན་པརྟགས་ཀྱི་མཚན་ཉིད་དུ་དོན་མེད་དོ།",
    "སྐབས་འདི་དག་ཀུན་བརྟགས་ཀྱི་ཚུལ་གསུམ་དུ་ངེས་པར་བསྒྲུབ་པ་ལ་གཞོལ་བ་ཡིན་ནོ།",
    "བདག་དང་བཅས་པར་རྟོགས་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ལ་མ་མཐོང་ཙམ་ཡོད་ཀྱང་ལྡོག་ཁྱབ་མི་འགྲུབ་ཅེས་དགག་པར་མཛད་དོ།",
    "ཐེ་ཚོམ་མི་ཟ་ན་དེ་ལ་ཡོད་པའམ་མེད་པར་འགྱུར་བའི་ཕྱིར།",
    "གང་ཡང་རུང་བ་ལ་གྲུབ་པ་དང་ཐེ་ཚོམ་ཟ་བ་བརྗོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "མི་མཐུན་དཔེ་གཞི་མ་གྲུབ་པ་བཞི་གསུངས་པ་ཇི་ལྟར་རིགས་པར་དཔེ་དོན་དུ་སྦྱར་ཏེ་སྔ་མ་གསུམ་སྦྱར་ལ།",
    "དེ་བཞིན་དུ་མཐུན་པའི་ཕྱོགས་ལ་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་དག་ལ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ་ཞེས་གསུངས་པའི་དོན་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "གང་རུང་ལ་མ་གྲུབ་པ་སོགས་ཡིན་ན་གཞན་དོན་སྐབས་ཀྱི་རྟགས་ཡང་དག་མིན་པར་བསྟན་ལ།",
    "མཉན་བྱ་མི་རྟག་པ་ཁོ་ན་ལ་གནས་ཀྱི་རྟག་པ་ལ་ནམ་ཡང་༣༡ན་མེད་པའི་ཕྱིརགཞན་དུ་ན་སྒྲ་ཡང་མི་རྟག་པར་མི་འགྲུབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་རྨོངས་པ་ལ་འབྲེལ་བ་སྟོན་པ་དཔེ་ལ་བལྟོས་པ་ཡིན་གྱི་མཁས་པས་ནི་དཔེ་མེད་པར་ཡང་།",
    "མཉན་བྱ་མི་རྟག་པར་ངེས་ན་སྒྲ་ཡང་མི་རྟག་པར་ངེས་དགོས་པའི་ཕྱིར་རོ།",
    "མཉན་བྱས་སྒྲ་ལ་རྟག་མི་རྟག་གཉིས་ཀ་འགོག་མི་ནུས་ཏེ།",
    "མཉན་བྱ་རྟག་མི་རྟག་གཉིས་ཀ་ལ་མ་མཐོང་ཡང་མེད་པར་མི་འགྲུབ་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་བྱས་པ་ལྟ་བུའི་རྟགས་གཞན་ལ་ཡང་མ་མཐོང་ཙམ་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ། ཆེ་",
    "གྱིས་ལྡོག་ཁྱབ་གྲུབ་པར་འདོད་པ་ལ།",
    "ཅད་མཁྱེན་པའི་ཚད་༣༣ན་མ་ལ་ཡང་ཡིད་བརྟན་མི་རུང་བར་དགོངས་ནས་རྣམ་འགྲེལ་མཛད་པས།",
    "མཚན་ཉིད་དང་ལྡན་པ་གཅིག་ལ་གནོད་པ་སྲིད་ན་དེའི་མཚན་ཉིད་ཐམས་ཅད་སུན་ཕྱུང་བ་ཁོ་ནར་གྱུར་པས་ཐམས་ཅད་ལ་ཡིད་བརྟན་དུ་མི་རུང་ངོ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་མ་མཐོང་བ་ཙམ་གྱིས་མཐོང་བ་དག་ལ་འགོག་པར་བྱེད་ན་དེ་ེ་ཡང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བཀག་པ་མི་རིགས་པར་འགྱུར་རོ།",
    "གང་ཡང་གལ་ཏེ་མ་མཐོང་བ་ཙམ་གྱིས་མི་སྣང་བ་དག་ལ་འགོག་པར་བྱེད་ན་དེ་ཡང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དེས་ནི་ས་ལ་སོགས་པ་སྤྱིར་བཟུང་ནས་དགག་པ་སྨྲས་སོ་ཞེས་གསུངས་ཏེ།",
    "ཡུལ་དང་དུས་དང་སོ་ནམ་ལ་སོགས་པའི་འདུ་བྱེད་ཀྱི་ཁྱད་པར་ལ་སྐྱུ་རུ་རའི་རྫས་ལ་རོ་མངར་སྐྱུར་དང་ནུས་པ་ཆེ་ཆུང་ཐ་དད་པ་མངོན་སུམ་ལ་སྣང་བའི་ཕྱིར།",
    "རྟགས་དེའི་ལྡོག་ཁྱབ་གྲུབ་པའི་སྐབས་ཡོད་པར་ཁས་ལེན་དགོས་ལ།",
    "གསོན་ལུས་ལ་བདག་དང་ས་ལ་ཤེས་པ་དང་སོགས་པ་འོ་མ་ལ་ཞོ་མ་དམིགས་ཀྱང་དེ་དག་མེད་པར་རབ་ཏུ་སྒྲུབ་པར་བྱེད་ནུས་པ་མིན་པའི་ཕྱིར།",
    "བྱེ་བྲག་པ་གསོན་ལུས་ལ་བདག་མ་མཐོང་ཡང་ཡོད་པར་འདོད་ཅིང་།",
    "སྲོག་ལྡན་དེ་སྒྲུབ་ཀྱི་མི་མཐུན་པ་ལ་མ་མཐོང་བས་མེད་པ་འགྲུབ་པར་འདོད་པ་འགལ་བ་དང་།",
    "༣༤གྲངས་ཅན་འོ་མ་ལ་ཞོ་མ་མཐོང་ཡང་ཡོད་པར་འདོད་པ་དང་།",
    "ཁྱབ་པ་འགྲུབ་པ་རྟགས་མི་མཐུན་པ་མཐའ་དག་མེད་པར་ངེས་པ་ལ་བལྟོས་པར་གྲུབ་པ་དང་།",
    "ཁྱབ་པ་འབྲེལ་བ་ལ་བལྟོས་པར་གྲུབ།",
    "ཡོད་ན་དམིགས་སུ་རུང་བ་ལས་མ་དམིགས་པའི་ཕྱིར་ཅེས་པར་འགྱུར་ལ།",
    "དེས་ན་མ་མཐོང་བས་ལྡོག་ཁྱབ་གྲུབ་པོ་ཞེས་འདོད་པ་རྒྱས་པར་བཀག་ནས།",
    "འམ་༣༥ན་སྒྲས་རྒྱུ་ལོག་པ་ཡིས་ནི་ངེས་པར་འབྲས་བུ་ལྡོག་པར་བྱེད་དེ།",
    "ངེས་པར་ཞེས་པ་ནི།",
    "མི་མཐུན་ཕྱོགས་ཡིན་ན་ཕྱིར་རྒོལ་གྱིས་གྲུབ་པས་༣༥བ་ཁྱབ་པར་མི་འདོད་པ་ཡིན་གྱི་གྲུབ་པའང་ཡོད་ཅེས་པའོ།",
    "ཞེས་པ་ལ་འཕྲོས་ནས་སྔར་ལྟར་དོགས་པ་གཅོད་པ་ཡིན་གྱི་གང་དག་མི་མཐུན་དཔེ་ནི་དཔེར་བཀོད་པ་ཁོ་ན་ལ་བཟུང་ནས་དེ་རྫས་སུ་གྲུབ་པ་ལ་བལྟོས་མི་དགོས་པར་བསྒྲུབ་པ་དེའི་དོན་མིན་ཏེ།",
    "དེ་ལ་མེད་པར་ངེས་པ་ལ་འབྲེལ་བ་བསྒྲུབ་པ་དགོས་པ་དང་བཅས་པ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "འབྲེལ་བ་དང་རྟཊ་ཀྱི་ཚུལ་དུ་གྱུར་པའི་ཁྱབ་པ་ངེས་དཀའ་སླ་མེད་པར་དོན་གཅིག་ཏུ་འདོད་པ་དེ་ལ།",
    "དེ་ལ་ཁྱབ་པ་གཉིས་ཀ་བརྗོད་མི་དགོས་ཀྱི་གང་རུང་གཅིག་བརྗོད་པས་ཆོག་པར་སྟོན་པའི་གཞུང་འོག་མ་དང་འགལ་ལོ།",
    "བརྗེད་ན་ཤེས་པར་འགལ་ལོ།",
    "སུ་སྨྲས་པས་གཉིས་པ་ཡང་ཤུཊ་ཀྱིས་གོ་བའི་ཕྱིར་གཉིས་ཀ་དངོས་སུ་བརྗོད་མི་དགོས་པར་སྟོན་པ་ཡིན་ནོ།",
    "དེ་གསུམ་ཚང་ན་ཁྱབ་པ་རྫོགས་པར་གོ་བས་དེའི་ཡན་ལག་ཏུ་བསྟན་པ་ཡིན་ནོ།",
    "བུམ་པ་ཡོད་ན་དམིགས་པར་ནི་རིགས་པ་དང་ལྡན་པ་ལས་དེ་མི་དམིགས་ཡང་གཞི་འགར་བུམ་པ་མེད་པ་གོ་བར་བྱེད་པའི་དགག་རྟཊ་ཡང་དག་ཡིན་པའི་ཕྱིར།",
    "བུམ་མེད་དོན་དུ་བྱས་ནས་དེ་ཕྱིར་རྒོལ་གྱིས་གྲུབ་ཟིན་པའི་ཐ་སྙད་འབའ་ཞིག་སྒྲུབ་ཡིན་ལའགོད་ཚུལ་ལ་ཡང་བུམ་པ་མེད་པའི་ཐ་སྙད་འཇུག་ཏུ་རུང་སྟེ།",
    "ཞེས་གསུངས་པའི་དགག་པ་ནི།",
    "ཡང་འདིར་བསྟན་པ་རྣམས་འགལ་བ་དང་ཟློས་པར་ཇི་ལྟར་མི་འགྱུར་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་གཅིག་ཅེས་བྱ་བ་ཉིད་དུ་མི་འགྱུར་བའང་མིང་ཐ་དད་པར་ཟད་དེ།",
    "རྒྱུ་ཐམས་ཅད་ཀྱིས་འབྲས་བུ་ཐམས་ཅད་ལ་ཕན་འདོགས་པར་འགྱུར་བས།",
    "ཡོན་ཏན་གསུམ་གྱི་རང་བཞིན་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཡོན་ཏན་གསུམ་གྱི་རང་བཞིན་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་འདོད་དོ་ཞེ་ན།",
    "སེར་པོའི་རང་བཞིན་དེ་ཉིད་སྔོན་པོའི་རང་བཞིན་ཡིན་པས་དངོས་པོ་ཐམས་ཅད་ཀྱི་རང་བཞིན་ཡོན་ཏན་བདེ་སྡུག་བཏང་སྙོམས་གསུམ་པོ་ཆ་མཉམ་པའི་གཙོ་བོ་དེ་ལ་ཆ་ཤས་ཅུང་ཟད་ཀྱང་མེད་པར་འདོད་པ་ལ་གནོད་པ་བརྗོད་པ་ཡིན་པས།",
    "རྒྱུ་འབྲས་ངེས་པར་བྱེད་པ་ལ།",
    "དེས་ཆུ་སྐྱོར་བའི་དོན་བྱེད་པས་སྟོང་པར་ངེས་པའི་དག་འཛིན་མངོན་སུམ་ལ་བལྟོས་དགོས་སོ།",
    "གོ་ས་མཚུངས་པར་གནས་པའི་ཆུ་དོན་གྱི་ཡུལ་གྱི་འབྲས་བུ་ཡིན་ལ།",
    "ལོག་རྟོག་སེལ་ཚུལ་རྒྱས་པར་ཤེས་པར་འདོད་པ་ལ་ཡང་བསྟན་དགོས་པ་ཡིན་གྱི།",
    "མེ་དེ་ཕན་བྱེད་དུ་མེད་པར་ནི་དེ་ཡོད་མི་སྲིད་དེ།",
    "མེ་མེད་པར་ཡང་ཡོད་པའི་ཕྱིར།",
    "གཉིས་ཀ་བརྗོད་པར་མི་རིགས་ཏེ།",
    "རྟག་ཏུ་ཡོད་ན་མེད་པར་འགལ་བས་སོ།",
    "རྒྱུ་ཡོད་པའི་རྗེས་སུ་མི་བྱེད་ན་ནམ་ཡང་མེད་པར་འགྱུར་རོ།",
    "རྟག་ཏུ་ཡོད་པ་དང་མེད་པ་གཉིས་གང་རུང་གཅིག་སྐྱོན་དང་བཅས་པར་ཁས་ལེན་དགོས་པས།",
    "ཡ་གྱལ་སོ་སོས་ཁྱབ་པར་ཁས་ལེན་དུ་མི་རུང་སྟེ།",
    "བུམ་ཡོད་ཡིན་ན་བུམ་མེད་ཤེས་བྱ་ལ་ཁེགས་པ་དང་བུམ་མེད་ཡིན་ན་བུམ་པ་ཁེགས་པར་འགྱུར་རོ།",
    "དངོས་འགལ་ལ་ཁྱབ་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ཡིན་ན་རྟག་རྫས་གཅིག་དང་དུ་མ་དང་བྲལ་བས་ཁྱབ་བམ་མ་ཁྱབ་ཁྱབ་ན་རྒྱུད་འགལ་ལ་ཁྱབ་པ་མེད་པར་འགྱུར་ལ།",
    "གཅིག་དང་དུ་མ་ཙམ་དང་བྲལ་བས་མ་ཁྱབ་པས་གཞི་གྲུབ་པར་འགྱུར་རོ།",
    "དེས་ན་མེའི་འབྲས་བུར་ལེགས་པར་གྲུབ་སྟེ།",
    "དགོས་ན་གཞན་དུ་མ་ཡོད་པ་རྣམས་དགོས་པར་འགྱུར་རོ།",
    "མི་རྟག་པ་དེ་བྱས་པ་ཡོད་པ་ཙམ་དང་།",
    "གཞན་སེལ་གྱི་རྣམ་གཞག་རྒྱས་པར་བསྟན་པའི་འཕྲོས་བཙལ་བའི་ཕྱིར་དང་།",
    "བྱས་མི་རྟག་རྫས་ཐ་དད་མེད་པའི་ཕྱིར།",
    "རྫས་སུ་གྱུར་པའི་བྱས་པ་གཏན་ཚིགས་ཡིན་ནམ།",
    "བྱས་པའི་རྫས་དང་༤༢བ་མི་རྟག་པའི་རྫས་ཐ་དད་མིན་པའི་ཕྱིར།",
    "བྱས་པ་མི་རྟག་པར་བསྒྲུབ་པའི་གཏན་ཚིགས་ཡིན་ན་མི་རྟག་པ་ཡིན་པར་འགལ་བས།",
    "ཁྱབ་པ་འགལ་ནས་མ་གྲུབ་པར་འགྱུར་ཞིང་།",
    "རྒྱུན་དང་རགས་པ་རྟོགས་པ་མི་སྲིད་པས་འདུས་བྱས་མི་སྲིད་ལ།",
    "དེ་མེད་ན་འདུས་མ་བྱས་ཀྱང་མི་སྲིད་པར་འགྱུར་རོ།",
    "རྟོག་པས་བཏགས་པའི་དོན་ལ་ཞེན་ནས་ཞུགས་པས་ཐོབ་པར་འགྱུར་བས་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "སྒྲ་བྱས་པར་ངེས་བྱས་ན་མི་རྟག་པའི་ཁྱབ་པ་ངེས་ན་སྒྲའི་མི་རྟག་པ་ལ་མི་སླུ་བ་རིགས་ན་རྟགས་སུ་བཀོད་པའི་དོན་དེ་ཡིན་ན་མི་རྟག་པ་ཡིན་པར་འགལ་བས་ཁྱབ་པ་ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པའི་རྟགས་ལས་མི་འདོད་པའི་ངེས་པ་བསྐྱེད་པར་བྱེད་ཀྱི།",
    "འདོད་པའི་ངེས་པ་བསྐྱེད་པར་མི་བྱེད་དོ།",
    "རྟགས་སུ་བཀོད་པའི་བྱས་པ་རང་མཚན་ཡིན་ནོ་ཞེ་ན།",
    "ཚིག་ཙམ་མཐོང་བས་ལེགས་པར་ཚིམ་པ་དག་ནི།",
    "གཞལ་བྱ་ཡིན་ན་རང་མཚན་ཡིན་པས་ཁྱབ་པར་སྨྲ་ཞིང་།",
    "ཐམས་ཅད་མཁྱེན་པའང་ལེགས་པར་བཀག།",
    "ཁྱད་པར་ཐ་སྙད་ཙམ་དུ་ཡོད་པའི་ཀུན་རྫོབ་ཀྱི་དོན་མི་རྟོགས་པར་འགྱུར་ལ།",
    "གཞན་སེལ་དང་སེལ་བས་འཇུག་ཚུལ་ཕྱིན་ཅི་མ་ལོག་པ་མ་རྟོགས་པ་བྱས་པ་ཡིན་པས།",
    "འདིར་གཞན་སེལ་གྱི་རྣམ་གཞག་རྒྱས་པར་མཛད་པ་ཡིན་ནོ།",
    "མ་རྟོགས་ན་གཟུགས་སྒྲ་ལ་སོགས་པ་ཀུན་རྫོབ་བདེན་པར་མི་རྟོགས་ལ།",
    "དམ་པའི་བདེན་པ་དང་འབྲས་བུ་བསྐྱེད་པའི་བྱ་བ་བྱེད་ནུས་པའི་གཟུགས་ལ་སོགས་པ་ཀུན་རྫོབ་ཀྱི་བདེན་པར་རྣམ་པར་བཞག་པ་མཛད་དོ།",
    "རང་སྒྲ་༩བཞིན་གྱིས་ཡོད་པ་དང་དོན་དམ་པར་ཡོད་པ་སོགས་འདྲ་ལ།",
    "གཟུགས་སྒྲ་སོགས་དོན་དམ་པར་ཡོད་པ་མ་ཁེགས་ན་ཀུན་རྫོབ་བདེན་པར་མི་འགྲུབ་པས།",
    "དེ་དག་བདེན་པས་སྟོང་པའི་རིགས་པའི་རྣམ་གཞག་རྒྱས་པར་མཛད་པ་ཡིན་ནོ།",
    "དེ་ཀུན་རྫོབ་ཏུ་མི་འགྲུབ་པས་དེ་འགོག་པའི་རྣམ་གཞག་རྒྱས་པར་འཆད་ཅིང་།",
    "དེས་འབྲས་བུ་མི་སྐྱེད་པའི་ཚུལ་རྒྱས་པར་སྟོན་བཞེད་ནས།",
    "གང་ཕྱིར་དངོས་ཀུན་རང་བཞིན་གྱིས་ཞེས་སོགས་གསུངས་ཤིང་།",
    "ད་ནི་འདི་དཔྱད་པར་བྱ་སྟེ།",
    "རང་མཚན་ཡིན་ན་ཡུལ་དང་དུས་དང་ངོ་བོ་མ་འདྲེས་པར་གནས་ལ།",
    "ཤར་ན་གནས་ན་ནུབ་ན་གནས་པར་འགལ་བ་དང་།",
    "འདྲེས་པ་སྔ་དྲོ་སྐྱེས་ན་ཕྱི་དྲོ་སྐྱེས་པར་འགལ་བའི་དོན་དང་།",
    "དུས་འདྲེས་པར་འཛིན་པའི་རྟག་འཛིན་ཀུན་བརྟགས་དང་ལྷན་སྐྱེས་ཀྱིས་སྔ་དུས་ཀྱི་དངོས་པོ་དང་ཕྱི་དུས་ཀྱི་དངོས་པོ་གཅིག་ཏུ་གཟུང་བས་དུས་མ་འདྲེས་པ་ཡང་སྔ་དུས་ཀྱི་དངོས་པོ་ཕྱི་དུས་ན་མེད་པ་དང་།",
    "ངོ་བོ་འདྲེས་པར་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "སེར་སྐྱའི་ངོ་བོ་ཡིན་པར་གཟུང་བས།",
    "སྔ་མ་གཉིས་ལ་ཕྱི་མ་གཉིས་ཀྱིས་གནོད་པར་འགྱུར་རོ།",
    "ངོ་བོ་མ་འདྲེས་པ་ཙམ་ཞིག་དངོས་པོ་རྣམས་ལ་ངོ་བོ་ཉིད་མེད་པར་སྨྲ་བ་རྣམས་ཀྱིས་ཀྱང་འདོད་པ་ཡིན་ནོ།",
    "བྱས་པ་སྒྲ་མི་རྟག་སྒྲུབ་ཀྱི་དམ་བཅའི་ཕྱོགས་གཅིག་རྟགས་སུ་བཀོད་པའི་མ་གྲུབ་པར་འགྱུར་ཏེ།",
    "བྱས་མི་རྟག་ངོ་བོ་ཐ་དད་མེད་པའི་ཕྱིར།",
    "དངོས་པོའི་གནས་ལུགས་བསྟན་པ་དེ་ཉིད་ཀྱིས་ཀུན་རྫོབ་དང་གཞན་སེལ་གྱི་རྣམ་དབྱེ་འབད་པ་མེད་པར་གྲུབ་བོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "སྒྲ་མ་ཡིན་པ་དང་བྱས་པ་མ་ཡིན་པ་ལས་ལོག་པ་ཡིན་ཏེ།",
    "བྱས་པ་ལ་བལྟོས་པའི་རིགས་མི་མཐུན་བྱས་པ་མ་ཡིན་པའི་ནམ་མཁའ་སོགས་དང་།",
    "སྒྲ་དེ་བྱས་པ་མ་ཡིན་པ་ལས་མ་ལོག་ན་འདུས་མ་བྱས་སུ་འགྱུར་ལ།",
    "ཡང་བུམ་པ་དེ་སྒྲ་མ་ཡིན་པ་ལས་ལོག་ན་སྒྲ་ཡིན་པར་འགྱུར་བས།",
    "བུམ་པ་ལས་རྗེས་སུ་མི་འགྲོ་བའི་སྒྲ་མ་ཡིན་པ་ལས་ལོག་པའི་ལྡོག་པ་དང་ཁྱབ་ཆེ་ཆུང་གཉིས་ཡོད་པར་གྲུབ་པ་ནི།",
    "དེས་མཚོན་ནས་ལྡོག་པ་མཐའ་དག་ལ་ཤེས་པར་བྱའོ།",
    "བྱས་མི་རྟག་ཐ་དད་དུ་རྣམ་པར་གནས་པས་དམ་བཅའི་ཕྱོགས་༤༦བ་གཅིག་རྟགས་སུ་བཀོད་པའི་སྐྱོན་དུ་མི་འགྱུར་རོ།",
    "བྱས་མི་རྟག་གོ་དཀའ་སླ་ཡོད་པའི་ཕྱིར།",
    "སོ་སོར་མེད་པ་ཡིན་པས་རང་རིག་མངོན་སུམ་ལ་སོ་སོར་གོ་བའི་ནུས་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེས་ན་བྱས་མི་རྟག་རྫས་ཐ་དད་མིན་ཡང་༤༧ན་བྱས་པའི་རྫས་དང་མི་རྟག་པའི་རྫས་ཐ་དད་ཡིན་ལ་དེ་ཡང་རྟོག་པས་བཏཊ་ཙམ་ཡིན་ནོ།",
    "སྒྲུབ་པའི་སྒྲ་རྟོག་སེལ་བའི་ཡུལ་ཅན་དུ་རྒྱས་པར་བསྒྲུབ་པ་དང་།",
    "དགག་པའི་སྒྲ་རྟོག་རྣམ་གཅོད་ཀྱི་ཡུལ་ཅན་དུ་འབད་པ་མེད་པར་གྲུབ་པའི་ཚུལ་ལོ།",
    "གཞན་སེལ་ལ་འཇུག་པར་བསྒྲུབ་པ།",
    "ཞེས་གསུངས་པའི་དོན་ནི།",
    "སྒྲ་དང་རྟགས་ཀྱི་རྣམ་བཅད་གཞན་སེལ་རྟོགས་པར་བྱེད་ཀྱི་སྒྲུབ་པས་ཏེ།",
    "དེ་གྲུབ་ན་གཞན་སེལ་གྱི་ཡུལ་ཅན་དུ་གྲུབ་པར་བསྟན་པའོ།",
    "སྒྲ་ངེས་པའི་ངེས་ཤེས་དེས་སྒྲ་དེ་སྒྲ་མ་ཡིན་པ་ལས་ལོག་པར་གོའམ་མ་གོ་མ་གོ་ན་སྒྲ་མ་ཡིན་དུ་འཛིན་པའི་ཞེན་ཡུལ་རྣམ་པར་བཅད་པ་མ་གོ་བས་སྒྲར་ཡང་མ་གོ་བར་འགྱུར་རོ།",
    "སྒྲ་མ་ཡིན་པ་ལས་ལོག་པར་གོ་ན་སྒྲ་དེ་རྟག་པ་ལས་ལོག་པར་གོའམ་མ་གོ།",
    "ཁོ་བོ་ནི་རྟགས་སྔ་མ་མ་གྲུབ་པར་འདོད་དེ་འོག་ཏུ་འཆད་དོ།",
    "སྒྲ་ཡི་དངོས་པོ་གཟུང་དོན་དུ་བྱས་ནས་མཐོང་བ་ཡིས་སོ།",
    "སྤྱི་ཡི་དོན་ཅན་ཡིན་པས་རྣམ་པར་རྟོག་པ་ཡིན་ལ།",
    "རྗེས་དཔག་དེས་སྒྲ་རྟག་འཛིན་ལྷན་སྐྱེས་ཀྱི་ཞེན་ཡུལ་༥ན་རྣམ་པར་བཅད་པ་དེས་ཀྱང་ལྷན་སྐྱེས་མངོན་གྱུར་འཇོམས་མི་ནུས་ཀྱི་བྱེད་པའི་འདུ་བྱེད་མ་ཉམས་ན།",
    "བསམ་གཏན་དང་པོའི་ཉེར་བསྡོགས་རྫོགས་པར་སྐྱེས་ན།",
    "བུམ་པའི་བྱས་སྟོང་དུ་ཡང་ངེས་ཞེས་བརྗོད་པ་ན།",
    "དེ་གཉིས་ཡུལ་གཞན་མ་ཡིན་པར་བརྗོད་བྱ་དང་དགོས་པ་ཐ་དད་མེད་པའི་རྗོད་བྱེད་ཐ་དད་ཡིན་པ་དེའི་ཕྱིར།",
    "རྟགས་དེའི་ཁྱབ་པ་བསྒྲུབ་པ་སྒྲ་རྟོགས་ིགཉིས་ཀ་ལ་སྦྱར་ནས་གསལ་བར་གསུངས་སོ།",
    "ཆ་ཤས་ཞེས་སོཊ་གསལ་བར་གསུངས་ཟིན་པས།",
    "རང་འགྲེལ་དུ་གསུངས་ཟིན་པ་ཡང་རྩ་བར་བཀོད་སྐུ་དང་རྟགས།",
    "ཁྱད་པར་སྣ་ཚོགས་པ་ཅན་གྱི་དོན་སྒྲ་དང་།",
    "དེ་ལྟ་ན་ཁྱད་པར་བྱས་སོགས་སྣ་ཚོགས་ལ་ཕན་འདོགས་པའི་རྒྱུའི་ཡན་ལག་སྒྲ་དེ།",
    "ངེས་པས་གཟུང་བ་མ་ངེས་པར་འགལ་བ་ནི།",
    "ཁྱབ་པ་མེད་ན་ཡུལ་དེ་ལ་གྲུབ་མ་གྲུབ་ཆ་གཉིས་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྟགས་མ་གྲུབ་ན་ངེས་ཤེས་ཀྱིས་གཟུང་ཡང་མ་ངེས་པར་འགལ་ལོ།",
    "གཞུང་འདིས་རང་ལུགས་ལ་ངེས་ཤེས་ཀྱི་གཟུང་ཡུལ་ལ་ངེས་ཡུལ་གྱིས་ཁྱབ་པར་བསྟན་པར་འདོད་པ་ནི་རྣམ་གཞག་མ་ཆཊ་པས་ཏེ།",
    "རྟོག་པ་རྣམས་ཀྱི་གཟུང་ཡུལ་རང་རིག་མངོན་སུམ་གྱི་གཞལ་བྱར་རིགས་པ་སྨྲ་བས་ཡང་དང་ཡང་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་གྲུབ་པའི་སྒོ་ནས་གཟུང་དོན་དུ་བྱས་པའི་ཕྱིར།",
    "དེའི་ཁྱད་པར་གང་ལ་རྟོགས་པ་བསྐྱེད་པ་ཡི་མཐུན་རྐྱེན་ཚང་བར་ཡོད་ཅིང་།",
    "འགལ་རྐྱེན་མེད་པ་དེ་རྟོགས་པར་འགྱུར་བའི་ཕྱིར།",
    "བློ་གོམས་པ་ཆེ་ཆུང་སོགས་ཀྱི་མཐུན་རྐྱེན་གྱི་ཁྱད་པར་ལས་སོ།",
    "འདི་ཡན་ཆད་ཀྱིས་སྒྲ་རྟོག་སེལ་བའི་ཡུལ་ཅན་དུ་བསྒྲུབས་ནས་རང་བཞིན་གྱི་རྟགས་དམ་བཅའི་ཕྱོགས་གཅིག་རྟཊ་སུ་བཀོད་པའི་མ་གྲུབ་པར་འགྱུར་བ་སྤངས་པ་ཡིན་ནོ།",
