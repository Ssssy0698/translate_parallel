    "གནས་པ་བརྟན་པ་ལ་ཡང་བསྒོམ་ཡང་སྒོམ་བྱས་ནས་བརྟན་པ་བོགས་དབྱུང་བ་ལ་སྤྱོད་པ་བྱེད་ལ།",
    "དེའི་ལན་དུ་གཉིས་ཀྱིས་ཞེས་པས་ལེགས་པར་འོང་ཞེས་པའི་ལན་ནོ།",
    "བསྣུན་སྙོམས་པར་ཞུགས་པའོ།",
    "དེ་གཉིས་སྙོམས་པར་ཞུགས་པ་ལས་སྦྱོར་བ་ལས་སོ།",
    "པར་བྱའོ་ཞེས་པའོ།",
    "དེ་ལས་ཀྱང་ཌཱ་ཀི་བཅོ་ལྔ་ལམ་དུ་བྱེད་པར་བསྡུའོ།",
    "ཐང་སྐུ་བྲིས་རབ་གནས་བྱས་ལ་གུར་གྱི་ལེའུ་བཅུ་གཉིས་པ་ནས་བསྟན་པའི་གནས་སུ་བསྡད་ནས།",
    "ཡེ་ཤེས་སེམས་དཔའ་སྤྱན་དྲངས་ནས་གཉིས་སུ་མེད་པར་བསྲེ་བ་དང་།",
    "དེ་རྣམས་ཀྱི་ཡང་ཆོ་གའི་ཁྱད་པར་ལ་དགོངས་ནས་འདི་བགྲངས་ཀྱི།",
    "སྔོན་དུ་བསྐྱེད་པ་ལ་བརྟན་པ་ཐོབ་པར་བྱས་ལ།",
    "ཐུན་བཞི་རུ་བྱས་ནས་ཐུན་གཉིས་ནི་བསྐྱེད་རིམ་བསྒོམ་ལ།",
    "དེ་ལས་ཇོ་བོ་པུ་ལ་ཧ་རི་པ་ནི་སྤྲག་པར་བཞེད་དོ།",
    "དེ་ལྟར་ཡང་རིམ་གཉིས་མཉམ་པར་གནས་ནས་ནི་ཞེས་པས་ཤེས་སོ།",
    "བསྐྱེད་དང་ཞེས་གསུངས་སོ།",
    "ཕ་འདོད་ཆགས་ལངས་པའི་དུས་དང་མ་འདོད་ཆགས་ལངས་པའི་དུས་སུ་སྙོམས་པར་ཞུགས་པས་ལུས་བདེ་བའི་ལུགས་སུ་བླུགས་པའོ།",
    "དོན་དམ་དེ་བཞིན་ཉིད་ཀྱི་རྣམ་པར་དག་པ་དང་།",
    "ཀུན་རྫོབ་ལྷ་སོ་སོའི་རྣམ་པར་དག་པ་གཉིས་སོ།",
    "དག་ལུགས་ཇི་ལྟར་བདག་ན་འབད་རྩོལ་མེད་པར་བདག་གོ།",
    "དག་ལུགས་འབད་རྩོལ་མེད་པར་དག་གོ།",
    "ཉམས་མྱོང་ནི་བདེ་བ་ངོས་འཛིན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཉམས་མྱོང་བདེ་ལ་མི་རྟོག་པ་ངོས་འཛིན་པར་བྱེད་དོ།",
    "དེ་ནས་ལྟ་སྟངས་བཞིས་ལས་བཞི་བསྒྲུབ་པ་ནི་མཉམ་པར་མ་རུངས་ཞེས་པ་ལ་སོགས་པ་ནི་ལྟ་སྟངས་བཞི།",
    "དེ་ཡང་སྐྱེ་བ་བདུན་པའི་ཤ་ཟོས་པས་ནི་དགའ་བྲལ་གྱིདགའ་བ་རྟོག་བཅས་ལ་དགའ་ཞིང་རྟོག་མེད་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ལ་སྨོད་པ་དེས་ཀྱང་ལན་བདུན་པ་སྟེ་སྐྱེ་བ་བདུན་པའི་ཤ་ཟོས་ན་དངོས་གྲུབ་འགྲུབ་པར་འགྱུར་རོ།",
    "ཅིག་ཕུལ་ནས་ལུས་འདི་སྦྱིན་དགོས་བྱས་ན་སྟེར་ཏེ།",
    "དེ་ལ་རི་ལུ་བྱས་ནས་ཟོས་པ་ཙམ་གྱིས་མཁའ་སྤྱོད་དུ་འགྱུར་ཏེ།",
    "བརྟག་པ་དང་པོའི་ལེའུ་བཅུ་པར་ས་སྦྱང་ས་ལ་སོགས་པ་བྱུང་བ་ལ།",
    "བྱས་པའི་ཕན་ཡོན་དང་།",
    "བསྡུས་པ་གསུམ་དུ་བྱས་ནས།",
    "རྒྱས་པ་ནི་རབ་གནས་ཀྱི་ཆོ་གའི་འབུམ་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ནས་སྟ་གོན་བྱས་པའི་ཏིང་ལ་དལ་གང་ཡིན་བྲི་བའོ།",
    "དེ་ནས་དལ་བསྒྲུབ་པ་སློབ་དཔོན་བདག་འཇུག་བྱས་པའི་རྗེས་ལ་ཧོ་མ་བྱ་བ་ནི།",
    "ཅི་གསུངས་སྦྱིན་སྲེག་བྱས་ནས་ནི།",
    "གཡས་ངོས་སུ་མེ་ཏོག་ལ་སོགས་པ་བཞག་ལ་གོ་རིམ་ཀྱང་ངེས་པ་མེད་ལ་དབུལ་བ་ཡང་གང་ཟིན་ཟིན་ནས་དབུལ་གསུངས།",
    "སྭཱ་ཧཱ་ནི་མཉེས་པར་གྱུར་ཅིག་པའོ།",
    "ཞི་བ་ཏིལ་ལ་སོགས་པས་ཁྱད་པར་གྱི་བསྲེག་རྫས་བསྟན།",
    "ཨོ་ལ་སོགས་པས་ཡེ་ཤེས་ཀྱི་མེ་ལྷ་སྤྱན་དྲང་པ་བསྟན།",
    "དེ་རྣམས་ལག་ཏུ་བླང་པ་ཧོ་མའི་ཆོ་གར་ཤེས་པར་བྱའོ།",
    "ལེའུ་དང་པོའོ། ལེའུ་གཉིས་པ་འདིས་བརྟག་པ་དང་པོར་བསྐྱེད་རྫོགས་བཟླས་པ་རྣམ་དག་དང་བཅས་པ་བསྒོམས་ཤིང་བརྡ་དང་སྤྱོད་པ་ལ་སོགས་པ་བྱས་པས།",
    "ཇི་སྲིད་ཕྱག་རྒྱ་མ་རྙེད་པར་ཞེས་པས་བསྟན་ནོ།",
    "སྤྲོས་མེད་བྱས་ན་སྒྱུ་ལུས་ལྷའི་སྐུ་དེ་རྣམས་ཀྱང་འོད་གསལ་སྟོང་པར་ཐིམ་པའོ།",
    "དེ་ལ་བཞི་ལས་དང་པོ་བསྐྱེད་རིམ་མེད་ན་འགྲུབ་པར་མི་འགྱུར་བར་དཔེ་དོན་གྱིས་བསྟན་ནོ།",
    "བསྐྱེད་རིམ་དང་དངོས་པོ་དང་དངོས་མེད་གཉིས་མེད་ལས་མ་འདས་པར་བསྟན་ནོ།",
    "རྟོགས་པའི་གནས་དེ་ཉིད་ན་ཕུན་གསུམ་ཚོགས་པ་ལྔའི་ངོ་བོར་བཞུགས་པར་བསྟན་པ་ནི།",
    "ཅི་ལྟར་ཤེས་པར་འགྱུར་བའི་ངེས་པ་སྟེར་བའོ།",
    "གཉིས་པ་ལ་རྣམ་པར་སྨིན་པའི་སྐད་ཅིག་མ་དང་མཆོག་དགའོ།",
    "དེའི་བསྐུར་ཐབས་ནི་དཀྱིལ་འཁོར་གྱི་ཆོ་གར་ཤེས་པར་བྱའོ།",
    "འཁོར་ལོ་ཞེས་གནས་ནམ་མཁའི་ཁམས་དེས་ནི་ཡུལ་ལ་སོགས་པ་རྣམ་པར་སྦྱོང་ཞེས་བསྟན་ནོ།",
    "ཀ་ཀོ་ལ་ནི་ལྟེ་བའི་ཨ་དེ་གཉིས་ལ་རྟེན་ནས་ལེན་ནུས་པས་བདེ་བ་ཤེས་པར་འགྱུར་ཞེས་སོ།",
    "དེ་བྱས་པས་བདེ་བ་ལེན་ནུས་པས་དེའི་བདེ་བ་ཤེས་པར་འགྱུར་ཞེས་སོ།",
    "ཚོགས་ཀྱི་བདག་པོས་སྔར་བྱས་ནས་ཞེས་པ་ནི།",
    "ཚོགས་གཉིས་སོགས་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་ལེའུ་ལ་སོགས་པས་རྩའི་རྣམ་པར་དག་པའི་ལན་ནོ།",
    "རྩེ་སུམ་ཅུ་རྩ་གཅིག་ལ་རྣམ་པར་དག་པ་བྱས་ནས།",
    "རྩ་གཅིག་ལ་རྣམ་པར་དག་པ་མི་བརྩི་བ་དེ་གང་ཕྱིར་སློང་བ་ཡིན་ཞེ་ན།",
    "གཅིག་ཏུ་ཞེས་པ་ནི་རྩ་ཟུང་གཅིག་ཏུ་ཆ་དང་བཅས་པ་ནི་རྣམ་པར་དག་པ་མེད་པས་ན་ཞེས་པའོ།",
    "རྩ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་ཐ་མ་བདུད་བྲལ་མ་ལ་རྣམ་པར་དག་པ་མེད་པས་སྤང་ཞེས་སོ།",
    "ལན་དུ་ཅིས་ཀྱང་བླང་པར་བྱ་བ་ཡིན་ཟེར་རོ།",
    "པ་ནི་དེ་གཉིས་ལས་ཁུ་ཁྲག་གཉིས་བྱུང་བས་ཉེ་བར་ལེན་པའི་རྒྱུ་བྱས།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུའོ།",
    "ད་ལྟ་ལུས་གནས་པ་ཡང་ཨེ་ཝཾ་ཐབས་ཤེས་རབ་ལས་མ་འདས་པར་བསྟན་པའོ།",
    "དེ་ནས་མགྲིན་པར་མེས་ཕྱིན་པའི་དུས་སུ་ཐིག་ལེ་ཞུ་ནི་མ་ཞུ་འཇུར་ནི་ཉེ་བ་དེ་ལ་སྐྱེས་བུ་བྱེད་པའི་འབྲས་བུ་ཞེས་བྱའོ།",
    "ལྟོ་བ་གནས་སུ་བརྗོད་པར་བྱ་ཞེས་པ་ལ་སོགས་པས་ལུས་སྤྲུལ་པའི་སྐུ་རུ་གྲུབ་པ་བསྟན་ཏོ།",
    "དེ་ཤེས་པས་སེམས་ཀྱི་བཞུགས་ས་ཤེས་པའི་དགོས་པ་ཡོད་དོ།",
    "རྒྱས་པར་རབ་དུ་ཕྱེད་བ་ལས་ཞེས་པ་ལ་སོགས་པ་རིགས་ལ་ཞེན་པ་མེད་པའི་ཕྱིར་རིགས་ཀྱི་དབྱེ་བ་སྟན་ཏོ།",
    "བརྟག་པ་དང་པོའི་ཐེ་ཚོམ་སེལ་བའི་ལེའུ་ཞེས་བྱ་སྟེ་བཞི་པའོ། ལེའུ་ལྔ་པ་འདིས་བརྟག་པ་དང་པོའི་ལེའུ་གསུམ་པར་ཧེ་རུ་ཀ་ཞལ་ཅིག་ཕྱག་གཉིས་པ་དང་།",
    "འཁོར་ལོ་ཇི་ལྟར་སྔར་གསུངས་པ་ཞེས་པ་ལ་སོགས་པས་བསྟན།",
    "ཞིབ་དུ་སྒོམ་རིམ་དུ་ཤེས་པར་བྱའོ།",
    "བྷོ་ལ་བཞིབ་པར་ལ་སོགས་པས་རྩ་བའི་སྔགས་བསྟན་ཏེ།",
    "པུ་ལ་ཧ་རི་ལ་ཞུས་པས་འདི་ལྟར་ཟློས་གསུངས་ནས་དག་པ་ཅིག་ལོགས་ན་ཡོད་དོ།",
    "ལེའུ་བརྒྱད་པར་བསྐྱེད་རིམ་བྱུང་བ་ལ།",
    "ཟུམ་པ་ཞིག་ངེས་པར་ཡོད་དོ།",
    "བརྟག་ལུགས་ཞིབ་ཏུ་ལས་རྒྱའི་མན་ངག་ཏུ་ཤེས་པར་བྱའོ།",
    "མཉམ་ཟས་ནི་ཀུན་རྫོབ་བྱང་སེམས་ལ་བརྟེན་ནས་དོན་དམ་པ་ས་ཧ་ཛ་རྟོགས་པར་ཤོག་ཞེས་པའོ།",
    "ཁ་སྦྱར་འབྱེད་པ་ནི་རང་བཞིན་གྱི་ཁ་སྦྱར་འཁོར་ལོ་བཞི་གཉིས་གཉིས་སུ་ཁ་སྦྱར་གྱི་དབུས་ན་སེམས་ཀྱི་རྒྱལ་པོ་བཞུགས་པས་དེ་འབྱེད་དགོས།",
    "བརྟེན་མ་ལེགས་ན་འཆིང་པར་འགྱུར་རོ།",
    "ཡང་བརྟག་པ་དང་པོའི་ལེའུ་ལྔ་པ་དང་བརྒྱད་པར་ཕྱག་རྒྱ་མའི་མན་ངག་བྱུང་བ་ལ་དེའི་མ་ཚང་པ་འདི་ནས་སྟོན་པས།",
    "བྷ་གར་ལིང་ག་ལ་སོགས་པའི་ཉན་པར་རྣ་གཏད་པར་བསྐུལ་བའོ།",
    "དེ་ཡང་ཕྱག་རྒྱ་མ་དང་གཉིས་ཀ་ལྷའི་སྐུར་བྱས་ལ་གཞུང་ནས་བྱུང་བའི་བདེ་བ་བསྐྱེད་པའི་ཚེ་བྱའོ།",
    "དེ་ལ་ག་བུར་ནི་ལུས་གཟུངས་རྒྱས་པར་བྱའོ།",
    "ཨོཾ་པདྨ་ལ་སོགས་པས་ཡུམ་གྱི་པདྨ་བྱིན་གྱིས་བརླབས་པར་བསྐུལ་བའོ།",
    "ཐེ་ཚོམ་སེལ་བ་དང་བཞི་རུ་བྱས་ནས་བརྟག་པ་དང་པོའི་ནང་དུ་གདབ་བོ།",
    "དེ་ཉིད་བཅུ་པོའི་རྣམ་པར་རིག།",
    "དཀྱིལ་འཁོར་འབྲི་མཁས་བཟླས་པར་ལྡན།",
    "དེ་ཡང་མཚན་ཉིད་གསུངས་པ།",
    "བསམ་པས་དེ་རྣམས་འགྲུབ་པར་འགྱུར།",
    "ང་རྒྱལ་ཁྲོ་ལས་རྣམ་པར་གྲོལ།",
    "རྡོ་རྗེ་སློབ་དཔོན་སེམས་བསྐྱེད་པ་སྔོན་དུ་འགྲོ་བས་གནས་ཡིད་དང་མཐུན་པར་འགྲོ་བ་ནི།",
    "ཧེ་བཛྲ་མཎྜ་ལ་མུཞེས་པས་རྟེན་དེ་རང་བཞིན་གྱི་གནས་སུ་གཤེགས་པར་བསམ།",
    "ཞེས་ན་ད་ལས་རང་སྒྲ་བྱུང་པར་བསམས་ལ་བརྗོད།",
    "དཔའ་བོ་བདེན་རྫུན་རྣམ་དཔྱད་པས་ཞེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཨོཾ་བཛྲ་རཀྵ་རཀྵ་ཧཱུཾ་ཧཱུཾ་ཧཱུྃ་ཞེས་བརྗོད་པས་བརྟན་པར་བསྒོམ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར་ཞེས་པ་དང་།",
    "ཐམས་ཅད་བདག་ཉིད་རྟག་བཞུགས་དང་ཞེས་སོ།",
    "འཁོར་ལོ་སྔོན་དང་ཅི་རིགས་པར།",
    "རྡོ་རྗེ་དཀྱིལ་འཁོར་དབུས་གནས་པར།",
    "སོགས་པ་གསུངས་སོ།",
    "རྒྱལ་ཆེན་རྣམ་པར་སྣང་མཛད་དེ།",
    "འཁོར་ལོ་དེའི་དབུས་སུ་ན་ད་ཆ་གཅིག་ཞུགས་པར་སྒོམས།",
    "འཁོར་ལོ་ཇི་ལྟར་སྔར་གསུངས་པ།"
  ]
}