    "འཇིག་ལྟ་གང་ཟག་གི་བདག་འཛན་ཡིན་པའི་ཕྱིར་དང་།",
    "མ་ཐོབ་པ་ནི་སྐྱེ་འགྲོ་ཕལ་ཆེར་ཡན་མོད།",
    "བརྒྱ་ལ་ཅུང་ཟད་འདས་ན་ཡང་མྱུརབ་མྱུར་བར་རང་རང་གི་ཕྱིར་བཅོས་ཀྱི་ཆོ་གས་དག་པར་བྱས་ནས་སྡིག་ལྟུང་དང་ཞག་ཏུ་མི་འགྲོག་པ་ཞིག་བྱེད་ཐུབ་ན་ལམ་རམཔ་གཉིས་ཉམས་སུ་མ་བླངས་ཀྱང་མམཐའ་སྐྱེ་བ་བཅུ་དྲུག་ཚུན་ལ་མཆོག་གི་དངོས་གྲུབ་ངེས་པར་ཐོབ་པར་རྒྱུད་དང་གྲུབ་ཆེན་གྱི་གཞུང་རྣམས་ལས་རྒྱ་ཆེར་འབྱུང་སྟེ།",
    "རྗེ་བཙུན་ནཱ་རོ་མཁའ་སྤྱོདད་མ་ལ་བརྟེན་པའི་མར་མེའི་སྦྱིན་སྲེག་བཞུགས་སོ། ། ནམོགུརུ་ཤྲཱི་ཙཀྲསམྦྷ་རཱ་ཡ།",
    "སྣང་གསལ་དྲི་ཆབ་ཞལ་ཟས་རོལ་མོའི་ཚོགས།",
    "ཨྃཨོ་ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ་བཛྲ་ཝ་ཎྞ་ནཱི་ཡེ་བཛྲ་བེ་རོཙ་ནཱི་ཡེ་དྨེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་ཕཊ་སརྦ་པཱ་པཾ་ཤིནྟཾ་ཀརུ་སྭཱཧཱ།",
    "རྩབས་བརྒྱད་ལ་མདུནནས་བརྩམས་ཏེ་གཡས་སྐོར་དུ་ཏཱ་རེ་ཏུཏྟརེཏུརེ་སྭཱ་ཞེས་པ་གཡས་སྐོར་དུ་ཡོད་པ།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གསེར་གྱི་བུམ་པའཆི་མེད་བདུད་རྩིའི་ཆུ་རྒྱུན་གྱིས་གང་བ་། མཉམ་གཞུག་གི་ཕྱགརྒྱའི་སྟེང་ན་བསྣམས་པ།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "རང་གི་ལུས་ཀྱི་སྤྱི་གཙུག་ནས་རྐང་མཐིལ་གྱི་བར་ཐམས་ཅད་མེར་གྱིས་ཁེངསཔས།",
    "འོད་དཀར་པོའི་གུར་ཁང་གི་ཕྱི་རོལ་འདོམ་གང་ཙམ་དུའོད་སེར་བའི་གུར་ཁང་དུ་གྱུར་རྒྱས་པའི་འཕྲིན་ལསཐམས་ཅད་འགྲུབ་པར་བསམ།",
    "འོད་སེར་པོའི་གུར་ཁང་གི་ཕྱི་རོལ་འདོམ་གང་ཙམ་ངྷི་འོདདམར་པོའི་གུར་ཁང་དུ་གྱུར།",
    "འོད་དམར་པོའི་ཟ་། གུར་ཁང་གི་ཕྱི་རོལ་ཏུ་འོད་མརྠང་གའི་གུར་ཁང་དུ་གྱུར།",
    "མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་ཐམསཅད་འགྲུབ་པར་བྱས།",
    "འོད་མཐིང་གའི་གུར་ཁང་གི་ཕྱི་རོལ་ཏུ་འོད་ལྗང་གུའི་གུར་ཁང་དུ་གྱུར།",
    "འོདལྗང་གུའི་གུར་ཁང་གི་ཕྱི་ལ་འདོམ་གང་ཙམ་ངུ་འོད་མཆིན་ཁའི་གུར་ཁངདུ་གྱུར།",
    "ཨོཾཥྞཱིཨྰ་ཏུཏྟཱརེ་ཏུ་རེ་མ་མཱ་ཨཱུ་ཡུརཔུ་ཎྱ་ཛཱན་པུའི་ཀུ་རུསྭཱཧཱ།",
    "ཟ་། ཟ་མ་ཏོག་གི་དཀར་ཆག་བཞུགས་སོ།",
    "ཐུགས་དགོངས་ཟབ་མོ་ཡོངསསུ་རྫོགས་པ་དང་མཆོག་སྤྲུལ་འཁྲུལ་བྲལ་ཞལ་བཟང་མངོན་གྱུར་ཤོག།",
    "རི་མོ་རྣམ་པར་བཀྲ་བའི་ཡོལ་བ་ལ།",
    "ཆུ་གཉིས་ཉེར་སྤྱོད་རོལ་མོ་འདོད་ཡོན་ལྔ།",
    "སྦྱ་། ཡོངས་སུ་གང་བས་དཔལ་ལྡན་ལྷ་མོ་དང་།",
    "གང་ཟག་གཅིག་གི་རྫོགས་བྱང་ཐོབ་ཐབས་ཀྱི།",
    "ཟབ་མོའི་ལྟ་དང་ཟུང་དུ་འབྲེལ་བ་ཡི།",
    "ཡིད་ལ་སྨོན་པའི་རེ་བ་མ་ལུས་པ།",
    "བདག་གི་བློ་ཡི་མུན་པཀུན་བསལ་ནས།",
    "ཞེན་པ་གཏིང་ནས་ལོག་པའི་ངེས་འབྱུང་གིས།",
    "བདག་གི་ལུས་དང་ལོངས་སྤྱོད་དགེ་ཚོགས་བཅས།",
    "གཞན་སྐྱོན་རང་གི་སྟེང་དུ་ལོན་པར་ཤོག།",
    "བདེ་བ་ཅན་གྱི་ཞིང་གི་ཡོན་ཏན་རྣམས།",
    "ཡོངས་སུ་བསྐོར་བའི་དག་པའི་ཞིང་གི་མཆོག།",
    "བློ་དམན་བདག་འདྲས་བརྗོད་འདོད་གད་མོའི་གནས།",
    "ཡོནཏན་མཐའ་དག་རྫོགས་པའི་མགོན་ཁྱོད་ལས།",
    "མགོན་ཁྱོད་སྲས་དང་བཅས་པ་མཐོང་བར་ཤོག།",
    "ཐེགམཆོག་གསུང་གི་བདུད་རྩིས་འཚོ་བར་ཤོག།",
    "མ་དག་ཞིང་གི་འགྲོ་བ་སྒྲོལ་བའི་ཕྱིར།",
    "ཕན་བདེའི་པད་ཚལ་ཐུགས་རྗེའི་འོད་སྟོང་གིས།",
    "ཉོན་མོངས་དུག་ལྔའི་ལྕགས་སྒྲོག་དམ་པོས་བཅིངས།",
    "རྡོ་རྗེ་སློབ་དཔོན་མཆོག་གི་ཞབསདྲུང་དུ།",
    "སྒྲུབ་ཐབས་ཟབ་མོའྀ་དབྱར་གྱི་རྔ་གསང་ལྡིར།",
    "དྲུགབྱོན་། དཀར་ཆག་གི་རིམ་པ་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པ་བཞུགས་སོ།  ། ཨོཾ་བདེ་ལེགས་སུ་གྱུར་ཅིག།",
    "ཕུན་ཚོགས་ཇི་སྙེད་མཛད་པའིའོད་སྟོང་གིས།",
    "ཀུན་གཟིགས་བློ་གྲོས་བཟང་པོའི་སྤྱན་སྟོང་གཡོ།",
    "མཛད་བཟང་ནོར་བུའི་ཏོག་གིས་རབ་མཚན་པའི།",
    "རྒྱལ་མཚན་སྲིད་པའི་རྩེ་མོའི་བར།",
    "བསྒྲེང་མཁས་གང་གི་བཀའདྲིན་བསམ་ལས་འདས།",
    "མཆོག་དང་མཐུན་མོང་དངོས་གྲུབ་ཀུན་གྱི་གཞི།",
    "རྒྱུ་སྐར་ས་ལ་བཀྲམ་འདྲའི་ཕྱུག་གཞུང་གི།",
    "ལུས་ཅན་བསོདནམས་ཞིངདུ་བསྔགས་མོད་ཀྱང་།",
    "རྒྱ་ཆེན་སྤྱོད་བརྒྱུད་ཟབ་མོ་ལྟ་བརྒྱུད་དང་།",
    "སྒྲིབ་གཉིས་བྱང་ཞིང་ཚོགས་གཉིས་རྫོགས་པར་མཛོད།",
    "ངན་སོང་ལོག་པའི་ལམ་དུ་མི་ལྟུང་ཞིང་།",
    "མིག་གི་བདུད་རྩིར་སྤུངས་འདྲའིགསར་བསྐྲུན་ནང་།",
    "ནང་གི་དབུས་དང་གཡས་གཡོན་ལྡེབས་བྲིས་སུ།",
    "གང་གི་བ་སྤུའི་ཁུང་བུ་རེརེར་ཡང་།",
    "ལྷག་བསམ་དུང་གི་མདངས་ལ་རྗེས་འགྲོ་བ།",
    "གཅིག་ཏུ་བསྡོམས་པའི་མཐུལས་ཡོན་བདག་གིས།",
    "ཉོནམོངས་ཚ་གདུང་སེལ་བའི་འདུས་ཚོགས་ཀྱི།",
    "ཅེས་པ་འདི་ནི་དྲུང་བློ་བཟང་མཐུ་སྟོབས་ནས་ལྷུན་རྩེ་མི་ཚན་གྱི་འདུ་ཁང་གི་རྟེན་གཙོའ་སྐྱབས་མགོན་བསྟན་པའི་ཉི་མའི་སྣང་བརྙནགསའ་དུ་བཞེངས་པའི་རྒྱབ་ཡིག་ཏུ་དགོས་གསུང་པ་ལྟ་༢དགེ་སློང་བློ་བཟང་སྦྱིན་བས་བྲིས་པའོ།",
    "རྨད་བྱུང་མཛད་པའི་འོདསྣངའབུམ་ཕྲག་གིས།",
    "དགེ་ལྡན་ལུགས་བཟང་སྲིད་པའི་མིག་ཟུང་གི།",
    "ཐལ་བར་བརླག་མཛདརང་བྱུང་རྒྱལ་མོ་ཡིས།",
    "ཅེས་པ་འདི་བཉིས་ནི་དྲུང་ཡིག་བློ་བཟང་དར་འདུས་ནས་དགོས་ཞེས་བསྐུལ་བ་ལ་བརྟེན་ནས་དགེ་སློང་བློ་བཟང་སྦྱིནཔ་བདག་གིས་བགྱིས་པའོ།",
    "སྒྲིངགཉིསབྱང་ཞིང་ཚོགས་གཉིས་མྱུར་རྫོགས་ཤོག།",
    "ངཞསོང་ལོག་པའི་ལམ་དུ་མི་ལྟུང་ཞིང་།",
    "འཛམགླིང་མཛེས་པའི་རྒྱན་རྣམས་ཕྱག་གི་ཡུལ།",
    "དབུས་གཙང་རུ་བཞིར་གྲགས་པདེའི་ནང་གི།",
    "ལས་འགྲོནབཅས་པས་སོར་མོའི་འཕྲུལ་ལས་བསྐྲུན།",
    "གྲོ་དང་གཞལ་མེད་ཁང་གི་ཕྱིའི་གྲྭ་བཞི།",
    "རིན་ཆེནའོད་འབར་ཏོག་གིས་རབམཛེས་པའི།",
    "ཕན་གདུགས་རྒྱལ་མཚན་འབུད་དཀྲོལ་བརྡུང་གསུམ་སོགས།",
    "སྐྱེ་བོའི་ཚོགས་ཀྱང་སྟོནམོས་ཚིམ་པར་བྱས།",
    "སྐུ་གཟུགས་མཆོད་རྟེན་རྣམས་ལ་རྡུལ་ཕྲ་མོ།",
    "གང་གི་ལུས་ལ་རིག་སྔགས་འདི་འཆང་ན།",
    "དཔེར་ན་ས་གཞི་ཆེན་པོའི་རྡུལ་ཕྲན་༴ ། དང་ཕྱུགས་ཀྱི་སྤུ་ཉག་རེ་ནས་བགྲང་ཞུས་ཀྱི།",
    "འཁོར་ལོ་གསུམ་གྱི་བྱ་བའི་མཛད་བཟང་གིས།",
    "རྒྱུ་སྦྱོར་ཡོན་བདག་ཕོ་མོ་རྣམས་ཀྱི་གཙོས།",
    "འཕགས་པའི་གསུང་གི་བདུད་རྩིར་སྤྱོད་པར་ཤོག།",
    "མངྒལཾ། ། བསྐལ་བཟང་ལྷ་ཁངགི་དཀརཆག་འདི་ཕྱིའི་བདེ་ལེགས་མ་ལུས་པའི་འབྱུང་གནས་ཞེསབྱ་བ་བཞུགས་སོ། ། ནམོ་གུ་རུ་ཝེ།",
    "འཁོར་སྒྱུར་ཡུལ་འཁོར་སྲུང་གི་སྲས་སྟོང་གིས།",
    "བསྟན་པའི་རྒྱལ་མཚན་རྩེ་མོར་རྟག་བཀོད་ནས།",
    "རྒྱུ་སྦྱོར་ཡོན་བདག་ཕོ་མོ་ཐམས་ཅད་ཀྱི།",
    "མཐུ་སྟོབས་གནམ་ལྕགས་ཐོག་གི་མདའཆར་གྱིས།",
    "ཐལ་བའི་རྔུལ་ཕྲནབཞིན་དུ་བརླག་མཛད་པ།",
    "བསེ་ཡི་ཁྲབ་རྨོག་གསོལ་དེ་ཕྱག་གི་ཡུལ།",
    "མྱང་སྟོད་ནོར་འཛིན་སྒེག་མོའི་ལྟོ་བ་རུ།",
    "དྲེགས་པའི་གཙོ་བོ་ཟུང་གི་གཞལ་མེད་ཁང་།",
    "ཁྱོན་སྒྲིལ་དངུལ་སྲང་བརྒྱ་ཕྲག་ལཉེ་བ།",
    "ས་ཕ་གིར་འབྱོན་ཞེས་ལུང་བསྟནལྟར།",
    "ཕྱོགས་གཅིག་ཏུ་བསྡུས་པ་སྣར་ཐང་གི།",
    "མཆོག་མཐུན་མོང་དངོས་གྲུབ་ལག་། མཐིལ་གྱི།",
    "མཆིམས་ཆེན་མོ་ནམ་མཁའ་གྲགས་པཞེས།",
    "སྟོང་གསུམ་མི་མཇེད་ཞིང་གི་བདག་པདེས།",
    "འགྲོ་བའི་རེ་བསྐོང་ལ་གསོལ་བ་འདེབས།",
    "དེ་སྲིད་ལམ་སྟོན་བཤེས་གཉེན་དམ་པ་ཁྱོད།",
    "ཤེསརབ་ཟབ་མོའིརླབས་འཕྲེང་ཆེར་གཡོ་བའི།",
    "འབྲལ་མེད་གསུང་གི་བདུད་རྩིར་སྤྱོད་པར་ཤོག།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་ས་གནོན་མཉམ་གཞག་གི།",
    "འོད་ཕུང་དབུས་ན་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའི།",
    "འོད་ཕུང་དབུས་ན་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའི།",
    "སོང་བའི་སྣེ་མོར་སེང་ཁྲི་པད་ཟླའི་སྟེང་།",
    "འོད་ཟེར་འཕྲོས་པའི་སྣེ་མོར་པད་ཟླའི་སྟེང་།",
    "བླམའི་ཚོགས་ཀྱིས་བསྐོར་ཞིང་དེ་དག་གི།",
    "བཤེས་གཉེནལམ་གུས་པ་ནས་བཟུང་སྟེ་བདག་གཉིས་སུམཚན་མརའཛིན་པའི་བར་གྱི་ཕྱིན་ཅི་ལོག་གི་བློ་སྣ་མཐའ་དགའགག་པ་དང་།",
    "ནས་རྡོ་རྗེ་འཆང་གི་གོའཕང་མྱུར་ཐོབ་ཤོག།",
    "རང་གི་སྤྱི་བོར་དགྱེས་བཞིནབཞུགས་པ་ནི།",
    "དད་ལྡན་སྐྱེས་བུའི་མིག་གི་དགའ་སྟོན་མཆོག།",
    "བལྟས་ནས་དདདང་མོས་གུས་ཤུགས་དྲག་གིས།",
    "གདམས་པ་ཟབ་མོ་ཁོང་དུ་ཆུད་པ་འདི།",
    "འདག་གིས་ཐོས་བསམ་སྒོམ་ལ་མ་འབད་ན།",
    "རང་རེ་འཆི་བར་འགྱུར་བ་སྨོས་ཅི་དགོས།",
    "ཕན་ཚུན་གཅིག་ལ་གཅིག་གིས་བསྣནཔ་ན།",
    "མེ་ལྕེ་འབར་ནསརང་གི་ལྟོ་བ་བསྲེག།",
    "གཉེན་པོ་སྟོབས་ཆུང་ཉོན་མོངས་སྟོབས་ཆེ་བས།",
    "ལསདང་ཉོན་མོངས་རྩད་ནས་འབྱིན་པའི་ཐབས།",
    "ལུས་དང་སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་བར།",
    "དེས་ན་བདག་གིས་སེམསཅན་ཐམས་ཅད་ཀྱི།",
    "ལ་ན་དང་རྣམ་པར་སྨིན་ལ་མི་རེ་བར།"
  ]
}