    "ཞེས་པ་ནི་མོས་པ་སྤྱོད་པའི་ས་ལས་འཕར་ཏེ་ཡེ་ཤེས་ཀྱི་ས་ལ་འཇུག་པའི་སྐབས་སུ་སྣང་བ་ཐོབ་པ་དང་།",
    "བདག་གི་ཕུང་པོ་གསོན་ན་ཞེས་པའོ།",
    "དེ་དག་གིས་ལྟས་ངན་པ་ལ་སོགས་པས་ཀྱང་མི་ཚུགས་ཞེས་པའོ།",
    "ཕྱི་རོལ་གྱི་དང་ནང་གི་སྟེ།",
    "དེ་ལ་ནང་གི་སེམས་ཀྱིས་མཉེས་པར་བྱ་བ་ནི།",
    "ཞེས་པ་ནི་ལྷ་རྣམས་ཀྱི་རང་བཞིན་ཤེས་བར་བྱས་ནས་དེ་དག་གི་གྲུབ་པའི་འབྲས་བུ་ཡང་ཤེས་པར་འགྱུར་ཞེས་པ་སྟེ།",
    "དེ་དག་གི་ཚད་དུ་གསུངས་པ་སྟེ།",
    "ཚད་ཅེས་པ་ནི་དེ་དག་གི་མཐུ་ལ་བྱའོ།",
    "ཞེས་པ་ནི་དེ་དག་གི་ཁྱད་པར་གསུངས་པ་སྟེ།",
    "འཇིག་རྟེན་པའི་ལྷ་རྣམས་འབྲས་བུ་ཚེ་འདི་ལ་འཕྲལ་དུ་སྟེར་མོད་ཀྱི།",
    "འཇིག་རྟེན་གྱི་འབྲས་བུ་ནི་བསྐལ་པ་གཅིག་གི་བར་དུ་ཐུབ་ཅེས་པའོ།",
    "དེ་ལ་དོན་དམ་པ་ནི་ཡི་གེ་ཨ་ལ་སོགས་པ་འབྲུ་རེའི་སྒོ་ནས་བསྟན་པའོ།",
    "ཞེས་པ་ནི་སྔོན་གྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལྷའི་རྣམ་པར་སྨིན་པའི་གཟུགས་ཕུང་པོ་ལྔ་འདི་ལས་ལས་ཀྱི་འབྲས་བུ་སྨིན་པར་གྱུར་པ་སྟེ་ནམ་བདག་གིས་ཏིང་ངེ་འཛིན་ལ་སོགས་པའི་གྲུབ་པ་ཐོབ་ན།",
    "ཚིག་གིས་གཟུགས་སུ་བཀོད་ཀྱི་འདིར་ནི་སེམས་རང་བཞིན་དངོས་སུ་གཞུག་ཏུ་མི་རུང་བའི་ཕྱག་རྒྱའི་གཟུགས་སུ་བཀོད་པ་སྟེ།",
    "མོས་པ་སྤྱོད་པའི་ས་ལ་གནས་པ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱིས་བཅད་པ་དང་སྣམ་བུའི་རིམ་པ་དང་ཚོན་དགྱེ་བ་ལ་སོགས་པའི་ཆོ་ག་རྣམས་ཀྱི་དཀྱིལ་འཁོར་གོང་མ་རྣམས་སུ་ཇི་སྐད་གསུངས་པ་བཞིན་ནོ།",
    "དེའི་སྟེང་དུ་པདྨོ་བྲི་བར་བྱ་བ་ནི་ས་བོན་དང་བཅས་པ་རྒྱས་པར་ཏེ་ཞེས་པ་ནི་རྡོ་རྗེ་དེའི་སྟེང་དུ་པདྨོ་འདབ་མ་བཞི་པ་རང་གི་ས་བོན་དང་བཅས་པ་བྲི་བའོ།",
    "དེ་ནི་ཕྱོགས་བཅུ་ཀུན་དུ་སོང་།",
    "དེ་ནི་ཕྱོགས་བཅུ་ཀུན་དུ་སོང་།",
    "རང་གི་ས་བོན་གྱིས་ཀྱང་གདབ།",
    "རང་གི་ས་བོན་དང་བཅས་པ་བྲི་ཞེས་པའོ།",
    "ཞེས་པ་ནི་དཀྱིལ་འཁོར་དེ་རང་གི་ས་བོན་ཡི་གེ་པ་ཀླད་ཀོར་དང་བཅས་པའི་མཚན་མས་བཏབ་ཅེས་པའོ།",
    "ཞེས་པ་ནི་རང་གི་ས་བོན་ཡི་གེ་ཧ་དང་བཅས་པར་ཤེས་པར་བྱ་ཞེས་པའོ།",
    "ཞེས་པ་ནི་པདྨའི་སྟེང་དུ་རྡོ་རྗེ་དམར་སྨུག་གི་ཁ་དོག་ཏུ་བྲིས་ཏེ།",
    "དཔའ་བོ་ཁྱོད་ཀྱི་དཀྱིལ་འཁོར་འདི།",
    "ཞེས་པ་ནས་མཐུ་ཆེན་དང་ལྡན་པའོ་ཞེས་པའི་བར་དུ་ཕྱག་ན་རྡོ་རྗེའི་དཀྱིལ་འཁོར་འོག་ལོགས་སུ་ནམ་མཁའ་དྲི་མ་མེད་པ་ལ་སོགས་པའི་རྡོ་རྗེ་འཛིན་བཅུ་གཉིས་མིང་གིས་སྨོས་པ་རྣམས་བྲིས་ཏེ།",
    "ཞེས་པ་ནི་རྡོ་རྗེ་འཛིན་པ་དེ་དག་གི་རྗེས་སུ་བསྔགས་པ་སྟེ་གདུལ་དཀའ་བ་རྣམས་འདུལ་ནས་ཞེས་པའོ།",
    "དེའི་སྟེང་དུ་འཕགས་པ་མི་གཡོ་བའི་ཕྱག་རྒྱ་རལ་གྲིའམ་ཞགས་པ་གང་ཡང་རུང་བ་ཅིག་རང་གི་ས་བོན་དང་བཅས་པར་བྲི་ཞེས་པའོ།",
    "དེའི་དབུས་སུ་རྡོ་རྗེའི་ཕྱག་རྒྱ་རང་གི་མཚན་མ་དང་བཅས་པར་ཞེས་སོ།",
    "ལྷ་མོ་དེའི་ཁ་དོག་ཀྱང་སེར་པོར་བྱ་སྟེ།",
    "ཞེས་པ་ནི་གཞན་གྱིས་མི་ཐུབ་ཅེས་བྱ་བའི་རིག་པའི་རྒྱལ་མོ་ཕྱག་རྒྱར་བྲི་སྟེ་པདྨོ་ནག་པོའི་སྟེང་ན་གནས་པར་བྱའོ།",
    "བསམ་པའི་ལག་པ་ནི་ཐལ་མོ་འགྲམ་པ་ལ་བརྟེན་པ་སྟེ་དཀྱིལ་འཁོར་དུ་བྲི་བར་བྱ་ན།",
    "འགྲམ་པ་མི་བྲི་བར་ཐལ་མོ་འབའ་ཞིག་གྱེན་ཤོར་འདུག་པར་བྲིའོ།",
    "བུམ་པར་ཤེས་པར་བྱ་བ་བདག་གི་ཆུས་གང་རྡོ་རྗེས་བརྒྱན་བཞིན་ནོ་ཞེས་པ་ནི་ས་བདག་གི་ཕྱག་རྒྱ་བུམ་པ་ཆུས་གང་པ་རྡོ་རྗེས་བརྒྱན་པར་བྲི་ཞེས་པའོ།",
    "མེའམ་འབུད་པའི་ཐབ་བཞིན་གྱི།",
    "ཞེས་པ་ནི་བསོད་སྐྱབས་ཞེས་པ་ལ་སོགས་པའི་དྲང་སྲོང་མིང་གིས་སྨོས་པ་རྣམས་དང་ལྷན་ཅིག་ཏུ་བྲི་ཞེས་ཏེ་ལག་པ་སྨྲང་འདོན་པ་བཞིན་དུ་བྱ་ཞེས་པ་ནི།",
    "དྲང་སྲོང་རྣམས་ཀྱི་ཕྱག་རྒྱ་སྨྲང་འདོན་པའི་ལག་པ་ལྟར་མཐེ་བོ་སོར་མོའི་ཚིགས་སུ་འཇོག་པར་བྱའོ།",
    "འཆི་བདག་གི་དྲིལ་བུར་ཏེ་ཞེས་པ་ནས་གྲུབ་པར་འདོད་པ་རྣམས་ཀྱིས་སོ།",
    "ཞེས་པའི་བར་དུ་གཤིན་རྗེའི་འཁོར་འཆི་བདག་དང་དུས་མཚན་མོ་ལ་སོགས་པའི་ཕྱག་རྒྱ་མིང་གིས་སྨོས་པ་རྣམས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཐ་མར་ཁྭ་དང་བྱ་རྒོད་ལ་སོགས་པས་བསྐོར་བར་བྲིའོ།",
    "རང་གི་ས་བོན་ཚུལ་བཞིན་ནོ།",
    "ཕོ་ཉ་དག་གིས་གསུངས་པ་ནི།",
    "རྡོ་རྗེ་དེ་ལྟར་བྱེ་བྲག་ཆེ་བས་རྡོ་རྗེ་གོང་མ་གཉིས་ཕྱོགས་རེ་རེ་ནས་རྩེ་གསུམ་པ་དང་རྩེ་གཅིག་པར་ཤེས་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་དུ་འཇུག་པའི་རིམ་པ་ལྔ་སྟེ་ནུབ་མོ་ལྷག་པར་གནས་ཤིང་སྡོམ་པ་གཟུང་བ་ལ་སོགས་པ་དང་།",
    "སློབ་དཔོན་ཡང་སྔ་མ་བཞིན་དུ་རང་རང་གི་ཏིང་ངེ་འཛིན་ལ་གནས་ནས།",
    "ཨ་ལས་བཅོམ་ལྡན་འདས་ཀྱི་སྐུར་གྱུར་པར་བསམ་མོ།",
    "ཤིན་ཏུ་ཚིག་ནས་ཐལ་བར་འགྱུར།",
    "ཡན་ལག་བཅུ་གཉིས་ཚིག་གིས་བཏབ།",
    "རང་གི་གཟུགས་ཀྱི་དཀྱིལ་འཁོར་དང་གཟུགས་བརྙན་གྱི་དཀྱིལ་འཁོར་རོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་དེའི་ཚེ་མ་འོངས་པའི་འགྲོ་བ་ལ་གཟིགས་ནས་ཀུན་རྗེས་སུ་ཆུད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "རི་མོ་རྣམས་ཀྱིས་བརྒྱན་པར་བྱ་བའི་ཐབས་བསྟན་པའོ།",
    "དེ་དག་གི་ཁ་དོག་དང་གཟུགས་སྣ་ཚོགས་སུ་བཅས་པ་ཞེས་པའོ།",
    "དེ་ནས་ལས་ཀྱི་རྡོ་རྗེར་བསྒྱུར་ཏེ་དེ་རྣམས་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསྟན་ཏོ།",
    "བདག་གི་ལུས་ཉིད་རྡུལ་ལ་སོགས་པའི་ཚུལ་དུ་བཤིགས་ཏེ།",
    "གསེར་གྱི་དཀྱིལ་འཁོར་དེའི་སྟེང་དུ་བདག་གི་ལུས་ལྟེ་བ་མན་ཆད་ཀྱང་གསེར་གྱི་དཀྱིལ་འཁོར་གྲུ་བཞི་པར་བསམས་ཏེ།",
    "བྱང་ཕྱོགས་ཀྱི་འདབ་མ་ལ་རྔ་དབྱངས་དེ་བཞིན་གཤེགས་པ་བསམ་མོ།",
    "དེ་རྣམས་ཀུན་གྱི་སྐུ་བདག་གི།",
    "ས་བཅུ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་དང་ཏིང་ངེ་འཛིན་རྣམས་ལྷ་མོའི་གཟུགས་སུ་བསམ་མོ།",
    "སྐྱོང་བ་དང་ཁྲོ་གཉེར་ལ་སོགས་པ་རིམ་བཞིན་དུ་བསམ་མོ།",
    "སྟེགས་བུ་ཞེས་པ་ནི་དབུས་ཀྱི་གཞིའི་གདན་དེ་ཉིད་ལ་བྱ་སྟེ་དེ་ཡང་གསེར་གྱི་ཁ་དོག་ཏུ་བསམ་མོ།",
    "སེམས་ཀྱིས་ཤིན་ཏུ་ཐོབ་ཅེས་པ་ནི་སྟོང་པ་ཉིད་ཀྱི་མཚན་ཉིད་དེ་སོ་སོར་རང་གིས་རིག་པ་ཐོབ་པ་ཞེས་པ་སྟེ།",
    "དེས་ནི་རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་བསྟན་པའོ།",
    "གཟུགས་བརྙན་གྱི་དཀྱིལ་འཁོར་རྣམས་རྫོགས་པ་རྒྱས་པར་བྲི་མི་ནུས་ཤིང་ཟབ་ཅིང་རྒྱ་ཆེ་བ་ལ་མོས་པས་དཀྱིལ་འཁོར་འདི་བྱ་ཞེས་པའོ།",
    "དྲུང་གི་ས་གཞི་ཀུན་དུ་ནི།",
    "རང་ལུས་རང་གིས་བྱ་བ་ནི།",
    "སྔགས་པ་སྦྱར་སྟན་དེར་འདུག་ནས་། དེ་བཞིན་གཤེགས་རྣམས་རྗེས་མོས་པས།",
    "ཞེས་པ་ནི་དེ་ལྟར་བདག་གི་དེ་ཁོ་ན་ཉིད་བདག་ནི་ལྷ་གང་ཡིན་པའི་གཟུགས་སུ་བསྒྱུར་བ་ཏིང་ངེ་འཛིན་འཁྲུགས་པ་དང་ལྷ་ཇི་བཞིན་པའི་བར་སྣང་བ་རྣམ་པར་རྟོག་པ་གཞན་མེད་པར་ལྷའི་གཟུགས་ཉིད་ཡིད་ལ་ཐེ་ཚོམ་མེད་པར་སྣང་ན་དེ།",
    "དེ་ནི་རིག་པ་དང་རྗེས་སུ་མཐུན་པའི་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་སྤྱོད་པ་དེ་སྔར་བདག་གིས་ལྷའི་གཟུགས་སུ་བསྒྱུར་ནས།",
    "དེའི་འོག་ཏུ་རང་གི་སེམས་ཡོངས་སུ་སྦྱང་བའི་ཕྱིར་ལྷའི་གཟུགས་སུ་བསྒྱུར་བ་དེ་སོ་སོ་ནས་མི་ཞིག་པར་ཡིད་ལ་མི་བྱ་བའི་ཚུལ་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ལ་གནས་པར་བྱའོ།",
    "བདག་གི་ལུས་ཀྱང་ཆུའི་རང་བཞིན་ལྟར་སྔོ་བར་བསྒོམ་ཞིང་པདྨོའི་ཕྱག་རྒྱ་བཅིངས་ལ་ཟླ་བ་གཅིག་ཏུ་བཟླས་པ་བྱ་སྟེ།",
    "བདག་གི་ལུས་རོ་སྟོད་མེའི་རང་བཞིན་དུ་འབར་བ་བཞིན་དུ་བསམ།",
    "ཕྱག་བྱས་ལ་སྦྱོར་བའི་སྐྱིལ་མོ་ཀྲུང་དུ་བཅས་ཏེ་སེམས་དང་ལུས་མཉམ་པར་བཞག་ནས་གོང་དུ་སྨོས་པ་རྣམས་ཞེས་པའོ།",
    "རང་གི་ལུས་ལ་གནས་པའོ།",
    "སློབ་དཔོན་དེ་མོས་པ་སྤྱོད་པའི་ས་ལ་གནས་ཏེ་དེ་བཞིན་གཤེགས་པ་མ་ཡིན།",
    "དེ་བཞིན་དུ་འཇིག་རྟེན་ན་སྣང་བ་ཆར་ཆུ་མོད་ཅིང་།",
    "དག་གི་རང་བཞིན་གྱི་ཡི་གེ་རྣམས་བདག་གི་ལུས་ལ་ཚང་བ་དང་།",
    "ཨ་ཞེས་པ་ནི་སྲོག་གི་མཆོག།",
    "ཞེས་པ་ནི་སྨིན་མཚམས་སུ་ཡི་གེ་ཧཱུཾ་གི་དཀྱིལ་འཁོར་དང་བཅས་པར་བསམ་མོ།",
    "ཞེས་པ་ནི་དེ་དག་གི་རྗེས་སུ་བསམ་པ་སྟེ།",
    "འཇིག་རྟེན་པ་རྣམས་བདག་གི་དངོས་པོ་ལ་ཆགས་ཤིང་གཞན་གྱི་རྐྱེན་གྱིས་འགྱུར་རོ་ཞེས་པ་ནི་འཇིག་རྟེན་པ་རྣམས་སྐྱེ་བ་དང་འཇིག་པ་དང་བདེ་བ་དང་སྡུག་བསྔལ་བ་དང་བསླབ་པའི་དངོས་པོ་ལ་སོགས་པ་ཐམས་ཅད་བདག་ཅེས་པའི་དངོས་པོ་དེས་བྱའོ་ཞེས་པ་ནས།",
    "རོལ་མོ་ལ་སོགས་པ་བཟོ་རྣམ་པ་མང་པོ་སྟོན་པ་ཡང་།",
    "དེ་ལྟ་བུར་སློབ་པས་ལྟུང་པའི་རྩ་བ་འདི་བཞི་སྲོག་གི་ཕྱིར་ཡང་ཉམས་པར་མི་བྱའོ་ཞེས་པ་དང་སྦྱར་ཏེ།",
    "དེ་དག་གི་རྗེས་སུ་སློབ་པ་ཞེས་བྱའོ།",
    "ཞེས་པ་ནི་དེ་བཞིན་ནི་འཇིགས་པར་བྱེད་པའི་ཐབས་དང་ཤེས་རབ་ཏུ་སྦྱར་བར་རང་བཞིན་གྱིས་ཉོན་མོངས་པ་ཡིན་ཏེ་སླར་དབྱུང་དུ་མེད་པ་ཞེས་པ་དང་སྦྱར་རོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་མི་ཟད་པ་ལ་སོགས་པའི་རྡོ་རྗེའི་རྒྱན་གྱི་འཁོར་ལོ་འདིར་བྱིན་གྱིས་བརླབས་པ་ལས་སྔགས་བཟླས་པའི་སྐབས་ལ་ཐོག་མར་སྤྱིར་ཕྱི་ནང་གི་བཟླས་པ་ཡན་ལག་བཞི་བསྟན་ཏེ།",
    "དང་པོ་ཉིད་དུ་ཕྱི་ནང་གི་བཟླས་པའི་ཡན་ལག་བཞི་ཕྱི་དང་ནང་གཉིས་ཀ་ལ་དམིགས་པས་སྤོམ་མོ།",
    "ཡི་གེ་ཨཾ་གིས་བྱིན་གྱི་བརླབ་པ་སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཆེན་པོས་འཁོར་འདུས་པ་ཐམས་ཅད་ལ་གཟིགས་ནས་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "འདིར་ནི་གནས་ཡོངས་སུ་འགྱུར་པའི་མཚན་མ་བྱུང་གི་བར་དུ་བཟླས་པ་གསུངས་པས་མཚན་མ་བྱུང་བ་དེ་ཉིད་འགྲུབ་པ་སྟེ།",
    "ཆུད་པའི་མཚན་ཉིད་དང་གཞུང་གི་མཚན་ཉིད་དེ།",
    "གཞུང་གི་མཚན་ཉིད་ལ་ཡང་དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་མཚན་ཉིད་དེ་དེ་ལྟར་རྣམ་པ་གསུམ་མོ།",
    "བདག་གི་ནང་ཉིད་དག་པས་སོ།",
    "བདག་གི་ནང་ཉིད་དག་པས་སོ།",
    "བདག་གི་ལྟ་བས་བཅོམ་ལྡན་འདས་ཀྱི་སྐུར་བསྒྱུར་བ་ཙམ་གྱིས་ཆོག་པ་མ་ཡིན་གྱི།",
    "ཡི་གེ་ཨཾ་གི་ཚིག་གི་རང་བཞིན་དུ་བལྟ་སྟེ།",
    "དེ་ཡང་འདི་ལྟར་དོན་དང་ཚིག་གི་བྱེ་བྲག་རང་བཞིན་གསུམ་དུ་དབྱེ་མོད་ཀྱི།",
    "གང་གིས་བྱ་བའི་ལས་ཀྱང་གཟུགས་དང་སེམས་ཀྱིས་བྱེད་པའི་གཟུགས་ཀྱིས་བྱ་བའི་ལས་ཀྱང་ངག་དང་སེམས་ཀྱིས་བྱ་བའི་ལས་ཀྱང་ལུས་དང་ངག་གིས་བྱེད།",
    "དམ་ཚིག་ཅེས་པ་ནི་ཚིག་གི་དོན་ནི་སྐབས་འདིར་ཀུན་དུ་ཆུད་པའམ་ཐོབ་པ་ལ་བྱ་སྟེ།",
    "གསང་བའི་བདག་པོ་ངའི་ངག་གི་འཁོར་ལོ་ཞེས་པ་ནས།",
    "དེ་དག་གི་བསྡུས་པའི་དོན་དུ་ཚིག་གི་དོན་ལ་འོན་ཀྱང་ཞེས་པ་ནི།",
    "མེ་ཏོག་གི་གཞི་ཞེས་པ་ནི་འཇིག་རྟེན་གྱི་ཁམས་དེ་མེ་ཏོག་གིས་བརྒྱན་པའོ།",
    "རྒྱན་ཞེས་པ་ནི་འཇིག་རྟེན་གྱི་ཁམས་མེ་ཏོག་གིས་བརྒྱན་པ་སྟེ།",
    "དེ་དག་གི་ལུས་ཀྱང་སེམས་ཇི་སྙེད་པ་དེ་ཉིད་ཀྱི་ལུས་ཁྱབ་པར་འགྱུར་ཏེ།",
