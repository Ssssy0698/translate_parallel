    "བསྐོར་བ་གཅིག་གིས་བསྐོར་བ་འབུམ་ཐེར་འགྱུར།",
    "ཨོཾ་ཨཱ་མུ་ཏྲ་ཨཱ་ཧ་རེ་བྷྱ་སྭཱ་ཧཱ།",
    "ཨཱོྃ་ཨཱ་བིཥྛ་ཨཱ་ཧ་རེ་བྷྱ་སྭཱ་ཧཱ།",
    "ཅེས་བརྗོད་དྲི་ཆེན་དྲི་ཆུའང་ཚོགས་སུ་འགྱུར།",
    "སྔགས་ལྟར་ཡི་དམ་ལུས་དཀྱིལ་གསལ་བཏབ་ནས་། ལྟེ་འོག་གཏུམ་མོ་ཡེ་ཤེས་མེ་ཡིན་ལ།",
    "དེ་ནི་ནང་གི་སྦྱིན་སྲེག་ཅེས་བྱ་སྟེ།",
    "ཨཱོྃ་ཨ་མྲྀ་ཏེ་ཧཱུཾ་ཕཊ།",
    "སྐྲ་དང་སེན་མོའི་རྩེ་ཡང་མི་བྲེག་གསུངས།",
    "རྫོགས་རིམ་ཟབ་མོའི་ཁྲིད་ཀུན་ཞོར་ལ་རྫོགས།",
    "སྤྲོས་བཅས་སྤྲོས་མེད་རེས་མོས་བྱས་པ་ཡིས།",
    "གཅིག་བོགས་གཅིག་གིས་ཐོན་ཏེ་ཉམས་རྟོགས་འཕེལ།",
    "སྒྲུབ་ཕྲན་ཡིན་ན་དྲིལ་བུའི་སྐད་ཐོས་ཕན་། སོང་ན་བར་ཆད་འོང་བས་ཤིན་ཏུ་འཛེམ།",
    "སྒྲུབ་ཆེན་སྒྲུབ་ཕྲན་སོང་བའི་བར་སྐབས་སམ།",
    "འགྲོ་ཁ་རང་གི་ཉལ་ས་མལ་གོས་ནང་།",
    "ཉལ་ཁ་ཀུ་ས་ལི་ཡི་ཚོགས་སོགས་བདག་འཛིན་གཅོད་པའི་སྟ་རེ་བཞུགས་སོ།",
    "ན་མོ་པྲཛྙཱ་པ་ར་མི་ཏ་ཡེ།",
    "དེ་ཉིད་རྡོ་རྗེ་ཕག་མོའི་སྐུར་གྱུར་ཏེ།",
    "སྤར་ཝིག་བྱས་ན་ལེགས་ཤིང་མ་བྱས་ཀྱང་། གོང་གི་བདུད་རྩིའི་ལྷག་མ་དེ་ཉིད་ནི།",
    "རེ་རེ་ལའང་བརྒྱ་སྟོང་གྲངས་མེད་འཕྲོ།",
    "རང་གི་ཐུགས་ལས་སྤྲོས་པའི་ཌཱ་ཀི་ནི།",
    "ཕག་ཁྱི་ལྕེ་སྤྱང་སྟག་གི་གདོང་ཅན་ཚོགས།",
    "མ་མོ་བྱེ་བ་གནོད་སྦྱིན་ཁྲི་ཡི་ཚོགས།",
    "རང་གི་ཕ་མྱེས་བརྒྱུད་ལ་ཡོད་དང་མཐུན།",
    "འདིར་ནི་དོན་བསྡུས་ཉུང་ངུ་ཚིག་གིས་བཀོད།",
    "དེ་མིན་གོང་གི་དམིགས་རིམ་ཚན་གསུམ་པོ།",
    "ཞག་རེ་ཙམ་ནས་འཕྲལ་དུ་བདེ་བ་ནི།",
    "ས་རྡོ་རི་བྲག་ཕག་མོ་དམར་མོར་བསྒོམ།",
    "ཐོག་སྲུང་རང་གི་སྤྱི་བོའི་ནམ་མཁའ་ལ།",
    "རང་གི་རྐང་འོག་གཡུ་ཡི་གྲོད་པ་ཞིག།",
    "རང་གི་པགས་པས་འཛམ་གླིང་ཁྱབ་པའི་སྟེང་།",
    "ཁྲོམ་ཚོགས་བཞིན་དུ་ཕག་མོའི་འོད་ཀྱིས་བསྡུས།",
    "དེ་ལ་དཀར་འགྱེད་དམར་འགྱེད་ལན་མང་བྱས་། ཕག་མོས་ཟིལ་མནན་ཆར་པའི་ལས་ལ་བསྐུལ།",
    "ཕག་མོས་ཟིལ་མནན་ཆར་བཀག་ལས་ལ་བསྐུལ།",
    "གོང་གི་ལུས་སྦྱིན་དམིགས་རིམ་གསུམ་གྱི་རྗེས།",
    "རང་གི་འོག་རྟ་གྲྭ་ཁལ་གོད་དོགས་ན་། དུད་འགྲོ་ཤ་མེད་ཀེང་རུས་སྐམ་པོ་ལ།",
    "གུང་གི་ཐུན་ལ་ཇི་ལྟར་སྨྲས་པ་རྣམས།",
    "ན་མོ་ཨཱརྱ་ཏཱ་རེ་ཡེ།",
    "ཚེ་འཕེལ་ལྷ་མོ་གཉིས་ཀྱི་གདམས་པ་ཟབ།",
    "ཏཱཾ་ཡིག་མཐའ་རུ་འདོད་གསོལ་དེ་ཡིས་བསྐོར་། དེ་རྒྱབ་ཏཱཾ་གི་གཡས་ཨོཾ་གཡོན་དུ་ཧྭ།",
    "ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ།",
    "རང་གི་སྐུ་ཡི་འོད་ཟེར་ལས་གྲུབ་པའི།",
    "སྲོད་དང་ཐོ་རངས་དམིགས་པ་ཐུན་རེ་བསྒོམ།",
    "ༀཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་གང་བྱེད་མཚན་སྔགས་དང་།",
    "བ་མོར་ཉི་ཟེར་ཕོག་ལྟར་ཞི་བར་བསྒོམ།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་ཆུ་དང་གཡང་ས་ཆོམ་རྐུན་གྱི་འཇིགས་པ་ཤཱནྟིཾ་ཀུ་རུ་སྭཱ་ཧྭ།",
    "བཟོ་མཁན་བུ་མོ་མགོ་གཙང་ཡོད་ན་མཆོག།",
    "ཨ་མྲྀ་ཏ་དང་སྭ་བྷཱས་བསངས་ཤིང་སྦྱང་།",
    "ༀཏཱ་རེ་ཏུཏྟཱ་རེ་འདི་འཆང་བ་ལ་ཆོམ་ང་གཅན་གཟན་གྱི་འཇིགས་པ་ལས་སྲུངས་ཤིག་རཀྵ་རཀྵ་ཀུ་རུ་ཡེ་སྭྰ་ཧྭ་། དེ་ལྟར་བརྒྱ་སྟོང་ལ་སོགསཅི་ནུས་སྔགས།",
    "ཡེ་ཤེས་ལྷ་མོ་ཚེ་འཕེལ་གོས་དཀར་མོ།",
    "རང་ཉིད་དྲན་རྫོགས་རྡོ་རྗེ་ཕག་མོར་བསྒོམ་། རང་ལུས་སྟོང་གསལ་སྐུ་ཡི་གནས་ལྔ་ན།",
    "རང་གི་སྤྱི་བོར་པདྨ་ཟླ་བའི་སྟེང་།",
    "རང་གི་ཚངས་བུག་ནས་ཞུགས་རང་ལུས་གང་།",
    "རང་གི་གནས་ལྔའི་ཚེ་དཔག་རིགས་ལྔ་ལས།",
    "སྔགས་ནི་ཨ་མཱ་ར་ཎི་ཚེ་གཟུངས་བཟླས།",
    "དེ་ནི་རང་གི་ཚེ་བསྲིང་དམིགས་པ་སྟེ།",
    "འོད་ཟེར་ཉི་མའི་ཟེར་བཞིན་དཔག་མེད་འཕྲོས་། འོད་དེའི་རྩེ་མོར་འོད་དཔག་མེད་རེ་རེ།",
    "བསྲུང་བྱ་རེ་རེའི་སྤྱི་བོར་རེ་རེ་བཞུགས།",
    "འདི་ལྟར་ཐུན་རེ་རྒྱུན་དུ་དམིགས་པའམ།",
    "བ་སྤུའི་རྩེ་མོ་ཙམ་ཡང་གཅོད་མི་ནུས།",
    "མཐོང་བ་དོན་ལྡན་སྐུ་ན་ཕྲ་མོའི་དུས།",
    "ང་ཡི་སྐུ་རིམ་རང་རེས་བྱེད་མི་དགོས།",
    "མ་བཞུགས་ནའང་རང་གི་ཚེ་འཕེལ་བའི།",
    "རང་རེར་ངན་སྔགས་མཐུ་གཏད་བྱེད་མཁན་འདུག།",
    "ཡེ་ཤེས་ལྷ་མོ་སྒྲོལ་དཀར་ཚེ་འཕེལ་མ།",
    "ཚེ་བསྲིང་དཔལ་བསྐྱེད་གདམས་ངག་ཟབ་མོ་འདིས་། གཞན་ལ་མི་གནོད་རང་ལ་ཉེས་སྒྲིབ་མེད།",
    "བདག་གི་རྒྱུན་གྱི་ཉམས་ལེན་ཟབ་མོ་འདི།",
    "ན་མོ་གུ་རུ་བཛྲ་པཱ་ཎི་ཡེ།",
    "སྔགས་ཀྱི་ལུགས་ལ་ཉོན་མོངས་སྤང་བ་དང་།",
    "ཉོན་མོངས་སྦྱང་དང་ཉོན་མོངས་བསྒྱུར་བ་དང་།",
    "ཉོན་མོངས་ལམ་དུ་ཁྱེར་དང་རང་བཞིན་ཤེས།",
    "སྦྱིན་པའི་མཆོག་གྱུར་རང་གི་མགོ་བོ་ཡང་།",
    "བསྐལ་པ་གྲངས་མེད་གཅིག་གི་བར་དག་ཏུ།",
    "བདག་གི་འདྲེན་མཆོག་དྷརྨེ་ཤྭ་རས་གསུངས།",
    "ནང་གི་སེམས་ཉིད་ཡི་དམ་ལྷ་རུ་བཞེད།",
    "ལྔ་བརྒྱ་ཕྲག་རེར་དེ་དག་ཐོབ་པ་མང་།",
    "དེ་རྗེས་ལུང་གི་བསྟན་པ་ལྔ་བརྒྱ་ཕྲག།",
    "དེ་ཕྱིར་ལུང་གི་བསྟན་པ་ཞེས་བྱའོ།",
    "རེ་རེ་ལ་ཡང་ལྔ་བརྒྱ་ཕྲག་རེ་གནས།",
    "རེ་རེ་ནུབ་ཀྱང་རེ་རེ་དར་བ་སྟེ།",
    "གསར་རྙིང་རྒྱུད་གཞུང་རྒྱ་ཆེར་གཟིགས་དང་གསལ།",
    "རཱ་ག་ཨ་སྱས་འཕྲལ་དུ་གང་དྲན་སྨྲས། ། ན་མོ་གུ་རུ་ཨཱརྱ་པ་ལོ་ཡེ།",
    "རང་གིས་བྲི་འམ་གལ་ཏེ་མི་ཤེས་ན།",
    "ནངས་རེ་བཞིན་དུ་ཡན་ལག་ལྔ་ཁྲུས་བྱ།",
    "སྐྱིལ་ཀྲུང་མི་བཅའ་ཙོག་པུར་ཐལ་མོ་སྦྱར།",
    "མཁྱེན་པས་གཟིགས་ཏེ་སྐད་ཅིག་དེ་ཉིད་ལ།",
    "ཚར་ནས་སླར་ཡང་ཁྲུས་དང་ཆབ་བླང་ངོ་། འདི་སྐབས་ཉོན་མོངས་དུག་ལྔ་འདུལ་ཚུལ་ནི།",
    "དེ་བཞིན་ཆུ་བུར་མིག་གིས་མ་མཐོང་ཡང་།",
    "ཡེ་ཤེས་ལྷ་དེ་མདུན་དུ་ངེས་པར་བཞུགས་། དེ་ཕྱིར་ཉོན་མོངས་རྟོག་པ་འཕྲེང་མི་ཕོད།",
    "དེ་ལ་གོམས་ནས་ཉོན་མོངས་ཤུགས་ཀྱིས་འགག།",
    "ནུབ་མོ་ཉལ་ཁ་ཐུན་ནི་འཇོག་པའི་ཚེ།",
    "ཕྱིར་ནངས་སྐྱ་རེངས་ཤར་ནས་གོས་ཚགས་བསྡམ།",
    "བསྲེས་པའི་ཞོ་ཟན་དག་གིས་བཀང་བྱས་ཏེ།",
    "ལྷ་དང་ལྷ་མོའི་གཟུགས་ཅན་རིག་འཛིན་ནི།",
    "སྤྱན་རས་གཟིགས་དང་སྒྲོལ་མ་ལ་སོགས་པའི།",
    "མཐོང་ཐོས་དྲན་རེག་ཐམས་ཅད་འདྲེན་ནུས་སོ།",
    "ཡི་གེ་པ་ཡང་བཱིརྱ་སཱ་ག་ར། ། ན་མོ་གུ་རུ་བཛྲ་པཱ་ཎི་ཡེ།",
    "རྟེན་གྱི་དྲུང་དུ་རང་གིས་ལེན་མི་ཆོག།",
    "མེད་ན་ཉིན་རེ་བཞིན་དུ་རྟེན་དྲུང་བླང་།",
    "ཉིན་ཞག་གཅིག་གི་སྡོམ་པ་ཡིན་ན་ཡང་།",
    "དེ་བཞིན་དགེ་ཚུལ་དང་ནི་དགེ་སློང་གིས།",
    "གནས་གསུམ་ཨོཾ་ཨཱ་ཧཱུྃ་གི་ཡི་གེ་གསུམ།",
    "འཕྲོས་ནས་རང་གི་སྔགས་ཕྲེང་ཟླ་བར་ཐིམ།",
    "དེ་ཚེ་ཉོན་མོངས་སྐྱེ་བའི་གོ་སྐབས་མེད།",
    "དེ་མིན་མང་པོ་བདག་གིས་མ་མཐོང་ངོ།",
    "རྣལ་འབྱོར་རྒྱུད་ཀྱི་ཉམས་ལེན་ངན་སོང་སྒོ་གཅོད་ཅེས་བྱ་བ་བཞུགས།",
    "ན་མོ་གུ་རུ་བེ་རོ་ཙ་ན་ཡེ།",
    "ནང་གི་རྣལ་འབྱོར་ཏིང་འཛིན་གཙོ་ཆེ་བས།",
    "འཇམ་དབྱངས་སྤྲུལ་པ་ལོ་ཆེན་རིན་བཟང་གིས་། རྣལ་འབྱོར་རྒྱུད་དང་ཁྱད་པར་སྤྱོད་རྒྱུད་འདི།",
    "བྱ་སྤྱོད་རྒྱུད་གཉིས་འགྲུབ་པའི་རེ་བ་མེད།",
    "དེ་བཞིན་རྡོ་རྗེ་གདན་པ་ཆེ་ཆུང་གིས།",
    "གོང་གི་རྒྱ་གཞུང་དེ་དག་ཀུན་དང་མཐུན།",
    "ཀུན་མཐུན་ཀུན་ལས་ལྷག་པ་ཡིན་མོད་ཀྱི།",
    "འདི་ལ་ཟུག་རྔུ་ལྡན་པ་འགའ་ཞིག་གིས།",
    "འདི་ཡི་རྒྱུད་ནི་གང་ལ་བརྟེན་པ་ཡིན་། ཟེར་ནས་ཅོ་འདྲི་བྱེད་པ་བདག་གིས་ཐོས།",
    "རྣལ་འབྱོར་རྒྱུད་ལ་མོས་པའི་དབྱངས་ཆུང་འདི།",
    "བིརྱ་སཱ་ག་ར་ཡང་དགོད་ཅིང་བྲིས། ། ན་མོ་གུ་རུ་སརྦ་བིད་ཡེ།",
    "དེ་གཉིས་རྡོར་ཕྲེང་སོགས་ལས་འབྱུང་མོད་ཀྱི་། ཆོ་གའི་ཁོག་ནི་ཀུན་རིག་སོགས་དང་མཐུན།",
    "འཕྲོས་པའི་རྒྱུད་ནི་ངན་སོང་སྦྱོང་རྒྱུད་དང་།",
    "རང་རེ་བཙུན་པ་རི་ཁྲོད་འགྲིམ་པ་རྣམས།",
    "ངན་སོང་གནས་སུ་ལན་གཅིག་སྐྱེ་དགོས་ཏེ།",
    "རང་དོན་ངན་སོང་སྦྱོང་ཐབས་གལ་ཆེན་ཡིན་། བྱང་བུ་ཕྱིར་ལྡོག་བསྔོ་ཞུས་ལ་སོགས་པ།",
    "ངན་སོང་སྡུག་བསྔལ་ཨེ་སྐྱོབ་རེ་བ་བཅས།",
    "སྦྱོང་རྒྱུད་ལས་ལྷག་ངན་སོང་སྦྱོང་ཐབས་མེད།",
    "ད་ནངས་སྔོན་འགྲོ་རེ་རེ་བཏང་བས་ཆོག་དེ་ནས་ཐུན་བཞིའམ་ནི་ཐུན་གསུམ་དུ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་ཧཱུཾ་གིས་མཚན་པའམ།",
    "རང་རང་སྔགས་རྣམས་མོས་པ་ཙམ་གྱིས་ཆོག།",
    "ངན་སོང་གསུམ་གྱི་འགྲོ་བ་ཐམས་ཅད་གསལ།",
    "ངན་སོང་སྐྱེ་བའི་རྒྱུ་ཡི་སྡིག་སྒྲིབ་དང་།",
    "འབྲས་བུ་ངན་སོང་སྡུག་བསྔལ་ཐམས་ཅད་ནི།",
    "བ་མོར་ཉི་ཟེར་བཞིན་དུ་སངས་སེ་དག།",
    "འོད་ཟེར་ཚུར་འདུས་རང་གི་ཐུགས་ཀར་ཐིམ།",
    "འོད་ཟེར་དེ་ཡི་ཟེར་མ་རེ་རེས་ཀྱང་།",
    "འོད་ཟེར་ཚུར་འདུས་རང་གི་ཐུགས་ཀར་ཐིམ།",
    "སླར་ཡང་ཉེ་རེག་ཆབ་དང་ཁྲུས་བྱས་ནས།",
    "དུས་ནི་རབ་ནི་ཟླ་དྲུག་འབྲིང་གིས་གསུམ།",
    "ཐ་མ་ཟླ་གཅིག་གིས་ཀྱང་རུང་བ་ཡིན།",
    "འཁོར་སྔགས་སོ་སོར་ཁྲི་ཕྲག་བཞི་རེདང་། སྦྱིན་སྲེག་ཁྲི་ཕྲག་བཞིའམ་ཡང་ན་གཅིག།",
    "འབྲིང་ལ་ཕྲེང་སྐོར་རེ་རེའི་གོ་ལ་ནི།",
    "རྩ་རིག་ཚང་མ་རེ་རེ་སྦྱར་བྱ་ཞིང་།",
    "དེ་ལ་བཞི་འབུམ་རིགས་བཞི་ཁྲི་ཕྲག་རེ།",
    "ཡུམ་བཞིར་སྟོང་རེ་གཞན་རྣམས་བརྒྱ་རེ་ཙམ།",
    "རཱ་ག་ཨ་སྱས་ཕྲལ་དུ་གང་དྲན་སྨྲས་། བཱིརྱ་སཱ་ག་ར་ཡིས་ཡི་གེར་བྲིས། ། ན་མོ་གུ་རུ་སརྦ་བིད་ཡེ།",
    "ཐ་མལ་ལུས་སུ་ཐོན་ལ་ཤར་སྒོའི་དྲུང་། པུས་བཙུགས་ཐལ་མོ་སྦྱར་ཏེ་གནས་པར་བསམ།",
    "མདུན་གྱི་གཙོ་བོས་ཀསུང་བསྒོམ་རང་གིས་འདོན།",
    "མདུན་གྱི་ལྷ་ལ་རང་གིས་ཞུ་སྣ་དང་།",
    "བདག་གི་ཡིད་ཀྱིས་མདུན་བསྐྱེད་གཙོ་བོ་ལ།",
    "སྒེག་སོགས་བརྒྱད་ཀྱིས་གླུ་དང་རོལ་མོ་བྱེད་། ཁྲོ་བོ་བརྒྱད་ཀྱིས་བར་ཆད་བགེགས་རྣམས་སྲུང་།"
  ]
}