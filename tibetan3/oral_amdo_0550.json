    "རབ་འབྱམས་ཞིང་གི་བདག་པོ་ལ་གསོལ་བ་འདེབས་སོ་། ཞིང་ཁམས་སྤྲུལ་པས་ཁྱབ་པ་ལ་གསོལ་བ་འདེབས་སོ།",
    "བསམ་བརྗོད་རེ་བ་ལས་འདས་པ་ལ་གསོལ་བ་འདེབས་སོ།",
    "དེ་དག་མཆོག་གི་སྤྲུལ་པའི་སྐུ་རུ་རྟོགས།",
    "རང་གི་སྤྱི་བོ་ཚངས་པའི་བུག་ནས་ཞུགས།",
    "སྐུ་གསུང་ཐུགས་དང་རང་གི་ལུས་ངག་ཡིད།",
    "བརྒྱུད་པ་ཟབ་མོ་ལྟ་བའི་བརྒྱུད་པ་ཟེར།",
    "དེ་དག་དངོས་སུ་གསན་པ་ཡིན་མོད་ཀྱི།",
    "རང་གི་སྤྱི་བོའི་ནམ་མཁར་པད་ཟླའི་སྟེང་།",
    "རང་གི་དཔྲལ་བར་ཐིམ་པས་ལུས་སྒྲིབ་དག།",
    "མགྲིན་པའི་གནས་ནས་འོད་ཟེར་དམར་ེའཕྲོས་། མགྲིན་པར་ཐིམ་པས་ངག་གི་སྒྲིབ་པ་དག།",
    "རཱ་ག་ཨ་སྱས་འཕྲལ་དུ་བྱུང་རྒྱལ་སྨྲས། ། ན་མོ་གུ་རུ།",
    "དེང་སང་སེར་མོ་འཛིན་པ་ཕལ་ཆེར་གྱིས།",
    "སྔགས་ལུགས་རང་གི་ཡི་དམ་གང་ཡིན་གྱི།",
    "དེ་ཡི་སྒྲུབ་ཐབས་མན་ངག་ཟབ་མོ་ཐོབ།",
    "ཨོ་རྒྱན་པ་ཡིས་ཐུན་མོང་དངོས་གྲུབ་དང་།",
    "རྒྱལ་བ་རྒྱ་མཚོའི་སྦ་ལྕག་གིས་དཀྲུགས་ནས།",
    "དེ་ཉིད་རང་གི་སྤྱི་གཙུག་པད་ཟླའི་སྟེང་།",
    "རྡོ་རྗེ་འཆང་གི་སྐུར་བསྒོམ་མན་ངག་ཡིན།",
    "ཞེས་སོགས་གང་མོས་གསོལ་བ་བཏབ་པར་བྱ།",
    "བརྩོན་འགྲུས་རྒྱ་མཚོས་ཉམས་ལེན་མཛོད། ། ན་མོ་གུ་རུ།",
    "མཚོ་རྒྱལ་དམར་མོ་གྲི་ཐོད་འཁྱུད།",
    "རང་གི་ཚངས་པའི་བུག་ནས་ཞུགས།",
    "དྲིལ་བུ་གསུང་གི་དམ་ཚིག་ནི།",
    "རང་གི་མགྲིན་པའི་གནས་སུ་བསྟན།",
    "རང་གི་སྤྱི་བོའི་གཙུག་རོལ་ན།",
    "པདྨ་གསུང་གི་ལྷ་ཚོགས་བསྒོམ།",
    "བརླ་ཡི་པུས་མོའི་རྩ་འཁོར་ན།",
    "པུས་མོ་གཡོན་གྱི་རྩ་འཁོར་ན།",
    "རང་གི་ལུས་དང་རྩ་ཀུན་གང་།",
    "བརྩོན་འགྲུས་རྒྱ་མཚོས་ཐུགས་དམ་མཛོད། ། ན་མོ་གུ་རུ།",
    "དེ་ཕྱིར་བརྩོན་འགྲུས་རྒྱ་མཚོ་ཁྱོད།",
    "རྒྱུན་གྱི་ཐུགས་དམ་མཛད་པར་ཞུ། ། ན་མོ་གུ་རུ།",
    "མོས་གུས་རྒྱལ་མཚན་རྩེར་ཕྱར་ནས།",
    "མོས་གུས་དྲག་པོས་གསོལ་བཏབ་ན།",
    "ཚེ་འཕེལ་འདོད་ན་ཚེ་དཔག་མེད་། འགྲོ་དོན་ཆེ་འདོད་སྤྱན་རས་གཟིགས།",
    "མོས་གུས་གཏེར་མཛོད་ནང་ན་གསལ།",
    "དེ་ཡི་ལུང་རྒྱུན་བདག་གིས་ཐོབ།",
    "བརྩོན་འགྲུས་རྒྱ་མཚོས་ཡི་གར་བཀོད་། ཕྱི་རབས་མོས་གུས་ལྡན་པ་ཡི།",
    "ན་མོ་མ་ཧཱ་མུ་དྲྭ་ཡེ།",
    "སྒོམ་སྐྱེས་བདག་པོ་མེད་པར་མི་སྐྱུར་བར་། རི་ཁྲོད་དབེན་པའི་གནས་སུ་སོང་ལ་སྒོམས།",
    "ཚེ་འདིར་དེ་སྔ་ཕན་ཆད་དེ་འབད་ཀྱང་། འདོད་པ་ཙམ་ཞིག་འགྲུབ་པར་མ་གྱུར་མོད།",
    "བསམ་བློ་གཏོང་རེ་ནཱ་ར་ཀན་ཞེས་བསམ།",
    "ཨ་མཆོད་འདི་ཚོ་སྔར་ནས་གྲུབ་ཐོབ་འོས།",
    "རང་གིས་བཀོལ་དུ་མ་བཏུབ་ན།",
    "མེ་རེ་འཁྱིལ་ལེ་མཚོ་ཆེན་འཁྱིལ་བ་བཞིན།",
    "ཅུང་ཞིག་ཡལ་ནས་གསལ་སྟོང་རྗེན་པར་བུད།",
    "རང་གི་ལུས་ཀྱང་མེད་དམ་སྙམ་པ་འབྱུང་།",
    "སྟོང་པ་རེད་དོ་སྙམ་པའི་འཛིན་པ་ཡོད།",
    "བསྔལ་ཁ་སྨྲས་ལ་སོགས་རྐྱེན་གཅིག་གིས།",
    "རེས་མོས་འཆར་བ་དཔྱིད་ཀའི་ཉི་མ་བཞིན།",
    "རེས་འགའ་བྱིང་རྨུགས་མི་གསལ་འཐིབས་སེ་བ།",
    "མིག་གིས་ལྟ་སྟངས་དྲག་ཏུ་གཟིར་བྱས་ཏེ།",
    "ཉོན་མོངས་དུག་ལྔའི་མགོ་བོ་ནོན་པ་དང་།",
    "དཔེར་ན་སེང་གེ་དཀར་མོའི་འགྲོས་བྱེད་ཚེ་། རྒྱངས་ཙམ་མཆོངས་ནས་ཚུར་ལ་བལྟ་བ་ལྟར།",
    "དཔེར་ན་འདམ་སེང་སྔོན་མོའི་ངར་སྒྲ་དེ།",
    "སེང་གེ་དཀར་མོའི་རིགས་ནི་མ་ཐོབ་སྟེ།",
    "འདམ་སྐྱེས་སེང་གེ་སྔོན་མོའི་ང་རོ་འདི།",
    "བཱིརྱ་སྭ་ག་ར་ཡིས་ཡི་གེར་བཀོད། ། ན་མོ་མ་ཧྭ་མུ་དྲ་ཡེ།",
    "ངོ་བོ་མ་གྲུབ་ཐམས་ཅད་སྟོང་པ་ཉིད་། རྒྱུག་མཆོངས་སོང་ཡང་ཐོགས་པ་མེད་སྙམ་བགྱིད།",
    "ལག་པས་རེག་ན་སྲ་མཁྲེགས་དེ་གར་སྣང་།",
    "སྙམ་པ་དེ་དག་རེ་རེའི་འཛིན་པ་ཞུགས།",
    "འདོད་ཁམས་ལྷ་རིགས་དྲུག་གི་གོལ་ས་གཉིས།",
    "གསལ་སྟོང་རྗེན་ནེ་ཡེ་རེ་ངེས་ཤེས་ཅན།",
    "སྐབས་རེ་དེ་འདྲར་སྐྱེས་ཀྱང་མི་གོལ་ཏེ།",
    "འོད་ཞིག་མིག་གི་ཐད་དུ་བྱུང་བ་ཡིས།",
    "ཅི་ཡང་དམིགས་སུ་མེད་པ་ཡིན་མོད་ཀྱི།",
    "ཕྱི་ནང་སྣོད་བཅུད་རང་གི་སེམས་དང་བཅས།",
    "དེ་ལ་རེས་འགའ་བ་དང་ཕལ་ཆེ་བ།",
    "རེ་རེ་ལ་ཡང་གསུམ་གསུམ་དབྱེ་བའི་ཚུལ།",
    "གོང་གི་རིགས་པས་དཔག་པས་ཤེས་པར་སླ།",
    "ཡི་དམ་འགྲུབ་པའི་མཆོག་གི་དངོས་གྲུབ་བམ།",
    "སྔར་གྱི་ཉམས་རྟོགས་ཤུན་པ་ལྟ་བུར་བུད།",
    "མིག་གི་ཡུལ་དུ་གཟུགས་ནི་ཅི་མཐོང་ཡང་།",
    "མིག་གིས་མཐོང་ཡང་འདི་ཡིན་འཛིན་པ་མེད།",
    "དྲི་རོ་རེག་བྱ་རྣམས་ཀྱང་དེ་ཡིས་འགྲེས་། མ་ཡེངས་ཉམས་ལེན་སྐྱོང་ཚེ་དེ་ལྟར་ཏེ།",
    "ཉམས་དེ་རེས་འགའ་བ་དང་ཕལ་ཆེར་རམ།",
    "ནང་གི་སེམས་ཉིད་གཏན་ལ་ཕེབས་ན་ཡང་།",
    "སྦྲ་ཁང་སྐྱེས་པ་བུད་མེད་དུད་འགྲོ་སོགས་། མིག་གིས་གང་མཐོང་དེ་ལ་རིག་པ་གཏད།",
    "རང་གི་ཉམས་ལེན་སྟེང་དུ་བཞག་པའི་ཚེ།",
    "ཡེངས་སྐབས་ཉོན་མོངས་ཧྲག་ཅིང་ཐ་མལ་པ།",
    "འདི་སྐབས་ཁྲོ་གཏུམ་ཚེ་དང་ཉོན་མོངས་ཧྲག།",
    "འདོད་པ་ཆེ་སོགས་བསྒོམ་འཁྲབ་སོང་བ་འདྲ།",
    "དེ་ནས་རྩུབ་སློང་ཉོན་མོངས་ཕལ་ཆེར་ཞི།",
