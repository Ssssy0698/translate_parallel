    "དྲང་སྲོང་ཆེན་པོ་གཞན་དག་དུས་བཞིན་བྱུང་བས་ཞི་བར་མཛད་པ་བཞིན།",
    "དེ་ནི་ཉི་མའི་ཉེས་པ་མ་ཡིན་གྱི་དམུས་ལོང་རང་ཉིད་ཀྱི་ཉེས་པ་ལས་བྱུང་བ་ཡིན་ནོ།",
    "བ་སྤུའི་འོད་དང་རང་བཞིན་འོད།",
    "ཡ་ལློ་ཀཱ་མྦ་ར་ཙ་ནྡྲ་ཙ་ནྡྲ་བ་པུ་ཥཱ་ཙ་ནྡྲ་པྲ་བྷ་ཏྭེ་ཏྭ་ཡཱ།",
    "པྲཱ་དཱཾ་སྟྱཾ་ཛི་ན་ཏེ་ན་ནཱུ་ན་མ་བྷ་བ་ནྨཱ་ར་ངྒ་ནཱ་ནཱཾ་མུ་ཁཾ་ས་ངྒོ་བཱ་ཉྩི་ཏ་པ་ཀྵྨ་ལོ་ཙ་ན་ད་ལཾ་ཡ་ཛྙཱ་ལ་སཱ་མ་ནྠ་རཾ།",
    "ཏྭ་ཙྩ་རྱཱ་ཏི་ཤ་ཡཱཾ་ཤ་ལེ་ཤ་ར་ཙ་ནཱ་ལྱ་ཤྲེ་སྔོ་ཁྲིད་ཡངས་པ་ཡི།",
    "ནམ་མཁའ་ལས་ཆོ་འཕྲུལ་བྱུང་ཡང་རང་ལས་བྱུང་ཞིང་རང་ལ་ཐིམ།",
    "སྣང་ཚད་ཡེ་ཤེས་སུ་འདུག་པས་རྟོགས་པའི་ཡེ་ཤེས།",
    "བྱུག་འདུག་བྲབ་གསུམ་སྔོན་དུ་འགྲོ་བས།",
    "སེམས་རྩེ་གཅིག་ཏུ་འདུག་ན་མིག་བཙུམས་ནས་དམིགས་རྟེན་གྱི་རྣམ་པ་ལམ་མེ་བ་ལ་སེམས་བཟུང་།",
    "དེ་གོམས་ནས་འགྲོ་འདུག་སྨྲ་བརྗོད་དྲན་རྟོག་སོགས་ཅུང་ཟད་དང་བསྲེས་ནས་གོམས་སུ་བཅུག་པས་བོགས་ཐོན་པར་འགྱུར་༥༩",
    "ཡུལ་གྱི་སྣང་བ་གང་སྣང་ཐམས་ཅད་སྒྱུ་མ་དང་རྨི་ལམ་དངོས་སུ་འདུག་སྙམ་དུ་གང་སྣང་བདེན་མེད་དུས་ལ་ལ་སྦྱང་།",
    "རང་རང་རྟགས་ཀྱི་ཕྱག་མཚན་དང་བཅས་ཏེ།",
    "ཟླ་བ་མངོན་དགའ་བེ་རོ་ཙ་ན་དང་།",
    "རང་རང་ཤུགས་ཀྱིས་གྲོལ་བར་བྱིན་གྱིས་རློབས།",
    "རང་རང་མཐུ་རྩལ་ཆེ་བ་བསྟན་ནས་ཀྱང་།",
    "རང་རང་མཐུ་རྩལ་ཆེ་བ་བསྟན་ནས་ཀྱང་།",
    "རང་རང་མཐུ་རྩལ་ཆེ་བ་བསྟན་ནས་ཀྱང་།",
    "འཇིག་རྟེན་པ་རྣམས་ཀྱང་རང་རང་གནས་སུ་གཤེགས་པར་གྱུར་པར་བསམ་བཀྲ་ཤིས་དང་བསྔོ་སྨོན་རྣམས་རྒྱས་བསྡུས་སྐབས་དང་སྦྱར་ལ་བྱའོ།",
    "གལ་ཏེ་རྒྱུ་ནོར་གསོག་མཁན་མང་ལ་འགྲོ་གྲོན་བྱེད་མཁན་ཉུང་ན་གསོག་པ་མགྱོགས་ལ་འཛད་པ་དལ་བས་རྟག་ཏུ་རྒྱུ་ནོར་གྱིས་ཕྱུག་འདུག་གོ།",
    "སྣང་སྟོང་གཉིས་རིག་པའི་བདག་ཉིད་དུ་ལྷུན་གྱིས་གྲུབ་པའི་ངོ་བོ་དེ་ལོངས་སྐུར་འདུག་པ།",
    "འབྲས་བུ་ཡང་ཀྲོང་ངེ་འདུག་པས་ན།",
    "གཞི་ལམ་དབྱེར་མེད་མངོན་དུ་གྱུར་པ་འབྲས་བུ་ཞེས་བཞེད་པར་འདུག་སྙམ་དུ་རྟོགས་སོ།",
    "རྣམ་པརིག་པའི་འཕྲུལ་ཆེ་བ་ཞིག་འདུག་པས་ན།",
    "མིསྲིད་པའི་སྐྱོན་གསུམ་གང་ཡང་མི་འདུག་པས་ཁྱབ་པའི་ཕྱིར་ཏེ།",
    "ཁོ་རང་ལ།",
    "མགོན་པོ་ཡང་རང་ལ་ཐིམ།",
    "གྱི་སྟེང་ན་འདུག་པ་དང་མཐུ་བ་སོགས་ནི་དགེ་སྦྱོར་སྐྱེ་བའི་རྟགས་སོ།",
    "གཞུང་བསྟོད་རྒྱ་སྐད་མ་ཡིན་ཟེར་ཡང་སྐད་དོད་ཤེས་པས་དག་པར་བྱེད་དགོས་པ་འདུག་གོ།",
    "དབྱེར་མེད་བློ་འདས་ནམ་མཁའ་ལྟ་བུ་ལ་གསལ་རིག་སྟོང་གསུམ་ནམ་མཁའ་ལྟ་བུར་མཐའ་དབུས་མེད་པར་འདུག་གོ་ཞེ་ན།",
    "ལྔ་པ་ཆེན་པོ་དངོས་སུ་འདུག་གསུངས་ཏེ་དགྱེས་ཉམས་ཆེན་པོ་གནང་།",
    "ཚེ་འདིའི་རྙེད་བཀུར་དོན་གཉེར་སོགས་ཆགས་སྡང་རྨོངས་གསུམ་གྱི་རྟོག་པ་མངོན་དུ་གྱུར་འདུག་ན་ཀུན་སློང་མ་དག་པ་ཡིན་པས།",
    "ད་དུང་སྡུག་བསྔལ་གྱི་གཏིང་དང་མཐའ་མངོན་དཀའ་བར་འདུག།",
    "བདེ་བས་ཕོངས་ཤིང་སྡུག་བསྔལ་གྱིས་མནར་བར་འདུག་པས།",
    "སྡུག་བསྔལ་མི་འདོད་རུང་སྡུག་བསྔལ་གྱི་རྒྱུ་སྡིག་སྤྱོད་སྣ་ཚོགས་ལ་སྤྲོ་བཞིན་ཞུགས་པས་དུས་ནམ་ཡང་བདེ་བའི་གོ་སྐབས་མེད་པར་སྡུག་བསྔལ་དྲག་པོས་མནར་བ་ཡིན་འདུག།",
    "དེ་དག་ལ་སྐྱོན་ལྡན་དུ་བསྟན་པ་མིན་ཀྱང་རང་སེམས་འཁྲུལ་པས་བསླད་ནས་སྐྱོན་བཅས་སུ་སྣང་བ་ལྟ་བུར་དཔགས་ན།",
    "རབ་རིབ་ཅན་ལ་སྣང་བའི་སྐྲ་ཤད་ལྟར་མེད་བཞིན་དུ་སྣང་བ་ཡིན་འདུག།",
    "དུད་འགྲོའི་སྐྱེ་གནས་ན་ཡང་གདའ།",
    "སླར་ཡང་ངན་འགྲོ་ཉམ་ང་བའི་གཡང་དུ་བསམ་བཞིན་མཆོངས་ན་ངེས་པར་སེམས་མེད་པའི་རྟགས་སུ་འདུག།",
    "སྒོ་གང་ནས་བསམས་ཀྱང་དལ་འབྱོར་འདི་ཤིན་ཏུ་དཀོན་པར་འདུག།",
    "སྔར་བྱས་ཀྱི་ལས་ངན་ཐམས་ཅད་སྟོབས་བཞིས་སྦྱངས་ཏེ་སླན་ཆད་དལ་འབྱོར་གྱི་ཨང་ཀ་མ་འཁྲུགས་པར་བདེ་ནས་བདེ་བའི་སར་འགྲོ་བ་ཞིག་འབྱུང་ངེས་པས་བློས་འཆི་བའི་ཕྱོགས་འཛིན་པ་ནི་ཕུན་ཚོགས་ཐམས་ཅད་ཀྱི་སྒོར་འདུག།",
    "དེ་བཞིན་དུ་ཟ་འཐུང་དང་འགྲོ་འཆག་ཉལ་འདུག་སོགས་ཅི་བྱ་བ་དང་ཅི་བྱེད་པའི་དུས་ཐམས་ཅད་དུ་ཚེ་བྲི་ནས་མི་འགྲོ་བའི་སྐབས་ཡེ་མེད་པས།",
    "མའི་མངལ་དུ་ཞུགས་པ་ནས་བཟུང་སྟེ་སྐད་ཅིག་ཙམ་ཡང་མི་སྡོད་པར་འཇིག་རྟེན་ཕ་རོལ་དུ་བང་བརྒྱུག་པའི་ཚོད་དུ་འགྲོ་བར་གསུངས་པ་བསམ་བློ་བཏང་ན་མེད་པར་གདའ།",
    "གསོན་པོ་ཟེར་ཡང་འཆི་བའི་ལམ་ཆེན་ལ་ཆས་འདུག།",
    "འགྲོ་འདུག་སྣ་ཚོགས་སོགས་དགོས་མེད་ཀྱི་བྱ་བཞག་མང་པོ་དང་།",
    "ལ་ལ་ཤི་ཚར་ཀྱང་རོ་རུལ་ད་དུང་ཁྱིམ་དུ་བཞག་འདུག།",
    "ཁོ་རང་རྒྱ་ནག་ཏུ་ཚོང་ལ་འགྲོ་རྒྱུ་དང་།",
    "ཁང་པ་ཇེ་ཆེར་གཏོང་རྒྱུ་སོགས་ཀྱི་སྐད་ཆ་འདུག།",
    "ཕོར་པའི་ནང་དུ་བླུགས་ནས་མ་འཐུང་གོང་དུ་འཆི་བ་དུ་མ་སྣང་བས་བདག་ད་ལྟ་རང་ཚེ་ཕྱི་མར་མི་འགྲོ་བའི་ངེས་པ་ཙམ་ཡང་མི་འདུག།",
    "ཕལ་ཆེ་བ་ཞིག་ཤི་མ་ཐག་ཤུལ་མི་རྣམས་ཀྱིས་རྒྱུ་རྫས་ལ་ཧབ་ཤ་འགྱེད་པ་མ་གཏོགས་གཤིན་པོའི་དགེ་རྩ་སོགས་ཡིད་ལ་དྲན་གྱིན་མི་འདུག།",
    "གོས་བཟང་པོ་གྱོན་པའི་སྐབས་ད་ལྟ་རིན་ཐང་ཆེ་བའི་གོས་གསར་པ་གྱོན་ཞིང་འདུག་སྟེ།",
    "གྲོགས་ཡིད་དུ་འོང་བ་དང་འགྲོགས་པའི་དུས་སུ་ད་ལྟ་བདག་གཞུང་བཟང་ཕྱི་ཐག་རིང་བའི་གྲོགས་དག་དང་འགྲོགས་གྱིན་འདུག་སྟེ།",
    "ཁྲུས་དང་བྱི་དོར་བྱེད་པའི་སྐབས་ད་ལྟ་བདག་བྱི་དོར་བྱེད་ཅིང་འདུག་སྟེ།",
    "མཛོ་གཡག་སོགས་ཀྱིས་གཤེད་མ་རལ་གྲི་བཟུང་ནས་རྩར་སླེབས་ཀྱང་རང་གསོད་དུ་འོང་བ་མི་ཤེས་པ་ལྟ་བུ་ཚེ་འདིའི་ཕན་གནོད་ཀྱི་བྱེ་བྲག་ལའང་ཤིན་ཏུ་རྨོངས།",
    "དེས་ཀྱང་རང་འདོགས་བྱེད་ཀྱི་ཐག་པའི་མདུད་པ་ཙམ་འགྲོལ་མི་ཤེས་ན་གཞན་ལྟ་ཅི་སྨོས།",
    "རྨ་འདིའི་ན་ཟུག་མི་ནུས་པར་འདུག།",
    "ལུད་པ་སྐམ་པོ་ཞིག་ལག་མཐིལ་དུ་བཙིར་འདུག།",
    "བླ་ཆེན་དག་འགྲོ་དོན་ལ་འབྱོན་སྐབས་གནག་ལུག་མང་པོ་དེད་ཅིང་མི་སྐྱ་ཁ་ཤས་ཕྱགས་ཕྱིར་ཁྲིད་དེ་ཕེབས་ཀྱིན་འདུག་པ་བརྟགས་ན་སྡིག་སྤྱོད་རླབས་ཆེ་བ་དང་།"
  ]
}