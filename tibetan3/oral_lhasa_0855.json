    "གཟུང་བ་མཐོང་བ་དེ་ལས་ནི་འཛིན་པར་བྱེད་པ་རྗེས་སུ་དཔོག་གོ་སྙམ་ན།",
    "ཇི་ལྟར་གནས་པ་བཞིན་ཞེས་བྱ་བ་ནི་དོན་དེ་ཇི་ལྟར་གནས་པ་དེ་ལས་མ་འདས་པས་འཛིན་པ་ཙམ་གྱི་བློས་བྱེད་པར་ཟད་ཀྱི་དོན་དེ་ལ་ཁྱད་པར་འགའ་ཞིག་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "འོན་ཏེ་འདི་གཟུང་བཞིན་པ་ཉིད་ཀྱིས་ཁྱད་པར་དུ་འཕགས་པར་འགྱུར་རོ་ཞེསགཟུང་བ་ཞེས་སྨོས་སོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ཇི་ལྟར་གནས་པའི་རང་བཞིན་དང་མི་མཐུན་པར་འཛིན་ན་ཡང་ངོ།",
    "དེ་ལྟ་བུའི་ཞེས་བྱ་བ་གསལ་བའི་རང་བཞིན་ཉིད་དུ་བྱ་བདེའི་ཚེ་དོན་དེ་ཉིད་དེ་ལྟ་བུ་ཞེས་བྱ་བ་གསལ་བའི་རང་བཞིན་དུ་གྱུར་པར་སྐྱེའོ་ཞེས་དེ་ལྟར་བརྗོད་པས་ན།",
    "ངས་ཞེས་གསུངས་སོ།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "འོ་ན་བློ་གང་ཡིན་པར་འགྱུར་སྙམ་ན།",
    "ཁྱད་པར་ནི་ཞེས་བྱ་བ་སྟེ།",
    "ཤེས་པར་འགྱུར་བ་ཉིད་ཀྱི་ཁྱད་པར་ཉིད་ལ་དེ་ལྟར་ཞེས་བྱ་བ་བློ་ཞེས་རབ་ཏུ་བརྗོད་དེ་བློས་ཅི་ཞིག་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཏེ་དོན་ཤེས་པར་འགྱུར་ཏེ་ཞེས་ཤེས་པ་ཉིད་དེ།",
    "ཤེས་པར་འགྱུར་བ་ཉིད་དུ་ཡོངས་སུ་བཅད་པ་ནི་མ་ཡིན་ནོ་སྙམ་ན།",
    "དོན་ཤེས་པར་འགྱུར་རོ་ཞེས་༤པའི་སྐྱེས་བུ་ནི་དོན་ཏེ་ཤེས་པ་ཡིན་ནོ་ཞེས་རྟོགས་པ་ཡིན་ཏེ།",
    "དེས་ན་ཤེས་པ་དོན་ལས་ཐ་དད་པར་མི་འགྱུར་རོ།",
    "དོན་ཤེས་པར་གྱུར་ཏོ་ཞེས་ནི་མ་ཡིན་པར་གྱུར་ན།",
    "འོན་ཏེ་དོན་ཤེས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པ་འདིས་ནི་དོན་གྱི་རང་བཞིན་དུ་གྱུར་པའི་ཤེས་པ་ཉིད་རྟོགས་སུ་ཆུག་པ་དེ་ལྟ་ན་ཡང་ཐ་དད་པར་འགྱུར་རོ་ཞེ་ན། དེའི་ཞེས་བྱ་བ་ནི་ལས་སོ།",
    "དེའི་སྐྱེས་བུ་གཞན་གྱིས་མཐོང་བར་གྱུར་པའི་དོན་ལ་ཡང་མཐོང་བར་གྱུར་པའི་ཐ་སྙད་དུ་བྱེད་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་དོན་གྱི་ཁྱད་པར་མཐོང་སྙམ་ན།",
    "དེ་ཞེས་སྨོས་ཏེ་དོན་ཏོ་། དོན་མཐོང་བ་ཞེས་པ་ཙམ་གྱིས་དེའི་ཁྱད་པར་ཡང་མཐོང་བར་འགྱུར་རོ།",
    "ཁྱད་པར་དེ་ཞེས་བྱ་བ་ནི་ཤེས་པས་བསྐྱེད་པའོ།",
    "དེ་དག་ཀྱང་ཞེས་བྱ་བ་ནི་གཞན་གྱིས་བསྐྱེད་པའི་ཁྱད་པར་དག་ཀྱང་ངོ།",
    "དེ་ལྟ་མ་ཡིན་ན་རུང་ཡུལ་གནས་པས་མི་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་གནོད་པ་སྲིད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཡང་ངོ།",
    "བདེ་བ་ལ་སོགས་པ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟའོ་ཞེ་ན་ཞེས་བྱ་བ་ནི་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ལྡན་པ་ཡང་མ་ཡིན་ཏེ་ཞེས་གསུངས་ཏེ་། ཡོད་པ་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་བུ་ཞེས་བྱ་བ་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པ་ཉིད་དུའོ།",
    "དེའི་རིག་པ་ནི་བདེ་བ་ལ་སོགས་པ་རིག་པར་བྱེད་པའོ།",
    "དེས་བསྐྱེད་པའི་རྣམ་པས་བདག་ཉིད་དུ་ཟིན་པར་མི་སེམས་པའོ།",
    "སྲོག་ཆགས་ཐམས་ཅད་ལ་ཡོད་པའི་ཕྱིར་ན་སྲོག་ཆགས་སོ་སོ་ལ་ཐ་དད་པ་དེ་བཞིན་དུ་དོན་ཡང་ཐ་དད་པར་འགྱུར་ཏེ།",
    "གཟུགས་ལ་སོགས་པ་དེའི་ཁྱད་པར་སྐྱེས་བུ་དུ་མས་ངེས་པའི་དུས་ན།",
    "ཤེས་པས་བསྐྱེད་པའིགཟུགས་ལ་སོགས་པ་ཐམས་ཅད་དམིགས་པར་འགྱུར་རོ།",
    "སོ་སོ་རང་ཉིད་ཅེས་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པ་ཡང་མངོན་སུམ་ལས་གཞན་ཡིན་པར་འགྱུར་ཏེ།",
    "དེའི་ཚེ་དེ་ལ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་རོ།",
    "གཞན་གྱིས་ཞེས་བྱ་བ་ནི་བདག་ཉིད་ལ་བློ་མ་རྟོགས་པར་རོ།",
    "གང་ཞིག་དྲན་པ་དེས་རྟོགས་པ་དེ་ཉིད་ནི་སྔར་ཡང་མངོན་སུམ་གྱི་ཤྰཡུལ་དུ་བྱས་པ་ཡིན་པ་དེས་ན་ཇི་ལྟར་རང་རིག་པ་ཡིན་ཞེ་ན།",
    "དེས་ན་འདི་ཉིད་སྔར་ཡང་རྟོགས་པར་ཇི་ལྟར་འགྱུར་འདི་ཡང་ཞེས་བྱ་བ་ད་ལྟར་བའི་རང་བཞིན་ཡང་དྲན་པས་ཡུལ་དུ་བྱེད་དོ་ཞེ་ན།",
    "འོ་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་འདི་ཇི་ལྟར་མི་བདེན་པ་ཡིན་ཞེ་ན་གཞལ་བྱ་དང་ཞེས་སྨོས་སོ།",
    "རང་རིག་པར་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "འདི་འཛིན་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་འཛིན་ནའོ།",
    "དེ་ཡང་ཞེས་གསུངས་ཏེ་མར་མེ་ཡང་ངོ།",
    "དེའི་རང་བཞིན་གྱིས་ཤེས་པ་ཉིད་ལས་གསལ་བར་བརྗོད་པར་ཟད་ཀྱི་དོན་དམ་པར་ནི་འདི་གསལ་བ་ཉིད་མ་ཡིན་ནོ།",
    "འོན་ཏེ་ཕྱི་མ་རྣམས་ཀྱི་ཚོགས་རྟོགས་པར་ན་རིང་པོར་རྟོགས་པ་ཡིན་ནོ་སྙམ་ན།",
    "རང་རིག་པ་མེད་པར་ནི་སྔ་མ་དང་ཕྱི་མ་རྟོགས་པ་མ་ཡིན་ནོ་ཞེས་དགོངས་སོ།",
    "འོན་ཀྱང་ཁྱད་པར་ཡོད་དོ་ཞེས་བྱ་བར་སྟོན་པ་ནི་འོན་ཀྱང་ཞེས་བྱ་བའོ།",
    "བློ་གཅིག་པ་ཉིད་ཀྱང་རིགས་མི་མཐུན་པའི་བློས་བར་མ་ཆོད་པ་ལས་རིག་པར་བྱའོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕ་རོལ་པོ་བློ་ཡང་གཞན་གྱིས་རིག་པར་བྱ་བ་ཉིད་དུ་སྒྲུབ་པར་བྱེད་དོ།",
    "ཡུལ་ཐ་དད་ན་བློ་ཡང་ཐ་དད་དོ་ཞེས་བྱ་བ་འདི་ལ་གཞན་ཡང་བཟློག་པར་རྟོགས་པ་མེད་པ་ཁོ་ནའོ་ཞེས་སྟོན་པ་ནི་དེ་སྐད་དུ་ཡང་ཞེས་བྱ་བ་སྟེ།",
    "གལ་ཏེ་འདིས་ནི་ཕ་རོལ་པོས་བློ་རྟོགས་པ་ཙམ་བརྗོད་ཀྱི་ཐ་དད་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན་ ཇི་ལྟར་ཞེས་གསུངས་ཏེ་ཞེས་བྱ་བ་ནི་བློའོ།",
    "ཡང་འཕེལ་བ་གཞན་དུ་ཡིན་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
