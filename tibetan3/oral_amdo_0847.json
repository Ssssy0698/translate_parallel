    "བདག་གི་བསམ་འགྲུབ་རེ་བ་སྐོངས།",
    "བདག་ལ་སྐྱབས་བཞིན་རེ་ས་མ་མཆིས་པས།",
    "མནོལ་བསང་ལྷ་ཆབ་སྔོན་མོ། ། པདྨ་ས་ཝ་ལ་ན་མོ།",
    "དེ་ནས་མོ་བས་མོ་བཏབ།",
    "རྒྱལ་པོའི་བཙུན་མོ་མང་བཟའ་ཁྲི་ལྕམ་བྱ་བ་ཞིག་ལ་རྩོག་མནོལ་གྱི་བུ་གཅིག་བྱུང་བས།",
    "བཙུན་མོས་གསང་ནས་ཁོལ་མོ་ཞིག་ལ་གཏད་པར་ཁྱོད་ཀྱིས་འདི་སུས་ཀྱང་མ་མཐོང་བར་སྦས་པ་གལ་ཆེ་ཟེར་བས།",
    "ཁོལ་མོས་ཕུག་གཅིག་ཏུ་སྦས་པའི་རྐྱེན་གྱིས་ས་བདག་གི་ལྟོ་བར་ཕྲད་པས་ས་བདག་ཡུལ་ལྷ་ཐམས་ཅད་ལ་མི་གཙང་བའི་གྲིབ་ཕོག་ནས་འཁྲུགས་པས་རྒྱལ་པོ་དང་ཡུལ་ཁམས་ཐམས་ཅད་དུ་མི་བདེ་བ་བྱུང་།",
    "དེར་ཁོལ་མོ་ལ་ཡང་མི་གཙང་བའི་གྲིབ་ཕོག་ནས་ན་བས།",
    "མགོ་དང་ཡན་ལག་ཞ་གྲུམ་དུ་སོང་།",
    "བཙུན་མོ་ཁྲི་ལྕམ་ལ་ཆད་པ་བཅད་པ་མི་འོས་འདྲ།",
    "མི་གཙང་བའི་མནོལ་གྲིབ་འདི་ལས་ཆེ་བ་ཉོན་མོངས་དུག་ལྔའི་གྲིབ་སེལ་བར་བྱེད་པ་ལ་སླ་བ་ཚེགས་ཆུང་བ་དོན་ཆེ་བའི་ཐབས་ཡོད་པས།",
    "བསང་རྫས་ཁ་དོག་དྲི་རོ་རེག་བྱ་ཕུན་སུམ་ཚོགས་པ།",
    "སྔགས་དྲུག་དང་ཕྱག་རྒྱ་དྲུག་གིས་བྱིན་གྱིས་བརླབས་ཤིང་།",
    "ཉོན་མོངས་དུག་ལྔས་ཡེ་ཤེས་ལྷ་ལྔ་མནོལ།",
    "ཏིང་འཛིན་འཁྲུགས་པས་སྲིད་པའི་མ་མོ་མནོལ།",
    "ཁྱད་པར་མི་གཙང་བུད་མེད་པང་སྨེ་མནོལ།",
    "བརྗེད་ངས་གཉིད་འཐིབ་བྱིང་ཞིང་མཚན་མོ་ཡེར།",
    "མོ་མཚན་མནོལ་བས་སྲིད་ཀྱི་སྐྱེ་སྒོ་ཆད།",
    "ཁ་རྗེས་མནོལ་བས་མི་རབས་ལད་མོ་ཤོར།",
    "གཞན་ཡང་སྨེ་མནོལ་རྩོག་མནོལ་རྨུག་གི་མནོལ།",
    "ཡུགས་སའི་མནོལ་དང་རབས་ཆད་ཕོ་མོའི་མནོལ།",
    "ནལ་བུ་མོ་མཚན་ཟླ་མཚན་ཟག་པའི་མནོལ།",
    "རྩེ་མོ་ལྷ་གནས་རབ་ཏུ་སྨིན་པའི་ཤིང་།",
    "ཕོ་ཤིང་མོ་ཤིང་བུ་ཤིང་ཤིང་སྣའི་ཚོགས།",
    "ཏིང་འཛིན་འཁྲུགས་པས་མནོལ་ན་སྲིད་པའི་མ་མོ་བསང་།",
    "ཁྱད་པར་མི་གཙང་བུད་མེད་པང་སྨེ་བས།",
    "ཡེ་ཤེས་ལྷ་རྣམས་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "འཇིག་རྟེན་ལྷ་རྣམས་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "མ་སྲིང་མཁའ་འགྲོ་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "བཀའ་སྲུང་དམ་ཅན་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ལྷ་རྣམས་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ཀླུ་རྣམས་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "རྣམས་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "དར་ཚོན་སྟག་གཟིག་དྲི་ཡིས་བསང་གྱུར་ཅིག།",
    "ས་བདག་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "གནས་བདག་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "གཞི་བདག་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ཡུལ་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ནོར་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "གཡང་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ཁང་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ཐབ་ལྷ་མི་གཅིག་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ཞིང་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ཕོ་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "དར་ཚོན་སྟག་གཟིག་དྲི་ཡིས་བསང་གྱུར་ཅིག།",
    "དགྲ་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "བྱེས་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "མགྲོན་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "སྐྱེ་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ལུས་ལྷ་མི་གཙང་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "སྲུང་སྐྱོབ་ལྷ་རྣམས་རྩོག་གིས་མནོལ་གྱུ་ན།",
    "རིག་བྱེད་ལྷ་རྣམས་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "རྒྱབ་རྟེན་ལྷ་རྣམས་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "ལུས་ཀྱི་གོ་མཚོན་རྩོགགིས་མནོལ་གྱུར་ན།",
    "ཟས་ནོར་ལོངས་སྤྱོད་རྩོག་གིས་མནོལ་གྱུར་ན།",
    "སྟེང་གི་ལྷ་རྣམས་མནོལ་བ་ཡོད་ན་ཡང་།",
    "ནོར་ལྷ་ཕྱུག་མོ་མནོལ་བ་ཡོད་ན་ཡང་།",
    "ར་ལྷ་ཙི་མོ་མནོལ་བ་ཡོད་ན་ཡང་།",
    "ཐབ་ལྷ་ཡོད་མོ་མནོལ་བ་ཡོད་ན་ཡང་།",
    "དེ་ནས་སྲུང་མའི་ཕྱི་ནང་གི་རྟེན་རྫས་རྣམས་བདུགས་ནས་འདི་སྐད་དོ།",
    "ལྷ་གཡག་ཞོལ་མོ་མནོལ་བ་ཡོད་ན་ཡང་།",
    "སྲུང་མའི་སྤྱན་གཟིགས་མནོལ་བ་ཡོད་ན་ཡང་།",
    "དེ་ནས་སྦྱིན་བདག་གི་མི་ནོར་ཕྱུགས་གསུམ་ལ་བདུགས་ནས་འདི་སྐད་དོ།",
    "ཉོན་མོངས་དུག་ལྔའི་གདུང་བ་བསང་གྱུར་ཅིག།",
    "མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་མཐུན་རྐྱེན་བསྒྲུབ་པ་ཡིན་པས།",
    "སླར་ཡང་འདི་བཞིན་ཉོན་མོངས་དུག་ལྔའི་གྲིབ་མནོལ་སྦྱང་ཞིང་།",
    "འཇོམས་པའམ་ཁྲོ་བོ་སྨེ་བརྩེགས་པ་བདུད་རྩི་འཁྱིལ་བ་སོགས་གང་རུང་གཅིག་གི་ང་རྒྱལ་དང་ལྡན་པའི་བསྒོམས་བཟླས་བྱས་པས་གྲིབ་ཁྲུས་དང་ནོར་རྫས་རྟ་སོགས་ལ་གྲིབ་ཕོག་ན་ཆབ་གཏོར་བྲན་ན་ཆོག་པ་ཡིན་གསུངས་སོ།",
    "སློབ་དཔོན་ཆེན་པོ་པདྨ་འབྱུང་གནས་ཀྱིས་མཛད་པའི་མནོལ་བསང་ལྷ་ཆབ་སྔོན་མོ་ཞེས་བྱ་བ་རྫོགས་སོ། ་",
    "བསང་གིས་མི་བསང་གང་ཡང་མེད།",
    "དུས་འདིར་རིག་འཛིན་རྣལ་འབྱོར་བདག་ཅག་གི།",
    "རེ་ཞིང་བཅོལ་བའི་ལས་འདི་བསྒྲུབ་པར་རིགས།",
    "དགྲ་བགེགས་ཐམས་ཅད་ཐལ་བའི་རྡུལ་དུ་རློགས།",
