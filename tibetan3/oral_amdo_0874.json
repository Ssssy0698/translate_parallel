    "ང་ཡི་མཆོག་གི་སྤྲུལ་པ་ལས་ཞེས་འཆི་མེད་དྲན་པ་ནམ་མཁའི་མཆོག་གི་སྤྲུལ་པའི་ནང་ཚན།",
    "བརྡ་ལ་ཞེས་འོག་ནས་གསལ་བ་ལྟར་བསྡའམ་ཟླ་སྒང་རིང་མོའི་རི་རྒྱུད།",
    "གྱི་ཤན་དུང་ཕི་ཁག་བཞི་དང་ཁྱད་པར་ཡ་ཀྲུག་ཏོའུ་ཐན་ཀྲོ་ཏ་ཞུན་གྱིས་ཐོད་ནག་གི་ལས་དམག་དང་།",
    "དམ་སྲི་གདུག་པ་ཅན་དཔུང་དང་བཅས་པའི་བླ་རྡོ་ལིང་ག་མནན་ཏེ་བྱམས་ཁང་ཆེན་མོའི་རྟེན་ལེགས་པར་བཞེངས་ནས་དམ་སྲིའི་རྒྱུ་སྲང་གི་འཕྲང་བཅད་དེ།",
    "སྨིན་གྲོལ་ནམ་མཁའི་ཁྱོན་དང་མཉམཞེས་སོགས་རྩོད་མེད་ཀྱི་ལུང་གིས་ཟིན་པ་སྟེ་འདིར་ཞིག་པོའི་ཆས་ཅན་ཞེས་པའི་དོན།",
    "རྗེ་ཉིད་ཕྱི་ལྟར་རབ་བྱུང་དྲང་སྲོང་གི་ཚུལ་དུ་བཞུགས་ནའང་།",
    "མཚོན་ན་གལ་ལུང་གི་སྐྱ་རེངས་སྔོན་དུ་བཏང་བ་བཞིན།",
    "དེ་ལ་རྡུལ་ཆུ་ཟལ་མོ་སྒང་།",
    "ལྷོ་ཡི་སྨར་སྒང་རིང་མོ་དང་།",
    "འབྲི་སྒང་རིང་མོ་དེ་དང་གཉིས།",
    "བརྡ་སྒང་རིང་མོ་དེ་དང་གསུམ།",
    "རྨ་ཡི་བོ་སྒང་རིང་མོ་བཞི།",
    "བརྡ་སྒང་རིང་མོའི་སའི་ཆ།",
    "དེ་དག་ལ་མེ་ཏོག་གི་རིགས་རྣམས་ཐ་དད་པ་དུ་མ་དང་།",
    "དེའང་སྔོན་ཚེ་འཆི་མེད་དྲན་པ་ཡབ་སྲས་ཀྱིས་དཔལ་གྱི་བསམ་ཡས་སུ་སྤྱི་སྤུངས་རྩོད་ཟློག་གི་སྒྲུབ་པ་མཛད་པའི་སྐབས་སུ།",
    "འཆི་མེད་ཡབ་སྲས་གསུམ་སེང་འབྲུག་ཁྱུང་གི་རྣམ་པས་བྱོན་ཏེ་གནས་ཀྱི་རྩེ་ལ་བབས།",
    "དེ་འོག་ཕྱུག་མོ་དཔལ་གྱི་རི",
    "དར་བའི་བརྡ་རྟགས་སུ་གཡུང་དྲུང་གི་རི་མོ་རང་བྱོན་ཤིན་ཏུ་གསལ་བས་མཚན་པའང་ཡོད།",
    "ཡུལ་འདིར་ཐོག་མར་སྲིད་པ་སངས་པོ་འབུམ་ཁྲིའི་རྒྱུད་ལས་གྲོལ་བའི་མཁས་པ་རྨེའུ་ཚང་གི་གདན་ས་ཆགས་ཏེ་བསྟན་འགྲོའི་ཕྲིན་ལས་རྒྱ་ཆེར་སྤེལ།",
    "ས་ལ་བའོ་ནུས་པའི་རྩལ་ལྡན་རིགས་སྔགས་འཆང་གི་རྒྱུད།་",
    "རེ་ཞིག་རྒྱལ་པོའི་ཡིག་ཚང་ལས།",
    "སྐྱེས་པའི་མིའི་རང་གི་སྐྱེ་རྒྱུད་མ་ཤེས་ན་ནགས་ཁུང་གི་སྤྲེའུ་དང་འདྲ།",
    "དམ་པ་གང་གི་རུས་ནི་ཕྱ་རྗེ་ཡབ་བླ་བདའ་དྲུག་གི་གདུང་།",
    "སྐྱེད་པའི་ཡབ་ནི་རིང་མོ་ནས་བོན་གྱི་རྒྱུད་མ་ཉམས་ཤིང་།",
    "བུད་མེད་ཀྱི་སྐྱོན་ཐམས་ཅད་དང་བྲལ་ཞིང་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོའི་མཚན་རྟགས་དང་ལྡན་པ་བོ་ལེགས་ཞེས་བྱ་སྟེ།",
    "དེ་གཉིས་ཀ་ཡབ་ཡུམ་དུ་རུང་བར་གཟིགས་ནས་དྲན་བཞིན་ཤེས་བཞིན་དུ་ལྷུམས་སུ་ཞུགས་ཤིང་།",
    "སྔོན་མེད་པའི་དགེ་སེམས་ཁྱད་པར་ཅན་ངང་གིས་རྒྱུད་ལ་སྐྱེ་བ་དང་།",
    "ལ་ལ་དག་ལ་འདི་ནི་བསྟན་དང་འགྲོ་བ་མཐའ་དག་གི།",
    "དུས་དེ་ཉིད་ནས་ཅུང་ཟད་ནར་སོན་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་བྱིས་པའི་སྤྱོད་པ་ཐམས་ཅད་ལས་རིང་དུ་སོང་ཞིང་།",
    "༩ དགུང་ལོ་གསུམ་བཞེས་པའི་ཚེ་ཡབ་ཡུམ་དང་ཡུལ་གཅིག་པའི་ཨ་ཕྱི་གཡུང་དྲུང་མཚོ་བྱ་བ་ཞིག་གིས་སྐུ་གཉེར་བྱས་ནས་ཡོད་སྐབས་ཤིན་ཏུ་རྗེ་ཉིད་ས་སྟོང་ཞིག་ཏུ་ཕྱིན་ནས་ཁྱིམ་དུ་བསླེབས་སྐབས།",
    "ཨ་ཕྱི་གཡུང་དྲུང་མཚོ།",
    "དེ་འདྲ་ལན་མང་པོ་བྱུང་བ་ནི་རང་གི་ལྷག་པའི་ལྷ་དང་དཔའ་བོ་མཁའ་འགྲོའི་ཚོགས་ཀྱི་ཞལ་མངོན་སུམ་དུ་གཟིགས་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "དུས་ཕྱིས་སུ་རྗེ་ཉིད་བདེ་ཆེན་རི་ཁྲོད་དུ་བཞུགས་སྐབས་ཨ་ཕྱི་གཡུང་དྲུང་མཚོ་དེར་བསླེབས་ནས།",
    "ཁྱེད་སྐུ་ཆུང་ངུའི་དུས་ལྷ་དང་ལྷ་མོའི་ཚོགས་རྣམས་དང་དངོས་སུ་མི་བཞིན་བགྲོ་གླེང་བྱེད་པ་ཞིག་ཡོད་དེ།",
    "དགོས་པ་བྱུང་བ་ལ་རང་གི་ཅི་ནུས་ཀྱིས་བྱ་བའི་གྲོགས་བྱེད་པ་དང་།",
    "ཕུད་ཕུལ་སོང་སྐབས།",
    "དེ་སྐབས་བུ་གཅིག་པུ་ལས་མེད་པས་ཁྱིམ་ཚང་དང་གཉེན་ཚན་རྣམས་བློ་བསྟུན་མ་བྱུང་བས་ཉེ་ཐུང་གིས་དང་བླངས་མ་གྲུབ་པར་ལུས་སོང་བར་གདའ།",
    "དེ་ནས་ཟླ་བ་གཅིག་ལོན་པ་དང་ཁྱིམ་མཚེས་དང་ཡུལ་མིའི་བྱིས་པ་མང་པོ་དང་ལྷན་ཅིག་ཏུ་འགྲོགས་ནས་དགོན་ཐོག་བྱ་བའི་སྒང་ཁ་ཞིག་ཏུ་རྩེད་མོའི་ཕྱིར་ཆས་ཏེ་སོང་བ་ལས།",
    "ཉིན་པར་ཁང་པ་ལ་ལྡེའུ་མིག་གིས་བསྡམས་དགོས་པ་བྱུང་།",
    "མཚན་མོར་ཕ་ཡབ་དང་གཟིམས་པས་གོས་ཐམས་ཅད་རྐང་པས་ཕུལ་ནས་གཅེར་བུར་འགྲོ་གྲབས་ཁོ་ན་རྒྱུན་དུ་བྱས་པས།",
    "དབྲ་བའི་རྒྱུད་སྲུང་སྤྱི་དང་ཁྱད་པར་མ་ཅིག་བཀའ་གསང་ལྷ་མོ་ལ་ཕྲིན་བཅོལ་ནན་ཏན་མཛད་ནས་བུ་འདིའི་འགལ་རྐྱེན་ཐམས་ཅད་སོལ་ལ་མཐུན་རྐྱེན་ཡིད་བཞིན་དུ་སྒྲུབས་ཤིག་ཅེས་ཕྲིན་བཅོལ་གནང་བ་དེང་སང་ཡང་རང་གི་དྲན་ལམ་དུ་སྣང་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "དེ་ནས་བཟུང་དངོས་ཉམས་རྨི་ལམ་ཀུན་ཏུ་བུད་མེད་ནག་མོ་དང་དྲེའུ་དམར་མོ་སོགས་ཀྱི་སྣང་བ་རྒྱུན་དུ་འོང་བར་ཡང་དངོས་སུ་གསུངས་པ་རང་གིས་ཐོས་སོ།",
    "དེ་དང་འབྲེལ་བར་བོན་རང་ལུགས་སུ་རབ་བྱུང་གི་གོས་གྱོན་པའི་ཁུངས་དང་ཕྱག་ལེན་གཉིས་ཀ་ཡོད་པར་སྣང་བས་དེའི་ཚེ་འཇིག་རྟེན་གསུམ་ན་ཐོབ་པར་དཀའ་བའི་གནས་གོས་སྣ་གསུམ་ལེགས་པར་བླངས་ཏེ་རང་དགོན་གྱི་ཚོགས་གྲལ་དུ་བྱོན།",
    "དེ་ནས་བཟུང་སྟོན་པ་ཐུགས་རྗེ་ཅན་གྱི་ཐུགས་རྗེའི་གྲིབ་བསིལ་ལ་བརྟེན་ནས་རབ་བྱུང་གི་ཆ་ལུགས་འཆང་བ་ལ་ཀུན་ཀྱིས་བཀུར་སྟི་ལྷུར་ལེན་པས་བག་ཡོད་ཚུལ་མཐུན་གྱི་སྒོ་ནས་རྣམ་དཀར་གྱི་བྱ་བ་ལ་རྟག་ཏུ་བརྩོན་བཞིན་ལས།",
    "སེར་གཟུགས་དོད་ཙམ་ཡན་ཆད་ལ་མོས་པ་ཆེ་ཞིང་ཁྱད་པར་དུ་རི་ཁྲོད་པ་ཡིན་བྱ་བ་དང་།",
    "ཌར་རྐང་ཁྱེར་བའི་རིགས་མཐོང་ན་རང་གི་ཁུ་བོ་ལྟ་བུའི་འདུ་ཤེས་སྐྱེ་བ་དང་རང་ཡང་དེ་ལྟ་བུ་ཞིག་བྱེད་པའི་འདུན་པ་རང་ཤུགས་ཀྱིས་མཆིས་པ་ཞིག་ཡིན་པ་ནི་སྔོན་ནས་གོམས་པའི་རིགས་ཀྱི་བག་ཆགས་མི་སྨད་པའི་རང་རྟགས་སུ་མངོན་ནོ།",
    "རྗེ་ཉིད་ལ་བྱིས་པ་འདིའི་རང་རེའི་བསྟན་པ་ལ་བྱ་བ་བྱེད་པ་ཞིག་འོང་བ་ཁྱེད་རྣམས་གོའམ་ཞེས་ལན་མང་དུ་གསུངས་པ་ཡུལ་མི་རྒན་པོ་རྣམས་ཀྱིས་མཐོང་ཐོས་སུ་སྣང་།",
    "བསླབ་སྟོན་རྣམས་ཡིད་ལ་རི་མོ་བྲིས་པ་ལྟར་ནམ་ཡང་མི་བསྙེལ་བ་དང་དེ་ལྟར་རྗེས་སུ་བསྒྲུབ་པའི་མོས་པ་ངང་གིས་སྐྱེ་བ་ཞིག་ཡིན་པ་ནི་ཚེ་རབས་མང་པོའི་གོང་རོལ་ནས་ལས་སྨོན་གྱིས་འབྲེལ་བའི་དཔོན་སློབ་ཏུ་ངེས་པའི་ཚུལ་ཡང་དག་པའོ་ཞེས་ཤེས་པར་བྱའོ།",
    "རིགས་བདག་གཅིག་པུར་གཙུག་གི་རྒྱན་དུ་བརྙེས།",
    "དེ་དུས་ན་ཚོད་བྱིས་པ་ཡིན་པའི་སྟབས་ཀྱིས་ལྷ་འདྲེ་མི་མིན་གྱི་གནོད་པ་ལ་བྲེད་སྣང་ཞིག་རྒྱུན་དུ་འོང་འདུག་པ་ལ་ཕན་དུ་རེ་ནས།",
    "གདན་ལས་སྐུ་ཀག་གིས་བཞེངས་ཏེ་སྐུ་གཞོགས་སུ་མེ་མདའ་ཞིག་ཡོད་པ་ཕྱག་ཏུ་བླངས་ཏེ་མེ་ཐིག་སྦྱར་ནས་རང་གི་བྲང་ལ་གཏད་ནས་བརྡེག་པར་གཟས་པའི་ཚེ་ཡིད་ལ་འཇིགས་སྣང་ཞིག་བྱུང་ནས་བྱོལ་ཏེ་མགོན་ཁང་དུ་ཡིབ་ནས་བསྡད་པས།",
    "དེ་ལ་ཁོང་ན་རེ།",
    "ཁྱེད་དྲན་གཞི་བཟང་མོད།",
    "ཁྱོད་རང་བྱིས་པ་ན་གཞོན་པའི་སྟབས་ཀྱིས་སེམས་ལ་གོ་བ་འབེབས་མ་ཤེས་པར་ཅི་མོས་སུ་སོང་འདུག་པ་དེ་གོ་འམ་ཞེས་ཟེར་བ་ལ།",
    "བུད་ཤིང་དང་ཆུ་ལེན་པ་ཚུན་ཆད་རང་གི་སྒྲིབ་སྦྱོང་དུ་དམིགས་ནས་དཀའ་ཚེགས་ལ་མ་གཟིགས་པ།",
    "གྲུབ་རྗེ་ནས་ཀྱང་བཟའ་བཏུང་བྱེད་ཚུལ་གོས་གྱོན་ཚུལ་ཚུན་ཆད་ཡ་རབས་ཀྱི་ཀུན་སྤྱོད་ལ་མིག་ལྟོས་སོར་འཇགས་ཀྱི་བསླབ་སྟོན་སོགས་རང་གི་ཚ་བོ་ལྟར་གཅེས་སྤྲས་ཀྱིས་བསྐྱངས་པས་ཕན་ཚུན་གུས་པ་དང་བརྩེ་གདུང་གི་སེམས་ཇེ་བས་ཇེ་རྒྱས་སུ་གྱུར་ཏེ་དཔོན་སློབ་ཀྱི་བྱ་སྤྱོད་ལ་ཀུན་ཀྱིས་མོས་ཤིང་ངོ་མཚར་བའི་གནས་སུ་མཐོང་ནས་གཏམ་དུ་གླེང་བར་ཡང་གྱུར་ཏོ།",
    "གྲུབ་རྗེའི་མདུན་དུ་ཞུས་པས་མི་དེས་དྲེད་མོང་ཞིག་བསད་འདུག་པས་ཕྱི་མའི་སྐྱེ་བ་ངན་གསུངས།",
    "དེ་ནས་སྔོན་འགྲོ་ཕྱི་ནང་གི་དམིགས་རྐང་འདྲིལ་བ་རེ་གསུངས་ནས་ཡང་བསྐྱར་གྱིས་དོགས་སེལ་བྱས་ནས་དེ་དག་ལ་བློ་སྦྱངས་ལེགས་པར་གྱིས་ལ་ཉམས་སུ་ལོངས་གསུངས།",
    "ཅི་མཛད་ལེགས་པར་མཐོང་བ་ལས་ལོག་རྟོག་གི་མུན་པས་བསྒྲིབས་དུས་ནམ་ཡང་མ་བྱུང་།",
    "ཐུགས་ལ་གནོད་པའི་ལས་ཕྲ་མོ་ཡང་བྱེད་མ་མྱོང་བའི་བཤེས་གཉེན་བསྟེན་ཚུལ་གྱི་སྐབས་འདིར་མ་བྱུང་སྙམ་པའི་འགྱོད་པ་བྱེད་དགོས་པ་ནམ་ཡང་མེད་ཅེས་དུས་ཕྱིས་སུ་ཡང་ལན་དུ་མར་གསུང་ངོ།",
    "དེང་མཛད་པ་ལགས་ན་རང་ཅག་ལྟ་བུས་དེ་ལྟར་དགོས་པ་སྨོས་མ་དགོས་ཀྱང་སང་ནི་ཕལ་ཆེར་དེ་ལས་ལྡོག་ཏེ་སློབ་དཔོན་གཞན་ལྟ་ཞོག་གི།",
    "ལ་རི་མོ་བྲིས་པ་ལྟ་བུ་ཞིག་བྱས་ནས།",
    "དབྲ་ཁྱུང་གི་བརྒྱུད་འཛིན་སྤྲུལ་པའི་སྐུ།",
    "དེ་དག་གི་བར་མཚམས་རྣམས་སུ་བོན་སྐྱོང་ཨ་བསྲེའི་རྟེན་རྫས་དང་སྲོག་འཁོར་སོགས་གཞུང་བཞིན་ཚང་བར་བསགས་ནས།",
    "ཉིན་རེ་བཞིན་སྒྲུབ་ཁང་གི་རྩེར་སྲིན་བྱ་དང་འུག་པ་བབས་ཤིང་མཚན་མོ་རྒོད་པ་དང་།",
    "སྒྲུབ་ཁང་སྟེང་གི་ཤ་རུ་མང་པོ་གསས་མཁར་ལ་བཙུག་ཡོད་པ་ལས་མེ་འབར་བ་མི་མང་པོས་མཐོང་བ་དང་།",
    "སྒོ་དྲུང་ནས་མེ་མཁར་གཞོང་ཙམ་རེ་འབར་ནས་སྒྲུབ་ཁང་ནང་གི་སྐུ་རྟེན་ལ་ཐིམ་པ་ལན་མང་པོ་བྱུང་།",
    "དེ་དག་དང་འབྲེལ་བར་རྗེ་ཉིད་ཀྱི་གཟིམས་ལམ་དུ་རང་གི་ཕྲག་པ་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "གཡོན་པའི་སྟེང་གི་བར་སྣང་ལ་བུད་མེད་ནག་མོ་སྐུ་ལ་དར་ནག་གི་བེར་ཐུལ་གསོལ་ཞིང་རལ་པས་སྐུ་རྒྱབ་ཁེབས་པ།",
    "ཕྱག་གཡས་ན་གནམ་ལྕགས་ཀྱི་ཕུར་བུ་དར་ནག་གིས་བརྒྱན་པ་ཞིག་བསྣམས་ནས་ལན་རེ་གཡུག་པས་དུད་སྤྲིན་དང་མེ་སྟག་ཚྭ་ཚྭ་འཕྲོ་བ་དང་།",
    "དེ་སྐབས་སུ་རང་གི་གནས་ཚུལ་གྱི་ལུང་བསྟན་ཞུས་པར་གསུང་བྲིས་སུ་སྩལ་ནས།",
    "ཕྱིས་ནས་རྗེ་ཉིད་ཀྱིས་བསྟན་པ་ལ་ཞབས་འདེགས་དང་འགྲོ་དོན་རྒྱ་ཆེན་པོ་མཛད་པའི་ཚུལ་གསལ་བར་གཟིགས་པའི་གསུང་དུ་མངོན་ནོ།",
    "༡༡ས་བོན་ལ་ངེས་པར་སེམས་པའི་དད་མོས་ཀྱིས།",
    "མོས་པའི་རྩྭ་ལྗང་མྱུ་གུ་འབུས་ཙམ་ནས།",
    "ཀུན་རིག་སྦྱིན་སྲེག་བཅས་དེ་སོགས་ལུང་གི་རིགས་མང་དུ་གསན།",
    "དེ་དག་གི་ཞལ་ནས་ཨ་དཀར་གསལ་འབར་སོགས་ཀྱི་སྔགས་སྒྲ་འུར་འུར་གྲགས་ཤིང་འོད་སྐུའི་སྣང་བ་དང་སྔགས་སྒྲའི་གདངས་ལམ་ལམ་པ་དང་ལྡིར་ལྡིར་བའི་ངང་ནས་གཉིད་ལས་སད་ཅིང་གསལ་སྣང་དེ་ཡུན་རིང་ཙམ་དུ་མི་འགགས་པ་ཞིག་བྱུང་ངོ།",
    "བསྐོར་བ་ལ་སོང་བས་གྲུབ་རྗེའི་ཞལ་ནས།",
    "གནས་ལུགས་སྐྱོངས་དང་བདེ་མོར་གདའ།",
    "གསུངས་པས་ཉམས་ལེན་སྐྱོང་མུར་གར་སྟབས་བྱས་ནས་མདུང་རིང་དེ་མཚོ་ནང་དུ་བཙུགས་པས་གང་ལའང་རེག་པ་མི་འདུག་པས་རྐྱེན་བྱས་ནས་རང་ལ་སྣང་བ་གཏད་མེད་ཀྱི་ཉམས་བཟང་པོ་ཞིག་སྐྱེས།",
    "ད་མྱུར་དུ་འགྲོ་གསུངས་ནས་གསོལ་ཇ་ཡང་གསོལ་ལོང་མེད་པར་བྱོན་པས་བླ་བྲང་གི་སྒོ་ཁར་སླེབས་པ་དང་མཉམ་དུ་སྤྲིན་ནག་ཤིན་ཏུ་འཁྲིགས་པའི་ཀློང་ནས་འབྲུག་སྒྲ་ཆེན་པོ་ས་འགེམས་པ་ལྟར་སྒྲོག་ཅིང་ཆར་དྲག་པོ་ཉིན་མཚན་བརྒྱུད་མ་ཞག་གསུམ་དུ་བབས་པས་ཐན་པའི་གདུང་བ་མིང་མེད་དུ་བསལ་ཞིང་དེ་ལོར་ལོ་ལེགས་པ་བྱུང་།",
    "མགོན་བླ་པདྨ་བྱ་བ་དང་ཁྱེད་གཉིས་སོང་ལ་དབལ་གསས་ཀྱི་སྦྱིན་སྲེག་ཤིག་བཅའ་ཤོམ་ཀྱིས་དང་ང་རང་འོང་གིས་ཞེས་གསུངས།",
    "དཀྱིལ་འཁོར་དང་སྦྱིན་སྲེག་ཆས་རྣམས་ལྟ་གོན་བྱས་ཟིན་པ་དང་གྲུབ་རྗེ་ཉིད་དེར་ཕེབས་ད་ཁྱེད་གཉིས་ཀྱིས་སྦྱིན་སྲེག་འདོན་དང་ཆོག་གི་གསུངསཁོང་གིས་མེ་སྒྱོགས་དེ་ཕྱག་ཏུ་བླངས་ནས་མགུར་རིང་བོ་ཁོ་ན་འཐེན་ཞིང་བཞུགས།",
    "སྦྱིན་སྲེག་ཟིན་མ་ཐག་རྟ་ལྷས་སུ་འགྲོ་གསུངས་ནས་མེ་ཞགས་བརྒྱབ་ཅིང་ཚོམ་རྔམ་དྲག་པོ་མཛད།",
    "སྐུ་ཚ་ཚེ་ལི་བྱ་བས་མེ་རྫས་བླུགས་ཤིང་རྡེའུ་ཡང་བཅུག་པས་རྟ་དམར་པོ་ཞིག་གི་ཐོད་པ་ལ་བརྒྱབ་པས་འགྱེལ་ནས་སོང་།",
    "ཡང་བརྫོངས་ཤིག་གསུངས་ནས་མེ་སྒྱོགས་དེས་རྟ་དཀར་པོ་ཞིག་གི་རྩིབ་མ་ལ་བརྡེག་འགྱེལ་ནས་ལངས་པ་དང་མེ་མདའ་ལན་གཉིས་བརྫོངས་ནས་རྟ་རྫི་གཉིས་ལ་རེ་རེ་བརྒྱབ་པས།",
    "རྗེས་ནས་བལྟས་པས་མི་གཉིས་ཀྱི་རྡེའུ་གཅིག་གོས་ཀྱི་ཕྱི་དང་གཅིག་ནང་དུ་ལེབ་མོར་བྱས་ནས་སྣང་།",
    "དྲན་པ་ཡང་སྟོར་ནས་བརྒྱལ་ཐབས་སུ་སོང་བ་ལས་སླར་གཉིད་སད་པ་ལྟ་བུ་ཞིག་བྱུང་བའི་ཚེ།",
    "རྗེ་རང་གི་ཞལ་ནས་ཀྱང་རིག་པའི་ངོ་བོ་སྐྱོང་བདེ་ཙམ་ཡོད་པ་འདི་དེའི་དུས་སུ་བྱུང་བས་དུས་ཕྱིས་རྣམས་སུའང་རིག་པའི་ངོ་བོ་ལ་སྐྱེད་འདོན་རྒྱུ་ཅི་ཡང་མི་འདུག་སོར་རྟོག་ཡེ་ཤེས་ཀྱི་རྩལ་ཇེ་རྒྱས་སུ་སོང་ནས་ངེད་རང་བཀའ་དང་བཀའ་རྟེན་གྱི་དགོངས་པ་ཅི་རིགས་ཁྲོལ་ཞིང་ཤེས་བྱ་འབྱེད་པའི་བློ་གྲོས་མངའ་བ་འདི་གྲུབ་ཆེན་པ་རང་གི་བཀའ་དྲིན་ལས་སྐྱེས་པ་ཡིན་ཞེས་གསུང་གིན་གདའ་སྟེ།",
    "ཁྱོད་རང་གཉིས་ཀྱིས་རྡོ་ཆེན་པོ་འདི་ཚོ་མར་ལ་སྒྲིལ་དགོས་པར་འདུག་གསུངས།",
    "རྡོ་མང་པོ་བསྒྲིལ་བས་ཕ་བང་ཆེས་ཆེ་བ་ཞིག་འགྲིལ་བའི་རྐྱེན་དུ་གྱུར་ཏེ་རིའི་རྩ་བ་ན་རྡོ་ཆེན་པོ་གཉིས་ཕན་ཚུན་དུ་འདུག་པ་དེའི་སྟེང་དུ་ཕ་བང་དེ་མིའི་རྩོལ་བ་ཞིག་གིས་བཞག་པ་ལྟར་བསྡད་སོང་བ།",
    "རྗེས་སུ་གནས་སྒོ་འབྱེད་པའི་སྐབས་སུ་རྒྱུ་འབྲས་སྟོན་པའི་ལམ་འཕྲང་གི་བརྡ་སྟོན་དུ་མཛད་འདུག་པས་དེ་ལྟ་བུའི་དགོས་པའི་དོན་ལ་དགོངས་པ་ཡིན་པར་ངེས་སོ།",
    "ཆས་སུ་ཞུགས་ན་ཕྱི་ནང་མཐུན་པའི་རྟོགས་ལྡན་གྱི་མིང་ཐོགས་སུ་རུང་བར་ཡོད་མོད་ཀྱི།",
    "ཨང་ཞུས་པས་ད་དུང་ལན་གསུམ་དེ་སྐད་གསུང་གི་གདངས་མཐོན་པོས་གསུངས་པའི་སྐབས།",
    "ལོ་ན་གཞོན་ནུའི་དུས་ནས་མ་འོངས་གཟིགས་པའི་སྤྱན།",
    "བསྟན་པ་འབྲུག་བཞིན་གྲགས་པའི་ལུང་གིས་བསྟན།",
    "དམར་མོ་མཛུབ་ཚུགས་ཀྱི་སྐོར།",
    "སྐབས་དེར་རབ་བྱུང་སྒྲུབ་མཁན་མང་དུ་སྣང་བས་ཁྱེད་ཀྱང་རབ་བྱུང་གི་སྡོམ་པ་ཞུས་ཞེས་གསུངས་ཕེབས་ལས།",
    "ཤུགས་འབྱུང་རྡོལ་ཚེ་དུས་བབས་རྗེས་འབྲང་ཚོགས།",
    "སྐབས་དེར་རྗེ་ཉིད་ནས་མགོ་འཛིན་མཛད་ནས་བརྐྱང་ཕྱག་གིས་བསྐོར་བ་བྱས་པས་གཤེན་རི་བདེ་ལྡན་གྱི་འཕྲད་ལམ་གྱི་མཚམས་སུ་ཕྱིན་པའི་སྐབས་སུ་གནས་ཀྱི་དབུ་རྩེ་ན་འཇའ་ཚོན་སྣ་ལྔའི་འོད་གུར་ཆེས་ཆེར་བཀྲ་ལ་གསལ་བ་ཞིག་གི་དབུས་སུ།",
    "རྗེ་ཉིད་ལ་ཁྱེད་ལ་བདག་གིས་མིང་ཞིག་སྤོ་དགོས་གསུངས་ནས་སྔར་གྱི་མིང་བཀྲ་ཤིས་རྒྱལ་མཚན་ཞེས་པ་འདོགས་པར་གནང་བས་དགོས་པ་ཞིག་ཡོད་འདུག་པ་ལོས་ཡིན་སྙམ་པ་ཤར།",
    "གནས་ལུགས་ངོ་སྤྲོད་ཀྱི་ཞལ་ཁྲིད་ཀྱང་གནང་བས་རྗེ་ཀུན་ཏུ་བཟང་པོ་དང་དབྱེར་མ་མཆིས་པའི་དད་པ་ཐུན་མོང་མིན་པ་ཐུགས་རྒྱུད་ལ་འཁྲུངས་སོ།",
    "རྟེན་དང་ཚོགས་མཇལ་ལེགས་པར་ཞུས་ནས་གླིང་བསྐོར་དང་ཕྱག་ཅི་ནུས་འཚལ།",
    "སྐུའི་གནས་ལས་འོད་ཟེར་གྱི་འཕྲོ་འདུས་བྱིན་གྱིས་བརླབས་པའི་བརྡ་ཐུན་མོང་མིན་པ་གནང་།",
    "ཁྱོད་ཀྱིས་བསྟན་པའི་བདག་པོ་གྱིས་ཤིག་ཅེས་པའི་གསུང་གི་གནང་བའང་ཐོབ་པ་ཡིན་ཞེས་རང་ལ་དངོས་སུ་གསུངས་པ་ཟོལ་མེད་ཀྱི་གཏམ་ཡང་དག་པའོ།",
    "བསྟན་པའི་བདག་པོར་དབུགས་དབྱུང་ལུང་གིས་བསྔགས།",
    "ཞེས་པའི་ལུང་བཞིན་ཕྱི་རབས་ཀྱི་བོན་གྱི་འདུ་གནས་ཆེན་པོ་གཡུང་དྲུང་རྣམ་རྒྱལ་ཀུན་གྲགས་གླིང་དུ་ཞབས་ཐེག་ནས་ཞག་འགའ་སོང་བས།",
    "གནས་བརྟན་བགྲེས་པོ་ཞིག་ན་རེ།",
    "དེ་ནས་རྐང་པ་གཡས་པ་དེ་ཤིན་ཏུ་ན་བ་ཞིག་བྱུང་ནས་ནམ་ལངས་ཚེ་སྒངས་ནས་ལང་དཀའ་བ་ཞིག་བྱུང་སོང་།",
    "ཁྱེད་རྣམས་རང་ཡུལ་དུ་ལོག་ནས་སོང་།",
    "རང་གི་ཡིད་ལ་དེར་བཞུགས་སྤྲོ་བའི་ཐུགས་དགོངས་ནར་མར་བྱུང་ཡང་ལས་སམ་སྐལ་བ་ཞིག་གིས་མཐུན་རྐྱེན་ཅུང་ཟད་མ་འགྲུབ་པར་དེ་གར་ལུས།",
    "སླར་ཡང་སྲུང་མ་རྣམས་ལ་གཏོར་བསྔོས་དང་ཕྲིན་བཅོལ་ལེགས་པར་བྱས་ནས་བདག་འདི་ནས་སྐྱེ་བ་ཐམས་ཅད་དུ་ལུས་ངག་ཡིད་གསུམ་གྱི་བྱ་བ་ཅི་བྱས་པ་ཐམས་ཅད་གྲྭ་ས་གོང་འོག་གི་བསྟན་པ་ལ་ཕན་ཐོགས་པར་གྱུར་ཅིག་ཅེས་པའི་ཐུགས་སྨོན་ཡང་དག་པར་གནང་བར་མཛད་དོ།",
    "དེ་ནས་རིང་པོར་མ་ལོན་པར་ཁུ་བོ་དུས་ལས་ཡོལ་ནས་ཞི་བར་གཤེགས་པས་བདུན་ཚིགས་ཀྱི་ཆོ་ག་ལ་བརྟེན་ནས་ཞེ་དགུའི་གནས་སྦྱོང་གི་ལག་ལེན་རྒྱས་པར་བྱས།",
    "ཞབས་གྲས་རྣམས་ནས་མ་མོ་སྟག་རེ་རོང་གི་འགུག་ལས་འདོན་པའི་སྐབས་སུ།",
    "བུ་མོ་ཡ་མཚོ་བྱ་བ་ཞིག་མགོ་ས་ལ་གཏད་ནས་བརྒྱལ་ཐབས་སུ་འགྱེལ་ནས་འདུག་པ་ལ།",
    "སླར་ཡང་རལ་གྲི་ཚུར་བླང་པས་བུ་མོ་དེ་འགྲེ་ལྡོག་ལིང་ལིང་བྱེད་པ་ལ་རྨ་ནས་ཁྲག་འཛག་རྒྱུ་གཏན་ནས་མི་སྣང་།",
    "དཀྱིལ་འཁོར་གྱི་མདུན་མ་ཏང་གྲུ་གསུམ་གྱི་འགྲམ་དུ་འགྲེལ་ནས་བརྒྱལ་སོང་།",
    "དེ་ལ་ཤི་འདྲེ་ཞིག་གིས་ལོ་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "བདག་བཟུང་བྱས་ནས་ཡོད་འདུག་པས་ཕྱིན་ཆད་གདོན་དང་བྲལ་བས་ཕན་སོང་ཞེས་ཞལ་ནས་གསུངས།",
    "རྗེས་སུ་ལོ་གཅིག་ནང་དུ་རྒྱལ་བློན་ནང་འཁྲུགས་ཀྱིས་མ་མཐུན་ཏེ་ཡུལ་མ་ཟིན་ནས་འགྲོ་དགོས་པ་བྱུང་སོང་བས་གྲུབ་རྗེ་འདིའི་མངོན་ཤེས་དང་ལུང་བསྟན་ལྟ་བུ་གཞན་སུ་དང་གང་གིས་བསྒྲུན་དུ་མེད་པའི་གནས་སུ་སྣང་བའང་ཤེས་པར་འཚལ་ལོ།",
    "སེམས་ལ་ལྷན་སྐྱེས་ཀྱི་བདེ་བ་ཆེན་པོ་ཇེ་བས་ཇེ་འཕེལ་དུ་སོང་།",
    "དེའི་སྟོབས་ཀྱིས་སེམས་ཀྱི་དྭངས་སྙིགས་ཕྱེད་དེ་དྭངས་མའི་གནས་ལུགས་རང་བབས་སུ་བསྐྱངས་པས་སྨྲ་བསམ་བརྗོད་པ་དང་བྲལ་བའི་དགོངས་པ་ལ་ངང་གིས་གནས་པ་ཞིག་བྱུང་བས་གསང་སྔགས་ཐབས་ཀྱི་ལམ་འདི་ཤིན་ཏུ་ཟབ་སྙམ་པའི་ཡིད་ཆེས་ཀྱི་ངེས་ཤེས་ནང་ནས་སྐྱེས་པ་ཡིན་གསུངས།",
    "ཁོང་གིས་སྙན་ཤལ་དང་མཆོད་ཐེབས་ཀྱང་རང་དགོན་དུ་བསྐུར་གནང་མཛད་སོང་།",
    "ཁོང་གི་ཞལ་སྔ་ནས་འདི་ལྟར།",
    "ཉམས་ལེན་གྱི་གདེངས་ཡོད་པ་ཞིག་གིས་མུན་ཁྲིད་ལ་བརྟེན་ནས་བོགས་འདོན་པ་ཡིན་པས་ཉམས་ལེན་ཅི་འདྲ་ཡོད་གསུངས་ཕྱག་རྫོགས་དབུ་གསུམ་གྱི་ལྟ་བའི་གོ་དོན་དང་ཉམས་སུ་བླང་ཚུལ་རྣམས་ཞུས་པས།",
    "ད་གོམས་ནས་བརྟན་དགོས་པས་གོང་གི་རི་ཁྲོད་དེར་སོང་ལ་བརྩོན་པ་བསྐྱེད་ནས་ཉམས་ལེན་ཐུན་བཞི་ཞག་ལྔ་བཅུར་བཞུགས་ལ་སླར་བྱོན་ཅིག་གསུངས།",
    "གཙོ་རྐྱང་གི་རྣམ་པ་གྲངས་མེད་པ་འཆར་བ་བྱུང་།",
    "ས་གནོན་མཛད་པ་རིགས་ལྔ་ཡོངས་སུ་རྫོགས་པའི་ལྔ་ཚོམ་ཁོ་ན་ཆེ་ཆུང་གི་རིགས་དུ་མ་དང་།",
    "དཔག་བསམ་རྩེ་མོར་འགྲོ་ལ་སྣང་སྲིད་བལྟ།",
    "རི་བྲག་ལ་ཐལ་བྱུང་དུ་འགྲོ་བ་དང་ལུས་སྣ་ཚོགས་སུ་སྤྲུལ་ཞིང་འདོད་དགུར་བསྒྱུར་ནུས་པ་ཞིག་བྱུང་རེ་འགའ་ནི་གཉིད་པའི་ཚེ་རྨི་ལམ་མེད་པར་འོད་གསལ་ཟིན་པའང་བྱུང་ངོ།",
    "ཆ་༡༡ དེ་ནས་བཟུང་བདུན་ཐ་མའི་ནང་ཚུན་ཆད་སྟེང་འོག་ཐམས་ཅད་ནམ་མཁའ་གཡའ་དག་པ་ལྟ་བུ་དྭངས་ལ་གསལ་བ་ཤིན་ཏུ་རྒྱ་ཆེ་བ་ཞིག་གི་ནང་དུ།",
    "དེ་ལྟར་མུན་པའི་རྣལ་འབྱོར་ལ་གོམས་པའི་མཐུས་ཅི་ཤར་ཐམས་ཅད་རང་རིག་པའི་ཡེ་ཤེས་སུ་ངང་གིས་ཤར་ཏེ་སྒོམ་མི་སྒོམ་གྱི་ཁྱད་པར་གཏན་ནས་མེད་པར་སྒོམ་གྱི་རྟོད་ཕུར་རྩད་ནས་ཐོན་ཏེ་འབད་རྩོལ་སྤྲོས་པའི་ཡུལ་ལས་འདས་པའི་དགོངས་པའི་རྩལ་ཡོངས་སུ་རྫོགས་པར་གྱུར་ཏོ།",
    "ཕྲེང་གསུམ་རེ་དུས་གཅིག་ཏུ་བཏོན་པས་དབུས་མ་དེའི་ཚིག་དོན་ངེས་ཤེས་བཅས་ཡིད་ལ་གསལ་ཞིང་།",
    "འོག་མ་དེ་ཡིད་ལ་ཕྱོགས་ཙམ་ངེས་པ་ལྟ་བུའི་ངང་ནས་ཇ་སྦྱོར་ཙམ་ལ་རྫོགས་སོང་སྙམ་པའང་བྱུང་སྟེ།",
    "འགྲོ་མགོན་ཤེས་རབ་གཡུང་དྲུང་གི་ཞལ་གདམས་སྐོར།",
    "དེ་ནས་རང་ཡུལ་སྟེང་ཆེན་དུ་ཆག་ཕེབས་ནས་དེ་ལོར་རྫོགས་ཆེན་ཡང་རྩེ་ཀློང་ཆེན་ལྟར་རིགས་དྲུག་རང་སྦྱོང་གི་བཅད་རྒྱ་ཞེ་དགུ་བ་ཞིག་བཞུགས།",
    "དེང་སང་གི་སྒོམ་ཆེན་ཕལ་ཆེ་བ་ལྟར་ལྟ་སྒོམ་གྱི་སྙེམས་པས་དགེ་སྤྱོད་ཀྱི་བྱ་བ་ཁྱད་དུ་གསོད་པའི་ལུགས་མིན་པར་སྔོན་འགྲོའི་བསགས་སྦྱང་རང་ཡང་ལན་གྲངས་སུ་བརྩོན་པར་མཛད་པ་ནི་རྒྱུ་འབྲས་མི་བསླུ་བའི་གནས་ལ་ངེས་ཤེས་ཚུལ་བཞིན་དུ་སྐྱེས་པའི་རྟགས་ཡང་དག་པའོ།",
    "དེ་དག་གི་སྔ་ཕྱིའི་རྩེདབྲ་སྟོན་པཎྜི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "ཚོགས་པའི་ལས་སློབ་དང་བྱང་འདྲེན་དང་གར་ཐིག་གི་བྱ་བ་སོགས་གང་ལའང་གལ་ཆུང་དུ་མ་བཞག་ཅིང་ཕྱག་ལེན་ཁུངས་མི་དང་འབྲེལ་བར་ཚོགས་པའི་རྒྱན་དུ་འགྱུར་བཟོད་པའི་ཉམས་བཞེས་གནང་བའང་བསྟན་པའི་དོན་ལ་སྲི་ཞུ་བགྱིད་པའི་བསམ་པས་ཞུགས་པ་ཡིན་པས་ཐ་མལ་དཀྱུས་མའི་སྤྱོད་ཚུལ་དང་མཚུངས་པའི་སྐབས་མེད་པའང་ཤེས་པར་བྱ་བའི་གནས་སོཎ་ཆ་ལོ་ཁྲི་ཁ་ཎ་ཀ་༡ཆ་བ་ཕན་དང་བདེ་བའི་འབྱུང་གནས་རྒྱལ་བའི་བསྟན།",
    "གྱི་པཎའཕགས་ཚོགས་གསེར་ལྡན་ཁྱོད་དུ་ལྷམ་མེར་བརྗིད།",
    "རབ་མཁན་པའི་མཐོང་ན་མི་མཐུན་མེད་པའི་འདྲེན་པ་ཁྱོད།",
    "དམ་ཚིག་གི་རྫས་མ་གཏོགས་པའི་མྱོས་བྱེད་ཀྱི་ཁུ་བ་ལྗགས་ཐོག་ཏུ་མི་བཞེས་ཤིང་།",
    "ཕྱི་དྲོའི་ཁ་ཟས་ལྟ་ཞོག་གི་སྒོག་ཙོང་གི་རིགས་སྣ་ཚོགས་དང་བཅས་སྤོང་བ་དང་།",
    "ཟླ་དུས་ཀྱི་གསོ་སྦྱོང་རང་དང་ཚོགས་པ་གང་འཛོམས་སུ་ཆགས་མེད་དང་།",
    "ཞེས་གསུངས་པ་ལྟར་རྒྱལ་བའི་བསྟན་པ་ནི་རྟགས་ཀྱི་ཆེ་བ་ཡིན་པས་གང་ན་ངུར་སྨྲིག་གི་རྒྱལ་མཚན་འཛིན་པ་ཡོད་པ་དེར་རྒྱལ་བའི་བསྟན་པའང་ཡོད་པའི་མཚན་རྟགས་སུ་སྟོན་པའི་ཞལ་སྔ་ནས་ལེགས་པར་གསུངས་པས་དགོས་ཆེད་ཤིན་ཏུ་ཆེ་ཞིང་།",
    "ག་ཏུདེང་སང་ནི་སྙིགས་མའི་དུས་ཀྱི་མཐུ་བདོ་བས་རབ་བྱུང་དང་དྲང་སྲོང་གི་མིང་ཙམ་གྱིས་སྙེམས་པས་སོས་དལ་ལེ་ལོར་གྱུར་ཅིང་རྟགས་ཀྱི་སྒོ་ནས་དགེ་སྦྱོང་གི་གྲལ་དུ་རྒྱུ་བ་དང་གཞན་དག་གིས་ཀྱང་ཕྱི་ཚུལ་བཟང་བོར་བཅོས་པ་ཁོ་ན་ལ་གུས་པའི་གནས་སུ་བརྩི་ཞིང་དེ་ཁོ་ན་ལ་ཡིད་རྟོན་བྱེད་པ་དུས་ཀྱི་སྐལ་བར་ཐོབ་པ་ཡིན་མོད་ཀྱི།",
    "དེ་ལས་ཕལ་མོ་ཆེས་ཁྱིམ་ཆེན་སྤངས་ནས་ཀྱང་ཁྱིམ་ཆུང་ལོགས་སུ་བཟུང་ནས་སོ་ནམ་གྱི་གཞི་འཛིན།",
    "ཡི་དམ་དཀྱིལ་འཁོར་གང་རུང་གི་གཞུང་བསྲང་སྟེ།",
    "དེའང་རྟོགས་པ་མངོན་གྱུར་གྱི་རྣལ་འབྱོར་ལ་སྡོམ་པ་འོག་མའི་ཡོན་ཏན་ཡར་ལྡན་དུ་ཚང་བ་ཡིན་པས་ཆེད་དུ་བྱ་བའི་ཡུལ་དུ་ཞེན་མི་དགོས་པའི་སྐབས་ཀྱང་ཡོད་པ་ཡིན་མོད།",
    "དེའི་ཚེ་དག་པའི་སྣང་བར་ལྷ་དང་གཞལ་ཡས་ཁང་མངོན་རྟོགས་དང་མཐུན་པ་ཞིག་མངོན་སུམ་དུ་ཞལ་གཟིགས།",
    "ཚེ་འབྲང་ལས་མྱུ་གུ་སྔོན་པོ་སྐྱེ་བ་སོགས་རྟགས་དང་མཚན་མ་ལེགས་ཤིང་ཚེའི་དངོས་གྲུབ་བརྙེས་ནས་རྗེ་ཉིད་སྐུ་ཚེ་རིང་པོར་འཚོ་ཞིང་གཞེས་ནས་བསྟན་འགྲོའི་དོན་ཡུན་རིང་དུ་མཛད་པའི་རྟེན་འབྱུང་གི་སྒོ་འཕར་ཅིར་ཡང་བྱེ་བར་གྱུར་ཏོ།",
    "གཞན་ཡང་སྐབས་དེར་གཟིམ་ལམ་དུ་བླ་བྲང་གི་ལྷ་ཁང་ན་དུས་གསུམ་སྟོན་པའི་སྐུ་སོགས་ལྡེར་སྐུ་རྣམས་གཡོ་ཞིང་འགུལ་ཤིག་ཤིག་བྱེད་པ་ན།",
    "ལྷ་ཁང་སྟེང་ནས་བཙུན་པ་གཟན་ཤམ་ཆས་ལྡན་ཞིག་གིས་བུམ་ཆུ་ཞིག་བླུག་པས་གཡོ་འགུལ་བྱེད་པ་ཞི་ནས་བསྡད་པ་ཞིག་བྱུང་འདུག་པ་ལ་བརྟག་ན།",
    "དེ་ནས་རྗེ་ཉིད་ཀྱི་གྲྭ་ཁང་རྙིང་པ་དེ་ཞིག་གསོས་ཀྱིས་ཐོག་བརྩེགས་གཉིས་པ་ཞིག་བྱས་ནས་མཆོད་ཁང་ཆུང་ངུ་ཞིག་གི་ནང་དུ་དུས་གསུམ་སྟོན་པ།",
    "ཤིང་གི་རྒྱུ་ལས་སྐུ་གདུང་ཆ་བརྒྱད་རྣམས་གསར་བཟོའི་ནང་དུ་གཟུངས་གཞུག་བཅས་ཚད་ལྡན་དང་ཚོན་རྩི་བཅས་ལེགས་པར་བསྐྲུན་ནས་རབ་གནས་ཀྱི་མེ་ཏོག་འཐོར་ནས་བཀྲ་ཤིས་པར་བྱས་སོ།",
    "དེ་དག་གི་སྔ་ཕྱི་རྣམས་སུ་སྒྲུབ་ཁང་ལ་དྲི་བཟང་པོས་ཁྱབ་པ་དང་།",
    "མཚན་མོའི་གཟིམས་ལམ་ཞིག་ན་རང་ཉིད་སྟག་ལ་མེ་འབར་གྱི་སྐུར་དངོས་ཡིན་པའི་སྣང་བས་གཡས་གཡོན་སྤུ་གྲི་དང་ཐོད་ཁྲག་བསྣམས་ཤིང་མེ་གུར་གྱི་ནང་ན་བཞུགས་པའི་གསལ་སྣང་དང་ང་རྒྱལ་བཅས་ཏེ།",
    "རེབ་ཀོལ་བ་ལྷག་པའི་ལྷ་ཡིས་བསླུ་བ་མི་སྲིད་པས།",
    "སྣ་ཚོགས་འཆར་བའི་གཟིགས་མོ་ཇི་སྙེད་པ།",
    "བདག་གིས་རིང་མོ་ནས་གནས་འགྱུར་རིག་གསུམ་གྱི་ཉམས་ལེན་ལ་གོམས་འདྲིས་ཅི་རིགས་བྱས་ཀྱང་ཡིན་མིན་རྩིས་གདབ་ཀྱི་འཕྲང་ལས་མ་འདས་སམ་སྙམ་ལ།",
    "མར་མེད་དུས་ཚིལ་ལ་ཚངས་སུ་རེ་དགོས་ཀྱང་མར་ཡོད་ནས་མི་དགོས་པ་དང་འདྲའོ་གསུངས།",
    "ཤར་ན་སྤང་བླང་བྱེད་མི་དགོས་ཏེ་གསེར་མ་རྙེད་བར་དུ་ཚོལ་དགོས་ལ་རི་ལུང་གསེར་དུ་སོང་ན་གསེར་ཚོལ་མི་དགོས་པ་དང་འདྲའོ་གསུངས།",
    "གིས་མཐོང་བས་མི་ཆོག་པར་ངོ་ཤེས་ནས་མིང་ཐོགས་པ་དགོས་པའི་ཚོད་དུ་འདུག་གསུངས་ཐལ་མོ་སྦྱར་བར་མཛད།",
    "རྗེའི་མནལ་སྣང་ལ་རང་དགོན་ཡི་རྒྱབ་རི་དེ་གངས་རི་ཆེས་མཐོ་བ་ཞིག་ཡོད་པ་ཞུད་ནས་ལྷ་ཁང་དང་གྲྭ་ཁང་ཀུན་མནན་ནས་ཅུང་ཟད་རེ་ཕྱག་ཀྱང་མི་ཕན་པར་ཐམས་ཅད་གངས་ཞབས་སུ་མནན་པ་དང་།",
    "རི་མཐོན་པོ་ཞིག་གི་རྩེ་ནས་ལྕགས་ཀྱི་སྡོང་བོ་སྦོམ་ལ་རགས་པ་ཞིག་འགྲིལ་ནས་སྲོག་ཆགས་སྟོང་ཕྲག་དུ་མ་བསད་ཅིང་ཐུར་དུ་འདེད་པའི་གཟིམས་ལམ་ཞིག་བྱུང་བས་རྗེའི་ཐུགས་ལ་དོགས་པ་ཆེར་སྐྱེས་ཀྱང་སུ་ལའང་གསུངས་མ་ནུས་པར་གསང་ནས་བཞུགས་སོ།",
    "མཚན་མོ་རྨི་ལམ་དུ་དོགས་གཅོད་བྱེད་པ་ལན་མང་དུ་བྱུང་ཞེས་རང་ལ་དངོས་སུ་གསུངས་པའང་ཐོས་སོ།",
    "རྫོགས་ཆེན་པས་རིག་པ་རྐྱང་དེད་ཀུན་བཟང་གི་དགོངས་པར་ངོ་སྤྲོད་པའི་ཚུལ་གྱིས་དམར་ལ་ཟབ་པ་ལྟར་བྱེད་ཀྱང་།",
    "དོན་གྱི་བབས་པ་སྒྲིག་ན་རིག་པ་རྗེན་པའི་སྟེང་དུ་འཁོར་འདས་ཀྱི་གཞི་རྩ་ཆོད་དགོས་པས་དེ་ལས་མ་འདས་པ་ཡིན་མོད་ཀྱི།",
    "རྣམ་གྲངས་མ་ཡིན་པའི་དོན་དམ་པའི་གནས་ལུགས་མཐར་ཐུག་དང་ཕྱག་རྫོགས་ཀྱི་དགོངས་པའི་མཐར་ཐུག་མཚོན་བྱེད་ཀྱི་ཚིག་རིས་ཙམ་མ་གཏོགས་དོན་གྱི་མཐིལ་དགོངས་པ་གཅིག་ཏུ་འབབ་པས་ཁོ་བོས་ངེས་ཤེས་རང་ལས་རྙེད་པ་ཡིན་ཞེས་སེང་གེ་ལྟར་འཇིགས་པ་མེད་པའི་དབྱངས་མཐོན་པོས་འཁོར་གྱི་དཀྱིལ་འཁོར་གྱི་ཁྱོན་ཀུན་ཏུ་ལན་གཅིག་མ་ཡིན་པར་བཀའ་སྩལ་པས་རྗེས་འབྲང་གི་ཚོགས་ཀུན་ལའང་ངེས་ཤེས་ཀྱི་གཏེར་སྒོ་ཕྱེད་པའི་དམིགས་རྐྱེན་མཆོག་ཏུ་གྱུར་ཏོ།",
    "༢༩བ་ཐལ་ཁྱཁྱབ་བདག་ཀུན་ཏུ་བཟང་པོའི་དགོངས་པའི་མཐིལ།",
    "ཀ་འདི་ལས་གཞན་དུ་རྒྱལ་བས་ཅང་གཟིགས་སམ།",
    "ཁྱོ་མང་།",
    "འདིར་རྒྱལ་བའི་བསྟན་པ་ཡོངས་རྫོགས་གང་ཟག་གཅིག་གི་ཉམས་ལེན་དུ་སྦྱོར་བ་དང་།",
    "རྫོགས་ཆེན་གྱི་ལུགས་ཀྱི་ཡུལ་མེད་ཟང་ཐལ་གྱི་རིག་ངོ་སྐྱོང་པ་རྣམས་མཐའ་ཐུག་དགོངས་པ་གཅིག་ཏུ་འབབ་པས་ཇི་སྐད་དུ།",
    "རྗེ་ཉིད་ནས་ཀྱང་གདམས་ངག་ཚད་དུ་ཕྱིན་ནས་ཕྱིན་ཆད་གདམས་ངག་གཞན་ལ་རེ་མི་དགོས་པ་ལྟ་བུ་ཡིད་ཀྱི་རེ་བ་ཡོངས་སུ་རྫོགས་པ་ཞིག་བྱུང་སོང་ཞེས་གསུངས་སོ།",
    "བཞུགས་ཚུལ་རྣམས་ཡབ་དང་སྲས་ཀྱི་གསུང་གནང་གི་ཚུལ་དུ་བཀའ་མཆིད་སྨར་ལ་ཟབ་པ་མང་དུ་གནང་བས་ཐུགས་རབ་ཏུ་ཚིམ་ཞིང་ཡིད་བདེ་ཆེན་པོར་སྐྱེས་སོ།",
    "རྟོག་པ་གཉིས་པ་ལ་གྲུབ་རྗེ་དཔོན་སློབ་གདན་ས་འདིར་སྟན་ཆགས་སུ་བཞུགས་མུར་ཐག་རིང་དུ་བྱོན་ནས་ཕྱིས་ཡུན་རིང་པོར་མི་འཕྲད་པའི་གཏམ་གྱི་ཞེ་འཇོག་ལྟ་བུ་ཞིག་བཞག་སོང་སྙམ་པ་ཞིག་ཐུགས་ལ་ཤར་བར་གྱུར་ཏོ།",
    "བདུན་དྲུག་པའི་སྐབས་སུ་གྲུབ་ཐོབ་ཆེན་པོ་ཉིད་སྐུ་ཅུང་ཟད་བསྟུན་པའི་ཚུལ་བསྟན་ནས་ཞག་འགའ་ཞིག་གི་ནང་དུ་དགོངས་པ་ཞི་བའི་དབྱིངས་སུ་མནལ་ཏེ་གཞིའི་འོད་གསལ་མངོན་དུ་བྱས་ཏེ་ནམ་མཁའ་ནང་འདྲེན་པ་བཞིན་དུ་བོན་སྐུའི་ཀློང་དུ་དགོངས་པ་བསྡུས་སོ།",
    "དེ་ནས་བདག་དད་མོས་གསོལ་བ་བཏབ་པའི་ཐུགས་རྗེ་དང་།",
    "འངས་ལ་ཁམས་ཞེས་གྲགས་པའི་གསེར་ལྡན་ཁྱོན་ཡངས་སུ།",
    "བྲན་པ་གང་གི་རྟོགས་པ་བརྗོད་པའི་ཆ་ཤས་ཙམ།",
    "དཔལ་མཉམ་མེད་པ་ཆེན་པོའི་བཀའ་སྲོལ་འཁྲུལ་བའི་ནོང་པ་ཐམས་ཅད་དང་བྲལ་བའི་རྗེས་བཞག་གི་མཛད་པ་ཡིན་ལ།",
    "མཚན་ལམ་དུ་མ་མོ་སྔགས་སྲུང་མའི་ཞལ་གཟིགས་ཏེ།",
    "རྟོགས་པ་ལ་བརྟན་པ་ཐོབ་ན་དགོན་གཞི་བསྐྱངས་ནས་བསྟན་པའི་ཞབས་འདེགས་བསྒྲུབ་པའང་བོན་གྱི་བྱ་བ་གཅིག་ནི་ཡིན་མོད་ཀྱང་།",
    "རང་གི་མོས་པ་དང་།",
    "བར་དགོངས་ནས་ཕྱི་ནང་གང་གི་དོན་དུ་གྲོང་ཆོག་ལ་གཏན་ནས་མི་འབྱོན་པ་དང་།",
    "དེ་ནས་ཁོང་གསུམ་པོ་ཡང་རེ་ཞིག་ལྷ་སར་ཐེག་ནས་དཔོན་གཡོག་ལྷན་རྒྱས་ནས་དབུས་གཙང་གི་གནས་རྟེན་རྣམས་ལ་མཆོད་འབུལ་ཚོགས་བསགས་དང་གྲྭ་ས་གོང་འོག་ལ་སྐུ་འགྱེད་མང་ཇ་སོགས་གཏོང་སྒོ་རྒྱ་ཆེར་མཛད།",
    "དཔལ་ལྡན་བྲུ་ཚང་གི་ཨ་ཁྲིད་ཐུན་མཚམས་བཅོ་ལྔ་བའི་སྔོན་དངོས་རྗེས་གསུམ་གྱི་སྨར་ཁྲིད་རྒྱས་པ་ཞིག་གནང་བའི་བཀའ་དྲིན་སྩལ།",
    "དེའི་སྐབས་སུ་ཨ་ཁྲིད་ཀྱི་སྔོན་འགྲོ་ཅུང་ཟད་རྒྱས་པ་ཞིག་འབྲི་བར་དགོངས་ནས་རྩ་ཚིག་གི་ས་བཅད་ཀྱི་རིམ་པ་རྣམས་ཐུགས་ལ་ཤར་བ་བཞིན་ཐོ་བཀོད་གནང་།",
    "དམར་མོ་མཛུབ་ཚུགས།",
    "གཅིག་གཤེན་ཚང་གི་གདུང་རིགས་ཤིག་ལས་འཁྲུངས་ཚུལ་ལུང་རེ་མཆིས་ཀྱང་དོན་ཐོག་མ་ཁེལ་བར་ལུས།",
    "རེ་ཞིག་ནས་རི་ངོགས་ཕན་ཚུན་ཐམས་ཅད་ཁྱབ་པའི་འཇའ་གུར་ཟླུམ་པོ་ཆེས་ཆེར་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "བཀྲ་བ་རིམ་པ་མང་པོར་འཁྱིལ་བའི་འཇའ་སྣེ་རྣམས་ཁོང་གཉིས་བཞུགས་པའི་མདུན་ཕ་ཝཾ་ཞིག་ཡོད་པའི་སྟེང་དུ་ཟུག་ནས་སོང་བས།",
    "བདག་གི་རྨི་ལམ་དུ་རང་ཡུལ་གྱི་ནམ་མཁའ་ལ་སྤྲིན་ནག་གིས་ཁེབས་ནས་ཡོད་པ་དེ་སྤྲིན་དམར་དུ་གྱུར།",
    "ད་ལན་ཁྱེད་ལ་ཁྲིད་འདེབས་ཆོག་ཅེས་གསུང་གནང་ནས་ཁྲིད་བཏབ་པས་ཉམས་ཀྱི་འཆར་སྒོ་དང་རྟོགས་པ་ལ་བོགས་ཐོན་ཚུལ་སོགས་ལེགས་ལམ་དུ་སོང་ནས་ཉམས་རྟོགས་བཟང་པོ་འཁྲུངས་པ་བྱུང་གསུངས།",
    "དེ་དག་གི་དགོས་དོན་གང་ཡིན་བྱས་ན་ཚེ་འདིའི་འཁོས་ཁ་ཐབས་དང་དཀོར་ནག་གང་རྙེད་བསྡུ་རྒྱུ་ཙམ་ལ་བློ་གཏད་འཆའ་བའི་གང་ཟག་མང་ཡང་།",
    "དེས་ན་ཚེ་འདིའི་བྱ་བ་སྤྱི་དང་དགོན་གཞི་བཟུང་ནས་ཚོགས་པའི་ཁ་ཐབས་བསྐྱང་བའང་བསྟན་པའི་གཞི་འཛུགས་པའི་མཛད་པ་བླ་ན་མེད་མོད།",
    "དེ་ནས་ཁོང་ལ་བདག་གིས་རི་ཁྲོད་ཅིག་བྱ་དགོས་པས་ས་དཔེ་ལེགས་ཉེས་ལ་དཔྱད་རོགས་ཞུས་ནས་ཁོང་དང་མཉམ་དུ་བྱོན་ཏེ།",
    "རེ་ཞིག་རྣམ་པའི་སྣང་ཚུལ་ལྟར་ན།",
    "སྣུམ་ཞིང་འབོལ་བའི་ཞིང་ས་རེའུ་མིག་ལྟར་ཆེས་ཆེར་རྣམ་པར་བཀྲ་བ་རྣམས་སུ་དད་པ་དང་ལྡན་པའི་སྐྱེ་བོའི་ཚོགས་དུ་མའི་ཡོངས་སུ་ཁེངས་བ།",
    "དེ་ལྟ་བུའི་དབེན་པའི་གནས་དེར་མིའི་རྒྱུ་འགྲུལ་དང་བསམ་གཏན་གྱི་འཚེར་མ་སྒྲ་སྐད་སོགས་འགལ་རྐྱེན་གྱི་རིགས་མཐའ་དག་གིས་དབེན་ཞིང་།",
    "དེ་རེད་པ་བའི་གྲོང་མི་རྣམས་ནས་ཤིང་ཆ་རྣམས་ཕུལ་ཟེར་ནས་ཁོང་རྣམས་ཀྱིས་ཁང་པ་ཐོག་བརྩེགས་གཉིས་པ་ཞིག་བྱེད་ན་ལེགས་ཞེས་གྲོས་བྱེད་པ་ན།",
    "སྤོང་བའི་ཁང་ཆུང་སྤྱོད་ལམ་བཞི་ཤོང་ཙམ་ཞིག་གིས་ཆོག་པར་གདའ་གསུངས་པས་རྡོ་བརྩིགས་ཀྱི་ཁང་ཆུང་སྤྱོད་ཡུལ་ལ་བྱོན་བཞུགས་བདེ་བ་ཞིག་བྱས།",
    "འཇིག་རྟེན་གྱི་འདུ་འཛིའི་འབྲེལ་ཐག་གཅོད་པ་དང་གཅིགཆགས་སྡང་ཚོགས་མང་གི་མགོ་འཛིན་མི་བྱེད་པ་དང་གཉིས།",
    "ཕྱི་མའི་སྒྲུབ་བརྒྱུད་ཀྱི་རིང་ལུགས་ཁོ་ན་སྐྱོང་བ་ལས་ཕྲིན་ལས་སྣ་ཚོགས་ཀྱིས་ཡོན་ཏན་ཟོངས་སུ་མི་འཚོང་བ་དང་ལྔ་སྟེ་དེ་ལྟར་ཐུགས་ལ་ངེས་ཤེས་ཀྱི་དམ་བཅའ་བརྟན་པར་བྱས་ནས་འདུ་འཛི་དང་ཆགས་སྡང་གི་བློ་སྣ་ཐམས་ཅད་འུབས་ཀྱིས་བཟུང་ནས་བྱ་བྲལ་ཀུན་སྤངས་ཀྱི་བརྟུལ་ཞུགས་ཁོ་ནས་བསམ་གཏན་གྱི་སྟན་ལ་གང་བའི་ཟླ་བ་བཞིན་དུ་ལྷམ་མེར་གནས་པར་གྱུར་ཏོ།",
    "གཞན་གྱི་འབུལ་བ་བྱུང་ནའང་འཚོ་ཆས་རིགས་རྣམས་བཞེས་པ་ལས་བསྔོ་རྟེན་ཊི་རེ་བབས་ཙམ་ལས་ཆེན་པོ་མ་བླངས་པར་བརྟུལ་ཞུགས་བྱ་བྲལ་དང་འཚོ་བ་དཀའ་ཐུབ་ལ་བརྟེན་ནས་ནམ་ཟླ་ཅི་འཁྱོལ་བྱས་ཏེ་བཞུགས་པར་གནང་།",
    "རྒྱུན་དུ་ཚོང་སོ་ནམ་དགྲ་འདུལ་གཉེན་སྐྱོང་གི་བྱ་བ་ལ་ཆུ་བོའི་རྒྱུན་བཞིན་འབད་ནས།",
    "སྔ་དགོངས་རྣམས་སུ་སྟབས་ལེགས་ཀྱིས་བོན་སྤྱོད་ཀྱི་བྱ་བ་ཅུང་ཟད་རེ་བྱས་ཀྱང་སེམས་ལ་ཡར་སྐྱེད་སྤུ་ཙམ་མ་བྱུང་བས་མཐའ་དེའི་ངང་ལ་ཉི་མ་མ་འཁྱོལ་ཏེ་རི་ནས་ཀླུང་དུ་བབས་ཏེ་རི་ཁྲོད་པ་གྲོང་ཁྲོད་པར་གནས་འགྱུར་བ་མང་དག་མཆིས་པ་ལྟ་བུ་མིང་གི་རི་ཁྲོད་ཙམ་མ་ཡིན་པར་ཚེ་འདིའི་སྣང་བ་ཐམས་ཅད་ལ་ཞེན་པ་གཏིང་ནས་ལོག་སྟེ་འདོད་ཆུང་ཆོག་ཤེས་ཀྱི་སྒོ་ནས་ཉམས་ལེན་ལ་ཚུལ་བཞིན་དུ་བརྩོན་ཏེ་ཚེ་དང་སྒྲུབ་པ་མཉམ་པར་མཛད་པ་སྟེ།",
    "ཞེས་གསུངས་པ་ལྟར་དགེ་སྦྱོར་གྱི་གཞི་རྟེན་རང་གི་བློ་རིགས་ལ་རག་ལས་པས་ཐོག་མར་འདུན་པའི་འཕེན་པ་གཏོང་ཚུལ་དང་།",
    "ནངས་མོར་ལྡང་བའི་རྣལ་འབྱོར་གྱིས་ལངས་ཏེ་ཐུན་ལ་འཇུག་ནམ་ལངས་ནས་ཁྲུས་དང་།",
    "ཆབ་གཏོར་རྩིས་མགོ་བདུན་པ་དང་བདུད་རྩིའི་ཆུ་རྒྱུན་རེས་མོ་དང་།",
    "ལྷ་བསང་དང་དཀར་གསུམ་བསྡུས་པ་རེ་བཏང་།",
    "ཉིན་གུང་ཕུད་མཆོད་དང་ཟས་ཚོགས་རེས་མོས་གསོལ་ཚིགས་མཐར་ཕྱག་བརྒྱ་རེ་དང་།",
    "དགོང་མོར་སྲིད་རྒྱལ་དྲེད་ཞོན་དང་།",
    "ཨ་བསྲེའི་བསྐུལ་པ་སོགས་གསོལ་བསྡུས་རེ་དང་།",
    "ཁྱད་པར་དུ་ལྷག་པའི་ལྷ་དུ་མའི་ལྗགས་བསྙེན་དང་འབྲེལ་བར་རིག་པ་ཟང་ཐལ་གྱི་ཉམས་ལེན་བསྐྱང་བ་ཁོ་ན་རྩལ་དུ་བཏོན་ཏེ་སྐད་ཅིག་ཀྱང་གཡེལ་བ་མེད་པའི་སྒོ་ནས་དུས་འདའ་བར་མཛད་ཅིང་།",
    "དེ་སྐབས་ཕལ་ཆེ་བ་ནི་ཆེད་འཛིན་མ་བྱས་པས་མགུར་ཚར་རེ་བླངས་ནས་ཡི་གེར་མ་བྲིས་པར་ལུས་པ་མང་ཞིང་།",
    "སྐབས་འདི་དག་ཏུ་ལྟ་སྒོམ་གྱི་གྲོགས་སུ་སྤྱོད་པ་ལ་རྩལ་སྦྱོང་གཙོ་བོར་མཛད་ནས་ཉམས་ལེན་གནང་བར་མཛད་པའི་མཐར་བཟང་ངན་རེ་དོགས་ཀྱི་བྱ་བྱེད་ཐམས་ཅད་ཉམས་ལེན་གྱི་རྒྱན་དུ་ཤར་ཏེ་ཕྱོགས་ལས་རྣམ་རྒྱལ་གྱི་སྤྱོད་པའི་གདེངས་ཐོབ་པའི་རྣལ་འབྱོར་བའི་གོ་འཕང་མཐོན་པོར་ངང་གིས་འཛེགས་པ་ཡིན་མོད་ཀྱི།",
    "མི་ཚེ་ལ་ཚད་བཙུགས་ནས་ཉམས་ལེན་བཟོ་མེད་སྐྱོང་པའི་ཞེ་བཅད་ལྷག་སྡུག་སྲན་ལ་སྒྲུབ་ཚུགས་སུ་རེ་བའི་ཨོ་ཟོབ་མ་ཡིན་པར་རིག་པ་པར་འཁྲུངས།",
    "མཆིད་མོལ་དང་།",
    "དམར་མོ་མཛུབ་ཚུགས་ཀྱི་ཁྲིད་མཐར་ཆགས་སུ་གནང་།",
    "ཊཱཀྐི་མ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ་ཞིག་གིས་དུང་གི་རྒྱ་མདུད་གཅིག་བྱིན་བྱུང་བ་ཕྱག་ཏུ་བླངས་ནས་བཀྲོལ་ཞིང་མདུད་དེ་འཆང་བ་ཞིག་རྨི་ལམ་དུ་བྱུང་གསུངས།",
    "དམར་མོ་མཛུབ་ཚུགས།",
    "ཐུགས་གཉེར་དང་སྒོམ་སྒྲུབ་ཀྱི་འབྲས་བུ་བླ་བྲང་གི་ཆུས་གཞི་ཞེན་ཆགས་ཀྱིས་བློས་མ་ཐོང་ནས།",
    "གཡུང་དྲུང་གི་གླུ་སྙན་ཞིང་དོན་ཟབ་པ་ལེན་པ་སོགས་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "འོན་ཀྱང་ད་ལྟའི་གནས་སྐབས་སུ་གང་ཟག་ཟོལ་མ་མང་བས་དེ་སྐད་སྨྲས་ན་བསྟན་པའི་གཞུང་ལམ་ལ་ཕན་པ་ལས་གནོད་པའི་རྐྱེན་དུ་འགྱུར་སྲིད་པ་ལ་དགོངས་ནས་གཞན་ལ་སྨྲ་བར་མ་གནང་ཡང་དོན་ལ་སྟོན་པའི་གདུལ་བྱ་སྐལ་ལྡན་འགའ་ཞིག་གི་དོན་དུ་འགྱུར་བར་སྲིད་པས་ཟུར་ཙམ་ཞིག་སྨོས་པར་ཟད་དོ་ཞེས་ཤེས་པར་བྱའོ།",
    "ཡེ་བས་རེ་བ་བགྱིད་པའི་གནས་སྐབས་འདི་མཐོང་ན།",
    "ཁྲི་ག་ན་དག་ཀར་མགོན་ཁྱོད་བསྟན་འཛིན་མཆོག་ཏུ་ངེས་པ་རྙེད།",
    "དེ་མཚམས་སུ་སྦ་ཞབས་ཁོག་ནས་བྱུང་བའི་གྲྭ་སློབ་གསར་བ་འགའ་དང་སྟེང་ཆེན་བའི་གྲྭ་མང་ཙམ་ལ་ཨ་ཁྲིད་དང་དམར་མོ་མཛུབ་ཚུགས་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "གང་འདུལ་མོས་ངོར་ཤར་བའི་གཡུང་དྲུང་བོན།",
    "གངས་ཅན་ཁྲོད་འདིར་རིང་མོའི་དུས་ཉིད་ནས།",
    "ཁྱོད་གཅིག་བསྟན་པའི་གསོས་སུ་འགྱུར་མཐོང་ནས།",
    "གང་གི་གསང་བ་གསུམ་གྱི་དཔག་བསམ་ལྗོན།",
    "འོན་ཀྱང་ཁོད་སྤུངས་པདྨ་བློ་གྲོས་ཉིད་སྐུ་ཚེ་མཐར་མ་ཕྱིན་པར་མཚམས་མལ་དུ་བཞུགས་པའི་ཚེས་བཅུ་ཞིག་ལ་ཚོགས་མཆོད་མཛད་ནས་བྱ་རྒོད་ཅིག་བྱུང་ནས་ཚོགས་གཏོར་རྣམས་བཞེས་ཤིང་ཟླ་བ་གཅིག་ཏུ་ཉིན་རེ་བཞིན་བྱ་རྒོད་དེ་བྱུང་བའི་ཚེས་བཅུའི་ཉིན་ཚོགས་མཆོད་གནང་བཞིན་དུ་སྐུ་གཤེགས་སོ།",
    "ཉེར་ཞུགས་ལས་དང་སྐལ་བ་ཡང་རབ་ཉོན་མོངས་གཡུལ་ལས་རྣམ་རྒྱལ་གང་།",
    "ཕལ་བའི་གདུལ་བྱ་རེ་ཞིག་མ་སྐྱོང་སྒྲུབ་པ་མཛོད་དང་བསྟན་པ་ལ།",
    "ཕན་ངེས་རེ་ཟུང་ཁོ་བོས་སྟོན་ཚེ་ཁྱོད་ཀྱི་གདམས་པས་རྗེས་ཟུངས་དང་།",
    "ཞེས་བཀའ་ཐམ་གྱི་ཕྱག་རྒྱས་དམ་དུ་འཁྱུད་པ་ཞིག་འབྱོར་བྱུང་བས་དེ་སྐབས་སྔ་ཕྱིར་སྔོན་འགྲོ་ལ་ཁྲིད་ཡིག་དང་ཟིན་བྲིས་ཐོར་བུ་མང་དུ་བྲིས་ཡོད་པ་རྣམས་རེ་ཞིག་གཞན་ལ་མ་བསྟན་པར་སྦས་ཏེ་བཞག་པར་མཛད།",
    "སྙེམས་ཐག་གཅོད་པའི་གཅོད་ཀྱི་གདམས་པས་ཟུར་བརྒྱན་ནས་ཉམས་ལེན་རྒྱུ་རིང་བོར་གནང་བས་ལྟ་སྒོམ་གཉིས་པོ་གཅིག་གྲོགས་གཅིག་གིས་སོང་ནས་བདག་འཛིན་གྱི་རྩ་བ་བུད།",
    "མ་ལ་བདག་རྒྱུ་འདྲི་རྩད་ནས་གཅོད་པས་གཅོད་ཅེས་གྲགས་མོད་ཀྱི།",
    "བ་དེ་ནས་དགུང་ལོ་སོ་བདུན་ཤིང་ལུག་གི་ལོ་ལ་བབ་པའི་ཚེ་བཀྲམ་ཁྲོད་ནས་གཡུང་དྲུང་གི་མཆེད་པོ་དམ་པ་གཡུང་དྲུང་བསྟན་པ་ལགས་ནས་འོད་གསལ་བདུན་སྐོར་ལ་བཞུགས་དགོས་པས་ཁྲིད་ཀྱི་གསལ་འདེབས་ལ་བྱོན་དགོས་ཞེས་ལྡོག་མེད་ཀྱི་ནན་ཞུས་གནང་ངོར་དེར་ཕྱག་ཕེབས་ནས་མུན་ཁྲིད་ཀྱི་ཁྲིད་བཏབ་པས་ཞག་ཞེ་དགུའི་བར་གཞུང་དང་མཐུན་པའི་ཉམས་རྟོགས་རྣམས་བྱུང་སྟེ་ལེགས་ལམ་དུ་སོང་།",
    "དགུང་ལོ་སོ་བདུན་པ་འདི་ནས་བཟུང་དགུང་ལོ་བདུན་ཅུ་ལྷག་གི་བར་དུ་ལོ་རེ་བཞིན་སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པ་ལ་དགོངས་ནས་སྔོན་འགྲོ་རེ་མ་ཆགས་པར་གནང་བ་ཡིན་ཞེས་གསུང་ངོ།",
    "རྒྱ་གར་ནས་ཁྱོད་ཀྱི་གྲོགས་པོ་ཞིག་གིས་སྤུ་གྲི་དེ་ཟུངས་ལ་མགྱོགས་པར་ཤོག་ཟེར་བའི་ཕྲིན་བསྐུར་བ་ཡིན་ཟེར་བ་ཞིག་བྱུང་།",
    "སྤྱན་བར་སྣང་ལ་གཟིགས་ཏེ།",
    "ཅེས་གསུངས་པ་ལྟར་རེ་ཞིག་ནས་ཕྱི་ནང་གི་གཏུག་འདུལ་སོགས་རྣམ་གཡེང་ཅུང་ཟད་བྱུང་བས་རྐྱེན་བྱས་ནས།",
    "མཚམས་ཁང་གི་སྒོ་འདག་སྦྱར་བྱས་ནས་མཚམས་བཅད།",
    "མཚམས་ཁུང་ནས་མོ་ཕྱ་འདེབས་པ་དང་།",
    "མི་ཉན་པ་ལ་ཞལ་ཏ་བཅུག་པ་སོགས་རྣམ་གཡེང་གི་ཚོགས་ཐམས་ཅད་རྦད་ཀྱིས་བཅད་ནས་ཁྲིད་ཞུ་རྣམས་མ་གཏོགས་པའི་གཞན་དང་མཇལ་འཕྲད་ཀྱི་གཏུག་འདྲུལ་ཡང་གཏན་ནས་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "མཉམ་བཞག་གི་ཉམས་ལེན་སྐྱོང་རིམ་བཞིན་དུ་རྒྱུ་འབྲས་ཀྱི་བརྩི་འཇོག་དང་།",
    "མན་ཀ་ཐར་བའི་ལམ་དུ་རེ་བའི་གང་ཟག་ཕལ།",
    "དེ་ལྟར་ཡིན་ཡང་འགྲོ་བ་འདི་དག་ཐམས་ཅད་ཀྱིས་གནས་ལུགས་ཀྱི་དོན་དེ་ཇི་ལྟ་བ་བཞིན་མ་རྟོགས་ཏེ་རང་རང་གི་ཕུང་པོ་ཚོགས་ཙམ་གྱི་སྟེང་དུ་བཏགས་པའི་ང་ལ་བདག་ཏུ་ཞེན་པའི་འཛིན་རྟོག་དང་།",
    "༡༢སྣང་ཡང་བདེན་པས་སྟོང་བའི་གཟིགས་མོ་ཀུན།",
    "ཁྱོད་དང་སྐྱེ་བ་བློ་མངོན་སུམ་མ་འདྲེས་འཆར་བའི་ཡ་མཚན་མདངས།",
    "དགེ་སྦྱོང་ལྷུན་གྲུབ་ཐོགས་མེད་སོགས་གྲྭ་བཙུན་དང་དགེ་སེར་མ་སོགས་འདུས་པའི་ཚོགས་རྣམས་ལ་སོ་སོའི་འདོད་མོས་ཀྱི་འཆད་ཉན་གཙོ་བོར་བྱས་ནས།",
    "ལམ་རིམ་ཆེན་མོ་བཀའ་རྟེན་སུམ་བརྒྱ་བ།",
    "དེ་དག་གི་སྐབས་སུ་མཚན་མོར་འོད་གསལ་གྱི་སྣང་བས་ཕྱོགས་ཀུན་ཁྱབ་པའི་ནང་དུ་ཐིག་ལེ་སྐར་ཚོགས་བཀྲམ་པ་ལྟར་གསལ་བའི་དབུས་སུ་འཇའ་ཚོན་གྱིས་བྲིས་པ་ལྟ་བུའི་ལྷའི་སྐུ་མང་པོ་དང་།",
    "རྣམ་རྟོག་ཅི་སྐྱེས་རང་གྲོལ་དུ་སོང་བའི་མཚམས་ནས་དྭངས་གསལ་བརྗོད་དུ་མེད་པའི་ཀ་དག་གི་དགོངས་པ་འཁྲུལ་མི་ཤེས་པ་ལྟ་བུ་ལན་མང་དུ་འཆར་བ་བྱུང་།",
    "བཤམས་པ་ལ་ཡང་མཛུབ་མོ་བཙུགས་ནས་འདི་རྣམས་ལུང་ཟིན་གྱི་སྐྱེས་བུ་དགུ་ལ་འདྲེན་རྒྱུ་ཡིན་ཟེར་མཚམས་སུ་གཟིམས་ལས་སད་པ་ཞིག་བྱུང་གསུངས་ཏེ་དེ་ནི་ཕྱིས་ནས་བརྒྱུད་འཛིན་གྱི་སྐྱེས་བུ་ཁྱད་པར་ཅན་འབྱོན་པའི་ལྟས་ཡིན་པར་གསལ་ལོ།",
    "ད་ལྟའི་ཁྲིད་ཞུ་རྣམས་ཀྱིས་སྔོན་འགྲོའི་བསགས་སྦྱང་འབུམ་ཐེར་རེ་ཙམ་གྱི་གྲངས་ཐོན་ནས་ཕྱིན་ཆད་དེ་ལས་མི་དགོས་པར་སེམས་པ་ནི་བློ་ཆུང་གི་རྣམ་འགྱུར་ངོམ་པ་སྟེ།",
    "དེང་སང་གི་བླུན་སྒོམ་སྟོང་ལྟ་ལ་གཙིགས་སུ་འཛིན་པ་རྣམས་ཀྱིས་འདུས་བྱས་ཀྱི་བསགས་སྤྱང་ལ་མི་རེ་བ་སྐད་དང་།",
    "ཁན་ཨ་པ་ཇི་བཞིན་ཉམས་སུ་ལེན་ནུས་རེ་འགའ་ཙམ།",
    "ཀ་དགུང་གྲངས་ཞེ་གཅིག་པ་ས་ཕག་གི་ལོ་གསར་དུ་ཚེས་ནས།",
    "ལམ་རིམ་ཀུན་ལ་འོལ་ཚོད་དུ་མ་སོང་བའི་ཉམས་བཞེས་ཡུན་རིང་མཛད་པས་ནང་དུ་མྱོང་བ་ལེགས་པར་སྐྱེས་པའི་རྣལ་འབྱོར་པ་དོན་དང་ལྡན་པ་ཞིག་བཞུགས་པས་རི་ཁྲོད་འདུས་པ་ཀུན་ལ་བཀའ་ཕེབས་ནས།",
    "རིགས་དྲུག་རང་སྦྱོང་གི་ཁྲིད་བཅས་གསན།",
    "དེ་རྗེས་ནས་རྫོགས་ཆེན་ཡང་རྩེ་ཀློང་ཆེན་ལྟར་རིགས་དྲུག་རང་སྦྱོང་ཞེ་དགུ་བ་ཞིག་ཉམས་བཞེས་གནང་བས་རིགས་དྲུག་གི་འཆར་སྒོ་སྣ་ཚོགས་སུ་བྱུང་གསུང་ངོ།",
    "དམར་མོ་མཛུབ་ཚུགས་ཀྱི་ཟབ་ཁྲིད་རྣམས་རྒྱས་པར་གནང་བའི་བཀའ་དྲིན་སྩལ།",
    "རྗེ་ཉིད་ཀྱི་སྔོན་འགྲོ་བཀའ་ལུང་རྒྱ་མཚོ་དེ་སྤྱན་གཟིགས་སུ་ཕུལ་ནས་འདི་ལ་སྐྱོན་འདུག་མིན་གཟིགས་རྟོག་ཅིག་གནང་བར་ཞུ་ཞུས་པས།",
    "གཞན་ཡང་བདག་གི་རྨི་ལམ་དུ་ཡི་གེ་ཨ་དཀར་པོ་གཅིག་ལས་གཉིས་འཕྲོས།",
    "སུ་མངོན་ཞིང་བོན་དང་རྙིང་མའི་ལུགས་ཀྱི་ལྟ་བའི་གསུང་སྒྲོས་རྣམས་རྟོག་གེའི་ཚིག་གིས་མ་བཅོས་པའི་ལུགས་སུ་སྣང་གསུངས་ནས་བསྟོད་བསྔགས་མཛད།",
    "ཁྱད་པར་ཡང་རྩེ་ལྟར་རིགས་དྲུག་རང་སྦྱོང་གི་ཁྲིད་ཞེ་དགུ་ཞིག་དང་།",
    "གཞན་གྱིས་བསྔོ་རྟེན་དུ་ཕུལ་བའི་དངུལ་སོགས་ཕྲན་བུ་རེ་བྱུང་བ་རྣམས་ཀྱང་ཆུད་ཟོས་སུ་མ་གཏོང་བར་ཚོགས་དང་ཇོ་དར་མར་མེ་སོགས་ཚོགས་སུ་གང་འགྱུར་འཕྲལ་འཕྲལ་གཏོང་བར་མཛད།",
    "དེ་སྐབས་དངོས་རྫས་ཀྱི་འདུ་བ་ཆེན་པོ་མེད་མོད་ཀྱི།",
    "གནོན་པར་འགྱུར་བ་མཚན་ཉིད་ཡིན་བཞིན་ཕྱོགས་ཀྱི་སྐྱེ་དགུ་མཐའ་དག་གིས་གུས་པས་བཏུད་པའི་གནས་སུ་བྱེད་པས་སྐུ་གསུང་ཐུགས་ལ་གཞན་གྱིས་ལོག་པར་ལྟ་བ་ལྟ་ཞོག།",
    "ད་དུང་ཡང་གཞན་དོན་ལ་བསྙད་པའི་རྣམ་གཡེང་གི་འདུ་ལོང་བཏང་སྙོམས་སུ་མཛད་ནས་དབེན་པར་བྱ་བཏང་གི་བརྟུལ་ཞུགས་ཀྱི་ཉམས་ལེན་ལ་གཙོ་བོར་མཛད་པ་ནི།",
    "ཟང་ཟིང་ཐམས་ཅད་དུག་གི་ལོ་མ་ལྟར་ཤེས་པར་བྱས་ནས་ཆེན་པོའི་གོ་ས་དང་གི་ལོངས་སྤྱོད།",
    "ཡི་འཚོ་ཚོ་ཁོ་ན་དབྱིན་ང་ཚོ་ང་ཚོས་གཞན་མགོ་གདུགས་བཞིན་བསྐོར་བའི་རྨོངས་པའི་ཁྱུས།",
    "དེ་བས་ན་ཁོ་མཁནཁྱོད་ཉིད་ཁོ་ནས་སྒྲུབ་པའི་རྒྱལ་མཚན་བསྒྲེངས།",
    "ཁ་དུ་སོང་བས་སྔོན་བྱུང་དམ་པའི་མཛད་པ་ཉམས་ལེན་དུ།",
    "འདུས་སྒར་ཀུན་ནས་སྤོས་དང་རོལ་མོས་མདུན་བསུས་ཤིང་བཞུགས་འཇག་གྲུབ་ནས།",
    "དེ་རྗེས་གཏེར་ཆེན་ཡབ་ཡུམ་གཙོས་དཔོན་སློབ་དུ་མས་སྒོམ་རིམ་ཐར་ལམ་མྱུར་བགྲོད་ལ་བརྟེན་ནས་བསགས་སྦྱང་གིཕྱག་ལེན་ཡང་གསར་དུ་འདེབས་པར་གནང་།",
    "བདུན་ཚིགས་ཕོ་སྦྱངས་མོ་སྦྱངས་ཀྱི་ལུང་རྣམས་གསན་པར་གནང་།",
    "དམིགས་ཁྲིད་སྒོམ་བཟླ་ཟུང་འཇུག་གི་ཕྱག་ལེན་བཅས་གནང་བར་མཛད།",
    "ཟླ་བ་གཅིག་གི་ནང་དུ་པོ་ཏི་ལྔར་ལོངས་བ་གྲུབ་པ་དང་།",
    "ནུབ་མོ་མུན་པ་འལ་འོལ་ལའང་ཐོགས་མེད་དུ་འབྲི་བ་སོགས་ལ་བརྟེན་ནས་གཏེར་སྟོན་འཁྲུལ་མེད་དུ་ངེས་ཤེས་ཐོབ་ཅིང་ཀུན་ཀྱིས་ཡ་མཚན་དུ་གླེང་བའང་བྱུང་ངོ།",
    "གཏེར་ཡིག་གི་དོན་ཡིད་ལ་འཆར་བའི་ཐོག་ཚིག་རྣམས་ངག་ནས་རང་རྡོལ་དུ་འོང་བ་དང་།",
    "སྔ་རབས་ཀྱི་གཏེར་དཔེ་ཕལ་ཆེ་བ་ནི་བོད་ཡིག་གི་གཟུགས་སུ་མཆིས་པས་གཏེར་སྟོན་དུ་མ་ཟད་གཞན་གྱིས་དཔེ་ཞུ་རུང་བའང་ཡོད་པར་མཆིས།",
    "གི་གཏེར་ཡིག་རྡོལ་བ་དང་།",
    "རིག་འཛིན་མཁའ་འགྲོའི་ལུང་གིས་བསྒྲགས་པའི་མཐུས།",
    "རྫ་སྟོད་ནས་རྗེ་ཁྲོ་ཚང་གི་མཆོག་སྤྲུལ་གཡུང་དྲུང་མཐོང་གྲོལ།",
    "བྲག་ཟང་ཐལ་ལ་སོགས་ནས་ཟབ་གཏེར་བརྙེས།",
    "ཕྱིར་ཉིན་གནས་སྲུང་ལྷ་མོའི་དྲེལ་རྗེས་དང་དྲེད་མོང་རྗེས་རྣམས་མཇལ་ཞིང་ངོ་སྤྲོད་མཛད།",
    "དད་འདུས་ཀྱི་ཡུལ་མི་ཀུན་ལ་རི་ཀླུང་གི་རྒྱ་དང་།",
    "གང་ལ་གང་འདུལ་མོས་ངོ་དང་འཚམས་པའི།་",
    "རོ་གཅིག་གཟིགས་པའི་ངང་ཚུལ་ཐོབ་མིན་ནམ།",
    "ཅེས་ལྷ་རེག་དྲི་མེད་ཀྱིས་བཀླུབས་ཏེ་ཕྱག་ཏུ་གནང་ནས།",
    "དེའི་ཐབས་སུ་གསུང་རྣམས་པར་དུ་འཁོད་པ་ཞིག་བྱུང་ན་ཕྱི་མོ་གཅིག་ལས་དུ་མར་འཕེལ་བས་ཤིན་ཏུ་གལ་ཆེ་ཞིང་།",
    "རིམ་གྱིས་ཐུགས་ལ་རེ་བ་མཛོད་དང་འགྲུབ་ངེས་པའི་ལྟས་མཐོང་བ་ཡིན་ཞེས་པའི་བཀའ་བསྩལ་ཏོ།",
    "ལུང་གི་གྲས་ལ།",
    "དེ་དག་གི་སྐབས་ཀུན་ཏུ་ཡང་ཐུགས་དམ་རིགས་ཆགས་མེད་དང་བྱ་ཆའི་དགེ་སྤྱོད་རིགས་རྒྱས་བསྡུས་གང་འགྲུབ་བཅས་ཐུགས་དམ་གྱི་ཉམས་ལེན་ཆུ་བོའི་རྒྱུན་བཞིན་སྐྱོང་བའི་སྒོ་ནས་སྒྲུབ་ཚུགས་ཀྱི་བཅད་རྒྱ་ཡང་མ་གཡེལ་བར་བཞུགས་ཤིང་གུ་ཡང་སོ་གསོད་སྙོམས་ཆུང་ཁོ་ནས་དུས་འདའ་བ་ནི་སྨོས་མ་དགོས་སོ།",
    "ཟམ་ཁ་ཚུན་ཆད་ལ་གནོད་པ་མ་བྱུང་བ་དེ་དག་གི་ལྟས་ཡིན་པར་མངོན་ནོ་གསུངས།",
    "བརྡ་ཡིག་ཕྲེང་མང་པོ་ཡོད་པ་ཞིག་ལ་བརྡ་ཡིག་རེ་རེ་བཞིན་ཐིག་ལེ་རེ་དང་།",
    "ཁ་བྱང་རེ་དང་།",
    "ཨང་ཀུ་རེ་ཤར་བ་ཞིག་འདུག་པ་བྱུང་ཞེས་གསུངས་ཏེ།",
    "དེ་དག་གི་དོན་ཐུགས་སྒམ་ཞིང་ཡོད་ཏན་གསང་བ་ལ་བརྩོན་པས་འདི་ཡིན་དངོས་སུ་མི་གསུངས་མོད་ཀྱི།",
    "དུས་དང་ཡུལ་གྱིས་སྟབས་ཀྱིས་མང་པོའི་དཔུང་ཤེད་དང་ངར་འཛིན་གྱི་ཆེ་གནོན་ཁོ་ནས་ཆགས་སྡང་ལ་སོ་ནམ་བྱེད་པ་འགའ་ཞིག་གི་ངན་གཡོ་ལ་བརྟེན་ནས་སྟེང་ཆེན་བ་དང་།",
    "དགོན་གསར་བ་གོང་འོག་གཉིས་འཁྲུགས་ལང་གི་གཞི་བསླངས་ཏེ།",
    "མཁས་པ་རང་གིས་དཔྱོད་ཤེས་ཀྱིས།",
    "མཆོད་རྟེན་བཅས་ཐོགས་རྩེགས་ལྷག་གིས་གཙོས་ལྷ་ཁང་ཉི་ཤུ་ཙམ།",
    "འགའ་ཞིག་གིས་ལྷམ་ཚང་དང་རྟའི་སྟན་བྱེད་པ་སོགས་བློར་མི་ཤོང་བའི་ལས་མང་པོ་བྱས།",
    "མགར་བ་རང་གི་རལ་གྲིས་བསད་པ་བཞིན།",
    "ཁྱོད་ཁོ་ན་བདེ་འགན་ན་བ་དང་བསྲེག་པར་བྱས་སོ་མདག་མེ་འབར་བ་ཡིས།",
    "ཚེ་འདིའི་བྱེད་སྤྱོད་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྒྱུ་འབའ་ཞིག་ཏུ་ངོ་སྤྲོད་པའི་རང་བྱུང་གི་སློབ་དཔོན་དུ་འཆར་བ་ལས་ཁོ་བོ་སེམས་ཁྲལ་ཞེ་ནས་མི་འོང་བ་ཞིག་ཡིན་ཡང་།",
    "ལམ་བར་དེར་སྔོན་མི་སྐྱ་གཉིས་ཀྱིས་བུད་མེད་ཅིག་གི་ལུས་རྒྱན་ཕྲོགས་ནས་བསད་པའི་ངུ་འབོད་བྱེད་པའི་སྣང་བ་དང་།",
    "རྗེའི་དགོངས་པར་རེ་ཞིག་ངེད་རང་གི་རི་ཁྲོད་དེས་དབེན་མོད་ཀྱི་འདི་ལྟ་བུའི་རྐྱེན་གྱིས་རྣམ་རྟོག་གིས་དབེན་པ་ཞིག་མི་འོང་བས་རང་ཡུལ་དུ་སོ་གསོད་པ་ཞིག་འོང་བར་དཀའ།",
    "སྡོམ་པ་དང་དམ་ཚིག་ལ་མི་བརྩི་ཞིང་གལ་ལ་ཐུག་ན་ཚེ་འདིའི་ཆེ་དུ་ཕྱི་མ་རྒྱབ་ཏུ་བསྒྱུར་བ་ལ་བློ་ཐེ་ཚོམ་ཙམ་ཡང་མི་འདུག་པ་འདི་ལྟ་བུ་བསམ་ན་སེམས་སྐྱོ་པ་ལ་སངས་དུས་ཙམ་མི་འདུག་པས་ཁོ་བོ་རྒྱལ་ཁམས་ཕྱོགས་མེད་ཅིག་བྱས་ན་ལེགས་སྙམ་པ་ཡིན་མོད།",
    "ཁྱེད་རྣམ་པའི་ཐུགས་འདོད་ལྟར་རེ་ཞིག་ཉག་རོང་དུ་ཕྱིན་ཡང་མི་ཆོག་པ་མེད།",
    "དགོང་མོར་གཟིམས་ལམ་དང་ཉམས་སྣང་འདྲེས་མ་ལྟ་བུར།",
    "བདག་གིས་མགོན་སྐྱབས་བྱེད་པར་ཤོག།",
    "ལྟར་བྲུའི་ཨ་ཁྲིད་ཆེན་མོའི་གཞུང་དང་རྒྱབ་སྐྱོར་སྦྲགས་ནས་སྔོན་འགྲོའི་སྐབས་སུ་བཀའ་ལུང་རྒྱ་མཚོ་ལྟར་རྒྱས་པར་གནང་ཞིང་སྔོན་འགྲོ་ཟིན་ནས་ཁྲིད་རྐང་རེ་རེ་བཞིན་ཐུན་བཞིའི་ཉམས་ལེན་གྱི་སྒོམ་རིམ་གནང་།",
    "ཡིད་ལ་ངེས་ནས་བསྒོམ་བཟླ་ཟུང་འཇུག་གི་སྒོ་ནས་བསགས་སྦྱང་གི་ཉམས་ལེན་འབུམ་ཐེར་རེའི་གྲངས་ཐོན་བསོགས་བཅོལ་མཐར།",
    "དགུང་གྲངས་ཞེ་དྲུག་པ་ཤིང་འབྲུག་གི་ལོ་གསར་ཚེས་ནས།",
    "གཙུག་ལག་ཁང་དུ་བཀུར་བཟོ་ཆེ་བའི་ལུགས་ཀྱི་ཁྲི་ལ་ཞབས་བཀོད་དེ་བཞེས་སྤྲོ་དང་འཕྲོས་མོལ་བཅས་ཁྲིད་ཀྱི་སྟ་གོན་ལ་ཞུགས།",
    "གཞན་ཡང་སོ་སོའི་རེ་འདོད་ཅི་དགོས་པ་རྗེས་སུ་སྐོང་བར་གནང་།",
    "དགོན་གཞུང་ནས་འབུལ་ཚོགས་རྒྱ་ཆེན་པོའི་བསྙེན་བཀུར་དང་ཁྲིད་ཞུ་སོ་སོ་ནས་གཏོང་རག་གི་མཎྜལ་ཅི་འབྱོར་འབུལ་ཞིང་བརྩེ་བས་བཞེས་པར་ཡང་གནང་ངོ།",
    "དེའི་ཚེ་དཔོན་སློབ་གཙོ་འདུས་ཀྱིས་བཀའ་བགྲོས་ཐོག་རྒྱ་ར་གཤིས་ལྡིང་དཔོན་ཨ་མགོན་དང་ཆུ་སྒོ་བཀྲ་ནོར་གཉིས་ལ་ཞུ་སྣ་བར་སྤྲན་ནས་རང་དགོན་སྟེང་ཆེན་རྣམ་རྒྱལ་གླིང་ཞིག་འཐོར་གྱི་དབྲ་སྟོན་པཎྜི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "དེ་ནས་དབལ་ཁྱུང་གི་གདན་ས་ནས་གཏེར་ཆེན་ཡབ་ཡུམ་གྱི་སྔར་ནས་སྙན་བསྐུལ་ཞུས་བཞིན་ཡེ་ཤེས་དགོན་ནས་ཕེབས་སྐྱེལ་བཀུར་བཟོ་དང་བཅས་དབལ་ཁྱུང་བླ་བྲང་དུ་ཞབས་བཏེགས།",
    "ཕྱག་རྫོགས་དབུ་གསུམ་གྱི་ལྟ་བའི་ཁོག་དབུབ་རེ་དང་།",
    "འགའ་ཞིག་འཇིག་རྟེན་གི་ཆགས་སྡང་དུ་འདུག།",
    "ཡང་གཅིག་ན་རེ།",
    "ཅེས་པ་སོགས་གསང་སྦས་མེད་པའི་གླེང་མོ་དྲང་ཐ་ལེ་བ་བྱེད་པར་འདུག་པས་བློ་སྦྱོང་ཉམས་སུ་ལེན་མཁན་ཡིན་ན་འདི་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "བས་ཏུ་དེ་༧ཀ་བ་གངས་ཅན་འདིར་ཡང་རིང་མོའི་དུས་ནས་བྱུང་།",
    "མ་ག་བ་ད་པ་མི་རི་བོང་ཅལ་སྒྲའི་རྗེས་སུ་རྒྱུག་གིས་དོགས།",
    "བྲག་གཡབ་དགོན་རྣམས་ནས་བླ་སྤྲུལ་གྲྭ་བཙུན་ལྔ་བཅུ་ལྷག་འཆད་ཉན་དང་ཁྲིད་ཞུ་བར་འདུས་པས་དེ་དག་ཀུན་ཀྱིས་ཀྱང་བསམ་གཏན་གྱི་ཁང་ཆུང་དང་བྲག་གསེབ་དང་ལྗོན་ཤིང་གི་ལྡིང་ཁང་སོགས་ལ་བརྟེན་ནས་འདུག་པར་གནང་།",
    "ཕར་རྩོལ་བ་རྐྱང་པས་དོན་དུ་འགྱུར་བ་དཀའ་བས་དུས་ལ་མ་བབས་པའི་འགྲོ་དོན་འདི་ལ་དགོས་པ་ཅི་ཡང་མི་སྣང་མོད།",
    "རང་གི་ཚེ་གཅིག་དགེ་ལ་སྤྱོད་པ་བས།",
    "རང་གི་སེམས་བསྐྱེད་མ་ཉམས་ན་རང་དོན་གྱི་དགེ་སྦྱོར་ལ་འབད་ཀྱང་གཞན་དོན་དུ་འགྱུར་ལ།",
    "གཞན་དོན་ལ་འབད་ཀྱང་རང་གི་ཉམས་ལེན་ལ་མ་གནོད་ན་རང་དོན་གྱི་དགེ་སྦྱོར་ཡང་འོང་བས་དོན་གཉིས་ཟུང་འབྲེལ་དུ་འགྱུར་བ་ལས་མ་མཆིས་པས།",
    "ད་དུང་ཡང་འཆད་ཉན་དང་ཟབ་ཁྲིད་ཅི་རིགས་རེ་བྱེད་དགོས་པར་འདུག་ན་ཡང་།",
    "ད་ནི་དཀོར་དང་འཁོར་གྱི་འདུ་བ་ལ་བརྟེན་ནས་རྣམ་གཡེང་ཇེ་ཆེར་འགྲོ་བར་སྣང་བས་དགེ་སྦྱོར་ལ་ཁྲིགས་སུ་ཚུད་པ་ཞིག་བྱུང་ན་རང་གི་ཡི་དམ་ལའང་ཕན་པ་དང་།",
    "ཐོག་མར་ཐོ་རངས་སྐྱ་རེངས་དང་པོའི་གོང་ཙམ་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "ཐོག་མར་ཀུན་བཟང་གཤེན་ལྷའི་བདག་བསྐྱེད་ཡེ་གཤེན་ཆེན་པོའི་ལུགས་བཞིན་སྐད་ཅིག་གིས་གསལ་བཏབ་ནས།",
    "ཀུན་བཟང་གི་བསྙེན་པ་ས་ལེ་འོད་བརྒྱ་སྐོར་གཅིག།",
    "ངན་སོང་དོང་སྤྲུག་སྒྲིབ་སྦྱོང་མ་ཏྲི།",
    "ཆབ་གཏོར་རྩིས་མགོ་བདུན་པ་དང་བདུད་རྩི་ཆུ་རྒྱུན་ཡན་ལག་དང་བཅས་པ་རེ་མོས་ཀྱིས་གནང་ཞིང་།",
    "ཆབ་གཏོར་གྱི་སྣོད་དང་རྫས་ཉེར་ལྔའི་གཏོར་རིམ་ཚད་ལྡན་གལ་ཆུང་དུ་མ་སོང་བའི་གཙང་སྦྲ་བཅས་ཆགས་མེད་མཛད།",
    "ཉིན་གུང་ཕུད་གཏོར་དང་ཟས་ཚོགས་གཉིས་རེས་མོས་ཀྱི་ཚུལ་དུ་གསོལ་ཚིགས་གནང་མཐར་ཆང་བུ་བསྔོ་བ་རྣམས་རྒྱུན་དུ་གནང་།",
    "སྔ་དྲོ་དང་ཕྱི་དྲོའི་ཐུན་གསེང་གཉིས་ལ་ཡི་གེའི་ཕྱག་བྲིས་ཡོད་ཚེ་ཅི་རིགས་རེ་འབྲི་བར་གནང་།",
    "དགོང་མོའི་ཆར་དམར་གཏོར་རྫས་ལྡན་བཅས་བོན་སྐྱོང་གི་རྒྱུན་གཏོར་འབུལ་བ་དང་ཕྱིར་ཟློག་གི་རིགས་ཅི་རིགས་རེ་གནང་།",
    "ནུབ་མོར་དམར་གསུར་དང་།",
    "སྟག་ལྷའི་བསྐྱེད་བཟླས་ཅི་རིགས་རེ་གནང་ནས་ཉམས་ལེན་གྱི་ཏིང་འཛིན་ཐུན་རེ་བཞུགས།",
    "ཐུན་མཐར་བསྔོ་སྨོན་རྒྱས་པ་རེ་དང་འབྲེལ་ཐོགས་རྣམས་ལ་དམིགས་བསལ་གྱི་བསྔོ་བྱང་རེ་ཐུགས་བཞེས་གནང་།",
    "འདུས་པའི་ཚོགས་སུ་དམིགས་བསལ་མ་གཏོགས་རྔ་བརྡུང་སོགས་མང་པོ་བྱེད་པ་དགེ་སྦྱོར་ཉམས་ལེན་པའི་མཚང་ཡིན་གསུངས་ནས་རྒྱུན་དུ་གྲྭ་ས་གོང་འོག་གི་ཕྱག་ལེན་དང་མཐུན་པར་སྣང་ངོ།",
    "རྗེ་ཉིད་ནས་ཐུན་དང་ཐུན་མཚམས་གཉིས་ཕྱེ་ནས་མཚན་བཅས་དང་མཚན་མེད་ཀྱི་རྣལ་འབྱོར་སོ་སོར་གནང་བ་ལྟར་མཛད་ཀྱང་དོན་དུ་ཕྱག་བསྐོར་ཁ་ཏོན་སོགས་ཅི་མཛད་ཀྱང་རིགས་ངོ་སྐྱོང་བ་ལ་མི་གནོད་པར་མ་ཟད་ཉམས་ལེན་རྐྱེན་དང་འདྲེས་པས་སྤྱོད་པ་ལམ་སློང་གི་བོགས་འདོན་དུ་འགྱུར་བ་ལས་མེད་པ་དང་།",
    "དཔོན་བརྒྱུད་དང་སྐྱེ་སྤྲུལ་གྱིས་གོ་སར་གནས་པ་ཕལ་ཆེ་བས་དེ་ཙམ་གྱི་དགོས་པ་རྗེས་སུ་བསྐྱབ་པའི་སླད་དུ་བོན་ལ་ཡིད་རྟོན་ཡང་དོན་དུ་རང་རིགས་དང་བཞུགས་ཁྲི་ནོར་བ་ཙམ་གྱི་རེ་བ་བྱུང་ན་དབྲ་སྟོན་པཎྜི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "ཀྱི་རྒྱུག་རྒྱལ་བསྟན་པད་ཚལ་བཞད་པའི་ཉིན་མོར་བྱེད།",
    "རྗེ་དཔོན་སློབ་ཐུན་མོང་ནས་སྤྱི་སྤུངས་ཞི་ཁྲོའི་ཆོ་ག་ལ་བརྟེན་ནས་ཚོགས་མཆོད་རྒྱས་པ་དང་འབྲེལ་བར་སྐོང་བཤགས་མཎྜལ་གང་མང་དང་ཡིག་བརྒྱ་འབུམ་ཕྲག་དུ་མའི་དམ་བཅའ་དང་བཅས་རྩ་གསུམ་གྱི་ཤོག་སེར་བརྡ་བསྒྱུར་འབེབས་པར་བསྐུལ་བས།",
    "གཏེར་གཞུང་གི་རྩ་ཚིག་ལ་ཇི་ལྟར་གནས་པའི་དགོངས་པ་བཞིན་དུ་རྩ་ཁྲིད་དམིགས་རྐང་འདྲིལ་བ་རེ་གནང་ཞིང་བཀའ་གཏད་བརྒྱུད་རིམ་དང་བཅས་པ་མཐར་ཆགས་སུ་བསྩལ་ཏོ།",
    "དགོས་པ་རྣམས་རང་གིས་བསྒྲུབ་པ་ཡིན་ཞེས་པའི་ཞུ་བ་སྔ་ཕྱི་དུ་མར་ནན་ཏན་དང་།",
    "དེ་ལྟར་དུས་བབ་མཁའ་འགྲོའི་ལུང་གིས་བསྐུལ་མ་ལས་བྱུང་བ་ཡིན་པས་ཁྲིད་ཀྱི་སྐོར་སོགས་རྒྱས་པར་བྱུང་ན་ལེགས་པའི་བཀའ་གནང་དང་གཟེངས་བསྟོད་ཀྱང་མཛད།",
    "ཐོད་རྒལ་སྣང་བའི་ལྟད་མོ།",
    "དེ་ནས་སླར་ཡང་གཏུམ་མོ་དང་ཐབས་ལམ་སོགས་ཀྱང་རྒྱས་པར་གནང་ནས་སྤེལ་བ་སྟེ།",
    "སྐབས་དང་མ་ཞུ་ལ་གོཨ་ལོ་ཚུ་ག་བ་ང་ཚོར་སྟེ་ག་ད་བ་ས་ཉེ་བརྒྱུད་མཁའ་འགྲོའི་ཞལ་རླངས་མ་ཡལ་བའི།་",
    "ས་ལ་མི་གྱི་སྐལ་ལྡན་ངང་མོ་འདུ་བའི་གནས་སུ་གྱུར།",
    "བཀའ་འབྲེལ་ཅི་དགོས་སོགས་ཀྱིས་རེ་འདོད་རྗེས་སུ་སྐོང་བར་མཛད།",
    "སྐྱོབ་འབྱིན་དྲེགས་པ་སེང་ནག་གསུམ་ནི་སྔོན་རབས་ཕྱྭ་རྗེ་ཡབ་བླ་བདལ་དྲུག་གི་རྒྱུད་ལས་གྲོལ་བའི་གཞི་བདག་ཏུ་འདུག་པས།",
    "མེ་ཉག་ལྕེ་ཚ་མཁར་བུ་དང་ཁོད་སྤུངས་བློ་གྲོས་ཐོགས་མེད་སོགས་རིག་འཛིན་དང་གྲུབ་ཆེན་གོང་མའི་བཀའ་སྡོད་དུ་གནས་པ་ཁོ་ན་ཡིན་པས་ཉག་ཡུལ་འདིར་ལུགས་གཉིས་གང་གི་ཐད་ནས་མགོ་ཐོན་པ་ཙམ་ཡོད་པ་འདི་ཞིང་སྐྱོང་མཐུ་བོ་ཆེ་འདི་དག་གི་མཐུ་ལས་བྱུང་བར་གྲགས།",
    "ཉམས་སྣང་དུ་རི་དེ་ཉིད་ལྷའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པ་ལྟ་བུ་དང་ཡུལ་ལྷ་མི་ནག་མདུང་དར་ཐོགས་པ་ཅན་ཞིག་གིས་གུས་པ་འབུལ་བ་ཞིག་བྱུང་བས།",
    "དེ་ནས་ཁོད་སྤུངས་གསང་མཆོག་གི་གདུང་རྒྱུད་མི་ནུབ་བླ་བྲང་དང་མི་ནུབ་དགོན་གྱི་བླ་གྲྭ་ཀུན་ནས་དད་པས་གདན་འདྲེན་ཞུས་པ་བཞིན་ཞབས་བཏེགས་པར་གནང་ནས།",
    "འདོད་མོས་བཞིན་ཀུན་ལ་ཅི་དགོས་པའི་རེ་བ་བསྐངས་ནས་འབྲེལ་ཚད་དོན་ལྡན་དུ་འགྱུར་བའི་སྨོན་འདུན་བཅས་གནང་བར་མཛད།",
    "སྐབས་དེར་ཞིང་སྐྱོང་སྐྱོབ་འབྱིན་སེང་ནག་གི་འཁོར་དུ་གཏོགས་པའི་གཞི་བདག་འགར་དམར་མཆོད་དགོས་པའི་སྲོལ་ངན་བྱེད་པའི་ཡུལ་མི་འགའ་རེ་ཡོད་པ་ལ་སྡིག་རྒྱུན་གཅོད་པའི་ཁས་ལེན་བསྒག།",
    "དེར་ཡུལ་མི་འགའ་ཞིག་གིས་སྡིག་རྒྱུན་གཅོད་པ་ལ་ཕྱིན་ཆད་འཁུ་ལྡོག་མི་འོང་བའི་ལྷ་འདྲེའི་བཀའ་ཡིག་ཅིག་དགོས་ཞེས་ཞུས་པའི་ངོར།",
    "ལྷ་འདྲེ་ལ་བཀའི་དམ་བཞག་གི་ལུང་བྱོན་པའང་འདི་ལྟར།",
    "རང་གི་ལུས་ལ་དཔེ་ལོངས་ལ།",
    "བོན་ཉིད་ཟབ་མོའི་བདེན་མཐུ་དང་།",
    "སླར་ཡང་དངོས་གཞིའི་སྐོར་རིམ་པར་ཐུགས་རྗེས་འཛིན་པར་བསྐུལ་བཞིན་དགྱེས་པའི་གསུང་གི་ཞལ་བཞེས་ཀྱང་མཛད།",
    "དེ་ལ་ཚེ་གནོན་གྱི་ཕྲག་དོག་གིས་གནས་གཞི་བཤིག་ཚུལ།",
    "ད་དགོས་བོན་དང་གཙུག་ལག་སྒོ་བཞིའི་བསྟན་པ་འདི་དང་པོ་ནས་གཅིག་གྲོགས་གཅིག་གིས་བྱས་ཏེ་ཆགས་ཤིང་།",
    "འབྱུང་འགྱུར་གྱི་གནས་གསལ་བར་སྟོན་པའི་ལུང་གི་ཆེ་བ་ཡིན་པར་ངེས་པར་བྱའོ།",
    "ང་ཡུལ་དང་དགུང་གྲངས་ཞེ་བརྒྱད་བཞེས་པའི་མེ་རྟ་ལོ་ལ་དཔལ་ལྡན་ཡེ་ཤེས་དགོན་གྱི་བླ་ཁག་དང་འདུས་པ་ཐུན་མོང་ནས་གསོལ་བ་བཏབ་པའི་ངོར་དེར་ཕེབས་པའི་ཞལ་བཞེས་གནང་ནས།"
  ]
}