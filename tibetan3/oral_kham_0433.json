    "ཨ་རིའི་ནེའུ་ཡོག་དུས་བབས་ཐོག་སྩལ་བའི་བཀའ་རྩོམ།",
    "རང་རང་སོ་སོའི་རྒྱུད་སྟེང་དུ་བཀལ་ནས་ཉམས་ལེན་བྱེད་དགོས་པའི་སྐོར་དང་།",
    "ཉི་ཧོང་དུ་ཡུན་རིང་གནས་པའི་སྟབས་ཀྱིས་ཉི་བོད་མི་མང་གཉིས་དབར་གྱི་ཕན་ཚུན་གོ་རྟོགས་དང་འབྲེལ་བ་དམ་ཟབ་ཏུ་གནས་ཐུབ་པ་བྱུང་འདུག་ཅིང་།",
    "རང་རང་སོ་སོས་ལས་བསགས་པའི་འབྲས་བུ་ཟློག་ཏུ་མེད་པ་ཡིན་ཙང་།",
    "ཝར་ཎ་དང་བོད་མིའི་གཞིས་སྒར་དུ་ཆིབས་བསྒྱུར་དང་ནེའུ་ཡོག་དུས་བབས་ཐོག་སྩལ་བའི་བཀའ་རྩོམ།",
    "༡༩༣ ལོར་རྒྱ་དམར་བཅིངས་གྲོལ་དམག་མི་དང་འབྲེལ་བ་བྱས་འདུག་ཀྱང་།",
    "ཨ་རིའི་ནེའུ་ཡོག་དུས་བབས་ཐོག་སྩལ་བའི་བཀའ་རྩོམ།",
    "ཕྲན་གྱིས་ཤེས་རྟོགས་བྱུང་བར་པེ་ཅིན་ནང་བཞིན་ལྷ་ས་ལ་ཡང་སྦྱར་ཡིག་ཁག་སྦྱར་ཡོད་བཟོ་འདུག་ཅེས་ཞུས་པར།",
    "དེའི་ཐོག་དུས་རབས་ཁ་ཤས་སྔོན་ནས་ཁོ་ཚོར་ཁེ་ནུས་ཕྲན་ཙམ་བྱུང་ཡོད་སྲིད།",
    "བོད་མི་བཙན་བྱོལ་བའི་ནང་ནས་ཀྱང་རང་ཉིད་ཕྱིར་སྡོད་རྒྱ་མིའི་མི་ཞེས་པའི་འགྲེལ་བརྗོད་དགོས་པ་དེ་མ་ཚོར་བར་འགྲོ་བསྐྱོད་བྱེད་མཁན་ཡང་ཡོད།",
    "ངེས་པར་དུ་བསམ་བློ་གཏོང་དགོས་ཀྱི་འདུག་ཅེས་དང་།",
    "གནས་ཚུལ་ཧ་ཅང་ཛ་དྲག་ཅན་ཞིག་ཏུ་གྱུར་འདུགདེས་ན།",
    "འོན་ཀྱང་རང་གཅེས་པར་འཛིན་པ་དེ་དག་སྤང་རྒྱུ་ཁག་པོ་ཡིན་ཡང་།",
    "སྤྱིར་ཨ་རིའི་མི་རྣམས་ཁ་གསང་ཐད་ཀར་གསུང་མཁན་ཞེ་དྲག་ཡག་པོ་འདུག་ད་དུང་ངོས་རང་ཤར་ནས་ནུབ་བར་དང་།",
    "ཉེ་ཆར་ཟླ་བ་ཁ་ཤས་ནང་རྒྱ་མིའི་འགོ་ཁྲིད་ཚོས་ཕྲན་བུ་སྤྱི་སྙོམས་ཀྱི་སྲིད་བྱུས་ལག་ལེན་བསྟར་ཡོད་པར་མངོན་གྱི་འདུག་ཅེས་སྩལ།",
    "བོད་ནས་གསར་འབྱོར་བ་རྣམས་ཀྱིས་བརྗོད་གསལ་ལྟར་ན་དེ་འདྲའི་གནས་སྟངས་ཡོད་ཚུལ་མི་འདུག་ཅེས་སོགས་སྩལ།",
    "འབྲུག་ཏུ་གནས་སྡོད་བོད་མི་སྐྱབས་བཅོལ་བ་རྣམས་ཕྱིའི་རྒྱལ་ཁབ་ཁག་ནས་སྐྱབས་བཅོལ་དུ་ལེན་མཁན་མ་བྱུང་ཚེ་བོད་དུ་ཕྱིར་སྐྲོད་གཏོང་རྒྱུའི་ཐག་གཅོད་ཟིན་འདུག་པར་སྐུ་ཉིད་ནས་ཐབས་ཤེས་ཕན་གྲོགས་ཤིག་གནང་ཐབས་གྱུར་ཚེ།",
    "བོད་མི་དེ་རྣམས་མགྱོགས་མྱུར་བོད་དུ་ཕྱིར་སྐྲོད་གཏོང་རྒྱུ་ཐག་གཅོད་ཟིན་འདུག་པར།",
    "ངོས་རང་ད་ལྟའི་བཙན་བྱོལ་གྱི་གནས་སྟངས་འདིའི་ཐོག་དུས་ཡུན་རིང་པོ་ཞིག་གནས་མི་དགོས་པ་ཡོང་རྒྱུར་ཚོད་དཔག་ཀྱང་བྱེད་ཀྱི་ཡོད།",
    "གཞན་ཡང་རང་རང་སོ་སོར་གང་འཚམ་པ་ཡོད་ནའང་དེ་དམིགས་རྟེན་དུ་བཟུང་ན་འགྲིགས།",
    "དེ་དང་ལྷན་ཅིག་ཏུ་ཟུར་གཅིག་ནས་བལྟ་བ་ལྟ་བུར་ཡུལ་དེ་ཉིད་གསལ་པོ་དང་བརྟན་པོ་འདུག་མིན་བརྟག་དཔྱད་བྱེད་དགོས།",
    "སེམས་དང་ལུས་གཉིས་ལ་སྦྱར་ན་དེ་འདྲའི་ང་དེ་གང་དུ་འདུག་གམ།",
    "གནས་ཚུལ་ལ་དཔྱད་པ་ན་ང་དེ་ཉིད་སྒྱུ་མ་ལྟ་བུར་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པ་གསལ་པོར་ཤེས་ཐུབ།",
    "དེ་བཞིན་གཞན་ལ་དེ་ཙམ་བརྟེན་མི་དགོས་པར་བརྟེན་བྱམས་པའི་ཉམས་ལེན་བྱེད་དགོས་དོན་མི་འདུག་སྙམ་ན།",
    "ཞིབ་ཚགས་པོའི་བསམ་བློ་བཏང་བ་ཡིན་ན་སྐབས་ཤིག་ཏུ་རང་ཉིད་ལ་མཐའ་གཅིག་ཏུ་གནོད་པ་བྱས་པའི་དགྲ་བོ་དྭངས་མ་དེས་ཀྱང་རང་ཉིད་ལ་དྲིན་ཆེན་པོ་བསྐྱངས་ཡོད་པ་ཤེས་ཐུབ།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ལ་གོང་འཁོད་ཨ་རིར་ཆིབས་བསྒྱུར་སྐབས་ཐུགས་སྣང་ཇི་བྱུང་རང་རྣམ་ནང་འཁོད་གསལ།",
    "ཁྱིམ་མེད་ཀྱི་མི་དེ་ལྟ་བུའི་མང་པོ་ཞིག་སྒོ་འགྲམ་ཁག་ཏུ་སྡོད་མཁན་ཡང་འདུག་པས་སེམས་སྐྱོ་པོ་ཞིག་བྱུང་།",
    "ཉེར་མཁོའི་ཡོ་བྱད་མ་ཚང་བ་མེད་པ་འདུག་ཀྱང་།",
    "ལོག་ལྟའི་བསམ་བློའི་འཁྱེར་སོ་ཤུགས་ཆེན་པོ་ཡོད་མཁན་འདུག་ཅིང་།",
    "བོད་དུ་ཕྱིར་སྐྲོད་གཏོང་རྒྱུའི་ཉེན་བརྡ་བཏང་འདུག་པས་གནས་སྟངས་ཉེན་ཚབས་ཅན་ཞིག་ཏུ་གྱུར་འདུག་རྒྱ་གར་ནང་བོད་མི་སྐྱབས་བཅོལ་བ་སྟོང་ཕྲག་བརྒྱད་ཅུ་ཙམ་ཡོད་ཁོངས་ནས་སྟོང་ཕྲག་བརྒྱད་བརྒལ་བར་ད་དུང་ཡང་གཞིས་ཆགས་ཀྱི་མཐུན་རྐྱེན་མ་ཐོབ་པར་ལྷག་བསྡད་ཡོད་པ་དང་བཅས་རྒྱ་གར་གཞུང་ལ་སྐུ་ངལ་མཛད་དཀའ་ཡོད་བཟོ་འདུག་ཅིང་།",
    "བོད་མི་དེ་རྣམས་བོད་དུ་ཕྱིར་སྐྲོད་གཏོང་རྒྱུའི་ཉེན་བརྡ་བཏང་འདུག་པའི་ཛ་དྲག་ཉེན་ཚབས་ཀྱི་གནས་སུ་ལྷུང་།",
    "ཕར་ཙམ་དེར་རྒྱ་མི་ཡིན་ནའང་རུང་།",
    "ད་དུང་མུ་མཐུད་ནས་གཞོན་ནུའི་སྒྲིག་འཛུགས་འདི་ཚགས་ཚུད་པོ་ཡོང་བའི་དོན་དག་གང་དང་གང་བྱེད་རྒྱུ་འདུག་གམ།",
    "ངོས་ཀྱིས་སུ་གཅིག་ལ་སྤྲེལ་ལད་འཁྲབ་དགོས་དོན་མི་འདུག་སུ་གཅིག་ལ་ཡང་ངོ་སྲུང་བྱེད་དགོས་དོན་མེད།",
    "གནས་ཚུལ་དེ་འདྲ་ཡིན་དུས་མ་འོངས་པ་ལ་གནས་ཚུལ་བཟོ་ལྟ་གང་འདྲ་ཞིག་ཆགས་ཀྱི་འདུག་གམ།",
    "སློབ་སྦྱོང་ཟིན་ནས་ཀྱང་རང་རིགས་གཙོ་གྱུར་འགྲོ་བ་མིའི་རིགས་གཞན་དག་ལ་སློབ་སྤེལ་བྱེད་ཐུབ་པའི་འབད་བརྩོན་ཤུགས་བསྐྱེད་དགོས་གལ་བཀའ་སློབ་སྩལ།",
    "དེ་རྗེས་མི་གྲངས་༣ སྐོར་འདུ་འཛོམས་ཐོག་དུས་རབས་ཉི་ཤུ་པ་འདིའི་ནང་ཕྱི་དངོས་པོའི་ཡར་རྒྱས་ཕྱིན་ཡོད་ཀྱང་།",
    "ད་དུང་རང་གཞན་གཉིས་ཡོད་ཀྱི་བྱ་བར་ལྷག་བསམ་ཁུར་འགན་ཆེ་བསྐྱེད་དགོས་སྐོར་དང་།",
    "བསམ་བློ་གཏོང་རྒྱུའི་ཐོག་ལ་གང་ཐུབ་ཀྱིས་འབད་བརྩོན་དང་དོ་སྣང་བྱེད་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཅེས་སོགས་ཡིད་བློ་མགུ་བའི་ལམ་སྟོན་མཛད།",
    "བོད་ནང་ལ་འབྲེལ་བ་བྱུང་བ་ཡིན་ན་ཡག་པོ་འདུག་བསམ་པའི་བསམ་ཚུལ་བྱུང་སྟེ།",
    "ངས་བདེ་སྐྱིད་ཟེར་བ་འདི་གསལ་པོ་མི་འདུག་ཅེས་ཤོད་མཁན་མང་པོ་བྱུང་།",
    "རྩད་གཅོད་དོན་པའི་སྐབས་ལ་རལ་པ་ལྷན་པས་མ་ཁེབས་པའི་བཟོ་འདྲ་པོབྱས་ནས་བསྡད་ན་ཆོ་གང་ཡང་མི་འདུག་སོ་སོས་མ་འགྲུབ་པ་དང་།",
    "གནས་ཚུལ་འདྲ་མིན་མང་པོ་འདུགདཔེར་ན།",
    "ཡག་པོ་མི་འདུག་བསམས་ནས་ཟན་བརྟག་བསྒྲིལ།",
    "རང་བཞིན་འཕྲོས་དོན་ལྟ་བུ་ཡིན་སྟབས་སྐྱོན་མི་འདུག་ལོ་གཅིག་ངོས་ཀྱི་རྨི་ལམ་དུ།",
    "ཚུར་ཙམ་དེར་རྙོག་གྲ་མང་པོ་ཡོད་པ་དང་།",
    "སྐུ་ཐོག་རྗེས་མ་ཚོར་གང་འདྲ་ཡོང་མིན་ཆ་མ་མཆིས་སྟབས་དགོངས་བཞེས་གནང་དགོས་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་བྱུང་།",
    "ཚོང་འཁོས་ལམ་འགྲོ་ཡོང་བའི་གསོལ་མཆོད་བྱེད་ཆོག་མེད་སྟབས་འགག་ལ་ཐུག་དུས་སྟོན་པ་བཅོམ་ལྡན་འདས་ལས་ཀྱང་ལྷ་འདྲེ་རྣམས་ཁ་ཚ་དགོས་གཏུགས་ཀྱི་མཁོ་ཕན་ཆེ་བར་མཐོང་ཞིང་།",
    "ཉེ་ཆར་ལྷ་སའི་ནང་སྦྱར་ཡིག་མང་པོ་ཞིག་སྦྱར་ཡོད་འདུག་འོན་ཀྱང་།",
    "གསང་བའི་སྒྲིག་འཛུགས་མང་པོ་ཞིག་ཡོད་བཟོ་འདུག་ཀྱང་ཁ་གྲངས་བརྗོད་རྒྱུ་དཀའ་ཞིང་།",
    "བརྗོད་ནའང་དགེ་མཚན་དེ་ཙམ་མི་འདུག་དངོས་འབྲེལ་ལུས་ཀྱི་འཐབ་འཛིང་ལ་བརྟེན་ནས་སྒེར་ལངས་བྱེད་པའི་གནས་ཚུལ་ཉུང་ཉུང་ཡིན།",
    "ལམ་ལུགས་འདིས་ད་བར་ལས་དོན་ཡག་པོ་འགྲུབ་ཡོད་བསམ་གྱི་འདུག་དེ་ཚོའི་ཐད་རང་ཐོག་ནས་ཀྱང་འགྱུར་བ་མང་པོ་ཞིག་བཏང་ཡོད།",
    "ད་ལྟའི་ཆར་གསུང་རྒྱུ་ཁག་པོ་ཡིན་པ་ཕྲན་ནས་ཤེས་ཀྱི་འདུག་འོན་ཀྱང་།",
    "ཞིབ་ཕྲ་ད་ལྟ་བརྗོད་འདོད་མེད་ལ་བརྗོད་རྒྱུ་ཡང་ཁག་པོ་འདུག་ད་ལྟའི་ཆར་ཕྱིར་ལོག་བྱ་རྒྱུའི་སྐད་ཆ་མེད།",
    "སྐབས་དེར་ཨ་རིའི་ནང་ནས་དོ་སྣང་ཤུགས་ཆེ་བ་བྱེད་ཀྱི་འདུག་ཅེས་སྩལ།",
    "མར་ལ་༦ ཡོད་པའི་གསལ་བཏོན་བྱས་འདུག་ཅིང་།",
    "ད་དུང་ཡང་ལྷག་བསྡད་བོད་མི་རྣམས་འགྲོ་འདུག་གཏན་མ་འཁེལ་བའི་དཀའ་ངལ་ཆེ་གྱུར་ལ་བརྟེན།",
    "ངས་དེ་འདྲ་དྲན་གྱི་འདུག་ཅེས་སྩལ།",
    "ང་རང་ནས་ད་ལྟ་སེམས་ཤུགས་དེ་འདྲ་ཞིག་འཁྱེར་ནས་བསྡད་ཡོད།",
    "ང་ཕར་ཤོག་ཟེར་གྱི་ཡོད་པའི་བཟོ་འདྲ་ཞིག་འདུག་འོན་ཀྱང་།",
    "ཁྱད་གང་ཡང་མི་འདུག་བལྟ་བར་ཕྱིན།",
    "རྒྱ་མིའི་འོག་ལ་སྐྱིད་པ་འདུག་ཅེས་ལབ་ན།",
    "རྒྱ་གར་ནང་འབྱོར་སྐབས་དེས་འགྲིགས་ཀྱི་མི་འདུག་པས་རིས་མེད་ཅིག་དགོས་ཀྱི་འདུག་ཅེས་སྲིད་བྱུས་གསར་པ་ཞིག་བཏིང་པ་ཡིན།",
    "ང་རང་ལ་ཆ་བཞག་ན།",
    "ཁོ་རང་གསོན་པའི་སྐབས་ལ་ཡང་བསྙད་སེ་བསྐོ་སེའི་རྙོག་མ་གཏིང་སློང་ཤ་སྟག་བྱས་བྱུང་ལ།",
