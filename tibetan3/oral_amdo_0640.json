    "ཞེས་བ་ནི་ཇི་ལྟ་བུར་ན་ཚོན་ཞེས་ཞུས་པའི་ལན་ཏེ། ། སྔགས་པ་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཞུགས་ནས་ནང་དུ་བསྣུར་ཞིང་ཚོན་རྣམས་བྲི་ཞེ་པའོ།",
    "དེ་ལ་གང་གི་ཐོག་མར་གཏང་།",
    "དེ་ལྟར་གཟུང་བ་དང་འཛིན་པའི་ཆ་ཡོངས་སུ་སྦངས་པའི་སྟོང་པ་ཉིད་ས་རབ་ཏུ་དགའ་པ་དེ་དག་གི་ཚེ་ན་མ་ཐོབ་པ་མ་ཡིན་མོད་ཀྱི།",
    "དག་གི་སྤྱོད་ཡུལ་དང་བྲལ་ཞེས་པ་ནི་རྣམ་པར་རྟོག་པ་དང་བྲལ་ཞེས་པ་སྟེ།",
    "ཞེས་པ་ནི་ཉོན་མོངས་པ་ལས་རྣམ་པར་གྲོལ་བས་དངོས་ས་ན་ཉོན་མོངས་པའི་བདུད་བཅོམ་པའོ།",
    "ཤིན་ཏུ་དྲི་མ་མེད་པ་ཞེས་པ་ནི་ཡེ་ཤེས་དེ་ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་ཡོངས་སུ་སྤངས་པ་ཞེས་པའོ།",
    "དེ་ཁོ་ན་ཞེས་པ་ནི་ཕྱིན་ཅི་མ་ལོག་པ་ཡོངས་སུ་རྫོགས་པའི་མཚན་ཉིད་པས་རིགས་པ་དང་གཞུང་གིས་སུན་དབྱུང་དུ་མི་ནུས་པས་ན་སྟོད་པ་ཉིད་ཀྱི་ཡེ་ཤེས་དེ་ཁོ་ན་ཞེས་བྱའོ།",
    "ཞེས་པ་ནི་འཇིག་རྟེན་རྣམས་གང་གི་འབྲས་བུ་ཡང་མ་ཡིན་ཏེ།",
    "འབྲུ་ནི་ཡི་གེ་ཀ་ལ་སོགས་པ་སྔགས་ཀྱི་ཡི་གེ་འབྲུ་རེ་བའོ།",
    "ཡུལ་སྐད་ནི་སོ་སོའི་ཡུལ་ན་སྐད་གང་གིས་སྤྱོད་སྤྱད་པ་དེ་ཉིད་དང་མཐུན་པར་གསུངས་པའོ།",
    "ཛིན་ཛིཀ་ཅེས་པ་ལ་སོགས་པ་ལྷའི་མཚན་སྨོས་པས་ལྷ་གང་གི་སྔགས་ཡིན་པ་རིག་པར་འགྱུར་བའོ།",
    "ཉན་ཐོས་རྣམས་ཀྱི་སྔགས་ནི་ཚིག་རེ་རེ་ལ་འཇུག་པ་སྟེ་ཞེས་པ་ནི།",
    "འཕགས་པ་ཉན་ཐོས་རྣམས་ཀྱི་། སྔགས་རྣམས་ནི་སྤྱི་བོ་དང་གཙུག་ཕུད་ལ་སོགས་པ་ཡན་ལག་གི་སྔགས་རྣམས་མེད་པས་ན་གཅིག་པུའོ།",
    "དགེ་སློང་གི་ཚུལ་གཅིག་པུ་འཛིན་པའམ།",
    "ཚིག་ལས་མིང་དང་མཚན་མར་རྟོག་པའི་མཚན་ཉིད་ཀྱི་སྔགས་བསྐུལ་པ་ལ་སོགས་པ་དང་ལྡན་པའི་ཚིག་གིས་དོན་གང་བསྐུལ་བ་དེ་གྲུབ་པར་བྱེད་པའི་མཐུའི་རང་བཞིན་རྣམས་མཐུ་འདིས་དོན་འདི་འགྲུབ་པར་བྱའོ་ཞེས་དེ་བཞིན་གཤེགས་པས་སྔགས་ཀྱི་རང་བཞིན་ཏེ་བྱས་པ་ཡིན་ནམ།",
    "རྒྱུ་གང་གིས་ཀྱང་འདུས་མ་བྱས་པར་མངར་བའི་རང་བཞིན་ཡེ་ནས་འདུག་པ་བཞིན་ནོ།",
    "བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་ཡུན་དུ་གཟིགས་པའོ།",
    "སྟོབས་ཞེས་པ་ནི་དེ་དག་གི་མཐུ་ཐོགས་པ་མེད་པའོ།",
    "ཚིག་དང་ཡི་གེ་འབྲུ་རེ་ལས་ཏིང་ངེ་འཛིན་གྱི་སྒོར་གྱུར་པ་དེ་ཡང་དོན་གཉིས་སྟོན་ཏེ།",
    "དེ་བས་ན་ཡི་གེ་འབྲུ་དང་ཚིག་གི་སྒོ་ནས་ཀུན་རྫོབ་དང་དོན་དམ་པའི་དོན་བསྟན་པའི་ཕྱིར།",
    "དེ་ལ་ཡི་གེ་ཨ་ལ་སོགས་པ་གང་ཡང་རུང་བ་ཅིག་གིས་ཐམས་ཅད་སྟོང་པ་ཉིད་དུ་སྟོན་པ་ལས་ལྷག་པར་ཡི་གེ་གཞན་རྣམས་སྟོང་པ་ཉིད་དུ་སྟོན་པ་མེད་དེ།",
    "སྟོང་པར་སྟོན་པ་ནི་ཡི་གེ་གཅིག་གིས་ཀྱང་ཆོག་མོད་ཀྱི།",
    "རྡུལ་ཞེས་རྡུལ་ཕྲ་མོ་རྣམས་ལ་ཡང་བྱ་བ་སྟེ་ཉོན་མོངས་པ་རྣམས་ལ་ཡང་བྱ་སྟེ།",
    "ངག་གི་ལམ་ལ་ལྦཱ་ཀ་ཞེས་བྱ་སྟེ།",
    "དེ་ལ་རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བསམ་གྱིས་མི་ཁྱབ་པའི་རྣམ་པར་སྨིན་པའི་འབྲས་བུའོ་ཞེས་པ་ནི།",
    "སྔགས་ཀྱི་དེ་ཁོ་ནའི་དོན་གདོན་མི་ཟ་བ་ཞེས་པ་ནི་ཕྱིན་ཅི་མ་ལོག་པས་རིགས་པ་དང་གཞུང་གིས་སུན་མི་ཕྱིན་པའོ།",
    "ནམ་མཁའ་དང་འདྲ་སྟེ་དྲི་མ་མེད་ཅེས་པ་ནི་ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་དྲི་མ་རྣམས་དང་བྲལ་བ་ཞེས་པའོ།",
    "ཞེས་བ་ནི་སེམས་པ་མེད་པ་ལས་སེམས་ཀྱི་ས་ལ་གནས་པ་སྟེ་སོ་སོ་རང་གི་རིག་པའི་རང་བཞིན་ཞེས་པའོ།",
    "ཀུན་རྫོབ་ཏུ་བཟླས་པའི་ཡན་ལག་བཞི་ལ་སོགས་པ་ལུས་དང་ངག་གི་ལས་རྣམས་ཀྱང་སྟོན་ཞེས་པའོ།",
    "ཡི་གེ་ཀ་ལ་སོགས་པ་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་དེ་དག་གི་དོན་བསམ་དུ་མེད་པ་དེ་དག་གིས་འཇལ་ཏེ་ངོ་མཚར་ཆེའོ་ཞེས་པའོ།",
    "རེ་རེ་བར་ནི་བསྒྲགས་པ་ཡིན།",
    "དཀར་དང་དམར་དང་སེར་ཞེས་པ་ནི་མེ་ཏོག་གི་རིགས་སྤྱིར་སྨོས་པའོ།",
    "ཞེས་པ་ནི་འདིར་མིང་གིས་སྨོས་པ་ལས་གཞན་ཡང་དྲི་ཞིམ་ཞིང་ཡིད་དུ་འོང་བ་ལ་སོགས་པ་དྲིའི་རིགས་རྣམས་གང་ཡང་རུང་བ་དབུལ་ལོ་ཞེས་པ་སྟེ།",
    "ཞེས་པ་ནི་ཕྱིའི་སྒོ་ཁར་ཤིང་ལ་སོགས་པ་ལས་བྱས་པའི་རྟ་བབས་བཟང་པོ་དྲིལ་བུ་དག་གིས་བརྒྱན་པ་ཞེས་པའོ།",
    "གོས་ཟུང་རེ་ནི་དབུལ་བར་བྱ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དབུས་ན་བཞུགས་པ་ལ་རས་ཟུང་རེ་རེ་དབུལ་ལོ་ཞེས་པའོ།",
    "ཐམས་ཅད་ལ་ཟུང་རེ་མི་འབྱོར་ན་སྤྱིར་ཟུང་གཅིག་དབུལ་བར་བྱའོ།",
    "ཡ་རེ་བར་ནི་བསྒྲགས་པ་ཡིན།",
    "ཞེས་པ་ནི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཕལ་རྣམས་ལ་ཡ་རེ་དབུལ་ཞེས་པ་སྟེ།",
    "ཐམས་ཅད་ལ་རེ་རེ་མ་འབྱོར་ན་ཡང་སྤྱིར་ཡ་གཅིག་དབུལ་བར་ཤེས་པར་བྱའོ།",
    "བཅིང་བ་དེ་ནས་སྔགས་པ་རང་གིས་ནན་ཏན་གྱིས།",
    "མོད་ཀྱི་ལས་འདི་རྣམས་ཀྱི་དང་པོར་ཤེས་པར་བྱའོ།",
    "དམ་ཚིག་གི་སྔགས་དང་ཕྱག་རྒྱས་བྱིན་གྱིས་བརླབས་པས་བཀབ་ནས་ཡེ་ཤེས་ཀྱི་མིག་ཏུ་བསྒྱུར་བར་འགྱུར་ཏེ།",
    "དེའི་བྱིན་གྱི་རླབས་སུ་གྱུར་པ་ནི་དམ་ཚིག་གི་སྔགས་དང་ཕྱག་རྒྱ་སྟེ།",
    "ར་ནི་ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་བྲལ་བའི་རང་བཞིན་ནོ།",
    "གདོང་གཡོགས་བཀྲོལ་ལ་མེ་ཏོག་དེ་བདག་གི་ལྷའམ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལ་དབུལ་བར་བྱ་སྟེ།",
    "བདག་ནང་དུ་ཞུགས་ན་ཁ་ཅིག་གི་སྤྱན་སྔར་ཀྱང་མི་འགྱུར་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་མི་ཟད་པའི་རྡོ་རྗེའི་རྒྱན་ལ་སོགས་པ་ལ་སྦྱིན་སྲེག་གི་སྒོ་ནས་ཡོན་ཕུལ་ན།",
    "རྩྭ་གཅིག་གི་རྩ་བས་གཅིག་གི་མགོ་ནོན་པར་བྱས་ཏེ་བསྐོར་རོ།",
    "སྐྱབས་གསུམ་ལ་སོགས་པར་སོང་བ་དང་།",
    "སྤྱིན་སྲེག་གི་ནི་ཡོ་བྱད་བཞག།",
    "ཡང་དག་ཡིད་གཅིག་གིས་ལ་ཉོན།",
    "ཁྱོད་ལ་རྟག་ཏུ་སྲུང་བར་བྱེད།",
    "དེ་ནས་དེ་ལྟར་བདག་གི་དོན་ཡོངས་སུ་རྫོགས་ནས་ཕ་རོལ་གྱི་དོན་ཕུན་སུམ་ཚོགས་པར་བྱ་བའི་ཕྱིར་རྐང་པའི་འོག་ཏུ་གསེར་གྱི་འཁོར་ལོ་བཞག་སྟེ།",
    "ཡང་དག་ཡིད་གཅིག་གིས་ལ་ཉོན།",
    "ནང་གི་དཀྱིལ་འཁོར་གྱི་ས་བྱང་ཕྱོགས་སུ་གཞོལ་བར་བྱའོ།",
    "ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་པའི་ཤེས་རབ་ཅན་ཞེས་པའོ།",
    "གཉིས་སུ་ནི་རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་གཉིས་ནི་ཕ་རོལ་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའི་རང་བཞིན་ཏེ།",
    "གོང་མ་གཉིས་ནི་རང་གི་དོན་ཕུན་། སུམ་ཚོགས་པའི་རང་བཞིན་ནོ།",
    "མརྒཏྟའི་བུམ་པ་གསེར་དང་དངུལ་དེ་དག་གིས་བརྒྱན་པའི་བུམ་པ་བྱའོ།",
    "ངན་སོང་སྤངས་ནས་ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་བྲལ་བར་གྱུར་ཅིག་པའི་དོན་དུ།",
    "སྔགས་པས་པདྨ་དམ་པ་དེ་ལ་ནི་རང་གིས་བཞག་ནས་སུ་ཞེས་པ་ནས།",
    "ལག་པ་གཡོན་པ་ཁྲི་ལ་བསྟེན་ལ་གཡས་པ་པུས་མོ་ལ་བཞག།",
    "བུ་ཁྱོད་ཀྱི་རྒྱལ་བས་ཁྱོད་ཀྱི་དེ་བསལ་བ་ནི་ཞེས་པ་སྔོན་མཉམ་པ་དང་།",
    "གཟུགས་ལ་སོགས་པའི་རང་གི་དངོས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པ་མི་མཐོང་བ་ལས་མཐོང་བར་བྱས་པ་བཞིན་དུ།",
    "རྟོག་པ་མེད་པ་ཞེས་པ་ནི་སྒྲིབ་པ་དང་དེ་དག་གི་བག་ཆགས་ཀྱང་མེད་ཅེས་པའོ།",
    "མི་གཟུང་བ་བརྗོད་དུ་མེད་པ་ཞེས་པ་དེ་ལྟ་བུའི་སྟོང་པའི་རང་བཞིན་ལ་རྣམ་པར་ཤེས་པ་དྲུག་གིས་གཟུང་དུ་མེད་ཅིང་།",
    "ཚིག་གིས་བརྗོད་དུ་མེད་པ་དེ་ལས་འདས་པའོ།",
    "ཞེས་པ་ནི་ཁྱོད་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལས་སྐྱེས་སོ་ཞེས་པའོ།",
    "ཁྱོད་ལ་རྟག་ཏུ་སྲུང་བར་བྱེད།",
    "ནང་གི་བདག་ཉིད་ངེས་པའོ།",
    "དེ་བཞིན་དུ་འདིར་ཡང་སྔ་ནས་ཡང་དམ་ཚིག་འདི་རྣམས་སྲུང་མོད་ཀྱི།",
    "བུ་ཁྱོད་དེང་ཕན་ཆད།",
    "སྲོག་གི་ཡང་ནི་ཕྱི་རུ་ཡང་།",
    "དེ་རྣམས་ཁྱོད་ཀྱིས་སྲོག་གི་ཕྱིར་ཡང་མི་གཏང་ངོ་ཞེས་པའོ།",
    "སེར་སྣ་ཁྱོད་ཀྱིས་ཡོངས་མི་བྱ།",
    "ནང་གི་བདག་ཉིད་ངེས་པས་སོ།",
    "ངག་གིས་ཞེས་པ་ནས་ཐམས་ཅད་ཁས་བླང་པ་ཞེས་པ་སྟེ།",
    "སེམས་ཀྱིས་ནི་ནང་གི་བདག་ཉིད་ངེས་པས་སོ་ཞེས་པ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ལ་སོགས་པ་མཉམ་པ་ཉིད་མི་ཟད་པའི་རྡོ་རྗེའི་རྒྱན་དེ་དག་གི་བྱིན་གྱིས་བརླབས་སུ་གྱུར་པ།",
    "དམ་ཚིག་དེ་ལྟ་བུ་ལ་ཞུགས་པ་ནི་མོས་པ་སྤྱོད་པ་ནས་ཞུགས་ན་མཐའ་དེ་བཞིན་གཤེགས་པའི་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་དེ་དག་ཇི་ལྟར་ཞལ་དང་ལྷུམས་ནས་སྐྱེས་པའི་སྲས་པོ་ཞེས་པ་ཞལ་ནས་སྐྱེས་པ་ནི།",
    "སྒོ་ནི་མོས་པ་སྤྱོད་པའི་ས་ལ་སོགས་པ་སྟེ་དེ་དག་མོས་པ་སྤྱོད་པའི་ས་ལ་ཞུགས་པའི་ཕྱིར་རོ།",
    "སྔགས་དེ་རྣམས་ཀྱང་དེ་བཞིན་གཤེགས་པའི་གསུང་གི་འཁོར་ལོས་ཁམས་གསུམ་དུ་ཁྱབ་པའི་བྱིན་གྱིས་བརླབས་སུ་གྱུར་པ་སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་འཁོར་དེ་དག་ཐམས་ཅད་ལ་གཟིགས་ནས་ཞེས་པ་ནས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཚེ་རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཞེས་པ་ནས་ཏིང་ངེ་འཛིན་ལ་ཀུན་དུ་མཐུན་པར་ཞུགས་སོ་ཞེས་པའི་བར་དུ་རིག་པའི་རྒྱལ་མོ་དེ་ཡོངས་སུ་བསྒྲགས་པའི་ཕྱིར་ཏིང་ངེ་འཛིན་ལ་ཞུགས་པ་སྟེ།",
    "རྣམ་པར་དག་པ་ཞེས་པ་ནི་ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་མེད་པའོ།",
    "རྩེ་མོ་ཀུན་དུ་བལྟ་བ་ཞེས་པ་ནི་ཁམས་གསུམ་ཐམས་ཅད་དུ་གཟིགས་པས་ན་རྩེ་མོ་ལྟར་མཐོ་བ་སྟེ་དེ་དག་ནི་ཏིང་ངེ་འཛིན་གྱི་ཁྱད་པར་རོ།",
    "བཅོམ་ལྡན་འདས་དེ་ལྟ་བུའི་སྒྲ་འབྱིན་ཅིང་རིག་པའི་རྒྱལ་མོ་གསུངས་སོ་ཞེས་པ་དང་སྦྱར་རོ།",
    "སྟོབས་ཆེན་གསང་སྔགས་འདི་དྲན་པས་སོ་ཞེས་པའི་བར་དུ་རིག་པའི་རྒྱལ་མོ་དེའི་མཐུ་རྗེས་སུ་བསྔགས་པ་སྟེ།",
    "བར་གཞན་གྱིས་ཆོད་ནས་དམ་ཚིག་གི་སྔགས་འདོན་པའོ།",
    "མེ་ཏོག་གི་སྔགས་ནི་བྱམས་པ་ཆེན་པོའི་ཡོན་ཏན་ལས་གྱུར་པའོ།",
    "དེ་བཞིན་ཉིད་ཐོབ་པར་བྱེད་པའི་ལམ་གྱི་ཡེ་ཤེས་འབར་བ་དེས་ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་དག་སྲེག་པར་བྱེད་པ་ལས་བྱུང་བའོ།",
    "ཤེས་བྱ་དང་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྲེག་པར་བྱད་པ་ལས་བྱུང་བའོ།",
    "བགེགས་ནི་རང་གི་སེམས་ལས་བྱུང་། ཞེས་པ་ནས།",
    "བགེགས་ནི་རང་གི་སེམས་ལས་བྱུང་།",
    "འཁོར་དྲུག་གི་མཐའ་བསྐོར་ནས་རྒྱལ་པོ་ཉིད་དབུས་སུ་བཞག་ལ།",
    "ལྷ་རྣམས་རང་རང་གི་དཀྱིལ་འཁོར་ལ་གནས་ནས།",
    "དམ་ཚིག་གི་ཚུལ་གྱིས་དེ་ལྟ་སྟེ།",
    "ལྷ་རྣམས་རང་རང་གི་དཀྱིལ་འཁོར་ལ་གནས་པར་སྦྱར་ན།",
    "གང་དང་གང་གི་ཁ་དོག་ཏུ་གསུངས་པ་དེའི་དཀྱིལ་འཁོར་ཡང་དེ་ཉིད་དོ་ཞེས་པ་ནི།"
  ]
