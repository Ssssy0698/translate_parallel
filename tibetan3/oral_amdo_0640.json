    "བསྐལ་པ་དེའི་བཞི་ཆ་གཅིག་གིས་ནི།",
    "ཇི་ལྟར་འཇིག་རྟེན་པ་རྣམས་འཇིགས་པ་གཅིག་ལས་ཐར་ནས་འཇིགས་པ་དེ་ལས་ཀུན་དབུགས་དབྱུང་མོད་ཀྱི་དེ་ལས་གཞན་པའི་འཇིགས་པ་རྣམས་ལས་མ་ཐར་ན་དབུགས་མ་ཕྱུང་བའོ།",
    "དབུགས་དབྱུང་མོད་ཀྱི་དེ་ལས་གཞན་པའི་བགེགས་སུ་གྱུར་པ་རྣམས་ལས་མཐར་ན་དེ་ལས་དབུགས་མ་དབྱུང་བ་ཞེས་བྱ་སྟེ།",
    "ནམ་བདག་གིས་དེ་ཁོ་ན་ཉིད་ཇི་ལྟ་བ་ཉིད་རབ་ཏུ་ཤེས་ན་བདག་གི་གནས་སུ་རབ་ཏུ་དབུགས་དབྱུང་བའོ་ཞེས་བ་ནི་སྦྱིན་པ་ལ་སོགས་པའི་སེམས་བརྒྱད་སྤྱོད་པ་ན།",
    "བདག་ལ་བརྟེན་ཅིང་འཇིག་རྟེན་པའི་ལས་རྣམས་གོམས་པར་བྱེད་པ་ནི་བདག་གི་གནས་སུ་དབུགས་དབྱུང་བ་ཞེས་བྱའོ།",
    "བདག་གིས་དེ་ཁོ་ན་ཉིད་ཇི་ལྟ་བ་ཉིད་དུ་རབ་ཏུ་ཤེས་ཞེས་པ་ནི་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་དུ་ཤེས་རབ་ཀྱིས་ཇི་ལྟ་བ་ཉིད་དུ་ཤེས་པ་ལ་ནི་མི་བྱའི།",
    "འཇིག་རྟེན་པའི་གཞུང་བཞིན་དུ་བདག་གི་ངོ་བོར་བརྟགས་པ་དེ་ཕྱིན་ཅི་མ་ལོག་པར་ཤེས་པ་ལ་བྱའོ།",
    "ནམ་ཕུང་པོ་ཡོངས་སུ་གཟུང་བ་བྱས་ནས་བདག་གིས་གནས་ཀུན་སྤངས་ཏེ།",
    "དོན་དམ་པར་སྟོང་བའི་རང་བཞིན་ཡིན་མོད་ཀྱི།",
    "སྒྱུ་མ་དང་སྨིག་རྒྱུ་དང་རྨི་ལམ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་གཞན་ཡང་གསང་བའི་བདག་པོ་ལ་ལས་མེའི་མགལ་པ་ལག་ཏུ་བླངས་ཏེ་བསྐོར་ནས་འཁོར་ལོར་མཐོང་མོད་ཀྱི།",
    "དེ་ན་ཆུ་ཡོད་པ་མ་ཡི་ན་ཡང་སྨིག་རྒྱུ་བ་དེ་ཇི་བཞིན་པའི་རྣམ་པར་ཤེས་པ་བསྐྱེད་ཅིང་སྐོམ་པ་ཡང་ཆུས་དེ་མོས་པའི་བྱ་བ་བྱེད་དེ།",
    "འདུ་ཤེས་ཙམ་དུ་ཟད་མོད་ཀྱི།",
    "ཇི་ལྟར་བུ་མོ་གཞོན་ནུའི་རྨི་ལམ་ན།",
    "གཞན་གྱི་ཕྱིར་མ་གྲུབ་ཀྱང་ནམ་རིག་འཛིན་ལ་སོགས་པ་གྲུབ་ན་ལྷའི་གཞལ་མེད་ཁང་དང་དཔག་བསམ་གྱི་ཤིང་གི་གྲིབ་མ་དང་ཤེལ་གྱི་བྲག་ལ་བདུད་རྩིའི་ཆུ་འབབ་པ་དང་།",
    "དེ་བཞིན་དུ་སྔགས་སྒྲུབ་པའི་རིག་འཛིན་དེ་ཡང་རིག་འཛིན་གྱི་ལུས་བཟང་པོ་ལ་སོགས་པ་བསྒྲུབ་པའི་གཟུགས་དེ་ལས་གཞན་མ་ཡིན་ཏེ་གཟུགས་དེ་ཉིད་ལས་འགྱུར་མོད་ཀྱི།",
    "ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་ཞེས་པ་ནི་དཀྱིལ་འཁོར་གྱི་སྒོ་ནས་སྒྲུབ་པ་ལྷ་མཉེས་པར་བྱ་བའི་སྤྱོད་ཡུལ་བ་རྣམ་པ་བཅུ་དྲུག་གིས་བདག་གི་ལྷ་མཉེས་པར་བྱ་བ་དང་སྒྲུབ་པའི་སྒོ་ནས་བསླབ་པའི་ཡན་ལག་བཞི་དང་རང་གི་སེམས་ཡོངས་སུ་སྦྱང་བ་ལ་སོགས་པའི་སྤྱོད་པའི་ལྷ་མཉེས་པར་བྱ་སྟེ།",
    "སྣོད་དུ་མི་འགྱུར་བའི་ཉན་པ་ཡོད་དམ་མེད་བརྟག་པའི་ཕྱིར་གཟིགས་པ་ལ་བྱ་སྟེ།",
    "རང་གི་སེམས་ཡོངས་སུ་སྦྱང་བར་བྱས་པས་ལྷ་མཉེས་པར་འགྱུར་ཏེ།",
    "གཉིས་སུ་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མོལ་ཏེ་ཞེས་པ་ནི།",
    "ཡང་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་མོལ་ཏེ་ཞེས་པ་ནི་མ་འོངས་པའི་འགྲོ་བ་ང་རྒྱལ་ཅན་རྣམས་ང་རྒྱལ་བཅག་པ་དང་།",
    "ངག་གི་ཡོན་ཏན་དང་ཡིད་ཀྱི་ཡོན་ཏན་དང་གསུམ་སྟེ།",
    "བརྟན་པ་ཞེས་པ་ནི་ཤེས་པ་དང་ལོངས་སྤྱོད་ལ་སོགས་པ་དང་ལྡན་པ་ཡང་དེ་དག་གིས་དྲེགས་པར་མི་འགྱུར།",
    "ཟབ་ཅིང་རྒྱ་ཆེ་བ་ལ་མོས་པ་དང་དམིགས་པ་ཅན་ནོ།",
    "རང་གིས་བསྐུལ་མ་བཏབ་སྟེ།",
    "རང་གིས་བསྐུལ་མར་བཏབ་སྟེ་ཞེས་པ་གོང་དུ་སྨོས་པའི་ཡོན་ཏན་གྱི་མཚན་ཉིད་དང་ལྡན་པར་མཐོང་ནས་ཞེས་པའོ།",
    "ཁྱོད་ཀྱང་ཚུལ་ཆེན་སྣོད་དུ་འགྱུར།",
    "ཕྱི་དང་ནང་གིའོ།",
    "ཟབ་ཅིང་རྒྱ་ཆེ་བ་ལ་མོས་པ་དང་དམིགས་པ་ཅན་ནོ།",
    "དེ་བས་ན་སློབ་དཔོན་ཟབ་ཅིང་རྒྱ་ཆེ་བ་ལ་མོས་པས་ནི་ཕྱི་ནང་གཉིས་ཀའི་ས་སྦྱང་བར་བྱའོ།",
    "དེ་ལ་ནང་གི་ས་སྦྱང་བ་ནི།",
    "ཕྱིའི་སྦྱང་བ་ནི་རྡོ་དང་གྱོ་མོ་དང་ས་དང་འབྲས་དང་ཞེས་པ་ནས་གནས་རྣམས་ཉེས་པ་ཐམས་ཅད་དང་བྲལ་ན་ལྷ་རྣམས་ཀྱིས་ཀྱང་བསྔགས་སོ་ཞེས་པའི་བར་དུའོ།",
    "ལྷའི་དང་བར་སྣང་གི་དང་ས་ལས་བྱུང་བའོ།",
    "བར་སྣང་གི་ནི་བཀྲ་ཤིས་ཀྱི་ཚིག་དང་བྲམ་། ཟེའི་སྨྲང་ལ་སོགས་པ་ཐོབ་སྟེ་འབྲིང་ངོ།",
    "དཔང་དུ་ལྷ་མོ་ཁྱོད་གྱུར་བ།",
    "ས་ཁྱོད་ཀྱི་སྟེང་དུ་བབས།",
    "ལྷ་མོ་ཁྱོད་ཀྱིས་ཇི་ལྟ་བ་ཉིད་ཤེས་ཏེ་དཔང་དུ་གྱུར་ཏོ་ཞེས་པ་སྟེ།",
    "དེ་བཞིན་བདག་གིས་བདུད་བཏུལ་ནས།",
    "དེ་ཚུལ་བཞིན་སྔར་དེ་བཞིན་གཤེགས་པ་རྣམས་དང་ལྷ་མོ་དེ་ལ་མཆོད་ཅིང་ཕྱག་བྱས་ལ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་དཀྱིལ་འཁོར་དང་སྒྲུབ་པ་དང་སྔགས་སྤྱད་པའི་ཡན་ལག་རྣམས་མཚན་མ་ཅན་ཡིན་མོད་ཀྱི་དོན་གྱི་བྱ་བ་བྱེད་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དོན་དམ་པའི་མཚན་ཉིད་དེ་ལྟ་བུ་ཡིན་མོད་ཀྱི།",
    "དམ་ཚིག་གསུམ་གྱི་ཕྱག་རྒྱ་བཅིངས་ནས་བསམ་མོ།",
    "དེ་ཡང་བྱེ་བྲག་གི་མཚན་ཉིད་རབ་ཏུ་བྱེད་པའི་མཚན་ཉིད་དེ།",
    "དེ་ལ་འདིར་དད་པ་རིགས་བཙུན་པ་ལས་བྱུང་བ་ཞེས་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཇི་སྐད་དུ་སྨོས་པ་རྣམས་བྱེ་བྲག་གི་མཚན་ཉིད་དོ།",
    "དེ་རྣམས་ཀྱང་རྒྱུད་ལས་ནི་ཁ་ཅིག་ལྟག་འོག་ཏུ་འབྱུང་མོད་ཀྱི།",
    "དེ་ལས་གཞན་ལ་སྔོན་སྐྱབས་སུ་མ་སོང་བ་རྣམས་གདོད་སྐྱབས་སུ་གཏང་བར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་སྟེ་འདིར་སྔོན་སྐྱབས་སུ་སོང་ཟིན་པ་ཡང་བརྟན་པར་བྱ་བའི་ཕྱིར་ཡང་འདིར་སྐྱབས་སུ་གཏང་བར་བྱའོ།",
