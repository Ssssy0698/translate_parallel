    "ད་ལྟའི་གནས་སྐབས་ལ་ལོ་གཉིས་ཀི་གནས་ཚུལ་ད་དུང་མ་རག་པའི་གནས་སྟངས་དེ་འད་ཆགས་བསྡད་འདུག་ཅེས་ཞུ་རྒྱུ་ཞིག་དང་།",
    "ས་ཆ་དེ་ཚོའི་གནས་སྟངས་ལ་ངེས་པར་དུ་ཞིབ་འཇུག་བྱ་ཐུབ་པའི་འབོད་སྐུལ་ཞུ་རྒྱུ་དེ་ངེས་པར་དུ་གལ་ཆེན་པོ་ཞིག་ཆགས་བསྡད་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "ང་རང་ངོས་ནས་ད་ལྟ་འདིར་དུས་ཚོད་བཟུང་ནས་བོད་བསྟན་སིད་མི་རིགས་ཀི་ཆེད་དུ་ལུས་སོག་མེ་མཆོད་ཕུལ་མཁན་༡༤༥ ཆ་ཚང་ལ་སོ་གསུམ་གུས་པ་ཆེན་པོའི་གུས་ཞབས་ཞུ་རྒྱུ་དང་།",
    "སྐབས་དེ་དུས་ང་རང་བཅར་བ་ཡིན།",
    "བོད་རྒྱ་ཆེའི་གཞིས་ལུས་མི་མང་གཞིར་བཞག་པའི་ཐོག་ནས་གནས་ཚུལ་དེ་འད་མ་ཡོང་བ་གནང་དགོས་ཀི་འདུག་ཅེས་ཞུ་འདོད་བྱུང་།",
    "རྒྱ་ནག་གཞུང་ལ་འཁབ་ས་དང་མ་བཟུང་སྡིངས་ཆ་དེ་ཆེ་རུ་འགོ་ཡི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "དེ་འད་ཞིག་ཆགས་འདུག་བསམ་པའི་ཚོར་བ་བྱུང་།",
    "བརོད་ཚིག་ནན་པོ་གསུང་དགོས་རྒྱུ་དེ་ཧ་ཅང་ནན་པོ་གསུངས་གནང་འདུག་དེ་ཡིན་ཙང་ངས་དཔལ་ལྡན་ཚོགས་གཙོ་སེལ་པོ་གཙོས་པའི་སི་འཐུས་རྒྱུན་ལས་ལ་བསྔགས་བརོད་ཞུ་རྒྱུ་ཡིན།",
    "གལ་ཆེ་སར་ཐུག་དུས་དངོས་གནས་དང་གནས་ཙག་ཙིག་གཞག་སྟེ།",
    "གནང་རྒྱུའི་དུས་ཚོད་ངེས་ཅན་ཞིག་ཏུ་སེབས་འདུག་གལ་སིད།",
    "གཞིས་ལུས་བོད་མི་ཚོར་བློ་ཕམ་བྱ་མི་འཇུག་པ་ཞིག་བྱེད་དགོས་ཀི་འདུག་མ་གཏོགས་པས།",
    "དག་དགའ་གཉེན་སྡུག་བྱེད་རྒྱུའི་ལས་ཀ་དེ་ཚོའི་ཐོག་ལ་སྦུག་སྦུག་བྱས་ཏེ་གཞག་རྒྱུའི་དུས་ཚོད་ཡོལ་འདུག་བསམ་པ་ཞིག་སྙམ།",
    "ད་ནས་བཟུང་གནང་དགོས་རྒྱུའི་དུས་ཚོད་ལ་སེབས་འདུག་མ་གཏོགས་པས་དཀའ་ངལ་འདི་འད་ཞིག་ལ་རི་བོང་རོ་བརྫུས་བྱས་ཏེ་བསྡད་པ་ཡིན་ན།",
    "དེ་ལྟར་གནང་རྒྱུ་གལ་ཆེན་པོ་འདུག་དེ་འབོད་སྐུལ་ཞུ་རྒྱུ་གཅིག་ཡིན།",
    "དེ་ཚོ་ལའང་དཀའ་ངལ་མི་འདུག་ཁོ་ཚོ་ལ་གོང་རིམ་ཞིག་ནས་བཀའ་སོབ་ལམ་སྟོན་གང་འད་བྱས་པ་ཡིན་ན་ཕལ་ཆེ་བ་ཤར་བསྐྱོད་བྱས་ཏེ་འགོ་ཡི་འདུག་ཡིན་ནའང་ཡི་གེ་སྣ་ཁ་གཅིག་གཉིས་ཙམ་ཤེས།",
    "སི་འཐུས་ཙ་ནེ་ཚང་དོན་གྲུབ་བཀྲ་ཤིས་ལགས།",
    "འབྱུང་འགྱུར་བོད་སོབ་འཛིན་ཚོགས་ཀི་གཏན་ཉིན་སོབ་གྲྭ་༡༤ རིས་ལེན་ཞུ་གཏན་འཁེལ་བའི་སོབ་གྲྭ་ཁག་ཉམས་གསོའི་འགོ་གོན་སོར་ས་ཡ་༡་༥ རིས་ལོ་འདིའི་ནང་གསར་དུ་འཆར་འབུལ་ཞུས་འདུག་པས་བོད་སོབ་འཛིན་ཚོགས་ཀི་སོབ་གྲྭ་ཁག་རིས་ལེན་དང་འབེལ་བའི་འགོ་གོན་གཏོང་ཕོགས་ཇི་ལྟར་ཡིན་མིན་སྐོར།",
    "གཞན་རྣམས་རིས་ལོ་འདིའི་ནང་ལྷན་ཁང་ཁག་སོ་སོ་དང་འབེལ་བའི་ལས་འཆར་ནང་བཀའ་འཁོལ་ཞུས་ཡོད་འདུག་ཅིང་།",
    "༥ འགོ་གོན་བཏང་ཟིན་ཡོད་འདུག་༥།",
    "འཛིན་ཆས་འཕྲུལ་ཆས་གསར་ཉོ་སོགས་ལ་རིན་ཚད་འགན་བསྡུར་དང་ལས་འཆར་ཞིབ་ཕྲ་མེད་པ་གང་འཚམས་ཤིག་འདུག་པ་དང་།",
    "ཟུར་བཀོལ་དམིགས་བཀར་ལས་འཆར་བཅས་པར་ཕོགས་བསྡོམས་འགོ་གོན་དགོས་དངུལ་སོར་ས་ཡ་༢༤༣༩་༨ འཆར་འབུལ་གནང་འདུག་པ་དང་།",
    "སྔོན་རིས་ཡོང་དམིགས་བསལ་ལ་ཕན་པ་ཡོང་འཆར་སོར་ས་ཡ་༢་༧༦ བཅས་བཀའ་འཁོལ་བསྩལ་བའི་ཞིབ་གནས་མཉམ་འབུལ་གནང་འདུག་ང་།",
    "འབྱུང་འགྱུར་བོད་སོབ་འཛིན་ཚོགས་ཀི་གཏན་ཉིན་སོབ་གྲྭ་༡༤ རིས་ལེན་ཞུ་གཏན་འཁེལ་བའི་སོབ་གྲྭ་ཁག་ཉམས་གསོའི་འགོ་གོན་སོར་ས་ཡ་༡་༥ རིས་ལོ་འདིའི་ནང་གསར་དུ་འཆར་འབུལ་གནང་འདུག་ཉ།",
    "གཞན་ས་གནས་སུ་འགོ་གོན་ཇི་ཡོད་ཁུངས་སོ་སོ་ནས་གཞུང་འབེལ་མཐུན་འགྱུར་གནང་དགོས་སྐོར་བཀོད་མངགས་ཞུ་དགོས་པ་བཀའ་དྲུང་ཡིག་ཚང་ནས་ཕེབས་འདུག་ཀང་།",
    "ཞེས་པའི་རིས་འགོ་ཞིག་འཆར་འབུལ་གནང་འདུག་པ་ནི།",
    "ཞེས་རིས་འགོ་གསར་གཏོད་ཀི་ས་འཆར་འབུལ་གནང་འདུག་པ་མ་ཟད།",
    "བཀའ་ཤག་ནས་བཀའ་འཁོལ་རྒྱབ་གཉེར་གནང་འདུག་འདི་ནས་གཅོག་ཆ་ཞུས་མེད།",
    "དོན་དངོས་ཇི་ཡིན་རད་གཅོད་སྐབས་ར་ས་གཡས་གཡོན་དུ་སྣུམ་འཁོར་དེ་རིགས་ཉོ་ཡུལ་གཅིག་ལས་མེད་པ་དངོས་བདེན་ཡིན་འདུག་པས་མ་འོངས་འདི་ལྟ་བུའི་གནས་སྟངས་ཁ་གསལ་ཁུངས་སྐྱེལ་ཡོད་རིགས་ལ་གནང་ཕོགས་ཇི་དགོས་སྐོར་སིག་གཞིར་བསྐྱར་ཞིབ་ཀིས་ཁ་གསལ་དགོས་འདུག་༡༣།",
    "༢༡༧ ཟླ་༢ ཚེས་༡༦ ཉིན་བཀའ་དྲུང་ཡིག་ཚང་ནས་ལྷན་ཁང་ཁག་ཏུ་བཀོད་ཁྱབ་ཁ་གསལ་བཏང་འདུག་ཀང་།",
    "གཞན་གཅིག་འདི་ནང་ལ་འཁོད་མི་འདུག་སྟེ།",
    "ལྷག་པར་དུ་ཡི་གེ་བིས་པའི་སྐབས་སུ་གཟབ་གཟབ་གནང་དགོས་ཀི་འདུག་འཁྱུག་ཡིག་ནང་ལ་བ་དང་ཞབས་ཀྱུ་གཉིས་ལ་མཚོན་ན།",
    "དེ་ནས་མཚམས་བཞག་སྟེ་འོག་ཏུ་ཞབས་ཀྱུ་བིས་འདུག་ཞབས་ཀྱུའི་མགོ་དེ་ཡར་ཙམ་འཐེན་པ་ཡིན་ན།",
    "ཆིག་སིལ་ཟེར་མཁན་དེ་ཚོ་ཆིག་སིལ་མི་བྱེད་མཁན་ཆགས་ཀི་འདུག་དེ་ཡང་ཞུ་འདོད་བྱུང་།",
    "ཨ་རི་དང་ཡུ་རོབ་སྐོར་རང་རང་གསུང་དུས།",
    "ཉིན་མ་ཞིག་ལ་ཨ་རི་དང་ཡུ་རོབ་སྐོར་ལའང་འཐེན་འཁྱེར་ཆགས་རྒྱུའི་ཉེན་ཁ་འདུག་དེ་འད་ཞིག་ཚོར་བྱུང་།",
    "ད་དུང་ཡང་རྣམ་འགྱུར་སྟོན་དགོས་འདུག་ཤ་སྟག་གསུངས་ནས།",
    "དེ་འད་ཡིན་དུས་དེ་ཚོའི་ཐོག་ལ་དགོངས་བཞེས་གནང་དགོས་ཀི་འདུག་མ་གཏོགས།",
    "ཚུར་ལ་སྡང་སེམས་བྱེད་མཁན་ཞིག་འདུག་ན།",
    "དེ་ཡིན་དུས་ཞུས་ན་ཏག་ཏག་ཅིག་བསྡད་ཀི་མི་འདུག་སྙམ་ནས་ཞུས་མེད།",
    "འདི་ཚོ་མར་སྟོན་ཏེ་ད་ལྟོས་གདའ།",
    "མུ་མཐུད་ནས་སོབ་གསོ་དང་ལམ་སྟོན་མིག་དཔེ་ལྟ་འོས་པ་ཞིག་དགོས་འདུག་ད་ལྟ་བོད་པའི་སི་ཚོགས་ཀི་ནང་ལ་ཕི་མིག་ཞིག་བལྟས་པ་ཡིན་ན།",
    "མུ་མཐུད་ནས་ཤུགས་རྒྱག་དགོས་ཀི་འདུག་སྙམ།",
    "དེ་ཚོའི་ཐོག་ལ་འབུར་དུ་བཏོན་ནས་ཁིམས་འགལ་ཡིན་པའི་རྣམ་པའི་ཐོག་ནས་བཀག་ཐུབ་རྒྱུའི་འབད་བརོན་གནང་དགོས་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "རོག་ར་ཆིག་སིལ་དགོས་འདུག་ན།",
    "ཁོང་རང་ཉིད་ཀི་ངོས་ནས།",
    "ཚོགས་པ་གཉིས་མཉམ་རུབ་ཀི་སྟེང་ནས་ལས་ཀ་གང་འད་ཞིག་བྱེད་དགོས་པ་འདུག་ལྷག་པར་དུ་ད་ལྟ་དཀ་འ་ངལ་དེ་འད་ཞིག་འཕྲད་པའི་དུས་ལ།",
    "ག་དུས་ཡིན་ནའང་ཞུས་བསྡད་ཀི་ཡོད།",
    "ཐེངས་མ་བཅུ་གངས་ཤིག་ལ་སེབས་བསྡད་འདུག་ཡང་ནས་བསྐྱར་དུ་མཚན་སྨད་རབས་དང་རིམ་པ་བྱས་ཏེ།",
    "གང་ཞིག་ལ་གནོད་ཀི་འདུག་ཅེ་ན།",
    "ང་རང་འདོད་པ་མེད་ལ་དགའ་པོ་ཡང་མེད།",
    "དེ་ལས་བསྡོམས་ལྟ་བུ་ཆགས་གབས་འདུག་བཀུར་འོས་སི་འཐུས་ལགས་ནས།",
    "ཀླུ་མཁར་བྱམས་ཀི་སྐྱེས་དམན་དང་ཕྲུ་གུ་ལ་སོགས་པ་མེད་པ་བཟོ་རྒྱུའི་འཆར་གཞི་གཏན་ནས་མེད་ཅེས་མི་ལྔ་བརྒྱའི་མཚན་རགས་བརྒྱབ་ནས་ཡི་གེ་སེབས་འདུག་དཔལ་ལྡན་ཚོགས་གཙོ་མཆོག་ནས།",
    "ད་རྒྱ་དང་ས་གནས་ཁག་བཅས་ལ་བཅར་འདི་བྱས་པ་བཅས་ལ་ག་དུས་ཡིན་ནའང་།",
    "ཀླུ་མཁར་བྱམས་ལ་ཁོས་དངུལ་སད་དེ་སང་འདུག་ཟེར་བ་ལྟ་བུ།",
    "སྔོན་མ་གཟུགས་པོ་ཨའོ་ཙམ་ཡོད་པའི་སྐབས་སུ།",
    "སོ་སོ་སེར་དང་འབེལ་བའི་མང་པོ་ཞིག་ཞུས་བསྡད་ན་ཡག་པོ་མི་འདུག་བཀུར་འོས་སི་འཐུས་ལགས་ནས།",
    "སོ་སོར་མཚོན་ན་ཚད་ལས་བརལ་འདུག་སྙམ་པའི་སེམས་ཚོར་བྱུང་།",
    "ཆོད་སེམས་ལ་གུས་བཀུར་དང་ཆེ་མཐོང་རང་མཚོན་ཆེད་དུ་སྐད་ཆ་ཚིག་ཁ་ཤས་ཅིག་ཞུ་རྒྱུ་ཡིན།",
    "དེའི་ནང་ལོ་༡༡༣ ལ་བསྡད་དགོས་མཁན་དེ་ཁྱེད་རང་ཡིན་ཞེས་བིས་ཡོད་དུས།",
    "དེ་འད་ཡིན་དུས་ང་རང་ལ་ཆ་བཞག་ན་ཁོང་རང་དེའི་ནང་དུ་མེད་པའི་ཡིད་ཆེས་ཆ་ཚང་བྱེད་ཀི་ཡོད།",
    "གལ་སིད་ཨ་ཚོགས་ཀླུ་མཁར་བྱམས་ནང་མིར་དཀའ་ངལ་སད་མཁན་ནང་དུ་ཁོང་རང་མེད་ཅེས་གསུངས་པ་བཞིན་དེ་ལྟར་ཡིད་ཆེས་བྱེད་ཀི་ཡོད།",
    "དེ་ལབ་དུས་གཅིག་ཡོད་པ་དེ་ཁྱེད་རང་ཡིན་ཞེས་པ་དང་།",
    "འབེལ་བ་སྤུ་ཙམ་ཞིག་འདུག་གམ།",
    "ཞིབ་ཅིང་ཕྲ་བ་གཏིང་ཟབ་ཀི་ཐོག་ནས་བོད་ཀི་གནས་སྟངས་དེ་སྔ་དང་ད་ལྟ་བོད་མིའི་མངོན་འདོད་ཅི་ཞིག་ཡིན་པ་ཆ་ཚང་འདིའི་ནང་འཁོད་འདུག་ལ།",
    "དེ་བཞིན་གཏམ་བཟང་གཅིག་གཉིས་ཡོད་ཅེས་གསུངས་འདུག་རོགས་ཚོགས།",
    "ཞེས་བཀའ་ཕེབས་འདུག་དེ་ནས་དེའི་འོག་དེར་གང་བཀའ་གནང་འདུག་ཅེ་ན།",
    "དེ་ཡང་སྐབས་གོང་མའི་གོས་ཚོགས་ལྟར་མ་ཡིན་པར་ལེགས་བཅོས་ཆ་ཚང་ཞིག་གནང་ནས་ཧ་ཅང་ཡག་པོ་གནང་འདུག་སྐབས་གོང་མའི་གོས་ཚོགས་ཚོགས་དུས་སྐབས་ལ་ཡིག་ཐོག་ཏག་ཏག་བསྡད་མེད་པ་ཞིག་དང་།",
    "ང་རང་རིས་ཀི་ཐོག་ལ་སང་མྱོང་བ་ཞིག་མིན་སྟབས།",
    "མ་དངུལ་ཕོགས་བསྡོམས་ལ་ཧིན་སོར་༢༢༨༢ འདུག་འདི་ནང་ལ་སྔོན་རིས་མ་དངུལ་དེ་ཧིན་སོར་༦༩༡༨༡ དང་།",
    "འདི་དང་ཕི་ལོ་༢༡༤་ ༢༡༥ ལོར་གཏན་འཇགས་མ་དངུལ་དེ་ཧིན་སོར་༢༢༤༤ འདུག་འདིའི་ཐོག་ལ་འཕར་མ་ཧིན་སོར་༢༨༨༥ བསྡོམས་པ་ཡིན་ན།",
    "ཧིན་སོར་༢༥༢༨༩ ཆགས་བསྡད་ཀི་འདུག་འདིའི་ཐོག་ལ་ཕི་ལོ་༢༡༦་ ༢༡༧ ལ་འཕར་མ་ཧིན་སོར་༡༦༡ བསྡོམས་པ་ཡིན་ན།",
    "ཧིན་སོར་༢༦༣༥ ཆགས་བསྡད་ཀི་འདུག་ཞེས་ཞུ་རྒྱུ་ཡིན།",
    "ཡིན་ནའང་འདིར་༢༦༣༥༡ དེ་འཁོད་འདུག་ཞུ་རྒྱུ་ཡིན།",
    "གལ་སིད་དེ་ལྟར་ཡིན་ན་ཉུང་དག་འདུག་ཞེས་ཞུ་འདོད་བྱུང་།",
    "ནང་སིད་ཀི་ནང་ལ་སོ་ནམ་འདེབས་ལས་ཀི་ཐོག་ལ་དངུལ་འབོར་ཞིག་འདུག་སྟེ།",
    "སིར་བཏང་བུན་གཡར་དང་འབེལ་བའི་ཐོག་ལ་འདུག་སྟེ།",
    "དུས་དེ་རིང་ཐམས་ཅད་རྫུན་དུ་འདུག།",
    "ཨཱ་ལ་མི་ཚེ་ཟད་ནས་འཕྱིས་འདུག་གོ།",
    "ཐོས་དོན་རྒྱུད་ལ་སྦྱར་བའི་ཉམས་ལེན་བྱེད་མི་དཀོན་པས་དགོས་པ་མི་འདུག་སྙམ་ནས་བཞག་པའི་ཚེ།",
    "ཉམས་སུ་བླངས་ན་ཀུན་བཟང་རང་ཞལ་མཇལ།",
    "ཉིན་གཅིག་མདུན་འདུག་རྒྱལ་བ་བློ་གྲོས་ལ།",
    "འདི་ནི་འཇིགས་མེད་གླིང་པའི་ཡིན་པར་གདའ།",
    "རང་རང་བློ་ཡི་བརྟུལ་ཞུགས་ཆེ་ཆུང་དང་།",
    "པཎ་ཆེན་པོ་བེ་རོ་ཙ་ན་ཞེས།",
    "ཞེས་གསུངས་པ་ལྟར་རྒྱལ་བའི་ཐུགས་ཀྱི་བསྟན་པ་སྤེལ་བའི་དུས་སུ་ལོ་ཆེན་བེ་རོ་ཙ་ན་ཞེས་ཡབ་བ་གོར་དོད་དེ་རྒྱལ་བ་དང་།",
    "གསང་སྔགས་རྙིང་མ་བའི་བེ་རོ་ཙ་ན་ཞེས་སྔགས་སེམས་སྔ་འགྱུར་གྱི་བསྟན་པ་རྒྱ་ཆེར་རྒྱས་པའི་སྐབས་སུ།",
    "འཛམ་གླིང་རྒྱན་མཆོག་བེ་རོ་ཙ་ནའི་མཚན།",
    "ཞེས་གསུངས་པས་ཀུན་བཟང་ཞི་བའི་བསྙེན་མཚམས་ལ་འདུག་དགོས་གསུངས་ནས།",
    "འདུག་སའི་གནས་ལ་མཐོ་དམན་ཁྱད་པར་མེད།",
    "སྟེ་ཕྱི་སྤྲིས་མ་ལྟ་བུས་གཡོགས་ལ་ནང་ཤིན་ཏུ་སླ་བར་འདུག་པའོ།",
    "མེར་མེར་པོ་སྨིན་པ་ལས་ལྟར་ལྟར་པོ་སྟེ་ཕྱི་ནང་གཉིས་ཀ་སྤྲིས་མ་ལྟར་གྱུར་ཏེ་ཞོ་ལྟར་འདུག་ལ་ཤར་ནི་མ་གྱུར་པའོ།",
    "ཆོ་ག་བཞིན་དུ་འཐུང་བ་ཡང་རང་བཞིན་ལྔ་རིམ་གྱིས་འོད་གསལ་དུ་ཞུགས་པ་ལ་བྱའོ།",
    "སྣང་བའམ་སྟོང་པ་གསུམ་ནི་གཉིད་དང་བརྒྱལ་བ་དང་འཁྲིག་དུས་དང་འཆི་བའི་དུས་དང་ཏིང་ངེ་འཛིན་མཐུ་ལྡན་གྱིས་སྤྲོས་པ་ཐིམ་པར་བྱས་པའི་སྐབས་མ་གཏོགས་པ་རྣམས་སུ་མངོན་དུ་མི་འགྱུར་ལ།",
