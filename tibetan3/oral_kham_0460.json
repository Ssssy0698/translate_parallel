    "ཁོ་རང་གཉིས་མཐའ་གཅིག་ན་ཡིབས་ཡོད་ཙ་ན།",
    "དེ་ཙ་ན་པད་ཞུ་ནག་པོ་མཐའ་ཟེགས།",
    "འབྲིང་སྒྱུ་ལུས་སུ་འཕོ་འདི་དང་གཉིད་ཀྱི་རྣལ་འབྱོར་གྱི་སྐབས་གཅིག་པར་འདུག་སྙམ་ན།",
    "མི་སྒོམ་ཙ་ན་ཁ་བཅད་པས་རྡུལ་ལ་སོགས་པ་མི་འགྲོ་གསུང་ངོ།",
    "ཡིད་དང་རང་རིག་པའི་རྣམ་འབྱོར་བའི་ཤེས་པའོ།",
    "འབྲས་བུ་ཚུལ་གསུམ་པའི་རྟགས་དང་རང་བཞིན་ཚུལ་གསུམ་པའི་རྟགས་དང་།",
    "དེ་ལྟ་ན་འབྲས་བུ་དང་རང་བཞིན་དག་ལས་མི་དམིགས་པ་ཇི་ལྟར་ཐ་སྙད་ཅེ་ན།",
    "དགག་པར་བྱ་བ་དུ་བའི་གང་རང་བཞིན་དེ་འདི་མི་དམིགས་པའོ།",
    "འབྲས་བུ་མི་དམིགས་པ་ལ་སོགས་པའི་སྦྱོར་བ་བཅོ་ལྔ་པོ་འདི་རྣམས་ཀྱང་རང་བཞིན་མི་དམིགས་པའི་ངོ་བོ་ཉིད་ཁོ་ནར་རྟོགས་པར་བྱ་སྟེ།",
    "བལྟར་མི་རུང་བ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་བསྐལ་བར་ཡང་དག་པར་འབྱུང་ངོ།",
    "གཞན་ཡང་རང་བཞིན་པའི་འབྲེལ་བ་ཞེས་པའི་དོན་ཅི་ཞིག།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་མེད་པའི་ཕྱིར་རོ།",
    "ཐ་དད་ན་ཡང་རང་བཞིན་གྱིས།",
    "འདོད་པ་དེ་རྣམས་ཀྱང་རང་ཉིད་ཡོད་པ་ཉིད་ཙམ་གྱི་རྒྱུ་ཅན་ཡིན་པས་ཅིས་བྱེད་པ་མ་ཡིན་ན་ཞེས་པས་དེ་ཁོ་ན་འདི་ཉེ་བར་དམིགས་པ་ཡིན་ནོ།",
    "མི་ཚང་མས་ཁོ་སྨྱོས་འདུག་ཟེར།",
    "དེང་སྐབས་འདུ་ཤེས་སུ་ཡར་འདེགས་བྱས་ཤིང་འདུ་ཤེས་ཀྱི་ཆེར་བསྐྱེད་ཤེལ་འོག་ཏུ་བཅུག་འདུག་དོན་དངོས་སུ་རིགས་ཤེས་མ་ཡིན་པའི་ཉེ་རབས་བློ་རིག་རིང་ལུགས་ཀྱི་རྟོག་པ་འཆར་ཡན་གྱི་མཚོན་མདངས་ནི་འདི་ལྟར་བྱུང་བ་སྟེ།",
    "འགན་འཁུར་ཞིག་དུས་ནམ་ཡང་ཆབ་སྲིད་ཚོགས་པ་ཟེར་བ་ལ་ཡོངས་སུ་གཏོགས་པའང་མིན།",
    "ད་རུང་འདུ་ཤེས་འདིས་ནང་སེམས་ཀྱི་བདེ་སྙོམས་དང་རང་བཀུར་རང་ལ་ཡིད་ཆེས་བྱེད་པ་དེ་མངོན་འགྱུར་བྱེད་པ་ཡིན།",
    "ཁོང་རྣམས་དང་མཉམ་འགྲོ་མཉམ་འདུག་བྱེད་བཞིན་པས་འདྲ་མཉམ་ཡིནཔ་ལྟ་བུར་སྣང་ལ།",
    "དཔོན་པོར་འདུག་པར་འདོད་མཁན་ཚོས་ཏང་ལ་ཁ་ལོ་བསྒྱུར་བཞིན་ཡོད།",
    "མིན་ན་ཁོ་རང་ཕམ་མི་སྲིད།",
    "ཁོ་ཚོས་དགག་པ་རྒྱུག་པའི་དོ་ཟླ་རྣམས་ཀྱིས་སེམས་སུ་ཡང་རང་ཉིད་ཀྱི་མཐའ་མའི་དམིགས་ཡུལ་ནི་ཕུལ་དུ་བྱུང་བ་ཡིན་པར་འདོད།",
    "ཁོ་ཚོས་རང་ཉིད་འཆར་ཡན་རིང་ལུགས་ཀྱི་བསམ་ཚུལ་ཁྲོད་དུ་མྱོས་པར་བྱས་འདུག་མི་གཤིས་ཀྱི་ཐད་ནས་བལྟས་ན།",
    "བེ་རོ་ཙ་ན་ཞེས་སོ།",
    "ཨང་གའི་སྔགས་ནི་འདི་ཡིན་ཏེ་ཏྲི་ལོ་ཙ་ན་ཞེས་སོགས་སོ།",
    "སྔར་ལྟར་བསང་གཏོར་བྱས་ལ་རང་ཉིད་དཀྱིལ་འཁོར་དབུས་སུ་འདུག་ནས།",
    "ཁ་ཤར་དུ་བལྟས་ནས་ཀུ་ཤའི་གདན་ལ་འདུག་སྟེ།",
    "བདག་ཉིད་དང་བཅས་པ་ནུབ་ཕྱོགས་ཀྱི་སྒོར་འདུག་ནས།",
    "སྟན་མེད་པར་རྐང་བ་གཡས་པས་གཡོན་པ་མནན་ལ་འདུག་པར་བྱའོ།",
    "རིག་སྔགས་འཆང་རང་ཉིད་ཀུ་ཤའི་ཁྲེས་པོའམ།",
    "ཏ་མ་ལའི་ལོ་མའི་རང་བཞིན་ལས་བྱས་པ་ལ་སྔར་སྨོས་པའི་ཆོ་གས་གཅིག་པུ་དབེན་པར་འདུག་སྟེ།",
    "རིག་སྔགས་འབུམ་བཟླས་ལ་མདུན་དུ་ཨ་ཤྭ་ཐ་ལ་བྱས་པའི་རྩེ་གསུམ་ལ་ཉིན་མཚན་རྒྱུན་དུ་འདུག་སྟེ།",
    "དུར་ཁྲོད་ཇི་ལྟ་བ་བཞིན་དུ་རི་བོ་ལ་སོགས་པ་ལ་ཡང་གཅིག་ཏུ་དབེན་པར་འདུག་སྟེ།",
    "དུར་ཁྲོད་དུ་ཞག་ལྔ་འདུག་སྟེ།",
    "ཙོག་པུར་འདུག་ནས་བྱས་ན་གདོན་མི་ཟ་བར་ཟླ་བ་ཕྱེད་ཀྱི་ནང་དུ་ལུས་ཡོངས་སུ་འགྱུར་བར་བྱེད་དོ།",
    "དུར་ཁྲོད་དུ་འདུག་ནས་སྔགས་དེ་ཉིད་བདག་གནོད་སྦྱིན་དུ་འགྱུར་བར་མཛོད་ཅིག་ཅེས་པའི་སྐུལ་ཚིག་ཅནཇི་སྲིད་གནོད་སྦྱིན་དུ་འགྱུར་གྱི་བར་དུ་བཟླས་པ་བྱས་ཏེ།",
    "མྱ་ངན་མེད་ཀྱི་ཤིང་རྩ་བར་འདུག་སྟེ།",
    "རྟ་བྲིས་ནས་དེ་ཉིད་དུ་འདུག་སྟེ།",
    "ལྷ་ཆེན་ཕྱོགས་སུ་ཀུ་ཤའི་ཆང་བུ་ལ་རང་ཉིད་ཉེ་བར་འདུག་སྟེ།",
    "ལྷའི་གཞོན་པ་བཀྲིས་ནས་དེའི་སྟེང་དུ་འདུག་སྟེ།",
    "ཁྲོས་པས་འདུག་ལ་སྔགས་དེ་དག་བཟླས་པ་བྱས་ན།",
    "ཙོག་ཙོག་པོར་རྩྭ་བཏིང་བ་ལ་ཉེ་བར་འདུག་ལ།",
    "བཏིང་བ་ལ་འདུག་སྟེ།",
    "དབེན་པར་འདུག་ནས་བཟླས་པ་ལ་གོམས་པར་བྱེད་པའོ།",
    "མེ་ཏོག་སིལ་མ་བཀྲམ་པའི་སྟེང་དུ་འདུག་ནས།",
    "ལག་ནརལ་གྲི་ཐོགས་ནས་འདུག་ལ།",
    "ཚེས་བཅུ་གསུམ་གྱི་ཉིན་མཚན་རངས་སྒྲུབ་པ་བོ་རང་ཉིད་ལོ་འདབ་བཏིང་བ་ལ་མྱུར་བར་འདུག་ལ།",
    "ཚེས་བཅུ་གསུམ་གྱི་ཉིན་ཞག་སྨྱུང་བར་འདུག་ནས་སྒྲུབ་པའམ།",
    "པྲི་ཡཾ་ཀུ་ལ་སོགས་པའི་ཆུའི་ནང་དུ་འདུག་ནས།",
    "ༀདྷུ་ན་བཛྲ་ཧཱ་ཞེས་བཟླས་པས་ལས་ཀྱི་རྡོ་རྗེ་བཅང་ཞིང་ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་སརྦ་ཨཱརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཀུ་ཤའི་མལ་སྟན་ལ་འདུག་ཅིང་།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭ་ཧྭ།",
    "ལྷ་རྣམས་ཀྱི་བཞུགས་ཚུལ་དང་མཐུན་པར་རང་ཉིད་ཀྱང་འདུག་པ་དང་།",
    "བརྩེ་མེད་རང་རང་རིགས་ལ་བགེགས་ཀྱང་བྱེད།",
    "ཉལ་ན་གཞན་ཡིན་མེ་ཏོག་འདུག་པ་དང་།",
    "སྒྲུབ་པ་བོའི་མདུན་དུ་འདུག་ནས་སྨྲ་བ་ནི།",
    "ཀུ་ཤའི་ཁྲི་ལ་འདུག་ནས།",
    "གང་ཡང་རང་རྒྱལ་བསེ་རུ་དང་།",
    "སྔར་བསྙེན་པ་གྲངས་ཚད་བྱས་ཀྱང་མཚན་མ་མ་བྱུང་བ་དེ་ཡང་རང་ནས་སྒྲུབ་པ་བྱས་པ་ཉིད་ཀྱིས་འགྲུབ་པར་འགྱུར་རོ་དངོས་གྲུབ་ཀྱི་མཚན་མ་བརྟག་པ་ལ་རྨི་ལམ་གྱི་མཚན་མ་བརྟག་པ་ནི།",
    "ལྷ་ཁང་མཆོད་རྟེན་འདུག་ནས་རྒྱལ་བའི་གཟུགས།",
    "ཁ་ཤར་ཕྱོགས་སུ་བལྟས་པས་ཀུ་ཤའི་སྟེང་དུ་འདུག་ནས།",
    "སྟན་གཙང་མ་ལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ཏུ་གཞུག་གོ།",
    "མིག་ནི་རབ་ཏུ་དམར་ཞིང་ཟླུམ་པོར་འདུག།",
    "རང་རང་རིག་སྔགས་ཀྱིས་དང་བོར་མར་དང་སྦྲང་རྩི་ལས་སྦྱིན་སྲེག་བརྒྱ་རྩ་བརྒྱད་བྱ།",
    "གཞན་ཡང་རང་འདོད་པའི་ལྷ་རྣམས་སྤྱན་དྲངས་ནས་མཆོད་ཡོན་བཟླས་པས་བཞུགས་སུ་གསོལ་ནས།",
    "ལྷན་ཅིག་འདུག་ཀྱང་ཅིས་མི་ཚུགས།",
    "པདྨའི་སྟན་ལ་དཀྱིལ་ཀྲུང་ཕྱེད་ཀྱིས་འདུག་པའོ།",
    "ཀུ་ཤའི་གདན་ལ་འདུག་སྟེ།",
    "བཟང་བོའི་འདུག་སྟངས་ཞེས་བྱ་བ་རིམ་པ་ལྟར།",
    "ཡ་གཅིག་མདུན་དུ་བརྐྱང་བའི་སྟབས་ཀྱིས་འདུག་སྟེ།",
    "རྣམས་ཀྱི་བཞུགས་ཚུལ་དང་མཐུན་པར་རང་ཉིད་ཀྱང་འདུག་པ་དང་།",
    "མགྲིན་པ་ཟུར་བ་ལ་སོགས་པའི་འདུག་སྟངས་ཀྱིས་སྤྱན་དྲང་བར་བྱ་ལ།",
    "ཞེས་པས་པདྨའི་འདུག་སྟངས་ཀྱི་གདན་དང་།",
    "ཅེས་པས་དཔའ་བོའི་འདུག་སྟངས་ཀྱི་གདན་ཕུལ་ལ།",
    "ནུབ་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་པ་ལ།",
    "གདུགས་དང་བཅས་པ་ནུབ་ཕྱོགས་ཀྱི་སྒོར་འདུག་ནས།",
    "མིག་བགྲད་ཁྲོ་གཉེར་བསྡུས་སོ་ཤིན་ཏུ་གཙིགས་ནས་སྟན་མེད་པར་རྐང་བ་གཡས་པས་གཡོན་པ་མནན་པས་འདུག་པར་བྱའོ།",
    "དེ་ནས་ལས་སྔགས་བཟླས་པའི་སྤོས་ཆུས་འཐོར་འཐུང་ལན་གསུམ་བྱ་ཞིང་རང་ཉིད་ལ་དེས་བསང་གཏོར་ལན་གསུམ་བྱས་ནས།",
    "ཉི་མ་ལ་ཁ་བལྟས་ཏེ་བཟླས་བརྗོད་བྱས་ནས་ཉི་མ་མངོན་སུམ་དུ་བསམ་ན་མདུན་ན་འདུག་ཅིང་མཆོག་སྒྲབ་པ་དེ་སྦྱིན་པར་བྱེད་དོ།",
    "དེ་ནས་རིག་པ་འཛིན་པ་ཁ་ཤར་དུ་བལྟས་ཏེ་འདུག་ནས།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷི་ལོ་ཙ་ནཱི་སརྦ་ཨརྠཱ་ས་དྷཱ་ནཱི་སྭཱ་ཧཱ།",
    "ཀུ་ཤའི་མལ་སྟན་ལ་འདུག་ཅིང་།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནཱི་སརྦ་ཨནྟྲ་ས་དྷ་ནཱི་སྭཱ་ཧྭ།",
    "ཀུ་ཤའི་མལ་སྟན་ལ་འདུག་ཅིང་།",
    "ༀརུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིད་དྷ་ལོ་ཙ་ནི་ཨནྟྲ་ས་དྷ་ནི་སྭ་ཧྭ།",
    "ལྷ་རྣམས་ཀྱི་བཞུགས་ཚུལ་དང་མཐུན་པར་རང་ཉིད་ཡང་འདུག་པ་དང་།",
    "ཨ་ཙིད་ཏྱང་།",
    "སྒྲུབ་པ་བོའི་མདུན་དུ་འདུག་ནས་སྨྲ་བ་ནི།"
  ]
