    "དེ་ནས་བསམ་གྲུབ་རྩེར་སླེབ་དུས་སྐུ་མཚམས་པ་ཙམ་གནང་འདུག་སླེབས་ཉིན་ནས་བཟུང་སྟེ།",
    "སྐུ་དོག་ཡོད་པའི་ལྟས་རང་ནི་མིན་པ་འདུག།",
    "ཕྱོགས་དེ་སྔར་ལུགས་ཀྱི་འཛོམས་ཆ་ཆེན་པོ་བག་དྲོ་བ་དེ་ནི་མི་གདའ།",
    "སྐུ་སྐྱེ་བཅུ་བཞིའི་ཞལ་ཐང་གསར་བཞེངས་བཟང་པོ་མཛད་འདུག་པ་ལ་རབ་གནས་རྒྱས་པ་བྱས་དེ་ནས་བསམ་སྡིངས་སུ་ཞག་པོ་གསུམ་པ་ཞིག་བསྡད་དེ།",
    "གང་ཡིན་ངོ་ཤེས་པ་ནི་གཞན་མི་འདུག་གོ།",
    "དེ་རྗེས་འགྱངས་ཆེན་མེད་པར་རྗེ་འཇམ་གྲགས་པ་ཞུ་བའི་འབྲུག་པའི་དབུ་ཆེ་ཞིག་ཡོང་འདུག་པའང་།",
    "སློབ་བརྒྱུད་ཚོས་གོ་ནི་ད་དུང་མ་གོ་བར་གདའ།",
    "ཕྱོགས་གཞན་གྱི་ཀླུ་འགའ་ཞིག་འདིར་འོངས་པའི་རྟགས་སུ་ནི་གདའ།",
    "ལུགས་ཀྱི་སེམས་བསྐྱེད་ཆེན་པོ་དེ་མཛད་པ་སྔ་སྲོལ་དུ་འདུག་པ་བཞིན་བྱས།",
    "ཀྱེ་རྡོ་རྗེའི་འགྲེལ་པ་རྡོ་རྗེའི་ཚིག་བསྡུས་གཉིས་ཀའི་རྒྱ་དཔེ་འདུག་སྟེ།",
    "སྔ་མ་ལ་མཛད་བྱང་ནཱ་རོ་པའི་མཚན་འབྱར་བ་དེ་ཀ་འདུག།",
    "ཟེར་བ་འདུག་ཀྱང་རྒྱ་དཔེ་འདི་ན་སྙན་གྲགས་བཟང་པོའི་སྐད་དོད་ལ་ཡ་ཤོ་བྷ་དྲ་ཞེས་པ་མེད་པར།",
    "དཔང་ལོས་འགྱུར་བཅོས་མཛད་པ་ལ་ཡང་དེ་བཞིན་དུ་འདུག་ཀྱང་།",
    "ཅུང་ཟད་ཟི་བ་ཡང་ཡང་ཡོང་བ་ཞིག་བྱུང་འདུག།",
    "དོན་ལ་ཡང་གོ་བབས་ཤིན་ཏུ་བཟང་བའི་ཐུགས་རབ་ཁྱད་པར་ཅན་རང་ཡིན་པར་འདུག།",
    "དེའི་ནང་ན་བཤེས་འཕྲིན་ཡོངས་རྫོགས་ཀྱང་འདུག།",
    "སྔར་གྱི་འགྲེལ་པ་ཐམས་ཅད་ནི་བསྡུས་དོན་སྣ་ཟིང་སྤུ་ཟིང་ལས་ལམ་རིམ་རྐང་ཚུགས་མི་འདུག་པ་ལ།",
    "ཙནྡྲ་ཤིང་རྒྱལ་པོས་དུང་བཟང་པོ་གཅིག་ངེད་ལ་བསྐུར་གདའ།",
    "ཁོང་རང་དཔོན་སློབ་ཀྱི་འཕྲིན་ལས་ལ་བར་ཆད་ཀྱི་ལྟས་དུ་མ་མཐོང་སེལ་ཐབས་བྱས་ན་བར་ཆད་དེ་སེལ་བ་དཀའ་ལས་མི་འདུག་སྟེ།",
    "ཁོང་དཔོན་སློབ་ཚོ་རང་དགོས་དོན་མེད་པའི་འགྲན་ཟླའི་ཁུངས་རང་འདུག་པས།",
    "བཅོལ་གཏོགས་མེད་པ་དེ་བཞག་པ་རང་ལེགས་པ་འདུག།",
    "ལར་མི་འདི་རྣམས་ལ་ཕན་ཐོགས་བྱུང་ཚད་དེ་འཕྲལ་བརྗེད་འགྲོ་བར་འདུག།",
    "ཨོཾ་གཉིས་མ་མ་དག་ལོ་པཎ་ཡོན་ལ་མ་མགུ་བར་སྔགས་ཀྱི་གུང་ནས་བཅད་པ་ཡིན་ཟེར་བ་ཁོ་ན་འདུག་པ་ཡང་།",
    "འདི་དངོས་ནང་པའི་གཞུང་རང་ནི་མིན་པ་འདུག་ནའང་།",
    "བྱ་བ་ལ་སོགས་པ་འདུག་པ་ལ།",
    "ཁོང་རང་ཡང་མགུ་བས་རྒྱ་གར་དུ་ཐེགས།",
    "དང་པོའི་བརྣག་པ་ཞིག་ཐུགས་ལ་ཡོད་པ་ལོས་ཡིན།",
    "མགོན་པོའི་བཞུགས་ས་བྱེད་རྒྱུ་ཡིན་བྱས་པ་ཙམ་གྱི་བདག་བྱེད་པར་འདུག།",
    "ལོ་སྔ་མ་གསུམ་གཞུང་དང་མཆོད་བཞིས་གཉིས་ཀར་ལོག་ནས་བྱས་པ་དང་གྲུབ་ཆེ་ཆུང་རང་ཁྱད་ཆེན་མ་བྱུང་།",
    "དེ་རྫུན་མ་ཡིན་པར་བདེན་པར་འདུག་ངོ་མཚར་ཆེ་ཟེར།",
    "སྤྱིར་སྐུ་རིམ་རྒྱ་ཆེ་བ་གནང་འདུག།",
    "གཡོན་ན་དེ་ཙམ་དམར་པོ་ཞིག་འདུག།",
    "དཀར་པོ་དེའི་ཡང་གཡས་ན་སེར་པོ་ཞིག་འདུག་བྱམས་པ་ཡིན་སྙམ།",
    "གཡོན་རང་ན་སྔོན་པོ་ཞིག་འདུག་པ་དེ།",
    "ང་འཕགས་པ་ཀུན་ཏུ་བཟང་པོ་ག་ན་བཞུགས་སྙམ་ཙ་ན།",
    "ཡི་དམ་མཐོང་ཡང་ནམ་མཁའི་འཇའ་ཚོན་གྱི་ཚུལ་དུ་འདུག།",
    "རོ་མཉམ་གཅིག་ལ་ཁྱད་པར་གང་ཡང་མི་འདུག་ཀྱང་།",
    "ལར་དུས་ཀྱང་ཤིན་ཏུ་ཐ་མར་སླེབས་པའི་ལྟས་ལོས་ཡིན་ཡོད།",
    "ཕྱིས་བློ་ལ་འཇགས་པ་ནི་མ་བྱུང་འདུག།",
    "སྤྱིར་ཡན་ལག་ཕྱི་མ་རྣམས་ཀྱི་ལག་ལེན་འདི་ཤིན་ཏུ་བཀའ་གཉན་པར་འདུག།",
    "བྲེལ་བ་མང་པོ་དང་ཡང་ཐུག་པ་གཅིག་ཀ་ཡོང་བ་འདུག།",
    "ཁམས་ཕྱོགས་ལ་འབྱོན་པའི་བློ་རྩེ་བྱས་འདུག་ཀྱང་།",
    "འབྲི་གུང་ཙམ་ནས་ཤིན་ཏུ་བསྙུང་བའི་ཚུར་ལོགས་སྐྱིད་ཤོང་བྲག་དཀར་སྐེར་དུ་གཤེགས་འདུག།",
    "ནུབ་ཕྱོགས་ནས་ཡེ་ཤེས་སེམས་དཔའ་དངོས་སུ་བྱོན་པའི་རྣམ་པར་འདུག།",
    "སྔར་གྱོད་ཁ་ཆེ་བ་ཞིག་ཡོད་པ་ངེད་རང་སང་འགྲོ་བ་འདུག།",
    "འགོང་པོ་དགའ་བའི་རྣམ་འགྱུར་དུ་ཡོང་བ་འདུག།",
    "འགའ་ཞིག་ལ་ཆེ་འདོན་བྱེད་པའི་སྲོལ་འདུག་ཀྱང་།",
    "ཆོ་ག་འདི་བྱེད་ཀྱི་ངེས་པ་མི་འདུག་ནའང་།",
    "མི་ཚོགས་དང་གྲགས་པ་ཆེས་པས་འདྲེ་མི་མ་ཡིན་མང་པོ་འདུས་སམ་སྙམ་པ་འདུག།",
    "རྙིང་པ་བཀྲག་མདངས་གཟི་བརྗིད་ཅན་མང་པོ་ལོག་འགྲོ་བའི་རྣམ་པ་འདུག།",
    "འདི་སྐབས་ཐུགས་བྲེལ་ཤིན་ཏུ་རང་ཆེ་བའི་སྐབས་སུ་འདུག་ཀྱང་།",
    "བཙུན་པ་ཀུན་ལ་འདི་འདྲའི་འདུན་པ་བྱུང་ན་འཚེད་པ་གདའ་སྟེ།",
    "བོད་ན་བཙན་བཙུན་མང་ཉུང་རང་ད་ལྟ་ཡང་ལྕོགས་ཙམ་གདའ་སྟེ།",
    "གྲུལ་བཏུབ་དེ་ཡེ་མི་གདའ།",
    "བསྟན་པ་གནས་པ་བྱ་བ་དེ་འདྲ་ལ་ཟེར་བ་ཡིན་པར་གདའ།",
    "ལྟས་ནི་ཤིན་ཏུ་འཚུབ་པར་འདུག།",
    "ཁོང་རང་ལ་ནི་ཞུ་མཁན་མ་བཏང་།",
    "ངེད་དང་འཕྲད་དགོས་པ་འདུག་གསུང་བ་ཞིག་ཡང་ཡང་བྱུང་ཡང་།",
    "བཤགས་པ་བྱེད་གསུང་པ་ལྟ་བུའི་ཁ་གསལ་ཅན་གང་ཡང་མི་འདུག་པས།",
    "ཟླ་བ་དེ་ཀ་ལ་བྱས་ན་ཕྱོགས་ནས་ཡོང་མཁན་རྣམས་དུས་ཐུག་སྟེ་མི་འཆོམས་པར་འདུག་པས།",
    "ཅི་མིན་གྱི་རྒྱུ་འགྲུལ་རིམ་པོ་ཁོག་ངན་བློ་ཉེས་དེ་ཚོ་ལ་མཁོ་ཡང་མཁོ་བར་གདའ།",
    "ཐ་ན་འདིའི་བྲིས་ཐང་ཙམ་ཡང་དཀོན་པར་འདུག་པས།",
    "གང་ཅིའི་ཁྱད་ཙམ་འདུག་པས།",
    "རྐྱེན་གྱིས་ལོག་འགྲོ་བ་ལ་ཚེགས་མི་གདའ།",
    "ཡང་ཞོལ་ན་ཐོར་པ་ཅུང་ཟད་འདུག་པས་དཔོན་ས་ཨ་ལྕེའི་དྲུང་ལ་ཕྱིལ་བསངས་ན་རང་ལེགས་ཞུས་ནའང་།",
    "དེར་སྐྱེ་བ་ལེན་པ་ཡིན་ནམ་སྙམ་ཙ་ན།",
    "འཇམ་དབྱངས་ཚུལ་བཟང་བ་གྲིབ་ཀྱི་རྣམ་པས་ཁམས་ངན་པར་འདུག་ཅིང་།",
    "ཕྱ་བཀའ་བཅུ་པ་ཡང་བསྙུང་གཞི་བརྫི་བར་འདུག་པ།",
    "ཞབས་དྲུང་རྒྱལ་བུའི་དྲུང་དུ་འབྲུམ་པ་བྱུང་དོགས་སོགས་འདུག་ཀྱང་།",
    "ཡོན་བདག་ལ་ལྟ་བར་འདུག།",
    "ད་ལྟའི་ཞོ་བརྒྱ་ཡང་ཞོ་བརྒྱ་སྒྲུབ་རྩོལ་དཀའ་ངེས་ཤེས་པ་ཡིན་འདུག།",
    "ཁྱེད་རང་རྣམས་ཀྱང་སོ་སོ་ནས།",
    "འཇིག་རྟེན་གྱི་ལན་བཏབ་དུས་ནག་སྤོབ་སྤོབ་ཁ་རོག་སྡོད་པར་འདུག།",
    "སྤྱིར་ཁོང་རྣམས་དེ་སྐད་ཟེར་བ་ལ་རྒྱུ་གཉིས་འདུག་སྟེ།",
    "གཅིག་ནི་རང་རང་སོ་སོ་ན་རང་བཟང་པོ་དཔེ་མེད་ཡིན་པར་འདོད་པ་ལ་དགེ་ལས་གང་ཡང་མ་གྲུབ།",
    "གཞན་ཚོ་མཐའ་ཕྱི་ཐམས་ཅད་བསྐོར་ནས་སྡོད་ཀྱིན་འདུག་པ།",
    "འདྲེའི་ཁ་ཕྱོགས་པས་མི་ཕྱུགས་ཀུན་གྱི་སྲོག་དང་ལོངས་སྤྱོད་ལ་ཕན་པར་འདུག།",
    "སྨྱོ་ཞུགས་པ་ཡིན་ནམ་སྙམ་པ་བྱེད་ཀྱིན་འདུག།",
    "ཕུལ་ནས་ཀྱང་ཚུར་སྡུད་པར་གདའ།",
    "སྐྱེ་བོའི་སྦྱིན་གཏོང་ལྟ་བུ་ལ་ཅུང་ཟད་བློས་ཐོངས་པར་གདའ་སྟེ་ཟ་མཁན་དངོས་སུ་འདུག་པ་ལ་ཡིད་ཆེས་པས་ཕན་ཡོན་ལ་བསམ་པ་ཡང་འདུག།",
    "འདི་ལོག་ལྟའི་ཞད་ཆེན་པོ་ཡིན་པར་འདུག།",
    "སྟོན་དུས་ཀྱི་འབྲུག་སྒྲ་བཞིན་དུ་སྒྲ་འུར་ཁོ་ནར་འདུག་ན།",
    "དད་པ་ཅན་ཡིན་ངེས་ཤེས་པ་དེ་ཡིད་བཞིན་ནོར་བུ་ལས་ཀྱང་དཀོན་པར་གདའ།",
    "དེ་མིན་སྐུ་དོག་ཆེ་བ་འདུག་ཚུལ་སོགས་ཞུར་བཏང་བ་ལ།",
    "མི་ངན་གཅིག་མཇལ་བས་ཉིན་བསླངས་འདུག།",
    "ཚེས་བཅུ་ཙམ་ནས་སྐུ་ལྟེམས་པ་ད་དགོས་ཐོར་བ་ཡིན་པ་འདུག་ཅིང་།",
    "སྐྱོན་ཆེ་བ་རང་མི་འདུག་ནའང་།",
    "དགོས་དུས་མི་ཕན་པ་ཟེར་ནས་ཐམས་ཅད་ཁ་གཏོང་བར་འདུག།",
    "དེ་སྐབས་སྐྱོན་ཡང་མ་བྱུང་འདུག།",
    "རྒྱལ་རྩེ་བདག་པོའང་དེ་རྗེས་སྐུ་འདས་ནས་མ་མཇལ་བར་གདའ།",
    "དགོངས་རྫོགས་ལ་ནི་ཕེབས་འདུག།",
    "དེས་མཚོན་ཡང་སྒོས་སུ་ཡང་འདི་སྐབས་ལྟས་ཤིན་ཏུ་ངན་པའི་ཕན་ཐོགས་ཤིག་མི་ཡོང་བ་འདུག་པ་དང་།",
    "དེ་སྐབས་ཚེས་བཅུ་ལ་གསང་བརྡོལ་བའི་རིགས་ཡིན་པར་འདུག།",
    "དུང་རྒྱ་གླིང་དར་འཕྱར་སོགས་གཟབ་ཤོམས་དུ་མ་དང་བཅས་ནས་དགེ་སྡིངས་སུ་ཕེབས་པ་མཐོང་འདུག།",
    "གང་མཇལ་མཇལ་དུ་འཕྲད་ཡོང་དགོས་ཚུལ་ཕེབས་པར་འདུག།",
    "ཕྱིས་ཀྱང་བཀའ་བློན་རྒྱུས་ཡོད་ཚོ་ཡང་དོལ་ལ་ཕེབས་པ་ལ་ནི་ཐུགས་རྟོག་ཅིག་ཀྱང་ཡོང་འདུག་ཟེར་བ་ཞིག་འདུག།",
    "དུག་ལིངས་བྱུང་བ་ཡིན་པར་འདུག།",
    "ལ་ལ་ཕྱིར་གསེང་བའི་ཁུངས་བྱེད་འདུག་སྟེ།",
    "སྤྲེའུ་ཡོས་རྐུའི་རྣམ་པ་ལས་མི་འདུག་ཀྱང་།",
    "རྩེར་མ་བྱོན་པ་ལ་དངོས་དགའ་བའི་རིགས་ཡིན་པར་ཡང་འདུག།",
    "སྔར་མགོན་ཁང་ཞིག་ཡོད་པ་བར་སྐབས་སུ་བདག་རྐྱེན་ཆུང་བའི་སྐྱོན་ལ་ཐུགས་རྟོག་ཀྱང་ཅུང་ཟད་འདུག།",
    "ཁ་ནས་ཀྱང་སྨྲ་བར་འདུག་སྟེ།",
    "དེ་མིན་བྱུས་མཐའ་ནས་བསྡུས་འགྲོ་བར་འདུག།",
    "པེ་དཀར་ཁོ་ན་ཡིན་པ་འདུག།",
    "མགོ་ཐོག་ཏུ་ནི་བབས་འདུག་གོ།",
    "དེ་མིན་འདྲེ་དྲག་ཤས་ཁོ་རང་དང་མུ་མ་འབྱོར་བའི་སྔོན་ལ།",
    "འོ་འཇིག་རྟེན་པའི་ཚུལ་བཟུང་བ་དེ་ཁོ་འཇིག་རྟེན་པའི་ཚུལ་འཛིན་དགོས་ཙ་ན།",
    "ཚུལ་དེ་འཇིག་རྟེན་པ་རང་དུ་འདུག་ན།",
    "དེ་ལ་ཁོ་བོས་སྡང་ཤུགས་བྱས་པ་འདྲ་སྙམ་པའི་དོགས་པ་མི་དགོས་སར་བླུན་དཔྱད་ཀྱི་དོགས་པ་ཞིག་ཤར་བར་འདུག།",
    "སྔ་ཕྱིའི་ཆ་རྒྱུས་ཅི་ཡང་མེད་པ་ཚོ་ཞིག་གཞན་ལས་སྨྲ་མཁས་པ་གདའ་བ་ཨང་།",
    "པེ་ཧར་ཆེན་པོ་དྲག་ཤུལ་ཅན་ལོས་ཡིན།",
    "བརྟེན་ཁང་དུ་པེ་དཀར་གྱི་གཏོར་བཞི་རྟེན་རྫས་སོགས་བཅའ་བ་མཛད་འདུག།",
    "རྒྱལ་ཁང་རང་ལ་སྤོས།",
    "སྤེའུ་སྟོད་སྨད་གཉིས་འདུག་པའི་འོག་མ་དེ་ན་ང་རང་འདུག།",
    "མགོན་ཁང་བཙུགས་པ་ལ་ཁོང་ཤིན་ཏུ་མ་མགུ་བར་འདུག།",
    "འདི་སྐབས་ཚེས་བརྒྱད་ལ་དིངས་སུ་ཤྭ་སྐྱོན་ཆེན་པོ་བྱུང་བའང་དམག་བྱུས་ལ་བལྟ་བར་འདུག།",
    "སྨྲས་ན་བདེན་སྙམ་པ་སུ་ལའང་མི་ཡོང་བ་འདུག།",
    "ཉམས་སྣང་ཡང་མི་འདུག་སྟེ་བླ་རྡོ་ཉར་མ་བྱུང་བར་མི་ལག་ཏུ་ཤོར་བའི་ཉམས་ཤིག་ཡོང་ཉེན་གདའོ།",
    "ཁོང་རང་སླེབས་པ་ནས་བཟུང་ནས།",
    "སྔ་སོར་ཞབས་དྲུང་གོང་མ་དེའི་དགོངས་གཏད་དུ་འདུག་པ་ངེད་ཀྱིས་བྲིས་ཡིག་ཀྱང་བྱས།",
    "ཞབས་དྲུང་དེ་ཉིད་སྐུ་བཞུགས་དུས་རྟག་བརྟན་དུ་གནང་བའི་དགོངས་བརྟད་དང་བཀའ་བཀོད་གནང་བ་ཡིན་འདུག།",
    "མཁའ་འགྲོ་རྒྱ་མཚོའི་འཁྱུད་ཡུམ་ཞལ་བཞི་ཕྱག་བཅུ་གཉིས་པ་བྲིས་འདུག་པའང་རྒྱུད་དང་མཐུན།",
    "དགྱེས་རྡོར་གྱི་རིགས་ཚོ་ཡང་བཀྲམ་གདན་ཁོ་ནར་བཞེངས་འདུག།",
    "བློ་གྲོས་ཕུར་ཁུང་ཐུག་པ་མ་ཡིན་པའི་རྣམ་འགྱུར་ཚོར་འདུག་པས།",
    "དེ་སྐབས་བཀའ་གྲོས་པ་ཚོ་དགོངས་རྫོགས་ཆོག་གྲྭ་སོགས་ལ་མྱོང་བ་ཆུང་ཞིང་ལྷུས་མི་ཐིངས་པ་ཞིག་འདུག་པ་ནས།",
    "གྲོལ་མཚམས་གདུད་ཆོག་བྱེད་དགོས་འདུག་གསུང་བ་བྱུང་བས།",
    "གདུང་ཆོག་བསྙུར་དགོས་པ་འདུག་པས།",
    "རྩིས་པ་ཚོ་ཡང་སྨྱོན་པའི་བརྟུལ་ཞུགས་འཛིན་པ་དེར་འདུག།",
    "འོན་ཀྱང་དགོངས་རྫོགས་དངོས་གཞིའི་དུས་ཐོག་དེ་ལ་འཁྲོལ་འདུག་པ་དང་།",
    "ཟླ་གཅིག་སྔ་བསྣུར་བའི་ཁུངས་སུ་འདུག།",
    "གཅིག་ཁོ་ནར་མི་གདའ།",
    "ཐོར་པས་མི་འགྲོངས་པར་འདུག་སྙམ་ནས།",
    "དུག་སྦྱོར་བྱུང་བ་ངེས་ཅན་དུ་འདུག།",
    "དེ་ལོ་ཡང་སྐུ་རིམ་མང་པོ་མཛད་གདའ།",
    "ཞེས་པ་དེར་གདའ།",
    "ཕུ་དཀྲུགས་མདའ་དཀྲུགས་རང་ཀ་བྱེད་པ་མང་བར་འདུག་གོ།",
    "གནང་སྒོ་མ་ལེགས་ཚུལ་མང་པོ་གླེང་བར་འདུག།",
    "ཡང་ཟེར་རིགས་འདི་ལ་དཔགས་ན་ག་འདྲ་ཡིན་ཡང་མི་ཤེས་པ་འདུག་བསམ་པའང་བྱུང་།",
    "མི་སྡོད་མཁན་ཚོས་སྡོང་ཡུལ་ལ་ཐེས་མེད་བྱེད་པ་འདི་ཚེ་ལོ་བཅུ་པ་ཧབ་རྒྱུགས་བྱེད་མཁན་ཀུན་གྱི་སྤྱི་ལུགས་སུ་འདུག།",
    "ཁྱེད་རྣམས་སྒོས་སུ་བློ་སྐྱོག་མི་དགོས་པ་འདུག་སྙམ་པའང་ཤར།",
    "ལོངས་སྤྱོད་དང་ཁ་དྲག་པོ་ནི་ང་རང་ལ་ཡོད།",
    "འཇིག་རྟེན་ཕལ་པ་ལ་ཕན་བཏགས་པ་ལ་འབྲས་བུ་དེ་ཀར་འདུག།",
    "གྲྭ་སར་ཡར་མར་ན་ནི་འདུག་རྩེ་རང་ན་གོས་སྐུ་མི་བཞུགས།",
    "ངེད་ལ་འདི་དུས་དོན་དག་ནི་མ་གྲུབ་པ་དེར་འདུག།",
    "ཉང་སྟོད་སྟག་ཙལ་གྱི་ཐད་སྨད་པ་ཚོའི་མི་ངོ་ལ་གསལ་པོར་བྱུང་འདུག་པས།",
    "དེ་རྗེས་བར་སྐབས་སུ་ཐུགས་གཏོང་ས་ཅུང་ཟད་འགྱུར་བའི་ཆ་ཤས་ཤིག་བྱུང་ཡོད་འདུག་པས་པར་ཤུན་གཙང་དུ་འབུལ་དགོས་བྱུང་བ་དེར་འདུག།",
    "གཙང་ཀུར་འཛིངས་པ་འདི་ཚོ་ལ་གཙོ་བོར་ཞྭ་དམར་ནག་བཞུགས་འདུག་སྟེ་ཁྱེད་ཀྱིས་ཀྱང་ཕན་འདོགས་བྱེད་དགོས་རྒྱུར་འདུག།",
    "སྔར་ཤུལ་རང་དཀའ་བ་འདུག་སྟེ།",
    "ལར་མི་ཆེན་གྱི་རིགས་ཚོ་རིམ་གྲོ་དཀར་ཕྱོགས་སྲུང་འཁོར་ལ་རྩོལ་འདོན་དགོས་པའི་རིགས་སུ་འདུག་གོ།",
    "དར་མ་ཙ་ན་དད་པ་ཡལ་ནས་སོལ་བའི་ཕྱེ་མ་ལྟར་ནག་ཐིབས་ཀྱི་འགྲོ།",
    "ཡང་ལ་ལ་དར་བབས་ཙ་ན་རྣམ་དཔྱོད་དང་ལྡན་ཞིང་གར་སླ་འཚམ་པ་ཞིག་ཡོད་པ་དེ།",
    "ན་ཚོད་ཅུང་ཟད་སྨིན་ནས་འབྲེལ་མེད་ཅལ་ཅོལ་འབའ་ཞིག་ཏུ་འགྲོ་བ་ཞིག་ཀྱང་འདུག།",
    "རྒན་འཆལ་སྔ་ཤོས་དེ་ལོ་ཉི་ཤུ་རྩ་གཉིས་ཙམ་ནས་ཡོང་ཟེར་བའི་དཔེ་དེར་གདའ།",
    "དང་པོ་རང་བཞིན་བཟང་བ་ཞིག་ཡོད་པ་དེ་མ་འགྱུར་ན་དགའ་སྟེ་འགྱུར་འགྲོ་བ་ཞིག་འདུག།",
    "ལར་མི་འགྱུར་བ་རང་དེ་སེམས་ཀྱི་གནས་ལུགས་རྟོགས་པ་དེ་རང་ཡིན་པར་གདའ་ལགས།",
    "ཞུད་ཁ་ཡང་མང་བར་འདུག་ཟེར་བས།",
    "འོ་ན་སྐུ་གལ་ཆེ་ཙ་ན་ཡོང་དགོས་བྱས་ཏེ།",
    "བརྟག་པའི་འཆར་སྒོ་ལ་ཉེས་སྐྱོན་ཡེ་མེད་ཅིང་ལེགས་པར་འདུག་ནས།",
    "བརྟག་པ་ཞུ་བ་གནང་ཡོད་འདུག་པས་དབུས་ལ་ཕེབས་པ་མ་ཆུག་ཚུལ་ཞུ་དགོས་ཟེར་བ་ལ་བརྟག་པའི་གནས་ཚུལ་ཞུས་གྲུབ་ཚུལ་ལབ།",
    "ཁོང་རང་ཡོན་མཆོད་ཚོ་ལ་དེ་རང་ཡོང་འདུག་པས་ཡིན་ནམ།",
    "བཤོལ་འདེབས་ནན་ཆགས་བྱེད་དགོས་ཟེར་ཡང་ཡང་ལབ་ཀྱིན་འདུག།",
    "རྫུན་བྱེད་རྒྱུ་ཡིན་ན་བརྟག་པ་བྱེད་དོན་ཡང་མི་འདུག་གོ།",
    "ངེད་གནང་ཆུང་ཡིན་ཙ་ན་ལར་གྱི་ཡང་གསན་པ་ཀོག།",
    "སྒོས་སུ་ཁྱེད་རང་རྣམས་ཀྱིས་ངེད་ཀྱིས་ཞུས་པའི་རིགས་ལ་གསན་དགོངས་མཛད་ན་ཡེ་མི་ཡོང་ཚུལ་རྒྱུན་མི་འཆད་ཕུལ་ནས།",
    "གཞན་སྤྲ་ལག་པ་མཁས་འཇུག་མཁན་མང་པོ་ཡང་དེ་ན་སླེབ་འདུག།",
    "མུན་མུན་སྟོང་ཆང་ཆང་ཞིག་བྱུང་འདུག།",
    "སྭ་ལག་ཟེར་དུས་མར་ཕྱོགས་སུ་སླར་དམ་པོ་བྱེད་པ་ལ་ཁྲིད་གཉེར་ལག་ལེན་རྒྱུ་ཡོད་པ་ཞིག་དགོས་པར་འདུག་ཟེར་བ་ལ་སྙད་བྱེད་ཀྱིན་འདུག་སྟེ།",
    "མི་ཉན་པ་ལ་ཁ་ཏའི་དཔེར་འདུག་པས།",
    "སྡོད་ཉིན་མི་འདོད་པར་འཕྲལ་དུ་ལས་ཀ་ལ་འཇུག་འདོད་པ་རང་བྱུང་འདུག།",
    "སྔ་མ་ཞག་ལྔ་ཙམ་ལས་མི་བཞུགས་པའི་རྩིས་སུ་འདུག་ཀྱང་།",
    "གཞན་འདི་འདྲའི་རིགས་ལ་རང་འདོད་ཀྱི་ཞུ་དོན་མང་པོ་དབུ་ཚུགས་མུ་ཚུགས་བྱེད་པ་ཞིག་ཡོད་པར་འདུག་སྟེ།",
    "བྲག་རམ་དང་ཉེ་བའི་ཐད་ཙམ་ལ་ནམ་མཁའ་ལ་འཇའ་སྤྲིན་རྒྱ་བྱའི་གཟུགས་ཀྱི་རྣམ་པ་གསལ་པོ་བྱུང་འདུག།",
    "དེས་ལོ་ཤས་ཀྱི་སྐུ་དོག་ཀྱང་སེལ་གདའ།",
    "ཡིན་ཡང་ཡིན་པ་འདུག།",
    "དེར་འཚོགས་ཐམས་ཅད་ཀྱིས་མཐོང་འདུག།",
    "དཔལ་རབ་ཀྱི་ཡིན་འདུག་པའི་སྔགས་ཐང་ཉི་ཤུ་སྐོར་ཞིག་སྟོན་པའང་གནང་།",
    "བཀའ་རྒྱུད་ཕོ་ཁྲོམ་ཚར་གཉིས་བཞེངས་པ་མཛད་འདུག།",
    "ཙན་དན་སྐྱེ་ལ་ཁད་ལ་སྲེད་དེ་མར་འགྱུར་གདའ།",
    "ཉང་སྟོད་གཞུང་ན་མར་ཡང་སྔགས་སྐུ་བཞེངས་ན་འཚུབ་ཡོང་ཟེར་བའི་ཁ་སྐད་ངན་པ་ཞིག་འདུག།",
    "ད་རྣ་མཆོག་ཏུ་ཁྱེར་བའི་སྔ་སོར་ནས་བོད་གོང་བ་སོགས་མང་པོའང་ཡོལ་ཐང་ཚུན་ཆོད་ལ་སྔགས་སྐུ་འདི་འཚུབ་གྲགས་པས་སྔགས་སྐུ་མེད་པ་རང་ཞིག་དགོས་ཟེར་གྱིན་འདུག།",
    "དེ་ཙ་ན་སྔགས་སྐུ་བཞེངས་ཀྱི་དོགས་ནས་འདི་ལ་འཚུབ་ཡོང་ངོ་ཞེས་གདུག་འདྲེས་བསྒྲགས་པའི་གཏམ་དེ།",
    "ནུས་མཐུ་ཕན་ཡོན་འདྲ་ཆེན་པོ་སུ་ལའང་མི་འདུག་སྟེ།",
    "སྔགས་ལ་ད་ལྟའང་ཅུང་ཟད་ཙམ་ཡོད་གཞན་ཚོ་ལ་མི་གདའ་བ།",
    "ཕྱག་ཆེན་དང་ཀ་མ་ལ་ཤཱི་ལའི་ལུགས་གཅིག་ཟེར་བ་སོགས་རྒྱལ་པོ་དམངས་སུ་འབེབས་པ་མང་པོ་འདུག་སྟེ།",
    "གྲྭ་རིགས་གྲོགས་མཆེད་མང་པོ་ཞིག་ནི་དྲི་ལོག་སྟེ་སྡོད་པར་འདུག་སྟེ།",
    "ཁག་ངན་འཁུར་དགོས་དང་དཀའ་ལས་ཡོང་གྲབས་འདུག་ན་འཁོར་མི་ཐེབས།",
    "དེའི་ཕྱིར་དུ་ཚོགས་པ་སྐྱོང་རིན་ཆོག་གསུང་བ་ཞིག་འདུག་པ།",
    "བཀའ་བརྒྱུད་པའི་སྒོམ་ཆེན་གོང་མ་འདི་ཚོ་ཐུགས་ལྷུས་ཐིངས་པའི་གསུང་བགྲོས་གཏན་ཚིགས་ཅན་རང་ཡིན་པ་འདུག།",
    "ཡིན་ནི་བྲག་དཀར་མགོན་པོའི་བཀའ་ཆད་རང་ཡིན་པ་འདུག་མ་ཕྱོགས་ཀྱི་རྒྱལ་ཞུད་ཡིན་ཟེར་བ་ཞིག་ཀྱང་འདུག་སྟེ།",
    "དེ་ཡང་རང་བཞིན་འཕོ་འགྱུར་མེད་པ་ལ།",
    "ཞེས་སོགས་དཔེའི་ཡེ་ཤེས་ལས་དོན་གྱི་ཡེ་ཤེས་ངོ་འཕྲོད་ཅིང་གསལ་བར་རྟོག་ཚུལ་ཞིག་གསུངས་འདུག་པ་དེ་ལ།",
    "བསྙུང་གཞི་དྲག་པོ་དེ་འདྲའང་ཡང་ཡང་ཐོག་བབས་ཡོང་པ་ཞིག་འདུག་པས།",
    "སྤྱི་བབས་བདེ་འགྲོས་རང་དུ་འདུག་ཅིང་།",
    "བྱ་བྱེད་འདི་དགོས་ཀྱང་ཅང་མི་འདུག།",
    "གསུམ་པོ་དེ་ནས་དེ་རིང་ཕེབས་མི་ཐུབ་པ་འདུག།",
    "གནངས་བཞེས་ཤིག་གདན་འདྲེན་ལ་ཡོང་ཟེར་བ་མནལ་ལམ་མ་ཡིན་པར་གསལ་སྣང་དགོས་སུ་བྱུང་འདུག།",
    "ང་སླེབ་དུས་ཐོག་མ་རང་ངོ་ཡང་མི་མཁྱེན་པ་ལྟར་འདུག་ཀྱང་།",
    "དེ་ཁ་ལ་བཞག་ན་ཕུ་མདའ་གཉིས་སུ་གོད་ཆེན་པོ་འོང་བར་འདུག་ནས།",
    "སྒང་ཆེན་པ་རྒན་པོ་སོགས་བཙོན་དོང་དུ་ཆུག་པ་ཚོ་ལ་ཕན་འདོགས་འདྲ་ཞུ་རྩིས་སྙན་དུ་ཕུལ་ཏེ་དོན་མཐོང་རིས་མན་པ་འདུག།",
    "དེ་སྐབས་ཡོང་པའི་ལག་རྗེས་དེ་ཁ་ཙམ་དུ་འདུག།",
    "སྔར་མ་གོ་བ་འདྲ་ཁྲ་གསལ་གྱིས་གོ་བ་འདུག་ན།",
    "འཇིག་རྟེན་ལུགས་རང་ལ་ཕན་ཅི་རིགས་པ་ཡང་འདོགས་པར་འདུག།",
    "ཅིག་ཤོས་འདིས་ནི་འདི་ཕྱི་ཐམས་ཅད་དུ་སྡུག་བསྔལ་འབའ་ཞིག་རང་སྡུག་གཞན་སྡུག་འདིར་སྡུག་ཕྱི་མར་སྡུག་ལ་གཏོད་པར་འདུག་སྟེ།",
    "ཞེས་གསུངས་པ་དེ་ཁར་འདུག།",
    "རྒྱང་ནས་ཕྱག་མཆོད་བྱེད་འབུལ་བ་བསྐུར་བ་ཡིན་པར་འདུག།",
    "སྲིད་ཕྱོགས་སྒྲིག་ནས་དམག་བྱུས་ལ་ཕན་པ་བྱས་པའི་བགྲོས་མི་གདའ།",
    "ཞེས་གསུངས་པ་ལ་ཐམས་ཅད་ཚང་འདུག་པ་ཤེས་ལྡན་རྣམས་ཀྱིས་དཔྱོད་ཅིག།",
    "བདེན་གཏམ་ལ་བདེན་བསམ་པ་སྐྱེ་བ་ཡང་མི་ཡོང་བར་འདུག་སྟེ།",
    "ངས་ནི་ཁྱི་ལུད་དེ་འདྲ་ནོར་བུ་རང་ཤིན་ཏུ་ཡིན་པ་གདའ་ལགས་ཧ་ཡི་ཕ་ཕ་ཟེར་བ་མཁས་འཇུག་ཀྱག་ཁྲམ་དེ་འདྲ་སྔར་ཡང་བྱེད་མ་མྱོང་།",
    "སྤྱིར་མི་དམངས་ལ་ངེས་པ་མི་འདུག་ཀྱང་།",
    "ཆ་ཅིག་ནས་རྣམ་རྟོག་རང་མི་དགོས་པ་འདུག་ཀྱང་།",
    "ལོ་སྔ་མ་གཉིས་སེར་སོགས་ཀྱི་སྐབས་གསུང་ཕེབས་པ་དེ་དེའི་སྔོན་འགྲོ་ཡིན་པར་འདུག།",
    "སྐྱོན་ཡིན་པ་འདུག་ཀྱང་སྡུག་ཞེན་བྱས་ནས་ཡོན་ཏན་ཅན་དུ་སྒོམ་མཁན་ཞིག་མ་ཡིན།",
    "ངེད་ལ་ཕྲག་དོག་སྡང་སྨྲས་བྱེད་ཀྱི་ཡོད་པར་འདུག།",
    "སྐབས་འདིར་ཡང་ར་ལུང་པ་ལ་ངེད་ཞེ་མ་སྡུག་ཡོད་ཀྱི་དོགས་པའི་རབ་བེ་རིབ་བེ་ཡིན་པ་འདུག་ནའང་།",
    "རང་ལ་མི་གནོད་པའི་བག་ཡོད་མཚམས་ཚིགས་ཟིན་པ་ཞིག་ནི་དགོས་རྒྱུར་འདུག།",
    "ཁོང་རང་རྣམས་ཀྱིས་ཡར་མར་དཀྲུགས་པ་ཡིན་ནའང་།",
    "ར་ལུང་ནས་སོགས་གཞན་རྣམས་ཀྱི་རྩར་ཁོང་རང་རྣམས་ཀྱིས་ལེགས་སམ་བྱས་གྱུ་བ་དང་།",
    "བརྟག་པ་ལ་ཆུག་གམ་མི་ཆུག་ཕེབས་ཀྱིན་འདུག།",
    "དབུས་ལ་ཕེབས་བསྐྱིལ་གྱི་སྐོར་ལ་གླེང་བརྗོད་སྣ་ཚོགས་ཤིག་འདུག་ཀྱང་།",
    "ལ་ལ་ཚོ་ཉེ་གནས་ཀྱིས་ལོངས་སྤྱོད་པ་ཞིག་གདའ།",
    "སྐུ་དོན་གསར་པ་གཞན་གང་ཡང་མི་འདུག་པས།",
    "དུས་ཐུག་པས་ཐེགས་གོང་སླེབས་མི་ཐུབ་པར་འདུག་ནས།",
    "དགྲ་ངོས་ལེན་བྱེད་རྒྱུའི་ཁུངས་བྱེད་ཀྱིན་འདུག།",
    "གང་དང་གང་བསྒོམས་པ་དེ་དང་དེ་གསལ་བར་སྣང་བའི་ཚུལ་ནི་ལོས་ཡིན།",
    "སྟོང་རྐྱང་དུ་འདུག།",
    "དེ་ཙམ་ལ་རག་མ་ལུས་པའི་སྟོང་པ་དེ་མཐར་གཏུགས་ན་བདེ་བར་འདུག།",
    "ཤར་ཙམ་ཉིད་ནས་ཀུན་རྫོབ་གཟུང་འཛིན་གྱི་དྲི་མས་མ་གོས་པ་ཞིག་འདུག་པ་དེ་ཉམས་སུ་ནི་མྱོང་།",
    "དེ་ཙ་ན་གཞན་མཁས་པ་ཡིན།",
    "དེ་ལྟར་སྨོས་པ་དེ་དང་རྗེས་མཐུན་པ་ཙམ་ལོས་ཡིན།",
    "ལན་ཅིག་བྱུང་ནས་ཉམས་རྒྱུ་ཡང་མི་འདུག་གོ།",
    "འདི་ཐུགས་རྡོ་རྗེའི་རིམ་པའི་གཟུགས་བརྙན་ཙམ་དུ་གདའ་ལགས།",
    "མེད་ཀྱང་རང་གཅིག་པུས་མི་ཕྱུགས་ཐམས་ཅད་འདེད་ཐུབ་པ་ཡིན།",
    "འདྲ་སྐུ་རང་ཡིན་ཟེར་ཡང་ཟེར་ཡིན་ཡང་ཡིན་ཡོད་པར་འདུག།",
    "ཞིབ་ཏུ་བརྟགས་ན་སྐུ་བཞུགས་དུས་ཀྱི་རྣམ་ཆ་ཡང་ངེས་པར་འདུག་ཅིང་།",
    "ལར་སྣང་བ་ཅུང་ཟད་འགྱུར་ནུས་པ་དཀྱུས་མ་མིན་པ་ཞིག་འདུག།",
    "སྐྱེ་བ་འདིའི་ཕྱི་མ་ཞིག་ལ་ནི་དེ་ལས་ཀྱང་མི་འགྲུབ་པ་ཞིག་འདུག།",
    "མགོན་ཁང་འོག་ན་ཕུར་པའམ་རྙིང་མ་ལྷ་ཁང་ཡིན་ཕེབས་པ་ཤིག་འདུག་པ་དེ་ལའང་ཉིན་གཅིག་རབ་གནས་བྱས།",
    "དེ་གོང་མ་གྲུབ་པས་དེ་ལོ་ཁྲིད་ཅིག་གནང་རྒྱུར་འདུག་པ་ལ་ཕན་ཐོགས་པར་མ་བྱུང་ཡང་།",
    "འདི་ཕྱོགས་ཕེབས་པའི་དུས་དང་ཉེ་བར་འདུག་ནས།",
    "དགོངས་བཞེད་ཀྱི་གཙོ་བོ་སྦྱོར་དྲུག་དང་ལམ་འབྲས་ཀྱི་སྐོར་སྔར་མ་གསན་འདུག་པ་དང་།",
    "ནེ་གུ་རགས་རིམ་ཙམ་གསན་འདུག་ཀྱང་།",
    "ལས་འབྲེལ་རྣམ་པར་དག་ཅིང་དམ་གཙང་བའི་རྟགས་ཤིག་ཅིས་ཀྱང་ཡིན་པ་འདུག།",
    "བཟོ་བོ་ལག་བདེ་ཤོས་རང་མི་འདུག་ཀྱང་ཞལ་རས་མཚར་ཞིང་ཚུགས་ཀྱང་བཟང་བར་བྱུང་།",
    "ལར་ཁོང་པ་ལ་ནོར་ཆེན་པོ་ཡོད་འདུག་ཅིང་།",
    "ཤི་རྗེས་ནོར་ཐམས་ཅད་ས་སྐྱ་རང་ནས་བཞེས་འདུག་པས།",
    "རྒྱུ་གང་ཡིན་ཡང་མི་ཤེས་པའི་རིགས་གཅིག་བྱུང་འདུག།",
    "ནོར་ལ་མིག་ཉེ་ཤོས་འདི་ཚོ་ཞེད་པར་གདའ།",
    "སྒྲུབ་གནས་ཆེན་པོའི་བླ་བྲང་རྙིང་པའི་གདོང་དེ་ན་ཐབ་ཚང་སོགས་ཁང་པ་སྐྱལ་སྐྱོལ་འཇིགས་ལ་ཁད་དུ་མ་འདུག་པ་རྣམས།",
    "ངེས་པར་མཇལ་དགོས་འདུག་གསུང་།",
    "ཞལ་རས་སྐུ་གཟུགས་ཀྱི་གཙོ་བོར་འདུག་པས།",
    "ཞལ་རས་ལ་གྲང་གསེར་འབུལ་བའི་རྩིས་ཀྱི་ཟངས་དམར་དུ་འཇོག་པའི་སྲོལ་ཞིག་དུས་ཕྱིས་ཕལ་ཆེར་ལ་འདུག་སྟེ།",
    "བྱིས་བློ་ཙམ་གྱི་གཡོ་ཟོལ་དུ་འདུག།",
    "ཁག་ཆེ་ཤོས་ལ་གལ་ཆུང་བྱས་པའི་ཉེས་པ་ཞིག་ཀྱང་ཡོང་བ་འདུག།",
    "འགངས་མེད་བྱས་ཀྱང་ཐམས་ཅད་དེ་ཀ་ལ་རྡིབ་ནི་འགྲོ་བ་ཞིག་འདུག།",
    "རང་ལ་མེད་ཙ་ན་དེ་ལས་ཐབས་མི་གདའ།",
    "འདུག་ནི་བླུན་རྟགས་ཀྱི་གཏམ་དུ་འདུག་སྟེ།",
    "གླེན་པ་རྣམས་ཀྱི་རྣེ་མཆོག་ཏུ་དེ་འཛུལ་བ་ཞིག་ཀྱང་གདའ།",
    "ཡ་མཚན་ཅན་དགུ་བཅུ་རྩ་དྲུག་རང་དུ་འདུག་གོ།",
    "སྣེ་སྦྱོར་སྟག་ལུང་ནས་འབུལ་དཔོན་ཞིག་ཀྱང་འདུག།",
    "ཐ་གུ་སྣ་དབུས་གཙང་ལ་མི་སྣར་ཡོང་རིགས་སུ་འདུག་པས།",
    "ཐེག་ཆེན་གྱི་ལམ་རིམ་ཟབ་ལ་རྒྱ་ཆེ་བ་གོང་ན་མེད་པར་འདུག་པས།",
    "སྐུ་ཤིན་ཏུ་ལྟེམ་པར་འདུག་ནའང་ཐུགས་རིག་དྭངས་པར་འདུག་ཅིང་།",
    "སྐུ་མཐར་ཐོན་རང་མི་ཡོང་བ་འདུག་ནའང་།",
    "དེ་རྗེས་ཉི་མ་གཉིས་བསྙུང་གཞི་རང་ནི་ཆུང་ངུ་མི་འགྲོ་འདུག་ནའང་།",
    "གང་ཡོད་ལ་ནི་ཟ་འདྲེ་ལས་ངན་གྱི་བསྐོས་བ་པོ་གདའ།",
    "ཐོད་པ་གཉིས་སུ་བདུད་རྩི་མང་དུ་བབས་འདུག།",
    "གཏིང་ན་འཁྱིལ་བའི་རྣམ་པར་འདུག།",
    "ཤིན་ཏུ་ཁོགས་འདུག་པས་བརྟན་བྱེད་ཀྱི་ཐབས་དང་།",
    "ཁང་གཡོག་དེ་རྙིང་པའི་དུས་ན་ཉིས་ཐོག་ཏུ་འདུག་ཀྱང་།",
    "རྡོ་རྗེ་གདན་པས་མཛད་པར་བརྫུས་པའི་སྟོད་པའི་ལུགས་དེ་སྔ་ཕྱི་ཀུན་ཏུ་དར་བར་འདུག་ཀྱང་།",
    "རྣམ་འགྱུར་གང་ཡང་མི་ཡོང་བ་འདྲ་ཞིག་འདུག།",
    "ལ་ལས་ཟེར་ན་རྟོག་གེ་མགོ་མཁྲེགས་པོ་ཞིག་འདུག་ཟེར།",
    "ལ་ལས་ཟེར་ན་འཁྲུལ་ཞིག་ལྷོད་གྲོལ་བ་ཞིག་འདུག་ཟེར།",
    "ལ་ལས་ཟེར་ན་ལྟ་སྤྱོད་ངན་པ་ཞིག་འདུག་ཟེར།",
    "ལ་ལ་ཟེར་ན་བསམ་ངན་འཇིག་རྟེན་པ་ཞིག་འདུག་ཟེར།",
    "རྣམ་པ་ཐམས་ཅད་པ་ཞེས་པ་དེ་ཡིན་ཉེན་གདའ།",
    "ཉམས་འོག་ཏུ་ཆུད་པ་རྐྱང་འདུག་གོ།",
    "ཟླ་ཚེས་གང་ཡིན་བརྗེད་གདའ།",
    "ངེད་ལྷོ་སྐྱ་ནས་ཁ་བྱང་ལ་བསྟད་འདུག།",
    "དེ་འཕྲལ་ཕྱག་གཡོག་འགའ་བྱུང་ནས་ད་འབྱོན་རན་འདུག་ཟེར།",
    "སྐུ་ཐིམ་འགྲོ་བའི་ལྟས་སུ་འདུག་སྙམ་པ་གཅིག་དེ་འདུས་བྱུང་།",
    "དོན་ལ་ཡང་ཡིན་པ་འདུག།",
    "སྐུ་དོག་སེལ་བ་ལ་དཀའ་ཚེགས་ཆེན་པོ་རང་མེད་རིགས་སུ་འདུག་ནའང་།",
    "ངེད་ལ་མི་གནོད་འདྲེར་འཛིན་བྱེད་ཀྱིན་འདུག་པས།",
    "སྟག་ལོ་རྡོ་རྗེ་རྣལ་འབྱོར་མ་རིག་པ་འཛིན་མའི་དཀྱིལ་འཁོར་རྡིབ་པའི་ལྟས་ཀྱི་དོན་འགོ་མ་ཚོ་ཤར་འདུག།",
    "ཁོང་རང་ཡུམ་སྲས་ཀྱིས་སྐྱོང་བའི་ས་ཆ་ནས་གཅོད་རྒྱུ་ནི་མིན།",
    "དགག་པ་མི་དགོས་པ་འདུག་སྟེ།",
    "ཕྱིས་རྟིང་ཁོང་རང་འདའ་ཁར།",
    "བྱང་བུ་གཅོག་པ་ཡང་ངེད་ལ་ཕུལ་ཟེར་བའི་ཁ་ཆེམས་བཞག་འདུག།",
    "ངམ་རིང་རང་ནས་ནི།",
    "ཁྱད་པར་དུ་ཡང་ལྕམ་དྲུང་རང་བསམ་འགྲུབ་རྩེར་ཡང་ཡང་ཕེབས་པ་ཀུན་ལ།",
    "ངམ་རིང་རང་དུ་བཞུགས་དུས་ཀྱང་།",
    "ཁོང་རང་དཔོན་གཡོག་ཕལ་ཆེར་འདུས་པའི་གྲོས་ལ་སྲུང་འཁོར་ཁྱད་དང་།",
    "གནས་བཟང་བའི་སྟབས་རི་ཁྲོད་ཆེན་པོར་བསྙེན་པ་ཞིག་མཛད་ན་ལེགས་ཟེར་བ་གྲོས་མཐུན་འདུག་པ།",
    "ལར་ནས་དུས་ཕྱིས་ཁྲོམ་ལ་གྲགས་པའི་སྐད་ཆ་ཀུན་གསང་གསང་བྱེད་པའི་སྲོལ་ཞིག་འདུག་པས།",
    "དེ་མཐུན་ལྕམ་དྲུང་རང་ཇོ་ནང་དུ་ཕེབས།",
    "ཁྲི་མཁར་བ་ལ་རང་གནས་བྱུང་འདུག།",
    "མགོན་ཁང་ནི་རྡིབ་ལ་ཁད་རང་འདུག།",
    "དེ་ན་ད་དུང་རྟེན་ངོ་མཚར་ཅན་འདྲ་ནི་བཞུགས་འདུག།",
    "ཟངས་དཀར་ལོ་ཙཱ་བས་བཞེངས་པའི་རྡོར་དབྱིངས་ལྷ་ཁང་དེ་ཁ་ཆེའི་ལུགས་སུ་འདུག་ཅིང་།",
    "ལྷ་སའི་དཀྱིལ་འཁོར་སྟེང་ན་ཟངས་དཀར་གྱིས་བཟོ་བཀོད་ཅིག་མཛད་འདུག་པ།",
    "མ་བབས་ཐུགས་ཁོག་འཚབ་པའི་སྟབ་སྟོབ་ཀྱི་གསུང་དུ་འདུག་ནའང་།",
    "ཕུགས་ཀྱང་ཟར་ཟིར་གྱི་རྒྱུ་ཁོ་ནར་འགྲོ་བ་འདུག་པས།",
    "སྐུ་ཚེ་ཧྲིལ་པོ་བཟང་བཙོན་དུ་བཞུགས་དགོས་ཀྱི་སྒོ་དོད་པ་དེ་ཁར་འདུག་ཀྱང་།",
    "དེ་སྐབས་རང་དེ་འཇིགས་པ་ཆེན་པོ་ལས་ཐར་བ་དེས་ཞབས་དྲུང་རང་ཡང་ཐུགས་དགྱེས་བཞིན་དུ།",
    "ཞབས་དྲུང་རང་བཞུགས་ཡུལ་རྟག་བརྟན་རང་དུ་རྒྱུན་བཞུགས་མཛད་དགོས་གསུང་བ་ཡོད་ནའང་།",
    "ཞབས་དྲུང་རང་དང་དགོས་པ་དཔོན་གཡོག་གཉིས་ཀྱིས་དགོས་མེད་ལ།",
    "གཞན་ཡང་ཟར་ཟིར་ཡ་རི་མ་རི་མང་པོ་ཡོང་རྩིས་འདུག་པས།",
    "དཔྱིད་ཀ་དེ་ཞབས་དྲུང་རང་རྟག་བརྟན་དུ་གདན་འདྲེན་དགོས་བྱུང་།",
    "གཞུང་དེ་གོ་ཞིག་ཤེས་པ་སྲིད་མཐའ་ཙམ་མིན་པ་མི་ཡོང་བར་འདུག་པས།",
    "འདི་ཀུན་ཏུ་ནི་ཕལ་ཆེར་ལ་གོ་རྟོགས་ཡོང་བ་དཀའ་བར་འདུག།",
    "གཞུང་བློ་ལ་བཟུང་བ་ཚོ་ལ་གོ་བ་ལེགས་རབ་ཤར་བ་ཡང་གདའ།",
    "དེ་རྗེས་བསྙེན་རྫོགས་བསྒྲུབས་ནས་སྟོད་ཕྱོགས་ལ་འབྱོན་བཞེད་ཅིག་འདུག་ནའང་།"
  ]
}