    "འདི་ལོ་ཆོག་མང་ལ་དུས་འཁོར་གྱི་སྦྱིན་སྲེག་བགྱིས་པའི་བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པའི་ཕྱག་ལེན་འཁྲུལ་མེད་ཕུར་གདབ་ཀྱི་སྟངས་སྟབས་སོགས་བློ་གྲོས་ཤེས་རབ་ཀྱིས་ཁྲིད་ནས་ཨོ་ཟོབ་ཏུ་མ་སོང་བར་བྱས།",
    "རྔ་ཆོ་ལ་སོགས་རོལ་མོ་ཁྲོལ་བར་འདུག།",
    "གྲོལ་གདོང་མཁའ་འགྲོ་མ་འགྲོ་བ་བཟང་མོའི་ལུགས་དར་ལམ་གཅོད་པ་སོགས་ཀྱི་བརྟན་བཞུགས་ཤ་མར་ཐུད་གསུམ་སོགས་ཚོགས་འཁོར་རྒྱས་པར་ཕུལ།",
    "གོས་དར་གྱི་འཕན་ལག་གསུམ་པ་ཕྱོགས་རེར་བཅུ་གསུམ་རེ།",
    "སྐུ་ལྟེམ་བབས་ལྕི་བ་རེ་ལྟ་བུ་འདུག་པར་འཕྲལ་དུ་རྣམ་འཇོམས་ཀྱི་བྱབས་བཀྲུས་ཕུལ།",
    "ཨེ་མ་ཕྱི་རིན་རྒྱམ་གྱི་ཤག་ཏུ་ནུབ་མོ་སྡོད་ས་བྱས།",
    "ཁྲོ་མོ་སྨེ་བརྩེགས་དང་སེང་གེ་སྒྲ་སོགས་ཀྱི་རྗེས་གནང་།",
    "མཉན་པའང་རྒྱུས་མེད་པ་བཅས་ལྕང་གསེབ་ཀྱི་རྒྱབ་འདམ་ཁྲོད་དུ་སྔོ་ཕུང་ཞིག་གི་སྟེང་དུ་སྟན་དམར་བཏིང་ནས་བསྡད་པར་ཞོགས་པ་བལྟས་པས་ཚེར་མའི་ཕུང་པོ་ཡིན་འདུག།",
    "ཁ་ཏོན་མ་ཆགས་ཙམ་ལས་བཟའ་བཏུང་གི་སྤྲོ་བསྡུ་ནི་ཅིའང་མ་བྱུང་།",
    "བློ་ལྡན་ངེད་རང་གི་འཁྲིས་སུ་ཉལ་སོང་བ་ཆར་པས་མ་སྦངས་ཙམ་བྱུང་།",
    "སོང་ཞོགས་རབ་བརྟན་ནས་ནུ་བོ་དང་བློ་གསལ་བཅས་བྱུང་བས་མདངས་སྐུ་བསྙེལ་པོ་བྱུང་ཡོད་ཅེས་ཤིན་ཏུ་བློ་མ་བདེ་བར་བྱེད།",
    "འདི་ལོ་བླ་བྲང་རང་ནས་སྤྱི་པའི་ཁུར་ལེན་བྱེད་དགོས་བྱུང་ཞིང་ཆུ་ཤིན་ཏུ་ཆེ་བའི་སྟོན་ཐོག་བསྡུ་ཐེབས་དང་བྲལ་བ་བྱུང་ཀྱང་བློ་གསལ་གྱིས་ཁུར་བླངས་པའི་སྒྲུབ་མཆོད་ཐམས་ཅད་ཆག་མེད་བཏང་སོང་ཀྱང་།",
    "སྟག་ལུང་ཆ་ལའི་བོང་བུའི་དཔེ་ལྟར་བྱུང་སོང་།",
    "གྲྭ་ཚང་གི་རྡོ་རྗེ་སློབ་དཔོན་པད་འདུས་ལགས་དང་།",
    "སྒྲུབ་ཐབས་བརྒྱ་རྩ་རྗེས་གནང་བདུན་ཅུ་དོན་དགུ་པོད་གཞུང་གི་ལུང་བཅས།",
    "ནུབ་མོ་དང་གུང་སང་སོགས་སུ་དགེ་སློང་ཨོ་ལོ་སོགས་ལ་རྒྱལ་སྲས་བཀའ་འབུམ་གྱི་ལུང་།",
    "ཁྱོན་འབྲས་སྤུངས་སུ་ཞག་ཉི་ཤུ་རྩ་བདུན་འགོར།",
    "སྲིན་མོ་རྣམས་མི་ཚད་ཙམ་རུ་ཤིང་ནས་ཞལ་བསྲོ་རབ་གནས་ཀྱི་བར་སྔར་ལྟར་སྤུས་ལེགས་གྲུབ་པ་མགོན་ཁང་དུ་གསར་དུ་བསྒྲིགས།",
    "དེ་དག་གི་སྔར་ཕྱིར་འདི་གར་སྦྱོར་འཇགས་སུ་མགོན་ཁང་དུ་ལྷ་བརྒྱད་ཀྱི་འབུར་སྐུ་སོ་སོར་ན་བཟའ་ཁ་བཏགས་ཆེ་ལེགས་རེ།",
    "གོས་ཆེན་གྱི་རྒྱལ་མཚན་ཆ་རེ།",
    "ཚེ་རྟ་སོགས་སྐྱ་སེར་ཐམས་ཅད་ཀྱི་བློའི་རེ་བ་བསྐངས།",
    "ལྕགས་ཟམ་དུ་མཆོག་གི་སྤྲུལ་པའི་སྐུ་ཅུང་ཟད་སྐུ་ལྟེམ་པར་རྐྱེན་སེལ་འདྲ་འབུལ་བ་སོགས་ལ་ཕྱིན།",
    "སྲེག་ཆོག་མ་གཏོགས་ཐམས་ཅད་ངེད་རང་གིས་བགྱིས།",
    "རེ་ཞིག་གསང་སྒོ་གནང་རྩིས་འདུག་ཀྱང་ངེད་རང་ནས་དེ་འདྲ་གཏན་ནས་མི་འགབ་ཚུལ་ཞུས་པས།",
    "བློ་ལྡན་གྱིས་རམ་བཏེག་ནས་ཞུས་སོང་བར་དེ་གར་གསན་མི་གནང་བར་ཐག་ཆོད།",
    "འཇིགས་བྱེད་ཀྱི་རྭ་ཁྲིད་ཀྱང་བསྐྱེད་རིམ་ཡན་ཆད་སོང་།",
    "འདི་ལོ་རང་ལོའི་སྐེག་གི་སྐུ་རིམ་དུ་ཚོགས་སུ་ཚེ་ཆོག་རྒྱས་པ།",
    "དེ་དག་གི་སྔ་ཕྱི་ཐམས་ཅད་དུ་རྣམ་སྲས་ཀྱི་རྗེས་གནང་བཅོ་ལྔ།",
    "རྡོར་ཕྲེང་གྲོལ་ནས་ཇོ་བོ་ལུགས་སྒྲོལ་མ་ཉེར་གཅིག་གི་རྗེས་གནང་དང་།",
    "ངེད་རང་གིས་མཁན་སློབ་སྦྲགས།",
    "དར་གླིང་པ་ལྔ་ལ་མགོན་པོ་ཕྱག་བཞི་པ་ལྷ་མང་གི་རྗེས་གནང་།",
    "དེ་དག་གི་སྔ་ཕྱིར་ཇོ་བསྟན་ཚོགས་པ་ཉི་ཤུ།",
    "དམག་ཟོར་མའི་རྗེས་གནང་ཐུན་མོང་མ་ཡིན་པ།",
    "བརྒྱ་མཆོད་ཀྱི་ཐེབས་བཅས་པར་ནས་སྤུངས་འཕྱར་མ་ལྕགས་འབོ་ཆེན་མོའི་ཁལ་བརྒྱ་ཐམ་པ་ཕུལ།",
    "མར་ལམ་གྲྭ་ཐང་གི་ཐད་དུ་རྒྱལ་པོ་དང་།",
    "སང་ཉིན་རྡོར་བྲག་གི་བང་ཕྱིན་གནང་བ་ལྟར་ཕྱིན།",
    "དེ་ཞོར་གྲུབ་ཐོབ་ཆེན་པོའི་གཟིམས་སྤྱིལ་སྒོར་མོའི་ཞིག་གསོས་གནང་བར་མེ་ཏོག་འཐོར།",
    "སྐུ་མཆོད་ཆེན་མོ་རྣམས་ཀྱི་རྡོར་སློབ་ལ་སྔར་རྒྱུན་ལྟར་ཕྱིན།",
    "ཉེར་བདུན་གྱི་ཉིན་གུང་ཡོལ་ལ་གཙུག་ལག་ཁང་གི་སྟེང་དུ་བྱད་ཀའི་རྣམ་པར་ཐོག་བབས་པས།",
    "འབྲོག་ལུགས་ཀྱི་ཚོགས་འཁོར་སྟོན་མོ་ཡང་ཡང་ཟབ་པར་བྱུང་ཞིང་།",
    "ཁྲེལ་དང་དམ་ཚིག་ལ་ཅིའང་མི་སེམས་པའི་གྲྭ་རྒན་འཇུངས་མེད་རེ་གཉིས་ཀྱིས་ཞབས་དྲུང་ཨོ་སྒྲོན་སོགས་བསླད་པས་ངེད་དེ་གར་བསྡད་ན་རང་ལ་ཅང་མི་འོང་བསམས་ནས།",
    "དཱ་བྱིན་ལ་མགོ་བཏགས་པའི་རྨེ་རུ་ཨ་མཆོད་བོས་ནས་དཔེ་མེད་མེད་ཀྱི་ཁས་དྲག་བྱེད་རྩིས་ཀྱི་གཞི་བཏིང་ཀྱང་།",
    "དེང་སང་གི་དུས་རྒྱལ་བུའི་དྲུང་དང་དཱ་བྱིན་གཉིས་དབྱེར་མེད་ཡིན་པས་གཡུལ་ངོ་མི་ལྡོག་ཅེས་གནང་མི་བྱུང་འདུག་ཀྱང་འཕྲལ་དུ་ལྡོག་འཕྲལ།",
    "དེ་ནས་ངེད་རང་གི་རྩིས་ལེན་སར་ཕྱིན་པས་ཡུལ་མི་རྣམས་ཀྱང་དགའ་སྤྲོ་ཐོབ་ཅིང་ཐམས་ཅད་བློ་མལ་དུ་ཚུད་པར་གྱུར།",
    "བྱེ་རྫིང་ཚོགས་པ་ཀུན་བཟང་རྡོ་རྗེ་དང་།",
    "ཁོ་པ་ཚོས་ཁྲོམ་གཟིགས་ཁང་བཟུང་།",
    "སྐོར་ཡང་མང་དུ་བྱས་མཐར་ཚེས་བཅུའི་ཞོགས་པ་ངེད་རང་སོག་པོར་རྩིས་སྤྲད་པའི་འཛིན་འཆགས་བྱས་ཤིང་གཉེར་པའང་མཉམ་དུ་ཟིན་པར་ཆུ་ཆགས་ཡང་ཡང་བརྒྱབས་སོང་ཀྱང་ཚིག་ཁ་མ་ཐལ་གཤིས་རེ་ཞིག་སོག་པོ་རེར་རྩིས་སྤྲད་པའི་དམ་རྩི་ཆེ་བར་བྱུང་།",
    "གསུང་གླེང་བག་ཕེབ་པ་བྱུང་ཞིང་སང་ཉིན་ནས་ཉིན་རེ་བཞིན་མཇལ་དགོས་འདུག་གནང་བྱུང་ཀྱང་ངེད་སོག་པོས་གཙེས་པས་མཇལ་མ་ཐུབ།",
    "སེར་སྦྲེང་ཆིབས་བསུ་སོགས་མི་འགབ་ཞུས་ཏེ་རེ་ཞིག་པར་སྟིར་ཇ་སོགས་གནང་།",
    "སྤྱི་སོ་ནས་དགེ་སློང་ནམ་མཁའ་རྒྱལ་མཚན་ལ་དྲིན་གཟོར་སྟོན་མོའི་ཐོག་གོས་ཆེན་གྱི་སྣམ་སྦྱར་གཅིག་ཕུལ་སོང་།",
    "དགོངས་ཁྲོལ་ཞུས་པར་རེ་ཞིག་འཁུར་ལེན་དགོས་ཚུལ་བྱུང་ཀྱང་།",
    "ཡང་བསྐྱར་འུ་ཐུག་གི་ཞུ་ཡིག་ཕུལ་བས་དགོངས་པ་ཁྲོལ།",
    "བརྒྱ་མཆོད་ཀྱི་ཐེབས་ནས་སྤུངས་འཕྱར་མ་ལྕགས་འབོ་ཆེན་མོའི་བརྒྱ་དང་བརྒྱད།",
    "མང་ཇའི་ཐོག་ལྟང་རྩེ་མ་གཏོགས་ཆ་ཚང་ཚོགས་གཤམ་དུ་ཕུལ།",
    "བཀྲ་ཤིས་ཟམ་པའི་ཐད་དུ་ཕེབ་པའི་གྲ་པ་རྣམས་ཀྱི་ཁ་བཏགས་ཀྱི་གཡབ་མོ་གནང་བར་རྟ་ཁ་བསྒྱུར་ཐེངས་གསུམ་བྱས།",
    "རྨོར་པ་བཅས་ཁྱོན་ཉིས་བརྒྱར་ཉེ་བར་དགོངས་རྫོགས་བྱས་པའི་སང་ཉིན་འཁྱོངས།",
    "ཞབས་ཏོག་གི་རིགས་ཆེ་ཕྲ་གང་ཡང་བྱེད་པ་མེད་པ་དང་།",
    "ངེད་རང་ཁྲི་མོན་ནས་གེགས་མེད་དུ་ཐོན་པས་ས་ལུགས་གཞན་མ་ལའང་ཅུང་ཞིག་ཕན་པར་བྱུང་སྟེ།",
    "དགོན་མང་པོ་མིང་གི་ལྷག་མར་བཏང་།",
    "རྡོ་རྗེ་ཤུགས་ལྡན་རྩལ་ལ་ཕྲིན་བཅོལ་དང་དམོད་ནས་ཕུལ་བས་དགྱེས་བཞིན་དུ་སྲུང་མར་ཞལ་གྱིས་བཞེས།",
    "ཁ་རེག་ནས་ཐེག་མཆོག་གླིང་དབོན་སློབ་སྐུ་མཆེད་ཕེབ།",
    "ས་ཕག་ལོ་གསར་པ་རང་ལོ་རེ་དྲུག་པའི་ནང་དུ་རིན་ཆེན་སྤུངས་པའི་དཔོན་སློབ།",
    "འདི་ལོ་དུས་སྟབས་དང་བཅས་བློ་གསལ་འདི་གར་ཁག་ཆེ་བའི་སྡོད་དགོས་བྱུང་སྟབས་ངེད་རང་གི་རོགས་བློ་ལྡན།",
    "སྦྱོང་གར་གྱི་སྟབས་ནས་བཙུན་མ་རྣམས་བསྐུལ་མ་ཐུབ་པས་གཡག་ཁལ་གྲྭ་བསྒྲིགས་པར་འབུལ་མི་མང་དུ་བྱུང་ཞིང་འགའ་རེ་ཉོས་པ་བཅས་མཛོ་གཡག་བཅུ་བཞི་ཙམ་དང་།",
    "ཞི་བ་ལས་ཐམས་ཅད་པའི་སྦྱིན་སྲེག་གི་སྒོ་ནས་བསྲེག་བླུགས་རྒྱས་པར་ཕུལ།",
    "གནས་བཅུའི་ཞལ་ཐང་གི་རབ་གནས་ལ་འོང་དགོས་ཚུལ་ཕེབ་པ་ལྟར་ཕྱིན།",
    "སྐྱེད་ཚལ་འོག་གི་དཔོན་སློབ་བཅས་ལ་གུར་ལྷ་བརྒྱད་ཀྱི་རྗེས་གནང་བྱས།",
    "དམག་ཟོར་མ་ཐུན་མོང་མ་ཡིན་པ།",
    "ལྕམ་དྲལ་ལྷ་གསུམ་ཐུན་མོང་མ་ཡིན་པ།",
    "ངེད་རང་གི་ཐོབ་ཡིག་པུསྟིའི་ལུང་སོགས་ཀྱང་ཕུལ།",
    "ཟླ་བ་ལྔ་པ་ནས་མགོ་བརྩམས་དཔུང་འཇུག་གི་མགོ་ཚུགས།",
    "དེ་ནས་ཟླ་བ་བརྒྱད་པའི་མཇུག་ནས་ཀོང་དམག་གི་བྱར་དྭགས་ལྷུམ་རྩེ་སོགས་རིམ་གྱིས་བླངས།",
    "དགུ་པའི་ནང་དུ་རྒྱ་ནག་གི་དམག་དཔོན་གཙང་ཇུན་དང་།",
    "རྩེའི་གཟིམས་ཆུང་ཕྱག་མཛོད་ཐམས་ཅད་དུ་རྒྱ་ཡིག་གིས་མནན།",
    "མི་སྲུན་པའི་གཙོ་བོ་བདུན་ཕ་རོལ་གྱི་གཟིགས་མོར་བཏང་།",
    "གཅིག་ཏུ་སྤུངས་པའི་ལེགས་བྱས་སྐྱ་རེངས་ཀྱིས།",
    "ཐ་མལ་བློ་འདི་འཁྱོག་ལ་འཕྱང་མོ་ཉུག།",
    "མ་རུངས་སྐྲོད་པའི་མཛད་བཟང་འཕྲུལ་མོ་ཆེར།",
    "ཚངས་པའི་འཇིག་རྟེན་མན་ཆད་གཟིགས་མོར་གཡེང་།",
    "གསེར་དམར་གྱི་དྲིལ་བུ་རྩེ་གདོང་གི་ཕྱག་དྲིལ་ཡིན་ཞེས་གནང་།",
    "གཞན་ཡང་རྗེས་གནང་གི་རིགས་མང་བ།",
    "འདི་སྐབས་ཀྱང་ཆེད་གཉེར་གྱི་དཔལ་འཛིན་པོད་ཆུང་གི་ལུང་།",
    "ཁྲོ་མོ་སྨེ་བརྩེགས་སོགས་ཀྱི་རྗེས་གནང་དང་།",
    "སེམས་དཔའ་ཆེན་པོ་ནི་སྨྱོན་པ་ལྟར་བཞེངས་ནས་ཐོགས་སོང་།",
    "དཀར་པོ་ཚེ་འཕེལ་ཐུན་མོང་མ་ཡིན་པ།",
    "ཉི་མ་སྦས་པའི་ལུགས་ཀྱི་སྒྲོལ་མ་ཉེར་གཅིག་གི་རྗེས་གནང་།",
    "ཡི་གེ་གསར་རྙིང་གི་ལུང་སོགས་བསྟན་རྒྱུན་ལ་ཕན་པའི་འགྲོ་གང་ཆེ་བྱས།",
    "བློ་ལྡན་མལ་གྲོལ་སོང་།",
    "ལོ་ཙཱ་བ་རྗེ་དྲུང་གི་ལོ་ཙཱ་བ་མཛད་པས་ཤིན་ཏུ་མགུ་བར་བྱུང་སོང་ཞིང་།",
    "མཇལ་མི་མང་བས་མགྲོན་གཉེར་གྱི་ཁ་ལ་མ་ཉན་པར་བློ་གསལ་གྱིས་ལན་ཡང་མེད་པར་སློག་སོང་།",
    "སང་ཉིན་དེ་མཇལ་ཁར་ཡང་མི་འགྲོ་ཟེར་འདུག་ཉེར་ལྔའི་ཉིན་ཆིབས་ཁ་བསྒྱུར་སོང་བས་འདི་རེས་མཇལ་མ་ཐུབ།",
    "གངས་ཅན་མཁན་ཟུར་ལ་རྣལ་འབྱོར་མའི་བེའུ་བུམ་ནས་ལུང་མང་བ་དང་རྗེས་གནང་ཁ་ཤས་སོགས་སོང་།",
    "དད་མོས་ཆེ་བར་མཛད།",
    "ཁ་བཏགས་འདོམ་དོ་ཡོད་པ་ཞིག་ངེད་རང་གི་མདུན་རྒྱབ་ཏུ་སྐོར།",
    "ངེད་རང་གིས་ཀྱང་སྔ་ཉིན་ནས་གྲབས་ཤོམས་གྲུབ་སྟབས་ཁ་ཏོན་སོགས་གྲུབ་འཕྲལ་ཚོམས་ཆེན་དུ་ཀྱེ་རྡོ་རྗེའི་བདག་བསྐྱེད་སྔོན་དུ་འགྲོ་བའི་སྒོ་ནས་རབ་གནས་རྒྱས་པ་དངོས་གཞི་ཐམས་ཅད་ནམ་ལངས་གོང་དུ་གྲུབ་པར་བྱས།",
    "དེ་ནས་སྟོན་མོ་བཟང་བ་འདུག་ཐོག་ཕྱག་མཛོད་ལ་སྦྱིན་བདག་བསྐོ་བ་ནས་མཇུག་ཆོག་གི་བར་དུ་བགྱིས།",
    "སང་ཞོག་ནམ་ཕྱེད་ཡོལ་ཁ་ཏོན་གྲུབ་འཕྲལ་ཐོན་སོང་།",
    "རྒྱལ་གྲུབ་གླིང་ཐུབ་ནམ་གྱིས་འཁྱོལ།",
    "ཚེས་དྲུག་གི་ཉིན་བློ་གསལ་ཀྱང་ཕེབ་བསུར་ཕྱིན་པའི་མགྲོན་གཉེར་ལ་ཚེས་བདུན་ལ་གྲྭ་ཚང་གི་ཞབས་བརྟན་ཡིན་གཤིས་བརྒྱད་ལ་ཕུལ་ཆོག་པ་སྙན་གསན་ཕུལ་འདུག་དོན་ལྟར།",
    "དེ་ཉིན་གྲྭ་ཚང་གི་ཞབས་བརྟན་གྱི་དུང་བརྡ་གཏོང་བ་དང་སླེབ་པ་དུས་མཉམ་དུ་བྱུང་།",
    "ངེད་རང་ནས་སྐུ་རྟེན་བདག་ཉིན་ཆེན་པོ་བཟང་པོ་དཔལ་གྱི་ཞལ་གཟིགས་གྱི་སྒྲོལ་མའི་སྐུ་མཐོ་གང་བ།",
    "ཕྱག་མཛོད་ནས་དེ་འདྲ་ཡོད་འདུག་པ་སྤུས་བསྒྱུར་དགོས་ནན་གྱིས་གནང་བྱུང་བར་ཐོག་མར་དེ་འདྲིའི་རེགས་མེད་ཅེས་སྐུ་རྩེད་ཞུས་པར་ནན་བསྐྱེད་གནང་བྱུང་བར།",
    "ཕྱིས་རྡོར་བྲག་གི་ཕྱག་ཏུ་འབྱོར་པར་སྟོར་དུས་འཁྱར་བ་ངེད་རང་གི་ལག་ཏུ་འབྱོར་བའི་ཁྱད་ཅན་དེ་དང་བཅས་འབུལ་བར་བློ་གསལ་བཏང་།",
    "འདི་གར་ཀྱང་བསྔོ་བྱང་གི་རྟེན་སྐྱེལ་བར་འབྱོར།",
    "འདི་ལོ་བསམ་ཡས་སུ་མཆོད་འབུལ་དང་གནས་གཟིགས་ལ་ཅིས་ཀྱང་འོང་དགོས་གནང་བྱུང་བས་དེ་ག་བྱེད་དགོས་འདུག་ཞུས་ཀྱང་།",
    "གསང་སྒྲུབ་ཀྱི་རྗེས་གནང་ཐུན་མོང་མ་ཡིན་པ།",
    "སྒྲུབ་དུས་ཐུན་མོང་མ་ཡིན་པ།",
    "སྲུང་འཁོར་ཚེ་ཁྲིད་ཐུན་མོང་མ་ཡིན་པ།",
    "གིང་ལྔ་གཟའ་གདོང་གི་བཀའ་གཏད།",
    "བེག་ཙེ་གཙོ་རྐྱང་གི་བཀའ་གཏད།",
    "ངེད་རང་ནས་ཀྱང་དམིགས་ཕུག་གི་གཏོར་མ་ཕུལ་བས་དེ་ནུབ་ས་སྲིབས་ནས་ནམ་མ་ལངས་བར་མཚན་ཡལ་ཆར་པ་ཤིན་ཏུ་ཆེ་བར་བབས།",
    "ཕག་མོའི་སྐུ་རྒྱུ་ལེགས་པ།",
    "དེ་ནས་འདུ་ཁང་དུ་བཞུགས་ཁྲི་ཆེན་མོའི་ཐོག་ཏུ་བོས།",
    "སྤྱི་སོའི་སྟོན་མོ་འབུལ་བ་དཔག་མེད་བྱུང་།",
    "བཀྲ་ཤིས་ཟམ་པའི་ཐད་ཀ་ནས་ཁ་བཏགས་ཀྱི་གཡབ་མོ་གནང་བར་རྟ་ཁ་ལན་གསུམ་བསྒྱུར།",
    "ཟངས་པར་གླིང་གི་སྦུགས་གཟིམས་ཆུང་ཤིན་ཏུ་སྤྲོ་བར་འདུག་པ་དེར་བསྡད།",
    "ལུམ་གྲུ་གཏོང་མ་ཐུབ་གཤིས་རྡོར་བྲག་གི་གྲུ་དོན་དེ་ནུབ་སྨད་པའི་ནང་དུ་བསྡད།",
    "བྱེ་རྫིང་ཚོགས་པ་བཅུ་གཅིག།",
    "བཙུན་ཆུང་སློབ་དཔོན་སོགས་གཉུག་མར་གནས་པ་བརྒྱར་ཉེ་བ་བཅས་ཁྱོན་ཕྱེད་ཉིས་བརྒྱ་སྐོར་ལ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་ལྡེམ་སྐུ་ཛྷེ་ཀྵིཾ།",
    "རབ་བྱུང་པར་མང་ཇ་འགྱེད་ཟླ་བ་བྱུང་ངོ་ཅོག་གི་གནམ་གང་ལ་དྲིན་ཅན་རྡོ་རྗེ་འཆང་གི་སྐུ་མཆོད་ལ་དམིགས་ནས་དངུལ་སྲང་སུམ་ཅུ་ཕུལ།",
    "ངེད་རང་གིས་ཡར་འོང་།",
    "གཡབ་མོ་བྱུང་བར་རྟ་ཁ་ལན་གསུམ་བསྒྱུར།",
    "ཞག་གསུམ་ཐོག་བཀྲ་ཤིས་བདེ་ལེགས་སུ་རྒྱལ་ཕུར་འགྲུབ་སྦྱོར་འཛོམས་ཐོག་གཞུང་གི་དམར་པོ་སྐོར་གསུམ་གྱི་འཁོར་ལོ་མཁྱེན་རབ་ལགས་མཚམས་འོག་ཏུ་བཞག་པའི་ཕྱག་བྲིས་རུང་བར་གནང་།",
    "བདུན་གཅིག་གི་བར་སྒྲུབ་པ་ཚུལ་བཞིན་བགྱིས།",
    "རྣམ་འཇོམས་དང་སྨེ་བརྩེགས་ཀྱི་བྱབས་ཁྲུས་རྒྱས་པ་ཉིན་རེ་བཞིན་རེ་མོས་ཀྱིས་ཕུལ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་རྗེས་གནང་།",
    "སྨེ་བརྩེགས་ལྗང་ནག་གི་རྗེས་གནང་བཅས་སོང་།",
    "བེང་དམར་ནག་གི་རྗེས་གནང་བཅས་སོང་།",
    "བཀའ་བཅུ་ཀུན་དགའ་བསམ་འགྲུབ་ཀྱིས་ངེད་རང་གི་འཁྲུལ་གཏམ་རིང་མོ་དང་།",
    "ཚེས་བཞིའི་ཉིན་འདུ་ཁང་དུ་མགོན་པོ་ཚེ་དཔག་མེད་ཀྱི་གསུང་ཆོག་ངེད་རང་གི་གསར་བསྒྲིག་སྟེང་ནས་རྒྱས་པར་གནང་།",
    "གཙང་ཁང་དུ་ཁྲིའུ་ཤིང་གི་ཁར་སྟག་ལྤགས་བཏིང་ནས་འབོད་པ་གནང་།",
    "ལྐོག་འགྱུར་གྱི་བསླབ་དོན་བག་ཕེབ་པར་གནང་ཞིང་ཕྱག་གི་ཞགས་པ་དང་།",
    "ཁྱོན་ཞག་དགུ་འགོར།",
    "སྟོན་མོ་དཔངས་མཐོ་བར་འདུག་ཅིང་།",
    "རེ་ཞིག་སྡོད་དགོས་ཕེབ་པས་བཀའ་ལྡོག་མ་ནུས།",
    "སྟེང་གི་གཟིམས་ཆུང་དུ་བསྡད།",
    "རྗེས་གནང་གི་རིགས་སོགས་ཆག་མེད་དུ་ཡུམ་སྲས་ལྷན་དུ་ཕུལ།",
    "སྐུ་ཁམས་ཀྱང་རིམ་བདེ་བྱུང་ཀྱང་ཞག་བཅོ་བརྒྱད་སོང་ནུབ་རྐྱེན་གདོན་ཞུད་ལྟ་བུས་ཟླ་བ་གཉིས་པའི་ཚེས་ཉེར་གཅིག་གི་ནུབ་སྐུ་ཚེས་མ་ཟིན་པར་སྐུ་ལ་བསྙུན་ཟུག་སོགས་གང་ཡང་མེད་པར་གཤེགས།",
    "དེ་ནས་བསམ་ཡས་སུ་རྡོར་ཕྲེང་གསན་མི་རྣམས་འཛོམ་ཆེས་པས་དགོངས་ཁྲོལ་ཞུས་པས་འདི་གར་ཡང་རྡོར་ཕྲེང་ཚར་གཅིག་དགོས་ཕེབ་པར་བཅོ་བརྒྱད་ནས་དཀྱིལ་ཐང་དང་ཕྱག་དཔེ་གཡར་ཞུས་ཀྱིས་ཉིན་བསྟར་རྡོར་ཕྲེང་གི་དཀྱིལ་འཁོར་གསུམ་བཞི་རེ་ཞལ་ཕྱེ་བའི་སྐུ་ཞང་ལགས།",
    "དེ་ནས་ཞག་བདུན་དྲུག་གི་ཐོག་ཏུ་གྲོལ་བ་གནང་རྒྱུ་ཉེར་དགུའི་ཉིན་ཡིན་ཀྱང་།",
    "བསམ་ཡས་སུ་རྡོར་ཕྲེང་གི་རིང་སྡོད་གནས་བཟན་ཤིང་སོགས་མཁོ་རྒུའི་ཡོ་བྱད་གང་དགོས་འོང་བའི་བཀའ་དྲིན་སྩལ།",
    "སྔོ་ནས་སྦྱིན་འབྲས་ཡིན་ན་མ་གཏོགས་སྐུ་ཁྲེས་རེ་ལྗི་རང་བྱུང་སོང་།",
    "དུས་འདི་དག་གི་གནས་ཚུལ་ལ་བསམས་ན་འདི་ཙམ་ཐོབ་སྟེ།",
    "དུས་རེ་འགའ་སྐྱིད་པའི་ཉི་མ་ཤར།",
    "དུས་རེ་འགའ་སྣ་ཚོགས་ཀྱི་སྡུག་བསྔལ་མྱོང་།",
    "དེ་དག་གི་གནས་ཚུལ་ལ་ལེགས་བསམས་ན།",
    "སྡུག་བསྔལ་རྣམས་རང་གི་ལས་འབྲས་ཡིན།",
    "ཉིན་བསྟར་གྱིས་ཕྱོགས་འདུས་རང་གྲྭ་བཅས་པ་ཐམས་ཅད་ཀྱིས་མང་ཇ་བཞེས་ཐུག་ཉིན་རེར་གསུམ་བཞི་རེ་མ་ཆག་པར་བྱུང་ཞིང་།",
