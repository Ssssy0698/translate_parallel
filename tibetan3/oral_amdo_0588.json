    "དགེ་སློང་ཕར་ཆེར་གྱིས་གོས་དར་གྱི་སྣམ་སྦྱར་དང་བཅས་ཕེབ་པས་དགའ་སྤྲོ་དཔག་ཏུ་མེད་པ་བྱུང་ཞིང་བདག་ཅག་གི་སྟོན་པ་སྐུ་དྲིན་ཅན་དེའི་སྐུ་དྲིན་རྗེས་སུ་དྲན་ནས་དད་པའི་མཆི་མ་གཡོ་བར་གྱུར།",
    "ཚེས་བརྒྱད་ནས་གྲྭ་ཚང་རྣམས་སོ་སོའི་གྱེས་ནས་རང་རང་གི་དགོན་གནས་སུ་ཕེབ།",
    "བྱེ་རྫིང་ཚོགས་པ་བདུན།",
    "སྟག་རྩེ་རབ་འབྱམས་སོགས་སེར་མོ་བ་ཉིས་བརྒྱར་ཉེ་བ་དང་།",
    "འདི་སྐབས་མཆོད་གཡོག་དེང་སང་གྲྭ་ཚང་གི་དཔོན་སློབ་བློ་གསལ་བསྟན་འཛིན་ཡིན་པས་ཁོང་ཐུགས་རབ་ཆེས་པས་འཁྲུལ་མེད་བྱུང་ཞིང་ཕྱག་ལེན་ངེས་པར་ཡོད།",
    "ལོ་འགའ་རེར་གཉིས་རེ་དགོས་པའང་བྱུང་།",
    "ཞག་ཉི་ཤུ་རྩ་བདུན་སོང་།",
    "དང་པོ་གསང་ཕུའི་གྲྭ་ཚང་རྣམས་འཁར་རྔ་མ་རྟོགས་དུང་གི་སྲོལ་མེད་ཀྱང་ཕྱིས་སུ་རྒྱས་ཆེར་སོང་བའི་གྲྭ་ཚང་རྣམས་ནས་དུང་གྲྭ་བསྒྲིགས་མཛད་པ་བྱུང་སོང་ཞིང་།",
    "རང་རེའི་གྲྭ་ཚང་འདིར་ཡང་ཚོགས་དུང་རག་གཤོག་མ་ཐར་སོང་ཞིག་དཔོན་སློབ་བསམ་གཏན་གྱི་དུས་གྲྭ་བསྒྲིགས་པ་གནང་ཡང་སེར་ཚོགས་ལ་སོགས་པའི་དུས་ཀྱང་ངོ་གནོང་བ་འོང་འདུག་གཤིས་སྔ་སོར་རང་གི་ལྷག་བསམ་རྣམ་པར་དག་པས་དུས་ཇ་ཞིག་སྦྱོར་དགོས་འདུག་ཀྱང་།",
    "བལ་པོའི་གླ་ལྟོ་སོགས་བསྡོམས་པར་དངུལ་སྲང་ལྔ་བཅུ་ང་གཉིས་རྩིས་སོང་།",
    "བླ་བྲང་ནས་དར་ཚོན་སྣ་ལྔ་ཆ་རེ་ཕུལ།",
    "ཞེས་གསུངས་པ་ལྟར་ཕྲག་པ་སྦྲུལ་འཚངས་ནས་དོག་བོར་མ་བདེ་བ་དག་ནི་ཀུན་སློང་གིས་བདག་བསྟོད་གཞན་སྨོད་བྱེད་པའང་སྣང་།",
    "དྲི་ཞིམ་དགྲ་བོར་འཛིན་པའི་མིག་གིས་མཐོང་།",
    "རེ་ཞིག་ཅིས་ཀྱང་སྡོད་ཕེབ།",
    "ནུབ་གཅིག་རྗེས་གནང་གི་ཕྱག་དཔེ་གཟིགས་རྟོག་གནང་འདུག་པར་དེ་འདྲའི་སྐུ་བསྙེལ་བ་མི་དགོས།",
    "འདི་ལོ་དགུང་ལོ་རེ་དགུའི་སྟེང་དུ་ཕེབ་པ་ཡིན་ཞིང་།",
    "འབུམ་པ་ཐང་ནས་རི་ཟུར་དུ་མ་སླེབས་བར་ཐོག་གི་བད་ཟུར་ནས་དབུ་སྐྱ་རིལ་བཞུགས་པ་གནང་འདུག་པས་ཀྱང་སེམས་ཤིན་ཏུ་སྐྱོ་བའི་ཚད་ཅིག་ཏུ་བྱུང་།",
    "དེ་ནུབ་དེས་གོང་དུ་བསྡད་པར་ཡང་ནུབ་མོ་ཉལ་དུས་གཟིམས་ཆུང་རྩེ་ནས་ཐུགས་རྟོག་གནང་བ་དེ་དྲན།",
    "གྲྭ་ཚང་ལ་ཀུན་རིག་གི་ཆོ་ག་ཉིན་གཉིས།",
    "ཆིབས་བསུ་སེར་སྦྲེངས་སོགས་ཧ་ལས་པར་བྱུང་སོང་།",
    "བྱེ་རྫིང་ཚོགས་པ་བྱང་འདྲེན་ཕྲིན་ལས་སོགས་དྲུག།",
    "མ་ནས་རང་ལོ་སོ་བདུན་ནས་བཟུང་བསྙེན་རྫོགས་ལས་གྲལ་བྱུང་རེས་ཀྱིས་ལས་སློབ་ལ་འགྲོ་དགོས་ཀྱིན་ཡོད།",
    "གདུལ་བྱ་རིག་ལུང་སོགས་འཕེལ་བར་བྱུང་ཀྱང་འཁྲུགས་ཟིང་གི་མགོ་ཚུགས།",
    "གསང་ཕུ་གྲྭ་ཚང་རྣམས་ནས་ཀྱང་མི་བཅུ་རེའི་ཐོག་ནས་མི་རེ་དམག་ཏུ་འགྲོ་དགོས་པ་སོགས་མི་བདེ་བའི་ངང་དུ་སོང་།",
    "ཁྲི་གསར་དོལ་ནས་ཟིན་པ་སོགས་བུན་ལོང་དེ་ཁའི་ངང་ལ་དབྱར་འཁྱོལ།",
    "ཆིབས་བསུ་སོང་བར་བ་རྒྱུག་རྟ་རྒྱུག།",
    "འདི་ལོ་ཤེལ་གྲོང་གི་ནས་བཀར་རྒྱར་བཅུག་ཅིང་དུས་མཆོད་ཀྱི་འཁུར་ཀྱང་བླ་སྤྱི་མི་སྣ་ཐུན་མོང་ནས་བྱེད་པར་བྱས་ཤིང་ཟླ་བོ་རྣམས་ནི་ཁག་སྦྱོང་ཆེ་བར་བྱུང་ཀྱང་ངེད་རང་ནི་སོ་བསོད་པོ་བྱུང་།",
    "ལོ་སྔོན་མ་ཕག་ལོ་ཟླ་བ་ལྔ་པའི་མཇུག་ཏུ་བདག་གི་མ་དྲིན་ཅན་མ་བགྲེས་མོ་དགུང་ལོ་བརྒྱད་ཅུར་ཕེབ་པ་གཤེགས་ཁར་དབུ་སྔས་མགོར་སླེབས།",
    "སླར་སྐུ་གདུང་གི་ཞབས་ཕྱི་མེ་མཆོད་འབུལ་བ་སོགས་ཀྱང་སྦྱོར་དངོས་རྗེས་གཙང་ཞུས།",
    "མ་དྲིན་ཅན་གྱི་དྲིན་དེ་གཞལ་བར་དཀའ་མོར་གདའ།",
    "སྤྱི་སོ་རང་གི་སྐམ་འགྱེད་ལོགས་སུ་བཏང་ནས་དུས་ཆེན་ཡན་ཆད་གེགས་མེད་དུ་འགྲུབ་པའི་གཞི་བཙུན་རྣམས་ལའང་མང་ཇ་འགྱེད།",
    "གཞུང་གི་ཞབས་བརྟན།",
    "འདི་ལོ་ཟླ་བ་ལྔ་པའི་ནང་དུ་བདག་གི་ཕ་དྲིན་ཅན་དེའང་དགུང་ལོ་གྱ་ལྔའི་སྟེང་དུ་གཤེགས།",
    "དུས་མཆོད་ཀྱི་སྟབས་ནས་ངེད་རང་སྐུ་གདུང་གི་ཞབས་ཕྱི་སོགས་ལ་འོང་མ་ཐུབ་ཀྱང་བློ་གསལ་གྱིས་ཕྱིན།",
    "བདག་གི་ཕ་རྒན་འདི་རྒྱུན་དུ་གཙུག་ཏོར་རྣམ་རྒྱལ་མའི་གཟུངས་རིང་ཚར་ཉི་ཤུ་རྩ་གཅིག་རེ་དང་།",
    "མཚན་བརྗོད་ཚར་བདུན་རེ་ལ་ཉུང་མཐའ་བྱས་པ།",
    "འོན་ཀྱང་ལྷག་བསམ་རྣམ་དག་གི་བརྩེ་བས་ཀུན་ནས་བསླངས་པས་ཉེས་པ་ཅུང་ཟད་ཆུང་བ་ནི་ལོས་འོང་།",
    "གཞུང་སར་ཡང་དགོངས་ཁྲོལ་ཞུས་གྲུབ་མོད།",
    "སྤྱིར་དད་ཟས་འདོད་ཡོན་གྱི་རིགས་འདི་བདུད་ཀྱི་བསླུ་ཁྲིད་ཁོ་ན་ལས་ཉེ་བར་གཞིགས་ན་རང་ཉིད་འཆིང་བའི་ཐབས་འབའ་ཞིག་ཏུ་མཆིས་མོད།",
    "གཟུགས་ཅན་རྣམས་ཀྱིས་ཀྱང་ཨུ་ཚུགས་མཛད་བྱུང་མོད།",
    "གྲྭ་ཚང་དུ་མང་ཇ་དང་འགྱེད་སྔ་རྟིང་གཉིས་ཟླ་བ་བྱུང་ངོ་ཅོག་གི་ཚེས་བཅུ་བཞིར་དུས་ཇའི་ཐེབས་དངུལ་སྲང་བཅུ་གསུམ་ཕུལ།",
    "ཚིག་སྟོང་ཤོག་གི་ཞལ་པོ་མང་ན་ཡང་།",
    "ངེད་རང་གིས་བསམ་ཡས་ཤག་ཏུ་སྤོས།",
    "ཚན་གྲངས་སློག་ཀྱང་ཟབ་པར་ཕུལ་སོང་།",
    "ངེད་རང་གི་བསམ་པར་གྲྭ་ཚང་འདིར་འཆད་ཉན་སོགས་ས་སྟེང་བགག་ཐུབ་ཙམ་བྱུང་།",
    "རེ་ཞིག་བར་འགོལ་སྡོད་བྱས།",
