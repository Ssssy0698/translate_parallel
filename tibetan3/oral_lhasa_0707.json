    "འཇིག་རྟེན་ཀུན་གྱིས་མཐོང་ན་དགའ་བ་དང་། ། སྐུ་གཟུགས་དེ་ལ་རྡུལ་ཕྲན་ཆི་ཡོད་པ།",
    "ཀུན་མཁྱེན་གོ་འཕང་ཐོབ་ལས་གཞན་དུཎྱེ།",
    "དེ་ལྟའི་ཕན་ཡོན་ཐོབ་པར་གསུངས་གྱུར་ན།",
    "ཉིན་མཚན་ཀུན་ཏུ་ཅི་དགར་སྤྱོད་པར་ཤོག།",
    "དོན་གཉིས་ཕུནཚོགས་ནོར་ལ་སྤྱོད་པར་ཤོག།",
    "ཐུགས་བསྐྱེད་བཞེད་ཀུནལྷུནགྱིས་གྲུབ་པར་མཛོད།",
    "བཟོ་ཡི་རིག་བྱེད་མཐར་སོནཚོགས་བསྡུས་ནས། ། ཀ་གདུང་ལྕམ་དྲལ་ལ་སོགས་རྒྱུ་གཙང་ལས།",
    "ཐོས་པས་ཀུན་གྱི་སྡིག་སྒྲིབ་བྱང་བར་གསུངས།",
    "བདེ་བ་ཅན་གྱི་ས་བོན་ངེས་པར་ཐེབས།",
    "ཕྱིར་མི་ལྡོག་པའི་ས་ཐོབ་ངེས་གསུངསན།",
    "ཕྱིར་མི་ལྡོག་པ་ཉིད་དུངེས་གསུངས་ན།",
    "སྒྲུབ་པར་བྱེད་རྣམས་མྱུར་དུ་འཚང་རྒྱུ་ངེས།",
    "ཐེ་ཚོམམེད་པར་གྱིས་ལདད་པ་སྒོམས།",
    "སྐད་ཅིག་ཉིད་ལ་ངེས་པར་རྫོགས་པར་གསུངས།",
    "ཡིགེ་དྲུག་པ་ངེས་པར་དར་བར་གསུངས།",
    "དགོངས་པར་སྣང་བས་ཡིད་ཆེས་བརྟན་པོ་མཛོད།",
    "རབ་ཏུ་འཕགས་པ་བཞུགས་གནས་མཆོད་རྫས་བཅས།",
    "མཐུ་དང་སྟོབས་དང་མཁྱེན་བརྩེ་ཞུས་པ་སོགས།",
    "འདི་ལྟའི་ལེགས་བྱས་ལམ་གསུམ་འགྲོ་བའི་རྒྱན།",
    "ཕུལབྱུངམཁྱེན་བརྩེནུས་པའི་གྲིབ་བསིལ་གྱིས།",
    "ཟབ་ཡངས་མཁྱེན་པའི་གཏིང་མཐའམི་མངོན་༴",
    "དགེ་འདིས་པཎ་ཆེན་ཐམསཅད་མཁྱེན་པ་དང་།",
    "ཐུབ་པའི་བསྟན་པ་སྤྱི་དང་ཁྱད་པར་དུ།",
    "རྫོགས་ཏེ་རྣམ་མཁྱེན་ཐོབ་པའི་ཆེད་དུ་དམིགས།",
    "བརྒྱན་ཏེ་ཤིང་ཁྲིའི་དྲ་མིག་སོ་སོར་བཞུགས།",
    "ཕ་རོལ་ཕྱིན་དྲུགཡོངས་སུ་རྫོགས་པར་འགྱུར།",
    "ལུས་དེ་རྡོརྗེའི་ལུས་སུ་རིག་པར་བྱ།",
    "རིང་བསྲེལ་མཆོད་རྟེནཉིད་དུ་རིག་པར་བྱ།",
    "ཕུང་པོའི་ཚད་ནི་བགྲང་བར་མི་ནུསགསུངས།",
    "མཐར་ཐུག་རྣམ་མཁྱེན་ཐོབ་སོགས་ཟ་མ་ཏོག།",
    "འཚལ་བ་ཕན་ཡོན་ལྷག་པར་ཆེ་བར་གསུངས།",
    "དེ་སོགས་ཕནཡོནགསུངས་ལ་ཡིད་ཆེས་ཀྱི།",
    "ལུང་རྟོགས་བསྟན་པ་ཕྱོགས་བརྒྱར་རྒྱས་པརཤོག།",
    "མི་མཐུན་རྒུད་པའི་མིང་ཡང་མི་གྲགས་པར།",
    "ཆར་ཆུ་དུས་འབབ་ལོ་ཕྱུགས་རྟག་ལེགསཀྱི་དགེ་མཚན་རྒྱ་ཆེནགསར་པ་ངོམས་པརཤོག།",
    "གནསགཙང་ལྷ་ཡིས་བསྐལ་པ་བཟང་པོ་ཞེས།",
    "སྒྱེ་འགྲོ་སྤྱི་དང་ཁྱད་པར་ཡུལ་ཕྱོགས་འདིའི།",
    "ཡིན་པར་རྣམ་སྣང་མངོན་བྱང་རྒྱུད་ལས་གསུངས།",
    "སྐུ་གཟུགས་རྣམས་ལ་རྡུལ་ཕྲནཅི་ཡོད་པ།",
    "ཕན་བདེའི་པད་ཚལ་ཀུནཤས་རྒྱས་པར་ཤོག།",
    "ཡུལ་ཕྱོགས་སྤྱི་དང་ཁྱད་པར་གངས་ལྗོངས་འདིར།",
    "དབུས་གཙང་རུ་བཞིའི་དཔགབསམ་ལྗོན་པའི་ནང་།",
    "ཇོ་ལགས་ཚེ་ཕུན་ལགསཞས་ལྷོ་གདུང་གཉིས།",
    "འོད་ཀྱིས་སྣོད་བཅུད་མ་ལུས་གསལ་བྱས་པས།",
    "ངོ་མཚར་རྟེན་དང་བརྟེན་པར་བཅས་པ་ལ།",
    "ལུང་རྟོགས་ནོར་བུས་ཐུགས་རྒྱུད་ཕྱུག་པར་ཤོག།",
    "ཕན་བདེའིདཔལ་ལ་རྟག་ཏུ་སྤྱོད་པར་ཤོག།",
    "རྟག་ཏུ་བསྲུང་སྐྱོབགཡེལ་མེད་བྱེད་པར་ཤོག།",
    "དགོན་འདི་ལ་ཅུང་ཟད་བསྟོད་པར་བྱ།",
    "ནང་དག་པའི་ཞིང་ཁམས་ཁྱད་པར་ཅན།",
    "ལམ་བསླབ་པ་གསུམ་གྱི་ཉམས་བཞེས་དང་།",
    "ཡུལ་དབུས་གཙང་ཞིང་ཁམས་ཀུན་ཏུ་འཕེལ།",
    "ལསསྡིག་སྒྲིབ་མ་ལུས་ཟད་པར་བྱེད།",
    "ཕ་གངས་རིའི་མགོན་དང་མཚུངས་པར་ཤོགདཔལ་ཨ་ཏི་ཤ་དང་འབྲོམསྟོན་རྗེ།",
    "ཞིང་གང་ན་བཞུགས་པ་དེར་སྐྱེས་ཞས།",
    "གསུང་བདུད་རྩིའི་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "མཐརཕྱིན་ཀུནམཁྱེན་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "མཁྱེན་བརྩེའི་ཆུ་འཛིན་འཁྲིགས་པའི་ཀློང་དཀྱིལ་ནས།",
    "འགྱུརམེད་རྡོ་རྗེའི་མཆེད་ཟླར་བརྟན་པར་བཞུགས།",
    "བསམ་དོན་མ་ལུས་ཡིད་བཞིན་འགྲུབ་པར་ཤོག།",
    "ཅེས་པའདི་ནི་སྣར་ཐང་པར་དཔོན་སྐུ་མཆེད་ཆུ་ནས་བསྐུལ་མ་བྱུང་བ་ལྟར་༩དགེ་སློང་བློ་བཟང་སྦྱིན་པས་ཕུལ་བ་དགེ་ལེགས་འཕེལ་བར་གྱུར་ཅིག།",
    "གནས་ཁང་བྱི་དོར་བྱས་ལ་སྐུ་གསུང་ཐུགས་ཀྱི་རྟེནབཀྲམ་པ་དང་།",
    "མདུནན་གླེགས་བམ་དང་བཅས་དགྱེས་བཞིན་བཞུགས།",
    "ཞས་འོད་ཕུང་དབུསན་སྐྱིལ་ཀྲུང་ཚུལ་གྱིས་བཞུགས།",
    "ཐུགས་རྗེས་ལས་བཞེསནས་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "གཞུང་ལུགས་ཀུན་མཁྱེནསདས་རྒྱས་ཡེ་ཤེས་ཞབས།",
    "ལེགས་པར་བཞེས་པ་ཡིན་ཞེས་རྒྱུད་ལས་གསུངས།",
    "བླམ་དགྱེས་པའི་ཐབས་ལ་འབད་པར་བྱ།",
    "ཡིད་བཞིན་ནོར་བུ་ལས་ཀྱང་ཆེས་ལྷག་པར།",
    "མི་ཉིད་ཆེས་ཐོབ་དཀའ་བར་གསུངས་པས་ན།",
    "རྙེད་པར་དཀའ་ཞིང་རྙེད་ན་ངོནཆེ་བའི།",
    "དེ་ཡི་སྟེང་དུ་མཚོན་གྱིས་གཤོག་པར་བྱེད།",
    "སྲོག་ལསགཅེས་པར་བསྲུང་བའི་ཐབས་ལ་འབད།",
    "ལམ་བཟང་བལྟ་བའི་བློ་མིག་མི་ལྡན་པར།",
    "ཐམས་ཅད་མཁྱེན་པའི་ལམ་ལ་འགོད་ནུསཔས།",
    "ཁྱད་པར་ཞི་ལྷག་ཟུང་འབྲེལ་རྣལའབྱོརལ།",
    "རྩ་བ་ཤེས་རབ་ཡིན་པར་གསུངས་པསན།",
    "བྲལ་བར་རྩེ་གཅིག་མཉམ་པར་འཇོག་པ་གཞད།",
    "ཉམས་སུ་ལེན་དགོས་པར་གདམས་པའོ།",
    "གསུམ་པ་ཉམསསུ་ལེན་དགོས་པར་གདམས་པ་ལ།",
    "བཀའ་དྲིན་རྗེས་སུ་དྲན་ཏེ་གུས་པར་བྱ་བའོ།",
    "གཉིས་པ་བཀའདྲིན་རྗེས་སུ་དྲན་ཏེ་གུས་པར་བྱ་བ་ལ།",
    "རྙེད་པར་དཀའ་ཞིང་རྙེདན་དོནཆེ་བའི།",
    "གཉིས་པ་ཐརཔར་བགྲོད་བྱེད་ཀྱི་ལམ་བསླབ་པ་གསུམ་ལ་སློབ་ཚུལ་ལ་གཉིས།",
    "ཁྱད་པར་ཐེག་གསུམ་ཡོན་ཏན་ཞེས་སོགས་ཤོ་ལོ་ཀ་གསུམབྱུང་།",
    "ལན་དང་རྣམ་པརཞེསསོགས་ཚིགས་བཅད་གཅིག་བྱུང་།",
    "ཁྱད་པརངར་འཛིན་ཞེསསོགས་ཚིགས་བཅད་གཅིག་བྱུང་།",
    "བློ་གྲོས་རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་ཞས།",
    "བྱོནརིམ་ས་༧་། ཞུ་འཕྲིན་གྱི་རིམ་པ་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པ་བཞུགསསོ།",
    "དུས་འདིར་སྐྱེ་འགྲོའི་ལེགས་བྱས་མཁའ་དབྱིངས་སུ།",
    "རང་ལུགས་གླིང་བཞིའི་དཔལ་དུ་བརྟན་པར་བཞུགས།",
    "དབེན་གནས་འགྱུར་མེད་སྐུ་མཚམ་པར་ཕུལ་བ་མཁས་པའི་མགུལ་རྒྱན་བཞུགསསོ། ། དག་སྣང་ཕྱོགས་མེད་ལྷ་ཡིལམ་བཟང་ལ།",
    "མཁྱེན་བརྩེ་ནུས་པ་གསུམ་གྱི་དྲི་བཞོན་གྱིས།",
    "ལགས་སམ།",
    "ལས་ཉོན་བྱན་ཟའི་ཚ་གདུང་སེལ་ལགསསམ། ། མཁས་ལསགསུམ་གྱི་དྲི་ཟའི་གླིང་བུའི་སྒྲས།",
    "བསྟན་འགྲོའི་ཕན་བདེའི་བུམ་བཟང་འགེངས་ལགསསམ།",
    "ཉེར་འཚེའི་རྙོག་པས་གོས་པ་མེད་ལགས་སམ།",
    "ཐབས་ལ་ཟབ་བཞེས་ནམ་ཡང་ལྷོད་མེད་ནས།",
    "ཧ་ཅང་བརྩེ་བས་བདག་ཅག་མི་བསྐྱུད་པར།",
    "ཉེར་འཚེའི་རྙོག་པ་སེལ་བའི་ཟབ་བཞེས་ཐོག།",
    "ཞུམ་པ་མེད་པར་མཆོག་དམན་ཞང་རྣམས་ལ།",
    "། དོན་ཁང་ལྷ་སྲས་སྐུ་ཞབཱ་ལྷ་ལྡན་དུ་ཕེབས་སྐབས་ཕུལས་འཆི་མེད་བདུད་རྩིའི་ཆུ་རྒྱུནཅེས་བྱ་བ་བཞུགས། ། སོར་གདུབལྡན་པའི་མཉེན་ལྕུག་ཕྱག་སོར་གྱི།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པ་མ་ལུས་དང་།",
    "སྲིད་མཚོར་བྱངས་ཀྱང་ཐར་ཐབས་མི་བྱེད་པར།",
    "ཡང་ཡང་གནང་སྐྱེས་བཟང་པོའི་འབབ་ཆུའི་རྒྱུན།",
    "སྔོན་དུ་བཀའ་མངགས་གནང་དོན་གཟུངས་བསྒྲིལ་སྐབས།",
    "གཡེང་ནས་ལུས་པར་དབྱིངས་ཁྲེལ་མ་གྱུར་ཏམ།",
    "གནོང་ཞིང་འགྱོད་པའིསེམས་ཀྱིས་བཤགས་ལགས་ན།",
    "གསུངས་པའི་ཚིག་དོན་དོན་བཞིན་གདུལ་བྱ་ལ།",
    "རྒྱལ་ཀུན་མཁྱེན་པའི་ཆུ་གཏེར་ལས་འོངས་པའི།",
    "མཁྱེན་རབ་ཐོགས་པ་མེད་པར་འཇུག་དགུ་གམ་སྙམ།",
    "ཀུན་རྨོངས་དགྲ་ཚོགས་བཅོམ་པའི་དཔའ་རྟགས་ལགས།",
    "འཛིན་བྱེད་བགྲང་བྱའི་སྣྲོན་ཟླའི་ཚེསལ་ཕུལ། ། སྐྱབས་མགོན་མཛེས་པར་ཕུལའའི་ཟིན་བྲིསབཞུགས། ། བཀྲ་ཤས་འཁོར་ལོས་མཚན་པའི་ཞབས་ཟུང་མཐིལ་།",
    "ཕནབདེའི་འདབ་བརྒྱའི་གཉེན་དུ་བཞུགས་མུས་ནས།",
    "ཀུན་གསལ་ཕ་མཐའ་འཚོལ་བྱའི་གཡོས་པར་གྱུར།",
    "གཡོ་མེད་རྡོ་རྗེའི་མཆེད་ཟླར་བརྟན་བཞུགས་ནས།",
    "གཞན་གྱི་འདྲེན་པར་རློམ་པའི་གཉིས་ཕུང་ཀྱང་།",
    "འཛིན་བྱེད་བགྲང་བྱའི་སྣྲོན་ཟླའི་ཚེས་འཕུལ། ། དགེ་འཕེལ་སྐུ་མཚམ་པར་ཕུལ་བའི་ཞུ་འཕྲིན་བཞུགསོ། ། དད་ལྡན་སྐྱེ་འགྲོ་ཡོངས་ཀྱི་གཙུག་རྒྱན་དུ།",
    "བཞེངས་ནས་འགྲོ་བ་འདྲེན་པར་གདོན་མི་ཟ།",
    "ཁྱད་པར་འདི་མདུན་གནང་བ་བཀའ་དྲིན་ཆེ།",
    "པ་སངས་ལྟ་བུར་རབ་དཀར་ལེགས་བྱས་ཀྱིས།",
    "ཚ་གྲང་ཁྱད་དུ་བསད་ནས་བགྲོད་བྱས་ཀྱང་།",
    "མཁྱེན་བརྩེའི་ནུས་གསུམ་ཐོགས་པམི་མངའ་བའི།",
    "ཡརབས་སྤྱོད་པའི་མེ་ཏོག་རྣམ་པར་མཛེས།",
    "ཡིད་མ་ཆེས་པར་སྐྱབས་མཆོག་བཤེས་གཉེན་གྱི།",
    "དེང་སང་རྒན་གཞོན་གོ་རིམ་མ་ངེས་པར།",
    "མཚུངས་པར་མ་ཟད་དམ་པས་སྨད་མཐོང་ནས།",
    "ལེགས་བྱས་ཉལ་འགྲོའི་རྫིང་བུ་ལས་ཐོན་པའི།",
    "ངག་འདོན་ཆོགའི་ཡལ་འདབ་མ་ཉམས་པར།",
    "མངཙམམེདཔར་དབེན་པའི་རི་སུལ་དུ།",
    "ལྷག་པར་དེང་སང་ཕྱིནང་གེགས་མང་བས།",
    "ཤེས་བྱའི་བྱ་ལམ་ཡངས་པར་ཐོགས་མེད་རྒྱུ།",
    "སྐྱེ་འགྲོའི་ཕན་བདེའིམྱུ་ཀྲུ་སྤེལ་བཞིན་པར།",
    "ཐོསཚོ་དབེན་པར་རྙེད་བཀུར་སྙན་གྲགས་ལ།",
    "རྡོ་རྗེ་འཆང་ཆེན་ཧ་ཅང་མང་བསནོར་འཛིན་དོག་པོར་བྱས་ཀྱི་དོགས།",
    "བསྟན་འགྲོའི་དཔལ་མགོན་དམ་པར་ལེགས་བསྔགས་པས།",
    "དེ་ཕྱིར་སྲིད་མཐའི་བར་དུ་ལགས་བཞུགས་ནས།",
    "སྤྲས་པའི་གཟུགསསྐུ་ཆབ་འགྲུབ་པར་གདོན་མི་ཟ།",
    "ཤོག་དེང་དུས་ལེགས་བྱས་རིན་ཆེན་རྣམ་བཞི་ལས།",
    "མཛད་བཟང་བང་རིམ་མངོནམཐོར་བཞུགས་པ་ལེགས།",
    "བསྙུན་གཞིའི་ཚ་གདུང་སེལ་ཐབསསྔའ་བཞིན་མཁྱེན།",
    "མཾསའིལྷ་ཆབ་གཙང་མའི་རྒྱུན་བཟང་སྤྲོས།",
    "གཞན་དྲང་མི་འཇོག་མཁྱེན་པའི་རླབས་འཕྲེང་དང་།",
    "བདག་ཅག་བལྟོསཔར་བཅས་ལ་ཕན་བདེའི་དཔལ།",
    "མྱུར་དུ་བྲལ་བའི་ཟབ་བཞེས་ལྷོད་མེད་མཛོད།",
    "གཏིང་དཔག་དཀའབའི་མཁྱེན་ཡངསརྒྱ་མཚོའི་ངོགས།",
    "ལྷག་པར་དགའ་བའི་དྲི་བཞོན་གྱིས་བསྐྱོད་དེ།",
    "རྗེཉིད་གདན་སར་ཕེབས་བསྐྱོད་བྱུང་ན་དང་།",
    "གངས་ཅན་འགྲོ་བའི་ལེགས་བྱས་རྟ་བདུན་གྱིས།",
    "འཕགས་ནོར་བདུན་གྱིས་ཐུགས་རྒྱུད་འབྱོར་ལགསསམ།",
    "འཛམ་གླིང་སྒྱེ་བོའི་ཚེ་ལ་ལོང་མེད་པར།",
    "ཁྱད་པར་ཕྱིམའི་རྒྱགས་ཕྱེ་གསོག་ལ་བརྔམ།",
    "ཡུན་རིང་གནས་པའི་ཟབ་བཞེས་ལྷོད་མེད་ནས།",
    "མི་རྗེ་སྐུ་ཞབས་ཆབ་བཞུགས།",
    "དམ་པའི་མན་ངག་སྦྲང་རྩིར་སྤྱོད་བཞིན་པར།",
    "རྣལ་འབྱོར་ཐུན་བཞིའི་སྒོ་ནས་སྐྱོང་མུས་ལགས།",
    "གསལ་ནས་ལྷག་པར་བཀའ་དྲིན་དྲན་པ་དང་།",
    "མཛད་བཟང་དྲི་བསུང་འཐུལ་བཞིན་བཞུགས་ལགསསམ།",
    "ལྔ་ལམ་གྱུར་དེའི་ཆེད་སྩལ་སྤྱི་བོར་ཕེབས།",
    "འཆིབརམཟད་ནམ་འཆི་ངེས་མེད་པར།",
    "གསུངས་པའི་དོན་ལ་ངེས་པ་གཏིང་ནསརྙེད།",
    "སྒོ་གསུམ་རྣམ་དཀར་དགེལ་བརྩོན་པར་མཛོད།",
    "རྒྱུད་གྲྭའི་ཀུན་གསལ་ངོགས་སུ་བཞུགས་སྤྲོའམ།",
    "མཚན་དཔེའི་གཟི་བརྗིད་ལྷམམེར་བཞུགས་ལགས་སམ།",
    "རྣམ་དཔྱོད་མཁྱེན་པའི་དབྱུ་གུས་སྲུབས་པ་ལས།",
    "བརྩེ་ཤོགཆེན་ཐུགས་ཀྱིས་རིང་མིན་སྩོལ་བ་མཁྱེན།",
    "གནང་སྐྱེས་བཟང་པོའི་ཁུར་གྱིས་ནོན་བཞིན་དུ།",
    "ཡབ་རྗེའི་ལུགས་བཟང་རྒྱས་པའི་ཁུར་བཞེས་ཤིག།",
    "སྙིགས་མའི་རྒུད་མུནསེལ་ཕྱིར་བཞུགས་ལགསསམ།",
    "འགྲོ་རྣམས་གྲོལ་བར་མཛད་དགོས་གསུངས་པ་ལ།",
    "། ཞབས་ཟུང་རྡོ་རྗེའི་ཁམསབཞིན་རྟག་བཞུགས་གསོལ།",
    "ཚེ་མཇུག་དོན་ལྡན་ཡོང་བའི་སྐྱབས་འཇུག་མཁྱེན།",
    "སྤོང་བ་བསམ་གཏན་མེ་ཏོག་རྣམ་པར་བཀྲ།",
    "སྐྱེ་བར་ལུང་ལསགསུངས་པའི་ཚུལ་དགོངས་ནས།",
    "མན་ངག་བདུད་རྩིའི་ཆུ་རྒྱུན་རྟག་བཞེས་ཤིག།",
    "མཁྱེན་པའི་ཆ་ཤས་རྫོགས་པའིདཀྱིལ་འཁོར་ནས།",
    "ལྷག་བསམ་བཟང་པོའི་དྲི་བསུང་འཐུལཁཞིན་པར།",
    "ལེགས་ཚོགས་ཀུན་གྱི་རྩ་བ་ཚུགས་པར་བྱ།",
    "ཞེས་པ་ལ་ལནའདི་སྐད་བརྗོད་པར་བྱ་སྟེ།",
    "སོ་སོའི་དྲགེ་མཚན་རྣམས་མིག་ལམ་དུ་མངོན་དུ་གྱུར་ནས་ཤིན་ཏུ་ཡི་རངས་པར་གྱུར་ཏོ།",
    "རབ་དགའི་ས་ཐོབ་བདེས་བྱས་པས།",
    "འགྲན་པར་མ་ནུས་དབྱིངས་སུ་བྲོས།",
    "དེ་ཡང་ལམཁར་གྱིལྗོངས་དེ་དག་ནི་ཆུ་ཀླུང་རྣམ་པ་སྣ་ཚོགས་པ་དང་དྲི་རབ་ཏུ་ཞིམ་པའི་ལྗོན་པ་སྣ་ཚོགས་པས་མཛེས་པར་བྱས་པ།",
    "སྔོན་བསགས་ལེགས་བྱས་མཐུ་ལས་དེ་རིང་མཐོང་།",
    "དགེ་མཚན་དུ་མས་ཀུན་ནས་བརྗིད་པར་གྱུར།",
    "སྤང་དང་ཁ་བའི་ཐོར་ཚུགས་ལྷག་པར་བརྗིད།",
    "བདེ་སྐྱིད་སྦྲང་རྩིའི་དཔལལསྤྱོད་མུས་ལགས།",
    "བློ་ཆུང་བྱིས་པས་ཕན་གནོད་མ་ཤེས་པར།",
    "བཟང་པོའི་སྤྱོད་པ་སྤྱདང་ཁྱད་པར་དུ།",
    "བྱིན་གྱིས་བརླབས་པའི་གཞས་དེར་ཕེབས་སྐད་ལགས།",
    "དེ་ནས་རང་མིན་གདན་སར་ཕེབས་པའིསྐབས།",
    "གངས་ཅན་སྐྱེ་འགྲོའི་ལེགས་བྱས་གངསའིའིསྤོར།",
    "སེངྒེའི་སུལ་བསྟེན་ནས་འཇིགསམེད་པར།",
    "ཚངས་པར་སྤྱོད་པའི་དཀའ་ཐུབ་བརྟུལ་ཞུགས་ཅན།",
    "སྐུ་ཚེ་འདི་ལ་འདྲེན་པར་གདོན་མི་ཟ།",
    "འཁོར་ཚོགས་དབུས་སུ་ཞལ་འཛུམ་ལྷུག་པར་གྲོལ།",
    "འཇིགརྟེན་འདི་ནི་སྐལ་བཟང་ཅི་ཡང་བྱས།",
    "དབེན་པར་འཕགས་པའིརགས་བཞི་ལ་གནས་པ།",
    "སྦྲང་རྩིའི་དགའ་སྟོན་བཟང་པོས་ལྷག་པར་མྱོས།",
    "མངོན་མཐོ་ངེས་ལེགས་འབྲས་བཟང་སྨིན་པརགྱུར།",
    "སེང་ཆེན་རྡོ་རྗེ་འཆང་ལ་ཕུལ་བབཞུགས། ། བློ་བཟང་མ་ལ་ཡ་ཡི་སྐྱེད་ཚལ་དུ།",
    "གུས་ལྡན་སྤྱི་བོའི་རྒྱན་དུ་ཕེབས་པའི་ཚེ།",
    "ནམ་ཡང་འགྲོལ་བ་མེད་པར་དམ་བཅིངས་ནས།",
    "ཉམ་ཆུང་བདག་ཀྱང་ཐུགས་རྗེས་མ་བསྐྱུད་པར།",
    "ཤོག་མེད་སྩོལ་བ་མཁྱེན།",
    "སྐུ་ཞབས་ཕུན་གླིང་སྒྲོལ་མ་ལྷ་ཁང་དུ་བཞུགས་སྐབས་སུ་ཕུལ་བ།",
    "དམ་པའི་བཞུགས་གནས་དབེན་པ་བསྟེན་པའི་མཐུས།",
    "དབེན་པར་སྒྲུབ་ལ་བརྩོན་པ་མཐར་ཕྱན་མཛོད།",
    "དྲི་འཛིན་དྭགའ་སྟོན་འགྱེད་ལ་བརྩོན་པརམཛོད།",
    "ཞབས་བརྟན་སྒྲུབ་དགོས་དང་བཅས་སྤྱིར་ཕེབས་ཚེ།",
    "བྲལ་ཞིང་རི་ཁྲོད་དབེན་པར་གནསམུས་ལགས།",
    "༣། སང་ལོ་ཙཱ་བར་ཕུལ་བའི་ཞུ་འཕྲིན་བཞུགས། ། ལེགས་བྱས་ཟླ་བའི་མ་མ་ལས་འཁྲུངས་ཤིང་།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་པའི་དཔལ་ཐོབཞས།",
    "རི་བོ་བཞན་དུ་མི་འགྱུར་བརྟན་པར་མཛོད།",
    "སང་ལོ་ཙཱ་བར་ཕུལ་བའི་ཞུ་ཕྲིན་བཞུགས་སོ། ། རྒྱལ་བསྟན་༢ཞི་ཆེན་འབྱུང་གནས་ལས་དྲངས་པའི།",
    "དེང་དུས་ལེགས་བྱས་རིན་ཆེན་འབྱུང་ལྡནལས།",
    "གཞིས་རྩེར་ཕེབས་པའི་གཏམ་སྙན་ཐོས་འཛིན་དུ།",
    "རརབ་ལྷུན་པོས་བྱས་ཀྱང་ཆུང་ངམ་སྙམ།",
    "འགྱུར་མེད་རྡོ་རྗེའི་གདན་ལ་བཞུགས་བཞིན་པར།",
    "མཁྱེན་རབ་རྒྱ་མཚོའི་མངའ་བདག་གང་དེ་ཡིས།",
    "བདག་འདྲའི་ཉམ་ཆུང་ཐུགས་རྗེས་མ་བསྒྱིད་པར།",
    "ཉི་མ་ཞེས་པའི་བགྲང་བྱའི་ཚེས་ལ་ཕུལ། ། སྐུ་ཞབས་སང་ལོ་ཙྪ་བར་ཕུལ་བ་དྲང་གཏམ་མངོན་འགྱུརཞེསབྱ་བ་བཞུགས། ། གྲངསཅན་ལྗོངས་འདིར་མཆེན་ཇི་སྙེད་ཅག།",
    "འབྲུ་དང་སྦགབཅས་གནང་བ་ཉམས་མེད་འབྱོར།",
    "ཕོགས་དང་ཇ་ཚུལ་སོག༵་ལ་སྤྱོད་བཞིན་པར།",
    "ལེགས་བྱས་བྱེ་བས་བསྐྲུན་པའི་སྐུའི་དཀྱིལ་འཁོར།",
    "བསྐལ་པའི་བར་དུ་འཚོ་བའི་ཟབ་བཞེས་ལ།",
    "དེང་དུས་སྔོན་བསགས་ལེགས་བྱསཆུ་གཏེར་ལས།",
    "མཛད་བཟང་ཆབད་སྟོང་སྤྲོ་བཞིན་བཞུགས་ལགས་སམ།",
    "ཆོག་ཤེས་མེད་པར་དཀོར་ཟས་གང་བྱུང་ལ།",
    "སྦྱངས་བ་ཅུང་ཟད་ཙམ་ཡང་མ་བརྱས་པར།",
    "ངནཔ་འཚངས་ནས་བརླག་པར་བྱེད།",
    "མཚུངས་ཞེས་འཕགས་མཆོག་ཀླུ་སྒྲུབ་གསུངས།",
    "ཚང་དང་འདྲ་ཞེས་མཁས་རྣམས་གསུངས།",
    "ཐེག་ཆེན་རྩ་བ་བརྟན་པར་བྱ།"
  ]
}