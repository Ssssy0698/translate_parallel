    "དེ་ནས་རྒྱལ་མཁར་རྨེའུ་བསམ་གཏན་གྱིས་བསྒྲིགས་པའི་དེབ་ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན་ཞེས་པའི་ནང་ཚན་དབུ་ནག་མིའུ་འདྲ་ཆགས་ཞེས་པ་ལས་བཤུས།",
    "བོད་ཀྱི་ཕྱིས་སུ་བྱུང་བའི་རིགས་མཐུན་གྱི་གཏམ་རྒྱུད་དམ་བྱུང་རིམ་དག་གི་ཆེས་སྔ་བའི་ཕྱི་མོ་ཡིན་པ་ཐག་གིས་ཆོད་ཅིང་།",
    "རིམ་པ་བརྒྱད་པར་ལྷ་གཡག་དེ་ཞང་ཞུང་གི་ཡུལ་ལ་བབས་པ་དང་།",
    "ཐོ་མ་སིའི་བོད་བྱང་ཤར་གྱི་གནའ་བོའི་དམངས་ཁྲོད་རྩོམ་རིག་ཅེས་པའི་ནང་དུ་རྟ་དང་འབྲོང་གི་གཏམ་རྒྱུད་བརྗོད་པའི་སྐབས་སུ།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "ཁབ་ཕྱི་མོ་གཡག་སྔོ་མ་དང་བཤོས་པའི་སྲས།",
    "ཀོང་ཡུལ་དུ་གཤེགས་ནས་ཐང་ང་ཀོང་མོ་ཐང་དང་བཤོས་པའི་སྲས་ཀོང་ལས་དེ་ཡགདེ་ནས་ཆབ་མ་སྨོན་མོ་ཐང་དང་བཤོས་པའི་སྲས་སྒམ་ལྷའི་ལྷ་སྲས་སོ།",
    "སྲིང་མོ་ཕྱྭ་ལྕམ་མ་དང་།",
    "ཕྱྭ་ལྕམ་འབྲུག་མོ་མ་དང་དྲུག་གོ།",
    "ཁྲི་ཁ་སྟག་གཟིག་ཐན་ཚོ་ཟོ་འབྲང་ངོ།",
    "སྲིང་མོ་ཐང་ང་ལས་མོ་དང་བརྒྱད་དོ།",
    "ཀུན་གྱིས་རྟོགས་པ་ཇི་བཞིན་ཁྲི་བར་གྱི་བདུན་ཚིགས་ནི་བོད་རྒྱལ་ཐོག་མ་གཉའ་ཁྲི་བཙན་པོའི་མེས་པོ་ཡིན་པ་རེད།",
    "དེ་དག་ངམ་ཤུགས་གང་རུང་གིས་དམངས་ཁྲོད་ཀྱི་དད་མོས་དང་དམངས་ཁྲོད་ཀྱི་རོལ་རྩེད།",
    "དེ་ལ་བཙུན་མོ་མཛེས་ལྡན་མ་ལ་སོགས།",
    "བཙུན་མོ་སུམ་ཅུ་རྩ་གསུམ་ཡོད་པ་ལ།",
    "འཛམ་བུའི་གླིང་གི་རྒྱལ་བོར་བཏང་བའི།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "བོད་རྒྱལ་ཐོག་མ་གཉའ་ཁྲི་བཙན་པོ་དང་བོད་ཀྱི་མི་རྒྱུད་སོགས་ནི་རྒྱ་གར་གྱི་མང་བཀུར་རྒྱལ་བོའི་རྒྱུད་པ་ཡིན་པར་བརྗོད་པའི་ལྷད་འདྲེས་པའི་གཏམ་རྒྱུད་བཅོས་མ་དག་གི་འབྱུང་ཁུངས་ལ་བཞག་ཆོག་པས་ན།",
    "མིའི་རིགས་སམ་སྒོས་སུ་བོད་མིས་གདོད་མའི་དུས་སུ་གནམ་གྱི་ལྷ་དང་བཅས་པའི་གནམ་ལ་དད་མོས་བྱེད་པའི་རྒྱུ་རྐྱེན་གཙོ་བོ་ཞིག་ནི་སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་དང་འབྲེལ་བ་ཡོད་པས་ཡིན།",
    "ཀློང་ལས་གཡུ་མཚོ་སྔོན་མོར་སྲིད་ཅེས་པ།",
    "མཚོ་ཕུས་དབྱལ་མ་མོ་ཞིག་སྲིད་ཅེས་པ།",
    "སྒོ་ང་རང་གིས་རང་བརྡོལ་བས།",
    "གཡུའི་བུད་མེད་སྔོན་མོ་ལ།",
    "མཐིང་གི་སྐྲ་མཆན་ལྷན་བདུན་དུ་བརྩེགས་པ་ཞིག་བྱུང་ངོ།",
    "ཆུ་ལྕགས་རྒྱལ་མོ་སྲིད་པའི་ཡུམ་ཞེས་པ།",
    "སྐོ་བ་ཆུ་ལྕགས་རྒྱལ་མོ་ཞེས་ཀྱང་བྱ།",
    "སྲིད་པའི་རྒྱལ་མོ་ཞེས་ཀྱང་བྱ།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "ཡབ་དང་ཡུམ་ཡང་ཕོ་དང་མོ་རུ་སྲིད།",
    "སྲས་ཕོ་མོ་གྲངས་མཉམ་པ་ཡང་སྲིད་པ་ཕོ་ཕྱེད་མོ་ཕྱེད་དུ་བསྟན་ཅེས་པ་དེ་རྣམས་ཀྱིས་ཐོག་མའི་མི་རྒྱུད་གང་ནས་མཆེད་པའི་ཁུངས་བསྟན།",
    "འགྲོ་བ་མི་གྲོལ་ཚུལ་ནི་སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་གི་བྱེ་བྲག་ཅིག་ཏུ་སྲིད་ནའང་ལྷ་སྒྲུང་འཕེལ་རྒྱས་ཀྱི་གོ་རིམ་ཁྲོད་ནས་རིམ་གྱིས་ལོགས་སུ་བྱུང་ཡོད་དེ།",
    "འགྲོ་བ་མི་གྲོལ་ཚུལ་ཡང་རང་རྐྱ་འཕེར་བའི་ལྷ་སྒྲུང་གི་ཕྱི་མོ་གཙོ་བོ་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "སྲིད་པ་སྒོང་གྲོལ་ནི་འཛམ་གླིང་གི་མི་རིགས་མང་བོ་ཞིག་ལ་ཡོད་པའི་འཇིག་རྟེན་སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་ཞིག་ཡིན་ནའང་།",
    "མེས་པོ་སྒོང་གྲོལ་གྱི་ལྟ་བ་དེ་ཧིན་རྡུ་ཉི་ཞི་ཡ་གཙོ་བྱས་པའི་ཁོ་རེ་ཡ་དང་།",
    "སྔ་མ་དེ་ཀེ་རེ་སི་དང་ཨེ་ཇིབ་རྒྱ་གར་ཨུ་རུ་སི་སོགས་ཀྱི་མི་རིགས་ཁ་ཤས་ལ་ཡོད་ལ།",
    "ཕྱི་མ་བྱ་རིགས་ལས་སྐྱེས་པ་ནི་ཧྥིན་ལན་དང་ཧིན་རྡུ་ཉི་ཞི་ཡ་དང་ཧ་ཝ་ཡེ་སོགས་ན་ཡོད་པ་རེད།",
    "དེ་ལ་བ་མོ་སྤུ་ཙམ་སྲིད།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "བྱ་ཁྱུང་གི་རྫུ་འཕྲུལ་བཤིག་ནས།",
    "སྐུ་ལ་འོད་ཟེར་འཕྲོ་བ་གཅིག་འདུག་དེ་ལ་ཡུལ་དེའི་མི་རྣམས་ཀྱིས་ཁྱོད་གང་ནས་ཡིན།",
    "དྲི་བཟང་གི་ངད་པ་བྲོ་བ་ཤེས་རབ་སྒྲོན་བྱ་བ་གཅིག་དང་།",
    "སྲིད་པ་སྒོ་ང་ལས་གྲོལ་བའི་ལྷ་སྒྲུང་གི་རྩ་བ་གཞི་ནས་དོར་མེད་པས་ཡིན།",
    "གོང་གི་རིགས་དེ་གཉིས་དང་བསྡུར་ན་མིའི་མངལ་ལས་སྒོ་ང་བྱུང་བ་དང་།",
    "རྒྱུ་གཞན་ལས་སྒོ་ང་དང་མཚུངས་པའི་ཤ་ལོག་དང་གྲོད་པུ་སོགས་བྱུང་བ་ནི་ཕྱིས་སུ་བྱུང་བའི་ལྷ་སྒྲུང་གི་ཆར་གཏོགས་པ་ཡིན་པར་བསམས།",
    "གེ་སར་སྒྲུང་གི་སྲིད་པ་ཆགས་ལུགས་ཞེས་པའི་དེབ་ནང་དུ།",
    "ཡུམ་གྱིས་ཕྱག་གིས་མྱུར་བར་བླངས་པས་སྒོ་ང་དེ་མེ་ཏོག་པད་མ་ལྟར་ཁ་ཕྱེ།",
    "ཡང་ཨ་པོ་བལྟ་ལ་སོང་སྟེ་བལྟས་པ་སང་།",
    "སྤྲེའུ་དང་བྲག་སྲིན་མོ་ལས་ཆད་པ་གསུམ་གྱི་ལྟ་བ་བྱུང་ཡོད་ལ།",
    "གེ་སར་གྱི་སྒྲུང་དུའང་གླེང་ལུགས་དེ་དག་སྒྲུང་གི་འཕེལ་ཕྱོགས་མི་མཐུན་པ་དང་བསྟུན་ནས་སོ་སོར་གྱེས་ཡོད།",
    "དུང་གི་མིག་ལྡན་དཀར་གསུམ་བྱུང་བ་དང་།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "སྨོན་མི་ལམ་ལམ་ལུམ་ལུམ་ཞེས་པ་ཚེ་སྲོག་གི་ཐོག་མའི་རྣམ་པ་དེ་བྱུང་བ་ཡིན་ལ།",
    "དེས་རང་གིས་རང་ལ་ལྟ་བའི་མིག་དོད།",
    "དེ་མ་ཟད་རང་གིས་རང་ལ་སྲིད་པ་སངས་པོ་འབུམ་ཁྲི་བཏགས་ཞེས་མིང་བཏགས་སྐད།",
    "དེ་ལྟར་མིའི་རིགས་ཀྱི་ཡ་ཐོག་གི་དུས་སྐབས་ལ།",
    "ཚེ་སྲོག་གི་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "སྤྲེའུ་དང་བྲག་སྲིན་མོ་གཉིས་ལས་ཆད་པའི་ལྟ་བ་གསུམ་བཅས་འདུག་པ་དང་།",
    "དེང་རབས་ཀྱི་ཞིབ་འཇུག་པ་དག་གིས་ཀྱང་ཁས་ལེན་བྱས་ཡོད།",
    "ལྷག་པར་དུ་སྤྲེའུ་དང་བྲག་སྲིན་མོ་གཉིས་ཀྱི་སྒྲུང་དེ་ངག་རྒྱུན་དུ་གྲགས་ཆེ་བར་བསམ་ན།",
    "འོ་ན་དེའི་འབྱུང་ཁུངས་སམ་ཕྱི་མོར་གང་འཇོག་རྒྱུ་དང་དེ་གང་ནས་བྱུང་བ་ཡིན་ཞེ་ན།",
    "ང་ཚོའི་གནའ་བོའི་ལྷ་སྒྲུང་དག་གི་ནང་ནས་དེ་དང་འབྲེལ་བའི་བརྡ་འཕྲིན་རྣམས་དམིགས་སུ་བཀར་ཏེ་དབྱེ་ཞིབ་བྱེད་དགོས་ཤིང་།",
    "སྤྱིར་ན་ལྷ་སྒྲུང་ནི་ཡ་ཐོག་གི་མིས་སྐད་ཆ་ལ་བརྟེན་ནས་ཕྱི་རོལ་གྱི་ཤེས་བྱ་དང་ནང་སེམས་ཀྱི་འགྱུ་བ་གཞི་གཅིག་ལ་མཚོན་པའི་སྒྲུང་གི་རིགས་ཤིག་ཡིན།",
    "ཡ་ཐོག་གི་དུས་སུ་མིའི་གནས་ཚུལ་མཐའ་དག་ངང་ངམ་ཤུགས་ཀྱིས་བསྡུས་དོན་དང་ཤུགས་བསྟན་གྱི་ལམ་ནས་ལྷ་སྒྲུང་དུ་མཚོན་ཡོད་རྐྱེན།",
    "འོ་ན་ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོའི་བརྡ་རྟགས་འདིའི་གདོད་མའི་སྐབས་ཀྱི་གདོད་གཟུགས་ཇི་ལྟ་བུ་ཞིག་ཡིན་ཟེར་ན།",
    "ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོ་གཉིས་ནི་འགྲོ་བ་མི་བསྐྱེད་པའི་རྒྱུའམ་ཆ་རྐྱེན་ཐོག་མར་ངོས་འཛིན་དགོས་ཤིང་།",
    "ད་དུང་ལྷ་སྒྲུང་གི་རིགས་ལམ་ལྟར་ན་མིའི་རིགས་ཀྱི་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "དེ་མཚོན་བྱེད་དུ་སྤྲེའུ་དང་བྲག་སྲིན་མོ་ཞེས་པའི་གཟུགས་བརྙན་གཉིས་བསྟན་ཡོད།",
    "དེང་སྐབས་ཀྱི་ཞིབ་འཇུག་པ་ཚོས་སྤྲ་ལ་ངོས་བཟུང་ནས་སྐྱེ་དངོས་འཕེལ་འགྱུར་རིག་པ་དང་ཚན་རིག་གི་ལྟ་བ་ལ་ཐོད་ཐུག་ཅེས་གླེང་ན་ཡང་།",
    "དོན་དུ་ཚན་རིག་དང་མཐུན་པའི་གཏན་ཚིགས་ཤིག་ལ་གཞི་བཅོལ་ནས་བདེན་དཔང་བྱེད་རྒྱུ་ཁག་པོ་རེད།",
    "བརྡ་རྟགས་འདིའི་གོ་དོན་བཀྲོལ་དགོས་ན་ཕྱིར་བོད་རང་གི་གནའ་བོའི་སྒྲུང་དག་དང་།",
    "དཔེར་ན་ཉི་ཟླ་སྐར་གསུམ་དང་གནམ་གཤིས་དྲོདགྲང་དུས་བཞིའི་འགྱུར་བ་སོགས་མིའི་ཉམས་མྱོང་གིས་ཁ་ལོ་བསྒྱུར་མི་བཏུབ་པས།",
    "ཡ་ཐོག་གི་བསམ་བློ་དང་རིགས་ལམ་སོགས་ཅི་རིགས་རིམ་གྱིས་བྱུང་བ་ཡིན།",
    "ཡིན་ཡང་འཇིག་རྟེན་ཤེས་བྱ་མང་དུ་སོང་བ་དང་ཆབས་ཅིག་མིའི་རིགས་ཀྱི་རིགས་ལམ་ལའང་འགྱུར་བ་བྱུང་བས།",
    "ཚོར་རེག་མི་ནུས་པའི་སྣང་ཚུལ་གསུམ་མཚོན་པ་ཡིན།",
    "ཀློང་ནས་གཡུ་མཚོ་སྔོན་མོར་སྲིད།",
    "མཚོ་དབུས་དབྱལ་མོ་གཅིག་སྲིད་པ།",
    "ཆུ་ལྕམ་རྒྱལ་མོ་སྲིད་པའི་ཡུམ།",
    "སངས་པོ་འབུམ་ཁྲི་དང་ཆུ་ལྕམ་རྒྱལ་མོ་གཉིས་ནི་ལྷ་དང་མི་དང་དོན་གྲུབ་ལྷ་རྒྱལ་གྱིས་བསྒྱུར།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོ་ནི་མི་ཁོ་ནའི་འབྱུང་ཁུངས་ཡིན་པསཕལ་ཆེར་ཕྱིས་སུ་བྱུང་བའི་ལྷ་སྒྲུང་གི་རིགས་ཡིན་པ་ཞོར་ནས་གོ་ཐུབ།",
    "ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོའི་ལྷ་སྒྲུང་ལ་འདི་ལྟར་བྲིས་ཡོད།",
    "དེ་ལ་སྤྱན་རས་གཟིགས་ཀྱིས་གསུང་བ།",
    "སྤྲེའུ་ཁྱོད་ཀྱིས་བྱང་ཕྱོགས་ཁ་བ་ཅན་གྱི་རི་ལ་སྒོམ་ནུས་སམ་གསུངས་བས།",
    "སྤྲེའུ་དེ་ན་རེ་ངས་བོད་ཁ་བ་ཅན་གྱི་བྲག་རི་ལ་སྒོམ་ནུས་ལགས་ཞེས་དང་།",
    "སྤྲེའུ་དང་བྲག་སྲིན་མོའི་ལྷ་སྒྲུང་ནི་དོན་དངོས་སུ་གནའ་མི་རི་དྭགས་རྔོན་པའི་དུས་ཇོ་བོ་ཨ་ཏི་ཤས་གཏེར་ནས་བཏོན།",
    "འགྲོ་བ་མི་ཡིས་རང་ཉིད་ཀྱི་སྟོབས་ཤུགས་ལ་ངེས་ཤེས་དང་ཡིད་ཆེས་གསར་བ་རྙེད་པའི་རྟགས་མངོན་གསལ་དུ་ཡོད་པ་རེད།",
    "ས་འོག་ནས་བུད་པའི་གནའ་རྫས་སྤྲེའུ་དང་མཚུངས་བ་དག་ཀྱང་དེའི་ར་སྤྲོད་དུ་འགྱུར་མིན་ད་དུང་བརྗོད་དཀའ་ཞིང་།",
    "དེ་ཡང་སྤྲེའུ་དང་བྲག་སྲིན་མོའི་ལྷ་སྒྲུང་དེ་བོད་ཀྱི་དུས་ཕྱིས་ཀྱི་དེབ་ཐེར་རྣམས་སུ་འགྲོ་བ་མིའི་འབྱུང་ཁུངས་ལ་ངོས་བཟུང་བ་ནི་དང་ཐོག་ངག་སྒྲོས་ལས་བསྒྲག་པ་མིན་པར་མཁས་པ་རྣམས་ཀྱིས་ཡིག་ཐོག་ལ་ཕབ་པ་ནས་བྱུང་བ་ཡིན་ཞིང་།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "དེ་ལྟར་ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོ་གཉིས་ནི་ཐོ་ཐེམ་ལྷ་སྒྲུང་ཞིག་གམ་ཡང་ན་ཡུལ་གཞན་ནས་འཁྱར་འོང་བའི་སྒྲུང་གང་ཞིག་ཡིན་ཡང་རུང་།",
    "འདིའི་གདོད་གཟུགས་ནི་བག་ལ་ཞ་བའི་ཡིད་བརྙན་གྱི་ཚུལ་གྱིས་བོད་མི་སྤྱིའི་སེམས་ཁམས་ཀྱི་གཏིང་སར་ཆགས་ཡོད་པ་རེད་དོ།",
    "གེ་སར་རྒྱལ་བོའི་སྒྲུང་ནི་དེའི་རྨང་གཞིའི་སྟེང་ནས་འཕེལ་རྒྱས་སུ་སོང་བ་ཡིན་ལ།",
    "གི་སྒྲུང་མང་བོ་ཞིག་ཀྱང་འདུས་ཡོད།",
    "བོད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་ལྷ་སྒྲུང་བཟོ་བའི་རིགས་ལམ་ལ་འབྲེལ་བ་ཡོད་པ་ཡིན།",
    "སྒྲུང་ཡང་མ་སངས་ཀྱི་སྒྲུང་གཞིར་བཅོལ་ནས་བཟོས་པ་ཡིན་ཞེས་སི་ཏེན་སོགས་ཀྱིས་གླེང་ཡོད་པ་རེད།",
    "དེས་ན་སྤྲེའུ་དང་བྲག་སྲིན་མོ་ཡང་མ་སངས་ཀྱི་སྒྲུང་ཞིག་མ་རེད་ཅེས་སུས་ཀྱང་ཁ་ཚོན་གཅོད་ཐུབ་པ་མ་རེད།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "བོད་མིའི་འབྱུང་ཁུངས་བརྗོད་པའི་ལྟ་བ་རེ་འགའ་བཏོན་ཡོད་ལ།",
    "ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོ་གཉིས་ཀྱི་ཕྱི་མོའམ་ཁུངས་དེ་ཕྱྭ་དང་དམུའི་གཉེན་སློང་བའི་གནའ་བོའི་གཏམ་རྒྱུད་ཅིག་ནས་འཕེལ་འགྱུར་བྱུང་བ་ཡིན་པར་སྒྲུབ་ཡོད།",
    "དཔེ་རྙིང་དེ་རིགས་ད་ལྟའི་དུས་ལ་ལག་སོན་དཀའ་ནའང་འགའ་རེ་ད་དུང་མཐོང་ཐུབ།",
    "འདིར་བོད་མི་བུ་གདུང་དྲུག་གི་རུས་མཛོད་མེ་ཏོག་སྐྱེད་ཚལ་ཞེས་བྱ་བ་ལས་བོད་མི་འབྱུང་ཁུངས་ཐད་ཀྱི་ལྟ་བ་ངོ་སྤྲོད་ཙམ་བགྱིས་ན།",
    "དེ་ལ་བོན་ལུགས་ལྟར་ན་སྲིད་པའི་མོན་བུ་ལུམ་ལུམ་དང་།",
    "ཡུམ་ཆུའི་རྒྱལ་མོ་འབུམ་གཉིས་ཀྱི་བརྒྱུད་པར།",
    "ཕྱྭ་དམུ་གཙུག་གསུམ་རྒོས་དང་བཞི་ནས་རིམ་པར་བརྒྱུད་ནས་སྲིད་པའི་རྒྱལ་བུ་མཐིང་གི་བར་མཆེད་ཚུལ་ལྟར་བྱུང་།",
    "བུད་མེད་དེས་ཐགས་དེའི་སྣས་ཟིན་ལ།",
    "གནའ་བོའི་ལྷ་སྒྲུང་འདི་ལས་ཀྱང་སྤྲེའུ་དང་བྲག་སྲིན་མོ།",
    "བོད་ཀྱི་མི་རྒྱུད་བྱུང་ཚུལ་གསུམ་གའི་ཐོག་མའི་རྨང་གཞིའམ་ལྷ་སྒྲུང་གི་རྒྱུ་དེ་རྙེད་ཐུབ་པ་ཡིན།",
    "ད་དུང་གནའ་བོའི་ཡིག་རྙིང་དེའི་ནང་དུ་སྲིན་པོ་ནི་ཚོ་བ་ཞིག་དང་སྲིན་མོ་ནི་ཚོ་བ་དེའི་བུད་མེད་རྣམས་ལ་གོ་བ་ཡིན་ཞིང་།",
    "བོད་མི་བུ་གདུང་དྲུག་གི་རུས་མཛོད་མེ་ཏོག་སྐྱེད་ཚལ།",
    "མཁར་རྨེའུ་བསམ་གཏན་གྱིས་བསྒྲིགས་པའི་དེབ་ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན་ཞེས་པའི་ནང་ཚན་དབུ་ནག་མིའུ་འདྲ་ཆགས་ཞེས་པ་ལས་བཤུས།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "སྲིན་མོ་གོ་ཟུ་ཅན་ཁབ་ཏུ་བཞེས་པ་ལས་དབའ་དང་ལྡ་གཉིས་བྱུང་བ་ཡིན།",
    "ཕ་རྒན་ཨ་མྱེས་ཁྲི་ཐོ་ཆེན་པོ་ཡིན་ཞེས་གསལ་བོར་བཀོད་འདུག་པ་ལ་དཔྱད་ན།",
    "མཐའ་མ་གཉན་གྱིས་གཅེན་གཅུང་དྲུག་གི་ཡབ་ཆེན་བཀྲོངས།",
    "གཉན་གྱིས་ཁྲི་ཐོ་ཆེན་པོའི་བུ་དྲུག་ལ་མི་སྟོང་དུ་སྲོག་ཆགས་རེ་སྤྲད་དགོས་ཀྱི་རེ་བ་བཏོན།",
    "གནའ་བོའི་ལྷ་སྒྲུང་དེ་དག་གཞིར་བྱས་ང་ཚོ་ལ་ངེས་ཤེས་འདི་འདྲ་འདྲོངས་རྒྱུ་ཡོད་དེ།",
    "ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོའི་ལྷ་སྒྲུང་ནི་བོད་རང་གི་གནའ་བོའི་ལྷ་སྒྲུང་གི་རྨང་གཞིའི་སྟེང་ནས་འཕེལ་འགྱུར་བྱུང་བའི་བོད་མི་བྱུང་རབས་སྨྲ་བའི་སྒྲུང་ཞིག་ཡིན་ཞིང་།",
    "བྲག་སྲིན་མོའི་ཕྱི་མོ་ནི་གནའ་བོའི་བོད་ཀྱི་མིང་ལ་སྲིན་དུ་འབོད་པའི་ཚོ་བའི་བུད་མེད་ཅིག་ལ་ངོས་འཛིན་གནང་ན་འགྲིག་པ་དང་།",
    "གནའ་བོའི་ལྷ་སྒྲུང་དེ་རིགས་ནི་མ་སངས་དང་ཐེའུ་བྲང་གི་སྒྲུང་སོགས་ལ་འབྲེལ་བ་ཆེ་བ་ཡིན།",
    "གདོད་མའི་དུས་ནས་བོད་ཡུལ་འདིར་རུས་རྒྱུད་དང་ཚོ་ཁག་མང་བོ་ཡོད་པ་དང་།",
    "དེ་ནས་རེ་ཏེ་མགོ་གཡག་བདུད་ཀྱིས་བྱས།",
    "སྟ་རེ་དགྲ་སྟ་དེ་ཡི་དུས་སུ་བྱུང་།",
    "དེ་ནས་སྲིན་པོ་གཉའ་རེངས་ཁྲག་མིག་བྱས།",
    "སྲིན་མོ་རྐང་དང་སྒྱོགས་གཉིས་ལག་ཆར་བྱུང་།",
    "འདི་ནི་སྐབས་དེའི་ཚོ་བ་ཁག་གི་འཚོ་བ་རོལ་སྟངས་དང་འགྲོ་འདུག་འཆག་གསུམ་གྱི་སྤྱོད་པ་དངོས་ཡིན་པ་དང་།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "བོད་རྒྱལ་གཉའ་ཁྲི་བཙན་པོའི་ཡར་སྔོན་ཏེ་ཉུང་མཐའ་ཡང་མི་ལོ་ཉིས་སྟོང་ལྷག་གི་སྔོན་ལ།",
    "ཕྱིས་སུ་མེས་པོ་དེ་དག་དད་མོས་བྱེད་སའི་ལྷར་གྱུར་ཞིང་།",
    "གདུང་རབས་ལ་བརྟེན་ནས་ཚོ་བ་དང་རུས་རྒྱུད་ཀྱི་མེས་པོ་དང་དེ་དག་གི་མཛད་པ་ཡིད་ལ་འཛིན་ཐུབ་པ་དང་།",
    "མི་ཡི་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "བོད་ཀྱི་ལྷ་སྒྲུང་དུ་ལྷའི་གདུང་རྒྱུད་དེ་ལ་ཕོ་ལྷ་དང་མོ་ལྷའི་ཁྱད་པར་མཆིས་ཤིང་།",
    "བོད་མི་བྱིངས་ཀྱི་བློ་ངོར་གཞན་གྱིས་ཚབ་བྱེད་མི་ནུས་པའི་ཡིད་འགུགས་ཀྱི་སྟོབས་ཤུགས་ལྡན་པ་རེད།",
    "བོད་བཙན་པོའི་དུས་སྐབས་ཀྱི་མགོ་ནས་བཟུང་མཁར་རྨེའུ་བསམ་གཏན་གྱིས་བསྒྲིགས་པའི་དེབ་ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན་ཞེས་པའི་ནང་ཚན་མིའུ་རིགས་བཞི་ལྷ་སེལ་ལྷ་མཆོད་རྒྱས་པའི་སྐོར་ཞེས་པ་ལས་བཤུས།",
    "འོག་གི་ཀླུ་དང་མཛེ་དྲག་ཐུབ།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "སྲིད་པ་མེ་སྟག་ཕྲ་མོ་ཆགས།",
    "མ་ཤེས་སྲིད་པར་དྲིས་ནི་ཡིན།",
    "དུང་སྒོང་གསུམ་དེ་ཡར་ལ་སོང་།",
    "གསེར་སྒོང་གསུམ་དེ་བར་ལ་སོང་།",
    "གཡུ་སྒོང་གསུམ་དེ་འོག་ལ་སོང་།",
    "ངས་མ་ཤེས་གླུ་བར་དྲིས་ནི་ཡིན།",
