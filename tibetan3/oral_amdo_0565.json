    "ཐོག་མར་འཇིག་རྟེན་ཁམས་འདིར་ཅི་ཡང་མེད་པ་དང་དེ་ནས་ཆ་ཤས་ཙམ་ཞིག་མཁར་རྨེའུ་བསམ་གཏན་གྱིས་བསྒྲིགས་པའི་དེབ་ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན་ཞེས་པའི་ནང་ཚན་དབུ་ནག་མིའུ་འདྲ་ཆགས་ཞེས་པ་ལས་བཤུས།",
    "ཡེ་སྲིད་ཕྱྭའི་རྒྱལ་མོ་ཁབ་ཏུ་བཞེས།",
    "གཡུའི་བུད་མེད་སྔོན་མོ་ཅིག་ཕྱག་ན་གསེར་འཕང་གཡུ་ལོ་བསྣམས།",
    "གཡུང་དྲུང་ཕྱྭ་ཡི་རྒྱལ་མོ་བྱ།",
    "གང་མོ་འགྱིང་མོ་བྱ་བ་ལགས།",
    "ཕྱུག་གཡང་ཁུགས་སོ་མེར་རེ་རེ།",
    "མཐིང་གི་མི་ཕོ་སྔོན་པོ་ཅིག་ཕྱག་ན་རིན་ཆེན་བུམ་པ་བསྣམས།",
    "མཆོང་གི་བུ་མེད་སྨུག་མོ་ཞིག་ཕྱག་ན་གཡང་གི་ཕྱྭ་ཆང་བསྣམས།",
    "མཚན་ནི་ཐབ་ལྷ་ཡུ་མོ་བྱ།",
    "མཁར་རྨེའུ་བསམ་གཏན་གྱིས་བསྒྲིགས་པའི་དེབ་ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན་ཞེས་པའི་ནང་ཚན་མུ་ཡེ་པྲ་ཕུད་ཕྱྭའི་མཐར་ཐུག་ཅེས་པ་ལས་བཤུས།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "དེ་དག་གིས་ལྷ་མི་སྲིད་པའི་དཔའ་སྟངས་འཛིན།",
    "དུང་གི་མི་ཕོ་ལ་གཡུ་ཡི་དབུ་སྐྲ་མཆན་ལྷན་བདུན་དུ་ཕྱིན་པ་ཞིག་བྱུང་།",
    "དེ་ལས་འོད་ཀྱི་སྒོ་ང་སྔོན་པོ་ཞིག་བྱུང་བ་དེ་ཉིད་བརྟོལ་བ་ལས་བུད་མེད་སྔོན་མོ་མཐིང་གི་སྐྲ་མཆན་ལྷག་བདུན་དུ་བརྩེགས་པ་ཞིག་བྱུང་།",
    "སྐོས་པ་ཆུ་ལྕགས་རྒྱལ་མོ་ཞེས་བཏགས།",
    "འདི་གཉིས་ནི་བོད་མིའི་ཆེས་སྔ་བའི་མེས་པོར་ངོས་འཛིན་བྱས་ཆོག་ལ་དེ་གཉིས་བཤོས་པ་ལས་སྲིད་པའི་ཕོ་མོ་ཐམས་ཅད་གྲོལ་བར་གྲགས།",
    "སྲིད་པ་མི་དང་བྱོལ་སོང་སྣ་ཚོགས་བྱུང་ཞེས་འཁོད་ཡོད་པས་ཀྱང་བདེན་དཔང་བྱས་ཆོག་གོ།",
    "འཛམ་གླིང་ཐོག་གི་མི་རིགས་སོ་སོའི་ཐོག་མའི་མེས་པོ་དེ་ལྷ་དང་འདྲེ་ཡི་བཟོ་ལྟ་དང་རྣམ་པས་བཞེངས་ཡོད་པས།",
    "ཕྱི་བལྟས་ཙམ་གྱིས་སྒྱུ་འཕྲུལ་ཅན་གྱི་སྣང་བརྙན་རེ་རེ་ལ་ངོས་འཛིན་བྱེད་སྲིད་མོད་ཀྱང་།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "སྲིད་པ་སྒོང་གྲོལ་གྱི་ལྟ་ཚུལ་འདི་ནི་བོད་ཁོ་ན་ལ་ཡོད་པའི་ལྷ་སྒྲུང་ཞིག་མིན་ཏེ་གནའ་བོའི་སྟག་གཟིག་དང་རྒྱ་གར།",
    "ཀེ་རེ་སི།",
    "དབུས་དང་ལྷོ་ཕྱོགས་ཀྱི་ཨ་མེ་རི་ཁ་སོགས་ཀྱི་མི་རིགས་སོ་སོའི་གདོད་མའི་ལྷ་སྒྲུང་གི་ནང་དུའང་མང་བོ་བདོག་གོ།",
    "སྒོང་གྲོལ་གྱི་འཇིག་རྟེན་ཆགས་ལུགས་དེ་ཐོག་མར་སྟག་གཟིག་ནས་དར་ཞིང་ཕྱིས་སུ་འཛམ་གླིང་གི་ཡུལ་གྲུ་སོ་སོར་གྱེས་པར་དགོངས་ཤིང་གནའ་བོའི་པར་སིག་གམ་སྟག་གཟིག་གི་ལྷ་སྒྲུང་དང་འབྲེལ་བ་ཡོད་པར་བཞེད་ཡོད་པ་རེད།",
    "རྣམ་ཀུན་འདི་འདྲའི་ལྷ་སྒྲུང་ཞིག་ལ་ད་གདོད་རང་སའི་སྒྲུང་གི་གྲས་སུ་བཞག་ཆོག་པ་རེད།",
    "མ་མཐའ་ཡང་ལུགས་འདི་བྱུང་བའི་འཛམ་གླིང་གི་ཆེས་སྔ་གྲས་ཀྱི་ས་གནས་ཤིག་ཡིན་པ་ཐག་གིས་ཆོད།",
    "འདི་ནི་གནས་སྐབས་སུ་ཡང་དག་གི་གནས་ལུགས་ཤིག་ལ་མི་འཇོག་ཐབས་མེད་ཡིན་ཏེ།",
    "འོན་ཏེ་འདིར་སྐབས་སུ་བབས་པའི་བརྗོད་བྱ་དང་རིང་དུ་གྱེས་པར་དོགས་ནས་རེ་ཞིག་གླེང་བར་མི་བྱའོ།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "བདག་གི་བསམ་ཚུལ་ཞིག་ལ་འཛམ་གླིང་གི་མི་རིགས་སོ་སོར་རང་གི་སྒོང་གྲོལ་གྱི་ལྷ་སྒྲུང་དང་ཡང་ན་སྒོ་ང་ལ་སྦྱར་བའི་ཆོ་ག་རྣམ་པ་སྣ་ཚོགས་ཡོད་པ་དང་།",
    "གནའ་བོའི་དུས་སུ་བོད་མིས་བྱ་ལ་མཆོད་བཀུར་དང་དད་མོས་བྱེད་པའི་སྲོལ་ཆགས་ཡོད་པ་དང་།",
    "འདི་དག་ད་དུང་དཔྱད་གཞིའི་ཚུལ་དུ་ཡོད་དགོས་ནའང་བསམ་བློ་གཏོང་ཕྱོགས་གསར་བ་ཞིག་གི་ངོས་ནས་གླེང་ན་མི་འོས་པ་མེད་དོ་བསམ།",
    "སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་ལ་མུན་འཐོམས་ཀྱི་རང་བྱུང་ཁམས་ལས་བརྡོལ་བའི་ལུགས་དང་འཇིག་རྟེན་བྱེད་པོའམ་ལྷ་ཆེ་གེ་མོས་བཟོས་པ།",
    "འཛམ་གླིང་གི་མི་རིགས་གཞན་དག་གི་ལྷ་སྒྲུང་ནང་དུའང་ཐོག་མའི་ལྷ་དེ་མུན་འཐོམས་ཀྱི་རང་བྱུང་ཁམས་ལས་བརྡོལ་ཞིང་རིམ་བཞིན་འགྲོ་བ་མིའི་དད་མོས་བྱེད་ཡུལ་དུ་གྱུར་བ་ཡིན་པ་དང་།",
    "རང་གཞན་རྟེན་བྱེད་ཀྱི་ཕྱི་རོལ་འཇིག་རྟེན་ཁམས་བཅས་ཀྱི་མཐར་ཐུག་གི་འབྱུང་ཁུངས་ལ་འཚོལ་སྙེག་དང་རྟོག་དཔྱོད་བྱེད་པའི་ཆེད་དུ་ཡིན།",
    "རང་བྱུང་གི་རང་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "ལྷ་སྒྲུང་གི་གདོད་མའི་རྣམ་པ་དོར་མེད་པ་དང་།",
    "དེས་ནི་དེང་གི་མི་ཚོས་གདོད་མའི་དུས་ཀྱི་བོད་མིའི་འཚོ་བ་རོལ་སྟངས་སོགས་རགས་ཙམ་ཤེས་རྟོགས་འབྱུང་རྒྱུ་ལ་རྒྱུ་ཆ་གལ་ཆེན་འདོན་སྤྲོད་བྱེད་ནུས།",
    "ཚེ་སྲོག་གི་གཟུགས་ཙམ་ཡང་མི་སྣང་བའི་ཐོག་མའི་རྣམ་པ་མཚོན་བྱེད་ཡིན་ཞིང་།",
    "ཆུ་ནི་བལྟོས་བཅས་ཀྱིས་དཔྱད་ན་མེ་དང་འགལ་ཟླར་སོང་ཡོད་གཤིས།",
    "སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་ལ་མིའི་རིགས་ཀྱི་བྱ་འགུལ་ཡོད་དོ་ཅོག་གི་ཕྱི་མོ་དང་།",
    "བྱ་བྱེད་བརྡར་ཤ་གཅོད་བྱེད་པའི་ཚད་ཐིག་གི་ནུས་པ་ཡོད་པས་མི་ཚད།",
    "འཛམ་གླིང་གི་མི་རིགས་མང་བོ་ཞིག་ལ་དཔྱིད་མགོ་ཚུགས་དུས་སུ་བབས་དང་བསྟུན་པའི་སྲོལ་རྒྱུན་གྱི་བྱེད་སྒོ་འདྲ་མིན་སྤེལ་སྲོལ་ཡོད་པའང་སྲིད་པ་ཆགས་པའི་འདུ་ཤེས་དང་འབྲེལ་ཞིང་།",
    "གཏམ་དེར་སྲིད་པ་ཆགས་པ་ནས་བྱུང་བའི་འཇིག་རྟེན་གྱི་ཆགས་འཇིག་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "སྒོ་གླེགས་ལ་སྡོང་བོའི་ར་ལག་རེ་འཛུགས་སྲོལ་ཡོད་པ་དང་།",
    "དེ་ལྟར་ལོ་རེ་བཞིན་གྱིས་འཇིག་རྟེན་ཡང་དང་བསྐྱར་དུ་གསར་སྐྲུན་བྱེད་བཞིན་ཡོད་དེ།",
    "སྲིད་པ་ཆགས་པའི་གལ་ཆེན་རང་བཞིན་དེ་གེ་སར་སྒྲུང་གི་ནང་ལ་བལྟས་ནའང་གསལ་བོར་གོ་འོང་སྟེ།",
    "སེར་བོ་ཧོར་དང་ཁྲ་བོ་མོན།",
    "སྲིད་པའི་ཁོག་འབུབ་ཆེན་མོ་དང་།",
    "སྔ་མ་གཉིས་གོང་གི་རིགས་དང་པོ་དང་གཉིས་པའི་ནང་ནས་རགས་ཙམ་གླེང་ཟིན་ལ་འདིར་ཁ་གསབ་རྒྱག་རྒྱུ་ཞིག་ནི།",
    "གེ་སར་སྒྲུང་གི་རིག་མཛོད་དང་པོ།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "གེ་སར་སྒྲུང་གི་ནང་ནས་རོང་ཚ་ཁྲ་རྒན་དང་ཁྲོ་ཐུང་།",
    "སྤྱིར་ཡིན་ན་སྲིད་པ་ཆགས་པའི་གླུ་ནི་བོད་མི་རྣམས་ཀྱིས་གཙུག་ཏུ་བཀུར་བའི་བགྲེས་པོ་ཞིག་གིས་དུས་སྟོན་སོགས་ཀྱི་སྐབས་སུ་ལེན་པ་ཡིན།",
    "རིམ་གྱིས་གླིང་གི་དཔོན་རྒྱུད་བྱུང་བ་རྣམས་སོ་སོར་གཏམ་དུ་དྲངས་ཡོད།",
    "གེ་སར་སྒྲུང་གི་རིག་མཛོད་དང་པོ།",
    "གླིང་སྒྲུང་དུ་རོང་ཚ་ཁྲ་རྒན་གྱིས་རང་ཉིད་སྲིད་པའི་ལྷ་རྒན་གྱི་འཐུས་ཚབ་བྱས་ཡོད་ལ་གླིང་གི་འདས་མ་འོངས་ད་ལྟ་གསུམ་མཁྱེན་པས་གླིང་གི་སྤྱི་དཔོན་གྱི་འགན་ཁུར་ཏེ་བཞུགས་ཡོད།",
    "མི་ཀུན་གྱིས་ཐུན་མོང་གི་ཚད་གཞིའི་དོད་དུ་བརྩི་ཞིང་སྲུང་དགོས་པ་ཡིན།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "འཚོ་བ་རོལ་སྟངས་སོགས་ལ་གཞི་བཅོལ་ཏེ་བཟོས་པའི་སྒྲུང་གི་རིགས་ཡིན།",
    "ཕྱི་རབས་པས་སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་གི་ནང་དོན་ཡང་དང་བསྐྱར་གྱིས་འཁྲབ་སྟོན་བྱས་ནས་གུས་སྲོལ་སྤེལ་ཞིང་།",
    "གེ་སར་སྒྲུང་ལ་སྲིད་པ་ཆགས་པའི་སྐོར་ཡོད་པས་མི་ཚད་གེ་སར་སྒྲུང་འབྱུང་ཞིང་བརྟེན་པའི་མགོ་ཁུངས་གཙོ་གྲས་ཡིན་སྙམ་པའི་ངེས་པ་ངང་གིས་རྙེད་འོང་།",
    "སྒྲུང་གི་འཕེལ་འགྱུར་གྱི་གེགས་སུ་གྱུར་བའི་ལྷ་སྒྲུང་གི་རྒྱུ་ཆ་རྣམས་རང་བཞིན་གྱིས་ཡལ་འགྲོ་བའམ།",
    "གདོད་མའི་ལྷ་སྒྲུང་ནང་ན་ལྷ་གཙོ་བོར་བཟུང་ནས་འཇིག་རྟེན་གྱི་ཆགས་འཇིག་གླེང་གིནཡོད་ལ།",
    "སྲིད་པ་ཆགས་པའི་ལྷ་སྒྲུང་དང་གེ་སར་སྒྲུང་གི་འབྲེལ་བ།",
    "རྒྱུག་མོས་མི་ཚེ་སྐྱེལ་དུས་དགོས།",
    "སྲིད་པ་ཆགས་ལུགས་ཀྱི་སྒྲུང་དང་གེ་སར་གྱི་སྒྲུང་གཉིས་ལ་འབྲེལ་བ་དམ་ཟབ་ཅིག་ཡོད་པ་སྨོས་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "ཡིན་ནའང་འབྲེལ་བ་དེ་རྨང་གཞི་གང་གི་སྟེང་ན་ཆགས་ཡོད་པ་དང་ཇི་ལྟར་ཆགས་ཡོད་པ།",
    "གེ་སར་རྒྱལ་བོའི་སྒྲུང་ཡང་བོད་ཀྱི་གདོད་མའི་ལྷ་སྒྲུང་གི་རྨང་གཞིའི་སྟེང་ནས་བྱུང་བ་རེད་ཟེར།",
    "ལྷ་སྒྲུང་གི་སྐད་ཆའི་སྒྱུ་རྩལ་གྱི་ཆ་ནས་བལྟས་ན།",
    "གདོད་མའི་སྲིད་པའི་བོན་གྱི་ཆོ་ག་སོགས་སུ་གྱེར་འདོན་བྱེད་པའི་ཚིག་གི་ཉམས་ཡོད་པ་དང་།",
    "ཚིག་རྐང་གི་མང་ཉུང་ཐད་ནས་དཔྱད་ན་ལྷ་སྒྲུང་གི་རྩོམ་རིག་ལ་ལྡན་པའི་རྩོམ་གྱི་རྣམ་པའམ་རྩོམ་ཉམས་ཡིན་པ་དང་།",
    "སྐབས་དེའི་མི་རྣམས་གདོད་མའི་འདུ་ཤེས་ལས་ད་དུང་རེ་ཞིག་ཐར་མེད་པས།",
    "དུས་དེ་ལ་ལྷ་གསོལ་བའི་ངག་ཐོག་གི་རྩོམ་རིག་དེ་དག་རིམ་གྱིས་སྒྲུང་རབས་ཀྱི་ཕྱོགས་ལ་འཕེལ་བའི་མགོ་ཚུགས་པ་ཡིན།",
    "བཙན་པོའི་དུས་སུ་ནང་གི་ཚོ་ཆེན་དང་ཚོ་ཆུང་བར་གྱི་གཡུལ་འགྱེད་མཇུག་རྫོགས་རྗེས།",
    "གཡུལ་འཁྲུག་གི་མགོ་རྩོམ་དུས་དམག་གི་དཔུང་ཆེན་པོས་ཡུལ་ལྷའམ་དགྲ་ལྷ་བསུ་བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "ཆོ་གའི་ནང་དུ་དགྲ་ལྷ་ལ་ཆེ་བསྟོད་བྱེད་ཅིང་དམག་འཁྲུག་གི་གོ་རིམ་ཧྲིལ་པོ་གླུ་རུ་ལེན་པའི་གནའ་སྲོལ་བྱུང་ཡོད་པ་ཏུན་ཧོང་ཡིག་རྙིང་སོགས་སུའང་སྣང་།",
    "ལྷ་འབོད་ཀླུ་མཆོད་བྱེད་པའི་ལྷ་བ་ནི་ད་ལྟའི་སྒྲུང་བའི་འབྱུང་ཁུངས་སུ་ངོས་བཟུང་ཆོག་ཆོག་རེད།",
    "དེའི་རྗེས་སུ་དབྱངས་འགྲོས་ལྡན་པའི་ངག་ཐོག་རྩོམ་རིག་གི་རྣམ་པ་སྟེ་ངག་ལ་ལེན་བདེ་བའི་དམངས་སྲོལ་རྣམ་པ་ཅན་དུ་གྱུར་བ་དང་།",
    "མཐའ་གཅིག་ཏུ་ཡི་གེ་དེ་དག་གི་རྨང་གཞིའི་སྟེང་ནས་གེ་སར་སྒྲུང་གྲུབ་པ་ཞེ་ཅི་ཧྲིན།",
    "སྲིད་པ་ཆགས་པའི་གོ་རིམ་ཁྲོད་ནས་གེ་སར་སྒྲུང་ལས་མཐོང་བའི་གླིང་གི་རུས་རྒྱུད་ཆེ་ཆུང་རྣམས་དང་དེ་དག་སྡོད་སའི་ས་ཆ་གྲུབ་ཡོད་པ་དང་།",
    "ལྷག་པར་དུ་གླིང་གི་སྤྱི་དཔོན་རོང་ཚ་ཁྲ་རྒན་ནི་སྲིད་པའི་གངས་རྒན་ནམ་མི་རབས་གསུམ་གྱི་མི་རྒན་ལྟ་བུའི་མེས་པོའི་མཚོན་བྱེད་ཡིན་པས།",
    "དམངས་ཁྲོད་ཀྱི་རྩོམ་རིག་ནི་སྒྲུང་གི་འབྱུང་ཁུངས་གཞན་ཞིག་ཡིན་པ་གཤམ་གྱི་དམངས་གླུ་འདི་ལས་རྟོགས་ནུས།",
    "ཁྱོས་ཤེས་ན་དེ་ལ་ལན་ཞིག་ཐོབས།",
    "ཤོ་ཚང་ཨ་ནུ་ཁྲ་རྒོད་རེད།",
    "སྐྱེས་ཡག་ཉི་མ་རང་ཤར་རེད།",
    "བོད་ཕྲུག་མི་ཆུང་ཁ་བདེ་རེད།",
    "ཚ་ཞང་འདན་མ་བྱང་ཁྲ་རེད།",
    "ཨ་དཔལ་གཡུ་བྱ་རྟེའུ་སྔོན་རེད།",
    "མ་བཞིའི་དཔོན་པོ་ཁྲོ་རྒྱལ་རེད།",
    "དེ་ཨེ་རེད་མ་རེད་གླུ་བས་ལྟོས།",
    "ངག་ཐོག་གླུ་གཞས་ཀྱི་རྣམ་པ་དེ་སྤྱིར་བཏང་གི་སྐད་ཆའི་འཆད་བརྗོད་ཀྱི་རྣམ་པ་ལས་ཁྱད་དུ་འཕགས་ཤིང་།",
    "དམག་འཁྲུག་གི་སྐབས་སུ་དམག་དཔུང་དང་དཔའ་བོ་ཕན་ཚུན་བར་དཔའ་རྟགས་ངོམས་པ་དང་གཡུལ་ལ་བསྐུལ་བའི་སྒྲུང་གླུའི་རྣམ་པས་མཚོན་ཡོད་པ་ཡིན།",
    "གླུ་ཚིག་འདི་ལས་གླིང་གི་དཔའ་ཐུལ་རྣམས་མེས་པོའི་ཚབ་ཏུ་སྲིད་པ་ཆགས་པ་དང་ཆབས་ཅིག་གསོན་ཡོད་ཅིང་།",
    "བོད་སྔ་རབས་ཀྱི་སྒྲུང་གི་བྱུང་བ་བརྗོད་པ་དགྲ་ལྷའི་དཔངས་བསྟོད།",
    "དོན་རྐྱེན་གང་དང་ངག་རྒྱུན་ཅི་རིགས་ཆུ་སྣ་བསྡུ་བའི་ཚུལ་གྱིས་བསྡུས་ཤིང་ཕན་ཚུན་ཕར་འདྲེས་ཚུར་འདྲེས་བྱས་ཏེ་དམངས་ཁྲོད་ཀྱི་སྒྲུང་རིང་གྲུབ་པ་ལ་ཆ་རྐྱེན་གང་ལེགས་བསྐྲུན་ཡོད་པ་རེད།",
    "སྲིད་པ་ཆགས་པའི་སྐབས་ཀྱི་མེས་པོ་དེ་དག་ལོ་ངོ་སྟོང་ཕྲག་གི་རིང་ལ་དམངས་ཁྲོད་ཀྱི་འཆད་བརྗོད་བརྒྱུད་ནས།",
