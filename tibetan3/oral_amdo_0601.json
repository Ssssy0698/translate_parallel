    "ཁྲོ་མོ་ལྕགས་ཀྱུ་མ་ལ་སོགས་པ་ཡབ་ཡུམ་བརྒྱད།",
    "དམ་ཚིག་གི་འཁོར་ལོ་ལ་ཇི་ལྟར་བཞུགས་པ་བཞིན་དུ་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་རྣམས་དེ་ལ་དེ་ལྟར་དུ་གཉིས་སུ་མེད་པའི་རང་བཞིན་དུ་མི་གཡོ་བརྟན་པར་བཞུགས་སུ་གསོལ་ཅེས་གསུངས་ནས་དེ་ཡན་ཆད་ཀྱིས་ཞི་བའི་ལྷ་ཚོགས་བཞུགས་སུ་གསོལ་བ་ཡིན་ནོ།",
    "བུདྡྷ་ཀྲོ་ཏི་ལ་སོགས་པ་ཤེས་རབ་ཀྱི་ཆར་གྱུར་པའི་ཀྲོ་ཏི་ལྔ་དང་སྦྱོར་བའི་ཡབ་ཡུམ་སྲས་དང་བཀའ་སྡོད་སྤྲུལ་འཁོར་དང་བཅས་པ་སྟེ།",
    "འདིའི་སྐབས་ཀྱི་སྲས་ཞེས་པ་ལུང་གི་ཧེ་རུ་ཀ་ལ་འགྲེལ་མཁན་ཡང་ཡོད་དོ།",
    "ཀོའུ་རཱི་ལ་སོགས་གནས་བདག་མ་མོ་བརྒྱད",
    "དུང་ཁང་གི་མཚོག་གསང་གཉིས་དང་ལྟག་གསང་གཉིས་ན་སྒོ་མ་བཞིའི་རང་བཞིན་རྩ་དང་ཐིག་ལེའི་དྭངས་མར་གནས་པ་དེ་ཉིད་སྒོ་སྲུང་གི་ཚུལ་དུ་ཡོད་ཅེས་གསུངས་པའོ།",
    "དེ་ལྟ་བུའི་སྤྲུལ་བའི་ཁྲོ་བོའི་བྱེ་བྲག་ལས་ཀོའུ་རཱི་ལ་སོགས་གནས་བདག་གི་མ་མོ་བརྒྱད་དང་།",
    "དུ་མ་རོ་གཅིག་ཅེས་པ་གོ་སོང་ངམ།",
    "ཞེས་ཏེ་བཞུགས་གསོལ་གྱི་ལེའུའི་མཚམས་སུ་དམ་ཚིག་གི་རྒྱ་དང་གསང་བ་གསུམ་མམ་རྡོ་རྗེ་གསུམ་གྱི་རྒྱ་རྟགས་ཀྱིས་རྒྱས་གདབ་པ་ཡིན་ནོ། ང་",
    "ཡུལ་བརྒྱད་གནས་དག་སེམས་མ་ཆེན་མོ་བརྒྱད",
    "ཉོན་མོངས་པ་གཏི་མུག་གནས་སུ་དག་པས་ན་གཙོ་བོ་བུདྡྷ་ཧེ་རུ་ཀ་ཞེ་སྡང་དག་པས་བཛྲ་ཧེ་རུ་ཀ་ང་རྒྱལ་དག་པས་རཏྣ་ཧེ་རུ་ཀ་འདོད་ཆགས་དག་པས་པདྨ་ཧེ་རུ་ཀ་ཕྲག་དོག་དག་པས་ཀརྨ་ཧེ་རུ་ཀ་སྟེ་དེ་ལྟར་སྦྱར་རྒྱུ་ཡིན་ཞིང་།",
    "ཀོའུ་རི་ལ་སོགས་གནས་ཀྱི་མ་མོ་བརྒྱད",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་གནས་སུ་དག་པ་པྲ་མོ་ཧ་དམར་མོ་ལ་སོགས་པ་གནས་ཀྱི་མ་མོ་བརྒྱད་དང་།",
    "རྟ་གདོང་དཀར་མོ་ལྕགས་ཀྱུ་ཅན།",
    "ཕག་གདོང་ནག་མོ་ཞགས་པ་ཅན་ལ་སོགས་པ་སྒོ་མ་བཞི།",
    "གཞི་ཡེ་དག་གི་ཁྲོ་བོ་མི་འབྲལ་དུང་ཁང་གི་གཞལ་ཡས་ན་བཞུགས་ཤིང་།",
    "དེ་ཡང་ཚུལ་ཇི་ལྟར་ཡིན་ན་གཞི་ཡེ་དག་གི་ཁྲོ་བོ་དེ་མི་འབྲལ་དུང་ཁང་ན་བཞུགས་དུས།",
    "མེ་ཏོག་བདུག་སྤོས་དྲི་ཞལ་རོལ་མོར་བཅས",
    "ཐིག་ལེ་དག་པ་གསུམ་ཁ་རྩང་ང་ཚོས་ཡན་ལག་བཅུ་བའི་སྐབས་སུ་འགྲེལ་བ་ལྟར་དུ་ཡིན་ལ།",
    "རེག་བྱ་བདེ་སྟོང་།",
    "ལོངས་སྤྱོད་རྒྱན་གྱི་རོལ་བ་བསམ་གྱིས་མི་ཁྱབ་པར་སྤྲལ་ཏེ་མེ་ཏོག་བདུག་སྤོས་དྲི་ཞལ་རོལ་མོ་དང་བཅས་པས་མཚོན་པའི་མཆོད་རྫས་དེ།",
    "རྡོ་རྗེ་གཟུགས་སྒྲ་དྲི་རོ་རེག",
    "སྒྲ་རྡོ་རྗེ་མ་སྔོན་མོ་པི་ཝང་སྦྲེང་ཞིང་སྙན་པའི་གླུ་ལེན་པ།",
    "འདིའི་ཕྱི་ནང་གཉིས་ཀའིཐུན་མོང་གི་རྐྱེན་བཞི་ནི་རྒྱུའི་རྐྱེན།",
    "དམ་ཚིག་གི་བདུད་རྩི་དང་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་གཉིས་ཀ་ཁ་ཁ་ཡི་གོ་བ་ལེན་དགོས་ཤིང་།",
    "ཡེ་ཤེས་ཀྱི་བདུད་རྩི་དེས་དམ་ཚིག་གི་བདུད་རྩི་ལ་བྱིན་གྱིས་བརླབས་ནས་དམ་ཡེ་དབྱེར་མེད་དུ་འགྱུར་དགོས་སོ།",
    "སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "འདི་གོ་སླ་བས་འདིའི་ཚིག་གི་དོན་འགྲེལ་མི་དགོས་ལ།",
    "རྫས་འདི་ཚོ་མན་ངག་གི་ངེས་པས་རྫས་སོ་ལྔ་ལ་སོགས་པ་བསྡུས་ནས་ཕྱི་ནང་གསང་བའི་རཀྟ་ཐམས་ཅད་ཚང་བར་བྱ་བ་ཡིན་ལ།",
    "ཤིང་གི་རཀྟ་ལྔ།",
    "མེ་ཏོག་གི་རཀྟ་ལྔའོ།",
    "འདི་ནས་འབུལ་བའི་གནས་སྐབས་ན་ཧཱུྃ་ཞེས་བདག་མེད་རྟོགས་པའི་ཐུགས་སྲོག་རྡོ་རྗེའི་ངོ་བོ་ཧཱུྃ་གིས་མཚོན་པས་ཚིག་སྣ་དྲངས་ནས།",
    "ཉོན་མོངས་དུག་ལྔ་ཡེ་ཤེས་ལྔ་རུ་བསྒྲལ་བའི་ཁྲག་འདོད་ཆགས་སོར་རྟོག་ཡེ་ཤེས།",
    "ཁཱ་ཧི་བཞེས་ཤིག་གི་དོན་ཡིན་ནོ།",
    "ཡིས་འདའ་དཀའ་དམ་ཚིག་གི་རྒྱ་གསང་བ་རྡོ་རྗེ་གསུམ་གྱི་བཀའ་རྟགས་ཀྱི་རྒྱས་མནན་པའོ། ཆ་",
    "སྐུ་ནི་མི་འགྱུར་ཀ་དག་ཟང་ཐལ་སྐུ",
    "ནང་གི་ཡོན་ཏན་གྱི་དཔེ་ལྟ་བུ་ཕྱི་རོལ་ལ་སྣང་བས་ན་དཔེ་བྱད་གསུངས་སོ།",
    "རྒོད་དང་གཤེ་དང་རྔམ་པར་སྟོན་པ་གསུམ་དེ་གསུང་གི་གར།",
    "ཐལ་ཆེན་རཀྟ་ཞག་གི་ཟོ་རིས་དང་",
    "ཀོ་རློན་གཡང་གཞི་སྟག་གི་ཤམ་ཐབས་དང་",
    "དོན་དམ་བཅུད་ཀྱི་རྒྱན་ཨོག་མ་ན་གཟི་ཆེན་ཞག་གི་ཟོ་རིས་ཏེ་བྱུག་པའི་རྩི་གསུམ་མོ།",
    "དཔའ་རྟུལ་ཟ་བྱེད་ཀྱི་རྒྱན་སྟག་གི་ཤམ་ཐབས་སོ།",
    "ཁྲོ་མོའི་གཟིག་ཤམ་ཡང་དེ་དང་གཅིག་པ་ཡིན་ཞིང་།",
    "དེ་ཡིས་བགོ་བའི་གོས་གསུམ་མོ།",
    "བྲམ་ཟེའི་རིགས་དམར་བོས་སེ་མོ་དོ་དང་མགུལ་ཆིངས།",
    "རྡོ་རྗེ་མཐིང་གི་གཤོག་པ་བརྐྱང་།",
    "ཞེས་གསུངས་པ་ལྟར་དུ་ཐབས་དང་ཤེས་རབ་ཟུང་འབྲེལ་དང་སྲིད་ཞི་གཉིས་ཀའི་མཐའ་ལ་མི་གནས་པའི་རྟགས་སུ་རྡོ་རྗེའི་གཤོག་པ་ཡང་རང་ཅག་གི་བྲིས་ཆ་རྣམས་ཀྱི་ནང་ན་ཡོད་པ་ལྟར་དུ་ཡིན་ལ།",
    "ཁྱབ་མཛད་རེ་སྐོང་རྡོ་རྗེའི་གཤོག་པའི་ཆས།",
    "ཟིལ་གནོན་འཇིགས་པར་བྱེད་པ་ཐུགས་ཀྱི་ཡི་གེ་ཧཱུྃ་ཡིག་གིས་སྣེ་དྲངས་ནས།",
    "ཉག་གཅིག་ཟང་ཐལ་སྐྱེ་མེད་ལོངས་སྤྱོད་རྫོགས",
    "སྐུ་གསུང་ཐུགས་དང་རྩ་བ་ཡན་ལག་གི",
