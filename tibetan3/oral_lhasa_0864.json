    "ལེགས་འོང་ཆུ་གཙང་འོ་ཞོ་མཚོ་ལྟར་བསྐྱིལ།",
    "ཚེ་བསོད་རིགས་རྒྱུད་སྙན་གྲགས་རྒྱས་པར་མཛོད།",
    "བྱ་སྤྱོད་ཐུགས་དང་མཐུན་པར་འོང་དཀའ་བའི།",
    "ཅུང་ཟད་ཙམ་ལ་ཕྲག་དོག་མི་མཛད་པར།",
    "ཡབ་སྲས་བརྒྱུད་པར་བཅས་པའི་ཞབས་ལ་འདུད།",
    "ཡེ་ཤེས་སྐུ་དང་དབྱེར་མེད་བཞུགས་སུ་གསོལ།",
    "སྒོ་གསུམ་སྡིག་རྩང་འགྱོད་པས་བཤགས་བསྡོམས་ཤིང་།",
    "ཟག་མེད་འདོད་དགུ་ལྷུན་གྱིས་འགྲུབ་པར་མཛོད།",
    "མཁྱེན་རབ་འཕགས་པ་འཇམ་དཔལ་སྤྲུལ་བའི་སྐུ།",
    "དེ་ཡི་ཕྱི་ནང་གསང་བའི་རྣམ་པར་འཕྲུལ།",
    "འདོད་དགུ་ནམ་མཁའ་མཛོད་ལ་དགྱེས་པར་རོལ།",
    "ཁྱད་པར་སྣང་སྲིད་དྲེགས་པ་དགྱེས་བྱེད་ཀྱི།",
    "ཞིང་ཁམས་ནམ་མཁའ་མཉམ་པར་འཁྲིགས་པ་འདིས།",
    "བསྐང་བཤགས་དང་འབྲེལ་བར་བརྗོན་གཏོང་བར་འདོད་ན་འདི་ལྟར།",
    "དག་བྱེད་གཙང་མའི་རྒྱུན་གྱི་མཆོད་ཡོན་དང་།",
    "བག་ཕེབས་རྩེ་དགའ་རོལ་བ་སྣ་ཚོགས་འདིས།",
    "བཤོས་བུ་གཙང་སྦྱོར་གཏོར་མ་ཟག་མེད་ཀྱི།",
    "གཙང་རིས་ལྷ་ཚོགས་ཀུན་དང་ཡུལ་ཕྱོགས་འདིར།",
    "ད་བཅས་ཏེ་ལེགས་བཞེས་ནས།",
