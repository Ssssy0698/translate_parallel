    "བཟངལགསོལམཆོད་ཀྱི་ཆོ་ག་ཕན་བདེའི་ཆར་འབེབས།",
    "སྲུང་སྐྱོབ་རྡོ་རྗེ་ར་བ་བརྟན་པར་མཛོད།",
    "གཡས་བརྐྱངས་གཡོན་བསྐུམས་སྟབས་ཀྱིས་རྣམ་པར་འགྱིངས།",
    "བརྟན་པར་བཞུགས་ལ་མཆོད་བཞེས་འཕྲིན་ལས་མཛོད།",
    "དམ་ཚིག་ཉམས་ཆག་ཡོད་ན་སོས་པར་མཛོད།",
    "ཆུ་མིག་གཙང་མའི་མཆོད་ཡོན་ཞབས་བསིལ་དང་།",
    "ལྷ་སྲུང་དམ་ལ་བཏགས་ཚེ་བཀའ་བསྒྲགས་ལྟར།",
    "ལྷ་སྲུང་བསྐུལ་བའི་ཚེ་ན་བང་མ་བུལ།",
    "མཁྱེན་གཏེར་ངུར་སྨྲིག་གར་མཛད་བློ་བཟང་གྲགས།",
    "མགྲོན་དུ་འཕྲིན་ལས་རྣམ་པར་བསྒྲུབ་པའི་ཕྱིར།",
    "བརྩེ་བའི་ཐུགས་ཀྱིས་བརྟན་པར་བཞུགས་ནས་ཀྱང་།",
    "འདོད་དགུ་མ་ཚང་མེད་པའི་མཆོད་ཚོགས་བཞེས།",
    "སྙན་གྲགས་ཡར་ངོའི་ཟླ་ལྟར་རྒྱས་པར་མཛོད།",
    "ཆུ་གཙང་མེ་ཏོག་སྤོས་སོགས་གང་འབྱོར།",
    "ངོས་དག་རྒྱ་ཆེ་བཤམས་ལ་བསང་བདུག་བྱས།",
    "བསང་ཤིང་གཙང་མ་དུད་པ་དྲི་བཟང་དང་བཅས་སྟ་གོན་རྣམས་ཚང་བར་བྱས་ཏེ།",
    "མཁྱེན་བརྩེ་ཐུགས་ཀྱིས་གནས་འདིར་གཤེགས་སུ་གསོལ།",
    "འབྲུ་སྣ་གཙང་ཕྱེ་སྦྱར་བའི་གཏོར་མ་ནི།",
    "སྣོད་ཀྱི་ཁྱད་པར་ཕུན་ཚོགས་ཀུན་གྱིས་མཆོད།",
