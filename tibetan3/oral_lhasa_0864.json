    "སྣང་སྲིད་ཀུན་ལ་མངོན་ཤེས་རྣམ་པར་གསལ།",
    "མི་འདོད་ཉེར་འཚེ་ཀུན་ལས་བཟློག་བྱས་ནས།",
    "དམར་གཡོ་གཙང་སོགས་ཐུབ་པའི་རྟུལ་ཞུགས་ཀྱིས།",
    "ཤིས་བརྗོད་ཀྱི་ཚིག་བཅད་ཅི་རིགས་པས་ཀྱང་མཐའ་རྒྱན་པརབྱ་འདི་ནི་རང་གཞན་རྣམ་དཀར་བསྒྲུབ་པ་ལ།",
    "བྱ་བ་འགྲུབ་པའི་མཐུན་རྐྱེན་མཆོག་ཏུ་གསུངས།་",
    "ཆུ་གཙང་མ་བྲན།",
    "ཁྱད་པར་སྲ་བརྟན་བྲག་དཀར་ལྷ་རི་ལ།",
    "མདུང་རྣོན་གཡོན་པར་ཐོད་རློན་ཁྲག་བཀང་ཐོགས།",
    "ཐོགས་པ་མེད་པར་གནས་འདིར་གཤེགས་སུ་གསོལ།",
    "དགྱེས་པའི་གདན་ཁྲིར་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "འབུལ་གྱིས་དགྱེས་བཞིན་ཉེ་བར་བཞེས་སུ་གསོལ།",
    "ཐུགས་དང་འགལ་བ་ཅི་བགྱིས་བཤགས་བྱེད་ན།",
    "བཟོད་པར་བཞེས་ལ་བཅོལ་བའི་ལས་རྣམས་སྒྲུབས།",
    "གཞི་མ་དཀར་གཙང་སྟེང་དུ་ཕྱེ་མར་དཀར་གསུམ་མངར་གསུམ་གཙོ་བོར་གྱུར་པའི་གཏོར་མ་བང་རིམ་བཞི་ལྡན་སྟེང་དུ་ཅོག་གཏོར་དང་།",
