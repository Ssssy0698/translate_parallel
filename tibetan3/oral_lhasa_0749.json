    "ལོའི་ཟླ་བ་བཅུ་གཅིག་པའི་ནང་བྲིས་གྲུབ་པ་དང་སང་ལོར་དཔེར་སྐྲུན་བྱས།",
    "ཕེར་ཅིན་ཐེ་ནི་རྩོམ་པ་པོས་དེང་སྐབས་ནོར་ཝེའི་ནུས་མེད་སྤོབས་མེད་ཆུ་སྣ་གར་འཁྲིད་ཀྱི་ཁྱིམ་པ་དེ་རྣམས་རྗེན་བྲིས་གནང་བ་ཞིག་ཡིན་ནོ།",
    "རྒྱུག་ཅིག་མེས་རྒྱལ་གྱི་ས་གཞིའི་སྟེང་དུ་འཚོལ་ཞིབ་བྱེད་པར་ཕྱིན་ཏེ།",
    "རྗེས་སུ་སྙན་ངག་འཁྲབ་གཞུང་དུ་སྒྱུར་བཅོས་བྱས་པའི་པུའུ་ལང་ཏེ་ཞེས་པའི་ནང་ཨིབ་སེན་གྱིས་རྙིང་ཞེན་བག་འཁུམས་དང་།",
    "ཡར་རྒྱས་མི་འདོད་པའི་རྒྱལ་དམངས་ཀྱི་གོམས་གཤིས་ལ་དེ་བས་རྣོ་ངར་ཆེ་བའི་བསུན་འབྱིན་གནང་ཡོད་པ་འདི་ལྟ་སྟེ།",
    "གལ་སྲིད་ད་ལྟ་མིན་ནའང་མ་འོངས་པར་གང་ལྟར་སྙན་ངག་ཡིན་སྲིད།",
    "རང་ལོ་ཉི་ཤུ་རྩ་གཉིས་ལ་ཨའོ་སི་ལུའུ་རུ་ཕེབས་ཀྱང་སློབ་ཕྲུག་ཚོགས་པའི་ཁྲོད་ཀྱི་ཕུལ་བྱུང་མི་སྣ་ཞིག་ཏུ་གྱུར་ཡོད་པ་དང་།",
    "དེའི་ནང་ཁོང་དགུང་ལོ་ཉི་ཤུ་ནས་སུམ་ཅུ་སོ་དྲུག་དབར་གྱི་སྙན་རྩོམ་འདེམས་བསྡུས་གནང་ཡོད།",
    "ཕེར་ཅིན་ཐེ་ཞེས་པའི་ཇུས་ཉེས་ལ་གཞིགས་ཏེ་མ་རུང་ཁོག་བཅངས་ཀྱི་མིས་མུ་མཐུད་བསུན་པོ་བཟོས་མི་ཡོང་ངམ་སྙམ་པའི་ཐུགས་ཁྲལ་གྱིས་ཁོང་བློ་བདེ་པོ་ཞིག་བྱུང་མེད།",
    "དེས་ན་ཁོང་དང་སུའུ་ཧྲན་ན་ཞིབ་ཕྲའི་གྲོས་བསྡུར་བྱས་རྗེས་ཁྱིམ་ཚང་འཇར་མན་དུ་སྤོ་རྒྱུའི་ཐག་བཅད།",
    "མུའུ་ཉི་ཧའེ་ནི་ཡི་ཀྲར་གཙང་པོའི་སྨད་རྒྱུད་དུ་གནས་ཡོད་ཅིང་།",
    "སུའེ་ཏེན་གྱི་རྒྱལ་པོ་ཁྲ་ལི་བཅོ་ལྔས་ཁོང་ལ་སུའེ་ཏེན་གྱི་ལོར་ཏེ་ཞེས་པའི་རྟགས་མ་གནང་།",
    "ཨེ་ཅིབ་ཀྱི་ཆབ་སྲིད་སྐྱོང་སྟངས་ལ་ལྟ་ཞིབ་གནང་།",
    "ས་ཆ་དེ་གའི་མིའི་གུར་གྱི་ནང་དུ་ཞག་བཞུགས་གནང་སྟེ་ཡ་མཚན་འབུམ་གྱིས་ཁེངས་པའི་བས་མཐའི་ཡུལ་ལྗོངས་ལ་ལྟ་རོལ་གནང་།",
    "ཨིབ་སེན་དེ་སྔོན་བྱེས་བཞུགས་གནང་སྐབས་དབྱི་ཐ་ལི་དང་འཇར་མན་དུ་ཡུན་རིང་བཞུགས་མྱོང་ཡོད་པ་ལས་ཧྥ་རན་སེར་བཞུགས་མྱོང་མེད་པས།",
    "ད་ཐེངས་ཧྥ་རན་སེར་གནས་སྐབས་བཞུགས་རྒྱུ་བྱུང་བ་དེ་ནི་ཐོབ་དཀའ་བའི་གོ་སྐབས་ཤིག་ཡིན།",
    "དེས་ན་ཁོང་ལུན་ཏུན་དུ་ཐེངས་གཅིག་ཀྱང་ཕེབས་མ་ཐུབ་པ་དེ་ནི་མི་ཚེ་ཧྲིལ་པོའི་བློ་ཕམ་དགོས་པའི་དོན་ཞིག་ཡིན།",
    "འཁྲབ་གཞུང་དེ་ནི་ཨིབ་སེན་གྱིས་སྙན་ངག་འཁྲུབ་གཞུང་ནས་ལྷུག་རྩོམ་འཁྲབ་གཞུང་དུ་བར་བརྒལ་བྱས་པ་དང་།",
    "པེ་སི་མའེ་ཡིས་འཇར་མན་གཅིག་གྱུར་གྱི་བྱ་གཞག་ལ་བྱས་རྗེས་ཆེན་པོ་བཞག་ཡོད།",
    "གཅིག་གྱུར་གྱི་བྱ་གཞག་ལེགས་གྲུབ་བྱུང་རྗེས་ཁོས་ཕྱི་ཕྱོགས་སུ་མངའ་ཁོངས་རྒྱ་སྐྱེད་བཏང་སྟེ་ཧྥ་རན་སེའི་ཨར་ས་སི་དང་ལུའོ་ལིན་བཙན་བཟུང་བྱས་པ་དང་།",
    "ལོའི་ཟླ་པར་ཧྥ་རན་སེས་དགྲ་ལ་མཉམ་སྡང་ཀྱིས་འཇར་མན་ལ་དམག་བརྡ་བཏང་བས་འཇར་མན་གྱི་གནས་ཚུལ་ཛ་དྲག་ཅན་དུ་གྱུར།",
    "དེས་ན་ཨིབ་སེན་གྱིས་ཁྱིམ་མི་འཁྲིད་ནས་ཏེན་མག་ཏུ་ཕྱིན་ཏེ་ཀོ་པུན་ཧ་ཀེན་དུ་འཚམས་འདྲི་གནང་།",
    "དེ་ནི་ལོ་གོང་མར་སུའུ་ཏེན་དུ་རྟོག་ཞིབ་གནང་སྐབས་ཐོབ་པའི་སུའུ་ཏེན་གྱི་ལོར་ཏི་དང་མཚན་སྙན་མཉམ་པའི་གཟེངས་བསྟོད་རྟགས་མ་ཞིག་ཡིན།",
    "ལོར་གཞི་ནས་གྲུབ་སྟེ་དཔར་བཏབ།",
    "ཁོང་ཏེ་ལེ་སེ་ཏུན་དུ་ལོག་ཕེབས་སྐབས་པོ་ལན་ཏེ་སེས་སླར་ཡང་མཚམས་ཞུར་བཅར།",
    "ཨིབ་སེན་གྱིས་ཁོང་ལ་མིའི་བསམ་པའི་གསར་བརྗེ་དེ་ཆབ་སྲིད་ཀྱི་གསར་བརྗེ་ལས་ལྡབ་མང་པོས་ལྷག་པའི་མཚན་ཉིད་ཀྱི་རིགས་གཞུང་གླེང་གནང་།",
    "དེའི་དུས་ཨིབ་སེན་གང་ཕེབས་ས་ལ་མཚན་སྙན་འབར་གྱི་ཡོད་པས་ནོར་ཝེ་ནས་ཁོང་ལ་སྐྱབས་རྗེ་ཨོ་ལ་ཧྲུའི་བྱ་དགའི་རྟགས་མ་གནང་བ་དང་།",
    "ཟླ་བ་བཞི་པར་མུའུ་ཉི་ཧོ་རུ་ཁྱིམ་སྤོས་གནང་།",
    "ལོར་སླར་ཡང་མུའུ་ཉི་ཧོ་རུ་ཚུར་སྤོས་གནང་ནས་དེ་གར་ལོ་བར་བཞུགས་རྗེས་གཞི་ནས་ནོར་ཝེར་ཚེ་མཇུག་སྐྱེལ་བར་ཕེབས།",
    "ིཨོ་སེ་ཅ་སྐུ་ཕྲེང་གཉིས་པས་གནང་བ།",
    "ཁོང་ནི་ཡཁ་ལོའི་བར་སུའེ་ཏན་གྱི་གོང་མ་གནང་བ་དང་།",
    "ལོའི་བར་ནོར་ཝེ་རང་བཙན་མ་བྱས་བར་ནོར་ཝེའི་གོང་མ་གནང་ངོ།",
    "དེ་དག་ཐམས་ཅད་མི་སྒེར་དང་དགྲ་ཟླར་ལངས་པ་འབའ་ཞིག་ཡིན་པའི་ངོས་འཛིན་གནང་སྟེ།",
    "མི་སྒེར་གྱི་སྟོབས་ཤུགས་ནི་ཐམས་ཅད་ལས་ལྷག་པར་འཛིན་གྱི་ཡོད།",
    "ཆ་ནོར་ཝེར་ཕེབས་ནས་ཚེ་མཇུག་བསྐྱལ་གནང་བ།",
    "ཁོང་ལས་ཀར་འཇོན་ཐང་ཆེ་བས་ལོར་ཧྭ་ཧྲེང་ཏུན་དུ་བཅའ་སྡོད་ནོར་ཝེའི་གཞུང་ཚབ་ཁང་དུ་གོ་གནས་འཛིན་པར་བཏང་བ་དང་།",
    "ནམ་རྒྱུན་ཁྱིམ་ནང་བཞུགས་བཞུགས་པར་བར་མེད་རྩོམ་འབྲི་བྱེད་པ་ལས་གྲོགས་པོ་སྤུན་མཆེད་དབར་ཕན་ཚུན་འགྲོ་འོང་བྱེད་པའང་ཧ་ཅང་ཉུང་ཉུང་ཡིན།",
    "ཨིབ་སེན་ནི་རྒས་ཤིང་ཁོགས་པར་གྱུར་ཡང་དཔྱིད་ཀྱི་དར་འབུས་དར་སྐུད་སྐྱུགས་པ་ལྟར་རྩོམ་འབྲིའི་བྱ་བར་ཉིན་གཅིག་ལྟར་འབད་པས་གཞོལ་བཞིན་ཡོད།",
    "ལོར་ཨར་ལས་དབུ་ཆེན་ཞེས་པ་པར་སྐྲུན་བྱས་པ་དང་།",
    "ལོར་ཨའེ་ཡིའུ་ཧྥུ་ཆུང་ཆུང་ཞེས་པ་པར་སྐྲུན་བྱས།",
    "ལོར་ཡུའེ་ཧན་ཀའེ་པོ་ལུའི་ཨེར་པོ་ཁོ་མན་ཞེས་པ་པར་དུ་སྐྲུན།",
    "ཨིབ་སེན་གྱིས་ཟློས་གར་གསར་རྩོམ་གནང་ཚུལ།",
