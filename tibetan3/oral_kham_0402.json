    "ཀྲྀ་ཡ་ས་མུ་ཙའི་གཞུང་མཆན་བུར་བཏབ་འདུག་པ་ལྟ་བུ་མ་དཔེ་གཅིག་ལ་བསྟུན་མི་བདེ་བ་འགའ་ཞིག་ཐད་ཀའི་ཤོག་ངོས་དེར་གཤམ་མཆན་བཏབ་ནས་བཞག་ཡོད།",
    "འདིས་ཀྱང་རང་གཞན་ཐམས་ཅད་མྱུར་ཏུ་ཚོགས་གཉིས་རྫོགས་སྒྲིབ་གཉིས་སྦྱངས་ཏེ་འཚང་རྒྱ་བར་གྱུར་ཅིག།",
    "ཞི་ཁྲོ་རབ་འབྱམས་རང་རང་གདན་ལ་བཞུགས།",
    "དུས་གསུམ་དགེ་རྣམས་རང་རང་ཅི་འདོད་པའི།",
    "མྱུར་ཏུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "དགེ་སློང་རང་ཟག་ཟོག་མེད་པར་བཞུགས་ཤིག་གསུངས།",
    "དེ་ལྟ་བུའི་བདེ་བའི་སྟན་ལ་རང་ཉིད་འདུག་པའི་ཀུན་སྤྱོད།",
    "འདི་རྣམས་ཐོག་མེད་ནས་སྡུག་བསྔལ་གྱི་རྒྱུ་འབའ་ཞིག་བསྒྲུབས་པས་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་མྱངས་ཤིང་ད་ལྟའང་མྱོང་བཞིན་དུ་དེའི་རྒྱུ་བསྒྲུབ་པར་འདུག་པས་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་དང་བྲལ་ན་ཅི་མ་རུང་བྲལ་བར་གྱུར་ཅིག།",
    "ཞེས་རང་ཅག་རྗེས་འཇུག་རྣམས་ལ་ཐུགས་བརྩེ་བ་ཆེན་པོས་གདམས་པར་གདའ་བས།",
    "རང་ཉིད་མིར་སྐྱེས་པས་དལ་བ་དང་བོ་བཞི་དང་རང་འབྱོར་དང་བོ་ཚང་།",
    "ཚང་བ་ནས་རྡོག་ལྟ་བུའི་ཚོད་དུ་འདུག་པས་དལ་འབྱོར་ཚང་བ་ཤིན་ཏུ་དཀོན་ནོ་སྙམ་དུ་བསམ།",
    "ཡང་སོས་ནི་རང་ཉིད་དང་རང་དང་སྐལ་མཉམ་འཚམས་བ་ད་༤།",
    "ཡང་བྲོས་པས་ལྕགས་ཀྱི་ཁང་བ་ཅིག་ཏུ་སླེབས་པ་ན་སྒོ་དབྱེར་མེད་དུ་འགྲིག་སྟེ་ཕྱོགས་ཀུན་ནས་མེ་ལྕེ་འབར་བས་བསྲེག་ཅིང་ད་བྲོས་ས་མི་འདུག་སྙམ་ནས་ངུ་འབོད་ལྷང་ལྷང་བ་བྱེད་པའི་སྡུག་བསྔལ་ཆེན་པོ་མྱོང་།",
    "ལྕགས་ཁང་ནང་མ་ནས་ཐོན་སྲིད་ཀྱང་ཕྱི་མ་ནས་མི་ཐོན་པར་འདུག་སྙམ་པའི་སྒོ་ནས་བསྡུག་བསྔལ་དྲག་པོ་མྱོང་།",
    "དེ་དང་འདབས་ཆགས་པ་ན་ཕྱི་སའི་འདམ་རོ་ལྟར་མནམ་པ་ལ་བརྒལ་བ་ན་མགོ་བོ་མན་ཆད་བྱིང་སྟེ་འདུག་པའི་ཚེ་ལྕགས་ཀྱི་འབུ་ཆུ་རྣོན་ཞེས་བྱ་བས་རྐང་ལ་ཐུག་པར་འབིགས་ཤིང་ཟ་བའི་སྡུག་བསྔལ།",
    "དགུན་ལྷགས་སྒང་ལ་ཞག་གཅིག་གཅེར་བུར་འདུག་པ།",
    "གཞི་གཞན་གྱི་ནོར་དང་ལོངས་སྤྱོད་ལ་དེར་འདུ་ཤེས་ཤིང་རང་ནོར་ལ་ཆགས་སེམས་དང་གསོག་སེམས།",
    "མཐུ་སྟོབས་ཉམས་པས་ལྡང་འདུག་འགྲོ་བ་སོགས་དཀའ་བ་དང་།",
    "མ་འདིས་ཟླ་བ་བཅུའི་བར་དུ་མངལ་དུ་བཟུང་ཞིང་རང་ཉིད་བདེ་བ་དང་ལྟོགས་སྐོམ་སོགས་ཁྱད་དུ་བསད་ནས་ཕན་གནོད་ཀྱི་སྤྱོད་ལམ་ཐམས་ཅད་བུའི་ཆེད་དུ་བྱས་ཏེ་དལ་འབྱོར་གྱི་ལུས་སྲོག་འདི་བྱིན་པས་དང་བོར་དྲིན་ཆེ།",
    "གཞན་གཅེས་འཛིན་ནི་ཕུན་ཚོགས་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་སུ་གདོན་མི་ཟ་བར་འདུག།",
    "གསལ་ཆའི་ངར་ཆ་ཧད་ཀྱི་ཤོར་ནས་དྭངས་ཆ་ཙམ་ལས་མི་འདུག་ན་བྱིང་བ་རགས་པ་བྱུང་བ་ཡིན་པས་ངོ་ཤེས་པར་བྱས་ལ་བསྒྲིམས་ཏེ་བསྒོམ།",
    "དེ་ལྟར་བྱིང་རྒོད་སོགས་བཀག་ནས་གྲིམ་ལྷོད་རན་པའི་འཚམས་རང་ཉམས་ལ་དཔགས་ཏེ་རིག་པ་འཕངས་འདི་ཙམ་ཞིག་བསྟོད་ན་རྒོད་པ་སྐྱེ་བར་འདུག་སྙམ་པའི་ཚད་དེ་ལས་ནི་ལྷོད་ལ།",
    "འདི་ཙམ་ཞིག་ལ་བཞག་ན་བྱིང་བ་སྐྱེ་བར་འདུག་སྙམ་པའི་ཚད་དེ་ལས་འཕངས་མཐོ་བའི་འཇོག་འཚམས་ཟིན་པར་བྱས་ལ་རྩ་བའི་དམིགས་པའི་སྟེང་དུ་ཙཀྱི་དག་ད་ས་ལེསལ་ཨ་དེ།",
    "ལུས་སེམས་གཉིས་ཀྱི་སྟེང་དུ་ང་རང་བཞིན་གྱིས་ཚུགས་ཐུབ་ཏུ་གྲུབ་པ་འདི་དང་ལུས་སེམས་གཉིས་པོ་དེ་གཅིག་དང་ཐ་དད་གང་རུང་དུ་མེད་པའི་ཕུང་གསུམ་པ་ཞིག་ཡིན་ནམ་སྙམ་དུ་རྩད་བཅད་པ་ན།",
    "དེ་ནས་དེ་ལ་ངེས་པ་རྙེད་ནས་ང་དང་ལུས་སེམས་གཉིས་ཐ་དད་ལས་འོས་མི་འདུག་སྙམ་པ་ནས།",
    "འདིས་ཀྱང་རང་ཉིད་གཅེས་འཛིན་སོགས།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "མྱ་ངན་འདས་པའང་རང་དོན་དུ།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "བདེ་བའི་སྟན་ལ་ལེགས་འདུག་སྟེ།",
    "འགྲོགས་ནས་འགྲོ་འམ་འདུག་པའི་ཚེ།",
    "ཁོ་རང་གང་འདོད་བྱེད་འཇུག་ཅིང་།",
    "འོན་ཀྱང་རང་ཅག་མི་དགེ་དང་།",
    "འདུག་དང་དམིགས་པར་གཏོད་ལ་མི་དགའ་བ།",
    "དང་རང་བཞིན་གྱིས་གཅིག་ཏུ་མེད་དེ།",
    "དང་རང་བཞིན་གྱིས་ཐ་དད་དུ་མེད་དེ།",
    "ཚོགས་པ་རྫས་སུ་གྲུབ་ན་ཚོགས་པ་ཅན་ཡན་ལག་རྣམས་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་རུང་དུ་འགྱུར་ལ།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་གཅིག་ཏུ་འདོད་པ་ལ་དབྱེར་མེད་གཅིག་ཏུ་འཕུལ་ནས་སྐྱོན་དེ་གཉིས་ཀ་འབབ་པར་སྟོན་པའོ།",
    "བདག་ཕུང་བོ་དང་རང་བཞིན་གྱིས་ལྡན་པའི་ཕྱོགས་ཀྱང་མི་འཐད་དེ།",
    "ང་རང་བཞིན་གྱིས་གྲུབ་པས་ཁྱད་པར་དུ་བྱས་ནས་འཛིན་པ།",
    "དེ་ཡང་དེ་ལྟ་བུའི་ང་དེ་ཕུང་བོའི་སྟེང་དུ་གྲུབ་ན་ཕུང་བོ་དང་གཅིག་ཐ་དད་གང་རུང་དུ་གྲུབ་དགོས་པར་འདུག་པ་ལས་ཕུང་བོ་དང་གཅིག་ཏུ་ཨེ་གྲུབ་སྙམ་ན།",
    "གཏན་ནས་མི་འདུག་སྙམ་དུ་ངེས་པ་ན།",
    "སྡུག་ཞིང་རང་ལ་བསྡུ།",
    "གོང་འོག་གྱིས་རང་རང་འདོད་པ་བཞིན།",
    "བསམ་སྟེ་རང་རང་ཡེ་ཤེས་པ།",
    "རྩེ་གཅིག་བསམ་པ་ཐག་པས་ལེགས་ལྕང་སྐྱ་ངག་དབངཟླཔཟང་ཆས་ལྡནགསུང་འདུག་ཁ་༡་།་",
    "ཞེ་ཕུགས་སུ་འཚངས་འདུག་པས་ལྟ་བའི་གོལ་ས་ཤིན་ཏུ་ཆེ་བ་ལ་གནས་པ་ཡིན་ནོ།",
    "དེ་ཡང་ང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་རང་ངོས་ནས་གྲུབ་པའི་ང་གཉིས་ཀ་སྐབས་འདིའི་དགག་བྱའི་བདག་ཡིན་པ་ལ་ཁྱད་པར་མེད་པས།",
    "དེས་ན་གཞུང་རྣམས་ནས་ང་ཙམ་འཚོལ་བའི་གཞིར་བྱས་ནས་དེ་ཕུང་བོ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཐ་དད་གང་དུའང་མ་རྙེད་པའམ་མེད་པར་རྙེད་པ་བདག་མེད་རྙེད་པར་གསུངས་པ་དང་།",
    "སྣང་ཡོད་པ་ལས་དང་བོ་བས་མི་ཁེགས་ཀྱང་ངེས་ངོར་འཛིན་སྟངས་ཀྱི་ཡུལ་དུ་ང་རང་བཞིན་གྱིས་གྲུབ་པ་བཀག་ཙམ་གྱི་མེད་དགག་ལས་གཞན་ཀུན་རྫོབ་ཀྱི་སྣང་ཆ་ཅི་ཡང་མི་འཆར་བར་བྱས་ཏེ་སྐྱོང་བ་ནི་མཉམ་བཞག་ནམ་མཁའ་ལྟ་བའི་སྐྱོང་ཚུལ།",
    "འཕྲལ་བློ་ལ་མི་ཤོང་ཡང་དོན་དུ་དེ་ཀ་ཡིན་པར་འདུག་གསུང་ངོ།",
    "མི་འདུག་སྙམ་དུ་བཟུང་ན་ཆད་མཐར་ལྟུང་།",
    "དེའི་ཚེ་གཞན་འཇོམ་པའི་མདའ་མཚོན་དང་རང་སྲུང་བའི་གོ་ཆ་སོགས་ཅི་ཡང་མ་བཟུང་བར།",
    "གཞུང་ཕྱི་མ་དེ་སྔ་མ་གཉིས་ཀྱི་འགྲེལ་བ་ལྟ་བུར་འདུག་པས།",
    "གཞན་གྱིས་ངོ་བསྟོད་བྱེད་ནའང་རང་ཉིད་ལ།",
    "ཕེབས་སྐབས་བླ་སྤྱི་སོ་སོར་མཛད་འདུག་ཀྱང་།",
    "ཡུན་རིང་མ་ལོན་གཅིག་ཏུ་བསྒྲིལ་འདུག་པ།",
    "འགྲོ་འདུག་སོགས་ཀྱི་གསུང་གླེང་གང་རྒྱས་གནང་།",
    "བསིལ་ཁང་ཕུག་ནས་དེ་རུ་འདུག་བཅུག་སྟེ།",
    "འོང་འདུག་སྐོར་སོགས་བསླབ་སྟོན་ནང་སྦྱར་སྩལ།",
    "འོང་སྐད་འདུག་པས་ངེད་ཚོ་དེ་ལ་འགྲོ།",
    "མང་ཉུང་འཚམ་པ་བྱུང་འདུག་ཁོ་བ་ནི།",
    "གང་དང་ཅི་ལ་བཀོད་པ་ཐོན་པ་འདུག།",
    "ཁོང་རང་གཉིས་ཀྱི་སྐྱེས་མ་སྤུས་གཙང་ཞིང་།",
    "ཁོང་རང་སྔར་ནས་དགོན་འདིར་རྒྱུད་གྲྭ་ཞིག།",
    "ཤིང་རྩི་དང་བཅས་ལེགས་པར་གྲུབ་འདུག་ཅིང་།",
    "བཏང་ཞིང་ཁོང་རང་མཁར་སྔོན་ཉིན་སླེབ་པ།",
    "ང་རང་སྡོད་པའི་ཁང་བར་ཕེབས་ཏེ་བཞུགས།",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ཅིང་།",
    "ཡོངས་སུ་དག་གོ་ཞེས་ཁོ་ན་ཉིད་མཆི་ཡིན་གདའོ།",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་པའི་ཕྲག་པ་གཡོན་པ་ལ་གདིང་བ།",
    "མིན་ན་བར་ཆད་དང་མི་ལྡན་པར་གདའ་ལགས་ཞེས་བརྡ་སྤྲོད།",
    "ཅི་ལ་ལོངས་སྤྱད་ཀྱང་སྡུག་བསྔལ་གྱི་ལོངས་སྤྱོད་ལས་མི་འདུག་པས།",
    "འདི་ལ་དངོས་དང་འདི་ལ་རྒྱུའི་བྱིན་བརླབས་འཆགས་པར་གདའ།",
    "ཁྱེད་རང་ལེགས་སོ་གྱིས་བྱས་ལ།",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་སྟེ།",
    "དེ་ནས་བསྒྲུབ་བྱ་ལ་ངེད་ལ་ཕྱག་གསུམ་ཕུལ་ལ་སྔར་བཞི་ཕ་གུའི་སྟེང་དུ་འདུག་ཅིག་ཅེས་བསྒོ་ལ།",
    "༡ ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྐོར།་",
    "ཁྱེད་རང་བརྒྱུད་པར་བཅས་རྣམས་ཀྱིས།",
    "རི་ལྡེབས་ནས་ཕྱུགས་རྫི་བ་རྣམས་ཀྱིས་མཐོང་སྟེ་རྒྱ་གར་བཛྲ་ལ་གཡུའི་ཐོག་ཕུབ་འདུག་གོ་བྱས་པས།",
    "དེ་ཐོག་བི་རོ་ཙ་ན་ཡིས།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་གཉིས་ཀྱིས་བོད་སྐད་དུ་བསྒྱུར་བ་ཞིག་ཡིན་པར་ངོས་འཛིན་གནང་བ་ཡོད་ཀྱང་།",
    "ཞེས་འཁོད་འདུག་གོ།",
    "དེ་ཡང་མངའ་བདག་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་ཐུགས་དགོངས་ལ་ཡབ་མེས་རྣམས་དང་རང་ཉིད་ཀྱིས་ཀྱང་བ།",
    "༡ ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྐོར།",
    "བི་རོ་ཙ་ན་ཞེས་པ་ནི་ལེགས་སྦྱར་གྱི་སྐད་ཡིན་ལ་བོད་སྐད་དུ་རྣམ་པར་སྣང་མཛད་ཅེས་པའི་དོན་ཡིན།",
    "སྔགས་བསྒྱུར་ནང་དུ་བེ་རོ་ཙ་ན་བྲིས།",
    "བེ་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "ཞེས་ལོ་ཆེན་བེ་རོ་ཙ་ནའི་དགོངས་པ་ནམ་མཁའ་ལྟ་བུ་ཕ་མཐའ་ཡས་པར་བསྟོད་བསྔགས་མཛད་པ་ལྟར།",
    "ཁྲི་སྲོང་ལྡེ་བཙན་བསྐུལ་ནས་བི་རོ་ཙ་ན་ནི།",
    "དུས་དེའི་ཚེ་གཡུ་ཐོག་ཆེན་པོས་ཀྱང་རང་ཉིད་ཀྱི་བསྟན་བཅོས་བརྩམས་པའི་ཆེ་བ་བརྗོད་དེ་གསུངས་པར།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "༣ ལོ་ཆེན་བེ་རོ་ཙ་ནའི་འཁྲུངས་ལོ་དང་།",
    "མཁས་པའི་ཁྲོད་དུ་ཕ་སྟོན་པ་ལ་བུའང་སྟོན་པ་བྱུང་འདུག་ཅེས་བུ་སྟོན་ཞེས་པའི་མཚན་ཡང་དེ་ནས་ཐོགས།",
    "ཅེས་གསུངས་འདུག་པས་དཔྱད་དགོས།",
    "སྣམ་སྣང་སྤྲུལ་པའི་ལོ་ཆེན་བེ་རོ་ཙ་ན་སོགས་འཕགས་བོད་ཀྱི་མཁས་གྲུབ་ཤིང་རྟ་ཆེན་པོ་དུ་མའི་རོལ་པར་བཞེངས་ནས་རྒྱལ་བསྟན་སྤེལ་བར་མཛད་པ་པོ་ཁོང་ནི།",
    "དུས་ད་ལྟའང་རང་ཅག་ཀུན་གྱི་མཐོང་སྤྱོད་དུ་གྱུར་པ་འདི་ལྟར་ལགས།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "གཞན་གྱི་བུ་བྱས་པའི་གནས་འདུག་ནས།",
    "ཀཾ་ཀ་ནི་ཀཾ་ཀ་ནི་རོ་ཙ་ནི་རོ་ཙ་ནི་འུ་ནི་དྲོ་ཊ་ནི་ཏཱ་ས་ནིཏྟས་པ་ཏི་ཤཱ་ན་བུ་ཏི་ཧ་ན།",
    "དེ་བཞིན་གཤེགས་པ་ལ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "མ་བསླབས་ཁ་རོག་འདུག་པ་ལ།",
    "བརྙས་ཐབས་བྱེད་ཅིང་རང་མཐོང་ཆེ།",
    "སྟན་ལ་གཡོ་མེད་དྲང་པོར་འདུག།",
    "འདུག་ན་གསེར་གྱི་རི་བཞིན་དུ།",
    "ཕ་རོལ་དུའང་རང་ཉིད་བདེ།",
    "སྐྱོང་ཚུལ་རང་རང་ལས་དང་ནི།",
    "རང་རང་ལས་ཀྱིས་བདེ་བར་སྐྱོང་།",
    "རང་རང་མངའ་རིས་གཏོགས་པ་རྣམས།",
    "རྒྱལ་པོ་དེ་ནི་ཡན་ལག་དུས།",
    "ཁོ་རང་ཉེས་པས་ཕུང་འགྱུར་ཞིང་།",
    "མི་བདག་དུས་སུ་བསྒྲིམ་བྱ་སྟེ།",
    "མི་གཙང་རང་ཐོག་འབབ་པ་བཞིན།",
