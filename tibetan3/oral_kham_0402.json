    "འདི་ཁོ་ན་ལ་སྦྱངས་འདུག་སྙམ་པ་དང་།",
    "ནེའུ་གསིང་སྔོན་པོའི་ཐང་གཅིག་ལ་རྡོ་དཀར་ལ་འཇམ་པ་གཅིག་འདུག་པས།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་ཟེར་བ་དེ་ཤིན་ཏུ་བདེན་པར་འདུག།",
    "དེ་མིན་ན་ཕྱྭ་པའི་སྐུ་འབུམ་ལ་མི་མཇལ་བ་འདུག་གསུང་ནས་མཉེས་ཚོར་ཆེན་པོ་མཛད།",
    "འདི་ནས་གཞན་དུ་མི་འབྱོན་པར་གསོལ་བ་ཐོབ་ཟེར་ཞིང་འདུག་པའི་སྣང་བ་གཅིག་བྱུང་།",
    "ཞབས་དྲུང་པ་རྣམས་ཀྱིས་ད་ལན་རང་སྐུ་ཁམས་ཀྱིས་མི་ལྕོག་པར་གདའ་བས།",
    "ལམ་རང་སོ་བསོད་ཅིང་དགེ་སྦྱོར་འཕེལ་བར་འདུག་གསུངས་ནས།",
    "ཡུས་ཆེ་ཆེ་ལྟར་འདུག་པའི་སྣང་བ་གཅིག་བྱུང་།",
    "དེ་ད་དུང་ལྷང་ལྷང་འདུག་གསུང་།",
    "སོ་བསོད་པ་དགེ་སྦྱོར་འཕེལ་བར་འདུག་པས།",
    "མ་ཚོར་བར་བསྡད་ན་རང་འཐད་པར་འདུག་སྟེ་མི་ཉན་ཡོང་གསུང་།",
    "ཞུས་ན་མང་རབ་གསུང་བའི་རིགས་སུ་འདུག་པས།",
    "འོ་ནའང་དགོས་པ་གཅིག་འདུག་པས་བྲིས་ཤིག་གཅིག་གསུང་ནས།",
    "འདིར་སྡོད་མི་དགོས་པས་ཁྱེད་རང་རྣམས་རང་ཉོལ་ཞིག།",
    "ཐུགས་བསྐྱེད་གཅིག་མཛད་ཅིང་འདུག་པ་དང་།",
    "གཞིས་ཀ་གོང་འོག་དང་འབྲེལ་ཡོད་ཀྱི་བུ་སློབ་པ་དརྣམས་ཀྱིས་རང་རང་སོ་སོས་རྩེ་གཅིག་ཏུ་གསོལ་བ་བཏབ་སྟེ།",
    "ང་འགྲོ་དགོས་ན་ཁྱེད་རང་རྣམས་མ་ཅིག་པ་དང་།",
    "དེ་བར་དུ་ང་འདིར་འདུག་པ་ཡིན།",
    "དྲུང་པ་འདི་པ་ལམ་འབྲས་ཀྱི་བདག་པོ་ཞིག་འོང་པར་འདུག་སྟེ།",
    "འདི་པ་ཐ་མལ་པར་མི་འདུག་གསུང་ནས་ཤིན་ཏུ་ངོ་མཚར་བར་གྱུར།",
    "བྲིས་ཤིག་ཟེར་བའི་སྣང་བ་ཞིག་བྱུང་བས་མགོ་ཐོན་པ་ཞིག་འོང་བར་འདུག་སྙམ་པ་བྱུང་གསུང་བ་བཞིན་ཐུགས་རྩོལ་ཀྱང་ཆེར་མཛད་དེ་ཧོར་གྱི་གཙེས་པས་བྲོས་བྱོན་པའི་ལམ་རྣམས་སུ་ཡང་རྩོམ་པ་རྒྱུན་མ་བཅད།",
    "སྐྱེད་བསྲིང་པའི་ཚེའང་རང་བཞིན་གྱིས་ཡིད་གཞུངས་ཤིང་།",
    "རིགས་ཀྱི་སྲས་འདི་ནི་གཞན་གྱིས་གནོན་པའི་རྩོལ་བ་མི་དགོས་པར་འདུག་ལ།",
    "ཆུན་པ་གཅིག་བྱུང་དྭོགས་རང་མི་འདུག་གསུངས།",
    "སློབ་དཔོན་ཆེན་པོ་འདི་ནི་སྐུ་ཚེ་དཔག་ཏུ་མེད་པ་ནས་ལམ་འདི་ལ་སྦྱངས་པའི་གང་ཟག་གཅིག་འདུག་ཅེས་ཟེར་ཞིང་།",
    "མང་པོའི་ནང་དུ་ངེས་པ་དང་བཅས་ནས་གསུང་བའི་ཐོགས་པ་མེད་པ་གཅིག་འདུག།",
    "འདི་ལའང་གཞན་གསལ་པོ་མང་པོ་ཡོད་ཀྱང་མི་དྲན་པར་འདུག་གསུང་།",
    "ཡིད་ལ་མ་བཟུང་བས་བརྗེད་འདུག་གསུང་།",
    "ཡང་དུས་ཤིག་ན་འགྲོ་མགོན་འཕགས་པ་དང་ཡང་མཇལ་བ་ཞིག་རྨིས་ཏེ་ཁྱད་པར་རྣམས་བརྗེད་འདུག་གསུང་།",
    "ཁྱད་པར་དུ་དྲུང་པ་ལའང་ཁྱེད་ལ་ཧོར་གྱི་གདན་འདྲེན་ཡོང་བར་འདུག།",
    "འོན་ཀྱང་སྐུ་ཚེ་ཐུང་བར་འདུག།",
    "འོན་ཀྱང་ད་རུང་དུས་སྐལ་ཅི་རིགས་པ་ལས་མི་ཡོང་བར་འདུག་པས།",
    "དེང་སང་ཡང་སྐབས་ལ་ལར་འོང་ཞིང་འདུག་གསུང་ངོ།",
    "འདམ་ཞེས་བྱ་བ་ཡོད་འདུག།",
    "དེ་བར་དུ་འབྱོན་དགོས་པར་འདུག།",
    "དེ་ནས་འབྱོན་མི་དགོས་པར་འདུག་ཅེསལུང་བསྟན།",
    "ཁོང་པ་རང་ལ་དེའི་རྣལ་ལམ་གཅིག་བྱུང་བ་ཡིན་པར་འདུག་ཅེས་གསུང་ངོ་ ཡང་ཐོས་བསམ་སྒོམ་གསུམ་གྱི་ནོར་གྱིས་རྒྱུད་གང་བའི་སྡོམ་བརྩོན་དམ་པ་མཁན་ཆེན་གཞོན་ནུ་མགོན་པོ་ལའང་།",
    "དེའི་ཕལ་ཆེ་བ་གཅིག་ད་ལྟ་ནུབ་ནས་ཁུངས་སྟོར་འདུག་ནའང་།",
    "ཉིན་རངས་སུ་འདུག་པས་ཀུན་གྱིས་ངོ་མཚར་དུ་བྱེད་དོ།",
    "རྣལ་སད་ནས་ཐུགས་དགོངས་ལ་ཧོར་གྱིས་གདན་འདྲེན་གཅིག་ཡོང་བ་ཡིན་པར་འདུག་ཀྱང་འགྲོ་མི་དགོས་པ་ཡིན་པར་འདུག་སྙམ་ཞེས་གསུང་ངོ།",
    "དཔོན་ཡིག་མཉྫུ་ཤྲཱི་དཔོན་སློབ་དཔེ་གོག་གཅིག་འདུག་པའི་ཕིབས་འོག་ཏུ་གཟིམས།",
    "གནས་ཚང་དེ་པའི་ཁང་པ་ལ་ཐོག་རྒྱབ་ནས་གནས་པོ་དེ་ཤི་ཡོད་པར་འདུག།",
    "ངེད་ལ་ཞུ་བ་བྱ་རྒྱུ་ཡོད་པ་ཡིན་ཟེར་ཞིང་འདུག་པ་དང་།",
    "སྒྲོམ་བུ་གཅིག་ཁྱེར་འདུག་ནས།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་མ་ཡིན་སྙམ་པ་གཅིག་ཀྱང་འདུག་པ་ན།",
    "མཁན་ཆེན་པས་འདི་རང་མཁའ་སྤྱོད་ཡིན་ཞེས་གསུངས་ཤིང་འདུག་པའི་སྣང་བ་གཅིག་བྱུང་།",
    "སུས་ཀྱང་བསྲེག་པ་མི་འདུག་པ་དང་།",
    "དེར་བྱོན་ན་འགྲོ་དོན་ཆེན་པོ་འོང་བར་འདུག་སྟེ་སྐུ་ཚེ་ཐུང་བར་འདུག།",
    "འོན་ཀྱང་འབྱོན་མི་དགོས་པ་བྱེད་མཁན་འདྲ་འོང་བར་འདུག་ཅེས་དང་།",
    "བོད་འདིར་དུས་སྐབས་ངན་པ་འཆར་ཞིང་ཡུན་རིང་བསྡད་ཀྱང་མི་ལེགས་པ་མང་པོ་མཐོང་བར་འདུག་ཅེས་པ་དང་།",
    "རང་རང་སོ་སོ་ཇི་ལྟར་དགའ་བ་དེའི་མཐུན་ཕྱོགས་ཁོ་ན་མཛད་དེ།",
    "རང་རང་སོ་སོ་ནས་ས་སྐྱའི་བདག་པོ་བྱ་བར་འདོད་པས།",
    "ས་སྐྱར་བཞུགས་ཙ་ན་སྐུ་བསོད་དང་མངའ་ཐང་ལ་མི་འཆམ་པས།",
    "སང་བལྟས་པས་ཉིན་པར་བྲིས་པ་དང་ཁྱད་མི་འདུག་པ་དང་།",
    "རང་རང་སོ་སོའི་སྣང་ངོར་མང་དུ་གསུངས་ཤིང་།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་མ་ཡིན་སྙམ་པ་གཅིག་འདུག་པ།",
    "འདི་ཀ་ཙམ་པའི་དེ་བཞིན་གཤེགས་པ་མང་པོས་ཞིང་འདི་ཐམས་ཅད་གང་འདུག་གསུངས།",
    "སུས་ཀྱང་ཅི་ཡང་བསྲེགས་པ་མི་འདུག་པས།",
    "འོ་ད་རན་བྱུང་གསུངས་ནས་བཞེངས་པའི་ཚུལ་མཛད་ཀྱིན་འདུག།",
    "སློབ་དཔོན་ཆེན་པོ་འདི་ཉིད་སྐུ་ཚེ་དཔག་མེད་ནས་སྦྱངས་པ་གཅིག་འདུག་ཅེས་ཀུན་གྱིས་བསྟོད་དོ།",
    "སྤོང་དག་དུས།",
    "དེ་ལྟར་བྱུང་བ་འདིའི་ལྟས་སུ་འདུག་གསུངས།",
    "ཏིང་ངེ་འཛིན་གྱི་སྐྱེ་ཚུལ་བཟང་བར་འདུག།",
    "འདི་ནི་ཐ་མལ་པར་མི་འདུག་ཅེས་གསུངས་པ་སོགས་ཀྱི་སྒོ་ནས་བསྔགས་པ་ཡང་ཆེར་མཛད་པས་ཐམས་ཅད་ངོ་མཚར་དུ་གྱུར།",
    "འོན་ཀྱང་སྐུ་ཚེ་ཐུང་བར་འདུག།",
    "སྤྱིར་བསྟན་པ་ལ་ཕན་པ་རྒྱ་ཆེན་པོ་འོང་བར་གདའ།",
    "རྗེ་བཙུན་གོང་མའི་གསན་པ་ཕལ་ཆེ་བ་ཞིག་ད་ལྟ་ནུབ་ནས་ཁུངས་གཏོར་འདུག་ནའང་།",
    "མནལ་སད་ནས་ཐུགས་དགོངས་ལ་ཧོར་གྱི་གདན་འདྲེན་ཞིག་ཡོང་བ་འདུག་ཀྱང་འགྲོ་མི་དགོས་པ་འདྲ་སྙམ་པ་བྱུང་གསུངས་པ་ཡང་ཇི་ལྟ་བ་བཞིན་དུ་བྱུང་ཞེས་གྲགས་ལ།",
    "དེའི་ཚེ་ཀོ་བ་ལ་འཇའ་ཚོན་ཉིས་རིམ་དུ་ཟུག་འདུག་པའི་ཆིབས་མཛོ་བ་འགའ་ཞིག་ལ་སོགས་པ་མང་པོས་མཐོང་ཞེས་གྲགས་སོ།",
    "སང་བལྟས་པ་ན་ཉིན་པར་བྲིས་པ་དང་ཁྱད་པར་མི་འདུག་པས།",
    "ཁྱེད་རང་ཕྱིན་པས་ལེགས་པོ་འོང་།"
  ]
