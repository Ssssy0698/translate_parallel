    "རྣམས་ཀྱིས་བཅུག་པར་གོ་སླའོ།",
    "འདས་ནས་རིང་སྲེལ་མཆོད་རྟེན་བརྒྱ་རྩ་བྱས།",
    "རྒྱལ་པོ་བཞུགས་དུས་ཉིད་ཏུ་བརྩིགས་སོ་སྐད།",
    "དེ་ནས་བཙན་པོ་ལྷ་སྲས་ཀྱི་ཞལ་ནསས་བཙན་པོ་ལ་སྲས་ཀྱི་ཞལ་ནས།",
    "སྲས་མུ་ནེ་བཙན་པོསྲས་མུ་ནེ་བཙན་པོ་ཆབ་སྲིད་ལ་བསྐོ་བ་དང་གསང་ལ་བབློན་པོ་ཞང་དབུ་རིང་བློན་པོ་ལ་བསྐོ་བའི་གྲོས་དབུ་རྩེ་ན་བྱེད་ཅིང་བཞུགས་པ་ངོ་མམེ་སྒེནགྱིས་གསལ་བབ་ཀྱིས་སོ་བར་དུ་ཆུ་གྲིས་བཀུམམཐོང་སྟེ་ཐུགས་གཏུམ་པོས་ཆབསྲེདསྣ་ནོཔ་ལ་སྟེར་ཛེསཾསྙམ་སྟེ་མུ་ཏིག་བཙན་པོ་ལ་གསོལ་བས་ལྷ་སྲས་ཀྱིས་སྒོ་བར་དུ་ཆུ་གྲིས་བཀུམ།",
    "མུ་ནེ་བཙན་པོས་ལཉེར་དགུ་བཞུགས་བྱ་བ་དང་།",
    "སྲས་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་སྐུ་རིང་ལ་ཤོག་བུ་བད་ག་ལ་གསེར་གྱིས་བྱས་ཏེ་འཤ་མེན་གྱི་སྒྲོམ་བུརབསྩལ་ནས།",
    "བསམ་ཡས་ལྷུན་ཀྱིས་འདུ་ལགཁང་དུ་ཡུབ་ཀྱིཤྩ་ལ་བཞག་པ་ལས་དཔེ་བགྱིས་ཏེ་བྲིས་པ། ། དམཔའི་ས་ནམ་དུ་ཡང་མི་གཞིགཔར།",
    "ལྷ་སའི་དཔེ་ཧར་བརྩིགས་པ་ཚུན་ཆད།",
    "ཐུགས་དམ་དང་དབུལ་སྙང་བཞེས་ཏེ་གཙིགས་སུ་མཛད་པསཐུགས་དམ་དང་དབུའ་སྙང་བཞེས་ཏེ་གཙིགས་སུ་མཛད་པས།",
    "བ་སྲིད་ཀྱིདབོན་སྲས་སྐུ་ཆུངདུན་བཞུགས་པ་ཡན་ཆདལྟས་ལས་སོགས་ཏེ་ཅིའི་ཕྱིར་ཡང་རུང་སྟེ།",
    "དེད་ཡབ་སྲས་ཀྱིས་མཆོད་གནས་སུ་གནང་བ་བཞི་ངེང་ཡབ་སྲས་ཀྱིས་མཆོད་གནས་སུ་གནང་བ་བཞིན་དུ་བྱས་ཏེ།",
    "གདུད་རྒྱུད་ལས་དབའ་སྙུང་བཞེས་དགོས་པའམ།",
    "ཞང་སྣ་ནམ་རྒྱལ་ལགས་དགེ་ཚུག་ཞང་སྣ་ནམ་ལྷ་བཞིར་སྤྱི་བཙན་བློནལྷ་བཟང་བྱིན་བྱིན།",
    "ལྷ་སྲས་གཙང་མ་རྒྱལ་སྲིད་རྩྭ་ལྟར་སྟངས།",
    "མཐའ་བཞི་ཀུན་ལས་རྣམ་པར་རྒྱལ་གྱུར་སྟེ།",
    "ས་ལ་བཙན་པོ་དབོན་ཞང་ལས་མེད་ཏོ་བར་བགྲོས་ནས་ཕ་བོང་ལ་ཉི་ཟླའི་གཟུགས་བྱས།",
    "བྱེསྲང་དང་ཞེ་ཆ་ཚུན་རྒྱ་གར་གྱི་དབུས་འགྱུར་ཚལ་དང་མཐུན་པར་བཅོས།",
    "སྐུའི་རྟེན་ཐམས་ཅད་རྒྱ་གར་གྱི་ཡུལ་དབུས་ཀྱི་ལྷ་ལ་དཔེ་བྱས་ལ་དཀར་དམར་ལམ་ལུགས་སུ་བླུག་པ་ཛམྦུ་ཆུ་བོའི་གསེར་གྱིས་གཡོགས་པ་འབའ་ཞིག་དུ་མཛད།",
    "སྤྱིར་འདི་ཡན་ལ་བོད་ཀྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་གཙུག་ལག་ཁང་སྟོང་དང་བརྒྱད་བཞེངས་པར་འདོད་ཏོའདོདཏོ།",
    "ལྷོ་ཕྱོགས་བྲམ་ཟེའི་ཡུལ་ལས་ཁ་ཚོམས་མ་ལྷོ་ཕྱོགས་བྲམ་ཟེའི་ཡུལ་ལས་བརྒལ་བར་གཏུགས་ཏེ་ཛམ་གླིངསུམ་གཉིས་ལས་ཆེས་ལྷག་པར་མངའ་མཛད་ཏོ།",
    "ལྷ་ཐོ་ཐོ་རི་ནས་རྒྱལ་པོ་འདིའི་བར་ལ་སྐྱིད་པའི་གདུང་རབས་ཕྱེད་དང་བཅུ་གསུམ་ཞེས་མུ་ནེ་བཙན་པོ་ཡུན་ཐུང་བས་ཕྱེད་ཏུ་བྱས།",
    "ཐུགས་སུ་བྱོན་པའི་ནང་འཁོར་པར་བྱས་པས།",
    "བྱམས་པས་བསྐྱངས་པའི་དྲིན་ལན་ལོག་པརགཞལ།",
    "འཇིག་རྟེན་སྐྱོང་རྣམས་གཏམ་དུ་གྲག་པར་ཟད།",
    "འབངས་རྣམས་ཀུན་གྱིས་རྗེ་ལ་ཁེང་ལོག་བྱས།",
    "རྩ་འགྱུཙང་བས་འབངས་རྣམས་ཀྱིས་གླང་དར་མར་བཏགས།",
    "གཙང་བ་བཅས་བསྒྱུར་ཟིན་པ་སྐད་དུ་ཐབས་བྱས་ནས་སོ་སོའི་ཁྲི་འོག་དུ་སྦསཔསག་ཐར་བགོས་ནས་མཆོད་རྟེན་འོད་འབར་ཡིན་ཡང་ཟེར།",
    "པཎྜི་ཏ་བྲོས་མ་ཐར་བ་ལ་ལ་མེན་དུ་བཙངས།",
    "ས་ངུ་འབོད་དང་མྱ་ངན་བྱས།",
    "ལྷ་ལུང་དཔལ་རྡོར་གྱིས་ཀྱང་ཡེར་པར་ཚོགསེ་སྒབ་ཁང་དུ་ཕུག་རོན་གྱི་རྐང་པ་ནས་བཟུང་སྟེ་འཕུར་སྟངས་བྱེད་བཅུག་པ་རྡུལ་ཕབ།",
    "ཡེར་པའི་དཀར་ཆག་ཕྱི་མ་ལས་ནི་དེའི་ཚེ་བསམ་ཡས་དང་ལྷ་ས་ཀུན་དུ་ཝ་ཚང་བཅས།",
    "ཏར་ཀའམེ་ཏོག་སྲོད་ལ་འཆར་བ་བལྟ་བར་བསྙད་ནས་འོན་འབར་ཁེང་ལོག་དུགྲགས་པ་བྱས།",
    "དེ་ཐམས་ཅད་ཀྱང་གནོད་སྦྱིན་བྲན་ཀ་དཔལ་ཡོན་གྱིས་བྱས་སྐད་སྟེ་ཁེང་ལོག་བྱེད་པའི་ཕུམཁན་མས་པོ་ན།",
    "འབྲོ་དང་ཅོག་རོ་གཉིས་ཀྱིས་མ་ཕྱུརབྱས།",
    "གཙང་སྟོད་ཡུལ་དུ་རྗེ་དཔོན་ཚན་གཅིག་ཆགས།",
    "ཁ་རག་ཁྱུང་བཙུན་ལྷ་ཡིས་ཞུ་བ་བྱས།",
    "མཆིམས་གཉགས་གཉིས་ཀྱིསམ་ཕྱར་བྱས་ནས་སུ།",
    "ཁེ་ལག་ནས་དགུ་པ་མེ་བྱ་ལ་ཤུད་པུ་སྟག་རྩེ་སོགས་བཞིས་གྲོས་བྱས་ནས་བར་སོ་རྣམས་བགོ་བཤའ་ས་ཕལ་ཆེར་ཐུས་ཏེ།",
    "གཟུགས་དང་བློ་གྲོས་གཞན་ལས་ཁྱད་པར་འཕགས་ཡེར་དམ་པ་རྣམས་ཀྱིས་བསྔགས་པའི་གནས།",
    "རིགས་ན་སྤྱོད་པས་སྟོན་པར་བྱེད།",
    "འབྲིང་པོ་འོད་ལྡེ་ལ་སྲས་བཞི་ལས་ཕ་བ་དེ་སོའི་རྒྱུད་གཙང་རོང་སྟབས་ཡུལ་དང་ཉང་སྟོད་སོགསན་ཡོད།",
    "ཟླ་བའི་རྒྱུད་རྟ་ཤགས་པ་དང་བྲ་སྣ་བའོ།",
    "ས་སྐྱ་པཎྜི་ཏའི་སྦྱིན་བདག་བྱས།",
    "སྐུ་གསུང་ཐུགས་རྟེན་འགའ་བཞེས།",
    "ཇོ་བོ་རྗེ་བོད་ཙུ་ཕེབས་དུས་ཀྱང་བོད་ཀྱི་རཱཛཱ་བོ་དྷི་ས་ཏྭའི་བརྒྱུད་པ་གསུང་ནས་བཙན་ཐམས་ཅད་ལ་ལྡང་བ་དང་བཀུར་སྟི་ཆེར་མཛད་པས་འབངས་རྣམས།",
    "བློ་གྲོས་ཡངས་པས་ཇིལྟ་ཇི་སྙེད་མཁྱེན།",
    "འཁོར་ལོས་བསྒྱུར་བའི་དཔལ་ལས་ཆེས་ལྷག་པར།",
    "དེ་ཚེ་བསྟན་པ་མེད་པར་གོ་བ་ཡས།",
    "ཞེས་བསྟོད་པ་བྱས།",
    "རྣམ་པར་གྲོལ་བའི་རྒྱལ་མཚན་གོས་གྱོན་པ།",
    "བཙོན་རར་འཇུག་པར་བྱེད་པ་དང་།",
