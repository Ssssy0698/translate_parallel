    "ཁྱེད་ཀྱིས་རྒྱལ་པོའི་ཁང་པ་མ་རུངས་པར་བྱས་སོ།",
    "རང་ཇི་ཙམ་གྱིས་འཚོ་བར་འགྱུར་བའི་ཚོད་མ་དང་བཟའ་བ་མཉམ་པ་མ་ཡིན་པ་དེ་ལས་ལྷག་པར་ལེན་ཏམ།",
    "ཟན་ཐ་ན་ཁམ་གཅིག་ཙམ་ཡིན་དུ་ཟིན་ཀྱང་དད་པས་སྦྱིན་པར་བྱ་བ་ཆུད་གཟོན་པར་བརྗོད་པར་བྱའོ།",
    "ཕྱིར་ལ་ཟློག་པར་མི་ནུས་པས་སམ།",
    "ལྷུང་བཟེད་ལ་མི་བལྟ་བ་ཞེས་པ་ནི་ཡིད་ཀྱིས་སྣོད་ཤེས་པར་མི་བྱ་བར་ལེན་པའོ།",
    "ཇི་སྲིད་དུ་བཅའ་བ་དང་བཟའ་བ་མངོན་སུམ་དུ་མ་འོངས་པ་ནས་ལྷུང་བཟེད་བཟེད་པར་བྱེད་པའོ།",
    "རུང་ཡང་སྲིད་མི་རུང་ཡང་སྲིད་བྱས་སོ།",
    "ལྷག་པོ་ཐོབ་པར་བྱའོ་སྙམ་པའི་བསམ་པས་འབྲས་ཆན་གྱིས་ཚོད་མ་དགབ་པའམ་ཚོད་མས་འབྲས་ཆན་དགབ་པར་བྱེད་པའོ་བསམ་པ་མེད་ན་ཉེས་པ་མེད་དོ།",
    "གཙང་སྦྲ་ཐ་དད་ལགས་ཀྱིས་མ་མཛད་སོགས་སོ།",
    "འགལ་ཟོས་ཁམ་ཆུང་ཆེ་དང་རན་པར་མིན།",
    "འགལ་བ་དང་རྣམ་པར་འགྱུར་བས་ལེགས་པར་ཟས་མི་བཟའ་བའོ།",
    "ཁར་ཁམ་ཚད་དུ་གཞུག་ཅིང་མིད་པར་བྱ་བ་སྟེ།",
    "དེ་ཧ་ཅང་ཆུང་ངུར་བྱས་པའོ།",
    "རང་ངམ་འཇིག་རྟེན་དང་མཐུན་པའི་ཁམ་རན་པར་མི་བྱེད་པའོ།",
    "ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲའི་བྱེ་བྲག་ཙུག་ཙུག་ཟེར་ཞིང་ཟ་བར་བྱེད་པའོ།",
    "ལག་པ་ལ་ཟས་ཆགས་པ་སྤྲུག་པར་བྱེད་པའོ།",
    "འདི་མི་དགའ་བར་བྱའོ་ཟེར་ནས་ལྷུང་བཟེད་བསྐྱམས་པས་དེའི་སྣམ་སྦྱར་ཆུས་མ་རུངས་པར་གྱུར་ནས་སྨོད་པ་སོགས་སོ།",
    "ལྕི་ཡང་ཅི་ཡོད་ཚད་པར་བྱེད་པའོ།",
    "འཁུར་བ་བྲིམས་པ་དེའི་སྟེང་དུ་གདུགས་བྱས་ནས་དགའ་བོ་ཉེ་དགའ་དག་མཆོད་རྟེན་འདི་ངན་འགྲོ་རྫོགས་པར་བྱེད་པ་རྫོགས་བྱེད་ཀྱི་ཡིན་ནོ།",
    "ལག་པ་ཟས་དང་འབགས་པས་བྱ་མ་བུམ་ལ་སོགས་པའི་ཆུ་སྣོད་འཛིན་པར་བྱེད་པའོ།",
    "ནང་མི་རྣམས་ཁང་བཟང་མ་རུངས་པར་བྱས་སོ།",
    "ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཟས་དང་འབགས་པའི་ཆུ་དེ་ཁྱིམ་དུ་དབོ་བར་བྱེད་པའོ།",
    "འདི་ལྟ་བུའི་མི་གཙང་བས་བཀྲུ་བར་མི་རུང་ངོ།",
    "ལྷུང་བཟེད་ལན་གསུམ་དག་པར་བཀྲུས་ཏེ།",
    "དགེ་སློང་རྣམས་ཀྱིས་འོག་གཞི་མེད་པར་ལྷུང་བཟེད་བཞག་པས།",
    "བྱིན་གྱིས་གཞོལ་བའི་གཡང་ས་ཡིན་པར་ལྷུང་བཟེད་བཞག་པའོ།",
    "སྟོན་པ་སེར་སྐྱའི་ནྱ་གྲོ་དྷའི་ཀུན་ར་ན་བཞུགས་པའི་ཚེ།",
    "མི་གཙང་བའི་དྲིས་ཝ་འདུས་ནས་ལྡུམ་ཐམས་ཅད་མ་རུངས་པར་བྱས་སོ།",
    "ཤིང་ལ་མི་གང་མཐོར་འཛེག་གནང་ལ་མིན།",
    "བདག་ལ་མཉན་ཡོད་ནས་རྒྱལ་བྱེད་ཀྱི་བར་ལ་ཐག་ཉེ་རིང་ཅི་ཡོད་སྙམ་པར་འདྲི་ན་བརྗོད་དགོས་པས་གོམ་པས་གཞལ་ལོ་སྙམ་ནས།",
    "འཕགས་པ་སྟག་མཆིས་ཀྱིས་མྱུར་དུ་མཐོར་འཛེགས་ཤིག་དེས་མི་གང་ལས་མཐོར་འཛེག་པར་མ་གནང་བས་དེར་བསྡད་པས་སྟག་མཆོངས་ནས་བསད་དོ།",
    "གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་གོ་ཞེས་ཕྱི་མ་གནང་བ་སྟེ།",
    "གནང་བ་རྣམས་ཉེས་མེད་དོ།",
    "སྐྱེས་པ་ཆགས་པ་དང་ལྷན་ཅིག་ཅེས་གསུངས་ཀྱང་།",
    "དེ་ལས་ན་སྨད་པ་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "རང་ལ་མེད་ན་ཐམས་ཅད་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "འདི་ཚང་ན་ལུས་བཀན་པའི་ཕམ་པར་འགྱུར་རོ།",
    "ཆགས་པར་གྱུར་པས་ཆགས་པར་གྱུར་པ་དང་ལྷན་ཅིག་གཞོགས་སྟེགས་དང་།",
    "མ་སྨྲས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "གཞི་དགེ་སློང་མ་གཞན་ལ་དགེ་སློང་མའི་ཕམ་པར་འགྱུར་བ་བརྒྱད་པོ་གང་ཡང་རུང་བ།",
    "གཞི་དགེ་སློང་གནས་ནས་ཕྱུང་བ་བཟོད་པར་གསོལ་བར་ངེས་པ་དགེ་སློང་མས་ཕྱག་བྱ་བའི་འོས་མ་ཡིན་པའི་སྡོམ་པ་བྱིན་པར་གྱུར་པ་ལ།",
    "བསམ་པ་དེ་དག་ཐམས་ཅད་དེར་ཤེས་པར་གྱུར་པ།",
    "མཐར་ཐུག་བཞམས་བསྒོ་གསོལ་བ་དང་བཞིའི་ལས་གསུམ་པ་ལ་བསྒོ་བས་མི་གཏོང་ན་བཟློག་པའི་ཕམ་པར་འགྱུར་རོ།",
    "སྦྱོར་བའི་གནས་སུ་ཉེས་བྱས་སོ།",
    "ཉེ་བར་སྤྱོད་པའི་གནང་བ་ཐོབ་ན་ཉེས་མེད་དོ།",
    "དེ་དག་ལས་ཚངས་པར་སྤྱོད་པ་ཉིད་སྤྱད་དོ་ཞེས་པའི་ཚིག་དེ་ལ་ཞུགས་པ་བཞམས་བསྒོ་གསོལ་བརྗོད་ཀྱི་ལན་གསུམ་པ་ལ་མི་གཏོང་ན་སྤོང་བའི་ལྷག་མའོ།",
    "རྩོད་པ་འགྱེད་པར་བྱེད་པ་ལ་དགེ་སློང་མ་རྣམས་ཀྱིས་ཆོ་ག་བཞིན་དུ་ཕྱིར་བཟློག་པ་ན།",
    "༧ སློང་པར་རིགས་པ་དང་།",
    "༢ ལྷུང་བཟེད་ལྷག་མ་ཞག་གཅིག་ལས་འདས་པར་འཆང་བ་ནི་ལྷུང་བཟེད་འཆང་བའི་སྤང་ལྟུང་དང་།",
    "དེའི་ཕྱིར་ངེས་པར་འཇོག་པར་བྱེད་ན་གོས་ཟས་ལ་བསྒྱུར་བའི་སྤང་ལྟུང་།",
    "རྫས་ལེགས་པར་གནས་པའི་ཆེད་ཡིན་ན་ཉེས་པ་མེད་དོ།",
    "ཕྱིར་མ་བསླངས་པར་སྤྱོད་པ་དང་།",
    "༢ གནང་བ་མ་ཐོབ་པར་རབ་ཏུ་འབྱིན་པ་དང་།",
    "རྫོགས་པར་བསྙེན་པ་དང་།",
    "དེ་བཞིན་འཁོར་མང་པོ་ཉེ་བར་འཇོག་ནུས་པས་ཡང་ཤེས་པར་བྱའོ།",
    "ཁུ་ཆུ་བླུག་པ་སོགས་ཉེས་བྱས་སོ།",
    "ཀུན་དོང་དང་ཀེའུ་ཟ་བ་ཉེས་བྱས།",
    "གོས་མ་རུངས་པར་གྱུར་པའོ།",
    "༨༤ ལེགས་པར་མ་མཐོང་།",
    "རབ་བྱུང་གཞན་ལ་བརྙས་པ་སོགས་ཉེས་བྱས་སོ།",
    "གཞན་ལ་གནོད་པར་སྤྱོད་པ་ལས་གྱུར་པའི་གསུམ།",
