    "འདིར་དྲལ་གྱི་སྙན་དུ་གདའ་སྟེ།",
    "ཆབ་ལ་རོལ་དུ་མཚོ་མ་ཕམ་དུ་གཤེགས་འདུག་ནས།",
    "དེ་དག་ནི་གསེར་གྱི་འབྲོང་རི་སྨུག་པོ་ཞེས་བྱ་བ་དཔལ་ལེགས་ལྡན་ཚོགས་ཀྱི་བདག་པོའི་བླ་རི་ཡིན་པར་གྲགས་པའི་རི་བོ་ཆུང་ལ་མཛེས་བརྗིད་ཆེ་བ་ཞིག་ཡོད་འདུག་པ་དེའི་ཉེ་སྐོར་གྱི་སྤང་ཐང་དང་།",
    "ཅེས་ཟེར་སྲོལ་འདུག་ཅིང་།",
    "དེའི་སྲས་སྐལ་བཟང་མགོན་ཡིན་འདུག་ཅིང་།",
    "ཚོད་མེད་པའི་སྒེར་པ་ཆེན་པོའང་མཐོང་དུ་མི་འདུག་ཕྱུག་དབུལ་འབྲིང་ཙམ་གྱི་མི་ཚང་ཞིག་ལ་ཆ་མཚོན་པ་ཡིན་ན།",
    "ཀོ་དམར་ཁྲག་བརྫིས་ཞེས་བྱ་བའི་མནའ་འཇོག་སྲོལ་ཡོད་འདུག་ཅིང་།",
    "ཞེས་སོགས་ཨང་གྲངས་མང་པོར་ལབ་སྲོལ་ཡོད་འདུག་ཀྱང་ཁོ་བོས་གསལ་པོར་མ་ངེས་སོ།",
    "དེས་ནི་ལོ་ཟླ་ཞག་དུས་ཀྱི་ཀེག་དྲན་པ་དག་བཟློག་པ་དང་།",
    "ལེའུ་བདུན་མ་སོགས་ཁ་ཏོན་མང་དུ་བྱེད་ཤེས་ཀྱི་ཡོད་འདུག་པ་དང་།",
    "དེ་ལས་ཤ་རྫ་མ་ནྀ་ཞེས་བྱ་བའི་གདངས་སྙན་པོ་ཞིག་ཡོད་འདུག་པ་དེ་ནི་འབྲོག་ཡུལ་ཁག་ཚང་མའི་ནང་དུ་དར་སྲོལ་ཆེ་ཞིང་།",
    "གྲྭ་ཤག་སོགས་མཛེས་བརྗིད་དང་ལྡན་པ་ཡོད་འདུག་ཅིང་།",
    "ཚོང་འགྲུལ་གྱི་མ་དངུལ་མང་དུ་ཡོད་འདུག་ཅིང་།",
    "གྲྭ་སྤྱི་དང་བླ་སྤྱི་ཙམ་དུ་མ་ཟད་སྒྲུབ་མཆོད་ཆེ་ཁག་ཁ་ཤས་ལ་དམིགས་བསལ་གྱི་སྤྱིའང་མང་དུ་ཡོད་འདུག་ཅིང་།",
    "དབྱར་ས་དགུན་མཚེར་རྒྱ་ཆེན་པོ་ཡོད་འདུག་པ་དང་།",
    "ཞེས་སོགས་མང་དུ་འདུག་ནའང་དར་ཁ་ཆུགདཔེར་བཀོད་པ་ནི་མ་མཐོང་ངོ།",
    "རྟ་རྒྱལ་ཞེས་པ་ནི་མི་ཚོགས་ཀྱིས་བཞག་པའི་རྒྱན་པོའམ་རྒྱལ་ཁའི་མཐར་ཐུག་ཅིག་ཡིན་འདུག་ཀྱང་།",
    "དགུན་མཚེར་དུ་བབས་ལུགས་སོགས་ཡིན་འདུག་ཅིང་།",
    "འབྲོག་པ་རྣམས་ལ་དབྱར་དགུན་སྟོན་དཔྱིད་ཀྱི་དུས་སོ་སོར་མཚེར་ས་སོ་སོར་ཡོད་འདུག་ཅིང་།",
    "འབྲོག་པའི་སྦྲ་ཕལ་ཆེ་བ་ནི་ཧ་ཅང་ཆེ་ཞིང་སྤུས་དག་པོ་ཤ་སྟག་ཡོད་འདུག་ཅིང་།",
    "ཡང་ན་བཅུ་དྲུག་ཙམ་ཡོད་འདུག་པ་དང་།",
    "འབྲོག་མིའི་འཚོ་བའི་གཞི་བརྟེན་ནི་དེ་དག་ལ་གང་ཡོད་པའི་སྒོ་ཕྱུགས་ཀྱི་རིགས་རྣམས་ཡིན་འདུག་ཅིང་།",
    "ར་བཅས་མི་ཉུང་བ་ཡོད་འདུག་ནའང་།",
    "ཐུད་དང་གྲོ་མ་བཅས་ཡིན་འདུག་པ་དང་།",
    "ཤིང་ཏོག་སྐམ་པོའི་རིགས་རྣམས་ཀྱང་གང་འཚམས་བེད་སྤྱོད་བྱེད་སྲོལ་ཡོད་འདུག་ནའང་།",
    "འབྲོག་མི་རྒན་རིགས་རྣམས་ནས་ཇ་འཐུང་སྲོལ་འདུག་ནའང་།",
    "འབྲོག་མི་ཚོས་དབྱར་དུས་ཀྱི་ཆེད་དུ་ཤ་བམ་ཞེས་བྱ་བ་ཞིག་ཀྱང་བཟོ་སྲོལ་ཡོད་འདུག་ཅིང་།",
    "ཡང་འབྲོག་མི་ཁ་ཤས་ཀྱིས་སྟོན་དུས་སུ་ཞོ་རྒན་ཞེས་བྱ་བ་ཞོ་བཟང་པོར་འོ་མའི་ཁ་སྤྲིས་མང་ཙམ་བླུགས་པ་ཟོ་བ་ཆེན་པོ་ཞིག་ཏུ་བསགས་ཤིང་འཕྱིང་བའི་གཡོགས་དང་བཅས་ཏེ་སྟོན་མཚེར་གྱི་ལྕི་འབམ་ནང་དུ་༣ཇོག་སྲོལ་ཡོད་འདུག་ཅིང་།",
    "ལུག་བལ་གྱིས་བཟོས་པའི་འཕྱིང་བ་རྣམས་ཡིན་འདུག་ཅིང་།",
    "འབྲོག་མི་ཚོས་དབྱར་སྟོན་དཔྱིད་གསུམ་གྱི་དུས་སྐབས་སོ་སོར་སྒོ་ཕྱུགས་ལ་ཚྭ་སྟེར་དགོས་ཀྱི་ཡོད་འདུག་ཅིང་།",
    "འབྲོག་པའི་སྒོ་ཕྱུགས་ཀྱི་ནང་དུ་ཚེ་ཐར་ཞེས་བྱ་བའི་འབྲི་གཡག་དང་ལུག་སོགས་རྣ་ཚར་ལྡན་པ་མང་དུ་ཡོད་འདུག་ཅིང་།",
    "འབྲོང་གཡག་དེའི་རྒྱབ་གྱི་སྤུ་རྩིད་ཀྱི་ནང་དུ་འབྲུའི་སྙེ་མ་ཁ་ཤས་འདུག་ཅེས་དང་།",
    "ནམ་རྒྱུན་འབྲོག་ཡུལ་དུ་མི་ཤི་བའི་རྗེས་སུ་ཞག་བཞི་བཅུ་ཞེ་དགུ་མ་ཟིན་བར་དགེ་རྩ་རྒྱ་ཆེན་པོ་སྒྲུབ་སྲོལ་ཡོད་འདུག་ནའང་།",
    "ལོན་ཀྱང་ཐོག་མའི་དུས་སུ་ཁོའི་རང་གཤིས་ནི་མ་འདྲིས་པའི་རི་དྭགས་ལྟར་མིའི་རིགས་ལ་འཇིགས་སྣང་ཅན་ཞིག་ཏུ་གྱུར་ཡོད་འདུག་ནའང་།",
    "འདི་ནི་ཡུལ་ལྷ་ཨ་བོ་ལྷ་ཆེན་གྱི་བཀའ་ཆད་དངོས་བདེན་ཡིན་འདུག་ཅིང་།",
    "རྔ་རྩིད་ཀྱིས་བསྡམས་པ་སོགས་རྟགས་མང་དུ་ཡོད་འདུག་ཉིན་ཕྱི་མར་ཁོ་བོས་འབྲོག་མི་གྲོགས་པོ་ཞིག་ལ་དེའི་གནས་ཚུལ་ཞིབ་ཏུ་དྲིས་པས།",
    "ནང་མི་སོ་སོས་རང་རང་གང་ལ་དགའ་བའི་ཤ་འདེམ་སྒྲུག་བྱས་པ་དེ་ལ་གྲི་རིས་སམ།",
    "རོང་ཡུལ་རྣམས་སུ་ལོ་སར་ལ་ལོ་ཆེན་དང་ལོ་ཆུང་གཉིས་སུ་ཡོད་པ་ལྟར་འབྲོག་ཡུལ་རྣམས་སུའང་རྒྱ་ལོ་ཞེས་པ་དང་ལོ་སར་ཞེས་བྱ་བ་གཉིས་སུ་ཡོད་འདུག་ཅིང་།",
    "དེ་ནས་དམིགས་བབསལོ་སར་གྱི་ཆེད་དུ་བཟོས་པའི་རྩལ་ཁུ་ཞེས་བྱ་བ་ཞིག་འཐུང་སྲོལ་ཡོད་འདུག་ཅིང་།",
    "འབྲོག་མི་ཚོས་ཉིན་མཚན་ཀུན་ཏུ་ཟོན་བྱེད་ཀྱི་ཡོད་འདུག་ཅིང་།",
    "གཅིག་སོགས་དགོས་ཀྱི་ཡོད་འདུག་ཅིང་།",
    "ཅེས་ཟེར་སྲོལ་ཡོད་འདུགསྤོས་གདན་ཞེས་པ་ནི་བག་མའི་སྐྲ་རྒྱན་གྱི་གཙོ་བོ་ཞིག་ཡིན་འདུག་ཅིང་།",
    "བག་མ་སྟེར་མཁན་ནས་བག་ཆས་དེ་དག་གྲ་སྒྲིག་ལེགས་པོར་བྱེད་དགོས་ཀྱི་ཡོད་འདུག་ཅིང་།",
    "བག་མའི་ལྷན་དུ་བག་སྣ་ཞེས་བྱ་བའི་གནོད་པ་ཞིག་ཡོང་བ་དེ་བཟློག་པའི་ཐབས་སུ་བག་མ་ཁྱིམ་དང་ཉེ་བར་སླེབས་པའི་ལམ་ཁར་སའི་ཕག་གཟུགས་ཤིག་བཞག་པ་དེ་གཏོར་བརླག་བྱེད་སྲོལ་ཡོད་འདུག་པ་ལྟར་བག་སྣའི་གནོད་པ་ཁ་བསྒྱུར་བའི་ཐབས་ཤིག་ཡིན་པར་སེམས་སོ།",
