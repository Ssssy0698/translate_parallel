    "དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟར་བསླབ་པར་བྱའོ།",
    "དེ་ན་ཁ་ཅིག་ནི་རྒྱལ་པོ་ལ་མི་སྙན་པ་སྒྲོགས་པར་བྱེད་དེ།",
    "ཤེས་ལྡན་དག་རྒྱལ་པོས་མཉེས་ཏེ་ཅི་ཐམས་ཅད་ཀྱི་ལུང་བསྟན་པ་བདན་པར་འགྱུར་རམ།",
    "ཤེས་ལྡན་དག་རྒྱལ་པོ་དང་ལྷ་སྦྱིན་གྱིས་ཀྱང་མ་ཉེས་ཏེ།",
    "འོན་ཀྱང་ལྷ་སྦྱིན་ཁྲིད་དེ་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་བར་དུ་མི་བཞག་པར་འདི་ལྟར་རབ་ཏུ་འབྱིན་པར་མཛད་པས་ན་བཅོམ་ལྡན་འདས་ཁོ་ནས་ནོངས་སོ།",
    "དེ་ནས་གང་དག་རྒྱལ་པོ་ལ་མི་སྙན་པར་སྒྲོགས་པ་དེས་རྒྱལ་པོ་ངོ་ཚ་བར་མི་བྱེད་ཀྱི།",
    "ཇི་ལྟར་འདིས་འདས་པའི་དུས་ན་ཡང་ཉེས་པ་གཞན་གྱིས་བྱས་ལ་སྐྱོན་གཞན་ལ་བསྒོས་པ་དེ་ཉོན་ཅིག།",
    "དེ་རྣམས་ཀྱིས་བལྟ་བར་བརྩམས་པ་ན་ཐམས་ཅད་བཅད་ཅིང་རབ་ཏུ་གཏུབས་པར་མཐོང་ནས་དེ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་སྨྲས་པ།",
    "དེ་རྣམས་ཀྱིས་ཇི་ལྟར་གྱུར་པ་རྒྱས་པར་སྨྲས་པ་དང་དེས་སྨྲས་པ།",
    "ཁྱེད་ཅིའི་ཕྱིར་རྒྱལ་པོ་ལ་གསོལ་བར་མ་བྱས།",
    "ཉེ་འགྲམ་སྟོབས་དང་ཁ་དོག་ལྡན་པ་གང་ལགས་པ།",
    "ཡུལ་གྱི་ཁྱི་ལགས་སོ།",
    "དེ་རྣམས་ལ་ཇི་ལྟར་བརྟག་པར་བྱ།",
    "ཇི་ཙམ་ན་འགྲམ་དང་ཉེ་འགྲམ་གཉིས་ཀོ་བའི་དུམ་བུར་སྐྱུགས་ནས་རྒྱལ་པོ་ལ་རིག་པར་བྱས་པ་དང་།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་འགྲམ་དང་ཉེ་འགྲམ་གང་ཡིན་པ་དེ་གཉིས་ནི་ལྷ་སྦྱིན་དང་།",
    "དེ་ན་ཡང་འདི་གཉིས་ཀྱིས་ཉེས་པ་བྱས་ལ་སྐྱོན་གཞན་ལ་བསྒོའོ།",
    "ད་ལྟར་ཡང་འདི་གཉིས་ཀྱིས་ཉེས་པ་བྱས་ལ་སྐྱོན་གཞན་ལ་བསྒོའོ།",
    "གཞན་ཡང་ཇི་ལྟར་ལྷ་སྦྱིན་བྱས་པ་མི་གཟོ་བ་དང་བྱས་པ་མི་ཚོར་བ་དེ་ཉོན་ཅིག།",
    "དེ་དག་ཐམས་ཅད་གཅིག་ལ་གཅིག་བསད་པར་འདོད་པའི་གནོད་སེམས་དང་ལྡན་པར་གྱུར་པ་དང་སེང་གེས་སྨྲས་པ།",
    "གཉིད་ལོག་པར་བྱེད་དོ།",
    "ཡུལ་མི་རྣམས་ཀྱང་རིངས་པར་དོང་ངོ།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་བྱས་པ་ཆུད་གསོན་པའི་མི་གང་ཡིན་པ་དེ་ནི་ལྷ་སྦྱིན་འདི་ཉིད་ཡིན་ཏེ།",
    "དེ་ན་ཡང་འདི་བྱས་པ་མི་གཟོ་བ་དང་བྱས་པ་མི་ཚོར་བ་ཡིན་ནོ།",
    "ད་ལྟར་ཡང་འདི་བྱས་པ་མི་གཟོ་བ་དང་བྱས་པ་མི་ཚོར་བ་ཡིན་ནོ།",
    "གཞན་ཡང་ཇི་ལྟར་འདི་བྱས་པ་མི་གཟོ་བ་དང་བྱས་པ་མི་ཚོར་བ་དེ་ཉོན་ཅིག།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་དུས་མ་ཡིན་པར་ཞག་བདུན་དུ་སྤྲིན་ཆགས་ཏེ་ལྷས་ཆར་ཕབ་ནས་ནེའུ་ལེ་ཞིག་བྱི་བའི་ཚང་དུ་ཞུགས་སོ།",
    "ཇི་ཙམ་ན་ནེའུ་ལེ་དེས་བྱི་བ་དེ་གསད་པར་བརྩམས་པ་ན་སྦྲུལ་གྱིས་སྨྲས་པ།",
    "ཤེས་ལྡན་དག་བདག་ཅག་སྡུག་བསྔལ་མི་བཟད་པ་དོག་པ་ཐོབ་ཀྱིས་གཅིག་ལ་གཅིག་གནོད་པ་མ་བྱེད་པར་མ་འགུལ་བར་འཁོད་ཅིག།",
    "སྡུག་བསྔལ་མི་བཟད་པ་དོག་པ་ཐོབ་ན་ཡང་འདི་དེ་ལ་གསོད་པར་རྩོམ་ན།",
    "གལ་ཏེ་དེ་ཁ་ཟས་མེད་པར་འོངས་ན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་པས་ཡེ་དེ་ལ་སྤྲིང་བར་བྱའོ་སྙམ་ནས་དེས་དེ་ལ་སྤྲིང་བ།",
    "གང་གཱས་བྱིན་པ་ཕྱིར་མི་འོང་ཞེས་གསུངས།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་ནེའུ་ལེ་དགའ་བོ་གང་ཡིན་པ་དེ་ནི་ལྷ་སྦྱིན་འདི་ཉིད་ཡིན་ཏེ།",
    "དེ་ན་ཡང་འདི་བྱས་པ་མི་གཟོ་བ་དང་བྱས་པ་མི་ཚོར་བ་ཡིན་ནོ།",
    "ད་ལྟར་ཡང་འདི་བྱས་པ་མི་གཟོ་བ་དང་བྱས་པ་མི་ཚོར་བ་ཡིན་ནོ།",
    "དེས་ཙམ་པར་དཔྱད་བབ་པས་གཙེ་བར་བརྩམས་ཏེ་གཙེས་པ་ན་སྐྱེ་བོའི་ཚོགས་འབྲོས་པ་ལ་ཞུགས་ཏེ།",
    "གཙེས་པ་ན་འབྲོས་ལགས་ཀྱིས།",
    "ལྷ་གཞོན་ནུ་དེ་ལས་བཟློག་པར་མཛད་པའི་རིགས་སོ།",
    "གཞོན་ནུ་ཅིའི་ཕྱིར་ཡུལ་མི་ལ་གནོད་པར་བྱེད།",
    "ལྷ་དཔུང་རྒྱས་པར་མི་འགྱུར་ལགས་སོ།",
    "གཞོན་ནུ་གལ་ཏེ་དེ་ལྟ་ན་རྒྱལ་པོའི་ཁབ་འབའ་ཞིག་མ་གཏོགས་པར་ཡུལ་མ་ག་དྷཱ་ཁྱེར་ཅིག།",
    "དེས་ཡུལ་མ་ག་དྷཱ་བླངས་ནས་ལྷ་སྦྱིན་གྱི་དྲུང་དུ་དོང་སྟེ་སྨྲས་པ།",
    "ལྷ་གཞོན་ནུས་ཡུལ་མ་ག་དྷཱ་བརླག་པར་བགྱིས་ཀྱིས་ཟློག་མཛོད་ཅིག།",
    "གཞོན་ནུ་ཅིའི་ཕྱིར་ཡུལ་མ་ག་དྷཱ་བརླག་པར་བྱ།",
    "དེས་རྒྱལ་པོའི་ཁབ་ཀྱང་བརླག་པར་བྱ་བར་བརྩམས་པ་ན་རྒྱལ་པོའི་ཁབ་ན་གནས་པའི་སྐྱེ་བོའི་ཚོགས་དང་།",
    "ཙམ་པ་བ་ཐམས་ཅད་སྐྲག་པར་གྱུར་ནས།",
    "ལྷས་བདག་ཅག་བུ་བཞིན་དུ་སོ་སོར་བསྐྱངས་ན་གཞོན་ནུས་མ་འོས་པ་བཞིན་དུ་བཀྲེན་པར་བགྱིས་པས་ལྷའི་ཡུལ་མི་ཕལ་ཆེར་བྲོས་ལགས་ཏེ།",
    "བདག་ཅག་ཀྱང་འབྲོས་པར་འཚལ་ལགས་སོ།",
    "ལྷ་རྒྱལ་པོ་རྣམས་ནི་མཛོད་ཀྱི་མཐུ་ཅན་ལགས་ན།",
    "དེ་ཞེ་གནག་པའི་ལས་ཅན་ཡིན་པར་ཤེས་པས་སུ་ཡང་ཁ་ཟས་སྦྱོར་བ་ཡང་མི་བྱེད་ན་སྐྱེལ་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "དེ་རྣམས་ཀྱིས་རྒྱས་པར་སྨྲས་པ་དང་།",
    "རྣམ་པར་མི་མཁྱེན་པ་ཅི་ཡང་མི་མངའོ།",
    "འཇིག་རྟེན་ལ་ཕན་པར་ཞུགས་པ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞིའི་ཞབས་ཀྱི་མཐིལ་ལེགས་པར་གནས་པ།",
