    "རེབ་གོང་རུས་མཛོད་ཀྱི་བུ་ཡིག་ཏུ།",
    "ཁོ་ཚེའི་གཉན་རིའི་སྒང་གི་ལྷ་མོའི་སྐུ་བརྙན་དེ་ཡང་མེད་པར་བཏང་མོད།",
    "དེ་ནས་བཟུང་ཁོ་ཚེའི་རྒན་དར་གཞོན་གསུམ་དང་སྐྱེས་ཕོ་མོ་སུ་ཞིག་ཡིན་རུང་གནའ་ནས་ད་ལྟའི་བར་དུ་ཁོ་ཚེའི་ཨ་མ་ཚང་ཞེས་ཚེ་འདིའི་བགེགས་དང་བར་ཆད་མ་ལུས་སེལ་བར་མཛད་མ་དང་།",
    "ཕྱི་མར་ངན་སོང་གི་གཡང་ལས་བདེ་འགྲོའི་ལམ་དུ་འདྲེན་པའི་སྐྱབས་དང་མགོན་གྱི་བདག་ཉིད་དུ་འཛིན་པར་བྱེད།",
    "དགྲ་ཇག་ཆོམ་རྐུན་ཐལ་བའི་རྡུལ་དུ་རློགས།",
    "སོག་གཡས་སྟག་དོང་མདའ་མོ་གྲངས་མེད་ལས།",
    "སོག་གཡོན་མཆན་ཁུང་གཟིག་ཤུབས་ལྕགས་གཞུ་ཅན།",
    "དགྲ་དཔུང་ཚོམས་ལ་ཐལ་བ་རྡུལ་དུ་རློགས།",
    "ཕྱོགས་ཕྱོགས་དེ་ཡི་ཕ་གི་ན།",
    "ཟླ་རེའི་ཚེས་བཅུའི་ཉིན་ཚེས་བཅུ་ཞེས་རིག་འཛིན་གདུང་སྒྲུབ་ཀྱི་ཆོ་ག་ཆད་མེད་དུ་སྤེལ་བའི་སྲོལ་ཆགས་ཡོད་པ་དང་།",
    "ལོ་རེའི་ཟླ་དང་པོའི་ཚེས་ཉི་ཤུ་ནས་ཉེར་གསུམ་ཉིན་བར་གུ་རུ་དྲག་པོའི་སྒྲུབ་པ་འཛུགས་པའི་སྲོལ་ཡོད་ལ།",
    "ཟླ་གཉིས་པའི་ཚེས་བཅུ་གཅིག་ཉིན་ལྷ་མོའི་ཚེ་གཏོར་གྱི་ཚོགས་བསྐོར་བའི་ཉིན་མོ་ཡིན་ལ།་",
    "ལོ་རེའི་ཟླ་བཞི་བའི་ཚེས་བཅུ་བཞི་ནས་བཟུང་བཞི་བའི་སྨྱུང་གནས་འཛིན་པ་ཡིན་པས།",
    "ཚེས་བཅུ་དྲུག་ཉིན་གྱི་ཐོ་རེངས་དུས་ཐོ་ཐུག་ཅེས་པ་འོ་མ་དང་གྲོ་མ།",
    "གྲོ་ཕྱེ་སོགས་ཀྱིས་སླ་མོར་བསྐོལ་བའི་ཐུག་པ་དེ་བཏུང་རྗེས་སྨྱུང་གནས་གྲོལ་བར་བྱེད།",
    "ལོ་རེའི་ཟླ་ལྔ་བའི་ཚེས་གཅིག་ནས་བཞི་བར་ཛམ་དཀར་གཏེར་སྒྲུབ་ཀྱི་ཆོ་ག་སྤེལ་བ་ཡིན་ལ།",
    "ལྷ་མོ།",
    "ཚེས་ཉེར་དགུའི་ཉིན་གྱི་ཞོགས་པར་ཤར་ཕྱོགས་དཀར་མོ་དང་ཉིན་གུང་ཀླུ་བདུད་བཙན་གསུམ་གྱི་འཆམ་རྩེ་བ་ཡིན་ལ།",
    "གི་རྒྱལ་བོ་དེ་ཉིད་ལྷ་བའི་ལུས་ཁོག་ཏུ་ཞུགས་ཤིང་།",
    "རེབ་གོང་ཤར་སྐྱབས་མགོན་ཚང་།",
    "དེ་ནས་བཟུང་དད་ལྡན་མང་པོས་ལྷ་བ་ལྷ་བབས་ཚེ་འདོད་ཁམས་བདག་མོ་རེ་མ་ཏི་དངོས་སུ་བྱོན་པའི་འདུ་ཤེས་ཀྱིས་སྒོ་གསུམ་ཀུན་ནས་དཀྲིས་ཏེ་དད་གུས་བླ་ན་མེད་པ་བྱེད།",
    "སྤྱིར་ལྷ་རྩེད་ནི་ལྷ་མཉེས་པར་བྱེད་པའི་ཞི་བའི་མཆོད་གར་དང་དྲག་པོའི་མཆོད་གར་ཟུང་དུ་འབྲེལ་བའི་སྲོལ་རྒྱུན་གྱི་རྩེད་མོའི་རིགས་ཤིག་ཡིན་ལ།",
    "རྩེད་ར་ལ་སྐོར་བ་ཐེངས་ཤིག་བྱས་ཚེ་རྩེད་མོའི་རྣམ་གྲངས་རིགས་གཅིག་མཇུག་རྫོགས་པར་བྱེད།",
    "རྣམ་གྲངས་གང་ཞིག་རྩེ་ཡང་མགོ་རྩོམ་སྐབས་རྐང་བ་གཡོན་པ་དང་ལག་ཟུང་ཡར་བཀྱགས་ཤིང་འཁར་རྔའི་སྒྲ་དང་བསྟུན་ནས་རིམ་བཞིན་མར་འབེབས་པའི་ཉམས་ཐེངས་གསུམ་ལ་བྱས་རྗེས་དངོས་སུ་འགོ་བརྩམས་ཏེ་སྐོར་བ་གཅིག་གི་ཡུན་ལ་བརྩེ་བ་ཡིན།",
    "སྐོར་བ་གཅིག་ལོངས་པ་ན་རྣམ་གྲངས་གཅིག་པོ་མཇུག་རྫོགས་པའི་རྟགས་སུ་རྐང་བ་གཡོན་པ་དང་ལག་ཟུང་ཡར་བཏེགས་ནས་མཁར་རྔའི་སྒྲ་དང་བསྟུན་ཏེ་དལ་མོར་མར་ཕབས་རྗེས།",
    "མདུང་གིས་ལྟོ་བར་བསྣུན་པ་སོགས་འཇིགས་ཉམས་དོད་པའི་རྣམ་པ་ཤིན་ཏུ་མང་ངོ།",
    "ལོ་རེའི་ལུགས་རྙིང་གི་ཟླ་དྲུག་པའི་ཚེས་བཅུ་གསུམ་ཉིན་ནི་ཡུལ་སྐྱོང་ལབ་ཙེ་བསྟོད་པའི་ཉིན་མོ་ཡིན་ལ།",
    "རྡེའུ་དཀར་ནག་བཅུ་གསུམ་རེ་གཏོར་བ་སོགས་བྱས་ཏེ་ལབ་ཙེ་བསྟོད་པ་དང་།",
    "ཞབས་དཀར་སྐུ་ཕྲེང་གཉིས་པ་འཇིགས་མེད་ཐེག་མཆོག་བསྟན་པའི་རྒྱལ་མཚན་མཆོག་དང་ཞབས་དཀར་སྐུ་ཕྲེང་གསུམ་པ་ཡེ་ཤེས་བསྟན་པའི་རྒྱལ་མཚན་མཆོག་གིས་གསུངས་པའི་བསང་དཔེ་སོགས་ཀྱི་བསྟོད་ཆོག་འདོན་པ་དང་རབ་གནས་བྱེད་པ་ཡིན།",
    "ཤུལ་དུ་ཡོད་པའི་སྐྱེས་པ་དང་བུད་མེད་རྣམས་ཀྱིས་སྔར་ནས་གཏན་འཁེལ་བྱས་ཡོད་པའི་གནས་སུ་རས་གུར་ཕུབ་ཅིང་ཇ་ཐབ་བརྒྱབ་ཏེ་གསོལ་སྟོན་གྱི་གྲ་སྒྲིག་བྱེད།",
    "སྐྱེས་པ་དར་མ་ཚོས་ལབ་ཙེ་བསྟད་དེ་ཕྱིར་ལོག་པ་ན་ལུས་ལ་གཟབ་འཕྱོར་སྤྲས་པའི་སྐྱེས་ཕོ་མོ་རྒན་གཞོན་ཚང་མ་སྤྲོ་གསེང་དུ་འོང་བ་དང་།",
    "བཟའ་བ་ཤ་མར་གྱི་རི་རབ་བརྩིགས་ཤིང་བཏུང་བ་ཇ་ཆང་གི་མཚོ་མོ་བསྐྱིལ་ཏེ་ཉིན་ཞག་འཁོར་མོ་ཡུག་ལྔ་ཙམ་ལ་གསོལ་སྟོན་ལ་རོལ་བར་བྱེད།",
    "སྔ་དྲོ་དང་ཕྱི་དྲོའི་སྐབས་སུ་ཚོ་བ་གསུམ་ཀའི་སྐྱེས་ཕོ་མོ་རྒན་གཞོན་མཐའ་དག་གནས་གཅིག་ཏུ་འཛོམས་ཏེ་གླུ་དང་ཤགས་ཀྱི་རྩེད་འཇོར་རོལ།",
    "རབ་བྱུང་བཅུ་དྲུག་པའི་མེ་ཕོ་སྟག་སྤྱི་ལོ་༡༩༨༦ལོར་ལྷ་བའི་བཀའ་གསུང་ལྟར་གུ་རུ་ཚོ་བའི་གསེགས་ལམ་ལབ་ཙེ་དང་ལུང་རིང་ཉག་ཀའི་ལབ་ཙེ་གཉིས་གནས་སྤོས་ཏེ་ལུང་རིང་སྒང་གི་དབུ་རྩེར་གཞི་གཅིག་ཏུ་བསྟད་པ་དང་།",
    "ལོ་རེའི་ཟླ་ལྔ་བའི་ཚེས་བཞི་ཉིན་ཉི་ཤར་གྱི་རྩེ་མོ་ལ་ལུང་རིང་སྒང་གི་ལབ་ཙེ་བསྟད་རྗེས།",
    "ལོ་འཁོར་ཧྲིལ་བོ་གཅིག་རིམ་གྱིས་འདས་ནས་ལོ་འཁོར་གསར་བ་ཞིག་གི་མགོ་བཟུང་བ་ན་གཟབ་འཕྱོར་རྒྱས་སྤྲོས་དང་བཟའ་བཏུང་ལོངས་སྤྱོད་བྱེད་པའི་གོམས་སྲོལ་ཡུལ་ཁམས་ཀུན་ཏུ་སྣང་བ་ཡིན་ལ།",
    "པའི་ལུང་རྩིས་ལྟར་གཟའ་སྐར་འཕྲོད་སྦྱོར་ལེགས་པའི་ཉིན་མོར་ཁྱིམ་ཕྱི་ནང་ཡོངས་སུ་གད་བདར་ལེགས་པོ་བྱེད་པ་དེ་ལ་དུད་པ་ལེན་པ་ཟེར་ལ།",
    "དེའི་རྗེས་ཁྱིམ་ཚང་གི་འབྱུང་ཁམས་ལ་ལེགས་པར་བརྟག་སྟེ་ཁྱིམ་སྔགས་པ་གདན་དྲངས་ནས་ལོ་སྔོན་མར་མཆོད་ཁང་དུ་བཤམས་པའི་གཏོར་མ་གསར་དུ་བརྗེ་བ་ཡིན་ལ།",
    "ཆོ་ག་འདི་ལ་ཁྱིམ་ཚང་སོ་སོས་རང་རང་གི་བསྟེན་པའི་ཡི་དམ་གྱི་ལྷ་གང་ཡིན་ན་དེའི་གསོལ་མཆོད་འདོན་པ་ཡིན་པས་གཅིག་གྱུར་མ་ཡིན།",
    "སྐྱེས་པ་དར་མ་རྣམས་ཀྱིས་ཀི་བསོ་སྒྲོག་བཞིན་ལྷ་བ་ཚང་གི་སྒོ་ཁར་འདུས་ཏེ་ལྷ་ཕབ་པའི་ལས་འགོ་རྩོམ་ལ།",
    "རྒན་རྒོན་དང་བུད་མེད།",
    "གོང་གསལ་གྱི་ཆོ་ག་དག་ཡོངས་སུ་མཇུག་རྫོགས་རྗེས་ཕོ་གསར་རྣམས་ཀྱིས་ལྷ་བ་ཕྱིར་ཁྱིམ་དུ་བསྐྱལ་ཏེ་ལྷ་གྲོལ་པ་ན་ཕྱིར་རང་རང་གི་ཁྱིམ་དུ་ལོག་ཅིང་བཟའ་མི་ལྷན་འཛོམས་ཀྱིས་རང་ཁྱིམ་གྱི་ལོ་སར་གཏོང་བ་དང་།",
    "སྔོན་གྱི་ཚེ་ན་ལོ་སར་ཚེས་གསུམ་ཉིན་རྟ་རྒྱུགས་བྱེད་པའི་སྲོལ་ཡོད་མོད།",
    "དུས་ཆེན་གྱི་ཉིན་མོར་ཉི་རྩེ་མ་བརྒྱབ་གོང་ཆུ་འཐུང་བ་དང་ཆུ་ནང་དུ་འཛུལ་ཏེ་ལུས་ཕུང་གཙང་མར་བཀྲུ་ལ།",
    "ཚེ་རྡོ་རྗེ་རྣམ་རྒྱལ་གྱིས་རྟ་ཉོ་དེ་ཚོ་ལྐོག་ཞིབ་པ་ཡིན་པ་ཤེས་ནས་ཡུལ་ཞོ་འོང་གི་རྒན་དར་གཞོན་གསུམ་ལ་ལྐོག་བརྡ་བརྒྱབ་པ་དང་།",
    "རྒྱ་སོག་དམག་གི་གསང་ཇུས་གསལ་བོར་བླངས་རྗེས་ཉུལ་ཞིབ་པ་རྣམས་གཅིག་ཀྱང་མ་ལུས་པར་ཚར་བཅད།",
    "རྒྱལ་པོ་རླངས་ཚང་སོགས་རེབ་གོང་ཕྱོགས་སུ་བརྡ་བརྒྱབ་ནས་རེབ་གོང་གི་དམག་མི་ཆིག་སྟོང་ཕྱེད་ལྷག་གི་སྣ་དྲངས་ཏེ་རྒྱ་སོག་དམག་གི་དམག་སྒར་གཏོར་ཞིང་།",
    "རྒྱ་སོག་དམག་གི་དམག་རྟ་དང་མཚོན་ཆ།",
    "མཁོ་ཆས་སོགས་མི་ཉུང་བ་ཞིག་ཐེངས་འདིའི་དམག་འཁྲུག་ཁྲོད་ཁོ་ཚེ་རྡོ་རྗེ་རྣམ་རྒྱལ་གྱིས་དམག་དཔོན་མཛད་པའི་རེབ་གོང་གི་དམག་དཔུང་ལ་ཐོབ་པས།",
    "རེབ་གོང་བླ་དཔོན་རྣམས་ཀྱིས་ཁོ་ལ་རྟ་ཕོ་ཆེན་སུམ་ཅུའི་དཔའ་དར་ཕུལ་བ་ན་ཁོ་ཚེ་རྡོ་རྗེ་རྣམ་རྒྱལ་ཞེས་རྒྱ་བོད་སོག་གསུམ་གྱི་ཡུལ་གྲུ་ཀུན་ཏུ་སྙན་པའི་གྲགས་པ་འབྲུག་སྒྲ་ལྟར་རྒྱས།",
    "ཁོ་ཚེ་རྡོ་རྗེ་རྣམ་རྒྱལ་དང་འཇམ་བཟའ་གཡང་མོ་མཚོ་གཉིས་ལ།",
    "ཁོ་ཚེ་སྔགས་འཆང་མགོན་པོ་ཚེ་བརྟན་ནི་རབ་བྱུང་དྲུག་པའི་བགྲང་བྱ་ང་དགུ་བ་ཤིང་མོ་གླིང་སྤྱི་ལོ་༡༣ ༨ ༥ ལོར་ཁོ་ཚེ་བསྟན་པ་དར་རྒྱས་ཆུང་བ་མགོ་རོ་དང་དཔོན་རུའི་རྡོ་རྗེ་སྐྱིད་རྣམ་གཉིས་ཀྱི་སྲས་སུ་འཁྲུངས་ཤིང་།",
    "དགུང་ལོ་བཅུ་ཙམ་ནས་རྒྱལ་བུ་རླངས་ཚང་ཆུ་སྐྱེས་ཐང་དུ་ཕེབས་ནས་རིག་འཛིན་མ་མཁའ་སྤྱོད་རྒྱལ་མོའི་མདུན་ནས་ཡི་གེ་འབྲི་ཀློག་སྦྱངས།",
    "སྤྱང་གི་ར་རྩེ་ཕུག་པ་སོགས་སུ་ཕེབས་ནས་སྒྲུབ་པ་མཛད།",
    "ཁྱད་པར་སེར་བ་དང་བད་འགོག་གི་མན་ངག་མང་བོའི་གདམ་པ་གྱ་ནོམ་པ་གསན་པས་མཐུ་ནུས་བསམ་གྱིས་མི་ཁྱབ་པ་བྱུང་།",
    "ལུང་རིགས་རྒྱ་མཚོ་བཞི་ལ་སེཪ་འགོག་གི་གདམས་པ་བསླབས་ནས་ཁོང་དུ་ཆུད་པར་མཛད་པ་དང་།",
    "སོགས་སུ་སློབ་དཔོན་སུམ་ཅུ་ལྷག་གི་ཞབས་པད་སྤྱི་བོར་བླངས་ཏེ་མཁས་པའི་ཡང་རྩེར་སོན།",
    "དགུང་ལོ་ཉི་ཤུ་བར་དབུས་གཙང་དུ་བྱོན་ནས་འབྲས་སྤུངས་སྒོ་མང་དུ་ཚོགས་ཞུགས་གནང་སྟེ་གཞུང་བཀའ་པོད་ལྔ་ལ་ལོ་བཅུ་དྲུག་གི་རིང་སྦྱངས་པ་མཛད་པ་དང་རྡོ་རམས་པའི་མཚན་སྙན་སྤྱི་བོའི་རྒྱན་དུ་ངོམས།"
  ]
}