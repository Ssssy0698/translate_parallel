    "ཞག་བདུན་དུ་ཡང་འདུག་ནས་ནས་ནི།",
    "དེས་དེ་ལ་བྱིན་ན་འོན་ཀྱང་དེ་ཉེས་པའི་གླགས་ཚོལ་བ་ལྷུར་ལེན་ཅིང་འདུག་གོ།",
    "གནམ་ངོ་རུབ་འདུག་དུང་བརྡ་གཏོང་མི་རུང་།",
    "འབྲིང་པོ་ལ་བགེགས་སྐྲོད་མངའ་གསོལ་ཤིས་བརྗོད་མཛད་པ་ཅིག་འདུག་ཀྱང་།",
    "ཌཱ་ཀི་ནི་ཛ་ལ་སམྦྷ་རཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་སོགས།",
    "ཉི་མ་སྒྲ་གཅན་གཟའ་བྲལ་ལྷང་རྗོངེར་འདུག་པ་དང་།",
    "དེ་བས་ན་ཉི་མ་སྒྲ་གཅན་གཟའ་བྲལ་ལྷང་ངེར་འདུག་པ་དང་།",
    "རྒྱལ་པོ་བཏང་སྙོམས་འདུག་ཅིང་བློན་པོ་ཀུན་བྱེད་ལྟར།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན་ཏེ།",
    "རྒྱུ་དང་རང་བཞིན་དང་བྲལ་བས་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་སྟོང་པ་ཉིད་དང་།",
    "འགྲོ་དང་འཆག་པ་དང་ནི་ཉལ་དང་འདུག་པ་རྗོསྟོན།",
    "དེ་ནི་དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་ནི་རང་རྒྱལ་ལོ།",
    "དེ་ཡང་རང་དང་སྤྱིའི་མཚན་མ་མེད་པས་མཚན་མ་མེད་པའོ།",
    "༤པེ་སྣར་འདུག་པར་བྱེད།",
    "གྱི་པེ་སྣར་འདུག་༡༣༡ པེ་སྣར་འཁྲུག་པེ་སྣར་དུ།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པའི་མཚན་ཉིད་སྤྱིར་ཤེས་བྱའི་སྒྲིབ་པའི་གཉེན་པོར་གྱུར་པ་དག་ཡིན་ནོ།",
    "སྟོང་པ་ཉིད་དང་རྣམ་པ་ཉི་ཤུ་ཡིན་པའི་རྒྱུ་ནི་རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "ཡུལ་གྱི་དབྱེ་བས་ལོག་པར་རྟོག་ཁྲུཔ་རྣམས་ཀྱི་དབྱེ་བ་མཐའ་ཡས་པ་ཡིན་ན་ཡང་ཉེ་བ་ན་འདུག་པའི་གདུལ་བྱའི་སྐྱེ་བོ་ལས་ལྟོས་རྗོཏེ།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་དེར།",
    "མི་མཐུན་པའི་ཕྱོགས་དང་གཉེན་པོ་གང་རང་བཞིན་ནི་མཚུངས་པ་ཉིད་ཀྱིས་སྒྲིབ་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་ཡང་སྤང་བའི་ཕྱིར།",
    "དེ་ཡང་རང་དང་གཞན་ཀྱི་དོན་གྱི་དབྱེ་བས་རྣམ་པ་གཉིས་སོ།",
    "སྤྱོད་ཡུལ་མིན་ཡང་རང་གཞན་ལ།",
    "དེ་ལ་ཕྱོགས་དང་པོ་ལྟར་ན་ནི་དེ་བརྗོད་དུ་མེད་པ་ཡིན་ཡང་རང་རིག་པ་མ་ཡིན་ཏེ།",
    "ཁ་ཅིག་ནི་རྫས་སུ་ཡོད་ཀྱང་རང་རིག་པའི་ངོ་བོ་བྱུང་བ་ཙམ་ལས་བསྟན་དུ་མེད་པ་སྟེརྗོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "རང་ཡང་དངོས་པོར་ངེས་ཀྱང་རང་ངེས་པར་བྱེད་པའི་རྟགས་བཟུང་སླ་བ་ཡང་མེད་པའི་ཕྱིར་ཐ་སྙད་གདགས་པའི་གཞིར་མ་གྱུར་པས་ན་འདི་ཕྱིར་མི་ལྡོག་པའོ་ཞེས་གང་དུ་ཡང་མ་གསུངས་ཏེ།",
    "ལུང་ལས་ཀྱང་འགྲོ་བའི་ལས་ཀྱང་རང་བཞིན་དང་རྗོདབྱེ་བ་གསུངས་པའི་ཕྱིར་རོ་སྙམ་པའོ།",
    "དབུས་ན་འདུག་པའི་རྡུལ་ཕྲ་རབ་ལ་ལྟོས་ནས་ཕྱོགས་དང་ཡུལ་ཐ་དད་པ་ན་གནས་པའི་རྡུལ་ཕྲ་རབ་རྣམས་བསགས་པ་ཡིན་ན།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ལམ་མངོན་སུམ་དུ་བྱེད་པ་ན་ནི་དེ་ལྟ་མ་ཡིན་ནོ།",
    "སློབ་པ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་བའི་དྲོ་བར་གྱུར་པ་ལ་སོགས་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་དོ།",
    "འཛམ་བུའི་གླིང་སྨོས་པ་ནི་གླིང་འདི་ན་འདུག་པ་རྣམས་ལ་གྲགས་པའི་ཕྱིར་རོ།",
    "རྒྱལ་པོ་བཏང་སྙེམས་འདུག་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཞེས་བྱ་བ་ཁོང་ནས་དྲང་ངོ།",
    "བཏང་སྙོམས་སུ་འདུག་པ་ཉིད་རབ་ཏུ་བསྟན་པའི་ཕྱིར་རྒྱལ་པོ་གྲོང་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ཐམས་ཅད་ནི་སྣང་བ་དང་རྣམ་པར་རྟོག་པ་ལ་རག་ལས་པ་ཁོ་ན་ཡིན་ལ་དེ་གཉིས་ཀྱང་རང་རིག་པའི་མཚན་ཉིད་ཡིན་པས་འཛིན་པ་པོ་ལྐོག་ཏུ་གྱུར་པ་གཞན་བརྟག་པའི་ཚེགས་དབྱུང་བ་ནི་མི་དགོས་སོ།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡང་རང་ཡོད་པ་ཙམ་མ་གཏོགས་པ་བྱེད་པ་གཞན་ནི་མེད་པ་ཁོ་ན་ཡིན་ལ་དེ་ནི་འདི་དང་ཡང་ཁྱད་པར་མེད་དོ།",
    "དེར་ནི་རབ་ཏུ་དང་བ་ལ་སོགས་པའི་ཡན་ལག་དང་བཅས་པར་འདུག་པས་ན་བསམ་གཏན་ཡན་ལག་དང་བཅས་པ་རྣམས་སོ་ཞེས་བྱ་བར་བལྟའོ།",
    "པེ་སྣར་འགྱུར་བར། པེ་སྣར་དེའི་བློ་ལ་འདུག་པ།",
    "བྱེད་དང་བྱེད་མེད་འོག་མིན་འགྲོ།",
    "རང་རང་ངོ་བོས་སྟོང་པ་ཉིད།",
    "རང་རང་ངོ་བོས་སྟོང་པ་ཉིད་ཅེས་པ་ལ་གཞན་ནི་ལུས་ལས་ལོགས་ཤིག་པའི་བདག་ཉིད་རང་བཞིན་གྱིས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་ཉིད་ཅེས་མཚན་ཉིད་རྣམ་པ་བཞིའོ།",
    "བཅོས་པའི་ཟད་མི་མཐུན་པ་མཐོང་ཡང་རང་སོར་བཞག་ཡོད།",
    "ཡང་མ་དཔེ་ཟློས་འབྲི་བྱས་འདུག་པ་ལ་རྟགས།",
    "འདིའི་ནང་རང་སོར་བཞག་ཡང་ཡིག་འབྲུ་ལྷག་པ་འདུག་པའི་མས་སུ་རྟགས།",
    "རྣལ་འབྱོར་བ་ཁྱེད་ཀྱི་ངའི་མདུན་དུ་ཅི་འདུག་པོ་མཐོང་ངམ་གསུངས་པས།",
    "པཎྜི་ཏའི་ཞལ་ནས་ལྷ་ཁང་འདི་སྤྲུལ་པའི་སྐུ་དང་ཁྱད་མེད་པ་ཅིག་འདུག་གསུངས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་མདུན་དྲང་བོར་འདུག་པ་དང་།",
    "དེའི་ཚེ་འཕགས་པ་འཇམ་དཔལ་དང་ཀུན་དགའ་བཅོམ་ལྡན་འདས་ལ་གཉིས་འཁོར་དེའི་ནང་ན་འདུག་པས།",
    "གྲུབ་ཐོབ་དེ་རྒྱལ་པོའི་ཁྲི་ལ་སྲོད་ཀྱི་དུས་ན་བཞུགས་ཡོད་ཙ་ན།",
    "དེའི་ནང་བར་རྒྱལ་པོ་དེ་ཀླུ་བདུད་ཀྱིས་བསད་ནས་ཤི་ཡོད་སྙམ་ནས་རོ་སྤྱན་འདྲེན་དུ་ཕྱིན་པ་ན་རྒྱལ་པོ་མ་ཤི་བར་འདུག་གོ།",
    "དེར་ཕྱི་མཆོད་རྟེན་ལ་ནང་སྤྱིལ་བོར་འདུག་པ་ཅིག་སོ་ཕག་ལ་ཚིགས་ལ་དེའི་ནང་དུ་སྤོས་ཀྱི་གོང་བུ་དེ་ཆུག་ལ་ཞོག་དང་།",
    "སྐུ་ལ་འོད་ཟེར་འདོམ་གང་ཡོད་པ་ལ་འདི་ལ་མི་འདུག་སྐུ་ལ་འོད་ཟེར་མཐའ་ཡས་པ་ཡོད་པ་ལ་འདི་ལ་མི་འདུག།",
    "སང་ཡོད་ལོ་དུས་སུ་ནགས་མ་བྱ་ཚོགས་ཅན་དུ་ཕྱིན་ནས་ངའི་བུ་དེ་ཅི་བྱེད་ཀྱི་ཡོད་དམ་སྙམ་ནས་ལྟར་ཡོང་ཙ་ན།",
    "ཕྲུ་གུ་བཞི་བརྒྱ་སྐྱེལ་ནས་འདུག་གོ།",
    "སྤུ་དང་མཇུག་མ་མེད་པ་ཤིང་ལ་མི་ཐར་བ་ཤི་ལ་ཁད་པ་ཁ་དམར་ཏིང་ཏིང་འདུག་པས།",
    "ཁོང་རྣམས་ཀྱིས་སྙེ་མའི་གྲངས་བགྲངས་པས་འབྲུའི་གྲངས་ཁྲི་ཁྲི་འདུག་ནས་ཡར་ལུངས་ཁྲི་ཐང་ཞེས་ཀྱང་བྱའོ།",
    "དུས་དེ་ཙ་ན་བེམ་པོའི་རྒྱལ་པོ་ཆེན་པོ་བཞི་བྱུང་སྟེ།",
    "འོད་ནི་རང་རང་ལ་ཡོད་དེ་དེ་ནི་བསྐལ་པ་ཕྲན་བུ་ཞིག་གནས་སོ།",
    "འོད་ནི་རང་རང་ལ་བྱུང་སྟེ་མུན་པའི་བསྐལ་པ་སངས་སོ།",
    "ཁས་བླངས་པ་དེ་ཆད་མ་བཙན་ནས་དེའི་བར་དུ་ཚོང་བ་ཨ་རི་ལིས་ཀར་ཤ་བ་ནི་ལྔ་བརྒྱ་བྱིན་ནས་སྨད་ཚོང་མ་འགྲོ་བཟང་ངའི་ཕག་ཏུ་ཤོག་ཅིག་བྱས་པས་སྔོན་ལ་ཚོང་བ་ཨ་རི་ལིའི་ཕག་ཏུ་ཕྱིན་ཏེ་དགའ་མགུར་སྤྱོད་ཀྱིན་ཡོད་ཙ་ན།",
    "དེ་ནས་དེ་གཉིས་བསད་འདུག་གོ་ཟེར་ནས།",
    "དེ་དུས་ཙ་ན་རྒྱལ་བུ་རུ་བ་སྐྱེས་བྱ་བ་ཁོང་མིང་ནི།",
    "དུས་དེ་ཙ་ན་རྒྱ་གར་གྱི་རྒྱལ་པོ་དམག་བརྒྱ་བའི་སྲས་རྒྱལ་བུ་རུ་བ་སྐྱེས་ཞེས་བྱ་བ་སྲིད་པ་ཕྱུའི་ལྷ་དེས། གནམ་རིམ་པ་བཅུ་གསུམ་གྱི་སྟེང་དུ་བཞུགས་ནས་ལྷ་རབས་ཐེན་དགུ་དང་།",
    "ལྷ་བཙན་པོ་དེ་ངོ་མཚར་ཆེ་བ་འདུག་ཁྱེད་བོན་པོ་ཚོས་གཉའ་བའི་ཁྲི་ལ་བཞག་པས་ལྷ་གཉའ་ཁྲི་བཙན་པོ་ཟེར།",
    "བཞི་ནི་སོ་སོ་རང་རང་ནས་གླིང་བཞི་དང་གསུམ་དང་གཉིས་དང་གསེར་དངུལ་ཟངས་ལྕགས་འཁོར་ལོ་བསྒྱུར་བྱ་བ་ཡིན་པས་རྒྱལ་པོ་བཞི་ནི་རིམ་པ་བཞིན་ཡིན་ནོ།",
    "མ་སངས་ཀྱི་མདའ་ནི་ཕ་བོང་ལ་འདེམ་ཚུགས་ཙམ་འདུག་པའི་དུས་ན།",
    "ཕ་བོང་ལ་མདའ་ལྡེམ་མེ་དང་སྒྲོ་རིབ་བེ་འདུག་གོ།",
    "རྒྱལ་པོ་དང་མ་སངས་ཀྱི་བར་དུ་མདའ་སྒྲོ་རིབ་བེ་བ་དེ་རྒྱལ་པོའི་ཡིན་པ་ལ་མ་སངས་ཀྱི་མདའ་ཡིན་ཟེར་ཀྱིན་འདུག་ང་རྒྱལ་པོས་མ་སངས་ལ་ཆད་པ་ཆོད་དང་ཟེར་བའི་ཕྲ་མ་བྱུང་བས།",
    "དེའི་སྟེང་ན་ཟིལ་བ་ཕྲུམ་མེ་ལ་སྔར་བས་ལེགས་པ་ཅིག་བྱས་འདུག་ནས།",
    "དེ་ངོ་མཚར་ཆེ་བ་ཅིག་འདུག་ནས།",
    "ཡབ་ཀྱི་ཐུགས་དགོངས་ལ་ངའི་སྲས་འདི་ངོ་མཚར་བ་ཅིག་འདུག་པས།",
    "རིག་པའི་བསྟན་བཅོས་ཐམས་ཅད་ལ་མངའ་བརྙེས་པ་ཅིག་བཞུགས་འདུག་པས།",
    "བློན་པོ་ལ་ཆང་དྲོངས་གསུངས་ནས་ཐོན་མིས་ཆང་དྲངས་ནས་གསོལ་ཙ་ན།",
    "ངས་ཁོའི་བློན་པོ་ལ་ཇི་ལྟར་བྱས་པ་ཁོའི་སྒྲོམ་བུའི་ལན་ཐེབས་པ་ཞིག་འདུག་སྟེ།",
    "སྤྲུལ་པའི་སྐུ་ཐུབ་པར་དཀའ་བ་ཞིག་ཡོད་འདུག་སྙམ།",
    "བདེན་ན་ང་བས་ཁོ་བཟང་བར་འདུགངས་ཁོའི་བློན་པོ་ལ་ཅི་སྐད་དུ་བྱས་པའི་ལན།",
    "ཁོའི་སྒྲོམ་བུས་སེམས་ཐེབས་ཀྱིན་འདུག་སྙམ་ནས་བྱེད་ཆུམ་ཆུམ་བྱུང་ནས།",
    "མཐིང་ཤོག་ལ་གསེར་དངུལ་ཟངས་གསུམ་གྱིས་བལ་བོའི་སྐད་དུ་ཡི་གེར་བྲིས་ནས་འདུག་པ་དེ་ཀློག་པས།",
    "བལ་བོའི་སྐད་དང་ཡི་གེ་ཤེས་པ་དེ་སྤྲུལ་པའི་སྐུར་ཡོད་པར་འདུག་བོད་ཀྱི་རྒྱལ་པོ་ཁོང་རང་གསུང་བ་བཞིན་དུ་བདེན་པར་ཡོད་འདུག་པས།",
    "དེ་བདེན་ཙ་ན་ང་བས་ཁོ་བཟང་འདུག་པས་བོད་ཀྱི་རྒྱལ་པོ་དེ་ལ།",
    "ཚུར་ལ་ལོག་ཡོང་ཙ་ན་བྱ་ཁྭ་ཏའི་སྐད་ཀྱིས་མ་ནོན་པ་ལ་ལོག་ཤོག་གསུང་ངོ།",
    "རྒྱ་ནག་སྟོང་ཀུན་གྱི་སྐད་དང་ཡི་གེ་མཐིང་ཤོག་ལ་གསེར་གྱི་ཕྲིས་ནས་འདུག་པ་དེ་ཀློག་པས།",
    "ངས་ཁོའི་བློན་པོ་ལ་ཇི་ལྟར་བྱས་པ་ཁོའི་སྒྲོམ་བུས་ལན་ཐེབས་པ་ཅིག་འདུག་པས་སྤྲུལ་པའི་སྐུ་ལྷ་ཅིག་ཨོང་ཅོང་སྤྱན་དྲངས་པ།",
    "ཐུབ་པར་དཀའ་བ་ཞིག་འདུག་སྙམ།",
    "ཁྱེད་ཀྱི་རྒྱལ་པོ་དེས་ང་ལ་སྡིག་རི་རང་གཏོང་བ་ཞིག་འདུག་རུང་དེས་མི་ཡོང་།",
    "འདི་བདེན་ན་ང་བས་ཁོ་བཟང་བར་འདུག་ངས་ཁོའི་བློན་པོ་ལ་ཅི་སྐད་སྨྲས་པའི་ལན་ཁོའི་སྒྲོམ་བུས་ཐེབ་ཀྱིན་འདུག་སྙམ་བྱེད་ཆུམ་ཆུམ་བྱུང་ནས།",
    "བོད་ཀྱི་རྒྱལ་པོ་སྐད་དང་ཡི་གེའི་གཟུགས་སུ་བྲིས་འདུག་ནས།",
    "དེ་བས་ན་ཤཱཀྱ་ཐུབ་པ་གཙོ་ཆེར་བར་འདུག་པས།",
    "ཁོང་རང་ཇི་ལྟར་གསུངས་པ་བཞིན་དུ་བདེན་པར་ཡོད་འདུག་དེ་བདེན་ཙ་ན་ང་བས་ཁོ་བཟང་བར་འདུག་སྙམ་ནས་རྒྱལ་པོ་ཁོང་བྲེད་དེ་མྱོས་ནས་ཁྲི་ཁ་ནས་ལྷུང་བ་དང་།",
    "ལྷ་ཅིག་ཨོང་ཅོང་འདི་ལག་ལེན་མཐའ་གཞུག་བོད་ཡུལ་དུ་གཏོང་དཔོས་པས་འདུག་སྟེ།",
    "ཁྱེད་རྣམས་སྔོན་ལ་གཡུ་ལུང་ཚུད་ཅིང་ཐོགས་པར་འདུག་ལྟོས་བྱས་པས།",
    "ཁོང་རང་འདུག་སའི་སྒོའི་ཡ་ཐེམ་ལ་མཚལ་གྱི་རྡོ་རྗེ་ཅིག་བྲིས།",
    "དེ་ཚོའི་གསེབ་ནས་ཁྱེད་རང་རྣམས་སུས་ཤེས་པ་དེ་ལ་སྟེར་བ་ཡིན་གསུང་བྱུང་བ།",
