    "རང་ལ་རྫོགས་ཤིང་རང་ལ་ཚང་བར་སྟོན།",
    "གཟུགས་མེད་པའི་ཁམས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ཡིན་ཏེ།",
    "དེ་ཡང་རང་རིག་ཡེ་ཤེས་ནི།",
    "ཇི་ལྟར་གྲོལ་ཡང་རང་སར་རང་ལ་གྲོལ།",
    "དེ་ཡང་རང་བྱུང་རིག་པའི་ཡེ་ཤེས་ཀྱི་རང་ཞལ་མངོན་སུམ་དུ་མ་མཐོང་བའམ་མ་རིག་པ་ནི་ལས་ཀྱི་སྒྲིབ་པ་ཡིན་ཏེ།",
    "འོན་ཀྱང་དེ་ལ་བཟང་ངན་དང་རང་གཞན་སོགས་སུ་ཞེན་ནས་རྟོག་པར་བྱེད་ན།",
    "མ་བཅོས་རྣལ་འདུག་རིག་པ་ཁོང་ཀློད་བདེ།",
    "སྒྲ་ནི་དེའི་སྟེང་དུ་སྔགས་ཕྲེང་རང་སྒྲ་སྒྲོགས་པར་བསམ་པ་སྟེ།",
    "བྱང་སེམས་ཀུན་བཟང་རང་བཞིན་དུ།",
    "དེ་ལྟ་བུའི་ལོངས་སྐུའི་སྟོན་འཁོར་རྣམ་པ་གཉིས་ཀྱང་རང་བྱུང་ཀུན་ཏུ་བཟང་པོ་སྟོན་པ་ཀུན་བྱེད་ང་ཡི་ངོ་བོར་ཡེ་ནས་གནས་པ་ཉིད་མངོན་དུ་ཕྱུང་བ་ཡིན་ནོ།",
    "སེམས་ཉིད་ཀྱི་དོན་ལ་དུ་མར་སྤྲོས་ཤིང་བརྗོད་ཀྱང་རང་བཞིན་གཅིག་ལས་མ་གཡོས་པར་བསྟན་པ།",
    "རིག་གདངས་མ་འགགས་པའི་རྩལ་སྣང་རང་ཤར་བ་ཙམ་ལས་ཡོན་ཏན་དེ་དག་བསྡུ་བའི་གནས་སམ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་གནས་སུ་ངེས་པར་བཟུང་ཞིང་ཞེན་པ་དང་དེས་རློམ་སེམས་པ་ཡང་རྡུལ་ཙམ་མེད་པའོ།",
    "ཆོ་འཕྲུལ་བསྟན་ཡང་རང་རྒྱུད་བྲལ།",
    "དབྱིངས་ལ་སྣང་སྟོང་རང་བཞིན་གཉིས་མེད་པས།",
    "རང་ལ་རྫོགས་ཤིང་རང་ལ་ཚང་བར་སྟོན།",
    "བསྒྲུབ་བྱ་ཡིན་པའི་དོགས་པ་མི་སེལ་ཡང་རང་སྒྲ་དོན་མེད་དུ་མི་འགྱུར་ཏེ།",
    "འདི་ལུང་དང་རང་ཚིག་གཉིས་ཀ་དང་འགལ་བ་ཡིན་ཏེ།",
    "གཞུང་འདིའི་དོན་རྙེད་པ་སྔར་གངས་ཅན་འདིར་གཞན་མ་བྱུང་བའི་ཚུལ་དུ་འདུག་གོ།",
    "འབྲས་བུའི་རྟགས་དང་རང་བཞིན་གྱི་རྟགས་གཉིས་ཀ་ལ་ལྷན་ཅིག་ཏུ་རྩོལ་བྱུང་དཔེར་བརྗོད་དུ་བསྟན་པ་ན་རྩོལ་བྱུང་ལྟར་རང་བཞིན་གྱི་རྟགས་ཐམས་ཅད་ཀྱང་མཐུན་ཕྱོགས་ལ་རྣམ་གཉིས་སུ་འཇུག་གམ་སྙམ་པའི་དོགས་པ་སྐྱེ་བའི་རང་བཞིན་གྱི་རྟགས་ཐམས་ཅད་མཐུན་ཕྱོགས་ལ་རྣམ་གཉིས་སུ་འཇུག་པ་དེ་འདྲར་ཤེས་པར་མི་འགྱུར་བའི་ཆེད་ཡིན་པའི་ཕྱིར་རོ།",
    "བསླད་པ་འཁྲུལ་ཤེས་ཡིན་པའང་རང་ཉིད་ཀྱིས་ཤེས་པ་མ་ཡིན་ཏེ།",
    "སྣང་རུང་རང་བཞིན་མ་དམིགས་གྲུབ་པའོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གཉིས་རྒྱུ་དང་ཁྱབ་བྱེད་ཀྱིས་གོ་བྱེད་དུ་བསྟན་པས་རྒྱུ་དང་ངོ་བོ་ལྡོག་པ་ཉིད་ཀྱིས་འབྲས་བུ་དང་ཁྱབ་བྱའི་དོན་ལྡོག་པར་ནི་དོན་གྱིས་བརྗོད་པ་ལས་རྒྱུ་དང་ཁྱབ་བྱེད་མ་དམིགས་པའི་དཔེ་ནི་གྲུབ་པའི་ཕྱིར་རོ།",
    "མཁས་པ་ལ་ནི་བུམ་པ་མེད་ངེས་ཀྱི་ཐ་སྙད་ཀྱང་རང་སྟོབས་ཀྱིས་དྲན་ནུས་པས་རྟགས་ལ་མི་ལྟོས་ལ།",
    "རང་བཞིན་མ་དམིགས་པ་དགག་གཞི་དམིགས་པའི་ཤེས་པ་ཡིན་པའི་སྒོ་ནས་རང་མྱོང་རང་རིག་མངོན་སུམ་ལས་གྲུབ་པ་ལས་གཞན་དུ་མི་འགྲུབ་ན།",
    "རང་མཚན་ཐམས་ཅད་རང་རང་ལྡོག་པར་སྨྲ།",
    "བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ།",
    "འགྲོ་བ་པོ་མིན་འགྲོ་བ་མིན།",
    "སྐྱེ་བའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "མུན་པའང་རང་དང་གཞན་ཀྱི་དངོས།",
    "དེ་ཡང་རང་བཞིན་ལུང་མ་བསྟན།",
    "ལྷ་ཚོགས་དེ་རྣམས་ཀྱང་རང་ལ་སྐོར་བ།",
    "དེ་བཞིན་གཤེགས་པ་ཀུན་གྱི་ཨོ་བཛྲ་ཙི་ཏྲ་ས་མ་ཡ་ཡེ་ཧཱུཾ་ཞེས་ནང་དུ་འདུག་ལ་གནས།",
    "དང་པོ་འཇམ་བདག་ཉིད་ཁྲུས་བྱ་ལུས་དྲིས་བྱུགས་ཁ་ཤར་དུ་ཕྱོགས་པའི་སྟན་པ་ལ་འདུག་ལ།",
    "གཉིས་པ་མཐོང་བ་བསྟན་པ་ནི་དཀྱིལ་འཁོར་གྱི་ཁ་དོག་ཅིར་འདུག་དྲིས།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་ཁ་དོག་ཅིག་ཅིར་འདུག་དྲི།",
    "སེམས་ཀྱི་དྲན་རྟོག་ཐམས་ཅད་སྒྱུ་མ་དང་རང་སྣང་དུ་ཤེས་པར་བྱའོ།",
    "བཛྲ་བེ་རོ་ཙ་ན་ཡེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧཱུྃ་ཕཊ།",
    "ནཱ་རོ་པའི་ཐུགས་ལ་ང་ལ་གསུང་བར་འདུག་སྟེ།",
    "ཨོ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "བཛྲ་བེ་རོ་ཙ་ན་ཡེ་བ་ལིཾ་ཏ་ཁཱ་ཧི།",
    "ༀབཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཕཊ།",
    "སྟན་བདེ་བ་ལ་འདུག་པར་བྱའོ།",
    "འོག་མིན་དང་རང་བཞིན་གྱི་གནས་ནས་འཁོར་ལོ་བདེ་མཆོག་ལྷ་ལྔའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་དུར་ཁྲོད་བརྒྱད་དང་བཅས་པ་ནམ་མཁའ་ལ་སྤྱན་དྲངས་ལ།",
    "དེའི་མདུན་དུ་ང་འདུག་སྟེ།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ནི།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་བསམ་གཏན་ལྔས་ཨོ་རྒྱན་བལྟས་ཏེ་འདུག་ལ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནེ་ཡི་ཧ་རི་ནི་ས།",
    "བེ་རོ་ཙ་ནའི་སྔགས་གཡོན་བསྐོར་དུ་སྦྲུལ་འཁྱིལ་བ་ལྟར་བསམ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧ་རི་ནི་ས་འུབ་འུབ་འདུས་འདུས་སུམ་སུམ་སརྦ་ནན་ཆད།",
    "མར་རྙིང་དང་ཏིལ་མར་དང་ཆང་ལ་ༀ་ བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧ་རི་ནི་ས་མན་ཙ་མུན་ཙ་ཏྲི་ཙི་རཾ་རཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧ་རི་ནི་ས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧ་རི་ནི་ས་བདུད་དང་བར་ཆད་ལས་རྒྱལ་ལོ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་སི་ཧ་རི་ནི་ས།",
