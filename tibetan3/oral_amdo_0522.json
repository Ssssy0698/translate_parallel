    "སོ་སོ་སོ་སོར་རེ་རེས་ཕུལ་བ་རྣམས།",
    "རྩ་བའི་ཐིག་གི་ནང་དུ་ནི།",
    "རྩ་བའི་ཐིག་གི་ནང་དུ་ནི།",
    "འདི་ལ་ནི་འོ་ཐུག་གི་བཟའ་བ་དང་།",
    "ཕྱག་གིས་བགྲང་ཕྲེང་དང་མེ་ཏོག་ཀུ་མུ་དལ་གནས་པའི་སྤྱི་བླུགས་འཛིན་པའོ།",
    "ཨོཾ་ཙནྡྲ་ཨ་མྲྀ་ཏ་བི་ཀྲ་མཱ་ཡ་ཤཱི་ཏ་ཨཾ་ཤ་བེ་ཨཱ་སྭཱ་ཧཱ།",
    "ལྷོའི་འདབ་མར་པདྨ་དཀར་པོའི་སྟེང་དུ་ཙནྡན་གྱི་དྲིའི་མཎྜལ་ལ་བཀྲ་ཤིས་ནི་དགེ་སློང་གི་གཟུགས་འཛིན་པ།",
    "ན་མོ་རཀྟ་ཨདྒ་ར་ཛྭ་ལ་ཀུ་མཱ་རཱ་ཡ་སྭཱ་ཧཱ།",
    "གཡས་པ་དང་གཡོན་པ་དག་གིས་བགྲང་ཕྲེང་དང་སྤྱི་བླུགས་འཛིན་པའོ།",
    "རཱ་ཛ་སུ་ཏྲ་བུདྡྷ་སུ་པཱི་ཏ་ཝརྞ་ཡ་ནམ་ཨོཾ་བུདྡྷཱ་ཡ་སྭཱ་ཧཱ།",
    "བྱང་གི་འདབ་མར་ཆུ་སྐྱེས་དཀར་པོའི་ལྟེ་བར་དེ་བ་དཱ་རུའི་དྲིའི་མཎྜལ་ལ་ཕུར་བུ་དགེ་སློང་གི་རྣམ་པ་གསེར་བཙོ་མའི་འོད་ཅན།",
    "འདི་ལ་ནི་ཞོ་ཟན་ནམ་འོ་ཐུག་གི་བཟའ་བ་དང་སྦང་དང་མར་གྱི་བདུག་སྤོས་ཏེ།",
    "ལོ་ཏི་ཏ་ཝརྞ་ནིར་ག་མཱ་ཡ་བྲྀ་ཧ་ས་པཱ་ད་ཡེ་ཨོཾ་ན་མོ་བྷོ་ག་སྤ་དཱ་ཡ་སྭཱ་ཧཱ།",
    "འདི་ལ་ནི་འོ་ཐུག་གི་བཟའ་བ་དང་ག་བུར་གྱི་བདུག་སྤོས་ཀྱང་དབུལ་བར་བྱ་སྟེ།",
    "ཕྱག་གིས་ཉི་མ་དང་ཟླ་བ་ཟ་བའི་ཚུལ་གྱིས་གནས་པའོ།",
    "ཨོཾ་ན་མོ་པི་ཀྲྀ་ཏ་པ་ཀྭ་རུ་དྷི་ར་རཱ་ཧོ་བྷིདྒ་ཨཉྫ་སིནྣཱ་བྷཱ་ཡ་ཨ་མྲྀ་ཏ་པྲྀ་ཡཱ་ཡ་སྭཱ་ཧཱ།",
    "ཨོཾ་ན་མོ་དྷཱུ་མྲ་ཨཱ་བྷ་ཝ་རྞ་སནྣི་བྷཱ་ཡ་ཛྱོ་ཏི་ཀ་ཏ་བེ་སྭཱ་ཧཱ།",
    "མེར་ནི་རྒྱུ་སྐར་ཐམས་ཅད་དེ་རང་རང་གི་བཞོན་པ་ལ་ཡང་དག་པར་གནས་ཤིང་ཐམས་ཅད་ཐལ་མོ་ཡང་དག་པར་སྦྱར་བའོ།",
    "བྱང་དུ་ལུས་ངན་པོ་ནི་སེར་པོ་དང་ནག་པོ་དང་དམར་པོ་དང་སེར་པོ་སྟེ་རང་རང་གི་ཕྱག་མཚན་དང་ལྡན་བའོ།",
    "ཉེར་འཚེ་བྱེད་པ་ཐམས་ཅད་ལ་སྲན་ནག་གི་ཟན་དང་།",
    "ཨོཾ་ན་མོ་བུདྡྷཱ་ཡ་སྭཱ་ཧཱ།",
    "འདི་རྣམས་ཐམས་ཅད་ལ་རང་རང་གི་སྔགས་དེ་ཉིད་ཀྱིས་མཆོད་ཡོན་དབུལ་བར་བྱ་སྟེ།",
    "སྣམ་བུ་གཉིས་པ་ལ་ནུབ་ཀྱི་ཕྱོགས་སུ་དེ་བཞིན་གཤེགས་པ་རྡོ་རྗེ་འཛིན་པ་རྒྱ་མཚོའི་ངེས་པར་སྒྲོགས་པ་སེར་པོ་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གི་བརླ་ལ་ཕྱག་གཡོན་པ་བཞག་ཅིང་གཡས་པས་མཆོག་སྦྱིན་མཛད་པའོ།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "སྣམ་བུ་གསུམ་པ་ལ་མེར་སྦས་པའི་ལྷ་མོ་ལྗང་གུའོ།",
    "བདེན་བྲལ་དུ་ཤིན་ཏུ་སྦས་པའི་ལྷ་མོ་དམར་མོ་གདུགས་འཛིན་པའོ།",
    "ནུབ་ཏུ་ནོར་སྦྱིན་མ་དམར་མོ་བུམ་པ་བཟང་པོ་དང་བི་ཛ་པཱུ་ར་ཀའི་ཕྱག་རྒྱ་ཅན་ནོ།",
    "དེ་ལྟ་ན་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེའི་ཁྱིམ་སྐྱེས་བུ་ཆེན་པོའི་ཚད་ཙམ་དུ་ནོར་གྱི་རྒྱུན་གྱིས་གང་བར་འགྱུར་ཏེ་ནོར་ཐམས་ཅད་དང་།",
    "གང་ཡང་དེ་བཞིན་ཉིད་དུ་མཎྜལ་ཟླུམ་པོ་བྱས་ནས་སླར་ཡང་སྔ་མོར་དྲི་ཞིམ་པོའི་ཆུས་ཁྲུས་བྱས་པ་གཙང་ཞིང་དྲི་མ་མེད་པའི་གོས་གྱོན་ཏེ།",
    "སློབ་དཔོན་གྱིས་དེ་བཞིན་གྱི་བརྟུལ་ཞུགས་དང་ལྡན་པས་མཚན་མོ་གསུམ་དུ་བྱ་ཞིང་།",
    "དེ་ལ་མིག་བཙུམས་པ་ཙམ་ལ་ནོར་རྒྱུན་མས་སྐྱེས་བུ་ཆེན་པོ་དང་འཚམ་པའི་ནོར་གྱི་རྒྱུན་གྱིས་སྦྱིན་བདག་གི་ཁྱིམ་ཡོངས་སུ་འགེངས་པར་འགྱུར་ཏེ།",
    "རྒྱལ་མཚན་དང་བ་དན་ལ་སོགས་པ་གཞན་དག་ནི་ཆུ་ཀླུང་གི་ཆུ་ལ་དོར་བར་བྱའོ།",
    "རྣམ་པར་བཀྲ་བའི་བླ་རེ་བྲེས་རྟེནས་རྡུལ་ཚོན་དཀར་པོས་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་རྣམ་པར་བཀོད་པས་བརྒྱན་པར་བྱས་པ་དེའི་དབུས་སུ་ནི།",
    "དེའི་ཕྱི་རོལ་དུ་ཤིན་ཏུ་མཛེས་པའི་པདྨ་འདབ་མ་བཅུ་དྲུག་པ་བྱས་ནས་འདབ་མ་རེ་རེ་ཞིང་རིམ་པ་ཇི་ལྟ་བར་སོ་སོར་ཟླ་བ་བཅུ་དྲུག་ལ་དེ་བཞིན་གཤེགས་པ་བཅུ་དྲུག་དགོད་པར་བྱ་སྟེ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ལས་བྱུང་བའི་གཙུག་ཏོར་དང་།",
    "དེ་བཞིན་གཤེགས་པ་འདི་དག་གིས་གདན་གྱི་མཎྜལ་བྱས་ནས་དུས་ཇི་ལྟ་བར་མེ་ཏོག་གི་ཚོམ་བུ་དགོད་པར་བྱའོ།",
    "སླར་ཡང་ཤར་དུ་བགེགས་རབ་ཏུ་ཞི་བར་བྱེད་པའི་ལྷ་མོ་རྣམ་པར་རྒྱལ་མ་དང་།",
    "ལྷོར་འཆི་བ་རབ་ཏུ་ཞི་བར་བྱེད་པའི་ལྷ་མོ་རྣམ་པར་རྒྱལ་མ་དང་།",
    "ནུབ་ཏུ་ཉོན་མོངས་པ་རབ་ཏུ་ཞི་བར་བྱེད་པའི་ལྷ་མོ་རྣམ་པར་རྒྱལ་མ་དང་།",
    "བྱང་དུ་ཕུང་པོའི་ནང་ཞི་བར་བྱེད་པའི་ལྷ་མོ་རྣམ་པར་རྒྱལ་མ་དང་།",
    "བདེན་བྲལ་དུ་སྒྱུ་འཕྲུལ་ཆེན་མོ་དང་།",
    "རྡུལ་ཚོན་གྱི་བའི་རེ་ཁཱ་གསུམ་གྱི་ནང་མའི་ནང་མ་ལ་སཱ་ལུའི་ཟན་ནམ་འཇིམ་པ་ལས་མཆོད་རྟེན་སྟོང་བྱའོ།",
    "བླ་རེ་རྣམས་ཀྱི་ནང་གི་བར་སྣང་ལ་གནས་པའི་རྩིབས་ཀྱི་རྩེ་མོ་ལ་བརྟན་པར་བཞུགས་པའི་ཤིན་ཏུ་འཇིགས་སུ་རུང་བའི་ཁྲོ་བོ་བཅུར་བྱིན་གྱིས་བརླབས་པའི་རྩིབས་བཅུ་པའི་འཁོར་ལོ་སེར་པོ་གཡས་སུ་བསྐོར་བའི་ལྟེ་བའི་དབུས་སུ་གནས་པའི་གཞལ་ཡས་ཁང་གི་རྣམ་པར་དཀྱིལ་འཁོར་ཁང་པར་ཤིན་ཏུ་བརྟན་པར་སྐད་ཅིག་གིས་ལྷག་པར་མོས་པར་བྱ་སྟེ།",
    "རང་གི་སོར་གྱི་སོར་ཕྱེད་དང་བཅས་པའི་བཅུ་གཉིས་ནི་མཐོའོ།",
    "སྤྱན་མ་ལ་སོགས་པ་ལྷ་མོ་རྣམས་ཀྱི་ནི་སོར་བཅུ་གཉིས་ལ་མཐོའོ།",
    "བཅོམ་ལྡན་འདས་མི་བཞུགས་པ་ན་དད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་རྣམས་ཀྱིས་ཅི་ལྟར་བསྒྲུབ་པར་བགྱི།",
    "སྒེག་པ་ནི་གསུམ་དུ་འཁྱོག་པ་ཉིད་ལ་སོགས་པའི་ཡོན་ཏན་གྱིས་སོ།",
    "སྤྱན་གྱི་འོག་གི་པགས་པ་དག་ལས་འོག་གི་ཆ་ནི་འཁུར་བར་འགྱུར་རོ།",
    "ཁྲོ་བོ་རྣམས་ཀྱི་ནི་ལེབ་མོར་རྣམ་པར་རྒྱས་ཤིང་ལྷག་པའོ།",
    "མ་མཆུའི་རྒྱ་ལ་སོར་གཉིས་ཏེ་དཔངས་ལ་ནི་ཆ་ཆུང་གསུམ་མོ།",
    "དེའི་དབུས་ལ་སོར་གཅིག་གི་རྒྱའོ།",
    "འོག་གི་མཐར་ཐུག་པ་ལ་སོར་གསུམ་མོ།",
    "ཁྲོ་བོ་རྣམས་ཀྱི་ནི་འཁྱོག་པོའོ།",
    "ཐམས་ཅད་བུད་མེད་སྒེག་མོ་རྣམས་ཀྱི་ནི་རིང་བར་ནས་བཅོ་བརྒྱད་དང་ཞེང་ལ་ནས་དྲུག་སྟེ་ཉའི་ལྟོ་བའི་རྣམ་པའོ།",
    "སྤྱན་གྱི་ནོར་བུ་ལ་སོར་གསུམ་མོ།",
    "པདྨའི་འདབ་མའི་རྣམ་པ་སྤྱན་གྱི་སྦུབས་ནི་སོར་གསུམ་མོ།",
    "སྨིན་མ་དག་གི་བར་ལ་ནི་སོར་ཕྱེད་དང་གཉིས་སོ།",
    "སྨིན་མ་དག་ནི་རི་མོ་དང་མཉམ་པར་སྙན་དག་སྟེ།",
    "དེ་དག་གི་སྟེང་གི་འདབ་མའང་ནས་བཞི་སྟེ་དེའི་དཔངས་སུ་ནི་སོར་གཅིག་གོ།",
    "ད་ནི་མགྲིན་པ་ལ་སོགས་པ་ནས་ལོང་བུའི་འོག་གི་མཐར་ཐུག་པའི་ཆ་དབྱེ་བར་བྱ་སྟེ་མགྲིན་པ་ལ་ནི་སོར་བཞིའོ།",
    "མགྲིན་པ་ནས་ཐུགས་ཀ་ལ་སོར་ཕྱེད་དང་བཅུ་གསུམ་མོ།",
    "ལྟེ་བ་ནས་གསང་གནས་ཀྱི་མཐར་ཐུག་པ་ལ་ཡང་སོར་ཕྱེད་དང་བཅུ་གསུམ་མོ།",
    "པུས་མོ་ལ་སོར་དྲུག་གོ།",
    "སོར་བཅུ་པའོ་ཞེས་པ་ནི་འགའ་ཞིག་གིའོ།",
    "ཕྲ་བའི་གནས་དང་བྲལ་བའི་ཕྲག་པ་ནས་གྲུ་མོའི་བར་ལ་སོར་ཉི་ཤུ་ནི་དཔུང་པའོ།",
    "གྲུ་མོ་ལ་ནི་སོར་གཅིག་གོ།",
    "གྲུ་མོའི་འོག་ནས་ནོར་བུ་འཆིང་བའི་སྟེང་ནི་ཕྱག་ངར་ཏེ་སོར་བཅུ་དྲུག་གོ།",
    "ནོར་བུ་འཆིང་བའི་འོག་ནས་སོར་མོ་གུང་མོའི་རྩེ་མོའི་མཐར་ཐུག་པ་ལ་ནི་སོར་བཅུ་གཉིས་ཏེ་ཕྱག་ལག་གོ།",
    "ནོར་བུ་འཆིང་བ་ནས་ཕྱག་གི་མཐིལ་ལ་སོར་བདུན་ནོ།",
    "སོར་མོ་གུང་མོ་ལ་ཆ་ཆུང་ལྔའོ།",
    "དེའི་ཚིགས་ཕྱེད་ཀྱིས་ཐུང་བ་ནི་མཛུབ་མོ་སྟེ་མིང་མེད་ནི་དེ་དང་མཉམ་པའོ།",
    "ཚིགས་གཅིག་གིས་ཐུང་བ་ནི་མཐེའུ་ཆུང་སྟེ་སོར་མོ་ཐམས་ཅད་ནི་ཚིགས་གསུམ་པའོ།",
    "དེ་རྣམས་ཀྱི་ཚིགས་ཕྱེད་ཀྱིས་སེན་མོའོ།",
    "ནོར་བུ་འཆིང་བ་ལས་སོར་བཞི་སྤངས་ནས་སེན་མོའི་རྩེ་མོ་ཇི་སྲིད་པ་ལ་སོར་བཞི་ནི་མཐེ་བོང་སྟེ་ཚིག་གཉིས་པའོ།",
    "ནས་ཕྱེད་ནི་སོར་མོའི་རྩ་བའོ།",
    "མཐེ་བོང་གི་མཐའ་སྐོར་ལ་ནི་སོར་བཞིའོ།",
    "མཐེ་བོང་ནས་མཛུབ་མོ་ལ་ནི་སོར་བཞིའམ་གསུམ་མོ།",
    "ནོར་བུ་འཆིང་བ་ནས་མཐེ་ཆུང་གི་རྩ་བའི་མཐར་ཐུག་པ་ལ་ནི་སོར་ལྔའོ།",
    "ཕྲག་པ་ནས་མཆན་ཁུང་གི་མཐར་ཐུག་པ་ལ་སོར་དགུ་སྟེ་མཆན་ཁུང་ནས་ནུ་མ་ཇི་སྲིད་པ་ལ་སོར་བཅུ་དྲུག་གོ།",
    "བྲང་ནས་རྒྱབ་དག་གི་མཐའ་སྐོར་ལ་སོར་ལྔ་བཅུ་དྲུག་སྟེ།",
    "ནུ་མ་དག་གི་བར་ལ་སོར་ཕྱེད་དང་བཅུ་གསུམ་མོ།",
    "ཚང་ར་དག་གི་རྒྱ་དང་དཔངས་ལ་ནི་སོར་བཞི་བཞིའོ།",
    "བརླའི་རྩ་བ་དག་གི་དབུས་ལ་སོར་བཅུ་གཉིས་ཏེ་མཐའ་སྐོར་དུ་ནི་སུམ་འགྱུར་རོ།",
    "དེ་དག་གི་བར་གྱི་དཔངས་ལ་སོར་ལྔའོ།",
    "པུས་མོའི་མཐའ་སྐོར་ལ་སོར་ཉི་ཤུ་རྩ་བརྒྱད་དོ།",
    "བྱིན་པའི་འོག་གི་མཐའ་སྐོར་ལ་ནི་སོར་ཉི་ཤུ་རྩ་གཅིག་གོ།",
    "ཞེང་གི་རྒྱ་ཡོངས་སུ་བསྐོར་བ་ལ་ནི་སོར་བཅོ་བརྒྱད་དེ་ལོང་བུ་ལས་ཕ་རོལ་མཐེ་བོང་གི་སེན་མོའི་ཇི་སྲིད་པ་ལའོ།",
    "སྟེང་དང་འོག་ཏུ་སོར་གཉིས་ཏེ་ཞབས་དག་གི་ངོས་ཀྱི་ཞེང་ལའོ།",
    "ཞབས་ཀྱི་སོར་མོ་ལྔ་ནི་ཚིགས་གཉིས་གཉིས་པའོ།",
    "དེ་རྣམས་ཀྱི་རྩེ་མོར་ཚིགས་ཕྱེད་ཀྱིས་སེན་མོའོ།",
    "ཞབས་ཀྱི་མཐེ་བོང་གི་ཟླུམ་ལ་སོར་ལྔ་སྟེ་རིང་བར་ནི་སོར་གསུམ་མོ།",
    "དེ་དང་མཉམ་པའི་མཛུབ་མོའོ།",
    "དེ་ལས་ནས་ཕྱེད་ཀྱིས་དམན་པ་ནི་གུང་མོའོ།",
    "སོར་མོ་རྣམས་ཀྱི་དཔངས་ལ་ནི་སོར་གཅིག་སྟེ་སོར་མོའི་རྩེ་མོ་ནི་སོར་ཕྱེད་ཀྱིས་མཐོ་བའོ།",
    "ཞབས་དག་གི་ཕྱི་རོལ་གྱི་སྟེང་ནི་རུས་སྦལ་གྱི་རྒྱབ་དང་མཚུངས་པ་སྟེ།",
    "དེ་དག་གི་འོག་ཏུ་འཁོར་ལོ་ལ་སོགས་པས་བརྒྱན་པའོ།",
    "བྱ་གག་གི་སྒོ་ང་དང་ཏིལ་གྱི་རྣམ་པ་དང་གྲུ་བཞི་དང་ཟླུམ་པོ་རྣམས་ཐམས་ཅད་དུ་མཉམ་པའི་རྟགས་ཀྱི་ཞལ་བྱ་སྟེ་རྣམ་པ་བཞིའོ།",
    "སྤྱན་མ་ལ་སོགས་པ་ལྷ་མོ་གཞོན་ནུ་རྣམས་ཀྱི་ནི་ཏིལ་གྱི་གཟུགས་ཀྱི་རྣམ་པའོ།",
    "ཞི་བའི་ཞལ་རྣམས་ནི་མཉམ་པར་གཟིགས་པ་དང་རབ་ཏུ་དང་བ་དང་སྣུམ་པ་དང་ངེས་པར་གཟིགས་པ་ན་སྟེང་དུ་མ་ཡིན་པ་དང་མི་རིག་པ་དང་འོག་ཏུ་མ་ཡིན་པར་ཐམས་ཅད་མཐོང་བར་བྱའོ་ཞེས་པའོ།",
    "ཁྭ་གདོང་མ་ལ་སོགས་པ་རྣམས་ཀྱི་དེ་དག་གི་མཐོ་གཉིས་ཀྱིས་ནུ་མ་དག་སྟེ་མཁྲེགས་པའོ།",
    "བ་ཌུ་དང་མིའུ་ཐུང་དང་ཚོགས་བདག་རྣམས་ནི་མཐོ་ལྔ་པ་བྱའོ།",
    "དེ་ལ་མཐོ་གཅིག་གིས་ནི་ཞལ་ལོ།",
    "སོར་མོ་རྣམས་རིང་བ་ཉིད་དང་།",
    "བ་སྤུ་རྣམས་རེ་རེ་ནས་གཡས་ཕྱོགས་སུ་འཁྱིལ་པ་ཉིད་དང་།",
    "ཐལ་གོང་བར་མེད་པ་ཉིད་དང་།",
    "སེན་མོ་མཐོ་བ་ཉིད་དང་།",
    "སོར་མོ་རྣམས་ཟླུམ་པ་ཉིད་དང་།",
    "སོར་མོ་རྣམས་རྒྱས་པ་ཉིད་དང་།",
    "སོར་མོ་རྣམས་བྱིན་གྱིས་ཕྲ་བ་ཉིད་དང་།",
    "ཁྱུ་མཆོག་གི་སྟབས་སུ་གཤེགས་པ་ཉིད་དང་།",
    "གཟིགས་པ་རབ་རིབ་མེད་ཅིང་རྣམ་པར་དག་པ་ཉིད་དང་།",
    "ཕྱག་གི་རི་མོ་མདངས་ཡོད་པ་ཉིད་དང་།",
    "ཕྱག་གི་རི་མོ་ཟབ་པ་ཉིད་དང་།",
    "ཕྱག་གི་རི་མོ་རིང་བ་ཉིད་དང་།",
    "འབྲུག་གི་སྒྲ་དང་ལྡན་པ་ཉིད་དང་།",
    "དེ་བཞིན་དུ་སོ་སོར་རི་མོ་རྣམས་རྗེས་སུ་མཚོན་པར་འགྱུར་རོ།",
    "མཆོད་རྟེན་གྱི་བུམ་པ་ནི་གསེར་དང་འབྲས་ཀྱི་ཕུང་པོ་དང་འཁྲི་ཤིང་དུ་གྲགས་པའི་དབྱེ་བས་གྲངས་ཇི་ལྟ་བ་བཞིན་དུ་ཐ་ཡིག་གི་དབྱིབས་དང་གཙུག་ཏོར་ལྟ་བུ་དང་བྱའི་སྒོ་ང་ལྟ་བུ་དང་ཏིལ་ལྟ་བུའོ།",
    "གདུགས་ཀྱི་རྣམ་པ་ནི་སྲོག་ཤིང་གི་སྟེང་དུ་སྟེ་ཆར་ཁེབས་ཀྱི་མིང་ཅན་ནོ།",
    "དེའི་སྟེང་དུ་ནོར་བུ་བྱ་སྟེ་པདྨ་ཟླུམ་པ་ནི་མཐར་རོ་ཞེས་པ་ནི་ཁ་ཅིག་གིའོ།",
    "མཐོ་གང་གི་དཔངས་དང་ཞེང་ལ་ཆ་ཆུང་གཉིས་པའི་ས་སྟེ་དེའི་དཔངས་ནི་སུམ་འགྱུར་རོ།",
    "སྔ་མ་དང་ཕྱི་མའི་ཆ་དག་གིས་ཟུར་བཞི་པོ་རྣམས་སུ་ཕྱེད་དང་བཅས་པའི་རེའུ་མིག་བསྐོར་ནས་ཚངས་པའི་ཐིག་གི་དབུས་ཀྱི་གཡོན་དང་གཡས་དག་གི་རེའུ་མིག་གཉིས་ཡོངས་སུ་དོར་ཏེ་སྔ་མ་དང་ཕྱི་མའི་རེའུ་མིག་གི་དབུས་ཀྱི་ཚངས་ཐིག་གི་མཐར་ཐིག་བཞི་བཏབ་པ་ལས་དབུས་ཀྱི་རྩེ་མོའོ།",
    "རྩེ་མོའི་གཉིས་ཀའི་ངོས་དག་ཏུ་ཆ་གཉིས་ཕྱིས་པ་ལས་ཆ་གཉིས་གཉིས་ཀྱིས་རྩེ་མོ་བཞིའོ།",
    "ཆ་བརྒྱད་དུ་མཐོ་ཞིང་འཁྱོག་པ་ནི་གསུམ་དུ་འཁྱོག་པ་སྟེ་འོད་ཟེར་འཕྲོ་བ་གསུམ་གྱིས་རྣམ་པར་མཛེས་པའོ།",
    "དབུས་ཀྱི་ཆལ་ནི་ཚངས་ཐིག་གི་དབུས་ནས་ཕྱོགས་བཞིར་ཐིག་གཉིས་དོར་ཏེ་ཟླུམ་པོར་བསྐོར་བས་ལྟེ་བའོ།",
    "དེའི་སྟེང་དུ་ཆ་ཕྱེད་པའི་རྐེད་ཆིངས་དོར་ནས་ཆ་གཉིས་པ་དག་གིས་རྣམ་པར་རྒྱས་པའི་པདྨའོ།",
    "རྐེད་ཆིངས་ཀྱི་ཁྱུད་མོའི་སྟེང་དང་འོག་ཏུ་ཁྱུད་མོ་ཕྲ་མོ་གཉིས་དང་སྦྱར་ཏེ་བྱའོ།",
    "ཆ་གཅིག་གིས་ནི་ཟླ་བ་རྫོགས་པ་སྟེ་ལྷག་མ་རྣམས་ཕྱིས་པ་ན་ནི་བཅོམ་ལྡན་འདས་ཀྱི་དམ་ཚིག་གི་རྡོ་རྗེར་འགྱུར་རོ།",
    "ཁྲོ་བོའི་ནི་ཟུར་རྣམས་སུ་ཆ་རེ་དོར་ནས་ཁ་གྱེས་པའོ།",
    "རྩེ་མོ་གཉིས་དོར་བ་ལས་ནི་རྩེ་གཅིག་པ་སྟེ་ཀླུ་ཀུན་ནས་སྐྱོད་པར་བྱེད་པའོ།",
    "རྩེ་དགུ་པ་ནི་ཟུར་རྣམས་སུ་རྩེ་མོ་བཞི་བྱས་པ་སྟེ་འོན་ཀྱང་དབུས་ཀྱི་རྩེ་མོ་ནི་ཟླུམ་པོའོ།",
    "རྩེ་མོ་བཅུ་གཉིས་པའི་སྣ་ཚོགས་རྡོ་རྗེ་ནི་ལྟེ་བའི་ཕྱོགས་བཞིར་རྩེ་མོ་གསུམ་བྱས་པའོ།",
    "དེ་ཉིད་རྩེ་མོ་ལྔ་པར་བྱས་པས་རྩེ་མོ་ཉི་ཤུ་པའི་སྣ་ཚོགས་རྡོ་རྗེའོ།",
    "སླར་ཡང་དེ་ཉིད་ལ་སྟེང་དང་འོག་ཏུ་རྩེ་མོ་ལྔ་ལྔ་བྱིན་པ་ལས་རྩེ་མོ་སུམ་ཅུ་པའི་སྣ་ཚོགས་རྡོ་རྗེའོ་ཞེས་སོ།",
    "ཆག་ཅིག་གིས་པདྨའོ།",
    "ཆ་གཞན་དག་གི་ཟུར་དག་ལས་ཆ་བཞི་སྤངས་ནས་འདབ་མ་བརྒྱད་པའི་པདྨ་སྟེ་ལྟེ་བ་དང་གེ་སར་དང་ལྡན་པའོ།",
    "ལྟེ་བའི་སྟེང་གདན་གྱི་འོག་ཏུ་རི་མོ་གསུམ་པ་མགྲིན་པའི་གཟུགས་ཅན་བྱའོ།",
    "ཀུན་ནས་ངེས་པར་སོང་བའི་མུ་ཁྱུད་ལ་ཆ་གཅིག་སྟེ་རྡོ་རྗེ་འཛིན་པ་ཆེན་པོའིའོ།",
    "ཁ་ཅིག་ནི་བ་ལང་གི་གདོང་ལྟ་བུའོ།",
    "འདིར་རྡོ་རྗེའི་དབུས་དང་ཤར་ལ་སོགས་པའི་རྩེ་མོ་དང་ལྟེ་བའི་མཐར་ཐུག་པ་རྣམས་ལ་མི་བསྐྱོད་པ་དང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་བསམ་པར་བྱའོ།",
    "ཕྱོགས་གཞན་གྱི་རྩེ་མོ་རྣམས་ལ་ནི་དབུས་སུ་ཡེ་ཤེས་མཁའ་འགྲོ་མ་དང་།",
    "བྱང་དུ་རྡོ་རྗེ་དག་མོ་མཁའ་འགྲོ་མ་དང་།",
    "ལྷོར་གཏུམ་མོ་རྣམས་སོ།",
    "དྲིལ་བུ་དེའི་སྟེང་དུ་ཁ་འོག་ཏུ་ཕྱོགས་པའི་པདྨ་རྣམས་ལ་གཡས་སྐོར་གྱིས་ཕྱོགས་སུ་སྤྱན་མ་དང་མཱ་མ་ཀཱི་དང་གོས་དཀར་མོ་དང་སྒྲོལ་བ་རྣམས་དང་།",
    "བུམ་པའི་སྟེང་གི་ཞལ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་མའི་སྐུའོ།",
    "ཞེས་བརྗོད་ཅིང་རྡོ་རྗེ་གཡས་པའི་རྒན་པོ་མིང་མེད་དག་གིས་དང་།",
    "ཨོཾ་བཛྲ་གྷཎྚ་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་དྲིལ་བུ་ཡང་གཡོན་པ་དག་གིས་བཟུང་ནས་གཡོན་པའི་དཀུར་བཞག་སྟེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་མཉེས་པར་བྱའོ་ཞེས་ལྷག་པར་མོས་ལ།",
    "སོ་ཧི་ཨི་བཛྫ་མུལླཱ་ལུ་ཏཱ་རི་ཨཏྭ་བི་མོཀྑ་དྷ་རམ་བི་མོ་ཀྭེཾ་བཱ་ཛྫ་ཏུ་ཧཱུཾ་བཱཛྫ་ཨུཙྪ་ཌ་དྷ་རཾ་ཏུ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཧོ་ཞེས་བརྗོད་ཅིང་རྡོ་རྗེ་གསོར་བར་བྱའོ།",
    "སརྦ་བུདྔྷ་ཀྵེ་ཏྲ་པྲ་ཙྪ་ལི་ཏེ།",
    "པད་ཀོར་རྣམ་པ་གསུམ་མམ་རྣམ་པ་ལྔ་པུས་མོའི་ཁོངས་སུ་བྱའོ་ཞེས་པ་རྡོ་རྗེ་དང་རྡོ་རྗེ་དྲིལ་བུའི་མཚན་ཉིད་ལ་སོགས་པའི་ཆོ་གའོ།",
    "ཌ་མ་རུ་ལ་ནི་ཁའི་ཚད་གྲུ་བཞི་བའི་ས་ལ་ཆ་བཅུ་གཉིས་ཏེ་ཚངས་ཐིག་གཉིས་བཏབ་ནས་ཚངས་པའི་ཐིག་ནས་བཟུང་སྟེ་ལྟེ་བ་ནས་གཡས་དང་གཡོན་གྱི་ཟུར་ཇི་སྲིད་པར་བསྐོར་ཞིང་ཚངས་པ་དང་ཟུར་གྱི་ཐིག་གི་མཐའ་རྣམས་ཕྱིས་པ་ལས་ཌ་མ་རུར་འགྱུར་རོ།",
    "ཚངས་པས་གཟུང་བར་རན་པའི་སྦོམ་པ་དང་རྣ་བའི་མཐར་ཐུག་པར་རིང་བ་ནི་ཡུ་བ་སྟེ་གདོང་གི་ཚད་ཀྱི་གྲུ་བཞིའི་ས་ལ་སྔ་མ་བཞིན་དུ་རྩེ་མོ་གསུམ་པའི་རྡོ་རྗེ་ཡུལ་རེ་རེར་སྟེང་དུ་བརྐྱང་བ་ལས་རྩེ་མོ་གསུམ་དུ་འགྱུར་རོ།",
    "དེ་ནས་ཁ་ཊྭཱཾ་ག་ནི་དམ་ཚིག་གི་རྡོ་རྗེ་ལྟ་བུའི་རྡོ་རྗེས་རྩེ་མོར་རྣམ་པར་མཛེས་པ་སྟེ་དེའི་འོག་ཏུ་མི་མོག་སྐམ་པོ་གསུམ་གྱིས་མཛེས་ཤིང་སྣ་ཚོགས་རྡོ་རྗེ་དབུས་སུ་བརྒྱན་པ།",
    "རྩེ་མོ་གཅིག་པའི་རྡོ་རྗེ་གཅིག་ནི་རྩ་བའི་གནས་སུའོ་ཞེས་ཁ་ཅིག་གོ།",
    "ཁའི་སྟེང་དུ་དམ་ཚིག་གི་རྡོ་རྗེ་བ་དན་ལྟར་རབ་ཏུ་འཕྱང་བའོ་ཞེས་པ་ནི་གཉིས་བའོ།",
    "དེ་བཞིན་དུ་ཆ་བཞི་ནི་འཁྱོག་པ་སྟེ་རྩེ་མོའི་རྣམ་པའོ།",
    "ཆ་བརྒྱད་ཀྱི་ཟུར་ནས་ཆ་དགུའི་ཟུར་ཇི་སྲིད་པར་འཁྱོག་པ་ནི་གྲི་གུག་སྟེ་ཆང་གཟུངས་ཀྱི་སྟེང་དུ་རྡོ་རྗེ་ཕྱེད་པས་བརྒྱན་པའོ།",
    "རེ་རེའི་ཐོད་པ་འཕེལ་བའོ།",
    "བུད་མེད་རྣམས་ཀྱི་རྟག་ཏུ་ཡང་།",
    "མུ་ཏིག་ཕྲེང་འདྲའི་རི་མོར་གྱུར།",
    "རང་གི་འདོད་པས་འཁྱིལ་པ་བྱས་ཏེ་སོར་གཉིས་སུ་སྦོམ་པ་མཐའ་གཉིས་ལ་རྡོ་རྗེས་བརྒྱན་པ་ནི་ཞགས་པའོ།",
    "དེ་དང་འདྲ་པ་ལ་ལྕགས་ཀྱུ་ནི་མཐོ་གང་པའི་རྩེ་མོ་གུག་པའོ།",
    "ཐོ་བ་ནི་སྣ་ཚོགས་དང་འདྲ་སྟེ་འོག་ཀྱང་ཕྱོགས་གཅིག་གི་རྩེ་མོ་རྣམས་གཅིག་པ་ཟླུམ་པོའི་ཡུ་བ་ཅན་ནོ།",
    "གཞུ་ནི་མཐོ་བཅུ་པ་སྟེ་ཞེང་ལ་སོར་བཞི་པ་ཆང་གཟུངས་ཀྱི་ཆ་རིང་པར་སོར་བཅུ་དྲུག་པ་འཁྱོག་པོའི་དབུས་ལ་སོར་བརྒྱད་པ་མཐའ་སྐོར་གྱི་ཟླུམ་ལ་སོར་དགུ་པ།",
    "ཀླུའི་གདེངས་ཀའི་རྣམ་པས་མཛེས་པ་དེ་དག་གི་དབུས་སུ་ཀོ་སྐོ་ལྟ་བུ་སོར་གང་དུ་རྣམ་པ་རྒྱས་པ།",
    "སླར་ཡང་དེའི་ཕྱི་རོལ་དུ་རྐང་པ་དང་བཅས་པའི་ཆ་གཅིག་གིས་རྩིབས་ཀྱི་ཟླུམ་པོ་དང་།",
    "ལྕགས་སྒྲོག་གིས་རྩེ་མོར་བཅིངས་པའི་ལྕགས་ཀྱི་བིལ་བ་ཅན་ནི་ཀ་ཎ་ཡའོ།",
    "མངའ་ལྟ་བུ་སྒྲོ་གསུམ་དང་ལྡན་ཞིང་གདོང་གི་ཚད་ཅན་ནི་འཕང་མདུང་ངོ།",
    "གཎྜཱི་དང་སྲོག་ཤིང་དང་རྩེ་མོར་གནས་བ་དང་།",
    "སྒོ་ལ་སོགས་པ་ཀ་བ་དང་བསྐྱེད་པའི་ཤིང་གི་དཔངས་དང་ཞེང་དང་ཁོ་ལག་དང་ཟླུམ་རྣམས་དང་གནས་ཀྱི་བདག་པོ་དང་ཐིག་འཛིན་པ་ལ་སོགས་པ་མཐའ་དག་གིས་དེ་དག་གི་ཚད་ཡོངས་སུ་གྲོས་བྱས་ནས་སློབ་དཔོན་དང་ཤིང་མཁན་རྣམས་དང་ལྷན་ཅིག་ནགས་ཚལ་གྱི་ལྟད་མོ་ལ་འགྲོ་བར་བྱའོ།",
    "ཚོགས་པ་ན་ཕུན་སུམ་ཚོགས་པའི་སྐར་མ་དང་གཟའ་དང་ཉི་མ་བཟང་པོ་བརྟགས་ཏེ་སྔགས་པས་བགེགས་མཐར་བྱེད་ཀྱི་གཟུགས་ཀྱིས་དུས་ཡོངས་སུ་བརྟགས་ལ་ཤར་དང་བྱང་གི་ཕྱོགས་སུ་ཁ་བལྟས་ནས་སོ།",
    "ནགས་ཚལ་དང་རི་དང་དགའ་བའི་ས་གཞི་མཆོག་གི་ཆ་ལ་རབ་ཏུ་འཇུག་པར་བྱའོ།",
    "ཨ་མྲ་དང་།",
    "སྦྲང་གི་ཤིང་དང་།",
    "གཞོན་པ་དང་རྒས་པ་དང་ཡན་ལག་འཁྱོག་པ་རྣམ་ནི་མ་ཡིན་ཏེ།",
    "དུར་ཁྲོད་དང་ཁུང་བུ་དང་བྱ་སྐྱིབས་དང་ལྷའི་གནས་དང་ལམ་དུ་སྐྱེས་པ་དང་ཚ་བ་དང་ཁ་བ་དང་གྲོང་གི་མི་གཙང་བའི་ཡུལ་དུ་གནས་པ་དང་།",
    "མཚེ་འུ་དང་ཆུ་ཀླུང་གི་དོགས་སུ་སྐྱེས་པ་ལ་སོགས་པ་རྣམས་དང་།",
    "རྡོ་རྗེས་བསྣུན་པས་དུམ་བུར་སོང་བ་རྣམས་སྤངས་ཏེ།",
    "ཕྱོགས་ཀྱི་ལྷ་རྣམས་དང་ནགས་ཚལ་གྱི་ཤིང་གི་ལྷ་རྣམས་ཉེ་བར་སྤྱོད་པ་ལྔས་ཡང་དག་པར་མཆོད་དོ།",
    "སཱ་ལ་དང་ཐང་ཤིང་དང་ཏིལ་སེའི་ཤིང་རྣམས་ལ་ཡང་དག་པར་གནས་པའི་ལྷ་མོ་ནི་འཇིག་རྟེན་གྱི་མ་མོ་དང་དེ་ལ་གནས་པའི་ཞིང་སྐྱོད་ནི་རི་རབ་ཆེན་པོ་ཞེས་བྱ་བ་འདིའོ།",
    "སཱུ་མ་ནཱ་ག་དང་ནཱ་ག་གེ་སར་དང་ཙམ་བ་དང་མྱ་ངན་མེད་པ་རྣམས་ཀྱི་ལྷ་མོ་ནི་གསང་བ་མ་དང་།",
    "ཨ་རུ་རའི་ཤིང་དང་ཧ་རཱི་ཏི་དང་པ་ཊའི་ཤིང་ལ་ཀརྞ་མོ་ཏི་ཀ་དང་ཧེ་ཏུའོ།",
    "ཀ་དམྤའི་ཤིང་ལ་ལྷ་མོ་བཞིན་བཟང་མོ་དང་།",
    "འཇམ་འབྲས་ཀྱི་ཤིང་ལ་ལྷ་མོ་འཇམ་འབྲས་ལ་གནས་མ་སྟེ་ཞིང་གི་བདག་པོ་དག་ནི་དྲིལ་བུ་ཆེན་པོའོ།",
