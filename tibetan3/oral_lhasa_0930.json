    "ངག་རྩ་སྔགས་ལ་སོགས་པ་ཟློས་པར་མཉམ་པ་སྟེ།",
    "ཡབ་ཀྱིས་ཡུམ་གྱི་མཁའ་མི་དམིགས་ཏེ་སྟོང་པ་ལས་ཨཱ་ལས་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་ཟེའུ་འབྲུ་ལ་ཨཱ་ས་བྱིན་གྱིས་བརླབས་པར་བསམ།",
    "དེ་ནས་བཟློག་དེ་ནས་ཁྱབ་པར་བྱ་བ།",
    "མཐར་མི་ཉམས་པར་བསྲུང་བའོ།",
    "ཡང་སྐད་ཅིག་མ་བཞི་ནི་ཉམས་མྱོངའབྱེད་པར་བྱེད་པ་ཡིན་ལ།",
    "གཉིས་པ་རྣམ་པར་སྨིན་པའི་སྐད་ཅིག་མ་སྟེ།",
    "བོལླ་དང་ཀཀྐོ་ལཱ་མཉམ་པར་སྦྱར་བ་ལས་བདེ་བ་སྔར་བས་འཕེལ་ཞིང་མཆོག་ཏུ་གྱུར་པས་ན་དེའི་དུས་སུ་ཉམས་ཅི་སྐྱེས་ཐམས་ཅད་མཆོག་དགའི་ཡེ་ཤེས་སོ།",
    "གསུམ་པ་རྣམ་པར་ཉེད་པའི་སྐད་ཅིག་མ་སྟེ།",
    "བསྲུབ་པ་ལ་སོགས་པའི་སྒོ་ནས་ཕྱག་རྒྱ་རྣམ་པར་ཉེད་པ་སྟེ།",
    "གསང་ཐུབ་པར་བྱ་སྟེ་དངོས་སུ་སྙོམས་འཇུག་མི་བྱའོ།",
    "གསང་ཐུབ་པར་བྱ།",
    "བདེ་སྟོང་དུ་མ་སྐྱེས་པའི་ཚེ་རིམ་གྱིས་མཆོག་དགའ་ལ་བསླབ་ཞེ་དགུ་སྟེ་། དེ་ནས་བོལླ་ཀཀྐོ་ལཱ་མཉམ་པར་སྦྱར་ཞིང་།",
    "གསང་ཐུབ་པར་བྱ།",
    "དེ་ནས་ཅུང་ཟད་བསྲུབ་པ་ན་བདེ་བ་མི་རྟོག་པ་དང་ལྡན་པར་འབྱུང་སྟེ།",
    "བདེ་བ་ཡལ་ནས་འགྲོ་བས་དྲག་ཏུ་མི་སྲུབ་པར་དལ་བུས་བསྲུབ།",
    "དེ་ཉིད་བཟློག་པར་ཡང་འགྱུར་རོ།",
    "ཁྱད་པར་དུ་ངག་སྟོབས་ཀྱི་ཧཱུཾ་དྲག་ལ་རིང་བས་དྲང་།",
    "དེ་རྣམས་ཀྱི་ལུས་ཐམས་ཅད་ལ་ཁྱབ་པར་འགྱུར་རོ།",
    "མི་ཉམས་པར་བསྲུང་བ་དྲུག་ནི།",
    "རྗེས་བཅད་བཟློག་ཅིང་ཁྱབ་པར་བྱ་བའོ།",
    "ལུས་ཀྱི་སྤྱོད་ལམ་ལྡན་བྱས་ནས།",
    "སྦ་བ་སྦུབས་སུ་ནུབ་པར་འགྱུར།",
    "བྱིན་གྱིས་བརླབས་སོགས་བྱས་ནས་ནི།",
    "མིག་གཉིས་སྟེང་དུ་བགྲད་པར་བྱ།",
    "འདིས་ནི་ཐིག་ལེ་ཟིན་པར་འགྱུར།",
    "འདིས་ཀྱང་ཐིག་ལེ་ཟིན་པར་འགྱུར།",
    "རྡོ་རྗེ་དང་པདྨ་བྱིན་གྱིས་བརླབས་ཏེ་སོགས་ཁོང་དུ་ལུས་ངག་མཉམ་པ་དང་འདོད་པ་མཉམ་པར་བྱས་ནས།",
    "འདིར་བོལླ་དང་ཀཀྐོ་ལཱ་མཉམ་པར་སྦྱར་ཏེ་ཕར་བསྐྱོད་ཚུར་དྲུད་ཅིང་འདོད་ཆགས་ཀྱི་མེས་ཐིག་ལེ་ཕབ་པས་བདེ་བས་མི་བཟོད་པ་དང་ཐིག་ལེ་བསྲུང་བའི་ཕྱིར་སྲིན་པོའི་ལམ་ཅུང་ཟད་བསྡམས།",
    "ལུས་སེམས་ལྷུག་པར་གཞག་གོ།",
    "དེས་ཐིག་ལེ་ཟིན་པར་འགྱུར་རོ།",
    "སྙོམས་འཇུག་བྱས་པའི་རྗེས་ལ་ལུས་སྐྱིལ་ཀྲུང་དུ་བྱས་ཏེ།",
    "གསང་གནས་ནས་ལྟེ་བའི་བར་ཐིག་ལེ་འདྲེན་པར་བསམ་ཤིང་ཤེས་པ་ལྟེ་བ་ལ་གཏད་ལ།",
    "ཁྱབ་པར་བྱ་བ་ལ་མཁས་པ་སེངྒེ་རྣམ་གྲོལ་གྱི་ཕྱག་རྒྱའོ།",
    "ལུས་ཐམས་ཅད་ལ་བདེ་བ་ཁྱབ་པར་སྐྱེས་ན་དགའ་བྲལ་སྣང་བའི་དངོས་པོ་ཐམས་ཅད་ལ་ཁྱབ་པར་སྐྱེས་ན་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའོ།",
    "དགའ་བ་གསུམ་གྱི་རྣམ་པར་རྟོག་པ་འགོག་པས་ལྷན་སྐྱེས་སོ། ། བཞི་པ་ངོ་བོ་ལ་ལྟོས་པ་ནི།",
    "འབྲས་བུའི་སྐབས་ཉིད་དུ་འཆད་པར་འགྱུར་བས་སྐབས་འདིར་༣། མ་བརྗོད་དོ།",
    "བསམ་གཏན་གྱི་ཡན་ལག་རྣམས་ཚང་བར་བྱས་ཏེ།",
    "དང་པོ་ཐབས་རྒྱུད་དག་པར་བྱ་བ།",
    "དེ་ནས་ཤེས་རབ་ཀྱི་རྒྱུད་དག་པར་བྱ་བ།",
    "དེ་ནས་གཉིས་ཀའི་རྒྱུད་སོ་སོར་དག་པར་བྱ་བའོ།",
    "ཐབས་རྒྱུད་དག་པར་བྱ་བ་བསྟན་པའོ། ། དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་རྒྱུད་ལ་ཡང་བྱ་སྟེ།",
    "གཉིས་ཀ་ཡང་སྐུ་ལྔ་ལྷུན་གྱིས་གྲུབ་པར་དྲན་པ་ཙམབྱའོ།",
    "དེ་ལྟར་ན་ཐབས་རྒྱུད་དག་པར་བྱ་བའི་སྐད་ཅིག་མ་གསུམ།",
    "ཤེས་རབ་ཀྱི་རྒྱུད་དག་པར་བྱ་བའི་སྐད་ཅིག་མ་གསུམ།",
    "རྣམ་པར་སྨིན་པས་སྟོབས་སྟེར་བྱེད།",
    "སྐྱེས་བུ་བྱེད་པས་རྣམ་པར་འཕེལ།",
    "དེ་ཙམ་༣། ན་སྐྲ་དཀར་དང་གཉེར་མ་སྤངས་ཏེ་ལུས་གཞོན་ཤ་དང་བཅས་པར་འགྱུར་རོ།",
    "གཉིས་པ་རྣམ་པར་སྨིན་པས་སྟོབས་སྟེར་བ་ནི།",
    "ཁམས་དྭངས་མ་མགྲིན་པར་བརྟན་ཙམ་ན་ལྕེ་འཕེལ་ཏེ་མཛོད་སྤུར་སླེབས།",
    "སྤྱི་བོར་བརྟན་ཙམ་ན་ལུས་བྱ་དང་རི་དྭགས་ལ་སོགས་པར་སྤྲུལ་ནུས་པ་དང་།",
    "རྣམ་པར་ངེས་པ་འབྱུང་སྟེ།",
    "སྒྲ་ལ་གོམས་པར་བྱ་བ་དང་།",
    "ཡི་གེ་ལ་གོམས་པར་བྱ་བའོ།",
    "ཧིཀ་ཀི་ཞེས་པ་ཉི་ཤུས་མགྲིན་པར་དྲང་ཞིང་ཀི་ཧིག་ཅེས་པ་ཉི་ཤུས་ངལ་བསོ་ལ།",
    "ཉི་ཤུ་རྩ་གཅིག་པ་བྱས་ན་ཚེ་ཐུང་ངུ་འགྲོ་བས་མི་བྱ།",
    "དེ་ལྟར་ཐུན་བཞིའི་ངེས་པས་ཞག་བདུན་དུ་གོམས་པར་བྱའོ། ། ཡི་གེ་ལ་གོམས་པར་བྱ་བ་ལ་གཉིས་ཏེ།",
    "ཕྱིའི་ཡི་གེ་ལ་གོམས་པར་བྱ་བ་དང་།",
    "དང་པོ་ལུས་ཀྱི་སྒོ་དགུ་ཡི་གེ་དགུས་དགག་པར་བྱ་སྟེ།",
    "དེའང་གཡས་ནས་རྒྱལ་པོ་གཡོན་ནས་ཕལ་པར་སྐྱེ་དེ་དགག་པའི་ཕྱིར་ཟླ་བ་ལ་ཡུཾ་སེར་པོ་མགོ་སྤྲོད་དམ་བསྒྲིལ་མ།",
    "གཡས་ནས་རྒྱལ་པོ་གཡོན་ནས་ཕལ་པར་སྐྱེ་དེ་དགག་པའི་ཕྱིར་ཟླ་བ་ལ་ཧཱུཾ་སྔོན་པོ་གཉིས་གཉིས།",
    "མགོ་སྤྲོད་ཐམས་ཅད་ཀྱི་བར་ཟླ་བས་བཅད་པར་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་ཐུན་བཞིའི་ངེས་པས་ཞག་བདུན་དུ་གོམས་པར་བྱའོ། ། འཆི་ལྟས་ངེས་པར་བྱུང་ནས་མ་བསླུས་ན།",
    "དངོས་གྲུབ་ལེན་པ་ལ་བར་ཆད་འོང་བས་ནུབ་དང་པོ་ལ་བསྲུང་བའི་འཁོར་ལོ་བརྟན་པོར་བསྒོམ་ཉིན་ཞག་གཉིས་པ་ལ་རྟེན་དེ་གནས་དབེན་པར་བཞག་ལ།",
    "དམ་ཚིག་མཁའ་འགྲོ་དང་ཤ་ཟ་མཁའ་འགྲོ་ཚོགས་ཀྱི་ཡོ་བྱད་ཀྱིས་མཉེས་པར་བྱ།",
    "སྲོག་འཇུག་པ་དང་བྲལ་བར་བྱས་ན་ངེས་པར་ལས་ལ་སྦྱར་བ་དེ་འགྲུབ་བོ།",
    "འབྲས་བུ་ཉིད་ཀྱི་སྐབས་སུ་འཆད་པར་འགྱུར་བས་འདིར་མ་བརྗོད་དོ།",
    "འབྲིང་འདའ་ཀ་མས་རྐྱེན་བྱས་ནས་གྲུབམཐའ་སྙོགས།",
    "དངོས་གཞི་སོ་སོར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ཟས་དང་ངེས་མེད་དང་གཉིད་དུ་འགྲོ་ཀ་གསུམ་དུ་བྱས་པས་རྨི་ལམ་དུ་དྲན་ན་འགྲུབ་པ་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "དེ་དང་འབྲེལ་བའི་ལྟ་བཤིན་ཏུ་རྣམ་པར་དག་པའི་དེ་ཁོ་ན་ཉིད་བདེ་སྟོང་དྲན་པ་གསུམ་ནི་ཐུན་གྱི་ངེས་པ་གཅིག་ལ་འབྲེལ་བ་ཅན་དུ་དྲན་པ་རྩེ་གཅིག་ཏུ་བྱའོ།",
    "དེ་ནས་དངོས་གཞི་ལ་བསྣམ་བྱ་རྣམ་པ་ལྔ་དང་རྐྱེན་བདུན་དུས་མཉམ་པར་བྱུང་ན་སྐྱབས་འཚོལ་བ་འབྱུང་ལ།",
    "མི་ཉམས་པར་བསྲུང་བའི་འཐད་པ་བསྟན་པ།",
    "རྗེས་སྤྱོད་ཤིན་ཏུ་རྣམ་པར་དག་པའི་དེ་ཁོ་ན་ཉིད།",
    "ཉིས་པ་ནི་དམ་ཚིག་ལྷག་མ་བཅུ་དགུ་པོ་རྣམས་ཅི་རིགས་པར་ཉམས་ན་ལམ་བགྲོད་པ་ལ་རིང་དུ་འགོར་བ་སྟེ།",
    "ཚེ་སྨད་ལ་ཐོབ་པ་དེ་འཆི་ཀ་ལ་སོགས་པར་ཕྱིར་ནུར་བའོ། ། གསུམ་པ་དམ་ཚིག་དེ་རྣམས་མི་ཉམས་པར་བསྲུང་བའི་འཐད་པ་བསྟན་པ་ནི།",
    "མཐུན་རྐྱེན་ཡིན་པས་བསྒྲུབ་དགོས་པསསོ། ། བཞི་པ་དེ་དག་མི་ཉམས་པར་བསྲུང་བའི་ཚུལ་དངོས་ལ་བཞི་སྟེ།",
    "ཐམས་ཅད་ཚུལ་ཇི་ལྟ་བ་བཞིན་རྒྱུད་ལ་སྐྱེས་པས་མི་ཉམས་པར་བསྲུང་བ་དང་།"
  ]
}