    "དེ་ལ་དང་པོ་ལུས་ཁྱད་པར་ཅན་ནི།",
    "དེ་ལྟ་བུ་དེ་ཆེད་དུ་བྱས་པ་མ་ཡིན་པས་བདེན་པ་མ་ཡིན་ལ།",
    "མཉམ་གཞག་ལ་ལྷ་སྐུ་ལ་སོགས་པ་བསྒོམས་ཀྱང་།",
    "གཙོ་བོར་ཕྱི་ཡུལ་གྱི་སྟེང་དུ་སྐྱེ་ངོ་བོ་མི་རྟོག་པར་སྐྱེ།",
    "འབྲས་བུ་ཉམས་ཀྱང་རིམ་པ་ཡིན་མིན་དུ་སྐྱེ་བས་ན་དེ་རྣམས་གང་བྱུང་ཡང་ཏིང་ངེ་འཛིན་དུ་ངོ་ཤེས་པར་བྱས་ལ་ལམ་དུ་བསྲེལ་ལོ།",
    "སྐབས་འདིར་མ་བསྟན་ཏེ་འོག་ཏུ་ཤེས་པར་བྱའོ།",
    "གཉིས་པ་རྒྱུ་ལ་བཅུ་དྲུག་གནས་པའི་ནུས་པ་ལུས་ལ་བརྟེན་ནས་སྨིན་པར་བྱེད་པ་རྐྱེན་ཆུ་ལུད་ལྟ་བུའི་ལུས་ཐབས་རྒྱུད་དང་།",
    "དེ་ཉིད་ཐབས་ཁྱད་པར་ཅན་གྱི་རྐྱེན་དང་འཕྲད་ན་མྱ་ངན་ལས་འདས་པའི་རྒྱུར་འགྱུར་བ་ཡིན་ནོ།",
    "ལྷའི་གདན་མ་ལུས་པ་ཚང་བ་ལ་རྣམ་པར་བཞག་པ་དང་།",
    "དེ་ཡང་དཔལ་བདེ་མཆོག་ལྷ་སུམ་ཅུ་རྩ་བདུན་ནམ།",
    "གསང་བ་འདུས་པ་ལྷ་སོ་གཉིས་ལྟ་བུ་ལ་སྦྱར་ཏེ་ཤེས་པར་བྱའོ།",
    "འདི་དག་ཐམས་ཅད་ཀྱང་རྣལ་འབྱོར་ལམ་པ་ལ་ཉམས་ཀྱི་སྣང་བ་སྐྱེད་པར་བྱེད་པ་དང་།",
    "རྗེས་གནང་།",
    "དེ་བས་ཀྱང་རྣམ་རྟོག་ཆེ་བས་རྫས་དེ་ལྕེ་ལ་འཇོག་མ་ནུས་པས་མགྲིན་པར་ཐིག་ལེ་བྱ་བ་ཙམ་སྟེ་ལྔའོ།",
    "འབྲས་བུ་སྐ་རྣམ་པ་ང་ཞི་ཐོབ་པའི་སྐལ་བ་ཅན་དུ་བྱས་པའོ།",
    "ལམ་ལ་གོམས་པར་བྱ་བ་བསྐྱེད་པའི་རིམ་པ་དབྱིབས།",
    "བསམ་གཏན་གྱི་ཡན་ལག་རྣམས་ཚང་བར་བྱས་ལ།",
    "གུས་འདུད་དྲག་པོར་བྱས་ཏེ་བདག་ཉིད་ལ་ཐིམ་པས་མུན་ཁུང་དུ་སྒྲོན་མེ་བཏེགས་པ་ལྟར་ལུས་ཀྱི་དཀྱིལ་འཁོར་གསལ་གདབ་སྟེ།",
    "འོག་མ་རྣམས་ལའང་དྲན་པར་བྱའོ།",
    "སྤང་བྱ་འདུ་བྱེད་དང་ཕྲག་དོག་རྣམ་པར་དག་པས་འབྲས་བུ་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ཤར་བ།",
    "དེ་ཉིད་ཉམས་སུ་ལེན་ཞིང་སྐྱོང་ཚུལ་ནི་ལུས་ཀྱི་དཀྱིལ་འཁོར་རྟེན་དང་བརྟེན་པར་བཅས་པ་གསལ་གདབ་སྟེ།",
    "དེ་ཉིད་བྱུང་རྒྱལ་དུ་བསྐྱངས་པས་རིམ་གྱིས་ཕྱི་ནང་གྱི་རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་གྱི་ལྷ་མ་ལུས་པའམ།",
    "བརྟན་གཡོ་སྣོད་བཅུད་ཀྱིས་བསྡུས་པའི་སྣང་བའི་དངོས་པོ་ཐམས་ཅད་ལ་སྔར་གྱི་ལྟ་བའི་ཡེ་ཤེས་དེས་ཁྱབ་པར་སྐྱེ་སྟེ།",
    "ཆུ་བོ་གྱེན་ལ་བཟློག་ཉི་ཟླ་གཏིང་པར་འཛིན།",
    "ཅེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ལ་དུས་ཐོབ་པར་བྱ་བའི་ཕྱིར་འཆི་ལྟས་བརྟག་པ་ལ་ཚུལ་བཞི་ལས།",
    "ཟླ་བ་གཅིག་ཏུ་གོ་ལོག་ན་གཉེན་འབྲེལ་དག་རྒུད་པར་འགྱུར་རོ།",
    "ཟླ་བ་ཕྱེད་དང་གཉིས་གོ་ལོག་ནས་རྒྱུ་ན་ཟླ་བ་དྲུག་ནས་ངེས་པར་འཆི་བའི་རྟགས་སོ།",
    "དགུན་ཟླ་རྭ་བ་ཞེས་བྱ་བ་སྨལ་པོས་ཉ་བའི་ཚེས་གཅིག་ནས་བརྟག་པར་བྱ་སྟེ།",
    "དེའི་ཕྱི་ལོ་བཅུ་བདུན་པའི་རྟགས་བརྟག་དེའི་ཕྱི་ལོ་བཅུ་དྲུག་པའི་རྟགས་བརྟག་ཅེས་བྱ་བ་ལ་སོགས་པ་རིམ་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ཚེ་སྲོག་ནི་འགག་པར་འགྱུར།",
    "སོ་གསུམ་རྒྱུ་ན་དེའི་ནངས་པར་འཆི་བར་འགྱུར་རོ།",
    "དེ་ལ་ཕྱིའི་འཆི་བསླུ་ནི་གཏོར་མ་དང་སཱཙྪ་དང་སྲོག་འདོན་ལ་སོགས་པ་ཅི་རིགས་པར་བྱ་སྟེ་བཟློག་པའོ།",
    "དང་པོ་ནི་སྲོག་རྩོལ་ཐོ་རངས་ཀྱི་ཐུན་ལ་སྟོང་ཙམ་ལ་སོགས་པ་བསྒོམས་ན་ངེས་པར་བཟློག་པའོ།",
    "ནམ་ལངས་ནས་ལག་པའི་བ་སྤུ་མཐོང་བ་ཙམ་ན་གནམ་སྔོ་སང་ངེ་མཐོང་བའི་སར་བསྡད་ལ།",
    "དེ་ལྟར་ཡང་དང་ཡང་དུ་བྱས་པས་སྒྲེགས་པ་གཅིག་བྱུང་ན་འཆི་བ་བསླུས་པ་ཡིན་ཏེ།",
    "འདིས་ངེས་པར་འཆི་བ་བསླུས་པ་ཡིན་ནོ།",
    "འདི་ཁོ་ན་བཞིན་དུ་བསྒོམ་ན་འཆི་མེད་ཀྱི་དངོས་གྲུབ་ཐོབ་བོ་ཞེས་གསུངས་སོ། ། དེ་ལྟར་བསླུས་ཀྱང་མ་ཕན་ན་ད་ནི་འཕོ་དགོས་ཏེ་དེ་ལ་གསུམ་ལས།",
    "ངེས་པར་འཆི་ལྟས་བྱུང་བའི་ཚེ།",
    "མི་བཞུགས་ན་བདག་འཇུགབྱ་ཚོགས་དང་གཏོར་མ་གཏང་།",
    "མདུན་གྱི་སྣང་བ་དེ་ལྷར་དྲན་པར་བྱས་ནས།",
    "རྒྱབ་རྟེན་རན་པ་གཅིག་བཞག་རང་ལྷག་པའི་ལྷར་བྱས་པའི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་འཕྲོས་སྟེ།",
    "དེ་བཞིན་དུ་ཉི་ཤུ་ཐམ་པའི་བར་དུ་བྱས་པས་མགྲིན་པར་བྱོན།",
    "དེ་ལ་སྤྱིར་ཐམས་ཅད་མཁྱེན་པས་ཐབས་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་གསུངས་ན་ཡང་།",
    "དམ་ཚིག་དང་ལྡན་ཞིང་སྡོམ་པ་དང་ལྡན་པས་ཁྲིད་བྱེད་པར་འདོད་ན།",
    "དེའི་ཚེ་འཕོར་མ་ཉན་ནའང་ཞག་གཅིག་གཉིས་ལ་སོགས་པ་ནུ་མ་བཅུད་ལ་བོར་བའི་སྦྱོར་བ་བྱས་ལ།",
    "དེའི་ཐུགས་ཀར་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཡི་གེ་ཧཱུཾ་དཀར་པོ་ཞིག་བསྒོམ་ལ་རྒྱས་པར་བྱེད་ན་ཧཱུཾ་ལས་འོད་ཟེར་དཀར་པོ་འཕྲོས།",
    "དེ་བཞིན་གཤེགས་པཐམས་ཅད་ཀྱི་ཐུགས་ཀ་ནས་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་སྤྱན་དྲངས་ནས་ཧཱུཾ་ལ་ཐིམ་པར་བསམ།",
    "ཤུལ་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་བདུད་རྩིས་ཁེངས་པར་བསམ་ལ།",
    "ཞེས་བྱ་བ་ཡིན་པས་ལག་ལེན་བཞིན་དུབ་དུབ་བྱས་ལ།",
    "དབེན་པར་ཡིད་ལ་ལས་མི་གཞོལ་བར་སྐྱོ་སེ་བཞག་གོ།",
    "སྦྱང་བ་གསུམ་པོ་ལོའམ་ཟླ་བའི་བར་དུ་བྱས་པས་ཏིང་ངེ་འཛིན་རང་ཤུགས་ཀྱིས་སྐྱེ་བའང་སྲིད་པས།",
    "མ་སྐྱེས་ན་བསམ་གཏན་གྱི་དངོས་གཞི་ལ་འཇུག་པར་བྱའོ།",
    "སྐྱིལ་ཀྲུང་ངམ་ཙོག་པུ་གང་བདེ་རྒྱབ་རྟེན་མེད་པར་ཚིག་པ་དྲང་པོར་བསྲངས་ཏེ་མགོ་ཅུང་ཟད་དགུག་མིག་སྣ་རྩེར་དབབ།",
