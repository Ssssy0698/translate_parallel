    "བཞི་པ་ཐབས་ཀྱིས་སྤྱོད་པའི་གྲོགས་ངོ་ཤེས་པར་བྱ་བའི་ཕྱིར་བརྡ་བསྟན་ལ།",
    "ལས་མཐའ་དག་སྒྲུབ་པར་བྱེད་པའི་ཐབས།",
    "སྐུ་གཟུགས་ལ་སོགས་པ་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་རབ་གནས་བདུན་པ་དངོས་ལས་བསྟན་ཏེ།",
    "སྡོམ་པ་ཐམས་ཅད་ལྡན་པར་ནི།",
    "བཅུ་པ་དངོས་ནས་སྐུ་གསུང་ཐུགས་ཀྱི་དམ་ཚིག་བསྟེན་པར་བྱ་བའི་དམ་ཚིག་ཕྱག་རྒྱ།",
    "ལ་ལར་མི་གསལ་བ་གསལ་བར་བྱས་ལ།",
    "ཡང་དག་པར་སྦྱོར་བ་ནི་རྒྱུའི་རྒྱུད་མ་དག་པ་སྣོད་བཅུད་དང་དག་པ་སྐུ་དང་ཡེ་ཤེས་ལ་སོགས་པར་སྣང་བས་ཐབས་དང་།",
    "རང་བཞིན་མཚན་མ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བས་ཤེས་རབ་སྟེ།",
    "རྒྱུའི་རྒྱུད་དེ་ལས་བྱུང་བ་ནི་ཐབས་ཀྱི་རྒྱུད་ཀྱི་ཐབས་ཤེས་རབ་གཉིས་མེད་དེ་ཡང་དག་པར་སྦྱོར་བ་ནི་ཏིང་ངེ་འཛིན་ཞེས་པའོ།",
    "སེམས་ཉིད་དང་བརྟན་གཡོ་ཐམས་ཅད་རོ་གཅིག་པར་ཉམས་མྱོང་སྐྱེ་བའོ།",
    "མཚན་ཉིད་ནི་ཐབས་འདིས་མཚོན་པར་བྱེད་པས་མཚན་ཉིད་ཅེས་ཐབས་ལ་བྱ་ལ།",
    "འདི་མཚོན་པར་བྱ་བ་ཞེས་འབྲས་བུ་ལ་བྱའོ།",
    "དེ་ཉིད་ཡང་དག་པར་སྦྱོར་བ་སྟེ།",
    "གཟུགས་ཀྱི་སྐུ་ཡུམ་དང་ཡང་དག་པར་སྦྱོར་བའོ།",
    "ཡང་བརྟག་པ་གཉིས་པ་རང་དུ་ཕྱག་རྒྱ་ལྔ་ལས་མ་གསུངས་ལ།",
    "འདིར་བཅུ་གཉིས་གསུངས་ལ།",
    "ཅེས་པས་ལྷ་སོ་སོའི་དག་པའང་ཟིན་པས་དག་པ་གསུམ་འབྲེལ་པ་ཅན་དུ་བསྟན་ལ།",
    "ལྟེ་བའི་དབུས་སུ་རྣམ་པར་གནས།",
    "ལྷན་ཅིག་སྐྱེས་པའི་རང་རིག་པའི་དག་པའི་ཕྱག་རྒྱའི་རིགས་ལ་མིང་བཅུ་གཉིས་གསུངས་ཀྱང་དོན་བརྒྱད་དུ་འདུ་བ་ཡིན་ཏེ།",
    "འདུ་ཤེས་གསུམ་དང་ལྡན་པས་བྱང་སེམས་མ་ཉམས་པར་གསང་ལ་བསྟེན་ཞེས་པའོ།",
    "གྲོགས་གང་དང་མཚུངས་པར་ལྡན་པ།",
    "ཀུན་རྫོབ་ཏུ་མི་གཙང་བ་ལ་སོགས་པ་དང་།",
    "དོན་དམ་པར་རང་བཞིན་མེད་པར་ཤེས་པར་བྱས་ནས་དྲན་པར་མི་བརྗེད་པར་བྱེད་པའོ།",
    "གྲོགས་ནི་དད་པ་ལ་སོགས་པའི་སེམས་ལས་བྱུང་བ་ཉི་ཤུ་རྩ་གཅིག་ལས་ཅི་རིགས་པ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ལུས་མི་གཙང་བར་ཤེས་པས་ལུས་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་གྱིས་བསྡུས་པ་དེའི་མཚན་ཉིད་ཤེས་པས་སྡུག་བསྔལ་གྱི་བདེན་པ་སྤོང་བ་ལ་འཇུག་ཚོར་བ་ཐམས་ཅད་སྡུག་བསྔལ་དུ་ཤེས་པས་སྤང་བྱར་ཤེས་པ་ན་ཚོར་བའི་འབྲས་བུ་སྲེད་པ་ལྡོག་ལ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པས་ཐོབ་པར་བྱ་བའི་དམིགས་ཡུལ།",
    "ཤེས་བཞིན་མ་ཡིན་པ་ནི་བྱིང་རྒོད་ལ་སོགས་པ་མི་རྟོགས་པ་སྟེ་དེ་ཤེས་བཞིན་གྱིས་ཟིན་པས་ཤེས་པར་བྱེད་དོ།",
    "འགོག་པ་དེའི་རྒྱུ་བདག་མེད་རྟོགས་པའི་ལམ་ལ་ལམ་དུ་ཤེས་པ་རྣམ་པར་བྱང་བར་འགྱུར་བས་ཞེས་པའོ།",
    "ངོ་བོ་དད་པ་ལ་སོགས་པ་གྲོགས་དེ་དང་མཚུངས་པར་ལྡན་པས་སེམས་ལས་བྱུང་བའོ།",
    "གཞུང་དང་སྦྱར་ཏེ་ཤེས་པར་བྱའོ།",
    "ཁྱད་པར་མ་དད་པ་ལ་སོགས་པ་འཇོམས་པའི་སྟོབས་དང་ལྡན་པར་འགྱུར་བའོ།",
    "དགའ་བ་ནི་ཕན་ཡོན་གྱི་ཡན་ལག་སྟེ་སེམས་ཀྱི་རྒྱུད་ཚིམ་པར་བྱེད་པས་སོ།",
    "གཞུང་དང་སྦྱར་ཏེ་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་ཡང་དག་པའི་ལྟ་བ་ནི་ཡོངས་སུ་གཅོད་པའི་ཡན་ལག་སྟེ་མཉམ་གཞག་ལ་དེ་ཁོ་ན་ཉིད་མངོན་སུམ་དུ་མཐོང་བ་དེ་ཉིད་རྗེས་ཀྱིས་ངེས་པར་འཛིན་པའོ།",
    "རྟོག་པ་རང་མཐུན་པར་ངག་ཀུན་ནས་སློང་བར་བྱེད་དོ།",
    "ངག་དང་ལས་ཀྱི་མཐའ་དང་འཚོ་བ་གསུམ་ནི་གཞན་དག་ཡིད་ཆེས་པར་བྱེད་པའི་ཡན་ལག་སྟེ།",
    "འཚོ་བ་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པ་འཕགས་པས་གནང་བའི་འཚོ་བ་སྟེ།",
    "བསོད་སྙོམས་ཀྱི་འཚོ་བ་རྣམ་པར་དག་པར་ཤེས་སོ།",
    "ཏིང་ངེ་འཛིན་ནི་ཡོན་ཏན་ཁྱད་པར་ཅན་ལ་སྒྲིབ་པ་མེད་པའི་ཡན་ལག་སྟེ།",
    "ཏིང་ངེ་འཛིན་གྱིས་བསམ་གཏན་གྱི་སྒྲིབ་པ་ལྔ་སྤངས་པས་མངོན་ཤེས་ལ་སོགས་པའི་ཡོན་ཏན་ཐམས་ཅད་སྐྱེད་པར་བྱེད་པས་སོ།",
    "རབ་ཏུ་བྱེད་པ་གཉིས་པའི་སྨད་བརྗོད་པར་བྱ་བའི་དོན་གཙོ་བོར་སྦས་པ་ཡིན་ལ།",
    "ལྷ་ཡེ་ཤེས་སུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་རྫོགས་པའི་རིམ་པ་དང་འབྲེལ།",
    "དེ་ལ་བཞུགས་པ་པོ་ཡེ་ཤེས་དུས་གསུམ་མཉམ་པ་ཉིད་ཀྱི་ཚུལ་གྱིས་རྟག་ཏུ་བཞུགས་པའོ།",
    "བཞུགས་པ་པོ་མཛད་པ་དང་བཅས་པ་ལ་བཞུགས་པ་པོ་སྐུ་གཉིས་པ་ལ་བྱ་ལ།",
    "སོ་སོར་སྐྱེས་པ་ཉིད་ཅེས་པ་ནི་ལམ་གྱི་དུས་སུ་འདོད་ཡོན་ལྔ་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པར་བྱས་པས་འབྲས་བུའི་དུས་སུ་ཡང་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཉིད་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པར་འདོད་པའི་ཡོན་ཏན་ལྔར་སྣང་བའོ།",
    "གདུལ་བྱའི་སེམས་ཉིད་ཀྱི་རང་བཞིན་ཁྱད་པར་མེད།",
    "རྒྱུད་ཕྱི་མ་ལས་འདོད་ཆགས་ལ་སོགས་པས་བསྐྱོད་པར་མི་ནུས་པས་བརྟན་པ་དང་།",
    "དེ་དང་མཉམ་པར་སྦྱོར་བ་དབྱིངས་སྤྲོས་བྲལ་ལོ།",
    "བ་ར་ན་ཁྱད་པར་དུ་འཕགས་ཞེས་པའི་དོན་ཏོ།",
    "སྒྱུ་མའི་རྣལ་འབྱོར་ཞེས་པ་རྣམ་སྣང་ལ་སོགས་པར་སྤྲུལ།",
    "དེ་ལས་ཀྱང་སྤྱན་མ་ལ་སོགས་པར་སྤྲུལ།",
    "དེ་ཉིད་རྟོགས་པར་དཀའ་བས་སྐད་ཀྱི་བྱིངས་ཞེས་བྱའོ།",
    "སྡོམ་ཞེས་པ་འདོད་ཆགས་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པའོ།",
    "འཁོར་ལོ་དེ་དང་རལ་གྲི་འཛིན་པ་གཉིས་ཀྱང་ཤུགས་ལས་ཤེས་པར་བྱའོ།",
    "བརྟག་པ་ཀུན་གྱིས་བརྟག་པར་བྱ།",
    "ཅེས་གསུངས་སོ།",
    "རྣལ་འབྱོར་གྱི་བདག་པོ་ལ་སོགས་པས་གཞན་དོན་ཁྱད་པར་ཅན་གྱི་སྒོ་ནས་བསྟོད་པའོ།",
    "མཉམ་པར་མ་བཞག་ཅེས་པ་ཤེས་པའི་རྒྱུ་བ་མ་བཀག་ཀྱང་ངོ།",
    "རྟག་པར་ཤིན་ཏུ་མཉམ་གཞག་ནི་སྤྱོད་ལམ་ཐམས་ཅད་དུའོ།",
    "ཉན་ཐོས་པས་གཟུང་འཛིན་དོན་དམ་དུ་སེམས་ཀྱི་ཚུལ་ཞེས་པ་སེམས་ཙམ་པས་རྣམ་པར་རིག་པ་ཙམ་དུ་རྟོགས་པའོ།",
    "འབྲས་བུ་དེ་མངོན་དུ་བྱེད་པའི་གནས་རབ་བྱེད་གསུམ་པ་དང་འབྲེལ་པ་ཅན་དུ་བྱས་ནས་འབྲས་བུ་དེ་ཐོབ་པར་བྱེད་པའི་ཐབས་ཀྱི་གནས་ཡིན་ཏེ།",
    "དོན་གནས་དེར་མངོན་དུ་བྱས་པའི་ལྷན་སྐྱེས་ཀྱི་མཚན་ཉིད་ཡིན་ཏེ།",
    "ཞེ་སྡང་ཤས་ཆེ་བ་ལ་མི་བསྐྱོད་པ་ལ་སོགས་པར་བསྟན་པའོ།",
    "ལྟེ་བའི་ཕྱི་སྐོར་དང་འཁོར་ལོ་གོང་མ་གསུམ་ཡང་འདབ་བརྒྱད་དུ་བྱས་ཏེ།",
    "ཡི་གེ་རྣམས་འཁོར་ལོའི་ཁ་དོག་དང་མཐུན་པར་བྱ།",
    "དོན་ནི་གླེང་གཞི་འཆད་པ་འདིར་ཡང་གསུངས་སོ།",
    "བཞུགས་པའི་དོན་ལ་གསུམ་སྟེ།",
    "སྤྲུལ་པའི་སྐུ་བཞུགས་པ་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རོ་གཅིག་པ་ས་བཅུ་གསུམ་པའི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་གཅིག་ཉིད་ཡིན་ལ།",
    "བཞུགས་སོ་ལ་བི་ཛ་ཧཱ་ར་བྱ་བ་ཡོད་པས།",
    "བྷ་ག་དེ་ལ་སོགས་པས་ལོངས་སྐུའི་བཞུགས་པ་སྟེ།",
    "སྤངས་པ་དང་རྟོགས་པ་ཡང་དག་པར་རྫོགས་པ་སྟེ།",
    "ཡེ་ཤེས་ཕུན་སུམ་ཚོགས་པ་སྐྱེད་པར་བྱེད་པའོ།",
    "ལྔ་པ་ནི་སྙོམས་པར་ཞུགས་པའི་སྟོབས་ཀྱིས་བརྒྱད་དྲུག་མངོན་དུ་བྱས་པ་སྟེ།",
    "སློབ་དཔོན་བདག་ཉིད་འཇུག་པ་དང་པོའི་བཅུ་པར་མི་གསལ་བ་གསལ།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་དང་།",
    "ཞེས་པ་ལ་སོགས་པ་དགའ་བ་བཞིའི་མཚོན་བྱེད་གསུངས་པ་དང་།",
    "རྗེས་སུ་གནང་བ་དང་།",
    "རྣམ་པར་རྟོག་པར་མི་འགྱུར་བས་སོ།",
    "བོལླ་ཀཀྐོ་ལ་མཉམ་པར་སྦྱོར་བའི་དུས་སུ་གོང་མ་ལས་མཆོག་ཏུ་གྱུར་པའི་བདེ་བ་ཉམས་སུ་མྱོང་བ་མཆོག་ཏུ་དགའ་བ།",
    "བདེ་བ་མི་རྟོག་པ་དང་བཅས་པར་སྐྱེ་ནས་ཤིན་ཏུ་བདེ་དགའོ།",
    "དགའ་བ་ལ་བརྟེན་ནས་མཆོག་དགའ་སྐྱེ་བ་ལ་སོགས་པར་མཐུན་པ་དང་།",
    "དེ་ཤིན་ཏུ་རྙེད་པར་དཀའ་བས་ན་རྙེད་པར་དཀའ་བའོ།",
    "མཚུངས་པ་མེད་པར་ཤིན་ཏུ་བསྡམས།",
    "དེ་བཞིན་དུ་ལམ་གྱི་དུས་སུའང་གོམས་པར་གྱིས་ཤིག་ཅེས་གཞུང་ལྷག་མས་བསྟན་ཏོ།",
    "བརྟག་པ་གཉིས་པའི་བརྗོད་པར་བྱ་བའི་དོན་སྦས་པ་རྣམ་པ་གཉིས་ཀ་ཡོད།",
    "ལྷ་ཡེ་ཤེས་སུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་རྫོགས་རིམ་དང་།",
    "བརྟག་པ་དང་པོའི་ལེའུ་བརྒྱད་པར།",
    "བརྒྱད་པར་ནམ་མཁའི་ཁམས་ནི་པདྨ་ལ་སོགས་པ་གསུངས་པ་དང་།",
    "ཕྱི་མའི་གསུམ་པར་ཡང་དཀྱིལ་འཁོར་འཁོར་ལོའི་ཐབས་ཀྱིས་སྡོམ་པ་གསུངས་པ་དེ་རྣམས་སུ་གནས་དང་།",
    "དུས་དང་སྐྱེ་བོ་གདུག་པའི་ནང་དུ་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་ལ་གོམས་པར་བྱ་བ་དང་།",
    "སྟོང་མིན་ཏེ་དངོས་པོ་ཡང་དག་ཏུ་ཡོད་པར་གཟུང་བ་ལས་སྒྲོ་སྐུར་གྱི་རྟོག་པར་འགྱུར་བའོ།",
    "གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཡིན་པར་བསྟན་པ་ལས།",
    "རིགས་དང་མཐུན་པ་ལ་ལོགས་མ་རིགས་དང་མི་མཐུན་པ་ལ་ཡང་གོམས་པར་བྱའོ།",
    "དེ་ནས་འོག་ཏུ་ཡང་དག་པར་སྦྱོར་ཞེས་པར་སྦྱར་ལ།",
    "ཕྱག་བཞི་པའི་ཞལ་མ་གསུངས་པ་དེ་འདིར་རྒྱུད་ཕྱི་མ་དང་བཅས་པས་གསལ་བར་བཤད།",
    "ཕྲིན་ལས་སྣ་ཚོགས་མཛད་པའི་ཚུལ་གྱིས་བཞུགས་པས་སོ།",
    "ཀུན་ལས་སྣ་ཚོགས་ནི་བཞུགས་ཚུལ་ཏེ་བརྐྱང་བསྐུམ་ལ་སོགས་པའོ།",
    "ཨཱ་ལི་ཀཱ་ལི་མི་མཉམ་པར་སྦྱོར་བ་དང་།",
    "ཀུ་རུ་ཀུལླེ་བརྟག་པ་གཉིས་པའི་ལེའུ་བཅུ་གཅིག་པར་ལྷའི་རྣལ་འབྱོར་ཆ་མཐུན།",
    "རྣམ་སྣང་སྒྱུ་འཕྲུལ་དྲྭ་བ་ཞེས་བྱ་བ་རྣལ་འབྱོར་གྱི་རྒྱུད་དེའི་རྟོག་པ་བཞི་པར་རིགས་བཞི་ཡུམ་བཞི།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་པ་གསུངས་ཀྱང་ཚུལ་འདི་ལྟ་བུ་མ་གསུངས་པས་དེ་ཁ་བསྐང་།",
    "དཔལ་རྡོ་རྗེ་མཁའ་འགྲོའི་ལེའུ་དང་པོ་དང་བཅུ་གཉིས་པར་རིགས་བཞི་ཡུམ་བཞི་གསུངས་ཀྱང་།",
    "རབ་གནས་བྱས་ལ་སྲུང་བ་དཔུང་པ་གཡོན་ལ་གདགས།",
    "ལས་རྒྱས་པའི་ལྷ་ནི་རྣལ་འབྱོར་འོག་མ་རྣམས་ཀྱང་འདི་ལས་བསྒྲེས་ཏེ་ཤེས་པར་བྱའོ།",
    "ཧེ་རུ་ཀ་ཕྱག་བཅུ་དྲུག་པ་ནི་བརྟག་པ་གཉིས་པའི་ཕྱི་མའི་ལེའུ་ལྔ་པར་གསུངས་པ་དང་གཙོ་བོའི་ཕྱག་མཚན་མི་འདྲ།",
    "ཀུན་ཏུ་རྣམ་པར་སྤྲོ་བར་བྱ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་དབུས་གནས་པར།",
    "བདུད་བཞི་མཉམ་པར་མནན་པ་དང་།",
    "དེར་ཕྱག་རྒྱ་དང་སྔགས་བཏུ་བ་ལ་སོགས་པ་རྒྱས་པར་གསུངས་པ།",
    "འདིར་མ་གསུངས་པས་བསྡུས་ནས་གསལ་བར་སྟོན་པ་ཡིན་གསུང་ངོ།",
    "གཞུང་ལས་ཡིད་དང་རྗེས་སུ་ཞེས་པར་སྦྱར་ཏེ།",
    "ཧེ་རུ་ཀ་ལྷ་ཅུ་བདུན་དག་པ་ཡིན་གསུངས་ཏེ།",
    "དེ་ལས་བདུད་རྩིའི་རྒྱུན་བབས་པས་ཁ་ཟས་བདུད་རྩིར་གྱུར་ནས་མཐར་ཧཱུྃ་ཟླ་བ་དང་བཅས་པ་ཡང་ཞུ་ནས་ཐིམ་པར་བསམས་ན་ཁ་ཟས་བྱིན་གྱིས་བརླབ་པར་འགྱུར།",
    "ཚིག་དོན་ལ་ཅི་གསུང་ཞེས་པ་རྩ་བའི་རྒྱུད་ཀྱི་ལེའུ་བརྒྱད་པར་རོ།",
