    "འགྱུ་བ་རང་འགྱུ་སྟོང་དུ་འདུག་པ་འདི་ཀ་བསྒོམ་དུ་ཤེས་ན་རྟོགས་པ་འཆར་བ་ཡིན་ཏེ།",
    "སྒོམ་བྱུང་འདུག་གམ་མི་འདུག་བལྟ་དྲན་པས་བཟུང་དགོས་སམ་མི་དགོས་བལྟས་ལ་རྨི་ལམ་དུ་ཡང་སྒོམ་འབྲལ་མེད་མ་ཡེངས་པར་བྱའོ།",
    "དེ་ཡང་རང་སོ་ལ་ལྷན་ནེ་བཞག་ནས་སྐྱངས་པས་རྣམ་རྟོག་ཐམས་ཅད་ཞི་བས་སྟེ།",
    "ཅིར་སྣང་རང་སེམས་ཀྱི་རྣམ་འཕྲུལ་ཡིན།",
    "འཁོར་འདས་ཐམས་ཅད་ལ་དག་སྣང་འབའ་ཞིག་བསྒོམ་ཞིང་རང་སེམས་ཐུལ་བར་བྱེད་པའོ།",
    "དེ་ཡང་རང་སྣང་འཁྲུལ་པས་ཕྱི་རོལ་གྱི་སྡུག་བསྔལ་ཕྲ་རགས་ཉམས་སུ་མྱོང་བ་ཡིན་ཏེ།",
    "རང་སེམས་འདུལ་ཞིང་རང་སྣང་དག་པར་བྱ་བ་གལ་ཆེ་སྟེ།",
    "སེམས་འདི་ཡོངས་སུ་གྱུར་ཙ་ན།",
    "ད་ལྟ་མངོན་དུ་གྱུར་པའི་སྣང་བ་གང་འདུག་པ་དེ་ཕུལ་ལ།",
    "རྩོལ་བ་ཆེ་ལ་ཡོན་ཏན་ཆུང་བ་ཞིག་བྱེད་པར་འདུག་སྟེ།",
    "ཡང་འདི་སྒོམ་ཞེས་བློས་བྱས་ལ་སྒོམ་རྒྱུ་གཅིག་ཀྱང་མི་འདུག་པས་སྒོམ་གྱིས་སྟོང་ལ།",
    "འདི་མི་སྒོམ་ཞེས་སྤང་བྱའམ་དོར་བྱ་མི་འདུག་པས་ཝལ་གྱིས་སྟོང་པ་སྟེ།",
    "རང་སྣང་རང་ངོ་ཤེས་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ལ་འགག་པ་མེད།",
    "རང་སྟོང་ཡེ་སྟོང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "དུས་མཆོད་ཀྲི་གེ་མཛད་རྟོགས་པ་ལ་བོགས་མེད་ཙ་ན་གསོལ་བ་འདེབས།",
    "ཉེ་གནས་ཀྱི་ཚ་བ་། དྲང་བ་ཕྱག་ཏུ་བཞེས་པ་བྱུང་འདུག་སྟེ།",
    "འདི་ལྟར་ཡིན་བྱ་བ་མི་འདུག་ལམ་དུ་འཁྱེར་ལུགས་གཅིག་ཡོང་ངོ་ཞེས་སྙམ་ནས།",
    "ད་ལྟ་ཡང་སྐུ་ཁམས་ནམ་བཟང་ཙ་ན་འོང་གསུང་།",
    "དེའི་འཕྲོ་ལ་མནལ་ཨཱ་། སད་ཙ་ན།",
    "དེ་ཡང་རང་དང་ལྷ་འདྲེ་གཉིས་ཀ་ལ་རྟག་བརྟན་ཐེར་ཟུག་མི་འགྱུར་བའི་དངོས་པོ་ཅན་ཞིག་མེད་པས།",
    "སྡུག་བསྔལ་གྱི་རང་བཞིན་དུ་འདུག་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལ་གནས།",
    "དེ་ཡང་རང་ལ་ལྷ་འདྲེའི་གནོད་པ་ཡོད་ན།",
    "དེ་ཉིད་ཀྱི་ངོ་བོ་གསལ་སྟོང་བློ་བྲལ་དུ་རྗེན་ལྷང་ངེ་འདུག་སྟེ།",
    "རང་ཞི་ཙ་ན་བདུད་ཀྱང་ཞི་བ་ཡིན་རང་གནས་ཙ་ན་བདུད་ཀྱང་གནས།",
    "ཞེས་པ་ལ་སོགས་པ་གསལ་བར་འདུག་སྟེ།",
    "ལྷའི་ང་རྒྱལ་བརྟན་པོ་ཡིས་འདུག་སྟེ།",
    "གང་རུང་རུང་ལ་བྱས་ན་རང་ལ་གཟན་པར་འདུག་དམ་སེལ་ལམ་སྡིག་སྒྲིབ་འཆལ་བའི་སྐྱོན་ཡོད་པ་ལ་བྱས་ན།",
    "སྤྱན་སྔ་ནས་ཕྱག་ལེན་འགའ་མཛད་པར་འདུག་པ།",
    "འཛག་པའི་གེགས་འདི་ཡོང་བར་འདུག་སྟེ།",
    "ཉན་ཙ་ན་རྣ་བར་ཉན་པ་དེ་ལ་བསྒོམས་ཙ་ན་གཡུ་ཏོ་མི་འདུག་གསུང་།",
    "མཐོ་གང་ཙམ་ཕྱུར་ཡོད་པ་ལ་རིག་པ་གཏད་དམིགས་པ་འདི་གཉིས་ཀ་འདྲེན་འཕར་ཆེ་བས་ཆུན་ཆེ་བར་འཇུག་འཛག་པ་དྲུག་ཀ་བསྲུང་བར་འདུག་རྨི་ལམ་དུ་འཛག་ན་གཉིད་ལོག་ཁར་ཡང་མང་དུ་བསྒོམ།",
    "གྱད་ཀྱི་འདུག་སྟངས།",
    "ལན་གཉིས་གསུམ་གྱིས་གཟེར་བཏབ་པ་བཞིན་འགྲོ་བ་འདུག་སྟེ།",
    "རྩ་ཁ་ཕྱེས་ཏེ་ཆུ་བཞིན་འཛག་པ་ལའང་འཕྲལ་ལ་ཁེགས་པར་འདུག་ཟླ་བ་ཕྱེད་ཀྱིས་བར་ལ་བསྟེན།",
    "གྲོགས་ལ་སོགས་པ་དང་རང་ལ་གནོད་པ་བྱེད་པའི་དགྲ་དང་།",
    "བཟློག་བསྒོམ་དུ་བྱས་ཏེ་རྐྱེན་དང་རང་ཐོག་ཏུ་རོ་སྙོམས་པའོ།",
    "ཟས་ནོར་ལ་སོགས་སྟེར་བ་བྱུང་བ་ལ་དགའ་སྤྲོ་སྐྱེ་ཞིང་དོན་གང་ཆེ་བ་གཏོང་བའི་བློ་མི་འདུག་ན།",
    "སྡོམ་པ་སྐྱེལ་ལམ་ཆ་མི་འདུག་པས།",
    "བཙལ་ཡང་མི་རྙེད་ཙ་ན་རྙེད་པ་སྒྲུབ་པའི་བློ་མི་ཡོང་བས།",
    "ནོར་རྫས་བསགས་པས་སོག་པ་མི་འདུག་ཅིང་།",
    "དམ་དུམ་འདུག་པ་འདི་ཡང་སུས་འདོད་པ་ཁྱེར་ཅི་དགའ་བ་བཟར་མེད་བགོར་མེད་ཐོང་བགྱིས།",
    "དོན་སྤྱི་མ་ནོར་བར་གོ་བའི་མཁས་པ་འདུག་གམ་མི་འདུག་ལྟ།",
    "ཕྲ་མ་བརྒྱད་དང་ངག་འཁྱལ་སྨྲས་པ་ལ་གྲངས་མི་འདུག་པས།",
    "འདི་ཕྱི་གཏན་དུ་བདེ་སྐྱིད་ཡོད་པ་ཞིག་འགྲུབ་པར་འདུག་པས་གོ་བཅད་སྙམ་དུ་བསམ།",
    "དགེ་སྦྱོར་འཆག་ཅིང་གཡེང་བར་འདུག་རྐང་འོག་དང་།",
    "ཐམས་ཅད་ཕྱུག་པོ་བྱ་སྙམ་པ་ལས་དབུལ་པོ་བྱ་སྙམ་པ་སུ་ཡང་མེད་པས་ཚོང་དང་སོ་ནམ་ལ་འབུངས་ཀྱང་ལྟོ་རྒྱགས་མི་འབྱོངས་པར་འདུག་ཅིང་།",
    "ཕྱུག་པོ་བས་དབུལ་པོ་འབུམ་འགྱུར་གྱྀས་མང་བར་འདུག་གལ་ཏེ་གསོག་ཀྱང་བོར་སྟོར་ཆུད་ཟོས་དང་སུས་འཕྲོག་ཆ་མི་འདུག་ནོར་ཕྱིར་རྩྭ་ར་འཚན་ཆུ་དང་སྲོག་དང་ནམ་བྲལ་མི་ཤེས་པར་འདུག་འཕྲལ་དུ་ཁ་ཆེ་སེར་སྣས་དགེ་ཕྱོགས་སུ་ཟན་རྡོག་གཅིག་ཡང་སྟེར་མི་ནུས་པར་ཕྱི་མ་ཡི་དྭགས་ལ་སོགས་པར་སྐྱེ་དགོས་པས་ནོར་གྱིས་དགོས་པ་མེད།",
    "ངས་ལུས་ཀྱི་སྦྱིན་པ་སྲོག་གཏོང་བ་ནི་མི་ནུས་པར་འདུག་ཀྱང་།",
    "སེམས་ཀྱི་དུ་ཁ་འདི་བཅོས་པས་ཆོག་པ་ཞིག་ཡིན་ན་ནི་དུ་ཁ་བྱ་མི་དགོས་པར་འདུག་སྟེ།",
    "དེ་ལ་མི་དགའ་བ་སྐྱེས་ན་ཇི་ལྟར་སྐྱོན་བརྗོད་པ་དེ་ཁ་ནང་དུ་ལོག་ལ་རང་ལ་འདུག་གམ་བལྟས་ལ།",
    "དེ་འདུག་ན་རང་སྐྱོན་མེད་པར་ཁོ་པས་བརྗོད་པ་མིན།",
    "རྐྱེན་བྱུང་ཙ་ན་དེ་ཐོག་ཏུ་རོ་སྙོམས་པ་དྲན་པའི་དགོས་པ་ཡོད།",
    "རང་རང་རིགས་ཀྱི་མཁའ་འགྲོ་སྣ་ཚོགས་ཀྱིས།",
    "རང་རང་ཡོད་པ་ཉིད་ཡིན་ཏེ།",
