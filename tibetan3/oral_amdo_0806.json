    "ཟུང་འཇུག་གི་ཡ་གཅིག་ཡིན་གྱིས་ཟུང་འཇུག་མིན་ནོ།",
    "ཕྱི་མ་ཡོད་དུས་སྔ་མ་མེད་པས་རེས་འཇོག་ཏུ་གྱུར་པའི་ཕྱིར་ཟུང་འཇུག་མེད་དོ།",
    "གང་གི་ཚེ་ལྷན་ཅིག་སྐྱེས་པའི་བདེ་བ་དང་བདག་མེད་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་སྟོང་པ་གཉིས་རོ་གཅིག་ཏུ་ཞུགས་པའི་འོད་གསལ་ཐོབ་པ་ལས།",
    "དེ་གཉིས་ཀྱང་ངོ་བོ་དབྱེར་མེད་པའི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་དུ་གྱུར་པས་ཟུང་འཇུག་གི་གོ་འཕང་ཞེས་བྱ་སྟེ།",
    "དེ་ཡང་ལྷ་མོར་སྣང་བའི་རིག་མ་དང་ཁ་སྦྱོར་བའི་རྣམ་པར་སྣང་བའི་ལུས་དང་།",
    "ཡང་གི་སྒྲས་ནི་སྔ་མ་ལ་ལྷན་སྐྱེས་ཀྱི་བདེ་བ་ཡོད་པར་མ་ཟད།",
    "ཟུང་འཇུག་གི་གོ་བ་སྐྱེད་དགོས་དེའི་གོ་བ་སྐྱེད་ཚུལ་ནི།",
    "སྟོང་པ་ཉིད་གཉིས་རོ་གཅིག་ཏུ་ཞུགས་པའི་འོད་གསལ་ཐམས་ཅད་སྟོང་པ་གཉིས་ངོ་བོ་དབྱེར་མེད་པའི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཟུང་འཇུག་གི་གོ་འཕང་མངོན་དུ་བྱེད་དེ།",
    "དེ་དང་མཉམ་པ་སྟེ་རོ་གཅིག་ཏུ་ཞུགས་པས་རང་གི་སེམས་གཟོད་མ་ནས་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དང་།",
    "ས་ཆེན་པོ་ལ་ཞུགས་པའི་རྒྱལ་སྲས་རྣམས་ཀྱི་མིག་གི་སྤྱོད་ཡུལ་ཙམ་ཡིན་པའི་ཕྱིར་རོ།",
    "འབྲས་བུ་ཟུང་འཇུག་རྡོ་རྗེ་འཆང་གི་སྐུ་མངོན་དུ་འགྱུར་བའི་སྐལ་བ་ཅན་དུ་བྱས་སོ།",
    "གསུམ་པ་དཀྱིལ་འཁོར་གྱི་མཇུག་གི་ཆོ་ག་ལ་གཉིས།",
    "ཉེ་བར་བསྡུ་བའི་ཆོ་ག་དང་ཚོན་དང་ཕུར་བུ་སོགས་སྡུད་པའི་ཆོ་གའོ།",
    "ཆོ་གའི་ཆད་ལྷག་གི་ཉེས་པ་ཞི་བའི་ཕྱིར་དུ་ཞི་བ་དང་།",
    "རང་གིས་དཀྱིལ་འཁོར་མཆོད་ཅིང་ཐམས་ཅད་ཀྱིས་ནུས་པ་ཅི་ཡོད་པས་མཆོད་ཅིག་ཅེས་བསྒོ་ལ།",
    "དེ་དག་དང་ལྷན་ཅིག་ཏུ་མཚན་མོ་མི་ཉལ་བར་གླུ་གར་ལ་སོགས་པ་དང་།",
    "རང་གིས་ཕྱི་རོལ་ཏུ་ཕྱོགས་ཀྱི་མཆོད་གཏོར་བྱས་ཏེ།",
    "དཀྱིལ་འཁོར་ལན་གསུམ་བསྐོར་ཏེ་ཤར་སྒོར་གཙོ་བོ་ལ་ཕྱོགས་པས་འདུག་ནས་ཆད་ལྷག་གི་ཉེས་པ་ཞི་བའི་དོན་དུ་ཡི་གེ་བརྒྱ་པ་ལན་གསུམ་བརྗོད་དོ།",
    "མགོན་ཁྱོད་དེ་ཀུན་བཟོད་པར་གསོལ།",
    "རང་གི་གནས་གཤེགས་བཛྲ་མུཞེས་བརྗོད་ལ་ཡེ་ཤེས་པ་གཤེགས།",
    "རང་གིས་སྤྲུལ་པའི་དམ་ཚིག་པ་རྣམས་རང་གི་ཕུང་པོ་དང་ཁམས་དང་མིག་ལ་སོགས་པ་དང་།",
    "སྣོད་གཞལ་ཡས་ཁང་གི་རང་བཞིན་དུ་བལྟའོ།",
    "མཚན་མོ་སྔར་ལྟར་ཉེར་བསྡུ་བྱས་པའི་ནང་བར་སྔ་བའི་དུས་སུ།",
    "དེ་ནས་རྡོ་རྗེས་ཤར་སྒོ་ནས་བརྩམས་ཏེ་ཚངས་ཐིག་གི་ལམ་ནས་གཙོ་བོའི་གནས་ཀྱི་བར་དབྱི་ཞིང་།",
    "རང་གི་མགོར་རྡུལ་ཚོན་ཅུང་ཟད་ཙམ་བླུགས་ནས་པདྨ་ལ་སོགས་པ་དབྱིའོ།",
    "དེ་ནས་ལག་པར་གནས་པའི་རྡོ་རྗེའི་རྩེ་མོས་སྒོ་རྣམས་དང་ཟུར་རྣམས་གཞིག་རྡུལ་ཚོན་ལྷག་མ་རྣམས་ལེགས་པར་ཕྱགས་ཏེ་ཞི་བ་ལ་སོགས་པ་དོན་དུ་གཉེར་བ་ལ་ཅུང་ཟད་བྱིན་ནས།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་བཀུར་སྟི་ཆེན་པོས་འོག་གི་གཞིར་ཁྱེར་བར་བསམ་མོ།",
    "དེ་ནས་རང་ཁམས་གསུམ་རྣམ་རྒྱལ་གྱི་ང་རྒྱལ་འཆང་བས་གཡོན་བརྐྱང་གིས་གནས་ཤིང་།",
    "རྡོར་དྲིལ་བཟུང་བའི་ལག་པ་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཛུབ་མོ་ལྕགས་ཀྱུ་བཞིན་བྱས་ཏེ།",
    "གླུ་གར་རོལ་མོ་དང་བཅས་པས་གཏོར་མ་བཏང་ལ།",
    "དེའི་དུས་སུ་ཁས་བླངས་པའི་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་སྡོམ་པ་དང་དམ་ཚིག་རྣམས་ལེགས་པར་ཤེས་ནས་ཚུལ་བཞིན་དུ་བསྲུང་ཞིང་།",
    "དེའི་ཐུགས་བསྐུལ་བའི་བཟླས་པས་རྡོ་རྗེ་སེམས་དཔའ་མཉེས་པར་བྱས་པ་ཞིག་གིས།",
    "གཞུང་གིས་མེད་མི་རུང་རྣམས་ཁ་བསྐངས་པ།",
    "ཚུལ་འདིར་རིང་དུ་འབད་ནས་རབ་སྦྱར་མོད།",
    "གཞུང་གི་དོན་དངོས་གཏན་ལ་དབབ་པ།",
    "ཡོངས་སུ་རྫོགས་པ་མཇུག་གི་དོན་དང་གསུམ།",
    "གཉིས་པ་ལ་གང་གིས་སྒྲུབ་པ་རྟེན་གྱི་གང་ཟག་གང་དུ་བསྒྲུབ་པ་གནས་ཀྱི་དེ་ཉིད།",
    "གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ནི་དཔལ་ཏེ་དེ་ཉིད་རང་གི་ངོ་བོར་ལྡན་པ།",
    "དེའང་རྩེ་མོ་ལས།",
    "རེ་ཞིག་དམ་ཚིག་ཉམས་པ་ལ།",
    "དངོས་གྲུབ་ཐོབ་པ་ལྟ་ཞོག་གི།",
    "དམ་ཚིག་དང་སྡོམ་པ་ཚུལ་བཞིན་བསྲུང་བ་དང་གསུམ་པོ་འདི་མེད་མི་རུང་གི་སྔོན་འགྲོའི་མཆོག་ཡིན་པས།",
    "མཇུག་གི་བྱ་བའོ།",
    "འཕགས་ལུགས་ལ་ཚོགས་ཞིང་དང་བདུན་རྣམ་དག་གི་གསལ་ཁ་ཆེར་མི་སྣང་ཡང་།",
    "དེ་དག་གི་དོན་ལ་གསུམ་སྟེ།",
    "གང་གི་མདུན་དུ་ཚོགས་གསོག་པའི་ཡུལ་ཚོགས་ཞིང་སྤྱན་འདྲེན་པ།",
    "དེའི་འོད་ཟེར་གྱིས་ཚོགས་ཞིང་གསལ་བར་བྱས་པ་དང་འོད་ཟེར་གྱི་སྣེ་མོར་ཚོགས་ཞིང་སྤྲུལ་པ་དང་།",
    "གཟུགས་ནས་རེག་བྱའི་བར་སྐྱེ་མཆེད་ལྔ་ནི་གཟུགས་རྡོ་རྗེ་མ་སོགས་ལྔ་དང་།",
    "དེ་བཞིན་དུ་ཉེས་པ་ནི་ང་རྒྱལ་ཏེ་སྤྱི་མིང་བྱེ་བྲག་ལ་ཞུགས་པ་ང་རྒྱལ་ལ་ཉེས་པ་དང་སྒྲིབ་པའི་མིང་གིས་བཏགས་པ་མང་དུ་འབྱུང་ངོ།",
    "སྒྲོལ་མ་ལ་བཛྲ་ར་ཏི་ཞེས་སོགས་ཡུམ་བཞི་རང་གི་ཡབ་ལ་དགའ་བ་ཞེས་འབྱུང་ཞིང་།",
    "རིག་པ་ནི་ལྷ་མོ་སྟེ་རང་རང་གི་ཡུམ་མོ།",
    "སེམས་ནི་མི་བསྐྱོད་པ་དེའི་རྗེས་སུ་ཐོགས་པ་སྟེ་མི་བསྐྱོད་པའི་རྗེས་སུ་འབྲངས་པ་སྟེང་འོག་གི་ཁྲོ་བོ་གཉིས་དེའི་རིགས་ཅན་ནོ།",
    "སྒྲིབ་པ་ནི་ང་རྒྱལ་ཏེ་རིན་འབྱུང་གི་རིགས་ཅན་འདོད་རྒྱལ་ཞེས་སོགས་སོ།",
    "གང་གི་མདུན་དུ་ན།",
    "ཁ་ཅིག་ཐོག་མའི་བློ་ཀ་གཉིས་ནི་བྱང་སེམས་ཀྱི་སྡོམ་པ་འཛིན་པ་ཡིན་ཞེས་པ་ནི་ལམ་ཐུན་མོང་བ་ལ་གོ་བ་མ་ཆགས་པ་ཡིན་ཏེ།",
    "མན་སྙེ་ལས་དེ་དག་གི་དོན་མངོན་དུ་བྱེད་ཅིང་བཀླག་པར་བྱའོ།",
    "དེ་དག་གི་དོན་རྣམས་ཡིད་ལ་ལེགས་པར་ཤར་བའི་རྣམ་པ་ཅན་གྱི་ཚིག་སྤྱི་ཙམ་དུ་མ་སོང་བར་བྱའོ།",
    "གཞུང་འདི་དག་གིས་ནི་རྩིབས་བཅུ་པའི་འཁོར་ལོ་དང་དེའི་དབུས་སུ་རྡོ་རྗེ་འཆང་དང་དེ་སེམས་དཔའ་སུམ་རྩེག་ཏུ་བྱེད་པ་རྣམས་བསྟན་པ་ཡིན་ལ།",
    "དེ་དག་གི་ཁུངས་སུ་ལེའུ་གསུམ་པ་དང་བཅོ་ལྔ་པའི་རྒྱུད་ཚན་གཉིས་དྲངས་ལ།",
    "ཕྱུང་བའང་རང་གི་སྐུ་ལས་ཡིན་པས་ཕྱི་རོལ་ཏུ་བསྐྱེད་པ་མིན་ནོ།",
    "དེ་དག་ནི་ཁུངས་དགོད་པ་སྟེ་གཞུང་གི་དོན་ལ་དང་པོར་བཀའི་འཁོར་ལོའི་གཙོ་བོ་བསྐྱེད་པའི་དེ་ཉིད་ནི་སྟོང་པའི་ངང་ལས་ཞེས་སོགས་ཏེ།",
    "འཁོར་ལོའི་ལྟེ་བ་ཁོང་སྟོང་དང་དེའི་སྟེང་འོག་གི་ཆ་གཉིས་རྩིབས་གཉིས་སུ་བྱས་ནས་དེའི་ནང་དུ་ཁྲོ་བོ་དགོད་པ་དང་རྩིབས་བརྒྱད་ལྟེ་བ་ལ་ཟུག་པའི་རྩིབས་སྟེང་དུ་མ་རེག་པར་ཁྲོ་བོ་བཀོད་པའི་ཚུལ་འདི་ནི་ཨ་བྷ་ཡའི་ལུགས་ཡིན་པས་འདི་རྣམས་ཞིབ་པར་ངག་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ནས་སྲུང་འཁོར་གྱི་གཙོ་བོས་གནོད་མཛེས་ལ་གཟིགས་པ་ནི་འཕགས་སྐོར་བ་རྣམས་བཞེད་ལ།",
    "དེ་ནས་གཙོ་བོས་བྱང་གི་ཁྲོ་བོ་ལ་གཟིགས་པས་དེ་ལས་ཁྲོ་བོ་རྡོ་རྗེ་ཕུར་བུ་སྟོད་བདུད་རྩི་འཁྱིལ་པ་དང་།",
    "བཛྲ་དྷ་ར་ཨ་ཛྙཱ་པ་ཡ་ནི་རྡོ་རྗེ་འཆང་གི་བཀའ་ཉོན་ཅིག་ཅེས་པ་སྟེ།",
    "ཡིད་དང་འདྲེས་ངེས་པ་རེ་བྱ་ཞིང་།",
    "འབྲས་བུའི་རྣམ་པ་དང་མཐུན་པར་བསྒོམས་ནས་བགྲོད་པའི་ཕྱིར་ཏེ་མོས་པ་ལམ་དུ་བྱེད་པའི་དོན་ཡང་དེ་ཡིན་ནོ།",
    "སྤྱི་དོན་ལ་སྔགས་མཚན་ཉིད་གཉིས་ཀྱི་སྤྱིར་འགྲོ་བ་དང་བསྐྱེད་རྫོགས་གཉིས་ཀྱི་ཐུན་མོང་དུ་འགྲོ་བའི་ཚུལ་གཉིས་ཡོད་དོ།",
    "མཆོག་གི་སྣང་ཞེན་སྐྱེ་བ་ལ་ཐ་མལ་གྱི་སྣང་ཞེན་སྡུད་པ་ངེས་པར་དགོས་པའི་ཕྱིར་ཏེ།",
    "ཡིད་ཤེས་གཅིག་གི་ངོ་ན་དེ་གཉིས་འདུ་བར་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེ་གཉིས་ཆུ་ལ་ཆུ་བཞག་པ་བཞིན་དབྱེར་མི་ཕྱེད་པར་སོང་བ་ནི་བཛྲའི་དོན་ཡིན་པས་དེ་ལྟར་སོང་བར་མོས་ནས་རིང་དུ་མཉམ་པར་བཞག་པ་དགོས་ཀྱི།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྲུང་འཁོར་འོད་གསལ་དུ་བསྡུས་ཀྱང་།",
    "གཞལ་ཡས་ཁང་འབྲི་བའི་ཚེ་མེ་རི་དང་རྡོ་རའི་ནང་དུ་ཆུད་པ་དགོས་པ་ཀླུ་བྱང་གིས་གསུངས་ཤིང་།",
    "སྐད་ཅིག་གིས་འདྲེས་པར་བསྒོམས་པས་ཆོག་གོ།",
    "དེའི་ཕྱོགས་བཞིའི་ངོས་ལ་རྡོ་རྗེའི་རྭ་ལྔ་རེ་ལྔ་རེའི་ཉི་ཤུ་དང་གསུམ་གསུམ་བཅུ་གཉིས་གང་རུང་སྟེ།",
    "དེ་ལྟར་ཚུལ་གཉིས་དང་གཞན་ཡང་ཟུག་མཚམས་རིང་ཐུང་ཞེང་ཚད་བྱ་ཚུལ་ལ་སོགས་པ་ཐིག་གི་སྒོ་ནས་ཞིབ་ཏུ་ཤེས་དགོས་ཏེ།",
    "དེ་རྣམས་སྣོད་འཇིག་འཆགས་དང་སྦྱར་བ་ཡིན་པར་ཀླུ་བྱང་གིས་གསུངས་སོ།",
    "དཔག་ཚད་བྱེ་བའི་ཁྱོན་ཙམ་དུ།",
    "སྐབས་འདིར་ཧཱུྃ་གཅིག་པུ་ལས་གཞལ་ཡས་ཁང་ཡོངས་སུ་རྫོགས་པར་གཅིག་ཅར་དུ་གྲུབ་པར་མོས་པ་ཡིན་ལ།",
    "དེའང་ཕྱོགས་རེ་རེ་བཞི་བཞི་དང་གཉིས་གཉིས་བྱེད་པའི་ལུགས་གཉིས་སོ།",
    "རྩིག་པའི་རྩ་བ་ནས་འདོད་སྣམ་ལ་ལྷ་མོ་སྣ་ཚོགས་ཤིན་ཏུ་མང་བར་གནས་པས་བཅུ་དྲུག་གི་ངེས་པ་མེད་ཅིང་།",
    "གར་གྱི་ལྷ་མོ་བཞུགས་པས་གར་གྱི་སྣམ་བུ་ཞེས་ཀྱང་བྱའོ།",
    "རྟ་བབས་ཀྱི་ཀ་བ་ལ་འཕགས་ལམ་ཡན་ལག་བརྒྱད་ཀྱི་དག་པ་སྦྱར་བས་ཕྱོགས་རེ་རེ་གཉིས་གཉིས་ཡིན་གསུངས་པ་མ་ངེས་ཏེ།",
    "དེ་ལ་ནི་དེ་དག་གི་དོན་སྤྱི་གསལ་བོར་ཆགས་པ་དགོས་པས་གཞལ་ཡས་ཁང་གི་རྣམ་གཞག་ཐིག་གི་སྒོ་ནས་ཤིན་ཏུ་ཞིབ་པར་ཤེས་པར་བྱ་ཡི་འདིར་ཅུང་ཟད་བརྗོད་པ་ཙམ་གྱིས་ནི་གོ་བར་མི་ནུས་པས་མ་སྤྲོས་པ་ཡིན་ནོ།",
    "བརྟེན་པ་རྗེས་སུ་བསྐྱེད་པ་དཀྱིལ་འཁོར་ཕལ་མོ་ཆེའི་ལུགས་སོ།",
    "འདིར་ལྷ་སོ་གཉིས་པོ་ཀུན་གྲུབ་པར་ལྷག་པར་མོས་པ་ཙམ་ལས་བསྐྱེད་པས་རྒྱུ་ཡི་གེ་སོགས་མི་བསྒོམ་སྟེ།",
    "དེས་ན་འདི་ལ་ལྷག་མོས་ཀྱི་དཀྱིལ་འཁོར་ཞེས་བྱའོ།",
    "རེག་བྱ་རྡོ་རྗེ་ཉིད་ཀྱང་ནི།",
    "གལ་ཏེ་ལྷག་མོས་ཀྱི་གཙོ་བོ་རྡོ་རྗེ་འཆང་ཡིན་ན་རྣམ་གཞག་རིམ་པར་མི་བསྐྱོད་པ་གསུངས་པ་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "ཞེས་གསུངས་པས་ལྷག་པར་མོས་པ་ཅན་གྱི་སེམས་ཀྱི་བདག་ཉིད་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཉིད་དུ་གྱུར་ནས།",
    "སློབ་དཔོན་ཀླུ་བྱང་གིས་ཀྱང་རྡོ་རྗེ་འཆང་དུ་བཞེད་མོད་ཀྱང་མི་བསྐྱོད་པར་གསུངས་པ་ནི།",
    "ཞེས་གསུངས་ཤིང་རྡོ་རྗེ་འཆང་ལ་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་མིང་གིས་བཏགས་པའང་ཡོད་པས་མི་འགལ་ལོ།",
    "ལྷ་མོ་རྣམས་ནི་དབུ་སྐྲའི་ཕྱེད་སྤྱི་བོར་བཅིངས་ཤིང་ཕྱེད་ཐུར་དུ་འཕྱང་བའོ།",
    "སེ་མོ་དོ།",
    "སེ་མོ་དོ་ནི་ནུ་མའི་བར་དུ་སླེབ་པ།",
    "ཕྱག་གདུབ་ལ་ཕྱག་གི་མཁྲིག་མ་ལ་གྱོན་པ་དང་དཔུང་པ་ལ་བཅིངས་པའི་རྒྱན་གཉིས་སོ།",
    "རང་གི་ལུས་ལ་དེ་རྣམས་གཟུད།",
    "ལྷག་མོས་ཀྱི་མཛད་པ་མི་གསལ་ཡང་།",
    "ལྷག་མོས་ལུས་ལ་སྡུད་པའི་སྐབས་སུ་ཁ་སྦྱོར་ཞེས་གསུངས་པའི་དོན་གཉིས་སུ་མེད་པར་སྦྱོར་བ་སྟེ་དབྱེར་མེད་དུ་བྱེད་པའི་དོན་ཡིན་ལ།",
    "དབྱེར་མེད་རྒྱུ་ནི་རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་དང་ལྷ་རྣམས་སོ།",
    "དེ་ལྟར་ན་རང་གི་གཟུགས་ཕུང་དང་རྣམ་སྣང་གཉིས་ཁ་སྦྱོར་བ་སྟེ་ངོ་བོ་དབྱེར་མེད་དུ་མོས་པ་དང་ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "རང་གི་ཕུང་པོ་དང་དབྱེར་མེད་པའི་དེ་བཞིན་གཤེགས་པའི་ཚོགས་བསད་ན་སྟེ་འོད་གསལ་དུ་བཅུག་ན།",
    "ཚོར་བའི་ཕུང་པོ་སྟེ་རིན་འབྱུང་གི་རིགས་ཅན་མཉམ་ཉིད་དེ་རིན་འབྱུང་།",
    "མཱ་མ་ཀཱི་དང་རེག་བྱ་རྡོ་རྗེ་མ་ནི་རིགས་གཉིས་འཛིན་ལ།",
    "འདིར་ལྷག་མོས་ཀྱི་ལྷ་ལུས་ལ་འགོད་པའི་ཚེའང་ལྷ་དེ་དག་རང་གི་ཕུང་ཁམས་དེ་དང་དེའི་ངོ་བོ་ཡིན་སྙམ་པའི་ངེས་པ་དང་།",
    "ཅེས་པ་ལྟར་གཙོ་བོའང་འོད་གསལ་དུ་བཅུག་ནས་གནས་ལུགས་ནམ་མཁའ་ལྟ་བུའི་ངང་ལ་མཉམ་པར་བཞག་ནས་བརྟན་བྱེད་ཀྱི་སྔགས་བརྗོད་པར་བྱ་སྟེ་རིམ་པ་དང་པོའི་སྐབས་སུ་འདི་རྣམས་མོས་པ་ཙམ་ཡིན་ལ།",
    "དེས་ཤའི་མིག་གི་ཡུལ་དུ་གྱུར་ནས་དེ་དག་གི་བྱ་བ་བསྒྲུབ་ནུས་པའི་སྐྱེ་བ་ལེན་པ་ནི་ལོངས་སྐུ་སྐྱེ་བ་ལེན་པའི་སྤྲུལ་པ་ཐ་མལ་པའི་མཐོང་བའི་ལམ་དུ་བསྟན་ནས་དེ་དག་གི་དོན་བསྒྲུབ་པ་དང་འདྲའོ།",
    "དངོས་སུ་གཞལ་ཡས་ཁང་གི་གདན་དབུས་མའི་སྟེང་དེར་རོ།",
    "འདིར་ནི་ཕུང་སོགས་འོད་གསལ་དུ་བཅུག་པའི་རྗེས་སུ་སྟོང་པའི་ངང་ལས་ཉི་མ་ལ་སོགས་རིམ་གྱིས་ལོངས་སྐུ་དང་པོའི་མགོན་པོར་བཞེངས་པ་ནི་བློས་མོས་པ་ཙམ་ཡིན་ལ།",
    "དེ་དག་གོམས་པས་འོད་གསལ་ཆེན་པོའི་མཐར་ཡང་སློབ་པའི་ཟུང་འཇུག་གི་སྐུར་ལྡང་བ་ཡིན་ནོ།",
    "འདིའང་ད་ལྟ་མོས་པ་ཡིད་བྱེད་ཀྱིས་གོམས་པར་བྱས་པས་རིམ་པ་གཉིས་པའི་སྐབས་སུ་ནི་དངོས་སུ་དེ་ལྟར་འགྱུར་བ་ཡིན་ནོ།",
    "ཁ་ཅིག་ལུས་ཀྱི་ཆ་རྣམས་གཞལ་ཡས་ཁང་གི་ཆ་དེའི་དོད་ཐུབ་ལྟ་བུར་བྱས་ནས་རྣམ་པ་མི་བསྒྱུར་བ་ཡོད་ཀྱང་།",
    "དེ་ལ་ལུས་ཀྱི་མདུན་ནི་གཞལ་ཡས་ཁང་གི་ཤར་ངོས་དང་།",
    "དེ་ལ་བརྟེན་ནས་ས་བོན་གྱི་ཡི་གེ་བསྒོམས་ནས་དེ་ལྷའི་ངོ་བོར་མོས་པ་ཙམ་བྱེད་པའི་ལུགས་ཡོད་ལ།",
    "རྒྱུད་གཞན་དག་གི་སྐབས་སུ་ལུས་ལ་ལྷའི་ས་བོན་བསྒོམས་པས་ལུས་དཀྱིལ་དུ་འགྲོ་བའི་སྐབས་ཡོད་ཀྱང་འདིར་ནི་དེས་མི་ཆོག་སྟེ།",
    "དེ་ལ་འདིར་ལུས་ཀྱི་དཀྱིལ་འཁོར་ཞེས་པ་ནི་ལུས་ཉིད་ཐུན་མོང་མ་ཡིན་པའི་རྒྱུར་གྱུར་པའི་ཚུལ་གྱིས་ལུས་ལས་བསྐྱེད་པའི་དཀྱིལ་འཁོར་ཡིན་པའི་ཕྱིར་ལུས་དཀྱིལ་ཞེས་བྱ་སྟེ།",
    "བསྐྱེད་པའི་ཤེས་པ་ལ་མིག་གི་ཤེས་པ་ཞེས་བརྗོད་པ་ལྟ་བུ་སྟེ།",
    "ཐུན་མོང་མ་ཡིན་རྒྱུ་ཡི་ཕྱིར།",
    "དེས་ན་རང་གི་གཟུགས་ཀྱི་ཕུང་པོ་དེ་ཉིད་ཡི་གེ་ཨོཾ་གྱི་རྣམ་པར་གྱུར་ནས་དེ་ཞུ་བ་ལས་རྣམ་སྣང་དུ་བསྐྱེད་པ་དང་དེའི་ཚེའང་རང་གི་གཟུགས་ཕུང་དང་དབྱེར་མེད་པར་གཟུགས་ཕུང་གི་ངོ་བོ་ཉིད་དུ་མོས་པའི་ང་རྒྱལ་རེ་རེ་བྱེད་པ་སྟེ།",
    "དེ་ལྟར་ན་གཟུགས་ཕུང་དུ་གྱུར་པའི་ལྷ་ཡིན་པ་དང་ལྷ་དེའི་ང་རྒྱལ་དང་རྣམ་པ་དྲན་པ་དང་གཟུགས་ཕུང་གི་ངོ་བོ་ཉིད་དུ་མོས་པ་གསུམ་ཆར་དང་ལྡན་པ་དགོས་སོ།",
    "རྣམ་སྣང་གི་སྐྱིལ་ཀྲུང་རང་གི་སྨིན་མཚམས་དང་གཙུག་ཏོར་རང་གི་སྤྱི་གཙུག་ཏུ་སླེབས་པ་དང་།",
    "དེ་བཞིན་དུ་འོད་དཔག་མེད་ཀྱི་གཙུག་ཏོར་རང་གི་སྐྲ་མཚམས་འོག་ཙམ་དང་སྐྱིལ་ཀྲུང་མགྲིན་པར་སླེབས་པ་སོགས་སོ།",
    "འདི་ལུས་དཀྱིལ་ཡིན་པས་རང་གི་ཕུང་པོས་བསྡུས་པ་དགོས་པའི་ཕྱིར་རོ།",
    "རྡོ་རྗེ་མ་ལྔ་སྐྱེ་མཆེད་ལྔ་ལས་བསྐྱེད་དགོས་པས་རང་གི་གཟུགས་སྒྲ་སོགས་ལས་བསྐྱེད་པར་བྱའོ།"
  ]
