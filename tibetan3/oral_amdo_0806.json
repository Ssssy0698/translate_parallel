    "རིམ་པ་གསུམ་པའི་སྣམ་བུ་ལ་ཤར་དུ་སྡོང་བུ་དང་བཅས་པའི་ཀླུ་ཤིང་གི་མེ་ཏོག་དཀར་པོ་འཁོར་ལོས་མཚན་པ་དང་འཁོར་ལོ་དཀར་པོ།",
    "མཚན་མ་ཐམས་ཅད་འོད་ཟེར་ཁ་དོག་ལྔས་བསྐོར་བ་རང་རང་གི་ཕྱོགས་སུ་མགོ་བསྟན་པ་སྟེ།",
    "གསུང་གི་རྣམ་འཕྲུལ་འཇིག་པའི་དུས་ཀྱི་འབྲུག་སྒྲ་སྒྲོགས་པ་ལྟ་བུར་སྔགས་འདོན་པ།",
    "གདུགས་དང་རྒྱལ་མཚན་དང་རོལ་མོའི་ཆ་བྱད་སྣ་ཚོགས་པས་དཀྱིལ་འཁོར་ལ་གཡས་བསྐོར་དུ་ལན་གསུམ་བསྐོར་ནས་དགོད་པར་བྱ་སྟེ།",
    "གཡོན་དུ་སྣང་བ་མཐའ་ཡས་དང་གོས་དཀར་མོ་དང་འཇམ་དཔལ་གྱིའོ།",
    "གཡོན་དུ་དོན་གྲུབ་དང་སྒྲོལ་མ་དང་ཀུན་བཟང་གིའོ།",
    "ལྷ་རེ་རེ་ལ་ཉེར་སྤྱོད་ཚང་བ་རེ།",
    "རེག་བྱ་རྡོ་རྗེ་མ་དང་གདམ་ངའོ།",
    "དཀྱིལ་འཁོར་སྒྲུབ་པའི་དུས་སུ་ནི་རེག་བྱ་རྡོ་རྗེ་མ་ཉིད་ཡུམ་དུ་བྱ་སྟེ།",
    "རྩ་རྒྱུད་ལས་མཱ་མ་ཀཱིའི་མཚན་མ་ལྷོ་ནུབ་ཏུ་དགོད་པར་གསུངས་པ་ལྟར་ཀླུ་བྱང་གིས་ཀྱང་གསུངས་ལ།",
    "ཀླུ་བྱང་གི་དཀྱིལ་ཆོག་ལྟར་བྱའོ།",
    "འོག་ཏུ་ཨོཾ་ཨཱ་ཧཱུྃ་ཧཱུྃ་གི་བར་སོ་གཉིས་དགོད།",
    "དེ་རྣམས་ཡོངས་སུ་གྱུར་པ་ལས་རང་རང་གི་མཚན་མ་བཀོད་པ་སོ་གཉིས་སུ་གྱུར།",
    "མཚན་སྔགས་ཀྱིས་ཕྱུང་ནས་རང་རང་གི་མཛད་པ་མཛད་པ་དང་།",
    "རང་རང་གི་ཡེ་ཤེས་པ་དང་གཅིག་ཏུ་གྱུར་ནས་མཆོག་ཏུ་དགའ་བའི་སྐུ་དང་ལྡན་པས།",
    "སླར་འབྱོན་པར་བཞེད་པའི་སྒོ་ནས་བཞུགས་པར་བསམ་མོ།",
    "གཙོ་བོ་ལ་སྒྲུབ་ཐབས་ལྟར་གྱི་ཡེ་ཤེས་སེམས་དཔའ་ལྷ་གཞན་རྣམས་ལ་རང་འདྲའི་ཡེ་ཤེས་སེམས་དཔའ་ཞལ་གཅིག་ཕྱག་གཉིས་པ་རེ།",
    "ཡེ་ཤེས་སེམས་དཔའ་རྣམས་ཀྱི་ཐུགས་ཀར་ཟླ་གདན་ལ་གནས་པའི་རང་རང་གི་ཕྱག་མཚན་གྱི་བུམ་པ་ལ་ཏིང་ངེ་འཛིན་སེམས་དཔའ་གཙོ་བོ་ལ་ཧཱུཾ།",
    "རྣམ་སྣང་ལ་ཨོ་ལ་སོགས་པ་སོ་སོའི་ས་བོན་འོད་ཟེར་གྱི་ཕུང་པོ་ཆེན་པོ་དང་བཅས་པ་རེ་བསྒོམ།",
    "མི་བཟད་བདུད་ཀྱི་དཔུང་གིས་ཕྱག་བྱས་པ།",
    "ཅེས་མེ་ཏོག་གི་གནས་སུ་ཉེར་སྤྱོད་ལྷག་མ་དང་རོལ་མོའི་མིང་གཞུག་ལ་ཉེར་སྤྱོད་དང་།",
    "རེག་བྱའི་རྡོ་རྗེ་མར་བཀུག་ནས།",
    "དེའི་ཚེ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་པར་མོས་ནས།",
    "རིག་མ་མཱ་མ་ཀཱིའམ་རེག་རྡོ་རྗེ་མར་སྐྱེད་དེ་སྙོམས་པར་ཞུགས་པའི་བདེ་བས་མཆོད་ཅིང་།",
    "གང་ཞིག་གཟུགས་དང་ཚོར་བ་ཞེས་སོགས་ཀྱིས་བསྟོད་དོ།",
    "དེ་ནས་གཙོ་བོའི་སྔགས་བརྒྱ་རྩ་བརྒྱད་དང་འཁོར་རྣམས་ལ་ཉེར་གཅིག་རེ།",
    "ཨུནྡྷད་ཨ་པསྣར་ཨོལྟ་ར་ག་ཨཱ་དི་བློ་བ་ལིཾ་ཏཱ་པ་ཡཱ་མི་གི་ཧཱི་ཏཱ།",
    "སྦྲ་ནཾ་ཙ་ནི་རུ་པ་ཏྲ་པཾ་ཀུཊྚན་ཏུ་སརྦ་བུད་དྷ་ཨ་དྷིཥྛ་ནེ་ན་ཨོཾ་ཨཱ་ཧཱུྃ་ཨི་དཾ་ཨ་མྲྀ་ཏ་པིཏྟཾ་བྷུཀ་ཏྭ་མ་མ་ས་པ་རི་ཝར་སྱ་ཤྲིནྟཾ་ཀུཊྚན་ཏུ་སཱསྟི་སཱཧཱ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གི་བདུད་རྩི་ཡི།",
    "དེ་ནས་ཉེ་རེག་བྱ་སྟེ་དེའི་ཚུལ་ནི་ལག་པ་དང་རྐང་པ་བཀྲུ།",
    "ཙོག་ཙོག་པུར་འདུག་ཅིང་སྨྲ་བ་བཅད་ལག་པ་གཉིས་པུས་མོའི་ནང་དུ་འོང་བ་བྱའོ།",
    "གཡས་པ་གན་རྐྱལ་དུ་གནས་པའི་གུང་མོ་དང་སྲིན་ལག་ཅུང་ཟད་བཀུག་སྟེ་ཁ་ལ་ཕྱོགས་པར་བཟུང་།",
    "གཡོན་པའི་མཐིལ་དུ་ཆུ་གཙང་བླུགས་པ་གཡས་པའི་སོར་མོས་བླངས་ཏེ།",
    "ལན་གཉིས་གསུམ་དུ་རྣ་བུག་གཉིས་དང་མིག་དག་དང་སྣ་དང་ཁ་དང་ལག་པ་དག་དང་ལྟེ་བ་དང་མགོ་ལ་རེག་པའི་རྗེས་སུ།",
    "ཕྱོགས་སྐྱོང་གི་སའི་གོང་བུའི་ཕྱི་ངོས་སུ་སའི་གོང་བུ་བརྒྱད་དམ།",
    "ཕྱི་རོལ་ཏུ་གཏོར་མ་ཟན་ལ་སོགས་པ་དང་མར་དང་སྦྲང་རྩི་དང་ཆུ་དང་འོ་མ་དང་ཆང་གི་རྒྱུན་ལྔ་གཡས་སྐོར་དུ་གཏོར་ཞིང་།",
    "གྲུབ་ན་ཆད་ལྷག་གི་ཉེས་པ་ཞི་བའི་ཕྱིར་དུ་ཞི་བ་དང་།",
    "རྡོ་རྗེ་ཤུགས་ཀྱི་འཇུག་པས་དཀྱིལ་འཁོར་དུ་ཞུགས་པར་མོས་ལ།",
    "ཁྲོ་བོའི་ལྟ་བས་བལྟ་ཞིང་དཀྱིལ་འཁོར་ལ་གཡས་སྐོར་བྱས་ནས་ནུབ་ཏུ་སོང་སྟེ།",
    "གཏོར་ཚོགས་གཏོར་མ་ཉེ་རེག་དང་།",
    "རང་གཙོ་བོ་ལས་ཕྱེ་སྟེ་ཤར་སྒོ་ནས་ཐོན་པར་མོས་ལ།",
    "དཀྱིལ་འཁོར་གྱི་མཇུག་གི་ཆོ་གའོ།",
    "ཉོན་མོངས་ཆུ་སྲིན་ན་ཀྲས་ཁྱབ།",
    "མི་ཤེས་ལིང་ཏོག་གིས་བསྒྲིབས་མིག།",
    "ཨོཾ་པྲ་བི་ཤ་བྷ་ག་ཝཱན་མཧཱ་སུ་ཁ་མོཀྵ་སུ་རཾ་སརྦ་སིང་དྷི་སུ་ཁ་པྲ་དཾ་པ་ར་མ་སུ་ཁ་ཨུད་ཏ་མ་སིང་རྒྱ་ཛཧཱུྃ་བཾ་ཧོ",
    "ཞེས་བརྗོད་དེ་རེ་ཞིག་དཀྱིལ་འཁོར་མི་མཐོང་བའི་དོན་དུ་གདོང་གཡོགས་བཅིང་།",
    "ཀྱེ་ཁྱོད་སུ་ཡིན་ཅི་ལ་དགའ།",
    "ཞེས་ལན་བཏབ་པས་རིགས་དང་མོས་པ་ཤེས་པར་བྱ།",
    "ལག་པ་ཐལ་མོ་སྦྱར་རྐང་པ་མཉམ་པར་འདུག་པ་ལ།",
    "དེང་ཁྱོད་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རློབ་པར་གྱུར་གྱི།",
    "ཁྱོད་ཀྱིས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གསང་བའི་དཀྱིལ་འཁོར་འདི།",
    "ཨཁཾ་བཱི་ར་ཧཱུཾ་གིས་སྒོམ་དོན་ལ་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཞུགས་པར་བསམ་ཞིང་དངོས་སུ་ཡོལ་བའི་ནང་དུ་གཞུག་ལ།",
    "ཞེས་བརྗོད་དེ་གཙོ་བོ་ལ་རྡོ་རྗེ་ཐལ་མོ་བརྐྱངས་ནས་ལུས་ཐམས་ཅད་ས་ལ་ཕབ་པའི་ཕྱག་བྱ།",
    "ཨོཾ་སརྦ་བུད་དྷ་པཱུ་ཛ་ཨུ་པ་སྦྲ་ནཱ་ཡ་ཨཱཏྨ་ནཾ་ནིརཱ་ཏ་ཡཱ་མི་སརྦ་ཏ་ཐཱ་ག་ཏ་བཛྲ་བེ་རོ་ཙ་ན་ཨ་དྷི་ཏིཥྛ་མཾ།",
