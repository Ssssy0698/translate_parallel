    "ངོ་བོ་ནི་དེ་ཡང་རང་བཞིན་ལུང་མ་བསྟན་ཏོ་ཞེས་བྱ་བ་སྟེ།",
    "ལས་ས་རང་རང་བཞིན་མེད་པའི་ཕྱིར་སྐྱེ་བ་མེད་དོ་ཞེས་བྱ་བའོ།",
    "གཞན་ཡང་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པས་སྐྱེ་འགག་ལ་སོགས་པའི་ཐ་སྙད་མི་འཐད་པར་བརྗོད་དོ།",
    "འདུ་བྱེད་ཕྲད་དང་རང་བཞིན་དང་།",
    "རང་རང་ནང་འཕྲད་ཚེ་བུ་བདུན་ཅུ་སྟེ།",
    "ལོ་ཟླ་ཞག་དུས་ཟད་ཚེ་རྡེལ་ནག་བོར།",
    "དེ་ལ་མན་ངག་ལོ་ཟླ་ཞག་དུས་བཞི།",
    "རིམ་བཞིན་ལོ་ཟླ་ཟླ་ཞག་ཞག་དུས་དང་།",
    "སྟག་དུས་ཟླ་གཅིག་བྱ་བྱིར་ཚེ་ལྷག་མེད། ཟན་གྲངས་རང་སྐྱེས་ལོ་ཟླ་ཞག་དུས་དང་།",
    "བླ་ཚེ་རོལ་པོ་ཁ་ནག་དུས་ཟླ་བ་གསུམ་པ་སུ་ཕྲོགས།",
    "བླ་ཚེ་འཁྱགས་པ་ཆགས་ཟླ་བ་བཅུ་གཅིག་པ་འཇིག་དུས་དེར་ཕྲོགས།",
    "མ་དང་རང་རབ་གྲོགས་དང་བུ་གཉིས་འབྲིང་།",
    "ལུག་དུས་བརྒྱད་ཏོག་གསེར་གསུམ་འབུམ་བཟང་སྤྱོད།",
    "སྟག་དུས་རྡོ་རྗེ་གཅོད་པ་བརྒྱ་ཚར་དང་།",
    "གཤེད་བཞི་རང་རང་ཐོག་ཏུ་སྐྱེས་པའི་རོ།",
    "བསྐོར་བའི་རོ་ཡི་འདུག་ས་གོམ་གང་ཚད།",
    "ལོ་མཚམས་ར་བཞི་གཤེད་བཞིའི་ཞག་དུས་སྤང་།",
    "ཞག་དུས་ནམ་ལངས་གསོན་པོ་དཔལ་བསྐྱེད་དུས།",
    "ཡོས་འབྲུག་དུས་ལ་ངན་ཞིང་དྲང་དགོས་ན།",
    "གཞན་ཡང་ལོ་ཟླ་ཞག་དུས་སྤར་སྨེ་དང་།",
    "བཏབ་སྟེ་དཔེར་ན་བྱ་སྤྲེལ་ལོ་པ་ཁམས་ལྕགས་ལོ་ཟླ་ཞག་དུས་སོགས་ལྕགས་ཐོག་ཏུ་སྐྱེས་ཤིང་ལྕགས་ཐོག་ཏུ་ཤི་བ་གསོན་པོ་ཡང་ལྕགས་ཁམས་མང་བ་ཞིག་མེ་ལ་བསྲེག་པ་ལྟ་བུ།",
    "སྐྱེ་བོ་རང་རང་གོས་རྒྱན་ལག་ཆའི་རིགས།",
    "རང་རང་ནང་ཕྲད་ལས་བྱུང་བུ་ཚ་དེའི།",
    "སྤྱིར་བསྟན་ལོ་ཟླ་ཞག་དུས་སྤར་སྨེ་དང་།",
    "སྨེ་བའི་ཟངས་རྐྱང་གཅིག་དུས་རོ་མི་དྲངས།",
    "དྲུག་དུས་གྲལ་དང་བདུན་དུས་བཤས་དམར་སྤང་།",
    "ཞག་དུས་གཅིག་ལ་བྱ་བར་མི་རུང་ངོ།",
    "ལོ་ཟླ་ཞག་དུས་སྤར་སྨེ་གཟའ་སྐར་དང་།",
    "བཞི་གཤེད་ལོ་སྐར་རང་རང་ནང་དུ་འགྲམས་།",
    "དེ་ཡི་ལོ་ཟླ་ཞག་དུས་ཤི་ན་འགྲམས།",
    "བརླ་གཡོན་སྐྱེར་རྩང་རང་འཐག་ཡ་ཁབ་མནན།",
    "དེ་ལྟ་ཟླ་ཞག་དུས་ཀྱི་འགྲམས་ཀུན་ལ།",
    "བྱི་བའི་ཟླ་ཞག་དུས་ལ་ཤི་བ་ན།",
    "ཀུན་ལ་ཐུབ་ཆོད་ཚིག་དང་ཐམས་ཅད་ལ་ལོ་ཟླ་བ་ཞག་དུས་ངན་པ་ལ་ཤི་བ་ཐུབ་བོ།",
    "གཤེད་བཞི་སྤར་ཁ་རང་རང་ཐོག་ཏུ་ཤི།",
    "རང་རང་ལོ་ཡི་ཐོད་པར་རང་སྤར་གྱི།",
    "རང་རང་ཕྱོགས་སུ་མནན་པས་ཉེས་པ་ཐུབ།",
    "གཞན་དུ་རང་རང་གཏོ་རྗེས་ཡངས་པ་ཡིན།",
    "འཕགས་པ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་བ་རྣམས་སོ།",
    "དེ་ཉིད་ཀྱང་རང་བཞིན་མེད་པའོ་ཞེས་གསུངས་སོ།",
    "དེ་ལ་ཐ་མལ་པའི་འགྲོ་བ་དང་འདུག་པ་ལ་སོགས་པའོ།",
    "སྙོམས་འཇུག་དུས་སུ་ལོང་མེད་འཛག་པ་དང་།",
    "དེ་སྙོམ་འཇུག་དུས་ལྕེ་འོག་བཅུག་པས་ཐིག་ལེ་འཛིན་པའོ།",
    "ཕ་དང་མ་ནི་བསད་བྱ་ཞིང་སོགས་འདུག་པས་བཀའ་མ་ཡིན་པར་འགྱུར་ཤས་ཆེའོ།",
    "ལུས་འདུག་པའི་ཕྱིར་རོ།",
    "ཚེ་འདིར་ཡང་རང་བཞིན་གྱི་བཟོད་པ་ལ་གནས་པ་དང་།",
    "འདི་ནི་གཞན་སྨིན་གྱི་དོན་བསྡུ་ཡིན་པར་འདོད་ཀྱང་རང་ལུགས་རང་སྨིན་ཚུལ་དགུ་དང་གཞན་སྨིན་ཚུལ་བརྒྱད་དེ།",
    "ནོར་བུ་ལེན་པའི་ཚོང་པ་རྣམས་རྒྱ་མཚོར་གྲུ་ཞིག་དུས་ཁྱེད་རྣམས་ངེད་ལ་འཇུས་ཤིག་རྒྱ་མཚོ་ལས་བསྒྲལ་བར་བྱའོ།",
    "སྦྱིན་པ་བཏང་བས་ནི་གཞན་དོན་དང་རང་དོན་གཉིས་ཀ་བྱེད་པས་གཉིས་ཀར་རྗེས་སུ་འཛིན་ཏེ།",
    "དེ་ལྟ་བུ་མ་ཡིན་ཀྱང་རང་དོན་འབའ་ཞིག་ཏུ་བསྔོ་ན་ཡིན་ནོ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་རྗེ་བཙུན་ཏཱ་ར་ནཱ་ཐ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྦྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "གསང་བ་གཙུག་ཏོར་ལྟེ་བ་ལ་ཡང་ལྷན་སྐྱེས་རྒྱལ་བའི་སྐུ་སྟེ་རང་བཞིན་མེད་དང་རང་བཞིན་ནོ།",
    "དམའ་བར་འདུག་སྨྲས་འདས་བཟླས་པ་ཡིས་ཡི་ མི་རྒྱན་ནམ་ནི་ནངས་བར་དུ།",
    "ཞེས་པ་སྡོམ་པ་ལེན་པའི་ཚུལ་སྟན་གཏན་དམའ་བ་ལ་འདུག།",
    "སྡོམ་པ་ཐོབ་ལ་མ་ཉམས་པ་ཤེས་པ་དང་རང་བཞིན་དུ་གནས་པའོ།",
    "དེ་ལ་ཡང་རང་རྒྱུད་ཀྱི་ཕུང་པོ་ལ་ཆགས་རྗེ་བཙུན་ཏཱ་ར་ནཱ་ཐ།",
    "རིགས་མཐོ་བས་ང་རྒྱལ་བ་དང་རྗེས་སུ་འབྲེལ་བར་གཞན་དམན་པ་དང་རང་ཉིད་མཆོག་ཏུ་འཛིན་པའི་སེམས་མཐོ་བ་དང་།",
    "བདག་ཏུ་འཛིན་པའི་འཛིན་སྟངས་ལ་འདུག་པ་མངོན་སུམ་མྱོང་བས་གྲུབ་པས།",
    "གཉེན་བཤེས་དགྲར་འགྱུར་བ་ལ་སོགས་པ་ངེས་པ་མེད་པ་སྣ་ཚོགས་ཉིད་དུ་འགྱུར་བ་མཆི་ཞིང་གདའ།",
    "སྐྱེ་བ་ལེན་པ་ཡང་རང་ཉིད་གཅིག་པུར་ལེན་པ་དང་།",
    "ལས་གསོག་པ་ཡང་རང་ཉིད་གཅིག་པུས་གསོག་པ་དང་།",
    "རྣམ་སྨིན་མྱོང་བ་ཡང་རང་ཉིད་གཅིག་པུས་མྱོང་བ་སྟེ།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "སྡུག་པའི་འང་ཐ་སྙད་མེད་ཟེར་པ་ཡོད་འདུག་ནའང་།",
    "དེ་བས་དམན་པ་རྣམས་རྗེས་སུ་འཇུག་པའི་རིམ་པ་སྒྲིགས་སུ་འཇུག་སྐབས་ལ་ལར་འདུག་པ་བཞིན་དོན་དུ་མཆོག་དམན་གྱི་དབྱེ་བས་ཡིན་པ་བཞིན།",
    "བཀའ་གང་གནང་བ་དེ་བཞིན་དུ་བགྱིད་ཅེས་བརྗོད་པར་བྱ་ཞིང་ལན་མེད་དུ་ཁོགས་འདུག་པ་མི་རུང་།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ཡང་ཉེས་པའི་དགྲ་ལས་རྒྱལ་བས་རྒྱལ་བའི་ཐ་སྙད་ཡོད་ཀྱང་།",
    "ཡང་ན་དེའི་སྔོན་པོའི་རྣམ་པ་འདུག་པས་སྔོན་པོ་ཡོད་དོ་ཞེས་རྗེས་སུ་དཔོག་པ་ཙམ་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "བསྒྲུབ་བྱ་ཐ་དད་རྗེས་དཔག་ཐུག་མེད་དུ་འགྱུར་བ་ནི་ཁྱེད་རང་ལྟར་ན་འདོད་པ་ཡིན་ཏེ།",
    "རང་བཞིན་དུ་གནས་པའི་མཚན་ཉིད་ཀྱིས་ཀྱང་རང་བཞིན་འདི་ཡིན་གྱི།",
    "སྔོན་པོ་སྣང་བ་ཡང་རང་སྣང་མཁན་གྱི་བློ་དང་ལྷན་ཅིག་དམིགས་པར་ངེས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་གཟུང་རྣམ་རིག་པའང་རང་རིག་ཏུ་བྱས་ནས་ཤེས་པ་ཐམས་ཅད་རང་རིག་ཏུ་སྒྲུབ་པ་ནི་མི་འཐད་དེ།",
    "བློ་རང་རིག་པ་ཡང་རང་ལུགས་སུ་ཁས་ལེན་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "ཕྱི་རོལ་གྱི་དོན་ཡོད་ཀྱང་རང་རིག་པ་ཇི་ལྟ་བ་བཞིན་དོན་འགྲུབ་པའི་ཕྱིར་དེ་ཉིད་འབྲས་བུར་རིགས་སོ།",
    "དོན་གྱི་རྣམ་པ་ཁྱད་པར་ཅན་ཤར་བ་ཉིད་ཀྱི་དོན་རིག་པ་དང་རང་རིག་པ་གཉིས་ཆར་འཇོག་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཐམས་ཅད་ཀྱང་རང་དང་རང་མིན་གཉིས་ཀ་ཡིན་པར་འགྱུར་བས་རང་དང་ཡང་དངོས་འགལ་དང་།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་སོགས་ལས་ཤུགས་ཀྱིས་དོན་གོ་ན།",
    "དེ་དག་ཀྱང་རང་བཞིན་ལ་སྦྱར་ན་རིམ་པ་ལྟར།",
    "ནུས་པ་ཐོགས་མེད་དུ་སྒྲུབ་པ་ཡང་རང་བཞིན་གྱི་རྟགས་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "རྒྱུ་ཚོགས་གྲངས་ཚང་ལས་འབྲས་བུ་འབྱུང་རུང་སྒྲུབ་པ་ཡང་རང་བཞིན་གྱི་རྟགས་ཆ་མཐུན་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "འོ་ན་བྱས་པའང་རང་བཞིན་གྱི་རྟགས་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེ་དག་ནི་རྣམ་པར་དཔྱད་ན་ཡང་རང་མཚན་ཁོ་ན་ཡིན་ཏེ།",
    "དགག་བྱ་མེད་པ་ནི་ཤེས་པ་མེད་པས་སྒྲུབ་པ་ལ་ཤེས་པ་དེ་མེད་པ་ཡང་རང་མ་རིག་པས་མི་དམིགས་པ་གཞན་གྱིས་སྒྲུབ་དགོས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཤེས་པ་རང་ཉིད་ཀྱིས་འགྲུབ་པ་ལྟར་ཤེས་པ་མེད་པ་ཡང་རང་ཉིད་ཀྱིས་འགྲུབ་པས་ཐུག་མེད་དུ་མི་འགྱུར་རོ་ཞེ་ན།",
    "རྒྱུ་ཡིན་པ་ཡང་རང་རྒྱུད་ཀྱི་ཡུལ་དུ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "དངོས་འབྲས་མ་དམིགས་པའི་རྟགས་ཀྱང་རང་བཞིན་མ་དམིགས་པའི་རྟགས་སུའདུས་ཏེ།",
    "གཞན་དུ་འདི་ནི་འདུག་པ་ན།",
    "རྣམ་འགྱུར་འཇིག་ཀྱང་རང་བཞིན་མི་འཇིག་པར་འདོད་པ་ནི་བཀག་ཟིན་ཅིང་འགོག་པར་འགྱུར་རོ།",
    "ཁྱེད་རང་ལྟར་ན་ཡང་།",
    "དེ་བཞིན་དུ་ཁྱེད་རང་ལྟར་ན།",
    "བློའི་སྤང་བྱ་སྤོང་བའི་ལྡོག་དུས་ལ་བྱ་བོ་དོང་པཎ་ཆེན་གྱི་གསུང་འབུམ་ལས།",
    "དེ་དག་ལ་ཡང་དོན་དང་བློའི་ལྡོག་དུས་གཉིས་ལས།",
    "ཕྲ་བའི་ལྡོག་དུས་སོ།",
    "བློའི་ལྡོག་དུས་ནི།",
    "ལྡོག་དུས་ལ་ཡང་སྐད་ཅིག་མ་གསུམ་པ་ལ་ལྡོག་ན་སྐད་ཅིག་མ་དང་པོ་ལྟ་བུ་ལ་ཡང་ཐོག་མ་དབུས་མཐའི་ཆ་མེད་ན་ནི་རགས་པའི་རྒྱུན་རྩོམ་པ་མེད་པར་འགྱུར་ལ།",
    "འོན་ཀྱང་རང་རྒྱུད་ཀྱི་རྟགས་ཡང་དག་ནི་གཞན་ཕྱོགས་སུན་འབྱིན་བྱེད་ཡིན་ཡང་སུན་འབྱིན་གྱི་སྒྲ་གཙོ་བོར་མི་བྱེད་པར་སྒྲུབ་བྱེད་ཀྱི་རྟགས་ཀྱི་སྒྲ་རབ་ཏུ་སྦྱོར་ལ།",
    "བྱས་པའི་ཕྱིར་ཞེས་རང་ལུགས་སྒྲུབ་པ་ཡང་རང་རྒྱུད་ཀྱི་རྟགས་སུ་བོ་དོང་པཎ་ཆེན་གྱི་གསུང་འབུམ་ལས།",
    "རང་བཞིན་དང་འགལ་བའི་ཁྱབ་བྱའི་འབྲས་བུ་དམིགས་པའི་རྟགས་ཞེས་བྱ་བ་ལོགས་སུ་འབྱེད་པ་ཁྱེད་རང་ཡང་མི་འདོད་པས་ནོར་བའི་ཕྱིར་རོ།",
    "བསྒྲུབ་བྱར་འདོད་པ་ཉིད་ཀྱིས་ཁོ་ན་དང་རང་ཉིད་ཀྱི་གཅད་བྱ་ཡང་བཅད་ལ།",
    "དེའི་དོན་དུ་ཡང་རང་ཉིད་ཀྱི་སྒྲ་སྦྱར་བ་མ་ཡིན་ནོ།",
    "འདོད་པས་ཀུན་ནས་བསླངས་ནས་བཟུང་བ་ཡང་འདོད་པས་བཟུང་བར་འདུག་པའི་ཕྱིར་རོ།",
    "བརྗོད་ན་ཡང་ཁྱེད་རང་ལྟར་ན།",
    "གྲུབ་བསལ་མ་ཞུགས་ཀྱང་རང་ཉིད་མི་འདོད་པ་ནི་རྩོད་པའི་སྐབས་ཀྱི་ཕྱོགས་སུ་འབྲེལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "ཁས་བླངས་དང་རང་ཚིག་སོགས་ཀྱི་ཁྱད་པར་དང་།",
    "དེ་ལ་ཡང་རང་ཚིག་དང་ལུང་ཚིག་ལས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཡང་རང་གཞུང་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བར་ཡང་གཞན་གཞུང་འཐད་ལྡན་དུ་བྱས་ནས་དེ་ཉིད་ལ་བསྙེགས་ནས་འདི་ཡང་རང་གཞུང་མ་ཡིན་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "ཁས་བླངས་དང་རང་ཚིག་གཉིས་སུ་ཕྱེ་བ་ན།",
    "དཔྱད་པས་དག་པའི་ཚུལ་འདི་ནི་མངོན་རྗེས་གཉིས་དང་རང་ཚིག་མི་འགལ་བར་མཐོང་བའི་ཤེས་རབ་ཅན་རྣམས་ཀྱིས་འགྲུབ་པ་ཡིན་ལ།",
    "བཀའ་འདི་རྣམས་ནི་བདེན་བཞི་བླང་དོར་ཐབས་དང་བཅས་པ་ལ་མི་བསླུ་བ་དང་རང་ཚིག་འགལ་བ་མེད་པའི་ཕྱིར།",
    "མཐའ་གཞན་བཀག་པ་དང་རང་བཞིན་ཁྱད་པར་མེད་པ་ལ་སོགས་པའི་རིགས་པས་འགྲུབ་པ་ཡིན་ནོ།",
    "རྟགས་ལ་ལྟོས་པའམ་མ་བལྟོས་ཀྱང་རང་མཚན་ཉིད་མི་སྣང་བ་ལྐོག་གྱུར་ངེས་པའི་དངོས་ཡུལ་དེ་ཡང་ནི་གཞན་སེལ་ཡིན་ཏེ།",
    "བུམ་དངོས་ཡིན་ནའང་རང་རྒྱུ་ལས་གྲུབ་ཟིན་པས་འཇིག་རྒྱུ་ཕྱིས་འབྱུང་མི་དགོས་ཤིང་།",
    "འོན་ཀྱང་རང་གཞན་གྱི་ངེས་པས་འདྲེན་པའི་སྟོབས་ལས་གཉིས་སུ་དབྱེ་བ་ཡིན་ནོ།",
    "རིམ་པ་དེས་ཆུ་དང་ས་དང་མེའི་དཀྱིལ་འཁོར་གྲུབ་པར་གྱུར་ཅིང་དེའི་དབུས་སུ་ཚངས་པའི་སྒོ་ང་ཆེན་པོ་འོད་འབར་ཞིང་གསལ་བ་ཞིག་གནས་པ་དེ་སྨིན་ཅིང་བརྡོལ་བ་ལས་འཇིག་རྟེན་གྱི་མེས་པོ་ཚངས་པ་ཆེན་པོ་པདྨའི་མངལ་ནས་བྱུང་བ་པདྨ་ལ་འདུག་པ་གདོང་བཞི་པ་ཞིག་བྱུང་སྟེ་དེས་འཇིག་རྟེན་ཐམས་ཅད་སྤྲུལ་པས་དེ་ལ་འཇིག་རྟེན་མེས་པོ་ཞེས་ཟེར་ཏེ།",
    "ལྷ་ཆེན་གྱིས་ཨུ་མའི་སྲུང་མ་ལ་དྲང་སྲོང་དེ་བཞག་པའི་ཚེ་དེ་ལ་ཨུ་མ་ཆགས་ནས་མདུན་དུ་འདུག་སྟེ།",
    "བེ་རོ་ཙ་ན་ལ་སོགས་པ་སད་མི་མི་བདུན་རབ་ཏུ་བྱུང་།",
    "པ་གོར་བེ་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་ཡེ་ཤེས་སྤྱན་དང་ལྡན།",
    "དེ་ཤིན་ཏུ་ཡིན་པ་འདུག་ཅེས་གསུངས།",
    "སྐལ་བར་ལྡན་རྣམས་རང་རང་བསམ་པ་དང་།",
    "མུ་གུ་ལུང་ན་འབྲོག་མི་ལོ་ཙཱ་པ་ཤཱཀྱ་ཡེ་ཤེས་བྱ་བ་ཤིན་ཏུ་མཁས་པ་ཞིག་ཡོད་འདུག་པས།"
  ]
