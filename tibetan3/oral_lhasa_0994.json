    "། མཎི་བསྒྲུབས་པས་འགྲུབ་རྟགས་སོགས་ཡམཚན་པ་མང་དུ་བྱུང་བས་ཕྱོགས་དེའི་སྐྱ་སེར་ཐམས་ཅད་དད་པའིསལ་འགོདཔར་མཛད་དོ།",
    "བུམ་པ་གཅིག་ཤརགྱི་སྐུ་འབུམ་གྱི་ནང་འཇམ་དབྱངས་ཀྱི་བཞུགས་ཁྲིའི་ཁར་ཚྭས་བསྒྲུབས།",
    "ན་དཔམས་འཇུག་པ་སོགས་བཀྲ་མི་ཤིས་བ་ཐམས་ཅད་ཞི་ནས་གང་ཕེབས་སར་ཆར་ཆུ་དུས་སུ་འབ་བ་ཅིང་ལོ་ཕྱུགས་ལེགས་པ་ལ་སོགས་པ་བདེབདེ་སྐྱིད་ཀྱི་དཔལ་ཕུན་སུམ་ཚོགས་པ་འབྱུད་ངས་ཐམས་ཅད་ཀྱིས་རྗེ་འདི་ཉི་དལ་ཐུགས་རྗེ་ཆེན་ས་ཀྱི་འདུ་ཤེས་སྐྱེད་པར་བྱེད་དོ།",
    "རྗེ་འདི་ལ་སྐུ་ཁམས་མ་བདེ་བ་ཆེན་པོ་ཞིག་བྱུང་བལ་སྐུ་རིམ་སོགས་གང་ཡངམ་མཛད་པར།",
    "དེར་ཁོ་ང་རྣམ་གཉིས་གསུང་གླེང་མང་བོ་མཛད་ཀྱིན་བཞུགས།",
    "ཐོག་མར་སྤེན་དཀར་ཐང་དུ་ཕེབས་ནས།",
    "རྟ་གཅིག་ཕུལ་པ་མ་བཞེས་པར་ཅོག་རྩེ་རྩེ་ཆུང་ངུ་ཞིག་འདྲུག་པདེ་བཞེས།",
    "དེ་ནས་ཡང་བྱོན་པ་ན་གནས་རི་མཐོབས་གཞནགཉིས་ནས་ཀྱང་ཕྱག་འབུལ་རིམ་བཞིན་གནང་བ་མཛད།",
    "དེ་ནས་གནས་རི་དང་ཉེ་བར་ཕེབས་པ་ནགནས་རིའི་ངོས་ནས་རྒོད་ཐང་དཀར་ཞིག་འཕུརཏེ་འོངས་ནས།",
    "གསུངས་པ་ཞིག་ཀྱང་བྱུང་གསུངས།",
    "ཞལ་བཀོད་ཀྱང་རྒྱས་པར་མཛད་དོ།",
    "ཁྱེད་ཀྱིས་བཀྲ་ཤིས་འཁྱིལ་དུ་རི་ཁྲོད་པ་རྣམས་ལ་ཁྲིད་གནང་ནལེགས་གསུངས་པས།",
    "དེ་ཡན་ཆད་རྗེ་འདི་བ་ལ་རི་ཁྲོད་པ་ཚོས་བྲིད་ཞུས་ཀྱང་ཆེར་མི་གནང་བར་ཁྱེད་ཚོསབསགས་སྦྱང་ལ་འབོད།",
    "བསགས་སྦྱང་ལ་འབད་ན་ཉམས་རྟོགས་དང་ང་མ་ཤུགས་ཀྱིས་སྐྱེ་གསུངས་ནས་ཁྲིད་ཆེ་རམི་གནང་བ་ལ།",
    "ལོ་དེ་ནས་བརྩམས་ཏེ་རི་ཁྲོད་པ་རྣམས་ལ་ཁྲིད་ཀྱང་གང་འདོད་འདོད་གནང་བྱུང་།",
    "ཞེས་སོགསམགུར་ནས་གསལ་བ་ལྟར་ལགས།",
    "འདུས་པ་རྒྱམཚོའི་དབུས་སུ་རྗེ་འདི་ཉིད་མི་འཇིགས་སེ་ངྒེའི་ཁྲི་ལ་བཞུགས་སུ་གསོལ་ནས།",
    "རྗེ་ཉིད་ཀྱིས་ཐུགས་ཉམས་སྤྲོ་། ཞིགགསུངས་ཏེ།",
    "དི་ཉིད་དགུད་ལོ་བགྲེས་ཀྱང་འབྱོན་པར་ཞལ་གྱིས་བཞེས་ནས།",
    "བཀྲ་ཤིས་འཁྱིལ་རང་དུ་བཞུགས་ནས་སྒྲུབ་པ་ལྕིད་བོད་མཛད་པ་ཡིན་ཏེ།",
    "མ་ཚམས་ཀྱི་བཅད་རྒྱ་བྱས་ན་བསྟན་ལ་ཕན།",
    "ཁོང་ཡང་དེ་དུས་གཟིམ་མེད་གསུངས།"
  ]
}