    "བླ་སྤྱི་དང་གྲྭ་ཚང་དཀོར་གཉེར་སོགས་རང་རང་བབས་འོས་ཀྱི་ཕྱག་ལས་ལ་གཞིགས་པའི་ཕལ་ཆེ་བ་འདུས་མང་ནས་འོས་འདེམས་ཞུས་པ་རྣམས་ནས་ལོ་དུས་རྒྱས་དཔྱད་སོ་སོར་ཕྱག་ལས་ཐུགས་འགན་བཞེས་མུས་ཡིན།",
    "གྲྭ་ཚང་རང་ལ་གཏོང་སྒོ་སོགས་གང་ཡང་གཏོང་མི་དགོས་ཤིང་།",
    "རྒན་པ་ཚོས་ཁྲི་པ་གཞིས་ཁ་ཅེས་ཀྱང་ཟེར་སྲོལ་འདུག།",
    "རྣམ་རྒྱལ་སྒང་གཞིས་ཁ་སོན་ཁལ་༣ སྐོར་འགྲོ་བའི་ས་ཞིང་ཡང་གསེར་གདུང་མཆོད་ཐེབས་ཁོངས་ཡིན་ཚོད་འདུག།",
    "འགྱེད་གཏོང་མཁན་རྣམས་ཀྱིས་གསོལ་རས་ཀྱང་གནང་སྲོལ་ཡོད་འདུག།",
    "དེ་ནས་དུང་རྒྱའི་བགྲེས་པ་རྒན་པས་འགྲོ་འདུག་ཉལ་གསུམ་གྱི་སྐོར་ལམ་སྟོན་གནང་སྲོལ་ཡོད་ཅིང་།",
    "རྒྱལ་མཆོག་ལུང་རྟོགས་རྒྱ་མཚོའི་ཡོངས་འཛིན་མཛད་འདུག།",
    "རྒྱན་འཇུག་དུས་བཟང་།",
    "ཟངས་ཀྱི་ཟོ་ལག་རག་ཤན་ཅན་སྐྱོགས་རིལ་དང་རང་འགྲིགས་༡༤།",
    "ཅམ་པ་དྭང་སློབ་བཅས་ཀྱི་རང་ཁོངས་གྲྭ་རིགས་རྣམ་ཞལ་འདེབས་རང་རང་བློས་བཅད་ཀྱིས་འབུལ་བསྡུས་བྱས་ཏེ།",
    "འདི་གཉིས་ལ་ཁྱད་པར་གང་ཡང་མི་འདུག།",
    "ཅོ་ནི་རྒན་བློ་བཟང་བདེ་ཆེན་ང་རང་མི་གཅིག་ལས་མེད་པས་ཁང་ཚན་གྱི་ཁང་པ་རྒྱབ་ཐུབ་ཀྱི་མི་འདུག།",
    "གཞུང་ཆེན་ཁག་ལ་མཁས་པར་གྲགས་པ་སྐབས་དེའི་གདན་ས་ཁག་ལ་ཡོངས་གྲགས་སུ་བྱུང་འདུག།",
    "གྷི་ཝང་ཞིག་ཡོད་འདུག་པ་ཁང་ཚན་སྐུ་དགྲེས་རྣམས་ནས་སྐྱབས་རྗེ་ཁྲི་བྱང་རྡོ་རྗེ་འཆང་མཆོག་ལ་དགོངས་སྐོར་ཞུས་ཏེ།",
    "ཨ་ཞང་པ་སངས་ཚེ་རིང་ལགས་ཁྱིམ་ཚང་གཉིས་ནས་འཇོག་གནང་བས་ཁང་ཚན་ལོ་གསར་གྱི་ཐེབས་དངུལ་ནས།",
    "གཉེར་པ་གཉིས་བཅས་ཡོད་འདུག།",
    "སྤྱིར་སོག་པ་ཁང་ཚན་ལ་གྲྭ་རྒྱུན་གྱི་ཐོབ་ཁོངས་ཧ་ཅང་རྒྱ་ཆེན་པོ་ཡོད་འདུག།",
    "བཞིན་མཁན་ཁྲིར་ཕེབས་པ་སོགས་ས་ཁོངས་དེ་དག་ནས་བྱོན་པའི་མཁས་བཙུན་བཟང་གསུམ་འཛོམས་པའི་སྐྱེས་བུ་དམ་པ་མང་དུ་བྱུང་འདུག།",
    "རྩོད་པའི་སྐབས་ཀྱང་རང་གཞན་གྱི་རྒྱུད་ལ་མ་རྟོགས་པ་དང་།",
    "ཤེས་ཀྱང་རང་གཞན་ལ་ཕན་ཐོགས་ཡོང་བ་དཀའ་བར་མཐོང་ངོ།",
    "དེ་ནས་དགའ་ལྡན་དུ་ཕེབས་པའི་ཐོག་མར་དགོང་དྲོ་སྙན་གསན་རྒྱབ་དགོས་ཞེས་གོང་འཁོད་འདུག་ཀྱང་དེ་མི་དགོས་ཟེར།",
    "གནང་མཁན་ནས་གནང་ཡང་མི་ཆོག་པ་ཡིན་འདུག།",
    "ཇི་ལྟར་ཡིན་ཞུས་པར་ད་ལྟ་དྲན་གྱི་མི་འདུག་གསུངས།",
    "ཕྱི་ཉིན་སྔ་པོ་ཞིག་ལ་ཕྲན་བཀའ་འགུགས་གནང་བར་མདངས་དགོང་རྨི་ལམ་དུ་ང་དགའ་ལྡན་དུ་སླེབ་འདུག།",
    "ཇི་ལྟར་ཡིན་ཞུས་པར་ད་ལྟ་དྲན་གྱི་མི་འདུག་གསུངས།",
    "ཕྱི་ཉིན་སྔ་པོ་ཞིག་ལ་ཕྲན་བཀའ་འགུགས་གནང་བར་མདངས་དགོང་རྨི་ལམ་དུ་ང་དགའ་ལྡན་དུ་སླེབ་འདུག།",
    "དེ་ནས་དུང་རྒྱའི་བགྲེས་པ་རྒན་པས་འགྲོ་འདུག་ཉལ་གསུམ་གྱི་སྐོར་ལམ་སྟོན་གནང་སྲོལ་ཡོད་ཅིང་།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡིས།",
    "སྔོན་གྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཕྱག་ལེན་ཡང་ཡིན་ཞིང་རང་ཉིད་ཀྱང་དམ་པ་གོང་མ་དེ་རྣམས་ཀྱི་མཛད་སྤྱོད་བཟང་པོ་སྨོན་པའི་ཡུལ་དུ་བྱས་ནས། དབྱར་གནས་པ་ཞལ་གྱིས་བཞེས་པའི་",
    "ཁོ་བོ་ནས་བྲིས་དགོས་འདུག་སྙམ་པ་འཆར།",
    "ཡོངས་སུ་གཟུང་བ་ཡངས་ཤིང་རྒྱ་ཆེ་བ་རྣམ་ཐོས་ཀྱི་བུའི་ནོར་དང་ལྡན་པ་རྣམ་ཐོས་ཀྱི་བུའི་ནོར་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།"
  ]
}