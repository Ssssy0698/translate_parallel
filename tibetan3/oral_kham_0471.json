    "ལུས་རུ་སྦལ་འཁར་གཞོང་དུ་བཅུག་པ་ལྟར་འདུག་སྟངས་ལས་འབྲས་མི་ཕོད་པ་༢༣༨",
    "ལོངས་སྐུའི་འདུག་སྟངས་སམ་གཞོག་གཡས་ཕབ་པར་གསུངས་ཀྱང་།",
    "སེང་གེའི་འདུག་སྟངས་བཅས་ལ།",
    "མཁའ་ལ་ལིང་ངེ་འདུག་པ་ལ་སེམས་གཏད་ལ་ཅུང་ཞིག་ཕྱིར་འཛིན་པ་ལ་བསླབས་པས།",
    "དམ་ཚིག་དང་སྡོམ་པ་བསྲུང་ཞིང་གཅིག་པུ་དབེན་པར་འདུག།",
    "སྐུ་གསུམ་གྱི་འདུག་སྟངས་ལ་སློབ་ཚུལ།",
    "ཚན་རིག་དང་རང་བྱུང་།",
    "ཐུར་ཁེའི་མི་སྤྱོད་ཚུལ་འདིར་ཅུང་ཙམ་གོམས་འདུག་ནསབློ་བརྟན་འགྱུར་མེད།",
    "ཁོ་རང་ཁོ་ཚོའི་མེས་པོའི་དུར་སའི་ཉེ་འགྲམ་ལ་གཏུག་འདོད་པ་སྟེ།",
    "གལ་ཏེ་མེ་མདའ་རང་ལ་གཏད་འདུག་ན།",
    "འཚོ་བ་རོལ་སྟངས་ཐད་ནའང་ཁོ་ཚོར་ཁྱད་པར་ཆེན་པོ་འདུག་པས།",
    "ཨ་ཙི་མི་ཏེ་ཡུལ་ཚེར་སྤྱི་ལོ་སྔོན་གྱི་ལོ་ཡུལ་ཆེར་སྤྱི་ལོ་སྔོན་གྱི་ལོ་ལ་བསྟན་པ་ཡིན།",
    "ཡིན་ཡང་ཁོ་རང་ཉིད་ཀྱིས་གསར་གཏོད་དེ་དག་གླེང་རིན་མེད་པར་འདོད་པ་དང་།",
    "ཁོ་ཚོ་ཐབས་རྡུགས་དང་དབུལ་ཕོངས་ཀྱི་འཚོ་བ་ལ་ཡིད་ཚིམ་འདུག་པ་མཐོང་ན།",
    "དེ་ཚོ་ནམ་ཡང་རང་ཉིད་ཀྱི་མཐའ་འཁོར་ནས་འདུག་ཏུ་བཅུག་སྟེ།",
    "སྐྲངས་འདུག་པའི་སེམས་ལས་ཅི་ཡང་ཁྱེར་མ་འོངས་པས།",
    "དོན་དངོས་སུ་ཕུ་ནུ་ཞེས་པའི་མིང་འདི་ལ་མཛེས་སྡུག་ལྡན་ཞིང་བྱམས་བརྩེས་ཁེངས་འདུག་བདག་དང་ལ་པོ་ཨའེ་ཞིའི་འབྲེལ་བ་ནི་ཕུ་ནུའི་བརྩེ་དུང་ཡིན།",
    "སྙེག་མཁན་གྱི་ཚད་གཞི་དང་ཏག་ཏག་འགལ་འདུག།",
    "ཁོ་ཚོས་ཁོ་རང་ལ་དོན་བཟང་སྒྲུབ་པའི་ཐབས་ཁོ་ཚོའི་ལག་ཏུ་སྤྲད།",
    "དཔེ་མི་སྲིད།",
    "ཁོ་རང་བློ་རྨོངས་པ་ལ་སྐྲག་པ་ཡིན།",
    "གང་ཞིག་བསྒྲུབས་ནའང་ཞིབ་ཚགས་དང་རང་རྟོགས་ལྡན་པ་དང་།",
    "སྔོན་གཤེགས་དཔའ་བོས་མེའི་ནང་ནས་རྗེ་བོ་ངན་པར་ཁ་གཏད་དེ་གཞོགས་འདི་ས་ཚོས་འདུག་ཆོད་དང་།",
    "ཁོ་ཚོས་རྨི་ལམ་རྨི་བ་དང་སེམས་འཁྲུག་པའི་སྐབས་ལ་རང་གནོང་རང་འགྱོད་བྱས་ཏེ།",
    "བློ་བརྟན་འགྱུར་མེད་དུ་གཏོང་ནུས་པ་དང་རང་ལ་ཡིད་ཆེས་སུའང་འཇུག་ནུས།",
    "རྒྱལ་ཁབ་དེ་ཚོས་ནོར་འཁྲུལ་ཡོད་མེད་ལ་ད་དུང་ཐེ་ཚོམ་འདུག་པའི་མི་ཞིག་ལ་མནར་གཅོད་གཏོང་ཞིང་གསོད་པ་ནི་འཇིགས་སུ་རུང་བའི་གདུག་རྩུབ་ཀྱི་བྱ་སྤྱོད་ཅིག་ཡིན་པར་འདོད།",
    "དེས་འཕུར་འཕུར་འདུག་འདུག་མ་གཏོགས་མི་ནུས།",
    "དེའི་གྲས་སུ་སའེ་སི་ཏི་ཨོ་སི་ཡོད་པ་དང་གྲལ་རྔ་ན་བསྡད་འདུག་སྐབས་དེར་ཁྱིམ་ཚང་ཕྱུག་པོས་གསོལ་སྟོན་བཤམས་ན།",
    "རྒྱུན་དུ་མི་ཁ་ཤས་ལྐོག་ནས་ཡོང་སྟེ་དེ་རུ་འདུག་པ་ཡིན།",
    "ཁོ་རང་ཉིད་གཡོ་སྒྱུ་ཅན་ཞིག་ཡིན་པའི་དོགས་པ་ཟ་ཞིང་།",
    "ཏེ་མེང་མའོ་ལང་ཞི་དང་ཏེ་པུའུ་ལི་ཝུང་ལ་གཅེས་སྐྱོང་མ་ཐོབ་པའི་གནས་ཚུལ་བརྗོད་རྒྱུ་བརྗེད་འདུག་པ་དང་།",
    "དེ་བས་ཀྱང་རང་བྱུང་ཡིན་པའི་ལོངས་སྤྱོད་གཞན་འཐོབ་མ་ཐུབ་པའི་སྐབས་སུ་ད་གཟོད་དེ་ཚོ་བཙལ་བའི་རྐྱེན་གྱིས་ཁོང་ཁྲོ་སྤུ་ཙམ་ཡང་མི་ལངས་ཤིང་།",
    "ཁྱིམ་དུ་བདག་དཔེ་ཁང་དུ་འཛུལ་ནས་འདུག་པའི་དུས་ཚོད་ཅུང་མང་།",
    "རང་གཅིག་པུ་ལྷིང་འཇགས་སེ་འདུག་པའི་ཆེད་དུ།",
    "དགུན་ཁར་བདག་དེ་རུ་མུ་མཐུད་ནས་འདུག་པའི་དུས་ཚོད་ཅུང་ཉུང་སྟེ།",
    "མི་ལ་ལར་ཁྱིམ་ནའང་རང་ཉིད་ལ་གཏོགས་ཤིང་ཞི་འཇགས་ལོངས་སུ་སྤྱོད་ཆོག་ཅིང་གཞན་ལ་བྱོལ་ཆོག་པའི་གནས་ཤིག་མེད།",
    "ཁོ་ཚོ་ནམ་ཡང་ངེས་པར་དུ་མཉམ་དུ་འདུག་དགོས་པ་དང་།",
    "ཚེ་གང་བོར་ཁེར་འདུག་བྱ་རྒྱུ་དེ་ཁེར་འདུག་གཏན་ནས་བྱས་མི་ཆོག་པ་ལས་ལེགས་པར་འདོད་དོ།",
    "བ་རྒྱུན་ལྡན་དང་རང་བཞིན་གྱི་འཆི་བར་གཏོགས་པ་དེ་ཡིན།",
    "ས་མཆོག་ས་གཡས་པ་ནས་བསམས་ནས་ཚན་རིག་དང་རང་བྱུང་།",
    "བྱེད་བ་གབཀག་བ་ས་ཚན་རིག་དང་རང་བྱུང་།",
    "རང་ཉིད་གོས་རྒྱན་དཀར་པོ་སྐྱིལ་ཀྲུང་ངམ་ཙོག་པུའི་ཤར་བལྟས་འདུག་ལ།",
    "སྤྱི་ཟླ་ཚེས་ཉིན་བལ་བོད་ས་མཚམས་འགྲམ་དུ་འབྱོར་པ་ཡོང་རྒྱུ་ཞེས་འཁོད་འདུག་པ་བཞིན་སྤྱི་ལོ་ལོའི་ཟླ་ཚེས་ཉིན་ཤག་ལྷོའི་བུ་བཀྲ་ཤིས་ནོར་བུ་ངེད་གཉིས་བུ་གཉིས་བསུ་བར་བསྐྱོད་ཅིང་།",
    "ད་ལྟ་རྒྱ་གར་གཞུང་ལ་འབུལ་རྒྱུ་བྱུང་མི་འདུག་དེ་རིང་རང་ཕུལ་ཆོག་པ་དགོངས་འགལ་མེད་པ་ཞེས་ཟེར་བར།",
    "བུ་གཉིས་ནས་ངོས་གཉིས་རྒྱ་གར་དུ་འགྲོ་བར་དགོངས་ཞག་དུས་ཚོད་མང་པོ་མེད་པ་དང་།",
    "ང་རང་སྒེར་གྱི་བསམ་འཆར་བྱས་ན་རྒྱ་གར་ལ་མ་ཕེབས་ན་ལེགས་ལུགས་གསུངས་འདུག་པ་དེ་ལྟར་བརྗོད་བབས་དང་།",
    "ང་རང་དངོས་རིགས་རྣམས་སྲུང་ཞིང་བསྡད།",
    "དེ་ནི་གཞུང་བཞེས་གནང་འདུག་སྤུན་མཆེད་གཅིག་བར་སྐོར་ནང་ཡོད་པ་དེའི་སར་འགྲོ་རྩིས་ཡིན་ཡང་།",
    "དེར་ཡང་སྒོ་ཐེལ་ཕོག་འདུག་བྱས་ཙང་ངའི་བུ་གནས་ཚང་འཚོལ་བར་བཏང་བས་ད་ལྟ་འབྱོར་མ་བྱུང་སྒུག་བསྡད་ཡོད་ཅེས་བརྗོད་པར།",
    "ཕྲན་སླེབས་པ་དང་ཁོང་རང་བཞུགས་སའི་སྐུ་རྒྱབ་ནས་ཤིང་ཤོག་སྦར་གང་ལྕགས་ཐབས་དེར་བླུག་སྟེ་མེ་སྤར་ནས་ཇ་ཐང་ཚ་པོ་བཟོས།",
