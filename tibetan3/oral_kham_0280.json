    "ཐོག་མར་ང་རང་དཔྱིད་ཀའི་འདམ་རྫབ་ཀྱི་ལམ་ཀྱག་ཀྱོག་དེའི་སྟེང་དུ་ས་ལ་འགྱེལ་བ་དང་།",
    "ང་རང་བརྒྱུད་ཟིན་པའི་ལམ་བུ་དེའི་སྟེང་ན་རྒྱ་མཚོའི་རླབས་གཉེར་ལ་འཕྱ་བའི་གཞོན་ནུ་ཁྲི་འབུམ་གྱིས་ས་གཞི་ཡོམ་ཡོམ་བྱེད་པའི་གོམ་སྟབས་སྒྱུར་གྱིན་མདུན་དུ་སྐྱོད་བཞིན་འདུག་ཡིན་ནའང་།",
    "ཡང་ལ་ལ་ཞིག་དུས་ཚོད་ཀྱི་གོ་རིམ་ཡིན་པ་དང་འགའ་ཞིག་ས་གནས་ཀྱི་བརྗེ་སྤོར་ཡིན།",
    "ཤེས་རབ་ཀྱི་དཔལ་ལྡན་པ་ཞིག་ཡིན་ཞིང་རང་བྱུང་ཁམས་ལ་འཐབ་རྩོད་དང་མ་འོངས་པའི་འཚོ་བར་བརྩོན་པ་ལྷུར་ལེན་གནང་སྟེ།",
    "བོད་ཁམས་བསིལ་བའི་ལྗོངས་འདི་གདོད་མ་ནས་གླུ་གར་གྱི་རྒྱ་མཚོ་ཞེས་གྲགས་པ་རྒྱུན་འབྱམས་སུ་གྱུར་འདུག་ལ།",
    "དེ་གསུམ་ཀའང་སོ་སོར་ཡུལ་ཕྲན་ཁག་མང་བོར་གྱེས་འདུག་པས་དུས་འདི་ལྟ་བུ་ལ་སྐད་རིགས་བཞིའི་ལམ་ནས་ཟློས་གར་གྱི་བསྟན་བཅོས་རྩོམ་རྒྱུ་ནི་ཤིན་ཏུ་ནས་དཀའ་བའི་གནས་ཡིན་ལ།",
    "གསུམ་ཀ་དོན་གཅིག་ཡིན་ཞིང་རྒྱན་གྱི་ཆ་ནས་ཀྱང་རང་བཞིན་བརྗོད་པ་ཙམ་དུ་མཐུན་ལ།",
    "ངེས་པར་དུ་ཚོར་བརྗེ་དང་འགལ་འདུའི་སྐད་ཆ་སྙན་རྩོམ་སྤྱིའི་བརྗོད་དོན་དང་རང་ཉིད་ཀྱི་རིགས་རྟོག་ལ་བརྟེན་ནས་གསེད་དཀྲོལ་བྱས་ཏེ་ཀློག་པ་པོར་གོ་བ་རྙེད་དུ་འཇུག་དགོས།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དང་།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "གཟུགས་ཀྱི་ཡོངས་སུ་གཟུང་རྗོབ་མ་མཆིས་པ་གང་ལགས་པ་དེའང་རང་བཞིན་ཀྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མ་ལགས་ཞེས་ཞེས་བྱ་བས་གཟུགས་ལ་སོགས་པ་ཡོངས་སུ་མ་བཟུང་རྗོབ་ལ་དེའི་ངོ་བོ་བཀག་པས་གང་གསུངས་པ་ཡིན་ནོ།",
    "མཚན་ཉིད་ཀྱི་རང་བཞིན་དང་རང་བཞིན་གྱི་མཚན་ཉིད་དག་ནི་ཕན་ཚུན་དེའི་བདག་ཉིད་དུ་གྱུར་པ་ཉིད་ཀྱིས་རྣམ་པའི་ཁྱད་པར་ནི།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་སླད་དུ་ཆགས་པ་མ་མཆིས་ཏེ།",
    "བསླབ་པ་ལས་འདའ་བའི་གཡེང་བའི་གཉེན་པོར་གནས་པ་དང་འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་རྣམས་དང་།",
    "འོང་བར་མ་ཡིན་འགྲོ་བར་མ་ཡིན་པ་དང་།",
    "དེ་གང་རང་བཞིན་མཚན་ཉིད་ཅན།",
    "ཉེ་ཀོར་དུ་འདུག་སྟེ།",
    "དེ་དང་ཉེ་བར་སྟན་བདེ་བ་ལ་འདུག་ནས་ཡིད་ལ་བྱེད་པ་འཇུག་པར་བྱ་སྟེ།",
    "སྣང་བའི་མཚན་མ་ནི་འདུག་པ་ལྟ་བུར་མི་གཡོ་བར་གྱུར་པ་ཡིན་ནོ།",
    "མཚན་མ་རྣམ་པ་འདི་དགུ་ཆར་ལ་ཡང་བདེ་བར་འདུག་ནས་ཁ་དོག་ལ་སོ་སོར་རྟོག་པ་དང་མཚན་ཉིད་ཡིད་ལ་བྱེད་པ་དག་སྤངས་ཏེ།",
    "འདུག་གནས་བྱེད་པ་ལ་སོགས་པ་ལ་ཐོག་མར་འགོ་ཞིང་གཞན་དག་ཀྱང་སྤྲོ་བ་བསྐྱེད་པའི་ཕྱིར་དང་།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དང་འབྱེལ་པའི་གཏམ་སྨྲས་པར་གྱུར་པ་ནི་སྤྱོད་རྙེད་པ་ཆེན་པོ་རྙེད་པ་ཡིན།",
    "རང་བཞིན་ཡང་རང་བཞིན་དང་བྲལ་བའོ།",
    "རང་བཞིན་གྱི་མཚན་ཉིད་ཀྱང་རང་བཞིན་དང་བྲལ་བ་ཡིན་ནོ།",
    "སྐྱེ་མཆེད་ལ་སོགས་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་སྐྱེ་བ་དང་འགག་པ་མི་དམིགས་ཏེ།",
    "འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་རྣམས་དང་།",
    "ཡང་རང་བཞིན་གང་ཡིན་པ་སྡུག་བསྔལ་གྱི་བདེན་པའི་རྟེན་ཅན་རྣམ་པར་གྱུར་པ་ནི་ལྔ་ཡིན་ནོ།",
    "དེ་དག་དེ་ལྟར་བྱས་ན་སྣེཇི་ལྟར་སྟོབས་ལ་སོགས་པའི་རྣམ་པ་རྣམས་ཀྱི་རབ་ཏུ་དབྱེ་བ་དང་རང་བཞིན་གང་ཡིན་པ་དེ་རྣམས་ནི་དེ་བཞིན་ཉིད་དང་།",
    "གོས་གཙང་མ་ལས་འཛག་སྐེཔའི་གཞོང་པ་ལ་སོགས་པའི་སྣོད་གང་ཡང་རུང་བ་ཆུས་བཀང་བ་གནས་ཤིན་ཏུ་བཟང་པོར་བཞག་ལ་བདེ་བར་འདུག་ནས་ཡིད་ལ་བྱེད་པ་བརྩམས་པར་བྱ་སྟེ།",
    "དེ་དང་ཉེ་བར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སོ་སོར་སྣང་བའི་མཚན་མ་ནི་ལེགས་པར་འདུག་པ་ལྟར་མི་གཡོ་བར་འགྱུར་རོ།",
    "མཚན་མ་དེ་དགུ་ཆར་ལ་ཡང་བདེ་བར་འདུག་ནས་ཁ་དོག་ལ་བརྟག་པའི་ཡིད་ལ་བྱེད་པ་སྤངས་ནས།",
    "པདྨའི་འདབ་མ་རྒྱས་པ་ལྟར་འདུག་པའི་སྤྱན་གྱིས་ལྷ་དང་།",
    "ཀུན་བརྟགས་པའི་བྱེད་པ་པོ་དགག་པ་ཡང་རང་བཞིན་སྟོང་པ་དང་།",
    "སྟོང་གཟུགས་ཀྱི་རིག་མས་འཁྱུད་པའི་རྣམ་པ་ཅན་དུ་བཞུགས་པའི་ཁ་སྦྱོར་དང་བདེ་ཆེན་དང་རང་བཞིན་ཡོད་པ་སེགས་ཀྱི་ཕང་ལ་ལ།",
    "ང་རང་འདྲའོ།",
    "ལྕགས་ཀྱུའི་ཕྱག་རྒྱ་བྱས་ལ་ཤཱི་གཡོན་གཞི་བཅའ་འདུགསྟེང་སོགས་ཐམས་ཅད་སྔར་བཞིན་གྱིས་བཏབ།",
    "དེ་ཡང་རང་ཡིན་གྱི་ཚུལ་གྱིས་བསྡུས་པ་མིན་པར་བྱེད་ལས་ཀྱི་སྒོས་བསྡུས་པ་འབབལྟའོ།",
    "དེ་ཡང་རང་ཡིན་གྱི་ཚུལ་གྱིས་བསྡུས་པ་ཡིན་པར་བྱེད་ལས་ཀྱི་སྒོས་བསྡུས་པའོ།",
    "དེ་ལ་རྒྱུད་ཀྱི་དོན་སྣང་བ་གསུམ་དང་རང་བཞིན་རྣམས་ལེགས་པར་གཏན་ལ་ཕབསྟེ་དེས་པར་བྱདགོས་པས།",
    "རྡོ་རྗེ་འཇིགས་བྱེདཀྱི་སྐུ་དྲུག་དུས་ཀྱི་འཁོར་ལོའི་སྐུ་བཅུ་ཐམཔ།",
    "རང་རང་དགྱེས་པ་བསྐྱེད་བྱེད་བའི།",
