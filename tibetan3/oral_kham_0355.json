    "འགྲངས་རྗེས་དལ་བུར་འདུག་དང་ཉིན་གཉིད་ལོག།",
    "བསིལ་གྲང་ལ་མཉམ་འཇོག་བཟང་བོ་བྱས་ནས་དྲོ་སར་འདུག་རྒྱུ་དང་གོས་དྲོན་པོས་གཡོག་རྒྱུ།",
    "དལ་བར་འདུག་དང་མྱ་ངན་སེམས་ལས་དུབ།",
    "རླན་ལ་འདུག་དང་ཆུ་ཡི་ལས་བྱས་དང་།",
    "ཉིན་པར་གཉིད་ལོག་སྐྱིད་པོར་འདུག་པ་དང་།",
    "རྒྱུ་རྐྱེན་འཁྲུས་དྲགས་སྟན་སྲབ་ཙོག་པུར་འདུག།",
    "སྤྱོད་ལམ་དལ་བར་འདུག་དང་ཉིན་གཉིད་ལོག།",
    "སྟན་སྲབ་ཙོག་པུར་འདུག་པ་ལ་སོགས་པ།",
    "རྒྱུ་རྐྱེན་སྟན་སྲབ་ཙོག་པུར་འདུག་པ་དང་།",
    "བཞོན་བསྟེན་རླན་སྟེང་ཡུན་རིང་འདུག་ལས་འབྱུང་།",
    "སྟན་སྲབ་བུའམ་རྩུབ་པོའི་སྟེང་དུ་ཙོག་པུར་ཡུན་རིང་ལ་འདུག་པའམ་རྒྱུན་དུ་འདུག་པ་དང་།",
    "ཡང་ན་ས་རླན་སྟེང་ཡུན་རིང་དུ་འདུག་པ།",
    "འ་སཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་༡༧༢བ་དང་།",
    "ཁྲི་ཚད་ཆུང་ངུ་ནི་ཁྲིའུ་ཞེས་བྱ་སྟེ་དེ་ལ་བདག་ཉིད་འདུག་ཏུ་འཇུག་པའི་བསྙེན་བཀུར་ཁྲིའུ་ཡང་དང་ཡང་དུ་ཤོམ་དུ་འཇུག་པ་ཉམས་སུ་མྱོང་བ་བྱེད་པའི་དགེ་སློང་མ་ལའོ།",
    "དགེ་སློང་མས་ཁྱིམ་གཞན་དུ་བདག་པོས་མ་བསྒོ་བར་དེར་སྟན་ལ་འདུག་པ་ལའོ།",
    "ཕྱིས་གནོན་བྱེད་པའི་ཞེས་བྱ་བ་ནི་ཟིལ་གྱིས་གནོན་ཅིང་འདུག་༡༧༧ན་པའོ།",
    "འདུག་པའི་ཆེད་དུ་ས་ལས་བྱས་པའི་སྟེགས་བུ་གྲུ་བཞི་དག་དང་༡༨༩ན་ཤིང་ལས་བྱས་པའི་ཁྲིའུ་ཡང་ངོ།",
    "བསླབ་པ་བྱིན་པ་དེ་དདགེ་སློང་རང་བཞིན་དུ་གནས་པའི་ནང་དུ་འདུན་པ་ལེན་དུ་འོང་ན་ཡང་དེ་ལ་འདུན་པ་འབུལ་དུ་མི་རུང་ལ།",
    "སའབནམ་མཁའ་ལ་འདུག་པར་འདུག་པ་དང་འགྲོ་བར་མི་བྱའོག།",
    "མཚམས་ཀྱི་ནང་ན་འདུག་ན་ཞེས་སོ།",
    "དེས་ཀྱང་མ་རྙེད་ནས་ཕྱོགས་མཐོན་པོར་འདུག་སྟེ་ཊི་",
    "གནས་དེ་ན་དགེ་སློང་རང་ཉིད་གཅིག་པུ་འབའ་ཞིག་ཡོད་ན་སྤྱོད་ལམ་འདུག་སྦྱོསསྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པའོ།",
    "དགེ་འ་སློང་རང་ཉིད་མ་གཏོགས་པ་ལྷག་མ་ཟླ་བོ་དགེ་སློང་གཞན་གཅིག་དང་བཅས་པ་སྟེ་དགེ་སློང་གཉིས་འདུག་ཏུག་བཞར།",
    "ཉེ་པ་ཉིད་ཡིན་ན་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པར་བྱའོབར་ཙོག་ཙོག་པུར་ཕས་འདུག་ཚུས་འདུག་སྟེ་གཅིག་ལ་གཅིག་བྱིན་གྱིས་བརླབ་བོ།",
    "གནས་དེ་ན་དགེ་སློང་གསུམ་ཡོད་ན་ནི་གསུམ་ཆར་འཁོད་དེ་འདུག་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གནས་དེ་རྣམས་སུ་མཛེ་ཅན་གྱིས་འདུག་ན་གཞན་ལ་གནོད་པའི་ཕྱིར་རོ།",
    "ཁ་ཏོན་དང་འདུག་པ་དང་།",
    "གནས་ཁང་ལ་ལར་སྔ་དྲོ་དང་དགུང་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་གནས་ཁང་ཐམས་ཅད་ཏིཔཱལོངས་སྤྱད་པ་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "ལུང་དང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་བདག་གནས་པར་པ་མ་ཚཁས་བླངས་སམ་མི་བློངས་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བ་ཉིད་ལ་ནི་དབྱར་གནས་པར་ཁས་བླངས་པ་མི་འཇིག་གོ།",
    "དབྱར་རལ་བས་ཀྱང་རང་ག་བ་བ་ར་དགག་དབྱེ་བྱ་དགོས་སོ་ཞེས་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་བཤད།",
    "གཉིས་པ་གང་ཟག་རྐྱང་པ་འཇོག་པ་དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ་ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པས་ཅི་ནས་ཀྱང་གང་ཟག་འཇོག་པར་བྱེད་ཅིང་གཞི་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི་འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་པ་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་བརྗོད་པ་དང་།",
    "གསུམ་པ་གཞི་དང་གང་ཟག་གཉིས་ཀ་འཇོག་པ་དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ་ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པ་ཅི་ནས་ཀྱང་གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱིས་འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་པ་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་བརྗོད་པའི་འོ།",
    "ཚུན་ཆད་དུ་འདུག་པ་ལ་ཡང་ཉེས་པ་མེད་དོ།",
    "སྲིད་དུ་ལབཏང་བའི་ཚལ་བུ་རྣམས་ཀྱི་སྣ་མཐོ་དམན་དུ་འདུག་པས་སྣམ་ཕྲན་སྦྲེལ་གཞི་ཉིད་དུ་འགྱུར་བ་ཊི་ཀ་",
    "རྒྱ་ཅང་ངམ་ནི་སྐུད་པ་མང་པོ་ལས་གཏོགས་པ་ཉིད་དུ་དབུས་ཁོང་སྟོད་དུ་འདུག་པའོ་ཞེས་ཊཱི་ཀའོ།",
    "སྣམ་སྦྱར་དེ་ལ་དེའི་སྟེང་དུ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "གདོང་ཕྱིས་ལ་ཡང་ཆག་བྱ་སྟེ་ཊཱི་ཀའི་སྐབས་གཞན་ལས་གདོང་ཕྱིས་ཀྱི་ཐ་དྲིལ་ཏེ་བཙེམ་ཞིང་རང་ཆག་བྱའོ་ཞེས་སོ།",
    "འདུག་པར་མི་བྱའོ།",
    "མ་དྲས་པའི་སྣམ་སྦྱར་ཡོད་པས་ཀྱང་དེར་འཇུག་པ་དང་འདུག་པར་མི་བྱ་ན་སྣམ་སྦྱར་གཏན་ནས་མེད་པས་ལྟ་ཅི་སྨོས་སོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་སྣམ་སྦྱར་མེད་པའམ་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་སྔ་མ་དེ་བཞིན་དུ་སྦྱར་བའོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་དག་འཁོད་ཅིང་མུ་སྟེགས་ཅན་ཉེ་བར་གནས་ན་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་འདུག་གནས་དེར་སྣམ་སྦྱར་མེད་པར་འཇུག་པ་པདང་འདུག་པར་མི་བྱའོ།",
    "སྤུ་དམའ་བ་ནི་སྤུ་ཐུང་ངུ་སྟུག་པོ་ཕྱིང་ངེ་འདུག་པ་སྟེ་བེའུ་རས་ལ་བྱའོ་ཞེས་ཊཱ་",
    "དགེ་ཚུལ་ལ་ཞིག་འོང་ན་ཡང་དེ་དེར་འདུག་ལ་ཟོ་ཞིག་ཅེས་ལུང་གསིལ་བུ་ལས་སོ།",
    "དགེ་སློང་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོའ།",
    "དུ་དོམ་ལྤགས་དེ་རྐང་པའི་གནས་སུ་གདིང་བ་དང་མཆིལ་ལྷམ་དག་ཏུ་བགོ་བ་དང་འདུག་པ་དང་ཉལ་བར་ཡང་བྱའོ།",
    "གདོང་ལ་གཏར་ཀ་བྱན་རྩ་གང་ན་འདུག་པའི་སྟེང་དུ་བྱས་པ་ནི་ཉེས་མེད་དོ།",
    "ལུང་དང་རང་འགྲེལ་དང་ཊི་ཀ་ལས་ཚིལ་རུང་བ་མ་ཡིན་པ་དང་ལྷན་ཅིག་བསྐོལ་བའི་ལན་ཚྭ་ལ་སོགས་པ་རྫས་རུང་བ་མ་ཡིན་པའི་བག།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "དགེ་སློང་དག་ཕྱིན་པའོ་ཞེས་སྨོས་ན་དེའི་དུས་ཀྱི་ཚིགས་ཅིས་བཟུང་ཞེ་ན་གནས་དེར་ཕྱིན་ནས་བྱ་བ་གཞན་ཆུ་བཙགས་པ་དང་གནས་ཁང་བསྐོ་བ་སོགས་བརྩམས་པ་དང་ངལ་བསོ་བ་ནི་སྟན་ལ་སོགས་པ་འདུག་པ་སྟེ་བྱ་བ་དེ་གཉིས་དངོས་ནི་ད་དུང་མ་བྱས་ལ་དེ་གཉིས་བྱ་བའི་མཚམས་ལ་ཐུག་པ་ཚུན་ཆད་ཀྱི་དུས་དེ་ནི་དགེ་སློང་དག་ཕྱིན་པ་ཉིད་ཀྱི་དུས་དེ་ཉིད་དོ།",
    "རྩྭ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དུས་སྟོན་ཆེན་པོ་བྱུང་སྟེ་འདུས་པ་ཆེན་པོའི་ཚེ་དགེ་སློང་མ་རྣམས་རྒན་རིམ་བཞིན་དུ་འདུག་པ་ན་ཅ་ཅོ་འདོན་པར་གྱུར་ནས་འདི་གསུངས་སོ།",
    "སྒོའི་ལག་གཅིག་ནང་དུ་སྣོལ་ལ་སྒོའི་ལག་གཅིག་ཕྱིར་སྣོལ་ཞིང་སྒོ་དྲང་ཐད་དུ་མི་འདུག་པས་ནང་དུ་ཞུགས་པའི་མི་དེ་ཕྱི་རོལ་ནས་མི་སྣང་བ་དེ་ལྟར་སྒོ་གདོད་པར་བྱའོ།",
    "ལུང་ལས་འདུག་པ་ན་རྐུབ་རུས་ན་ན་ཐགས་མའི་སྦུ་གུའི་ཐན་ཀོར་འབོལ་བའི་ཕྱིར་དུ་ལོ་མའི་ཆངས་བུ་དག་གཞུག་གོ།",
    "བཤལ་མ་བྱས་པར་འདུག་པར་མི་བྱའོ།",
    "གང་ཟག་ཇི་ལྟ་བུས་ཕྱིར་བཟློག་འཆགས་ཞེ་ན་འདུག་པའི་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་དང་།",
    "རབ་ཏུ་དབྱུང་བར་འདོད་པ་སྟེ་ཙོག་བུར་འདུག་སྟེ་འོ།",
    "མནན་ཏེ་འདུག་པར་བྱའོ།",
    "ཅི་བདེར་འདུག་ཏུ་གཞུག་པ་ཡིན་གྱི་ཙོག་བུར་འདུག་ཏུ་མི་གཞུག་གོ།",
    "ཙོག་པུར་འདུག་སྟེ་བརྗོད་པར་བྱའོ།",
    "གསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ།",
    "ཤིང་དྲུང་ལ་སོགས་འདུག་པའི་གནས་ཐམས་ཅད་ལ་བསླབ་པ་རྒན་རིམ་དུ་བསྐོ་བར་བྱའོ།",
    "གང་ཟག་དེ་ཚུལ་ཇི་ལྟར་འདུག་པ་ལ་བྱ་ཞེ་ན་རྩྭ་བཅད་དེ་ས་ལ་བཀྲམ་པ་ལྟ་བུར་ལུས་ཐམས་ཅད་ས་ལ་འགྱེལ་བ་ན",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ཉིད་ལ་འདུག་པར་བྱའི་དེ་ལས་གཞན་སྟན་མཉམ་པའམ་མཐོ་པས་འདུག་པར་ཡང་ངོ།",
    "སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་མི་བྱ་ན་སྟན་གཅིག་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ངོས་དང་སྟེང་གཡོགས་མ་གཅིག་ཏུ་ཉལ་བར་མི་བྱ་བས་དེར་མལ་བཤམ་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་གནས་པ་དེ་དང་བརྟེན་པར་ཏེ་འཇིང་པ་བསྒྲིལ་བར་མི་བྱའོ།",
    "༢༩ན་འདུག་ཏུ་རུང་བ་ཡོད་དེ་དགེ་སློང་མ་རྣམས་ཀྱི་གྲལ་གོང་དུ་འདུག་པའོ།",
    "དེའི་སྒྲུབ་བྱེད་ནི་ལུང་གསིལ་བུ་ལས་དགེ་སློང་མ་དག་འབའ་ཞིག་ཚོགས་ན་ཡང་རྟག་ཏུ་གྲལ་གྱི་དང་པོར་སྟན་གཅིག་ལྷག་པར་ཞོག་ལ་འཁོད་ཅིག་དེ་སྟེ་དགེ་ཚུལ་ཕ་ཞིག་འོངས་ན་ཡང་དེ་དེར་འདུག་ལ་ཟོ་ཞིག་ཅེས་གསུངས་པ་ན་དགེ་སློང་མ་རྣམས་ལས་ནི་ནས་སང་དགེ་ཚུལ་མཐོ་བ་ཡིན་ལ་དགེ་ཚུལ་བས་ཀྱང་སྤོ་མགུ་སྤྱོད་པ་གྲལ་མཐོ་བའི་ཕྱིར་རོས།",
    "གསོ་སྦྱོང་དང་དགག་དབྱེ་གཞག་པ་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྦྱོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གནས་གང་དུ་དུས་འདའ་བར་བྱ་བ་ངལ་བསོ་བའི་གནས་བསྟི་གནས་ལྟ་བུ་གནས་དབེན་པ་གང་ན་མི་མཐུན་པ་དགྲ་བོ་ཡོད་པ་དེ་དང་ལྷན་ཅིག་ཏུ་འཁོད་པ་འདུག་པ་དང་འགྲེང་བར་མི་བྱའོ།",
    "གནས་བརྟན་དེས་རྒོལ་ཕྱིར་རྒོལ་དེ་གཉིས་དང་ལྷན་ཅིག་འགྲེང་བ་དང་ལྷན་ཅིག་འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆག་པ་དང་གཏམ་འདྲེ་བ་དང་བག་ཕེབས་པར་སྨྲ་བ་ཡང་ངོ།",
    "རྒྱབ་ཀྱིས་ཕྱོགས་པ་མདུན་ཕར་ལ་ལྟ་བ་དང་ཁྱིམ་གཞན་ཁྱིམ་པའི་ཁྱིམ་ཊིན་འདུག་པ་དང་།",
    "ས་གཞན་ན་གནས་པ་དང་ཉམས་པ་ལ་སོགས་པ་བཅུ་གསུམ་སྔར་བསྟན་མ་ཐག་པ་དེ་རྣམས་ལས་ཁྱིམ་གཞན་ན་འདུག་པ་མ་གཏོགས་པ་གཞན་ཐམས་ཅད་ལ་ནི་ཁྱིམ་པས་ཀྱང་ཕྱག་མི་བྱའོ་རབ་ཏུ་བྱུང་བ་ཁྱིམ་གཞན་ན་འདུག་པ་དག་ལ་ཡང་ཁྱིམ་པས་ཕྱག་བྱའོ་ཞེས་ཊཱི་ཀ་ལས་སོ།",
    "ལྷོད་༣༧བ་ཕབ་ཏུ་འདུག་པར་བྱའི་མ་བསྒོ་ན་ཙོག་པུས་སོ།",
    "འདུག་པར་བྱའོ།",
    "ལུང་ནོད་པར་བྱ་བའི་གཞུང་མང་བ་ཉིད་ཡིན་ན་གསར་བུ་དེས་ལྷོད་ཕབ་ཏུ་འདུག་པའི་ཕྱིར་ལུང་འབོག་པ་པོ་ལ་ཞུ་བར་བྱའོ།",
    "སེང་གེའི་ཁྲི་ལ་འདུག་པའི་མདུན་དུ་མེ་ཏོག་དང་བདུག་སྤོས་དགྲམ་ཞེས་འགྲེལ་ཆུང་ལས་སོ།",
    "ལུང་ལས་སྐར་ཁུང་དམའ་བར་གཏོད་པས་ཧ་ཅང་ཚ་བར་གྱུར་ནས་བཀའ་སྩལ་པ་སྐར་ཁུང་དེ་དག་མ་མཐའ་དང་དགེ་སློང་འདུག་པའི་ཁྲི་ལ་སོགས་པའི་སྟན་གྱི་ཚད་དག་ཡ་མཐའ་ཐད་ཀར་བབ་པ་བྱའོ།",
    "བར་བྱའི་གང་ཟག་གསུམ་ལས་ལྷག་པ་མང་པོ་བཞི་ཡན་ཆད་དང་ལྷན་ཅིག་ཁྲི་གཅིག་ལ་སྟེང་དུ་འཛེག་པ་དང་འདུག་པ་དང་ཉལ་བ་ཉིད་བསྟེན་པར་མི་བྱའོ།",
    "ཁྲིའུ་ཁྲི་ཆུང་དུ་གྲུ་བཞི་ལ་གང་ཟག་གཅིག་ཁོ་ན་འདུག་པར་མི་བྱའི་གཅིག་གཉིས་ཡན་ཆད་མ་ཡིན་པས་འདུག་པར་མི་བྱའོ།",
    "བསླབ་པ་གཞོན་པ་དེ་ཆེས་རྒན་པ་དང་ལྷན་ཅིག་འདུག་པ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་གཉིས་སྟན་གཅིག་ལ་འདུག་ཏུ་མི་རུང་ངོ་ཞེས་ལུང་ལས་སོ།",
    "ས་སྟེགས་སམ་ཤིང་ལེབ་བམ་༣༡༩ན་རྡོའི་སྟེང་ན་ནི་ཁྱིམ་པ་དང་ཡང་ལྷན་ཅིག་ཏུ་འདུག་ཏུ་རུང་ངོ་ཞེས་ཊིཀ་ཆུང་ལས་སོ།",
    "ར་ལསགྲལ་ཐོབ་པ་ལས་གོང་དུའང་མི་འདུག་མནལ་འོག་ཏུའང་མི་འདུག་བ་།",
    "ཆར་པ་ཆད་ན་དྲུང་ན་འདུག་པའི་ཁྱིམ་དག་ཏུ་གདུགས་དེ་བཞག་གོ།",
    "དགེ་སློང་མ་དེས་དབྱེར་ཁང་དེའི་ཕྱི་སྒོར་འདུག་པར་མི་བྱའོ།",
    "དགེ་སློང་མ་གོས་མེད་པ་ཅན་གྱིས་འདུག་པར་མི་བྱ་བ་དེ་ལ་རྡུལ་གཟན་ནི་གཅེར་བ་བསྐྱབ་པའི་གོས་ཉིད་ཡིན་པས་དེས་རྔུལ་གཟན་གྱོན་ན་གཅེར་ཐེར་འདུག་པའི་ཉེས་པ་མེད་པ་ཡིན་ནོ།",
    "བསྙེན་གྱི་དྲུང་དུ་འདུག་པར་མི་བྱའོ།",
    "བསྡུ་སྐྱོགས་མ་བྱས་པར་བརྩམ་པར་འདུག་ན་གནས་ཇི་ལྟ་པ་བཞིན་དུ་མཁོས་སུ་དབབ་པར་བྱའོ།",
    "ཐེག་གསུམ་རིགས་ཅན་རང་རང་སྐལ་བ་དང་།",
    "རང་རང་ནུས་མཐུ་མི་ཞུམ་ཆེར་ངོམས་ཤོག།",
    "ལུས་ནི་གཅན་གཟན་འདུག་གནས་རི་དྭགས་འདྲ།",
    "མི་འཆིའི་ཐབས་ནི་མི་གདའ་སྟེ།",
    "འདུག་རུང་མི་རུང་ཐག་མ་ཆོད།",
    "ཉམས་སུ་ལེན་པའང་དཀའ་བར་གདའ།",
    "གཅིག་པུར་ཞག་གཅིག་འདུག་མ་མྱོང་།",
    "མི་འཆི་འདུག་ས་གཅིག་ཀྱང་མེད།",
    "ཐམས་ཅད་འདི་ཡིས་བསླུས་ནས་གདའ།",
    "འཆི་བདག་བཀག་ས་ཨེ་གདའ་ན།",
    "འཐེན་ས་གཏོང་ས་ཨེ་གདའ་ན།",
    "བགོ་ནས་ཁུར་ཐབས་ཨེ་གདའ་ན།",
    "ཕྱོགས་འགོ་ཙམ་ཞིག་ཅིས་ཀྱང་ཤེས་དགོས་གདའ།",
    "མུ་སྟེགས་མིན་ཀྱང་མུ་སྟེགས་འདྲ་ཉན་གདའ།",
    "བོན་པོ་མིན་ཀྱང་བོན་དང་འདྲ་ཉན་གདའ།",
    "འོག་ནི་ས་ཚོང་རྡོ་ཚོང་ཡིན་འདུག་པས།",
    "དེ་ལྟར་མིན་པར་བེ་རོ་ཙ་ན་ཡིས།",
    "སེམས་ནི་སྟོང་པར་འདུག་པས་བདག་མ་གྲུབ།",
    "ཕན་ཡོན་ཆེན་པོ་མི་འབྱུང་སྐྱོན་ཞིག་གདའ།"
  ]
}