    "གཅིག་པུར་འདུག་ནས་སྒྲུབ་པར་ཁས་འཆེ་ཡང་།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའི་གང་ཟག་སྤོབས་པ་ཉམས་སུ་མ་ལོན་པ་དེ་དག་ལ་དགག་པ་དང་སྒྲུབ་པ་ག་ལ་ནུས།",
    "མཐར་ཤར་ཕྱོགས་ནས་སྒོ་གཅིག་ཕྱེ་ནས་ནང་དུ་ཕྱིན་པར་སྣང་ནས་གཙུག་ལག་ཁང་ཤིན་ཏུ་བཟང་བ་གཅིག་འདུག།",
    "རྒྱལ་པོ་པེ་དཀར་ཁོ་ཆོ་འཕྲུལ་གཅིག་སྟོན་གྱིན་འདུག་པ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པའི་དོན་ཅི་ལགས་ཞུ་ཡིན་འདུག་པ་ལ།",
    "ཁྱེད་རང་ཚགས་གྱིས་ལ་དར་འདིས་དེའི་ན་བཟའ་གྱིས་གསུང་།",
    "ཧོར་གྱི་ལྷ་པ་གྲལ་མགོར་འཇོག་པ་ཡོད་པར་འདུག།",
    "ས་ཆོག་མི་ཤེས་པར་འདུག་པས་ས་གཞི་མ་བྱིན།",
    "རྟོགས་ལྡན་པ་ཁྱེད་ཀྱིས་འདི་དག་ཐུགས་ལ་བཞོག་ལ་སྒྲུབ་པ་མཛོད་དང་ཕན་ཐོགས་པ་ཆེན་པོ་གཅིག་འོང་གསུང་ནས་ཆེད་གཉེར་མཛད་ཅིང་འདུག།",
    "ཀ་ཞེས་བརྗོད་པའི་སྒྲ་རང་མཚན་ཡང་རང་མཚན་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་ཡི་གེར་མི་རུང་ངོ།",
    "སྤྱི་མཚན་དང་རང་མཚན་གཅིག་ཏུ་ཞེན་པའི་སྒོ་ནསཤིང་དང་བ་གླང་བླང་བ་དང་དོར་བ་ལ་འཇུག་པའི་ཕྱིར་ཤིང་དང་བ་གླང་ཞེས་སྤྱི་ཙམ་དེ་བརྗོད་པའི་སྒྲ་ནི་རིགས་ཀྱི་སྒྲ་ཡིན་ལ།",
    "དེའང་འཆད་པའི་ཚེ་སྤྱི་དང་རང་མཚན་སོ་སོར་འབྱེད་ཀྱི།",
    "བྱ་བ་དང་འདུག་པ་རིགས་པ་ལ་བྱ་བའི་རིགས།",
    "འདུག་པའི་རིགས་བྱ་བ་དང་།",
    "རོལ་བའི་ཉམས་གཙོ་བོར་གྱུར་པ་ལུས་ཀྱི་འདུག་སྟངས་དང་།",
    "འདུན་སར་འདུག་ནས་དེས་སྨྲས་པ།",
    "རྒྱ་མཚོའི་ནང་ན་འདུག་པའི་གྲུ་མཛེས་པ།",
    "དེའི་ཚེ་སླར་ཡང་བུ་འཆོལ་པས་རྟ་རྣམས་བཙལ་བས་ཁྱབ་འཇུག་ཁྲོས་པའི་མདུན་ན་རྟ་རྣམས་འདུག་ཅིང་།",
    "དེ་ཡང་རལ་པའི་ཁྲོད་དུ་འདུག་ཅེས་ཅེས་ཡུན་རིང་དུ་བཞག་གོ།",
    "འོན་ཀྱང་རང་ཉིད་ནང་པ་ཡང་མཚོ་དེ་ལ་ཀླུའི་རྒྱལ་པོ་མ་དྲོས་པ་གནས་ཤིང་།",
    "སློང་བ་པོ་རྣམས་ཀྱིས་ཁྱེད་ཀྱིས་ནོར་བཏང་བ་རྣམས་སློང་བ་པོ་ཁོང་རང་རྣམས་ཀྱི་ནོར་དུ་བསམས་ནས་ལེན་པའི་ཕྱིར་རོ།",
    "ཙོག་པུར་འདུག་སྟེ།",
    "དངོས་གཞིའི་དུས་ནི་ཙོག་ཙོག་པུར་འདུག།",
    "རྐང་རྟེན་བཅས་པའི་ཁྲི་ལ་རབ་འདུག་ཅིང་།",
    "གོས་ཀྱི་སྟན་དེ་ལ་ནི་རབ་འདུག་ནས།",
    "ཨ་ར་པ་ཙ་ན་ལ་སོགས་པ་བསྒོམས་པས་དེའི་དོན་ལ་བཟོད་པ་སྐྱེ་བ་ནི་བཟོད་པའི་གཟུངས་སོ།",
    "ཉིད་ཕྱོགས་ཀྱི་གོས་ཅན་གྱི་ཚུལ་གྱིས་འདུག་གོ།",
    "སྒྲིབ་གཡོགས་ཀྱིས་ལན་པར་བསམས་ཏེ་གོས་དང་བྲལ་བར་འདུག་ཀྱང་མ་རྙེད་པས།",
    "རལ་པའི་ཚོགས་ཀྱིས་ནགས་ཁྲོད་དེ་གང་བར་བྱས་ཏེ་འདུག་གོ།",
    "སྣུམ་གྱི་དྲི་མ་བཏོན་ཏེ་སྦྱར་བས་ཤིན་ཏུ་གསལ་པོ་བྱུང་བས་ཉིད་ཀྱི་ཐུགས་ལ་འབྲས་བུ་བཟང་པོ་འདོད་ན་རྒྱུ་ལ་ནན་ཏན་དགོས་པར་འདུག་བསམ་པ་དེ་བྱུང་ངོ།",
    "དེ་མགོ་འཐོམས་ནས་ཕམ་པས་ཁོ་རང་ལྕེབ་པར་ཁས་བླངས་སོ།",
    "བྷ་ཏུ་ས་ཏུ་སཾ་ཀ་ར་ཞེས་གསུངས་ཏེ་བྲམ་ཟེའི་ཁྱེའུ་འདུས་བྱས་རུང་ཞེས་པར་གདའ།",
    "སློབ་དཔོན་གྱིས་ཕྲ་བ་ཏ་ཞེས་གསུངས་ཏེ་གསལ་བའི་ཕྱིར་རོ་ཞེས་གསུངས་པར་གདའ།",
    "སློབ་དཔོན་གྱིས་ཤིང་ཕུང་འདིའི་རྩ་ནས་ཉན་པའི་རྣལ་འབྱོར་པ་དེ་མ་སླེབ་པར་འདུག་པ་གསུངས་པས།",
    "སྔར་མ་གྲགས་པའི་རིགས་པ་མང་པོ་འདུག།",
    "མཁས་པ་རྣམས་ཀྱིས་ཁྲེལ་ཞིང་རང་ཉིད་ངོ་ཚ་བའི་གནས་ཡིན་ནོ།",
    "ཞེས་འཁོད་འདུག་པ་ལྟར།",
    "ཨ་ཞང་ལགས།",
    "བོད་ནང་དུས་འགྱུར་བྱུང་རྗེས་ཨ་ཞང་ཨག་ལོད་ལགས་དང་བཟའ་ཟླ་པདྨ་ལགས་གཏན་ཞལ་གཉིས་དང་།",
    "ཨ་ཞང་ཨག་ལོད་ལགས་ཀྱིས་༡༩༦༣ ལོ་ནས་བཟུང་ཤོད་རོང་བདེ་གླིང་གཞིས་ཆགས་ཀྱི་རུམ་གདན་བཟོ་གྲྭའི་ནང་མི་ལོ་ཉི་ཤུ་རྩ་གྲངས་རིང་བལ་སྒྲུབ་ཚོང་ལས་ཞབས་ཞུ་ལྷག་བསམ་རྣམ་དག་ངང་ཞུས་པར་བརྟེན་བཟོ་ལས་ཁང་ནས་གཟེངས་བསྟོད་ཕྱག་འཁྱེར་ཡང་གནང་ཡོད།",
    "ཨ་ཞང་འཇམ་དཔལ་ལགས་དང་བཟའ་ཟླ་ཚེ་རིང་ཉི་མ་ལགས་གཉིས་༡༩༦༡ ལོར་བལ་ས་ཤར་ཁུམ་བུར་སྐྱབས་བཅོལ་དུ་འབྱོར་ཞིང་།",
    "དིང་སྒང་སེར་ཕྱུག་ཨ་ཞང་རྡོ་རྗེ་ལགས་དང་།",
    "ཨ་ཞང་ཕན་ཀུན་བཟང་ལགས།",
    "༡༩༥༨ ལོའི་ཟླ་མཇུག་ཏུ་གུས་རང་གཞིས་རྩེ་ནས་ཕྱིར་ལོག་འགྲོ་སྐབས་རྒྱ་དམར་གྱིས་དིང་རི་བར་འཁོར་ལམ་གསར་བཟོ་ཟིན་འདུག་པ་མ་ཟད་ཤེལ་དིང་གཉིས་ལ་རྒྱ་དམག་ཕོན་ཆེ་སྔོན་འབྱོར་ཐོག་དིང་རི་ནས་ཕ་དྲུག་རྫ་རོང་ཕུ་བར་འཁོར་ལམ་གསར་བཟོའི་ཆེད་ལམ་བཟོ་བ་ཆིག་སྟོང་ལྷག་ཙམ་འབྱོར་ཞིང་གུས་ཚོའི་ཁང་པ་དང་སྐྱ་རའི་ནང་རྒྱ་མི་ལམ་བཟོ་བ་ལྔ་བཅུ་ནས་དྲུག་ཅུ་བར་སྦྲ་གུར་ཕུབ་ནས་བསྡད་པ་དང་།",
    "དེ་བཞིན་མི་ཚང་ཆེ་ཁག་ཚང་མའི་ནང་རྒྱ་དམག་དང་རྒྱ་མི་ལམ་བཟོ་བ་ཕོན་ཆེ་བསྡད་པའི་ཐོག་དིང་རིའི་གཡས་གཡོན་ས་སྟོང་ཐང་དཀྱིལ་ནང་སྦྲ་གུར་ཕུབ་ནས་བསྡད་འདུག་སྐབས་དེར་རྒྱ་མིའི་དམག་མི་དང་ལམ་བཟོ་བ་གཉིས་ཀྱི་ཟས་གོས་དབར་ཡག་ཉེས་ཁྱད་པར་ཆེན་པོ་འདུག་རྒྱ་མི་ལམ་བཟོ་བ་དེ་དག་ཟི་ལིང་སྟོད་སྨད་ནས་ཡོང་སྐོར་གོ་ཐོས་བྱུང་།",
    "ཚེས་༦ ཉིན་བལ་ས་ཤར་ཁུམ་ཐང་སྨད་དུ་ཨ་ཞང་བསྟན་འཛིན་ལགས་ཀྱི་ཁང་པར་གནས་གཡར་ཞུས།",
    "ཨུ་ཡོན་འོས་བབས་ཡོད་པ་རྣམས་མི་ངན་གྱི་དཀྲོག་གཏམ་ལ་བལྟས་ནས་ཡུལ་གྱར་དུ་ཕྱིན་འདུག་པ་ད་ཆ་རང་ཡུལ་དུ་ཕྱིར་ལོག་ཡོང་ན་དགའ་བསུ་དང་།",
    "སྔོན་བྱས་ལ་རྩད་གཅོད་སོགས་གང་ཡང་མེད་ཅེས་བྲིས་འདུག་པར།",
    "བུ་གཉིས་འདི་གར་སྡོད་དུ་མ་བཅུག་པར་ཤར་ཁུམ་བུར་བྲོས་བྱོལ་དུ་གཏོང་མི་ང་རང་ཡིན།",
    "དེ་ནས་ཨ་ཞང་ཨག་ལོད་ལགས་ཀྱི་ནང་མི་དང་།",
    "རྒྱ་བལ་ནང་གནས་མཇལ། ། ཕྱི་ལོ་༡༩༥༩ ཟླ་༡༢ པའི་ནང་ཨ་ཞང་ཨག་ལོད་ལགས་ནང་མི་དང་།",
    "ཨ་ཞང་ཨག་ལོད་ལགས་དང་།",
    "གུས་པར་ཟུར་དུ་ཁྱེད་རང་འདི་གར་བཞུགས་འདོད་ཡོད་ན་བླ་བྲང་ནས་ནམ་སྡོད་བར་ཁང་པ་ཞིག་རིན་མེད་ཕུལ་ཆོག་ཅེས་གསུངས་བྱུང་།",
    "ཁུམ་སྟོད་ལ་སོགས་པའི་ས་སྟོང་གར་ཡོད་སར་སྦྲ་གུར་ཕུབ་ནས་བཞུགས་འདུག་བལ་ས་ཤར་ཁུམ་ནི།",
    "ནོར་བུ་མི་འདུག་མ་གསུངས།",
    "ལོ་དྲུག་དཀའ་སྤྱད་ཀྱི་བོད་དགོན་གནས་འཛིན་ལ་དྭགས་དགེ་སློང་བློ་བཟང་བཀྲ་ཤིས་ལགས་གཉིས་བལ་ས་ཤར་ཁུམ་བུར་བཙན་རྒོལ་རྒྱལ་སྐྱོབ་ཀྱི་དྭང་བླངས་མི་འགྲོ་འཚོལ་སྒྲུབ་ཏུ་བཏང་གནང་འདུག་ཀྱང་།",
    "རྒྱ་གར་དང་བལ་པོའི་ཁྲལ་ས་གཉིས་ཀྱི་གཞོགས་གཡས་སུ་རྒྱུག་ཆུ་ཞིག་ཡོད་པར་འགྲོ་ཟམ་གཅིག་ཇ་ཡེ་ན་གར་གྲོང་གདལ་གྱི་འཁྲིས་སུ་ཡོད་འདུག་དགོང་དྲོ་ཆུ་ཚོད་༥ པ་ཙམ་ལ་ཕུར་བུ་ཚེ་རིང་ལགས་དང་།",
    "སྐྱ་མདའ་གཏོང་དུས་སངྒཱའི་གྲོང་གདལ་གྱི་འཁྲིས་སུ་སླེབས་འདུག་པ་གུས་རང་བལ་ཡུལ་དང་ཤར་ཁུམ་དབར་ཐེངས་ཁ་ཤས་འགྲོ་མྱོང་ཡོད་ཀྱང་།",
    "ཁོང་ནི་བཙན་རྒོལ་རྒྱལ་སྐྱོབ་ཀྱི་སྒྲིག་འཛུགས་ཡོངས་ཀྱི་དབུ་འཁྲིད་ཡིན་འདུག་ཀྱང་མཇལ་འཕྲད་ཞུ་མྱོང་མེད།",
    "ཌོག་ཊར་ཨིག་ལོབ་བསད་དེ་གངས་ལ་བརྒལ་ནས་བོད་ནང་བྲོས་རྒྱུ་གཏན་འཁེལ་ཟིན་འདུག་ན།",
    "གུས་ཚོ་ལཱཁ་ནའུ་ནས་དིལླིར་འབྱོར་ཉིན་སྐྱེད་མ་ཚེ་རིང་སྒྲོལ་མ་ལགས་ནས་ཉི་མ་ཚེ་རིང་ལགས་ཀྱི་ནང་མི་བརྒྱུད་གུས་ལ་ཕྱག་བྲིས་ཤིག་གནང་འདུག་པའི་ནང་།",
    "དེ་སྐབས་རྒྱ་གར་གྱི་ས་གནས་མང་པོ་ནས་ཕེབས་པའི་བོད་མི་སུད་ཚོང་པ་ཁྱིམ་ཚང་ལྔ་བཅུ་ལྷག་ཙམ་ཞིག་དམག་མིའི་རས་གུར་རྙིང་པའི་ནང་བཞུགས་འདུག་ཕྲན་དང་།",
    "ཨོ་རི་ས་བཅས་ཀྱི་སུད་ཚོང་བ་ཁྱིམ་ཚང་བཅུ་གསུམ་ཙམ་ཡོད་འདུག་པ་ཚང་མ་མགྲོན་ཁང་དེར་བཞུགས་འདུག་དེ་སྐབས་ཀྱི་བོད་མི་སུད་ཚོང་བ་ཚང་མ་ཡ་རབས་སྤྱོད་བཟང་ཤ་སྟག་ཏུ་མཐོང་།",
    "དེ་རྗེས་ཏི་རུ་མ་ལཱ་ཞེས་པའི་རྒྱ་གར་གྱི་གནས་སྐད་གྲགས་ཅན་ཞིག་འདུག་པ་དེར་མི་གླ་བཞི་མཉམ་འཁྲིད་ཀྱིས་སྦ་ལན་ཚོང་ཐུབ་མིན་ལྟ་བར་ཕྱིན་པར།",
    "སྐབས་གཅིག་མི་གླ་བཞི་བཅུ་ཙམ་ཟིན་འདུག་པས་རྒྱ་ཆེ་ཁུ་མ་བསྡུས་ཀྱི་དཀའ་ངལ་ཆེན་པོ་བྱུང་།",
    "༥ ངུརངཧང་༨ ང་རངམའིངབོད་རང་བན་༥ ངུཐུསངདང་༧།",
    "བསྔགས་བརྗོད་དང་ཐུགས་རྗེ་ཆེ་ཞེས་བཀའ་ཕེབས་འདུག་ཅིང་།",
    "ཁྱེད་ཚོས་ཀྱང་རང་མིའི་འཚོ་དོན་སུད་ཊར་ཚོང་ལས་ཐོག་སྤྱི་པའི་ལས་དོན་ལ་དོ་སྣང་ཆེད་བསྐྱེད་བྱེད་མུར་ཡོད་པ་གང་ལེགས་ལྟར།",
    "རྒྱ་གར་རྡོར་གླིང་དུ་དབུས་གཙང་སྐྱིད་སྡུག་ཅིག་ཡོད་འདུག་པ་ག་དུས་གསར་འཛུགས་གནང་མིན་གསལ་པོ་མི་དྲན།",
    "ཐག་ཆོད་ཀྱི་མི་འདུག་ན་ག་ལེ་ག་ལེར་གང་དགའ་ཅི་ལེགས་ཀྱི་བསམ་བློ་ཐོངས།",
    "གྲྭ་ཚང་རང་ནས་དོལ་རྒྱལ་བསྟེན་གསོལ་བྱེད་ཀྱི་མེད་པ་གསལ་ཤེས་ཀྱིས་མཆོད་ཡོན་འབྲེལ་བ་སྔར་བཞིན་ཞུས་པ་ཡིན།",
    "ས་གནས་མང་པོ་ཞིག་ལ་འགྲེམས་སྤེལ་བྱས་འདུག་ཀྱང་།",
    "མ་འོངས་པར་དུས་ཚོད་འཚམ་པོ་ཞིག་བྱུང་མཚམས་ཞི་བའི་གོམ་བགྲོད་བྱ་རྒྱུའི་ནང་ང་རང་ཡང་མཉམ་དུ་འགྲོ་བསམ་པ་ཡོད།",
    "ད་ལྟའི་དུས་ཚོད་འདིར་གཞིགས་ན་རྗེས་སུ་ང་རང་གང་དྲག་བསམས་ནས་སེམས་ནང་དངངས་སྐྲག་སླེབས་ཏེ་མི་བདེ་བ་ཞིག་ཆགས་ལེའུ་ཉེར་གཅིག་པ།",
    "གནས་ཚུལ་འདིའི་ཐོག་ང་རང་སྒེར་དང་།",
    "ལས་འགུལ་ནང་རང་ངོས་ནས་མཐུན་འགྱུར་གང་ཡོང་ཞུ་རྩིས་ཡོད།",
    "ཚེས་༢༦ ཉིན་བྷི་ནི་ནས་ཐོན་སྐབས་ཉིན་གང་ཆར་པ་བབས་ཏེ་ཇལ་ཇི་ལཱ་ཟེར་བའི་ལ་ཁག་གཉིས་བརྒྱུད་འགྲོ་དགོས་འདུག་པར་ལ་གཤམ་གྱི་ཟ་ཁང་གཅིག་ནང་དགོང་ཞག་བསྡད།",
    "༡༩༩༦ ཟླ་༡༢ ཚེས་༡༨ ཉིན་ཁོང་ཕྲན་སར་ཕེབས་ཏེ་ལྷམ་རལ་ནས་གོམ་པ་རྒྱག་རྒྱུ་དཀའ་ངལ་འདུག་པས་འཚེམ་དུ་འགྲོ་རྒྱུར་དགོངས་པ་གནང་རོགས་ཞེས་གསུངས་བྱུང་།",
    "ལྷམ་དེར་ལྟ་དུས་མཐིལ་ཚང་མ་ཁ་བྲལ་འདུག་པས་གསར་པ་ཉོ་རྒྱུའི་ཕྱག་དངུལ་ཡོད་མེད་བཀའ་འདྲི་ཞུས་པར།",
    "དོན་གྱི་ཆ་ནས་སྟོང་པར་གྱུར་ཟིན་པ་ཞིག་ལ་ངོས་འཛིན་གཙང་མ་གནང་འདུག་པ་མ་ཟད།",
    "དབུས་གཙང་རང་འབབ་ཐོག་འབུལ་ལམ་ཞུ་རྒྱུར་དགོངས་བཞེས་ཀྱིས་རྒྱ་གར་དངུལ་ཁང་ནང་ལོ་འཁོར་སྐྱེད་བཅོལ་ཞུས།",
    "ཚོགས་གཙོ་མཆོག་ནས་ཀྱང་ས་གནས་ཀྱི་བསམ་ཚུལ་ལ་བརྩི་མེད་ཀྱིས་དྲུང་ཆེར་དགེ་སྐྱོན་བཀའ་སློབ་གང་ཡང་གནང་མི་འདུག་པར་བརྟེན།",
    "ཞེས་སླར་ཡང་བདེན་པ་མ་ཡིན་པའི་གནས་ཚུལ་གྱི་ཐོག་ནས་སྐབས་བརྒྱད་པའི་རྒྱུན་ལས་རྣམས་ལ་མིང་ཤས་བཟོས་འདུག་པ་ནི་རྒྱལ་གཅེས་ལྷག་བསམ་གྱིས་ཕྱུག་པའི་དབུས་གཙང་དབུས་རྒྱུན་ནང་ལོ་མང་མི་རྒྱུ་གཉིས་ཀྱི་ཐོག་ནས་ཞབས་ཕྱི་ཞུ་མཁན་གུས་པའི་ལས་རོགས་ཚོར་དོན་མེད་མིང་དབུས་གཙང་ནས་མི་ཚེ་དོན་ལྡན་གྱི་གཟེངས་བསྟོད།",
    "ཆིག་སྒྲིལ་ཚོགས་པའི་ནང་ཞབས་ཞུ། ། ཕྱི་ལོ་༡༩༦༤ ལོར་རྡོར་གླིང་དུ་དང་ཐོག་ཆིག་སྒྲིལ་དབུས་རྒྱུན་སྐབས་དང་པོ་ནས་དྲུག་པའི་བར་རྩེ་དྲུང་འཕན་པོ་བློ་བཟང་ཡེ་ཤེས་ལགས་ཚོགས་གཙོ་བསྟུད་མར་བདམས་ཐོན་བྱུང་བ་ལྟར་ལས་ཁུར་ཞུས་མཐར་སྐུ་ཚེའི་འཕེན་པ་རྫོགས་འདུག་༡༩༨ ནས་༡༩༨༤ བར་རྒྱུན་ལས་སྐབས་བདུན་པར་དཀར་མེ་ཁང་ཕུན་ཚོགས་བཀྲ་ཤིས་ལགས་ཚོགས་གཙོའི་ལས་ཚབ་དང་།",
    "རྒྱུན་ལས་ཚང་མས་ཡོན་ཏན་རྒྱ་མཚོ་ཁྱེད་རང་དངུལ་གཉེར་ལས་ཚབ་འགན་བཞེས་གནང་དགོས་ཞེས་ཡང་ཡང་ཨུ་ཚུགས་གནང་བར་བརྟེན་བཀའ་ངོ་ལྡོག་མེད་ཀྱིས་དངུལ་གཉེར་ལས་ཚབ་བྱ་རྒྱུ་ཁས་ལེན་ཞུ་དགོས་བྱུང་།",
    "དུས་དེར་རྒྱལ་པོ་ཆེན་པོ་ཡིས་འོ་ན་བློན་ཚོགས་རྣམས་ཉོན་ཅིག་ང་རྒྱལ་པོའི་བསམ་ཚུལ་ཨེ་འདྲ་གདའ་ཟེར་ནས་ཐུགས་འཁྲུགས་པའི་ཚུལ་གྱིས་འགྲོ་སྡོད་ཀྱི་གླུ་འདི་བླངས་སོ།",
    "གང་དགོས་རང་རང་བསམ་བློ་ཐོངས།",
    "དགོས་པ་ལར་ནས་མི་འདུག་བསམ།",
    "ཁྱེད་བློན་ཚོགས་ཐུགས་དགོངས་ཅི་འདྲ་གདའ།",
    "༡༢་ང་རང་བསམ་ཚུལ་དེ་འདྲ་གདའ།",
    "༡ དང་རང་རྒྱལ་ལ་བསྟོད་པ་མི་བྱེད་པར།",
    "ལ་ལས་ཅེས་གསུངས་ནས་རྔམ་སྟབས་ཀྱིས་གསེར་ཁྲིའི་ཐོག་ནས་ཧོར་འདུག་ཅིག་བྱས་ཏེ་བསྡད་པ་ལ།",
    "འགྲམ་བཅར་ན་ཨེ་གདའ་ལྟོས་ལ་ཤོག།",
    "གོ་བོས་ཅི་ཡིན་སྙམ་ནས་ཡི་གེ་ལ་བལྟས་པས་འགྲོ་དགོས་ལུགས་སོགས་འདུག་པས།",
    "ང་རང་ཞག་བཅུ་ལས་མི་འགྱངས་བར་ཐོན་འོང་ཟེར་ནས།",
    "བདེ་སྐྱིད་འབྱུང་ཞིང་ཇི་འདུ་གདའ།",
    "གླིང་ནམས་ཀྱིས་རྒྱ་ཚོ་ལ་ཡིད་དད་པའི་ངང་ནས་གསོལ་བ་རྩེ་གཅིག་ཏུ་བཏབ་ནས་བསྡད་པར་གདའོ།",
    "བླ་བྱའི་མགྲིན་པ་ལ་ཐེབས་ཏེ་ཁོ་རང་འཕུར་གྲབས་བྱས་ཀྱང་སྔགས་ཀྱིས་མཐུས་འཕུར་མ་ནུས།",
    "ཆང་རང་དང་ང་ངོ་མ་ཤེས་ན།",
    "གདའ་ག་མར་གྱིས་བརྒྱན་པ་དེ་ལ་ངོ་ཚ་ཡང་བྱ་ཐབས་གཞན་མ་བྱུང་།",
    "ཕྱི་ཉིན་ལྟོས་མེད་ཀྱིས་གླིང་དཀར་སྟོད་ལ་ཆས་པར་གདའོ།",
    "རང་རང་འགོ་དཔོན་སྔར་དང་མཚུངས།",
    "ཁོང་རྣམས་ཀྱིས་གསུང་གླེང་ཞིབ་རྒྱས་མང་དུ་མཛད་པར་གདའོ།",
    "དཔོན་འགྱིས་འབུལ་བ་བརྒྱབ་སྟེ་གསུང་གླེང་ཞིབ་རྒྱས་མཛད་པར་གདའོ།",
    "ཉི་མ་འབུས་དུས་དེ་ཙ་ན་དཔའ་འབུམ་པའི་རྒྱ་ཚ་ཞལ་དཀར་དེརགྱི་ཟེར་མདངས་འཕྲོ་བ་དགྲ་ལྷ་འཁོར་གྱིས་བསྐོར་བ།",
    "རྒྱ་རང་རང་འབབ་ཚུལ་ཤམ་མཐུད་གྱིས།",
    "བུ་དཔའ་བོའི་ལག་རྗེས་འདུག་ཟེར་ན།",
    "རང་རང་རྟ་ལ་སྒ་ཆས་སྤྱོད།",
    "པ་རང་རང་བཟའ་བཏུང་ལེགས་པར་གྱིས།",
    "ཞིབ་ལྟ་བྱས་ཚེ་མཚལ་མིན་པ་ཞིག་ཏུ་འདུག་པ་མཐོང་ཞིང་།",
    "སྟོབས་རྫུ་འཕྲུལ་ཡོད་ན་སྟོན་རིན་གདའ།",
    "འགྲུབ་རྒྱུའི་ལས་དེ་ཚར་ནས་གདའ།",
    "ཡུན་རིང་བོ་འདུག་པའི་རྒོད་པོ་མིན།",
    "ནས་ང་རང་ངར་ཆེན་མཚོན་གྱི་འོག་ཏུ་དྲངས།",
    "བློན་ཚོགས་རྣམས་པོ་དེ་གསེར་ཁྲིའི་ཐོག་ཏུ་ཧོར་འདུག་ཅིག་བྱས་ནསདམག་བཀོད་དང་འགྲོ་སྡོད་ཀྱི་གླུ་འདི་བླངས་སོ།",
    "རང་རང་ལས་དམག་དྲོངས་ལ་ཤོག།",
    "རང་རང་ལས་དམག་དྲོངས་ལ་ཤོག།",
    "རང་རང་ལས་དམག་ཅི་ཡོད་སོགས།",
    "དཔུང་རོགས་རང་རང་དམག་དཔུང་བཅས།",
    "ང་རང་རྒྱལ་བློན་རྣམ་པ་ཚོས།",
    "འཐབ་པའི་རྟིང་མ་འདུག་པས་ན།",
    "ད་ནི་ང་རང་བསད་ཀྱང་བཟོད་ནུས་ཏེ།",
    "དམར་གསོད་གཏོང་ལས་མི་འདུག་ཀྱང་བློན་རྒན་མ་འོངས་ད་མཁྱེན་འདི།",
    "ང་རང་རྒྱལ་བློན་རྣམ་པ་ཚོ།",
    "ངར་ཤུགས་ཅི་འདུག་དེ་རིང་ལྟ།",
    "དེ་རིང་གླིང་སྒར་གཏོར་བ་ལས་མི་འདུག་སྙམ་ནས་བསྡད་པ་ན།",
    "གླིང་དཔའ་རྟུལ་དང་གེ་སར་སོགས་ཀྱིས་འགྲན་མ་ནུས་པའི་མི་དེ་འདྲ་ཞིག་གདའ།",
    "དམའ་རྟ་རྫི་ཡན་ཆད་ཚང་མ་སྤྲུག་ཅིང་འདུག་གོ།",
    "དེ་ལན་མ་སྤྲད་འདུག་ཐབས་ཅི།",
    "ན་མི་དམར་རྟ་དམར་ཅན་ཞིག་འདུག།",
    "རཏི་ཁས་ལེན་དཔའ་རྟུལ་བརྒྱད་ཅུ་གདའ།",
    "ལས་དམག་ཁྲི་ཚོ་བཅུ་ཙམ་གདའ།",
    "ཐམས་ཅད་སྐྲག་སྟེ་ཡིད་མི་བདེ་བའི་ངང་དུ་འདུག་ལ།",
    "ཆུ་ཤོད་རི་བོ་ཐང་ལ་སླེབས་ཙ་ན།",
    "དུས་དེར་ཇག་དཔོན་ཁོ་ཤིན་ཏུ་ཁྲོས་ཏེ་རལ་གྲི་ཤུབས་ལས་བཏོན་ཏེ་ཚོས་འགྲུབ་ལ་ཀླུ་འདི་བླངས་པར་གདའོ།",
    "མདུང་འགྲན་བྱས་ཏེ་དཔའ་སྟོབས་འདྲ་མཉམ་དུ་འདུག་པའི་སྐབས་དེར།",
    "དེ་ནས་ཁོང་གཉིས་ཀྱིས་མགོ་འཕྲུ་རྣམས་ཁྱེར་ཏེ་ཚུར་བྱོན་པར་གདའོ།",
    "བ་བླངས་པར་གདའོ།",
    "ང་བློན་པོའི་སེམས་ལ་འདི་འདྲ་འདུག་ཟེར་ནས་གླུ་འདི་འབར་བའི་ཟིར་སྒྲ་ལ་དྲངས་ཏེ་བླངས་སོ།",
    "ཡང་༡ གདའ་ལི་ཁྱི་ཡི་ཟུག་སྒྲ་དེ།",
    "ཁས་ལེན་དཔའ་རྟུལ་བརྒྱད་ཅུ་གདའ།་",
    "ནའི་ཁ་བ་དཔུང་རོགས་དཔའ་རྟུལ་ཁ་ཤས་གདའ།",
    "གོ་བཙན་དཔའ་རྟགས་འདྲ་འདུག་ཟེར།",
    "གོ་བཙན་དཔའ་རྟགས་འདྲི་འདུག་ཟེར།",
    "གདའ་ཟེར་ནས་གླུ་འདི་ལྟར་བླངས་སོ།",
    "ང་རང་ལ་ཉི་མ་དེ་སྔ་ཕན་ཆད་ལ།",
    "དཔེ་བཞག་ན་འདྲ་མ་ཨེ་འདྲ་གདའ།",
    "དུས་དེ་ཙ་ན་ཡ་མེད་རྒོད་འབྲོང་ནག་པོ་དེས་ཕ་བོང་འབྲོང་གཡག་ཙམ་ཞིག་ལག་གཡས་ཀྱིས་ཕྱིར་ཏེ་གེ་སར་གྱི་གདོང་བཀག་ནས་གླུ་འདི་བླངས་སོ།",
    "མེ་གླིང་རྒྱལ་བློན་རྣམས་ཀྱང་རང་ཡུལ་དུ་གཡུག་བྱེད་བཞིན་འདུག་ལ།",
    "མེ་གླིང་རྒྱལ་བློན་རྣམས་ཀྱིས་བྱུ་རུའི་རབ་གསལ་ཁ་ནས་ཤེལ་གྱི་རྒྱང་མཐོང་བཙུགས་ཏེ་བལྟས་ཙ་ན།",
    "གདའ་ལི་ཁྱི་བཞིན་ཞགས་པས་བཟུང་།",
    "མི་འདུག་འཇའ་ཡི་ཡུལ་ལ་འགྲོ།",
    "བསྐལ་བ་མ་སྟོང་བར་དུ་མ་གཏོང་ཟེར་བའི་ཡི་གེ་ཡང་བྲིས་པར་གདའོ།",
    "ཟེར་ཏེ་ངུ་འབོད་བྱེད་ཅིང་རྒྱ་ཚའི་ལག་པར་འཇུས་འཇུས་བྱས་ཙ་ན།",
    "འདི་ལྟ་བུ་གངས་ཅན་སྒྲུབ་བརྒྱུད་ཀྱི་ཤིང་རྟ་ཆེན་པོ་གཞན་དག་དང་བསྡུར་ནའང་ཁྱད་བོན་དུ་འདུག་གོ།",
    "དེ་ནས་ལུང་བསྟན་བཞིན་འགྲོ་དོན་དུས་ལ་བབ་པར་རྟགས་དང་རྨི་ལམ་སོགས་ལ་བརྟེན་ཏེ་དགུང་ལོ་ལྔ་བཅུ་ཤིང་བྱ་སྤྱི་ལོ་༡༤༥ལོར་གནས་དེར་ཕེབས་ཚེ་ས་གནས་དེར་བཞུགས་པའི་རྣལ་འབྱོར་བ་གཉིས་ཕེབས་གྲབས་བྱེད་ཀྱིན་ཁལ་བཀལ་གྱིན་འདུག་པ་འཕྲད།",
    "མཐར་ཡང་རང་བཞིན་མེད་པའི་གསུང་འཐོབ་པར་འགྱུར།",
