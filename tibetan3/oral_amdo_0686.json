    "བྱང་གི་ཕྱོགས་རྣམས་སུ་གོ་རིམས་བཞིན་དུ་མཐའ་ཡས་དང་།",
    "ཆུ་སྔོན་དག་གིས་ཡོངས་གང་བའི།",
    "དེ་ནས་ཛ་ནཾ་ཛ་ཞེས་བྱ་བའི་སྔགས་ཀྱིས་སམ་ཡིད་ཀྱིས་རྡོ་རྗེ་ལྕགས་ཀྱུ་སྤྲོས་ནས་ཀླུ་ཐམས་ཅད་བཀུག་ནས་རང་རང་གི་གནས་སུ་བཞུགས་ཏེ་མཆོད་ཡོན་དབུལ་བ་དང་།",
    "དེར་བཀུག་ནས་དེ་རྣམས་ཀྱི་ལྕེ་ལ་ཡི་གེ་ནཾ་བསྒོམས་ནས་ཡོན་ཆབ་ལ་སོགས་པ་སྔོན་དུ་སོང་བའི་སྦྱིན་སྲེག་གི་ཆོ་གས་རེ་ཞིག་དང་པོར་བུ་རམ་དང་།",
    "སྟེང་དུ་ཁྲོ་བོའི་མེས་མནན་པ་ཤིན་ཏུ་ཉམ་ཐག་པར་འགྱུར་ཏེ་ཆུ་སྐྱུག་པར་མོས་པར་བྱས་ན་ཀླུའི་ཚོགས་ངེས་པར་ཆར་པ་འབེབས་པར་འགྱུར་རོ།",
    "དབུས་སུ་ཡི་གེ་བཾ་ཧཱུཾ་ཡིག་དག་གི་ནང་དུ་སྤེལ་ལ་བྲི་བར་བྱས་ནས་ཆུ་བོའི་ཕར་ངོས་ཚུར་ངོས་ཀྱི་སའམ།",
    "ལྷོ་ཕྱོགས་སུ་ཁ་བལྟས་པའམ་ནུབ་ཕྱོགས་སུ་ཁ་བལྟས་པས་བཙིར་བས་ཆར་པ་འབབ་པའི་ཚུལ་གྱི་མེ་ཐབ་གྲུ་གསུམ་དུ་དུར་ཁྲོད་ཀྱི་མེ་ཕུ་ཡིག་གིས་སྦར་ཏེ།",
    "དེའི་དབུས་སུ་བཅོམ་ལྡན་འདས་སྟོབས་པོ་ཆེ་བསྒོམས་ནས་དེའི་ཞལ་དུ་ལྕེ་ལ་ཧཱུཾ་གིས་མཚན་པ་ལ་ཁྲོ་བོའི་རྣལ་འབྱོར་གྱིས་འཆོལ་བ་དང་མཐའ་དག་སྔགས་བཟླས་ཤིང་མཇུག་མ་ནས་བརྩམས་ཏེ་མཚོན་རྣོན་པོས་གཏུབ་ཅིང་གཏུབ་ཅིང་བརྒྱ་རྩ་བརྒྱད་ཀྱི་བར་དུ་སྦྱིན་སྲེག་བྱས་ན་ཆར་པ་འབེབས་སོ།",
    "དེའི་རྡོ་རྗེ་སྟེང་དུ་བསྒྲུབ་བྱའི་མིང་དང་སྤེལ་ནས་འདོད་པའི་རྒྱལ་པོའི་སྔགས་ཡུང་བ་དང་སྲིན་ལག་གི་ཁྲག་གི་ཝང་དང་བཅས་པས་བྲི་བར་བྱའོ།",
    "དེའི་དབུས་སུ་བསྒྲུབ་བྱའི་མིང་གི་ཡི་གེ་རྣམས་མྱོས་བྱེད་ཀྱི་ཁུ་བ་དང་།",
    "གི་ཝང་དག་གིས་བྲིས་ལ་པདྨའི་འདབ་མའི་རྩེ་མོ་ལ་གཤིན་རྗེ་གཤེད་ཀྱི་སྔགས་མཛུབ་མོའི་ཁྲག་དང་དུག་གིས་བསྒྲུབ་བྱའི་མིང་དང་བཅས་པ་བྲི་བར་བྱའོ།",
    "དགུག་པ་ལ་སོགས་པ་སྔོན་དུ་སོང་བས་ཐོད་པ་གཉིས་ཁ་སྦྱར་ནས།",
    "སེང་ལྡེང་གི་མེ་ལ་སྲོ་ཞིང་སྔགས་རེ་རེ་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་དེ་ལྟར་ན་ཞག་བདུན་གྱིས་ཁུགས་པར་འགྱུར་རོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱིས་བསྐྱོད་པར་མི་ནུས་པའི་ཕྱིར་མི་གཡོ་བའོ།",
    "མི་གཡོ་བའི་རྣལ་འབྱོར་གྱིས་རྐང་པ་གཡས་པའི་སྲིན་ལག་གི་ཁྲག་དང་།",
    "ཚ་བ་གསུམ་རྣམས་ལྷ་ཆེན་པོ་ལ་སོགས་པ་གང་འདོད་པར་རང་གི་ཆུང་མ་དང་བཅས་པ་ནི་ཇི་ལྟ་བ་བཞིན་དུ་བྲིས་ནས།",
    "རང་གི་སྔགས་བསྐུལ་བའི་ཚིག་དང་བཅས་པ་བརྗོད་ནས་གཤིན་རྗེ་གཤེད་ཀྱིས་དགུག་པར་གསུངས་པའི་ཆོ་གས་དགུག་པར་བྱའོ།",
    "རྡོ་རྗེ་བུ་མོ་དགུག་པར་བྱ།",
    "གནོད་མཛེས་ཀྱི་རྣལ་འབྱོར་དུ་བྱས་ནས་ཤིན་ཏུ་སྔགས་པའི་བུད་མེད་ཀྱི་ཐོད་པ་ལ་རྐང་པ་གཡོན་པའི་སྲིན་ལག་གི་ཁྲག་གིས་སྤྱན་ལ་སོགས་པའི་ནང་ནས་གང་འདོད་པ་བྲིས་ནས་རྡོ་རྗེ་ལྕགས་ཀྱུས་བྱིན་གྱིས་བརླབས་པའི་རྐང་པ་གཡོན་པས་དེའི་ཆུ་སྐྱེས་མནན་ནས་གཡོན་བརྐྱང་བ་དང་ལྡན་པས།",
    "མིག་གི་རྫི་མ་འགུགས་བྱེད་པ།",
    "དེ་ཉིད་ཀྱིས་ཚིག་གི་བརྡ་ལས་ཕྱིན་ཅི་མ་ལོག་པར་དོན་སྟོན་ཅིང་རྟོགས་པར་བྱེད་པ་དང་ལྡན་པའི་ཕྱིར་ངག་གི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་ཀྱིས་གནས་ལས་བྱུང་བའོ།",
    "ཞེས་བྱ་བ་ནི་བཀའི་འཁོར་ལོས་ཏེ་རང་གི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ཞེས་ཁ་ཅིག་འདོད་དོ།",
    "ད་ནི་འཁྲུལ་འཁོར་ལ་མ་ལྟོས་པར་རྣལ་འབྱོར་པ་ཐམས་ཅད་ཀྱིས་གང་འདོད་པའི་བུ་མོ་དགུག་པའི་དོན་དུ་གསུངས་པ།",
    "ཞེས་བྱ་བ་ནི་གཤིན་རྗེ་གཤེད་པོ་ལ་སོགས་པ་གང་འདོད་པའི་གཟུགས་སུ་རང་གི་སྔགས་ཀྱིས་བདག་ཉིད་བསྒོམས་ནས་སོ།",
    "མཆོག་ཅེས་བྱ་བ་ནི་བུད་མེད་ཀྱི་མཚན་ཉིད་དང་ལྡན་པའོ།",
    "རང་གི་ལྷའི་སྦྱོར་བས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་གནས་ཏེ།",
    "རང་གི་ལྷའི་གཟུགས་ཞགས་པ་དང་ལྕགས་ཀྱུ་འཛིན་པ་རྣམས་ཀྱིས་དེ་ཇི་ལྟ་བའི་རང་གི་གནས་ནས་བཅིངས་ཏེ་ཁྱེར་ནས་འོངས་པར་བསམ་པར་བྱའོ།",
    "རང་ཡང་དེའི་མིང་དང་སྤེལ་བའི་སྦྱོར་བར་རང་གི་སྔགས་ཛའི་མཐའ་ཅན་བཟླས་ནས་དགུག་པར་བྱའོ།",
    "ནམ་མཁའི་བུ་མོ་ཞེས་བྱ་བ་ནི།",
    "ས་འོག་གི་བུ་མོ་དགུག་པའི་དོན་དུ་གསུངས་པ།",
    "དེས་ཇི་ལྟ་བ་བཞིན་དུ་ལྷ་མ་ཡིན་གྱི་བུ་མོ་དགུག་པར་བྱའོ།",
    "བཙག་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་ཀྱང་གི་སྒྲས་གི་ཝང་ལ་སོགས་པ་གཟུང་ངོ།",
    "མཚན་མ་ཐོབ་པས་འདོད་པའི་རྒྱལ་པོ་ལ་སོགས་པ་གང་འདོད་པའི་སྦྱོར་བ་བྱས་ནས་ཟླ་བ་གཟས་ཟིན་པ་ལ་ཡི་གེ་ཧཱུཾ་ལས་རྡོ་རྒྱུས་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་རྡོ་རྗེ་ལྕགས་ཀྱུའི་གཟུགས་སུ་མོས་པར་བྱས་ནས་ཁར་ཞེས་བྱ་བ་ནི་རང་གི་རིག་མ་དང་གཉིས་སུ་མེད་པར་གྱུར་པས་ཕྱིའི་རིག་མའི་པདྨར་བཅུག་ནས་རྡོ་རྗེས་ཁ་བཅད་ནས།",
    "ཇི་ལྟ་བ་བཞིན་དུ་གྲུབ་པའི་རྡོ་རྗེ་ལྕགས་ཀྱུའི་ལྷ་ནང་དུ་གཞུག་པ་དང་སྤྲོ་བ་ལ་སོགས་པ་བྱས་ནས་གང་གི་ཚེ་བཟླས་པ་བྱས་ཏེ།",
    "ཟླ་བ་གཟས་ཟིན་པ་བཏང་གི་བར་དུའོ།",
    "གནོད་སྦྱིན་མོ་དགུག་པ་གསུངས་པ་རྣམ་པའི་མཆོག་ཀུན་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
