    "དུས་གསུམ་དག་གི་ལམ་དུ་བྱུང་།",
    "རྟག་ཏུ་གནས་པའི་ཡང་ཕྱིར་ནམ་མཁའི་ལམ་མོ།",
    "རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་ལ་བསྟོད་པ་གསུངས་ནས་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་ལ་བསྟོད་པ་གསུངས་པ།",
    "འདིས་ནི་རྣམ་པར་མི་རྟོག་པའི་སྤྱོད་པ་སྔོན་དུ་སོང་བ་ཉིད་གཉིས་སུ་མེད་པའི་དངོས་གྲུབ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཅེས་བྱ་བ་ནི་འདིའི་ཆོ་ག་ནི་པདྨའི་ནང་དུ་རང་གི་ས་བོན་གྱི་འོད་ཀྱིས་བཀུག་པ་ལ་སོགས་པའི་ཀུན་དུ་བཟང་པོའི་སྒྲུབ་ཐབས་ཀྱི་ཆོ་ག་ལས་གསུངས་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཇི་སྲིད་རེག་ལ་ལོངས་སྤྱོད་པ།",
    "གང་གི་ཕྱིར་ལུས་ལ་སོགས་པ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པའི་ངོ་བོར་བརྟགས་པའི་རང་བཞིན་སྐུ་ལ་སོགས་པའི་རང་བཞིན་དེ་ཁོ་ན་ཉིད་མ་ཡིན་ནོ།",
    "སྒྱུ་མ་ལྟ་བུར་མོས་པ་བྱས་ནས།",
    "དེའི་རྗེས་ལ་ངག་གི་ཞེས་བྱ་བ་ནི་བྱིན་གྱིས་བརླབ་པའི་སྔགས་སོ།",
    "གང་གི་ཕྱིར་འདིའི་དོན་བཅུ་པ་ལས།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་ཞེས་བྱ་བ་ནི་རིགས་པ་མ་ཡིན་པའི་རང་བཞིན་གྱི་ཏིང་ངེ་འཛིན་གྱི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ད་ནི་རིགས་ཀྱི་དབྱེ་བས་ཕྲ་མོའི་རྣལ་འབྱོར་བསྟན་པའི་ཕྱིར་རེ་ཞིག་ལྷའི་རྣལ་འབྱོར་གསུངས་པ།",
    "འདི་ནི་ཉེ་བར་མཚོན་པ་སྟེ་ཐམས་ཅད་རང་གི་གདན་ལ་གནས་པའི་རང་གི་ས་བོན་བལྟ་བར་བྱའོ།",
    "འདི་ཡང་ལྷ་ཐམས་ཅད་ཀྱི་རང་གི་ཁ་དོག་ཉེ་བར་མཚོན་པའོ།",
    "གང་གི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་ཚིག་འབྱིན་པ་སྟེ་སྤྲོ་བར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་བརྟན་པའི་མཚན་མ་ཐོབ་ནས་དེའི་འོད་ཟེར་ལས་སྤྲུལ་པའི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རྣམས་སྤྲོ་བར་བྱ་ཞེས་བྱ་བའོ།",
    "ད་ནི་ཕྲ་མོའི་རྣལ་འབྱོར་གྱི་སྔོན་དུ་བསྙེན་པ་ལ་འཇུག་པའི་ཆོ་ག་གསུངས་པ་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "གསུང་ནི་གསུང་གི་རང་བཞིན་གྱིས།",
