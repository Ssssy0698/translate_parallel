    "དེ་ལ་ཇི་ལྟར་དེ་བཞིན་དུ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པ་ཐོབ་པར་འགྱུར་བ་དེ་ལྟར་ད་ནི་རི་ལུ་བསྒྲུབ་པ་ལ་སྔོན་དུ་བསྙེན་པ་ལ་སོགས་པའི་སྒོ་ནས་གསུངས་པ་རང་གི་སྔགས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འདི་སྐད་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་གསུམ་མཆོད་བྱས་ནས་རང་གི་སེམས།",
    "དེ་བཞིན་དུ་རང་གི་ས་བོན་དང་མཚན་མ་རྣམས་ཀྱིས་གསུང་དང་ཐུགས་རྡོ་རྗེ་དག་ཀྱང་ཇི་ལྟ་བ་བཞིན་དུ་བསྐྱེད་དོ།",
    "ཐམས་ཅད་དུ་རང་གི་ས་བོན་དང་།",
    "རང་གི་སྔགས་ཀྱིས་རལ་གྲི་བསྒོམ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རལ་གྲི་གྲུབ་པའི་དུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་རང་གི་ས་བོན་གྱིས་རལ་གྲི་བསྐྱེད་ལ་ནམ་ཞིག་གྲུབ་པ་ན་དེ་བླང་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རི་ལུ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་ངོ།",
    "དེ་བཞིན་དུ་གསུང་དང་ཐུགས་རྡོ་རྗེ་ལ་སོགས་པ་དག་ཀྱང་རི་ལུའི་སྒྲུབ་པ་ལས་ཇི་ལྟར་རང་གི་ས་བོན་ལ་སོགས་པའི་ཁྱད་པར་བལྟ་བར་བྱའོ།",
    "གང་གི་ཚེ་ཤིན་ཏུ་སྟེང་དུ་འབར་བ་དེའི་ཚེ།",
    "དེ་བཞིན་དུ་ཡི་གེ་ཧཱུཾ་གིས་ལྕགས་གསུམ་གྱི་རང་བཞིན་གྱི་རྡོ་རྗེའོ།",
    "རང་རང་གི་རིག་མའི་སྔགས་ཀྱིས་བླང་བར་བྱའོ།",
    "ཨོཾ་ཀཱ་མ་བཛྲི་ནི་སིདྡྷཱ་སཱི་བི་ཤུདྡྷ་སཱི་སྭ་བྷཱ་བ་ག་ག་ན་ཨུཏྦྷཱ་བ་ཡོ་གེ་ན་སིདྡྷ་མཾ་པ་ར་མཀྵ་རེ།",
    "དངོས་གྲུབ་ཀྱི་མཚན་མ་མ་བྱུང་གི་བར་དུའོ།",
    "རྡོ་རྗེ་ལ་སོགས་པའི་སྒྲུབ་པ་གསུངས་པའི་ཆོ་གས་རང་འདོད་པའི་ལྷའི་སྦྱོར་བ་སྔོན་དུ་སོང་བས་རྩེ་གསུམ་ལ་སོགས་པའི་བསྒྲུབ་པས་རྩེ་གསུམ་གྱི་རིག་པ་འཛིན་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་གསུམ་བསྒོམས་པའི་དེ་མ་ཐག་ཏུ་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ཟླ་བ་ལ་ཡི་གེ་ཧཱུཾ་གིས་རྡོ་རྗེ་ཀྱོ་བ་བསྐྱེད་ནས་དེ་ཡོངས་སུ་གྱུར་པ་ལས་རྡོ་རྗེ་འཛིན་པ་ཆེན་པོ་ལྟ་བུ་རྩ་བའི་ཕྱག་གིས་རྡོ་རྗེ་ལྕགས་ཀྱུ་འཛིན་པ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པས་བྱིན་གྱིས་བརླབ་པ་དང་།",
    "ལ་ལ་དག་ནི་ཇི་ལྟར་འདོད་པའི་ལྷའི་བུ་མོ་རྣམས་ཀྱང་འདིས་དགུག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "སྔོན་དུ་སོང་བ་རྡོ་རྗེ་ཀྱོ་བའི་སྒྲུབ་པ་གསལ་བར་བྱ་བ་གསུངས་པ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཛིན་པ་འབའ་ཞིག་གི་སྦྱོར་བ་མ་ཡིན་གྱི།",
    "མཚན་མ་ཐོབ་པའི་རྡོ་རྗེ་འཛིན་པ་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་གྱིས་རང་གི་དཀྱིལ་འཁོར་ལ་གནས་པའི་ལག་པ་གཡས་པར་དངོས་སུ་ལྕགས་རྣོན་པོ་ལས་བརྡུངས་པའི་ལྕགས་ཀྱུའམ།",
    "ཞེས་པ་དེ་ནི་ངག་གི་དངོས་གྲུབ་ལ་སྦྱོར་བ་གསུངས་པ།",
    "རྡོ་རྗེ་སྐུ་ཞེས་བྱ་བ་ནི་རང་གི་ལྷའི་སྐུ་རྡོ་རྗེར་བདག་ཉིད་བསམས་ནས།",
    "གསང་བ་གསུམ་དམ་ཚིག་ནི་རང་གི་ལྷ་མོ་དེ་ཉིད་དོ།",
    "དེ་ཉིད་དངོས་གྲུབ་ཀྱི་བྱེ་བྲག་གི་སྦྱོར་བ་གསུངས་པ།",
    "གང་ཞིག་གསང་བ་བདག་གིས་བཤད།",
    "ལྕེའི་གནས་སུ་ཟླ་བ་ལ་གནས་པའི་ཧཱུཾ་ལས་བྱུང་བའི་ཡི་གེ་ཧཱུཾ་གིས་བྱིན་གྱིས་བརླབས་པ་རྡོ་རྗེ་དཀར་པོ་རྩེ་མོ་ལྔ་པ་བསྒོམས་པས་སོ།",
    "མཚོན་ཆ་མཆོག་གིས་དྲངས་ནས་ནི།",
    "མཆོག་གི་གཙོ་བོ་སྟེ་ངེས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡང་ན་བསྐྱེད་པའི་རིམ་པས་བྱེ་བྲག་གིས་སོ།",
    "ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོའི་བྱེ་བྲག་གིས་ཞེས་ལ་ལ་དག་འདོད་དོ།",
    "དེ་ཉིད་སྦྱོར་བ་སྟེ་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་རང་གི་ལྷའི་གཟུགས་སོ།",
    "རང་སྔགས་རྡོ་རྗེ་ཅན་ནི་རང་གི་ལྷ་རྣམས་སོ།",
    "གཉིས་པ་ལྷ་མོའི་གླུས་བསྐུལ་བ་སྔོན་དུ་སོང་བ་རང་གི་ལྷའི་ས་བོན་དང་ཕྱག་མཚན་གྱི་གཟུགས་སུ་ཞུ་བ་བསྡུས་པའི་ཚོགས་ཀྱི་རང་བཞིན་ནོ།",
    "དེ་ནས་རྡོ་རྗེ་བཞི་དག་གིས།",
    "ཞག་བདུན་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སྔོན་དུ་བསྙེན་པ་བྱས་པ་ལ་སོགས་པ་གང་གི་ཚེ་སྒྲུབ་པ་ལ་འཇུག་སྟེ།",
    "རང་གི་ལྷའི་བསྒྲུབ་པ་དང་།",
    "འདིས་རང་གི་དོན་དང་།",
    "དེའི་ཚུལ་ནི་བཟླས་པའི་མཚན་ཉིད་ཀྱི་ལམ་མོ།",
    "རིམ་པ་མ་ཡིན་པའི་བྱེ་བྲག་གིས་གང་སྤྲོ་བ་སྔོན་དུ་སོང་བའི་བསྡུ་བ་དེ་རྡོ་རྗེའི་མཐའོ།",
    "རང་གི་གནས་སུ་དགོད་པར་བྱ་བའི་ཕྱིར་འདིར་བཀོད་པའོ།",
    "སྐུ་ལ་སོགས་པ་བདག་མེད་པའི་སྒོ་ནས་རྡོ་རྗེ་གསུམ་རྫོགས་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རྡོ་རྗེ་གསུམ་མོ།",
    "གཟུགས་ཀྱི་བཟླས་པ་ལ་རིམ་གྱིས་རེ་ཞིག་སྤྲོ་བ་གསུངས་པ།",
    "རང་གི་སྔགས་ནི་སྣ་ཚོགས་འོད་ལྡན་པར།",
    "སྐུ་ལ་སོགས་པའི་རྡོ་རྗེ་རྣམས་རང་གི་མོས་པས་རང་བཞིན་སྤྱད་པ་སྔོན་དུ་སོང་བའི་རྣལ་འབྱོར་གྱིས་བཟླས་པ་གསུངས་པ།",
    "གཉིས་ཀའི་བྱེ་བྲག་གིས་སྟོང་པའི་ཕྱིར།",
    "གསུང་གིས་བཟླས་པ་གསུངས་པ།",
    "དེའི་རྣམ་པར་དཔྱད་པ་ནི་རིགས་པ་དང་ལུང་དག་གིས་སྐྱེ་བ་མེད་པའི་སྒོ་ནས་ཡང་དག་པར་གྱུར་པ་སོ་སོར་རྟོགས་པའོ།",
    "བཟང་པོ་ཡིན་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་རེ་ཞིག་དེ་བཞིན་དུ་སྟེ།",
    "བཞུད་པ་མ་ཡིན་པར་མོས་པ་སྟེ།",
    "རང་གི་རྡོ་རྗེ་རབ་གྲགས་པ་སྟེ།",
    "རང་གི་བདག་པོས་ཁྲོ་བོའི་ཚིག་ཏུ་བརྗོད་པའོ།",
    "གང་དུ་རང་གིས་སྤྲུལ་པའི་དཀྱིལ་འཁོར་པས་ཐོབ་པ་སྟེ།",
    "ཁྲོ་བོ་རྣམས་ཀྱི་དམ་ཚིག་ནི་རང་གི་བདག་པོའོ།",
    "སྤྲོ་བ་ལ་སོགས་པ་སྔོན་དུ་སོང་བས་བཟླས་པ་བྱ་བ་སྟེ།",
    "ཞེ་སྡང་གི་གནས་ཞེས་བྱ་བ་ནི་མི་བསྐྱོད་པ་ཉིད་ལའོ།",
    "དམ་ཚིག་ལ་སོགས་པས་ཐམས་ཅད་ཐུན་མོང་དུ་འདིའི་བཟླས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་བདག་པོ་ཞེས་བྱ་བ་ནི་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ལྷ་མོ་དྲུག་གོ།",
    "འདོད་པའི་ལོངས་སྤྱོད་དག་གིས་འགྲུབ།",
    "སྐུའི་བཟླས་པ་ལ་སོགས་པ་རང་གི་སྔགས་གསང་བ་སྔོན་དུ་སོང་བས་བྱ་བར་གསུངས་པ།",
    "རང་གི་དཀྱིལ་འཁོར་ལ་གནས་པ་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་པས།",
    "འོད་ཟེར་ལྔ་ཡི་བྱེ་བྲག་གིས།",
    "ཞེས་བྱ་བ་ནི་རིམ་དང་ཅིག་ཅར་གྱི་བྱེ་བྲག་གིས་སོ།",
    "སྐུ་གསུམ་རྡོ་རྗེའི་བྱེ་བྲག་གིས།",
    "ཞེས་དགོངས་པས་གསུངས་པས་རེ་ཞིག་དཀྱིལ་འཁོར་ཆེན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "གང་གིས་ཤེ་ན་གསུངས་པ།",
    "གང་གི་སྦྱོར་བ་ལས་གང་བྱ་བ་དེ་གསུངས་པ།",
    "འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་ལྷ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་ལས་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "ཅེས་བྱ་བ་ནི་ཞི་བ་དང་རྒྱས་པ་ལ་མ་གཏོགས་པ་གཞན་ཐམས་ཅད་ལ་འདིས་སྔོན་དུ་སོང་བས་བྱའོ་ཞེས་བྱ་བ་ནི་མན་ངག་གོ།",
    "ཁ་བཞི་པ་ཞེས་བྱ་བ་ལ་དབུས་ཀྱི་རྩེ་མོ་ལ་ཕྱོགས་བཞིའི་རྩེ་མོའི་སྦྱོར་བ་ལས་སོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་བྱེ་བྲག་གིས་སོ།",
    "གོང་བུའི་ཚུལ་གྱིས་སོ་ཞེས་བྱ་བ་ནི་གཅིག་གི་རྣམ་པའི་སྦྱོར་བས་སོ།",
    "འདི་ནི་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་ཚིགས་སུ་བཅད་པ་ཡིན་ཏེ།",
    "འོན་ཀྱང་མཚན་མ་འཛིན་པའི་བྱེ་བྲག་གིས་སོ།",
    "འཁོར་ལོ་ཆེ་ཞེས་བྱ་བ་ནི་ཁྲོ་བོའི་ཚོགས་དང་བཅས་པ་རང་གི་ལྷག་པའི་ལྷ་གཤིན་རྗེ་གཤེད་པོར་བལྟའོ།",
    "ཡེ་ཤེས་མཆོག་གི་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་སེམས་རྩེ་གཅིག་པའི་རྣལ་འབྱོར་པས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་རང་གི་མིང་སྦ་བ་ལ་སོགས་པས་རང་གི་རིག་པ་སྲུང་བ་དེ་ཉིད།",
    "གང་གི་གང་ལ་བདག་པོར་འགྱུར་བ་དེས་དེ་ཉིད་ལ་ཞབས་ཀྱིས་མནན་པར་བསམ་པར་བྱའོ།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་བསྒོམས་པས་སེམས་བརྟན་པོར་བྱས་པའི་རྣལ་འབྱོར་པ་གང་གི་ཚེ་ཆུ་ལ་འགྲོ་བར་འདོད་པ་དེའི་ཚེ།",
    "ངག་རེངས་པར་བྱ་བ་གསུངས་པ།",
    "གང་གི་ཚེ་ངག་འཕྲོག་པར་འདོད་པ་དེའི་ཚེ།",
    "ཡི་གེ་ཧཱུཾ་ལས་བསྐྱེད་པ་སོར་བརྒྱད་པའི་ཚད་རྩེ་མོ་ལྔ་པའི་སྟེང་དུའོ།",
    "གང་གི་ཚེ་ཡང་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་གཟུགས་ཀྱིས་བསྐྱེད་པར་གྱུར་པ་དེའི་ཚེ།",
    "ལས་ཐམས་ཅད་ལ་བསྲུང་བ་སྔོན་དུ་སོང་བས་འཇུག་པ་གསུངས་པ།",
    "ཨོཾ་ཛི་ན་ཛི་ཀ་ཆེ་གེ་མོ་ཤཱནྟིཾ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "ཨོཾ་ཨཱ་ཨཱ་རོ་ལྀཀ་ཆེ་གེ་མོ་པུཥྚིཾ་ཀུ་རུ་ཧཱུཾ་ཞེས་བྱ་བའམ།",
    "རིན་ཆེན་སྤྲིན་ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་རིན་ཆེན་འབྱུང་ལྡན་གྱི་སྦྱོར་བས་རྒྱས་པར་བྱེད་པའི་དེའི་ཚེ།",
    "རང་གི་དོན་དང་ཉེས་པ་ཆུང་བ་རྣམས་ལ་ལས་འདི་བྱ་བ་མ་ཡིན་པར་གསུངས་པ་གནོད་བྱེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འདི་སྐད་གསུངས་པ་ཡིན་ཏེ།",
    "རང་གི་བ་སྤུའི་བུ་ག་ནས་ཕྱུང་བའི་འོད་ཟེར་ལས་བྱུང་བའི་སྲིན་པོ་ལ་སོགས་པ་རྣམས་ཀྱིས་གཏུབས་ཤིང་ཟ་བར་བསྒོམས་ན་འདིར་འཆི་བར་འགྱུར་བ་གདོན་མི་ཟའོ།",
    "དེ་ཡིས་བུད་མེད་ལ་བལྟས་ན།",
    "བྱེ་བྲག་གིས་ཐམས་ཅད་བསྡུས་པར་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་ཕྱོགས་འདིས་ལྷ་ཐམས་ཅད་ཀྱི་རྩ་བའི་ཕྱག་མཚན་ངེས་པར་རྟོགས་པ་སྟེ་ཐ་དད་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་འདུ་ཤེས་ཀྱི་ཕུང་པོའི་བདག་ཉིད་ནི་ངག་རྡོ་རྗེས་ཚོར་བ་དང་འདུ་བྱེད་དག་གི་ངོ་བོ་ཉིད།",
    "ཐམས་ཅད་གཅིག་གིས་བསྡུས་པ་སྟེ།",
    "ལྷག་མ་རང་གི་རིགས་ཀྱི་ནང་དུ་འདུས་ཞེས་གཞན་ཟེར་རོ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཡེ་ཤེས་དེ་རང་གི་འབྱོར་པ་ཁྱེར་བར་བྱེད་པ་དེ་མཱ་མ་ཀཱི་སྟེ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "གསུང་གི་རྡོ་རྗེའི་གོ་འཕང་ཐོབ་པར་བྱེད་པ་སྟེ།",
    "གསུང་རྡོ་རྗེ་མ་ནི་གོས་དཀར་མོའོ།",
    "ཕྱག་ལྷག་མ་རྣམས་ཀྱིས་ནི་རང་གི་བདག་པོའི་ཕྱག་མཚན་འཛིན་པའོ།",
    "སེར་པོ་དང་དམར་པོ་དག་གི་གཡོན་དཀར་པོའོ།",
    "ནག་པོ་དང་དཀར་པོ་དག་གི་དམར་པོའོ།",
    "ཁྲོ་བོ་དག་ནི་རེ་རེ་ཡང་།",
    "བུད་མེད་སྒྱུ་མའི་མཆོག་ལྡན་པ།",
    "ཞེས་བྱ་བ་ནི་བུད་མེད་ཐམས་ཅད་སྤྲུལ་པ་རྣམས་ཀྱི་གཙོ་བོར་གྱུར་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དང་བཅས་པ་ནི་ཕྱག་གི་མཆོག་སྟེ།",
    "བུད་མེད་སྒྱུ་མས་མྱོས་ཞེས་བྱ་བ་ནི་དེ་ཡིས་མྱོས་པ་སྟེ།",
    "ཁྲོ་བོའི་འཁོར་ལོ་གང་གིས་ཏེ་དེས་དཀྱིལ་འཁོར་པའི་ལྷ་དང་བཅས་པས་སོ།",
