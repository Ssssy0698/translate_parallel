    "ང་རང་མཚོ་རྒྱལ་གླིང་ལ་འབྱོར།",
    "ང་རང་ཐོག་མར་འདི་གར་འབྱོར་དུས་ཀྱི་ཚོར་སྣང་དང་མཐོང་ཐོས་དེ་ཚོ།",
    "དྲན་སྣང་དེ་དག་ནི་ང་རང་རྒྱུན་གྱི་འཚོ་བ་དཀྱུས་མ་དང་ཁ་བྲལ་ནས།",
    "ང་རང་ཐོག་མར་དགོན་འདིར་འབྱོར་སྐབས།",
    "ང་རང་ལྟོགས་དྲགས་ནས་ཞོགས་པའི་ཚོགས་ཐུན་ཕྱི་མ་གྲོལ་མ་ཐག་ཐབ་ཚང་ལ་ཁ་ལག་ལེན་དུ་ཕྱིན་ཡིན།",
    "ང་རང་གང་ཐུབ་ཐུབ་བ་ཕྱུགས་ལས་གཡོལ་རྩིས་བྱེད་དུས།",
    "ཡིན་ནའང་ང་རང་དཔྱིད་འགོའི་ཆར་པ་ཟམ་ཟིམ་བབས་མ་ཐག་པའི་ས་གཞིའི་དྲི་ངད་བསྣམ་རྒྱུར་ཤིན་ཏུ་དགའ་ཞིང་།",
    "ང་རང་མིག་གཡེང་བྱེད་ས་གཙོ་བོ་ཡིན།",
    "ང་རང་དགའ་དྲགས་ཏེ་སྐད་རྒྱག་ཉན་བྲོ་བ་དང་།",
    "ཡོད་ཐབས་མི་འདུག་མི་ཚེ་དུས་ཚོད་ཀྱི་གཙང་པོ་དང་འདྲེས་ནས་མེར་མེར་ངང་ཕྱིར་ལྡོག་མེད་པར་བཞུར་བ་དང་བསྟུན།",
    "ང་རང་བསམ་བློའི་ནང་ལྷུང་འགྲོ་བའི་སྐབས་ཡིན་ཞིང་།",
    "དེ་བས་ཀྱང་ཅི་བྱེད་འདི་བྱེད་མི་འདུག་པས།",
    "ང་རང་སེམས་པ་སྐྱོ་བ་ལ་ཚོད་ཅིག་མ་བྱུང་ནའང་།",
    "དེ་དུས་ང་རང་ལོ་བཅུ་ལྷག་ལ་སླེབས་ཡོད་ཚོད་ཡིན།",
    "ང་རང་ཕྲུ་གུ་ཆེ་ཤོས་ཡིན་པས་པཱ་ལགས་ཕྱི་ལོགས་ལ་ཕེབས་དུས་ཁང་པའི་གནས་སྟངས་ཆ་ཚང་ལ་འགན་ཁུར་དགོས།",
    "ང་རང་ད་ལྟའང་འགྱོད་པ་སྐྱེ་བཞིན་ཡོད་དེ།",
    "ང་རང་ཁོ་ལ་སེམས་པ་འཐད་ཀྱི་མེད་པས་ཡ་མེད་གཏོང་གང་ཐུབ་བྱས་ནའང་།",
    "ཇོ་ཇོ་བཀྲ་ཤིས་དང་མཉམ་དུ་ཁྱིམ་མཚེས་རོགས་པ་གཞན་པ་ཁ་ཤས་ཀྱང་སླེབས་འདུག་པས་ང་རང་སེམས་པ་ཅུང་བདེ་ལ་བབས་ནའང་།",
    "མུན་ནག་ཁྲོད་ཁང་ཐོག་ནས་ཁང་ཐོག་འཛེགས་ཏེ་ཇོ་ཇོ་བཀྲ་ཤིས་ཀྱི་ནང་ལ་ཡོང་གྲབས་བྱས་འདུག་ཁོ་རང་ཁྱིམ་མཚེས་ཀྱི་ཁང་པ་ཐོག་བརྩེགས་གསུམ་པའི་སྟེང་འཛེགས་ནས་ཡོང་དུས།",
    "ང་རང་འགྱོད་པ་ནམ་ཡང་སྐྱེས་མ་མྱོང་།",
    "མི་ཚེ་ཐུང་ཐུང་འདིའི་ནང་རང་ཉིད་ཀྱིས་སྒྲུབ་ནུས་པའི་ལས་ཀ་རླབས་ཆེན་རིགས་གང་ཡང་མེད་ཆོག་ཀྱང་།",
    "གེགས་མེད་ངང་རང་ས་ནས་བགྲོད་ཀྱི་ཡོད།",
    "སྣ་བུག་ནས་སྡུར་སྒྲ་ནར་ནར་འབྱིན་ཞིང་དཔྲལ་བ་དང་མ་ནེ་སོགས་ནས་རྔུལ་ཆུ་ཁྲོམ་ཁྲོམ་དུ་བཞུར་ཞོར་ཀ་བ་སྦོམ་པོ་དེའི་ལྟག་རྒྱབ་ན་གཉིད་ཀྱི་ཆུ་ཕག་ཞིག་ལ་བཞོན་འདུག་ལོས་ཡིན།",
    "གྲྭ་ཤག་ཏུ་འདུག་སྐབས་ལག་ཐོགས་ཁ་པར་བརྩེ་རྒྱུ་དང་།",
    "རྒྱུས་ལོན་འདོད་བྱེད་མཁན་ཡང་ཡོད་ཚོད་མི་འདུག་དེ་བས་སྒྲུང་གཏམ་འདི་ནས་ཀྱང་ཁོའི་མིང་ངོ་མ་དེ་རྩད་གཅོད་དགོས་མ་བྱུང་།",
    "ཨ་ཙི།",
    "དེ་ཁྱེད་ལ་ཡང་ཁག་མི་འདུག་ཁྱེད་རང་ལ་དེ་འདྲའི་ཤེས་འདོད་ཡོད་ན་མུ་མཐུད་ནས་ཀློགས་ཤོག་དང་།",
    "ནམ་མཁའི་དཀྱིལ་འཁོར་འདི་ཁོ་ན་རྒྱུ་སྐར་གྲངས་མེད་ཀྱིས་བརྒྱན་འདུག་ལ།",
    "སྐུ་ཞབས་ལམ་འགྲོ་ལ་མཚོན་ན་རྒྱང་འཕེན་པ་ལས་ལྡབ་བཅུའི་སྤྱང་གྲུང་འཛོམས་པ་ཞིག་ཡིན་པ་ལས་རྒྱང་འཕེན་པ་ལྟར་གླེན་རྟགས་ཚ་པོ་ཞིག་ཡིན་ཚོད་མི་འདུག་དེ་མིན་ཁོ་གཉིས་དུག་སྡོང་གཅིག་ལས་སྐྱེས་པའི་ཡལ་ག་ཡིན་པས་བསྟན་བཤིག་དང་བསྟན་འཛིན་གྱི་ཁྱད་པར་འབྱེད་ས་ཞིག་ཡོད་མི་སྲིད།",
    "སྣང་སྐྱིད་པ་ཚོ་གཉིད་ཀྱི་འཇིག་རྟེན་ཞིག་འགྲིམ་བཞིན་འདུག་གལ་སྲིད་གཟབ་ནན་གྱིས་ཉན་ཚེ།",
    "གང་ལྟར་ད་ལྟ་རྒྱང་འཕེན་པས་བསམ་བློའི་འཚོ་བ་ཞིག་རོལ་བཞིན་འདུག་པས།",
    "རྒྱང་འཕེན་པ་སྨྱོས་འདུག་ཟེར།",
    "ལུང་པའི་དཀྱིལ་དུ་གཡུ་འབྲུག་གྱེན་དུ་རྒྱུ་བ་ལྟ་བུའི་ཆུ་ཆེན་ཞིག་འུར་གྱིས་འབབ་བཞིན་འདུག་པ་འདི་ནི་སྨར་ཆུ་ཞེས་གྲགས་ཏེ།",
    "དེ་རིང་རི་བོའི་རྐེད་དུ་སྨུག་པས་གཡོགས་ནས་འདུག་གཡས་གཡོན་གྱི་རྩྭ་དང་རྩི་ཤིང་།",
    "རྐང་པར་རྒྱ་ལྷམ་མགོ་ཁྲ་ཞིག་གྱོན་འདུག་ཀྱང་མཐེ་བོང་ཧྲིལ་པོ་རྒྱབ་ཏུ་ཐོན་པ་མ་ཟད།",
    "ལྷག་པར་དུ་ཕ་རྒན་ཉི་མ་ཁོ་རང་ལྷ་བཟོ།",
    "ཕྱི་དྲོའི་ཉི་མ་ལ་རྩེར་སོན་པ་ན་ཡུལ་མི་ཀུན་ཀྱི་ཁང་པའི་དུད་ཁུང་ནས་དུད་པ་སྔོ་ལོང་ལོང་འཕྱུར་བཞིན་འདུག་པས་ཉེར་དགུའི་དགུ་ཐུག་སྐོལ་བཞིན་ཡོད་པ་འདྲ།",
    "རྟ་ལ་སྒ་བསྟད་སྲབ་བསྐོན་ནས་སྒུག་འདུག་པ་ནི་ལྷ་གསོལ་བར་འགྲོ་དགོས་པའི་བརྡ་ཡིན།",
    "ཐ་ན་སྒོ་ཁྱི་རྣམས་ཀྱང་འཇམ་ཐིང་ངེར་ཉལ་ནས་འདུག་ཚུལ་ལ་བལྟས་ན་དུད་འགྲོ་ལས་དམན་པའི་མི་དེ་ཚོ་ལ་ཡིད་གཏིང་ནས་ཆད་པ་འདྲ།",
    "མ་གཞི་ནས་ཁག་ཀྱང་མི་འདུག་སྟེ།",
    "སྐབས་འདིའི་མ་རྒན་གྱི་སྡུག་བསྔལ་ནི་བེམ་པོར་གྱུར་པའི་རྡོ་ཡིས་ཀྱང་བཟོད་དཀའ་བའི་གནས་ཚུལ་ཞིག་ལོས་ཡིན་ཡང་བྱ་ཐབས་བྲལ།",
    "ཚོགས་པ་འཚོག་དུས་ཁོ་གྲལ་གྱི་མཐའ་དེར་སྡོད་ཅིང་ཆོ་ག་ཅི་འདྲ་ཞིག་ཡིན་ཡང་ཁོ་ལ་གདོན་རྒྱུ་གཅིག་རང་ཡོད་པ་ནི་ཞི་ཁྲོའི་བསྐང་བའི་དུམ་བུ་ཐུང་ངུ་ཞིག་སྟེ།",
    "སྐེ་བསྣར་ཏེ་མདུན་ངོས་སུ་ཅེར་འདུག་མི་ཚོགས་ཀྱི་གསེང་ནས།",
    "ཁོའི་སྐད་ཆ་དེར་ང་རང་གཏན་ནས་མི་འཐད་པར་གྱུར།",
    "ངོ་མ་བྱས་ན་ཁོ་ལ་དྲི་བ་འདོན་མཁན་གྱི་མགོ་སེར་དེ་ཚན་རིག་པ་ཞིག་ཡིན་བཟོ་མི་འདུག་ཀྱང་།",
    "འོན་ཀྱང་ཁོ་རང་དེང་སང་ཡང་བསྟོད་པར་དགའ་པོ་བྱེད་ཀྱི་ཡོད།",
