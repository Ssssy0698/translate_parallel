    "བྱེད་ཡིན་གྱི་ལུང་གི་གནོད་བསྒྲུབ་ལ་མ་ལྟོས་པར་རིགས་པས་གྲུབ་པ་མི་སྲིད་སྙམ་དུ་དོགས་པ་བཀག་ནས་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པའི་རིགས་པས་ཐུབ་པའི་བསྟན་པ་དང་སྟོན་པ་ཉིད་སྐྱོན་དང་བྲལ་བར་བསྒྲུབ་པར་མཛད་ལ།",
    "དེ་དག་གི་དགོངས་པ་མ་ནོར་བར་འགྲེལ་བས་རྣམ་འགྲེལ་དང་།",
    "སྐྱབས་སུ་སོང་ནས་བྱ་བ་ཁྱད་པར་ཅན་ལ་འཇུག་པའི་ཡན་ལག་གོ།",
    "འོ་ན་མྱུ་གུ་བསྐྱེད་པ་ལ་ས་བོན་དོན་མེད་པར་ཐལ།",
    "ཐུན་མོང་མིན་པའི་རྒྱུ་ས་བོན་ཡིན་ཡང་མྱུ་༣གུ་བསྐྱེད་པ་ཆུ་ལུད་ལ་བལྟོས་པས་ཁྱབ་པ་མ་ངེས་ལ།",
    "ཕྱི་མ་ཕྱེད་ཀྱིས་ཡིད་ཀྱིས་སྐྱབས་སུ་སོང་ནས་ལུས་ངག་གིས་འདུད་པའི་ཚུལ་གོ་བར་བྱེད་པའམ་སྒོ་གསུམ་ཆར་གྱིས་འདུད་ཅིང་སྐྱབས་སུ་འགྲོ་བའི་དོན་བསྟན་ཏོ།",
    "ཅེས་གསུངས་པ་ལྟར་རང་གིས་གཞལ་བྱ་ངེས་པའི་ཐབས་དང་།",
    "གང་ཟག་གི་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་དང་དེའི་འབྲས་བུ་སྤངས་པ་དང་བཅས་པ་ནི་ལེའུ་གཉིས་པ་ནས་སྟོན་ལ།",
    "སུམ་དུ་གཟིགས་པ་ཇི་སྙེད་པ་མཁྱེན་པའི་ཡེ་ཤེས་སོ།",
    "ཁྱོད་ཀྱིས་གཟུགས་སྐུ་གཉིས་བརྙེས་པའི་ཕྱིར།",
    "ཁྱོད་ལ་བསྟོད་ཕྱག་བྱས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "ལ་བརྟེན་ནས་གནས་སྐབས་དང་མཐར་ཐུག་གི་དོན་འགྲུབ་པའི་ཕྱིར།",
    "ཁྱད་པར་ཅན་རྣམས་ལ་གཞན་གྱི་ཕུན་ཚོགས་ལ་ཕྲག་དོག་པའི་དྲི་མ་དག་གིས་རྒྱུད་དཀྲུགས་ནས་གཞན་ལ་ཞེ་སྡང་བར་ཡང་ཡོངས་སུ་གྱུར་པ་དེས་ན་སྟེ་དེའི་ཕྱིར་རོ།",
    "བསྒོམས་ན་རྒྱུད་ལ་མི་སྐྱེ་བས་བློ་གྲོས་དང་ལྡན་པ་དག་གིས་གནས་འདི་ལ་ཤིན་ཏུ་གཟབ་པར་བྱའོ།",
    "གཏན་ཚིགས་ཡང་དག་གི་མཚན་ཉིད་དང་།",
    "དེར་ཐལ།",
    "དོན་མ་ཡིན་པ་ནི་གནོད་པའི་བདག་ཉིད་ངན་སོང་གི་སྡུག་བསྔལ་ལ་སོགས་པ་ཡིན་ལ།",
    "འཇུག་ཚུལ་སོགས་བསྟན་པ་ཡང་ཤིན་ཏུ་རྟོགས་དཀའ་བར་གཟིགས་ནས།",
    "གཏན་ཚིགས་ལ་བརྟེན་ནས་རང་གི་གཞལ་བྱ་གོ་བར་བྱེད་པ་ཡིན་ལ།",
    "གཞུང་གི་སྦྱོར་ཚུལ་གཉིས་པ་ནི།",
    "རྩོད་གཞི་ལ་ཕྱོགས་ཀྱི་སྒྲས་སྟོན་པ་མི་རིགས་པར་ཐལ།",
    "དེ་མི་ཁེགས་ན་ཚུལ་གསུམ་ལ་ཡང་དག་གིས་ཁྱབ་པ་སྒྲུབ་པའི་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "༩འོ་ན་ཕྱོགས་ཀྱི་སྒྲས་བརྗོད་ཀྱང་ཉེས་པ་མེད་པར་ཐལ།",
    "མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་གྲུབ་ན་མཐུན་དཔེ་ལ་ཡོད་པར་གྲུབ་པས་མ་ཁྱབ་པར་ཐལ།",
    "འོ་ན་སློབ་དཔོན་ཕྱོགས་གླང་གིས་ཚུལ་གསུམ་གྱི་མཚན་ཉིད་སྟོན་པ་ན།",
    "ངེས་པ་ཞེས་གསུངས་པའི་ཚུལ་གསུམ་པ་སྟོན་པའི་སྒྲ་ཟློས་པའི་སྐྱོན་ཅན་དུ་ཐལ།",
    "རང་མིང་གིས་སྨོས་ན་སྐྱོན་དེ་དག་རིམ་པར་སྤོང་དགོས་པས་རྟོགས་དཀའ་ལ།",
    "ངེས་གཟུང་གི་སྒྲུབ་བྱེད་དུ་སྦྱར་རོ།",
    "སྐྱ་བོ་སོགས་ཀྱང་མེ་གོ་བྱེད་དུ་ཐལ།",
    "རྩྭ་དང་སོག་མའི་མེ་དང་དེ་ཡང་གསལ་བ་དང་འབར་བ་སོཊ་ལས་དུ་བ་སྐྱེ་བར་མཐོང་བས་དེ་དག་ཀྱང་དུ་བའི་གོ་བྱར་ཐལ།",
    "གོ་བྱ་གོ་བྱེད་ནི་རྟོག་པ་ཕྱིན་ཅི་ལོག་གིས་སྒྲོ་བཏཊ་པ་ཡིན་པས་རྒྱུ་འབྲས་ལ་གོ་བྱ་གོ་བྱེད་དུ་འདོད་པའི་ཚུལ་འདི་ནི་མི་རིགས་སོ་ཞེ་ན།",
    "རྒྱུ་དེ་སྔོན་དུ་མ་སོང་ན་ཡུལ་དུས་འགར་ཡང་འབྲས་བུ་དེ་མ་མཐོང་བའི་རྒྱུ་འབྲས་ཀྱི་རིགས་ལ་རྗེས་སུ་འགྲོ་ལྡོག་ངེས་པ་དེ་ཉིད་གོ་བྱ་གོ་བྱེད་ཡིན་པས་ཉེས་པ་སྔ་མ་དེ་དག་མེད་ལ།",
    "ལའི་དུ་བ་ཚང་མང་ལ་རྗེས་སུ་མི་འགྲོ་བས་རྗེས་ཁྱབ་ངེས་ན་བསྒྲུབ་བྱ་གྲུབ་པར་ཐལ་བ་དང་།",
    "ཡང་དག་འགལ་རྟགས་༡༡ན་སུ་ཐལ་བ་དང་།",
    "ཐུན་མོང་མ་ཡིན་པའི་རྟགས་ཡང་དག་ཏུ་ཐལ་བའི་ཉེས་པ་གསུམ་མོ།",
    "སོང་བ་ནི་ལའི་དུ་བ་སོང་བར་འདོད་པ་དེ་ལ་ཡང་རྟཊ་སུ་གང་སོང་བ་དེ་ལ་ཉེས་པ་གསུམ་པོ་དེ་ལྡོག་ཏུ་མེད་དོ།",
    "ཁྱོད་ཀྱིས་རྟགས་སུ་འདི་སོང་ཞེས་སྨྲས་པ་དོན་མེད་པར་ཐལ།",
    "ཁྱོད་ཀྱིས་གང་སྨྲས་པ་དེ་རྟགས་སུ་མ་སོང་གང་སོང་བ་དེ་སྨྲ་མི་ནུས་པའི་ཕྱིར།",
    "ཡང་རྒྱུ་འབྲས་གྲུབ་དུས་སྔ་ཕྱིར་གནས་པས་གོ་བྱ་གོ་བྱེད་དུ་རྟོགས་པ་ཕྱིན་ཅི་ལོག་གིས་བརྟགས་པ་ཙམ་དུ་འདོད་པ་མི་རིགས་ཏེ།",
    "ཡིན་པའི་ཕྱིར་ཅེས་བཀོད་ན་གོ་བྱེད་དུ་མི་རུང་བར་ཐལ།",
    "རང་གི་རང་བཞིན་ཡོད་ཙམ་དང་རང་ཆས་སུ་འབྲེལ་བ་ཅན་གྱི་ངོ་བོ་མི་རྟག་པ་སྒྲ་ལ་གོ་བར་བྱེད་པའི་རང་བཞིན་གྱི་རྟགས་ཡང་དག་ཡིན་ཏེ།",
    "ཡོད་ཙམ་ཞེས་པས་ཕྱིས་བྱུང་གི་རྒྱུ་ལ་རག་ལས་པ་བཅད་ནས་བྱས་པ་ཡོད་ཙམ་དུ་བསྐྱེད་པའི་ལག་རྗེས་འཇོག་བྱེད་ཀྱི་རིགས་ཀྱི་རྒྱུ་ནུས་པ་ཐོགས་མེད་དེ་ཉིད་མི་རྟག་པའི་ལག་རྗེས་འཇོག་བྱེད་ཀྱི་རིགས་ཀྱི་རྒྱུ་ནུས་པ་ཐོགས་མེད་ཡིན་པས་ཡོད་ཙམ་ནས་རང་ཆས་སུ་རྗེས་སུ་འབྲེལ་བ་ཞེས་བྱའོ།",
    "ཟག་གི་བཅད་ཤེས་དོན་མཐུན་གྱི་ཡུལ་དུ་མེད་པའི་ཤ་ཟ་ལ་གང་ཟག་དེའི་ངོར་ཡོད་ངེས་ཀྱི་༡༢ན་ཐ་སྙད་དོན་མཐུན་མི་འཇུག་པ་གོ་བའི་འབྲས་བུ་ཅན་གྱི་རྟཊ་ཡང་དག་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་དེར་ཤ་ཟ་མེད་ངེས་སུ་ཐལ།",
    "འོ་ན་དེ་ཡོད་ན་ཀུན་མཁྱེན་གྱིས་ཀྱང་དམིགས་སུ་མི་རུང་བར་ཐལ།",
    "ཤེས་བྱ་ཐམས་ཅད་ཇི་ལྟར་ཡོད་པ་དེ་ལྟར་མངོན་སུམ་དུ་གཟིཊ་པ་མིན་པར་ཐལ།",
    "མདུན་གྱི་གཞིར་ཤ་ཟ་ཡོད་ན་ཁྱོད་ཀྱིས་ཡོད་པར་གཟིགས་པའི་ངེས་པ་མེད།",
    "དེར་ཁྱེད་ཀྱིས་མ་གཟིགས་ན་མེད་པའི་ངེས་པ་མེད་པའི་ཕྱིར།",
    "ཤ་ཟ་གཞི་གང་ན་ཡོད་ན་ཡང་དམིགས་པར་ཐལ།",
    "ཁྱོད་ཀྱིས་ཡོད་པ་ཐམས་ཅད་མངོན་སུམ་དུ་གཟིགས་པའི་ཕྱིར།",
    "གཞི་དེར་ཤ་ཟ་ཀུན་མཁྱེན་གྱིས་དམིགས་པ་ཁེགས་པར་ཐལ།",
    "འོ་ན་ཁྱེད་ལྟར་ན་ཡང་གཞི་དེར་དེ་མེད་ངེས་སུ་ཐལ།",
    "འོ་ན་གཞི་འདིར་ཤ་ཟ་ཡོད་པར་ཐལ།",
    "རྟགས་མ་གྲུབ་ན་དེར་དེ་མ་གྲུབ་པར་ཐལ།",
    "ཤ་ཟ་རང་གང་ལ་བསྐལ་དོན་དུ་སོང་བ་དེས་དེ་ཡོད་ཅེས་དམ་འཆའ་བ་མི་རིགས་ཏེ།",
    "སྒྲ་རྟག་པར་བཏགས་པའི་དོན་མི་སྲིད་པར་ཐལ།",
    "གང་ཟག་གིས་གང་ཟག་གི་ཚོད་མི་བཟུང་སྟེ།",
    "རང་གི་དགག་བྱ་འགོག་པའི་མ་དམིགས་པའི་ཚུལ་གསུམ་ཡིན་པའི་ཕྱིར།",
    "དང་པོ་ལ་རང་གི་འགལ་ཟླ་དངོས་དང་འགལ་ཟླའི་འབྲས་བུ་རྟཊ་སུ་༡༥ན་བཀོད་པ་གཉིས་སུ་ངེས་པས་རང་བཞིན་འགལ་དམིགས་དང་།",
    "རྣམ་ངེས་ལས་དེ་ལྟར་ན་མ་དམིགས་པ་འདི་ནི་སྦྱོར་བའི་བྱེ་བྲག་གིས་རྣམ་པ་བཅུ་ཡིན་ནོ་ཞེས་གསུངས་ཀྱིས་དེ་ལས་གཞན་དུ་འདོད་པ་དག་བསྟན་བཅོས་ཀྱི་དགོངས་པར་མི་སེམས་སོ།",
    "གྲང་རེག་གཅིག་པུ་འགོག་པ་༩ ལ་ཡང་དུ་མར་དབྱེར་རུང་ངོ།",
    "འགལ་ཟླའི་ངོ་བོ་མེས་གྲང་རེག་འགོག་པ་ལ་རྩོད་པ་མེད་ཀྱི།",
    "མེའི་རྒྱུ་དང་འབྲས་བུ་གཉིས་གྲང་རེག་འགོག་པ་ལ་ཉེ་རིང་གི་ཁྱད་པར་མི་འཐད་པས་རྒྱུས་འགོག་མི་ནུས་ན་འབྲས་བུས་ཀྱང་མི་ནུས་ལ།",
    "དེས་ནུས་ན་ཅིག་ཤོས་ཀྱིས་ཀྱང་ནུས་པས་གཞི་འགར་གྲང་རེག་རྒྱུན་ཆགས་སུ་གནས་པ་མེད་དེ་བུད་ཤིང་དམིཊ་པའི་ཕྱིར་རོ་ཞེས་པ་ཡང་ཡང་དག་ཏུ་འགྱུར་རོ་ཞེ་ན།",
    "གྲང་རེག་འགོག་པ་ཁྱབ་པ་འཁྲུལ་པ་ཅན་ཡིན་ཏེ།",
    "རང་ཉིད་ཡོད་ཙམ་གྱིས་གྲང་རེག་འགོག་པ་མ་ཡིན་ཏེ།",
    "དེར་གྲང་རེག་རྒྱུན་ཆགས་སུ་གནས་པ་འགོག་པ་མེའི་དྲོད་ཀྱིས་ཁྱབ་པའི་ཡུལ་དང་དུ་བ་དྲག་ཏུ་འཕྱུར་བཞིན་པའི་དུས་དང་ལ་སོགས་པ་གྲང་རེག་འགོག་ནུས་ཀྱི་མེ་ལ་མི་འཁྲུལ་བའི་གནས་སྐབས་ཁྱད་པར་ཅན་ལ་ལྟོས་པར་འདོད་རིགས་པའི་ཕྱིར།",
    "ཡང་ན་མེ་དང་གྲང་རེག་གཞི་དེར་ཕྱིར་རྒོལ་གྱི་མངོན་སུམ་ལ་སྣང་དུ་མི་རུང་བའི་ཡུལ་དང་དུ་བ་སྣང་དུ་རུང་བའི་དུས་དང་སོགས་པས་དེ་དྲག་ཏུ་འཕྱུར་བཞིན་པའི་རྣམ་པའི་ཁྱད་པར་ལ་བལྟོས་ཞེས་སོ།",
    "གྲང་རེག་འགོག་པ་ལ་ཁྱབ་པ་འཁྲུལ་བར་འགྱུར་ཏེ།",
    "དཔེར་ན་མི་གྲང་བ་གྲང་རེག་མེད་པར་སྒྲུབ་པ་ལ་ཐལ་བ་རྟགས་སུ་བཀོད་པ་བཞིན།",
    "ཡང་གི་སྒྲས་འགལ་རྒྱུ་དམིགས་པ་ལྟར་འགལ་འབྲས་ལ་ཡང་རྟགས་གང་བྱུང་གིས་མི་ཆོག་ཅེས་པའི་དོན་ནོ།",
    "༡༦བ་ཡང་དག་གི་ཁྱད་པར་གསུམ་དུ་མ་འདུས་པ་དགག་པ་དང་།",
    "ལྟར་སྣང་གི་ཁྱད་པར་ཡང་དག་ཏུ་འདུས་པ་དགག་པའོ།",
    "ཁྱོད་ལས་རང་འབྲས་ནས་ཀྱི་མྱུ་གུ་སྐྱེ་བ་ནི་ཡང་རྒྱུ་རྐྱེན་དོན་གཞན་ལ་མི་ལྟོས་པར་རང་གྲུབ་ཙམ་ནས།",
    "ཁྱོད་ལས་འབྲས་བུ་དེ་བསྐྱེད་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "པ་ཁྱོད་ཀྱི་ཚོགས་པ་སྐད་ཅིག་སྔ་མ་དང་།",
    "ཁྱབ་པ་ཡོད་པར་ཐལ།",
    "ཁྱོད་ཀྱང་ཡིན་དེ་བསྐྱེད་པ་ལ་འགལ་རྐྱེན་གྱིས་གེགས་བྱེད་པ་དང་བཅས་པ་ཡང་ཡིན་པའི་གཞི་མཐུན་དག་སྲིད་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ཚོགས་གྲངས་ཚང་གི་ལྡོག་པ་རྟགས་སུ་འཛིན་པ་དེ་ལ་འདི་འདྲི་བར་བྱ་སྟེ།",
    "འོ་ན་གཞི་དེ་ནས་ཀྱི་མྱུ་གུའི་རྒྱུར་ངེས་ནས་སྐྱེད་བྱེད་དུ་མ་ངེས་པ་མི་སྲིད་པར་ཐལ་ལོ།",
    "ཁྱོད་ལས་རང་འབྲས་ནས་ཀྱི་མྱུ་གུ་སྐྱེ་རུང་སྟེ།",
    "ཁྱོད་ཀྱིས་ནས་ཀྱི་མྱུ་གུ་བསྐྱེད་པ་ལ་འགལ་རྐྱེན་གྱི་གེགས་མི་སྲིད་པར་ཐལ།",
    "འོ་ན་བུམ་པ་ཡོད་པ་ལ་འགལ་རྐྱེན་གྱི་གེགས་མི་སྲིད་པར་ཐལ།",
    "དེ་མི་སྐྱེད་པ་མི་སྲིད་པས་ཁྱབ་པར་ཐལ་དེ་བསྐྱེད་པ་ལ་འགལ་རྐྱེན་གྱི་གེགས་མི་སྲིད་པས་ཁྱབ་པའི་ཕྱིར།",
    "བུམ་པ་མེད་པ་མི་སྲིད་པར་ཐལ།",
    "དུ་བས་དུ་ལྡན་ལའི་སྟེང་དུ་མེས་བུད་ཤིང་གི་འགྱུར་བ་བསྐྱེད་པའི་ནུས་པ་སྒྲུབ་པའི་སྟོབས་ཀྱིས།",
    "བུད་ཤིང་གི་འགྱུར་བ་ནི་ཐལ་བ་དང་སོལ་བ་སོགས་སོ།",
    "ནས་ཀྱི་མྱུ་གུ་སྐྱེ་རུང་དུ་ཐལ།",
    "བསྐལ་དོན་དུ་མི་རུང་བར་ཐལ།",
    "དེ་ལ་བུམ་པ་ཡིན་ན་ཡོད་པའི་ཁྱབ་པ་མ་ངེས་པར་ཐལ།",
