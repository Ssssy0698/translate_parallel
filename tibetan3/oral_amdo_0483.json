    "སོད་ག་གི་རེག་པ་ནི་ཉེས་བྱས་སོ།",
    "ཏིང་དེ་འཛིན་ནི་རྡོརྗེ་དང་འདྲ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་གང་རི་བོ་ཐམས་ཅ་ད་འཇོམས་པའི་ཕྱིརརོ།",
    "ཉོན་མོངས་པ་རྣམས་ནི་ཡེ་ཤེས་ཀྱིས་འཇོམས་སོ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་རྣམས་ཀྱི་སྔོན་དུ་གཏི་མུག་འགྲོ་ལས་ཏི་མུག་གི་གཉེན་པོ་ནི་ཡེ་ཤེས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྩེད་མོ་ཞེས་བྱ་བ་ནི་ཟླ་དངའོ།",
    "གྱ་ཀྱང་ཞེས་བྱ་བ་ནི་དེ་ཉིད་ཀྱིས་བསྐྱེད་པའི་ངག་གི་ལ་ས་སོ།",
    "དགའ་བ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གང་གིས་གོས་སྤྱོད་པ་དེ་གལ་ཏེ་དགའ་བ་དང་།",
    "སྐྱེས་པ་མེད་པར་བུད་མེང་དང་ཞེས་བྱ་བ་ནི་གངལ་གྲོགས་སྐྱེས་པ་གཞན་མེད་པའི་ཐ་ཚིག་གོ།",
    "ཁུར་དག་གི་འདོང་ཞེས་བྱ་བ་ནི་ཁུང་ཐོགས་ཏེ་འདོང་བའོ།",
    "འདི་ལྟར་དགེ་སློང་གི་དངོས་པོ་ཐོ་བ་བལ་དོགས་པ་ཤཱ་ལ་སོགས་པ་བཅད་པའི་ཕྱིར་ཏེ།",
    "རུ་བར་བྱེད་པ་མེདན་ཞེས་བྱ་བ་ནི་དེ་ཡང་རྫོགས་པར་མ་བསྟེན་པ་གཞན་མེད་ན་གནང་གི་ཡོད་ན་མི་གནང་ངོ།",
    "གཤེགས་སྟོན་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་རྫོགས་པའི་སྟོནམོའོ།",
    "དགེ་སློང་གི་བསོད་པ་ལ་མགྲོན་དུ་བས་ནངན་བ་སློང་ན་དེ་སློད་བ་ལ་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "དགེ་སློང་བསོད་སྙོམས་ལ་ཞུགས་པ་ན་བུད་མེད་ཀྱི་ཡུལ་ཟས་ཁྱེར་འའོང་ན་དགེ་སློད་གིས་སློངས་ཐོགས་མི་འདོད་དོ་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་བུད་མེད་ཀྱི་ཡུལ་ན་དུ་འཕགས་བཤིག་བཞེད་ཅེས་ཟེར་ན་བསྟབས་པར་བརྗོད་བར་བྱའོ།",
    "མཐུན་མོང་སཞེས་བྱ་བ་ནི་དགེ་སློང་དང་དགེ་སློང་བ་རྣམས་ཀྱི་མཐུན་མོང་ངོ།",
    "ཕྱུགས་ཆུང་ཞེས་བྱ་བ་ནིལ་ང་ཚོལ་བཅུ་པ་གཞོན་ནུ་མའོ།",
    "གང་ཟག་ལ་ཞེས་བྱ་བ་ཡང་གང་བྲག་གི་ཡུལ་ལའོ།",
    "ཆར་སར་པ་ཞེས་བྱ་བ་ནི་བུ་ངམ་ཆང་གི་བྱེ་བྲག་སྟེ་ཤིན་ཏུ་མྱོས་པར་འགྱུར་བའོ།",
    "དེ་དག་ལེ་གསའོངས་ལག་ཞེས་བྱ་བ་ནི་དེ་དག་གི་མིའི་ནང་དུ་འོངས་པ་དང་སོང་བ་ཞི་ོགས་པ་ཡིན་པའོ།",
    "༦ ཀླུ་ཨམྲའི་ཆུ་རོགས་པཞེས་བྱ་བ་ནི་རྫིང་གི་ཆུ་གང་ཤིང་ཨམས་མཚོ་ན་བ་དེ་ནི་ཨ་མྲའི་ཆུ་ཡིན་ལ།",
    "རེག་བྱ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ལགས་པར་སྦས་པ་ཞེས་བྱ་བ་ནི་གཞན་དག་གིས་ཟིལ་གྱིས་མི་ཊོན་པའོ།",
    "གཞིག་ནས་བརྟུལ་ཞིར་ཞེས་བྱ་བ་ནི་སྐྱེས་པའི་སྒོ་དང་བུད་མེད་ཀྱི་སྒོ་གཞིག་ནས་བསྒྲུབས་པའོ།",
    "རི་མོར་བྱས་ཞེས་བྱབ་ནི་ལུས་ཀྱི་ཕྱག་ནལསོགས་པ་བྱས་པའོ།",
    "ཡམ་སྲེག་ཤིང་ཞེས་བྱ་བ་ནི་སྦྱིན་སྲེག་གི་བུད་ཤིར་ངོ།",
    "གང་འདོད་པ་ཞེས་བྱ་བ་ནི་ཆིག་གི་འདོད་པའོ།",
    "གཞན་ལ་དག་ལས་པའི་དོན་དག་གིས་ནི་གནོད་པ་སྐྱེས་པར་བྱེད་དོ།",
    "རྒྱར་སོང་ན་དངོས་གཞི་གཅིག་ཏུ་འགྱུར་གྱི།",
    "རྫིང་བུ་དལ་གྱིས་འབབ་པ་ན་ཞེས་བྱ་བ་ནི་དེ་དག་གི་དུང་ན་གནས་ཡོད་པའོ།",
    "ཨར་མོ་ནིག་ཞེས་བྱ་བ་ནི་ཐགས་མཁྲ་བོའོ།",
    "འདིར་སོ་སོའི་སྐྱ་བོ་ཞེས་སྨྱོས་པ་ནི་ཁཅིག་ན་རེ་རེ་འདོད་ཆགས་དང་བྲལ་བ་དག་པས་ཀྱང་ཁྱད་པར་དུ་འཕགས་པ་ངོ་མང་ཆེ་བར་བསྟན་བའི་ཕྱིར་རོ།",
    "ཟོང་ལ་སོགས་པ་སྦྱིན་བདག་གིས་ཡང་དང་ཡང་དུབསན་མིངགོས་པར་གཏན་གྱི་འཚོ་བ་འབྱོར་བར་འགྱུར་བའི་ཡོབྱད་དག་གོ།",
    "རུང་བ་མ་ཡིན་པ་ཞེས་བྱ་བཞི་རྗེས་སུ་ཆགས་པ་དང་ཁོང་ཁྲོབ་ལ་སོགས་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རེ།",
    "དགེ་སློང་གི་ཚུལ་དང་མི་མཐུན་གཞེས་བྱབ་ནི་དགེ་སྐོར་གི་ཚུལ་དང་འགལ་བའོ།",
    "ཁྱེར་ཀྱི་ནང་ན་གནས་ཞེས་བྱ་བ་ནི་བཙུན་མོའི་འཁོར་ཀྱི་ནང་ན་གནས་པའོ།",
    "གཞོན་ཚུའི་གནས་སྐབས་དང་ལང་ཚོའི་གནས་སྐབས་ལ་སོགས་པའོ།",
    "རྩེད་མོ་ཞེས་བྱ་བ་ནི་དགར་དགུར་སྤྱོད་པའོ།",
    "ཁྱབ་འཇུག་གི་བུ་དང་།",
    "དཀའཐུབ་ཅེས་བྱ་བ་ནི་ལུས་ཀྱི་རེ་ས་བའོ།",
    "ཤིབ་འདི་བདག་གི་ཕའམ་རྗེས་ཡིན་ནོཞེས་ཀྱངམི་སྨྲ་འོཞེས་བྱ་བའི་ཐཚིག་གོ།",
    "མི་མཆོག་ཁྱོད་ཀྱི་ཚུལ་དང་མཐུན་པ་ཡིན།",
    "དེ་ནི་དེ་རིང་ན་བར་གཟིགས་པར་འགྱུར།",
    "དེ་ནི་དེ་རིང་ཁྱེད་ཀྱིས་གཟིགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདོད་པལ་འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པ་དག་གོ།",
    "གནས་གཞི་ཞེས་བྱ་བ་ནི་ལྷ་ཁང་གི་གནས་ཞེས་བྱ་བའིཟ་ཆིག་གོ།",
    "བབ་པ་ཞེས་བྱ་བ་ནི་སྟང་གི་ཡལ་གའི་གྲིབ་མ་ཤིན་ཏུ་འབབ་པའོ།",
    "དཔས་མཚོན་བ་གང་དག་འཇིག་རྟེན་པའི་ལམ་གྱིས་ཉོན་མོངས་པ་སྤོང་བ་མེད་པར་གནོད་པཁོ་ནར་ནི་འགྱུར་ཏེ་ས་བོན།",
    "མབསལ་པའི་ཕྱིར་པོཞེས་ཟེར་བ་དག་གིས་ལུགས་ནི་གཞུང་འདི་དང་འགལ་བར་ཤེས་པར་བྱའོ།",
    "གནས་བརྟན་དག་གིས་ཀྱང་ཞེས་ཁར་ཞུབྱ་བཞི་བཙོམ་ལྡན་འདས་བཞུགས་པའི་དུས་ནི་དང་པོར་ཡང་དག་པར་སྡུད་པར་བྱེད་པ་དག་གིས་སོ།",
    "གཞི་ཡང་ཡིན་ཏེ་ལུས་དང་ངག་གི་ལས་སེམས་པས་ཡུལ་དུ་བྱ་བའྀ་ཕྱིར་རོ།",
    "འཕགས་པའི་ལམ་མོ།",
    "གི་ཡུལ་ལ་དགའ་དང་མཆོག་ཏུ་དགའ་བ་ཐོབ་པའོ།",
    "གཙང་བའི་གནས་སུ་བྱ་བ་ག་གྷ་ལ་སོགས་པཐམས་ཅད་པས་ཀྱང་འདི་ཤི་བའི་རེ་དང་ལྷན་ཅིག་མི་གནས་པས་ཁྱད་པར་དུའཕགས་པའི་ཕྱིར་ངོ་ དོགས་བདེ་བཞེས་བྱབ་ནི་རིམ་གྱིས་གཞོལ་བའི་ཕྱིར་དང་།",
    "བག་མགཏོང་པ་ཞེས་བྱ་བ་ནི་བུ་མོ་སྦྱིན་པའོ།",
    "བདག་གི་བྱིས་པབསྐྱབ་དུ་གསོལ་ཞེས་བྱ་བནི་བྱིས་པའི་སྐྱོབ་པར་གུར་ཅིགཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དྲུག་གིས་འཇག་རྟེན་བཀུར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་མགུ་བར་འགྱུར་བའི་གཞི་དྲུག་གིས་ཏེ།",
    "ཐབ་མོར་གང་ཞིག་འབྱར་མི་འགྱུར།",
    "རྟེན་མེད་པ་ཞེས་བྱ་བ་ནི་ངན་སོང་སེམས་ཅ་ན་ཤེས།",
    "ཟབམོ་ནས་བྱབ་ནི་རང་གི་དུས་ཀྱི་སྡུག་བསྔལ་ཟད་པའི་མཐའ་མེད་པའི་ཕྱིར་དེ།",
    "ཞེས་བྱ་བ་ནི་ཤེས་རབ་སྒྲོན་མསམཉམ་བར་བཞག་པའི་སའི་ཉོན་མོངས་པའི་ཚར་མཕྲ་མོའི་རང་བཞིན་འབྱིན་པར་འགྲུབ་པའི་ཕྱིར་རོ།",
    "གཞན་དང་གཞན་དུ་ཁྱོད་དྲིས་ཤིག།",
    "ནོ་ འཇིག་རྟེན་ཕ་རོལ་འཇིགས་པས་ཞེས་བྱབ་ཞིངན་སོར་གིས་འཇིགས་པའོ།",
    "ཅན་ཤི་ནས་བཙུན་མོ་དཔལ་ལྡན་བྱང་ནང་ལ་བརྟེན་ནས་བཙུན་མོའི་འཁོར་གྱི་ནང་དུ་འཇུག་པ་རྗེས་སུ་གནས་པ་དེ་བསྟན་པར་བྱ་སྟེ།",
    "དེ་ནི་གཞོན་ནུའི་བསྟན་གྱིས་ཞེས་བྱ་གཞིས་ནི་བུ་མོ་བདག་གིར་མི་བྱེད་དོ་ཞེས་བྱབའིཐ་ཚིག་གོ།",
    "གང་གི་ཕྱིར་ཐུབ་པ་རྣམས་ཀྱིས་རྟག་པར་རྒྱནས་བུ་དག་བསྐྱསྐྱེད་པར་འགྱུར་བ་དེའི་ཕྱིར་འདི་ཡང་བུའི་དོན་དུ་ཆུད་མ་ལེན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚི་ག་གི།",
    "བདག་གི་བུ་མོ་ཞེས་བྱ་བ་ནི་ཁོ་བོའི་བུམོའོ།",
    "འདི་དང་ལྷན་ཅིག་ལེགས་པར་ཁྱོད་དགྱེས་མཛོད།",
    "བྲམ་ཟེ་བ་ཡིས་འདུད་ཀྱི་བུ་མོ་ནི།",
    "བདག་གི་བུ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "མིལྡན་པར་གཟིགས་སམ་ཅི་ཞེས་བྱ་བ་འོ།",
    "ཀུན་ཏུགཟིགས་པ་བུད་མེད་བླངས་པ་མཛད་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "ཀུན་ཏུ་གཟིགས་པ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པའོ།",
    "འཛམ་བུའི་གླིང་༣ ཤེ་དགའ་བར་འགྱུར་བ་ཁྱོད་ཀྱིས་བདག་ཅག་སྔངས་སམ་ཞེས་བྱ་བཞི་ཐག་རིང་བར་ཡོངས་སུ་སྦངས་སམ་ཞེས་བྱ་བའོ།",
    "མཆོག་གིས་ཞེས་བྱ་བ་ནིམཐར་ཐུག་གིས་སོ།",
    "བརྟུལ་ཞུགས་མཆོག་ཏུ་འཛིན་པ་དང་ཐེ་ཚོམ་མོ།",
    "འདི་སྐྲདབ་སྟན་ཏེ་གང་གི་ཕྱིར་བྱིས་པ་དག་འདོད་ཆགས་ལ་སོགས་པས་བཅིངས་ཤིང་མི་ཤེས་མུནཔས་སོ་ཟི་བྱས་པ་དེའི་ཕྱིར་ལུས་ལ་སོགས་པ་མི་སྡུག་པ་ཡང་སྡུག་བཞི་ད་དུ་ལྟ་བར་བྱེད་དོ།",
    "མ་རེད་དེ་རེད་པ་མ་ཡིན་ཞིང་ཞེས་བྱ་བ་ནི་༢ དད་པ་ལ་སོགས་པ་ཁྱད་པར་དུ་འཕགས་པ་མ་རྙེད་བའི་ཕྱིར་རོ།",
    "རྙེད་བཉེས་པ་རེད་དེལེགས་པར་རྙེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་པ་ནི་མིང་ཉིད་ལ་སོགས་པ་ཡོངས་སུ་རྫོགས་པ་མ་རྙེད་པའི་ཕྱིར་རེ།",
    "ལྷམོའི་ཚོགས་ཀྱིས་ཀུན་བསྒྲགས་ཤིངཞེས་བྱ་བ་ནི་གླུ་དབྱངས་ཀྱིས་སྒྲས་ཀུན་ཏུ་གང་བའོ།",
    "ཁྱིམ་ནའདུག་པའི་དམག་པཞེས་བྱ་བ་ནི་གྱོ་སྒུག་གི་ཁྱིམ་དེ་ཉིད་ན་འདུག་ཅིང་གཞན་དུ་མི་འགྲོབའི་དམག་པའོ།",
    "མི་རྣམས་ནང་ན་མཆོག་གི་རབ་ཀྱི་མཆོག་ཅེས་བྱ་བལ་སོགས་པ་ལ།",
    "ཁྱེལུའདི་ཁྱོད་ཀྱི་ཅི་ཞིག་ཅེས་བྱ་བ་ནི་ཁྱེའུ་གཞོན་ནུ་འདི་ཁྱོད་ཀྱི་མད་པོ་འམ།",
    "ཁྱོད་ཀྱི་བུ་འམ།",
    "ཁྱོད་ཀྱི་སྐུད་པོ་འམ།",
    "བྲམ་ཟེ་འདི་ནི་བདག་གི་མིང་བོ་དང་།",
    "ཁྱེའུ་འདི་ནི་བདག་གི་མིར་བོ་ཡར་ཡིན།",
    "བདག་གི་བུ་ཡང་ཡིན།",
    "བདག་གི་སྐུད་པོ་ཡང་ཡིན་ནོཞེས་སྟོན་ཏོ།",
    "དེའི་ཕྱིར་འདིའི་ཕ་གང་ཡིན་པ་དེ་བདག་གི་ཕ་ཡིན་ཏེ་ཞེས་བྱ་བ་གསུར་ས་ཏེ།",
    "འཇིག་རྟེནགྱི་ཐ་སྙད་ཀྱིས་ཁེ་འདི་དག་གི་མིང་པོ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཁྱེའུ་འདིའི་ཕ་དལྟར་བདག་གི་ཁྱོ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་ཁྱེའུ་འདིའི་ཕ་ར་ལྟར་བདག་གི་ོ་ཡིན་ལ།",
    "བུད་མེད་ཀྱི་གཡོ་ཚདག་དང་བུད་མེད་ཀྱི་གྱ་གྱུ་དག་དང་བུད་མེད་ཀྱི་ཡ་ཡོ་དག་ཅེས་བྱ་བ་ནི་གཡོས་ཀུན་ནས་བསླང་བའི་ལུས་དང་ངག་དང་ཡི་དཀྱིལས་དག་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "མི་རྩང་ཞེས་བྱ་བ་ནི་མིགཙང་བ་སུམ་ཅུ་རྩ་དྲུག་གི་ཚོགས་ཡིན་པའི་ཕྱིར་རོ།",
    "བདག་གིར་བྱེད་ཅེས་བྱ་བ་ནི་སྐྱེས་པགཞན་དག་ལ་ཁྱིམ་ཐབ་ཏུའཛིན་པའི་བློ་སྐྱེད།",
    "གཏི་མུག་གི་མུན་༣ པས་བསྒྲིབས་པ་ཞེས་བྱ་བ་ནིམི་ཤེས་བའི་མུན་པས་བསྒྲིབས་པའོ།",
    "ཁྱོལ་ཆགས་པར་བྱེད་ཅེས་བྱ་བ་ནི་འདོད་ཆགས་སྐྱེད་པར་བྱེད་པའོ།",
    "ཨུཏྤལ་བདག་གི་ལག་པ་ཞེས་བྱ་བནི་ལག་པ་གང་བའོ།",
    "སྨད་པའི་གནསཞེས་བྱ་བ་ནི་སྐྱོན་གྱི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རེ།",
    "འཆིང་བམཐའ་དག་ཡོད་པ་ཞེས་བྱ་བནི་ཉོན་མོངས་པ་རྣམས་མ་བརྩེགས་པའོ།",
    "གཅིག་གིས་ཀྱི་བསྒོ་ན་ཡང་བསྒོ་བ་ཉིད་ཡིནལ་གཞན་དུན་སོ་སོར་ཞྭ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་དགེ་སློང་གཅིག་གིས་ཀྱང་དགེ་སློང་མ་དེ་ལ་དེ་སྐད་ཅེས་སླ་བ་མ་སྦེབས་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་དགེ་སློང་གཅིག་གིས་ཀྱང་ཚིག་འདི་མངོན་སུམ་དུ་བྱེད་མ་ནུས་ན་ཞེས་བྱ་བིའ་རྦ་ཚིག་གོ།",
    "སྐྱོན་མེད་པ་ཞེས་བྱ་བ་ནི་ངན་སོང་རྐྱོང་བར་འགྱུར་བའི་ལས་མི་བྱེད་པདང་།",
    "མཐོང་བའི་ལམ་སྐྱེས་པས་དགེ་སློང་ཞི་དལ་བཀོད་བཞེས་བྱབ་ནི་མཐོང་བའི་ལམ་སྐྱེས་པས་དགེ་སློང་གི་སྡོམ་པ་ཞིད་ཐོག་པ་སྟེ།",
    "མོ་ཐབས་ཟླུམ་གོཞེས་བྱ་བ་ཞིམམཐའི་ཁ་མཉམ་པར་འདུག་པའོ།",
    "སོར་མོ་གཉའ་གོང་དུ་བཞག་པའོ།",
    "ཞེས་བྱབ་ནི་ཁྱིས་བདག་གིས་མ་བསྒོ་བར་དག་སློང་ཀྱིས་དུ་སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "རྣམ་པརའགྱུརབ་དག་གིས་བྲས་ཟ་བར་བྱེད་ནས་ཞེས་བྱ་བ་ནི་རྐང་ལག་རྐྱོང་པལ་སོགས་པ་དག་གིས་སོ།",
    "འདི་དག་གི་རྒོད་བག་དང་མ་གུས་པའི་ཕྱིར་དགག་པམཛད་དོ།",
    "དེའི་ཕྱིར་མི་གདམས་པའི་ཕྱིར་རྩོད་པལ་ནི་དེའི་རེ་བ་ཉིད་འཆལ་དུ་གཞུག་པ་ཡང་བྱས་ཏེ་འདིར་དོན་ནི་དོ་ཡིན་ནོ།",
    "རྣམ་པར་ཞི་བར་བྱའོ་ཞེས་བྱ་བ་ནི་འཇུག་གིས་སོ།",
    "མཀྱེས་རང་གིས་ཁས་བླངས་དང་།",
    "གཞན་གྱིས་ཉེས་པ་སྒྲོགས་པ་མང་བཙམ་ཞིག་ཡོད་པས་དེ་དག་གིཉེས་པ་དེ་ཡོངས་སུ།་",
    "གང་གིས་འདོད་ཆགས་ཀྱི་སྒྲིབ་པ་དང་གཏིམག་གི་སྒྲིབ་པལས་སེམས་རྣམ་པར་སྐྱོང་བ་ལྟ།",
    "ཀ་ལོ་བདག་གི་རིགས་དང་མི་རིགས་ལ།",
    "མ་མཐུན་པ་དང་གཞན་དག་གི།",
    "གཞན་དག་གི་བྱས་དང་མ་བྱས་རྣམས་ལ་མིན་ཞེས་བྱ་བ་ནིགཞན་དག་གི་རྫོགས་པ་དང་མརྫོགས་པལརྟག་པར་མི་བྱ་བའོ།",
    "གང་དག་གིས་ཐུབ་པ་བསྐྱེད་པའོ།",
    "སྐྱོབ་པ་ཞེས་བྱ་བ་ནི་རང་གི་སེམས་རྗེས་སུ་སྲུང་བའོ།",
    "བཅོམལྡན་འདས་དེ་བཞིན་གཤེགས་པ་འོད་སྲུང་གི་སློབམ་རྣམས་ནིཉེས་པ་ཆུང་བ་ཡིན་ནོ།",
    "འཕགས་པའི་ལར་གྱིས་ཉོན་མོངས་པ་ཐམས་ཅད་ཡོངས་སུ་ཟད་པས་ནི་ཕུང་པོའི་ལྷག་མ་དང་བཅས་པ་དང་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པ་འཐོབ་པར་འགྱུར་རོ།",
    "ངང་གི་སེམས་ནི་ཡོངས་སུ་འདུལ།",
    "པ་སྟེ་ ངག་གི་སྡོམ་པལེགས་པ་ཡིན།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་གངུལ་ཤེས་བྱབ་འདིས་ནི་ལྷག་པ་སེམས་ཀྱི་བསླབ་པ་བསྟན་ཏོ།",
    "ལེགས་ཉེས་སྟངས་འཛིན་པྲ་ལྟས་མོ་ཡི་རིག་པ།",
    "ཡབ་མེས་གོང་མ་རྣམས་ཀྱི་རྩལ་དུ་བཏོན་པའི་རིག་གཞུང་གི་ཉིང་ཁུ་བདུད་རྩིའི་མཆོད་ཡོན་ལྟེམས་ཀྱིས་འཁྱིལ་ཡོད་པ་ནི།",
    "ངས་ལྷག་བསམ་རྣམ་དག་གིས་བཀའ་དྲིན་དང་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "བོན་གྱི་ཡིག་རྙིང་ཁག་གི་དགོངས་པ་དང་བསྟུན་ན།",
    "དམ་པ་མཆོག་གིས་དགྲ་འདུལ་གཉེན་སྐྱོང་དང་།",
    "ཡ་རབས་གུས་སྲོལ་སོགས་དངོས་པོའི་དཔལ་ཡོན་དང་བསམ་པའི་འདུ་ཤེས་གང་གི་ཐད་ནས།",
    "རིམ་གྱིས་སྟག་གཟིག་དང་ཞང་བོད་ཀྱི་ཡུལ་གྲུ་ཀུན་ལ་ཁྱབ་གདལ་དང་དར་སྤེལ་དུ་བཏང་བ་མ་ཟད།",
    "འདི་ནས་འདས་པའི་མི་ལོ་ཆིག་སྟོང་ལྷག་གི་ཡར་སྔོན་དུ།",
    "དེ་དག་གི་སློབ་བརྒྱུད་རྣམས་ཀྱིས་སྟོད་གངས་དཀར་ཏི་སེ་མན་ཆད་ནས།",
    "འོན་ཀྱང་མ་ཕྱི་ནི་གནའ་སྔའི་ཤིང་པར་དུ་བཏབ་པ་རེ་ཟུང་མ་གཏོགས།",
    "དུས་རབས་བཅུ་གཉིས་པའི་ནང་སྐུ་འཁྲུངས་པའི་གཤེན་སྟོན་ནམ་མཁའ་རྒྱལ་མཚན་མཆོག་གི་གསུང་པོད་གཅིག་དང་།",
    "ཡང་དག་པའི་ལྟ་གྲུབ་ཟབ་མོའི་དགོངས་པ་དང་།",
    "བགྲོད་བདེ་བའི་སྤྱོད་ལམ་དྲང་མོའི་རྣམ་གཞག་དུས་གཏན་གྱི་ཕན་བདེ་ལེགས་པོའི་འབྲས་བུ་བཅས་ལ་མྱོང་རོལ་བྱེད་ཐུབ་པ་སྨོས་མ་དགོས་ལ།"
  ]
}