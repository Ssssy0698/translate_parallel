    "སྔོན་ལ་ཕྱོགས་གང་ནས་བལྟས་ཀྱང་རང་ཉིད་ཕ་རོལ་ལས་རྒྱལ་ཁ་ཏན་ཏན་ཐོབ་ངེས་པའི་མཐུན་རྐྱེན་ཐ་དག་ཚང་བ་བྱས་ཐོག་དེ་རྗེས་གཞི་ནས་དངོས་སུ་འཐབ་ལག་སྦྱོར་བ་ལས་མུན་ཐོམ་གྱིས་འཐབ་པར་མི་བྱ་བའི་ཤེས་རབ་འཕེལ་བ་དང་།",
    "ཡོ་ལང་ཇི་ལྟར་ཆེ་ནའང་རང་སེམས་རྣལ་དུ་འཕབས་ཐུབ་པ།",
    "བདེ་བར་འདུག་པ་ངལ་བའི་གནས་སུ་འཇོག།",
    "བདེ་བར་འདུག་པ་ངལ་བའི་གནས་སུ་འཇོག།",
    "ཅེས་པའི་དོན་ནི་སྐབས་བབས་ཀྱི་བྱ་ཐབས་གང་རུང་ལ་བརྟེན་ནས་ཕ་རོལ་ལ་སྣོན་ཤུགས་སྤྲད་དེ་ཕ་རོལ་བས་ཕེབས་སུ་འདུག་པའི་ཚུལ་དེ་གནས་བཟོད་མི་བདེ་བའམ་དཀའ་ངལ་གྱི་རྐྱེན་དང་ལྡན་པ་བཟོ་དགོས་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "ཐུ་བཞི་རང་སར་འགུལ་མེད་འདུག།",
    "བདེ་བར་འདུག་པ་འཁྲུག་པར་བྱེད།",
    "ཞེས་པ་ནས་བདེ་བར་འདུག་པ་འཁྲུག་པར་བྱེད།",
    "འདིར་ཡང་ཛིརྒྱལ་བ་མི་ཡི་སྦྱོར་བས་གཏོད་ཅེས་དམག་འཁྲུག་ནང་རང་ཕྱོགས་ཀྱི་ཐབས་ནུས་གང་ཡོད་འདོན་སྤེལ་བྱས་རྗེས་ཕ་རོལ་འཁྲུལ་བ་དང་བསམ་ཡུལ་ལས་འདས་པར་བྱེད་པ་དང་།",
    "དཔུང་མང་ཁྲག་འདོན་དམར་འཛིང་བྱེད་དུ་འཇུག་མི་ཕོད་པ་དེས་དམག་འཐབ་ལ་གནོད་སྐྱོན་བཟོ་བར་གོ་དགོས་པའང་ཡོད་འདུག་གང་ལྟར་ན་ཡང་དེ་གཉིས་ཀ་གསོན་ལ་ཞེན་པའི་རང་གཤེས་ལས་བཟོས་ཤིང་།",
    "ཉི་ཕྱོགས་ལྟ་བཞིན་སྒང་སར་འདུག།",
    "ཉི་ཕྱོགས་ལྟ་བཞིན་སྒང་སར་འདུག།",
    "བྱུ་ར་གྱིས་གཤེགས་ལ་འདུག་མི་བྱ།",
    "ཐང་ས་སྙོམ་སར་འདུག་པ་བདེ།",
    "དམག་འཁྲུག་ནང་འཐབ་ཡ་ཕྱོགས་གཉིས་ཀ་ཡིས་ཅི་ནས་ཀྱང་རང་ལ་ཕན་པའི་དགེ་ས་འཛིན་ཐབས་བྱ་ཚུལ་བསྟན་ཡོད།",
    "འགག་སར་བརྟེན་ནས་འདུག་པ་ཡིན།",
    "ལངས་ནས་འདུག་པ་ལྟོགས་པའོ།",
    "དཔུང་མང་ཙོག་པུར་འདུག་པའི་ཚེ།",
    "དཔུང་བཙོག་པུར་འདུག་པའི་ཚེ།",
    "གྲུ་བོ་གཅིག་ཏུ་འདུག་པའི་ཚེ།",
    "གྲུ་བོ་གཅིག་ཏུ་འདུག་པའི་ཚེ།",
    "སྐབས་དེར་ཞུང་ནུའུ་བྱང་མའི་འིཛིསྨོ་ཕོ་ཉ་ཡང་དེར་སློབས་ཡོད་པ་འདི་ཉིད་ཀྱིས་དབྱེན་སྦྱོར་བྱས་པ་ཡིན་ངེས་པར་ཐག་བཅད་ཐོག་ད་ཀོ་ངེད་ཚང་མ་ཉམས་ཉེན་གྱི་གནས་སུ་ལྷུངས་བཞིན་འདུག་པ་དང་།",
    "མེ་བྱ་སོགས་ཡོད་པས་དེ་དག་དུས་རྒྱུན་ནས་གྲ་སྒྲིག་གང་ལེགས་བྱ་དགོས།",
    "ཞི་བར་འདུག་ན་བརྟགས་པ་ལས།",
    "འཆི་བའི་མྱུལ་མ་ལ་འགྲེལ་ཚུལ་མི་མཚུངས་པ་གཉིས་ཡོད་འདུག་སྟེ།",
    "བྱེས་པ་འདི་ནི་གོང་གསལ་གྱི་བྱ་ནག་པོ་ཞེས་པའི་མྱུལ་ཞིབ་གནམ་གྲུ་དེར་ལེགས་བཅོས་བྱས་ཏེ་བཟོས་པ་འིག་ཡིན་འདུག་ཀྱང་།",
    "སུན་ལུའུ་ཁོང་རང་སྔར་བཞིན་དམག་དོན་ལ་ཐེ་ཞུགས་བྱེད་འདོད་ཡེ་ནས་མེད་ཀྱང་རྒྱལ་པོས་རང་དགར་གཏན་ནས་མ་བཞག་སྟབས།",
    "བ་༦ མཁའ་དང་རང་རིག་སྟོང་པ་ཉིད།",
    "དེ་ཡང་རང་སེམས་གཅིག་པུའི་འཕྲུལ་གང་།",
    "ཐ་ཡི་ཐུགས་དང་རང་སེམས་གཅིག་གྱུར་པ།",
    "འདུག་ལ་ཞེས་པའི་བར་གྱི་དོན་ནོ།",
    "ཟླུམ་པོའི་འདུག་སྟངས་ཀྱིས་ནི་བཞུགས།",
    "ད་གདོད་སོས་གདལ་གདེང་ཐོབ་གདའ།",
    "འདམ་ཁྲོད་འདུར་འདུར་འདོང་ཞིང་འདུག།",
    "ཙཱ་རུའི་བཟའ་བ་ཙ་ན་ཀ།",
    "དུ་གདའ་ཞེ་ན་འགའ་ཞིག་གོ།",
    "མཐའ་རྟེན་གཞན་མཐར་རང་རང་ལའོ།",
    "རང་རང་རྣམ་དཔྱོད་རིག་པས་དཔྱད།",
    "རུས་ཀྲང་ཤ་མེད་རུས་རྐྱང་ཀྲང་ངེ་ཀྲོང་ངེ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་འདུག་ཚུལ་ཞིག་བཅས་པ་བཟོས་པ།",
    "ཉེར་ལེན་གྱི་རྒྱུ་དང་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་དང་རང་རྐྱ་ཐུབ་པ་རྐོམ་ལ་སོགས་པ་རར་བཏགས་པའི་ཀའོ། ལྐ་",
    "སྐྱོ་མ་སྔ་བཙན་ཕྲ་མ་བཅུག་པ་སྐྱིལ་ཀྲུང་འདུག་སྟངས་ཀྱི་ཁྱད་པར་སྐྱོད་པ་གཡོ་བ་འགྲོ་བ།",
    "གྲ་མ་ཤིང་ཞིག་སྤུ་གཅོད་པའི་གྲི་སྤུ་གྲ་ལྟར་ཡང་འདུག་གྲུ་འཛིན་པའི་རི་སྟེ་པོ་ཏ་ལའི་རི།",
    "རྒོལ་བ་ཚར་བཅད་པ་གཅོད་པ་བློས་བཅལ་བ་འཇལ་བ་ཤེས་པའམ་རྟོགས་པ་བསླབ་པ་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་བཅབས་པ་གསངས་པ་འཆབ་པ།",
    "མཆིས་པ་གནས་པའམ་འདུག་པའི་མལ་གནས་དུག་སྦྲུལ་གྱི་མཆིལ་མ་རྩ་སྔོན་ལ་གོས་པ་ལས་སྐྱོབ་པའི་རྐང་ལྷམ་སྟེ་ལྷམ་སྤྱིར་ཡང་གོ་མཆིག་རང་འཐག་སོགས་ཀྱི་མས་གཏུན་མཆིག་གུ་ཡས་གཏུན།",
    "འདོད་པ་ལ་འཆུམས་པ་ཆགས་པའི་དོན་གནས་འཆའ་བ་འདུག་ས་བཟོ་བ་འཆེལ་པ་ཞེན་པའི་དོན་ཡིན་པར་སྣང་འཆུར་བ་གནས་སུ་གཅུར་བ།",
    "གཞུ་མདའ་སྟན་བདུངས་པ་བཀུག་པའམ་བཀང་བ་བདོག་པ་ཡོད་པ་དང་ནོར་རྫས་ལ་སོགས་པའི་མིང་སྐྱེལ་བདར་སྐྱེལ་གླ་ཕེབས་སྐྱེལ་བྱས་པའི་རྔན་པ་བདར་བ་སྦྱིན་པ་བདོག་པ་ཡོད་པའམ་འདུག་པ།",
    "བསྡུ་བྱ་ནོར་སོགས་བསྡུ་བ་བཏུ་བ་བསྡུས་པ་བཏུས་པ་སྡུད་པ་བསྡུར་བ་སྡུར་བ་མཉམ་པར་བྱེད་པ་འགྲན་པ་བསྒྲུན་ནས་བསྡད་པ་སྡོད་པ་འདུག་པ།",
    "ནག་རྩིས་ཀྱི་སྨེ་བ་གཅིག་དཀར་སོགས་དགུ་དང་སྨོན་པ་སྨད་པ་སྨྱོས་པ་སྨིན་བྱེད་སྨྱུང་སྨྲེད་པ་སྨད་འཚོང་སྨས་པ་སྨྲིག་སྨྲེ་པ་སོགས་སར་བཏགས་མའོ། ཙ་ཙབ་ཙུབ་ཚབ་ཚུབ་མི་བརྟན་པ་མི་བྱ་མི་བགྱི་ཙོག་ཙོག་པུ་ཙོག་པུ་འདུག་སྟངས་ཤིག།",
    "ཙཱ་རུ་ཞེས་པའི་དོན་བཟའ་བའམ་ལྷ་བཤོས་དང་མཛེས་པ་ཙ་ན་ཀ་སྲན་ཆུང་ཞིག།",
    "འ་དངོས་སུ་ཡོད་པ་ལ་ཐོབ་དཔེ་དགའ་ཞིང་བཟའ་ཞེས་གདའ་ཞེའོ།",
    "དུ་ཇི་ཙམ་གདའ་ཞེ་ན་འགའ་ཞིག་གོ་ལྟ་བུ།",
    "མཐའ་རྟེན་ག་སོགས་གཞན་གྱི་མཐར་ག་སོགས་རང་རང་ལ་མ་དང་སྣ་རུ་སྦྱར་བས་གམ་སོགས་དང་གོ་སོགས་ཐོབ་པའོ།",
    "རང་རང་སོ་སོའི་བརྡ་ལ་རྣམ་པར་དཔྱོད་པའི་རིག་པས་ཀྱང་དཔྱད་པར་བྱའོ།",
    "གྲུ་ལ་འགྲོ་བའི་སྐབས་སུ་ང་རང་སྔོན་ཆད་གྲུ་ལ་འགྲོ་མ་མྱོང་བ་ཡིན་དུས་ཡིན་གཅིག་མིན་གཅིག་གྲུ་གཏོང་མཁན་ཉམས་མྱོང་ཅན་ཆུ་ལ་རྒྱུས་ཡོད་པ་ཞིག་དགོས།",
    "དེ་མེད་ན་ང་རང་ཆུས་འཁྱེར་འགྲོ་བ་ཡང་ཡོང་སྲིད།",
    "འོན་ཀྱང་རང་ལ་དེ་ལྟ་བུའི་འཇིགས་སྐྲག་དང་སྡུག་བསྔལ་མེད་པ་ལ་བརྟེན་ནས་གཞན་འཇིགས་སྐྲག་དང་སྡུག་བསྔལ་ཡོད་པ་དེ་ཚོ་གང་བྱུང་དུ་གཡུགས་བཞག་པ་ལྟ་བུ་མ་ཡིན་པར།",
    "གཉིས་པ་དེ་ང་རང་རྐྱང་པའི་ཆེད་མ་ཡིན་པ།",
    "ཡིན་གཅིག་མིན་གཅིག་དུས་ཚོད་ཐུང་ཐུང་ཞིག་ཡིན་ན་ཡང་འཕྲོ་བརླག་མ་ཤོར་བ་ཞིག་བྱས་ནས་སྒྲུབ་དགོས་ཀྱི་ཡོད།",
    "ང་རང་དང་།",
    "བོར་ཐབས་མེད་པ་རྟག་པར་ང་རང་དང་མཉམ་དུ་ཡོད་པ་འདྲ་པོ་ཞིག་བསམ་གྱི་ཡོད།",
    "དེ་ལས་ཀྱང་གཅེས་པར་འཛིན་པའི་གྲོགས་པོ་དེ་ང་རང་ལ་མེད་དུ་མི་རུང་བ་འདྲ་པོ་ཞིག་ཡིན་སྙམ་ནས་རྩ་ཆེན་པོར་རྩིས་ཀྱི་ཡོད།",
    "ད་ལྟ་ཁྱེད་རང་ཏོག་ཙམ་ནོར་གྱི་འདུག།",
    "ད་ལྟ་ཁྱེད་རང་ཡག་པོ་ཞེ་དྲག་འདུག།",
    "ང་རང་ལ་ཡག་པོ་བྱས།",
    "ང་རང་ལ་བྱམས་པ་བྱས།",
    "ང་རང་གཅིག་པོ་སྐྱིད་པོ་བྱེད།",
    "ང་རང་ལ་བརྩེ་བ་ཆེན་པོ་ཅན་དེ་ཚོར་ཧ་ཅང་སྡུག་པོ་བྱུང་ན་ང་རང་བདེ་བ་བྱུང་ན་ཕན་པ་ཅི་ཡོད།",
    "དེ་ལ་ཡིན་གཅིག་མིན་གཅིག་བསྔོ་བ་བྱེད་དགོས་པར་གདའ།",
    "ཡིན་གཅིག་མིན་གཅིག་ཁོ་རང་སུ་ཡིན་ན་ཡང་དོན་ལ་ཕན་པར་ཤོག་སྙམ་པའི་བློ་བསྐྱེད་དེ།",
    "དངོས་སུ་ཁོ་རང་ཡོང་ནས་འཕྲོག་པ་ཡིན་ན་ཡང་འདྲ།",
    "ཁོ་རང་ལ་ཡག་པོ་ཞིག་ཡོང་བར་ཤོག་བསམ་པ་དང་།",
    "དེ་ཡང་རང་ལ་དངོས་གནས་སྡུག་པོ་བཏང་དགོས་པའི་ཉེས་པ་ཅུང་ཟད་ཙམ་ཡང་མེད་བཞིན་དུ།",
    "ང་རང་ལ་སྐྱོན་གང་ཡོད་པ་དེ་དངོས་སུ་མི་མང་པོའི་དཀྱིལ་དུ་ལབ་ནས་མཚང་ནས་འབྲུ་ཞིང་།",
    "ཡང་སྐབས་སྐབས་ལ་ང་རང་ལ་མི་མང་པོའི་དབུས་སུ་མི་དེས་མཚང་ནས་བྲུས་ཞིང་སྐྱོན་སྨྲ་ན།",
    "ང་རང་དང་ཡོན་ཏན་མཉམ་པ་ལོངས་སྤྱོད་མཉམ་པ་རིགས་རུས་མཉམ་པའམ།",
    "ཡང་ན་རང་ལས་དམན་པ་རང་ལས་ཐབས་སྐྱོ་བོ་རང་ལས་ཡོན་ཏན་ཆུང་བ་རང་ལས་སྐྱོན་མང་བའི་སྐྱེ་བོ་ཁོ་རང་ལ་ང་རྒྱལ་ཤུགས་ཆེན་པོ་ཡོད་པ།",
    "རང་ལས་དམན་པ་སྐྱོན་མང་པོ་ཡོད་པ་དང་ཡོན་ཏན་ཉུང་ཉུང་ཡོད་པ་འདི་ལྟ་བུ་ཞིག་ཡིན་ཡང་ང་ལ་བརྙས་བཅོས་བྱེད་ཀྱི་འདུག་སྙམ་པའི་དམིགས་བསལ་ཁོང་ཁྲོ་དང་།",
    "དང་པོ་དེ་འཚོ་བས་ཕོངས་ཤིང་ཟེར་བ་ནི་ང་རང་དུས་རྒྱུན་དུ་ལོངས་སྤྱོད་མེད་པ་འཚོ་བ་ཤིན་ཏུ་ཕོངས་པ།",
    "དེ་བཞིན་དུ་ང་རང་ལ་དུས་རྟག་ཏུ་མིས་བརྙས་བཅོས་བྱེད་པའམ་མི་སྐད་གྲགས་ཅན་ནམ་མི་སྙན་གྲགས་ཅན་ལྟ་བུ་མ་ཡིན་པར་མིས་རྟག་ཏུ་བརྙས་པ།",
    "ང་རང་ལ་ཞེན་ཆགས་སྐྱེས་པའི་དངོས་པོ་དེ་རྣམས་འཕྲལ་ལ་སྤོང་བ་སྟེ།",
    "ང་རང་དེ་ལ་ཞེན་ཆགས་སྐྱེས་པ་འདུག་བསམ་པ་དེ་གནས་སྐབས་ཕར་གཡུགས།",
    "ཁོ་རང་རང་བཞིན་གྱིས་གདོད་དུ་མ་གྲུབ་པའི་ངོ་བོ་དེ་ལྟ་བུའི་སྒོ་ནས།",
    "དེ་བདེན་པ་ལ་བཟུང་ན་དེ་ནས་ཨ་ཐང་ཆད་ཟེར་མཁན་དེ་དཔེ་མི་སྲིད་པའི་ང་རང་ང་རང་ཐང་ཆད་དགོས་པ་འདྲ་པོ།",
    "དེའི་ལན་ལ་སང་ཉིན་ང་རང་རྦད་དེ་སྐྱོ་པོ་དང་།",
    "ཡང་ན་ཁོ་རང་ལ་གནོད་པ་བརྒྱབ་མཁན་འདྲ་པོ།",
    "དེ་ནས་ཁོ་རང་ལ་དངོས་པོ་དེ་སྦྱིན་པ་བཏང་ན་སྦྱིན་པ་བཏང་བ་ལ་བརྟེན་ནས།",
    "དཔེ་མི་སྲིད་པའི་བརྟན་པོ།",
    "ང་རང་ལ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཤིག་ཡོད་ན།",
    "སྐྱོན་ཏོག་ཙམ་ཞིག་འདུག་བསམ་པ་ཞིག་དང་།",
    "ང་རང་ལ་ཐོག་མ་མེད་པ་ནས་གང་དུ་བག་ཆགས་དེ་ཞེ་དྲག་སྤངས་དཀའ་པོ།",
    "དུས་རྒྱུན་དུ་ང་རང་ལ་ཉེན་ཁ་མི་འདུག་བསམ་པ་ཞིག་མ་བྱུང་བར་དུ།",
    "དེ་སྲིད་པ་ཡིན་པའི་ཕྱིར་ན་དེ་ལ་སྐྱོན་འདི་འདྲ་འདུག་ཟེར་ནས་བརྟག་ན།",
