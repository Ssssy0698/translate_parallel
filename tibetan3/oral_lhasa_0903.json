    "ཉ་བརྩོན་གཉིས་ཀྱིས་ཐོག་པས་ཞལ་འཕྲད་མ་གནང་བས།",
    "ཞུ་བའི་ཚིག་འདི་ཅུང་ཟད་གསན་པར་རིགས།",
    "ཡོན་ཏན་ཁྱེད་དྲུག་ལས་ལྷག་པ་ཕྱིན་ཆད་མི་ཞེས་སོགས་ཀྱི་ཞུ་མཆིད་ཕུལ་ཏེ་ཕྱོགས་ལ་ཕེབས་པས།",
    "སུམ་ཅུ་པ་ལྕགས་ཕོ་ཁྱི་ནས་བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།་",
    "ཉ་བརྩོན་གཉིས་ཀྱི་སློམ་མ་གཡག་གཞོན་རྣམ་གཉིས་ཞེས་བསྟན་པའི་གསལ་བྱེད་དམ་པར་གྱུར།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོབརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ལྕགས་ཕོ་སྟག་ལ་བལྟམས་དེས་ན་མཁན་ཆེན་གཡག་པས་དོན་ལྔ་བཞུགས་ཏེཀརྨ་པ་དཀོན་གཞོན་གྱི་གསུང་བོས་བསྟན་པ་ལ་བྱ་བ་བྱས་པ་ཡིན་ཞེས་དང་ནས་ཤིང་རྟ་ལ་གཤེགས་པས་སོ།",
    "ལོ་བཅོ་བརྒྱད་པ་ལ་ས་བཟང་མ་ཏིའི་དྲུང་གྲོགས་ཀྱི་སྟོབས་ཀྱིས་ཀུན་མཁྱེན་ཆེན་པ་ཤིག་ཡིན་ནའང་།",
    "མཁས་པ་བླུན་རྨོངས་ཁོ་ནའི་སྤྱོད་ཡུལ་ལོརྒྱ་ཆེར་བསགས་པར་སྣང་བ་ནི།",
    "ལོ་ཙཱ་བ་གཉིས་བཞུགས་པའི་ལོ་ལྔ་རྩོད་སྒོམ་གཙོ་བོར་སྟོན་པའི་ཐུགས་དམ་ཉམས་ལོ་ཙཱ་བ་སྐྱབས་མཆོག་དཔལ་སོགས་ལས་གསང་འདུས་སོགས་ཀྱི་གྲགས་རྒྱལ།",
    "ལོ་བདུན་སྐལ་ལྡན་གྱི་གདུལ་བྱ་བརྒྱད་ཅུ་སྐོར་ལ་ཉམས་བཞེས་ཁོ་ན་མཛད།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དེ་ཡན་དུ་ཡང་བཀའ་བཞི་ལེགས་པར་སྨྲ་བ་བཅུ་ཕྲག་གཅིག།",
    "རྒྱལ་ཚབ་དར་མ་མན་ཆད་ནས་བྱུང་བར་མེད་མི་བཞུགས་པས།",
    "ཞེས་བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དགུང་ལོ་བཅུ་དྲུག་པ་ལ་དབུས་གཙང་ལ་བྱོན།",
    "གཙང་ཕྱོགས་ཀྱི་ཞ་ལུ།",
    "ས་སྐྱ་འབྲུག་ལ་ས་སྐྱ་ནས་ཤར་ཕྱོགས་ལ་ཕེབས།",
    "བོ་དོང་དུ་གྲྭ་སྐོར་མཛད་ནས་སྣར་ཐང་དུ་ཕྱག་ཕེབས།",
    "དེ་ཉིད་ཀྱི་ཐུགས་སྲས་དམ་པར་གྱུར།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།་",
    "དེ་ནས་ཁྱད་པར་བསྙེན་བཀུར་ཆེར་མཛད་པ།",
    "ཐམས་ཞིང་བསྙེན་པར་རྫོགས།",
    "ཀུན་མཁྱེན་འདི་གསུམ་ལས་འཆད་པའི་རྒྱུན་དང་།",
    "དབུས་གཙངདུ་གྲྭ་སྐོར་མཛད་པའི་པོ་ཏི་བཅུ་ཁོ་བཞིའོ།",
    "གཙང་པ་སེམས་དཔའ་ཆེན་པོ་མཛད་སྤྱོད་མཚུངས་པ་གསུམ་ནི།",
    "གཙང་རོང་བྱམས་ཆེན་གསུང་ཐུགས་ཀྱི་མཛད་སྤྱོད་མཚུངས་པའི་བུ་ཆེན་གསུམ།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "མཁན་ཆེན་པས་རང་རིག་ཡུལ་མེད་དུ་ཞལ་གྱིས་བཞེས་པ་ལ།",
    "ཕས་རྒོལ་གྱི་རྒོལ་བ་ཉིད་གཤིས་ལ་ཕམ་ཆེན་པས་གཟུགས་སྒྲ་ཀ་བུམ་སོགས་རྟག་པར་ཁས་བླངས་པ་ལ།",
    "པར་རིག་པ་ག་ལ་ཡིན་ཏེ།",
    "པཎ་ཆེན་པས་ས་པའི་སྒོ་ནས་སྙན་པར་གྲགས་སོ།",
    "ཡང་དག་པར་ན་དེ་གཉིས་ཡང་མ་ཡིན་ནོ།",
    "ཤོང་སྟོན་རྡོ་རྗེ་རྒྱལ་མཚན་ལ་སོགས་པས་ཀྱང་དེ་ལྟར་གནང་བ་མེད་པར་ཁས་བླངས་མི་དགོས་པའི་ཕྱིར་རོ།",
    "བཟོ་རིག་ནས་བཟུང་ཡོངས་པར་བྱས་སོ།",
    "འཇམ་པའི་རྡོ་རྗེ་རྒྱལ་གྲགས་པས་མཐུན་པའི་རྐྱེན་སྦྱར་ཏེ་ཀུན་མཁྱེན་རོང་སྟོན་ཆེན་པོ་སློབ་བུའི་མི་ཡི་ཟློས་གར་མཁན།",
    "ཕྱོགས་ལས་རྣམ་འཇམ་དབྱངས་ཀྱི་དཀྱིལ་འཁོར་དྲུག་ཅུའི་རྣམ་གྲངས་ལེགས་པར་བགྲངས་ཤིང་།",
    "པར་རྒྱལ་བའི་བཤེས་གཉེན་དྲུག།",
    "དཀའ་བཅུ་ལེགས་པར་སྨྲ་བ་སྟོང་ཕྲག་གཅིག།",
    "ཚེ་འདི་བློས་འདུས་པ་ལ་རྩོམས་ཤིག་ཅེས་གནང་བ་ནོད་པ་དང་།",
    "ལྷག་པར་རྒྱལ་བ་ཐམས་ཅད་བསྐྱེད་པའི་ཡུམ།",
    "ས་ལ་དགེ་སློང་མ་ཡིས་རབ་གྲགས་བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།་",
    "པ་ སྤྲུལ་པའི་གར་གྱིས་གསང་བ་འཛིན་པར་མཛད།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དེའི་མཁན་རིམ་པར་བཟུང་ཞིང་བོ་དོང་པ་ཞེས་སྙན་པར་གྲགས་སོ།",
    "པཎ་ཆེན་འདིས་དོན་བདུན་བཞུགས།",
    "ཤབ་ལྷུན་རྩེ་བ་ཀུན་མཁྱེན་དང་བཅུ་བཞི་འདས་པའི་བཅོ་ལྔ་པ་ཆུ་ཕོ་ཁྱི་སྤྱི་ལོ་༡༣༨༢ལ་དཔལ་ལྡན་ས་སྐྱའི་འཕགས་འོད་དང་།",
    "དགུང་ལོ་དོན་ལྔ་པ་མེ་བྱི་སྤྱི་ལོ་༡༤༥༦ལོར་སྐུ་འདས་པ་བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ལོ་ཉི་ཤུ་རྩ་ལྔ་བཞེས་ཀྱི་བར་དུ་གཙོ་ལ་འཛེགས་བྱོན་པས།",
    "ས་བཟང་བ་བེར་ཐུལ་མནབ་པ་གཅིག་དང་མཇལ་ཏེ་ཟག་མེད་ཀྱི་དགའ་བ་ཆེན་པོ་མྱོང་བ་འཕགས་པས་གསང་སྟོན་བགྱིས་ཏེ་བསྙེན་པར་རྫོགས་པར་མཛད།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།་",
    "ལོ་ལྔ་པ་ལ་འབྲས་ཚར་གསུམ་གྱིས་ལྷག་པའི་བཅུ་ཕྲག་བརྒྱད་གནང་།",
    "ཤར་ཡེས་སློབ་དཔོན་མཛད་དེ་བསྙེན་པར་ཁྱེབས་སུ་ཉིས་བརྒྱ་འདུ་བ།",
    "ཀུན་མཁྱེན་གོ་དགའ་ལྡན་དུ་ཕྱིན།",
    "བསྟན་རྩིས་གསལ་བའི་ཉིད་བྱེད་ལྷག་བསམ་རབ་དཀར་ཞེས་བྱ་བ་བཞུགས་སོ།་",
    "དོན་གསུམ་པ་འབྲུག་ལོར་མུས་གངས་ཆེན་ཀུ་དགའ་དཔལ་ལས་བསྙེན་པར་རྫོགས།",
    "འབྲོག་མ་ཚུགས་པར་ཁ་ཡུལ་ཆགས་ཏེ་རྫི་བོ་སོགས་ཀྱང་མཛད།",
