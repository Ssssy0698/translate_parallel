    "གཅིག་པ་ཉིད་ཅིའི་ཕྱིར་ཞེས་པ་ལ་གསུངས་པ།",
    "གང་ཞིག་དུ་མ་ཉིད་སྣ་ཚོགས་ཀྱི་རྣམ་པར་ཡོད་པ་ནི་མི་སྐྱེ་སྟེ།",
    "གལ་ཏེ་དུ་མའི་རྒྱུས་སྣ་ཚོགས་ཀྱི་རྣམ་པར་རྟོགས་ན་དེ་ལྟ་ན་རྒྱ་མཚོར་ཞུགས་པའི་ཆུ་བོ་རྣམས་སྣ་ཚོགས་སུ་སོ་སོར་སྣང་བར་རིགས་སོ།",
    "དེའི་ཕྱིར་དུ་མ་ཉིད་དུ་མི་འབྱུང་ཞེས་པའི་རིགས་པ་གསུངས་པའོ།",
    "དེ་ལ་རང་བཞིན་གྱིས་ཡོད་པའི་ཆུ་བོ་རྣམས་འདིར་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་སོགས་པའི་གཅིག་པ་ཉིད་དུ་བརྗོད་པར་མི་ནུས་ཏེ།",
    "ཇི་སྐད་དུ་གསུངས་པ།",
    "འདི་རྣམས་གསུངས་པར་གྱུར་པ།",
    "སེམས་པ་དང་བདག་ལ་སོགས་པ་ཡོད་པར་རིགས་པས་མི་རྟོགས་སོ།",
    "གལ་ཏེ་རིགས་པ་ཡོད་པར་གྱུར་ཀྱང་།",
    "དེ་ཁོ་ན་ཉིད་གཅིག་པ་དེ་ལྟར་དེ་ཁོ་ན་ཉིད་གསུམ་གང་ལས་ཐོབ་པར་བྱ་ཞེས་པ་ལ་གསུངས་པ།",
    "དེ་ལ་མན་ངག་བསྟན་པ་གསུངས་པ།",
    "གང་དུ་གནས་ཞེས་པ་ལ་གསུངས་པ།",
    "དེའི་ཁྱད་པར་ཇི་ལྟ་བུ་དང་ལྡན་ཞེས་པ་ལ་གསུངས་པ།",
    "ནམ་མཁའ་གཅིག་པུས་ནི་མ་ཡིན་ཏེ་པདྨས་ཀྱང་བརྒྱན་ཞེས་པ་ལ་གསུངས་པ།",
    "དེ་ཇི་ལྟ་བུའི་རྣམ་པར་གནས་ཞེས་པ་ལ་ཁུ་པ་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཁུ་བས་ཕྱེ་བ་ཉིད་ཀྱིས་ཁུ་བ་སྟེ་བདུད་རྩི་གཞོམ་དུ་མེད་པར་ཡང་དག་པར་རིག་པའི་ཚུལ་འདིས་ན་བདུད་རྩིས་གཟུགས་སོ།",
    "གཞན་ཡང་དེའི་བྱེ་བྲག་ཏུ་བྱ་བའི་ཕྱིར་གསུངས་པ།",
    "དེ་གཉིས་ལས་རྣམ་པར་གྲོལ་བ་ནི་བྲལ་བའོ།",
    "གནས་དེར་ཅི་ཞིག་བྱེད་ཅེས་པ་ལ་གསུངས་པ།",
    "དེའི་ཚུལ་ཇི་ལྟ་བུ་ཞེས་པ་ལ་ལུས་ཀྱི་རབ་ཏུ་སྦྱོར་བས་རྒྱས་པར་བྱ་བའི་ཕྱིར་གསུངས་པ།",
    "དེ་ལྟར་གྱུར་པ་དེའི་འགྲོ་བའི་སྤྱོད་པ་གསུངས་པ།",
    "གང་དུ་གསུངས་པའི་ལུས་འདི་དག་ལ་ཇི་ལྟ་བ་བཞིན་རོལ་ཏེ་དེའི་ཕྱིར།",
    "གཞན་ནི་དེ་ཉིད་རྣམ་པར་གནས་ཞེས་པ་འདིར་འབྲེལ་ཏོ།",
    "དེ་ལྟར་རྣ་བའི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་ལྷའི་སྤྱོད་ཡུལ་བསྒྲིབས་པ་ལ་སོགས་པའི་དངོས་པོ་ཡོངས་སུ་གཅོད་པས་སྒྲ་ཉན་པར་བྱེད་དོ།",
    "སྣོམ་པ་ནི་སྣའི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་དྲི་བཟང་པོ་ལ་སོགས་པའི་དྲི་རྣམས་སྣོམ་པར་བྱེད་དོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་རོ་ཞིམ་པ་ལ་སོགས་པའི་རྫས་རྣམས་མྱོང་བར་བྱེད་དོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་ཚིག་རབ་ཏུ་རྒྱས་པ་སྟེ་ལེགས་པར་སྦྱར་བ་ལ་སོགས་པའི་མཛེས་པ་རྣམས་སོ།",
    "འཛིན་པ་ཞེས་པ་ནི་སོ་སོར་འཛིན་ཅིང་ཞེན་པའི་སྲིད་པའི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་ལེན་པར་བྱེད་དོ།",
    "རྒྱུག་པ་ཞེས་པ་ནི་འགྲོ་བ་ལ་བརྟེན་ནས་མགྱོགས་པར་རྒྱུག་པའོ།",
    "གཉིད་དང་བྲལ་བས་རབ་ཏུ་སད་པར་འགྱུར་རོ།",
    "དགོད་པའི་དངོས་པོ་ལ་བརྟེན་ནས་དགོད་པར་བྱེད་དོ།",
    "སྣ་ཚོགས་གཟུགས་ཞེས་པ་ནི་ལྷ་དང་ལྷ་མ་ཡིན་ལ་སོགས་པའི་བག་ཆགས་ཀྱི་མཚམས་སྦྱོར་བ་ལ་མཉམ་པར་བརྟེན་པའི་སྦྱོར་བ་ལས་སོ།",
    "སྣ་ཚོགས་གཟུགས་ཀྱི་ནོར་བུ་འདིས་དཔེས་སོ་སོར་རྟོགས་པར་བྱ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་གཞོམ་དུ་མེད་པའི་རྣམ་པ་སྟེ་དེ་ལྟ་བུར་འགྱུར་བའི་འགྲོ་བའི་གྲོང་དུ་རྣམ་པར་གནས་པའོ།",
    "མེད་པར་བསྟན་པའི་ཕྱིར་གསུངས་པ།",
    "འདི་ཞེས་པ་ནི་དེ་མ་ཐག་ཏུ་གསུངས་པའོ།",
    "འཛིན་པ་ལ་སོགས་པའི་ཉེ་བར་ལོངས་སྤྱོད་པ་ཐམས་ཅད་ནི་མེད་ཅིང་འདོད་པ་ཐམས་ཅད་ལ་ཉེ་བར་ལོངས་སྤྱོད་པ་ལ་འཇུག་པ་ནི་ཡོད་པར་དགོངས་སོ།",
    "དེ་ནས་ཐམས་ཅད་ལ་ཉེ་བར་ལོངས་སྤྱོད་པ་ཉིད་ཀྱིས་འགྲུབ་ཅེས་བསྟན་པའི་ཕྱིར་གསུངས་པ།",
    "འདོད་པར་བྱ་བ་ཉིད་ཀྱིས་པདྨའོ།",
    "དེས་ཅིར་འགྱུར་ཞེས་པ་ལ་གསུངས་པ།",
    "འགྲུབ་པ་ནི་འབྲས་བུ་ཐོབ་པར་འགྱུར་རོ།",
    "བརྟག་པ་གཉིས་པ་ལས་ཀྱང་རྒྱས་པར་གསུངས་པ།",
    "ཞེས་པར་འབྲེལ་ཏོ།",
    "ཁྱད་པར་ཇི་ལྟ་བུའི་བདག་ཉིད་ཅེས་པ་ལ་སུམ་ཅུ་རྩ་གཉིས་ཞེས་པ་ལ་སོགས་པའོ།",
    "གཙང་མ་ཞེས་པ་སྟེ་སུམ་ཅུ་རྩ་གཉིས་སོ།",
    "རྟོགས་པར་བྱས་ལ་དེའི་གནས་རྣམས་སུ་ངེས་པར་བསྟན་པར་བྱའོ།",
    "འདི་དག་ཅེས་པ་ནི་དེ་མ་ཐག་ཏུ་གསུངས་པ་ཉིད་དོ།",
    "རྣམ་པར་སྣང་མཛད་ནི་རབ་ཏུ་གནས་པར་ཟད་དོ།",
    "དེ་རྣམས་ཀྱིས་རྣམ་པར་མི་ཤེས་པའི་དོན་ནི་ཤེས་ཀྱང་གཞན་དག་ལ་མ་བསྟན་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ལྟ་བུའི་ཆོ་གས་གསོལ་བ་འདེབས་པར་བྱེད་པ་མེད་པས་ནའོ།",
    "དེ་ལྟ་བུའི་ཆོ་གས་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་ལ་སོགས་པ་གདབ་པས་གསོལ་བ་འདེབས་པར་བྱེད་པ་ཡོད་ན།",
    "བསྟན་པའི་བྱེ་བྲག་རྣམས་བསྟན་པར་འགྱུར་རོ།",
    "རྒྱུད་རྣམས་བསྟན་པར་མ་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་པ་དེ་གསུངས་སོ།",
    "གང་ཞིག་འདིར་གསུངས་པ།",
    "མཱ་མ་ཀཱིས་རང་དགར་བརྩམས་པ་ནི་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་གསུངས་པ།",
    "རྡོ་རྗེ་ཅན་གྱིས་གསུངས་ཞེས་པ་ལ་སོགས་པའོ།",
    "རྒྱས་པར་བསྟན་པའི་མིང་གསུངས་པ།",
    "མཱ་མ་ཀཱིའི་གླུ་ཡིས་གསོལ་བ་འདེབས་པར་བྱེད་ཅེས་གསུངས་པ།",
    "དགྱེས་ཞེས་པ་ནི་དེ་ཁོ་ན་ཉིད་རྟོགས་པས་དེ་ཡང་དག་པར་དགྱེས་པའོ།",
