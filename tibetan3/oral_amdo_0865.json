    "གནས་སྐབས་གཞན་གྱི་བྱེ་བྲག་གིས་ཡང་བསྟན་ཏོ།",
    "དེ་དག་གི་སོ་སོའི་མཚན་ཉིད་ཀྱང་བསྟན་ཏོ།",
    "ཇི་ལྟར་ནམ་མཁའ་ཡོད་པ་དེ་བཞིན་དུ་ཁམས་ལྷག་མ་རྣམས་ཀྱང་རང་གི་མཚན་ཉིད་ཡོད་པའི་ཕྱིར་ཡོད་དོ།",
    "མཚན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར།",
    "མི་འཇུག་དེ་ལྟར་གང་གི་ཕྱིར་མཚན་ཉིད་མེད་པའི་དངོས་པོ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་མཚན་ཉིད་མེད་པའི་དངོས་པོ་མེད་ན་དེ་གཞི་མེད་པ་ལ་མཚན་ཉིད་འཇུག་པར་མི་འཐད་དོ།",
    "དངོས་པོ་རང་གི་མཚན་ཉིད་དང་བཅས་པར་རབ་ཏུ་གྲུབ་པ་ལ་ཡང་མཚན་ཉིད་ཀྱིས་ཅི་ཞིག་བྱ།",
    "དེ་ལྟ་ན་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "རྟག་ཏུ་མཚན་ཉིད་འཇུག་པར་ཐལ་བར་འགྱུར་རོ།",
    "འདི་ལྟར་ཁྱོད་ཀྱིས་མཚན་ཉིད་དང་ལྡན་པ་ལས་ཁམས་རབ་ཏུ་འགྲུབ་པར་བསྟན་ན་མཚན་ཉིད་དང་ལྡན་པ་དེ་ཡང་མཚན་ཉིད་མི་འཇུག་པའི་ཕྱིར་མི་འཐད་དོ།",
    "དེ་མེད་ན་ཁྱོད་ཀྱི་མཚན་ཉིད་ཀྱི་གཞི་གང་གིས་འགྲུབ་པར་འཐད།",
    "དེ་རེ་ཞིག་མཚན་ཉིད་ནི་ཡོད་དེ།",
    "དེ་ལྟར་གང་གི་ཕྱིར་རྣམ་པ་ཐམས་ཅད་དུ་བརྟགས་ན་མཚན་ཉིད་འཇུག་པར་མི་འཐད་པ་དེའི་ཕྱིར་མཚན་ཉིད་ཀྱི་གཞི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་མཚན་ཉིད་ཀྱི་གཞི་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་གང་ཞིག་མེད་པའི་མཚན་ཉིད་ཀྱང་ཡོད་པ་ཉིད་མ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་དེ་བརྗོད་པར་མི་ནུས་མོད་ཀྱི།",
    "འོན་ཀྱང་རེ་ཞིག་དངོས་པོ་ནི་ཡོད་དོ།",
    "འདི་ལ་ཁྱོད་ན་རེ་མཚན་ཉིད་ཀྱི་གཞི་དང་མཚན་ཉིད་དག་མེད་དོ་ཞེས་ཟེར་བ་དེ་ནི་དངོས་པོ་ལ་ལྟོས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་གང་གི་དངོས་པོ་མེད་དོ་ཞེས་བརྗོད་པའི་དངོས་པོ་དེ་ནི་འགའ་ཞིག་ཡོད་པས་དེ་ལྟ་བས་ན་དངོས་པོ་མེད་པ་ཡོད་པའི་ཕྱིར་དངོས་པོ་ཡོད་པ་ཉིད་དོ།",
    "དངོས་མེད་གང་གི་ཡིན་པར་འགྱུར།",
    "ཞེས་བསྟན་པས་དངོས་པོ་དེ་ཡོད་པ་མ་ཡིན་ན་ཁྱོད་ཀྱི་དངོས་པོ་མེད་པ་དེ་གང་གི་ཡིན་པར་བརྟག།",
    "དངོས་པོ་དེ་ཡང་ཡོད་པ་མ་ཡིན་ན་དངོས་པོ་མེད་པ་དེ་གང་གི་ཡིན་པར་འགྱུར།",
    "གང་གི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དེ་དག་ཤེས་པར་བྱེད་ཅིང་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་རྟོག་པར་བྱེད་པ་དེ་ནི་རེ་ཞིག་ཡོད་དོ།",
    "གང་གིས་དངོས་དང་དངོས་མེད་ཤེས།",
    "དེ་ལྟར་གང་གི་ཕྱིར་བརྟགས་ན་མཚན་ཉིད་ཀྱི་གཞི་དང་མཚན་ཉིད་དག་མེད་ཅིང་།",
    "མེད་པ་ཉིད་དུ་རྗེས་སུ་ལྟ་བ་ཆད་པ་དང་རྟག་པར་ལྟ་བས་བློ་གྲོས་ཀྱི་མིག་བསྒྲིབས་པ་དེ་དག་གིས་ནི་མྱ་ངན་ལས་འདས་པ་ལྟ་བར་བྱ་བ་ཉེ་བར་ཞི་ཞིང་ཞི་བ་མི་མཐོང་ངོ།",
    "འཇིག་རྟེན་ནི་ཕལ་ཆེར་ནམ་མཁའ་ལ་ཅི་ཡང་མ་ཡིན་པར་མོས་ཏེ།",
    "འདི་ལྟར་སྨྲ་བ་པོ་དག་ན་རེ་སྤྲོས་པ་དེ་དག་ཐམས་ཅད་ནི་ནམ་མཁའོ།",
    "ཞེས་བྱ་བར་བསམ་མོ།",
    "ཁྱོད་ཀྱིས་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་དག་གི་སྟོང་པ་ཉིད་རྗེས་སུ་རབ་ཏུ་བསྟན་པས་ཁོ་བོ་སྟོང་པ་ཉིད་ཉན་འདོད་པར་གྱུར་གྱིས།",
    "ཁྱོད་ཀྱི་ཆགས་པ་ཡོད་པར་གྱུར་ན་ཡང་།",
    "རེ་ཞིག་ཆགས་པ་ནི་ཡོད་དེ།",
    "འདོད་ཆགས་མེད་ན་གང་གིས་དེ་ཆགས་པར་འགྱུར།",
    "ཁྱོད་ཀྱི་འདོད་ཆགས་ཡོད་པར་གྱུར་ན་ཡང་ཆགས་པ་མེད་པ་ཉིད་དུ་ག་ལ་འགྱུར་ཏེ།",
    "ཁྱོད་ན་རེ་གང་དག་ལྷན་ཅིག་ཉིད་དོ་ཞེས་ཟེར་བའི་འདོད་ཆགས་དང་།",
    "རེ་ཞིག་གཅིག་པ་ཉིད་ཡིན་ན་ལྷན་ཅིག་ཉིད་མི་འཐད་དོ།",
    "གལ་ཏེ་རེ་ཞིག་འདོད་ཆགས་དང་ཆགས་པ་དག་གཅིག་པ་ཉིད་ཡིན་ཡང་ལྷན་ཅིག་ཉིད་དུ་འགྱུར་ན་ནི་དེ་ལྟ་ན་གྲོགས་མེད་པར་ཡང་ལྷན་ཅིག་ཉིད་དུ་འགྱུར་རོ།",
    "རྟ་གཅིག་པུ་ཉིད་ལ་གྲོགས་མེད་པར་ཡང་ལྷན་ཅིག་ཉིད་ཡོད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "རྟ་ཐ་དད་པ་ཉིད་ལ་གྲོགས་མེད་པར་ཡང་ལྷན་ཅིག་ཉིད་ཡོད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དངོས་པོ་ཕན་ཚུན་མི་ལྟོས་པར་རེ་རེ་ལ་ཡང་ཡོད་པར་འགྱུར་བས་དོན་མི་འདོད་དེ།",
    "གང་གི་ཚེ་དེ་ལྟར་ཡང་རྟོག་ན་དེ་གཉིས་ཐ་དད་པ་ཉིད་དུ་གྲུབ་པ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་གཉིས་ལ་ལྷན་ཅིག་གི་དངོས་པོ་ཐ་དད་པའི་དངོས་པོ་དང་མི་མཐུན་པ་དེ་ནི་མེད་པར་ཅིའི་ཕྱིར་ཡོངས་སུ་རྟོག་པར་བྱེད་གང་གི་ཚེ་ཐ་དད་པའི་དངོས་པོར་གྲུབ་ན་ལྷན་ཅིག་གི་དངོས་པོར་བརྟགས་སུ་ཟིན་ཀྱང་།",
    "དེ་ལྟ་བས་ན་ལྷན་ཅིག་གི་དངོས་པོར་བརྟགས་སུ་ཟིན་ཀྱང་ཐ་དད་པ་ཉིད་ཀྱི་སྐྱོན་ཆགས་པ་ཁོ་ནའི་ཕྱིར་ལྷན་ཅིག་གི་དངོས་པོར་བརྟག་པ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "ཐ་དད་པའི་དངོས་པོར་རབ་ཏུ་གྲུབ་པ་མེད་ན་ལྷན་ཅིག་གི་དངོས་པོ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "འདི་ལྟར་ཁྱོད་ནི་ཐ་དད་པའི་དངོས་པོ་ཡོད་ན་དེ་གཉིས་ཀྱི་ལྷན་ཅིག་གི་དངོས་པོ་ཡོད་པར་འདོད་ན།",
    "ཐ་དད་པའི་དངོས་པོ་མེད་ན་ཁྱོད་ཀྱི་ལྷན་ཅིག་གི་དངོས་པོ་ཡོད་པར་ག་ལ་འགྱུར།",
    "འོ་ན་ཐ་དད་པའི་དངོས་པོ་གང་ཞིག་ཡོད་ན་འདོད་ཆགས་དང་ཆགས་པ་དག་ལྷན་ཅིག་གི་དངོས་པོར་འདོད་པ་ཅི་རེ་རེ་ལ་ཡོད་དམ།",
    "འོན་ཏེ་གཉི་ག་ལྷན་ཅིག་བྱུང་བ་ལ་ཡོད་དམ་འོན་ཏེ་ཁྱོད་ཀྱིས་རང་དགར་ཐ་དད་པའི་དངོས་པོ་གཞན་ཞིག་བརྟགས་ཀྱང་རུང་སྟེ།",
    "ཐ་དད་པ་གང་ཡོད་ན་འདོད་ཆགས་དང་ཆགས་པ་དག་ལྷན་ཅིག་གི་དངོས་པོར་འདོད་པ་དེ་སྨྲོས་ཤིག།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གང་དག་སྔར་འདས་པའི་རྣམ་པ་དེ་དག་གིས་དེ་ལྟར་འདོད་ཆགས་རྣམས་ཆགས་པ་དང་ལྷན་ཅིག་གམ་ཆགས་པ་མེད་པར་ཡང་འགྲུབ་པ་མེད་དོ།",
    "ཁྱོད་ཀྱིས་འདོད་ཆགས་དང་ཆགས་པ་བརྟག་པ་དེ་བྱས་པས་ཁོ་བོའི་ཡིད་སྟོང་པ་ཉིད་ཉན་པ་ལ་སྤྲོ་བར་བྱས་ཀྱི།",
    "དེ་ལ་རེ་ཞིག་འདུས་བྱས་སུ་ཡོངས་སུ་རྟོག་ན།",
    "དེ་དག་གིས་བུམ་པ་ཉིད་སྐྱེ་བ་དང་གནས་པ་དང་།",
    "ཅི་སྟེ་བྱེད་ན་ནི་མྱ་ངན་ལས་འདས་པ་འདུས་མ་བྱས་ཀྱང་འདུས་བྱས་ཀྱི་མཚན་ཉིད་ཡིན་པར་ཐལ་བར་འགྱུར་བས་དེ་ནི་མི་འདོད་དེ།",
    "འཇིག་པ་དག་རེ་རེ་ལ་ཡང་འདུས་བྱས་ཀྱི་མཚན་ཉིད་བྱ་བར་མི་ནུས་ཏེ།",
    "སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་དག་གང་གི་མཚན་ཉིད་དུ་འགྱུར།",
    "དེ་མེད་ན་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་དག་གང་གི་མཚན་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེ་ལྟར་རེ་ཞིག་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་དག་སོ་སོའམ།",
    "རེ་ཞིག་གནས་པ་ནི་ཡོད་དོ།",
    "དེ་མེད་ན་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་དག་གང་གི་མཚན་ཉིད་དུ་འགྱུར་ཞེས་བསྟན་ཟིན་པས་དེའི་ཕྱིར་འཇིག་པ་ཡང་འདུས་བྱས་ཀྱི་མཚན་ཉིད་དུ་མི་འཐད་དོ།",
    "འདི་ལྟར་གང་གི་ཚེ་ན་སྐྱེ་བ་དེའི་ཚེ་ན་གནས་པ་དང་འཇིག་པ་མེད་ལ།",
    "གང་གི་ཚེ་གནས་པ་དེའི་ཚེ་ན་སྐྱེ་བ་དང་འཇིག་པ་མེད་ཅིང་།",
    "གང་གི་ཚེ་འཇིག་པ་དེའི་ཚེ་ན་ཡང་སྐྱེ་བ་དང་གནས་པ་མེད་པ་དེའི་ཕྱིར་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་སོ་སོ་བ་དང་འདུས་པ་དག་ཀྱང་འདུས་བྱས་ཀྱི་མཚན་ཉིད་དུ་མི་འཐད་དོ།",
    "ལྟག་ཆོད་དེ་ལྟ་བུ་འབའ་ཞིག་གིས་ཅི་བྱ།",
    "ཡོང་ནི་གང་གི་སྐྱེ་བ་དང་།",
    "ཁོ་བོ་ལྟག་ཆོད་ཀྱི་ཕྱིར་མི་རྩོམ་གྱིས་ཁོ་བོ་ནི་དེ་ཁོ་ན་ཤེས་པར་བྱ་བའི་ཕྱིར་རྩོམ་མོ།",
    "རེ་ཞིག་གནས་སྐབས་གང་ལ་བུམ་པ་ཞེས་བྱ་བར་འགྱུར་བ་ལེགས་པར་སོམས་ལ་སྨྲོས་ཤིག།",
    "དེ་ལ་གང་གི་ཚེ་མ་སྐྱེས་པ་ལ་ནི་བུམ་པ་ཞེས་བྱར་ཡང་མི་རུང་སྟེ།",
    "བུམ་པ་མ་ཡིན་པ་སྐྱེ་ཞིང་ཞེས་བྱ་བ་དེ་རེ་ལྡེའམ།",
    "དེ་ལ་རེ་ཞིག་གལ་ཏེ་རེ་ལྡེའམ།",
    "ཅི་སྟེ་བུམ་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ཅིའང་མེད་པ་ཞིག་ཡིན་ན་ནི་ཅི་ཡང་མེད་པ་གང་ཡིན་པ་དེ་ཇི་ལྟར་སྐྱེ་ཅི་སྟེ་སྐྱེ་ན་ནི་རི་བོང་གི་རྭ་ཡང་ཅིའི་ཕྱིར་མི་སྐྱེ།",
    "དེ་ལ་རེ་ཞིག་གལ་ཏེ་དེ་དག་ལས་འདུས་བྱས་ཀྱི་མཚན་ཉིད་གཞན་ཞིག་ཡོད་ན་ནི་དེ་ལྟ་ན་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཐུག་པ་མེད་པར་ཡང་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "དེ་དག་ནི་རེ་ཞིག་འཁོར་ཅེས་བྱའོ།",
    "དེ་ལྟར་གཅིག་གིས་གཅིག་སྐྱེད་པར་བྱེད་པས་ཐུག་པ་མེད་པར་མི་འགྱུར་རོ།",
    "འཇིག་པའི་འཇིག་པས་ཀྱང་རྩ་བའི་འཇིག་པ་འཇིག་པར་བྱེད་པས་དེ་ལྟར་ན་འདི་ལ་ཡང་ཐུག་པ་མེད་པར་ཐལ་བར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་སྐྱེ་བའི་སྐྱེས།",
    "ཁྱོད་ཀྱི་རྩ་བས་མ་སྐྱེད་དེས།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་སྐྱེ་བའི་སྐྱེ་བས་རྩ་བའི་སྐྱེ་བ་སྐྱེད་པར་བྱེད་ན་ཁྱོད་ཀྱི་རྩ་བའི་སྐྱེད་པས་མ་སྐྱེས་པའི་སྐྱེ་བ་དེས་རྩ་བའི་སྐྱེ་བ་དེ་ཇི་ལྟར་སྐྱེད་པར་བྱེད་དེ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་རྩ་བ་ཡིས།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་རྩ་བའི་སྐྱེ་བས་བསྐྱེད་པའི་སྐྱེ་བའི་སྐྱེ་བ་དེས་རྩ་བའི་སྐྱེ་བ་དེ་སྐྱེད་པར་བྱེད་ན་སྐྱེ་བའི་སྐྱེ་བ་དེས་མ་སྐྱེད་པའི་རྩ་བའི་སྐྱེ་བ་དེས་སྐྱེ་བའི་སྐྱེ་བ་དེ་ཇི་ལྟར་སྐྱེད་པར་བྱེད།",
    "ཁྱོད་ཀྱི་དེ་ནི་སྐྱེ་བཞིན་པ།",
    "ཁྱོད་ཀྱི་རྩ་བའི་སྐྱེ་བ་དེ་སྐྱེ་བཞིན་པ་རང་ཉིད་མ་སྐྱེས་པ་དེས་གལ་ཏེ་སྐྱེ་བའི་སྐྱེ་བ་གཞན་དེ་སྐྱེད་པར་བྱེད་ནུས་ན་ནི་སྐྱེ་བའི་སྐྱེ་བ་དེ་སྐྱེད་པར་འདོད་ལ་རག་གོ།",
    "ཡང་ན་ཁྱོད་ཀྱི་སྐྱེ་བའི་སྐྱེ་བ་དེ་སྐྱེ་བཞིན་པ་རང་ཉིད་མ་སྐྱེས་པ་དེས་གལ་ཏེ་རྩ་བའི་སྐྱེ་བ་གཞན་དེ་སྐྱེད་པར་བྱེད་ནུས་ན་ནི་རྩ་བའི་སྐྱེ་བ་དེ་སྐྱེད་པར་བྱེད་ལ་རག་ན་མི་ནུས་ཏེ།",
    "ཇི་ལྟར་མར་མེས་རང་གི་བདག་ཉིད་ཀྱང་སྣང་བར་བྱེད་ལ་བུམ་པ་དང་།",
    "སྣམ་བུ་ལ་སོགས་པ་དངོས་པོ་གཞན་དག་ཀྱང་སྣང་བར་བྱེད་པ་དེ་བཞིན་དུ་སྐྱེ་བས་ཀྱང་རང་གི་བདག་ཉིད་ཀྱང་སྐྱེད་པར་བྱེད་ལ་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པ་དངོས་པོ་གཞན་དག་ཀྱང་སྐྱེད་པར་བྱེད་དོ།",
    "མུན་པས་ཀྱང་རང་དང་གཞན་གྱི་དངོས་པོ་དག་སྒྲིབ་པར་ཐལ་བར་འགྱུར་བ་འདི་ལ་ཐེ་ཚོམ་མེད་པ་ཞིག་ན་མུན་པས་ནི་རང་དང་གཞན་གྱི་དངོས་པོ་དག་སྒྲིབ་པར་མི་བྱེད་དོ།",
    "གལ་ཏེ་སྐྱེ་བས་རང་གི་བདག་ཉིད་སྐྱེད་པར་བྱེད་ན་སྐྱེས་པས་སམ།",
    "མ་སྐྱེས་པ་ཞིག་གིས་སྐྱེད་པར་སྐྱེད་གྲང་ན།",
