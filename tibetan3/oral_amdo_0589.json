    "དེ་དག་གི་ནང་དུ་འཁོད་པའི་རྩ་ཚིག་ལོ་ཆེན་གྱི་འགྱུར་དང་ཁྱད་པར་ཉུང་ཤས་ལས་མི་འདུག་པས།",
    "ལར་ནས་འཕགས་ཡུལ་དུ་ལེགས་སྦྱར་སོགས་རྒྱ་སྐད་ཀྱི་གནའ་བོའི་དཔེ་ཕལ་མོ་ཆེ་ཤིང་ཤུན་དང་།",
    "འཇམ་དཔལ་མཚན་བརྗོད་རྒྱ་ནག་གི་སྐད་དུ་ཐོག་མ་སློབ་དཔོན་དཱན་པཱལ་ནས་ཕྱི་ལོ་༩༨༡ ཙམ་གྱི་ནང་བསྒྱུར་བ་དང་།",
    "དེ་དག་གི་ཁྲོད་ཏཱ་ལའི་ལོ་མའི་ཐོག་བྲིས་མ་རྙིང་ཤོས་ཕྱི་ལོ་བརྒྱ་ཕྲག་བཅུ་པའི་སྐབས་ཙམ་གྱི་ཡིན་པའང་ཡོད་བཟོ་འདུག།",
    "བོད་ཀྱི་འགྲེལ་མཛད་ཕལ་མོ་ཆེས་དྲི་མེད་འོད་དང་བདུད་རྩིའི་ཐིགས་པ་སྒྲོལ་མ་གསལ་བ་གཉིས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་ལེའུ་བཅུ་བཞིའམ།",
    "མ་བགྲངས་ན་བཅུ་གསུམ་མོ།",
    "རིན་ཆེན་གཙུག་ཏོར་ཆེར་གཟིགས་ནས།",
    "ཞེས་པའི་བར་གསུམ་པ་རིགས་དྲུག་ལ་གཟིགས་པའི་ལེའུ་ཐོཀ་གཉིས།",
    "ཚིག་གི་བདག་པོས་ཚིགས་སུ་བཅད་ཅེས་པ་ནས།",
    "མཆོག་སྦྱིན་རྡོ་རྗེ་མཆོག་ཁྱོད་འདུད།",
    "ཡེ་ཤེས་སྐུ་ཉིད་ཁྱོད་ལ་འདུད།",
    "ཅེས་པའི་བར་བཅུ་གསུམ་པ་རྗེས་སུ་ཡི་རང་གི་ལེའི་ཐོཀ་ལྔ་ཡོད་ཅིང་།",
    "རྒྱ་བོད་ཀྱི་འགྲེལ་པ་ཕལ་མོ་ཆེའི་ནང་གི་རྩ་ཚིག་ཀྱང་ལོ་ཆེན་གྱི་འགྱུར་དང་མཐུན་ཚབ་ཤིན་ཏུ་ཆེ་བས་དཔེ་དེབ་འདིའི་ནང་འགྱུར་གཉིས་ཀ་ཞུ་སྒྲིག་གིས་པར་སྐྲུན་ཞུས་ཡོད།",
    "ལོ་ཆེན་གྱི་འགྱུར་བོད་ཀྱི་པར་མ་དཔེ་ཐུང་ཞིག་ཕྱི་ལོ་༡༩༥༩ ལོར་བཙན་བྱོལ་དུ་འབྱོར་ནས་རིང་པོ་མ་སོང་བར་ཁོ་བོར་ལག་སོན་བྱུང་བ་དེ་ལ་གཞི་བྱས།",
    "མ་དཔེ་གང་རུང་གི་ཡིག་ནོར་མ་དག་པ་ཡིན་པ་གསལ་རྟོགས་ཐུབ་རིགས་རྟགས་འདི་ལྟ་བུའི་ནང་མ་དག་ཅེས་ཁ་ཚོན་བཅད་དེ་མཆན་འགོད་བྱས་ཡོད་ཀྱང་།",
    "མ་དག་པར་ངེས་ཀྱང་སྣང་མེད་དུ་མ་བཞག་པ་ནི་འདི་དག་ཀྱང་དཔྱད་གཞིར་འོས་པར་རེ་བ་ཡིན།",
    "རྒྱ་དཔེར་གཏུགས་ཏེ་ཞུ་དག་མ་བྱས་ན་གཞུང་དོན་གོ་ནོར་ཆེན་པོ་ཡོང་སྲིད་པའང་ཇི་སྙེད་ཅིག་འདུག་པ་རེ་ཟུང་དཔེར་མཚོན་ན་བཀའ་དང་དགའ་ཡང་།་",
    "ས་ཡི་དཀྱིལ་འཁོར་གཞི་ཡི་ཁྱོན།",
    "ཞེས་པར་བཞི་ཡི་ཁྱོན་ཅེས་བྲིས་པ་ལྟ་བུ་མཚོན་པ་ཙམ་སྟེ་དེ་རིགས་དོན་ལ་འཁྲུལ་གཞི་ཅན་གྱི་མིང་ཚིག་རྣམས་གཞུང་འདིར་ཀློག་པ་ཐོས་བསམ་གནང་མཁན་རྣམས་ཀྱིས་ཐུགས་སྣང་གནང་གལ་ཆེ།",
    "བོད་ཀྱི་སྙིགས་དུས་ཀྱི་མཧཱཔཎྜིཏ་གུང་ཐང་འཇམ་དཔལ་དབྱངས་ཀྱིས་མཛད་པའི་འཇམ་དཔལ་མཚན་བརྗོད་ཀྱི་འདོན་ཐབས་ཁག་གཉིས་བཅས་རྩ་གཞུང་གི་སྔོན་དུ་བཀོད་ཡོད་པ་དང་།",
    "མཁས་གྲུབ་ནོར་བཟང་རྒྱ་མཚོའི་གསུང་༧གོང་ས་ཐམས་ཅད་མཁྱེན་པའི་ཞབས་བརྟན་ཤྰཀ་གཉིས་བཅས་རྟགས་རྟེན་ལ་བསམས་ཏེ་རྩ་གཞུང་གི་མཇུག་ཏུ་བཀོད་ཡོད།",
    "ཞུ་སྒྲིག་གི་བྱ་བར་མཐུན་འགྱུར་གནང་མཁན་དྷ་ས་བོད་ཀྱི་དཔེ་མཛོད་ཕྱག་དཔེ་གསུང་རྟེན་ཁང་གི་འགན་འཛིན་སྐུ་ཞབས་བློ་བཟང་ཤཱསྟྲཱི་མཆོག་དང་།",
    "དུས་ཡུན་ཧ་ཅང་ཐུང་ངུའི་ནང་དཔེ་དེབ་པར་སྐྲུན་བྱེད་རྒྱུ་དཀའ་བའི་བྱ་བ་ཞིག་ཡིན་མོད།",
    "ཁོང་གིས་གཞུང་འདིའི་འགྱུར་བྱང་དུ།",
    "འདིའི་མཚན་ལ་ཞིབ་མོ་རྣམ་པར་འཐག་པ་ཞེས་ཀྱང་མཇུག་བྱང་དུ་གསལ།",
    "དུས་འཁོར་སྦྱོར་དྲུག་གི་རྒྱུད་འཛིན་མཁས་གྲུབ་གྲས་ཡིན་ཞིང་།",
    "རྒྱ་གཞུང་ཡིན་མིན་ལ་ཐེ་ཚོམ་གྱི་གཞི་མ་མཆིས་སོ་སྙམ་མོ།",
    "ཁོང་གི་གསུང་དུ་འཇོག་པར་སྐྱོན་ཨེ་ཡོད་སྙམ་པ་མ་ཟད།",
    "དཔལ་སྒེག་པའི་རྡོ་རྗེས་མཛད་པའི་སྔགས་དོན་རྣམ་གཟིགས་དང་།",
    "དེ་དག་གི་ནང་ནས་སྔགས་དོན་རྣམ་གཟིགས་དང་།",
    "ཕྱག་དཔེ་དེ་བོད་ཀྱི་དཔེ་རྙིང་ཁག་གི་ཁྲོད་ནས་ནམ་ཞིག་རྙེད་རེ་ཡོད་དམ་སྙམ།",
    "སློབ་དཔོན་བིབྷཱུཏིཙནྡའམ་རྣམ་བྱུང་ཟླ་བ་ནི་ཕྱི་ལོ་བརྒྱ་ཕྲག་བཅུ་གསུམ་པའི་ནང་བལ་ཡུལ་གྱི་ཇགདྡལ་གཙུག་ལག་ཁང་གི་པཎྜིཏ་གྲགས་ཆེན་ཞིག་ཡིན་ཁར་ཁ་ཆེ་པཎ་ཆེན་ཤཱཀྱཤི་བོད་དུ་ཕེབས་སྐབས་ལྷན་དུ་ཡོད་པའི་པཎ་ཆུང་དགུའི་གྲས་ཡིན་པ་དང་།",
    "དགོས་འདོད་ཀུན་འབྱུང་ནོར་བུ་བསམ་འཕེལ་ཁྱོད།",
    "བླ་བྲང་སོགས་ཀྱི་སྤྲོས་པའང་མེད་པས་རེ་ཞིག་དེ་མུར་ལུས།",
    "སྣར་ཐང་མཁན་ཆེན་ཤེར་རྒྱལ་བ་སོགས་ཀྱིས་ཕྲག་དོག་གིས་སྙན་ཕྲ་མང་པོ་ཞུས་རྐྱེན།",
    "སྐབས་དེར་པཎ་ཆེན་མཆོག་ལྷས་ཁྱོད་ནི་འབྲོམ་སྟོན་པ་དངོས་ཡིན།",
    "དེ་རྗེས་ར་སྒྲེང་སོགས་བཀའ་གདམས་པའི་གདན་ས་མང་པོར་གནས་གཟིགས་དང་།",
    "དེ་རྗེས་རྩ་རིར་གནས་གཟིགས་གནང་ཞིང་།",
    "དེ་སྐབས་བཀྲས་ལྷུན་གྱི་གདན་ས་མི་དགོས་པའི་དགོངས་ཞུ་མཛད་ཀྱང་པཎ་ཆེན་ཡེ་ཤེས་རྩེ་མོས་དམ་ཚིག་ལ་བཀར་ཏེ་བཀའ་ནན་ལྕི་བས་བཀྲས་ལྷུན་གྱི་གདན་ས་ཡང་མཛད་དགོས་བྱུང་།",
    "དགུང་གྲངས་རེ་བདུན་༡༥༤༢དུ་ཕེབས་པའི་སྐབས་གཟུགས་སྐུའི་བཀོད་པ་བསྡུས་པར་མཛད་དོ།",
    "མཛད་པ་ཀུན་ལས་གསུང་གི་ནི།",
    "ཀློག་པ་ལས་གཞན་དགོས་པ་མ་གཟིགས་ཏེ།",
    "དེ་བཞི་ག་བོད་པར་ནས་བཤུས་པ་གཅིག་གྱུར་ལས་དག་མ་དག་གི་ཁྱད་པར་ཕལ་ཆེར་མི་འདུག།",
    "ཚིག་འབྲུ་རེ་ཟུང་དྲི་རྟགས་དང་བཅས་ཏེ་བཀོད་འདུག་པ་ཞུ་སྒྲིག་སྐབས་ཕན་ཐོགས་ཆེན་པོ་བྱུང་།",
    "མིང་ཚིག་རེ་ཟུང་ཡིག་ནོར་ཡིན་པ་གསལ་རྟོགས་བྱུང་བ་རྣམས་དཀྱུས་སུ་དག་བཅོས་ཀྱིས་བཀོད་དེ་མ་དག་པ་རྣམས་ནག་བསུབ་མ་བྱས་པར་གཤམ་མཆན་དུ་བཀོད་ཡོད།",
    "ཡང་ན་ཁོང་གི་ལུང་ཁུངས་གཟིགས་དཔེ་དེ་དག་ད་ལྟའི་བཀའ་བསྟན་པར་མ་ཁག་ཏུ་བཞུགས་པ་རྣམས་མ་ཡིན་པར་ལོ་པཎ་གཞན་གྱིས་བསྒྱུར་བའི་སྔ་འགྱུར་གྲས་ཤིག་ཡིན་ཆ་མ་འཚལ།",
    "འདིའི་རྩ་འགྲེལ་གཉིས་ཀའི་ཞུ་སྒྲིག་སྐབས་བར་སྐབས་ཀྱི་སྲོལ་རྒྱུན་དང་མི་མཐུན་པ་རེ་ཟུང་ཡོད་པ་དཔེར་ན།",
    "རྗོད་བྱེད་ཀྱི་ཚིག་གི་ཡིག་གཞིའི་ཉམས་ཞིབ་དང་འབྲེལ་བའི་བརྗོད་པར་འདོད་པ་མི་ཉུང་བ་ཞིག་མཆིས་མོད།",
    "དེ་བཞིན་རྩ་ཆེའི་ཕུགས་ནོར་ཕྱག་དཔེ་འདི་དག་གི་དཔེ་རྒྱུན་ཡུན་གནས་པའི་ཕྱིར་དང་།",
    "ཕྱག་དཔེ་ཞུ་སྒྲིག་གི་སྐོར།",
    "ཆེས་མྱུར་བའི་དུས་ཐུང་ནང་གྲུབ་དགོས་སྟབས་མ་ཕྱི་གློག་ཀླད་ནང་གསར་འཇུག་དང་ཞུ་སྒྲིག་གི་ལས་རིམ་ཆ་ཚང་འགྲོ་ཐུབ་རེ་བྲལ་བ་མ་ཟད།",
    "ཀློག་པ་པོ་རྣམས་འཇུག་པ་བདེ་བའི་ཆེད་དེབ་གཟུགས་གཅིག་གི་ངོར་བསྐྲུན་ཆོག་པའི་སློབ་དཔོན་མཆོག་ལ་བཀའ་འཁྲོལ་ཡང་ཞུས།",
    "མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་བསྟོད་སྨོན་ཕྱོགས་བསྒྲིགས་༡༩༩༦རིན་སྒྲོན།",
    "ཧ་༨༢༩༡༣༨ སྔགས་དོན་རྣམ་གཟིགས།",
    "སློབ་དཔོན་འཇིགས་མེད་འབྱུང་གནས་སྦས་པས་མཛད་པའི་དཔལ་ཡང་དག་པར་སྦྱོར་བའི་རྒྱུད་ཀྱི་རྒྱལ་པོའི་འགྲེལ་པ་མན་ངག་གི་སྙེ་མ།",
    "རེ་༨༢༣༨༩༦ ཡོན་ཏན་གྱིས་འགེངས་པ།",
    "སློབ་དཔོན་ཉི་མ་དཔལ་ཡེ་ཤེས་ཀྱིས་མཛད་པའི་རྣལ་འབྱོར་ཡན་ལག་དྲུག་གི་བརྗེད་བྱང་ཡོན་ཏན་གྱིས་འགེངས་པ།",
    "གང་གིས་ཞུས་པ་སྡུད་པ་པོའི་ཁྱད་པར།",
    "དགོས་པ་གང་གི་ཆེད་དུ་ཞུས་པའི་ཁྱད་པར།",
    "དང་པོ་གང་གིས་ཞུས་པ་སྡུད་པ་པོའི་ཁྱད་པར་ལ་གཉིས།",
    "ཡན་ལག་གི་དོན་ནོ།",
