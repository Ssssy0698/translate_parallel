    "གང་གི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་འགྱུར་བ་དང་།",
    "གང་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་འགྱུར་བ་དང་།",
    "དེ་དག་གི་འཚོ་བ་ལེགས་པར་འཚོ་བ་ཡིན་ན།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ནས།",
    "མེ་ཏོག་མན་དཱ་ར་བ་དེ་དག་གིས།",
    "ལྷ་མ་ཡིན་དུ་བཅས་པའི་འཇིག་རྟེན་གྱི་དོན་དུ་མོས།",
    "བདེ་བར་མོས་ཤིང་།",
    "ལེགས་པར་བགྱི་བར་མོས་ཏེ།",
    "ཀེའུ་ཤི་ཀ་གླིང་ཆེན་པོ་བཞི་པའི་འཇིག་རྟེན་གྱི་ཁམས་ནི་སྐྲའི་རྩེ་མོའི་ཚད་ཀྱིས།",
    "ཀེ་ཤི་ཀ་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་དང་།",
    "སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ནི་སྐྲའི་རྩེ་མོའི་ཚད་ཀྱིས།",
    "སྐྲའི་རྩེ་མོ་བརྒྱར་གཤེགས་པའི་ཆ་གཅིག་གིས།",
    "བཅོམ་ལྡན་འདས་གང་གིས་སེམས་བསྐྱེད་པ་འདི་བསྒྲུབས་སྟེ།",
    "ནམ་ཡང་རེག་ཡིད་དུ་མི་འོང་བ་རེག་པར་མི་འགྱུར་རོ།",
    "ཕྱིར་མི་ལྡོག་པ་དང་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ།",
    "ཀོ་ཤི་ཀ་རྣམ་གྲངས་དེས་ཀྱང་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་དེས་ཅི་ནས་ཀྱང་སེམས་མེད་པ་དང་།",
    "སྒྱུ་མ་ལྟ་བུའི་སེམས་དེ་ཁྱོད་ཀྱིས་ཡང་དག་པར་རྗེས་སུ་མཐོང་ངམ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་སྒྱུ་མ་ཡང་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་སྒྱུ་མ་ལྟ་བུའི་སེམས་དེ་ཡང་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་ངོ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་གང་ཉོན་མོངས་པར་འགྱུར་བ་འམ།",
    "གང་གིས་མངོན་དུ་བགྱི་བའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་དེ་ཡང་མི་དམིགས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡང་གང་ཞིག་གིས་མངོན་དུ་བགྱི།",
    "དེ་ནི་འདི་ལྟར་གང་གིས་འདི་ལ་སྡུག་པ་འམ།",
    "དེ་ནི་དོན་གང་གི་སླད་དུ་སྤྲུལ་པའི་དོན་དེ་སྦྱོར་ཏེ།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡང་དོན་གང་གི་སླད་དུ་བརྗོད་པའི་དོན་དེ་ཡང་བགྱིད་དེ།",
    "གླང་གི་གཟུགས་ཀྱི་འཁྲུལ་འཁོར་ཞིག་སྦྱར་ན།",
    "དེ་དོན་གང་གི་སླད་དུ་བགྱིས་པའི་དོན་དེ་བསྒྲུབ་ཀྱང་།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡང་དོན་གང་གི་སླད་དུ་བརྗོད་པའི་དོན་དེ་བགྱིད་ཀྱང་།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་དང་།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་དང་།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་གང་ཁྱོད་ཀྱིས་འདི་སྐད་དུ་རྒྱུན་དུ་ཞུགས་པར་བརྗོད་པ་ཅི་ལས་གྱུར།",
    "གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཇི་སྐད་དུ་བསྟན་པ་འདི་ལ་སྤྱོད་པ་དང་།",
    "གང་གིས་ཞུམ་པར་འགྱུར་བ་དང་།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་གང་ཞུམ་པར་འགྱུར་བ་འམ་གང་གིས་ཞུམ་པར་འགྱུར་བ་འམ།",
    "རབ་འབྱོར་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་དག་ན།",
    "དེ་བས་ན་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་འདི་ལྟ་སྟེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་རྣམ་པར་སྤྱོད་པ་དེས་རྣམ་པར་སྤྱད་པ་དང་།",
    "གང་གིས་ཐོས་ཤིང་མོས་ནས་དེ་བཞིན་ཉིད་དུ་གནས་པ་དང་།",
    "རབ་འབྱོར་གང་ཁྱོད་འདི་སྐད་དུ་གང་དེ་བཞིན་ཉིད་ལ་གནས་པ་དང་།",
    "བདག་གིས་དེ་སྐད་དུ་གསོལ་ཏེ།",
    "ཀོ་ཤི་ཀ་གང་ཁྱོད་ཀྱིས་དེ་སྐད་དུ་སྨྲས་ཏེ་དེ་སྐད་དུ་བརྗོད་པས་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་རྗེས་སུ་བརྗོད་པ་དང་།",
    "གང་གི་ལུས་ལ་མཚན་ཡོད་པར་འགྱུར་བ་ལྟ་ཅི་སྨོས།",
    "གང་གི་ལུས་ལ་དཔེ་བྱད་ཡོད་པར་འགྱུར་བ་ལྟ་ཅི་སྨོས།",
    "སྟོང་གི་ཆ་དང་།",
    "བརྒྱ་ཕྲག་སྟོང་གི་ཆ་དང་།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲག་སྟོང་གི་བར་གྱི་ཆར་ཡང་ཉེ་བར་མི་འགྲོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས།",
    "དགེ་སློང་དེ་དག་གིས་ཐལ་མོ་སྦྱར་ཏེ་བཏུད་པའི་ཚེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་དེ་དག་གི་བསམ་པ་ཐུགས་སུ་ཆུད་དེ།",
    "དེ་དག་གིས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་སྣང་བས་རྒྱས་པར་བཀང་ནས་ཕྱིར་འདུས་ཏེ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བས་བཏུད་དེ།",
    "རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ལ་སྤྱོད་པའི་རིགས་ཀྱི་བུ་དང་།",
    "རིགས་ཀྱི་བུ་མོ་དེས་འདི་ལྟར་བདག་ནི་མིའི་ནང་ནས་ཤི་འཕོས་ནས་འདིར་སྐྱེས་པ་འམ།",
    "མིའི་ནང་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་རྒྱ་ཆེར་ཐོས་པ་འམ།",
    "དགའ་ལྡན་གྱི་ལྷའི་རིས་སུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་རྒྱ་ཆེར་ཐོས་པའོ་ཞེས་བྱ་བར་རྟོགས་པར་རིག་པར་བྱའོ།",
    "དགའ་བོ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཉན་པ་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཐོས་པར་གྱུར།",
    "ཉན་ཐོས་རྣམས་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཐོས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་རིག་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིན་པ་དང་།",
    "དགའ་བོ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་བསྟན་པ་ཐོས་ན།",
    "ཕྱིར་མི་ཟློག་ཅིང་ངན་དུ་མི་བརྗོད་ལ་ཐོས་ནས་ཀྱང་མོས་པ་ཐོབ་པར་འགྱུར་ན།",
    "རིགས་ཀྱི་བུ་མོ་དེ་ནི་སྔོན་གྱི་རྒྱལ་བ་ལ་བྱ་བ་བྱས་པ།",
    "དགའ་བོ་དེ་བས་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཁྱོད་ལ་གཏད་དེ།",
    "དགའ་བོ་གལ་ཏེ་ཁྱོད་ཀྱིས།",
    "དེའི་འོག་ཏུ་ཆུད་གསན་ཏེ་བོར་ཡང་དེ་ཙམ་གྱིས་དགའ་བོ་ཁྱོད་ལ་སྐྱོན་དུ་ངས་མི་བརྩིའི།",
    "དགའ་བོ་གལ་ཏེ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་བཟུང་སྟེ།",
    "དགའ་བོ་ཁྱོད་ལ་ངས་སྐྱོན་དུ་གཟུང་ངོ།",
    "དགའ་བོ་དེ་བས་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཁྱོད་ལ་གཏད་ཀྱིས།",
    "རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིན་པ་དང་།",
    "རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིན་པ་དེས་ནི།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་གཟུང་བར་བྱ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་བཟུང་སྟེ།",
    "དགའ་བོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་བསྟན་པ་ལ་རིམ་གྲོ་དང་དགའ་བ་དང་མོས་པ་བསྐྱེད་པ་དེས་ནི།",
    "དགའ་བ་དང་མོས་པ་བསྐྱེད་པར་འགྱུར་རོ།",
    "དགའ་བོ་གལ་ཏེ་ཁྱོད་ལ་ང་སྡུག་ཅིང་ཡིད་དུ་འོང་བས་ཡོངས་སུ་མ་བཏང་ཞེ་ན།",
    "དགའ་བོ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་སྡུག་པ་དང་ཡིད་དུ་འོང་བ་དང་།",
    "ཅི་ནས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ལས་ཚིག་འགའ་ཡང་ཁྱོད་ཀྱིས་ཆུད་མ་ཟོས་པར་གྱིས་ཤིག།",
    "དགའ་བོ་ངས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་གཏད་པར་བརྩམས་ཏེ།",
    "དགའ་བོ་ཁྱོད་ལ་ང་ཇི་ལྟར་སྟོན་པར་གྱུར་པ་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཡང་ཁྱོད་ཀྱི་སྟོན་པ་ཡིན་གྱི།",
    "དགའ་བོ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛིན་པ་དང་།",
    "གཞན་ལ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་རྣམ་གྲངས་དུ་མར་རྒྱ་ཆེར་འཆད་པ་དང་།",
    "དགའ་བོ་དེ་བས་ན་ཁྱོད་ལ་ཕ་རོལ་དུ་ཕྱིན་པ་དྲུག་པོ་འདི་དག་ཡང་དང་ཡང་ཡོངས་སུ་གཏད་དོ།",
    "ད་རུང་ཉན་ཐོས་ཁྱོད་ཀྱིས་ངའི་ཉན་ཐོས་ཀྱི་བྱ་བ་བྱས་པར་མི་འགྱུར་གྱི།",
    "ཉན་ཐོས་ཁྱོད་ཀྱིས་ང་དགྱེས་པར་བྱས་པ་ཡིན་ཏེ།",
    "དགའ་བོ་ཉིན་གཅིག་ལྟ་ཞོག་གི།",
