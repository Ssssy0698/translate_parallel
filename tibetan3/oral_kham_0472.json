    "ལྟག་འོག་ན་འདུག་པའི་དགེ་སློང་གཅིག་ལ་མ་སྨྲས་པ་ལ་ན་སྨད་པ་མེད་དོ།",
    "རྣམ་ཐོས་ཀྱི་བུའི་ནོར་ཀྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེས་སྙེདེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "དེ་ནས་བྲམ་ཟེ་དེས་ཚེ་དང་ལྡན་པ་ལེགས་འོངས་བདེ་བར་འདུག་པར་རིག་ནས་ཁ་ཟས་བསོད་པས་ཚིམ་པར་བྱས་སོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་འདུག་པ་ལ་སྨྲས་ཏེ་འགྲོ་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་འདུག་པ་ལ་སྨྲ་བར་བྱའོ་ཞེས་བཀའ་སྤྲུལ་ནས།",
    "དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན་ཏྲེཞེས་བྱ་བ་ནི་དེ་ན་དགེ་སློང་གང་འདུག་པ་ལའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཅིག་ཀྱེའདུག་པ་དེའི་ཁྱེམ་དུ་ཉེ་དགའ་དུས་དང་དུས་སུ་འགྲོ་ཞིང་དེས་དེ་སྐྱབས་སུ་འགྲོ་བ་དང་བབེེབ་པའི་གཞི་དག་ལ་གཞག་གོ།",
    "འདུག་པར་བྱ་ཞིང་འདི་ལ་འགྱོད་པར་མི་བྱའོ།",
    "ཉེ་དགའ་ཤགས་མེད་ན་༧ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཁྱེམ་པ་འདུག་པ་ལ་བསྒོ་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཁྱིམ་པ་འདུག་པ་ལ་བསྒོ་བར་བྱའོ་ཞེས་བཀའ་སྤྲུལ་ནས།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མི་བསྒོ་ན་ཞེས་བྱ་བ་ནི་དེ་ན་ཁྱིམ་པ་གང་འདུག་པ་ལའོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་བསྒོ་བར་བྱའོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུའི་མདུན་ཛིདུ་འདུག་གོ།",
    "ཁམས་དང་རང་བཞིན་ཁོང་དུ་ཆུད་ནས།",
    "མཐའ་གཅིག་ན་འདུག་ནས།",
    "གསུམ་གྱི་ཚེ་འདུག་པར་ཤེས་ཤིང་ལན་མང་དུ་ལྟ་ཅི་སྨོསཏཱུ།",
    "ལན་མང་དུ་ལྟ་ཅི་སྨོས་ན་ཞེས་བྱ་བ་ནི་ལན་མང་དུ་གྲུའདུག་པར་ཤེས་པ་ལྟ་ཅི་སྨོས་ནའོ།",
    "མལ་སྟན་ཆེན་པོ་ལ་འདུག་པའམ།",
    "ཁྲི་བརྩེགས་༩མའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ།",
    "དེ་ན་དགེ་སློང་ཞིག་འདུག་པ་དེས་སྨྲས་པ།",
    "རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "ཉེས་པ་ནི་དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལམ་པོ་ཆེ་ན་འདུག་པ་བསོད་སྟོམས་ཀྱི་ཕྱིར་གྲོང་དུ་འགྲོ་བ་ལས་བཅའ་བ་དང་།",
    "སོ་སོར་བཤགས་པར་བྱ་བའི་རྣམ་པར་གཞག་པ་ནི་གཙུག་ལག་ཁང་དེ་ན་དགེ་སློང་ཇི་སྙེད་འཁོད་པ་ལ་ཡང་རུང་དྲུཇི་ཙམ་མིག་སྔར་སྣང་བ་དང་ཐོས་པའི་ཉེན་ཀོར་ན་འདུག་པ་དག་ལ་ཡང་རུང་སྟེ།",
    "ཆེ་གང་ཡང་རུང་བ་ལ་གྷུན་འདུག་པ་ལ་ན་སྨད་པ་མེད་དོ།",
    "གྲོང་ངམ་གཞན་གང་ཡང་རུང་བ་ན་འདུག་པ་ལ་ན་སྨད་པ་མེད་དོ།",
    "གཉིས་ཀ་སྙེལམ་པོ་ཆེའམ་གྲོང་ན་འདུག་པ་ཉིད་དང་།",
    "དགེ་སློང་གྲོང་དང་ལམ་པོ་ཆེ་ན་འདུག་པ་མ་ཡིན་པས་དགེ་སློང་མ་གྲོང་ངམ་ལམ་པོ་ཆེ་ན་འདུག་པ་ལས་བཅའ་བ་དང་བཟའ་བ་ལེན་ཅིང་ཟ་བ་ལ་ཉེས་བྱས་སོ།",
    "དགེ་སློང་ནམ་མཁའ་ལ་འདུག་པས་བླངས་ཏེ་ཟ་ན་ཉེས་བྱས་སོ།",
    "གཉི་ག་གཙུག་ལག་ཁང་ན་འདུག་པ་ལ་ཐོང་བ་མེད་དོ།",
    "གཉི་ག་གནས་ན་འདུག་པ་ལ་རྩང་བ་མེད་དོ།",
    "མ་བྱིན་པ་ལ་བྱིན་རྨྱེདུ་འཇུག་པ་མ་གཏོགས་པ་དང་བསྒོ་བའི་ཚིག་ཉེ་བར་གདགས་སུ་མི་རུང་བར་ཐག་རིང་བ་མ་གཏོགས་པ་དེ་ན་འདུག་པ་ཡིན་ནོ།",
    "འདི་ལྟར་བྱ་སྟེ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་དམག་དཔོན་སེང་གེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཤིང་རྟ་དག་ཀྱང་ཤིང་རྟའི་མདའ་རུདང་བྲལ་ཏེ་འདུག་གོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "ཤམ་ཐབས་ཧྥུཅི་ནས་ཀྱང་ཟླུམ་པོར་འདུག་པར་གྱུར་པ་དེ་ལྟར་བགོ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལྟ་བུར་བསྒྲུབ་པའི་ཚུལ་གྱིས་བསྟན་ཏོ།",
    "དེ་ལ་ཤམ་ཐབས་ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་མཐའི་དང་ཁ་མཉམ་པར་འདུག་པ་དེསབྱེ།",
    "ཤམ་ཐབས་ཇི་ནས་ཀྱང་ཟླུམ་པོར་འདུག་བྱེཔར་འགྱུར་བ་དེ་ལྟར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "དེ་ལ་འབྲུའི་ཕུར་མ་ལྟར་ཞེས་བྱ་བ་ནི་གློ་ནས་ཕྱི་རོལ་གྱི་རིམ་པའི་གྲྭ་ཕུར་མ་ལྟ་བུར་འདུག་པ་སྟེ།",
    "ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་མ་མཐའི་ཁ་མཉམ་པར་འདུག་པ་སྟེ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "བྲམ་ཟེ་དེ་ཕྱིར་ཕྱུང་བ་དང་ཉེ་དགའ་རྐང་པ་དང་བཅས་པར་མལ་ཀྱི་སྟེང་དུ་འཛེགས་ཏེ་འདུག་པ་མཐོང་ངོ།",
    "འཇིག་རྟེན་ཀྱི་གཙང་སྦྲ་ནི་ཐ་དད་པ་ཡིན་ན་ཅིའི་ཕྱིར་ནུརྐང་པ་དང་བཅས་པར་འཛེགས་ཏེ་འདུག།",
    "བྲམ་ཟེ་དེ་གནས་སུ་སྨོད་པར་བྱེད་དོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བབེེབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་མ་བསྒོ་བར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "རྒྱ་སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "སྟན་ལ་མ་བརྟགས་པར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལྟར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བབེེབ་པར་བྱ་བའོ།",
    "རྔུ་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེས་བསམས་པ་གལ་ཏེ་ཁྲིའུ་མི་སྟེར་ན་ཁྲིའུ་འདི་ཡང་བཅག་པར་བྱའོ་སྙམ་ནས་དེས་ཆོཞོའི་ཁམ་ཕོར་དང་ཕྱེའི་ཁམ་ཕོར་དེ་གཉིས་འགྲེང་སྟེ་བླངས་ནས་ཁྲིའུ་དེ་ཉིད་ལ་ལུས་ཐམས་ཅད་ཀྱི་ཚོབྱེ་ལྗིད་ཀྱིས་ཕབ་སྟེ་འདུག་པར་བརྩམས།",
    "དེ་དག་གནས་སུ་སྨོད་དོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ཕབ་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "ཁྱེལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ཕབ་སྟེ་ཐྲིག་ཅེས་རྨྱེའདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོཞུ།",
    "ཕྱེལྗིད་ཀྱིས་འབེབས་པ་དང་འདུག་པ་ཉིད་དོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་བསྣོལ་ཏེ་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་བསྣོལ་བ་ཞེས་བྱ་བ་ནི་རྐང་པའི་སྟེང་དུ་རྐང་པ་གཞག་སྟེ་འདུག་པར་མི་བྱའོགེ།",
    "དེ་ལྟར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་བསྣོལ་བ་དང་འདུག་པ་ཉིད་དོ།",
    "གྱེབརླ་མི་བསྣོལ་བར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་བརླ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་བརླ་བསྣོལ་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་བརླ་མི་བསྣོལ་བ་ཞེས་བྱ་བ་ནི་བརླའི་སྟེང་དུ་བརླ་བཞག་ཧུ་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་བརླ་བསྒོལ་བ་དང་འདུག་པ་ཉིད་དོ།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་གཞག་པར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དུ་ལོང་བུ་མི་གཞག་པར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་གཞག་པ་ཞེས་བྱ་བ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་གཞག་པ་དང་འདུག་པ་ཉིད་དོ།",
    "ཀྱི་རྐང་པ་མི་འགུགས་ཧཱུཾཔར་ཁྱེམ་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་ཨྱོབྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་རྐང་པ་མི་དགུག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་བཀུག་དེ་ཀླུཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་དགུག་པ་ཞེས་བྱ་བ་ནི་རྐང་པ་གཉིས་འགབ་ཀུང་དུ་རྔུབཀུག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ་དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བབེེབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་དགུག་པ་དང་འདུག་པ་ཉིད་དོ།",
    "ཚུརྐང་པ་མི་གདངས་པར་༧་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་རྐང་པ་མི་གདངས་པར་རིཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བབེེབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་གདངས་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་གདངས་པ་ཞེས་བྱ་བ་ནི་བརླ་གཉིས་གཞིབས་ཏེ་བྱིན་པ་དང་རྐང་པ་གཉིས་བར་ཐག་རིང་དུ་སོ་སོར་ཕྲལ་ཏེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བབེེབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་གདངས་པ་དང་འདུག་པ་ཉིད་དོ།",
    "ཉེས་པ་ནི་ཁྱེཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་༡།",
    "མ་བསྒོ་བར་ཁྱེམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བབེེབ་པར་བྱ་བ་མན་ཆད་འདི་ཡན་ཆད་ཐམས་ཅད་ནི་ཁྱེམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བབེེབ་པར་བྱ་བའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "སྟན་ལ་འདུག་སྟེ་རིམ་པ་བཞིན་མཐར་ཆགས་སུ་ཟས་བླང་བར་བྱ་སྟེ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ནས་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ནས་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱེམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་དང་།",
    "ཁྱེམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དེ་དག་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དོ།",
    "ཐག་རིང་པོ་ན་འདུག་པ་ཡང་འདིས་བསྡུས་པར་རིག་པར་བྱའོ།",
    "སྣེདྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་སྤྱོམི་གཏོར་བར་༧བསླབ་པར་དུབྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བབེེབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་རྨྱེཆུས་གཏོར་བར་མི་བྱ་བ་སྟེ།",
    "འདིར་ཡང་དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དོ།",
    "ཁྱེམ་པ་འདུག་པ་ཙལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱེམ་གཞན་དུ་ཐུ་མི་དབོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱེམ་གཞན་དུ་མི་དབོ་བ་ཞེས་བྱ་བ་ནི་ཁྱིམ་པ་དག་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱེམ་པའི་ཁྱིམ་གཞན་དུ་དབོ་བར་མི་བྱ་བ་སྟེ་དེ་ལྟར་ས་གཞི་མ་རུང་བར་ཞུ་གྱུར་པའི་ཉེས་རྩོམ་མི་བྱ་བར་བསླབ་པར་བྱ་བའོ།་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "འདིར་སྟན་དུ་ཞེས་བྱ་བ་ནི་འདུག་པའི་ས་ཕྱོགས་ཀྱང་བཟུང་བར་རིག་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "ཅི་ཙམ་ན་མི་གཙང་བའི་དྲི་བྲོ་ནས་དེ་ལག་པ་ལ་འགྲམ་པ་གཏད་ཏེ་༧སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "ཅི་ཙམ་ན་ལྡུམ་ཐམས་ཅད་མི་གཙང་བས་གཏོར་ཞིང་ཝས་ཀྱང་ཟོས་ཏེ་ཟོང་དུ་མ་སྤུརུང་བར་མཐོང་ནས་དེ་ལག་པ་ལ་འགྲམ་པ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "འདི་ཁྱེལྟར་འོང་བའི་སྟངས་ལས་ན་འདིས་བདག་ཟན་གཅོད་པར་བྱེད་དོ་སྙམ་དུ་རིག་ཁྱེནས་དེ་ཤིང་ལྗོན་པ་དེ་ལས་བབས་ཏེ་འདུག་གོ།",
