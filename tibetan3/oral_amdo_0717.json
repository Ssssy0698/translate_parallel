    "གཅིག་གི་དབོ་ལ་གཅིག་གི་མགོ་བསྲིངས་ནས་ཇོ་སྐྱབས་ཀྱི་གདོང་ལ་ཅེར་པ་ན།",
    "དོགས་དང་ཐེ་ཚོམ་ཅི་ཡང་མེད་པར་བྲག་ཁུང་གི་དུད་ཁྱིམ་སོ་སོའི་ཁྱིམ་བདག་མ་རྣམས་ཀྱིས་ཚ་བའི་རྡོ་སྐས་ལས་མར་བབས་རྗེས།",
    "ཕྱིར་བལྟས་མེད་ཁྲོད་ནས་བཟའ་བཏུང་གཡོས་སྦྱོར་བྱེད་མ་ནུས་པ་པར་ཚྭ་ལམ་ཕྱོགས་ལ་གོམ་ཁ་བསྒྱུར་སོང་།",
    "རྩྭ་ཕྲན་ནེམ་ཤ་ཅན་དེས་བྲག་ཕུག་ནང་ནས་བཙོན་ལ་བཀུགས་མོད།",
    "རང་གི་ལས་འགན་རླབས་པོ་ཆེ་དེ་ཡིད་ལ་དྲན་པ་རྣམས་ཉི་འོད་བཙན་པོའི་ཁྲོད་ན་བཙན་རྙིད་ལ་ན།",
    "མཁའ་འགྲོ་མ་དེ་རང་གི་རྗེས་སུ་འབྲང་བའི་སོང་སྟེ།",
    "ཕོ་རོག་ཅིག་འཕུར་ཡོང་ནས་ཨག་འགྱུར་ལན་འགའ་བྱས་རྗེས་བྱང་གི་ཕྱོགས་སུ་འཕུར་སོང་།",
    "ངོ་གདོང་དམར་པོར་གྱུར་ནས་ཚ་ལམ་ལམ་བྱེད་མོད།",
    "པར་སྐབས་རེར་མགྱོགས་པ་མགྱོགས་པར་འགྲོ་།",
    "མཚམས་རེར་རྗེས་སུ་བསྡད་ནས་ཉེ་འཁོར་གྱི་འཕྱི་བ་དང་བྱིའུ་སོགས།",
    "ཁོ་གཉིས་ཀའི་སུ་ཡིན་རུང་གོམ་པ་དུ་མ་སྤོས་ནས་གནམ་ལ་ལན་རེར་ལྟ་བཞིན་ཡོད།",
    "ཉི་མ་ཆར་སྤྲིན་ལེབ་མོ་ཞིག་གིས་བསྒྲིབས་ནས་ཉི་།",
    "འོད་འགོག་པར་རེ་བ་ལས་མ་འདས།",
    "འོན་ཏེ་སྐབས་དེར་སྔགས་འཆང་པདྨ་ཁྲོ་རྒྱལ་གྱིས་རེ་ལྟོས་བྱེད་ས་གཙོ་བོ་ནི་ཆར་སྤྲིན་མིན་ཏེ་གཅེས་ནོར་ཡིན།",
    "ཁོ་གཉིས་ཚྭ་མཚོར་ཇེ་ཉེ་ནས་ཇེ་ཉེར་སོང་བ་དང་བསྟུན་ནས།",
    "དེ་དག་གིས་སྐད་ཅིག་ཉིད་ལ་ཕྱེ་མར་བཏགས་འགྲོ་བ་མ་ཡིན་ནམ།",
    "ད་སྔགས་འཆང་པདྨ་ཁྲོ་རྒྱལ་དང་ཇོ་སྐྱབས་གཉིས་ཀས་རི་ཉག་ཅིག་རྒྱབ་ལ་བསྐྱུར་ཏེ་མདུན་ལ་སོང་བ་ན།",
    "ཁོ་ཕར་ལ་གོམ་པ་འགའ་སོང་རྗེས།",
    "སླར་ཡང་སྔགས་འཆང་པདྨ་ཁྲོ་རྒྱལ་གྱི་གན་ལ་ལོག་དེ་ནས་ཕྱིར་འཁོར་ཏེ་ཕར་ལ་གོམ་པ་ལྔ་སོང་།",
    "གཅིན་པ་མཁའ་ནས་རྒྱང་ལ་སོང་སྟེ།",
    "འདོ་བ་འཕར་བ་རྔ་ནག་གིས་སྐབས་དེར།",
    "སྔགས་འཆང་དེ་ཉིད་མྱུར་སྟབས་ཀྱིས་མགོ་བོ་གཡས་སྐྱོག་གཡོན་སྐྱོག་ལན་འགའ་བྱས་ཏེ་ཡར་ལང་རྩིས་བྱས་མོད།",
    "རྒྱབ་ཀྱི་རྡོག་ཁྲེས་འོམ་དལ་བུར་འགྲོ་མཚམས་བཞག་སོང་།",
    "བེར་བདེན་ཅོག་ཅོག་གིས་དེ་ལྟར་བཤད།",
    "ཇོ་རུས་ཅི་བྱེད་གང་བྱེད་ལ་ལྟད་མོར་བལྟས་ནས་བསྡད།",
    "ཇོ་ལ་སོང་བ་ན།",
    "འདན་ཆུ་དར་དཀར་དགུ་འཁྱོག་གི་རུས་གོམ་པ་འཁྱར་འཁྱོར་སྤོ་བ་དང་།",
    "ཏིག་ནི་ལུང་བ་གཡེར་མོ་ཞིག་གི་མཐིལ་ན་སྔོ་ལམ་མེར།",
    "ཆུ་བོ་འབྲུབ་དུས་སྟོད་རྒྱུད་ཀྱི་ལུང་ཕྲན་སོ་ཇོ་རུ་ཁྲོ་ཐུང་གི་གན་ལ་བྱོན་རྗེས།",
    "ཐོག་མར་སོ་ནས་ཁུར་ཡོང་བའི་ལྗོན་ཤིང་དང་ཤིང་ཕྲན་གོག་འཇིགས་འཇིགས་ཞུམ་ཞུམ་གྱིས་མ་བཞི་དཔོན་པོ་རྣམས་ནི་ཆུ་འགྲམ་ན་སྐྱ་ཡོམ་མེར་འདུག་པ་པོར་གཟིགས་ཙམ་མཛད།",
    "གི་འགྲོས་དང་བསྟུན་ནས་མགོ་ལྕོག་ལྡེམ་པ་ན།",
    "ཟས་མེད་གཡོག་པོས་དཔོན་གྱི་བཀའ་ལ་ཉན་ནས་འཐད་ལན་དབྱུག་ཐོགས་ཁྱོད་གཡོག་པོ་ཡིན།",
    "མྱུར་མོར་ཐབ།",
    "མ་བཞི་དཔོན་པོ་ཁྲོ་ཐུང་གིས་རྟ་ཁ་ཤུགས་ཕྲུག་ཨབ་གཟན་ཁྱོད་ཉིད་ལྟོགས་གྲིར་འཆི་བར་ལ་སྦྱང་ཆརསྒྲུང་གཏམ།",
    "དེ་ང་ཚོ་རྒྱུ་བཞི་དཔོན་པོ་ཁྲོ་ཐུང་གིས་ཚུལ་དེ་མཐོང་བ་ན།",
    "དེ་ནས་བསམ་བློ་ཞིབ་མོ་ཞིག་འདན་གླིང་གཉིས་ཀའི་རྡོ་ལ་ཁྱད་པར་ཅི་།",
    "ཁྱོད་དེ་འདྲ་ཞིག་ཡིན་པས་སྤྲང་པོར་གྱུར་པ་ཤེས།",
    "རྟ་ལ་ཞོ་ཀྱིས་ཅི་བྱེད་ཤེས་མཁན་ཞིག་ཡིན་སྙམ་སྟེ་ཡིད་ཁྲོ་ཐུང་གི་རལ་བ་སྦོམ་པོ་དེ་མདུད་པ་བརྒྱབ་སེམས་བསྒྲིམས་ནས་ལྟད་མོར་བལྟས།",
    "ཁོང་གིས་འཇིགས་ཤིང་འདར་ངེས་ཡིན།",
    "འོ་སྡངས་པའི་ངང་ནས་སླ་ངའི་འོག་ལ་བུད་ཤིང་རྐང་ཇོ་རུས་ཚུལ་དེ་གཟིགས་པ་ན།",
    "མྱུར་བ་མྱུར་བུར་ཕྱིར་བསྐྱེད་དབྱིངས་ནས་བཞད་འདོད་ཅིག་བྱུང་མོད།་",
    "ཨ་ཁུ་ཁྲོ་སེམས་གཟེར་བ་ཞིག་བསྟན་བྱུང་།",
    "འདུག་པ་ལ་སྣང་དོགས་སྤུ་ཙམ་ཡང་མེད་མོད།",
    "འདི་མཐུ་སྟོབས་ཆེ་སོང་ཟེར་ནས་འཇིགས་འོན་ཏེ་ཇོ་རུས་ཨ་ཁུ་ཁྲོ་ཐུང་གིས་ཅི་བྱས་གང་བྱས་པའི་ཉམས་ཀྱིས་ཕར་ལ་བྱོན།",
    "དེ་ནས་རྡོ་ཟུར་ལ་མ་གཟིགས་པར་འདུག་ཁོང་གིས་ཐབ་རྡོ་གསུམ་ཞིག་ལ་གཡས་སྐོར་ཞིག་གནང་སྟེ།",
    "འདི་ནི་དེ་ལས་ཀྱང་འཇིགས་སུ་རུང་བ་ཞིག་རེད་།",
    "ཁྲོ་ཐུང་གིས་ཚབ་ཚུབ་ངང་ནས་བྲོ་ཁུག་འདྲུད་བཞིན་དང་རྩམ་པ་གཏོར་བཞིན་བརྒྱུགས་ཏེ་འདོ་བ་འཕར་བ་རྔ་ནག་གི་གོང་ལ་བུད་རྗེས།",
    "རྐང་བས་ཡོབ་རྡེབ་དང་ལག་པས་རྟ་ཁ་སྤྲུག་བཞིན་བྲོས་སོང་ལ།",
    "ལཁོས་འདན་ཆུ་དར་དཀར་དགུ་འ་ཁྱོག་དེ་འཕྲེད་ལ་གཏུབས་ནས་མཆོངས་པ་ན།",
    "ཆུ་རྡུལ་མཁའ་ལ་འཕྱུར་ནས་མི་རྟ་གཉིས་ཀའང་བསྒྲིབས་སོང་།",
    "རྡོ་གསུམ་གྱིས་ཁྲོ་ཐུང་གི་རྗེས་ལ་ཚ་འདེད་བྱས་བྱུང་།",
    "རྫ་རྡོ་ཁྲ་བོ་དེ་ས་ལ་བབས་ནས་བསྡད་མོད།",
