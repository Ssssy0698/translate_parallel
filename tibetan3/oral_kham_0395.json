    "ལྡང་འདུག་ཀྱང་གཞན་ལ་བརྟེན་ནས་བྱེད་དགོས།",
    "འཕོ་འགྱུར་ལ་སོགས་པ་རིགས་དྲུག་གཞན་གྱི་སྡུག་བསྔལ་རྣམས་ཀྱང་ཅི་རིགས་སུ་ཚང་བའི་ཚུལ་གྱིས་སྡུག་བསྔལ་ཞིང་འདུག་པ་རང་ཅག་རྣམས་ཀྱིས་མྱོང་བས་གྲུབ་པ་འདི་ཡིན་ནོ་། གསུམ་པ་ལྷ་མ་ཡིན་དང་ལྷའི་སྡུག་བསྔལ་བསམ་པ་ནི།",
    "རྩོད་པ་དང་གཡུལ་འགྱེད་པ་ལ་སོགས་པ་ཁོ་ན་ལས་ལུས་སེམས་དལ་བར་འདུག་པའི་སྐབས་སྐད་ཅིག་ཙམ་ཡང་མེད་ཅིང་།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བསམ་ཙ་ན།",
    "དལ་འབྱོར་ཐོབ་པ་དེ་ཙམ་དུ་ཅི་དཀའ་མི་མང་དུ་འདུག་གོ་སྙམ་ན།",
    "མདུན་ན་འདུག་པ་འཆི་བ་སྟེ།",
    "འཆི་བ་འོང་སྙམ་པ་ཡིད་ཡུལ་ན་མི་འདུག་ཀྱང་།",
    "ཁྲི་སྟན་བཟང་པོ་ལ་འདུག་པའི་ཚེ་ད་ལྟ་བདག་ཁྲི་སྟན་བཟང་པོ་འདི་ལྟ་བུ་ལ་འདུག་སྟེ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "གལ་ཏེ་ཚེའི་ལྷག་མ་ཅུང་ཟད་ཡོད་སྲིད་ཀྱང་དེ་མ་རྫོགས་ཀྱི་བར་ལ་འདུག་རྒྱུ་འོང་བའི་ངེས་པ་ཅི་ཡང་མེད་དེ།",
    "ཁོ་བོ་ཅག་འཛམ་བུ་གླིང་པ་རྣམས་ལ་ཚེ་ཚད་ཀྱི་ངེས་པ་ནི་མི་འདུག།",
    "ཚེ་ལྷག་ཅུང་ཟད་ཡོད་སྲིད་ཀྱང་ཚེ་ལ་དུས་མིན་གྱི་འཆི་བ་ནི་འོང་བར་འདུག།",
    "ཚེ་ལ་བར་དུ་གཅོད་པའི་རྐྱེན་ནི་ཤིན་ཏུ་མང་བར་འདུག།",
    "བར་དུ་གཅོད་བྱའི་ལུས་སྲོག་ནི་འབྲལ་སླ་བར་འདུག།",
    "བར་དུ་གཅོད་བྱེད་ཀྱི་འཆི་བདག་ལ་བརྩེ་བ་ནི་མེད་པར་འདུག།",
    "བར་ཆད་ཀྱི་རྐྱེན་དེ་དག་མེད་པའི་སར་འབྲོས་ས་ནི་མི་འདུག།",
    "དེ་ལྟ་བུའི་རྐྱེན་དང་མི་ཕྲད་པའི་གདེང་ནི་མི་འདུག།",
    "དེས་ན་བདག་དེ་རིང་འཆིའམ་སང་འཆི་ཆ་མི་འདུག།",
    "འཆི་བའི་དུས་ལ་བབ་པའི་ཚེ་བདག་ལ་ཅི་འདྲ་ཞིག་འོང་བ་འདུག་གེ་ཨ་ཙ་མ།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "ཀྱེ་མ་བདག་ལ་འཆི་བ་ནི་འོང་བར་འདུག།",
    "ཅི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག།",
    "གཙོ་བོའི་ཞིང་ཕ་མ་དང་རིགས་ཀྱི་རྒན་པ་དང་རང་ལ་དྲིན་ཆེ་བ་རྣམས་ལ་སྟོབས་ཆེ་ལ།",
    "སྟན་ལ་འདུག་པའི་ཚེ་རྡོ་རྗེའི་གདན་ཐོབ་པར་གྱུར་ཅིག།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "མཛའ་བཤེས་དང་འཁོར་གཡོག་ལ་སོགས་པ་གང་ཡང་རྗེས་སུ་མི་འབྲང་བར་འདུག་ཅིང་།",
    "འདུག་བདག་པོའི་འབྲས་བུ་ནི་ས་ཕྱོགས་ཡིད་དུ་མི་འོང་ཞིང་སྐྱོན་དང་བཅས་པ་དེ་ལྟ་བུར་སྐྱེ་དགོས་པར་འདུག།",
    "ཕྱི་མ་མཐོ་རིས་ཀྱི་ལུས་རྟེན་ཙམ་ཡང་ཐོབ་པའི་ངེས་པ་ཆག་མི་འདུག་ཅིང་།",
    "ཚེ་འདིར་ཡང་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཁྲེལ་བའི་གནས་སུ་འགྲོ་བ་འདུག་སྙམ་དུ་བསམ་ཞིང་བློ་ལ་སྐྱེད་ཅི་ཐོན་བྱ།",
    "ཕན་ལན་དུ་ཕན་མ་བཏགས་ན་བདག་ལས་ཁྲེལ་བོར་བ་སུ་ཡང་མི་འོང་བ་འདུག་པས་མ་འདི་ལ་དྲིན་ལན་དུ་དྲིན་དང་ཕན་ལན་དུ་ཕན་འཇལ་ཅི་ཐུབ་ཅིག་བྱ།",
    "བདེ་བ་དང་བདེ་བའི་རྒྱུ་དང་ལྡན་ན་ཕན་པ་འདུག་པ་ལ།",
    "ད་ལྟ་ནི་དེ་དང་བྲལ་ནས་འདུག།",
    "འདི་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་དང་བྲལ་བ་ལ་འགོད་དགོས་པ་འདུག་ནའང་།",
    "འདུག་པ་ནི་ཏིང་ངེ་འཛིན་གྱི་གནས།",
    "ས་མཐོ་བར་འདུག།",
    "དབེན་པའི་གནས་སུ་བདེ་བའི་སྟན་ལ་རྗེ་བཙུན་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱོད་ལམ་ལྟ་བུས་འདུག་སྟེ་སྐྱབས་གསོལ་སེམས་བསྐྱེད་གསུམ་སྔོན་དུ་འགྲོ་བས།",
    "གལ་ཏེ་འདུག་ན་གང་འདུག་པ་དེ་ཉིད་ལ་གཉེན་པོ་བཏང་སྟེ།",
    "གཙང་པོ་རྣམས་སུ་ཆུ་འཐུང་དུ་ཕྱིན་པས་ཆུ་མིག་འདུག་ནས།",
    "ཆུ་རྣམས་སོ་སོའི་གནས་ན་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པས།",
    "བློ་འདས་གཞི་མེད་རྩ་བྲལ་ནམ་མཁའ་ལྟ་བུར་འདུག་པ་ལ་དེ་ལྟར་མ་ཤེས་པར་ང་བདག་དང་གཟུང་འཛིན་གྱི་འཆིང་བ་དམ་པོས་བཅིངས་ཏེ།",
    "ཁྲི་སྟན་ལ་འདུག་པ་དང་།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཁ་ནང་བལྟས་ཀྱི་སེམས་རང་རིག་ཅིང་རང་གསལ་ཙམ་མ་འགགས་པར་མྱོང་བ་དེ་ཉིད་ལ་གསལ་བ་སེམས་ཀྱི་མཚན་ཉིད་ཅེས་བྱ་ལ།",
    "དེ་བཞིན་དུ་སེམས་ཉིད་གསལ་སྟོང་ཟུང་འཇུག་མངོན་དུ་བྱེད་པའི་ཐབས་བསྐྱེད་རྫོགས་ཡེ་ཤེས་གསུམ་ཀྱང་རང་སེམས་ཀྱི་ཆོ་འཕྲུལ་ལས་མ་འདས་ཏེ།",
    "གསལ་སྟོང་ཟུང་འཇུག་ཡ་མ་བྲལ་བ་ཡིན་ཞེས་བསམ་དེ་བཞིན་དུ་རང་སེམས་གསལ་སྟོང་ཟུང་འཇུག་མངོན་དུ་གྱུར་པའི་འབྲས་བུ་སྐུ་གསུམ་ཀྱང་རང་སེམས་དག་པའི་རྣམ་རོལ་ལས་མ་འདས་ཏེ།",
    "དེ་ལྟར་ན་རྨི་ལམ་གྱི་སྣང་བ་དང་ད་ལྟར་གྱི་སྣང་བ་བདེན་རྫུན་གྱི་ཁྱད་པར་འགའ་ཙམ་ཡང་མི་འདུག་པ་ལ།",
    "རང་རིག་ཅིང་རང་གསལ་ཙམ་དེའི་རང་གདངས་ལ་རྗེན་གྱིས་བལྟ།",
    "དེ་ལྟར་ན་དོན་ལ་སྐྱེ་འགག་ནི་མི་འདུག།",
    "མི་འདུག་པ་བཞིན་དུ་དེ་ལྟ་བུའི་སྣང་བ་ནི་ཤར།",
    "གཅིག་དང་དུ་མ་ལ་སོགས་པ་གང་དུ་ཡང་གྲུབ་པ་ནི་མི་འདུག།",
    "མི་འདུག་བཞིན་དུ་ཕན་ཚུན་ལྟོས་གྲུབ་ཀྱི་སྣང་བ་འདི་ལྟ་བུ་ནི་ཤར།",
    "མི་འདུག་བཞིན་དུ་ལྟོས་གྲུབ་ཀྱི་སྣང་བ་འདི་ལྟ་བུ་ནི་ཤར།",
    "མི་འདུག་བཞིན་དུ་འདི་ལྟ་བུའི་སྣང་བ་ནི་ཤར་ཞེས་སོགས་སྔར་ལྟར་བསམས་ལ་ངེས་ཤེས་བསྐྱེད་དོ།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "འཚོལ་མཁན་གྱི་སེམས་རང་རིག་ཅིང་རང་གསལ་ཙམ་ཞིག་ནམ་ཡང་ནས་མ་འགགས་པའི་ཕྱིར་མེད་པ་མ་ཡིན།",
    "མ་གྲོལ་ན་འཚང་མི་རྒྱ་བར་འདུག་པས།",
