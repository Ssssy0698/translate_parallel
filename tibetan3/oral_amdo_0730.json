    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཉེ་བར་སྟོན་པ་དང་།",
    "མྱ་ངན་ལས་འདའ་བ་ལ་རེ་བ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤོང་བ་ལ་བརྩོན་པ།",
    "ལྟ་བས་༨ན་ཁྱོད་ཀྱིས་མངོན་སུམ་དུ་བྱ་ཞིང་ཁྱོད་ཀྱིས་༩སོ་སོར་རིག་པར་བྱའོ།",
    "དེ་ནས་བདག་གིས་༧ཏིང་འཛིན་འདི་བསྒོམས་ཏེ།",
    "ཀུན་ནས་ཉོན་མོངས་པར་མི་བྱེད་པ་དང་།",
    "ཉོན་མོངས་པའི་བདུད་དང་།",
    "འཆི་བདག་གི་བདུད་དང་།",
    "ཐོས་པའི་ཚོགས་དེ་དག་གི་ནང་ན་ཚོགས་གང་ཆེས་མཆོག་དང་ཆེས་གཅོ་བོ་ལགས།",
    "ཐོས་པའི་ཚོགས་དེ་དག་གི་ནང་ན་ཐོས་པའི་ཚོགས་འབའ་ཞིག་མཆོག་ཅེས་བྱ།",
    "དེ་ལྟར་མོས་པའི་རྣམ་པ་དང་།",
    "བདག་གི་སེམས་བསྲུང་བའི་རྣམ་པ་དང་།",
    "བདག་གི་ཕྱོགས་བསྲུང་བའི་རྣམ་པ་དང་།",
    "ཕ་རོལ་གྱི་ཕྱོགས་ད་ང་ཉོན་མོངས་པ་ཚར་གཅོད་པའི་རྣམ་པ་ད་ང་།",
    "ང་ནི་༡ཁྱོད་ཀྱི་ཁྱིམ་འདིར་མི་འདུག་ཅ་སྟེ་། གང་ཕྱིར་ཁྱོད་ནི་རྟག་ཏུ་སྐལ་མི་མཉམ།",
    "དེ་ཕྱིར་ཁྱོད་ནི་རྟག་ཏུ་མགོན་མེད་པར་༡།",
    "ཕྱི་མའི་ཚེ་ལ་ཁྱོད་ནི་བདེ་བར་འགྱུར།",
    "ཚིག་གིས་སྨོད་པར་འགྱུར་ར་རོ།",
    "གང་བརྗེད་ངས་པ་དེ་ལ་དགེ་སྤྱོང་གི་ཚུལ་མེད་དོ།",
    "གང་དགེ་སྦྱོང་གི་ཚུལ་མེད་པ་དེ་ལ་མྱ་ང་ན་ལས་འདའ་བ་མེད་ད་དོ།",
    "དེ་བཞིན་སྙན་པའི་ཚིག་གིས་ཉེར་བསྡུས་ནས།",
    "ཇི་ལྟར་བདག་བྱ་ཅ་ཏྲ་ནི་བསྟན་བཅོས་ཐམས་ཅད་ཀྱི་དོན་དང་ཚིག་གི་སྒོ་ནས་འཛིན་པ་དང་།",
    "དོན་ད་ང་ཚིག་གི་སྒོ་ནས་རྗོད་པར་བྱེད་པ་ཡིན་ན་ནོ།",
    "བད་ག་གིས་༡དོན་བརྒྱ་སྟོང་ཕྲག་དུ་མ་རྣམས་ལྷན་ཅིག་ཏུ་གནས་པ་རྣམས་དང་།",
    "དེ་དེའི་ཚེ་ན་ནང་༡སྟོང་པ་གསོག་དང་གསོབ་ཏུ་གྱུར་པ་ནི་༢འདི་སྙམ་དུ་གལ་ཏེ་དགེ་སློང་དེ་དག་གིས་༢བདག་ལ་ཇི་ལྟ་བ་བཞིན་སྟོན་ཅིག་ཅེས་༐",
    "དེ་ད་ག་གིས་༢བདག་ཟིལ་གྱིས་གནོན་པར་འགྱུར་ར་རོ།",
    "གང་གི་ཚེ་དགེ་སློང་རབ་ཏུ་བྱུང་བར་གྱུར་པ་དེའི་ཚེ།",
    "ཚངས་པར་སྤྱོད་པ་དང་བཅས་པ་དེ་དག་གིས་༤།",
    "ཅ་རྣམ་པ་གང་གིས་ལམ་ཆུད་ཟོས་པར་འགྱུར་བ་སླར་ཡང་ཡིད་ལ་གཞག་༡པར་བྱ་ཞེས་དེ་སྐད་དུ་མི་འདྲིའོ།",
    "དགེ་སློང་གིས་ནི་དེ་ཉིད་རིག་༩།",
    "ལུས་ཞིག་ནས་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མ་ཐོ་རིས་ལྷ་དག་གི་ནང་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟ་སྟེ་དཔེར་ན་སྐྱེས་བུ་ལ་ལ་ཞིག་གིས་གྲམ་པའི་ས་ཕྱོགས་སུ་ཤིང་ཙམ་པ་ཀ་བསྐྲུན་ལ།",
    "ཆ་བ་ཚོལ་༡བར་མི་བགྱིད་ཀྱིས་གང་ནས་ཆབ་མཆི་བར་མཐོང་བའི་ཕྱོགས་དེ་ཡང་གོར་མ་ད་ང་གྱོ་མོ་དག་གིས་བཀུམ་ན།",
    "ང་རྒྱལ་གྱིས་རེངས་པར་གྱུར་ན།",
    "གང་གི་ཚེ་རྒྱ་མཚོ་ཆེན་པོ་མཆིས་པར་༐",
    "པ་དཀྲུགས་༢པར་བྱེད་པ་དེ་ནི་རང་གི་སྤོབས་པ་ཅན་ཞེས་བརྗོད་དོ།",
    "ཡང་གང་ཞིག་རང་གི་སྤོབས་པས་དཀྲུགས་༤པར་བྱེད་ཅིང་དེ་དེ་བཞིན་གཤེགས་པས་གསུངས་པར་སྨྲ་བ་དེ་ནི་དེ་བཞིན་གཤེགས་པ་ལ་སྐུར་པར་འགྱུར་ར་རོ།",
    "ཇི་སྐད་སྨྲས་པ་དེ་བཞིན་བྱེད་པའོ་། བདག་གིས་བདུད་ཀྱི་༢ལས་རྟོགས་ནས་ཀྱང་སྤང་བར་བྱའོ།",
    "བདག་ནི་ཟབ་མོ་ལ་བཟོད་པ་ཅན་ན་ནོ།",
    "བདག་གིས་མངོན་སུམ་དུ་བྱས་སོ་སྙམ་ན་དེ་བཞིན་གཤེགས་པ་སླུ་བར་བྱེད་ད་དོ།",
    "རང་གིས་ཡོངས་སུ་དག་པར་བྱ་བ་མེད།",
    "དེ་དག་གི་མི་སྙན་པ་སྨྲའོ།",
    "དེ་ལས་དེ་དག་གི་སྐྱོན་ཐོས་ནས་སྐྱེ་བོ་མང་པོ་མ་དད་པར་བྱེད་ད་དོ།",
    "འདི་དག་ནི་ཆུ་ཕོར་གང་གིའང་འོས་ཀྱང་༢མ་ཡིན་ན་ནོ་། དེ་བརྩོན་འགྲུས་རྩོམ་པ་དེས་བད་ག་ལ་བསྟོད་ཅིང་གཞན་ལ་སྨོད་པས་དེ་བྱིས་པ་ཡིན་ནོ་ཞེས་ང་སྨྲའོ།",
    "ང་ནི་འཇིག་རྟེན་ན་མཆོག་ཏུ་འགྱུར་རོ་སྙམ་མ་མོ།",
    "དེ་ངན་དུ་སེམས་པ་དེ་དང་ངན་དུ་བརྗོད་པ་དེས་ངན་སོང་དུ་འགྲོ་བ་ཐོབ་པར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "ཉོན་མོངས་པའི་དྲི་མ་ཐམས་ཅད་དག་པར་བྱེད་པས་ཆུ་ལྟ་བུའོ།",
    "མོས་པ་ཉམས་སུ་མྱོང་བར་བྱེད་པས་བཟའ་ཤིང་༤གི་ར་བ་ལྟ་བུའོ་ཞེས་བྱ་བ་ནས།",
    "དུག་གིས་མི་ཚུགས་སོ།",
    "༢ཉོན་མོངས་པའི་མཚོན་གྱིས་མི་ཆོད་ད་དོ།",
    "དེ་ནི་སྲང་གཅིག་གིས་ཀྱང་ལྕགས་སྲང་སྟོང་གསེར་དུ་འགྱུར་ར་རོ།",
    "ཉོན་མོངས་པའི་ལྕགས་ཐམས་ཅད་ཀྱིས་ཀྱང་ཀུན་ནས་ཉོན་མོངས་པར་༤བྱ་བྱ་བའམ།",
    "གང་གིས་སྟོང་གསུམ་ཐམས་ཅད་ཀྱང་།",
    "གང་གིས་༢ཐལ་མོ་སྦྱར་བྱས་ནས།",
    "རྒྱ་མཚོ་དང་ནི་ཆུ་ཡི་ཟིགས་པ་བཞིན།",
    "ཤ་ར་དྭ་༧ཏིའི་བུ་འདི་ལྟ་སྟེ་དཔེར་ན་སྲིན་བུ་མེ་ཁྱེར་བརྒྱ་སྟོང་གིས་ཀྱང་ཉི་མའི་འོད་ཟིལ་གྱིས་གནོན་པར་མི་ནུས་སོ། ༐",
    "ཤ་ར་དྭ་༢ཏིའི་བུ་འདི་ལྟ་སྟེ་དཔེར་ན་བར་སྣང་ལས་རོ་གཅིག་པའི་ཆུའི་རྒྱུན་འབབ་པ་བབ་ནས་སྣོད་ཀྱི་བྱེ་བྲག་གིས་རོ་བྲོ་བ་ཐ་དད་དུ་འགྱུར་རོ། ༐",
    "ཀུན་དགའ་བོ་ལག་པ་དང་རྐང་པ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ངའི་ཤཱ་རིའི་བུ་དང་མོད་གལ་གྱི་བུ་དག་ཡིན་ལ།",
    "ཀུན་དགའ་བོ་གལ་ཏེ་གནས་བརྟན་ཤཱ་རིའི་བུ་དང་མོད་གལ་གྱི་བུ་གཉིས་བསྐལ་པའམ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཕམ་པར་བྱས་ནས་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཡོངས་སུ་རྫོགས་པར་བྱེད།",
