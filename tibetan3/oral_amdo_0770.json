    "རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
    "དེ་རིང་ཁྱོད་ནི་བསྐུར་བར་འགྱུར།",
    "རྡོ་རྗེ་འདི་ནི་ཁྱོད་ཀྱིས་ལོང་།",
    "སྤྱི་བོར་མིང་གི་སྟེ།",
    "ཀྱེ་ཆེ་གེ་མོ་རྡོ་རྗེ།",
    "རང་གི་དངོས་པོ་གང་གང་སྣང་།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
    "གཟུགས་སོགས་འདོད་པའི་དམ་ཚིག་གིས།",
    "རང་གི་རིག་པའི་ངོ་བོ་དེ།",
    "རང་གི་ལྷ་ཡི་སྦྱོར་བ་ཡི།",
    "དམ་ཚིག་གི་ནི་ཕྱག་རྒྱ་ཆེར།",
    "རོལ་མོ་དྲི་ལ་སོགས་ལྡན་ཞེས།",
    "ནུབ་ཀྱི་སྒོ་ནི་ཡིན་པར་བཤད།",
    "རྩེ་མོར་དྲིལ་བཏགས་སྒྲ་སྒྲོགས་ཡིན།",
    "དེ་ཡི་ནང་གི་འཁོར་ལོ་དེ།",
    "རྡོ་རྗེའི་ཐིག་གིས་བསྐོར་བ་ཡིན།",
    "རང་གི་མཚན་ཉིད་དབེེན་པ་ཉིད།",
    "གླུ་སྙན་གང་དང་རོལ་མོ་རྣམས།་།",
    "རང་གི་རྣམ་རྟོག་གནས་གྱུར་པ།",
    "བུམ་པ་མཆོད་ཡོན་བླ་རེ་སོགས།",
    "རབ་གསང་ཤེས་རབ་མཆོག་གི་ནི།",
    "ཀྱེ་དེ་བཞིན་གཤེགས་པ་རྡོ་རྗེ་ཆེ་གེ་མོ་ཞེས་བྱ་བ་སིརྙི་བྷུར་བྱུ་བ་སྭ།",
    "ཉིན་རེ་བཞིན་དུ་ཐུན་བཞི་རུ།",
    "གྱུར་པས་ཐུན་མོང་ཅིག་ཤོས་ཀྱི།",
    "རིག་པ་འཛིན་པ་སུམ་སྟོང་གིས།",
