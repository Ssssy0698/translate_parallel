    "དེ་མན་ཆད་བསྲེག་གི་ཡན་ཆད་ལ་གནོད་པ་མེད་དོ།",
    "ཆུས་འཇིག་པའི་རྩེ་མོ་གསུམ་པ་སྟེ་དེ་རམན་ཆད་འཁྲུ་བར་བྱེད་དོ།",
    "མཐོ་ཤོས་ལ་རྩེ་མོར་བྱས་ན།",
    "མེའི་རྩེ་མོ་དང་པོ།",
    "ཆུའི་རྩེ་མོ་གཉིས་པ།",
    "དེའི་མཐར་སོན་ཡང་གནོད་པས་མི་བརྫི་བས་བརྟན་པ་སྲ་བ་རབ་རྩེ་མོ་ཞེས་བྱ་ཡིན་པར་འདོད་དོ།",
    "དེ་ལྟར་ཡིན་པ་ལ་དེང་སང་སེམས་སེམས་བྱུང་གི་རྟོག་པ་མ་འགགས་པར་རང་སོ་ན་ཡོད་ཅིང་།",
    "འཇིག་རྟེན་ལས་འདས་པ་གྲུབ་རེ་སྐན་ནོ།",
    "རང་གི་ལས་ཀྱིས་དེ་ནས་འཆི་འཕོ་སྣང་།",
    "དེ་ལ་རྟོག་དཔྱོད་ཀྱི་འཇུག་པ་སེམས་དང་སེམས་བྱུང་རགས་པ་བསམ་གཏན་ལ་རོ་མྱོང་གི་ཆགས་པ།",
    "ལྷ་སྦྱིན་གྱི་དགྲ་མེད་པ་དེ་ལ་དེའི་ལག་གི་མཚོན་གྱིས་མི་གནོད་པ་བཞིན།",
    "མ་གཏན་དེ་དག་འཇིག་པའི་སྔོན་དུ་དེ་ན་ཡོད་པའི་ལྷ་དེ་དག་གིས།",
    "ཞིག་ནས་སྟོངས་ཏེ་ནམ་མཁའ་གཅིག་གི་ངང་།",
    "དེ་ནས་ཡང་ཅིག་ཆགས་པའི་མགོ་རྩོམ་མོ།",
    "སྟོངས་པའི་དུས་ན་ཐམས་ཅད་ནམ་མཁའ་གཅིག་གི་རང་བཞིན་དུ་གནས་པ་ནི་འདུས་བྱས་འདུས་མ་བྱས་ཀྱི་དབྱིངས་སུ་གནས་པ་སྟེ།",
    "མ་འོངས་པ་ཕྱི་མའི་མཐར་ཡང་ཆགས་འཇིག་གི་བསྐལ་པ་དང་།",
    "ངན་སོང་ན་སྡུག་བསྔལ་ཤས་ཆེ་ལ་བདེ་བ་བག་ལ་ཉལ་ཏེ།",
    "མངོན་གྱུར་སྲིད་པ་ཙམ་མོ།",
    "ཁྱད་པར་དུ་འགྲོ་བ་གང་དུ་སྐྱེས་ཀྱང་གཟུགས་དང་ལང་ཚོས་བརྒྱན་པ་དང་།",
    "ཁ་ཟས་མོད་པ་དང་།",
    "ངན་སོང་གི་རིགས་ལ་སྤྱིར་སྣང་བ་ནི།",
    "འདི་ལྟར་འདོད་པའི་ཁམས་ན་རང་རང་གི་ལས་ཐ་དད་པ་ལས།",
    "མི་དང་ངན་སོང་གི་གནས་སྐབས་གང་ཡང་རུང་སྟེ།",
    "དེ་ཀུན་རང་གི་འཁྲུལ་སྣང་ལས་ལས་གྱུར།",
    "གཅིག་གི་རྒྱུད་ལ་འདི་དག་སྤེལ་མར་བྱུང་བའམ།",
    "མེ་ཏོག་ལ་སོགས་པའི་མིག་གི་དགའ་སྟོན་མཐོང་བ་ལ་སོགས་པས་ཡིད་བདེ་བ་ཇི་སྙེད་པ་དང་།",
    "ལྷ་མ་ཡིན་ནི་སྔོན་ཕྲག་དོག་གི་ལས་ཤས་ཆེ་བས་འཕངས་པས།",
    "ཕན་ཚུན་ཡང་གཅིག་གིས་གཅིག་བདེ་བ་མི་བཟོད་པས་ཁྲོ་ཞིང་འཚེ་བས།",
    "མེ་ཏོག་མགོ་རྒྱན་ལྷ་མོ་རྣམས་ཀྱིས་གང་།",
    "བརྒྱ་བྱིན་གྱི་བཙུན་མོ་དམ་པ་བཙུན་མོའི་འཁོར་དུ་མས་བསྐོར་བ་དང་།",
    "ལྷའི་བུ་མོ་མེ་ཏོག་གི་མགོ་རྒྱན་དང་།",
    "ཤིང་དང་བུ་མོ་ལྟ་ལས་གྱུར་པའོ།",
    "རྩ་བས་བདག་ཅག་གི་གནས་སུ་ཅི་བྱ་ཞེས་སྟ་རེས་གཅོད་པར་བྱེད་པ་ན་ཤིང་ཆད་ཀྱིས་དོགས་པ་དང་།",
    "གང་གི་ཚེ་རྩོད་པར་འགྱུར་བའི་རྒྱུ་ཚོགས་པ་དེའི་ཚེ།",
    "ཐོག་མར་ཀླུ་དང་བར་སྣང་གི་ལྷ་རྣམས་འཁྲུག་པ་ལས།",
    "གང་རུང་ཞིག་ཕམ་པ་དེའི་ཚེ་བར་སྣང་གི་ལྷ་དཀར་པོ་དང་།",
    "གང་དུ་སྒྲ་གཅན་རྒྱལ་བ་དེའི་ཚེ་དཀར་ཕྱོགས་ཀྱི་ཀླུ་དང་བར་སྣང་གི་ལྷས་རྒྱལ་ཆེན་རིས་བཞིའི་དཔུང་རྣམས་སྦྲན་པ་ལས།",
    "དཀར་ཕྲེང་གི་གནས་ནས་འགུལ་ཕྲེང་ཅན་ལྷ་མ་ཡིན་གྱི་དཔུང་དང་ལྷན་ཅིག་འཐབ་པ་ལས།",
    "རྩུབ་འགྱུར་ཚལ་སོང་གོ་ཆ་རབ་བགོས་ཏེ་ རབ་བརྟན་བཞོན་པ་ལྷ་ཡི་དཔུང་དང་བཅས།",
    "དེ་ནས་ལྷའི་ཚོགས་དག་རྩུབ་འགྱུར་གྱི་ཚལ་དུ་སོང་སྟེ་རྫིང་བུར་ཞུགས་པ་ཙམ་གྱིས་ཞེ་སྡང་སྐྱེས་ཏེ་འཐབ་པ་ལ་སྤྲོ་བར་གྱུར་པ་དེའི་ཚེ།",
    "མགོ་བོ་རེ་རེར་ཡང་བདུན་བདུན་དུ་སྤྲུལ་པ་རེ་རེའི་སྟེང་ན་ལྷའི་དཔུང་ཡོད་ལ།",
    "མཆེ་བ་རེ་རེ་ན་སྐྱེད་མོས་ཚལ་དང་རྫིང་བུ་བདུན་བདུན།",
    "དེ་ན་ལྷའི་བུ་མོ་ཤིན་ཏུ་མཛེས་པ་གླུ་གར་བྱེད་པ་བདུན་བདུན།",
    "དེ་རེ་རེ་ལ་གཡོག་མོ་བདུན་བདུན།",
    "དེ་རེ་རེ་ལ་སིལ་སྙན་བདུན་བདུན་སྤྲུལ་ནས་རི་རབ་ཀྱི་ཆུ་མཚམས་ལ་ཐུག་པར་བསུ་བ་ལས།",
    "རྡོ་རྗེ་དང་འཁོར་ལོ་འཕེན་པ་དག་གིས་སེམས་རབ་ཏུ་མྱོས་པར་བྱེད་ཅིང་།",
    "དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པ་དང་ལྷན་ཅིག་འོངས་ཏེ།",
    "དེའི་ཚེ་ས་རྣམས་གཡོ་ཞིང་རི་རབ་འཕངས་པ་རྡུལ་དུ་སོང་བས་འཛམ་བུའི་གླིང་ལ་སོགས་པར་རྡུལ་གྱིས་ནམ་མཁའ་འཁྲིགས་པ་དང་།",
    "རྒྱུད་ཁ་ཅིག་ལས་ཁ་རླངས་དང་མཇུག་མའི་རླངས་གང་རུང་གིས་བསྒྲིབས་པར་འདོད་ཅིང་།",
    "ལྷ་རྣམས་ཕམ་པ་དེའི་ཚེ་ཕྱིར་ལོག་སྟེ་བྲོས་པའི་སླད་བཞིན་ལྷ་མ་ཡིན་གྱི་དཔུང་གིས་བདས་ཏེ་རི་རབ་ཀྱི་རྩེར་སོང་བལས།",
    "ལྷ་མ་ཡིན་རྣམས་ཕམ་པ་ན་དེའི་ཚེ་རི་རབ་ཀྱི་ཁོང་གསེང་གི་གསེར་གྱི་ས་གཞི་ལ་ཐུག་པར་བྲོས་པའི་སླད་བཞིན་དུ་ལྷའི་དཔུང་གིས་བདས་ཏེ།",
    "ལྷ་རྣམས་རང་གི་གནས་སུ་ལོག་པ་དང་།",
    "ཁ་ཅིག་བློ་འཁུམས་ཏེ་༧གསོན་དུ་རེ་བ་མེད་དོ།",
    "གསང་བ་ཡིད་བཞིན་མཆོག་གི་རྒྱུད་ལས།",
    "དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "རྒྱུ་ལས་སྣ་ཚོགས་པ་ཀུན་འབྱུང་གི་བདེན་པ་དང་།",
    "དེའི་འབྲས་བུ་བདེ་སྡུག་སྣ་ཚོགས་པ་སྡུག་བསྔལ་གྱི་བདེན་པས་ཉོན་མོངས་པར་བྱེད་པས།",
    "ཡར་སྲིད་པའི་རྩེ་མོ་ལ་མཚོའི་སྟེང་བྱས་པ།",
    "བར་ལྷ་མི་ངན་སོང་ལ་མཚོའི་དབྱིངས་འཁྱིལ་བ།",
    "གསོང་ཞིང་དེས་ལ་གྱ་གྱུ་མེད་པ་སྟེ།",
    "ཡིད་བཞིན་རིན་ཆེན་དད་བརྒྱའི་གཙུག་གིས་བསྟེན།",
    "གཟུང་འཛིན་དང་ཉོན་མོངས་པ་ཆུང་བས་དུལ་ཞིང་བཟོད་པ་དང་ལྡན་པ།",
    "སྒོ་གསུམ་ངང་གིས་དུལ་བས་དྲང་ལ་གྱ་གྱུ་མེད་པ།",
    "གསོང་ཞིང་སྤྱོད་ལམ་གྱ་གྱུ་མེད།",
    "ལྟ་སྤྱོད་ཕུལ་བྱུང་གང་གིས་སྨད་དུ་མེད།",
    "ལུང་གི་དགོངས་པ་ངེས་པར་རྟོགས།",
    "ལྟ་སྒོམ་སྤྱོད་འབྲས་ལ་ཉམས་མྱོང་གི་དྲོད་རྟགས་ཐོབ་པ།",
    "འབྲེལ་ཚད་རྣམ་གྲོལ་ཟབ་མོའི་ལམ་ལ་སྦྱོར།",
    "ཐབས་ལམ་ཟབ་མོས་གང་ཡང་ལམ་དུ་སྒྱུར།",
    "ཐབས་ལམ་ཟབ་མོ་མངའ་བས་གང་ཡང་ལམ་དུ་སྒྱུར་བ།",
    "གསང་བ་ཡིད་བཞིན་མཆོག་གི་རྒྱུད་ལས།",
    "དེ་དག་གི་དོན་ཡང་།",
    "དྲུག་ཚན་རེ་ཚང་བའང་དམ་པར་བཟུང་ནས་བསྟེན་པར་བྱའོ།",
    "དེ་དག་གི་ནང་ནས་ལམ་ལ་མཁས་པ་དག་གཙོ་བོར་བསྟེན་ཏེ།",
    "གཏན་གྱི་འདུན་གྲོས་ཐར་ལམ་ཟབ་མོ་ཉིད།",
    "ཉོན་མོངས་མ་ལུས་རྩད་གཅོད་པ།",
    "ཐར་ལམ་བསྒྲུབ་པའང་ཚོགས་གཉིས་རྫོགས་ལ་རག།",
    "ཞིང་གི་མཆོག་གྱུར་གུས་པས་རྟག་ཏུ་བསྟེན།",
    "ཡིད་བཞིན་མཆོག་གི་རྒྱུད་ལས།",
    "ཡིད་ཀྱིས་མོས་པ་དང་གུས་པ་ལ་སོགས་པ་དང་།",
    "རང་གི་རྫས་དང་ཡོ་བྱད་ཀྱིས།",
    "རང་གི་བདེ་བ་དགྲ་ལྟར་འཇོམས།",
    "གཞན་ཡང་གནས་སྐབས་དང་མཐར་ཐུག་གི་འཇིགས་པ་སྐྱོབ་ཅིང་ལེགས་པར་སྒྲུབ་པ་ཐམས་ཅད་སྒྲུབ་པའི་མཆོག་ཏུ་སོང་བ་ཉིད་ནི་དེ་ལས།",
    "ལས་དང་ཉོན་མོངས་པ་རྣམས་ཀྱིས་ཐུབ་པར་དཀའ།",
    "གཞན་ཞིག་བདག་གི་སྟོན་པར་མི་འགྱུར་བས།",
    "བདག་ཅག་གི་ངོར་དྲིན་ཆེ་བས་ལྷག་པར་ཡང་བརྗོད་དེ།",
    "ཡོན་ཏན་མཆོག་གི་གཏེར་གྱུར་པ།",
    "ཁྱོད་ལ་སོགས་པའི་དོན་དུ་འགྱུར།",
    "རང་གིས་ཀྱང་ཕྱོགས་ཐ་དད་པར་སོང་ལ་བརྟགས་ཏེ།",
    "ལས་དང་ཉོན་མོངས་པས་ཐུབ་པར་དཀའོ།",
    "གང་ངག་གི་ལས་ལ་མི་སྤྲོ་བ་དེ་མེད་དོ་ཞེས་པ་དང་།",
    "ལོངས་སྤྱོད་དང་མི་གཞི་ལ་སོགས་པའི་སྐྱོན་ཕྱོགས་རེའམ་དུ་མ་ཡོད་ཀྱང་བསྟེན་ལ།",
    "གཏོང་ཕོད་ཆུང་བ་དག་གི་ཡང་ཚོགས་གཉིས་རྫོགས་པའི་ཡན་ལག་ཏུ་ཡོ་བྱད་འདོད་པར་བྱེད་དོ།",
    "བདུད་དུ་ཤེས་ནས་སླར་ཡང་གུས་མཆོག་གིས།",
    "ཅི་ནས་ཀྱང་དཔོན་སློབ་དག་གི་བར་དུ་དབྱེན་བཅའ་ཞིང་།",
    "མཚན་མོའི་མུན་ནག་སྣང་བ་ཇི་ལྟ་བུ།",
    "ཆུ་གཏེར་ཟབ་མོའི་འབྱུང་གནས་བགྲོད་པར་བྱེད།",
    "འགྲོ་འོང་གིས་མི་སྐྱོ་བ་གྲུ་ལྟ་བུའི་སེམས་དང་།",
    "ཉོན་མོངས་པས་མི་སྐྱོ་བ་མ་ལྟ་བུའི་སེམས་དང་།",
    "གཏི་མུག་གི་གཉིད་ལས་སད་པར་བྱེད་པའི་འདུ་ཤེས་བསྐྱེད་དོ།",
    "ཉོན་མོངས་པའི་མེ་འབར་བ་ལས་ཞི་བར་བྱེད་པའི་ཆར་སྤྲིན་གྱི་འདུ་ཤེས་བསྐྱེད་དོ་ཞེས་པ་དང་།",
