    "གསུམ་པ་སྲེག་པའི་ཚུལ་ནི་ལྷུང་བཟེད་དེ་སྲེག་པར་བྱའོ།",
    "ཕྱི་ནང་བྱུགས་པ་དེ་བསྐམས་པར་གྱུར་པས་དགབ་པར་བྱའོ།",
    "ས་གཞི་བྱི་དོར་བྱས་པར་ཕུབ་མ་གདིང་ཞིང་དུ་བ་འཚེར་བར་བྱེད་པའི་རྒྱུ་འབྲུ་མར་གྱི་ཚིག་མ་འབའ་ཆ་དང་ཨ་རུ་ར་ལ་སོགས་པའི་རྫས་བཀྲམ་པའི་སྟེང་དུ་ལྷུང་བཟེད་ཁ་བུབ་ཏུ་བཞག་པ་ལ་རྫ་བོས་དགབ་བོ།",
    "ལྷུང་བཟེད་ཀྱི་ཁ་དོག་རྫོཊ་པ་ཕུན་སུམ་ཚོཊ་པར་གྱུར་གྱི་བར་དུ་ཡང་ཡང་བཟླས་པར་བྱའོ།",
    "ཇི་ལྟར་བཟླས་ན་བྱི་དོར་བྱས་ཤིང་བསྲེག་པའི་གནས་སུ་གཞུག་པར་བྱའོ།་།",
    "བསྙེན་པར་རྫོགས་པར་འདོད་པའི་ལོ་ཚིགས་མི་ཤེས་ན་མཚན་གྱི་ཉེ་འཁོར་དུ་སྤུ་སྐྱེས་པ་བསྙེན་པར་རྫོགས་པར་ཁས་བླང་བར་བྱའོ།",
    "དེ་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "མཚན་གྱི་ཉེ་འཁོར་དུ་སྤུ་སྐྱེས་པ་དེ་ནི་དེ་ཉིད་ཀྱིས་མ་ཚོར་བ་སྒྱུ་ཐབས་ཀྱིས་བརྟག་པར་བྱའོ།",
    "བསྙེན་པར་རྫོགས་པར་འདོད་པ་དེ་མཐོང་བའི་སྤྱོད་ཡུལ་ལས་འདས་པའི་མཚམས་ཀྱི་ཕྱི་རོལ་ཏུ་མི་བཏང་ངོ།",
    "བསྙེན་པར་རྫོགས་མ་ཐག་པ་ལ་གནས་མི་བརྗོད་པར་མི་བྱ་སྟེ།",
    "དེའི་ཚེ་སེམས་མཐུན་པས་གནས་རྣམས་བསྒྲུབ་པར་སྤྲོ་བའི་ཕྱིར་རོ།",
    "ཐོབ་པ་མི་ཉམས་པར་བསྲུང་བའི་སྤྲོས་པ།",
    "གཉིས་པ་ཐོབ་པ་མི་ཉམས་པར་བསྲུང་བའི་སྤྲོས་པ་ལ་བཞི།",
    "གཙུག་ལག་ཁང་གང་ན་གནས་མེད་པ་དེར་གསོ་སྦྱོང་མ་འོངས་པ་ལ་བསྡད་པར་དང་དབྱར་སྔ་མ་གནས་པར་ཁས་བླང་བར་མི་བྱ་སྟེ།",
    "དབྱར་སྔ་མ་གནས་པར་ཁས་བླངས་པའི་ཚེ་གནས་མེད་པར་གྱུར་ན་དབྱར་སྔ་མ་རྗེས་སུ་བསྲུང་བར་མི་བྱ་བར་གནས་ཡོད་ས་དེར་འགྲོ་བར་བྱའོ།",
    "དབྱར་ཕྱི་མ་ལ་ཡང་ཁས་བླངས་ནས་གནས་མེད་པར་གྱུར་ན་ཟླ་བ་དང་པོ་གཉིས་ལས་ལྷག་པ་བསྲུང་བར་མི་བྱའོ།",
    "དེའི་ཚེ་ཆེས་རྒན་པས་མ་ཞུས་པར་ཡང་བྱ་བ་བྱའོ།",
    "གནས་པར་བྱ་བ་ཉེ་བར་མི་གནས་པ་ཞུ་ས་མེད་ན་གཞན་ལ་ཞུ་བར་བྱའོ།",
    "མ་ཞུས་པར་བྱ་བ་མི་བྱ་བའི་དམིགས་བསལ་ནི།",
    "དུལ་བའི་ཚུལ་གྱིས་དགེ་ལ་བརྟེན་པར་བྱ།",
    "ཆེད་དུ་མ་བསྒོས་པར་ཡང་འགོས་པར་འགྱུར།",
    "གནས་ཀྱིས་ཀྱང་ཐམས་ཅད་ལ་གནས་སྦྱིན་པར་མི་བྱ་བར།",
    "གནས་དང་གནས་པ་གཉིས་ཇི་ལྟར་གནས་པར་བྱ་ཞེ་ན།",
    "གནས་པས་གནས་ལ་པའི་འདུ་ཤེས་དག་བསྐྱེད་པར་བྱའོ།",
    "གནས་ཀྱི་འོས་དུ་མ་ཚོགས་ན་གང་ལ་གནས་པར་བྱ་ཞེ་ན།",
    "གནས་པ་ཆད་པས་བཅད་པར་འོས་པ་གནས་ཀྱིས་ཆད་པས་མི་བཅད་པར་མི་བྱའོ།",
    "གནས་དགག་པ་སྟེ་གནས་འཆར་མི་གཞུག་པར་བྱའོ།",
    "ཆད་པས་བཅད་ཀྱང་བཟོད་པ་གསོལ་བའི་ཕྱིར་དུ་གུས་པར་མི་བྱེད་ན་དྲང་པོར་བྱ་བའི་ཕྱིར་གནས་ཀྱིས་དགེ་སློང་ཤེས་ཉེན་ཅན་གཞན་བསྐོ་བར་བྱའོ།",
    "དད་པ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པ་ཆད་པས་བཅད་པར་མི་འོས་པ་ལ་ཆད་པས་བཅད་པར་མི་བྱའོ།",
    "ཆད་པའི་རྒྱུ་བཏང་བ་བཟོད་པ་བྱ་བར་འོས་པ་ལ་མི་བཟོད་པར་མི་བྱའོ།",
    "དེ་གནས་ཁང་ནས་བསྐྲད་པར་བྱའོ།",
    "ཡོ་བྱད་མེད་པར་བསྐྲད་དམ་ཞེ་ན།་",
    "བསྐྲད་བྱ་དགེ་ཚུལ་ལ་ནི་ཆུ་ཚགས་དང་རིལ་བ་སྤྱི་བླུགས་དང་མཐང་གོས་དང་བཅས་པའི་བླ་གོས་ཀྱང་བྱིན་ཏེ་བསྐྲད་པར་བྱའོ།",
    "ཆུ་ཚགས་ཀྱང་བྱིན་ཏེ་བསྐྲད་པར་བྱའོ།",
    "བསྐྲད་བྱ་བསྙེན་པར་རྫོགས་པ་ལ་ཡང་ཡོ་བྱད་དྲུག་བྱིན་ནས་བསྐྲད་དོ།",
    "སོ་ཤིང་དོར་བ་དེ་ལ་ཝ་ཁ་ཡང་མི་དབེན་པར་མི་འགྱུར་རོ།",
    "ལྕེ་བཞར་ཉེ་བར་གཞག་པར་བྱའོ།་།",
    "རྒྱུ་ཅི་ལས་བྱས་པ་ཞེ་ན།",
    "ཁབ་ཀྱི་རྫས་ར་གན་དང་ཟངས་དང་ཁར་བ་དང་ལྕགས་དག་ལ་བྱས་པའོ།",
    "མི་རྣོ་བས་ཀྱང་དལ་གྱིས་མ་ཡིན་པར་དྲུད་བཞར་མི་བྱའོ།",
    "སོ་དང་ལྕེ་གཉིས་ཀྱི་དྲུད་བཞར་གྱི་ཕྱོགས་ཁའི་དྲི་མས་གོས་པ་མ་བཀྲུས་སམ་སས་མ་བསྐུས་པར་མི་དོར་རོ།",
    "སེ་གོལ་ལ་སོགས་པའི་སྒྲ་མ་བྱས་པར་སོ་ཤིང་མི་དོར་རོ།",
    "དེ་ལ་ཐོག་མར་ཕྱག་བྱས་ཏེ།",
    "ལྡང་བྱེད་ལ་གསུངས་པ་བཞིན་ནོ།",
    "ཚིག་ལེའུར་བྱས་པ་ལྔ་བཅུ་པར།",
    "ཞེས་སོགས་གསུངས།་",
    "དེ་ནས་ཚང་མང་སྟེ་གཡོས་ཁང་བལྟས་ཏེ་བཟའ་བཏུང་ཇི་ལྟ་བུ་སྟ་གོན་བགྱི་ཞེས་གནས་ལ་བརྗོད་པར་བྱའོ།",
    "གལ་ཏེ་གནས་དེ་ལྷན་ཅིག་བསོད་སྙོམས་ལ་འཇུག་པར་བཟོད་ཅིང་འདོད་ན་གནས་དེ་ཉིད་དང་ལྷན་ཅིག་བསོད་སྙོམས་ལ་འཇུག་པར་བྱའོ།",
    "འདམ་རྫབ་ལ་སོགས་པ་ཉམ་ང་བ་ལ་སོགས་པར་གནས་པས་མདུན་དུ་༥༦བ་འགྲོ་བར་བྱའོ།་།",
    "གནས་ལ་བསོད་སྙོམས་བསྟན་པར་བྱའོ།",
    "བཟའ་བ་དང་བཅའ་བ་ཆེས་མཆོག་ཏུ་གྱུར་པ་འདི་བཞེས་ཤིག་ཅེས་གནས་ལ་དབུལ་བར་བྱཞོ།",
    "གནས་དེས་བསོད་པ་སྟོབས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་བྱ་བ་ཐམས་ཅད་ལ་གནས་པ་ལ་མི་གནོད་པ་དེ་ལྟར་ཚོད་རིག་པར་བྱའོ།",
    "གདུགས་ཚོད་ལ་བབ་པོ་ཞེས་ཟན་གྱི་དུས་བརྗོད་པར་བྱའོ།",
    "གནས་པས་གནས་ཀྱི་མལ་དང་སྟན་བཤམ་པར་བྱའོ།",
    "དེ་ལྟར་མ་བསྐོས་པར་ཁབ་ཐོགས་པ་ཡང་མཐོང་ན་ལས་ཆུང་ངུར་བྱའོ།",
    "ཤིང་ཐོག་ལ་སོགས་པ་རུང་བར་བྱ་བ་དང་མཆོད་རྟེན་སོགས་ལ་སྐྱེས་པའི་སྔོ་ཆུང་དུ་རྔ་བ་དང་མེ་ཏོག་དང་འབྲས་བུ་བཏོག་པ་དང་སོ་ཤིང་ཉེ་བར་བསྒྲུབ་པ་ལ་སོགས་པར་ཡང་དགེ་ཚུལ་བསྐོའོ།",
