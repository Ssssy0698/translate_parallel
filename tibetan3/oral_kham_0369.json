    "རྡོར་སེམས་སྐུ་དངོས་ལྟ་བུ་ཞིག་ལ་སྐུ་སྨད་དུ་རིང་བསྲེལ་གྲངས་མེད་པ་འབྱར་ནས་འདུག་པ་མཇལ་བར།",
    "ནང་ནུབ་ཟས་ནོར་ཏེ་འདུ་བ་རྣམ་པ་གསུམ་རྣམས་ནི་ཐམས་ཅད་ཀྱི་མཐུན་སྣང་དུ་གྲུབ་པ་དེར་གདའ།",
    "ལར་ཁྱེད་རང་རྣམས་ནས་བྱ་དགོས་ངེས་དེ་ཅིའང་མི་བྱེད།",
    "འདི་དེ་ཙམ་གྱི་རྙིང་ཉམས་བཅའ་ཁ་སོགས་མི་འདུག་པས་ན་མ་ཅི་ཆེ་གསུངས་པས།",
    "རྗེ་ཉིད་ཁྱམས་ཡངས་པ་ཞིག་ན་ཁྲི་མཐོན་པོར་བཞུགས་འདུག་པ་ལ།",
    "སྟོད་ཀླུ་འཇིམ་གྱི་རྣམ་པ་རྡོ་རྗེ་འཆང་སྐེད་ཡན་ཆོད་ཤིན་ཏུ་གསལ་བ་ཞིག་འདུག།",
    "ཤོག་སེར་ཆུང་ངུ་ཞིག་འདུག་སྟེ་ངེད་ནས་ཀློག་མི་ཤེས་གསུངས།",
    "ལར་ཁྱེད་རང་ལ་བྱང་གཏེར་འདིའི་བག་ཆགས་ཆེན་པོ་ཡོད་པ་གསུངས།",
    "དེས་རྩ་མདུད་གྲོལ་བས་དེ་ཕྱིན་ཆད་ཤོག་སེར་འབེབས་པ་ལ་ཐོགས་པ་མེད་པ་དང་ཚིག་དོན་ཐམས་ཅད་རིམ་བཞིན་ཇེ་ལེགས་ཇེ་ཟབ་ཏུ་གྱུར་པ་བྱུང་འདུག།",
    "དེར་སུ་འདུག་བལྟ་དགོས་དགོངས་ནས་ཕེབས་པས།",
    "དེར་མངའ་རིས་རིག་འཛིན་ལེགས་ལྡན་རྡོ་རྗེ་ཉིད་། སྔགས་པའི་ཆ་ལུགས་ཅན་དུ་བཞུགས་འདུག་པ་ལ་གུས་འདུད་མཛད་ནས་འདིར་ཕེབས་དོན་ཅི་ཡིན་ཞུས་པར།",
    "ཁྱེད་རང་གསུམ་ཙམ་མ་གཏོགས་སྐས་ཆེན་འདི་ཚུགས་ཐུབ་པ་ནི་སུའང་མི་འདུག་ཟེར་བ་ཞིག་བྱུང་བས་འདི་ལའང་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གསུངས།",
    "སྤང་ལྗོངས་ནེའུ་གསེང་ཆུ་མཚོ་རྣམས་ལ་མེ་ཏོག་དཀར་དམར་སྣ་ཚོགས་ཀྱིས་སྤྲས་ཤིང་ཤིན་ཏུ་ཉམས་དགའ་ལ་ཡིད་དུ་འོང་བ་ཞིག་ཏུ་ཕེབས་འདུག་པར།",
    "འཇིག་རྟེན་གྱི་ངོས་ནས་ཀྱང་རྗེ་ཉིད་ཀྱི་ཡབ་དེ་ཤིན་ཏུ་བློ་དྲང་ཞིང་ངོ་ལྐོག་ཐུབ་པ་ཞིག་ཡོད་འདུག་སྟབས།",
    "ཐ་ཆད་འགའ་ཞིག་རྣ་བ་སུན་སྣང་ཡང་སྐྱེ་སྲིད་པར་འདུག།",
    "མཐར་འཆི་དུས་ཀྱང་གཅིག་པུར་འཆི་བས་གལ་ཆེ་ཤོས་དེ་གཉིས་ལ་བློ་སྟོན་གྲོས་བྱེད་མཁན་སུ་མི་འདུག་པ།",
    "རྗེ་ཉིད་སྐུ་ན་གཞོན་ནུའི་དུས་སྐུ་གཟུགས་ཐང་པོ་ཞིག་ཡིན་འདུག་རུང་།",
    "ཐ་ན་སོ་སོའི་ལམ་མཐུན་མན་ངག་ཚད་ལྡན་ཤོག་ལྡེབ་གཅིག་འདུག་ཀྱང་གསར་བྲིས་ཀྱིས་བཞེངས་པར་མཛད་པའི་པུསྟི་ཉིས་བརྒྱ་ཡར་བརྒལ་དང་།",
    "གཡོན་ཕྱོགས་ནས་གླེགས་བམ་ཞིག་བླངས་ཏེ་བསྟན་པ་ཤེར་ཕྱིན་སྡུད་པའི་རྒྱ་དཔེར་འདུག།",
    "ད་ནས་དུས་ཡོལ་ཟིན་པས་ཅི་བྱ་མེད་ནའང་ཁྱེད་རང་ལ་ཐེངས་པ་ཡིན།",
    "ཡང་མེ་ཡོས་ལོར་རྗེ་ཉིད་དང་མཆོག་གླིང་ལྷན་རྒྱས་ཕེབས་བཞུད་མཛད་སྐབས་ཡབ་བཞིས་རི་བོ་ཁྱུང་ལྡིང་ངམ་ཁྱུང་ཚང་བྲག་ནས་རྡོ་སྒྲོམ་རིམ་པ་གསུམ་པ་ཞིག་སྤྱན་དྲངས་པ་ལ་རྩ་གསུམ་བཀའ་འདུས་ཀྱི་ཆ་ལག་རྗེས་འབངས་ཉེར་ལྔ་སོ་སོའི་སྒྲུབ་ཐབས་དམ་རྫས་བཅས་བཞུགས་པ་ཡིན་འདུག་ཀྱང་།",
    "པདྨ་ཤེལ་རིར་གཏེར་ཁ་ཞིག་ཡོད་པ་སོགས་རྗེ་ཉིད་སྔར་ཕེབས་སྐབས་གྲ་འགྲིགས་པོ་མ་བྱུང་བ་དང་ད་ཕན་དངོས་ཀྱིས་ཕེབས་པ་མི་འོང་བར་འདུག་པས་དེ་རིགས་ལོན་རྒྱུ་བྱུང་ན་གལ་ཆེ་བ་ཡོད་ཚུལ་བཀས་གནང་བ་ལྟར།",
    "གཞན་ཐམས་ཅད་རྗེ་ཉིད་ནས་འབེབས་པར་གནང་འདུག་པ་དང་།",
    "འདི་སྐོར་དག་སྣང་མང་དུ་འདུག་ཀྱང་འདིར་མ་བཀོད།",
    "ཕྱིས་སུའང་དགོངས་པ་ཆེད་དུ་གཏད་ན་ཞིབ་ཆ་མཁྱེན་པར་འདུག་གསུངས།",
    "ནག་ཕྱོགས་དར་ན་ཕུང་ཁྲོལ་ཚབ་ཇེ་ཆེར་འགྱུར་བས་དམ་སྲི་འདི་རྣམས་བསྒྲལ་དགོས་ཞེས་ནན་གྱིས་བཏུད་ནས་ཟེར་འདུག་པ་ལ།",
    "དངོས་སུའང་ཁྲག་དྲི་སྣོམ་པ་སོགས་བྱུང་འདུག།",
    "དེ་རྗེས་ངོས་བཟུང་མེད་པའི་བསྙུན་ཁམས་ཀྱིས་གསུང་འགག་པ་སོགས་ཀྱང་བྱུང་འདུག་པས།",
    "དེ་སྐབས་བསྟན་པའི་རིམ་གྲོ་འདོན་བྱ་སོགས་སྒྲུབ་མཁན་མང་འདུག་ཀྱང་དོན་དུ་རྗེ་འདི་ཉིད་ཀྱི་ཐུགས་རྗེས་ནག་ཕྱོགས་གདུག་པའི་ཚ་ངར་ཕྱེད་ཙམ་ཞི་ནས་རྒྱལ་ཁམས་སུ་བདེ་སྐྱིད་སྤྲིན་བར་གྱི་ཉི་མ་ཙམ་བརྡོལ་བར་མངོན་ནོ།",
    "རང་རང་ཉམས་ལེན་མཐར་དབྱུང་ལ",
    "བར་སྣང་དུ་སླེབས་པ་ལྟ་བུ་མཐོ་བའི་ནང་དུ་ཁྲི་སྟན་ཞིག་འདུག་པ་ཉིད་ཀྱི་ཡིན་སྙམ་གྱིས་དེར་བཞུགས།",
    "བར་དན་དུ་ཆང་བུམ་ལྟ་བུའི་ལྗང་གུ་ཆེ་ལེགས་ཞིག་འདུག་པ་ན་ཉིད་སྔར་མལ་བཞུགས།",
    "ཁྱེད་རང་རྣམས་སློབ་དཔོན་པདྨ་དང་།",
    "དེ་སྔ་གཏེར་སྟོན་གྱི་མིང་ཐོགས་མི་འདུག།",
    "ཞེས་གསུངས་པའང་ཇི་བཞིན་བྱུང་བར་འདུག་གོ།",
    "ཁྱེད་སྔ་འགྱུར་ལོ་ཙཱ་བ་ཡིན་ན་རྗེ་འབངས་ཉེར་ལྔའི་གྲལ་དུ་མི་འདུག་ན་གསུངས་པས།",
    "། ད་རུང་གཏེར་རྙིང་སྐོར་ཉི་ཤུ་རྩ་ལྔ་ཁ་ལོངས་པ་ཞིག་ཕབ་རྒྱུ་དང་འཇོག་རྒྱུ་ཐོན་ན་ཁྱེད་རང་གཉིས་ཀ་ད་རུང་ལོ་ཉི་ཤུ་རྩ་ལྔ་སྡོད།",
    "ནོར་བུའི་ཁང་པ་དང་རྒྱན་སོགས་ལ་ལོངས་སྤྱོད་པའི་ཡ་མཚན་ཅན་ཞིག་འདུག་སྙམ་བྱེད་པའི་ངང་དེ་ལས་སད་གསུངས།",
    "གསོལ་ཚིགས་ཞིག་ཞུ་དགོས་ཟེར་འདུག་པས་རྟ་འདི་ཆིབས་ནས་གསོལ་ཚིགས་ལ་འབྱོན་པར་ཞུ་ཟེར།",
    "འདི་ནང་བྲམ་། ཟེ་སྐྱེ་བདུན་ཤ་རིལ་སྟོང་ཕྲག་གསུམ་ཡོད་པ་སྔར་ལས་འཕྲོ་གླིང་པ་ལ་ཕུལ་བ་ཁོང་འགྲོ་དོན་ཆེ་བས་ད་གཅིག་ལས་ལྷག་མི་འདུག།",
    "ཟབ་བུ་ལུང་གཏེར་ལུང་མཇལ་དུ་འགྲོ་བ་ཡིན་ཁོ་ན་གསུངས་ཀྱིན་འདུག།",
    "ཕྱི་དྲོ་ལུང་པའི་རྐེད་ཙམ་སླེབ་པ་ཆུ་ཕར་ཀ་དེར་འབྲོག་དུད་ཕྱུག་པོ་ཞིག་འདུག་པ།",
