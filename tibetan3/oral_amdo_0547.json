    "ཟླ་བ་དྲུག་གི་རིང་སྐུ་མཚམས་སུ་བཞུགས་ནས་ཡ་མ་རཱ་ཛ་བྱེ་ཆེན་གཅིག་སོང་སྐབས་མནལ་ལམ་དུ་རྭ་ལོ་ཙཱ་བས་ཕྱག་མཚན་བི་དྷི་པཱ་ལ་གཏད་དེ་རྩ་སྔགས་ཀྱི་བསྙེན་པ་དེས་ཆོག་ཟེར་བའི་གནང་བ་ཐོབ།",
    "ཕྱིས་སུ་རྒྱ་གྲྭ་ཚང་དང་འབྲོམ་སྟེང་གྲྭ་ཚང་གཉིས་ཀ་སྟོད་པ་གྲྭ་ཚང་དུ་ཟླ་བསྒྲིལ་བ་རེད།",
    "བོད་རབ་བྱུང་བདུན་པའི་ལྕགས་ལུག་སྤྱི་ལོ་༡་༢༩༡ལོར་ཡབ་མགོན་པོ་རྡོ་རྗེ་དང་ཡུམ་ཇོ་མོ་ནམ་མཁའ་སྐྱིད་གཉིས་ཀྱི་སྲས་སུ་སྐུ་འཁྲུངས།་",
    "དེ་ནས་གཙང་གི་ཕྱོགས་སུ་ཕེབས་ནས་སྣར་ཐང་དང་རེ་ཕུད་དང་བྲག་དམར་སོགས་སུ་ལོ་ངོ་བཅུ་གཉིས་ཙམ་གྱི་རིང་འཆད་ཉན་སྤེལ་བས་གྲྭ་ཚོགས་ཀྱང་རྒྱ་ཆེར་འཕེལ།",
    "སྐྱོར་མོ་ལུང་།",
    "གཙང་གི་བཀྲ་ཤིས་ལྷུན་པོ།",
    "ཀ་། རང་གི་མིག་ལམ་དུ་གྱུར་པའི་ཚད་གཞུང་ཇི་ཡོད་ཀྱི་སྐོར།",
    "དྲུང་ཆེན་ལེགས་བཟང་གི་བློ་རིག་ལ་སུམ་ཅུ་ཐམ་པ།",
    "དེར་ཐལ།",
    "ཤེས་བྱ་རྣམས་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཡིན།",
    "༡ རྟག་པ་དང་དངོས་པོ་གཉིས་མཚོན་པའི་རྩི་ཤིང་གི་ཡལ་ག་གཉིས་ཡོད།་",
    "རེ་འགའ་བའི་རྟག་པ་གཉིས།",
    "དེ་བཞིན་དུ་རྟག་པ་ཡིན་ན་རྣམ་པ་ཐམས་ཅད་པའི་རྟག་པ་ཡིན་པས་མ་ཁྱབ་ལ་རེ་འགའ་བའི་རྟག་པ་ཡིན་པས་ཀྱང་མ་ཁྱབ་བོ། ། དཔེ་དོན་མཚོན་ཚུལ་ནི་གོང་གི་རིགས་པའི་འགྲོས་དེ་ལ་བརྟེན་ནས་གཤམ་འོག་ཐམས་ཅད་དུ་ཤེས་པར་བྱའོ།",
    "རེག་བྱའི་སྐྱེ་མཆེད་དང་ལྔ།",
    "རྩ་བའི་ཁ་དོག་དང་ཡན་ལག་གི་ཁ་དོག་གཉིས།",
    "ཡན་ལག་གི་ཁ་དོག་ལ་དབྱེ་ན་བརྒྱད།",
    "རྩ་བའི་ཁ་དོག་དང་ཡན་ལག་གི་ཁ་དོག་གང་རུང་ཡིན་ན་ཁ་དོག་ཡིན་པས་ཁྱབ་ཀྱང་ཁ་དོག་ཡིན་ན་རྩ་བའི་ཁ་དོག་དང་ཡན་ལག་གི་ཁ་དོག་བཅུ་གཉིས་པོ་གང་རུང་ཡིན་པས་མཁྱབ་བོ།",
    "ཡན་ལག་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་བཞི།",
    "ཉིང་ལག་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་བརྒྱད།",
    "སྐྱེས་བུའི་ཐལ་མོ་བརྡབས་པའི་སྒྲ་ལྟ་བུ་ལ་མཚོན་ན།",
    "ཁྱོད་དེ་ལ་བརྟེན་ནས་སྐྱེས་པའི་སྒྲ་ཡིན་པའི་ཕྱིར་ན་དེ་ལྟར་བརྗོད་པ་ཡིན་ནོ།",
    "ཡན་ལག་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་དྲུག།",
    "སྦྱར་བྱུང་གི་དྲི་གཉིས་ཡོད།",
    "གཉིས་པ་སྦྱར་བྱུང་གི་དྲི་ལ་དབྱེ་ན།",
    "ཡན་ལག་གི་ལོ་འདབ་སོ་དྲུག་པོ་རེ་རེ་ལའང་གསུམ་གསུམ་དུ་ཕྱེ་བས་ཉིང་ལག་གི་བརྒྱ་དང་བརྒྱད་ཡོད།",
    "ཡན་ལག་གི་སྒོ་ནས་དབྱེ་ན་སོ་དྲུག་སྟེ།",
    "ཉིང་ལག་གི་སྒོ་ནས་རོ་བརྒྱ་དང་བརྒྱད་དུ་དབྱེ་ཚུལ་ནི།",
    "རོ་སོ་དྲུག་པོ་རེ་རེའི་ངོ་བོར་གྱུར་པའི་ཐོག་མར་མྱང་བའི་ཚེ་ལྕེ་ཤེར་ཕན་པ་དང་།",
    "ཡན་ལག་གི་དབྱེ་བ་མཚོན་བྱེད་ཀྱི་ལོ་འདབ་བཅུ་གཅིག།",
    "དེ་ཡང་ལུས་ཤེས་ཀྱི་མྱོང་བྱ་དེ་རེག་བྱའི་སྐྱེ་མཆེད་ཀྱི་མཚན་ཉིད་དོ།",
    "འབྱུང་འགྱུར་གྱི་རེག་བྱ་གཉིས།",
    "གཉིས་པ་འབྱུང་འགྱུར་གྱི་རེག་བྱ་ལ་དབྱེ་ན།",
    "རེག་བྱའི་དབྱེ་བ་བཅུ་གཅིག་པོ་གང་རུང་ཡིན་ན་རེག་བྱ་ཡིན་པས་ཁྱབ་ཀྱང་རེག་བྱ་ཡིན་ན་དབྱེ་བ་བཅུ་གཅིག་པོ་གང་རུང་ཡིན་པ་མ་ཁྱབ་བོ།",
    "རྗེས་དཔག་གི་རྒྱུན་དུ་གྱུར་པའི་དཔྱད་ཤེས།་",
    "དེ་གཉིས་གང་རུང་མ་ཡིན་པའི་དཔྱད་ཤེས་དང་གསུམ་མོ།",
    "རྗེས་དཔག་གི་རྒྱུན་དུ་གྱུར་པའི་དཔྱད་ཤེས་ལ་དབྱེ་ན།",
    "དངོས་སྟོབས་རྗེས་དཔག་གི་རྒྱུན་དུ་གྱུར་པའི་དཔྱད་ཤེས་དང་།",
    "ཡིད་ཆེས་རྗེས་དཔག་གི་རྒྱུན་དུ་གྱུར་པའི་དཔྱད་ཤེས།",
    "དེ་གསུམ་གང་རུང་མ་ཡིན་པའི་རྗེས་དཔག་གི་རྒྱུན་དུ་གྱུར་པའི་དཔྱད་ཤེས་དང་བཞི་ཡོད།",
    "་ ༢ རང་གི་འཇུག་ཡུལ་ལ་འཁྲུལ་པའི་རིག་པ་དེ།",
    "རང་གི་གཞན་ཡུལ་ལ་འཁྲུལ་བའི་རིག་པ་དེ།",
    "རང་གི་འཛིན་སྟངས་ཡུལ་ལ་འཁྲུལ་པའི་གསལ་སྣང་ཅན་གྱི་རིག་པ་དེ།",
    "༥་རང་གི་འཇུག་ཡུལ་དུ་གྱུར་པའི་རབ་མཚན་གསལ་བར་སྣང་ཡང་མ་ངེས་པའི་བློ་དེ།",
    "སེམས་དང་སེམས་བྱུང་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་ལྔ་བཅུ་ང་བདུན།",
    "དེའི་ནང་ནས་སེམས་བྱུང་གི་ཡན་ལག་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་ལྔ་བཅུ་ང་གཅིག།",
    "སེམས་བྱུང་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་ལྔ་བཅུ་ང་གཅིག་གི་ནང་ནས་ཀུན་འགྲོའི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་ལྔ།་ཡུལ་ངེས་ཀྱི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་ལྔ།",
    "༥ རེག་པ་དང་ལྔའོ། གཉིས་པ།",
    "སེམས་བྱུང་གི་དབྱེ་བ་ང་གཅིག་གང་རུང་ཡིན་ན།",
    "གཙོ་བོའི་སེམས་རྣམས་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཡིན།",
    "གཟུགས་ཤེས་གང་རུང་མ་ཡིན་པའི་དངོས་པོ་གསུམ་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཡིན།",
    "ནང་གཟུགས་དག་གི་དབྱེ་བ་མཚོན་པའི་ལོ་འདབ་དག་གི་ཁ་དོག་ནི་དམར་སྐྱ།",
    "ཉོན་མོངས་ཅན་ཀྱི་སེམས་བྱུང་རྣམས་ལ་དམར་ནག་ཏུ་བྱས་པ་ནི།",
    "༞། ན་མོ་གུ་རུ།",
    "དཔྱད་གཞིའི་ཚུལ་དང་སྐལ་མཉམ་རེ་འགའ་ལ།",
    "ཕན་པར་རེ་བས་རིགས་འཕྲུལ་སྡོམ་འདི་འཆད། ། གཟུགས་སུ་རུང་བ་གཟུགས་ཀྱི་མཚན་ཉིད་དང་།",
    "མིག་གི་ཁམས་རྣམས་དོན་གཅིག་དབྱེ་ན་གཉིས།",
    "རང་འབྲས་ལུས་ཤེས་ཐུན་མོང་མ་ཡིན་པའི།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱའི་སྐྱེ་མཆེད་དོ།",
