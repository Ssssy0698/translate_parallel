    "དངོས་པོར་སྨྲ་བ་གང་དག་སྐྱེས་ཟིན་གྱི་དྲི་མ་ལམ་གྱིས་ཟད་པར་བྱས་པ་ལ་དྲི་མ་དེ་དག་བདག་གི་རྒྱུད་ལ་ཟད་དོ་སྙམ་པའི་ཤེས་པ་ནི་ཟད་པ་ཤེས་པ་དང་།",
    "སྐྱེ་འགྱུར་གྱི་དྲི་མ་ལམ་གྱིས་མི་སྐྱེ་བར་བྱས་པ་ལ་ཕྱིན་ཆད་བདག་གི་རྒྱུད་ལ་དྲི་མ་མི་སྐྱེའོ་སྙམ་པའི་ཤེས་པ་ནི་མི་སྐྱེ་བ་ཤེས་པ་ཡིན་པར་བརྗོད་པ་སྟེ་འདོད་ཅིང་།",
    "འདི་དག་ཀྱང་དོན་ལ་གང་ཡིན་དང་འདོད་པས་བཏགས་པའི་ཁྱད་མ་ཕྱེད་པར་དོན་སྨྲ་གཉིས་ཀྱི་རྣམ་གཞག་གིས་༡ཐེག་དམན་གྱི་འཕགས་པ་ལ་གྲུབ་དགོས་སྙམ་དུ་རྨོངས་པས་ལན་ནོ།",
    "གཉེན་པོ་མཐོང་ཞེས་བྱ་བའི་ལམ་གྱིས་ནི་དངོས་སྨྲ་བ་འདོད་པ་ལྟར་མཐོང་སྤང་རྣམ་པར་རྟོག་པའི་རིགས་སྔར་ཡོད་ཅི་ཞིག་ཟད་པར་བྱས་ཤིང་སྐྱེ་འགྱུར་མི་སྐྱེ་བར་བྱས་ནས་སྐྱེ་མེད་ཀྱི་རྣམ་པ་ཅི་ཞིག་འཐོབ་སྟེ་དེ་ལྟ་བུའི་ཟད་ཐོབ་མེད་པར་ཐལ་ཏེ།",
    "ཁྱོད་ཀྱིས་བཏགས་པ་ལྟར་གཉེན་པོ་མཐོང་བའི་ལམ་གྱི་སྟོབས་ཀྱིས་སྤང་བྱ་རྣམ་པར་རྟོག་པ་ཤེས་སྒྲིབ་དང་སོགས་པས་ཉོན་སྒྲིབ་ཀྱི་ངོ་བོ་སྔར་སྐྱེས་ཟིན་བདེན་པ་བ་ནི་ཅི་ཞིག་ཟད་པ་དང་།",
    "འདིས་ནི་ཁྱེད་ཀྱིས་བཏགས་པ་ལྟར་མཐོང་ལམ་གྱིས་དེ་མི་སྤོང་ཞེས་པའམ་ཁྱོད་འདོད་པ་ལྟར་གྱི་མཐོང་ལམ་གྱིས་མི་སྤོང་ཞེས་ཁས་བླངས་འགོག་པ་ཡིན་གྱི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པའི་རྣམ་པར་རྟོག་པས་རྣམ་པ་ཐམས་ཅད་དུ་སྟེ་མ་ལུས་པར་སྤངས་པ་ངོ་མཚར་ཆེ་བའི་གནས་ཏེ་མི་སྲིད་པ་ཡིན་ནོ་ཞེས་བར་ཚིགས་ཀྱིས་གསུངས་པ་ནིའོ།",
    "གཞུང་གི་འབྲེལ་བསམ།",
    "དེའི་ཕྱིར་དེ་དག་གི་ཁས་བླངས་འགལ་བ་ཡིན་ནོ།",
    "གཉིས་མེད་ཀྱི་རང་རིག་རྣམས་ལ་ཞེན་པ་གསུམ་ཡོད་པ་ལས་དང་པོ་གཉིས་སྤོང་ཚུལ་སེམས་ཙམ་དང་ཐུན་མོང་བ་ཡིན་ཞིང་།",
    "ཐུན་མོང་བའི་དོན་ཡང་གཟུང་བ་དང་འཛིན་པ་རྫས་གཞན་ལ་ཞེན་པའི་ཡུལ་བཀག་ནས་ཡུལ་ཅན་འགོག་པ་ཙམ་དུ་འདྲའོ།",
    "སྔར་བསྟན་པའི་འབྲེལ་དང་འོག་ནས་ཀྱང་གཞུང་འདི་དག་གི་དོན་བཟློག་པ་ལ་དངོས་སྨྲ་བའི་འདོད་པར་བྱས་ནས་སྒྲིབ་པ་སྤོང་མི་ནུས་པར་གསུངས་པས་སོ།",
    "དོན་སྨྲ་དང་སེམས་ཙམ་པ་ལྟར་གཟུང་འཛིན་དང་རང་རིག་དོན་ལ་ཡོད་པ་འཐད་པར་ཁས་ལེན་པའི་ཞེན་པ་མིན་གྱི་གང་ཟག་གི་རྒྱུད་ལ་མངོན་ཞེན་སྐྱེ་བ་ཙམ་ལ་གོ་བར་བྱ་སྟེ།",
    "གང་ཀུན་རྫོབ་ཏུ་ཡང་སྐྱེ་བ་དང་འཇིག་པས་སྟོང་བ་ནི་རྟག་པ་དང་བདག་གི་དངོས་པོར་མེད་དེ།",
    "རི་བོང་གི་རྭ་བཞིན།",
    "བྱེ་བྲག་པ་སོགས་ནི་བདག་རྟག་པ་བེམ་པོའི་ངོ་བོར་འདོད་ཅིང་རྟག་པ་ཡང་དོན་བྱེད་པའི་ནུས་པ་ཐམས་ཅད་ཀྱིས་དབེན་པས་སྐྱེ་འཇིག་གིས་སྟོང་པ་དང་།",
    "ནང་གི་མུ་སྟེགས་བདག་ཁས་ལེན་པ་གནས་མ་བུ་སོགས་ནི་རྟག་མི་རྟག་གང་དུ་ཡང་བརྗོད་བྲལ་དུ་འདོད་པས་དེ་ལ་ཡང་སྐྱེ་འཇིག་མི་རུང་ངོ།",
    "དཔེར་ན་སྒྱུ་མའི་རྟ་གླང་གི་སྣང་བ་བཞིན་དུའོ།",
    "གང་གི་ཚེ་སྤོང་ན།",
    "རིགས་པས་བརྟགས་ན་རྒྱུ་འབྲས་ཀྱི་དངོས་པོར་མི་འཐད་པས་སྒྱུ་མ་ལྟ་བུའི་བདག་ཉིད་དུ་སྣང་བའི་བློ་ཆགས་སོགས་ཀྱི་རྟོག་པས་སྟོང་པའི་མཐོང་ལམ་རྣམ་པར་མི་རྟོག་པ་རྣལ་འབྱོར་པ་སོ་སོ་རང་གིས་བརྗོད་མེད་དུ་རིག་པར་བྱ་བ་ཅི་ཞིག་ལྟར་ཏེ་འགའ་ཞིག་ཡང་དག་པར་རྒྱུད་ལ་སྐྱེས་པ་ནིའོ།",
    "གང་གི་ཚེ་སྐྱེ་ན།",
    "ནོར་བུ་སོགས་སྐྱེས་བུ་མིག་དག་པས་དུས་གཅིག་ཏུ་དེ་དག་མཐོང་ལ་དེའི་ཚེ་ཡང་མི་གནོད་ཅིང་ཕན་པ་ལྟར་དུ་མཐོང་བའི་ཡུལ་དུ་ཡང་ཀུན་རྫོབ་པ་རྣམས་ལག་མཐིལ་དུ་ཤིང་ཐོག་བཞག་པ་ལྟར་གསལ་བར་སྣང་ཞིང་དེ་དག་གིས་མི་གནོད་ལ།",
    "ཆགས་སོགས་ཀྱི་དྲི་མ་དེ་དག་ལ་ནི་རང་རང་གི་གཉེན་པོ་བསྒོམས་པས་གནོད་པ་ཅུང་ཟད་ཀྱང་མི་བྱེད་པར་འགྱུར་ཏེ།",
    "ནམ་མཁའ་ལ་གནོད་པ་བྱར་མེད་པ་བཞིན་དུ་ཞེས་པ་ནི་ཐལ་བའི་དམ་བཅའི་དཔེའོ།",
    "ནམ་མཁའ་ཐོགས་པའི་རེག་བྱའི་རྫས་མེད་པ་ཙམ་གྱི་ངོ་བོ་འཛིན་པ་སྟེ།",
    "དེ་དག་ལ་ཞེན་པའི་ཤེས་སྒྲིབ་སྤང་དུ་མི་རུང་བར་ཐལ།",
    "བདེན་འཛིན་དེ་ལ་གནོད་པ་མི་བྱེད་པར་ཐལ།",
    "གང་གིས་ན།",
    "སྦྱིན་པ་ལ་སོགས་པ་དྲུག་པོ་རེ་རེར་ནི་དྲུག་པོ་དེ་དག་ཕན་ཚུན་དུ་བསྡུས་པ་གང་ཡིན་པ་སྐད་ཅིག་གཅིག་པའི་བཟོད་པ་ཡིས་བསྡུས་པ་དེ་རྩེ་སྦྱོར་འདིར་མཐོང་ལམ་ཡིན་ཏེ།",
    "དེ་ཇི་ལྟར་གང་གིས་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "མཐོང་བའི་ལམ་གྱི་རྩེ་མོ་ཡིན་ནོ།",
    "བསྡུ་བྱ་སྦྱིན་སོགས་དྲུག་པོ་དེ་དག་སོ་སོར་སྡུད་བྱེད་སྦྱིན་སོགས་ཕྱིན་དྲུག་རེ་རེར་སྔ་མ་གོ་སྒྲུབ་ཏུ་བསྟན་པ་བཞིན་དུ་ཕན་ཚུན་དུ་དྲུག་དྲུག་བསྡུས་པས་ནའོ།",
    "དེ་འདོད་ཁམས་ཀྱི་ཉོན་མོངས་སྤོང་བྱེད་ཡིན་ལ།",
    "རྟོག་པ་བཞི་པོ་རེ་རེ་ལ་དགུ་བཞི་སོ་དྲུག་ཡོད་པ་དེ་འདོད་པ་སོགས་ཀྱི་ཁམས་གསུམ་ལ་སྦྱར་བས་དེར་འགྱུར་རོ།",
    "གལ་ཏེ་མངོན་གྱུར་སྤངས་པས་བག་ལ་ཉལ་སྤངས་ན་ཧ་ཅང་ཐལ་ཞེ་ན།",
    "གོམས་པར་བྱས་པ་ཉིད་ཀྱིས་རྒྱུ་དེ་བཟློག་པ་ན་འབྲས་བུ་རྟོག་པ་དེ་དག་རང་གི་ངང་གིས་ལྡོག་པར་འགྱུར་རོ།",
    "སྒོམ་སྤང་གི་རྟོག་པ་ལ་ཡང་སྤོང་ཚུལ་འདི་བཞིན་དུ་བལྟའོ།",
    "དེས་ན་རྟོག་པ་རྣམས་ཀྱི་དམིགས་རྣམ་གསལ་བའི་དབྱེ་བ་མཐའ་ཡས་ཀྱང་དི་དག་གི་རྩ་བ་བདེན་འཛིན་ཡིན་པས།",
    "རྟོགས་དཀའ་དང་ཤེར་འབྱུང་གིས་རྒྱན་སྣང་ལྟར་དེ་སྐྱེས་པ་ན་ཞེས་སོགས་འདིའི་མཚམས་སྦྱོར་ལ་མཛད་ཀྱང་གཞུང་འདི་ལ་མི་འགྲིག་གོ།",
    "ཕྱིན་དྲུག་རེ་རེ་ལ་གནས་ནས་གཞན་ལྔ་ལྔ་འཛིན་པར་གསུངས་པའི་ཡུམ་ལ་གནས་ནས་བསམ་གཏན་འཛིན་པའི་སྐབས་སུ།",
    "དེ་ལྟར་ན་འདི་དག་གི་བཞེད་པ་ནི།",
    "མཐོང་ལམ་རྩེ་མོ་ཐོབ་པའི་རྣལ་འབྱོར་པ་མཐོང་ལམ་པ་དེའོ།",
    "དེའི་ངེས་ཚིག་ནི་མཐོང་སྤང་གི་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པའི་འཇིགས་པ་དང་བག་ཚ་བ་མེད་པའི་ཕྱིར་ཏེ།",
    "གང་གི་ཚེ་ན།",
    "མ་རིག་པ་དང་འདུ་བྱེད་གཉིས་ནི་ཀུན་འབྱུང་གི་བདེན་པ་ཡིན་ལ།",
    "རང་རང་གི་བྱེད་ལས།",
    "གསུམ་པ་ནི་རྐྱེན་ལས་སྐྱེ་ཞིང་མི་རྟག་ཀྱང་རྒྱུ་ཐམས་ཅད་ལས་འབྲས་བུ་ཐམས་ཅད་མི་འབྱུང་གི་རང་རང་གི་སྐྱེད་པའི་ནུས་པ་དང་ལྡན་པའི་རྗེས་སུ་མཐུན་པའི་རྒྱུ་ལས་སྐྱེ་བའོ།",
    "འདི་དག་གི་རང་བཞིན་ཀྱང་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དེ་ལ་སྤྱིར་མ་རིག་པ་ལ་ཉོན་མོངས་ཅན་ཡིན་མིན་གཉིས་ཡོད་ཀྱང་གཉིས་པ་ནི་དགྲ་བཅོམ་པ་རྣམས་ལ་ཡང་མངོན་གྱུར་དུ་ལྡན་པས་སྲིད་པར་སྐྱེ་བ་ལེན་པའི་རྩ་བར་མི་འཐད་པས་དང་པོ་ཡིན་ལ།",
    "གང་གི་ཚེ་བདག་ལ་ལྷག་པར་ཆགས་པ་དེའི་ཚེ་བདག་བདེ་བར་འདོད་ཅིངསྡུག་བསྔལ་བར་མི་འདོད་དོ།",
    "བདེ་སྡུག་གི་འགྱུར་བའི་སྡུག་བསྔལ་དང་བྲལ་བ་གཙོ་བོར་བཏང་སྙོམས་ཀྱི་བདེ་བ་ལ་སྲེད་པས་ནི།",
    "དེ་ལྟར་མ་རིག་པ་གང་གིས་ལས་གང་སློང་བ་ནི།",
    "འོ་ན་འཕགས་པ་ལ་འཕེན་བྱེད་ཀྱི་མ་རིག་པ་ཡོད་པར་ཐལ་ཞེ་ན།",
    "མ་རིག་པས་བསླང་བའི་ལས་ཏེ་འདི་ལ་གསུམ་མོ།",
    "རེག་པས་ཡུལ་གསུམ་བཅད་པ་ལས་སིམ་གདུང་སོགས་ཀྱི་ངོ་བོར་སྐྱེས་པའི་མྱོང་བ་སྟེ་སྔར་ལྟར་དྲུག་གོ།",
    "གཟུགས་མེད་བཞི་ན་བཏང་སྙོམས་ལ་འདུན་པ་གཟུགས་མེད་ཀྱི་སྲེད་པ་གསུམ་མོ།",
    "ལྟ་བ་ཉེ་བར་ལེན་པ་ནི་ལྟ་ངན་རེ་གཉིས་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པར་བསྡུ་བའོ།",
    "ཡན་ལག་དང་པོ་གསུམ་སྟེ་གང་གིས་ན་མ་རིག་པའི་རྐྱེན་ཅན་གྱི་འདུ་བྱེད་ཀྱིས་སོ།",
    "གང་གིས་ན་སྲེད་པའི་རྐྱེན་ཅན་གྱི་ལེན་པས་སོ།",
    "གང་གིས་འཕེན་དང་ཇི་ལྟར་གང་།",
    "གཉིས་ཀྱི་ཡན་ལག་གཅིག་གིས་དང་།",
    "གཅིག་གིས་གཅིག་གིས་གཅིག་གིས་ནི།",
    "རྒ་སོགས་ཉེས་དམིགས་གང་གི་ཕྱིར།",
    "བརྗོད་མོད་ཀྱི་ཉེས་པ་ནི་མེད་དེ།",
    "དང་པོ་བརྒྱད་པ་དགུ་ཉོན་མོངས།",
    "ཞེས་པ་ལྟར་གསུམ་ཉོན་མོངས་པ་དང་གཉིས་ལས་དང་བདུན་སྐྱེ་བའི་ཀུན་ཉོན་ནོ།",
    "དུ་ཁ་ཕྱིར་ནི་འགྲོ་ཉོན་མོངས།",
    "ཞེས་གསུངས་པས་དེ་དང་དེའི་ཕྱིར་འགྲོ་བ་རྣམས་ཉོན་མོངས་པར་བྱེད་ཅེས་ཀུན་ལ་སྦྱར་ཞིང་ཐ་མ་གཉིས་སྐྱོ་བའི་རྒྱུར་བསྡུས་ནས་གཞན་རྣམས་རེ་རེ་ཞིང་སྦྱར་རོ།",
    "གལ་ཏེ་འདོད་པ་ལ་ཆགས་བྲལ་གྱི་བྱིས་པ་ཁམས་གོང་དུ་སྐྱེ་བའི་ལས་གསོག་པ་ན་འདོད་པའི་ཉོན་མོངས་མེད་པས་དེའི་མ་རིག་པ་འདོད་པར་མི་གཏོགས་ཤེ་ན།",
    "འདི་ལ་མཛོད་པ་རྣམས་དེའི་རྒྱུད་ལ་གོང་མའི་ཉོན་མོངས་ཡོད་པས་ས་གོང་མའི་ཉོན་མོངས་གང་ཡོད་དེས་ཀུན་ནས་བསླང་བའི་ལས་གསོག་པར་འདོད་ཀྱང་།",
    "གལ་ཏེ་ས་གཞན་གྱི་མ་རིག་པས་ས་གཞན་གྱི་ལས་ཀུན་ནས་སློང་ན་གོང་སའི་རྟེན་ལའང་འོག་སར་སྐྱེ་བའི་ལས་ཅི་སྟེ་མི་གསོག་ཅེ་ན་རྟེན་དེ་ལས་འོག་མར་སྐྱེ་བའི་ཉོན་མོངས་ཐམས་ཅད་མེད་པ་དང་ས་ཐ་དད་ཀྱིས་བཅད་པའི་རྟེན་ཁྱད་པར་ཅན་ཐོབ་པས་འོག་སའི་དམན་ལས་གསོག་པ་ལ་མི་ནུས་པས་སོ།",
    "མཛོད་པ་ལྟར་ན་ས་དེ་དང་དེར་སྐྱེ་བའི་ཉོན་མོངས་མ་སྤངས་ན་འཕགས་པས་ཀྱང་དེས་ཀུན་ནས་བསླང་བའི་ལས་འཕེན་པར་འདོད་པ་འདྲའོ།",
    "དེ་ལྟ་བུའི་ཡན་ལག་བཅུ་གཉིས་ནི་སྐྱེ་འགག་གི་རྗེས་སུ་གྲུབ་པའི་བདག་ཉིད་དུ་དངོས་པོར་སྨྲ་བ་རྣམས་འདོད་ལ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་གཞན་ཡང་འདིར་རེ་ཞིག་མ་སྨྲས་སོ།",
    "སྒོམ་ལམ་གྱི་མི་མཐུན་ཕྱོགས་སྤོང་བ་དང་སོགས་པས་ཡོན་ཏན་སྐྱེད་པ་ནི་དེ་དག་གི་རྟེན་སྒོམ་ལམ་གྲུབ་པ་སྟེ་རྟོགས་པ་སྔོན་དུ་འགྲོ་བ་སྟེ་བཏང་བ་ཡིན་ན་གོ་སླ་བས་སོ།",
    "འདི་ལ་ལེ་བརྒྱད་མར་སྦྱོར་དངོས་དང་ཐོད་རྒལ་ཉིད་ལ་ཡང་ཡར་སོང་མར་འོང་གི་མཚམས་བཅད་པ་མེད་ལ།",
    "འགོག་དང་ནས་སོང་འོངས་ཞེས་པས་ནི།",
    "སྙོམས་འཇུག་དགུ་ལ་ལུགས་མཐུན་དུ་ཡར་སོང་ཞིང་ལུགས་མི་མཐུན་དུ་མར་འོངས་པའི་སེང་གེ་རྣམ་བསྒྱིངས་ཕྲུགས་གཉིས་བསྡུས་ཏེ།",
    "དེའི་ཕྱིར་རྣམ་གཉིས་ཞེས་པ་ཐོད་རྒལ་དངོས་གཞིའི་སོང་བ་གཉིས་ལ་བྱེད་པ་དང་འགོག་པ་དང་བཅས་པའི་སྙོམས་འཇུག་དགུ་ཡར་བཅད་ནས་དེས་སེང་གེ་རྣམ་བསྒྱིངས་བསྟན་པ་འཕགས་པ་དང་ཤཱནྟི་པའི་ལུགས་སུ་འཆད་པ་ནི་ལུགས་གཉིས་ཀ་དང་མི་མཐུན་ནོ།",
    "སོང་བ་དང་།",
    "སྤེལ་བའི་སོང་བའོ།",
    "བསམ་གཏན་དང་པོ་ལས་ལངས་ནས་དེ་ཉིད་ལ་ཞུགས་ཏེ་འགོག་པའི་བར་དུ་མཐར་ཆགས་སུ་སོང་བ་སྟེ།",
    "འདི་རྩ་ཚིག་གིས་མ་ཟིན་ཀྱང་སྦྱོར་བ་ལུགས་མཐུན་དང་རིགས་གཅིག་པ་ལ་དགོངས་ཏེ།",
    "སྙོམས་འཇུག་དགུ་ལ་ལུགས་དང་མཐུན་མི་མཐུན་སྦྱར་བས་ནི་སྦྱོར་བ་དང་སོང་བ་དང་པོ་དང་།",
    "གཅིག་རྒལ་སོགས་ཀྱི་དོན་དེ་དག་ལ་འཇུག་པ་ལ་མཛད་ཅིང་དེ་ལ་ལུགས་དང་མཐུན་མི་མཐུན་གཉིས་སྦྱར་བས་ནི་སོང་བ་གཉིས་པ་དང་འོངས་པ་གཅིག་བསྟན་ཏོ།",
    "མཉམ་པར་མ་བཞག་པའི་སེམས་ཀྱིས་ཞེས་དེ་གཉིས་ཀའི་ཐོག་མར་སྨོས་པས་ཡར་འགྲོ་ལ་མཐའི་མཚམས་དང་མར་འོང་ལ་སྙོམས་འཇུག་རེ་རེའི་མཚམས་སུ་བྱེད་པ་བསྟན་ཏོ།",
    "དངོས་གཞིའི་སོང་འོང་གཉིས་ཀ་ལ་སྙོམས་འཇུག་དགུ་ལ་འཇུག་པར་གསུངས་པས་སོ།",
    "འོ་ན་སྲིད་རྩེར་ནུད་པས་ཅི་མ་ཆོག་གང་གིས་ན་སྲིད་རྩེའི་རྗེས་སུ་ཡང་འདོད་སེམས་མངོན་དུ་བྱེད་དགོས།",
    "དེས་ན་བྱང་བའི་ཚེའམ་གང་ཟག་ཁ་ཅིག་ལ་ལེ་བརྒྱད་མར་དྲངས་པ་ལྟར་འགོག་པ་ལས་འདོད་སེམས་ཀྱིས་ཀྱང་ལྡང་ནུས་མོད།",
    "དེའི་ཕྱིར་དེ་ལས་སོང་བ་དང་པོ་ལ་གནས་དགུ་སོང་བ་གཉིས་པ་ལ་བཅུ་བདུན།",
    "ཤཱནྟིས་ནི་འགོག་པ་དང་བཅས་པའི་སྙོམས་འཇུག་དགུར་རྣམ་པ་གཉིས་སུ་སོང་བ་གཉིས་དང་འོངས་པ་གཅིག་གོ།",
    "འགོག་པའི་བར་དུ་ཞེས་འགོག་པ་མཐར་བྱས་པ་སྟེ་དགུ་ལ་མཐར་ཆགས་སུ་སོང་བའོ།",
    "ཡར་འགྲོ་འདིའི་ཚེ་མཐའི་འགོག་པ་ལ་འཇུག་ནི་དགོས་ལ་སེམས་གཞན་མངོན་དུ་མ་བྱས་ན་སྙོམས་འཇུག་བརྒྱད་པོ་རེ་རེའི་རྗེས་ལ་འགོག་པ་ལ་ཞུགས་ཡོད་པས་འགོག་པ་ལས་འགོག་པས་ལྡང་བར་འགྱུར་ལ།",
    "གཅིག་རྒལ་སོང་ཞིང་འོངས་ནས་ནི།",
    "དེ་ནས་སྲིད་རྩེ་དོར་བའི་ཟག་བཅས་བདུན་དང་ཟག་མེད་བདུན་ལ་སོ་སོར་རེ་རེ་བར་དུ་བོར་བའི་སོང་འོང་གཉིས་ནི་ཉེ་སྦྱོར་རོ།",
    "དེ་ནས་ཟག་བཅས་བསམ་གཏན་དང་པོ་ནས་ཟག་མེད་གསུམ་པ་དང་དེ་ནས་ཟག་བཅས་ནམ་མཁའ་དང་དེ་ནས་ཟག་མེད་ཅི་ཡང་དུ་སོང་བ་དང་།",
    "ཝཱ་ཡ་ས་དང་པོའི་ཡ་ས་༡སྒྲ་མཚུངས་ཀྱང་བྱ་རོག་དང་འོ་ཐུག་གི་དོན་སོ་སོ་ལ་འཇུག་པ་ལྟར་རོ།",
    "སོང་ཞིང་འོངས་སོ།",
    "རྟེན་གང་གིས་ན་བྱང་སེམས་སྒོམ་ལམ་པ་རྣམས་ཀྱིས་ནིའོ།",
    "དེ་གང་ན་བསམ་གཏན་དང་པོ་ནས་བཟུང་སྟེ་འགོག་པའི་བར་དུ་སོང་ནས་དེའི་འོག་ཏུ་འགོག་པ་ནས་བཟུང་སྟེ་བསམ་གཏན་དང་པོའི་བར་དུ་འོངས་ཏེ་དེ་ལྟར་རོ།",
    "སོང་བ་དང་འོངས་པའོ།",
    "སྤེལ་བའི་སོང་བའོ།",
    "ཆེན་པོ་དག་ལུགས་དང་མཐུན་མི་མཐུན་རྣམ་གཉིས་ཀྱིས་སོང་ཞིང་འོངས་ཞེས་ཕྱིར་ལ་བཅད་ནས་འདི་བསྟན་པར་བཞེད་པ་ནི།",
    "དེ་ཐམས་ཅད་ཀྱིས་སོང་འོངས་ཕྲུགས་གཉིས་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་སྙོམས་འཇུག་རེ་རེ་དང་འགོག་པ་རེ་རེ་སྤེལ་ནས་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་གྱི་སྐྱེ་མཆེད་ཀྱི་བར་ལ་འཇུག་གོ།",
    "སུ་ག་ཏ་ཤྲཱི་ན་རེ་འདོད་སེམས་སྤེལ་པའི་ཡར་འགྲོ་བ་གཅིག་ཀྱང་ཡོད་པ་ཡིན་ཟེར་ལ།",
    "འབྲེས་འགྲོ་བ་སྤྱི་དང་སོང་འོང་གཉིས་བྱེ་བྲག་གི་སྒྲ་ཡིན་པས་འགོག་པའི་བར་དུ་ཞེས་པ་ནི་སྤྱིར་དེར་འགྲོ་བ་ཙམ་མོ་ཞེས་གསུངས་པར་གྲགས་ཀྱང་སྔར་ལྟར་གཞུང་སྦྲེལ་བས་རྩོད་པ་རང་གྲོལ་དུ་འགྱུར་རོ།",
    "དེ་ལྟར་སྒོམ་ལམ་རྩེ་མོ་བརྗོད་ཟིན་ནས་སྒོམ་སྤང་རྟོག་པ་སྟོན་ཏེ།",
    "རེ་ཞིག་གཟུང་རྟོག་དང་པོ་དགུ་གསུངས་སོ།",
    "བྱང་སེམས་ཀྱི་འཇུག་ལྡོག་གཉིས་ཀ་ཡུལ་དུ་བྱེད་ན་གང་ལ་བླང་བྱར་སོང་བ་དེ་དང་དེའི་འཇུག་བྱའོ།",
    "བྱང་སེམས་ཀྱི་འཇུག་ཡུལ་འབའ་ཞིག་ཡིན་ན་འདི་ནི་བདག་གི་འཇུག་བྱའོ་ཞེས་གཟུང་བའི་རྣམ་རྟོག་འདི་གཅིག་གམ་དང་པོའོ།",
    "ཡུལ་དགུ་པོ་དེ་ལ་རྟོག་ཚུལ་ནི་རྒྱན་སྣང་ལས་སྒྱུ་མ་ལྟ་བུར་བདག་གིས་འཇུག་པར་བྱའོ་ཞེས་དེ་ལྟར་འཇུག་པའི་ཕྱོགས་ལ་བརྟེན་པའི་གཟུང་བའི་རྣམ་པར་རྟོག་པ་ཞེས་པ་ལྟར་རོ།",
    "སྒོམ་ལམ་རྩེ་མོ་ཐོབ་ལ་ཡོངས་སུ་མ་རྫོགས་པ་ཉེར་བསྡོགས་ཀྱི་གནས་སྐབས་འདིར་སྤང་བར་བྱ་བ་ཉིད་ཀྱིས་ན་སྒོམ་ལམ་གྱི་སྦྱོར་བའི་གནས་སྐབས་ཀྱི་ཡུལ་དུ་སྤང་བྱར་ཡོད་པ་ཅན་ནོ།",
    "སེམས་མི་སྐྱེ་སོགས་རེ་རེའི་མཐར་ལ་སྦྱར་བ་དགུའོ།",
    "འདི་དག་ཀྱང་ཐེག་དམན་གྱི་ཚོགས་ལམ་སྦྱོར་ལམ་མཐོང་ལམ་སྒོམ་ལམ་མི་སློབ་ལམ་དེ་དག་ལས་བཟློག་པ་དང་ཡུལ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་གོལ་བ་བདུན་དུ་འདུ་སྟེ་དང་པོ་གཉིས་ལ་གཉིས་གཉིས་དང་གཞན་ལ་རེ་རེའོ།",
    "དེ་དག་ལ་བདག་གི་ལྡོག་བྱའོ་སྙམ་དུ་ཞེན་པའི་གཟུང་རྟོག་གཉིས་པའོ།",
    "དེ་གཉིས་ཀ་ཚོགས་པ་དང་ཚོགས་པ་དེ་བཀག་པས་རྣམ་མཁྱེན་ཐོབ་པར་འདོད་པ་གསུམ་རྟོག་པའི་ཡུལ་དུ་བྱས་ཏེ།",
    "འདི་ཉི་སྣང་གི་དགོངས་པར་ཡང་འགྱུར་ཞིང་འདོད་པ་གསུམ་ཡུལ་དུ་བྱས་ན་སློབ་དཔོན་གྱི་བཞེད་པ་ལ་ཡང་མི་རུང་བ་མི་སྣང་ངོ།",
    "ཡུལ་དགུ་པོ་དེ་ལ་རྟོག་ཚུལ་ནི་དངོས་པོར་ཞེན་པས་མ་རུངས་པར་བྱས་པའི་ཕྱིར་བདག་གི་ལྡོག་བྱའོ་སྙམ་དུ་འཁྲུལ་པའོ།",
    "སྒོམ་རྩེ་ཐོབ་པ་ཡོངས་སུ་རྫོགས་པའི་གནས་སྐབས་དེ་ན་སྤང་བར་བྱ་བ་ཉིད་ཀྱིས་ན་སྒོམ་ལམ་གྱིས་ཟག་མེད་ཀྱི་སེམས་དང་སེམས་ལས་བྱུང་བ་འཇུག་པ་སྟེ་མཇུག་གི་གནས་སྐབས་ཀྱི་ཡུལ་དུ་སྤང་བྱར་ཡོད་པ་ཅན་ནོ།",
    "འདིའི་རྩ་ཚིག་ཏུ་གཉེན་པོ་སྔོན་ལ་བྱུང་བས་ཕྱི་འགྲེལ་གཉེན་པོ་ལ་བསྙགས་ས་ཉེ་རིང་གིས་ཡིན་ནམ་སྙམ་མོ།",
    "གང་གི་ཕྱིར་ཡང་བྱང་ཆེན་ཡུམ་ལ་མི་སྤྱོད་དོ།",
    "རྟོག་པ་དེ་ནི་སྒོམ་ལམ་རྩེ་མོ་དང་སྤང་གཉེན་དུ་འབྲེལ་ཏེ་སྒོམ་ལམ་རྩེ་མོ་དེ་ཡི་རྣམ་པར་འཇོམས་པས་སོ།",
    "ཡུལ་ནི་ཀུན་མཁྱེན་གསུམ་ལ་སོགས་པ་དགུ་པོ་རེ་རེའི་མཐར་ལ་སྦྱར་བའོ།",
    "རྨོངས་པའི་ཡུལ་ལ་དེའི་མིང་གིས་བཏགས་པར་བཞེད་པས་འཕགས་པ་དང་མཐུན་ནོ།",
    "ཤེས་བྱ་གཟུགས་སོགས་དང་དེའི་དེ་བཞིན་ཉིད་དག་གི་རང་བཞིན་ཇི་བཞིན་དུ་ཡོངས་སུ་མ་ཤེས་པས་ཏེ།",
    "ལམ་གཞན་དང་མི་མཉམ་ཞིང་ཐུན་མོང་མ་ཡིན་པ་ལ་ནི།",
    "བྱང་ཆེན་ཡུམ་ཟབ་མོ་འདིའི་དོན་ལ་དཔྱད་པས་མི་རྟག་པའི་དོན་ལ་སྤྱད་པར་བྱའོ་དེ་བཞིན་དུ་སྡུག་བསྔལ་དང་བདག་མེད་དང་སྡུག་བསྔལ་ཤེས་པའི་དོན་ལ་སྤྱད་པར་བྱའོ་ཞེས་པ་སྟེ་འདི་བདེན་པ་རྣམ་པར་བཞག་པའི་དམིགས་པའོ།",
    "ཉོན་མོངས་ཀྱི་རང་བཞིན་ལ་ནི།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་བདག་གི་དོན་ཞེའམ་དོན་མ་ཡིན་ཞེས་དཔྱད་པར་མི་བྱའོ་ཞེས་སོ།",
    "སྒོམ་ལམ་རྩེ་མོའི་མི་མཐུན་ཕྱོགས་སྒོམ་སྤང་རྣམ་པ་བཞི་པོ་དེ་དག་སྤང་བར་བྱ་བ་ཉིད་དུ་དངོས་སུ་བསྟན་པས་སྤང་བྱ་དེའི་དབྱེ་བས་གཉེན་པོ་སྒོམ་རྩེ་རྣམ་པ་བཞིར་ཐ་དད་དོ་ཞེས་བྱ་བར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "སྔ་མ་མཐོང་རྩེར་བསྟན་པ་བཞིན་དུ་སྒོམ་སྤང་གི་རྣམ་རྟོག་མངོན་དུ་རྒྱུ་བརྒྱ་རྩ་བརྒྱད་སྤངས་པ་དང་དུས་མཉམ་པ་ཁོ་ནར་རྟོག་པ་དེ་དག་གིས་རྒྱུར་བསྡུས་པའི་ཉོན་མོངས་པའི་བག་ལ་ཉལ་བརྒྱ་རྩ་བརྒྱད་སྤངས་པའི་མཐུས་ཐེག་གསུམ་གྱི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པའི་རིགས་ཐམས་ཅད་བྱང་སེམས་སྒོམ་ལམ་ལ་གནས་པ་ལ་བརྟེན་ཏོ་ཞེས་བྱ་བར་བར་ཚིགས་གཉིས་དག་གིས་གསུངས་པ་ནིའོ།",
    "ས་འདིར་སྒོམ་སྤང་གི་རྟོག་པ་བཞི་བཟོད་པར་བསྟན་པ་ནི་རགས་པ་ལ་དགོངས་སོ།",
    "སྒོམ་ལམ་རྩེ་མོའི་རྗེས་ལ་བར་ཆད་མེད་པའི་ལམ་གྱི་རྩེ་མོ་སྐྱེ་བ་ཡིན་པས་སོ།",
    "ཏིང་ངེ་འཛིན་དེའི་དམིགས་པའི་ཡུལ་དང་སོགས་པས་བདག་པོ་དང་རྣམ་པ་རྣམས་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན་བར་ཚིགས་གཅིག་གིས་དམིགས་པ་སོགས་གསུངས་པ་ནིའོ།",
    "དེ་ལྟ་ན་ལམ་ཐམས་ཅད་ལ་དེ་ལྟར་ཐལ་བའི་ཕྱིར་རོ།",
    "འདིས་ནི་རྣམ་མཁྱེན་གྱི་མཐུན་རྐྱེན་ཚང་བ་དང་ལོག་རྟོག་གིས་ནི་བར་རྩེའི་སྐབས་སུ་འགལ་རྐྱེན་ཐམས་ཅད་དང་བྲལ་བར་བསྟན་པས་བར་རྩེ་རྣམ་མཁྱེན་གྱི་བར་ཆད་མེད་པའི་རྒྱུ་ཉིད་དུ་སྒྲུབ་པའི་ཕྱིར་ཡིན་ནོ།",
    "ཅི་དངོས་པོ་མེད་པ་ཞེས་པ་རི་བོང་གི་རྭ་ལྟར་གཏན་མེད་དམ།",
    "བྱིས་པ་རྣམས་ལ་ཐ་སྙད་དུ་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཞེས་བརྗོད་པ་ཙམ་དུ་བས་ཀྱི་འདིའི་རང་བཞིན་དངོས་པོ་ཡོད་མེད་སོགས་གང་དུ་ཡང་བརྗོད་པར་མི་ནུས་པས་འཕགས་པའི་རང་རིག་གི་སྤྱོད་ཡུལ་ལོ་ཞེས་བསྒྲགས་པའོ།",
    "ཁ་ཅིག་ཏུ་ནི་རང་གི་རང་བཞིན་ལ་ཟེར་ཏེ་རྣམ་པ་དམན་པ་ལ་སོགས་པའོ།",
    "དེ་དག་ལས་འདིར་ནི་རང་བཞིན་ལ་གཟུང་སྟེ་རང་བཞིན་གྱིས་ངོ་བོ་དང་རྗེས་སུ་དྲན་པ་དང་ངེས་རྟོག་གི་རྣམ་རྟོག་རྣམས་ཞི་བ་ཉིད་ཡིན་ནོ་ཞེས་ཚིག་གསལ་ལས་འཆད་དོ།",
    "རྒྱུའི་རྐྱེན་ནི་ཀུན་གཞི་ལ་ཡོད་པའི་རྣམ་བྱང་གི་ས་བོན་དང་།",
    "གང་གིས་ན།",
    "གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་མར་ངག་༡གི་བརྗོད་པའི་ལམ་མཐའ་ཐུག་པ་མེད་པར་རོ།",
    "གང་གིས་ན།",
    "རྒོལ་བ་དེ་དག་གིས་དམིགས་རྣམ་དེའི་གཏིང་དཔག་པར་དཀའ་བའི་ཕྱིར་ཏེ།",
    "གཉིས་པ་ནི་དམིགས་པ་རྣམ་པར་བཞག་པ་དེ་མི་འཐད་པ་ཉིད་དོ་ཞེས་སེམས་པ་སྟེ་ངོ་བོ་ནི་ཐེ་ཚོམ་མོ།",
    "འོ་ན་ལོག་ཤེས་སུ་འགལ་སྙམ་ན་གཞན་གྱི་ཁས་བླངས་འགལ་བས་མི་འཐད་སྙམ་པ་ཙམ་མ་གཏོགས་པ་རང་གིས་མཐའ་གཅིག་ཏུ་མ་ངེས་པ་ཉིད་ཀྱིས་ན་ཐེ་ཚོམ་སྟེ་བལྟོས་ས་ཐ་དད་ལ་ལྟོས་ནས་བློ་གཉིས་སུ་འགྱུར་རོ།",
