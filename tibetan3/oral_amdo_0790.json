    "སོགས་པའི་སྐུ་གསུམ་དག་གིས་འཇུག།",
    "དོན་འདི་ལ་ཚིག་གསལ་ལས་ཁ་ཅིག་ན་རེ།",
    "སྐུའི་གྲངས་ལ་བརྩོད་པའི་སྐབས་སུ་གཞན་དག་ན་རེ་ཞེས་པ་ལས་མ་བྱུང་ཡང་དེ་ཡང་ངོ་བོ་ཉིད་ཀྱི་སྐུ་ལ་སོགས་པའི་དབྱེ་བས་རྣམ་པ་བཞི་ཡིན་པས་ཞེས་དང་།",
    "དེ་དག་གི་དོན་ནི།",
    "གཞན་དུ་ན་བཅོམ་ལྡན་འདས་ཀྱི་གདུང་ལ་སོགས་པ་ཡང་སྐུ་ལོགས་ཤིག་པར་རྣམ་པར་བཞག་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དང་པོ་ལྟར་ན་རང་གི་ཁས་བླངས་དང་ཇི་ལྟར་མི་འགལ།",
    "དེ་ནི་ཐུབ་པའི་རྣམ་ཀུན་མཁྱེན་པ་ཉིད་ཅེས་སོགས་ཀྱིས་མངོན་རྟོགས་གཞན་བདུན་ལའང་གསུངས་པ་ལྟར་རང་རང་གི་སྐབས་ཀྱི་མངོན་རྟོགས་ཀྱི་སྤྱི་མིང་ཡིན་པས་ཤེ་ན།",
    "རིགས་པས་ཐོབ་པ་ནི་ཚིག་གིས་བཟློག་པར་མི་རུང་བ་དང་ཚིག་གཅིག་དོན་དུ་མ་ལ་འཇུག་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་ཤེས་བྱ་སྙོམས་འཇུག་གི།",
    "ཁོ་བོ་ཅག་གིས་དབུ་སེམས་ཀྱི་གཞུང་ལུགས་རྒྱ་མཚོ་ལྟ་བུའི་དོན་ཤེས་པ་ལྟ་ཞོག་ཚིག་ཙམ་ཡང་མཐོང་ངོ་ཞེས་མནའ་བོར་བའང་ཡིན་ནོ།",
    "དེ་བཞིན་ཉིད་གཞི་དུས་ནས་ཀྱང་མི་འདོད་ན་འདུས་མ་བྱས་མ་ཡིན་པར་ཐལ་བ་འདི་ཙམ་དུ་ཟད་པས་སོ།",
    "ཆེ་ལོང་ཙམ་ཞིག་སྨྲས་པས་མཐའ་མི་ཆོད་ལ་མཐའ་ཆོད་པར་བརྒལ་ཞིང་བརྟགས་ན་ཚིག་གི་ཁུར་ཧ་ཅང་མངས་པས་འཇིགས་ནས་རེ་ཞིག་མ་བྲིས་ཏེ་ཡི་གེ་ལོགས་པར་སྤྲོ་འདོད་དོ།",
    "ཉོན་མོངས་ཅན་ཡིན་གནས་གྱུར་པ།",
    "རང་གི་ངོ་བོ་ཉིད་དེ་དེ་ཡང་སྐྱེ་བ་མེད་པ་སྤྲོས་བྲལ་གྱི་ངོ་བོ་ཉིད་ནིའོ།",
    "རང་བཞིན་གྱིས་ཀྱང་དག་པ་གང་ཡིན་པའི་ཡེ་ཤེས་དེ་དག་གིའོ།",
    "བྱང་སེམས་ཀྱི་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གྱིས་སྤྲོས་པ་འགའ་ཡང་མ་གཟིགས་པའི་ཚུལ་གྱིས་རྟོགས་པའི་སྒོ་ནས་འཐོབ་པར་བྱེད་ཀྱི་གསར་དུ་བྱས་པའམ་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "ཚིག་གསལ་ལས་ནི་ངོ་བོ་ཉིད་མ་བཅོས་པ་དང་ལྷན་སྐྱེས་ཞེས་པ་མིང་གི་རྣམ་གྲངས་ཡིན་ཏེ།",
    "གཉིས་ཀྱི་བདག་ཏུ་ཐལ་བར་འགྱུར།",
    "འཇིག་རྟེན་ལས་འདས་པའི་རྗེས་ཐོབ་ཀྱི་སྣང་བ་ཡིན་གྱི་གཙུག་ལག་ཁ་ཅིག་ལས་བྱིས་པ་རྣམས་ཀྱི་ཐུན་མོང་གི་ཐ་སྙད་ལ་དེར་བསྟན་པ་ནི་མ་ཡིན་ཞེས་འཆད་དོ།",
    "ཉོན་མོངས་པ་མེད་པའི་ཏིང་ངེ་འཛིན་དང་།",
    "དེ་དག་ཉིད་སེར་པོ་དང་དམར་པོ་དང་དཀར་པོར་གྱུར་པ་དང་མཚན་མོ་སྟེང་དངུལ་ཟླ་བའི་དཀྱིལ་འཁོར་སོགས་དང་།",
    "དཀར་ཁུང་ནང་ན་ཤིང་གི་ལོ་མའི་གསེབ་ནས་ཟླ་བ་དང་ཉི་འོད་བྱུང་བས་ས་གཞི་ལ་སྐྱེད་པའི་འོད་ཀྱི་ཐིག་ལེ་ལ་ལྟ་བ་དང་།",
    "དང་པོ་ནི་སྔོ་སོགས་ཀྱི་ཁ་དོག་གི་དབྱེ་བ་དང་བྲལ་བའི་ཆུ་དྲི་མ་མེད་པ་ནམ་མཁའ་ནས་འབབ་པ་ཡོངས་སུ་དག་པའི་ཆུ་ཚགས་ལས་འཛག་པ་རྣམས་ཀྱིས་ལྷུང་བཟེད་སོགས་༡ཀྱི་སྣོད་གང་རུང་བཀང་བ་དང་།",
    "ཟད་པར་གྱི་མཚན་མ་མངོན་དུ་བྱ་བའི་ཕྱིར་གནས་ཁང་གི་རྩིག་པ་དག་སྔོན་པོ་ལ་སོགས་པ་རྣམ་པ་བཞིར་བྱའོ་ཞེས་ཀྱང་གསུངས་སོ།",
    "རྩིག་པ་རེ་ལྡེ་སྣམ་བུ་གང་རུང་གིས་གཡོགས་པའི་གནས་སུ་མཐོ་གང་སོར་བཞི་ཙམ་གྱི་བུ་ག་བཏོད་པ་མཐོང་བའི་ཡུལ་དུ་བྱས་པ་རྣམས་ཟད་པར་ཆུ་ལ་སོགས་པའི་དམིགས་རྟེན་ནོ།",
    "དུ་བ་འཐུལ་ཞིང་མེ་འབར་བ་དང་མེ་མདག་གི་ཆར་འབེབས་པ་དང་གང་འདོད་པ་དེ་སྲེག་པ་དང་།",
    "མྱ་ངན་ལས་འདའ་བ་ན་མེས་ལུས་སྲེག་པ་དང་ལྷའི་མིག་གི་ཡུལ་སྣང་བར་བྱེད་པ་དང་།",
    "ལྷའི་མིག་གི་ཡུལ་སྣང་བར་བྱེད་པ་དང་།",
    "གཟུགས་གསལ་བ་དང་གཉིད་རྨུགས་རིང་དུ་བྱེད་པ་དང་ལྷའི་མིག་གི་ཡུལ་སྣང་བར་བྱེད་སོགས་དང་།",
    "གལ་ཏེ་གཟུགས་དང་རེག་བྱ་ལ་ཟད་པར་བཞག་ནས་སྐྱེ་མཆེད་གཟུགས་ཅན་གཞན་བརྒྱད་ལ་མི་འཇོག་པ་ཅི་ཞེ་ན།",
    "དེ་ལ་དང་པོ་བཞི་ནི་ནང་རྣལ་འབྱོར་པ་རང་ལ་གཟུགས་ཅན་དུ་འདུ་ཤེས་པའི་སྒོ་ནས་ཕྱི་རོལ་གྱི་གཟུགས་ཆུང་ངུ་རྣམས་ལ་དེ་དག་གི་རྣམ་པ་དགུ་དག་ཏུ་ལྟ་ཞིང་གཟུགས་དེ་དག་ཟིལ་གྱིས་མནན་ནས་ཤེས་ཤིང་ཟིལ་གྱིས་མནན་ནས་མཐོང་དེ་ལྟར་འདུ་ཤེས་པར་གྱུར་པ་ཞེས་བྱ་བ་ནི་དང་པོའི།",
    "ཞེས་སྦྱར་ནས་ཆེ་ཆུང་གཉིས་རེ་རེར་བྱས་པ་ནི་ཕྱི་མ་གཉིས་སོ།",
    "ཕྱི་མ་བཞི་ནི་སྔར་ལྟར་གཟུགས་ཆེ་ཆུང་ལ་ལྟ་བ་ན་གཟུགས་ཅན་ཡིན་མིན་གཉིས་ཀྱི་འདུ་ཤེས་མི་བྱེད་པར་ནང་གཟུགས་མེད་པར་འདུ་ཤེས་པ་དག་ཁོ་ན་སྔོན་པོ་ནས་དཀར་པོ་དང་ཟིལ་གྱིས་མནན་ནས་ཤེས་ཟིལ་གྱིས་མནན་ནས་མཐོང་དེ་ལྟར་འདུ་ཤེས་པར་གྱུར་པ་ཞེས་བྱ་བ་རེ་རེའི་མཐར་སྦྱར་བ་བཞིའོ།",
    "སྔོན་པོ་ལྟ་བུར་སྟོན་པ་ནི་སྦྱར་འབྱུང་གི་སྔོན་པོའོ།",
    "མེ་ཏོག་ནི་ལྷན་སྐྱེས་དང་རས་སྦྱར་བྱུང་གི་དཔེའོ།",
    "བདུན་པ་ཉོན་མོངས་མེད་པའི་ཏིང་ངེ་འཛིན་ནི།",
    "སྐད་ཅིག་རེ་རེ་ལ་ཏིང་ངེ་འཛིན་གྲངས་མེད་པ་ལ་འཇུག་པའི་ཐུགས་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གསུང་ཐུགས་ཀྱི་སྤྱོད་པ་ཉེས་སྤྱོད་མཐའ་དག་གིས་ཡོངས་སུ་དག་པ་སྟེ་དེའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་འདི་ལ་ཕྱིན་ཅི་ལོག་གི་ཀུན་སྤྱོད་ངན་པ་གང་ཟག་གཞན་གྱིས་ཡོངས་སུ་ཤེས་ཀྱིས་དོགས་པའི་བསྙེངས་པའམ་འཇིགས་པས་བཅབ་པ་སྟེ་གསང་བར་བྱའོ་སྙམ་པའི་དགོངས་པ་མི་མངའ་བ་ཞེས་བྱ་བའོ།",
    "ཁ་ཅིག་སྔ་མ་དང་ཁ་ཅིག་ཕྱི་མ་ལྟར་གཉིས་ཀ་དག་ལ་ཆགས་སྡང་གཉིས་ཀས་༡དབེན་པ་ཁོ་ནར་བཏང་སྙོམས་སུ་དྲན་པ་དང་ལྡན་པར་གནས་སོ་ཞེས་བྱ་བ་རེ་རེའི་མཐར་སྦྱར་བའོ།",
    "ཉོན་མོངས་ནས་སྤངས་པས་ཏེ་དེ་ནི་ཉོན་མོངས་སྤངས་ཀྱང་མ་སྤངས་པ་ལྟར་ཀུན་ཏུ་སྤྱོད་པ་སྟེ་ཟད་པའོ།",
    "ཞེས་བྱ་བ་ནི་སྣང་མཛད་ལ་སོགས་པ་ཁ་ཅིག་གི་ཡིན་ལ་སློབ་དཔོན་ཡང་དེའི་རྗེས་སུ་འབྲང་ངོ།",
    "སྐུ་བཞིར་འདོད་པ་ལས་གཞན་སྐུ་གསུམ་དུ་འདོད་པ་དག་གིས་ནི་ཁས་བླངས་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་ལྟ་ན་ཡོན་ཏན་དེ་དག་གི་རང་བཞིན་ཡང་སྐུ་དེ་མ་ཡིན་པས་སོ་སྙམ་པའོ།",
    "ཉི་སྣང་གི་ཚིག་ཕྱི་མས་ངོ་བོ་ཉིད་ཀྱི་སྐུ་སྐུ་བཏགས་པ་བར་བསྟན་པ་ཡིན་ཞེས་ལེགས་པར་མ་སྦྱངས་པ་ཁ་ཅིག་སྨྲ་བ་ནི་ཤིན་ཏུ་བདེན་ཏེ།",
    "སྐུ་གསུམ་དུ་འདོད་པ་ལས་གཞན་སྐུ་བཞིར་འདོད་པ་དག་ན་རེ།",
    "དེ་ཉིད་ཁྱོད་ནི་སྟོང་པར་བཞེད།",
    "སྐུ་གསུམ་དུ་འདོད་པ་ཁ་ཅིག་ན་རེ།",
    "སྐུ་བཞིར་འདོད་པ་གཞན་དག་ན་རེ།",
    "ཉོན་མོངས་མེད་པ་དང་།",
    "གཞན་རྒྱུད་ལ་ཡོད་པའི་ཉོན་མོངས་པ་ཆགས་སོགས་མི་སྐྱེད་པས་ཉོན་མོངས་མེད་པ་སྟེ་འདི་ལ་གཉིས་ལས།",
    "ཉན་ཐོས་ཀྱི་ཉོན་མོངས་པ་མེད་པའི་ཏིང་ངེ་འཛིན་དང་།",
    "མཐོང་བ་མི་ཟློག་གི་མཐོང་བ་ཡོད་ཀྱང་དེ་དག་གི་ཉོན་མོངས་རྒྱུན་གཅོད་པ་ནི་དེ་བཞིན་གཤེགས་པའི་ཉོན་མོངས་མེད་པའོ་ཞེས་འཆད་དོ།",
    "ཉོན་མོངས་མེད་པ་ཀུན་རྫོབ་ཤེས།",
    "མིས་བསྐྱེད་ཉོན་མོངས་འདོད་གཏོགས་པ།",
    "རང་གི་ངང་གིས་འཇུག་པའི་ལྷུན་གྲུབ་དང་།",
    "མང་པོ་དག་གིས་དུས་གཅིག་ཞུ་ཞུས་ནས།",
    "གསུང་དབྱངས་གཅིག་གིས་སོ་སོར་ལན་ཀྱང་འདེབས།",
    "གང་གི་ཚེ་ན།",
    "གང་གིས་ན།",
    "གདུལ་བྱ་དེ་དང་དེའི་ངོར་རང་རང་གི་སྣང་བ་དང་འཚམ་པར་ཏེ་རབ་དགའ་འདུལ་པ་ལ་དྲི་ཟར་སྤྲུལ་པ་ལྟ་བུའོ།",
    "གང་གི་ཚེ་ན།",
    "ཡང་ཇི་ལྟར་ན་རྟག་པ་ཞེས་ཀྱང་བརྗོད་དེ་མི་རིགས་པར་ཐལ།",
    "འདི་དག་ཡོད་པར་འདོད་མོད་ཀྱི།",
    "དེ་ལྟ་བུ་ཡི་སྐུར་གཟིགས་སོ།",
    "གཞན་ཡང་མཚན་རྣམས་གཙོ་བོ་ཡིན་པས་རེ་རེ་ཡང་ཕྱིན་དྲུག་གི་རྒྱུ་ལས་བྱུང་བར་བསྟན་ཏེ།",
    "སྨིན་མཚམས་ཀྱི་མཛོད་སྤུ་ཁ་དོག་དཀར་བ་དང་གཡས་སུ་འཁྱིལ་བ་དང་སྤ་༡ཞིང་ཟིལ་གྱིས་མི་ནོན་པ་དང་རིང་བར་གནས་པ་དང་ཤིན་ཏུ་འཁྱིལ་ཞིང་ལེགས་པར་གནས་པ་དང་འོད་མཐའ་ཡས་པས་ཁྱབ་པ་རྣམས་རིམ་པ་ལྟར་དེ་དྲུག་གི་འབྲས་བུར་གསུངས་སོ།",
    "སོར་མོ་དང་སེན་མོའི་དཔེ་བྱད་དྲུག་ནི་ཕྱག་སོར་རིང་བའི་འཁོར་རོ།",
    "གཟིགས་པ་སྒྲིབ་མེད་དག་པ་ལ་སྤྱན་མཛེས་པར་འཛུམ་པ་ཞེས་ཟེར་རོ།",
    "ཞལ་གྱི་གཉིས་དང་ལྗགས་ཀྱི་གསུམ་དང་གསུང་གི་གསུམ་དང་མཆེ་བའི་ལྔ་སྟེ་བཅུ་གསུམ་ནི་ལྗགས་ཡངས་པ་དང་ཚངས་དབྱངས་དང་ཚེམས་ཀྱི་མཚན་བཞི་དང་རོ་བྲོ་བའི་མཆོག་མཁྱེན་པའི་སྟེ་ཇི་ལྟར་རིགས་པར་སྦྱར་རོ།",
    "གསད་པར་བྱ་བ་ནི་བཅིངས་པ་སྟེ་དེ་ལས་ཐར་བར་བྱས་པས་ཕྱག་ཞབས་ཀྱི་སོར་མོ་རིང་བའོ།",
    "ཕྱག་རིང་བ་ནི་བརླ་དྲང་བོར་བཞག་སྟེ་མ་བཏུད་ཀྱང་ཕྱག་གིས་པུས་མོའི་ལྷ་ངར་སླེབ་པའོ།",
    "ཁང་བཟང་གི་སོགས་གཞལ་ཡས་ཁང་གྱ་ནོམ་པའོ།",
    "སྤུ་རེ་རེ་ནས་གཡས་སུ་འཁྱིལ་བ་ནི་བ་སྤུའི་ཁུང་བུ་རེ་རེར་སྤུ་གཉིས་གཉིས་མེད་པར་འཁྱིལ་བའོ།",
    "ཐལ་གོང་རྒྱས་པ་ནི་དཔུང་མགོ་ཕན་ཚུན་གྱི་བར་རྒྱས་པ་ལ་དགོངས་རྒྱན་དང་ཐལ་གོང་བྲང་ལ་དག་ལྡན་ལས་ཏེ།",
    "ཤིང་ནྱ་གྲོ་ད་ལྟར་ཆུ་ཞེང་གབ་པ་ནི་འདོམ་གྱི་ཕན་ཚུན་གྱི་རྩེ་མོ་ནས་གཅལ་པ་ཇི་ཙམ་པ་ཞབས་ནས་སྤྱི་བོའི་བར་ལའང་དེ་ཙམ་པའོ།",
    "སྙན་གྱི་བུག་པ་དང་དཔྲལ་བའི་སྐྲ་མཚམས་ཀྱི་བར་ལྗགས་ཀྱིས་རེག་པ་ལ་དགོངས་རྒྱན་ལས་སོ།",
