    "སྒྲུབ་ཐབས་གསུམ་ཡང་སྟེང་ལོའི་ལུགས་ཀྱི་དང་པོར་ཕྱི་ནང་གསང་གསུམ་གྱི་སྒྲུབ་ཐབས་བྱུང་བ་དེ་དག་གམ་དེ་དག་གི་རྩ་བ་ལ་དགོངས་པ་གང་རུང་ལས་ཕལ་ཆེར་ཕྱི་མ་ཉིད་ཡིན་པ་འདྲའོ།",
    "ལས་ཀྱི་སྦྱོར་བ་ཆེན་པོ་ངེས་པ་དྲུག་གིས་གཏན་ལ་ཕབ་པ་ཙ་མིས་མཛད་ཞེས་སྣང་བ་དེ་རྩ་བར་གྱུར་པ་ཡིན་འདྲ་སྟེ།",
    "འོན་ཀྱང་ཞིབ་མོ་སླར་བརྟག་གོ།",
    "ཡུམ་སྐོར་ནི་བྱང་བཟང་གིས་མཛད་པའི་ཡུམ་སྐོར་དེ་ཡིན་ནམ་སྙམ། ཞང་ཞུང་ལུགས་ལ།",
    "བྱ་གདོང་གསུམ་གྱི་གཅིག་བདུད་མོ་བྱ་གདོང་།",
    "དེ་ལྟར་དཔལ་མགོན་ཕྱག་བཞི་པའི་སྒྲུབ་ཡིག་གི་མཐའ་གཅོད་ངེས་པའི་དཔལ་སྟེར་ཞེས་པ་རང་ཉིད་ཀྱི་རྟོག་དཔྱོད་སྤེལ་བའི་ས་བོན་དུ་སྤེལ་བ་རེ་ཞིག་གོ། །",
    "གང་གིས་སྒྱུ་འཕྲུལ་ཁྲོ་བོའི་སྐུར་བཞེངས་པ།",
    "བསྙེན་ཐབས་དངོས་ཀྱི་ས་བཅད་དང་གསུམ་མོ།",
    "ཐབས་ཤེས་གཙོ་ཆེ་ཆུང་གི་ཁྱད་པར་ལས།",
    "རྡོ་རྗེ་འཆང་གི་རྒྱུད་དང་བདུན་ཡོད་པ་ལས།",
    "ཧེ་རུ་ཀའི་རྒྱུད་ལ་ཡང་འཁོར་ལོ་བདེ་མཆོག་གི་རྒྱུད།",
    "འདི་འཁོར་ལོ་བདེ་མཆོག་གི་རྒྱུད་ཡིན།",
    "འདི་ཆ་མཐུན་མགོན་པོ་སྔོན་བྱུང་གི་རྒྱུད་ཡིན་པ་དང་།",
    "སྟན་འདིར་བདག་གི་ལུས་འདི་སྐམ་པའམ།",
    "ཁ་ཅིག་གིས་མགོན་རྒྱུད་དུ་དུར་ཁྲོད་དང་རི་རབ་ཀྱི་ཟོམ་ལ་སོགས་པར་གསུངས་པ་ཡོད་སྙམ་ན།",
    "ཨིནྡྲ་བྷུ་ཏི་སོགས་སློབ་དཔོན་མང་པོས་གདམས་པ་དེ་ཉམས་བཞེས་མཛད་པས་བདུད་ཀྱི་ཚོགས་ཕམ་པར་བྱེད་ཅིང་མཆོག་གི་གོ་འཕང་ཚེ་གཅིག་ལ་མངའ་བརྙེས་ཐོབ་པའི་གྲུབ་ཐོབ་མང་པོ་བྱོན།",
    "སྒྲུབ་ཐབས་དངོས་ཀྱི་ས་བཅད་དང་གསུམ་མོ།",
    "བདེ་མཆོག་གི་རྒྱུད་ཡིན།",
    "དང་པོ་སྔོན་འགྲོ་ལ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པ་གཉིས།",
    "དང་པོ་ཐུན་མོང་གི་སྔོན་འགྲོ་ལ་ཡང་།",
    "གཉིས་པ་ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོ་ལ།",
    "རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཅེས་པ་ནས་སྤྱི་བོར་ཐིམ་པར་གྱུར་ཞེས་པའི་བར་ལ་བྱེད།",
    "དེ་ཡང་ཇེ་ཕྲར་གྱུར་པས་དྲན་རིག་གི་ངང་དུ་མཉམ་པར་བཞག་པ་དེའོ།",
    "མཉམ་བཞག་དེ་ལས་སྐད་ཅིག་གི་སྔར་བཞིན་བཞེངས་ནས།",
    "ཨོཾ་དཀར་པོ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཞེས་པ་ནས་ནང་ཞག་གི་རྒྱ་མཚོ་ཞེས་པའི་བར་ལ་བྱེད།",
    "དེའི་ནང་དུ་ཚུད་ཅིང་ནས་ནང་ཁྲག་གི་རྒྱ་མཚོ་ཞེས་པའི་བར་ལ་བྱེད།",
    "དང་པོ་ནི་ཉི་མའི་གདན་དང་འཁོར་གནས་ཐམས་ཅད་དུ་ཧཱུྃ་མཐིང་ནག་འབར་བ་རེ་ཞེས་པ་ལ་བྱེད།",
    "ཐུན་མོང་ཁྱད་པར་བླ་ན་མེད།",
    "ཨོཾ་བཛྲ་མཧཱ་ཀཱ་ལ་ཞེས་པ་ནས་ན་མོ་ན་མ་ཧཱུྃ།",
    "རོལ་མོར་འབུལ་ཞེས་པའི་བར་ལ་བྱེད།",
    "ཨ་མྲྀ་ཏ་པཱུ་ཛ་ཁ་ཧི་ཞེས་པའི་བར་ལ་བྱེད།",
    "དེ་ལ་ཐུན་མོང་རྫས་ལ་བརྟེན་ནས་ཐུགས་དམ་བསྐང་བ་དང་།",
    "བསྟོད་ཕྲེང་གིས་བསྐང་བ།",
    "གཉིས་པ་བསྟོད་ཕྲེང་གིས་བསྐང་བ་ནི།",
    "གསུམ་པ་མཆོད་ཕྲེང་གིས་བསྐང་བ་ནི།",
    "གདུགས་ཕྱོགས་བླ་རེ་རྒྱལ་མཚན་འཕན་ཕུར་གདུགས།",
    "རང་རང་སྲོག་གིས་ལེགས་བསྡམས་བླ་རྡོ་ཡིས།",
    "ཟབ་མོ་རྫོགས་རིམ་གྱིས་བསྐང་བ།",
    "ཕྱི་ནང་སྦྱིན་སྲེག་གིས་བསྐང་བ་དང་དྲུག་ལས།",
    "འཇམ་མགོན་བུདྡྷ་བཛྲ་ཡིས་མཛད་པའི་བསྐང་བའི་གསལ་བྱེད་དུ་སྣང་ངོ།",
    "བདག་གི་རོགས་གྱིས་དགྲ་བོ་བསྒྲལ་བར་མཛོད།",
    "ཧཱུྃ་ལས་དམ་ཚིག་གི་ཕུར་པ་ཞེས་པ་ནས།",
    "དུག་གི་རླངས་པ་འཐུལ་བ་ཞིག་ཏུ་གྱུར་ཞེས་པའི་བར་ལ་བྱེད།",
    "ཨོཾ་མ་ཧཱ་ཀཱ་ལ་གིངྐ་ར་ཞེས་པའི་བསད་སྔགས་རྫོགས་པའི་བར་ལ་བྱེད།",
    "མ་རྡོ་རྗེ་བཙུན་མོ་ཁྲོས་པའི་གཟུགས།",
    "དེ་ནས་ས་བཅད་དེ་དག་གི་གྲངས་སུ་མེད་ཀྱང་ཐ་མར་གཏོར་མ་འབུལ་བ་ནི།",
    "གང་གིས་མཛེས་པའི་མཚར་བྱས་དེ་དང་དེར།",
    "གཏོར་འབུལ་ཀཱ་རི་ཀའི་སྐབས་སུ་ཕོའི་གཡས་དང་མོ་གཡོན་དུ་བསྐྱེད་པ་ཡིན་ནོ།",
    "མགོན་པོ་ཡི་དམ་དུ་སྒྲུབ་པ་གཙོ་རྐྱང་གི་མངོན་རྟོགས་ཁྱེར་བདེ་བ་བཞུགས་སོ།",
    "སྤྲོ་ན་བསྟོད་པ་རྐང་བརྒྱད་ཚར་ཅི་ནུས་རེ་འདོན།",
    "རྣམ་མཁྱེན་ཉམས་དགའི་གྲོང་གི་དཔལ་སྤྱོད་ཤོག།",
    "དམངས་ཁྲོད་ཀྱི་ལ་གཞས་དང་མགུར་མོ་གཏམ་དཔེ་གཅེས་བཏུས།",
    "དམངས་ཁྲོད་ཀྱི་ལ་གཞས་དང་མགུར་མོ་གཏམ་དཔེ་གཅེས་བཏུས།",
    "སྤྱི་ལོ་༢༡ལོར་ཁོང་རང་ཉིད་ཀྱི་མོས་པ་དང་།",
    "རང་རེའི་ཁ་བ་རི་བོའི་ན་གཞོན་མང་པོ་ཞིག་ད་དུང་སོས་དལ་བག་ཕེབས་ངང་རྐུ་ཇག་དང་ཤོ་ཆང་ལ་གཡེང་བཞིན་ཡོད་པ་དང་།",
    "རྩེད་མོ་ཅི་བྱས་གླུ་རེད་ཅེས་གོ་ཐོས་བྱུང་བས་སེམས་ཤིན་ཏུ་དགའ་ཡང་དོན་དངོས་དེ་ལྟར་ག་ལ་བདེན་ཏེ།",
    "ལོ་ན་ཅུང་མཐོ་བའི་རྒས་རྒོན་འགའ་ལས་གསར་སྐྱེས་གཞོན་ནུ་རྣམས་ནི་གླ་དང་གཏམ་དཔེ་ལ་ཆ་རྒྱུས་དབེན་འདུག་རེད།",
    "མགུར་མོ་སོགས་ཀྱང་ཉམས་བཞིན་པ་དངོས་སུ་རྟོགས་པས་རང་སེམས་ཤིན་ཏུ་ཕངས།",
    "ངལ་བ་དང་དུ་བླངས་ནས་སྦྲ་ནག་རེ་རེའི་སྒོ་ཁ་ནས་གཏམ་དཔེ་རེའམ་ལ་གླུ་རེ་སློང་ནས་ལ་ལུང་མང་པོ་ཞིག་དམངས་ཁྲོད་ཀྱི་ལ་གཞས་དང་མགུར་མོ་གཏམ་དཔེ་གཅེས་བཏུས།",
