    "བསམ་པའི་རེ་བ་གང་བའི་མཆོག་སྦྱིན་མཛོད།",
    "གོང་གི་རྒྱལ་པོ་བཞིའི་སྔགས་ཤམ་དུ་ཡེ་དྷརྨ་དང་སུ་པྲ་ཏིཥྛ་སོགས་ཀྱི་མེ་ཏོག་འཐོར་ཞིང་བརྟན་བཞུགས་བྱ།",
    "ཀྱི་བར་བསྙེན་པའི་མན་ངག་གི་གཞུང་བཞིན་དང་།",
    "ཅེས་བརྗོད་ཅིང་བསམས་ལ་རུ་ཙིར་སོགས་འགྱུར་སྔགས་ཟབ་མོའི་རིགས་དང་ཡེ་དྷར་ཉེར་གཅིག་གམ་བདུན་བཟླས་པ་ཕུས་བཏབ།",
    "བཟླ་དུས་རང་གི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་མཐིང་ཁ་ཟེར་གྱིས་འཕྲོས་པ་ཞལ་ནས་ཐོན།",
    "འཁོར་སྔགས་རྣམས་ཀྱང་ཚར་གསུམ་རེ་ཙམ་བཟླས་ལ་དབྱངས་གསལ་དང་ཡིག་བརྒྱ་ཚར་གསུམ་སོགས་ཅི་ནུས་སུ་བརྗོད།",
    "དེ་ཡང་བསྙེན་པ་ཚུགས་པའི་ནུབ་མོའི་ཐུན་དང་པོ་དགོང་ཐུན་ནམ་སྲོད་ཐུན་རྣམས་གང་རུང་ལ་འཛུགས་པས་ཕྱག་ལེན་དུ་སྣང་།",
    "སྲོད་ཐུན་ལ་འཛུགས་ན་འདི་ཉིད་དུ་འོག་གི་ཚོགས་ལས་མན་ཆད་འཐུས་པས་འགྲུབ་ཅིང་།",
    "དགོང་ཐུན་ལ་འཛུགས་ཚེ་ཐུན་འདིའི་མཐར་གཏང་རག་གི་མཆོད་བསྟོད་བསྡུས་པ་ཡིག་བརྒྱ་བཟོད་གསོལ་རྣམས་བྱས་ལ་གྲོལ།",
    "ཐུན་རྗེས་མའི་སྐབས་བདག་བསྐྱེད་སྐད་ཅིག་གིས་གསལ་བཏབ་ལ་མངོན་རྟོགས་ནས་བཟུང་བཟླས་པའི་བར་གོང་བཞིན་སོང་རྗེས་ཚོགས་བྱིན་བརླབས་ནས་བསྟབས་པའི་བར་དཀྱུས་བཞིན་བྱ།",
    "བར་འདིར་སྒེར་གསོལ་གཞི་བདག་གཏོར་བསྔོ་སོགས་དགོས་ན་བྱ་ཞིང་ཚོགས་ལྷག་བཏང་།",
    "གཏང་རག་གི་མཆོད་བསྟོད་ཡིག་བརྒྱ་བཟོད་གསོལ།",
    "འདིར་ཉིན་མོའི་དགེ་སྦྱོར་ཁྲིགས་ཆགས་གཞན་ཡོད་ན་བྱ།",
    "ཤུ་ནྱ་ཏཱ་ནས་བཟུང་མཇུག་གི་བར་གོང་དང་འདྲ།",
    "ཐུན་རྗེས་མ་སྲོད་ཐུན་ལ་ཡང་གོང་ལྟར་ལ་མཇུག་གི་ཆོ་ག་རྣམས་རྒྱས་པར་བྱ།",
    "དེ་ལྟ་བུས་ཉིན་རེ་བཞིན་ཁྲིགས་ཆགས་འཆུགས་མེད་བྱ་ཞིང་།",
    "དུས་བསྙེན་ཟླ་བ་དྲུག་གི་བར་དུ་འབད་པར་བྱ་ལ།",
    "གོང་གི་འཕྲོར།",
    "སྔགས་ནི་སྟོང་ཕྲག་བཅུ་དག་གིས།",
    "བཟླ་བར་འདོད་ན་ཡུམ་སྔགས་དང་ལས་སྔགས་ལ་ཁྲི་བཞི་ཙམ་དང་མན་ཆད་ལ་ཁྲི་རེ་ཙམ་བཟླས་ཀྱང་རུང་ངོ།",
    "ལྷ་གཞན་རྣམས་ཀྱི་སྔགས་ལའང་གཤམ་བུ་དེ་ཉིད་བཏགས་པས་བདུན་ཙམ་རེ་བཟླ།",
    "ནང་པར་གཏང་རག་གི་ཚོགས་གཏོར་གསར་པ་རྒྱ་ཆེན་པོ་དང་དངོས་གྲུབ་ཀྱི་རྫས་ཅི་འབྱོར་བ་བཤམས་ལ།",
    "ཐུགས་གསུང་གི་ལྷ་ཚོགས་རྣམས་ཀྱི་གནས་གསུམ་ནས་འོད་ཟེར་དཀར་དམར་མཐིང་གསུམ་ལྷ་སྐུ་ཡིག་འབྲུ་ཕྱག་མཚན་གྱི་ཚོགས་སྤྲོས་པ་རང་གི་གནས་གསུམ་དུ་ཐིམ་ནས་སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ་ཐོབ་ཅིང་སྐུ་དཀྱིལ་གྱི་ལྷ་ཚོགས་རྣམས་ཀྱི་རང་རང་གི་རིགས་དང་རྗེས་སུ་མཐུན་པའི་དངོས་གྲུབ་བསྩལ་བར་བསམས་ལ།",
    "དངོས་གྲུབ་ཀྱི་རྫས་རྣམས་དང་ཚོགས་ལ་ལོངས་སྤྱོད།",
    "བསྙེན་པའི་སྐབས་འདིར་ངང་ཐུང་མི་བྱ་བར་ལུས་སེམས་ཁོང་སློད་ལ་ཟོ་དལ་བར་བྱ་ཞིང་མ་ཡེངས་པའི་འདུན་པ་རྩེ་གཅིག་པས་ཐུན་བཞིའམ་གཉིས་སུ་འབད་ཅིང་རྟགས་མཚན་བཟང་པོ་ལ་དགའ་བྲོད་དང་རློམ་སེམས་ངན་པ་ལ་སྐྱོ་འཇིགས་བསྲུན་སྣང་སྡུག་སྣང་མི་བྱ་བར་དགེ་སྦྱོར་གྱི་ཐོག་ཏུ་རོ་མཉམ་མོ།",
    "ནང་མ་པདྨ་འདབ་མ་བརྒྱད་པའི་ཟེའུ་འབྲུར་ཉི་མའི་གདན་དང་འཁོར་གནས་ཐམས་ཅད་དུ་རང་གི་ཐུགས་ཀ་ནས་འཕྲོས་པའི་ཧཱུྃ་མཐིང་ནག་འབར་བ་རེ།",
    "དེང་སང་སྒྲུབ་པ་འདྲ་འབག་ཙམ་མོས་པ་ལམ་བྱེད་ཞག་བདུན་ཙམ་རེ་ལས་མི་མཛད་གཤིས་ལོང་ཆེར་མི་ཡོང་འདུག་པ་བསྙེན་ཐབས་འདི་ཉིད་སྔོན་ནས་ལོགས་སུ་བྱ་དགོས་པས་མདུན་དཀྱིལ་རས་བྲིས་རྡུལ་ཚོན་སོགས་མི་དགོས།",
    "འདི་ལྟར་ན་སྐབས་འདིར་གོང་གི་སྲོག་སྔགས་བཙུན་པ་ཉིད་ས་ཡ་གཅིག་སྟེ་འབུམ་ཕྲག་བཅུ་བཟླས་པས་གྲངས་བསྙེན་རྫོགས་པ་ཡིན་ལ།",
    "ཞེས་གསུངས་པའི་དོན་དུ་བཞེད་ལ་འདི་གསུམ་དཀྱུས་ཐོག་གཅིག་ཏུ་འགྲུབ་ན་ཆེས་ལེགས་མོད།",
    "དེའི་ངང་ལས་དུར་ཁྲོད་ཆེན་པོའི་གཞལ་ཡས་ཁང་གི་དབུས་སུ་པད་ཉི་དང་རོའི་གདན་ལ།",
    "ཧཱུྃ་ལས་རྡོ་རྗེ་གྲི་གུག་ཧཱུྃ་གིས་མཚན་པ་ལས་འོད་འཕྲོས།",
    "རང་ཉིད་སྐད་ཅིག་གི་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ཆེན་པོ་ནས་ཡབ་དང་རྡོ་རྗེ་པདྨ་གཉིས་སུ་མེད་པར་སྙོམས་པར་ཞུགས་པའི་སྤྱི་བོར་ཨོཾ།",
    "ཧེ་རུ་ཀཱ་དཔལ་མཆོག་གི་རྣམ་འཕྲུལ་ཁྱོད།",
    "ཐུན་བཞི་རེ་ཙམ་འགྲོ་བ་བཟླས།",
    "ཡིག་བརྒྱ་བཟོད་གསོལ་ནས་རང་ལ་བསྡུས་རིལ་འཛིན་རྗེས་གཞིག་གི་རིགས་ཀྱིས་རྫོགས་རིམ་དུ་བསྡུས།",
    "དེ་ལྟར་བསྙེན་པ་སོང་ནས་སྒྲུབ་པ་ནི།",
    "བསྙེན་པ་སོང་ནས་རྒྱུན་གྱི་གཏོར་བསྔོས་རྒྱུན་བསྙེན་གྱི་བསྒྲུབ་པ་ལྟ་བུ་ཡིན་པས་བཟླས་པ་བྱུང་ན་ལེགས་པས།",
    "དེ་ཡང་བདག་ལྷན་སྐྱེས་ཀྱི་ཞལ་ནས་སྔགས་ཕྲེང་ཐོན་མགོན་པོའི་ཞལ་ནས་ཐུགས་ཀར་འཁོར་ཐུགས་ཀ་ནས་བདག་གི་ཐུགས་ཀར་འོང་ཞལ་ནས་མགོན་པོའི་ཞལ་དུ་ཞུགས་པ་སོགས་དང་།",
    "མགོན་པོའི་ཐུགས་ཀ་དང་མགོན་པོའི་ཐུགས་ཀ་ནས་བདག་གི་ཞལ་དུ་ཞུགས།",
    "དེ་ཡང་བདག་གི་གདོན་བགེགས་སོགས་བསལ་བར་དམིགས་པ་ལགས།",
    "དེ་ལྟར་གཙོ་བོར་བརྒྱ་ཙམ་རེ་དང་།",
    "དགེའོ། ། མགོན་པོ་ལྷ་མང་ནང་སྒྲུབ་ཁྱད་པར་བའི་བསྙེན་ཡིག་རེག་ཟིག་མའོ།",
    "སྒྲུབ་ཁང་གི་ཕྱོགས་བཞིར་རམ།",
