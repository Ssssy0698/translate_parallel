    "མི་ཧྲེང་སོགས་ཚང་མར་ལྟ་རྟོག་ཞུ་རྒྱུ་བཅས་ནི་ས་སྲུང་གི་ལས་འགན་ཡིན།",
    "ཕ་མ་སྤུན་མཆེད་དགའ་ཉེ་རྣམས་ངོ་མཇལ་དགའ་སྐྱིད་ངང་གཞིས་སུ་ཟླ་བ་གཉིས་ཙམ་སོང་མཚམས།",
    "གྲོ་མོ་ས་སྲུང་གཞིས་རྩེ་དང་རྒྱལ་རྩེ་དམག་སྒར་གཉིས་ལོ་གསུམ་རེས་མོས་ལྡིང་དམག་༢༦ རེ་བརྗེ་ལེན་དུ་འགྲོ་དགོས་ལྟར།",
    "མདའ་དཔོན་མུ་བྱ་དང་སྐུ་ངོ་རུ་གསུམ་པ་འབུད་སྒང་པ་བསམ་གྲུབ་ཚེ་རིང་ནས་བཀའ་ཡིག་ཕེབས་པ་ལྟར།",
    "ལྡིང་དཔོན་སུ་འགྲོ་རྒྱན་རྒྱག་མིན་པར་གུས་པས་བཀའ་ངོ་ལྡོག་མེད་ངོ་བསྐྱོད་བཀའ་གསུང་དང་ལེན་ཞུས་དོན་ལོ་གསུམ་ནས་བརྗེ་ལེན་གནང་རྒྱུའི་ཞལ་བཞེས་ཐོབ་སྟེ་གུས་ལྡིང་དམག་༢༦ གཞིས་རྩེ་ནས་གྲོ་མོར་བསྐྱོད།",
    "སྐུ་ཚབ་བསམ་ཕོའི་ཞབས་ཁོངས་ཕྱག་མཛོད་སྨོན་མདའ་ཟེར་བ་བཞུགས་འདུག་ས་སྲུང་གསར་རྙིང་རྩིས་སྤྲོད་ཟིན་རྗེས་ཕག་རི་ཤོ་ཁང་གི་བལ་དང་།",
    "གྲོ་སྤྱིའི་སྐུ་ཚབ་ཐུན་མོང་ནས་འགན་བཞེས་གནང་དགོས་པ་བཞིན།",
    "ཚོང་པ་སུ་ཐད་ནས་ཚོང་པ་གཞན་གྱི་དོ་པོ་བདལ་ལེན་བྱེད་རྐྱང་གིས་གཞུང་གི་རྫས་མདེལ་བདལ་གླར་ལེན་མཁན་མེད་པས།",
    "སྐབས་དེར་གུས་པར་སྒང་ཏོག་ནས་དྲེལ་པའི་ཐོག་ཐེངས་རེར་འོར་འདྲེན་དགོས་པའི་བཀོད་ཁྱབ་བྱ་རྒྱུའི་འགན་དཀྲི་གནང་བ་ལྟར།",
    "མཛོད་སྦུག་གི་སྐུ་ཆས་གསེར་དངུལ་རྣམས་འབྲས་ལྗོངས་སུ་འོར་འདྲེན་ཞུས་ཏེ་བསྲུང་བྱ་བོད་དམག་བཞི་ཟླ་བ་གསུམ་རེས་འཁོར་གྱིས་བཞག་པ་དང་།",
    "དེ་མཚམས་བོད་རྒྱ་ཞི་ཆིངས་འགྲིགས་པ་རེད་ཅེས་རྒྱ་དཔོན་གཅིག་དང་།",
    "གུས་ལྡིང་དམག་རྣམས་ལ་གཟིགས་བཟོས་བྱིན་རྟེན་དང་།",
    "ཕྱག་དངུལ་དངུལ་སྲང་༡༥ དམག་བྱིངས་རེར་བྱིན་རྟེན་དང་།",
    "དངུལ་སྲང་༥ རེ་གསོལ་རས་སྩལ་བ་དང་།",
    "གཞུང་གི་ལས་དོན་ཇི་བསྒྲུབས་སོགས་ཀྱི་སྐོར།",
    "འཛམ་གླིང་གི་སྐད་རིགས་ས་ཁྲ།",
    "བོད་རང་གི་ཡི་གེའི་བྱུང་བ་དང་འཕོ་འགྱུར་ཏོག་ཙམ་གླེང་བ།",
    "རང་རེ་གངས་ཅན་བོད་པ་ཚང་ལ་ཆེས་སྔ་མོའི་དུས་ནས་ཐུན་མིན་གྱི་བོད་སྐད་འཐུས་ཚང་ཞིག་ཡོད་སྟབས་དུས་ཚོད་ངེས་ཅན་ཞིག་གི་རིང་ལ་རང་རིགས་ཀྱིས་རང་སྐད་བསྐྱངས་པ་དང་།",
    "འདི་ནས་ཡར་བརྩིས་པའི་མི་ལོ་སྟོང་ལྷག་གི་ཡར་སྔོན་སྟེ་ཕྱི་ལོའི་དུས་རབས་བདུན་པའི་ནང་མི་བོ་ཆེ་བོད་རྒྱལ་སོ་གསུམ་པ་སྲོང་བཙན་རྒམ་པོའི་སྐུ་རིང་ལ་བློ་རིག་འགྲན་ཟླ་དང་བྲལ་བའི་བློན་ཆེན་ཐོན་མི་སམ་བྷོ་ཊ་ཞེས་མཚན་གྱི་གྲགས་པ་གོ་ལའི་ཁྱོན་ན་འབར་བ་གང་དེ་ཉིད་ཀྱིས་བོད་རང་གི་སྐད་ལ་གཞི་བཅོལ་ཞིང་གུཔྟའི་ཡི་གེ་སྤྱིར་བོད་ཡིག་གང་ལ་དཔེ་བྱས་མིན་གྱི་སྐོར་ནས་བཞེད་ཚུལ་མི་མཐུན་པ་དུ་མ་ཡོད་དེ།",
    "ཛ་མཐལམ་དང་།",
    "བློ་རྣལ་མས་དཔྱད་པ་བཏང་བ་ཡིན་ན་བོད་རང་གི་སྐད་དང་མཐུན་པའི་ཁྱད་ཡོན་ཅན་གྱི་ཡི་གེ་འཐུས་སྒོ་ཚང་བ་འདི་ནི་ཐོན་མིས་རྒྱ་གར་གྱི་ཡི་གེ་ལ་དཔེར་བྱས་ནས་གསར་དུ་བཟོས་པ་ཁོང་ཉིད་ཀྱི་གསུང་ལས་རྒྱ་ཡིག་ལྔ་བཅུ་ཐམ་པ་ལས།",
    "དཀའ་མོའི་ཚེགས་དང་དཀོན་མོའི་རྒྱུ་ལ་མི་འཛེམ་པར་ཡི་གེ་བཟོ་བའི་ངལ་བ་ཆེན་པོ་དེ་འདྲ་དང་དུ་བླངས་ནས་བློན་ཆེན་གང་མང་ཞིག་གི་སྐུ་སྲོག་ཀྱང་ཤོར་བར་གྲགས་པ་དང་།",
    "རྒྱལ་པོ་ཁོང་གིས་ཀྱང་ཐོན་མི་སམ་བྷོ་ཊ་དགའ་དད་ཆེན་པོས་གཙུག་ཏུ་བཀུར་ཞིང་།",
    "བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་བརྒྱད་གིབར་བབས་པ་དང་།་",
    "གཉིས་པ་རྟགས་ཀྱི་འཇུག་པའི་སྐབས་ཏེ་བསྟན་བཅོས་བརྒྱད་ཀྱི་ནང་གི་དྲུག་པའོ་ཞེས་པར་དཔགས་ན་གཞུང་འདི་གཉིས་ཐོན་མིས་བརྩམས་པའི་བསྟན་བཅོས་བརྒྱད་ཀྱི་དང་པོའི་ལྔ་པ་དང་།",
    "དེ་ལྟ་ན་བསྟན་བཅོས་རེ་རེ་ལའང་སྐབས་མང་དུ་ཡོད་པར་མངོན་ནོ་ཞེས་ཐུགས་ཕངས་ཆེན་པོས་དཔྱད་པ་སྣ་ཚོགས་བཏང་ཡོད་ནའང་།",
    "དཔྱད་པ་ག་ཙམ་བཏང་ཡང་རྙེད་དུ་མེད་པའི་འདས་དོན་ཞིག་ཏུ་སོང་ཙང་།",
    "བོད་ཀྱི་བརྡ་སྤྲོད་ཀྱི་ཕྱི་མོར་གྱུར་པ་སུམ་རྟགས་ཀྱི་རྩ་བ་གཉིས་པོ་གཞིར་བཟུང་ནས།",
    "གོ་སླ་ཞིང་འཇུག་བདེ་བའི་ཕྱིར་དུ་ལྗགས་རྩོམ་དང་རྩོམ་སྒྲིག་གི་མཛད་པ་རྒྱ་ཆེར་བསྐྱངས་ནའང་།",
    "ལྷག་པར་འཐུས་སྒོ་ཚང་བ་དང་ཞིབ་བསྡུར་གྱི་རྒྱུ་ཆ་རབ་ཏུ་དཀོན་ཕྱིར་སྦྱང་འདོད་ལྡན་པ་ལ་རིག་གཞུང་གིས་སྟོང་པའི་ཆ་དང་།",
    "རིག་གཞུང་ལ་རྒྱུད་འཛིན་གྱི་སྟོང་པའི་ཆ་ཞིག་ངང་གིས་བྱུང་ཞིང་རིམ་པས་ཆེས་ཆེར་འགྱུར་གྱིན་ཡོད་པ་ནི་དོན་དངོས་ཡིད་ཀྱི་སྐྱོ་འོས་པའི་གནས་ཚུལ་ཞིག་གོ།",
    "གིས་ལོ་མང་པོའི་རིང་ལ།",
    "འཚོལ་བསྡུ་དང་རྩོམ་སྒྲིག་གི་བྱ་བ་དང་དུ་བླངས་ཤིང་།",
    "བོད་མི་རིགས་ཀྱི་རིག་གཞུང་སྤྱི་དང་ལྷག་དོན་གནའ་དཔེ་འཚོལ་སྒྲིག་གི་ཕྱོགས་ལ་ཕྱག་ལས་རྒྱ་ཆེར་གནང་བཞིན་པའི་ཤེས་འཇོན་གཉིས་ལྡན་གྱི་མི་སྣ་དག་དང་།",
    "རླབས་ཆེན་ལས་སྒྲུབ་ཁང་འགའ་ཞིག་གི་ཐུགས་ཁུར་དང་རྒྱབ་སྐྱོར་ལ་བརྟེན་ནས།",
    "དག་ཡིག་གི་སྐོར།",
