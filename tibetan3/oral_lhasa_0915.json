    "མཆེ་བ་གཙིགས་པཔས་འཇིགས་པར་བྱེད་པ།",
    "ཞལ་ནས་ཁྲག་འཛགས་པར་བདག་ཉིད་སྐད་ཅིག་ཏུ་རྫོགས་པར་བྱས་ནས་སྔགས་བཟླས་པར་བྱའོ།",
    "ཨོཾ་མ་ཧཱ་ཀཱ་ལ་ཡ་ཤཱིས་ནོ་པ་ཀ་ར་ཡཱ་སརྱ་མུཊྚ་ཧྥ་ཤཱ་ཎ་༡བཱ་སི་ནཱ་སྐྲ་ཏཱ་ཡ་ཨེ་ཥོ་ཨ་པརྩི་མ་ཀཱ་ལོཉ་ཡཾ་ཡ་ཏི་ཏཾ་པྲ་ཏི་བྷཱཛཱ་སྨ་ར་སི་ཏི་དཱ་ཨི་མཾ་རཏྣ་ཏྲ་ཡཱ་ཀ་རི་ཎ་མཱ་མུ་ཀ་ན་དུཎྞཾ་ཁ་ཁཱ་ཧི་ཁ་ིཁཱ་ཧི།",
    "ཏིལ་འབྲུ་ཙམ་དུ་གཏུབ་པར་བྱེད།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་དཔག་ཏུ་མེད་པ་རྟོགས་པར་བྱའོ།",
    "ཡི་དགས་ཀྱི་གདན་ལ་བཞེངས་པར་གནས།",
    "ཁ་ཤར་ིསྔགས་སྟོང་ཕྲག་བཅུ་བཟླས་པར་བྱའོ།",
    "ཚངས་པར་བྱས་ལ་མངོན་དུ་ཕྱོགས་པས་སྔགས་བཟླས་པར་བྱའོ།",
    "ཨོཾ་མ་ཧཱ་ཀཱ་ལ་ཧ་ན་ཧ་ན་བཛྲ་ཎ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་འབུམ་ཕྲག་གཅིག་བཟླས་པར་བྱའོ།",
    "ཨོཾ་མ་ཧཱ་ཀཱ་ལ་ཧ་ན་ཧ་ན་བཛྲ་ཎ་ཨེ་ཏ་ཏ་པྲ་ཥ་ཡཱ་མི་ཀ་ར་ཥ་ཐཱ་སྭཱ་ཧཱ་ཞེས་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "རྣལ་འབྱོར་མ་དང་སྒྲུབ་པ་བྱས་ལ་ནག་པོ་ཆེན་པོ་བསྒྲུབ་པར་བྱའོ།",
    "ཞེས་འབུམ་ཕྲག་གཉིས་བཟླས་པར་བྱའོ།",
    "ཚ་དུ་ཕྱིན་པ་ས་སྔགས་བཟླས་པར་བྱའོ།",
    "ཨོ་གྲུབ་པར་གྱུར་ཅིག།",
    "ཧཱུཾ་གྷོ་གྷོ་ཞེས་བཟོད་པའི་ཤུགས་མིཅན་ཅ་ཅོ་སྒྲོགས་པར་བྱེད་པའི་གདུག་པ་རྣམས་བཟུང་སྟེ།་",
    "གླུ་སིཾཧི་ཞེས་སྔགས་ཀྱི་གསུངས་ཨིཅན་པ་ཙ་པ་ཙའི་སྔགས་ཀྱིས་བགེགས་རྣམས་རབ་ཏུ་བསྲེགསཀྱི།",
    "ཕོ་ཕོ་ཕཊ་ཅེས་སྒྲོགས་པ་སོ་སོར་བསྐྱོད་པའི་མེ་དཔུང་ཆེན་པོའི་དབུས་སུ་བཞུགས་ནས་སུ།",
    "རིགས་ཀྱི་ལུས་ཅན་སྲུང་བར་བམཛད་ཅིང་སྒྲུབ་ཅེཔ་རྣམས་ཀྱི་ཞིང་རྣམས་ངེས་པར་ཞིང་སྐྱོང་མཛོད།",
    "ས་སྟེངས་ཅདང་ནི་མཐོ་རིས་སུ་འང་དེ་ཡི་བགེགས་ཀྱི་ཚོགས་རྣམས་རྟག་ཏུ་ཉམས་པར་འགྱུར།",
    "བསྟན་པ་སྲུང་བར་ཞལ་བཞེས་པ།",
    "བར་གྱི་གདོན་ཚོགས་བསྡིགས་པར་བྱེད།",
    "དབུས་ཕེབས་སྔ་མ་སྤུ་ཀོང་བརྒྱུད་ནས་ཕེབས་སྐབས།",
    "རྣམ་འདྲེན་མཆོག་དང་ཀུན་མཁྱེན་ཉི་མའི་གཉེན།",
    "མ་རྟོགས་ལོག་པར་རྟོགས་དང་ཕྱོགས་ཙམ་རྟོགས།",
    "འཛམ་བུའི་ཆུ་བོའི་གསེར་གྱིས་བཀང་བྱས་ཀྱང་།",
    "ཁྱད་པར་སྔ་འགྱུར་རྫོགས་པ་ཆེན་པོ་ཞེས།",
    "འབུལ་ན་བརྩེ་ཆེན་ཐུགས་རྗེས་བཞེས་ནས་ཀྱང་།",
    "རིང་མིན་འགྲུབ་པར་མཛོད་ཅིག་ཀྱེ།",
    "སྔ་འགྱུར་བཀའ་མའི་སྐོར་གྱི་དཔེ་རྒྱུན་དཀོན་རིགས་རྣམས་དབུས་གཙང་ཀུན་ཏུ་བཙལ་བས་མ་རྙེད་པར་ཡོད་པའི་ཚེ།",
    "ཁོ་བོས་ཀྱང་མཐུན་འགྱུར་གང་ནུས་བྱེད་ཅེས་གསུངས་པ་དང་།",
    "ཕྱོགས་གཞན་དུ་བཞུགས་པའི་ཞལ་སློབ་ཡོངས་ལ་དེ་ལྟར་བསྒྲུབས་པའི་མཐུན་རྐྱེན་རོགས་སྐྱོར་ཅི་འབྱོར་སྒྲུབས་ངེས་དགོས་ཞེས་པའི་གསུངས་བྲིས་ཕྱག་རྟགས་ཀྱིས་སྤྲས་པ་གནང་ཡོད་པར་མ་ཟད་དམན་བུ་བདག་ལའང་དཔེ་རྙིང་ཉུལ་བཙལ་དང་ཕྱོགས་བསྒྲིག་བྱེད་རྒྱུ་བཅས་ཀྱི་ལས་དོན་སྒྲུབས་དགོས་ཅེས་ཕྱག་དར་བཅས་བཀའ་ཕེབས་གནང་བྱུང་བ་ལ།",
    "རོང་ཟོམ་དང་མཁན་མཁྱེན་བརྩེའི་བློ་གྲོས་ཀྱི་གསུང་ཚང་མ་དེ་མིན་གྱི་དཔེ་དཀོན་མང་ཙམ་ཐོབ།",
    "ལྟ་ཕྲེང་གཙང་ཊིཀ།",
    "ཞེས་པ་ལྟ་ལག་ཤེས་ཅན་གྱི་ཡིག་བྲིས་རྣམས་ལ་སེམས་མི་འཕངས་པ་བྱས་ཏེ་བྲི་བཅོལ་ནན་ཟབ་བྱས་ཀྱང་།",
    "པར་རྙིང་ཁ་ཤས་ཡང་སྔོན་དུ་ཞུ་བཅོས་མ་ཐུབ་པ་མང་ཤིང་།",
    "དེང་སང་ཕྱོགས་བསྒྲིགས་བྱས་ཟིན་པའི་བཀའ་མ་དང་རྒྱུད་འབུམ་གཉིས་སུ་མ་ཚུད་པའི།",
    "བཟང་གོས་ཀྱི་ན་བཟའ་གསོལ་བ་ཞིག་དཔེ་སྒྲོམ་དུ་བཞུགས་པ་དེ་གནང་སྟེ།",
    "དེས་ན་བདུད་འཇོམས་འཇིགས་བྲལ་ཡེ་ཤེས་རྡོ་རྗེས་རྒྱ་གར་འཕགས་པའི་ཡུལ་དུ་བཀའ་མའི་དཔེ་དཀོན་རྣམས་ཕྱོགས་བསྒྲིགས་གནང་བའི་བཀའ་དྲིན་བསམ་གྱིས་མི་ཁྱབ་ཀྱང་།",
    "སྔ་འགྱུར་བཀའ་མའི་དཔེ་དཀོན་ཁ་གསབ་བྱ་ཚུལ་གྱི་བཀའ་སློབ་དུ་མ་གནང་སྟེ་ལོ་དེ་ཉིད་དུ་ཞི་བར་གཤེགས་སོ།",
    "འགའ་ཤས་ལྷ་ས་དང་ཁམས་རི་བོ་ཆེའི་ཕྱོགས་ཀྱི་བྲིས་པ་རྣམས་ལ་འབྲིར་བཅུག་པ་རྣམས།",
    "ཁ་གསབ་ཀྱི་ཚུལ་དུ་བཞགས་ཏེ་སྒྲིག་སྟངས་ཀྱི་གོ་རིམ་ཡང་སྔ་མ་བཞིན་བྱས་ཏེ་ཚར་བརྒྱ་ཐམ་པ་པར་བསྐྲུན་ཞུས་པ་ཡིན།",
    "རྒྱ་རིགས་ཀྱི་དད་ལྡན་མ་ནིང་ཡུ་ཧྥ་ཡིས་ཁང་པ་གཡར་གནང་བ་དེར།",
    "ཚེ་རིང་རྒྱ་མཚོ་མཆོག་ནས་བཞེས་ཤིང་གུས་པས་ཀྱང་གང་ནུས་ཀྱི་ཞབས་ཕྱི་ཞུས་པ་བརྒྱུད།",
    "དེ་ནས་ཞུ་དག་བྱེད་སྐབས་གཟན་དཀར་མཆོག་སྤྲུལ་ཐུབ་བསྟན་ཉི་མས་ལས་ཀའི་སློབ་སྟོན་ཐེངས་མང་གནང་བ་མ་ཟད།",
    "མི་དམངས་ཤོག་སྒོར་ཁྲི་ཉི་ཤུ་ཙམ་གནང་བ་བཅས་ཀྱི་མཐུ་རྐྱེན་འོག།",
    "ལས་ཀའི་འགན་ཡོངས་རྫོགས་ཚེ་རིང་རྒྱ་མཚོ་ནས་ཆེ་བཞེས་མཛད།",
    "སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གཉིས་ལ་འབྲེལ་མཐུད་གནང་སྟེ།",
    "རྩིས་འཕྲུལ་ནང་ཕབ་བླུག་བྱས་པའི་བཀའ་མ་ཇི་ལྟར་བཞེངས་པའི་ཚུལ།",
    "ལམ་ཏུ་སོན་ཟིན་པ་རྣམས་ཐོག་མའི་སྐབས་ལག་བྲིས་ཀྱིས་ཞལ་བཤུས་ཏེ་ལེགས་པར་བསྒྲིགས།",
