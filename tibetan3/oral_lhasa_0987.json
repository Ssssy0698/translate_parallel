    "རག་དུང་དེའང་སྔར་མེད་པ་ལ་ལྷ་བཙུན་པའི་ཐུགས་ཤེས་རབ་ཀྱིས་བཅོས་ནས་གསར་དུ་བཟོས་གནང་པས་ཕྱིས་ལོ་པཎ་སྤྱན་འདྲེན་གྱི་དུང་ཆེན་དུ་གྲགས།",
    "ངའི་གདུལ་བྱ་རྣམས་ལ་ཐུགས་རྗེས་ཟུངས་ཤིག་གསུངས་ནས་ཐུགས་སྨོན་མཛད།",
    "ད་ནི་མིང་པོ་དེའི་ཚབ་མ་ཁྱེད་ལ་ཞུ་བ་ལགས་པས་སྐྱེ་བོ་ངན་པ་རྣམས་ཀྱི་ལོག་རྟོག་ངན་པ་གཅིག་པུ་སྦྱངས་བའི་ཆེད་དུ་ཡང་བོད་དུ་ཡུན་བསྲིངས་ནས་རྒྱུན་དུ་བཞུགས་པ་ཞུ་འཚལ་ཞེས་གསོལ་བ་བཏབ།",
    "ཇོ་བོ་རྗེས་ཅུང་ཙམ་བཞེས་རྗེས་སྣོད་འདི་དང་བཅུད་འདི་གཉིས་མཐུན།",
    "ནག་ཚོ་ལོ་ཙཱ་བས་འདི་ལ་ཇ་ཟེར་བ་ལགས།",
    "བོད་ཀྱི་རབ་བྱུང་རྣམས་ཀྱི་བཏུང་བ་ལགས།",
    "སྐུ་ཁམས་བདེའམ་དགོས་པར་སྤྱོད་ལགས་སམ།",
    "ཨ་ཏི་ཤ་ཡིས་བཟོད་པར་མཛད་དུ་གསོལ་ཞེས་དང་།",
    "དཀའ་བ་མང་པོ་སྤྱད་པ་བཟོད་པར་མཛོད།",
    "གཞུང་ལུགས་ཤིན་ཏུ་དར་ཞིང་རྒྱས་པར་ཤོགབདུན་པ།",
    "ཁྱད་པར་དུ་ཨཱ་ཙ་རྱ་ཤམ་ཐབས་དམར་པོ་ཅན་དང་།",
    "འོ་ན་ཇོ་བོ་ཉིད་ཀྱི་བཞེད་པ་ཇི་ལྟར་ལགས་ཞེས་ཞུས་པས།",
    "ང་ལ་འདོད་པ་མེད་གསུངས།",
    "རབ་རིབ་ཅན་གྱིས་སྐྲ་ཤད་མཐོང་བ་ལྟར་འདི་དག་ཐམས་ཅད་དེ་ལྟར་གནས་པ་ཡིན་གསུངས།",
    "ནམ་མཁའ་ལ་སྔགས་ཀྱིས་བཏབ་པས་རྟ་གླང་དུ་སྣང་བ་ལྟ་བུ་ཡིན་གྱི་སྣ་ཚོགས་སྣང་བ་ཙམ་ལས་འཁྲུལ་གཞི་ཀུན་རྫོབ་ཏུ་ཡང་མེད་གསུངས།",
    "ཟས་ཐམས་ཅད་སྐྲ་ཤད་མཐོང་བས་ཁོག་པར་སྐྲན་ཞུགས།",
    "མནའ་མ་ལ་ཡིད་མུག་པར་གྱུར་ཏེ།",
    "བུས་ཆུང་མ་ལ་ཇི་ལྟར་ཡིན་བྱས་པས།",
    "ངས་གུས་པར་བྱས།",
    "དེ་ལ་ཇོ་བོ་རྗེ་སྤྱན་དྲངས་སྟན་མཉམ་པར་བཤམས།",
    "སྟན་ཐོག་གཅིག་ཏུ་ལམ་འབྲས་བུ་དང་བཅས་པ་མ་ཚང་བ་མེད་པར་ཉམས་སུ་ལེན་པ་འབྲས་བུའི་རྒྱུད་དེ་རྒྱུད་གསུམ་གྱིས་ཉམས་སུ་ལེན་ཞིང་།",
    "བསྐྱེད་རིམ་གཅིག་པུའི་སྟེང་དུ་ཡང་ཐམས་ཅད་ཚང་བར་ཉམས་སུ་ལེན་པ་ཡིན་ནོ་ཞེས་གསུངས།",
    "དེ་གོང་མཁྱེན་པ་ཆེ་ཡང་།",
    "ཇོ་བོའི་ཞལ་ནས་ངའི་ལོ་ཙཱ་ལ་འགྲོ་དགོས་གསུངས་པས།",
    "སྲིད་པའི་ཆུ་བོ་ལས་སྒྲོལ་བའི་ཐབས་ཤེས་རབ་ཀྱི་གྲུ་གཟིངས་རྙེད་པའི་དུས་འདིར་སེམས་བྱ་བ་ངན་པ་རྣམས་ཀྱིས་མི་གཡེང་བར་སྒྲུབ་པ་རྩེ་གཅིག་ཏུ་མཛོད་ཅིག་གསུངས་པས།",
    "དེ་ལྟར་ཇོ་བོས་མངའ་རིས་སྟོད་དུ་བསྟན་པའི་བྱ་བ་རྒྱ་ཆེར་མཛད་ནས་ལོ་གསུམ་རྫོགས་པར་ཉེ་བ་ན།",
    "ནག་ཚོ་ལོ་ཙཱ་བ་ལ་གནས་བརྟན་གྱི་དམ་ཚིག་ལ་བཀར་བའི་མནའ་ཡོད་པས་ལོ་ཙཱ་བས་ད་རྒྱ་གར་དུ་འབྱོན་པར་ཞུ་ཞེས་བསྐུལ།",
    "ཇོ་བོས་ཀྱང་འབྱོན་པ་ལྟར་གནང་སྟེ་པུ་ཧྲེང་དུ་ཕེབས།",
    "མཁྱེན་པ་མཐོ་ཞིང་ཐུགས་དགོངས་ཤིན་ཏུ་གསལ་བའི་གྲོགས་དག་ལ།",
    "ཡོན་ཏན་ཅན་ལ་ཕྲག་དོག་མི་བྱ་གུས་པར་གྱིས་ལ་ཡོན་ཏན་བླང་།",
    "འགྲོ་བ་ཀུན་ལ་ཕ་མའི་འདུ་ཤེས་བསྐྱེད་ལ་བུ་བཞིན་བྱམས་པར་གྱིས།",
    "མངོན་ཤེས་མེད་པར་གཞན་དག་སྨིན་པར་མི་ནུས་པས་ན་སྒྲུབ་ལ་བརྩོན་པར་མཛོད།",
    "དེ་ལྟར་མཛད་ན་བདག་ཀྱང་དགའ་ལ་རང་གཞན་ཀུན་ཀྱང་སྐྱིད་པར་མཆིས།",
    "འབྲོམ་སྟོན་པས་བརྐྱངས་ཕྱག་མཛད་དེ་ཇོ་བོའི་སྐུ་མདུན་དུ་ཕེབས་པ་ན་ཇོ་བོ་རྗེས་འབྲོམ་སྟོན་པའི་དབུ་ཐོག་ཏུ་ཕྱག་བཞག་ནས་སམ་སྐྲ་ཏའི་སྐད་དུ་ཤིས་བརྗོད་མང་དུ་མཛད།",
    "དེ་ཉིན་སྦྱིན་བདག་དེ་ལའང་ངའི་ཨུ་པ་སི་ཀའི་སྐལ་བ་དགོས་ཞེས་བསྣམས་ནས་ཡོད་པ་དེ་གནང་།",
    "ཇོ་བོ་རྗེ་སྐུ་ཚེ་ཧྲིལ་པོར་ཤ་མི་བཞེས་པས་དེ་ཉིན་གྱི་འབྲོམ་སྟོན་པའི་སྐལ་བ་དེ་ལ་ཟན་དང་མར་སྦྲགས་ནས་ཡོད་པ་འབྲོམ་གྱི་ཟན་དེ་བཞེས།",
    "མར་དེ་མ་བཞེས་པར་མར་མེ་ཀོང་བུ་མཚན་ཐུབ་ཅིག་བཟོས་ནས་ཇོ་བོའི་དབུ་སྔས་སུ་ཕུལ།",
    "ཚེ་ཧྲིལ་པོར་ཇོ་བོའི་དབུ་སྔས་སུ་མར་མེ་མཚན་ཐུབ་རྒྱུན་མ་ཆད་པར་ཕུལ་བ་ཡིན་གསུངས།",
    "དེ་ནས་པུ་ཧྲེང་ནས་རིམ་གྱིས་ཕེབས་ཏེ་མང་ཡུལ་གྱི་གྲོང་དུ་ཕེབས།",
    "བལ་ཡུལ་བརྒྱུད་དེ་རྒྱ་གར་དུ་གདན་འདྲེན་རྩིས་བྱས་ཀྱང་ལམ་དུ་དམག་ཟིང་ཆེན་པོ་ལངས་པས་ལམ་འགག་ནས་ཕེབས་མ་ཐུབ།",
    "ཇོ་བོས་ཚངས་པར་སྤྱོད་པ་གྲངས་མང་པོ་དེ་ལྟ་བུ་རྒྱ་གར་ན་ཡང་དཀོན།",
    "འབྲོམ་སྟོན་པ་དགའ་བ་སྐྱེས་ནས་བོད་དུ་འབྱོན་པར་ཞུས་པས།",
    "ཇོ་བོ་རྗེས་ཞལ་བཞེས་གནང་།",
    "ཇོ་བོ་རྗེས་ནག་ཚོ་ལོ་ཙཱ་བ་ལ་དེ་ཙམ་སེམས་སྡུག་བྱེད་མི་དགོས་སྒྲུབ་པར་མ་ནུས་པ་ལ་ཉེས་པ་མེད་གསུངས།",
    "ནག་ཚོ་ལོ་ཙཱ་བ་ཤིན་ཏུ་དགའ་ནས་འོ་ན་བོད་དུ་མར་བྱོན་པར་ཞུ་ཞེས་ཞུས།",
    "དེ་ལྟར་ཇོ་བོ་རྗེ་ཕེབས་མ་ཐུབ་པས་རྒྱ་གར་དུ་བང་ཆེན་བརྫངས་ནས།",
    "འགྲོ་དོན་ཡང་ཤིན་ཏུ་ཆེ་བས་རབ་ཏུ་བོད་དུ་བཞུགས་ཆོག་པ་འདྲ་མི་ཡོང་ངམ་ཞེས་ཞུ་ཡིག་དང་།",
    "ཐམས་ཅད་ཧ་ལས་ནས་མགྲིན་གཅིག་ཏུ་ཇོ་བོ་བོད་དུ་ཕེབས་པས་བོད་པ་རྣམས་ལ་ལེགས་པ་མ་ཟད།",
    "ཇོ་བོ་རྗེ་རྒྱ་གར་དུ་བཞུགས་ན་རྒྱ་གར་བ་རྣམས་ཤེས་རབ་དང་བརྩོན་འགྲུས་ཆེ་བས་བསྟན་བཅོས་འདི་ལྟ་བུ་མི་གསུངས།",
