    "དེ་དག་གིས་ནི་རི་རྣམས་བསྟན་ཏོ།",
    "འདི་དག་གིས་ནི་གླིང་རྣམས་བསྟན་ཏོ།",
    "རང་གི་ལུས་ཀྱང་སྟོང་པ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "ནང་གི་སྐྱེ་མཆེད་ཉིད་ཡིན་ནོ།",
    "གང་གི་ཚེ་སྟོང་པ་ཉིད་དུ་ཐམས་ཅད་ཐིམ་ཞིང་འོད་གསལ་བས་མི་གཡོ་བར་གནས་པ་དེའི་ཚེ་ཏིང་ངེ་འཛིན་གྱི་མཐར་འོད་ཟེར་མར་མེ་ལྟ་བུ་སྣང་བར་གྱུར་ན།",
    "གང་ཞིག་ཅེས་བྱ་བ་ནི་སྒྲུབ་པ་པོ་གང་ཞིག་གིས་སོ།",
    "རིམ་པར་ཕྱེ་བ་ནི་གཞུང་གི་ཚོགས་སོ།",
    "ཁྱད་པར་ནི་བློའི་ཁྱད་པར་གང་དང་གང་གིས་འགྲོ་བ་ཁྱད་པར་ཅན་ཐོབ་པར་བྱེད་པའི་ཁྱད་པར་རོ།",
    "ཡེ་ཤེས་ཐུན་མོང་བྱིན་བརླབས་པ།་",
    "ཐུན་མོང་ནི་ལྷན་ཅིག་སྐྱེས་པའོ།",
    "ཁ་ཅིག་ན་རེ་ལྷ་དང་ལྷ་མ་ཡིན་ལ་སོགས་པའི་ཐ་མལ་པའི་རྣམ་པར་ཤེས་པ་ནི་ཐུན་མོང་མ་ཡིན་ལ།",
    "བྱེ་བྲག་གཞན་བེེ་ཇི་ལྟ་བུ་ཞེས་བྱ་བ་ནི་བྱེ་བྲག་མ་རྟོགས་པར་རྣམ་པར་ཤེས་པ་བསྟན་པར་མི་ནུས་པས་བྱེ་བྲག་གི་ཁྱད་པར་ཉིད་གསོལ་བ་བཏབ་པ་ཡིན་ནོ།",
    "གང་གིས་ཤེ་ན།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་གང་གི་ཚེ་འཆི་བའི་དུས་ལ་བབ་པ་ན།",
    "ཉོན་མོངས་པའི་རྐྱེན་ཅན་གྱི་དམིགས་པའི་ཁྱད་པར་གྱི་ལས་ཀྱི་བསྒོས་པའོ།",
    "རང་རིག་ཅེས་བྱ་བ་ནི་རང་གི་བསམ་པས་འགྲོ་བའོ།",
    "ངན་འགྲོའི་འགྲོ་བ་མེད་པ་ལ་སོགས་པ་ཤིན་ཏུ་ཐལ་ཆེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་དག་གི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "ཉན་ཐོས་ལ་སོགས་པའི་ཡུལ་ལས་ཤིན་ཏུ་རིང་བར་སོང་བའི་ཕྱིར་རོ།",
    "ཕྲ་མོ་ཞེས་བྱ་བ་ནི་ཆུ་ལ་སོགས་པའི་སྐྱེ་བོ་ཕྲ་མོ་རྣམས་སོ།",
    "ཆུ་དང་ཞེས་བྱ་བ་ནས་བྲག་ལ་སོགས་པ་ཞེས་བྱ་བའི་བར་དུ་བརྟན་པ་རྣམས་ནི་ཆུ་ལ་སོགས་པའི་རང་བཞིན་གྱི་སྐྱེ་བོ་ཕྲ་མོ་གཟུང་བར་མི་ནུས་པ་རྣམས་སོ།་",
    "ཞེས་བྱ་བ་ནི་སྐྱེ་བ་གནས་བཞིས་བསྡུས་པའི་སྐྱེ་བོ་ཐམས་ཅད་རང་རང་གི་རང་རིག་པའི་ཡེ་ཤེས་མྱོང་བ་ལ་སྐྱེས་པའོ།",
    "ཡང་ན་བརྟན་པ་དང་གཡོ་བའི་འགྲོ་བ་ཐམས་ཅད་རང་གི་ཡེ་ཤེས་ཙམ་གྱི་སྣང་བ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ནི་གསང་སྔགས་ཀྱི་ཚུལ་ལ་མོས་པས་སོ།",
    "རིམ་པར་ཕྱེ་བ་ནི་དོན་དེའི་གཞུང་གི་ཚོགས་ཏེ་སུམ་ཅུ་པའོ།",
