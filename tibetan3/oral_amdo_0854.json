    "ཕྱོགས་གཉིས་བྱ་རོག་གི་གཤོག་པ་ལྟར་ཟླུམ་པའོ།",
    "མཐེ་བོའི་ཁྱོན་ཙམ་དུ་ནི་མཐོང་།",
    "བསྒྲུབ་བྱའི་ཁ་ན་གནས་པའི་ཡི་གེ་བདག་གི་ཁ་ན་གནས་པའི་ཡི་གེ་ལ་བསྡུ་བའོ།",
    "དེ་བཞིན་དུ་གནས་དྲུག་པོ་གཞན་དག་གི་ཡང་སྦྱར་བར་བྱའོ།",
    "ཡང་ན་སྒོ་དང་སྒོ་ཞེས་བྱ་བར་སྦྱར་ཏེ་བདག་གི་སྣ་སྒོ་གཡས་ནས་བྱུང་བའི་དབུགས་ཀྱི་རི་མོས་བསྒྲུབ་བྱའི་སྣ་སྒོ་གཡོན་པར་ཞུགས་ཏེརྐ།",
    "ཡི་གེ་རྣམས་བཀུག་ནས་སླར་དེ་ལས་བཟློག་པའི་ལམ་ནས་ཞུགས་ཏེ་རང་གི་ལུས་ཀྱི་ནང་དུ་དགང་བའོ།",
    "སཾ་ག་རྔུཐིག་ལེའི་རི་མོའི་མེ་ལྕེའི་སྒོར་རོ།",
    "ཞེས་བྱ་བ་ནི་ཟླ་ཚེས་དང་ཟིག་ལེ་གཉིས་དང་མཉམ་པར་སྦྱར་བའོ།",
    "ད་ནི་ལས་དེ་དག་ཐམས་ཅད་ལ་ཡི་གེ་དེ་དག་ཉིད་ཀྱིས་སྔོན་དུ་རང་གི་ལུས་བསྲུང་བའི་ཆོ་ག་བསྟན་པའི་ཕྱིར།",
    "བདག་གི་དེ་ཉིད་གསལ་བ་ཡིན།",
    "ཞེས་བྱ་བ་ནི་བདག་གི་ཁམས་བཅུ་དྲུག་བསྲུང་བའི་དེ་ཁོ་ན་ཉིད་དོ།",
    "རང་གི་ལྷ་ཡི་སྡོམ་པ་སྟེ།",
    "དེའི་འོད་ཟེར་དམར་པོས་ཡན་ལག་གི་ཚིགས་ཐམས་ཅད་དུ་ཁྱབ་པའོ།",
    "བཟི་ཞེས་བྱ་བ་ནི་ཆང་གིས་མྱོས་པ་ལྟ་བུར་ཆགས་པས་མྱོས་བའི་ཕྱིར་བཟི་བའོ།",
    "ཞེས་བྱ་བ་ནི་བདུད་རྩི་འཛག་པའི་སྤྱོ་བོའི་སྟེང་དུ་ཟླ་བ་དྲུག་གམ་ལོ་གཅིག་གི་བར་དུ་བསྒོམས་ན་ཇི་སྐད་སྨོས་པ་བཞིན་དུ་འགྱུར་རོ།",
    "དམར་ཞེས་བྱ་བ་ནི་ལོངས་སྤྱོད་སྡོགས་པའི་འཁོར་ལོར་གནས་པའི་ཡི་གེ་ཨོཾ་མོ།",
    "ཨོཾ་གྱི་འོད་ཟེར་མགོ་བོར་སོང་བས་མི་ཤིགས་པའི་ཐིག་ལེ་བཞུ་བའོ།",
    "ཡང་ན་ཨ་རུ་དུ་ན་ཞེས་བྱ་བ་ནི་སྐྱ་རེངས་ཏེ་སྤུསྤྲུལ་པའི་འཁོར་ལོར་གནས་པའི་ཨའོ།",
    "གཙོ་མོ་བཞི་ནི་རྣམ་པ་བཞིའི།",
    "གཙོ་མོ་བཞི་ནི་གཤིན་རྗེ་བརྟན་མ་ལ་སོགས་པ་རྣལ་འབྱོར་མ་བཞིའོ།",
    "གང་གི་ལྕེ་ཡི་སྟེང་དུ་ནིའུ།",
    "ཅུང་ཟད་སྔོ་བ་འཇིགས་ཆེན་མོ།",
    "མ་ཧེ་དང་ནི་རྟ་དག་གི།",
    "དེར་མ་ཏེ་དང་རྟ་ལ་གནས་པའི་ཧཾ་གི་འཁྲུལ་འཁོར་སྦྱར་བར་བྱའོ།",
    "རྐན་ཀྱི་ལམ་ནི་སྤྱི་གཙུག་གི་སྒོའོ།",
    "རི་མོ་དག་ནི་ཞུགས་པར་བསམ།",
    "རི་མོ་དེ་ཡང་ཅི་འདྲ་ཞེ་ན།",
    "རི་མོ་མར་མེའི་རྩེ་ལྟ་བུ་སྟེ།",
    "ཀྵེ་གི་ཐིག་ལེ་ལས་མེ་འབར་བའོ།",
    "རྩེ་མོ་རྒྱས་པ་མཐོང་འགྱུར་ཏེ།",
    "ཞེས་བྱ་བ་ནི་རྩེ་མོ་ནི་འདས་པ་ལ་སོགས་པའི་ཆའོ།",
    "འདོད་པ་ནི་རང་གི་བྱ་བ་ཤེས་པ་ཞེས་བྱའོ།",
    "རེ་རེ་ཡི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རེ་རེ་འང་སྦྱོར་བ་བཞི་བཞི་སྟེ།",
    "ཞེས་བྱ་བའི་ཚིག་ཐ་མ་འདི་གཉིས་ཀྱི་བར་ན་གནས་པའི་མཆོག་གི་དགྱེས་པ་ཞེས་བྱ་བའང་གཟུང་བར་བྱ་སྟེ།",
    "གང་ཁྱོད་ཀྱིས་སྔར་བསྟན་པའི་དོན་ནི་ཇི་ལྟ་བུ་ཞིག་ལགས་ཞེས་བྱ་བར་ཡང་སྦྱར་བར་བྱའོ།",
    "མ་མོ་ཞེས་བྱ་བ་ནི་ཁམས་བཅུ་དྲུག་པོ་འདི་དག་ཡིན་ཏེ།",
    "དེ་དག་གི་ལུས་བསྐྱེད་ཅིང་བརྟན་པར་བྱེད་པས་མ་ལྟར་གསོ་ཧུཕྱིར་མ་མོའོ།",
    "དེ་དག་གི་མ་མོ་ཡང་ཡིན་ལ་ནང་གི་དཀྱིལ་འཁོར་ཡང་ཡིན་ཏེ།",
    "ཁ་ཅིག་ནི་ནང་གི་རྫས་རྣམས་ལྷའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་དག་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "བ་སྟེ་སྤྱོར་བ་གཞན་གྱི་ནང་གི་རྫས་ཀྱི་སྦྱོར་བ་༧བཅུ་དྲུག་དུ་བགྲེང་ཞིང་བསྒྱུར་བའི་ཆར་ཡང་མི་ཕོད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྫས་རྣམས་ཡི་གེ་རེ་རེ་ཞིང་སོ་སོའི་བརྡས་བསྟན་པའི་ཕྱིར།",
    "སོ་དང་ལག་སྐྱེས་ཞེས་བྱ་བ་ནི་སོ་དང་སེན་མོའི་རྡུལ་སྟོན་པ་སྟེ།",
    "སྐབས་མ་ཡིན་མོད་ཀྱི་བདེ་བླག་ཏུ་རྟོགས་པར་ཡང་བྱ་བའི་ཕྱིར་རོ།",
    "ཡང་སྔར་ཐལ་བའི་འཕྲོ་གསང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམ་པ་གཞན་བསྟན་པའི་ཕྱིར།",
    "ད་ནི་གོང་དུ་ཐལ་བའི་སེམས་དཔའི་སྒྲ་བསྒྲུབ་པར་འདོད་ནས།",
    "དེ་དག་གིས་ནི་དམ་ཚིག་སྤྱོད་ཡུལ་ཡིན་ཞེས་བསྙད་དོ།",
    "གཟུང་བ་དང་འཛིན་པ་དང་འཛིན་པ་པོ་གསུམ་གྱི་དམིགས་པ་དེ་ནི་ཟག་པ་དང་བཅས་པའི་དངོས་པོ་གསུམ་མོ།",
    "བཅོམ་ལྡན་འདས་མ་སྟེ་བུ་མོའོ།",
    "ལྷ་དང་མི་དག་གི་བདེ་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "ནང་གི་ཁམས་བཅོ་བརྒྱད་ཀྱིས་ར་ས་ཡཱ་ན་སྦྱར་བའོ།",
    "བུ་མོ་ཞེས་བྱ་བ་ནི་ལོ་བརྒྱད་པའོ།",
    "ཐུན་མོང་མ་ཡིན་པས་ན་ཆགས་པ་ཆེན་པོ་སྟེ།",
    "ལོ་བརྒྱད་པ་ཇི་སྤུལྟ་བ་བཞིན་དུ་ལོ་དགུ་ནས་བཅུ་དྲུག་གི་བར་གྱི་བུ་མོ་རྣམས་ཀྱི་ཁྲག་སུམ་འགྱུར་དང་།",
    "བཅུ་དྲུག་ལོན་པའི་བུ་མོར་བཤད།",
    "ནང་གི་བཅུ་དྲུག་གི་ཆའི་སྦྱོར་བ་དེ་ལ་བསྒྲིན་པ་མི་ནུས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།་",
    "དེ་དག་གིས་ནི་བདུད་རྩི་ལྔའི་སྦྱོར་བ་བསྟན་ཏོ།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ནི་རིགས་ཀྱི་བུ་མོ་ལས་གཞན་པ་སྟེ་གཞན་གྱིའོ།",
    "ཡང་ན་སྔགས་ལ་སོགས་པ་ཕོ་ཉ་དང་བྲལ་བའི་ཕོ་ཉ་དག་གིས་མེ་ཏོག་ཀྱང་གཟུང་བར་བྱ་སྟེ།",
    "རས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གསལ་བར་མི་ཕྱེད་པ་ཞེས་བྱ་བ་ནི་སྒྲིབ་པའི་ངོ་བོ་ཉིད་དེ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཕྱིར་མི་ཤེས་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཡང་ན་མན་ངག་གི་ཏིང་ངེ་འཛིན་ཀྱི་དབྱེ་བ་རྣམ་པ་གསུམ་གསུངས་པ་ཡིན་ཏེ།",
    "བར་མ་ཞེས་བྱ་བ་ནས་རང་གི་དབུས་སུ་བསྡུས་ལ་ཞེས་བྱ་བའི་བར་དུ་ནི་གཉིས་པ་སྟེ།",
    "དབུས་སུ་བསྡུས་ལ་ཞེས་བྱ་བ་ནི་རང་གི་སེམས་སུ་བསྡུ་བ་སྟེ།",
    "མཆོག་གི་ཞེས་བྱ་བའི་བར་དུ་ནི་ཏིང་ངེ་འཛིན་གསུམ་པ་སྟེ།",
    "བུད་མེད་ཀུན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེ་གང་གི་སྤྱོད་ཁྱེཡུལ་ཡིན་པ་དེ་ནི་སྤྱོད་ཡུལ་ལོ།",
    "དེ་གང་གི་ཡུལ་ཡིན་པ་དེ་ནི་སྤྱོད་ཡུལ་ལོ།",
    "དེ་ཉིད་ནི་ཞེས་བྱ་བ་ནི་བུད་མེད་ཀུན་ཞེས་བྱ་བ་གང་ཡིན་པའོ།",
    "དམ་ཚིག་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ནང་གི་སྦྱོར་བ་སྟོན་པ་ཡིན་ནོ།",
    "རང་གི་པདྨའི་ལྟེ་དབུས་སུ།",
    "ཀཱ་ལིས་ངོས་ཀུན་དུ་བསྐོར་བའི་དབྱངས་ཀྱི་ཡི་གེ་བཅུ་དྲུག་གི་རི་མོའི་སྐུད་པས་ཐིག་བཏབ་པའམ།",
    "རྩ་བཅུ་དྲུག་གི་རི་མོས་ཀུན་དུ་བསྐོར་བའོ།",
    "སོགས་ཀྱིས་མཆོག་གི་དགྱེས་པ་ན་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གཞན་གཟུང་བར་བྱའོ།",
    "གཞུང་གང་ལས་དེ་དག་གི་དེ་ཁོ་ན་ཉིད་འབྱུང་ཞིང་སྟོན་པའོ།",
