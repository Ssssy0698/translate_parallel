    "ཅིག་ཤོས་ཞེས་བྱ་བ་ནི་དངོས་པོའི་རྣམ་པར་རྟོག་པའོ་༧།",
    "གཞན་སེལ་བ་དེ་ལ་སྐྱེས་བུ་འཇུག་པར་བྱེད་པ་ཡང་ཡིན་ནོ།",
    "ཕྱི་རོལ་དེའི་ཐ་སྙད་ཀྱི་ཡུལ་དང་རྒྱུ་དེའི་དངོས་པོ་ཉིད་དུ་རྣམ་པར་འཇོག་པ་སྟེ་གནས་པའོ་། གལ་ཏེ་ཤེས་པ་དེ་ལས་ལྷག་པར་སྒྲོ་བཏགས་པ་ལ་ལྷག་པར་ཞེན་པ་ཞེས་བརྗོད་པ་ཡིན་གྱི་དེ་ལ་མ་རྟོགས་ཀྱང་འཇུག་པའི་རྒྱུ་ཉིད་ལ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་དུ་རྩོད་པ་བརྗོད་པ་ནི་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གལ་ཏེ་ཞེས་གསུངས་སོ།",
    "དེས་ཞེས་བྱ་བ་ནི་ལྷག་པར་ཞེན་པའི་རང་བཞིན་གྱིས་རྣམ་༧པར་རྟོག་པས་སོ།",
    "འདི་ལ་བརྗོད་པ་ནི་ལྷག་པར་ཞེས་བྱ་བའོ་། གཞན་ན་ཡོད་པའི་ཆུ་ཉིད་དེས་གཟུང་བའི་ཕྱིར་སྒྲོ་བཏགས་པ་༧ཡིན་ནོ།",
    "ཆུ་ལ་སོགས་པ་མེད་པ་ཞེས་བྱ་བ་ནི་སྨིག་རྒྱུ་བ་དག་ལ་རྟོགས་པའི་ཆུ་ནི་གཞན་གྱི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་གཞན་གྱིས་མེད་པར་རྟོགས།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནི་ཆུ་མ་ཡིན་པ་ལ་ཡང་ཆུའི་རྣམ་པར་རོ།",
    "ཕྱི་རོལ་གྱི་ཐོབ་པར་བྱ་བའི་ཐ་སྙད་བྱེད་པའི་རྒྱུའི་ཕྱིར་ན།",
    "དེ་ལྟ་ན་ཡང་རྟོགས་པ་ེིལྡན་པ་དག་རྟོགས་པར་འགྱུར་རོ་ཞེས་བལྟ་བར་བྱའོ།",
    "ལྡོག་པ་ནི་ཐ་དད་པ་ཁོ་ནའོ་ཞེས་བརྒྱ་ལ་འགའ་ཞིག་དགོངས་པར་འགྱུར་བས་ན་དེ་ཉེ་བར་བཀོད་ནས་སུན་འབྱིན་པ་ནི་ལྡོག་པ་དེ་ནི་ཞེས་བྱ་བའོ།",
    "ཅི་རིགས་མི་མཐུན་པའི་གསལ་བ་དག་ལ་མེད་པ་དང་བཅས་པ་རྟོགས་པར་བྱ་བའི་དོན་དུ་སྒྲ་གཞན་དུ་མ་མཐོང་བ་ལ་ལྟོས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རྩོད་པའི་དོན་ཏོ།",
    "དེས་ན་གསལ་བ་ཉིད་རྟོགས་པར་འགྱུར་གྱི།",
    "ད་ཡང་ཞེས་བྱ་བ་ནི་ཁྲ་བོ་ལ་སོགས་པ་ཁྱད་པར་གྱི་རང་བཞིན་ནོ།",
    "དེས་ན་ཇི་ལྟར་གདོན་མི་ཟ་བར་ཁྱད་པར་འགའ་ཞིག་ཡོད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་ན་འདི་ནི་སྤྱི་རྟོགས་པར་ཁས་བླངས་ནས་བརྗོད་པ་ཡིན་ནོ།",
    "དངོས་པོ་ཁོ་ནའཇུག་པར་མཐོང་བའི་ཕྱིར་རོ་ཞེས་དོགས་པ་ལ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གཅུགས་པའི་སྐྱེས་བུ་ཡང་བུམ་པ་མ་ཡིན་པར་མཐོང་ཡང་དེ་མི་ལེན་ཏེ་དེས་ན་སྒྲའི་དོན་གང་ཡིན་པ་དེ་ལ་ནི་སླུ་ེིབ་མེད་དོ།",
    "བྱེ་བྲག་ཏུ་ཞེས་བྱ་བ་ནི་རྣམ་པར་དབྱེ་བར་རོ།",
    "གལ་ཏེ་གདོན་མི་ཟ་བར་ཁྱེར་ཏེ་འོང་བར་འགྱུར་ན་ནི་དེའི་ཚེ་ཡོད་པ་ཉིད་ལ་བྱེད་པ་འཇུག་པར་འགྱུར་བ་ཞིག་ན།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གསལ་བ་ཅིག་ཅེས་གསུངས་སོ།",
    "ཇི་ལྟར་མེའི་ཁྱད་པར་ལ་ཐེ་ཚོམ་ཟ་ཞེས་བྱ་བ་ནི་སྤྱི་མཐོང་བའི་ཕྱིར་དང་།",
    "ཁྱད་པར་མ་མཐོང་བའི་ཕྱིར་དང་།",
    "ཁྱད་པར་དྲན་པའི་ཕྱིར་ཐེ་ཚོམ་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱད་པར་གྱི་རིམ་པ་ཉིད་ཡོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་རིམ་པ་ལ་མ་གཏོགས་པ་དྲོ་བའི་སྤྱི་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གཞན་རྟོགས་པའི་རྒྱུས་མདུན་ན་གནས་པ་དེ་ལ་སྐྱེས་བུ་རྣམ་པར་རྟོག་པ་མི་བྱེད་ཀྱང་དངོས་པོ་གཉིས་པོ་དེའི་ངོ་བོར་སྣང་བ་ནི་མེད་པའི་ཕྱིར་རོ་། དེ་ཉིད་ཅེས་བྱ་བ་ནི་དེ་ཙམ་འབའ་ཞིག་སྣང་བ་ཉིད་དོ།",
    "དངོས་པོ་གཉིས་པོ་དེ་ཉིད་ནི་ལྡན་པར་གྱུར་པ་ཡིན་ནོ་ཞེས་རྟོགས་པ་ཡང་མེད་པར་གྱུར་ཏེ་ལྡན་པ་མེད་པའི་ཕྱིར་རོ།",
    "སྔ་མ་དང་ལྷན་ཅིག་ཏུ་རྟོགས་པ་མེད་པའི་ཕྱིར་ལྡན་པར་གྱུར་པ་རྟོགས་པ་ནི་མ་ཡིན་ནོ་ཞེས་སྦྱར་རོ།",
    "གང་ཞིག་མི་ལྡན་པར་གྱུར་པ་དེ་ནི་ལྡན་པར་གྱུར་པ་འདི་ཡིན་ལ།",
    "གལ་ཏེ་རྟོགས་པ་དེ་ལྟ་བུ་མེད་ན་ནི་དེའི་ཚེ་ལྡན་པར་རྟོགས་པ་དོན་མེད་པ་ཁོ་ནའོ།",
    "འོ་ན་འབྲས་བུ་དང་བཅས་པར་ཇི་ལྟར་འགྱུར་སྙམ་ན།",
    "སྒྲ་སྦྱོར་བར་བྱེད་པ་ཡང་ཞེས་གསུངས་སོ།",
    "གཞི་མཐུན་པར་འགྱུར་སྙམ་ན།",
    "གལ་ཏེ་འདས་པ་དང་འབྲེལ་བ་གཟུང་བ་ན་ེའདས་པ་འཛིན་གྱི་འབྲེལ་པ་མེད་པར་ནི་མ་ཡིན་ན་དེ་ཅི་ལྟར་ཐམས་ཅད་འཛིན་པར་བརྗོད་སྙམ་ན་ཞེས་གསུངས་སོ།",
    "དྲན་པར་བྱ་བ་དང་ཡོངས་སུ་མཐོང་བཞིན་པ་ཉིད་ལྷན་ཅིག་ཉིད་དུའོ།",
    "དེ་དང་ཞེས་བྱ་བ་ནི་དྲན་པར་བྱ་བ་མི་བདེན་པ་དང་ངོ།",
    "དེ་ཉིད་འདི་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་ཡོད་པའི་དེའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱང་དྲན་པ་ཉིད་དོ།",
    "གལ་ཏེ་གཅིག་མེད་པར་ནི་དོན་ཉིད་དུ་མི་འགྱུར་རོ་ཞེ་ན།",
    "དེའི་དོན་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལས་གཞན་པའི་ཞེས་གསུངས་ཏེ།",
    "གཉིས་པོ་དེ་ནི་ཁྱད་པར་མེད་དེ།",
    "དེས་ཇི་ལྟར་ཁྱད་པར་མེད་ཅེས་བརྩད་པ་ན་གྲུབ་པའི་མཐའ་གསུངས་པ་ནི་གསལ་ཉིད་དང་ཞེས་བྱ་བའོེ།",
    "སྔར་མཐོང་བ་དེ་ལྟ་བུ་དང་གཅིག་པར་ཇི་ལྟར་འགྱུར་དེ་ནི་མི་གསལ་བའི་ཕྱིར་རོ།",
    "གཞན་དུ་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ཐ་མི་དད་པས་རྟོག་པ་དང་བཅས་པ་ཉིད་ཡིན་ནའོ།",
    "ཆུ་ཌ་༤༤༦མེད་པར་འགྱུར་ལ་མཐོང་བ་དེ་མེད་ན་ཡང་ཡོད་པའི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པ་དེ་དང་སྟེ་དེ་ལྟ་བུའི་རྣམ་པར་རྟོག་པ་དང་མཐོང་བ་དེ་གཅིག་ཉིད་དུ་ཇི་ལྟར་འགྱུར་ཏེ།",
    "འདིར་ཐ་དད་པར་ཁས་བླངས་པའི་ཕྱིར་གཞན་དུ་ཡང་ངོ།",
    "གཞན་གྱི་ཚེ་ཡང་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པར་རོ། ། ནམ་ཡང་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྔའི་མཚན་ཉིད་ཀྱི་ལུས་ནི་ཤེས་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞན་དུ་ཡང་ཞེས་བྱ་བ་ནི་བ་ལང་མཐོང་བའི་དུས་སུ་བ་ལང་དུ་རྣམ་པར་རྟོག་པ་ནི་ཡང་ངོ།",
    "གནས་སྐབས་དེ་ན་ཞེས་བྱ་བ་ནི་བརྡར་རྣམ་པར་རྟོག་པའི་གནས་སྐབས་ནའོ།",
    "འདིར་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་བསྒྲུབ་པར་བྱ་བ་འདིར་རོ།",
    "རྟོགས་པར་འགྱུར་བ་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྦྱོར་བ་ནི་འདི་ལྟར་ཡིན་༤ཏེ་གང་ཞིག་གང་དུ་ཐ་སྙད་བྱེད་པ་དེ་ཐམས་ཅད་ནི་དེའི་རྣམ་པར་རྟོག་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་ཏེ།",
    "རྣམ་པར་རྟོག་པ་གཞན་གྱིས་དེ་མ་ཐག་པ་འདི་ཡང་ཐ་སྙད་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "དེ་རྟོགས་ན་སྟེ་མེ་དེ་རྟོགས་པར་ཁས་ལེན་ན།",
    "གཟུགས་ཀྱི་ཁྱད་པར་སྒྲུབ་ན་ནི་མ་ངེས་པ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "གཟུགས་ཁྱད་པར་དཀར་པོའམ་སེར་པོ་ནི་སྒྲུབ་པར་མི་ནུས་སོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གང་དུ་ཞེས་གསུངས་སོ།",
    "བློ་སྔོན་དུ་བཏང་ནས་བྱས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པ་གཞན་དུ་ཡང་ཡོད་པའོ།",
    "དཔེར་འོལ་མ་སེའི་ཕུངགྲང་བ་བཟློག་པ་དོན་༧སྤྲེའུ་རྣམས་ཀྱིས་བསྟེན་ེཔར་བྱ་བ་ཡིན་པ་དེ་ཅི་མེ་འདེ་བའི་ཐ་སྙད་མཐོང་བ་ལས་མེ་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ནམ།",
    "འདི་ལ་གྲུབ་པའི་མཐའ་སྨྲ་བས་གསུངས་པ་ནི།",
    "རྣམ་པར་རྟོག་པའི་སྒྲུབ་བྱེད་ནི་དེ་ལྟར་དེ་དུ་བ་དང་འབྲེལ་པ་མ་ཡིན་ནོ།",
    "༤༤༩རྣམ་པར་རྟོག་པ་རང་རིག་པའི་མངོན་སུམ་གྱི་ཡུལ་ཡིན་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་མི་འཐད་དོ་ཞེས་དགོངས་པའོ།་།",
    "དེ་ལྟར་རྟོགས་པར་བྱ་བ་ནི་གྲང་བའི་༤རང་བཞིན་དུ་རྟོགས་པའོ།",
    "དཔྱོད་སོགས་ཏེ་རྣམ་པར་རྟོག་པ་དང་།",
    "དེ་ཡོད་ན་ཞེས་བྱ་བ་ནི་གོམས་པ་དང་ལྡན་པ་ཉིད་ཡོད་ན་ནི་རྣམ་པར་དཔྱོད་པ་ལ་སོགས་པ་མེད་ཀྱང་ཐ་སྙད་དེ་འགྱུར་བ་ཡིན་ནོ།",
    "རྣམ་པ་གཞན་དུ་ཡང་ཞེས་བྱ་བ་ནི་སྔ་མ་དང་ཕྱི་མ་དཔྱོད་པ་མེད་པར་ཡང་ངོ།",
    "དེའི་ཕྱིར་རྣམ་པར་རྟོག་པ་མེད་ཀྱང་གོམས་པ་ལས་སྲོག་ཆགས་རྣམས་ཀྱི་ཐ་སྙད་འཇུག་པ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་ལ་སོགས་པའོ།",
    "རྣམ་པ་གཞན་དུའང་ཞེས་བྱ་བ་ནི་དཔྱོད་པ་ལ་སོགས་པ་མེད་པར་ཡང་ངོ།",
    "འབྲེལ་པ་མེད་པར་ནི་མི་སླུ་བ་ཉིད་མི་སྲིད་དོ་ཞེས་ཐ་སྙད་ཙམ་དུ་འབྲེལ་པ་ཉེ་བར་བསྟན་པའི་ཕྱིར་བརྗོད་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "ོདེ་ལྟ་མ་ཡིན་ན་བརྗོད་པར་འདོད་པ་ཙམ་ལས་བྱུང་བའི་སྒྲ་རྣམས་གང་ལ་མི་སྲིད་པས་ཡིན་ོ་དེ་མཐོང་བ་ན་ཞེས་བྱ་བ་ནི་ཤིང་མཐོང་བ་ནའོ།",
    "དེ་ཞེས་བྱ་བ་སྣང་བ་ཐ་དད་པ་ཐ་དད་པར་བྱེད་པ་སྟེ།",
    "དངོས་པོ་འགའ་ཡང་ཐ་དད་པར་མི་འགྱུར་རོ།",
    "རྣམ་པ་གཞན་གྱི་སྒོ་ནས་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་དུ་སྒྲུབ་པས་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "སྒྲ་དང་རྟགས་དང་རྣམ་པར་རྟོག་པ་རྣམས་ནི་ཡུལ་གཅིག་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དྲན་པ་དང་མངོན་སུམ་གཉི་ག་ལ་ལྐོག་ཏུ་གྱུར་པ་ལ་འཇུག་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པ་ཡིན་ན་ནི།",
    "དེ་ལྟ་ན་ཡང་ཇི་ལྟར་རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་ཞེ་ན།",
    "མངོན་སུམ་རྟོག་པ་དང་བཅས་པ་ཡིན་པར་གྱུར་ནའོ།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པ་དང་བཅས་པར་མ་གྱུར་ནའོ།",
    "ངེས་པའི་རྣམ་པར་བརྗོད་པ་ནི་འདི་ནི་ཞེས་བྱ་བའོ།",
    "༢ཨྰ་ཌཤི་༤༥ ༢བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་མངོན་སུམ་སྐྱེ་བར་འགྱུར་བའོ།",
    "ཅི་སྟེ་ཤེས་པ་གཉིས་གལ་ཏེ་གཅིག་ཏུ་མ་གྱུར་ན་ཐ་སྙད་ཉིད་མེད་པར་ནི་འགྱུར་རོ་ཞེ་ན་ཐ་སྙད་ནི་ཞེས་གསུངས་སོ།",
    "ཚོགས་པ་ཙམ་གྱིས་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པར་ཡང་ཐ་སྙད་སྟོན་པ་ནི་གཞན་ཞེས་བྱ་བའོ།",
    "དེའི་ཚེ་ཡང་མཐོང་བཞིན་ལ་ཞེན་པ་ཡོད་པ་ཡིན་ནོ་ཞེས་༤རྣམ་པར་རྟོག་པ་གཞན་ཞེས་བྱ་བའོ།",
    "ད་ནི་རྣམ་པར་རྟོག་པ་ཡོད་ཀྱང་ཐ་སྙད་མེད་དོ་ཞེས་གསུངས་པ་ནི་སྒྲ་སྦྱོར་བར་བྱ་བའོ།",
    "ཡང་ཇི་ལྟར་ན་འདིའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་འཇུག་པ་མདུན་ན་གནས་པའི་དངོས་པོ་ངེས་པ་ཉིད་མི་འཐད་སྙམ་ན་འདི་ལ་ཞེས་སྨོས་སོ།",
    "ངེས་པར་མ་བྱས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པས་མ་བཟུང་བའོ།",
    "༤༥ ༣པ་ཅན་གྱི་རྣམ་པར་རྟོག་པས་སོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པར་གྱུར་པས་གསལ་བའི་རྣམ་པར་ཉམས་སུ་མྱོང་བའི་རང་བཞིན་ལ་ཐ་སྙད་མི་སྲིད་པར་ཇི་ལྟར་འགྱུར་ཞེས་འབྲེལ་ཏོ།",
    "དེ་ལྟར་བློ་ཉམས་སུ་མྱོང་བ་མེད་པར་ཁས་བླངས་ནས་བརྗོད་པ་ཡིན་ནོ་། དེ་ནི་གཟུགས་ཀྱི་བློ་ལ་ཡང་ཉམས་སུ་མྱོང་བ་ཡོད་པ་ཉིད་དོ་ཞེས་བསྒྲུབ་པ་བརྗོད་པ་ནི་དེ་ཞེས་བྱ་བའོ།",
    "དེའི་ཚེ་རྣམ་པར་རྟོག་པ་གཉིས་ཞེས་བྱ་བ་གཟུགས་ཀྱི་རྣམ་པར་རྟོག་པ་དང་།",
    "ཅི་སྟེ་དང་པོ་གཟུགས་རྣམ་པར་རྟོག་པ་ཡིན་ལ།",
    "ཕྱིས་ནི་བདག་ཉིད་རྣམ་པར་རྟོག་པ་ཡིན།",
    "གཅིག་ལ་ཞེས་གསུངས་སོ།",
    "དོགས་པ་ན་རིམ་པ་མ་ཡིན་པ་ཉིད་ཡིན་པར་འགྱུར་རོ།",
    "འདི་ལ་བརྗོད་པ་ནི་ཐུག་པ་མེད་པར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་བློ་གཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ཡང་བཟླས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པ་ལ་རྣམ་འགྲེལ་ཉིད་འགོད་པ་ནི་དེས་ནི་ཞེས་བྱ་བའོ།",
    "དུས་མཚུངས་པའི་རྣམ་པར་ཤེས་པ་ཉམས་སུ་མྱོང་བ།",
    "༤༥༥པའི་རང་བཞིན་གྱི་རིག་པ་བློ་ཕྱི་མས་མི་གཟུང་བའི་འོན་ཀྱང་རིག་པ་ཙམ་ཞིག་མཐུན་པར་འགྱུར་རོ་ཞེས་དགོངས་པའོ།",
    "དེ་ལྟ་ན་ཡང་གཟུགས་ཀྱི་བློ་ནི་གཟུང་བར་འགྱུར་རོ་ཞེ་ན་བློ་གཞན་ཡང་ཞེས་གསུངས་ཏེ།",
    "གཟུགས་འཛིན་པ་དེ་ནི་འདས་པའི་རང་བཞིན་ཁོ་ནར་མངོན་སུམ་གྱིས་འཛིན་པ་དེས་ན་བྱུང་བར་གྱུར་ཏོ་ཞེས་བྱ་བར་འགྱུར་རོ་ཞེ་ན་དེ་ལྟར་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ཡིན་དང་གཟུགས་འཛིན་པ་ཡོད་དོ་ཞེས་བྱ་བ་མི་འཐད་པར་འགྱུར་ཏེ་འདས་པ་ནི་ད་ལྟར་བ་ཉིད་དུ་བསྟན་པ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་སྔར་གཟུགས་འཛིན་པ་ད་ལྟར་བྱུང་བ་ཡིན་ལ་ཞེས་རིག་པར་བྱའོ།",
    "འོན་ཏེ་འདས་པ་དང་ད་ལྟར་གཅིག་ཡིན་ན་གཉི་ག་ཡང་ད་ལྟར་བ་དང་འདས་པ་ཉིད་དུ་འཛིན་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་མངོན་སུམ་གྱིས་གཟུང་བའི་དངོས་པོ་དེ་ཁོ་ན་ལྟར་རྣམ་པར་འཇོག་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གལ་ཏེ་མངོན་སུམ་ལ་ེརིམ་པར་སྣང་ན་འདི་རིམ་པ་ཅན་ཁོ་ནར་འགྱུར་ཏེ།",
    "རིམ་གྱིས་གཟུང་བ་ནི་རིམ་པ་མེད་པར་མི་འཐད་དོ།",
    "གལ་ཏེ་ངེས་ེཔ་ལ་རིམ་གྱིས་འཛིན་པ་མི་སྲིད་ན་འོ་ན་དྲན་པར་འགྱུར་རོ་ཞེ་ན་དྲན་པ་ཡང་ཞེས་བྱ་བའོ།",
    "འདི་ཇི་ལྟར་ཤེས་པར་བྱ་བ་ཡིན་ཞེས་བྱ་བ་ནི།",
    "འདོད་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི་རང་རིག་པ་མེད་པར་སྨྲ་བར་རིག་པ་ཅན་ལ་སོགས་པ་ནི་ཇི་ལྟར་གཞན་གྱི་བློ་བློ་གཞན་གྱིས་ཡོངས་སུ་གཅོད་པ་དེ་བཞིན་དུ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པ་གསལ་བའི་དོན་དུ་སྨྲས་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་མངོན་སུམ་དུ་བྱས་པ་ཡང་འདས་པ་ཉིད་དུ་འགྱུར་བའིའོ།",
    "གལ་ཏེ་མངོན་སུམ་གྱིས་དེའི་རང་བཞིན་ནམ་ཡང་མ་རྟོགས་ན་དེའི་ཚེ་ཇི་ལྟར་རྗེས་སུ་དཔག་པས་ཀྱང་རྟོགས་པར་འགྱུར་ཞེས་བསམས་པའོ།",
    "དེ་དང་གཞན་གྱིས་བྱས་པ་ཞེས་བྱ་བ་ནི་རང་རིག་པ་དང་རིག་པ་མ་ཡིན་པས་བྱས་པའོ།",
    "གཟུགས་ཀྱི་བློའི་བློ་གང་ཡིན་པ་དེ་ཡང་འཛིན་པ་དེ་དེའི་འཛིན་པར་བྱེད་པ་ཡང་གཞན་ཡིན་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་འགྱུར་ན་ནི་ཞེས་བྱ་བ་ནི་ཐུག་པ་མེད་པར་འགྱུར་བའོ།",
    "འཆད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "རྒྱུན་མི་འཆད་པར་སྣང་མི་འགྱུར།",
    "གཅིག་ཏུ་ནི་རིགས་གཅིག་པར་རོ།",
    "མངོན་སུམ་དུ་གཅིག་ཉིད་ཅེས་བྱ་བ་ནི་མངོན་སུམ་གྱི་ངོ་བོར་གཅིག་པ་ཉིད་གང་ཡིན་པ་དེ་དང་ལྡན་པར་རྟོགས་པར་མི་འགྱུར་རོ།",
    "ཕྱི་མ་རྣམས་རྣམ་པར་ཆད་པར་སྣང་བ་ཡིན་གྱི།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་འཛིན་པ་གང་ཡིན་པའི་གཟུང་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་བཞིན་དུ་ཡིན་པར་ཁས་བླངས་ན་ནི།",
    "ཁྱད་པར་སྒྲ་དང་སྦྱོར་བ་མེད་པའི་ཕྱིར་རོ།",
    "ཉིད་ཀྱི་སྒྲའི་རྣམ་པར་གཅད་པར་བྱ་བ་བརྗོད་པ་ནི་མིག་ལ་སོགས་པ་ཞེས་བྱ་བའོ།",
    "མིག་ལ་སོགས་པའི་རྒྱུན་གཅིག་ལ་རག་ལས་པའི་ཤེས་པ་གང་ཡིན་པ་དེ་འདིའོ་སྙམ་པས་དེས་གཟུང་བ་མ་ཡིན་པར་མངོན་སུམ་ལ་སྣང་བའི་གེག་ལ་སོགས་པར་མི་འགྱུར་ཏེ།",
    "ཁྱད་པར་མེད་པ་ཉིད་བསྟན་པའི་དོན་དུ་གཞན་གྱི་བརྗོད་པ་ནི་རང་བཞིན་གཉིས་ཞེས་བྱ་བའོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དོན་དམ་པར་གཞི་མཐུན་པ་མེད་པ་ཉིད་དུ་སྟོན་པར་བྱེད་དོ།",
    "བག་ཆགས་སད་པ་ཡང་གཞན་ལ་ཅི་སྟེ་མེད་སྙམ་ན་དོན་བྱ་བའི་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པ་དང་།",
    "བདག་ཉིད་ཐམས་ཅད་དམ་རྣམ་པའགའ་ཡངསྤྱི་ལས་ཁྱད་པར་ཐ་དད་པ་མེད་པ་གང་ཡིན་པ་དེའི་ཕྱིར་གལ་ཏེ་ཁྱད་པར་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་ཤེས་པའི་རིགས་པ་ཡིན་ན། དེའི་ཚེ་ཤེས་པ་ིཀུན་གཅིག་ཏུ་འགྲོ་བར་འགྱུར་ཏེ།",
    "ཤེས་པ་ཐམས་ཅད་སྤྱི་དང་ཁྱད་པར་གྱི་རྣམ་པ་ཅན་དུ་རྟོགས་པར་འགྱུར་རོ་ཞེས་དགོངས་པའོ།",
    "ཁྱད་པར་དང་བཅས་པའི་སྤྱི་སྒྲའི་ཤེས་པ་ལ་མི་སྣང་བ་ཡིན་ནོ་ཞེ་ན་འདི་ལ་བརྗོད་པ་ནི་དེ་ཉིད་ཅེས་བྱ་བའོ།",
    "ཁྱད་པར་དེ་དང་ལྷན་ཅིག་རྗེས་སུ་ཞུགས་པ་མ་ཡིན་ཏེ་འདྲེས་པ་མ་ཡིན་པ་ནིའོ།",
    "དེའི་ཚེ་ནི་འདྲེས་པར་གྱུར་པའི་དུས་ནའོ།",
