    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་ནང་དུ་བལྟས་ཏེ་འདུག་ག་གོ།",
    "དེའི་ཚེ་ན་བཙུན་པ་འཆར་ཀ་དེ་ཉིད་ན་འདུག་པར་གྱུར་ཏ་མ་འདུག་གོ།",
    "དབེན་པ་སྐྱབས་ཡོད་པ་ན་སྟན་ལ་འདུག་ཏུ་རུང་ངང་མ།",
    "རུང་ཡང་སྲིད་མི་རུང་ཡང་སྲིད་དེ་ཁོ་བོ་དེ་ལྟར་འདུག་གོ་ཞེས་ཟེར་ནས།",
    "དབེན་པ་སྐྱབས་ཡོད་པ་ན་སྟན་ལ་འདུག་པའོ།",
    "གཉི་ག་རྐུབ་ཚོས་༡བཞག་སྟེ་འདུག་པའོ།",
    "སྦེད་མ་གཙུག་ལག་ཁང་ན་ཕྱག་དར་བྱེད་ཅིང་འདུག་གོ།",
    "དབྱར་ཁང་འདི་དེ་ཁོ་ན་བཞིན་དུ་ཕྱག་དར་དང་བཅས་པར་འདུག།",
    "སྔར་འདུག་པ་ཞེས་སྨོས་༡པའི་གནས་སུ་འདིར་འགྲེང་བ་ཞེས་བརྗོད་པར་བྱའོ།་",
    "སྡོམ་ལ་ཡང་ཡང་དང་ནི་འདུག་གནས་ག་ཅིག།",
    "འདུག་གནས་སུ་ཟ་བ་དང་།",
    "མཐའ་ག་ཅིག་ཏུ་འདུག་གོ།",
    "བསོད་སྙོམས་པ་དེའི་མདུན་དུ་འདུག་པ་དང་།",
    "རི་བྲགས་ཤིག་༦ན་ཁྱིམ་བདག་ག་ཅིག་འདུག་པ་དེས།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་དོན་དུ་འདུག་གནས་བྱེད་དུ་བཅུག་སྟེ།",
    "དེ་འདུག་གནས་༧དེ་ན་ཕྱོགས་བཞིའི་དགེ་སྦྱོང་དང་།",
    "བྲམ་ཟེ་གང་འདུག་པ་དེ་ལ་བསོད་སྙོམས་ཀྱི་མཁོ་བ་སྟོབས་པར་བྱེད་ད་དོ།",
    "འདུག་གནས་༢ག་ཅིག་ཏུ་ཞག་ལོན་པའི་དགེ་སློང་མི་ན་བས་བསོད་སྙོམས་ག་ཅིག་ཟ་བར་བྱའོ།",
    "ཉེས་པ་ནི་འདུག་གནས་༥ག་ཅིག་ཏུ་ཞག་ལོན་པས་བསོད་སྙོམས་ག་ཅིག་ལས་ལྷག་པར་ཟ་བའོ།",
    "འདུག་གནས་ག་ཅིག་ཏུ་ཞག་ལོན་པའི་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་གྱི་༦འདུག་གནས་སུ་ཞག་ལོན་པའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ག་ཅིག་འདུག་པ་དེས་༢རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་དེས་རིགས་༢མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "དེ་རང་ཉིད་སོ་ནམ་བྱེད་ཅིང་འདུག་ག་གོ།",
    "དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་༡དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "དེས་དེ་མདུན་དུ་ཙོག་པུར་འདུག་དུ་བཅུག་སྟེ།",
    "བདག་སློབ་དཔོན་འདིས་རྟག་ཏུ་མདུན་དུ་ཙོག་པུར་འདུག་ཏུ་བཅུག་སྟེ།",
    "ཟས་གང་ཡང་རུང་བ་ཅུང་ཟད་ཀྱིས་གཞིའི་འདུག་གནས་སུ་ཟ་བའམ་འདུས་ཤིང་ཟ་བ་གང་ཡང་རུང་བ་གཅིག་ལ་མ་བསྲུལ་བ་དང་།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་དུས་མ་ཡིན་པར་བ་ཅའ་བ་དང་།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་དང་།",
    "བྱིན་ལེན་གྱི་མཚན་ཉིད་མངོན་སུམ་དུ་མཚམས་ཀྱི་ནང་དུ་འཐོབ་པའི་ཕྱོགས་ན་འདུག་པའམ་༡།",
    "ལག་པ་བཀན་པས་ལུས་སམ་དེ་དང་འབྲེལ་བར་གྱེན་དུ་འབྲེལ་བར་འདུག་༢ནུས་པ།",
    "མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "དགེ་སློང་རང་སྤྱོད་པའི་དོན་དུ་ལུས་ཀྱི་ཉེ་བར་སྤྱོད་པའི་མཚན་ཉིད་ད་དང་།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཉེས་པ་ནི་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པའོ།",
    "སྔ་མ་ནི་མངོན་སུམ་དུ་བརྣག་༢པས་འདུག་པའི་ཡུལ་ལ་རྣམ་པར་གཞག་གོ།",
    "ཁམས་དང་རང་བཞིན་ཐུགས་སུ་ཆུད་ནས།",
    "རྒྱལ་པོས་༡དེ་ཉིད་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་པ་དང་།",
    "གལ་ཏེ་དེ་མཆིས་པར་གྱུར་ན་དེའི་མཐུས་རི་བྲགས་པ་འདི་ཕེབས་པར་འགྱུར་བ་གང་ལགས་པ་དེ་ལྟ་བུ་༢གནས་མཆིས་པར་འགྱུར་གདའོ།",
    "བདག་ཅག་དུས་ལ་བབ་པ་ན།",
    "བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ནང་ན་གནས་པའི་ཚེ་ཡང་ཞེས་བྱ་བ་ནི་འདུག་པའི་ཚེ་ཡང་ང་ངོ།",
    "དབེན་པའི་ཕྱོགས་སུ་འདུག་ནས་ཡིད་ལ་བྱེད་པ་བསྐྱེད་༤པར་བརྩམས་ས་སོ།",
    "ཟས་ཟོས་ནས་ཕྱིར་འོངས་ས་སོ་། དེའི་འོག་ཏུ་དགའ་བོ་ཡང་ཁྱིམ་བདག་དེའི་ཁྱིམ་དུ་དོང་སྟེ་ཟན་ཟ་ཞིང་འདུག་ག་གོ།",
    "འདུག་པ་བདེ་བ་མ་ཡིན་གྱི་༤།",
    "དགེ་སློང་གླེང་བ་པོ་རྒན་པའི་༨མཐའ་ལོགས་སུ་འདུག་སྟེ།",
    "དེས་རྙེད་པ་ཐམས་ཅད་དེ་དག་ལ་སྦྱིན་༢ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་ག་གོ།",
    "ཀུན་དགའ་ར་བར་གཏོགས་པ་ན་འདུག་པའམ།",
    "ཀུན་དགའ་ར་བར་གཏོགས་པ་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བའི་ཕྱི་རོལ་ནའོ།",
    "གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བའི་ནང་ནང་ནའོ།",
    "མ་གཏོགས་ཏེ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བར་གཏོགས་པ་ན་འདུག་པའམ།",
    "གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་བཞག་སྟེའོ།",
    "གཙུག་ལག་ཁང་དང་དེའི་ཉེན་ཀོར་ན་འདུག་པ་མ་ཡིན་པ་ཉིད་ད་དང་།",
    "བཞིས་གྲོགས་བྱེད་ཅིང་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་དག་འདི་ག་ཅིག་པུ་ཕར་རྒྱུག་ཚུར་རྒྱུག་ཅིང་འདུག་པ་༡༧།",
    "དེས་༢ཅང་མི་སྨྲ་བར་འདུག་ག་གོ།",
    "རྒྱལ་པོ་སྐྱེངས་ནས་ཅང་མི་སྨྲ་བར་འདུག་ག་གོ།",
    "ལྷས་དེ་ནི་གསན་ན་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་ན་དགེ་སློང་འདུག་པ་ན་འདོད་ཆགས་དང་བཅས་ཞེ་སྡང་དང་བཅས།",
    "རྒྱལ་པོ་ཐོས་པ་ཉུང་བས་དེ་ཅང་མི་སྨྲ་བར་འདུག་ག་གོ།",
    "རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་ཅིག་༤འདུག་པ་དེ་ལ་བུ་གཉིས་དང་།",
    "བསྲང་སྟེ་༡དྲན་པ་ཕྱོགས་པར་བཞག་ནས་འདུག་གོ།",
    "དེ་ཕྱི་དེ་ཉིན་པར་ལུས་དག་༧འབྲུ་མར་གྱིས་བསྐུ་མཉེ་བྱས་ནས་ཁྲི་ལ་ཉལ་ཞིང་འདུག་པ་དང་།",
    "ཚུར་ཤེག་ཡུ་བུ་ཅག་ཆུའི་ནང་དུ་གང་ཡུན་རིང་དུ་འདུག་ཕོད་པ་ལྟའོ།",
    "དེ་དག་ད་དུང་ཆུའི་འོག་ན་འདུག་གོ་སྙམ་ནས།",
    "དེའི་ཚེ་༢ཚེ་དང་ལྡན་པ་གྱད་༢བུ་ནོར་རྒྱལ་པོའི་ཁབ་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་རྫིང་བུ་རྡོ་རྩིག་༤ཅན་ཞེས་བྱ་བའི་འགྲམ་ན་འདུག་གོ།",
    "རྒྱལ་པོའི་ཁབ་ན་ཐ་ག་པ་སྤྱི་ཅེར་༡ཞེས་བྱ་བ་ཞིག་འདུག་པ་དེས།",
    "མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པ་དང་།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས།",
    "ཅང་མི་སྨྲ་བར་ཉན་རྣས་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཅང་མི་སྨྲ་བར་ཉན་རྣས་འདུག་ན་ཞེས་བྱ་བ་ནི་ཅང་མི་སྨྲ་༐",
    "ཉན་རྣས་འདུག་པ་ཉིད་ད་དང་།",
    "གླེང་བ་པོ་རྒན་པའི་མཐའ་ལོགས་སུ་འདུག་སྟེ་སྨྲས་པ།",
    "ཅང་མི་སྨྲ་བར་སྟན་ལས་ལངས་ཏེ་འགྲོ་ཞིང་དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན།",
    "དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན་ཞེས་བྱ་བ་ནི་དེ་ནི་དགེ་སློང་གང་འདུག་པ་ལའོ།",
    "དཔོང་སའི་ཁང་པར་འདུག་ཅིང་མཐུན་པར་གྱུར་པ་ན།",
    "རྩོད་ཅིང་འདུག་ལ།",
    "རྣམ་ཐོས་ཀྱི་བུའི་ནོར་ལ་འགྲན་པ་ཞིག་འདུག་པ་དེས།",
    "ཚེ་དང་ལྡན་པ་ལེགས་འོངས་ནི་ཆུ་སྲིན་བྱིས་པ་གསོད་ཀྱི་རི་ལ་ཁྱིམ་བདག་རྟོགས་ལྡན་གྱི་ཆུང་པོ་གྲོགས་བྲམ་ཟེ་སྦྲུལ་ཁས་བསྡིགས་པ་ཞིག་འདུག་པ་དེ།",
    "དེ་ནས་བྲམ་ཟེ་དེས་ཚེ་དང་ལྡན་པ་ལེགས་འོངས་བདེ་བར་འདུག་པར་རིག་ནས།",
    "དགེ་སློང་དག་ཉེས་དམིགས་འདི་དང་གཞན་དག་ཀྱང་དགེ་སློང་དག་དུས་མ་ཡིན་པར་གྲོང་དུ་འཇུག་པ་ལས་གྱུར་པས།",
    "དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན།",
    "དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན་ཞེས་བྱ་བ་ནི་དེ་ན་དགེ་སློང་གང་འདུག་པ་ལའོ།",
    "དགེ་སློང་འདུག་པ་ལ་སྨྲ་བར་བྱ་བ་དེ་སྲིད་དུ་དེའི་ལྷུང་བཟེད་ད་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་༢འདུག་པ།",
    "འདུག་པར་བྱ་ཞིང་འདི་ལ་འགྱོད་པར་མི་བྱའོ།",
    "ཉེ་དགའ་ཤགས་མེད་ནས་ཅང་མི་སྨྲ་བར་འདུག་ག་གོ་། དེ་ན་ས་ཁྱིམ་བདག་དེས་བྲིམ་པར་བརྩམས་༧པ་དང་།",
    "སྔ་དྲོ་དང་ཕྱི་དྲོ་དག་ཁྱིམ་དག་ཏུ་རྒྱུ་ཞིང་ཁྱིམ་པ་འདུག་པ་ལ་མི་བསྒོ་ན།",
    "ཁྱིམ་པ་ལ་མི་བསྒོ་ན་ཞེས་བྱ་བ་ནི་དེ་ན་ཁྱིམ་པ་གང་འདུག་པ་ལའོ།",
    "ལན་མང་དུ་ལྟ་ཅི་སྨོས་ན་ཞེས་བྱ་བ་ནི་ལན་མང་དུ་འདུག་པར་ཤེས་པ་ལྟ་ཅི་སྨོས་ནའོ།",
    "དེ་ན་དགེ་སློང་ཞིག་འདུག་པ་དེས་སྨྲས་པ།",
    "ཡུད་ཙམ་ཞིག་གཏམ་འདྲི་བས་འདུག་ནས་སྨྲས་པ།",
    "༢པེ་སྣར་མཐའ་ག་ཅིག་ཏུ་འདུག་གོ།",
    "༢པེ་སྣར་འདུག་༤པེ་སྣར་བར།",
    "ཡོངས་སུ་གཟུང་བ་ཡངས་ཤིང་རྒྱ་ཆེ་བ་རྣམ་ཐོས་ཀྱི་བུའི་ནོར་དང་ལྡན་པ་ནམ་ཐོས་ཀྱི་བུའི་ནོར་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "ཡང་དགེ་སློང་གང་དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལམ་པོ་ཆེ་ན་འདུག་པ་བསོད་སྙོམས་ཀྱི་ཕྱིར་གྲོང་དུ་འགྲོ་བ་ལས་བཅའ་བ་༐",
    "ཐོས་པའི་ཉེ་འཁོར་ན་འདུག་པ་དག་ལ་ཡང་རུང་སྟེ།",
    "དགེ་སློང་བདག་ཉིད་ལམ་པོ་ཆེ་ན་འདུག་པས།",
    "གཉི་ག་ལམ་པོ་ཆེ་གྲོང་ན་འདུག་པ་ཉིད་ད་དང་།",
    "བསྒོ་བའི་ཚིག་ཉེ་བར་གདགས་སུ་མི་རུང་བར་ཐག་རིང་བ་མ་གཏོགས་པ་དེ་ན་འདུག་པ་ནི་བྱེད་པ་པོ་ཡིན་ན་ནོ།",
    "ཤིང་རྟ་དག་ཀྱང་ཤིང་རྟའི་མདའ་དང་བྲལ་ཏེ་འདུག་ག་གོ།",
    "ཇི་ཙམ་ན་ལམ་ཁ་ན་ཤིང་རྟ་བཅའ་བ་དང་བཟའ་བས་གང་བ་ཤིང་རྟ་མདའ་དང་བྲལ་བ་དག་འདུག་པ་དང་།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "ཤམ་ཐབས་ཅི་ནས་ཟླུམ་པོར་༨འདུག་པར་འགྱུར་བ་དེ་ལྟར་བགོ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལྟ་བུར་བསྒྲུབ་པའི་ཚུལ་གྱིས་བསྟན་ཏོ།",
    "དེ་ལ་ཤམ་ཐབས་ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་མཐའི་ཁ་མཉམ་པར་འདུག་པ་སྟེ།",
    "ཉེས་པ་ནི་ཤམ་ཐབས་འབྲུའི་ཕུར་མ་ལྟར་འདུག་པར་༧གྱོན་པའོ།",
    "དེ་ལ་འབྲུའི་ཕུར་མ་ལྟར་ཞེས་བྱ་བ་ནི་གློ་ནས་ཕྱི་རོལ་གྱི་རིམ་པའི་གྲ་༨ཕུར་མ་ལྟར་འདུག་པ་སྟེ།",
    "ཤམ་ཐབས་བྱིན་གྱིས་མ་བརླབས་༢པ་ལ་སོགས་པ་དག་ལ་ཡང་རྣམ་པ་འདི་དག་རིག་༢པར་བྱའོ་། ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་༤མཐའི་ཁ་མཉམ་པར་འདུག་པ་སྟེ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "དེ་ལ་མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བྲམ་ཟེ་དེ་ཕྱིར་བྱུང་བ་དང་ཉེ་དགའ་རྐང་པ་དང་བཅས་པར་མལ་གྱི་སྟེང་དུ་འཛེགས་ཏེ་འདུག་པར་མཐོང་ངོ།",
    "མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་༦ལ་མི་འདུག་པར་བསླབ་པར་བྱའོ་༧ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་མ་བསྒོ་བ་དང་འདུག་པ་ཉིད་ད་དོ།",
    "སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བ་ར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱའོ།",
    "འདུག་པ་ཉིད་དོ།",
    "ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ལྗིད་ཀྱིས་༩ཕབ་སྟེ་འདུག་པར་བརྩམས་པ་དང་།",
    "དེ་དག་གནས་སུ་སྨད་དོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་༡པ་ནི་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ཕབ་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "ཏྲིགས་ཞེས་འདུག་པར་མི་བྱ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་༢ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་འབེབས་པ་དང་འདུག་པ་ཉིད་ད་དོ།",
    "རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་བསྣོལ་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་བསྣོལ་བ་ཞེས་བྱ་བ་ནི་རྐང་པའི་སྟེང་དུ་རྐང་པ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་༐",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་བསྣོལ་བ་དང་འདུག་པ་ཉིད་ད་དོ།",
    "སྔ་མ་བཞིན་དུ་བརླ་མི་༢བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་བརླ་བསྣོལ་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་བརླ་མི་བསྣོལ་བ་ཞེས་བྱ་བ་ནི་བརླའི་སྟེང་དུ་བརླ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "པོ་ནི་༤བརླ་བསྣོལ་བ་དང་འདུག་པ་ཉིད་དོ།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་བཞག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་བཞག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་༐",
    "ཉེས་པ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་ལོང་བུ་མི་གཞག་པར་༢ཞེས་བྱ་བ་ནི་འོང་བུའི་སྟེང་དུ་ལོང་བུ་གཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་གཞག་པ་དང་འདུག་པ་ཉིད་ད་དོ།",
    "རྐང་པ་མི་དགུག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བ་ཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་རྐང་པ་མི་དགུག་༨པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་ད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་དགུག་༡སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་དགུག་པར་ཞེས་བྱ་བ་ནི་རྐང་པ་གཉིས་འགབ་ཀུང་དུ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་བཀུག་པ་དང་འདུག་པ་ཉིད་ད་དོ།",
    "མི་གདང་བར་༡༧ཁྱིམ་གཞན་དུ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་ཏྲ་གཞི་ནི།",
    "རྐང་པ་མི་གདང་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་གདངས་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "རྐང་པ་གཉིས་བར་དག་སོ་སོར་ཕྱེ་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་༨ནི་རྐང་པ་གདངས་པ་དང་འདུག་པ་ཉིད་ད་དོ།",
    "ཡང་ན་ཐམས་ཅད་ཀྱང་རུང་བ་ཐད་ཀར་གདངས་ཏེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱ་བ་མན་ཆད་འདི་ཡན་ཆད་ཐམས་ཅད་ནི་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "སྟན་ལ་འདུག་པའི་རིམ་པ་༐",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་༡༧ནས་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བ་ཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བ་ཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་༡༡ཐོས་ནས་སྐྱེང་ས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་ད་དེ།",
    "ཐག་རིང་པོར་འདུག་པ་ཡང་འདིར་བསྡུས་པར་རིག་༥པར་བྱའོ།",
    "ཏྲ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་༥གཏོར་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་ད་དེ།",
    "དེ་ལ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བ་ཞེས་བྱ་བ་ནི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་གཏོར་བར་མི་བྱ་བ་སྟེ།",
    "འདིར་ཡང་དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པ་༢ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་ད་དེ།",
    "དེ་ལ་ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བ་ཞེས་བྱ་བ་ནི།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེའི་བུ་ན་བར་གྱུར་ནས།",
    "བཞོན་པའི་སྟེང་དུ་༨འདུག་པ་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "མི་ན་བར་འདུག་པ་ལ་༐",
