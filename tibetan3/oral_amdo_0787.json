    "འདི་ཡང་ཀུན་གཞིའི་སྟེང་གི་ས་བོན་ལ་དགོངས་སོ།",
    "འོ་ན་སྐྱེ་མཆེད་དྲུག་གི་ཁྱད་པར་ཞེས་པ་གང་ཞེ་ན།",
    "དེ་ལ་དང་པོ་གཉིས་ཀྱིས་ནི་སྐྱེ་མཆེད་དྲུག་ནང་གི་ལ་འདོད་པས་སྐྱེ་མཆེད་གང་ཡིན་ལ་མ་འཁྲུལ་ཡང་སྐྱེ་མཆེད་དྲུག་པ་དང་དྲུག་ཉིད་རིགས་སུ་འདོད་པ་ནི་འཁྲུལ་ལ།",
    "ནང་གི་སྐྱེ་མཆེད་ཡིན་པར་ཅིས་ཤེས་ཤེ་ན།",
    "ས་བོན་དེ་ཡང་འདུས་བྱས་ལས་དེ་ཉིད་གཞན་དང་གཞན་དུ་བརྗོད་པ་ལས་གྲོལ་༡ བ་གཟུང་བར་མི་ནུས་པ་སྐྱེ་མཆེད་དྲུག་གི་ཁྱད་པར་ཞེས་བྱ་བའོ།",
    "དེ་ལྟར་ན་ནང་གི་སྐྱེ་མཆེད་དྲུག་གམ་གང་རུང་གཅིག་ལྡན་པས་ཀྱང་ཆོག་པས་སྐྱེ་མཆེད་དྲུག་གི་རིགས་ཀྱི་ཁྱད་གཞིའམ་གནས་སྐབས་ཅན་ནོ།",
    "གང་གི་ཚེ་འབྲས་བུ་སྐྱེད་ཅིང་འབྲས་བུ་གྲུབ་པ་དེའི་ཚེ་ན་ནི་ས་བོན་གང་ཡིན་པ་དེ་དང་འབྲས་བུ་གང་ཡིན་པ་དེ་གཅིག་ཏུ་བསྡུས་ནས་དེའི་ཕྱིར་རིགས་དེ་རགས་པ་ཞེས་བྱ་བར་སྟོན་པར་འགྱུར་རོ།",
    "དེ་ལྟར་བྱས་ན་ཉི་སྣང་ལས་གཞན་དག་ནི་རིགས་ནི་སྐྱེ་མཆེད་དྲུག་གི་ཁྱད་པར་ཡིན་ནོ།",
    "ནང་གི་དགའ་བ་ཡང་དང་ཡང་དུ་ལྡང་།",
    "དེ་དག་གིས་ནི་རང་བཞིན་དུ་གནས་པའི་རིགས་ལ་རང་བཞིན་དུ་བརྗོད་པའི་དོན་བརྗོད་དགོས་སོ།",
    "ཡང་ན་དེ་དག་གི་རིགས་ནི་བཏགས་པ་བ་ཡིན་ལ་འདི་ནི་མཚན་ཉིད་པ་ཡིན་ཏེ།",
    "ཐམས་ཅད་གཟིགས་པ་རྣམས་ཀྱི་ཡུལ།",
    "སེམས་ཙམ་པ་ནི་སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་བ་དེ་གཤིས་ལ་རང་གི་ངོ་བོས་དུས་ཐམས་ཅད་དུ་གྲུབ་ཅིང་དྲི་མ་དེ་དག་དེ་ལ་གཉེན་པོས་འབྲལ་དུ་རུང་ལ།",
    "ཕྱི་མ་ནི་གྲོལ་དཀའ་བ་ཙམ་ལ་དགོངས་ཀྱི་རིགས་གཏན་ཆད་མི་སྲིད་དེ་དྲི་མ་སྤང་དུ་མི་རུང་ན་སེམས་ཀྱི་རང་བཞིན་དུ་ཐལ་བར་འགྱུར་ལ།",
    "མིང་གི་རྣམ་གྲངས་ནི།",
    "དེ་བཞིན་དུ་སྦྱོར་ལམ་ལྷག་མ་དང་མཐོང་སྒོམ་གྱི་རྟེན་ལ་ཡང་རང་རང་གི་སྐབས་ཀྱི་རྣམ་རྟོག་དང་དཔེ་དོན་སྦྱོར་ཞེས་ཉི་སྣང་ལས་གསུངས་པ་བསྟན་པར་བྱའོ།",
    "རྩེ་མོའི་རྟེན་ནི།",
    "འདུས་མ་བྱས་ཀྱི་དབྱིངས་དང་འདུས་བྱས་ཀྱི་ཁམས་ལ་རིམ་པ་ལྟར་འདུས་བྱས་ཀྱི་ཁམས་དང་འདུས་མ་བྱས་ཀྱི་དབྱིངས་ཀྱི་གནས་མེད་ཅིང་མི་དམིགས་པའི་དཔེ་བཞིས་མཐོང་སྤང་གི་རྟོག་པ་བཞི་མཚོན་ནས་སོ།",
    "རྣམ་བྱང་མེད་པའི་ཚིག་གི་དོན་མེད་ཅིང་མི་དམིགས་པའི་དཔེ་བདུན་དང་།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པ་ལ་གནས་མེད་ཅིང་མི་དམིགས་པའི་དཔེ་དགུས་ས་དགུའི་སྒོམ་སྤང་གི་རྟོག་པ་དགུ་མཚོན་ནས་སོ།",
    "འོ་ན་སྒོམ་སྤང་གི་རྟོག་པ་ཡང་བཞིར་ཡོད་པས་དཔེ་བཞིར་རིགས་ཤེ་ན།",
    "འདིའི་སྐབས་སུ་སྐྱེ་བ་མེད་པ་སོགས་གཅིག་ཏུ་བྱས་ནས་དཔེ་གསུམ་དུ་འགྱུར་བས་དགུར་བྱས་ཏེ་སྒོམ་སྤང་ལ་ཆེ་འབྲིང་གི་སྒོ་ནས་དགུར་འབྱེད་ལ་མཐོང་སྤང་ལ་དེ་ལྟར་ཕྱེ་བ་མེད་པས་སོ།",
    "དེ་བཞིན་དུ་དེའི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་དང་རྣམ་པར་གྲོལ་བ་དང་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་གཟིགས་པ་ལ།",
    "གྲོལ་བའི་ཡེ་ཤེས་མ་གཟིགས་པའི་གནས་མེད་ཅིང་ཞེས་སོ།",
    "འདིས་ནི་གཟའ་ལ་སོགས་པའི་འོད་ཀྱིས་མཚོན་པའི་ཉན་རང་གི་ཡེ་ཤེས་དང་ཐུན་མོང་མིན་པར་མཐའ་ཡས་པའི་འཇིག་རྟེན་དུ་འཕྲོ་བའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ཅན་དུ་གསུངས་སོ།",
    "འཇུག་པའི་དོན་དེར་གཞན་ཞིག་འཇུག་པ་རུ་མི་༡ སྣང་གི་ཡེ་ཤེས་རང་གི་༢ འཇུག་ཚུལ་དུ་སྣང་བའི་ཕྱིར་རོ།",
    "རེ་ཞིག་ནི་རིམ་པ་སྟོན་པའོ།",
    "ཐབས་གང་གིས་སྤོང་ན་སྤང་གཉེན་དེ་དག་མི་དམིགས་པར་མངོན་སུམ་དུ་རྟོགས་པས་སོ།",
    "ཐབས་གང་གིས་སྐྱེད་ན།",
    "ཐབས་གང་གིས་འགོད་ན་གཞུག་པ་ལ་ལྡེམ་པོར་དགོངས་པ་དང་སོགས་པས་ལྡེམ་དགོངས་ལྷག་མ་གསུམ་དང་དགོངས་པ་བཞིའི་སྒོ་ནས་སོ།",
    "གང་ཟག་གི་ནི་བསམ་པ་ལ།",
    "གང་ཟག་གི་བསམ་པ་ལ་དགོངས་པ་ནི།",
    "བརྗོད་བྱ་ཟབ་མོ་གཞན་དུ་འདྲེན་པ་ལ་བལྟ་སྟེ།",
    "ཉོན་མོངས་པས་ནི་རབ་ཉོན་མོངས།",
    "ཉོན་མོངས་པ་ནི་ཡུན་རིང་པོར་དཀའ་སྤྱད་ཀྱིས་ངལ་བའོ།",
    "དེས་ན་དགོངས་གཞི་གཞན་དུ་བཙལ་དགོས་པའི་སྒྲ་ཇི་བཞིན་མ་ཡིན་པ་རྣམས་ནི་དགོས་པ་འབའ་ཞིག་གི་ཕྱིར་མཛད་པ་ཡིན་གྱི་དགོངས་གཞིའི་ཕྱིར་མིན་ནོ།",
    "ཐད་ཀར་མི་སྟོན་པར་འཁྱོག་པོའི་ངག་གིས་བསྟན་པའི་དགོས་པ་འདིའོ་ཞེས་དགོས་པ་སྟོན་པའི་ཆ་ནས་ལྡེམ་པོར་དགོངས་པ་སྟེ་ལྡེམ་པོའམ་ལྡེའུའི་ངག་ནི་འཁྱོག་པོ་ཡིན་པས་སོ།",
    "ཊཱིཀ་བྱེད་དག་གིས་ནི་ཚུལ་འདི་ཙམ་ཡང་ལེགས་པར་མ་བརྟགས་སོ།",
    "གང་མིང་གི་ཚོགས་དང་ཚིག་གི་ཚོགས་དང་ཡི་གེའི་ཚོགས་ཀྱི་དོན་གཞན་དུ་བརྗོད་ལ་དོན་གཞན་དུ་ཡོངས་སུ་བསྒྱུར་བ་སྟེ།",
    "གཉེན་པོ་ལ་ལྡེམ་པོར་དགོངས་པ་ནི་གང་དུ་སྤྱོད་པ་བརྒྱད་ཁྲི་བཞི་སྟོང་གི་གཉེན་པོར་བསྟན་པའོ་ཞེས་གསུངས་པས་བཀའ་ཐམས་ཅད་དྲང་དོན་དུ་འགྱུར་ཞེ་ན།",
    "གཉིས་པ་ཡང་མི་འཐད་དེ་ལུང་དེའི་དོན་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་ང་རྒྱལ་དང་རྣམ་རྟོག་ལ་སོགས་པའི་ཉོན་མོངས་རྣམས་རིམ་པ་ལྟར་མི་སྡུག་པ།",
    "དབུགས་འབྱུང་རྔུབ་བགྲང་བ་སོགས་ཀྱི་གཉེན་པོས་རྫོགས་པར་སྤོང་བར་བསྟན་པ་རྣམས་སྒྲ་ཇི་བཞིན་པ་མིན་ཏེ་དེ་དག་རེ་རེས་མ་ལུས་པར་སྤང་མི་ནུས་པས་སོ།",
    "རིགས་བྱིན་བུད་དྷ་ཤྲཱི་ཤེར་འབྱུང་ནི་སྐྱེ་བའི་རིམ་པར་འདོད་དོ།",
    "ལྔ་པ་ནི་མཐོང་བའི་ལམ་མོ།",
    "བཅུ་གཉིས་པ་ནི་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་དང་སྲིད་པ་ཐ་མ་པའོ།",
    "བུད་དྷ་ཤྲཱིས་དྲུག་པ་ས་བདུན་པ་ཕྱིན་ཆད་དེ་ནས་གཅིག་དང་གཅིག་དང་བཞི་དང་གཅིག་ནི་རིམ་པ་ལྟར་ས་བརྒྱད་པ་དགུ་པ་བཅུ་པ་དེའི་ཁྱད་པར་གྱི་ལམ་ལ་བཞག་གོ།",
    "ཁ་ཅིག་བུད་དྷ་ཤྲཱིས་བདུན་བརྒྱད་གཉིས་ས་བརྒྱད་པ་ལ་བཞག་ཅེས་གསུང་བ་ནི་འགྲེལ་པ་དེ་མ་ངེས་པ་ཡིན་ནོ།",
    "བུད་དྷ་ཤྲཱིས་བདུན་བརྒྱད་ས་སོ་སོ་ལ་བཞག་པ་ཡང་སློབ་དཔོན་གྱི་དགོངས་པ་མིན་ནོ།",
    "ཚོགས་ལམ་དུ་ཕྱིར་མི་ལྡོག་གི་རྟགས་མ་ཐོབ་པས་མ་བཞག་སྟེ་འདིར་བསྟན་ཕལ་པའི་རིགས་ནི་ཚོགས་ལམ་ན་ཡོད་པར་ཉི་སྣང་དང་རྒྱན་སྣང་གི་རིགས་དང་སྦྱོར་ལམ་གྱི་འཆད་ཚུལ་ལ་རྩོད་པ་སྤོང་བས་ཤེས་སོ།",
    "གང་གི་ཆེད་དུ་ན།",
    "གང་གི་སྒོ་ནས་ན།",
    "ཞེས་བྱ་བ་དེ་ལྟ་བུའི་ལན་ཞིག་ཀྱང་བྱམས་པའི་མཁྱེན་པས་གཟིགས་མོད་ཀྱང་མ་བཀོད་ཅེས་པ་ནི་རིགས་སུ་འགྲོ་ཚུལ་དེ་རྒྱན་འདིར་ཚིག་གིས་མ་ཟིན་པས་སོ།",
    "འདིར་ཧ་ཅང་ཐལ་བ་ཅི་སྟེ་ཚོལ་བར་བྱེད་ཅེས་པའི་དོན་སློབ་དཔོན་གྱིས་བཀོད་དོ།",
    "རྩ་ཚིག་གིས་འཇིག་རྟེན་པའི་དངགས་དངོས་སུ་མ་གསུངས་ཀྱང་དེས་མཚོན་པའི་དོན་བསྟན་པ་ལ་དགོངས་སོ།",
    "བུད་དྷ་ཤྲཱིས་ནི་རིགས་དེ་ཐ་དད་པའམ་ཐ་མི་དད་ཅེས་པའི་ལན་དུ་ཕྱེད་སྔ་མས་ཐ་མི་དད་པར་བསྟན་ནས།",
    "ཞེས་བྱ་བས་དམིགས་པའི་རང་གི་ངོ་བོ་དང་།",
    "རེ་ཞིག་དམིགས་པ་རྣམས་ཀྱི་དང་པོར་དགེ་མི་དགེ་ལུང་དུ་མ་བསྟན་པ་སྟེ་གསུམ་འཆད་དོ།",
    "རྟོགས་དཀར་ཉན་ཐོས་སོགས་དང་ཐུན་མོང་བ་ཡིན་པས་སྤྱིར་ཞེས་སོ།",
    "གཉིས་པ་ནི་ཉོན་མོངས་པས་ཀུན་ནས་བསླང་པའི་སྲོག་གཅོད་པ་དང་སོགས་པས་ལྷག་དགུ་དང་།",
    "ཟག་མེད་ནི་གང་ཟག་གི་བདག་དེར་ལྟ་བའི་གཉེན་པོ་དྲན་པ་ཉེ་བར་བཞག་པ་བཞི་དང་ཡང་དག་སྤོང་༡ བ་ལ་སོགས་པའི་འཇིག་རྟེན་ལས་འདས་པའོ།",
    "ལེ་བརྒྱད་མར་མཐུན་མོང་གི་སྐབས་སུ་སོ་སྐྱེ་དང་ཐུན་མོང་བར་གསུངས་སོ།",
    "དང་པོར་བྱང་སེམས་ལ་བདག་གི་བླང་བྱ་དང་དོར་བྱ་དང་བཏང་སྙོམས་སུ་བྱ་བ་གང་ཡིན་སྙམ་པའི་བློ་སྐྱེ་ལ།",
    "དེ་ལ་ལྟོས་ཏེ་དང་པོ་གསུམ་མོ།",
    "ཡང་ན་དང་པོ་ནི་ཟག་བཅས་ཡིན་པས་བླང་བྱ་རེ་ཞིག་པ་ཡིན་ལ།",
    "འདུས་བྱས་ལ་དམིགས་པ་ལ་ཡང་འབྲས་བུ་ཡོད་མོད་ཀྱི་འཕགས་པའི་གང་ཟག་རྣམས་ནི་འདུས་མ་བྱས་ཀྱིས་རབ་ཏུ་ཕྱེ་བས་དེའི་འབྲས་བུ་མ་བསྟན་ཏོ།",
    "དེའི་དོན་ཡང་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་ཕྱོགས་རེ་དང་ཕལ་ཆེར་དང་མཐའ་དག་རྟོགས་པས་རིམ་པ་ལྟར་འཕགས་པ་གསུམ་དུ་འཇོག་པས་སོ།",
    "འདི་དག་ནི་རྒྱན་སྣང་གི་དགོངས་པ་སྔོན་གྱི་མཁས་པ་དག་གིས་བླངས་པ་ལྟར་བཀོད་དོ།",
    "སུ་ཞིག་གི་ཆེད་དུ་བྱ་བ་ཞེ་ན།",
    "ཉོན་མོངས་བག་ཆགས་དང་བཅས་པར་སྤངས་པ་དང་།",
    "ཡུལ་དུས་ཀྱིས་ཆོད་པ་དང་དངོས་པོ་ཕྲ་མོ་ཤེས་པ་མེད་པས་ཆེན་པོ་གསུམ་མེད་དེ་ཞེས་དགོངས་སོ་ཞེས་རྟོགས་དཀར་འཆད་དོ།",
    "སྔར་དྲངས་པའི་ལུང་གིས་ཀྱང་ཤེས་སོ།",
    "སེམས་དང་པོ་བསྐྱེད་ཕྱིན་ཆད་ཆགས་སོགས་དང་ཉན་རང་གི་སེམས་མི་བསྐྱེད་པའོ།",
    "རྟེན་དང་ལྡན་པས་དམིགས་པ་ལ་དམིགས་ནས་ཆེད་དུ་བྱ་བའི་ཆེད་དུ་སྒྲུབ་པར་བྱེད་པའི་སྒྲུབ་པ་དེའི་རང་གི་ངོ་བོ་གང་ཡིན་ཞེ་ན་དེའི་ལན་དུ་སྒྲུབ་པའི་ངོ་བོ་འཆད་དོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་རྟེན་ཅན་ཞེས་བྱ་བ་ནི་དྲུག་གི་བསྒྲུབ་བྱ་ཅན་ནོ།",
    "ཕྱིན་དྲུག་གི་རྟེན་ཅན་བྱ་བ་ནི་སྦྱིན་སོགས་ལ་བརྟེན་པའི་བྱ་བ་ཉམས་སུ་ལེན་པ་ནི་སྒྲུབ་པ་ཡིན་ནོ།",
    "དེ་ལ་དགོངས་ནས་རྗེ་བཙུན་གྱིས་སྒྲུབ་པ་བཞི་སྟོན་པའི་སྐབས་འདིར་སྒྲུབ་པ་གཉིས་ཀ་དུས་གཅིག་ཏུའམ་ཐུན་མོང་དུ་སྟོན་པར་མཛད་དོ།",
    "ལྷག་མ་འཇུག་པ་ལ་སོགས་པ་ནི་སྒྲུབ་པ་དང་པོའོ་ཞེས་དགོངས་པས་དུས་གཅིག་གི་ཚུལ་གྱིས་སྟོན་པར་མཛད་དོ་ཞེས་བྱ་བའོ།",
    "ཡན་ལག་གི་དོན་ནོ།",
    "ཕྱིན་དྲུག་གི་རང་བཞིན།",
    "དེ་ལ་མི་མཐུན་ཕྱོགས་ནི་རང་རང་གི་སྐབས་ཀྱི་ཡིན་ལ།",
    "འདོད་པ་རྫོགས་པར་བྱེད་པ་ནི་རིམ་པ་ལྟར་ལུས་ངག་གི་སྒོ་ནས་གཞན་ལ་གནོད་པ་བསྡམས་པ་དང་།",
    "དེ་དག་རེ་རེ་ལ་ཡང་གསུམ་གསུམ་དུ་ཕྱེ་བས་བཅོ་བརྒྱད་དུ་འགྱུར་བ་ནི།",
    "བཟོད་པ་དང་ལྡན་ན་བརྩོན་འགྲུས་རྩོམ་མོ།",
    "རེ་བ་མེད་པའི་སྦྱིན་པ་དང་།",
    "ཅེས་གནས་སྐབས་དང་མཐར་ཐུག་གི་འབྲས་བུ་གསུངས་པ་ལྟར་རོ།",
    "ཕྱིན་དྲུག་རེ་རེར་དྲུག་དྲུག་ཚང་བར་བསྒྲུབ་པར་བྱའོ་ཞེས་སེམས་ཀྱིས་གོ་གྱོན་ནས་བསྲན་བཙུགས་༡ པ་ནི་ཕྱིན་དྲུག་གི་མི་མཐུན་ཕྱོགས་ཀྱིས་མི་ཕིགས་པའི་ཕྱིར།",
    "སྔར་གྱི་སྦྱར་ཚུལ་དེ་དག་ཀྱང་འཕགས་པ་ཐོགས་མེད་ཀྱིས་གོ་ཆ་དང་འཇུག་པའི་སྒྲུབ་པ་དག་ནི་གོ་རིམ་བཞིན་དུ་བརྒྱུད་པ་དང་དངོས་སུ་སྦྱོར་བའི་རང་བཞིན་ཚོགས་དང་མོས་པས་སྤྱོད་པའི་སས་བསྡུས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཚིག་གསལ་དང་ཤེར་འབྱུང་གིས་ལམ་བཞི་དང་སྒྲུབ་པ་བཞི་རིམ་པ་བཞིན་སྦྱར་བ་དང་།",
    "དྲུག་ཚན་དྲུག་གི་དབྱེ་བའི་སྒོ་ནས་སྦྱིན་སོགས་དྲུག་ཇི་བཞིན་དུ་སྟེ་གྲངས་ཚང་བར་རོ།",
    "སྡུད་བྱེད་སྦྱིན་པ་དང་སོགས་པས་ཤེས་རབ་ཀྱི་བར་རྣམ་པ་དྲུག་ལ་སྟེ་དྲུག་ཏུ་བསྡུ་བྱ་སྦྱིན་སོགས་དེ་དག་སྡུད་ཚུལ་སོ་སོར་ཏེ་རེ་རེ་དྲུག་བསྡུས་པ་ཡིས་སོ།",
    "སོགས་པས་སྲོག་གི་བར་ཆད་དུ་འགྱུར་བ་སོགས་ཀྱི་འཇིགས་པ་ལས་སྐྱོབ་པའི་མི་འཇིགས་པའི་སྦྱིན་པ་དང་།",
    "སློང་མོ་བ་ལ་སོགས་པ་སྐྱེ་བོ་ཐམས་ཅད་ཀྱིས་མི་སྙན་པར་སྨྲ་བའི་གཤེ་བ་ལ་ཁོང་མི་ཁྲོ་བའི་བཟོད་པ་དང་།",
    "གོ་རིམས་བཞིན་ནི་རེ་རེའི་མཐར་འཁོར་གསུམ་མི་དམིགས་པ་སྦྱོར་བའོ།",
    "འདི་དག་གི་སྦྱིན་པ་ནི་རང་དེ་ལ་གནས་ནས་གཞན་དེ་ལ་འགོད་པའོ།",
    "འོ་ན་འཇུག་འཛེག་གི་དོན་གང་ཞེ་ན།",
    "དེ་གཉིས་ཐེག་ཆེན་མ་ཡིན་པ་ལས་ཁྱད་པར་དུ་བྱེད་པའི་ལམ་མོ།",
    "ཞི་རགས་ཚོར་བ་གང་ཡོད་པ་བདེ་བའི་རོ་མྱོང་བ་གསུམ་མོ།",
    "ལྷག་མ་ལྔ་ལ་རིམ་པ་ལྟར་བསམ་གཏན་གཟུགས་མེད་ལ་འཇུག་ལྡང་བྱེད་ཀྱང་ཉན་རང་གི་སེམས་མི་བསྐྱེད་པ་དང་།",
    "བསམ་གཏན་བཞིའི་ཡན་ལག་རྣམས་ལ་མི་རྟག་སྡུག་བསྔལ་བདག་མེད་ཞི་བ་སྟོང་པ་མཚན་མེད་དུ་རྟོགས་ཀྱང་སྙོམས་འཇུག་དེ་དག་གིས་རློམ་སེམས་མེད་པ་རྣམས་ཀྱིས་གསུངས་སོ།",
    "དང་པོར་རང་གི་སེམས་འདོད་ཡོན་གྱི་རྗེས་སུ་འབྲང་ཞིང་གཡེང་བ་དེ་ལས་ཡོན་ཏན་གང་ཡང་ཐོབ་པར་མི་ནུས་པས་དེ་ནང་དུ་བཟུང་བའི་སྒོ་ནས་དམིགས་པ་ལ་བརྟན་པར་བྱ་བའི་དོན་དུ་བསམ་གཏན་དང་གཟུགས་མེད་པའི་སྙོམས་འཇུག་ལ་འཇུག་ལྡང་བྱེད་ཅིང་དེ་ཡང་ཕྱིན་དྲུག་དང་འབྲེལ་བར་མི་དམིགས་པར་སྒྲུབ་པའོ།",
    "ཚོགས་གཉིས་བསགས་པ་ནི་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་ལ་ལྷག་པར་མོས་པ་སྐྱེ་བའི་ཕྱིར་དེ་རྟོགས་པའི་ལམ་ལ་འཇུག་པའོ།",
    "ཊཱིཀ་ཆུང་ལས་མི་སློབ་ལམ་ལམ་གྱི་དབྱེ་བར་བཀོད་པ་ཙམ་མོ་གསུང་ངོ།",
    "དེ་ལྟར་སྤྱོད་པ་རྣམས་རང་གི་བསྒྲུབ་བྱ་ལ་འབད་པའི་ཕྱིར་ཆེན་པོ་གསུམ་གྱི་ཆེད་དུ་བྱ་བ་ལ་འཇུག་པའོ།",
    "མངོན་ཤེས་ཐོབ་པ་རྣམས་ནི་ཤེས་བྱ་༡ དུ་མ་ཤེས་པ་ན་ད་ནི་བདག་གིས་རྣམ་མཁྱེན་གྱི་ཡེ་ཤེས་ཐོབ་པར་བྱ་སྙམ་ནས་འཚང་རྒྱ་བར་སྤྲོ་བ་དྲག་པོ་སྐྱེ་བས་རྣམ་མཁྱེན་ལ་འཇུག་པའོ།",
    "གང་གིས་ཐོབ་བྱེད་ཀྱི་རྒྱུ།",
    "མོས་པ་ལས་བྱུང་བ་དང་།",
    "གཉིས་པ་ནི་ཡིད་བྱེད་གསུམ་པ་བཞི་པ་དྲུག་པ་སྟེ་ས་འོག་མའི་ཉོན་མོངས་ཆེ་འབྲིང་ཆུང་གསུམ་འཇོམས་པས་སོ།",
    "མོས་པ་ལས་བྱུང་བའི་ཡིད་ལ་བྱེད་པས་ནི་སྤང་བར་བྱ་བ་དང་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡང་དག་པར་རྩོམ་པ་སྦྱོར་བར་བྱེད་དོ།",
    "རབ་ཏུ་དབེན་པའི་ཡིད་ལ་བྱེད་པས་ནི་ཉོན་མོངས་པ་ཆེན་པོ་སྤོང་བར་བྱེད་དོ།",
    "དགའ་བ་སྡུད་པའི་ཡིད་ལ་བྱེད་པས་ནི་ཉོན་མོངས་པས་རྣམ་པ་འབྲིང་སྤོང་བར་བྱེད་དོ།",
    "སྦྱོར་བ་མཐར་ཐུག་པའི་ཡིད་ལ་བྱེད་པས་ནི་ཉོན་མོངས་པའི་རྣམ་པ་ཆུང་ངུ་སྤོང་བར་བྱེད་དོ།",
    "དང་པོར་འདོད་པ་ནི་སྡུག་བསྔལ་ཆེས་རྒྱས་ཤིང་མ་ཞི་བ་དང་ཆེས་ཚེ་ཐུང་ལ་བསམ་གཏན་དང་པོ་ནི་དེ་ལས་ཟློག་པས་རགས་༡ པ་དང་ཞི་བའོ་ཞེས་ཐོས་བསམ་འདྲེས་མར་ཡིད་ལ་བྱེད་པ་ནི་ཁམས་གོང་འོག་གི་མཚན་ཉིད་སོ་སོར་གཅོད་པའི་ཕྱིར་མཚན་ཉིད་རབ་ཏུ་རིག་པའི་ཡིད་ལ་བྱེད་པའོ།",
    "དེ་ལྟར་གོང་འོག་ལ་ཞི་རགས་སུ་ཡུན་རིང་དུ་མོས་པར་བྱས་པ་ལས་ཐོས་བསམ་ལས་འདས་ནས་ཞི་གནས་དང་ལྷག་མཐོང་དུ་སོན་པ་ནི་མོས་པ་ལས་བྱུང་བའི་ཡིད་ལ་བྱེད་པའོ།",
    "དེ་ཡུན་རིང་དུ་འདྲིས་པར་བྱས་པའི་མཐུས་ཐོག་མ་ཁོ་ནར་འདོད་པའི་ཉོན་མོངས་ཆེན་པོ་གསུམ་སྤོང་བའི་ལམ་སྐྱེ་བར་འགྱུར་ཞིང་སྐྱེས་པའི་ལམ་དེ་དང་ལྡན་པའི་ཡིད་བྱེད་ནི་རབ་ཏུ་དབེན་པའི་ཡིད་བྱེད་དོ།",
    "དེས་འདོད་པའི་ཉོན་མོངས་དང་དེའི་ཕྱོགས་ཀྱི་གནས་ངན་ལེན་དང་བྲལ་བར་བྱས་པ་ན་དེ་ནས་ཉོན་མོངས་སྤོང་བ་དང་དེས་དབེན་པ་ལ་དགའ་བར་འགྱུར་ཞིང་།",
    "དེ་གཉིས་ལ་ཕན་ཡོན་དུ་མཐོང་ནས་དབེན་པ་ལས་སྐྱེས་པའི་དགའ་བདེ་ཆུང་ངུས་རེག་པ་ན།",
    "ཉོན་མོངས་པ་འབྲིང་གསུམ་སྤོང་བའི་གནས་སྐབས་སོ།",
    "དེ་ལྟར་དུས་དུས་སུ་སྤངས་མ་སྤངས་དཔྱོད་པ་ན་སྤང་བྱ་མངོན་གྱུར་མ་སྤངས་པ་སྤང་བའི་ཕྱིར་འདོད་པའི་ཉོན་མོངས་ཆུང་ངུ་གསུམ་གྱི་གཉེན་པོ་སྐྱེས་པ་ནི་སྦྱོར་བ་མཐར་ཐུག་པའི་ཡིད་བྱེད་དེ།",
    "དེ་ཡང་རེ་ཞིག་ཙམ་སྤངས་པ་ཡིན་གྱི་གཏན་སྤངས་པ་ནི་མིན་ཏེ།",
    "མཉམ་པར་མ་བཞག་པའི་ས་པའི་ཡིད་ལ་བྱེད་པ་དག་གིས་འདོད་པ་རྣམས་ལ་རགས་པའི་མཚན་ཉིད་དང་།",
    "མཚན་ཉིད་སོ་སོར་རིག་པ་དང་མོས་པ་ཡིད་ལ་བྱེད་པ་ནི་སྦྱོར་བའི་ལམ་གྱིས་བསྡུས་པ་ཡིན་ནོ།"
  ]
}