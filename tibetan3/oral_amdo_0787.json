    "དོན་འདི་ལ་རྒྱུད་བླའི་ཊཱིཀ་བྱེད་ཕལ་མོ་ཆེས་གོང་དུ་བསྟན་པའི་སྐྱབས་གསུམ་པོ་དེ་ངེས་དོན་མིན་པར་དྲང་དོན་དུ་ཤོ་ལོ་ཀ་འདིས་བསྟན་པར་འཆད་པ་ནི་འདིའི་དོན་གཏན་མ་རྟོགས་པར་མཐོང་སྟེ་དེ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "རིགས་ཅན་གསུམ་པོ་རེ་རེས་ཀྱང་གསུམ་ག་ལ་སྐྱབས་སུ་འགྲོ་བ་མ་ཡིན་ནམ།",
    "ཅེས་གསུངས་པ་ཡང་ཐུན་མོང་གི་སྐྱབས་ཀྱི་རྣམ་གཞག་ཡིན་ནོ།",
    "བདག་གི་སྐྱབས་འདི་ཡུལ་མ་ལུས་པ་མཁྱེན་པའི་སྟོན་པའོ་སྙམ་དུ་ཞེན་པ་ལྡོག་པའི་ཆེད་དུའོ།",
    "འདི་དག་གིས་གཞི་ལམ་རྣམ་པ་རྣམས་བསྟན་ཏེ།",
    "བྱང་ཆེན་གྱི་ཤའི་མིག་གིས་དཔག་ཚད་བརྒྱ་མཐོང་བ་ཡོད་དོ།",
    "ལྷ་དེ་དག་གི་མིག་གིས་བྱང་སེམས་ཀྱི་མིག་མི་ཤེས་པ་དང་།",
    "ཉོན་མོངས་དང་བཅས་མ་བཅས།",
    "མིག་གང་གིས་བྱང་ཆེན་རྣམ་པ་ཐམས་ཅད་དུ་མ་མཐོང་བའམ་མ་ཐོས་པའམ་མ་བསམས་པའམ་རྣམ་པར་མ་ཤེས་པ་ཅི་ཡང་མེད་པ་སྟེ།",
    "དེ་ལ་ཤའི་མིག་གི་སྐབས་སུ་དཔག་ཚད་བརྒྱ་ལ་སོགས་པ་མཐོང་བ་ཡོད་ཅེས་གསུངས་པ་ནི་བྱང་སེམས་ཀྱི་སའི་མཐོ་དམའ་དང་ཡོན་ཏན་ཆེ་ཆུང་གི་རིམ་པས་ཡིན་ནོ།",
    "ལྷ་རྣམས་ཀྱི་མིག་བྱང་སེམས་ཀྱི་ལྷའི་མིག་གིས་ཤེས་པར་གསུངས་པ་ནི་དེ་དག་གི་མིག་དང་དེའི་ཡུལ་དང་ལྷ་དེ་དག་གི་བསམ་གཏན་དང་ཏིང་ངེ་འཛིན་རྣམས་ཤེས་ལ།",
    "འོན་ཀྱང་གཙང་མའི་རིས་ཀྱི་ལྷ་ནི་འཕགས་པ་ཁོ་ནར་ངེས་པས་དེ་དག་གིས་མི་ཤེས་པར་གསུངས་པ་ནི་ཉན་ཐོས་འཕགས་པ་ལ་དགོངས་སོ།",
    "དེ་དག་ཇི་ལྟ་བ་བཞིན་དུ་སྟོན་པར་བྱེད་པའི་སྒོམ་བྱུང་གི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་ནི་མངོན་ཤེས་ཏེ།",
    "བསྒོམས་བྱུང་གི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་ཅེས་ལྷག་མ་ལྔ་ལའང་སྦྱར་རོ།",
    "གཉིས་དང་གསུམ་ནས་བརྒྱ་སྟོང་གི་བར་དུ་ཡང་རྗེས་སུ་དྲན་ནོ།",
    "བྱེ་སྨྲ་རྣམས་སྔར་རང་རང་གིས་མ་མྱོང་བ་དྲན་པར་མི་འདོད་དོ།",
    "འདི་གཟུགས་ཐམས་ཅད་ཀྱང་མཐོང་བས་ཡུལ་གྱི་ཁྱད་པར་ཏེ་ཁྱད་པར་གསུམ་མོ་ཞེས་པ་ནི་མི་འཐད་དེ།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་དང་གཟུང་འཛིན་དུ་རྟོག་པའི་ཤེས་སྒྲིབ་སོགས་ཀྱི་ས་བོན་སྤངས་པའམ་སྤོང་བར་བྱེད་པ་སྟེ།",
    "མངོན་ཤེས་དང་པོ་ལྔ་ཕྱི་རོལ་པ་དང་ཡང་ཐུན་མོང་བ་ཡིན་ལ།",
    "གང་གིས་སྒོམ་ན།",
    "གང་གི་དོན་དུ་ན་མཐོང་ལམ་དེས་སྤང་བར་བྱ་བ་མཐོང་སྤང་གི་དངོས་པོའི་གཉེན་པོ་ཉིད་དུའོ།",
    "སྒྱུ་མ་མཁན་རང་གིས་སྤྲུལ་པའི་སྒྱུ་མ་ལ་མངོན་ཞེན་མེད་པ་དེ་བཞིན་དུའོ།",
    "འཕགས་པས་འདུས་བྱས་ནི་ལམ་མོ།",
    "སློབ་དཔོན་འདིས་ཉི་སྣང་གི་དེ་བཀོད་པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་གདམས་ངག་གི་བརྗོད་བྱ་བཅུར་གྲངས་ངེས་ཤེ་ན།",
    "བཅུ་པོ་འདི་ཙམ་ཁོ་ནས་གང་ཟག་གཅིག་འཚང་རྒྱ་བའི་བཞེད་དོན་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་འགྱུར་བས་ན་གདམས་ངག་གི་བརྗོད་བྱ་ནི་བཅུར་ངེས་སོ།",
    "སྤྱིར་གནས་སྐབས་དང་མཐར་ཐུག་གི་དོན་སྒྲུབ་པ་ལ་སྒྲུབ་པ་རང་གི་ངོ་བོ།",
    "སྤང་བླང་རང་གིས་ཤེས་པས་གཞན་གྱི་སོགས་སོ།",
    "དེ་དང་ཆགས་བྲལ་སྔོན་སོང་གི་ཞུགས་པ་གཉིས་མཐོང་ལམ་པ་དང་།",
    "འདོད་པ་ལ་ཆགས་པ་དང་བྲལ་བ་སྔོན་དུ་སོང་བ་ཞེས་བརྡ་མཛད་པ་ལས་འདིར་ཐོད་རྒལ་བ་ཞེས་བཏགས་པ་ནི་བརྡ་དངོས་སུ་སྦྱར་བ་མེད་ཀྱང་དོན་གྱིས་འཐོབ་སྟེ།",
    "དེས་ན་ཆགས་བྲལ་སྔོན་སོང་ཞེས་བརྡ་སྦྱར་ན་སྤང་བྱ་སྤངས་ཚུལ་དང་།",
    "ཕྱི་མ་གཉིས་ལ་ལམ་རིམ་གྱིས་པ་དང་ལམ་ཅིག་ཅར་བ་ཞེས་བརྡ་སྦྱོར་བ་མང་༡ མོད།",
    "དེ་དག་གིས་ནི་བརྡ་འདི་དག་གི་དོན་གཏན་མ་རྟོགས་པར་མཐོང་སྟེ།",
    "སྤངས་པའི་སྒོ་ནས་མི་སྲིད་པ་ནི་འབྲས་བུ་གང་དང་གང་གི་སྤང་བྱའི་གཙོ་བོ་མཐོང་ལམ་གྱི་སྔོན་དུ་སྤངས་པ་གཅིག་དགོས་ན་རྒྱུན་ཞུགས་ལ་དེ་མི་སྲིད་དེ།",
    "དེས་ན་ཅིག་ཅར་བ་ཕྱིས་རང་རྒྱལ་དུ་སོང་བ་གཅིག་སྲིད་ཀྱི་བསེ་རུ་ལྟ་བུ་༡ ཡིན་ན་ཅིག་ཅར་བར་ངེས་པར་འགལ་བ་ཡིན་ནོ།",
    "འབྲས་བུ་དེ་དག་ལམ་གང་གིས་དང་།",
    "དེ་ཡང་མཐོང་ལམ་གྱི་སྔོན་དུ་འདོད་པའི་སྒོམ་སྤང་དྲུག་པའམ་དགུ་པ་ངེས་པར་སྤངས་པ་གཅིག་གིས་བཅུ་དྲུག་པ་ཐོབ་པ་དང་མཉམ་དུ་ཕྱིར་འོང་དང་ཕྱིར་མི་འོང་ཐོབ་ལ།",
    "དད་པས་མོས་དང་མཐོང་བས་ཐོབ།",
    "དེ་ལྟ་ན་ཕྱིར་འོང་དེས་ཕྱིར་མི་འོང་ཐོབ་པ་ན་ཡང་ཐོད་རྒལ་བར་ཐལ་ཞེ་ན།",
    "ཕྱིར་འོང་གིས་ཐོབ་པའི་ཕྱིར་མི་འོང་དང་ཕྱིར་མི་འོང་གིས་ཐོབ་པའི་དགྲ་བཅོམ་ཐོད་རྒལ་བར་མི་འདོད་དེ།",
    "གཞན་ཡང་དེ་གཉིས་ཆགས་བྲལ་སྔོན་སོང་གི་ཕྱིར་འོང་དང་ཕྱིར་མི་འོང་ཞུགས་པ་དང་ཕྱིར་མི་འོང་དང་དགྲ་བཅོམ་ཞུགས་པ་གཞི་མཐུན་པ་ཡིན་ཀྱང་ཆགས་བྲལ་སྔོན་སོང་གི་ཞུགས་པ་ནི་མིན་ཏེ།",
    "དགྲ་བཅོམ་མོ།",
    "དེའི་ཁྱད་པར་ལ་རེ་ལྟར་ཐོགས་ན་ལན་བདུན་པ་དང་།",
    "རེ་ལྟར་ཐོགས་ན་ལན་བདུན་པ།",
    "ཐམས་ཅད་ནི་མ་ཡིན་པས་རེ་ལྟར་ཐོགས་ན་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ཀྱི་ཐ་ཤལ་བའོ།",
    "འོག་མིན་དང་སྲིད་པའི་རྩེ་མོའི་མཐར་ཐུག་པ་ཉིད་ནི་ཕན་ཆད་དུ་འགྲོ་བ་མེད་པའི་ཕྱིར་ཏེ།",
    "ཞེས་དང་རེ་ལྟར་ཐོགས་ན་ཞེས་པའི་མིང་ཡང་ཕ་མཐའི་སྐྱེ་བ་བཟུང་བར་སྣང་གི་ཚུན་ཆད་ལེན་ངེས་མིན་པའི་ཕྱིར་ཞེ་ན།",
    "སྤྱིར་རྒྱུན་ཞུགས་རེ་ལྟར་ཐོགས་ན་ལན་བདུན་པ་ལ་སྐྱེ་བ་གཅིག་བླངས་ནས་འདའ་བ་ནས་བདུན་བླངས་ནས་འདའ་བའི་བར་དུ་ཡོད་པས་བདུན་དུ་མ་ངེས་མོད།",
    "འོན་ཀྱང་འབྲས་གནས་སྒོམ་སྤང་ཞེས་སོགས་ཀྱི་སྐབས་འདིར་བསྟན་པ་ནི་ལན་བདུན་ལེན་ངེས་ཀྱི་བྱེ་བྲག་པ་དེ་ལ་སྤྱི་མིང་བཏགས་པ་ཡིན་པས་དེ་ལ་བསམས་ནས་རེ་༡ ལྟར་ཐོགས་ན་ལན་བདུན་པའི་སྐྱེ་བ་ངེས་པར་བྱས་ཏེ།",
    "མཆོག་ཏུ་ཐོགས་ན་ལན་བདུན་པ་གཞན་ཡང་ཡོད་མོད་ཀྱི་མ་ངེས་པས་མི་བརྗོད་ཞེས་ལན་བདུན་པ་གཞན་ཡོད་ཀྱང་མ་བརྗོད་པ་ནི་མ་ངེས་པས་ཡིན་ལ་འདིར་ནི་བདུན་ལེན་ངེས་བསྟན་ཅེས་༣ གསུངས་པས་སོ།",
    "འདི་ཡང་རྩོམ་པ་དང་པོ་ལ་ཡིན་གྱི་ཉོན་མོངས་གཅིག་སྤངས་པ་དང་སྐྱེ་བ་གཅིག་བླངས་ནས་ནི་མཚན་ཉིད་འཇིག་གོ།",
    "ལུང་འདིས་བར་ཆད་གཅིག་པ་ལའང་ཆགས་བྲལ་སྔོན་སོང་ཡོད་པར་བསྟན་ཏོ།",
