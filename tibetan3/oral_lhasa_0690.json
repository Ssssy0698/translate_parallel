    "བསྟན་པར་བྱའོ་ནི་མངོན་སུམ་དུ་བྱ་བའོ།",
    "གང་ཞིག་སྲིན་ལགསྟོན་པ་ལ།",
    "ཞེས་པ་ལ་གལ་ཏེརྣལ་འབྱོར་མ་སྲིན་ལག་སྟོན་པ་དེའི་ཚེ་རྣལ་འབྱོར་བས་མགྲིན་པབསྟན་པར་བྱའོ།",
    "དེ་སྟོན་པ་ལ་ནི་ཀུན་དུ་སྣང་བའི་རྣམ་པར་དག་པརབྱ་བའོ།",
    "ཡང་དག་པར་རིགཔའི་རང་བཞིན་ཆ་ཤས་དང་བྲལ་བ་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ཀྱིརང་བཞིན་ནོ།",
    "དེ་བས་དེའི་དེ་ཉིདབསྟན་པར་བྱའོ།",
    "བསྟན་པནི་ཁྱད་པར་དུ་འཕགས་པའི་ཡེ་ཤེས་ཡིན་ནོ།",
    "གོས་ཞེས་པ་ནི་གོས་ཀྱིས་མགོ་གཡོགས་པའིབརྡ་རྣལ་འབྱོར་མ་གང་སྟོན་པའི་རྣལ་འབྱོར་མ་དེ་ལ་རྩེ་གསུམགྱི་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།",
    "འདིས་ནི་ཡེ་ཤེས་ལྔ་དབྱེརམེད་པར་གྱུརཔའི་ཡེ་ཤེས་ལྔ་རྣམས་བསྟན་པ་ཡིན་ནོ།",
    "མཐོང་བའི་ལྟ་བའི་ཡེ་ཤེས་ཉིད་ཀྱིས་རྫོགས་པར་དབྱེརམེད་པར་རྟོག་པ་རྣམ་པར་གཞགཔར་བྱ་བའི་དོན་ཏོ།",
    "དེ་བསྟན་པ་ནི་མཐོང་བཉིད་ཀྱིས་རྣམ་པར་གཞག་ཅིང་ཡེ་ཤེས་ཉིད་ཀྱིས་ངེས་པར་བྱའོ།",
    "འཕགས་པའི་ཡེ་ཤེས་རྣམ་པར་བཞག་པས་གཉིས་སུ་མེད་པརྟོགས་པ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "གཙུག་ཕུད་དགྲོལ་བར་བྲྗོད་པར་བྱ།",
    "བྲྗོད་པ་ནི་ཁྱད་པར་དུ་འཕགས་པའིམཆོག་རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་སྟོང་པ་ཉིདཀྱི་རང་བཞིན་དུ་ངེས་པའོ།",
