    "དུར་ཁྲོད་ཀྱིས་ཀྱང་གསུང་རྡོ་རྗེ་བསྟན་པའི་ཕྱིརསྔགས་ཀྱི་རིམ་པར་ཕྱེ་བའོ།",
    "དེཉིད་གཉི་གའི་བདག་ཉིད་ཀྱི་དཀྱིལ་འཁོར་སྤྲོ་བ་དང་བསྡུ་བའིཚུལ་གྱིསདཀྱིལ་འཁོར་གཉིས་ཀྱི་རང་བཞིན་ཡིན་པས་དེ་ཁོ་ན་ཉིད་ཀྱི་རིམཔར་ཕྱེ་བའོ།",
    "དེ་བས་དེ་ཁོ་ན་ཉིད་ཀྱི་རྣལ་འབྱོར་པས་སྤྱོད་པབྱེད་པར་ནུས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ན་གང་སྤྱོད་པ་བྱེད་པར་འདོད་པ་དེ་སྦྱར་བརབྱ་བ་ཉིད་ཡིན་ནོ།",
    "སྤྱོད་པ་ཉིད་ཅིའི་དོན་དུ་ཡིན་པ་གསུངས་པ།",
    "དངོས་གྲུབ་འགྱུར་ཞེས་པ་ནི་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ཐོབཔར་བྱ་བའི་ཕྱིར་རོ།",
    "འདི་མེད་པརཡང་དག་པའི་དངོས་གྲུབ་ཐོབ་པ་མ་ཡིན་ནོ།",
    "འཆད་པར་འགྱུར་བས་རིགསལྔ་ལ་སོགས་པ་དབྱེར་མེད་དུ་རྟོགས་པས་ཤིང་གཅིག་ལ་སོགས་པརྣམས་སུ་རྒྱུ་བར་ནུས་པ་ཡིན་ནོ།",
    "དེ་ནས་ཡང་དྲོད་ཐོབ་པརའགྱུར་ཏེ།",
    "དངོས་གྲུབ་ཀྱང་ཕྱགརྒྱ་ཆེན་པོའི་སྔོན་དུ་འགྲོ་བ་ཉིད་ཀྱིས་བདེན་པ་གཉིས་ཁྱད་པརའཕགས་པའི་ཕྱག་རྒྱ་རྙེད་པ་དེ་ཁྱེར་ནས་སྤྱོད་པ་སྤྱད་པརབྱའོ།",
    "སྤྱོད་པ་བྱ་བར་རྟོགས་པར་བྱ།",
    "དེའི་ལྷ་ནིརྣམ་སྣང་ཞེས་བྱ་བ་ལ་སོགས་པ་འཆད་པར་འགྱུར་རོ།",
    "དེ་བཅུག་པ་ནི་དམིགསཔར་བྱས་པས་སོ།",
    "སྤྱོད་པ་བྱ་བར་རྟོགས་པར་བྱ།",
    "འདི་ཞེས་པ་ནི་འདི་ལྟ་བུཁྱེར་ནས་དངོས་སུ་འཁྱམ་པར་བྱ་བར་རིགསཔ་ཡིན་ནོ།",
    "རྣམ་པ་གཉིས་ཀཡང་དབྱེར་མེད་པར་བྱས་པ་ཀུན་དུ་བཟང་པོའི་སྤྱོད་པ་ལ་འཇུག་པཡིན་པར་དགོངས་སོ།",
    "དེལས་བྱུངབ་ནི་དེར་གྱུར་པར་བྱུང་བ་རབ་ཏུ་གསལ་ཏེ།",
    "ཅིས་ཁྱད་པར་དུ་འཕགས་ཤེ་ན།",
    "དེས་སྦྱངས་པ་ནི་འདུས་བྱས་པའི་ཚུལ་ཅན་ཀུན་རྫོབ་ཀྱིབདེན་པའི་བདག་ཉིད་དོ།",
    "དེའི་ཚེ་དེ་ཇི་ལྟ་བུ་ཡིན་པ་གསུངས་པ།",
    "ཐརཔའི་རྒྱུས་ནི་གར་བྱས་ཏེ།",
    "ཅེས་བྱ་བ་ནི་གལ་ཏེ་དགའ་བསྐྱེས་ནས་རྣལ་འབྱོར་པ་གར་རྩོམ་པ་ལ་འཇུག་པར་འགྱུར་བ་དེའིཚེ་གར་དང་བྲོའོ།",
    "གཡས་བརྐྱང་བ་ལ་སོགསཔ་རྐང་སྟབས་བརྒྱད་ཀྱིས་མཉམ་པར་བཞག་པས་དེ་ཁོ་ན་ཉིད་ལསེམས་ཞེན་པས་སོ།",
    "མཆོག་ནི་ཁྱད་པར་དུ་འཕགས་པ་རྣམ་པར་དགའབ་ལ་ཐུག་པའི་ཐ་ཚིག་གོ།",
    "དགའ་བ་ནི་རྣམ་པརདགའ་བའོ།",
    "གར་བྱེད་པ་ནིགར་ངེས་པར་གནས་པར་འབྱུང་ངོ།",
    "དེ་ཉིད་མཉམ་གཞག་སྟེ་མི་མཐུན་པ་མེད་པརགནས་པའི་དོན་ཏོ།",
    "ད་ནི་རུས་པའི་རྒྱན་ལ་སོགས་པ་གང་རྣལ་འབྱོརཔས་བརྒྱན་པ་དེ་རྣམས་ཀྱི་རྣམ་པར་དག་པ་གསུངས་པ།",
    "སྤྱི་བོར་འཁོར་ལོ་རྣམ་པར་འཛིན།",
    "ལག་པར་རྣམ་པརསྣང་མཛད་བྲྗོདཔ་ནི།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པ་ལྔའི་རྣམ་པརདག་པ་ཕྱག་རྒྱ་ལྔའི་རིམ་པར་ཕྱེ་བ་བསྟན་པ་ཡིན་ཏེ།",
    "རྐངཔར་དེ་བཞིན་རྐངགདུབ་པོ་ནི་རྐང་པ་དག་ཐབས་དང་ཤེས་རབ་ཀྱི་རང་བཞིན་ཨའ་ལིཀཱ་ལིའི་ནཱ་དའི་བདག་ཉིད་རྐང་གདུབ་རྣམ་པར་དག་པའོ།",
    "ཅེས་པ་ནི་གཉི་ག་དབྱེར་མེད་པའིརྡོ་རྗེ་འཛིན་པའི་རྣམ་པར་དག་པའི་རྒྱན་རྣམས་ཉིད་སྤྲོ་བདང་བསྡུ་བའི་བདག་ཉིད་དོ།",
    "འཁོར་ལོའི་གཟུགས་ཀྱིས་མི་ཤེས་པ་གཅོད་པར་བྱེད་པའི་རྣམཔ་དེས་སོ།",
    "ལག་པར་རྣམ་པར་སྣང་མཛདབྲྗོད།",
    "སྣང་མཛད་ནི་རབ་ཏུ་གསལ་བའི་རྣམ་པར་གནས་པས་རྣམ་པར་སྣངམཛད་དོ།",
    "དོན་ཡོད་ནི་འབྲས་བུ་མེད་པ་མ་ཡིན་པས་འགྲོ་བའི་དོན་བྱེད་པར་ནུསཔའི་དོནཏོ།",
    "སྤྱོད་པ་བྱ་བར་རྟོགས་པར་བྱ།",
    "ཞེས་གང་གསུངས་པདེའི་རྣམ་པར་དག་པ་བསྟན་ཏོ།",
    "ཞེས་ཀྱང་གསུངས་པ་དེ་ཡངཤེས་རབ་ཀྱི་རང་བཞིན་ནོ།",
    "འདིས་ནི་མཁའའགྲོ་མ་བཅོ་ལྔ་ཨའ་ལིའི་ནཱ་ད་ཡིན་པར་བསྟན་ཏོ།",
    "དེ་ཡངཐབས་ཀྱི་གཟུགས་ཀྱིས་ཐབས་རྣམ་པར་དག་པས་སོ།",
    "རིགས་ལྔ་རྣམས་སུའཁྱམ་པར་བྱ།",
    "འདིས་ནི་ཨའ་ལི་ཀཱ་ལིའི་ནཱ་ད་གཉིས་ཀྱི་བདག་ཉིདདེས་རྣལ་འབྱོར་པར་འགྱུར་རོ།",
    "ཞེ་སྡང་རྣམ་པརདག་པས་ཏེ་མི་བསྐྱོད་པའི་རྣམ་པར་དགཔའོ།",
    "ཞེས་ཏེ་འཁོར་ལོ་ལ་སོགས་པའི་ཕྱགརྒྱའི་རྣམ་པར་དག་པ་མི་བསྐྱོད་པ་ལ་སོགས་པའོ།",
    "ནཱ་ད་གཉིསཀྱི་བདག་ཉིདཐབས་དང་ཤེས་རབ་ཀྱི་རང་བཞིན་རྣམས་རྣམ་པར་དག་པར་གྱུར་པཡིན་པས་ཞེ་སྡང་རྣམ་དག་རྣལ་འབྱོར་པ་རྡོ་རྗེ་འཛིན་པའི་རངབཞིན་དུ་གྱུར་པ་ཡིན་ནོ།",
    "འདིས་ནི་རྣལ་འབྱོར་པའི་ཕྱག་རྒྱ་ལྔརྣམས་བསྟན་པ་དེ་རྣམ་པར་དག་པ་མི་བསྐྱོད་པ་ལ་སོགས་པའོ།",
    "རྐང་གདུབ་ནི་ཐབསདང་ཤེས་རབ་རྣམ་པར་དག་པའི་རྣམ་པའོ།",
    "དཔུང་རྒྱན་ཐབསདང་ཤེས་རབ་རྣམ་པར་དག་པའོ།",
    "བཟའ་བ་མི་འཆི་བཅུ་ཕྱེད་ནི་ཤེས་རབ་རྣམ་པར་དགཔའོ།",
    "ཧེ་རུ་ཀ་སྦྱོར་སྐྱེས་བུ་ཉིད་ནི་དེས་རྣལ་འབྱོར་བ་རྣམ་པརདག་པའོ།",
    "རིགས་ལྔ་རྣམས་སུ་འཁྱམ་པར་བྱ་བ་ལ་སོགས་པ་གང་ཕྱིར་ཕྱེབ་མཚོན་མི་བྱའི་མཐར་ཞེ་སྡང་རྣམ་པར་དག་པས་རྣམ་པར་དགཔའོ།",
    "དབེན་པའམ་བས་མཐའ་ནི་ཐབས་དང་ཤེས་རབ་ཀྱིརྣམ་པར་དག་པའོ།",
    "སྤྱོད་པའི་དངོས་གྲུབ་ཀྱང་རྒྱུ་དང་འབྲསབུར་གྱུར་པ་ཐབས་དང་ཤེས་རབ་ཀྱི་རྣམ་པར་དག་པའོ།",
    "གླུདང་གར་གྱི་རྣམ་པར་དག་པ་ཡང་ད་ནི་བསྟན་པར་བྱ་སྟེ།",
