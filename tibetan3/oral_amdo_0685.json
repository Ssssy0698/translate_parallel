    "དེ་རྣམས་ཀྱི་སྐུའི་རྡོ་རྗེའི་ངོ་བོ་ཉིད་ལ་རང་གི་སྐུ་རྡོ་རྗེ་ཉིད་ངོ་བོ་ཉིད་དོན་དམ་པའམ།",
    "དེ་བཞིན་ཉིད་ལ་ནི་གང་གིས་བརྗོད་པས་ཀྱང་མི་རེག་པའི་ཕྱིར་ན་དེ་སྐད་ཅེས་བྱའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་འབྲས་བུ་ཐོབ་པའི་མཚན་ཉིད་དགོས་པ་ངེས་པར་བརྗོད་པར་བྱའོ།",
    "ཅིའི་ཕྱིར་ཐུན་མོང་མ་ཡིན་པ་ཞེས་བྱ་ཞེ་ན།",
    "འདི་ལྟར་ཡང་བླང་བར་བྱ་བ་དང་དོར་བར་བྱ་བའི་ཁྱད་པར་མི་ཤེས་ནས་མུ་སྟེགས་རྣམས་ནི་རེ་ཞིག་ལྷ་དང་མི་ལ་སོགས་པའི་བདེ་བ་ཅུང་ཟད་ཙམ་ལ་ཤིན་ཏུ་འདོད་པའི་སེམས་ཀྱིས་ཆུ་དང་མེ་ལ་སོགས་པ་རྣམས་སུ་བདག་འཇུག་པར་བྱེད་དོ།",
    "དེ་ཡང་རྡོ་རྗེ་རྩེ་མོ་ལས་གསུངས་པ།",
    "ཡང་རྡོ་རྗེ་རྩེ་མོ་ལས་གསུངས་པ།",
    "རེ་ཞིག་ཐང་ཀ་ལ་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེ་རྡོ་རྗེ་སྙེམས་པ་བྲིས་ཏེ།",
    "དཔལ་གསང་བ་འདུས་པ་ལས་གཙོ་བོ་ཉིད་ཀྱི་བསྒྲུབ་པར་ནུས་པ་ཐབས་དང་ཤེས་རབ་གཉིས་སུ་མེད་པའི་རྣལ་འབྱོར་གྱི་མན་ངག་ལས་མཆོག་གི་སྐྱེས་བུའི་དོན་ལ་མཁོ་བ་ཟག་པ་མེད་པའི་བདེ་བའི་རང་བཞིན་རྡོ་རྗེ་འཛིན་པ་ཆེན་པོ་ཉིད་རྫོགས་པའི་ཕྱིར་ཐུན་མོང་མ་ཡིན་པའི་རྒྱུ་ཉེ་བར་བསྟན་པ་འདི་ནི་བླ་ན་མེད་པའོ།",
    "ཞེས་བྱ་བ་ལ་རེ་ཞིག་འདིའི་དགོས་པ་ནི་སྨྲས་ཟིན་ཏོ།",
    "རིགས་ཀྱི་བུ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་ཟུང་ཤིག།",
    "བདག་གིས་ཞེས་བྱ་བ་འདིས་བདག་ཉིད་ཀྱིས་མངོན་སུམ་དུ་ཐོབ་པའོ།",
    "བདག་གིས་བྱས་པ་ཡང་མ་ཡིན་ཏེ།",
    "བདག་གིས་ཞེས་བྱ་བས་མི་ལྡན་པ་རྣམ་པར་བཅད་པ་སྟེ་གྲངས་ལས་འདས་པའི་འཁོར་འཆད་པར་འགྱུར་བས་སོ།",
    "གདུལ་བྱའི་བྱེ་བྲག་གིས་རྗེས་སུ་མཐུན་པའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའོ།",
    "གསུང་གཅིག་གིས་ནི་བསྟན་མོད་ཀྱེ།",
    "འདི་ལྟར་གླེང་བསླང་བ་བྱས་ནས་སྡུད་པའི་དུས་སུ་ཉེ་བ་མ་ཡིན་པའི་མ་འོངས་པའི་འགྲོ་བ་ཡིད་ཆེས་པར་བྱ་བའི་དོན་དུ་གང་གི་ཚེ་གང་ལས་གང་དུ་གང་དང་ལྷན་ཅིག་ཐོས་པ་དེ་གོ་རིམས་བཞིན་དུ་བསྟན་ཏེ།",
    "བདག་གིས་ལན་ཅིག་ཉིད་དུ་ཐོས་ཀྱིགཞན་དུ་གཞན་ཡང་ཐོས་ཏེ།",
    "རྡོ་རྗེ་རྩེ་མོ་ལ།",
    "ཉོན་མོངས་བདུད་ལ་སོགས་འཇོམས་པས།",
    "ཤེས་རབ་ཉོན་མོངས་དེ་འཇོམས་ཕྱིར།",
    "ཀུན་རྫོབ་ཏུ་ཡང་སྤྲུལ་པ་ལ་སོགས་པའི་གཟུགས་ཉིད་ཀྱིས་ཇི་ལྟར་རྣམ་གྲངས་གང་གིས་འཇིག་རྟེན་པ་ལ་སྣང་བའི་དངོས་པོ་དེ་ཉིད་མི་རྟག་པ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཀྱིས་གཤེགས་པ་དང་ལྡན་པ་དང་ཡོངས་སུ་སྤྱོད་པ་དང་ལྡན་པ་དང་།",
    "ངག་གི་ལམ་ཐམས་ཅད་ལས་འདས་ཀྱང་ཚིག་གི་སྤྱོད་ཡུལ་ལྟ་བུ་དང་།",
    "བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པའི་ཕུང་པོ་འཇོམས་པས་བཙུན་མོའི་བྷ་ག་སྟེ།",
    "གཅིག་གི་གྲུ་གསུམ་གྱི་རྣམ་པ་ཞེས་ཁ་ཅིག་འདོད་དོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་བྱའོ།",
    "རྒྱལ་བ་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་ལས་རྒྱལ་བ་ནི་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའོ།",
    "ཏིང་ངེ་འཛིན་ཡང་ཉོན་མོངས་པ་ལས་རྒྱལ་བ་དང་བྲལ་བ་ལ་མེད་དོ།",
    "ཞེས་བསྟན་པའི་ཕྱིར་དམ་ཚིག་རྡོ་རྗེ་ལ་སོགས་པའི་སྒྲ་འདིས་འདི་རྣམས་བསྟན་གྱི་རང་གི་མིང་གིས་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ཤེས་པ་དང་ཐ་མི་དད་པའི་ཤེས་བྱའི་དཀྱིལ་འཁོར་ལ་དམིགས་པས་སེམས་དཔའ་ཆེན་པོ་སྟེ།",
    "དེའི་ཕྱིར་ཕུང་པོ་ལ་སོགས་པ་རྣམས་རང་གི་སྣང་བ་ལས་ཐ་མི་དད་པའི་ལྷའི་གཟུགས་ཀྱིས་ངེས་པར་དེ་ཁོ་ན་ཉིད་བླང་བར་བྱའོ།",
    "ལྷ་མོ་བཞི་ནི་ངེས་པར་ཁམས་རྣམས་ཡིན་གྱུར་པ།",
    "འདིར་ཕུང་པོའི་ཚུལ་ལ་རེ་ཞིག་མིག་ལ་སོགས་པ་ལ་རྟེན་ཅིང་གཟུགས་ལ་སོགས་པ་ལ་དམིགས་ནས་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་སྐྱེ་བ་གཟུགས་ལ་སོགས་པ་ངེས་པར་སྣང་བ་དེ་ལ་རྣམ་པར་དག་པས་རྣམ་པར་སྣང་མཛད་དོ།",
    "རེག་བྱའི་ཕྱོགས་གཅིག་རྣམ་པར་དག་པར་གྱུར་པ་ནི་སྤྱན་ལ་སོགས་པ་བཞི་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དང་།",
    "ཡང་གི་སྒྲས་ནི་སེམས་ལས་བྱུང་བ་གཟུང་སྟེ།",
    "གཟུགས་དང་ཚོར་བ་དང་ནི་འདུ་ཤེས་དང་།",
    "ཞལ་གསུམ་ཕྱག་དྲུག་གི་དཀྱིལ་འཁོར་པའི་ལྷའི་རྣམ་པའི་གཟུགས་ཀྱིས་བརྟགས་པ་ཞེས་བྱ་བ་ནི་ཐུག་པ་མེད་པ་མ་ཡིན་ནོ།",
    "ཏིང་ངེ་འཛིན་གང་གིས་མངོན་དུ་བྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ཉིད་ཉོན་མོངས་པའི་ཆགས་པ་སྤངས་པས་དམ་པའི་བདེ་བ་ཟག་པ་མེད་པ་སྒྲུབ་པ་ལ་ཐབས་ཆེན་པོ་དང་།",
    "བུད་མེད་སྒྱུ་མ་ཁྱད་པར་འཕགས།",
    "དེ་མཉེས་པར་བྱེད་པའི་དོན་དུ་ཡིན་ཏེ་རིག་མ་ལ་ཞུགས་པས་སྐྱེད་པ་ལྷག་པའི་བུད་མེད་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པས་དགའ་བ་སྐྱེད་པའི་ཕྱིར།",
    "ཉིད་ཀྱི་སྐུ་བུད་མེད་ཀྱི་གཟུགས་ཞེས་ཏེ།",
    "ཉིད་ཀྱི་སྐུ་ནི་རང་གི་གཟུགས་སོ།",
    "བུད་མེད་ཀྱི་གཟུགས་སུ་སྤྲུལ་པ་ནི་རང་གི་རིགས་དང་།",
    "རྗེས་སུ་མཐུན་པའི་གཟུགས་བུད་མེད་ཀྱི་ལྷའི་རྣམ་པར་བྱིན་གྱིས་བརླབས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེས་དེ་བཞིན་གཤེགས་པ་དེ་རྣམས་རང་གི་བ་སྤུའི་བུ་གར་བཅུག་ནས།",
    "སྙོམས་པར་ཞུགས་པའི་རྗེས་ཐོགས་ལ་ཡང་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེས་དེ་བཞིན་གཤེགས་པའི་རང་གི་གཟུགས་རྣམས་བུད་མེད་ཀྱི་གཟུགས་སུ་བྱིན་གྱིས་བརླབས་ནས་དེ་ཉིད་ཀྱི་བ་སྤུའི་བུ་ག་ནས་འཐོན་པར་གྱུར་ཏོ།",
    "དེ་བརྗོད་པ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཇི་ལྟར་རང་རང་བུད་མེད་ཀྱི་གཟུགས་ཀྱིས་ཕྱུང་སྟེ།",
    "བཙུན་མོའི་བྷ་ག་ནི་འདི་རང་སྣང་བའི་པདྨའོ།",
    "ཞེས་བྱ་བས་ནང་གི་འཕར་མ་བསྟན་ཏོ།",
    "རྡུལ་མེད་པ་ཞེས་བྱ་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའོ།",
    "ཉོན་མོངས་པ་ནི་དྲི་མར་བྱེད་པས་རྡུལ་ཏེ།",
    "འདིའི་དོན་ནི་རྣམ་པར་སྣང་མཛད་དང་པོར་བྱས་ནས་རང་གི་གདན་དང་བཅས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་ཁྱབ་པ་ཞེས་བྱའོ།",
