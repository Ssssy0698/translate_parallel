    "སྤྱོད་པ་བྱས་ཀྱང་དངོས་གྲུབ་མ་གྲུབ་པའི་ཚུལ་ལོ།",
    "རིགས་ལྔའི་ཏིང་ངེ་འཛིན་གསུངས་པའི་ཚུལ་གྱིས་མཇུག་བསྡུ་བའོ།",
    "གདུལ་བྱའི་སེམས་འདུན་པར་བྱ་བ་དང་།",
    "ལྷ་རྣམས་རྒྱས་པའི་ཕྱིར་ཚིམ་པར་བྱ་བའི་ཆོ་གའོ།",
    "དངོས་གྲུབ་བསྒྲུབ་པའི་ཐབས་རིག་མ་ལ་བརྟེན་དགོས་པར་བསྟན་པའོ།",
    "དབུ་རྒྱན་གྱི་ལྷ་ལས་བྱུང་བའི་བདུད་རྩིས་སེམས་དཔའ་གསུམ་ག་ཚིམ་པར་བྱེད་ཚུལ་སྤྱིར་བསྟན་པ།",
    "མཇུག་བསྡུས་ཏེ་ལྷའི་ང་རྒྱལ་བརྟན་པར་བྱ་དགོས་པར་བསྟན་པའོ།",
    "བསྟོད་པས་སྟོན་པ་མཉེས་པར་བྱ་བ་དང་།",
    "འདོད་ཡོན་ལ་ཆགས་པ་ལམ་དུ་བྱས་པས་ཐོབ་བྱའི་དོན་རྫོགས་པར་བྱེད་པ་དང་།",
    "རྣམ་པར་འཚེ་བ་ཞི་བའི་སྦྱོར་བ་དང་།",
    "ལས་དེ་འགྲུབ་པར་ངེས་པའི་དུས་བསྟན་པ་དང་།",
    "དེ་ལྟར་གསུངས་པ་ལ་དགྱེས་ནས་ཆེད་བརྗོད་མཛད་པའོ།",
    "སྔགས་ལ་གཞོལ་བའི་ཆོ་གའི་ཁྱད་པར་དང་།",
    "སྣང་མཐའི་རྣལ་འབྱོར་པའི་ཁྱད་པར་གྱི་ཆོ་ག་ཕན་ཡོན་དང་བཅས་པའོ།",
    "དེའི་དབུས་སུ་རང་དང་མཚན་ལྡན་གྱི་ཕྱག་རྒྱས་འདོད་པའི་དོན་རྫོགས་པར་བྱ་བའོ།",
    "དངོས་གྲུབ་དེ་འདོད་པས་སོར་སྡུད་དང་བསམ་གཏན་ལ་བསླབས་ན་འདོད་པའི་དོན་འགྲུབ་པར་བསྟན་པའོ།",
    "དེ་གཉིས་མི་འགལ་བ་དེ་བཞིན་གཤེགས་པའི་དགོངས་པ་ཡིན་པར་བསྟན་པའི་ལན་ནོ།",
    "དེ་ལྟ་ཡིན་ཀྱང་དངོས་གྲུབ་དང་དེའི་གཞི་རྣམས་བདེན་པར་དམིགས་སུ་ཡོད་པ་དགག་པའོ།",
    "རྟེན་གྱི་དཀྱིལ་འཁོར་ཡོངས་སུ་རྫོགས་པར་བྲི་བ།",
    "དེ་ལྟར་བྱས་པའི་ཕན་ཡོན་ནོ།",
    "གཉིས་ཀའི་རྒྱུད་ལས་གསུངས་པའི་ཆོ་གས་ནང་དང་ཕྱིའི་ཟས་ཀྱི་སྦྱིན་སྲེག་གཉིས་རིམ་ཅན་དུ་བྱ་བ་དང་།",
    "ཡེ་ཤེས་དབབ་པའི་ཆོ་ག་ཁྱད་པར་བ་དང་།",
    "ལྷ་དང་སྔགས་ཀྱི་རྗེས་གནང་སྦྱིན་པའོ།",
    "གདུལ་བྱ་མ་དད་པ་དད་པར་བྱེད་པའི་སྦྱོར་བ།",
    "ལྷ་སོ་སོའི་སྒྲུབ་ཐབས་ལ་བརྟེན་ནས་ལས་སྒྲུབ་པའོ།",
    "མཁའ་འགྲོ་མ་གཉིས་དང་སྙོམས་པར་ཞུགས་པས་འབྲས་བུ་གཉིས་འགྲུབ་ཚུལ་ལོ།",
    "མཚམས་སྦྱོར་སྔོན་འགྲོས་སྤྱོད་པ་བྱེད་པས་ཆ་ལུགས་བསྒྱུར་དགོས་པར་བསྟན་པ།",
    "ངེས་དོན་གྱི་དམ་ཚིག་བཞི་ལ་གནས་པར་བྱ་བ།",
    "དམ་ཚིག་དེ་བརྒྱད་ལ་གསང་འདུས་པས་ཀྱང་སྤྱད་པར་བྱ་བ་དང་།",
    "གསུམ་པ་ལ་དྲུག་རྫོགས་རིམ་པས་ལས་ཀྱི་ལམ་རྣམས་འོད་གསལ་གྱིས་དག་པར་བྱ་བའི་དམ་ཚིག་དང་སྡོམ་པ་དང་།",
    "ནང་ལ་གཞོལ་བ་རྣམས་ཀྱིས་ཚིམ་པར་བྱ་བའི་ཆོ་ག་དང་།",
    "སྔགས་ལ་གཞོལ་བ་རྣམས་ཀྱིས་ཚིམ་པར་བྱ་བའི་ཆོ་གའོ།",
    "དེའི་ལན་འཁོར་གྱི་དེ་བཞིན་གཤེགས་པས་གསུངས་པ་དང་།",
    "ལན་དེ་ལ་ལོག་པར་རྟོག་པ་འཇམ་དཔལ་ལ་སོགས་པས་བསལ་བ་དང་།",
    "ལོག་པར་གཟུང་བ་ཞེས་པའི་ཚིག་དོན་ལ་ལོག་རྟོག་བསལ་བ་དང་།",
    "དེའི་རྩ་བ་འོད་གསལ་དང་དེ་ལ་རྩ་བ་གཉིས་པ་མེད་པར་བསྟན་པའོ།",
    "རིག་མ་དང་སྙོམས་པར་ཞུགས་པས་བསྐྱེད་པའི་བདུད་རྩི་ཟོས་པའི་བཅུད་ལེན་གྱིས་ལུས་ཀྱི་སྟོབས་རྒྱས་པར་བྱ་བ།",
    "འཁོར་རྣམས་ལ་དྲིས་ལན་གྱི་སྐབས་དབྱེ་བའི་ཕྱིར་སྟོན་པ་འོད་གསལ་ལ་བཞུགས་པ་དང་།",
    "སྟོན་པ་འོད་གསལ་ལས་བཞེངས་ནས་བསམ་གཏན་གྱི་དཀྱིལ་འཁོར་ཉན་པར་བསྐུལ་བ།",
    "ལུས་རྟས་པར་བྱེད་པའི་ཆོ་ག་དང་།",
    "རྒྱུད་འདི་ལ་བརྟེན་ནས་ཚེ་འདིར་མཆོག་འགྲུབ་པར་བསྟན་པ་དང་།",
    "རྒྱུད་ཤིན་ཏུ་ཟབ་པར་བསྟན་པའོ།",
    "འོད་གསལ་ལས་བཞེངས་ནས་རིགས་བཞིའི་ངོ་བོས་སྤྱན་སོགས་བཞི་དང་སྙོམས་པར་ཞུགས་པ།",
    "སྟོན་པ་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་དང་སྙོམས་པར་ཞུགས་པས་འགྲོ་བའི་དོན་མཛད་ཚུལ་ལོ།",
    "རྒྱུད་གཏད་པའི་འོག་ཏུ་འཁོར་རྣམས་རྡོ་རྗེ་གསུམ་དུ་གྱུར་པར་བསྟན་པའོ།",
    "དེས་ན་ཐེ་ཚོམ་སྤངས་ཏེ་རང་གཞན་གྱི་གྲུབ་པའི་མཐའི་མཆོག་དམན་ངེས་པར་བྱ་བ་དང་།",
    "ཁྱད་པར་བདུན་ལྡན་གྱི་ཟུང་འཇུག་རྒྱུད་ཀྱི་དོན་མཐར་ཐུག་པར་བསྟན་པ་དང་།",
    "དཔལ་གསང་བ་འདུས་པའི་རྣལ་འབྱོར་པ་ཤར་ཙོང་ཁ་པ་བློ་བཟང་གྲགས་པའི་དཔལ་གྱིས་འབྲོག་རི་བོ་ཆེ་དགའ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་དུ་སྦྱར་བའོ།",
    "ཏིལ་གྱི་གང་བུ་བཞིན་དུ་བར་མེད་པར།",
    "ལེགས་པར་ཕྱེ་བའི་དཀའ་གནས་ཀྱི།",
    "ལྷ་དང་མིའི་རྣམ་པར་འདྲེན་པ་དམ་པ།",
    "སྔོན་དུ་བསྟན་པ་སྤྱིའི་རྣམ་པར་གཞག་པ་དང་།",
    "སྡུག་བསྔལ་སེལ་བའི་འཇུག་ལྡོག་འཇིག་རྟེན་པའི་རྒན་པོ་རྣམས་ཀྱིས་རྣམ་པར་ཕྱེ་བའི་ལུགས་ཙམ་གྱིས་ཆོག་པར་མི་འཛིན་པར།",
    "འཇིག་རྟེན་ཕྱི་མ་ཕན་ཆད་ཀྱི་གོང་མའི་ཁྱད་པར་འཚོལ་བ་རྣམས་ཀྱི་འཇུག་ངོགས་ནི།",
    "རྒྱ་མཚོའི་ནང་ན་རྣམ་པར་གནས།",
    "ཞེས་གསུངས་པ་ལྟར་རོ།",
    "གང་ཞིག་རིགས་པར་ལྡན་པའི་ཚིག།",
    "དེ་ཉིད་སྟོན་པར་ཡོངས་སུ་འཛིན།",
    "ཞེས་གསུངས་པ་ལྟར་རང་དང་གཞན་གྱི་སྟོན་པའི་ལུགས་ལ་ཕྱོགས་ལྷུང་དང་།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "དེའི་ཚེ་ལུང་སྒྲུབ་བྱེད་དུ་མི་རུང་ལ་རིགས་པའི་སྒྲུབ་བྱེད་ཀྱང་མེད་པར་འདོད་པའི་ཕྱིར་རོ།",
    "རྟག་པས་སྐྱེད་ན་དུས་ནམ་ཡང་ལྡོག་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེའི་བསྟན་པ་ལུང་རྟོགས་གཉིས་དང་དེ་དག་ཚུལ་བཞིན་དུ་ཉམས་སུ་ལེན་པ་ལ་ཚིག་ཙམ་མིན་པའི་གུས་པ་ཆེན་པོ་སྐྱེད་པའི་ཐབས་མཆོག་ཏུ་ཤེས་པར་བྱོས་ཤིག་གཉིས་པ་ལ་གཉིས།",
    "ཁྱད་པར་ཞིབ་པ་ནི་ཚིག་མངས་སུ་དོགས་པས་འདིར་གཉིས་ཀའི་སྤྱིའི་རྣམ་གཞག་རགས་པ་འགའ་ཞིག་བརྗོད་པར་བྱའོ།",
