    "མོ་རྩ་ཡིན་ན་བུ་མོ་ཁོ་ན་མང་བ་དང་།",
    "བར་དུ་བྱིའུ་འུར་བ་སྟེ་རྒྱ་ནག་སོགས་སུ་བྱིའུ་མཇུག་སྒྲོ་མ་པ་ཞིག་གིས་གཤོག་སྒྲ་འབྱིན་པ་དེ་ཡིན་ཞེས་སྔ་འགྲེལ་རྣམས་སུ་བཤད།",
    "དཔྱིད་ལ་སོགས་པའི་དུས་བཞིའི་དང་པོའི་དབུགས་ཐོབ་ཤར་བའི་ཉིན་དེ་ནས་བཟུང་སྟེ་མཆིན་རྩ་ལ་སོགས་པ་རང་རང་གི་རྒྱུ་དུས་དང་།",
    "དེ་ཇི་ལྟ་བུ་ཞེ་ན་ལོ་གཅིག་གི་དུས་ཚོད་ལྔ་པོ་གང་ཡིན་པའི་དུས་དེའི་རང་རྩ་དང་།",
    "དེས་ན་ཐ་མལ་གྱི་རྩ་རྒྱུད་གསུམ་གང་ཡིན་ཀྱང་རང་རང་གི་འཕར་ཚུལ་གཞིར་བཞག་པའི་སྟེང་དུ་དུས་ཀྱི་ཁམས།",
    "༦ཀྱི་༢ ཡར་ཚུལ་གྱི་འགྱུར་བ་ཕྲ་མོ་ཡོད་པ་དེ་རྟོགས་དགོས་ཤིང་།",
    "དེ་ལ་རྩ་གང་ཡིན་ཀྱང་འཕར་ལུགས་ལྔ་རེ་ཡོད་པའི་རང་གི་འཕར་ཚུལ་ལྟར་འཕར་ན་དར་བ་ཆུང་ངུ།",
    "དཔེར་ན་མཆིན་རྩ་དེ་ཅོ་གའི་སྐད་ལྟར་ཕྲ་ལ་གྲིམས་པར་འཕར་ན་རང་གི་འཕར་ལུགས་དང་།",
    "དེས་ན་དོན་ལྔའི་རྩ་ལྔ་པོ་རེ་རེ་ལའང་འཕར་ཚུལ་ལྔ་རེ་ཡོད་པས་མ་ཉི་ཤུ་རྩ་ལྔར་ཕྱེས་ནས་དུས་གང་ཡིན་པ་དེའི་རང་ཨ་བུ་གྲོགས་དགྲའི་རྩ་དར་གུད་ཤེས་པར་བྱ་བ་འདི་ཁོ་ན་དགྲ་གྲོགས་ཀྱི་རྩྭ་བརྟག་ཚུལ་ཡིན་པས་འོག་གི་སྐབས་རྣམས་སུ་དེ་ལྟར་ངེས་པར་བྱའོ།",
    "རང་གི་རྩ་ལ་གང་བྱུང་ན་རྩ་བལྟ་ཡུལ་དེ་ཁོ་རང་ལ་འོང་སྟེ།",
    "དཔེར་ན་དཔྱིད་ཤིང་གི་ཞག་དོན་གཉིས་པོའི་བྱིང་ལ་མཆིན་རྩའི་ནང་དུ་བྱིང་འཐིབ་བྱུང་ན་ཁོ་རང་ལ་མི་གཙང་བའི་ངོ་ཡོད་པ་ལྟ་བུའི་འགྲེའོདེ་བཞིན་དཔྱིད་དུས་མ་རྩ་ཆུ་ཁམས་མཁལ་རྩའི་ནང་དུ་བྱུང་ན་མ་དང་ཞང་པོ་ལ་མི་གཙང་བ་སོགས་ཀྱི་རྩ་གང་བྱུང་བ་དེའི་སྐྱོན་འབྱུང་ལ།",
    "བྱེས་སུ་སོང་བ་དེའི་གང་བརྩེ་ཞིང་ཡིད་ལ་གཅག་པའི་གཞི་པ་ཞིག་ལ་བརྟག་གོ།",
    "དེ་ལྔའི་ནང་ན་མཆིན་རྩ་དྲག་ན་ད་ལྟ་གོང་དུ་སོང་བའི་གཞི་དེར་ཡོད་པ་དང་།",
    "ལ་ཉེ་བརྟག་པ་འདི་ལ་ནི་རྩ་དེ་དག་གི་དྲག་ཞན་ཙམ་ལྟ་བ་ཁོ་ན་ཡིན་པས་འཕར་ཚུལ་གྱི་ཁྱད་པར་གཞན་དཔྱད་མི་དགོས་སོ།",
    "རང་མ་བུ་རྩ་ལ་སོ་སོའི་གྲོགས་སྨྲ་བྱུང་བ་སྟེ་དེ་དག་རང་གི་གྲོགས་རྩ་ལྟར་འཕར་ན་དེའི་ཚོད་ཀྱིས་དོན་འགྲུབ་པ་སྟེ།",
    "དམག་ཆེན་སོགས་ལ་དམག་དཔོན་ལྟ་བུར་བརྟག་པས་དེ་དག་གི་གློ་རྩ་རང་ས་དང་།",
    "དུས་དེའི་དགྲ་རྩ་གློ་ལ་དགྲརྩ་བའི་རྩ་དེ་ཁུ་བྱུག་གི་སྐད་ལྟར་སྦོམ་ལ་རིང་བར་འཕར་ན་དགྲའི་རྩྭབྱུང་བས་དགྲ་ཐུབ་བོ།",
    "གཞན་ཡང་ཤིང་ཁམས་ཀྱི་རྩའི་འཕར་ལུགས་ཕྲ་གྲིམ་དེ་རྩ་རྒྱུད་ཀུན་ལ་ཤས་ཆེ་ན་ཤིང་གི་རྩ་ལ་གཉན་དང་རྒྱལ་པོའི་གནོད་པ་སོགས་རྒྱུ་ཡང་དོན་གྱི་གོ་རུང་ངོ།",
    "ཡང་དུས་ཀྱི་མེ་ཁམས་ཀྱི་རྩེའི་མཚན་ཉིད་རྩ་རྒྱུད་ཀུན་ལ་ཤེས་ཆེར་བྱུང་བ་ལའང་ཁ་དམར་འདི་སྦྱོར་རུང་བར་མངོན་ནམ་སྙམ་པ་རང་གི་རྣམ་རྟོག་གོ།",
    "༧ དྲུག་པ་མེ་ཆུ་གོ་ལྡོག་གི་རྩྭ་ཞེས་པ་དཔེས་མཚོན་ནས་མིང་དུ་བཏགས་པ་སྟེ།",
    "དཔེར་ན་སྣོད་ཀྱི་ནང་གི་ཆུ་དེ་དྲག་ཏུ་ཁོལ་བར་མཐོང་ཚེ་དེའི་འོག་ན་མེ་འབར་བ་དངོས་སུ་མ་མཐོང་ཡང་དེའི་ཚ་བ་ལ་དཔགས་ནས་དེའི་འོག་ན་མེ་ཡོད་པར་ཤེས་པ་དང་།",
    "སྣོད་ནང་གི་ཆུ་ཁོལ་བ་མ་མཐོང་ཡང་།",
    "མ་དང་བུ་མོའང་ཕ་བུ་བཞིན་ནོ།",
    "ཁྱོ་སྟེ་སྐྱེས་པའི་མཁལ་རྩེ་ཆུང་མའི་ས་དང་།",
    "དེའང་བུད་མེད་དེའི་མཁལ་རྩ་གཡས་གཡོན་ག་ཉིས་ལས་གཡས་པ་དྲག་ན་མངལ་གནས་དེ་བུ་ཕོ་ཡིན་ལ།",
    "གཡོན་པ་དྲག་ན་བུ་མོར་སྐྱེའོ།",
    "བུད་མེད་དེའི་དུས་ཀྱི་རྩ་གང་ཡིན་པའི་བུ་ཡི་རྩ་ལ་འཕར་ཚུལ་ལྔའི་ནང་གི་མ་རྩ་བུ་རྩའི་འཕར་ཚུལ་བྱུང་ན་མངལ་གནས་དེ་ལ་ལེགས་དེ་མ་རྩ་བྱུང་ན་བཙས་སླ།",
    "དེས་ངོ་མཚར་རྩ་བདུན་སོང་ནས།",
    "དེ་ཡང་དབུགས་ནི་རིང་ཐུང་ཇི་ལྟར་འདྲེན་ཀྱང་ཆོག་མོད།",
    "རྩ་ལ་གོམས་པ་རྣམས་ཀྱིས་རེག་པ་ཙམ་གྱིས་དུས་རྒྱུན་ལས་འཕར་ཚུལ་འཕེལ་འགྲིབ་སོགས་ཤེས་ནུས་སོ།",
    "ཕྱི་ནང་གི་དབུགས་ལ་ལན་ལྔར་འཕར་བ་དེ་ཡང་ལན་རེ་ཟུང་ཙམ་འོལ་སྤྱིར་བརྟག་པ་ལ་ལྟར་ལྟར་སྣང་འབྱུང་སྲིད་པས་འཕར་བ་དེ་ལན་གྲངས་བརྒྱ་ཡི་བར་དུ་གཅིག་པ་བྱུང་ཞིང་།",
    "ཕྱི་ནང་གི་དབུགས་ཀྱི་རྒྱུ་བ་གཅིག་གི་ཡུན་ལ་དྲུག་འཕར་ན་ཚ་བ་ཙམ་པོ་པ་དང་།",
    "མོ་རྩ་ཕྲ་ལ་མྱུར་བ་དང་།",
    "འདྲིལ་ཀྱང་རུང་སྟེ་ཕྱི་ནང་གི་དབུགས་ལན་ལྔ་འཕར་ན་ཚ་བ་མིན་ལ།",
    "སྟེགས་ཞེས་གཏིང་གི་ཚ་བའི་བརྡ་ཡིན་པར་བཤད།",
    "གྲང་བའི་རྩ་ནི་གོང་གི་དྲུག་པོ་དང་རིམ་པར་ལྡོག་ཕྱོགས་སུ་གྱུར་པ་སྟེ།",
    "ཚོ་བ་ནི་ཕྱི་ཤ་ལྤགས་སམ་ཁ་མི་ཚ་བ་དང་བར་རུས་རྐང་གི་ཚ་བ་གཉིས་གསར་པ་དང་།",
    "དེའི་རྩ་ནི་རྩ་རྒྱུད་སྦོམ་ལ་ནང་གང་བ་ལྟར་ཁེངས་ཤིང་སྨུག་པོ་ཁྲག་མཁྲིས་ལ་གནས་པའི་སྟོབས་ཀྱིས་མཆིན་རྩ་གཙོར་གྱུར་ཀན་འོག་གི་རྩ་གཉིས་པོ་དམའ་བ་ལ་ཞར་ཞེས་བྱ་སྟེ།",
    "སྲིན་གྱི་རྩ་ནི་འཁྱིག་ཅེས་པ་ཚུར་སོར་མོའི་ངོས་སུ་དཀྲི་བའམ་འཁྱུད་པ་ལྟར་བྱེད་པ་སྟེ།",
    "སོར་མོའི་ངོས་ཁྱད་དུ་ལེན་པ་ལྟར་སྡོམ་སྡོམ་བྱེད་པ་ལྟ་བུའི་ཚུལ་དུ་འཕར་བ་དང་།",
    "ཞེང་དུ་ལེབ་ལེབ་མོ་ལྟ་བུར་འཕར་བར་བྱེད་པའོ།",
    "རེམས་ཚད་རྩ་ནི་ཕྲ་ལ་མགྱོགས་པར་འཕར་བའོ།",
    "སྦྱར་དུག་གི་རྩ་ནི་རྩ་རྒྱུད་འབར་འབུར་མང་བས་རེ་བ་ལྟར་རྩུབ་པ་དང་།",
    "འཆོལ་བ་ཞེས་རེས་དྲག་རེས་ཞན་ལྟ་བུ་སོགས་ངེས་མེད་ཁཚོལ་བ་སྣ་ཚོགས་སུ་འོང་བ་དང་།",
    "མགོ་ཆག་པ་ལ་བརྟག་ན་ཤ་རུས་ཀླད་པ་གསུམ་གང་ལ་སྐྱོན་ཡོད་ན་ཚོན་ཀན་ཆག་གི་རྩ་རིམ་བཞིན་དྲག་ཅིང་སོགས་གསུངས་ཏེ།",
    "རུས་ལ་སྐྱོན་ཡོད་ན་ཀན་འོག་གི་རྩ་གྲིམས་པ་འབྱུང་ངོ།",
    "ཀླད་པ་ལ་སྐྱོན་ཡོད་ན་ཆག་འོག་གི་རྩ་མགྱོགས་པར་འབྱུང་ངོ།",
    "དེ་ཡང་གཏིང་ན་ཤེད་ཆེ་ཆུང་གིས་མི་ནོར་བར་བྱེད་དགོས་སོ།",
    "སོར་མོའི་ཡར་ཟུར་ན་གནས་པ་དོན་ལྔ་དང་།",
