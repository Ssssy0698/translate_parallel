    "དགུང་ལོ་བདུན་གྱི་སྟེང་ཡབ་ཀྱི་འདོད་མོས་ལྟར་ཀ་རིང་གཤོང་སར་ཐེངས་གཅིག་ཕེབས་བཞུད་མཛད།",
    "འདིའི་སྐབས་དགུང་གྲངས་བྱིས་པའི་ན་ཚོད་ལས་མ་འདས་ཀྱང་ཕྱིའི་ཀུན་སྤྱོད་དང་ནང་གི་འདུ་ཤེས་སོགས་གཞན་ལས་ཁྱད་དུ་འཕགས་པ་ཞིག་ཡིན་ཞེས་ཀུན་གྱིས་གླེང་།",
    "དེ་ནས་དགུང་ལོ་བཅུ་དགུའི་དགུན་ཁར་འཇིགས་མེད་གཤིན་རྗེ་གཤེད་པོ་དེ་ཉིད་ངུར་སྨྲིག་གི་རྣམ་པར་རོལ་བ་རྡོ་རྗེ་འཆང་དངོས་ཨ་བྷ་མཚན་ཅན་གྱིས་སྐུལ་མ་བྱུང་བ་དང་།",
    "ངེས་དོན་གཞུང་གི་དགོངས་ཟབ་དབྱར་རྔའི་སྤྲིངས་ཡིག་ལྗགས་རྩེ་གློག་གི་འཕྲུལ་ལས་འདོན།",
    "དགག་སྒྲུབ་ལག་པའི་མཚོན་གྱི་རྣོ་ངར་ཕ་རོལ་རྒོལ་བའི་གདོང་ལ་གཏད་དེ་གོ་རིགས་དང་རྣམ་དཔྱོད་ཀྱི་སྐྱ་རེངས་ཐོག་མར་འཆར་བ་ལ་ཅི་ཡང་གཞོལ་བར་གྱུར་ཏོ།",
    "ཚིག་གི་ཁྲིད་ཚུལ་སོགས་གསར་སློབ་ཀྱི་རྣམ་པ་གཏན་མེད་པ་ལ་ཐམས་ཅད་ཀྱིས་འདི་རོང་བོར་རྩོད་པ་སྔོན་སོང་ཞིག་རེད་ཅེས་གླེང་བ་བྱུང་།",
    "གྲྭ་ཚང་རང་ནས་རྒྱལ་བ་པཎ་ཆེན་ལྟ་བུ་ལ་ཞུ་འཕྲིན་འདེགས་དགོས་བྱུང་ཚེའང་ཁོང་གིས་འབྲི་དགོས་བྱུང་།",
    "གང་བྱུང་གི་ཟས་དང་ཕྱག་དར་ཁྲོད་པའི་གོས་ལ་བསྟེན་པས་བསྟན་པའི་དམིགས་རྐྱེན་དུ་མཛེས་པ།",
    "དགུང་མོ་མཆོད་མེ།",
    "ལོ་རེ་བཞིན་ན་བཟའ་སོགས་མཐུན་རྐྱེན་གང་འཚམས་ཡོངས་འཛིན་ཡབ་སྲས་ཀྱིས་གནང་།",
    "ཚད་འབྲས་སོགས་སྐབས་ཀྱི་ཁྲིད་གཞུང་རྣམས་ལ་ཞིབ་གཟིགས་དང་དོགས་དཔྱོད།",
    "ཁོང་ནས་སྐབས་དོན་གྱི་ལུང་དང་ཚིག་གི་ཞིབ་ཆ་བཅས་ལན་རེ་གཉིས་ཀྱིས་རྒོལ་བ་བཞིན་ཉམས་པ་དང་སྐད་ཀྱི་གདངས་ཆག་པ་སོགས་མཁས་པར་རློམ་པ་དག་ཀྱང་བག་འཁུམས་པའི་གནས་ལ་འགོད་པར་མཛད་དོ།",
    "དབྱངས་ཅན་མ་དཀར་མོ་དང་དམར་མོ།",
    "ལྷ་མོ་དུར་བདག་ཡབ་ཡུམ།",
    "ལམ་རིམ་འཇམ་དཔལ་ཞལ་ལུང་གི་ཁྲིད་རྒྱས་པ།",
    "སྤྱོད་འཇུག་ཆེན་མོ།",
    "མཚན་མོ་གན་རྐྱལ་དུ་གཟིམས་པ་ཡང་མི་དྲན་ཞེས་ཞལ་ལས་གསུངས།",
    "དགེ་ལྡན་ལྔ་མཆོད་ཆེན་མོ་འབྲེལ་བར་རྒོལ་བ་སྨྲ་བའི་སེང་གེ་བྱེ་བའི་དཔུང་ཚོགས་རྔམ་ལ་ཟིལ་ཆེ་ཞིང་།",
    "དགག་སྒྲུབ་ཁྲོས་པའི་ངར་སྐད་གནམ་ལྕགས་ཐོག་གི་མེ་ཆར་མཁའ་ལས་སྤྲོ་བ།",
    "རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱི་མན་ངག་གིས་རྒྱས་བཏབ་པ།",
    "མཁས་རློམ་གྱི་རི་ཕྲན་དུ་མ་རྨག་མེད་དུ་བཅོམ་པའི་གཏམ་རྒྱུད་རིང་མོ་ཞིབ་པར་མ་སྤྲོས་སོ།",
    "ཐུགས་མཉེས་པའི་སྐུ་རྩེད་དང་བཅས་བཞད་མོ་གནང་།",
    "རྗེ་འདིས་འདོད་བསྟུན་གྱི་ཞལ་ཟས་གསོལ་བས་ཁམས་མི་བདེ་བར་གྱུར་མོད།",
    "ནང་ཉོན་མོངས་དུག་གསུས་ངས་མ་ཐུབ།",
    "དེ་ལྟར་དགུང་ལོ་བཅུ་དགུ་ནས་སོ་དྲུག་གི་བར་གཞུང་པོ་ཏི་ལྔའི་དཔྱད་པ་ཡོངས་སུ་རྫོགས་པ་མཛད་དེ་རབ་འབྱམས་གཞུང་ལུགས་རྒྱ་མཚོའི་དེ་ཉིད་འབྱེད་པ་ལ་སྤོབས་པའི་གདེང་རྙེད་ཅིང་བསླབ་གསུམ་ཉམས་བཞེས་ཀྱི་རྟོགས་པ་ཀློང་དུ་བརྡོལ།",
    "བསྟན་པའི་མངའ་བདག་ཆེན་མོ་རེབ་གོང་སྐུ་ཕྱོགས་ཚང་གདན་སར་ཕེབས།",
    "ཁྱད་པར་དུ་རྗེ་འདི་ལ་ཨ་ཁུ་ཞོ་འོང་གི་ཡོན་ཏན་སྐྱེ་བ་གཅིག་ལ་སྦྱངས་པའི་ཡོན་ཏན་མིན་གསུངས།",
    "ལས་བཞི་ཐིག་གི་ཆ་ཚད་སོགས་འཆད་རྩོད་རྩོམ་པའི་ཐུགས་མི་དལ་བར་གྱུར།",
    "རྐང་ཚ་ཆུང་བ་ཚང་སོགས་དགེ་ཕྲུག་རྣམས་ལ་རྗེ་ཡབ་སྲས་གསུམ་གྱི་གསུང་འབུམ་ཆ་ཚང་གི་བཀླག་ལུང་བསྩལ།",
    "ཚིག་གིས་ཐམས་ཅད་བྱེད་པར་འགྱུར།",
    "དེ་དང་སྟབས་གཅིག་ཏུ་སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པའི་བདག་པོ་རེབ་གོང་སྐུ་ཕྱོགས་ཆེན་མོཪ་ཞལ་མཇལ་དུ་ཕྱིན།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་དུ་གེ་སར་སྒྲུང་སོགས་བོད་ཡིག་གི་དཔེ་དེབ་སྐོར་ལ་ཞུ་དག་གནང་།",
    "ལོ་རེ་གཉིས་ལ་ཟི་ལིང་དུ་བཞུགས།",
    "ཡང་དག་པ་མ་ཡིན་པའི་ཉོན་མོངས་རབ་ཏུ་ཞི་བར་འདོད་པ་དང་།",
    "བདག་གི་སྡུག་བསྔལ་དང་བྲལ་བར་འདོད་པ་དང་།",
    "འཛིན་མའི་ཁྱོན་ཐམས་ཅད་མུན་ནག་ཏུ་བསྒྱུར།",
    "དཀོན་ང་བརྩེགས་འོད་སྲུང་ལེའུརསེང་གེ་སྲོག་དང་བྲལ་ཡང་གཅན་གཟམི་བཟོད་ན་ཟ་བ་ལྟ་ག་ལ་དེ་ཉིད་ཀྱི་ཁོག་པའི་ནང་གིས་འབུས་ཟ།",
    "དེ་བཞིན་ཁོང་གིས་སྤྱན་འབྲས་ལྟར་གཅེས་པའི་དགེ་ཕྲུག་ནང་མ་ཞིན་ཧེ་དོན་གྲུབ་ཚང་།",
    "སྟོན་ཁར་གནས་ལྔ་གཟིགས་པའི་པཎ་ཆེན་ཚེ་ཏན་ཞབས་དྲུང་ཚང་བྱ་ཁྱུང་དུ་ཕེབས་པ་དང་མཇལ།",
    "འདིར་ཀུན་གཟིགས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པར་ཚེ་བུམ་འབུལ་དུ་པེ་ཅིན་དུ་ཕེབས།",
    "ཀུན་གཟིགས་ཡེ་ཤེས་ཀྱི་ཉི་མ་མཆོག་གིས་དགྱེས་བརྩེ་གནང་ཞིང་།",
    "འཇམ་དབྱངས་དཔལ་གཅིག་དབྱངས་ཅན་མ་དཀར་མོ།",
    "བསྡུས་གྲྭ་སྐོར་གསུམ་སོ་སོར་རང་རང་གི་རྩོད་མཚམས་སྐུ་ངལ་ལ་མ་འཛེམས་པར་མཛུབ་ཁྲིད་བསྐྱངས།",
    "གྲྭ་ཚང་གི་གནས་བརྟན་བགྲེས་གཞོན་རྣམས་དང་ལྷན་དུ་མཚོ་མགོར་ཕེབས།",
    "ཟླ་གཉིས་པའི་ནང་བོ་ཐོ་ལ་ཁའི་སྔགས་མང་གིས་ཞུས་ངོར།",
    "བཛ་གུ་རུ་སོགས་འདོད་མོས་ལྟར་གནང་།",
