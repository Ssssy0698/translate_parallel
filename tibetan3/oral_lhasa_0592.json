    "ཉམས་པ་མེད་པའི་རྣམ་པར་སྨིན་པས་ཡོངས་སུ་བསྔོའོ།",
    "འདོད་པ་དང་ལྡན་པར་བྱ་བའི་བསམ་པས་ཡོངས་སུ་མི་བསྔོའོ།",
    "ཏིང་ངེ་འཛིན་དང་སྙོམས་པར་འཇུག་པའི་རོ་ལ་ཆགས་པས་ཀྱངཁུཡོངས་སུ་མི་རི་༩",
    "འདི་ལྟར་འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྦྱིན་པར་བྱ་བ་དང་།",
    "གདུལ་བའི་དོན་དུ་ཐམས་ཅད་མཁྱེན་པའི་༡༡ཡེ་ཤེས་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཡོངས་༡༢སུ་བསྔོའོ།",
    "བསམ་པ་བརྟེན་༡༨པ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "པ་ལ་རབ་ཏུ་གནས་པར་བྱ་བའི་ཕྱིར་ཉེ་བར་གནས་ཤིང་ཡོངས་སུ་བསྔོའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྤྱོད་པ་ལ་གྲུབ་པའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "བདུད་ཀྱི་དཀྲུགས་མ་ཐམས་ཅད་རྣམ་པར་གཏོར་རི་",
    "དྲན་པ་རྣམ་པར་སྦྱངས་པས་ཡོངས་སུ་བསྔོའོ།",
    "བློ་གྲོས་ཡིརྣམ་པར་ངེས་པས་ཡོངས་སུ་བསྔོའོ།",
    "ལྷག་པའི་བསམ་པ་༧རྣམ་པར་དག་པས་ཡོངས་སུ་བསྔོའོ།",
    "བདུད་ཀྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་རྣམ་པར་གཏོར་བའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "རྣམ་པར་དག་པ་དང་ཆགས་པ་མེད་པ་ཐམས་ཅད་རབ་ཏུ་འཐོབ་༣པར་བྱ་བའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱ་བ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྨིན་པར་བྱ་ཞིང་གདུལམ་བ་དང་།",
    "བསམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་སེམས་ཀྱི་རྒྱུད་ཤིན་ཏུ་ཚིམ་པར་བྱ་བ་དང་།",
    "ཞིང་ཐམས་ཅད་དུ་སྒྲས་༧༧རྒྱས་པར་འགེངས་པའི་དབྱངས་དང་།",
    "སྒྲ་ཆེ་བས་རྣམ་པར་འཁྲུག་པ་ཐམས་ཅད་རབ་ཏུ་ཞི་བར་བྱེད་པའི་དབྱངས་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱིས་ངག་མཉན་པའིཚམ་དབྱངས་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "༧༧དབྱངས་ཐམས་ཅད་ཀྱིས་བརྒྱན་པའི་དབྱངས་ཀྱི་ཡན་ལག་རྣམ་པར་དག་པའི་དབྱངས་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "འགྲོ་བ་ཐམས་ཅད་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་རྣམ་པར་དག་པའི་མཐར་ཐུག་པར་བྱེད་༣ནཔ་དང་།",
    "༥འགྲོ་བ་ཐམས་ཅད་ཀྱི་ཐེ་ཙོམ་གཅོད་ཅིང་༧ཁོང་དུ་ཆུད་པར་བྱེད་པའི་དབྱངས་དང་།",
    "སྤོབས་པས་ལེགས་པར་སྦྱར་བའི་དབྱངས་དང་ཉ།",
    "རྣམ་པར་དག་པ་རྡུལ་མེད་པ་དྲི་མ་དང་བྲལ་བ་འོད་གསལ་ཞིང་དང་བ།",
    "མིག་ཡོར་གྱི་རྣམ་པར་དམྱིགས་པས་འགྲོ་བ་ཐམས་ཅད་སྣང་བར་གྱུར་ཅིག།",
    "ཡོན་ཏན་ཡང་དག་པར་སྟོན་པ་དང་།",
    "ནན་ཏན་ཡང་དག་པར་སྟོན་པ་དང་སྐེ།",
    "ཆོ་འཕྲུལ་ཡང་དག་པར་སྟོན་༡༢པ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་མ་འོངས་པའི་དུས་ཀྱི་༧ཕྱི་མའི་མཐའི་༡༡མུར་ཐུག་པར་གནས་པ་དང་།",
    "བ་ཡོངས་སུ་བཏིང་ནི་བ་གྲངས་མེད་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་ཀྱི་སྤོས་ཆགས་པ་མེད་པའི་མཐར་ཐུག་པའི་སྤོས་ཀྱི་ཡིད་ཀྱི་ལས་རྒྱ་ཆེན་པོ་ཡོངས་སུ་དག་པ་ཚད་ཉེམེད་པའི་བར་དུ་༧ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ཅེས་བྱ་བ་ནས་ཡེ་ཤེས་ཀྱི་མེ་ཏོག་ཆགས་པ་མེད་པའིསྙིམཐར་ཐུག་པའི་ཡིད་ཀྱི་ལས་མེ་ཏོག་རྒྱཚམཆེ་ཞིང་ཡོངས་སུ་དག་པ་བསམ་གྱིས་མི་ཁྱབ་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ཞིང་ཐམས་ཅད་དུ་གདུགས་སྣ་ཚོགས་ཡང་དག་པར་བཙུགས་ཀྱེཔའི་གདུགས་ཀྱི་རྒྱན་ས་འཚམས་སྟི་མེད་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་ནསྔོ་ཡེ་ཤེས་ཀྱི་གདུགས་ཀྱི་རྒྱན་༧༡་ཆགས་པ་མྱེད་པའི་མཐར་ཐུགཚྭཉེཔའི་ཡིད་ཀྱི་ལས་ཡེ་ཤེས་ཀྱིསཚྭ་ཡང་དག་པ་ཁྱབ་པ་ཡོངས་སུ་དག་པ་ས་མཚམས་མེད་པའི་བར་དུ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ལྷབ་ལྷུབ་སྣ་ཚོགས་ཐམས་ཅད་ཀྱི་ལྷབ་ལྷུབ་ཀྱི་རྒྱནམཉེབརྗོད་དུ་མེད་པའི་ཡང་ཉེབརྗོད་དུ་མེད་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་ནས་སྟེ།",
    "ཡེ་ཤེས་ཀྱི་ལྷབ་ལྷུབ་ཀྱི་རྒྱན་གྱི་མཐར་ཐུག་པའི་ཡིད་ཀྱི་ལས་ཀྱི་ཡེ་ཤེས་ཀྱི་ལྷབ་ལྷུབ་ཀྱི་རྒྱན་གྱིས་བརྒྱན་པ་རྣམ་པར་དག་པ་བརྗོད་དུ་མེད་པའི་ཉེཡང་བརྗོད་དུ་མེད་པའི་བར་དུ་ཙོཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "དེ་ལྟར་ཚུལ་དེ་བཞིན་དུ་ཐམས་ཅད་དུ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ཚུལ་དེ་བཞིན་དུ་ཀུན་ཏུ་བྱས་ཏེ།",
    "གོམས་པར་བྱ་བ་དང་།",
    "རྣམ་པར་ཤེས་པ་མཉམ་པ་ཉིད་ལ་གནས་ཤིང་ཡོངས་སུ་བསྔོའོ།",
    "རྣམ་པར་བྱང་བ་རྣམ་པར་དག་པ་མཉམ་པ་ཉིད་ལ་གནས་ཤིང་ཡོངས་སུ་བསྔོའོ།",
    "མཉམ་པའི་༡༡ལུས་ཡོངས་སུ་དག་པ་ཀུན་ནས་གནས་པར་འགྱུར་རོལ།",
    "བླ་ན་མེད་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོབས་དང་མི་འཇིགས་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "ཀུན་ནས་གནས་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "རྒྱ་ཆེན་པོའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "བསྒྲིབས་པ་མེད་པའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "བསམ་གྱིས་མི་ཁྱབ་པའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་རྣམ་པར་དག་པར་བྱེད་པའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་བྱིན་གྱིས་རློབ་ཅིང་བརྟེན་མེཔར་བྱེད་པའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "ཤིན་ཏུ་བསྟན་པ་བརྗོད་དུ་མེད་པའི་རྣམ་པར་འཕྲུལ་པ་དང་།",
    "སྐྱེ་མཆེད་ཡོངས་སུ་ཤེས་པའི་ཡེ་ཤེས་ཐམས་ཅད་རྣམ་པར་དག་པ་དང་།",
