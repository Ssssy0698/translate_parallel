    "དགྲ་ཐམས་ཅད་དང་མཛའམ་༧བ་ཐམས་ཅད་བདེ་བ་ཐམས་ཅད་ལ་གཟུང་བའི་༨ཡེ་ཤེས་རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "བསྒྲིབས་༡པ་མེད་པའི་དབྱིངས་ལ་གནས་པར་ཡོངས་སུ་བསྔོའོ།",
    "འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྡུད་པས་འགྲོ་བ་ཐམས་ཅད་རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་མཐར་ཐུག་༨",
    "དེ་བཞིན་གཤེགས་པའི་དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱིས་ཤིན་ཏུ་སྟན་པ་ཡང་དག་པར་བསྟན་༡་པས་མདངས་དགའ་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་ཉི་མས་སེམས་ཤིན་ཏུ་སྣང་བར་བྱས་པ་།",
    "དུས་མཉམ་པ་ཉིད་ལ་རྣམ་པར་དཔྱད་༡༢པ་དང་།",
    "དོན་ཤེས་པ་ཁོང་དུ་ཆུད་པར་བྱ་བ་དང་།",
    "ལས་ཐམས་ཅད་ཡང་དག་པར་བསྩགས་ཉ་༧པ་ལ་འཇུག་པ་དང་།",
    "བརྗོད་པ་ཐམས་ཅད་ལ་གནས་མེད་པར་ཤིན་ཏུ་བསྒྲུབ་པ་དང་སྐེ།",
    "གནས་ཐམས་ཅད་རྐྱེན་སྣ་ཚོགས་ཀྱིས་བྱུང་བ་ཡང་དག་པར་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་པར་བྱ་བ་དང་།",
    "ཡོངས་སུ་བསྔོ་བ་རྣམ་པར་དབེན་པ་ལ་རབ་ཏུ་དཔྱོདམ་དཔ་དང་།",
    "ཁྱད་པར་མེད་པའི་༣སེམས་ཀྱིས་འཇིག་རྟེན་ཐམས་ཅད་ལ་ཡོངས་སུ་བསྔོ་སྟེ།",
    "དེ་བཞིན་ཉིད་ཀྱི་སྤྱོད་ཡུལ་གང་ཡིན་པ་དེ་བཞིན་དུ་དསྐེ་བའི་རྩ་བ་དེ་དག་དེ་བཞིན་གཤེགས་པའི་སྤྱོད་ཡུལ་ཁོང་དུ་ཆུད་ཉི་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "དེ་བཞིན་ཉིད་ཀྱིས་ཇི་ལྟར་འགྲོ་བ་ཐམས་ཅད་ཡང་དག་པར་བཟུང་ནི།",
    "སྐད་ཅིག་གཅིག་༡་ཏུ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་དུས་ལ་འཇུག་པར་མཁས་པ་ལ་རབ་ཏུ་གནས་པར་གྱུར་ཅིག།",
    "སྟོབས་ཀྱི་མཛོད་གྲངས་མེད་པ་ལ་གནས་པར་གྱུར་ཅིག།",
    "བརྗོད་པ་དང་རྣམ་པར་བརྗོད་པ་དང་།",
    "ཤིན་ཏུ་གནས་པར་གྱུར་ཅིག།",
    "གནས་ཡེ་ཤེས་ཀྱི་ས་ཐོབ་པར་གྱུར་ཅིག།",
    "ལས་ཀྱི་རྣམ་པར་སྦྱིན་པ་ཐམས་ཅད་མཉམ་པ་ཉིད་འཐོབ་བོ།",
    "དེ་བཞིན་གཤེགས་པ་༥རྣམ་པར་འཕྲུལ་པ་མཐའ་དང་དབུས་མེད་པ་ཡོངས་སུ་རྫོགས་པ་རབ་ཏུ་འཐོབ་པོ།",
    "དེ་བཞིན་གཤེགས་པ་༢ཐ་དད་པ་ཡང་དག་པར་ཤེས་པ་མཐའ་དང་དབུས་མེད་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པ་རབ་ཏུ་འཐོབ་པོ།",
    "གནས་རྣམས་ཐམས་ཅད་མ་ལུས་མཐོང་བྱས་ཤིང་།",
    "རྣམ་པ་ཐམས་ཅད་འཇིག་རྟེན་བླངས་བྱས་ཤིང་།",
    "རང་བཞིན་དེ་འདྲར་སེམས་ཀྱང་བསྒྱུར་བྱས་ཤིང་།",
    "དེ་ལྟར་ལས་རྣམས་ཤིན་ཏུ་དག་པར་བྱེད།",
    "ཆགས་མེད་སེམས་ནི་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འཇུག་པར་བྱེད་པའང་གང་༧ཡང་དམིགས་པ་མེད།",
    "དེ་ལ་སེམས་ནི་ལྷག་མ་མེད་པར་བྱེད་།",
    "སེམས་ནི་སེམས་མིན་རྣམ་པར་དབེན་པ་༡༢ཤེས།",
    "དེ་ཕྱིར་ཡོན་ཏན་རྣམ་པར་གྲགས་པ་ཡིན།",
    "དེ་དག་རྣམ་སྨིན་ཐམས་ཅད་མ་ལུས་པར།",
    "ཡེ་ཤེས་རྒྱས་བཏབ་ཟད་པར་མི་འགྱུར་ཏེ།",
    "འཆི་འཕོ་ཡོངས་སུ་རྟོག་པ་མེད་བྱས་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ཇི་སྙེད་༡༢ཐ་དད་པའི།་",
    "བམ་པོ་བཅུ་པར།",
    "འཇིག་རྟེན་གྱི་ཁམས་གཞན་ལྷན་བཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་༡༢ལ་ཕྱག་བྱ་བའི་ལས་ལ་བརྙས་༡༢པ་མྱེད་པའི་སེམས་དང་ལྡན་པ་ཡིན།",
    "འཇིག་རྟེན་གྱི་ཁམས་གཞན་ན་ཚབཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་གསོལ་བ་གདབ་པའི་ལས་ལ་བརྙས་པ་མྱེད་པའི་སེམས་དང་ལྡན་པ་ཡིན་ཏེ་༡།",
    "འདི་ལྟར་ཆགས་པ་མྱེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་ཀུན་ཏུ་བཟང་པོའི་ལུས་ཀྱི་ལསམཇུ་༨༧རབ་ཏུ་གྲུབ་པར་གྱུར་ཅིག།",
    "ཆགས་པ་མེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་ཀུན་ཏུ་བཟང་པོའི་ཡིད་ཀྱི་སྣ་ཚོལས་ཡོངས་སུ་རྫོགས་པར་གྱུར་ཅིག།",
    "ཐམས་ཅད་དུ་༡༡རབ་ཏུ་བརྩོན་པས་ཆགས་པ་མེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་ཀུན་ཏུ་བཟང་པོའི་རྩོམ་༡༢པ་ལ་བསྟེན་༡་པར་གྱུར་ཅིག།",
    "གྲོལ་ཞིང་བཅིངས་པ་མེད་པའི་སེམས་སུ་༡༡ཀུན་ཏུ་བཟང་པོ་དང་མངོན་སུམ་དུ་འགྱུར་བའི་གནས་སུ་འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་མཐའ་དག་༡༢ལྷག་པ་མེད་ཅིང་མ་ལུས་པར་གཟུང་བ་༡་བསྟན་པར་བྱིན་གྱིས་བྱིན་དུ་རློབ་༧པར་གྱུར་ཅིག།",
    "རྣམ་པར་འཕྲུལ་པ་ཐམས་ཅད་ཡང་དག་པར་སྟོན་པར་གྱུར་ཅིག།",
    "ཀླས་པར་གཏོགས་པར་རི་༩༧ཐམས་ཅད་དུ་རྗེས་སུ་དྲན་པར་གྱུར་ཅིག།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་གཏོགས་པར་ཤིན་ཏུ་བསྟན་པ་ལ་འཇུག་པར་གྱུར་ཅིག།",
    "གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་རྒྱུད་མཐའ་ཡས་པའི་སྤྱོད་པའི་རྒྱུས་ད་སྟོན་པར་གྱུར་ཅིག།",
    "བསྐལ་པ་ཐམས་ཅད་ཚོཟད་པར་གྱུར་ཀྱང་ཡེ་ཤེས་མཐའ་དང་དབུས་༥སྐྱེད་པའི་མཐར་མྱི་འགྱུར་ཞིང་༥དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་བྱིན་གྱི་རླབས་༤ཀྱང་ཀུན་ཏུ་བཟང་པོའི་སྤྱོད་པས་རབ་ཏུ་གྲུབ་པར་གྱུར་ཅིག།",
    "ཐམས་ཅད་མཁྱེན་པའི་སའི་མཐར་ཐུག་པ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "༡ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་མཐར་ཐུག་པར་མྱི་འགྱུར་བའི་ཚུལ་གྱི་༢རྒྱལ་པོ་དེ་ལྟ་བུ་ཐོབ་པར་གྱུར་ཅིག།",
