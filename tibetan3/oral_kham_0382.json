    "ཁྱེད་རང་རྣམས་ཀྱང་རིགས་ལྔ་སོ་སོའི་ང་རྒྱལ་དང་ལྡན་པས་ཕྱག་རྒྱ་འདི་རྣམས་ཀྱང་མཛད་པར་ཞུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སློབ་དཔོན་ལ།",
    "ཁྱེད་རང་རྣམས་སྣོད་དང་ལྡན་མི་ལྡན་བརྟག་པའི་ཕྱིར།",
    "དྲི་བ་མཛད་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ཆུ་སྐྱེས་རྩ་མཛེས་པའི་བྷ་ག་བསྟན་ནས་པདྨའི་ཆེ་བ་བརྗོད་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ངེད་རང་ལ་དགེས་པའི་མདངས་བསམ་གྱིས་མི་ཁྱབ་པ་ཅིག་མཛད་ཀྱི་འདུག་ལ་མཐོང་ནས།",
    "པཎྜི་ཏར་གྱུར་ཙ་ན།",
    "ས་རོ་རུ་ཧའི་མཚན་ཙམ་ནི་འདུག་ཅིང་།",
    "དེར་བོད་ཡིག་ཏུ་མཚོ་སྐྱེས་རྡོ་རྗེ་ཞེས་བྲིས་འདུག་ན་དེ་གཉིས་གཅིག་ཡིན་ནམ་ཐ་དད་ཡིན་ཆ་མ་འཚལ།",
    "ཌ་ཝིཌ་ཊེམ་པལ་མེན་གྱི་དབྱིན་འགྱུར་དུ་ཀཱནྟ་ཞེས་བསྒྱུར་འདུག་པ་ནི་རྩ་བའི་མ་ཕྱིའི་དག་ཆ་དང་མི་མཐུན།",
    "དེ་ནང་འཁོད་པ་རྣམས་འདི་ཡི་ཁ་སྐོང་ལྟ་བུར་གྱུར་འདུག།",
    "ཞེས་པ་ལ་གཞིགས་ན་ཨིནྡྲ་བྷུ་ཏི་བར་པ་ཀུཀཱུ་རཱཛ་མིན་པ་གསུང་མེད་ཀྱང་ལྭ་ཝ་པ་དང་གང་ཟག་ཅིག་ཏུ་གསུངས་འདུག་པས་གྲུབ་ཆེན་རྣམས་ཀྱི་ངོས་འཛིན་གང་དྲན་དྲན་དུ་བཞག་ན་ག་ལ་འཐད།",
    "ཡབ་སློབ་དཔོན་དང་སྐུ་ཚེ་མཉམ་པར་བྱིན་གྱིས་བརླབས་འདུག།",
    "ཁྲིའི་སྟེང་ན་མི་སྔོན་པོ་ཉི་ལྷགས་ཀྱིས་ཁྱེར་བ་སྐྲ་འཛིངས་པ་ཞིག་ཉལ་ནས་འདུག་པ་ལ།",
    "བལྟས་པས་དེའི་ལུས་ཀྱི་འོད་དུ་འདུག།",
    "ཤཱ་བཱ་རི་པའི་དབུའི་རལ་པ་བཤིག་པས་སྲོ་ཤིག་ཉིལ་གྱིས་བྱུང་བ་ཡུམ་གཉིས་ཀྱིས་གསོལ་བར་འདུག་པས་མེ་ཏྲི་པ་ཅུང་ཟད་ཐུགས་མ་དད།",
    "རྣ་བ་ཡ་གར་ལུས་པས་ཀྲོང་ངེ་བ་ད་ལྟའང་འདུག་གསུང་།",
    "ཌཱ་ཀི་ནཱི་པ་ཊ་ཞེས་པ་འདི་བོད་རྣམས་ལྷོ་ཕྱོགས་ཡིན་ཟེར་ནའང་ཡོད་ནི་ཤར་ཕྱོགས་ན་ཡོད་པར་གདའོ།",
    "རྫིའུ་ནས་ཆུ་འདོད་པས་སྐོམ་འཐུངས་པ་མྱོས་བྱེད་དུ་འདུག།",
    "དེ་ནས་ནེ་ཙོ་དེས་ཤིང་ཏོག་སླར་ཁོ་རང་ལ་གཏད།",
    "གདམས་པ་ཡང་གནང་བས་དེ་ཉིད་སྒོམ་བཞིན་དུ་རྩེ་གཅིག་ཏུ་འདུག་པ་ན།",
    "རྒྱལ་པོས་ཀྱང་དེ་ཉིད་སྒོམ་བཞིན་དུ་འདུག་པ་ན།",
    "རྒྱལ་པོས་རྣལ་འབྱོར་པ་ངན་པ་དེ་མ་འདུག་ཟེར།",
    "ད་ལྟ་ལྕགས་ཀྱིས་བསྡམས་ནས་འདུག།",
    "དྲང་སྲོང་སྐྲ་འཛིངས་པ་འཇིགས་འཇིགས་ལྟར་འདུག་ནས་འདྲེ་ཡིན་ནོ་སྙམ་ཕྱིར་བྲོས་པ་ན།",
    "ཤིན་ཏུ་དམན་པའི་སྤྱོད་པ་ལྟར་བཅོས་པས་སོ་མ་བསོད་དོ་ དེར་ཉིན་ཞག་མང་པོའི་བར་དུ་འདུག་པ་ན།",
    "དེ་ཁོ་ན་ཉིད་ཀྱིས་རྗེས་སུ་གཟུང་བར་ཞུ་ཟེར་གྱིན་འདུག་ཟེར་བ་ན།",
    "ཡང་ཡང་འགྲོ་ཞིང་འདུག་པས་ཅི་བྱེད།",
    "དེས་ཀྱང་དེ་བཞིན་བྱས་པས་མིག་གདངས་ཙམ་ན་སློབ་དཔོན་གྱི་མདུན་དུ་སླེབ་འདུག་སྐད།",
    "འོན་ཀྱང་དེ་བཞིན་དུ་བྱས་པས་ཡུད་ཙམ་གྱིས་ལམ་རྣམས་ཆོད་འགྲོ་ཡིན་འདུག་ནས་དན་རྟགས་རྣམས་ཁྱེར་ཞིང་འོངས་ནས།",
    "པི་ཝཾ་མཁན་ཞིག་རྒྱལ་པོ་ལ་སེམས་ཤིང་འདུག་ཅེས་སྒོ་བས་རྒྱལ་པོ་ལ་སྦྲན་པས་ནང་དུ་བོས་པ་ན།",
    "ཅི་འདུག་མྱུར་བ་མྱུར་བར་སྨྲོས་གསུང་།",
    "དེར་རྒྱལ་པོས་ཅང་མི་འདུག་བརྗོད་པ་ན།",
    "འོ་ན་ང་ལ་ཚ་བོ་མང་དུ་ཡོད་པར་འདུག།",
    "དྷ་མ་པ་དང་དྷུ་མ་པ་གཉིས་འདུག་པ་ལས།",
    "ནགས་ཚལ་འདིར་འདུག་ན་རྩྭ་དང་ཤིང་འཛོམ་ལ།",
    "སློབ་དཔོན་གཤེགས་ནས་མི་འདུག།",
    "རྒྱལ་པོའི་དྲུང་དུ་འདུག་པའི་ཚེ།",
    "སློབ་དཔོན་རིག་མ་དང་ལྷན་ཅིག་མི་གང་ཙམ་གྱི་ནམ་མཁའ་ལ་ཏིལ་རྡུང་བཞིན་འདུག་གོ།",
    "ནཱ་རོ་པ་རུང་ཁང་ན་ཡོད་ཙ་ན།",
    "སློབ་དཔོན་དེ་ལ་ཞེན་ཞེན་ལྟར་མཛད་ཅིང་འདུག་པས།",
    "བག་མ་ཞིག་འགྲོ་ཡིན་འདུག་པ་ལ་ཡང་སྔ་མ་ལྟར་གསུངས་ནས་གསོས་པའི་བར་གོང་བཞིན།",
    "འདི་ན་ཆུ་དང་མེ་ཏོག་མི་འདུག་ཞུས་པས།",
    "དེའི་ནང་པར་རྩོད་པ་མཛད་ཙ་ན་རྩོད་པ་ཅུང་ཟད་ཕམ་པས།",
    "རྒྱ་གར་མཁས་པ་རྣམས་མཇལ་བར་མཛད་ཀྱིན་འདུག།",
    "འགྲེལ་པ་དེའི་གླེགས་བམ་གྱི་རྒྱ་དཔེ་ཡང་སློབ་དཔོན་ནི་ཏྲཱ་ཎ་ཤྲཱིའི་ཕྱག་ན་འདུག་པ་ཁོ་བོས་ཀྱང་མཐོང་ངོ།",
    "མི་མགོའི་གཟུགས་ཅན་ཁང་པ་ཙམ་ནག་པོ་གཉིས་འདུག་སྐད།",
    "ཁོང་ཉིད་ཀྱིས་ལོ་བཅུ་གཉིས་སུ་ཤར་ཕྱོགས་ས་ར་བྷང་གའི་ནགས་ཚལ་དུ་འདུག་སྟེ་ཁ་ཟས་ཀྱི་འཁྲི་བ་བཅད་ནས་ཆུ་ཁོ་ན་གསོལ་ཞིང་བསྒྲུབས་པས་རྟོགས་པ་ནམ་མཁའ་དང་མཉམ་པ་སྐྱེས།",
    "དེར་ཕྱག་རྒྱ་བཞིའི་གདམས་ངག་ཞུས་པ་ཕྱག་རྒྱ་གཞན་གསུམ་གྱི་སྐབས་གདམས་ངག་ང་རང་ཆེ་སྙམ།",
    "སློབ་དཔོན་འདི་རྒྱལ་རིགས་ཀློག་པ་པོ་ཞིག་ཡིན་ཟེར་བའང་འདུག།",
    "ཞོ་བཟང་པོ་དྲངས་པ་གསོལ་ནས་འབྱོན་པར་ཆས་ཙ་ན།",
    "དེར་ལྷ་རྣམས་ཀྱིས་སློབ་དཔོན་སྤྱན་དྲངས་ཏེ་སུམ་ཅུ་རྩ་གསུམ་དུ་འདུག་པ་ལ།",
    "ཁ་ཅིག་ལས་དེའི་ཚ་བོ་རྒྱལ་པོ་ཙ་ན་ཀ་ཡིན་ཟེར་བ་གཉིས་ལས།",
    "འདིར་མ་འདུག་བྱས་པས།",
    "འོ་ན་རྡོ་རྗེ་རྣལ་འབྱོར་མས་དངོས་གྲུབ་བསྒྲུབས་པ་མ་བླངས་པར་འདུག་པ་གསུང་།",
    "བསྐོར་བའི་དབུས་ན་བྲག་རི་ཆེན་པོ་ཞིག་ཡོད་པ་དེར་འདུག་སྐད།",
    "དེ་གསུམ་པོ་སྟན་གཅིག་ལ་འདུག་སྟེ།",
    "ཡན་ལག་ནས་ཁྲག་ཕྱུང་སྟེ་འདུག་པ་ལ།",
    "འོ་ན་སྔར་བཞིན་གྱུར་ཅིག་བྱས་པས་ཚོང་པ་རྣམས་སླར་ལྡོག་ནས་བལྟས་པའི་ཚེ་ཡོ་བྱད་ཐམས་ཅད་སྔ་མ་བཞིན་དུ་ཐམས་ཅད་བཟང་པོར་གྱུར་ནས་འདུག།",
    "ཡུལ་གོ་དཱ་བ་རི་ན་རྣལ་འབྱོར་པ་གྲངས་མེད་པ་འདུག་པའི་གྲལ་གྱི་ཐ་མ་ཞིག་ན།",
    "ཡན་ལག་ལས་རྣག་ཁྲག་ལྷུང་བ་ཞིག་འདུག་པས་དེ་ཡིན་པར་ཤེས་ནས་ཕྱག་བཙལ་ཞིང་གསོལ་བ་བཏབ་པས།",
    "གཞན་སེམས་ཤེས་པར་འདུག་ནས་སུ་ཡིན་དྲིས་པས།",
    "དགུང་ལོ་ཉི་ཤུ་རྩ་གཉིས་པ་ལཔ་རྒྱ་མཚོའི་འགྲམ་ཀོང་ཀུ་ནའི་ཡུལ་དུ་གསེར་གྱི་རྒྱལ་མཚན་ཞེས་བྱ་བའི་གནས་གཞི་ཞིག་དུས་དེ་ཙམ་ན་བཙུན་ཚུགས་བཟང་བ།",
    "ལན་ཅིག་ཆུ་འགྲམ་ཞིག་ན་སྨད་འཚོང་མ་དྲུག་ཁྲུས་བྱེད་ཅིང་འདུག།",
    "རྩྭ་ཁྱིམ་ཐམས་ཅད་ལ་མེ་འུར་འུར་འབར་གྱིན་འདུག།",
    "ཐུགས་ཀྱང་གཡོ་བ་མེད་པར་འདུག་པ་དེས་མཐོང་ནས་ཅུང་ཟད་དད་པར་གྱུར་ཏེ།",
    "སྒོ་ལྕགས་ཀྱང་རང་བྱེ་ནས་ཞི་བ་སྦས་པ་དང་བཙོན་ལྔ་སྟོང་ལྷན་ཅིག་ཐར།",
    "ཡང་ཧིན་དུའི་རྟ་པ་ཞིག་སློབ་དཔོན་ལ་དད་དེ་གསེར་དང་དངུལ་གྱི་མེ་ཏོག་བྲེ་གང་སྐུ་ལ་གཏོར་བས་ཀྱང་སྔ་མ་ལྟར་ཚོར་བ་མེད་པ་ལྟར་འདུག།",
    "ཟས་སྐོམ་གཅིག་ཀྱང་མ་དྲངས་པར་ཉིན་ཞག་བདུན་འདས་ཀྱང་སྐུ་ལུས་སྔ་མ་བཞིན་དུ་འདུག་ལ།",
    "རིའི་ཟུར་ཞིག་ན་རི་དྭགས་ཧི་རཎ་ཞིག་འདུག་པ་མཐོང་།",
    "མཧཱ་བོ་དྷི་མཇལ་དུ་འགྲོ་བའི་ནས་གླིང་པའི་དགེ་སློང་མང་པོ་འདུག་པ་དེ་ཀུན་བཀའ་བབས་བདུན་ལྡན།",
    "སློབ་དཔོན་ལ་ཕྱག་མི་འཚལ་བར་འདུག་གསུང་།",
    "ལོ་བརྒྱད་ཅུ་ལོན་ཙ་ན་གྲུབ་ཆེན་ཞི་བ་སྦས་པས་གྲུབ་པ་བརྙེས་ཏེ།",
    "ཁ་ཅིག་ཤེས་པ་ཐམས་ཅད་ཁོ་རང་ལ་རང་རིག་མངོན་སུམ་ཡིན་ཟེར་ཏེ།",
    "བུམ་འཛིན་རྟོག་པ་དེ་ཁོ་རང་ལ་མངོན་སུམ་ག་ལ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་འབྲས་ཞེས་པས་རང་འབྲས་གཟུགས་འཛིན་ཡིད་མངོན་སྐྱེད་བྱེད་མིན་པ་རྣམས།",
    "དེ་རགས་པ་ཡིན་གྱི་རྡུལ་ཕྲན་མཚན་ཉིད་པ་མིན་པར་ཁས་བླངས་འདུག་ཀྱང་།",
    "བསྐལ་པ་འཇིག་དུས་ཀྱི་གཟུགས་སྐད་ཅིག་མ་ཆ་མེད་པས།",
    "དེ་ལ་དངོས་སྐྱོན་ཚིག་སྐྱོན་མི་འདུག་པའི་ཕྱིར།",
    "ཁོ་རང་དང་དུས་མཉམ་པའི་གཟུགས་སྐད་ཅིག་མ་དང་པོ་ནས།",
    "ཁོ་རང་རྩོམ་བྱེད་ཀྱི་རྡུལ་ཕྲ་རབ་རྣམས་བསགས་པ་ལས་བྱུང་བ་ཡིན་ཡང་།",
    "དེར་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་མེ་ཏོག་གཅལ་དུ་བཀྲམ་པར་འདུག་ལ་རྡོ་རྗེ་དང་དྲིལ་བུ་བཟུང་སྟེ་འདྲི་བར་འགྱུར་བའི་དཀྱིལ་འཁོར་གྱི་རྣལ་འབྱོར་དང་ལྡན་པས།",
    "འདུག་ནས་ཀྱང་རྐང་པའི་མཐིལ་གཉིས་ལ་སྦྱོར་བ་ནི་ཁ་སྦྱོར་གྱི་རྐང་སྟབས་སོ།",
    "རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་རྩར་གན་རྐྱལ་དུ་བཞག་པ་ནི་དཔའ་བོའི་འདུག་སྟངས་སོ་ཞེས་ཁ་ཅིག་གོ།",
    "སྟན་མཐོན་པོ་ལ་གནས་ཏེ་རྐང་པ་གཉིས་དྲང་པོར་བཟུང་བ་ནི་བཟང་པོའི་འདུག་སྟངས་སོ།",
    "རྐང་པ་གཡས་པ་སེམས་དཔའི་སྐྱིལ་ཀྲུང་བཅས་ལ་འགྱིང་བ་དང་བཅས་པས་གཡོན་པ་བརྐྱང་བ་ནི་རོལ་པའི་འདུག་སྟངས་སོ།",
    "རྐང་པ་གཉིས་ཁ་སྦྱར་ལ་འདུག་པ་ནི་བཀྲ་ཤིས་ཅན་ནོ།",
    "དེའི་རྗེས་ལ་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་འདུག་སྟེ།",
    "ཕྱོགས་གཞན་ལ་ནི་དཀྱིལ་འཁོར་གྱི་ཤར་ནས་ནུབ་ཏུ་ཕྱོགས་པས་འདུག་སྟེ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་ཤར་སྒོར་འདུག་སྟེ་འཆད་པར་འགྱུར་བའི་སྡོམ་པ་གཉིས་སྦྱིན་པ་སྔོན་དུ་འགྲོ་བའི་ལྷག་པར་གནས་པའི་ཆོ་གས་སམ།",
    "རང་རང་བསླབ་པ་ལེགས་པར་ལྡན།",
    "དོན་དམ་པར་ནི་དཀྱིལ་འཁོར་ལ་སོགས་པ་རྣམས་ནི་རིམ་པ་གཉིས་ཀ་ལ་ཡང་རང་བཞིན་མེད་པའི་བདག་ཉིད་ཅན་དེ་བཞིན་ཉིད་དེ་ཁོ་ན་ཉིད་རྣམ་པར་དག་པ་དང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧུཾ་ཧཱུཾ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "བེ་རོ་ཙ་ནའི་སྔགས་གང་ཡིན།",
    "འདུག་སྟངས་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་ཕྱོགས་པས་ཤར་སྒོར་འདུག་སྟེ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྠ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།"
  ]
}