    "ཞིབ་འཇུག་ལས་ཀ་བཅས་ལ་བརྟེན་ནས་བྱ་དངོས་ཡོད་དོ་ཅོག་རང་རང་སོ་སོར་འཚམ་པའི་གནས་ཤིག་ཏུ་བསྒྲིག་རྒྱུ་དེ་ཡིན་ནོ།",
    "གལ་ཏེ་བསྡུ་མི་ཐུབ་ན་ཕྱིའི་ཡི་གེ་ཐད་ཀར་ནང་འདྲེན་བྱས་ན་འགྲིག་ཐད་ཀར་འདྲེན་ནའང་གུག་རྟགས་སོགས་སྤྱད་ནས་བོད་འདིར་རང་ལ་མཚོན་ན་གོང་སྨོས་འདོད་ཚུལ་གསུམ་པ་དང་ཅུང་མཐུན་པར་འདུག་སྟེ།",
    "འགྲོ་འདུག་སྤྱོད་གསུམ་གྱི་འཚོ་བའི་རོལ་སྟངས་ལ་རྒྱ་རིགས་དང་ཕྱིའི་མི་རིགས་ཀྱི་ཤན་ཤུགས་སྣ་ཚོགས་ཐེབས་ཡོད།",
    "དེ་ལ་སྣ་མང་རང་བཞིན་དང་དམིགས་གཏད་ཀྱི་བེད་སྤྱོད་ཁྱབ་ཁོངས་ཤིག་ཡོད་པ་ཡིན་ནོ།",
    "འོན་ཀྱང་རང་ཅག་ལ་དེ་འདྲའི་མིང་མཛོད་འགའ་ཡོད་པ་ནི་དངོས་གནས་རྩོམ་མཁན་རྣམ་པར་རྗེས་སུ་ཡི་རང་བྱ་འོས་པ་དང་ཐུགས་རྗེ་ཆེ་ཞུ་འོས་པ་ཞིག་ཡིན་པ་སྨོས་མ་དགོས་པ་ཡིན།",
    "འོངས་པའི་བོད་པ་ཡིན་ཅེས་བྲམ་ཟེ་ཞིག་ལ་གསུངས་པ་སོགས་འདུག་དེ་རྒྱུའི་ཆབ་འོག་ཏུ་བགྲངས་བ་སོགས་ཀྱིས་ཀྱང་མ་ཡིན་ཏེ།",
    "ཁོ་རང་རྒྱལ་བོ་དང་གཉེན་འབྲེལ་བྱུང་བས་བཀའ་བློན་དུ་བསྐོས་པར་ཡང་བཤད།",
    "ལྷ་ཕྲུག་གཤའ་མར་འདུག་པས་ཤ་ཚངས་བུག་དབྱིངས་སུ་དོད་པས་ན།",
    "སྐད་ནི་བོད་ཡུལ་དབུས་གཙང་རང་སྐད་དེ།",
    "སྦལ་ཏིའི་མི་དམངས་ཀྱི་སྦྲེལ་ཐག་ལྟ་བུར་གྱུར་འདུག།",
    "འགྲོ་བ་དང་ནི་འདུག་པ་ན།",
    "ཅུང་ཟད་གསོན་པོར་འདུག་པ་ན།",
    "དེ་ལྟར་སོ་སོར་གཞན་ལའང་རང་སྡུག་པས།",
    "ཁྱིམ་འདུག་ཉེས་རྩོམ་བྱེད་པ་དག།",
    "འགྲེང་དང་འདུག་དང་དེ་བཞིན་ཉལ་བ་དང་།",
    "གཉེན་འདུན་དབུས་ན་ལམ་མེར་འདུག།",
    "འགའ་ཞིག་རི་བོའི་སྤོ་ལ་འདུག་ནས་སུ།",
    "དག་དང་མ་དག་རང་རང་བྱེད།",
    "ལྡང་བའི་དུས་ཚེ་འདུག་པར་བྱེད་པ་དང་།",
    "རབ་ཏུ་གཡོ་བ་མེད་འདུག་པ།",
    "རྡུལ་དང་དྲི་མས་མ་ཡིན་ཙོག་པུར་འདུག་ལ་འབད་པ་ཡིས།",
    "གང་ཞིག་འདུག་ནས་རྡུལ་བྲལ་བ།",
    "མི་སྒོམ་སྨྲ་བར་མི་བྱེད་པར་། འདུག་ནས་རྡུལ་བྲལ་སེམས་པ་དེ།",
    "འཇིག་རྟེན་ཐམས་ཅད་སྣང་བྱེད་འདུག་འགྱུར་བ།",
    "པེ་སྣར་འདུག།",
    "དེ་གྲོང་དེ་ན་འདུག་པ་ལས་ད་འི་ལག་པ་ཉིད་དུཡིད་བརྟན་ཏེ་ཁྱིམ་མའི་ནང་དུ་རྗོལས་པ་དག་ལ་ཡི་གེ་བསྐུར་རོ།",
    "བྱེད་རིགས་པའང་རང་དང་འབྱེལ་པ་མེད་པ་རྣམ་པར་བཟློག་ཅིང་རྒྱས་པ་སྟེ།",
    "འདི་བྱུང་བའི་གླེང་གཞི་མཉན་དུ་ཡོད་པ་ན་དེའི་ཚེ་དགེ་སློང་རབ་ཏུ་མང་པོ་བསྟེ་གནས་ཀྱི་ཁང་པ་དག་ཏུ་འདུག་སྟེ་འདུག་ཛེེནས་འདི་ཉིད་ཀྱི་ཚུལ་གྱིས་བར་སྐབས་ཀྱི་གཏམ་བརྗོད་པར་གྱུར་ཏེ།",
    "རྣམ་པར་འཐོར་ནས་འདུག་པ་ཡིན་ཞེ་ན།",
    "འཇིགས་པ་མེད་པར་འདུག་པའོ།",
    "གང་ལ་འདི་ལྟ་བུའི་བུ་དང་ནོར་ཡོད་པ་དེ་ནི་འཇིགས་པ་ག་ལ་ཡོད་ཅེས་བག་ཕབ་སྟེ་འདུག་པར་གྱུར་ཏོ།",
    "གང་ཞིག་དུས་འདི་ཇི་སྲིད་དུ་འཚོ་བར་གྱུར་པ་དེ་ཡང་འཆི་བདག་ཉིད་ཀྱིས་ཁྲིད་པ་ཡིན་ཏེ།",
    "རི་གངས་ཅན་གྱི་གནས་ན་དྲང་སྲོང་ལྔ་བརྒྱ་རྒ་བ་དང་འཆི་བ་མེད་པར་བྱ་བའི་ཕྱིར་དཀའ་ཐུབ་སྤྱོད་ཅིང་འདུག་གོ།",
    "འདུག་པ་ན་ཡང་ལུས་ཀྱི་གནས་སྐབས་ཐམས་ཅད་དུ་སྟེ།",
    "ཅུང་ཟད་གསོན་པོར་འདུག་པ་ན།",
    "དེ་ཉིད་ཀྱི་མདུན་དུ་འདུག་ཅིང་གཏམ་རྣམ་པ་སྣ་ཚོགས་པ་བྱས་ནས་སྨྲས་པ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་བསམ་པ་བཟང་བར་བྱས་ཏེ།",
    "དེ་ནས་ལམ་བཟང་པོ་བོར་བ་དེ་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ།",
    "ཡུན་རིང་དུ་འདུག་པ་དང་བག་མེད་པར་གནས་པ་བག་ཡོད་པ་ལ་གཟུད་པའི་ཕྱིར་གསུངས་སོ།",
    "ཉེ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མི་རིང་བ་དང་དྲུང་ན་འདུག་པ་ཡིན་ཏེ་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་ན་གནས་པ་ཡང་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་ཀྱི་ཚུལ་དུ་གནས་པ་ཡིན་ནོ་ཞེས་རིག་པར་བྱ་སྟེ།",
    "དེ་དེ་དག་དུས་བྱས་པ་དང་འབྲས་ཀྱི་ཞིང་ཉམས་པར་གྱུར་པ་ལས་སྨྱོས་ཤིང་གཅེར་བུར་བྱུང་སྟེ།",
    "དེའི་ཆེད་དུ་ལྷའི་ཚོགས་རྣམས་ཀྱང་ཡོངས་སུ་མྱ་ངན་བྱེད་ཅིང་འདུག་པ་ལས་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་ཚིགས་སུ་བཅད་པ་གཉིས་གསུངས་སོ།",
    "སྨད་པར་མི་འགྱུར་ལ་ཞེས་བྱ་བ་ནི་དགའ་ཞིང་རངས་པ་རྒྱ་ཆེ་བ་སྐྱེ་བར་འགྱུར་བ་སྟེ།",
    "འོད་མའི་ཚལ་དེའི་བྲམ་ཟེ་དང་ཁྱིམ་བདག་དད་པ་རྣམས་མ་དད་པར་བྱེད་ཅིང་འདུག་གོ།",
    "འདི་མཉན་པས་དགའ་ཞིང་རངས་པ་སྐྱེ་བར་འགྱུར་བའོ།",
    "བདག་ཉིད་མ་སྦྱངས་པ་དག་དུས་དང་གནས་སྐབས་རྒྱུན་དུ་བསྲུང་བ་མི་བཟོད་པའི་ཕྱིར་རོ།",
    "ཁྱིམ་དུ་ཉེས་པར་འདུག་འདོད་གང་།",
    "འཇུག་པར་བྱེད་པ་ཡིན་པས་འདུག་པ་སྟེ།",
    "ཐམས་ཅད་དང་ལྷན་ཅིག་ཏུ་ཡང་དག་པར་འདུག་པས་ཚུལ་ཉམས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷག་པར་ཞེན་པ་ཡིན་པས་འདུག་པ་སྟེ།",
    "ཡང་ན་སྡུག་བསྔལ་གྱིས་ཁྱིམ་མམ་གནས་གང་དག་ན་འདུག་ཀྱང་དེ་ནི་དེ་ཉིད་དོ།",
    "གཞན་དག་ནི་ཉེ་དགའ་རྒན་པོ་དག་དང་ལྷན་ཅིག་འདུག་ཅིང་ཚུལ་མཉམ་ལ་འཕྱ་བ་བཞིན་དུ་སྟོན་པ་ལས་སོ་ཞེས་ཟེར་རོ།",
    "ཆུ་བོ་ཥྤེ་རཉྫ་ནའི་ངོགས་ན་ཇི་ཙམ་ན་བདག་ཉིད་གཅིག་པུ་འདུག་སྟེ།",
    "བསམ་པ་དང་རང་བཞིན་དེ་རྣམས་སོ་སོར་ཡང་དག་པར་རིག་པའོ།",
    "ལྷ་སྦྱིན་ཡང་དགེ་སློང་ལྔ་བརྒྱ་ཙམ་དང་ལྷན་ཅིག་ཟས་ཀྱི་གྲལ་དང་པོར་ཉེ་བར་འདུག་པར་གྱུར་ཏོ།",
    "དེ་དག་ལ་ཅུང་ཟད་ཀྱང་མ་བྱིན་ནས་དེ་ཐམས་ཅད་དེའི་གནས་སུ་འདུག་པ་ནི་ཉེས་པ་གཅིག་གོ།",
    "ཀྱེ་མའོ་དགེ་སློང་དག་ང་ལ་འཁོར་གྱི་དྲི་བ་དྲིས་ལ་བསྙེན་བཀུར་གྱིས་ཏེ་འདུག་ཤིག་དུདང་ཞེས་པའོ།",
    "འདི་ལྟར་དགེ་སློང་གང་དག་གཞན་གྱི་རྙེད་པ་ལ་ཞེན་པར་གྱུར་པ་དང་རང་རྙེད་པ་མི་ལེན་པ་སྟེ།",
    "བྱེད་ཅིང་འདུག་པའོ།",
    "དེས་ཀྱང་རང་ཉིད་ཀྱིས་ཀྱང་ཅི་ཡང་མི་ཤེས་ན་དེས་ཁྱེད་ཅག་ལ་ཅི་ཞིག་སློབ་པར་འགྱུར་ཞེས་སོ།",
    "དེ་ལྟ་བུའི་གནས་སྐབས་ན་ནི་མི་གཡོ་བར་འདུག་པར་བྱའོ།",
    "གཅིག་པུར་འདུག་ཅིང་གནས་པ་ནི་དམ་པ་རྣམས་ཀྱིས་མཆོག་ཏུ་བསྔགས་པ་ཡིན་ནོ།",
    "འདུག་པ་ནི་ཉེ་བར་འདུག་པ་སྟེ།",
    "དེ་བཞིན་ཉལ་བ་ན་ཞེས་བྱ་བ་ནི་འདུག་པ་ན་ཡང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱུ་དང་འབྲས་བུ་དང་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་ལས་རྗེས་སུ་དྲན་པའོ།",
    "ི་པེ་སྣར་ཏེ། པེ་སྣར་འདུག་མ་པེ་སྣར་དེ།",
    "ལམ་མེར་འདུག་ཅེས་བྱ་བ་ཡིན་ཏེ།",
    "དེ་མྱ་ངན་མི་བྱེད་ཅིང་ཉེ་དུའི་དབུས་ན་ལམ་མེར་འདུག་པ་ཡིན་ཏེ།",
    "ཉལ་བར་འགྱུར་ཞེས་བྱ་བ་ནི་གཉིད་ལོག་པ་ལྟ་བུར་རྨོངས་པས་འདུག་པ་སྟེ།",
    "བསམས་པ་གལ་ཏེ་ཀུན་དགའ་ར་བ་འདིར་བྱོན་ན་ནི་ལན་དུ་མར་ཆུ་འཐུངས་ཏེ་འདི་ཟད་པར་འགྱུར་རོ་སྙམ་ནས་དེས་སྒོ་བཅད་ཅིང་ཟོ་ཆུན་ཡང་སྦས་ཏེ་འདུག་པ་དང་།",
    "དེ་དེར་འདུག་ནས་ཚིགས་བཅད་སྨྲས་པ།",
    "མངོན་སུམ་ཐོས་བཞིན་འདུག་བྱེད་དམ།",
    "རི་བོའི་སྤོ་ཉིད་ལ་འདུག་ན་ནི་ཐག་རིང་པོར་གྱུར་པ་ཡང་ཀུན་དུ་མཐོང་བ་ཡིན་གྱི་གཞན་དུ་ནི་མ་ཡིན་ཏེ།",
    "འགའ་ཞིག་འདུག་ནས་སུ་ཞེས་བྱ་བ་ནི་མིག་དང་ལྡན་པའི་སྐྱེས་བུ་འདུག་ཅིང་གནས་པའོ།",
    "གང་དུ་འདུག་ནས་ངལ་བ་ཞི་བར་བྱེད་པ་ནི་མལ་སྟན་ནོ།",
    "ཞེས་བྱ་བ་ནི་གང་ལ་ལ་ཞིག་དུས་ཚིགས་བརྒྱར་རིས་མཐུན་པར་ཛེེའཛིན་པར་བྱེད་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཕ་དང་མ་ལ་སོགས་པའི་གཉེན་དང་རང་ཅི་དགའ་བ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཁུམས་ཏེ་ཕྱི་རོལ་པའི་དྲང་སྲོང་དག་ནམ་མཁའ་ལས་འོང་བ་དང་འགྲོ་བར་བགྱིད་པ་གདའ་བས་བདག་དགའ་བ་སྐྱེས་ཏེ།",
    "ལུས་ཞིག་ནས་ལྷ་རྣམས་ཀྱི་ནང་དུ་སྐྱེ་བ་གདའོ་ཞེས་གསོལ་པ་དང་།",
    "རང་རང་བྱེད་ཅེས་བྱ་བ་ནི་བདག་ཉིད་དང་འབྱེལ་པ་དང་།",
    "སྡུག་བསྔལ་དེས་འདུག་པའོ་ཞེས་བྱས་ནས་ཏེ།",
    "དབེེན་པར་བྱས་ཀྱང་ཞེས་བྱ་བ་ནི་སྐྱེ་བོ་དང་ལྷན་ཅིག་འདུག་པའི་ཕྱོགས་དང་བྲལ་བ་ནི་དབེན་པ་སྟེ།",
    "ལྷན་ཅིག་སྟིའདུག་ཀྱང་དུས་ཅུང་ཟད་ཀྱང་རྟོགས་པ་དང་ཡིད་ཆེས་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཚིག་ཅུང་ཟད་ཀྱང་མ་སྨྲས་ཤིང་མི་བརྗོད་ན་ནི་འདི་ནི་རྟག་ཏུ་ལྐུགས་པ་བཞིན་དུ་འདུག་གོ་ཞེས་སྨོད་པར་བྱེད་དོ།",
    "སྔོན་ཞེས་བྱ་བ་ནི་སྔོན་དུ་འདུག་པ་སྟེ།",
    "བདེ་བར་འདུག་ཅེས་བྱ་བ་ནི་འཚེ་བ་མེད་པར་གཉིད་ལོག་པའམ་འདུག་པའོ།",
    "དེ་ཉིད་ནི་བདེ་བར་འདུག་སྟེ།",
    "འདུག་པར་བྱེད་པ་དང་ཞེས་བྱ་བ་ནི་ཉེ་བར་མི་སྦྱོར་བ་སྟེ།",
    "ཁྱིམ་འདུག་ཅེས་བྱ་བ་ཁྱིམ་དང་ཉེ་བ་ན་འདུག་པ་སྟེ།",
    "འདུག་པ་ཞེས་བྱ་བ་ཡིན་ཏེ་རྣམ་པར་གཡེངས་པ་མེད་པས་སོ།",
    "དགེ་སློང་ནི་སློང་བའི་ཕྱིར་སྒོ་ན་འདུག་གོ་ཞེས་འཇིག་རྟེན་ན་ཐ་སྙད་དུ་འདོགས་པ་དེ་ཇི་དགེ་སློང་ཞེས་བྱ་བ་ཡིན་ནམ་ཞེ་ན།",
    "ཐོ་རངས་ཁྲིའི་སྟེང་དུ་འདུག་པ་ལས་ཚིགས་སུ་བཅད་པ་འདི་གསུངས་སོ།",
    "དེ་ཡང་ཇི་སྲིད་དུ་གཞན་གྱི་དོན་དུ་འདུག་པ་དེ་སྲིད་དུ་ནི་སྐྱོབ་པ་སྟེ།",
    "ཙོག་པུར་འདུག་ལ་འབད་པ་ཡིས།",
    "ཞེས་བྱ་བ་ནི་ཙོག་ཙོག་པོར་འདུག་པ་གང་ཡིན་པ་དེ་ནི་ཙོག་པུར་འདུག་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཐད་དུ་རལ་པ་ཅན་ཞིག་ཆུ་བོ་ཛ་ཡ་རྒལ་ཏེ་འོངས་ནས་མདུན་དུ་འདུག་སྟེ།",
    "གང་ཞིག་འདུག་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཚེ་དང་ལྡན་པ་ནམ་གྲུས་མཚན་མ་མེད་པའི་ཏིང་ངེ་འཛིན་མངོན་དུ་བྱས་ནས་གནས་སོ།",
    "འདུག་ནས་ཞེས་བྱ་བ་ནི་དབེེན་པའི་གནས་སུ་འདུག་པས་སོ།",
    "འདུག་ནས་སྨོས་ཏེ་ཤིང་དྲུང་ལ་སོགས་པ་དབེེན་པར་འདུག་པའོ།",
    "ཉི་པེ་སྣར་འདུག་ེ་པེ་སྐྱེ།",
    "དེ་ལྟ་བུའི་ལམ་སྟོན་ཅིང་རང་ཉིད་ཀྱིས་རྟོགས་པ་སྟེ།",
    "གཞན་དག་ནི་ཞིག་ནས་འདུག།",
    "གཞན་དག་ནི་ཆགས་ནས་འདུག་གོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ཆགས་ནས་འདུག་པའོ།",
    "འདུག་གམ་གཉིད་ལོག་གམ།",
    "གཞན་ལ་རག་མ་ལས་པ་ནི་ལམ་བསྒོམས་པ་ལ་གཞན་གྱི་ལུང་མེད་ཀྱང་རང་མཁས་པའི་ཕྱིར་རོ།",
    "འདུག་པ་འམ་ནི་ལྡང་བའང་རུང་།",
