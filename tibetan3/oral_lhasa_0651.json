    "འཕེན་བྱེད་ཀྱི་ལས་དང་འགྲུབ་བྱེད་ཀྱི་ལས་དེ་གཉིས་ཀྱིས་འཕངས་ཤིང་གྲུབ་པར་བྱས་པའི་རྣམ་སྨིན་གྱི་འབྲས་བུ་དེའི་བདེ་སྡུག་རྫོགས་པར་བྱེད་པའི་རྫོགས་བྱེད་ཀྱི་ལས་དང་གསུམ་ཡོད།",
    "སྲོག་གཅོད་འདོད་ཡིད་ལ་འཁོར་ནས་གསོད་འདོད་ཀྱི་འདུན་པ་ལོག་པའི་ལས་ལྟ་བུ་བྱས་བསགས་གཉིས་ཀ་མ་ཚང་བའི་ལས་དང་བཞི་ཡོད་ཅིང་།",
    "འདི་དག་རྒྱས་པར་ཤེས་འདོད་ན་རྟེན་ལ་ཡན་ལག་བཅུ་གཉིས་ཀྱི་སྐོར་གཞུང་རྒྱས་པ་ཁག་དང་།",
    "རྐྱེན་བཞིའི་སྒོ་ནས་གསུངས་ཡོད།",
    "ཞིང་ལ་ས་བོན་བཏབ་སྟེ་ཆུ་དང་ལུད་སོགས་ཀྱིས་སྐྱོང་ལུགས་ཇི་ལྟར་བྱས་པ་ལྟར་སྟོན་འབྲས་ཀྱང་དེ་ལྟར་སྨིན་པ་མངོན་སུམ་གྱིས་གྲུབ་པ་ལྟར།",
    "སྡུག་བསྔལ་བ་ལ་སྡུག་བསྔལ་བ་ཡིན་པར་ཤེས་ནས་དེ་སྤོང་འདོད་པ་དང་དེ་ལ་མི་འདོད་པའི་བློ་སྐྱེ་བ་ན་དེའི་རྒྱུ་གང་ཡིན་རྩད་གཅོད་པ་རང་ཤུགས་ཀྱིས་ཡོང་བ་ཡིན།",
    "དེ་ཡང་སྡུག་བསྔལ་མི་འདོད་ན་དེའི་རྒྱུ་ཀུན་འབྱུང་རྩད་ཆོད་པར་བྱས་ཏེ་རྒྱུ་ཀུན་འབྱུང་དེ་ནུས་པ་ཇེ་ཆུང་ནས་ཇེ་ཆུང་དུ་བཏང་སྟེ་མཐར་འགགས་ནས་བྲལ་བའི་ཚེ་འབྲས་བུ་སྡུག་བསྔལ་ཡང་གཏན་ནས་ཡོང་ཐབས་མེད་པས་དེ་ལྟར་སྡུག་བསྔལ་རྒྱུ་དང་བཅས་པ་ཉེ་བར་ཞི་བའི་གནས་སྐབས་ཤིག་ཡོང་རྒྱུ་ཡོད་པར་གྲུབ།",
    "གསར་དུ་མི་བསོག་ཅིང་འབྲས་བུ་སྐྱེད་པའི་བྱ་བ་ཆད་པ་ཙམ་ལ་འཇོག་པ་ལྟ་བུ་ཐོར་པ་ཞེས་པ་ཟག་བཅས་ཀྱི་ཁྱད་པར་ཙམ་ཞིག་ལ་འདོད་པའི་ལོག་རྟོག་འགོག་པའི་ཆེད་དུ།",
    "དེ་ངེས་པ་ན་འགོག་བདེན་ཐོབ་རྒྱུ་ཡོད་པ་དེ་ཤེས་པར་འགྱུར་བས་འགོག་བདེན་དུས་གསུམ་པར་གསུངས་པ་ཡིན།",
    "མངོན་སུམ་དུ་མཐོང་ཟིན་པ་དེ་ཉིད་ཡང་ཡང་གོམས་པར་བྱེད་པའི་སྐབས་ཀྱི་སྒོམ་ལམ་དང་།",
    "ངེས་འབྱིན་བཞིའི་སྒོ་ནས་གསུངས་ཡོད།",
    "དེ་ཐོབ་བྱེད་ཀྱི་རྒྱུ་བསམ་གཏན་གྱི་ཁྱད་པར་འདུ་ཤེས་མེད་པའི་སྙོམས་འཇུག་ལྟ་བུ་ཐར་ལམ་ཡིན་ནོ་སྙམ་པའི་ལོག་རྟོག་ལྡོག་པའི་ཆེད་དུ།",
    "སེམས་ཀྱི་རང་བཞིན་མཐར་ཐུག་གམ་གནས་ལུགས་མཐར་ཐུག་མངོན་སུམ་དུ་མཐོང་བབའི་བདག་མེད་གཉིས་རྟོགས་པའི་བློ་དེས་སེམས་ཀྱི་དོན་དམ་པའི་གནས་ལུགས་ཕྱིན་ཅི་མ་ལོག་པར་སྒྲུབ་པས་སྒྲུབ་པ་ཞེས་བྱ་ལ།",
    "ཞེས་སོགས་གསུངས།",
    "ཡན་ལག་བརྒྱུད་པར་བསྟན་པའི་དོན་དུ་འགྲེལ་ཚུལ་དང་།",
    "ཚེ་བརྒྱུད་པར་བསྟན་པའི་དོན་དུ་འགྲེལ་ཚུལ་དང་།",
    "འདི་ཡོད་པས་འདི་འབྱུང་ཞེས་པས་འདུས་བྱས་རྣམས་གཡོ་བ་མེད་པའི་རྐྱེན་ལས་བྱུང་བར་བསྟན།",
    "འདི་སྐྱེས་པའི་ཕྱིར་འདི་སྐྱེ་ཞེས་པས་འདུས་བྱས་རྣམས་མི་རྟག་པའི་རྐྱེན་ལས་བྱུང་བར་བསྟན།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་ཏེ།",
    "དོན་གྱི་ཁྱད་པར་ཞལ་གྱིས་བཞེས་པ་ལ་ཡང་ཡོད་པ་ཡིན་ཏེ།",
    "ཞེས་བརྟེན་པ་དང་ཕྲད་པ་དང་ལྟོས་པ་གསུམ་གྱི་ཐོག་ནས་དུས་གོ་བ་ལེན་ལུགས་ཤིག་གསུངས་ཤིང་།",
    "དེ་གསུམ་རྣམ་གྲངས་པར་གར་གསུངས་ཀྱང་དོན་གཅིག་ཡིན་མི་དགོས།",
    "ཐ་སྙད་དུ་གང་ཟག་བློ་ངོར་འཆར་རྒྱུ་དང་ཕན་གནོད་ཀྱི་བྱ་བ་བྱེད་མཁན་ཞིག་ཡོད་པར་གསུངས་ཡོད།",
    "དུས་ཀྱི་ཀུན་སློང་ལ་ལས་འབྲས་ལ་རྨོངས་པའི་མ་རིག་པ་ཞེས་ཀུན་བཏུས་ལས་གསུངས།",
    "ཚེ་ཕྱི་མ་རྣམ་སྨིན་ཡིད་དུ་འོང་མི་འོང་ཅི་རིགས་པ་འགྲུབ་རུང་དུ་བྱས་པའམ་འདུ་བྱེད་པའི་གཟུགས་དང་ཤེས་པ་གང་རུང་ཞིག་ལ་ཟེར།",
    "ལས་དང་པོ་གཉིས་ཀྱིས་འཕངས་ཤིང་འགྲུབ་པར་བྱས་པའི་རྟེན་གྱི་གང་ཟག་རང་ཉིད་ཚེ་ཇི་སྲིད་འཚོ་བའི་བར་དུ་བདེ་སྡུག་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་ཚེ་རྫོགས་པར་བྱེད་པའི་ལས་ལ་ཟེར།",
    "ཕུང་པོ་ལྔ་ལ་བརྟེན་ནས་བཏགས་པའི་ང་ཙམ་དང་གང་ཟག་ཉིད་ལ་འཇོག་པར་མཛད་དོ།",
    "ལུས་རྫོགས་པར་གྲུབ་པའི་སྐབས་ལ་འཇོག་པར་ཡང་གསུངས་སོ།",
    "འདི་ནི་འདོད་ཆགས་ཁྱད་པར་ཅན་ཚེ་འདིའི་ཚོར་བ་བདེ་སྡུག་བཏང་སྙོམས་གསུམ་ཅི་རིགས་ལ་དམིགས་ནས།",
    "འདིའི་དམིགས་པ་ལ་ཚོར་བ་གསུམ་པོ་གང་རུང་དགོས་པར་ལྟ་བུར་གསུངས།",
    "འདིའི་དམིགས་པ་ནི་ཚོར་བ་གསུམ་དང་ལྟ་བ་དང་ཚེ་སྔ་ཕྱིའི་ཕུང་པོ་སོགས་ཀྱང་ཡོད་པར་གསུངས།",
    "འདིས་ཡང་སྲིད་ཕྱི་མ་སྐྱེ་སྲིད་གཞན་གྱིས་བར་མ་ཆོད་པར་འགྲུབ་པར་བྱེད་པས་འགྲུབ་བྱེད་ཀྱི་ལས་ཞེས་དང་།",
    "ཡང་སྲིད་ཕྱི་མ་ངེས་པར་འགྲུབ་པར་བྱེད་པས་སྲིད་པ་ཞེས་འབྲས་བུ་སྲིད་པའི་མིང་རྒྱུ་ལས་ལ་བཏགས་པ་ཡིན།",
    "འཇིག་རྟེན་ན་རྒ་བ་ཞེས་པ་སྐྱ་དཀར་བ་དང་གདོང་ལ་གཉེར་མ་མང་བ་སོགས་ལ་བརྩིས་ཀྱང་བསྟན་བཅོས་ལས་ནི་སྐྱེ་བའི་སྐད་ཅིག་གཉིས་པ་ནས་སྐྱེས་པའི་ཕུང་པོ་དེ་ཉིད་ཇེ་རྙིང་དང་ཚེ་ཇེ་ཐུང་དུ་འགྲོ་བཞིན་པ་ཡིན་པས་གོ་བ་ལ་འ་པར་གསུངས།",
    "ལྷག་པར་ཡིད་དུ་འོང་བའི་ཟག་བཅས་ཀྱི་ཅ་དངོས་གོས་རྒྱན་དང་།",
