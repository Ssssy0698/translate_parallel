    "དྲི་ཆེན་གྱིས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་ཐོབ།",
    "ཞེས་གུར་ལས་གསུངས་སོ།",
    "དེ་ལྟར་མ་བྱས་པར་གཟུང་འཛིན་དུ་བཟུང་ན།",
    "དེར་བདེན་འཛིན་བྱས་ན་སྒོམ་བྱའི་སྐབས་དོན་ཡང་ཧར་པོར་འགྲོ་བས་ན།",
    "གཏད་མེད་སྒྱུ་མ་ལྟ་བུའི་ངང་ལ་མཉམ་ཉིད་དུ་ལམ་དུ་འཁྱེར་གསུངས།",
    "སྣང་བ་མ་འགགས་པར་སྣ་ཚོགས་སུ་འཆར་བ་ཙམ་མ་གཏོགས་པ་བདེན་པའི་དངོས་པོ་ནི་གང་ཡང་མེེེད་པས་ན།",
    "སྐྱོན་མ་ཤོང་པ་ཡིན་པས་རང་ལ་སྐྱོན་ཡོན་ཅི་བྱུང་ཡང་བློར་ཤོང་པར་བྱས་ནས།",
    "ཉམ་ང་དང་བག་ཚ་དང་ང་རྒྱལ་ལ་སོགས་པ་མེད་པར་སྙམས་སྙོམས་མེད་དགག་བསྒྲུབ་མེད།",
    "ཆགས་སྡང་མེད་པར་ཁོང་ཡངས་བསྐྱེད་པའོ།",
    "ཡོན་ཏན་ཡང་ངང་ངམ་ཤུགས་ཀྱི་རྡོལ་ནས་འོང་ངོ་གསུངས་སོ།",
    "ཁམས་ཆ་མཉམ་དགོས་པས་རིམ་གྱིས་ཚོད་འཛིན་གྱིན་བསྒོམ་གསུངས་སོ།",
    "འགྱུར་ནས་ལུས་བདེ་བ་འབའ་ཞིག་ཏུ་འོང་གསུངས་སོ།",
    "ལུས་སེམས་ཀྱི་ཁོངས་སུ་མི་འཕྲོད་པའི་རྐྱེན་ཅི་བྱུང་ཡང་ཤེས་པ་དཔའ་མ་ཤོར་བར་བྱས་ནས།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་གསལ་འདེབས་ཡིན་པས་ལམ་དུ་ཁྱེར་ནས་གང་ལ་ཡང་དུ་ཁ་མི་བྱེད་པའོ་གསུངས།",
    "ཁྱད་པར་གཞན་གྱིས་ཀྱང་དགའ་ཡལ་གྱིས་བགྱིས་ཤིག།",
    "དུ་ཁ་བྱས་པས་ཕན་རྒྱུ་ཡང་མེད་དེ།",
    "རོ་གཅིག་ཡན་ཆད་དུ་སྟོང་པར་བཞག་མི་དགོས།",
    "འདིར་སེམས་ཀྱི་ངོ་བོ་ལེགས་པར་མཐོང་སྟེ་སྤྲོས་བྲལ་གྱིས་རྟོགས་པ་རྒྱུད་ལ་སྐྱེས་པས་བློ་ཐག་ཆོད་ཡིད་ཆེས་པ་ཡིན་ཡང་ནི་སྟོང་པར་བཞག་སྟེ།",
    "དེའི་རྩར་རྫོགས་པར་བྱེད་པ་ལ་མ་ཡེངས་ཙམ་དུ་བསྒོམ་དགོས་པས།",
    "ཐ་མལ་པ་གྲུབ་མཐས་བློ་མ་བསྒྱུར་བའི་མི་མ་སྨྱོ་བ་ཀུན་གྱིས་སྨྱོན་པ་ལ་བལྟས་པས་འཁྲུལ་པར་མཐོང་ལ།",
    "འཁྲུལ་པར་མཐོང་།",
    "དེ་བཞིན་དུ་རྟོགས་ལྡན་གྱིས་བལྟས་ན་དངོས་འཛིན་གྱིས་དགེ་སྦྱོར་བྱེད་ལོ་བ་ཡང་འཁྲུལ་པར་མཐོང་།",
    "གཞན་དག་དབུགས་འབྱིན་པ་ལ་སོགས་པའི་ཡོན་ཏན་ཡོད་དོ་གསུངས།",
    "བསྐུར་ཡང་མ་བསྐུར་ཐོབ་ཀྱང་མ་ཐོབ་པ་བཞི་ལས་རང་ཅག་དང་པོ་ལྟར་བྱའོ་གསུངས།",
    "རྗེ་གྲུབ་ཐོབ་ཆེན་པོ་ནས་བརྒྱུད་པ་ཡིན་གསུངས།",
    "རྗེ་ཡི་བུ་བཞིན་དགོངས་ནས་གནང་བའོ།",
    "དྲན་ཉམས་བཟློག་ཕྱིར་བྲིས་པ་བཟོད་པར་གསོལ་།",
    "འདུས་བྱས་ཐམས་ཅད་མི་རྟག་པ།",
    "མཉམ་མེད་ཟས་གཙང་སྲས་པོས་རྟག་སྐྱོངས་ཤིག།",
    "འཕྲལ་ཕུགས་ཀུན་ཏུ་བསམ་གཞིག་བྱས་ཏེ་བྲིས།",
    "སྤྱི་ལོ་༢༡༣ ནས་ཡར་བརྩིས་པའི་ལོ་༢༦༣༨སྤྱི་ལོའི་སྔོན་གྱི་ལོ་༦༢༥ལོར་སྟོན་པ་མཉམ་མེད་ཤཱཀྱ་སེང་གེ་རྒྱ་གར་འཕགས་པའི་ཡུལ་དུ་ཡབ་རྒྱལ་པོ་ཟས་གཙང་དང་།",
    "གྲགས་འཛིན་མ་ཁབ་ཏུ་བཞེས་ནས་ཁྱིམ་གྱི་བྱ་བ་མཛད་ཅིང་སྲས་སྒྲ་གཅན་འཛིན་འཁྲུངས།",
    "དགུང་ལོ་༢༩བར་ཁྱིམ་དུ་བཞུགས།",
    "ལྟ་བའི་ཆ་རྒྱས་པར་གསུངས་པ་འཁོར་ལོ་བར་པ་དང་།",
    "སྤྱོད་པའི་ཆ་རྒྱས་པར་གསུངས་པ་འཁོར་ལོ་ཐ་མ་གསུངས་ཏེ།",
    "ལྷག་པར་གཞི་དངོས་པོའི་གནས་ལུགས་ལྟ་བུར་བསམ་གཞིག་བྱས་ན།",
    "འདི་དག་ལག་བྲིས་ཀྱིས་བཞེངས་པར་གྲགས།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་གསུངས།",
    "འདི་ལ་ལམ་རིམ་དང་ལམ་ཁྲིད་ཁག་ཏུ་གསུངས་པ་ལྟར་བཤེས་གཉེན་བསྟེན་ཚུལ་འདི་ནི་གལ་ཆེ་སྟེ།",
    "གདམས་ངག་གནང་རོགས་ཞུ་ཞེས་སྐད་ཆེན་པོས་ཞུས་པ་ལ།",
    "ཧེ་ཧེ་ཁོ་བོ་ལ་རྣ་བ་ཏ་བཟང་པོ་བཟང་པོ་བདོག་སྟེ་མན་ངག་བྱ་བ་དད་པ་ཡིན་དད་པ་དད་པ་ཞེས་གསུངས་པ་དང་།",
    "དེའི་འོག་ཏུ་བསྟེན་ཚུལ་གསུངས་པའི་སྐབས་སུ་ཁྱད་པར་དུ་རྩྭ་བར་དད་པ་སྦྱང་བ་ཞེས་ས་བཅད་ཟུར་དུ་མཛད་དེ་དད་པ་འདི་གལ་ཆེན་དུ་མཛད།",
    "དེ་ལྟར་གསུངས་པ་དྲང་དོན་ཡིན།",
    "ནང་བསྟན་རྩ་བ་ནས་སུན་འབྱིན་པར་བྱེད་པའི་ཕུང་དཀྲུག་མཁན་ཡིན་པར་ཚང་མས་ཤེས་དགོས།",
    "རྒྱལ་ཚབ་ཐམས་ཅད་མཁྱེན་པས།",
    "དེ་མ་བྱས་ན་རབ་ཏུ་བྱུང་བའི་གྲལ་ལ་མི་ཚུད།",
    "ཁུར་འཁུར་བ་ན་ཇི་བྱ་བའི་སེམས་བཞིས་བསྟེན་པར་གསུངས་སོ།",
    "འདི་ནི་དེང་སྐབས་ཀྱི་སྐད་ཆ་བྱས་ན།",
    "དོན་ངོ་ཐོག་བྱས་ན་ཤེས་པ་ཞིག་གཏན་ནས་མེད་པ་ལྟ་བུའི་རིགས་ཤིན་ཏུ་མང་།",
    "སྒྲུབ་པའི་སྒོ་ནས་བཤེས་གཉེན་བསྟེན་པར་བྱ།",
    "དུས་རྒྱུན་ལྡན་དུ་དཔེ་དེབ་འདྲ་མིན་ཀློག་རྒྱུ་ལ་གོམས་པར་བྱེད་པ་མ་གཏོགས།",
    "ཀུན་སྤྱོད་གཙང་བས་གཞན་གྱི་ཡིད་དུ་འཐད།",
    "སྒོ་གསུམ་བག་དང་ལྡན་པར་གྱིས་ཤིག་ཨང་།",
    "དང་པོར་སྐྱབས་ཞུ་སའི་དཔོན་པོ་དེ་ངོ་ཤེས་པར་བྱས་ནས་དེས་སྐྱོབ་ཐུབ་དང་མི་ཐུབ།",
    "དེ་ལྟར་མ་ཡིན་ན་སྔར་ཕན་བཏགས་མ་བཏགས་ལ་བལྟས་པས་སྐྱབས་སུ་འགྲོ་མཁན་ཡོངས་ཀྱི་དོན་མི་བྱེད་པར་ཕྱོགས་རིས་ཅན་འཇིག་རྟེན་ཁྱིམ་པའི་རྒྱལ་བློན་རུལ་སུངས་ཅན་ལྟ་བུར་གྱུར་ནས་གཏན་གྱི་སྐྱབས་སུ་འགྲོ་བའི་ཡུལ་མིན་པས་སོ།",
