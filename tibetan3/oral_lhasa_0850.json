    "གཞི་མཐུན་པར་ཞེས་བྱ་བ་ནི་སྒྲ་མི་རྟག་པའོ་ཞེས་སོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་གཞི་ཐ་དད་པར་ཏེ་སྒྲའི་མི་རྟག་པའོ་ཞེས་བྱ་བར་རོ།",
    "ཐ་སྙད་མ་གྲུབ་ན་ནི་ཞེས་བྱ་བ་ནི་ཕྱེད་ཕྱི་མ་རྣམ་པར་འགྲེལ་པའོ།",
    "ཐ་སྙད་ཡུལ་གྱི་དངོས་པོ་ཉིད་དུ་དྲན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "གལ་ཏེ་མཐོང་བའི་དངོས་པོ་ལ་དེའི་རྣམ་པར་རྟོག་པ་ཐ་སྙད་སྒྲུབ་པ་ཡིན་ཏེ།",
    "འབྲས་བུའི་རྗེས་སུ་དཔག་པ་ལ་ནི་དངོས་པོ་མ་མཐོང་བ་ཉིད་ཀྱིས་ཐ་སྙད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "༣༦༣པར་བྱེད་པ་ཡིན་ནོ།",
    "འོན་ཏེ་དེ་ལྟ་ཡང་དངོས་པོ་འཛིན་པར་འདོད་ན་དེའི་ཚེ།",
    "མི་ངེས་ན་དེ་དང་ཐ་མི་དད་པའི་ཁྱད་པར་མི་འཛིན་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་ཉིད་ཀྱི་ཚེ་ཞེས་བྱ་བའོ་། གཟུགས་པར་རྟོགས་པ་མི་འཐད་པ་ཉིད་བརྗོད་ནས།",
    "མེའི་ཁྱད་པར་ལས་མ་རྟོགས་པ་དེ་ཉིད་ནི་ཡོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ནི་ཐ་སྙད་སྒྲུབ་པར་བྱེད་པ་ཉིད་དོ་ཞེས་དགོངས་པའོ།",
    "༢༣་རྩ་༣༦༤ལས་བྱུང་བ་ལ་སོགས་པ་ཁྱད་པར་རབ་ཏུ་འགྲུབ་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་འགྲུབ་པར་མི་འགྱུར་ཞེ་ན།",
    "སྤྱི་ལ་ཞེས་གསུངས་ཏེ།",
    "དེའི་ཚེ་ཇི་ལྟར་ཁྱད་པར་འཛིན་པ་ཡིན་ཏེ་མ་ཡིན་པ་ཉིད་དོ།",
    "མངོན་སུམ་དུ་ཞེས་གསུངས་སོ།",
    "ཐོབ་པ་གཞན་དུ་མི་འཐད་པས་ཐེ་ཚོམ་མི་སྲིད་པར་དོགས་པ་ནི་ཐེ་ཚོམ་ཟ་ན་ཞེས་བྱ་བའོ།",
    "ཀུན་ཚེ་ཡོད་པ་ལས་ཞེས་བྱ་བ་རྣམ་པར་འགྲེལ་པ་ནི་གང་དུ་ཞེས་བྱ་བའོ།",
    "སྤྱིའི་ཡུལ་ཅན་ཉིད་ཀྱིས་དངོས་པོ་འཛིན་པར་དོགས་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་ན་འོ་ན་མ་རྟོགས་པའི་ཁྱད་པར་ཇི་ལྟར་འཐོབ་ཅེས་བརྗོད་པ་ནི་སྤྱི་རྟོགས་པ་ན་ཞེས་བྱ་བའོ།",
    "དེས་ན་བརྒལ་ཞིང་བརྟག་པ་ིམཚུངས་ཀྱང་གཅིག་ལ་ནི་བརྒལ་ཞིང་བརྟག་པར་བྱ་བ་ཡིན་ལ།",
    "དེ་ལྟ་ཡིན་ན་ཅི་ཡོད་སྙམ་ན། དེ་ལྟ་ཡིན་ན་ཞེས་གསུངས་ཏེ་དོན་བཟུང་བ་ཡིན་ནའོ།",
    "ཁྱད་པར་གྱི་རང་བཞིན་ལས་ཞེས་བྱ་བ་ནི་ལན་ནོ།",
    "ཁྱད་པར་གྱི་རང་བཞིན་ནོ།",
    "ཐེ་ཚོམ་ནི་ཞེས་གསུངས་སོ།",
    "དེས་ན་དངོས་པོའི་གནས་ལུགས་ཀྱི་ཁྱད་པར་མ་རྟོགས་པས་ན་དེ་ལ་ཞེན་པའི་ཐེ་ཚོམ་དུ་མི་འགྱུར་རོ།",
    "༣༦༧པར་ལ་ཡང་འཇུག་པ་ཡིན་གྱི་ཐེ་ཚོམ་ལས་ནི་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "མ་རྟོགས་པ་ནི་ཁྱད་པར་རོ།",
    "ཇི་ལྟར་དེ་གཉིས་གཅིག་མ་ཡིན་པར་བརྗོད་སྙམ་ན།",
    "རྗེས་སུ་དཔག་པའི་དུས་ན་ནི་ཁྱད་པར་རྟོགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "འོན་༤ཏེ་ཞེས་བྱ་བ་ལ་སྤྱི་རྟོགས་པས་གཞན་པའི་དུས་ནི་དུས་གཞན་ནི་དེར་མངོན་སུམ་གྱིས་རྟོགས་པའི་ཁྱད་པར་སྔར་རྟོགས་པའི་སྤྱི་དང་གཅིག་ཏུ་རྟོགས་པའི་སྐྱེས་བུའོ།",
    "ངེས་པ་མེད་ཀྱང་དེའི་ངོ་བོར་མི་འགལ་ལོ་ཞེས་ལན་གསུངས་པ་ནི་འདི་ནི་ཞེས་བྱ་བའོ།",
    "རིགས་མི་མཐུན་པར་སྐྱེ་བ་མེད་པའི་ཕྱིར་རོ།",
    "རྩོད་པ་པོ་ཉིད་ཀྱིས་གལ་ཏེ་སྒྲིབ་པར་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྐལ་པར་དོགས་པ་བསུ་ནས།",
    "ཇི་ལྟར་གཉི་ག་བསྒྲིབས་པར་འགྱུར་ཞེ་ན།",
    "གལ་ཏེ་ཐ་དད་པར་བཟུང་ནས་བསྒྲིབས་པའི་དོན་ཅི་ཡིན།",
    "དེ་འཛིན་པ་མེད་ན་ཡང་ཐ་དད་པར་མཐོང་བ་མ་འཁྲུལ་བར་གནས་པ་ཉིད་དོ་ཞེས་བྱ་བའོ།",
    "སྔོན་གྱི་རིག་པ་དང་དེའི་ཡུལ་མེད་པའི་ཕྱིར་དེས་ནི་རྣམ་པར་རྟོག་པ་མ་ཡིན་གྱི་འོན་ཀྱང་རྗེས་སུ་མཐུན་པའི་ཐ་སྙད་ཀྱི་གེགས་བྱེད་པའི་ཕྱིར་ན།",
    "དེ་ནི་རྣམ་པར་རྟོག་པས་བསྒྲིབས་པར་འགྱུར་རོ་ཞེས་ལན་བརྗོད་པ་ནི།",
    "གལ་ཏེ་མཐོང་བ་བཞིན་དུ་རྣམ་པར་རྟོག་པ་ཡང་ཇི་ལྟར་ཐ་སྙད་བྱེད་པ་ཡིན་ཞེ་ན།",
    "ཕྱིན་ཅི་ལོག་ཏུ་གསུངས་སོ།",
    "གལ་ཏེ་དེ་དེ་ལྟ་ན་ཡང་དེ་༤མཐོང་བ་ཇི་ལྟར་བསྒྲིབས་ཏེ་ཅི་ཡང་མ་བྱས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཇི་ལྟར་ཐ་སྙད་མེད་པ་ཡིན་ཞེ་ན་གཞན་ཞེས་གསུངས་ཏེ།",
    "སྐད་ཅིག་ཕྱི་མ་སྐད་ཅིག་སྔ་མ་ལས་ཐ་དད་པར་ཉེ་བར་མ་མཚོན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མཁས་པས་སྒོང་ལ་སོགས་པ་ཐ་དད་པར་རྟོགས་པ་ཉིད་མ་ཡིན་ནམ་རིགས་མཐུན་པའི་སྐད་ཅིག་མ་སྐྱེས་པར་ནི་དོན་གྱི་རྒྱུ་འགལ་ཡང་ནི་ཐ་དད་པར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "འཇིག་པ་དང་དེའི་གནས་སྐབས་མ་ཡིན་པ་དག་ནི་དོན་གཞན་མ་ཡིན་པའི་ཕྱིར་དེས་ན་སྒྱུ་མའི་སྒོང་བཞིན་དུ་འདིར་ཡང་ཐ་དད་པར་དམིགས་པ་ཡོད་པ་ཉིད་དོ།",
    "ལ་ལར་དེའི་ས་མི་ཤེས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཁྱད་པར་བརྗོད་པ་ཉིད་ཀྱིས་དོན་གོ་བ་ཡིན།",
    "དུས་གཞན་དུ་གནས་པར་སྐྱེ་ནས་ཚོགས་པ་གཞན་དོན་མེད་པར་བརྗོད་ནས།",
    "དུས་གཞན་མི་གནས་པར་སྐྱེ་བ་ལ་མ་ནུས་པ་མེད་པ་བརྗོད་པ་ནི་དུས་གཞན་དུ་མི་གནས་པར་ཞེས་བྱ་བའོ།",
    "དེ་ལྟར་སྒྲོན་མ་ལ་སོགས་པ་སྐད་ཅིག་དང་པོ་ཉིད་ལས་དུས་གཞན་དུ་གནས་པར་སྐྱེས་པ་ལ་སྒོང་ཚུུབུ་དང་རས་བལ་ལ་སོགས་པའི་ཚོགས་པ་མེད་པར་བརྗོད་ནས།",
    "༣༧༡པས་ཀྱང་སྐད་ཅིག་དང་པོ་ཉིད་ལ་བདག་ཉིད་ཐམས་ཅད་བཟུང་བའི་ཕྱིར་རྗེས་སུ་འཇུག་པའི་མིག་༧ལ་སོགས་པ་དོན་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་དེ་བཞིན་དུ་ཞེས་བྱ་བའོ།",
    "དུས་གཞན་དུས་གནས་པའི་༤དེ་ཡིན་ལ་འཛིན་པའི་ཡིན་པ་དེ་ཞེས་བྱ་སྟེ་རྣམ་པར་རྟོག་པ་གཉིས་པའོ།",
    "རྣམ་པར་རྟོག་པ་གཉིས་པ་ལ་བརྗོད་པ་ནི་འཛིན་པ་ཞེས་བྱ་བའོ།",
    "མཐོང་བ་ཞེས་གསུངས་སོ།",
    "འདི་ནི་གཞན་གྱི་ལུགས་ཀྱིས་བརྗོད་པར་ཟད་ཀྱི་འདི་འཐད་པར་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་དགོངས་པའོ།",
    "ཕྱེད་སྔ་མ་རྣམ་པར་འབྲེལ་པ་ནི་དུས་གཅིག་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "མཐོང་བ་མ་ངེས་པར་ཡིན་ནོ་ཞེས་ལན་བརྗོད་པ་ནི་ནུས་པ་དངོས་པོ་ལས་ཐ་མི་དད་པས་བཟུང་བཞིན་དུ་ཡང་རྨོངས་འགྱུར་ཏེ་ངེས་པ་མེད་པར་འགྱུར་རོ།",
    "དེ་དག་ནི་མཐོང་བ་ཉིད་ལས་ངེས་པར་བྱེད་དོ།",
    "སྔོན་པོ་ཉམས་སུ་མྱོང་བ་ཞེས་གསུངས་སོ།",
    "རྗེས་སུ་འབྲང་བ་ན་ཡང་ངེས་པར་བརྟེན་པའི་རྗེས་སུ་དཔག་པ་བརྟག་ེཔའི་ཡུལ་ཅན་དུ་འགྱུར་རོ།",
    "འདིས་ནི་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་དག་ཐ་དད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེས་ན་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་མི་འགལ་ལོ་ཞེས་བྱ་བར་དགོངས་པའོ།",
    "དེས་ན་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་སྒྲུབ་པར་བྱེད་པའི་རྗེས་སུ་དཔག་པས་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "གལ་ཏེ་སྔར་མཐོང་བའི་སྐད་ཅིག་སྐད་ཅིག་ཕྱི་མའི་དུས་ན་དེ་ཁོ་ན་ཉིད་བཞིན་དུ་དྲན་པར་འགྱུར་ན་ནི་མི་རྟག་པ་ཉིད་དུ་ངེས་པར་གྱུར་པ་ཞིག་ན།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དྲན་པ་ཉམས་པ་མེད་ན་རྟག་ཏུ་ལྡོག་པ་དྲན་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་ཡོད་ན་ལྡོག་པ་ལས་ལྡོག་པ་མི་ངེས་པར་ཇི་ལྟར་ཇི་ལྟར་འདི་ཉིད་ངེས་པ་ཡིན་ཞེ་ན།",
    "དཔེར་ན་སྨིག་རྒྱུ་དག་ལ་ཆུར་ལྷག་པར་ཞེན་པ་བཞིན་ནོ།",
    "ཉམས་སུ་མྱོང་བ་དང་དེ་ལས་བཟློག་པ་དག་ལ་ངེས་པ་མེད་པར་དྲན་པ་སྐྱེ་བ་ནི་ངེས་པ་ཡིན་ནོ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་གསུངས་སོ།",
    "དེ་མ་ཐག་ཏུ་ངེས་པར་མི་བྱེད་ན་ནི་མི་དྲན་པ་སྟེ་ཕྱིན་ཅི་ལོག་ཏུ་དྲན་པའོ།",
    "དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་དེ་མ་ཐག་པ་ནི་ཕྱིས་མི་ེདམིགས་པའི་ཕྱིར་ན་སྔར་གྱི་དངོས་པོ་ཡང་མི་རྟག་པ་ཡིན་པར་འགྲུབ་པོ།",
    "དེས་ན་སྔར་བཞིན་དུ་ཕྱིས་ཀྱང་མི་འཇིག་པར་འགྱུར་རོ།",
    "མངོན་སུམ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་༧པར་ལྷག་པར་ཞེན་པ་སྟེ།",
    "དགག་པར་ལྷག་པར་ཞེན་པ་ནི་མེད་པར་སྒྲུབ་པར་བྱེད་པར་ིམི་འགལ་བའི་ཕྱིར་ཏེ།",
    "རིགས་པ་པའི་འདོད་པ་ལས་འདི་ཁྱད་པར་དུ་འཕགས་པར་བསྟན་པའི་དོན་དུ་དེའི་དོན་དུ་བའི་དོགས་པ་བསུ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དེ་ལྟ་བུར་གྱུར་པའི་མི་རྟག་པ་ཉིད་ནི་ེདམིགས་པས་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དངོས་པོ་མེད་པ་མ་རྟོགས་པའི་མཐའ་གཉིས་ཉིད་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་ན་ཡང་དངོས་པོ་མེད་པ་མི་དམིགས་པས་སྒྲུབ་པར་འགྱུར་གྱི་མི་རྟག་པ་ཉིད་ནི་མ་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་སེལ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བ་ནའོ།",
    "དེའི་ཚེ་དངོས་པོའི་དུས་ན་ཉེ་བར་གཟུང་བའི་དངོས་པོའི་མེད་པ་ཉིད་མི་རྟག་པར་ཇི་སྟེ་མི་འདོད་དེ།",
    "འདོད་པ་ལ་ཉེས་པ་དོགས་པར་བྱས་། སེལ་བར་བྱེད་པ་ནི་དྲུག་པ་སོགས་ཞེས་བྱ་བར་རོ།",
    "ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་འབྲེལ་པ་ནི་ལྡན་ེལ་ལྟོས་པས་དངོས་པོ་དག་ཁོ་ནའི་ཡིན་ནོ།",
    "འབྲེལ་པ་མེད་པ་དེ་བས་ན་དྲུག་པ་དང་བདུན་པ་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ་དང་།",
    "དེ་གཉིས་ཀྱི་ཁྱད་པར་ཅན་ཞེས་པ་དེ་ལྟར་སྦྱར་བ་སྔ་ིན་མེད་པ་དང་།",
    "ོཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དངོས་པོར་འགྱུར་བ་ཡིན་ནོ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་དོགས་པའོ།",
    "ཅིའི་ཕྱིར་མེད་པར་འགྱུར་སྙམ་ན།",
    "དངོས་པོ་དང་ཞེས་གསུངས་སོ།",
    "སོགས་པ་སྨོས་པས་ནི་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་བཟུང་ངོ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་འབྲེལ་བ་མི་འཐད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་ག་ལས་ཡིན་སྙམ་ན་མི་འཐད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་ཏེ།",
    "ཁྱད་པར་ཞེས་བྱ་བའོ།",
    "འོ་ན་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་ཡང་འདུ་བ་ལ་སོགས་པའི་འབྲེལ་པ་མེད་པར་མི་འགྱུར་ན་འོ་ན་ནི་ཞེས་སྨོས་ཏེ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་ཞེས་གསུངས་སོ།",
    "དེའི་ཁྱད་པར་ཅན་ནི་མཐའ་གཉིས་ཀྱི་ཁྱད་པར་ཅན་ནོ།",
    "དེས་ན་མི་རྟག་པའི་སྒྲ་ལས་དངོས་པོ་རྟོག་པར་ཇི་ལྟར་འགྱུར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཡོད་པ་མི་རྟག་པ་ཉིད་དུ་མི་འདོད་ལ་མི་རྟག་པའི་སྒྲའི་དངོས་པོའི་རྐྱེན་ཀྱང་ཐ་དད་པའི་མི་རྟག་པ་ཉིད་རྗོད་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་ཐ་དད་པ་མེད་པའི་ཕྱིར་ན་སྒྲའི་མི་རྟག་པ་ཉིད་ཅེས་བྱ་བའི་དྲུག་པར་མི་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་ནས་བརྗོད་པ་ནི་ཡོད་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་ཐ་དད་པ་མེད་ཀྱང་ཡོད་པ་ཉིད་གནས་སོ་ཞེས་བྱ་བར་འགྱུར་བ་དེ་བཞིན་དུ་དངོས་པོའི་མི་རྟག་པ་ཞེས་དྲུག་པར་ཅི་སྟེ་མི་འདོད།",
    "དེ་ལྟ་ན་མི་རྟག་པ་ཉིད་ཐ་དད་པར་འཐད་པ་མ་ཡིན་ནོ།",
    "ཡང་ན་སྒྲའི་ཚུལ་ལམ་རིགས་པས་མཐའ་གཉིས་ཀྱི་ཁྱད་པར་ཅན་གྱི་ཡོད་པ་མི་རྟག་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་མེད་པའི་ཕྱིར་ན།",
    "རྒྱུ་དང་འབྲས་བུ་ཞེས་གསུངས་ཏེ།",
    "ཡོད་པ་ཉིད་དང་ཞེས་གསུངས་སོ།",
    "དེའི་ཚེ་ཁྱད་པར་མེད་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེ་དག་ནི་ཡོད་པའི་ཁྱད་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ་། ཅིའི་ཕྱིར་དེ་དག་ཁྱད་པར་དུ་མི་འགྱུར་ཞེ་ན་འབྲེལ་པ་མེད་པའི་ཕྱིར་རོ་།",
    "འོན་ཏེ་དངོས་པོ་གང་ལ་ཡོད་པ་དང་འབྲེལ་བ་དག་གནས་པ་དེའི་ཁྱད་པར་རྒྱུ་དང་འབྲས་བུར་གྱུར་པའི་མཐའ་དག་ཡིན་ནོ་ཞེ་ན།",
    "འདི་ཡང་ལོག་པ་ཡིན་ཏེ་མཐའ་དེ་དག་ནི་དེའི་ཡང་ཁྱད་པར་མ་ཡིན་ཏེ།",
    "སྔ་ན་མེད་པ་དེའི་ཁྱད་པར་ཅན་གྱི་བརྗོད་པ་གང་ལ་ཡོད་པ་༣ནི་དེའི་ཁྱད་པར་ཅན་ནོ།",
    "དེའི་ཁྱད་པར་ཅན་གྱི་བརྗོད་པ་སྔ་ན་མེད་པ་ལ་བརྟེན་ནས་རྒྱུ་དང་འབྲས་བུའི་ཐ་སྙད་ཐོབ་པ་ནི།",
    "དངོས་པོ་ནི་ཞེས་གསུངས་སོ།",
    "ཁས་ལེན་ཞེས་གསུངས་སོ།",
    "སྔ་ན་མེད་པ་དང་ཞིག་ནས་མེད་པ་ཉིད་མི་རྟག་པ་ཡིན་ནོ་ཞེས་བྱ་བར་གསུངས་སོ།",
    "ཞིག་ནས་མེད་པ་མཐའ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་ལས་རྒྱུ་དང་འབྲས་བུ་མཐའ་ཡིན་ནོ་ཞེས་བྱ་བའི་མཐའ་ཕྱོགས་གཞན་དེ་ལ་བརྟེན་པ་ཡང་ཉམས་པར་འགྱུར་རོ་ཞེས་རྗེས་སུ་འཇུག་གོ།",
    "དེ་ལྟ་ན་ཡང་དངོས་པོའི་རྒྱུ་དང་འབྲས་བུར་འགྱུར་རོ་སྙམ་ན་བརྗོད་པའི་ཁྱད་པར་འདི་ནི་ཞེས་བྱ་བའོ།",
    "དེ་མེད་ན་ཞེས་བྱ་བ་ན་སྔ་ན་མེད་པའི་ཁྱད་པར་མེད་པའོ་། དེར་ཞེས་བྱ་བ་ནི་བརྗོད་པའི་ཁྱད་པར་དུའོ།",
    "གང་མེད་པར་འགྱུར་བ་བརྗོད་པའི་ཁྱད་པར་དེ་ཡང་གང་ཡིན་ཞེ་ན།",
    "འོ་ན་རྒྱུར་འགྱུར་རོ་སྙམ་ནའབྲས་བུ་མེད་པའི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་སྔ་ན་མེད་པའི་ཁྱད་པར་ལ་ལྟོས་པ་རྒྱུ་དང་འབྲས་བུ་ཉིད་ནི་དེ་མེད་ན་མི་འགྱུར་རོ་ཞེས་བརྗོད་པ་ཡིན་ན་ནི་དེའི་ཁྱད་པར་ལ་མ་ལྟོས་པའི་ཕྱིར་ཡང་ཞེས་བྱ་བའོ།",
    "རྒྱུ་དང་འབྲས་བུ་ཉིད་ཀྱི་རང་བཞིན་དེ་ནི་གང་རྣམ་པ་གཞན་ནི་གང་ཞིག་དེས་དེ་མེད་པར་ནི་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དེས་ཅི་ཡང་མི་བྱེད་པ་དེས་ན་གང་ཞིག་སྐྱེད་པར་བྱེད་པས་རྒྱུ་ཡིན།",
    "དེས་ན་ཕྱི་མས་ནི་དེ་མེད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དངོས་པོ་ཡང་ཞེས་གསུངས་སོ།",
    "གཞན་དུ་ནི་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་འབྲེལ་པ་བྱས་པ་མེད་པར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་མེད་པ་དང་ལྷན་ཅིག་འབྲེལ་བ་མེད་པར་ཡང་མེད་པ་ཡིན་ན་དེའི་ཚེའོ།",
    "འབྲེལ་པ་ནི་གཉིས་ལ་གནས་པའི་ཕྱིར་ཐ་དད་པ་ཁོ་ནར་འབྲེལ་པ་ཡིན་ནོ་ཞེས་བསམས་ནས་གཞན་དག་དོགས་པར་བྱེད་པ་ན་ཐ་དད་པ་ཉིད་ཅེས་བྱ་བའོ།",
    "ཐ་དད་པར་ནི་ཞེས་གསུངས་སོ་། ཐམས་ཅད་ལ་འབྲེལ་པ་ཡོད་པར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་བདག་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པས་འབྲེལ་པ་གཞན་དག་ཀྱང་དོགས་པ་བྱས་ནས་སྤོང་བ་ེཐ་དད་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་གྱིས་ཞེས་གསུངས་སོ།",
    "བདག་ཉིད་མ་ཡིན་པ་དང་མི་དམིགས་པས་བསྒྲུབ་པར་བྱ་བ་ཡང་ཡིན་ནོ།",
    "སྤྱི་དང་ཁྱད་པར་ཅན་གྱི་གཞལ་བྱ་གཞན་མེད་པས་སོ།",
    "ཡང་ངོ་ཤེས་པར་ཞེས་བྱ་བ་ནི་འཆད་པའོ།",
    "གྲུབ་པའི་མཐའ་ནི་དེ་ཉིད་ཅེས་བྱ་བས་ནི་རྟོག་པ་དང་ལྡན་པ་འཇུག་པ་ཉིད་མིན་ཏེ་རྣམ་པ་གཞན་དུ་འཇུག་པར་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི་དེ་ནི་དེ་ལྟར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཡང་འཇུག་པའི་ཡུལ་དོན་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་པ་དེ་ལྟ་ན་ཡང་དོན་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་དེ་ནི་དེ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "སྔོན་མཐོང་ཉིད་ཅེས་གསུངས་སོ།",
    "དེའི་དོན་ཞེས་གསུངས་སོ།",
    "སྔོན་མཐོང་བ་ཉིད་དུ་ཞེས་གསུངས་སོ།",
    "སྔརགྱི་ཚད་༧ དང་ཡུལ་ཁྱད་པར་མེད་པ་དེས་ན་གྲུབ་པ་དང་བདེ་བ་ཐ་དད་པ་མ་ཡིན་པས་ན།",
    "དྲན་པ་གཟུང་བ་ལ་འཛིན་པར་བྱེད་པ་ཡིན་པས་ན།",
    "སྦྱོར་བའི་རྣམ་པར་བརྗོད་པ་ནི་དེའི་དོན་བྱེད་པར་རུང་བའི་ཞེས་བྱ་བའོ།",
    "སྐད་ཅིག་མ་ཉིད་ཀྱིས་བསྟན་པའི་དོན་མི་སྐྱེ་བའི་ཕྱིར་རོ་ཞེས་དོགས་པ་བསུ་བ་དེ་དག་ཅེས་གསུངས་སོ།",
    "མི་སླུ་བ་ཡང་ཞེས་གསུངས་ཏེ།",
    "དུ་མ་ཉིད་ཡིན་ཡང་ཞེས་གསུངས་ཏེ་ཉེ་བར་བཏགས་པའི་གཅིག་པ་ཉིད་དུ་ནི་མ་ཟད་དེ།",
    "ད་ནི་གཅིག་ལ་ཡང་དུ་མ་ཉིད་ནི་འཇུག་ཕྱིར་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྤང་བར་འདོད་པས་དེ་ཉིད་ཟློས་པར་བྱེད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "མངོན་སུམ་གྱིས་མཐོང་བའི་ཁྱད་པར་རྗེས་སུ་དཔག་པ་དེ་ནི་ཁྱད་པར་མཐོང་བའི་རྗེས་སུ་དཔག་པའི་༦ཁྱད་པར་ཁོ་ན་ཞེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་མཐོང་བ་ཁོ་ནའོ།",
    "ཁྱད་པར་མཐོང་བའི་རྗེས་སུ་དཔག་པས་༤ཁྱད་པར་ཁོ་ན་འཛིན་པ་ཡིན་ཏེ།",
    "དཔེར་ན་ཁྱད་པར་མཐོང་བའི་རྗེས་སུ་དཔག་པའི་ཤེས་པ་བཞིན་ནོ།",
    "༢༣༩མངོན་སུམ་གྱིས་མཐོང་བའི་ཁྱད་པར་ལ་ནི་ངོ་ཤེས་པ་སྲིད་པ་མ་ཡིན་ནོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་སྐད་སོ་སོར་ཞེས་གསུངས་ཏེ།",
    "ཁྱད་པར་ཡུལ་ཅན་ཉིད་ཀྱང་མིན།",
    "དེ་ལས་གཞན་པའི་ཡུལ་ཅན་ཡིན་ན་ནི་སྐབས་སུ་བབ་པ་མངོན་སུམ་གྱིས་མཐོང་བའི་༦ཁྱད་པར་གྱི་ཡུལ་ཅན་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཕྱི་མའི་སྐད་ཅིག་དེ་མཚུངས་པར་དུ་བའི་སྒོ་ནས་འཛིན་པའི་ཕྱིར་རོ།",
    "ཐ་དད་པ་ནི་རྣམ་པར་གྱུར་པའོ།",
    "གལ་ཏེ་སྔར་མཐོང་བའི་ཁྱད་པར་གྱི་ཡུལ་ཅན་མ་ཡིན་ན།",
    "ོ་ཡོད་པའི་ཁྱད་པར་གྱི་ཡུལ་ཅན་ཉིད་དུ་འགྱུར་རོ་ཞེ་ན།"
  ]
}