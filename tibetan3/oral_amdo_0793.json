    "ན་མ་ས་མནྟ་བུད་དྷཱ་ནཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་ཝ་ལོ་ཀི་ར་གཏོར་མ་བྱིན་ལ་བཏང་།",
    "དེ་ནས་ཉེ་རེག་བྱ་སྟེ་ངག་བཅད་ཙོག་པུར་འདུག་ཅིང་ལག་པ་གཉིས་པུས་མོའི་ནང་དུ་འོང་བར་བྱས་ལ་གཡོན་པའི་མཐིལ་དུ་ཆུ་གཙང་བླུག།",
    "ཁ་ལ་བྱབ་ཅིང་ལན་གསུམ་དུ་རྣ་བ་དང་མིག་དང་སྣ་དང་ལག་པ་དང་པུས་མོ་གཉིས་རྣམས་དང་ལྟེ་བ་དང་མགོ་ལ་རེག་ནས་ཆུ་ལྷག་མ་ཧུབ་གསུམ་གྱིས་ཁ་བཤལ་ཏེ་མཆུ་ལ་ལན་གཉིས་ཕྱི་བར་བྱའོ།",
    "བཛྲ་བེ་གཱ་ཀྲ་མ་ཧཱུཾ་ཞེས་རྡོ་རྗེ་ཤུགས་ཀྱི་འཇུག་པས་དཀྱིལ་འཁོར་དུ་ཞུགས་པར་མོས་ཏེ་ཡིག་བརྒྱ་བརྗོད་ཅིང་རྡོ་རྗེ་གསོར་དྲིལ་བུ་འཁྲོལ་བས་དཀྱིལ་འཁོར་ལ་སྐོར་བ་གསུམ་བྱས་ལ་ཤར་ནས།",
    "རྡོ་རྗེ་ཐལ་མོ་སྤྱི་བོར་སྦྱར་ལ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སོགས་ཀྱིས་གསོལ་བ་གདབ།",
    "སྤྲོ་ན་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཐེབ་བོང་གུང་མོ་མཐེའུ་ཆུང་རྣམས་གྱེན་དུ་བསྒྲེང་སྟེ་ཁ་སྦྱར་མཛུབ་མོ་དང་མིང་མེད་སེམས་སྐྱིལ་དུ་བྱས་པ་རྡོ་རྗེའི་ཕྱག་རྒྱས།",
    "སྣ་དང་སྐེད་པ་པུས་མོ་བོལ།",
    "ལོང་བུ་སྣ་ཡི་རྩེ་མོ་དང་།",
    "ཨོཾ་ཧྲཱི་བི་ཤུད་དྷ་དྷརྨཱ་སརྦ་པཱ་པཱ་ནི་ཙཱ་སྱ་བི་ཤོ་དྷ་ཡ་སརྦ་བི་ཀཝན་ཨ་བ་ན་ཡ་ཧཱུྃ་ཞེས་འཁྱོར་བ་གསུམ་བྱིན་ལ་འཐུང་དུ་གཞུག།",
    "དེ་ནས་ཀུ་ཤ་མང་ཉུང་གཉིས་ཧཱུཾ་དང་དྷིལས་བྱུང་བར་མོས་ཤིང་ལས་སྔགས་དང་ངྷིབཟླས་པ་ཨོཾ་བཛྲ་ཏིཀྵ་ཎ་བཾ་ཞེས་སྟན་དང་སྔས་ཀྱི་དོན་དུ་བྱས་ནས་སེང་གེའི་ཉལ་སྟབས་ཀྱིས་ཉོལ་ལ་རྨི་ལམ་རྟོགས་ཏེ་སྨྲོས་ཤིག་པར་བསྒོ།",
    "ཨོཾ་བུད་དྷ་མེ་ཏྲི་རཀྵ་རཀྵ་སརྦ་སྭཱ་ཧཱ་ཞེས་སྐྱེས་པའི་དཔུང་པ་གཡས་དང་བུད་མེད་ཀྱི་གཡོན་དུ་བཅིང་།",
    "རེས་འགའ་འབྱུང་ངམ་མི་འབྱུང་སྲིད།",
    "བརྒྱ་ལམ་ན་ནི་རེས་འགའ་འབྱུང་།",
    "གང་གིས་ཁྱེད་རྣམས་རྒྱལ་བ་ཀུན།",
    "གང་གིས་ཁྱེད་རྣམས་འགྲོ་འགྱུར་བས།",
    "ངན་ན་ཞི་བའི་སྦྱིན་སྲེག་གིས་བགེགས་བཟློག་པའམ་རྨི་ལམ་རང་བཞིན་མེད་པར་ཤེས་པར་བྱའོ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་བས།",
    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "སློབ་དཔོན་གྱིས་བཛྲ་རཀྵ་བཟླས་པའི་སྟོད་གཡོགས་དང་སྨད་གཡོགས་ཨོཾ་བཛྲ་རཀྵ་ཧཾ་དང་ཨོྃ་བཛྲ་ཝསྟ་ཨཱ་ཧཱུྃ་གིས་བཀོན།",
    "ལས་སྔགས་དང་སྒོ་བ་བཞིའི་སྔགས་བཟླས་པའི་མིག་དར་ཨོཾ་ཙཀྵུ་བྷན་དྷ་ཝ་ར་མ་ཎ་ཡེ་ཧཱུྃ་གིས་བཅིང་།",
    "རང་གི་སེམས་ནི་དག་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་ལན་གསུམ་གྱིས་ཐུན་མོང་གི་སྡོམ་པ་བཟུང་དུ་བཅུག།",
    "བློ་ཆེན་ཁྱོད་ཀྱིས་བཟུང་བར་བྱ།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་རེ་ཞིང་ནི་བཟླ་བར་བྱ།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་བསད་མི་བྱ།",
    "ངག་གི་རྣམ་པ་བཞི་དག་དང་།",
    "ཁྱོད་ཀྱིས་བརྙས་པར་མི་བྱའོ།",
    "ཁྱོད་ཀྱི་རྟག་ཏུ་བསྲུང་བར་བྱ།",
    "དེ་དག་བདག་གིས་བགྱིད་པར་འཚལ།",
    "ཅེས་ལན་གསུམ་གྱིས་ཐུན་མོང་མ་ཡིན་པའི་སྡོམ་པ་བཟུང་དུ་བཅུག་ལ།",
    "བདག་ཉིད་ཆེན་པོ་ཁྱོད་འདོད་དམ།",
    "ཞེས་གཉིས་ཀས་མོས་ཏེ་གནས་དེ་དག་ཏུ་མེས་བོའི་ཤུལ་བཞག་ལས།",
    "སེམས་དཔའ་བཞིའི་ཕྱག་རྒྱའམ་རྡོ་རྗེས་རེག་ཅིང་བཛྲ་ས་ཏྭ་བཛྲ་རཏྣ་བཛྲ་དྷརྨཱ",
    "ཨོཾ་བཛྲ་ས་མ་ཡ་ཧཱུྃ་གིས་དཀྱིལ་འཁོར་དུ་གཞུག།",
    "སྒོ་བ་བཞིའི་སྔགས་རྒྱས་རང་རང་གི་སྒོ་ནས་དགུག་པ་སོགས་བྱས་ལ་སླར་ལྕགས་ཀྱུའི་སྔགས་རྒྱས་ཤར་སྒོར་བཅུག་ལ་ལྷ་སྣམ་གྱི་སྟེང་དུ་བཞག་པར་མོས།",
