    "ཞེས་མོས་ལ་རྡོ་རྗེ་ནང་བསྡམས་ལས་མཐེབ་བོང་གཉིས་གཤིབས་ཏེ་བཀབ་པ་ཏི་རིནྟི་རིའི་ཕྱག་རྒྱས།",
    "ཞེས་མོས།",
    "མཐར་མཉམ་པའི་ཐལ་མོ་དཔྲལ་བར་བརྡབས་ལ་ཨོཾ་བཛྲ་དུ་ཥྱ་ཧོ་ས་མཉེས་པར་བྱ་ཞིང་།",
    "དར་དཀར་པོ་ཞིང་དུ་ཁྲུ་གང་པ་དཀྱུས་སུ་ཁྲུ་ཉི་ཤུ་རྩ་གཅིག་པས་གནས་དགུར་མདུད་ནས་རྣ་བའི་སྔོན་དུ་སོར་བཞི་ཙམ་གྱི་ཁུག་པ་ཕྱུང་ནས་ལྟག་པ་ཕྱེ་སྟེ་བརྐྱང་བ་ལུས་དང་མཉམ་པར་གྱུར་ཞེས་མོས།",
    "གསུང་གི་ང་རོ་འབྲུག་སྟོང་ལྡིར་བའི་སྒྲས།",
    "ཉོན་མོངས་དུག་ཅན་རྩད་ནས་འཇོམས་མཛད་པ།",
    "ཉི་ཟླ་འབར་བའི་སྤྱན་གྱིས་སྡང་མིག་གིས།",
    "ཞེས་བགེགས་ལ་བཀའ་བསྒོས་ནས་ཁུ་ཚུར་རྒྱབ་སྦྱར་ཏེ་མཐེའུ་ཆུང་སྦྲེལ་མཛུབ་མོ་གཉིས་བསྒྲེང་བ་ཧཱུཾ་མཛད་ཀྱི་བཅོམ་ལྡན་འདས་ཀུན་རིག་རྣམ་པར་སྣང་མཛད་ཀྱི་ཆོ་ག་སྒྲིབ་པ་རྣམ་པར་སེལ་བ།",
    "ཨོཾ་བཛྲ་ཛྭ་ལ་ཨ་ན་ལཱརྐ་ཧཱུྃ་གིས་བགེགས་རྣམས་ལ་བསྣུན།",
    "རྡོ་རྗེ་ནང་བསྡམས་ཁ་སྟེང་དུ་བསྟན་ལ་སོར་མོ་རྣམས་འབར་བ་ལྟར་བྱས་ཏེ་གུང་སྲིན་བར་དུ་མཐེ་བོང་རྩེ་སྤྲད་པ་རྡོ་རྗེ་མེའི་རྒྱས།",
    "ཁུ་ཚུར་གཉིས་འགལ་མེའི་འཁོར་ལོ་ལྟར་བསྐོར་ཏེ་མགོ་བོར་མཛུབ་མོ་ལྕགས་ཀྱུའི་ཚུལ་དུ་བཞག་པ་རྡོ་རྗེ་འཇིགས་བྱེད་སྤྱན་གྱི་རྒྱས།",
    "རྡོ་རྗེ་ཐལ་མོའི་མཐེབ་བོང་གཉིས་བརྐྱང་ལ་མཛུབ་མོ་གཉིས་མཆེ་བ་ལྟར་བྱས་པ་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་རྒྱས།",
    "ཨོཾ་བཛྲ་ཡཀྵ་ཧཱུྃ་གུར་གྱི་འོག་ཏུ་རྡོ་རྗེའི་བླ་རེར་གྱུར།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཐེའུ་ཆུང་ལུ་གུ་རྒྱུད་དུ་སྦྲེལ་མཛུབ་མོ་རྩེ་སྤྲད་དེ་བཟློག་ནས་སྤྱི་བོར་བཞག་པ་རྡོ་རྗེ་གཙུག་ཏོར་གྱི་རྒྱས།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་གཉིས་སེམས་སྐྱིལ་དུ་བྱས་ནས་མཛུབ་མོ་གཉིས་མཉམ་དུ་གཤིབས་ཏེ་ཕྱེ་ལ་མཐེའུ་ཆུང་གཉིས་བ་དན་ལྟར་བྱས་པ་རྡོ་རྗེ་བ་དན་གྱི་རྒྱས།",
    "ཧྲཱི་བཛྲ་ཀཱ་ལི་རུ་ཊ་མ་ཊ་བྱང་རྡོ་རྗེའི་ར་བརརྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རི་བོ་འདེགས་ཚུལ་བྱས་པ་རྡོ་རྗེ་རྩེ་མོའི་རྒྱས།",
    "མདུན་དུ་བཅོམ་ལྡན་འདས་ཀུན་རིག་གི་དཀྱིལ་འཁོར་རྟེན་དང་བརྟེན་ངཔར་བཅཅས་པ་གསལ་བར་གྱུར་ཞེས་མོས་ཤིང་ཕྱག་རྒྱ་དེ་ཉིད་ཁར་བཞག་ལ་བལྟ་བཞིན་དུ་སྔགས་དེ་ཉིད་བརྒྱ་རྩ་བརྒྱད་བཟླས་ལ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "སོ་སོར་བརྟན་པོར་བདག་གིས་བཟུང་།",
    "སྡོམ་པ་དེང་ནས་བདག་གིས་བཟུང་།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "མ་རྒལ་བ་རྣམས་བདག་གིས་བསྒྲལ།",
    "མ་གྲོལ་བ་རྣམས་བདག་གིས་དགྲོལ།",
    "ཐལ་མོ་གཉིས་ཁ་སྟེང་དུ་ཕྱོགས་པ་མདུན་དུ་བཞག་ལ།",
    "གཡས་གཡོན་གྱི་སོར་མོ་རྣམས་ལ་མཐེབ་བོང་ནས་རིམ་བཞིན་ༀཧཱུྃ་ཏྲཾ་ཧྲཱི་ཨ་རྣམས་ལས་གཡས་སུ་རྣམ་སྣང་དཀར་པོ་མི་བསྐྱོད་པ་སྔོན་པོ་རིན་འབྱུང་སེར་པོ་འོད་དཔག་མེད་དམར་པོ་དོན་གྲུབ་ལྗང་གུ།",
    "མཉམ་པའི་ཐལ་མོ་བྱས་ལ།",
    "རྡོ་རྗེ་ཐལ་མོ་བྱས་ལ།",
    "དེའི་ཕྱེད་ཚད་དུ་ནང་གི་གཞལ་ཡས་ཁང་སྟེ།",
    "དེའི་སྟེང་དུ་ཨོཾ་ན་མོ་བྷ་ག་ཝ་ཏེ་སརྦ་དུརྒ་ཏི་པ་རི་ཤོ་དྷ་ན་རཱ་ཛཱ་ཡ།",
    "ཏེ་སཾ་མྱཀ་སཾ་བུད་དྷཱ་ཡཏ་དྱ་ཐཱཨོཾ་ཤོ་དྷ་ནེ་ཤོ་དྷ་ནེ།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ་ཉི་མའི་རྒྱབ་ཡོལ་ཅན་དུ་གྱུར།",
    "གང་ཕྱིར་ངན་སོང་བདག་ཅག་སྦྱངས།",
    "ཅེས་ཆེད་དུ་བརྗོད་པ་ཆེད་དུ་བརྗོད་ནས་མི་སྣང་བར་གྱུར་ཏོ་ཞེས་མོས།",
    "རང་གི་ཐུགས་ཀར་ཟླ་བའི་སྟེང་དུ་རྩ་རིག་གིས་བསྐོར་བའི་དབུས་སུ་ཧཱུྃ་ཏཱཾ་ཧྲཱི་ཨཱ་རྣམས་ལ་འོད་ཟེར་སྣ་ལྔ་འཕྲོས།",
    "ངན་སོང་སྦྱོང་རྒྱལ་དཀར་དམར་ཕྱག་གཉིས་ཏིང་ངེ་འཛིན་གྱི་ཕྱག་རྒྱས་རྡོ་རྗེ་རྩེ་ལྔ་པ་འཛིན་པ།",
    "ཐམས་ཅད་ཀྱང་ཞི་བའི་གཟིགས་སྟངས་ཅན་སོགས་ཉི་མའི་རྒྱབ་ཡོལ་ཅན་དུ་གྱུར།",
    "མཱ་མ་ཀཱི་སྔོན་མོ་གཡས་རྡོ་རྗེ་འཛིན་པ།",
    "གོས་དཀར་མོ་དམར་མོ་གཡས་པདྨ་འཛིན་པ།",
    "ཨོཾ་བུད་དྷ་ལོ་ཙ་ནེ་ཧཱུཾ།",
    "ཨོཾ་བཛྲ་པཱཎཱ་རེ་དེ་ཧི་དེ་ཧི་སིད་དྷི་བོ་དྷི་ལོ་ཀོཏྟ་རིཾ་པ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་སྭ་སྭ་སྭ་སྭཱ་ཧཱ།",
    "རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ་གཡས་སོར་མོ་དབུས་མ་གསུམ་བསྒྲེང་བའི་རྩེ་མོར་དང་པོའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཐུགས་ཀར་བསྟོད་པའི་ཚུལ་དུ་འཛིན་ཞིང་གཡོན་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་དྲིལ་བུ་ཁ་ནང་དུ་བསྟན་ཏེ་སྙེམས་པའི་ཚུལ་གྱིས་དཀུར་བརྟེན་པ།",
    "རྡོ་རྗེ་རྒྱུ་སེར་པོ་གཡས་ཀྱི་གུང་མོའི་རྩེ་མོར་རྡོ་རྗེ་རྩེ་གཅིག་པའི་རྩིབས་ཅན་གྱི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་བསྐོར་བར་མཛད་པ།",
    "རྡོ་རྗེ་ལས་རབ་ཞལ་དང་བྱིན་པ་མན་ཆད་དཀར་པོ་ཞལ་གྱི་འོག་ནས་སྐེད་པའི་བར་དམར་སྐྱ་སྐེད་པའི་བར་དང་ཕྱག་གཉིས་སྔོ་སྐྱ་བརླ་གཉིས་སེར་སྐྱ་ལྷག་མ་སྔོན་པོ་གཡས་སྣ་ཚོགས་རྡོ་རྗེ་རྩེ་མོ་བཅུ་གཉིས་པ་ཐུགས་ཀར་གཏོད་པའི་ཚུལ་གྱིས་འཛིན་ཞིང་གཡོན་སྙེམས་པའི་ཚུལ་གྱིས་དྲིལ་བུ་དཀུར་བརྟེན་པ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་སེར་པོ་ཕྱག་གཉིས་དམ་ཚིག་གི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རྡོ་རྗེ་རྩེ་ལྔ་པ་འཚིར་བར་མཛད་པའོ།",
    "ཧཱུཾ་ཏྲཾ་ཧྲཱི་ཨ་སྒེག་མོ་དཀར་མོ་ཕྱག་གཉིས་རྡོ་རྗེ་རྩེ་ལྔ་པ་གཉིས་དཀུར་འཛིན་ཞིང་སྒེག་པས་གཡོན་དུ་ཅུང་ཟད་འདུད་པ།",
    "ནང་གི་གྲྭ་བཞིའི།",
    "ཧཱུྃ་ཏཱཾ་ཧྲཱི་ཨ་བདུག་སྤོས་མ་དཀར་མོ་ཕྱག་གཉིས་རྡོ་རྗེ་སྤོས་སྣོད་བསྣམས་ཏེ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཚིམ་པར་མཛད་པ།",
    "མེ་ཏོག་མ་སེར་མོ་གཡོན་རྡོ་རྗེ་མེ་ཏོག་གི་སྣོད་བསྣམས་ཏེ་གཡས་མེ་ཏོག་གི་ཆར་འབེབས་པར་མཛད་པ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་དམར་སྐྱ་ཕྱག་གཉིས་རྡོ་རྗེ་ལྕགས་སྒྲོག་གིས་དེ་བཞིན་གཤེགས་པ་རྣམས་འཆིང་བར་མཛད་པ།",
    "ནང་གི་སྒོ་བཞིའི།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ་ཟླ་བའི་རྒྱབ་ཡོལ་ཅན་དུ་གྱུར་ཞེས་མོས།",
    "ཧཱུཾ་མཛད་ཀྱི་ང་རྒྱལ་གྱིས་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཁ་གྱེན་དུ་བསྟན་ལ་མཛུབ་མོ་བསྒྲེང་བའི་ལོགས་ཀྱི་རྩེ་མོ་སྦྱར་ཏེ་ཁྲོས་ནས་མཛུབ་མོ་གཉིས་དབྱེ་བའི་རྒྱས།",
    "ཀུན་རིག་གི་ང་རྒྱལ་གྱིས་རྡོ་རྗེ་ཁུ་ཚུར་ལས་མཛུབ་མོ་ལྕགས་ཀྱུ་ལྟར་བྱས་ཏེ་ལག་ངར་བསྣོལ་ལ་གུང་མཐེབ་ཀྱིས་སེ་གོལ་མཉམ་པར་རྡེབ་པ་རྡོ་རྗེ་བསྡུ་བའི་རྒྱས།",
    "ལྷ་སྣམ་བར་མའི་གདན་ལ་ཤར་དུ་དགའ་བོ་སྒྲ་གཅན་འཛིན་ཤཱ་རིའི་བུ་མོའུ་འགལ་གྱི་བུ།",
    "ཤར་སྒོར་ཁྲོ་བོ་འཇིག་རྟེན་གསུམ་སྣང་དེའི་གཡས་སུ་བདུད་རྩི་འཁྱིལ་བ་གཡོན་དུ་དུས་ཀྱི་སྲིན་མོ་རྒྱབ་ཏུ་དུས་ཀྱི་ལྕགས་ཀྱུ་མ།",
    "ནུབ་སྒོར་འཇིག་རྟེན་གསུམ་འཆིང་གཡས་སུ་མི་གཡོ་བ་གཡོན་དུ་དུས་ཀྱི་མཚན་མོ་རྒྱབ་ཏུ་དུས་ཀྱི་ལྕགས་སྒྲོག་མ།",
    "གནོད་སྦྱིན་གྱི་ལས་རྒྱ་དང་ཨོཾ་བཛྲ་ཡཀྵ་ཧཱུྃ་གིས་ཕྱི་འབྲང་གི་བགེགས་བསྐྲད།",
    "ཁུ་ཚུར་གྱི་ལས་རྒྱ་དང་ཨོཾ་བཛྲ་སན་དྷི་སཾ་གིས་སྒོ་བཅད།",
    "བསྲུང་བའི་ལས་རྒྱ་དང་ཨོཾ་བཛྲ་རཀྵ་རཾ་གིས་བསྲུང་།",
    "རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་བའི་ཕྱག་རྒྱ་དང་ཨོཾ་བཛྲ་ས་ཏྭ་ཧཱུཾ་གིས་མཆོད་ཡོན་ཕུལ་ཏེ།",
    "མཉམ་པའི་ཐལ་མོ་དཔྲལ་བར་སྦྱར་ལ་ཨོཾ་བྷི་ཏ་བྦི་ཏ་སརྦ་ཨཱ་ཝ་ར་ཎཱ་ནི་ཧཱུྃ་ཕཊ།",
    "ཐལ་མོ་སྙིམ་པར་སྦྱར་བ་མགྲིན་པར་བཞག་ལ་ཨོཾ་ཏྲཊ་ཏྲཊ་སརྦ་ཨཱ་ཝ་ར་ཎ་ནི་ཧཱུྃ་ཕཊ།",
    "སརྦ་བིད་དྲི་ཤྱ་ཛ་ཧཱུྃ་བཾ་ཧོ་ས་མ་ཡ་སྟཱཾ་གིས་དམ་ཚིག་པ་ལ་ཡེ་ཤེས་པ་དགུག་གཞུག་བཅིང་མཉེས་བྱ་བཅོམ་ལྡན་འདས་ཀུན་རིག་རྣམ་པར་སྣང་མཛད་ཀྱི་ཆོ་ག་སྒྲིབ་པ་རྣམ་པར་སེལ་བ།",
    "ས་མ་ཡ་སཾ་ཨ་ཧཾ་གིས་གཉིས་མེད་ཀྱི་ང་རྒྱལ་བྱས་ལ།",
    "ཨོཾ་སརྦ་བིད་སརྦ་ཨཱ་ཝ་ར་ཎཱ་བི་ཤོ་དྷ་ནེ་ཧ་ན་ཧཱུྃ་ཕཊ་ཅེས་རྣམ་སྣང་གི་སྔགས་ལན་གསུམ་བརྗོད།",
    "བུད་དྷ་ལོ་ཙ་ནེ་དྲི་ཤྱ།",
    "བུད་དྷ་ལོ་ཙ་ནེ།",
    "བཛྲ་པཎྜ་རེ།",
    "བཛྲ་ཏཱ་རེ་ཞེས་པའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་བསྒྲེང་བའི་ཚིགས་གསུམ་པར་མཛུབ་མོ་གཉིས་རྡོ་རྗེའི་ཚུལ་དུ་བཟུང་བ་ནི་མཱ་མ་ཀཱིའིའོ།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་ཏེ་པདྨ་ཁ་བྱེ་བའི་ཚུལ་དུ་བྱས་པ་ནི་གོས་དཀར་གྱིའོ།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བ་ལས་མཛུབ་མོ་གཉིས་བཀུག་པས་གུང་མོའི་སེན་མོ་མནན་ཏེ་མཐེ་བོང་གཉིས་དབུས་སུ་བཞག་ནས་ཅུང་མེས་བོའི་ཤུལ་བཞག་ལས།",
    "དེཉིད་ལས་མཛུབ་མོ་གཡས་བཀུག་པ་རྒྱལ་པོའི་དང་།",
    "དེ་ཉིད་ལས་སླར་བཀུག་སྟེ་མཐེ་བོང་ལ་མཛུབ་མོ་གཉིས་རྩེ་སྤྲད་པ་ལེགས་པའི་དང་།",
    "དེ་ཉིད་ལས་རྩེ་མོ་ཡིད་ཙམ་བཀུག་པ་རྣོན་པོའི་དང་།",
    "དེཉིད་ལས་རྩེ་མོ་ཡིད་ཙམ་བཀྱེད་པ་ལས་ཀྱི་དང་།",
    "དེཉིད་ལས་རྩེ་མོ་གཉིས་སླར་བཀུག་ལ་གནོད་སྦྱིན་གྱི་དང་།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་བྱུང་བའི་གར་བྱས་ལ་ཐལ་མོ་སྦྱར་བ་སྤྱི་བོར་བཞག་པ་གར་མའི་དང་།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་བཅོམ་ལྡན་འདས་ཀུན་རིག་རྣམ་པར་སྣང་མཛད་ཀྱི་ཆོ་ག་སྒྲིབ་པ་རྣམ་པར་སེལ་བ།",
