    "རྣམ་པར་རྟོག་ཅིང་དེ་གོམས་པར་བྱེད་པའོ།",
    "དེ་མྱོང་བ་ནི་དེ་ལྟར་གོམས་པར་བྱེད་པ་ན་མཐོང་བའི་ལམ་ཞེས་བརྗོད་པ།",
    "དེ་ལྟར་རྣམ་པ་བཞི་ནི་ལམ་གྱི་འཁོར་སྟེ་ཡང་དང་ཡང་དུ་གཞན་ལ་བརྟེན་ནས་རྣམ་པར་འཇོག་པར་རིག་པར་བྱའོ།",
    "ཡང་བཟོད་པའི་གནས་སྐབས་ན་བདེན་པའི་དེ་བཞིན་ཉིད་མངོན་སུམ་དུ་ཡོངས་སུ་ཤེས་པ་དང་ཤེས་པ་རྣམས་ནི་སྒྲིབ་སྤངས་པའི་གནས་སྐབས་སུ་སྐྱེས་པའི་ཕྱིར་ཡོངས་སུ་སྤོང་བས་ཀྱང་ལམ་རྣམ་པར་དག་པའི་ཕྱིར་རོ།",
    "དེ་རྣམས་ཀྱིས་གནས་གྱུར་པ་མངོན་སུམ་དུ་ཐོབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གཞན་གྱིས་གཞན་ལ་ལུང་ནོད་པ་མེད་པར་ཡང་བདག་ཉིད་མཁས་པའི་ཕྱིར་རོཤེས་ནས་དད་པ་ཐོབ་པས་གཞན་མུ་སྟེགས་ཅན་རྣམས་ཀྱིས་ཚེ་མི་དཀྲི་བ་ནི།",
    "སྙོམ་པར་འཇུག་པའི་བསམ་གཏན་ནི།",
    "དངོས་གཞི་ཁྱད་པར་ཅན་ཞེས་བྱ་ལ།",
    "སྦྱོར་བའི་དུས་སུ་གཟུགས་ཀྱི་འདུ་ཤེས་རྣམ་པར་བཞག་སྟེ།",
    "ནམ་མཁའ་མཐའ་ཡས་སོ་སྙམ་དུ་ཡིད་ལ་བྱས་པས་དངོས་གཞིའི་དུས་ན་དེ་ཉིད་མངོན་དུ་གྱུར་པའི་སེམས་རྩེ་གཅིག་པ་མཚུངས་ལྡན་དང་བཅས་པའོ།",
    "ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ནི་དེའི་འོག་ཏུ་གཟུང་བྱ་ཅི་ཡང་མེད་དོ་སྙམ་དུ་ཡིད་ལ་བྱས་པས་དེ་ཉིད་མངོན་དུ་གྱུར་པའོ།",
    "ཞི་བ་གྱ་ནོམ་པའོ་ཞེས་ཡིད་ལ་བྱས་པས།",
    "གང་ཞིག་གོང་མའི་ཉེར་བསྡོགས་ཐོབ་པ་དེ་ནི་འོག་མའི་དངོས་གཞི་ལ་བརྟེན་ནས་ལམ་སྒྲུབ་པར་བྱེད་དེ།",
    "གོང་མའི་ཉེར་བསྡོགས་ལས་འོག་མའི་དངོས་གཞི་ལམ་སྒྲུབ་པར་སླ་བའི་ཕྱིར་རོ།",
    "དེ་ཡང་ཉམས་པ་ཆ་མཐུན་དང་གནས་པ་ཆ་མཐུན་ཁྱད་པར་ཆ་མཐུན་ངེས་འབྱེད་ཆ་མཐུན་ཏེ་བཞི་ཡིན་ནོ།",
    "སྲིད་རྩེ་ལ་ནི་ཁྱད་པར་ཆ་མཐུན་མེད་དེ།",
    "གཞན་རྣམས་ལ་ནི་བཞི་ཀ་ཡོད་པར་རིགས་པར་བྱའོ།",
    "དེས་ཁྱད་པར་ཐོབ་ན་སེམས་ཁེངས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྣམ་པར་བཞག་པ་ལ་ཡན་ལག་རྣམ་པར་བཞག་པ་ལ་སོགས་པ་བཞི་ལས་དང་པོ་ཡན་ལག་རྣམ་པར་བཞག་པ་ནི་བསམ་གཏན་དང་པོ་ནི་ཡན་ལག་ལྔ་དང་ལྡན་ཏེ།",
    "གཉིས་པ་དང་གསུམ་པ་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་ཅེ་ན།",
    "གསུམ་པ་དང་བཞི་པ་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་ཅེ་ན།",
    "བསམ་གཏན་བཞི་པ་ནི་ཤིན་ཏུ་སྲངས་པ་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ཡང་བདེ་བ་ཡན་ལག་ཏུ་མ་སྨོས་པའི་ཕྱིར་རོ།",
    "ཏིང་ངེ་འཛིན་དང་མཚུངས་པར་ལྡན་པས་ཁ་ནང་དུ་ཕྱོགས་ཏེ།",
    "བྱིས་པ་རྣམས་ཀྱིས་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་རྟོགས་པར་དཀའ་བའི་ཕྱིར་རོ།",
    "དེ་སྐད་དུ་ཡང་རྣམ་པར་གཏན་ལ་དབབ་པར།",
    "བསམ་གཏན་གཉིས་པ་དང་གནས་སའི་ཁྱད་པར་མི་དམིགས་པར་འགྱུར་བས།",
    "དེའི་ཕྱིར་མ་སྤངས་པ་ཁོ་ནར་རིག་པར་བྱའོ།",
    "ཞེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "བསམ་གཏན་གསུམ་པ་སྤངས་པ་ཁོ་ནར་རིག་པར་བྱའོ།",
    "ཅེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཕྱི་རོལ་གཟུགས་ཀྱི་འདུ་ཤེས་དང་ནང་རྣམ་པར་ཤེས་པ་ལ་དཀྲ་བར་འཛིན་པའི་འདུ་ཤེས་གཉིས་ཡིན་ལ།",
    "ཅིའི་ཕྱིར་གཟུགས་མེད་པ་རྣམས་ལ་ཡན་ལག་རྣམ་པར་མི་བཞག་ཅེ་ན།",
    "སྙོམས་པར་འཇུག་པ་རྣམ་པར་བཞག་པ་ནི་ཡིད་ལ་བྱེད་པ་བདུན་གྱིས་བསམ་གཏན་དང་པོ་ནས་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་གྱི་བར་ལ་སྙོམས་པར་འཇུག་སྟེ།",
    "དེ་ནི་ཐོས་པ་དང་བསམ་པ་འདྲེས་པའི་རང་བཞིན་ཅན་དུ་རིག་པར་བྱའོ།",
    "དེས་དེ་ལྟར་དཔྱད་ནས་ཅུང་ཞིག་མ་སྤངས་པར་ཤེས་པ་ན།",
    "སྤང་བྱ་དང་ཐོབ་བྱ་ལེགས་པར་ཡོངས་སུ་ཤེས་ནས་སྤང་བྱ་དང་ཐོབ་བྱ་ལ་སེམས་འཇོག་པར་བྱེད་པའོ།",
    "འབྲས་བུ་བསམ་གཏན་གྱི་སྐྱེ་བ་རྣམ་པ་གསུམ་གསུམ་འགྲུབ་པར་ཤེས་པར་བྱའོ།",
    "ཞི་གནས་ཀྱི་ཆ་ནི་དེ་དག་དང་མཚུངས་པར་ལྡན་པའི་བསམ་གཏན་དང་པོའི་ཉེར་བསྡོགས་མི་ལྕོགས་པ་མེད་པ་ནས་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་བར་ཏེ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ལམ་ནི་རྣམ་པར་མི་རྟོག་པའི་རང་བཞིན་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དག་ལས་སྲིད་རྩེ་འཇིག་རྟེན་པ་དང་གཞན་བདུན་འཇིག་རྟེན་ལས་འདས་པར་ཡང་བསྟན་ན།",
    "གཟུགས་ལ་འདོད་ཆགས་དང་བྲལ་བ་ཁོ་ན་གཟུགས་མེད་པ་རྣམས་ལ་སྙོམས་པར་འཇུག་པའི་ངེས་པ་མེད་དོ།",
    "འདི་ལྟར་གཟུགས་ལས་འདོད་ཆགས་དང་བྲལ་ལ་གཟུགས་མེད་པ་ལ་སྙོམས་པར་འཇུག་མི་ནུས་པ་ཡང་ཡོད་དེ།",
    "གཟུགས་ལ་འདོད་དང་མ་བྲལ་བར་གཟུགས་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་ནི་བསམ་གཏན་བཞི་པ་ཐོབ་པའི་འཕགས་པ་གཟུགས་མེད་པར་སྐྱེ་བ་དོན་དུ་མི་གཉེར་ལ།",
    "སྤོང་བའི་ལམ་གསལ་ནས་ཁྱད་པར་ཅན་གྱི་ལམ་ལ་གནས་ཏེ།",
    "གཉེན་པོའི་ཕྱོགས་རྣམ་པར་བཞག་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་ནི།",
