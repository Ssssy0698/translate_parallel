    "ནག་པོའི་ཕྱོགས་གཏུགས་ནས་ཡང་གང་གིས་བདེ་བར་འགྱུར་བ་དེ་ནི་གསུམ་པ་ཡིན་ནོ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "འདི་ལྟར་འཇིག་རྟེན་པ་དག་ནི་དང་པོར་སྡུག་བསྔལ་གང་ཡང་རུང་བ་གཅིག་གིས་ཐེབས་པ་ན་དེ་ལ་རྟོག་པར་བྱེད་དོ།",
    "རང་གི་མཚན་ཉིད་ཡོངས་སུ་གྲུབ་པ་ལ་རྣམ་པར་བཞག་ལ།",
    "མ་རིག་པའི་རྗེས་སུ་འགྲོ་བའི་འཇིག་རྟེན་པ་དག་གིས་རྣམ་པར་གཞག་པས་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡིན་ནོ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་ནི་སྤང་བར་བྱ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་ནི་སྡུག་བསྔལ་གྱི་བདེན་པས་བསྡུས་པ་ཡིན་པའི་ཕྱིར།",
    "སྡུག་བསྔལ་གྱི་བདེན་པ་ཡོངས་སུ་ཤེས་སུ་ཟིན་ཀྱང་ད་རུང་ཀུན་འབྱུང་གི་བདེན་པ་དང་རྗེས་སུ་འབྲེལ་བའི་ཕྱིར་ཀུན་འབྱུང་གི་བདེན་པ་ནི་སྤང་བར་བྱ་བ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་དང་སྤྱིའི་མཚན་ཉིད་གཉིས་ཀྱི་སྒོ་ནས་ཤེས་པར་བྱ་བ་ཡིན་པས།",
    "སྡུག་བསྔལ་གྱི་རྣམ་པ་གཅིག་པུ་ནི་རང་གི་མཚན་ཉིད་ཡིན་ནོ།",
    "སྡུག་བསྔལ་གྱི་བདེན་པ་ཡང་ཟག་པ་དང་བཅས་པ་ཉིད་ཀྱིས་སྤང་བར་བྱ་བ་ཡིན་ན་ཅིའི་ཕྱིར་ཀུན་འབྱུང་གི་བདེན་པ་ཁོ་ན་སྤང་བར་བྱ་བ་ཡིན་ཞེ་ན།",
    "གང་ཞིག་གང་གི་རང་བཞིན་མི་འདོད་པ་དེས་ནི་དེའི་རྒྱུའི་རང་བཞིན་སྤང་བར་བྱ་བ་ཡིན་ནོ།",
    "དེ་བས་ན་ཀུན་འབྱུང་གི་བདེན་པ་ནི་སྤང་བར་བྱ་བ་ཁོ་ན་ཡིན་ནོ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "གང་གི་ཚེ་སྡུག་བསྔལ་མ་ལུས་པ་ཉེ་བར་ཞི་བའི་འགོག་པ་དེ་ཉིད་མངོན་གསུམ་དུ་བྱ་བ་དམ་པར་བསྟན་པ་ན།",
    "དེ་དག་གི་གནས་ན་ཡོད་པའི་རྒྱལ་ཆེན་བཞིའི་རིས་སོ།",
    "རྗེ་བཙུར་རེད་ར་དའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "རང་གི་སྤྲུལ་པའི་ལོངས་སྤྱོད་ལ་དགའ་བར་བྱེད་པས་འཕྲུལ་དགའོ།",
    "རང་གི་ས་གོང་མ་ལ་ལྟོས་ནས་འོད་ཆུང་བའི་ཕྱིར་འོད་ཆུང་ངོ།",
    "ཚོགས་དྲུག་གི་འདུ་ཤེས་རྒྱུན་བཅད་དེ་གནས་པས་འདུ་ཤེས་མེད་པའོ།",
    "ཏིང་ངེ་འཛིན་ཁྱད་པར་ཅན་ཐོབ་པས་ཉོན་མོངས་པའི་གདུང་བ་མེད་པའི་ཕྱིར་མི་གདུང་པའོ།",
    "སྙོམས་འཇུག་གི་སྦྱོར་བའི་དུས་ན་ནམ་མཁའ་མཐའ་ཡས་སོ་སྙམ་པའི་རྣམ་པར་བྱེད་པས་དེའི་ཕྱིར་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་དོ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "ཡང་སོས་ནི་འདི་ནས་དཔག་ཚད་སུམ་ཁྲི་ཉིས་སྟོང་གི་འོག་ན་ཡོད་དོ།",
    "དེའི་འོག་ཏུ་དཔག་ཚད་བཞི་སྟོང་བཞི་སྟོང་གིས་བཅད་པ་ན་ནི་དེ་ལས་གཞན་པ་རྣམས་ཡོད་དོ།",
    "དེའི་འོག་དཔག་ཚད་ཉིས་སྟོང་ཉིས་སྟོང་གིས་བཅད་པ་ན་ནི།",
    "དེ་དག་གི་གནས་གཞན་ལོགས་ཤིག་ཏུ་རྣམ་པར་མི་བཞག་གོ།",
    "གནས་བརྟན་མོང་འགལ་གྱི་བུས།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "རེས་ཆེ་ཞིང་རེས་ཆུང་ངུར་འགྱུར་ཏེ།",
    "དེ་ཡང་རང་གི་ཁྲུ་ཕྱེད་དང་བཞི་པའོ།",
    "རང་གི་ཁུ་ཕྱེད་དང་བཞི་པའོ།",
    "རྒྱང་གྲགས་བཞི་ཆ་གཅིག་ལྷག་ཙམ་མོ།",
    "འོག་མ་འོག་མ་ལས་གོང་མ་གོང་མ་རྒྱང་གྲགས་བཞི་ཆ་རེ་རེས་ལྷག་པར་བལྟ་བར་བྱའོ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "འཛམ་བུ་གླིང་པའི་མི་རྣམས་ཀྱི་ནི་ཞག་སུམ་ཅུ་ལ་ཟླ་བ་གཅིག་དང་ཟླ་བ་བཅུ་གཉིས་ལ་ལོ་གཅིག་གཅིག་གི་ཚུལ་གྱིས་ཚེའི་ཚད་ངེས་པར་བྱེད་དོ།",
    "དེ་ཡང་རེས་འགའ་ནི་ཚེའི་ཚད་དཔག་ཏུ་མེད་པར་འགྱུར་ལ།",
    "རེས་འགའ་ནི་བརྒྱད་ཁྲི་བར་འགྱུར་རོ།",
    "རེས་འགའ་ནི་ཚེ་ལོ་བཅུ་པའི་བར་དུ་འགྱུར་རོ།",
    "ཟླ་བ་ཉིན་ཞག་གིས་ལྔ་བརྒྱ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞངས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "བྱང་གི་སྒྲ་མི་སྙན་མ་གཏོགས་པ་རྣམས་རང་རང་གི་ཚེའི་ཚད་ལ་མ་སླེབས་པར་བར་མ་དོར་འཆི་བ་ཡོད་དོ།",
    "དེ་དག་གིས་ཕན་ཚུན་གཅིག་ལ་གཅིག་བསྣན་པར་བྱེད་དོ།",
    "དེ་ནས་ཡང་ལངས་ཏེ་ཕན་ཚུན་གཅིག་ལ་གཅིག་གིས་བསྣན་པར་བྱེད་དོ།",
    "རྗེ་བཙུན་རེད་ར་དའ་བ་གཞོར་ར་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུར་ངོ་ད་བཅུ་པ།",
    "སྟག་གི་གདོང་པ་ལྟ་བུ་གཉིས་གཉིས་ཀྱི་བར་དུ་བརྫ་ང་བར་བྱེད་དོ།",
    "བཙིར་ནས་སྒོ་ཐམས་ཅད་ནས་ཁྲག་གིས་རྒྱུན་འབབ་བོ།",
    "དེ་ནས་སྒོ་ཐམས་ཅད་ནས་ཁྲག་གི་རྒྱུན་འབབ་བོ།",
    "ངུ་འབོད་ཀྱི་སྐབས་སུ་བསྟན་པའི་ཁང་པ་དེ་ལྟ་བུ་ཉིས་སྦྲག་གི་ནང་ན་འདུག་པར་རིག་པར་བྱ་སྟེ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "རྩེ་མོ་གསུམ་པོ་ཕྲག་པ་གཉིས་དང་།",
    "ཡང་ལྕགས་གླེགས་པ་ཚ་ཞིང་རབ་ཏུ་ཚ་བ་འབར་ཞིང་ཀུན་ཏུ་འབར་བ་དག་གིས་ལུས་ཡོངས་སུ་བཀྲི་བར་བྱེད་དོ།",
    "བྱང་གི་ཕྱོགས་རྣམས་ཀྱང་དེ་དང་འདྲ་སྟེ།",
    "རྗེ་བཙུན་རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་ཞབས་ཀྱི་གསུང་འབུམ་པོད་བཅུ་པ།",
    "ལྕགས་ཀྱི་ར་བ་དག་གིས་བསྐོར་ཏེ།",
