    "རྡོ་རྗེ་ཆགས་པར་བདག་ཉིད་རྣམ་པར་བསམས་ནས།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བའི་སེམས་དཔའ་རྣམས་ཡིད་ཀྱིས་མདུན་དུ་གནས་པ་ལ།",
    "བསྒྲུབ་པར་བྱ་བ་མདུན་དུ་བཞག་སྟེ།",
    "དེ་བཞིན་དུ་འོད་ཟེར་དམར་པོ་རྣམས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་འཁྱུད་ཅིང་བཟླས་བརྗོད་བྱ་སྟེ།",
    "རྡོ་རྗེ་བསྡམས་པའི་ཁུ་ཚུར་ཆེན་པོས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཐམས་ཅད་བསྡམས་པ་ལ་ནི་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་ཀྱི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བའི་རྡོ་རྗེ་ལྕགས་སྒྲོག་དང་བཅིང་བར་བྱའོ།",
    "ཐམས་ཅད་ལྐུགས་པར་བྱ་བ་ལ་ནི་ཞེས་བྱ་བ་ལ།",
    "རྡོ་རྗེ་ཞལ་གྱི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བདག་ཉིད་རྡོ་རྗེ་དགུན་གྱི་གཟུགས་སུ་རྣམ་པར་བསམས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་རྡོ་རྗེ་ཁ་བ་བབས་པས་འཁྱག་པར་འགྱུར་ཞིང་ཚིག་སྨྲ་མི་ནུས་པས་རྨུགས་པར་བསམ་པར་བྱ་སྟེ།",
    "དེ་ལྟ་བུས་ནི་ལྐུགས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་བསྡམས་པའི་ནང་དུ་ཆུད་པ་དང་བསྒྲུབ་པར་བྱ་བ་བཙིར་བར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་བསྡམས་པའི་ཁུ་ཚུར་ཏེ།",
    "ཐམས་ཅད་གསད་པ་ལ་ནི་རྡོ་རྗེ་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "ཨཱ་ཧཱུཾ་ཞེས་བྱ་བས་རྡོ་རྗེ་ཁྲོ་བོར་བདག་ཉིད་རྣམ་པར་བསམས་ལ།",
    "དེ་ལྟ་བུས་ནི་རྡོ་རྗེ་ཁྲོ་བོའི་ཁུ་ཚུར་གྱིས་ཐམས་ཅད་གསོད་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་སྦྱོར་བས་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "ཐམས་ཅད་གཞིག་པ་ལ་ནི་རྡོ་རྗེ་ངེས་པར་བཙིར་བའི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི།",
    "སྔ་མ་བཞིན་དུ་སྦྱོར་བ་བྱས་ལ།",
    "བསྒྲུབ་པར་བྱ་བ་བཙིར་བའི་བསམ་པས་བཙིར་བར་བྱའོ།",
    "འདིས་ནི་རྡོ་རྗེ་ངེས་པར་བཙིར་བའི་ཁུ་ཚུར་འདིས་ཐམས་ཅད་གཞིག་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་དྲལ་བའི་བསམ་པས་དྲལ་བར་བྱའོ།",
    "འདི་དང་ཨ་ཞེས་བྱ་བས་ཐམས་ཅད་འབེབས་པར་འགྱུར་རོ།",
    "འདིས་ཐམས་ཅད་གར་བྱེད་དུ་གཞུག་པར་བྱའོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "ཨ་ཞེས་བྱ་བ་ཟློས་ཤིང་ཐམས་ཅད་གར་བྱེད་པའི་ཚུལ་གྱིས་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཡིད་ཀྱིས་གཞུག་པས་བསྒྲུབ་པར་བྱ་བ་བཀང་ལ།",
    "བདག་ཉིད་ཀྱིས་གར་བྱས་ཏེ་དེས་ནི་ཐམས་ཅད་གར་བྱེད་དུ་གཞུག་པར་བྱའོ།",
    "འདི་བཅིངས་ལ་ཨ་ཞེས་བྱ་བ་བཟློས་ཤིང་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བས་བསྒྲུབ་པར་བྱ་བའི་ལུས་ལ་ཇི་ལྟ་བ་བཞིན་དུ་ཞུགས་ནས།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་ཡང་དང་ཡང་དུ་པི་ཝང་བརྡུང་བ་ལྟར་བྱས་ན་ཐམས་ཅད་སྨྲ་བར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "འབར་བ་དེས་ཕྱོགས་བཅུའི་སྤྲིན་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བ་གནོན་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ཀྱི་སྦྱོར་བ་བྱས་ལ།",
    "ཞེས་ཁྲོས་པས་བཟླས་བརྗོད་བྱས་ལ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་སྦྱོར་བ་བྱས་ལ།",
    "ཨཱ་ཧཱུཾ་ཞེས་བྱ་བས་དཔལ་ཧེ་རུ་ཀར་བདག་ཉིད་རྣམ་པར་བསམས་ལ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ནས་རྡོ་རྗེ་ཧཱུཾ་མཛད་དུ་བདག་ཉིད་རྣམ་པར་བསམས་ཏེ།",
    "ཕྱག་རྒྱ་ཐམས་ཅད་བཅིང་བ་ལ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "ཕྱག་རྒྱ་ཐམས་ཅད་རྡོ་རྗེར་བྱ་བ་ལ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "ཐམས་ཅད་ཕྱེ་མར་བྱ་བ་ལ་ནི་རྡོ་རྗེ་བཟང་པོའི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "ཡིད་ཀྱིས་བསྒྲུབ་པར་བྱ་བའི་སྟེང་དུ་བཞག་ནས།",
    "ས་ལ་བཙིར་ཏེ་རྡོ་རྗེ་འབར་བས་བསྒྲུབ་པར་བྱ་བ་ཐ་ལ་བར་བྱས་པར་གྱུར་པར་བསམ་ཞིང་།",
    "ཐམས་ཅད་རྣམ་པར་གཞིག་པ་ལ་ནི་རྡོ་རྗེ་གདུག་པའི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྤྱོར་བ་བྱས་ལ།",
    "གཡོན་དུ་བལྟ་བ་དང་བཅས་པ་ཉིད་ཀྱིས་གཡོན་པའི་ཁུ་ཚུར་མངོན་དུ་ཕྱོགས་པར་བྱས་ཏེ།",
    "གཅིག་ལ་གཅིག་བཙིར་བར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་གདུག་པའི་ཁུ་ཚུར་ཏེ་ཐམས་ཅད་རྣམ་པར་འཇིག་པར་བྱེད་པའོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "ཆུའི་ནང་དུ་གནས་ཤིང་འཆག་པར་བྱ་བ་འདི་ནི་རྡོ་རྗེ་རྣོན་པོའི་ཁུ་ཚུར་ཏེ།",
    "བཟླས་བརྗོད་ནི་ཨ་ལམ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟ་བུས་ནི་གཟུགས་མང་པོ་སྟོན་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "ནམ་མཁའ་ལས་དངོས་པོ་ཐམས་ཅད་བསྐྱེད་པར་བྱ་བ་ནི་རྡོ་རྗེ་ནམ་མཁའི་ཁུ་ཚུར་ཏེ་དངོས་པོ་ཐམས་ཅད་སྐྱེད་པར་བྱེད་པའོ།",
    "རྡོ་རྗེ་སྐས་ཀྱི་གདང་བུ་རྣམ་པར་བསམས་ལ།",
    "རལ་གྲི་འཛིན་པའི་རིག་པ་འཛིན་པར་བདག་ཉིད་བསྒོམས་ན།",
    "བསྒྲུབ་པ་གྲུབ་ནས་རལ་གྲི་འཛིན་པའི་རིག་པ་འཛིན་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་སྦྱོར་བ་བྱས་ལ།",
    "ཐམས་ཅད་མཁྱེན་པའི་དངོས་གྲུབ་ལ་ནི་རྡོ་རྗེ་ཡེ་ཤེས་ཀྱི་ཁུ་ཚུར་གྱིས་སོ་ཞེས་བྱ་བ་ནི།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོབ་པར་འགྱུར་ཏེ།",
    "དེས་ན་འདི་ལ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་འགྲུབ་པར་འགྱུར་རོ།",
    "དེས་དཀྱིལ་འཁོར་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་བཅིངས་ལ་ཨ་ཞེས་བྱ་བས་ལྕེ་ལ་དབབ་པར་བྱས་ན།",
    "ད་ལྟར་བྱུང་བ་ཐམས་ཅད་སྟོན་པར་འགྱུར་རོ།",
    "འདི་བཅིངས་ལ་ཨ་ཞེས་བྱ་བ་ཟློས་ཤིང་རྡོ་རྗེ་སེམས་དཔར་བདག་ཉིད་བསྒོམས་ན་རྡོ་རྗེ་འཛིན་པ་ཉིད་དུ་འགྱུར་རོ།",
    "ད་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་པས་གསང་སྔགས་རྣམ་པར་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདིའི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེའི་རྗེས་ཐོགས་ཉིད་ལ་འཁོར་ལོ་ལྟར་ཡི་གེ་བསྐོར་བ་ཞེས་བྱ་བ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་འདི་གསུངས་སོ།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་དང་།",
    "སོ་སོར་རྟོག་པར་བྱེད་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "གང་རྣམ་པར་མི་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་སྐུ་དང་།",
    "དེ་རྣམས་ལ་སྤྲོས་པ་ནི་རྣམ་པར་རྟོག་པ་རྣམས་སོ།",
    "མིང་དེ་སྐད་ཅེས་བྱ་བ་གསུངས་པའོ།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ནི་དོན་དམ་པར་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་སྟོན་པའོ།",
    "དོན་འདི་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ངོ་བོ་ཉིད་མེད་པའི་ཚུལ་གྱིས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་སྨིན་པའི་སྐུ་དང་།",
    "དེ་རྣམས་ཀྱི་མཚན་མ་ནི་བདག་ལ་སོགས་པར་རྣམ་པར་རྟོག་པའི་བག་ཆགས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པའི་རྒྱུའོ།",
    "དོན་འདི་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་མཚན་མ་མེད་པའི་ཚུལ་གྱིས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་དང་བྲལ་བས་མཚན་མ་མེད་པའོ།",
    "དེ་ཉེ་བར་བཟུང་བ་ནི་རྒྱུར་བྱས་པ་སྟེ།",
    "རྟོག་པ་མེད་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྨོན་པ་མེད་པའི་ཚུལ་གྱིས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྨོན་པར་མི་བྱེད་པས་ན་སྨོན་པ་མེད་པ་སྟེ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "དོན་དམ་པར་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའོ།",
    "མི་བདེན་པ་ཡོངས་སུ་བརྟགས་པ་རྣམས་ནི་དོན་དམ་པར་གདོད་མ་ནས་མ་སྐྱེས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་དག་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་བག་ཆགས་དང་བཅས་པ་དང་བྲལ་བའི་ཡེ་ཤེས་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "དེའི་རྣམ་པར་དག་པ་ནི་དེ་བཞིན་ཉིད་དེ།",
    "རང་བཞིན་གྱིས་འོད་གསལ་བ་རྣམས་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "རང་བཞིན་གྱིས་འོད་གསལ་བར་སྟོན་པར་བྱེད་པའི་རལ་གྲི་བཞི་ཕྱག་བཞིས་ཡོངས་སུ་བཟུང་བས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་འདེབས་ཤིང་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་དང་མཉམ་པའི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་དུ་བསྒོམས་པས་མི་སྣང་བར་བྱས་པ་སྟེ།",
    "གསུངས་སོ་ཞེས་བྱ་བ་ནི་དེ་བཀའ་སྩལ་པ་སྟེ།",
    "དང་པོའི་དཀྱིལ་འཁོར་གྱི་ཚུལ་གྱིས་བཞུགས་སོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ནས་འདུས་པ་མཛད་པ་སྔོན་དུ་འགྲོ་བ་ནས་བརྩམས་ཏེ་གསུམ་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེས་སྤྲོས་པ་མེད་པ་ནི་རྣམ་པར་མི་རྟོག་པ་སྟེ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་དེ་བཞིན་ཉིད་དུ་རོ་གཅིག་པས་རྣམ་པར་མི་རྟོག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་དམིགས་པས་ན་མིང་དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཤིང་མངོན་སུམ་དུ་མཛད་ནས་འཁོར་ལོ་ལྟར་ཡི་གེ་བསྐོར་བ་ཞེས་བྱ་བའི་དཀྱིལ་འཁོར་འདི་གསུངས་པའོ།",
    "ཡང་དག་པར་བྲིས་པའི་འཁོར་ལོའི་ལྟེ་བ་ལ།",
    "ཕྱག་བཞི་དང་རལ་གྲི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་འདེབས་པར་བཞག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་དང་།",
    "གཡས་དང་གཡོན་གྱི་ཕྱག་བཞིས་འདེབས་པར་མཛད་ཅིང་མི་སྣང་བར་མཛད་པར་བཞག་པར་བྱའོ།",
