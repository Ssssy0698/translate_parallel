    "བསམ་པ་ཐམས་ཅད་རྫོགས་པར་གྱིས།",
    "ཚིགས་སུ་བཅད་པ་ལྔ་པས་རྗེས་སུ་གནང་བ་དང་།",
    "ཡང་བདག་ལ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པ་དག་བྱས་ཏེ།",
    "ཅི་འདོད་པར་བཟླས་བརྗོད་ཀྱང་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་ལ་ཕྱག་བྱས་ལ།",
    "འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་ཆོ་ག་ཐམས་ཅད་རྗེས་སུ་སྤྱད་པར་བྱའོ།",
    "སློབ་དཔོན་གྱིས་དངོས་གྲུབ་ཀྱི་ཡེ་ཤེས་བསླབ་པར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྒྲུབ་པ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་སྒྲུབ་པ་རྣམས་ཀྱང་དེ་ལྟར་ཤེས་པར་བྱའོ།",
    "བདག་ལ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པ་བྱས་ནས།",
    "དེ་ནས་ཟླ་བ་ཉ་ལ་བབ་པ་དང་མཚན་ཐོག་ཐག་བཟླས་བརྗོད་བྱས་ན།",
    "སྔོན་དུ་བསྙེན་པ་དེ་བཞིན་དུ་བྱས་ལ།",
    "མཚན་ཐོག་ཐག་བཟླས་བརྗོད་བྱས་ཏེ།",
    "དེ་ནས་མ་བསྒྲུབས་པར་ཞེས་བྱ་བ་ནི་སྔ་མ་དང་འདྲའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོན་པར་བྱེད་པའོ།",
    "དེ་ཐོབ་པ་ནི་མངོན་སུམ་དུ་བྱས་པའོ།",
    "དེ་བཞིན་དུ་སྔོན་དུ་བསྙེན་པ་བྱས་ལ།",
    "དེ་རྣམས་ཀྱི་དོན་ནི་ངོ་བོ་ཉིད་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ཤེས་པ་ནི་ངེས་པར་བྱས་པའོ།",
    "དྲི་མ་མེད་པའི་ནམ་མཁའ་ལ་ལྟ་ཞིང་བཟླས་བརྗོད་བྱའོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདི་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་རྣམས་ཐོབ་པ་ནི་རྙེད་པར་གྱུར་པའོ།",
    "གདུགས་ཆེན་པོ་ཐོབ་པར་བྱ་བ་ལ་ནི་ཞེས་བྱ་བ་ནི།",
    "གདུགས་བཟུང་ནས་བཟླས་བརྗོད་འབུམ་བྱའོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་རྒྱལ་བ་ཆེན་པོ་སྟེ།",
    "ཡ་ལད་བགོས་པར་གྱུར་པ་སྤྲུལ་པ་ལ།",
    "དེ་ལྟ་བུས་ནི་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བ་ཐོབ་པར་འགྱུར་རོ།",
    "གྲགས་པ་ཆེན་པོ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འཇིག་རྟེན་གསུམ་དུ་ཁྱད་པར་ཅན་དུ་གྱུར་ཅིང་།",
    "འཇིག་རྟེན་ཐམས་ཅད་ཡང་དག་པར་བསྲུང་ཞིང་།",
    "ཏྲོཾ་ཧྲི་ཞེས་བཟླས་བརྗོད་བྱས་ཏེ།",
    "ད་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་གཅིག་ཏུ་བྱས་པ་རང་བཞིན་གྱིས་འོད་གསལ་བར་སྒྲུབ་པོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མཚན་ཉིད་ཅན་ནི་རྡོ་རྗེ་ཁུ་ཚུར་བསྒོམས་པས་གྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དོན་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པའི་གཞུང་གསུངས་པ་ཡིན་ཏེ།",
    "དེའི་རྗེས་ཐོགས་ཉིད་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་འདི་གསུངས་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་དེས་པ་དང་།",
    "མིང་དེ་སྐད་ཅེས་བྱ་བའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་འདི་གསུངས་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པའི་ངོ་བོ་ཉིད་དོ།",
    "དེ་རྣམས་འཐོབ་པར་འགྱུར་པ་ནི་རྙེད་པ་སྟེ།",
    "དེའི་དོན་དུ་འཇུག་པར་འགྱུར་ཞིང་།",
    "རྒྱུ་ཉིད་དུ་སྒྲུབ་པར་བྱེད་དོ།",
    "འདིས་ནི་དོན་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ལྕེ་ལ་རྡོ་རྗེ་དཀར་པོ་རྣམ་པར་བསམས་ནས།",
    "དེ་རྣམས་ཐོབ་པ་ལ་འཇུག་པར་འགྱུར་བའོ།",
    "འདིས་ཀྱང་དོན་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "དེའི་དོན་དུ་འཇུག་པར་འགྱུར་བའོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ལྕེ་ལ་རྡོ་རྗེ་དཀར་པོ་རྣམ་པར་བསམས་ལ།",
    "དེའི་དབུས་སུ་བཟླས་པར་བྱ་བའི་རིག་སྔགས་བཀོད་ལ།",
    "འདི་ཉིད་ཀྱིས་དོན་བཞི་པོ་ཉིད་སྟོན་པར་གྱུར་པ་ཡིན་ནོ།",
    "དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་འགྱུར་རོ།",
    "ད་ནི་དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོན་པར་མཛད་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་སྤྲུལ་བར་བྱ་བའི་ཕྱིར།",
    "དེ་རྣམས་ཀྱི་དངོས་གྲུབ་ནི་སྤྲུལ་པ་རྫོགས་པར་འགྱུར་བའོ།",
    "དེའི་དམ་ཚིག་ནི་རྫོགས་པར་བྱེད་པའི་རྒྱུ་སྟེ།",
    "དེ་ནས་འདི་གསུངས་པ་ཙམ་གྱིས།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་བདག་ཉིད་སྐྱེད་པར་བྱེད་པས་མི་ཕྱེད་པར་བྱས་པ་ནི་རྡོ་རྗེ་སེམས་དཔའ་སྟེ།",
    "ཕྱུང་ནས་ཀྱང་དང་པོའི་དཀྱིལ་འཁོར་གྱི་ཚུལ་གྱིས་བཞུགས་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི་དེ་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ཁུ་ཚུར་ཡོངས་སུ་བསྐོར་ནས།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་གྱི་ཚུལ་དུ་བཞུགས་པའོ།",
    "གསུམ་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་གསུམ་གྱི་མཐར་སྙོམས་པར་ཞུགས་པར་མཛད་པའི་རྗེས་ཐོ་གས་ཉིད་ལ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་དམ་ཚིག་ཅེས་བྱ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་འདི་གསུངས་སོ་ཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་ཡང་ཡིན་ལ་ཐམས་ཅད་ཀྱང་ཡིན་པས་ན་ཕྱག་རྒྱ་ཐམས་ཅད་དེ།",
