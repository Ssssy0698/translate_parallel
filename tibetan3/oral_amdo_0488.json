    "ཞེས་པའི་དོན་གོང་གི་དམ་ཚིག་རྣམས་ལ་བྱེད་པ་དང་།",
    "ཕྱོགས་མཚམས་ཀྱི་རྩིབས་ཀྱི་རྩེ་མོ་ལ་ཅུང་ཟད་མ་རེག་པའི་གནས་རྣམས་སུ་སྣ་ཚོགས་པད་ཉིའི་གདན་ཟུང་བརྒྱ་དང་།",
    "གཙོ་བོ་འོད་མའི་སྟེང་གི་སྦུབས་སྟོང་གི་བར་སྣང་དང་འོག་ཏུ་པད་ཉིའི་གདན་ཟུང་རེ་རེ།",
    "རང་གི་སྤྱི་བོའམ་ཞལ་ནས་ཞུགས།",
    "དེ་རྣམས་རེ་རེ་ནས་ཧཱུཾ་རིང་པོ་རེ་རེར་གྱུར།",
    "དེ་རྣམས་ལས་མི་བསྐྱོད་པ་དང་ཁྲོ་བོ་བཅུར་གྱུར་པའི་དབུས་སུ་མི་བསྐྱོད་པ་སྔོ་ནག་ཞལ་གསུམ་ཕྱག་དྲུག་པ་བསམ་པ་རང་གི་རྡོ་རྗེའི་ལམ་ནས་ཐུགས་ཁར་དྲངས།",
    "རང་གི་ཡེ་ཤེས་པ་དང་འདྲེས་ནས་ཚུར་བྱོན་རང་ལ་ཞུགས་པས།",
    "དེ་དང་མཉམ་དུ་ཡུམ་སྔ་མ་རེག་བྱ་རྡོ་རྗེ་མར་བསྒྱུར་བར་བྱ་དགོས་ཏེ།",
    "དེ་ནས་ཁྲོ་བོ་རྣམས་རེ་རེ་ནས་མཚན་སྔགས་བརྗོད་ཅིང་ཐུགས་ཁ་ནས་ཕྱུང་སྟེ།",
    "རང་རང་གི་གདན་ལ་དགོད་པར་བྱ་ཞིང་།",
    "ཁྲོ་བོ་རྣམས་ཕྱིར་ཕྱུང་བའི་ཚེ་བརྒྱད་སྲུང་འཁོར་ལ་ཐོགས་མེད་ཐལ་བྱུང་དུ་སོང་སྟེ་རང་རང་གི་གདན་ལ་ཁ་ལྟ་ཕྱོགས་ནི་ཕྱོགས་མཚམས་ཀྱི་ཁྲོ་བོ་རྣམས་ནང་དུ་ལྟ་བ་དང་།",
    "འོག་གི་གནོད་མཛེས་ནི་ཅུང་ཟད་རྒྱབ་ངོས་ནས་ཞལ་ཤར་དུ་ལྟའོ།",
    "རང་ཞེ་སྡང་རྡོ་རྗེས་འོག་གི་གནོད་མཛེས་ལ་སྤྱན་ཧུར་ཏེ་བལྟས་པས།",
    "གནོད་མཛེས་ཕྱག་གཡས་གཡོན་ལྕགས་ཀྱུ་དང་ཞགས་པ་ཐོགས་པ་བཅུར་གྱུར་ཏེ་ཕྱོགས་བཅུར་སོང་།",
    "ནག་ཕྱོགས་པའི་ཕྱོགས་སྐྱོང་བཅུ་བཟུང་ཞིང་བཅིངས་ནས་བཀུག་སྟེ་ཁྲོ་བོ་བཅུ་ལ་གཏད་པའི་ཚེ་ཁྲོ་བོ་རྣམས་ཞལ་ཕྱིར་གཟིགས།",
    "དེ་མ་ཐག་ཁྲོ་བོ་རྣམས་ཀྱི་ཕྱི་རོལ་གྱི་ཐད་དུ་ཧཱུཾ་རིང་པོ་ལས་བྱུང་བའི་ཁྲོན་པ་འབྲུབ་ཁུང་གི་རྣམ་པ་ཅན་བཅུ་བྱུང་བ་རྣམས་ཀྱི་ནང་དུ་བགེགས་རྣམས་ཁ་ཕྱིར་བསྟན་ཏེ་སོ་སོར་བཅུག་པར་བསམ།",
    "གཙོ་བོས་བྱང་གི་བདུད་རྩི་འཁྱིལ་བ་ལ་གཟིགས་པས།",
    "དེ་ནས་སྟེང་འོག་གི་བར་རིམ་གྱིས་བརྡུང་བའོ།",
    "བཛྲ་དྷཱ་ར་ཨཱ་ཛྙཱ་པ་ཡ་ཏི་ནི་རྡོ་རྗེ་འཆང་གི་བཀའ་ཉོན་ཅིག་པའོ།",
    "སླར་ཡང་ཁྲོ་བོ་དང་ཕུར་བུ་ལས་རྡོ་རྗེའི་མེ་འོད་འཕྲོས་པས་འཁོར་གྱི་བགེགས་རྣམས་འཚིག་ནས་ཕྱོགས་ཕྱོགས་སུ་བྲོས་པར་བསམ་མོ།",
    "གུར་གྱི་འོག་ར་བའི་བར་དུ་རྡོ་རྗེའི་བླ་རེ།",
    "རང་གི་ལུས་ངག་ཡིད་གསུམ་སྲུང་བའི་གོ་ཆ་མཛད་པའོ།",
    "མ་ཟད་པ་རྣམས་འཇིག་རྟེན་གཞན་གྱི་ངན་སོང་དག་ཏུ་ཚེ་འཕོས་པའི་ཚུལ་གྱིས་སྟོང་།",
    "དེའི་རྗེས་སུ་འཛམ་གླིང་གི་མི་ཞིག་གི་རྒྱུད་ལ་བསམ་གཏན་དང་པོའི་ཏིང་ངེ་འཛིན་སྐྱེས་ཏེ་བསམ་གཏན་དང་པོར་ཚེ་འཕོས་པའི་ཚུལ་གྱིས་སྟོང་།",
    "དེ་ལ་བར་བསྐལ་གཅིག་གི་ཡུན་ཡོད་དོ།",
    "གཞན་ཤེས་པ་ལྟ་བུ་ལ་རང་རང་གི་སྐད་ཅིག་སྔ་ཕྱིའི་ཆ་དུ་མ་དང་།",
    "སྣོད་བཅུད་ཐམས་ཅད་འོད་ཀྱི་གོང་བུར་མོས་ནས་རིམ་གྱིས་ཡལ་ཏེ་མཐར་རང་ལ་ཐིམ།",
    "རྟེན་བརྟེན་པ་ཐམས་ཅད་བདེ་སྟོང་གི་རྣམ་རོལ་ཏུ་འཆར་བའི་ཆེད་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་གིས་རྡོ་རྗེའི་ས་གཞི་ར་བ་ཞེས་སོགས་ལྟར་སྲུང་འཁོར་ཐུན་མོང་བ་སྐད་ཅིག་གིས་བསྐྱེད།",
    "དབྱིབས་ཟུར་གསུམ་པ་རྩེ་མོ་ཕྲ་བ་འོག་ཏུ་ཟུག་ཅིང་གདེངས་ཀ་ཆེ་བ་གྱེན་དུ་ཕྱོགས་པ་ཁོག་པ་སྟོང་པ།",
    "རྩེ་མོ་ཕྲ་བས་ལས་དང་པོའི་སྐབས་སུ་ཡོན་ཏན་ཆུང་ཞིང་།",
    "གདངས་ཀ་ཆེ་བས་མོས་སྤྱོད་ནས་བཟུང་སྟེ་ཡར་ཡོན་ཏན་ཇེ་རྒྱས་སུ་སོང་བ།",
    "དཀར་དམར་ཐུན་མོང་བས་བདེ་སྟོང་དབྱེར་མེད།",
    "རྭ་རྩེ་རྣམས་ཆ་ཕྲན་རེ་རེ།",
    "གྲངས་ཕྱོགས་རེ་རེར་ལྔ་ལྔའམ་གསུམ་མ་གང་རུང་དང་།",
    "རྡོ་རྗེའི་ལྟེ་བར་བྷྲུཾ་དཀར་པོ་རྣམ་སྣང་གི་ཚོགས་ར་བའི་ནང་ཐམས་ཅད་དུ་འཕྲོ་བའམ་རིགས་ལྔའི་ཚོགས་འཕྲོ་བ་གང་རུང་།",
    "གཞལ་ཡས་ཁང་གི་ནང་མཐའ་ནས་ནང་མཐའི་བར་སྒོ་ཚད་བརྒྱད།",
    "འོད་འཕྲེང་གི་མཐའ་ནས་མཐའི་བར་སྒོ་ཚད་ཉེར་བཞི་སྟེ།",
    "གཞལ་ཡས་ཁང་གི་རྩིག་པ་རིམ་པ་ལྔ་པོ་ཕྱི་ནང་ལྔ་སྦྲགས་ཏུ་ཡོད་ཅིང་།",
    "སྦུག་གི་གཞུ།",
    "དངུལ་གྱི་གཞུ་རྣམས་བརྩེགས་པའི་སྟེང་དུ་གསེར་གྱི་སྐ་རགས་ལེབ་མོ་ཞེང་ཆ་ཕྲན་གཅིག་པ་བཞི་སྟེང་ནས་སྟེང་དུ་བརྩེགས་པ་བཞི་ཀ་བསྡོམས་པའི་དཔངས་ཆ་ཕྲན་གཉིས།",
    "གཞལ་ཡས་ཁང་གི་རྩ་ཐིག་དང་ཚངས་ཐིག་འཕྲད་མཚམས་ནས་གཡས་གཡོན་དུ་ཆ་ཕྲན་གཉིས་གཉིས་དོར་བས་སྒོ།",
    "དེ་ནས་སྒོ་ཚད་རེ་ཕྱིར་དོར་བས་སྒོ་འཁྱུད།",
    "དེ་ནས་གཡས་གཡོན་དུ་སྒོ་ཚད་རེ་སོང་བ་སྒོ་འགྲམ།",
    "དེ་ནས་ཕྱིར་སྒོ་ཚད་རེ་སོང་བ་སྒོ་ལོགས་ཏེ།",
    "འགྲམ་ལོགས་སྒོ་དང་མཉམ་པ་འདི་ལ་རྩིག་གདོང་ཉིད་རྡོ་རྗེའི་ལྟེ་བ་དང་མཉམ་མོ།",
    "སྒོ་བཞི་སོ་སོའི་རྩ་ཐིག་དང་ཚངས་ཐིག་འཕྲད་མཚམས་ནས་ནང་དུ་སྒོ་ཚད་གཅིག་སོང་བའི་གཡས་གཡོན་དུ་ཆ་ཆུང་ལྔ་ལྔ་སོང་བའི་སར་ཞེང་ཆ་ཕྲན་གཅིག་དང་།",
    "ཕྱོགས་རེ་རེར་གཉིས་གཉིས་ཏེ་བརྒྱད་བཙུགས་པའི་སྟེང་དུ་ཕྱོགས་བཞིར་གདུང་མིག་མངས་རིས་སུ་རྒྱུགས་པ་ལ་ལྕམ་སྣེ་ནང་མ་དང་།",
    "ཐད་ཀར་སྒོ་བཞི་པའི་སྟེང་གི་མཐར་རྡོ་རྗེ་རྩེ་གསུམ་པ་དཔངས་ཆ་ཕྲན་གཅིག་པས་ཟླུམ་པོར་བསྐོར་བའི་རྭའི་འཕྲད་མཚམས་ནས་ཕྱོགས་རེ་རེར་ཀ་བ་སྔར་བཞིན་བཙུགས་པའི་སྟེང་དུ་གཞུ་འཁྱོགས་དང་གདུང་ཟླུམ་གྱིས་འཁོར་མར་བསྐོར་བའི་སྟེང་དུ་གདུང་བཞི་མིག་མངས་རིས་སུ་བྱས་པ།",
    "ལྷོ་བྱང་དུ་རྒྱུགས་པའི་གདུང་གི་ལྷོ་བྱང་མཚམས་སུ་རྩ་བ་ཟུག་པའི་ཀ་བ་བསེགས་ཁ་ཡོད་པ་བཙུགས་པའི་སྟེང་དུ་རྡོ་རྗེའི་གདུང་ལྷོ་བྱང་དུ་རྒྱུགས་པ་ལ་ལྕམ་སྣེ་ནང་དང་།",
    "རྒྱ་ཕིབས་ཀྱི་གུང་གི་དབུས་སུ་རྩ་རྒྱུད་བཞུགས་པའི་ཁང་བུ་རྡོ་རྗེ་ནོར་བུའི་ཏོག་གིས་སྤྲས་པའོ།",
    "སྒོ་བཞིའི་མདུན་དུ་རྩིག་གདོང་དང་རྡོ་རྗེའི་ལྟེ་བ་ནས་ཆ་ཕྲན་གཅིག་སོང་བའི་སར་རྡོ་རྗེའི་རྭ་རྩའི་སྟེང་དུ་སྟེགས་བུ་གྲུ་བཞི་བུམ་པ་དང་བཅས་པ་ལ་གནས་པའི་ཀ་བ་ཞེང་ཆ་ཕྲན་གཅིག།",
    "གཡས་གཡོན་དུ་གཉིས་ཆེ་སྟེ་བཞི་བཞི་བཙུགས་པའི་སྟེང་དུ་སྣམ་བུ་བཅུ་གཅིག་སྣམ་བུ་ལྔ་པ་དང་བདུན་པའི་དཔངས་ལ་ཆ་ཕྲན་ཕྱེད་དང་གཉིས་རེ་དང་།",
    "གཞན་རྣམས་ཀྱི་དཔངས་སུ་ཆ་ཕྲན་རེ་རེ་བར་མཉམ་མོ།",
    "གཞལ་ཡས་ཁང་གི་མཚན་ཉིད་གཞན་ཇི་ལྟ་བུ་ཡིན་ཚུལ་རྒྱས་པར་གཞན་དུ་ཤེས་པར་བྱའོ།",
    "གཞལ་ཡས་ཁང་གིས་རྣམ་སྣང་དག་པ་མཚོན།",
    "བྷྲུཾ་རྣམ་སྣང་གི་ས་བོན་ཡིན་ཞིང་།",
    "ལྷག་མོས་ཀྱི་ལྷ་བསྐྱེད་པ།",
    "སྐད་ཅིག་གིས་ལྷག་པར་མོས་པ་ཙམ་གྱིས་ལྷ་སུམ་ཅུ་རྩ་གཉིས་དུས་གཅིག་ཏུ་ཡོངས་སུ་གྱུར་པ་ནི་ཞེས་སོགས་གསུངས་པ་ལྟར།",
    "དུས་གཅིག་ཏུ་སྐད་ཅིག་གིས་བསྐྱེད་ནས་རྣམ་པ་རྣམས་རིམ་གྱིས་གསལ་འདེབས་པ་ཡིན་ལ།",
    "གར་བུའི་ནང་དུ་གནོད་མཛེས་ཞལ་ཤར་གཟིགས།",
    "ལྷ་མོ་དགུ་ཞི་ཁྲོ་ཕྱེད་མ།",
    "གཉིས་པ་ལྷག་མོས་ཀྱི་མཛད་པ་ནི།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ།",
    "འོན་ཀྱང་ངན་སོང་བ་ཐམས་ཅད་ཀྱི་རྣམ་པར་མོས་པ་མི་བདེ་ན་མིའི་རྣམ་པའམ།",
    "ཡང་ན་སྤྱི་ཙམ་གྱི་རྣམ་པར་མོས་ཆོག་གམ་སྙམ་མོ།",
    "ཤར་ཕྱོགས་པ་རྣམས་ཤར་ཕྱོགས་སུ་རྣམ་སྣང་གི་ཞིང་དུ་གཤེགས་པར་མོས་པ་འདྲ་སྟེ།",
    "གསུམ་པ་ལྷག་མོས་ལུས་ལ་བསྡུ་བ་ནི།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་སྔོན་པོའི་འོད་ཟེར་ལྕགས་ཀྱུའི་རྣམ་པ་ཅན་གྱིས་ཞེས་སོགས་གསུངས་པ་ལྟར་ཡིན་ལ།",
    "དེ་ཡང་རང་གཙོ་བོར་གསལ་བའི་ཧཱུཾ་ཡིག་གི་ནཱ་ད་ལས་འོད་ཟེར་ལྷ་གྲངས་དང་མཉམ་པ་འདིར་སོ་གཅིག་སྤྲོས་ཏེ།",
    "རྣམ་སྣང་རང་གི་སྤྱི་བོར་ཞལ་ཤར་དུ་གཟིགས་པ།",
    "གསང་གནས་རྣམས་སུ་འོད་དཔག་མེད་སོགས་འོག་མ་སྟེང་མ་ལ་མ་རེག་ཙམ།",
    "བྱམས་པ་རྣམ་སྣང་གི་རྒྱབ་ནས་ཞལ་རྣམ་སྣང་ལ་གཟིགས་པ།",
    "གཙོ་བོའི་ཡུམ་རེག་བྱ་རྡོ་རྗེ་མ་སྤྱན་དྲངས་ནས་སྒྲིབ་སེལ་ལ་འཁྱུད་པའི་ཚེ་གཙོ་བོ་ཡབ་རྐྱང་ཡིན་ནོ།",
    "དབྱུག་སྔོན་ཅན་དང་སྟོབས་པོ་ཆེ་གཉིས་པུས་མོའི་ལྷ་ངའི་ནང་།",
    "སྤྱི་བོའི་སྒྲོལ་མའི་སྟེང་གཙུག་ཏོར་འཁོར་ལོས་བསྒྱུར་བ་ཞལ་ནུབ་ཏུ་ཕྱོགས་པར་གནམ་དུ་གཟིགས་པ།",
    "དཔེ་དོན་གྱི་འོད་གསལ་གྱི་རྒྱུད་སྨིན་བྱེད་ལྷག་མོས་འོད་གསལ་དུ་སྡུད་པའི་གཞི་འདིང་བ་དང་།",
    "དེ་ལྟར་ཡིན་ཀྱང་འདིར་མཚོན་དོན་ཁྱད་པར་ཅན་བསྒྲིག་པའི་ཆེད་དུ་མངོན་བྱང་ལྔའི་སྒོ་ནས་བསྐྱེད་པ་ཡིན་པས་སྔར་གྱི་གདན་དབུས་མ་ཉི་གདན་གྱི་སྟེང་དུ་འོད་གསལ་ལས་རང་གི་སེམས་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་དེ་ཉིད།",
    "རང་དང་པོའི་མགོན་པོར་གསལ་བའི་ཐུགས་ཀའི་ཧཱུཾ་གི་འོད་ཟེར་གྱི་སྣེ་ལས་ཡབ་ཡུམ་སྤྲོས་ཏེ་གདུང་ཟླུམ་གྱི་སྟེང་དུ་བཞུགས་པ་དང་།",
    "དེའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མི་བསྐྱོད་པ་ཡབ་ཡུམ་གྱི་རྣམ་པར་སྟེང་གི་རེའུ་མིག་གི་ནམ་མཁའ་གང་བར་བཤད།",
    "གཞུང་ཆེ་བ་འགའ་ཞིག་ནས་མི་བསྐྱོད་པ་རང་གི་མདུན་དུ་སླེབ་པ་ན།",
    "མི་བསྐྱོད་པས་ནམ་མཁའ་ཁྱབ་པ་ནི་གཞི་ལ་ཕ་མའི་ཁུ་ཁྲག་གིས་རྩ་སྟོང་ཕྲག་དོན་གཉིས་ཀྱི་ནང་གང་བ་དེ་མཚོན།",
    "སེམས་དཔའ་དྲུག་གིས་མིག་སོགས།",
    "དེ་ཡང་ལུས་ཀྱི་ཆ་དེ་དང་དེ་རྣམས་ལས་རིགས་འདྲ་རེ་ཆད་དེ་འོད་ཀྱི་རྣམ་པར་གྱུར་ཏེ་ཕྱི་དཀྱིལ་གྱི་ཆ་དེ་དང་དེ་ལ་ཐིམ་པས་རང་གི་ལུས་ཀྱི་ཆ་དེ་དང་དེས་ཉེར་ལེན་དང་དཀྱིལ་གྱི་ཆ་དེ་དང་དེས་ལྷན་ཅིག་བྱེད་རྐྱེན་བྱས་ནས་ལུས་དཀྱིལ་གྱི་གཞལ་ཡས་ཁང་དེ་དང་དེར་གྱུར་པར་བསམ།",
    "དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་སྐབས་སུ་ལྷ་བཀོད་ཟིན་པའི་ཚེ་ལུས་རྟེན་གྱི་དཀྱིལ་འཁོར་དུ་གྱུར་པའི་ཆ་མ་བསྡུས་པས་དེ་ལ་ལུས་དཀྱིལ་གྱི་ཐ་སྙད་བྱེད་མི་བྱེད་ཀྱི་བརྒལ་བརྟག་མང་ཡང་མི་བརྗོད་དེ།",
    "འཁྲིད་ཡིག་འགའ་ཞིག་ནས་རང་གི་ལུས་ཀྱི་དབུས་ནས་བགོས་པའི་ཆ་བཞི།",
    "ལུས་དཀྱིལ་དུ་རུང་སྙམ་སྟེ་བརྟགལུས་ཀྱི་ཆ་དེ་དང་དེ་རྣམས་གཞལ་ཡས་ཁང་གི་ཆ་དེ་དང་དེར་གྱུར་པ་ན་ལྷག་མ་ལུས་པ་མི་འགྱུར་རམ་སྙམ་དུ་དོགས་མི་དགོས་སོ།",
    "རང་གི་སྤྱི་གཙུག་ནས་སྐྲ་མཚམས་ཀྱི་བར་དུ་གཟུགས་ཀྱི་ཕུང་པོའི་ངོ་བོ་ཨོཾ་དཀར་པོ་ཞིག་ཏུ་བསམ།",
    "སྤྱི་བོ་ན་གཟུགས་ཕུང་གི་རྒྱུའི་གཙོ་བོ་བྱང་སེམས་ཡོད་པ་དང་།",
    "ཚོར་བ་ལུས་སེམས་ཀྱི་ཆ་རྣམས་ལ་ཡོད་ཀྱང་ཚོར་བའི་རྟེན་གཏུམ་མོ་ལྟེ་བར་ཡོད་པ་དང་།",
    "རང་གི་སྤྱི་བོར་ཨོཾ་ལས་བྱུང་བ་དང་ལྕེའི་དབུས་སུ་ཨཱ་ལས་བྱུང་བའི་ཞེས་པ་ཙམ་ལས་མི་གསལ་ཡང་།",
    "ཡི་གེ་དེ་གསུམ་ལས་རིམ་པ་བཞིན་དུ་འཁོར་ལོ་པདྨ་ཉི་མ་རེ་རེ་བསྐྱེད་པའི་སྟེང་རིམ་པ་བཞིན་དུ་ཨོཾ་ཨཱ་ཧཱུཾ་བཀོད་དེ།",
    "དེ་རྣམས་ལ་འོད་ཟེར་འཕྲོས་པའི་སྣེ་མོ་ལས་སྤྱན་སོགས་དཔག་ཏུ་མེད་པ་སྤྲོས།",
    "དེ་ཡང་རྣམ་སྣང་ལྟ་བུ་ཆེ་བ་རེ་རེ་དབུས་ན་ཡོད་པའི་མཐར་རྣམ་སྣང་ཡབ་ཡུམ་དཔག་ཏུ་མེད་པས་བསྐོར་བར་བསམ་པ་ཡིན་ལ།",
    "གཞན་སླ་ཞིང་དཔལ་དང་ལྡན་པའི་དོན་ནི་རང་གི་ཡུམ་སྤྱན་སོགས་དང་ལྡན་པ་དང་།",
    "རྡོར་སེམས་ཀྱི་སྤྱི་བོར་སླེབ་པ་ན་ཆ་གཉིས་སུ་སོང་།",
    "གསུང་གི་སྐབས་སུ་རང་གི་མགྲིན་པར་སླེབ་པ་ན་གཉིས་སུ་གྱུར་ཏེ་ཆ་གཅིག་འོད་དཔག་མེད་དང་།",
    "སྒྲུབ་ཐབས་ཀྱི་ཚིག་ཟིན་ལྟར་གཞུང་ཆེ་བ་ཕལ་ཆེར་ལས་དང་པོའི་ཚེ་རང་གི་སྤྱི་བོ་དང་།",
    "མཐར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་གསུམ་གྱི་བདག་ཉིད་དེ་ངའོ་སྙམ་དུ་ཟུང་འཇུག་གི་ང་རྒྱལ་བྱའོ།",
    "ཐུན་མོང་དུ་བྱིན་བརླབ་བྱ་བའི་ཚེ།",
    "རིགས་བདག་གིས་རྒྱས་གདབ་པའི་ཚེ།",
    "དེ་ཡང་དམིགས་སྐོར་རྒྱས་བསྡུས་སུ་སྣང་གི་ངེས་པར་དགོས་པའི་ཡན་ལག་ཏུ་མི་སྣང་ངོ།",
    "དེ་ཡང་སྐུ་གསུམ་གོ་འཕང་བདེ་ཆེན་གྱི་ལམ་གྱིས་ཐོབ་པར་བསྟན་པའི་ཕྱིར་སྔོན་རྡོ་རྗེ་འཆང་གིས་ལྷ་མོ་སྤྲུལ་ཏེ་སྙོམས་པར་འཇུག་པའི་ཚུལ་བསྟན་པ་ལྟར།",
    "དེ་ཞུ་བ་ལས་རྡོ་རྗེ་ཁཾ་གིས་མཚན་པ་དང་།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་རེག་བྱ་རྡོ་རྗེ་མར་སྒྲུབ་ཐབས་ལྟར་བསྐྱེད་དེ།",
    "གང་དུ་ཇི་ལྟར་བཞུགས་པ་ནི་གོང་གི་དེས་ཤེས།",
    "འོན་ཀྱང་རལ་གཅིག་མ་ནི་ཡུམ་གྱི་བྱ་རོག་གདོང་གི་བུ་གའི་ནང་ཙམ་རྩ་འཁོར་ཡོད་པ་དེར་འགོད།",
    "རིན་འབྱུང་གི་ང་རྒྱལ་གྱིས་ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་སོགས་བརྗོད་དེ་སྙོམས་འཇུག་གི་སྦྱོར་བ་བརྩམས་ཤིང་།",
    "སྙོམས་འཇུག་དངོས་གཞིའི་ཚེ་རྡོ་རྗེ་འཆང་གི་ང་རྒྱལ་དུ་འཕོ།",
    "རྟེན་བརྟེན་པ་ཐམས་ཅད་བདེ་སྟོང་གི་རྣམ་རོལ་ཏུ་འཆར་བ་དང་།",
    "ཆ་གཅིག་གདན་དེ་རྣམས་ཀྱི་སྟེང་དུ་རེ་མིག་གི་དབུས་ནས་གཟུང་སྟེ་ཐིག་ལེ་སོ་གཉིས་སུ་གྱུར།",
    "ཁྲོ་བོ་བཅུའི་གནས་སུ་ཧཱུཾ་རེ་རེར་གྱུར་པར་བསམ་ཞིང་།",
    "དེ་རྣམས་ཡོངས་སུ་གྱུར་པ་ལས་དབུས་སུ་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཧཱུཾ་དང་ཁཾ་གིས་མཚན་པ་གཉིས།",
    "དེ་བཞིན་དུ་ལྷ་རང་རང་གི་ས་བོན་གྱི་ཕྱག་མཚན་རེ་རེ།",
    "མི་བསྐྱོད་པ་རང་གི་ཐུགས་ཁར་དྲངས།",
    "བཛྲ་དྷྲིཀ་ཐུགས་གནས་ཕྱིར་ཕྱུང་ཞེས་སོགས་རང་རང་གི་མཚན་སྔགས་བརྗོད་དེ་བོས་པ་ལྟར་རེ་རེ་ནས་ཐུགས་ཀར་དྲངས།",
    "སྔར་གྱི་མངོན་བྱང་ལྔའི་སྐབས་ཀྱི་ཟླ་བའི་རྒྱུན་གྱི་ཟླ་བ་དེ་ཉིད་རང་གི་འོག་གི་ཉི་གདན་ལ་ཐིམ།",
    "རེག་བྱ་རྡོ་རྗེ་མ་བྱོན་ནས་རང་གི་ཡུམ་རེག་བྱ་རྡོ་རྗེ་མ་ལ་ཐིམ་པས་དབྱེར་མེད་དུ་གྱུར།",
    "མི་བསྐྱོད་པ་གཙོ་བོར་སོང་བའི་ཚེ་དེ་ལྟར་ཡིན་གྱི།",
    "གཞན་རེག་བྱ་རྡོ་རྗེ་མ་གཙོ་བོར་སོང་བའི་ཚེ།",
    "མི་བསྐྱོད་པས་རེག་བྱ་རྡོ་རྗེ་མ་ལ་འཁྱུད་པ་དང་།",
    "རྣམ་སྣང་སོགས་བཞི་གཙོ་བོར་སོང་བའི་ཚེ་སྤྱན་སོགས་བཞིས་འཁྱུད་པ་དང་།",
    "ཡུམ་བཞི་གཙོ་བོར་སོང་བའི་ཚེ་ཡབ་བཞིས་འཁྱུད་པ་དང་།",
    "མོ་ཧ་ར་ཏི་སོགས་བཞི་ནི་གཏི་མུག་དགའ་མ་ཞེ་སྡང་དགའ་མ་འོད་དཔག་མེད་དམ་འདོད་ཆགས་དགའ་མ་རྡོ་རྗེ་དོན་གྲུབ་དགའ་མ་སྟེ་རིགས་བཞིའི་ཡུམ་ཡིན་པའི་དོན་ནོ།",
    "རཱུ་པ་བཛྲ་ནི་གཟུགས་རྡོ་རྗེ་མ་ཞེས་པ་སྟེ་གཞན་རྣམས་རང་རང་གི་མཚན་སྔགས་ཡིན་ལ།",
    "དེ་བརྗོད་ཅིང་ལྟེ་རེ་རེ་ནས་ཕྱུང་སྟེ་རང་རང་གི་གདན་ལ་འགོད་དོ།",
    "གཉིས་པ་བཟླས་པ་ལ་སྤྱིར་དམ་ཚིག་གི་བཟླས་པ།",
