    "རང་གི་མཛའ་བ་སྟེ་གཉེན་ཉེ་དང་།",
    "མི་མཛའ་བའི་དགྲ་དང་གནོད་བྱེད་དེ་རྣམས་ཐམས་ཅད་ལ་གནོད་པ་བྱེད་དུ་རེ་ནས་ཞེ་སྡང་དང་ཕྲག་དོག།",
    "དོན་ངོ་མ་ལ་མི་མཛའ་བའི་གནོད་བྱེད་དགྲ་འདྲེའི་རིགས་དེ་རྣམས་ཐམས་ཅད་ཀྱང་ཤི་སྟེ་འཆི་བདག་གིས་བསད་ནས་མེད་པར་འགྱུར་ཞིང་།",
    "མཛའ་བ་གཉེན་ཉེ་དུ་ནང་མི་གྲོགས་པོ་དེ་དག་ཐམས་ཅད་ཀྱང་འཆི་བདག་གིས་བསད་དེ་ཤི་ནས་ཐམས་ཅད་མེད་པ་ཉིད་དུ་འགྱུར།",
    "ད་ལྟའི་ཚེ་འདི་ཉིད་ཀྱི་ཚེ་སྟོད་ལ་དངོས་པོ་གང་དང་གང་སྤྱད་པ་དེ་རང་གི་གཉེན་ཉེ་དུ་ཕ་ཚོ་སྤུན་གྲོགས།",
    "དེ་འདྲའི་དངོས་པོ་གང་དང་གང་སྤྱད་པ་དེ་དག་ཐམས་ཅད་ནི་ད་ལྟ་ཡང་བསམ་བློ་གཏོང་ན་ཅུང་ཟད་རེ་དྲན་པ་མ་གཏོགས་ཡོད་པ་མ་ཡིན།",
    "རེ་ཞིག་གསོན་ཚེ་འདི་ཉིད་ལའང་།",
    "རེ་ཞིག་སྟེ་དང་པོ་ད་ལྟ་རང་ཉིད་གསོན་པར་གནས་པའི་ཚེ་འདི་ཉིད་ཀྱི་ཚེ་སྟོད་ལའང་མཛའ་བ་དང་མི་མཛའ་བ་དུ་མ་འདས་ཞེས་པ་སྟེ།",
    "མཛའ་བ་སྟེ་རང་གི་ཕ་ཚོ་སྤུན་གྲོགས་ཀྱི་དགའ་མཛའ་ཉེ་དུ་ལ་སོགས་པ་དེ་འདྲ་རང་དང་ལོ་ཚོད་མཉམ་པའམ་ཅུང་ཟད་མཐོ་དམའ་ཡོད་པ་དེ་འདྲ་དུ་མ་མང་པོ་སྟེ་ཤི་ཟིན་ནས་འདས་ཟིན་པ།",
    "བདག་གིས་རྟོགས་པར་མ་གྱུར་པས།",
    "གཏི་མུག་ཆགས་དང་ཞེ་སྡང་གིས།",
    "རང་ཕྱོགས་ལ་ཆགས་པ་དང་གཞན་ཕྱོགས་ལ་སྡང་བའི་ཞེ་སྡང་གིས་སྲོག་གཅོད་པ་དང་།",
    "དེ་ཡང་ཉིན་གཅིག་གམ་མཚན་མོ་གཅིག་ལྟ་བུ་ཚེ་འདི་ཟད་པ་མེད་པར་སྡོད་པ་འགྱུར་བ་ནི་ངེས་པ་ཅན་དུ་མེད་པར།",
    "བདག་རང་ཉིད་ནི་ཚེ་ཟད་དེ་འཆི་ཁར་མལ་དེ་ན་འདུག་བཞིན་དུ་རང་གི་གཉེན་ཉེ་དུ་སྤུ་མཆེད་གྲོགས་པོ་ལ་སོགས་པ་བཤེས་དེ་རྣམས་ཀུན་འདུས་ནས་རང་གི་མལ་སའི་མཐའ་ནས་བསྐོར་ཏེ་མིག་གིས་བལྟས་ནས་སྡོད་ཡོད་ཀྱང་།",
    "གཉེན་ཉེ་གྲོགས་པོ་དེ་རྣམས་མང་པོ་ཡོད་ན་ཡང་ཁོ་ཚོས་བགོ་གཤའ་བྱས་ནས་རང་གིས་མྱོང་མི་དགོས་པ་ལྟ་བུ་དེ་འདྲ་ནི་གང་ཡང་མེད།",
    "དེ་ཡང་བདག་གིས་མ་བསྟེན་ཏོ།",
    "འཆི་རན་པའི་གནས་སྐབས་ན་གཤིན་རྗེའི་ཕོ་ཉ་སྟེ་ལས་མཁན་སྟག་གཟིག་དོམ་དྲེད་ལ་སོགས་པའི་མགོ་བརྙན་ཅན་ཤིན་ཏུ་འཇིགས་ཤིང་ཡ་ང་བར་གྱུར་པ་དེ་རྣམས་ཀྱིས་གཤིན་རྗེའི་ཞགས་པ་དང་།",
    "དེ་ཡང་ཚེ་འདི་ཉིད་ལ་བདག་གིས་རྒྱུད་ན་ཚུལ་བཞིན་དུ་མ་བསྟེན་ཏོ་ཞེས།",
    "བསྟེན་མ་ཤེས་པའི་སྒོ་ནས་མི་ཚེ་ཟད་སོང་དུས།",
    "མགོན་པོ་བག་མེད་བདག་གིས་ནི།",
    "ད་ལྟ་གཤེད་མ་རྣམས་ཀྱིས་ལྕགས་སྒྲོག་དང་ཐག་སྒྲོག་གིས་བསྡམས་ནས་བརྙས་བཅོས་བྱས་ནས་ཡན་ལག་གཅད་སར་ཁྲིད་འགྲོ་བའི་གནས་སྐབས་ན།",
    "ལག་ན་མཚོན་ཆ་སྟ་རེ་དང་རལ་གྲི་སོགས་མེ་འབར་བའི་རང་བཞིན་ཅན་དང་།",
    "ཤར་ལ་སོགས་པའི་ཕྱོགས་བཞིར་ང་རང་ལ་སྐྱབས་དང་མགོན་བྱེད་མཁན་ཨེ་ཡོད་ན་བསམས་ནས་སྐྱབས་དག་འཚོལ་བའམ་རེ་བ་བྱེད་བཞིན་པ་ལ།",
    "དེ་ཚེ་བདག་གིས་ཇི་ལྟར་བྱ།",
    "དུས་དེའི་ཚེ་ན་བདག་རང་གིས་ཇི་ལྟར་བྱ་སྟེ་བྱ་ཐབས་དང་བྲལ་བ་ཡིན་པས།",
    "བདག་གི་ལུས་འདི་དབུལ་བར་བགྱི།",
    "སྤྱན་རས་གཟིགས་མགོན་དེ་ལ་ཡང་།",
    "དེ་གཅིག་གིས་ཀྱང་འཛམ་གླིང་ན།",
    "བར་གྱི་བསྐལ་པ་གཅིག་ལ་སོགས་པའི་བར་དུ་ཚ་གྲང་གི་སྡུག་བསྔལ་དྲག་པོ་མྱོང་དགོས་པའི་གཡང་ས་དེ་ཉིད་ལ་ལྷུང་བའི་དོགས་པ་བྱས་ནས་དགེ་སྒྲུབ་སྡིག་སྤོང་གི་ལས་ལ་ཡང་ནས་ཡང་དུ་འབད་པར་བྱ་དགོས་པའམ་བག་ཡོད་པའི་སྒོ་ནས་གནས་པར་བྱ་དགོས་པ་ནི་ལྟ་སྨོས་ཀྱང་ཅི་ཞིག་དགོས་ཞེས་པའོ།",
    "དེས་ན་བདག་རང་ཉིད་ལ་དེ་རིང་ཙམ་དུ་ཁྱོད་འཆི་མི་ཡོང་ཞེས་པ་ལྟ་བུའམ།",
    "དེར་ཇི་ལྟ་བ་བཞིན་རང་གི་གཉེན་ཉེ་དུ་ཕ་མ་སྤུན་སྲིང་ལ་སོགས་པ་དང་།",
    "ཉིན་མཚན་རྟག་ཏུ་བདག་གིས་ནི།",
    "དྲན་རྒྱུ་བསམ་རྒྱུ་གཞན་མེད་པར་འདི་ཉིད་འབའ་ཞིག་བསམ་པའི་རིགས་ཞེས་པ་སྟེ་ཉོན་མོངས་པ་ཆགས་སོགས་དང་།",
    "ཐལ་སྦྱར་སྡུག་བསྔལ་འཇིགས་སེམས་ཀྱིས།",
    "དེ་རྣམས་ཀྱི་སྤྱན་སྔར་རང་ཉིད་མངོན་སུམ་དུ་འདུག་པར་མོས་ཏེ་ལུས་ཀྱི་ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་ནས།",
    "འདྲེན་པ་རྣམས་ཀྱིས་བདག་གི་སྡིག།",
    "ཕྲག་དོག་གི་གཉེན་པོ་ལ་རྗེས་སུ་ཡི་རང་བའི་ཡན་ལག།",
    "ཐལ་མོ་སྦྱར་ཏེ་གསོལ་བ་ནི།",
    "ངག་གི་སྒོ་ནས་གསོལ་བ་འདེབས་པ་ནི།",
    "ཐལ་མོ་སྦྱར་ཏེ་གསོལ་བ་ནི།",
    "སྔོན་བདག་ཅག་གི་སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་སྐུ་ཚེ་དགུང་ལོ་བརྒྱད་ཅུ་ཟིན་པའི་དུས་སུ་སྐུ་མྱ་ངན་ལས་འདའ་བའི་ཐུགས་བཞེད་གནང་བ་ན།",
    "བཏུང་བར་བྱ་བའི་སྐོམ་གྱི་རང་བཞིན་དུ་གྱུར་ཏེ་དེ་དག་གི་མདུན་ན་ཆར་ཕབ་སྟེ་བཀྲེས་པ་དང་སྐོམ་པའི་གནོད་པའམ་སྡུག་བསྔལ་དེ་དག་ཐམས་ཅད་བསལ་བར་ཤོག་ཅིག།",
    "དེ་དག་གི་མདུན་དུ་བཟའ་བར་བྱ་བའི་ཟས་དང་།",
    "ཁོ་ཚོ་ལ་དགོས་པའི་ཡོ་བྱད་མཁོ་དགུ་རྣམ་པ་སྣ་ཚོགས་པ་ཅི་མོས་གང་མོས་སུ་མདུན་ན་ཉེ་བར་གནས་པར་ཡང་གྱུར་ཅིག།",
    "དེ་བཞིན་དུ་ལོངས་སྤྱད་པར་བྱ་བའི་ཟས་གོས་གནས་མལ་དང་ཡོ་བྱད་ཀྱི་དངོས་པོ་གང་དང་གང་གི་ལོངས་སྤྱོད་ཇི་སྙེད་ཅིག་ཡོད་པར་གྱུར་པ་དེ་རྣམས་དང་།",
