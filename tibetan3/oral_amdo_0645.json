    "གནས་དེར་སྐབས་རེར་སྡོད་པའི་དགེ་སློང་ཞིག་ཡོད་པས་བསང་ཞིག་རྩོམས་ཟེར་བ་དེ་ལྟར་བྲིས།",
    "ལྗོན་ཤིང་གི་ནགས་མེ་ཏོག་གིས་བཀྲ་བ་མཐོང་ནས་དབེན་པ་ཁོ་ན་དྲན་པས་ཚུགས་ཐབས་མེད་པ་ལྟ་བུ་བྱུང་།",
    "དེ་སྐོར་རང་གི་བྲག་ཕུག་ཅིག་ཏུ་སྒྲུབ་པ་ལ་སེམས་བྲེལ་བ་ལངས་ནས་ཡོད།",
    "གནས་ཉམས་དགའ་རྨོས་ལེགས་འབྲུ་ཞིང་གི་དབུས་སུ།",
    "ཤིང་ལྗོན་པའི་བསིལ་ཡབ་མཉེན་ལྕུག་གིས་གཡོབ་ཅིང་།",
    "ཡིད་མཐུན་པའི་ཕ་མ་སྤུན་སྲིང་གིས་བསྐོར་ཞིང་།",
    "གྲོགས་རི་དྭགས་ཕོ་མོ་བྱེའུ་དང་གཅན་གཟན།",
    "སེམས་རེ་དོགས་མེད་ལ་བུ་ཆུང་ང་སྨོན་ཤོར།",
    "གསེར་དངུལ་དང་ནོར་ཕྱུགས་རྟ་གླང་གི་སོ་ཚིས།",
    "ཚོང་སོ་ནམ་རྒྱུ་ལ་ཡིད་སྨོན་དང་བྲལ་སོང་།",
    "ཤ་ཁྲག་དང་ཆང་སོགས་ཞིམ་ཟས་ལ་མི་རེ།",
    "མཁར་ཁང་བུ་བརྩེགས་པའི་གཟིམ་ཆུང་གི་སྦུག་ན།",
    "བརྒྱ་བཤིག་སྟེ་སྟོང་འགུགས་བླ་ཆེན་ལ་མི་རེ།",
    "བྲག་སྤྱོད་ལམ་བཞི་ཤོང་རང་བྱུང་གི་ཁང་མཛེས།",
    "ལས་མཐའ་རུ་ལོག་པའི་བསོག་འཇོག་ལ་མི་རེ།",
    "ཡང་སྐབས་ཤིག་ཕ་མ་དང་སྤུན་ཟླ་ནང་མི་ལ་འཕྲིན་འདི་འདྲ་ཞིག་བཞག་ནས་རི་ཁྲོད་དུ་སོང་ན་བསམས་ཏེ་བྲིས་པ།",
    "ཆུང་ནས་ད་བར་བྱམས་སྡུག་གི་སྐྱོང་བཞིན།",
    "འཁོར་གཡོག་མི་དགོས་ཆགས་སྡང་གི་ཉེ་འཁོན།",
    "རེ་ཞིག་བུ་ཆུང་རི་སུལ་དུ་ཡིབ་ཀྱང་།",
    "མེ་ལྟར་འབར་བས་དགོན་ཁོག་གི་མགོ་འཛིན།",
    "འོན་ཀྱང་ད་ལྟ་ལོ་ཆུང་སྐབས་ཁ་ཕོ་མ་སྒྲོགས་མ་གཏོགས་སྒྲུབ་མཐར་མ་འཁྱོལ་ན་དེ་ལས་ངོ་ཚ་བ་མེད་པས་རིང་པོར་མི་ཐོག་པར་རང་གཉིས་དབེན་པར་འགྲོ་ཆོག།",
    "ཕ་མ་ལ་ཡང་སེམས་མི་བབ་པ་ཡོད་མ་རེད་པས་ཁྱེད་མ་འགྲོ་ཟེར་མི་འོང་ཟེར་བས་བློ་བདེ་བར་བྱུང་།",
    "ཞོགས་པར་རཏ་གླིང་ཚེ་སྒྲུབ་ཡང་གསང་གུད་སྦས་ཀྱི་བསྙེན་པ་སྟོང་རྩ་རེ་དང་།",
    "ཡིད་འོང་བའི་ཕུག་པ་ཟུང་གིས་མཚན།",
    "མཚམས་རྣམས་སུ་རྩྭ་ཤིང་ཕང་ཕུང་ཚོགས།",
    "ཤར་ཉི་ཟླའི་སྒྲོན་མེ་མདངས་རེ་གསལ།",
    "ཕ་མ་ཡང་མཚམས་མཚམས་སུ་འོང་བ་ལ་དེ་ཚུལ་སྨྲས་སོང་བས།",
    "ཉིན་རེར་ཤ་དུས་རེ་ལས་མི་ཟ་བའི་དམ་བཅའ་བཟུང་།",
    "ཞིང་གི་ལོ་ཏོག་སད་ཀྱིས་ཁྱེར་བ་དང་།",
    "སྙན་ངག་གི་བརྗོད་པའང་བཟང་དུ་སོང་བ་བྱུང་།",
    "དཔལ་བྱ་བཏང་གི་རྒྱལ་པོའི་ཚུལ་བསྟན་པ།",
    "དགྲ་འཆི་བདག་གི་ཇག་པས་བརླག་སྙམ་པའི།",
    "གནས་ངན་སོང་གཡང་ས་གཏིང་རིང་ཞིང་།",
    "འཆི་བདག་གི་འཇིགས་པ་སྲུང་མི་ནུས།",
    "གཟུགས་ལང་ཚོའི་ཉམས་འགྱུར་ཡིད་དགའ་ཡང་།",
    "ལུས་གྲང་ན་གཏུམ་མོ་གོས་སུ་གྱོན།",
    "མིས་བཟོ་བཅོས་མ་བྱས་བྲག་གི་ཕུག།",
    "སྐབས་རེས་འགའ་སྤྲིན་དང་ན་བུན་ལྡང་།",
    "སྔར་མྱོང་ཚད་ཆུ་ཡི་རི་མོ་འདྲ།",
    "དུས་མ་འོངས་རེ་དོགས་སོ་ཚིས་ཀྱིས།",
    "དགྲ་འཆི་བདག་ཞགས་པ་ཐེབས་པའི་མོད།",
    "རྡོའི་རི་མོ་བཞིན་དུ་བརྟན་པ་ཡིས།",
    "འདི་དག་གི་ཚེ་སྤྱིར་སྔ་འགྱུར་གྱི་རིག་འཛིན་ཕལ་མོ་ཆེ།",
    "བདག་གི་རྣམ་འདྲེན་ཆེན་པོ་རྣམས་དབེན་པར་སྦས་ཚུལ་ཁོ་ནས་བཞུགས་ཏེ་ཐོས་བསམ་སྒོམ་གསུམ།",
    "སྤྱིར་སྐྱེ་བ་སྔ་མ་རི་ལ་རྟག་པར་གནས་པའི་རྔོན་པའམ་རི་སྐྱེས་ལྟ་བུ་གང་གི་ལུས་བླངས་པའི་བག་ཆགས་ཀྱིས་ཡིན་ན་བྲག་ཕུག་ཡིད་དུ་འོང་བའམ།",
    "ནགས་ཚལ་བལྟ་ན་སྡུག་པའི་ནང་སྤྱིལ་བུ་སོགས་མཐོང་མ་ཐག་སེམས་བག་དྲོ་འུར་རེའི་འདི་འདྲ་ཞིག་ཏུ་གཅིག་པུ་ཁུ་སིམ་མེར་བསྡད་ན་བསམ་པ་རང་བཞིན་གྱིས་སྐྱེ་བ་འདུག།",
    "ཉི་ཟེར་ཚ་པོས་ལུས་ལ་རེག་པ།",
    "དཔུང་པ་སོགས་ལའང་འབྲུམ་བུ་ཆུང་ངུ་མང་པོ་བརྡོལ་ཏེ་སྦལ་པའི་ལྤགས་པ་ལྟ་བུ་རྒྱུན་དུ་ཡོད་པ་སོགས་ལ་བསམས་ན་བརླན་གཤེར་དུ་སྐྱེས་པའི་བྱོལ་སོང་གི་རིགས་ཤིག་ཡིན་ངེས་སྙམ་པ་འཕྲོས་སུ་སྨོས་པ་དང་།",
    "རྫོགས་ཆེན་སོགས་བཀའ་རྙིང་གི་དགོན་ཁག་མང་པོའི་ཆིབས་བསུ།",
    "ཐུགས་དམ་ཉམས་རྟོགས་འཁྲུངས་ཚུལ་སོགས་ནང་གི་བཀའ་འཕྲོས་ཞིབ་ཏུ་གནང་།",
    "དབྱངས་ཅན་དཀར་མོའི་རྗེས་གནང་རྣམས་ཕུལ།",
    "མཛོད་ཅིག་ལ་བརྡ་ཡིག་གིས་ཁེངས་པས་ཕྱག་མཚན་རྡོ་རྗེ་རྩེ་ལྔ་ཆེ་ལེགས་ཤིག་དྲིལ་ནས་ཁྱེད་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་ཐུགས་ཀྱི་སྤྲུལ་པ་ཡིན་པའི་བརྡ་ཡིན་ཟེར་བ་ཞིག་རྨིས།",
    "དཔལ་བསྟན་གཉིས་དར་རྒྱས་གླིང་གི་རི།",
    "རྗེ་མཆོག་གི་དགོངས་ཉམས་མཇལ་ཙ་ན།",
    "ཚེ་གཅིག་གི་སྟེང་དུ་མི་གསོབ་རེ།",
    "རྗེ་མཆོག་གི་ཡོན་ཏན་བསམ་པའི་ཚེ།",
    "དེ་ལ་ཆེད་དམིགས་ཀྱིས་ཡུམ་བཀའ་བདེ་ཆེན་རྒྱལ་མོའི་ཚོགས་འབུམ།",
    "སྔར་ནས་རང་གི་འཁྲུལ་རྟོག་ལ་ཚེ་ལམ་ཕྱག་རྒྱ་ཞིག་དང་འཕྲད་ན་ཚེ་གེགས་བཟློག་ཅིང་རིང་དུ་འཚོ་སྙམ་ཡོད་པ་གཞི་རྟེན་སྔགས་པར་བསྒྱུར།",
    "གཟིམ་ཆུང་གི་སྒོར་སྤོས་རིང་བསྣམས་ཏེ་ཕེབས་བསུ་དང་།",
    "རང་གིས་མཁའ་འགྲོ་གསང་བ་ཀུན་འདུས་ཀྱི་ཚོགས་འབུམ།",
    "རང་དང་ཐབས་གྲོགས་མ་ལ་གོས་རྒྱན་སོགས་ཟང་ཟིང་གི་གནང་སྦྱིན་རྒྱ་ཆེར་བསྩལ།",
    "དིལ་མགོའི་ཁྱིམ་འཛིན་སྲིང་མོའི་བཟའ་ཟླ་ཤི་བ་སོགས་སྡུག་བསྔལ་དུ་མ་ཐོག་ཏུ་བབས་པ་ལ།",
    "རང་ལོ་སོ་གསུམ་ཆུ་ལུག་ལོར་བུ་མོ་ཞིག་སྐྱེས།",
