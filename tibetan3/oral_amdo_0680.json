    "སྐྱེས་པ་བུད་མེད་མཚན་ལྡན་གཉིས་ཁྱོ་ཤུག་ཏུ་སྦྱོར་བ་སྨྱན་བྱེད་པའི་ལྷག་མ་སྟེ།",
    "གང་ཟག་གི་དོན་དུ་གཞི་མི་རུང་བ་དང་།",
    "རང་གི་གནས་ཀྱི་ཉེ་འཁོར་ལས་གཞན་དུ་གཞག་ནས།",
    "དེའི་རྒྱུར་བསགས་ཟླ་གཅིག་འདས་པ་ཟླ་འཇོག་གིས་སྤང་བ་སྟེ།",
    "རང་གི་ངག་གིས་མངོན་སུམ་དུ་བཅོལ་ནས།",
    "བྱ་བ་དེའི་ཕྱོགས་གཅིག་ཙམ་ཚར་བ་འཁྲུར་འཇུག་གི་སྤང་བ་སྟེ།",
    "བུད་མེད་ཐམས་ཅད་དང་སྐྱེས་པ་ཡིན་ཡང་ཆགས་སེམས་སྐྱེ་བའི་དགག་བྱ་ཡོད་པ་ལ།",
    "རང་དོན་དུ་རང་གི་ངག་གིས་བསླངས་ནས་ཐོབ་བློ་སྐྱེས་པ་སློང་བར་མི་རིགས་པ་སློང་བའི་སྤང་བ་སྟེ།",
    "གཅིག་གིས་གོས་ཀྱི་རིན་ཕུལ།",
    "གཅིག་གིས་ཞལ་ཏ་བ་བྱས་ཏེ་རིན་དེས་གོས་སྒྲུབ་པར་ཁས་བླངས།",
    "གཅིག་གིས་ཕོ་ཉ་བྱས་ཏེ་རིན་དེ་ཞལ་ཏ་བ་ལ་གཏད་པ་ལས་མ་བྱུང་ན་ལན་གསུམ་དངོས་སུ་བསྐུལ།",
    "རིམ་བཞིན་ཁལ་ནག་འབའ་ཞིག་གི་སྤང་བ་དང་།",
    "ལོ་དྲུག་གི་ནང་དུ་དེ་ལས་གཞན་བྱེད་དུ་༥ན་ཡང་མ་གནང་ལ།",
    "རང་གི་ཕྱིར་སྟན་རྒྱུ་རུང་བ་ལས་བཟོ་འམ་བཟོར་བཅུག་ནས་བཀྲམ་ཟིན་པ་ལོ་དྲུག་གི་ནང་དུ་སྟན་གཉིས་པ་བྱེད་པའི་སྤང་བ་སྟེ།",
    "རང་གི་གདིང་བ་གསར་པ་ལ་རྙིང་པ་ཡོད་བཞིན་དུ་མ་གླན་ནམ།",
    "ཐེབས་རེ་ལ་མཐོ་གང་གི་སྤང་ལྟུང་རེ་སྐྱེད་དེ།",
    "ཕྲག་པ་དང་མགོ་བོ་སོགས་ཡན་ལག་གིས་ཁུར་བ་ཐམས་ཅད་དེའི་ཕྱོགས་མཐུན་གྱི་ཉེས་པའོ།",
    "ཉེ་དུ་མ་ཡིན་པའི་དགེ་སློང་མ་ལ་རང་གི་བལ་རྨེལ་བ་རང་གི་མངོན་སུམ་དུ་བཅོལ་བ་ལས་དེས་ཅུང་ཟད་རྨེལ་བ་ན་བལ་རྨེལ་བའི་སྤང་བ་སྟེ།",
    "རེག་གམ་རེག་བཅུག་ནས་རེག་པའི་ཚེ།",
    "ཟངས་སོགས་ལ་རེག་པ་དང་།",
    "མ་རེག་ཀྱང་སྣོད་དམ་མཛོད་སོགས་སུ་བཅངས་པ་རྣམས་ཕྱོགས་མཐུན་གྱི་ཉེས་པའོ།",
    "ཁམས་ཅད་སྔར་བཞིན་སྦྱར་བ་ཉོ་ཚོང་གི་སྤང་བ་སྟེ།",
    "ཉོ་དགོས་པ་ནའང་ཁྱིམ་པར་མི་འཆོལ་བར་རང་གི་ཉོ་བ་དང་།",
    "ཅིས་ཀྱང་རང་གིས་ཉོ་དགོས་ནའང་རིན་ཐང་དྲང་པོར་དང་པོ་ནས་མ་བརྗོད་པ་དང་།",
    "རང་ངམ་གཞན་ལ་བསྒོ་བས་སྦྱིན་བདག་གི་འཐག་པ་སྐྱེད་པར་མ་གནང་ཡང་ཁྲུ་གང་ཡན་སྐྱེད་དེ་ཐོབ་བློ་སྐྱེས་པ་འཐག་པ་བསྐྱེད་པའི་སྤང་བ་སྟེ།",
    "རྐུ་སེམས་ཡིད་བཅུགས་མ་ཡིན་པར་རང་ངམ་གཞན་དོན་དུ་དགེ་སློང་གི་གོས་སམ་ལྷུང་བཟེད་གཏན་དུ་འཕྲོག་འདོད་ཀྱིས་རང་གིས་མངོན་སུམ་དུ་ཕྲོགས་ནས་ཐོབ་བློ་སྐྱེས་པ་བྱིན་ཕྲོགས་ཀྱི་སྤང་བ་སྟེ།",
    "རང་གིས་བསླངས་ནས་ཐོབ་བློ་སྐྱེས་པའི་ཚེ་རས་ཆེན་འཚོལ་སྔས་པའི་སྤང་བ་དང་།",
    "ཇ་དཀར་ནག་གི་བཏུང་བ་སོགས་ཐུན་ཚོད་དུ་རུང་བ་དང་།",
    "ཡང་རྩོད་པ་ཞི་བྱེད་ཀྱི་དགེ་སློང་གིས་སླར་རྩོད་པ་ལངས་པའི་ཚིག་གསལ་བར་རྩོད་པ་ཞི་བྱེད་ལ་སྨྲས་པས།",
    "བུད་མེད་མཚན་ཉིད་ཚང་བ་སེམས་རང་བཞིན་དུ་གནས་པ།",
    "རྒོད་བག་གིས་མིན་པར་ཁ་ཏོན་ཞུ་བ་དང་།",
    "རྙེད་པའི་ཕྱིར་རང་གི་ཡོན་ཏན་གཞན་བརྗོད་པ་ཉེས་བྱས་སོ།",
    "གསོ་སྦྱོང་གི་དུས་དེར་ཚོགས་པའི་དགེ་སློང་གིས་ཚོར་བར་བསླབ་ཚིག་ཁྱད་དུ་གསོད་པའི་ཚིག་སྨྲས་པ་ལས།",
    "གང་ཟག་གི་མལ་སྟན་ཆུད་ཟར་བཅུག་པ་དང་།",
    "དེ་དངོས་མིན་ཀྱང་དུད་འགྲོ་ཡན་ལ་རྒོད་བག་གིས་གནོད་པ་བྱེད་པ་ཉེས་བྱས་སོ།",
    "དགེ་སློང་མ་ལ་རེག་པས་ཉེས་པས་དག་པ།",
    "རང་དང་ངོ་ཚ་བསྲུང་བའི་ཉེ་དུ་མིན་པའི་བུད་།",
    "དགེ་སློང་མ་མཛའ་བཤེས་ཙམ་གྱི་ཕྱིར་རང་གི་གོས་བྱིན་ནས།",
    "དེ་དངོས་མིན་ཀྱང་གོང་བཞིན་དེ་ཙམ་གྱི་བུད་མེད་ལ་ཟས་སོགས་སྟེར་བ་ཐམས་ཅད་ཉེས་བྱས་སོ།",
    "རང་དང་ཉེ་དུ་ནོར་གཅིག་མིན་པའི་བུད་མེད་ཀྱི་སྦྱིན་བདག་ཁྱིམ་པ་ལ་དུས་རུང་བསླངས་ཏེ་ཟོས་ན།",
    "ཉིན་ཞག་དེ་ལ་དུས་རུང་གི་ཁམ་ཟས་དེ་ཁྱིམ་དུ་མི་ཟ་བར་བློས་བཅད་དེ།",
    "དགེ་སློང་གི་ཟས་སྤངས་པར་ཤེས་བཞིན་ལྷག་པོར་མ་བྱས་ཤིང་།",
    "ཕོར་པ་སོགས་ལ་ཟས་གོས་པ་གསོག་འཇོག་ཏུ་སོང་བ་ཟ་བ་དང་།",
    "དགེ་སློང་གིས་བཙོས་པ་སོགས་ཟ་ཟ་བ་ཉེས་བྱས་སོ།",
    "གཞན་ཡང་དེ་འདྲའི་རིགས་སྲོག་ཆགས་ཕྲ་མོ་ལ་གནོད་པ་འོང་བ་སྤོང་བ་ལ་མ་འབད་ན་ཉེས་བྱས་སོ།",
    "ཁྱིམ་པ་ཕོ་མོ་ལུས་བསྟེན་རུང་གཉིས་རང་གི་ཁྱིམ་དུ་ཉལ་པོ་ལ་ཞུགས་པའི་མངོན་སུམ་འདོམ་གང་ནང་དུ་བསྡད་ནས་ཕན་ཚུན་ཡོད་པར་ཚོར་བའི་ཚེ།",
    "དེ་དངོས་མིན་ཀྱང་སྲོག་ཆགས་ཕྲ་མོ་ཉལ་པོ་བྱེད་པའི་མདུན་༩བ་དུ་སྡོད་པ་དང་འགྲེང་བ་ཚུན་ཆད་ཉེས་བྱས་དང་།",
    "ཉེས་བྱས་ཕྲ་མོར་འགྱུར་རོ།",
    "བུད་མེད་ཀྱི་དམག་སོགས་ལ་ཉེས་བྱས་སོ།",
    "དགོས་པ་ཁྱད་པར་ཅན་ལ་དམག་གི་ནང་དུ་སྡོད་དགོས་པའི་ཚེ་ཡང་རང་དགར་དམག་ལ་བལྟ་བའམ།",
    "རེག་པའམ།",
    "མེ་རྡོག་དག་དང་མེ་དག་ལ་རེག་གམ།",
    "མེ་ལྕེ་དང་མེ་༡ན་མ་མུར་ལ་རེག་པ་དང་།",
