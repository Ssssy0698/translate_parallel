    "དུར་ཝ་ཡང་རྒྱ་ནག་གི་དུར་ཝ་ཁོ་ན་ལ་བྱ་ཞིང་།",
    "རང་གི་གཡོན་ཐབ་ཀྱི་གཡས་ནས་ཆུ་གཉིས་སྔོན་འགྲོའི་ཉེར་སྤྱོད་འོ་མས་ཁ་བསྒྱུར་བ།",
    "རང་གི་གཡས་ཐབ་ཀྱི་གཡོན་ན་ཤིང་སྟེགས་ལ་སོགས་པའི་ཁར་འབྱོར་ཚེ་དངུལ་ལམ་ཤེལ་དུང་དཀར་གྱི་ཏིང་གི་ནང་དུ་གོང་གི་བསྲེག་རྫས་རྣམས་གོ་རིམ་མ་ལོག་པར་ཁ་གསོ་དང་བཅས་པར་བཤམས།",
    "རང་གི་མདུན་དུ་འཇིམ་པ་ལས་བྱས་པའི་མེ་ཡོལ་དཀར་པོ་ལ་གངས་རི་ཆུ་རིས་ཝྃ་བྲིས་པ་བཞག་དེའི་རྒྱབ་ལྕོག་རྩེའི་སྟེང་དུ།",
    "དེ་མིན་ནའང་རྡོ་རྗེ་རྩེ་དགུ་པ་མཐའ་མེ་རིས་ཀྱིས་བསྐོར་བ་རྩེ་མོར་ཉི་ཟླས་མཛེས་པ་དར་ནག་གི་གུར་མདུང་ཐུང་དང་བཅས་པ།",
    "དེའི་མདུན་དུ་འདས་གཏོར་ཟླུམ་པོ་གསུམ་མམ་ལྔའམ་བདུན་ནམ་བཅུ་གང་རུང་དར་ནག་གི་འཕྱང་འཕྲུལ་བཅས་པ་བཤམས།",
    "དེ་མིན་ན་ཟླ་བ་གང་རུང་གི་ནམ་ལང་ལའོ།",
    "བསྙེན་པ་དང་རྒྱུན་གྱི་སྦྱིན་སྲེག་གི་དབྱེ་བ་བསྟན་པ་ཞར་བྱུང་འཕྲོས་དོན་དང་བཅས་པ་སྟེ་བཞིའོ།",
    "ཨོཾ་བཛྲ་ཀྲོ་དྷ་ཨ་མྲྀ་ཏ་ཀུཎྜ་ལི་ཧ་ཱུྃ་ཚིནྡྷ་ཚིནྡྷ་ཧ་ཱུྃ་ཕཊ།",
    "ཨོཾ་བཛྲ་ཀྲོ་དྷ་ཨ་མྲྀ་ཏ།",
    "ཕྱི་རོལ་སྟེགས་བུ་གྲུ་བཞི་པའི་གྲྭ་བཞིར་ཟླ་ཕྱེད་རྡོ་རྗེས་མཚན་པ་དྭངས་ཤིང་ཐོགས་པ་མེད་པ་བུད་ཤིང་བརྩིགས་པ་དང་བཅས་པར་གྱུར།",
    "གཡོན་སྤྱི་བླུགས་འཛིན་པ་གསུས་ཁྱིམ་ཆེ་བ་རལ་པའི་ཐོར་ཚུགས་དང་སྨ་ར་ཨག་ཚོམ་ཅན་དྲང་སྲོང་གི་ཚོགས་ཀྱིས་བསྐོར་བའི་དཔྲལ་བར་ཨོཾ།",
    "ལག་པ་གཉིས་ཀྱི་མཐེ་བོང་གུང་མོའི་རྩ་བར་བཞག་མཛུབ་མོ་གུང་མོའི་རྒྱབ་ནས་བཀབ་ལ་དབྱུག་གུ་རྩེ་གསུམ་པའི་ཕྱག་རྒྱ་རྣ་བའི་དྲུང་དུ་གཡབ་ཅིང་།",
    "དེ་ནས་ཐལ་མོ་སྦྱར་བ་ལས་གུང་མོའི་ཚིགས་བར་པའི་རྒྱབ་ནས་མཛུབ་མོ་གཉིས་བཙུགས་སྲིན་ལག་གཉིས་ལག་མཐིལ་དུ་བཀུག་མཐེབ་ཆེན་དང་མཐེ་ཆུང་སོ་སོར་སྦྱར་བ་རྡོ་རྗེ་རྩེ་ལྔ་པའི་ཕྱག་རྒྱ་བཅས་ལ་དམ་བཞག་པ་ནི།",
    "ལག་པ་གཉིས་རྡོ་རྗེ་ཁུ་ཚུར་ལག་གཡོན་པའི་མཐེའུ་ཆུང་ལ་གཡས་པའི་མཛུབ་མོ་སྦྲེལ་བ་ལྕགས་ཀྱུའི་ཕྱག་རྒྱ་བཅའ་ཞིང་།",
    "ཨོཾ་བཛྲ་པཀྵི་ནི་ཧ་ཱུྃ་ཛ་ཞེས་བརྗོད་པས་རྡོ་རྗེ་གནོད་སྦྱིན་མས་མེ་ལྷ་ཡེ་ཤེས་པར་ལྕགས་ཀྱུས་རེག་པས་དམ་ཚིག་པའི་སྤྱི་བོར་སྤྱན་དྲངས།",
    "ཞེས་བརྗོད་པས་རྡོ་རྗེ་འཇིགས་བྱེད་མས་མེ་ལྷའི་ཞབས་ལ་ཞགས་པ་རེག་པས་དམ་ཚིག་པའི་སྤྱི་བོ་ནས་བསྟིམ་པར་བསམ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་ལས་མཐེ་ཆུང་གཉིས་སྦྲེལ་མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མཐུར་ཁ་གྱེན་དུ་བསྟན་པ་ལྕགས་སྒྲོག་གི་ཕྱག་རྒྱ་བཅས་ལ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཧ་ཱུྃ་བཾ།",
    "ཞེས་བརྗོད་པས་རྡོ་རྗེ་བདུད་རྩི་མས་མེ་ལྷ་དམ་ཚིག་པའི་ཞབས་ལ་ལྕགས་སྒྲོག་རེག་པས་དམ་ཡེ་གཉིས་དབྱེར་མེད་དུ་བྱས།",
    "ཨོཾ་བཛྲ་མཱ་ར་ཎི་ཧ་ཱུྃ་ཧོ་ཞེས་བརྗོད་པས་རྡོ་རྗེ་གསོད་བྱེད་མས་ཕྱི་ནང་ཀུན་ཏུ་དྲིལ་བུའི་སྒྲ་བསྒྲགས་པས་སྐད་ཅིག་ཀྱང་མི་འབྲལ་ཞིང་བརྟེན་པར་བྱས་པར་བསམ་མོ།",
    "སྟོང་པའི་ངང་ལ་ཧ་ཱུྃ་ལས་བྱུང་བའི་ཀུ་ཤ་སྔོ་ལྗང་རྩ་བ་དང་རྩེ་མོ་མ་ཉམས་པ་འབགས་པ་དང་མ་དག་པ་སེལ་བའི་ནུས་པ་དང་ལྡན་པར་གྱུར།",
    "ཞེས་བརྗོད་ཅིང་སློབ་དཔོན་གྱི་ཐལ་མོའི་བར་དུ་བཟུང་ལ།",
    "འདིས་བདག་ཅག་གི་བགེགས་དང་མི་མཐུན་པའི་ཕྱོགས་ཞི་ཞིང་ལས་ཀྱི་དངོས་གྲུབ་ཀྱང་སྩལ་དུ་གསོལ།",
    "ཕྱག་ལེན་ལ་སྐབས་འདིར་མཛད་པས་བྲམ་ཟེ་རྒྱུན་བཞག་གི་མེའམ་མེ་ཤེལ་ལས་བྱུང་བ་དང་།",
    "ཤིང་འོ་མ་ཅན་བཙུགས་པ་ལས་བྱུང་བའི་མེས་སྤོར་ལྡེ་སྦར་ནས་སློབ་དཔོན་གྱི་ཐལ་མོའི་བར་དུ་བཟུང་ལ།",
    "ཞེས་བརྗོད་ཅིང་ཐབ་ནང་གི་ཏིང་ལོ་སྦར།",
    "གོང་གི་སྔགས་བརྗོད།",
    "ཞེས་བརྗོད་ཅིང་བསམ་ལ་གཡས་ཁུ་ཚུར་བཅང་བ་ལས་མཛུབ་མོ་དང་མཐེ་བོང་བསྒྲེངས་བས་བླུགས་གཟར་བཟུང་བ་ཁ་ཕུབ་ཏུ་བཅངས།",
    "ཤེས་རབ་མཆོག་གིས་ཉོན་མོངས་ཐམས་ཅད་སྲེག།",
    "རྩེ་མོ་སྦོམ་ན་ཤིན་ཏུ་བཟང་།"
  ]
}