    "སྔ་ཕྱི་རྣམས་སྡོམ་ཞིབ་རྩིས་བྱས་པས་བརྒྱ་དང་བཅུ་གསུམ་ལྷག་ཆད་མེད་པ་འགྲུབ་འདུག་པ་ལ།",
    "ང་རང་ལ་ས་ཕྱོགས་འདི་ལྟ་བུར་འགྲོ་དོན་འདི་འདྲ་ཡོང་།",
    "ད་དེ་རིང་ཉི་མ་ཡང་ཕྱེད་འདུག།",
    "འདི་རྣམས་ཅིར་འདུག་བྱས།",
    "བུ་དང་ཚ་བོ་གཉིས་ཀ་ཙཀྲ་མེའི་འཁོར་ལོ་ཐོགས་པའི་ཧུར་ཐུམ་ཕཌ་གཉིས་ཀ་འདུག།",
    "གདན་གཅིག་བཏིངས་འདུག་ཀྱང་ས་བརྗེན་རང་ལ་བསྡད་མཚམས།",
    "རྗེ་དྲུང་ཀརྨ་པ་ཉུལ་རྒྱལ་ཁང་ན་གདན་ཆགས་འདུག་པའི་དྲུང་།",
    "ཁྲིད་ཁ་བརྒྱ་རྩའི་ཁ་བསྐོངས་བཀྲ་ཤིས་གྲངས་ཀྱི་མཐའ་བསྟེན་མིང་བཀྲ་བཟང་བར་འདུག་པས།",
    "གཅིག་པུར་འདུག་ཀྱང་དགའ་བའི་ཅ་ཅོ་ཤོར་།",
    "མིང་ཙམ་མཚུངས་ཀྱང་རང་བཞིན་ཐ་དད་ཅེས་།",
    "ཕྱིས་མཐོང་བ་ན་ཡང་རང་ཉིད་དད་པའི་སྤུ་ལོང་གཡོ་ཞིང་།",
    "ཐུགས་དོག་ཆེ་བ་རང་འདུག་པ་ནས།",
    "བར་ཆད་རྩོམ་པའི་དམིགས་བྱ་དེར་འདུག་པས་བསྒྲལ་ལམ་སྙམ་པ་སྐད་ཅིག་ལ།",
    "སྣོད་གང་འདུག་ཏུ་མར་མེ་ཕུལ་བས།",
    "ལོག་ཀྱང་དོ་དགོངས་གནས་ཁང་ཡང་མི་རྙེད་ཅིས་ཀྱང་མི་མཇལ་ན་སྐུ་ཆས་འདི་པ་འབུལ་བ་ལ་ང་རང་འགྲོ་ཟེར་ཀྱིན་འདུག་པ་ལ།",
    "འབྲུམ་པས་ན་ནས་ཤི་ན་ཕུང་པོ་སོགས་སྐྱུར་བ་ལ་ལས་སླ་བར་འདུག་སྙམ་ནས།",
    "དེར་ལག་ཏུ་བླངས་ནས་མགོར་བཞག་བལྟས་རྗེས་ཕྱག་ནས་མ་རང་ཡིན་ཟེར་བའི་ཁ་ཡིག་འདུག་ཅིང་།",
    "ས་གར་བསྡད་པ་ལ་ཆུ་འདི་རང་ལུས་ལ་ཕན་པར་འདུག་ཅིང་།",
    "ཚེ་མདའ་ལ་ཆད་མངོན་ཙམ་བྱུང་བ་རྣམས་སྐྱེས་བུ་ཆེན་པོ་མང་ཐོས་པ་དེ་ཉིད་སྐུ་ཚེ་རིང་པོ་མི་བཞུགས་པའི་བལྟས་སུ་འདུག།",
    "རྡོ་གཡེབས་མི་བསྐྱོད་པ་མང་པོའི་དཔྱིལ་པོའི་ཕྱོགས་ཀྱི་ཕྱི་མཐའ་ཀུན་ན་འདུག་པ་ཡོངས་ཀྱི་མིག་ཤེས་ལ་ཕེབས་པ་ངེས་ཅན་བརྫུན་བྲལ་ཡིན།",
    "ཡི་གེ་ལ་ཞལ་བཤུས་པའི་མྱང་སྟོད་ཕལ་ཆེར་ཁྱབ་འདུག་ཅིང་།",
    "དེ་ལོ་ས་སྐྱ་སོགས་སྐྱ་མུག་ཆེ་བར་འདུག་པ་ལ་ངེད་དཔོན་སློབ་སྐྱིད་དུ་ཚོར་བའི་ཆས་འབད་མེད་བྱུང་།",
    "སྟོད་ཧོར་ཡང་དེའི་ཉིན་ཀ་བློ་བུར་དམག་ཡོང་བ་འདུག་ཟེར་ནས་ལོག་སྐད་དོ་།",
    "སླར་འབོད་མི་གནང་བ་དང་བསྟུན་ནས་ཚུར་ལམ་ཆུ་འདུས་ཕྱོགས་ན་འབྲུམ་བགས་འདུག་ཟེར་བ་ལ་འཛེམས་ནས་གཏིང་སྐྱེས་ནས་གདོང་ནག་ལ་བྱས།",
    "ལྷག་པར་ཉན་པོའི་རི་བོ་དགེ་ལྡན་པ་རྣམས་ལོ་དུས་ཀྱི་གསང་བ་འདུས་པའི་སྒྲུབ་མཆོད་ཅིག་འདུག་པའི་དབུས་སུ་བོས་ནས།",
    "དེར་ཁྱེད་རང་ལ་དམིགས་ནས་བསྒྲུབས་པ་ཡིན་གསུང་བའི་དཔྱིལ་བུ་ཅིག་ཏུ་ཉལ་བས་མཚན་ཕྱེད་ཙམ་ན་ལྷག་པར་ན་བའི་ཁྲག་དྲོན་སྐྱུག་པ་རང་བྱུང་བས་ཁོང་ཐམས་ཅད་སོ་མ་སོད་ལ་བཀོད།",
    "མཁས་བཙུན་པ་གསུམ་གྱི་སྐུ་རིང་ལ་ས་སྐྱ་པའི་གུར་ཞལ་རང་ལ་བྱེད་པ་ཡིན་འདུག་ཅིང་།",
    "སླར་ངམ་རིངས་སུ་ཡོངས་རྨི་ལམ་ལ་གུར་མགོན་རྩུབ་འགྱུར་གྱི་རྣམ་འཕྲུལ་སྣ་ཚོགས་རང་འདུག་པས་བསྐངས་གསོ་ཅུང་རྒྱུན་རིང་པ་ཙམ་ཅིག་སྐུ་རིམ་དུ་ཆེ་བ་ཞུས་ནས་བསྐང་གསོ་ཟབ་རྒྱས་རང་བརྒྱ་ཐར་གསུམ་བཏུད།",
    "རང་རང་ཕྱག་བཞེས་ཡིན་པས་ཅི་ཞིག་གོ་།",
    "དེར་ཞིབ་ཏུ་དཔྱད་པས་གསར་བཞེངས་ཀྱི་ས་པཎ་གྱི་སྐུ་དེ་སྐུ་འདྲ་ཡིད་བཞིན་གྱི་ནོར་བུ་ལས་དབུ་དཔངས་མཐོ་བར་འདུག་པས།",
    "བསོ་ཡང་བསོད་པར་འདུག་སྙམ་སང་འདེགས་གནང་འདེགས་རང་ལ།",
    "རང་རང་སྐལ་པའི་ཆ་ཤས་གྱུར་པ་ནི་།",
    "ཁོ་རང་ལ་ཡང་དངོས་ཀྱིས་ཁྱེད་ཀྱི་མགོ་འདི་མི་ལག་ཏུ་མཆོར་ངེས་འདུག་པས་འགྲོ་འགྲོ་མངས་མངས་པ་མི་དགའ་ཡང་ཡང་ལབས།",
    "དེའི་གནམ་གང་ལ་རྗེ་རབ་གསལ་ཟླ་མགོན་པ་གཤེགས་པར་འདུག་པ་ལ།",
    "དུས་ཟིངས་པས་ངེད་ལ་ལོན་ཆ་སོགས་མ་ཐེངས་པ་ཡིན་ཚོད་དུ་འདུག་པ་ལ།",
    "གཞིས་ཀ་ནས་དངུལ་སྐུའི་སྐུ་འདྲ་དྲན་པའི་གསལ་འདེབས་སུ་མཚན་ཐོགས་པ་དེའི་རབ་གནས་ཀྱང་སྟག་ལུང་རང་དུ་ཞུར་གནས་བྱུང་བ་བཞིན་བསྒྲུབས།",
    "སྟག་ལུང་ནས་སླར་ལོག་ཡོང་དུས་ལམ་འུ་ཡུག་ལ་བྱས་གཞིས་ཀར་སླེབ་པས་ཞབས་དྲུང་ཁུ་དབོན་ནི་གང་ཡང་མ་བཞུགས་འདུག།",
    "ངེས་འབྱུང་ཆེན་པོའི་དགའ་གདུང་རང་གྲོལ་མཆོག་།",
    "རང་རང་རིགས་དང་མཐུན་པའི་ལེའུ་ཁས།",
    "རང་རང་བསྟན་པའི་ཁུར་ཆེན་འདེགས་རློམ་པས།",
    "ཡུལ་སོ་སོ་བདག་ཏུ་བཟུང་སྟེ་རང་རང་འདོད་པའི་འཕྲུལ་གྱིས་བསམ་སྦྱོར་མི་བསྲུན་པའི་མཚོན་གྱི་བསྐལ་པ་དར།",
    "བརྗོད་ཀྱིས་མི་ལངས་པ་འདུག་ཀྱང་འབྲི་བར་མ་ལང་ཞིང་ཟུར་ཙམ་ཞིག་བརྗོད་པ་ལས།",
    "འཚང་ཁའི་གནས་ཡུལ་དང་རང་ཕྱོགས་བཙན་དམིགས།",
    "གཞན་ཕྱོགས་ཕ་རོལ་གང་ཡོད་གང་བྱེད་ལ་བརྟག་དཔྱད་དང་རང་ཟོན་སྐྱོར་ནས་དགྲ་དང་འཐབ་ཟེར་བའི་དཔེ་ལྟར་ཁྱེ་ཉེན་གྱི་བརྟག་དཔྱད་ལེགས་པར་བྱེད་དགོས་ཤིང་།",
    "དགྲ་འདུག་ཤ་ཞོག་ལ་ལན་ཐོངས།",
    "མེ་དམར་ནག་རྩེགས་རྩེགས་ཡོང་བ་ཞིག་འདུག་ན་ཡིན་ཏེ་མ་འཁྲུལ་བར་བརྟག་དགོས་སོ།",
    "སྨར་ཞོའི་སྲང་གྲངས་སུ་བྱེད་པ་སོགས་འདུག་པར།",
    "ཚོང་འདུས་ཀྱི་གསེར་རིན་ལག་ཡོད་གང་འདུག་ལ་ཆ་འཇོག་པ་སོགས་གནང་སྲོལ་འདུག་ཅིང་།",
    "དབུས་ལ་གསེར་བྲེའི་བཞི་ཞོ་དང་གསུམ་ཞོ་སོགས་རྣམ་གྲངས་ཤིན་ཏུ་མང་བ་འདུག་པ་ཞོའི་ཚད་ནི།",
    "རྐང་གླ་སོགས་ཆད་པའི་བཞི་ཟུར་རིམ་འགྲོས་སུ་བྱས་པ་ཞིག་འདུག་ཀྱང་།",
    "གཞན་མ་དབུས་ལུགས་ལ་བཅུ་ཁ་ལེན་པ་ཞིག་འདུག་ཀྱང་འདི་འགབ་ཡུལ་ཆགས་པ་མི་འདུག་པས།",
    "ནག་ཆེན་གྱི་སྟོང་མིང་བཏགས་པ་ཙམ་ལ་མིང་འདོགས་ཀྱི་སྒོ་ནས་ཐབས་ལ་མཁས་པར་མཛད་པ་ཡིན་འདུག་ཀྱང་།",
    "ཕྱིས་འཆལ་བ་ཤིན་ཏུ་ཟོང་བ་ལ་སྟོང་སྤྲོད་སྤྲོད་ཟེར་ཁ་དཔེར་བྱས་ནས་སྟོང་ལ་ཟོལ་ཟོག་གང་འགྲོ་བྱེད་པ་ཞིག་བར་དུ་དར་འདུག་ཀྱང་།",
    "བྲེ་ཚད་ཀྱི་ཡུལ་ཞོ་ཁལ་བརྒྱད་མར་འདུག་པ།",
    "མི་འདི་ལ་འདི་ཞེས་པ་རྐྱེན་ལམ་དུ་བཏང་འདུག་པ།",
    "རྐྱེན་རྩ་འཆི་མཁན་ནག་ཆེ་བ་ཡོད་ན་འདས་པོ་ཚེ་ཚད་ཀྱིས་གཏུགས་པའི་དེ་བཞིན་བྱས་འདུག་ཀྱང་།",
    "མིང་འདོགས་ཀྱི་མི་བདག་ལག་དམར་གྱི་བློ་ཁྲིད་ཕྱོགས་སམ་སྲོལ་རྒྱུན་གྱི་ཁྱད་པར་ཡིན་འདུག་ཅིང་།",
    "མི་མཐའ་ཁྲག་ལ་ཐིགས་སེ་ཟེར་བ་གྲགས་འདུག་ནའང་།",
    "སྔ་སོར་རྨ་འོག་ཏུ་གཤགས་དོར་ཟེར་བ་ཞིག་འདུག་ཀྱང་།",
    "དེས་ན་བདེན་མེད་དུ་འགྲོ་བར་འདུག་པས།",
