    "བདག་ཅག་ལ་གཡར་གཟིགས་ངན་པ་དག་བསྐུར་ཞེས་སྤྲིང་བ་འོངས་ན།",
    "ཁོ་མོས་དེ་དག་ལ་ཁོ་མོས་ཁྱེད་ཅག་ལ་གཡར་གཟིགས་ངན་པ་ནི་མ་བསྐུར་ཏེ།",
    "དེ་ལྟ་མོད་ཀྱི་གཡར་གཟིགས་བསོད་པ་ཞིག་བསྐུར་རོ་ཞེས་སྤྲིང་ངོ།",
    "ཁོ་མོས་བྲན་མོ་ལ་དྲིས་པ།",
    "བྲན་མོ་གཡར་གཟིགས་བསོད་པ་དག་ཁྱོད་ཀྱིས་ཟོས་ལ་དེ་དག་ལ་ངན་པ་དག་མ་བྱིན་གྲང་།",
    "ཁྱོད་ཀྱི་གཡར་གཟིགས་ཟ་ན་རྣག་ཁྲག་ཅིའི་ཕྱིར་མི་འཐུང་ཞེས་སྨྲས་པས།",
    "གྲོ་བཞིན་སྐྱེས་ཡང་གནས་པ་ཞེས་བྱ་བའི་གྲོང་དུ་འགྲོ་ན་དེ་ན་ཁོ་མོའ་བུ་མོ་སྨད་འཚོང་བྱེད་པ་དེ་ལ།",
    "ཁྱོད་ཀྱི་ཕ་དང་།",
    "བྲན་མོ་དག་ངས་མཐོང་སྟེ།",
    "སྲིང་མོ་ཁྱེད་ཉིད་ན་རེ་འཛམ་བུའི་གླིང་པའི་མི་རྣམས་ནི་ཡིད་ཆེས་པར་དཀའོ་ཞེས་སྨྲས་པས་ཡིད་ཆེས་པར་མི་འགྱུར་རོ།",
    "གྲོ་བཞིན་སྐྱེས་གལ་ཏེ་ཡིད་མི་ཆེས་ན་ཁྱོད་ཀྱི་ཕའི་སྔོན་གྱི་ཁང་པ་ན་ལྕགས་ཟངས་གསེར་གྱིས་གང་བ་ཟུང་བཞི་དང་།",
    "དུས་དུས་སུ་འཕགས་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོ་ལ་བསོད་སྙོམས་དབུལ་ཞིང་བདག་ཅག་གི་མིང་ནས་ཕྱུང་སྟེ་ཡོན་བསྔོ་བ་བྱོས་ཤིག་དང་།",
    "གྲོ་བཞིན་སྐྱེས་ཁྱོད་གནས་པའི་གྲོང་དུ་འགྲོ་འམ།",
    "སྲིང་མོ་འགྲོའོ་ཞེས་དེ་གཞལ་མེད་ཁང་དུ་ཞུགས་པ་དང་དེས་ཡི་དགས་དེ་རྣམས་ལ་བསྒོ་བ།",
    "ཤེས་ལྡན་དག་དེང་ལ་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་ཉལ་བཞིན་དུ་གནས་པའི་གྲོང་གི་ཕའི་སྐྱེད་མོས་ཚལ་དུ་ཞོག་ལ་སླར་གཤེགས་ཤིག།",
    "དེ་དག་གིས་དེ་གནས་པའི་གྲོང་དུ་ཕའི་སྐྱེད་མོས་ཚལ་དུ་བཞག་གོ།",
    "དེ་ནས་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོ་གང་ན་བ་དེར་སོང་བ་དང་།",
    "གྲོ་བཞིན་སྐྱེས་ཁྱོད་འོངས་པ་ལེགས་སོ།",
    "གྲོ་བཞིན་སྐྱེས་ཁྱོད་ཀྱིས་འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་ཕ་རོལ་མཐོང་ངམ།",
    "གྲོ་བཞིན་སྐྱེས་རེ་ཞིག་སྔོན་གྱི་དམ་བཅས་པ་དྲན་པར་བྱོས་ལ་ཐ་ན་ཇི་སྐད་སྤྲིང་ཞིང་བཟུང་བ་ཆུབ་པར་སྐྱོལ་ཅིག།",
    "དེ་ཤེན་པ་དེའི་དྲུང་དུ་སོང་ནས་བཞིན་བཟངས་ཁྱོད་ཀྱི་ཕ་ངས་མཐོང་སྟེ།",
    "ཀྱེ་ནང་རྗེ་བདག་གི་ཕ་ནི་ཤི་ནས་དེང་དུ་ལོ་བཅུ་གཉིས་ལོན་ན།",
    "ཁྱོད་ཀྱིས་འཇིག་རྟེན་ཕ་རོལ་ནས་སླར་འོངས་པ་འགའ་མཐོང་བ་ཡོད་དམ།",
    "དེ་ཡིད་མཆེས་པ་དང་བཞིན་བཟངས་ཅི་སྟེ་ཡིད་མི་ཆེས་ན་དེ་ན་རེ་ཁྱོད་ཀྱི་ཕའི་རལ་གྲིས་བསད་པའི་འོག་ན་གསེར་ཕྱེ་མ་བུམ་པ་གང་བཞག་གིས་དེ་ཕྱུང་ལ་བདག་ཉིད་ལ་ཡུན་དུ་བདེ་བས་ཚིམ་པར་བྱ་བ་དང་།",
    "བདག་ཅག་གི་མིང་ནས་ཕྱུང་སྟེ་ཡོན་བསྔོ་བ་བྱོས་ཤིག་དང་།",
    "བདག་གིས་སྔོན་ཆད་ནི་དེ་ལྟ་བུ་ལན་འགའ་ཡང་མ་ཐོས་ན་རེ་ཞིག་བལྟས་ཏེ་གལ་ཏེ་བྱུང་བར་གྱུར་ན་ཟེར་བ་དེ་ཐམས་ཅད་བདེན་ནོ་སྙམ་ནས།",
    "དེས་སོང་སྟེ་བརྐོས་ནས་ཇི་ཙམ་ན་མཐོང་བ་དང་དེ་ཐམས་ཅད་དེ་ཁོ་ན་བཞིན་དུ་གྱུར་ཏེ།",
    "དེའི་འོག་ཏུ་བྱི་བོ་བྱེད་པ་དེའི་དྲུང་དུ་སོང་སྟེ་སོན་ནས་སྨྲས་པ།",
    "བཞིན་བཟངས་ཁྱོད་ཀྱི་ཕ་ངས་མཐོང་སྟེ།",
    "ཀྱེ་ནང་རྗེ་བདག་གི་ཕ་ཤི་ནས་དེང་དུ་ལོ་བཅུ་གཉིས་ལོན་ན་ཁྱོད་ཀྱིས་འཇིག་རྟེན་ཕ་རོལ་ནས་འོངས་པ་འགའ་མཐོང་བ་ཡོད་དམ།",
    "བཞིན་བཟངས་གལ་ཏེ་ཡིད་མི་ཆེས་ན་ཕ་ན་རེ་ཁྱོད་ཀྱི་ཕའི་མེ་ཐབ་ཀྱི་འོག་ན་གསེར་ཕྱེ་བུམ་པ་གང་བཞག་གིས་དེ་ཕྱུང་ལ་བདག་ཉིད་ཡུན་དུ་བདེ་བས་ཚིམ་པར་བྱ་བ་དང་།",
    "དུས་དུས་སུ་འཕགས་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོ་ལ་བསོད་སྙོམས་ཕུལ་ལ་བདག་ཅག་གི་མིང་ནས་ཕྱུང་སྟེ་ཡོན་བསྔོ་བ་བྱོས་ཤིག་དང་།",
    "བདག་གིས་དེ་སྐད་སྔོན་ཆད་ནི་ལན་འགའ་ཡང་མ་ཐོས་ན་གལ་ཏེ་བྱུང་བར་གྱུར་ན་ཟེར་བ་དེ་ཐམས་ཅད་བདེན་ནོ་སྙམ་ནས།",
    "དེས་སོང་སྟེ་བརྐོས་ནས་ཇི་ཙམ་ན་མཐོང་བ་དང་དེ་ཐམས་ཅད་དེ་ཁོ་ན་བཞིན་དུ་གྱུར་ཏེ་དེས་ཡིད་ཆེས་པར་གྱུར་ཏོ།",
    "དེའི་འོག་ཏུ་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་སྨད་འཚོང་མ་དེའི་དྲུང་དུ་སོང་སྟེ་སྨྲས་པ།",
    "སྲིང་མོ་ཁྱོད་ཀྱི་ཕ་དང་།",
    "བྲན་མོ་དག་ངས་མཐོང་སྟེ།",
    "སྲིང་མོ་གལ་ཏེ་ཡིད་མི་ཆེས་ན་དེ་དག་ན་རེ་ཁྱོད་ཀྱི་ཕའི་སྔོན་གྱི་ཁང་པ་རྙིང་པ་ན་ལྕགས་ཟངས་གསེར་ཕྱེས་གང་བ་ཟུང་བཞི་དང་།",
    "བདག་ཅག་གི་མིང་ནས་ཕྱུང་སྟེ་ཡོན་བསྔོ་བ་བྱོས་ཤིག་དང་།",
    "བདག་གིས་སྔོན་ཅད་ནི་དེ་ལྟ་བུ་ལན་འགའ་ཡང་མ་ཐོས་ན་བལྟ་བར་བྱ་སྟེ།",
    "དེས་སོང་སྟེ་བརྐོས་ནས་ཇི་ཙམ་ན་མཐོང་བ་དང་དེ་ཐམས་ཅད་དེ་ཁོ་ན་བཞིན་དུ་གྱུར་ཏེ་ཡིད་ཆེས་པར་གྱུར་ཏོ།",
    "སྲིད་མོ་བདག་ནི་སྐྱེ་བོ་དག་གིས་དེ་ལྟར་ཤེས་སོ།",
    "དེ་སོང་ནས་དེའི་ཕ་མ་ལ་ཡབ་ཡུམ་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་མཆིས་སོ་ཞེས་སྦྲན་པ་ནས་དུ་མ་ཞིག་གིས་སྦྲན་ན་ཡང་དེ་དག་ཡིད་མ་ཆེས་ནས།",
    "དེ་དབྱིག་གི་ང་རོ་ཅན་ཞིག་པས་དེ་གཉིས་ཀྱིས་སྐད་ལས་ངོ་ཤེས་ནས་དེ་གཉིས་ཀྱིས་དེའི་མགུལ་ནས་འཇུས་ཏེ་དུ་བར་བརྩམས་པ་དང་།",
    "དེ་གཉིས་མཆི་མ་བྱུང་བས་མིག་གི་ལིང་ཏོག་བྱེད་ནས་བལྟ་བར་བརྩམས་སོ།",
    "ཡབ་ཡུམ་བདག་ཡང་དག་པར་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་འབྱུང་གིས་གནང་བར་མཛོད་ཅིག།",
    "བུ་ཁྱོད་ཀྱི་མྱ་ངན་དང་དུད་མོས་བདག་ཅག་མིག་ལྡོངས་པར་གྱུར་པ་ལས།",
    "ཉིད་འོངས་ནས་བདག་ཅག་གི་མིག་སོར་ཆུད་ཀྱིས།",
    "བཀྲེན་པ་ཕལ་མོ་ཆེ་ཞིག་དབུལ་བོར་ནས་ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོ་གང་ན་བདེར་སོང་སྟེ་ཕྱིན་ནས་ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོའ་རྐང་པ་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེས་རབ་ཏུ་ཕྱུང་ནས་མ་མོ་རྟོགས་པར་བྱས་ཏེ།",
    "རྡོ་ཅན་ཞེས་བྱ་བའི་ཡུལ་གྱི་མཐའ་ན་དགེ་སློང་གི་ཚོགས་ཉུང་སྟེ་གྲངས་བཅུར་བསྐང་བ་དཀའ་ནས།",
    "ཉེ་གནས་ཀྱི་དགེ་སློང་དག་གིས་ཡིད་ལ་བྱེད་པའི་ཁྱད་པར་དེ་དང་དེ་དག་བཟུང་ནས་ཆུབ་པར་བྱས་ཏེ་གྲོང་དང་།",
    "ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོའ་རྐང་པ་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་དེ་དག་གིས་ཇི་ལྟར་རྟོགས་པ་དག་སྨྲས་ཏེ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས་ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བདག་གི་ཚིག་འདིས་རེག་པར་སྤྱོད་དམ་ཞེས་བྱ་བའི་བར་དང་།",
    "བཙུན་པ་རྡོ་ཅན་ཞེས་བགྱི་བའི་ཡུལ་གྱི་མཐའ་ན་དགེ་སློང་ཉུང་བས་གྲངས་བཅུར་བསྐང་བ་དཀའ་ན་དེ་ལ་ཇི་ལྟར་བདག་གིས་བསྒྲུབ་པར་བགྱི།",
    "བཙུན་པ་བ་ལང་གི་རྗེས་ཀྱིས་ས་རྩུབ་པོར་གྱུར་པ་དང་།",
    "ལུག་གི་ལྤགས་པ་དང་།",
    "ལུག་གི་པགས་པ་དང་ཞེས་བྱ་བ་གོང་མ་བཞིན་ནོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རིས་ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོའ་རྐང་པ་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་ཚེ་དང་ལྡན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོའ་དྲུང་ནས་སོང་ངོ།",
    "ཀུན་དགའ་བོ་སོང་ལ་དེ་བཞིན་གཤེགས་པ་དང་།",
    "གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རེ་གཙུག་ལག་ཁང་གཅིག་ཏུ་ཁྲི་ཤོམས་ཤིག།",
    "དེ་བཞིན་གཤེགས་པ་དང་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་གཙུག་ལག་ཁང་གཅིག་ཏུ་ཁྲི་བཤམས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "གཙུག་ལག་ཁང་གི་ཕྱི་རོལ་དུ་ཞབས་གཉིས་བཀྲུས་ཏེ་གཙུག་ལག་ཁང་དུ་ཞུགས་ནས་དགོངས་པ་མངོན་དུ་བཞག་སྟེ་བཞུགས་སོ།",
    "ཚེ་དང་ལྡན་པ་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་ཡང་གཙུག་ལག་ཁང་གི་ཕྱི་རོལ་དུ་རྐང་པ་གཉིས་བཀྲུས་ནས་གཙུག་ལག་ཁང་དུ་ཞུགས་ཏེ་སྐྱིལ་མོ་ཀྲུང་བཅས་ལུས་བསྲང་ནས་དྲན་པ་མངོན་དུ་ཕྱོགས་པར་བཞག་ནས་འདུག་སྟེ།",
    "བཅོམ་ལྡན་འདས་དང་ཚེ་དང་ལྡན་པ་གྲོ་བཞིན་སྐྱེས་རྣ་བ་བྱེ་བ་རི་འཕགས་པའི་མི་སྨྲ་བས་དེའི་མཚན་མོ་འདས་པར་མཛད་དོ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ།",
    "སྟོབས་དང་བདེ་བ་དང་ཉམ་པ་མ་མཆིས་པས་བདེ་བ་ལ་རེག་པར་སྤྱོད་དམ་ཞེས་སྙུན་གསོལ་ལགས་སོ།",
    "དེ་ཡང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་ཞེས་བྱ་བ་ནས་བདེ་བ་ལ་རེག་པར་སྤྱོད་དམ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ངན་སོང་མཐོང་ཞིང་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཏེ་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བགྱིས་ལགས།",
    "གང་གི་ཚེ་རྒྱལ་པོ་ཀྲི་ཀཱི་ཤི་ནས་དེའི་བུ་ལེགས་སྐྱེས་ཞེས་བྱ་བ་དེ་རྒྱལ་སྲིད་ལ་བཞག་པ་དང་དེའི་བློན་པོ་དག་གིས་དཔྱ་ཉུང་ཤས་ཤིག་ཕུལ་ལོ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "གལ་ཏེ་ལྷས་གནང་ན་དཔྱ་དེ་བདག་ཅག་གིས་དགུམ་མོ།",
    "དེ་དག་གིས་བསམས་པ།",
    "གལ་ཏེ་ལྷས་གནང་ན་བདག་ཅག་གིས་ཅི་ནས་དཔྱ་དེ་དག་རང་འདུ་བར་མི་འགྱུར་བ་དེ་ལྟར་བྱའོ་སྙམ་ནས།",
    "དེ་དག་གིས་སྒོ་བཅད་དེ་བཞག་པས་ཕྱིན་ཆད་དཔྱ་འདུ་བ་ཆད་དོ།",
    "ཁྱོ་ཤུག་དེ་གཉིས་རྒས་པར་གྱུར་པ་ནས་མཆོད་རྟེན་དེ་ཉིད་ལ་བྱི་དོར་བྱེད་ཅིང་འདུག་གོ།",
    "བུ་བདག་ཅག་གིས་སྐྱིན་པོ་ཅུང་ཟད་ཀྱང་མ་བྱས་ཏེ།",
    "དེ་ཞིག་གིས་དོགས་པས་བླ་འོག་མ་བསྒྱུར་བར་ཉལ་ལོ།",
    "དེ་ནང་པར་སྔར་ལངས་ཏེ་ཡུལ་ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱི་དྲུང་དུ་སོང་བ་དང་དེས་དེ་ལ་སྨྲས་པ།",
    "གསུས་པོ་ཆེ་ཁྱོད་ཇི་སྙམ་དུ་སེམས།",
    "དེ་ཞིག་གིས་དོགས་ནས་ཁོ་བོ་བླ་འོག་ཀྱང་མི་སྒྱུར་བར་ཉལ་ལོ།",
    "བཞིས་ཁྲི་ཁྱེར་ནས་དེ་དག་སྲང་གི་དབུས་ནས་འདོད་པ་བྲམ་ཟེ་དང་།",
    "ཁྱིམ་བདག་དེ་དག་གིས་མཐོང་ངོ།",
    "འདི་དག་ནི་བདག་གིས་ཐོབ་བོ།",
