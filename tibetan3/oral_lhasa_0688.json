    "དགེ་སློང་རྣམས་ཀྱིས་ཅི་རན་ཙམ་དུ་བསྡད་པར་བྱའོ།",
    "བདག་ཉིད་ན་བ་ལས་བྱས་པ་ལམ་དུ་ཞུགས་པ་སྲ་བརྐྱང་བཏིང་བ་དང་།",
    "དེ་ལས་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "དེ་ལྟར་སེམས་པ་མེད་ན་ཕྱིས་བཟའ་བྱ་འགྲུབ་པར་འགྱུར་བ་དེ་ལ་ཉེས་བྱས་སུ་འགྱུར་ཞིང་།",
    "གང་རུང་གཅིག་ལ་གོས་ཀྱི་རྙེད་པ་མེད་ན་གོས་ཀྱི་རྙེད་པ་མེད་པ་དེ་ལས་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཡིད་ཀྱིས་དང་དུ་བླང་ན་བསྡམ་བྱའི་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཡིན་ལ།",
    "ཟ་བའི་མདུན་རོལ་ཏུ་འགྲོ་བ་ལ་སོགས་པ་ནི་བཤགས་བྱའི་ཉེས་བྱས་སོ།",
    "ཉིན་གཅིག་ལ་སྔར་གོས་དང་བཅས་པའམ་གོས་མེད་པའི་མགྲོན་དུ་བོས་པ་རྙེད་ནས་དེའི་རྗེས་སུ་གོས་དང་བཅས་པའི་མགྲོན་དུ་བོས་པ་གཞན་ཡོད་ན་ཟན་སྔ་མ་ལ་དྲངས་པར་ཟོས་ནས་དེང་འདི་ལས་མི་ཟའོ་ཞེས་སྤོང་བ་སྲུང་ཞིང་ཟན་སྔ་མ་ལ་འཇུག་པར་བྱ་ཞིང་།",
    "བྱིན་ལེན་མ་བྱས་པ་དང་རྟ་ཤ་སོགས་མི་རུང་བ་ལ་མགྲོན་དུ་བོས་པ་ཡང་མགྲོན་དུ་བོས་པ་ཉིད་མིན་ནོ།",
    "ཉི་མ་གཉིས་སུ་ཟན་མ་ཟོས་པར་གནས་ན་ཞག་ལོན་པ་ལ་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོའོ།",
    "ཞག་གཅིག་ལས་ལྷག་པ་གནས་པ་ལ་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "གཡོས་སུ་བྱས་པའོ།",
    "ལྷུང་བཟེད་འདི་སྙེད་ཅིག་བཞེས་ཅིག་ཅེས་ཚད་ཡོངས་སུ་མ་སྤགས་པར་༡༩༩བ་སྟོབས་པ་བྱེད་པ་པོ་ཡིན།",
    "ཇི་ཙམ་དགོས་པ་བཞེས་ཤིག་ཅེས་ཅི་བདེར་མ་བྱས་པ་དེ་བྱེད་པ་པོ་ཡིན་གྱི།་",
    "ཅི་བདེར་བྱས་པ་བླངས་ན་ཉེས་པ་མེད་དོ།",
    "བསོད་སྙོམས་ལྷག་པ་མནོས་པ་དེ་ལ་ནི་སྦྱར་བའི་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "དགེ་ཚུལ་ལའང་ཟས་ཟ་བའི་དགག་བྱ་ཡོད་པས་ཉེས་བྱས་ཡིན་གསུངས།",
    "ཐ་ན་ལན་ཚྭ་ཡན་ཆད་བཟའ་བ་དང་བཅའ་བར་བྱ་བ་གང་ཡང་རུང་བ་ཅུང་ཟད་ཅིག་བྱིན་ལེན་བྱས་ཏེ་བླངས་ན་ཟས་བརྩམས་པའི་རྣམ་པ་དེ་ཡིན་ནོ།་",
    "ཐུག་པ་སྤངས་པས་བཟའ་བར་བྱ་བ་སྤངས་པར་མི་འགྱུར་གྱི།་",
    "ཁོ་བོས་འཚལ་ལགས་ཏེ་ཟོས་ཟིན་ཏོ་ཞེས་བྱ་བས་ཀྱང་སྤངས་པ་ཡིན་ནོ།",
    "ཐུག་པ་དང་སྐྱོ་མ་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "བསམ་པ་ནི་ལྷག་པོར་བྱེད་པར་འདོད་པ།",
    "ཆོ་ག་ནི་སྤྱོད་ལམ་བསྟེན་པ་སོགས་བྱས་ཏེ།",
    "འཚལ་མ་འཚལ་ལགས་ཤིང་སྤངས་ཏེ་ཡོངས་སུ་རྫོགས་ཤིང་མཐར་ཐུག་པར་བགྱིས་པ་༢༡ན་ལས་བཅའ་བ་དང་བཟའ་བ་རྙེད་ཅིང་འཚལ་བར་འཚལ་ན་ལྷག་པོར་བགྱིས་ཏེ་བདག་ལ་བསྩལ་དུ་གསོལ།",
    "ལྷག་མར་བྱས་ཤིང་བོར་བས་ན་ལྷག་བོར་རོ།",
    "ཟས་རུང་བ་མིན་པ་གསོག་འཇོག་བྱས་པ་སོགས་དང་།",
    "འདི་ལས་གཞན་པའི་ཟན་མི་ཟའོ་ཞེས་མི་ཟ་བར་བརྟགས་པ་བྱས་པས་ཀྱང་ལྷག་བོར་བྱའོ།",
    "ཅི་བདེར་གསོལ་ཅིག་ཅེས་བྱ་བའི་ཚིག་བརྗོད་པར་བྱ་ཞེས་ཟེར།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་ཆོ་ག་མཚུངས་པའི་ཕྱིར་རོ།",
    "ལྷག་བོར་མ་བྱས་ཤིང་དཀོན་ཟས་མིན་པའོ།",
    "ཟས་ལྷག་པོར་མ་བྱས་པ་ཉིད་དག་ལའོ།་།",
    "སྤྱིར་བཏང་བ་དང་དམིགས་ཀྱིས་བསལ་བའི་ཚུལ་གྱིས་དུས་མིན་པར་ཟ་བ་ལ་སོགས་པ་བཞིན་ནོ།",
    "ཟོས་ཟིན་ཕན་ཆད་ལྷག་བོར་བྱས་ཀྱང་རུང་ལྷག་བོར་མ་བྱས་ཀྱང་རུང་བཅའ་བར་བྱ་བ་དང་བཟའ་བར་བྱ་བ་དག་བཟའ་བར་མི་བྱ་སྟེ།",
    "ཟོས་ན་ཡི་དམ་རལ་བར་འགྱུར་རོ་ཞེས་གསུངས།",
    "ཀུན་སློང་སྟོབས་པར་འདོད་པ།",
    "སྦྱོར་བ་སྟོབས་པར་རྩོམ་པ།",
    "སྤངས་པ་ཉིད་དང་ལྷག་བོར་མ་བྱས་པ་ཉིད་དག་ལའོ།",
    "གཉིས་པ་གནས་མིན་པར་ཟོས་པ་ལ་གཉིས་ལས།",
    "ལྷས་སྦྱིན་མི་མཐུན་པར་འདོད་པའོ།",
    "ཡོ་བྱད་ཐམས་ཅད་ཟད་པར་འགྱུར་བ་སོགས་ཡན་ལག་ལ་བཞི་ལས།",
    "ལས་བྱས་པ་དང་ལམ་དུ་ཞུགས་པ་དང་།",
    "བསྙེན་པར་མ་རྫོགས་པ་གསུམ་ལ་སོགས་པ་དང་ལྷན་ཅིག་ཀྱང་ཡིན་ནམ་ཞེ་ན།",
    "རྟགས་འདི་མེད་པའི་ཕྱི་རོལ་པའི་རབ་ཏུ་བྱུང་བའི་ཟས་མུ་སྟེགས་ཅན་གྱི་ལྟ་བ་རྣམ་པར་བཅད་པའི་ཕྱིར་དང་།",
    "གང་བྱས་ན་ཞེ་ན།",
    "ཟ་ན་ལྷན་ཅིག་ཉིད་ཡིན་ན་ནི་མ་དྲིས་པར་ཟོས་ན་ཡང་ཉེས་པ་མེད་དོ་ཞེས་གསུངས།",
    "དགེ་སྐོས་ལས་གཞན་པས་དགེ་སློང་ཐམས་ཅད་ཀྱིས་ཟན་མ་ཟོས་པར་གཡོས་མལ་ཚང་མང་དང་།",
    "གཉིས་པ་དུས་མ་ཡིན་པར་ཟོས་པ་ལ་གཉིས་ལས།",
    "ནག་པོ་ཆེན་པོ་བག་ཆགས་མ་བྱས་པས་སོ་སོར་མ་བརྟགས་པའོ།",
    "ཐུན་ཚོད་དུ་རུང་བའི་ཟས་བྱིན་ལེན་བྱས་པ་དེ་ཉིད་མ་བཤིག་པར་སྲོད་ཀྱི་ཐུན་ཚོད་ལས་འདས་པ་ནི་གསོག་འཇོག་བྱས་པ་ཡིན་ཏེ།",
    "གསོག་འཇོག་བྱས་པ་དེ་ཉིད་ལ་ཤེས་གཙོའོ།",
    "བཙོས་པ་ནི་བྱིན་ལེན་བྱས་ནས་ཡང་བཙོ་༢༤བ་བར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "བཙོས་པར་འགྱུར་བ་ལའང་རྗེན་དང་བྲལ་བ་དགོས་སམ་ཞེ་ན།",
    "རྒུན་ལ་སོགས་པ་མེས་རུང་བ་བྱས་པ་ནི་མ་བཙོས་པ་མིན་པས་མཚམས་ནང་དུ་ཤིང་ཐོག་མེས་རུང་བར་མི་བྱའོ།",
