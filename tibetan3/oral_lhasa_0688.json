    "ཁ་དོག་ཆེན་པོ་ཚོན་ཆེན་བརྒྱད་ཀྱིས་ཁ་བསྒྱུར་བའི་གོས་བསྒོ་བ་བསྟེན་པར་མི་བྱའོ།",
    "བརྒྱད་ནི་སུམ་བརྒྱ་པར།",
    "ཁ་ཚར་དང་ཕུན་ཚར་མ་བཅད་པའི་ཁྱིམ་པའི་གོས་ཀྱང་བསྒོ་བ་བརྟེན་པར་མི་བྱའོ།་།",
    "བདག་པོ་རྟགས་ཐམས་ཅད་ལ་མ་བབ་པར་མུན་སྤྲུལ་ཙམ་གྱིས་ཁོ་བོའི་ཡིན་ནོ་ཞེས་ཟེར་བ་ལ་རྫས་དེ་སྦྱིན་པར་མི་བྱའོ།",
    "གལ་ཏེ་རྫས་ཉོས་སམ་མ་ཉོས་པར་སྤྱོད་པ་དེ་ཚེ་བདག་པོ་འོངས་པར་གྱུར་ན།",
    "རྫས་དེ་བདག་པོ་དེ་ལ་སྦྱིན་པར་བྱའོ།",
    "་གསེར་དངུལ་ལས་བྱས་པའི་མགུལ་རྒྱན་དང་།",
    "མདའ་ཕྱེད་ལྕགས་ལས་བྱས་པ་རྣམས་ནི་མདེའུ་དང་བཅས་པ་ཉིད་ན་རུང་བའོ།",
    "སྐུ་གདུང་མེད་ན་ཉེས་བྱས་དང་།",
    "ཆོམ་རྐུན་པ་ལ་སོགས་པས་འཇིགས་པར་གྱུར་ན།",
    "རྒྱུ་གང་ལས་བྱས་པ་ཞེ་ན།",
    "རོ་ཉེའམ་ཟངས་སམ་ར་གན་ནམ་འཁར་བའམ་རྒྱ་སྐྱེགས་ཀྱི་ཚིགས་མའམ་ཤིང་ངམ་རྡོའམ་སའམ་བསོའམ་རྭ་དག་ལས་བྱས་པའོ།",
    "སོ་མངས་ཀྱིས་སྐྲ་ཤད་པར་མི་བྱའོ།",
    "སོ་མངས་དེ་ནི་དཔེ་ཡིན་པས་གཞན་གྱིས་ཀྱང་སྐྲ་ཤད་པར་མི་བྱའོ།",
    "གཉིས་པ་ནི་ས་དཀར་ལྟ་བུའི་དཔྲལ་རིས་གསུམ་བསྟེན་པར་མི་བྱའོ།",
    "སྒོའི་བྱང་ཐད་མིན་པར་གཞག་གོ།",
    "ག་བུར་དང་ཨུཏྤལ་སྔོན་པོ་སོགས་མིག་ལ་ཕན་པའི་དྲི་ཞིམ་པོ་དུས་དུས་སུ་བསྣམ་པར་བྱའོ།",
    "འཕྲེང་ཐོགས་པ་བསྟེན་པར་མི་བྱའོ།",
    "སྔགས་སྐུད་ཀྱང་ཐོགས་པ་བསྟེན་པར་མི་བྱའོ།",
    "དགེ་སློང་དེ་ཡང་རྣམ་པར་འཁྱམས་ཏེ་བབས་ཤིང་ཡང་བསྙེན་པར་རྫོགས་པ་ལས་རབ་ཏུ་བྱུང་བ་སྔ་མ་ནི་ཐ་དད་པ་ཡིན་པས་དེས་ཆོ་ག་སྔ་མ་ལ་བརྟེན་ནས་དེ་ལས་ཟས་ཟོས་ན་ཁ་ན་མ་ཐོ་བར་འགྱུར་རོ།",
    "ཟླ་བ་ཕྱེད་ཅིང་གནང་བའི་དུས་མིན་པ་དང་།",
    "ཆུ་མིན་པ་འབྲུ་མར་དང་འོ་མ་ལ་སོགས་པས་ཁྲུས་བྱེད་ན་ཡང་ཉེས་བྱས་སོ།",
    "ཨ་སྨ་པ་རན་ཏ་རྡོ་ཅན་ཞེས་བྱ་བའི་ཡུལ་དག་ལ་ནི་ཁྲུས་བྱ་བའི་ངེས་པ་འདི་མེད་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེར་རྟག་ཏུ་ཁྲུས་བྱ་བར་གནང་བའི་ཕྱིར་རོ།་།",
    "དེའི་ཕྱིར་དེར་ནི་བློ་གྲོས་དེ་ཉེ་བར་བཞག་སྟེ་དུས་མིན་པར་༢༣༣ན་ཡང་ཁྲུས་བྱའོ།",
    "དགེ་སློང་བཅུ་བསག་ཏུ་ཡོད་བཞིན་དུ་མཐའ་འཁོབ་ཏུ་ལྔ་ཚོགས་ལ་བརྟེན་པར་མི་བྱ་བ་ལྟ་བུའོ།",
    "ཀུན་སློང་གསོད་པར་འདོད་པ།"
  ]
}