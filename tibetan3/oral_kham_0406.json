    "དེར་ངུ་ཞིང་འདུག་པ་ན།",
    "ཐབས་ཅི་ཚུགས་ཏེ་ཇི་ལྟར་བྱས་ཀྱང་རང་ཉིད་བརླག་པར་འགྱུར་ཏེ།",
    "ཁྱི་ངན་པ་དེ་དོན་མེད་དུ་ཞེ་སྡང་སྐྱེས་ཏེ་ཟུག་ཅིང་ཕ་རོལ་པོའི་རྗེས་སུ་བསྙེགས་པས་རྡོ་འཕངས་པ་ཕོག་པ་ན་འཁང་ཞིང་དཔའ་ཞུམ་སྟེ་རང་སར་ཉལ་ནས་འདུག་པའི་སྤྱོད་ཚུལ་ལ་ལྟོས་ཞེས་པའོ།",
    "དེ་དག་རྫིང་བུར་ཞུགས་ནས་གླང་པོ་ཆེ་དེ་ཆུ་ནང་དུ་ནུབ་ནས་འདུག་པ་དང་།",
    "འདི་ལ་ཟབས་ཞེས་འདུག་ཀྱང་ཐིགས་༩༢ཟགས་ཀྱི་ཟགས་ཡིན་པར་སེམས།",
    "དེ་རང་༩༥མི་འོང་ངམ་སྙམ་སྟེ་སྐྲག་ཅིང་འདུག་པ་དང་།",
    "མི་མེད་པར་རྟ་གྲོག་པོའི་ཁ་ན་འདུག་པར་མཐོང་ནས།",
    "ཁྱེའུ་ཡང་སྤངས་འདུག་པས།",
    "ངེད་ཀྱིས་མི་ཐུབ་པར་གདའ་ཟེར་བས།",
    "རྒྱལ་པོ་རྒྱལ་སྲིད་དང་བཅས་པ་ལ་ཆགས་༡༦ཆེན་པོ་ཡོད་པས་དེའི་རིམ་གྲོར་བློན་པོ་ཆེ་བ་ཞིག་ཟླ་བ་གསུམ་གྱི་བར་དུར་དུ་འདུག་དགོས་པར་བསྒྲག་ཏུ་བཅུག་སྟེ།",
    "གླང་པོ་ཆེའི་རོ་ནི་ངས་མི་ཐེགཤ་ནི་ཟ་དགོས་པར་འདུག་སྙམ་སྟེ་སྨྲས་པ།",
    "རྒྱལ་པོས་ངོ་ཚ་༡༧༤ནས་མགོ་སྨད་དེ་འདུག་གོ།",
    "དེ་ཡང་མི་འོས་པའམ་མི་འགྲུབ་པའི་བྱ་བ་ལ་འཇུག་པ་ནི་བླུན་ཞིང་རང་ཉིད་བརླག་པའི་རྒྱུ་ཡིན་ཏེ།",
    "དེ་ལྷག་ཅིང་མང་བ་བཞིན་དུ་བཀྲ་མི་ཤེས་པའི་རྐྱེན་བྱེད་པའི་ཉེས་པ་དང་རང་གཞན་སྡུག་ལ་སྦྱར་བའི་སྐྱོན་ཤིན་ཏུ་ཆེ་སྟེ།",
    "ཙ་ན་ཀའི་བསྟན་བཅོས་ལས།",
    "ད་དམ་བཅས་པ་བཞིན་དུ་མཐུ་རྩལ་མི་སྟོན་པར་ཞུམ་ཞིང་འདུག་གམ།",
    "དེའི་ཚེ་གཞོན་ནུ་ནོར་བཟང་ཡང་འཁོར་དེ་ན་འདུག་པས།",
    "གོས་ངུར་སྨྲིག་བགོས་ཏེ་འདུག་གོ།",
    "སྟན་གཅིག་བོར་ནས་གཉིས་པ་ལ་འདུག་གོ།",
    "རི་དྭགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་ཟས་ཀྱིས་ལྟོ་འགྲངས་ཤིང་ཚིམ་པ་ན་གཞན་ལ་གནོད་པ་མིབྱེད་པར་གཞོགས་གཡས་པ་འོག་ཏུ་ཕབ་ནས་བདེ་བར་ཉལ་ནས་འདུག་པ་ལ་ལྟོས།",
    "མི་ངན་དེ་སྐྱེངས་བཞིན་དུ་མགོ་སྨད་དེ་འདུག་པ་མཐོང་ནས།",
    "ཕྱོགས་བཞིར་རྫུ་འཕྲུལ་སྣ་ཚོགས་བསྟན་ནས་ཁྲི་ལ་འདུག་སྟེ།",
    "རི་དྲུང་ཞིག་ན་སེང་གེ་རལ་པ་ཅོད་པན་ལྟ་བུ་དང་ལྡན་པ་ཞིག་འདུག་པ་དེས།",
    "རོ་བསྲེགས་པའི་མེ་ལ་ནེ་ལེ་འདུག་པ་དང་།",
    "ཟན་ལ་སྨིན་བྱེད་ཀྱི་རྫས་བསྲེས་ཏེ་མ་མ་ལ་བྱིན་ནས་དེ་ལ་འདུག་ཏུ་བཅུག་པས།",
    "རྒྱལ་པོ་དང་ལྷན་དུ་ཞག་བདུན་དུ་འདུག་ཅིང་།",
    "གུས་པ་དང་དད་པའི་རྣམ་འགྱུར་ཆེ་བ་ཞིག་འདུག་པས།",
    "ཁོས་༢༩༨སྐྱེངས་པས་ཁྱིམ་བདག་དེའི་མདུན་དུ་མ་འདུག་གོ།",
    "དེ་མཁས་ཤིང་སྤྱོད་ལམ་དང་འགྲོ་འདུག་འོ་བཟེ་བས་སྐྱེ་བོ་རྣམས་ཀྱི་ཡིད་དུ་འོང་བར་གྱུར་ཏོ།",
    "ཙ་ན་ཀ་རྒྱལ་པོའི་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "རང་རང་མངའ་རིས་རྣམས་ཀྱི་ཆོག་ཤེས་ཤིང་།",
    "༣༥༦ཀླད་ཆུང་རང་བཞིན་ངན་པ་ལ།",
    "ཅིས་ཀྱང་རང་བཞིན་མི་འགྱུར་ཏེ།",
    "ཙ་ན་ཀ་རྒྱལ་པོའི་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "༡༦རང་རང་ཕུགས་ཀྱི་དོན་པོ་ཆེ།",
    "༣༥བློ་ལྡན་མཁས་ཤིང་རང་བཞིན་དྲང་།",
    "ཤོད་དགོས་བྱུང་ན་མི་ཚེའི་ཁ་ལ་མི་ཚེ་མང་པོ་དགོས་འདུག་པས།",
    "རང་ནོར་རང་ལ་བདག་དུས་བསམ་བློ་ཐོངས།",
    "༡༡འགག་རྩར་༥༩ཐུག་དུས་དགོས་པའི་དུས་ཤིག་༦ཡོང་།",
    "གྱོང་རང་དྲགས་ན་འགག་ལ་ཐུག་པའི་ཉེན།",
    "འཇིག་རྟེན་འདི་རུ་སྒང་གཤོངས་༡༡མང་ཞིག་༡༢ འདུག།",
    "སྡུག་རྩ་ཐུག་དུས་སྒྱིད་༡༥༡བུ་གྲང་བ་མཐོང་།",
    "ལྟ་༡༦༡ལུགས་གཅིག་ལ་རིགས་ཀྱང་རིགས་གཅིག་འདུག།",
    "ནང་དོན་དངོས་རྣམས་རྒྱ་ཡིག་ནས་ཕབ་སྒྱུར་བྱས་ཏེ་རྒྱ་བོད་ཡིག་རིགས་གཉིས་ཀྱི་སྒོ་ནས་བཀོད་འདུག་ལ།",
    "གཅིག་ན་ཁ་བྱང་སྔོན་མ་དེ་བཏགས་ནས་དུས་ཡུན་ངེས་ཅན་ཞིག་འགོར་བས་ཀློག་མཁན་མང་པོ་དེ་ལ་གོམས་འདུག་པ་དང་།",
    "སྐུ་ཕུང་དེ་གཤགས་གཅོད་སྟེགས་བུའི་སྒང་དུ་གཅེར་བུར་བཞག་འདུག་ཁཾ་ནས་ཁྲག་དམར་ཆིལ་ལེར་ཐོན་འདུག་ལ།",
    "དུས་རབས་ཀྱི་འཕེལ་ཕྱོགས་ཆེན་པོ་ཞིག་སླེབས་པའི་སྐབས་སུ་ག་དུས་ཡིན་ཀྱང་།",
    "ཐོན་སྐྱེད་བྱེད་པའི་བརྒྱུད་རིམ་ཁྲོད་ནང་དོན་འདེམས་བྱེད་ཀྱི་ཚད་གཞིའམ་སྤྱི་འགྲོས་ཤིག་ཆོད་བསྡོམས་ཀྱིས་བསྟན་རྒྱུ་འདུག་པ་སྟེ།",
    "སྐབས་དེར་ཧྥ་ལ་ཅིས་ཏིང་ཞའོ་ཕིང་ལ་བཀའ་འདྲི་ཞུ་བའི་ནང་དོན་ནི་ཏིང་ཞའོ་ཕིང་རང་ཉིད་ཀྱི་སྐོར་དང་།",
    "ཡང་མུའུ་སུའེ་ཞིན་ཞེས་ཐད་ཀར་མིང་ནས་འབོད་ན་ཡང་ན་ཚོད་ཀྱི་ཧེ་བག་དང་མི་འཚམ་པས་ཡག་པོ་མི་འདུག་སྙམ།",
    "འདིར་འཚོ་བ་གོམས་འདྲིས་བྱེད་ཡག་གང་འདྲས་འདུག་གམ།",
    "ཁྱེད་རང་དེ་འདྲའི་དྲན་ཤེས་བརྟན་ཞིང་ངེས་རྩལ་ཆེ་བ་ལ་ཨང་།",
    "སྐབས་དེ་དུས་ཁྱེད་རང་ལས་འགུལ་ནང་བཞུགས་ཡོད་དམ།",
    "སྐབས་དེ་དུས་ཁྱེད་རང་མེ་འཁོར་ནང་ཡོད་དམ་ལྟ་བུར་མཚོན་ན་ལས་འགུལ་དེའི་ནང་བཞུགས་ཡོད་པ་དང་།",
    "གང་ཡང་བསམ་གྱི་མིན་འདུག་ལེའུ་བཅུ་གསུམ་པ།",
    "བཀའ་དྲིན་ཆེན་པོ་ཡིན་བསམ་གྱི་མིན་འདུག་གམ།",
    "ཁྱེད་རང་ད་བར་རྫུན་རྐུབ་རྡོལ་མྱོང་ཡོད་དམ།",
    "བཀའ་དྲིན་ཆེན་པོ་ཡིན་བསམ་གྱི་མིན་འདུག་གམ།",
    "གལ་སྲིད་ཅང་ཆིང་ལ་སྐར་མ་རྒྱག་ན་སྐར་མ་ག་ཚོད་རྒྱག་པ་འདུག་གམ་ཅེས་དྲིས་པའི་ལན་དུ།",
    "ཁྱེད་རང་གཅིག་པོ་ཡོང་བ་ཡིན་ནམ།",
    "ང་རང་གཅིག་པོ་ཡོང་བ་ཡིན།",
    "དུས་ནམ་ཡང་རང་སོར་འཇོག་རྒྱུ་ཡིན།",
    "སློབ་སྦྱོང་ཡག་པ་ཚོར་བསམ་འཆར་མང་བ་འདུག་གམ།",
    "ཡང་ན་སློབ་སྦྱོང་སྐྱོ་བ་ཚོར་བསམ་འཆར་མང་བ་འདུག་གམ།",
    "སྐབས་དེ་དུས་ཁྱེད་རང་ལས་བྱའི་སྡོད་ཁང་དུ་ཡོད་དམ་མེད།",
    "སློབ་སྦྱོང་ཁག་པོ་འདུག་གམ་ཞེས་དྲིས་ན་ཕལ་ཆེར་སློབ་ཕྲུག་ཚོས་དོ་སྣང་མི་བྱེད་པ་མ་ཟད།",
    "གལ་སྲིད་ཁོ་རང་ལ་ཡང་བློ་ཁོག་ཡོད་ན།",
    "མི་ཚོས་ཡེ་ནས་གོ་ཐོས་མ་བྱུང་བའི་གནས་ཚུལ་གསར་པ་ཞིག་དུས་ཐོག་ཏུ་སྤེལ་དགོས་ཀྱི་ཡོད།",
    "དེང་དུས་བོད་རིག་པ་ནི་འཛམ་གླིང་རང་བཞིན་གྱི་རིག་ཚན་ཞིག་ཏུ་གྱུར་ཡོད།",
    "མཐའ་མར་བལྟ་དུས་ཀླད་ཁྲག་འདྲེས་ནས་རྐྱེན་ལམ་དུ་ཤོར་འདུག་ཅེས་པ་ལྟ་བུ།",
    "དངོས་ཡོད་ཀྱི་གནས་ཚུལ་ལ་གཞིགས་ཏེ་དོན་དངོས་ཁོ་རང་ལ་དབྱེ་ཞིབ་བྱས་ཏེ་ལྟ་ཚུལ་མཚོན་དགོས་པ་ལས།",
    "ཁོ་རང་ལ་བློ་འབྱེད་ཆེན་པོ་བྱུང་བ་དང་།",
    "ཡང་ན་ང་ཡང་གཙང་སྦྲར་དགའ་ཞེས་བཀོད་འདུག་པ་དང་།",
    "ཚོང་ཁང་དག་ལ་དུས་ཆེན་གྱི་གཟབ་འཕྱོར་སྤྲས་འདུག་པ་དང་།",
    "དེ་ཡང་དུས་རབས་ཉིས་ཤུ་པའི་ལོ་རབས་དྲུག་ཅུའི་ནང་རང་དོན་སྤུ་ཙམ་མེད་ལེའུ་ཉེར་བཞི་པ།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འགལ་བ་དང་།",
    "ཤེས་པ་དེ་དག་ཀྱང་ལོ་མང་བེད་སྤྱོད་མེད་སྟབས་ད་ཆ་འབྲི་སྙམ་ཡང་མང་པོ་བརྗེད་འདུག་ཅེས་ཞུས་པ་དང་།",
    "ད་ལྟའི་བར་ཚིག་མཛོད་སྣ་ཚོགས་པར་འགྲེམས་བྱུང་ཡོད་ཀྱང་ངལ་རྩོལ་པའི་ལག་ཆ་ཅུང་ཆ་ཚང་ཙམ་ཡོད་པའི་ཚིག་མཛོད་མི་འདུག་གལ་ཏེ་གུས་པས་ངལ་རྩོལ་པའི་ལག་ཆ་ཡོད་དོ་ཅོག་ཚུད་པའི་ཚིག་མཛོད་ཅིག་རྩོམ་འབྲི་ལེགས་གྲུབ་བྱུང་ཕྱིན།",
    "བྱ་དངོས་ཀྱི་ངོ་བོ་དང་རང་བཞིན།",
    "བག་ཏུ་ཉལ་བའི་ཚུལ་དུ་གནས་འདུག་བསམ་པའི་ཚོར་སྣང་དྲག་པོ་ཞིག་སྐྱེས་བྱུང་།",
    "འདུག་ང་ལྷ་སར་ཡག་པོ་ཡོད།",
    "དགྲ་འགོ་རྒོད་པོ་ཤ་སྟག་ཏུ་སྣང་ཞེས་ལམ་ཡིག་ནང་རང་བྱུང་ཁམས་ཀྱི་ཉམས་སྣང་དང་དེ་གའི་མི་རྣམས་ཀྱི་ཀུན་སྤྱོད་དང་ཉམས་འགྱུར།",
    "གཞན་ཡང་རང་བྱུང་ཁམས་ཀྱི་སྤྱིའི་སྣོད་ཀྱི་བཀོད་པ་དང་ནང་བཅུད་ཀྱི་མི་ཚོའི་བསམ་སྤྱོད་བྲིས་པ་བརྒྱུད་མིའི་བློ་སྟོབས་དང་གཤིས་ཀ་ཀུན་སྤྱོད་སོགས་མཚོན་པ་བྱ་དགོས་ཀྱི་ཡོད།",
    "འཛུམ་མདངས་ལྡན་པར་པར་ལེན་བྱེད་བཞིན་འདུགནོར་གླིང་ལྷུན་གྲུབ་དགའ་ཚལ་གྱི་ནུབ་ངོས་སུ་ཤ་བ་དང་།",
    "ཞའོ་ཀྲུའོ་ཅི་ཡིས་འཛུམ་པའི་རྣམ་ར་དང་བཅས་དེའི་ཐོག་ལ་ང་རང་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "དུས་ནམ་ཡང་རང་སོར་འཇོག་རྒྱུ་ཡིན་ཞེས་གསུངས།",
    "ཇི་ལྟར་བུ་ཆུང་ཚུལ་དུ་འདུག་པ་ཡིས།",
    "སྟོང་བཞིན་དུ་སྣང་ཞེས་པ་དངོས་གནས་སུ་འདུག་པས་ཇི་བཞིན་སྒྲ་དང་སཇོ་ནང་དཔེ་ཚོགས།",
    "ཡིད་ཞབས་སུ་ངེས་རྒྱུ་གོ་རྒྱུའི་རྣམ་པར་མྱོང་འདུག་རྒྱུ་ཡོད་ཚད་ཐམས་ཅད་རྣམ་པར་ཤེས་པའི་སྣང་ཆ་འབའ་ཞིག་ཏུ་ཟད་པའི་དེ་དག་ཡིན་ནོ།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་གྱི་སེམས་བཞག་ཐབས་དང་རང་ངོ་ཟིན་པ་ཞིག་གལ་ཆེ་སྟེ་དེ་ཡང་རང་རིག་རང་གསལ་གྱི་བདེ་གསལ་མི་རྟོག་པའི་ཚུལ་མཚན་འཛིན་དམིགས་བྲལ་རང་བྱུང་བདེ་ཆེན་རང་ཉམས་འཛིན་མེད་དུ་མྱོང་ཞིང་གསལ་བ་ཀུན་ནས་བརྗོད་མེད་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ཇི་ལྟར་བུ་ཆུང་ཚུལ་དུ་འདུག་པ་ཡིས།",
    "ཐག་ཆོད་དེ་ལུས་སེམས་སྡུག་བསྔལ་བ་འདི་དང་རང་གཞན་རྣམས་ནམ་ཞིག་ཏུ་འབྲལ་བའི་དུས་ཚོད་ཅིག་ཡོད།",
    "འོན་ཀྱང་སྤྲོས་པ་ལ་དགའ་ན་འོད་ཟེར་སྤྲོ་བའི་མགོར་དར་ཅིག་ལ་འདུག་བཞིན་འདི་ལྟར་བསམ།",
    "བསྙེན་བཟླས་ཀྱི་རྗེས་སུ་སྣོད་བཅུད་རྟེན་དང་བརྟེན་པའི་དཀྱིལ་འཁོར་འོད་ཞུའི་སྒོ་ནས་རང་ལ་བསྡུ་ཞིང་རང་ཡང་ཡས་མས་ནས་ཐུགས་ཀའི་རྣམ་བཅུའི་ཡི་གེ་ལ་བསྡུས་ནས་དེ་ཡང་རིམ་པས་སྟོང་པར་ཡལ་བའི་ངང་དུ་མཉམ་པར་འཇོག་དགོས་ལ།",
    "ཡང་བར་འགར་སེམས་གནས་ཀྱི་གསལ་ངར་ཙམ་ཉམས་པའམ་དམིགས་རྣམ་མི་གསལ་བའི་བྱིང་བའི་སྐྱོན་བྱུང་ན་རང་གསལ་ངང་དུ་ཅེར་གྱིས་བལྟ་བ་དང་རང་ཡུལ་ལ་རྩེ་གཅིག་ཏུ་སེམས་གཞུར་བ་སོགས་ཐབས་སྣ་ཚོགས་པས་ཉེས་པ་དེ་ཡང་འགོག་པར་བྱེད་པའི་སྒོ་ཇོ་ནང་དཔེ་ཚོགས།",
    "ཐིམ་ཚུལ་ཡང་གཞན་ལུགས་ལ་སྐྱེད་རིམ་དང་རང་ལུགས་ལ་སྡུད་རིམ་ཡིན་ཞིང་།",
    "བསམ་གཏན་གྱི་སྐད་དོད་དྷྱ་ནཾ་ཞེས་པ་སེམས་པར་བྱེད་པ་སྟེ་དམིགས་པ་ལ་གཡོ་མེད་དུ་སེམས་པར་བྱེད་པས་ན་སྤྱིར་བསམ་གཏན་དང་སྐབས་འདིར་སོར་སྡུད་ཀྱིས་བསྒྲུབ་པའི་དམིགས་པ་སྟོང་གཟུགས་དང་རང་སེམས་འདྲེས་པ་དེ་ལས་གཞན་ཏུ་མི་གཡོ་བར་སེ་པར་བྱེད་པས་ན་བསམ་གཏན་ཞེས་བརྗོད་པའི་ཕྱིར།",
    "ཕྱི་མ་འདི་གཞན་ལྟར་ན་སྒྲས་བརྗོད་རིགས་ཀྱི་དབྱེ་བ་ཙམ་དུ་འདོད་ཀྱང་རང་ལུགས་ལ་དབྱེ་བ་མཚན་ཉིད་པར་བཞེད།",
    "གདོད་ནས་མ་གྲུབ་རང་རང་ངོ་བོས་སྟོང་།",
    "ང་རང་གྱོན་པའི་ཞྭ་སེར་ཕྱམ་ཚེ་གཉིས།",
    "ཆུ་སྲིན་ཁ་ཉི་མ་ལ་བསྟན་ནས་འདུག་པ་དང་།",
    "ཞག་ཚད་གནས་སོ་ཞེས་གསུངས་པའི་དགོངས་པ་དང་རང་ལུགས་མཐུན་པར་གསུངས་ལ་སྐབས་འདིའི་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "ནམ་ཞིག་དུས་བཞི་ཕྱི་མ་ལེགས་ཤར་སྐབས།",
    "དབྱིངས་དེ་ཉིད་ལས་ནོར་བུ་ལ་དགོས་འདོད་ལྟར་ཐུགས་རྗེ་བརྩེ་བ་རྒྱ་མཚོའི་བདག་ཉིད་ཀྱི་བྱེད་པས་གང་འདུལ་གྱི་འགྲོ་བ་མ་ལུས་པའི་རང་རང་དང་འཚམས་པར་སྲིད་ཞིའི་སྡུག་བསྔལ་ཅི་རིགས་སེལ་བར་མཛད་ཅིང་།",
    "ང་རང་བཞིན་གྱིས་གྲུབ་པར་འཛིན་པ་དེ་ཡིན་ལ།",
    "དམིགས་རྣམ་ལོགས་སུ་ཆེད་ཀྱིས་མ་བསྒོམས་ཀྱང་རང་ཤུགས་སུ་འཆར།",
    "འདི་ཡང་རང་དང་སྐལ་མཉམ་འགའ་ཞིག་ལ།",
    "དེའི་ཕྱིར་ནང་སེམས་ཞི་ན་ཀུན་ཞི་བ་དང་སེམས་དུལ་ན་ཀུན་དུལ་བ་མ་གཏོགས་ཡུལ་གྱི་དོན་སྟེང་ནས་དུལ་ཞིང་ཞི་བའི་ཐབས་ཚུལ་དཀའ་བ་བསྒྲུབ་པའི་ངལ་བ་དེས་ཅི་ཞིག་བྱ་སྟེ་ཅི་ཡང་དགོས་པ་མི་འདུག་གོ།",
    "དེ་དག་ཐམས་ཅད་སེམས་དཔའ་ཆེན་པོའི་སྤྲུལ་པའི་རོལ་གར་གྱི་བཀོད་ཆེན་གདུལ་བྱ་རང་རང་དང་འཚམས་པ་ལ་ཕྲིན་ལས་དུས་སུ་ནམ་ཡང་ཡོལ་སྲིད་པའི་གོ་སྐབས་གཏན་ནས་མ་དམིགས་པ་དེ་བས་ན།",
    "བཅུད་ལྡན་ཁ་དོག་མཛེས་པའི་འབྲས་བུ་བཟང་པོ་ཆེས་དཀར་བ་འཛིན་པའྀ་ལྕིད་ཀྱིས་རབ་དུད་ཅེས་པ་ཀུན་ནས་སྤངས་ཏེ་འབོ་ལེར་འདུག་པ།",
    "དགེ་སྦྱོར་བྱས་ཀྱང་རང་རྒྱུད་མ་ཐུལ་ཚེ།",
    "ད་ནི་ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "འོན་ཀྱང་དེ་ལྟར་ཡིན་འདུག་ཅེས་གཞན་དུ་རྒྱུག་མི་དགོས་ཏེ།",
    "འདུག་མ་ཐག་ལ་སོགས་ཀྱི་དོན་ནི།",
    "དེ་ལྟར་ཡོང་བ་ཡང་རང་གཅེས་འཛིན་གྱིས་ལན་པར་མཐོང་ནས་སོགས་ཇོ་ནང་དཔེ་ཚོགས།",
    "དེ་ལྟར་བྱེད་པ་ཡང་རང་གཅེས་འཛིན་གྱིས་ལན་པར་མཐོང་ནས་སོགས་སོ།",
    "ཡོན་ཏན་ཡོད་ཀྱང་མི་འདུག་ཅེས་སྐུར་བ་འདེབས་པར་བྱེད་པ་ཡང་བདག་གཅེས་འཛིན་གྱིས་བྱས་པར་མཐོང་ནས་སོགས་སོ།",
    "ད་ལམ་ནི་ངན་པའི་ལེ་ལན་ཐམས་ཅད་བདག་གཅེས་འཛིན་གཅིག་པུ་ལ་གདའ་ཡི་གཞན་སུ་ལ་མི་གདའ་བས་སྐྱེ་འགྲོ་གཞན་ཐམས་ཅད་ཀྱིས་ནི་རང་ལ་རྣམ་སྨིན་ངན་པ་ཟད་ཅིང་བཟང་པོ་སྨིན་པར་བྱེད་པ་འདི་ལ་བཀའ་དྲིན་ཤིན་ཏུ་ཆེ་བར་སྒོམས་ལ།",
    "གཞན་ཡང་འགྲོ་འདུག་སྤྱོད་ལམ་ཀུན་ཏུ།",
    "རབ་ཏུ་དམའ་བའི་ས་ལ་འདུག།",
    "དུས་ད་ལྟ་ལུས་ཀྱི་རྩ་ན་གདའ།",
    "ཕ་རོལ་པོ་ཤི་བ་མཐོང་ཡང་རང་འཆི་བ་མི་ཤེས་པས་ལེ་ལན་དང་པོ་དེ་ལ་ཐུག་ཅེས་དང་།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།",
    "མི་འབྲལ་འདུག་པར་འདོད་ཀྱང་འགྲོ་བར་ངེས།",
    "གང་བསྟེན་བསྟེན་པ་ཀུན་རྒྱལ་ནས་གདའ།",
    "གང་བསྟེན་བསྟེན་པ་ཀུན་བརླགས་ནས་གདའ།",
    "ཨ་ཙ་ར་མིག་ཕོར་ཁོག་ཙམ་བསྒྲད་པ་ལྔ་གཟིམ་ཁང་དུ་འདུག་པས།",
    "སྟོན་པས་པུ་ཏོ་བ་ཁོང་ཅི་མཛད་ཀྱིན་གདའ་གསུངས་པས།",
    "རང་གཞན་གྱི་ཡོ་བྱད་མང་པོས་རྟེན་གསུམ་འབའ་ཞིག་བཞེངས་ཤིང་གདའ་ཞུས་པས་སྔར་བཞིན་གསུངས།",
    "ཁོང་སྒོམ་འབའ་ཞིག་མཛད་ཀྱིན་གདའ་ཞུས་པས།",
    "ཁམས་པ་ལུང་པ་ཁོང་ཅི་མཛད་ཀྱིན་གདའ་གསུངས་པས།",
    "དབུ་བཏུམས་ཏེ་བཤུམ་པ་འབའ་ཞིག་མཛད་ཅིང་གདའ་ཞུས་པས།",
    "ཁྱེད་རང་ཇི་ལྟར་འདོད་པ་དེ་གཞན་རྣམས་ཀྱང་དེ་ལྟར་འདོད་པ་ཡིན་པས་དེ་དང་སྦྱོར་ཅིག་གསུངས།",
    "ཟེར་བ་ཞིག་འདུག་པས།",
    "བྱ་བ་གཅིག་གདའ།",
    "སྲུང་སྡོམ་དག་པ་གཅིག་པུས་གར་ཡང་མི་ཕྱིན་པར་འདུག་གསུངས།",
    "འོ་བརྒྱལ་བར་འདུག་པས་ངེད་རྣམས་ཀྱིས་བྱེད་པར་ཞུ་ཞུས་པས།",
    "ནོར་མེད་ཙ་ན་དགྲ་དང་བྲལ།",
