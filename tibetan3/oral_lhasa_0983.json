    "འདིར་དང་པོ་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་དཀྱིལ་འཁོར་གྱི་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བའི་སྒྲ་ནི་དེ་མ་ཐག་པར་སྟོན་པའི་ཚིག་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚིག་བཞི་ཕན་ཡོན་དང་བཅས་པར་གསུངས་པའོ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "དེ་རྣམས་ཀྱི་མཉམ་པ་ཉིད་ནི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བའོ།",
    "གསུངས་སོ་ཞེས་བྱ་བ་ནི་འདི་སྐད་དུ་བཀའ་སྩལ་པའོ།",
    "དེ་ནས་འདི་གསུངས་པ་ཙམ་གྱིས་ཞེས་བྱ་བ་ནི།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་གསུངས་པ་ཙམ་གྱི་རྗེས་ཐོགས་ཉིད་ལའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའོ།",
    "ཡང་དག་པར་འདུས་ནས་ཞེས་བྱ་བ་ནི་ཚོགས་པར་མཛད་པའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱོགས་ཐམས་ཅད་དུ་ཞེས་བྱ་བ་ནི་ཕྱོགས་བཞིར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་གྱིས་བཞུགས་པ་དང་ཞེས་བྱ་བ་ནི།",
    "རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་ཆེན་པོའི་དབྱིངས་ཀྱིས་བཞུགས་པའོ།",
    "ཕྱོགས་དང་མཚམས་སུ་བཞུགས་པའོ།",
    "ཡིད་བདེ་བ་སྐྱེས་པར་གྱུར་པས་བཞད་པ་ཆེན་པོས་བཞད་པར་གྱུར་པ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱི་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གསུམ་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་ཆེན་པོའི་དཀྱིལ་འཁོར་རོ།",
    "དེ་ལ་སྙོམས་པར་འཇུག་པ་ནི་མངོན་སུམ་དུ་མཛད་ནས།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིས་དཀྱིལ་འཁོར་ཆེན་པོ་འདི་གསུངས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་སྟོན་པར་བྱེད་པས་གང་ལ་དེ་སྐད་ཅེས་བྱ་བ་ནི་དམ་ཚིག་ཆེན་པོའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་དེ་གསུངས་ཏེ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས།",
    "དཀྱིལ་འཁོར་གྱི་རྣམ་པར་སེམས་རྩེ་གཅིག་ཏུ་བྱ་སྟེ།",
    "གང་དཀྱིལ་འཁོར་འདི་དག་བར་སྣང་ལ་གནས་པའི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་འོག་ཏུ་ཡང་བྲི་བར་བྱ་ཞིང་།",
    "དེའི་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱིའོ།",
    "སྤྲུལ་པའི་སྐུ་གཟུགས་ཅན་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་བརྒྱད་ཡང་དག་པར་གཞག་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ལ་བཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་རྡོ་རྗེ་འཛིན་བ་དང་བཅས་པར་བྲི་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "རྣལ་འབྱོར་པ་དེས་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ལ་ཟླུམ་པོར་བསྐོར་ནས།",
    "བུམ་པ་གང་བ་བཞི་སྒོ་རྣམས་སུ་དགོད་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དཀྱིལ་འཁོར་གྱི་སྒོ་བཞིར་བུམ་པ་གང་བ་བཞི་ལེགས་པར་གཞག་པར་བྱའོ།",
    "འབྲས་སཱ་ལུ་ལས་སྐྱེས་པའི་ལྗང་བུ་དང་བཅས་པའི་སའི་དུམ་བུ་དགོད་པར་བྱ་སྟེ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "གསུམ་པ་ནི་སུམ་འགྱུར་དུ་ཟླུམ་པོར་དེ་ཡོངས་སུ་བསྐོར་བར་དཀྱིལ་འཁོར་ཀུན་དུ་ཐིག་བཏབ་ལ་ལེགས་པར་བྲིས་ཏེ།",
    "འཇམ་པའི་དབྱངས་དང་བཅས་པར་རྡོ་རྗེ་སེམས་དཔའི་དཀྱིལ་འཁོར་གྱི་ཚུལ་དུ་བྲི་བར་བྱའོ།",
    "ལྷག་མ་རྣམས་ནི་སྔར་སྨྲས་པར་ཟད་དོ།",
    "དེ་བཞིན་དུ་གཞན་དག་ཀྱང་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོ་བསྒོམ་ཞིང་།",
    "མཚན་བརྒྱ་རྩ་བརྒྱད་ཀྱིས་བསྟོད་པར་བྱའོ།",
    "རྡོ་རྗེ་བསྲུང་བས་བསྲུང་བ་ཐམས་ཅད་ཡང་དག་པར་བསྲུངས་ལ།",
    "ཨ་དྲྀ་ཤྱ་ཞེས་བྱ་བ་ནས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ཐམས་ཅད་བལྟ་བར་བྱས་ནས།",
    "དེ་ཐམས་ཅད་བསྒྲུབ་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ལྗགས་ལ་ཡང་ཨ་ཞེས་བྱ་བ་བསམ་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ལས་ཀྱི་ཕྱག་རྒྱ་ཨ་ཞེས་བྱ་བ་ཟློས་བཞིན་དུ་བཅིང་བར་བྱས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱའོ།",
    "མི་བསྐྱོད་པའི་ཕྱག་རྒྱ་ལས་ལག་པ་གཡས་པ་བ་དན་གསུམ་པ་ལྟར་བྱས་ལ།",
    "མི་འཇིགས་པ་སྟེར་བའི་ཚུལ་གྱིས་བཞག་པ་ནི་དོན་ཡོད་པར་གྲུབ་པའི་ཕྱག་རྒྱའོ།",
    "གཉིས་ཀས་སྙིམས་པ་དང་བཅས་པར་བསྟོད་པའི་ཚུལ་དུ་བཞག་པ་འདི་ནི་ཕྱག་ན་རྡོ་རྗེའིའོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་རྒྱ་ཆེན་པོ་ནི་བྲིས་པའི་རྗེས་སུ་འབྲངས་ནས་བསམ་པར་བྱའོ།",
    "དེ་ལྟར་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ལ་སོག་སྤ་ཕྱག་རྒྱ་བཞིས་རྒྱས་བཏབ་པ་བྱས་ནས།",
    "མེ་ཏོག་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ལ།",
    "དེ་ནས་ཡིད་ཀྱིས་དཔག་བསམ་གྱི་ཤིང་ལ་སོགས་པའི་སྤྲིན་རྣམས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཡང་དག་པར་མཆོད་ལ།",
    "ཕྱི་རོལ་ཏུ་གཏོར་མ་སྦྱིན་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་སྣ་མ་བཞིན་དུ་ཐབ་ཀྱི་དབུས་སུ་དཀྱིལ་འཁོར་གྱི་ཚུལ་གྱིས་བཀོད་ནས།",
    "དེས་གདོང་གཡོགས་བྱས་ལ།",
    "རྣམ་པར་སྒེག་པའི་རྡོ་རྗེས་ཕྱག་བྱའོ།",
