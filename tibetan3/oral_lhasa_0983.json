    "ཧ་ཧ་ཞེས་དགོད་ཅིང་བཟླས་པས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་སྦྱོར་བ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ལ།",
    "ཁྱིམ་ལ་སོགས་པ་ལ་གནོད་པ་བྱེད་པའི་གནོད་སྦྱིན་མ་རུངས་པ་རྣམས་ཧ་ཧ་ཧ་ཧཱུཾ་དུཥྚ་ཡ་ཀྵཨུཙྪ་ཊ་ཡ་ཧཱུཾ་ཞེས་བྱ་བ་ཧ་ཧ་ཞེས་དགོད་པས་ཁྲོ་བོ་ཆེན་པོས་ཁྱབ་པ་དང་བཟླས་བརྗོད་བྱས་ལ་ཁ་ལས་རྡོ་རྗེ་འཛིན་པ་ལ་སོགས་པའི་ཁྲོ་བོའི་ཚོགས་སྤྲུལ་ནས་ཕྱུང་བ་འཇིགས་བྱེད་ཆེན་པོའི་གཟུགས་ཅན་དེ་རྣམས་ཀྱིས་གནོད་སྦྱིན་གདུག་པ་དེ་རྡོ་རྗེ་འབར་བ་ལ་སོགས་པས་བསྲེགས་པར་གྱུར་པ་དང་།",
    "དབྱིག་པ་ལ་སོགས་པ་རྣམས་ཀྱིས་བརྡེགས་པར་གྱུར་པ་དང་།",
    "སྐྲོད་པར་གྱུར་པར་རྣམ་པར་བསམས་ལ།",
    "དེ་ལྟ་བུས་ནི་གནོད་སྦྱིན་ཐམས་ཅད་སྐྲོད་པར་འགྱུར་རོ།",
    "དེས་ཀྱང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ལྟ་བུ་འབར་བའི་ཚོགས་ཀྱིས་ཁྱེར་ཏེ་འོངས་པར་བསམ་པར་བྱ་སྟེ།",
    "དེ་ལྟ་བུས་ནི་ཀླུ་ཐམས་ཅད་འབྱིན་པར་འགྱུར་རོ།",
    "འདིས་སྔ་མ་བཞིན་དུ་ལུས་ངན་པོ་དང་རྣམ་ཐོས་སྲས་སྒྲུབ་པའི་སྦྱོར་བས་མནན་ལ་དཔལ་དབྲོག་པར་བྱའོ།",
    "དེ་ནས་དེས་དེ་རྣམས་མཐོང་བས་བསམ་གཏན་ལས་ཉམས་པར་གྱུར་ཏེ།",
    "འདིས་ནི་ཁྱབ་འཇུག་འཇིག་པར་འགྱུར་རོ།",
    "གསང་བའི་དངོས་གྲུབ་རྣམ་པར་གཏོར་བ་ཞེས་བྱ་བ་ནི་ཕན་ཚུན་དུ་རྣམ་པར་གཏོར་བ་སྟེ།",
    "དེ་ཉིད་ནི་རྣམ་པར་འཇིག་པའོ།",
    "རྡོ་རྗེ་ཁྲོ་བོའི་གདུག་པའི་དམ་ཚིག་འཇིག་པར་བྱེད་པས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་ཉིད་དེའི་ཚུལ་གྱིས་སྦྱར་བ་ནི་རྡོ་རྗེ་ཁྲོ་བོ་གདུག་པའི་དམ་ཚིག་འཇིག་པར་བྱེད་པར་འགྱུར་རོ།",
    "གསེར་ལ་སོགས་པའི་དངོས་པོ་རྣམས་ཁྲོ་བོའི་ཁུ་ཚུར་གཉིས་ཀྱིས་བླངས་ལ་དབྲོག་པར་བྱ་སྟེ།",
    "འདིས་ཐམས་ཅད་འཕྲོག་པར་འགྱུར་རོ།",
    "གཞན་རྣམས་ལ་འཇིགས་པ་བསྐྱེད་པར་བྱ་སྟེ།",
    "འདིས་དཔུང་ཐམས་ཅད་གསོད་པར་འགྱུར་རོ།",
    "འདིས་གཞན་གྱི་དཔུང་ཐམས་ཅད་གཞོམ་པ་ལ་སོགས་པ་བྱེད་པར་འགྱུར་རོ།",
    "འདིས་ས་ཐམས་ཅད་ནུབ་པར་འགྱུར་རོ།",
    "དེ་བསལ་བ་ལ་ནི་རྣམ་པར་གཞིག་པའོ།",
    "ཐམས་ཅད་བྱས་ལ་གཡས་པས་རྡོ་རྗེ་འབར་བ་གསོར་ཞིང་ཧཱུཾ་ཞེས་བྱ་བ་དང་།",
    "འཇིག་རྟེན་གསུམ་པོ་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བ་ལ་ནི།",
    "ངེས་པར་གནོན་པར་འགྱུར་རོ།",
    "འདིས་ཁམས་གསུམ་ཐམས་ཅད་རྗེས་སུ་ཆགས་པར་བྱ་བ་དང་།",
    "གནོན་པར་གྱུར་པ་རྣམས་སྒྲུབ་པར་འགྱུར་རོ།",
    "དབབ་པ་ནི་བབ་པར་བྱས་པའོ།",
    "བཅིང་བ་ནི་མི་འགུལ་པར་བྱས་པ་དང་།",
    "དེ་རྣམས་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱིར།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་ཡུལ་ལ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱིས་དབུགས་དབྱུང་བས་ཁྲོ་བས་ཁྲོ་བ་སྤང་བ་གསུངས་ནས།",
    "དེ་ནས་ཞེས་བྱ་བའི་སྒྲ་ནི་འདས་མ་ཐག་པའི་དོན་སྟོན་པར་བྱེད་པ་སྟེ།",
    "སྔ་མ་བཞིན་དུ་ཐམས་ཅད་བྱས་ནས།",
    "དེའི་རྗེས་ཐོགས་ཉིད་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱི་པའི་ཚུལ་འདི་གསུངས་པའོ།",
    "དེ་ཉིད་ཕྱིན་ཅི་མ་ལོག་པར་ཐུགས་སུ་ཆུད་ཅིང་བརྙེས་པས་ན་དེ་བཞིན་གཤེགས་པའོ།",
    "འདོད་ཆགས་སྤྲོས་པ་མེད་པར་བསྟན་པ་ལ་ལྟོས་ནས་ཡང་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་ཤིན་ཏུ་མཉམ་པར་གཞག་པའི་སྦྱོར་བས་མངོན་སུམ་དུ་མཛད་པའོ།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པའི་འཆིང་བས་མ་བཅིངས་པའོ།",
    "འདི་ཞེས་བྱ་བ་ནི་འདས་མ་ཐག་པའི་འོག་ཏུ་སྟོན་པར་འགྱུར་བའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བློ་ལ་བཞག་ནས་འདི་སྐད་དུ་སྨྲས་པའོ།",
    "གསུངས་ཏེ་ཞེས་པ་ནི་བཀའ་སྩོལ་བར་མཛད་པའོ།",
    "དེའི་རྣམ་པར་དག་པ་ནི་དེ་བཞིན་ཉིད་དེ་དེས་ནི་ཞེ་སྡང་ཐམས་ཅད་དག་པར་འགྱུར་རོ།",
    "དེའི་རྣམ་པར་དག་པ་ཡང་དེ་བཞིན་ནོ།",
    "ཞེ་སྡང་ཐམས་ཅད་ཀྱི་རྣམ་པར་དག་པར་གྱུར་པ་ནི་ཞེ་སྡང་ཐམས་ཅད་རྣམ་པར་དག་པ་སྟེ།",
    "དེའི་དོན་དུ་འཇུག་པར་འགྱུར་ཞིང་རྒྱུར་གྱུར་པས་རབ་ཏུ་སྒྲུབ་པའོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "འདོད་ཆགས་ཐམས་ཅད་ནི་རྨི་ལམ་ལྟ་བུར་རྟོགས་པར་ཐོབ་པས།",
    "ཞེ་སྡང་ཐམས་ཅད་རྨི་ལམ་ལྟ་བུར་རྟོགས་པར་གྱུར་ཏེ།",
    "རྗེས་སུ་ཆགས་པ་མེད་པས་ཞེ་སྡང་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་རྣམ་པར་དག་པ་ཡང་དེ་བཞིན་ནོ།",
    "དྲི་མ་ཐམས་ཅད་རྣམ་པར་དག་པར་གྱུར་པ་ནི།",
    "དྲི་མ་ཐམས་ཅད་རྣམ་པར་དག་པ་ཉིད་དེ།",
    "དེའི་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱི་རྣམ་པར་རྟོག་པ་དང་།",
    "གཏི་མུག་མེད་པས་ན་ཉེ་བར་སྤྱོད་པ་ལ་ཀུན་དུ་སྤྱོད་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་རྣམ་པར་དག་པ་ཡང་དེ་བཞིན་ནོ།",
    "དེ་རྣམས་རྣམ་པར་དག་པ་ནི་ཚངས་པ་ལ་སོགས་པ་རྨི་ལམ་ལྟ་བུར་རྟོགས་པའོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་རྣམས་ཀྱི་རྣམ་པར་དག་པ་ཡང་དེ་བཞིན་ནོ།",
    "ཤེས་པ་ཐམས་ཅད་རྣམ་པར་དག་པར་འགྱུར་བ་ནི་ཤེས་པ་ཐམས་ཅད་རྣམ་པར་དག་པ་ཉིད་ཀྱིས་སོ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་རྣམ་པར་དག་པར་འགྱུར་རོ།",
    "ཤེས་པ་ཐམས་ཅད་རྣམ་པར་དག་པའི་རྒྱུ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "ད་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ནས་ཞེས་བྱ་བའི་སྒྲ་ནི་འདས་མ་ཐག་པ་སྟོན་པར་བྱེད་པའི་ཐ་ཚིག་གོ།",
    "ཇི་སྐད་གསུངས་པའི་འདོད་ཆགས་ལ་སོགས་པའི་དྲི་མས་མི་གོས་པ་ལ་བལྟ་ཞིང་རྣམ་པར་རྟོག་པའོ།",
    "འདི་ཞེས་བྱ་བ་ནི་འདས་མ་ཐག་པའི་འཆད་པར་འགྱུར་བ་བློ་ལ་བཞག་ནས་སྨྲས་པའོ།",
    "གསུངས་སོ་ཞེས་བྱ་བ་ནི་བཀའ་སྩལ་པ་སྟེ།"
  ]
}