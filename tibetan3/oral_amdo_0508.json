    "སྟེང་མ་བྱ་མགོ་ནག་པོའི་སྔོན་མོ།",
    "སྲིན་མོ་སྤུན་དགུ་ཏྲི་ཛ་ནན།",
    "མཐར་གོང་གི་ཡཾ་ཤུད་དམར་པོ་ནས།",
    "ཨོཾ་མཧཱ་མགོན་པོའི་མནན་སྔགས་འདི་གོང་གི་སྲི་རིགས་སྤྱི་འགྲོའི་ལིངྒའི་མཐར་ཡང་བྲིས་ན་ཤིན་ཏུ་ལེགས་མོད།",
    "མོ་ཧ་ཡ་མོ་ཧ་ཡ།",
    "དེ་ལྟར་འདི་ནི་གནངས་ཆུང་མོད།",
    "ཕྱོགས་བཅུར་བཞུགས་པ་སོགས་སྐྱབས་སེམས་ནས་འབར་བ་མེ་ཡི་མཚམས་ལས་མ་འདའ་ཞིག་གི་བར་གོང་གནོན་སྔགས་བྱང་དཀྱུས་བཞིན་དང་།",
    "མདུན་བསྐྱེད་མངོན་རྟོགས་མཆོད་བསྟོད་རྒྱས་བསྡུས་ལོང་སྐབས་དང་བསྟུན་དགོས་ཀྱང་ཧ་ཅང་རྒྱས་པ་ནི་འོག་གི་ཆོ་ག་དངོས་དང་བཟླས་པའི་གྲངས་ལ་གནོད་པས་རྒྱུན་གཏན་གྱི་གཏོར་བསྔོ་ལྟར་རམ་དེ་ལ་མཆོད་བསྟོད་ཅུང་ཟད་བསྣན་ཀྱང་འཐུས།",
    "ཛ་དམ་ཚིག་ཆེན་པོ་ནས་མྱུར་དུ་བསྒྲལ་བའི་ལས་མཛོད་ཅིག་རོལ་མོའི་འོག་ཏུ་རྦད་སྔགས་ཚར་གསུམ་བདུན་ཅི་རིགས་བཟླས་རྗེས་ཉེས་པ་བསྒྲགས་པ་ནི།",
    "དམ་སྲི་བྱ་མའི་སྡིག་ཅན་ཁྱོད།",
    "གནོད་པར་བྱེད་པའི་དམ་སྲི་ཁྱོད།",
    "ཞེས་སོགས་ནས་དམིགས་པའི་རྟེན་འདི་ལ་ཁུག་ཅིག་སྲི་ཅན་འབྱུང་པོ་ཏྲི་ཨངྐུ་ཤ་ཛ་ཛ་ཅེས་པའི་མཐར་དྲག་རོལ་དང་བཅས་པའི་དགུག་གཞུག་ཉུང་མཐའ་ཉེར་གཅིག་ནས་མང་མཐའ་བརྒྱའི་བར་ལོང་དང་བསྟུན་པ་བྱས་རྗེས་རོལ་མོ་བཞག་ལ་སྨྲ་བ་བཅད་དེ་སྲིའི་འབོད་སྔགས་བཟླ་བ་ནི།",
    "མ་ཏྲི་ནི་ཛ་ཤོག་ཅེས་བརྒྱ་རྩ་ཙམ་བཟླས་མཐར་ཐུན་འཇོག་ཁར་ལིངྒ་གུ་གུལ་གྱིས་བདུག་ཨོཾ་མཧཱ་ཀ་ལ་གིངྐར་སོགས་བསད་སྔགས་ཚར་བདུན་དང་།",
    "ཨོཾ་མཧཱ་ཀ་ལ་གིངྐར་ནས་ཐུཾ་རིལ་རྦད་ཀྱི་བར་དང་།",
    "གོང་བཞིན་དགུག་གཞུག་བསྡུས་པ་ཚར་གཅིག་གི་རྗེས་སུ།",
    "ཁྲག་སྣ་མི་ཟད་རླན་ཆགས་ཞག་གིས་བྲན་ནས།",
    "ཞེས་པའི་ཤློ་ཀ་གཉིས་སོང་རྗེས་དྲག་རོལ་དང་བཅས།",
    "མདུན་བསྐྱེད་ལ་བཏང་རག་གི་མཆོད་བསྟོད་ཡིག་བརྒྱ།",
    "དགུག་གཞུག་རྒྱས་པ་ཚར་གཅིག་དམ་ཅན་བསྐུལ་བ་ཉེས་པ་བསྒྲགས་པ་རྣམས་སོང་རྗེས་དགུག་གཞུག་བསྡུས་པ་མན་ཆད་སྔར་ལྟར་བྱ་ཞིང་།",
    "དམ་སྲི་བྱ་བའི་སྡིག་ཅན་ཁྱོད།",
    "དགོང་མོའི་ཐུན་གྱི་མཐར་ཚོགས་མཆོད་བསྐང་བཤགས་སོགས་ཀྱང་རྒྱས་པར་བྱའོ།",
    "དེ་ལྟ་བུས་རབ་ཏུ་ཁུག་རྟགས་དངོས་ཉམས་རྨི་ལམ་དུ་གསལ་བའམ་ཐ་མ་སྒྲུབ་ཞག་བདུན་མ་ལྟ་བུའི་སྐབས་སུ་ཞག་གཉིས་སོགས་སོང་རྗེས་སྲི་བྲབ་ཅིང་བསད་པ་ནི།",
    "དམ་ཅན་བསྐུལ་བའི་མྱུར་དུ་བསྒྲལ་བའི་ལས་མཛོད་ཅིག་གི་མཐར་རྦད་སྔགས་ཀྱི་བར་སོང་རྗེས།",
    "རྦད་སྔགས་གསུམ་ཚར་གཅིག་གིས་མགོ་དྲངས་ནས།",
    "ཨོཾ་མཧཱ་ཀ་ལ་གིངྐ་ར་སོགས་ཉེར་གཅིག་ཨོཾ་སརྦ་ན་ཏྲི་ནི་རྦད་ནན་མཱ་ར་ཡ་སོད།",
    "དམ་སྲི་བྱ་བའི་སྡིག་ཅན་ཁྱོད།",
    "ཕྱིན་ཆད་ངན་སྤྱོད་བགག་པར་བྱེད་ཀྱི་བར་སོང་རྗེས་ཐུན་བརྡེག་པ་དང་སྦྲགས།",
    "ཨོཾ་མཧཱ་ཀ་ལ་གིངྐ་ར་སོགས་དང་།",
    "སོད་སོད་མཱ་ར་ཡ་སོད་སོགས་ནས་ཐུམ་རིལ་ལི་ཧཱུྃ་ཕཊ་ཀྱི་བར་གོང་གི་སྔགས་གསུམ་སྦྲེལ་བའི་མཐར།",
    "དམ་སྲི་བྱ་བའི་སྡིག་ཅན་ཁྱོད།",
    "ཕྲིན་ལས་མགོན་པོ་སོགས་སྦྲེལ་ཏེ་བརྡུང་བའི་གཞུང་བྱ་བ་ལས་ཐུན་བྱིང་རྫོགས་མཚམས་དེར་རོལ་མོ་རིང་ཙམ་གྱི་འོག་ཏུ་གོང་གི་སྲིའི་བསད་སྔགས་རིང་ཐུང་རྣམས་བཟླ་ཞིང་ཐུན་རྫས་ཕྱེ་མས་བྲབ།",
    "དེ་རྗེས་བརྡུང་བ་དང་ཟན་ལིང་གི་ལིང་རོར་བསྟབ་པ་གཞུང་བཞིན་བྱ་ཚོགས་ལྷག་བཏང་སྟེ་ཚོགས་གསེང་བར་འདིར་སློབ་དཔོན་དང་ལས་རྡོར་གྱིས་མནན་ཆས་རྣམས་ལེགས་པར་བྱས་གྲུབ་པ་ན།",
