    "ཞབས་ཕྱི་ཞུ་བ་སོགས་དད་གུས་ཆེན་པོ་མཛད་འདུག་ལ།",
    "སྐུ་རུས་ཀྱི་ཆ་ཤས་ཚང་མ་རིང་བསྲེལ་གྱིས་གཏམས་འདུག་པ་གཅིག་ཀྱང་མ་གོད་པར་བྱས་ཏེ་མཆོད་སྡོང་ཆེན་པོ་གསར་བཞེངས་དང་།",
    "ལྕགས་ཕག་ལོར་གུང་ཐང་རང་དགོན་དུ་གདན་དྲངས་ཏེ་འཇིགས་བྱེད་ཁང་ཆེན་གསར་འཛུགས་དང་།",
    "ཧོས་རུ་གཅིག་ལས་གཞན་ཅི་ཡང་མི་འདུག་པས།",
    "བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་།",
    "ས་དང་པོ་བའི་ཡོན་ཏན་བརྒྱ་ཕྲག་བཅུ་གཉིས་ཀྱང་མི་འདུག་ན།",
    "ཀུན་འབྱུང་ལ་གཉིས་ཀྱི་འདུ་ཤེས་གཉིས་འཛིན་གྱི་ཀུན་འབྱུང་རང་རྒྱུད་ཡོན་ཏན་གྱིས་དྲེགས་ཤིང་གཞན་ཉམསར་མི་ཆེན་པ་ཁ་བརྙས་པའི།",
    "གཤེས་ཀྱི་དག་བ་ངས་ལེགས་ཕན་བདེའི་རྒྱུར་གྱུར་པ་སྤྱོད་བ་དམན་པ་དུད་འགྲོའི་རྒྱུད་ལ་འདུག་ནའང་བསྟེན་དགོས་ན།",
    "བྱེད་པ་པོས་བྱས་པ་དང་རང་བཞིན་གྱིས་བྱུང་བ་དང་།",
    "ཁྱེད་ཀྱི་ད་ལྟའི་སེམས་གས་ལ་ལ་ཧྲིག་གེ་ལམ་མེ་བ་ཞིག་མི་འདུག་གམ།",
    "ཁྱེད་ཅག་རྣམས་དལ་འབྱོར་གྱི་མི་ལུས་ཐོབ་པ་དོན་ཡོད་པར་བྱས་ནས་དམ་པའི་ཚེས་ཀྱི་ཉམས་ལེན་ལ་སྤྲོ་བར་འདུག་པ་ཤིན་ཏུ་ལེགས་ཤིང་།",
    "འཆི་བདག་དུས་ཀྱི་དཔུང་ལས་རྒྱལ་གྱུར་ཏེ།",
    "གལ་ཏེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "དེ་རྣམས་ཀྱང་དོན་ང་རང་བཞིན་མེད་པའི་བདག་ཉིད་ཅན་དེ་བཞིན་ཉིད་ཀྱི་དེ་ཁོ་ན་ཉིད་རྣམ་པར་དག་པའོ།",
    "གཞོན་པ་བཅུ་དྲུག་དུས་དང་ནི།",
    "ཕྱག་གསུམ་བཙལ་ནས་གྲལ་ལ་འདུགདེ་ནས་གཙོ་བོས་ཐམས་ཅདའིམ་ཕ་གཉིས་ཀྱི་རྣལ་འབྱོར་ལ་ཞུགས་པར་ཞུ།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་དེར།",
    "གླང་པོ་ཆེའི་རྒྱབ་སམ་ཆུ་སྲིན་གྱི་ཁ་ལ་སོགས་པའི་དབྱིབས་སུ་འདུག་པ་བཞིའི་བྱེད་དུ་བདམ་དམར་པོའི་ལྟེ་བ་དང་།",
    "གདུལ་དཀའ་བའི་བགེགས་རྣམས་མེ་རིའི་ཕྱི་རོལ་ན་བཀུག་ནས་འདུག་པར་དམིགས་ནས།",
    "སའི་དབུས་སུ་སློབ་དཔོན་བདག་ཉིད་འདུག་ནས་ས་བྱིན་གྱིས་བརླབ་པ་རྩམ་པར་བྱའོ།",
    "འདུག་སྟངས་དང་།",
    "གོས་སེར་པོ་གྱོན་ལ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་སྟན་འཇམ་པོ་ལ་འདུག་སྟེ།",
    "མེ་ཏོག་སྙིམ་པར་གཟུང་ལ་ཙོག་པུར་འདུག་པའོ།",
    "སྒྲུབ་པའི་གྲོགས་གོ་རཱིར་དམིགས་ཏེ་ཤར་ནས་ནུབ་ཏུ་བལྟས་ཏེ་འདུག་པའི་ལག་ཏུ་ཛྫ་ལན་གསུམ་མམ་དགུར་བརྗོད་པས་བརྐྱང་ཞིང་།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ།",
    "སྒྲུབ་པའི་གྲོགས་མཆོག་རྣམས་ཀྱང་ཇི་ལྟར་འཚམ་པའི་གནས་སུ་འདུག་སྟེ།",
    "བདག་དཔལ་ཀྱེའི་རྡོ་རྗེ་ཕྱག་གཉིས་པའི་རྣལ་འབྱོར་དུ་འདུག་ལ།",
    "སྒྲུབ་པའི་གྲོགས་དང་ལྷན་ཅིག་ཏུ་ལན་གསུམ་དུ་བསྐོར་ཞིང་ཡི་གེ་བརྒྱ་པ་བརྗོད་ལ་ལྷག་ཆད་ཐམས་ཅད་དེས་ཁ་བསྐང་བར་བྱས་ལ་ལྷའི་རྣལ་འབྱོར་ལ་གནས་བཞིན་པས་གནས་ཇི་ལྟ་བར་འདུག་གོ།",
    "ལུས་ཀྱི་སྤྱོད་ལམ་ཙོག་པུ་ལོང་བུ་སྤྲད་པ་མ་སྙེས་པར་འདུག་ཏུ་བཅུག་སྟེ།",
    "དེའི་དམིགས་པ་ནི་ལངས་ནས་འདུག་པར་བསྒོམས་ལ།",
    "སློབ་དཔོན་ལྷའི་ང་རྒྱལ་དང་ལྡན་པས་ཧཱུྃ་ཨ་ཧ་ཛྷེཾ་ཞེས་བརྗོད་ཅིང་ཡང་དང་ཡང་དུ་གསལ་བར་བྱས་ལ་རྡོ་རྗེའི་རྐང་སྟབས་ཀྱིས་འདུག་ལ།",
    "བདག་ལ་འགྲོལ་བའི་ནུས་པ་མི་འདུག་པས།",
    "མི་གཙང་རང་བཞིན་ལུས་དེ་འགྲོ་བ་ལ།",
    "འགྱོད་ཀྱང་འཕྱིས་པའི་དུས་ཅིག་བྱུང་དོགས་འདུག།",
    "མཐོང་ཡང་རང་ཉིད་འཆི་སྙམ་མིསེམས་པ།",
    "སྣངཙམ་ཉིད་ནས་རང་རང་ངོ་བོས་སྟོང་།",
    "སློབ་དཔོན་སྟན་མཐོན་པོ་ལ་འདུག་ནས་ཆོག་འདི་ལྟར་བྱའོ།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "སླེབ་མ་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "གཞན་གྱིས་མ་ལྡོག་ཀྱང་རང་དེ་ལས་བཟློག་པ་ནི་ཆུང་ངུ་ཡིན་ལ།",
    "ོག་ཅོག་པུར་འདུག་སྟེ་འདི་སྐད་དུ།",
    "ཚོག་ཙོག་པུར་འདུག་ཀྱང་རུང་སྟེ།",
    "ལུས་སྦྲེབས་འདར་ཤ་བསྐུར་ནས་ཀུམ་ཀུམ་པོར་འདུག་པ།",
    "ྷ་མིན་གནས་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "ལུས་དྲང་བོར་འདུག་སྟེ།",
    "བདག་འཛིན་ནམ་བྱུང་ངོ་ན་བརྟག་ན་བདག་གང་ཡང་མི་འདུག་པ་ལ།",
    "ཡང་རང་དོན་སྒྲུབ་པའི་བསམ་སྦྱོར་ལ།",
    "སྔར་ནི་ངས་འདི་ལ་གནོད་པ་འབའ་ཞིག་བྱས་འདུག།",
    "དེ་ལྟར་ན་ཉེས་པ་ཐམས་ཅད་བདག་གཅེས་འཛིན་ལས་བྱུང་འདུག་པས་དེ་ལ་དགྲར་བལྟས་ལ།",
    "ང་རང་སྣང་བ་མ་དག་པ་ཡིན་གྱིས།",
    "དལ་འབྱོར་མི་ལུས་སྟེང་ལོག་བྱེད་ཉེན་གདའོ།",
    "འཆི་ཁར་བྲང་ལག་འཐབ་མ་འཆོར་ཉེན་གདའོ།",
    "འཇིགས་རུང་ངན་འགྲེའི་གཡང་སར་འཆོར་ཉེན་གདའོ།",
    "ཁས་བླངས་ཐོག་ཏུ་ཁེལ་བམིགདའོ།",
    "ཁས་ལེན་ཆེ་ལཉམས་ལེན་ཞན་པར་གདའོ།",
    "རང་གཞན་གཉིས་ཁུང་ལས་ལ་འཇུག་ཉེན་གདའོ།",
    "ཉམས་ལེན་ཕྱོགས་ཙམ་འགྲུབ་པ་མི་གདའོ།",
    "བདག་འསྐྱོབ་པའི་ནུས་པ་མི་གདའ་བས།",
    "བདག་ལ་དེའི་ནུས་པ་མི་འདུག་པས།",
    "ཞི་ཞིང་རང་ཏུ་ཞི་བ་བསྟེན་པ་ཡིས།",
    "ཞི་ཞིང་རང་ཞི་ཉེ་བར་ཞི་བར་བྱོས།",
    "བདག་རང་རང་ལ་གཅེས་འཛིན་ཆེས་པའི་རྒྱུས།",
    "འོན་ཀྱང་དམ་པ་འགས་ད་འདྲའི་རྣམ་བཞག་མད་གདའ་བས།",
    "ང་རྒྱལ་གྱི་ཁོང་ཡུས་སྤངས་ཙ་ན།",
    "ཅི་སྣང་རང་སེམས་ཡིན་པས་ཀྱི་དོན་ཞེན་པ་སྤོངས།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་དང་ནས་མི་བཅུས་མི་ཟིན་པའི་མཚན་བཅས་ཀྱི་དགེ་སྦྱོར་མང་པོ་མཛད་པ་ཡིན་པར་གདའ།",
    "སྐྱེས་སྟོབས་ཤེས་རབ་ཆེ་བ་སྦྱོར་ནན་ཏན་ལ་བརྩོན་པ་ཅིག་འཚལ་བར་གདའ་ནའང་།",
    "མཆེད་གྲོགས་གོངམརྣམས་ཀྱི་བཀའ་སྲོལ་བཟང་པོ་མི་ཉམས་པར་བྱ་པའི་ཕྱིར་རྣམ་པར་བཞུག་པ་ཆ་ཆེན་པོ་སྒྲུབ་འཚལ་བར་གདའ་ནའང་།",
    "སྟན་བདེ་བ་ལ་ཅི་བདེ་བར་འདུག་ནས།",
    "བེ་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "གྲིམས་པའི་རྩ་འདུག་ན་ཚ་བ་དང་།",
    "ལྷོད་པའི་རྩ་འདུག་ན་གྲང་བའོ།",
    "ཁ་དོག་ཇི་ལྟར་འདུག་ཀྱང་རོ་ཚ་སྐྱུར།",
    "ཁ་དོག་ཇི་ལྟར་འདུག་ཀྱང་རོ་མངར་བའམ།",
    "ཞིབ་ཏུ་རྟོགས་པ་དཀོན་པར་འདུག།",
    "ཕོ་འཆིན་མཆིན་བླུགས་ཤིང་ལྡང་འདུག་དུབ་བྱེད།",
    "དེའི་གཡའ་སྤང་མཚམས་ན་འཇའ་འོད་རྣ་སྣ་ལྔ་ཁྲ་ཁྱིལ་ཁྱིལ་ཆིལ་ཆིལ་བ་མང་པོ་འདུག་དེར་ཡོན་མཆོད་ཕྱིབས་གཞོལ་ནས་ཞབས་ཐང་དུ་བྱོན་པས།",
    "འོལ་ཚོད་དང་རང་བཟོས་ནི་ནམ་ཡང་མི་འགྲུབ་པས་ན།",
    "གཉིས་འགྱུར་གྱི་ཨ་རུ་ར་དེ་རྣམས་ཞིབ་པར་བཏགས་ལ་སིངས་པོས་སྦྱར་བའི་འདུག་པ་སྐམ།",
    "བསྲེག་བྱེད་གཉེན་ཁོ་རང་ཚིག་པའི་དྲི་མ་དེ་དང་བྲལ་བའི་དོན་དུ།",
