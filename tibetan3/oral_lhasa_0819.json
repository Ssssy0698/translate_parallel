    "བྱ་བ་ལྷག་མ་ནི་གཟའ་བཀྲ་ཤིས་ཀྱི་ཇི་ལྟ་བ་བཞིན་དུ་ཉི་མ་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཆུ་སྲིན་ལ་སོགས་པ་ལ་ཡང་དེ་ལྟ་བུ་ཉིད་དུ་རྟོགས་པར་བྱའོ།",
    "ཆུ་ཚོད་ཀྱི་གནས་ལ་སོགས་པར་ནོར་དང་བུ་ལོན་དུ་བྱ་སྟེ།",
    "རྒྱས་པར་ནི་ཨུ་སངྒ་ལར་འཆད་དོ་ཞེས་པ་འདི་ནི་ཉི་མ་སོ་སོའི་ཉི་མ་དག་པའོ།",
    "ད་ནི་ཟླ་བ་དག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "གནས་ཇི་ལྟ་བ་བཞིན་དུ་དམན་པར་བྱའོ།",
    "རྐང་པ་ནི་རྒྱུ་སྐར་གྱི་དྷྲཱུ་བ་ཀའི་ཆུ་ཚོད་ལ་སོགས་པ་རྣམས་ཀྱིས་དམན་པར་བྱ་བའི་ཕྱིར་དེ་རྣམས་དམན་པར་བྱའོ།",
    "ཆུ་ཚོད་ལ་སོགས་པ་མ་ལོངས་པ་ན་བུ་ལོན་གྱི་ཆུ་ཚོད་ལ་སོགས་པ་དེ་ལྟར་ལྷག་པར་འགྱུར་རོ།",
    "རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་མ་འོངས་པའི་རྒྱུ་སྐར་ཚད་དུ་ཞེས་རིག་པར་བྱའོ།",
    "རྒྱུ་སྐར་གྱི་དྷྲཱུ་བ་ཀ་ལ་གནས་པའི་རྒྱུ་སྐར་རྣམས་ཀྱི་མཚན་མ་དང་ཟླ་བས་སྤྱད་པའི་རྒྱུ་སྐར་རྣམས་བསྲེས་པར་གྱུར་བ་ལ་ཉི་ཤུ་རྩ་བདུན་གྱིས་སྦྱངས་པའི་ལྷག་མ་ནི་སེལ་བ་ལ་སོགས་པ་རྣམས་སོ།",
    "ད་ནི་གདབ་པ་ལ་སོགས་པའི་བྱེད་པ་བདུན་བརྗོད་པར་བྱ་སྟེ།",
    "གཅིག་དང་བྲལ་བ་ལ་བདུན་གྱིས་བགོས་པའི་ལྷག་མ་ནི་གདབ་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "དག་པའི་ལོ་ལ་བརྒྱད་བསྲེས་ཏེ་བཞི་བརྒྱས་བསྒྱུར་ནས་བརྒྱད་བསྲེས་པའི་བྱེད་པའི་ལོས་དམན་པར་བྱས་པ་སུམ་བརྒྱ་བཅུ་བདུན་གྱིས་བགོས་པའི་ལྷག་མ་ནི་གཟར་འགྱུར་རོ།",
    "དེ་ལ་བཀྲ་ཤིས་ལ་སོགས་པའི་ངེས་པ་ཉི་མ་ལ་སོགས་པས་བྱེད་པའི་དོན་དུ་གཟའི་གནས་སུ་གཉིས་དང་ཆུ་ཚོད་ཀྱི་གནས་སུ་སུམ་ཅུ་སྦྱིན་པར་བྱའོ།",
    "དེ་རྣམས་ཀྱིས་ཆུ་ཚོད་དོ་ཞེས་པ་ཐམས་ཅད་དུ་རིག་པར་བྱའོ།",
    "ཡང་ན་བྱང་དུ་བགྲོད་པའི་ཟླ་བ་དང་པོ་ལ་ཉི་མ་བཅུའི་བར་དུ་བརྟག་པར་བྱ་སྟེ།",
    "སུམ་བརྒྱ་དང་དྲུག་ཅུ་གནས་གཉིས་སུ་བྱས་ནས་གནས་འོག་མ་གཉིས་ཀྱིས་བསྒྱུར་ནས་དྲུག་ཅུ་རྩ་ལྔས་ཐོབ་པ་སྟེང་དུ་གཞུག་པར་བྱའོ།",
    "དེ་ལྟར་བསྒྲུབས་པའི་ཉིན་ཞག་ལ་སོགས་པ་རྣམས་དབུགས་ཀྱི་ཕུང་པོར་བྱས་པ།",
    "ལྷག་མ་རྣམས་ནི་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཉིན་ཞག་ལ་སོགས་པར་ཤེས་པར་བྱ་སྟེ།",
    "སྔ་མ་བཞིན་དུ་དྲུག་ཅུ་ལ་སོགས་པ་རྣམས་ཀྱིས་བསྒྱུར་ནས་འདི་ཉིད་ཀྱིས་བགོས་པ་ནི་ཆུ་ཚོད་ལ་སོགས་པར་འགྱུར་རོ།",
    "ཐ་སྐར་ལ་སོགས་པའི་རྒྱུ་སྐར་ལ་ལོངས་སྤྱོད་པར་འགྱུར་རོ།",
    "དེ་རྣམས་ད་ལྟར་བའི་དོན་དུ་སྔོན་མའི་ཉི་མ་གཅིག་ལ་སོགས་པ་དང་བཅས་པ་གནས་གསུམ་དུ་བྱས་ཏེ།",
    "ད་ནི་བཀྲ་ཤིས་བརྗོད་པར་བྱ་སྟེ།",
    "ད་ནི་བཀྲ་ཤིས་དག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "ཐ་སྐར་ལ་སོགས་པའི་རྒྱུ་སྐར་གྱི་ལོངས་སྤྱོད་ལ་གལ་ཏེ་བུ་ལོན་ལྷག་པར་འགྱུར་ན་སྦྱང་བར་བྱའོ།",
    "ཕུང་པོ་དམན་པར་གྱུར་པ་དེའི་ཚེ་འཁོར་ལོ་བཅུ་གཅིག་ནས་བྱའོ།",
    "གལ་ཏེ་སྦྱངས་པའི་ལྷག་མ་ལ་འཁོར་ལོ་བྱེད་ལྷག་པ་འམ་འཁོར་ལོ་ཕྱེད་ཡོངས་སུ་རྫོགས་པ་དེའི་ཚེ་འཁོར་ལོ་ཕྱེད་དོར་ནས་བཀྲ་ཤིས་ཀྱི་ལོངས་སྤྱོད་ཀྱི་ཕུང་པོ་གཉིས་པའི་ཆུ་ཚོད་ལ་སོགས་པ་ལ་ནོར་དུ་རྟོགས་པར་བྱའོ།",
    "དེ་ལྟར་ཐམས་ཅད་ལ་ཡང་རྟོགས་པར་བྱའོ།",
    "སྦྱངས་པའི་ལྷག་མའི་རྒྱུ་སྐར་གནས་པ་དེའི་ཚེ་སྐར་མ་དེ་དྲུག་ཅུས་བསྒྱུར་ནས་འོག་ཏུ་གནས་པའི་ཆུ་ཚོད་ཀྱི་ཚོགས་དང་ལྷན་ཅིག་ཏུ་བྱས་ཏེ།",
    "དེ་ལ་སྔ་མ་ཕྱེད་མ་ཟོས་པ་བསྡོམས་ནས་གཅིག་ཏུ་བྱས་ཏེ།",
    "དེའི་གནས་ཀྱི་ལྷག་མ་ཆུ་ཚོད་ལ་སོགས་པས་བསྒྱུར་ཏེ་སྔ་ལ་སོགས་པས་བགོས་པའི་རྙེད་པ་སྟེང་དུ་བཅུག་ནས་ལོངས་སྤྱོད་ཀྱི་ཕུང་པོ་གཞན་ལ་ནོར་སྦྱིན་པ་དང་བུ་ལོན་དབྲོག་པར་ཤེས་པར་བྱའོ།",
    "ལྷག་མ་ཆུ་ཚོད་ལ་སོགས་པའི་གནས་ལ་ལྔ་ལ་སོགས་པ་ཐོབ་པ་དང་གཅིག་ཏུ་བྱས་ནས་སྤྱད་པའི་རྐང་བའི་གནས་དང་པོ་ལ་དམན་པར་བྱ་སྟེ།",
    "སྤྱད་པའི་རྐང་པའི་གནས་བསྡོམས་པ་དེ་ཡིས་ནོར་དང་བུ་ལོན་རྟོགས་པར་བྱའོ།",
    "བསྒྱུར་བ་དེ་ལ་སླར་ཡང་ལྔ་ལ་སོགས་པས་ཐོབ་པ་མ་སྤྱད་པའི་རྐང་པའི་ཚོགས་ལ་གནས་པ་ཇི་ལྟ་བ་བཞིན་དུ་དམན་པར་བྱས་ཏེ།",
    "དམན་པར་བྱས་པའི་ལྷག་མ་ཉིད་ནོར་དང་བུ་ལོན་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་པ་བཀྲ་ཤིས་ཀྱི་དལ་བའི་ལས་ངག་པའོ་། ད་ནི་མྱུར་བའི་ལས་ཀྱི་ཆོ་ག་བརྗོད་པར་བྱ་སྟེ།",
    "ནོར་དང་རིམ་མིན་གྱིས་བུ་ལོན་ནི་ཐམས་ཅད་དུ་ཤེས་པར་བྱའོ།",
    "ཕྱེད་ཕྱི་མ་ལ་ཐོབ་པས་དམན་པར་བྱས་ཏེ་མ་སྤྱད་པའི་གནས་བསྡོམས་ནས་འདིར་ཡང་ནོར་དང་བུ་ལོན་ཤེས་པར་བྱས་ཏེ་ལྷག་མ་སྔ་མ་བཞིན་ནོ།",
    "ད་ནི་གཟའ་ལྷག་དག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "ད་ནི་ཕུར་བུ་དག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "ཕུར་བུའི་ལོངས་སྤྱོད་སྔ་མ་བཞིན་བྱས་པ་གཅིག་ལ་རྒྱུ་སྐར་བཅུ་གཉིས་སྦྱངས་པའི་ལྷག་མའི་བྱ་བ་མིག་དམར་བཞིན་ནོ།",
    "ད་ནི་པ་སངས་དག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "གཟའ་ལྷག་བཞིན་དུ་ཉི་མའི་དྷྲཱུ་བ་ཀ་ཐ་དད་དུ་བྱས་པ་གཅིག་ལ་རྒྱུ་སྐར་དྲུག་སྦྱང་བར་བྱའོ།",
    "ད་ནི་སྤྲེན་པ་དག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ན་གཞུའི་ཁྱིམ་དུ་སྐྱེས་པར་འགྱུར་རོ།",
