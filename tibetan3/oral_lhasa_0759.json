    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་དང་།",
    "བོན་ཐམས་ཅད་ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་དང་།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བརྩལ་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་དང་།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "ཐོག་མ་དང་ཐ་མའི་མཐའ་ལས་འདས་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
    "བོན་ཐམས་ཅད་མཚོན་དུ་མེད་པ་སྟོང་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་རྫོགས་ཏེ་གནས་པའོ།",
