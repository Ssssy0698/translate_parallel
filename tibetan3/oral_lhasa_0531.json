    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "སྟོབས་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་དེ་བཞིན་ཉིད་ཡང་། དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ བསམ་གཏན་རྣམས་སམ།",
    "བསམ་གཏན་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་སམ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་སམ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "མཚན་མ་མེད་པའི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "སྨོན་པ་མེད་པའི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ གཟུངས་ཀྱི་སྒོ་རྣམས་སམ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "མི་འཇིགས་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་སམ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུའི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུའི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུའི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ཡང་ན་རུས་པར་འདུ་ཤེས་པ་སྟོན།",
    "དགྲ་བཅོམ་པ་ཉིད་འཐོབ་པར་འགྱུར་བའི་ལམ་དང་ནན་ཏན་ནི་འདི་ཡིན་ནོ།",
    "ཡོ་བྱད་ཀྱིས་རིམ་གྲོར་བྱས་པ་དང་།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་པ་དང་།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་པ་དང་།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་པ་དང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་པ་དང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ལ་སྤྱོད་པ་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལ་སྤྱོད་པ་དང་།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ལ་སྤྱོད་པ་དང་།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་སྤྱོད་པ་དང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་སྤྱོད་པ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལ་སྤྱོད་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་སྤྱོད་པའི་ཚེ།",
    "ཡོངས་སུ་ཞུས་པ་རྣམས་ལ་བསྟན་པར་འདོད་དམ།",
    "དེ་བཞིན་དུ་བརྩོན་པར་བྱས་ཀྱང་།",
    "དེ་ལྟར་སློབ་སློབ་པ་རྣམས་ཀྱིས་ཀྱང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མ་ཐོབ་ན།",
    "མི་འཇིགས་མི་དངང་སྐྲག་པར་མི་འགྱུར་ཞིང་།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུའང་ཐོབ་པར་མི་འགྱུར།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུའང་ཐོབ་པར་མི་འགྱུར།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱང་ཐོབ་པར་མི་འགྱུར།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱང་ཐོབ་པར་མི་འགྱུར།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་ཐོབ་པར་མི་འགྱུར་བའི་ཆགས་པ་སྟོན་པ་ནི།",
    "དེ་དག་ཀྱང་དགྲ་བཅོམ་པ་ཉིད་ལ་གནས་པར་གྱུར་ན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་དུ་དེ་ལྟར་སྤྱོད་པ་ནི།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ལས་ཡོངས་སུ་མི་། ཉམས་འདུས་བྱས་སྟོང་པ་ཉིད་ལས་ཡོངས་སུ་མི་ཉམས།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལས་ཡོངས་སུ་མི་ཉམས།",
    "ཡང་དག་པར་སྤོང་པ་རྣམས་ལས་ཡོངས་སུ་མི་ཉམས།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལས་ཡོངས་སུ་མི་ཉམས།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལས་ཡོངས་སུ་མི་ཉམས།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལས་ཡོངས་སུ་མི་ཉམས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལས་ཡོངས་སུ་མི་ཉམས་སོ་སྙམ་ལ།",
    "རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ལས་ཕྱིར་ལྡོག་གོ།",
    "ཡང་དག་པར་སྤོང་བའི་འདུ་ཤེས་ལས་ཕྱིར་ལྡོག་གོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པའི་འདུ་ཤེས་ལས་ཕྱིར་ལྡོག་གོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པའི་འདུ་ཤེས་ལས་ཕྱིར་ལྡོག་གོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པའི་འདུ་ཤེས་ལས་ཕྱིར་ལྡོག་གོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་འདི་ནི་ནམ་མཁའ་དང་མཚུངས་པ།",
