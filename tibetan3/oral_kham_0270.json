    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་རིག་པ་ཕྱི་མ་བསྐྱེད་པར་གྲུབ་པས་རིག་པ་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པ་ཙམ་དངོས་སུ་ཁེགས་པ་ན་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་ཏེ་སྒྲོན་མ་ཙམ་གྱིས་འོད་འབྱིན་ཕར་གྲུབ་པས་འོད་མི་འབྱིན་པའི་སྒྲོན་མའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་པ་བཞིན་ནོ་ཞེས་གསུང་ངོ།",
    "བསྒྲུབ་བྱའི་ཚོས་ངོ་བོ་དབྱེར་མེད་དུ་ཞུགས་ན་མེད་དགག་ཉིད་དུ་འགྱུར་ལ་ཐ་དད་ལྡན་པར་ཞུགས་ཀྱང་རང་བཞིན་གྱི་རྟགས་ཀྱི་རྗེས་འགྲོ་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "བེམས་པོ་ལས་ལོག་པའི་ཕྱིར་རང་རིག་མངོན་སུམ་བཞིན་ཞེས་བཀོད་པ་ན་མངོན་སུམ་དང་རང་རིག་ཁྱབ་མཉམ་ཡང་དཔེ་དང་ཤེས་འདོད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "མི་དམིགས་པ་ཐམས་ཅད་དཔེ་ལ་སྣང་རུང་མི་དམིགས་པར་འདུ་ལ་དེ་བདག་གཅིག་པའི་འབྲེལ་བ་ལ་བརྟེན་པས་རང་བཞིན་གྱི་རྟགས་ཡིན་ཅིང་དེ་དག་བཟློག་པས་མི་དམིགས་པའི་འགལ་བའང་རང་བཞིན་འགལ་བའི་ལྟར་སྣང་དུ་འདུ་བས་འགལ་བའང་གཉིས་ཉིད་དེ།",
    "སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བར་ཚོགས་དོན་བསྒྲུབ་བྱའོ།",
    "ཞེས་བརྗོད་པས་དགག་སྒྲུབ་སྒྲ་དོན་ལ་བྱས་ཀྱང་རང་མཚན་གོ་བ་ཡིན་ཏེ།",
    "ས་པཎ་ཀུན་དགའ་རྒྱལ་མཚན་དྲི་བསུང་རང་རིགས་བས་གཉིས་པ།",
    "གཞན་དག་ལུང་དང་རང་ཚིག་ཟེར།",
    "རང་ཚིག་དང་ཁྱད་པར་མེད་པས་དེ་ཁས་བླངས་ནས་འགལ་ཡང་རང་ཚིག་དང་འགལ་བ་དང་།",
    "བརྗོད་འདོད་ཀྱི་གྲགས་པ་ཁས་མི་ལེན་ན་ཁྱེད་རང་ཁས་ལེན་པའི་རི་བོང་ཅན་ལ་སོགས་པར་འདོད་པའང་འཇིག་པས་ཐ་སྙད་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "དམ་བཅའ་དང་རང་ཚིག་འགལ་བ་དཔེར་ན་དགེ་སྦྱོང་མ་སྦྲུམ་མའམ་བདག་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཡང་རང་ལ་གྲུབ་པའི་བ་ལང་ཉིད་ལ་སོགས་པའང་གཞན་ལ་མ་ངེས་པར་སྟོན་ན་འགལ་བ་དང་།",
    "ཞེས་བསྲེས་ཏེ་མི་སྨྲ་བར་འདུག་ན་སྐབས་དོན་གྲུབ་བོ་སྙམ་ན།",
    "མི་སྨྲ་བར་འདུག་གམ།",
    "ཁྱེད་རང་དེར་མི་འདོད་པའི་ཕྱིར་སྐྱེས་བུ་རྐུན་མ་ལ་རྟགས་མ་ཡིན་ནོ།",
    "ས་པཎ་ཀུན་དགའ་རྒྱལ་མཚན་གྱི་གཟུང་རང་གླེགས་པས་གཉིས་པ།",
    "དེ་ལྟ་ན་སྒྲ་རྟག་སྟེ་མཉན་བྱ་ཡིན་པའི་ཕྱིར་སྒྲ་ཉིད་བཞིན་ཞེས་ཟེར་བ་མ་ངེས་པར་འདུག་ལ།",
    "དེའང་རང་དོན་དུ་དོན་གྱི་སྐྱོན་འབའ་ཞིག་དཔྱད་ལ་གཞན་དོན་དུ་བློ་དང་སྒྲའི་སྐྱོན་ཡང་དཔྱད་དོ།",
    "ས་པཎ་ཀུན་དགའ་རྒྱལ་མཚན་གྱི་གསུང་རང་གླེགས་བམ་གཉིས་པ།",
    "མེ་དང་སྤུ་ལོང་བྱེད་པ་ཕན་ཚུན་འགོག་པ་རྒྱུ་དང་འགལ་བ་དདམིགས་པ་དང་རང་བཞིན་འགལ་བའི་འབྲས་བུ་དམིགས་པ་གཉིས་དང་།",
    "སྨོན་འཇུག་དུས་གཅིག་ཁས་ལེན་པ་ཡང་།",
    "ཀ་ལ་པིངྐའི་ཕྲུ་གུ་སྒོ་ངའི་སྦུབས་ཀྱི་ནང་ན་འདུག་པ་སྒོ་ང་མ་བརྟོལ་ཞིང་སྦུབས་ནས་མ་ཕྱུང་ཀྱང་ཀ་ལ་པིངྐའི་སྒྲ་ཉིད་དུ་འབྱིན་ཏོ།",
    "མདུན་དུ་འདུག་སྟེ་རྒྱུན་བཤགས་བྱ།",
    "དེ་དབྱར་དང་སྟོན་འོང་ཡང་དགུན་སྨད་དང་དཔྱིད་མི་འོང་བར་འདུག།",
    "དེས་ཀྱང་མི་འཚོ་བར་འདུག།",
    "ད་ལྟ་གྲུབ་པ་ཐོབ་ནས་འདུག་གོ་བྱ་བར་གྲགས་པས་དེ་རྒྱལ་པོས་གསན་ནས།",
    "དུས་དེའི་ཚེ་རྒྱལ་པོ་ཆེན་པོ་དེ་ལ་ཡུལ་གཞན་གྱི་རྒྱལ་ཕྲན་ཅིག་ཕྱག་ལ་འཇལ་དུ་འོངས་པར་འདུག་པ་མཁྱེན་ནས།",
    "བཀྲ་ཤིས་པར་འདུག་མི་འདུག་ལྟ།",
    "རྒྱལ་པོ་སྲང་དུ་གཤེགས་སུ་མི་འདོད་པར་གདའ།",
    "དེ་ནས་རྟོགས་པ་དེ་ལས་སད་དེ་བལྟས་ཙ་ན་འབྲས་མི་འདུག་པས།",
    "ལུས་འོད་ཀྱིས་བསྐོར་ནས་འདུག་པ་གཞན་གྱིས་མཐོང་ནས།",
    "ད་ལྟ་རྒྱ་གར་གྱི་ཡུལ་ན་སློབ་དཔོན་ཏི་ལོ་པ་བྱ་བ་གྲུབ་པ་ཐོབ་པའི་རྣལ་འབྱོར་ཞིག་བཞུགས་པར་འདུག་པས།",
    "འདོམས་དཀྲིས་ཀྱི་རས་ཀྱི་སྣ་ལ་ཉ་རློན་པ་འགའ་བཏགས་པ་ཅིག་འདུག་པ་ལས།",
    "དེ་ནས་སློབ་དཔོན་ནཱ་རོ་ཏ་པའི་བསམ་པ་ལ་འདི་ནུས་པ་ཐོབ་པ་རྣལ་འབྱོར་པ་ཞིག་འདུག་པས།",
    "བར་འདུག་སྙམ་ནས།",
    "འདི་ན་ང་ལས་སུ་ཡང་མི་འདུག།",
    "ས་ལ་ལྷུང་ཙ་ན་མི་ཐམས་ཅད་ཀྱིས་མི་འདི་སྨྱོ་བ་ཅིག་འདུག་ཟེར་ནས་འཛིན་དུ་བྱུང་བ་ལ།",
    "ཡང་གཉིས་པོ་ལམ་གཅིག་ལ་ཕྱིན་ཙ་ན།",
    "ཡང་གཉིས་པོ་ལམ་གཅིག་ན་ཕྱིན་ཙ་ན་བློན་པོ་ཆུང་མ་དང་བཅས་པ་བྱུང་བ་ལ།",
    "ད་དུང་བཞེས་པར་འདུག་སྙམ་ནས།",
    "ཕྱོགས་རྣམས་སྟོང་ཞིང་རང་ཡང་རྣམ་པར་བྲལ།",
    "ཁོ་རང་ཡང་དེའི་འཁོར་ཡིན་པས།",
    "ན་ལྕོག་བཞི་ལས་མེད་ཀྱང་ཕྱོགས་བཞི་ནས་བལྟས་ཙ་ན།",
    "སྒྲུབ་པ་པོ་དང་པོ་ཁ་ཟས་ཆ་མཉམ་སྟེ་བསམ་གཏན་གྱི་ཁང་པ་མཚན་ཉིད་དང་ལྡན་པར་ཁ་ཤར་དུ་བལྟས་ཏེ་འདུག་ལ།",
    "བརྒྱད་པའི་སྔགས་བརྗོད་ཅིང་རང་ལྷའི་ང་རྒྱལ་བརྟན་པར་བྱས་ལ།",
    "ཀྱེ་ཧོ་འདི་ནི་རང་རང་བཞིན་དག་པ་ཡིན།",
    "འགྲོ་འདུག་བྱ་བ་སྤྱོད་ལམ།",
    "སོ་སོ་ན་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷན་ཅིག་མི་གནས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མཉམ་དུ་མི་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "མཉམ་དུ་མི་འདུག་པ་ཉིད་སྟོན་པ་ནི་འདི་ལྟ་སྟེ།",
    "གཅིག་དང་འདུག་པ་ནི་གཅིག་ལ་གནས་པའོ།",
    "རིམ་གྱིས་གནས་པ་ན་ཞེས་བྱ་བ་ནི་རིམ་གྱིས་འདུག་པའོ།",
    "མ་འབྲེལ་པ་གཉིས་ཞེས་བྱ་བ་ནི་སོ་སོ་ན་འདུག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་འབྲེལ་པ་གཉིས་ཞེས་བྱ་བ་ནི་སོ་སོ་ན་འདུག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབྲེལ་པ་ཞེས་བྱ་བའི་ངོ་བོ་དེ་ཉིད་གཞན་ཞིག་ཡོད་པར་ཟད་པའི་ཕྱིར་གཞན་དེ་ཡོད་པས་དངོས་པོ་གང་ཡང་འདྲེས་པར་གྱུར་པ་མེད་པའི་ཕྱིར་ཡང་དག་པར་ཇི་ལྟར་འབྲེལ་པ་ཡོད་ཅེས་བྱ་བ་ནི་གང་ན་གཉིས་འདུག་པ་དེའི་ནང་དུ་གསུམ་པ་འོངས་ན་དེ་དེར་ལྷག་པ་ཡིན་གྱི་དེ་ཉེ་བས་གཉིས་ཀྱི་ངོ་བོ་འདྲེས་པར་འགྱུར་པ་ནི་མེད་དོ།",
    "མ་འགགས་ན་ཡང་ལྷན་ཅིག་ཏུ་འདུག་པ་གཉིས་ཕན་པར་བྱ་བ་དང་ཕན་པར་བྱེད་པའི་དངོས་པོ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཅི་སྟེ་ཡང་རྒྱུ་དང་འབྲས་བུ་གཉིས་ཚོགས་པར་འདོད་ན་དེའི་ཚེ་དུས་གཅིག་ཏུ་ཚོགས་པ་གཉིས་ལ་ཕན་པར་བྱ་བ་དང་ཕན་པར་བྱེད་པའི་དངོས་པོ་མེད་པས་ཤིན་ཏུ་ཡང་འབྲེལ་པ་ཅན་མི་འཐད་དོ།",
    "ཇི་ལྟར་སྦྱོར་བ་ལ་སོགས་པ་དང་ལྡན་པར་རུང་བའི་དངོས་པོ་རྟག་ན་ནི་ཞེས་བྱ་བ་ནི་ཅི་སྟེ་ཡང་འབྲེལ་པ་ཅན་ནི་དུས་ཐམས་ཅད་དུ་སྦྱོར་བ་ལ་སོགས་པ་གཞིར་རུང་བའི་ངོ་བོར་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གང་ཡང་རང་བཞིན་དུ་གྱུར་པ་མེད་ན་དེ་ལ་ཇི་ལྟར་ཡང་ཐོབ།",
    "ཡང་དག་པར་སྦྱོར་བ་ལའི་རྟོགས་པ་ཐ་དད་པ་མེད་དེ་ཁར་གཞོང་འདི་ལ་རྒྱ་ཤུག་རྣམས་དང་ཁྲི་འདི་ལ་ལྷ་སྦྱིན་འདུག་པ་དང་།",
    "དེའི་ཁྱད་པར་ནི་དོན་གཅིག་ཏུ་འཛིན་པར་ངེས་པ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་ཉེ་བར་བསྐྱེད་པར་རུང་བའི་བདག་ཉིད་དུ་འདུག་པ་ཡིན་ནོ།",
    "དེ་ལ་འདི་སྙམ་དུ་བརྒྱུད་དེ་སྐྱེས་བ་ལ་ནི་རག་སྟེ་འཁྲུལ་པ་ནི་སོན་འདུག་པ་ཁོ་ནའོ་སྙམ་དུ་སེམས་ན་དེའི་ཕྱིར།",
    "སྤོབས་པ་མེད་པས་བྱེད་པར་འགྱུར་བས་མི་སྨྲ་བར་འདུག་པར་གྱུར་པའི་ཕྱིར་ཏེ།",
    "སྒྲུབ་པའི་ངོ་བོ་ཡང་རང་བཞིན་གྱི་ངོ་བོ་དང་རྒྱུའི་ངོ་བོར་འགྱུར་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པས་མི་གསལ་བའི་དོན་རྣམས་སོ།",
    "གྲུབ་པ་དེ་ཡང་རང་ཡོད་ན་བདག་ཉིད་དུ་ཉེ་བ་སྟེ།",
    "གང་བསྐལ་པ་རྣམ་པ་གསུམ་གྱི་ངོ་བོ་བསྒྲིབས་པ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱི་མཚན་ཉིད་རི་རབ་དང་ར་མན་དང་ལྷ་མ་ལ་སོགས་པའི་ངོ་བོ་ལྟ་བུ་དེས་མ་བསྐལ་པ་ནི་རང་བཞིན་ཁྱད་པར་ཅན་དུ་། བརྗོད་དོ།",
    "རིན་མེད་པར་ཡང་རང་ངོ་བོ་འཇོག་པ་ནི་བཞད་གད་དུ་བྱེད་པའོ།",
    "འདིས་ནི་འགལ་བའི་འབྲས་བུ་དམིགས་པའི་ཡང་ཡུལ་དང་རང་བཞིན་གྱིས་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་ཏུ་སྒྲུབ་པ་ནི་གོ་སླ་བ་ཉིད་དོ།",
    "གཉིས་པོ་མི་བརྗོད་པ་ནི་མི་སྨྲ་བར་འདུག་པས་སོ།",
    "འོ་ན་ཡོད་པའི་བདག་ཉམས་པ་དང་མེད་པའི་བདག་ཐོབ་པར་། ཁས་བླངས་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་གཅིག་པའི་རྣམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བ་གང་ཡིན་པ་འདིའི་ཕྱོགས་ལ་དམ་བཅའ་སྔ་མ་དེ་ནི་འདིར་གྲུབ་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟར་འདིར་རྐང་མིག་བདག་ཉིད་འདིར་རང་བཞིན་འགྱུར་བའི་མཚན་ཉིད་འདྲི་བར་བྱེད་ཅིང་རང་བཞིན་དང་འབྲེལ་པ་མེད་ཅིང་ངེས་པ་མེད་པས་རང་བཞིན་གྱི་དོན་ལ་རག་ལས་པའི་ཕྱིར་ཚིག་ལ་འཇུག་པར་བྱེད་དོ།",
    "དེ་ལྟ་ན་གྲངས་ཅན་དེའི་གཏན་ཚིགས་མ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པའི་སྐྱོན་བརྗོད་པས་བརྩད་པ་ན་གསལ་པ་འདི་དང་རང་བཞིན་གཅིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་སུན་དབྱུང་བར་འགྱུར་རོ།",
    "སྤོབས་པ་མེད་པས་མི་སྨྲ་བར་འདུག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དེའི་སྒྲས་བརྗོད་པར་མི་ནུས།",
    "རྩོད་པའི་དུས་སུ་སྤོབས་པ་མེད་པས་མི་སྨྲ་བར་འདུག་ནས་ཅུང་ཟད་ཀྱང་བརྗོད་པ་མེད་དོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བའི་དོན་རྣམས་ཅིའི་ཕྱིར་ཞེ་ན།",
    "གྲུབ་པ་ཡང་རང་ཡོད་ན་ཡོད་པ་གྲུབ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་ཁྱད་པར་ཅན་བསྟན་པ་ནི་གང་བདག་ཉིད་མ་ཡིན་པའི་སྣང་བ་། ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་གྱིས་ཕན་ཚུན་ནུས་པ་དེ་ལས་ཅིས་མ་ཡིན་ཞེ་ན།",
    "དེ་བཞིན་དུ་འདུས་པ་ཡང་རང་སྣང་བའི་ཤེས་པའི་རྒྱུའི་དངོས་པོར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཉེས་པ་དེའི་སོ་ན་འདུག་སྟེ།",
    "ལྟོ་ནི་རྐེད་ན་འདུག་ལ་དེ་ཡང་ཡངས་པ་ཡིན་ཏེ།",
    "དེ་ནི་ནམ་ཡང་མདུན་ན་མི་འདུག་ན།",
    "ལོ་ཙཱ་བ་དགེ་སློང་བེ་རོ་ཙ་ནས་བསྒྱུར་བའོ།",
    "རྒྱུན་དང་རང་བཟོའི་རྒྱུན་བཞིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གནས་ཕྱིར།",
    "དོན་བྱ་བ་བསྒྲུབ་པ་དེའི་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་ཤེས་ན་ནི་འཇུག་པ་དེའི་ཡུལ་ཅན་ཡིན་ནོ།",
    "ཡུལ་གཞན་ན་འདུག་པ་ལེན་པར་འདོད་པ་ན་ཡུལ་གཞན་ན་འདུག་པ་ངེས་པར་ཉམས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཁྱིམ་གྱི་དང་ར་གཅིག་ན་འདུག་པའི་མེའི་ཕུང་པོ་བཞི་ལས་གང་ཡང་རུང་བ་ཞིག་བླང་བར་བྱ་བ་ཡིན་ཏེ།",
    "ཉེ་བ་ན་འདུག་པའི་བར་ཆད་དང་བཅས་པའི་ལོ་མ་དམིགས་པའི་ཕྱིར་བར་ཆད་དང་བཅས་པ་ཉིད་དུ་འཛིན་ལ།",
    "རིང་པོ་ན་འདུག་པས་ནི་བར་ཆད་མི་མཐོང་བས་མི་སྣང་བའི་ཕྱིར་ལོ་མ་འབའ་ཞིག་སྣང་བ་ནས་སྔོན་པོའི་དངོས་པོ་གཅིག་ཏུ་སྣང་བར་ཤེས་པ་ཡིན་ནོ།",
    "དཔེར་ན་ཁྱད་པར་ཅན་གྱི་དབྱིབས་དང་ལྡན་པའི་རལ་གུ་བཟུང་བ་ལས་དེ་དང་མཐུན་པའི་དངོས་པོ་དེའི་ནང་ན་འདུག་པ་རྗེས་སུ་དཔོག་པ་བཞིན་ནོ།",
    "གཞན་ནི་གཞན་གྱི་རང་རང་བཞིན་དུ་འགྱུར་བར་མི་འོས་ཏེ།",
    "དྲུང་ན་འདུག་པའི་མངོན་སུམ་ཉིད་ཀྱིས་ཡིན་ནོ།",
    "ཡང་གང་ཞིག་ཆུས་དབེན་པའི་ཕྱོགས་སུ་ཆུའོ་ཞེས་སྒྲོ་འདོགས་པ་གཉིས་ཀ་དང་འདྲེས་པའི་རྣམ་པར་རྟོག་པ་དེ་ཡང་རང་བཞིན་གཉིས་མཐོང་བ་ལ་རག་ལས་པ་ཁོ་ནའོ།",
    "སྐད་ཅིག་མ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ལ་དཔེ་མི་སྲིད་དོ་ཞེས་གང་སྨྲས་པ་དེ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "དུས་དེ་རྫོགས་ཀྱང་རང་བཞིན་དེ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་བརྗོད་པ་ན་དེ་དག་དུས་ཅུང་ཞིག་གནས་པའི་རང་བཞིན་ཅན་ཡིན་ནོ་ཞེས་ཁས་བླངས་པར་འགྱུར་རོ།",
    "འབྲས་བུ་དང་རང་བཞིན་དང་མི་དམིགས་པའོ།",
    "ཇི་ལྟར་འདི་རང་ལ་བྱ་བ་འགལ་བས་རྣམ་པར་ཤེས་པའི་རང་གསལ་བ་མི་བཟོད་བཞིན་དུ་སྒྲོན་མེའི་རང་གསལ་བ་བཟོད་པར་གྱུར་སྙམ་དུ་མ་། ཤེས་སོ་། ཡང་ན་སྒྲོན་མེའི་ཡང་རང་གསལ་བ་མི་བཟོད་ལ་རག་ག།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའོ།",
    "འབྲས་བུ་མི་དམིགས་པ་ལ་སོགས་པ་མ་དམིགས་པའི་སྦྱོར་བ་འདི་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་མི་དམིགས་པ་ཉིད་དུ་འདུ་བར་འགྱུར་རོ།",
    "དེའི་བདག་ཉིད་དང་དེ་ལས་བྱུང་བ་དག་ཀྱང་རང་བཞིན་དང་འབྲས་བུ་དག་ཉིད་ཀྱི་ཕྱིར་དེ་དག་ཉིད་ཀྱིས་དངོས་པོ་གྲུབ་པོ་དགག་པ་བསྒྲུབ་པ།",
    "ཡིད་དང་རང་རིག་པའི་རྣམ་འབྱོར་བའི་ཤེས་པའོ།",
    "འབྲས་བུ་ཚུལ་གསུམ་པའི་རྟགས་དང་རང་བཞིན་ཚུལ་གསུམ་པའི་རྟགས་དང་།",
    "འོ་ན་གལ་ཏེ་མི་དམིགས་པ་ལ་ཡང་དེའི་དེ་ལྟ་ན་འབྲས་བུ་དང་རང་བཞིན་དག་ལས་མི་དམིགས་པ་ཇི་ལྟར་ཐ་སྙད་ཅེ་ན།",
    "དགག་པར་བྱ་བ་དུ་བའི་གང་རང་བཞིན་དེ་འདི་མི་དམིགས་པའོ།",
    "འབྲས་བུ་མི་དམིགས་པ་ལ་སོགས་པའི་སྦྱོར་བ་བཅོ་ལྔ་པོ་འདི་རྣམས་ཀྱང་རང་བཞིན་མི་དམིགས་པའི་ངོ་བོ་ཉིད་ཁོ་ནར་རྟོགས་པར་བྱ་སྟེ།",
    "གཞན་ཡང་རང་བཞིན་པའི་འབྲེལ་བ་ཞེས་པའི་དོན་ཅི་ཞིག་ཅི་རང་ལས་གྱུར་པའམ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་མེད་པའི་ཕྱིར་རོ།",
    "ཐ་དད་ན་ཡང་རང་བཞིན་གྱིས།",
    "འདོད་པ་དེ་རྣམས་ཀྱང་རང་ཉིད་ཡོད་པ་ཉིད་ཙམ་གྱི་རྒྱུ་ཅན་ཡིན་པས་ཅིས་བྱེད་པ་མ་ཡིན་ན་ཞེས་པས་དེ་ཁོ་ན་འདི་ཉེ་བར་དམིགས་པ་ཡིན་ནོ།",
    "སྨྱོ་མེད་དུས་ཀྱི་འཁོར་ལོ་སྟོན་སོགས་ཡི་དམ་གང་ཡིན་ལ་ཚིག་བསྒྱུར་མཛད་པའང་བྱུང་འདུག་པས་གང་བདེ་བྱས་ཆོག་རྗེས་ཡིག་བརྒྱ།",
    "ཉམས་ཀྱི་མཐོ་དམན་ཇི་ལྟར་འདུག་རུང་",
    "ད་རུང་རང་སྟོབས་གཉེན་པོ་ངན་པ་དང་",
    "གཞན་ཡང་སྐྱེས་རབས་ནས་ད་རུང་རང་སྟོབས་གཉན་པོ་ངན་ཞེས་དང་",
    "འདུག་མི་ལེགས་པ་དང་",
    "མཆེད་དང་ལྕམ་དྲལ་དང་ཉམས་ན་ཡང་རང་དང་འབྲེལ་ཆེ་ཆུངཉམས་ཚབས་ཆེ་ཆུང་དང་བསྟུན་ཏེ་གོང་བཞིན་སློབ་དཔོན་དང་མཐུན་པ་དང་",
    "ཁྱེད་ལ་འདི་ན་འགྲོ་དོན་ཆེ་རུ་མི་འདུག་པས།",
    "རྔ་ཡབ་གླིང་དུ་ཚེ་འདིར་འགྲོ་བ་ལུང་ཡང་བསྟན་ང་རང་ཡང་འགྲོ་ཡང་བསམ།",
    "དཀའ་སྤྱད་མང་དུ་བྱུང་འདུག་ན།",
    "གཙུག་ལག་ཁང་ཆེན་པོ་གཅིག་འདུག་པས།",
    "དེ་ལ་ལྕགས་རི་རིམ་པ་བདུན་འདུག་ལྷ་ཁང་གསེར་ཏོག་ཅན་ལྔ་འདུག་ཕྱོགས་བཞི་ན་མཆོད་རྟེན་ཆེན་པོ་བཞི་འདུག་ལྷོ་ནུབ་དེ་ན་ཤ་རིའི་བུའི་མཆོད་རྟེན་ཡིན་ཟེར་བ་དཀར་པོ་གཅིག་འདུག་གཞན་རྒྱ་གར་ཡུལ་གྱི་བཀོད་པ་རྣམས་ཡི་གེ་མང་དོགས་པས་མ་བྲིས་སོ།",
    "ཨོ་ཏ་ནའི་གཙུག་ལག་ཁང་ཡིན་ཟེར་བའི་ཞིང་དང་ཐོད་པའི་རྒྱལ་མཚན་གྲངས་མེད་པ་ནམ་མཁའི་ཁམས་ཁེངས་པར་འདུགདེའི་བྱང་ཕྱོགས་ན་ཀོ་ཤའི་གཙུག་ལག་ཁང་ཡིན་ཟེར་བ་གཅིག་མཐོང་།",
    "ལྷོ་ཕྱོགས་ངོས་ལ་གྷན་དྷོ་ལ་བྱ་བའི་གཙུག་ལག་ཁང་ཆེན་པོ་གཅིག་འདུག་ཡུལ་དེའི་ནུབ་ཕྱོགས་ན་གངས་གཅིག་འདུག་སྟེ།",
    "སྣང་བ་སྐྱོ་ཕྱེད་དེ་འདུག་པའི་ཚེ།",
    "ཤིང་སྣ་ཚོགས་དང་མེ་ཏོག་དང་པད་མའི་སྡོང་པོས་བསྐོར་འདུག་དེ་ནས་བྲག་དེའི་རྩར་སླེབས་ཙམ་ན།",
    "པད་མའི་སྡོང་པོ་དང་མེ་ཏོག་ཁ་དོག་སྣ་ཚོགས་ཕུབ་ཙམ་མཁར་གཞུང་ཙམ་འདུག་པའི་རྩར་སླེབས་ཙ་ན།",
    "དེས་ན་རིགས་གསུམ་མགོན་པོའི་ལྷ་ཁང་གསུམ་འདུག་དེ་ནས་བྲག་སྟེང་དུ་སླེབས་དུས་སྟེང་དེ་ཟུར་གསུམ་དུ་ཡོད་པའི་ཟུར་གཅིག་ཤར་ལྷོ་ལ་གཏད་པས།",
    "གནམ་ནས་ས་ལ་བལྟས་པ་ཙམ་དུ་ཤིན་ཏུ་མཐོ་བར་འདུག་སྟེ།",
    "ཕ་ཚད་གཙང་པོ་གཉིས་སུ་སྔོ་ནར་གྱིས་གྱེས་འགྲོ་ཞིང་འདུག་ཡང་ཆུ་གཅིག་བྱང་ངོས་ལ་བབས་པས།",
    "ཕར་ལ་སྐྱ་ཏ་ལེ་འདུག་སྟེ།",
    "སྟེང་དུ་གྲུ་གསུམ་དུ་འདུག་ཀྱང་།",
