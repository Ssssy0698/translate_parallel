    "སྐྱིད་སྡུག་བྱུང་དུས་བློ་གཏད་འདྲི་ས་གཅིག་ཀྱང་མི་འདུག།",
    "ཡུལ་ངན་པ་སྤངས་ནས་ནགས་ཁྲོད་དུ་འདུག་ཀྱང་།",
    "སྐྱབས་ཡུལ་མཆོད་སྟེགས་གྲལ་དུ་འདུག་པ་འདི།",
    "མི་ནུས་བཞི་པོ་བན་ཆུང་རང་ལ་འདུས།",
    "བན་ཆུང་རང་ལ་བཙུན་པའི་མིང་བཏགས་ཀྱང་།",
    "ཐུགས་ཡིད་དབྱེར་མེད་འདྲེས་པར་དཀའ་བ་ནི་མི་འདུག།",
    "བདག་ཅག་དེར་གནས་གང་དུ་ལྟས་ཙ་ན།",
    "ཆ་ལུགས་འགྱུར་ཡང་རང་རྒྱུད་མ་དུལ།",
    "ན་ཚ་ཚ་རུང་སྐྱུར་དུ་མི་འདུག།",
    "ལ་ལུང་བརྒལ་ནས་དབེན་རི་འདུག་པ།",
    "ཡང་རང་བཞིན་མེད་པར་སྟོན་པའི་རིགས་པའི་ཚོགས་ཀྱི་བསྟན་བཅོས་ལྔ་ཡིན་ནོ་ཞེས་ཟེར་བ་ཐམས་ཅད་ཚུལ་འདིས་བསལ་བ་ཡིན་ནོ།",
    "དཔེར་ན་ནམ་མཁའ་ནི་ཁྱབ་ཅིང་རང་བཞིན་མེད་ལ་གོ་འབྱེད་པ་ལྟར།",
    "ཁྱེད་རང་ཡང་འདོད་པ་དང་འགལ་ལོ།",
    "ཞེས་པའང་རང་ལ་ལོག་པར་འགྱུར་རོ།",
    "སྐྱོན་གྱི་འབྱུང་གནས་སུ་འདུག་པས་ཁོ་བོས་བྱས་པའི་འཇུག་པའི་དཀའ་འགྲེལ་དུ་རྒྱས་པར་བཀག་ཟིན་པ་ལས་བལྟ་བར་བྱའོ་། གཉིས་པ་དོན་དམ་བདེན་པའི་མཚན་གཞི་ལ་གསུམ་སྟེ།",
    "གཞན་དུ་ན་ཀུན་རྫོབ་བདེན་པའང་རང་ལུགས་ལ་ཁས་མི་ལེན་པར་འགྱུར་ཏེ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་དབེན་པའི་བསྒྲུབ་བྱ་ཡོད་ཀྱང་ཁས་མི་ལེན་ནམ།",
    "དེ་ལྟ་བས་ན་ཐ་སྙད་དུ་རང་ལ་དམ་བཅའ་མེད་པ་མིན་ལ་དེ་སྒྲུབ་པའི་རྟགས་ཀྱང་རང་ལ་གྲུབ་པ་ཡོད་པ་ཉིད་དེ།",
    "ཞེས་སོགས་ཀྱི་གཞུང་རང་ལ་ཞེ་འདོད་ཀྱི་ཁས་ལེན་ཅུང་ཟད་ཀྱང་མེད་པའི་ལུང་དུ་ཡང་མི་རུང་སྟེ།",
    "ཞེས་ངེས་པར་བྱ་མི་ནུས་པས་རྟགས་དང་བསྒྲུབ་བྱ་འདོད་ཀྱང་རང་རྒྱུད་ཀྱི་རྟགས་དང་བསྒྲུབ་བྱ་མི་འདོད་པ་ཡིན་ནོ།",
    "མཚན་འཛིན་དུ་འདུག་གོ་སྙམ་ནས་ལྟ་བ་རྒྱུད་ལ་སྐྱེས་པར་རློམ་པའི་འོག་ཏུ་སྤྱོད་ཕྱོགས་ཐམས་ཅད་ལ་ཞེ་རྩིས་མེད་པའི་ལོག་ལྟ་རྣམས་ལེགས་པར་ཁེགས་པར་འགྱུར་རོ།",
    "ཁོ་རང་ཡང་ངེས་པར་འདོད་དགོས་པའམ་འདོད་པ་ཅིག་དགོས་ཏེ།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་རྟགས་དང་བསྒྲུབ་བྱ་ལ་གཞན་གྲངས་ཅན་གྱིས་སྨྲས་པའི་གཏན་ཚིགས་འགལ་བ་དང་གྲུབ་པ་ལ་བསྒྲུབ་པའི་ཉེས་པ་མ་བསལ་བའི་ཕྱིར་ཡང་མི་རིགས་སོ།",
    "རྩོད་པ་ཟློག་པའི་འགྲེལ་པ་མཛད་པ་ན་སློབ་དཔོན་གྱིས་ཀྱང་རང་རྒྱུད་ཀྱི་སྦྱོར་བའི་ངག་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་སྨྲ་ཞིང་རང་རྒྱུད་པ་དག་ཀྱང་ཐ་སྙད་དུ་གཞན་སྐྱེ་ཡོད་པར་སྨྲའོ།",
    "དོན་དམ་པར་ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་མེད་པའི་དོན་ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་ཉིད་མཐའ་བཞིར་དཔྱད་ན་མི་རྙེད་པ་ལ་བྱས་འདུག་པའི་ཕྱིར།",
    "འདིའང་བརྟགས་ན་མི་རུང་སྟེ་དོན་རྣམས་ལ་སྔ་ཕྱིའི་དབུས་ན་འདུག་པས་ཁྱབ་ཅིང་སྣང་བ་ལ་ད་ལྟར་བས་ཁྱབ་ལ།",
    "ཁྱབ་པའི་སྒོ་ནས་ནི་དངོས་པོ་ཙམ་ཡང་རང་བཞིན་མེད་པར་གྲུབ་སྟེ།",
    "ཕ་རོལ་མ་དད་ན་མི་ཉན་པས་དེའི་དོན་མི་འགྲུབ་ཅིང་རང་ལ་སྨོད་པས་ཕ་རོལ་ཉམས་པའི་དོན་མ་ཡིན་པ་ཐོབ་པའི་ཕྱིར་ཏེ།",
    "སེམས་ཙམ་པ་དང་རང་རྒྱུད་པ་དག།",
    "རང་ཉིད་ཀྱི་སྐུ་གཅིག་གམ་བ་སྤུའི་ཁུང་བུ་གཅིག་ལའང་རང་གཞན་གྱི་དུས་གསུམ་གྱི་སྤྱོད་པ་དང་འཁོར་འདས་ཀྱི་སྣང་བ་མ་ལུས་པ་སྟོན་པ་སྟེ།",
    "ལྷར་བཅས་འགྲོ་རྣམས་རང་རང་ལས་མཐུན་པའི།",
    "དེས་ན་འདི་དག་ནི་སེམས་དང་དེ་ཁོ་ན་ཉིད་དོན་ལ་ཐ་དད་དུ་ཡོད་པས་དེ་གཉིས་རོ་ཅིག་ཏུ་འདྲེས་པའི་བློ་དེ་གནས་ཚུལ་ལ་མ་ཞུགས་ཐ་དད་དུ་ཤེས་པའི་བློ་དེ་གནས་ཚུལ་ལ་ཞུགས་པར་དོན་གྱིས་ཁས་བླངས་འདུག་གོ།",
    "པྲེ་ཥོ་ད་ར་ཞེས་པའང་དོན་མ་རྟོགས་པར་ཡི་གེ་མ་དག་པ་བྲིས་འདུག་པའི་ཕྱིར་དང་།",
    "ཁྱེད་རང་ལ་ཁས་བླངས་འགལ་ཏེ།",
    "དྲུག་པ་ནི་གཞན་དོན་རྗེས་དཔག་ཐམས་ཅད་ཀྱང་རང་རྒྱུད་པས་རང་རྒྱུད་ཀྱི་སྦྱོར་ངག་ཏུ་འདོད་ལ།",
    "བདེན་གཉིས་ཐ་སྙད་དུ་རང་རང་ངོ་བོས་མི་སྟོང་པའི་ཕྱིར།",
    "འདི་ཡང་རང་རྒྱུད་པ་ལ་སྦྱར་བར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "བདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་མེད་པའི་ཕྱོགས་ལ་ཡོད་ཅེས་པའོ།",
    "བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་མེད་པས་རྟག་ཆད་ལྟ་བ་སྤངས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "འདི་། ནི་ལུགས་འདིའི་རིགས་པ་ཕྲ་ལ་དོན་ཆེ་བ་ཅིག་ཏུ་འདུག་གོ།",
    "ཞིག་རྒྱུའི་དངོས་པོ་མེད་པའི་དུས་ཁོ་ནར་བཞག་འདུག་པའི་ཕྱིར།",
    "འདི་ནི་ལུགས་འདིའི་རིགས་པ་ཕྲ་ལ་དོན་། ཆེ་བ་ཅིག་ཏུ་འདུག་གོ།",
    "ཞེས་ཟེར་བ་ནི་འགྲེལ་པ་འདིར་དེ་མེད་པར་དངོས་སུ་གསུངས་ཤིང་རང་ཉིད་ཀྱང་སྐབས་དེར་དེ་བཞིན་དུ་ཁས་བླངས་པ་དང་དངོས་སུ་འགལ་ལོ།",
    "ཞེས་པ་ལ་སྦྱར་མ་ཤེས་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ལན་བཏབ་ཟིན་པ་སྐབས་འདིའི་ལན་ལ་ཡང་མཚུངས་ཞེས་པའི་དོན་སྦྱར་མ་ཤེས་པར་གཞི་སོ་སོར་བྱས་འདུག་པའི་ཕྱིར་རོ།",
    "དཔེ་འདིས་ཀྱང་རང་རིག་ཐ་སྙད་དུ་ཁས་མི་ལེན་པ་མ་ཡིན་ཏེ།",
    "ཆུ་ཤེལ་དང་མེ་ཤེལ་ལས་ཆུ་དང་མེ་སྐྱེ་བ་སྲིད་ཀྱང་ཆུ་དང་མེ་ཡིན་ན་དེ་གཉིས་ལས་སྐྱེ་བས་མ་ཁྱབ་པ་དཔེར་བཀོད་། འདུག་པའི་ཕྱིར་རོ།",
