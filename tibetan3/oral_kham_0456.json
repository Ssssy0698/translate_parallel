    "དཔེ་རྙིང་དེ་དག་ནི་རྭ་ལུང་དགོན་དང་ཐག་མི་རིང་བའི་སར་བཀྲ་ཤིས་སྒོ་མང་མཆོད་རྟེན་ཞིག་འདུག་པ།",
    "དེའུ་ཞྀང་སུཾ་ཞུས་ཞེས་སོགས་འཁོད་འདུག་ལེའུ་དྲུག་པ།",
    "གཞུང་དེའི་ལྡེབ་གྲངས་ཀྱང་རང་བཞིན་གྱིས་འཕར་ཆགས་ཡོང་སྲིད་པས།",
    "མྱི་སྐྱག་ཞུ་ཆེན་གཉིས་ཀྱིས་ཞུ་དག་སྐབས་ལྡེབ་ཤོག་ངོས་སུ་ཆུ་ཐིགས་འབབ་ཤུལ་ལས་ཤོག་རོར་བཏང་འདུག་པས།",
    "མཚལ་དབུས་ཞོ་ཆིག་དུས་རབས་སྐབས་བཀའ་བསྟན་བཞེངས་པའི་རྣམ་པ།",
    "ཤོའུ་ཁྱད་འཕགས་ཁེང་པོའི་དུང་རང་ལགས།",
    "འཕྲུལ་ཆེན་ལུགས་སུ་འདུག་པའི་འཆིམས་ཆུང་བདག་རོལ་དང་།",
    "རྒྱའི་ཏོང་ཀུན་སྣག་ཚ་ངོ་མཚར་ཆེ། ། ཤོའ་འུ་ཁྱད་པར་འཕགས། ། དུང་རང་ཡང་སྙོན་ལགས། ། ཤོག་རྒྱུ་ངོ་མཚར་ཆེ། ། ཀར་ལྡངས་ཆེ་བར་ཤོག། ། སྣག་ཚ་ཁྱད་པར་འཕགས། ། རྒྱའི་སྟོང་ཀུན་ལགས། ། ཁ་ཏོག་ངོ་མཚར་ཆེ།",
    "ཤོག་གུ་ལྷོའ་དུང་རང་ཀར་འཇམ་པས།",
    "ཤུ་ལོག་བཞི་བཅུ་ཞེས་འཁོད་འདུག་པ་ལས།",
    "དང་ཐན་ཙེ་རཧྭ་ཞེས་པ་ཏེ་གནམ་སྐྱོང་གོང་མ་ཞེས་པའི་མཚོན་དོན་ཡིན་ཙ་ན།",
    "སྦྲུ་བྲུ་སྦཟྭཞེས་དཔར་བྱང་སུམ་འབིད་ཅན་ཞིག་སྦྱར་གནང་འདུག་དེ་དག་ལ་བསམ་གཞིགས་ཤིག་བྱས་ན།",
    "འོན་ཏེ་མཛད་བྱང་དུ་སྦྱར་བའི་ལོ་ཚིགས་དེ་གནའ་དཔེ་ལ་ལར་རབ་བྱུང་གྱི་གྲངས་དེ་མ་གསལ་བར་ལོ་རྟགས་ཁོ་ན་བཀོད་པ་དང་ལ་ལར་སྟོན་པའི་འདས་ལོར་མགོ་བཏགས་བཅོལ་ནས་དཔར་བྱང་སོགས་མཛད་པའང་འདུག་ལོ་ཚིགས་འདི་རིགས་བཀོད་པའི་དཔེ་རྙིང་དུས་རབས་དང་སྤྱི་ལོར་གཏན་ལ་དབབ་པའི་སྐབས་སུ་དཀའ་རྙོག་མང་པོ་ཞིག་འཕྲད་ཀྱི་ཡོད།",
    "དཔའ་ཁོར་བེ་རོ་ཙ་ན།",
    "ཞེས་གསུངས་འདུག་བུ་སྟོན་རིན་ཆེན་གྲུབ་ནི་དུས་རབས་པའི་ནང་དུ་བྱོན་པའི་སྙན་པའི་གྲགས་པ་ཕྱོགས་བཅུར་ཁྱབ་པའི་མཁས་པ་ཞིག་ཡིན།",
    "གཡོན་ངོས་སུ་གསང་སྔགས་ཀྱི་ལྷ་སྐུའི་སྣང་བརྙན་ཞིག་བཞུགས་འདུག་དབུ་ཞབས་ལྷ་སྐུའི་སྐུ་བརྙན་གཙོ་བོ་ཤེར་ཕྱིན་ཡུམ་བཞུགས་པ་ལས་གནའ་དཔེ་དེ་ཤེར་ཕྱིན་ཡིན་པ་རྟོགས་སླའོ།",
    "དེ་གཉིས་མ་དཔེ་ལས་བུ་དཔེར་བྱོན་པ་ལྟ་བུ་ཞིག་འདུགདེ་ན་ཡིབ་རི་དགོན་གྱི་ཤེར་ཕྱིན་དེ་ནི་བསྟན་པ་ཕྱི་དར་གྱི་འགོ་དུས་རབས་པར་བྲིས་བཞེངས་བྱས་པའི་ཁ་ཆེའི་སྒྱུ་རྩལ་ལྡན་པའི་ཤེར་ཕྱིན་ཞིག་ཡིན་པ་ཤེས།",
    "སྟོན་པའི་སྐུ་བརྙན་གྱི་སྤྱི་ཁོག་དུས་རྒྱུན་དུ་ཤ་ཚུགས་ཆེ་ལ་མཉེན་ཆས་དབེན་པའི་རྣམ་པ་ཞིག་ཡིན།",
    "དེ་ལྟར་ཡིན་ཙ་ན་ངག་ཐོག་ནས་གཞུང་དེའི་བརྗོད་དོན་མ་ལུས་པ་ཡོངས་སུ་བློ་ལ་ཡོང་དགོས་ན།",
    "རང་འགྲེལ་དང་གཞན་འགྲེལ་སྟེ་རང་འགྲེལ་ནི་གཞུང་དེའི་རྩ་བ་མཛད་མཁན་ཡང་མཛད་པ་པོ་ཁོང་རང་ཡིན་ལ་བོད་ཡིག་གནའ་དཔེའི་རྣམ་བཤད།",
    "ཞེས་བཀོད་གནང་འདུག་པ་དེར་བསམ་གཞིགས་གཅིག་གནང་བ་ཡིན་ན།",
    "ཕྱོགས་འདི་ནས་ཡིན་ཙ་ན་ཚ་ཁོ་པ་ཟེར།",
    "ཞུས་དག་གོ་ཞེས་པ་སོགས་སུག་བྲིས་གནང་འདུགདཔེར་ན་འོན་ཀེ་རུར་བཞུགས་པའི་ཤེར་ཕྱིན་བྲིས་མ་བམ་པོ་གཉིས་པའི་རྫོགས་མཚམས་དེར་འགོས་ཤག་སྲས་ཀྱྀས་བྲིས།",
    "ཡིན་པ་ཞེས་པ་དེ་ཡང་བོད་ཀྱི་མཁས་པ་སྔ་མ་རྣམས་ཀྱིས་སྔོན་ནས་ལས་རིགས་དེའི་ངོ་བོ་མཁྱེན་འདུག་གོ།",
    "འཕྲུལ་ཡིག་སོགས་འཕྲུལ་གྱིས་ཆེ་བསྟོད་མཛད་པ་མང་པོ་ཞིག་འདུག་དེས་ན་འཕྲུལ་ཞེས་པའི་ཚིག་འདིར་དམིགས་སུ་བཀར་ནས་དོན་འདི་འདྲ་ཞིག་གོ་དགོས་ཞེས་སྨྲ་བའི་འབབ་སྟེགས་བསྒྱུར་དཀའ་ཡང་།",
    "ཅེས་བྲིས་འདུག་མཛད་བྱང་དེས་མལ་བྲིས་དར་ཡུལ་འཕན་པོ་ཡིན་པ་སྣག་ཤོག་མང་པོས་འགྲེལ་མི་དགོས་པར་རྣག་ཐོག་གཙག་འཁེལ་ལྟ་བུ་ཞིག་གསུངས་འདུག་གོ།",
    "འཇང་མིག་ཡ་མིག་དུས་རབས་གནའ་དཔེའི་ལྡེབ་གྲངས།",
    "པོད་གྲངས་ཀྱི་གོ་རིམ་དེ་ཀ་མད་ལ་བཅོལ་ཡོད་པ་དངོས་སུ་མཇལ་རྒྱུ་འདུག་དེས་ན་གསུང་པོད་ཕན་ཚུན་མི་འཁྲུགས་པ་དང་མ་འཛིང་པའི་ཆེད་དུ་ཀ་མད་ཀྱི་གོ་རིམ་ལ་བཅོལ་བའི་སྲོལ་དེ་དུས་རབས་པའི་སྐབས་ནས་ཡོད་པ་དེ་ཤེས་ཐུབ།",
    "དེ་དང་ཆབས་ཅིག་སློབ་དཔོན་ཞི་བ་ལྷའི་སྤྱོད་འཇུག་དགའ་ལྡན་དཔར་རྙིང་དུ་གྲགས་པ་དེའི་ཞབས་ཤོག་ཏུ་བཏབ་པའི་དམིགས་བསལ་རྟགས་སམ་རྟགས་ཐམ་དེ་ཡང་རང་བཞིན་གྱིས་དུས་རབས་པར་བཏབ་པའི་རྟགས་ཐམ་ཞིག་ཡིན་པ་ཤེས།",
    "དེའི་གཤམ་ཏུ་བོད་ཨང་བཅས་བྲིས་འདུག་དེ་དག་ལ་དབྱེ་ཞིབ་རགས་ཙམ་ཞིག་བྱས་ན་དེའི་སྟེང་དུ་གསལ་བའི་ཀ་མད་བཀོད་པ་དེ་ནི་གནའ་དཔེ་དེའི་རིགས་ཚན་གྱི་རྟགས་ཡིན།",
    "མ་ཎི་བཀའ་འབུམ་གྱི་ལྡེབ་གྲངས་བརྒྱའི་མཚོན་ཆེད་དུ་དམིགས་བསལ་རྟགས་འདི་བཀོད་འདུག་དུས་རབས་ནས་འགོ་བརྩམས་སྟེ་དེབ་ལྟེབས་མགོ་མ་དེ་དར་ཁྱབ་ཤུགས་ཆེན་པོ་བྱུང་འདུག་དེབ་ལྟེབས་མགོ་མ་དེ་ནི་གཙོ་བོ་རྒྱུན་སྤྱོད་ཆེ་བ་དང་གཞུང་སའི་ནང་མཛོད་དུ་བཞུགས་པའི་རྩིས་ཐོ་སོགས་ལ་བེད་སྤྱོད་པའི་དཔེ་གཟུགས་ཤིག་ཡིན།",
    "ཡང་སྔོན་གྱི་དུས་རབས་པའི་གནའ་དཔེ་དག་ལ་བྲིས་ཡོད་པ་མཇལ་རྒྱུ་འདུག་ལྷག་དོན་དུ་དུས་རབས་པའི་བྲིས་མ་དབའ་བཞེད་དང་དཀར་ཆག་འཕང་ཐང་མ་སོགས་ཀྱི་ནང་དུ།",
