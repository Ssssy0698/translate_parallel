    "ཆུང་ནས་ད་བར་མཛད་སྤྱོད་རྣམས་ཉུལ་ནས་དྲིས་པ་རྣམས་ཟིན་བྲིས་སུ་བཏབ་ཡོད་ཀྱང་རང་འཁུམས་ཀྱིས་དེ་གར་ལུས།",
    "ཁོ་རང་ལ་དེ་ཚུལ་འཕྲིག་ཙམ་ཡང་མ་ཤོར་བར་སླར་རྟ་ལ་ཞོན་ནས།",
    "ད་ལྟའི་ཞིབ་འཇུག་གནས་བབ་སོགས་ཚང་མ་ཚུད་འདུག་པས།",
    "དཔྱད་རྩོམ་འདིའི་ནང་རང་ཉིད་ཀྱིས་མཆིམས་ཀྱི་རུས་རྒྱུད་འབྱུང་ཁུངས་དང་།",
    "ཤོག་གྲངས་༡༥་༡ལ་ཁྲི་ཉག་ཁྲི་བཙན་པོ་ཞེས་ཀྱང་འབོད་སྲོལ་ཡོད་འདུག་དེ་ལྟར་ན་གཉའ་ཁྲི་བཙན་པོ་དང་ལོ་དེ་གུང་རྒྱལ་གྱི་སྲས་མཆིམས་ལྷ་ཐན་ཚོ་དེ་གཉིས་ནི་ཁྲག་རྒྱུད་འབྲེལ་བའི་གཉེན་ཉེ་ཡིན་པར་སྣང་བས།",
    "དེས་ན་མཆིམས་ལྷ་ཐན་ཚོ་ནི་ཆེས་གནའ་བོའི་དུས་སུ་རང་རང་ས་ཆར་དངོས་སུ་བྱུང་བའི་འགྲོ་བ་མི་ཞིག་ཡིན་པ་དང་།",
    "ཆེས་གནའ་བོའི་ཡིག་རྙིང་ལ་ལར་བཟའ་ཞེས་འབྲི་སྲོལ་འདུག་བཙུན་ར་པ་ཡ་ཐུབ་བསྟན་ཕུན་ཚོགས།",
    "དེ་ལྟར་སྲས་དགུང་ལོ་གཅིག་ལ་མ་སོན་གོང་ཡབ་བཙན་པོ་མི་ཡུལ་ལས་ཁ་བྲལ་འདུག་པས།",
    "བེ་རོ་ཙ་ན་དང་།",
    "ཁྲི་ལྡེ་གཙུག་བརྟན་གྱི་མ་ཡུམ་མཆིམས་བཟའ་བཙན་མ་ཏོག་ཡིན་འདུག་གཞན་ཡང་།",
    "སྲོང་བཙན་སྒམ་པོའི་སྐུ་དུས་སུ་རུ་ཆེན་བཞིའི་དམག་དཔུང་རྣམས་བཙན་པོ་སྐུ་ངོ་མའི་བཀོད་འདོམས་འོག་རང་རང་རུ་ཆེན་ལ་བཀོད་འདོམས་བྱེད་མཁན་དམག་དཔོན་སུ་དང་།",
    "མཆིམས་ཤཱཀྱ་ཞེས་སོགས་མཚན་བརྗོད་པའི་ཡིག་འབྲུར་ཁྱད་པར་ཅུང་ཙམ་བྱུང་འདུག་འདི་གར་རང་ཉིད་ཀྱིས་མང་ཆེ་བའི་འབྲི་ཚུལ་བཞིན་མཆིམས་ཤཱཀྱ་པྲ་བྷ་རུ་འདོད་ཡོད།",
    "པ་གོར་ན་འདོད་ཀྱི་བུ་པ་བཙསདབས་ཀ་གོར་བི་རོ་ཙ་ན་དང་།",
    "པ་གོར་ན་འདོད་ཀྱི་བུ་བི་རོ་ཙ་ན་དང་།",
    "པ་གོར་བི་རོ་ཙ་ན་བཅས་ཡིན་ཞེས་གསུངས།",
    "ཨ་ཙ་ར་པ་གོར་བི་རོ་ཙ་ན་དང་།",
    "བན་དེ་ཕྱོགས་ཀྱི་བློན་པོའི་གྲལ་དུ་པ་གོར་བི་རོ་ཙ་ན་སོགས་དང་ལྷན་དུ་མཆིམས་ཤཱཀྱ་པྲ་བྷ་ཡང་ཞུགས་ཡོད་ཅིང་།",
    "པ་གོར་ན་འདོད་ཀྱི་བུ་པ་གོར་བི་རོ་ཙ་ན་དང་།",
    "བསྟན་བཅོས་ཀྱི་གཏམ་རྒྱུད་མང་པོ་གསུང་ཞིང་འདུག་པ་རྨིས་ཏེ།",
    "དེ་གར་ཡོད་པའི་སླེབས་རིའི་བང་སོའི་ཚོགས་དེ་རྣམས་ཀྱང་གཅིག་བསྡུས་མ་ཡིན་པར་ཤར་གླིང་བང་སོའི་ཚོགས་དང་ནུབ་གླིང་བང་སོའི་ཚོགས་ཞེས་ཁག་གཉིས་སུ་དབྱེ་ནས་འདུག་ཤར་གླིང་བང་སོའི་ཚོགས་ནི་སླེབས་རིའི་གད་སྟེགས་རིམ་པ་གཉིས་པའི་ཤར་ངོས་གྱེན་ལྡེབས་སུ་བསྐྲུན་ནས་ཡོད་སྟབས་སྐྱེམས་སྟོང་ཕུ་ཆུ་ནས་དུར་སའི་བར་མཐོ་ཚད་སྤྱི་ཁྲེ་༡ལྷག་ཙམ་ཡོད་པ་དང་།",
    "བང་རིམ་གོང་མ་ཟླུམ་པོ་ཡིན་ལ་དཔངས་ཅུང་མཐོ་བ་བཅས་མཆོད་རྟེན་གྱི་བཟོ་དབྱིབས་ལྟར་དུ་སྣང་འདུག་བང་སོ་དེ་རྣམས་གྲུ་བཞི་སྐབ་ཚེ་མགོ་ཆུང་དང་།",
    "རང་ཡུལ་དུ་བཏབ་པ་བཅས་ཀྱི་སྲོལ་མི་འདྲར་བྱུང་འདུག་སྤུ་རྒྱལ་བཙན་པོའི་བང་སོ་རང་ཡུལ་ཡར་ལུང་འཕྱོངས་རྒྱས་སུ་བཏབ་པ་ནི་བཙན་པོ་ཁྲི་གཉན་གཟུང་བཙན་ནས་བཟུང་ལུགས་སྲོལ་བྱུང་བ་ཞིག་ཡིན་པར་མཐོང་།",
    "སོ་མང་པོ་འདུག་བང་སོའི་ལོགས་སུ་ས་ཁང་བརྩིགས་པ་ཚོས་དམར་པོར་བསྒྱུར་ཡོད་ལ།",
    "འོན་ཏེ་འདུག་སྙམ།",
    "གནས་ངན་ལེན་གྱི་ཚིག་བརྗོད་པར་མ་ནུས་ནས་དེ་གཅིག་པུ་དབེན་པར་འདུག་པ་ན་འདི་ལྟ་བུའི་སེམས་སྐྱེས་པར་གྱུར་ཏེ།",
    "གཞན་གྱི་ནོར་འཕྲོག་པ་ཞིག་འདུག་པ་དེས་འདི་ལྟར་སེམས་བསྐྱེད་དེ།",
    "ཡང་དག་པར་འཛིན་དུ་བཅུག་པ་བརྒྱད་སྟོང་འཁོར་དེ་ཉིད་དུ་འདུས་པར་གྱུར་ཏེ་འདུག་པས།",
    "དེ་ནས་བཟང་སྐྱོང་ཞུ་བར་འདོད་པས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཚོང་དཔོན་བཟང་སྐྱོང་གཟི་བརྗིད་འབར་ཞིང་གཟུགས་བཟང་པོ་ཕུན་སུམ་ཚོགས་པ་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་མཐོང་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཉི་མ་གུང་ན་འདུག་པ་ཡང་མི་མཐོང་ལ།",
    "ཅི་མི་དེའི་ཁོང་ན་འདུག་པའི་སྐེམ་བྱེད་དམ།",
    "མི་དེའི་ནང་ངམ་སླད་རོལ་ན་ཡང་གདོན་མི་གདའ་སྟེ།",
    "དུར་ཁྲོད་ན་འདུག་པའི་ཁོག་པ་དེ་ཡང་དེས་མཐོང་ནས་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "རྐྱེན་རྣམས་ལ་ཡང་ཇི་ལྟར་གདའ་བར་འགྱུར།",
    "རྙེད་པ་ཐོབ་ཀྱང་རང་མི་མཐོང་།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་འོད་སྲུང་ཆེན་པོ་འཁོར་དེ་ཉིད་དུ་འདུས་པར་གྱུར་ནས་འདུག་གོ།",
    "ནམ་མཁའི་ཁམས་ནི་སྒྲིབ་པ་མེད་པར་འདུག།",
    "དཔེར་ན་བྱ་ཀ་ལ་པིང་ཀའི་ཕྲུག་གུ་སྒོ་ངའི་སྦུབས་ན་འདུག་པ་མིག་མ་བྱེ་བ་ཡང་འདི་ལྟ་སྟེ།",
    "ཇི་ལྟར་འདུག་པ་དེ་བཞིན་དུ་ཚེའི་འདུ་བྱེད་འདོར་བར་འགྱུར་བ་སྟེ།",
    "འདུག་བཞིན་བདེ་བར་འཆི་བའི་དུས་བྱེད་དེ།",
    "སྐྱེ་བ་གྲོལ་བའི་སླད་དུ་སྐྱེ་བོས་དབེན་པའི་གནས་སུ་རྨོངས་པ་བཟློག་ཅིང་ངོ་མཚར་གྱི་ཡོ་ན་ཏན་ལ་ཀུན་མགུ་ཞིང་ཆགས་པ་སུ་མ་ཅུ་རྩ་གཉིས་རྣགེ་བ་འདོད་ཅིང་རང་འདོད་ཀྱི་དྲི་མ་མེད་པར་བསྔགས་པར་འོས་པའི་མཛད་པ་དེ་མ་ལྟ་བུ་བསྟེན་ཏོ།",
