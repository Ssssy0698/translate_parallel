    "དེ་བཞིན་དུ་འདུག་པ་ཕྱག་རྒྱ་གཡོན་ལོགས་སུ་ཅུང་ཟད་བཏུད་ནས།",
    "ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ།",
    "ཞི་བའི་ལས་ལ་ནི་སྟན་འཇམ་པོ་ལ་འདུག་ནས།",
    "གོ་རོ་ཙ་ན་བུ་གར་བཅུག།",
    "ཞེས་བྱ་བ་ནི་དེ་ཉིད་ཀྱིས་གོ་རོ་ཙ་ན་དེ་གཡོགས་པར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནས་གོ་རོ་ཙ་ན་དེ་ནམ་འབར་བར་གྱུར་པ་དང་།",
    "མཚན་ཐོག་ཐག་ལྷན་ཅིང་འདུག་པས་ན་གནས་པའོ།",
    "དམག་ཇུས་མཁས་པ་སོགས་ཀྱི་རྒྱུ་རྐྱེན་ལས་ཡིན་འདུག།",
    "དམག་དུས་སྐབས་དགྲ་ཕྱོགས་ནས་ཐོབ་པའི་མཚོན་ཆ་དང་།",
    "དཔུང་ཆེན་མ་བཏེགས་གོང་ལ་རོང་ཆུ་སོགས་ལ་སྔོན་སོ་གཏོང་སྲོལ་སོགས་རྣམ་པ་དེ་འདྲ་ཡོད་རབས་འདུག་རྒྱུད་ལ་ས།་",
    "དུས་བདེ་ལྷིངས་འཇགས་སྐབས་དམག་དཔུང་གཏན་ཉར་མ་དགོས་པར་རང་ཁུངས་ཡུལ་གཞིས་སོ་སོར་ནམ་ཞིག་དགོས་གལ་མ་བྱུང་བར་ཕྱིར་སློག་མཛད་བཞིན་ཡོད་འདུག་དེ་སྐབས་དམག་ལུགས་སྤྱི་དང་།",
    "གོ་མཚོན་སོགས་རྒྱལ་མཆོག་ལྔ་པ་ཆེན་པོའི་སྐུ་དུས་ལྟར་གནས་འདུག་འོན་ཀྱང་བར་ལམ་གོ་ཤྲི་ཁང་དང་།",
    "རྒྱ་ལུགས་ཤུགས་མ་ཐུབ་ཀྱིས་འདྲེས་ལྷད་བྱུང་འདུག་ང་པ་ཁ་གཏན་འཇགས་བོད་དམག་གསར་འཛུགས།",
    "འོན་ཀྱང་ཆབ་སྲིད་ལ་འགྱུར་བ་འགྲོ་བ་དང་ཆབས་ཅིག་ཏུ་དམག་དོན་ཡང་དར་རྒུད་སྣ་ཚོགས་བྱུང་འདུག་པ་ལས།",
    "དེ་བཞིན་དམག་དུས་ཛ་དྲག་སྐབས་དབུས་གཙང་དང་།",
    "སེང་གེ་ཁ་སྤྲོས་ཡོད་ཚུལ་འཁོད་འདུག་ཀྱང་།",
    "དམག་ལུགས་གང་ཅི་དེའི་དུས་དང་འཚམས་པའི་ཡར་རྒྱས་གང་ལེགས་བྱུང་འདུག་པ་དང་།",
    "ནང་མ་ལྷ་སར་སྨོན་ཚོགས་སྐབས་རྟག་བཅར་དགོས་པ་ཡིན་འདུག་རྔ་དང་།",
    "དེ་རྗེས་བོད་ཀྱི་ཤར་ནུབ་གང་ནས་དར་ཁྱབ་བྱུང་བ་ངེས་གསལ་མི་འདུག་རུང་།",
    "མེ་སྒྱོགས་ཆ་ཚང་རང་གཞུང་ནས་བཟོ་བསྐྲུན་བྱ་མུས་ཕལ་ཆེར་༡༨༩ ཙམ་ནས་གོར་ཁ་ཡང་ཅན་ཞེས་པ་སྣ་རྫས་ལ་ཀྲོ་པི་ཞེས་པ།",
    "དེ་ལོ་ཆུ་བྱ་སྨོན་ཚོགས་གྲོལ་རྗེས་ཕ་དང་གྲོང་དྲག་དམག་སྒར་གསར་འཛུགས་གནང་རྒྱུ་ཐུགས་གཏན་སྔོན་འཁེལ་འདུག་པ་ལྟར།",
    "གྱོན་ཆས་ཆ་ཚང་འཁྱེར་འདུག་བཅུ་ཤོག་སོ་སོའི་ནང་གནས་ཚུལ་ཤེས་རྟོགས་བྱུངབ་ཚོས་སྒམ་ཤག་ནང་ལུས་རྐང་གཅིག་ཀྱང་མེད་པར་ས་ཕག་དང་།",
    "མ་ཤེས་པ་ཚོའི་སྒམ་ནང་ལུས་རྐང་ཆ་ཚང་བཞག་འདུག་དེ་ཉིན་གཡུ་མདའ་གུང་སེང་འཁེལ་བར་བརྟེན་གཟིམ་ཤག་ལ་ཉིན་སྔོན་མའི་དགོང་དྲོ་ཕེབས་ཏེ།",
    "གཞུང་སྒོ་རྒྱབ་ཏེ་འགྲོ་ཡུལ་མི་འདུག་རུང་།",
    "སྐུ་སྲུང་དམག་རྣམས་ཕྱིར་བསློག་སྐབས་དེར་དམག་སྒར་འགོ་བྱེད་རྣམས་ནས་མགོ་རུལ་སྣ་བས་མ་ཚོར་བ་བྱུང་འདུག་ཅེས་གཡུ་ཐོག་ལ་བཀའ་ཉེས་གསེར་སྲང་༡ དང་།",
    "དགུ་ཟི་འདི་བོད་ཀྱི་གྲི་རུ་འདུག་གྲི་གུམ་བཙན་པོའི་རིང་ནས་དར།",
    "གད་པ་ལྡིང་དཔོན་གཅིག་བཅས་ཡོད་མུས་སུ་འདུག་གོང་གསལ་གོ་སྲུང་བརྒྱ་དཔོན་དང་།",
    "ལས་ང་རང་དམག་དྲུང་བྱེད་པའི་རིང་ངོ་ལས་འཕོ་འགྱུར་བྱུང་བ་ནི།",
    "ཕར་ཙམ་རིང་དམག་སྤྱི་ཛ་མཁན་སྦྲེལ་པོ་དང་།",
    "ནས་འགན་རྐང་ལེན་བྱེད་དགོས་ཀྱི་འདུག་རྩིས་སྤྲོད་ལ་ཡོད་པའི་ཡི་གེ་དེ་ཚོའི་གྲས་ནས་ལས་བྱ་གཞན་གསུམ་གྱིས་འདོན་དགོས་པ་བྱུང་ན།",
    "དེ་ཉིན་འདོན་སྤྲོད་གནང་ཡུལ་བཀར་ཁང་དེའི་ནང་གོ་ཆས་ཀོ་ཁོམ་ནང་བཅུག་པ་མང་ཙམ་འདུག་ཀྱང་།",
    "རྟེན་ཐུག་གདན་ཞུ་བའི་གོ་ཆས་ཆ་ཚང་གཉིས་པོ་དེ་སྟག་སྒམ་ཞིག་ནང་འདུག་ཁྲབ་རྨོག་ཚང་མར་བཙའ་དང་།",
    "རྫས་སྣོད་ཀོ་ཐོ་ཟེར་བ་གྲངས་འབོར་དང་འགེལ་སྟངས་དེ་མཚུངས་སུ་འདུག་ཅིང་།",
    "ཁེར་རྐྱང་ངང་རང་མགོ་ཐོན་པའི་སྔོན་ཐོན་པ་ཞིག་ཡིན་པར་ཐེ་ཚོམ་མི་འདུག་ཀྱང་།",
    "དམག་སྒར་ཁ་ཤས་ཀྱི་ལག་མདར་རྩིས་སྤྲོད་གནང་ཚུལ་ཡང་གླེང་རྒྱུ་འདུག་པ་དང་།",
    "གར་སྣུམ་ལེབ་བྱུགས་བདག་གཅེས་ཆེན་པོས་ཐུགས་ཉར་གནང་བཞིན་འདུག་པས།",
    "གོ་རིམ་བཞིན་གྲལ་ལ་འཁོད་པར་ཇ་ཆང་དྲངས་མུར་གཟིམ་ལྡིང་སོ་སོས་རང་འོག་མི་གྲངས་ཇི་ཡོད་ཀྱི་མིང་ཐོ་གོ་མཛོད་གཉེར་པར་སྤྲོད་ཀྱི་འདུག་གོ་གཉེར་ནས་མིང་ཐོ་བཀླགས་ཏེ་སོ་སོའི་རང་མིང་ཐོན་རིམ།",
    "རབལམཚོགོ་མཛོད་གཉེར་པ་གཉིས་ནི་དབུས་མདའ་དཔོན་སོ་སོས་འཛུགས་དགོས་པ་ཞིག་ཡིན་འདུག་དེའི་སང་ཉིན་ནས།",
    "དེ་ནས་མི་དཔོན་སོགས་ཀྱིས་ཕེབས་བསུ་སྤོས་སྣེས་གདན་འདྲེན་ཞུ་སྲོལ་འདུག་པ་དེ་ནི་ལྷ་ཞོལ་གཉིས་ཀྱི་ས་མཚམས་ལྟ་བུར་བརྩི་བ་ཡིན་ཚོད།",
    "མེ་སྒྱོགས་དེ་རྣམས་ལ་མཚན་ཡང་འདི་ལྟར་འདུག་སྐུ་ཚད་ཆེ་ཤོས་ལ་ལྐུག་པ་དང་།",
    "གནམ་ལྕགས་ཞལ་ངོ་གཉིས་ལ་དེ་ཉིན་གྱི་བྱེད་སྒོ་འཐུས་ཚང་དགོས་པའི་བཀའ་བསྒྱུར་ཡང་གནང་སྲོལ་འདུག་པ་གྲུབ་པ་དང་དགོན་གསེབ་དམ་",
    "དགོང་དྲོ་གར་གླུ་བཏང་ཟིན་པ་དང་ཆིབས་བསྒྱུར་སྐབས་གཟིམ་པ་ཚོས་ཞབས་པད་རྣམ་པའི་ཆིབས་ཁ་འཁྲིད་དེ་གཞས་ཆེན་གཏོང་བཞིན་དུ་སོ་སོའི་གཟིམ་ཤག་བར་ཕེབས་སྐྱེལ་ཞུ་ལམ་འདུག་འདི་ཉིན་ནས་གཟིམ་པས་ལོ་སྨོན་གྱི་ཞུ་སྒོ་ཡོངས་སུ་ཚར་བ་ཡིན་པས་བོད་ཟླ་༢ ཚེས་༢༣ ཙམ་ལ་དམག་དྲུང་གཉིས་རྒྱ་ལུ་ཆས་དང་།",
    "སྒྱོགས་དྲེལ་ཆབས་ཅིག་དམག་སྒར་སོ་སོར་རྩིས་སྤྲོད་གནང་འདུག་ཀྱང་།",
    "ཁ་དང་གྲ་བཞི་གཉིས་ལ་ཡང་འཕྲེད་སྐྱོགས་ཆེ་ཆུང་འགའ་ཤས་རྩིས་སྩལ་སྒྲིག་བཀོད་ཡོད་འདུག་༡༩༡༧ ལོར་སླར་གོ་མཚོན་ཡར་རྒྱས་གཏོང་སླད་དམག་སྒར་ཁག་ལ་ལག་མདའ་དབྱིན་ཇི་ཁ་ཐུང་རྩིས་སྩལ་སྐབས།",
    "གཟབ་གྱོན་འགོ་སྣམ་ལས་གྲུབ་པའི་སྟོད་སེར་སྨད་སྔོན་པོ་ཡིན་འདུག་པ་དེ་བཞིན་བོད་དམག་སྤྱིའི་མཚོན་རྟགས་དམག་དར་ནི།",
    "དར་ཕྲུག་ཅེས་བརྡ་སྤྲོད་དར་ཆ་ཆུང་ངུ་དེ་འདྲ་ཡང་ཡོད་འདུག་གནས་རིམ།",
    "དམག་ལུགས་སྤྱི་མཚུངས་ལྟ་བུར་གནས་འདུག་དེ་བཞིན་དབྱིན་ཡུལ་དུ་གཞུང་ཞབས་ཁོངས་གཞོན་ནུ་བཞི་དང་།",
    "དབྱིན་ཇིའི་དམག་ལུགས་ཆེད་སྦྱོང་གནང་བ་ལེགས་ཐོན་གྱིས་དམག་སྒར་ཁག་ལ་ཕན་ཁྱབ་གང་ཆེ་བྱུང་འདུག་༦ གོ་རྫས་དང་།",
    "གངས་ཤེལ་སོགས་རྩིས་སྩལ་གནང་བ་ཕྱིས་སུ་ཡང་བེད་སྤྱོད་ཞུ་བཞིན་ཡོད་འདུག་༧ ཕྱོགས་ཐོན་དང་སྐྱེལ་འདྲེན།",
    "དེ་ཡང་གཞུང་འབངས་ངལ་གྲོན་ཆུང་སླད་དམག་སྒར་སོ་སོ་ལོ་གསུམ་ནས་བདུན་བར་བརྗེ་ལེན་མེད་པར་ཕྱོགས་སྡོད་ཞུ་དགོས་ཡོང་འདུག་ཀྱང་།",
    "དམག་སྒར་གཞིས་འཁོར་དུ་ཐོན་ཁར་ཡུལ་མིས་སེམས་ཕྲེང་དང་བཅས་སྐྱེལ་མ་ཡང་གང་རྒྱས་བྱེད་སྲོལ་ཡོད་འདུག།",
    "རུ་སྒྲིག་རྒྱས་པ་བཅས་ཕྱོགས་སྡོད་ལྷ་གསོལ་སྐབས་ལས་གྲ་རྒྱས་ཞུས་རྗེས་དམག་མང་རང་ཁྱིམ་དུ་སློག་གཏོང་བྱེད།",
    "འགོ་ཐོན་ལམ་འགྲོ་ཡོང་བའི་སྨོན་འདེབས་སོགས་རྟག་རྟེན་ཆོ་ག་མ་འཆོལ་བར་ཕྱོགས་ཐོན་ཞུ་སྲོལ་ཡོད་འདུག་༡ ལྷ་སར་བཅའ་སྡོད་སྐབས་ཀྱི་ཞུ་སྒོ།",
    "སྒོས་སུ་དམག་མཁོའི་མཐུན་རྐྱེན་སྣ་ཚོགས་དུས་མཐུན་ལེགས་བཅོས་མཛད་དང་མཛད་འཆར་ཡོད་འདུག།",
    "རང་རང་དཔུང་གྲལ་ངོས་འཛིན་གྱིས་སྔར་བཞིན་རུ་ཁ་སྤྲོད་ཡོད་ཐོག་ནས་མཚོན་གུར་བཀྲོལ་ཞིང་།",
    "འདི་སྐབས་གོང་རིམ་ནས་རུ་སྟེང་བཀའ་བསྒྱུར་སོཌ་ཡོད་ཚེ་ཉན་ཆེད་ཡིན་ཚོད་འདུག་ཀྱང་།",
    "དལ་ཞིང་འགྲུལ་སྟངས་ཀྱང་དགོས་འདུག་པས་ཨམ་ཐབ་ས།",
    "དང་རང་དོན་འཁོར་ཞག་སོགས་ལ་བསྐྱོད་སྐབས་གོ་ལག་སོ་སོའི་བཅུ་ལྡིང་ལ་རྩིས་སྤྲོད་ཀྱི་འཇོག་པ་ལས།",
    "རྩིས་བཤེར་སྐབས་གོ་ཆར་ཕྱིད་བདར་བདག་གཅེས་མ་བྱུང་བའི་སྐྱོན་ཆགས་འདུག་ཚེ་འགོ་བྱེད་ལྡིང་དཔོན་ཡན་ལ་ཉེས་པ་དངུལ་སྲང་༨ ནས་དངུལ་སྲང་༢ བར་སྐྱོན་ཆགས་ཆེ་ཆུང་ལ་གཞིགས་པ་འགེལ་དཀྲི་བྱས་༧རྒྱལ་མཆ།",
    "གཏན་སྡོད་བྱས་པ་དེ་ཡང་རང་བཞིན་བག་མེད་བྱུང་རྒྱལ་མ་ཡིན་པར་འགོ་བྱེད་རིམ་པར་བརྩི་བཀུར་དང་།",
    "ཡང་རྣམ་ཀུན་སྡོད་ཚུགས་ཟིན་ལ་དམག་དུས་སྐབས་སོགས་བྱས་རྗེས་པ་བྱུང་རིགས་དམག་ལོ་རྒན་གཞོན་ལ་མ་ལྟོས་པར་གོ་གནས་སྤར་རྒྱུ།",
    "དེ་མིན་ནའང་རང་ལ་ངོ་སོ་རྒྱུ་རྔན་འབྱུང་ཐབས་སོགས་སུ།",
    "སུ་བྱུང་རང་སྣང་༣ པ་གང་དྲན་གྱིས་ཞུ་བདེ་རིགས་གཏན་ནས་མི་ཆོག་ཉེར་གསུམ་པར།",
    "འགོ་དམག་སུ་འདྲ་ཞིག་ཡིན་རུང་རང་ལས་མཐོ་བའི་རིགས་ལ་རང་ལུགས་ཀྱི་གུས་འདུད་དང་།",
    "ཕར་འགྲོ་ཚུར་འགྲོ་གང་ཅིར་འགྲོ་ལུགས་ལུས་ཀྱི་རྣམ་འགྱུར་མ་ཉམས་པར་ལམ་གཞུང་དུ་ཡ་ཡོ་མེད་པར་ཐད་ཀར་བསྐྱོད་ཐོག་མི་རིགས་དྲག་ཞན་ཇི་འདྲ་ཐུག་རུང་རང་དོན་བྱ་སྒོའི་གཏམ་ཚིག་དགོས་ངེས་མ་གཏོགས།",
    "རང་ལུགས་སུ་སྒྲིག་འཛུགས་མཛད་འདུག་ཀྱང་།",
    "བཀ་ཀ་འ་བལ་ཡུལ་ནང་བོད་དམག་དུས་ཡུན་ཇི་ཙམ་བསྡད་མིན་ཕྱི་ནང་མཁས་པ་མང་པོ་ཞལ་མི་མཐུན་པ་ཡོད།",
    "ངག་རྒྱུན་ཙམ་ལ་གནས་པ་མ་གཏོགས་ཡིག་རིགས་མང་པོར་ཕབ་བསྒྱུར་གྱིས་འཛམ་གླིང་ནང་ཁྱབ་སྤེལ་ཐུབ་པ་བྱུང་མི་འདུག་སྲོང་བཙན་ཡབ་སྲས་ཀྱི་སྐུ་དུས་བོད་ཀྱི་ས་ལས་སྲོང་བཙན་འཁྲུངས་ལོ་ཕྱི་ལོ་༦༡༧ དང་གཤེགས་ལོ་༦༥ བར་དགུང་ལོ་༣༦ བཞུགས་པ་དང་།",
    "བོད་ཀྱིས་ཁྱིམ་མཚེས་རྒྱལ་ཁབ་གཞན་ལ་ཡང་དམག་ཤུགས་ཀྱིས་འཇིགས་སྐུལ་ཡང་ཡང་བྱེད་བཞིན་ཡོད་སྟབས་བོད་ལ་འཇིགས་ཟོན་ངང་གནས་དགོས་བྱུང་འདུག་ཕྱི་ལོ་པར་ ཙམ་ལ་བོད་ཀྱི་དམག་དཔོན་ཙན་ཕོ་མགར་ཁྲི་འབྲིང་དང་།",
    "བོད་ཀྱི་རྒྱལ་རབས་ནང་རང་ཤི་བརྒྱབ་ལུགས་གསལ་འཁོད་མི་འདུག་ཀྱང་།",
    "གང་ལྟར་ལོ་འདིར་རྒྱལ་པོ་འདུས་སྲོང་མང་རྗེ་དགོངས་པ་རྫོགས་འདུག་པ་འཛིན་པ།་",
    "ཕྱི་རྒྱལ་དེབ་རིགས་མང་པོར་འཁོད་འདུག་རྒྱ་དམར་གྱིས་ཕྱིས་སུ།",
    "རྟེན་གསུམ་ལ་བསྙེན་བཀུར་རྒྱ་ཆེ་ཞུས་པ་བཅས་ཁང་ནི་བསྟན་པའི་སྦྱིན་བདག་ཆེན་པོར་གྱུར་འགོ་ཚུགས་འདུག་ག་ཕྱི་ལོ་༡༢༢༧ ལོར་ཆིང་གེ་སེ་ཁང་འདས་པའི་ཚབ་ཏུ་སྲས་གོ་དན་ཁང་ཁྲིར་གསོལ།",
    "སོག་དམག་ཡུན་རིང་མ་བསྡད་པར་ཕྱིར་ལོག་བྱས་འདུག།",
    "ད་ཆ་ང་པགས་པ་བཤུས་ཏེ་ས་ལ་དྲུད་ཀྱི་འདུག་ཀྱ།",
    "དེ་རྗེས་དཔོན་ཆེན་རྒྱལ་བཟང་ས་སྐྱར་ཕྱིར་ཕེབས་སྐབས་དམག་དཔུང་གང་མཚམས་སྣེ་གདོང་ཕ་རིའི་བྱ་སའི་འགྲམ་དེར་འཇོག་གནང་མཛད་འདུག་ག་དེ་ནས་ས་སྐྱར་དཔོན་ཆེན་རྒྱལ་བཟང་དང་།",
    "གཞན་སྲིད་ཕྱོགས་ཀྱི་འབྲེལ་བ་ནི་གང་ཡང་གནང་རིགས་བྱུང་མི་འདུག་ག།",
    "ཁ་༡༥༦༥ ལོར་སྐུ་མདུན་ཞིང་རང་ཉིད་དམག་དཔོན་བྱས་ཏེ་པ་རྣམ་ལྷུན་གྲུབ་ཁྱུང་རྩེ་དང་།",
    "ཕམས་ཉེས་བྱུང་བ་སོ་སོས་ཁ་ཕྱི་བལྟས་ཕྱི་ཕྱོགས་ནས་དམག་རོགས་བཙལ་ཏེ་སྤྱིར་བཏང་རང་མགོར་ཆུ་འདྲེན་ལྟར་ཡང་།",
    "བལ་ཡུལ་སོགས་ཁྱིམ་མཚེས་རྒྱལ་ཁག་ནས་བཀྲིས་བདེ་ལེགས་ཀྱི་རྟེན་འབུལ་ཞུ་མི་རིམ་འབྱོར་སོགས་ཆབ་སྲིད་ཀྱི་རྨངས་གཞི་བརྟན་པོར་ཚུགས་འདུག་༤ ཚན་མཱ་ཡཱ་ལེའུ་བརྒྱད་པ།",
    "ལྷ་བཟང་ཁང་དེ་ཉིད་ཀྱི་ཞབས་འབྲིང་བཟུང་འཁྲིད་བྱས་པ་རྣམས་འཕྲོགས་ལེན་ཐུབ་པ་སོགས་ཇུན་དམག་རྣམས་བོད་ནས་བྲོས་འཐེན་བྱ་དགོས་དེ་ལྟར་ཆགས་འདུག།",
    "ཁང་ཁྱིམ་སོགས་གནོད་པ་མེད་པར་རང་ཁྱིམ་སོ་སོར་སྲུང་བྱ་དང་བཅས་ཅི་བདེར་འདུག་ཏུ་འཇུག་གོ་ཞེས་དམ་བཅའ་ཕུལ།",
    "སེང་ཏཱ་ཤིན་ཅན་རྒྱ་དམག་གཅིག་སྟོང་ལྔ་བརྒྱ་བཅས་རྒྱ་ནག་ཏུ་ཕྱིར་ལོག་ཙིའུ་ཏུ་ལོ་ཡེ་དང་རྒྱ་དམག་ལྔ་བརྒྱ་གྲ་བཞིར་ཁང་པ་གསར་རྒྱག་ནང་སྤོས་འདུག་མ་པས།་",
    "དཔོན་དམག་ཚོའི་ཕོགས་ཐོབ་ལྡེང་ངེས་གོང་མས་གཏོང་རྒྱུ་ཡིན་ཚུལ་ཁས་ལེན་བྱས་ཡོད་འདུག།",
    "མཆོད་རྒྱུན་ལ་ཉམས་སྐྱོན་ཆེན་པོ་ཡོད་འདུག་པ་དེ་དག་བཏང་འཛིན་༧རྒྱལ་མཆོག་ལྔ་པའི་སྐབས་བཞིན་བོད་གཞུང་ནས་དགོས་ལུགས་སོགས་འཐབ་རྩོད་མུ་མཐུད་གནང་འདུག།་",
    "ནང་དོན་ཇུན་གར་ལ་ཡང་མཐུན་ཕྱོགས་ཀྱི་འབྲེལ་ལམ་བཟོ་མིའི་མི་སྣ་འགྲུལ་བཞུད་བྱས་འདུག་དེར་བརྟེན་ལྷ་སྡོད་མན་ཛུའི་ཨམ་བན་གཉིས་ཀྱིས་གནས་ཚུལ་ཆ་ཚང་རྟོགས་ཏེ་པད་ཅིང་དུ་གསང་གནས་བཏང་བའི་ལན་གསལ་མ་འབྱོར་གོང་།",
    "ཡར་སོར་གཉིས་བཅས་ལ་བརྡ་སྦྱོར་ཞུས་ཉིད་ལྷ་ཡོད་བོད་དམག་རྣམས་བསྐུལ་ཏེ་དུས་ཟིང་ཆེན་པོ་ལངས་འདུག་སྨར་།",
    "ལྟག་སྒོ་རྒྱབ་བཅས་པར་བོད་དམག་དང་མི་མང་ཡོང་སྟེ་སྐྱབས་བཅོལ་དུ་བཅར་བའི་རྒྱ་རིགས་རྣམས་རྩིས་སྤྲོད་དགོས་ལུགས་ཤུགས་ཆེ་ཞུས་འདུག་ཀྱང་།",
    "རྩ་ཚིག་དབྲལ་བ་སོགས་བྱས་འདུག་ཀྱང་།",
    "གཞུང་ཕྱོགས་ནས་རང་ས་རང་སྲུང་གནང་འཆར་ཁོ་ན་མ་གཏོགས་གོང་མར་དམག་རོགས་ཞུ་སྐུལ་གནང་རིགས་བྱུང་མི་འདུག་ཀྱང་།",
    "ས་རྒྱུས་བྱ་མི་དོལ་སྤོར་ཟླ་ག་ཅག་གདོང་པ་བཅས་བོད་རྒྱ་གཏོས་ཆེ་ལྷ་ས་ནས་མཉམ་ཐོན་གནང་འདུག་འོན་ཀྱང་།",
    "སྐུ་གདུང་མང་པོའི་གཟུངས་བཞུགས་བཏོན་འཁྱེར་བྱས་འདུག་པར་མ་ཟད།",
    "ཁྱད་མེད་སྤྲོད་ལེན་བྱེད་སྒོའི་སྦུག་དམ་རྩ་ཚིག་དང་སྦྲགས་༡༧༩༢ ལོར་བོད་རྒྱ་ཁྱབ་ལ་གཏོང་འགྲིམས་མཛད་འདུག་ལོ་འདིར་མན་ཇུ་གོང་མས་རྒྱ་བོད་མཆེད་ཡོན་དད་ཞེན་གྱིས་དམག་རོགས་ཡིན་ཞེས་ནང་བློན་བུ་ཟི་གུང་རྡོ་ཀྲུང་ཐང་དང་།",
    "དམག་དུས་འདིར་དབུས་གཙང་ཁམས་གསུམ་གྱི་མི་སེར་ལ་གཟན་གོད་ཆེ་ཙམ་བྱུང་བ་སྐྱོབ་གསོའི་སླད་གཞུང་འབྲུ་ཕོན་ཆེ་འདོན་སྤྲོད་གནང་།",
    "དེ་མིན་དམག་ཤེད་རིང་ལུགས་པའི་བྱ་ཐབས་བཟུང་ཏེ་ཁེངས་དྲེགས་ཆེན་པོས་བོད་ཀྱི་ཆབ་སྲིད་ལ་ཐེ་བྱུས་གང་བྱུང་བྱས་འདུག་།",
    "བྱས་འདུག་སདེ་མཚམས་བོད་གཞུང་ནས་དམག་དོན་སྤྱི་ཁྱབ་བཀའ་བློན་དཔལ་ལྷུན་དང་།",
    "མདའ་དཔོན་སྤེལ་བཞི་བར་བདག་རྐྱེན་ཇི་སྩལ་གསལ་ཁ་མི་འདུག་ཀྱང་།",
    "གཅིག་བསྒྲིལ་མེད་པར་ཡུན་རིང་གནས་འདུག་དེ་རྗེས་མ་ཧཱ་ར་གན།",
    "དེ་སྐབས་རྒྱ་གར་ཡུལ་ཁག་མང་པོའི་ནང་རང་བཙན་དོན་དུ་དབྱིན་ཇིར་ངོ་རྒོལ་དཀའ་ངལ་ཆེན་པོ་འཕྲད་སྐབས་འཇང་སྦ་རྡུར་ནས་དབྱིན་ཇིར་དམག་རོགས་བཏང་སྟེ་ཕན་ཐོགས་ཆེན་པོ་བྱུང་སྟབས་དབྱིན་ཇིས་ཁོ་པར་ཁྲི་གསུམ་ལྡན་གྱི་གོ་གནས་དང་།",
    "གཙང་མདའ་དཔོན་པད་ཚལ་བ་དཔུང་བཅས་འགོག་སྲུང་འཐབ་འཛིངས་སླད་མངགས་བརྫོངས་མཛད་པ་ལྟར་ས་གནས་སོ་སོར་འགོག་འཐབ་གང་ཡོང་བྱས་འདུག་ཀྱང་།",
    "འོན་ཀྱང་ཁོང་རང་གཞུང་ཞབས་ཞུས་པ་ནས་ལས་ཚན་སྐས་ཐེག་རིམ་འཛེགས་ཀྱིས་གཞིས་བྱེས་གང་སར་ཐོག་མཐའ་བར་གསུམ་ལ་ཞི་དྲག་ཞབས་འདེགས་ཇི་ཞུས་སྐོར་དང་།",
    "པའི་སྐུལ་བརྡ་ཡང་བཏང་འདུག་གཞུང་ཞབས་རྣམས་གཞུང་འབྲེལ་ཡིན་མིན་མ་ཤེས་པར་སྡོད་བློས་བཟོད་མིན་སྣ་ཚོགས་བྱུང་སྟེ།",
    "དེ་གར་ཡང་བཞུགས་བློས་མ་བཟོད་པར་བྱང་བརྒྱུད་རྒྱ་ནག་ཏུ་བྲོས་བྱོལ་ལ་ཕེབས་འདུག་ལོ་འདིར་དགའ་འབྲས་དྲུང་སྤྱི་དང་།",
    "དེ་ནས་དཔལ་དོན་ཕ་ཡུལ་ཕྱོགས་ལ་བྲོས་འཆར་ཡོད་འདུག་ཀྱང་།",
    "དེ་མཚམས་དམག་དོན་སྤྱི་ཁྱབ་བཀའ་བློན་ཕུ་ལུང་པ་ཉག་རོང་རང་དུ་ངོ་ཕེབས་ཐོག་ཕོགས་དཔོན་ཕུན་རབ་པ་ཚེ་རིང་དཔལ་ལྡན་ལ་ཐའི་ཇིའི་གོ་གནས་དང་སྦྲགས་ཉག་ཁོག་སྤྱི་ཁྱབ་དང་།",
    "དབྱིན་ཇི་དང་འབྲེལ་གཏུགས་མི་དགོས་པའི་གཙོ་འདོན་གནང་བཞིན་ཡོད་འདུག།",
    "སྲུང་དམག་སྡོད་ཁང་གསར་རྒྱག་མཛད་དེ་སྲུང་བྱ་བོད་དམག་གོ་ཧྲག་ཆེད་འཛུགས་གནང་གཏན་འཁེལ་འདུག་པ་དང་།",
    "བོད་ཀྱི་གཞུང་དམངས་ཚང་མས་མ་དགའ་བ་ཆེན་པོ་ཆགས་ཏེ་མཐོང་འདོད་རྩ་བ་ནས་མེད་པར་ངོ་རྒོལ་ཕོག་སྟབས་ཁོ་པ་ལོ་དེ་རང་དུ་ཕྱིར་འཐེན་བྱ་དགོས་བྱུང་འདུག།",
    "རང་ཕྱོགས་ནས་ཀྱང་དིང་རི་བརྒྱ་དཔོན་དངོས་ཚེས་གཙོས་འགོ་དམག་ཉི་ཤུ་སྐོར་བོད་རྒྱལ་ཁབ་ཀྱི་དོན་དུ་རང་སྲོག་གཟི་བརྗིད་ངང་ཤོར་འདུག་ཡང་དེ་དང་དུས་མཚུངས་ལུང་ཐུར་ལའི་འཐབ་ར་གཞན་མ་དེར་དབྱིན་དམག་ཚུར་རྒོལ་ལ་རང་ཕྱོགས་ནས་བོད་མདའ་དང་།",
    "ལྷག་དོན་བོད་ཀྱི་དེབ་ཐེར་ནང་འཁོད་པ་དང་པོ་དེ་ཡིན་འདུག་དེ་ལྟར་གོ་མཚོན་བཟང་ཞན་དང་།",
    "ལྷ་སའི་ནང་འཕྱ་སྨོད་ཀྱི་གཞས་འདི་འདྲ་ཞིག་བཏང་འདུག།",
    "ལྷ་ཀླུ་ལོག་ནས་ཕེབས་འདུག།",
    "སེ་རིལ་བསྐྱལ་ནས་ཕེབས་འདུག།",
    "ལྕང་ཅན་སྤྱང་རང་དྲགས་ནས།",
    "རྩིས་དཔོན་ལྕང་ལོ་ཅན་རྟ་ཟགས་པ་ཞིག་བཞོན་ནས་བྲོས་ཕྱིན་པ་སོགས་ལ་ཟེར་བ་ཡིན་འདུག་༢དམག་ས་གཉིས་པ་ནགས་ཐང་སྐོར།",
    "གོར་ཥ་རྒྱལ་ཁང་ནས་ཀྱང་དབྱིན་བོད་དྲག་འཐབ་མི་དགོས་པའི་གོར་ཥས་བར་འདུམ་ཞུ་འདོད་ཡོད་ལུགས་ཞུ་ཡིག་བཅས་ཕུལ་ཡོད་འདུག་ཀྱང་།",
    "ད་དུང་དགོས་གལ་ཤར་ཚེ་སེར་དམག་དང་ཡུལ་དམག་བཏང་ཆོག་ཨང་བསར་དགོས་པའི་བཀའ་ཁྱབ་སྒྲིག་བཀོད་གནང་ཡོད་འདུག།",
    "ཡང་ཧ་སེ་སྦན་ཅན་འགོ་དམག་བཞི་བརྒྱ་སྐོར་གམ་པར་འབྱོར་བ་དང་དུས་མཚུངས་གདན་སའི་མི་འཐུས་གསུམ་ཡང་ལྷ་ས་ནས་ཞི་གྲོས་སླད་འབྱོར་འདུག་གཞིས་རྩེར་སྡོད་པ་རྒྱ་དཔོན་ཧོ་ཀང་སི་ཟེར་བ་ཡང་ལྷ་སྡོད་མན་ཇུའི་ཨམ་བན་གྱི་ངོ་ཚབ་ཡིན་ཞེས་ཞི་གྲོས་སུ་གམ་པར་འབྱོར་འདུག་ཀྱང་།",
    "འབྲུག་པ་ཀ་ཅི་ཨོ་རྒྱན་གཉིས་ནས་ཀྱང་ཞུ་འཕྲིན་གོང་མཚུངས་ཐོག་དབྱིན་བོད་དབར་ཞི་གྲོས་ཞུ་བར་བཅར་འཐུས་ཞུ་ཡིག་སྔོན་འབྱོར་ལྟར་དབྱིན་དམག་མཉམ་ཕག་རིར་ཡོང་འདུག་དེ་བཞིན་འབྲས་ལྗོངས་ས་སྤྱོད་དང་།",
    "གདན་གསུམ་གྱི་མཁན་འཐུས་ནས་གཅིག་རུ་དཔོན་ཁང་གསར་བྱང་མ་ཅན་བསད་འདུག་པ་དང་།",
    "འོན་ཀྱང་རང་ཕྱོགས་འགོ་དམག་རྣམས་ནས་བོད་རྒྱལ་ཁབ་དང་།",
    "སྔོན་ལ་ཡོད་པའི་རྟ་དམག་ཚོས་གཡས་གཡོན་རི་ངོས་སོགས་ལ་རྒྱང་ཤེལ་བལྟ་བཞིན་འདུག་ཀྱང་།",
    "དེ་འབྲེལ་རང་ཕྱོགས་ནས་དཔའ་ངར་བརྟུལ་ཕོད་ཀྱི་དགྲ་འཐབ་གཞན་འདྲིང་མི་འཇོག་པ་བྱས་འདུག་ཀྱང་།",
    "བོད་མདའ་འཕེན་མཁས་མང་པོ་ཡོད་པ་བཅས་ནས་འགོག་སྲུང་འཐབ་འཁྲུག་དཔའ་ངར་གང་ཆེ་བྱས་སྟབས་དགྲ་ཕྱོགས་ལ་ཤི་རྨས་མང་པོ་བྱུང་སྟེ་སྐབས་ཤིག་རིང་ཕྱིར་འཐེན་བྱས་འདུག་དེ་མཚམས་གཙང་མདའ་སྨོན་གླིང་པ་དང་།",
    "ང་རང་དེ་སྐབས་ལོ་༩ ཙམ་ཡིན།",
    "ཁོས་ཁ་བརྡ་ལག་བརྡ་མང་པོ་ཞིག་བྱས་ཏེ་ལོག་རྒྱུགས་ཟེར་གྱི་འདུག་ངས་མ་ཉན་པར་སྒོ་འགྲམ་དེར་བསྡད་ནས་སྐད་ཆེན་པོ་བརྒྱབ་སྟེ་ངུས་པ་ཡིན།",
    "གླིང་གཞིས་ཤོད་དྲུང་དཔལ་ལྷུན་བཅས་ལ་མངགས་གཏམ་འགན་དཀྲི་མཛད་དེ་ལྷ་སར་བྲེལ་སྟབས་ངང་ཕེབས་འདུག་ཁ་རོ་ལར་རང་དམག་རྣམས་འབྱོར་འཕྲལ་ཤར་ནུབ་ཁག་བགོས་ཀྱིས་སྒར་བཅས་ཏེ་ས་བབས་ལ་གཞིགས་ནས་ཕན་ཚུན་རི་ངོས་སུ་འཛིང་རོགས་བཟོས།",
    "ཞེས་གོང་ལོའི་བོད་ཟླ་༦ ཚེས་༥ དང་༨ སོ་སོར་སྩལ་འདུག།",
    "ལྷ་ཀླུ་ཕྱོགས་སུ་སྒར་ཕབ་ནས་གནས་འདུག་དེ་འཕྲལ་ལྷ་སྡོད་ཨམ་བན་ནས་དབྱིན་དཔོན་སར་ཟ་ཆས་འདྲ་མིན་འཁྱེར་ནས་ངོ་དགའ་འཁྲབ་པ་དང་།",
    "ཞེས་པའི་གཞས་བརྩམས་བཏང་བྱས་འདུག་ཡང་དེ་དུས།",
    "དམག་དུས་འདིར་ལུས་སྲོག་ལེགས་སྐྱེས་སུ་ཕུལ་བ་དང་།",
    "རུ་སུ་དང་ཉི་ཧོང་གཉིས་ས་མཚམས་སྐོར་དམག་འཁྲུག་ལངས་ཉེན་ཡོད་པ་སོགས་ཀྱི་དུས་སྐབས་ཡིན་འདུག་དེ་ནས་༧གོང་ས་མཆོག་སྟོན་འཁོར་ཁུ་རལ་དང་།",
    "རོག་ཧིལ་ནས་བོད་དང་རྒྱ་ནག་གཉིས་ཐ་དད་ཡིན་སྐོར་བདེན་དོན་ཁུངས་སྐྱེལ་དེབ་གཅིག་བྲིས་ཡོད་འདུག་ཟླ་༧ ཚེས་༢༧ ཉིན་གནས་མཆོག་དྭངས་བསིལ་ནས་རྒྱ་བོད་ཧོར་གསུམ་ཀྱི་ཆིབས་ཞབས་འདུ་ལོང་གང་ཆེ་དང་བཅས་པད་ཅིན་དུ་ཆིབས་བསྒྱུར།",
    "གསར་བརྗེའི་ལམ་ལུགས་རིམ་བཞིན་འཛུགས་བཀོད་མཛད་རྒྱུའི་དགོངས་བཞེད་རྒྱ་ཆེ་ཡོད་འདུག་ཀྱང་།",
    "དེ་དོན་གཅིག་ཏུ་གོ་ན་མཁས་པ་ཆེན་པོ་བེ་རོ་ཙ་ནའི་ཞབས། ། རྟོགས་པ་ཡིན།",
    "ཡུད་ཙམ་གཅིག་ལས་མི་འདུག་པས།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཀུན་ཏུ་ལྷུག་པར་ཞོག།",
    "སྐོར་མཛོད་ཀྱི་དབྱིངས་སུ་སླེབས་ནས་གདའ།",
    "མཐོང་བ་གཅིག་ཀྱང་མི་གདའ་ན།",
    "སྐད་ངན་འདོན་དུ་ད་གདའོ།",
    "ཆགས་སྡང་འཕེལ་བའི་རྒྱུ་ཞིག་གདའ།",
    "སྡིག་ཏུ་འགྲོ་བའི་ཉེན་ཞིག་གདའ།",
    "རང་རྒྱུད་སྲེག་པའི་བདུད་ཅིག་གདའ།",
    "ནམ་ཟླ་འཛད་པའི་འདྲེ་ཞིག་གདའ།",
    "འདུ་ལོང་མང་པོའི་བདུད་ཅིག་གདའ།",
