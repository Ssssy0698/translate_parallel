    "འདི་ལྟར་ཐོག་མར་ངོས་རང་མཚམས་འཇོག་བྱས་པ་ལས།",
    "དེའི་འོག་ལས་དོན་རྩག་རྩིག་བྱེད་མཁན་གྱི་ཚུལ་དུ་བརྩིས་ནས་དོལ་རྒྱལ་བསྟེན་གསོལ་གནང་ན་ཁྱད་པར་མེད།",
    "བ་བྱས་ན་དམ་སེལ་ཡོད་པའི་མི་ཞིག་ཡིན་སྟབས།",
    "ཕྱི་གསལ་ནང་གསལ་གྱིས་ངོ་རྒོལ་བྱས་ན་འགྲིགས་པ་ཡིན།",
    "དེ་ལ་ཁྱད་པར་གང་ཡང་མེད།",
    "གནས་ཚུལ་ངོ་མ་གང་ཞིག་ཡིན་པ་དེ་མ་ཤེས་པར་མགོ་སྐོར་ཐེབས་ནས་བྱས་པ་སྟེ།",
    "བསྟན་དང་འགྲོ་བར་འཚེ་བ་བྱེད་མཁན་ཞིག་ལ་ངོས་འཛིན་གནང་སྟེ་དམ་དྲག་ཆེན་པོ་གནང་ཡོད།",
    "དེ་ལྟར་དོལ་རྒྱལ་རང་ཉིད་ཀྱིས་དགེ་ལུགས་པའི་དམ་སྲི་ལ་ངོས་ལེན་བྱས་ཡོད།",
    "རིས་མེད་གནང་མཁན་ཧ་ཅང་ཡག་པོ་ཞིག་བྱུང་ཡོད།",
    "ངོས་ཀྱིས་གནས་ཚུལ་ཡག་པོ་མ་ཤེས་པར་བརྟེན་དོལ་རྒྱལ་བསྟེན་གསོལ་བྱས་ཤིང་།",
    "དེ་ནས་རིམ་བཞིན་ཕྱི་ལོ་༡༩༦ ལོ་མཇུག་དང་༡༩༧ འགོ་སྟོད་ནས་ངོས་རང་དེར་དོགས་པ་སྐྱེས་ཏེ་བརྟག་དཔྱད་རིམ་པར་བྱས་པ་ཡིན།",
    "སྐབས་དེར་ཡོངས་འཛིན་རྣམ་པ་གཉིས་སྐྲ་འཚོ་ཞིང་བཞུགས་ཡོད།",
    "ངོས་ཀྱིས་བརྟག་དཔྱད་བྱས་ནས་བྱེད་སྟངས་འདི་ལྟར་བྱས་ཤིང་།",
    "དེར་བརྟེན་ངོས་ཀྱིས་བློ་བདེ་པོ་བྱས་ནས་མཚམས་འཇོག་བྱས་པ་ཡིན།",
    "བླ་སློབ་ཀྱི་འབྲེལ་བ་ཆགས་སྐབས་དམ་ཚིག་གཙང་མ་བསྲེས་ལྷད་མེད་པ་ཞིག་དགོས།",
    "དོལ་རྒྱལ་ལ་ཆ་བཞག་ན་ངོས་ནས་སྔར་བསྟེན་གསོལ་བྱས་ཤིང་།",
    "ངོས་ཀྱིས་མཚམས་འཇོག་བྱས་པ་ཙམ་དུ་མ་ཟད།",
    "དམ་ཚིག་གཙང་མ་དགོས་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་ཆགས་ཡོད།",
    "སྐུ་ཐང་འཁྱེར་ནས་སྐུ་མདུན་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་པར་རབ་གནས་གནང་རོགས་ཞེས་ཞུས་ཡོད།",
    "འཇིག་རྟེན་ལྷ་ཡིས་སུ་ཞིག་སྐྱོབ་པར་ནུས།",
    "ལོ་ངོ་དེ་དག་རིང་གླེང་གཞི་ཅན་ཁོ་ནའི་ཐོག་ཏུ་བསྡད་པ་ལས་རྩོད་མེད་ཡོངས་གྲགས་ཤིག་ཆགས་མེད།",
    "སྐུ་མདུན་སྐུ་གོང་མ་འཚོ་ཞིང་བཞུགས་པའི་རིང་ལ་དོལ་རྒྱལ་དམ་དྲག་གནང་བར་བརྟེན་འཕག་འཚག་དེ་ཙམ་རྒྱག་ཐུབ་མེད།",
    "སྐབས་དེར་ཡོངས་འཛིན་རྣམ་གཉིས་ཀྱང་བཞུགས་ཡོད་ལ།",
    "ངོས་ལ་དོགས་པ་བྱུང་རྗེས་བརྟག་དཔྱད་རིམ་པར་བྱས་པ་ཡིན།",
    "ངོ་བོའི་ཁྱད་པར་དམ་སྲི་འབྱུང་པོ་ཡིན་པ།",
    "བྱེད་ལས་ཀྱི་ཁྱད་པར་ནི་བསྟན་དང་འགྲོ་ལ་འཚེ་བ་བྱེད་པ་ཞེས་གསུངས་ཡོད།",
    "ལྷག་པར་དུ་དཔལ་ལྡན་དམག་ཟོར་མ་འཁོན་གྱི་ཡོད་པ།",
    "དྲེགས་པ་དེ་ཉིད་བསྟེན་གསོལ་བྱེད་མི་ཆོག་པ་བཟོས་པ་གནང་སྟེ།",
    "ཡོངས་འཛིན་རྣམ་པ་གཉིས་ཀ་བཞུགས་ཡོད།",
    "དམ་ཉམས་ས་སྟེང་བཀང་ལགས་སམ།",
    "དངོས་གནས་དཔྱད་གསུམ་རྣམ་པར་དག་པའི་གསུང་དེ་དག་ལ་བསམ་བློ་བཏང་ནས་དཔལ་ནཱ་ལེནྡྲ་ཞེས་བརྗོད་སྐབས།",
    "ཚེ་འདིར་ང་དང་འབྲེལ་བ་གཙང་མ་གཅད་རྒྱུ་དང་།",
    "གར་ཞྭ་དང་ཁུ་ནུ་སོགས་ནས་ཡོང་བའི་མི་རྣམས་ཀྱིས་ཀྱང་དོན་འདི་ཤེས་པར་བྱེད་དགོས།",
    "བོད་ནས་ཕེབས་མཁན་ཚོ་ཕྱག་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་རྐྱོངས་ཞེས་སྤྱན་ཞིབ་གནང་རྗེས།",
    "མི་རྒན་རབས་ཚོའི་ངག་རྒྱུན་ལ་ཡོད་པ་དེ་གཅིག་པུས་མི་རིགས་ཀྱི་ཡུལ་གོམས་གཤིས་ལུགས་ཉར་ཚགས་བྱེད་མི་ཐུབ་པས་ངེས་པར་དུ་ཡི་གེ་ཡོད་པ་བྱེད་དགོས།",
    "དྲང་པོ་དྲང་བཞག་བྱེད་མཁན་ཞིག་ཡོད་ཅེས་ཁ་ཀེར་ཀེར་བྱས་ནས་ཤོད་ཀྱི་ཡོད།",
    "དེ་ཚོའི་གྲས་ཀྱིས་གཟབ་གཟབ་ཡག་པོ་མ་བྱས་ན།",
    "ཕར་སླེབས་ནས་འཐོམ་མ་སངས་བར་དེ་གར་བསྡད།",
    "དེ་མིན་ཞེས་གསུངས་པའི་ཕྱིར་ཞེས་ལུང་དྲངས་ན་ནང་པ་མིན་པ་ཞིག་ལ་ཕན་ཐོགས་རྩ་བ་ནས་མེད།",
    "སྐུ་མདུན་སྐུ་གོང་མ་བཅུ་གསུམ་པ་ཆེན་པོར་མཚོན་ན།",
    "སྔོན་མ་མཚན་ཞབས་དངོས་གྲུབ་མཆོག་བརྙེས་ཀྱིས་ང་ལ་གསུངས་པར།",
    "རྗེ་བདག་ཉིད་ཆེན་པོ་ཡབ་སྲས་ཀྱི་དུས་ནས་བཟུང་དགོན་གནས་འདིའི་ནང་དུ་འཇིག་རྟེན་པའི་ལྷ་སྲུང་སྣ་ཚོགས་བསྟེན་པའི་ཕྱག་སྲོལ་མེད་པས་ཕྱིན་ཆད་དེ་རིགས་གཏན་ནས་བྱེད་མི་ཆོག་ཅེས་ཚོགས་སུ་བསྒྲགས།",
    "ཞེས་དམ་དྲག་གནང་ཡོད།",
    "ཁུ་ནུ་བའི་ཕྱུ་པའི་སྟེང་ལ་གཟན་འདྲ་པོ་གྱོན་པའི་སྤོ་བོ་ལགས་གཅིག་ཐུག་བྱུང་།",
    "འགྲོ་ལ་ཕན་པར་བྱེད་རྣམས་ལམ་ཤེས་ཉིད་ཀྱིས་འཇིག་རྟེན་དོན་སྒྲུབ་མཛད་པ་གང་།",
    "ལམ་ཐམས་ཅད་བསྐྱེད་པར་བྱ།",
    "ལམ་ཐམས་ཅད་ཤེས་པར་བྱ།",
    "ཞེས་གསུངས་པ་དེ་ལ་ཐུག་ཡོད།",
    "དེ་འདྲའི་རྐྱེན་མང་པོ་ཞིག་འཛོམས་པར་བརྟེན་རིས་མེད་ཀྱི་གཞུང་སྦྱང་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་མཐོང་བྱུང་།",
    "མཚན་མཐོང་ལ་གནོད་པའི་ཞབས་འདྲེན་གྱི་རིགས་ལ་དམིགས་སུ་བཀར་ནས་ཡིད་གཟབ་མ་བྱས་ན་ཡག་པོ་མེད་ཅེས་ངས་རྒྱ་གར་གྱིས་མཚོན་པའི་ཕྱི་རྒྱལ་ཁག་ལ་ཡོད་པ་དང་།",
    "དེ་བཞིན་ས་རྙིང་བཀའ་བརྒྱུད་བཅས་ནས་ཀྱང་སོ་སོའི་རང་གཞུང་གཙོ་བོ་བྱས་པའི་ཐོག་དགེ་ལུགས་ཀྱི་གཞུང་གཞན་དག་མཁྱེན་པ་བྱུང་ན་ཡག་པོ་ཡོད།",
    "བྱང་སེམས་སྦྱོང་ཞིང་ལྟ་སྤྱོད་གཙང་བ་སོགས།",
    "དགེ་ལུགས་པར་ཐུགས་ཞེན་ཡོད་ཀྱང་དགེ་ལུགས་པའི་གྲལ་ལ་མི་ཚུད་པ།",
    "ཡར་ཕྱིན་ནས་རང་བྱུང་ལྔ་ལྡན་གྱི་སྐུའི་མགུལ་ལ་འཐམས་ནས་བསྡད་པ་ཡིན།",
