    "མིང་ཞེས་བྱ་བ་སྒྲ་དང་དོན་དང་ཤེས་པ་ལས་ཐ་དད་པ་བུམ་པ་དང་སྣམ་བུ་ལསོགས་པར་བརྡབརྟགས་པོ་དེ་དང་།",
    "དོན་ལ་འཇུག་པར་མི་འགྱུར་ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "སྦྱའི་དངོས་ཀྱི་བརྗོད་བྱ་མེད་པར་བསྒྲུབ་པ།",
    "ངོ་བོམེད་པས་བརྗོད་བྱ་མན་ཞེས་བྱ་བ་ལསོགས་པ་གསུངས་པས་སོ།",
    "བློ་ལས་ཐ་དད་མེད་ཕྱིར་རོ་ཞེས་གསུངས་པས་སོ།",
    "གཉིས་པ་ཤེས་པ་རང་མཚན་བརྗོད་བྱས་འདེད་པ་དང་མཚུངས་པ་སྤང་བ་ནི།",
    "སྐྱེ་ཕྱིར་ཞེས་གསུངས་པ་དང་འགལ་ལོ་ཞེ་ན།",
    "མཉན་པ་གཞན་སེལ་བྱེད་པར་བརྗོད།",
    "ཆད་བྱས་འབྲེལ་པས་གོ་བ་ལ།",
    "འཁྲུལ་ནས་དོན་ལ་འཇུག་པར་འགྱུར།",
    "དེ་ཕྱིར་དངོས་པོ་ཐམས་ཅད་ཀྱི་། འབྲེལ་པ་ཡང་དག་དུ་ན་མེད་ཅེས་གསུངས་པས་སོ།",
    "དེས་ན་བྱས་དང་མི་རྟག་པ།",
    "སྒྲ་དང་མི་རྟག་པ་དང་བྱས་པ་ཞེས་ལྡོག་པ་ཐ་དད་བློས་ཕྱེ་བ་ཡིན་གྱི་དོན་ལ་མེད་དོ།",
    "ཡོད་ན་བྱས་ལྡོག་དང་མི་རྟག་པའི་ལྡོག་པ་གཉིས་བདག་གཅིག་ནི་སྨྲས་ཀྱང་གཅིག་ལྕོག་པའང་གཅིག་པས་ཐ་དད་དུ་འདོད་ཀྱང་དོན་ལ་ཁྱད་པར་ཅིང་ཡིད་ལ།",
    "གལ་ཏེ་དེ་ལས་བྱུང་པས་འབྲེལ་ན་རང་བཞིན་གྱི་རྟགས་སུ་མི་འགྱུར་གཞན་ཡང་བས་ལྡོག་རྟག་ན་རྟག་དངོས་སྲིད་པར་འགྱུར་ལ།",
    "གལ་མེ་འགོགས་ལ་དུ་བ་མ་སྐྱེས་པའི་ཁར་དེར་སྦྱོར་བའི་འབྲེལ་པ་ཡོད་པར་འདོད་ན་རྒྱུ་འབྲས་མ་འབྲེལ་བ་གཉིས་ཀྱི་འབྲེལ་བྱེད་དུ་མི་འཐད་དེ།",
    "དེ་མེད་པར་ཡང་ཡོད་པའི་ཕྱིར།",
    "ཕུན་པའི་ཁྱད་པར་མ་བསྐྱེད་ན་རྒྱ་ཤུག་མི་གནས་པར་འགྱུར་ཏེ་ཕན་མ་བཏགོས་པའི་ཕྱིར་རོད།",
    "པ་ལྟར་རོཁྱད་པར་བྱ་བྱེད་ཀྱི་འབྲེལ་པ་ཡང་ཁྱད་པར་དང་ནི་ཁྱད་པར་ཅན།",
    "བཟུང་སྟེ་དེ་དག་བསྡོམ་བྱས་ནས།",
    "ཡང་བྱེད་པ་པོ་དང་ལས་ལ་བྱ་བའི་འབྲེལ་པ་འདོད་དེ་ལས་འབྲས་ཆན་ལུ་བྱེད་པ་པོ་ལྷ་སྦྱིན་གྱིས་བྱ་བ་འཚེད་པ་ལྟ་བུའི་འབྲེལ་པ་དེ་ཡང་བརྟག་སྟེ།",
    "ཕན་མི་འདོགས་ན་འབྲེལ་པ་མེད་པརྔཤེས་པར་བྱའོ།",
    "སྟོན་པའི་རྣམ་རྟོག་ལོག་པ་ཡིནཞེས་དྭང་རྣམ་ངེས་ལས་ཀྱང་དོན་དམ་པར་ནི་ཡོད་པ་ལའང་ཆེས་དོང་ཆོན་གྱི་དངས་པ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གཉིས་པ་རྩོད་པ་སྤྱང་བལ་གཉིས་ལས་བློས་བདག་གཅིག་པར་སྦྲེལ་བ་ལ་རྩོད་པ་སྤང་པ་ནིབྱས་དང་མི་རྟག་བློས་སྦྲེལ་བ།",
    "བྱས་པ་དང་མི་རྟག་པ་དི་དག་བློས་ལྕེལམ་གྲུབ་ན་བྱས་པས་སྒྲ་མི་རྟོག་པར་མི་འགྲུབ་སྟེ་འབྲེལ་པ་དོན་ལ་མི་གནས་པའི་བ་ལྟར་དོན་ལ་གྲུབ་ན་དོན་ལ་འབྱོལ་པ་མེདཅེས་བརྗོད་ཀྱང་ཡོད་པར་འགྱུར་ལམི་རྟག་པར་རྟོག་པ་ལྟ་བུ་དང་།",
    "གཞན་སེལ་ཕྱིན་ཅི་ལོག་དོན་ལ་འཇུག་དུ་མ་རུང་པས་ལ་རྟག་པ་དང་མ་བྱས་པར་རྟོག་པ་ལྟ་བུའོ།",
    "དེས་ན་། མེད་ན་མི་འབྱུང་པའི་འབྲེལ་པ་ཞེས་གསུངས་པའང་སེལ་པའི་བློ་དེར་ཡིན་ཏེ།",
    "རྣམ་བརྟགས་འབྲེལ་ལ་ཉེས་འདི་མེདཙོས་གསུང་དགག་བརྟགོས་ཀྱི་འབྲེལ་པ་ལ་རྩོད་པ་སྤོང་པ་འང་དེ་ཉིད་ཀྱིས་ཤེས་པར་འགྱུར་རོ།",
    "ལྡན་པ་འདི་ཉིད་བ་གླང་པོ་ཞེས་མིང་དོན་གཅིག་ཏུ་འཁྲུལ་པ་ལ་བདག་གཅིག་པོའི་བརྡ་ཆད་བྱས་པས་འགྲུབ་ཀྱི་དོན་ལ་གཅིག་ཏུ་མེད་དེ་མཚོན་བྱ་སྒྲོ་བཏགས་ངོན་ལ།",
    "ཅིག་མ་གཅིག་དུ་སྐྱེས་པ་དེ་གཉིས་པར་མི་སྡོད་པའི་ངང་ཅན།",
    "ཡོད་པ་མ་ལྟོས་པར་དག་པ་བར་གསུངས་ལ།",
    "མི་ནུས་ན་ཅི་ཡང་མེད་པས་ཡོད་པར་མིང་བཏགས་ཀྱང་མེད་པ་ཉིད་ཡིན་ནོ།",
    "ཡང་རྟགས་འགོད་པ་ན་ཡོད་ཙམ་མ་ངེས་པར་འགྱུར་བས་དངོས་པོཔ་འགམས།",
    "འཇིག་པར་བྱ་རྒྱུའི་དངོས་པོ་དང་།",
    "འཇིག་པར་བྱེད་ན་འཇིག་པ་དེ་ནི།",
    "ཐོ་བ་རང་ཐོ་བས་བྱེདམ་སྲིད་དོ་གྱོ་མ་བྱས་ན་བུམ་པའི་ཉེར་ལེན་དང་ཐོ་བའི་ལྷན་ཅིག་བྱེད་པ་ལས་གྱེ་མ་སྐྱེ་བ་ཁོ་བོ་ཡང་འདོད་དོ།",
    "གལ་ཏེ་རྒྱ་མར་བཏང་པ་ཉིད་འཇིག་པ་རྒྱུས་བྱས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ན་བུམ་པ་འཇིག་པར་ནི་ཡུ་བུ་གཉིས།",
    "མྱུ་གུ་བསྐྱེད་པར་མ་ངེས་ན།",
    "བྱས་ཡོད་སྐད་ཅིག་འཇིག་པོ་མིན།",
    "གལ་ཏེ་མི་འགྲུབ་ན་ཕྱིས་ཀྱང་མ་འགྲུབ་སྟེ་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་མི་སྲིད་དེ་བུམ་པ་ལསགས་པ་ཕྱིས་འཇིག་པས་དོན་བྱེད་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "དངོས་མེད་ཡིན་ན་རྟག་པར་འགྱུར་ཞིང་།",
    "གཉིས་དངོས་འགལ་བུམ་པའི་སྟེང་དུ་རྫས་གཅིག་པར་འགྱུར་རོ་ཞེས་རྒོལ་ཏེ།",
    "འོ་ན་ཞིག་པ་དངོས་མེད་ལ་ནུས་པ་མེད་པས་དེས་དངོས་པོ་འཇིག་པར་མི་འགྱུར་ལ།",
    "འདོད་ན་དངོས་པོ་རྟག་པར་འགྱུར་རོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་དོན་གཞན་དུ་གྱུར་པའི་ཞིག་པ་དངོས་མེད་ཀྱིས་དངས་པོ་འཇོག་པར་མ་འདོད་པས་སོ།",
    "འཔརྣམ་འགྲེལ་ལས།",
    "འཇིག་པ་ངག་ནི་མ་འདོད་དོ་ཞེས་གསུངས་པས་སོ།",
    "དངོས་མེད་ཡིན་ཞེས་གསུངས་པའང་དངོས་པོ་མིན་ཞེས་བྱ་བ་ཡིནཞེས་གསུངས་པ་ལྟར་རོ།",
    "གསུམ་པ་ཐོགས་བཅས་ཐོགས་མེད་ལ་མཚུངས་པ་སྤང་པ་ནི་བྱས་པ་འམ་ཡོད་པར་མཚུངས་པ་འ་རྟག་མི་རྟག་གཉིས་མ་སྲིད་ན།",
    "མི་མཚུངས་ཏེ་བྱས་པ་འམ་ཡོད་པར་སྐྱེས་ཙམ་ཉིང་མི་རྟག་པ་ཡིན་གྱི་དེ་ལ་མི་རྟག་པ་དང་རྟག་པར་བྱེད་པའི་རྒྱུ་ཐ་དད་མེད་ལ།",
    "མི་རྟག་ངོ་བོ་ཐ་དད་མེད་ཅེས་གསུངས་པ་ལྟར་རོ།",
    "དོན་བྱེད་མ་ནུས་ན་ཡོད་པརུ་མིང་བརྟགས་ཀྱང་དངོས་མེད་ཡིན་པས་མིང་ལ་མི་བརྩད་དོ།",
    "གཉིས་པ་རང་རིག་གཅིག་པུས་འགྲུབ་པར་འདོད་པ་དགག་ན།",
    "མི་འཇིག་དེས་ན་འཇིག་པར་ཁས་ལེན་པ་ལ་གནོད་པ་ཅན་མི་འཇུག་ལདངོས་པོ་འཇིག་མེད་དེས་དོན་བྱེད་ནུས་སམ་མ་ནུས་ཞེས་བརྟགས་ནས་འགོག་པ་ཡིན་ནོགཉིས་པ་དེ་ལས་བྱུང་པའི་འབྲེལ་བ་དེས་པར་བྱེད་པ་ལ་གསུམ་ལས་གཞན་ལུགས་དགུག་ན་བར་ཁས་ལེན་པ་ལ་ལྟོས་མེད་མི་འཇུག་པས་ཡུལ་ཐ་དད་པ་ཡིན་ནོརྒྱུའབྲས་ཕྱུགས་ལྔས་ངེས་ཞེས་ཟེར།",
    "འགལཞིག་རྒྱུ་འབྲས་ཕྱུགས་ལྔས་ངེས་པར་བྱེད་དེ།",
    "དེ་དག་རྒྱུ་ཡིནཞེས་གསུངས་པས་སོ།",
    "མཀ་གསུངས་པ་ནི་གཉིས་ཀ་ལ་དགོངས་པ་ཡིན་ནོ།",
    "འབྲས་བུ་རྣམས་ནི་རྒྱུ་ལ་འཁྲུལ་པ་མེད་དོ་ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "པོ་ལས་གྲུབ་པ་དེའི་འབྲས་བུ་མ་ཡིན་ན་ཇོ་གཙུབས་པའི་མེ་མེ་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཚོགས་པ་རྣམ་པར་འཇོག་པ་ཡི་རྒྱུནི་ཚོགས་པ་ཅན་ཡིན་པས་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "རྡོ་དང་ཤིང་ནི་མེའི་རྡུལ་ཕྱོགས་གཅིག་ཏུའཚོག་པར་བྱེད་པའི་བདག་རྐྱེན་ཡིན་གྱི་ཉེར་ལེན་གྱི་རྒྱུར་མི་རུང་སྟེ།",
    "རྗེས་དཔོག་རིགས་པ་མ་ཡིན་ཏེ་ཡང་བས་ཐམས་ཅད་ངེས་པར་མི་ནུས་སོ།",
    "བར་རྣམས་འབྲེལ་པ་དོན་ལ་ཡོད་པར་འདོད་པ་ལྟར་ན་མཚན་མ།",
    "སྒྲ་དོན་དངོས་མེད་ལ་འབྲེལ་པ་བྱས་པས་རང་མཚན་གོ་བར་མི་ནུས་ཏེ་རང་མཚན་དང་དངོས་ཡོད་ཉིང་ལ་འབྲེལ་པ་མེད་པའི་ཕྱིར་བུམ་པ་ལ་འབྲེལ་པ་བྱས་པས་བ་གླང་མི་ག་བ་བཞིན་ནོ།",
    "དའཁྲུལ་པའི་གཞན་སེལ་ཁོ་ནསཡིནརྟོག་པས་སྒྲ་དོན་ལ་རང་མཚན་དུ་འཁྲུལ་པའི་གཞན་སེལ་གྱིས་དུ་བ་དང་མེ་དང་བྱས་པ་མི་རྟག་པ་ལསོགས་པའི་ལོག་པ་གཅིག་ཏུ་བཟུང་བ་ཉིད་ཡིན་ཏེ།",
    "ཁྱེད་རྗེས་འགྲོ་བ་སྤྱིའི་ངོ་བོ་ཉིད་དུ་རྟོགས་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "འབྲེལ་པ་ངེས་པར་བྱེད་ཅེས་གྲག།",
    "ངེས་པར་འདི་ལ་གཞི་མི་འདོད།",
    "བརྗོད་པ་ལས་ཀྱང་དེ་རྟོགས་ཕྱིར་ཞེས་གསུངས།",
    "ཡིད་དཔྱོད་མི་སྲིད་ལ་བཙདཔ་ཡིན་ནོ་ཤེས་ཡིན་ཡང་བཞི་པར་མི་འགྱུར་ཏེ།",
    "གཉིས་པ་འགལ་བའི་ན་ངེས་པར་བྱ་ན་འགལ་བ་སྤྱིའི་མཚན་ཉིད་དང་།",
    "ལ་རྟག་པ་ཕན་ཚུན་འགོག་ནུས་པར་འགྱུར་ཏེཔས་ས་གཉིས་པ།",
    "གཞན་ཡང་གནོད་བྱེད་ཅེས་བྱ་བ་འཇིག་པར་བྱེད་པ་ལ་ཟེར།",
    "འདོད་ན་ཐུག་པ་མེད་པར་འགྱུར་བས་སྐད་ཅིག་གསུམ་ལ་ལོག་པ་ངོས་མི་ཟིན་ནོཞིན།",
    "རྣམ་པར་རྟོག་པས་སྒྲོ་བཏགས་ནས།",
    "རྒྱུན་མི་ཟློག་ཅེས་བྱ་བས་ལྷན་ཅིག་མི་གནས་པ་གཅོད་པར་འདོད་དེ།",
    "ངས་འགལ་ནི་དགག་བྱ་རྣམ་པར་བཅད་ལྡོག་ཙམ་དུ་གནས་པའོ།",
    "དངོས་འགལ་གྱིས་ཁྱད་པར་དུ་བྱསཔ་དང་ལ་བྱས་པའོ།",
    "རྟག་པ་ལྟ་བུ་དང་རྫས་ལ་དངོས་འགལ་གྱིས་ཁྱད་པར་དུ་བྱས་པ་སོགས་མིན་དང་ཨུད་པ་ལའི་སྔོན་པོ་ལྟ་བུ་དང་།",
    "ལྡོག་པ་དངོས་འགལ་གྱིས་ཁྱད་པར་དུ་བྱས་པ་མེད་དགག་དཤེས་བྱའི་ལོག་པ་ལྟ་བུ་དང་གཏན་ཚིགས་མ་ཡིན་པ་དང་བྱས་པའི་གཏན་ཚིགས་ལསོགས་པ་དང་།",
    "ཁྱད་པར་དུ་མ་བྱས་པ་བྱས་ལྡོག་དང་མི་རྟག་པའི་ལྡོག་པ་ལསོགས་པ་ལྡོག་པ་ཐ་དད་པ་ཐམས་ཅད་ཡན་པས་དྲུག་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "འབྲེལ་པརྣམས་ཀྱང་འགལ་བར་འགྱུར།",
    "སྒྲ་པོ་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་འགལ་བརྣམ་པ་གཉིས་གོ་ཡང་མེད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་དང་འགལ་ལོ། ། གཉིས་པ་ཉེས་སྤོང་གལན་དགག་པ་ནི།",
    "རྫས་སམ་ལྡོག་པ་ཐ་དད་ས་སེར་ལསོགས་པ་མ་འབྲེལ་ཡང་རུང་མེ་དུད་དམ་བྱས་མི་རྟག་ལསོགས་པ་འབྲེལ་ཡང་འདུདཕན་ཚུན་ཐ་དད་ལྡན་པ་དང་ངོ་བོ་ཡིན་པ་འགོག་ལ།",
    "ལྡོག་པ་ཐ་དང་ཕན་ཚུན་པ་གཞན་སེལ་གྱིས་མི་ཁེགས་པར་ཐམསཅད་དུ་འགལ་དམིགས་སྦྱོར་དགོས་པར་འགྱུར་རོ།",
    "གསུམ་པ་ཐ་དད་ལ་འགལ་བར་གསུངས་པའི་དགོངས་པ་ནི།",
    "ཐ་དད་འགལ་བར་གསུངས་པ་ནི།",
    "དཔེར་ན་འདུས་བྱས་དང་རྟག་པ་དང་ལྟོས་བཅས་དང་ངེས་དངོས་དང་བདག་དང་ཕུང་བཙཔོ་དང་དངོས་པོ་དང་བདེན་དངས་ལསོགས་པ་ཕན་ཚུན་འགོག་པའོ།",
    "དེ་དག་རྣམ་པར་གཞག་འཇོག་ཡིན།",
    "མིཤེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཐ་དད་ལྡན་པར་མི་སྒྲུབ་ཀྱི་ངོ་བོ་དབྱེ་མིད་དུ་སྤྲུབ་པས་ཡལ་ག་ཉིད་ཀྱང་ཤིང་དུ་གྲུབ་བོ་ཅེ་ན།",
    "ཤེས་བྱའི་ཐ་སྙད་ལ་ཐ་སྙད་གཉིས་པ་མེད་ཀྱང་ཐ་སྙད་སྔ་མ་ཤེས་བརྗོད་ལས་འཨཔར་མ་འགྱུར་ཏེ།",
    "རིགས་པ་འདི་མཚན་ཉིད་ནསྔ་མ་ཤེས་བརྗོད་ལས་འདས་པར་འགྱུར་རོ་ཞེས་ཟེ།",
    "ལོ་ཅག་སྒྲ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་གཞན་སེལ་དུ་འདོད་ལ།",
    "དྲན་པར་བྱས་པས་འགྲུབ་པོ་སྒྱུ་བ་འདིར་གཏོགས་ཀྱང་གོ་སླའོ།",
    "དེ་ཉིང་མཚན་ཉིད་ཡིན་པར་ཡང་གང་དངོས་འགལ་གཅོད་པའི་དོན་ལྡོག་གྲུབ་པ་ལ་མཚན་ཉིད་ཀྱི་བརྡ་སྦྱར་ཏེ་ཡལ་ག་དང་ལྡན་པ་ལ་ཤིང་བཞིན་ཞེས་པ་ཉིད་ཀྱིས་འགྲུབ་འདསྦྱོར་བ་འདིར་གཏོགས་ཀྱང་བྱེ་བྲག་ལ་བཀར་ཏེ་བརྗོད་པ་ཉིད་ཀྱིས་ཤེས་པར་སླའོད་གསུམ་པ་རྩོད་པ་སྤང་བ་ནི་ཚུལ་གསུམ་ཚུལ་གསུམ་མེད་ནརྟགས།",
    "ཚུལ་གསུམ་ལ་ཚུལ་གསུམ་མ་ཚང་ན་ཚུལ་གསུམ་གཤ་ཚིགས་མ་ཡིན་པར་འགྱུརལཚང་ན་དེ་ཉིད་ཚུལ་གསུམཾ་གཉིས་པ་ཡིན་པས་དེ་ཉིད་ལ་། ལྟོས་ནས་ཚུལ་གསུམ་གསུམ་པ་དང་བཞི་པ་ལསོགས་པ་ཁྱེད་ལའང་ཐུག་མེད་དུ་འགྱུར་རོཞིན།",
    "དཔོ་མི་མཚུངས་ཏེ་མི་རྟག་པ་ལ་མ་ལྟོས་པར་བྱས་ལྡོག་འགྲུབ་ལོ་འདིར་མཚོན་བྱ་མ་གྲུབ་ན་མཚོན་བྱའི་དོན་ལྡོག་། མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "ཁ་ཅིག་དེའི་སྟེང་དུ་གཞན་གྱི་ཐ་སྙད་དང་གཞན་གྱི་ཐ་སྙད་ཀྱིས་ཁྱད་དུ་བྱས་པ་བཀོད་པ་སྟེ།",
    "མི་གནས་ན་ལྡོག་པ་ལ་དེ་དང་དེ་མིན་གྱི་མཚན་གཞིར་ཁཚོནམ་ཆོད་པར་འགྱུར་བའི་ཕྱིར་བཞེས་སྨྲས་པ་དང་བཅས་ནས་བསུང་ངོ།",
    "དོན་ལྡོག་གཞན་གྱུར་མེད་པར་འགྱུར།",
    "དེས་ནཐ་སྙད་དེ་དག་རྣམ་པར་འཁྱམས་པ་ཡིན་ནོ།",
    "སྒྲ་ཇི་ལྟར་གཅོད་པ་ལྟར་དོན་ཡང་དེ་ལྟར་རྣམ་པར་གཅོད་པས་མཚན་ཉིད་ཀྱི་སྐྱོན་གསུམལས་མི་འའོ།",
    "དང་པོ་ལའང་གཉིས་ལས་དངོས་པོའི་རང་ལྡོག་མ་གྲུབ་པ་ནི་རང་བཞན་གྱི་ཐ་སཱང་དང་ཐ་སཱད་ཀྱིས་ཁྱད་པར་དུ་བྱས་པ་མཚན་ཉིད་དུ་བཀོད་པའོ།",
    "ལྡོག་པ་ཐ་དད་པ་ཙབྱས་པའི་མཚན་ཉིད་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་བཀོད་པ་ལྟ་བུལོ་འདི་མི་སྲིད་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དེས་ན་ཐ་དད་རྣམ་པར་གནས་ཞེས་ད་ཚཅིག་ཆ་ཤས་སྒྲོ་འདོགས་ཇི་སྙེད་པ།",
    "དེས་ན་རྫུ་ལ་ལྐོག་ཤལམཚན་གཞི་ལ་མ་སྲིད་ལ་བྱས་པ་ལ་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་མཚོན་བྱ་ལ་མ་སྲིད་པ་ཡིན་ནོ།",
    "ཚུལ་གསུམཁགྱིས་སྟོང་པ་ལ་ཚུལ་གསུམ་བཀོད་པ་ནི་དེར་མི་འགྱུར་ཏེ་ཁྱད་པར་བཀག་ལྟོག་ཉིད་ལ་ཚུལ་གསུམ་ཚང་བའི་ཕྱིའི་འོད།",
    "ཀར་ཟལལ་འཀོད་ན་སྐྱོན་མེད་དུ་འགྱུལཞིངནག་སྒྱུར་ལ་བཀོད་ན་མི་སྲིད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མ་བཀོད་པ་ལ་རྩི་ནམཚན་གཞིའི་སྐྱོན་ཐམས་ཅད་མི་འཐད་པར་འགྱུར་ཏེ།",
    "དེ་བྱས་པས་མི་རྟག་པ་སྒྲུབ་པ་བཞིན་ནོ།",
    "རྣམ་ངེས་ལས་ཡུལ་གྲུབ་པས་ཡུལ་ཅན་ཤེས་པ་དང་སྒྲ་དང་ཐ་སྙད་དག་རྟོགས་པ་འམ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "བྲིས་པ་རྨི་ལྟར་འབྲེལ་པའི་ཚུལ་ལག་འཐུས་རང་བཞིན་འབྲེལ་པའང་ཡོད་དེ་དངོས་པོ་མི་རྟག་པ་མཚོན་པ་ལ་དུས་གཉིས་པར་མི་སྡོད་པ་བཀོད་པ་དགཉིས་དང་མཚན་གཞི་གནས་སྐབས་འབྲེལ་ལ།",
    "གཉིས་པོ་དམ་། ཡིན་ཏེ་དཀར་ཟལ་མཚན་ཉིད་ཙམ་མ་ཡིན་པར་མཚོན་པ་འཁྲུལ་པའི་སྐབས་སྲིད་ལ།",
    "མ་ཁྱབ་བྱས་ན་ཉེས་པ་མེད།",
    "གཉིས་པ་གཞན་ལྡོག་ཡིན་པར་མཚོན་ཚུལ་ལ་བསྟོད་པ་སྤོང་བ་ལ་གསུམ་སྟེ།",
    "འཛིན་སྟངས་གྱི་ཁྱད་པར་དོན་ལ་མི་འཁྲུལ་བའི།",
    "དེ་འང་བློ་དོན་དང་མཐུན་པར་འཛིན་པ་ཙམ་ཡིན་ཏེ།",
    "དེ་འཛིན་གྱི་སྤྱི་རིགས་དེ་དོན་མེད་པར་འབྱུང་མི་སྲིད་པ་དུ་བ་མེད་ལ་མི་འཁྲོལ་བ་ལྟ་བུའོ།",
    "དང་པོན་ཤེས་པམི་འཁྲུལ་བ་དོན་ཇི་ལྟར་གནས་པ་ལྟར་ཡོད་པ་ལ་ཡོད་པར་ཤེས།",
    "དོན་བྱེད་ནུས་པར་གནས་པ་ནི།",
    "མཾ་ཞུ་བ་ཞེས་གསུངས་བས་སོ།",
    "དོན་བྱེད་ནུས་པར་ཡོད་མེད་དཔྱོད་པའི་ཁུ།"
  ]
}