    "དེ་ཚེ་བློ་དོན་མེད་ཉམའགྱུར་ཞེས་། གསུངས་པས་སོ།",
    "གཞལ་བྱ་གཉིས་སུ་གསུངས་པ་དང་འགལ་བ་སྤང་བནི།",
    "གཞལ་བྱ་གཉིས་ཡོད་ནསོ་གཉིས་སུ་གསུངས་པ་མ་ཡིན་གྱི།",
    "ལྐོག་གྱུར་གྱི་རང་མཚན་གཞན་ལས་འཇལ་བ་ལ་དགོངས་ནས་གཉིས་སུ་གསུངས་པ་ཡིན་ཏེ།",
    "ཅེས་གསུངས་པ་ལྟར་རོ།",
    "ཁཅིག་དོན་སྤྱི་དང་མེད་པ་གསལ་བ་གཉིས་ཀ་ཡུལ་མ་ཡིན་པར་མཚུངས་པ་ལ་བློའི་འཇུག་ཚུལ་གྱིས་དོན་སྤྱི་དང་གཞལ་བྱར་འཇོག་པ་ལྟར་རྟོག་མེད་འཁྲུལ་པའི་དམིགས་པ་དེའངོ་། ཡུལ་གསུམ་བར་ཅིའི་ཕྱིར་མའགྱུར་ཅེ་ན།",
    "ཞེན་པ་བྱས་ཀྱང་དོན་དང་ཕྲད་པོ་འང་མེད།",
    "རྟག་ཏུ་ཡོད་པ་འམ་མེད་པར་འགྱུརཅས་པས་ཁེགས་ལ།",
    "དོན་དམ་པའི་དེ་ཁོ་ན་ཉིདི་ལ་འཇུག་པ་ན་སྤྲོས་པ་དང་ལབ་ལ་འཇུག་པར་མཛད་དོ།",
    "འཛིན་འགྱུར་གཞན་འགའི་མ་ཡིན་བཞིནཅེས་གསུངས་པ་ལྟར་འདོད།",
    "ཅིག་དང་དུ་མའི་རང་བཞིན་མེད་ཅེས་གསུངས་པ་ལྟར་རོ།",
    "པའང་གང་ཟག་འཇིག་རྟེན་མ་ཡིན་གྱི་བློ་འཇིག་རྟེན་པ་མ་བརྟགས་མ་དཔྱད་པར་འཇུག་པ་དང་འཇུག་གནས་ཟོར་རོ།",
    "སྔོ་དང་རི་བློ་གཞན་མ་ཡིན་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "མི་མཐུན་ཕྱོགས་དངོས་པོ་ཐ་དད་དུས་མི་མཉམ་པ་ལ་ལྕན་ཅིག་དམགས་ངོས་ནི་དུས་མི་མཉམ་པར་འཛིན་པཉིད་ཀྱིས་ཁགོས་ལ།",
    "དུས་མཉམ་པ་ལ་འང་སྒོ་བཏགས་པ་ནི་སྤྲོ་བཏགས་པར་ཤེས་པ་ཉིད་ཀྱིས་ཡུལ་གཞན་མེད་པར་གྲུབ་ཅིང་།",
    "སྣུམ་གཉིས་ཀྱིས་ཁྱད་པར་དུ་མ་བྱས་པའི་རིག་པ་ཙམ་འགོད་དེ།",
    "གམར་ཤུལ་དུ་རྩོམ་པའི་གཅིགམི་སྲིད་པའི་ཕྱིརའོ་འོ་རྡུལ་ཕྲན་ཡང་གཅིག་ཡིན་ན་དྲུག་ཡིན་པར་འགལ།",
    "དེ་ནི་བདག་མེད་ལྟ་རྟེན་ཡིན་ཞེས་གསུངས་པས་སོ།",
    "རྟགས་མི་འགོད་པར་ཡོད་ཚོས་དམ་བཅའ་རྐྱང་པ་ནི་ནི།",
    "གཏན་ཚིགས་ལྟར་སྣང་བའི་པར་འགྱུར་ཡིད་དཔྱོད་འགལ་མ་ངེས་མ་གྲུབ་གསུམ་ལ་བརྟེན་པོའི་བློ་གསུམ་དུ་མི་འདུན་ཡིད་དཔྱོད་སྐྱིད་པོ།",
    "རྟགས་ཞེས་བྱ་བ་ལྟར་སྣང་བཞི་པ་སྲིད་པར་འགྱུར་རོ།",
    "རྗེས་སུ་དཔག་པ་འང་མིན་པར་འགྱུར།",
    "གཉིས་ཀ་བདེན་པར་འདོད་ན་འགལ་བ་ལ་མི་འཁྲུལ་བ་སྲིད་པར་འགྱུར་ཞིང་།",
    "ཇི་ལྟར་མ་ངེས་པ་ལས་ངེས་པར་འགྱུརཉིས་བྱ་བ་དང་།",
    "ཡོདཀྱང་དངོས་པོས་མ་བྱས་པའི་རྟོགས་པ་ནི་མེད་པ་རྟོགས་པ་དང་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ཏེ་ཡིད་ཆེསཾ་པ་མེད་པའི་ཕྱིན།",
    "གཞལ་བྱས་མི་རྟག་པ་སྒྲུབ་པ་དངོས་གྱི་མ་ངེས་པ་དང་།",
    "མངོན་སུམ་ལ་མཆིད་ཞུགས་པའི་ཕྱིར་། ཕྱིར་དེ་ཚང་མ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དཔྱད་ན་བོཅད་ཤེས་མ་རྟོགས་པར་འདུ་སྟེ།",
    "པར་འདུ་བ་བཞིན་ནོ།",
    "སབསྐྱེ་ནུས་ལཾཁེངས་སུ་འདུ་བའི་རྟགས་ཀྱི་རྣམ་གཞག་ཐམས་ཅད་ཀྱང་ནུབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་དབྱེ་བས་བྱས་པ་ཡིན།",
    "མི་འདོད་འདོད་པའི་ངེས་སྦྱབ་བྱེད་ཅེས་གསུངས་པ་ལྟར།",
    "ཀ་ཡང་གཞལ་བྱ་རང་མཚན་དུ་འདུ་བར་གསུངས་པ་བཞིན་ནོ།",
    "རྟགས་ལ་ལྟོས་པ་འགལཞིག་ཡང་དཔྱད་དུ་འདོད་ལྟོས་པ་མཉན་བྱ་དང་གཞལ་བྱས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་ལསོགས་པ་མ་ངེས་པའི་རྟགས་མཐའ་དག་དང་པཁྲོན་བ་ན་ཆུ་ཡོད་སྙམ་པ་འམ།",
    "འབྲེལ་པ་ཡང་དག་དུ་ན་མེད་ཅེས་གསུངས་པ་ལྟར་རོ།",
    "ཁོ་བོ་གཞུང་བཞིན་འཆད་པར་འདོད།",
    "གཉིས་པ་རྫས་ལྡོག་དོན་ལ་གྲུབ་པར་འདོད་པ་དགག་པ་ལ་གཉིས་ཏེ།",
    "དེ་ཕྱིར་དེ་དག་རྟགས་སེལ་བཡིད་ཡུལ་ཅན་ཡིན་པར་རབ་ཏུབསྒྲགས།",
    "ལྡོག་པར་བྱེད་པ་སྤྱི་བྱེ་བྲག་རིགས་མི་མཐུན་ལས་ལྡོག་པ་སྤྱི།",
    "མཚན་ཉིད་མི་འགྲུབ་དགག་སྒྲུབ་ཀྱི་རྣམ་པར་གཞག་པའང་འཇིག་པར་འགྱུརཡོནནག་པའི་སྤུ་དེ་ལྡོག་གཉིས་ཚོགས་སུ་འགྱུར་ལ།",
    "། ལསོགས་པ་ཡལ་ག་ལོ་འདབ་དང་ལྡན་པར་མཚན་ཉིད་མཚུངས་པའི་སཱི་དང་བྱེ་བྲག་རྣམས་རྫས་ཅིག་ག་ཙིན།",
    "མཐོང་དང་མཚུངས་པར་དེ་འཛིན་ཕྱིར།",
    "བློ་ལོ་སྤྱི་ཚིག་ལ་ཤར་ནོམཚུངས་པར་འཛིན་པས་སྤྱིའི་གོ་མི་ཆོད་དོ།",
    "སྒྲའི་དོན་ནི་བརྟགས་པས་ཡིན་ཅེས་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་པ་དང་།",
    "མིང་ཐ་དད་པར་ཟད་དེ་དོན་ལནཅིག་སྐྱེ་བ་དང་འཇིག་པ་དག་དང་ཐམས་ཅད་ལ་ཐམས་ཅད་ཉེ་བར་སྤྱོར་བའགྱུར་འོད་དེ་ལྟ་མ་ཡིན་ན་གཅིག་ཅེས་བྱ་བ་ཉིད་དུ་མ་འགྱུར་བ་འམཡང་དེ་ལ་ཡང་སྐྱེ་བ་ཡོད་པས་འགལཞིག་ལས་འོངས་པ་མེད་པ་དེ་ལྟ་ན་བླུན་པོ་ལས་འགལ་བའི་ཁུར་སུས།",
    "གཞན་ཡང་འདིས་མི་རིགས་པ་ཅི་ཞིག་མངོནཔར་སྤྱད་ནས་དེ་ལྟར་དུབ་པ་མང་པའི་སྤྱི་སྣ་བ་ལ་རྟེན་པ་ཡིན་ཅེས་གསུངས་པས་སོ།",
    "སི་ཁེགས་པས་བྱེ་བྲག་འགོག་པ་ཁྱབ་བྱང་མི་དམིགས་པ་ལསོགས་པརྟོགགེའི་རྣམ་གཞག་དང་འཇིག་རྟེན་གྱི་བྱ་བ་ཐམསུསུད་འཇིག་པའགྱུར།",
    "གཉིས་པ་སོ་སོའི་རང་བཞིན་ངེས་པར་བྱ་བ་ལ་གཉིས་ཏེ།",
    "གསུམ་པ་མཚན་གཞི་ལ་མཚན་ཉིད་ངེས་པར་སྒྲུབ་པ་ལ་གསུམ་ལས་ཡུལ་གྱིགནས་ལུགས་ནི།",
    "སྔོན་པོ་ཉིད་དང་དེའི་བྱས་མི་རྟོག་ཀྱང་ཐ་དད་མེད་པ་དང་།",
    "རྟགས་མི་སྲིད་པ་སྤང་བ་ནི་བྱས་པ་དང་།",
