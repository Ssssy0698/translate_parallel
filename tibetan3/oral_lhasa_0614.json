    "རྣམ་པར་རྟོག་པ་བཞིན་དུ་དོན་གྱི་ཡུལ་ཉིད་དུ་རྟོག་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ལ་འཛིན་པ་ཉིད་དུ་རུང་བ་མ་ཡིན་པ་རྣམ་པར་དབྱེ་བའོ།",
    "རྣམ་པར་རྟོག་པའི་དབྱེ་བ་བརྗོད་པའི་དགོས་པ་བསྟན་པ་ནི།",
    "གཉི་གར་ཞེས་བྱ་བ་ནི་ཆུ་ལ་ཡང་སྐོ་འདོགས་པ་ནི་རྣམ་པར་རྟོག་པ་ལའམ་ཡན་ལག་ཅན་ལའོ།",
    "དེ་ཉིད་དམ་ཞེས་བྱ་བ་ནི་སྒྲོ་འདོགས་པ་དང་རྣམ་པར་རྟོག་པ་དག་གོ།",
    "ཉིད་ཀྱིས་ཉམས་སུ་མྱོང་བའི་བརྡ་དྲན་པ་ལ་ལྟོས་པ་ཉིད་མངོན་སུམ་མ་ཡིན་པ་ཉིད་ཀྱིས་ཁྱབ་པར་མཐོང་བར་བསྟན་པ་ནི།",
    "མངོན་སུམ་རྟོག་པ་དང་བྲལ་བ་ཞེས་བྱ་བ་དེ་དག་ཙམ་གྱིས་ནི་ཟླ་བ་གཉིས་ཀྱི་ཤེས་པ་ཡང་རྟོག་པ་དང་བྲལ་བའི་ཕྱིར་མངོན་སུམ་ཐོབ་པར་འགྱུར་བ་ལ་དམིགས་ཀྱིས་བསལ་བར་བྱེད་པ་ནི་རབ་རིབ་དང་བཅས་པ་སྨོས་པས་ཞེས་བསྟན་པ་ནི།",
    "ཁྱད་པར་གྱི་རྗེས་སུ་དཔག་པ་ལས་གཞན་པ་ཁོ་ན་ལའོ།",
    "གཞན་གྱི་གཞུང་ལུགས་བསལ་བའི་དོན་དུ་ཁྱད་པར་དུ་ཞེས་བྱ་བ་ནི་རྟོག་པ་དང་བྲལ་བ་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་གཅད་པར་བྱ་བ་ནི་གཞན་གྱི་གཞུང་ལུགས་ལས་གཞན་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གནོད་བྱ་གནོད་བྱེད་ཀྱི་ཚུལ་ཞེས་བྱ་བ་ནི་སྤྱི་དང་ཁྱད་པར་གྱི་ངོ་བོའོ།",
    "དེའི་དུས་སུ་གནོད་པར་བྱེད་པ་མེད་ཀྱང་དུས་ཕྱིས་འགྱུར་བར་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "རབ་རིབ་ཅན་གྱི་དམིགས་པ་ནི་མིག་སེར་ཅན་ལ་ཡང་ཁྱད་པར་མེད་པའི་ཕྱིར་ཉེ་བར་མཆོན་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཟླ་བ་གཉིས་ཀྱི་ཤེས་པ་རྟོག་པ་ཡིན་པར་སྨྲ་བའམ།",
    "ཕྱོགས་སྔ་མ་བསྟན་པ་ནི་རྣམ་པར་རྟོག་པའི་ཞེས་བྱ་བ་སྟེ་གལ་ཏེ་ཞེས་བྱ་བ་ལ་ལྟོས་པ་ཡིན་ནོ།",
    "དེའི་ཡང་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་སྟེ་མཐོང་བའི་རྗེས་སུ་འབྲང་བ་ཉིད་ཀྱི་ཕྱིར་དྲན་པ་བཞིན་དུའོ་ཞེས་དགོངས་པའོ།",
    "ལྡོག་འགྱུར་ཞེས་བྱ་བ་ནི་རྣམ་པར་དཔྱོད་པས་སོ།",
    "ལྡོག་པར་མི་འགྱུར་ཞེས་བྱ་བ་ནི་རྟག་པ་ཉིད་ཀྱི་འཁྲུལ་པ་བཞིན་ཏེ།",
    "སྦྲུལ་དུ་འཁྲུལ་པ་ནི་རྣམ་པར་འགྱུར་བ་ཡོད་ཀྱང་།",
    "རྣམ་པར་དཔྱད་ན་མ་གྱུར་པ་མ་ཡིན་ནམ།",
    "ནག་པོ་ཉིད་ལ་སོགས་པ་ནི་རྣམ་པར་འགྱུར་བ་ཡང་ན་རྣམ་པར་དཔྱད་པ་ལ་སོགས་པས་མི་ལྡོག་པའི་ཕྱིར་རོ།",
    "དཔྱད་དུ་རུང་བ་ལ་སོགས་པའི་འཁྲུལ་པ་ལྡོག་པར་འགྱུར་རོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "རྣམ་པར་འགྱུར་བ་ལས་སྐྱེས་པའི་ནག་པོ་ལ་སོགས་པའི་ངོ་བོ་ནི་ཟླ་བ་གཉིས་ཀྱི་ཤེས་པ་བཞིན་དུ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ཡང་ཡིད་ཀྱི་ཞེས་བྱ་བ་འདི་ལ་ཡིད་ཀྱིས་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ཅན་ཡིན་ལ།",
    "རྟོག་པ་དང་བྲལ་བ་སྨོས་པ་ཉིད་ཀྱི་ལྡོག་པ་ཁས་ལེན་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྟོག་པ་དང་བཅས་པར་ཞེས་བྱ་བའོ།",
    "ཕན་འདོགས་པར་བྱེད་པ་ཉིད་དུ་ཞེན་པ་ནི་ཆུར་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི།",
    "ཕན་འདོགས་པ་དང་གནོད་པ་བྱེད་པར་སྣང་བ་ཞེས་བྱ་བའོ།",
    "འཁྲུལ་པ་ཅན་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རིགས་ཀྱི་ཐ་སྙད་གདགས་པར་བྱ་བ་ཉིད་མ་ཡིན་ཏེ།",
    "ཐ་སྙད་གདགས་པར་བྱ་བ་ཉིད་ཀྱང་ངོ།",
    "གཞན་གྱིས་གཞན་ལ་གང་དུ་ཐ་སྙད་གདགས་པར་བྱ་བ་ནི་ཉ་ཕྱིས་ལ་དངུལ་བཞིན་དུ་དེ་ལྡོག་པ་ཡང་མ་ཡིན་ཏེ།",
    "གཉི་ག་ལས་སྐྱེས་པ་ཉིད་ནི་གང་ཡང་རུང་བ་ཉིད་དུ་རྣམ་པར་གཞག་པ་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བརྗོད་པར་བྱ་བའོ་ཞེས་བྱ་བ་ནི་སྐྱེས་བུ་དང་པོ་རྣམས་ལ་སོགས་པ་རྣམས་ལ་དོ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་པའི་སྣང་བ་ལས་སྐྱེས་པ་ཉིད་མི་སྲིད་པར་བསྟན་པ་ནི།",
    "འོན་ཏེ་སྐྱེད་པར་བྱེད་པ་གང་ཡིན་པའི་དོན་དེ་ལ་དམིགས་པ་ཡིན་ན།",
    "ཤེས་པ་མེད་པར་མཚོན་མ་ཡིན།",
    "བྱ་བ་སྒྲུབ་པར་བྱེད་ཅེས་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་སྐྱེད་བྱེད་ཀྱིས་ངེས་པར་བྱེད་ན།",
    "ངེས་པར་འབྱེད་པའི་ཤེས་པ་ནི།",
    "རྣམ་པར་གཞག་པར་འོས་པ་ཡང་ཞེས་བྱ་བ་ནི་རྣམ་པར་གཞག་པར་འདོད་པ་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "བློ་ནི་རྣམ་པ་དང་བཅས་པ་ཡིན་པའི་ཕྱིར་འདི་རྣམ་པར་གཞག་པ་ཡིན་གྱི།",
    "ཤིན་ཏུ་སྟབས་ཡིན་ན་ཐག་རིང་བ་རྟོགས་པར་མི་འགྱུར་བར་བསྟན་པ་ནི་ཡུན་རིང་པོ་ཅན་མ་ཡིན་པ་ཞེས་བྱ་བའོ།",
    "གཞན་ནི་ཞེས་བྱ་བ་ནི་རིག་བྱེད་ཀྱི་མཐའི་དགོངས་པ་འཆད་པར་འགྱུར་བ་ནི།",
    "རྣམ་པར་ཇི་ལྟར་བདེན་འགྱུར་ཏེ།",
    "ངེས་འཛིན་པའི་དབྱེ་བ་ལ་ཁྱད་པར་ལས་ནི་མ་ཡིན་ཏེ་སཱ་ལུ་དང་ནས་ལ་སོགས་པའི་ས་བོན་ཐ་དད་པ་ལ་དེས་སྐྱེད་པ་ཉིད་ཙམ་གྱི་མྱུ་གུ་ལ་ཐ་དད་པ་མ་ཡིན་གྱི་འོན་ཀྱང་འབྲས་བུའི་ཐ་དད་པ་མཐོང་བ་ལས་རང་བཞིན་ཐ་དད་པ་ཡོད་པར་བསྟན་པ་ནི།",
    "ཤེས་པ་ལ་བྱེད་པ་པོ་ཡིན་པའི་ཕྱིར་ངེས་པར་བྱེད་པ་ཉིད་ནི་རྣམ་པར་འབྱེད་པ་ཉིད་ཀྱིས་ཡིན་པར་བསྟན་པ་ནི།",
    "ངེས་པར་ཤེས་པར་བྱེད་པ་ཉིད་ཡིན་པར་ཟེར་བ་ནི།",
    "ཤེས་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་མིག་ལ་སོགས་པ་རྣམས་སོ།",
    "སྣང་བ་གསལ་བ་ཡང་རིག་པའི་བདག་ཉིད་མ་ཡིན་པའི་རྣམ་པ་མེད་པའི་ཤེས་པས་ཇི་ལྟར་རིག་པར་བྱེད་ཅེས་བྱ་བའི་ཕྱོགས་ཉིད་ལ་འདི་བསྟན་པ་ནི།",
    "གཞན་ཞེས་བྱ་བ་ནི་ཤེས་པ་ཉིད་དེ་ཤེས་པ་ཡོད་ན་ངེས་པར་ཡོད་པས་འདིའི་རང་བཞིན་དུ་བརྗོད་དེ།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་དེའི་བྱ་བ་རྟོགས་པ་ནི་བྱེད་པའི་ངོ་བོ་ཁྱད་པར་ཅན་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་ལས་ལ་ངེས་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ་རྣམ་པ་དང་ལྡན་པའི་ཤེས་པ་ལས་བྱ་བ་ཐ་མི་དད་པའི་བྱ་བ་རྣམ་པ་དང་ལྡན་པ་ཡིན་ན།",
    "རང་ཉིད་ངེས་པ་ཅན་ཡིན་པར་བསྟན་པ་ནི།",
    "རྣམ་པ་དང་བཅས་པ་ཉིད་ཀྱི་དོན་རིག་པར་བྱེད་པ་ནི་བདེན་ཏེ།",
    "ཁྱད་པར་བཞིན་དུ་ཁྱད་པར་དུ་བྱས་པའི་ངོ་བོ་ཁས་བླངས་པས་བདག་མ་ཡིན་པ་རིག་པ་ནི་བདག་མ་ཡིན་པ་ཁོ་ནས་རིག་པའི་ཕྱིར།",
    "ཅིའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དེའི་རྣམ་པ་མ་ཡིན་པ་ཉིད་གཉི་ག་ཡང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ནས་འབྲས་བུ་མེད་ཅིང་དེ་དང་ལྡན་པ་ཡང་མེད་པར་ཟེར་བ་ནི།",
    "གལ་ཏེ་འདོར་བ་ལ་སོགས་པའི་བྱེད་པ་ནི་རིགས་པས་རྣམ་པར་གཞག་པ་ཡང་ཅིའི་ཕྱིར་དངོས་སུ་བ་མ་ཡིན་སྙམ་དུ་སེམས་པ་ལ།",
    "དངོས་སུ་བའི་མངོན་སུམ་ལ་རིགས་པ་ཆེན་པོ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྣམ་པར་རྟོག་པའི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཡང་རྣམ་པར་འཇོག་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མཐོང་བ་ལ་སོགས་པ་ཡང་རྣམ་པ་བཞིན་དུ་རྟོགས་པ་དང་རྣམ་པར་གཞག་པ་དག་སྔ་མ་དང་ཕྱི་མ་དག་མེད་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ལ་སྔ་མ་དང་ཕྱི་མ་མེད་ཀྱང་བྱེད་པ་དང་།",
    "ཅིག་ཤོས་ལ་སོགས་པ་འཇིག་རྟེན་པ་མ་ཡིན་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རང་ཉིད་ཀྱིས་དེའི་རྣམ་པར་འཇོག་པར་མི་བྱེད་ན།",
    "ཡུལ་དེ་ལ་ངེས་པར་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་གཞག་པ་ཉིད་ལ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ཡང་དེའི་རྣམ་པར་གཞག་པར་བྱེད་པ་ལ་དེའི་རྣམ་པ་ཉིད་ཁོ་ན་མདུན་དུ་བྱེད་པ་ཡིན་གྱི་ཁས་བླངས་པ་འབའ་ཞིག་ལས་ནི་མ་ཡིན་ཏེ།",
    "དེ་ཡི་སྒྲུབ་བྱེད་དམ་པར་འདོད།",
    "དེའི་བདག་ཉིད་འཛིན་པ་དེ་དོན་རྟོགས་པའི་བདག་ཉིད་ཀྱི་ཞེས་གསུངས་པའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་ནི།",
    "དོན་ལས་ཀྱང་ལྐོག་ཏུ་མ་གྱུར་པ་ཉིད་ཀྱི་ངོ་བོའི་ཤེས་པའི་ཁྱད་པར་བསྟན་པ་ནི།",
    "འདི་ཉིད་ཀྱི་དོན་གྱི་འབྲས་བུ་ཉིད་ཀྱང་བརྗོད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཤེས་པ་རྣམ་པ་མེད་པར་སྨྲ་བ་འགྲུབ་པོ་སྙམ་དུ་སེམས་པ་ལ།",
    "འོན་ཀྱང་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱི་རོལ་གྱི་བེམས་པོ་ཉིད་དེ་ལས་ལྡོག་པ་དང་འགལ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་དག་ཅེས་བྱ་བ་ནི་བསྟན་པའིའོ།",
    "རང་ཉིད་མེད་པའི་མེད་པ་ཉམས་སུ་མྱོང་བས་གནོད་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "འདྲེས་པ་ཡིན་གྱི་གཞན་དུ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "བཞིན་ལ་སོགས་པ་མེད་པར་ཡང་ཞེས་བྱ་བའོ།",
    "བ་ལང་དང་དཀར་པོ་དང་འགྲོ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྟོགས་པ་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "བ་ལང་དཀར་པོ་དང་འགྲོ་བ་ཞེས་བྱ་བ་བ་ལང་ཉིད་ལ་སོགས་པའི་ཁྱད་པར་ནི་ཐ་དད་པས་དེའི་ཤེས་པ་ཁྱད་པར་དུ་མི་བྱེད་ན།",
    "རྣམ་པར་འཇོག་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་བློ་ཡང་ཞེས་བྱ་བའོ།",
    "ཁྱད་པར་དུ་བྱ་བའི་ཤེས་པ་རྣམས་ཀྱང་དེ་བཞིན་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་མ་ཡིན་པའི་ངོ་བོའི་ཁྱད་པར་ཅན་གྱི་བློ་ཉིད་མི་འགྲུབ་བོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡང་འདིའི་འདི་ཞེས་དེ་གང་ལས་ཞེས་བྱ་བ་བསྟན་ཟིན་ཏོ།",
    "ཁྱད་པར་སྔར་ཁོ་ན་ཡིན་ལ་ཁྱད་པར་དུ་བྱ་བ་ཉིད་ནི་ཕྱིས་འཛིན་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་ལའོ།",
    "པར་དུ་བྱ་བ་ལ་བརྟེན་པ་ཉིད་དོ།",
    "ཁྱད་པར་ནི་ཁྱད་པར་དུ་བྱ་བ་ལ་ལྟོས་པ་ཡིན་ལ།",
    "ཁྱད་པར་དུ་བྱ་བ་ཉིད་ཀྱི་དེ་ལ་ལྟོས་པ་ཡིན་པས་དེ་འཛིན་པ་ན་གཟུང་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་ལ་བསྟན་པ་ཡིན་ནོ།",
    "དེའི་དུས་སུ་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དུ་བྱ་བ་རྟོགས་པའི་དུས་སུ་ཡང་ངོ།",
    "བསྐྱེད་པ་མ་གཏོགས་པའི་བྱ་བ་མེད་པའི་ཕྱིར་ཁྱད་པར་དུ་བྱ་བའི་ཤེས་པ་ཉིད་བཞིན་དུ་དེ་ཡང་ཡིན་པའི་ཕྱིར་གཅིག་དོན་མེད་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱེད་བྱེད་མ་ཡིན་ན་དེའི་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྔ་མ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་དུས་ཉིད་ན་ཁྱད་པར་འཛིན་པ་ཡིན་ནོ།",
    "ཤེས་པ་གཅིག་ཉིད་རིམ་གྱིས་འཇུག་པ་ཡིན་གྱི་དུ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་མི་རིགས་པར་བསྟན་པ་ནི་གཅིག་ལ་ཞེས་བྱ་བའོ།",
    "ཅི་ལས་ཤེ་ན་སྔ་མ་དང་ཁྱད་པར་མེད་དོ་ཞེས་སྨོས་སོ།",
    "བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་མེད་པར་འགྱུར།",
    "དེའི་འདུ་བ་དང་དེའི་ཁྱད་པར་ཉིད་ཀྱང་ཡིན་ལ།",
    "གཞན་གྱི་ཚེ་དེ་ལས་བྱུང་བ་ཡིན་པར་རྟོགས་པར་མི་ནུས་སོ།",
    "འབྲེལ་པ་ལ་ཁྱད་པར་མེད་པས་འཛིན་པ་ལ་ཁྱད་པར་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "དབྱིབས་དེ་དབྱིབས་ཙམ་ནི་མུན་པར་འཛིན་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་རིགས་པ་བསྟན་པ་ནི།",
    "སྒྲིབ་པར་བྱེད་པ་རྡུལ་ལམ་ཅིག་ཤོས་སེལ་བར་བྱེད་པར་འགྱུར་བར་བསྟན་པ་ནི།",
    "ཤེས་པ་ལས་སྐྱེས་པ་ཤེས་པའི་རྒྱུ་ངེས་པར་བྱེད་པ་འདུ་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་འགྲེལ་པ་ནི་དོན་སོ་སོར་ངེས་པ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་བྱ་བྱེད་གཅིག་ཡིན་པར།",
    "ལུས་ལ་སོགས་པའི་ཐ་སྙད་ནི་རྣམ་པར་གཞག་པར་བྱ་བ་ལ་སོགས་པར་བརྟགས་པས་ཡུལ་ཐ་དད་པ་ཡིན་གྱི་ཅིག་ཤོས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབྲས་བུ་ལ་སོགས་པ་ཉིད་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པས་སྤྲུལ་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ལྟའི་རྣམ་པར་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་གནས་ཞེས་བྱ་བ་ནི་བྱེད་པ་སྟེ་དེ་དང་ལྡན་པའི་བྱེ་བྲག་ཏུ་བརྟགས་པ་ཞེས་བྱ་བའི་དོན་ཏོ་ཞེས་བསྟན་པ་ནི།",
    "རང་ལ་བྱེད་པར་འགལ་བ་སྤངས་པའི་ནི་དོན་དམ་པ་ནི་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རིག་པ་ཉིད་དོན་རིག་པ་ཡིན་པར་མི་རིགས་པ་མ་ཡིན་ནམ།",
    "དུ་བརྗེད་པར་འགྱུར་ལ།",
    "རྒྱུན་མ་ཡིན་པ་དང་ལྐོག་ཏུ་གྱུར་པ་ནི་བརྗེད་པར་འགྱུར་བའམ་ཐེ་ཚོམ་ཟ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གནས་སྐབས་དེའི་སྣང་བ་དག་ཉིད་ལ་ཁྱད་པར་ཡོད་པའི་ཕྱིར་རོ།",
    "ཕྱི་རོལ་གྱི་དོན་དུ་སྨྲ་བ་པོ་ཡང་དྲན་པ་ཉམས་སུ་མྱོང་བའི་ཡུལ་ཅན་དུ་འདོད་པའི་ཕྱིར་ཁྱབ་ཆེས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྩོད་པའི་གཞི་ཁྱད་པར་གྱི་དྲན་པ་འདི་ལས་ཁྱབ་ཆེས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "འདི་ནི་ཡུལ་མེད་པར་ཡིན་པས་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་ལས་གསལ་བ་ཉིད་བཞིན་དུ་གསལ་བ་བསྒོམས་པ་ལས་བྱུང་བ་ཉིད་ཡིན་ཏེ།",
    "ངས་འདི་མཐོང་ངོ་ཞེས་བྱ་བ་བྱེད་པ་པོ་དང་ལས་ལ་སོགས་པ་ནི་ཐ་དད་པར་སྣང་བ་མ་ཡིན་ནམ་སྙམ་དུ་སེམས་པ་ནི།",
    "འདི་མཐོང་འདི་ཐོས་ཞེས་བྱ་བའི་ངེས་པས་དམིགས་པར་བརྗོད་པའོ།",
    "ཉམས་སུ་མྱོང་བ་མེད་ན་ངེས་པ་མི་རིགས་པར་བསྟན་པ་ནི་ངེས་པ་ནི་མྱོང་བ་ཞེས་བྱ་བའོ།",
    "ཉམས་སུ་མྱོང་བ་ལ་བརྟེན་ནས་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཟླ་བ་གཉིས་སུ་མཐོང་བ་ལ་ནི་དེའི་ངེས་པ་དེ་ཁོ་ན་ཉིད་དུ་འབྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་མ་ངེས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "གཅིག་ཏུ་ངེས་པར་བྱེད་པ་མ་ཡིན་གྱི་འོན་ཀྱང་དུ་མར་ངེས་པར་བྱེད་པ་ཡིན་ནོ།",
    "བཟུང་བ་ལ་ངེས་པར་བྱེད་པ་མཐོང་བ་ཡིན་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ་གོམས་པ་ནི་ཞེས་བྱ་བའོ།",
    "དོན་ནོ་ཞེས་བྱ་བ་ཡང་ཕྱི་རོལ་མ་ཡིན་གྱི་འོན་ཀྱང་དོན་བྱེད་པའི་ཚིག་སྟེ་ཤེས་པ་ཉིད་ལ་ཡང་སྐྱོན་ཅན་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རང་མ་ཡིན་པར་རིག་པ་ཉིད་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ངེས་པར་གཟུང་བ་གཉི་གའི་འབྲས་བུ་བསྟན་པ་ནི།",
    "ཞེས་བྱ་བས་ཀྱང་ཉམས་སུ་མྱོང་བ་ལ་དེ་ལས་གཞན་པ་རིག་པར་བྱ་བ་བསལ་བ་ཡིན་ནོ།",
    "བ་ཡིན་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "དེའི་བདག་ཉིད་དང་དེ་ལས་བྱུང་བ་དག་ལ་ཁྱད་པར་མེད་དོ་སྙམ་དུ་སེམས་པ་ལ།",
    "མི་རྟག་པ་དང་བྱས་པ་ཉིད་བཞིན་དུ་སྔོན་པོ་ཉམས་སུ་མྱོང་བ་དེའི་བདག་ཉིད་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བ་ཡང་ཐ་སྙད་འདོགས་པ་ཡིན་ནོ།",
    "ཐ་མི་དད་པ་འགལ་བ་ཅན་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "གསལ་བར་བྱ་བ་ཉིད་ནི་གསལ་བར་བྱེད་པ་ཉིད་ཀྱི་ཁོངས་སུ་གཏོགས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "གསལ་བར་བྱེད་པ་ཉིད་ནི་གཞན་ཁོངས་སུ་གཏོགས་པར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "འོན་ཀྱང་ལྐོག་ཏུ་མ་གྱུར་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཇི་ལྟར་སྒྲོན་མ་སྐྱེད་པར་བྱེད་པ་ཉིད་གསལ་བར་བྱེད་པར་ཐ་སྙད་འདོགས་པ་དེ་བཞིན་དུ་མིག་ལ་སོགས་པའང་ཡིན་པར་བསྟན་པ་ནི།",
    "བདག་ཉིད་ཀྱི་ངོ་བོ་བྱེད་པ་ཤེས་པ་དང་འགལ་བ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཆད་པ་ནི་ཞེས་བྱ་བ་ནི་རལ་གྲིའི་སོ་དེ་ཉིད་ཁོ་ནས་གཅོད་པ་མ་ཡིན་པར་བསྟན་པ་ཡིན་ནོ།",
    "འོན་ཏེ་ཇི་ལྟར་ཞེན་པས་རིག་པར་བྱ་བ་དང་རིག་པར་བྱེད་པ་དག་ནི་ཐ་དད་པ་ཉིད་ཡིན་ན་སྐྱོན་ཅི་ཡོད་ཅེས་ཟེར་བ་ལ།",
    "རིག་པར་བྱ་བ་ཡང་དེའི་བདག་ཉིད་མ་ཡིན་ན་མི་འཐད་པ་སྟེ།",
    "འབྲེལ་པ་ཅན་མ་ཡིན་པར་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "དེ་ནི་ཉེ་བའི་ཁྱད་པར་གྱིས་གཟུགས་ཀྱི་ཁྱད་པར་བསྐྱེད་པ་ཉིད་ཡིན་གྱི་གཟུང་བ་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་ཉིད་དུ་ངེས་པར་བྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་ཉིད་ཀྱི་ངེས་པ་ཉམས་སུ་མྱོང་བ་དང་འགལ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཅི་ལས་ཤེ་ན་རིག་པར་བྱ་བའི་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་མེད་པ་སྟེ་རྟོགས་པ་མེད་པ་ན་ཇི་ལྟར་འགྱུར་ཏེ་རྟོགས་པར་ཇི་ལྟར་འགྱུར་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གཞན་གྱིས་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་རྟོགས་པ་མེད་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "དངོས་པོ་ཉིད་གསལ་བའི་ངོ་བོ་ཉིད་དུ་རྗེས་སུ་དཔག་པའི་གོ་བྱ་ཡིན་པར་ཟེར་བ་ནི།",
    "རྗེས་སུ་དཔག་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རང་བཞིན་གཅིག་པ་ཉིད་ཅེས་བྱ་བ་ནི་དོན་དམ་པར་རྟོགས་པ་ཐ་དད་པ་དེ་ལ་བརྟགས་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རྟོག་པ་ཙམ་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་ལ་ཁྱད་པར་མེད་པས་སོ།",
    "ཁྱད་པར་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་ཀྱི་ཁྱད་པར་ཉིད་ཀྱིས་སོ།",
    "དེ་ཡང་གཞལ་བྱའི་དུ་བ་རྟོགས་ན་ལྐོག་ཏུ་གྱུར་པའི་མེ་ལ་ཡོད་པ་ཡིན་པ་དེ་ལྟ་ན་མེ་ཡང་རྟོགས་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ནི།",
    "ལན་ནི་ལྐོག་ཏུ་གྱུར་པར་ཞེས་བྱ་བའོ།",
    "གསལ་བ་སྣང་བ་བག་ཆགས་ཙམ་ལས་བྱུང་བ་ཡིན་ན་འདོད་པ་ཁོ་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཕྱི་རོལ་ཁྱད་པར་ཡོད་མིན་ཡང་།",
    "ཕྱི་རོལ་ཁས་བླངས་ཀྱང་འགལ་བའི་འབྲས་བུ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "དྲན་པ་བརྗེད་པར་ཞེས་བྱ་བའོ།",
    "ལོག་པར་རིག་པ་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་གཞན་ལ་གནས་པ་ལ།",
    "དེ་ལས་གཞན་པར་རྟོགས་པ་ཡིན་ནོ།",
    "མེད་པ་ཡང་ཡུལ་ལ་སོགས་པ་ལ་ངེས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྔ་མ་སྔ་མ་ཚེས་ཆེས་གསལ་བའི་ཤེས་པའི་བདག་ཉིད་རིམ་གྱིས་འགྱུར་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "ནུས་པའི་བག་ཆགས་ཉིད་ལའམ་སད་པར་བྱེད་པའི་དབྱེ་བས་བྱས་པའི་འབྲས་བུ་ཐ་དད་པའི་རིམ་པ་འདིས་བསྟན་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ནུས་པའི་ཁྱད་པར་ཞེས་བྱ་བ་ནི་དེ་ལས་ཐ་མི་དད་པའམ།",
    "སྔོན་པོ་ལ་སོགས་པའི་ངོ་བོ་ཐ་དད་པར་མི་སྣང་ན་འཁྲུལ་པར་མི་རིགས་པར་བསྟན་པ་ནི།",
    "ཕན་ཚུན་རྟེན་པ་འཐོབ་པར་འགྱུར།",
    "རྟོགས་པའི་ངོ་བོ་དངོས་སུ་རྣམ་པར་ཤེས་པ་མ་ཡིན་ནམ།",
    "དེ་ལྟར་ཡང་དོན་གྱི་རྣམ་པ་ཉིད་དུ་ཐ་མི་དད་པ་ནི་དངོས་སུ་བའི་བག་ཆགས་ཙམ་ལས་བྱུང་བའི་ཕྱིར་ཤེས་པ་རྣམས་པར་བྱེད་པར་མི་བྱེད་ན་དང་བའི་ཤེས་པའི་ངོ་བོ་ལས་ས་བོན་དང་མྱུ་གུའི་རིགས་པ་ཇི་ལྟར་ཡིན།",
    "རྣམ་པར་ཤེས་པའི་བསྐྱེད་བྱའི་འདུ་བྱེད་པ་ནི་བག་ཆགས་ཡིན་ཏེ།",
    "གང་ཉམས་སུ་མྱོང་བ་ཆེས་གསལ་བ་ནི་དྲན་པའི་ས་བོན་འཇོག་པར་བྱེད་དོ་ཞེས་གསུངས་པས་སོ།",
    "དེ་གལ་ཏེ་འཛིན་པ་དང་དྲན་པའི་ངོ་བོའི་ཤེས་པ་འབྱེད་པར་བྱེད་ན་ཡུལ་གྱིས་ཐ་དད་པ་མ་ཡིན་བར་འགྱུར་རོ།",
    "དེ་ནི་དེ་ལྟ་བུའི་རྣམ་པ་ཁྱད་པར་ཅན་སྐྱེད་པར་བྱེད་པ་ནི་བག་ཆགས་ཡིན་ཏེ།",
    "འབྲས་བུའི་དུས་ན་དེ་མེད་ཀྱང་དེ་བྱེད་པ་ནི་བག་ཆགས་ཡིན་པར་བརྗོད་དོ་ཞེས་བསྟན་པ་ནི།",
    "ཤེས་པའི་བདག་ཉིད་ཡིན་པས་བཟུང་བའི་རྣམ་པ་ནི་བག་ཆགས་ཀྱིས་བྱས་པ་ཡིན་ཡང་དངོས་སུ་བ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡུལ་འདི་དང་འབྲེལ་པ་བཞིན་དུ་འདི་མེད་པ་ཁོ་ན་ཡིན་པར་ཤེས་པར་བསྟན་པ་ནི།",
    "རྟེན་དང་ཅིག་ཤོས་མ་གཏོགས་པར་འབྲེལ་པ་མེད་ན།",
    "སེམས་དང་རྗེས་སུ་འགྲོ་བ་མེད་པར་འཇིགས་པ་ལ་ཡང་ངོ།",
    "ལྷན་ཅིག་སྐྱེ་བ་དག་ལ་ཡང་དེས་བསྐྱེད་པར་བྱ་བ་མེད་པའི་ཕྱིར་ལྷན་ཅིག་པ་ཡིན་ཀྱང་དེ་དག་ལ་འབྲེལ་པ་ཉིད་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་བག་ཆགས་མེད་པར་ཞེས་ཟེར་བ་ནི།",
    "སྒོ་བར་བྱེད་པ་མ་ཡིན་ན་སྐད་ཅིག་པ་ཉིད་ནི་བསྒྲུབ་བྱ་ཕྱིན་ཅི་ལོག་ཏུ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི་བཟློག་པར་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "དྲན་པའི་ས་བོན་གྱི་ངོ་བོའི་བག་ཆགས་ཀྱང་བཟུང་བའི་དབྱེ་བས་ཁྱད་པར་ཅན་མ་ཡིན་པ་ཉིད་ཀྱི་འཛིན་པའི་དབྱེ་བ་སྐྱེད་པར་བྱེད་པ་ཡིན་གྱི་ཉམས་སུ་མྱོང་བ་འབའ་ཞིག་པ་ནི་མ་ཡིན་ཏེ།",
    "བསྒོ་བྱ་སྒོ་བྱེད་ཀྱི་ངོ་བོ་ཡིན་པར་བསྟན་པ་ནི།",
    "བསྐྱེད་བྱའི་ཁྱད་པར་ནི་བསྒོ་བྱའི་མིང་ཅན་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་རྟག་པ་ལ་མི་སྲིད་པར་བསྟན་པ་ནི།",
    "འཇིག་པར་འགྱུར་བའི་དངོས་པོ་ཡང་འཇིག་པར་འགྱུར་བ་གཞན་གྱིས་ཇི་ལྟར་བསྒོ་བྱར་འགྱུར་སྙམ་དུ་སེམས་པ་ལ།",
    "ཤེས་པ་ནི་རང་ལས་ཐ་མི་དད་པ་ནི་རྣམ་པར་འགྱུར་བ་བྱེད་ན་འདུ་བྱེད་པ་ནི་བྱེད་པ་པོ་ཉིད་ཡིན་ཏེ།",
    "བརྟན་པར་གནས་པ་སྔ་མ་ལ།",
    "དེ་རྟོགས་པའི་ཡུལ་ཡིན་པར་ངེས་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "ཅེས་བྱ་བ་མི་རིགས་པར་བསྟན་པ་ནི།",
    "རྗེས་སུ་འགྲོ་བ་མེད་པར་ཞིག་པའི་ཕྱིར་རྗེས་སུ་མཐུན་པ་ཉིད་གང་ལས་ཡིན་སྙམ་དུ་སེམས་པ་ལ།",
    "རྗེས་འགྲོ་མེད་པར་ཞིག་གྱུར་པར།",
    "བག་ཆགས་ཉིད་ཡིན་ནམ་ཚན་ཉིད་མི་མཐུན་པ་དག་ལ་བསྐྱེད་པར་བྱ་བ་དང་།",
    "རྗེས་འགྲོ་མེད་པར་འཇིགས་གྱུར་ན།",
    "བག་ཆགས་ཐམས་ཅད་འཇིག་པར་འགྱུར།",
    "ཞེས་བྱ་བ་སྟེ་བརྩམ་པར་བྱ་བ་ཇི་སྙེད་ཡོད་པ་དུས་གཅིག་ཁོ་ན་བརྩམ་པར་བྱ་བའོ་སྙམ་དུ་སེམས་པ་ལ།",
    "སྣང་དུ་རུང་བ་ལན་བརྒྱ་གཤགས་ན་ཡང་དེའི་གནས་སྐབས་ནམ་དམིགས་པའི་ཕྱིར་རོ།",
    "དམིགས་པར་བྱ་བ་མ་ཡིན་པ་དམིགས་པས་དམིགས་པ་ནི་བག་ཆགས་དེ་ཉིད་ཡིན་པར་བསྟན་པ་ནི།",
    "མེ་ཏོག་ཞིག་པར་ཞེས་བྱ་བའོ།",
    "ཞེས་བྱ་བའང་ཡིད་ལྡོག་པ་ལ་གནས་པ་ཡིན་གྱི་ངོ་བོ་ལ་གནས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཤེས་པ་གོམས་པས་ལྡན་པར་འགྱུར།",
    "ཞེས་བྱ་བ་བསལ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "གཞན་དག་དེ་ལ་རྣམ་འགར་འཛིན་པར་འགྱུར།",
    "རྣམ་པའི་རྣམ་པར་དབྱེ་བ་ཡིན་གྱི་ཤེས་པ་ནི་མ་ཡིན་པ་དེའི་ཕྱིར་དབྱེ་བ་ནི་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱིར་རོལ་གྱི་དོན་ཉིད་དང་བྲལ་ན་རིག་པའི་ཁོངས་སུ་གཏོགས་པ་ཐ་མི་དད་པའི་དམིགས་པ་ཅན་གྱི་ཤེས་པ་དམིགས་པ་མེད་པར་བརྗོད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "གོམས་པའི་རྗེས་སུ་འགྲོ་བ་ཉིད་ལ་གནོད་པའི་དོན་ཅན་གྱི་གནོད་པ་ནི་མྱུར་དུ་ཉམས་པ་ཡིན་གྱི་གཞན་གྱི་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རིགས་གང་གང་ལས་གྲུབ་པ་ནི་ཞེས་བྱ་བའི་རིགས་པ་བསྟན་པ་ནི་གུས་པར་གོམས་པ་ཞེས་བྱ་བའོ།",
    "གནོད་པར་བྱེད་པ་ནི་ཉམས་པར་བྱེད་པ་སྟེ།",
    "ཡུལ་མེད་པའི་སྒོ་ནས་དམིགས་པ་མེད་པ་ཉིད་རང་ལ་དམིགས་པ་ཉིད་དུ་རྟོགས་པར་བྱེད་ན་གོམས་པའི་རྗེས་སུ་འགྲོ་བ་ཉིད་དུ་གོ་བར་བྱེད་པ་ཡིན་གྱི་མེད་པ་ཉིད་དུ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "གནོད་པར་བྱེད་པ་ལས་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དངོས་པོ་མེད་པར་ཞེས་བྱ་བའོ།",
    "འགལ་བའི་ཤེས་པ་གནོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཡང་མི་དམིགས་པ་ཉིད་ཀྱིས་བྱས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "འགལ་བ་མེད་པར་ཞེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་ཁྱད་པར་མེད་དོ་ཞེས་ཟེར་བ་ནི་དེས་ན་ཇི་ལྟར་ཞེས་བྱ་བ་སྟེ།",
    "རིག་པ་མེད་པར་ཞེས་བྱ་བའོ།",
    "རིག་པ་ཡང་དེ་ཉིད་ཀྱིས་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱིས་སོ་ཞེས་བསྟན་པ་ནི།",
    "དེ་མ་ཐག་པའི་ཁྱད་པར་གྱི་སྐྱེད་པར་བྱེད་བ་ཉིད་ལ་སོགས་པ་དངོས་སུ་བ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "གང་ཞིག་གཞན་གྱི་ངོ་བོ་འཛིན་པར་བྱེད་པ་ཉིད་ཀྱི་རང་ཉིད་འཛིན་པར་བྱེད་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་སད་པའི་ཤེས་པ་ལ་ཡང་མཚུངས་པར་བསྟན་པ་ནི།",
    "དེ་ལྟར་འགྱུར་ཞེས་བྱ་བ་ནི་སད་པ་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བའོ།",
    "གཞན་ལས་ཁྱད་པར་མ་ཡིན་ནམ་སད་པའི་ཤིན་ཏུ་ངེས་པའི་བློ་ཡིན་པའི་ཕྱིར།",
    "གནོད་པར་བྱེད་པའི་ཤེས་མེད་ན།",
    "དེར་རྣམ་པར་མི་གནས་པ་ཞེས་བྱ་བའོ།",
    "དེ་དགག་བྱས་པ་དེ་ཡི་ཕྱིར།",
    "དོན་དམ་པར་མི་མཐུན་པ་ཉིད་མེད་པ་ཁོ་ན་དཔེ་ལ་དཔེ་ཅན་གྱིའོ་ཞེས་བསྟན་པ་ནི་དེ་ནས་ཕྱིས་ཞེས་བྱ་བ་སྟེ།",
    "སྔར་སྣང་བའི་ཁྱད་པར་ལས་མ་ཡིན་གྱི་འཇིག་རྟེན་ལས་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་ལ་གྲགས་པ་ཐ་དད་པའི་རྗེས་སུ་དཔག་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དོན་དམ་པར་གྲུབ་པ་ནི་རྗེས་སུ་དཔག་པ་འཇུགས་པ་ལ་གནོད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "འདི་ཉིད་འཇིག་རྟེན་ལ་གྲགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ལས་བཟློག་པར་འཛིན་པ་ན་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ལས་བཟློག་པར་འཛིན་པ་ལའོ།",
    "དེ་ལས་བཟློག་པའི་གཞན་བྱ་དྲུངས་ཕྱུང་ན་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ལས་བཟློག་པའི་གཞན་བྱ་དྲུངས་ཕྱུང་ན་སྟེ་གནོད་པ་ནའོ།",
    "གཟུང་བའི་སྤྱི་དང་འགལ་བ་ཅན་མ་ཡིན་པའི་ཁྱད་པར་སྒྲུབ་པར་བྱེད་པ་བཞིན་དུ་སྒྲོ་བཏགས་པའི་ཐ་དད་པའི་འགལ་བ་ཅན་ཡིན་ལ།",
    "ཐ་མི་དད་པར་སྒྲུབ་པར་བྱེད་པ་འགལ་བ་ཅན་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཐ་དད་པར་ནི་ཞེས་བྱ་བའོ།",
    "ཐ་མི་དད་པར་རིག་པ་རྒྱུ་དང་འགལ་བ་ཡིན་ན་ཇི་ལྟར་འབྲས་བུ་ཐ་དད་པ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་པ་ཉིད་དམིགས་པ་དང་བཅས་པ་ལས་གནོད་པར་བྱེད་པ་མི་དམིགས་པས་བཟློག་པ་ནི་དམིགས་པ་མེད་པ་ཉིད་ཀྱིས་ཁྱབ་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི་ཇི་ལྟར་རྨི་ལམ་གྱི་ཤེས་པ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་སྟེ།",
    "རྣམ་པར་གྲོལ་བ་ཉིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དམིགས་བཞིན་པ་ཉིད་དམིགས་པ་ཡིན་པར་རྨི་ལམ་ལ་ཡང་ཡིན་པའི་ཕྱིར་འབྲེལ་པ་མཚུངས་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "ཐམས་ཅད་ཀྱི་ཚེ་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དུ་བའོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི་བདེ་བ་ལ་སོགས་པ་བཞིན་དུ་རིག་པ་ཙམ་དོན་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "སད་པ་ལ་ཡང་ཐམས་ཅད་དེ་ལ་རག་ལས་པ་ཉིད་ཡིན་པར་བསྟན་པ་ནི།",
    "རིག་པ་ལ་ནི་དོན་གཞན་ཉིད་ཁྱད་པར་བྱེད་པ་འགལ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་བཞིན་དུ་གཞན་ཡང་ཞེས་བྱ་བ་ནི་འཁྲུལ་པར་འདོད་པའི་ཤེས་པའི་དོན་ཡང་ངོ།",
    "གོམས་པའི་ཁྱད་པར་ལས་འཆོལ་བ་དང་ཅིག་ཤོས་ལ་སོགས་པའི་ཁྱད་པར་ཡིན་གྱི།",
    "གཞན་ཉིད་ལས་ཡིན་པ་ནི་ཐུག་པ་མེད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྔོན་པོ་ནི་རིག་པའི་དུས་ཙམ་ལ་ཡོད་པས་དེ་དག་ཐ་མི་དད་པའི་ཕྱིར་སད་པ་ན་ཡང་རྨི་ལམ་དང་མཚུངས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་འབྲེལ་པ་གཟུང་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "བར་དུ་ཆོད་པའི་མེའི་བསྐྱེད་བྱ་དུ་བ་བཞིན་དུ་བར་དུ་ཆོད་པའི་གོམས་པའི་སད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ཡང་སྐྱེ་བ་སྔ་མ་ལ་གོམས་པ་དྲན་པ་ཉིད་ལོག་པའི་དེ་མ་ཐག་ཏུ་རྨི་ལམ་མཐོང་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྨི་ལམ་དུ་མཐོང་བ་གོམས་པ་ལས་བྱུང་བ་ཉིད་དུ་བསྒྲུབ་ནས་འདི་ལས་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "གོམས་པའི་ཁྱད་པར་ལས་ཞེས་བྱ་བའོ།",
    "པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ལ།",
    "གནོད་པར་བྱེད་པའི་ཤེས་པ་ནི།",
    "མི་སླུ་བ་ལས་ཡིན་པར་བསྟན་པ་ནི།",
    "འཇུག་པར་བྱེད་པ་ཉིད་ཀྱིས་ཡིན་གྱི་འཛིན་པར་བྱེད་པས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འཛིན་པ་དང་ཞེན་པ་དག་མེད་ན་འཇུག་པར་བྱེད་པ་ཉིད་མེད་པའི་ཕྱིར་མི་རིགས་སོ་སྙམ་དུ་སེམས་པ་ལ།",
    "ངེས་པ་ལས་ཞེས་བརྗོད་པར་བྱའོ།",
    "རྣམ་པར་རྟོག་པ་ཙམ་ལས་བྱུང་བའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་ལ།",
    "མངོན་སུམ་རྩ་བ་ཡིན་པའི་ཕྱིར་གནོད་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་བསྟན་པ་ནི།",
    "ལོག་པར་འཛིན་པའི་ཕྱིར་རང་རིག་པའི་རྗེས་སུ་དཔག་པ་ཡང་ཞེས་རྒོལ་བ་སྔོན་དུ་འགྲོ་བས་བསྟན་པ་ནི།",
    "དེ་དགག་བྱས་པ་དེ་ཡིན་ཕྱིར།",
    "དེ་དག་ཕྱོགས་ལ་གནོད་པར་འགྱུར།",
    "ཞེས་ཟེར་བ་མི་རིགས་པར་བསྟན་པ་ནི།",
    "དགག་པར་ཡང་ནི་རིགས་པ་ཡིན།",
    "ཞེས་བྱ་བ་ནི་ལེགས་པར་སྨྲས་པ་མ་ཡིན་ཏེ།",
    "དམིགས་པ་མེད་པར་དེ་ཉིད་དུ་དམིགས་པའི་བློ་རྣམས་ཀྱི་ཤེས་པ་ཉིད་དམིགས་པ་མེད་པ་ཉིད་དུ་མ་ངེས་པ་ཡིན་ཏེ།",
    "ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པའི་བློ།",
    "དམིགས་པ་མེད་པར་ཡང་དེ་ལ་དམིགས་པ་ཅན་གྱི་བློ་ཡིན་ལ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རིག་པར་བྱ་བ་དང་རིག་པར་བྱེད་པའི་རྣམ་པ་འདི་ལ་མེད་དོ་ཞེས་བྱ་བ་ནི་གནས་སྐབས་ཀྱི་རྗེས་སུ་དཔག་པ་ལ་དགོས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "རིག་པར་བྱ་བ་མེད་ཀྱང་རིག་པར་བྱེད་པ་ནི་རིག་པར་བྱེད་པ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི་རིག་པར་བྱེད་པ་ལྟ་བུའི་རྣམ་པ་གང་ལ་ཡོད་པ་དེ་ནི་རིག་པར་བྱེད་པའི་རྣམ་པ་ཡིན་ནོ།",
    "ཐོག་མ་མེད་པའི་འཁྲུལ་པ་བག་ཆགས་ཀྱིས་སྒྲོ་བཏགས་པའི་རིག་པར་བྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དགག་བྱས་པ་དེ་ཡི་ཕྱིར།",
    "དེ་དག་ཕྱོགས་ལ་གནོད་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་བསལ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "བདེ་བའི་དུས་སུ་དཀར་པོ་ལ་སོགས་པ་དམིགས་པ་ཁོ་ན་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ་ཐོབ་པར་བྱ་བའི་རང་བཞིན་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཐོབ་པར་བྱ་བ་ནི་འཇུག་པའི་ཡུལ་ཏེ་དམིགས་པ་ཡིན་གྱི་ཅིག་ཤོས་ནི་མ་ཡིན་ཏེ།",
    "ཡུལ་དུ་མ་བྱས་པ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་ཐམས་ཅད་ལ་འགྱུར་རོ་ཞེས་ཟེར་བ་ལ།",
    "རིག་པར་བྱ་བ་དང་རིག་པར་བྱེད་པའི་རྣམ་པ་འདི་ལ་མེད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་དང་ཕྱི་མ་དང་དེའི་ཚེ་ཡང་རིག་པར་བྱེད་པ་པོའི་རིག་པ་མེད་པ་ལ་ཐ་དད་པ་ལ་སོགས་པ་མེད་པར་བརྗོད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཐོབ་པར་བྱ་བའི་དོན་བྱེད་པའི་མཐའི་སྐད་ཅིག་ནི་དོན་བྱེད་པར་རིག་པའི་དུས་སུ་གཏོགས་པའི་ངོ་བོ་ཡང་བྱེད་པ་པོ་ཡོད་པ་ཡིན་པར་ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་བསྟན་པ་ནི་དུས་མཉམ་པ་ཡང་ཞེས་བྱ་བའོ།",
    "དེ་ལྟར་རྣམ་པར་ཕྱེ་བ་ཡང་རིག་བྱ་མ་ཡིན་པ་ལ་སོགས་པའི་རྣམ་པ་ཅི་ལས་ཤེས་ཞེས་ཟེར་བ་ལ།",
    "གཟུང་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཙམ་འབའ་ཞིག་ནི་མ་ཡིན་གྱི་རྨི་ལམ་དང་ཅིག་ཤོས་ལ་སོགས་པ་ཡང་ཡིན་ནོ།",
    "དེ་ལས་ནི་རྣམ་པར་རྟོག་པ་ལས་སོ།",
    "དེ་ལྟ་བུའི་ངོ་བོ་ལ་རང་རིག་པར་བྱ་བ་དང་ཅིག་ཤོས་ཉིད་དུ་ཉམས་སུ་མྱོང་བ་མེད་པའི་ཕྱིར་ཏེ།",
    "ཕྱི་རོལ་ཉིད་དུ་ཞེན་པས་སྣང་བ་མ་ཡིན་པའི་ཕྱིར་དང་མངོན་དུ་སེམས་པ་ཙམ་གྱི་བྱེད་པ་ཡིན་པར་ཐ་མི་དད་པའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་མ་རྟོགས་པ་མི་གཞན་གྱིས་རིག་པའི་ཕྱིར་མེད་པར་མི་འགྱུར་བ་ཞེས་ཟེར་བ་ལ།",
    "དེས་བཟུང་བ་བསྟན་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཐ་མི་དད་པ་ལས་བཟུང་བ་ཐ་མི་དད་པ་ཡིན་ན་འཛིན་བྱེད་ཀྱང་ཐ་དད་པར་མི་འགྱུར་བར་བསྟན་པ་ནི།",
    "གཞན་གྱི་བདེ་བའི་ཁྱད་པར་རྟོགས་པ་བཞིན་དུ་གཞན་གྱི་རིག་བྱའི་ཁྱད་པར་རྟོགས་པ་ཡིན་པར་ཟེར་བ་ལ།",
    "གཅིག་རིག་པ་མ་ཡིན་ཡང་རིག་པ་ཡིན་པར་ཟེར་བ་ནི།",
    "དུས་ཐ་དད་པ་མ་ཡིན་པ་བཞིན་དུ་ཐ་དད་པ་ལ་ཡང་རྟགས་ཐ་མི་དད་པས་ཐ་མི་དད་པ་ནི་དུས་ཐ་དད་པས་བསྒྲིབས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཚེ་ཡང་གཉི་ག་རིག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕན་ཚུན་བསྟེན་པ་ཡིན་པར་བསྟན་པ་ནི་མངོན་སུམ་གྱིས་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་གྱིས་ངེས་པ་ལ་ཡང་ཚིག་ལ་དགོས་པ་མེད་པར་བསྟན་པ་ནི།",
    "མངོན་སུམ་གྱིས་མ་རྟོགས་པ་ལ་ཚིག་ཡིན་པར་བསྟན་ཏེ།",
    "གཅིག་པར་འདོད་པ་འདི་མིན་ཏེ།",
    "དེ་དགག་བྱས་པ་དེ་ཡི་ཕྱིར།",
    "ཞེས་ཟེར་བ་ནི་ཤིན་དུ་རྣམ་པར་ངེས་པའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "རྩིག་པའོ་ཞེས་བྱ་བར་ཤིན་ཏུ་ངེས་པ་ནི་ཇི་ལྟར་ཕྱིན་ཅི་ལོག་པར་འགྱུར་རོ་ཞེས་ཤིན་ཏུ་རྣམ་པར་ངེས་པ་སྨོས་པས་སོ།",
    "ཡུལ་དུ་མ་བྱས་པ་ལ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་རིག་པའི་བདག་ཉིད་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི།",
    "ཤིན་ཏུ་རྣམ་པར་ངེས་པ་ཉིད་ཅེས་བྱ་བའོ།",
    "དེ་ཕྱིར་དེས་པར་བརྟགས་པ་མེད།",
    "ཅེས་བྱ་བ་མི་རིགས་པར་བསྟན་པ་ནི།",
    "ཡུལ་ཉིད་ནི་རྣམ་པར་རྟོག་པའི་མ་ཡིན་ཏེ།",
    "ཡོད་པའི་ངོ་བོ་སྣང་བའི་ཕྱིར་རྟོགས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "གཞན་དུ་ན་མེད་པ་ཞེས་བྱ་བར་རྗེས་སུ་བརྗོད་པར་མི་རིགས་སོ།",
    "གཞན་སེལ་པའི་རྗེས་སུ་བྱེད་པ་ལས་དེ་ཉིད་མེད་པར་རྟོགས་པ་མ་ཡིན་ནམ་ཞེས་ཟེར་བ་ལ།",
    "ལས་ལ་ཡིན་གྱི་སྒྲོ་བཏགས་པ་དེའི་ངོ་བོས་གཞན་གྱིས་དམིགས་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་དམིགས་པ་མེད་པ་ཉིད་ཡིན་ན་ཇི་ལྟར་ཡིན།",
    "དེ་དག་ཙམ་མི་དམིགས་པའི་རྗེས་སུ་འབྲངས་པའི་རྣམ་པར་རྟོག་པ་ནི་འདི་རང་དཔང་དུ་འཛིན་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "བློ་ཉིད་ལས་བློ་གཞན་རྣམ་པར་དང་ལྡན་པ་ཡིན་པར་བསྟན་ནས།",
    "དུས་མཉམ་པར་ནི་ཞེས་བྱ་བའོ།",
    "རྟོགས་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོའོ།",
    "རྟོགས་པར་བྱ་བ་ཞེས་བྱ་བ་ནི་ངོ་བོའོ།",
    "དེ་མ་གྲུབ་པ་ཉིད་ན་ཤེས་པར་འདོད་པའི་བྱེད་བྲག་དང་ལྡན་པ་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བསྒྲུབ་བྱའི་རྗེས་སུ་འབྲངས་པས་དེ་ཉིད་སྔ་ན་ཡོད་པར་བསྟན་པ་ནི།",
    "དེ་ལྟར་མ་གྲུབ་ན་རྒྱལ་དཔོག་པའི་ཡང་སྒྲུབ་པར་བྱེད་པ་ཅུང་ཟད་ཀྱང་མེད་པར་བསྟན་པ་ནི།",
    "སྒྲ་དང་དོན་ཙམ་ལ་འདི་ནི་སྒྲ་འདི་ནི་དོན་ནོ་སྒྲ་འདི་ནི་དོན་ནོ་ཞེས་བརྟག་པར་མི་ནུས་པའོ།",
    "ཁྱད་པར་མེད་པ་ནི་ཐ་དད་པ་ཅིག་ཤེས་འཛིན་པར་བྱེད་པ་ཉིད་ལ་སོགས་པའི་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་མ་གྲུབ་པ་ཞེས་བྱ་བ་ནི་ཤེས་པ་ཐམས་ཅད་ལ་ཇི་ལྟར་ཡང་དམིགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "འཆད་པར་འགྱུར་བ་མ་བཅད་ནས།",
    "དེ་འདྲའི་རྒོལ་བ་བྱེད་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གནས་སྐབས་མ་བཅད་པ་དང་ཅིག་ཤོས་ཉིད་ཀྱི་ཕྱོགས་སྔ་མ་དང་ཅིག་ཤོས་ལ་བརྟེན་ནས་འབྲེལ་བ་མེད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཀྱིས་སྒྲོ་བཏགས་པའི་རྣམ་པར་གཞན་སྐྲ་ཤད་ཀྱི་ཤེས་པའི་གོ་བྱ་དང་རྒྱུ་ཡང་ཡིན་ནོ།",
    "གོ་བྱའི་དོན་ལ་རྣམ་པར་དཔྱོད་པ་ན་རྒྱུ་གནས་སྐབས་པ་མ་ཡིན་པ་དང་།",
    "དེའི་རང་བཞིན་ཅན་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཟླ་བ་གཉིས་སུ་སྣང་བ་ལས་ཟླ་བ་གཅིག་ཏུ་སྣང་བ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་རྣམ་པའི་ཕྱི་རོལ་སྣང་བ་མ་ཡིན་པ་ནི་གནོད་བྱེད་ཡིན་ལ་རྣམ་པ་ཡང་སྣང་བཞིན་པར་གཉི་ག་ལ་ཡང་ཁྱད་པར་མེད་དོ།",
    "ཤེས་པའི་བདག་ཉིད་ཀྱི་སྔོན་པོ་ཡང་སེར་པོ་ལ་སོགས་པ་ཡོད་པས་མི་འབྱུང་ན་རྗེས་སུ་མཐུན་པའི་ཕྱི་རོལ་གྱི་སྔོན་པོ་ཉིད་རྒྱུ་ཡིན་པར་རྟོགས་པར་བྱེད་དོ་སྙམ་དུ་སེམས་པ་ལ།",
    "གཞན་གྱི་བསྐྱེད་བྱ་ཡང་དེའི་རྣམ་པར་ཅན་དུ་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཚུངས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "རོ་ལ་སོགས་པ་མེད་པར་ཡང་།",
    "དེ་ལྟ་མ་ཡིན་པར་ཞེས་བྱ་བ་ནི་བདེན་པའི་ཆུའི་ཤེས་པ་བཞིན་དུ་དམིགས་པ་དང་བཅས་པ་ཡིན་ནོ།",
    "འོ་ན་སྣང་བ་ཉིད་ཅེས་བྱ་བ་ནི་བདེ་པ་ལ་སོགས་པའི་འཛིན་པར་བྱེད་པ་ལས་ཐ་དད་པའི་བཟུང་བ་ཉིད་ཀྱིས་སོ།",
    "དེའི་ཕྱིར་ཁྱད་པར་མེད་དོ།",
    "གཟུང་བ་རྣམ་པར་གཉིས་མ་གཏོགས་པའི་བྱ་བ་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "དེ་དང་ལྡན་པའི་སྦྱོར་བའི་རྣམ་པར་རྟོག་པ་ནི་སོ་སོ་ཁོ་ན་ཡིན་ཏེ།",
    "བདེ་བ་དང་སྦྱོར་བ་དག་ཐ་དད་པར་ཉམས་སུ་མྱོང་བའི་ཕྱིར་རོ།",
    "མངོན་སུམ་ནི་རྟོགས་པ་མེད་པ་སྣང་བའི་དོན་བྱེད་པས་དོན་མ་མིན་པ་ཉིད་དུ་མི་རིགས་པའི་ཕྱིར་མ་ལུས་པ་འཁྲུལ་པ་མེད་པ་ཁོ་ན་ཡིན་གྱི་དབྱེ་བ་མེད་པར་བསྟན་པ་ནི།",
    "འོན་ཏེ་མིག་མི་འཛུམས་པར་མཐོང་བ་ཉིད་ནི་འཐོབ་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "ཞིག་པ་གང་ཡིན་པ་དེ་ཡང་ཇི་ལྟར་འཇིག་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ལན་ཡིན་ཏེ།",
    "སྔར་མཐོང་བ་ངོ་ཞེས་པ་ནི་དེ་མ་ཡིན་པའི་འབྲས་བུ་རྣམ་པར་གཅོད་པའི་ཡུལ་ཅན་ཏེ།",
    "འགལ་བ་ཅན་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་ནི་དམིགས་པ་མེད་པ་ཉིད་དོ།",
    "ཁྱད་པར་གྱི་ཁྱད་པར་ནི་ཕྱི་རོལ་གྱི་ངོ་བོའོ།",
    "དོན་དམ་པར་ཞེས་བྱ་བས་སྒྲོ་བཏགས་པས་ནི་གྲུབ་པ་ཡིན་པའོ།",
    "བློ་ལ་མི་གནས་ལ་ནི་ཁྱད་པར་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་དོན་དམ་པར་མེད་པ་སྒྲུབ་པར་བྱེད་པའི་རྒྱུར་འགྱུར་པར་བསྟན་པ་ནི།",
    "ཡུལ་གཞན་ལ་སོགས་པའི་ཁྱད་པར་ནི་གཞན་དུ་ངེས་པར་ཡིན་གྱི་སྒྲོ་འདོགས་པ་མ་ཡིན་ཏེ།",
    "མེད་པར་སྒྲུབ་པ་ནི་མེད་པའི་དོན་དུའོ།",
    "ཡུལ་གཞན་ལ་སོགས་པར་མཐོང་བ་ཡང་གཞན་དུ་སྒྲོ་གཏགས་པའི་སྣང་བ་ཉིད་ཁོ་ན་དགག་པ་ནི་གཞན་ལ་ཡང་མཚུངས་པར་བསྟན་པ་ནི།",
    "ཇི་ལྟར་བསྒྲུབ་པར་འགྱུར་བའོ།",
    "ཡོད་པའི་ངོ་བོ་དེ་ཁོ་ནས་ཡོད་པ་མ་ཡིན་དུ་ཟིན་ཀྱང་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་གྱི་དེའི་ཞིག་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "འཇིག་པར་འགྱུར་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཕྱིས་ཀྱང་འཇིག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྔ་མ་ཉིད་ནི་རྒྱུ་ཡོད་པར་རྟོག་པ་ཉིད་ནའོ།",
    "དངོས་པོ་རྟོགས་པའི་དུས་སུ་ཁྱད་པར་དང་བཅས་པར་མ་གྲུབ་པའི་ཕྱིར་དེའི་ཚེ་དངོས་པོའི་ཁྱད་པར་དེ་ཇི་ལྟར་གཞན་རྟོགས་པར་མི་ནུས་པས་མ་གྲུབ་པའི་ཁྱད་པར་ལ་ཕྱོགས་གྲུབ་པ་མ་ཡིན་པ་དེ་ཁོ་ན་བཞིན་དུ་འགྱུར་ཞིང་།",
    "ཁྱད་པར་རབ་ཏུ་མ་གྲུབ་ན།",
    "ཁྱད་པར་ནི་མེད་པའི་མ་ཡིན་ནམ་སྙམ་དུ་སེམས་པ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པར་མི་འགྱུར་བའི་ཕྱིར་ཁྱད་པར་གྲུབ་པ་མ་ཡིན་ནའང་།",
    "རང་བཞིན་མིན་བཟུང་ན་ཞེས་བྱ་བ་ལ་མེད་པའི་ཁྱད་པར་ནི་རང་བཞིན་མ་ཡིན་ན་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་གནོད་པར་བྱ་བ་ལ་སོགས་པ་ཡོད་པ་དང་མེད་པ་ཡིན་ཡང་རྟོགས་པའི་སྣང་བ་རྗེས་སུ་དྲན་ནས་དམིགས་པ་ཉིད་དུ་བརྗོད་པ་ཡིན་ནོ།",
    "རྟོགས་པ་ཉིད་ཐོབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་སྒྲོ་བཏགས་པའི་ཡུལ་ཅན་གྱི་གནོད་བྱེད་ཉིད་ནི་བརྟགས་པ་པ་ཉིད་ཡིན་པར་བསྟན་པ་ནི་རྟོགས་བཞིན་པ་ནི་ཞེས་བྱ་བའོ།",
    "དམིགས་པར་ཞེས་བྱ་བ་ནི་དངོས་པོའོ།",
    "ཅེས་བྱ་བ་ནི་རྣམ་པ་མེད་པར་སྨྲ་བ་པོའི་ཡང་འདི་ཁོ་ན་ལྟར་འཇོག་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "འདི་ནི་ལྐོག་ཏུ་གྱུར་པའི་སྐྱེད་པར་བྱེད་པ་བརྟན་པར་བྱེད་པའི་རྒྱུ་དམིགས་པར་བྱེད་པ་ཡིན་གྱི།",
    "རྣམ་ངེས་ཏེ་རྟོགས་པས་བྱས་པར་མི་རིགས་པ་དེ་བཞིན་དུ།",
    "ཁྱད་པར་དང་ཁྱད་པར་དུ་བྱ་བ་ཉིད་ཕྱི་རོལ་གྱི་དམིགས་པ་མེད་པ་ཉིད་ན་ངེས་སམ་ཞེས་བསྡུ་བ་ཡིན་ནོ།",
    "དེ་དགག་བྱས་པ་དེ་ཡི་ཕྱིར།",
    "ཉ་ཕྱིས་ལ་དངུལ་གྱི་ཤེས་པ་བཞིན་དུ་དངུལ་མ་ཡིན་ན་ཇི་ལྟར་དངུལ་གྱི་ཁྱད་པར་དགག་པ་ཡིན་ཞེས་བརྒལ་ཞིང་བརྟགས་པའོ།",
    "དོན་དམ་པར་ན་ཕྱི་རོལ་གྱི་འཁྲུལ་པ་མེད་པ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ཁྱབ་ཆེས་པ་ཡིན་ནོ།",
    "མ་འཁྲུལ་པར་འདོད་པ་དེ་དང་རྒྱུ་དང་ལྡན་པ་ཡིན་ན་དེ་ལས་བརྒལ་ཞིང་བརྟགས་པ་མཚུངས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁྲུལ་པར་འདོད་པ་དེ་སྒྲུབ་པར་བྱེད་པས་མ་འཁྲུལ་པས་འཁྲུལ་པ་ཐོབ་པར་འགྱུར་རོ་ཞེས་ཟེར་བ་ནི།",
    "དེའི་ཕྱིར་ཁྱད་པར་དུ་འཁྲུལ་པ་ཡིན་པར་ངེས་པ་ཉིད་དུ་བསྟན་པ་ནི།",
    "འཁྲུལ་པ་ཉིད་ནི་རྗེས་སུ་བརྗོད་པར་བྱ་བ་ཡིན་གྱི།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་དང་བཅས་པའི་བློ་གང་དུ་རྒྱུ་ཡིན་པ་དེ་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཁྱད་པར་གྱིས་ཉེ་བར་བཀོད་པ་ལས་ཡིན་གྱི།",
    "དེས་རྟོགས་པ་ཡིན་ཡང་མངོན་སུམ་གྱི་ངེས་པ་མ་ཡིན་པ་ནི་འཁྲུལ་པ་ངེས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "མངོན་སུམ་གྱི་རྟོགས་པར་བྱ་བས་འཁྲུལ་པ་ཉིད་འཛིན་པའི་ཡུལ་ཡང་མངོན་སུམ་གྱིས་ངེས་པ་མ་ཡིན་ཏེ།",
    "ཟད་པར་སྒྲུབ་པར་བྱེད་བློ་ཡང་།",
    "མ་ཚང་སོགས་པར་ཐར་བར་འགྱུར།",
    "སྔ་མ་ཐམས་ཅད་མེད་པར་འགྱུར།",
    "དངུལ་དུ་རྟོགས་པར་བྱེད་ན་ནི།",
    "ལྡོག་པའི་རྒྱུ་ནི་གནོད་པར་བྱེད་པའོ།",
    "རྟོགས་པ་གཉིས་ཀྱི་ཡུལ་མི་དམིགས་པ་ལ་ཁྱད་པར་མེད་པས་དེའི་ཚེ་ཀ་བ་སྒྲུབ་པར་བྱེད་པའི་ཤེས་པའི་དབྱེ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདོད་པ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི།",
    "སྒྲུབ་པར་བྱེད་པའི་ཤེས་པ་ནི་ཀ་བ་ལ་སོགས་པའི་ཤེས་པའི་ཡུལ་མ་ཡིན་པའི་མི་དམིགས་པ་རྗེས་སུ་བརྗོད་པ་ལས་ཁྱད་པར་དུ་བྱ་བ་ཁོ་ན་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།"
  ]
}