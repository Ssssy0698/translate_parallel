    "ཚིག་འབྲུ་འདི་ཉིད་ནི་བརྗོད་པར་བྱ་བའི་དོན་ཡིན་པས་དེའི་ཕྱིར་ཚིག་འབྲུའི་དོན་ཞེས་བྱའོ།",
    "མངོན་དུ་བྱས་པའི་མཚན་ཉིད་དང་།",
    "གནས་དང་གནས་པར་རབ་ཏུ་འབྲེལ་བའི་མཚན་ཉིད་ནི་འདི་ལྟ་སྟེ།",
    "རྒྱུར་བྱས་པའི་གཟུགས་རྣམས་ནི་གནས་པ་ཡིན་ནོ།",
    "ཡང་ནམིག་ལ་སོགས་པ་ནི་གནས་ཡིན་ལ་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ནི་གནས་པ་ཡིན་ནོ།",
    "ཡང་ན་བརྗོད་པར་བྱ་བ་ནི་གནས་ཡིན་ལ།",
    "རྗོད་པར་བྱེད་པ་ནི་གནས་པ་ཡིན་ཏེ།",
    "འབྲས་བུ་འགོག་པ་ཕན་ཚུན་མཐུན་པར་གྱུར་པའི་དོན་གང་ཡིན་པ་དེ་ནི་གནས་དང་གནས་པར་འབྲེལ་བའི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "འཇིག་རྟེན་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བ་སྟེ།",
    "གཟུགས་ནས་རྣམ་པར་ཤེས་པའི་བར་དུའོ།",
    "སྡུག་བསྔལ་ལས་རྣམ་པར་གྲོལ་བའོ།",
    "འདུན་པ་དང་འདོད་ཆགས་ལས་ཡང་དག་པར་འདས་པའོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "རབ་ཏུ་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གནས་དང་གནས་པར་རབ་ཏུ་འབྲེལ་པའི་མཚན་ཉིད་ནི་འདི་ལྟ་སྟེ།",
    "དེ་ཁོ་ནའི་མཚན་ཉིད་ལ་སོགས་པ་གོང་མ་གོང་མའི་གནས་ཡིན་པར་སྟོན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རྣམ་པ་གསུམ་དུ་བསྒྱུར་བ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་མི་ཤེས་པའོ།",
    "གསུམ་པ་ནི་ཐོབ་པར་བྱ་བའི་དངོས་པོ་དཔག་ཏུ་མེད་པ་སྟེ།",
    "བཞི་པ་ནི་ཡོངས་སུ་སྨིན་པར་བྱ་བའི་དངོས་པོ་དཔག་ཏུ་མེད་པ་སྟེ།",
    "འདི་ནི་ཆགས་པའོ་འཇིག་པའོ་ཞེས་རྣམ་པ་སྣ་ཚོགས་ཀྱི་དབྱིབས་ཀྱི་བྱེ་བྲག་རྣམ་པར་གཞག་པ་སེམས་པ་གང་ཡིན་པའོ།",
    "རབ་དག་ལས་ཁྱད་པར་འཕགས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་དོན་སོ་སོ་ཡང་དག་པར་རིག་པ་གང་ལགས་པ་དང་།",
    "བསམ་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་དོན་སོ་སོ་ཡང་དག་པར་རིག་པ་གང་ལགས་པ་དང་།",
    "ཤེས་རབ་རྣམ་པ་གསུམ་གྱིས་དོན་སོ་སོ་ཡང་དག་པར་རིག་པའི་བྱེ་བྲག་བསྟན་པ་དང་།",
    "དང་པོ་ཡང་རྣམ་པ་གཉིས་ཏེ་ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པ་སྟེ།",
    "ཞུ་བ་གསོལ་བ་ནི་གནས་བསྟན་པ་དང་ཞུ་བ་གསོལ་བ་ཉིད་ཀྱི་ཚིག་ཡང་དག་པར་བསྟན་པ་སྟེ།",
    "གཉིས་པ་སྒྲ་ཇི་བཞིན་པ་ནི་འདི་ལྟར་ཚིག་འབྲུ་ཇི་ལྟ་བ་བཞིན་དུ་དོན་འཛིན་པར་བྱེད་ཀྱི།",
    "ཡང་ན་འདུས་བྱས་དང་།",
    "འདུས་མ་བྱས་ཀྱི་རྣམ་པར་གྲོལ་བ་རྣམ་པ་གཉིས་ཀ་ཡང་སྡུད་པའི་ཕྱིར་རོ།",
    "ཐོས་པའི་ཤེས་རབ་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་རོ།",
    "བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་རྣམ་པ་གསུམ་གྱི་རྣམ་པར་བྱང་བའི་ཐབས་ཡོངས་སུ་བསྟན་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་མཛོད་ཀྱི་བསྟན་བཅོས་ཀྱི་ཚིག་ལེའུར་བྱས་པ་ལས།",
    "ཡི་གེ་མ་སྤངས་པར་དོན་ལ་སོ་སོར་རྟག་པའི་ཕྱིར་རོ།",
    "བསམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ནི་མིང་དང་དོན་གྱི་ཡུལ་ལ་དམིགས་པར་བྱེད་དེ།",
    "ཡི་གེ་ཚང་བར་མ་སྤངས་པར་ཡང་དོན་ལ་སོ་སོར་རྟོག་པའི་ཕྱིར་རོ།",
    "དོན་ལ་དམིགས་པ་གཉི་གར་གཏོགས་པ་ཡང་ཡིན་ན་ནི་གོ་རིམས་བཞིན་དུ་ཐོས་པ་དང་བསྒོམས་པ་ལས་བྱུང་བ་ཡིན་པར་འགྱུར་རོ་ཞེས་འབྱུང་སྟེ།",
    "བསམ་པའི་རིགས་པ་ལ་བརྟེན་ཏེ་བྱུང་བ་ཁྱད་པར་དུ་འཕགས་པའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་བསམས་པ་ལས་བྱུང་བ་ཞེས་བྱའོ།",
    "ཏིང་ངེ་འཛིན་བསྒོམས་པ་ལ་བརྟེན་ཏེ་བྱུང་བ་ཁྱད་པར་དུ་འཕགས་པའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་བསྒོམས་པ་ལས་བྱུང་བ་ཞེས་བྱའོ།",
    "རྒྱ་ཆེར་རྣམ་པར་འབྱེད་པ་ནི་བསྟན་བཅོས་སེམས་སྣ་ཚོགས་བསྟན་པ་དང་།",
    "བསམས་པའི་འོག་ཏུ་ནི་ཇི་སྐད་བསྟན་པ་བཞིན་དུ་བསྒྲུབས་པར་ཤེས་པ་དང་།",
    "བསྒོམས་པ་ལས་དོན་ཐོབ་པ་གང་ཡིན་པ་དེ་ནི་བསྒོམས་པ་ལས་བྱུང་བ་ཞེས་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཐོས་པ་ལས་བྱུང་བའི་ཚིག་འབྲུ་དང་དོན་ཤེས་པའི་ཤེས་རབ་དང་ཤེས་རབ་མཚུངས་པར་ལྡན་པའི་སེམས་དང་སེམས་ལས་བྱུང་བའི་ངོ་བོ་ཉིད་དོ།",
    "བསམས་པ་ནི་སེམས་པར་བྱེད་པ་སྟེ།",
    "རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་ཕྱིར་རོ།",
    "བསྒོམས་པ་ནི་ཡོངས་སུ་གོམས་པར་བྱེད་པ་སྟེ།",
    "བསྒོམས་པ་ལས་བྱུང་བའི་དོན་དང་དངོས་པོ་ཤེས་པའི་ཤེས་རབ་དང་ཤེས་རབ་མཚུངས་པར་ལྡན་པའི་སེམས་དང་སེམས་ལས་བྱུང་བའི་ངོ་བོ་ཉིད་དོ་ཞེས་འབྱུང་ངོ།",
    "རྣམ་པ་གསུམ་གྱིས་ན་འཕགས་པའི་བདེན་པ་ཡོངས་སུ་འཛིན་པར་བྱེད་དེ།",
    "ཐོས་པའི་ཤེས་རབ་ཀྱིས་ནི་ཚིག་འབྲུ་ཡོངས་སུ་འཛིན་པར་བྱེད་དོ།",
    "བསམས་པའི་ཤེས་རབ་ཀྱིས་ནི་མཚན་ཉིད་ཡོངས་སུ་འཛིན་པར་བྱེད་དོ།",
    "བསྒོམས་པའི་ཤེས་རབ་ཀྱིས་ནི་མངོན་སུམ་དུ་བྱེད་པ་ཡོངས་སུ་འཛིན་པར་བྱེད་དོ་ཞེས་ཞིབ་ཏུ་དེ་ཉིད་ལས་བསྟན་པ་བཞིན་ཏེ།",
    "ཅིའི་ཕྱིར་འདི་ལྟར་མི་མཐུན་པར་གྱུར།",
    "དེ་ཅི་ལྟར་བརྡ་ཕྲད་པར་བྱ་ཞེ་ན།",
    "དེ་ནི་གཏུགས་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་འདི་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམ་པ་གསུམ་གྱི་བྱེ་བྲག་ཅེས་བྱའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་སྤྱིའི་མཇུག་བསྡུ་བར་རིག་པར་བྱའོ།",
    "མཐོང་བ་ནི་གང་ལགས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་ཤེས་པ་དང་མཐོང་བའི་བྱེ་བྲག་བསྟན་པའོ།",
    "ལན་དུ་གསུངས་པ་སྟེ།",
    "འདིར་ནི་རྣམ་པ་གཉིས་ཀྱིས་ཁྱད་པར་དུ་འཕགས་པ་དང་དམན་པ་དག་རབ་ཏུ་བསྟན་པའི་ཕྱིར་འདྲེས་པ་མ་ཡིན་པ་ལ་དམིགས་པའི་མཐོང་བ་ཞེས་བསྟན་ལ་འདྲེས་པ་ལ་དམིགས་པ་ནི་ཤེས་པ་ཞེས་བསྟན་ཏོ།",
    "རྣམ་པར་ཤེས་པ་ལྔ་དང་།",
    "མཚུངས་པར་ལྡན་པའི་ཤེས་རབ་དང་།",
    "ཟག་པ་མེད་པའི་བཟོད་པ་མ་གཏོགས་པ་གཞན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པའི་བཟོད་པ་རྣམས་སོ་ཞེས་འབྱུང་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་དང་མཚུངས་པར་ལྡན་པའི་ཤེས་རབ་དང་ཟད་པ་དང་མི་སྐྱེ་བའི་ཡེ་ཤེས་དང་ལྟ་བ་ལྔ་དང་།",
    "འཇིག་རྟེན་པའི་ཡང་དག་པའི་ལྟ་བ་མ་གཏོགས་པ་གཞན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པ་ཟག་པ་དང་བཅས་པའི་ཤེས་རབ་བོ།",
    "དང་པོ་ཁོ་ནར་འཇིག་པར་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་ཤེས་པ་ཞེས་བྱའོ།",
    "དེའི་ཕྱིར་འགྲེལ་པ་དེ་ཉིད་ལས་མཁྱེན་ཏོ་ཞེས་བྱ་བས་མཆོག་གམ།",
    "ཅིའི་ཕྱིར་ཡང་དེ་བཞིན་གཤེགས་པས་མཁྱེན་ཏོ་ཞེས་བྱ་བ་གསུངས་ཤེ་ན།",
    "གལ་ཏེ་མཁྱེན་ཏོ་ཞེས་བྱ་བ་མ་གསུངས་ན།",
    "འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་འགྲེལ་པ་ལས་ནི་དཔེར་ན་གཞན་དག་ལས་ཀློག་པ་དང་ཁ་ཏོན་སློབ་པ་དང་རྣམ་པར་འབྱེད་ཅིང་དཔྱོད་པ་ལྟ་བུ་གང་ཡིན་པ་དེ་ནི་ཤེས་པ་ཞེས་བྱའོ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་ཇི་ལྟར་ཏིང་ངེ་འཛིན་བསྒོམས་པས་ཤེས་པ་དང་མཐོང་བ་ཐོབ་པར་འགྱུར་ཞེ་ན།",
    "དེ་ལ་མིག་མེད་པར་ཡང་གཟུགས་ཀྱི་ཡུལ་རྣམས་ལ་ལྟ་བ་དང་།",
    "གཞན་ཡང་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཤེས་པ་དང་མཐོང་བ་གཉིས་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "གཞན་ཡང་གཟུང་བས་དམིགས་པར་བྱས་པའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་ཤེས་པ་ཞེས་བྱའོ།",
    "འཛིན་པས་དམིགས་པར་བྱས་པའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་མཐོང་བ་ཞེས་བྱའོ།",
    "གཞན་ཡང་རྣམ་པར་མི་རྟོག་པའི་གཟུགས་བརྙན་ཡུལ་དུ་གྱུར་པ་ལ་དམིགས་པའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་ཤེས་པ་ཞེས་བྱའོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་གཟུགས་བརྙན་ཡུལ་དུ་གྱུར་པ་ལ་དམིགས་པའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་མཐོང་བ་ཞེས་བྱའོ།",
    "ལན་དུ་གསུངས་པ་དང་།",
    "ཇི་ལྟར་རྣམ་པར་སེལ་བར་བགྱིད་ལགས་ཞེས་བྱ་བ་ནི་མཚན་མ་བསལ་བའི་ཐབས་ཞུས་པ་སྟེ།",
    "རིགས་ཀྱི་བུ་དེ་བཞིན་ཉིད་ཡིད་ལ་བྱེད་པས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པའོ།",
    "འདི་ནི་ཞུས་པ་དང་པོའི་ལན་དུ་གསུངས་པ་སྟེ།",
    "དོན་གྱི་མཚན་མ་རྣམ་པར་སེལ་བར་བྱེད་དེ་ཞེས་བྱ་བ་ནི་ཞུས་པ་གཉིས་པའི་ལན་དུ་གསུངས་སོ།",
    "གོང་དུ་བསྟན་པའི་རྗོད་པར་བྱེད་པའི་མིང་ལ་སོགས་པ་དང་།",
    "བརྗོད་པར་བྱ་བ་དོན་བཅུ་ལ་སོགས་པ་དོན་རྣམས་ཀྱི་གཟུགས་བརྙན་གྱི་མཚན་མའམ།",
    "མིང་ལས་བརྩམས་ནས་རྣལ་འབྱོར་རྣམ་པར་འབྱེད་པ་དང་།",
    "དེ་ལྟར་རྟོག་པའི་ཚེ་མིང་འབའ་ཞིག་དམིགས་སུ་མེད་པར་མཐོང་བ་མ་ཡིན་གྱི།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་མངོན་སུམ་དུ་གྱུར་པ་ན་ཡུལ་གྱི་དོན་ཐམས་ཅད་སྣང་བར་མི་འགྱུར་རོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དོན་ཐམས་ཅད་ལ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཉིས་པ་ཟླས་ཚིག་ལ་སོགས་པའོ།",
    "ཁམས་ཀྱི་བར་ལ་ཡང་ཁམས་ཀྱི་ངོ་བོ་ཉིད་མི་དམིགས་པ་ན་དེའི་གནས་ཀྱི་མཚན་མ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བས་དེ་ལྟར་རྣམ་པར་སེལ་ཏོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་ཟླས་དོན་རྣམ་པ་ལྔ་ལ་སོགས་པ་བསྟན་པའོ།",
    "རྣལ་འབྱོར་གྱི་སྒོ་དེ་དག་ཀྱང་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ཇི་སྐད་དུ་བསྟན་པ་བཞིན་ཏེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་བསྟན་པའི་དོན་བརྗོད་པར་བྱའོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་བཞི་ལས་བརྩམས་ནས་མིང་དང་དོན་དེ་དག་ལ་སོ་སོར་རྟོག་པར་སྟོན་ཏོ།",
    "དོན་གྱི་རྣམ་པར་ཤེས་པ་དམིགས་སུ་མེད་པར་སོ་སོར་རྟོག་སྟེ།",
    "དེའི་ཕྱིར་ཚིག་ལེའུར་བྱས་པ་ལས།",
    "རྣམ་པར་རིག་པ་ཙམ་གྱི་ངོ་བོ་ཉིད་ལ་གནས་པས་ཡང་སྦྱོར་བ་བསྒོམས་ནས་འཛིན་པ་གཉིས་རྣམ་པར་གནོན་ཅིང་སེལ་བར་བྱེད་དེ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་བཞི་ལ་བརྟེན་ནས་དང་པོ་དང་ཐ་མའི་གནས་སྐབས་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "ཀུན་དུ་བརྟགས་པ་ནི་ཡང་དག་པར་མེད་པའི་ངོ་བོ་ཉིད་གང་ཡིན་པའོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་བཞི་པོ་དག་ནི་རྣམ་པར་ཤེས་པ་ལས་གུད་ན་ཡང་མེད་ལ་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མ་ཡིན་པས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་ཞེས་བྱའོ།",
    "སྣང་བ་ཐོབ་པའི་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ཏེ་ཀུན་དུ་ཚོལ་བ་ཐ་མ་བསྐྱེད་ནས་གཟུང་བ་མེད་པ་ཉིད་དུ་མཐོང་བ་ལས་ནི་བྲོ་བར་གྱུར་པའི་གནས་སྐབས་རྣམ་པར་གཞག་སྟེ།",
    "ཡང་དག་པར་ན་དམིགས་སུ་མེད་པ་ཉིད་དུ་མཐོང་བས་སོ།",
    "ཡང་དག་པར་ནི་དམིགས་སུ་མེད་པ་ཉིད་དུ་མཐོང་བས་སོ།",
    "རྗེས་སུ་མཐུན་པའི་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ཏེ་ཡང་དག་པའི་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་ཐ་མ་བསྐྱེད་ནས་གཟུང་བ་མེད་པ་ཉིད་ལ་ཡང་ངེས་པ་ཉིད་དུ་འཛིན་པར་བྱེད་ལ་འཛིན་པ་མེད་པ་ལ་ཡང་གཞོལ་བ་དང་།",
    "འདོད་པ་དང་བཟོད་པར་བྱེད་དེ།",
    "ཡུལ་ཡང་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་ན་འཛིན་པ་དང་བྲལ་བའི་རྣམ་པར་ཤེས་པ་ལྟ་གཟུང་བའི་ཡུལ་ལས་གུད་ན་ཡང་དག་པའི་རྣམ་པར་ཤེས་པ་ག་ལ་ཡོད་སྙམ་སྟེ།",
    "གཟུང་བ་དང་འཛིན་པ་དག་ནི་ཕན་ཚུན་ལྟོས་པ་ལས་རྣམ་པར་གཞག་པའི་ཕྱིར་རོ།",
    "འཛིན་པའི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་ནི་གཟུང་བ་སྟོང་པ་ཉིད་སོ་སོར་རྟོག་སྟེ།",
    "བཟོད་པ་ཐ་མ་བྱུང་བའི་ཚེ་སྟོང་པ་ཉིད་ཀྱི་མཚན་མ་འཇིག་པར་བྱེད་དོ།",
    "ཡང་དག་པར་རྣམ་པར་རིག་པ་ཙམ་གྱི་དོན་ལ་གནས་པ་མ་ཡིན་གྱི་དེའི་མཚན་མ་ཉེ་བར་ཞི་བར་གྱུར་པ་ན་གདོད་ཡང་དག་པར་གནས་པ་ཞེས་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ཏེ།",
    "གཟུང་བ་མེད་པར་རྟོག་པར་འགྱུར།",
    "དེ་ནས་མི་དམིགས་ལེགས་པར་འགྱུར།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ་ཞེས་འབྱུང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཅི་དེ་བཞིན་ཉིད་ཀྱི་དོན་སོ་སོ་ཡང་དག་པར་རིག་པའི་མཚན་མ་གང་ལགས་པ་དེས་དེ་བཞིན་ཉིད་ཀྱི་མཚན་མ་ཡང་རྣམ་པར་སེལ་བར་བགྱིད་ལགས་སམ་ཞེས་བྱ་བ་ནི་གསུམ་པ་བརྟག་པ་སྟེ།",
    "འདི་ལྟར་སྔར་བསྟན་པའི་དེ་བཞིན་ཉིད་ཡིད་ལ་བགྱིད་པས་དམིགས་པའི་དེ་བཞིན་ཉིད་དེ་ཡང་རྣམ་པར་སེལ་བར་བགྱིད་ལགས་སམ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མཚན་མ་རྣམས་ཅི་ཡང་མེད་དེ་མཚན་མ་མེད་པའི་ཕྱིར་དམིགས་སུ་ཡང་མེད་པ་ནི་ཅི་ཞིག་རྣམ་པར་སེལ་བར་བྱེད་ཅེའོ།",
    "འདི་ལྟར་དེ་བཞིན་ཉིད་ཀྱི་རྣལ་འབྱོར་ལ་ཞུགས་པ་ན་གཟུང་བ་དང་འཛིན་པའི་མཚན་མ་ཅི་ཡང་མི་དམིགས་པས་དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པའི་ནང་ནས་རབ་ཏུ་རྟོགས་པའི་གནས་སྐབས་ཀྱི་ཚིགས་སུ་བཅད་པ་ལས།",
    "རྣམ་པར་རིག་པ་ཙམ་ལ་གནས།",
    "རིགས་ཀྱི་བུ་ད་ནི་དེ་བཞིན་ཉིད་ཀྱི་དོན་སོ་སོ་ཡང་དག་པར་རིག་པའི་ཚེ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་དེ་མ་ཡིན་པ་གཞན་གྱིས་གནོན་པར་མི་ནུས་པས་སོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ནི་འདི་སྐད་དུ་མཚན་མ་གཞན་ཐམས་ཅད་ནི་མཚན་མ་དང་བཅས་པའི་ཕྱིར་དེ་བཞིན་ཉིད་ཀྱིས་རྣམ་པར་སེལ་བར་འགྱུར་ལ་དེ་བཞིན་ཉིད་མངོན་དུ་གྱུར་པའི་ཚེ།",
    "དེ་ལ་མཚན་མ་མེད་པ་ལ་མཚན་མར་མི་བྱེད་པ་ཞེས་བྱ་བ་ནི་མཚན་མ་མེད་པ་རྣམ་པར་མི་སེལ་བའོ།",
    "མཚེའུ་འཁྲུགས་པའི་དཔེས་གཞན་གྱི་གཟུགས་བརྙན་གྱི་མཚན་མ་བརྟག་པར་མི་ནུས་ལ་དེ་ལས་བཟློག་པས་ནི་ནུས་པ་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་ཞུས་པ་དང་།",
    "མི་ནུས་པ་རྣམ་པར་འབྱེད་པ་ཞེས་སྟོན་ཏོ།",
    "ལན་དུ་གསུངས་པའོ།",
    "སོ་སོར་བརྟག་པར་ནུས་པའི་དཔེ་དང་སོ་སོར་བརྟག་པར་མི་ནུས་པའི་དཔེའོ།",
    "དེ་བཞིན་དུ་ལེགས་པར་མ་བསྒོམས་པའི་སེམས་ཀྱིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་དེ་བཞིན་ཉིད་ཇི་སྙེད་ཡོད་པ་སོ་སོར་བརྟག་པར་མི་ནུས་ཀྱི།",
    "ལེགས་པར་བསྒོམས་པ་གང་ཡིན་པ་དེས་ནི་ནུས་སོ་ཞེས་བཀའ་སྩལ་པ་གང་ལགས་པ་ཞེས་བྱ་བ་ནི་གཉིས་པ་དཔེ་དང་དོན་དུ་སྦྱར་བ་སྟེ།",
    "དེ་ལ་ཇི་ལྟ་བུ་ཞིག་ལ་སོ་སོར་བརྟག་པའི་སེམས་ལེགས་པར་གསུངས་ཤིང་དེ་བཞིན་ཉིད་ནི་གང་ལས་དགོངས་ཏེ་དེ་སྐད་བཀའ་སྩལ་ལགས་ཞེས་བྱ་བ་ནི་གཉིས་པ་བསྟན་པ་བཞིན་དུ་ཞུ་བ་གསོལ་པ་ཉིད་དོ།",
    "དེ་སྐད་དུ་གསུངས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གཉིས་པ་ནི་སོ་སོར་བརྟག་པར་བྱ་བའི་ཡུལ་ཞུས་པ་སྟེ།",
    "རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་ལས་དགོངས་ཏེ་དེ་སྐད་བསྟན་པ་ཡིན་ན་ནི་ཞེས་བྱ་བ་ནི་གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པའོ།",
    "སེམས་ཀྱིས་སོ་སོར་བརྟག་པ་རྣམ་པ་གསུམ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གཉིས་པ་སོ་སོར་བརྟག་པར་བྱ་བའི་ལམ་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་ཉིད་རྣམ་པ་བདུན་ལས་རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་དོ།",
    "དང་པོ་ནི་འདུ་བྱེད་ཐམས་ཅད་རྣམ་པར་རིག་པ་ཙམ་གྱི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་དེ་བཞིན་ཉིད་ཅེས་བྱ་སྟེ།",
    "གཉིས་པ་ནི་རྣམ་པར་རིག་པ་ཙམ་གྱི་ངོ་བོ་ཉིད་ལ་རྣམ་པར་རིག་པའི་ངོ་བོ་ཉིད་ཅེས་བྱ་སྟེ།"
  ]
}