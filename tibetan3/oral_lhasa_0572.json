    "མིའི་འགྲོ་བ་རྣམས་ཀྱང་རྣམ་པར་སྨིན་པའི་ངོ་བོ་འཕེན་པར་བྱེད་པའི་ལས་ནི་མཚུངས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "རྣམ་སྨིན་གྱི་ངོ་བོ་ཕུང་པོ་རྣམས་རིས་མཐུན་པར་དམིགས་པའི་ཕྱིར་རོ།",
    "གཞན་དུ་ན་རྒྱུ་ཐ་དད་པ་ལས་སྐྱེས་པའི་འབྲས་བུ་ཐ་མི་དད་པར་འགལ་ཏེ།",
    "ཚེ་རིང་ཐུང་དང་གཟུགས་བཟང་ངན་དང་ལོངས་སྤྱོད་ཆེ་ཆུང་ལ་སོགས་པའི་ཁྱད་པར་སྣ་ཚོགས་པ་དམིགས་པའི་ཕྱིར་དང་།",
    "དེ་བཞིན་དུ་འགྲོ་བ་གཞན་རྣམས་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "རྫོགས་པ་ཡོད་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "འདོད་པར་བྱ་བའི་འབྲས་བུ་བཟང་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་བཟང་པོ་དང་ངན་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་ལ།",
    "ལས་ཀྱི་སྐད་ཅིག་མ་མང་པོས་ཚེ་གཅིག་པོ་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པའི་ས་བོན་ཡང་དང་ཡང་དུ་གསོས་པའི་ཕྱིར་རོ།",
    "འདི་དག་ནི་ལུང་ལ་བརྟེན་ནས་རྣམ་པར་བཞག་པ་ཙམ་ཡིན་གྱི་རིགས་པས་འགྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་ལས་གང་ལྕི་བ་དེ་ཉིད་ཀྱི་འབྲས་བུ་ཐོག་མར་རྣམ་པར་སྨིན་པར་འགྱུར་ཏེ།",
    "དེ་ཡང་འདྲ་ན་ཐོག་མ་ཉིད་དུ་སྤྱད་པ་དེ་ཉིད་ཐོག་མར་སྨིན་པར་རིག་སྟེ།",
    "སྔོན་བྱས་གང་ཡིན་དེ་ལས་ནི།",
    "ཞེས་གང་གསུངས་པ་ལྟར་རོ།",
    "འབྲས་བུ་ཡིད་དུ་འོང་བ་འབྱིན་པར་བྱེད་པའི་ཕྱིར་དང་།",
    "མཉམ་པར་གཞག་པའི་ས་པ་ཡིན་པས་ས་འོག་མའི་སྐྱོན་གྱིས་མི་གཡོ་བའི་ཕྱིར་རོ།",
    "འདོད་པའི་ཁམས་ན་ཡང་འཕེན་བྱེད་ཀྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་ནམ་ཡང་མི་གཡོ་སྟེ།",
    "བདེ་འགྲོའི་རྣམ་སྨིན་འཕེན་པར་བྱེད་པ་དེས་ནི་ནམ་ཡང་ངན་འགྲོའི་རྣམ་སྨིན་མི་འཕེན་ལ།",
    "གཞན་གྱི་རྫས་ལ་ཆགས་པ་མེད་ན་དེ་ལེན་པར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་གཉིས་ཀ་ཡང་འདོད་ཆགས་ཀྱིས་ཆར་གཏོགས་པས་དེས་རྫོགས་པར་བྱེད་དོ།",
    "ཕྲ་མ་ལ་ཚུལ་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ལོག་པར་ལྟ་བ་ནི་གལ་ཏེ་རྒྱལ་པོ་ལ་སོགས་པས་བསྙེན་བཀུར་ལ་སོགས་པ་འབྱུང་ངོ་སྙམ་པས་སྦྱིན་པ་མེད་དོ།",
    "འབྲས་བུ་མཐུན་མི་མཐུན་གནང་བཀག་དང་།",
    "རྣམ་པར་རིག་བྱེད་ཡིན་མིན་དུ་འདོད་པ་གསུམ་དང་།",
    "དེའི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ནི་སོ་སོར་ཉམས་སུ་མྱོང་བའི་ཕྱིར་རོ།",
    "འཕགས་ལམ་གྱིས་མ་སྤངས་ཤིང་ཡོངས་སུ་མ་ཤེས་པ་དེ་ནི་བྱེ་བྲག་མེད་པར་སྟོབས་དང་ལྡན་པ་ཡིན་ཏེ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་བཟང་ཞིང་།",
    "ཡིད་ལ་བྱེད་པ་ནི་གལ་ཏེ་ཀུན་སློང་དྲག་པོ་དང་ལྡན་པར་གྱུར་ནའོ།",
    "ལན་མང་དུ་བྱེད་པ་ནི་ཡང་དང་ཡང་དུ་བྱས་པར་གྱུར་པའམ།",
    "བཟློག་པའི་ལས་རྣམས་ནི་སྟོབས་དང་མི་ལྡན་པར་རིག་པར་བྱའོ།",
    "དེ་ལྟ་ན་སྲིད་པའི་སྡུག་བསྔལ་ཟད་ཅིང་མཐར་དབྱུང་བའི་སྐབས་ཀྱང་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་རྒྱུར་གྱུར་པའི་ཚངས་པར་སྤྱོད་པས་གནས་པའི་རྣམ་སྨིན་སྡུག་བསྔལ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་གནས་པར་འགྱུར་ལ།",
    "མི་ཚངས་པར་སྤྱོད་པ་སྤོང་བར་མི་འགྱུར་རོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཡང་དག་པར་བླངས་པའི་སྡོམ་པ་སྐྱོན་མེད་པ་དེ་ཉིད་ལ་བརྟེན་ནས།",
    "གནས་ཀྱིས་ཉམས་པར་བྱས་པའི་སྤོང་བ་གང་ཡིན་པ་དེ་ནི་བསམ་གཏན་གྱི་སྡོམ་པ་ཞེས་བྱའོ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུ་ཐོབ་པར་བྱེད་པའི་ཚེ་ན།",
    "གཉེན་པོ་དང་རྣམ་པར་དག་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་དུ་འགྱུར་བར་ཟད་ཀྱི།",
    "མི་མཐུན་ཕྱོགས་སྤངས་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་དུ་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "ཇི་ལྟར་ན་སེམས་དཔའ་ཁོ་ན་སྡོམ་པར་བཞག་ཅེ་ན།",
    "སེམས་རྣམ་པར་གཡེངས་པ་དང་།",
    "སྡོམ་པར་རུང་བ་མ་ཡིན་གྱི།",
    "སེམས་ཡོད་པ་དང་མེད་པ་དང་རྣམ་པར་གཡེངས་པ་དང་མ་གཡེངས་པའི་དུས་ཀུན་དུ་རྗེས་སུ་འབྲེལ་བར་འཇུག་པ་དེ་ནི།",
    "ཆུ་ལོན་ལྟར་རྣམ་པ་ཐམས་ཅད་དུ་འཆལ་ཚུལ་གྱི་རྒྱུན་འགོག་པར་བྱེད་པ་ལ་ནུས་པ་དང་ལྡན་པའི་ཕྱིར།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་ཆུ་ལོན་ལྟ་བུ་ཡོད་པའི་མཐུ་ལས་ཡིན་ཞེས་པ་འདི་དཔྱད་པར་བྱ་བ་ཡིན་ལ།",
    "དེ་ལྟར་རྣམ་པར་དཔྱད་པ་ན་ཡང་།",
    "རྒྱུན་རྗེས་སུ་འབྲེལ་བའི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་མཐུ་ལས་བྱུང་བ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་གཞན་བརྟགས་པས་ཅི་ཞིག་བྱ།",
    "གལ་ཏེ་དེ་ལྟ་བུའི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་མེད་ན།",
    "འདི་ནི་སེམས་རྣམ་པར་གཡེངས་པ་དང་མ་གཡེངས་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "སེམས་རྣམ་པར་གཡེངས་ཏེ།",
    "སྤོང་བའི་སེམས་པ་གང་ཡང་ཡོད་པར་ཁས་བླང་མི་དགོས་སོ།",
    "མྱོས་པ་ལ་སོགས་པ་སེམས་རྣམ་པར་གཡེངས་པའི་གནས་སྐབས་ན་ནི།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་ཡོད་པར་བརྟགས་ཀྱང་།",
    "འོན་ཀྱང་དེའི་ཚེ་སྲོག་གཅོད་པ་ལ་སོགས་པ་ཡང་དག་པར་བླངས་པ་དང་འགལ་བའི་ལས་སྤྱད་ཀྱང་སྡོམ་པ་འབྲལ་བར་མི་འགྱུར་ཏེ།",
    "ནུས་པ་ཆུང་བས་སྤོང་བའི་སེམས་པའི་ས་བོན་གྱི་ནུས་པ་ཉམས་པར་བྱེད་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཇི་སྲིད་འཚོའི་བར་དུ་སྲོག་གཅོད་པ་ལས་ལྡོག་པར་བགྱིའོ།",
    "ཞེས་ཁས་བླངས་པའི་རྣམ་པར་རིག་བྱེད་དང་འགལ་བ་སྐྱེས་པའི་ཕྱིར་ཇི་ལྟར་ན་སྡོམ་པ་འབྲལ་བར་མི་འགྱུར་ཞེ་ན།",
    "དེ་ལྟ་བུ་སྒྲུབ་པར་མི་ནུས་པའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ན་སེམས་རྣམ་པར་གཡེངས་པ་དང་སེམས་མེད་པའི་གནས་སྐབས་དག་ན་སྤོང་བའི་སེམས་དཔའ་མངོན་གྱུར་ཁས་བླང་དུ་ནི་ནུས་པ་མེད་པའི་ཕྱིར་དང་།",
    "ཡང་དག་པར་བླངས་པའི་སྡོམ་པ་ཡིན་ནོ།",
    "གཞན་གྱིས་བཏགས་པའི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་ལྟར་ཡོད་པར་མི་རྟོགས་པའི་ཉེས་པ་ཡང་མེད་དེ།",
    "ཤི་བའི་འོག་ཏུ་ཡང་ཅིའི་ཕྱིར་རྒྱུན་འཇུག་པར་མི་འགྱུར་ལུས་ཞིག་པས་སེམས་རྒྱུན་འཆད་དོ།",
    "རྒྱུན་འཇུག་པར་མི་འགྱུར་རོ།",
    "དེ་ཉིད་ཀྱིས་སྡོམ་པ་ལུས་ལ་རྟེན་པར་གྲུབ་པ་ཡིན་ཏེ།",
    "གཞན་དུ་ན་ཇི་སྲིད་མྱ་ངན་ལས་མ་འདས་ཀྱི་བར་དུ་ཞེས་ཅིའི་ཕྱིར་ཡང་དག་པར་ལེན་པར་མི་བྱེད།",
    "ཅིའི་ཕྱིར་ཇི་སྲིད་མཚོའི་བར་དུ་སྡོམ་པ་ལེན་པར་མི་བྱེད།",
    "གདུལ་བྱ་རྣམས་ཀྱི་ཇི་སྲིད་འཚོའི་བར་དུ་ཡང་དག་པར་བླངས་པ་དྲན་པས།",
    "ཇི་སྲིད་འཚོ་བ་ལས་ལྷག་པར་ཁས་ལེན་པར་མི་བྱེད་དོ།",
    "སེམས་སྟོབས་ཆེན་པོ་དང་ལྡན་པར་འགྱུར་བས།",
    "དེའི་ཕྱིར་ཤི་འཕོས་པའི་འོག་ཏུ་ཡང་དག་པར་བླངས་པ་དྲན་ནམ་མི་དྲན་ཡང་རུང་སྟེ།",
    "དེའི་ཕྱིར་ཡང་ཉན་ཐོས་ཀྱི་སྡོམ་པ་ནི་ཇི་སྲིད་འཚོ་ལས་ལྷག་པར་ལེན་པར་མི་བྱེད་དོ།",
    "སྤང་ལྟུང་སུམ་ཅུ་དང་སོ་སོར་བཤགས་པ་བཞི་དང་།",
    "ཉེས་བྱས་བརྒྱ་རྩ་བཅུ་གཉིས་ཏེ།",
    "བྱིན་ལེན་མ་བྱས་ཟ་བ་དང་།",
    "སོག་འཇོག་བྱས་པ་ཟ་བ་ལས།",
    "ལོག་པར་གཡེམ་དང་བརྫུན་གྱི་ཚིག།",
    "གཞན་ལ་གནོད་པའི་དངོས་པོ་སྤོང་བ་ཡང་དག་པར་བླངས་པའི་ཡན་ལག་དང་།",
    "ཡང་དག་པར་བླངས་པ་ལས་མི་ཉམས་པའི་ཡན་ལག་གོ།",
    "འདི་ལྟར་གཞན་ལ་གནོད་པ་སྤོང་བ་ཡང་དག་པར་ལེན་པའི་ཡན་ལག་དང་།",
    "སྤོང་བ་ཡང་དག་པར་ལེན་པའི་ཡན་ལག་དང་།",
    "ཡང་དག་པར་བླངས་པ་ལས་མི་ཉམས་པར་བྱ་བའི་ཕྱིར།",
    "དྲན་པ་རྨོངས་པར་མི་འགྱུར་བའི་ཡན་ལག་གོ།",
    "མི་ཚངས་པར་སྤྱོད་པ་སྤོང་བ་ནི་ཡན་ལག་གཉིས་པ་ཡིན་ཏེ།",
    "བདག་ལ་གནོད་པར་མི་འགྱུར་ཞིང་།",
    "གཞན་ལ་གནོད་པར་ཡང་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདག་ཉིད་དབེན་པར་ཡུད་ཙམ་ལ་མཐོང་བ་ན།",
    "གཞན་ལས་ཀྱང་ལེན་པར་བྱེད་དོ།",
    "གཞན་ལ་ཡང་དག་པར་བླངས་པ་ན།",
    "བདག་ཉིད་ལ་བརྟེན་ནས་འཛེམ་པ་ཉེ་བར་གནས་པར་འགྱུར་བས།",
    "དེའི་ཕྱིར་གཞན་ལས་ཡང་དག་པར་ལེན་པར་བྱེད་དོ།",
    "ཁྱིམ་པ་ལ་ཅི་ནས་ཀྱང་དེ་ལས་འགལ་ན་ཉེས་པ་གཅིག་བཤགས་པར་ཟད་ཀྱི།",
    "གཉིས་མི་དགོས་པར་བྱ་བའི་ཕྱིར་ཡང་བར་མཛད་ནས་བསླབ་པ་གཅིག་ཏུ་བསྡུས་ལ་རབ་ཏུ་བྱུང་བའི་ཚུལ་དང་མི་མཐུན་པས་དེ་དང་འགལ་ན་ཉེས་པ་གཉིས་བཤགས་དགོས་ཀྱི།",
    "གཅིག་མ་ཡིན་པར་བྱ་བའི་ཕྱིར་ལྕི་བར་མཛད་ནས་ཡན་ལག་གཉིས་སུ་བཅས་སོ།",
    "སྡོམ་པ་ཡང་དག་པར་བླངས་པ་དེ་དག་ཀྱང་རྒྱས་པར་ཕྱེ་ན་རྣམ་པ་བརྒྱར་གཏོགས་པར་རིག་པར་བྱ་སྟེ།",
    "ཉེས་པ་ལ་ཉེས་པར་འཆགས་ཤིང་།",
    "སླར་སྡོམ་པར་བྱེད་པ་ནི་བཞི་པ་ཡིན་ནོ།",
    "འདི་ལྟར་ཡང་དག་པར་ལེན་པའི་སྡོམ་པ་དང་།",
    "དེ་ལ་སྡོམ་པ་དང་པོ་གཉིས་ནི་ཡང་དག་པར་ལེན་པའི་སྡོམ་པ་ཡིན་ནོ།",
    "དེ་གཉིས་ཀའི་ཁོངས་སུ་གཏོགས་པར་ཤེས་པར་བྱའོ།",
    "ཡང་དག་པར་ལེན་པའི་སྡོམ་པ་དང་ཀུན་དུ་འཛིན་པའི་སྡོམ་པ་གཉིས་ཟག་པ་དང་བཅས་པ་དང་ཟག་པ་མེད་པའི་བསམ་གཏན་གྱིས་ཡོངས་སུ་དག་པར་བྱས་པ་ནི་ཡོངས་སུ་དག་པའི་སྡོམ་པ་ཡིན་ལ།",
    "ལེན་པར་མི་འགྱུར་ཞིང་།",
    "ལེན་པར་འདོད་ཀྱང་ཐོབ་པར་མི་འགྱུར་ཞེ་ན།",
    "ཐ་དད་དུ་གནས་པ་དང་གནས་པར་མི་བྱ་བ་རྣམས་ཡིན་ནོ།",
    "དེ་ལ་བསམ་པ་ཉམས་པས་ནི་རྣམ་པ་ཐམས་ཅད་ལེན་པར་མི་འགྱུར་བ་ཁོ་ནར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "པར་མི་འགྱུར་བར་བརྗོད་པར་བྱའོ།",
    "གང་དག་ཉེས་པར་སྤྱོད་པ་ལས་དབེན་པར་སྤྱོད་ཅིང་འདོད་པ་ལས་དབེན་པར་སྤྱོད་པ་དག་ཀྱང་ཡོད།",
    "གང་དག་འདོད་པ་ལས་དབེན་པར་མི་སྤྱོད་ཅིང་ཉེས་པར་སྤྱོད་པ་ལ་དབེན་པར་སྤྱོད་པ་དག་ཀྱང་ངོ་གང་དག་ཉེས་པར་སྤྱོད་པ་ལ་དབེན་པར་མི་སྤྱོད་ཅིང་འདོད་པ་ལ་ཡང་དབེན་པར་མི་སྤྱོད་པ་དག་ཀྱང་ཡོད་དོ།",
    "དེ་ནི་སྲོག་གཅོད་པ་ལ་སོགས་པ་ཉེས་པར་སྤྱོད་པ་ལས་ཀྱང་དབེན་པར་སྤྱོད་ལ།",
    "མི་ཚངས་པར་སྤྱོད་པའི་འདོད་པ་ལས་ཀྱང་དབེན་པར་སྤྱོད་པས་རབ་ཏུ་ཕྱེ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "བསླབ་པའི་གཞིའི་ཚིགས་གཅིག་དུ་ལུ་གུ་རྒྱུད་ལྟར་འབྲེལ་པ་ཡོངས་སུ་རྫོགས་པར་བསྲུང་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་ནི་གཉིས་ཀ་ལ་དབེན་པར་སྤྱོད་པ་མ་ཡིན་ཏེ།",
    "དེ་གཉིས་ཀྱི་རྒྱུ་སྤོང་བ་ཙམ་ཡང་དག་པར་བླངས་ནས།",
    "མི་ཚངས་པར་སྤྱོད་པ་སྤོང་བའོ།",
    "དཀར་ཕྱོགས་སམ་ནག་ཕྱོགས་གང་རུང་ལ་སྐྱེས་པར་འགྱུར་བའོ།",
    "ཀླུགས་པ་ནི་ཁར་མི་གཙང་བ་ཀླུགས་པ་ན་སྐྱེས་པར་འགྱུར་བའོ།",
    "བསྡུ་བར་ནི་མ་ནིང་གསུམ་གསུངས་ཏེ།",
    "གལ་ཏེ་སུན་འབྱིན་པར་བྱེད་ན།",
    "ཅིའི་ཕྱིར་ཟ་མ་དང་མ་ནིང་དག་རབ་ཏུ་དབྱུང་བར་མི་བྱ་ཞིང་བསྙེན་པར་རྫོགས་པར་མི་བྱ་ཞེ་ན།",
    "དགེ་སློང་མའི་ཕྱོགས་སུ་བཞག་ན་ཡང་ནོམ་པ་དང་ཉུག་པ་ལ་སོགས་པའི་སྒོ་ནས་སྐྱེས་པ་བསྟེན་པའི་ཉེས་པར་འགྱུར་བས།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བ་ཡང་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཡང་རབ་ཏུ་དབྱུང་བ་དང་བསྙེན་པར་རྫོགས་པའི་འོས་མ་ཡིན་ནོ།",
    "བསམ་གཏན་བཞི་པ་ལ་འདོད་ཆགས་དང་བྲལ་བ་ནི་གཟུགས་མེད་པར་གཏོགས་པ་ཡིན་ལ།",
    "བཅས་ཀྱི་ཏིང་ངེ་འཛིན་དང་མཚུངས་པར་ལྡན་པའི་སེམས་དཔའ་ཡིན་ལ།",
    "ཟག་མེད་ཀྱི་སྡོམ་པ་ཡང་འཆལ་ཚུལ་གྱི་ས་བོན་ཡང་དག་པར་འཇོམ་པར་བྱེད་པའི་ཟག་མེད་ཀྱི་ཏིང་ངེ་འཛིན་དང་མཚུངས་པར་ལྡན་པའི་སེམས་དཔའ་ཡིན་ནོ།",
    "ཞེས་ཤེས་པར་བྱའོ།",
    "དེ་ལ་ཡང་དག་པར་བླངས་པ་བརྡ་ལས་བྱུང་བའི་སྡོམ་པ་དེ་ཉིད།",
    "མི་མཐུན་ཕྱོགས་ཀྱི་ས་བོན་ཡང་དག་པར་བཅོམ་པས་ཟག་པ་མེད་པའི་སྡོམ་པ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "ལྟར་ཡང་དག་པར་བླངས་པ་བརྡ་ལས་བྱུང་བའི་སྡོམ་པ་རྣམས་ཀྱི།"
  ]
}