    "སྐམ་ལ་གནས་པ་ནི་ཆུའི་གཏིང་དུ་འདུག་པར་མི་བཟོད།",
    "ཆུ་ལ་གནས་པ་ནི་སྐམ་ལ་འདུག་པར་མི་བཟོད།",
    "ཕྱོགས་ནི་གང་མངོན་སུམ་གྱིས་དམིགས་པ་དེའི་རྗེས་སུ་འཇུག་པའི་བློ་དེ་དང་འབྱེལ་པའི་དངོས་པོ་མངོན་སུམ་གྱིས་མ་དམིགས་པ་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་མ་བསྐལ་བ་སྒོག་ཏུ་གྱུར་པའི་དོན་ལ་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ནོ་ཞེས་སྟོན་ཏེ།",
    "དེ་ལྟ་བུ་དང་མཐུན་པ་གང་ཡིན་པ་དེ་ནི་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བ་ལ་ཚུལ་གསུམ་པའི་རྟགས་དང་རང་དང་གཞན་གྱི་དོན་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་སྔར་བསྟན་པ་དེ་ལྟ་བུ་དང་མཐུན་པ་གཞན་དག་དང་ཅི་རིགས་པར་སྦྱར་ཏེ།",
    "དེ་ཡང་མི་དམིགས་པ་ལ་དངོས་པོ་མེད་པར་རྗེས་སུ་དཔག་པ་དང་རང་བཞིན་ལས་མི་རྟག་པ་ལ་སོགས་པར་རྗེས་སུ་དཔག་པ་དང་འབྲས་བུ་ལས་རྒྱུ་རྗེས་སུ་དཔག་པ་ཐམས་ཅད་དུ་ཡང་ཚུལ་གསུམ་པའི་རྟགས་ཀྱིས་རང་དང་གཞན་གྱི་དོན་རྗེས་སུ་དཔག་པར་བྱ་སྟེ།",
    "དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའི་ཡུལ་ལོ།",
    "གཞན་གྱིས་བསྒྲིབས་པའི་དངོས་པོ་སྒོག་ན་འདུག་པ་དག་ལ་ཡང་ཡིད་ཀྱིས་མངོན་སུམ་དུ་ཙོསྣདམིགས་པ་སྙམ་དུ་འཛིན་པ་དང་།",
    "འདུག་པ་དང་།",
    "དེ་གཉིས་ཀས་མ་བསྟན་ཀྱང་རང་བཞིན་གྱིས་ཤེས་ཉེན་ཆེ་བ་ནི་གཞན་པ་ཞེས་བྱའོ།",
    "དེའི་གཉེན་པོ་ནི་ལུས་ངལ་ཞིང་སྟོམ་པ་དང་སྐྱོ་ཞིང་དུབ་པ་མེད་པར་ཡང་ཞིང་བདེ་བ་དང་ཞུམ་རྒོད་དང་བྱིང་རྒོད་མེད་དེ་གསལ་ཞིང་རྩེ་གཅིག་ཏུ་འདུག་པ་སྟེ།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "དེ་ནས་ཞུམ་རྒོད་དེ་ཕྱིར་འབྱུང་དུ་དོགས་བཞིན་དུ་གནས་པ་ནི་སེམས་རྣལ་དུ་འདུག་པ་ཞེས་བྱའོ།",
    "སེམས་ཞིབ་པ་ཞེས་བྱ་བ་ནི་སྔར་བུམ་པའོ་ཙམ་དུ་རྩིང་བར་བརྟགས་པ་དེ་ཉིད་ལ་དཔྱོད་དོ།",
    "དེ་ཡང་རང་བཞིན་དང་།",
    "མེད་ཅེས་བསྟན་དུ་ནི་ད་ལྟར་མངོན་སུམ་དུ་སྣང་ཞིང་འདུག་པས་ཅི་ཡང་མི་བསྟན་པར་གཞག་པ་ནི་གཞག་པའི་ལུང་བསྟན་པའོ།",
    "གནས་ཁང་ཛེེཙམ་དག་ལ་ཆགས་ཤིང་འདུག་པའི་ལྟས་ཏེ།",
    "གཞན་གྱི་སྟན་ལ་ཡང་མི་འདུག་པར་དེ་ལ་འདུག་པ་ནི་སྟན་གཅིག་པའོ།",
    "ཟས་ཀྱིས་འགྲངས་པ་ཙམ་ཞིག་དུས་གཅིག་རྗོཏུ་བླངས་ཏེ་ཞིམ་པའི་བྱེ་བྲག་དབྱེ་ཞིང་ཕྱིར་འདོད་ཅིང་ལེན་པ་མེད་པར་ཟ་བ་ནི་ཟས་ཕྱིས་མི་ལེན་པའོ།",
    "རུས་སྦལ་རྒྱ་མཚོ་ན་འདུག་པའི་བུ་སྐམ་ལ་གཞག་པ་དེ་མའི་སེམས་ཇི་སྲིད་དུ་བུ་ལ་དྲན་པ་དེ་སྲིད་དུ་བུའི་སྲོག་འཛིན་པ་ནི་ཡིད་ཀྱི་རྗོཟས་ཞེས་བྱའོ།",
    "དེའི་དཀའ་འགྲེལ་སློབ་དཔོན་བེ་རོ་ཙ་ན་རཁྲི་ཏས་མཛད་པ།",
    "འདུག་པར་ཤེས་པར་བྱའོ།",
    "འདུ་བྱེད་ཀྱི་ཕུང་པོ་འདི་དག་ཀྱང་རང་རྗོབཞིན་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "འཛམ་བུའི་གླིང་འདིའི་འོག་དཔག་ཚད་སྟོང་ཕྲག་ཉི་ཤུ་ན་འདུག་སྟེ།",
    "དེ་ལ་ཤར་ཀྱི་ལུས་འཕགས་གླིང་ནི་ཟླ་བ་ཕྱེད་པ་ལྟར་འདུག་སྟེ།",
    "མདུན་དུ་སྒུ་ཤེབའི་ལུས་ནི་གང་འདུག་པའི་སྤྱོད་ལམ་གྱི་དུས་ན་ཡང་ལུས་མདུན་དུ་དུད་ཅིང་དྲང་པོར་གནས་པར་མི་ནུས་པའོ།",
    "དེ་ལ་ཁ་ཅིག་འཆགས་པ་དང་འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་དང་།",
    "གྲོང་ལ་སོགས་པའི་སྤྱོད་ཡུལ་ལ་བབ་བབ་ཏུ་འདུག་ཅིང་འཕྲལ་གྱི་བྱ་བ་དང་།",
    "འཆགས་པ་དང་འདུག་པ་དང་།",
    "སྟོབས་བཅུ་པོ་འདི་དག་དུས་གཅིག་ཏུ་ཐམས་ཅད་ཐོབ་སྣསྟེ།",
    "པ་རང་ག་བཅུའི་སྟོབས་ཙ་ནུ་ར་ག་གཅིག་ལ་ཡོད་དོ།",
    "ཞལ་རབ་ཏུ་མི་རིང་བ་ནི་ཞལ་ཆུ་རིངས་སུ་མི་འདུག་པའོ།",
    "ཀུན་གྱི་དེ་ལྟར་གདའ་བ་སྟེ།",
    "དད་ལྡན་རྐང་བརྐྱང་འདུག།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "བརྟག་པ་མ་མཐོང་སྟེ་ཡུད་ཙམ་ལ་ཡང་འགྲོ་བ་དང་སྡོད་པ་དང་ལྡན་པ་དང་ལྡང་བ་དང་འདུག་པ་དང་ཉལ་བ་དང་འཕྲེས་པ་དང་།",
    "དེ་བཞིན་དུ་འདུག་པས་ཡུན་རིང་དུ་འདའ་བར་བྱེད་ནུས་ཤིང་སྤྱོད་ལམ་དེས་དེའི་ལུས་ཤིན་ཏུ་ངལ་བར་མི་འགྱུར་བ་དང་།",
    "གཉིད་སྐྱེད་པའི་ཁ་ཟས་དང་བཏུང་བ་དང་ཚང་ཁུང་དུ་འདུག་པ་དང་།",
    "སྤྱོད་ལམ་སྔར་འདུག་པ་བཞིན་དུ་བྱས་ལ་ཤེས་པ་ཅི་ལ་ཡང་མི་གནས་པར་གཞག་གོ།",
    "ཁ་ཅིག་ལ་གོང་མ་བཞིན་དུ་བཞག་པས་དེ་མ་ཐག་ཏུ་ལྷན་གྱིས་གནས་ཤིང་མི་གཡོ་བར་འདུག་ཀྱང་ལུས་ཀྱང་ཡོད་པར་མི་ཚོར་བ་མི་འབྱུང་སྟེ།",
    "ཤེས་པ་འཕྲོ་ཞིང་འདུག་ཏུ་མི་འདོད་ན་ཡང་བསྒྲིམས་ཞིང་གཞག་ཀྱང་ཟ་ཟི་དང་།",
    "དབུགས་མི་བདེ་ཞིང་ཤེས་པ་གྱོང་སེ་འདུག་ལ།",
    "ནམ་མཁའ་ཧ་ཅང་མི་དཀར་བའི་ནང་ན་འདུག་པ་བཞིན་དུ་ཧ་ཅང་མི་གསལ་ལ་ལུས་ཡོད་པ་མི་ཚོར་བ་ཡིན་ནོ།",
    "བསྒྲིམས་པའི་སྟོབས་ཀྱིས་མི་འཕྲོ་བ་ཙམ་དུ་འདུག་པའི་ཉམས་ཞིག་བྱུང་ན་ཡུན་གོམ་པ་ཐ་མལ་པས་མདའ་རྒྱང་ཕྱེད་དུ་ཕྱིན་པ་ཙམ་ཞིག་བསྒོམས་ལ་ལྡང་ངོ།",
    "དེ་ནས་སྐྱེད་བྱུང་སྟེ་བསྒྲིམས་ན་སྙི་མུལ་གྱིས་འགྲོ་བ་འདུག་པས་བསྒྲིམས་མི་དགོས་སོ།་",
    "ཁ་ཅིག་ལ་སྔར་སྨོས་པ་བཞིན་དུ་སེམས་བཞག་པས་སྣ་ཚོགས་སུ་འཕྲོ་ཞིང་འདུག་ཏུ་མི་འདོད་དེ་ཤེས་པ་བསྒྲིབས་ནས་སླར་མི་བདེ་སྟེ།",
    "ཞི་གནས་ཆུང་བ་མེད་ཀྱང་ཡུན་རིང་དུ་གོམས་པར་མ་བྱས་པས་མུན་པ་ཧ་ཅང་གནག་པ་མ་ཡིན་པའི་ཚུལ་དུ་འདུག་པ་དང་།",
    "འདུག་པར་མི་འགྱུར་རོ།",
    "སྔར་རྒོད་པ་ལ་ཤིན་ཏུ་སྐྱོན་ཆེ་བར་བརྟགས་པའི་སྟོབས་ཀྱིས་༡་འཛིན་ཆེ་ཞིང་ཞི་གནས་ཀྱི་ཉུ་ཤས་ཆེ་བས་མཚན་མུན་ནག་བཞིན་དུ་འདུག་པ་དང་།",
    "ལུས་ཇི་ལྟར་འདུག་པ་མ་ཤེས་ཀྱང་།",
    "རྩུབ་ཅིང་བསྡོམས་ཐུཔ་སྙམ་བྱེད་ཅིང་བཤིག་པར་དཀའ་བ་ལྟ་བུར་འདུག་པའོ།",
    "ལྡང་བར་བསམས་ཙམ་ན་ལུས་བསྡམས་པ་བཞིན་དུ་འདུག་སྟེ།",
    "དངུལ་ལྕགས་ཀྱི་སྣོད་བྱང་མའི་འོག་ཏུ་ཆུ་གཙང་མས་བཀང་ནས་མི་གཡོ་བར་འདུག་པ་བཞིན་དུ་ཤེས་པ་དང་།",
    "སོས་དལ་བར་འདུག་གོ།",
    "ཡུད་ཙམ་ཞིག་གན་རྐྱལ་དུ་འདུག་དུཔའམ།",
    "ཚུར་འོང་བ་ལན་གཉིས་གསུམ་བཞི་ཙམ་བཅགས་ལ་ཡང་འདུག་པར་བྱ་སྟེ།",
    "དེ་ཡང་མི་རིགས་ཏེ་དེ་ལྟ་བུའི་དཔེ་མི་སྲིད་དོ།",
    "གཟུགས་བརྙན་ཉིད་ཀྱང་རང་བཞིན་མེད་པར་ནི་མ་བསྒྲུབས་ཏེ།",
    "འོན་ཏེ་ངའི་སེམས་འདུག་ཏུ་མི་འདོད་དོ།",
    "དོན་ལ་འདུག་ཏུ་མི་བཏུབ་པས་རྗོད་ཛྭཔར་བྱེད་པ་༨གོམས་པར་བྱས་ན་བརྗོད་བྱའི་དོན་ལན་ཅིག་མངོན་དུ་འགྱུར་རོ་ཞེས་ཁས་བླངས་པས་རྗོད་བྱེད་ཀྱི་མཐའ་ནི་ཡི་གེ་ཡིན་ཏེ།",
    "དཔེར་ན་ཁྱིམ་རྐ་ན་འདུག་པའི་གླང་དང་།",
    "ཞིང་ཐོག་ན་འདུག་པའི་གླང་ལྟ་བུའོ།",
    "གླང་གཅིག་ཁྱིམ་ན་འདུག་པ་དང་།",
    "ད་ཅིའི་སར་འདུག་ཅེས་མི་བྱའོ།",
    "དཔེར་ན་བྱ་དེ་རྒྱ་མཚོའི་མཐའ་བལྟས་པས་མ་མཐོང་སྟེ་འགྲོ་ས་མེད་ནས་འདུག་པ་དེ་བཞིན་དུ་བསམ་པའི་ཤེས་རབ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་བརྟགས་ནས་མ་མཐོང་བ་ལ་ཏིང་ངེ་འཛིན་གྱིས་གྲོགས་བྱས་ནས་དེ་ལས་མི་གཡོ་བར་ལྷན་ཥྤེ་ཡོད་ཀྱི་རྣམ་པར་ཤེས་པ་འདུག་པ་ཡིན་ནོ་ཝཱིཞེས་གསུངས་པ་ཡིན་ནོ།",
    "མཉམ་ན་ཇི་སྲིད་ནུས་ཀྱི་བར་དུ་འདུག་པ་ལས་འབད་པ་དང་།",
    "ཞེས་དཔྱད་ནས་རྣམ་པར་རྟོག་པ་མེད་ཅིང་བརྗོད་པ་མེད་པ་དང་གབྱུག་ཏུ་གྱུར་པའི་ཡིད་ཀྱིས་དེ་ཁོ་ན་བསྒོམ་ཞིང་ཇི་སྲིད་འདོད་པའི་བར་དུ་འདུག་པར་བྱ་བ་༤ལ་སོགས་པ་གསུངས་པ་དང་།",
    "རྣལ་འབྱོར་པ་དེ་ཁོ་ན་ཤིན་ཏུ་གསལ་བར་ངེས་པར་གཟུང་ཞིང་འདུག་པར་བྱའོ།",
    "སྟན་ཤིན་ཏུ་དམའ་བ་ལ་འདུག་ནས་བླ་གོས་ཕྲག་པ་གཅིག་ལ་གཟར་ཏེ།",
    "དེ་དག་ཀྱང་རྐྱེན་དག་ཡོད་ན་ཆ་མཉམ་པར་འགྱུར་བ་ཡིན་པར་མངོན་ཙ་ནོ།་།",
    "སེམས་སང་སང་པོར་འདུག་པའམ།་",
    "སྡོམ་པ་གཉི་ག་ལ་ཡང་རང་བཞིན་དང་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་མི་འདྲལ་བ་དང་།",
    "དེ་མ་ཐག་ཏུ་ས་ཕྱོགས་བྱེ་དོར་མ་བྱས་པ་ཞིག་ཏུ་འདུག་ནས་དང་བའི་སེམས་ཀྱིས་མིག་མི་འཛུམས་པར་བལྟས་ཤིང་རྡེ།",
    "ལུས་ལ་སྐྱོ་བ་བསྐྱེད་དེ་འདུག་པར་བྱའོ།",
    "བདག་ཅག་དུས་དང་དུས་མ་ཡིན་པ་ཐམས་ཅད་དུ་ཟ་བས་ལྷད་ཟན་ལས་མེད་ཀྱང་ཁམས་ཅིའི་ཕྱིར་མི་བརྟ།",
    "ས་གཅིག་ཏུ་ཡུན་ཧ་ཅང་རིང་བར་མི་འདུག།",
    "དེའི་སྐབས་སུ་མི་བརྩལ་བར་ལུས་དང་སེམས་ལ་མི་གནོད་ཙམ་དུ་བསྒོམ་ཞིང་འདུག་པར་བྱའོ།",
    "གཞན་ཕན་སྤོང་ཞིང་རང་དོན་ལྷུར་ལེན་པ།",
    "བདག་ཕྱིར་མ་ཡིན་འགྲོ་བའི་ཕྱིར་བརྩམས་པས།",
    "ལམ་འཇུག་དུས་དང་ནོར་དང་འབྲུ་རྣམས་སྡུད་ཟིཔ་དང་།",
    "དགའ་སྟོན་ཀུན་ན་འདུག་དང་དགོས་པ་སྒྲུབ་པ་ན།",
    "ལོ་ཟླ་ཞག་དུས་རུང་བ་མིན་པའི་སྐེག།",
    "ཡོངས་སུ་སྤངས་ནས་རང་རང་ལོངས་སྤྱོད་ཀྱིས།",
    "རང་རང་སོ་སོའི་མཚན་ཉིད་ཤེས་བྱེད་དུ་བཀོད་པས་ནི་མིང་དོན་གྱི་འབྲེལ་བ་གཞི་སོ་སོའི་སྟེང་དུ་ཤེས་པར་འགྱུར་ལ།",
    "ཉོན་ཡིད་ཀྱི་འཁོར་ན་ཡོད་པ་ནི་རང་རང་མཚན་ཉིད་པ་ཡིན་ཀྱང་།",
    "འདི་རྣམ་སྨིན་གྱི་རྒྱུ་ཡིན་བའི་ཚུལ་ཡང་རང་ལྡོག་ནས་འགྲུབ་བྱེད་ཀྱི་རྒྱུ་ཡིན་གྱི།",
    "ཁོ་རང་ཉིད་དེའི་དགག་བྱར་གྱུར་པའི་ཕྱིར་རོ།",
    "གོང་དུ་སྐྱེ་བའི་ཚེ་དང་རང་སར་སྐྱེ་བའི་ཚེ་ནི་མ་ཡིན་ཏེ།",
    "ཀུན་རྫོབ་ཏུ་བདེན་པ་ཡང་རང་ལུགས་ཀྱི་རིགས་པས་རྣམ་པར་བརྟགས་ནས་འཇོག་པ་ཡིན་གྱི།",
    "དེའི་སྤང་བྱ་སྐྱེ་འགག་དུས་མཉམ་པ་ལ་འཆད་པ་ནི།",
    "འདུས་མ་བྱས་པའི་ཤེས་བྱེད་ཀྱང་ལས་ཉོན་གྱིས་འདུག་མ་བྱས་པ་ལ་གསུངས་སོ།",
    "ཁོ་རང་ལ་ལྟོས་པའི་མཉམ་གཞག་ཡིན་ཀྱང་།",
    "མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "སྐྱེ་འགག་མེད་ཅིང་རང་བཞིན་གྱིས་ཞི་བར་གསུངས་པའི་དགོངས་པའོ།",
    "གོང་འཕོའི་སྐབས་སུ་འོག་མིན་འགྲོ་དང་།",
    "ཕས་ཀྱི་རྒོལ་བ་ཚར་གཅོད་ཅིང་རང་ཕྱོགས་གཞག་པའི་མཛད་པ་དང་།",
    "བཞི་པ་རྒོལ་བ་ཚར་གཅོད་ཅིང་རང་ཕྱོགས་གཞག་པ་ལ་གཉིས་ཏེ།",
    "ཀུན་རྫོབ་རང་རང་ངོ་བོས་སྟོང་པ་དང་།",
    "དང་རང་བཞིན་ཡོད་མེད་གསལ་བར་ཕྱེ་ནས།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་ཁོ་ནས་ཡིན་གྱི།",
    "སློབ་དཔོན་འདིས་ཐ་སྙད་དུ་ཡང་རང་རིག་ཁས་མི་ལེན་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་དག་སྣང་ངོ།",
