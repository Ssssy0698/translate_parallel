    "སེལ་ངོའི་ཤེས་བྱ་མཐའ་དག་ནི་སྐབས་འདིར་ཡང་ལྟོས་གྲུབ་དང་རང་སྟོང་དུ་ཁས་བླངས་པའི་ཕྱིར།",
    "གཉིས་པོ་གང་གཞལ་བྱར་བྱས་ཀྱང་རང་རིག་པ་འབྲས་བུར་འཇོག་པ་ནི་གོ་རིམ་བཞིན་དུ་རྣམ་བདེན་རྫུན་གྱི་།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "ཁྱེད་རང་ལྟར་ན།",
    "ཁྱེད་རང་ལྟར་ན་རྟགས་དངོས་འགལ་ལོ།",
    "དིང་སང་རང་བཟོའི་དགའ་མས་ཡིད་བསྲུབས་ཀྱི།",
    "གོ་རིམ་བཞིན་དུ་འབྲས་བུ་དང་རང་བཞིན་དང་༡ སྟེ་བཟས་ཟ་ཀ་ཀཀ་༥དམིགས་པའི་གཏན་ཚིགས་ཡང་དག་ཡིན་དགོས་པའི་ཕྱིར།",
    "ཞེས་བརྟགས་ན་ཉེས་པ་དེ་ཁྱེད་རང་ལ་མཚུངས་སོ་ཞེ་ན།",
    "ནས་ཀྱི་ས་བོན་དང་ས་ལུའི་ས་བོན་གཉིས་ཀ་དང་རང་བཞིན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "འབྲས་བུ་མི་སྐྱེད་པའི་གནས་སྐབས་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་སྨྲས་པ་ལ།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "དེའི་ལན་ལ་རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "སླར་ཡང་རང་ལུགས་བསྡུས་ཏེ་༡ བསྟན་པའོ།",
    "གང་རང་རིག་པ་འབྲས་བུར་འགྱུར་རོ།",
    "བློ་ཚུལ་གཉིས་པ་ཅན་ལ་སྒྲུབ་བྱེད་བཀོད་པའི་སྒོ་ནས་ཕྱི་དོན་མེད་ཀྱང་རང་རིག་འབྲས་བུར་བཞག་པའོ།",
    "སླར་ཡང་རང་རིག་པའི་སྒྲུབ་བྱེད།",
    "སླར་ཡང་རང་རིག་པའི་སྒྲུབ་བྱེད་ལ།",
    "སླར་ཡང་རང་མི་རིག་པའི་གནོད་བྱེད་ལ།",
    "བྱེ་བྲག་ཏུ་རང་རང་དེ་སྐོར་ཀྱི་ཕྱོགས་སྐྱོན་ཡིན་ཏེ།",
    "བརྒྱ་ལྔ་བཅུ་། ཕྱིར་། འདིར་ཡང་རང་བཞིན་རྟགས་དང་སྣང་རུང་མ་དམིགས་པའི་རྟགས་མི་འགལ་ཏེ་དགག་པའི་གཏན་ཚིགས་འགལ་བ་དེའི་ཚེ་བདག་མེད་བསྒྲུབ་པའི་རང་བཞིན་གྱི་གཏན་ཚིགས་ཡང་དག་དང་།",
    "ལུང་ཁོ་རང་མ་གཏོགས་པའི་ལུང་དེའི་དོན་རྟོགས་པའི་ཐབས་ཀྱི་སྒྲུབ་བྱེད་མེད་པའི་ཕྱིར།",
    "གང་ན་ཤིན་ལྐོག་སྟོན་པའི་ལུང་དང་རང་ཚིག་གོ།",
    "དེའི་ཚེ་ན་ཡང་རང་ཚིག་འགལ་བར་འགྱུར་བའི་ཕྱིར།",
    "ལུང་དང་རང་ཚིག་གཉིས་ལ་གཞུང་བཞིན་མེད་པས།",
    "འདི་ཡང་རང་ཉིད་ཅེས་པའི་ཚིག་ལས་དོན་གྱིས་གྲུབ་ཟིན་པ་མ་༢༨ ༢བས་བ་ཤཱཀ་མཆོག་བཀའ་འབུམ།",
    "རང་ཉིད་དང་རང་རྟེན་གྱི་སྒྲ་ཥགཉིས་མི་ཟློས་ཏེ།",
    "འདིའི་ཁས་བླངས་དང་རང་ཚིག་ཀྱང་བྱེ་བྲག་པའི་ངོར་གེགས་བྱེད་ཙམ་ཡིན་ཀྱང་།",
    "གཉིས་པ་ནི་དངོས་དང་རང་ལ་མཚུངས་པ་སྤང་བའོ།",
    "རང་རང་ཐུགས་ཀྱི་མཁྱེན་རབ་གཅིག་བསྡུས་ནས།",
    "ཁྱེད་རང་ལྟར་ན།",
    "ཁྱེད་རང་འདོད་པའི་སྤྱི་དེ་གང་ལ་བྱེད།",
    "ཞེན་པའི་བརྗོད་བྱ་བ་ལང་རང་མཚན་ལ་འཇུག་པར་དོན་མཚུངས་པའི་ཕྱིར།",
    "ཤིང་རང་མཚན་སྒྲུབ་པའི་ནུས་པ་རྣམ་པ་གཉིས་ཡོད་དེ།",
    "འཇུག་པའི་ཚེ་ནི་དོན་སྤྱི་དང་རང་མཚན་གྱི་ཕྱེ་བསལ་མེད་པར།",
    "རིགས་དང་རང་མཚན་སོ་སོ་ལ།",
    "ཨ་། སྤྱི་དང་རང་མཚན་མ་ཕྱེ་བའི།",
    "འཇུག་པའི་ཚེ་སྤྱི་དང་རང་མཚན་མ་ཕྱེ་བར་གཅིག་ཏུ་འཁྲུལ་པ་ལ་བརྡ་སྦྱར་བས་འཇུག་ཡུལ་ཐོབ་པའི་ཐབས་སུ་བྱེད་པས་སོ།",
    "བརྡ་ཡི་དུས་ན་དོན་སྤྱི་དང་རང་མཚན་བསྲེས་ནས་བརྡ་སྦྱར་ལ།",
    "གཞན་སེལ་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བར།",
    "བུམ་པ་རང་གྲུབ་ཙ་ནས་འཇིག་ངེས་སུ་སྒྲུབ་པ་འདི་ཡང་ཁྱབ་པ་མ་ངེས་སོ་ལོ།",
    "འཇིག་ཀྱང་རང་གྲུབ་ཙམ་ནས་འཇིག་ངེས་ཡིན་པར་འདོད་པ་སྟེ།",
    "མེ་དུ་དང་བྱས་མི་རྟག་ལྟ་བུའི་དོན་སྤྱི་དང་རང་མཚན་གྱི་དངོས་པོ་གཅིག་ཉིད་དུ་འཁྲུལ་པས་གཅིག་ཏུ་བཟུང་ཞིང་།",
    "ངོ་བོ་གནོད་པའི་ལྡོག་དུས་དང་།",
    "རྒྱུས་གནོད་པའི་ལྡོག་དུས་དང་།",
    "གང་རང་དུས་ཀྱི་སྐད་ཅིག་གསུམ་པར།",
    "དོན་གྱི་འགལ་བ་༣༩ལྡོག་དུས་ལ་རྩོད་པ་སྤང་བ་དང་།",
    "བློའི་འགལ་བ་ལྡོག་དུས་ལ་རྩོད་པ་སྤང་བའོ།",
    "སེར་པོ་མ་ཡིན་པའི་སྒྲུབ་བྱེད་དུ་སྔོན་པོ་ཡིན་པ་སོགས་འགོད་པ་ནི་དགག་པ་གཏན་ཚིགས་ལས་འོས་མི་འདུག་པས།",
    "རང་རང་ལྡན་པའི་མཚན་གཞི་ཡི།",
    "འདི་རང་མཚན་དང་བརྒྱུད་ནས་འབྲེལ་པས་ཕྱིས་དེ་འཐོབ་པ་སྲིད་ཀྱང་ཁོ་རང་རང་མཚན་དེ་ཡོངས་སུ་གཅོད་བྱེད་དུ་མེད་པས་འཐོབ་པའི་ནུས་པ་དང་འབྲེལ་བ་མ་ཡིན་ཞེས་པའོ།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "རང་རིག་དང་རང་སྐྱེ་གཉིས་མཚུངས་པའི་གོ་སྐབས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་གཞན་ལ་བརྗོད་པའི་ཉེས་པ་སོ་ན་འདུག་པའི་ཕྱིར་དེས་ན་གཞུང་འདི་ལྟར།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "རང་རང་སྐབས་སུ་དངོས་མིང་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཡང་དག་ཡིན་ཞེས་ལན་དུ་མར་གསུངས་པ་རྣམས་ཀྱི་དོན་ལ་བསམ་པར་བྱའོ།",
    "ལུང་དང་རང་ཚིག་དང་འགལ་བ་གཉིས་ཀ་ཡང་།",
    "གང་ན་འདུག་པའི་གནས་དེར་མ་འབྲེལ་བས་གོང་དུ།",
    "མི་སྨྲ་བར་འདུག་པ་དང་།",
    "དེ་དང་རང་ཚིག་འགལ་བ་རྣམས་སོ།",
    "སུན་འབྱིན་དུ་གྱུར་པའི་སྒྲུབ་ངག་ཡང་དག་འདུག་པའི་ཕྱིར་ན།",
    "ཀུན་ཀྱང་རང་རང་ཀུན་རྫོབ་ནི།",
    "ཞི་ཞིང་གཅེར་བུར་འདུག་པ་དང་།",
    "འཇིག་དུས་ཆེན་པོའི་མེ་དང་མཚུངས།",
    "ཀུན་སློང་རང་དོན་དུ་རང་དགར་འཆང་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དོན་དུ་ལེན་འདོད་དང་།",
    "ཀུན་སློང་རང་དོན་དུ་སློང་བར་འདོད་པ་དང་།",
    "ཀུན་སློང་རང་དོན་དུ་ཁྱིམ་པ་གཅིག་ལ་གོས་ཟུང་གཅིག་ལས་ལྷག་པ་སློང་བར་འདོད་པ་དང་།",
    "ཀུན་སློང་རང་ལ་མ་ཕུལ་གོང་དུ་སློང་འདོད་པ་དང་།",
    "ཀུན་སློང་རང་དོན་དུ་གླིངས་པའམ་ནང་ཚངས་ཅན་ཀྱི་སྟན་བྱེད་འདོད་དང་།",
    "ཀུན་སློང་རང་དོན་དུ་འཁུར་འདོད་དང་།",
    "ཀུན་སློང་རང་དོན་ཁོ་ནའི་ཆེད་དང་།",
    "ཀུན་སློང་རང་དོན་དུ་ལྷུང་བཟེད་ལྷག་པོ་ཚོལ་བར་འདོད་པ་དང་།",
    "ཀུན་སློང་རང་དོན་དུ་འཐག་པ་བསྐྱེད་འདོད་རྒྱུན་མ་ཆད་པ་དང་།",
    "མཐར་ཐུག་དུས་དེར་ཐོབ་པའོ།",
    "དམག་དང་ཆོམ་རྐུན་སོགས་ཀྱི་གནོད་པ་མ་ཡིན་པར་གཙུག་ལག་ཁང་རང་དགར་མི་འདོར་ཞིང་།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "ཨ་ར་པ་ཙ་ན་ཡ་ཏེ་ན་མ",
    "བསྟན་པའི་སྒྲོན་མེར་གྱུར་མ་དཔལ་ལྡན་ས་སྐྱར་ཐོརངས་མཉམ་གཞག་དུས།",
    "ཐཅིག་ཡུད་ཙམ་དལ་བར་མི་འདུག་པར།",
    "སྨྲ་བའི་སེང་གེ་དམ་པ་དེ་ལ་འདུག།",
    "འོན་ཀྱང་རང་རྒྱུད་དག་དང་མ་དག་པ་། ལས།",
    "སྣང་སྟོང་རང་བཞིན་གཅིག་མིན་ཐ་དད་མིན།",
    "དལ་འབྱོར་མི་ལུས་སྟོང་ལོག་བྱེད་ཉེན་གདའོ།",
    "འཇིགས་རུང་ངན་འགྲོའི་གཡུང་དར་འཆོར་ཉན་གདའོ།",
    "ཁས་བླངས་ཐོག་ཏུ་ཁེལ་བ་མི་གདའོ།",
    "ཁས་ལེན་ཆེ་ལ་ཉམས་ལེན་ཞན་པར་གདའ།",
