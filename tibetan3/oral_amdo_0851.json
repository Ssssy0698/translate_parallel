    "༥༢བསྡུར་འབྲས་རེའུ་མིག་༥༤༣༣༡༤ གསང་བ་རྡོ་རྗེའི་རྒྱུད་ཀྱི་རྒྱལ་པོའི་འགྲེལ་པ།་",
    "༥༨༥བསྡུར་འབྲས་རེའུ་མིག་༥༨༨༣༡༥ དཔལ་རྡོ་རྗེ་མཁའ་འགྲོ་རྒྱུད་ཀྱི་དེ་ཁོ་ན་ཉིད་རབ་ཏུ་བརྟན་པར་བྱེད་པ་ཞེས་བྱ་བའི་དཀའ་འགྲེལ།་",
    "༦༢༤བསྡུར་འབྲས་རེའུ་མིག་༦༢༧༣༡༦ དཔལ་གསང་ཆེན་པདྨ་ཞེས་བྱ་བའི་རྒྱ་ཆེར་འགྲེལ་པ།་",
    "༦༨༥བསྡུར་འབྲས་རེའུ་མིག་༦༩རྒྱུད།",
    "སྤྱོ་བཀ་པ་ཐག་ཅེསཐག་ངབ་་༦༩༣རྒྱུད་ཀྱི་རྣམ་པར་གཞག་པ་དང་དེ་བཞིན་དུ་དགོས་པ་ལ་སོགས་པ་རྣམ་པ་བདུན་རྣམས་ཀྱིས་ཡན་ལག་བཅུ་བདུན་རྣམས་ནི་འདི་སྐད་བདག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "རེརྭབསྡོན་སྣེ།་",
    "བཅོམ་ལྡན་འདས་ཡང་དག་པའི་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པའི་སྒྲུབ་པའི་ཐབས་ཀྱི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་རྣམས་ཀྱི་སྐྱེ་བ་ལ་སོགས་པ་སྣ་ཚོགས་པའི་མན་ངག་འཆད་པའི་རྣམ་པར་གཞག་པ་རྒྱས་ང་།",
    "རྣམ་པར་སྣང་མཛད་དང་དེ་བཞིན་དུ་གཤིན་རྗེ་མའི་གོ་ཆའི་སྔགས་ཀྱི་སྒོ་ནས་སྣ་ཚོགས་པའི་གདམས་ངག་གི་རྣམ་པར་གཞག་པ་དུས་ཚོད་ལ་སོགས་པ་མིང་ལ་སོགས་པའི་ཡི་གེ་ལས་བསྐྱེད་པའི་མིང་རྣམས་སུ་རྫོགས་ལྡན་གྱི་དུས་ལ་ཐམས་ཅད་ཀྱི་དུས་སུ་རབ་ཏུ་གཞག་པའི་ཆོ་གའི་མཚན་ཉིད་རྒྱས་པར་ཚོབ།",
    "རབ་ཏུ་གཏུམ་མོས་བདག་པོ་བྱས་པའི་རྡོ་རྗེ་འཁོར་ལོའི་རྣལ་འབྱོར་མ་དང་དཔའ་བོ་རྣམས་ཀྱི་ཕྱག་རྒྱ་དང་བརྡ་ཡིས་གནས་པའི་མཚན་ཉིད་ཀྱི་ཆོ་ག་དང་།",
    "དེ་བཞིན་དུ་མིང་གི་ཡི་གེ་རྣམས་ཀྱི་རྣམ་པར་གཞག་པ་དང་དཀྱིལ་འཁོར་གྱི་བདག་པོའི་རང་བཞིན་དང་གནས་ལ་སོགས་པ་གང་བའི་རི་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱིས་ཀུན་དུ་སྤྱོད་པ་བསྟན་པ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའི་མཚན་ཉིད་ཀྱི་ཆོ་གའི་རང་བཞིན་རྒྱས་པར་བསྟན་པ་།",
    "སྣ་ཆེན་པོའི་བརྡའི་ཆོ་གའི་མཚན་ཉིད་དང་མིང་གི་ཡི་གེ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་དང་།",
    "དཔལ་བོའི་བློ་གྲོས་མའི་རང་བཞིན་གྱི་སྤྱི་གཙུག་ལ་སོགས་པའི་ཕྱག་རྒྱ་དང་ཕྱག་རྒྱའི་ལན་བསྟན་པའི་ཆོ་གའི་མཚན་ཉིད་དང་མིང་གི་སྐབས་རྣམས་སུ་དཔའ་བོའི་བློ་གྲོས་མ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་དང་དཀྱིལ་འཁོར་གྱི་བདག་པོར་དེའི་རང་བཞིན་གྱི་མན་ངག་གི་མཚན་ཉིད་དང་ཀུན་དུ་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་རྩ་བའི་སྔགས་དང་དེ་བཞིན་དུ་ཤིན་ཏུ་བཟང་མོའི་རྩ་བའི་སྔགས་གཉིས་སུ་མེད་པའི་སྦྱོར་བའི་བདག་ཉིད་དང་མིང་གི་ཡི་གེ་རྣམས་དང་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་བདག་པོ་དང་ལས་ཀྱི་ཚོགས་ཀྱི་མཚམས་སྦྱོར་གྱི་སྐད་ཅིག་གིས་བསད་པ་ལ་སོགས་པས་དང་ཀླུ་དགུག་པ་ལ་སོགས་པས་དང་རྟའི་འཁྲུལ་འཁོར་གྱི་ཆོ་གའི་མཚན་ཉིད་རྒྱས་པར་བསྟན་པ་༡༢༤༣ལེའུ་བཞི་བཅུ་པ།",
    "འཁོར་ལོའི་གོ་ཆ་མའི་མིང་གི་ཡི་གེ་ལ་སོགས་པའི་རབ་ཏུ་སྦྱོར་བས་ལྐུགས་པར་བྱ་བ་དང་སྣ་ཚོགས་པའི་མན་ངག་གི་རབ་ཏུ་སྦྱོར་བའི་ཆོ་གའི་མཚན་ཉིད་དང་།",
    "མིང་གི་ཡི་གེའི་རབ་ཏུ་སྦྱོར་བའི་མན་ངན་གི་སྒྲུབ་པའི་ཐབས་དང་དེ་བཞིན་དུ་ཁམས་ཀྱི་རྩ་འཕྱང་བ་ལ་ནི་ཉི་ཤུ་རྩ་བཞིའི་ཁམས་ཀྱི་དཔའ་བོ་རྣམས་ཀྱི་དབྱེ་བས་རྣམ་པར་ཤེས་པར་འཇུག་པ་དང་།",
    "ནང་གི་བདག་ཉིད་ཀྱི་སྦྱིན་སྲེག་དང་འཁྲུལ་འཁོར་གྱི་འཁོར་ལོ་རྩ་བའི་སྔགས་ཀྱི་ཆོ་བ།",
    "ཐོད་པའི་དུམ་བུ་ལ་སོགས་པ་དཔའ་བོ་ཉི་ཤུ་རྩ་ལྔའི་རང་གི་མིང་སྔོན་དུ་སོང་བས་དེ་ཁོ་ན་ཉི་ཤུ་རྩ་ལྔའི་རྣམ་པར་བཞག་པ་དང་སྣ་ཚོགས་པའི་ལས་ཀྱི་ཚོགས་རྣམས་དང་མན་ངག་སྣ་ཚོགས་པའི་དབྱེ་བ་དང་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སེམས་བསྐྱེད་པ་དང་རྒྱུད་ཐམས་ཅད་ཀྱི་དོན་སྟོན་པ་པོ་ཉིད་པས་དེའི་དགོངས་པ་འགྲུབ་པའི་ཆོ་གའི་མཚན་ཉིད་ཀྱི་སྐབས་ཐམས་ཅད་གསང་བའི་ཆོ་ག་ཅེནབ་ཐབ་སྦྱོ་ཐབ་ང་ཟང་ང་།",
    "དཔལ་ཐམས་ཅད་གསང་བའི་ལེའུ་ལྔ་བཅུ་པ་ལས་སྟོབས་པོ་ཆེའི་རབ་ཏུ་སྦྱོར་བས་རྣལ་འབྱོར་གྱི་ལུས་ལ་སོགས་པའི་ཁམས་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་སྦྱིན་སྲེག་གི་ཆོ་གའི་མཚན་ཉིད་རྒྱས་པར་བསྟན་པ།་",
    "༡༤༣༡བསྡུར་འབྲས་རེའུ་མིག་༡༤༨༡",
    "དཀར་ཆག་གི་ཟུར་མཆན།",
    "སྐད་ཅིག་གིས་ནི་གསལ་མཛད་པ།",
    "གང་ཡིན་དེ་འདིར་བདག་གིས་ནི།",
    "བདག་གིས་བྲི་བར་མི་ནུས་ཀྱང་།",
    "གསང་བ་མཆོག་གི་ཞེས་བྱ་བ་ནས།",
    "ཅེས་བྱ་བ་ནི་བར་གྱི་ཚིག་རྣམས་དང་པོར་སྡུད་པར་བྱེད་པ་རྡོ་རྗེ་ཕག་མོས་གསུངས་ཏེ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཉིད་འཆད་པ་པོ་ལ་སོགས་པར་གནས་མོད་ཀྱི།",
    "གསང་བ་མཆོག་གི་དགྱེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གསང་བ་མཆོག་གིས་དགྱེས་པར་བཞུགས་ནས།",
    "བཅོམ་ལྡན་འདས་མ་རྡོ་རྗེ་ཕག་མོ་བདག་ཉིད་ཀྱི་རང་བཟོ་སྤོང་བར་མཛད་ཅིང་འདི་ལྟར་བཅོམ་ལྡན་འདས་ལས་ཐོས་ནས་རྒྱུད་བསྡུས།",
    "དེ་དག་གིས་ནི་གནས་ཕུན་སུམ་ཚོགས་པ་བསྟན་ཏོ།",
    "མཁའ་འགྲོ་ཀུན་གྱེ་སྒྲས་ནི་རབ་ཏུ་གཏུམ་མོ་ལ་སོགས་པའི་ལྷ་མོ་ལ་བྱ་ལ་དེ་རྣམས་ཀྱི་རང་བཞིན་གང་ལ་ཡོད་པ་དེ་མཁའ་འགྲོ་ཀུན་གྱི་དངོས་སོ།",
    "དེ་ལྟ་མོད་ཀྱི་བདེ་བའི་དོན་དུ་ཐབས་སྣ་ཚོགས་དོན་དུ་གཉེར་བས་བདེ་བ་ལས་གཞན་པའི་བསྒྲུབ་པར་བྱ་བ་གཞན་ཡོད་པ་མ་ཡིན་ལ།",
    "ཅི་རང་གི་རྐྱེན་ཅན་དུ་བྱས་པས་གསལ་ཞིང་རིག་པ་དང་སྤྲུལ་པ་རྒྱས་པར་བྱེད་པས་ན་ལྷ་སྟེ།",
    "ཡང་ན་མཁའ་འགྲོ་ཀུན་གྱི་ཚིག་གིས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ལ་བྱ་སྟེ།",
    "ཟླ་བ་ལ་སོགས་པ་ཡོངས་སུ་གྱུར་པ་ལས་རང་གི་ལྷར་བསྒོམས་ལ།",
    "ཕོའི་དོན་ལ་མ་ནིང་གི་རྟགས་སུ་གསུངས་པ་ནི་ལུང་སྟེ།",
    "བུད་མེད་ཆགས་པ་སྐྱེས་པ་སྡང་།",
    "ཆགས་པ་རྣམ་དག་བུད་མེད་དེ།",
    "སྐྱེས་པ་བུད་མེད་བརྟུལ་ཞུགས་ཡིན།",
    "རང་བཞིན་གྱིས་བརྟན་པར་སྟོན་པའི་ཚིག་གི་ཕྲད་དོ།",
    "དེ་ཉིད་བུད་མེད་ཀྱི་གཟུགས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་བུད་མེད་ཀུན་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བུད་མེད་ཀུན་ནི་ལྷ་མོ་ཐམས་ཅད་དོ།",
    "དེ་དག་གི་སྒྱུ་མ་ནི་རང་བཞིན་ཏེ།",
    "རིགས་ཀྱིས་ན་མང་པོ་ལ་གཅིག་གི་ཚིག་ཏུ་བྱས་པ་ཡིན་ནོ།",
    "དེ་དག་གིས་བཅོམ་ལྡན་འདས་དེ་ཉིད་བདེ་བས་བདེ་བ་ཆེན་པོ་སྒྲུབ་ཅིང་རྟོགས་པར་བྱ་བའི་ཕྱིར་བུད་མེད་ཀྱི་གཟུགས་སུ་སྤྲུལ་པར་སྟོན་ཏོ།",
    "བུད་མེད་ཀུན་གྱི་སྒྱུ་མའི་ཕྱག་རྒྱ་དེ་ཉིད་ཀུན་རྫོབ་དང་དོན་དམ་པའི་ཚུལ་གྱི་ཕྱག་རྒྱ་དབྱེར་མེད་པ་ནི་གཉིས་མེད་དེ་དེ་ཉིད་ཕུལ་དུ་བྱུང་བའི་ཡེ་ཤེས་པས་ན་ཡེ་ཤེས་མཆོག་གོ།",
    "རྙེད་དང་བདེ་བ་ཀུན་མོས་པས།",
    "ཀུན་མོས་པས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མོས་པ་ནི་ཕུལ་དུ་བྱུང་བ་སྟེ།",
    "ངན་པར་སྤྱོད་པ་ཞེས་བྱ་བ་ལ་སྨད་པས་ན་ངན་པ་སྟེ་ཉོན་མོངས་པ་རྣམས་སོ།",
    "སྒྲུབ་པ་པོ་གང་གི་རང་བཞིན་ཉོན་མོངས་པ་བདོ་བ་ཡིན་ཀྱང་དེ་དག་ལ་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་དོན་དམ་པའི་ཡེ་ཤེས་ཀྱི་དངོས་གྲུབ་སྟེར་བར་འགྱུར་བའོ།",
    "འང་ཞེས་བྱ་བའི་སྒྲས་ནི་རྣལ་འབྱོར་མ་རྣམས་ལ་ཡང་དེ་དག་གིས་དོན་དམ་པའི་ཡེ་ཤེས་སྟེར་བར་འགྱུར་རོ་ཞེས་བལྟ་བར་བྱ་བ་ཊྭཱ་སྟེ།",
    "བུད་མེད་དག་ཀྱང་ཚེགས་མེད་པར་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "ལྷ་མོ་རྣམས་ཀྱི་ཐ་སྙད་གཞན་ཀྱི་སྒོ་ནས་དེ་ཁོ་ན་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ནམ་མཁའ་ཀུན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།་",
    "རིགས་ཀྱིས་ན་གཅིག་གི་ཚིག་ཏུ་བལྟ་བར་བྱ་སྟེ།",
    "ཡང་ན་མཁའ་འགྲོ་མ་ཞེས་བྱ་བ་ནི་གང་དག་གི་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱིས་ཁྱབ་པར་འགྲོ་བའི་ངང་ཚུལ་ཅན་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "ཁ་ཅིག་ནི་བརྡ་འདི་ནི་ཐ་མལ་པའི་བུད་མེད་རྣམས་ཀྱི་ཡིན་ཏེ།",
    "དེས་འདི་སྐད་དུ་རབ་ཏུ་གཏུམ་མོ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས།",
    "འཁོར་ལོས་སྒྱུར་བ་དྲུག་གི་རིམ་ཀྱིས་བལྟ་བར་བྱའོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "ཐ་མལ་པའི་བུ་མོ་རྣམས་ལྷ་མོའི་གཟུགས་ཀྱིས་ཁྱད་པར་དུ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟ་བུ་ཞིག་གིས་ཤེ་ན།",
    "རྡོ་རྗེ་འཛིན་པ་ལ་སོགས་པ་གཞན་ཡང་རང་རང་གི་འཁོར་གྱི་མཁའ་འགྲོ་མའི་ཚོགས་དང་ལྷན་ཅིག་ཏུ་འགྲུབ་པ་སྟེ།",
    "སྐྱེ་བ་མིན་ཞེས་བྱ་བ་ནི་དེ་དག་གིས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་འགྲུབ་པར་མི་འགྱུར་བའོ།",
    "འོ་ན་གང་གིས་འགྲུབ་པར་འགྱུར་ཞེ་ན།",
    "རང་གི་ལྷའི་གཟུགས་ཀྱིས་ཕྱག་རྒྱ་ཆེན་པོ་རྫོགས་པར་འགྱུར་ཏེ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་དེ་ལྟ་བུར་གྱུར་པའི་བཅོམ་ལྡན་འདས་ནི་བརྗོད་པར་བྱ་བ་ཡིན་ལ་བརྗོད་པར་བྱ་བ་ཤེས་ནས་མངོན་སུམ་དུ་བྱེད་པ་ནི་དགོས་པ་ཡིན་ཏེ།",
    "རང་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེས་ནི་བདག་གི་དོན་ཕུན་སུམ་ཚོགས་པ་བསྟན་ནས།",
    "ནམ་མཁའ་ཞེས་བྱ་བ་ནི་གང་གི་མཚན་ཉིད་རང་བཞིན་མེད་པའི་ངང་ཚུལ་ཅན་དེ་དག་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "གང་དག་གི་ཞེ་ན།",
    "ཇི་ལྟར་ནམ་མཁའ་ཐོགས་པར་བྱེད་པའི་རེག་བྱ་དང་བྲལ་བའི་མཚན་ཉིད་ཙམ་ཡིན་པས་ན་མཚན་ཉིད་མེད་པ་ཡིན་ཏེ།",
    "མཐོང་བ་ཞེས་བྱ་བ་ནི་ཉམས་སུ་སྩོང་བ་ཙམ་མོ།",
    "རེག་པའི་དངོས་ཞེས་བྱ་སྟེ།",
    "དེ་དག་གི་རྣམ་པའི་དབྱེ་བ་ཐམས་ཅད་སྣང་མོད་ཀྱི།",
    "གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེ་དག་གང་གིས་ཞེས་བྱ་བ་ནི་དངོས་པོའི་ཆ་ཕྲ་མོ་ཙམ་གྱིས་ཏེ།",
    "དེས་ཞེས་བྱ་བ་ནི་དངོས་པོའི་ཆ་ཕྲ་མོ་ཙམ་དེས་ཞེས་བྱ་བར་དགོངས་སོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་འབའ་ཞིག་གིས་སོ།",
    "འདའ་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་ཙམ་ཡང་མེད་པར་མྱ་ངན་ལས་འདའ་བའོ།",
    "གང་གི་ཚེ་མར་གྱི་རྒྱུན་ཟད་པ་དེའི་ཚེ་དེ་ཉིད་དུ་ཟད་ཅིང་གཏུགས་པར་གྱུར་པ་བདག་ཉིད་ཀྱང་མི་སྣང་ན་གཞན་སྣང་བར་བྱེད་པ་ལྟ་ཅི་སྨོས་ཏེ།",
    "དེ་བཞིན་དུ་སྟོང་པ་ཉིད་འབའ་ཞིག་གི་ཏིང་ངེ་འཛིན་ཡང་བལྟ་བར་བྱའོ།",
    "སྒྱུ་མ་ལྟ་བུའི་སྦྱོར་བ་དེ་ཉིད་འཁོར་ལོས་སྒྱུར་བ་དྲུག་གི་བྱེ་བྲག་གིས་བསྟན་པའི་ཕྱིར་གཟུགས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྡང་བ་དང་གཏི་མུག་གི་བདག་ཉིད་དོ།",
    "སྒྱུ་མ་ཆེན་མོའི་རང་བཞིན་ནི་སྒྱུ་འཕྲུལ་ཆེན་མོའི་བདག་ཉིད་དེ།",
    "དེའི་བདག་ཉིད་ཀྱིས་ཉོན་མོངས་པ་དང་བྲལ་བས་ཆགས་བྲལ་ཡིན་ལ།",
    "འགུགས་མ་ནི་དགའ་བ་དང་མེའི་ཁམས་ཀྱི་རང་བཞིན་གོས་དཀར་མོ་སྟེ།",
    "ཉོན་མོངས་པ་སྐེམ་རྒྱཔའི་ཕྲིན་ལས་གཉིས་མཛད་པའི་ཕྱིར་རོ།",
    "རྡོ་རྗེ་གཙོ་མོར་དུ་གནས་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་དང་ལྷན་ཅིག་དབྱེར་མེད་པར་གནས་པའི་ཕྱིར་རོ།",
    "སྟོང་པའི་ཚུལ་གྱི་མིག་གིས་ཞེས་བྱ་བ་ནི་དེར་དམིགས་པའི་སེམས་ཀྱིས་སོ།",
    "དེ་བཞིན་དུ་གཉིས་པར་ནི་ཀ་ལ་སོགས་པ་ཞུགས་པར་བསྒོམ་མོ།",
    "ཟླ་བའི་སྟེང་གི་ཐོད་པ་ལ་ཕྱེད་ཀྲུང་བཅས་པའི་གར་གྱིས་བཞུགས་པ།",
    "དེར་ཧཱུཾ་གི་ས་བོན་ལས་བྱུང་བའི་རྡོ་རྗེ་ལྟེ་བར་ཧཱུཾ་གིས་བྱིན་གྱིས་བརླབས་པར་བསྒོམས་ནས།",
    "བདག་ཉིད་རྡོ་རྗེ་ཙམ་དུ་མོས་ནས།",
    "རང་གི་སེམས་ཀྱི་རྟོག་པ་ཙམ་གྱིས་ལངས་ཏེ།",
    "ཞེས་བྱ་བས་ལྟེ་བར་རྡོ་རྗེ་ཕག་མོ།",
    "ཨོཾ་ཧཱུཾ་ཧཱུཾ་གིས་སྤྱི་གཙུག་ཏུ་སྐྲག་བྱེད་མ།",
    "ཨོཾ་ཕཊ་ཕཊ་ཀྱིས་ཡན་ལག་ཐམས་ཅད་ལ་མཚོན་ཆར་གཏུམ་མོ་བསམ་པར་བྱ་སྟེ།",
    "མེ་ནི་གོས་དཀར་མོ།",
    "རང་གི་ལུས་ཀྱི་འོད་ལས་སྤྲོས་པའི་མཁའ་འགྲོ་མ་རྣམས་ཀྱིས་དེ་བཞིན་གཤེགས་པ་རྣམས་བཀུག་ནས།",
    "དེ་ལ་ཤར་ཕྱོགས་ཀྱི་ཐོད་པའི་ཟླ་བའི་ཧཱུཾ་ལས་བྱུང་བའི་ཁ་དོག་དཀར་ཞིང་ཞི་བ་གཡས་ལ་སོགས་པའི་ཕྱག་བཞིས་འཁོར་ལོ་དང་དྲིལ་བུ་དང་ཐོད་པ་དང་ཞགས་པ་བསྣམས་པའི་རྣམ་པར་སྣང་མཛད་བསྒོམ་མོ།",
    "དེ་ནས་རིམ་པ་གཉིས་པའི་ཤར་དུ་ཨོཾ་ལས་བྱུང་བའི་རྡོ་རྗེ་དྲག་མོ་ཕྱག་བཞིས་མདའ་དང་།",
    "ཁུ་བས་གང་བའི་ཐོད་པ་བསྣམས་པར་བསམ་མོ།",
    "ཁྲག་གིས་གང་བའི་ཐོད་པ་བསྣམས་པའོ།",
    "རྔེའུ་ཆུང་བསྣམས་པར་བསམ་མོམེ་མཚམས་སུ་ཁྲུ་ལས་བྱུང་བའི་རྡོ་རྗེ་མཁའ་འགྲོ་མ་ཕྱག་བཞི་ན་པདྨ་དང་།",
    "ཁྲག་གིས་གང་བའི་ཐོད་པ་བསྣམས་པའོ།",
    "རིམ་པ་གསུམ་པའི་ཤར་ཕྱོགས་སུ་རྀ་ལས་བྱུང་བའི་སྒེག་མོ་ལག་པ་གཡོན་པ་དཀུར་བཙུགས་ཤིང་གཡས་པ་གར་ཐབས་སུ་བསྐྱོད་པའོ།་།",
