    "ལྷ་མོ་ཕྱི་སྒྲུབ་ཀྱི་རྒྱ་གཞུང་གི་འགྲེལ་པ་ལག་ལེན་མ་ཤིན་ཏུ་ཟབ་པ།",
    "ཟབ་མོ།",
    "དྲག་མོ་རྐང་ཐང་རྣོ་བའི་མདེའུ་ཧ་ལ་རེག་ཆོད་ཅེས་བྱ་བ།",
    "མཁས་པ་གདན་སར་མཁན་ཨ་མ་པ་བམ་མམས་ལ་ལ་ལས་དེབ་དགུ་བའི་དཀར་ཆག་རྔོག་ཐོགས་མེད་གྲགས་ཀྱི་གསུང་།",
    "དཔལ་གདན་བཞི་པ་ཁྲི་ཉིས་སྟོང་པ་ལྭ་བ་པའི་རྒྱུད་ལེའུ་བཅུ་དྲུག་པའི་རྣམ་པར་འགྲེལ་པ་ཡང་དག་པར་གཟིགས་པ།",
    "དཔལ་གདན་བཞི་པའི་ཞི་བ་དང་རྒྱས་པའི་སྦྱིན་བསྲེག་གི་ཆོ་ག་སྒྱུ་འཕྲུལ་ཆེན་མོའི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་དཔལ་སྒྱུ་འཕྲུལ་ཆེན་མོའི་སྒྲུབ་ཐབས།",
    "དཔལ་སྒྱུ་འཕྲུལ་ཆེན་མོའི་བསྟོད་པ།",
    "སྒྱུ་འཕྲུལ་ཆེན་མོའི་འགྲེལ་པ་ཉི་མའི་འོད་ཟེར།",
    "དཔལ་ལྡན་དུད་སོལ་མའི་ཕྱི་སྒྲུབ་ཀྱི་རྗེས་གནང་གི་ཡི་གེ་རྒྱས་པ།",
    "དཔལ་ལྡན་ལྷ་མོ་དུད་སོལ་མའི་ཐུན་མོང་མ་ཡིན་པའི་རྗེས་གནང་གི་ཡི་གེ་རྒྱས་པ།",
    "དཔལ་ལྡན་ལྷ་མོའི་ཇ་གླིང་མ།",
    "དཔལ་ལྡན་དུད་སོལ་ལྷ་མོའི་བསྐང་བ།",
    "བདག་མེད་ལྷ་མོ་བཅོ་ལྔའི་སྒྲུབ་ཐབས།",
    "ཚེའུ་བནྡེ་དར་རེའི་གསུང་།",
    "བདེ་མཆོག་གི་མངོན་རྟོགས་གསལ་བྱེད།",
    "བཅོམ་ལྡན་འདས་དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་གསལ་བྱེད་སྒྲོན་མ",
    "དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་རྒྱུད་ཀྱི་རྒྱལ་པོ་མཁའ་འགྲོ་མ་ཀུན་ཏུ་སྤྱོད་པ།",
    "བ་་ཤུཙམ་པའི་ཤུབབ་ཀྱི་འ་ཐེངས་པོ་རྒྱུད་ཀྱི་རྒྱུ་པ་པོའི་རྒྱ་ཆ་༢༥འགྲུལ་པ་དྲི་བ་ཕེབསྟན་པའི་འོད་སྟེང་འབྲེམད་ཐབྱ་བད་ཉིས་པ་ཀྱི་ཡི་གེ་རྣམས་ཀྱི་དང་པོར་པས་ཡིག་ལ་བོད་པ་དེ་ནི་ས་ལ་གི་པ་ལ་ནི་ས་ཡི་ཤུ་དེ་ལོ་ཀོ་པོ་ར་ལྷོ་ནས་བྱ་བ་ནི་བརྗོད་པས།",
    "འོ་ཡིག་མི་མིག་དུ་པའི་ཕྱིར་རོ་ཨེ་ལི་པུ་རྗེ་ཡི་ཞེ་སེ་གེ་མ་ཎ་༣ཨ་ཚ་ཞེས་བྱ་བ་སོགས་པའི་བྱུང་ཁང་ཞེན་གྱི་མོན་ཏན་ད་༦་ ངམ་རང་ལ་བརྒྱབས་བྱ་ཅུ་སོགས་ས་སོ།",
    "མེས་པོའི་ཤུལ་བཞག་ཅེས་པའི་དཔེ་ཚོགས་འདི་ནི་དཔལ་བརྩེགས་བོད་ཡིག་དཔེ་རྙིང་ཞིབ་འཇུག་ཁང་གིས་བསྒྲིགས་ཤིང་འདི་ག་དཔེ་སྐྲུན་ཁང་དང་མཉམ་འབྲེལ་གྱིས་བསྐྲུན་པའི་དཔེ་རྙིང་དཔེ་ཚོགས་ཤིག་ཡིན་ལ།",
    "རང་རེའི་མེས་པོའི་ཤུལ་ནོར་སྲུང་སྐྱོབ་རྒྱུན་འཛིན་དང་བོད་རིག་པའི་གལ་ཆེའི་དཔྱད་གཞི་མཁོ་འདོན་གྱི་དགོས་པ་ཆེ་བ་མ་ཟད།",
    "དཔལ་བརྩེགས་ཞིབ་འཇུག་ཁང་གི་འགན་འཛིན་པ་ལྷན་རྒྱས་དང་།",
    "དབུས་གཙང་ཁམས་གསུམ་དུ་བཞུགས་སོ་ཅོག་གི་གླེགས་བམ་ཐམས་ཅད་གཅིག་ཏུ་སྤུངས་ན་རི་རབ་ལྷུན་པོའི་གཏོས་དང་མཉམ་ཞིང་།",
    "སྔོན་འགྲོའི་ཞུ་ཚིག་མོ་རྣམས་སུ་བོད་ཡིག་གི་དཔེ་མཛོད་ཆེན་པོ་ཡོད་པ་མ་ཟད།",
    "སྒྲུབ་པ་ཉམས་སུ་ལེན་ཚུལ་ལ་བརྒྱུད་པའི་ཁྱད་པར་དང་མན་ངག་གི་དབྱེ་བས་སྒྲུབ་བརྒྱུད་འདྲེན་པའི་ཤིང་རྟ་བརྒྱད་དེ།",
    "བདག་ཅག་གི་ཡབ་མེས་གོང་མ་རྣམས་ཀྱིས་གཅེས་པའི་ལུས་སྲོག་ལོངས་སྤྱོད་ཐམས་ཅད་ཕངས་པ་མེད་པར་བཏང་སྟེ།",
    "དཔེ་དཀོན་གྱི་མ་ཕྱི་གཡར་གནང་གི་སྐྱབས་འཇུག་ཡོང་བ་མཁྱེན་མཁྱེན།",
    "ལྷག་པར་དུ་ད་ལྟ་ལུས་ཀྱི་ལང་ཚོ་རྒྱས་ཤིང་།",
    "འཁོས་བསྟུན་གྱི་སྲི་ཞུའི་ལས་ཀ་ཅུང་ཟད་རེ་སྒྲུབ་ནུས་ན།",
    "བཟོ་གསོ་སོགས་ཐུན་མིན་དང་ཐུན་མོང་གི་རིག་གཞུང་གང་མང་ཞིག་འཆད་ཉན་གྱིས་གཏན་ལ་ཕབ་ཅིང་གླེགས་བམ་གྱི་ཚོགས་ཕོན་ཆེན་པོ་བཞེངས་ཡོད་པ་ལ།",
    "གནས་ཚུལ་མང་པོ་ཞིག་གི་རྐྱེན་པས་རྩ་སྟོང་དུ་འགྲོ་བར་དམིགས་ཏེ།",
    "དཔལ་བརྩེགས་བོད་ཡིག་དཔེ་རྙིང་ཞིབ་འཇུག་ཁང་གི་འགན་འཛིན་དགེན་ཀརྨ་བདེ་ལེགས་དང་།",
    "རྒྱལ་ཕྱི་ནང་གི་བོད་རིག་པའི་ཞིབ་འཇུག་པ་དག་ལ་དཔྱད་གཞིའི་དགོས་མཁོ་སོགས་ལ་དམིགས་ཏེ།",
    "དེབ་གྲངས་སུམ་བརྒྱ་ལྔ་བཅུ་ཙམ་ལོངས་པ་ལ་བཀའ་བརྒྱུད་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས་ཞེས་པའི་མཚན་གསོལ་ཏེ་མེས་པོའི་ཤུལ་བཞག་གི་དཔེ་ཚོགས་ནང་རིམ་པ་བསྟར་ཆགས་སུ་གཟིགས་པ་པོའི་སྤྱན་ལམ་དུ་འབུལ་རྒྱུ་ཡིན།",
    "ལྷག་བསམ་ཁ་རུ་མི་ཁྱེར་ཞིང་ལག་ལེན་དོན་ཐོག་ཏུ་འཁྱོལ་བའི་གྲོགས་པོ་རྣམས་ཀྱི་དཔེ་རྒྱུན་མཐོང་ན་མཁོ་འདོན་སྩལ་གནང་ཡོང་བར་ཞུ།",
    "སྤར་ཤིང་ད་ལྟ་བཞུགས་ཤིང་དཔེ་ཅུང་མོད་པ་རྣམས་སྐབས་འདིར་བཞག་མེད།",
