    "དེའི་སྟེང་དུ་མི་བསྐྱོད་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་ལ་ཡི་གེ་ཧཱུྃ་ལས་ལག་པ་གཡས་པར་རྡོ་རྗེ་བསྐྱེད་ལ་བསྒོམས་ན་རྡོ་རྗེའི་རིག་པ་འཛིན་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་དུ་འདུག་སྟེ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་ཡི་གེ་ཨོཾ་ལས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་ལས་བསྒྲུབས་པ་ལས་འཁོར་ལོའི་ལྕགས་ཀྱུ་ལག་པ་གཡས་པར་བསྒོམས་ལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དགུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འོད་དཔག་མེད་ཀྱི་རྣལ་འབྱོར་པས་འོད་དཔག་མེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ་ཡི་གེ་ཨཱ་ལས་ལྕགས་ཀྱུ་པདྨ་རིགས་ཀྱི་གཟུགས་སུ་རྣམ་པར་བསམས་ལ་འོད་དཔག་མེད་ལ་སོགས་པ་དགུག་པར་བྱའོ།",
    "ནམ་མཁའི་དབྱིངས་སུ་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ་གཡས་པའི་འཁོར་ལོ་ནམ་མཁའ་དང་མཉམ་པར་རྣམ་པར་བསམས་ལ།",
    "འཕགས་པ་གཤིན་རྗེའི་གཤེད་ཀྱི་སྦྱོར་བ་བྱས་ལ་རྡོ་རྗེ་ནམ་མཁར་བཅོམ་ལྡན་འདས་ཀྱི་དཀྱིལ་འཁོར་རྣམ་པར་བསམས་ལ་གནས་ལྔར་གཤིན་རྗེའི་གཤེད་ཀྱི་སྦྱོར་བས་འདུག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་དེའི་སྦྱོར་བས་འདུག་ལ་དེའི་སྔགས་ཀྱིས་ཁྲོ་བོ་བདུད་རྩི་འཁྱིལ་པ་རྡོ་རྗེ་ཕུར་བུར་བསམས་ཏེ།",
    "དཀྱིལ་འཁོར་དེར་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་དབུས་སུ་འདུག་ལ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭཱ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཁྲོ་བོ་གང་ཡང་རུང་བའི་སྦྱོར་བ་བྱས་ལ་དེའི་དཀྱིལ་འཁོར་ནམ་མཁའ་ལ་རྣམ་པར་བསམས་ནས་དཀྱིལ་འཁོར་དེའི་དབུས་སུ་འདུག་སྟེ།",
    "དེའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ་རྣམ་པར་སྣང་མཛད་དགུག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་སྦྱོར་བ་བྱས་ལ་དེའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རྣལ་འབྱོར་པ་འདུག་སྟེ།",
    "ཤར་ཕྱོགས་སུ་མི་བསྐྱོད་པའི་སྦྱོར་བས་འདུག་པའི་རྣལ་འབྱོར་པས་དབུས་སུ་ཡི་གེ་ཛཾ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་དེའི་སྟེང་དུ་ཡི་གེ་ཛཾ་ལས་གསེར་གྱི་ཁ་དོག་ཅན་འོད་ཟེར་སེར་པོའི་ཚོགས་ཀྱིས་ནམ་མཁའ་གང་བའི་འོད་ཟེར་དེ་རྣམས་ཀྱི་སྒོ་ལ།",
    "ཡི་གེ་མཾ་ལས་འཕགས་པ་འཇམ་དཔལ་གྱི་གཟུགས་ཀྱིས་འདུག་ལ།",
    "དེ་ནས་ཆར་དབབ་པའི་ས་ཕྱོགས་སུ་འདུག་ལ་གདུགས་དང་རྒྱལ་མཚན་དང་།",
    "ཡང་ན་མགོ་ལ་ཧྲཱི་བདུད་རྩིའི་ཚོགས་འོ་མ་ལྟ་བུར་འབབ་པ་བཀོད་ལ་ལུས་ལ་གནས་པའི་དུག་ངོ་བོ་ཉིད་ཀྱིས་ནག་པོར་འདུག་པའི་དྲི་མ་རིམ་གྱིས་སེལ་བར་བྱེད་པའི་འོད་ཀྱི་རྒྱུན་བསམས་ལ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་གཟུགས་ཇི་ལྟ་བ་བཞིན་དུ་གསང་བའི་གནས་སུ་བྱས་ལ་རབ་གནས་བྱ་ཞིང་རང་དེ་ལྟ་བུའི་སྦྱོར་བ་དང་ལྡན་པས་བསྟན་པ་ལྟར་བྱའོ།",
    "དགྲའི་རོ་ཙ་ན་ཞེས་བྱ་བ་ནི་དགྲའི་དྲི་ཆེན་ནོ།",
    "སྣང་མཛད་ནི་བེ་རོ་ཙ་ནའོ།",
    "ཅི་སྟེ་བཞུགས་ཞེས་པ་ནི་འདུག་པར་འདོད་པའོ།",
    "འདུག་ཅེས་བྱ་བ་ནི་གནས་པའོ།",
    "སྐལ་བ་དང་ལྡན་པ་གང་ཞིག་རྒྱུད་འདིར་སློབ་པ་དེ་ཡང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་རིམ་གྱིས་འགྱུར་བ་ནི།",
    "གལ་ཏེ་འདུག་ཀྱང་བགེགས་བྱེད་ན།",
    "བསྒྲུབ་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་མཚན་ཐོག་ཐག་བཟླས་ནས་ཐོ་རངས་ནམ་མཁའ་ལ་བྱ་ཁྱུང་ལྟར་འགྲོ་བར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་བཟླས་ན་དེའི་ཐོ་རངས་དེ་མི་སྣང་བར་འགྱུར་ཏེ་ལྷས་ཀྱང་མི་མཐོང་བར་འགྱུར་རོ།",
    "འདིར་ཡང་སྔ་མ་ལྟར་བྱ་བ་བྱས་ཏེ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་ཆུའི་སྣོད་ལ་རྡོ་ལ་སོགས་པ་བོར་བ་མི་འབྱིང་བ་ཐོ་རངས་གྲུབ་པ་ན་དེས་དེ་གྲུབ་བོ།",
    "ཚངས་པ་ཆེན་པོའི་སྟོབས་ཀྱིས་ཡུལ་བཀོད་པའི་བྱིན་གྱི་རླབས་ཀྱིས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཚེ་དཔག་མེད་ཀྱི་སྤྱན་སྔ་ན་འདུག་གོ།",
    "དེ་ནས་བརྒྱ་བྱིན་གཙུག་ཕུད་འཛིན་ཅེས་བྱ་བ་འཛམ་བུ་ཆུའི་གསེར་གྱི་རྒྱན་གྱིས་ལུས་ལ་བརྒྱན་ནས་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་འདུག་གོ།",
    "གང་རང་བཞིན་ལ་སོགས་པའི་ཁ་ན་མ་ཐོ་བ་སྤང་བར་སྟོན་པ་ལ་སོགས་པའི་ཕྱག་རྒྱ་གང་ཡང་རུང་བས་ཐེབས་ཤིང་ཆེན་པོ་བསྟན་པས་ཁྱབ་ན་ངེས་པར་དེས་བསྟན་པ་བླང་ངོ།",
    "བདུད་རྩི་ལྔ་ནི་བེ་རོ་ཙ་ན་དང་།",
    "ཞི་བའི་རོ་ཙ་ནས་བཟུང་སྟེ།",
    "དེ་བཞིན་དུ་ཞི་བའི་འཁོར་ལོ་བྲི་བ་ལ་ནི་ཁྱད་པར་གྱི་རྫས་རོ་ཙ་ན་སྟེ་རྔུལ་དང་ཀླད་པ་གང་ཡང་རུང་བས་བྱའོ།",
    "ལྷོ་ཕྱོགས་སུ་འགན་སྟན་ཨ་ཤྭ་ཏཱྠའི་ལོ་མ་སེར་པོས་བཀང་བའི་སྟེང་དུ་འདུག་སྟེ།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་ཁ་བལྟས་པ་དེའི་ཕྱོགས་སུ་འདུག་པར་བྱའོ།",
    "ཡི་གེ་དམར་པོའི་སྟེང་འདུག་ལ།",
    "གདུག་པའི་ཏིང་ངེ་འཛིན་ནི་སྤྲུལ་པའི་ཁྲོ་བོའི་ཚོགས་རྣམས་ཀྱིས་གདུག་པ་ཅན་གྱི་ཚེར་མ་ཕུར་བུའི་དབྱིབས་སུ་འདུག་པ་ལག་པ་གཡོན་དུ་ཐོགས་ནས་གཡས་པའི་ཐོ་བས་བརྡུང་ཞིང་།",
    "རོ་ཙ་ན་དང་རྒྱ་སྐྱེགས་དང་།",
    "ཞེས་པ་ནི་རོ་ཙ་ན་ནི་ཀླད་པའོ།",
    "དེ་སེལ་བར་བྱེད་པའི་རྩི་ནི་བེ་རོ་ཙ་ན་དང་བྱི་ཤྭ་དང་ཤུ་ཀྲ་དང་རཀྟ་དང་།",
    "དགྲ་ཡི་བེ་རོ་ཙ་ན་བླང་།",
    "ཞེས་པ་ལ་དགྲའི་བེ་རོ་ཙ་ན་ནི་དྲི་ཆེན་ནོ།",
    "དེར་འདུག་སྔགས་བཟླས་བརྟུལ་ཞུགས་ཅན།",
    "དེ་ཡང་རང་ཉིད་དང་མཚུངས་པའོ།",
    "དེ་ནི་སྔོ་བསངས་སུ་འདུག་པ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སྣང་མཛད་ནི་བེ་རོ་ཙ་ན་སྟེ་དྲི་ཆེན་ནོ།",
    "རྡོ་རྗེ་འཆང་རང་ངོ་བོ་ཉིད།",
    "རྡོ་རྗེ་འཆང་རང་ངོ་བོ་ཉིད་ཅེས་བྱ་སྟེ་ཡེ་ཤེས་ལྔ་རོ་གཅིག་པའི་ངོ་བོ་ཉིད་ནི་རང་རིག་པ་སྟེ།",
    "དེས་རྣལ་འབྱོར་དུ་མི་འགྱུར་ཞིང་རང་རྒྱུད་ཀྱི་དྲི་མ་དང་བཅས་པས་ན་རྒྱུ་བར་མི་བྱའོ།",
    "སྣག་ཚ་ལ་སོགས་པ་ཡང་ཟློས་པར་གསུངས་པ་རོ་ཙ་ན་ཞེས་པ་གོ་རོ་ཙ་ནའོ།",
    "ག་ཏྲི་པ་ནི་རོ་ཙ་ན་ལ་སོགས་པ་སྟེ།",
    "འཁྲུལ་འཁོར་གྱི་རིམ་པ་བྲི་བའི་དོན་དུ་རོ་ཙ་ན་ལ་སོགས་ཏེ་གང་ལ་དེ་སྟོན་པའོ།",
    "རོ་ཙ་ན་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "རོ་ཙ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "ལྷོ་ལ་སོགས་པའི་སྒོ་རྣམས་སུ་ཡ་ཙ་ནི་ར་ཞེས་པའི་ཡི་གེ་བཞི་པོ་ཉི་མ་ལ་གནས་ཤིང་ནག་པོ་དང་།",
    "ཨོཾ་ཡཀྵེ་མ་མེ་ད་ཡ་ཙ་ནི་རཱ་ཛ་ས་དོ་རུ།",
    "དེ་བཞིན་དུ་ཡི་གེ་ཙ་ནི་བེ་ཅོན་རྡོ་རྗེ་གཤིན་རྗེའི་དགྲའིའོ།",
    "གོ་རོ་ཙ་ན་བླངས་ཏེ་གྲོ་གའམ།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཚོར་བའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཚོར་བ་མ་ལགས།",
    "འདུ་ཤེས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འདུ་ཤེས་མ་ལགས།",
    "འདུ་བྱེད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འདུ་བྱེད་མ་ལགས།་",
    "རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "རྣ་བའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་ཡིསྟོང་པའི་སླད་དུ་རྣ་བ་མ་ལགས།",
    "སྣའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྣ་མ་ལགས།",
    "ལྕེའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལྕེ་མ་ལགས།",
    "ལུས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལུས་མ་ལགས།",
    "ཡིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡིད་མ་ལགས།",
    "གཟུགས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མ་ལགས།་",
    "སྒྲའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྒྲ་མ་ལགས།",
    "དྲིའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དྲི་མ་ལགས།",
    "རོའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རོ་མ་ལགས།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣ་བའི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྣའི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལྕེའི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "སའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་ཞུགང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སའི་ཁམས་མ་ལགས།",
    "ཆུའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆུའི་ཁམས་མ་ལགས།",
    "མྱེའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྐྱེའི་ཁམས་མ་ལགས།",
    "ནམ་མཁའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་ཕྱདམ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ནམ་མཁའི་ཁམས་མ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣམ་པར་ཤེས་པའི་ཁམས་མ་ལགས།",
    "མ་རིག་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མ་རིག་པ་མ་ལགས།",
    "འདུ་བྱེད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འདུ་བྱེད་མ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "མྱིང་དང་གཟུགས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མིང་དང་གཟུགས་མ་ལགས།",
    "ཚོར་བའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཚོར་བ་མ་ལགས།",
    "སྲེད་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྲེད་པ་མ་ལགས།",
    "ལེན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལེན་པ་མ་ལགས།",
    "སྲིད་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྲིད་པ་མ་ལགས།",
    "སྐྱེ་བའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྐྱེ་བ་མ་ལགས།",
    "རྒ་ཤིའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྒ་ཤི་མ་ལགས།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ལགས།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ལགས།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ལགས།",
    "བསམ་གཏན་གྱི་པ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་ཞུ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ལགས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ལགས།",
    "ནང་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ནང་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཕྱི་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཕྱི་ནང་སྟོང་པ་ཉིད་མ་ལགས།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆེན་པོ་སྟོང་པ་ཉིད་མ་ལགས།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དོན་དམ་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་ནིམཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འདུས་བྱས་སྟོང་པ་ཉིད་མ་ལགས།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་མ་ལགས།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རང་བཞིན་སྟོང་པ་ཉིད་མ་ལགས།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མ་ལགས།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡང་དག་པར་སྤོང་བ་རྣམས་མ་ལགས།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མ་ལགས།",
    "སྟོབས་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྟོབས་རྣམས་མ་ལགས།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་མ་ལགས།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་འཕགས་པའི་བདེན་པ་རྣམས་མ་ལགས།",
    "བསམ་གཏན་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་བསམ་གཏན་རྣམས་མ་ལགས།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མ་ལགས།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་མ་ལགས།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཏིང་ངེ་འཛིན་རྣམས་མ་ལགས།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུངས་ཀྱི་སྒོ་རྣམས་མ་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་མ་ལགས།",
    "མྱི་འཇིགས་པ་བཞིའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟིསྟོང་པའི་སླད་དུ་མྱི་འཇིགས་པ་བཞི་མ་ལགས།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་མ་ལགས།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུའི་ཡོངས་སུ་བཟུང་བ་མ་བྱམཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་མ་ལགས།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་དུ་མ་ལགས།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་མ་ལགས།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དགྲ་བཅོམ་པ་ཉིད་མ་ལགས།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་མ་ལགས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མ་ལགས།",
    "དེ་བཞིན་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་ཚིགང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དེ་བཞིན་ཉིད་མ་ལགས།",
    "མ་ནོར་བ་དེ་བཞིན་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ།",
    "གཞན་མ་ཡིན་པའི་ཉེདེ་བཞིན་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཞན་མ་ཡིན་པའི་དེ་བཞིན་ཉིད་མ་ལགས།",
    "ཡང་དག་པའི་མཐའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡང་དག་པའི་མཐའ་མ་ལགས་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་སོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་མ་ཡིན།",
    "སྟོང་པ་ཉིད་ལས་གུད་ན་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་མེད།",
    "སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "སྒྱུ་མ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཞེས་དགོད་སྒྲ་དང་བཅས་འཁོན་འཁོན་ཐོགས་ཐོགས་ཅི་ཡང་མེད་པར་བྱ་འཕུར་བ་ལྟར་རྒྱུགས་ནུས་པ་ཞིག་འདུག་པས་བལྟས་བལྟས་རིག་རིག་ཏུ་མཐོན་པོའི་ལ་དང་དམའ་བའི་གཤོང་།",
    "ཡུལ་ལུང་དེ་བཞིན་ངོ་མ་མིང་དོན་མཚུངས་པར་འདུག་སྟེ།",
    "ཀོ་དོང་ཙམ་ལས་མི་འདུག་གོ་ཞེས་སྨྲས་པ་ལ།",
    "དེ་ལྟར་བདག་ནི་ཕུན་ཚོགས་ལྔ་གཉིས་འདོད་རྒུའི་དཔལ་ཡོན་བཅུ་ཡི་སེམས་ཁམས་དགའ་མར་དམ་དུ་འཁྱུད་ནས་ལོངས་སུ་སྤྱོད་ཀྱིན་ཡོད་ཙ་ན།",
    "དཀར་རྩིས་བརྒྱན་ཞིང་ཧ་ལམ་སྤེན་བད་ཀྱང་ཡོད་བཟོ་ཆེ་བས་ང་རང་ཡིད་འཐད་པ་ཞིག་བྱུང་སྟེ་ཉེ་བར་བཅར་ནས་གནས་མཇལ་ཞུས་པའི་ཚེ་ན།",
    "དབུ་ང་བརྒྱ་འཛོམས་འདུགུ་ལ་སྟོང་འཛོམས་འདུག།",
    "སློ་མ་སོགས་བཟོ་བཀོད་དང་ཆེ་ཆུང་སྣ་ཚོགས་པ་གང་དགོས་ཅི་འཛོམས་འདུག་པ་ལ།",
    "རྡོ་ཡི་བྷ་གའི་ཁ་དེ་ཅུང་ཟད་གས་ཆག་ཏུ་གྱུར་འདུག་པས་ངས་རྒྱུ་རྐྱེན་གང་ཡིན་བཀའ་འདྲི་ཞུས་པ་ལ་སྐུ་ཞབས་ལགས་ནས་སྔོན་ཚེ།",
    "གཞན་ཡང་གནས་དེ་ན་ཤིང་སྟག་མ་ལོ་མ་ཤིན་ཏུ་ནས་ཆེ་བ་ཞིག་འདུག་པ་དོམ་ཚང་རོང་ལ་ཤིང་སྣ་གཅིག་ཆད་པ་ཁ་གསབ་ཕྱིར་རྒྱ་གར་རྡོ་རྗེ་གདན་ནས་གདན་དྲངས་སྐད་ལ།",
    "གནས་དེ་ག་ན་དཀར་གཙང་ཁ་བཏགས་ཀྱིས་ཡོངས་སུ་བཀླུབས་པའི་གླང་པོ་ཆེའི་རང་བྱོན་འདུག་པ་ལ།",
    "ཕུག་པའི་ནང་ནས་གཡས་དེར་ཕུག་ཆུང་ཞིག་འདུག་པ་དེའི་མཐིལ་དུ་རྣ་བ་གཏད་དེ་ཞིབ་པར་ཉན་ན་སྐད་སྒྲ་སྣ་ཚོགས་ཐོས་པར་གྲོགས་ལ།",
    "གཡོན་ཕྱོགས་ན་ཚེ་མཆོག་ཕུག་འདུག་ཅིང་།",
    "དེ་ནས་ཚེ་བུམ་རང་བྱོན་འདུག་ཅིང་ཚེ་བུམ་རང་བྱོན་གྱི་ཁ་རུ་སྒྲུབ་ཆུ་རང་བཞིན་དུ་བབ་པའི་མཁའ་འགྲོ་མའི་ནུ་མའི་རང་བྱོན།",
    "གཡས་སྟེང་ན་འབྲུག་རང་བྱོན་ཡོད་ལ་ཕུག་སྦུབས་སུ་གུ་རུའི་བཞུགས་ཁྲི་མཇལ་རྒྱུ་འདུག་དེ་ནས་གནས་གསར་མ་ཞེས་རྒྱལ་བ་ཀརྨ་པ་རང་བྱུང་རྡོ་རྗེས་གནས་སྒོ་ཕྱེ་བར་གྲགས་པའི་ཕུག་པ་དེར་འབྱོར་བ་ལ།",
    "ཁྱད་པར་ན་སོམ་སྡོང་ཤིན་ཏུ་རིང་ལ་སྦོམ་པ་ཞིག་ལ་ཉག་ཤུར་བཅུ་དགུ་བཏོན་པའི་ཤིང་སྐས་ཤིན་ཏུ་ནས་གཟར་བ་ཞིག་འདུག་པ་དེ་འཛེགས་རྗེས་ཕུག་སྒོར་སླེབས་ལ་ཕུག་པ་གུ་དོག་པས་དལ་བུ་དལ་བུར་ཆུ་ཚོད་ཕྱེད་ཙམ་སྐྱོད་མཚམས་ད་གཟོད་ཐོན་སྒོར་འབྱོར།",
    "སྔོན་ཚེ་ངར་ལྕགས་ལས་གྲུབ་པའི་ཨ་ལོང་ཆེ་བ་བཅུ་དགུ་ཅན་ཞིག་འདུག་པ་དེ་ལ་འཁྱུད་ནས་བབ་དགོས་སྐད་ཀྱང་དེང་ཆར་ཤིང་སྐས་ཐེམ་སྐས་ཉེར་གཅིག་བྱས་པ་དེ་ནས་བབ་དགོས་ཀྱི་འདུག་མར་བབས་རྗེས་བྲག་སྐྱིབས་ཤིག་ན་རྡོའི་བཞུགས་ཁྲི་གསུམ་ཡོད་པ་ལ་སྐུ་ཞབས་ལགས་ནས་གསུངས་པ་ལྟར་ན།",
    "ང་རང་མགྱོགས་སྟབས་སུ་བསྐྱོད་པས་ཆུ་ཚོད་དགུ་དང་ཕྱེད་ཀ་ཡོལ་ཙམ་དུ་ཚོང་འདུས་ཚོགས་གནས་ཀྱི་ཐང་ཆེན་གསར་པར་འབྱོར།",
    "ང་རང་བརྩིས་ན་བཅུ་དྲུག་ཡོད་ཅེས་གསལ་བ་ལྟར།",
    "ཤ་སྐུམ་ལྕུག་ཕྲན་ཤིག་ཤིག་ར་ཤུ་ཚི་ལུ་ཡོག་ཡོག་ལུག་ཤ་རླངས་པ་འཚུབ་འཚུབ་སོགས་བོད་པའི་རྒྱུན་ཟས་གང་དང་ཅི་ཡང་འདུག་ལ།",
    "དགའ་བའི་མི་ཀུན་རང་རང་གང་འདོད་བཞིན།",
    "ཉོ་ཚོང་ཀུན་དགའ་ནམ་ཡང་ཡུན་གནས་ཤོག་ཅེས་དགའ་བའི་གླུ་དབྱངས་ལེན་བཞིན་སྤྲོ་བའི་ཐང་ཆེན་སྒོར་གཞས་འཁྲབ་ཀྱིན་འདུག་གོ།",
    "ཁོ་བོ་སོགས་ནི་སྐབས་དེ་ཤེད་ན་རང་རང་ལག་ཐོགས་ཁ་པར་ལ་བརྟེན་ནས་མཛེས་ཤིང་ལྟ་ན་སྡུག་པའི་མཚར་ལྗོངས་རྒྱབ་ལྗོངས་སུ་བྱས་ཏེ་ཕན་ཚུན་དྲན་རྟེན་གྱི་པར་འགའ་ལེན་རྒྱུ་ཙམ་དུ་ཟད།",
    "དེའི་ཕྱོགས་བཞི་རུ་བུ་ག་ཆུང་ཆུང་བཞི་བརྡོལ་འདུག་པས་མདའ་འཕེན་དུས་སྒྲ་ཁྱད་པར་བ་ཞིག་གྲགས་པས་ཀོང་པོ་བས་བི་ཤུ་ཞེས་སུ་འབོད།",
    "བོད་བཟོའི་མཛེས་བཀོད་མ་ཚང་བ་མེད་པའི་གྲོང་མིའི་སྡོད་ཁང་ཐོག་གཉིས་མ་གཅིག་ལ་གཅིག་འགྲན་གྱི་ཚུལ་དུ་གྲལ་སྟར་ཚར་དུ་དངར་བར་སྒོ་བྱང་ལ་བོད་རྒྱ་ཡིག་རིགས་གཉིས་ལས་བྲིས་པའི་བསམ་སྐྱིད་སྒྲོལ་མའི་ཁྱིམ་ཚང་མགྲོན་ཁང་དང་ཕུན་ཚོགས་གསོལ་མགྲོན་ཁང་ཞེས་པ་སོགས་མང་དུ་འདུག་པ་ལ།",
    "ཁྱིམ་ཚང་གཞན་འགོས་ཀྱང་རང་རང་འཁོས་འབབ་ལ་བ་ཞིགས་ཏེ་ཡུལ་སྐོར་བར་བཞོན་རྟ་བོགས་གཏོང་དང་།",
    "འདུག་གནས་བ་ར་དང་ཕག་ཚང་ཇི་ལྟ་ལ།",
    "ད་ཆ་རླབས་ཆེན་གུང་ཁྲན་ཏང་དང་མའོ་ཀྲུའུ་ཞིའི་དབུ་ཁྲིད་འོག་རང་ཁྱིམ་རང་བདག་བྱུང་ནས་བཟའ་ལེགས་འཐུང་ལེགས་ནི་འདུག་གྱོན་ལེགས་ཉལ་ལེགས་ནི་འདུག་ཁྱིམ་ནི་ཁྱིམ་ཡག་སྣང་།",
    "འདུག་ས་ནི་འདུག་ས་སྐྱིད་སྣང་།",
    "ཁོང་རང་མཚན་ལ་འདི་ལྟར་ཞུ་བ་ཡོད།",
    "བར་ཁྱམས་ཀྱི་གཡོན་ལོགས་སུ་དཀྱུས་ལ་སྤྱི་ཁྲེ་ཕྱེད་ཐང་དགུ་དང་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་ཕྱེད་དང་བདུན་དང་ལྡན་པའི་བཅད་ཁང་ཞིག་འདུག་པ་དེ་ནི་འདུ་ཁང་ངམ་ཚོམས་ཆེན་ཞིག་ཡིན་ཤས་ཆེ་ལ།",
    "བར་ཁྱམས་ཀྱི་གཡས་ཕྱོགས་སུ་བཅད་ཁང་དྲུག་ཡོད་པའི་དཀྱུས་རིང་ཤོས་ལ་སྤྱི་ཁྲེ་ལྔ་ལྷག་དང་ཆུང་ཤོས་ལ་སྤྱི་ཁྲེ་བཞི་ལྷག་དང་ལྡན་ཞིང་ཞེང་ཚད་ལ་སྤྱི་ལེ་གཉིས་ཙམ་འདུག་པ་དེ་དག་ལྷ་ཁང་གམ་གཟིམ་ཆུང་ཡིན་ཤས་ཆེ།",
    "བཅོམ་ལྡན་རྒྱལ་བ་རིགས་ལྔའི་བཀྲ་བཀྲ་ཤིས་ཤོག་ཅེས་པའི་བཀྲ་ཤིས་བཅད་པ་བརྗིད་ཉམས་ལྡན་པ་ཞིག་འདུག་ལ་དེ་གཉིས་ཀའི་ཚིག་རྩ་ཡང་ཤིན་ཏུ་གསལ་བས་ཡི་གེར་འགོད་བདེ་བ་ཞིག་བྱུང་ལགས།",
    "འཇིག་རྟེན་གདགས་པའི་དཔེའུ་ཆུང་རྣམས་བྲིས་ཞེས་འདུག་ཀྱང་ད་བར་བཞིན་མཇལ་གྱི་གོ་སྐབས་མ་ཐོབ།",
    "གཤིས་རྒྱུད་བཟང་བའི་སྣང་ས་སོགས་འཁྲབ་མི་གཙོ་བོ་འབྲི་བཞེངས་ལེགས་པར་བྱས་འདུག་གཞན་ཡང་།",
    "མདའ་དམག་དུས་ཆེན་སོགས་ས་གནས་དེ་གའི་དམངས་ཁྲོད་རིག་རྩལ་དང་།",
    "དུས་ཚོད་ཀྱང་རྩ་བ་ནས་གཞི་འཛིན་ས་མེད་པའི་སྤྱི་ཟླ་༦པའི་ཚེས་༡ཉིན་མདའ་དམག་དུས་ཆེན་གྱི་ཉིན་དང་པོར་གཏན་འཁེལ་བྱས།",
    "ད་ལྟའི་མདའ་དམག་དུས་ཆེན་ནི་སྲོལ་རྒྱུན་གཙོ་བོར་བྱེད་པའི་རྨང་གཞིའི་ཐོག་ད་དུང་གཡག་རྒྱུག་དང་།",
    "ད་ནང་རང་དཀྲོག་པ་ཡིན།",
    "དགྲ་དང་རང་ཕྱོགས་དབར་གོ་མཚོན་བཟང་ཞན་གྱི་ཧེ་བག་ཤིན་ཏུ་ཆེ་བ་སོགས་ཀྱི་གནས་བབ་ཧ་ཅང་ཉམས་ཐག་འོག་གཉའ་མ་ཞུམ་པར་སྔར་མུས་བཞིན་དཔའ་ངར་ཆེན་པོས་དགྲ་བོར་སྲོག་དང་བསྡོས་པའི་འགོག་རྒོལ་དྲག་པོ་བྱས་ཏེ་དགྲ་དམག་རྣམས་རྒྱལ་རྩེ་རང་དུ་བཀག་ནས་ལྷ་སའི་ཕྱོགས་སུ་གོམ་པ་གང་ཡང་མ་བཏང་།",
    "པ་སྣམ་ཞེས་པའི་མིང་ཐོགས་ཚུལ་གཉིས་ཙམ་འདུག་པ་སྟེ།",
    "ཁོང་རང་ཉིད་ཀྱིས་ཀྱང་སྒྲུང་སྣ་༦ཙམ་ལེགས་སྒྲིག་དང་།",
    "ད་ཆ་འཕྲུལ་ཆས་དེ་དག་ཡོད་སྟབས་ཞིང་འདེབས་པ་དང་བསྡུ་དུས་ཉིན་བཅུའི་ནང་ཚར་གྱི་འདུག་ཅེས་བཤད།",
    "ཀུང་སིའི་སྤྱི་ཁྱབ་ལས་འཛིན་ནོར་བུ་བསྟན་འཛིན་གྱིས་དེང་སྐབས་བོད་དུ་རྩམ་པ་ལས་སྣོན་བཟོ་གྲྭ་འཛུགས་པའི་དར་སོ་ཆེན་པོ་བྱེད་ཀྱི་འདུག་པས།",
    "གནས་བཅུ་ལྷ་ཁང་བསྐྱར་བཞེངས་གནང་བའི་ནང་སྔོན་གྱི་རྡོ་བརྐོས་ཀྱི་གནས་བཅུའི་སྐུ་བརྙན་སྔོན་ཁྲོན་པའི་ནང་དུ་སྦས་པ་རྣམས་བཏོན་ཏེ་བཞུགས་སུ་གསོལ་བ་མཇལ་རྒྱུ་འདུག་དགོན་དེའི་མཐར་ལྕགས་རི་མཐོ་ལ་ཞེང་ཆེ་བ་དང་།",
    "ང་རང་ཡང་བང་ཕིག་ཚོང་བ་ལས་བཟོ་མི་ཤེས།",
    "ནང་ངོས་ཀྱི་སྒྲིག་ཆས་དག་ནི་མཛེས་ཤིང་སྤུམ་པའི་བོད་བཟོའི་རྣམ་པར་འདུག་གནས་དེ་ན་གཙོ་གཉེར་ཚན་པས་རྒྱུ་ང་མེ་ཏོག་ལྷ་མཛེས་དང་།",
    "གཞིས་བྱེས་རྣམ་པས་ཕན་ཚུན་འཚམས་ཞུ་དང་སྦྲགས་རང་རང་ངོ་སྤྲོད་ཞུས་རྗེས་ད་གཟོད་གཙོ་སྐྱོང་བའི་མཛུབ་ཁྲིད་འོག་གཞིས་བྱེས་རྣམས་ཀྱི་གཏམ་ཁ་བརྗོད་དོན་གཙོ་བོའི་ཕྱོགས་སུ་གྱུར།",
    "ཁོང་འཁྲུངས་སའི་མི་ཁྱིམ་ནི་ནག་པོའི་ས་གཞི་ཆེན་པོ་དང་ལས་འགྲོ་ཤིན་ཏུ་ཟབ་པས་ཕ་ཚ་བུ་རྒྱུད་ཚང་མ་ལོ་གཅིག་དུས་བཞིར་དཔུང་ས་འོག་ཏུ་བཅུཔག་སྟེ་ས་སོ་ནམ་ཀྱི་ལས་ལ་བྲེལ་ནས་འཚོ་གནས་བྱེད་མཁན་ཞིང་དུད་ཕལ་པ་ཞིག་ཡིན་ཁར།",
    "རླངས་འཁོར་སྟག་གྲུ་ཁའི་ཟམ་ཆེན་དལ་བུར་སྒྲོལ་ནས་ཡར་ཀླུང་གཙང་པོའི་བྱང་ཁ་རུ་སླེབས་དུས་མུ་མཐས་དབེན་པའི་ཞིང་ཐང་ཡངས་པོའི་སྟེང་ཨ་ཇོ་ཞིང་པས་ཞོག་ཁོག་འདོན་པའི་ལས་ལ་རིངས་ནས་འདུག་ཅིང་།",
    "ཞིང་ཐང་གྲུ་ཟུར་གྱི་སྤང་ལྗོངས་ཤིག་ན་རྡོག་ཆེའི་ཞོག་ཁོག་དཀར་པོ་དེའུ་འབུར་ཆུང་ངུ་ཞིག་ལྟར་བྱུར་སྤུངས་བརྒྱབ་ནས་འདུག་པ་ལ་བསམས་ན་གནས་འདི་ནི་མིང་དུ་གྲགས་པའི་ཨེ་མ་སྒྲུང་ཞོག་ཁོག་འདེབས་ལས་རྟེན་གཞི་ཡིན་པར་ངེས།",
    "དེ་ནས་ཡར་ཙམ་བྲོས་རྗེས་སྤོ་བོས་ད་ཆུ་གང་དུ་སླེབས་སམ་ཞེས་དྲིས་པར་ཚ་བོས་རི་ཁྱུ་ཞིག་འགྲོ་ཡི་འདུག་བྱས་པས་སྤོ་བོས་ས་དེའི་མིང་ལ་རི་ཁྱུར་ཐོགས་ཤིག་གསུངས།",
    "ཚ་བོས་ཆུ་ཁྲོ་ལོ་ལོ་འཁྱིལ་འདུག་བྱས་པར་སྤོ་བོས་ས་དེའི་མིང་ལ་ཁྲོ་ལོར་ཐོགས་ཤིག་གསུངས།",
    "དེ་ནས་ཡར་ཙམ་བྲོས་རྗེས་སྤོ་བོས་སླར་ཚ་བོར་ཆུ་གང་དུ་སླེབས་ཡོད་མེད་དྲིས་པ་ལ་ཚ་བོས་ངག་དལ་པོའི་ངང་ད་ནི་ཆུ་ཁར་གསེར་བྱ་ངང་པ་ཞིག་སླེབས་འདུག་ལ་ཆུ་ཡང་ལུད་ཀྱི་མི་འདུག་བྱས་པས་སྤོ་བོས་ད་བྲོས་མི་དགོས།",
    "དང་ཐོག་ང་ཡི་མིག་སྒོར་ཆུད་པ་ནི་ང་རང་རྦད་དེ་ཧ་ལས་ཧོན་ཐོར་དུ་གྱུར་བའི་གཟེངས་བསྟོད་གོས་དར་དང་བྱང་བུ་དེ་དག་ལགས།",
    "རྩོམ་པ་པོ་གྲགས་ཅན་འཇམ་དབྱངས་ཤེས་རབ་ལགས་ཀྱིས་ཁོང་རང་བྱུང་ཐང་བ་ཞིག་ཡིན་ལ།",
    "དངོས་པོའི་འཁོར་རྒྱུག་ནུས་པའི་འཁོར་རྒྱུག་སྐྱེ་དངོས་ཀྱི་སྣ་མང་རང་བཞིན་བཅས་ལ་ཞིབ་འཇུག་བྱེད་པར་མེད་དུ་མི་རུང་བའི་རང་བྱུང་རྟེན་རྫས་བཤམས་མཛོད་ཁང་ཞིག་ཡིན་ཞེས་སྨྲས་ན་འགལ་ཆ་ཅི།",
    "དེ་གར་རྩྭ་ཆུ་འཛོམས་པས་སྤྲིན་ནག་མཁའ་ལ་འཁྲིག་འདྲའི་ནག་ཆུང་ནོར་ཁྱུ་དང་སྐར་ཚོགས་ས་ལ་འཕོས་འདྲའི་གཡང་དཀར་ལུག་ཁྱུ་དག་རང་རང་སོས་དལ་བག་ཕེབས་ཀྱི་ངང་ཚུལ་ལས།",
    "ཡང་ཤོད་རྒྱུན་གཞན་ཞིག་ནི་དེ་བས་འཇིགས་ཤིང་སྐྱི་གཡའ་བར་འདུག་པ་སྟེ།",
    "ང་རང་རྐང་བགྲོད་མགྱོགས་པས་མདུན་གྲལ་དུ་སླེབས།",
    "དགོན་དེའི་ཆགས་ཡུལ་གྱི་མཛེས་ལྗོངས་ཉམས་སུ་དགའ་བ་ཞིག་འདུག་སྟེ།",
    "ཚོགས་པའི་དབུས་སུ་འདོན་དུ་མི་རུང་བའི་གྲོང་ཚིག་དམར་རྗེན་ཅན་གྱི་ཡང་མ་སྐྱོན་པར་ཀློག་བདེ་ལ་འབྲེལ་ཆགས་པའི་བོད་ཡིག་རྣལ་མའི་ལམ་ནས་བྲིས་འདུག་པས་སྟོད་མངའ་རིས་བསྐོར་གསུམ་དང་།",
    "སྐུ་ཞབས་ལྗང་གཞོན་གྱི་སྙན་ངག་ཇི་ལྟའི་གོ་སླ་བ་དེ་འདྲ་ཡང་མ་ཡིན་པས་བར་པའི་ཚད་དུ་འདུག་སྙམ་ན་ཡང་།",
    "ས་དམར་གྲགས་པས་རྒྱ་ཡིག་ལས་བྲིས་པའི་སྙན་དེབ་འོད་ཀྱི་སྒྲོག་གུ་ཞེས་པ་སྒོར་ཐོན་འདུག་ཅིང་།",
    "རྒན་ཁྱེད་རང་དུས་ནམ་ཞིག་ནས་རྩོམ་རིག་གསར་གསར་རྩོམ་གྱི་ལས་སུ་ཞུགས་པ་ཡིན།",
    "དེ་ཕལ་ཆེར་མི་བུ་སྒལ་ཚིགས་ཅན་ཞིག་ལ་མ་མཐར་ཡང་འཛོམས་དགོས་ངེས་ཀྱི་དྲིན་བྱས་དྲིན་དུ་བསམ་པ་ཞེས་པ་དེས་སྐུལ་བ་ཡིན་ཚོད་གདའ།",
    "ང་རང་གསར་རྩོམ་ལ་ཐོག་མར་ཞུགས་པའི་དུས་ནི་ཏག་ཏག་དུས་རབས་གོང་མའི་ལོ་རབས་བརྒྱད་ཅུ་པར་ཡིན་ལ།",
    "འོན་ཏེ་རང་གདོང་རང་གསལ་ནུས་པའི་སྲིན་འབུ་མེ་འཁྱེར་ཅན་གྱི་རྩོམ་མཁན་ཐེབས་ཆག་པའི་གྲལ་མཐའ་འཛིན་ནུས་སུ་གྱུར་ཚུལ་ཅུང་ཟད་ཅིག་གླེང་ན་ནི།",
    "མི་བུར་གོས་ཀྱིས་བརྒྱན་ནས་མི་ཚོགས་ཀྱི་དབུས་སུ་ལྟ་བས་ཆོག་མི་ཤེས་པ་ཞིག་ཡོང་གང་ཐུབ་བྱེད་དགོས་པར་འདུག་སྙམ།",
    "ང་རང་ནི་རྩོམ་པ་པོ་ཐེབས་ཆག་ཅིག་ཡིན་ན་ཡང་ཀློག་པ་པོ་རྣམ་དག་ཅིག་ཡིན།",
    "ལོ་ཙ་བ་ཇོ་སྲས་ནམ་མཁའ་བཀྲ་ཤིས་སོགས་ཀྱིས་གཙོས་པའི་སྐྱེས་སྟོབས་ཀྱི་དཔལ་འབར་བའི་ན་གཞོན་རྩོམ་པ་པོའི་ཁྱུ་ཚོགས་ཤིག་འཚར་ལོངས་ཡོང་དང་ཡོང་བཞིན་འདུག་པས།",
    "མ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "མ་སྤེལ་བར་ཡང་རང་ཉིད་འཕེལ།",
    "རྒྱལ་པོ་ལྐོག་ཏུ་འདུག་ན་མཛེས།",
    "རྩོལ་བ་དོར་ནས་འདུག་པ་ལ།",
    "བི་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "གངས་ཅན་མིག་ཅིག་གཅིག་བི་རོ་ཙ་ན་དང་།",
    "ཁ་བཏོན་སོགས་སྨྲ་བརྗོད་ཡིད་མི་བདེ་བའི་སེམས་ལས་འགྲོ་འདུག་སྤངས་ཏེ་བརྟག།",
    "དེ་ཡང་གྲང་གྲངས་མང་ཉུང་ཇི་ལྟར་ཡང་མཁྲུང་བ་དང་གྲིམ་གྲིམས་པར་འདུག་ན་ཚ་བ།",
    "གྲངས་མང་ཡང་སྟོང་པ་དང་ལྷོད་པ་པར་འདུག་ན་གྲང་བ།",
    "དགྲ་རྩ་མ་ཚང་ན་རང་ལ་དགྲ་སྡང་ལྡང་བའི་དགྲ་རབས་ཆད་ཅིང་རང་ལ་བཟང་།",
    "དྲག་ཤུལ་གྱི་གྱིས་འགྲོ་འདུག་སེམས་ལས་ཆེ་བ་སོགས་ཆུ་འཁྲུགས་སྤང་བར་བྱ།",
    "གྲང་ནས་ལྡོག་དུས་ལྡོག་ཚུལ་ལོག་རྗེས་བརྟག།",
    "འདིའི་ཚུལ་རྒྱས་པར་འོག་ཏུ་འཆད་དོ་ལྡོག་དུས་རླང་རླངས་མ་ཡལ་བར་ལྡོག་པ་ཚ།",
    "མེད་ཀྱང་ལྡོག་དུས་ལྡོག་ན་སྐྱོན་མེད།",
    "སྔོ་ཡི་གཙོ་བོ་འཁྲུག་འཁྲུགས་ཚད་པ་ཧོང་ལེན་རིམ་རིམས་ཚད་ལ་བོང་ང་དཀར་དེ་རྣམས་རང་རང་གཉེན་པོ་ཐུན་ལོག་ཏུ་བྱེད་ཅིང་།",
    "ལྕགས་ནི་གསེག་བརྡར་གྱིས་བརྡར་བའི་ཕྱེ་མ་དང་རང་ལས་གསུམ་སུམ་འགྱུར་གྱི་ཚ་ལ་མུ་ཟི་ཉིས་འགྱུར་གྱི་ཨ་རུ་ར་དེ་རྣམས་ཞིབ་པར་བཏགས་ལ་སིངས་པོ་སྦྱར་བའི་འདག་པ་བཅས་གསེར་དངུལ་ཟངས་ལྕགས་བཞི་བོ་དེ་ཞིག་དཀའི་བ་ས་མེ་ཐུབ་ཀྱི་རྐང་ཀོང་བུ་བཟང་པོ་བྱས་ནས་སོ་བཏང་བའི་ནང་དུ་དང་པོ་གསེར།",
    "ཐར་ནུ་སྟོན་གཞུགས་གཞུག་དུས་བཀོས་བརྐོས་བ་ཆུར་བཏུལ་བ་དང་།",
    "འདྲུལ་འགྲུལ་བསྲུང་མི་སྨྲ་མི་ཉལ་ཙོགས་ཙོག་པུར་འདུག།",
    "མི་སྨྲ་མི་འགུལ་ཙོག་པུར་འདུག་པ་དང་།",
    "མི་སྨྲ་མི་གྲང་ཙོག་པུར་འདུག་པར་བྱ།",
    "གཞན་ཡང་བསྲེག་པའི་དུས་སུ་ལོ་ཟླ་ཞག་དུས་སོགས་ལ་མཛེམ་འཛེམ་བྱ་མང་བར་མཆིས་ཀྱང་ཁྱད་པར་བླ་གནས་ཀླུ་རིགས་ལྡན་གཉིས་ངེས་པར་བརྟག་དགོས་སོ།",
    "ཚ་ལོགས་ལོག་ཚ་གྲང་འཁྲུལ་བས་ཐུར་ལོག་ལ་དེ་རྟག་རྟགས་བཅོས་ཐབས་རང་རང་སྐབས་ལྟར་བྱ།",
    "སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་འབྱིན་པ་དང་།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་རྒྱ་གར་དུ་བྱོན་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་སྣང་བ་དང་ལྡན་ཞེས་བྱ་བ་ན་དེ་བཞིན་གཤེགས་པ་འོད་ཟེར་རྒྱལ་པོ་བཞུགས་པའི་ཞིང་ན་ལྷུང་བཟེད་དེ་བར་སྣང་ལ་འདུག་པར་གྱུར་རོ།",
    "ཚོང་དཔོན་གྱི་བུ་དྲི་མ་མེད་པའི་དཔུང་པ་ཞེས་ཕ་མའི་པང་ན་འདུག་པ་དེས་དགེ་སློང་དེ་མཐོང་བས་མའི་པང་ནས་དགེ་སློང་དེའི་དྲུང་དུ་བརྒྱུགས་ཤིང་བཟའ་བ་བསླངས་པ་དང་།",
    "དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་སྟན་དེ་ལ་འདུག་བཞིན་དུ་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་སྟེ།",
    "ཟས་ཟ་བ་མ་གཏོགས་པར་འདུག་པར་ཡང་མ་གྱུར་ཏེ་འགྲོ་བ་དང་ལྡོག་པ་ཐམས་ཅད་དུ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་བསྐྱེད་ཅིང་སེམས་དེ་ལའང་རློམ་སེམས་བྱེད་པར་མ་གྱུར་ཏོ།",
    "དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་འོད་གསལ་གྱི་ལྷའི་རིས་སུ་འདུག་སྟེ་མགུལ་པ་བསལ་བའི་ཚེ།",
    "རྟོག་པ་དེ་འཇམ་དཔལ་གྱིས་རིག་ནས་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདིར་མེ་འབར་བ་ན་འཇིག་རྟེན་གྱི་བར་དུ་འདུག་སྟེ་ཅི་ཤཱ་རིའི་བུའམ་ཁོ་བོའི་རྫུ་འཕྲུལ་གྱི་མཐུས་བརྒལ་ཞེས་སྨྲས་པའི་ཚེ།",
    "དེ་ནས་དུས་གཞན་ཞིག་ན་དེ་བས་ཀྱང་ཤིན་ཏུ་རྒྱ་ཆེ་ཞིང་ཡངས་པའི་འཇིག་རྟེན་གྱི་ཁམས་སུ་མེ་འབར་བ་ན་འཇིག་རྟེན་གྱི་བར་དུ་འདུག་སྟེ།",
    "དེ་ན་ལྷུང་བཟེད་ཟས་ཀྱིས་བཀང་བ་གཅིག་གདའོ་ཞེས་ཞུས་པ་དང་།",
    "དེས་དེ་དག་ཡིད་ཆེས་པར་བྱས་ནས་འདུག་པ་དང་།",
    "དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་འཁོར་མང་པོས་བསྐོར་ཏེ་སྨྱིག་མའི་ལྡུམ་བུའི་འཁོར་གྱི་ཁྱམས་ག་ལ་བར་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་དུ་དོང་ནས་ཕྱག་བཙལ་ཏེ་མུ་སྟེགས་ཅན་གྱི་འཁོར་རྣམས་ཀྱིས་ཀྱང་མེ་ཏོག་མནྡ་ར་བས་མཆོད་ཅིང་ལན་གསུམ་བསྐོར་ཏེ་ཕྱོགས་གཅིག་འདུག་གོ།",
    "དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་གནས་པ་མེད་པའི་ཁང་བརྩེགས་ན་འདུག་འདུག་པ་ལས།",
    "འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་དཔག་ཚད་བརྒྱ་རྩ་བཅུའི་ཕ་རོལ་ནས་ཕྱག་བརྐྱངས་ཏེ་ཚོང་དཔོན་གྱི་བུ་ནོར་བཟང་དེ་ན་འདུག་པའི་སྤྱི་བོར་བཞག་ནས།",
    "སྣང་བ་ཆེན་པོ་དང་ངོ་མཚར་རྨད་དུ་བྱུང་བའི་མཚན་མ་རྒྱ་ཆེན་པོ་འདི་ལྟ་བུ་གདའ་བའི་རྒྱུ་དང་རྐྱེན་གང་ལགས་ཞེས་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་འཁོར་འདུས་པ་འདི་ན་མི་གདའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གཡས་ཕྱོགས་ན་ལག་ན་རྡོ་རྗེ་རྡོ་རྗེ་ཐོགས་ནས་འདུག་པ་ལ།",
    "ཆུང་མ་དམ་པ་མ་སྨད་པ་ཞེས་བྱ་བ་དང་དཔེ་མེད་མ་ཞེས་བྱ་བ་གཉིས་ཁྲུས་བྱས་ཏེ་སེང་གེའི་ཁྲི་པདྨའི་འབྱུང་གནས་བཟང་པོ་ལ་འདུག་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་འོད་ཟེར་གྱིས་སྣང་བར་གྱུར་པས་མིག་དང་བཞིན་རྒྱས་པར་གྱུར་ཏེ་ཆེད་དུ་བརྗོད་པ་བརྗོད་ནས་དེ་བཞིན་གཤེགས་པའི་བསམ་གྱིས་མི་ཁྱབ་པ་ཉིད་ཡིད་ལ་བྱེད་ཅིང་འདུག་པ་ལ།",
    "དེ་ནས་གསང་བ་པའི་བདག་པོ་ཅང་མི་སྨྲ་བར་འདུག་སྟེ།",
    "དེ་ཐམས་ཅད་ཀྱི་ཚེ་ཚོང་དཔོན་གྱི་བུ་ནོར་བཟང་ཉིད་ཀྱང་དེའི་དྲུང་ན་འདུག་ཅིང་ཡུན་དེ་སྙེད་དུ་བྱ་བ་བྱས་ཤིང་དྲན་པ་མ་ཉམས་པར་རྣམ་པ་ཐམས་ཅད་ཁོང་དུ་ཆུད་པའི་ཚུལ་གྱིས་ཤེས་སོ།",
    "གནོད་སྦྱིན་གྱི་གཞལ་མེད་ཁང་མིའི་ཁང་པ་ན་འདུག་པའི་ལ་མིའི་ཁང་པ་གནོད་སྦྱིན་གྱི་ཁང་པའི་ཁོངས་ན་འདུག་པ་ནི་ཕན་ཚུན་ཐ་མི་དད་དེ་ལས་ཀྱི་ཡུལ་རྣམ་པ་ཇི་ལྟར་དག་པའི་ཚུལ་བཞིན་དུ་སྣང་བ་དང་།",
    "སྐྱེས་བུ་དམ་པ་འདིས་བཀོད་པ་ཆེན་པོ་བསྟན་ནས་སྟོན་པ་ལ་ཕྱག་ཀྱང་མི་འཚལ་བར་སྟན་ལ་འདུག་པར་སྣང་ཞེས་སྨྲས་པ་དང་།",
    "དེའི་སྐལ་པ་ཇི་ལྟ་བ་བཞིན་དུ་རྨི་ལམ་དུ་སྣ་ཚོགས་པའི་གཟུགས་གང་ཡང་རུང་བས་དེའི་མདུན་དུ་འདུག་ནས།"
  ]
}