    "བཟོ་རིག་པ་སྔ་མོ་ཞིག་ནས་མི་རིགས་གཞན་དུ་སྤེལ་བའི་རྟགས་སུས།",
    "རྒྱུང་བྱང་གི་རི་མོ།",
    "ལི་ཡུལ་ནས་བོད་སྔ་རབས་ཀྱི་ལྷ་རིས་བྲིས་ཡོད་པའི་བྲག་ཕུག་དང་བོད་ཡིག་གི་ཡིག་ཚང་མང་པོ་རྙེད་ཅིང་དེའི་དངོས་པོ་ད་ལྟ་ཡོ་རོབ་ཀྱི་དངོས་མཛོད་ཁང་དུ་མར་ཉར་ཡོད།་",
    "དེང་གི་བོད་རིག་པའི་ཞིབ་འཇུག་པ་དུ་མས་རི་བོ་བྱ་རྐང་གི།",
    "གསང་སྔགས་ལྷ་ཚོགས་ཀྱི་ལྡེབས་རིས་སུ་བརྡ་རྙིང་བོད་ཡིག་གི་ལོ་ཚིགས།",
    "སྦྱིན་བདག་གི་མིང་།",
    "སྤྱི་ལོ་༨༤༥ལོ་ཧུའུ་ཁྲང་གིས་བར་ནསརྒྱ་ནག་གི་ནང་བསྟན་བསྣུབས་ཀྱང་ཏུན་ཧོང་གི་བཟོ་དངོས་རིག་གཞུང་དང་བཅས་པ་ལ་བོད་རིག་གཞུ་འབའ་ས་ཆེ་ཀྱིས་སྲུང་སྐྱོབ་བྱས།",
    "མི་རིགས་དེའི་རྟེན་བཞེངས་དང་དམངས་ཁྲོད་ཀྱི་མཛེས་རྒྱུན་རི་མོ་ཐམས་ཅད་ད་ལྟའི་བར་དུ་བོད་ཀྱི་བཟོ་རྒྱུན་ཡིན།",
    "དེའི་སྔ་རྗེས་སུ་དེང་གི་ནང་སོག་ཏུ་གཞི་བོད་ལུགས་ལ་རྒྱ་ནག་གི་བཟོ་རྒྱུན་འདྲེས་པའི་ལུགས་སྤེལ་བ་ལ་སོག་ལུགས་ལྷོ་མ་སྟེ།",
    "དེ་རྗེས་ཆིང་གི་ནང་བློན་རྒྱ་བོད་དང་སོག་བོད་ཀྱི་ལོ་ཙཱ་ཆེན་མོ།",
    "སོག་པོའི་རིགས་མགོན་པོ་གྲགས་པ་ཟེར་བ་དེས་བོད་ཡིག་གིས་བདེ་བར་གཤེགས་པ་སྐུ་གཟུགས་ཀྱི་ཐིག་རྩ་ཞེས་པའི་བསྟན་བཅོས་དེ་རྒྱ་ཡིག་ལ་བསྒྱུར།",
    "དེའི་སྔོན་རྗེས་སུ་ཚལ་པ་སྐལ་ལྡན་མགོན་པོ་སོགས་བོད་ཀྱི་བཟོ་བོ་མང་པོ་རྒྱ་ནག་ཏུ་སོང་ནས་བོད་ལུགས་ཀྱི་རྟེན་གསུམ་བཞུགས་གནས་དང་བཅས་པ་བཞེངས།",
    "སྣག་བྲིས་རི་མོ་གཉིས་དང་ཕྱོགས་མཚུངས་ཀྱི་གནས་བརྟན་བཅུ་དྲུག་དང་།",
    "འབྲུག་གི་འདག་སྐུ་བཞེངས་པའི་ལག་རྩལ་ལ་སྐད་གྲགས་ཆེན་པོ་ཡོད།",
    "བོད་ལྗོངས་ལྷོ་ཁ་ཕྱོགས་ཀྱི་མོན་པ་བཅས་ནི།",
    "རང་རང་ལ་ཡུལ་སྐད་རེ་ཡོད་པ་ཙམ་ལས་ཡི་གེ་ཕལ་ཆེར་བོད་ཡིག་སྤྱོད་ཅིང་བོན་དང་བོད་བརྒྱུད་ནང་བསྟན་ལ་དད་པ།",
    "རེབ་གོང་སྒྱུ་རྩལ་ཞེས་ཡོངས་སུ་གྲགས་པའི་བཟོ་བོ་ཕལ་ཆེ་བ་ཞིག་སྟོད་ཧོར་གྱི་བཟོ་བོ་ཡིན་ལ།",
    "རི་མོའི་སྒྱུ་རྩལ་ལ་མཆོག་ཏུ་མཁས་པ་མང་སཔོ་བཞུགས།",
    "བབསཔཀ་ཤི་མུར་ཆེས་སྔ་མོ་ཞིག་ནས་བོད་དང་འབྲེལ་འདྲེས་ཆེ་ཞིང་དེའི་བཟོ་བོས་བོད་ལུགས་། འཆོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "རྒྱན་བརྐོས་རི་མོ།",
    "དེང་དུས་བཀའ་གདམས་ལུགས་སུ་འབོད་པའི་གུ་ཙཚ་སགེའི་ཕྱོགས་ཀྱི་བཟོ་ཁྱད་པར་ཅན་གྱི་རི་མོ་ཕོན་ཆེ་བའང་ཡུལ་དེའི་བཟོ་བོས་བཞེངས་པ་ཡིན།",
    "པ་༤ འ་བལ་བོད་གཉིས་ཆེས་སྔ་མོ་ཞིག་ནས་འབྲེལ་འདྲིས་ཆེ་ཞིང་།",
    "མེས་སྲོང་བཙན་ནས་དེང་གི་བར་སྤྲུལ་པའི་བཟོ་བོ་ཨ་ཉི་དགའ་སོགས་བལ་པོའི་བཟོ་བོ་མང་པོ་གདན་འདྲེན་ཞུས་ནས་རང་རེ་གངས་ཅན་གྱི་ཡུལ་དུ་ལག་རྗེས་བཟང་པོ་འབོར་ཆེན་བཞག་པ་དང་ཆབས་ཅིག་བོད་ལུགས་ཀྱིས་བལ་བཟོ་ལའང་ཤུགས་རྐྱེན་ཐེབས་ནས་བལ་ཡུལ་དུ་བོད་ལུགས་ཀྱི་བཟོ་རྒྱུན་སྤེལ།",
    "བོད་ཀྱི་མཆོད་ཆས་དང་རྒྱུན་ཆ་མགར་ནས་བྱུང་བའི་སྔ་མོའི་ཅ་ལག་མང་པོ་བོད་ཁམས་ཀུན་ཏུ་ཉར་ཡོད་པ་དང་འཚབ།",
    "པད་དཀར་དགོན་གཙོས་པའི་དགོན་ཆེན་ཁག་ཕྱི་སོག་གི་དགའ་ལྡན་ཐེག་ཆེན་གླིང་།",
    "འཇང་གི་དགོན་ཁག་བཅུ་གསུམ།",
    "རི་བོ་བྱ་རྐང་གི་སྒྲོལ་མ་ལྷ་ཁང་།",
    "དགོས་མཁོ་དང་བསྟུན་ནས་རྒྱལ་ཕྱི་ནང་གི་བཟོ་བོ་མང་པོས་བོད་བཟོའི་རི་མོ་དང་།",
    "དེ་ཐམས་ཅད་ས་གནས་དང་རྒྱལ་ཁབ་དེ་གའི་དེང་གི་རྒྱུ་ཆས་དང་བོད་ལུགས་ཀྱི་བཟོ་བཀོད་གཉིས་ཟུང་དུ་འབྲེལ་ནས་བསྐྲུན་པ་འབའ་ཞིག་ཏུ་སྣང་བས་ན།",
    "རང་རེ་གངས་ཅན་པའི་ཐུན་མོང་མ་ཡིན་པའི་བཟོ་རྒྱུན་གྱི་ས་བོན་དེ་འཛམ་གླིང་ཡུལ་གྲུ་དུ་མའི་ཀ་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "བོད་ཀྱི་ལག་ཤེས་ཞིབ་འཇུག་ཁང་གི་གཙོ་འགན་སོགས་ཀྱི་ལས་འགན་བཞེས་ཡོད་ཕྲན་དཔྱད།",
    "དེ་རྣམ་ནི་མི་རིགས་མང་པོའི་བློ་གྲོས་ཀྱི་ཉིང་བཅུད་མཉམ་གཅིག་ཏུ་འདུས་བ་ལས་བྱུང་བ་ཤ་སྟག་ཏུ་འདུག་དེ་བཞིན་རང་རེའི་བོད་ཀྱི་བཟོ་རིག་པ་འདིར་མཚོན་ནའང་།",
    "སྐུ་གསུང་ཐུགས་རྟེན་གཙོ་བྱས་པའི་བཟོ་རིག་གི་བསྟན་བཅོས་མང་དུ་བསྒྱུར་ཞིང་མཛད་པ་མ་ཟད།",
    "ལུགས་ཡང་དག་པར་བསྟན་པའི་གཞུང་ལུགས་ཤིག་བཏོད་པ་ལ་བརྡ་སྤྲོད་པའི་གཞུང་ལུགས་ཞེས་བརྗོད་པ་རེད།",
    "ཡང་ཤར་ཕྱོགས་རྒྱལ་ཁབ་ལ་མཚན་འགྲེལ་དང་བཅས་པ་ཞིག་ཡོད་པ་དེར་ངོས་འཛིན་པ་རེད་སསསསསསཔསསསསསསཔསབ་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "རྒྱ་གར་དང་ཨོའོ་གླིང་སྐད་བརྡའི་ཁྲོད་ད་བར་ཉར་ཚགས་བྱུང་བའི་བརྡ་སྤྲོད་གཞུང་ལུགས་ཆེས་སྔ་ཤོས་དེ་ཡིན་པར་ངོས་འཛིན་བྱེད་ཅིང་ཕྱིས་སུ་གཞུང་ལུགས་དེའི་འགྲེལ་བའམ་དེ་ལ་བརྟེན་ནས་བརྩམས་པའི་བསྟན་བཅོས་མང་དུ་བྱུང་བའི་ཁྲོད་གྲགས་ཆེ་ཤོས་ནི་ཀ་ཙན་དབྱངས་གསུམ་ཞེས་སྒྲའི་བསྟན་བཅོས་རྒྱུས་བསྡུས་ཅི་རིགས་བྱུང་བ་དག་རེད།",
    "དུས་པ་མའ་ཆབཀའ་རབས་ཉི་ཤུ་པའི་ལོ་རབས་ཉི་ཤུའི་ནང་ལི་ཅིན་ཞིས་དབྱིན་ཡིག་གི་བརྡ་སྤྲོད་ལ་དཔེ་བྱས་ནས་རབས་ན་སུ་དེང་དུས་རྒྱ་སྐད་ཀྱི་བརྡ་སྤྲོད་གསུང་རྩོམ་གསར་མ་ཞེས་པ་ཞིག་བརྩམས་ས་བ་ས་ཡོད་པ་དེ་དེང་དུས་རྒྱ་སྐད་ཀྱི་བརྡ་སྤྲོད་རིག་གཞུང་ཨང་དང་པོ་ཡིན་པར་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།",
    "འདིརམན་རང་རེ་བོད་འདིར་མཚོན་ན་སྤྱི་ལོའི་དུས་རབས་བདུན་པའི་ནང་ལོ་ཙཱ་བའི་ཐོག་མ་དང་ནས་བདུན་པ་མའ་འཕྲུལ་བློན་མཛངས་མི་བདུན་གྱི་བཞི་པ།",
    "ཏུན་ཧོང་གི་ཤོག་དྲིལ་སོགས་ནང་སུམ་རྟགས་ཀྱི་དགོངས་པ་དང་མི་མཐུན་པའི་རིགས་གང་ཡོད་པ་དཔེར་དྲངས་པའམ་ཡང་ན་སུམ་རྟགས་ཀྱི་དོན་འགྲེལ་རྙིང་མ་འགའ་ཞིག་གི་ནང་དོན་དང་བསྡུར་བ་གནང་ནས་སུམ་རྟགས་ཀྱི་རྩ་བ་ནི་བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་སྐུ་རིང་ལྟ་ཅི།",
    "སམྦྷོ་ཊ་ཡིས་མཛད་པ་ཡིན་ན་དེ་མཛད་པོ་ནི་སྲོང་བཙན་སྒམ་པོའི་དུས་སུ་ན་ཞེས་ནང་འཚོ་བཞེས་གནང་བ་ཞིག་ལ་ཁས་ལེན་ཐུབ་ཀྱི་མི་འདུག་ང་ཚོས་བརྡ་སྤྲོད་པའི་གཞུང་ལུགས་བརྩམས་པའི་མཛད་འཕྲིན་ཁོང་ལ་སྤྲོད་ཆོག་ཀྱང་།",
    "ཡང་འགའ་ཞིག་གིས་ཏུན་ཧོང་གཏེར་ཡིག་དང་རྡོ་རིང་ཡི་གེ་སོགས་སུ་སུམ་རྟགས་གཉིས་ཀྱི་རྩ་བ་དང་མཐུན་པའི་རིགས་མང་དུ་ཡོད་པ་དཔང་དུ་བཞག་ནས་ཡིག་རྙིང་དེ་དག་སུམ་རྟགས་རྩ་བ་ཐོན་མིའི་མ་ཡིན་པའི་སྒྲུབ་བྱེད་དུ་འགྲོ་རྒྱུ་ལྟ་ཞོག་དེ་ལས་ལྡོག་སྟེ།",
    "སུམ་རྟགས་ཀྱི་རྩ་བ་ཐོན་མིའི་ཡིན་པའི་སྒྲུབ་བྱེད་ཡང་དག་ཏུ་སོང་ག་འདུག་ཅེས་པ་དང་།",
    "མིག་ལམ་དུ་ཡོད་ཀྱང་མ་མཐོང་བ་རེད་ཅེས་པ་སོགས་སུམ་རྟགས་རྩ་བ་སློབ་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "ལོ་དུས་གང་ཙམ་ལ་བྱུང་མིན་ཐད་རང་རང་གི་དགོངས་ཚུལ་མི་འདྲ་ཙམ་བྱུང་ཡོད།",
    "ཐོན་མིའི་ཞལ་ལུང་བའ་ཅནའབརྡ་སྤྲོད་བློ་གསལ་དགའ་སྟོན་སོགས་བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་ཕལ་མོ་ད་ཆབ་གཙ་ཚེའི་ནང་སྤྱི་ལོའི་དུས་རབས་བདུན་པའི་སྐབས་རྒྱལ་པོ་སྲོང་བཙན་གྱི་བློན་པོ་ཐོན་མིས་བོད་ཡིག་ཟས་གསར་བཟོ་མཛད་པ་དང་རིམ་གྱིས་བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་སུམ་ཅུ་པ་དང་རྟགས་ཀྱི་འཇུག་པ་གཉིས་མཛད་པའི་དགོངས་ཚུལ་གཅིག་མཐུན་ཡིན་པ་ལྟར་སུམ་རྟགས་གཉིས་ཀྱི་རྩ་བ་ནི་སྤྱི་ལོའི་དུས་རབས་བདུན་པའི་ནང་སློབ་དཔོན་ཐོན་མིས་བརྩམས་གནང་བ་ནི་བདེན་པ་རང་ཡིན་ནོ།",
    "འོན་ཀྱང་དུས་ཡུན་ངེས་ཅན་ཞིག་གི་རིང་སློབ་དཔོན་ཐོན་མིས་གཏན་ལ་ཕབ་པའི་བརྡ་སྤྲོད་གཞུང་ལུགས་ཀྱི་དགོངས་པ་ཚུལ་བཞིན་ལག་ལེན་མ་བྱུང་སྟབས་སྔར་གྱི་ཡིག་རྙིང་ཁྲོད་ཡུལ་སྐད་སྤྱོད་ཤུགས་ཆེ་བ་དང་ར་ནས།",
    "རྒྱ་གར་གྱི་ཡི་གེ་ལ་དཔེ་བྱས་ནས་བོད་ཡིག་གི་གཟུགས་བརྩམས།",
    "གཞན་གྱི་ལད་མོ་མ་ཡིན་རང་སྟོབས་ཀྱིས།",
    "ཁ་ཆེ་ཨཱ་ནནྟ་སོགས་ལོ་ཙཱ་བ་རྒན་གཞོན་བར་གསུམ་གྱིས་གཞུང་ལུགས་ཤིན་ཏུ་མང་པོ་བོད་ཡིག་ཏུ་བསྒྱུར་བ་མ་ཟད་མིང་དང་ཚིག་གི་ཐ་སྙད་དཔག་ཏུ་མེད་པ་གཏན་ལ་ཕབ་སྟེ་བརྡ་སྤྲོད་གཅིག་མཐུན་ཡོང་རྒྱུར་ཕན་པ་བསྐྲུན་པ་དང་།",
    "ཁྱད་པར་དུ་ལོ་ཙཱ་བ་ལྕེ་ཁྱི་འབྲུག་གིས་སྒྲའི་བསྟན་བཅོས་གནས་བརྒྱད་ཆེན་པོའི་རྩ་བ་བསྒྱུར་བ་དང་།",
    "ཡི་གེ་ཉུང་བའི་ཆེད་དུ་མ་དོར་ནས་ཡུལ་དུས་དང་མཐུན་པའི་གོ་སླ་ཞིང་འདོན་བདེ་བར་བྱས་མྱ་ད་དྲག་རྐྱང་པའི་འ་བརྟེན་སོགས་དོར་ཏེ་གཞུང་ཚད་རྣམས་ཀྱང་བམ་གྲངས་སོགས་ངེས་པར་བྱེ་བྲག་རྟོགས་བྱེད་ཆེན་མོ།",
    "བྱེ་བྲག་རྟོགས་བྱེད་ཆེན་མོ་དང་།",
    "དཔེར་ན་ཞོལ་རྡོ་རིང་གི་ངོས་སུ་ལ་དོན་གྱི་ཕྲད་ཏུ་སྒྲ་གཅིག་ཀྱང་མེད་པ་དང་འབྲེལ་སྒྲ་དང་བྱེད་སྒྲའི་ཕྲད་ས་ཀྱི་དེང་ཀྱིས་སྒྲ་མཐོང་དཀོན་ནའང་དབོན་ཞང་རྡོ་རིང་དང་ཞྭ་ལྷ་ཁང་གི་རྡོ་རིང་ངོས་སུ་ཐོབ་པ་ཐང་ལྟར་འཇུག་པའི་ལ་དོན་གྱི་ཕྲད་ཏུ་སྒྲ་དང་བྱེད་འབྲེལ་གྱི་ཕྲད་ཀྱི་ཀྱིས་གྱི་གྱིས་སོགས་ཀྱི་སྦྱོར་ཚུལ་གཏན་ཆགས་ལྟར་བྱུང་བ་ལྟ་བུའོ།",
    "གང་དུ་བསྟན་པ་དར་ཆེ་བ་དེ་ན་ཡི་གེ་ཤིན་ཏུ་དག་པ་བྱུང་ཞིང་བསྟན་པ་འཕང་དམའ་རུ་སོང་བ་ན་ཡི་གེ་ཡང་ཅལ་ཅོལ་དུ་འགྲོ་བ་ཡིན་ཞེས་གསུངས་པ་ལྟར་སྲོང་བཙན་སྒམ་པོ་དང་།",
    "ཁྲི་རལ་པ་ཅན་སོགས་བཙན་པོ་གོང་མ་རྣམས་ཀྱི་དུས་སུ་བརྡ་སྤྲོད་གཞུང་ལུགས་གསར་བད་དང་རིམ་བཞིན་འཐུས་ཚང་ཡོང་སླད་གཞུང་ལུགས་དེ་ཉིད་དང་འབྲེལ་བའི་བསྟན་བཅོས་མང་དུ་བྱུང་ཡོད་ཀྱང་བཙན་པོ་དར་མ་འུ་དུམ་བཙན་གྱི་དུས་སུ་ཕྱོགས་གཅིག་ནས་སྐབས་དེའི་བོད་ཀྱི་ཆབ་འོག་ཁྱབ་རྒྱ་ཧ་ཅང་ཆེ་བས་སྲུང་དམག་གི་མི་རྒྱུའི་འགྲོ་གྲོན་མི་འདང་བ་དང་།",
    "ཆ་ད་ལྟ་སུམ་ཅུ་པ་དང་རྟགས་འཇུག་གི་རྩ་བ་གཉིས་ལས་དེ་འཕྲོས་སམ་ས་༣་བཔསོ་དར་དང་དྲུག་བསྟན་པ་སྔ་དར་དང་ཕྱི་དར་གྱི་མཚམས་སུ་ནུབ་ནས་དཔེ་མ་བྱུང་བས་ན་ཤིན་ཏུ་ཕངས་ཆེ་ཡ་ངལ་མ་ལ།",
    "པརསྤྱི་ལོའི་དུས་རབས་ཉི་ཤུ་པའི་ལོ་སྟོད་དུ་དངུལ་མསསཆུ་དབྱངས་ཅན་གྲུབ་པའི་རྡོ་རྗེས་མཁས་མཆོག་སི་ཏུ་པཎ་ཆེན་དང་ཐམས་ཅད་མཁྱེན་པ་དངུལ་ཛའ་ཆུ་དྷརྨ་བྷདྲ་དཔལ་བཟང་པོའི་དགོངས་པ་གཙོར་འཛིན་ཐོག་སྔོན་བྱུང་གི་འགྲེལ་བ་མང་པོར་སྙིགས་དོར་བཅུད་ལེན་གནང་སྟེ་སུམ་རྟགས་གཉིས་ཀྱི་རྩ་བར་མི་གསལ་བའི་ཕྲད་འགའ་ཞིག་དང་།",
    "ཅེས་པ་སོགས་ཕྲད་མང་དག་ཅིག་གི་ངེས་སྲོལ་དང་༥་ཉེ།",
    "བོད་ཡིག་ལས་དོན་འ་གདངས་པས་སྒྲ་སྦྱོར་དག་མིན་དབྱེ་འབྱེད་བྱེད་པའི་གཞི་རྟེན་གལ་ཆེན་ཞིག་ཏུ་གྱུར་པ་རེད།",
    "བོད་སྐད་བརྡ་སྤྲོད་གཞུང་ལུགས་ཞིབ་འཇུག་བྱེད་པའི་དུས་རིམ་རྒྱུནན་སྤྱི་ལོའི་དུས་རབས་ཉི་ཤུ་པའི་ལོ་རབས་སུམ་ཅུའི་ཡས་མས་ཙམ་ནས་དེང་རབས་སྐད་བརྡ་རིག་པ་དར་ཁྱབ་ཤུགས་ཆེན་བྱུང་བའི་སྟབས་ཀྱིས་སྔར་བརྡ་སྤྲོད་གཞུང་ལུགས་དེ་ཉིད་ཚིག་འགྲེལ་དང་དོན་འགྲེལ་གཙོར་བཟུང་གིས་རྒྱུད་འཛིན་བྱེད་པའི་རྣམ་པ་དེ་རིམ་བཞིན་མཁས་བརྒྱ་འགྲན་གླེང་དང་།",
    "དེར་དུམ་པ་བཞི་ཡོད་པ་མངའ་བདག་ཁྲི་སྲོང་ལྡེ་བཙན་གྱིས་ཕྱི་མོ་གནང་ནས་རེག་ཟིག་སྔོ་དམར་བཞེངསཚན།",
    "བརྒྱུད་ལས་བས་རེག་ཟིག་སྔོ་དམར་ལ་སོགས་ཧ་ཅང་བསྡུས་དྲགས་པས་བེ་རོ་ཙ་ན་རཀྵིཏས་རྒྱ་དཔེ་དང་༧བསྟུན་ནས་ཞུས་དག་མཛད་ཅིང་འགྲོས་རྐང་ཆད་པ་གསབ་སྟེ་ཚིག་སྣ་རིང་བར་བཅོས་ཏེ་དུམ་པ་དྲུག་གླེགས་ཤིང་ལ་པར་བཀབ་བཅོས་པ་ལས་པར་བཀབ་ཅན་དུ་ཐོགས།",
    "བླ་འགྱུར་ཆེན་མོར་གྲགས་སོ།",
    "ན་གོང་དུ་བརྗོད་པའི་བླ་འབུམ་ཁག་ལས་འབུམ་རེག་ཟིག་སྔོ་དམར་དང་བླ་འབུམ་སྐྱ་བོ།་",
    "བཙནམས་འན་འ་བླ་འབུམ་ཤ་སྒྲོ་ཅན་སོགས་ཕྱིས་སུ་གང་དུ་བཞུགས་མིན་ཐད་ལོ་ལྔ་བརྒྱ་དྲུག་བརྒྱའི་གོང་གི་ཡིག་རབས་༨་༤་པརབ་བའ་ངལ་བར་ཆ་ཁག་ལ་གསལ་བར་འཁོད་མོད།",
    "ལྷ་ཁང་ཁག་གི་དཀོན་གཉེར་སྤྲོད་དེབ་སོགས་སུའང་གང་ཡང་མི་གསལ།",
    "འ་༣་སྐར་ཆུང་གཙུག་ལག་ཁང་མེས་ཚིག་པ་ཐལ་བའི་གསེབ་ནས་མ་ཚིག་པར་བྱོན་པ་ལགས་བྱིན་གྱི་ག་བ་རླབས་ས།",
    "གླེགས་བམ་ཁ་པར་ལྡེབ་༥༧༤དང་གླེགས་བམ་ག་པར་ལྡེབ་༦༡༤བཞུགས་པཕྲེང་༡༢ཡོད་པའི་པོད་ཤིན་ཏུ་ཆེ་བ་ཞིག་རེད་འདུགནཁྲི་ལྡེ་སྲོང་བཙན་གྱི་བླ་འབུམ་འདི་ཡི་ཕྱི་མོ་གང་ལ་གཏུགས་སྙམ་ན་དབུ་ཤོག་སྟེང་གླེགས་འི་༧ ༡སས་བམ་བཞི་ཡོད་ཚུལ་འཁོད་པ་དང་།"
  ]
}