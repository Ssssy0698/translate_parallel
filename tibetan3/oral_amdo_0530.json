    "སྨད་རྒྱུད་དུ་ཕེབས་ནས་སྔགས་ཀྱི་དམ་བཅའ་ཆེན་མོ་མཛད།",
    "ཟུར་བཀའི་དཀྱིལ་འཁོར་ཆེན་པོ་ཡོངས་རྫོགས་ལན་འགའ་རེ།",
    "འདུ་ཁང་ཆེན་མོ་སོགས་གསར་བཞེངས་མཛད་ཅིང་།",
    "མཇུག་ཏུ་གཡེར་གཤོང་ནས་དཀྱིལ་འཁོར་གདན་དྲངས་ཏེ་གནྡྷོ་ལའི་རྒྱ་མཐོངས་སུ་བཀྲམ་སྟེ་དཔའ་བོའི་སྟོན་མོ་རྒྱས་པ་གནང་།",
    "ཀུན་མཁྱེན་ཁྱོད་ལ་གཟུར་གནས་སུ་མི་དད།",
    "མཛད་བཟང་གི་འཕྲིན་ལས་ཀྱིས་ཡུལ་ཁམས་སྐྱོང་བཞིན་ནམ་ཞིག་ན།",
    "འབྲོམ་སྟོན་པ་ཤ་བ་ཞིག་ལ་ཞོན་པ་གཟིགས་པས་ཧ་ཅང་དགྱེས།",
    "དེ་ནས་གོང་སའི་བཀའ་ལྟར་ཆུ་ལུག་ལོར་གསེར་ཁྲི་ཆེན་མོར་ཕེབས།",
    "ནམ་མཁའ་ལས་ཉི་མ་གཉིས་ཤར་བར་ཡུམ་རང་གིས་གཅིག་ལ་གོས་སྐུད་ཀྱིས་རྟགས་ཤིག་བརྒྱབ་ནས་བཞག་པ་རྨིས།",
    "བྱིས་པས་ཨ་མ་བཙན་བཙན་ཞེས་གསུང་ཕེབས་པས་མ་སྐྲག་སྟེ་ཡིབ།",
    "དེ་ནས་རང་ཡུལ་དུ་བཞུགས་སྐབས་སྔར་བཞིན་སྨྲ་མི་ནུས་པའི་ཚུལ་གྱིས་བཞུགས་པར་ཨ་མ་ཡང་ངོ་མཚར།",
    "ཡང་ལན་གཅིག་མཛོ་མོ་ཞིག་བོར་སོང་བར་མས་ནོར་མ་ལ་རྡུང་སྡིགས་མང་དུ་བྱས་པར་ཡང་ཞལ་ནས།",
    "ཁྱོད་ཀྱི་མཛོ་མོ་རྐུན་མ་གཉིས་ཀྱིས་ཁྱེར་ནས་འགྲོ་གིན་འདུག་གསུངས་པ་ལྟར་རྗེས་སུ་བསྙེགས་པ་ན་དོན་སྟེང་དུ་ཁེལ་བས་ཐམས་ཅད་ངོ་མཚར།",
    "མས་ཁྱོད་ཀྱིས་ཇི་ལྟར་ཤེས་པ་ཡིན་ཞེས་དྲིས་པ་ལ།",
    "ཡང་ཉིན་གཅིག་ལ་བུ་ཆུང་རྟར་བསྐྱོན་ཡོད་པའི་སྐབས་རྟ་འདྲོགས་ཏེ་སྒང་གཤོང་ཐང་གསུམ་ཀུན་ཏུ་ཁུར་ནས་བརྒྱུགས་ཀྱང་སར་མ་ལྷུང་བར་ཨ་མས་ཁྱོད་མི་སྐྲག་གམ་ཞེས་དྲིས་པ་ན།",
    "ཁྲི་ཟུར་ནས་ཀྱང་ཐུགས་དམ་ལ་ཐརྩོན་བཞིན་པའི་སྐབས་ཤིག་མཚན་ལམ་དུ་རང་ཕྱག་ན་རྡོ་རྗེ་དངོས་ཡིན་པར་རྡོ་རྗེ་ཕྲག་པར་ཁྱེར་ནས་འགྲོ་གི་ཡོད་པ་ཞིག་རྨིས།",
    "གཡུ་རྔོག་སྔགས་རམས་པའི་རྨི་ལམ་དུ་འབྲོམ་སྟོན་རྡོ་དྲིལ་དང་བུམ་པ་ཕྱག་ཏུ་ཐོགས་པ་ཞིག་གིས་བནྡེ་ཐར་གྱི་བུའི་མིང་ལ་འཇིགས་བྱེད་རྡོ་རྗེ་ཐོགས་གསུངས་པ་རྨིས་པ་དང་བསྟུན་ནས་མཚན་གསོལ།",
    "ཁྱོད་ཀྱིས་རྟིང་སྐུལ་གཏོང་སྒོ་བཟང་བོའི་ངོས་ནས་གྲྭ་ཚང་གི་རྩོད་གྲྭར་ཕན་ཐོགས་ཆེན་པོ་བྱུང་ཡོད་སྐབས་འདིར་རྩོད་པར་ཉན་བསམ་པ་འདུག་པས།",
    "ད་རེས་ཀྱི་དམ་བཅའ་ཆེན་མོ་ངེད་ཀྱི་གཟིམ་ཁང་ར་སྐོར་ནས་ཚུགས་དགོས་གསུངས་པ་ལྟར་ཉིན་གསུམ་རིང་ལ་བཀའ་པོད་ལྔའི་དམ་བཅའ་གནང་།",
    "རེ་སྐོང་གི་བོད་སོག་འཁྲུགས་པ་དང་ཟི་ལིང་མཁར་ལ་དམག་ཐེངས་གཉིས་བསྐྱོད་དོན་ཚབས་ཆེར་སོང་བ།",
    "རྗེ་གསུང་འབུམ་གྱི་ལུང་གནང་སྐབས་རྗེ་ཐམས་ཅད་མཁྱེན་པའི་ཞལ་གཟིགས་ཤིང་དགུང་ལོ་ང་དྲུག་པར་འདའ་ཉེ་བར་ཧིཀ་སྒྲ་མཐོན་པོ་ཞིག་གནང་སྟེ་མྱ་ངན་ལས་འདས།",
    "སྐུ་གདུང་ཆ་གཉིས་སུ་བྱས་ཏེ་གདན་ས་གོང་འོག་ཏུ་གདུང་རྟེན་མཆོད་རྟེན་རེ་བཞེངས་སོ། ། གདན་རབས་སོ་གསུམ་པ།",
    "སྤྱིར་ཁྱེད་རང་གི་མཛད་འཕྲིན་ལ་སྲུང་མ་ཁྱད་པར་ཅན་ཞིག་གིས་གྲོགས་མཛད་པར་ཡོད།",
    "སྐྲའི་ལན་ཚར་རིང་བོ་ཅན་ཞིག་གིས་རྟག་ཏུ་བྱ་བ་གང་བརྩམས་ལ་མཐར་ཐོན་གྱི་གྲོགས་མཛད་ཀྱིན་འདུག་པས།",
    "རྒྱུད་ཁྲི་དང་དུས་འཁོར་ཁྲི་བ་གཉིས་ཀར་ལོ་འགའ་རེ་བཞུགས།",
    "ཨ་རོལ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོ་གསུམ་ནི་སྲས་ཀྱི་ཐུ་བོ་ཡིན་པར་གསུངས།",
    "ཕྱིར་ཕེབས་ནས་ཨུངྒེ་གྲྭ་ཚང་གི་ཁྲི་བར་ཕེབས།",
    "དགུང་ལོ་རེ་གསུམ་པ་ལ་གཤེགས།",
    "ཨ་མཆོག་མགོ་ལོག་སོགས་བརྒྱུད་དེ་དབུས་སུ་ཕེབས།",
    "རང་དགོན་དུ་གོང་སའི་བཀའ་ལྟར་གསེར་ཁྲི་ཆེན་མོར་ཕེབས་ཏེ་གྲྭ་ཚང་རང་གི་སྔར་ནས་བཟུང་འཆད་ཉན་གྱི་གཞིར་མཛད་པ་ར་སྟོད་བསྡུས་གྲྭ་དང་།",
    "ཞེས་གསུངས་ཏེ་ད་ཡིག་གི་མཚན་མ་ཞིག་བཀོད་པ་སྐུ་སྔ་ཕྱི་འདས་འཁྲུངས་དང་།",
    "འཁྲུངས་ས་ད་ནི་ཡིན་པར་འཕིགས་ཚུད་དེ་གདན་སར་བཀོད།",
    "སྐྱབས་མགོན་སྐུ་ཕྲེང་དྲུག་པའི་ཡོངས་འཛིན་གནང་སྟེ་གོང་ས་མཆོག་གི་འཕྲིན་ལས་ཀྱི་སྒོ་འཕར་ཡངས་པོར་ཕྱེ།",
    "གསེར་ཁྲིའི་སྐབས་ཀྱི་ཟང་ཟིང་གི་ལྷག་མ་ཆུད་གཟན་མི་རུང་གསུངས་ནས་དངུལ་འབུམ་གསེར་གྱི་སྐ་རགས་ཅན་གཞུང་ཁང་དང་བཅས་པ་གསར་བསྐྲུན་མཛད་ཅིང་།",
    "སྟག་ལུང་གྲུབ་པས་དཔལ་ལྡན་ལྷ་མོས་བེ་ཅོན་ལན་གསུམ་བསྐོར་ནས་བདག་གིར་བཞེས་སོང་ཞེས་གསུངས།",
    "གིང་ལྔ་གཟའ་གདོང་གི་སྲོག་གཏད།",
    "དུས་འཁོར་གྲྭ་ཚང་གིས་ཞུས་པ་ལྟར།",
    "གོང་ས་༧སྐྱབས་མགོན་དྲུག་པ་ཆེན་མོ།",
    "རྗེ་ཨ་རོལ་རྗེ་བཙུན་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོ་ལས་རབ་ཏུ་བྱུང་ཞིང་།",
    "ཆུང་དུས་ནས་བཟུང་ཚོགས་བསགས་རྒྱ་ཆེན་གནང་བས་ཡོན་ཆབ་བྱེ་བ་དང་།",
    "འཇིགས་བྱེད་བཅུ་ཆ་ཆེན་མོ་ཚད་ལྡན།",
    "གཞན་ཡང་ཚོགས་མཆོད་དང་།",
    "གདན་སའི་གྲྭ་ཚང་རྣམས་ཀྱི་མཁན་ཁྲི་རིམ་བགྲོད་ཀྱིས་བསྐྱངས་པའི་རྒྱུ་སོང་རགས་རིམ་ལ་ཡང་དངུལ་སྲང་འབུམ་ཕྲག་ལྷག་སོང་ན་ཡང་ཞལ་བཞུགས་དུས་ཚུལ་དེ་དག་གཏན་ནས་མི་གསུང་ངོ།",
    "ཨ་རོལ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོ།",
    "ལུས་བཟོ་བྲི་ཐིག་འབུད་རྡུང་དང་།",
    "གསུང་རྩོམ་ཐད་སྙན་ངག་གི་ཉམས་དང་ལྡན་པའི་ཤུགས་འབྱུང་གི་བཀའ་རྩོམ་མཛད་མཁན་ཞིག་ལ་འདི་ཉིད་ངོ་མཚར་བ་ཞིག་ཡིན།",
    "དྲུང་ཡིག་པས་བྲིས་ན་གསུང་གི་རྗེས་སུ་མི་ཆོད་པ་ཡིན།",
    "རྒྱུ་ཆེ་གྲངས་མང་ཐོབ་འདི་སྐལ་བ་རེ་བཟང་ངོ།",
    "ཐོས་ཚད་དཔྱད་འཇོག་གིས་དབེན་པར་ཉམས་སུ་བཞེས་ཏེ་རྟོགས་པ་ཀློང་དུ་གྱུར་པ་ཡིན་ནོ།",
    "ད་དུང་འཇམ་དཔལ་མཚན་བརྗོད་དང་གང་བློ་མ་རེ་རེ་ནས་འབུམ་ཚར་དང་།",
    "ལམ་རིམ་ཆེན་མོ་བརྒྱ་ལྷགབདག་འཇུག་ཁྲིར་ཉེ་བ།",
    "གསུང་རྩོམ་ཡང་སྡོམ་གསུམ་ཆེན་མོ་སོགས་པོད་འགའ་པར་དུ་འཁོད་པ་དང་།",
    "སྐྱབས་མགོན་སྐུ་ཕྲེང་གིས་ཡོངས་འཛིན་དུ་བཀུར་བ་རྣམས་བགྲང་འོས་པས།",
    "གཡེར་གཤོང་མཆོག་སྤྲུལ་རྣམས་སྐྱབས་མགོན་སྐུ་ཕྲེང་གང་རིགས་ཀྱིས་ཡོངས་འཛིན་དུ་བཀུར་བའི་དམ་པ་དག་གི་སྐྱེ་རྒྱུད་ཡིན་ཞིང་།",
    "ཨ་རོལ་སྐུ་ཞབས་ཆེན་མོ།",
    "དེ་ཉིད་ཀྱི་ཡོངས་འཛིན་ཀླུ་སྒྲུབ་སྤྲུལ་བའི་སྐུ་སོགས་ལྷ་མོ་ཉིན་སྲིབ་ཀྱི་བླ་སྤྲུལ་དང་།",
    "གནམ་བསྐོས་ཕག་མོ་གྲུ་པའི་ལུང་གིས་ཨེར་ཏེ་ནི་པཎྜིཏ་ཝང་ཧོ་ཐོག་ཐུར་བསྔགས་པ་མཁས་དགུའི་གཙུག་རྒྱན་ཚེ་ཏན་ཞབས་དྲུང་འཇིགས་མེད་རིགས་པའི་བློ་གྲོས་དཔལ་བཟང་བོ་དང་།",
    "ངོ་མོའི་ཕྱག་མཛོད་བློ་བཟང་རྒྱ་མཚོ་སོགས་ཤར་བླ་བྲང་ཆེན་མོའི་མཛོད་པ་མཁན་ཆེན་སྔ་ཕྱི་རྣམས་དང་།",
    "དེ་དག་ཐམས་ཅད་ལ་རང་རང་གི་བློ་ཁ་དང་འཚམ་པར་ལམ་ཡོངས་རྫོགས་ཀྱི་ཉམས་ལེན་དང་གཞུང་ཆེན་མོ་ལ་ཐོས་བསམ་དང་།",
    "ཁོང་ཁྲི་ལས་ཐོགས་པའི་སྐབས་སུ་གྲྭ་ཚང་འདུ་ཁང་གསར་བཞེངས་ཀྱི་སྦྱོར་བ་ལ་གནས་པའི་སྒང་དུ་སོང་།",
    "ཆིག་ལབ་རིང་མོ།",
    "མ་ལྷ་མོས་རྗེས་བཟུང་དངོས་གྲུབ་ལྷ།",
    "གཞོན་ནུ་རོལ་རྩེད་མཛད་པར་སྔགས་པ་ཨག་ཚོམ་དཀར་བོ་རྩེ་གསུམ་འཛིན་པ་ཞིག་གིས་ཤིང་ཏོག་འགའ་ཕུལ་ནས།",
    "ད་ཁྱེད་ཀྱི་བདག་པོ་རྣམས་མྱུར་མོར་འོངས་པ་ཡོད།",
    "ཅེས་ཞུ་བ་ཡུམ་གྱིས་གསན་ནས་བཙལ་བ་ན་གར་སོང་ཆ་མེད་དུ་གྱུར།",
    "འཇམ་དབྱངས་ཁང་གི་སྔགས་པ་དེས་ང་ཕར་འཇོག་ཚུར་འཇོག་བྱས་པ་ཡིན།",
    "སྔགས་པ་ག་རེ་ཞུས་པར།",
    "དགུང་ལོ་བདུན་བརྒྱད་སྐབས་འཇམ་དབྱངས་དཀར་བོ་དང་དབྱངས་ཅན་མ་དཀར་མོ་གཉིས་ལ་བསྟོད་པ་རེ་གནང་བར་སྙན་ངག་གི་ཉམས་ཕུལ་དུ་བྱུང་བ་ཞིག་བྱུང་ཡོད་པར་གསུངས།",
    "ཇི་གིན་ལ་བསྟོད་སྐབས་རི་རྩེར་ཆུ་མེད་ཚུལ་ཞུས་པར་ཡོད་འགྲོ་གསུངས་པ་ལྟར་བྱུང་།",
    "སྒོམ་བྲག་གི་སྒྲུབ་གནས།",
    "གནས་སྐོར་སྐབས་ཤར་རི་དང་དབུས་རིའི་བར་འཇའ་ཚོན་ངོ་མཚར་བ་ཤར་བ་སོགས་ཡ་མཚན་པའི་ལྟས་མང་བོ་གཟིགས།",
    "ཀུན་གཟིགས་ཞིང་དང་མཚུངས་པའི་གནས་མཆོག་འདིར།",
    "གནས་གཟིགས་སྤྱི་འཐེབ་བསྩལ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་རྣམ་སྤྲུལ་ལས་བྱུང་བའི།",
    "གཞུང་ས་ཆེན་མོ་ནས་འཇའ་ས་ཐམ་ག་གྲུ་སྒོར།",
    "གདན་སར་འབྱོར་ནས་ཨ་རོལ་རྡོ་རྗེ་འཆང་ཞལ་མ་བཞུགས་པ་ལ་གྲྭ་ཚང་དུ་དུས་མཆོད་ཀྱི་འཐེབ་དངུལ་སྟོང་ཕྲག་སྦྱོར་འཇགས་གནང་།",
    "ཇོའི་ཁང་ལ་ངེད་འདུག་རིང་ཉིན་རེར་ལན་གསུམ་རེ་མཇལ་བ་ཡིན་ཡང་ནམ་མཇལ་རེས་ཀྱིས་སྔར་མཐོང་མ་མཐོང་བ་ཤ་སྟག་སྣང་བས་བློར་གཏན་མི་ཤོང་གསུངས།",
    "ཕྱག་མཛོད་དོར་ཉིན་ལྷུན་གྲུབ་རྒྱ་མཚོར་བཀའ་བསྒྱུར་ཏེ་རྡོ་ཚད་རེ་བདུན་གྱིས་གདན་སའི་གོས་སྐུ་ཆེན་མོ་གསར་དུ་བཞེངས།",
    "གཡེར་གཤོང་གི་ཡུམ་ཞིག་གསར་དུ་བཞེངས།",
    "དམིགས་བསལ་གྱི་སྐབས་རེར་མ་གཏོགས་བླ་ཆེན་གྱི་སྒྲུབ་མི་མཛད་པར་ཤིང་ཁག་དང་རྔ་རྩིད་ཀྱི་སྤྱན་ར་བསྣམས་པ་སོགས་རི་ཁྲོད་པ་ཕལ་བའི་ཆས་ཤ་སྟག་མཛད།",
    "དེ་ནས་བཟུང་དཀོར་གཉེར་བཞི་གཡོག་དང་བཅས་པས་ལོ་རེར་ཡོན་ཆབ་བྱེ་བ་འགྲོ་ངེས་ཀྱི་རྒྱུན་བཙུགས་ལ།",
    "སྐྱབས་མགོན་འདི་དང་དུས་མཉམ་དུ་སྒྲུབ་བསྟན་མངའ་བདག་ཨ་རོལ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོ་སོགས་སྤྲུལ་བ་ཡ་མ་ཟུང་གིས་བསྟན་འགྲོའི་དོན་མཛད་དོ།",
    "ནང་སོ་སྐུ་སྐྱེས་ཡང་སྲིད་བློ་བཟང་མཁས་མཆོག་ལ་ཨ་རོལ་བློ་བཟང་ལུང་རིགས་རྒྱ་མཚོ་ལས་རབ་ཏུ་བྱུང་ཞིང་དགེ་ཚུལ་བསྒྲུབས་འཕྲལ་དགའ་ལྡན་ལྷ་བརྒྱ་མའི་ཚོགས་ཞིང་གི་བྲིས་ཐང་བྱོན་ལེགས་དང་།",
    "རང་གི་གདན་སའི་གཟིམ་ཆུང་གི་གདུང་མའི་སྟེང་དུ་ཡང་མེ་ཏོག་ཁྲ་ཆིལ་ལེར་བཞད་པས་བཀའ་རྩོམ་འགའི་མཇུག་ཏུ་ཡང་གདུང་མ་མེ་ཏོག་བཞད་པའི་ལྡིང་ཁང་ནས་ཞེས་གསུངས་པ་ལྟར་ལ།",
    "ལ་ཞབས་གྲས་པ་ཚུན་ཆད་ཀྱི་སེམས་ཀྱི་རྟོགས་པ་ཕྲ་མོ་ཚུན་ཆད་ཕྱག་མཐིལ་དུ་གཟིགས་པ་ལྟར་མཁྱེན་པ་སོགས་སྔར་གདན་སར་ལྡེབས་བྲིས་སུ་བཀོད་པ་ཡང་ཤིན་ཏུ་མང་།",
    "ངའི་ཨ་ཁུ་ཁོང་སྐྱེས་བུ་དམ་པ་ཡིན་པའི་ཆ་ནས་ཕར་ཞོག།",
    "བདག་གིས་ཀྱང་།",
    "གསུང་གི་གདངས་སོགས་ཆ་གང་ནས་ཀྱང་མི་ཡུལ་ན་ཡོད་པ་ཞིག་ཨེ་ཡིན་སྙམ་པའི་ཐེ་ཚོམ་འདྲེན།",
    "འདི་འདྲའི་ལྟད་མོ་ཁྱད་པར་ཅན་མཐོང་བའི་སྐལ་པ་སྲིད་མཐའ་ཙམ་ཡིན་རྒྱུ་རེད་ཅེས་མགྲིན་གཅིག་ཏུ་བསྔགས་པ་ཀུན་ལ་གྲགས་སོ།",
    "ཕྱིས་སུ་དུས་ལ་བབ་པ་ན་རེ་སྐོང་གི་གོང་ས་སྐྱབས་མགོན་གྱི་སྐུ་ཚབ་གཙོ་བྱས་པའི་གདན་ས་རྣམ་གསུམ།",
    "སྤྱི་དཔོན་ནང་སོ་གཙོ་བྱས་པའི་གཤོག་ཁག་སོ་སོའི་དཔོན་པོ་ས་སྒར་ལུང་བཅུ་གཅིག་སོགས་སྐུ་བདག་རྣམས་ལྷན་རྒྱས་སུ་འཛོམས་ནས་ཕྱག་ཡིག་གི་དམ་རྒྱ་གྲོལ་ཏེ་མཇལ་བའི་ཚེ།",
    "དེ་ནས་དགུང་ལོ་བརྒྱད་ཀྱི་སྟེང་སྐྱབས་རྗེ་ཨ་རོལ་རྡོ་རྗེ་འཆང་བློ་བཟང་ལུང་རྟོགས་བསྟན་པའི་རྒྱལ་མཚན་གྱི་དྲུང་ནས་རབ་ཏུ་བྱུང་སྟེ་དགེ་ཚུལ་གྱི་སྡོམ་པ་བཞེས།",
    "དགུང་ལོ་ཉེར་གཉིས་ནས་ས་ཁྱི་ལོའི་དུས་དང་བསྟུན་ཏེ་བསྟན་འགྲོའི་ཆེད་དུ་ཟི་ལིང་ནས་བཞུགས་སྐབས་ཁྲི་མུན་རང་ཤོང་རེ་རེ་བ་ལས་སུ་དང་མི་འཕྲད་པ་ཡིན་ན་ཡང་།",
    "དེ་དུས་ཀྱང་བདེ་གསང་འཇིགས་གསུམ་དུས་འཁོར་དང་བཅས་པའི་རྩ་སྔགས་བྱེ་བ་རེ་དང་།",
    "རིག་གསར་དུས་ལོག་གིས་སླར་ཡང་ཁྲི་མུན་དུ་བཞུགས་དགོས་བྱུང་སྐབས་ཀྱང་།",
    "མ་ཎི་བྱེ་ཆེན་རེ་ལྗགས་བཟླས་དང་།",
