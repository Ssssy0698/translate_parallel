    "སྔར་གྱི་བཞུགས་གནས་རྣམས་སུའང་འབྱོན་གི་འདུག་གསུངས།",
    "མེ་ཏོག་གི་ཆར་བབས།",
    "དེར་འགྲོ་དོན་འཕེལ་མུས་སུ་བཞུགས་པ་རབ་ཚེས་ཤིང་ཡོས་ལོར་ཤར་བླ་བྲང་ཆེན་མོའི་ཕྱག་མཛོད་ངོ་མོའི་བློ་བཟང་རྒྱ་མཚོ་ནས་དངུལ་སྲང་སྟོང་ཕྲག་གི་འགྲོ་སྒོ་བཏོད་དེ་ཐབས་མཁས་ཀྱིས་གདན་དྲངས་སྐབས་ཡ་མཚན་པའི་ངག་སྒྲོས་ཅི་རིགས་ཐོས་པ་ཡོད་ཀྱང་མངས་ཀྱིས་དོགས་སོ།",
    "ཡོངས་སུ་གྲགས་པ་ལ་ཡང་སྤྱན་རས་གཟིགས་ཀྱི་རྣམ་པར་རོལ་བ་འཕགས་པ་ཤཱ་རིའི་བུ་དང་།",
    "བདེ་མཆོག་དྲིལ་བུ་ལྷ་ལྔའི་སྒོ་ནས་སྐུ་ཚེ་འདིའི་སྟེང་ཐུན་མོང་སྣང་ངོར་སེམས་དབེན་དང་།",
    "ཐུན་མོང་མིན་པའི་སྣང་ངོར་མི་སློབ་པའི་ཟུང་འཇུག་བརྙེས་པར་གསུང་མགུར་དག་ལས་ཀྱང་གསལ་བར་གསུངས་སོ།",
    "དུས་གསུམ་གཟིགས་པའི་མཁྱེན་པ་སོགས་བརྗོད་ག་ལ་ནུས།",
    "སྙན་གྲགས་པི་ཝང་ཕྱོགས་ཀྱི་ན་ཆུང་གིས།",
    "རྒྱལ་མོ་བཀྲ་ཤིས་ཚེ་རིང་སོགས་འགྲོ་བའི་འདྲེན་པར་གྱུར་པའི་བླ་སྤྲུལ།",
    "ཨ་མགྲོན་མཁས་བཙུན།",
    "སྒོས་བདག་གི་གྲྭ་ཚང་འདི་ཉིད་དུ།",
    "དེ་ལྟར་གདན་ས་ཆེན་པོའི་ཐོས་བསམ་གྱི་ཁུར་ཆེན་པོ་བཞེས་ནས་དགུང་ལོ་རེ་གསུམ་པར་བདེ་འཛོམས་དགའ་ཚལ་ནས་གཟུགས་སྐུའི་བཀོད་པ་རེ་ཞིག་འཇམ་དཔལ་རོལ་བའི་ཞིང་ཁམས་སུ་བསྡུས་སོ། ། གདན་རབས་བཞི་བ།",
    "ཞེས་དགེ་ཚུལ་ཞིག་གི་མདུན་དུ་དབྱུག་བརྡ་གནང་བ་ཕྱིས་སུ་དེ་ཡིན་པར་ངོ་འཕྲོད་པར་གྲགས་ལ།",
    "ཐུན་མོང་མ་ཡིན་པའི་རིག་པའི་གནས་མཐའ་དག་ལ་ཐུགས་བརྩོན་གྱིས་སྦྱངས་པ་རྒྱ་ཆེར་གནང་ཞིང་།",
    "འཇམ་དབྱངས་ཞི་ཁྲོ་སྦྲགས་སྒྲུབ་དང་རྟ་མགྲིན་ལྕགས་རལ་སྒོམ་བཟླས་ཀྱི་མཐིལ་མཛད་དེ་སྤྱོད་ལམ་ཐམས་ཅད་དེའི་ངང་གིས་འདའ་བར་མཛད།",
    "སྐུ་མཆེད་གཅིག་ལས་མེད་པ་ཚེ་ལས་འདས་པའི་ཕ་གཞིས་ཁང་ཁྱིམ་རྒྱུ་ནོར་ཅི་ཡོད་གྲྭ་ཚང་གི་གཞུང་ལ་ཕུལ།",
    "གསེར་ཁྲི་བླ་བྲང་གི་རྨང་བཏིངས་ནས་གསར་བསྐྲུན་མཛད།",
    "ཕྱག་སོར་རྨེན་བུར་སོང་ཞིང་གས་པ་ལས་ཁྲག་འཛག་པ་སོགས་དཀའ་སྤྱད་ཀྱིས་ལོ་ལྔའི་རིང་གཞུང་ལུགས་ལ་སྦྱངས།",
    "དགེ་འཕེལ་དུ་རྗེ་ཐམས་ཅད་མཁྱེན་པའི་ཞལ་གཟིགས།",
    "ཝ་མོ་བློ་བཟང་བསྟན་རྒྱན།",
    "རྒྱ་མོ་གཤག་རལ་གོང་འོགསྟག་ཚང་ལྷ་མོ་སོགས་རྔ་བ་ཚུན་གྱི་དབེན་གནས་ཐམས་ཅད་དུ་ཉམས་བཞེས་གནང་།",
    "ཉི་མ་མཐིལ་རྩེར་བསྟན་སྲུང་རྒྱ་མཚོའི་ཞལ་གཟིགས་རྒྱུན་མར་བྱུང་།",
    "ཝ་མོ་བྲག་རྒན་བློ་བཟང་བཀྲ་ཤིས།",
    "དགུང་ལོ་རེ་དགུའི་དུས་རྒྱལ་མཆོག་བདུན་པ་ལ་མཇལ།",
    "རྒན་གྱ་སོགས་སུ་མ་ཎི་བཙུགས་ཏེ་ལོ་རེར་དུང་ཕྱུར་ལྔ་བཅུ་ལྷག་འགྲོ་བས་རྟིས་ཚང་མ་ཎི་བར་གྲགས།",
    "སྐྱབས་མགོན་ཐམས་ཅད་མཁྱེན་པའི་བཀའ་ལྟར་རབ་བྱུང་བཅུ་གཉིས་པའི་མེ་བྱ་ལ་ཐོས་བསམ་གླིང་གི་གསེར་ཁྲིར་ཕེབས།",
    "སྟོང་ཐུན་ཆེན་མོ།",
    "གླིང་རྒྱལ་ནས་མེས་པོ་ལྡོང་དཔོན་གྱི་ལྡོང་གི་རིགས་སུ་སྐུ་འཁྲུངས།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་རབ་བསྔགས་པས།",
    "རོ་ལྡན་ཚིག་གི་བདུད་རྩི་ནི།",
    "རྗེ་འདི་ལ་ཡང་དེ་དུས་མཁས་པའི་ཡང་རྩེའི་སྙན་གྲགས་དབྱར་རྔ་ལྟར་ལྡིར་བ་ལ་མོ་ནམ་མཁའ་ཡང་བཞེངས་ཏེ་བགྲོ་གླེང་གནང་བ་པ།",
    "རྩོད་པ་ཨང་དང་བོ་ཐོབ་པའི་ལེགས་སྐྱེས་སུ་རྒྱལ་མེ་ཏོག་ཐང་གི་མཁན་སར་མངའ་གསོལ།",
    "སྐྱབས་མགོན་མཆོག་གི་བཀས་རང་དགོན་དུ་ཕེབས་ཏེ་རབ་བྱུང་བཅུ་གཉིས་པའི་ཆུ་སྤྲེལ་ལོར་ཐོས་བསམ་རྣམ་རྒྱལ་གླིང་གི་གསེར་ཁྲིར་བཞུགས།",
    "ཐོས་བསམ་གླིང་གི་འདུ་ཁང་།",
    "སྐབས་ཀྱི་གཏོང་སྒོ་དང་གྲྭ་ཇ་གཅིག་གི་རྒྱུན་འཐེབ་ཀྱང་སྦྱོར་འཇགས་བསྩལ།",
    "ཀུན་གཟིགས་ལྔ་བས།",
    "ང་ཚོ་འདུ་མཁན་ཆེན་བློ་བཟང་འཕྲིན་ལས།",
    "དགུང་ལོ་སོ་དྲུག་པར་འཇམ་དབྱངས་ཀུན་གཟིགས་སྤྲུལ་བའི་སྣང་བརྙན་ལ་གསེར་ཆབ་ཕུལ་བ་དང་གཟུགས་མེད་པའི་སྒྲ་ཞིག་གིས།",
    "སྐྱབས་མཆོག་རྡོ་རྗེ་འཆང་གི་ཡོངས་འཛིན་མཛད་ནས་མན་ངག་ཐམས་ཅད་ལུས་པ་མེད་པར་ཕུལ།",
    "དཔལ་ལྡན་གུར་གྱི་མགོན་པོས་གསེར་ཁྲི་ཆེན་མོར་ཕེབས་དགོས་ཀྱི་སྙན་སྒྲོན་མངོན་སུམ་དུ་ཕུལ་ཞིང་།",
    "སྐུ་ན་གཞོན་དུས་བསེ་ཁྲི་རྒན་ཚང་གི་ཡང་སྤྲུལ་དུ་ངོས་འཛིན་བྱས་ནས་བླ་བྲང་གི་ཚོགས་སུ་ཞུགས།",
    "ནང་གི་བསམ་པའི་ཁྱད་པར་གོ་བར་བྱེད།",
    "ཁྱུང་ཕྲུག་གཉིས་མཇལ་དུ་སོང་བར་རང་རང་གི་མིང་ནས་འབོད་པ་གནང་བས་དེ་གཉིས་ངོ་མཚར།",
    "ལུས་ཀྱི་སྟོད་སྨད་ཅིག་ན་རྟགས་ཤིག་ཡོད་དགོས་ཀྱི་རེད་ལ།",
    "ཨེ་ཡོད་ལྟོས་དང་གསུངས་པས་བལྟས་པ་ན་ཞབས་དཀྱིལ་གཉིས་ལ་འཁོར་ལོའི་རི་མོ་ཡོད་པར་མཐོང་ནས་དེ་ལྟར་ཞུས་པ་ན།",
    "འཇམ་དབྱངས་ཞི་ཁྲོ་སྦྲགས་སྒྲུབ་ཀྱི་ཐུན་མིན་ཟབ་ཁྲིད་ཉམས་སུ་བསྟར་པས་ཞོགས་ཇ་ནས་དྲོས་ཇའི་བར་ལ་སྣ་རིང་ལྔ་རེ་ཐུགས་འཛིན་གནང་ཐུབ་པ་བྱུང་ཞིང་འཇམ་དབྱངས་སྨྲ་སེང་གི་མཚན་མ་བརྟན་པོ་རྙེད།",
    "ལྕང་སྐྱའི་བསེ་སྐུ་སྐྱེ་དང་འདི་རྣམ་པ་གཉིས་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་བར་གྲྭ་སྐོར་དུ་ཕེབས་ཏེ་ཉིན་ལྔའི་རིང་དམ་བཅའ་གནང་བར་ཁས་ལེན་ལ་གནོད་པ་ཅི་ཡང་མ་སོང་བས་གྲགས་པའི་སྙན་པ་ཟླ་བཞིན་འཕེལ།",
    "འཇམ་དབྱངས་རིགས་ལྔ་དང་སྒྲོལ་དཀར་སྔོན་སོགས་ཀྱི་ཞལ་གཟིགས།",
    "དེར་ཉམས་ཆག་ཏུ་སོང་ཟིན་པ་སླར་ཡང་འདུ་ཁང་དང་བྱམས་ཁང་རྟེན་བརྟེན་པར་བཅས་པ་གསར་བཞེངས་གནང་ནས་གཟུངས་འབུལ་རབ་གནས་ཚད་ལྡན་བགྱིས་ཤིང་།",
    "རྒྱལ་བ་འཇམ་དཔལ་རྒྱ་མཚོ་ཚོགས་དབུར་ཕེབས་དུས་བགྲོ་གླེང་ངོ་མཚར་ཅན་ཕུལ་བས་དགྱེས་གཟིགས་ཤིན་ཏུ་ཆེ་བ་བྱུང་ཞིང་མཁས་པའི་གྲགས་དཀར་རྒྱས།",
    "ཁྱད་པར་སྙོམས་ཆུང་ཚུལ་མཐུན་དང་དོན་གཉེར་ཅན་རྣམས་ལ་གཟིགས་པ་ཆེ་ཞིང་བསྔགས་བརྗོད་རྒྱ་ཆེན་གནང་བ་ནི།",
    "ནོར་ལྡན་བླུན་པོའི་ཚོགས་ཀྱི་བྲན་དུ་གྱུར་པའི་མཛད་པ་ཅན་རྣམས་ཀྱིས་སྤྱན་གྱིས་གཟིགས་པར་ཅི་ཡང་མཛེས་སོ།",
    "བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་གྱི་མཁས་པ་མང་བོས་ཡོན་ཏན་གྱི་ཚོད་བརྟག་པ་ལ་དྲི་རྨེད་དང་བགྲོ་གླེང་གིས་སྨྲ་མེད་དུ་བྱས།",
    "རྨི་ཉམས་འདྲེས་མའི་སྣང་བར་ནམ་མཁའ་ལ་སྤྲིན་གསེབ་ཏུ་རལ་གྲི་ཆེན་པོ་ཞིག་ཡོད་པ་གཞན་ཞིག་གིས་རང་ལ་སྟེར་བའི་སྣང་བ་སོགས་གཟིགས་པ་ངོ་མཚར་ཅན་མང་།",
    "ཟླ་བ་རེ་རེར་དུས་བཟང་ཉིན་ལྔ་རེ་ཆག་མེད།",
    "བདེ་མཆོག་གི་སྒྲུབ་མཆོད་ངོས་གཙང་ཉིན་བཅུ་རེ་སོགས་ཀྱི་ཚོས་རྒྱུན་བཙུགས།",
    "རབ་བྱུང་བཅུ་གསུམ་པའི་ཤིང་བྱི་ལོར་གྲྭ་ཚང་གི་གསེར་ཁྲི་ཆེན་མོར་ཕེབས་ནས་ལོ་ལྔའི་རིང་ལ་བསྐྱངས།",
    "ཀུན་གཟིགས་མ་ཧཱ་པཎ་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོས།",
    "ངེས་པ་དོན་གྱི་པཎ་ཆེན་ས་ན་རྒྱུ་བའི་ཟླ་བ་དེ་ཉིད་རབ་བྱུང་བཅུ་གསུམ་པའི་གནམ་ལོའི་བདག་པོ་དཔལ་དུ་འཆར་བའི་གཟའ་སྐར་ཕུན་སུམ་ཚོགས་པའི་འོད་སྣང་དང་འགྲོགས་ཏེ་གསེར་ལྗོངས་མར་ནང་བིས་ཐང་ཞེས་བྱ་བའི་ནོར་འཛིན་གྱི་སྙིམ་མཐིལ་དུ་སྐུའི་འོད་ཟེར་དང་ནམ་མཁའི་འཇའ་ཚོན་གྱི་གུར་ཁང་སོགས་མཁྱེན་རབ་ལང་ཚོ་རྒྱས་པའི་ལྟས་དང་བཅས་ཏེ་སྐུའི་མེ་ཏོག་སྐྱེ་དགུའི་མིག་གི་བདུད་རྩིར་འཁྲུངས་སོ།",
    "ལང་ཚོ་ཡོལ་བ་རྣམས་ཀྱིས་གནས་པ་བདེ།",
    "དུས་འཁོར་གྲྭ་ཚང་གི་གདོང་ལྔས་བཏེགས་པའི་ཁྲི་ལ་ཉེ་བར་ཕེབས་སོ།",
    "ཆེས་ཕྲ་ཚིག་གི་ཟླ་ཤེལ་གཞོན་ནུར་ཡང་།",
    "དེ་ནས་ཕྱི་དུས་ཀྱི་འཁོར་ལོ་སྣོད་བཅུད་ཀྱི་རྣམ་གཞགདེ་གཏན་ལ་འབེབས་བྱེད་རི་མོའི་གོ་དོན་དང་བཅས་པའི་ལག་ལེན།",
    "རྒྱལ་སྲས་སྟོང་གི་རེ་བ་ཀུན་ནས་སྐོང་།",
    "ལམ་རིམ་ཟིན་བྲིས་སྙན་བརྒྱུད་རྡོ་ཡི་རི་མོ་དང་ལམ་གཙོའི་འགྲེལ་ཆེན་སོགས་ལམ་རིམ་བློ་སྦྱོང་གི་སྐོར།",
    "འཕྲིན་ཡིག་གི་རྣམ་གཞག་དང་པསྟོད་ཚིག་གི་སྐོར།",
    "གོང་གི་བཀའ་ལྟར་རྒྱུད་པའི་ཁྲིར་ཕེབས།",
    "རབ་བྱུང་བཅུ་བཞི་བའི་མེ་ཡོས་ལ་གསེར་ཁྲི་ཆེན་མོར་བྱོན་ཏེ་ས་འབྲུག་ལ་མྱ་ངན་ལས་འདས་པའི་ཚུལ་བསྟན་ཏོ། ། གདན་རབས་ཉེར་བཞི་བ།",
    "རྒྱུད་གྲྭའི་འདུ་ཁང་གི་འཐེབ་ཏུ་དངུལ་དཀར་སྲང་བཞི་བརྒྱ་དང་དངོས་པོ་གཏོས་ཆེན་ཕུལ་བའི་ཡོན་སྦྱར་ཐོགལྗགས་བཀོད་མཛད་དེ་རྒྱུད་ཁང་གསར་བཞེངས་ལེགས་པར་གྲུབ།",
    "ཐུག་མོ་དགོན་དང་།",
    "བསླབ་པ་མིག་གི་འབྲས་བཞིན་བསྲུངས་པའི་ཚད་དུ་བྱེད།",
    "མཚན་སྟོད་གསེར་ཕྲེང་དང་ལམ་རིམ་ཆེན་མོ་ཐུགས་ཐོག་ནས་སྐྱོར་སྦྱངས་དང་།",
    "ལྕགས་ལུག་ལ་གསེར་ཁྲི་ཆེན་མོར་ཕེབས།",
    "རབ་བྱུང་བཅུ་བཞི་བའི་ཆུ་སྤྲེལ་ལ་གསེར་ཁྲི་ཆེན་མོར་བྱོན།",
    "རྗེའི་སྟོང་མཆོད་འབུལ་ཚུལ་བཀྲ་ཤིས་གཡང་འཁྱིལ་བྱ་བ་ཡང་གསར་རྩོམ་གནང་བ་ད་ལྟའི་བར་ལོ་རེ་བཞིན་ཡུལ་དབུས་དགའ་ལྡན་དང་རང་དགོན་གཉིས་ན་མ་ཉམས་པར་ཡོད།",
    "འབྲོག་རི་བོ་དགེ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་གི་གསེར་ཁྲི་ཆེན་མོའི་མཚན་གྱི་བ་དན་ཅན་བློ་བཟང་རྒྱལ་མཚན་སེངྒེ་ནི།",
    "ཉིན་རེར་ཤོག་བུ་བཅུ་གསུམ་རེ་ཆག་མེད་དུ་ཐུགས་འཛིན་གནང་།",
    "རི་བོ་རྩེ་ལྔ་སོགས་ལ་གནས་གཟིགས་སུ་བྱོན་ཏེ་ཕྱིར་གདན་སར་འབྱོར།",
    "རྒྱལ་མོ་རོང་དང་།",
    "ར་མོ།",
    "རང་རེ་སྐྱབས་མཆོག་དམ་པ་གཉིས་ལ་རབ་བྱུང་བསྒྲུབས།",
    "མཚན་ལམ་དུ་ནམ་མཁའ་ལས་སྒྲ་ཞིག་གིས།",
    "ལྷ་མོར་འཕྲིན་བཅོལ་རེ་གནང་བས་སྐྱེན་པར་མཚམས་ཆད།",
    "ཀུན་གཟིགས་ལྔ་བ་ཆེན་མོས།",
