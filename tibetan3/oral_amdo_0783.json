    "ཞུ་ཡིག་རྟེན་དུ་ཧང་སྤུང་གི་ཇ་སེར་པོ་ཞོ་ལྔ་ཕུལ་བ་དགེ་ལེགས་འཕེལ་བར་གྱུར་ཅིག།",
    "རྗེ་བཙུན་རེད་མདའ་བའི་དྲུང་དུ།",
    "ཕྱོགས་སྐྱོང་ལ་འབུལ་བའི་ཆུ་བཞི་སྔོན་དུ་འགྲོ་བའི་ཉེར་སྤྱོད་རྣམས་ཕྱོགས་སྐྱོང་གི་གཡས་རང་གི་གཡོན་ནས་བརྩམས་ཏེ་བཤམས།",
    "ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་རྡོ་རྗེ་འཁོར་ལོ་པད་མ།",
    "རོལ་མོ་རྣམས་རང་བཞིན་སྟོང་པ།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་སྔོན་པོའི་འོད་ཟེར་ལྕགས་ཀྱུའི་རྣམ་པ་ཅན་གྱིས་ཕྱོགས་སྐྱོང་བཅོ་ལྔ་འཁོར་དང་བཅས་པ་བཀུག་སྟེ་ཕྱོགས་མཚམས་རྣམས་སུ་གནས་པ་ནི།",
    "དེ་ཀུན་ཁྱོད་ཀྱིས་བཟོད་མཛད་རིགས།",
    "མེ་ཏོག་དང་བཅས་པའི་ཐལ་མོ་སྦྱར་ཏེ།",
    "ཕྱག་གསུམ་བྱས་ནས་རང་གི་གྲལ་ལ་འཁོད།",
    "རང་གི་སྤྱི་བོར་པཾ་ལས་པད་མ།",
    "ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པ་དཀར་པོ་ལྟེ་བ་ཧཱུཾ་གིས་མཚན་པ།",
    "ཡུམ་རྡོ་རྗེ་སྙེམས་མ་དཀར་མོ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པས་འཁྱུད་པ།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "སྦྱོར་མཚམས་ནས་འཐོན་པའི་བྱང་སེམས་བདག་གི་སྤྱི་བོའི་སྒོ་ནས་ཞུགས།",
    "བདག་གི་ལུས་ཐམས་ཅད་གང་།",
    "ཡོན་ཏན་བདག་གཞན་ཐམས་ཅད་ཀྱི་རྒྱུད་ལ་སྐྱེས་པར་བསམ་མོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ཞལ་ནས་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱི་སྡིག་སྒྲིབ་དང་དམ་ཞོལ།",
    "རང་གི་སྒོ་གསུམ་དང་རྡོ་རྗེ་སེམས་དཔའི་སྐུུ་གསུང་ཐུགས་དབྱེར་མེད་པར་གྱུར།",
    "སྣ་ཚོགས་པད་མ་དང་ཉི་མའི་གདན་རེ་རེ།",
    "དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་རྡོ་རྗེ་འཁོར་ལོ་པདྨ།",
    "རང་གི་སྤྱི་བོར་སྐུུ་རྡོ་རྗེའི་ངོ་བོ་ཨོཾ་དཀར་པོ།",
    "རལ་གྲི་འཛིན་པ་རང་གི་ཐུགས་ཀར་དྲངས་བཛྲ་དྷྲིཀ་ཐུགས་ཀ་ནས་ཕྱིར་ཕྱུང་།",
    "ཕྱག་དྲུག་གི་གཡས་རྡོ་རྗེ་རྩེ་དགུ་པ་འཁོར་ལོ་པདྨ།",
    "གཤིན་རྗེའི་གཤེད་ནག་པོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "དགྲ་སྟ་འཛིན་པ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "ཤར་གྱི་རྩིབས་ཀྱི་རྩེ་མོའི་སྟེང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱངས་ཀྱིས་འཁོད།",
    "བྱང་ཤར་གྱི་རྩིབས་ཀྱི་རྩེ་མོའི་སྟེང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱངས་ཀྱིས་འཁོད།",
    "སྟེང་གི་རྩིབས་ཀྱི་ནང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱངས་ཀྱིས་འཁོད།",
    "འོག་གི་རྩིབས་ཀྱི་ནང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱངས་ཀྱིས་འཁོད།",
    "དེ་ནས་བདག་གིས་གནོད་མཛེས་ལ་བལྟས་པས།",
    "འབྲུབ་ཁུང་གི་རྣམ་པ་ཅན་རྣམས་སུ་བཅུག་པར་གྱུར།",
    "དེ་ནས་བྱང་གི་བདུད་རྩི་འཁྱིལ་པས་སྤྲུལ་པའི་བདུད་རྩི་འཁྱིལ་པ་གཉིས་པ་དེ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་སྣ་ཚོགས་རྡོ་རྗེ་འཁོར་ལོ་གཏུན་ཤིང་།",
    "སྟེང་འོག་གི་ཕུར་བུ་རྣམས་ཀྱི་སྤྱི་བོ་ནས་བརྡུངས་པས།",
    "སྤྲུལ་པའི་གནོད་མཛེས་འོག་གི་གནོད་མཛེས་ལ་ཐིམ།",
    "སྟོང་པའི་ངང་ལས་སྐད་ཅིག་གིས་རྡོ་རྗེའི་ས་གཞི།",
    "སྤྱན་སོགས་ལྷ་མོ་བཞིའི་ངོ་བོར་གྱུར།",
    "དེ་རྣམས་ཀྱི་སྟེང་དུ་སྐད་ཅིག་གིས་ལྷག་པར་མོས་པ་ཙམ་གྱིས་ལྷ་སུམ་ཅུ་རྩ་གཉིས་དུས་གཅིག་ཏུ་རྫོགས་པར་གྱུར་པ་ནི།",
    "སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་རྡོ་རྗེ་འཁོར་ལོ་པདྨ།",
    "རེག་བྱ་རྡོ་རྗེ་མ་སྔོན་མོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན།",
    "ལང་ཚོ་དར་ལ་བབ་ཅིང་།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་གྱིས་བསྐོར་བའི་དབུས་ན་ཡབ་སེམས་པའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཤར་ལྷོར་སྤྱན་མ་དཀར་མོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "ལྷོ་ནུབ་ཏུ་མཱ་མ་ཀཱི་སྔོན་མོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན།",
    "ནུབ་བྱང་དུ་གོས་དཀར་མོ་དམར་མོ་འོད་དཔག་མེད་ཀྱི་དབུ་རྒྱན་ཅན།",
    "རིམ་པ་གཉིས་པའི་ཤར་ལྷོར་གཟུགས་རྡོ་རྗེ་མ་དཀར་མོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "ལྷོ་ནུབ་ཏུ་སྒྲ་རྡོ་རྗེ་མ་སེར་མོ་རིན་འབྱུང་གི་དབུ་རྒྱན་ཅན།",
    "ནུབ་བྱང་དུ་དྲི་རྡོ་རྗེ་མ་དམར་མོ་འོད་དཔག་མེད་ཀྱི་དབུ་རྒྱན་ཅན།",
    "ལྷ་མོ་བརྒྱད་པོ་ཐམས་ཅད་ཀྱང་དབུ་སྐྲ་རལ་པ་ཕྱེད་བཅིངས་སུ་བྱས་པ།",
    "རང་རང་གི་གདན་ལ་རྡོ་རྗེའི་སྐྱིལ་མོའི་ཀྲུང་གིས་བཞུགས་པའོ།",
    "སྣང་གི་དབུ་རྒྱན་ཅན།",
    "བྱམས་པའི་ཕྱག་གཡས་ཀྱི་དང་པོས་ཀླུ་ཤིང་གི་མེ་ཏོག་སྡོང་བུ་དང་བཅས་པ་འཁོར་ལོས་མཚན་པ་འཛིན་པ།",
    "རྣམ་སྣང་ནས་ཀུན་བཟང་གིས་བར་གྱི་ལྷ་ལྷག་མ་ཐམས་ཅད་ཀྱང་དབུ་སྐྲ་རལ་པའི་ཐོར་ཚུགས་ཅན།",
    "ཤར་སྒོར་གཤིན་རྗེའི་གཤེད་ནག་པོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་འཕྲོས།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས་པས་རྣམ་སྣང་ནས་གནོད་མཛེས་ཀྱི་བར་གྱི་ལྷ་རྣམས་སྤྱན་དྲངས་ཏེ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་གིས་མཚན་པ།",
    "རང་གི་ལུས་ཀྱི་མདུན་རྒྱབ་དང་གཡས་གཡོན་བཞི་དཀྱིལ་འཁོར་གྱི་ཟུར་བཞི།",
    "རང་གི་སྤྱི་གཙུག་ནས་སྐྲ་མཚམས་ཀྱི་བར་དུ་གཟུགས་ཕུང་གི་ངོ་བོ།"
  ]
}