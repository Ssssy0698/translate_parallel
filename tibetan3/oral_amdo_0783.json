    "ཟླུམ་ཐིག་རྟ་བབས་ཀྱི་རྩེ་མོ་ཟད་མཚམས་ནས་བསྐོར་ཅིང་།",
    "དེའི་འོག་ཏུ་དུས་གང་གི་ཚེ་དྲང་སྲོང་རྣམས་ལ་ངེས་པ་བྱིན་པ་དང་།",
    "ཛ་མ་ཞེས་པ་ལྟ་བུ་སཾསྐྲྀ་ཏ་ལས་གཞན་ཟུར་ཆག་གི་སྒྲ་དང་།",
    "དཔེར་ན་འཚེད་པ་ལྟ་བུར་རང་གཞན་གང་གིས་འཚེད་མ་ངེས་པར་ཐུན་མོང་དུ་སྟོན་ན།",
    "གང་གིས་འཚེད་པ་ལ་པ་ཙ་སི།",
    "ཁ་ཅིག་ཏུ་གཅིག་གི་ཚིག་ལ་མང་པོའི་ཚིག་སྦྱར་བ་བཙུན་མོ་གཅིག་ལ་བཙུན་མོ་རྣམས་ཞེས་སྦྱར་བ་ལྟ་བུ་དང་།",
    "མང་པོའི་ཚིག་ལ་གཅིག་གི་ཚིག་ཤིང་གི་ཚོགས་པ་ལ་ཤིང་ཞེས་སྦྱར་བ་ལྟ་བུ་དང་།",
    "ཚིགས་སུ་བཅད་པ་ཁ་ཅིག་ཏུ་ཕོའི་རྟགས་ལ་མ་ནིང་གི་རྟགས་དང་མ་ནིང་གི་རྟགས་ལ་ཕོའི་རྟགས་སུ་སྦྱར་བ།",
    "མོ་སྟོན་ན་ཨཱ་སྦྱར་ནས་སརྦཱ་ཞེས་དང་།",
    "ཐ་སྙད་ཀྱི་གཙུག་ལག་དང་མི་མཐུན་པ་དེ་ལྟ་བུ་དང་གཞན་ཡང་རྒྱུད་སྟོན་པ་པོའི་མན་ངག་གི་རྗེས་སུ་འབྲངས་ནས་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཞེས་པ་ནས་གསུངས་པ་ཞེས་པའི་བར་གྱིས་གླེང་གཞིའི་ཚིག་གི་མཚམས་སྦྱར་བའོ།",
    "རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་ལ་བཞུགས་སོ།",
    "རྒྱུད་གཞན་ལས་བསྟན་པའི་ཨེ་ཝཾ་གྱི་དོན་དེ་ཉིད་འདིའི་གླེང་གཞིའི་ཚིག་གི་དོན་དུ་ཇི་ལྟར་ཡོད་ཚུལ་དང་།",
    "འདི་གཉིས་གང་རུང་རེས་ཀྱང་དམ་བཅའ་དེ་ཉིད་འགྲུབ་པའི་རྟགས་རྣམས་གྲངས་སྟོན་པ་ཡིན་ནོ།",
    "སྡུད་པ་པོས་ཀྱང་གདུལ་བྱ་རང་རང་གི་སྐད་དང་མཐུན་པར་སྡུད་མི་ནུས་པར་ཐལ།",
    "ཅིག་ཅར་ཞིང་མཐའ་ཡས་པར་གདུལ་བྱ་མཐའ་ཡས་པ་ལ་སྐུུ་དང་གསུང་གི་རྣམ་པས་དོན་མཛད་པ་མེད་པར་འགྱུར་ལ།",
    "རྣམ་པ་ཐམས་ཅད་པའི་སྟོང་པའི་མིང་གི་རྣམ་གྲངས་དང་།",
    "ཝཾ་ཡིག་གིས་མཚོན་དོན།",
    "བདེ་བ་ཆེན་པོའི་མིང་གི་རྣམ་གྲངས་དང་།",
    "གཉིས་ཀའི་མཚོན་དོན་ཐབས་ཤེས་གཉིས་སུ་མེད་པའི་རྣལ་འབྱོར་གྱི་མིང་གི་རྣམ་གྲངས་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་བ་དང་བཅས་པར་འཆད་དོ།",
    "འགའ་ཞིག་གིས་བསམས་པས།",
    "ཨུ་ཡིག་དེ་ཉིད་དེའི་གོང་གི་ཨ་མཐོང་བས་ཨོ་ཡིག་ཏུ་འགྱུར་དགོས་ཏེ།",
    "ཨུ་ཡིག་དེ་དེའི་གོང་གི་ཨས་མཐོང་བས།",
    "གཞན་ཨི་ཀའི་ཡི་གེ་བཞི་པོ་དེ་དག་གིས།",
    "རང་གི་ཕ་རོལ་ཡི་གེ་གཞན་གྱིས་བར་མ་ཆོད་པར།",
    "ཨི་ཡིས་རང་གི་ཕ་རོལ་ཏུ་རང་དང་རིགས་མི་མཐུན་པའི་ཨ་ཙའི་ཡི་གེ་ཞིག་མཐོང་ན།",
    "རང་གི་གོང་གི་ཨ་དེ་མཐོང་བ་ཡིན་པས་ཨུ་དེ་ཝྲ་རུ་འགྱུར་རོ།",
    "དེའང་སྒྲ་པ་དག་གི་ལུགས་ཀྱིས།",
    "རང་གི་འགྲམ་ན་གནས་པའི་དབྱངས་ཡིག་དང་སྦྱར་ཞིང་།",
    "འདིར་ནི་རྟེན་ནམ་གནས་ཀྱི་ངོ་བོ་གཅིག་གི་མཚོན་བྱེད་དུ།",
    "དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "སྒྲ་དོན་གཉིས་ཀའི་མཐའ་ལ་བརྟེན་པ་གཉིས་སུ་གསུངས་པ་ལྟར་གྱི་རྗོད་བྱེད་མཐའ་དྲུག་གི་མཚན་ཉིད་དོ།",
    "མཐའ་དྲུག་གི་ངོས་འཛིན་ནི་སྒྲོན་གསལ་ལས་ཤེས་པར་བྱའོ།",
    "འོ་ན་སྔགས་ཀྱི་སྐབས་སུ་ངེས་པའི་དོན་ལ་སོགས་པ་དེ་དང་དེར་ཐབས་གང་གིས་རྟོགས་པར་བྱ་ཞེ་ན།",
    "ཡི་གེ་རེ་རེའི་དོན་འཆད་པ་ལ་ཤློ་ཀ་རེ་རེ་གསུངས་པའི་ཤློ་ཀ་བཞི་བཅུས་ཡི་གེ་བཞི་བཅུར་བྱས་ནས་བསྙོན་དུ་མེད་པར་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་དག་གི་ཁྱབ་བདག་ལྷན་ཅིག་སྐྱེས་པའི་སྐུུ་དང་སོ་བདུན་ལ་དག་པ་སྦྱོར་བའི་ཆེད་དུ་ཡི་གེ་སོ་བདུན་དུ་བསྡུས་ཏེ་གསུངས་པའོ།",
    "རྒྱུད་འདིའི་གླེང་གཞིའི་ཚིག་གི་དོན་དུའང་ཇི་ལྟར་ཡོད་པའི་ཚུལ་འཆད་དེ།",
    "ཤོག་༦༨ ན་༥ ཤློ་ཀ་རེ་གསུངས་པའི་ཤློ་ཀ་དུས་འཁོར་འགྲེལ་ཆེན་གྱི་དཀའ་གནས་ཟིན་བྲིས།",
    "དེ་གཉིས་དོན་གཅིག་ཀྱང་འགའ་ཞིག་གིས་ཉན་རང་དགྲ་བཅོམ་པ་དག་གི་ཡིད་ཀྱི་རང་བཞིན་གྱི་ལུས་ཀྱང་ཡེ་ཤེས་ཀྱི་སྐུུ་ཡིན་ནམ་སྙམ་དུ་དོགས་པ་ལ་ཐམས་ཅད་མཁྱེན་པའི་སྐུུ་ཁོ་ན་ཡེ་ཤེས་ཀྱི་སྐུུ་ཡིན་གྱི་ཉན་རང་དགྲ་བཅོམ་པས་ཤེས་སྒྲིབ་ཀྱི་ལྷག་མ་མ་སྤངས་པའི་ཕྱིར་ཡེ་ཤེས་ཀྱི་སྐུུ་མེད་དོ།",
    "དེ་ལྟ་ནའང་ཡེ་ཤེས་ཀྱི་སྐུུ་དང་ཉིན་མོར་བྱེད་པའི་སྐུུ་གཉིས་ཀ་སྨོས་པས་ཟློས་ཞེས་པ་ལ།",
    "འགའ་ཞིག་ཤེས་སྒྲིབ་ཀྱི་ལྷག་མ་གང་སྤངས་པས་ཡེ་ཤེས་ཀྱི་སྐུུ་འཐོབ་པའི་ཤེས་སྒྲིབ་དེ་ལ་གཟུང་འཛིན་རྫས་ཐ་དད་དུ་འཛིན་པ་མ་ལུས་པར་སྤངས་པ་ཙམ་གྱིས་ཆོག་གམ་སྙམ་པ་ལ་དེས་མི་ཆོག་གི།",
    "འདིར་དེ་དག་གི་ནང་ཞེས་པ་ནས་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་པའི་བར་རོ།",
    "ཞེས་པ་གསུངས་པ་ནི་ཟློས་པའི་ཚིག་གི་སྐྱོན་དུ་མི་འགྱུར་རོ།",
    "ཉོན་མོངས་ཀྱི་བག་ཆགས་ཀྱི་ལྷག་མ་ཤེས་སྒྲིབ་དང་བཅས་མ་བཅས་ཀྱི་ཁྱད་པར་ཡོད་པའི་ཕྱིར་ཞེས་སྟོན་པ་ནི།",
    "དེ་ཙམ་ཞིག་གིས་ཡེ་ཤེས་ཀྱི་སྐུུ་འཐོབ་པར་འགྱུར་བ་མེད་དོ་ཞེས་རྒྱས་པར་ཤེས་པའི་ཕྱིར་དུ།",
    "ཉིན་མོར་བྱེད་པའི་སྐུུ་དང་ཡེ་ཤེས་ཀྱི་སྐུུ་གཉིས་ཀ་སྨོས་སོ་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཞེས་པ་ནས།",
    "ལེགས་སྦྱར་གྱི་སྐད་ཉི་ཚེ་འབའ་ཞིག་གིས།",
    "རེ་ཞིག་ཅེས་པ་རྗེའི་གསུང་འབུམ་ན་པ།",
    "རིམ་པ་དེ་གཉིས་དགོས་པའི་འབྲས་བུ་གང་གི་རྒྱུར་གསུངས་ན།",
    "རྫོགས་རིམ་གྱིས་ནི་སྟོང་པ་ཉིད་ཀྱི་གཟུགས་ཀྱི་ཕྱག་རྒྱ་ཆེན་མོ་དང་།",
    "རང་གི་སེམས་ཀྱི་སྣང་བ་སྟོང་པའི་གཟུགས་ཀྱི་ཕྱག་རྒྱ་དང་།",
    "རང་གི་སེམས་བདེ་བ་ཆེན་པོ་གཉིས་ནམ་ཡང་དབྱེར་མི་ཕྱེད་པ་ཉིད་དུ་གྱུར་པ་ནི།",
