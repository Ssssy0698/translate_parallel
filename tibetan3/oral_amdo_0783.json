    "དེའང་བདེ་སྟོང་གི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་དུ་འདྲེས་པ་ཞེས་བྱའོ།",
    "དེའི་མིང་གི་མཚན་མའམ་མཚོན་བྱེད་དབུས་ཀྱི་མཚན་མའི་ལྷོར་ཐིག་ལེ་གཉིས་བྲིའོ།",
    "རྒྱུད་ཀྱི་ཡེ་ཤེས་ཞེས་པའི་མིང་གིས་བསྟན་ཏོ།",
    "དེའི་མཚན་མར་དབུས་ཀྱི་མཚན་མའི་ཤར་མདུན་དུ་དབྱིག་པའི་རྣམ་པ་རི་མོ་ནར་བ་ཞིག་བྲིའོ།",
    "ཐོད་གུག་གི་རྣམ་པ་བྲིའོ།",
    "ཐམས་ཅད་སྒྲིབ་བྲལ་དུ་གྱུར་པ་རྣམས་གང་གི་རང་བཞིན་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་ནི་བདེ་བ་ཆེན་པོ་སྟེ།",
    "ཝཾ་ཡིག་གིས་མཚོན་པའི་དོན་ཡིན་པས།",
    "དབུས་ཀྱི་མཚན་མ་གྲི་གུག་གི་རྣམ་པ་ལུས།",
    "ཐིག་ལེ་གཉིས་ནར་མོར་བརྐྱང་ནས་སྟེང་འོག་ཏུ་གཤིབས་ཏེ་ཟླ་ཚེས།",
    "བྱང་གི་ཐིག་ལེ་གཅིག་པོ་དེ།",
    "རེ་རེ་ལའང་བརྗོད་དུ་མེད་པ་སྟེ།",
    "ཨཱ་ལི་སོགས་རང་བྲིས་ན་བརྗོད་བཅས་སུ་འགྱུར་བས་དེ་རྣམས་བརྗོད་མེད་མཚོན་པའི་བརྡར་གྲི་གུག་གི་རྣམ་པ་སོགས་ལྔ་བྲིས་པ་ཡིན་ནོ།",
    "ཝཾ་གྱི་མགོ་བོ་དང་ཟླ་ཚེས་སོགས་ཡིན་པས་ཡི་གེའི་ཆ་ཤས་རེ་རེ་ཡིན་པའི་ཕྱིར་བརྗོད་བཅས་སུ་འགྱུར་རོ།",
    "དེའི་ཕྱིར་མ་བཀོད་པ་ཡིན་གྱི་བརྗོད་བཅས་སུ་སོང་དོགས་པ་མ་ཡིན་ལ།",
    "ཨ་ཡིག་གི་ཕུང་པོ་དྲུག་ཚན་དེ་གཉིས་རང་གི་དངོས་ཀྱི་བརྗོད་བྱར་བྱས་ནས།",
    "ཐུན་མོང་མིན་པར་གོ་བར་བྱེད་པས་དེའི་ཕྱིར་བརྗོད་དུ་མེད་པ་གསུངས་ཏེ།",
    "བོད་སྔ་མ་འགའ་ཞིག་གིས་བོད་ཡིག་ལ་ཨེ་ཝཾ་བསྒྲུབས་ནས་གྲི་གུག་ལ་ཨའི་ལག་པ་བྱས་པ་སོགས་ནི།",
    "སྔ་མ་དག་གིས་རྒྱས་པར་བཀག་པ་ལྟར་རོ།",
    "དེ་ལ་སྡུད་བྱེད་ཀྱི་ཁམས་ཡེ་ཤེས་ནམ་མཁའ་སོགས་ལྔའི་མིང་གི་དབྱངས་ནི།",
    "བྱའི་ཁམས་དྲུག་ཚན་དྲུག་གི་མིང་གི་དབྱངས་ཡིག་ནི།",
    "འདི་དག་ནི་སུམ་ཅུ་རྩ་དྲུག་གི་དབྱེ་བས་ཐ་དད་པ།",
    "ཞེས་པ་ནི་དབྱངས་འདི་དག་ཀྱང་ཁམས་སོ་དྲུག་གི་དབྱེ་བས།",
    "དེ་དག་གི་མིང་གི་དབྱངས་ཐ་དད་སོ་དྲུག་སྟེ།",
    "ཕུང་པོ་དྲུག་གི་དོད་ལ་རོ་དྲུག་བཟུང་བར་བྱ་ཞིང་།",
    "དེ་དག་གི་མིང་གི་དབྱངས་ནི།",
    "དེས་ན་དབྱངས་སོ་དྲུག་གི་མིང་གི་ཡི་གེས་མཚོན་པའི་ཁམས་སོ་དྲུག་སྒྲིབ་བྲལ་དུ་གྱུར་པའི་བདེ་ཆེན་ཐམས་ཅད་ཀྱང་།",
    "ཨ་སོགས་མིང་གི་དབྱངས་ལྔས་མཚོན་པའི་དག་པའི་ཁམས་ལྔར་འདུས་ལ།",
    "ལྔ་པོ་དེའང་ཝཾ་ཡིག་གིས་མཚོན་དོན།",
    "ཞེས་སོགས་ཀྱིས་སྟོན་ལ་དེ་དག་གི་དོན་ཡང་།",
    "ཕུང་པོ་དྲུག་ཚན་དྲུག་སྒྲིབ་བྲལ་དུ་གྱུར་པའི་སྟོང་པ་སོ་དྲུག་ཐམས་ཅད་ཀྱི་རེ་རེ་ནས་མཚོན་པའི་མིང་གི་ཡི་གེ་ནི།",
    "དྲུག་པོ་དེའི་མིང་གི་ཡི་གེ་ནི།",
    "ཕྱག་རྒྱ་ཆེན་མོ་ལ་ཐབས་བདེ་བ་ཆེན་པོ་བརྟེན་པ་མཚོན་ནོ།",
    "མིང་གི་ཡི་གེའང་དབྱངས་སུ་གསུངས་ལ།",
    "ཕྱི་མ་ཕུང་པོའི་ལྡོག་པ་ནས་བསྟན་པས་མིང་གི་ཡི་གེའང་གསལ་བྱེད་དུ་གསུངས་ཤིང་།",
    "དེའི་མིང་གི་ཡི་གེ་དབྱངས་གསལ་ལ་ཐུང་ངུ་དང་།",
    "འོ་ན་ཁམས་དང་དེའི་མིང་གི་ཡི་གེ་དབྱངས་ཀྱི་ཡི་གེ་དེ་དག་ལས།",
    "དེ་དག་གི་མིང་གི་ཡི་གེ་གསལ་བྱེད་ཀྱི་ཡི་གེ་དེ་དག་ལས་ཤེས་རབ་སྟོང་པ་མཚོན་པའི་ཨེ་དབྱངས་ཀྱི་ཡི་གེ་བསྒྲུབ་པ་ཅི་ཞེ་ན།",
    "མགྲིན་རྐན་སྤྱི་བོ་མཆུ་དང་སོ་དང་སྣ་སྟེ་ཐ་སྙད་དྲུག་གིས་ཡོད་མེད་ཀྱི་དོན་ཞོལ།",
    "གཞན་དུ་མིག་གི་ཡེ་ཤེས་སོགས་ལ་འཆད་པ་དོན་མིན་ནོ།",
    "འདིར་དྲུག་ཚན་དྲུག་དྲུག་གིས་ཐབས་ཤེས་ཀྱི་དབྱེ་བ་བསྟན་ན།",
    "ཞེས་སོགས་ཏེ་དེ་དག་གི་ཚིག་དོན་ནི།",
    "དེ་ལྟར་གཉིས་ལས་འདིར་ཁུ་བ་དང་ཟླ་བ་ནི་ཝཾ་ཡིག་གི་ངེས་དོན་བདེ་བ་ཆེན་པོ་སྟེ་དེ་ཉིད་རྡོ་རྗེའོ།",
    "རྡུལ་དང་ཉི་མ་ནི་ཨེ་ཡིག་གི་ངེས་དོན་ཤེས་རབ་སྟེ་སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོའི་པདྨའོ།",
    "རྡོ་རྗེའི་དོན་དྲུག་ཙམ་ཟུར་ནས་ཁ་བཀང་སྟེ་འཆད་མོད།",
    "རྡོ་རྗེ་ནི་མཆོག་གི་བདེ་བ་དང་།",
    "རྡོ་རྗེ་ནི་མཆོག་གི་བདེ་བ་དང་།",
    "གཞི་དུས་ཀྱི་དེ་དག་གི་དབྱེ་བ་སོགས་འབྱེད་ཚུལ་སྟོན་པ་ནི།",
    "གཙོ་བོར་མངལ་སྐྱེས་མོ་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དུ་འགྱུར་ལ།",
    "ཕོ་མོ་གང་ལའང་ཁུ་རྡུལ་ཕྱིར་འཕོ་མི་ནུས་ཀྱི་བར་དུ།",
    "བུད་མེད་ལ་ལོ་བཅུ་གཉིས་དང་།",
    "དོན་དམ་པར་གང་གིས་བརྟན་གཡོའི་འཇིག་རྟེན་བྱེད་པ་པོའི་སྐྱེས་བུ་མེད་ཀྱང་།",
    "དེའི་ཕྱིར་གང་གིས་ཞེས་སོགས་ཀྱིས་མཚན་བརྗོད་དང་རྒྱུད་འདིའི་ཡོན་ཏན་བརྗོད་ནས་མཉན་པར་བསྐུུལ་བ་སྟོན་པ་ལ།",
    "ཞེས་པའི་བར་འདི་དག་གིས་དངོས་སུ་ལྡོག་ཁྱབ་བསྟན་ཤ་གས་ལ་རྗེས་ཁྱབ་སྟོན་ཏེ།",
    "རྒྱུད་འདི་ཤེས་ན་རྡོ་རྗེ་འཆང་གི་ལམ་ཤེས་པར་འཆད་དགོས་པ་ལ།",
    "དེ་ལ་ཁྱབ་པའི་རྗེས་སུ་འགྲོ་ལྡོག་གི་ནི་རྣམ་པ་མ་ཤར་རོ།",
    "ཟླ་བཟང་གིས་ཞུས་པའི་ལན་གྱི་ཚིག།",
    "གྲགས་པས་བསྡུས་རྒྱུད་དུ་བསྡུས་པ་དེ་བདག་གིས་དགྲོལ་བར་བྱའོ།",
    "ཟླ་བ་བཟང་པོ་ཁྱོད་ལ་བདག་མགུའོ་ཞེས་བྱ་བ་ནི།",
    "གང་ཟག་གི་ཞེས་སོགས་ཏེ།",
