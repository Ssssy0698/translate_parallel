    "ཐུན་མོང་གིས་བདུད་བཞི་གཅོད་པས།",
    "འདྲེ་གདོན་ཐུལ་དུ་རེ་བས་ཟ་ཆོག་ཕྱིར་དུ།",
    "གྲོང་པའི་གཉིད་ཀྲོགརྩིང་ཐལ་གྱི་སྤྱོད་པ་སྣ་ཚོགས་ལ་ཞུགས་པ་ནི་གཅོད་ཐ་ཁྱི་ཟུག་ཟུག་ཟེར་བ་ལྟར་གཅོད་ལོག་ཏུ་འགྲོ་བའི་ནོར་ས་རྔམ་པོ་ཆེ་ཡིན་པས་དང་པོ་ནས་ཀུན་སློང་མ་ནོར་བར་བྱ།",
    "ཞེས་པས་ཟབ་མོ་གཅོད་ཀྱི་ཁོག་དབུབ་ཁྱད་པར་ཅན་དོན་བཞི་སྟོན་པ་བཞིན་ཉམས་སུ་ལེན་པ་ཡིན་ཏེ།",
    "ཡང་མ་ཅིག་གིས།",
    "ཚེ་སྲོག་འཕྲོག་པའི་འཆི་བདག་གི་བདུད།",
    "དེའི་ཐུགས་ཀ་ནས་སྐུ་གསུང་ཐུགས་སྤྲུལ་གྱི་ཁྲོས་མ་ལས་བྱེད་ཀྱི་ཁྲོ་མོ་གློག་ལྟར་འཁྱུགས་ཅིང་སྐར་ལྟར་འཁྲུགས་པ་འཕྲོས་པས།",
    "རང་ཁྲོས་མས་ཧཱུྃ་ཕཊ་ཀྱི་སྒྲ་དྲག་པོ་དང་བཅས་བདེ་ཆེན་སྒྱུ་མའི་གར་གྱི་སྲིད་གསུམ་ཕྱག་རྒྱས་འགེངས་པའི་རྡོ་རྗེའི་གར་སྟབས་ཀྱིས་འཁྲབས་པས་རང་གི་བ་སྤུའི་བུ་གར་ཁྲོས་མས་གཏམས་པ་རྣམས་དང་།",
    "དེའང་སྔོན་དམ་བཅས་པ་ཉིད་མོས་པས་སློབ་པའི་ཚུལ་གྱིས།",
    "གཉིས་པ་ཚོགས་ཞིང་གསལ་བཏབས་ཅིང་ཚོགས་བསགས་པ་ལ།",
    "དབུ་ཐོག་ཡུམ་ཆེན་མོ་རྒྱལ་བ་རིགས་ལྔ།",
    "ཕ་རྒྱུད་མ་རྒྱུད་གཉིས་མེད་རྒྱུད་སོགས་སོ་སོའི་འཁོར་གྱིས་བསྐོར་བའི་ཕྱི་རོལ་དཔའ་བོ་དཔའ་མོ།",
    "སྒྲ་གསུང་ལྷ་མོ་པི་ཝང་ཐོགས་པ་དཔག་མེད་སྤྲོས།",
    "གཞུང་གི་མ་ཅིག་ཐུགས་ཀར་པད་ཟླར་ཡེ་ཤེས་སེམས་པ་རྡོ་རྗེ་འཆང་མཐིང་གསལ་གཅེར་བུ་རུས་རྒྱན་ཅན་ཕྱག་གཉིས་རྡོ་དྲིལ་སྣོལ་ཐབས་ཡུམ་ཤེར་ཕྱིན་དམར་སེར་གྲི་ཐོད་འཛིན་པ་ལ་ཞབས་རྡོ་རྗེ་དང་པདྨའི་དཀྱིལ་ཀྲུང་གིས་རོལ་པའི་ཐུགས་ཀར་ཉི་མ་དང་ཟླ་བའི་དབུས་སུ་ཏིང་འཛིན་སེམས་དཔའ་ཧཱུྃ་ཡིག་དཀར་པོའི་མཐར་སྔགས་ཕྲེང་གིས་གཡས་སུ་བསྐོར་བ།",
    "འགྲོ་བ་ཀུན་ལ་ཕོག་པས་སྡིག་སྒྲིབ་སྦྱང་ཡུམ་ཆེན་མོའི་གོ་འཕང་ལ་བཀོད།",
    "ཚིག་དོན་བཞིན་རང་གི་འོག་ཏུ་ལྷན་སྐྱེས་བདུད་ཚེ་འཆི་སྲོག་གི་བདག་པོ་ཆུ་སྲིན་གདོང་ཅན་ཁ་གདངས་པའི་ནང་དུ་ཁྲུས་ཁུ་ཁ་དོག་དྲི་རོ་ནུས་པ་ཕུན་སུམ་ཚོགས་པའི་བཟའ་བཏུང་དུ་གྱུར་ཏེ་སོང་བས་ངོམ་ནས་ལན་ཆགས་བྱང་།",
    "དེ་དག་གིས་ནི་ཐུན་མོང་བའི་ལམ་དང་མཐུན་པའི་བསགས་སྦྱོང་གི་རིམ་པའོ།",
    "ལུས་བ་སྤུ་དང་མིག་འཆི་མ་འཁྲུག་བཞིན་དུ་ཐམས་ཅད་མགྲིན་གཅིག་གིས་གསོལ་བ་འདེབས་པར་བསམ་ལ།",
    "རང་གི་རྐང་མཐིལ་གཡས་སུ་ཕ་ལས་ཐོབ་པའི་ཐིག་ལེ་དཀར་པོ།"
  ]
}