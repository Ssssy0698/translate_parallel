    "ཡུལ་ལྗོངས་ཤིན་ཏུ་ཉམས་དགའ་བ་ཞིག་གི་ཁ་སྟོད་རི་བོ་གླང་ཆེན་འགྱིང་བ་ལྟ་བུའི་གདོང་པའི་ཐད་ཙམ་དུ་རྗེ་ཉིད་ཕེབས་པས་རྒྱང་རིང་པོ་ནས་འོད་ཀྱི་གང་བུ་ལྗང་གུ་ཤིན་ཏུ་། བཀྲག་མདངས་དང་ལྡན་པ་ལ་ཇེ་ཉེར་སླེབས་པའི་ཚེ་རྡོ་ཤེལ་ལྗང་ནག་དྭངས་བ་ལ་ཉི་ཟེར་ཕོག་པའི་རྐྱེན་གྱིས་འོད་ཟེར་ཁ་དོག་སྣ་ཚོགས་སུ་འཕྲོ་བ།",
    "དབྱིབས་ནོར་བུ་མིག་གཅིག་ལྟ་བུ་ཆེ་ཞིང་དྭངས་པ་ཞིག་གི་དྲུང་དུ་སླེབས་པ་ན་ངོ་མཚར་གྱི་སྣང་བ་བཅས་ནང་དུ་ཞུགས་པས།",
    "དེ་ཉིད་སྐད་ཅིག་གིས་ཨོ་རྒྱན་སྣང་སྲིད་ཟིལ་གནོན་གྱི་སྐུར་གནས་གྱུར་ནས་སྨིན་གྲོལ་གྱི་གདམས་པ་ཆིག་རྫོགས་སུ་སྩལ།",
    "འཁོར་ལོ་སོགས་སྔར་དུས་སྔགས་པ་རྣམས་ལ་དར་ཅིང་གྲགས་ཆེ་ཡང་ཕྱིས་སུ་བརྒྱུད་པ་ཆད་ནས་ཡུན་རིང་སོང་།",
    "དབོན་སྲས་ཁྱུང་ཐོག་གི་ཡཀྴ་ཀཱི་ལ་ཡ།",
    "ཨ་ཡ་བོན་པོ་ལྷ་འབུམ་མམ་རྟ་ནག་གུ་རུ་རྣོན་རྩེའི་མ་རྒྱུད་ཟབ་མོ་ཀུན་འདུས།",
    "གཏེར་རྙིང་ལས་དཔེ་ལུང་གི་རྒྱུན་དཀོན་པ་མི་ལས་འཕྲོ་གླིང་པའི་པདྨ་གཏུམ་པོ།",
    "སྟག་མོ་གཏེར་སྟོན་དཔོན་སྲས་ཁྱུང་ཐོག་གི་ཚེ་སྒྲུབ་ཡེ་ཤེས་སྲོག་ཏིག།",
    "ཟླ་བ་བཅུ་གཅིག་པའི་ཚེས་ཉེར་དགུའི་ནུབ་མོར་རྗེའི་དག་སྣང་དུ།",
    "འདི་སྲིད་པ་མ་མོའི་རྒྱུད་ལུང་ཐམས་ཅད་འདུས་པ་ཡིན་གསུངས།",
    "མདུན་དུ་བུད་མེད་ཐོག་བརྩག་ཚད་ཅིག་སླེབས་འདུག་པ་ཁྱོད་སུ་ཡིན་གསུངས་པས།",
    "ལར་ར་ཤག་གིས་འགྲོ་དོན་མ་བྱུང་ཟེར་བ་རེད་ཀྱང་འགྲོ་དོན་བསམ་གྱིས་མི་ཁྱབ་པ་མཐོང་ཐོས་དྲན་རེག་གྲོལ་ཚུལ་དང་།",
    "གཟི་བརྗིད་ཆེན་པོས་ཁ་ཕར་གྲུས་ཏེ་སོང་འཕྲལ་འཁོར་གཡོག་བསམ་གྱིས་མི་ཁྱབ་པ་དང་བཅས་ཡུད་ཀྱིས་གཤེགས་པར་གཟིགས།",
    "ད་རེས་དགའ་རྟགས་ཡིན་ཟེར་འབྲས་སྙེ་ཞིག་ཕྱག་ཏུ་ཕུལ་བའི་ཉམས་བྱུང་།",
    "གསང་སྔགས་རྙིང་མའི་བསྟན་པ་ལ་བྱ་བ་རྒྱ་ཆེན་རེད་འགྲོ་གསུངས་པ་བྱུང་འདུག།",
    "རྗེ་ཉིད་ཀྱི་ཕྱག་ཏུ་ཡར་མར་ཀུན་ནས་དཔེ་རྙིང་འགའ་རེ་རྩོལ་མེད་དུ་འབྱོར་པ་རྣམས་དབུ་ཞབས་བསྒྲིགས་ནས་དཔེ་གསར་བཞེངས་མཛད།",
    "རྗེ་ཉིད་ལྷོ་བྲག་ལ་ཡག་བརྒྱ་ཕྱོགས་སུ་ཁྱིམ་བདག་ཞིག་གི་ཆུང་མ་རྡོ་རྗེ་འཚོ་ཟེར་བ་ཞིག་ཏུ་གྱུར་ནས་འཇིག་རྟེན་པའི་ལས་ཐབས་ལ་སྤྱོད་ཀྱིན་འདུག་པའི་སྐབས་ཤིག།",
    "ཕྱག་ཏུ་ཕུལ་བས་འདི་ཁོང་གི་གཏེར་རྫས་སྒམ་ཡིན།",
    "དེར་སྐྱེས་དམན་དུ་སོང་བ་དང་ཡུལ་འཕོ་དགོས་པ་འདྲ་ཞིག་ཀྱང་དྲན་ཡུལ་དུ་འདུག་པ་སོགས་ཀྱིས།",
    "ཁོ་མོས་ཚགས་རྩ་གཏན་ནས་མི་ཐུབ།",
    "རེ་ཞིག་ཚགས་རྩ་གྱིས་དང་ང་རང་སླེབ་འོང་གསུངས།",
    "གསང་སྔགས་ལུང་གི་བཀའ་ཐོ་ཆེན་མོ་བཞུགས་སོ།",
    "ཐུགས་རྗེ་ཆེན་པོ་རྒྱལ་བ་རྒྱ་མཚོ་དང་ངན་སོང་ཀུན་སྐྱོབ།",
    "བགྲེས་པོ་བགྲེས་མོ་དར་དཀར་ཐོད་དང་གོས་ཅན་གཟི་བརྗིད་ཆེན་པོ་ཅན་གཉིས་འདུག་པས་ཡུངས་མ་བཙོས་པ་ལྟ་སི་། བུ་ཞིག་དྲངས་པ་ཤར་འདུག།",
    "ངེད་གཉིས་མིང་མང་ཡང་སྐབས་རེར་ཕ་ལ་ལེགས་ལྡན་ནག་པོ་ཟེར།",
    "དེ་རྗེས་རྒྱུན་མ་ཆད་ཙམ་ཡོད་པ་ལ་ཕྱིས་སུ་ཆད་སོང་བས་ངེད་ཚོ་མ་དགའ།",
    "ད་རེས་ཁྱེད་ནས་སྤེལ་བ་ལ་ངེད་རྣམས་ཤིན་ཏུ་དགའ་བས་ཕྲིན་བཅུ་ལས་སྒྲུབ་ཟེར་བ་བྱུང་གསུངས།",
    "བུད་མེད་ནང་གོས་སྟེང་སྟོད་གཡོགས་དམར་པོ་ལྷུབ་གྱོན།",
    "སྐྲ་རྒྱབ་ཏུ་བསྡམས་པ་ཞིག་གིས་ཤེལ་དམར་ལྟ་བུའི་གྭའུ་ཞིག་ཁྱེར་ནས།",
    "དེ་ནས་བྲམ་ཟེ་སུ་རེད་དྲིས་པས་ཟླ་བ་བཟང་པོ་རེད་ཟེར།",
    "མཁའ་འགྲོ་མ་དེ་པདྨའི་དྲྭ་བ་ཅན་རེད་གསུངས།",
    "གནས་མདར་སྔགས་པ་ཞིག་གིས་ཁྱིམ་དུ་གདན་དྲངས།",
    "དགའ་མོ་ཡོང་འགྲོ་གསུངས་ཀྱིན་ཕེབས།",
    "འོ་ན་དོ་དགོང་ཁྱེར་རང་ཚང་ལ་གནས་ཚང་ཨི་གཡར་བྱས་སོང་བ།",
    "ཕ་ཝང་ཞིག་གི་སྐྱིབས་སུ་རྣལ་འབྱོར་པ་ཐོར་ཚུགས་ཆུང་ངུ་ཡོད་པ།",
    "བུད་མེད་གོས་སྔོན་གྱོན་པ་ཞིག་གིས་ད་འགྲོ་གསུངས་པའི་རྗེས་ལ་ཕེབ་པའི་ལམ་དུ་གྲོག་རོང་ཞིག་འདུག་པ་ལ་བུད་མེད་དེ་འཕུར་སོང་བའི་རྗེས་ལ།",
    "སྒོའི་བུ་ག་སྒོ་ཞིག་ནས་གསན་པས་ཕེ་ཧྲང་གི་འཕྲུལ་འཁོར་ལྟ་བུའི་རོལ་མོའི་སྒྲ་སྙན་ལ་ཡིད་འཕྲོག་པ་བསམ་གྱིས་མི་ཁྱབ་པའི་གདངས།",
    "རྒྱུད་ཀྱི་ཚིགས་སུ་བཅད་པ་ངོ་མཚར་བ་སྒྲོགས་པ་ཞིག་གསན་པ་མཆོད་འབུལ་གྱི་རོལ་མོའི་སྒྲ་ཡིན་ཟེར།",
    "དེའི་བར་ཁང་དུ་ཕེབས་པས་སྤྱན་རས་གཟིགས་རྒྱལ་བ་རྒྱ་མཚོ་ལ་ཉེ་སྲས་བརྒྱད་ཀྱིས་བསྐོར་བ།",
    "སྟེང་ཁང་དུ་ཕེབས་པས་འོད་སྔོན་པོའི་རང་བཞིན་དུ་གཟིགས་ནས་དག་སྣང་ལས་སད་གསུངས།",
    "བཞི་པ་ཟབ་མོ་དགོངས་པའི་གཏེར་ནི།",
    "མཐར་རང་ཉིད་ལ་ཐིམ་པའི་མོད་ལ་རྟོག་མེད་འོད་གསལ་ཆེན་པོར་འབྱམས་ཀླས་ཤིང་རྡོ་རྗེ་གསུམ་དང་དབྱེར་མི་ཕྱེད་པའི་ངེས་ཤེས་འཁྲུངས།",
    "ཡན་ལག་གི་སྐོར་ལས་རིག་འཛིན་རྣམ་གསུམ་གྱི་སྒྲུབ་སྐོར་ཁྱད་པར་ཅན།",
    "ཞེས་གདམས་པ་ངོ་སྤྲོད་ཤློ་ཀ་གཅིག་སྩལ་ནས་ཉིད་ལ་ཐིམ་པས་སྨིན་གྲོལ་གདམས་པའི་སྐོར་ཐུགས་ལ་བཀྲ་གསལ་གྱིས་འཆར་བས་བཅོ་ལྔའི་ཉིན་གྲུབ་ཐོབ་ཐུགས་ཐིག་གི་ལས་བྱང་སོགས་གཏན་ལ་ཕབ་པར་མཛད།",
    "དྲུག་པ་དག་སྣང་གི་སྐོར་ནི།",
