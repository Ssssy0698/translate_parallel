    "ཡོང་ནི་མི་ཐེ་པར་མ་ཐང་བར་འདུག།",
    "དེ་དུས་ན་ད་ལྟའི་སེམས་དང་ཁྱད་པར་ཅི་འདུག་ལྟ་དགོས་སྙམ་པ་བྱུང་སྟེ།",
    "དེ་བསྒོམ་གྱི་བག་ཆགས་སད་པར་འདུག།",
    "ཕྱིས་ཀྱང་སྔར་གྱི་དེ་ཀ་ལས་མི་འདུག་གསུང་།",
    "ད་ལྟར་གྱི་བར་དུ་མཁས་ཤིང་གྲུབ་པ་བརྙེས་པ་ཤ་སྟག་བྱུང་བ་ཡིན་ཞེས་གསུང་འབྱོན་པར་གདའ།",
    "ལས་བརྒྱ་རྩ་པ་འདི་ཤིན་ཏུ་བག་ཆགས་འཐུག་པར་འདུག།",
    "སྤྲུལ་པའི་སྐུ་ལས་ལུང་སྟན་གདམས་པ་ཐོབ་རྗེ་བཙུན་ཉིད་ལ་ཟེར་བ་འདུག།",
    "དེ་ལ་ངའི་མ་ཡིན་སྙམ་དགོངས་པས་ཡབ་ཇོ་འཕན་ལས་ཀྱང་རྩེ་བརྩེ་སེམས་ཆེ་བར་འདུག།",
    "དེ་ནས་ཡང་སྐུ་སྐྱེ་བ་བདུན་གྱི་ཡབ་བསྟན་པས་ཐམས་ཅད་ལ་བརྩེ་སེམས་སྐུ་ཚེ་འདི་ཡི་ཡབ་དང་མཚུངས་པར་འདུག།",
    "གྲིབ་ཀྱི་གཟུགས་ན་བུན་ནམ་རླངས་པ་ལྟ་བུ་འདུག་པ་དང་།",
    "ས་འགའ་ཞིག་ན་གྲིབ་གཟུགས་མེད་པའང་འདུག་གསུངས།",
