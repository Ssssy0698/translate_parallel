    "ཡུལ་ཁོ་རང་གི་ངོས་ནས་གྲུབ་པ་མེད་ལ།",
    "ཉེར་བཞིའི་མཁའ་འགྲོ་མ་རྣམས་ཡིད་ལྟར་མྱུར་བའི་ཤུགས་ཀྱིས་བྱོན་ནས་རང་གི་བདེ་ཆེན་འཕེལ་བའི་གྲོགས་མཛད་དེ་དགའ་བཞིའི་ཡེ་ཤེས་འབར།",
    "འདི་གྲུབ་ཆེན་ནག་པོ་པས་བདེ་མཆོག་གི་ཞལ་གཟིགས་སྐབས་ཐོལ་བྱུང་དུ་བསྟོད་པ་མཛད་པ་ཡིན།",
    "རྒྱུན་དུ་འཇིགས་བྱེད་དཔའ་གཅིག་ཉམས་སུ་ལེན་མཁན་ཡིན་ན་དེའི་སྲུང་འཁོར་མ་བསྡུས་པར་གཞག་བདེ་འཇིགས་གཉིས་ཀ་བཏོན་པས་ནི་བདེ་མཆོག་གི་སྲུང་འཁོར་ནང་དང་།",
    "ཐུན་གྱི་སྐབས་གཟབ་གཟབ་བྱེད་ཀྱང་ཐུན་མཚམས་བག་མེད་དུ་སོང་ན་མི་ཚེ་ཕལ་ཆེར་དོན་མེད་དུ་འདའ་འགྲོ་སྟེ།",
    "རབ་ཀྱིས་བདེ་སྟོང་གིས་རྒྱས་འདེབས་པ་སོགས་ཡིན།",
    "ངག་གི་སྨྲ་བརྗོད་ཐ་མལ་པ་རྣམས་ཀྱང་དོན་མེད་དུ་མི་འགྱུར་ཏེ།",
    "ལྷའི་རྣལ་འབྱོར་གོམས་པ་བརྟན་པོར་སོང་བ་ན།",
    "ཡན་ལག་གི་ནི་བསྐྱོད་པ་དང་།",
    "ཚིག་གི་རབ་འབྱམས་ཇི་སྙེད་པ།",
    "སྣོད་བཅུད་གང་མཐོང་ཡང་ཞལ་ཕྱག་གི་རྣམ་པ་ཅན་གྱི་ཧེ་རུ་ཀའི་སྐུའི་རྣམ་པ་གསལ་མ་ཐེབས་ཀྱང་དེའི་བདག་ཉིད་དུ་བལྟ་བ་དང་།",
    "ངེས་དོན་གྱི་ཧེ་རུ་ཀ་ལྷན་སྐྱེས་ཀྱི་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་འབའ་ཞིག་གི་རྣམ་འཕྲུལ་དུ་ཤེས་དགོས།",
    "དེ་ལྟར་བྱས་ན་རིམ་གཉིས་ཟབ་མོའི་སྨིན་བྱེད་དུ་འགྱུར་བ་དང་།",
    "ད་ལྟའི་སྣང་བ་འདི་ལམ་དུ་མ་ལོངས་པ་ལ་བརྟེན་ནས་རང་རེས་ལས་ངན་བསག་པ་ཡིན་པས་མན་ངག་འདི་ལ་གོམས་པ་ཞིག་བྱུང་ན།",
    "བདེ་བར་གཤེགས་པའི་སྐུ་གསུང་ཐུགས་རྟེན་མཐོང་པའི་སྐབས་སུ་འཁོར་ལོ་བདེ་མཆོག་ཏུ་མོས་ནས་རྐང་བརྒྱད་ཀྱི་བསྟོད་པ་རབ་ཚར་བདུན།",
    "མ་མཐའ་གཅིག་གིས་བསྟོད།",
    "རང་ཡང་ཧེ་རུ་ཀའི་ངོ་བོར་མོས་ནས་ཡང་ཡང་བསྟོད།",
    "སྣོད་བཅུད་ཀྱི་འཁོར་ལོ་གཞན་རྣམས་ལའང་ཧེ་རུ་ཀའི་ངོ་བོར་མོས་ནས་བསྟོད་དགོས།",
    "སང་ཞོགས་འོད་གསལ་དེ་ལས་ལྷ་སྐུར་ལྡང་བ་དང་ཁྲུས་ཀྱི་རྣལ་འབྱོར་ཡང་གོང་དུ་སོང་བ་ལྟར་བྱེད་དགོས།",
    "རྩ་ཁམས་དཔའ་བོ་དང་དཔའ་མོ་བཞུགས།",
    "ཅེས་གསུངས་པ་ལྟར་ཁ་ཟས་ཚོགས་འཁོར་དང་སྦྱིན་སྲེག་གི་ཚུལ་དུ་ལོངས་སྤྱད།",
    "དེ་ལྟར་བྱས་ན་དད་ཟས་གཤིན་ཟས་སོགས་ལ་ལོངས་སྤྱད་ཀྱང་ཚོགས་རླབས་ཆེན་རྫོགས་པའི་རྒྱུར་འགྲོ།",
    "རང་ལྷར་བསྐྱེད་པ་ལ་བསྔོ་བ་མ་བྱས་པར་རང་ཉིད་ལྷར་བསྐྱེད་པ་སོགས་ཀྱི་རྣལ་འབྱོར་དང་བྲལ་བའི་སྒོ་ནས་བཟའ་བཏུང་ལ་སྲེད་པའི་བསམ་པས་ཀུན་ནས་བསླངས་ཏེ་རང་དོན་དུ་ལོངས་སྤྱད་ན་ཟས་ཁམ་རེ་དང་བཏུང་བ་ཧུབ་རེ་ལ་བྱང་སེམས་ཀྱི་སྡོམ་པ་དང་འགལ་བའི་ཉོན་མོངས་ཅན་གྱི་ཉེས་བྱས་རེ་རེ་དང་།",
    "ཚོགས་འཁོར་ཡང་འགྲུབ་ན་ཉིན་རེ་བཞིན་འབུལ་དགོས་པ་མ་རྒྱུད་ཐུན་མོང་མ་ཡིན་པའི་དམ་ཚིག་ཡིན།",
    "མ་མཐའང་རྒྱལ་གྱི་ཟླ་བར་ཚོགས་འཁོར་རེ་ཆག་མེད་མ་བྱས་ན་མཁའ་འགྲོ་རྣམས་ཁྲོས་པའི་ཉེས་པ་འབྱུང་།",
    "ཚོགས་གཏོར་དང་ཚོགས་རྫས་བག་ལེབ་སོགས་རྒྱས་པར་བྱུང་ན་རབ།",
    "རྩེ་མོར་རྡོ་རྗེས་མཚན་པ་ལྟ་བུ་བཟོ་མི་རུང་།",
    "རྩེ་མོར་ཉི་ཟླ་ནཱ་དས་མཚན་པ་དགོས།",
    "རང་གཅིག་པུ་ཡིན་ཚེ་ཚོགས་འབུལ་ལེན་སོགས་འདོན་པ་ཐམས་ཅད་རང་གིས་འདོན།",
    "ཌཱ་དྲིལ་སོགས་རོལ་མོ་རྣམས་གདན་ས་གསུམ་ལྟ་བུ་ལ་སྤྲོས་མེད་མངོན་ཆུང་མཛད་དགོས།",
    "རྐང་མགྱོགས་དང་བཅུད་ཀྱིས་ལེན་པ་ལ་སོགས་པ་ཐུན་མོང་གི་དངོས་གྲུབ་གྲུབ་པ་ཆེན་པོ་བརྒྱད་དང་།",
    "ཐུན་མོང་མ་ཡིན་པ་རྫོགས་རིམ་ཟབ་མོའི་ལམ་དང་འབྲས་བུའི་གནས་སྐབས་ཀྱི་རྟོགས་པ་མྱུར་དུ་རྒྱུད་ལ་སྐྱེད་པའི་སྨིན་བྱེད་ཁྱད་པར་ཅན་དུ་འགྱུར་ཞིང་།",
    "དག་ཞིང་གི་མཆོག་ནི་དག་པ་མཁའ་སྤྱོད་ཡིན།",
    "བདེ་མཆོག་འདི་ཉམས་སུ་ལེན་པའི་རྣལ་འབྱོར་པ་འགའ་ཞིག་ཤི་བའི་ཕུང་པོའི་སྤྱི་གཙུག་ཏུ་འཇའ་དཀར་པོ་ཟུག་པ་རྗེ་ཉིད་ནས་གཟིགས་ཚུལ།",
    "དེ་ལྟ་བུའི་ལམ་བཟང་འདིར་རང་ཅག་གིས་ཚིག་ཙམ་འདོན་རྒྱུ་བྱུང་བའང་སྐལ་བ་བཟང་།",
    "དེར་ན་ད་རེས་འཇམ་མགོན་སྙན་བརྒྱུད་ཀྱི་བསྟན་པ་འདི་ལྟ་བུ་དང་མཇལ་བའི་སྐབས་འདིར་སོ་སོར་བློ་ཚོད་དང་བསྟུན་པའི་ལམ་ཆ་ཚང་བ་ཞིག་ལ་ཉམས་ལེན་གཤའ་མ་ཞིག་བྱ་རྒྱུ་བྱུང་ན།",
    "གྲོགས་དག་གསང་མཐའི་མྱུར་ལམ་ཟབ་མོ་ལས།",
    "ལྔ་ལྡན་ལང་ཚོ་སྒྱུ་མའི་རྩེ་དགའ་སྟོང་།",
    "མཁའ་ཁྱབ་ཞིང་གི་འཁོར་ལོར་གྲོལ་གྱུར་ཅིག།",
