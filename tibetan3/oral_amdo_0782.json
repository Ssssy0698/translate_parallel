    "རིགས་བཟང་ཞིང་ཁུངས་བཙུན་པ་ནི་དཔེར་ན་འདབ་ཆགས་ཀྱི་ནང་ནས་བྱ་ཁྱུང་གི་བུ་དང་འདྲ་སྟེ་སྤྱི་རྒྱ་རླབས་ཀྱིས་གཅོད་པར་ཆེ་ཞིང་།",
    "གང་གིས་ཀྱང་མི་དཔོག་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "སྤོས་ཀྱི་བན་གླང་འགྱིང་བ་དང་འདྲ་སྟེ་གང་གིས་ཀྱང་བསྒྱུར་དུ་མི་བཏུབ་པར་ཆེ་ཞིང་།",
    "མཁའ་ལྡིང་གསེར་མིག་ལྟར་མུན་སྣང་མེད་པར་ཐམས་ཅད་ཡོངས་ལ་གཟིགས་པ་ཆེ་ཞིང་།",
    "སྤྲུལ་པའི་སྐུ་ལྷ་དང་ལྷ་མོའི་ཆ་ལུགས་སུ་ངོ་མཚར་དང་ལྡན་པར་ཆེ་ཞིང་།",
    "སྟོབས་དང་ལྡན་པ་དུང་གི་སེང་གེ་ལྟར་ཆེ་ཞིང་།",
    "འགྱུར་བ་མེད་པ་གཡུང་དྲུང་གི་སྐུ་ལྟར་ཆེ་ཞིང་།",
    "གང་གིས་ཀྱང་བསྐྱད་དུ་མི་ཚུགས་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "སྐྱོན་གྱིས་མ་གོས་པ་འདམ་གྱི་པད་མོ་ལྟར་ཆེ་ཞིང་།",
    "ཐུགས་ཀྱི་རྒྱ་ཁྱོན་ནི་ནམ་མཁའི་དབྱིངས་ལྟར་ཆེ་ཞིང་།",
    "དུག་ལྔ་ཉོན་མོངས་འཇོམས་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "སྟོབས་ཤུགས་དང་ལྡན་པ་བར་སྣང་གི་ཐོག་རྒོད་ལྟར་ཆེ་ཞིང་།",
    "གང་གིས་གཏིང་དཔག་མི་ལོན་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "གང་གིས་ཀྱང་འགྲན་ཟླ་བྲལ་ཞིང་ཟིལ་གྱིས་ནོན་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "མྱུར་མགྱོགས་ཀྱི་ཚད་ནི་བར་སྣང་གི་གློག་ལྟར་བགེགས་དང་ལོག་འདྲེན་སྐད་ཅིག་གི་ཏིང་ངེ་འཛིན་གྱིས་འཆིང་བའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "གང་གིས་བཅོས་སླད་དང་བསྒྱུར་དུ་མི་བཏུབ་པའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "བར་སྣང་ལ་གཞའ་སྤྲིན་གྱི་རི་མོ་མ་ཡལ་བ་ལྟ་བུར་ཆེ་ཞིང་།",
    "ཡར་འཕེལ་དང་མར་འགྲིབ་གང་གི་མཚམས་སུ་ཆེ་ཞིང་།",
    "ནན་ཏན་གྱི་འགྲོ་དོན་མཛད་ཅིང་ཞིབ་ཏིག་གིས་བསྟན་པ་སྤེལ་བའི་ཡོན་ཏན་དང་ལྡན་པ་ལགས་སོ།",
    "ལྷོ་འཛམ་བུ་གླིང་གི་དམིགས་སུ་རྒྱལ་པོའི་སྲས་སུ་སྐུ་སྐྱེ་བ་བཞེས་པར་ཆེ་ཞིང་།",
    "རྒྱལ་བུ་འདིའི་ཀླད་པ་དུང་ཁང་གི་ནང་ན།",
    "རྒྱལ་བུ་འདིའི་དབུས་མཐིང་གི་རྩེ་ལ།",
    "རྒྱལ་བུ་འདིའི་ཞབས་ཀྱི་སོར་མོ་ལ།",
    "རྒྱལ་བུ་འདིའི་ཡན་ལག་གི་རྩེ་ལ།",
    "ཡི་གེ་དང་ཐོག་གི་འབྲུ་བཀོད་པ་ཞིག་གདའོ།",
    "ཡི་གེ་ཙེག་གི་འབྲུ་བཀོད་པ་ཞིག་གདའོ།",
    "ཡི་གེ་ཐིག་འཇོག་གི་འབྲུ་བཀོད་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདིའི་རྫི་མ་ལ་ཡི་གེ་གི་གུའི་འབྲུ་བཀོད་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདིའི་ཕྱག་གི་སོར་མོ་ལ།",
    "ཡི་གེ་ཧཱུཾ་གི་འབྲུ་བཀོད་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདིའི་ཀླད་པ་དུང་ཁང་གི་ནང་དུ།",
    "ཉ་ནི་ཉོན་མོངས་སྡུག་བསྔལ་གསིང་བའི་ཆ་ལ།",
    "རྒྱལ་བུ་འདིའི་དབུས་མཐིང་གི་རྩ་ལ།",
    "རྒྱལ་བུ་འདིའི་ཞབས་ཀྱི་སོར་མོ་ལ།",
    "སྣང་སྲིད་གོམ་པ་གཅིག་གིས་བགྲོད་པར་ངེས་ཤིང་།",
    "དུག་ལྔ་ཉོན་མོངས་འཇོམས་པའི་ཐོ་ཡིག་ལགས་སོ།",
    "རྒྱལ་བུ་འདིའི་ཡན་ལག་གི་རྩ་ལ།",
    "མ་རིག་སྒོ་མོ་འབྱེད་པར་ངེས་ཤིང་།",
    "ཡི་གེ་ཚེག་གི་འབྲུ་བཀོད་པ་ནི།",
    "ཡི་གེ་ཐིག་འཇོག་གི་འབྲུ་བཀོད་པ་ནི།",
    "ཐིག་འཇོག་ཉ་མོ་ལྟར་དུ་མཛེས་པའི།",
    "རྒྱལ་བུ་འདིའི་རྫི་མ་ལ་ཡི་གེ་གི་གུའི་འབྲུ་བཀོད་པ་ནི།",
    "གི་གུ་ནི་སྟོང་རིག་སྒྲིབ་པ་མེད་པའི་སྤྱན་གྱིས།",
    "རྒྱལ་བའི་ཞིང་ཁམས་གཟིགས་པར་ངེས་ཤིང་།",
    "སྤྱན་དྲུག་འགྲོ་བ་ཡོངས་ལ་གཟིགས་པའི་ཐོ་ཡིག་ལགས་སོ།",
    "རྒྱལ་བུ་འདིའི་ཕྱག་གི་སོར་མོ་བཅུ་ལ།",
    "ས་གཞིའི་ཁྱོན་བཅས་གནོན་པར་ངེས་ཤིང་།",
    "ངན་སོང་གནས་ནས་འདྲེན་པར་ངེས་ཤིང་།",
    "ཡི་གེ་ཧཱུྃ་གི་འབྲུ་བཀོད་པ་ནི།",
    "རྒྱལ་བུ་འདི་ནི་བོན་ཐམས་ཅད་ཤེས་བྱ་ལྷག་མཐོང་གི་མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་མཉམ་པའི་རང་བཞིན་དུ།",
    "རྒྱལ་བུ་འདི་ནི་བོན་ཐམས་ཅད་སྤྱི་དང་རང་གི་མཚན་ཉིད་མ་འདྲེས་པའི་ཡོན་ཏན་སོ་སོར་ནས་བྱུང་བའི་རང་བཞིན་དུ།",
    "རྒྱལ་བུ་འདི་ནི་བོན་ཐམས་ཅད་རྨད་ཀྱི་ཁྱད་པར་གྱི་གཟིགས་ཚད་སོ་སོའི་རང་བཞིན་དུ།",
    "རྒྱལ་བུ་འདི་ནི་བོན་ཐམས་ཅད་མཚན་མ་མེད་པ་གཡུང་དྲུང་གི་གཟེར་ལྟར་གནས་པ་བྱ་བ་ལ་ནན་ཏན་གྱི་རང་བཞིན་དུ།",
    "རྒྱལ་བུ་འདི་ནི་བོན་ཐམས་ཅད་དགོངས་པ་ཟབ་མོའི་བསམ་པ་མྱ་ངན་ལས་འདས་པ་ཆགས་སུ་མེད་པ་བྱ་བ་ལ་ནན་ཏན་གྱི་རང་བཞིན་དུ།",
    "རྒྱལ་བུ་འདི་ནི་གློག་གི་སྒྲོན་མའི་ཏིང་ངེ་འཛིན་དང་ལྡན་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདི་ནི་མྱུར་མགྱོགས་གློག་གི་ཏིང་ངེ་འཛིན་དང་ལྡན་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདི་ནི་མཐའ་མ་རེག་པའི་ཏིང་ངེ་འཛིན་དང་ལྡན་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདི་ནི་ཐིག་ལེ་ངང་གི་ཏིང་ངེ་འཛིན་དང་ལྡན་པ་ཞིག་གདའོ།",
    "རྒྱལ་བུ་འདིའི་ཕྱག་གི་སོར་མོ་བཅུ་ལས་ཀྱང་།",
    "རྒྱལ་བུ་འདིའི་ཞབས་ཀྱི་སོར་མོ་བཅུ་ལས་ཀྱང་།",
    "འོད་ཟེར་དེ་དག་རེ་རེ་ལ་ཡང་སྤྲུལ་པའི་སྐུ་ཟག་པ་ཟད་པ།",
    "ཉོན་མོངས་པ་མེད་པ།",
    "བྱོལ་སོང་དང་།",
