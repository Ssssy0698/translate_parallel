    "འདི་སྙམ་དུ་བདག་གི་ཕྱི་བཞིན་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འབྲང་ངོ་སྙམ་དུ་མི་སེམས་སོ།",
    "འདི་སྙམ་དུ་བདག་གི་ཕྱི་བཞིན་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འབྲང་ངོ་སྙམ་དུ་མི་སེམས་སོ་ སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་འདི་སྙམ་དུ་བདག་ནི།",
    "དེ་དག་གི་རང་བཞིན་ནི་དེ་ཡིན་ཏེ།",
    "བདག་གིས་གང་ཡང་ཡོངས་སུ་གཏང་བ་མེད་དོ།",
    "ཡན་ལག་དང་ཉིང་ལག་བཅད་ཀྱང་ཞེ་སྡང་གི་སེམས་མི་སྐྱེད་དོ།",
    "དེ་བས་ན་བདག་གིས་ཤེས་རབ་འཆལ་པ་དང་ལྡན་པའི་སེམས་འགའ་ཙམ་ཡང་བསྐྱེད་པར་མི་བྱའོ་སྙམ་སྟེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ལྔ་པོ་འདི་དག་གིས་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་འཐོབ་པར་མི་འགྱུར་ཏེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་འདི་དག་གིས་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་འཐོབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྟེན་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་འདི་དག་གིས་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མིང་འཐོབ་པར་འགྱུར་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ཅིའི་སླད་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་དེ་དག་གི་རབ་ཅེས་བགྱི།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་པོ་འདི་དག་གི་རབ་ཅེས་བྱ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རེག་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་མིག་གི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་སྣའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ལྕེའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་མིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རེག་པ་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་མི་འཛིན་མི་གཏོང་ངོ།",
    "ཇི་ལྟར་ན་རེག་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་མིག་གི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་མིག་གི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་སྣའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་ལྕེའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་པ་ལགས།",
    "ཇི་ལྟར་ན་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "ཇི་ལྟར་ན་རང་གི་མཚན་ཉིད་སྟོང་། པ་ཉིད་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ལགས།",
    "རེག་ཡིད་ལ་མི་བྱེད་པས་རེག་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ཡིད་ལ་མི་བྱེད་པས་མིག་གི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "མིག་། གི་འདུས་ཏེ་རེག་པ་ཡིད་ལ་མི་བྱེད་པས་མིག་གི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡིད་ལ་མི་བྱེད་པས་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ཡིད་ལ་མི་བྱེད་པས་སྣའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཡིད་ལ་མི་བྱེད་པས་ལྕེའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡིད་ལ་མི་བྱེད་པས་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡིད་ལ་མི་བྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡིད་ལ་མི་བྱེད་པས་མིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡིད་ལ་མི་བྱེད་པས་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡིད་ལ་མི་བྱེད་པས་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡིད་ལ་མི་བྱེད་པས་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡིད་ལ་མི་བྱེད་པས་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡིད་ལ་མི་བྱེད་པས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རེག་པ་ཡིད་ལ་མི་བྱེད་པས་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཡིད་ལ་མི་བྱེད་པས་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུམ་བཟུང་མ་བཏང་བ་ཡིན་ནོ་། མི་དམིགས་པ་སྟོང་པ་ཉིད་ཡིད་ལ་མི་བྱེད་པས་མི་དམིགས་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རེག་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་། ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རེག་པ་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་མ་བཟུང་མ་བཏང་བ་ཡིན་ནོ།",
    "འཆི་བ་ལས་རྒྱལ་གཟིག་གོས་ཅན་།",
    "ཨཤྭཏྠཐོས་རྟུལ་མོའི་བུ་།",
    "སྒྲ་ཅན་གསོད་དང་སྦྲང་གི་བུ།",
    "ལྷ་མོ་དགའ་བ་དཔའ་བོའི་རྒྱུད་།",
    "སྐར་ཁུང་གིསབརྒྱན་པ།",
    "ཀུནནས་ཉོན་མོངསཔ་ཅནཀྱིའཇིག་རྟེནགྱི་ཁམས་ཡོངས་སུསྤྱོང་བ་ཤ་སྟག་དང་།",
    "གཞན་དག་ངཕྱུག་པའི་བསམ་པར་དགོད་དོ་ཞེས་དབུགས་འབྱིན་པ་རེདཔརགྱུར་ཏེ།",
    "གཞན་དག་ཀྱང་དད་པ་ལ་དགོདདོ་ཞེས་དབུགསའབྱིན་པརེདཔར་འགྱུར་ཏེ།",
    "གཞན་དག་ཀྱང་འདུས་བྱས་དང་དབྱེར་མེད་པ་འདུས་མ་བྱས་ཤེས་པ་ལ་དགོད་དོཤིས་དབུགས་འབྱིན་པ་རེད་པར་འགྱུར་ཏེ།",
    "དེལ་བདག་དང་དབྱེར་མེདཔ་བདཔག་མེདཔ་ནི་བདག་གི་རང་བཞིན་གང་ཡིན་པའོ།",
    "བདག་མེདཔ་བདག་གི་རང་བཞིན་ལས་གཞན་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "བདག་གི་རང་བཞིན་ལས་བདག་མེད་པ་བཞན་མེད་པས་བདག་གིརང་བཞིན་ཉིད་བདག་མེད་པ་སྟེ།",
    "གཞན་དག་དདརྐྱེན་ཚོགས་པའི་བྱེད་པ་དང་ད་པརྒྱུ་དང་རྐྱེན་ཚོགས་པའི་བྱེདཔ་མེདཔ་ཤེས་པ་ལ་དགོད་དོ་ཞེས་དབུགས་འབྱིན་པ་རེདཔར་འགྱུར་ཏེ།",
    "བདག་ནི་མོ་ཤམ་གྱི་བུམ་ཡིན་པ་དང་དབྱེར་མེད་པའི་མོ་ཤམ་གྱི་བུ་ཤེས་པ་ལ་གནས་ཀྱིས།",
    "མོ་ཤམ་གྱི་བུའི་རང་བཞིན་ལས་མོ་ཤམ་གྱི་བུ་མ་ཡིན་པ་གཞན་མེད་པས་མོ་འམ་གྱི་བུའི་རང་བཞིན་ཉིད་ལོ་ཤམ་གྱི་བུ་མ་ཡིན་པ་སྟེ།",
