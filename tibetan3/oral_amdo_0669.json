    "ཀུནའགོག་ལམ་སྤང་རེ་རེའི་ལོག་ལྟ་དྲུག།",
    "རེ་རེ་ཐོབ་མ་ཐག་དང་དྲུག་ཡོད་པའོ།",
    "གཉིས་ཙམ་གཏོང་བ་འདོད་ཟལ་ཙམ་སོང་བའི།",
    "ཆགས་བཅས་པ་དངགཟུགས་བྲལ་སྔོན་སོང་གི།",
    "ཀུན་འགོག་ལམ་སྤང་མཆོག་འཛིན་བརྒྱུདཙམ་མོ།",
    "གཉིས་ཙམ་ལྡན་པ་གཟུགས་མོད་འཕགས་པ་དེ།",
    "འདོད་པའི་སྒོམ་སྤང་ཟག་མེད་གང་གི་ཡང་།",
    "ག་ཟུགས་ཀྱི་འགོག་ལམ་མཐོང་སྤང་གང་རུང་གི།",
    "རེ་རེ་ཐོབ་མ་ཐག་པའི་ཆགས་བཅས་པ།",
    "ཉོན་མོངས་སྟོབས་ཀྱི་དགྲ་བཅོམ་ལས་ཉམསཚོ།",
    "བཅུ་གཉིས་ཙམ་རེད་གསར་དུ་རྙེད་པ་མེད།",
    "གཉིས་པདགུ་ནི་འདོད་པའི་སྡུག་སྤང་གི།",
    "མ་རིག་པ་སྟེ་ལྔ་དང་ཀུན་སྤང་གི།",
    "གོངམ་གཉིས་ཀྱི་འགོག་སྤང་མཐོང་སྤང་གི།",
    "འདོདཆགས་དརྒྱལ་བཞི་སྟེ་ཉེར་གསུམ་མོ།",
    "བདེན་ཏེ་འོན་ཀྱད་འགོག་ལམམཐོང་སྤང་གི།",
    "གཉིསཙམ་ལྡན་པ་གཟུགས་བྲལ་སྔོན་སོང་གི།",
    "སྔར་གྱི་ཞེ་ལྔ་འདོད་པའི་སྡུག་སྤང་གི།",
    "ཆགས་བཅས་པ་དེ་འདོད་པའི་ཀུན་སྤང་གི།",
    "རེ་རེ་ཐོབ་མ་ཐག་པའི་ཆགས་བཅས་དེ།",
    "གཟུགས་དང་གཟུགས་མེད་འགོག་ལམ་མཐོང་སྤང་གི།",
    "ཆགས་བཅས་པ་ད་འདོད་པའི་སྡུག་སྤང་གི།",
    "ཨེ་སྐྱེ་དེ་ནི་འདོད་པའི་སྡུག་སྤངགི།",
    "བདེན་བ་མཐོངལ་སྦྱོར་ལམ་སྔོན་སོང་དགོས།",
    "དེར་ཐལ་དེའི་ཕྱིར་མི་སྡུག་སྒོམ་བའི་དེ།",
    "དམིགས་པའི་ཉོན་མོངས་སྤངས་མཐག་བའི་ཕྱིར།",
    "གཅིག་ཙམ་ལ་དམིགས་ཉོན་མོངས་སྤངས་མ་ཐག།",
    "མེ་དདོ་ཟེར་ན་བཞི་བའི་ཉོན་མོངས་དེ།",
    "སྦངས་མཐག་བའི་ཕྱིར་མི་འོང་དཡིན། ། མ་གྲུབ་ན་ནི་ཐལ་ཕྱིར་རྟགས་གྲུབ་སྟེ།",
    "དེར་ཐལ་དེའི་ཕྱིར་སྲིད་རྩེའིལམ་བདེན་དུ།",
    "གྱར་བའི་ལུས་དྲན་ཉེར་བཞག་གི་ཡུལ་ལ།",
    "གཞན་གསུམ་ལ་ནི་དམིགས་པའི་སྦཉོན་མོངས་གསུམ།",
    "མི་ངགིས་སོ་བདུན་ཡིན་གྱི་རྫས་སུ་བཅུའོ།",
    "པའི་ཉོན་མོངས་གཅིག་ཆར་སྤངས་ཕྱིར་རོ།",
    "ཡུལ་ཡིན་ཟེརན་འདོད་པའི་བདེན་བཞིར་ཐལ།",
    "དེ་ལྟར་བར་ཐལ་སེམས་ཤེས་ཡུལ་ཡིན་ཕྱིར།",
    "ཕ་རེལ་སེམས་ཤེས་གཅིག་སྟེ་བདུན་ཙམ་གྱིའོ།",
    "བདུན་ཙམ་ལ་དམིགས་ཏོན་མོངས་གསར་སྤངས་སོ།",
    "གཅིག་མ་ལ་དམིགས་ཉོན་མོངས་གསར་སྤངས་བཞིའོ།",
    "དངཔོའི་ཉོན་མོངས་གསར་སྤངས་སྐྱེ་འཕགས་དང་།",
    "གཉིས་ཙམ་ལ་དམིགས་ཉོན་མོངས་སྤངས་མ་ནི།",
    "དམིགས་པའི་ཉོན་མོངས་སྤངས་མ་ཐག་པའི་ཕྱིར།",
    "དམིགས་ཉོན་མོངས་སྤངས་པ་ཕྱིར་འོང་དང་།",
    "བཞི་པའི་ོན་མོངས་གསར་སྤངས་ཕྱིར་མི་ལྡོང་།",
    "སྙོམས་འཇུག་རེ་རེ་ཙམ་ལ་དམིགས་པའི་དེ།",
    "ཉོན་མོངས་སྤངས་མ་ཐག་པ་གསུམ་པ་ནི།",
    "དམིགས་པའིཉོནམོངས་སྤངས་མ་ཐག་པའི་ཕྱིར།",
    "སྐང་བྱ་ཀུནའབྱུང་ལས་དང་ཉོན་མོངས་འབྱུང་ལུགས་སོགས་ལ་མཁས་དགོས་ཤིང་།"
  ]
}