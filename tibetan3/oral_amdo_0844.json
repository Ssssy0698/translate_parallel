    "དེ་ལ་ཞེས་བྱ་བ་སྟེ་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་དེ་མ་ཐག་པར་གྱུར་པ་ནའོ།",
    "རང་གིས་མཐོང་བའི་དོན་རབ་ཏུ་གསལ་བར་བྱེད་པ་ཉིད་དུ་རྣམ་པར་གནས་ཀྱི།",
    "འདི་རྣམ་པར་འགྲེལ་པ་ནི་རང་གི་ཞེས་བྱ་བ་སྟེ་རྒོལ་བ་ལ་སོགས་པའི་བདག་གིས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྒོལ་བ་དང་ཕྱིར་རྒོལ་བ་རང་གིས་ཞེས་གསུངས་སོ།",
    "གང་གི་ཚེ་རྒོལ་བ་ཡང་དག་པའི་སྒྲུབ་བྱེད་བརྗོད་པས་སྟོན་པར་བྱེད་པ་དེའི་ཚེ་ཕྱིར་རྒོལ་བ་ཡང་དག་པ་མ་ཡིན་པའི་ཉེས་པ་བརྗོད་པའི་ཕྱིར་བསྟན་པར་བྱ་བ་ཉིད་ཡིན་ལ།",
    "གང་གི་ཕྱིར་རྒོལ་བ་ཡང་དག་པའི་ཉེས་པ་བརྗོད་པས་སྟོན་པར་བྱེད་པ་ཡིན་པ་དེའི་ཚེ་ནི།",
    "༢༡་༩༣༨གིས་རབ་ཏུ་གསལ་བར་བྱེད་པ་ཞེས་བྱ་བ་ལ་ལྟོས་སོ།",
    "དེ་དག་གིས་ཅི་ཞིག་རབ་ཏུ་གསལ་བར་བྱེད་སྙམ་ན།",
    "རང་གིས་མཐོང་བ་ཞེས་བྱའོ་༤།",
    "གལ་ཏེ་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་གང་ཡིན་པ་འདི་དག་ཁོ་ན་ལ་རང་གིས་མཐོང་བ་རབ་ཏུ་གསལ་བར་བྱེད་པ་ཡིན་ནམ་སྙམ་ན།",
    "དེ་དག་འབའ་ཞིག་རང་གིས་མཐོང་བ་གསལ་བར་བྱེད་པ་ཡིན་པར་ནི་མ་ཟད་དེ།",
    "དེ་དག་གིས་མཐོང་བའོ།",
    "ཤུགས་ཉིད་ལས་ཞེས་བྱ་བ་ནི་ིརང་གིས་མཐོང་བའི་དོན་སྨོས་པའི་ཤུགས་ལས།",
    "གང་ཞིག་གསལ་བར་བྱེད་པ་རང་གིས་མཐོང་བ་དེ་གང་ཡིན་སྙམ་ན།",
    "རང་གིས་མཐོང་བའི་དོན་ཞེས་གསུངས་ཏེ།",
    "༩༣༩འདི་ལ་ཕ་རོལ་པོ་གཏན་ཚིགས་སྨྲ་བ་ནི་རང་གིས་མཐོང་དོན་སྨོས་པ་ནི་ཞེས་བྱ་བའོ་ ། དོན་ཙམ་ཡིན་པས་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡང་སྟོན་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གི་ཚེ་རྗེས་སུ་དཔོག་པ་པོ་དུ་བ་ལ་སོགས་པ་ལས་མེ་ལ་སོགས་པའི་དོན་རྟོགས་པ་དེའི་ཚེ་དེ་རང་གིས་མཐོང་བ་ཡིན་པའི་ཕྱིར་དེ་ཡང་རང་གིས་མཐོང་དོན་སྨོས་པས་སྟོན་པ་ཡིན་པར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་བསྒྲུབ་པར་བྱ་བའི་རང་བཞིན་དེ་ནི་བརྗོད་ཀྱང་གཞན་གྱིས་རྟོགས་པར་བྱ་བ་མི་ནུས་པ་དེའི་ཕྱིར་ན་བསྒྲུབ་པར་བྱ་བ་ལ་ནི་གསལ་བར་བྱེད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "རབ་ཀྱི་ཚིག་ཅེས་བྱ་བ་ནི་རང་གིས་མཐོང་དོན་རབ་གསལ་བྱེད།",
    "དེ་ཡང་ནི་ཚིག་གིས་སོ།",
    "ཁྱོད་ཀྱང་དོན་དེ་ལ་མངོན་དུ་ཕྱོགས་པར་རུང་བ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ངེས་པར་སྦྱོར་བར་བྱེད་པ་པོ་ནི་ངེས་པར་སྦྱོར་བའི་ཚིག་གིས་བདག་ཉིད་ཀྱི་དོན་དེ་ལ་མངོན་དུ་ཕྱོགས་པའི་དངོས་པོ་མི་བརྗོད་པ་མ་ཡིན་ནམ།",
    "མངོན་དུ་ཕྱོགས་པར་གྱུར་པ་ལ་ཞེས་བྱ་བ་འདི་ནི་ཐུན་མོང་བ་སྟེ་མངོན་སུམ་བསྐྱེད་པ་ཉིད་ལ་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེས་ན་རྗེས་སུ་དཔག་པས་ཏེ།",
    "དེ་ལྟར་འགྱུར་མོད་ཅི་སྐྱོན་སྙམ་ན་ཚིག་གི་འབྲས་བུའི་གཏན་ཚིགས་ཚུལ་གསུམ་པ་ནི་གསལ་བ་མ་ཡིན་ནོ།",
    "ཁྱབ་ེཔ་ཉིད་ཚིག་གིས་བསྟན་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་འདིར་ཁྱབ་པ་གྲུབ་པའི་ཕྱིར་དེ་བརྗོད་པ་ནི་མ་ཡིན་གྱི།",
    "ཚིག་གི་དོན་ནི་ཞེས་གསུངས་སོ།",
    "འདི་དུ་བའོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏེ་དགོས་པ་ནི་འདི་ཡིན་ཏེ་ཞེས་བྱ་བ་འཆད་པར་འགྱུར་བའི་མཚན་ཉིད་དེ་ཚུལ་གསུམ་པའི་རྟགས་གསལ་བའོ།",
    "མངོན་སུམ་གྱིས་གྲུབ་པ་སྟོན་པ་ནི་ཚིག་གི་དགོས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ནོ།",
    "མངོན་སུམ་གྱིས་མཐོང་བའི་དོན་ཏེ་རང་གི་མཚན་ཉིད་དོ།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་རྒྱུ་རྗེས་སུ་དཔག་པ་ནི་ཡོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་དེ་ནི་ཞེས་བྱ་བ་སྟེ།",
    "རང་གི་དོན་གྱི་ཞེས་བྱ་བ་ནི་འཆད་པའོ།",
    "འདི་ལྟར་གལ་ཏེ་ཡང་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པར་དུ་བ་འབྲས་བུའི་གཏན་ཚིགས་ཡིན་པ་དེ་ལྟ་ན་ཡང་འབྲས་བུའི་གཏན་ཚིགས་སུ་ཡང་འགྱུར་བ་ཡིན་ནོ།",
    "རྟོགས་པ་པོ་འཁྲུལ་པ་མེད་པ་ལ་ལྟོས་ནས་ནི་ཇི་ལྟར་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་མ་ཆོད་པ་༧ཁོ་ནར་འབྲས་བུའི་གཏན་ཚིགས་ཡིན་པ་དེ་བཞིན་དུ་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་བརྗོད་པ་ནི་ཡང་ན་ཞེས་བྱ་བའོ།",
    "ཚུལ་དེ་ཉིད་ཅེས་བྱ་བ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་བརྗོད་པ་གང་ཡིན་པའོ།",
    "གང་གིས་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་རྒྱུའི་རྗེས་སུ་དཔག་པ་མེད་པའི་ཕྱིར་མཚན་ཉིད་འདི་མི་འགྲིག་པར་འགྱུར་བ་འདི་ན་དུ་བ་ཡོད་དོ་ཞེས་བརྗོད་པའི་ཚིག་རྣམས་ཐམས་ཅད་ནི་དེ་ལྟར་ཏེ་རྗེས་སུ་དཔག་པའི་རྒྱུར་བརྗོད་པར་འདོད་པ་མ་ཡིན་ནོ།",
    "གང་གིས་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་རྒྱུའི་རྗེས་སུ་དཔག་པའི་རྒྱུ་ཉིད་མ་ཡིན་པའི་ཕྱིར་ན་མཚན་ཉིད་འདི་མི་འགྲིག་པར་འགྱུར་བ་རྗེས་སུ་དཔག་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པ་ཉིད་ཀྱི་ལ་ནི་མ་ཡིན་ནོ།",
    "འདི་ན་དུ་བ་ཡོད་དོ་ཞེས་བརྗོད་པའི་ཚིག་ནི་རང་བཞིན་རྗོད་པར་བྱེད་པ་ཡིན་ཡང་རྗེས་སུ་དཔག་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་ན་རྒྱུའི་རྗེས་༦དཔག་གི་རྒྱུར་ཡཡང་འགྱུར་བ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཚུལ་གསུམ་པའི་རྟགས་ལ་མ་གཏོགས་པ་གཞན་ལ་གསལ་བར་བྱེད་པ་མེད་པ་དེས་ན་ཚུལ་གསུམ་སྟོན་པ་ཉིད་ཅི་ལྟར་སྲིད་པར་རྗེས་སུ་དཔག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྐབས་སུ་བབ་༧པ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱང་ཡོད་པ་ཉིད་ནི་སྐད་ཅིག་མ་མེད་པར་མི་འགྱུར་རོ་ཞེས་ངེས་ཤིང་ཡིད་ཆེས་པའི་གནས་ཏེ་རྟེན་ཡིན་ནོ་། དེས་ནི་རྗེས་སུ་དཔག་པ་ལ་ནི་ཞེས་བྱ་བ་སྐད་ཅིག་མ་ཉིད་སྒྲུབ་པར་བྱེད་པའི་རྟགས་ལ་༦རེས་འགའ་འགའ་ཞིག་ཏུ་སྐད་ཅིག་མ་ཉིད་མེད་ཀྱང་ཡོད་པར་འགྱུར་སྲིད་དོ་སྙམ་པའི་འཁྲུལ་པ་བཟློག་པ་ཡིན་ཏེ།",
    "དེའི་རིགས་ཅན་གྱི་ཚིག་གིས་འཁྲུལ་པ་བཟློག་པ་མ་ཡིན་ནོ།",
    "སྐྱེས་བུ་འགའ་ཞིག་གིས་བྱས་པར་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་ཚུལ་གསུམ་པའི་རྟགས་ཉིད་རང་གིས་མཐོང་བའི་སྒྲར་འདོད་པ་ཡིན་གྱི།",
    "ཕ་རོལ་པོ་རང་གིས་མཐོང་དོན་སྨོས་པ་ཚུལ་གསུམ་པའི་རྟགས་ཀྱི་དོན་ཡིན་ན།",
    "། ལོག་པར་རྟོགས་པ་བསལ་བའི་མཚན་ཉིད་ཀྱི་དོན་ཏེ་དགོས་པ་གཞན་རང་གིས་མཐོང་དོན་སྨོས་པ་གང་ལ་ཡོད་པ་སྟེ་དེའི་ཕྱིར་རོ།",
    "བདག་གི་རྒོལ་བའོ།",
    "གཞན་དག་གིས་ནི་ཕྱིར་རྒོལ་བ་དག་གིས་སོ་།",
    "དེའི་ཚེ་རང་ཉིད་རྟོགས་པ་དེ་ཉིད་རྟགས་འདིར་འགྱུར་མོད།",
    "རང་གིས་མཐོང་དོན་སྨོས་པ་ནི་རང་གིས་མཐོང་བར་བསྟན་པའི་ཕྱིར་བྱས་པ་ཡིན་ནོ།",
    "རང་གིས་མཐོང་བ་སྨོས་པ་ནི་གཞན་གྱི་ེམཐོང་བ་འགོག་པ་མ་ཡིན་གྱིས།",
    "དེས་ན་རང་གིས་མཐོང་བ་སྨོས་པའི་མཚན་ཉིད་འདི་ནི་རང་གི་བརྗོད་པར་བྱ་བ་གཉི་གས་མཐོང་བ་ཉིད་རང་གཞན་ཁོ་ནས་ཞེས་ངེས་པར་འགོག་པའི་མཚན་ཉིད་ཅི་ལྟར་གནས་པ་ཉིད་དོ།",
    "རང་གི་མཐོང་བའི་སྒྲ་ནི་རང་གིས་མཐོང་བ་ཉིད་སྒྲུབ་པར་པར་འགོག་པ་ཤེས་པར་བྱེད་པ་ཡིན་ནོ།",
    "རང་གིས་མཐོང་བ་བསྟན་པའི་དོན་ནི་མ་ཡིན་པའོ།",
    "རང་གིས་མཐོང་བའི་སྒྲ་ནི་ལོག་པར་རྟོགས་པ་སེལ་ིབཤུགས་ཀྱིས་རང་གི་༧མཐོང་བ་ཉིད་དུ་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཅི་ཞིག་མི་རིགས་སྙམ་ན་གང་གིས་དོན་དུ་ཞེས་བྱ་བ་སྟེ།",
    "གང་གིས་དོན་ཏེ་དགོས་པ་རང་གི་མཐོང་བ་བསྟན་པའི་མཚན་ཉིད་གང་ཡིན་པ་འདི་རྩོམ་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ནི་ཞེས་བྱ་བ་རང་གི་མཐོང་དོན་སྨོས་པའི་མཚན་ཉིད་དོ།",
    "རང་གི་སྒྲས་བསྡུ་བ་ནི་དོན་གྱིས་རྟོགས་པར་བྱ་བ་སྟེ་དེ་ནི་མི་རིགས་སོ།",
    "ཅི་ལྟར་མི་རིགས་སྙམ་ན་རང་གིས་ཞེས་སྨོས་སོ།",
    "གལ་ཏེ་རང་གིས་མཐོང་བའི་སྒྲས་རྒོལ་བས་མ་མཐོང་བ་མི་༡༦བསྒྲུབས་ན་དེའི་ཚེ་རྒོལ་བ་རང་གིས་མ་རྟོགས་པར་གཞན་གྱིས་རྟོགས་སོ་ཞེས་བརྗོད་པར་མི་ནུས་པར་འགྱུར་རོ།",
    "འོ་ན་ཞེས་བྱ་བར་རང་གིས་ནི་རྒོལ་བས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་བུའི་ཉེས་པ་ཡོད་པ་དེས་ན་རྒོལ་བ་རང་གིས་མ་རྟོགས་པར་འདི་ནི་གཞན་ལ་གྲུབ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདིར་ཅི་ལྟར་འགྱུར་ཏེ་མི་འགྱུར་བ་ཁོ་ནའོ།",
    "དེས་ན་གཞན་གྱིས་རྟོགས་པ་ཤེས་པའི་རྒོལ་བ་རང་གིས་ཀྱང་རྟོགས་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "རང་གིས་རྟོགས་པ་ལ་ལྟོས་པས་སོ།",
    "གཞན་གྱིས་རྟོགས་པའོ་ཞེས་ངེས་པ་གང་ཡིན་པ་དེ་ནི་རྒོལ་བ་རང་གིས་ཀྱང་རྟོགས་པ་ཡིན་ནོ།",
    "རང་གིས་ནི་རྒོལ་བས་སོ།",
    "འོ་ན་ཅི་ལྟར་རང་གིས་མཐོང་བ་ཞེས་མི་བརྗོད་སྙམ་ན།",
    "རྗེས་སུ་དཔག་པས་ཞེས་བྱ་བ་ནི་གྲངས་ཅན་པའི་རྗེས་དཔག་གིས་ཕྱིན་ཅི་ལོག་སེམས་པ་མྱོང་བར་མི་འགྲུབ་པོ།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པ་སྟོན་པར་བྱེད་པའི་ཚིག་གི་ཕྱོགས་གཅིག་པོ་གང་ཡིན་པ་དེ་ནིའོ།",
    "རང་གི་མཚན་ཉིད་ནི་རང་གི་གསལ་བར་བྱ་བ་སྟེ།",
    "དེ་ལྟ་མོད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཞན་གྱི་སྟེ་རྒོལ་བས་སྒྲུབ་པར་བྱེད་པ་མ་ཤེས་ཀྱང་ཉེས་པ་མེད་པ་ཉིད་དོ།",
    "དེ་ནི་རེ་ཞིག་ཅེས་སྨོས་ཏེ།",
    "ཁྱོད་ལ་སྟེ་བསྟན་པར་བྱ་བ་ལ་གཏན་ཚིགས་ཏེ་གྲུབ་ནའོ།",
    "དེ་ལྟ་མོད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྩོད་པ་ལ་ལན་བརྗོད་པའོ།",
    "རང་གིས་ཏེ་རྒོལ་བ་གྲངས་ཅན་ཉིད་ཀྱིས་མ་རྟོགས་པར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་རང་གིས་རྟོགས་ན་རྒོལ་བ་འདིས་ནི་རྟགས་འདི་རྟོགས་སོ་ཞེས་བྱ་བར་རོ།",
    "གང་གི་ཚེ་ཞེ་ན།",
    "གལ་ཏེ་གཞན་ཕྱིར་རྒོལ་བ་སྒྲུབ་པར་བྱེད་པའི་རང་གི་ངོ་བོ་རྟོགས་པར་ཁས་མི་ལེན་ནའོ།",
    "རེས་འགའ་ཁས་ལེན་པར་འགྱུར་རོ་སྙམ་ན།",
    "རྒོལ་བས་སྒྲུབ་པར་བྱེད་པའི་རང་གི་ངོ་བོ་རྟོགས་ན་ནི་ཉེས་པ་མེད་དོ་ཞེས་སྟོན་པ་ནི་རང་ཉིད་ཅེས་བྱའོ་།",
    "དེས་ན་རང་གིས་རྟོགས་པའི་སྒྲུབ་པར་བྱེད་པ་ནི་གཞན་གྱིས་རྟོགས་སོ་ཞེས་ཤེས་པར་ནུས་ཀྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ།",
    "རྒོལ་བས་སྒྲུབ་པར་བྱེད་པ་རང་གིས་རྟོགས་ཀྱང་གཞན་ཕྱིར་རྒོལ་བ་རྟགས་རྟོགས་སོ་ཞེས་ཅི་ལྟར་ཤེས།",
    "གཉིས་ལས་གང་རུང་གི་ཕྱོགས་སུ་ལྷུང་བའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "ཆགས་པ་ལས་གྱུར་ཏེ་གཉིས་ལས་གཅིག་གིས་ཕྱོགས་སུ་ལྷུང་བ་ན་ཡང་རིག་པས་འཐད་པའི་ཕྱོགས་ལ་ཡང་ཡིད་གཏོད་པར་མི་དའོ།",
    "དེའི་ཕྱིར་ན་ཉན་པར་བྱེད་པ་དག་གིས་རྟོགས་པ་ཉིད་དོ་ཞེས་ཅི་ལྟར་རྟོགས་པར་བྱེད་སྙམ་ན།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཉན་པ་པོ་ཡོད་པ་དེའི་ཕྱིར་རོ།",
    "འོ་ན་གང་གི་ཚེ་ཞེས་བྱ་བ་ནི་གཞན་གྱིའོ།",
    "གང་གི་ཚེ་ཞེ་ན་སྐལ་ལྡན་ཡང་ནི་ཞེས་བྱ་བའོ།",
    "བདག་གིས་དེའི་སློང་ཕོར་དུ་གཅིན་བཏུང་བར་བྱའོ་ཞེས་བྱ་བ་འདི་དང་མཚུངས་པ་ནི་བདག་གིས་འདི་ལ་སྒྲུབ་པར་བྱེད་པ་མ་འབྲེལ་པར་ྱབརྗོད་པར་བྱའོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "རང་གིས་ེབསྒྲུབ་པར་བྱ་བ་སེམས་པ་མེད་པ་ཉིད་རབ་ཏུ་གྲུབ་པ་སྟེ།",
    "བསྟན་བཅོས་ཁས་བླངས་པར་གྱུར་ན་གཉི་ག་ལ་གྲུབ་པ་ལུང་གི་མཚན་ཉིད་སེམས་པ་མེད་པའི་སྒྲུབ་པར་བྱེད་པ་སྲིད་པ་ན་ལུང་གི་མཚན་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པ་ལས་གཞན་གང་ཡིན་པ་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་དེ་ཉེ་བར་འགོད་པ་ནི་ེའགའ་ཡང་བྱ་བ་ཉིད་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེས་ན་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་མེད་པའི་སྒྲུབ་པར་བྱེད་པ་སྟེ་ཉེ་བར་དགོད་པས་ཅི་ཞིག་བྱ་སྟེ་ཅི་ཡང་བྱར་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་ཡིན་དང་སྔར་སེམས་པ་མེད་པ་ལ་སོགས་པའི་བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་གང་གིས་འདིས་རྟོགས་པར་གྱུར་པ་དེ་ཉིད་ཀྱིས་གཞན་ལ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན།",
    "གང་གིས་༣ ཕྱིར་དངོས་པོ་སྟེ་རྟགས་དང་འབྲེལ་༤མེད་དེ་འབྲེལ་བ་མེད་པའི་སྟེ་དངོས་པོར་གྱུར་པའི་རྟགས་མེད་པར་སྐྱེས་པས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པའི་སྒྲུབ་པར་བྱེད་པ་འདི་ནི་ཁྱོད་གྲངས་ཅན་ལའོ།",
    "དེ་ལྟར་ན་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་ཚིག་ཉིད་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ཡིན་གྱིས་། གཞན་ནི་མ་ཡིན་ནོ་ཞེས་གནས་སོ།",
    "དེ་ལས་ཞེས་བྱ་བ་ལས་ིཐལ་བ་སྒྲུབ་པར་བྱེད་པ་ལས་སོ།",
    "འོ་ན་ཐལ་བར་༩༧༢།",
    "ཡང་ཐལ་བར་སྒྲུབ་པ་དེ་གང་ཡིན་ཞེ་ན།",
    "ཐལ་བར་སྒྲུབ་པ་དེ་ནི་འདི་ཡིན་༤ཞེས་སྨོས་སོ།",
    "ཐལ་བའི་སྒྲུབ་བྱེད་གཉིས་པ་བརྗོད་པ་ནི་དེ་བཞིན་དུ་ཞེས་བྱ་བའོ།",
    "དུས་དེའི་ཡང་སྔོན་དང་ཕྱི་མ་ནི་ཡོད་པ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་རང་གི་ངོ་བོ་ཁོ་ན་ལས་ཡིན་གྱི།",
    "དུས་གཞན་ཐ་དད་པ་ལས་ནི་མ་ཡིན་ནོ་། དེ་བཞིན་དུ་ཡུལ་ཡང་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོ་ཁོ་ན་ལས་ཤར་བ་ལ་སོགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོན་ཏེ་དངོས་པོ་དང་དུས་ལ་སོགས་པ་དག་གིས་སྔ་མ་དང་ཕྱི་མ་ཉིད་ཁས་མི་ལེན་གྱི།",
    "དེའི་ཚེ་རྒྱུ་ཡོད་པ་དང་མེད་པ་དག་ཉིད་ལས་འགྱུར་མོད།",
    "ཐལ་འགྱུར་བས་ཞེས་བྱ་བ་ནི་ཡུན་རིང་བ་དང་མྱུར་བ་ལ་སོགས་པའི་དབྱེ་བའོ།",
    "རྟགས་ནི་མོ་རྟགས་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་བྱ་བ་དེ་ལྟར་བྱ་བ་མེད་པ་དེས་ནའོ།",
    "དུས་ལ་སོགས་པ་ཞེས་སོགས་པའི་སྒྲ་ལ་སོགས་པའི་ཚིག་གི་དོན་བསྡུའོ།",
    "གང་གིས་འཛིན་པ་མེད་ཅེ་ན།",
    "དེ་ལ་རེ་ཞིག་བློའི་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་གཞན་དུ་ནི་ཞེས་བྱ་བ་བློ་ལའོ།",
    "རྣམ་པ་གཉིས་པོ་ཉིད་སྟོན་པ་ནི་བརྒྱ་ཞིག་ལ་རང་གི་ངོ་བོ་ཞེས་བྱ་བའོ།",
    "དེ་ལ་རྣམ་པར་རྟོག་པ་དང་པོ་སེལ་བ་ནི་རང་གི་ངོ་བོ་ཞེས་བྱ་བའོ། ། འོ་ན་བློའི་ངོ་བོ་ཉིད་སྤྱིར་འགྱུར་རོ་སྙམ་མོ་༤།",
    "འདིས་ནི་ཚིག་གི་ལེའུར་བྱས་པ་དང་པོ་རྣམ་པར་བཀྲལ་ལོ།",
    "རྣམ་པ་གཉིས་ནི་གསལ་བ་དང་སྤྱིའི་རྣམ་པ་གཉིས་སྣང་བར་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་གིས་དེ་བཟུང་བས་གསལ་བ་གཞན་ཡང་བཟུང་བར་ཐལ་བ་གསལ་བ་གཞན་དང་གསལ་བ་གཞན་གྱི་ལྷན་ཅིག་དེའི་བདག་ཉིད་ཇི་ལྟར་ཡིན་ཞེ་ན་བརྒྱུད་པས་ཞེས་བྱ་བའོ།",
    "དེས་ན་བརྒྱུད་ནས་རྣམ་པ་དང་ལྡན་པ་གཞན་ཡང་རྣམ་པ་དང་ལྡན་པ་གཞན་དང་དེའི་བདག་ཉིད་ཡིན་ལ་དེ་ལྟར་ན་རྣམ་པ་བཟུང་བ་ན་རྣམ་པ་དང་ལྡན་པགཞན་བཟུང་བར་ཐལ་ལོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིས་ནི་ཞེས་བྱ་བ་ནི་རྣམ་པ་དང་ལྡན་པ་ཐ་མི་དད་པར་ཐལ་བས་ནིའོ།",
    "༩༨༣ཐ་མི་དད་པ་ཞིག་ཡིན་དེ་ལ་རེ་ཞིག་ཕྱོགས་དང་པོ་སེལ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཡང་ན་ནག་པ་ེལ་སོགས་པ་རྒྱུ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་སྐྱོན་ཉིད་དོ་ཞེས་གསུངས་པ་ནི།",
    "དབྱིག་པ་དང་སྐྱེས་བུ་དག་ལ་ནི་དེ་ལྟར་རྟོགཔས་བཀོད་པ་ནི་ཡིན་གྱི་དངོས་པོ་ལས་ནི་མ་ཡིན་ནོ།",
    "རྒྱུ་འབྲེལ་པ་ཅན་ཉིད་ཡོད་ན་ཧ་ཅང་ཐལ་བའི་ཉེས་པ་བརྗོད་པ་ནི་རྒྱུ་ཉིད་ནི་ཞེས་བྱ་བའོ།",
    "རེ་ཞིག་རྩོད་པའི་ཆ་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི་ནག་པོ་ཞེས་བྱའོ།",
    "འོ་ན་ཐ་དད་པར་འགྱུར་མོད།",
    "རྩེད་མོ་ཉིད་ཀྱི་གཞུང་འཛུགས་པ་ནི་ཐ་དད་ཕྱོགས་ནི་ཞེས་བྱ་བའོ།",
    "གཙོ་བོ་དེའི་གནས་སྐབས་ཐམས་ཅད་འཛིན་པའི་ཕྱིར་སྐྱེས་བུ་ཐམས་ཅད་ཀྱིས་ཐམས་ཅད་མཐོང་བར་ཐལ་ལོ།",
    "ཐམས་ཅད་མཐོང་བར་ཐལ་བ་ཉིད་སྤོང་བ་ནི་འོ་ན་ཏེ་ཞེས་བྱ་བའོ་། ཐམས་ཅད་ཐམས་ཅད་ཀྱི་བདག་ཉིད་ཡིན་པ་ནི་རྟོགས་༤པས་གནོད་དོ་ཞེས་ལན་འདེབས་པ་ནི་དེ་ཡང་ཞེས་བྱ་བའོ།",
    "གྲངས་ཅན་རང་གི་ལུགས་དང་འགལ་བ་ཡང་ཡིན་ནོ་ཞེས་བསྟན་པའི་དོན་དུ་དེའི་ལུགས་འགོད་པ་ནི།",
    "དོན་དམ་པར་ཡོད་པ་ནི་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་འགྲོ་བ་མཐའ་དག་ནི་གཙོ་བོ་དེ་ལས་སྐྱེ་བར་འགྱུར་བ་ཡིན་ཏེ།",
    "སྐྱེད་མོས་ཚལ་དང་ཀུན་དགའ་ར་བ་ལ་སོགས་པའི་མཐོང་བའི་ལམ་དུ་གང་གྱུར་པ་དེ་ནི་གཙོ་བོ་ཡང་ཤིན་ཏུ་གསོག་པ་ངོ་བོ་ཉིད་མེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "གང་གིས་ཕྱིར་ཞེས་བྱ་བའོ།",
    "འོན་ཀྱང་གསོག་གི་རང་བཞིན་དུ་གྱུར་པའི་གསལ་བ་ལས་གསོག་མ་ཡིན་པའི་རང་བཞིན་གྱིས་ནུས་པ་ནི་གཞན་ཁོ་ན་ཡིན་པས་གཙོ་བོ་དེ་དང་བདག་ཉིད་གཅིག་པ་ཡིན་ཡང་གསོག་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བྱ་བའི་ཕྱོགས་གཉིས་པའི་དོགས་པ་བསུ་བ་ནི།",
    "ཅི་སྟེ་ཞེས་བྱ་བ་ནི་རྒྱུ་ལ་ཡོད་པའི་འབྲས་བུ་ནུས་པའི་རང་བཞིན་ཅན་ནི་གསལ་བ་ལས་གཞན་ཉིད་ཡིན་གྱི་གསོག་གི་རང་བཞིན་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་གཞན་གྱི་ལུགས་ལ།",
    "ཐ་སྙད་པ་དག་གིས་ཞེས་བྱ་བ་ནི་དེ་ཉིད་འདིའོ་ཞེས་ཐ་སྙད་བྱེད་པ་དག་གིས་སོ།",
    "འོ་ན་སྔར་གྱི་རྗེས་སུ་འབྲངས་ནས་རྟོགས་པ་གང་དག་ཡིན་པ་དེ་ལ་སྤྱི་ཡོད་མོད་སྙམ་ན།",
    "ཚིག་གི་ལྷག་མ་མེད་ན་ནི་མ་འབྲེལ་བ་བརྗོད་པར་འགྱུར་ཏེ།",
    "ཁ་དོག་དང་དབྱིབས་སུ་སྣང་བ་བ་ལང་གི་རྣམ་པར་རྟོག་པའོ།",
    "གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་ཏེ་རང་བཞིན་གཞན་གྱིས་སྟོང་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའོ།",
    "ཐལ་བ་སྒྲུབ་པར་བྱེཞེས་བྱ་བ་ནི་ཐལ་བ་ནི་འཐོབ་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་དང་།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་ཐལ་བ་བསྒྲུབ་པའི་དུས་ནའོ།",
    "ཅི་ལྟར་འདི་ཐལ་བའི",
    "དེས་ན་འདིས་ནི་ཐལ་བའི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "འདི་ལྟར་ཐལ་བ་དང་བཟློག་པ་གཉིས་ཀྱིས་ནི་གཞན་གྱིས་ཡོངས་སུ་བརྟགས་པ་ལ་འགལ་བ་བརྗོད་པར་བྱ་བ་ོཙམ་ཞིག་ཟད་ཀྱི།",
    "གསལ་བ་གཅིག་མཐར་ཐུག་པ་ཞེས་བྱ་བ་འདི་ལ་ནི་རྣམ་པར་ངེས་པ་འདི་ཉིད་སློབ་དཔོན་གྱིས་ཐལ་བའི་གཏན་ཚིགས་སུ་བཞེད་པ་ཡིན་ནོ་ཞེས་སྟོན་པའོ།",
    "འདི་ནི་གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་གཞན་དང་ལྡན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཐལ་བ་ཡིན་ནོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་ཚིག་གི་དོན་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་ཚིག་གི་དོན་ཉིད་ཀྱི་ཕྱིར་རོ། ། རྣམ་པར་དབྱེ་བ་ཞེས་བྱ་བ་ནི་ལུས་ཅན་ཉིད་ཀྱིས་བྱས་པའི་མ་ཁྱབ་པ་༧དང་ལུས་ཅན་མ་ཡིན་པས་བྱས་པའི་ཁྱབ་པ་ཉིད་ཅེས་བྱ་བའོ།",
    "ཕ་རོལ་པོ་ཕྱོགས་འདི་ཁས་ལེན་པའི་དོགས་པ་བསུ་བ་ནི་ཡིན་མོད་ཅེས་བྱ་བའོ།",
    "གལ་ཏེ་སྤྱི་དེ་གསལ་བ་དུ་མ་ལ་ཁྱབ་པའི་རང་བཞིན་ལ་མ་ལྟོས་པར་འཛིན་ན་དེའི་ཚེ་རང་གི་ངོ་བོ་འཛིན་པ་དེའི་ཕྱིར་ཅི་ལྟར་སྤྱི་བཟུང་སྟེ་མ་ཡིན་པ་ཁོ་ནའོ།",
    "ཁྱབ་པ་མ་ཡིན་པར་སྒྲུབ་ཅེས་བྱ་བ་ནི་གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་ཞེས་བྱ་བའི་སྒྲུབ་པར་བྱེད་པས་སོ།",
    "དེ་ཉིད་གསལ་འདེབས་པ་ནི་ཁྱོད་ཅེས་བྱ་བ་སྟེ་རིགས་པ་ཅན་ལ་སོགས་པའོ།",
    "རྣམ་པ་ཉིད་ཅེས་བྱ་བ་ནི་ཡན་ལག་གི་བཀོད་པའོ།",
    "དེས་ན་གཏན་ཚིགས་གསལ་བ་གཅིག་གི་མཐར་ཐུག་པ་ཉིད་མ་ཁྱབ་པ་ཉིད་དུ་བསྒྲུབ་པའི་དོན་དུ་ཉེ་བར་བཀོད་པ་ནི་གཞི་མ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "གང་གིས་འདི་ཐལ་བའི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་ན།",
    "རྒོལ་བ་གཅིག་གིས་ནི་དབྱིབས་ཀྱི་མཚན་ཉིད་རྣམ་པ་ཉིད་སྤྱི་ཡིན་པར་བརྗོད་ལ།",
    "དེ་ལྟར་ན་རེ་ཞིག་གང་ཡང་རུང་བའི་ལུགས་ལ་གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་ཐལ་བ་སྒྲུབ་པ་ཡིན་ནོ་ཞེས་གཞུང་བཙུགས་པ་ཡིན་ནོ།",
    "གསལ་བ་གཅིག་གི་མཐར་ཐུག་པ་ཉིད་དགག་པར་བསྒྲུབ་པར་བྱ་བ་ལ་ནི།",
    "ཁྱབ་པའི་ཕྱིར་ཞེས་བྱ་བའི་སྒྲུབ་པར་བྱེད་པ་རྒོལ་བ་གཉི་གའི་ལུགས་ཀྱིས་མ་གྲུབ་པའི་ཕྱིར་ན་ཐལ་བ་སྒྲུབ་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་ཡང་ན་ཞེས་བྱ་བའོ།",
    "གཅིག་པ་གཅིག་གི་མཐར་ཐུག་པ་དགག་པ་ནི་ཐལ་བ་ཡིན་པར་ལྷག་མས་བརྗོད་པ་ཡིན་ནོ།",
    "བཟློག་པ་ནི་རྩ་བའི་གཏན་ཚིགས་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་བསལ་ེབ་གཅིག་གི་མཐར་ཐུག་པར་ཡང་དམིགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གྲུབ་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཐལ་བའི་སྒྲུབ་བྱེད་སྒྲུབ་བྱེད་མ་ཡིན་པ་ཉིད་ཡིན་ན་འོ་ན་དེས་ཅི་ཞིག་བྱ་བ་ཡིན་སྙམ་ན།",
    "ཐལ་བ་ནི་ཞེས་བྱ་བའོ།",
    "གང་གི་ཚེ་ཞེ་ན།",
    "གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་ཞེའམ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པའི་ཐུན་མོང་ཞེས་བྱ་བ་ནི་སྤྱིའོ།",
    "དངོས་པོའི་རང་བཞིན་གྱི་བ་ལང་ཉིད་ལ་ཐུན་མོང་བའི་རང་བཞིན་གཞན་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་ན་གནས་པའི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་ནི་རྣམ་པར་རྟོག་པའི་སྣང་བ་ཐུན་མོང་མ་༤ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཀྱང་ཐལ་བ་དང་བཟློག་པ་གཉི་ག་ཡང་དེ་ཁོ་ནར་གཞི་མ་གྲུབ་པའི་ཕྱིར་ན་འགལ་བ་སྟོན་པར་བྱེད་པའི་འབྲས་བུ་ཅན་ཡིན་ནོ།",
    "སྤྱི་ཐ་མི་དད་པའི་ཕྱོགས་ལ་ནི་འདི་ཐལ་བའི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གསལ་བ་གཅིག་གི་མཐར་ཐུག་པའི་ཕྱིར་ཞེས་བྱ་བ་ཐལ་བ་བ་བ་བསྒྲུབ་པ་མ་ཡིན་གྱིས་། འོན་ཀྱང་ཁྱབ་པ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ཉིད་ཐལ་བའི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གཟུགས་ལ་སོགས་པ་གསལ་བ་གཅིག་གི་མཐར་ཐུག་པ་ནི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཉིད་དོ།",
    "དེས་ན་ཐལ་བའི་སྒྲུབ་བྱེད་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་གཉི་ག་ལྟར་ན་ཡང་ཐལ་བའི་སྒྲུབ་པར་བྱེད་པ་ལས་ནི་བསྒྲུབ་བྱ་འགྲུབ་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་རང་གིས་མཐོང་བ་སྨོས་པའི་རྣམ་པར་གཅད་༦ པར་བྱ་བ་བསྟན་ནས།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་ཞེས་བྱ་བ་ནི།",
    "རང་གི་དོན་དུ་ཞེས་བྱ་བ་ནི་རང་གི་དོན་གྱི་རྗེས་དཔག་ཏུའོ།",
    "གལ་ཏེ་གང་གིས་དོན་སྨོས་པས་གསལ་བར་བྱ་བ་རྟོག་པས་སྒྲོ་བཏགས་པ་གཏན་ཚིགས་ཡིན་ན་ཅི་ཉེས་ཤེ་ན།",
    "གང་གིས་དོན་སྨོས་པར་འདི་གསལ་བར་བྱ་བ་ཅི་ལྟར་འདི་མ་ངེས་པ་ཡིན་སྙམ་ན།",
    "གལ་ཏེ་དེ་ལྟར་ན་རང་གིས་མཐོང་བའི་དོན་སྒྲུབ་པར་བྱེད་པར་འགྱུར་མོད།",
    "ངེས་པར་གཟུང་བའི་རྣམ་པར་གཅད་ཾཔ་བརྗོད་པ་ནི་ཕྱོགས་ཀྱི་ཚིག་གིས་ཞེས་བྱ་བའོ།",
    "དེའི་ཞེས་བྱ་བ་གཏན་ཚིགས་ཀྱི་ཚིག་གི་དོན་གཞལ་བྱ་བ་ཉིད་མི་རྟག་པ་ཉིད་དེར་མ་འབྲེལ་པའི་ཕྱིར་གཞལ་བྱ་ཉིད་གཏན་ཚིགས་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་བསྒྲུབ་པར་བྱ་བ་དང་འབྲེལ་པ་གང་གིས་ཟློག་པར་བྱེད་དེ་འགལ་བ་མེད་པ་ཁོ་ནའོ།",
    "ཚིག་གིས་ནི་ཞེས་བྱ་བའོ།",
    "དེ་ལ་ཚིག་གིས་ཞེས་བྱ་བ་ནི་མངོན་སུམ་གྱིས་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལའོ།",
    "ཕྱོགས་ཀྱི་ཚིག་གིས་ནི་ཞེས་གསུངས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཚིག་གཞན་གྱི་དོན་གྱི།",
    "རང་གི་དོན་ཉིད་ཡིན་གྱི་གཞན་གྱི་དོན་ནི་མ་ཡིན་ནོ།",
    "བསྟན་པར་བྱ་བ་ལ་ལྟོས་ནས་ནི་རང་གི་དོན་ཉིད་དོ་ཞེས་གང་བརྗོད་པ།",
    "རེ་ཞིག་སུན་འབྱིན་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "གྱི་ན་བརྗོད་པ་ཉིད་དེ་ཞེས་བྱ་བ་ནི་བསྟན་པར་བྱ་བ་ལ་ལྟོས་ཏེ་ཚིག་རང་གི་དོན་གྱི་རྗེས་དཔག་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཚིག་རང་གི་དོན་མ་ཡིན་ཏེའོ།",
    "དེས་ན་རྟོགས་པར་བྱ་བ་ལ་ལྟོས་ནས་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པར་བརྗོད་དོ་ཞེ་ན།",
    "དེས་ན་དེ་ལ་ལྟོས་ནས་ནི་ཚིག་རྗེས་སུ་དཔག་པ་མ་ཡིན་མོད་ཀྱི་གཞན་གྱི་དོན་དུ་ནི་འགྱུར་བ་ཁོ་ནའོ།",
    "དེ་ལ་རེ་ཞིག་དྲན་པ་ཙམ་ནི་འབྲེལ་པ་ཁོ་ན་ལས་ཡིན་ནོ་ཞེས་ངེས་པ་མེད་དོ།",
    "ཅི་རེས་༤འགའ་ཁོ་ན་ལྷན་ཅིག་སྤྱོད་པ་ལས་སམ་ཞེ་ན།",
    "རྣམ་གང་གིས་དེས་སྒྲ་སྨྲས་པ་དེ་ནི་དེ་ཁོ་ན་ལྟར་ཡིན་ཏེ།",
    "ལེན་ནི་ཡིན་པ་ཉིད་དེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཚིག་གིས་ཁྱད་པར་བདེན་པ་དང་མི་བདེན་པ་ཉིད་དུ་རྟོགས་པར་ཁས་ལེན་ན་དེའི་ཚེ་ལྐོག་ཏུ་གྱུར་པའི་དོན་ལ་ཚིག་དེ་རང་གི་དོན་གྱི་རྗེས་དཔག་ཁོ་ནར་འགྱུར་ཏེ་དུ་བ་བཞིན་ནོ།",
    "གལ་ཏེ་དུ་བ་ལ་སོགས་པ་འབྲེལ་བའི་དོན་ལ་རྟོགས་པར་ཁས་ལེན་ན་དེའི་ཚེ་དེ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ཁོ་ནར་འགྱུར་གྱི་གཞན་གྱི་དོན་ནི་མ་ཡིན་ཏེ།",
    "གཞན་གྱི་དོན་ནི་ཚིག་གི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་རོ།",
    "དེ་ལྟར་མ་ཡིན་ན་རྗེས་སུ་དཔག་པ་སྐྱེ་བ་མེད་པའི་ཕྱིར་རོ་། ཧ་ཅང་ཐལ་བ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་མོད།",
    "དོན་བྱ་བ་མྱོང་བ་དང་གོམས་པ་དེས་ན་དེ་ཉིད་བསྟན་པར་འགྱུར་མོད།",
    "དེས་ན་སྒྲུབ་པར་བྱེད་པའི་ཚིག་གི་ཆ་རྣམས་ཐུག་པ་མེད་དོ།",
    "དེ་ཞེས་བྱ་བ་ནི་དམ་བཅའ་བའི་ཚིག་གོ་། འོ་ན་བསྒྲུབ་བྱ་འགྲུབ་པའི་ནང་གི་ཡན་ལག་གི་ནུས་པ་གང་ཡིན་ཞེ་ན།",
    "གང་གིས་ཞེས་བྱ་བའོ།",
    "དེའི་ཚེ་རྟོགས་པ་དེ་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་དང་ཁྱད་པར་ཅི་ཡོད་དེ་ཅི་ཡང་མེད་པ་ཁོ་ནའོ།",
    "གང་ཡིན་པ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཏེ།",
    "༧དེ་ལ་རེ་ཞིག་དངོས་སུ་རྟོགས་ན་ནི་མངོན་སུམ་དུ་ཐལ་བར་འགྱུར་རོ་། བརྒྱུད་ནས་རྟོགས་ན་ཡང་དེ་དེ་དང་འབྲེལ་པ་གཟུང་བར་བྱ་བ་ཡིན་ལ།",
    "རྟོགས་པ་འདིས་ནི་གོང་བུ་ཙམ་ལས་བླ་ན་ལྷག་པའི་དོན་ལ་རེག་པ་ཡིན་ཏེ།",
    "དེ་རེ་ཞིག་དང་པོ་སེལ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བ་སྟེ།",
    "གལ་ཏེ་མངོན་སུམ་དང་མི་དམིགས་པ་དག་གི་རྒྱུ་དང་སྐད་ཅིག་འབྲེལ་པ་མཐོང་བའི་འབྲས་བུ་ལས་རྒྱུ་རྟོགས་པ་ཡིན་ན།",
    "དམ་བཅས་པས་ཅི་ཞིག་བྱ་ཞེས་བྱ་བ་ནི་ལུང་གིས་རྟོགས་པར་བྱས་པའི་དོན་སྟོན་པར་བྱེད་པ་ཡིན་ན་དམ་བཅས་པ་དོན་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ལུང་གིས་མ་གྲུབ་ན།",
    "གལ་ཏེ་དམ་བཅའ་བའི་དོན་ལུང་གིས་གྲུབ་པས་དམ་བཅའ་བ་ལུང་ཡིན་ན།",
    "དེའི་དོན་ལུང་གིས་མ་བསྒྲུབས་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ཡང་གལ་ཏེ་དམ་བཅའ་བའི་དོན་ལུང་གིས་གྲུབ་པ་ཡིན་ན།",
    "འོན་ཀྱང་དེ་ནི་ལུང་གི་དོན་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན་ལུང་བཅས་ཞེས་བྱ་བའོ།",
    "དེ་ལུང་གི་དོན་ནི་དམ་བཅས་པ་ཙམ་གྱིས་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་ནི་དམ་བཅས་པའི་ཚིག་གིའོ།",
    "ཕྱིར་རྒོལ་བ་གཞན་དག་གིས་སོ།",
    "རེ་ཞིག་རྒོལ་བ་ལ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་དོན་དུ་རྒོལ་བ་ལའོ་ཞེ་ན་ཞེས་དོགས་པ་བྱས་སོ།",
    "གང་གི་ཚེ་ཞེ་ན།",
    "དེས་ན་དམ་བཅའ་བའི་ཚིག་གིས་ནི་ཅི་ཡང་བྱར་མེད་དོ།",
    "གང་ཞིག་ཉེ་བར་མི་མཁོ་བས་ཉེ་བ་མ་ཡིན་པ་དེ་ཉིད་ཀྱིས་མ་ཚང་བར་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་ཞིག་གང་གིས་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དེ་ཐམས་ཅད་དམ་བཅའ་བ་ཕྱིར་ན།",
    "དེར་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་ལྟར་སྣང་བ་མིག་གིས་གཟུང་བ་ཉིད་དམ་བཅའ་བར་ཐལ་བར་མི་འགྱུར་རོ།",
    "བསྟན་པར་བྱ་བ་ཞེས་བྱ་བ་ནི་མཚན་ཉིད་ཀྱིས་རྟོགས་པར་བྱ་བ་མཚན་ཉིད་ཀྱི་ཚིག་གིས་མ་བསྟན་པར་འགྱུར་རོ།",
    "མིག་གིས་གཟུང་བ་ཉིད་ནི་དམ་བཅའ་གཅིག་ཡིན་ཏེ།",
    "དམ་བཅའ་བ་ཉིད་ཀྱིས་ན་མིག་གིས་གཟུང་བ་ཉིད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ན།",
    "རང་གི་དོན་ནི་རང་གིས་བརྗོད་བྱ་སྟེ་མིག་གིས་གཟུང་བའི་ཕྱིར་ཞེས་བྱ་བ་འདི་བརྗོད་པར་བྱ་བ་མིག་གིས་གཟུང་བ་ཉིད་ནི་མིག་གིས་གཟུང་བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བས་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་འཐད་པའོ།",
    "དེ་བས་ན་བརྗོད་པར་བྱ་བ་མིག་གིས་གཟུང་བྱ་ཉིད་དང་བཅས་པའོ།",
    "མིག་གིས་གཟུང་བྱ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཚིག་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "༡༢༥གིས་གཟུང་བྱའི་མཚན་ཉིད་ཀྱི་དོན་ཏོ།",
    "རང་གི་ཚིག་དང་བཅས་པའི་མིག་གིས་གཟུང་བྱ་ནི་བདག་ཉིད་ཀྱི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོ་ན་སྒྲ་གང་གི་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡིན་སྙམ་ན།",
    "བདག་གི་དོན་བསྒྲུབ་པར་བྱ་ཡིན་པའི་ཕྱིར་རོ།",
    "བདག་གི་དོན་གྱི་ེབསྒྲུབ་པར་བྱ་བ་ཡིན་ཡང་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པར་སྨྲ་སྟེ།",
    "གང་གིས་དེ་བསལ་ནས་མཚན་ཉིད་བརྗོད་པ་གྲུབ་པ་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེ་ལྟར་རང་གི་སྒྲའི་རྣམ་པར་གཅོད་པ་བརྗོད་ནསཁོ་ནའི་སྒྲའི་རྣམ་པར་གཅད་༤པ་བརྗོད་པ་ནི།",
    "དེ་ནི་མིག་གིས་གཟུང་བ་ཉིད་དོ།",
    "དོན་གྱི་བརྗོད་པ་ཕྱིར་རྒོལ་བ་ལ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ན་ཕྱིར་རྒོལ་བ་དག་གི་དོན་ཤེས་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "སྐབས་སུ་གཞན་བབ་ལ་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་ཉིད་དོ།",
    "བསྒྲུབ་པར་བྱ་བ་གཞན་ཡིན་ན་ཞེས་བྱ་བ་ནི་གཞན་གྱི་དོན་ཙམ་མོ།",
    "རྒོལ་བ་དེ་ལ་སྐྱོན་ཡོད་མོད།",
    "མ་བརྗོད་པ་དང་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པའི་ཕྱིར་འབའ་ཞིག་གི་འདོད་པ་བཟློག་པའི་དོན་དུ་ཡང་ཡིན་ནོ།",
    "དགོས་པ་འདི་གཞུང་གང་གིས་བརྗོད་སྙམ་ན་རང་ཉིད་ཅེས་བྱ་བ་ནི་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་གཞན་གྱི་འདོད་པ་ལྡོག་པ་ལ་ལོག་པར་རྟོགས་པ་མེད་པས་འབད་པ་མེད་པ་ཁོ་ནར་གྲུབ་པ་དེའི་ཕྱིར་འདོད་པའོ།",
    "གང་གི་ཕྱིར་གཞན་གྱི་ལན་འདི་ཡིན་པ་དེས་ན་བརྗོད་པའོ།",
    "དེ་དོན་ནི་བདག་གི་དོན་ཏོ།",
    "དེ་བསྒྲུབ་མིན་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་ཉིད་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་བདག་གི་དོན་བསྒྲུབ་བྱ་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་གཞན་གྱི་དོན་ཙམ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་དེའི་ཚེ་བདག་གི་དོན་གྱི་མཚན་ཉིད་ཁྱད་པར་དེ་གཞན་གྱི་དོན་ཙམ་དེའི་ཁྱད་པར་ཡིན་པར་འགྱུར་རོ།",
    "བདག་གི་དོན་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནམ།",
    "གཞན་གྱི་ལུགས་ལ་མ་ལྟོས་པར་རང་གི་གྲུབ་པའི་མཐའ་ཁོ་ན་༦ལ་གནས་ནས་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཅི་ལྟར་མི་བསྒྲུབ་པར་མི་བྱེད།",
    "རང་གི་ཕྱོགས་མ་སྨྲས་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རང་བཞིན་བསྒྲུབ་པའི་དོན་དུ་སྒྲུབ་པར་བྱེད་པ་འགོད་པའི་འབད་པ་བྱས་པས་ཅི་བྱ།",
    "མ་བརྗོད་པ་ཞེས་བྱ་བའོ་། ཐམས་ཅད་བསྒྲུབ་བྱ་ཡིན་མོད་ཅི་སྐྱོན་སྙམ་ན།",
    "འདི་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་གྱི་མཚན་ཉིད་དོ།",
    "དམ་པ་སྟེ་མཁས་པ་འགྲོ་བའི་ཚུལ་ལུགས་ལ་གནས་པ་དག་ནི་གང་གིས་མཐར་ཐུག་སྟེ།",
    "སྒྲ་རྣམས་ཅི་ཙམ་ཞིག་ལ་ཕྱོགས་བརྟགས་ནས་ངག་གི་དོན་ངེས་པར་བྱ་བ་ལ་འཇུག་གི་གཞན་དུ་ནི་མ་ཡིན་པའོ།",
    "མཁས་པའི་ཞེས་བྱ་བའི་སྐབས་སུ་བབ་པ་ལ་ངག་གི་དོན་གང་ཡིན་ཞེས་དོགས་པ་བཟློག་པས་རྣམ་འགྲེལ་གྱི་ཕྱེད་སྔ་མ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "དེ་ལ་ཏེ་བདག་གི་དོན་ལ་ལྟོས་ནས་སོ།",
    "དེ་ཞེས་བྱ་བ་བདག་གི་དོན་ཏོ།",
    "གཞན་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་ལས་གཞན་གྱི་དོན་ཙམ་བསྒྲུབ་ན་ཡང་མ་འབྲེལ་པ་དེའི་ཕྱིར་ན།",
    "བདག་གི་དོན་དང་གཞན་གྱི་དོན་ཙམ་གྱི་ཕྱོགས་གཉིས་གྲུབ་པ་ལ་ལྟོས་ཏེའོ།",
    "དེ་ཞེས་བྱ་བ་བདག་གི་དོན་ཉིད་སྤངས་ནས་སོ།",
    "གཞན་ནི་གཞན་གྱི་དོན་ཉིད་དོ་། འདོད་འགྲུབ་ནི་བདག་གི་དོན་འགྲུབ་པའོ།",
    "ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བར་༤ཐལ་བའི་ལན་གྱི་དོགས་པ་བསུ་བ་ནི།",
    "དེ་ཉིད་ནི་བདག་གི་དོན་ཉིད་དོ།",
    "འོན་ཏེ་གང་གིས་རྒོལ་བའི་འདོད་པ་འགྲུབ་པར་འགྱུར་བ་འབྲེལ་པའི་ཁྱད་པར་ཡོད་པ་ཉིད་དོ་ཞེ་ན།",
    "གང་གིས་ཞེས་སྨོས་སོ།",
    "གཅིག་ཏུ་ངེས་པར་འགོག་པའི་དོན་ཡིན་མོད་དེ་ལྟ་ན་ཡང་འདི་ལ་སྔར་བརྗོད་པའི་སྐྱོན་ཅི་ལྟར་ཡོད་སྙམ་ན།",
    "ཅི་ལྟར་ན་ཁྱབ་པའི་དུས་སུ་སྤྱི་མ་གྲུབ་ན་གང་གིས་ཕན་ཚུན་བདེན་པའི་ཉེས་པར་འགྱུར་སྙམ་ན།",
    "གལ་ཏེ་ཕྱོགས་ཁོ་ན་ཡོད་མོད་དེ་ལྟ་ན་ཡང་དེ་ལས་གཞན་ཉེ་བར་དགོད་པར་འགྱུར་རོ་སྙམ་ན།",
    "རང་གི་ཚིག་དང་འགལ་ལོ་ཞེས་བྱ་བ་ནི་གང་ཡང་རུང་བ་སྨོས་པས་ནི་མ་ངེས་པར་བསྟན་ལ།",
    "ཚིགགི་ནི་ཨུཏྤལ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའིའོ།",
    "ངག་གི་ཞེས་བྱ་བ་ནི་བུམ་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའི་ངག་གི་ཤུགས་ཀྱིས་ཐོབ་པའིའོ་། དེ་བཞིན་དུ་མི་རྟག་པ་སྒྲུབ་པར་བྱེད་པ་ལ་ཁྱབ་པར་མ་གྲུབ་པོ་༦ཞེས་བྱ་བ་འདི་ནི་མ་ཡིན་གྱི།",
    "དངོས་པོའི་ཤུགས་ཀྱིས་ཞེས་བྱ་བ་ནི་འབྲས་ཆན་ལ་སོགས་པ་གཉི་གས་བཟའ་བའི་ཡུལ་མ་ཡིན་པ་རུང་བ་ལ་སོགས་པ་དེའི་ཤུགས་ཀྱིས་སྐྱེས་བུ་གཅིག་ཁོ་ན་ལ་བཟར་གཞུག་པར་ངེས་པ་ཡིན་གྱི་ལྷས་བྱིན་དང་མཆོད་སྦྱིན་དག་ལས་གང་ཡང་རུང་བ་ལ་ཟན་བྱིན་ཅིག་ཅེས་བྱ་བའི་ཚིག་གི་ཤུགས་ཀྱིས་ནི་མ་ཡིན་ནོ་། རྗེ་བོས་གང་ཡང་རུང་བ་ལ་ཟན་བྱིན་ཅིག་ཅེས་བརྗོད་པས་ཁོལ་པོ་ནན་གྱིས་འཇུག་པ་ནི་མ་ཡིན་ལ།",
    "གསུམ་ཀ་ཡང་རང་གི་འདོད་པས་འཇུག་པའི་ཕྱིར་རོ།",
    "ཟ་བ་པོའམ་སྟེར་བ་པོ་རང་གི་འདོད་པས་འཇུག་པའི་ཕྱིར་རོ་ཞེས་འབྲེལ་ཏོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གལ་ཏེ་གང་གིས་དཔེ་ལ་རྗེས་སུ་འགྲོ་བར་མཐོང་བ་དེ་འདི་ན་མེད་པའི་ཕྱིར་ཅི་ལྟར་དེའི་ཁྱད་པར་ཅན་དུ་འགྲུབ་སྙམ་ན།",
    "ཅི་སྲིད་རྗེས་སུ་དཔག་པ་མེད་པ་དེ་སྲིད་དུ་ཡང་བསྒྲུབ་བྱ་དང་ལྷན་ཅིག་སྒྲུབ་བྱེད་མི་རྟོགས་ཏེ་དེས་ན་ནང་གི་ཁྱབ་པ་ནི་མི་འཐད་པ་ཁོ་ནའོ་ཞེས་བྱ་བའོ།",
    "ནང་གི་ཁྱབ་པ་མི་འགྲུབ་པ་ནི་ཕན་ཚུན་བརྟེན་པའི་ཉེས་པས་སོ་། དེས་ན་ཕྱིའི་ཁྱབ་པ་ལ་བརྟེན་པར་བྱ་བ་ཡིན་ན།",
    "ནང་གི་ཁྱབ་པ་དང་ཕྱིའི་ཁྱབ་པའི་ཚུལ་འདི་ནི་གཞན་ལ་ལྟོས་ནས་བརྗོད་པ་ཡིན་གྱི།",
    "ཡང་གང་ཞིག་ཕྱོགས་ནང་དུ་བསྡུས་ནས་ཁྱབ་པ་སྟོན་པ་དེ་ནི་ནང་གི་ཁྱབ་པ་སྨྲ་བ་ཡིན་གྱི།",
    "གལ་ཏེ་ཁྱབ་པའི་ལྷག་པར་ཞེན་པ་སྲེག་བྱེད་མ་ཡིན་པ་ལ་སོགས་པར་འགྱུར་བ་ཡིན་ན་དེའི་ཚེ་སླུ་བར་འགྱུར་རོ་གང་གི་ཚེ་མེ་དང་དུ་བ་དག་ལ་སྲེག་པ་ལ་སོགས་པར་བྱེད་པ་དང་མཚུལ་དུ་བརྐུ་བ་ལ་སོགས་པར་བྱེད་པར་ལྷག་པར་ཞེན་པར་བྱེད་པ་དེའི་ཚེ་ནི་སླུ་བ་མ་ཡིན་ནོ།",
    "དེ་ལས་བཟློག་པ་ཞེས་བྱ་བ་ཐལ་བར་བྱས་པ་ལས་བཟློག་པ་བསྒྲུབ་པའི་ཕྱིར་རོ།",
    "འོ་ན་གང་གི་ཚེ་ཉེས་པར་འགྱུར་ཞེ་ན།",
    "གང་གི་ཞེས་བྱ་བའོ།",
    "འདོད་པ་སྨོས་པ་ཉིད་ཀྱིས་༧རང་ཉིད་ཀྱི་སྒྲའི་གཅད་བྱ་བཟློག་པའི་ཕྱིར་ན་རང་ཉིད་ཀྱི་སྒྲ་དོན་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ་། ཁ་ཅིག་ན་རེ་ཞེས་བྱ་བ་ནས་སྐྱོན་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་ནི་ཐམས་ཅད་ཀྱང་རྣམ་འགྲེལ་ལ་འཇུག་པའི་དོན་དུ་རྩོད་པ་བྱེད་པའོ།",
    "གང་གིས་དམ་བཅའ་བའི་སྐྱོན་དུ་འགྱུར་བ་དེའི་དོན་ལ་གནོད་པ་ཉིད་དུ་ཅི་ལྟར་འགྱུར་སྙམ་ན།",
    "དེ་ལྟ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་ཅི་ལྟར་དམ་བཅའ་བའི་ཉེས་པ་ཡིན་སྙམ་ན་ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བསྟན་བཅོས་ལ་བརྟེན་པ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་རྣམ་པ་འབའ་ཞིག་གིས་སྒྲ་དེ་ལ་ནམ་མཁའི་ཡོན་ཏན་ཉིད་བསྒྲུབ་པར་བྱ་བ་ལྟར་རོ།",
    "༡༤༩ཏེ་གཏན་ཚིགས་འདིས་མི་རྟག་པ་ཉིད་སྒྲུབ་པར་བྱེད་པ་དེ་ལྟ་ན་ཡང་དག་གི་བསྟན་བཅོས་ཀྱི་དོན་བཀག་པས་འགལ་བར་འགྱུར་བནམ་མཁའ་ཡོན་ཏན་ཉིད་ཅི་ལྟར་སེལ་བར་བྱེད་པ་ཡིན་སྙམ་ན།",
    "དེ་དག་གིས་ནི་ནམ་མཁས་སོ།",
    "གང་གི་ཕྱིར་དོན་མེད་པ་ཡིན་པས་སོ།",
    "གང་གིས་དེ་ལས་བཟློག་པ་བསྒྲུབ་༤པ་ལ་སྐྱོན་དུ་འགྱུར་བ།",
    "གང་གིས་ཕྱིར་ཞེས་བྱ་བའོ།",
    "སྤྱིའི་ཕྱོགས་གཅིག་གི་ཁྱད་པར་ཉིད་ནི་རྟག་ཏུ་ཡོད་པའི་ཕྱིར་ན།",
    "དེ་ལྟར་ན་རྟོགས་པ་ཡང་དེ་དག་གིས་ཞེས་བྱ་བའི་རྣམ་འགྲེལ་གྱི་ཆ་ལ་རྩོད་པ་ཉེ་བར་བཀོད་ནས་ལན་འདེབས་པ་ནི་འདིར་བརྗོད་པ་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཚིག་གིས་འདོད་པའི་ཁྱད་པར་མི་རྟོགས་ལ།",
    "སྐབས་གང་ལ་ཚིག་གིས་རྟོགས་པའི་ནུས་པ་ཐོགས་པ་མེད་པ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བརྗོད་དོ།",
    "གཞན་གྱིས་བསམ་པས་བརྗོད་པ་ཡིན་ནོ་། དེ་ལ་རེ་ཞིག་སྒྲ་སྐབས་ཀྱིས་ནི་ནམ་མཁའི་ཡོན་ཏན་འདོད་པ་གོ་བར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་སྒྲ་ཡང་སྐབས་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "འདི་ག་ལས་ཤེ་ན་ལུང་གིས་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ལུང་ལ་མི་ལྟོས་པར་གྱུར་ན་དེའི་ཚེ་ལུང་གིས་མི་གནོད་པ་ཞིག་གོ།",
    "གལ་ཏེ་མངོན་སུམ་ལུང་གིས་གནོད་པས་འཁྲུལ་པར་འགྱུར་ན།",
    "ལུང་གི་ཚིག་ཀུན་གྱི་བྱེད་པ་པོ་སྟེ་ཡིན་པར་གྲུབ་ན་དེའི་ཚེ་ཁོ་བོ་ཅག་ལ་སོགས་པའི་མངོན་སུམ་དེས་༤བྱས་པའི་ལུང་གིས་གནོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཚིག་འདི་རིགས་པར་འགྱུར་བ་ཡིན་ན་དེ་ལྟར་གྲུབ་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ནི་བདག་ཅག་གིས་གསལ་བར་ངེས་པ་མ་ཡིན་ནོ།",
    "དེས་ན་དེ་དག་གི་ཚིག་དང་མི་འགལ་བར་རྗེས་སུ་དཔག་པ་འཇུག་པ་ཡིན་ནོ་ཞེས་བྱ་བར་བསམ་པའོ།",
    "དེ་ན་ཅི་ལྟར་རང་གི་བསྟན་བཅོས་དང་འགལ་བ་སྤོང་བ་དེ་བཞིན་དུ་གཞན་གྱི་བསྟན་བཅོས་དང་འགལ་བ་ཡང་སྤང་བར་བྱ་ན།",
    "ཁྱོད་ཀྱི་འདོད་པས་ནི་ཁས་བླངས་པས་བརྟག་པ་ལ་གནོད་པ་ཡང་ཡིན་ཏེ།",
    "སྐྱེས་བུ་དང་བསྟན་བཅོས་དག་གི་ལྷན་ཅིག་སྐྱེས་པའི་འབྲེལ་བ་ཉིད་ལས་སོ།",
    "གང་གིས་དེ་སྐད་བརྗོད་པ་དེ་ལྟར་མཐོང་བ་ཡོད་དམ་ཅི་སྙམ་ན་ིདུ་བ་གཅིག་གིས་ཀྱང་ཞེས་བྱ་བའོ།",
    "འབྲས་བུ་དང་ཁྱབ་བྱའི་མཚན་ཉིད་ཀྱི་ངོ་བོ་ཉིད་དེ་ནི་འདོད་པའི་བསྒྲུབ་པར་བྱ་བ་མེ་དང་ཤིང་གི་མཚན་ཉིད་ཀྱི་དོན་དང་།",
    "གཞན་གྱིས་སྨྲས་པ་དེ་མ་ཐག་པར་བརྗོད་པ་ཐམས་ཅད་ཡིན་མོད་ཀྱི་སྟེ་དེ་ལྟར་བདེན་ཡང་འོན་ཏེ་བསྟན་བཅོས་དང་འགལ་བའི་སྒྲུབ་པའི་ཕྱིར་ན་རྒོལ་བ་མི་རིགས་པ་བྱེད་པར་འགྱུར་རོ་ཞེའོ་། འགལ་ན་ཞེས་བྱ་བ་ནི་བསྟན་བཅོས་འགལ་ནའོ།",
    "འོ་ན་གང་གི་ཚེ་ཉེས་པ་ཡོད་སྙམ་ན།",
    "གལ་ཏེ་འགལ་བ་མི་འཁྲུལ་པ་ཅན་དག་གིས་འགལ་བ་གཉིས་བསྒྲུབ་པར་ཅི་སྟེ་མི་འགྱུར་དེས་ན་ཕན་ཚུན་གནོད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེའི་སྟེ་ལུང་གི་དོན་རྗེས་སུ་དཔག་པར་བྱ་བའོ།",
    "བྱས་པ་དེ་རང་གིས་སྒྲུབ་པར་བྱེད་པ་མི་རྟག་པ་ལ་མི་མཐུན་པ་མེད་ཀྱང་ངོ།",
    "དེས་ན་མ་གྲུབ་པའི་གཏན་ཚིགས་ལ་སོགས་པ་ཡང་ལུང་ལ་ལྟོས་པ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་མ་གྲུབ་པ་ཉིད་ལ་སོགས་པའི་ཉེས་པར་མི་འགྱུར་རོ་ཞེས་དེ་མ་ཐག་ཏུ་སྟོན་པར་འགྱུར་རོ།",
    "འདིས་ནི་ལུང་གི་དོན་ཡང་ཡིན་ལ་དམ་བཅའ་བ་ཡང་མ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོས་ནི་དམ་བཅའ་བ་ལུང་མ་ཡིན་ཏེ།",
    "འདི་ན་མེ་ཡོད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡང་ལུང་དུ་ཐལ་༦བའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ཁོ་ནར་ཞེས་ངེས་པར་གཟུང་བའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པར་བསྟན་པ་ནི་དམ་བཅའ་བ་མ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "རིགས་པ་ཉིད་ནི་བསྟན་བཅོས་ཁས་བླངས་ཕྱིར་ཞེས་བྱ་བའོ་། འོན་ཏེ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་ཕྱོགས་ཡིན་ནོ་ཞེས་བྱ་བའི་ཚིག་གིས་བསྟན་པ་རིགས་པ་ཡང་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་གང་གི་ཕྱིར་ཞེ་ན།",
    "གཟུགས་ཀྱང་རྒྱང་རིང་བ་དང་མི་རིང་བ་དག་གིས་མཐོང་ཏེ་དེས་ན་དེ་ཡང་ནམ་མཁའི་ཡོན་ཏན་ཉིད་དུ་འགྱུར་རོ།",
    "གང་གིས་གང་ཞིག་འཛིན་པ་དེའི་ཡོན་ཏན་དེ་ཡིན་ནོ་ཞེས་བྱ་བའི་རིགས་པ་ཐམས་ཅད་དུ་རུང་བ་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ཅི་ལྟར་ཞེས་བྱ་བའོ།",
    "གང་ལ་བདག་གིས་༤དོན་དེ་བྱེད་པ་མ་ཡིན་པ་དེ་ལ་ནམ་མཁས་ཀྱང་དོན་དེ་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གྲུབ་པའི་མཐའ་པ་ཡང་གཅིག་ཏུ་ཐལ་བ་བོར་ནས་སྐབས་སུ་བབ་པ་གཞན་གྱིས་བརྟགས་པའི་ནམ་མཁའ་མེད་པར་བརྗོད་པ་ནི།",
    "དེ་ལ་ཉེས་པ་འདིར་འགྱུར་བ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བའོ་། བུ་ག་མེད་པར་ཞེས་བྱ་བ་སྟེ།",
    "མགོ་ཡོར་ཅན་གྱི་དངོས་པོ་ཡོད་པ་དེའི་ཚེ་བུ་གའི་མཚན་ཉིད་ཀྱི་ནམ་མཁའ་གར་སོང་།",
    "དེ་མེད་ན་ཡང་ཞེས་བྱ་བ་ནི་གློ་ནས་བུད་པར་དམིགས་པ་མེད་ན་ཡང་ངོ།",
    "གལ་ཏེ་ཡུལ་ཁྱབ་པ་ནི་ནམ་མཁའ་བཞིན་དུ་སྐབས་འབྱེད་པ་མ་ཡིན་མོད།",
    "དེ་ནི་ཞེས་བྱ་བ་ནུབ་པ་ལ་སོགས་པ་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དཔེར་ན་དྲང་པོ་ཞེས་བྱ་བའི་ཐ་སྙད་འཁྱོག་པོ་ལ་མ་ལྟོས་པ་ཁོ་ནར་འགྱུར་བ་ཡིན་ན་དེ་ལྟ་ན་ཡང་འཁྱོག་པོ་ནི་དོན་གཞན་ཁོ་ན་ཡིན་མོད།",
    "༡༧༡པར་རྟོག་པའི་ཤེས་པས་མཐོང་བ་ནི་ལྟོས་པར་བྱ་བའི་ཁྱད་པར་འཁྱོག་པོ་ལས་འགྱུར་བ་ཡིན་ནོ།",
    "འོ་ན་ཅི་ལྟར་འཁྱོག་པོ་ལ་མ་ལྟོས་པ་ཁོ་ནར་འདི་དྲང་པོ་ཞིག་གོ་ཞེས་ཐ་སྙད་བྱེད་པ་ཡོད་སྙམ་ན་ནས་ཞེས་སྨོས་སོ།",
    "གཞན་མེད་པར་ནི་འཁྱོག་པོ་ལ་སོགས་པ་མེད་པར་ནིའོ།",
    "ལྟོས་པར་བྱ་བ་འཁྱོག་པོ་ལ་སོགས་པ་མེད་ཀྱང་ངོ།",
    "དེ་ལ་གོམས་པ་ཞེས་བྱ་བ་ཉི་མ་རེ་ལ་གོམས་པ་དེས་ཉམས་པའི་ཕྱིར་ཏེ་རྫོགས་པའི་ཕྱིར་རོ།",
    "སོང་བའི་རྗེས་སུ་འགྲོ་བ་དེ་ལ་ཡོད་པའི་ཚུལ་ནི་སོང་བའི་རྗེས་སུ་འགྲོ་བའི་ཚུལ་ཏེ།",
    "དེས་ཡིད་ཉམས་པ་གང་དག་ཡིན་པ་དེ་དག་གི་དངོས་པོ་ནི་ཉིད་དེ་དེས་སོ།",
    "གལ་ཏེ་གང་གིས་ཐ་དད་པར་ཉེ་བར་བསྟན་པའི་དངོས་པོའི་རང་བཞིན་ཉིད་དུས་ལ་སོགས་པའི་བརྗོད་པ་ལ་སྟོན་པར་འགྱུར་བ།",
    "ཕྱོགས་ཀྱང་དེ་བཞིན་ཏེ་ཤར་ལ་སོགས་པའི་རང་བཞིན་རང་གི་ངོ་བོས་ཡིན་གྱི།",
    "གང་གི་ཕན་ཚུན་བརྟེན་པའི་ཉེས་པར་འགྱུར་བ་རིམ་གྱིས་ནི་མ་ཡིན་ནོ།",
    "གཉིས་དག་ཅེས་བྱ་བ་ནི་ཡུན་རིང་མོར་འདས་པའི་དོན་དང་དུས་དག་གོ་། དེས་ན་ཅི་ལྟར་ཅིག་ཅར་ཉིད་ཕན་ཚུན་འདས་པར་འགྱུར་སྙམ་དུ་བསམ་པའོ་། དོགས་པ་བསུ་བ་ནི་དེ་དག་ཅེས་བྱ་བ་སྟེ་ཅིག་ཅར་བའི་ཡུན་རིང་པོར་འདས་པའི་དོན་དང་དུས་དག་གཞན་ལ་འདས་པ་ཡིན་ནའོ།",
    "ཡང་ན་ཡིན་མོད།",
    "གང་གི་ཕྱིར་ཕྱོགས་ཀྱི་མཚན་ཉིད་ལས་ཕྱི་རོལ་གྱི་དོན་ཅན་ཡིན་པས་སོ།",
    "གལ་ཏེ་འགའ་ཞིག་གིས་བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བརྗོད་ན།",
    "དེའི་ཚེ་གང་གིས་རང་ཉིད་སྨོས་པས་གཞུག་པར་བྱ་བ་བསྟན་བཅོས་འཛིན་པ་སུས་བཟློག།",
    "རང་གི་ཕྱོགས་པ་འགའ་ཞིག་མ་གྲུབ་པའི་ཉེས་པར་འགྱུར་བའི་ཕྱིར།",
    "རང་གི་ངོ་བོ་ཉིད་བསྟན་པ་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་རང་གི་ངོ་བོ་ཅན་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནའོ།"
  ]
}