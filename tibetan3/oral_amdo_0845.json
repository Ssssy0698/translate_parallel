    "དེས་ན་རྗེས་འགྲོ་ཞེས་བྱ་བ་བྱས་པ་ཉིད་དམ་བ་ལང་ཉིད་རྗེས་སུ་སོང་བ་ནི།",
    "གང་གི་ཕྱིར་བ་ལང་ཉིད་ལ་སོགས་པའི་སྤྱི་གསལ་བ་སྔ་མ་དང་ཕྱི་མ་ལ་གནས་པ་ཉིད་ལ་ནི་མངོན་སུམ་གྱི་བྱེད་པ་འཇུག་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ལྷན་ཅིག་པར་གྱུར་པ་དག་ལ་ཡང་རྗེས་སུ་སོང་བའི་རང་བཞིན་ནི་འགའ་ཡང་ཤེས་པ་མེད་དོ།",
    "འདི་ལྟར་རྟོགས་པ་པོ་གང་གིས་དང་པོ་གསལ་བའི་རང་བཞིན་གཅིག་ཉིད་མཐོང་བའི་རྟོགས་པ་པོ་དེ་ནི་གསལ་བ་དེ་ལ་རྗེས་སུ་འགྲོ་བར་ཏེ།",
    "གསལབ་ཐམས་ཅད་ཅེས་བྱ་བའོ་། ཐལ་བ་འདི་སྤོང་བའི་ལན་གྱི་དོགས་པ་བསུ་བ་ནི།",
    "ཁྱབ་པ་ཉིད་སྤྱི་དེའི་རང་གི་ངོ་བོ་ཡིན་གྱི།",
    "གང་གིས་རེས་འགའ་རང་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པ།",
    "དོན་སོང་ཟིན་པ་ཉིད་ལྷག་བརྗོད་པའི་དོན་དུ་ཟློས་པར་བྱེད་པ་ནི།",
    "གང་གི་ཕྱིར་སྤྱི་ནི་རྟོགས་པ་ནི།",
    "ྚཡང་ན་རྒྱུ་གཅིག་གིས་བསྐྱེད་པར་བྱ་བས་བྱས་པ་ཡིན་ནོ་བཟློག་པ་བརྗོད་པ་ནི།",
    "གཞན་འགྲུབ་༤ན་དེའི་ཧ་ཅང་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་གསལ་བ་ལས་ཐ་དད་པ་རྗེས་སུ་སོང་བའི་རང་བཞིན་ནོ།",
    "གང་གི་ཕྱིར་ཐ་མི་དད་པར་གྱུར་ན་ཐ་མི་དད་པའི་རང་བཞིན་ཟད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་རྣམ་པ་དུ་མར་བརྟགས་པས་ཟད་པར་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་འགྱུར་མོད་ཅི་སྐྱོན་སྙམ་ན།",
    "རང་བཞིན་གཅིག་གིས་རྟོགས་པས།",
    "གཏན་ཚིགས་གང་གིས་འགོག་སྙམ་ན།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "འདིས་ནི་རང་གི་མཚན་ཉིད་ཁོ་ན་མངོན་སུམ་དུ་གྲུབ་པ་ཡིན་པའི་ཕྱིར་དོན་དམ་པ་ཡིན་གྱི།",
    "དེ་ལྟར་རང་གི་མཚན་ཉིད་མངོན་སུམ་གྱིས་གྲུབ་པ་ཉིད་དུ་བརྗོད་ནས།",
    "ཁྱད་པར་རྣམས་ནི་རྗེས་སུ་དཔག་པའི་ཤེས་པ་ལ་རང་གི་རང་བཞིན་གཏོད་པར་བྱེད་པ་མ་ཡིན་ལ།",
    "དེས་ན་གང་གི་འཇུག་པར་འགྱུར་བ།",
    "དེའི་ཕྱིར་ན་དེའི་ཚེ་ཡང་ཞེས་བྱ་བ་གསལ་བ་ཐུན་མོང་མ་ཡིན་པའི་རང་བཞིན་དུ་རྟོགས་པར་མི་ནུས་པས་ན།",
    "དེ་ལྟར་ཡིན་མོད་ཅི་སྐྱོན་སྙམ་ན།",
    "མཚུངས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་དང་པོ་གསལ་བ་དང་སྤྱི་དག་གིས་མཐོང་བ་བསྐྱེད་ལ། དེས་ནི་རྣམ་པར་རྟོག་པ་རྟོག་༦པས་ཀྱང་འཇུག་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "དུ་བ་དེ་ཉིད་ལས་མེའི་གསལ་བ་རྟོགས་པར་འགྱུར་མོད།",
    "གསལ་བ་གཅིག་གིས་ནི་གསལ་བ་གཞན་གོ་བར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་མེ་ཉིད་ཀྱི་སྤྱི་རང་གི་གསལ་བ་རྣམས་ཀྱི་ཁྱབ་པར་བྱེད་པ་ཡིན་ན།",
    "གང་གི་ལྟར་ན་ངེས་པའི་ཤེས་པ་ཡུལ་དང་བཅས་པ་དེ་དག་ལ་ཉེས་པ་འདིར་འགྱུར་གྱི།",
    "རང་གི་གསལ་བ་དང་འབྲེལ་བ་མ་བཟུང་བའི་མེ་ཉིད་ཀྱི་སྤྱི་ལས་རི་ལ་ཡོད་པའི་མེའི་གསལ་བ་རྟོགས་ན་ནིའོ།",
    "ཧ་ཅང་ཐལ་བའི་ཚུལ་བརྗོད་པ་ནི་བ་ལང་ཉིད་ལ་སོགས་པ་སྤྱི་གཞན་གྱི་གསལ་བ་ཁྲ་བོ་ལ་སོགས་པ་གང་ཡིན་པ་དེ་ཡང་མེ་ཉིད་ཀྱི་སྤྱི་ལས་རྟོགས་པར་འགྱུར་རོ།",
    "གང་གིས་མེ་དང་མེ་ཉིད་གཉིས་ཀྱིས་འབྲེལ་བ་མ་བཟུང་བ་དེས་ཀྱང་མེ་ཉིད་ལས་མེ་རྟོགས་པར་འགྱུར་རོ།",
    "སྔར་ཞེས་བྱ་བ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པར་རོ།",
    "ཆུ་ཀླུང་གི་ངོགས་ན་ཁ་རའི་ཕུང་པོ་ཡོད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ངག་ལས་ནི་གསལ་བ་རྟོགས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་རྟགས་ལས་ཀྱང་སྤྱི་ཁོ་ན་རྟོགས་པ་ཡིན་པ་དེའི་ཚེ་སྒྲ་ལས་ནི་སྤྱི་ཙམ་མོ་ཞེས་ཙམ་གྱི་སྒྲ་མི་བྱ་བར་འགྱུར་ན་བྱེད་པ་ཡང་ཡིན་ཏེ།",
    "༡༢༨༣ལས་འགྱུར་མོད།",
    "གསལ་བ་རྟོགས་པའི་སྐྱོན་ཐམས་ཅད་ཉམས་སུ་མྱོང་བ་ཡིན་པའི་ཕྱིར་འཇུག་པ་མེད་པར་ཐལ་བའི་མཚན་ཉིད་ཀྱི་སྐྱོན་དེ་མེད་དམ་ཅི་སྟེ་ཡོད་པ་ཁོ་ནའོ།",
    "སྤྱི་ཐ་དད་པ་དང་ཐ་མི་དད་པ་ལབརྟེན་ནས་གསལ་བ་ལ་མ་རེག་པར་རྟོགས་པ་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་གསལ་བ་ལ་རེག་པ་ཁོ་ནཡིན་ནོ།",
    "ཡང་ན་གཉི་གའི་རང་བཞིན་གྱི་སྤྱི་དེ་ལ་ེདམིགས་པའི་རྟོགས་པ་སྐྱེ་བ་གང་ཡིན་པ་དེ་ནི་གསལ་བ་ལ་མ་རེག་པར་མི་འགྱུར་ཏེ།",
    "འོན་ཀྱང་གསལ་བ་ལ་རེག་པ་ཁོ་ནས་ཡིན་ཏེ་དེས་ན་གསལ་བ་རྟོགས་པའི་སྐྱོན་དུ་ཅི་ལྟར་མི་འགྱུར།",
    "རྟོགས་ཀྱང་ཞེས་བྱ་བ་སྟེ་ཐུན་མོང་དུའོ་། མ་རྟོགས་པ་ཞེས་བྱ་བ་ནི་གསལ་བ་ངེས་པའི་རང་བཞིན་དུའོ།",
    "ཐུན་མོང་མ་ཡིན་པ་ཉིད་ནི་གཞན་ཡིན་ནོ།",
    "གཞན་གྱིས་ཞེས་བྱ་བ་ནི་ཐུན་མོང་མ་ཡིན་པ་སྟེ།",
    "དངོས་པོ་ནི་ཐུན་མོང་བ་ེདང་ཐུན་མོང་མ་ཡིན་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན་ལན་ནི་གང་གིས་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཐ་དད་པ་དང་ཐ་མི་དད་པ་དང་གཉི་གའི་རང་བཞིན་གྱི་སྤྱི་མི་འཐད་པ་དེས་ན།",
    "གང་གི་སྤྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གྲུབ་པའི་མཐའི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "ད་ནི་གཞན་ལུགས་ལས་རང་གི་ལུགས་ཁྱད་པར་དུ་ེའཕགས་པར་བསྟན་པའི་ཕྱིར་བརྗོད་པ་ནི་སྤྱི་དང་ཞེས་བྱ་བའོ།",
    "སྒྲ་རང་གི་མཚན་ཉིད་ཀྱིའོ།",
    "སྔར་ཉིད་དུ་ནི་ཞེས་བྱ་བ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པར་གཞན་སེལ་བའི་སྐབས་སུའོ།",
    "གང་གི་ཕྱིར།",
    "ཅི་སྟེ་སྤྱི་ཞེས་བྱ་བ་ནི་ལོག་པའི་དངོས་པོ་རྟོགས་པ་གཞན་དུ་མི་འཐད་པ་ཉིད་ཀྱིས་སྤྱི་ཉིད་རྟོགས་པར་བྱ་མོད་ཅེས་བྱ་བའོ།",
    "རང་ཉིད་ཅེས་བྱ་བ་བདག་ཉིད་ཀྱི་རང་བཞིན་གྱིས་དེ་ལྟར་ཞེས་བྱ་བ་མེ་རང་གི་མཚན་ཉིད་རིགས་མི་མཐུན་པ་ལས་ལྡོག་པ་མ་ཡིན་པར་གྱུར་ན།",
    "འདི་ནི་མེ་རང་གི་མཚན་ཉིད་དོ།",
    "ཙེ་༢༡༡༩༡༡༢༨༨རྟོགས་ན་རང་གི་ངོ་བོས་རྟོགས་པ་ཉིད་དུ་མི་འགྱུར་བའམ།",
    "རང་གི་ངོ་བོས་མི་མཐུན་པ་ཉིད་དུ་རྟོགས་ན་ནི་སྤྱི་དང་ལྡན་པ་དོན་མེད་དོ་ཞེས་གསུངས་པ་ནི་རང་གི་ངོ་བོས་ཞེས་བྱ་བའོ།",
    "འོན་ཀྱང་རང་གི་རྒྱུ་ལས་གྲུབ་པ་ཉིད་སྤྱིས་ཤེས་པར་བྱེད་པ་ཡིན་ནོ་སྙམ་ན་གལ་ཏེ་ཞེས་སྨྲས་སོ།",
    "དང་པོ་ནི་བ་ལང་གི་གསལ་བ་གཅིག་ཉིད་མཐོང་ལ།",
    "གང་གི་ཕྱིར་དང་པོ་མཐོང་བས་གཉིས་ཀྱི་ཐ་དད་པ་མཐོང་བ་དེའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་མཐོང་བ་ཡང་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་བ་ལང་གི་གསལ་བ་ཐམས་ཅད་མཐོང་བ་མ་ཡིན་ཏེ་མཐའ་ཡས་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོས་མིན་ཞེས་བྱ་བ་ནི་གསལ་བ་མེད་པར་རང་གི་ངོ་བོས་ནི་གསལ་བ་མི་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་གསལ་བ་མེད་པར་མི་གསལ་བ་དེས་ན་གསལ་བ་ལ་ལྟོས་པར་བྱ་བ་ཁོ་ནའོ།",
    "འོ་ན་ལྟོས་ན་རག་མོད་སྙམ་ན།",
    "༢༡༩ ༡༦༡༨༡༢༩རང་གི་ངོ་བོས་སྤྱི་རྟོགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་གང་གིས་མ་འཛིངས་པར་བརྡའང་བྱེད་པསྤྱི་ངེས་པར་ཅི་ལྟར་རྟོགས་སྙམ་ན།",
    "བ་ལང་ཞེས་བྱ་བའི་བརྡ་མེད་པར་འགྱུར་རོ་། ཐམས་ཅད་ལ་བརྡ་བྱས་ན་ནི་བ་ལང་གི་སྒྲ་ཡོད་པ་ཉིད་དང་།",
    "ཅི་ལྟར་རྣམ་པ་གང་གིས་ཤེས་པར་བྱ་སྟེ།",
    "ལན་ནི་འོ་ན་ཞེས་བྱ་བ་སྟེ་གསལ་བ་གཅིག་གིས་གསལ་བ་ཉིད་དུ་ཡང་ངོ།",
    "༡༢༩༣སྤྱི་དེ་མེད་ན་གསལ་བ་དེ་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གསལ་བ་མེད་པར་མ་ཟད་མོད་སྙམ་དུ་དོགས་ན།",
    "འོན་ཏེ་རང་གི་ངོ་བོ་ཁོ་ནས་སྤྱི་རྣམས་ཐ་དད་པ་ཡིན་ལ།",
    "གཞན་གྱིས་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ཀྱིའོ།",
    "ཁྱོད་ཀྱི་ལུགས་ཀྱིས་ནི་གང་ལས་སྤྱི་རྣམས་ཐ་དད་པར་འགྱུར་བ་གསལ་བ་རྣམས་ཀྱང་ཐ་དད་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "རང་གི་ངོ་བོས་རིགས་མཐུན་པ་དང་རིགས་མི་མཐུན་པའོ་།",
    "གསལ་བ་དག་ནི་སྤྱི་དག་གི་ཐ་དད་པར་བྱེད་པ་ཡིན་པར་ཁྱོད་འདོད་པ་ཡིན་ན།",
    "རང་གི་ངོ་བོས་ཐ་དད་ན་སྤྱི་དག་ཀྱང་དེ་བཞིན་དུ་འགྱུར་རོ།",
    "འོན་ཏེ་གསལ་བ་རྣམས་ནི་རང་གི་ངོ་བོ་ཁོ་ནས་ཞེས་བྱ་བ་ནི་གཞན་གྱི་ངོ་བོས་མ་ཡིན་པའོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་རང་གི་ངོ་བོ་ཐ་དད་པའོ།",
    "གལ་ཏེ་གསལ་བ་རྣམས་རང་གི་ངོ་བོས་ཐ་དད་ན་སྤྱིས་ཅི་བྱ།",
    "འོན་ཏེ་སྤྱི་ནི་རང་གི་ངོ་བོས་ཞེས་བྱ་བ་དེ་གསལ་བ་ཐ་དད་པ་ལས་ནི་མ་ཡིན་པའོ།",
    "གང་གི་ཚེ་སྤྱི་ཐ་དད་པ་ནི་གསལ་བ་རྣམས་ཀྱི་ཐ་དད་པར་བྱེད་པ་ཡིན་པ་དེའི་ཚེ།",
    "དེའི་ནི་ཁ་དོག་གིའོ།",
    "དོགས་པ་ནི་རྫས་སོ་ཞེས་དེ་ལྟར་རྟོགས་པ་ནི་རྫས་ཀྱི་རང་གི་རང་བཞིན་ནོ་ཞེ་ན།",
    "དེ་ལྟར་འགྱུར་མོད་སྙམ་ན་རེག་པའི་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཡོན་ཏན་ཙམ་ལ་ངོ་ཤེས་པ་མ་༧ཡིན་པ་དེས་ནའོ།",
    "དེས་ཅི་ལྟར་སྔར་གྱི་དྲན་པ་དེ་མེད་པའི་ཕྱིར་ངོ་ཤེས་པར་མེད་པར་འགྱུར་སྙམ་ནརེ་ཞིག་ཅེས་བྱ་བའོ།",
    "རེག་པའི་རྣམ་པར་ཤེས་པ་ལ་ཡང་བུམ་པ་ལ་སོགས་པ་ལས་ཐ་དད་པའི་ཉམས་སུ་སྣང་བ་མ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "ཡན་ལག་ཙམ་ནི་གྱོ་མོ་ལ་སོགས་པའི་ཡན་ལག་གང་ཡང་རུང་བ་ཙམ་མོ།",
    "དེ་ནི་ཞེས་བྱ་བ་སྟེ་ཡན་ལག་ཙམ་མོ།",
    "དེ་ཁོ་ན་ལྟར་ཞེས་བྱ་བ་ནི་ཡན་ལག་གི་རང་བཞིན་ཉིད་དོ།",
    "གང་གི་ཚེ་བུམ་པ་ལ་སོགས་པ་ཞེས་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་མདུན་ན་གནས་པའི་ཚུལ་གྱིས་ཡན་ལག་དང་ཡོན་ཏན་གཞན་གཟུགས་མཐོང་བ་དེའི་ཚེ་ཡོན་ཏན་དང་ཡན་ལག་གཞན་ཞེས་བྱ་བ་རེག་པ་ལ་སོགས་པ་དང་།",
    "ཡན་ལག་ཅན་ནི་ཡོན་ཏན་དང་ཡན་ལག་མཐའ་དག་གིས་ཁྱབ་པར་བྱེད་པ་ཡིན་ལ།",
    "༡༣༡ངོ་ཤེས་པ་དང་ཡན་ལག་དག་གིས་སོ།",
    "འོག་གི་ཡན་ལག་རྗེས་སུ་དཔོག་པར་བྱེད་ལ།",
    "གཞན་དུ་སྟེ་ཐ་དད་པར་མངོན་སུམ་གྱིས་མཐོང་བའི་དངོས་པོ་ལ་གཅིག་ཏུ་ངོ་ཤེས་པ་ལས་གྱུར་པ་གང་ཡིན་པ་དེ་རྟོགས་པའི་ལམ་དུ་མོད་ལ་ཅི་ལྟར་བྱེད་པར་འགྱུར།",
    "འོན་ཀྱང་བརྟགས་པའི་གཅིག་གི་ཡུལ་ཅན་ཡིན་ལ།",
    "སྒྲུབ་པར་བྱེད་པའི་ཤེས་པས་ཉེ་བར་བསྟན་པའི་གཟུགས་དང་རེག་པའི་ཤེས་པས་ཉེ་བར་བསྟན་པའི་རེག་པ་ཉིད་གཅིག་ཏུ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "སྔར་མཐོང་བ་གང་ཡིན་པ་དེ་ཉིད་མི་སླུ་བའི་རང་བཞིན་དོན་བྱ་བའི་ཤེས་པས་རེག་པར་བྱ་བ་ཡིན་ཏེ།",
    "དང་པོ་མི་ོམཐོང་བ་གང་ཡིན་པ་དེ་ཉིད་ལ་འཇིག་རྟེན་གྱིས་རེག་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ཞེས་བྱ་བ་མངོན་སུམ་སྔོན་དུ་སོང་བ་ཅན་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པའི་རྗེས་སུ་དཔག་པ་ལས་སོ།",
    "རྗེས་སུ་དཔག་པ་ཡང་མཐོང་བ་གང་ཡིན་པ་དེ་ཉིད་རེག་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དོན་དམ་པར་ཐ་དད་པ་མེད་པ་དེ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འདི་དག་གི་བསྒྲུབ་བྱ་ཉིད་ལ་སོགས་པའི་ཐ་སྙད་གནས་པ་འདི་ནི།",
    "དེ་བཞིན་དུ་ཡན་ལག་དང་རེག་པ་ལ་སོགས་པའི་ཡོན་ཏན་ཉིད་འདོད་པ་ཡིན་ན།",
    "བདག་གིས་མཐོང་བ་གང་ཡིན་པ་དེ་ཉིད་ལ་རེག་གོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཐ་སྙད་མེད་པར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་དོན་དམ་པར་མེད་པ་དེའི་ཕྱིར་གང་གི་ཚེ་ཐ་དད་པར་སྣང་བར་གྱུར་པ་དེའི་ཚེ་དེ་ནི་ཐ་སྙད་ཀྱི་རྟེན་ཡིན་ནོ།",
    "དོན་གང་གི་བདག་ཉིད་གང་ཞིག་དེ་ལྟ་བུ་མ་ཡིན་པ་ལས་ཐ་དད་པ་དེའི་མཐར་ཐུག་པའི་ཤེས་པ་གང་ཡིན་པ་དེ་ལའོ།"
  ]
}