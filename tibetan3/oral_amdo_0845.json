    "རང་གི་ངོ་བོས་མ་རྟོགས་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོས་ཞེས་བྱ་བའོ།",
    "གང་དུ་བ་ལང་ལ་སོགས་པའི་དོན་རྣམ་པར་དབྱེ་བས་ངེས་པར་བྱར་མེད་པ་མུན་པར་མཐོང་བ་རྣམས་ལ་ཡང་མ་འཆོལ་བར་རྟོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཐལ་བའོ།",
    "དེ་ལྟ་ཡིན་མོད་ཅི་སྐྱོན་སྙམ་ན།",
    "ཁྱད་པར་ཉིད་ཡིན་ན་ཞེས་བྱ་བ་ནི་རང་གི་རྣམ་པའི་རྗེས་སུ་བྱེད་པའི་བློའི་རྒྱུ་ཡིན་ནའོ།",
    "༡༡༦༥ཡང་འདི་ནི་ངང་པའི་གསལ་བ་དང་མི་མཐུན་པ་བ་ལང་གི་གསལ་བ་ཡིན་ནོ་ཞེས་རྟོགས་པར་འགྱུར་གྱི་ཐེ་ཚོམ་ཟ་བར་ནི་མི་འགྱུར་རོ།",
    "སྤྱི་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ལས་མི་ལྡོག།",
    "དོན་གྱི་བདག་ཉིད་སྤྱི་ནི་རང་གི་ངོ་བོ་ལས་མི་ལྡོག་སྟེ།",
    "དེའི་ཚེ་སྤྱི་ཡོད་ཀྱང་དོན་གྱི་༤བདག་ཉིད་རང་གི་ངོ་བོ་ལྡོག་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་གང་གིས་ཐེ་ཚོམ་ཟློག་པར་ནུས་པར་འགྱུར་བ་ཅི་ལྟར་སྤྱི་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན།",
    "འོན་ཏེ་མེད་པ་ཡིན་ན་དེའི་ཚེ་རང་གི་ཡོད་པ་མིན་ན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རང་གི་ངོ་བོ་ནི་གཞན་དུ་མི་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་པའོ།",
    "རྩོད་པ་བྱེད་པ་ཁྱོད་ཀྱིས་བརྗོད་པར་མི་བྱའོ།",
    "རང་བཞིན་དེ་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་གནོད་ན་སྐྱོན་ཡིན་གྱི་སྤྱི་གནོད་ན་མ་ཡིན་པའོ་ཞེས་བྱ་བ་འདི་གལ་ཏེ་བསྟན་པར་འདོད་པ་ཡིན་ན་དེའི་ཚེ་སྒྲ་རང་གི་མཚན་ཉིད་ཅེས་བྱ་བའོ།",
    "གལ་ཏེ་སྒྲ་མཉན་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདིས་འབྲེལ་པ་འགོག་པར་མི་འདོད་ཀྱི་འོན་ཀྱང་རང་གི་མཚན་ཉིད་འགོག་པ་ཉིད་ཡིན་ན།",
    "དེའི་ཚེ་སྒྲ་རང་གི་མཚན་ཉིད་མེད་དོ་ཞེས་བྱ་བ་ཉིད་བརྗོད་མོད་ཅེས་བྱ་བའོ།",
    "རྗོད་པར་བྱེད་པ་རང་གི་མཚན་ཉིད་ཀྱིས་སོ།",
    "སྒྲ་རང་གི་མཚན་ཉིད་མེད་དོ་ཞེས་བྱ་བར་དམ་བཅས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་ཀུན་ཞེས་བྱ་བ་ནི་མཉན་བྱའི་སྒྲའམ་རང་གི་མཚན་ཉིད་ཀྱི་སྒྲས་ཀྱང་རུང་སྟེ།",
    "སྒྲ་རང་གི་མཚན་ཉིད་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཚེ་གཉིས་ལས་གང་ཡང་རུང་བ་ཞིག་གིས་བརྗོད་དོ་ཅོག་འདི་ལ་འཆོལ་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་དེར་རོ།",
    "རང་གི་མཚན་ཉིད་མ་ཡིན་ནམ།",
    "རང་གི་མཚན་ཉིད་ཀྱི་མཚན་ཉིད་ནི་ཞེས་བྱ་བའོ།",
    "རང་གི་མཚན་ཉིད་ལས་གཞན་པའི་སྤྱི་ཡང་གྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་འཇོམས་པར་བྱེད་པ་ཉིད་གནོད་བྱེད་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གང་གིས་སྣང་བ་མི་དམིགས་པ་མེད་པའི་དེ་ཁོ་ན་མཚོན་པ་མེད་པའི་གྲངས་ཅན།",
    "དེས་ནི་རི་བོང་གི་རྭ་ཡང་སྐྱེད་པར་འགྱུར་རོ།",
    "ཕྱིས་རྫ་མཁན་ལ་སོགས་པའི་བྱེད་པའི་དེ་མ་ཐག་པའི་རི་བོང་གི་རྭ་དེའོ།",
    "དེའི་ཚེ་རི་བོང་གི་རྭ་ཡང་བལྟར་མི་རུང་བས་དེ་ཡང་འགག་པར་མི་འགྱུར་རོ།",
    "དེས་ན་བསྐལ་པའི་བུམ་པ་བཞིན་དུ་རི་བོང་གི་རྭ་ཡང་འཇིམ་གོང་ལ་ཡོད་པ་ཉིད་དོ།",
    "གང་གི་ཕྱིར་རི་བོང་༤གི་རྭ་མེད་པ་ཉིད་དུ་མ་གྲུབ་པ་དེས་ན།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་མེད་ན་མི་བྱེད་དོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་མ་ཡིན་པས་ནའོ་། རི་བོང་གི་རྭ་དོན་དུ་གཉེར་བའི་སྐྱེས་བུ་ཡང་ཉེ་བར་ལེན་པ་འཇིམ་གོང་ལེན་པར་འགྱུར་རོ།",
    "དཔེར་ན་བུམ་པ་དོན་དུ་གཉེར་བ་འཇིམ་གོང་ཚོལ་བ་དེ་བཞིན་དུ་རི་བོང་རྭ་དོན་དུ་གཉེར་བ་ཡང་འགྱུར་ཏེ།",
    "རི་བོང་གི་རྭ་དེ་འཇིམ་གོང་ལ་ཡོད་པ་དེས་ན་འཇིམ་གོང་འདི་རི་བོང་གི་རྭ་དེའི་རྒྱུ་ཉིད་དུ་འཛིན་པའོ།",
    "གང་གི་ཕྱིར་རི་བོང་གི་རྭ་འཇིམ་གོང་ལ་ཡོད་པ་དེས་ན་དེ་དོན་དུ་གཉེར་བས་དེ་རྒྱུ་ཉིད་དུ་འཛིན་པར་འགྱུར་རོ།",
    "འཇིམ་གོང་དེར་སྐྱེ་བ་པ་དེ་དང་བྲལ་བ་མ་ཡིན་པའི་རི་བོང་གི་རྭ་ལ་སོགས་པ་དེ་མེད་པའི་ཕྱིར་འཇིམ་གོང་ལ་རི་བོང་གི་རྭ་མེད་པར་གྲངས་ཅན་འདོད་ནའོ།",
    "དོན་ནི་འདི་ཡིན་ཏེ་གལ་ཏེ་ཡང་འཇིམ་གོང་ལ་བུམ་པ་ཡོད་པ་དེ་ལྟ་ཡང་འཇིམ་གོང་ལ་སྐྱེ་བའི་ཁྱད་པར་ཅན་གྱི་རི་བོང་གི་རྭ་ནི་མེད་དེ།",
    "ཡོད་པ་ཙམ་དུ་ནི་འཇིམ་གོང་ལ་རི་བོང་གི་རྭ་ཁྱོད་ཀྱིས་ཁས་བླངས་ཏེ།",
    "དེས་ན་འཇིམ་གོང་ཡང་རི་བོང་གིས་བསྐྱེད་པར་འགྱུར་རོ།",
    "འཇིམ་གོང་ལ་རི་བོང་གི་རྭ་ཡོད་པ་ཡིན་ཡང་གལ་ཏེ་དེ་སྐྱེད་པའི་ནུས་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེའི་ཚེ་འཇིམ་གོང་དེ་ལ་དེ་སྐྱེད་པའི་ནུས་པ་མེད་པ་ཉིད་རྟོགས་པས་རི་བོང་གི་རྭ་དེ་ཡོད་པར་རྟོགས་པར་མི་འགྱུར་རོ།",
    "རྒྱུ་གང་ལས་འབྲས་བུ་བུམ་པ་ལ་སོགས་པ་གང་སྐྱེས་པའི་རྒྱུ་དེ་ལ་འབྲས་བུ་དེ་ཡོད་དོ་ཞེས་རྟོགས་ཀྱི་རི་བོང་གི་རྭ་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་བསམས་པའོ།",
    "སྐྱེས་པའི་སྔོན་རོལ་འཇིམ་གོང་གི་གནས་སྐབས་ན་ནི་བུམ་པ་ལ་སོགས་པའི་འབྲས་བུ་ཤེས་པ་མེད་དེ་དེས་ན་འབྲེལ་པ་མ་ཤེས་པའི་རྟགས་ལས་ཡོད་པར་ཅི་ལྟར་རྟོགས།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་མ་ཤེས་པའི་འབྲས་བུ་ཡོད་པ་དང་སྐྱེ་བ་འབྲེལ་པ་རབ་ཏུ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "རྒྱུ་དང་འབྲས་བུ་དག་གི་ཡོད་པ་ཉིད་གང་ཡིན་པ་དེ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་འབྲས་བུ་གང་ཡིན་པ་དེ།",
    "དེས་ན་འབྲས་བུ་མ་ངེས་པས་ནི་རང་གི་ཡོད་པ་བསྒྲུབ་པར་མི་ནུས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་ཡིན་དང་ཁྱོད་ཀྱི་ལུགས་ཀྱིས་བསྐྱེད་བྱ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་གསལ་བར་མི་རིགས་པ་དེས་ན།",
    "རང་གི་ངོ་བོ་ཞེས་བྱ་བ་ནས་ཞེ་ནའི་བར་གྱིས་ནི།",
    "སྐྱོན་ནི་ཕྱོགས་ལ་གནོད་པར་ཐལ་བའི་མཚན་ཉིད་དེ་། ངེས་པར་གཟུང་བར་རྙེད་པའི་དོན་ཉིད་བརྗོད་པ་ནི།",
    "གནོད་མོད་ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་གྲུབ་པའི་མཐའོ་། དེ་ལྟར་ན་ཡང་ཞེས་བྱ་བ་ནི་ནམ་མཁའ་རྟག་པ་ཉིད་ལ་གནོད་ཀྱང་ངོ།",
    "འོ་ན་གང་གི་ཚེ་སྐྱོན་ཡོད་སྙམ་ན།",
    "མགྲིན་པའི་སྦུབས་ཀྱིས་ནི་ལུས་བརྩམས་པ་ཡིན་མོད་ཀྱི།",
    "ཁྱོད་ཀྱིས་འདོད་པས་ནི་མགྲིན་པའི་སྦུབས་དང་ལུས་གཉིས་རིགས་མི་མཐུན་པས་ན།",
    "ོརང་གི་ངོ་བོས་ནི་མ་ཡིན་ཏེ་གྲུབ་ཟིན་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་རྟག་པས་སོ།",
    "གང་གི་ཕྱིར་བདག་ཅག་ནི་དངོས་པོ་དཔྱོད་པ་ལྷུར་ལེན་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་གཏན་ཚིགས་འདི་ནི་ལྷག་ལྡན་ཏེ་མ་ངེས་པའི་ཁྱད་པར་མི་མཐུན་པའི་ཕྱོགས་ལ་ལྡོག་པ་ལ་ཐེ་ཚོམ་ཟ་བར་འདོད་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་ཕྱོགས་ལས་ཐ་དད་པའི་སྒྲུབ་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་དུས་དང་རང་གི་ངོ་བོ་དེར་ཞུགས་པར་གྱུར་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཉེས་པ་འདི་གང་གི་ཡིན་ཞེ་ན།",
    "གཉི་ག་ཡང་ཞེས་བྱ་བའི་ནི་ཕྱོགས་དང་སྒྲུབ་པར་བྱེད་པ་དག་གིའོ།",
    "སྒྲུབ་པར་བྱེད་པ་ལ་ཞེས་བྱ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་ལ་ལྟོས་པའི་མ་གྲུབ་པ་རང་གི་ངོ་བོ་མ་གྲུབ་པའི་མཚན་ཉིད་གང་ཡིན་པ་དེ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཀྱི་སྐྱོན་ཡིན་ནོ་ཞེ་ན།",
    "རང་གི་ངོ་བོ་ཁོ་ནར་ཞེས་བྱ་བའོ།",
    "རང་གི་ངོ་བོ་ལ་ལྟོས་ནས་ནི་སྤྱི་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་གང་གིས་ཕྱོགས་ཙམ་ཞེས་བརྗོད་པ་དཔེར་བརྗོད་པ་གཞན་ཡང་ཡོད་དམ་ཅི་སྙམ་དུ་དོགས་པ་སེལ་བས་བརྗོད་པ་དང་མ་བརྗོད་པ་གསུམས་པ་ནི།",
    "མངོན་སུམ་མ་ཡིན་པ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "དོན་ནི་འདི་ཡིན་ཏེ་ཡན་ལག་རྣམས་ནི་ཁྱོད་མངོན་སུམ་དུ་གྱུར་པ་ཉིད་དུ་འདོད་པ་ཡིན་ན།",
    "དེའི་ཕྱིར་ཐ་དད་པའི་ཕྱོགས་ལ་མངོན་སུམ་མ་ཡིན་པར་ཐལ་ཏེ།",
    "འདི་ལྟར་ཚིག་གི་དོན་གསུམ་ཡོད་པར་བྱེད་པ་ནི་ཡོད་པ་ཉིད་ཡིན་ནོ་ཞེས་བརྗོད་པའི་ཕྱིར།",
    "རྫས་ཀྱི་མཚན་ཉིད་ཅན་ཞེས་བྱ་བའི་རྣམ་འགྲེལ་རྣམ་པར་འགྲེལ་པའི་སྒོ་ནས་བར་དུ་ཆོད་པའི་གཞུང་གིས་སྟོན་པར་འགྱུར་རོ།",
    "དེ་བས་ན་རེ་ཞིག་དཔེར་བརྗོད་པ་གཉིས་གོ་རིམས་ཅི་ལྟ་བ་བཞིན་རྣམ་པར་འགྲེལ་པ་ནི།",
    "རང་གི་རང་བཞིན་ལ་ཞེས་བྱ་བའོ།",
    "འང་གི་སྒྲས་ནི་རྫས་ཉིད་གཞན་ཡིན་ན་ཡང་ཞེས་སྡུད་པའོ།",
    "ཡོད་མོད་ཅི་ཉེས་སྙམ་ན།",
    "ཡོན་ཏན་ཉིད་རྫས་ལས་ཁྱད་པར་མེད་པའི་ཐལ་བ་སྔ་མ་གང་ཡིན་པ་དེ་བཟློག་པ་མེད་པར་འགྱུར་རོ།",
    "རང་གི་ངོ་བོས་ཕན་ཚུན་ཐ་དད་པར་ངེས་ནུས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེའི་ཞེས་བྱ་བ་ཡོན་ཏན་ཉིད་དང་རྫས་ཉིད་ཀྱི་ཁྱད་པར་རྫས་ཉིད་དམ་ཡོན་ཏན་ཉིད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་རང་བཞིན་ནོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོའི་ལྡོག་པ་ཉིད་དོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ནི་འདི་སྙམ་དུ་རང་གི་ངོ་བོས་ནི་རིགས་རྣམས་ཕན་ཚུན་ལྡོག་པ་མ་ཡིན་ན།",
    "གང་གིས་བསལ་བ་རྣམས་ཀྱང་དེ་ལྟར་འགྱུར།",
    "རང་གི་ཞེས་བྱ་བའོ།",
    "སྤྱི་རང་གི་དགོས་པ་རིགས་མི་མཐུན་པ་ལས་ལྡོག་པའི་མཚན་ཉིད་གང་ཡིན་པ་དེ་ནི།",
    "དེའི་ཕྱིར་རང་གི་ངོ་བོ་ལས་ཐ་དད་པའི་སྤྱི་དམིགས་པ་ནི་མེད་དོ།",
    "འོ་ན་གང་གི་ཚེ་ཁྱད་པར་ཡོད་སྙམ་ན།",
    "ཁྱད་པར་གྱི་རྣམ་པ་ཉིད་བརྗོད་པ་ནི་རྫས་ཞེས་བྱ་བ་ནི་། གཉི་གའི་སྒྲ་ནི་རེ་རེ་དང་སྦྱར་ཏེ་རང་གི་ངོ་བོ་གཉི་ག་བསལ་བ་དང་།",
    "དེ་དག་གི་ཁྱད་པར་རྣམས་ཀྱི་དཔེར་བརྗོད་པ་བསྟན་ཟིན་པ་དེ་ལྟ་ན་ཡང་དེ་དག་ནི་ཐ་དད་པར་དཔེར་བརྗོད་པ་ཡིན་ལ།",
    "ངག་དང་བདེན་པ་མ་ཡིན་པ་ཉིད་ཀྱི་རང་གི་ངོ་བོ་ཁྱད་པར་དག་སྤོང་བ་བརྗོད་པར་འདོད་པ་ཡིན་ན།",
    "གཉི་གའི་རང་གི་ངོ་བོ་དང་ཁྱད་པར་སྤོང་བའི་མཚན་ཉིད་ཀྱི་སྐྱོན་ཡིན་ནོ།",
    "གལ་ཏེ་གང་གིས་ཏེ་སེལ་བར་འགྱུར་བ་དེའི་མི་རྟག་པ་ཉིད་ཅི་ལྟར་ཞེ་ན།",
    "ངག་གི་རང་བཞིན་སྒྲུབ་པ་མེད་ན་ཞེས་བྱ་བ་ནི་ངག་གི་རང་བཞིན་ཕན་འདོགས་པར་བྱེད་པ་མ་ཡིན་ནའོ། ༴།",
    "སྨྲ་བ་པོ་གྲུབ་པ་ཉེ་བར་འཇོག་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་འབྲེལ་ཏོ།",
    "དེར་གྱུར་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་སྟེི་ངག་གི་རང་བཞིན་གྱི་ཕན་པ་མེད་ནའོ།",
    "ལྟོས་པར་བྱ་བ་ཡང་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་ངག་གིས་༧དེ་ནི་ངག་གོ།",
    "གལ་ཏེ་གང་གིས་དེ་ལྟར་བརྗོད་པར་འགྱུར་བ།",
    "ཧ་ཅང་ཡུལ་ཐག་རིང་པོ་ན་གནས་པ་མ་ཡིན་པ་ཕན་ཚུན་ཉེ་བ་ཉིད་དུ་གནས་ཤིང་མ་འདྲེས་པའི་སྐུ་ཡུལ་གང་ལ་ཡོད་པ་སེམས་གཅིག་གི་རྣམ་པར་སྣང་བའི་རྟོགས་པ་དེ་ལ་དེ་སྐད་ཅེས་བརྗོད་དོ།",
    "དེ་དག་གིས་ཞེས་བྱ་བ་ནི་ཡོན་ཏན་དང་བྱ་བ་དག་གིའོ།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གིས་མ་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "རྡུལ་གཉིས་པ་ལ་སོགས་པ་ནས་བརྩམས་ེཔའི་རྫས་ཀྱི་ལྕི་བ་གང་ཡིན་པ་དེ་དག་གིས་གཞལ་བའི་ཚེ་དང་འབྲེལ་པའི་ཕྱིར་འཛིན་པ་ཡིན་ནོ།",
    "གཅིག་གིས་ལྗིད་ངེས་པར་གཟུང་བར་མི་ནུས་ཏེ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཡན་ལག་ཅན་གྲུབ་པ་རེ་བ་ཡིན་ནོ།",
    "དེ་ཞེས་བྱ་བ་སྣང་བ་ཙམ་མོ།",
    "དེ་ལྟར་གྱུར་ན་ནི་རྫས་ཕྲེང་གཞལ་བ་ཞེས་གང་བརྗོད་པ་དེ་མ་འབྲེལ་པར་ཐལ་ཏེ།",
    "འདིས་ནི་རང་གི་ཚིག་དང་འགལ་བ་མེད་དུ་བཅུག་པ་དེ་ལྟ་ན་ཡང་ཉེས་པ་ཡོད་པ་ཉིད་ཞེས་བརྗོད་པ་ནི།",
    "ཡན་ལག་ཅན་ཐམས་ཅད་ཞིག་ནས་སྐྱེས་པའི་ཐ་མའི་ཡན་ལག་ཅན་གྱི་ལྗིད་མི་རྟོགས་པ་ཡང་མི་འཐད་དེ་དེ་ཡོད་པའི་ཐ་སྙད་མེད་པར་ཐལ་བའི་ཕྱིར་རོ་ཞེས་དགོངས་པའོ།",
    "དེ་ཡང་རྡུལ་ཕྲ་རབ་གཉིས་པོ་མ་ཞིག་གི་བར་དུ་འཇིག་པ་མ་ཡིན་ནོ་རྡུལ་ཕྲ་རབ་རྣམས་ཀྱང་འཇིག་པར་ཐལ་ལོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡན་ལག་ཅན་ཐམས་ཅད་ཞིག་ན་རྡུལ་ཕྲ་རབ་འཇིག་པར་ཐལ་བ་དེའི་ཕྱིར།",
    "དེའི་ཕྱིར་རང་གི་གཞུང་དང་འགལ་བསརྡུལ་ཕྲ་རབ་ནི་འཇིག་པར་ནི་ཁས་བླང་བར་༧བྱ་བ་མ་ཡིན་ནོ།",
    "༡༢༡༣པར་མེད་པའི་ཕྱིར་རོ་ཞེ་ན་འདི་ལ་རེ་ཞིག་རང་ཉིད་ལན་འདེབས་པ་ནི།",
    "འདིར་བར་གྱི་སྒྲ་བྱ་རོག་གི་ལྟ་སྟངས་ཀྱི་ཚུལ་གྱིས་གཉི་ག་ཡང་སྦྲེལ་བར་བྱའོ།",
    "ཤིན་ཏུ་ཆུང་བ་ཇེ་ཆུང་ཇེ་ཆུང་སོང་བ་ནི་ཤིན་ཏུ་རྟོགས་པར་དཀའ་བར་འགྱུར་རོ།",
    "དེའི་རྒྱུ་དུམ་བུའི་ཡན་ལག་གི་ཡིན་པར་འགྱུར་རོ།",
    "ཐ་མའི་ཡན་ལག་ཅན་ཞིག་ཀྱང་ཞེས་ཡང་གི་སྒྲ་ནི་རིམ་པ་གཞན་དུ་བྱ་སྟེ།",
    "ཐ་མའི་ཡན་ལག་ཅན་ཞིག་ཀྱང་ལྗི་བ་ཉིད་དམིགས་པ་གང་ཡིན་པ་དེ་ནི་དེ་དག་གི་ཡིན་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུར་གྱུར་པ་དུམ་བུའི་ཡན་ལག་ཅན་དང་དེའི་ཡན་ལག་གཉིས་པ་ཞིག་པར་གྱུར་པ་དག་དང་འབྲེལ་པའི་ལྗིད་ེཉིད་གང་ཡིན་པ་དེ་ཉིད་མཐོང་ངོ་གང་གིས་ཕྱིར་དེ་ལྟར་ལྕི་བ་ཉིད་༦མཐོང་བ་དེས་ནའོ།",
    "ཡན་ལག་ཅན་ནམ་དེའི་འབྲས་བུ་མངོན་སུམ་ཉིད་མ་ཡིན་མོད།",
    "རེ་ཞིག་ཡན་ལག་ཅན་ནི་སྲིད་པ་མ་ཡིན་པས་གཟུགས་དང་རོ་ལ་སོགས་པའི་ཁྱད་པར་མི་རྟོགས་མོད་ཀྱི།",
    "གལ་ཏེ་ཕྱོགས་ལྟར་སྣང་བ་འདི་གང་གི་ནང་དུ་བསྡུ་ཞེས་དོགས་ན།",
    "དེ་བཞིན་དུ་རང་གི་ཚིག་དང་འགལ་བ་ནི།",
    "རང་གི་ངོ་བོ་གནོད་པ་ལ་སོགས་པ་བཞིན་ནོ།",
    "རང་གི་ངོ་བོ་ལ་གནོད་པ་ལ་སོགས་པའི་དཔེར་བརྗོད་པ་ལྷག་མ་གཉིས་ཅི་ལྟར་བསྟན་པ་དེ་བཞིན་དུ་དཔེར་བརྗོད་པ་ལྷག་མ་གཉིས་ཀྱང་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གི་ཚེ་བདེན་སྙམ་ན་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཆསྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་ཚེ་ཡང་བསྒྲུབ་བྱར་མི་འདོད་ན་ཡང་བསྒྲུབ་བྱར་ཐལ་བར་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་ཡང་བསྒྲུབ་པར་བྱ་བར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "མིག་གིས་གཟུང་བ་ཉིད་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེའི་ཕྱིར་འདོད་པའི་ཁྱད་པར་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པའི་མ་གྲུབ་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རང་བཞིན་ལ་བརྟེན་༧པར་མི་འགྱུར་རོ་། འཆད་པ་ནི་ཤེས་པར་བྱེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་སྐབས་སུ་གྱུར་པའི་མ་གྲུབ་པ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་པའི་རྒྱུ་དེས་ནའོ།",
    "གཞུང་གང་གིས་དཔེར་བརྗོད་སྙམ་ན།",
    "མིག་གིས་གཟུང་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་མ་གྲུབ་པའོ།",
    "དཔེ་དང་གཏན་ཚིགས་མ་གྲུབ་ེཔར་བྱ་བ་ཐམས་ཅད་དམ་བཅའ་བར་ཐལ་བ་མ་ཡིན་ཏེ་ཞེས་འབྲེལ་ཏོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པའི་གཏན་ཚིགས་དེས་ན།",
    "བསྒྲུབ་པར་བྱ་བའི་རང་གི་ངོ་བོའི་ཚིག་ཉིད་ཀྱིས་གྲུབ་པའི་རང་བཞིན་བཀག་པའི་ཕྱིར་ནམ་གྲུབ་པའི་སྒྲུབ་པར་བྱེད་པ་ལ་སོགས་པ་ནི་དམ་བཅའ་བ་ཉིད་མ་ཡིན་ཞེས་བྱ་བ་ནི་རྩོད་པའི་དོན་ཏོ།",
    "དེས་བསྟན་པར་བྱ་བའི་དོན་མ་གྲུབ་པའི་ཕྱིར་ན་ཡན་ལག་གི་མཚན་ཉིད་ཐམས་ཅད་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གང་གི་ཚེ་ཞེ་ན།",
    "འོ་ན་གང་གིས་དེའི་མཚན་ཉིད་དོན་དང་བཅས་པར་འགྱུར་བ་སྒྲུབ་པར་བྱེད་པ་ཉིད་གང་ཞིག་ཡིན་ཞེ་ན།",
    "ཐམས་ཅད་ནི་ཞེས་བྱ་བའི་ཀྱང་གི་སྒྲ་རྣམ་པར་འགྲེལ་པ་ནི།",
