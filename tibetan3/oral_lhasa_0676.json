    "འདི་ལྟར་ཁ་ན་མ་ཐོ་བ་མཁྱུད་ན་འཀྱོད་པར་འགྱུར་རོ།",
    "ཚིག་རྩུབ་པོ་ཞེར་འདེབས་པར་བྱེད་པའི་ངང་ཚུལ་ནི་ཞེར་འདེབས་པ་སྟེ།",
    "ཕན་འདོགས་པར་འདོད་པས་འདོད་པའམ།",
    "མི་འདོད་པ་ལ་ཡང་རུང་སྟེ་སྦྱིན་པར་བྱེད་པ་དེ་ནི་སྦྱིན་པའོ།",
    "དེ་ཡོད་ན་སྦྱིན་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་དེ་དང་མི་མཐུན་པ་ཞེས་བྱའོ།",
    "དེ་ནི་དངོས་སུ་མཁྱུད་པར་བྱེད་པའོ།",
    "རྣམ་པར་འཚེ་བ་ནི།",
    "རྣམ་པར་ཐོ་འཚམས་པའོ།",
    "ཐོས་ན་རྗེས་སུ་ཡི་རང་བ་རྣམས་དང་གོ་རིམས་བཞིན་དུ་སྦྱར་བར་ཤེས་པར་བྱའོ།",
    "དེ་དང་ལྡན་ན་སེམས་བླུན་པར་གྱུར་ནས་མི་གཡོ་བ་བཞིན་དུ་དམིགས་པ་རྟོགས་པར་སྤྲེ་མི་ནུས་པའོ།",
    "རྣམ་པར་གཡེང་བ་ནི་འདིས་སེམས་སྣ་ཚོགས་སུ་གཡེང་བར་བྱེད་པའོ།",
    "ཡིད་ལ་གཅགས་པའོ་ཞེས་བྱ་བ་ལ་ངན་པ་བྱས་པས་འགྱོད་དེ་དེའི་དངོས་པོ་ནི་འགྱོད་པ་ཉིད་དོ།",
    "ངན་པ་བྱས་པའི་ཡུལ་ལ་སེམས་མི་དགའ་བ་སྟེ།",
    "རིགས་པ་དང་མི་རིགས་པ་བྱས་སམ་མ་བྱས་ཀྱང་རུང་སྟེ།",
    "སེམས་པ་དང་ཤེས་རབ་ཀྱི་བྱེ་བྲག་ཅེས་བྱ་བ་ལ་ཀུན་དུ་ཚོལ་བ་ནི་འདི་ཅི་ཡིན་ཞེས་ཀུན་དུ་རྟོག་པའི་རྣམ་པར་ཞུགས་པའོ།",
    "འདི་གཉིས་ནི་སེམས་རྩིང་བ་དང་ཞིབ་པར་རྣམ་པར་གནས་པ་ཐ་དད་དུ་དབྱེའོ།",
    "དེ་དག་ནི་མི་ལྡན་པའི་འདུ་བྱེད་ཡིན་པར་སྐབས་ཀྱིས་སྦྱར་རོ།",
    "དེ་ལྟར་སྤྱིར་བསྟན་ནས་ཁྱད་པར་ཁོང་དུ་ཆུད་པར་འདོད་ནས།",
    "དེ་དག་ཀྱང་ལྡན་པ་མ་ཡིན་པའི་འདུ་བྱེད་རྣམས་སུ་རིག་པར་བྱའོ།",
    "རྙེད་པ་རྣམས་སྐད་ཅིག་གཉིས་པ་བུལ་སོགས་པར་ཡོད་པ་ནི་ལྡན་པ་སྟེ།",
    "ཡང་དག་པར་རྗེས་སུ་འགྲོ་བ་ནི་ལྡན་པ་ཞེས་བྱའོ།་།",
    "དེ་ལྟར་ན་ཐོབ་པའི་སྒྲ་ནི་རྙེད་པ་དང་ལྡན་པ་ལ་ཡང་སྙེགས་པར་བསྟན་པ་ཡིན་ནོ།",
    "འདུ་ཤེས་མེད་པར་སྙོམས་པར་འཇུག་པའམ།",
    "འདུ་ཤེས་མེད་པ་རྣམས་ཀྱི་སྙོམས་པར་འཇུག་པ་ནི།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པའོ།",
    "སྟོམས་པར་འཇུག་པ་ལ་དེའི་ལམ་དུ་འདུ་ཤེས་པ་རྣམས་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལ་སྙོམས་པར་འཇུག་གོ།་།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་སེམས་དང་སེམས་ལས་བྱུང་བ་འགགས་སུ་ཟིན་ཀྱང་འདུ་ཤེས་མེད་པ་ཉིད་ལ་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་བསྟན་ཏེ།",
    "འདི་ལྟར་འདུ་ཤེས་ཉིད་ལ་སུན་འབྱིན་པས་སེམས་དང་སེམས་ལས་བྱུང་བ་མ་ལུས་པར་འགག་པའི་གནས་སྐབས་སུ་འགྱུར་རོ།",
    "བརྟན་པ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཟག་པ་མེད་པའི་ལམ་གྱི་བདེན་པ་ལ་སྟོམས་པར་འཇུག་པའི་དུས་དང་།",
    "འགོག་པ་ལ་སྙོམས་པར་འཇུག་པའི་དུས་དང་།",
    "མི་སློབ་པའི་དུས་མ་གཏོགས་པར་དུས་གཞན་ཀུན་ན་ཡོད་པའི་ཕྱིར་བརྟན་པ་མ་ཡིན་པ་རྣམས་ཞེས་བྱེ་བྲག་སྨོས་སོ།",
    "གང་འགོག་པ་ཞེས་བྱ་བ་ནི་སྙོམས་པར་འཇུག་པའི་སེམས་ཀྱིས་བྱས་པ་སྟེ།",
    "འདིས་འགག་པར་བྱེད་པས་ན་འགོག་པའོ།",
    "དེ་ལྟར་ན་ལུས་ཀྱི་གནས་སྐབས་ཀྱི་བྱེ་བྲག་ལ་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལ་གདགས་པར་བསྟན་པ་ཡིན་ནོ།",
    "སྟོམས་པར་འཇུག་པའི་སེམས་ཀྱིས་དེ་མ་ཐག་པའི་སེམས་གཞན་སྐྱེ་བ་དང་མི་མཐུན་པའི་ལུས་སྐྱེད་པའི་ཕྱིར་སྙོམས་པར་འཇུག་པའི་སེམས་ཀྱིས་བྱས་པ་ཞེས་བྱའོ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་གང་ཞེ་ན།",
    "དགྲ་བཅོམ་པའི་སྙོམས་པར་འཇུག་པ་ཡིན་གྱི།",
    "སོ་སོའི་སྐྱེ་བོ་ནི་མ་ཡིན་པར་བསྟན་པ་ཡིན་ནོ།",
    "འདིས་གནས་པར་བྱེད་པས་གནས་པ་སྟེ།",
    "དེ་མ་ཐག་ཏུ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་མངོན་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "བརྟན་པ་མ་ཡིན་པ་རྣམས་ཞེས་བྱ་བ་ནི་འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་འཇུག་པའི་རྣམ་པར་ཤེས་པ་དྲུག་དང་བཞི་དང་གཅིག་འདོད་པ་དང་།",
    "བརྟན་པ་རྣམས་ལས་ཀྱང་ཁ་ཅིག་ཅེས་བྱ་བ་ལ་བརྟན་པ་ནི་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པར་བསྡུས་པ་དག་ཀྱང་ཡོད་པས་དེའི་ཕྱིར་ཁ་ཅིག་ཅེས་བྱ་བ་སྨོས་སོ།",
    "མི་སློབ་པའི་དུས་མ་གཏོགས་པར་ཟག་པ་དང་བཅས་པའི་སྤྱོད་པ་ཐམས་ཅད་ན་གནས་པའི་ཚུལ་ཅན་ཡིན་པས་བརྟན་པའོ།",
    "འགོག་པ་གང་ཡིན་པའོ་ཞེས་བྱ་བ་ནི་འཇུག་པའི་རྣམ་པར་ཤེས་པས་བྱས་པ་སྟེ།",
    "རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་ལ་འཇུག་པའི་རྣམ་པར་ཤེས་པ་རྣམས་དང་།",
    "འདིས་འཇུག་པའི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ལྟར་ན་སྟོམས་པར་འཇུག་པའི་སེམས་ཀྱིས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ས་བོན་ཉམས་པར་བྱས་པའི་གནས་སྐབས་ལ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་གདགས་སོ།",
    "འདུ་ཤེས་མེད་པའི་སྟོམས་པར་འཇུག་པའི་འབྲས་བུ་སྟེ།",
    "ས་བོན་ཉམས་པར་གྱུར་པའི་དུས་དེ་ན་གནས་ལ་འདུ་ཤེས་མེད་པ་གདགས་སོ།",
    "འདིས་འགོག་པར་བྱེད་པས་ན་འགོག་པའོ།",
    "དུས་ཇི་སྲིད་དུ་གནས་པར་འགྱུར་བ་དེ་གནས་པའི་དུས་ངེས་པའོ།",
    "དེའི་གནས་ནི་སྔོན་བསགས་པའི་ལས་ཀྱིས་འཕངས་པས་ནུས་པའི་ཁྱད་པར་ཅན་གྱི་འདུ་བྱེད་དུབརྟན་པ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྔོན་དུ་འགྲོ་བ་རྣམས་སོ།",
    "རིས་མཐུན་པར་གང་འདུ་བྱེད་རྣམས་མ་བྱུང་བ་ལས་བྱུང་བའོ་ཞེས་བྱ་བ་ལ།",
    "རིས་མཐུན་པར་གྱུར་པའི་འདུ་བྱེད་གང་ཡིན་པ་དེ་དག་ཉིད་མ་བྱུང་བ་ལས་བུབྱུང་བ་ལ་སྐྱེ་བ་ཞེས་བྱ་སྟེ།",
    "ཞིག་པ་མེད་པ་རྣམས་ཀྱི་སྐྱེ་བ་དོན་གཞན་དུ་འགྱུར་བ་རྗོདང་བྱེད་པ་ལས་དུས་རྣམ་པར་གཞག་པར་འཛིན་པ་རྣམས་ཀྱི་འདོད་པ་དེ་བསལ་དྷིབའི་ཕྱིར།",
    "བྱེད་པ་ལས་དུས་རྣམ་པར་གཞག་པ་ཡང་མ་ཡིན་ནོ།",
    "སྐད་ཅིག་གཅིག་ལ་ཡང་མི་བྱ་ཞིང་དོན་གཞན་དུ་གྱུར་པ་ཡང་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "རྒྱུན་ཆད་པ་ནི་འདིར་འཆི་བ་ལ་བྱ་བར་རིག་པར་བྱའོ།",
    "མི་རྟག་པ་ཉིད་ཡོད་པར་ངེས་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འདུས་བྱས་ཀྱི་མཚན་ཉིད་སྐྱེ་བ་དང་།",
    "ཕྱི་རོལ་གྱི་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་མིང་དང་འཇིག་རྟེན་པའི་ཚིག་ལས་ཚིག་བྱེ་བྲག་ཏུ་བྱས་པ་ཡིན་ནོ།",
    "ཁྱད་པར་གྱི་གཞི་ནི་ངོ་བོ་ཉིད་ཡིན་པས་སྔར་ངོ་བོ་ཉིད་ཀྱི་ཚིག་བླ་དྭགས་སྨོས་སོ།",
    "ཁྱད་པར་ནི་མི་རྟག་པ་ལ་སོགས་པའོ།",
    "འཇུག་པ་དང་ལྡོག་པའི་བདག་ཉིད་དང་གཞན་དུ་མི་སྙེགས་པའི་ངོ་བོ་ཉིད་ལས་བྱེ་བྲག་ཏུ་བྱེད་པ་ནི་ཁྱད་པར་ཏེ།",
    "དངོས་པོའི་ངོ་བོ་ཉིད་ཀྱི་ཁྱད་པར་བརྗོད་པ་ནི་ཚིག་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ངོ་བོ་ཉིད་དང་ཁྱད་པར་གྱི་ཚིག་བླ་དྭགས་ཀྱི་གནས་སྐབས་སུ་གྱུར་པའི་ཡི་གེ་འདུས་པ་རྣམས་ལ་མིང་དང་ཚིག་གདགས་པའི་ཕྱིར་ཏེ།",
    "དེ་དག་ནི་མིང་དང་ཚིག་ལྐུགནས་ཀྱིས་དོན་ཡང་དག་པར་བརྗོད་པའི་ཕྱིར་བརྗོད་པ་ཞེས་བྱའོ།",
    "བརྗོད་པར་བྱ་བ་ཉིད་རྣམ་གྲངས་སུ་གཏོགས་པ་གཞན་རྣམས་ཀྱིས་ཤེས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ངོ་བོ་ཉིད་དང་ཁྱད་པར་དང་དེ་གཉི་གའི་ཐ་སྙད་ཙམ་དུ་ཟད་དེ།",
    "དེ་བཞིན་དུ་ལྡན་པ་མ་ཡིན་པ་གཞན་དག་ཀྱང་ཚིག་དང་ཡི་གེའི་ཚོགས་བཞིན་དུ་དགོས་པ་ལ་ལྟོས་རྗོནས་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "རྒྱུ་དང་འབྲས་བུ་ཐ་དད་པ་ཉིད་ལ་སོ་སོར་ངེས་པ་རྣམ་པར་གཞག་སྟེ།",
    "རྒྱུ་དང་འབྲས་བུ་ཐ་དད་པ་ཡང་འདོད་པའི་ཡུལ་གྱི་ནི་ལེགས་པར་སྤྱད་པའོ།",
    "མི་འདོད་པ་ནི་ཉེས་པར་སྤྱད་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ནི་འབྲས་བུ་སོ་སོ་བ་རྣམས་ཀྱི་རྒྱུ་ཐ་དད་པའོ།་།",
    "དཔེར་ན་སྦྱིན་པ་ནི་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་དང་འཚམ་པར་རིགས་པར་སྦྱིན་པའི་འབྲས་བུ་ནི་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་ལྟ་བུའོ།",
    "གཟུགས་སུ་བསྡུས་པ་ནི་རྒྱུ་དང་འབྲས་བུར་རིག་པར་བྱ་སྟེ།",
    "གཟུགས་མེད་པ་རྣམས་ནི་ཕྱོགས་ལ་ཁྱབ་པར་བྱེད་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་གང་ཞེ་ན།",
    "དམིགས་པ་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "དེ་ཡང་རྣམ་པར་རིག་པ་ནི་འཛིན་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་དེ་ནི་སེམས་ཞེས་ཀྱང་བྱ།",
    "དེ་ལ་འཇུག་པའི་རྣམ་པར་ཤེས་པ་ནི་དམིགས་པ་སོ་སོར་རིག་པའི་རང་བཞིན་ཡིན་པ་དང་།",
    "དམིགས་པ་སོ་སོར་རྣམ་པར་རིག་པ་ཡང་རྣམ་པ་དུ་མ་ཡིན་པའི་ཕྱིར།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ནི་སྣ་ཚོགས་ཞེས་བྱའོ།",
    "དངོས་སུ་ན་སེམས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "དེ་ལ་རྒྱུའི་རྐྱེན་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་གནས་པའི་བག་ཆགས་ཏེ།",
    "དེ་མ་ཐག་པའི་རྐྱེན་ནི་རྣམ་པར་ཤེས་པ་འགགས་མ་ཐག་པའོ།",
    "དེ་བཞིན་དུ་རྣ་བ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ལ་ཡང་ཇི་ལྟར་མཐུན་མཐུན་དུ་བརྗོད་པར་བྱའོ།",
    "ཤེས་པར་དཀའ་བའི་ཕྱིར་མ་སྨོས་སོ།",
    "དེའི་འོག་ཏུ་ཀུན་དུ་ཚོལ་བའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའོ།"
  ]
}