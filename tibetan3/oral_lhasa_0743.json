    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དང་།",
    "འདི་ནི་བདག་གོ་ཞེས་བྱ་བར་མཐའ་གཉིས་ལ་ཆགས་པར་གྱུར་པས།",
    "རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "རྣམ་པར་ཤེས་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "ཆུང་ཟད་མྱེད་པའི་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "འདུ་ཤེས་མྱེད་འདུ་ཤེས་མྱེད་མྱིན་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པ་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཡང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་ཡོངས་སུ་ཤེས་པ་མྱེད།",
    "དངོས་པོ་མཆིས་ཞེས་བགྱི་བ་ནི་ཇི་ལགས།",
    "དངོས་པོ་མ་མཆིས་ཞེས་བགྱི་བ་ནི་ཅི་ལགས།",
    "བཅོམ་ལྡན་འདས་གཉིས་ཤེས་བགྱི་བ་ཇི་ལྟ་བུ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ནི་གཉིས་སོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ནི་གཉིས་སོ།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ནི་གཉིས་སོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ནི་གཉིས་སོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ནི་གཉིས་སོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་འདུ་ཤེས་ནི་གཉིས་སོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་འདུ་ཤེས་ནི་གཉིས་སོ།",
