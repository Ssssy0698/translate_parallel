    "སེར་མོ་པདྨ་རཀྟའི་སྣོད་འཛིན་པ།",
    "གོང་གི་ཕྱག་རྒྱ་ལས་བཟློག་པས་གོ་རཱིའི་གནས་སུ་ཙོ་རཱི།",
    "དམར་མོ་རྡོ་རྗེ་དྲི་ཆུའི་སྣོད་འཛིན་པ་༴",
    "གཡོན་ཁུ་ཚུར་གྱི་སྟེང་དུ་གཡས་ཀྱི་ཐལ་མོའི་རྒྱབ་བཞག་ཏེ་སོར་མོའི་རྩེ་རྣམས་བསྡུས་པས་པུཀྐ་སཱི།",
    "དཀར་མོ་རོ་དྲུག་སྦྲང་རྩིའི་སྣོད་འཛིན་པ་༴",
    "གཏུམ་མོ་ནི་༴",
    "གཡུང་མོ་ནི་༴",
    "བཅུ་དྲུག་ལང་ཚོ་མཛེས་པའི་རྒྱན་ལྡན་མ།",
    "གཡུང་མོས་སྙོམས་འཇུག་བདེ་བས་མཆོད་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "གཙོ་བོ་དང་ལྷ་མོ་རྣམས་ཀྱང་དཔའ་བོའི་རྣམ་པར་གྱུར་པ་ལ་གཡུང་མོས་འཁྱུད་ཅིང་སྙོམས་པར་ཞུགས་པས་བདེ་བ་ཆེན་པོས་མཉེས་པར་བསམ་ཞིང་འཁྱུད་པའི་རྒྱས།",
    "གང་གི་ལྷག་མའི་ཞལ་རྣམས་ནི།",
    "གླང་པོ་རྟ་བོང་གླང་རྔ་མོང་།",
    "བཾ་ལས་སྐྱེས་པའི་སེར་མོ་ནུབ།",
    "གྷསྨ་རཱི་ནི་བྱང་གི་སྒོར།",
    "གཏུམ་མོ་ནམ་མཁའི་སྔོ་བསངས་མ།",
    "ཌཾ་ལས་འཁྲུངས་པའི་གཡུང་མོ་ནི།",
    "ལྷ་མོ་འཁོར་ལོར་བཅས་བསྟོད་པས།",
