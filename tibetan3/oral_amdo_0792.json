    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོཾ་ལས་རྣམ་སྣང་སོགས།",
    "དེ་དག་རྡོ་རྗེའི་ལམ་ནས་རང་གི་ཐུགས་ཀར་དྲངས།",
    "ཐུགས་ཀ་ནས་ཕྱིར་ཕྱུང་ཕྱོགས་བཅུར་འཕྲོས་རང་རང་གི་མཛད་པ་མཛད།",
    "སྤྲུལ་པ་རྣམས་འདུས་ནས་རང་རང་གི་ཞིང་དུ་གཤེགས་སོ་སོའི་ཡེ་ཤེས་པ་དང་གཅིག་ཏུ་གྱུར་ནས་མཆོག་ཏུ་དགའ་བའི་སྐུ་དང་ལྡན་པས་སླར་འབྱོན་པར་བཞེད་པའི་སྒོ་ནས་བཞུགས་པར་གྱུར།",
    "སླར་ཡང་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་ལྕགས་ཀྱུ་ལྟ་བུ་འཕྲོས་པས་འོག་མིན་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མདུན་གྱི་ནམ་མཁར་སྤྱན་དྲངས་ཞེས་མོས་ཏེ།",
    "མི་བཟད་བདུད་ཀྱི་དཔུང་གིས་ཕྱག་བྱས་པ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་དམ་ཚིག་པ་རྣམས་དང་གཉིས་སུ་མེད་པར་གྱུར་ཞེས་མོས་ཏེ་སྟ་གོན་གྱི་ལྷ་ལ་གོང་བཞིན་མཆོད་ནས་ཐུགས་ཀའི་ཧཱུཾ་གི་འོད་ཀྱིས་སྟ་གོན་གྱི་དཀྱིལ་འཁོར་སྤྱན་དྲངས་ཏེ་དམ་ཚིག་པ་ལ་བསྟིམ་ཛ་ཧཱུྃབཾ་ཧོ་བརྗོད།",
    "གཅིག་རེ་དང་བརྟན་བྱེད་དུ་ཡིག་བརྒྱ་བཟླས་སོ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གི་བདུད་རྩི་ཡི།",
    "བྱ་བ་རྣམས་རྫོགས་པ་དེ་སྲིད་དུ་བཞུགས་ནས་བར་ཆད་ཐམས་ཅད་སྲུང་བའི་ཕྲིན་ལས་མཛོད་ཅིག་ཅེས་བརྗོད་དེ་ཉེ་རེག་བྱས་ལ་ནང་དུ་འོང་ངོ།",
    "ཉིན་རེ་བཞིན་ཕྱི་རོལ་གྱི་གཏོར་མ་འདི་ཉིད་དང་གྲུབ་ན་ཀླུ་གཏོར་དང་ཞི་རྒྱས་སྦྱིན་བསྲེགས་ལ་སོགས་པ་བྱའོ།",
    "རྡོ་རྗེ་ཤུགས་ཀྱི་འཇུག་པས་དཀྱིལ་འཁོར་དུ་ཞུགས་པར་མོས་ནས་རྡོ་རྗེ་གསོར་དྲིལ་བུ་འཁྲོལ་ཞིང་རྡོ་རྗེའི་རྐང་སྟབས་ཀྱིས་དཀྱིལ་འཁོར་ལ་བསྐོར་བ་གསུམ་བྱས་ལ་ཤར་སྒོ་ནས།",
    "སྒེག་པའི་ཕྱག་གིས་བཅོམ་ལྡན་འདས་ལ་འདུད།",
    "དེ་བཞིན་དུ་བྱང་དང་ཤར་དང་ལྷོ་ནས་ལྷོ་དང་ནུབ་དང་བྱང་གི་སྒོ་ཕྱེ་བར་མོས་ཏེ་སྔགས་བརྗོད།",
    "ཉེས་པ་མེད་པ་རྟག་པ་ཁྱོད།",
    "དམ་ཚིག་མཆོག་གི་འདོད་པ་མཆོག།",
    "བདེན་པ་གང་གིས་ཡེ་ཤེས་མཆོག།",
    "བདེན་པ་དེ་ཡིས་མགོན་པོ་ཁྱོད།",
    "ཉོན་མོངས་ཆུ་སྲིན་ན་ཀྲས་ཁྱབ།",
    "མི་ཤེས་ལིང་ཏོག་གིས་བསྒྲིབས་མིག།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་སྟེ།",
    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "ༀཔྲ་བི་ཤ་བྷ་ག་ཝན་མ་ཧཱ་སུ་ཁ་མོཀྵ་སུ་རཾ་སརྦ་སིད་དྷི་སུ་ཁརཾ་པ་པ་ར་མ་སུ་ཁ་ཨུཏྟ་མ་སིད་དྷྱ་ཛ་ཧཱུྃ་བཾ་ཧོ་པྲ་སིད་དྷྱ་ཡཱ་ཞེས་པས་ལས་སྔགས་བཟླས་པའི་དར་དམར་པོའམ་སེར་པོའི་གདོང་གཡོགས་བཅིང་།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་ནུཏྟ་ར་བོ་བྷི་ཨ་ལཾ་ཀ་ར་ཝསྟྲ་པཱུ་ཛ་མེ་གྷ་ས་མུ་ཏྲ་སྥ་ར་ཎ་ས་མ་ཡེ་ཧཱུྃ་གིས་སྨད་གཡོགས་དང་།",
    "ས་བཛྲ་རཀྵ་ཧཾ་གིས་སྟོད་གཡོགས་དང་།",
    "ཡི་གེ་གསུམ་གྱི་འོད་ཟེར་གྱིས་ལུས་འོད་གསལ་བར་བྱས་ལ་ཧཱུཾ་ཞེས་བརྗོད་པས་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོར་འཁོད་པར་གྱུར་ཞེས་མོས་ཏེ་སློབ་དཔོན་གྱིས།",
    "ཀྱེ་བུ་ཁྱོད་སུ་ཡིན་ཅི་ལ་དགའ།",
    "ཞེས་ལན་གསུམ་གྱི་ཐུན་མོང་གི་སྡོམ་པ་བཟུང་ལ་ཐུན་མོང་མ་ཡིན་པའི་སྡོམ་པ་བཟུང་བའི་ཕྱིར།",
    "མགོན་པོ་འཁོར་ལོ་ལྷ་དག་གི།",
    "ཅེས་པའི་བར་ལན་གསུམ་གྱིས་ཐུན་མོང་མ་ཡིན་པའི་སྡོམ་པ་འཛིན་དུ་བཅུག་ལ།",
    "དེང་ཁྱོད་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བྱིན་གྱིས་བརློབ་པར་འགྱུར་གྱི།",
    "ཁྱོད་ཀྱིས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གསང་བའི་དཀྱིལ་འཁོར་འདི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པ་རྣམས་ལ་སྨྲ་བར་མི་བྱ་ཞིང་མ་དད་པ་རྣམས་ལ་ཡང་མ་ཡིན་ནོ་ཞེས་གདམས་སོ།",
    "ཨོཾ་ཨཱ་ཡ་མནྟ་ཀྲྀཏ་ཧཱུྃ་ཨ་ཁཾ་བི་ར་ཧཱུྃ་གིས་ཡོལ་བའི་ནང་དུ་ཁྲིད།",
    "དེ་བཞིན་དུ་ཤར་ལྷོ་ནུབ་བྱང་གི་སྒོར་རྣམ་སྣང་རིན་འབྱུང་འོད་དཔག་མེད་དོན་གྲུབ་རྣམས་སུ་བསྐྱེད་པའམ་དེ་དག་གི་ང་རྒྱལ་གྱིས་རིམ་པས།",
    "ཨོཾ་སརྦ་བུད་དྷ་པཱུ་ཛ་ཨུ་པ་སྠཱ་ནཱ་ཡ་ཨཱཏྨ་ནཾ་ནིརྱ་ཏ་ཡཱ་མི་སརྦ་ཏ་ཐཱ་ག་ཏ་བཛྲ་བེ་རོ་ཙ་ན་ཨ་ངྷི་ཏིཥྛ་མཾ།",
    "ཞེས་ཕྱག་བྱས་ལ་རིགས་སོ་སོས་བྱིན་གྱིས་བརླབས་པར་མོས་སོ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱི་དེས་ན་ངས་ཁྱོད་ལ་རྡོ་རྗེ་ཡེ་ཤེས་བསྐྱེད་པར་བྱ་སྟེ།",
    "ཡེ་ཤེས་གང་གིས་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དངོས་འགྲུབ་རྣམས་ཀྱང་ཐོབ་པར་འགྱུར་ན་དངོས་གྲུབ་གཞན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "ཁྱོད་ཀྱིས་ཀྱང་འདི་དཀྱིལ་འཁོར་མ་མཐོང་བ་རྣམས་ཀྱི་མདུན་དུ་སྨྲ་བར་མི་བྱ་སྟེ་ཁྱོད་དམ་ཚིག་ཉམས་པར་འགྱུར་ཏ་རེ་ཞེས་དང་།",
    "ཁྱོད་ཀྱི་དམ་ཚིག་རྡོ་རྗེ་འདི།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་འགའ་ཞིག་ལ།",
    "རྣམ་རྒྱལ་གྱི་སྟེང་གི་ཆུའི་སྣོད་མཐེབ་སྲིན་གྱིས་འཛིན་པས་ཆུ་ཡི་གེ་གསུམ་གྱིས་བསྔགས་ལ་དེའི་ཁར་བླུག་ཅིང་།",
    "དེང་ནས་བརྩམས་ཏེ་ཁྱོད་ཀྱི་ཕྱག་ན་རྡོ་རྗེ་ང་ཡིན་གྱི།",
    "ངས་འདི་གྱིས་ཤིག་ཅེས་གང་བསྒོ་བ་དེ་ཁྱོད་ཀྱིས་བྱ་དགོས་སོ།",
    "རལ་གྲི་འཛིན་པ་གཡོན་བརྐྱང་གིས་བཞུགས་པའི་སྤྱི་བོར་ཧ་མགྲིན་ཨཱ",
