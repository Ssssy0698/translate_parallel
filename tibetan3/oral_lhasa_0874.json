    "དེ་ལྟར་འདི་ཡིས་སླར་ཡང་རབ་ཏུ་སྤྱོར་བའི་སྒྲུབ་ཐབས་ཀྱི་མན་ངག་གསུངས་པ།",
    "གཞན་རྟོགས་པར་སླའོ།",
    "དེ་ལྟར་འདི་རྣམས་ཀྱི་སྔགས་ཀྱི་ཡི་གེ་རྣམས་གསུངས་པ།",
    "རབ་ཏུ་གསུངས་པ་སྟེ་སྡོམ་པ་རྒྱ་མཚོ་ཆེན་པོར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཀྱང་དེ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ཀྱི་འཆི་བ་བསླུ་བའི་མན་ངག་ཐམས་ཅད་སྟོང་པའི་གོ་འཕང་ཞེས་བྱ་བ་སྟེ་འོད་གསལ་བར་བྱས་ནས་སོ།་།",
    "དེ་ཡང་མངོན་སུམ་དུ་བྱས་ནས་ཏེ་དུ་བ་ལ་སོགས་པའི་རྟགས་བཅུ་རྣམས་ཀྱིས་ཞེས་བྱ་བའི་དོན་ཏོཟུ།",
    "འདི་གསུངས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གོ་སྤུསླའོ།",
    "ད་ནི་ལེའུ་བཅུ་བཞི་པ་རྒྱས་པར་བྱས་པ་གསུངས་པ།",
    "གཤིན་རྗེ་འཇོམས་མའི་འཇུག་པ་སྟེ་འཆད་པར་འགྱུར་བའི་མཚན་ཉིད་ཀྱིས་བསྐྱེད་པ་ལ་སོགས་པའོ།",
    "ཙའ་ཡི་གེས་དཔའ་བོ་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པ་རྣམས་ཀྱིས་ཀྱང་འདུས་པར་བྱས་ནས་སོ།",
    "ཅི་ཞེས་བྱ་བ་ཞུས་པ་གསུངས་པ།",
    "དེ་ལྟར་དྲིས་པའི་ཉོན་ཞེས་བྱ་བ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་ཀྱིས་ལན་གསུངས་པ།",
    "མ་རིག་པར་གྱུར་པས་ཡང་ཐམས་ཅད་མཐོང་ངོ།",
    "ཆུའི་ཟླ་བ་ལྟར་རྣམ་པར་དཔྱོད་པས་ཀྱང་མེད་དོ།",
    "ད་ནི་འདི་རྣམས་ཀྱི་ཀུན་རྫོབ་དང་དོན་དམ་པ་གཉིས་ཀྱི་དགོས་པ་དང་བྱེད་པའི་མཚན་ཉིད་ཀྱི་རང་བཞིན་གྱེ་མན་ངག་གསུངས་པ།",
    "དེ་ནས་དོན་དམ་པ་གཉིས་སུ་མེད་པ་གསུངས་པ།",
    "སླར་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་བྱ་བ་དང་བྱེད་པ་སྟེ་དོན་དམ་པ་སྟེ་རྟོགས་པར་ཁྱསླའོ།",
    "དེ་བཞིན་དུ་འདིར་འདིས་དེ་ལྟར་དུས་མ་ཡིན་པར་འཆི་བའི་རབ་ཏུ་སྤྱོར་བ་གསུངས་པ།",
    "སྲོག་རྒྱུ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་ཐོག་མེད་ཡུད་ཙམ་ཞེས་བྱ་བའི་བར་དུ་རྟོགས་པར་འུ།",
    "དེ་ལྟར་ཁ་སྦྱར་གྱི་སྔགས་ཀྱི་ཡི་གེ་རྣམས་གསུངས་པ།",
    "ལྷག་མ་རྟོགས་པར་སླའོ།",
    "ཞེས་བྱ་བ་ནི་ཀུན་དུ་སྤྱོད་པ་གསུངས་ཏེ།",
    "སླར་ཡང་བདག་པོར་བྱ་བ་གསུངས་པ།",
    "སླར་ཡང་ཁྱབ་བདག་ཉིད་གསུངས་པ།",
    "ད་ནི་རྣལ་འབྱོར་མ་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ཀྱི་རང་བཞིན་ཅན་མའི་རྣམ་པར་གཞག་པའི་མཚན་ཉིད་ཀྱིས་བདག་ཏུ་བྱེད་པའི་རྒྱུ་གསུངས་པ།",
    "ཏུའི་ཡི་གེ་ནི་ངེས་པར་གཟུང་བའོ།་།",
    "ཞེས་བྱ་བ་ནི་རྐང་གཉིས་ལ་སོགས་པའི་འཇིག་རྟེན་པ་སྐྱེས་པ་རྣམས་ཀྱི་དངོས་པོ་རྣམས་རྣམ་པར་ཉམས་པར་བྱེད་མ་སྟེ་འདོད་ཆགས་ལ་སོགས་པའོ།",
    "དེ་ལྟར་འདིའི་ཉེ་བར་བསྡུ་བའི་གླུ་གསུངས་པ།",
    "དེ་ལྟར་བྱས་པས་ཅིར་འགྱུར་བ་གསུངས་པ།",
    "སྲིད་པར་སླར་ཡང་ལྡོག་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ལྟར་འབྲས་བུ་དེའི་རྒྱུ་གསུངས་པ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་རྗེས་སུ་གནས་པ་སྟེ་མཁའ་འགྲོ་མ་ལ་སོགས་པ་ནས་འཇོམས་མའི་མཐར་རྣལ་འབྱོར་མ་བཅུ་གཉིས་རྣམས་ཀྱི་རྣམ་པར་གཞག་པའི་དབུས་སུ་ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ངེས་པའོ།",
    "དེ་ལྟར་གསུངས་པ།",
    "ཀུན་ནས་རྣམ་པར་དཔྱོད་པའི་དུས་སུ་རང་བཞིན་གྱིས་སྐྱེ་བ་བྱེ་ནི་རི་སྟེ་དེའི་ཚེ་རང་བཞིན་གྱི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཕུང་པོའི་རི་ནི་རྟེན་ནོ།",
    "དེ་ལྟར་མིག་ལ་སོགས་པའི་ཡུལ་རྣམས་སུ་འཛིན་པ་རྣམ་པར་དཔྱོད་པའི་དུས་སུ་གལ་ཏེ་རང་བཞིན་གྱི་ཡེ་ཤེས་དེའི་ཚེ་མིག་ལ་སོགས་པའི་ཡུལ་གྱི་སྤྱོད་ཡུལ་ཀུན་ནས་རྟེན་གྱི་འུགནས་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་གླིང་རྣམས་སོ།",
    "དེ་ལྟར་གལ་ཏེ་རུས་པ་ལ་སོགས་པའི་ཁམས་བདུན་རྣམས་སུ་ཀུན་ནས་འཛིན་པ་རྣམ་པར་དཔྱོད་པའི་དུས་སུ་རང་བཞིན་གྱི་བྱེ་ཡེ་ཤེས་པ་སྐྱེད་པ་དེའི་ཚེ་ཁམས་ཀྱི་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ཅན་ནོ།་།",
    "ཕྱི་རོལ་དུ་ཡང་སྣ་ཚོགས་པའི་ཉ་དང་ཤ་ལ་སོགས་པས་དེའི་ཚེ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ངེས་པའོ།",
    "དེ་ལྟར་རྒྱུའི་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་རྣམ་པར་བསམ་པའི་མཚན་ཉིད་རྣམ་པ་བརྒྱད་རྣམས་བསྐྱེད་པར་འགྱུར་ཏེ།",
    "ཁའི་གཙང་སྦྲ་སོགས་སྔོན་ཞེས་བྱ་བ་སྟེ།",
    "སྔོན་ཞེས་བྱ་བ་ནི་ནམ་ལངས་པ་དང་ལངས་ལ་གཙང་སྦྲ་བྱེལ་སོགས་པས་བྱའོ།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་གཞལ་མེད་ཁང་ན་སྤྱོད་པ་རྣམས་ཀྱི་དབུས་སུ་ཚངས་པའི་གཞལ་ཡས་ཁང་རྫོགས་པར་བྱེད་དེ་དེའི་རྣམ་པ་གཞལ་མེད་ཁང་ན་སྤྱོད་པ་རྣམས་ཀྱིས་བལྟས་ནས་སླར་ཡང་སྔོན་ཀྱི་བག་ཆགས་ཀྱིས་ཁམས་གསུམ་པའི་རྣམ་པ་ཚངས་པ་ལ་སོགས་༡་པའི་ལྷ་རྣམས་རྗེས་སུ་དྲན་པར་བྱས་ནས་བལྟ་སྟེ་བཅོམ་ལྡན་འདས་ཀྱི་བདག་ཉིད་ཅན་རྣམས་སོ།",
