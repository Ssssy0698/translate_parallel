    "རེས་ཞུམ་པ་དང་རེས་རྒྱས་པར་འགྱུར།",
    "ཁ་ཅིག་གིས།",
    "ལ་ལར་བདག་ཀུན་ཏུ་སོང་ཁྱབ་བར་མཐོང་།",
    "སེར་སྐྱས་བདག་གི་མཚན་ཉིད་ནི།",
    "མོས་པ་ཡིད་བྱེད་དང་།",
    "དེའི་དང་པོ་ནི་འཚོལ་བ་དྲུག་གིས་འཚོལ་བ་སྐྱོང་བ་སྟེ།",
    "དེ་ནི་སོ་སོའི་རང་གི་མཚན་ཉིད་དོ།",
    "འདི་ནི་ཐུན་མོང་སྤྱིའི་མཚན་ཉིད་དོ་ཞེས་མཚན་ཉིད་འཚོལ་བ་དང་།",
    "དེ་ལྟར་བསྒོམས་པས་དེའི་འགལ་ཟླའི་ཉོན་མོངས་ཆེན་པོ་སྤོང་བའི་ལམ་སྐྱེས་པ་རབ་ཏུ་དབེན་པའི་ཡིད་བྱེད་དོ།",
    "མེད་པའང་མ་ཡིན་ནོ་སྙམ་དུ་མཉམ་པར་གཞག་པས་འདུ་ཤེས་དང་འཛིན་པ་ཕལ་ཆེར་ཉེ་བར་ཞི་བའི་སྲིད་པའི་རྩེ་མོའི་ཏིང་ངེ་འཛིན་ཐོབ་བོ།",
    "དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ཐོབ་པས་རང་གི་ལུས་བལ་ལྟར་འཇམ་པ་དང་ཡང་བར་མོས་པ་མང་དུ་བྱས་པས་རྫུ་འཕྲུལ་༥བ་གྱི་མངོན་ཤེས་ཐོབ་སྟེ།",
    "ས་རྡོ་རི་རྣམས་ནམ་མཁར་མོས་པས་དེ་དག་ལ་ཐོགས་པ་མེད་པར་འགྲོའོ།"
