    "བྱང་ལ་སོགས་པའི་ཕྱོགས་ཐ་དད་པ་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་བཞིན་དུ་རྡུལ་ཕྲ་རབ་ཀྱང་ལུས་པ་ཥེམེད་པ་དང་།",
    "ཡུལ་ན་མི་གནས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་འོ་ན་ཕྱི་རོལ་གྱི་དོན་མེད་པའི་ཕྱིར་རྣམ་པར་ཤེས་པ་ཉིད་དོན་གྱིས་བླ་རྣམ་པར་འབྱུང་སྟེ།",
    "རྨི་ལམ་གྱི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ཁས་བླང་ངོ།",
    "ཚོར་བ་ལ་སོགས་པ་དག་ཀྱང་འདས་པ་དང་མ་འོངས་པ་ནི་དེའི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་སྐྱེད་སྐྱེཔ་མ་ཡིན་ཏེ།",
    "ད་ལྟར་གྱི་དག་ཀྱང་ད་ལྟར་གྱི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་མ་ཡིན་ཏེ།",
    "སྐྱེས་པའི་ཚེ་ན་ནི་རྣམ་པར་ཤེས་པ་ཡང་དེའི་རྣམ་པར་ཤེས་པའི་ཕྱིར་བྱ་བ་ཅུང་ཟད་ཀྱང་མེད་པས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་དམིགས་པ་མེད་པ་ཉིད་དུ་སྐྱེའོ།",
    "མེའི་ཡོན་ཏན་མེད་པར་བྲམ་ཟེའི་ཁྱེའུ་ལ་མེ་ཉེ་བར་གདགས་པ་ནི་མི་རིགས་སོ།",
    "གཙོ་བོ་ལ་ཤེས་པ་དང་བརྗོད་པ་ཡོན་ཏན་གྱི་ཚུལ་གྱིས་འཇུག་པར་ཟད་དེ།",
    "གཞན་དུ་ན་ཡོན་ཏན་དོན་མེད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་སྒྲའི་བར་དུ་འབྱེལ་བ་མེད་པར་ཤེས་པ་དང་།",
    "དེ་ལྟར་ན་བརྗོད་པ་དང་བརྗོད་པར་བྱ་བ་མེད་པས་དོན་གྱི་དངོས་པོ་མེད་དོ།་།",
    "སྒྲ་ཐམས་ཅད་ཀྱང་གཙོ་བོ་ལ་མེད་པར་བཏགས་པའི་ངོ་བོས་འཇུག་གོ།",
    "རྣམ་པར་ཤེས་པ་གྱུར་པ་རབ་ཏུ་དབྱེ་བ་ཡོད་པ་མི་ཤེས་ཏེ།",
    "རྣམ་པར་སྨིན་དང་ངར་སེམས་དང་།",
    "ཡུལ་ལ་རྣམ་པར་རིག་པའོ།",
    "གྱུར་པ་རྣམ་པ་གསུམ་པོ་དེ་དག་ནི་རྣམ་པར་སྨིན་པ་ཞེས་བྱ་བ་དང་།",
    "ཡུལ་ལ་རྣམ་པར་རིག་པ་ཞེས་བྱའོཀྱི།",
    "གཟུགས་ལ་སོགས་པ་ཡུལ་སོ་སོར་སྣང་བས་མིག་ལ་སོགས་པའི་རྣམ་པར་ལྐུཤེས་པ་རྣམ་པ་དྲུག་ནི་ཡུལ་ལ་རྣམ་པར་རིག་པར་བྱའོ།",
    "ཀུན་གཞི་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་གང་ཡིན་པ་དེ་རྣམ་པར་སྨིན་པར་གྱུར་པའོ།",
    "རྣམ་པར་ཤེས་པར་བྱེ་བྱེད་པས་རྣམ་པར་ཤེས་པའོ།",
    "གལ་ཏེ་འཇུག་པའི་རྣམ་པར་ཤེས་པ་ལས་གུད་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡོད་ན་གོ་བ་དེའི་ཕྱིར་དམིགས་པ་དང་རྣམ་པ་ཡང་བརྗོད་དགོས་ཏེ།",
    "རྣམ་པ་མེད་པའི་རྣམ་པར་ཤེས་པ་ནི་མི་རུང་ངོ།",
    "ཕྱི་རོལ་གྱི་རྣམ་པ་ཡོངས་སུ་མ་ཆད་པ་སྣོད་ཀྱི་རྣམ་པར་རིག་པ་དང་རྣམ་པ་ལྐུགཉིས་སུ་འབྱུང་སྟེ།",
    "རྣམ་པར་རིག་པ་མི་རིག་སྟེ་། གང་ལ་ལེན་པ་མི་རིག་པ་དང་།",
    "གནས་ཀྱི་རྣམ་པར་རིག་པ་མི་རིག་པ་ཡོད་པའི་ཕྱིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ལེན་པ་དང་གནས་ཀྱི་རྣམ་པར་༦མི་རིག་པའོ།",
    "དེ་ལ་ལེན་པ་ནི་ལེན་པར་བྱེད་པའོ།",
    "དེ་ཡང་བདག་ལ་སོགས་པར་རྣམ་པར་རྟོག་པའི་བག་ཆགས་དང་།",
    "དེ་ལ་ཡོད་པའི་ཕྱིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པས་བདག་ལ་སོགས་པ་རྣམ་པར་རྟོག་པ་དང་།",
    "གཟུགས་ལ་སོགས་པར་རྟོག་པ་འབྲས་བུར་ལེན་པས་བདག་ལ་སོགས་པ་སྤུརྣམ་པར་རྟོག་པ་དང་།",
    "གཟུགས་ལ་སོགས་པར་རྣམ་པར་རྟོག་པའི་བག་ཆགས་དེ་ནི་ལེན་པ་ཞེས་བྱ་སྟེ།",
    "དེ་ནི་འདི་ལ་འདིའོ་ཞེས་ཚོར་བའི་རྣམ་པར་མི་རིག་ཙོ་པས་དེའི་ཕྱིར་དེ་ནི་ལེན་པ་མི་རིག་པ་ཞེས་བྱའོ།",
    "གཟུགས་སུ་རྣམ་པར་མྦིན་པ་ཧཱུཾམི་འགྲུབ་པས་མིང་བཞི་ལེན་པ་ཉིད་དེ།",
    "རྣམ་པར་སྨིན་པའི་དུས་ནི་མ་ཡིན་ནོ།",
    "ལེན་པ་དེ་ལ་འདིའོ་ཞེས་རིག་པར་མི་ནུས་པས་དེའི་ཕྱིར་མི་རིག་པ་ཞེས་བྱའོ་་། གནས་ཀྱི་རྣམ་པར་རིག་པ་སྣོད་ཀྱི་འཇིག་རྟེན་གནས་པར་རྣམ་པར་རིག་པ་སྟེ།",
    "ཇི་ལྟར་ལྟརྣམ་པར་ཤེས་པ་དམིགས་པ་དང་རྣམ་པར་ཡོངས་སུ་མ་ཆད་པར་འགྱུར་ཞིང་།",
    "འགོག་པ་ལ་སོགས་པའི་དུས་ན་རྣམ་པར་ཤེས་པ་རྔེད་པར་རྟོག་པར་ཡང་མི་ནུས་ཏེ།",
    "དེ་བཞིན་དུ་ཅི་སེམས་ལས་བྱུང་བ་དེ་དག་དང་རྟག་ཏུ་མཚུངས་པར་ལྡན་ནམ།",
    "བདེ་བའི་ཚོར་བ་འབྱུང་ངོ་ཞེས་རྒྱ་ཆེར་གསུངས་སོ།",
    "འཇུག་པར་བྱེད་པས་འཇུག་པ་སྟེ།",
    "སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པ་མྱོང་བ་ནི་ལས་དགེ་མི་དགེ་གཉི་གའི་འབྲས་བུ་རྣམ་པར་སྨིན་པའོ་སྙམ་དུ་སེམས་སོ།",
    "འགགས་ན་བེེར་ཕྲད་པར་འདོད་པ་སྐྱེའོ།",
    "འགགས་ན་སླར་ཕྲད་པར་མི་འདོད་པའོ།",
    "སེར་པོ་ལ་སོགས་པ་དམིགས་པ་རྣམ་པར་ཁྲུགཞག་པའི་རྒྱུའོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་སྐབས་ཡིན་པས་དེར་བསྙེགས་སོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཚོར་བ་བཏང་སྙོམས་ཉིད་ཡིན་གྱིཐུ།",
    "ཞེས་བྱ་བ་ཡང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བསྙེགས་སོ།",
    "དེ་ལ་མ་བསྒྲིབས་པ་སྨོས་པ་ནི་བསྒྲིབས་པའི་ལུང་དུ་མ་བསྟན་པ་རྣམ་པར་གཅད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་གཅིག་ཏུ་རྣམ་པར་སྨིན་པ་དང་།",
    "བདག་མ་གཏོགས་པར་གཞན་བཞི་དང་།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་རྟག་ཏུ་ལྡན་ནོ།",
    "མ་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པ་ཡང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་བཞིན་ཏེ།",
    "རྣམ་པར་མྦིན་པ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་རྣམ་པར་སྨིན་པ་མ་ཡིན་པ་དང་།",
    "གཞན་དུ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "ཅི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་༡ཇི་སྲིད་འཁོར་ཀྱི་ནང་༢དུ་ཐ་དད་པ་མེད་པར་འཇུག་པ་ཞིག་གམ།",
    "དེ་གཅིག་པུ་ཐ་དད་པ་ཟིམེད་པར་འཇུག་པ་མ་ཡིན་ཏེ་སྐད་ཅིག་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་དང་སྦྱར་རོ།",
    "ཆུའི་ཚོགས་ཀྱི་སྔ་ཕྱིའི་ཆུ་རྒྱུན་མི་འཆད་པར་འབབ་པ་ནི་ཆུ་བོ་ཞེས་བྱའོ།",
    "བསྡུས་ནས་ཇི་སྲིད་འཁོར་གྱི་བར་དུ་རྒྱུན་མི་འཆད་པར་རྒྱུན་དུ་འབྱུང་ངོ།",
    "དེའི་ཚེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་གནས་ངན་ལེན་མ་ལུས་པར་སྤངས་པའི་ཕྱིར།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལྡོག་པར་འགྱུར་ཏེ།",
    "དེ་ལ་ཇི་ལྟར་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་རྣམས་ཀྱི་གནས་མིག་ལ་སོགས་པ་དང་།",
    "དེ་ལ་ཞེས་བྱ་བའི་སྒྲ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ལ་སྦྱར་རོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་དེའི་བག་ཆགས་ཀྱི་གནས་ཡིན་ཏེ།",
    "དེ་ལ་དམིགས་པ་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ལ་དམིགས་པ་སྟེ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་ལ་སོགས་པ་དང་མཚུངས་པར་ལྡན་པས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ང་དང་ང་ཡིར་དམིགས་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ན་སེམས་གང་ལས་བྱུང་བ་དེ་ཉིད་དེའི་དམིགས་པར་འགྱུར་ཞེ་ན།",
    "ཞེས་བྱ་བ་འདིས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་ལས་རྣམ་པར་བྱེའབྱེད་དོ།",
    "ཇི་སྲིད་དུ་མཚུངས་པར་ལྡན་པར་འགྱུར་བ་དེ་མི་ཤེས་ཏེ།",
    "དེ་ལས་གཞན་པ་དག་ལས་རྣམ་པར་དབྱེ་བའི་ཕྱིར།",
    "དེ་དག་ཐམས་ཅད་དང་མཚུངས་པར་ལྡན་པ་༩མ་ཡིན་པས་དེའི་ཕྱིར་བཞི་ཞེས་བྱ་བ་སྨོས་སོ།",
    "འགྲོགས་ཞེས་བྱ་བ་ནི་མཚུངས་པར་ལྡན་པའོ།",
    "ཇི་སྲིད་དུ་དེ་ཡོད་པ་དེ་སྲིད་དུ་དེ་དག་དང་ཀྱེམཚུངས་པར་ལྡན་ནོ།",
    "སྤྱིར་བསྟན་པས་ཁྱད་པར་མི་ཤེས་ནས་ཁྱད་པར་སྟོན་ཏོ།",
    "འོན་ཏེ་གཞན་གྱི་ས་པ་དག་དང་མཚུངས་པར་ལྡན་པ་མི་ཤེས་ནས།",
    "དེའིའོ་ཞེས་བྱ་བ་ནི་ཁམས་དང་ས་གང་དུ་སྐྱེས་པ་ཁམས་དེ་དང་ས་དེ་ཉིད་ཀྱི་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "དེ་དག་ཀྱང་གང་དུ་སྐྱེས་པ་དེ་ཉིད་དང་མཚུངས་པར་ལྡན་གྱེ།",
    "ཡང་ན་གཞན་ཞེས་བྱ་བ་ནི་རྩ་བའི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པ་དག་ལས་རྣམ་པར་དབྱེ་བའི་ཕྱིར་ཏེ།",
    "ལུང་དུ་མ་བསྟན་པའི་དུས་ན་ཡང་བྱེ་བྲག་མེད་པར་འབྱུང་ན་ནི་དེའི་ལྡོག་པ་རྔེད་པར་འགྱུར་རོ།",
    "ཕྱིར་མི་འོང་བ་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཐོབ་པ་ཡང་ལམ་གྱི་སྟོབས་ཀྱིས་འགོག་པའི་སྙོམས་པར་ཅེའཇུག་པ་ཐོབ་པས་འགོག་པའི་སྙེམས་པར་འཇུག་པའི་དུས་ན་ཡང་ལམ་བཞིན་དུ་འགག་པར་འགྱུར་རོ།",
    "འགོག་པ་ལས་ལངས་སྒོནས་ཡང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ལས་འབྱུང་ངོ།",
    "འཇིག་རྟེན་ལས་འདས་པ་སྨོས་པ་ནི་འཇིག་རྟེན་པ་རྣམ་པར་གཅད་སྩོཔའི་ཕྱིར་རོ།",
    "དེ་ལས་ལངས་ནས་ཡང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ལས་འབྱུང་ངོ།",
    "འདི་ལྟར་དེ་དག་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་རྣམས་ལ་བྱེ་བྲག་མེད་པར་འབྱུང་ངོ།",
    "བལྟ་ཥྤེབ་དང་མཉན་རྡུཔར་བྱ་བ་ལ་སོགས་པའི་ཡུལ་བསམས་པའི་དངོས་པོ་གང་ཡིན་པ་དེ་ནི་བསམས་པའོ།",
    "དེ་ལ་མཐོང་བ་དང་ཐོས་པ་ལ་སོགས་པར་སྨོན་པ་ནི་འདུན་པ་སྟེ།",
    "ངེས་པར་སྨོས་པ་ནི་ངེས་པ་མ་ཡིན་པ་དགག་པའི་ཕྱིར་ཏེ།",
    "དེ་ནི་རྣམ་པར་མི་གཡེང་བའི་ལས་ཅན་ཏེ།",
    "རྣམ་པ་གཞན་ལ་སེམས་རྣམ་པར་གཡེང་བ་རྔེད་པས་རྣམ་པར་གཡེང་བ་མེད་པའི་ལས་ཅན་ནོ།",
    "ངེས་པར་བརྟག་པར་བྱའོ།",
    "སེམས་མཉམ་པར་གཞག་ན་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་པའི་ཕྱིར་ཤེས་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "ཐུཔའི་དངོས་པོ་ཉིད་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་སྟེ།",
    "རྣམ་པར་འབྱེད་པར་བྱེད་པས་རབ་ཏུ་རྣམ་པར་འབྱེད་གྲུཔ་སྟེ།",
    "རིགས་པ་ངེས་པར་སེམས་པ་ལས་སྐྱེས་པ་ནི་བསམས་པ་ལས་བྱུང་བའོ།",
    "རྗེས་སུ་དཔག་པར་སྣང་བ་དང་།",
    "ལོག་པར་བསམས་པའི་ཏིང་ངེ་འཛིན་ཏེ།",
    "ཐམས་ཅད་ལ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "རྣམ་པར་སྨིན་པ་མི་འདོད་པ་ཡིན་པས།",
    "བྱས་ཀྱང་རུང་མ་བྱས་ཀྱང་རུང་།",
    "འདི་ནི་ཉེས་པར་སྤྱོད་པ་ལེགས་པར་སྡོམ་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "བདག་ལ་ལས་འདི་ལྟ་བུ་རིག་ན་སྨོད་པར་འགྱུར་རོ་ཞེས་ཚིགས་སུ་བཅད་པ་མ་ཡིན་པ་ལ་སོགས་པའི་འཇིགས་རྔུཔས་ཁ་ན་མ་ཐོ་བ་ལ་འཛེམ་པ་སྟེ།",
    "འདི་ཡང་ཉེས་པར་སྤྱོད་པ་ལེགས་པར་སྡོམ་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "འདི་ནི་ཉེས་པར་སྤྱོད་པ་ལ་མི་འཇུག་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "འདི་ཡང་ཉེས་པར་སྤྱོད་པ་ལ་མི་འཇུག་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡང་དག་པར་རྟོགས་པའོ།",
    "འདི་ཡང་ཉེས་པར་སྤྱོད་པ་ལ་མི་འཇུག་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "དེ་དང་ལྡན་ན་དམིགས་པ་ལ་སེམས་ཐོགས་པ་རྔེད་པར་འཇུག་པས་དེའི་ཕྱིར་སེམས་ལས་སུ་རུང་བ་ཞེས་བྱའོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་ལས་ཅན་ནོ།",
    "བྱིང་བ་དང་རྒོད་པ་ནི་གཉེན་པོའི་རྒྱུ་རྣམས་ལ་རྩོལ་བ་མི་བྱེད་པར་ལྷུན་ཀྱིས་གྲུབ་པའི་དུས་ན་སེམས་ལྷུན་གྱིས་གྲུབ་པ་ཉིད་དེ།",
    "རྣམ་པར་མི་འཚེ་བ་ནི་རྣམ་པར་འཚེ་བའི་གཉེན་པོ་སྟེ།",
    "འདི་ནི་རྣམ་པར་ཐོ་མི་འཚམས་པའི་ལས་ཅན་ནོ།",
    "དེ་ལ་འདོད་ཆགས་ནི་སྲིད་པ་དང་ལོངས་སྤྱོད་ལ་ལྷག་པར་ཆགས་པ་དང་སྨོན་པ་སྟེ།",
    "སེམས་ཀྱི་རྗེས་སུ་འགྱུར་བས་ལུས་ལ་ཡང་གདུང་བར་ཡང་འགྱུར་བ་ཉིད་དེའི་སྤྱོད་ལམ་ཐམས་ཅད་དུ་སྡུག་བསྔལ་དང་བཅས་ཤིང་ཕོངས་པ་དང་བཅས་པར་གནས་པར་འགྱུར་རོ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་ལ་སོགས་པའི་ལྟ་བ་དང་སྦྱར་གྱེ་འཇིག་རྟེན་གྱི་ཡང་དག་པར་ལྟ་བ་དང་།",
    "མཐར་འཛིན་པར་སྔུལྟ་བ་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་ལ་བདག་ཏུ་བཟུང་བ་དེ་དག་ཉིད་ལ་གང་ཆད་པའམ།",
    "རྟག་པར་ལྟ་བའོ།",
    "དངོས་པོ་ཡོད་པ་འཇིག་པར་བྱེད་པ་སྟེ།",
    "ལྟ་བ་མཆོག་ཏུ་འཛིན་པ་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་༥རྣམས་ལ་མཆོག་དང་ཁྱད་པར་དུ་འཕགས་པ་དང་གཙོ་བོ་དང་དམ་པར་ལྟ་བ་གང་ཡིན་པའོ།",
    "ཁོན་དུ་འཛིན་པ་ནི་མདུད་པར་འཛིན་པ་སྟེ།",
    "མི་བཟོད་པ་ནི་གནོད་པ་བྱེད་པ་ལ་ཇི་མི་སྙམ་པར་མི་བྱེད་ཀྱི་ལན་ཙོདུ་གནོད་པ་བྱེད་འདོད་ཅེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "དེ་ཁ་ན་མ་ཐོ་བ་མཁྱུད་པ་ན་འགྱོད་པར་འགྱུར་རོ།",
    "ཞེར་འདེབས་པར་བྱེད་པའི་ངང་ཚུལ་ནི་༤ཞེར་འདེབས་པ་སྟེ།",
    "དེ་དག་དང་ལྡན་པའི་གང་ཟག་དང་འགྲོགས་པར་དཀའ་ཤཾབའི་ཕྱིར་རོ།",
    "འཐོབ་པ་དང་བཀུར་སྟེ་ལ་ལྷག་པར་ཆགས་པས་གཞན་གྱི་རྙེད་པ་དང་།",
    "ཡིད་མི་བདེ་བ་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "སྦྱིན་པར་བྱེད་པ་དེ་ནི་སྦྱིན་པའོ།",
    "དེ་ཡོད་ན་སྦྱིན་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་དེ་དང་མི་མཐུན་པ་ཞེས་བྱའོ།",
    "རྙེད་པ་དང་བཀུར་སྟེ་ལ་ལྷག་པར་ཆགས་པས་པྱའཚོ་བའི་ཡོ་བྱད་རྣམས་ལ་འདོད་ཆགས་ཀྱི་ཆར་གཏོགས་པའི་སེམས་ཀྱི་ཀུན་དུ་འཛིན་པ་དང་ཡོངས་སུ་མི་གཏོང་བའི་འདོད་པ་ནི་སེར་སྣའོ།",
    "ཡོ་བྱད་མ་བསྙུངས་པ་ནི་སེར་སྣས་ཡོ་བྱད་མི་མཁོ་བ་རྣམས་ཀྱང་སྩོགས་པར་༦རིག་པར་བྱའོ།",
    "དེ་དང་ལྡན་ན་སེམས་དྲུན་པར་གྱུར་ནས་སློང་བར་གྱུར་ཏེ།",
    "དམིགས་པ་རྟོགས་པར་མི་ནུས་པའོ།",
    "རྒོད་པ་ནི་སེམས་རྣམ་པར་མ་ཞི་བའོ།",
    "རྣམ་པར་ཞི་བ་ནི་ཞི་གནས་ཏེ།",
    "དེ་དང་མི་མཐུན་པ་ནི་རྣམ་པར་མ་ཞི་བའོ།",
    "རྩེ་རྩེ་བ་རྗེས་སུ་དྲན་ནས་སེམས་རྣམ་པར་མ་ཞི་བའི་རྒྱུ་སྟེ།",
    "འདི་ནི་རྣམ་པར་གཡེང་བའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "འདིས་སེམས་སྣ་ཚོགས་སུ་གཡེང་བར་བྱེད་པས་རྣམ་པར་གཡེང་བའོ།",
    "སྨད་པ་བྱས་པས་འགྱོད་དོ།",
    "ཀུན་དུ་ཚོལ་བ་ནི་འདི་ཀྱེཅི་ཡིན་ཞེས་རྟོག་པའི་རྣམ་པར་ཞུགས་པའོ།",
    "འདི་གཉིས་ནི་རྩིང་བ་དང་ཞིབ་པར་རྣམ་པར་གནས་པས་ཐ་དད་དུ་དབྱེ་བའོདཱུ།",
    "ཚོར་བ་རྣམ་པ་གསུམ་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་ཀུན་དུ་འགྲོ་བ་ལྔ་པོ་ཁོ་ན་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "ལྔ་རྣམས་ཞེས་བྱ་བ་ནི་མིག་ལ་སོགས་པ་རྣམ་པར་ཤེས་པ་རྣམས་ཏེ།",
    "དེའི་རྗེས་སུ་རྒྱུ་བ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་བཅས་པ་རྣམས་སོ།",
    "འགྲོ་བ་རྣམས་སུ་སྐྱེ་བ་ཉེ་བར་ལེན་པའི་ཕྱིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་རྩ་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱའོ།",
    "ཆུ་ལ་རླབས་རྣམས་ཇི་བཞིན་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་ཟུའཇུག་པའི་རྣམ་པར་ཤེས་པ་བྱུག་ཅར་རམ་ཅིག་ཅར་མ་ཡིན་པར་འགྱུར་བའི་དཔེ་སྟེ།",
    "ཆུ་བོའི་ཆུ་རྒྱུན་ཡང་ཆད་པར་མི་འགྱུར་ལ།",
    "ལེན་པའི་རྣམ་པར་ཤེས་པ་ཟབ་ཅིང་ཕྲ།",
    "བདག་ཏུ་རྟོག་པར་གྱུར་ན་མི་རུང་ཞེས།",
    "རྣམ་པར་ཤེས་པའི་དམིགས་པའི་རྐྱེན་སོ་སོར་ངེས་པ་བཞིན་དུ་དེ་མ་ཐག་པའི་རྐྱེན་ནི་མི་འདོད་དེ།",
    "དམིགས་པའི་རྐྱེན་དང་ཕྲད་ན་དེ་མ་ཐག་པའི་རྐྱེན་གཅིག་པུ་དེ་ལས་ཀྱང་རྣམ་པར་ཤེས་པ་གཉིས་སམ་མང་པོ་འབྱུང་སྟེ།",
    "ཧཱུཾད་ནི་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "ཅི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་དག་དང་ལྷན་ཅིག་འབྱུང་ངམ།",
    "སྙོམས་པར་འཇུག་པ་རྣམ་གཉིས་དང་།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་པ་དང་དེ་མ་ཡིན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྟོམས་པར་འཇུག་པ་རྣམ་པ་གཉིས་ནི།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པའོ།་།",
    "ང་ར་ཤེས་པ་དང་དེ་དང་མཚུངས་པར་ལྡན་པའི་སེམས་ལས་བྱུང་བ་རྣམས་གང་འགོག་པ་སྟེ།",
