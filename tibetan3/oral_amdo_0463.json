    "མཚོན་སྟངས་ཐབས་ཤེས་བཞི་པ་ནི་བགྲོ་གླེང་གི་མཚོན་ཐབས་ཡིན་ཞིང་དེ་ནི་ལེའུ་བཞི་པའི་སྐབས་ཕྱོགས་གཅིག་ཏུ་བསྟན་པར་བྱའོ།",
    "དེ་ནི་གཅིག་ནས་དངོས་པོ་གང་གི་བཟོ་དབྱིབས་དང་།",
    "ཕན་ནུས་སོགས་ལ་འགྲེལ་བ་ཁ་གསལ་བྱེད་པའམ་ཡང་ན་མིང་ཚིག་གི་མཚན་ཉིད་དམ།",
    "རང་གི་མཚན་གཞིའི་སྟེང་དུ་གྲུབ་པ།",
    "དེ་དག་རང་གིས་བཟའ་བཅའ་བཟོ་སྐྲུན་མི་ཐུབ་ཅིང་།",
    "སྤྱང་ཀི་གཟིག་འབུ་ཕྲ་བཅས་ཚང་མ་མཐར་བཏུགས་ན་རྩི་ཤིང་ལ་བརྟེན་ནས་འཚོ་བར་བྱེད།",
    "ལྗོངས་ཡོངས་ཀྱི་སྤྱིའི་ས་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི་བརྒྱ་དང་ཉི་ཤུ་རྩ་གཉིས་ལྷག་ཡོད་པ་དེས་རྒྱལ་ཡོངས་ཀྱི་བརྒྱད་ཟུར་གཅིག་ཙམ་ཟིན་པ་དང་།",
    "བོད་ཀྱི་ཆ་སྙོམས་མཐོ་ཚད་ནི་རྒྱ་མཚོའི་ངོས་ལས་སྤྱི་ཁྲེ་བཞི་སྟོང་ལྷག་ཙམ་ཡོད་པས་འཛམ་གླིང་གི་ཡང་རྩེ་ན་གྲགས་ཤིན་ཏུ་ཆེ།",
    "འཁྱོག་རིས།",
    "སྒོར་རིས་ལ་སོགས་པའི་རི་མོ་བེད་སྤྱོད་བྱས་ནས་བྱ་དངོས་ཀྱི་ཁྱད་ནུས་གསལ་མཚོན་བྱེད་ཅིང་།",
    "རི་མོ་དང་རེའུ་མིག་གི་མཚོན་སྟངས་ལ་ཕྱོགས་བསྡོམས་རི་མོ་དང་ཕྱོགས་བསྡོམས་རེའུ་མིག་གཉིས་ཡོད།",
    "ཕྱོགས་བསྡོམས་རི་མོ་ནི་རི་མོའི་བཟོ་ལྟས་བསྡོམས་རྩིས་ཀྱི་གྲངས་མང་ཉུང་དང་འགྱུར་བའི་གཞི་ཁྱོན་རི་མོར་བརྟེན་ནས་མཐོང་དཀའ་བ་དག་མི་རྣམས་ལ་ཤེས་རྟོགས་སླ་བ་དང་ངོས་འཛིན་བདེ་བ་བཅས་ཡོང་རྒྱུར་ཕན་ཐོགས་ཡོད།",
    "ཕྱོགས་བསྡོམས་རེའུ་མིག་ཅེས་པ་ནི་འབྲེལ་ཡོད་ཀྱི་ཞིབ་འཇུག་བྱ་ཡུལ་དག་ཨང་ཀིས་མཚོན་པའི་རེའུ་མིག་ཡིན་ཏེ།",
    "དེའང་ཀྱག་ཀྱོག་དང་རྙོག་འཛིང་གི་རང་བཞིན་ཆེན་པོ་ལྡན་པ་ཞིག་ཡིན་ན་དེ་མ་ཉིད་དུ་ངོས་འཛིན་དང་གསལ་རྟོགས་བྱ་ཐུབ་པ་ཞིག་མ་ཡིན་ལ།",
    "གལ་ཏེ་དེ་འདྲའི་རེ་བ་དང་མ་མཐུན་ཚེ་ནན་ཏན་གྱིས་ཞིབ་འཇུག་བྱས་ཏེ་སྤོང་བ་དང་།",
    "གལ་སྲིད་དེ་དག་རེ་བ་བཞིན་བྱུང་མེད་ཚེ་འོས་འཚམས་ཀྱིས་བཟོ་བཅོས་རྒྱག་དགོས།",
    "རང་གིས་བྲིས་པའི་རྩོམ་གྱི་སྐྱོན་རང་གིས་མཐོང་སླ་བ་ཞིག་མིན་པས་ངེས་པར་དུ་བསམ་བློ་མང་ཙམ་གཏོང་བ་དང་བལྟ་ཞིབ་མང་ཙམ་བྱེད་དགོས།",
    "རང་གིས་དཀའ་བ་སྤྱད་པ་ལས་ཐོབ་པའི་འབྲས་བུ་དག་དབྱུགས་མི་ནུས་པ་ཡོང་སྲིད་ན་དེ་འདྲའི་བསམ་བློ་དོར་དགོས།",
    "ཐོར་སི་ཐའེ་ཡིས་རྩོམ་བཅོས་སྐབས་གཙོ་ཆེ་ཤོས་ནི་ཚན་པ་རེ་འགའ་དབྱུགས་རྒྱུ་དེ་རེད།",
    "ཁོང་གིས་གྲོགས་པོ་ཞིག་ལ་བཏང་བའི་ཡི་གེའི་ནང་གདམས་གསེས་ལེགས་པོ་བྱ་དགོས།",
    "བརྩམས་སྒྲུང་ཐུང་གྲས་འབྲི་དུས་མགྱོགས་དགོས་མོད།",
    "ནུབ་ཕྱོགས་དེང་རབས་རྩོམ་རིག་གི་བསམ་བློ་གླེང་བ།",
    "གླེང་མོལ།",
    "ཁྱོད་ཅི་བྱེད་དུ་འགྲོ།",
    "གཏམ་གླེང་གི་སྣེ་ལེན་སྟངས།",
    "དེ་དག་གི་ནང་དོན་ཞིབ་ཕྲ་སུམ་རྟགས་གཞུང་ལས་ཤེས་མོད།",
    "ལྷུག་པའི་ཚིག་གི་བར་སྟོང་ཐོབ་མིན་ཁྱད་པར་རབ་ཏུ་གསལ་བའི་སྡོམ་ཤེལ་གྱི་བུམ་བཟང་ཞེས་བྱ་བ།",
    "གདམ་ངའི་དོན་གྱི་གོང་གི་ཕྲད།",
    "ཐད་ཀར་གུག་རྟགས་ནང་མཆན་འགོད་པ་དེའི་དགེ་ཆ་གཙོ་བོ་ནི་ཀློག་པ་པོས་ཀློག་པའི་བརྒྱུད་རིམ་ནང་ཐད་ཀར་མཐོང་ཐུབ་པས་ཀློག་མཚམས་བཅད་མི་དགོས་པ་དེ་ཡིན་མོད།",
    "༣ རྩོམ་གྱི་བར་སྟོང་འཇོག་སྟངས་དང་མཆན་འགོད་སྟངས་བཅས་ཀྱི་ནང་དོན་ལ་བསམ་གཞིགས་ལེགས་པར་བྱས་ཏེ་ལག་ལེན་ཐོག་དོན་འཁྱོལ་བྱེད་དགོས།",
    "སྙན་རྩོམ་ནི་ཆེས་དར་སྔ་བའི་རྩོམ་རིག་གི་རྣམ་པ་ཞིག་ཡིན་ལ།",
    "ཕྱིས་སུ་རིམ་བཞིན་གླུ་གར་དང་སྙན་རྩོམ་ཞེས་སོ་སོ་རང་རྐྱ་ཐུབ་པའི་རིག་ཚན་གཉིས་སུ་གྱུར་བ་རེད།",
    "དེས་ན་སྙན་རྩོམ་ནི་མིའི་རིགས་ཀྱི་རྩོམ་རིག་གི་བྱིས་པའི་དུས་སྐབས་ཡིན་ལ།",
    "མིའི་རིགས་ཀྱི་རྩོམ་རིག་གི་ཞིང་ས་གཤིན་པོ་དེ་ཡང་ཡིན་ཞེས་བརྗོད་སྲོལ་ཡོད།",
    "སྙན་ཚིག་རྣམས་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ལྟ་བུར་སོང་མོད།",
    "སྙན་ངག་དང་རྩོམ་རིག་གཉིས་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ལྟ་བུར་མཐོང་བས་ན་དཔྱད་པར་རིགས།",
    "ཚེག་ཁྱིམ་གསུམ་ཅན་བཞི་ཅན་ནས་དེ་ལས་ཆེས་མང་བ་ཡོད་པས་ང་ཚོས་ཞིབ་འཇུག་དང་དཔྱད་པ་གཤིབ་བསྡུར་བཅས་བྱེད་དགོས་སོ།",
    "ཐུན་མོང་ཐོག་ངལ་རྩོལ་བྱེད་སྐབས་རྐང་ལག་དོ་མཉམ་ལོང་ཕྱིར།",
    "ངག་ཐོག་གི་སྙན་རྩོམ་དར་བར་གསུངས་ཏེ།",
    "ལུའུ་ཞུན་གྱིས་དེ་དུས་ཚང་མས་མཉམ་དུ་ཤིང་སྡོང་ཁུར་སྐབས་ཧང་ཡོ་ཧང་ཡོ་ཞེས་བྱུང་བའི་སྒྲ་དེ་ནི་གསར་སྐྲུན་ཅིག་རེད་ཅེས་དང་།",
    "ཆའོ་ཀྲི་ཐང་མུའུ་སན་གྱིས་གདོད་མའི་དུས་སྐབས་སུ་མི་རྣམས་ཀྱིས་ཐུན་མོང་གི་ངལ་རྩོལ་ཁྲོད་དུ་བྱུང་བའི་འགྲོས་རིམ་དང་ལྡན་པའི་བྱ་བ་དེར་གྲུབ་ཆ་གཉིས་ཡོད་དེ།",
    "ལུས་ཀྱི་གྲུབ་ཆ་དང་ངག་གི་གྲུབ་ཆ་རེད།",
    "སྔ་མ་འཕེལ་རྒྱས་སུ་སོང་བས་ཟློས་གར་དང་ཕྱི་མ་དེ་འཕེལ་རྒྱས་སུ་སོང་བས་སྐད་ཆ་བྱུང་བ་རེད།",
    "གླུ་སྙན་རྩོམ་ཡི་སྐད་ཆ་དང་སྤྱིར་བཏང་གི་སྐད་ཆ་བྱུང་བ་རེད་ཅེས་གླུ་ཡི་བྱུང་བ་བརྗོད་པ་ཞེས་པར་གསུངས།",
    "ང་ཚོས་ཤེས་གསལ་ལྟར།",
    "ཡི་གེ་བྱུང་རྗེས་ཡིག་ཐོག་གི་སྙན་རྩོམ་བྱུང་བ་དང་།",
    "རིམ་གྱིས་གླུ་པ་དང་སྙན་ངག་མཁན་དང་སྙན་ངག་དཔྱད་བརྗོད་མཁས་ཅན་རྣམས་བྱུང་བ་རེད།",
    "གྲངས་ཚད་དང་སྤུས་ཚད་གང་གི་ཆ་ནས་ཀྱང་རྩོམ་རིག་གི་རྩོམ་ལུས་གཞན་གྱི་མདུན་གྲལ་ལ་སླེབས་ཡོད།",
    "བཙན་སྦྱོར་ཨུ་ཚུགས་མིན་པར་རང་བཞིན་ངང་གིས་གྲུབ་པའི་དབྱངས་འགྲོས་ཀྱི་ཉམས་འགྱུར་མངོན་གསལ་དོད་པོ་ཞིག་དགོས།",
    "དེའི་ཁྲག་རྒྱུན་ཡལ་མེད་རྒྱུན་ཆགས་སུ་རྒྱུག་བཞིན་ཡོད་པས་རེད།",
    "རང་མོས་སྙན་རྩོམ་ཡིན་ན་སྐས་རིམ་འབེབས་སྟངས་སོགས་རྩོམ་པ་པོའི་ཤུགས་དྲག་པའི་ཚོར་འདུའི་འཕེལ་རིམ་མཚོན་ཐུབ་པ་སྟེ།",
    "སྙན་རྩོམ་ལ་ཤུགས་དྲག་པའི་ཚོར་འདུ་མེད་ན་དེ་བས་ཀྱང་དེ་འདྲ་རེད།",
    "ཐོས་བརྩོན་ཤེས་རབ་ཅན་གྱི་ཉམ་ཆུང་གི་ཁ་སྟབས།",
    "སྲོལ་རྒྱུན་གྱི་སྙན་རྩོམ་དང་རང་མོས་ཀྱི་སྙན་རྩོམ་གཉིས་སོ།",
    "ཚིག་རྐང་རེ་རེའི་ཚིག་འབྲུ་ཆ་མཉམ་པ་གང་ཞིག་ལ་ཆ་གྲངས་དང་ཡ་གྲངས་ཀྱི་གནས་གཅིག་མཚུངས་ཡིན་པ།",
