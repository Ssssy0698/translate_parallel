    "རྦབ་ཆུའི་ལང་ཚོ་ལ་ཡལ་བ་མེད་ཅིང་།",
    "ལང་ཚོའི་རྦབ་ཆུ་ནི་དེ་བས་ཀྱང་ཉམས་པ་མེད།",
    "འདི་ནི་བོད་གངས་ཅན་གྱི་གཞོན་རབས་རྣམས་ཀྱི་ངག་ལས་བྱུང་བའི་ལང་ཚོའི་རྦབ་ཆུ་རེད།",
    "འདི་ནི་བོད་གངས་ཅན་གྱི་གཞོན་ནུ་རྣམས་ཀྱི་སེམས་ན་འབབ་པའི་ལང་ཚོའི་རྦབ་ཆུ་རེད།",
    "རང་མོས་སྙན་རྩོམ་གྱི་རྣམ་པར་བརྩམས་པ་ཞིག་ཡིན།",
    "ཚིག་གི་དངོས་ཤུགས་ཅི་རིགས་ནས་སྤྲོ་བའི་རྦབ་ཆུ་ཆིལ་ཆིལ་དུ་འབབ་ཞིང་།",
    "བརྩེ་དུང་གི་ཟེགས་མ་རྒྱུན་ཆད་མེད་པར་ཕྱོགས་བཞིར་འཐོར་བ།",
    "༣རང་མོས་སྙན་རྩོམ་གྱི་རྩོམ་སྲོལ་དེ་ལོ་རབས་བརྒྱད་ཅུ་ཡི་ནང་བོད་ཀྱི་རྩོམ་རིག་གར་སྟེགས་ཐོག་གཞི་ནས་གསར་དུ་ཐོན་པ་ཞིག་ཡིན་ཞེས་ན་འཐད་དམ།",
    "སྤྱིར་ལྷུག་རྩོམ་ཞེས་པ་ནི་རང་རེའི་བོད་ཀྱི་སྲོལ་རྒྱུན་གྱི་གོ་བ་ལེན་ཚུལ་ལྟར་ན་ཚིགས་བཅད་ལྷུག་སྤེལ་མ་གསུམ་གྱི་ཡན་ལག་ཏུ་གྱུར་པའི་ཚིག་ལྷུག་མར་འབྲི་བའི་རྩོམ་མཐའ་དག་ལ་ཟེར་བ་ཡིན་ཏེ།",
    "དེས་ན་ལྷུག་རྩོམ་ནི་རང་རེ་བོད་ལ་མཚོན་ན།",
    "ཉེ་བའི་ལོ་འགའི་ནང་བྱུང་བའི་རྩོམ་རིག་གི་ལུས་ཤིག་ཡིན་ལ།",
    "ཉེ་བའི་ལོ་འགའི་ནང་གསར་རྩོམ་བྱས་པའི་ལྷུག་རྩོམ་དག་གི་ནང་དུ།",
    "རྩ་འགྲེལ་སྣ་ཚོགས་སོགས་ལ་གོ་རྒྱུ་ཡོད་མོད།",
    "ང་ཚོས་འདིར་བརྗོད་པའི་ལྷུག་རྩོམ་ནི་སྙན་རྩོམ་དང་བརྩམས་སྒྲུང་།",
    "ཡིན་ནའང་ང་ཚོས་ཤེས་དགོས་པ་ཞིག་ནི་སྙན་རྩོམ་དང་བརྩམས་སྒྲུང་།",
    "སྙན་རྩོམ་དང་བསྡུར་ན་ལྷུག་རྩོམ་ལ་ཚིགས་སུ་བཅད་པའི་དབྱངས་ཀྱི་འདེགས་འཇོག་གི་འགྱུར་ཁུག་དང་སྒྲ་སྦྱོར་སོགས་ཀྱི་རྣམ་གཞག་མི་ངེས་ལ།",
    "ཡ་གིའི་ཇོ་མོ་གླང་མ་དང་མ་གིའི་ཡར་ཀླུང་གཙང་པོ།",
    "དཔྱད་བརྗོད་ལྷུག་རྩོམ་བཅས་གསུམ་མོ།",
    "བརྩམས་སྒྲུང་གིས་ཆ་ཚང་བའི་མི་སྣའི་གཟུགས་བརྙན་གསར་བཟོ་བྱས་པ་ལ་བརྟེན་ནས་འཚོ་བ་མཚོན་པ་དང་དོན་བརྗོད་ལྷུག་རྩོམ་ལ་ཆ་ཚང་བའི་མི་སྣའི་གཟུགས་བརྙན་དང་གཏམ་རྒྱུད་ཀྱི་བྱུང་རིམ་མེད་པར་དོན་རྐྱེན་ཕྲན་བུ་ཞིག་གམ་ཆ་ཤས་ཤིག་ལ་བརྟེན་ནས་འཚོ་བ་མཚོན་པའམ་མྱོང་ཚོར་མཚོན་པ་ཡིན་ནོ།",
    "རང་གྲོལ་གྱི་རྐང་ལམ་ཕྲ་མོ་༨༤ལོའི་སྦྲང་ཆར་དེབ་གསུམ་པ་ཞེས་པ་ནི་ཕུལ་དུ་བྱུང་བའི་དོན་བརྗོད་ལྷག་རྩོམ་ཞིག་ཡིན་ལ།",
    "རྩོམ་པ་པོས་རྐང་ལམ་ཕྲ་མོ་དེར་བརྩེ་དུང་ཟབ་མོ་ཞིག་བཅངས་ཏེ་རྐང་ལམ་དེའི་ནུས་པ་དང་།",
    "རྐང་ལམ་ཕྲ་མོ་དེ་ནི་རང་བྱུང་གི་རྐང་ལམ་ཕྲ་མོ་ཞིག་མ་ཡིན་པར་མཁྱེན་རྩལ་དང་འཇོན་ཐང་ལྡན་པའི་གངས་ཅན་མེས་པོ་རྣམས་ཀྱིས་དཀའ་བ་བརྒྱ་ཕྲག་ལས་ཐོག་མར་གསར་ཏུ་བསྐྲུན་པའི་སྔོན་ཐོན་མཆོག་གྱུར་གྱི་རི་རྩེར་བསྙེགས་པའི་ལམ་ཞིག་ཡིན་པ་ངོ་སྤྲོད་ནན་པོ་བྱས་མཐར།",
    "ཁྱོན་ཇེ་ཡངས་སུ་གཏོང་མ་ཐུབ་པར་ད་ལྟའི་བར་དུ་ལུས་ནས་དུས་རབས་ཀྱི་འཕོ་འགྱུར་དང་འགལ་བ་ཆེན་པོར་གྱུར་པ་བསྟན་ཏེ།",
    "ང་ཚོའི་རྗེས་རབས་པ་རྣམས་ལ་རྐང་ལམ་ཕྲ་མོ་དེར་མཐོང་ཆེན་དང་དོ་སྣང་བྱེད་དགོས་པའི་གསལ་འདེབས་དྲག་པོ་བྱས་ཐོག་རྐང་འམ་ཕྲ་མོ་དེ་གསར་གཏོད་བྱེད་རྒྱུ་ནི་ཁ་ཚ་དགོས་གཏུགས་ཡིན་པའི་བརྗོད་བྱ་གཙོ་བོ་འབུར་ཐོན་ཏུ་བརྗོད་དེ་གསོན་ཉམས་ལྡན་ཞིང་ནང་དོན་རྒྱ་ཆེ་བའི་དོན་བརྗོད་ལྷུག་རྩོམ་གྱི་མ་དཔེ་ཞིག་ཏུ་གྱུར་ཡོད།",
    "ལྷ་རྩེ་ས་ཆའི་སྐྱེ་བོ་ཕོ་མོ་རྒན་གཞོན་ཐམས་ཅད་ཀྱིས་ལུས་ལ་མཛེས་པའི་གོས་གྱོན་ཞིང་།",
    "མི་རེ་རེའི་སེམས་ལ་དད་པ་དང་གུས་པ།",
    "དགའ་བ་དང་རེ་བ་ཆེན་པོ་བཅངས་ཤིང་།",
    "ལག་ཏུ་ཁ་བཏགས་དང་བདུག་སྤོས་བཟུང་ནས་གྲག་འགུལ་མེད་པར་མདུན་ཕྱོགས་ཀྱི་ལམ་སྣེར་ཅེར་འདུག་ད་ནི་ཁོ་ཚོས་ཡུན་རིང་ལ་རེ་སྨོན་བྱས་པའི་དུས་ཚོད་དེ་སླེབས་གྲབས་ཡོད་པས།",
    "འཚང་ཁ་ཤིག་ཤིག་གིས་འཇེབ་འཁོར་ལ་དམིགས་ཏེ་ཞོགས་སོང་།",
    "ཁོང་གི་སྐུ་ལ་ཐེར་མ་རྒྱ་སྨུག་གི་ན་གཟའ་གསོལ་ཞིང་།",
    "བརྟན་ཞིང་བརླིང་བའི་ངང་ནས་འཇེབ་འཁོར་གྱི་གམ་དུ་བཞེངས་ཏེ་མཇལ་བསུ་བྱེད་དུ་འོངས་པའི་མི་ཡོངས་ལ་གཟིགས།",
    "མི་རེ་རེའི་མིག་མཐར་དགའ་བའི་མཆི་མས་གང་བཞིན་རིན་པོ་ཚེའི་ཞལ་གྱི་དཀྱིལ་འཁོར་ལ་ཞིབ་ཏུ་མཇལ།",
    "ཁོང་གི་ཞལ་རས་ལ་འཛུམ་མདངས་བཀྲ་ཞིང་བྱམས་བརྩེ་ལྡན་པ་དང་བརྟན་ཞིང་བརླིང་བའི་གོམ་པ་རེ་རེ་སྤོས་ནས་དལ་བ་དལ་བུར་མི་ཚོགས་ཁྲོད་དུ་ཕེབས་ཤིང་།",
    "མགོ་སྒུར་ལྕེ་བསྣར་གྱི་ངང་ནས་བསྒུགས་འདུག་པའི་མགར་བ་རྡོ་རྗེ་འཚབ་འཚུབ་ཀྱིས་རིན་པོ་ཚེའི་སྐུ་མདུན་དུ་སོང་ནས་མཇལ་དཪ་མགོ་བོའི་གོང་དུ་བཏེགས་ནས་ཕུལ།",
    "ང་ཚོ་ཚང་མ་འདྲ་མཉམ་རེད་ཅེས་བྱམས་བརྩེ་ལྡན་པའི་ངང་ནས་གསུངས་པ་དང་།",
    "ཡུད་ཙམ་ལ་ཕྱག་ཟུང་མགར་བ་རྡོ་རྗེའི་ལག་པར་འཇུས་ཤིང་སྤྱན་གྱིས་མཐའ་འཁོར་གྱི་མི་རེ་རེའི་གདོང་ལ་གཟིགས།",
    "ཁོང་གི་ཞལ་རས་ནི་གཟབ་ནན་དང་བག་ཕེབས།",
    "ཅི་འདྲའི་རྟོགས་དཀའ་བའི་དོན་ཞིག་རེད་ཨང་།",
    "དེར་ཡོད་ཀྱི་མི་རེ་རེའི་སེམས་སུ་ཐེ་ཚོམ་དང་དོགས་པའི་མདུད་པ་འགྲོལ་བར་དཀའ་བ་རེ་མདུད་སོང་།",
    "དེ་ནི་ཁོང་གིས་དོན་གལ་ཆེན་ཞིག་ལ་ཐུགས་གཞིག་ཟབ་མོ་གནང་བའི་རྗེས་སུ་རྦད་དེ་ཐག་གཅོད་གནང་བ་འདྲ།",
    "ཁོ་ཚང་གི་འཚོ་བའི་ཆ་རྐྱེན་ཇེ་བཟང་དུ་སོང་སྟེ་ས་ཆ་འདིའི་ཕྱུག་འགྱུར་གྱི་མིག་དཔེ་རུ་གྱུར།",
    "མགར་བ་རྡོ་རྗེ་ཡིས་བརྡུངས་པའི་ཡོ་ཆས་ལ་ཉེ་འཁོར་མང་ཚོགས་ཀྱིས་དགའ་བསུ་ཆེན་པོ་བྱེད་ལ།",
    "པཎ་ཆེན་རིན་པོ་ཚེས་གནས་ཚུལ་དེ་གསན་མ་ཐག་སྐུ་དངོས་སུ་མགར་བ་རྡོ་རྗེའི་ཁྱིམ་དུ་འཚམས་འདྲིར་ཕེབས་རྒྱུའི་ཐག་གཅོད་གནང་བ་རེད།",
    "མགར་བ་རྡོ་རྗེ་ཚང་གི་ཁང་པ་ནི་གསར་དུ་ཕུབ་པ་ཞིག་ཡིན་ཞིང་།",
    "དུས་རབས་འགྱུར་ཟིན་པ་རེད།",
    "ང་ཚོ་ཚང་མ་འདྲ་མཉམ་ཡིན་པས་མཆོག་དམན་གྱི་དབྱེ་བ་གཏན་ནས་ཡོད་པ་མ་རེད་ཅེས་གསུངས་པ་དང་།",
    "ཁོང་གིས་དེ་སྐད་དུ་གསུངས་དུས་སྤྱན་རས་ལས་བྱམས་དང་བརྩེ་བའི་འོད་མདངས་འཚེར་ནའང་ཞལ་རས་ཀྱི་རྣམ་པ་ནི་ཧ་ཅང་གཟབ་ནན་ཡིན།",
    "འདི་ནི་ཁོང་གིས་མགར་བ་རྡོ་རྗེ་ལ་གསུང་ས་པ་ཡིན་ལ།",
    "དེར་ཡོད་པའི་མི་ཐམས་ཅད་ལ་གསུངས་པའང་རེད།",
    "ཁོང་གིས་མི་རྣམས་ཀྱི་ཕྱུག་འགྱུར་གྱི་བློ་སྒོ་འབྱེད་པའི་ཆེད་དུ་རྒྱའི་ཞིང་པས་ལག་ཡས་ཀྱིས་སོ་ནམ་ལས་ཀ་དམ་འཛིན་བྱེད་པ་དང་།",
    "ཁོང་གིས་ཚང་མར་གཟིགས་ཏེ་ཞིང་ལས་ཁོ་ནར་མགོ་འཁོར་ནས་བསྡད་ན་ནམ་ཡང་ཕྱུག་པོར་འགྱུར་མི་སྲིད་ཅེས་གསུངས་ནས་མི་རྣམས་ཀྱི་བློ་སྒོ་ཕྱེས་གནང་ཞིང་ཚང་མས་ཁོང་གི་བཀའ་སློབ་སེམས་ལ་དམ་པོར་བཅངས།",
    "ཞིང་བར་ལོ་ཡག་བྱུང་བ་གཟིགས་ནས་ཐུགས་དགྱེས་པའི་ངང་ནས་དབུ་ལྕོག་ལྡེམ་ལྡེམ་དང་ཞལ་རས་འཛུམ་འཛུམ་གནང་།",
    "ཁོང་གིས་ཐུགས་ཞིབ་མོས་མགར་བ་རྡོ་རྗེས་བཟོས་པའི་གྲི་དང་ཟོར་བ།",
    "འཇུ་སྐལ་བཟང་གིས་བརྩམས་པའི་འབྱོར་ཕྱུག་ལྡན་པའི་མགོ་ལོག་ལ་བསྟོད་པ་དང་ལྷ་རྒྱལ་ཚེ་རིང་གིས་བརྩམས་པའི་མདུན་སྐྱོད་ཀྱི་གོམ་སྒྲ་ལྟ་བུ་ཡིན་ནོ།",
    "ངས་ཀྱང་དལ་མོར་ལྭ་རིང་གཡང་ཤམ་བྱས་ཏེ་སྒོ་གླེགས་འཐེན་ནས་ཕྱིར་བུད།",
    "མཚན་མོར་དེ་བས་ཀྱང་དབེན་ཞིང་ཁུ་སིམ་མེར་གནས།",
    "ཟླ་འོད་མེད་པའི་མཚན་མོར་འམ་ཕྲན་འདི་ནག་རོག་གེར་སྐྱི་གཡའ་བ་ཞིག་འདུག་དོ་ནུབ་ཀྱང་ཟླ་འོད་མོག་མོག་ཏུ་སྣང་མོད་ནམ་རྒྱུན་ལས་ཅུང་ལེགས་པར་སྣང་།",
    "བདག་ནི་འདུ་འཛི་ལ་དགའ་ཞིང་ལྷིང་འཇགས་ལ་མོས།",
    "ད་ནི་པད་མའི་དྲི་བསུང་དང་ཟླ་བའི་འོད་སྣང་གི་དཔལ་ལ་ཅི་དགར་རོལ་ཆོག་གོ།",
    "ཆུ་ཁར་བུད་པའི་ལོ་འདབ་མཐོན་པོ་དག་ནི་སྒེག་ལྡན་གར་མའི་སྨད་ཤམ་གཡོ་བ་དང་ཀུན་ནས་མཚུངས་ཤིང་།",
    "བཀྲག་མདངས་བཀྲ་བའི་མུ་ཏིག་གི་རྡོག་པོ་རེ་རེ་དང་འདྲ་ལ་སྔོ་བསངས་ཀྱི་ནམ་མཁའི་སྐར་ཚོགས་དང་ཡང་དག་མཚུངས།",
    "བསིལ་བའི་དྲི་བཞོན་དང་འགྲོགས་ནས་ཁྱབ་པའི་དྲི་བསུང་ནི་ཐག་རིང་གི་ཁང་བརྩེགས་མཐོན་པོ་ལས་མཆེད་པའི་སྙན་འཇེབས་གླུ་དབྱངས་ཀྱི་རྗེས་སུ་རྐང་པ་འཇོག་དེའི་ཚེ་ལོ་འདབ་དང་མེ་ཏོག་རྣམས་འདར་ཡོམ་ཕྲན་བུ་ཞིག་བྱས་ཤིང་གློག་འགྱུ་བ་ཇི་བཞིན་སྐད་ཅིག་ལ་མཚེའུའི་ཚུ་རོལ་ནས་ཕ་རོལ་དུ་རྒྱུགས་ཤིང་།",
    "ཁ་དོག་གི་མཛེས་རྗེས་སྡུག་སྣང་ཡུལ་དུ་མ་གྱུར་ཡང་ལོ་འདབ་དག་ལ་མཛེས་སྡུག་གི་ལང་ཚོ་སྔར་བས་འབར།",
    "ན་བུན་སྲབ་མོ་ཞིག་མཚེའུའི་ངོགས་སུ་འཕྱོ།",
    "གཉིད་ཐུན་བུ་ཡིས་ཀྱང་ཐུན་མོང་མ་ཡིན་པའི་བདེ་བ་སྦྱིན་ཐུབ་པ་བཞིན་ནོ།",
    "ཟླ་འོད་ལྗོན་ཤིང་གི་གསེབ་ནས་ཚུར་འཕྲོས་ཏེ་མཐོ་སར་སྟུག་པོར་རྒྱས་པའི་ཤིང་ཕྲན་གྱི་ཆ་མི་མཉམ་པའི་གྲིབ་མ་ས་ལ་ཕོག་ཅིང་།",
    "མཉེན་པའི་ལྕུག་ཕྲན་ཐུར་དུ་དཔྱངས་པའི་རྒྱ་ལྕང་གི་གྲིབ་བརྙན་པད་མའི་ལོ་འདབ་ཀྱི་སྟེང་དུ་རི་མོ་བྲིས་པ་བཞིན་ཤར།",
    "པད་མའི་མཚེའུའི་ཕྱོགས་བཞིའི་ཉེ་རྒྱང་གང་སར་ལྗོན་ཤིང་གིས་ཡོངས་སུ་བཏུམས་པ་ལས་མང་ཆེ་ཤོས་ནི་རྒྱ་ལྕང་ཡིན།",
    "ལྗོན་ཤིང་དེ་དག་གིས་མཚེའུ་དེ་ཕྱི་རིམ་ནང་རིམ་དུ་ཡོངས་སུ་བསྐོར་ཅིང་དམ་པོར་སྦྲེལ།",
    "སྐབས་འདིར་ཆེས་སྤྲོ་བ་བརྟས་པ་ནི་བགྲང་དུ་ཡས་པའི་སྡོང་མགོའི་འབུ་འུར་བའི་སྒྲ་དང་ཆུ་ནང་གི་སྦལ་སྐད་ཡིན།",
    "ཕལ་ཆེར་གནའ་སྔ་མོ་ནས་དར་ཞིང་རྒྱལ་རབས་དྲུག་གི་དུས་སུ་འཕེལ་རྒྱས་ཆེ་བའི་ཚུལ་སྙན་ངག་ལས་རགས་ཙམ་ཤེས་ཐུབ།",
    "འདི་ཡིས་བདག་གི་སེམས་སུ་འབྲི་ཆུའི་ལྷོ་རྒྱུད་དེ་བོར་མེད་དམ་དུ་བཅངས་ཡོད་པ་ཤེས།",
    "ནང་དུ་གྲག་འགུལ་ཅི་ཡང་མེད་པར་འཇམ་ཐིང་ངེར་གནས་ཤིང་བཟའ་ཟླ་སྔ་མོ་ནས་གཉིད་ཀྱི་ཞིང་ཁམས་སུ་འགྲིམས་ཟིན།",
    "དེ་ནི་དཔྱད་རྩོམ་དང་ཐག་ཉེ་ནའང་དཔྱད་རྩོམ་བཞིན་ཐད་ཀར་གནས་ལུགས་མི་བརྗོད་པར་བྱེ་བྲག་གི་སྒྱུ་རྩལ་གཟུགས་བརྙན་ལ་བརྟེན་ནས་ད་པྱད་གཏམ་བརྗོད་པ་ཞིག་ཡིན་པས་ན།",
    "ལྷུག་རྩོམ་ཞིག་བློས་བསླངས་བྱེད་སྐབས་རྒྱུན་མཐོང་གི་སྐུད་སྣེ་ལ་གཤམ་གསལ་གྱི་རིགས་དག་མཆིས་ཏེ།",
    "ང་ཚོས་ངེས་པར་དུ་འཚོ་བར་རྟོག་ཞིབ་དང་མྱོང་ཞིབ་བྱ་རྒྱུ་གལ་ཆེར་འཛིན་དགོས་པ་མ་ཟད།",
    "ལིའུ་དཔེ་ཡུས་ཀྱིས་རྒྱ་བསྐྱེད་དང་རྩོམ་རིང་འབྲེལ་ཆགས་ཀྱིས་མཚོན་པར་བྱས་སྟབས་ཚང་མས་རྩོམ་པ་པོ་རང་རང་གི་རང་གཤིས་དང་དམིགས་བསལ་གྱི་མཛེས་རྟོག་གི་ཚོར་ཤེས་མཚོན་པར་བྱས་ཡོད་པས་རྟོགས་ནུས་སོ།",
    "གྲངས་ཚད་དང་སྤུས་ཚད་གང་གི་ཆ་ནས་ཀྱང་ཕྱི་རྒྱལ་དང་རྒྱ་ནག་གི་རྩོམ་རིག་གསར་རྩོམ་གྱི་རྗེས་སུ་ལུས་ཡོད་པ་ནི་དོན་དངོས་ཤིག་ཡིན།",
    "རྩོམ་པ་པོ་དང་ཀློག་པོའི་དཔུང་ཁག་གང་གི་ཆ་ནས་ཀྱང་སྟོབས།",
    "ང་ཚོས་དེ་དག་གི་ཐོག་ནས་དབྱེ་ཞིབ་ཅིག་བྱས་ཚེ།",
    "བརྩམས་སྒྲུང་གི་རྩ་བའི་རྒྱུ་རྐྱེན་ཏེ།",
    "ང་ཚོས་ཤེས་དགོས་པ་ཞིག་ལ།",
    "བརྩམས་སྒྲུང་གི་རིགས་གང་ཡིན་ནའང་།",
    "བརྩམས་སྒྲུང་གི་འབྱུང་ཁུངས་ཀྱང་དེ་ལས་མ་འདས་མོད།",
    "མིའི་རིགས་ཀྱི་ཐུན་མོང་དུ་ངལ་རྩོལ་བྱས་རྗེས་ལུས་ངལ་ཞིང་སེམས་དུབ་པ་ན།",
    "རྩོམ་པ་པོ་དང་རྩོམ་རིག་མཁས་ཅན་དེ་དག་གིས་སྔར་ཡོད་ཀྱི་གཏམ་རྒྱུད་དམ་ལྷ་སྒྲུང་ལ་སྒྱུ་རྩལ་གྱི་ལས་སྣོན་བྱས་ཏེ།",
    "བརྩམས་སྒྲུང་ལས་དར་ཅུང་སྔ་བའི་ལྷུག་རྩོམ་བཟང་པོའི་རྩོམ་གཤིས་ལེགས་པོ་ཞིག་གིས་རྨང་གཞི་བྱས་པའི་སྟེང་།",
    "བོད་ཀྱི་དམངས་ཁྲོད་གཏམ་རྒྱུད་དང་རྒྱ་གར་གྱི་དམངས་ཁྲོད་གཏམ་རྒྱུད་མང་པོ་ཞིག་གིས་ཀྱང་བོད་ཀྱི་རྩོམ་ལུས་འདིའི་འཕེལ་རྒྱས་ལ་འཚོ་བཅུད་བཟང་པོ་བྱིན་ཡོད་དེ།",
    "སྙན་རྩོམ་ནི་མི་རྣམས་ཀྱིས་རང་བྱུང་ཁམས་ནང་རང་ཉིད་ཀྱི་འཚོ་གནས་ཀྱི་ཕྱིར་ཐུན་མོང་དུ་ངལ་རྩོལ་སོགས་བྱེད་པའི་བརྒྱུད་རིམ་ནང་གོམ་འགྲོས་སོགས་དོ་མཉམ་ཡོང་ཕྱིར་གསར་གཏོད་བྱས་པ་ཞིག་ཡིན་ན།",
    "འཚོ་བའི་ནང་གི་དྲང་ཕྱོགས་དང་ལྡོག་ཕྱོགས་ཀྱི་མི་སྣའི་གནས་ཚུལ་དག་ཇི་མ་ཇི་བཞིན་མཚོན་བྱེད་དུ་རིམ་བཞིན་དར་འཕེལ་བྱུང་བ་རེད།",
    "བསམ་བློ་དང་སྒྱུ་རྩལ་གང་གི་ཆ་ནས་ཀྱང་གཏིང་ཇེ་ཟབ་དང་།",
    "བརྩམས་སྒྲུང་རིང་ཐུང་ཅི་འདྲ་ཞིག་ཡིན་ཡང་དེ་གསུམ་ངེས་པར་དུ་ཚང་དགོས་པས་ན་དེ་དག་ནི་བརྩམས་སྒྲུང་གི་རྩ་བའི་གྲུབ་ཆར་བཤད།",
    "མི་སྣ་ནི་བརྩམས་སྒྲུང་གི་གྲུབ་ཆ་གལ་ཆེ་ཤོས་དེ་ཡིན་ཞིང་།",
    "བརྩམས་སྒྲུང་ལ་ལར་ཕར་བལྟས་ཚོད་ཙམ་ལ་སྲོག་ཆགས་ཙམ་ལས་མི་སྣ་དངོས་རྩ་བ་ནས་མེད་མོད།",
    "རྫ་ཙིག་གི་གཏམ་རྒྱུད།",
    "བྱུང་རིམ་ནི་དོན་རྐྱེན་བརྗོད་པ་ཞིག་ཡིན་མོད།",
    "ང་ཚོས་དཔེ་ཞིག་བཞག་ནས་ཞུས་ན།",
    "རྒྱལ་པོ་གྲོངས་སོང་།",
    "དེ་ནས་རྒྱལ་ཡུམ་ཡང་གྲོངས་སོང་།",
    "ཡང་རྒྱལ་པོ་གྲོངས་སོང་།",
    "རྒྱལ་ཡུམ་ཡང་སེམས་སྡུག་གིས་མནར་ནས་གྲོངས་སོང་།",
    "ང་ཚོས་རྒྱལ་པོ་གྲོངས་པའི་གནས་ཚུལ་དེའི་ཐད།",
    "དེ་ནས་ག་རེ་བྱུང་ཞེས་དྲིས་ཚེ་གཏམ་རྒྱུད་རེད།",
    "དེ་ནི་བརྩམས་སྒྲུང་ནང་གི་བྱུང་རིམ་དང་གཏམ་རྒྱུད་ཀྱི་རྩ་བའི་ཁྱད་པར་ཡིན་པ་གསལ་པོ་ཤེས་དགོས་སོ།",
    "སྐབས་རེ་ཐག་གཅོད་རང་བཞིན་གྱི་ནུས་པའང་ཐོན་གྱི་ཡོད་པའང་དོན་དངོས་ཤིག་ཡིན།",
    "བརྩམས་སྒྲུང་ནང་མི་སྣའི་གཟུགས་བརྙན་གསར་བཞེངས་ཀྱིས་མི་སྣ་གང་དེའི་ཐུན་མོང་མ་ཡིན་པའི་རང་གཤིས་གྲུབ་པ་བྱེད་ཅིང་།",
    "བརྩམས་སྒྲུང་གི་བྱ་བའི་བྱུང་རིམ་ཞིབ་ཕྲས་འབྲི་དགོས་ན།",
    "ཕུན་སུམ་ཚོགས་ལ་རང་གཤིས་མངོན་གསལ་དོད་ཅིང་ཐུན་མོང་མ་ཡིན་པ་ཞིག་དང་།",
    "སྒྲུང་གི་བྱུང་རིམ་ཆ་ཚང་ལ་ཞིབ་ཕྲ་ཚ་བ།",
    "བརྩམས་སྒྲུང་གི་ནང་གསེས་དབྱེ་བ་ཕྱེ་ཚུལ་ཐད་ཅུང་རྙོག་དྲ་ཆེ་ཙམ་དང་བཞེད་པ་མང་ཙམ་ཡོད་དེ།",
    "ཕོ་མོའི་བརྩེ་དུང་མཚོན་པའི་བརྩམས་སྒྲུང་།",
    "ཚན་རིག་འཕྲུལ་སྣང་གི་བརྩམས་སྒྲུང་སོགས་ཤིན་ཏུ་མང་པོ་ཡོད་ལ།",
    "འཕྲིན་ཡིག་གི་རྣམ་པར་བྲིས་པའི་བརྩམས་སྒྲུང་།",
    "གཏམ་གླེང་གི་རྣམ་པར་བྲིས་པའི་བརྩམས་སྒྲུང་སོགས་མང་པོ་ཡོད་མོད།",
    "དེང་སྐབས་རྩོམ་རིག་རིག་པའི་གཞུང་ལུགས་ནང་ཕལ་ཆེ་བས་བརྩམས་སྒྲུང་གི་རིང་ཐུང་གི་ཚད་གཞི་གཞིར་བཞག་ནས་དབྱེ་སྲོལ་ཞིག་ཡོད་པ་དེ་སྤྱི་འགྲོས་ལྟ་བུར་གྱུར་ཡོད་དེ།",
    "བརྩམས་སྒྲུང་གི་ཡིག་འབྲུ་མང་ཉུང་དང་།",
    "འདིའི་གསར་རྩོམ་གྱི་བྱ་ཐབས་སོགས་ནི་ཚིག་ཉུང་བསྡུས་གསལ་གྱིས་ཕྱོགས་བསྡོམས་བྱ་ཐབས་བྲལ་བས་རེ་ཞིག་བཏང་སྙོམས་ལ་བཞག་གོ།",
    "སྒྲུང་གི་བྱུང་རིམ་ཡང་ཅུང་སྟབས་བདེ་ལ་རྙོག་དྲ་དེ་ཙམ་གྱི་ཆེན་པོ་མེད་པ་ཞིག་ཡིན།",
    "ང་ཚོས་འདིར་ཤེས་དགོས་པ་ཞིག་ལ་བརྩམས་སྒྲུང་འབྲིང་གྲས་ནི་བརྗོད་བྱའི་ནང་དོན་གྱི་རྒྱ་ཆེ་ཆུང་དང་མི་སྣ་མང་ཉུང་།",
    "སྒྲུང་རིང་ཞིག་ཐུང་དུ་བཏང་བ་དང་སྒྲུང་ཐུང་ཞིག་རིང་དུ་བཏང་བ་ཞིག་རྩ་བ་ནས་མིན་པར་དེ་ནི་བརྗོད་བྱའི་ནང་དོན་གྱིས་ཐག་བཅད་པ་ཞིག་ཡིན་པ་འདི་རེད།",
    "མའོ་ཏུན་གྱིས་རིང་གྲས་དང་ཐུང་གྲས་ནི་བརྩམས་སྒྲུང་གི་བྱུང་རིམ་སྟབས་བདེ་དང་རྙོག་འཛིང་ཡིན་མིན།",
    "འདི་ལ་ཡིག་འབྲུ་སྟོང་འགའ་ནས་ཁྲི་གཅིག་གཉིས་ནང་ཚོད་འཛིན་བྱེད་དགོས་པར་བཤད།",
    "ཚེ་རིང་དོན་གྲུབ་ཀྱིས་བརྩམས་པའི་ཟླ་འོད་འོག་གི་ཟློས་གར་ཞེས་པར་མཚོན་ན།",
    "ཟླ་འོད་འོག་གི་ཟློས་གར།",
    "ཁོང་གི་གཤིས་ཀ་ཧ་ཅང་བཟང་བ་སྟེ་ཕོ་མོ་རྒན་གཞོན་སུ་དང་ཐུག་ནའང་ངོ་གདོང་ནས་འཛུམ་མདངས་ཕྱུང་སྟེ་གུས་གུས་ཞུམ་ཞུམ་བྱེད་ངེས་ཡིན།",
    "དེ་རིང་ཁོ་ཁྲོམ་ལ་འགྲོ་སྐབས་རྒྱབ་ཕྱོགས་ནས་མི་ཞིག་གིས་ལོ་ལ་ཝང་ཧྲུའུ་ཅི།",
    "ངས་ཁྱོད་ཝང་ཧྲུའུ་ཅིར་འཁྲུལ་སོང་ཟེར་ནས་བསྐྱོད་དོ།",
    "དཔོན་པོ་དེ་ཚོ་སྐྱིད་པོ་གང་འདྲ་མ་རེད་དམ་ཟེར།",
    "ཁོང་ཚོ་ལ་སྐྱིད་སྡུག་གང་བྱུང་ན་ཡང་ང་ཚོར་འབྲེལ་བ་ཅི་ཡོད་ཟེར།",
    "མ་རེད།",
    "དེ་འདྲ་ཡིན་ནའང་ང་ཚོར་འབྲེལ་བ་ཅི་ཡོད།",
    "ཕར་སོང་།",
    "ཕར་སོང་།",
    "དེ་རང་རེད།",
    "རབ་བརྟན་ཞན་ཀྲང་ཡང་དུས་རྒྱུན་ང་ཚོའི་ཁྱིམ་ལ་ཡོང་བ་མིན་ནམ།",
    "ངས་བལྟས་ན་ཁྱོད་ཀྱིས་རབ་བརྟན་ཞན་ཀྲང་ལ་ཟུར་དུ་ཁ་བརྡ་ཞིག་བྱས་ན་ཟེར་ནས་སྔར་ལས་གཟབ་ནན་གྱི་ཚུལ་དུ་བསྡད་པས་མོས་ཀྱང་དེ་ལྟར་བྱེད་རྒྱུ་ཁས་བླངས།",
    "དེ་ལ་སྐྱོན་ཅི་ཡོད་ཆུང་མས་རབ་བརྟན་ཞན་ཀྲང་ས་ནས་ཕྱིར་ལོག་སྟེ་ཁོ་ལ་ཞན་ཀྲང་གིས་ཁྱོད་ལ་རེ་བ་ཆེན་པོ་ཡོད་ཚུལ་ཤོད་ཀྱི་འདུག་ཟེར་བས་གཅོད་པ་མཚན་གང་པོར་གཉིད་མ་ཁུགདེའི་ཕྱི་ཉིན་དགོང་ཟས་ཟོས་རྗེས་གཅོད་པས་ཆུང་མར་སླར་ཡང་རབ་བརྟན་ཞན་ཀྲང་སར་འགྲོ་དགོས་པའི་ཚུལ་བསྟན་རྗེས་ཁོ་རང་རྩེ་ཆུའི་ཁར་སྤྲོ་བསང་དུ་སོང་།",
    "ཁྱོད་ཁྱོད་ཀྱིས་ཆང་འཐུང་ངམ་ཞེས་གཅོད་པ་ཧ་ལས་ཏེ་ཆུང་མའི་གདོང་ལ་བལྟ་ཞོར་དུ་དེ་ལྟར་བཤད།",
    "ཁོ་ངོ་མ་མི་བཟང་པོ་ཞིག་རེད་འདུག་ཟེར་བས་གཅོད་པ་སེམས་འགུལ་ཧ་ཅང་ཆེན་པོ་ཐེབས་ནས་ཁྱོད་ནི་དེ་བས་ཀྱང་བཟང་ཟེར་ཏེ་ཆུང་མའི་མགྲིན་པར་དམ་པོར་འཁྱུད།",
    "ཡང་དེའི་ཕྱི་ཉིན་དགོང་ཟས་ཟོས་རྗེས་ཆུང་མས་རང་འགུལ་ངང་ཞན་ཀྲང་གིས་ལས་ཀ་དེའི་སྐོར་ལ་ད་རུང་ཞིབ་འཇུག་རེ་བྱེད་རྒྱུ་ཡོད་གསུང་བྱུང་ཟེར་ནས་ཕྱིར་བུད།",
    "ཡིན་ནའང་སྡོད་ཀྱིན་སྡོད་ཀྱིན་ཁོའི་སེམས་ལ་ཞན་ཀྲང་གིས་ངའི་དོན་དེར་ཞིབ་འཇུག་ཇི་ལྟར་གནང་གི་ཡོད་དམ་སྙམ་པའི་སེམས་འཚབ་འགོག་ཐབས་མེད་པ་ཞིག་སྐྱེས་ཏེ་སྒོར་བུད་པ་ན་ས་རུབ་ནས་འདུག་ལ།",
    "ཤར་རིའི་རྩེ་མོའི་ཟླ་བ་ནི་ཁ་སང་ལས་ཀྱང་ཉ་གང་བ་དང་དཀར་གསལ་ལེར་འདུག་ཨེ་མ།",
    "མཚན་མོའི་འཇིག་རྟེན་འདི་ཅི་འདྲའི་ཡིད་དུ་འོང་བ་ཞིག་རེད་ཨང་།",
    "ཞེས་གཅོད་པས་ཆིག་ལབ་རྒྱག་བཞིན་སེམས་ལ་དེ་ལས་ཀྱང་ཡིད་དུ་འོང་བའི་རེ་བ་ཞིག་བཟུང་སྟེ་རྦབ་རྡོ་འདྲིལ་བ་ལྟར་རབ་བརྟན་ཞན་ཀྲང་གི་སྒོ་ཁར་ཕྱིན།",
    "ལྷག་པར་དུ་ཁྱོད་གཉིས་ལ་ད་དུང་ཕྲུ་གུ་མེད་པས་བཟའ་ཚང་ཁ་བྲལ་བྱེད་རྒྱུར་ཅི་ཞིག་སྐྲག་ཅེས་བརྗོད་མཚམས་ཁོའི་ཆུང་མས་སྐད་གདངས་དམའ་མོས་གཙོ་བོ་ནི་ཁ་གཡར་ས་ཞིག་མ་རྙེད་ཟེར།",
    "སྒྲུང་གི་བྱུང་རིམ་ཆ་ཚང་མི་དགོས་པའམ་དགོས་པའི་ངེས་པ་མེད་དེ།",
    "མཛེས་ལྡན་ལང་ཚོའི་དཔལ་གྱིས་ཕྱུག་པའི་ཆུང་མ་ཞིག་རང་གི་ཁྱོ་བོར་ཤིན་ཏུ་བརྩེ་ཞིང་།",
    "ཁོ་མོའི་མི་ཚེའི་འཚོ་བ་ནི་ཞི་འཇམ་བདེ་སྐྱིད་ལྡན་པ་སྟེ།",
    "ཉིན་ལྟར་ཁྱོ་བོ་ལས་ཀ་གྲོལ་ནས་ནང་ལ་ལོག་ཡོང་དུས་ཁྱིམ་ཚང་ནང་ཆུང་མའི་དགའ་སྤྲོའི་གླུ་སྒྲ་དང་བདེ་སྐྱིད་ཀྱི་དགོད་སྒྲས་ཡོངས་སུ་ཁེངས་ནས་ཡོད།",
    "དེ་རིང་ང་ལ་ལག་རྟགས་ག་རེ་ཉོས་ཡོད།",
    "ཁྱིམ་ཚང་ནང་གི་དགའ་སྤྲོའི་གླུ་སྒྲ་དང་བདེ་སྐྱིད་ཀྱི་དགོད་སྒྲ་དེ་ཡང་སྟོན་མཇུག་གི་བུང་བ་རྒན་པོའི་ངང་ཚུལ་ལྟར་རིམ་བཞིན་མེད་པར་གྱུར།",
    "ངའི་བསམ་པར་ཁྱེད་ལས་ཁོར་སྡུག་བསྔལ་མྱོང་དུ་བཅུག་ན་བསམ་གྱི་འདུག་ཅེས་དེ་འདྲའི་ངང་ཆུང་མ་ལུའུ་ལེ་ཁེ་དང་མཉམ་དུ་ཕྱིན་སོང་།",
    "དེས་ང་ཚོའི་རྒྱུན་ལྡན་གྱི་འཚོ་བའི་ཁྲོད་ཐོན་དང་འཐོན་མུས་ཡིན་པའི་བྱ་སྤྱོད་ངན་པ་དང་སྣང་ཚུལ་སྐྱུག་བྲོ་བ་དེ་དག་ལ་བསུན་འབྱིན་ཤུགས་ཆེན་ཞིག་བྱས་ཡོད།",
    "དེ་ལས་ཀྱང་ང་ཚོས་དོ་སྣང་བྱ་དགོས་པ་ཞིག་ནི་མཇུག་འབྲས་དེ་བསམ་ཡུལ་ལས་འདས་པ་ཞིག་བསྡུས་ཏེ་ཀློག་པ་པོའི་སེམས་བསམ་པའི་ནང་ཆེས་ཟབ་པའི་བག་ཆགས་ཀྱི་རི་མོ་གསལ་པོ་ཞིག་འཇོག་ཐབས་བྱས་ཡོད།",
    "ང་ཚོར་བཞད་གད་ཀྱི་ཚོར་བ་ཞིག་སྦྱིན་རྗེས་གཏིང་ཟབ་པའི་བསམ་གཞིགས་ཀྱི་ཡུལ་ཞིག་ཀྱང་བཞག་ཡོད།",
    "༣ བརྩམས་སྒྲུང་གི་གྲུབ་ཆ་གསུམ་པོའི་འབྲེལ་བའི་ཐད་བགྲོ་གླེང་བྱ་དགོས།",
    "ཟློས་གར་དང་ཟློས་གར་རྩོམ་རིག་གི་སྐོར།",
    "བསྟན་པ་ཕྱི་དར་སྐབས་ས་པན་གྱིས་རོལ་མོའི་བསྟན་བཅོས་དང་ཟློས་གར་རབ་དགའི་འཇུག་པ་བརྩམས་ཤིང་།",
    "ཕྱིས་སུ་བོད་ལ་ཅོང་པོའི་ལྷ་མོ་ཚོགས་པ་དང་སྐྱོར་མོ་ལུང་གི་ལྷ་མོ་ཚོགས་པ་སོགས་བཙུགས་ནས་བོད་ཀྱི་ཟློས་གར་སྔར་ལས་དར་འཕེལ་ཕྱིན་ཡོད།",
    "བོད་ཀྱི་ལྷ་མོའི་ཟློས་གར་ལ་རོལ་ཆའི་རམས་འདེགས་ཉུང་ཞིང་རྔ་དང་སྦུབས་ཆལ་ཁོ་ནས་ཆོག་ལ།",
    "བོད་ལ་མཚོན་ན་བསྟན་པ་སྔ་དར་གྱི་སྐབས་སུ་བོད་ལ་བོད་རང་གི་མཁས་པས་མཛད་པའི་ཟློས་གར་གི་རྩོམ་རིག་ལྟ་ཅི་རྒྱ་གར་སོགས་མི་རིགས་གཞན་གྱི་ཟློས་གར་གྱི་རྩོམ་རིག་བོད་ལ་འགྱུར་བ་མེད་ཅིང་།",
    "བསྟན་པ་ཕྱི་དར་སྐབས་ཏེ་སྤྱི་ལོའི་དུས་རབས་བཅུ་གསུམ་ནང་གཞི་ནས་རྒྱ་གར་གྱི་ཟློས་གར་རྩོམ་རིག་ཀླུ་ཀུན་ཏུ་དགའ་བའི་ཟློས་གར་དང་འཇིག་རྟེན་ཀུན་ཏུ་དགའ་བའི་ཟློས་གར་གཉིས་བོད་སྐད་དུ་འགྱུར་མོད།",
    "ཐང་སྟོང་རྒྱལ་པོས་ལྷ་མོའི་ཟློས་གར་གསར་གཏོད་མཛད་སྐབས་ཟློས་གར་རྩོམ་རིག་ཡོད་མེད་མ་ཤེས་ཀྱང་ད་ཡོད་ཀྱི་དཔྱད་གཞིར་གཞིགས་ན།",
    "དེ་བཞིན་གླུ་གར་གཞུང་རྔམ་བརྗིད་ལྡན་པའི་རྡོ་རིང་དང་ཡིད་འཕྲོག་ལྷ་མོ་སོགས་མང་པོ་ཐོན་ཡོད་དོ།",
    "ཟློས་གར་དང་ཟློས་གར་རྩོམ་རིག་གི་གོ་དོན།",
    "ངག་གི་སྨྲ་བརྗོད་དུ་མ་ཡང་ཟློས་ཤིང་གར་བྱེད་པའམ་ཡང་ན་གར་སྟེགས་ཀྱི་སྣང་བརྙན་བཟོ་བཀོད་བྱ་རྒྱུ་དམིགས་ཡུལ་དུ་འཛིན་ཅིང་གར་མཁན་གྱི་འཁྲབ་རྩལ་ལྟེ་བར་འཛིན་པའི་རོལ་དབྱངས་དང་བྲོ་གར།",
    "ཟློས་གར་སྒྱུ་རྩལ་ནི་རྩོམ་རིག་དང་རི་མོ།",
    "ཟློས་གར་འཁྲབ་གཞུང་ནི་གར་སྟེགས་སྟེང་འཁྲབ་སྟོན་བྱེད་པར་དམིགས་ནས་བརྩམས་པའི་རྩོམ་རིག་གི་བསྟན་བཅོས་ཤིག་ཡིན་སྟབས་དེའི་བརྗོད་བྱ་བཀོལ་བར་བཀག་རྒྱ་ངེས་ཅན་ཡོད་དེ།",
    "ལྐོག་འགྱུར་གྱི་འདུ་ཤེས་ཁམས་ཁོ་ན་ཐད་ཀར་བརྗོད་མི་ཆོག་པར་ཕྱི་ལུས་ངག་གི་བྱ་སྤྱོད་ཀྱི་ཉམས་དང་རྣམ་འགྱུར་གྱི་ངང་ཚུལ་མཐའ་དག་འདུ་ཤེས་ཀྱི་རྣམ་པ་དངོས་ཡིན་པར་འཛིན་ནས་གཟུགས་སམ་སྣང་བརྙན་གྱི་རྣམ་པ་ཁོ་ན་ལ་བརྟེན་ནས་མཚོན་དགོས་པས་ན་ང་ཚོས་གཅིག་ནས་མི་སྣ་གཅིག་གམ་གཉིས་གཙོ་བོར་བཟུང་ནས་སྣང་བརྙན་གཅིག་བསྡུས་སུ་འབྲི་བ་དང་མི་སྣ་ཕལ་པ་དག་སྤོང་ཅི་ཐུབ་དགོས།",
    "མི་སྣའི་རང་གཤིས་གསལ་ཞིང་གཟིགས་མོ་བའི་ཡིད་ཀྱི་བརྟན་པ་འཕྲོག་ཐུབ་པ་དགོས་ན་ངེས་པར་དུ་མི་སྣ་གཅིག་སྡུད་ཅེས་པ་དགོས།",
    "གསུམ་ནས་ཟློས་གར་རྩོམ་རིག་གི་ཡུལ་ལྗོངས་ནི་བརྩམས་སྒྲུང་བཞིན་ཡུལ་ལྗོངས་འདྲ་མིན་སྣ་ཚོགས་ཀྱི་རྣམ་པའི་རིས་སུ་ཐོན་ནས་འབྲི་བཀོད་བྱེད་པའི་གོ་སྐབས་མེད་ལ།",
    "ངེས་པར་མི་སྣའི་སེམས་ཁམས་དང་གཤིས་ཀར་འབྲེལ་བ་དམ་པའི་ཡུལ་ལྗོངས་དཔེ་མཚོན་ཅན་རེ་གཉིས་ཙམ་བཀོད་ན་ལེགས་ཏེ།",
    "ཟློས་གར་རྩོམ་རིག་གི་སྐད་ཆར་ངེས་པར་དུ་རང་གཤིས་ཡོད་པ་དང་བྱ་བྱེད་ཉམས་འགྱུར།",
    "ཟློས་གར་འཁྲབ་གཞུང་ཁྲོད་ཀྱི་མི་སྣའི་སྐད་ཆ་ནི་འཁྲབ་གཞུང་ནང་གི་མི་སྣ་ཕན་ཚུན་གྱི་ཁ་བརྡ་དང་ཆིག་ལབ།",
    "གལ་ཏེ་དེ་ལྟར་མིན་པར་འཁྲབ་སྟོན་པས་གར་སྟེགས་སྟེང་ནས་དུས་ཡུན་རིང་པོ་ཙམ་ལ་ངག་གི་སྨྲ་བརྗོད་མེད་ཅིང་ངག་གི་སྨྲ་བརྗོད་དེ་དག་ལ་འགུལ་ཉམས་མེད་ན་ལྟད་མོ་བའི་མདུན་ལ་སྲོག་མེད་ཀྱི་འབག་སྐུ་ཞིག་བཞེངས་པ་ཙམ་ལས་ཉམས་དང་རང་གཤིས་ཀྱིས་ཕྱུག་པའི་འཚོ་བའི་ནང་གི་མི་སྣ་ཞིག་བཟོ་སྐྲུན་མི་ཐུབ་བོ།",
    "ཟློས་གར་གྱི་འགལ་འདུ་འདི་ལའང་ཕྱིའི་འགལ་འདུ་དང་ནང་གི་འགལ་འདུ་གཉིས་ཡོད་ལ།",
    "ཕྱིའི་འགལ་འདུ་ནི་མི་སྣ་སོ་སོའི་བར་རམ་ཡང་ན་མི་སྣ་དང་སྟོབས་ཤུགས་ཤིག་གི་བར་དུ་བྱུང་བའི་འགལ་བའམ་ཁ་འཐབ་དེ་ལ་ཟེར།",
    "ཟློས་གར་རྩོམ་རིག་གི་ནང་གསེས་དབྱེ་བ།",
    "གཏམ་བརྗོད་ཟློས་གར་ནི་སྐད་ཆ་གཙོ་བོར་འཛིན་པ་སྟེ་ངག་གི་སྨྲ་བརྗོད་མཚོན་བྱེད་ཀྱི་རྣམ་པའི་ཐབས་སུ་འཛིན་པའི་ཟློས་གར་བྱ་ལ་དེ་ནི་ད་ལྟའི་ཟློས་གར་ཁྲོད་ཀྱི་ཆེས་སྤྱིར་བཏང་གི་སྒྱུ་རྩལ་གྱི་རྣམ་པ་ཞིག་ཡིན།",
    "སྐྲ་དཀར་བུ་མོ་དང་རྔམ་བརྗིད་ལྡན་པའི་རྡོ་རིང་ཞེས་པ་ལྟ་བུའོ།",
    "སྐྱོ་གར་གྱི་འགལ་འཐབ་ནི་མི་སྣའི་ཉམས་ཉེས་དང་བར་ཆད་ཡིན་མོད།",
    "གལ་ཏེ་དྲང་ཕྱོགས་ཀྱི་མི་སྣ་ཞིག་མིན་པར་ངན་དགུ་ཚང་བའི་མི་ཞིག་ཡིན་ན་ཁོའི་ཉམས་ཉེས་ནི་རང་སྡུག་རང་གིས་ཉོས་པ་ཞིག་ཡིན་ལ།",
    "ཟློས་གར་འཁྲབ་གཞུང་གི་སྐད་ཆའི་སྐོར།",
    "གཅིག་ཟློས་གར་འཁྲབ་གཞུང་གི་སྐད་ཆའི་གལ་ཆེའི་རང་བཞིན།",
    "གླུ་གཞས་བཅས་ཀྱིས་རྟག་ཏུ་འཁྲབ་གཞུང་གི་གནས་བབས་གཙོ་བོ་དང་མང་ཤོས་དེ་ཟིན་གྱི་ཡོད།",
    "ཟློག་གར་འཁྲབ་གཞུང་གི་སྐད་ཆ་ནི་བརྩམས་སྒྲུང་དང་ལྷུག་རྩོམ་ནང་གི་སྐད་ཆ་ལས་གལ་ཆེ་བ་ཞིག་ཏུ་མཐོང་།",
    "དེར་དེ་ལས་ལྷག་པའི་ཚེ་སྲོག་གི་སྟོབས་ཤུགས་དང་གསོན་ཉམས་ལྡན་དགོས།",
    "མི་སྣའི་གཟུགས་དབྱིབས་འགུལ་སྐྱོད་དང་སེམས་ནང་གི་འགུལ་སྐྱོད་དག་ཕན་ཚུན་ཟུང་འབྲེལ་བྱས་པའི་སྐད་ཆས་མི་སྣའི་བྱ་སྤྱོད་མཚོན་དགོས།",
    "ག་རེ།",
    "སོགས་ལས་མི་སྣའི་གཟུགས་དབྱིབས་འགུལ་སྐྱོད་དང་སེམས་ནང་གི་འགུལ་སྐྱོད་དག་མཚོན་ཐུབ་བོ།",
    "རང་གཤིས་ཅན་ཞེས་པ་ནི་མི་སྣའི་སྐད་ཆར་ངེས་པར་དུ་མི་སྣ་རང་གི་གཤིས་ཀ་དང་བསམ་བློའི་བརྩེ་དུང་གི་ཚོར་སྣང་ཞིག་དགོས་པ་དང་དེར་ཕན་ཚུན་ཚབ་བྱེད་མི་རུང་བའི་རང་གཤིས་ཅན་གྱི་སྐད་ཆ་དགོས་ཏེ།",
    "ལའོ་ཧྲེསའཁྲབ་གཞུང་རྩོམ་མཁན་གྱིས་ཟློས་གར་ནང་གི་མི་སྣ་ཐེངས་དང་པོར་ཁ་གྲག་ཏུ་འཇུག་སྐབས།",
    "གཏམ་བརྗོད་ཟློས་གར་རྔ་མོང་ཞང་ཙི་ཞེས་པའི་འཁྲབ་ཚན་དང་པོར།",
    "གང་དུ་སོང་པ་ཡིན་ནམ།",
