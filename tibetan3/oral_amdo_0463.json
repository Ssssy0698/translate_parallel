    "སྤྱིར་བསྒྲུབ་བྱ་ལ་ལྟེ་བའི་བསྒྲུབ་བྱ་དང་ཡན་ལག་གི་བསྒྲུབ་བྱ་གཉིས་ཡོད་དེ།",
    "ལྟེ་བའི་བསྒྲུབ་བྱ་ནི་རྩོམ་མཁན་རང་གི་ལྟ་ཚུལ་གཙོ་བོ་དེ་ཡིན།",
    "ཡན་ལག་གི་བསྒྲུབ་བྱ་ནི་ལྟ་ཚུལ་གཙོ་བོ་གསལ་འདོན་བྱེད་པར་ལྟ་ཚུལ་གཙོ་བོ་གྱེས་པ་ལས་འཕྲོས་པའི་ལྟ་ཚུལ་ཆུང་བ་ཁག་ཅི་ཙམ་ཡོད་པ་དེ་རྣམས་ལ་ཟེར་ཞིང་།",
    "ཡན་ལག་གི་བསྒྲུབ་བྱ་ནི་ངེས་པ་དོན་གྱི་ཆ་ནས་ལྟེ་བའི་བསྒྲུབ་བྱ་དང་འབྲེལ་ནས་ཡོད་པ་ལས་སོར་གནས་བྱ་མི་རུང་བ་མ་ཟད།",
    "རྩོམ་པ་པོས་ལྟེ་བའི་བསྒྲུབ་བྱ་དེའི་རྨང་གཞིའི་འོག་ཡན་ལག་གི་བསྒྲུབ་བྱ་ཁག་གསུམ་བཏོན་ནས་དེ་དག་པོསོའི་སྒྲུབ་བྱེད་དུ་བཀོད་པ་སྟེ།",
    "མི་དམངས་མང་ཚོགས།",
    "ཞེས་པའི་ཡན་ལག་གི་བསྒྲུབ་བྱ་དེ་དག་སྒྲུབ་བྱེད་དུ་བརྗོད་པ་བརྒྱུད།",
    "བགྲོ་གླེང་རྩོམ་ཐུང་དག་ལ་བསྒྲུབ་བྱ་ཆེ་ཆུང་གཉིས་ཀ་དགོས་པའི་ངེས་པ་མེད་མོད།",
    "ནོར་འཁྲུལ་དང་ཕྱོགས་ལྷུང་གི་ལྟ་བ་ཅི་འདྲ་ཡིན་རུང་རང་ཚུགས་མི་ཐུབ་པས་འགོག་པར་བྱའོ།",
    "གཉིས་ནས་བསྒྲུབ་བྱར་བཏོན་པའི་ལྟ་ཚུལ་དེ་ཚན་རིག་གི་རང་བཞིན་ལྡན་དགོས་པ་ལས་གོ་དོན་མི་གསལ་བའི་ཉག་ཉོག་གི་ཚིག་གྲུབ་གཏན་ནས་བཟོ་མི་རུང་།",
    "བསྒྲུབ་བྱ་གྲུབ་ཚུལ་གྱི་ཚིག་གི་རྣམ་པ་ལ།",
    "འཆི་ཁར་འཕག་འཚག་རྒྱག་པ་ཅན་གྱི་མ་རྩ་རིང་ལུགས་རེད།",
    "སྒྲུབ་བྱེད་དུ་གྱུར་བའི་རྒྱུ་ཆ་ནི་ཧ་ཅང་མང་མོད།",
    "ལུང་རིགས་ཅི་ཡིན་རུང་ངེས་པར་དུ་དོན་དངོས་དང་མཐུན་མིན་བརྟག་དཔྱད་ལེགས་པོ་བྱེད་དགོས་པ་ལས་རང་སྣང་ལྟར་དང་ཚོད་དཔག་བྱེད་མི་རུང་།",
    "ཚོད་དཔག་སྒྲུབ་བྱེད་ཅེས་པ་ནི་སོ་སོའི་དགོས་མཁོའི་ཆེད་དུ་རྟོག་བཟོ་བྱས་པའི་སྒྲུབ་བྱེད་བཀོད་ནས་རང་གི་ཁས་ལེན་གྱི་བསྒྲུབ་བྱ་དེ་བསྒྲུབས་པ་ཡིན།",
    "སྔོན་མི་ཞིག་གིས་ཀེ་པེ་ཉི་ཡི་སྐར་མའི་གོ་ལ་གསར་པའི་རིག་པར་ངོ་རྒོལ་བྱས་ནས་རང་གི་ལྟ་བ་དེ་བསྒྲུབ་སྐབས་ཚོད་དཔག་སྒྲུབ་བྱེད་བཀོད་པའི་ནོར་འཁྲུལ་བྱུང་ཡོད།",
    "དེ་ཡང་སྒྲུབ་བྱེད་ཡང་དག་པ་ཡིན་པ་གཏན་འཁེལ་རྗེས་གཞི་ནས་བསྒྲུབ་བྱ་ཡང་དག་པ་ཡིན་པ་བསྒྲུབས་དགོས་མོད།",
    "ཁྱོད་ཀྱིས་རྫུན་ཤོད་ཀྱི་འདུག་རྒྱལ་ཚོང་ཆོམ་རྐུན་པ་ནི་རྫུན་གཏམ་པ་རེད།",
    "དེར་བརྟེན་རྫུན་གཏམ་པ་ནི་རྒྱལ་ཚོང་ཆོམ་རྐུན་པ་རེད།",
    "དེར་བརྟེན་ང་ནི་རྒྱལ་གཅེས་པ་རེད།",
    "དེར་བརྟེན་ངའི་སྐད་ཆ་ནི་འཁྲུལ་བ་མེད་པ་རེད།",
    "ངའི་སྐད་ཆ་ནི་འཁྲུལ་བ་མེད་པ་ཞིག་ཡིན་ན་ཁྱོད་རྒྱལ་ཚོང་པ་ཡིན་པར་གདོན་མི་ཟ།",
    "ཡང་ཁྱོད་རྒྱལ་ཚོང་པ་ཡིན་པའི་སྒྲུབ་བྱེད་དུ་ངའི་སྐད་ཆར་རིན་ཐང་ཡོད་པས་ཡིན་ཞེས་བཀོད་པ་ལྟར་ཡིན་ནོ།",
    "དེ་ལྟར་བྱས་ཚེ་སྐབས་འགར་སྟེས་དཔང་གིས་བསྒྲུབ་བྱ་དང་སྒྲུབ་བྱེད་གཞི་གཅིག་གི་སྟེང་དུ་འབྱུང་མོད་སྐབས་འགར་འགྲིག་ཙམ་ཡོང་ལ་མཚམས་རེ་ཕན་ཚུན་མི་མཐུན་པའི་ཞྭ་དཔེ་ལྷམ་འགེབས་སུའང་འགྱུར་གྱི་ཡོད་པས་དེ་གཉིས་གཅིག་མཐུན་དགོས་རྒྱུ་གལ་ཆེ།",
    "སྒྲུབ་རིམ་གསུམ་གྱི་རྩ་བའི་ཆ་རྐྱེན་ལ་བརྟེན་ནས་རང་ལུགས་བཞག་ནས་འབྲི་བ་ཡིན་མོད།",
    "བགྲོ་གླེང་གི་རྩོམ་འབྲིའི་རེ་བ།",
    "གཅིག་རིག་གཞུང་གི་རང་བཞིན་ལྡན་པ།",
    "རྩོམ་པ་པོས་རྩོམ་འབྲི་བྱེད་པའི་དམིགས་ཡུལ་བཅས་གསལ་པོར་སྟོན་དགོས་པ་རེད།",
    "རིག་གཞུང་དཔྱད་རྩོམ་འབྲི་བ་ལ་རིག་གཞུང་གི་རང་བཞིན་ཤུགས་ཚེ་ཞིང་།",
    "དེ་ནི་རིག་གཞུང་དཔྱད་རྩོམ་དང་སྤྱིར་བཏང་བགྲོ་གླེང་རྩོམ་གཉིས་ཀྱི་རྩོམ་སྟངས་ཀྱི་རྩ་བའི་ཁྱད་པར་ཡིན་པ་དེ་རེད།",
    "ལྷག་པར་དུ་རིག་གཞུང་དཔྱད་རྩོམ་ལ་རིག་གཞུང་གི་རང་བཞིན་ཤུགས་ཆེ་ཕྱིར་དེའི་རྩོམ་ནང་དུ་བྱུང་བའི་ནོར་འཁྲུལ་དང་།",
    "ལངས་ཕྱོགས་ཐོག་གི་ནོར་འཁྲུལ་ཡིན་པར་རྩིས་མི་རུང་བ་རེད།",
    "གཉིས་ནས་ཚན་རིག་གི་ཐད་ནས་གསར་གཏོད་མཛད་པ་དང་།",
    "གསུམ་ནས་རིག་པའི་གཞུང་ལུགས་གང་གི་ཆ་ནས་ལྟ་ཚུལ་གསར་པ་དང་།",
    "ཚན་རིག་གི་རང་བཞིན་ལྡན་པ།",
    "དཔྱད་རྩོམ་འབྲི་བའི་རྩ་བའི་བླང་བྱ་ནི་ཚན་རིག་གི་སྤྱོད་སྟངས་དགོས་པ་སྟེ།",
    "རང་ཉིད་ཀྱིས་འོས་མིན་བཙན་སྒྲིག་ཀྱང་བྱས་མི་ཆོག་པ་རེད།",
    "དེའི་ཐད་ལ་མའོ་ཙེ་ཏུང་གིས་རང་བློར་གང་ཤར་གྱི་གཟུགས་སྣང་ལ་མི་བརྟེན་པ་དང་།",
    "རིགས་པས་སྒྲུབ་པ་དེའང་ཧ་ཅང་ཞིབ་པ་དང་ཚགས་དམ་པ་ཞིག་ཡིན་དགོས་པ་རེད།",
    "ཚན་རིག་གི་སྤྱོད་ཚུལ་བཟུང་ནས་ཚན་རིག་རང་བཞིན་ལྡན་པའི་རིག་གཞུང་དཔྱད་རྩོམ་ཞིག་འབྲི་བར་བྱེད་ན།",
    "དང་པོ་ནི་གཞན་གྱི་ཞིབ་འཇུག་གི་གྲུབ་འབྲས་དེ་ཅིས་ཀྱང་སྣང་ཆུང་མི་བྱེད་པའི་སྤྱོད་ཚུལ་འཛིན་དགོས་ཏེ།",
    "ཆབ་སྲིད་དང་ལངས་ཕྱོགས་ནོར་བའི་སྐྱོན་གྱིས་རིག་གཞུང་གི་གྲུབ་འབྲས་དགག་མི་རུང་ལ།",
    "རིག་གཞུང་གི་གྲུབ་འབྲས་ཆེ་བ་དེས་ཀྱང་ཆབ་སྲིད་ལངས་ཕྱོགས་སྟེང་གི་ནོར་འཁྲུལ་དེའང་འགེབས་སྲུང་བྱེད་མི་རུང་།",
    "རིག་གཞུང་དཔྱད་རྩོམ་འབྲི་བ་ལ་ཚན་རིག་གི་སྤྱོད་ཚུལ་ལྡན་དགོས།",
    "དེའང་གཞན་གྱི་ཞིབ་འཇུག་གི་འབྲས་བུ་རྡོག་རོལ་དུ་གཏོང་བ་དང་།"
  ]
}