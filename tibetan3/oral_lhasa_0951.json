    "རྣམ་པར་ཤེས་པར་སྨྲ་བ་གང་དག་ཤེས་པ་ཐམས་ཅད་ནི་གཟུང་བ་དང་འཛིན་པ་དང་བྲལ་བའི་ཕྱིར་རང་ཉིད་གསལ་བ་ཡིན་གྱི།",
    "ཤེས་པ་གཞན་གྱིས་རྟོགས་པར་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེས་འདོད་པ་དེ་ལ་བསྒྲུབ་པར་བྱ་བ་མ་ཚང་བའི་ཉེས་པ་གཡོ་བ་མེད་པ་ཉིད་དོ།",
    "སྐྱེ་བ་དང་ལྡན་པ་ལ་སོགས་པའི་སྒྲུབ་པར་བྱེད་པ་གཞན་དག་ལ་ཡང་གྲུབ་པ་ལ་སྒྲུབ་པ་ལ་སོགས་པའི་སྐྱོན་བརྗོད་པར་བྱའོ།",
    "ཅི་སྟེ་ཡང་འབྲས་བུ་མེད་པའི་ཁྱད་པར་བླངས་ནས།",
    "ཁྱད་པར་སྐྱེད་པར་བྱེད་ཕྱིར་རོ།",
    "ཁྱད་པར་སྐྱེད་པར་བྱེད་པ་ནི་ཉེ་བར་ལེན་པའི་རྒྱུ་དང་ཡུལ་མཚུངས་པར་སྐྱེད་པར་བྱེད་པའོ།",
    "གང་ཡང་དངོས་པོ་ཡོད་པའི་ཞེས་བྱ་བའི་ཁྱད་པར་དེ་ནི་དོན་མེད་པ་ཉིད་ཡིན་ཏེ།",
    "རྣམ་པར་གཅད་པར་བྱ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "གལ་ཏེ་འཇིག་པའི་འབྲས་བུ་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་རྣམ་པར་གཅད་དུཔར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་ཡོད་པའི་ཞེས་བྱ་བའི་ཁྱད་པར་དོན་དང་བཅས་པར་འགྱུར་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་འདི་ན་འདི་རྫས་ལ་སོགས་པ་བཞིན་དུ་སྟོན་པ་དང་དངོས་པོར་ཡང་འགྱུར་བའི་ཕྱིར་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་གྱིས་རྣམ་པར་དཔྱད་པར་བྱ་བ་ཅུང་ཟད་དུ་ཡང་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དངོས་པོ་ཡོད་པ་ཞེས་བྱ་བའི་ཁྱད་པར་དོན་མེད་དོ།",
    "དེ་ལྟ་བས་ན་དེ་ལྟ་བུར་གྱུར་པའི་མཚམས་ཁྲུསྦྱོར་བ་ལས་དངོས་པོ་རྣམ་པར་འཇོག་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "དཔེར་ན་སྦེ་ཏྲེས་ལ་སོགས་པས་རིམས་ལ་སོགས་པ་ཞི་བར་བྱེད་དོ་ཞེས་བྱ་བ་འོག་ནས་རྒྱས་པར་སྟོན་པར་འགྱུར་རོ།",
    "གལ་ཏེ་བདག་ལ་སོགས་པ་རྟག་པ་གཅིག་པུ་སྔ་མ་དང་ཕྱི་མའི་དུས་སུ་རྗེས་སུ་འགྲོ་བའི་འབྲས་བུ་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་དེ་དག་ཡིན་པར་གྱུར་ན།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་གཅིག་ལས་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་དྲུག་པོ་སྐྱེ་བ་གསལ་པོར་ཤེས་ཏེ།",
    "ཡིད་ཀྱིས་རྗོགོས་སྦྱིན་པར་བྱའོ་སྙམ་དུ་སེམས་པར་བྱེད་དོ།",
    "མཚམས་སྦྱོར་བ་ཡང་དྲན་པས་བྱས་པ་ཡིན་ལ།",
    "དེ་ལྟ་ཡིན་དང་འགའ་ཞིག་བཟུང་ཡང་རིམ་པར་ངེས་པ་མ་ཡིན་ཏེ།",
    "འདི་ཡང་འོག་ནས་རྒྱས་པར་འཆད་པར་འགྱུར་རོ།",
    "དེ་ལ་གནོད་པར་བྱེད་པའི་རྗེས་སུ་དཔག་པ་རྗོའདི་ཡིན་ཏེ།",
    "ལྷ་སྦྱིན་གྱི་གཟུགས་ལ་སོགས་པའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཡང་རྒྱུ་ནུས་པ་ཐོགས་པ་མེད་པ་ཉེ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "དེས་ན་གཏན་ཚིགས་མི་མཐུན་པའི་ཕྱོགས་ལས་ལྡོག་པར་མ་གྲུབ་པའི་ཕྱིར་མ་ངེས་པ་ཉིད་ཡིན་ནོ།",
    "འོན་ཏེ་འདི་ཉིད་དོགས་པར་བྱས་ནས།",
    "རྣམ་གྲངས་ངེས་པར་གྲུབ་པ་ལས་ཐ་དད་པ་ཞེས་བྱ་བའི་གཏན་ཚིགས་དེའི་ཁྱད་པར་བརྗོད་པ་མ་ཡིན་ནམ།",
    "དེ་ལྟ་བས་ན་འདི་ལ་བརྗོད་པ་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་འདི་ནི་མ་གྲུབ་པོ།",
    "བདག་ཅེས་བྱ་བའི་ཚིག་འདི་སེམས་ཀྱི་རྣམ་གྲངས་ཉིད་དུ་རྣམ་པར་གཞག་པའི་ཕྱིར་རོ།",
    "ཉེ་བར་བཏགས་ཏེ་ཐ་སྙད་དུ་བྱས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་བས་ན་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་མ་གྲུབ་པོ།",
    "གལ་ཏེ་དོན་དམ་པར་བློ་ལ་སོགས་པ་ལས་ཐ་དད་པའི་དོན་རྗོད་པར་བྱེད་པ་ཉིད་དུ་སྒྲུབ་ན།",
    "སྒྲའི་ཐ་སྙད་ཐམས་ཅད་ཀྱི་ཡུལ་ནི་སྒོ་བཏགས་པའི་དོན་ཡིན་པའི་ཕྱིར་རོ་ཞེས་འོག་ནས་སྟོན་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་གཏན་ཚིགས་བསྒྲུབ་བྱས་ཁྱབ་པར་འགྱུར་སྙམ་དུ་དགོངས་པའོ།",
    "ཁྱད་པར་དང་བཅས་པ་ཡིན་ན་ཡང་གཏན་ཚིགས་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེས་ན་འཁྲུལ་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲ་རྣམས་བརྡ་མེད་པར་རང་བཞིན་གྱིས་དོན་གསལ་བར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རང་བཞིན་ཐ་དད་པར་ཁས་ལེན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་འབྱེལ་པ་དང་བྲལ་བའི་སྲོག་ལ་སོགས་པ་ལུས་དེ་གསོན་པོས་ཁྱད་པར་དུ་བྱས་པའི་ལུས་ལ་ཅིའི་ཕྱིར་སྡོག་སྟེ་མི་ལྡོག་པ་ཉིད་དོ།",
    "སྲོག་ལ་སོགས་པ་ཡང་བདག་ལ་འབྱེལ་པ་མེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པའོ།",
    "མིག་ལ་སོགས་པ་རྣམས་ནི་དོན་དམ་པར་བྱེད་པ་ཉིད་དུ་མ་གྲུབ་སྟེ།",
    "ཛེེདོན་དམ་པའི་བྱེད་པ་པོ་ཉིད་སྒྲུབ་པར་བྱེད་ན་མ་ངེས་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་བྱེད་པ་པོ་འབའ་ཞིག་ཏུ་ཡང་མིག་ལ་སོགས་པ་རྣམས་འབྱེལ་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་རྟགས་དང་རྟགས་ཅན་གྱི་འབྱེལ་པ་དྲན་པ་ལ་ལྟོས་པ་མེད་པར་ངའོ་སྙམ་པའི་ཤེས་པ་ནི།",
    "དེ་ནི་མི་རིགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཁྲུལན་འདེབས་པར་བྱེད་དོ།",
    "སེམས་པ་མེད་པ་ཅན་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པར་འདོད་ལ།",
    "ངའོ་སྙམ་པའི་ཤེས་པ་འདི་ལ་རྟག་པ་ལ་སོགས་པར་སྣང་བ་ཡང་མི་མངོན་ནོ།",
    "གསལ་བར་ཞེས་བྱ་བ་ནི་གསལ་པོར་ཏེ་འཁྲུལ་པ་མེད་པར་འཇུག་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་གལ་ཏེ་འདི་ཕལ་པ་ཡིན་པར་གྱུར་ན་དེའི་ཚེ་འཁྲུལ་པས་འཇུག་པར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་ན་སེང་གེ་དང་བྲམ་ཟེའི་ཁྱེའུ་དག་ལ་དངོས་དང་བཏགས་པས་དེ་གཉི་ག་ཡང་སེང་གེའོ་སྙམ་དུ་བློ་མི་འཁྲུལ་པར་འཇུག་པར་མི་འགྱུར་རོ།",
    "ངའི་ལུས་ལ་སོགས་པ་ཞེས་ཐ་དད་པར་མཐོང་བའི་ཕྱིར་ལུས་ལ་སོགས་པ་ལ་ངའོ་རྗོསྙམ་པ་ནི་འཁྲུལ་པས་འཇུག་པ་ཡིན་ཏེ།",
    "དེ་ལ་ཡང་ངའི་བདག་ཅེས་ཐ་དད་པར་མཐོང་བ་ཡིན་ནོ།",
    "དེ་དག་ནི་ལྷན་ཅིག་མི་གནས་པ་ཉིད་ཀྱིས་རྗོགནོད་པར་བྱ་བ་དང་།",
    "གནོད་པར་བྱེད་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "བྱས་པ་ཉིད་དང་།",
    "དོན་བྱེད་པར་ནུས་པ་ལོག་ན་ཡང་དངོས་པོ་ཉིད་སྡོག་སྟེ།",
    "བདག་ལ་ཕན་འདོགས་པར་བྱེད་པ་མ་ཡིན་པ་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "མེད་པ་ནི་ཚིག་ཕྱི་མའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་བདག་དང་བཅས་པ་ཞེས་བྱ་བ་ཡང་གང་ཞིག་ཡིན་པ་བརྗོད་པར་བྱའོ།",
    "དཔེར་ན་སྦྲང་བུ་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུར་མེད་པའི་སྦྱོར་བ་ཚིག་ཕྱི་མ་མེད་པར་མ་མཐོང་ངོ་ཅི་སྟེ་ལུས་ལ་བདག་འགེགས་ན་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "ལུས་ལ་བདག་ཡོད་པར་སུ་ཞིག་འདོད།",
    "འདི་ཐམས་ཅད་ནི་ཁྱད་པར་བཀག་པ་ཡིན་ལ།",
    "ཁྱད་པར་བཀག་ན་ཡང་སྤྱི་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་ན་གང་དགག་པར་བྱ་བ་དེ་རྗེས་སུ་གནང་བ་བྱས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་གཟུགས་ལ་སོགས་པ་ལས་ཐ་དད་པའི་ཡུལ་ཁས་བླངས་པའི་ཕྱིར་འགལ་བ་ཡིན་ནོ་ཞེས་སྨྲས་པ་དེ་འདི་ལ་དུལན་འདེབས་པར་བྱེད་པ་ནི།",
    "དེ་ཉེ་བར་ལོངས་སྤྱོད་པའི་གཞི་མ་ཡིན་པ་ཉིད་ཀྱིས་བདག་མེད་པར་འདོད་པ་ཁོ་ནའོ།",
    "གང་ཞིག་བཀག་པས་གསོན་པོའི་ལུས་ཁོ་ན་བདག་དང་བཅས་པར་རྟོགས་ཀྱི།",
    "དངོས་པོ་ཉིད་ལ་སོགས་པའི་ཕྱིར་རོ་ཞེས་སྒྲུབ་པར་བྱེད་དོ།",
    "དེ་ལྟ་བས་ན་བདག་ལ་ཕན་འདོགས་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ནི་གཞི་སྟེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཁྱེད་ཅག་ལ་ཡང་མེད་པར་རབ་ཏུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་སྒྲུབ་པར་ནུས་པ་ཁོ་ན་སྟེ།",
    "ལུས་ལ་སོགས་པ་ཡང་བདག་རྟག་པ་དང་གཅིག་པུའི་རང་བཞིན་གྱི་ཁྱད་པར་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པའོ།",
    "རང་བཞིན་གྱི་ཁྱད་པར་ནི་བདག་ལས་ཐ་མི་དད་པའི་ཕྱིར་རོ།",
    "དེ་བྱེད་ན་བདག་ཁོ་ནའི་བྱེད་པར་འགྱུར་ཏེ།",
    "དེ་ལྟ་བས་ན་རྟག་པ་ལ་ཅུང་ཟད་ཀྱང་ཕན་འདོགས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་རིག་བྱེད་སྨྲ་བ་རྣམས་ལྟར་གང་དག་ལུས་ལ་སོགས་པ་རྣམས་ནི་བདག་ཡོངས་སུ་འགྱུར་བའི་ངོ་བོ་ཡིན་པར་སྨྲ་བར་བྱེད་དོ།",
    "གང་ཡང་མེད་པ་ནི་ཚིག་ཕྱི་མའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་བདག་དང་བཅས་པ་ཡང་གང་ཞིག་ཡིན་པ་བརྗོད་པར་བྱའོ་ཞེས་སྨྲས་པ་དེ་ཡང་འཟེལ་པ་མེད་དེ།",
    "ཚིག་ཕྱི་མའི་དོན་ཡོད་པ་ཁོ་ན་དགག་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཡོད་པ་དགག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འདི་ལུང་དེ་ཉིད་རྗེས་སུ་བརྗོད་ནས་གཞན་གྱི་ལོག་པའི་ཤེས་པ་ཉིད་དུ་བརྗོད་པར་བྱ་བ་འགེགས་པར་བྱེད་དོ།",
    "གང་ཡང་ལུས་ལ་བདག་ཡོད་པར་སུ་ཞིག་འདོད་ཅེས་སྨྲས་པ་དེ་ཡང་ཡང་དག་པ་མ་ཡིན་ཏེ།",
    "ཕན་ཚུན་ཕན་གདགས་པར་བྱ་བ་དང་ཕན་འདོགས་པར་བྱེད་པ་མེད་པའི་ཕྱིར་གངས་ཅན་དང་འབིགས་བྱེད་བཞིན་དུ་བདག་དང་ལུས་གཉིས་འབྲེལ་པ་མེད་དོ་ཞེས་སྔ་མ་བཞིན་དུ་བསྒྲུབ་པར་ནུས་པའི་ཕྱིར་རོ།",
    "གང་ཡང་ཁྱད་པར་བཀག་ན་སྤྱི་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ནི་མ་ངེས་ཏེ།",
    "རྟག་པའི་སྒྲ་ཡང་དོན་དམ་པར་དངོས་པོ་རྟག་པ་འགའ་ཞིག་ལ་འཇུག་པར་གྲུབ་པ་ཡང་མ་ཡིན་ནོ།",
    "འཁྲུལ་པ་མེད་པར་རྟོགས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་ཏེ།",
    "ཡོད་པ་ལ་སོགས་པའི་ངོ་བོས་རྗེས་སུ་འཇུག་པ་སེམས་པ་ཅན་གྱི་ངོ་བོར་རྗོད་པར་བྱེད་དོ།",
    "སེམས་པ་ཅན་རྟག་པའི་རང་བཞིན་ཞེས་བྱ་བ་ནི་སེམས་པ་ཅན་གྱི་རང་བཞིན་རྟག་པ་གང་ལ་ཡོད་པ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "ཇི་ལྟར་རིགས་རྗོཔ་ཅན་ལ་སོགས་པ་རྣམས་ཀྱིས་རྟེན་པ་བཞིན་དུ་གཅིག་ཏུ་ངེས་པར་མཐའ་གཅིག་ཏུ་རྗེས་སུ་འགྲོ་བ་ལ་མི་རྟེན་ཅེ་ན།",
    "གལ་ཏེ་འཇིག་པ་རྗེས་སུ་འགྲོ་བ་མེད་པ་ཡིན་ན་དེའི་ཚེ་ལས་བྱས་པ་ཆུད་ཟོས་པར་འགྱུར་ཏེ།",
    "མ་བྱས་པ་དང་ཕྲད་པར་ཡང་འགྱུར་ཏེ།",
    "བདག་ངོ་བོ་གཅིག་ཉིད་ཡིན་ན་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པ་ལོངས་སྤྱོད་པར་མི་འགྱུར་ཏེ།",
    "ནམ་མཁའ་བཞིན་དུ་ཟ་བ་པོ་མ་ཡིན་པའི་གནས་སྐབས་ལས་ཟ་བ་པོའི་གནས་སྐབས་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་གཉི་གའི་ངོ་བོའི་སྐྱེས་བུའི་གནས་སྐབས་བྱེད་པ་པོ་གང་ཡིན་པ་དེ་ཟ་བ་པོ་མ་ཡིན་པའི་ཕྱིར་བྱས་པ་ཆུད་ཟོས་པ་དང་མ་བྱས་པ་དང་ཕྲད་པ་དེ་དག་འདི་ལའང་འོང་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "ང་ཁོ་ནས་ཤེས་པར་འགྱུར་རོ།",
    "ང་ཁོ་ནས་རིག་པར་བྱེད་དོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་བྱེད་པ་པོ་གཅིག་ཉིད་ཀྱིས་ཡུལ་ཅན་ངོ་ཤེས་པའི་ངོ་བོའི་ཕྱིར་ཏེ།",
    "ཡང་ཇི་ལྷར་ངོ་ཤེས་པའི་ཤེས་པས་འདི་གཉིས་ཀ་གྲུབ་པར་འགྱུར་ཞེ་ན།",
    "ངས་རིག་གོ་ཞེས་བྱ་བ་འདི་ངའི་ཤེས་པས་ཤེས་པ་པོ་འདི་རྟོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་ལ་རྩོད་པ་མེད་པ་ཉིད་ཡིན་ཏེ།",
    "འོན་ཏེ་ཤེས་པའི་ཕྱོགས་ཡིན་ན་དེའི་ཚེ་ཐམས་ཅད་ཤིན་ཏུ་འབྲེལ་པར་དཀའ་སྟེ།",
    "འདི་ལྟར་ངས་ཤེས་པར་གྱུར་ཏོ།",
    "དེའི་ཡུལ་ཤེས་པའི་སྐད་ཅིག་ཡིན་པར་རྟོག་པ་ན།",
    "དེ་ལ་དང་པོ་སྟེ་འདས་པའི་ཤེས་པའི་ཡུལ་ཉིད་དུ་རྟོག་པར་བྱེད་ན་ཤེས་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་དེ་ལྟར་རྣམ་པའི་ངེས་པ་འདི་རིགས་ཏེ།",
    "ཤེས་པར་འགྱུར་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པར་འཛིན་པར་ནི་མི་རིགས་སོ།",
    "ད་ལྟར་དང་འདས་པ་གཉིས་ཀའི་ཤེས་པའི་སྐད་ཅིག་ཤེས་པར་གྱུར་པ་མ་ཡིན་ལ།",
    "ཤེས་པར་གྱུར་པ་གཅིག་ཡིན་ལ།",
    "འདི་ལྟར་རྒྱུན་འདི་སྔར་ཤེས་པར་གྱུར་པ་མ་ཡིན་ཞིང་།",
    "གང་ཞིག་ངའི་ཤེས་པར་རྟོགས་པར་བྱ་བ་དེ་ནི་ད་དུང་ཡང་འཇུག་པ་ཡིན་ཏེ།",
    "འདས་པའི་ང་རྒྱལ་གྱི་ཡུལ་རྟོགས་པ་ཡང་ངའི་ཤེས་པས་རྟོགས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "ད་ལྟར་བའི་བློ་འདི་ཡང་ཤེས་པ་པོ་དང་ངའི་ཤེས་པས་རྟོགས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "དེ་ཉིད་ལས་སམ་ཞེས་བྱ་བ་ནི་ངའི་ཤེས་པས་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ལྷ་སྦྱིན་ལ་སོགས་པའི་རྒྱུད་གཅིག་དང་འབྱེལ་པའི་ཤེས་པ་པོའི་དོན་བདུན་པ་དེར་རམ།",
    "འདི་ཡང་གཏན་ཚིགས་སྟོན་པའོ་། ངའི་ཤེས་པ་ཉིད་ཙམ་ནི་སྐྱེས་བུ་གཞན་གྱི་ང་རྒྱལ་ལ་འཇུག་པས་དེའི་ཕྱིར་མ་ངེས་པ་སྤང་བའི་དོན་དུ་རྒྱུད་གཅིག་དང་འབྲེལ་པའི་ཤེས་པ་པོའི་ཡུལ་ཉིད་གཏན་ཚིགས་ཀྱིས་ཁྱད་པར་དུ་བྱས་སོ།",
    "ངའི་ཤེས་པ་དེ་དག་ཉིད་ཀྱི་ནང་ནས་བློ་གཅིག་ཏུ་བརྗོད་པར་འདོད་པ་བཞིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་འདི་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཕྱོགས་ཕྱི་མ་རྩོམ་པར་བྱེད་དོ།",
    "གལ་ཏེ་རྟག་པ་དང་གཅིག་པུའི་ངོ་བོ་སེམས་པ་ཅན་ཁས་ལེན་པར་བྱེད་ན།",
    "བར་མེད་པར་སྒོ་འདོགས་པ་རྣམ་པ་དུ་མ་སེམས་པ་ན་སྐྱེ་བ་དང་འཇིག་པ་དང་འབྲེལ་པའི་བློ་རྣམས་ཤིན་ཏུ་གསལ་བར་ཉམས་སུ་མྱོང་བའི་ཕྱིར་རོ།",
    "འོ་ན་ཇི་ལྟར་གཟུགས་ཀྱི་བློ་རོའི་བློ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཐ་དད་དུ་རྟོགས་པར་འགྱུར་ཞེ་ན།",
    "འདི་སྙམ་དུ་གལ་སྟེ་བློ་རྟག་པ་དང་གཅིག་པུ་ཡིན་ན་དེའི་ཚེ་ཅིའི་ཕྱིར་གཟུགས་ལ་སོགས་པའི་ཡུལ་རིམ་གྱིས་རྟོགས་པར་འགྱུར།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་དཔེར་ན་མེ་རྟག་ཏུ་སྲེག་པའི་བདག་ཉིད་ཡིན་པར་གྲག་ན་ཡང་ཐམས་ཅད་ཐམས་ཅད་ཀྱི་ཚེ་སྲེག་པ་ནི་མ་ཡིན་ནོ།",
    "རྣམ་པར་འཇིག་པའི་ཕྱིར།",
    "བློ་འཇིག་པར་མངོན་གྱི།",
    "དེའི་ཚེ་འོ་ན་དོན་ཐམས་ཅད་རྟོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཀླན་ཀའི་གནས་སྐབས་དེ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "ཅི་སྟེ་འདིའི་བློ་རྟག་པ་ཉིད་ཇི་ལྟར་རྟོགས་པར་བྱ་ཞེ་ན།",
    "རྟོགས་པའི་བདག་ཉིད་ཡིན་པས་བློ་བློ་ཞེས་བྱ་བར་ངོ་ཤེས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་སྒྲ་བཞིན་དུ་བློ་རྟག་པ་ཡིན་ནོ།",
    "འོན་ཏེ་གླང་པོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་བྱེད་དེ།",
    "གལ་ཏེ་བློ་ཐ་དད་པས་བྱས་པ་ཁོ་ན་ཡིན་ན་དེའི་ཚེ་གང་དག་གླང་པོ་ལ་སོགས་པས་སྟོང་པའི་སར་རིམ་གྱིས་རྟ་དང་གླང་པོ་ལ་སོགས་པ་མི་གནས་པའི་སྒོ་འདོགས་པར་བྱེད་པའི་ཤེས་པ་རྣམས་འཇུག་པ་དེ་དག་ལ་ཐ་དད་པར་རྟོགས་པ་ཅི་ལ་རྟེན་པར་འགྱུར།",
    "ཐ་དད་པ་རྣམ་པར་གཞག་པའི་རྟེན་འགའ་ཡང་ཡོད་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཁྱད་པར་དུ་བྱེད་པར་འགྱུར་བའི་ཡུལ་སྣ་ཚོགས་པའི་ཕྱིར་ཡང་མ་ཡིན་ཏེ།",
    "དེར་ཁྱད་པར་དུ་བྱེད་པའི་དོན་འགའ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་སོ་སོར་ངེས་པའི་དོན་གྱི་རྣམ་པར་གཞག་པ་ཆད་པ་ཁོ་ནར་འགྱུར་རོ།",
    "བརྗོད་པར་འདོད་པའི་ཡུལ་ན་ནི།",
    "བརྗོད་པར་འདོད་པའི་ཡུལ་ནི་གང་དུ་སྒྲོ་བཏགས་པ་བྱས་པ་སྟེ།",
    "དེ་ལྟ་བས་ན་ཤེས་པ་དེ་དག་ནི་དོན་དམ་པར་མ་འདྲེས་པའི་རང་བཞིན་དང་གཡོ་བའི་བདག་ཉིད་ཡིན་ཏེ།",
    "ཤེས་པ་དམིགས་པ་མེད་པར་བསྟན་པ་འདི་ཉིད་ཀྱིས་བློ་མངོན་སུམ་མ་ཡིན་པ་ཡང་སུན་བྱུང་བ་ཡིན་ཏེ།",
    "འདི་ལྟར་ཡོངས་སུ་གསལ་བའི་རྣམ་པ་དེ་ནི་ཕྱི་རོལ་མ་ཡིན་པར་བསྒྲུབས་པ་ཡིན་ནོ།",
    "ཁྱད་པར་མེད་ཕྱིར་རིམ་གྱིས་ཀྱང་།",
    "མིན་ཞེ་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་སྒྲའི་ཡུལ་ཅན་གྱི་བློ་དེ་ཉིད་ཀྱི་རོ་ལ་སོགས་པའི་སྤྱོད་ཡུལ་ཅན་དུ་ཁས་ལེན་པར་མི་བྱེད་ན།",
    "མེ་དཔེར་བྱས་པ་ཉིད་གང་ཡིན་པ་དེ་ཡང་མ་གྲུབ་པོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "བསྲེག་པར་བྱ་བ་ཐམས་ཅད་སྲེག་པའི་རང་བཞིན་གྱིས་སྲེག་པར་བྱེད་པ་རྟག་ཏུ་གནས་པ་ནི་མ་ཡིན་ནོ།",
    "སྲེག་པར་བྱེད་པ་འབར་བ་དང་རྗོའབྲེལ་པའི་བསྲེག་པར་བྱ་བ་བཞིན་དུ་རང་སྲེག་པར་བྱེད་པ་ཉིད་དུ་རྟག་ཏུ་ཉེ་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་མེ་རྟག་ཏུ་སྲེག་པར་བྱེད་པའི་བདག་ཉིད་དུ་མི་འགྱུར་ན།",
    "འོ་ན་ཇི་ལྟར་དོན་ཉེ་བ་ཡང་སྲེག་པར་བྱེད་ཅེ་ན།",
    "བསྲེག་པར་བྱ་དོན་ཉེ་ཉིད་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་གལ་ཏེ་སྐད་ཅིག་མ་མ་ཡིན་པ་དེའི་གཟུགས་བརྙན་འཛིན་པར་འགྱུར་ན།",
    "དེའི་ཚེ་ཉེ་བར་བསྒྱུར་བ་དང་བཅས་པའི་གནས་སྐབས་གང་ཡིན་པ་དེ་ཁོ་ན་དེ་ཉེ་བར་སྒྱུར་བ་མེད་པའི་གནས་སྐབས་ཡིན་པའི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པའི་ཉེ་བར་སྒྱུར་སྣེབ་དང་བྲལ་བ་ལ་ཡང་སྔོན་པོ་ལ་སོགས་པའི་གཟུགས་བརྙན་ཡང་དག་པར་དམིགས་པར་འགྱུར་ཏེ།",
    "སྔར་གྱི་ངོ་བོ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཤེལ་ལ་ཡང་ཡང་དག་པར་ཉེ་བར་བསྒྱུར་བའི་གཟུགས་བརྙན་རྟོགས་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི།",
    "གལ་ཏེ་དོན་དམ་པར་ཤེལ་ལ་སོགས་པའི་ཡུལ་གྱི་གཟུགས་བརྙན་འཛིན་པར་འགྱུར་ན།",
    "གལ་ཏེ་ཡང་འདི་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་ཁས་ལེན་པར་བྱེད་ན་དེའི་ཚེ་འདི་ཉིད་ལ་ཉེས་པ་འདི་མེད་དོ་ཞེས་ཤེས་པར་བྱེད་པའི་དོན་དུ་དེ་ཉིད་དུ་ཡོད་ན་ཞེས་སྨོས་སོ།"
  ]
}