    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བས་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "གསལ་བ་མངོན་གསུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་དང་།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་རང་རིག་མངོན་དུ་ཤར་བས་གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བས་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྒྲིབ་པ་མེད་ཅིང་ཡོངས་སུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་དང་།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "གསལ་བ་མངོན་སུམ་པའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ།",
    "གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་བསྙེལ་ཞིང་ཡེངས་པ་མི་མངའ་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
