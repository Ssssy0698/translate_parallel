    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "རྣམ་པར་བྱང་བའི་བོན་ཐམས་ཅད་སྐུ་མ་བཅོས་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཇི་ལྟར་སྨིན་ཅིང་གསལ་བར་ལགས།",
    "རྣམ་པར་བྱང་བའི་བོན་ཐམས་ཅད་ནི་སྐུ་མ་བཅོས་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "སྐུ་མ་བཅོས་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "རྣམ་པར་བྱང་བའི་བོན་ཐམས་ཅད་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པར་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དང་།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བར་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་དང་།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྤོང་བ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་དང་།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་དང་།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བོན་ཐམས་ཅད་སྤོང་པ་མེད་པ་རྒྱན་དུ་སྣང་བ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་དཔྱོད་པ་མེད་ཅིང་ཆུ་ཟླའི་འཁོར་ལོ་ལྟར་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་རྫུ་འཕྲུལ་གྱི་སྐུ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དེ་མཉམ་པ་ཉིད་ཀྱི་དོན་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།",
    "བོན་ཐམས་ཅད་སྐྱེ་བ་མེད་པ་གདོད་ནས་དག་པ་གསལ་བའི་རང་བཞིན་དུ་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཡོངས་སུ་སྨིན་ཅིང་གསལ་བར་གནས་སོ།"
  ]
