    "དེ་ཡང་ང་ཞེད་ཀྱི་འདུག།",
    "དེ་དུས་ང་རང་ལོ་ན་བཅུ་ཙམ་ཡིན།",
    "གནས་ཚུལ་དེར་རྒྱ་མི་དོགས་པ་ཆེན་པོ་བྱུང་ཡོད་པ་ནི་པཱ་ལགས་དང་ཆུ་བཞི་སྒང་དྲུག་དབར་འབྲེལ་བ་འདུག་སྙམ་པ་དེ་ཡིན།",
    "འདི་ཕྱི་གཉིས་ཕུང་རང་གཞན་གཉིས་མེད་ལས་ངན་དེས།",
    "བོད་རྒྱ་དམར་གྱིས་ཧམ་ཟ་མ་བྱས་པའི་གོང་དུ་རང་ལ་དངུལ་ཡོད་ན་ཟ་བཅའ་དང་དངོས་རིགས་གང་འདྲ་ཞིག་ཡིན་ཡང་རང་འདོད་ལྟར་ཉོ་ས་ཡོད་པ་དང་།",
    "ང་ཕྲུ་གུའི་སྐབས་གཞིས་ལ་སྡོད་སྐབས་ཞིང་ལགས་ཀྱི་སྐུ་མདུན་ལ་གཟའ་འཁོར་ཁ་ཤས་དེ་འདྲ་སྡོད་མྱོང་བ་ད་ལྟ་ཡང་དྲན་སོས་ཀྱི་འདུག།",
    "སྐབས་དེ་དུས་ང་རང་ཡང་ལོ་ཆུང་ཆུང་ཡིན།",
    "སྐབས་དེ་དུས་ང་རང་ལོ་བཅུ་གཅིག་བཅུ་གཉིས་ཙམ་ལས་སླེབས་མེད།",
    "རྣམ་པ་ཚོས་རྒྱ་དམར་བཙན་འཛུལ་པ་དེ་གདུག་རྩུབ་གཡོ་སྒྱུ་ཆེ་བ་གང་འདྲ་མི་འདུག་གམ།",
    "གུང་ཁྲན་ཏང་ཟེར་བ་དེ་གང་འདྲ་ཞིག་འདུག་གམ།",
    "ལི་རྨོའོ་ཧྲའ་བཅས་མི་གསུམ་ལ་ཟེར་གྱི་ཡོད་འདུག།",
    "འཕྲིན་ལས་རྒྱ་མཚོ་ལགས་ཀྱི་གཟིམས་ཁང་ལ་ཁོང་རང་དང་ཞང་འཇམ་དཔལ་ལགས་གཉིས་ལས་གཞན་མེད།",
    "པར་དེའི་ནང་ཁོ་པའི་མིག་གཉིས་ཀར་སྐྱོན་རྩ་བ་ནས་མི་འདུག།",
    "སྐབས་དེ་དུས་མི་ཚང་མར་མི་བདེ་བ་དང་སུན་སྣང་ཆེན་པོ་བྱེད་དགོས་པ་ཞིག་ལོས་ཡིན།",
    "ང་རང་དེར་ཡ་མཚན་ཆེན་པོ་བྱུང་།",
    "དེ་ལྟ་མིན་པར་དེ་དག་ཚང་མ་རྒྱ་དམར་གཞུང་རང་དང་།",
    "ཅེས་བརྗོད་མཚམས་དེར་ང་རང་ངོ་མ་གྲ་ནང་ལ་ཕྱིན་པའི་གནས་ཚུལ་ཞིག་ངོ་སྤྲོད་བྱེད་འདོད་བྱུང་།",
    "དེ་ནས་མི་དེས་རྩྭ་རས་དེ་ཁ་བསྔོགས་ནས་ལྟ་སྐབས་རྩྭ་རས་ནང་ལ་རྒྱ་གར་གྱི་ཧ་ཡང་གསར་རྐྱང་བརྩེགས་བཞག་པ་ཁ་ཤས་ཤིག་ཡོད་བཟོ་འདུག།",
    "རྒྱ་དམར་ཇག་ཚོགས་དེས་བོད་ལ་བདེ་སྐྱིད་བསྐྲུན་ཡོད་ཟེར་བ་དེ་གང་འདྲ་ཞིག་འདུག་གམ།",
    "ལྷ་ཀླུའི་ཕྱག་མཛོད་བསྟན་པ་ཆུ་ལ་མཆོངས་ནས་རང་ཤི་བརྒྱབ་འདུག་ཅེས་གོ་ཐོས་བྱུང་ཞིང་།",
    "དེ་ནི་སྐབས་དེར་ཆབ་སྲིད་གྲོས་ཚོགས་ནི་པ་རི་ཁུག་ལ་ཡོད་པས་དེའི་སྐབས་ཁོང་རང་ཤི་བརྒྱབ་པ་ཞིག་ཡིན།",
    "མི་སྣ་ཁ་ཤས་ལ་ལྷ་འདྲེ་གདོན་བགེགས་ཟེར་ནས་རྔམ་སྟོན་ཁྲོམ་སྐོར་ལ་འཁྲིད་པ་སོགས་བྱེད་ཀྱི་འདུག་ཀྱང་།",
    "དེ་དག་རླངས་འཁོར་གྱི་ནང་བླུགས་སྐབས་རླངས་འཁོར་གྱི་སྒྲོམ་སྐྱོར་སྒང་ལ་སླེབས་ཀྱི་འདུག་ཀྱང་དེའི་སྟེང་ལ་མི་སྡོད་དགོས་པ་དང་།",
    "དེར་དམག་མིའི་འབབ་ཚུགས་འདུག་པས་དགོང་དྲོའི་ལྟོ་ཆས་ཟོས་ནས་ཞག་སྡོད་བྱས།",
    "དེ་ནི་རླངས་འཁོར་གྱི་འོག་ལ་མི་མནན་ཏེ་སྲོག་སྐྱོན་བྱུང་ནས་ཕུང་པོ་བཏོན་མི་ཐུབ་པར་ལུས་འདུག།",
    "དེ་ནས་དམག་མིའི་འབབ་ཚུགས་ཡོད་སར་ཆུ་ཚོད་ཕྱེད་ཀ་ཙམ་ལས་འགོར་གྱི་མི་འདུག།",
    "ཐོག་མར་ས་ཕག་རྒྱག་པའི་སྐབས་དཀའ་ལས་ཧ་ཅང་ཁག་པོ་འདུག།",
    "བུ་ཡར་ནང་ལ་ཤོར་འགྲོ་བ་དང་པ་ཕ་ནང་ལ་བཞག་ནས་སྒོ་ཕྱི་ནས་སྒོ་ལྕགས་བརྒྱབ་ཡོད་སྟབས་དོན་ས་མེད་དུས་སྒེའུ་ཁུང་ནང་ནས་དོན་ཡོང་ནས་བུའི་ཐོག་ཤོར་ཏེ་དགྲ་ཟླ་གཉིས་ཤི་གསོན་གྱི་དམག་འཐབ་བྱེད་པ་ནང་བཞིན་བྱེད་ཀྱི་འདུག།",
    "དེ་ནས་མེ་མདའ་དང་རང་བཟོས་འབར་རྫས།",
    "ང་རང་མི་གསོད་ཁྲག་སྦྱོར་བྱེད་པའི་སྐབས་གཙུག་ལག་ཁང་ནང་ཡོད་དམ་ཞེ་ན་མེད།",
    "ཡིན་ནའང་རང་ཉིད་དེ་སྐབས་ལྷ་སར་ཡོད།",
    "དེ་དུས་ཀྱི་རྒྱ་སྐད་ཀྱི་ཚིག་དེ་འདྲ་ཞིག་སེམས་ནང་འཇགས་ཡོད་པ་ནི་ཅང་ཆིང་ཐུང་ཀྲེས་ཧྲུའོ་ཟེར་བ་དང་ཡང་ཁང་ལའོ་ཧུའོ་ཟེར་བའི་ཚིག་དུམ་ད་ལྟ་ཡང་རྣ་ཅོག་ལ་འཇགས་ནས་བསྡད་འདུག།",
    "སྐབས་དེ་དུས་ང་རང་ལྷ་སར་ལྟོ་གོས་ཆེད་ལཱ་མག་བརྒྱབ་ནས་བསྡད་ཡོད།",
    "དེ་ནས་ང་དང་བྱམས་བཟོད་ལགས་ཁ་ཆེ་གླིང་ཁའི་ནང་སླེབས་པའི་སྐབས་བཀྲ་ཤིས་དང་བློ་བཟང་ཚེ་འཕེལ་ལགས་ནས་ང་གཉིས་སྒྲུག་བཞུགས་འདུག།",
    "ངོས་ནས་ཀྱང་དེ་ཡག་པོ་འདུག།",
    "ལར་ནས་ཐོག་མར་བློ་བཟང་ཚེ་འཕེལ་དང་བཀྲ་ཤིས་གཉིས་ནས་བྱམས་བཟོད་ལགས་ལ་ང་འབོད་པར་བཏང་ནས་ཁ་ཆེ་གླིང་ཁའི་ནང་སྒྲིག་འཛུགས་འཛུགས་རྒྱུའི་སྐོར་བློ་བཟང་ཚེ་འཕེལ་དང་བཀྲ་ཤིས་གཉིས་ནས་བྱམས་བཟོད་ལགས་དང་རང་ཉིད་ཡོད་སར་སྐད་ཆ་དེ་གླེང་བ་དང་།",
    "ད་ཆ་བྱམས་བཟོད་ལགས་ལ་བློས་འཁེལ་གྱི་མི་འདུག་ཟེར་བའི་སྐད་ཆ་དེར་ངོས་རང་ཧང་སང་ནས།",
    "ངོས་གཉིས་གླིང་སྐོར་ཕྱི་ལ་འཆམ་འཆམ་ལ་མཉམ་དུ་ཕྱིན་པས་བྱམས་བཟོད་ལགས་ཀྱིས་བློ་འགྱོད་ཆེན་པོས་ང་རང་ལ་བརྗོད་དོན།",
    "དེ་ནས་མུ་མཐུད་ནས་རླངས་འཁོར་ལ་རྩེ་ནས་བབ་ནས་འགྲོ་སྐབས་ལམ་ཁ་ཧ་ཅང་ཞན་པའི་ཐོག་ལམ་ཁ་ཤས་ལ་རླངས་འཁོར་གཅིག་ལས་ཐར་ས་མི་འདུག།",
    "རི་མགོ་ནས་རླངས་འཁོར་མར་བབས་པའི་སྐབས་རི་གཤམ་ལ་ལྟ་མི་ཕོད་པ་ལྟ་བུའི་ཞེད་སྣང་འདུག།",
    "གཉིས་ནས་ལམ་ཁ་ཡག་པོ་རྩ་བ་ནས་མི་འདུག་པས་རླངས་འཁོར་འདི་ག་དུས་ཨ་ལོག་བརྒྱབ་ནས་ཐེར་ཚལ་འབར་ཚལ་བཟོ་ཡོང་ངམ་སྙམ་པའི་དངངས་སྐྲག་ངང་འགྲོ་དགོས་བྱུང་།",
    "དེ་ནི་རི་དེའི་ཐོག་ཤིང་ནགས་མཐུག་པོ་མི་འདུག་ཀྱང་ཐང་ཤིང་དང་།",
    "ཤིང་སྟག་མ་སོགས་གང་འཚམ་འདུག་པས་རླངས་འཁོར་རི་གཤམ་ལ་འདྲེད་བརྡར་ཤོར་བའི་སྐབས་ཨ་ལོག་རྩ་བ་ནས་ཐེབས་མེད་པར་རྒྱབ་བཤིགས་བརྒྱབ་ནས་འདྲེད་བརྡར་ཤོར་ནས་སྡད་འདུག།",
    "དེ་ཡང་རླངས་འཁོར་འདྲེད་བརྡར་ཤོར་ས་དེ་ལའི་དཀྱིལ་ཙམ་ལ་ཡིན་པ་མ་ཟད་ལམ་ཡག་པོ་མེད་ཀྱང་གཡང་གཟར་པོ་རྩ་བ་ནས་མི་འདུག།",
    "ས་ཚང་མ་འཁྱགས་པ་བརྒྱབ་ནས་འཇག་མ་གཅིག་པུས་ས་སློག་རྒྱག་ཐུབ་པ་མི་འདུག།",
    "ང་འཁྱགས་ཀྱི་འདུག་ཟེར་ས་མེད་པར་ཡང་བསྐྱར་ལམ་སེང་ཆུ་ལེན་པར་འགྲོ་དགོས་ཀྱི་ཡོད།",
    "ས་གནས་ཀྱི་འགོ་ཁྲིད་ཅིག་ཡིན་པའི་ཚོད་དཔག་ཐུབ་ཀྱི་འདུག།",
    "གནས་སྟངས་དངོས་འབྲེལ་སེམས་པ་སྐྱོ་དགོས་པ་ཞིག་འདུག།",
    "ངས་ཀྱང་ང་རང་ནས་ཇ་སྦག་ཆུང་གཅིག་དང་།",
    "ཐ་མག་བཅས་ལག་རྟགས་ལ་ཕུལ་ནས་དེ་ཕྱག་རྟགས་རང་ཡིན་པ་མ་གཏོགས་ང་རང་ལ་དངོས་པོ་བརྗེ་ཚོང་གནང་མི་དགོས་ཞུས་པ་ཡིན།",
    "ཡིན་ནའང་ང་སྡོད་སའི་རྒྱལ་ཁ་ལམ་ལམ་བཟོའི་རུ་ཁག་ནང་གྲལ་རིམ་བུ་ཕྲུག་ལ་དམིགས་བསལ་གྱིས་དམ་དྲག་བྱེད་མཁན་མི་འདུག།",
    "ཁྱིམ་ཚང་དེ་རྒྱ་ཆེན་པོ་དང་ནང་མི་ཧྲག་པོ་འདུག།",
    "ད་ཁྱེད་རང་གཉིས་སང་ཉིན་ནམ་མ་གསལ་གོང་ཕེབས་རོགས།",
    "གཡས་གཡོན་ཚང་མ་ནག་ཐིང་ངེར་བསྡད་འདུག།",
    "དེ་ནས་གཞོན་ནུ་འཇུ་བཟུང་བྱས་པའི་ནང་སུ་དང་སུ་འདུག་གམ་ཞེས་དྲིས་པས།",
    "ཡིན་ནའང་ཉིན་དེ་ནས་བཟུང་རང་ཉིད་ནི་བློ་རྣལ་ལ་བབ་པ་ཞིག་རྩ་བ་ནས་མ་བྱུང་།",
    "ཁོ་པས་ངའི་མིང་ནས་བོས་ཏེ་བདེ་ཆེན་རྒྱ་མཚོ་ཡར་ཤོག་ཟེར་གྱི་འདུག།",
    "དེ་གར་གཡས་གཡོན་ཚང་མར་དམག་མིས་ཁེངས་ནས་བསྡད་འདུག།",
    "དེར་དེ་རིང་ཞོགས་པ་ཡར་མར་འགྲོ་མཁན་དམག་དཔོན་རྒན་ཁོག་དེ་ཚོ་འདུག།",
    "གུར་ནང་ལྕོག་ཙེ་གཅིག་དཀྱིལ་ལ་བཞག་འདུག།",
    "༤གཅིག་ས་མཐིལ་སྒང་ལ་བཞག་ནས་ང་ལ་རྐུབ་སྟེགས་སྒང་ལ་སྡོད་དགོས་ཟེར་གྱི་འདུག།",
    "ལ་གཤམ་དེར་དམག་མིའི་འབབ་ཚུགས་ཁ་པར་རྒྱག་ས་ཏར་ཁང་ཆུང་ཆུང་ཞིག་འདུག་པ་དེར་ང་ལ་རྒྱབ་ལྕགས་བརྒྱབ་ཡོད་ཡོད་པར་ཁང་པའི་ཕྱི་རུ་ས་མཐིལ་སྒང་ལ་སྡོད་དུ་བཅུག་པ་དང་།",
    "དེའི་ནང་རྩམ་པ་རྩྭ་ཞིབ་འདྲེས་མ་ཞིག་འདུག།",
    "ཁང་ཆུང་དེ་ནི་ཉལ་ཁྲི་གཅིག་བརྒྱབ་ཐུབ་ཙམ་ཁང་པ་གྲུ་བཞི་ཆུང་ཆུང་ཞིག་འདུག་དེ་ནས་ངོས་ལ་ཉལ་ཆས་དང་།",
    "ཡང་སྒོ་དེའི་འོག་ཙམ་དེར་ཕོར་པ་ཆེ་བ་ཐར་ཙམ་གྱི་མི་ཁུང་ཕྱི་ནས་ཁ་གཅོད་ཡོད་པ་ཞིག་འདུག།",
    "དེ་དུས་ང་རང་ལྟོ་གོས་ཆེད་ལཱ་མག་དང་ས་ཕག་རྒྱག་པར་ཕྱིན་ནས་དཀའ་ངལ་ཀྱི་ངང་གནས་ཡོད་པ་ལས་གཞན་པའི་གསང་བའི་ཚོགས་པ་དེ་འདྲའི་ནང་ཞུགས་པ་དང་།",
    "ཡིན་ནའང་ངས་ང་རང་ཐར་རྒྱུའི་ཆེད་དུ་མི་གཞན་གྱི་གནས་ཚུལ་ཐེར་འདོན་བྱས་པ་ཡིན་ན།",
    "བོད་ཕྱི་ནང་ལག་འབྲེལ་འདུག་བསམ་པའི་དོགས་པ་ཆེ་རུ་ཕྱིན་ནས་རང་གཞན་ཚང་མར་དཀའ་ངལ་དང་ཉེན་ཁ་བསམ་ཡུལ་ལས་འདས་པ་ཡོང་རྒྱུ་ཡིན་པས།",
    "ཁོང་ཆུང་དེའི་ནང་རང་ཉིད་ཟླ་བ་གསུམ་ཙམ་བཞག་བྱུང་བས་དུས་ཚོད་དེའི་རིང་བོད་ལ་གནམ་གཤིས་གྲང་ངར་ཆེན་པོ་ཡོད་པའི་དུས་སྐབས་ཤིག་ཡིན་ཡང་ང་ཉི་མ་གཅིག་ཀྱང་ཉི་མའི་ནང་བཏོན་མ་བྱུང་།",
    "ངས་ཁོང་སུ་ཡིན་མིན་ཞལ་ཚོར་གྱི་མི་འདུག་ལ།",
    "དེ་བཞིན་ཁོང་དང་མཉམ་དུ་ཡོད་པའི་བཙོན་པ་དེ་དག་ཀྱང་ཞལ་ཚོར་གྱི་མི་འདུག།",
    "བཛྲ་གུ་རུ་སོ་སོ་བྱེ་བ་ཁ་ཤས་བགྲང་གསོག་ཐུབ་འདུག།",
    "ལྟོ་ཆས་ཀྱི་ཚད་གཞི་དེས་གྲོད་པ་བརྒྱག་ཐབས་རྩ་བ་ནས་མེད་པར་ག་དུས་ཡིན་ནའང་གྲོད་པ་རྟོགས་པར་སྡོད་དགོས་ཀྱི་ཡོད།",
    "རང་ཉིད་ཚོགས་ཁང་ནང་ཡོད་པ་ལྟ་བུ་ཞིག་ལ་ཚོགས་ཁང་ནང་རྐུབ་སྟེགས་མང་པོ་ཡོད་པའི་ནང་མི་མང་པོ་མཉམ་དུ་འདུག་པས།",
    "ངའི་བསམ་བློའི་ནང་རྒྱ་དམར་གྱི་རྒྱལ་དར་དེ་ཡང་མཉམ་དུ་བསྒྲིགས་ནས་བཞག་འདུག་སྙམ་ནས་མི་བདེ་བ་དང་།",
    "ངས་ཞང་ལགས་བསམ་བློར་འཁོར་སྐབས་དེང་སྐབས་དེ་ལྟ་བུའི་བཟང་སྤྱོད་ལྡན་པའི་མི་མཐོང་རྒྱུ་ཉུང་ཉུང་དེ་ནི་བློ་ཕམ་གྱི་གནས་ཚུལ་ཞིག་ཡིན་པ་བསམ་གྱི་འདུག།",
    "ད་དུང་ངས་མཚན་མི་ཤེས་པ་དང་དྲན་མི་སོས་པའི་བཙོན་པ་བཅུ་གྲངས་ཤིག་འདུག།",
    "རང་ཉིད་བཙོན་པ་བྱིངས་མཉམ་དུ་ཚོགས་ཆུང་ནང་གཏོང་སྐབས་ངའི་རོགས་པ་བྱམས་བཟོད་ལགས་མཉམ་དུ་བཏང་འདུག་ཀྱང་ང་གཉིས་ཚོགས་ཆུང་གཅིག་ནང་མཉམ་དུ་བཞག་མེད།",
    "པའདུག་འདུག་ཁོང་ལ་རྐང་ལྕགས་དང་ལག་ལྕགས་བརྒྱབ་དགོས་དོན་ནི།",
    "ངས་ག་དུས་ཡིན་ནའང་ང་གསད་རོགས་གྱིས་ཟེར་གྱི་ཡོད་མ་གཏོགས་ངས་མགོ་སྒུར་གྱི་མིན།",
    "བྱམས་བཟོད་ལགས་རྗེས་ལ་རིག་འཚོ་མ་ཟིན་པ་ཆགས་ནས་དུས་ཚོད་ལོ་ལྔ་སྔ་སྣུར་གྱིས་གློད་བཀྲོལ་བཏང་འདུག།",
    "ཚོགས་ཆུང་དེའི་ནང་ལ་རྒྱ་མི་བཞི་དང་བོད་མི་གཅིག་འདུག།",
    "ཐ་མག་འཐེན་ཞེས་གསུངས་ཀྱི་འདུག།",
    "དུས་འབྲུག་ཡུལ་ལ་ཡོད་སྐད་ཟེར་གྱི་འདུག།",
    "ཕལ་པ་རྣམས་ཀྱིས་རང་ཉིད་ཐར་ཐབས་དང་རང་ཉིད་ཀྱི་ཁེ་ཕན་ཕྲན་བུ་ཞིག་དོན་གཉེར་བྱེད་རྒྱུའི་ཆེད་བོད་རྒྱལ་ཁབ་དང་།",
    "ཡིན་ནའང་རང་ཉིད་ལག་རྩལ་མཁས་པ་གང་འདྲ་ཞིག་ལ་འགྱུར་ཡང་རྒྱ་དམར་བཙན་འཛུལ་པ་དེའི་ངལ་རྩོལ་ནུས་ཤུགས་བཤུ་གཞོག་གཏོང་བྱེད་ཀྱི་ཁོངས་སུ་གཏོགས་པ་ཞིག་ཡིན།",
    "ངས་ད་ལྟ་ཡང་ཐུགས་གཤིས་དལ་བའི་གཅེན་པོ་ཞིང་གཤེགས་དཔལ་ལྡན་ཚེ་རིང་ལགས་ཀྱི་བཀའ་དྲིན་བརྗེད་ཀྱི་མི་འདུག།",
    "ང་རང་ཡང་དེ་ལྟར་བྱེད་མཁན་ཞིག་ཡིན།",
    "ད་དུང་གཡས་གཡོན་གཉིས་ལ་དམག་མིས་ལག་པར་དཔུང་རྟགས་ནག་པོ་དང་བྲང་ཁོག་ལ་ཤོག་བུའི་མེ་ཏོག་དཀར་པོ་བཏགས་ནས་སྲོང་པོར་ལངས་ནས་བསྡད་འདུག།",
    "ང་རང་ནི་ཡི་གེ་འབྲི་ཀློག་ཐུབ་ཙམ་ལས་མེད།",
    "དེ་ནས་ཆུ་ཚོད་གཅིག་ཙམ་རྗེས་བསྟན་པ་ལགས་དང་བོད་ཆས་བཞེས་པའི་མི་དར་མ་ཞིག་མཉམ་དུ་ཕེབས་ཀྱི་འདུག་པ་ཤག་ལ་ཕེབས་མཚམས་བསྟན་པ་ལགས་ཀྱིས་ཁོང་སྐུ་ངོ་བློ་བཟང་ངག་དར་རྒྱས་ཡིན་པའི་ངོ་སྤྲོད་གནང་བྱུང་བས།",
    "དགྲ་ཕྱོགས་དང་རང་ཕྱོགས་ཀྱི་སྟོབས་ཤུགས་ལ་གཞིགས་པའི་དམག་རྩལ་དང་འཐབ་བྱུས་གསར་པ་སློབ་སྦྱོང་མུ་མཐུད་བྱས་ནས་ནམ་ཡང་རྩ་མེད་གཏོང་མི་ཐུབ་པའི་སྟོབས་ཤུགས་ཤིག་གསར་འཛུགས་བྱེད་དགོས།",
    "ཀྲུང་དབྱང་ནས་སྤྱད་པའི་དངུལ་དེ་དག་ཡར་ཀླུང་གཙང་པོའི་ནང་གཡུགས་འདུག་ཅེས་ཁོང་ཁྲོ་ཆེན་པོས་སྐྱོན་བརྗོད་བྱས་ཡོད་པ་མ་ཟད།",
    "ང་རང་ཡང་འགྲོ་འདོད་འདུག་ཅེས་ཞུས་པས།",
    "དེ་བཞིན་གཞིས་བཞུགས་སྐུ་མཆེད་གཞན་རྣམས་ཀྱི་གནས་སྟངས་ཇི་ཡོད་སྐོར་བཀའ་འདྲི་གནང་འདུག་པས།",
    "ངས་ཨ་ཞང་ལགས་ལ་ང་རྒྱ་གར་ལ་འགྲོ་འདོད་འདུག་པས།",
    "ངས་ཨ་ཞང་ལགས་སུ་རྒྱ་གར་གྱི་ཤོག་བུ་དང་ཡིག་ཁོག་ཅིག་ཕུལ་ནས་ཕྱག་གཟུགས་མི་འདྲ་ཙམ་ཞིག་བྲིས་རོགས་གནང་ཞུས་པ་ཡིན།",
    "སྟོད་ཕད་ཕྱི་སྐྱོད་ལག་འཁྱེར་བཅས་ལ་ཞིབ་བཤེར་བྱེད་ཀྱི་འདུག།",
    "ཕྲུ་གུ་མང་པོ་ཕྱིར་དོན་ནས་བསྡད་འདུག།",
    "ང་རང་ནི་ལྟོ་ཆས་མེད་པར་མི་འགྲོ་བ་ལྟ་བུ་བྱུང་།",
    "ང་དང་དེ་བཞིན་མཉམ་དུ་ཡོད་པ་ཚོས་བག་ལེབ་དང་ལྟོ་ལྷག་མཐའ་སྐོར་ལ་བལྟས་ནས་སྡོད་མཁན་ཕྲུ་གུ་དང་མི་རྒན་དེ་དག་ལ་སྤྱོད་པའི་སྐབས་ཧབ་ཐོབ་བརྒྱབ་ནས་ལེན་གྱི་འདུག།",
    "དེ་ནས་རླངས་འཁོར་ལ་བསྡད་ནས་བལ་ཡུལ་གྱི་རྒྱལ་ས་ཀ་ཐ་མན་གྲུར་འགྲོ་བའི་ལམ་བར་བསྙད་བརྐོ་ལྡབ་གསིག་གཏོང་མཁན་ཟ་རྔམ་ཅན་གྱི་བལ་པོའི་པུ་ལི་སིའི་འབབ་ཚུགས་མང་པོ་འདུག།",
    "ཁོང་ནི་དེ་སྔ་ལྷ་སའི་དན་བག་ནས་ཡིན་གསུངས་ཀྱི་འདུག།",
    "ངོས་རང་ནས་ཀྱང་རང་ཉིད་ངོ་སྤྲོད་ཞུས་རྗེས་དགའ་སྤྲོ་ཧ་ཅང་ཆེན་པོ་བྱུང་བ་དང་དེ་ནས་སྐུ་ངོ་ཡིས་རླངས་འཁོར་རྫིབ་གཅིག་ཁྲིད་ཕེབས་འདུག་པ་དེའི་ནང་ངའི་ཅ་དངོས་དེ་དག་བླུགས་རྗེས་མེག་ལོར་གན་ཇི་ནས་གངས་ཅན་སྐྱིད་གཤོང་ལ་ཁྲིད་པ་གནང་ཞིང་དེར་སྐུ་ངོ་བྱམས་པ་སྐལ་ལྡན་ལགས་མཇལ་ནས་ཕན་ཚུན་འཚམས་འདྲི་ཞུས་རྗེས་སྐུ་ངོ་མཆོག་ནས་སྔོན་ལ་ཁྱེད་རང་སྐུ་ངལ་གསོས་གནང་།",
    "དེ་ནས་སྐུ་ངོ་ཡིས་༧གོང་ས་མཆོག་ད་ལྟ་བཞུགས་སྒར་དུ་སྐུ་བཞུགས་གནང་མེད་པས་ཉིན་ཤས་ནང་ཡུ་རོབ་ནས་ཕྱིར་བཞུགས་སྒར་དུ་ཞབས་སོར་འཁོད་མཚམས་གང་མགྱོགས་མཇལ་ཁ་གོ་སྒྲིག་བྱེད་འཐུས་གསུངས་ཀྱི་འདུག།",
    "ཐུགས་ཕམ་ཡོད་པའི་རྣམ་པ་ཞིག་ཀྱང་འདུག།",
    "ཟམ་པ་དེར་ལྟ་སྐབས་བོད་ལ་སླེབས་པའི་སྣང་བ་ལྟ་བུ་ཞིག་ལས་རྒྱ་གར་གྱི་ས་ཆའི་ནང་ཡོད་པའི་སྣང་བ་སྤུ་ཙམ་མི་འདུག།",
    "པི་ཏི་ནི་ལུང་ཁུག་སྐྱོ་པོ་ཞིག་འདུག།",
    "བསྟན་ལ་དད་ཅིང་རང་རིགས་ལ།",
    "དེ་ནས་བཞུགས་སྒར་ནས་མ་ཐོན་གོང་ཙམ་ལ་སྐུ་ངོ་བྱམས་པ་སྐལ་ལྡན་ལགས་ཀྱིས་ཕྱི་དྲོ་ཞིག་ལ་ངོས་ལ་རྡ་ཤོད་ཀྱི་ཟ་ཁང་ཞིག་ནང་གསོལ་སྟོན་སྟབས་བདེ་ཞིག་གནང་བའི་སྐབས་སྐབས་དེའི་བདེ་སྲུང་དྲུང་ཆེ་གཞོན་པ་སྐུ་ངོ་བློ་བཟང་སྦྱིན་པ་ལགས་མཉམ་དུ་ཕེབས་འདུག།",
    "བོད་རང་བཙན་བསྐྱར་ལེན་གྱི་འཐབ་རྩོད་ལ་རྒྱབ་སྐྱོར་ཡོང་ཆེད་བལ་ཡུལ་ལ་ཡོད་པའི་ཨུ་རུ་སུའི་གཞུང་ཚབ་ཁང་ལ་བསྐྱོད་ནས་གཞུང་ཚབ་ཀྱི་འབྲེལ་ཡོད་ལས་བྱེད་དང་ཐུག་འཕྲད་བྱས་ཏེ་རང་ཉིད་བོད་ལ་ཕྱིར་ལོག་བྱས་པ། ། བལ་ཡུལ་ལ་གཟའ་འཁོར་ཁ་ཤས་སྡོད་རིང་རང་ངོས་ནས་ཨུ་རུ་སུའི་གཞུང་ལ་བོད་མིའི་རང་བཙན་འཐབ་རྩོད་ལ་རྒྱབ་སྐྱོར་ཡོང་རྒྱུའི་འབད་བརྩོན་ཞིག་བྱས་པ་ཡིན།",
    "ལན་བརྡ་སོགས་གང་ཡང་བྱེད་མཁན་མི་འདུག།",
    "དེ་ནས་མི་ཞིག་ཡོང་ནས་ངའི་འགྲམ་དེར་བསྡད་ནས་ངོས་ལ་ཁྱེད་རང་བདེ་པོ་ཡིན་པས་ཞེས་འཚམས་འདྲི་བྱས་སྟབས།",
    "ང་རྒྱ་གར་དང་བལ་ཡུལ་ལ་སྡོད་སྐབས་ངའི་སྤུན་མཆེད་དང་ངོ་ཤེས་མང་པོས་ཁྱེད་རང་བོད་ལ་ཕྱིར་ལོག་མ་བྱེད།",
    "ཡིན་ནའང་རང་ཉིད་ནི་དེ་ཙམ་གྱི་དངངས་སྐྲག་མ་བྱུང་།",
    "ལན་འཕྲོད་མ་བྱུང་ངམ་གསུངས་ཀྱི་འདུག།",
    "དེ་ནས་མར་སྡོད་ཟེར་ནས་རྐུབ་བཀྱག་ཐོག་འདྲ་མཉམ་སྡོད་དུ་བཅུག་ནས་ལྕོག་ཙེའི་སྒང་ལ་ཁ་ཏོག་དང་ཇ་དམ་གཅིག་བཞག་འདུག།",
    "མ་གཞི་ཁྱེད་རང་ཁ་སང་ཐིང་ཀྲང་མཇལ་བར་བཅར་འདུག།",
    "རོགས་པ་མེད་པར་རང་རྐྱ་འཕེར་བ་མི་འདུག།",
    "ངས་དངོས་གྲུབ་ལགས་ཁྱེད་རང་འདི་གར་བཞུགས་པའི་རིང་ཞལ་ལག་དང་བཞུགས་ས་ཚང་མ་འདི་གར་གྲ་སྒྲིག་བྱེད་རྒྱུ་ཡིན་པས།",
    "གཉིས་ནས་ཁྱེད་རང་ཕྱི་ཕྱོགས་ལ་ཡོད་པ་ཡིན་ན།",
    "གང་ལགས་ཞེ་ན་དེ་གོང་རང་ཉིད་ལས་དོན་ཆེད་རྒྱ་གར་ལ་ཐོངས་མཆན་ཞུས་ནས་ཕྱིན་པ་དང་།",
    "དེར་གནས་རྩ་ཆེན་ཀྲ་ཏ་པུ་རི་ཟེར་བ་དེ་འདུག་པས་མཇལ་བར་ཕྱིན་པ་དང་།",
    "དེ་ནས་གཡས་གཡོན་ནས་རྩྭ་སྐམ་པོ་བསྒྲུགས་ནས་དེའི་ཐོག་ས་སྣུམ་ཕྲན་བུ་བཤོས་ནས་མེ་སྦར་སྐབས་མེ་ལམ་སེང་འབར་གྱི་མི་འདུག་དེ་ནས་ཤོག་བུའི་ཐོག་ས་སྣུམ་བཤོས་ནས་མེ་སྦར་བས་འབར་ཙམ་བྱུང་།",
    "མཚོ་ཐོག་ལ་ངང་པ་དང་བྱ་བྱིའུ་འདྲ་མིན་འཕུར་བཞིན་འདུག་ལ་ཞོགས་པའི་ཉི་ཟེར་མཚོ་ལ་འཕྲོས་སྐབས་དམིགས་བསལ་གྱི་མཛེས་སྡུག་ལྡན་པ་ཞིག་སྣང་།",
    "ཚེས་༣ཞོགས་པ་སྔ་པོ་ནས་ཐོན་ནས་མུ་མཐུད་ནས་འགྲོ་སྐབས་ཆུ་དང་སྤང་བར་བུར་མང་པོ་ཡོད་པའི་ཐང་གཞོང་ལྟ་བུ་ཞིག་བགྲོད་དགོས་ཀྱི་འདུག་པས་སྤང་བར་བུར་དེ་བགྲོད་བར་ཆུ་ཚོད་གཉིས་གསུམ་ཙམ་ཞིག་འགོར་ཡོད་ངེས་ལ་དེ་ནས་ས་མ་རུབ་ཙམ་ལ་ཀླུ་མེད་ཀྱི་འབྲོག་སར་སླེབས་བྱུང་བས་གཞི་ནས་སེམས་པ་ལྷོད་ལ་བབ་པ་དང་།",
    "ཕར་བལྟས་ཚུར་བལྟས་བྱས་ཀྱང་ཁང་པའི་ནང་གང་ཡང་བྱུང་མི་འདུག།",
    "དེ་ནས་ང་སྒོའི་ཕྱི་ལ་ལྟ་བར་ཕྱིན་པས་གང་ཡང་བྱུང་མི་འདུག།",
    "དེའི་རྒྱུ་རྐྱེན་གང་ལ་ཐུག་པའི་ཐད་རང་ངོས་ནས་ཞིབ་འཇུག་དང་དེའི་རྗེས་ལ་བོད་ནས་གནས་ཚུལ་བཏང་བ་བཅས་ལ་རྩད་ཞིབ་བྱེད་པའི་སྐབས་གསང་བའི་ལས་འགུལ་དེ་ཕྱི་གྱར་ཕྲན་བུ་བྱུང་བའི་བཟོ་ཞིག་འདུག།",
    "ཚུལ་ལྡན་ལྟ་བུ་ཞིག་འདུག།",
    "དེ་ལས་དགྲ་བོའི་ལག་པར་མ་ཐེབས་གོང་རང་སྲོག་གཅོད་རྒྱུ་དེ་འདེམས་པ་ཞིག་ཡིནཔར་ངས་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།",
    "དེ་ཡང་རང་ཉིད་སྐབས་དེར་བལ་ཡུལ་ལ་གནས་སྡོད་བྱེད་རྒྱུ་དང་ས་མཚམས་ཁག་ལ་འགྲོ་བའི་སྐབས་བལ་པོའི་ངོ་སྤྲོད་ལག་འཁྱེར་ཞིག་དགོས་གལ་ཆེ་བར་བརྟེན།",
    "ས་ཆ་དེར་མིང་གཉིས་འབོད་ཀྱི་ཡོད་པ་ནི་མཚོ་གཤམ་དང་ཕྱོགས་གཤམ་ཟེར་གྱི་འདུག་པས་ངས་དེར་དཔྱད་ཞིབ་ཅིག་བྱེད་པའི་སྐབས་མཚོ་གཤམ་ཟེར་བ་དེ་ས་ཆ་དེའི་མིང་དངོས་དང་ཕྱོགས་གཤམ་ཟེར་བ་དེ་ནི་ཁ་སྐད་མིན་ནམ་སྙམ།",
    "ས་ཆའི་དཀྱིལ་དེར་ཆུ་རྒྱུག་ཡུལ་གྲམ་པ་ཞིག་འདུག་ལ།",
    "མ་གཞི་སྤུན་མཆེད་སུ་ཡིན་མིན་སང་ཉིན་ཡི་གེ་གསལ་པོ་ཞིག་ཁྱེར་ནས་ཆུས་ལ་ཤོག་ཟེར་གྱི་འདུག་ལ།",
    "དེ་ནས་ངས་ཨ་རག་ཡོད་མེད་བལྟས་པས་ཨ་རག་རྒྱ་སྐད་ལ་སྦའེ་ཆུའུ་ཟེར་བ་ཤེལ་དམ་གསུམ་བཞི་ལས་མི་འདུག།",
    "ད་དུང་བལྟས་པས་གཞན་ཕན་ཐོགས་པའི་ཅ་དངོས་མེད་པར་སྟོད་ཐུང་ནང་འཇམ་དེ་འདྲ་འདུག་པས།",
    "ཡིན་ན་ཡང་ས་གནས་དེ་རྒྱུད་ལ་སྐབས་དེར་དམག་མི་བསྐྱར་འཇོག་གང་ཡང་བྱས་མི་འདུག།",
    "གུར་ནང་ང་དང་ཕ་རྒན་དེ་མ་གཏོགས་མེད་ཅིང་དང་ཐོག་རྒད་པོ་དེས་མ་ཎི་བགྲང་ནས་སྡོད་པ་མ་གཏོགས་ང་ལ་སྐད་ཆ་ཚིག་ཟུར་ཙམ་ཡང་ཤོད་ཀྱི་མི་འདུག་པས་རང་ཉིད་འཚེར་པོ་བྱུང་།",
    "སྤོའོ་ལགས་ཁྱེད་རང་ཐུགས་ཁྲལ་མ་གནང་།",
    "ཡིན་ནའང་རི་སྐེད་ནས་མར་ལྟ་སྐབས་ཆུ་ཆེན་དྲག་ཏུ་རྒྱུག་བཞིན་འཇིགས་སྣང་ཆེན་པོ་འདུག།",
    "ལྷག་པར་དུ་མཇིང་པ་ཕར་ཚུར་འགུལ་སྐྱོད་དང་གཟུགས་པོ་ཡང་འགེགས་འགུག་བྱེད་ཐུབ་ཀྱི་མི་འདུག་ལ།",
    "ངས་ངའི་ལམ་གྲོགས་ལ་སང་ཉིན་ཁྱེད་རང་ཕར་ཕེབས་པ་ཡིན་ན།",
    "རང་ཉིད་ཆུ་ཕ་རིར་བགྲོད་ཐུབ་པ་བྱུང་ཡང་སྐྱོར་མཁན་མེད་པར་རང་རྐྱ་འཕེར་ནས་འགྲོ་ཐུབ་ཀྱི་མི་འདུག།",
    "བརྡབས་སྐྱོན་ཤུགས་ཆེ་བས་མཇིང་པ་ཕར་ཚུར་སྔར་བཞིན་འགུལ་སྐྱོད་ཐུབ་ཀྱི་མི་འདུག་ལ།",
    "ཁྱེད་རང་ལྷོད་ལྷོད་བྱས་ནས་བཞུགས་གསུངས་ནས་ཐུགས་ཁུར་ཆེན་པོ་གནང་བྱུང་།",
    "གང་ཡིན་ཞེ་ན་ངའི་བརྡབས་སྐྱོན་དེ་རྩ་ལ་སྐྱོན་བྱུང་བ་ཞིག་ཡིན་པ་ཤེས་ཀྱི་འདུག།",
    "ཁྱེད་རང་དེ་གར་སྐུ་ངལ་ལྷོད་ལྷོད་བྱས་ནས་གསོས་གནང་།",
    "ཡུལ་གོམས་གཤིས་ལུགས་སོགས་ཚང་མ་བོད་མི་དང་ཁྱད་པར་ཧ་ལམ་མི་འདུག།",
    "དེ་ནས་པུ་ལི་སིས་ང་རྩད་མི་ཆོད་སྟབས་ཕྱིར་ལོག་བྱས་འདུག་པས།",
    "ཟམ་པ་ནས་མར་ལྟ་སྐབས་གཡང་གཟར་གཏིང་རིང་པོ་འདུག།",
    "དེ་ནས་རྒྱའུ་ལ་འཛེགས་ནས་ཆུ་ཚོད་ལྔ་ཙམ་འགྲོ་སྐབས་ལ་དཀྱིལ་ཙམ་ལ་སླེབས་ནས་དེར་ཚ་ཐོག་རྒྱག་ཡུལ་རྫིའུ་སྡོད་སའི་རྡོ་བརྩིགས་ཀྱི་ར་སྐོར་ཞིག་འདུག་པས།",
    "ངའི་སེམས་ནང་རང་བཞིན་གྱིས་དངངས་ཚབ་དང་མི་བདེ་བ་ཞིག་བྱུང་།",
    "ལ་དེ་ནི་ལ་ཐག་ཧ་ཅང་རིང་པོ་ཞིག་འདུག་པས།",
    "ང་དིང་རིའི་རྒྱ་མིའི་འགག་སྒོར་སླེབས་པར་རྒྱང་ཐག་ཆུ་ཚོད་གཅིག་ཙམ་གྱི་སྟོད་ཕྱོགས་ནས་གསང་ཐབས་ཀྱིས་ཆུ་བོ་ཆུང་ངུ་ཞིག་འདུག་པ་དེ་བཅད་ནས་འགག་སྒོ་བརྒལ་ཙམ་གྱི་རྒྱ་ལམ་ཐོག་ཐོན་སྐབས།",
    "དེའི་འགོ་གཙོ་བརྒྱ་དཔོན་གྱི་གོ་གནས་ཡོད་མཁན་རྒྱ་མི་ལོ་ཆུང་གདུག་རྩུབ་ཅན་ཞིག་འདུག།",
    "ད་དུང་དེའི་འོག་བོད་མི་བཅུ་དཔོན་ཡིན་ངེས་ལ་ལོ་ལྔ་བཅུ་ཡས་མས་ལ་སླེབས་པ་གཅིག་དང་བོད་མི་དམག་མི་ལྔ་དྲུག་ཙམ་དང་རྒྱ་མི་ལྔ་དྲུག་ཙམ་ཞིག་འདུག།",
    "དེབ་དེ་དག་སུས་སྤྲད་བྱུང་ངམ་ཟེར་གྱི་འདུག་པས།",
    "དེ་ནས་རང་ཉིད་བློ་བདེར་གྱུར་ནས་གཞི་ནས་ཐབས་མཁས་ཀྱིས་གསོན་ཐུབ་པ་བྱེད་རྒྱུའི་གསོན་ལམ་འདུག་སྙམ་པ་བྱུང་།",
    "ཡང་དམག་མི་ལོ་གཞོན་དེས་མི་མེད་པའི་སྐབས་དང་བསྟུན་ནས་ང་ལ་སྐད་ཆ་དྲིས་དོན་ཁྱེད་རང་གང་ནས་ཡོང་བ་ཡིན་ནམ་ཟེར་གྱི་འདུག་པས།",
    "རྒྱ་བོད་གཉིས་ཀྱི་འགལ་བ་དེ་ཤུགས་ཆེན་མངོན་གྱི་འདུག།",
    "ལྕགས་རི་བར་མའི་མཐོ་ཚད་སྤྱི་ཁྲེ་ལྔ་དྲུག་ཡོད་ལ་ཞེང་ཚད་ཆེན་པོ་ཡོད་པ་དང་ལྕགས་རིའི་སྟེང་བཙོན་པར་ལྟ་ཞིབ་བྱེད་མཁན་དམག་མིས་བཙོན་པར་ལྟ་ཞིབ་བྱེད་ཀྱི་འདུག།",
    "ཁོ་པས་རྟག་ཏུ་གུང་ཁྲན་ཏང་ལ་དམའ་འབེབས་བྱེད་ཀྱི་འདུག།",
    "ཁྱེད་རང་ལ་ལས་འགན་ཡོད་པ་དང་།",
    "དེ་ནས་ཉིན་གཉིས་པར་ཁོ་པ་ཚོ་འོངས་ནས་སླར་ཡང་དྲི་ཞིབ་བྱེད་ཀྱི་འདུག་པས།",
    "སྤུན་མཆེད་སུ་སུ་ཡོད་མེད་དྲིས་ཀྱི་འདུག་པས།",
    "ཁྱེད་རང་ནས་བསམ་བློ་ཡག་པོ་གཏོང་དགོས་པ་དང་།",
    "སྒྲིག་འཛུགས་བཙུགས་མི་དང་འགོ་ཁྲིད་ང་རང་ཡིན་པ།",
    "ཚོགས་མི་སུ་དང་སུ་ཡོད་དྲི་ཞིབ་བྱེད་ཀྱི་འདུག་པས་ངས་བསྟན་པ་དང་།",
    "ང་རང་ལ་ཡང་བྱས་རྗེས་ཡོད་པས་ངས་གོང་རིམ་ལ་ཞུ་ཆོག།",
    "ལོ་ན་བདུན་ཅུ་ཙམ་ལ་སླེབས་ཡོད་ངེས་ལ་སྔོན་མ་མཐོང་མྱོང་བ་ལྟ་བུ་ཞིག་འདུག།",
    "ཁྱེད་རང་དོ་དགོང་ཕར་ལོག་ནས་བསམ་འཆར་དང་འཆར་གཞི་འཁྱེར་ཤོག་ཟེར་གྱི་འདུག་པས།",
    "ཁོ་པའི་ལས་རོགས་ན་གཞོན་རྒྱ་མི་ཝང་ཟེར་བ་དང་དེའི་ཐོག་མི་གསར་པ་བོད་མི་གཅིག་འདུག་པས།",
    "གཞིས་རྩེར་ཁྱེད་རང་ལ་ངོ་ཤེས་ཡོད་མེད་ཟེར་གྱི་འདུག་པས།",
    "ཁ་པར་ཨང་གྲངས་དང་པོ་གཉིས་པ་ལས་གནས་ཏ་མིང་དེ་དག་སེམས་ལ་ངེས་པ་བྱས་ནས་དེ་བརྗེད་མེད་པ་བཟོ་དགོས་ཟེར་གྱི་འདུག།",
    "ནང་ལ་འཛུལ་སྐབས་པཱ་ལགས་ཀྱང་ཞུགས་འདུག་པས།",
    "ད་དུང་མི་གསར་པ་གཅིག་ཡོད་པ་ནི་དེའི་མིང་ལ་ཡང་ཝང་ཟེར་གྱི་འདུག་ལ།",
    "དེ་ཡང་དེང་སྐབས་ལྷ་སའི་དམག་དོན་བཀག་འདོམས་གློད་འདུག་ཀྱང་དམ་དྲག་ཤིན་ཏུ་ཆེན་པོ་འདུག་ཅེས་ཤོད་དགོས།",
    "ཚལ་སྣེ་ཁ་ཉི་ཤུ་ཙམ་བཤམས་འདུག་ལ།",
    "དེའི་རིང་ལྷ་སའི་གནས་སྟངས་ནི་ཛ་དྲག་ཆེན་པོ་འདུག།",
    "ཁོ་པས་ང་དང་ང་སྐྱེལ་མི་ཚོར་སྣེ་ལེན་བྱེད་ཀྱི་འདུག་ལ།",
    "དེ་གོང་ཁྱེད་རང་ཨ་རིར་སློབ་སྦྱོང་ལ་འགྲོ་རྒྱུའི་འཆར་གཞི་ལྟར་སྔོན་ལ་ཨ་རིར་སློབ་སྦྱོང་ལ་ཕྱིན་ན་ལེགས་ཚུལ་བཀའ་གནང་བར་བརྟེན་རང་ཉིད་ཨ་རིར་སློབ་སྦྱོང་ལ་ཐོན་རྒྱུའི་གྲ་སྒྲིག་བྱས་པ་ཡིན།",
    "འོན་ཀྱང་རང་ཉིད་བོད་ལ་འགྲོ་ཐབས་མེད་པ་དེ་ངས་ཤེས་ཀྱི་ཡོད།",
    "ཆབ་སྲིད་གྲོས་ཚོགས་ནས་ངོ་སྤྲོད་ཞུ་དགོས་པས་ཆབ་སྲིད་གྲོས་ཚོགས་ཀྱི་ངོ་སྤྲོད་ནར་འགྱངས་ཁོ་ན་བྱས་ནས་སྤྲོད་ཀྱི་མི་འདུག་པས།",
    "དེ་ནས་ཡང་ཨ་རིར་ཕེབས་རྒྱུའི་ངོ་སྤྲོད་ཞུ་རྒྱུའི་དབུ་འཛུགས་གནང་ནས་ཡུན་རིང་ཕྱིན་ཡང་ངོ་སྤྲོད་རྩ་བ་ནས་ཕུལ་མི་འདུག་པས་རང་ཉིད་བློ་ཕམ་ཆེན་པོ་བྱུང་ཡང་བྱེད་ཐབས་ག་ལ་ཡོད།",
    "བཅུ་བཞི་བཅས་མ་གཏོགས་བྱུང་མི་འདུག།",
    "སྙེམས་བྱེད་ཞེ་སྡང་རང་གྲོལ་ན་རིགས་དྲུག་ལས་ཐར་ཞིང་ཡེ་ཤེས་ལྔ་རྟོགས་པ་དང་།",
    "ཀུན་ཀྱང་རང་བྱུང་ཞེས་པ་ལ་སོགས་པ་ཚིག་རྐང་པ་བཅུ་སྟེ།",
    "གོང་དུ་སྨོས་པ་ལ་སོགས་པ་ཀུན་ཀྱང་རང་སེམས་ཡིན་པས།",
    "གཉེན་པོ་བཅུག་ཀྱང་རང་གྲོལ་དུ་གྱུར་ན་ནི།",
    "དེ་ཡང་རང་ཡིན་ན་བསྒྲུབ་ཏུ་མེད་པ་ནི།",
    "ཞེ་སྡང་རང་སར་གྲོལ་ཞེས་པ་ལ་སོགས་པ་ཚིག་རྐང་པ་ཉི་ཤུ་རྩ་གཉིས་ཏེ།",
    "དེ་ཡང་རང་རིག་གཟུང་འཛིན་གྱི་རྣམ་རྟོག་དང་བཅས་པ་འདི་ཉིད་གཉན་ས་ཡིན་ཏེ།",
    "རང་སྣང་རང་ལ་གནོད་པ་ཡིན་ཏེ།",
    "རང་རང་གཞུང་དང་གྲུབ་པའི་མཐའ་ཡིས་ནི།",
    "གོ་རོ་ཙ་ན།",
    "ཨོཾ་ཀཱ་ལ་རཱུ་པ་འདི་གཏེར་གཞུང་དུ་མི་འདུག།",
    "ཉིད་ཐོགས་མེད་དངོས་སུ་འདུག།",
    "སང་རང་འགྲོ་དགོས་གསུང་ཞེས་གྲག་གོ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་ཞུས་ནས་ཉམས་ལེན་བྱས་པས་དོན་དཔྱོད་ཀྱི་ཤེས་རབ་ཆེན་པོར་གྱུར།",
    "དུས་ཕྱིས་ཀྱང་འདི་འབོགས་མི་ཉུང་བར་གདའ།",
    "རྨིལམ་འཛིན་པ་འདི་ལ་བྱང་ཆ་ཆེན་པོ་ཞིག་ཡོད་དེ་བར་སྐབས་ཤིག་ཏུ་འགྲིབས་འདུག་པ།",
    "བ་མ་ཆ་བས་། ཉལབྱས་པའི་མདུན་དུ་རྗེ་བཙུན་མ་བྱོན་འདུག་པས།",
    "ད་མགྱོགས་པར་འགྲོ་བར་འདུག་གསུང་།",
    "དེ་དཔའ་བོ་ཞིག་ཡིན་པར་འདུག།",
    "ཐོས་བསམ་ལ་སོགས་པ་བྱ་བའི་རིམ་བ་ཐམས་ཅད་དེདང་མཐུན་པར་བྱུང་འདུག་གསུང་ཞིང་།",
