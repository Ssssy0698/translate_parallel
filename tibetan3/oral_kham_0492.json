    "སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་ཀྱི་ཕྱག་གཡས་པར་ཌཱ་མ་རུ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངག་ཀྱང་ཐོག་མ་དང་ཐ་མ་ཨ་དམ་པ་བྱེད་པར་འགྱུར།",
    "དེང་ཕྱིན་ཆད་ཁྱེད་རང་རྣམས་རྡོ་རྗེ་སློབ་དཔོན་དུ་གྱུར་པ་ཡིན་པས།",
    "དེ་དག་དང་བྲལ་བ་ལས་སྡིག་ཆེ་བ་ཁམས་གསུམ་ན་མེད་པས་ཁྱེད་རང་རྣམས་ཀྱིས་དེ་དག་དང་མ་བྲལ་བར་བྱའོ་ཞེས་པ་ལགས།",
    "ཛྭ་ལ་ཁམུ་ཁི་པཾ་ག་ལ་ལོ་ཙ་ནི།",
    "ཡབ་ཀྱི་མགྲིན་པར་ཨོཾ་བཛྲ་བ་ར་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "དཔྲལ་བར་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "པིངྒ་ལ་ལོ་ཙ་ནི།",
    "ༀབཛྲ་བེ་རོ་ཙ་ནཱ་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "སྤྲུལ་པ་དང་རང་རྒྱུད་པའི་དཔའ་བོ་དང་།",
    "ཌཱ་ཀི་ནཱི་ཛཱ་ལ་སམྦ་རཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཛཱ་ལི་ཏ་ཏེ་ཛ་སེ་ཛྭ་ལ་མུ་ཁི་པིངྒ་ལ་ལོ་ཙ་ནི།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱཧཱུཾ།",
    "ཌཱ་ཀི་ནཱི་ཛཱ་ལ་སམྦ་རཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་བི་རོ་ཙ་ནི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཅེས་པའི་པར་བྱང་འདིའང་རང་ཉིད་ཀྱིས་སོ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཇི་ལྟར་བསྐུར་བ་ཆོ་གའི་མཚན་ཉིད་རྣམས་ཀྱང་ཐུགས་ལ་མངའ་བཞིན་ཡིན་པར་འདུག་པ།",
    "དེའང་རང་ཉིད་གཅིག་པུའི་དོན་དུ་མ་ཡིན་ཏེ།",
    "སློབ་དཔོན་འཁོར་ལོ་བདེ་མཆོག་ཡབ་ཡུམ་དུ་གསལ་བའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་ཚེ་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་བསྲེགས་ཤིང་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར།",
    "དེ་ལ་དམིགས་ཏེ་སློབ་དཔོན་གྱིས་ཧཱུྃ་ཞེས་བརྗོད་པའི་རྐྱེན་གྱིས་ཁྱེད་རང་རྣམས་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཧེ་རུ་ཀ་གསལ་བའི་དཔྲལ་བར་ཨོཾ་ལས་འཁོར་ལོ་ཨོཾ་གྱིས་མཚན་པ་ལས་སྐུ་རྡོ་རྗེ་མ།",
    "དེ་ལྟར་བྱས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་གདོད་མ་ནས་རྡོ་རྗེ་གསུམ་གྱི་ངོ་བོར་གནས་པ་དེ་ཆོ་ག་འདིས་ངོ་སྤྱད་ཅིང་གསལ་བར་བྱས་པ་ཡིན།",
    "ཐོག་མར་དམ་ཚིག་བསྒྲག་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "གང་དག་མི་འགྲོ་བ་དེ་དག་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ལས་བྱུང་བའི་ཁྲོ་བོའི་རྡོ་རྗེ་འབར་ཞིང་རབ་ཏུ་འབར་བ་འདིས་ཁྱེད་རང་རྣམས་ཀྱི་མགོ་བོ་ཚལ་པ་བརྒྱར་འགས་པར་འགྱུར་རོ།",
    "དེ་ནས་ཕྱག་བྱ་བ་ནི་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོ་ནས་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་ཐམས་ཅད།",
    "དེ་ནས་སྡོམ་པ་གཟུང་བ་ལ་འཛིན་རྒྱུའི་སྡོམ་པ་འདི་ཡིན་ནོ་ཞེས་བསྒྲག་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ་སྟེ།",
    "ཐུགས་ཀྱི་འཁོར་ལོའི་ལྷ་ཚོགས་རྣམས་ཁ་དོག་སྔོན་པོའི་རྣམ་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ཀྱི་སྟོད་ཀྱི་ཆ་ལ་ཐིམ།",
    "ཌཱ་ཀི་ནཱི་ཛཱ་ལ་སཾ་བ་རཾ་སྭཱ་ཧཱ་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀའི་ས་བོན་གྱི་འོད་ཀྱིས་མི་བསྐྱོད་པ་དཔག་ཏུ་མེད་པ་བཀུག་ན་སྟེ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཟླ་བ་ལ་ཨོཾ་གནས་པའི་བུ་ག་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཚོར་བའི་ཕུང་པོ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་སྣ་ཚོགས་རྡོ་རྗེ་གནས་པའི་ལྟེ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པར་པདྨ་འདབ་མ་བཅུ་དྲུག་པའི་ལྟེ་བ་ནས་ཞུགས་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་སྣ་ཚོགས་རྡོ་རྗེ་བགནས་པའི་ལྟེ་བ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གཟུགས་ཀྱི་ཕུང་པོ་མི་དམིགས་ཏེ་སྟོང་པར་གྱུར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཨོཾ་མགོ་ཐུར་བསྟན་དུ་གནས་པའི་བུ་ག་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོང་པར་གྱུར།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོང་པར་གྱུར།",
    "དེང་ཕྱིན་ཆད་ཁྱེད་རང་རྣམས་རྡོ་རྗེ་སློབ་དཔོན་དུ་གྱུར་པ་ཡིན་པས།",
    "དེ་དག་དང་བྲལ་བ་ལས་སྡིག་ཆེ་བ་ཁམས་གསུམ་ན་མེད་པས་ཁྱེད་རང་རྣམས་ཀྱིས་དེ་དག་དང་མ་བྲལ་བར་བྱའོ་ཞེས་པ་ལགས་ལུང་སྟོན་པ་དང་གཟེངས་བསྟོད་པ་གཉིས་གཅིག་ཏུ་བྱ་བ་ནི།",
    "ནཁྱེད་རང་རྣམས་བསྐྱེད་པ་རྡུལ་ཚོན་ནམ་རས་བྲིས་ཀྱི་དཀྱིལ་འཁོར་དུ་ཞུགས་ཏེ་མཐོང་།",
    "པིངྒ་ལ་ལོ་ཙ་ནི།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ད་དཔལ་འཁོར་ལོ་བདེ་མཆོག་གྲུབ་ཆེན་དྲིལ་བུ་ལུགས་ཀྱི་ཕྱི་རྡུལ་ཚོན་གྱི་ཆོ་གའི་མངོན་དཀྱིལ་གཉིས་ལྷན་ཅིག་ཏུ་བཀོད་པ་དེས་དོན་གསལ་བའི་སྒྲོན་མེ་ཞེས་། གཅིག་དུསབྱ་བ་བཞུགས་སོ།",
    "སེམས་དེ་ཡང་རང་བཞིན་ཅི་ཡང་མ་གྲུབ་པའི་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་བི་རོ་ཙ་ནི་སོགས་ལན་གསུམ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་སྟན་ལ་འདུག་ཁ་ཤར་དུ་ཕྱོགས་པས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་སོགས་དང་།",
    "དེ་ཡི་མདུན་ན་བདག་འདུག་སྟེ།",
    "མགྲིན་པར་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "སྐྱེས་པ་རབས་ཀྱི་རྒྱུད་ལས་རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཇི་ལྟར་བསྐུར་བ་ཆོ་གའི་མཚན་ཉིད་རྣམས་ཀྱང་ཐུགས་ལ་མངའ་བཞིན་ཡིན་པར་འདུག་པ།",
    "དེའང་རང་ཉིད་གཅིག་པུའི་དོན་དུ་མ་ཡིན་ཏེ།",
    "སློབ་དཔོན་དཔལ་འཁོར་ལོ་བདེ་མཆོག་ཡབ་ཡུམ་དུ་གསལ་བའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་ཚེ་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ལ་། ཅད་བསྲེགས་ཤིང་སྦྱངས་ཏེ་ལུས་འོད་ཀྱི་གོང་བུར་གྱུར།",
    "དེ་ལ་དམིགས་ཏེ་སློབ་དཔོན་གྱིས་ཧཱུྃ་ཞེས་བརྗོད་པའི་རྐྱེན་གྱིས་ཁྱེད་རང་རྣམས་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
    "སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་ལ།",
    "ཞེས་ལན་བཏབ་ནས་སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་ལ་སྡོམ་པ་བསྒྲགས་པ་འདི་ལ་གསན་པས་ཁྱབ་སྟེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་གསང་བ་ཆེན་པོ་ཡོངས་སུ་འཛིན་པར་སྤྲོའམ་ཞེས་དྲི་བ་ནི།",
    "སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་ཀྱི་ལག་པ་ནས་བཟུང་སྟེ།",
