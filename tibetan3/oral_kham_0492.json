    "འདི་ལ་དབལ་མང་གསན་ཡིག་ཏུ་ལུང་མེད་ཀྱི་རྟགས་མེད་ཀྱང་ཛ་ཡའི་གསན་ཡིག་ཏུ་ལུང་མེད་བྱས་འདུག་པས་དེ་ལྟར་ཡིན་འདུག་གསུངས།",
    "མཚམས་འདིར་ཅོ་དཔར་ན་མེད་ཀྱང་གཞན་དུ་ལས་མཁན་ཏེའུ་ལོ་བའི་རྟོག་པ་འདུག་པ་རྭ་པོད་ཀྱི་སྐབས་སུ་གསན་པས་ལུང་རྒྱུན་ཡོད།",
    "དབལ་མང་གསན་ཡིག་ཏུ་འདི་གཉིས་ཞེས་པ་ཕྱི་མ་འདི་གཉིས་ཡིན་འདུག་ཀྱང་སྦྲེལ་མཚམས་ནོར།",
    "དཔེ་རྙིང་སོགས་སུ་དགྲ་ལས་རྒྱལ་ཞེས་པ་ལས་རྣམ་མི་འདུག་པ་རྒྱ་སྐད་སོར་བཞག་འགྱུར་བ་འདྲ་སྟེ།",
    "ལྷན་སྐྱེས་ལ་གཞུང་ཆུང་གཉིས་འདུག་པའི་གཅིག་ཤོས་ལ་ལུང་མེད་ཀྱང་ལུང་ཡོད་པ་གང་ཡིན་མ་ཤེས་པས་གཉིས་ཀ་གནང་སྲོལ་འདུགབརྒྱུད་པ་ནི་ཀློང་རྡོལ་གྲུབ་ཆེན་ཡན་ཚོལ།",
    "འཇིགས་བྱེད་བཅུ་གསུམ་མའི་སྒྲུབ་ཐབས་རྡོ་རྗེའི་འོད་བེ་རོ་ཙ་ན་རཀྵི་ཏའམ་སྣང་མཛད་སྲུང་བས་མཛད་པའི་བརྒྱུད་པ་ནི།",
    "པར་ལ་འཁོད་འདུག་ཀྱང་དོན་དུ་ཕ་བོང་ཁ་པ་འཇམ་དབྱངས་གྲགས་པས་མཛད་པའི་དབུ་ཅན་ཀུན་མཁྱེན་གྱིས་མཛད་པར་གྲགས་པས་འདིར་གསུང་འབུམ་ཁྲོད་དུ་བྲག་རི་ཁྱབ་བདག་རྡོ་རྗེ།",
    "འཇམ་དབྱངས་དམར་སེར་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་བློ་གྲོས་རྒྱས་བྱེད་ཀྱི་ཀཀ་ཀཀརྗེ་བཙུན་དཀོན་རྗེ་བཙུན་དགེ་༢༧༨སྨྱུ་གུ་ལ།",
    "འཁོར་ལོའི་མགོན་པོ་བདེ་ཡིག་ཏུ་ཆད་འདུག་ཀྱང་ལུང་ཡོད་གསུངས།",
    "༦ འདིའི་ལུང་གནང་རྒྱུན་འདུག་ཀྱང་བརྒྱུད་པ་དཔྱད་དགོས་སོ།",
    "༡ རྡོ་རྗེ་འཆང་རང་ཉིད་ལས་ཀྱང་ཐོབ།",
    "འདི་མན་མ་ཕྱིར་མི་འདུག་བློ་བཟང་རྒྱལ་བ་ཀུན་གྱི་འཕྲིན་ལས་དཔལ།",
    "ཡང་རང་ཉིད་ཞེ་སྡང་ལ་རྡོ་རྗེ་ཞེས་པའི་དབུ་ཅན།",
    "ལྟ་བའི་ཟིན་བྲིས་དང་རང་བཞིན་གྱིས་གྲུབ་ལ་པར་འཛིན་པ་དང་།",
    "༡༢ འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "ལ་བཅངས་པའི་ཀླུ་འབྲོས་ཤིང་རངས་པ་དང་།",
    "བེ་རོ་ཙ་ནའི་སྦས་པ་མིག་འབྱེད་ཀྱི་སྐོར་དང་ཕ་འདར་གྱི་རྟགས་ཅན་རྣམས་དང་།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "བརྒྱུད་པ་སྒྲུབ་པ་ཆར་དབབ་པ་སྟེ་དོན་གསུམ་གྱིས་བསྟན་པའི་ཀླུའི་རྒྱལ་པོ་ཝ་རུ་ཎའི་ཆར་འབེབས་རྒྱ་གར་བི་རོ་ཙ་ནའི་རང་འགྱུར་དུ་མཛད་པ།",
    "༡༧ གསན་ཡིག་ལ་ཆད་འདུག་ཙ་ཏུར་མུ་ཁ་བཅུན་ཐབས་ཉི་ཟླ་ཅན་གྱི་ཤོག་དྲིལ།",
    "འདིའི་མཇུག་ན་རྣམ་སྲས་སྤྲིན་གསེབ་མ་གཏེར་མ་རྫོགས་སོ་ཟེར་བ་འདུག་ཀྱང་དེང་སང་འདི་རྙིང་མ་བཀའ་མར་ངོས་འཛིན་མཛད་པ་ཡིན།",
    "ལི་ཡུལ་དུ་སློབ་དཔོན་བི་མཱ་ལ་མི་ཏྲ་དང་ལོ་ཙཱ་པ་བེ་རོ་ཙ་ནས་བསྒྱུར་བ་དང་།",
    "ཀྱི་གསལ་བྱེད་སློབ་དཔོན་བི་མཱ་ལ་མི་ཏྲས་མཛད་པ་ལེའུ་ཐ་མའི་གསལ་བྱེད་ཅེས་གསུང་ཡང་ཚེ་སྒྲུབ་ལེའུ་དྲུག་པ་ན་འདུག་གསུངས།",
    "བེེ་རོ་ཙ་ན།",
    "གནོད་སྦྱིན་གདུག་པའི་ལས་སྦྱོར་ལ་བརྟེན་ནས་དགྲ་ལ་ཁྱི་དམག་དྲངས་པ་བི་རོ་ཙ་ནས་པཎྜི་ཏ་དྷ་ཙཎྜ་ལ་གསེར་སྲང་གང་ཕུལ་ནས་ཞུས་པ་དགྲ་ལ་བྱ་དམག་དྲངས་པའི་གདམས་པ་མཇུག་ཏུ་མི་དགོས་ན་ས་ལ་སྦའོ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "ཕྲ་རྒྱས་ཐམས་ཅད་ཀྱང་རང་ལ་དམིགས་པའི་སྒོ་ནས་ཟག་པ་རྒྱས་རུང་ཡིན་ཏེ།",
    "ཡིད་ཤེས་རྟོག་བྲལ་དུ་གྱུར་བའི་སེམས་དང་སེམས་བྱུང་རང་ཡུལ་ལ་གསལ་སྣང་དང་བཅས་ཏེ་འཇུག་ཚུལ་དང་།",
    "རྗེས་དཔག་དང་རང་དོན་རྗེས་དཔག་གཉིས་དོན་གཅིག་ཡིན་ཏེ།",
    "གནོད་འཇོམས་ཀྱི་ལུགས་དང་རང་ལུགས་གཉིས་ཀར་ཡོངས་གྲུབ་ཀྱི་མིང་མི་འདྲ་ཡང་དོན་མི་འདྲ་ཟེར་རྒྱུ་ཨེ་ཡིན།",
    "གཟུངས་ཀྱིས་ཚོགས་ལས་མཐའ་དཔྱོད་ཟུར་དུ་བྱུང་འདུག་པས་གཟུངས་དང་སྤོབས་པའི་ཁྱད་པར་ཇི་ལྟར་ཡིན།",
    "བརྩི་ཚུལ་མང་ཡང་རང་ལུགས་ལ་བཞི་སྦྲགས་མ་གཙོ་བོར་བྱེད་དགོས་ཏེ།",
    "ལས་དང་བོ་བ་ལ་ཕན་ཆེ་གསུངས་ནས་རྫས་ལྡོག་རྒྱས་པར་བཀོད་འདུག་པས་སོ།",
    "ང་རང་གཅིག་པུ་ཡིན་ན་བློ་བདེ་སེམས་སྐྱིད་ཡོང་བ་འདུག་ཟེར་བ་ལྟ་བུ་དེ་རིགས་སྤྱད་ན་ཆོག།",
    "ང་རང་གཅིག་པུས་བྱས་ན་ལས་འགན་འདི་མགྱོགས་པ་སྒྲུབ་པ་འདུག་ཟེར་བ་ལྟ་བུར་སྤྱོད་པ་ཡིན།",
    "ཡོང་བ་འདུག་སོགས་ཚིག་གྲོགས་ནི་སྐབས་དང་བསྟུན་ནས་གང་མཁོར་བསྒྱུར་ཆོག་པ་གཞན་དང་འགྲེ།",
    "བྱེད་ཀྱི་འདུག།",
    "ཐ་ན་བྱེད་མི་ཤེས་པ་གསལ་པོ་འདུག་ཅེས་རྫུས་རྟགས་བསྟན་པའམ།",
    "ཁོས་གང་ཟེར་གྱི་རྗེས་རྒྱུག་བྱེད་མཁན་རང་ཚུགས་རྩ་བ་ནས་མི་འདུག་ཟེར་བ་ལྟ་བུར་སྤྱོད་ཅིང་།",
    "སྐད་རྒྱག་ས་ཁྱེད་རང་མ་གཏོགས་མེད་ཟེར་བ་ལྟ་བུ་དེ་རིགས་ལ་སྤྱོད་པ་ཡིན།",
    "མི་དེ་ལ་གང་ལྟར་བཟང་པོ་མིན་པའི་གཡའ་ཞིག་འདུག་ཅེས་པ་ལྟ་བུར་སྤྱོད་ཅང་།",
    "གྲོགས་པོ་གཞན་དེས་འབོད་མཁན་ལ་སྣེ་ལེན་གཟབ་རྒྱས་བྱས་རྐྱེན་ཁོ་རང་ཡང་ལོག་མ་ཐུབ་པ་སོགས་དེ་ལྟ་བུར་བཞད་གད་ཀྱི་ཚུལ་དུ་སྤྱོད་པ་མང་།",
    "ཡང་ན་བཀའ་དྲིན་བསམ་ཤེས་བྱེད་ཀྱི་མི་འདུག་ཟེར་བ་མཚོན་པར་སྤྱོད་པ་ཡིན།",
    "མི་འདུག་ཟེར་བ་ལྟ་བུར་སྤྱོད་པ་ཡིན་ཞིང་།",
    "འགོ་གཙོས་རྟག་པར་མ་འགྲིག་མ་འཐུས་པ་ཁོ་ན་ཤོད་ཀྱི་འདུག་ཟེར་བ་ལྟ་བུ་དེ་རིགས་ལ་སྤྱོད་པའོ།",
    "ཀྱང་ཉན་གྱི་མི་འདུག་ཟེར་བ་ལྟ་བུར་སྤྱོད་པ་ཡིན།",
