    "སེལ་ཅིང་སྐད་སྙན་ཡི་ག་འབྱེད་པར་བྱེད།",
    "དེ་ཕྱིར་བརྩོན་པས་ལེཊ་པར་བཅོས་པར་བྱ།",
    "གང་གས་མེ་བཞིན་འཇོམས་པར་བྱེད་པ་ཡིན་ ཚ་རིམས་བཅོས་པའི་ལེའུ་སྟེ་བཅོ་བརྒྱད་པའོ།",
    "ཉཱར་བབས་ཧྭ་ལོག་ཤར་བབས་ལྷོག་པར་བཤད།",
    "ཨེར་མས་ཨིག་ཏུ་བཙུད་པས་ཚུད་པར་འགྱུར།",
    "ལོང་རྩ་གཏར་ཞིང་མངལ་བཤལ་བྱས་པས་ཕན།",
    "གླ་རྩིའི་ཆུ་སྦྱིན་ས་བདག་ཐུབ་པར་འགྱུར།",
    "གང་ཡིན་རྟགས་ཀྱིས་ལེགས་པར་ངོས་བཟུང་ལ།",
    "ཆུ་ལྕག་སྐར་ཆུ་བུམ་པར་བླུགས་པ་བསྒྲེང་།",
    "བུ་ལ་གོས་ནས་མི་གཙང་གདོན་རྐྱེན་གྱིས།",
    "རྒྱུས་པར་ཡན་ལག་བརྒྱད་པར་ཤེས་པར་བྱ།"
  ]
}