    "གཟུགས་དང་ཚོར་བ་སོགས་ཀྱི་རང་བཞིན་རྣམ་པར་དག་པར་བསྒོམས་པས་སྒྲིབ་པ་སྤོང་བའི་རྒྱུར་གྱུར་པ་ནི་རྣམ་པར་དག་པ་དང་།",
    "བུད་དྷ་ཤྲཱིས་ས་མཚམས་དེ་ལྟར་བྱས་པར་འཆད་པ་ནི་དེའི་འགྲེལ་པ་ན་མེད་ལ་རང་བཞིན་དང་གནས་སྐབས་སུ་བྱེད་ནའང་ཉི་ཤུ་པ་གནས་སྐབས་སུ་བྱེད་པ་ནི་བུད་དྷ་ཤྲཱིའི་ནོར་བའི་རྗེས་སུ་འབྲངས་པའོ།",
    "སྦྱོར་བ་དེ་དག་གི་གོ་རིམ་ཡང་རྒྱན་སྣང་ལས།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཞི་ཆར་གྱིས་ཐུན་མོང་དུ་སྦྱར་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཞེས་ཤེས་པར་བྱའོ།",
    "སྦྱོར་བའི་འོག་ཏུ་སྦྱོར་བ་དེ་དག་གི་ཕན་ཡོན་དུ་གྱུར་པའི་ཡོན་ཏན་གསུངས་ཏེ།",
    "ཡོན་ཏན་འདི་དག་ནི་ལས་དང་པོ་པའི་ས་ནས་བརྩམས་ཏེ་ལྡན་མོད་ཀྱི་ལེགས་པར་འབྱོར་བ་ནི་དྲོད་ཐོབ་པ་ཡན་ཆད་ལ་སྦྱར་བར་བྱ་སྟེ་ཞེས་པ་ལྟར་ཁས་བླང་ངོ།",
    "སྦྱོར་བ་ཉི་ཤུ་སོགས་སུ་ཡང་མ་ངེས་པར་ཧ་ཅང་ཐལ་ལོ།",
    "ཡུམ་ཟབ་མོ་འདི་འདྲི་བ་དང་སྟོན་པ་དང་འཆང་བ་དང་ཀློག་པ་དང་ཁ་ཏོན་བྱེད་པ་དང་།",
    "གཞན་ནི་བར་ཏ་ནི་ནི་ཤར་ཕྱོགས་དང་བྱང་གི་ཕྱོགས་རྒྱ་ཡུལ་ལ་སོགས་པ་ལ་འཆད་དོ།",
    "དེ་རེ་རེ་ལ་ལེའུ་རེ་རེར་བྱས་པས་བཅུ་སྟེ།",
    "ལུང་གི་ལེའུ་གསུམ་པོ་རེ་རེ་ལ་གསུམ་གསུམ་སྟེ་དེ་ཡང་དགྲ་བཅོམ་ཕྱིར་མི་འོང་རྒྱུན་ཞུགས་ཀྱི་ལེའུ་གསུམ་དང་།",
    "དེ་ཁྱད་པར་བསྐྱེད་པའི་དོན་དུ་སྤྱན་རྣམས་ཀྱི་ཡེ་ཤེས་ཀྱིས་གཟིགས་པ་དང་།",
    "འོག་མ་འདི་དག་ལ་ཡོན་ཏན་དང་འབྱུང་ཞིང་ཞེས་དང་སྔ་མ་རྣམས་ལ་འཐོབ་པ་ཞེས་པ་སྦྱོར་བ་ནི་གཞུང་གི་གཅོད་མཚམས་མ་དག་པའོ།",
    "ཡོན་ཏན་དེའི་འོག་ཏུ་སྦྱོར་བ་དེ་དག་གི་བར་ཆད་དུ་འགྱུར་བའི་སྐྱོན་གསུངས་ཏེ།",
    "ཚེགས་ཆེན་པོས་ཡུན་རིང་མོ་ནས་ཡུམ་ཤེས་པ་འཐོབ་ཅིང་དེས་སྐྱོ་བ་དང་།",
    "ལུས་རྣམ་པར་འགྱུར་བའི་ཀླལ་བ་ཧ་ཧ་ཞེས་པ་རྒོད་པ་ལུས་སམ་ལུས་དང་འབྲེལ་བས་གཞན་ལ་ཀུ་རེ་བྱེད་པའི་སྟེགས་བཞིན་དུ་འདྲི་བ་སོགས་བྱེད་པའི་ལུས་ཀྱི་གནས་ངན་ལེན་ཏེ་དེའི་རྣམ་གཡེང་དང་།",
    "འདི་དག་གི་གནས་ངན་ལེན་དུ་བཞག་པ་ནི་ཕྱོགས་གཅིག་པའོ།",
    "གྱ་ནོམ་པའི་རོ་འབྲས་བུ་མཆོག་གི་བདེ་བ་མྱང་བ་ལས་ཉམས་པ་སྟེ།",
    "ཉི་ཟླའི་དཀྱིལ་འཁོར་གྱི་ཚད་ཀྱིས་རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་གི་ཚད་དང་མཉམ་པའི་ཁང་བཟང་བྱེད་འདོད་པའི་ཕྱྭ་མཁན་ནམ་ཤིང་བཟོ་མཁན་བཞིན་དུ་རྣམ་མཁྱེན་གྱི་རྒྱུ་དང་འབྲས་བུ་འབྲེལ་བ་སྟེ་དེ་གཉིས་རྗེས་སུ་མཐུན་པ་ལས་ཉམས་པ་དང་།",
    "བསོད་སྙོམས་པ་ལ་སོགས་པ་སྦྱངས་པའི་ཡོན་ཏན་བཅུ་གཉིས་དང་ལྡན་པ་དང་དེ་དང་མི་ལྡན་པ་དག་གིས་དང་།",
    "སྦྱིན་སོགས་ཀྱིས་ཕྱིན་དྲུག་དང་ལྡན་ཞིང་དེ་ལ་སློབ་པར་འདོད་པ་དང་དེ་ལས་བཟློག་པས་དེ་དང་མི་ལྡན་པས་ཏེ་ཞེས་བྱ་བ་རེ་རེའི་མཐར་ཡང་སྦྱར་བ་ནི་བཅུ་ཚན་གསུམ་པའོ།",
    "ཚིག་དོན་མི་བརྗེད་པའི་གཟུངས་ཐོབ་པ་དང་དེ་མ་ཐོབ་པ་དག་གིས་དང་།",
    "ཡུམ་ཡི་གེར་འདྲི་བ་ནས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའི་བར་དུ་འདོད་པ་དང་དེའི་བར་དུ་མི་འདོད་པ་དག་གིས་དང་།",
    "འདོད་པའི་འདུན་པས་མཚོན་པའི་གནོད་སེམས་དང་གཉིད་རྨུགས་དང་རྒོད་འགྱོད་ཐེ་ཚོམ་གྱི་སྒྲིབ་པ་ལྔ་དང་བྲལ་བ་དང་དེ་ལྔ་དང་མ་བྲལ་བ་ཉིད་ཀྱིས་ཏེ་ཞེས་བྱ་བ་རེ་རེའི་མཐར་སྦྱར་བ་བཞིའོ།",
    "གང་ན་སྲོག་གི་བར་ཆད་དུ་འགྱུར་བའི་ཕྱོགས་སུ་འགྲོ་བར་འདོད་པ་དང་དེར་འགྲོ་བར་མི་འདོད་པ་སྟེ་ཞེས་བྱ་བ་རེ་རེའི་མཐར་སྦྱོར་བ་བཞི་སྟེ།",
    "ཞེས་བྱ་བ་རེ་རེའི་མཐར་སྦྱར་བ་གསུམ་མོ།",
    "ངན་སོང་གསུམ་གྱི་བཀྲེས་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་བརྗོད་ན་གཞན་དོན་དུ་ངན་སོང་གི་འགྲོ་བར་འགྲོ་བ་ལ་ཕྱིར་ཕྱོགས་པ་སྟེ་མི་མོས་ཤིང་སྐྱོ་བ་དང་།",
    "སྤྱི་དང་ཡན་ལག་གི་དོན་ནོ།",
    "ཀུ་མཱ་ར་ཤྲཱི་ན་རེ།",
    "ཤེར་འབྱུང་གིས།",
    "དེ་ལྟ་ཡིན་ན་ཡང་སྦྱོར་བའི་ངོ་བོ་ཉིད་རྣམས་ཀྱི་ངོ་བོ་ཡིན་པའམ་དེ་སྔོན་དུ་སོང་བར་སྒྲུབ།",
    "གཞན་ཡང་ཤེས་པའི་མཚན་ཉིད་དུ་འགྲོ་རྒྱུ་ཡང་སྦྱོར་བའི་སྟེང་གི་ནུས་པ་ལ་འདོད་ན་སྦྱོར་པའི་རང་བཞིན་གྱིས་རང་བཞིན་མཚོན་པར་སོང་ལ་དེ་ལྟ་ན་མཚན་ཉིད་དང་པོ་གསུམ་ལ་བྱེད་མཚན་དང་ཐ་མ་ལ་ལས་མཚན་དུ་གསུངས་པ་མི་རིགས་ཏེ།",
    "མེའི་ཚ་བ་ལྟ་བུ་རང་ཉིད་གཞན་དང་ཐུན་མོང་མ་ཡིན་པར་མཚོན་པ་རང་གི་མཚན་ཉིད།",
    "གཞན་ཡང་འདི་ལས་མཁྱེན་པ་གསུམ་གས་ཡུམ་གྱིས་དེ་བཞིན་གཤེགས་པ་སྐྱེད་པའི་ཆེ་བ་ཤེས་པར་བྱེད་ན་གཞི་ཤེས་ཀྱིས་ཆོག་པས་གཞན་གཉིས་དོན་མེད་དོ་སྙམ་པ་ལ་ཤེས་པར་བྱེད་པར་མཚུངས་ཀྱང་དེ་དག་གི་ཁྱད་པར་འདིའོ་ཞེས་ཁྱད་མཚན་གྱིས་སྟོན་ཞེས་འཆད་པ་ནི།",
    "ཤིན་ཏུ་ཡང་མི་རིགས་ཏེ་ཁྱད་མཚན་གྱིས་དམན་མཆོག་གི་ཁྱད་ཆེ་བ་ནི་ཉན་རང་དང་ཐེག་ཆེན་གྱི་ཡིན་ལ།",
    "དེ་ཡང་བྱ་རོག་གིས་ཁང་བཟངས་མཚོན་པ་ལྟར་དེའི་སྒོ་ནས་ཤེས་པར་བྱས་པ་ཙམ་མོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་མཚོན་ཚུལ་ལོ།",
    "གང་གིས་འཚེད་པ་བྱ་བྱེད་དང་འབྲེལ་བའི་ཚིག་ཡིན་པས་དེ་གཉིས་སུ་དྲང་དུ་རུང་བ་བཞིན་དུ།",
    "མཚན་ཉིད་ཅེས་པ་ཡང་གང་གིས་མཚོན་པ་དང་གང་མཚོན་པའི་བྱ་བྱེད་གཉིས་ཀ་དང་འབྲེལ་བ་ལ་དགོངས་ནས་རྗེ་བཙུན་གྱིས་དང་པོ་གསུམ་གང་གིས་མཚོན་བྱེད་དང་ཐ་མ་གང་མཚོན་བྱ་རུ་མཛད་དོ།",
    "སྟ་རེ་དང་ཤིང་ལྟ་བུ་གཅོད་བྱེད་དང་གཅད་བྱ་ཡུལ་ཅན་དང་ཡུལ་ལྟ་བུ་རིག་བྱེད་དང་རིག་བྱ་སོགས་ལ་བྱེད་སྒྲུབ་དང་ལས་སྒྲུབ་ཏུ་འཇོག་པས་མཐའ་ཡས་སོ།",
