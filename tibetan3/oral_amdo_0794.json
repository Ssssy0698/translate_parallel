    "ལྕགས་སམ་རྫའི་སྣོད་དུ་ཁྲག་ཕལ་པ་བསྲེས་པའི་ཨརྒ་སོགས་དྲག་པོའི་མཆོད་རྫས་ཐུན་མོང་བ་རྣམས་དང་།",
    "མི་ཐོད་ཀྱི་སྣོད་དུ་ཁྲག་ཆེན་གྱིས་ཨརྒ་མཆོད་རྫས་ཁྱད་པར་བ་རྣམས་དང་སྤྱན་གཟིགས་དང་བསྐང་རྫས་སྣ་ཚོགས་བཤམ།",
    "དེའི་ནང་དུ་དམ་ཚིག་གི་རྫ་ས་རྣམས་གོ་ཀུ་དྷ་ཧ་ན་དང་བི་ར་ཤུ་མ་མུ་རྣམས་ལས་ཤ་ལྔ་དང་བདུད་རྩི་ལྔ་སོ་སོའི་ས་བོན་གྱིས་མཚན་པར་གྱུར།",
    "དེའི་སྟེང་དུ་ཨོཾ་ཨཱ་ཧཱུྃ་གི་འོད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཐུགས་ཀ་ནས་པཾཤེས་ཀྱི་བདུད་རྩི་བཀུག།",
    "སྟེང་བསྐལ་པའི་མེ་དཔུང་དུ་འབར་ཞིང་འོག་ཤ་ཁྲག་གི་རྒྱ་མཚོར་འཁྲུག་པ།",
    "ཧཱུཾ་ལས་གྲི་གུག་ཧཱུཾ་གིས་མཚན་པ་ལས་འོད་ཟེར་འཕྲོས།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱི་གཡས་གྲི་གུག་འཕྱར་ཐབས་སུ་འཛིན་ཞིང་གཡོན་ཐོད་པ་ཁྲག་གིས་གང་བ་ཐུགས་ཀར་འཛིན་པ།",
    "རབ་ཏུ་འཇིགས་པའི་སྐུ་ཡན་ལག་རྒྱས་ཤིང་སྦྲུལ་ཆེན་པོ་བརྒྱད་དང་རུས་པའི་ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་པ།",
    "གསུས་ཁྱིམ་འཕྱང་ཞིང་སྟག་གི་ལྤགས་པའི་ཤམ་ཐབས་གསོལ་བ།",
    "སྐེད་ལ་གསེར་སྐུད་དང་སྟག་རལ་གཟིག་ཤུབས་ཀྱིས་མཛེས་ཤིང་ཞབས་ལ་སག་ཏི་ཡུ་རིང་གསོལ་བ།",
    "གླང་པོ་ཆེའི་ཀོ་རློན་གྱི་སྟོད་གཡོགས་དང་རེ་ལྡེའི་སྨད་གཡོགས་བྱས་ཤིང་སྦྲུལ་གྱི་ཆུན་པོའི་སྐེ་རགས་བཅིངས་པ།",
    "ཐུགས་ཀར་ཧཱུཾ་ལས་རྡོ་རྗེ་སྔོན་པོ་ཧཱུཾ་གིས་མཚན་པའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས།",
    "དུར་ཁྲོད་ཆེན་པོ་བསིལ་བའི་ཚལ་དང་ཨུ་ཙ་ལ་ནས་དཔལ་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ལ་བསྟན་སྲུང་དམ་ཅན་རྒྱ་མཚོའི་ཚོགས་དཔག་ཏུ་མེད་པས་བསྐོར་བ་སྤྱན་དྲངས་ཞེས་མོས་ཏེ།",
    "རྒྱ་མཚོ་གླིང་གི་དུར་ཁྲོད་ནས།",
    "ཚུར་བཤེགས་ཚུར་གཤེགས་ལྷ་མོ་ཆེ།",
    "ཚུར་གཤེགས་མ་མོ་རྣམས་ཀྱི་གཙོ།",
    "ཚུར་གཤེགས་ལྷ་ཆེན་སྲས་མོ་ཆེ།",
    "ཚུར་གཤེགས་བསྟན་བསྲུངས་ནག་མོ་ཆེ།",
    "ཨོཾ་ཨཱ་ཨྰ་ཧཱུྃ་སྭཱ་ཧཱ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཛྙཱ་ན་བཛྲ་སརྦ་བུད་དྷ་ཀཱ་ལ་ཝཱཀྵིཏྟ་བཛྲ་ཨ་བྷི་ཥིཉྩ་ཧཱུཾ་ཞེས་བྱིན་གྱིས་བརླབ།",
    "རྩུབ་འགྱུར་རེག་བྱ་སྣ་ཚོགས་འབུལ།",
    "ཐོད་རྔ་རྐང་གླིང་རོལ་མོའི་དབྱངས།",
    "མི་ལྤགས་གཡང་གཞིའི་བླ་རེ་བྲེས།",
    "མི་རོ་རེངས་པའི་རྒྱལ་མཚན་བསྒྲེང་།",
    "མི་ནག་གིང་པོ་དགྲ་ལ་རྔམ།",
    "རྡོ་རྗེ་གཏུམ་པོ་ཁྱོད་ལ་བསྟོད།",
    "ཁྱོད་ཀྱི་སྐུ་ལས་སྤྲུལ་པ་ཡི།",
    "འབྲུག་དབྱངས་སྒྲོག་པ་ཁྱོད་ལ་བསྟོད།",
    "རེ་འགའ་ཞལ་གཅིག་ཕྱག་བཞི་པ།",
    "སྤྲུལ་པ་མང་པོ་སྟོན་ཁྱོད་བསྟོད།",
    "སྲིད་གསུམ་རྒྱུ་བའི་ཕོ་ཉ་མོ།",
    "ནག་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་མ།",
    "དུར་ཁྲོད་ཉུལ་བྱེད་ཁྱོད་ལ་བསྟོད།",
    "རེ་འགའ་ཞལ་གཉིས་ཕྱག་བཞི་མ།",
    "གླང་ཆེན་གོས་དང་རེ་ལྡེས་དཀྲིས།",
    "དེ་ནས་རང་གི་ཐུགས་ཀར་ཉི་མའི་སྟེང་དུ་ཧཱུཾ་གི་མཐར་བཟླ་བྱའི་བསྙེན་སྔགས་ཀྱིས་བསྐོར་བར་བསམ།",
    "འཁོར་གཉིས་ཀྱི་ཐུགས་ཀར་ཉི་མའི་སྟེང་དུ་ལས་མགོན་ལ་རཾ་དང་ལྷ་མོ་ལ་བྩོ་ནག་པོའི་མཐར་སོ་སོའི་བསྙེན་སྔགས་ཀྱིས་བསྐོར་བར་དམིགས་ནས་སྔགས་བཟླས་པས།",
    "ཐུགས་ཀྱི་དངོས་གྲུབ་དང་བཅས་པའི་སྔགས་ཕྲེང་ཐུགས་ཀ་ནས་ཐོན་པ་རང་གི་ཐུགས་ཀར་ཞུགས་ཏེ་སྔགས་ཕྲེང་ལ་ཐིམ།",
    "ༀམ་ཧཱ་ཀཱ་ལི་ཏྲག་རཀྴ་རཀ་མོ་དུན་བྷྱོ་ཛ་ཛ།",
    "མ་ཧཱ་ཀཱ་ལི་རཀ་མོ་རྦི་ཤ་ཀུ་རུ་ཐཾ་རྦད།",
    "མ་ར་ཡ་མྱོགས་མྱོགས་ལིང་ལིང་ཆེ་གེ་མོ་མ་ར་ཡ་ཛ།",
    "ས་མ་ཡ་ཆེ་གེ་མོ་ནི་ཛ་ཛ།",
    "ལྷ་མོ་སྤྱིའི་སྔགས་སོ།",
    "ༀ་མ་ཧཱ་ཀཱ་ལི་ཏྲག་རཀྴ་རཀ་མོ་ཨེ་དམ་སོགས་ཀྱིས་གཏོར་མ་འབུལ།",
    "ༀམ་ཧཱ་ཀཱ་ལ་ཡཀྵ་སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་ཨཉྙཾ་ཁཱ་ཧི་ཞེས་དང་།",
    "པཉྩ་ཨ་མྲྀ་ཏའི་མགོན་པོ་གྲི་གུག་ཅན་གཙོ་འཁོར་གསུམ་པའི་བསྐང་གསོའི་ལས་འགྲིགས།",
    "གལ་ཏེ་ཞི་བར་མ་གྱུར་ན་མངོན་སྤྱོད་དྲག་པོའི་ཕྲིན་ལས་ཀྱིས་བསད་ཅིང་བཅད་པ་དང་བསྐྲད་ཅིང་དབྱེ་བ་དང་རྨོངས་ཤིང་རེངས་པ་དང་།",
    "འཇིགས་པའི་གད་མོས་རི་རབ་བསྒྱེལ།",
    "ནག་པོ་ཁྱོད་ནི་ཡིན་པ་སྟེ།",
    "སྟེང་གི་ལྷ་ཚོགས་འཇིགས་པར་བྱེད།",
    "ཁྱོད་ཀྱིས་ཐུབ་པའི་བསྟན་པ་སྲུངས།",
    "གཏུམ་པའི་སྡང་མིག་གློག་གིས་གནོད་བྱེད་བསྲེག།",
    "སྤྲུལ་པའི་མོན་པ་ཕོ་མོས་ས་གཞི་འགེངས།",
    "སྟག་རལ་གཟིག་ཤུབས་གསེར་སྒ་འབར་བས་བརྒྱན།",
    "རབ་བརྗིད་དབྱངས་ཀྱི་ང་རོས་ཁྱོད་བསྟོད་ན།",
    "རྒྱན་དུ་རྐང་སྒྲོག་ལྕགས་ལས་བྱས་པ་ཞིག་གིས་རང་གི་རྐང་པ་མཛེས་པར་བྱས་པ་སྟེ།",
    "ལྷ་མོ་ཁྱོད་ཉིད་ཀྱིས།",
