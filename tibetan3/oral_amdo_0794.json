    "མ་བྱིན་པར་ལེན་པ་དག་གིས་བརྐུས་སོ།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དགེ་སློང་ཞིག་གིས་བགོ་བ་དག་ཁྱེར་ཏེ་དགེ་སློང་དག་དང་ལྷན་ཅིག་ཏུ་བྲོས་ཏེ་དོང་བ་དང་།",
    "དེས་སྨྲས་བ་གང་གི་ཚེ་བསྒོ་བར་བགོས་པ་དེའི་ཚེ་ན་ནི་ཁྱོད་རྒན་པོས་ཁྱེར་ལ་ད་བཀུར་བའི་ཚེ་ནི་ང་ལ་སྦྱིན་ནམ་ཁྱོད་ཉིད་ཁྱེར་ཅིག།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "གང་གིས་འཇིགས་པའི་ཚེ་ཁྱེར་ཁྱེར་བ་དེ་ཉིད་ཀྱིའོ།",
    "གང་གི་ཚེ་འཇིགས་པ་མེད་པར་གྱུར་ན་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ངོ་ཞེས་སླར་མ་ཕུལ་བ་དང་།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་པས་བཅོམ་ལྡན་འདས་ལ་དེ་སྟེ་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ན་བདག་གིས་དུས་སྟོན་ཆེན་པོ་བགྱིའོ་ཞེས་གསོལ་བ་དང་།",
    "ཁྱིམ་བདག་ངས་གནང་གིས་བྱོས་ཤིག།",
    "དགེ་སློང་དག་རྔ་དང་དུང་དག་གི་སྒྲས་བརྡེགས་ན་ཚོལ་བར་འཁོད་དོ།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དགེ་སློང་དག་གིས་དེ་བཞིན་དུ་བྱས་པ་དང་ཁྱིམ་བདག་ནི་བཟའ་བ་འཕྲིམ་པ་ལ་རྐུའོ།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་གསོལ་པ་དང་།",
    "དེ་དེར་བསོད་སྙོམས་ལ་ཞུགས་ན་དེ་ན་གཞན་ཞིག་གིས་དེ་ལ་འཕགས་པ་ཁྱིམ་འདི་ན་དགེ་སློང་མ་དག་བཤོས་གསོལ་ཞིང་འཁོད་ཀྱིས་དེར་བཞུད་ཅིག་ཅེས་སྨྲས་པ་དང་།",
    "དེ་སྐྱེངས་ནས་དེས་བསམས་པ་དེ་སྟེ་བདག་གིས་སྦྱིན་པའི་ཡོན་ཏན་བརྗོད་ཀྱི་བར་དུ་འདུག་ན་ནི་འགྲོན་པ་མང་པོ་དག་ཀྱང་དང་བར་འགྱུར་གྱིས་ཕྱོགས་གཅིག་ཏུ་ཟན་ཟོས་ཏེ་འགྲོའོ་སྙམ་ནས་ཕྱོགས་གཅིག་ཏུ་ཟན་ཟོས་ཏེ་སོང་ངོ།",
    "དགེ་སློང་དག་གིས་ཚེ་དང་ལྡན་པ་བདེ་པར་འོངས་སམ།",
    "དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དགེ་སློང་དག་གིས་ཇི་ལྟར་བྱ་བ་མི་ཤེས་ནས།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "འཕགས་པ་དག་རིན་ཐང་ཆོད་ཅིག་དང་བདག་གིས་གླུང་གསོལ་ལོ།",
    "དྲུག་སྟེ་དག་གིས་དལ་འགྲན་ཅིང་སྦེལ་བ་ལ་ཞུགས་པ་དང་།",
