    "འབྲས་བུའི་ཕན་ཡོན་གྱི་ཁྱད་པར་རྣམ་པ་གཉིས་སུ་རིག་པར་བྱའོ།",
    "གཡོ་བར་བྱེད་པ་ཉིད་ཀྱིས་ནི་གདུལ་བྱ་རྣམས་འདུན་པར་བྱེད་ད་དོ།",
    "སྐྱེ་བའི་ཁྱད་པར་ཡོངས་སུ་འཛིན་པས་ནི་བསྐལ་པ་བརྒྱར་གནས་པར་བྱེད་ད་དོ།",
    "དོན་མྱུར་བར་བྱེད་པར་སྦྱོར་བར་རིག་པར་བྱའོ།",
    "སྤྱན་ལྔ་པོ་ཐམས་ཅད་ཡིན་པར་རིག་པར་བྱའོ།",
    "རང་བཞིན་རྣམ་པར་ད་ག་པའོ།",
    "ཆེ་བ་ཉིད་ཀྱི་བསམ་པ་ཞེས་གསུངས་པའོ།",
    "དེ་ཡང་རྣམ་པ་དགུར་རིག་པར་བྱ་སྟེ།",
    "དུལ་བ་དྲང་བའི་བསམ་པ་ནི་བརྗེད་ཀྱང་ཉེས་པར་འཁྲུལ་པ་མེད་པ་སྟེ།",
    "ཞི་བ་དྲང་བའི་བསམ་པ་ནི་ང་རྒྱལ་མེད་པས་དེས་ཁེངས་པར་མི་འགྱུར་བའི་ཕྱིར་ར་རོ།",
    "མ་འདྲེས་པ་ལས་༢དྲང་བའི་བསམ་པ་ནི་དེ་ཙམ་གྱིས་ཆོག་པར་མི་འཛིན་པ་སྟེ།",
    "བྱམས་པའི་སེམས་དང་ལྡན་ཏེ་ཞེས་གསུངས་པའོ།",
    "དེ་ཀུན་དུ་རྟོག་༤པ་ཙམ་གྱིས་ཀྱང་སྲོག་ཆགས་རྣམས་༥ལ་རྣམ་པར་འཚེ་བར་མི་བྱེད་ན།",
    "གནོད་པར་བྱེད་པའི་དངོས་པོ་དབྱིག་པ་དང་།",
    "ཁམས་མི་མཉམ་པར་བྱེད་པའི་གནོད་པའི་བར་དག་ཀྱང་གནོད་པར་བྱེད་པ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "དེ་དག་འབྲས་བུ་དེ་ཐོབ་པར་སྨོན་པས་བྱམས་པའི་སེམས་ཏེ།",
    "བྱམས་པའི་སེམས་ད་ང་ལྡན་ཏེ་ཞེས་གསུངས་པའོ།",
    "དེ་ལྟར་ཕྱིན་ཅི་མ་ལོག་པར་རྒྱུ་དང་འབྲས་བུ་འདོད་པས།",
    "གཏི་མུག་ལས་བྱུང་བ་མཆོད་སྦྱིན་བྱེད་པ་ལ་སོགས་པས་བྱས་པའི་ཆོ་གའི་༢སྲོག་གཅོད་པ་སྤོང་བར་བསྟན་པ་ཡིན་ཏེ།",
    "སེམས་ཀྱིས་རྣམ་པར་འཚེ་བའོ།",
    "ཐོ་འཚམས་༢པ་ཆེན་པོ་བྱ་བ་ལྟ་ཅི་སྨོས་ཞེས་གསུངས་པའོ་། ཀུན་དུ་སྤྱོད་པ་ཆེན་པོ་༢ནི་རྣམ་པ་ལྔས་ཡོངས་སུ་བསྟན་ཏེ་གཞན་སྨོས་པས་བརྒྱུད་པ་དང་།",
    "ལོ་མ་ཡང་མ་བྱིན་པར་མི་ལེན་ན་འཚོ་བའི་ཡོ་བྱད་གཞན་དག་ལྟ་ཅི་སྨོས་ཞེས་བྱ་བ་ནི་ཆུང་བ་དང་ཆེ་བའོ།",
    "འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་སྤོང་བའི་ད་བང་དུ་བྱས་ནས་སྤོང་བ་རྣམ་པ་ཅ་གསུམ་༡ཡོངས་སུ་བསྟན་ཏེ།",
    "གཉེན་པོ་ནི་ཕྱི་མ་གཞན་ན་ཚངས་པར་སྤྱོད་འདོད་པས་ཆུང་མ་འདོད་པ་མེད་པ་སྟེ།",
    "དི་ནི་འཇུག་པར་བྱ་བ་མ་ཡིན་པ་དང་།",
    "གནས་མ་ཡིན་པར་འགྲོ་བས་ཡོངས་སུ་བསྟན་ཏེ།",
    "གནས་མ་ཡིན་པར་འགྲོ་བ་ནི་ཡན་ལག་མ་ཡིན་པའི་རྣམ་པར་རིག་བྱེད་ད་དེ།",
    "སྤང་བར་༡༧རིག་པར་བྱ་སྟེ།",
    "བརྫུན་དུ་སྨྲས་པ་༡སྤོང་བའི་ད་བང་དུ་བྱས་ནས།",
    "གཞི་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་ར་རོ།",
    "མཚོན་ཆ་སྤངས་ཞེས་གསུངས་པ་དེ་ལྟར་བརྫུན་དུ་སྨྲ་བ་སྤོང་བ་ལ་ཕྱི་རོལ་གྱི་དངོས་པོ་མེད་ད་དེ།",
    "གཞི་ད་ང་ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་གཞི་ནི་རྒྱུ་སྟེ་སྲོག་གཅོད་པའི་རྒྱུ་ནི་ཆགས་པ་དང་།",
    "༢དེ་ནི་བདེན་པར་སྨྲ་བ་ཉིད་ཀྱིས་འགྱུར་ཏེ།",
    "བདེན་པར་སྨྲ་བ་དེ་ཉིད་ནི་ཕ་རོལ་སླུ་༦བའི་བསམ་པའི་གཉེན་པོ་ཡིན་ཏེ།",
    "བདེན་པར་སྨྲ་ཞེས་གསུང་ས་པའོ།",
    "ཡང་དག་པར་སྨྲ་ཞེས་གསུངས་པའོ།",
    "བསམས་ཏེ་༢བརྗོད་པ་ལྟ་ཅི་སྨོས་ཞེས་གསུངས་པའོ།",
    "དེ་དག་དབྱེ་བའི་ཕྱིར་ཕ་བི་ལས་ཐོས་ནས་ཚུ་བི་ལ་སྙོད་༢༢པ་མ་ཡིན་ཏེ་ཞེས་གསུངས་པའོ།",
    "བསམ་པ་དང་ལས་སུ་རིག་པར་བྱའོ།",
    "དེའི་གཉེན་ཅ་པོར་འདུས་པ་རྣམས་མི་འབྱེད་ཅིང་བྱེ་བ་རྣམས་ལ་ཡང་མི་སྣོན་ཏེ་ཞེས་གསུངས་པའོ་། བསམ་པ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "དེའི་ག་ཉེན་པོར་བདེན་ནམ་བརྫུན་ཡང་རུང་མི་འདུམ་པར་བྱ་བའི་ཚིག་མི་སྨྲའོ་ཞེས་གསུངས་ས་སོ།",
    "འདི་ད་ག་ནི་བརྗོད་པའི་མཚམས་སྦྱར་བ་ཡིན་པར་རིག་པ་སྟེ།",
    "དེས་གཞན་འཁྲུག་པར་འགྱུར་ཏེ།",
    "གནོད་པར་བྱེད་པའི་རྒྱུ་དང་།",
    "གཞན་དག་ཀྱང་མི་ཕྱོགས་པར་བྱེད་པ་དེ།",
    "གཞན་གྱི་སེམས་ཀྱི་རྒྱུད་མ་རུང་བར་བྱེད་པའི་ཚིག་ཅེས་གསུངས་པའོ།",
    "མཉེན་པ་༢ད་ང་ཡིད་ལ་འཐད་པ་དང་ཞེས་གསུངས་པའོ།",
    "སྐྱེ་བོ་མང་པོ་༥ཡིད་ལ་འབབ་པ་ཞེས་གསུངས་པའོ།",
    "བདག་ཀྱང་མངོན་དུ་ཕྱོགས་ལ་གཞན་ཡང་མངོན་དུ་ཕྱོགས་པར་བྱེད་པའི་ཕྱིར།",
    "གཞན་གྱི་སེམས་ཀྱི་རྒྱུད་ད་ང་བར་བྱེད་པ་ཞེས་གསུངས་པའོ།",
    "གཉེན་པོ་ནི་ཕན་ཚུན་སྨྲ་བར་བྱ་བའི་ད་བང་དུ་བྱས་ནས།",
    "གླེང་བར་སྦྱོར་བའི་ཚེ་ལན་འདེབས་པར་ཀློན་པའི་ཚིག་དང་།",
    "དུས་སུ་སྨྲ་བ་ཞེས་གསུངས་པའོ།",
    "རྩོད་པ་ཞི་བར་བྱེད་པར་སྦྱོར་བའི་ཚེ་རིགས་པར་༢སྨྲ་བ་ད་ང་།",
    "མཉན་པར་འོས་པའི་སྤྱོད་ལམ་གྱིས་༢གནས་པ་རྣམས་ལ་སྨྲ་བ་དང་།",
    "དུས་ད་ང་རྨང་དང་བཅས་པའི་ཚིག་སྨྲ་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "ཡེངས་པ་༢ལྟ་ཅི་སྨོས་ཞེས་གསུངས་པའོ།",
    "དེའི་རབ་ཏུ་དབྱེ་བ་ནི་བརྣབ་སེམས་རྣམ་པ་གསུམ་གྱི་༧གཉེན་པོར་རིག་པར་བྱ་སྟེ།",
    "དེའི་གཉེན་པོར་འདོད་པར་མི་བྱེད་ཅིང་མི་སྨོན་ཆགས་པའི་སེམས་མི་བསྐྱེད་དོ་ཞེས་བྱ་བ་གསུངས་པའོ་། དེ་ལྟར་གོང་མ་གཉིས་ནི་ཆུང་བའོ།",
    "པའི་སེམས་ལ་༢བྱེ་བྲག་མེད་པར་ཤེས་པར་བྱའི།",
    "ཁོང་ཁྲོ་བ་སྔོན་དུ་འགྲོ་བ་གང་དག་ཡིན་པ་དེ་དག་སྤངས་ཏེ་ཞེས་བྱ་བའི་ཚིག་དེ་དག་ད་ང་གོ་རིམས་བཞིན་དུ་བསྟན་པར་རིག་པར་བྱའོ།",
    "ཁྲོ་བ་ལ་སོགས་པ་དེ་དག་ནི་ཉེས་པར་སྤྱོད་པ་གཞན་གྱི་༧སྔོན་དུ་འགྲོ་བ་ཡིན་ཏེ།",
    "བརྫུན་དུ་བརྗོད་པའི་ལྟ་བ་དེའི་གཉེན་པོར་གཡོ་མེད་ལ་སྒྱུ་༤མེད་པས་ཞེས་བྱ་བ་གསུངས་ས་སོ།",
    "ད་གེ་འདུན་ལ་བསམ་པ་ངེས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་གསུངས་ས་སོ།",
    "རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་རྗེས་སུ་སྲུང་བས་དེ་ཉིད་ཀྱི་སྐྱོན་མེད་པ་ཡོངས་སུ་སྟོན་ཏེ།",
    "གཞན་དག་ཀྱང་ཡང་དག་པར་སྒྲུབ་པ་ལ་དགོད་པར་བྱའོ།",
    "ཉེས་པར་སྤྱོད་པས་འགྲོ་བའི་དོན་ད་ང་།",
    "གྲངས་ཀྱིས་བསྡུས་པའི་ཕྱིར་བཅུ་ཞེས་བྱའོ་། འབྲས་བུ་ཐོབ་པར་བྱེད་པས་བསྡུས་པའི་ཕྱིར་ལས་ཀྱི་ལམ་རྣམས་ཤེས་པར་བྱའོ།",
    "ཡང་དག་པར་བླངས་པའི་རྒྱུས་ཞེས་བྱ་བ་ལ།",
    "ཡང་དག་པར་བླངས་པ་ནི་ཀུན་དུ་སྤྱོད་པའོ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་གྱི་འགྲོ་བ་རྣམས་ཡོད་པར་གྱུར་ཏོ།",
    "སྒྲའི་རྗེས་སུ་འབྲང་བས་ཤེས་རབ་ཀྱི་རྣམ་པས་ཡོངས་སུ་བསྒོམས་ན་ཉན་ཐོས་ཀྱི་ཛེག་པ་འགྲུབ་པར་བྱེད་དོ་ཞེས་གསུངས་པ་སྟེ།",
    "ཤེས་རབ་ཀྱི་རྣམ་པ་ནི་འདིར་བདེན་པའི་རྣམ་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "རྣམ་པ་ལྔས་ཐ་དད་པར་བསྟན་ཏོ།",
    "སྒྲའི་རྗེས་སུ་འབྲང་བ་ཞེས་གསུངས་པའོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་དག་པའི་སྤྱོད་པ་རྒྱ་ཆེན་པོ་འགྲུབ་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལ།",
    "ནམ་པར་སྨིན་པའི་འབྲས་བུའི་བྱེ་བྲག་དང་།",
    "ཆུང་ངུས་ནི་གཤིན་རྗེའི་འཇིག་རྟེན་གྱི་རྒྱུར་འགྱུར་ཏེ་ཞེས་གསུངས་པ་སྟེ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་དུ་ཁྲིད་དོ་ཞེས་གསུངས་པའོ།",
    "འགྲན་ཟླ་དང་བཅས་པའི་ཆུང་མར་འགྱུར་བའོ་ཞེས་བྱ་བ་ནི་འདོད་པ་ལོག་༤པར་གཡེམ་པའི་འོ།",
    "གཡོག་འཁོར་ངན་པར་འགྱུར་བའོ་ཞེས་བྱ་བ་ནི་ཕྲ་མ་ཟེར་བའི་འི་འོ།",
    "མ་ངེས་པའི་སྤོབས་པར་འགྱུར་བའོ་ཞེས་བྱ་བ་ནི་ཚིག་འཁྱལ་བའི་འི་འོ།",
    "གཡོ་སྒྱུ་༢ཅན་དུ་འགྱུར་བའོ་ཞེས་བྱ་བ་ནི་ལོག་པར་ལྟ་བའི་འོ།",
    "རྣམ་པར་སྨིན་པ་ཐ་དད་པ་གཉིས་ཀྱིས་ནི་སྡུག་བསྔལ་མི་བཟད་པ་ཉིད་ཡོངས་སུ་སྟོན་ཏོ།",
    "གཞན་རྣམས་ཀྱང་དེ་དག་ཉིད་ལ་འགོད་དོ་ཞེས་གསུངས་པའོ།",
    "ཉེས་པར་སྤྱོད་པ་ལ་ཞུགས་པ་རྣམས་ལ་ནི་ལེགས་པར་སྤྱད་པ་ལ་འཇུག་པར་སྨོན་པ་སྟེ།",
    "ལེགས་པར་སྤྱད་པ་ལ་ཞུགས་པ་རྣམས་ལ་ནི་དེའི་འབྲས་བུ་ཐོབ་པར་སྨོན་པ་སྟེ།",
    "བདེ་བ་རྣམས་ལ་ནི་བག་ཡོད་པར་སྨོན་པ་སྟེ།",
    "ཡོངས་སུ་མི་ཉམས་པར་སྨོན་པ་སྟེ།",
    "སྟོན་པའི་སེམས་ཉིད་བསྐྱེད་ཅེས་གསུངས་པའོ།",
    "ཆོག་མི་ཤེས་པར་ཡོངས་སུ་སྤྱོད་པ་དང་།",
    "ཀུན་དུ་ཚོལ་བ་ཡང་རྣམ་པ་གཉིས་ཏེ་ཉེས་པར་སྤྱད་པ་ལ་སྦྱོར་བས་ཚེ་འདི་ཀུན་དུ་ཚོལ་བ་དང་།",
    "ལེགས་པར་སྤྱད་པ་ལ་སྦྱོར་བས་ཚེ་རབས་གཞན་ཀུན་དུ་ཚོལ་བའོ།",
    "ཚངས་པར་སྤྱོད་པ་ཚོལ་བ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་ད་ག་ལས་གཉིས་ནི་ངེས་པར་སེམས་པ་ལས་བྱུང་བའི་ཕྱིར་བློ་གྲོས་མི་ཉམས་པས་༤རབ་ཏུ་ཕྱེ་བའོ།",
    "ལམ་གོལ་༤བའི་ཐིབས་པོར་རྒྱུ་བ་ཡིན་གྱིས་ཞེས་གསུངས་པའོ།",
    "ཇི་ལྟ་བ་ན་༦དེ་བཞིན་ཉིད་ལ་དགོད་པར་བྱའོ་ཞེས་གསུངས་པའོ།",
    "རྩོད་པ་ལ་ཞུགས་པ་༩རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་ཁྲོ་བ་དང་།",
    "ཆོག་མི་ཤེས་པར་ཡོངས་སུ་སྤྱོད་པ་ལས་བརྩམས་ཏེ་ངོམས་མི་མྱོང་བ་ནི་བརྣབ་སེམས་ཏེ།",
    "འཚེ་བ་མེད་པའི་མྱ་ང་ན་ལས་འདས་པ་ལ་དགོད་པར་བྱའོ་ཞེས་གསུངས་པའོ།",
    "ཚེ་འདི་ལ་ཀུན་དུ་ཚོལ་བའི་ཉེས་པར་སྤྱད་པ་ལ་ཞུགས་པ་རྣམས་ཀྱི་ཉེས་པ་ནི་ལོག་པ་ལ་བདེ་བར་མཐོང་བ་ད་ང་།",
    "གཏི་མུག་དེའི་རྒྱུ་བག་ལ་ཉལ་བརྟས་༧པར་གྱུར་པ་དང་།",
    "དེའི་ཚོགས་ལེགས་པར་སྤྱད་པའི་མི་མཐུན་པའི་ཕྱོགས་ལ་ཞུགས་པས་ཟག་པ་མེད་པའི་ཤེས་རབ་ལས་རིང་དུ་གྱུར་པ་ཡང་ཉེས་པ་སྟེ།",
    "གཉེན་པོ་ཡང་དག་པར་མ་བསྒྲུབས་པའི་ཕྱིར་འགྱོད་པའི་ལྟ་བ་ནི་ཡ་ང་བ་མཐོང་བ་ཡིན་ན་ནོ།",
    "ཚེ་རབས་གཞན་ཀུན་དུ་ཚོལ་བ་ན་ལེགས་པར་སྤྱད་པ་ལ་ཞུགས་པ་རྣམས་ཀྱི་ཉེས་པ་ནི་ལམ་ཡ་ང་བར་ཞུགས་པ་ཡིན་ཏེ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་གྱི་གཡང་ས་ལ་མངོན་དུ་ཕྱོགས་པ་ཞེས་གསུངས་པའོ།",
    "ལྟ་བ་ངན་པའི་རྒྱ་ཉམ་ང་བར་ང་ཞུགས་པ་ཞེས་གསུངས་པའོ།",
    "དོན་དམ་པའི་བདེ་བ་ལ་ལམ་ལོག་པར་ཞུགས་པའི་ཕྱིཕྱིར།",
    "མི་ཁོམ་པར་སྐྱེས་པ་དང་།",
    "ཡོངས་སུ་འདྲེན་པ་མཁས་པ་ད་ང་བྲལ་བ་ཞེས་གསུངས་པའོ།",
    "ཆུད་ཟ་བས་བསྟན་པར་རིག་པར་བྱའོ།",
    "ལྟ་བའི་ཆུ་བོར་ཞུགས་པ་ཞེས་གསུངས་པའོ།",
    "འདོད་ཆགས་ཀྱི་ད་ཀྱིལ་དུ་ཀུན་དུ་ཐོགས་པ་ཞེས་གསུངས་པའོ།",
    "ཐ་སྙད་ཀྱི་དུས་ན་ང་དྲག་གོ་སྙམ་པ་ལ་སོགས་པ་ང་རྒྱལ་རྣམ་པ་གསུམ་གྱིས་༢ཁེངས་པར་གྱུར་པའི་ཕྱིཕྱིར།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་གླིང་འཚེ་བ་མེད་པ།",
    "འཇིགས་པ་དང་སྐྲག་པ་ཐམས་ཅད་མེད་པ་ལ་རབ་ཏུ་དགོད་པར་བྱའོ་ཞེས་གསུངས་པའོ།",
    "བཅིང་བ་ད་ང་སྒྲིབ་པའི་ཉེས་པ་ལྔ་དང་ལྡན་པར་རིག་པར་བྱའོ།",
    "འཁྲུག་པ་མང་པོ་མང་བ་ཞེས་གསུངས་པའོ།",
    "མྱ་ངན་དང་སྨྲེ་སྔགས་འདོན་པ་དང་བཅས་པའི་རྗེས་སུ་རྒྱུ་བ་ཞེས་གསུངས་པའོ།",
    "སྒྲིབ་པ་མེད་པའི་མྱ་ངན་ལས་འདས་པ་ལ་དགོད་པར་བྱའོ་ཞེས་གསུངས་པའོ།",
    "སྒྲིབ་པ་ཐམས་ཅད་སྤངས་པའི་མྱ་ངན་ལས་འདས་པ་ལ་དགོད་པར་བྱའོ་ཞེས་གསུངས་པའོ།",
    "ས་ད་ང་པོ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་འདིར་ཡང་ཅི་རིགས་སུ་རིག་པར་བྱའོ།",
    "དེ་ལྟར་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཤས་ཆེ་བར་ཅིའི་ཕྱིར་གསུངས་ཤེ་ན།",
    "དེ་ཡང་འདིར་ཆེས་༢ཡོངས་སུ་དག་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་དག་པ་ཡང་དག་པར་འགྲུབ་པ་དེས་༢སེར་སྣ་དང་།",
    "འདོད་ཆགས་དང་འབྲལ་༡བར་སྦྱོར་བ་ནི་བསམ་གཏན་བསྒྲུབས་༢ཏེ་གནས་པར་མ་གྱུར་གྱི་བར་དུའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ས་སོ།",
    "དེ་ལ་འདོད་ཆགས་དང་བྲལ་བའི་སེམས་ཀྱི་༢བསམ་པ་ནི་དག་པའི་སེམས་ཀྱི་བསམ་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་ལྟ་སྟེ་དག་པའི་སེམས་ཀྱི་༧བསམ་པ་ཡིད་ལ་བྱེད་ཅེས་གསུངས་པའོ།",
    "ཐོབ་པར་བྱ་བའི་ཐབས་ནི་དེའི་མི་མཐུན་པའི་ཕྱོགས་མ་འོངས་པའི་འདོད་པ་སུན་འབྱིན་པ་དང་།",
    "འདོད་ཆགས་དང་བྲལ་བའི་སེམས་ཀྱི་༩བསམ་པ་ཡིད་ལ་བྱེད་པ་ཞེས་གསུངས་པའོ།",
    "སྲིད་པའི་རྒྱུན་༤གཅོད་པའི་ད་བང་དུ་བྱས་ནས་༥སེམས་ཀྱི་བསམ་པ་ཡིད་ལ་བྱེད་པ་བཅུ་པར་རིག་པར་བྱ་སྟེ།",
    "ད་ལྟར་བྱུང་བ་ལ་མི་གནས་པར་སོ་སོར་རྟོག་གོ་ཞེས་གསུང་ས་པའོ།",
    "དེ་ལྟར་འདུ་བྱེད་དུ་གྱུར་པ་མི་རྟག་པ་ལ་ཅི་འདུ་བྱེད་དུ་གྱུར་པ་ལ་བརྟེན་པར་བྱ་བའི་ཕྱིཕྱིར།",
    "མངོན་དུ་བསྟེན་པར་བྱ་བ་མ་ཡིན་པ་དེ་ཡང་རྣམ་པ་དགུར་༡༧རིག་པར་བྱ་སྟེ།",
    "ལོངས་སྤྱོད་རྣམས་ཡོངས་སུ་ཚོལ་བའི་དུས་ན་བདག་ལ་སྡུག་པར་འགྱུར་གྱི།",
    "མི་སྡུག་པར་མི་འགྱུར་གྲང་སྙམ་དུ།",
    "འཁྲུག་པ་མང་པོ་མང་བ་ཞེས་གསུངས་པའོ།",
    "པ་ནི་༦ལུས་དེ་ཡང་དང་ཡང་བསྟན་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཆེ་བ་ཉིད་རྣམ་པ་གཉིས་ཀུན་དུ་༢བསྟན་པས་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་ཡང་ད་ག་པར་གཏོང་བ་དང་།",
    "རྣམ་པར་དག་པ་ཆེ་བ་ཉིད་དོ་༡།",
    "ཡོན་ཏན་ཡོངས་སུ་འཛིན་པ་ཡང་༢༡རྣམ་པ་ལྔར་རིག་པར་བྱ་སྟེ།",
    "མྱ་ངན་ལས་འདས་པ་ཐོབ་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེའི་གཞི་ལས་བྱུང་བ་མྱ་ངན་ཟད་པར་རིག་པར་བྱ་སྟེ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་མྱ་ངན་ལས་འད་ས་པ་ཐོབ་པ་ལ་༢ཁྱད་པར་དུ་འཕགས་པར་རིག་པར་བྱ་སྟེ།",
    "དེས་༤དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་དེ་ལྟར་ཚང་བ་ཡང་དག་པར་མཐོང་སྟེ།",
    "མགོན་མེད་ཅིང་རྟོན་པ་མེད་པའི་སེམས་ཀྱི་བསམ་པ་ཉིད་ཅེས་རྒྱ་ཆེར་གསུངས་པའོ་༧། དེ་ལ་རྟོན་པ་མེད་པ་ཉིད་ནི་མགོན་མེད་༐",
    "རབ་ཏུ་མ་ཞི་བ་ཡོངས་སུ་སྤྱོད་པ་གཉིས་རིག་པར་བྱ་སྟེ།"
  ]
}