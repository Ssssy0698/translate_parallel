    "ཤིན་ཏུ་འད་ས་པ་དེ་ཡང་རྣམ་པ་བརྒྱད་དུ་རིག་པར་བྱ་སྟེ།",
    "གསུངས་པའོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་འགྲོ་བར་ཞུགས་པ་ཡིན་ཞེས་གསུངས་པའོ།",
    "དུས་གསུམ་མཉམ་པ་ཉིད་དུ་རྟོགས་༤པ་ཡིན་ཞེས་གསུངས་པའོ།",
    "རྣམ་པར་འཚེ་བ་མེད་པ་མང་བ་ཡིན།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་དང་།",
    "དེ་ཡང་རྣམ་པ་དགུར་རིག་པར་བྱ་སྟེ།",
    "དང་བ་མང་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "རངས་པ་མང་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "མགུ་བ་མང་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "དགའ་རླབས་མང་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "སྤྲོ་བ་མང་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "མི་འཁྲུགས་པ་མང་བ་ཡིན་༢ཞེས་གསུངས་པའོ།",
    "རྣམ་པར་འཚེ་བ་མེད་པ་མང་བ་ཡིན་ཞེས་གསུང་ས་པའོ།",
    "ཁྲོ་བ་མེད་པ་མང་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "མ་འོངས་པ་ན་ཐོབ་པར་བྱ་བ་དང་ད་ལྟར་༦བྱུང་བ་ན་ཐོབ་པའོ།",
    "དེ་ལ་མ་འོངས་པ་ན་ཐོབ་པར་བྱ་བའི་ད་བང་དུ་མཛད་ན་ས།",
    "སང་ས་རྒྱས་བཅོམ་ལྡན་འདས་རྣམས་རྗེས་སུ་དྲན་ཞིང་མཆོག་ཏུ་དགའ་བ་ཡིན་ཞེས་རྒྱ་ཆེར་གསུངས་ས་སོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ཞེས་གསུངས་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་གད་མས་ངག་རྗེས་སུ་བསྟན་པ་ཞེས་གསུངས་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་འཇུག་པའི་སྦྱོར་བ་རྗེས་སུ་དྲན་ཞིང་མཆོག་ཏུ་དགའ་བ་ཡིན་ཞེས་གསུངས་པའོ།",
    "ཇི་ལྟ་བུས་རབ་ཏུ་ཕྱེ་བ་དེ་ནི་རྗེས་སུ་དྲན་པ་རྣམས་སུ་རིག་པར་བྱའོ།",
    "དེ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་ད་ག་པས་རབ་ཏུ་ཕྱེ་བའོ།",
    "སའི་ཁྱད་པར་དུ་འགྲོ་བ་དང་།",
    "ཉེ་བའི་ཡན་ལག་ཏུ་རིག་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་དེ་ལྟར་བྱུང་བ་ན་ཐོབ་པའི་དམིགས་པའི་ད་བང་དུ་མཛད་ནས་ཕྱིར་ཞིང་མཆོག་ཏུ་དགའ་བ་དང་ལྡན་པ་ཡིན་ཏེ་བད་ག་ནི་སོ་སོའི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་ཡུལ་ལས་ཕྱིར་ལོག་གོ་ཞེས་རྒྱ་ཆེར་བྱ་ཏྲ་གསུངས་ཏེ།",
    "བདག་ནི་བྱིས་པ་སོ་སོའི་སྐྱེ་བོའི་ས་ལས་རིང་དུ་གྱུར་ཏོ་ཞེས་གསུངས་པའོ།",
    "བདག་ནི་ཡེ་ཤེས་ཀྱིས་ད་ང་ཉེ་བར་གྱུར་ཏོ་ཞེས་གསུངས་པའོ།",
    "བདག་ནི་དེ་བཞིན་གཤེགས་པ་མཐོང་བ་ད་ང་ཉེ་བར་གྱུར་ཏོ་ཞེས་གསུངས་པའོ།",
    "བདག་ནི་བྱང་ཆུཌྭབ་སེམས་དཔ་འ་ཐམས་ཅད་ཀྱི་མཉམ་པ་ཉིད་དང་ལྡན་པར་གྱུར་ཏོ་ཞེས་གསུངས་པའོ།",
    "བག་ཚ་བ་དང་བྲལ་ལོ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་འཇིགས་པ་ནི་མི་འདོད་པར་ལྟུང་༢དུ་དོགས་པ་སྟེ།",
    "སེམས་པ་ཡིད་མི་བདེ་བ་དང་མཚུངས་པར་ལྡན་པའོ།",
    "ཡོ་བྱད་ཐམས་ཅད་ལ་ཕོངས་༨པར་སེམས་པ་ལྟ་ག་ལ་ཡོད་ད་དེ།",
    "སའི་ལེགས་པའི་ཁྱད་པར་ཡོངས་སུ་བསྟན་པའི་ཕྱིར་ར་རོ།",
    "བདག་ལ་ཕངས་པར་སེམས་པ་ཡང་མེད་ན།",
    "ཡོ་བྱད་ཐམས་ཅད་ལ་ཕངས་པར་སེམས་པ་ལྟ་ག་ལ་ཡོད་ཅེས་བྱ་བ་དང་།",
    "ད་གེ་བའི་རྩ་བ་ཐམས་ཅད་ཡང་དག་པར་བསྡུ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གང་དག་ས་དེས་བསྡུས་པ་རྣམས་སོ་༡༧།",
    "སྲིད་པར་འཛིན་པ་མང་བའི་ཕྱིར་ད་ང་།",
    "བྱམས་པ་ཆེན་པོ་དང་ལྡན་པའི་ཕྱིར་ཞེས་གསུངས་པ་སྟེ།",
    "ཡིད་ཡོངས་སུ་མི་སྐྱོ་བའི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "ངོ་ཚ་ཤེས་ཤིང་ཁྲེལ་ཡོད་པའི་རྒྱན་གྱི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "ཉིན་མཚན་དུ་ད་གེ་བའི་རྩ་བ་སོགས་པས་མི་ངོམས་པའི་ཞེས་གསུངས་པའོ་། སོགས་པ་དེ་ཡང་རྣམ་པ་བརྒྱད་དུ་རིག་པར་བྱ་སྟེ།",
    "ཡིད་གནས་མེད་པའི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "གནས་མེད་པ་ནི་འདིར་བསམ་གཏན་གྱི་རོ་མྱང་བ་མེད་པར་རིག་པར་བྱའོ།",
    "མ་ཐོབ་པ་ལ་ལྷག་པར་ཆགས་པ་མེད་པ་སོགས་པ་དང་།",
    "དེ་ལྟ་བུ་ནི་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པས་བརྩོན་པར་བྱེད་པའོ་༐།",
    "༡ཡོངས་སུ་བསྔོ་བ་ཕུན་སུམ་ཚོགས་པས་བརྩོན་པར་བྱེད་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་བདེན་པའི་ཚིག་ལྷུར་ལེན་པའི་ཕྱིར་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་སུན་པར་མི་བྱེད་པའི་ཕྱིར་དང་།",
    "རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་གོང་ནས་གོང་དུ་ཁྱད་པར་དུ་འཕགས་པ་ཡོངས་སུ་ཚོལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདིས་ནི་ཡོངས་སུ་བསྔོ་བ་ཕུན་སུམ་ཚོགས་པ་སྟོན་ཏོ།",
    "དེས་སློང་བ་ཟློག་༢པར་བྱེད་ཅིང་ཁས་མི་ལེན་ཏོ།",
    "ཇི་སྐད་སྨྲས་པ་བཞིན་དུ་མི་བྱེད་པ་ནི་དེས་ན་ཁས་བླངས་ཀྱང་སྦྱིན་པར་མི་བྱེད་ད་དེ།",
    "ཇི་སྐད་སྨྲས་པ་དེ་ལྟར་བྱེད་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ས་སོ།",
    "དེས་ནི་ཡང་དག་པར་བླངས་ཏེ་ད་མ་བཅས་པ་ཡང་ཞིག་པར་བྱེད་ལ།",
    "དེའི་གཉེན་པོར་རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་བདེན་པའི་ཚིག་ལྷུར་ལེན་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་སུན་པར་བྱེད་པའོ།",
    "ཐོ་འཚམས་༡པ་ནི་དེའི་རིགས་ཅན་གྱི་ལས་ངན་པ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེའི་གཉེན་པོར་དེ་བཞིན་གཤེགས་པའི་རིགས་སུན་པར་མི་བྱེད་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ས་སོ།",
    "སེམས་རྣམ་པར་གཡེང་བ་དང་།",
    "རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་གོང་ནས་གོང་དུ་ཁྱད་པར་དུ་འབོགས་པ་ཡོངས་སུ་ཚོལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་ཏེ་གོ་རིམས་བཞིན་ན་ནོ།",
    "དེ་ལྟ་བུ་ནི་ཡོངས་སུ་བསྔོ་བ་ཕུན་སུམ་ཚོགས་པས་ཡང་དག་པར་བརྩོན་པར་བྱེད་པའོ།",
    "ཁྱད་པར་དེ་ནི་རྣམ་པ་གསུམ་སྟེ།",
    "འདུན་པའི་ཁྱད་པར་དང་།",
    "སྒྲུབ་པའི་ཁྱད་པར་དང་།",
    "འབྲས་བུའི་ཕན་ཡོན་གྱི་ཁྱད་པར་རོ།",
    "ཡང་ད་ག་པར་ཚོལ་བས་རིམ་གྲོ་བྱ་བ་དང་།",
    "དེ་ཡང་དག་པར་གཟུང་བ་ནི་ལེན་པ་ད་ང་།",
    "དེ་ཡང་ད་ག་པར་ཡོངས་སུ་གཟུང་བ་ནི་ཐོབ་པར་བྱ་བའི་གདམས་ངག་སྦྱིན་པའི་ཕྱིར་ར་རོ།",
    "ལྷུམས་ན་བཞུགས་པ་ད་ང་།",
    "མྱ་ངན་ལས་འད་ས་པར་གཤེགས་པའི་བར་དུ་བྱ་ཞིང་ཐམས་ཅད་དུ་དུས་གཅིག་ཏུ་སྒྲུབ་པའི་ཕྱིར་ཞེས་བྱ་བས་ནི་རིམ་གྱིས་མ་ཡིན་པའོ།",
    "ཅིའི་ཕྱིར་དགའ་ལྡན་ན་བཞུགས་པ་སྟོན་ལ།",
    "བདག་ཅག་ལ་ཐུགས་བརྩེ་བའི་ཕྱིར་ལྷའི་བདེ་བ་ཡང་སྤངས་ནས་མིའི་ནང་དུ་གཤེགས་སོ་ཞེས་གུས་པ་ལྷག་པར་སྐྱེད་༨པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་ལྷུམས་ན་བཞུགས་པ་སྟོན་ཞེ་ན།",
    "གཞན་ལ་རག་མ་ལུས་པར་འགྲུབ་བོ་ཞེས་སྐྱེས་བུའི་བྱེད་པ་ལ་གཟུང་བའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པར་གཤེགས་༢ན།",
    "ཡན་ལག་དང་ཉེ་བའི་ཡན་ལག་ཏུ་བཅས་པར་༢ིསྒྲུབ་པ་དང་།",
    "ཐབས་རྣམས་ལ་གདམས་ངག་རྗེས་སུ་བསྟན་པ་དེ་རིག་པར་བྱའོ།",
    "ཐ་མི་དད་པ་ཞེས་གསུངས་པའོ།",
    "འགྲོ་བ་བགྲངས་པ་ཐམས་ཅད་རྣམ་པར་གཅད་པའི་ཕྱིར་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་རབ་ཏུ་དགོད་པའི་ཕྱིཕྱིར།",
    "དོན་ནི་གང་ལ་ཡོངས་སུ་སྨིན་པར་བྱ་སྟེ།",
    "འདུ་ཤེས་མེད་མིན་༦དག་ཏུ་རིག་པར་བྱའོ་། དེ་ལྟར་ན་འདི་ནི་རགས་པ་ད་ང་།",
    "འགྲོ་བ་བགྲངས་༢པ་ཐམས་ཅད་རྣམ་པར་གཅད་པའི་ཕྱིར་ཞེས་གསུངས་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ད་གོད་པའི་ཕྱིར་ཞེས་གསུངས་པ་སྟེ།",
    "རྣམ་པར་དབྱེ་བ་མིག་འཕྲུལ་ལྟ་བུ་ད་ང་།",
    "དེ་ལ་༨འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ནི་མཚན་ཉིད་གསུམ་དུ་ཡེ་ཤེས་ཀྱི་༩ཁོང་དུ་ཆུད་པར་བྱ་ཞིང་།",
    "སྟེང་ཡོགས་མེད་ཅིང་གཞི་ཕྱལ་པ་ནི་ཁྱིམ་ན་གནས་པ་མ་བྱས་པ་རྣམས་ས་སོ།",
    "འཇུག་པའི་ཁྱིམ་ཅན་ནི་ཁྱིམ་ན་གནས་པ་བྱས་པ་རྣམས་ཏེ།",
    "དོ་། ༢དེ་ལ་དོན་དམ་པའི་མཚན་ཉིད་ནི་ཡེ་ཤེས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་ར་རོ།",
    "ཞིང་གཅིག་ལྟར་ཞིང་ཐམས་ཅད་དུ་མཉམ་པར་རྒྱུ་བས་ཡོངས་སུ་སྤྱོང་བ་ད་ང་།",
    "འོད་ད་ང་རྣམ་པར་བཀོད་པའི་རྒྱན་གྱིས་རབ་ཏུ་བརྒྱན་པ་ད་ང་།",
    "དེ་ཡང་རྣམ་པ་བདུན་དུ་རིག་པར་བྱ་སྟེ།",
    "རྣམ་པར་བཀོད་པའི་རྒྱན་གྱིས་རབ་ཏུ་བརྒྱན་པ་ཉིད་ཀྱི་ཕྱིར་འོད་ཀྱི་རྒྱན་དང་།",
    "ཚིམ་པར་བྱ་བའི་ཕྱིར་འབྲས་བུ་ཡོངས་སུ་དག་པ་སྟེ།",
    "བསམ་པ་དང་སྦྱོར་བ་གཅིག་པར་བྱ་བའི་ཕྱིར་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་རྣམ་པར་རྒྱུ་བར་བྱ་བའི་ཕྱིར་དང་།",
    "འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་སྣང་བ་ཐོབ་པར་བྱ་བའི་ཕྱིར་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་རྣམ་པར་རྒྱུ་བ་ཉིད་ད་དང་།",
    "གཉིས་པ་ནི་མཐུན་པར་དམིགས་པས་ནང་དུ་ཡང་ད་ག་འཇོག་པས་ས་སོ།",
    "གསུམ་པ་ནི་འབྲེལ་པའི་གཏམ་ནམ་པར་གཏན་ལ་འབེབས་པས་སོ།",
    "དེ་དག་ཕན་ཚུན་ཡང་ད་ག་པར་སྟོན་པ་དང་།",
    "ཡིད་ཀྱི་ལས་དོན་ཡོད་པར་བྱ་བའི་ཕྱིར་ད་ང་།",
    "ཚིག་བརྗོད་མ་ཐག་ཏུ་ཡེ་ཤེས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟ་བུའི་ལུས་ཐོབ་པར་བྱ་བའི་ཕྱིར་དང་།",
    "ཡིད་ཀྱི་ལས་དོན་ཡོད་པ་ཉིད་ནི་དེ་ཚིག་༡གསུམ་གྱིས་༢ིགོ་རིམས་བཞིན་བསྟན་པར་རིག་པར་བྱ་སྟེ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཆེན་པོ་བསྟན་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སྤྱོད་པའི་སྟོབས་རྒྱུན་མི་འཆད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དེ་ནི་ལས་བདུན་བྱེད་པར་རིག་པར་བྱ་སྟེ།",
    "ལམ་བསྟན་པར་བྱེད་པར་རིག་པར་བྱའོ།",
    "ལས་གསུམ་པ་ནི་གཅིག་མངོན་དུ་ཡང་ད་ག་པར་རྟོགས་པ།",
    "གཉིས་པ་ནི་ཡེ་ཤེས་ཀྱི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "གང་དུ་གནས་ནས་ཡོངས་སུ་སྨིན་པར་༐",
    "འདིས་ནི་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་དེ་ལྟ་བུ་ཡང་ཡོངས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "བརྩོན་པ་ནི་དེ་གྲུབ་པར་བྱེད་པའི་ཐབས་ས་སོ།",
    "ཡེ་ཤེས་ཀྱི་རྒྱུད་ཀྱི་ཁམས་ཀྱི་མཐར་ཐུག་པར་ར་རོ།",
    "འདིར་རྒྱུན་གྱི་མཐར་ཐུག་པ་ཡིན་པར་རིག་པར་བྱའི།",
    "ཁྱད་པར་གྱིས་༦ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ནོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་ད་ག་པར་འགྲུབ་པ་དང་།",
    "ས་ཡང་དག་པར་འགྲུབ་པས་བསྒྲུབ་༢པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་སའི་བར་དུ་ངེས་པར་བསྟན་པ་དང་།",
    "བདེ་བར་གནས་པའི་ཁྱད་པར་ཐོབ་པས།",
    "ས་ཡང་ད་ག་པར་འགྲུབ་པས་འགྲུབ་པ་ཞེས་གསུངས་པའོ།",
    "འབྲས་བུ་ཡོངས་སུ་འགྲུབ་པ་ལ་ཡིད་ཆེས་པ་ཡིན་ཞེས་གསུངས་པའོ།",
    "འཛིན་པ་ནི་རྟོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སེར་སྣ་ད་ང་མཚུངས་པར་ལྡན་པས་འགྲོ་བར་སྐྱེད་པར་སྦྱོར་བ་རྣམས་ད་ང་།",
    "ལེན་པ་རྣམ་པར་འཕེལ་ལོ།",
    "ཉེ་བར་ལེན་པ་རྣམ་པར་འཕེལ་ནས་སྲིད་པ་འབྱུང་ང་ངོ།",
    "འདི་ལྟར་དེ་ཁོང་དུ་མི་ཆུད་དོ་ཞེས་གསུངས་པའོ།",
