    "གསོལ་ལྷུང་ནི་ནང་ལ་ཤ་དཀར་གྱི་གཡའ་རྩི་བཏང་བ་ཞིག་འདུག་སྟེ།",
    "མགོ་མཇུག་ཏུ་རས་ནག་པོའི་མཐའ་ཆགས་བཅས་པ་ཞིག་འདུག་འདི་རྣམས་དཔེ་རིས་སུ་བྲིས་པ་ལ་ལྟོས།",
    "འཁོར་གྱི་རྟ་མགྲིན་དེ་ཡས་ཀྱི་མཆེ་བ་གླང་ཆེན་བཞིན་གཡས་སུ་འཁྱིལ་བ་ཞིག་འདུག་ཅིང་།",
    "མེས་དབོན་གྱི་ལྷ་ཁང་རྣམས་ན་ཡང་ཁྲོ་བོའི་གཟུགས་རྣམས་དེ་ཁོ་ནར་འདུག་པས།",
    "ཞ་ལུར་ཡང་ཡ་རྩེ་ནས་ཕུལ་བྱ་བའི་རྒྱ་དཔེ་འདུག་པས།",
    "སྲིད་དུ་མཐོ་དྲུག་ཡོད་པ་གཉིས་ཀྱི་ནང་དུ་བཅུག་འདུག་པ་སྒམ་དེ་ཡང་བུ་སྟོན་གྱི་ཡིན་ཟེར།",
    "དེའི་ནང་དུ་བོད་དཔེ་བྲིས་མ་མང་པོ་ཡང་འདུག་སུ་ལ་ཡང་རྒྱུས་མེད་པའི་དཔེ་རིང་ཞིག་གོས་ཐུམ་དགུ་ཙམ་གྱིས་དྲིལ་ནས་འདུག་པར་ཞལ་ཕྱེས་པས།",
    "དེ་མེད་པ་ནི་མུན་པ་སོགས་འདུག་པས།",
    "བོད་འགྲེལ་རང་དུ་སྣང་ལ་བར་བར་དུ་ཚིག་གསལ་རྒྱ་སྐད་དུ་བྲིས་འདུག་གོ།",
    "བོད་དཔེ་རྣམས་ཅི་བས་ཀྱང་སྤུས་ལེགས་ལ་གྲས་མཚུངས་པ་རྐྱང་འདུག་འདིར་རྒྱ་དཔེ་པོད་ཆེ་ཆུང་བཞི་བཅུ་ལྷག་བཞུགས་པར།",
    "བྱ་བ་བོད་ཡིག་དབུ་ཅན་ཤིན་ཏུ་ཡིད་འཕྲོག་པའི་གཟུགས་སུ་བྲིས་ནས་འདུག་ས་བཟང་པཎ་ཆེན་གྱི་ཕྱག་བྲིས་ཡིན་མཆིས།",
    "དཔེ་པོད་སྟོང་ཕྲག་ལྷག་ཙམ་འདུག་པའི་ནང་ནས་ཐོག་མར་ངེད་ཀྱིས་དཔེ་ལྡེབ་ཆེན་པོ་ཞིག་སྣང་མེད་དུ་བཏོན་པས།",
    "པཎྜི་ཏ་རྣལ་འབྱོར་ཟླ་བའི་ཕྱག་བྲིས་རྣམ་འགྲེལ་རྒྱན་གྱི་རྒྱ་དཔེ་ཤོག་བུ་ལ་བྲིས་པ་ཆ་ཚང་ཞིག་འདུག་དེར་པཎྜི་ཏས་རྒྱ་དཔེ་མང་དུ་རྙེད་འོང་བར་བསམ་ནས་གྲོགས་བཅོལ་ཏེ་ཉིན་གཉིས་གསུམ་བཙལ་ཡང་དཔེ་ཁང་དེའི་ནང་ན་པོད་དེ་གཅིག་པུ་ལས་མི་འདུག་སྟབས་ལེགས་འདི་འདྲ་ལ་གཞན་ཞིག་ཡིན་ན་ངོ་མཚར་ཆེན་པོ་བརྩི་ངེས།",
    "ལྷ་ས་ཀུན་གླིང་བླ་བྲང་དུ་རྩོད་རིགས་ཀྱི་འགྲེལ་པ་ཞི་འཚོས་མཛད་པ་དཔེ་ཐུང་ཞིག་འདུག་པར་པཎྜི་ཏས་ངོ་བཤུས་བྱས།",
    "དེར་བརྒྱད་སྟོང་མཚན་བརྗོད་སོགས་ཀྱང་འདུག་བོད་དཔེ་དཀོན་པོ་སྦ་བཞེད་ཞབས་བཏགས་མ་བྲིས་མ་ཞིག་ཀྱང་སྣང་།",
    "དེར་ངོ་མཚར་ཆེ་བ་རྡོ་རྗེ་གདན་གྱི་མཆོད་རྟེན་སོགས་དགོན་གནས་ཡོངས་རྫོགས་ཀྱི་བཀོད་པ་རྡོ་ནག་དང་ཙནྡན་དཀར་པོ་ལས་བྱས་པ་ཁ་ཐོར་ཆ་གཉིས་འདུག་རྡོ་ཡི་དེ་རྒྱ་གར་ནས་འཁྱེར་ཡོང་བ་ཡིན་ཟེར་ཅིང་།",
    "ཀཎགོམིས་མཛད་པ་སོགས་ནི་བྱང་ཤམ་བྷ་ལའི་དཔེ་མཛོད་དེ་འདྲ་ན་ཡོད་ན་མ་གཏོགས་བོད་ཡུལ་གྱི་གླེགས་བམ་འདི་གཅིག་པུ་ལས་གཞན་ས་སྟེང་ན་དཔེ་རྒྱུན་ཡོད་ཚོད་དུ་མི་འདུག་ཅིང་།",
    "ཡུལ་དེའི་ཆུ་འགྲམ་བྱང་ངོས་ན་གྲུབ་ཐོབ་གཅེར་བུ་རྣམས་ཀྱི་རྒྱལ་ས་ཆེན་པོ་ལ་སྟོད་རྒྱལ་གྱི་ཤྲཱི་བྱ་བའི་གྲགས་ཆེན་དེ་འདུག་མཐོང་ནས་དྲུང་དུ་སླེབས་ཙ་ན།",
    "ལན་གཅིག་རྒྱལ་པོ་ལ་ཚེ་གེགས་འདུག་པས་དེ་སེལ་བའི་ཐབས་སུ་ཤི་ནས་སླར་སྐྱེས་པའི་ཆོ་ག་བྱ་དགོས་ཟེར་ནས།",
    "འོན་ཀྱང་ཞོ་ལྟ་བུའི་ཀླད་པ་ཁོ་རང་ནི་བེམ་པོ་ཡིན་པས་ཤེས་པར་ག་ལ་རུང་།",
    "ལི་ཡུལ་ནི་བོད་ཀྱི་བྱང་ཕྱོགས་སུ་ཡོད་ཅིང་རང་སྐད་ལ་ཀུསྟན།",
    "ངེས་པར་ལྷའི་ཡུལ་དང་རྨི་ལམ་གྱི་ཞིང་ལྟ་བུ་ཞིག་ཏུ་གྲུབ་འདུག་སྟེ།",
    "སྦྲུལ་དུག་ཅན་ཁྱུད་ཀྱི་སྒྲ་དང་བཅས་བྲང་གཤོག་པ་ལྟར་ཁ་ཕྱེས་ཏེ་རྒྱང་བ་ཞིག་འདུག་པ་རྒྱ་བལ་གཉིས་ཀར་སྦྲུལ་མགོའི་གདེང་ཀའི་གཟུགས་ལ་ཡང་དེ་ཁོ་ན་སྣང་།",
    "དེ་ད་བྱིད་དུ་བསྒྱུར་ནས་འདུག་སྙམ།",
    "བོད་ཀྱི་མདུན་སྨྲ་རིན་མ་ཆོག་པ་རྐྱང་འདུག་པས་རང་འགར་བཞག་དུང་གསོན་པོ་དང་།",
    "དེ་ཡང་རང་ཡུལ་གྱི་གྲོང་དང་ཡུལ་ཕྲན་ནམས་ཀྱི་མིང་ནི་རང་མིས་བཏགས་པ་ཤས་ཆེ་ཡང་།",
    "སྐད་གཉིས་ཤན་སྦྱར་དང་འཕྲིན་ཡིག་སོགས་ནའང་རྒྱ་གར་གྱི་སྐད་དོད་བིཧར་ཞེས་པ་འདུག་ཅིང་།",
    "ཏིརཧིཏ་ནས་རྒྱ་གར་དུ་སླེབས་ཅེས་གསུངས་པས་ཤས་ཆེར་མ་ག་དྷ་ཙམ་ལ་ཁོང་རྣམས་རྒྱ་གར་ཅེས་འབོད་པ་ཡིན་འདུག་སྟེ་ཏིརཧིཏ་ནིབྲྀཛིའི་ཡུལ་དང་།",
    "ཨཔཱརཱབྷཀ་བྱ་བ་རྣམས་ཀྱི་ཚིག་དོན་བསྒྱུར་བ་མིན་པར་འདུག་པས་ཤིན་ཏུ་གསལ་ལ།",
    "སྒྲ་ངན་ལ་སོགས་པའི་ཡུལ་གཞན་ཐམས་ཅད་ཀྱང་དཀྵིར་ལ་སོགས་པའི་རྒྱ་ཚིག་དེ་ཀ་རང་བོད་སྐད་དུ་བསྒྱུར་འདུག་པས་ལོ་ཙཱ་བས་ངོ་སྤྲད་པ་ཙམ་ཡིན་ལ།",
    "ལྷའི་རྣམ་པ་སོགས་མང་པོ་ཟེར་ཀྱང་ཡིན་ངེས་པ་བྱང་སེམས་ཁྱིམ་པའི་རྣམ་པར་འདུག་སྙམ།",
    "འདི་ལ་ཚིགས་བཅད་ཞིག་ཀྱང་འདུག་འཛེནྶྲཞསྲཾཀྲིཏཔཱདསྷིཾང་།",
    "རྒྱ་གར་རང་ན་ཡབ་ཡུམ་ཞལ་སྦྱར་བའི་སྐུ་བརྙན་ནི་ཕྱི་ནང་གང་ལ་ཡང་མཐོང་བ་སྲིད་མཐའ་ཙམ་དུ་འདུག་ཅིང་།",
    "དེ་བཞིན་མིའམ་ཅི་ལྗོན་པའི་སྐུ་བརྙན་ལག་པ་བཞི་པ་འདུག་ཅིང་།",
    "ཞལ་རས་མིའི་རྣམ་པ་ཆེར་གསལ་བ་དག་འདུག་སྐུ་བརྙན་དེ་དག་ཀྱང་ད་ལྟ་གསུང་འབྱོན་ནམ་སྙམ་པ་ལྟ་བུ་མཆིས།",
    "བདེ་བ་ཅན་གྱི་ཞིང་བཀོད་ཀྱང་རྒྱའི་བྲིས་ཆ་རྒྱ་ནག་ནས་ཡིན་འདུག་པ་ལྷམ་ཡུ་རིང་དང་།",
    "དེས་ན་ཕལ་ཆེར་ད་ལྟའི་ཡོ་རོབ་པའི་རིགས་དང་འདྲ་པོ་ཞིག་ཡིན་འདུག་གོ།",
    "སྤྱིར་པེ་ཧར་རྒྱལ་པོའི་ཆས་འདི་ལ་བསམ་རྒྱུ་ཤིན་ཏུ་མང་བར་འདུག་ཅིང་།",
    "ལུང་བསྟན་འདི་རིགས་ལ་དེ་ལས་ཀྱང་གོ་གང་ཡངས་ཡངས་སུ་འགྲེལ་ལུགས་དུ་མ་བྱས་ཆོག་འདུག་པས།",
    "ད་དུང་ཡང་རང་ཉིད་ཅི་དགར་ཕེབས་ཆོག་བཞིན་དུ་ངེད་ལ་ཁྲོ་དགོས་པའི་དོན་མེད་དོ།",
    "རྩ་རྒྱུད་འདི་ཉེ་དུས་སུ་ལྷོ་ཕྱོགས་ཡུལ་གྱི་ལྷ་ཁང་རྙིང་པ་ཞིག་ལས་རྙེད་པ་ཡིན་འདུག་ཅིང་།",
    "བྱ་བ་སོགས་འདུག་ལུང་བསྟན་འདི་ལ་གཞི་བཅོལ་བའམ་ཡང་ན་རང་དགར་བློ་བཟོ་བྱས་ཏེ།",
    "ངེད་ཀྱི་སེམས་ལ་ནི་ལྷ་ས་བྱ་བ་ཡང་རྒྱལ་རབས་དང་དཔེ་རྙིང་རྣམས་ལ་ར་ས་བྱ་བ་ལས་ལྷ་ས་བྱ་བ་ཡེ་མི་འདུག་ཅིང་།",
    "དེའི་ཕྱིར་རྭ་ཞེས་པ་ཁྱིམ་དང་ཁང་པའི་མིང་དུ་བྱེད་པ་འདུག་ལ།",
    "དེས་ན་ཁྱིམ་ནག་བྱ་བ་དང་རྦ་ནག་བྱ་བ་ཡང་གོ་རྒྱུ་གཅིག་པ་འདུག་བླ་བྲང་ཕྱོགས་ཁང་པ་ལ་གུར་དྲུའུ་བ་ལ་གུར་ཕྲུལ་བྱ་བ་སྟེ།",
    "སྔོན་གྱི་ཚེ་རྒྱ་གར་གྱི་སྐད་དོད་ལ་ཡང་བིཧར་ཉིད་བྱུང་བའི་དེ་དུས་ཀྱི་རྒྱ་གར་བྱ་བ་དེ་འདི་ཙམ་ལ་བྱེད་པ་ཡིན་འདུག་ཅིང་།",
    "དེ་ལ་མགྷདྷ་དེ་ནི་࿇ཤོག་ངོས་༩༣ ནས་༩༥ འདིའི་བར་ཆད་འདུག་ཡུལ་གྱི་བྱིངས་རྣམས་ཐང་འབའ་ཞིག་ཏུ་གནས་ཤིང་།",
    "འོན་ཀྱང་ད་ལྟ་བོད་ཀྱི་ཡུལ་མང་པོར་རྫི་མ་སྨིན་མའི་མིང་དུ་བྱེད་ཀྱིན་འདུག་པ་ལ་མ་ནོར་བ་དགོས།",
    "ལྕགས་རི་ཞིག་པོ་དེའི་དབུས་ཀྱི་ལྟེ་བ་ན་མྱ་ངན་མེད་ཀྱི་རྡོ་རིང་ཐོག་ཚད་གཉིས་ལྷག་པ་ཞིག་འདུག་པར།",
    "ཆུ་འགྲམ་དུ་གྲོང་ཆུང་དུ་ཞིག་འདུག་པ་ལ་ད་དུང་ཡང་ཀོ་ཤམ་ཟེར་གྱིན་གདའ།",
    "སྔོན་གྱི་གྲོང་ཤུལ་དངོས་ནི་ཞིང་དུ་འདུག་ཅིང་།",
    "དགོན་གནས་བཅུ་ཙམ་འདུག་པ་ཕལ་ཆེར་འཇིག་ཟིན་ཀྱང་།",
    "ཐང་དཀྱིལ་ནའང་རི་དེའུ་ཁ་ཤས་འདུག་ཅིང་།",
    "ཞབས་འབའ་ཞིག་ལུས་པའི་ལྡེར་བཟོ་བྱམས་ཆེན་ཐོག་ཚད་གཉིས་གསུམ་པ་ཞིག་ཡིན་རྒྱུར་སྣང་བ་ཞིག་ཀྱང་འདུག་གཞན་དེ་ནས་རྙེད་པའི་ངོ་མཚར་ཅན་གྱི་སྐུ་བརྙན་དང་།",
    "འབྲུག་པ་པད་དཀར་དགུང་ལོ་གཞོན་དུས་དགེ་སློང་ལྔ་བོད་དུ་སླེབས་པ་པིཥྐརཝཏི་ནས་ཡིན་ཅིང་རྒྱ་གར་ནུབ་ན་ད་དུང་བསྟན་པ་ཡོད་ཅེས་སྨྲས་འདུག་ཅིང་།",
    "ས་མིང་རང་ན་ད་ལྟ་ཡང་དྷརྣཀཌ་ཟེར།",
    "ཁ་ཆེའི་ཡུལ་ནས་ནུབ་ཏུ་ཨོ་རྒྱན་ཤིན་ཏུ་ཉེ་ཚོད་ཡིན་འདུག་ཀྱང་ལམ་མེད།",
    "རཛཧུར་བྱ་བ་ལ་རྒྱུས་མེད་པ་མ་གཏོགས་གཞན་གསུམ་དེ་ཀ་རང་དུ་ཡོད་འདུག་ཡུལ་དེ་ཨབ་གན་གྱི་རྒྱལ་པོའི་ཆབ་འོག་ཏུ་ཡོད།",
    "དེ་དུས་ནས་ཆེས་ཤིན་ཏུ་ཉམས་ཉེས་པར་ཡོད་འདུག་ལ།",
    "ཇལཾ་རྣམས་ཡིན་རྒྱུར་འདུག་གོ།",
    "རྣལ་འབྱོར་མང་པོ་ཞིག་ནི་ཕྱོགས་དེ་ནས་བྱོན་པར་འདུག་འོན་ཀྱང་རྒྱའི་བཙུན་པ་ཝེན་ཚག་དང་།",
    "མལཀོཊི་སོགས་བརྒྱུད་ནས་ཕེབས་ཤིང་དཀའ་ངལ་ཆེ་བའི་ལམ་རྣམས་ནི་བོད་ནས་རྒྱ་གར་དུ་འབབ་པའི་ས་མཚམས་རྐྱང་དུ་འདུག་པས།",
    "ངེས་པར་རྒྱང་རིང་ཙམ་ནས་བལྟས་ཙ་ན་གླང་ཆེན་གྱི་སྣ་དང་གདོང་འབུར་ཐམས་ཅད་གསལ་བའི་སྣ་མཆོད་རྟེན་དང་ཧ་ཅང་མི་རིང་པ་ན་ཡོད།",
    "ཏུརུཀས་བཟུང་མ་ཐག་པ་ཞིག་འདུག་གསུངས་ཀྱང་བསྟན་པ་ནི་དེའི་སྔོན་ཞིག་ནས་ཉམས་པར་མངོན་ཞིང་།",
    "སྔོན་དུས་ཀྱི་ནང་པའི་མི་རྒྱུད་དེ་ཀ་རང་ཡིན་པར་འདུག་འོན་ཀྱང་མི་རྣམས་དཔའ་ཞིང་རང་བཞིན་དྲང་།",
    "ཨོ་རྒྱན་རིན་དཔལ་ཡང་ཡར་ལམ་འདིར་བྱོན་ཅིང་བར་དེར་མ་ཧུར་ཡང་བྱོན་འདུག་པ་ལ།",
    "དེར་ཌཀི་ནི་བྱ་བ་བསྒྱུར་བར་འདུག་མཁའ་འགྲོ་མ་བྱ་བ་འཇིག་རྟེན་དུ་ངན་པར་གྲགས་ཀྱང་སྔགས་ཀྱི་གྲོགས་མཆོག་ཏུ་གྱུར་པ་ནི་ཤིན་ཏུ་ཡང་འོས་པ་ཡིན།",
    "ཐོག་མར་རབ་ཏུ་མ་བྱུང་བར་རྒྱལ་པོའི་ཁྲི་ལ་སྡོད་མི་རུང་བ་སོགས་ཡོད་འདུག་འོན་ཀྱང་བསྙེན་པར་རྫོགས་ཏེ་བསླབ་པ་ཉམས་པ་ནི་ཡུལ་འདི་ཐམས་ཅད་ན་ངན་རབ་ཏུ་བྱེད།",
    "གང་ལྟར་ཡང་དོན་ལ་བྷར་མ་རང་དུ་འདུག་འོན་ཀྱང་རྒྱུས་ཅུང་ཟད་ཙམ་ལས་མེད་དོ།",
    "དེ་ཙ་ན་ཡུལ་དེར་གཉུག་མར་གནས་པའི་ཁ་དོག་ནག་པོ་ཅན་གྱི་མི་སྟེ།",
    "ཕྱིས་ཙ་ན་སྒྲ་ངན་པ་དང་།",
    "དུས་དེ་ཙ་ན་ཨཱརྱཎ་གྱི་རིགས་རྣམས་ཤིན་ཏུ་འཕེལ་ཏེ།",
    "དགོད་བྲོ་བའི་ཡ་མཚན་པ་ཞིག་འདུག་གོ།",
    "དེ་བཞིན་ཕྱིས་ཙ་ན་ཚོགས་ཁོ་ནས་སྲིད་བསྐྱངས་པ།",
    "དཔྱད་པ་གསུམ་གྱིས་དག་ཚུལ་སོགས་ཀྱང་རང་མྱོང་ལ་སྦྱར་ན་ཤིན་ཏུ་དཀའ་སྟེ།",
    "གནས་དང་པོ་གཉིས་ཀྱི་དཔྱད་པ་དག་ལ་གནས་གསུམ་པ་བསྟན་པའི་ཆ་ལའང་རང་ཚིག་སྔ་ཕྱི་མི་འགལ་བ་ཙམ་བྱ་དཀའ་བ་ཡིན་པས་སོ།",
    "བྱ་བ་ཡང་འདི་ལ་ཟེར་བ་འདུག་དེ་ཡང་སྒྱུ་འཕྲུལ་མ་ལྷས་བསྟན་གྱིས་མའི་ཁྱིམ་དུ་བུ་བཙའ་བར་འགྲོ་བའི་ཚེ།",
    "དེ་དུས་ད་དུང་རང་ལོ་སུམ་ཅུ་ཙམ་ཡིན་ཟེར།",
    "མྱ་ངན་མེད་ཀྱི་དུས་ཙ་ན་ཡ་ཝན་དག་ཀྱང་རྒྱལ་པོ་དེའི་ལུང་ལེན་ཅིང་།",
    "ཁོང་ལ་རྣམ་འགྲེལ་གྱི་རྒྱ་དཔེ་ཁ་ཐོར་ཞིང་མ་ཚང་བ་ཞིག་འདུག་པ་བོད་དཔེ་ལ་བསྒྱུར་ཏེ་བསྒྲིགས།",
    "བྱ་བ་དེར་འདུག་པདཀཎྜཾ་སོགས་སྣང་།",
    "གལ་ཏེ་བརྒྱ་སྦྱིན་སྤྱི་བོ་མེད་སོགས་ཀྱི་རྣམ་འགྲེལ་འགྲེལ་པར་ཚིག་ཀྱང་དེ་ལ་ཟེར་བར་འདུག་དྲང་སྲོང་གྲོག་མཁར་སྒོམ་ལ་ཡུར་བ་ཕྱི་ནས་གྲོག་མ་རྣམས་ཀྱིས་གྲོག་མཁར་བརྩིགས་ཏེ་ལུས་ཧྲིལ་པོ་གཡོགས་ཀྱང་མ་ཟས་པར་གྲགས་པས་མིང་དེ་ཐོགས་ཟེར།",
    "ཀདམྦ་ཡང་ལོ་མ་ཤིན་ཏུ་སྟུག་པའི་ཤིང་ཆེན་པོར་འདུག་མེ་ཏོག་ནི་མ་མཐོང་།",
    "ཁ་དོག་ཀྱང་སྔོན་པོ་སྔོ་རྐྱང་མ་ཡིན་པར་ཅུང་ཟད་སྨུག་ཤས་ཆགས་པ་རྒྱལ་བའི་སྤྱན་གྱི་ཁ་དོག་དེ་ཁོ་ན་ལྟར་འདུག་པདྨའི་རྩ་བ་དཀར་པོ་བྱིས་པའི་ལག་ངར་ཙམ་པ་ཡོད་པ་ཞིག་རྒྱ་གར་བ་རྣམས་ཀྱིས་མར་ལ་བརྔོས་ནས་ཚོད་མ་བྱེད།",
    "རྒྱ་ནག་པ་རྣམས་མན་གོ་ཟེར་ཞིང་ཡི་གེ་འདི་ཡིན་པར་འདུག་སྡོང་པོ་ཐོག་ཚད་གཉིས་ཙམ་པ་ཡོད།",
    "འབྲས་བུ་ལྟང་སེར་བྱིས་པའི་མགོ་ཙམ་པ་ནས་ཁུ་ཚུར་ཙམ་པའི་བར་ཡོད།",
    "འདིའི་མིང་ལ་མངོན་བརྗོད་དུ་རྒྱབ་ཁྲ་ཟེར་བ་དེ་ལ་བྱེད་པ་ཡིན་འདུག་སྤྲུལ་མཐོང་ན་སྐད་འབྱིན་པ་ཡང་ཡོངས་གྲགས་ཡིན།",
    "རྒྱ་ནག་ནི་ས་གཤིན་ཅིང་དྲོ་བའི་རྒྱ་གར་གྱི་མེ་ཏོག་ལྗོན་པ་སོགས་རང་སྐད་དུ་བསྒྱུར་ནས་ཡུལ་གྱི་མི་ལ་ངོ་སྤྲོད་ཐུབ་པས་བཙུན་པ་ཐང་ཟན་ཙང་སོགས་ཀྱིས་ཚིག་ཐམས་ཅད་ཁ་ཐད་དུ་བསྒྱུར་པ་ཡོད་འདུག་པས།",
    "སྤྱིར་དཔེ་ལྡེབ་མ་རིང་པོ་བྲི་བའི་སྲོལ་འདི་དང་པོ་ཏལའི་ལོ་མར་བྲིས་པ་ལ་བརྟེན་ཏེ་རྒྱ་གར་དང་བོད་ཡུལ་སོགས་ལ་དར་བར་འདུག་ཅིང་།",
    "སྟོན་པ་སོགས་ཀྱི་སྐུ་དུས་ཙ་ན་བྱུང་བའི་མགདྷའི་ཡི་གེ།",
    "རྔོན་པ་དེས་གཞུ་ཊའི་དབྱིབས་ལྟ་བུ་རྣ་དྲུང་དུ་བཀང་སྟེ་གསུངས་པ་ལྟ་བུ་ལ་ལཉྩའི་ཊ་འདི་དང་ཝཏུ་ལ་འདི་ལྟར་ཡོད་པ་གཞུ་དང་འདྲ་དོན་མི་འདུག་ཀྱང་འདིའི་ཊ་འདི་ལྟར་འདུག་པ་གཞུ་དངོས་ལྟར་འདུག་པ་དང་།",
    "ཀློག་ཚུལ་དེ་ཡང་རྒྱ་གར་ལྟར་འདུག་པ་དང་།",
    "དེ་དུས་ཙ་ན་གུཔྟའི་ཡི་གེ་དང་ཡེ་ཁྱད་མེད་ལྟ་བུ་ཡོད་ཚོད་འདུག་དེར་མ་ཟད་དེ་དུས་ཀྱི་བལ་པོའི་རྒྱལ་པོ་རྣམས་ཀྱི་རྡོ་རིང་།",
    "འདི་འདྲ་འདུག་པ་འདི་ཡང་ཨོཾཡིག་ཏུ་འདུག་ལ་དེར་མ་ཟད།",
    "འོན་ཀྱང་གང་ན་འདུག་སྟོན་ཅིག་ཅེས་ངར་མཛད་ཀྱང་།",
    "གཡེལ་བྱ་བའི་མིང་གཞིའི་ཡི་གེ་ལ་བསམ་ནས་བྲིས་པ་ལྟར་འདུག་པས།",
    "དེ་ཕྱིར་མུ་སྟེགས་ཅན་ལ་སྨད་ན་རྣམ་པར་སྣང་མཛད་རིང་བར་འགྱུར་བ་ལ་ཁག་མི་འདུག་ཅིང་།",
    "འདི་ལྟར་ཙ་ནས་འའི་བར་གྱི་དཀྱུས་གཅིག་ཏུ་ཡོད་པའི་ཡི་གེ་བདུན་ཀ་ཐུ་མིས་གསར་དུ་བསྣན་པ་ཡིན་ཅིང་།",
    "ཁྱིམ་ལ་ཁྱི་མ་ཁི་ཡ་མ་ལྟ་བུར་ཀློག་ངས་བྱིས་པ་གཅིག་ལ་ཡི་གེར་བྲིས་དང་སྨྲས་པས་ཁོས་ཁྱིམ་ཞེས་བྲིས་འདུག་པ་སོགས་ཡ་བཏགས་རྣམས་ཀློག་ས་མགོ་དག་པར་ཀློག་མཁན་ནི་བླ་དགས་པ་ཙམ་སྟེ་ཁོང་རྣམས་སྐྲ་ལ་སཀར།",
    "བོད་ཀྱི་རྩོམ་དངོས་མ་ནི་འདི་ཚོ་ཡིན་འདུག་སྟེ།",
    "ཚིག་གསལ་ཆེ་བར་བྲིས་ཚེ་ཀུན་གྱིས་གྲོང་ཚིག་ཅེས་སྨྲ་ཡིན་གདའ་སྟེ།",
    "འདུག་འབབ།",
    "གཙང་ན་རྡོ་རྗེ་གདན་སོགས་འདུག་པ་ལ་མི་མཚར་ན་བོད་སྐད་ཀྱི་བྱིངས་བྱ་བའི་ཐ་སྙད་ལ་དེ་ཙམ་སྣང་བ་ཅི་ཡིན།",
    "མིང་ལས་ཚིག་ཏུ་སྒྲུབ་པ་སོགས་བྱེད་ཀྱི་གདའ་སྟེ།",
    "ཇི་ལྟར་བྲིས་པའི་དོན་འདི་ཡང་རང་ཉིད་ཀྱིས་སྤེལ་བར་བྱ་ཞིང་ཉམས་པར་མི་བྱ་ལ།",
    "འོན་ཀྱང་རང་འགྲེལ་ག་ལས་འཇིགས་མེད་དུ་གྲགས་པ་ནི་བོད་དུ་བསྒྱུར་བ་འདི་ཁོ་ན་ལས་མེད་པར་འདུག་འགྲེལ་བ་དེ་ཡང་རབ་བྱེད་ཉེར་བདུན་པར་འཕགས་པ་ལྷའི་ལུང་དྲངས་པའི་ཕྱིར་རང་འགྲེལ་མིན་ཅེས་རྗེ་བདག་ཉིད་ཆེན་པོས་གསུངས།",
    "མྱ་ངན་མེད་ཀྱི་སྲིད་ཉམས་པའི་དུས་ཙ་ན་ཏམིལའི་རྒྱལ་ཁམས་ཀྱི་བྱང་སཏ་བ་ཧ་ན་བྱ་བའི་རྒྱལ་བརྒྱུད་སྟོབས་ཆེ་བར་གྱུར་ཅིང་།",
    "རུང་ཁང་དང་ཉེ་བར་འཕྲོག་མའི་སྐུ་བརྙན་སྣུམ་མང་པོ་སྟེང་དུ་བླུགས་ཏེ་ནག་ཁོལ་ལེ་འདུག་སོགས་གསུངས་པས་འུ་ཅག་འབྲས་སྤུངས་འདྲ་ཡང་དྲན།",
    "དུས་ཀྱང་ཞི་འཚོའི་སྐུ་ཚེ་སྟོད་ཙ་ན་ཡིན།",
    "ཕྱིས་ཙ་ན་ལུང་ལེན་པའི་ཁམས་ཀྱི་རྒྱལ་ཕྲན་ལྟ་བུར་བྱས་ཏེ་སྡོད་པ་ཙམ་བྱུང་།",
    "ཕྱིས་ཙ་ན་ཁ་ཆེའི་ཡུལ་སིནྡྷུ་སོགས་ཀྱང་འོག་ཏུ་ཆུག་རྒྱུན་དུ་གསེར་གྱི་རྔ་བརྡུང་བའི་མི་བརྒྱ་ཕྲག་དང་བཅས་པའི་དམག་ཆེན་ཁྲིད་དེ་ཡུལ་རྣམས་སུ་བསྐོར་ཞིང་།",
    "བཙུན་པ་འདིའི་དུས་ན་ད་དུང་རྒྱ་གར་ན་དགེ་སློང་མ་ཡང་ཡོད་འདུག་ཅིང་།",
    "དེ་མཚུངས་རྒྱ་ཡུལ་དུ་ཡང་དགེ་སློང་མ་ཡོད་པར་འདུག་རྒྱའི་བཙུན་པ་སྔ་ཕྱི་འདི་གསུམ་གྱི་རྒྱ་གར་ལམ་ཡིག་རྣམས་མཇལ་ཚེ་ཁ་སང་རྒྱ་གར་ནས་བྱོན་ནམ་སྙམ་པ་ཙམ་འཆར།",
    "དེ་ནས་བྷངྒའི་ཡུལ་དུ་དམག་དྲངས་ཏེ་གོ་ཊའི་རྒྱལ་པོ་བསད་པའི་བྱུང་བ་དག་དུས་མཉམ་པའི་སྙན་དངགས་མཁན་བཀྭཏིརྭཐ་ངག་བདག་རྒྱལ་པོ་བྱ་བས་པྲཀདའི་སྐད་དུ་ཚིགས་བཅད་བྱས་ཏེ་བྲིས་པ་ཡོད།",
    "སྟོན་པ་འདས་རྗེས་ཀྱི་ལོ་ཆིག་སྟོང་དྲུག་བརྒྱ་ལྷག་པའི་སྐབས་ཙ་ན་སླར་ཡང་བྷངྒ་ལར་སེ་ནའི་རྒྱལ་བརྒྱུད་དུ་གྲགས་པ་ཞིག་མངོན་ཆེ་བར་བྱུང་།",
    "ནོ་ཧ་ཨཔཱརཧཾ་ཨ་བར་ཧཾ་བཱར་ཧྨ་རྣམས་ཀྱི་མིང་ཡིན་པར་འདུག་སྟེ།",
    "ཀླ་ཀློའི་མགོན་པོ་མདྷུམཏི་ཞེས་དངོས་སུ་འཐོན་འདུག་པས་དེ་ལེགས་སྦྱར་རང་དུ་བསམ་ནས་བསྒྱུར་བར་ཐེ་ཚོམ་མེད་དེ།",
    "ད་ཧར་རང་ཉིད་དམག་དཔོན་དུ་བྱས་ཏེ་རོཨར་བྱ་བའི་གྲོང་ལྕགས་རི་ཅན་གྱི་ཉེ་འདབས་སུ་འཐབ་འཛིང་བྱས་ཀྱང་མཐར་རྒྱལ་པོ་ཁོ་རང་དམག་ནང་དུ་ཤི།",
    "དེ་ལ་ཡང་རང་ཚིག་སྔ་ཕྱི་འགལ་བ་ཡེ་མེད་དོ་ཞེས་ཀྱང་ཤེས་པར་བྱའོ།",
    "ནོར་མང་དུ་རྙེད་པས་ཁོ་རང་ཡང་ཧ་ལས།",
    "རྒྱ་གར་ནས་འཕྲོག་པའི་ནོར་རྣམས་ཀྱང་རང་ཡུལ་གྱི་མཁས་པ་དག་ལ་ཆ་རྐྱེན་དུ་སྦྱར་བ་སོགས་ཡོན་ཏན་གྱི་བག་ཙམ་ཡང་མཆིས་པར་གླེང་།",
    "དེ་དུས་ཙ་ན་པྲཏིཧར་རྣམས་ཀྱང་ཡུལ་འདིར་སྲིད་སྐྱོང་།",
    "ཉེ་བར་སྐྲ་མེད་པའི་དགེ་སྦྱོང་རྣམས་ཀྱི་སྟེ་ཆེན་པོ་ཞིག་བཅོམ་ཞེས་བྱུང་བ་བི་ཧར་ཤ་རིབ་ཨོཏནྟཔུ་རི་ལ་ཟེར་བའི་འདི་ན་ལེནྡྲ་ཡིན་པར་འདུག་ལ།",
    "ཛིཔུརའི་དཔའ་བོ་རྣམས་ཀྱི་རོ་ལ་རྒྱལ་པོ་རང་ཉིད་ཀྱི་མེ་ཏོག་སྤར་བ་གང་རང་ཕུལངྐད།",
    "འོན་ཀྱང་དེ་རྒྱ་ཆེ་ཚད་ཞིག་ཏུ་འདུག་དྲི་མེད་འོད་ཀྱང་།",
    "ཐམས་ཅད་ཁ་རོག་པར་འདུག་ལན་གཉིས་པ་བསྒྲགས་པ་ལ་ཡང་ལན་མ་བྱུང་།",
    "ཡང་འོངས་པའི་ཐམས་ཅད་བྲོས་པའི་ཤུལ་ནས་ཨཎིབིཤ་ནས་འོངས་པའི་ཧིབཏ་ལུས་འདུག་པས་འོས་མེད་དུ་ཁས་ལེན་དགོས་བྱུང་།",
    "ཁོང་པ་རྣམས་ཀྱང་རང་ཡུལ་ལ་མིང་དེ་ག་དང་།",
    "ཁོང་དག་ལ་ཡང་རྒྱུས་འདུག་རྒྱ་གར་ནུབ་ཀྱི་ཀླ་ཀློ་རྣམས་ནི་གླིང་འདི་ལ་སོརྞདྭིཔ་སྟེ་གསེར་གླིང་དུ་འབོད་ཅིང་གནས་ཆེན་དུ་བརྩི།",
    "གཞན་གཅན་གཟན་འདུག་པ་དུག་སྦྲུལ་དང་།",
    "ཐོ་རངས་ཙ་ན་གྲོང་ཐམས་ཅད་ཅིག་ཆར་དུ་གླུ་དང་རྔ་སྒྲ་དང་།",
    "བྱིས་པ་རྩིས་ནོར་ཚེ་དབྱུག་གུ་དེ་ཉིད་ཀྱིས་མགོ་ལ་བསྣུན་པ་སོགས་བྱེད་ཀྱིན་འདུག་པས།",
    "སྒོམ་བྱེད་ཀྱིན་འདུག་ཅེས་ཟེར།",
    "འདིར་མིང་ལ་ངེས་པ་མི་འདུག་ཅིང་།",
    "འདྲ་ཚུལ་ཡང་དོན་ལ་དེ་བཞིན་པར་འདུག་གོ།",
    "གཙུག་ལག་ཁང་ཆེན་པ་གསུམ་གྱི་རྩ་བའི་གནས་གཞི་དག་ཡིན་པར་ཐེ་ཚོམ་མི་འདུག་ཅིང་།",
    "སྤྱིར་སེར་སྐྱའི་སྐད་དོད་ཀཔིལ་བྱ་བར་བྱས་འདུག་ལ་ཨམརཀོཤར།",
    "ལུང་འགངས་ཆེན་རིགས་ཡི་གེར་མི་བྲི་བ་དེ་སྔོན་རྒྱ་གར་ན་ཕྱི་ནང་གཉིས་ཀའི་སྲོལ་དུ་ཡོད་འདུག་ལ།",
    "ཇོ་ནང་ཀུན་མཁྱེན་གྱིས་ཕོ་ཉ་བརྒྱད་ཡོད་གསུངས་པ་དེ་ཚོའི་གྲས་ཡིན་རྒྱུར་འདུག་གོ།",
    "དུས་འདི་ཙ་ན།",
    "འདིའི་གཉེན་ཚན་གྱི་རྒྱུད་པར་གྲགས་པའི་མི་ངོ་འགའ་ཞིག་ཀྱང་ད་ལྟའི་བར་ཀུརྡུནེགལ་བྱ་བའི་ཡུལ་ན་འདུག་དགྲ་བཅོམ་འདིའི་སྐུ་བསྟོད་སོགས་ཀྱང་མང་དུ་སྣང་ཞིང་།",
    "དགྲ་བཅོམ་འདི་ལ་མཚན་དེ་འདྲ་ཡོད་པ་རྒྱུས་མི་འདུག་ཅིང་།",
    "དེ་དུས་ཁོང་རྣམས་ཀྱིས་བྱས་པའི་རྩོད་པ་ཀུན་ཡི་གེར་བཏབ་པ་ཞིག་ཀྱང་འདུག་པ་ཤིན་ཏུ་ངོ་མཚར།",
    "ངེད་ཀྱང་སྟབས་ལེགས་སུ་དེ་ལ་སླེབས་པར་བོད་ཀྱི་ཡུལ་ནས་ཀྱང་ཐོས་ཏེ་འོངས་འདུག་སོགས་གྲགས།",
    "ད་དུང་པོ་ལོན་ན་རྒྱུ་པ་ན་རྒྱལ་པོ་ཨརཀྲ་མས་བཞེངས་པའི་མཆོད་རྟེན་འདི་ལས་ཉིས་འགྱུར་ལྷག་ཆེ་བ་ཞིག་ལ་ཕྱེད་ལས་མ་ཟིན་པ་ཞིག་ཀྱང་འདུག་སིངྒལའི་རྒྱལ་པོ་རྣམས་ཀྱིས་མཆོད་རྟེན་བཞེངས་པའི་ཧམ་པ་དེ་ལ་སུས་ཀྱང་འགྲན་དཀའ།",
    "ཕལ་ཆེར་འབྲོག་ཁྱིམ་གྱི་རྣམ་པར་ཆགས་ཡོད་ཚོད་དུ་འདུག་འདྲེ་ལ་སོགས་པ་ལ་དཔྲལ་བ་ན་མིག་གཅིག་དང་།",
    "གླུ་ཁོ་རང་ཡང་།",
    "དབུས་གཙང་དུ་ལྷ་པ་རྣམས་ཀྱི་གྱོན་རྒྱུ་བཙན་ཞྭ་བྱ་བའི་ཞྭ་ཁུག་མའི་དབྱིབས་སམ་མདའ་ཤུབས་ལྟ་བུའི་རིང་པོ་ཞིག་འདུག་ཅིང་།",
    "བོད་སྐྲ་བཞར་ཞེས་པའི་གཏམ་དཔེ་ཡང་འདུག་འབྲུག་པ་རྣམས་ཀྱང་ཐམས་ཅད་སྐྲ་ཧྲིལ་པོར་བྲེགས་པ་ཡིན།",
    "བླུན་འཆར་གྱི་རྫུན་ཡང་མང་དུ་བསྲེས་པས་ཡི་གར་འོང་བ་ཞིག་མི་འདུག་ནའང་།",
    "ཁ་ཆེ་བ་མིན་མ་ཧཱ་ཙི་ན་ནས་འོངས་པའི་བོད་པ་ཡིན་ཅེས་བྲམ་ཟེ་ཞིག་ལ་གསུངས་པ་སོགས་འདུག་འདི་རྨན་ཚེ་བྱ་བ་དང་གཅིག་པར་བུ་སྟོན་གསུངས།",
    "གཙང་ནི་གཙོ་བོའམ་རྒྱ་ཆེན་པོ་ལ་བྱེད་པ་ཡིན་འདུག་གོ།",
    "རྒྱའི་དམག་དཔོན་ཐུག་པུ་ཤི་བཟུང་སོགས་བྱུང་བས་ཙོང་ཁ་ཆེ་ཆུང་གཉིས་ཀྱང་བྱེད་པ་ཡིན་འདུག་གོ།",
    "རྒྱ་གར་པ་རྣམས་ར་མཆོད་སྦྱིན་ལ་མཆོག་ཏུ་བྱེད་པ་དེ་ཡིན་སྙམ་གསུམ་ལྡན་གྱི་དུས་ཙ་ན་དུད་འགྲོ་རྣམས་རི་དྭགས་དང་ལུང་དྭགས་ཀྱི་ཚན་པ་གཉིས་སུ་གྱུར་ཏོ།",
    "སྐྱེ་བ་ལྔ་པའི་དུང་རང་ཉིད་ཀྱིས་བྱས་སོ།",
