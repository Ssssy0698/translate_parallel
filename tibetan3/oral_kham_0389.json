    "ཉན་ཐོས་རྣམས་དང་རང་སྟོང་སྨྲ་བ་དང་།",
    "ཁྱད་པར་རང་རང་གཞུང་དང་དངོས་སུ་འགལ།",
    "འདི་དག་དང་རང་སྟོང་སྨྲ་བ་ཡང་ཅུང་ཟད་གཅིག་མ་གཏོགས་པ་ལྟ་བ་ཆེས་མཐུན་ནོ།",
    "རྒྱ་བོད་མ་གཏོགས་ཁྱད་པར་ཅི་འདུག་ལྟོས།",
    "ཀུན་གཞི་འགོག་དང་རང་རིག་འགོག་པ་དང་།",
    "ཁྱད་པར་རང་རང་གཞུང་དང་དངོས་སུ་འགལ།",
    "ཕྱི་ནང་མཐའ་དབུས་ཆེ་ཆུང་བཟང་ངན་མཆོག་དུས་སོགས་བློས་སྒྲོ་བཏགས་ཀྱིས་གཟུང་བྱ་ཐམས་ཅད་དོ།",
    "ལྟ་བའི་ངོས་ནས་དེ་བས་ཀྱང་རང་སྟོང་མཐོ།",
    "ལྷ་དང་མིའི་འགྲོ་བ་ནི་དེ་རྣམས་ལ་ལྷོས་ན་སྲིད་མཐའ་ཙམ་ཡིན་པར་འདུགདེ་ལས་ཀྱང་སྤྱིར་མིའི་འགྲོ་བ་ཉུང་།",
    "དེ་ལྟར་ཤིན་ཏུ་རྙེད་དཀའ་བའི་མི་ལུས་འདི་ལན་གཅིག་ཐོབ་པའི་སྐབས་འདིར་དོན་ཆེན་པོ་ཞིག་སྒྲུབ་དགོས་པར་འདུག།",
    "སྤྱིར་འཆི་བ་ལས་འོས་མི་འདུག་དགོས་སུ་ཚེ་ལ་སྣོན་ཁ་རྒྱག་མཁན་ནི་མེད།",
    "ལེ་ལོ་དང་བར་སྐབས་སུ་བསྒོ་ལ་བའི་ཐབས་ཡེ་མི་འདུག་སྙམ་དུ་བསམ་དགོས།",
    "འཆི་བདག་སྒོ་དྲུང་ན་སླེབ་ཚར་བའི་ཝོ་དུ་གདའ།",
    "བདེ་སྡུག་གཏམ་གསུམ་འདི་ཀུན་དང་ཡུན་རིང་འགྲོགས་སྐབས་མི་འདུག་ཅིས་ཀྱང་ཅི་བྱེད་སྙམ་པ་དང་།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "འཆི་བ་ལ་ཇེ་ཉེ་ཇེ་ཉེར་འགྲོ་བ་དེར་འདུག།",
    "རང་བས་རྒན་པ་ཡང་ཅི་ཙམ་ཞིག་ཤི་འདུག།",
    "མཉམ་པ་དང་གཞོན་པ་ཡང་ཅི་ཙམ་ཞིག་ཤི་འདུག་བསམས་ན་ད་ལྟ་ཡོད་པ་བས་ཤི་བ་མང་།",
    "དེ་དག་ཀྱང་ཚེ་ཚད་དུ་ཐུབ་ནས་ཤི་བ་ཙམ་ཆེར་མི་འདུག།",
    "བྱས་ནས་ཕྱི་བགོལ་དུ་འཇོག་པའི་ཐབས་རང་འདུག་གམ་སྙམ་དུ་བསམ།",
    "གོམས་དགོས་ལྷོངས་སུ་གྱུར་དགོས་པ་འདུག།",
    "དེ་ཡང་སྟོད་བཏུབས་ཙ་ན་སྨད་འགྲིག།",
    "སྨད་བཏུབས་ཙ་ན་སྟོད་འགྲིག།",
    "བཟོད་པའི་གོ་སྐབས་ཅུང་ཟད་ཀྱང་མི་འདུག་སྟེ་ལན་ཅིག་དེར་སྐྱེས་ཟིན་ནས་ཟློག་པའི་ཐབས་མེད།",
    "འགྲོ་སྡོད་ཀྱི་ས་ཙམ་ཡང་མི་རྙེད་པའི་ཚུལ་ཙམ་དུ་ཡོད་པར་གདའ།",
    "དེ་ལས་སྐྱོབ་པའི་སྐྱབས་ཞིག་དགོས་པར་འདུག།",
    "ལས་འབྲས་སེབ་ཚགས་སུ་གཏོང་བའི་ལུགས་ཀྱང་འདུག་སྟེ།",
    "བཅུ་བོ་དེ་དག་དུས་རྒྱུན་དུའམ་དལ་བར་འདུག་པའི་དུས་སུ་མི་བྱེད་པར་མ་ཟད།",
    "ཡང་དགེ་སྡིག་གཉིས་མ་ཡིན་པའི་ལས་ལུང་མ་བསྟན་ཞེས་བྱ་བ་འགྲོ་འཆག་ཉལ་འདུག་སོགས་ངེས་མེད་སྣ་ཚོགས་པ་ཞིག་འདུག་པ།",
    "འི་འབྲས་བུ་མེད་ཀྱང་དོན་མེད་དུ་དུས་འདའ་པར་འདུག།",
    "དྲན་ན་གཞན་མི་དགོས་སྐྱེ་བའི་སྡུག་བསྔལ་གཅིག་པུ་ལ་བསམ་ཀྱང་མིར་སྐྱེས་པ་ལ་གྲོག་ཅི་ཡང་མི་འདུག།",
    "མིའི་འགྲོ་བ་མངལ་སྐྱེས་ཀྱི་སྡུག་བསྔལ་ནི་དེ་ལྟ་བུར་འདུག།",
    "འདུག་པ་ན་ཚ་དོ་ཐག་པ་ཆད་པ་བཞིན་སྡོད།",
    "ཕ་མ་སྦུན་ཟླ་ཁྱིམ་ཐབ་གྲོགས་ལ་སོགས་པ་མེད་ཐབས་མེད་པ་དང་བྲལ་ཙ་ན།",
    "ཐོས་བསམ་གྱི་གོ་བ་ཙམ་ཞིག་ཡོད་པ་སྲིད་ནའང་རང་བློའི་འཆར་ཚུལ་ལ་བརྟགས་ན།",
    "གང་ཡང་མི་ཤེས་པའི་མུན་ཐོམ་མེ་བའི་རྣམ་རྟོག་གཅིག་འདུག་པ་འདི་ཀ་ཡིན།",
    "ཡང་རང་ངམ་རང་ཕྱོགས་ལ་གནོད་ན་དེ་ལ་ཞེ་སྡང་འབྱུང་སྟེ།",
    "རང་གཅིག་པུ་གྲོལ་བའི་ཐབས་སྒྲུབ་པ་དེ་ཁྲེལ་མེད་གདོད་ཆུང་ཕྱི་ཐག་མེད་པ་གཞན་དོན་སྤངས་པའི་ཐར་བར་འདུག་པ།",
    "དེའི་རྒྱུར་བྱམས་པ་དགོས་པར་འདུག།",
    "དེའི་རྒྱུར་བྱས་པ་ཤེས་ཤིང་དྲིན་དུ་བཟོ་བ་དགོས་པར་འདུག།",
    "རྒྱུ་འབྲས་རིམ་པ་ལྟར་མཛད་པ་འདི་ཁར་འདུག།",
    "དེ་རྣམས་རྒྱུ་འབྲས་བདུན་ཡིན་བྱ་བ་ཡོད་པས་རྒྱུ་འབྲས་བདུན་གྱི་ཐ་སྙད་ཀྱང་ཕྱིས་ཀྱི་གསར་བྱུང་རང་མིན་པ་གོ་དགོས་སོ།",
    "དང་པོ་ནི་རྩ་བའི་མ་བྱ་བ་ཚེ་འདི་བསྐྱེད་པའི་མ་ལ་ཟེར་བ་ལགས་ཏེ་འདི་བདག་ལ་དྲིན་ཆེ་བར་འདུག།",
    "ལས་ལ་འཁོལ་བ་དང་ཆད་པས་བཅད་པ་སོགས་དངོས་སུ་རང་ཡང་སྡུག་བསྔལ་འདི་མི་མྱོང་བྱ་བ་མེད་པ་དེར་འདུག།",
    "གད་ཁ་གཡང་ཁ་ཅིག་ནས་མར་ལྷུང་ལ་ཁད་ཁད་འདུག་ན་བདག་ཅི་ཙུག་བྱེད།",
    "མ་འདི་རྣམས་བདེ་དགོས་པར་འདུག།",
    "སྐྱིད་དགོས་པར་འདུག་པ་ལ།",
    "འོན་ཀྱང་དེའི་ནུས་པ་བདག་ལ་མི་འདུག།",
    "གཉེན་པོས་མ་སླེབ་པར་ཐུན་ཚོད་གཅིག་འདས་ན་སེམས་བསྐྱེད་གཏོང་བ་ཡིན་པར་འདུག།",
    "ང་བདག་ཅེས་པ་གནས་ཚུལ་ལ་གྲུབ་པ་ཡེ་མེད་པར་འདུག་སྙམ་དུ་བསམ།",
    "དེས་ན་ལུས་ཞེས་བྱ་བ་བློས་བཏགས་པ་མ་གཏོགས་བདེན་པར་མི་འདུག།",
    "བདེ་སྡུག་བཏང་སྙོམས་མྱོང་བ་སོགས་ཚོར་བར་འདུག་སྟེ།",
    "མཐོ་དམན་བཟང་ངན་མིང་དོན་སྣ་ཚོགས་འཛིན་པ་སོགས་འདུ་ཤེས་སུ་འདུག་སྟེ།",
    "ད་ཤེས་པའི་རྣམ་གྲངས་དེ་ཐམས་ཅད་ཀྱང་རིག་རིག་ཅོ་ཅོ་པོར་འདིའི་རྣམ་འགྱུར་མ་གཏོགས་ཚུགས་ཐུབ་ཏུ་མི་འདུག།",
    "ད་ལྟའི་རིག་པ་སྐད་ཅིག་མ་བྱས་ཀྱང་རང་ངོས་ནས་བདེན་པར་གྲུབ་པ་མེད་དེ་སྐད་ཅིག་གཅིག་པོ་དེ་ལའང་སྔ་མ་དང་འབྲེལ་བ་སྐྱེ་བའི་ཆ་གཅིག་དང་།",
    "གང་ཡང་གཅིག་པུའི་ངོ་བོ་མ་གྲུབ་པ་དེར་གདའ།",
    "ཡང་རང་གཞན་སྣོད་བཅུད་མཐོང་ཐོས་གཟུགས་ཅན་ཐོགས་བཅས་ཐམས་ཅད་ནི།",
    "ད་འདི་ལ་གེགས་སེལ་གྱི་ཐ་སྙད་གསུང་བར་གདའ།",
    "དགྲ་གཉེན་ལོངས་སྤྱོད་གཏམ་སོགས་ཀྱི་རྣམ་རྟོག་རགས་པ་དེ་ཀ་འདུག་ན།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "ཞེས་གཞན་སུ་ལའང་སྐྱོན་ཞིག་འདུག་པ་མཐོང་ན།",
    "ང་རང་སྣང་བ་མ་དག་པ་ཡིན་ཁོང་ལ་དེ་ལྟ་བུ་ཨེ་ཡོད་མི་ཤེས་རང་སྣང་མ་དག་པས།",
    "ཡང་བདག་གཅེས་འཛིན་ཅི་འདྲ་འདུག་བལྟ།",
    "ཡང་གཅེས་འཛིན་སྐྱེ་བར་འདུག་ན།",
