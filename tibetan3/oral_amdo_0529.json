    "གདུགས་དང་རྒྱལ་མཚན་སོགས་ཀྱི་རི་མོ་སོགས་འབུར་གྱིས་གྲུབ་ཅིང་།",
    "དུང་གི་གཟུགས་ཀྱི་རྣམ་པས་ཕྱོགས་ཀུན་འགེང་བ།",
    "དུས་བཟང་ལ་ལྷའི་རྔ་དང་དུང་རོལ་མོ་གཎྜི་སོགས་ཀྱི་སྒྲ་གྲགས་པ་མཐུན་སྣང་དུ་ཐོས་པ།",
    "རུས་བུ་མཐེབ་སེན་གྱི་ཆེ་ཆུང་གོར་མོ་མང་བོའི་སྟེང་དུ་ཡིག་འབྲུ་དང་རི་མོ་སྣ་ཚོགས་ཡོད་པ་གང་ས་གང་དུ་རྙེད་རྒྱུ་ཡོད།",
    "དཔལ་ལྡན་ལྷ་མོའི་དྲེའུ་རྗེས།",
    "ལྷ་ལྷ་མོའི་རྣམ་པར་སྣང་ངོ་ཞེས།",
    "ལྷའི་རྔ་བརྡུངས་སྙན་པའི་རོལ་མོ་འཁྲོལ།",
    "ཁོང་གིས་འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོ་བསྒྲུབས་ནས་ཡིག་དྲུག་ལ་ཐུགས་དམ་གྱི་མཐིལ་མཛད་པས་ཞལ་གཟིགས་དང་གྲུབ་རྟགས་མང་བོ་སྟོན་ནུས་པ་བྱུང་།",
    "བཞུགས་གནས་ཀྱི་ཕྱི་རོལ་བྲག་གི་ངོས་རྣམས་སུ་མཚལ་གྱིས་བྲིས་པ་ལྟ་བུའི་ཡི་གེ་དྲུག་མའི་གཟུངས།",
    "དུང་དང་གླིང་བུ་སོགས་རོལ་མོའི་སྒྲ་སྙན་སིལ་སིལ་འཁྲོལ་བ་ཕྱོགས་ཀྱི་ངོ་མཚར་བའི་ལྟས་ཁྱད་པར་བ་མང་བོ་ཡོད།",
    "སྟག་ལུང་གི་རིའི་རྒྱབ་ཕྱོགས་སུ་འབྲུ་ལུང་ཟ་ལུང་སྤྱང་ལུང་སོགས་ཡོད་པ་ལས་སྤྱང་ལུང་གི་ཕུའི་རྭ་རྩེ་ཕུག་པ་ནི།",
    "སྐབས་ཤིག་ནས་གནས་འདིར་བྱོན་ཏེ་གཟུངས་སྔགས་ཟབ་མོ་བཟླ་བ་དང་།",
    "དེར་ཁོང་གིས་ད་སྒྲིབ་པ་དག་ཟིན་སྙམ་སྟེ་འཕུར་ནས་མཚོ་ཞིག་གི་འགྲམ་དུ་བབས་པར་མཚོ་བསྐམས་པས་དེ་ལ་དེང་སང་ད་དུང་མཚོ་སྐམ་དུ་གྲགས།",
    "དེ་ནས་ལྷག་པར་སྒྲིབ་སྦྱོང་ལ་གཞོལ་བས་སྡིག་སྒྲིབ་ལྷག་མེད་དུ་དག་སྟེ་ཡི་དམ་ལྷའི་ཞལ་གཟིགས་ཤིང་གྲུབ་པ་ཐོབ།",
    "མཐར་འཇའ་ལུས་བརྙེས་ཤིང་བཞུགས་གནས་ཀྱི་བྲག་ལ་དཀྱིལ་འཁོར་གྱི་རི་མོ་དང་།",
    "ལྷ་སྐུ་དང་ཡིག་འབྲུ་ཕྱག་མཚན་མཆོད་རྟེན་སོགས་ཀྱི་རི་མོ་རང་བྱོན་མང་དུ་བབས་ཡོད།",
    "ཁོང་གིས་སྔོན་སྒྲིབ་སྦྱོང་གནང་སྐབས་སྨད་པ་དཀར་རྩེ་གདོང་དང་།",
    "ཨ་མགྲོན་མཁས་བཙུན་རྒྱ་མཚོས།",
    "ཁོང་ཚོས་བུ་སློབ་སོགས་མཁས་གྲུབ་དམ་པ་མང་དུ་བཞུགས་པར་གསལ་ཞིང་།",
    "གོང་གི་གནས་དེ་དང་ཉེ་བ་ན།",
    "ཨ་མགྲོན་གྱིས།",
    "དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་སྐུ་དང་མཆོད་རྟེན་སོགས་ཀྱི་རི་མོ་རང་བྱོན་དུ་ཕེབས་པ་མང་ལ།",
    "མཐའ་རྣམས་སུ་གཟིག་སོགས་གཅན་གཟན་རི་དྭགས་རྒྱུ་བའི་ནགས་ན་པདྨ་དང་ཨ་གར་ཤིན་ཏུ་མང་བོ་དང་།",
    "རྫ་རི་སྨུག་པོ་སྟག་མོ་མཆོངས་འདྲ་མང་བོས་བསྐོར་བར་ཡོད་དོ།",
    "གཡུ་ལུང་དུ་ཡུན་རིང་སྒྲུབ་པ་མཛད་པས་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་རྟོགས་པ་ཀློང་དུ་གྱུར།",
    "ཨ་མཐུའི་སྔགས་པ་གཡུ་རྔོག་གྲུབ།",
    "ཨ་མགྲོན་གྱིས།",
    "ཨ་མཐུའི་སྲས་པོ་གཡུ་རྔོག་གྲུབ།",
    "དེ་ལ་སྲས་ཨ་བོ་མཐུ་ཆེན་ཟེར་བ་ཞིག་ཡོད་པ་ལ་ཕྱིས་སུ་ཨ་མཐུ་ཞེས་གྲགས།",
    "རང་གི་ཡུལ་གྲོང་དང་ཉེ་བ་བཀྲ་ཤིས་ཐང་ཟེར་བ་དེང་སང་ཧོར་རྒྱལ་མཚན་གཞུང་དུ་གྲགས་པ་དེར་སླེབས་ནས་རྒད་པོས་ཆུང་མ་ལ་སྨྲས་པ།",
    "ཆུང་མས་ད་དུང་རང་གི་ཁྱིམ་ལ་མ་སླེབས་ཀྱི་བར་དུ་འབྱེད་མི་རུང་ཚུལ་སྨོས་ཀྱང་མ་ཉན་པར་ཕྱེས་པས།",
    "མ་འགྱངས་པར་སྲས་ཤིག་འཁྲུངས་པའི་སྤྱི་བོར་རལ་བ་ལེབ་མོ་རྩྭ་གྲེས་མའི་དབྱིབས་ཅན།",
    "ཆེར་སྐྱེས་ནས་རེ་ཞིག་དམེ་ཤུལ་ལུང་བའི་དགོན་ཞིས་སུ་གྲགས་པར་བཞུགས།",
    "དཔལ་ལྡན་ལྷ་མོ་བྲན་དུ་འཁོལ་ཞིང་རིགས་རྒྱུད་ལ་ལུས་དང་གྲིབ་མ་བཞིན་དུ་འགོ་བར་ཞལ་གྱིས་བཞེས།",
    "ནུབ་གཅིག་དཔལ་ལྡན་ལྷ་མོས་སང་ཉིན་ཆུ་འགྲམ་དུ་དངོས་གྲུབ་ཀྱི་རྫས་ཤིག་ཡོད་པས་ལོངས་གསུངས་པ་ལ།",
    "དེ་ལ་ཁོང་གི་རྒྱུད་པ་གཡུ་རྔོག་ཏུ་གྲགས་ཤིང་ད་ལྟའི་བར་དུ་སྔགས་འཆང་ནུས་པ་ཅན་ཟམ་མ་ཆད་པར་བྱོན།",
    "འབྲི་དཀར་མོ་རྭ་རིང་གི་རྒྱུད་པ་ཞེས་ད་ལྟ་ཡང་ངག་རྒྱུན་ལ་གྲགས།",
    "ཁྱད་པར་སྒྲོལ་དཀར་འོད་ཟེར་དྲུག་སྦྲགས་མའི་ཚེ་ཁྲིད་གསན་ནས་ཐུགས་ཉམས་བཞེས་པའི་སྐབས་ཤིག་ཤེལ་ལས་གྲུབ་པའི་གཞལ་ཡས་ཁང་གི་ནང་སྒྲོལ་མ་དཀར་སྔོན་གྱི་སྐུས་བར་མཚམས་མེད་པར་གང་བ་དང་།",
    "ཕྱག་མཚན་ཨུཏྤལ་དཀར་བོས་གང་བ་སོགས་ཀྱི་གཟིགས་སྣང་དང་།",
    "ཅེས་གསུངས་པ་རེ་སྐོང་སྟོད་ཀ་རོང་གི་ས་ཆར་ཞི་དེའུ་ཟེར་བ་དེར་སྡོན་ཤེལ་གྱི་འོད་དེ་གུང་རྒྱལ་ལམ་སྐལ་ལྡན་འོད་རྒྱལ་ཞེས་བྱ་བའི་གྲུབ་ཐོབ་རྫུ་འཕྲུལ་ཅན་ཞིག་བྱོན།",
    "སྐྱ་རྒན་གནས་མོའི་སྒྲུབ་གནས་ཀྱི་བྲག་ཕུག་ཏུ་སྤྱིར་ཡིག་འབྲུ་རང་བྱོན་མང་བོ་དང་།",
    "ཁྱད་པར་བྲག་གི་རྩེ་ལ་ཨོཾ་ཧཱུཾ་ཏྲཾ་ཧཱིཨཱཞེས་པའི་རིགས་ལྔའི་ས་བོན་སོགས་ཡ་མཚན་པ་རང་བྱོན་དུ་བབས་པ་མང་བོ་བཞུགས་སོ།",
    "གོང་མོའི་གུར་ཁང་བྲག་རྩ་ན།",
    "ཅེས་གསུངས་པ་ནི་སྔོན་དྲན་པ་ནམ་མཁའ་ཞེས་བྱ་བ་ཞིག་གོང་མོའི་གུར་ཁང་གི་བྲག་ཕུག་ཏུ་བཞུགས་ནས་སྒོམ་སྒྲུབ་མཛད་པས་རྟོགས་པ་མངོན་དུ་གྱུར།",
    "སྒྲུབ་གནས་ལ་དུས་རྒྱུན་པར་ཉིན་མོ་མི་དང་།",
    "འཕྱག་རྟེན་ཤིང་གི་འཁར་བ་སྐམ་པོ་གཉིས་སར་བཙུགས་པ་སྐྱེས་ནས་རྗེས་སོར་ཆུ་ཆ་ལྷ་ཤིང་དུ་གྲགས་པའི་ཐང་སྡོང་ཆེན་པོ་དེ་དང་།",
    "གསེར་ཀླུའི་ཆུ་མིག་གི་མགོར་མ་གལ་གྱི་སྡོང་བོ་ཆེན་པོ་ཞིག་རྒྱས་ཡོད་པ་དེ་གཉིས་ཡིན་པར་གྲགས་སོ།",
    "གནས་བརྟན་བཅུ་དྲུག་གི་ཞལ་གཟིགས་སོ།",
    "ཡང་གནའ་དུས་སུ་བྱུང་བ་ཡ་རོང་བུ་མོ་ལྷ་རིས་སུ་གྲགས་པའི་རྣལ་འབྱོར་མ་ཞིག་བྱོན་པ་ཡིན་ཏེ།",
    "གང་ལྟར་ཡང་ཕྱུག་པོ་འབྱོར་ལྡན་ཞིག་གི་བུ་མོ་ཡིན་པས།",
    "དེ་ནས་ཀྱང་ར་དཀར་མོ་ཞིག་གི་འོ་མ་ཙམ་ལ་འཚོ་བ་མཛད་ནས་སྒོམ་སྒྲུབ་རྒྱུ་ཆེར་གནང་བ་ཞིག་ཡིན་ནོ།",
    "ཕྱིས་སུ་ར་དཀར་མོ་དེ་ཉིད་ཤི་བའི་རུས་པའི་སྟེང་དུ་ཡང་ཡིག་འབྲུ་རང་བྱོན་མང་བོ་ཡོད་པར་གྲགས་ལ།",
    "དེ་ལ་ར་མ་དཀར་མོའི་མཆོད་རྟེན་ཞེས་ཟེར་རོ།",
    "སྐབས་དེར་རྒྱལ་བསྟན་གངས་ཀྱི་ལྷུན་པོ་སྐྱོང་བའི་མངའ་བདག་ཏུ་ཁོང་ཚོ་གཙོ་ཆེ་བས་ན་འདི་ཙམ་བརྗོད་པ་ཡིན་ལ།",
    "བསྡོ་སྨོན་རྣམ་དག་གིས་མཇུག་ཏུ་རྒྱས་འདེབས་པའི།",
    "ལུས་དང་ལང་ཚོ་ངང་ཚུལ་ཕུན་སུམ་ཚོགས་པའི་བུད་མེད་དམ་པ་གཅིག་གི་རྣམ་པར་བྱུང་བར་གྲགས་སོ།",
    "རེ་ཞིག་བུད་མེད་དེ་ལས་ཁྱེའུ་རབ་ཏུ་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་ཀུན་གྱི་ཡིད་འཕྲོག་པ་ཞིག་བཙས་པར་གྱུར་ཏོ།",
    "དཔལན་གཅིག་མནལ་ལམ་དུ་བན་ཆུང་རུས་པའི་རྒྱན་ཅན་དབུ་ལ་ཤ་བའི་མཉེན་ཞུ་གསོལ་བ་ཞིག་གིས་ཕྱག་གཡས་པས་རྡོ་རྗེ་གསོར་བ་དང་གཡོན་པས་ཐོད་པའི་ནང་གི་བདུད་རྩི་གཏོར་ཞིང་གྲུ་མོ་ནས་ཁ་ཊཾ་ག་ཚུར་བསྟན་ནས་འདི་སྐད་དུ།",
    "ཁྱོད་ཀྱི་བསྟན་པ་ལ་ཕན་ཐོགས་ཆེན་པོ་འབྱུང་ཞིང་།",
    "ཁོང་རྣམས་སྟག་ཚང་ལྷ་མོ་ཞེས་བྱ་བའི་གནས་དེར་ཕེབས་ཏེ་དགྲ་རྣམས་ཆམ་ལ་འབེབ་པའི་མཐུ་སྒྲུབ་མཛད།",
    "ཟླ་གཅིག་ཙམ་ཡང་མ་སོང་བར་ཨར་ཇག་དེ་དག་གི་ཡུལ་ཕྱོགས་སུ་སེར་བ་ཆེན་པོ་འཇིགས་སུ་རུང་བ་དང་།",
    "དེ་ནས་རིམ་གྱིས་བྱོན་པའི་ལམ་ནས་ཚོ་བཞིའི་གུ་རུ་སྐྱབས་ཕ་བོང་ཆེན་པོ་ཞིག་གི་སྟེང་དུ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་ནས་ཕྱག་གིས་ཕ་བོང་ལ་བསྣུན་པས་རི་ཀླུང་ཀུན་ཏུ་བརྒྱུགས།",
    "ཙོང་ཁའི་རྡོར་བཟང་གིས་གསེར་གྱི་རྡོ་རྗེ་རྩེ་དགུ་བ་ཞིག་བསོར་ནས་ནམ་མཁར་འཕངས་པ་ནམ་མཁའི་དཀྱིལ་དུ་གཡོ་འགུལ་མེད་པར་ཞག་གསུམ་གྱི་བར་དུ་བསྡད།",
    "ཡུལ་སྐྱོང་དཔལ་བཟང་གིས་ཤ་རཱ་མ་ཉམས་པ་ཞིག་ལ་ཞོན་ནས་རྭ་ས་ལ་མ་རེག་པར་རྟ་བཞིན་དུ་བརྒྱུགས་ཤིང་།",
    "ནངས་མོར་ཁྱེད་རྣམས་འདི་ནས་ཐག་ཉེ་སར་སྡོད་དང་།",
    "རལ་བ་དཀར་བོ་ཐོར་ཚུགས་སུ་བཅིངས་པའི་མདུད་པའི་གསེབ་ན་མི་རྐང་གི་གླིང་བུ་འཕྲེད་དུ་གཟེད་པ།",
    "དེ་ལ་ཁྱོད་ཡུལ་གང་གི་མི་ཡིན།",
    "རྒྱ་མི་དེ་ན་རེ།",
    "སུ་ཡིན་དང་ཡུལ་གང་གི་མི་ཡིན་པ་ཁྱེད་ལ་དགོས་པ་མེད།",
    "ཁོ་ན་རེ།",
    "ད་འདི་ནས་སྒར་ཞིག་འདེབས་དགོས་རྒྱུ་ལ་ས་ཁོད་སྙོམས་པ་ཞིག་གང་ན་གདའ་དགོངས་ནས་ཕྱོགས་གཟིགས་མཛད་པ་ན།",
    "ཡང་སྔར་གྱི་བྱ་རོག་གསུམ་པོ་བྲག་གི་གཡས་ཕྱོགས་ཀྱི་ངོས་སུ་སྤང་ལེབ་བདེ་མོ་ཉམས་དགའ་བ་ཞིག་འདུག་པ་དེར་བབས་ནས་འཕྲལ་དུ་འཇའ་ཡལ་བ་བཞིན་མི་སྣང་བར་གྱུར་ཏོ།",
    "འདི་ནས་གཡས་ཕྱོགས་སུ་ཆུ་མིག་མང་བོ་ཡོད་པ་དེའི་ཁར་སོང་ལ་འཇམ་དབྱངས་ནཱ་ག་རཀྟ་དང་ཁྱུང་གི་སྒྲུབ་སྐོར་གྱི་པོ་ཏི་མང་བོ་གཏེར་དུ་སྦོས།",
    "ཕྱི་ཉིན་ཆུ་མིག་གི་རྩར་ཕེབས་ཏེ་ལུང་བསྟན་བཞིན་དུ་པོ་ཏི་མང་བོ་གཏེར་དུ་འཇུག་པར་མཛད་པ་སོགས་བྱས་ཏེ་སླར་ཕེབས་པའི་ནུབ་མོ་དཔལ་ཆེན་རྟ་མགྲིན་གྱི་ཞལ་དངོས་སུ་གཟིགས་ཏེ་གསུང་ལས།",
    "ཁྱོད་ཀྱིས་བསྟན་འགྲོའི་དོན་ལ་གང་ཕན་གྱིས་གསུངས་ནས་གདམས།",
    "དེ་རྣམས་ལས་མཆེད་པ་ལ་དེང་སང་ཚོ་བཞི་ཞེས་གྲགས་ལ།",
    "སྔགས་བརྒྱུད་ལ་སྨད་རྒྱུད་སྔགས་རམས་པ་ཚོ་བཞི་ཨ་ཁུ་ཚང་ཞུ་བ་དགུང་ལོ་བརྒྱ་ལྷག་རིང་བཞུགས།",
    "ངེས་དོན་ཟབ་མོའི་བདུད་རྩིས་ཆེར་མྱོས་པས།",
    "གླིང་བཞིའི་དཔལ་ལ་སྲེད་པ་མིན་མོད་ཀྱང་།",
    "ཉིན་མཚན་རེས་ཀྱིས་བསྐྱོད་ལ་མི་ངལ་ཞིང་།",
    "སྔོན་གྱི་སྐྱེས་ཆེན་དམ་པ་མང་བོས་རེ་སྐོང་འདིར་བསྟན་པ་སྔ་དར་དང་བར་དར་ཕྱི་དར་གསུམ་གྱི་ཐ་སྙད་མཛད་པ་ཡིན་ལ།",
    "རྒྱ་བོད་ཀྱི་ལས་ལུང་གིས་མཐོ་བ་ཟམ་མ་ཆད་པར་ཕེབས་པའི་རིགས་ཞེས་བསྔགས་བརྗོད་ཡང་ཡང་གནང་བ་དོན་དང་བཅས་པ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་ཡངས་མོར་བྱེད་དང་འདི་མི་མཚུངས།",
    "མོང་གོལ་ཧན་གྱིས་བོད་དུ་དམག་བཏང་ཞིང་སེ་ཆེན་ཧན་ནས་གུས་སྲོལ་གྱིས་ཀརྨ་པཀྴི་དང་།",
    "དེ་ལེགས་མོད་ཀྱང་།",
    "ལྕམ་སྲིང་གིས་དྲང་དོན་དུ་འཇིག་རྟེན་པའི་ཚུལ་བཟུང་ཡོད་སྟབས་འཁུ་ལྡོག་ཆེ་བས་མཆོད་བཀུར་སོགས་དཀའ་བས་གཞན་ཞིག་མཁྱེན་ཞུས་པར།",
    "འོ་ན་མ་ཅིག་དཔལ་ལྡན་ལྷ་མོ་སྟེར་གསུངས་པར།",
    "དེ་ཡང་ལེགས་ན་ཡང་མཐུ་ནུས་མེད་པར་གནོད་བྱེད་ཀྱི་དགྲ་ལ་རྦད་ན་ཚུར་ལྡོག་གི་ཉེན་ཡོད་པས་དེ་ལས་གཞན་ཞིག་མཁྱེན་མཁྱེན་ཞུས་པར།",
    "འོ་ན་ཁྱེད་རང་གིས་འདེམས་ཤིག་གསུངས།",
    "གསུང་གི་རྟེན་ལ་མན་ངག་གི་བེའུ་བུམ།",
    "མི་ཁྱོད་ཀྱི་རྒྱུད་པས་བསྟན་པ་སྤེལ།",
    "རེ་སྐོང་སྟོད་ཀྱི་ས་ཆ་ལུང་བཟང་ནས་ཇག་པ་འགའ་ཞིག་གིས་གཙེས་པ་ན།",
    "གདོང་རིང་སྣ་འཁར་གོང་གདོང་གཞུག་གི་སྣར་ངོས་བཟུང་སྟེ་གསེར་ལྗོངས་རྒྱལ་ཐང་དང་ཧོར་སྙན་བཟང་གཉིས་སུ་གཞི་ཕབ།",
    "གཅན་ཚ་ཁྲི་ཀའི་བུ་མོ་ཞིག་བཙུན་མོར་བསུས་ཏེ་ཁྱིམ་བཟུང་།",
    "དེ་ཆེར་ལོན་པ་ན་ཡབ་ཉིད་ཀྱིས་སྲས་ཁྲིད་དེ་ལ་རིང་སྐེད་དུ་སོང་ནས་རྗེས་སུ་ངའི་སྤུར་འདིར་ཞོག་དང་།",
    "དེ་ཉིད་ཀྱིས་ཁྱོད་ལ་ས་འདི་ལས་ལྷག་པ་ཞིག་རྙེད་དཀའ་ཡང་ངེད་ལ་ཤིན་ཏུ་འཚུབ་པས་གོམ་པ་རེ་ལ་གསེར་ཞོ་དོ་རེ་དགོས་པ་ཡིན་ཟེར་བ་ལྟར་འདོད་པ་བསྒྲུབས་ཏེ་བལྟ་རུ་བཅུག་པར།",
    "ས་དེར་ད་ལྟའི་བར་ལ་རྒྱུན་མ་ཆད་པར་རོང་བོ་ཚང་གིས་ལོ་རེ་བཞིན་གཏེར་འབུལ་གྱི་སྲོལ་རྒྱུན་ཚུགས་ཡོད་པ་རེད།",
    "དེ་ནས་འཁོན་ཤེས་རབ་ཡོན་ཏན་གྱི་རིགས་སུ་འཁོན་བསྟན་པ་ནམ་མཁར་སྲས་སྲས་མོ་བདུན་བྱུང་བའི་ཆེ་བ་ནི་ཀུན་དགའ་དོན་གྲུབ་ཡིན།",
    "དགུང་ལོ་བཅོ་བརྒྱད་སྟེང་གཙང་རུ་ལེགས་སུ་བལ་བོ་ནས་ཕེབས་པའི་བལ་བོ་འཇིགས་མེད་ཐུབ་བསྟན་ཟེར་བའི་བུ་མོ་བལ་བཟའ་ཀླུ་མོ་ཚེ་རིང་ཟེར་བ་ཁབ་ཏུ་བཞེས་པར་དགུང་ལོ་བཅུ་དགུའི་སྟེང་སྐྱེས་པ་ལྷ་རྒྱལ་དཔལ་ཏེ་སྲས་ཆེ་བ།",
    "དེ་ནས་ལྷོ་ཕྱོགས་སུ་བསྐོར་ནས་རྨ་ཆུའི་རབ་ཁ་ལ་འབྱོར་དུས་གྲུ་གཟིངས་དང་གྲུ་བ་གང་ཡང་མེད་པར་བཙུན་མོས་ལྷ་ལ་གསོལ་བ་བཏབ་པ་ལྟར་སེར་མོ་ཉེར་དྲུག་གིས་མི་རེས་གླུ་རེ་ཁྱེར་ཡོང་ནས་ཁྱེད་རྣམས་ཆུའི་ཕ་ཁར་ངེད་རྣམས་ཀྱིས་བསྐྱལ་ཆོག་ཟེར་ནས་ཕ་ཁར་ཕྱིན་པ་ན།",
    "དེ་ནས་ལྷོ་ཕྱོགས་སུ་འཁོར་ཏེ་རྫ་མཐོན་པོ་ཞིག་གི་རྩེ་ལ་གཟིགས་ནས།",
    "མངའ་རིས་དཔག་བསམ་ཤིང་གི་ར་བ་ནས།",
    "ཁྱོད་ཀྱི་བསྟན་པའི་བདག་པོ་ང་ཡིས་བྱེད།",
    "སྒོ་མོའི་རྫ་རིའི་སྟེང་དུ་གནས་པ་ཡིན།",
    "ཟེར་ནས་འཕུར་སོང་ངོ།",
    "དེ་ནས་གངས་ཅན་ཁའི་ཁར་ཕེབས་ནས་རྡོ་དཀར་ནག་གིས་འཕྲ་བཏབ་སྟེ་བརྩིགས་པའི་བསང་ཁྲིའི་ཤུལ་དུ་ད་ལྟ་བསང་ཁྲི་ཁྲ་སྡང་ཟེར་སྲོལ་ཡོད།",
    "སྒོ་མོའི་རྫ་རི་མཐོན་པོ་སེ་ཀུ་བྱ་ཁྱུང་གི་བྱང་ཕྱོགས་ན་རི་མཐོན་པོ་སྤུན་གསུམ་མཉམ་དུ་ལངས་འདྲ་ཡོད་པ་ལ་གཟིགས་ནས།",
    "ཤར་ན་གཉན་རྡོ་དམར་བོ་སྟག་མོ་གཟན་ལ་རྔམ་འདྲ།",
    "ལྷོ་ན་གཡུ་འབྲུག་སྔོན་མོ་སྤྲིན་གྱིས་བསྐོར་འདྲ།",
    "ནུབ་ན་བྱ་རྒྱལ་ཁྱུང་ཆེན་ཚང་ལ་བབས་འདྲ་ཞིག་མཐོང་ནས་ས་དེར་སོང་སྟེ་ཟླ་ཕྱེད་ཙམ་བསྡད་པའི་ཡང་ནུབ་ཅིག་རྨི་ལམ་དུ།",
    "སོ་རྒྱུ་སྟག་གི་མཆེ་བ་གཙིགས་འདྲ་ཞིག་འོངས་ནས།",
    "ང་ནི་ཁྱེད་ཀྱི་ཁུ་བོ་ཡིན་ལ་ཁྱོད་འདི་ནས་རི་བོ་ཆེ་ཡི་མདུན་དུ་སོང་དང་སང་སྔ་མོ་ས་པཎ་གྱིས་གསུངས་པ་ལྟར་གྱིས་ཟེར་ནས་ཧབ་དགོད་ཆེན་པོ་ཞིག་བྱས་པ་དང་མཉམ་དུ་སད་དེ་ཡར་ལངས་པ་ན་གནམ་ན་འཇའ་ཚོན་སྔར་མཐོང་མ་མྱོང་བ་སྣ་ཚོགས་དང་།",
    "ལཚུར་ཤ་བ་ཆེན་པོ་སྦྲུལ་དཀར་ནག་གིས་དཀྲིས་པ་མགོ་ན་རྭ་ཡལ་ག་བཅོ་བརྒྱད་ཡོད་པ་ཞིག་གིས་ཁ་ནས་ངར་སྐད་སྒྲོག་བཞིན་འོངས་པ་ལ།་",
    "ཐ་ཆུང་གིས་རྭ་ནས་བཟུང་བ་ལ་དཔགས་ནས།",
    "མི་སུམ་ཅུ་ཙམ་རེ་ལ་རུ་སྒར་གཅིག་རེ་བྱས་ཏེ་ས་རུ་སྒར་བཅུ་གཅིག་ཏུ་གྱེས།",
    "སྔར་གྱི་གཏེར་བུམ་སོ་སོ་དང་གཡང་མདའ་བདུན་པོ་ཐམས་ཅད་རེ་སྐོང་གི་ཆར་བཅུད་དང་གཡང་གི་རྟེན་དུ་སྦས།",
    "སྲས་འབྲིང་བོ་ལ་གཅན་ཚའི་རིགས་སུ་སྐྱེས་པའི་བུ་མོ་ཞིག་ཆུང་མར་བླངས་པ་ལ་རིགས་རྒྱུད་མ་བྱུང་།",
    "གདུང་རུས་རེ་སྐོང་གི་བྱང་སྐྱོར་མཆོད་རྟེན་དུ་བཞུགས་སོ།",
    "འདུ་ཁང་ཆེན་མོ་སྟེང་འོག་ཅན་རྟེན་བརྟེན་པ་བཞེངས།",
    "དེ་ནས་མི་རབས་དག་གི་མཛད་རྣམ་གཙོ་བོ་ནི།",
    "ཡོངས་འཛིན་མཆོག་གི་ཟློས་གར་བསྒྱུར།",
    "ཧིདཀར་ཐུགས་རྗེ་ལང་ཚོ་ཞུ་བའི་ཁམས།",
    "སྐལ་ལྡན་མིག་གི་བདུད་རྩིར་ལྷང་ངེ་བ།",
    "གུར་ཀུམ་གར་གྱིས་མཛེས་ཁྱོད་མ་ལ་ཡར།",
    "རབ་བྱུང་བཅུ་བའི་ཆུ་ཁྱི་ལ་ཏཱ་ཆིང་གོང་མ་ཐེན་ཆི་ཁྲི་ལོ་གཉིས་པའི་སྟེང་བཀའ་ཡིག་གི་བྱང་བུ་བྱིན།",
    "ཁྱད་པར་ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤ་བོད་དུ་ཕེབས་དུས་ས་སྐྱའི་རིའི་ངོས་ལ་འབྲོང་གཉིས་འདུག་པ་གཟིགས་ནས།",
    "ཁོང་ནི་སྒྲུབ་པ་ཉམས་བཞེས་ཤ་སྟག་གནང་བས་འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་ཞལ་མངོན་སུམ་དུ་མཇལ་བ་སོགས་གྲུབ་པའི་གོ་འཕང་མཐོན་པོར་ཕེབས་པ་ཞིག་ཡིན།",
    "དེའི་དོན་དུ་ཁྱོད་ལ་ཧུང་ཟེའུ་དམེའུ་དབུ་ཀོ་ཤྲཱིའི་ལས་ཀ་བྱིན་པ་ཡིན།",
    "ལུང་ལས་འདི་དག་ཕྱིས་སུ་སྐྱེབས་མགོན་སྐུ་ཕྲེང་ཕྱི་མ་རྣམས་ཀྱིས་བདག་གིར་བཞེས་བཞིན་ཡོད་དོ།",
    "མགོན་པོ་རྭ་སྐྱེས་སུ་གྲགས་པའི་ལྷ་ཁང་རྣམས་རྟེན་བརྟེན་པ་བཞེངས་པ་རྣམས་ལ་ཡང་གོང་མས་ཕུལ་བའི་ཡིག་བྱང་ཡོད་པ་རེད།",
    "རང་གི་གཟིམ་ཁང་དང་གྲྭ་ཁང་རྣམས་ཀྱང་གསར་འབུབས་མང་།",
    "མེ་ཏོག་གི་ཆར་བབས།",
    "དུང་དང་རོལ་མོ་སོགས་ཀྱི་སྒྲ་གྲགས།",
    "རེ་སྐོང་སྟོད་སྨད་བར་གསུམ་གྱི་དུད་གྲངས་དང་མི་གྲངས་བླངས་ནས་ཁྱིམ་གཅིག་ལ་བྱིས་པ་ཕོ་གསུམ་ཡོད་ན་གཅིག་གྲྭ་བ་བྱེད་རྒྱུའི་བཀའ་ཤོག་སྤེལ་ཏེ་བཙུན་ཁྲལ་བསྡུས།",
    "བྱང་སྟོད་ཇོའུ་ལོ་ཧོར་མོ་ཁ་གསུམ་ནས་བྱང་སྨད་རྨ་ཆུའི་འཁྱིལ་ཕྱོགས་ཚུན་ཆད་བཀའ་གསུང་རྡོ་རྗེའི་ར་བ་གཅིག་ལ་བསྡམས་པ་ཡིན་ཏེ་ཅུང་ཟད་ད་དུང་འཆད་པར་འགྱུར་རོ།",
    "ས་འདི་བསིལ་ལྡན་ཞིང་གི་རྒྱན་དུ་བསྒྲུབས།",
    "ནང་སོ་དཔལ་ལྡན་གུ་རུ་གཙོ་བྱས་པའི་འདུ་ཁང་གི་ནང་།",
    "ལོ་གཅིག་གི་རིང་ལ་འདི་འདྲའི་བྱ་བ་རྒྱ་ཆེན་པོ་ཇི་ལྟར་གྲུབ་པའི་ཚུལ་ལ་དཔག་ན་རིག་པའི་གནས་ལ་མཁས་པའི་སྐྱེ་བོ་གང་འདྲ་ཙམ་ཡོད་པ་ཡང་ཤེས་ནུས་སོ།",
    "རོང་བོའི་སྐུ་མདུན་པ་ཞེས་གྲགས་པས་ན་རོང་བོའི་མཁས་གྲུབ་ལས་ལུང་གིས་མཐོ་བ་ཞིག་གི་སྐུ་མདུན་དུ་བཞུགས་པ་ཡིན་པར་ངེས་ལ།",
    "དེ་རིཊ་རྙོག་བྲལ་གངྒཱའི་ལྷ་མོ་ནི།",
    "མགར་རྩེའི་བླ་རབས་མང་བོ་སོང་ཞིང་།",
    "ང་རོང་ཕ་ད་རུ་སྐྱེས་ན་ཕན་ཐོགས་ཆེ་རྒྱུ་རེད་ཨང་ཞེས་གསུངས་པ་སོགས་ལ་དཔཊ་ན་འདི་ལྟར།",
    "རབ་བྱུང་བཅུ་བའི་ཤིང་སྦྲུལ་ལ་འདུ་ཁང་ཆེན་མོའི་གཞི་བཏིངས།",
    "ཤ་སྦྲང་གི་ཉེ་འཁོར་གྱི་ཉིན་ཕྱོགས་རི་ཁྲོད་ཅིག་ཏུ་སྒྲུབ་པ་མཛད་ནས་བཞུགས་ཞེས་བྱ་ཁྱུང་གདན་རབས་སུ་གནང་འདུག་པ་གསུམ་ཡང་དག་པའི་ཁུངས་སུ་ལེགས་ན་ཐེ་ཚོམ་མེད་པར་སེམས།",
    "རང་ཉིད་བྱ་ཁྱུང་གི་གནས་བཙལ་བར་བྱོན།",
    "དེ་ལ་ངག་རྒྱུན་དུ་ཐོག་མར་ཤ་སྦྲང་ལ་ཕེབས་པར་རྒད་པོ་ཞིག་གིས་གུང་ཚིགས་ལ་ཤ་བྲང་ཞིག་ཕུལ་བ་ན།",
    "ཁོང་གི་ཞལ་ནས།",
    "ཕ་རི་ཚུ་རིའི་མིང་ལ་ཅི་ཟེར་དྲིས་པའི་ལན་དུ།",
    "ཕ་གི་ལ་རི་ངོ་སྡིག་དང་ཚུ་རི་ལ་སྣ་ཕུག་ཟེར་ཞུས་པ་ལ།",
    "ཤ་བྲང་གིས་གུང་ཚིགས་མི་ཉན།",
    "དགོན་ལག་གཞན་དག་གི་མཚན་གླེང་ཙམ་སོགས་རིམ་བཞིན་འགོད་པར།",
    "གདན་ས་གསུམ་གྱི་རྟེན་འདུ་ཁང་དང་ལྷ་ཁང་གི་ངོ་སྤྲོད་གླེང་ཙམ་དང་།",
    "སྔོན་བྱུང་གི་ངོ་སྤྲོད།",
    "འདིར་ནི་གཞན་དག་ལྟར་གང་འགྲིག་བཙན་སྦྱོར་ལྟ་བུ་མ་ཡིན་པར་ཐུན་མོང་དུ་ངེས་ཤེས་འདྲེན་སླ་བ་གཙོ་བྱས་ཏེ་ཅུང་ཟད་འགོད་པ་ལ།",
    "སྟག་ཁྲ་བོ་གྲ་འཛུམ་གྱིས་པའི་ཟུར་ཞེས་དགོན་ཆེན་གྱི་མདུན་ཕྱོགས་ཤར་ན་སྟག་མོ་གནམ་དུ་འཕྱོངས་འདྲར་འདུག་པ་དང་།",
    "ལྷོའི་གཡུ་འབྲུག་སྔོན་མོ་ཞེས་པ་དབྱངས་ཅན་འཛུམ་པའི་རོལ་མོ་ལས།",
    "ཅེས་པ་ལྟར་ལྷོ་ཆབ་དགུ་ཆུ་སྔོན་མོ་གཡུ་འབྲུག་དགུང་ནས་འཁྱུག་པའི་འགྲོས་ལྟར་ལྷོ་ནས་མདུན་བརྒྱུད་དེ་བྱང་དུ་འབབ་པ་དང་།",
    "བྱང་གི་རུས་སྦལ་སེར་བོ་ཆུ་མའི་སྟེང་སེར་ལ་མ་སྦྱར་རང་འགྲིག་གིས་སོང་བའི་ཕྱོགས་བཞིའི་ས་དཔྱད་ཀྱི་མཚན་ཉིད་ཡང་དག་པར་ཚང་ངོ།",
    "ཉམས་ལྡན་རེག་བྱའི་ལྷ་མོ་འགྱིང་བ་བཞིན།",
    "ཞེས་པ་ལྟར་རྒྱབ་རི་མཐོན་པོ་བཅུ་གསུམ་གྱི་གཙོ་བོ་ལྷ་གཉན་བྱ་ཁྱུང་གི་ལྷུན་པོ་བསྟན་ལ།",
    "མི་ཁྱོད་ཀྱི་བསྟན་པ་ལེགས་པར་བྱེད།",
    "མི་ཁྱོད་ལ་འདུད་ཅིང་གུས་པར་བཞུགས།",
    "ཞལ་བཟང་མངོན་དགར་བལྟ་བའི་གཟིགས་ལམ་དུ།",
    "ཨེ་མ་གངས་ཅན་མཐིལ་ན་ཞིང་མང་གི།"
  ]
}