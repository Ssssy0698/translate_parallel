    "ལུས་འདི་ལ་གཙང་མ་དང་ཡིད་འོང་གི་དངོས་པོ་ཡོད་པར་སེམས་ན།",
    "ཐོག་མར་ལུས་ཀྱི་ཕྱིའི་པགས་པ་རིམ་པ་བདུན་ཡོད་པར་གསུངས་པའི་རིམ་པ་འདི་དག་ཐམས་ཅད་རང་གི་བློའམ་སེམས་ཀྱིས་རེ་རེ་བཞིན་དུ་སོ་སོ་ཐ་དད་དུ་ཕྱེ་ནས་བལྟས་ན་གཙང་མ་དང་ཡིད་འོང་།",
    "ཡང་གཙང་མ་དང་ཡིད་འོང་གི་དངོས་པོ་རིན་ཐང་ཅན་དེ་འདྲ་ཡོད་མེད་བརྟག་དཔྱད་བྱ་ཞིང་།",
    "རྐང་གི་བར་དུ་བལྟ་བྱ་ཞིང་།",
    "ཞེས་པ་ཡང་རུས་པའི་དུམ་བུ་དེ་རྣམས་ཀྱང་སོ་སོར་ཚིགས་རྣམས་དབྱེ་བ་བྱས་ནས་ནང་གི་རྐང་ལ་ཐུག་གི་བར་དུ་བློ་ཤེས་རབ་ཀྱིས་གཙང་མ་དང་ཡིད་འོང་དང་རིང་ཐང་ཅན་ལྟ་བུ་ཡོད་མེད་བརྟག་ཅིང་དཔྱད་པར་བྱ་ཞིང་།",
    "ཁྱོད་ནི་ལུས་འདི་སྲུང་བར་བྱེད།",
    "ཁྱོད་ཀྱིས་མི་གཙང་བཟར་མི་རུང་།",
    "ལུས་ཀྱིས་ཁྱོད་ལ་ཅི་ཞིག་བྱ།",
    "ལུས་མི་གཙང་དེ་ཉིད་ཀྱིས་བདག་འཛིན་ཅན་གྱི་སེམས་ཁྱོད་ལ་མགུ་བའི་དོན་ཅིས་བསྒྲུབ་པར་བྱ་སྟེ་ཅི་ཡང་བྱར་མི་རུང་།",
    "ཉིས་ན་སྟེ་གཉིས་སུ་ན་གཙང་བཙོག་གང་ཡང་མེད་པའི་ཝ་དང་བྱ་རྒོད་ཀྱི་ཟས་ཀྱི་དོན་དུ་ལུས་འདི་ད་ལྟ་ཁྱོད་ཀྱིས་བསྲུང་བ་ཡིན་ན།",
    "དེ་ཡང་ཤི་ཟིན་པའི་གནས་སྐབས་ན་ཝ་དང་བྱ་རྒོད་ལ་སོགས་པ་དེ་རྒྱགས་འགྲོ་གི་རེད།",
    "དེའི་ཕྱིར་ན་ངའི་ལུས་འདི་ད་ལྟ་བསྲུང་གི་ཡིན་སྙམ་དུ་སེམས་ན།",
    "དེ་ཁྱོད་རང་འོས་སོ་ཞེས་པའི་དོན་ལྟ་བུ་ཐུགས་མ་རངས་པའི་ཚིག་གོ།",
    "མིའོ་ཅོག་གི་ལུས་འདི་ནི།",
    "འདི་ལྟར་ཁྱོད་ཀྱིས་བསྲུངས་ཀྱང་ནི།",
    "དེ་ཚེ་ཁྱོད་ཀྱིས་ཅི་བྱར་ཡོད།",
    "བྱ་དང་ཁྱི་དང་ཝ་དང་ལྕེ་སྤྱང་ལ་སོགས་པ་དེ་དག་གི་ཁར་ཟས་སུ་བྱིན་པ་ཡིན་ན།",
    "དུས་དེའི་ཚེ་ན་སེམས་ཁྱོད་ཀྱིས་ཅི་ཞིག་བྱར་འོས་ཏེ་ཅི་ཡང་བྱར་མེད་དོ།",
    "ཁྱོད་ཀོ་ཅི་སྟེ་ཤ་ཐང་གསོ།",
    "འཇིག་རྟེན་བྲན་གཡོག་སྟེ་ལས་མི་ལས་སུ་བཀོལ་དུ་མི་བཏུབ་པའམ་ལས་ཀ་ཡག་པོ་མ་བྱས་པ་དེ་འདྲ་ཡིན་པ་ལའང་སྦྱིན་བདག་གིས་གོ་ལ་སོགས་པ་སྟེ་ཟས་དང་གླ་རྔན་ལ་སོགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་མི་སྦྱིན་པ་ཡིན་ན།",
    "ད་ལྟ་བདག་འཛིན་ཅན་གྱི་སེམས་ཁྱོད་ཀོ་སྟེ་ཁྱོད་ཀྱིས་ནི་ཅི་སྟེ་ན་ཤ་ཐང་སྟེ་ཤ་ཟད་ཟད་ཁྲག་སྐམ་སྐམ་གྱི་བར་དུ་དཀའ་ལས་ངལ་དུབ་ཀྱི་སྒོ་ནས་ལུས་འདི་གསོ་སྟེ་དེ་ཙམ་གསོ་མི་འོས་ཞེས་པའི་དོན་ནོ།",
    "ད་ནི་རང་གི་དོན་བྱེད་ཆུག།",
    "འགྲོ་བའི་བཤེས་དང་གསོང་པོར་གྱིས།",
    "གཡོ་དང་སྒྱུ་མེད་པར་གསོང་པོར་ཏེ་སེམས་ཁོག་དྲང་པོར་གྱིས་ཞེས་པའོ།",
    "དེ་དག་ཐམས་ཅད་ལ་ཕྲག་དོག་མེད་པའི་སྒོ་ནས་རྗེས་སུ་ཡི་རང་གི་བསམ་བློས་ཁྱོད་ཀྱིས་ལེགས་པར་གསུངས་སོ།",
    "རང་གི་ཡོན་ཏན་བརྗོད་ན་དེ།",
    "ཡང་རང་གི་མཐུན་གྲོགས་སམ་དགྲ་བོ་ལ་སོགས་པ་ཡུལ་གང་དང་གང་གི་ཡོན་ཏན་དེ་ཉིད་གང་ཟག་གཞན་གྱིས་བརྗོད་དེ་བསྟོད་པ་དང་བསྔགས་པ་སོགས་བྱེད་པ་མཐོང་ན།",
    "རང་གིས་ཀྱང་དེ་དེ་བཞིན་ནོ་ཞེས་དེའི་རྗེས་སུ་ཡི་རང་བའི་ཚུལ་གྱི་སྒོ་ནས་ཡོན་ཏན་བརྗོད་པར་བྱ་དགོས་ལ།",
    "ཡང་རང་གི་ཡོན་ཏན་གང་ཟག་གཞན་འགའ་ཞིག་གིས་བརྗོད་པ་དེ་འདྲ་ཐོས་པ་བྱུང་ན།",
    "རང་དང་གཞན་གྱིས་ལས་བྱ་བ་རྩོམ་པ་བྱས་པ་ཐམས་ཅད་རང་རང་གི་སེམས་དགའ་བའི་ཕྱིར་དུ་ཡིན་པ་སྟེ།",
    "གལ་ཏེ་བསམ་ངན་ཕྲག་དོག་གི་ཉེས་པས་གཞན་གྱི་ཕུན་སུམ་ཚོགས་པའི་ཡོན་ཏན་ལ་མི་དགའ་བས་བལྟས་ན།",
    "དེ་ནས་ཚེ་འདི་ཉིད་ལ་ཡང་རང་གི་སེམས་ལ་ཡིད་མི་བདེ་བའི་སྡུག་བསྔལ་མྱོང་ཞིང་།",
    "ཡང་གཉེན་པོའི་ཁྱད་པར་ལ་སེར་སྣའི་གཉེན་པོ་ལ་རང་གི་གཅེས་ནོར་གཞན་ལ་སྦྱིན་པ་ལྟ་བུ།",
    "ཕན་འདོགས་པའི་ཞིང་དུ་གྱུར་པ་སྟེ་རང་གི་ཕ་དང་མ་ལ་དྲིན་ལན་འཇལ་བ་ལྟ་བུ།",
    "ཡང་སྡུག་བསྔལ་གྱི་ཞིང་དུ་གྱུར་པ་སྟེ་ཐག་རིང་གི་འགྲུལ་པ་ལྟ་བུ།",
    "ལས་རྣམས་བདག་གིས་རྟག་ཏུ་བྱ།",
    "གཙོ་ཆེར་གཞན་གྱི་དོན་བསམ་མོ།",
    "ཐུགས་རྗེ་མངའ་བ་རིང་གཟིགས་པས།",
    "བྲམ་ཟེ་ཁྱེའུ་སྐར་མ་ཞེས་བྱ་བས་ཚོང་དཔོན་གྱི་བུ་མོ་འཆི་བ་ལས་སྐྱོབ་པའི་ཕྱིར་དུ་མི་ཚངས་པར་སྤྱད་དེ་ལོ་བཅུ་གཉིས་ཀྱི་བར་དུ་ཁྱིམ་ཐབ་བསྟེན་པར་མཛད་པ་དེ་དག་གིས་ཀྱང་བསྐལ་པ་མང་པོའི་ཚོགས་རྫོགས་པར་གསུངས་པ་ལྟ་བུ་ཡིན།",
    "ཆ་གཅིག་རང་གིས་བཟའ་བའི་གནས་སྐབས་ན་ཡང་རན་པ་ཙམ་དུ་སྟེ་ཧ་ཅང་བཟའ་ཆེ་ན་ལུས་ལྕི་བར་གྱུར་པ།",
    "བྱུང་ན་ཞོར་དུ་གནོད་སྦྱིན་མོ་འཕྲོག་མ་བུ་ལ་ཆང་བུ་ཡང་སྦྱིན་པར་བྱ་བ་དེ་ཙམ་གནང་བ་སྟེ།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་ལ་ཤོག་བུ་དང་སྣག་ཚ་དང་།",
    "ལུས་ནི་དགྲ་ལྟར་མཐོང་མོད་ཀྱི།",
    "ཡང་ཅི་ནས་ཀྱང་ཚེ་འདི་དང་སྐྱེ་བ་ཕྱི་མ་ལྟ་བུ་གཞན་དུ་ཡང་དོན་ཆེན་པོ་སྒྲུབ་པའི་རྒྱུ་ལྟ་བུ་བྱུང་བ་སྟེ་རང་གི་ལུས་གཏོང་བ་ཡིན་ན་མི་གཞན་གྱི་སྲོག་སྐྱོབ་ནུས་པ་ལྟ་བུ།",
    "སྐྱེས་པ་མེད་པར་བུད་མེད་མིན།",
    "དགོངས་པ་དང་ལྡེམ་དགོངས་ཞེས་བྱ་བ་སོགས་གདུལ་ཞིང་གི་བསམ་པ་ལ་ལྟོས་པའི་སྒོ་ནས་འདྲ་མི་འདྲ་ཡོད་པ་དེ་དག་ཤེས་དགོས།",
    "བུད་མེད་གཞན་དང་གཅིག་མི་བྱ།",
    "ཡང་མལ་སྟན་གཅིག་གི་སྟེང་དང་གནས་ཁང་གཅིག་གི་ནང་དག་ཏུ་རང་གི་ཉེ་དུ་མ་ཡིན་པའི་བུད་མེད་གཞན་དང་ལྷན་ཅིག་ཏུ་བསྡད་པ་སོགས་མི་བྱ།",
    "རང་གིས་འཇིག་རྟེན་གཞན་གྱིས་མ་དད་པའི་ཆ་ཡིན་པ་མ་ཤེས་པའམ་མ་ཐོས་པ་ཡིན་ན།",
    "སོར་མོས་བརྡ་ནི་མི་བྱ་སྟེ།",
    "དངོས་པོ་གཞན་བསྟན་དགོས་པའི་སྐབས་ན་ལག་པའི་སོར་མོ་གཅིག་རྐྱང་པས་བརྡ་སྟོན་པར་མི་བྱ་སྟེ།",
    "ལག་པའི་མཛུབ་མོ་དང་ལག་མགོ་ལྟ་བུ་ཅུང་ཟད་ཅིག་ཡར་བསྐྱོད་ལ།",
    "དེ་ཡང་ཉལ་ཁར་ཤེས་བཞིན་ཏེ་དེ་རིང་གི་ཉིན་མོར་བསླབ་པ་དང་འགལ་བའི་ཉེས་སྤྱོད་བྱུང་ཡོད་ན་བཤགས་སྡོམ་དང་།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "དེའི་ཆེད་དུ་ཉིན་མོར་ལན་གསུམ་དང་།",
    "དེ་ལྟར་ན་བཅུ་ཕྲག་གི་རིག་པའི་གནས་དེ་རྣམས་ལ་མི་བསླབ་པ་དེ་ནི་གང་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཟང་ཟིང་གི་སྒོ་ནས་སྦྱིན་པ་གཏོང་བ་ལ་སོགས་པའི་སྒོ་ནས་ཕན་འདོགས་པར་ནུས་པའམ།",
    "ཡང་ན་རང་གིས་ཐོས་བསམ་སྒོམ་གསུམ།",
    "སྲོག་གི་ཕྱིར་ཡང་མི་བཏང་ངོ།",
    "ཟབ་མོ་སྟོང་པ་ཉིད་རྟོགས་པའི་ལྟ་བ་དང་།",
    "ཁོང་ཁྲོ་གཅིག་གིས་འཇོམས་པར་བྱེད།",
    "རང་གི་ཡིད་དམ་སེམས་དེ་ཉིད་ནི་དུས་དང་རྣམ་པ་ཀུན་རབ་ཏུ་སྡུག་བསྔལ་ཉེ་བར་ཞི་བའི་ཏིང་ངེ་འཛིན་སོགས་ཀྱི་བདེ་བ་དེ་ཉིད་ཉམས་སུ་མི་མྱོང་ཞིང་།",
    "དེར་མ་ཟད་ཐ་ན་མཚན་མོ་གཉིད་ཀྱང་མི་འོང་ཞིང་།",
    "ཞེས་རྗེ་དཔོན་ཞེ་སྡང་ཆེ་ན་བྲན་གཡོག་གིས་ཀྱང་གསོད་པར་འགྱུར་བའི་ཉེན་ཁ་ཡང་ཡོད་པ་སྟེ།",
    "དེ་ཡང་བྲན་གཡོག་ལ་སོགས་པ་འབངས་མི་གང་རང་ལ་ནོར་ཟས་གོས་དང་བཀུར་སྟི་སོགས་ཀྱི་སྒོ་ནས་དྲིན་བྱིན་པའི་རང་གི་རྗེ་དཔོན་ནམ་བདག་པོ་སྦྱིན་བདག་དེ་ཉིད་ལ་བརྟེན་པར་གྱུར་པ་ན།",
    "བྲན་གཡོག་འབངས་མི་དེ་དག་ཀྱང་ནི་ཞེ་སྡང་དང་ལྡན་པར་གྱུར་པའི་རང་གི་རྗེ་དཔོན་ནམ་བདག་པོ་དེ་ལ་གསོད་པའི་བར་དུ་རྒོལ་བར་གྱུར་པ་དེ་འདྲ་ཡོད་པ་དེའང་ཞེ་སྡང་གི་ཉེས་དམིགས་ལ་བརྟེན་ནས་བྱུང་པ་ཡིན་ཞེས་པའོ།",
    "ཞེས་ཁོང་ཁྲོ་དེ་ཡིས་ནི་རང་གི་མཛའ་བཤེས་གཉེན་ཉེ་ཡུལ་མི་གྲོགས་པོ་ལ་སོགས་པ་དེ་རྣམས་ཀྱང་སེམས་མི་དགའ་ཞིང་སྐྱོ་བ་ཉིད་དུ་འགྱུར་ལ།",
    "རང་གི་ཟས་དང་གོས་ལ་སོགས་པ་སྐབས་འཕྲལ་སྦྱིན་པའི་སྒོ་ནས་འཁོར་དུ་ཚུར་བསྡུས་ཀྱང་།",
    "ཞེས་ཁོང་ཁྲོའི་ཉེས་པ་ནི་གཞན་འགའ་ཞིག་གིས་ཐོག་མར་བདག་དང་བདག་གི་གཉེན་ཉེ་སོགས་ལ་རྡུང་རྡེག་སོགས་ཀྱི་སྒོ་ནས་རང་གི་སེམས་ལ་མི་འདོད་པ་བྱས་པ་དང་།",
    "བདག་གི་དགྲ་ལ་བདེ་བ་བྱེད་པ་སོགས་ཀྱི་སྒོ་ནས་རང་གི་སེམས་ལ་མི་འདོད་པ་བྱེད་པ་ལྟ་བུ་དང་།",
    "དེ་བཞིན་དུ་རང་དང་རང་གི་གཉེན་ཉེ་སོགས་ལ་རྙེད་པ་དང་བཀུར་སྟི་སོགས་འདོད་པ་ཡི་གེགས་བྱེད་པ་དང་།",
    "དེ་ལྟས་བདག་གི་དགྲ་བོ་དེའི།",
    "ཅི་ལ་བབ་ཀྱང་བདག་གིས་ནི།",
    "ཞེས་དེས་ན་དགོས་པའམ་གནས་སྐབས་ཅི་ལ་བབ་ཀྱང་བདག་གིས་ནི་ཡིད་མི་བདེ་བའི་གཉེན་པོ་དགའ་བའི་སེམས་སམ་ཡིད་འདི་ཉིད་ནི་ཁོང་ཁྲོའམ་ཞེ་སྡང་གི་སྒོ་ནས་དཀྲུག་པར་མི་བྱ་ལ།",
    "བདག་གམ་བདག་གི་བཤེས་རྣམས་ལ།",
    "བདག་རང་ངམ་བདག་གི་བཤེས་ཏེ་རང་གི་ཉེ་དུ་གྲོགས་པོ་ལྟ་བུ་དེ་རྣམས་ལ་ལུས་ལ་གནོད་པའི་སྡུག་བསྔལ་བསྐྱེད་པ་དང་།",
    "དགྲ་ལ་དེ་ལས་བཟློག་པས་སོ་ཞེས་པ་སྟེ་རང་གི་དགྲ་བོ་ལ་ལུས་ལ་ཕན་པའི་བདེ་བ་ཐོབ་པ་དང་།",
    "ལྐོག་ནས་སྙན་པར་སྨྲ་བ་བྱུང་བ་སྟེ་དེ་རྣམ་པ་བཞི་རང་གི་སེམས་ལ་མི་འདོད་པས་ན།",
    "བདག་དང་བདག་གི་བཤེས་ལ་ལུས་ལ་ཕན་པའི་བདེ་བ་ཐོབ་པ་དང་།",
    "ངོས་ནས་ཚིག་རྩུབ་མོ་སྨྲ་བ་དང་།",
    "ད་དུང་དེ་ལས་ཀྱང་དབྱེ་ན་རེ་རེ་བཞིན་དུ་འདས་པའི་དུས་སུ་ཡང་གནོད་པ་དང་མི་འདོད་པ་དེ་དང་དེ་བྱས་སོ།",
    "བདག་གི་བཤེས་ལ་མི་འདོད་པ་བྱེད་པ་ལ་བཟོད་པ་དང་།",
    "བདེ་བའི་རྒྱུ་ནི་རེ་འགའ་འབྱུང་།",
    "དེ་བས་སེམས་ཁྱོད་བརྟན་པར་མནོས།",
    "བསྟོད་པ་སོགས་དེ་དག་ཐམས་ཅད་ནི་རེ་འགའ་རེ་འགའ་ལས་མ་གཏོགས་མི་འབྱུང་ཞིང་།",
    "སྡུག་བསྔལ་དེ་ཡོད་ན་ངེས་འབྱུང་གི་སྐུལ་མ་ཡིན་པ་དང་།",
    "ལྷ་མོ་ཨུ་མ་ཞེས་བྱ་བ།",
    "འདོད་ཁམས་ལྷ་མོ་ཞེས་པ་དེ་ལ་དད་པའི་ཕྱི་རོལ་མུ་སྟེགས་པ་དེ་རྣམས་ཀྱིས་ཀྱང་དེའི་རྩེ་གསུམ་གྱི་སྟེང་དུ་མཆོངས་ནས་རང་གསོད་པར་བྱེད་པ་དང་།",
    "ཡང་སྦྱིན་སྲེག་གི་མེའི་ནང་དུ་མཆོངས་ནས་རང་ཉིད་ཀྱིས་རང་ཉིད་གསོད་པར་བྱེད་པ་ལྟ་བུ།",
    "ཡང་ཡུལ་ཀརྞ་པ་ཞེས་པ་དེ་ལ་གནས་པའི་མུ་སྟེགས་པ་དེ་རྣམས་ཀྱིས་ལྷ་ཚངས་པ་སོགས་རང་ཉིད་ཀྱིས་ཐོབ་པར་རློམ་སྟེ་ཉི་མ་དང་ཟླ་བ་གཟས་ཟིན་པའི་ཚེ་ན་རང་གི་མགོ་བཅད་པ་དང་།",
    "གོམས་སོང་ན་སླ་བར་མི་འགྱུར་བའི་དངོས་པོ་དེ་གང་ཡང་ཡོད་པ་མ་ཡིན།",
