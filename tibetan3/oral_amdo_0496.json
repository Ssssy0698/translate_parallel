    "ཨ་ཕུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཆར་འབབ་པའི་ཆོ་ག་གསུངས་པ་ཡིན་ཏེ།",
    "དཀྱིལ་འཁོར་པ་རྣམས་ཀྱིས་ཀྱང་རང་རང་གི་ཕྱོགས་སྐྱོང་བ་མནན་པ་བྲིའོ་ཞེས་ཁ་ཅིག་འདོད་དོ།",
    "རྡོ་རྗེ་མ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ལས་གནོད་པ་ལ་སོགས་པའི་ལས་རྣམ་པ་བདུན་ལ་རྡོ་རྗེ་མ་ལ་སོགས་པ་རྣལ་འབྱོར་མ་བདུན་རང་རང་གི་ས་བོན་དང་མཚན་མ་ལས་ལས་དང་རྗེས་སུ་མཐུན་པའི་གཟུགས་དང་ཁ་དོག་དང་།",
    "དང་པོར་རེ་ཕ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེ་ཉིད་ལ་ནི་ཧཱུྃ་གི་གཟུགས།",
    "གཞན་སེར་མོ་ལ་སོགས་པ་ནི་རིགས་བཞིའི་རྣམ་པར་དག་པའི་བདག་ཉིད་ཅན་དུ་ཤེས་པར་བྱའོ།",
    "ཕྱག་དང་ཞལ་དང་སྤྱན་གྱི་དབྱེ་བ་ཡང་མེད་ཅིང་རང་གི་བཙུན་མོ་དང་དཀྱིལ་འཁོར་པ་ཡང་མེད་དོ་ཞེས་ཟེར་རོ།",
    "སེར་མོ་ལ་སོགས་པ་རྣམ་པ་བཞི་ནི་མི་བསྐྱོད་པ་དང་།",
    "མཚམས་རྣམས་སུ་སྦོས་མོ་ལ་སོགས་པ་བཞི་ལ་ཡང་མི་བསྐྱོད་པ་དང་།",
    "མིག་གིས་གཟུགས་ལ་འཛིན་པར་བྱ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་འདིས་ཕྱི་དང་ནང་གི་སྐྱེ་མཆེད་ཀྱི་བདག་ཉིད་ཙམ་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཕྱི་དང་ནང་གི་སྐྱེ་མཆེད་རྣམས་རང་བཞིན་མེད་པར་བསྟན་པ་འདིས་དངོས་པོ་ཐམས་ཅད་ཀྱང་ངོ་བོ་ཉིད་མེད་པར་རྟོགས་ཤིང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "སྐྱེད་མ་དང་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་མ་དང་བུ་མོ་ལ་སོགས་པའི་འབྲེལ་པ་མེད་པར་སྟོན་པར་འགྱུར་ཏེ།",
    "བུ་ལ་སོགས་པ་ཕན་ཚུན་དུ་འབྲེལ་པ་གང་ངག་གི་འམ་གང་གིས་འབྲེལ་པར་བརྗོད་དེ་མ་གྲུབ་པ་དེ་ཁོ་ནའོ།",
    "དེ་ལྟར་མཆོག་གི་དེ་ཁོ་ན་ཉིད་མཐོང་བའི་རྣལ་འབྱོར་པས་ཁམས་གསུམ་མ་ལུས་པ་འདི་དག་དབྱིབས་ལ་སོགས་པ་ཙམ་གྱིས་རྣམ་པར་ཕྱེ་བ་ལྷའི་རིགས་ཀྱིས་མ་ཡིན་ནོ།",
    "ལང་ཚོ་དང་ལྡན་པའི་བུ་མོ་རྣམས་གཟུང་བར་བྱ་སྟེ།",
    "བདག་དང་བདག་གི་བ་སྣ་ཚོགས་པ་རྣམས་སྤངས་ཏེ།",
    "ཁ་ཅིག་ཏུ་ཐོགས་པ་དང་བཅས་ཤིང་ཁ་ཅིག་ཏུ་བགྲོད་པ་མ་ཡིན་པ་གཞན་དུ་རྣལ་འབྱོར་མ་རྣམས་ལ་དཔྱད་པ་མེད་པར་རང་གི་ལུས་བཞིན་དུ་རེག་པར་བྱ་ཞིང་སྤྱད་ལ་བཏུང་བ་དང་།",
    "རིགས་ལྔ་རྣམས་ཀྱི་ཕྱག་རྒྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཐོག་མ་མེད་པའི་སྐྱེ་བ་གཅིག་ནས་གཅིག་ཏུ་གོམས་པའི་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་རབ་ཏུ་ཞི་བར་བྱ་བའི་རྒྱུར་གསུངས་སོ།",
    "སྤྲོས་པ་མེད་པ་ཉིད་ཡིན་ཡང་བསྒྲུབ་པར་བྱ་བ་དང་བྱེད་པའི་བྱེ་བྲག་གིས་གསུངས་པ།",
    "འཇིག་རྟེན་ལ་དེ་ཁོ་ན་ཉིད་ཀྱིས་གཟིགས་པས་ན།",
    "ཅི་ཉན་ཐོས་ལ་སོགས་པ་དང་ཐུན་མོང་བ་ཞིག་གམ་སྙམ་པ་ལ།",
    "མ་ཡིན་ཏེ་ཕ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཕ་ནི་རང་གི་སེམས་ཙམ་གྱི་བདག་ཉིད་དོ།",
    "བདེ་དེ་རང་གི་ལོངས་སྤྱོད་བྱ།",
    "ཞེས་བྱ་བ་ལ་རང་གི་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དང་།",
    "བདེ་དེ་རང་གི་ལོངས་སྤྱོད་བྱ།",
    "བདེ་བ་གང་ཞིག་གིས་ཞེས་བྱ་བ་ནི་བདེ་བའི་རང་བཞིན་གང་ཞིག་ཤར་བར་གྱུར་པས་སོ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་གང་ཞིག་གིས་སོ།",
    "བགྲོད་པ་ཞེས་བྱ་བ་ནི་ལྷག་པར་སོང་བར་གྱུར་པའོ།",
    "གཟུང་བྱ་བ་ཞེས་བྱ་བ་ནི་ཚུལ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་རང་གི་ཉེས་པ་གསལ་བའི་ཕྱིར་དང་།",
    "མ་མོ་ནི་ལྷ་མོ་རྣམས་ཀྱི་སྟེ་དེ་རྣམས་ཀྱི་གནས་ནི་ཁྱིམ་མོ།",
    "མཚན་མོའི་དུས་སུ་སྐྱེ་བོ་རྣམས་གཉིད་ལོག་པར་འགྱུར་བ་ནི་དབེན་པ་སྟེ།",
    "བས་མཐའ་ཞེས་བྱ་བ་ནི་གྲོང་གི་མི་རྣམས་ཀྱི་སྐད་གང་དུ་མི་ཐོས་པའོ།",
    "མ་མོའི་ཁྱིམ་ཡང་དེ་ཉིད་ཡིན་ཏེ་ཁམས་རྣམ་པ་བདུན་ནི་སྐྱེ་བའི་གནས་པས་མ་མོ་ཡིན་ལ།",
    "ཁྱིམ་ལྟར་དེ་འཛིན་པར་བྱེད་པས་ཁྱིམ་༡༥༨བ་མོ།",
    "དངོས་གྲུབ་ཐོབ་ཕྱིར་ཞེས་བྱ་བ་ལ་དངོས་གྲུབ་ནི་ཐུན་མོང་དང་།",
    "མཆོག་གི་དངོས་གྲུབ་དག་སྟེ།",
    "མཚན་ཉིད་དང་ལྡན་པའི་ལྷ་མོ་ནི།",
    "ཆུ་ནི་དྲི་ཆུའི་རྫས་ཏེ་དེ་དག་གི་དབུས་ན་གནས་པ་ཁྲག་དང་ཁུ་བ་དང་ཤ་རྣམས་ཀྱང་གཟུང་བར་བྱའོ།",
    "གཏི་མུག་ཅེས་བྱ་བ་ནི་ཕན་པ་དང་གནོད་པ་ལ་སོགས་པ་བདག་དང་བདག་གིར་འཛིན་པའོ།",
    "འཇིགས་པ་ཞེས་བྱ་བ་ནི་སྤྱོད་པ་ལ་ཞུགས་པ་རྣམས་ཀྱི་འབྲས་བུའི་བར་ཆད་བྱ་བའི་ཕྱིར་གཞན་དག་གིས་བྱས་པའི་སྒྲིབ་པའི་ཁྱད་པར་རོ།",
    "དེ་དག་གི་རོ་མྱང་བ་ལ་ལྟོས་པ་མེད་པར་ལོངས་སྤྱོད་ཅིང་ཞིམ་པ་དང་།",
    "བླ་ན་མེད་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་སྤྱོད་པ་མ་གཏོགས་པར་ཕྱི་དང་ནང་གི་སྦྱིན་སྲེག་ལ་སོགས་པའི་རྟོག་པ་རྣམས་ཀྱིས་དངོས་གྲུབ་ཆེན་པོར་མི་འགྱུར་རོ།",
    "རང་གི་ཏིང་ངེ་འཛིན་ལས་ཉམས་པར་མི་བྱའོ།",
    "སེང་གེ་ནི་བཅོམ་ལྡན་འདས་ཏེ་ཉོན་མོངས་པ་རི་དགས་ཀྱིས་མི་བརྫི་བའི་ཕྱིར་རོ།",
    "མྱོས་པ་ཞེས་བྱ་བ་ནི་ལུས་དང་ངག་གི་རྣམ་པར་དབྱེ་བ་སྔོན་དུ་འགྲོ་བས་རྒྱལ་བར་འགྱུར་བའོ།",
    "སྐལ་པ་དང་ལྡན་པ་རྣམས་ཀྱི་སྤྱོད་ཡུལ་མ་ཡིན་པའི་བརྡ་མ་རྟོགས་པར་རང་གི་དམ་ཚིག་ཅན་རྣམས་ཁོང་དུ་ཆུད་པར་མི་འགྱུར་རོ།",
    "བརྡ་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་ལུས་དང་ངག་གི་ཐ་སྙད་དོ།",
    "དེ་ནས་རང་གི་དམ་ཚིག་ཅན་དེ་རྣམས་ལ་ཡང་གུས་པས་སྤྱི་བོས་འདུད་པར་བྱས་ནས་སྐལ་པ་ཇི་ལྟ་བ་བཞིན་དུ།",
    "འདི་རྣམས་སུ་རྣམ་པ་བཅུ་གཉིས་ཏེ་ཞེས་བྱ་བ་ནི་མོས་པས་སྤྱོད་པའི་ས་དང་།",
    "རིང་དུ་སོང་བ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཉིན་མོ་དང་མཚན་མོ་ནི་ཐབས་དང་ཤེས་རབ་ཀྱི་རྣམ་པར་དག་པར་གསུངས་པ་ཡིན་ནོ།",
    "བདག་གི་བདག་ལྟར་གཞན་དེ་བཞིན།",
    "ཞེས་བྱ་བ་ནི་ཕྱིན་ཅི་ལོག་གིས་བརྟགས་པའི་ཕུང་པོ་ཙམ་སྟེ།",
    "ཇི་སྲིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་གང་ཅུང་ཟད་ལུས་ཀྱི་རྣམ་པའི་ལས་དང་གང་ཡང་དག་གི་རང་བཞིན་དེ་ཐམས་ཅད་སྔགས་དང་ཕྱག་རྒྱའོ།",
    "དེའི་སྟེང་མཐོ་གང་གི་སྤགས་པའི་བར་སྣང་ལ་ཁ་ཊྭཱཾ་གའི་ཟླ་བ་ལ་གནས་པའི་ཡི་གེ་ཨོཾ་གྱིས་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་དྲངས་ནས་དམ་ཚིག་གི་བདུད་རྩི་དང་གཅིག་ཏུ་བྱས་ཏེ།",
    "ཟེའུ་འབྲུ་ཞེས་པ་ནི་ཟེའུ་འབྲུ་ཡོངས་སུ་གྱུར་པ་སྟེ་ནང་གི་རིམ་པ་ཟླུམ་པོའོ།",
    "ཞེས་ཇི་སྐད་གསུངས་པའི་པི་ཙུ་བཛྲའི་རི་མོའི་དཀྱིལ་འཁོར་དུ་གཏོགས་པའོ།",
    "ས་བོན་ཕྱག་མཚན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དེ་དག་གི་དབུས་སོ།",
    "སེར་མོ་ལ་སོགས་འདི་ལས་འབྱུང་།",
    "ཡན་ལག་དྲུག་ཅེས་བྱ་བ་ནི་ཁ་དོག་དྲུག་གི་བདག་ཉིད་ཅན་ནོ།",
    "ཞེས་བྱ་བ་ལ་མཆོག་ཏུ་དགའ་བ་དང་རྣམ་པར་དགའ་བ་དག་གི་དབུས་ནི་མཐའ་སྟེ།",
    "ཕྱི་ནས་གསལ་བར་ལྡན་ཞིང་རྒྱུན་དུ་སྐད་ཅིག་གཅིག་ཀྱང་དེ་ཉིད་སེམས་གཅིག་གིས།",
    "དེ་ལྟར་ལས་དང་ཉོན་མོངས་པར་མ་བསམས་པས་ཕུང་པོ་ལ་སོགས་པ་ལོག་པ་ཙམ་ནི་མྱ་ངན་ལས་འདས་པ་ཞེས་བྱའོ།",
    "དེ་ལྟ་མོད་ཀྱི་ལྷན་ཅིག་སྐྱེས་པའི་རང་བཞིན་བསྟན་པའི་ཕྱིར་གསུངས་པ།",
    "ངག་གི་རྟོག་པ་ཐམས་ཅད་ཀྱི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སྔགས་ཀྱི་ལས་གོ་བཟློག་པའི་མན་ངག་ཤེས་པར་བྱ་བ་སྟེ་རང་གི་ཉམས་སུ་མྱོང་བར་བྱ་བའོ།",
    "ཞེས་བྱ་བ་ནི་ལེགས་པར་བྱས་པའི་རང་གི་རྒྱུད་ལས་གསུངས་པ་ཕྱག་རྒྱ་རྙེད་པ་ཡིན་ནོ།",
    "རང་གི་གཟུགས་དང་ལྷན་ཅིག་ཅེས་བྱ་བ་དེ་ཉིད་ཀྱིས་བདག་ཉིད་ལྷའི་བདེ་བའི་རང་བཞིན་བསམ་པར་བྱ།",
    "ཞེས་བྱ་བ་ནི་གང་ཅུང་ཟད་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ལས་ཉོན་མོངས་པ་ཡང་རུང་སྟེ།",
    "ཞེས་བྱ་བ་ནི་གཞན་དག་གི་ནི་ཐོས་པ་དང་དྲན་པ་དང་།",
    "རང་གི་ཏིང་ངེ་འཛིན་ལས་ཉམས་པ་ལས།",
    "རང་གིས་བསྡུས་ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བདེ་བ་ཆེན་པོའི་རང་བཞིན་དུ་ཡང་དག་པར་འདུས་པའོ།",
    "འདོད་ཆགས་ཞེ་སྡང་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་ཏེ།",
    "དེ་དག་གི་མི་མཐུན་པའི་ཕྱོགས་སུ་གྱུར་པ་རྣམས་ཀྱིས་སོ།",
    "ཡེ་ཤེས་ཞེས་བྱ་བ་ནི་སོ་སོར་རང་གིས་རིག་པའི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་དེ།",
    "ཞེས་བྱ་བ་ནི་བུད་མེད་དང་སྐྱེས་པའི་རྣམ་པས་སོ།",
    "འདི་དག་ནི་རང་གི་རང་བཞིན་གྱིས་གསལ་བ་སྟེ།",
    "ངག་གི་ལམ་འདས་ཞེས་བྱ་བ་ནི་མིང་དང་མཚན་མ་དང་ངག་གི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "བདག་བྱིན་གྱིས་བརླབ་པའི་རིམ་པ་ཞེས་བྱ་བ་ནི་སྔགས་ལ་སོགས་པའི་རྣམ་པར་དག་པ་རྣམས་ནི་རང་གི་རང་བཞིན་གྱིས་སེམས་ལ་གནས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡེ་ཤེས་རང་གི་རྣམ་པའི་ཡུལ་དང་གཞན་གྱི་རྣམ་པའི་ཡུལ་ཅན་ཡང་མི་སྐྱེའོ།",
    "དེ་དག་གིས་མི་འགྲུབ་ཅེས་པ་ནི་ཕྱག་རྒྱ་ཆེན་པོའི་བདག་ཉིད་དུའོ།",
    "སྲིད་པ་དག་པར་འགྱུར་ཞེས་བྱ་བ་ནི་དེ་དག་གིས་དག་པ་བསྐྱེད་པ་ཙམ་ལེགས་པར་འགྱུར་རོ།",
    "མི་ཤེས་པ་ཞེས་བྱ་བ་ནི་ལྷག་པར་མོས་པ་ཙམ་ཡང་མི་ཤེས་པ་སྟེ།",
    "རྒྱུད་གཞན་དག་གིས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ཀྱི་ཕྱིར་འབད་པ་དེ་དག་གི་ངལ་བ་འབྲས་བུ་མེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ལྟེ་བར་གཏུམ་མོ་འབར་བ་ཞེས་བྱ་བ་འདི་ཡང་རྫོགས་པར་བྱ་བའི་ཕྱིར།",
    "ཆུ་བོ་རྒྱུན་དུ་འབབ་པ་སྟེ་ཞེས་བྱ་བ་ནི་ཧཾ་གི་གཟུགས་ཅན་གྱི་མི་ཤིགས་པ་རྟག་ཏུ་འོག་ཏུ་བལྟས་ནས་སོ།",
    "མར་མེ་རྒྱུན་དུ་འབར་བ་ཞེས་བྱ་བ་ནི་ཨཾ་གི་གཟུགས་ཅན་མ་བར་ཆད་མེད་པར་འབར་བ་རང་བཞིན་གྱིས་འོད་གསལ་བའི་ཤེས་རབ་སྟེང་དུ་བལྟས་པར་བསམ་པ་སྟེ།",
    "དངོས་པོ་ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་ཕྱི་དང་ནང་གི་རྣམ་པར་དག་པའི་དངོས་པོ་མཐའ་དག་རྣམ་པར་དག་པ་ནི་དེ་བཞིན་ཉིད་དེ།",
    "རེ་རེ་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལ་སོགས་པའི་དབྱེ་བས་ལྷ་རྣམས་ཀྱི་རྣམ་པར་དག་པ།",
    "མི་ཤེས་པ་དང་ཉོན་མོངས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "མི་ཤེས་པ་ནི་མ་རིག་པ་སྟེ་བདག་དང་བདག་གིར་འཛིན་པའོ།",
    "འདོད་པ་དང་མི་འདོད་པའི་ལས་ཀྱི་རྒྱུར་གྱུར་པའི་སེམས་ཀྱི་ཁྱད་པར་ནི་ཉོན་མོངས་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་སྟེ་སྟོང་པ་འདི་དག་གི་རྣམ་པར་དག་པ་ནི་ཕྱག་བཅུ་དྲུག་པོ་རྣམས་སོ།",
    "ཉོན་མོངས་པའི་དང་།",
    "འཆི་བདག་གི་བདུད་རྣམས་ཏེ།",
    "ཉོན་མོངས་པའི་བདུད་ནི་འདོད་ཆགས་ལ་སོགས་པ་རྣམས་སོ།",
    "གང་དང་གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་བདག་ཉིད་ཀྱི་ལས་དག་ཉོན་མོངས་པས་ཡང་དང་ཡང་དུ་སྐྱེ་བོ་རྣམས་བཅིངས་པ་ཡིན་ནོ།",
    "དེ་དག་གི་གདོང་དགབ་པར་བྱའོ་ཞེས་བྱ་བར་འདོད་དོ།",
    "ཡེ་ཤེས་ཞེས་བྱ་བ་ནི་རང་གིས་རབ་ཏུ་གསལ་བའི་རང་བཞིན་ནོ།",
    "ཐོགས་པ་མེད་པའི་ཕྱིར་ན་མཁའ་མཉམ་མོ།",
    "ཐམས་ཅད་མཁྱེན་ཅེས་བྱ་བ་ནི་དེ་ཉིད་རང་གི་སེམས་ཙམ་ཉིད་ཀྱིས་ཐམས་ཅད་དུ་སོན་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ནི་གང་དང་གང་གི་གཟུགས་ཀྱི་བརྟགས་པ་དེ་དང་དེའི་གཟུགས་སུ་ལྡན་པ་ཉིད་དུ་མཚོན་པའི་ཕྱིར་རོ།",
    "མཆོག་གི་ངོ་མཚར་ཐོབ་གྱུར་ནས།",
    "མཆོག་གི་བླ་ན་མེད་པའི་བདེ་བ་ཆེན་པོའི་རང་བཞིན་ནོ།",
    "ཐུན་མོང་དང་མཆོག་གི་དངོས་གྲུབ་རྫོགས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དེ་ཉིད་ཉོན་མོངས་པའི་དྲི་མ་དང་བྲལ་བའི་ཕྱིར་རྣམ་པར་དག་གོ།",
    "ཞེས་བྱ་བ་གང་འདི་ཕྱིན་ཅི་ལོག་ཏུ་ཡོངས་སུ་བརྟགས་པའི་སེམས་ཀྱིས་བསགས་པའི་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་རང་བཞིན་བདག་དང་བདག་གི་བ་དང་།",
    "གཟུང་བ་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པ་རྣམ་པར་དག་པའི་སེར་མོ་ལ་སོགས་པའོ།",
    "༡༧བ་ཤ་དང་ཁྲག་དང་གཅི་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྤོས་མོ་ལ་སོགས་པའོ།",
    "སྒོམ་ཞེས་བྱ་བ་ནི་ལམ་མོ།",
    "དགྲ་ཞེས་བྱ་བ་ནི་སྤང་བར་བྱ་བའི་རང་བཞིན་ཉོན་མོངས་པ་སྟེ་དེ་མེད་པའོ།",
    "ལྷན་ཅིག་སྐྱེས་ཞེས་བྱ་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་དང་ཡང་དག་པར་བྲལ་བ་སྟོང་པ་ཉིད་དང་།",
    "རྟོག་པ་མཐའ་དག་དང་བྲལ་བའི་རང་གི་སེམས་ནི་སྟོང་པའོ།",
    "ཞེས་བྱ་བ་ནི་མཁའ་ལ་སྤྱོད་པའི་དངོས་གྲུབ་གྲུབ་ན་རྟག་ཏུ་རིག་པ་འཛིན་པའི་བུ་མོ་རྣམས་དང་སྦྱོར་བས་ཀུན་དུ་དགའ་བ་སྐྱེས་པས་རྣམ་པར་དགའ་བ་སྟེ་འདོད་ཆགས་དང་བྲལ་བའི་རང་བཞིན་སུན་འབྱིན་པ་ཞེས་འཇོམས་པ་ཡིན་ནོ།",
    "ཤིན་ཏུ་ཐུང་ཞིང་རིང་བ་ཡང་མ་ཡིན་པའི་ཡིད་དུ་འོང་བ་འཛམ་བུ་ནཱ་དའི་གསེར་གྱི་ཁ་དོག་གི་བདག་ཉིད་སྐྱེ་བོ་ཐམས་ཅད་ཀྱིས་བསྔགས་པའི་ལུས་སོ།",
    "གྲུབ་པ་དག་གི་སེམས་ཀྱིས་ནི།",
    "ཞེས་བྱ་བ་ནི་ཐ་མལ་པའི་ང་རྒྱལ་ལས་གྲོལ་བ་རང་གི་ལྷའི་རྣམ་པ་དང་ཡང་དག་པར་ལྡན་པའི་སེམས་ཏེ།",
    "གཞན་ཡང་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་རྣམས་ཀྱིས་སྒྲུབ་པ་པོ་ཉོན་མོངས་པར་མི་འགྱུར་པ་སྟེ།",
    "ཕྱག་རྒྱ་འདི་ཉིད་ནི་མོས་པ་དམན་པ་གཞན་པ་རྣམས་ཀྱིས་ནི་འཇིགས་པ་སྐྱེ་བར་འགྱུར་བས་ན་འཇིགས་པའི་གཟུགས་སོ།",
    "དངོས་གྲུབ་ཀྱི་རང་གི་ངོ་བོ་༡༧༤ཨ་གསུངས་པ།",
    "དེའི་ཕྱིར་སྐྱེ་བ་དང་འཇིག་པ་དག་གི་ཐབས་དང་ཤེས་རབ་ནི་འཆིང་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "གང་ཡང་ཞེས་བྱ་བ་ནི་གང་གི་ཡང་ངོ།",
    "སྤྲོས་པའི་ངོ་བོ་ཉིད་མེད་པར་གྱུར་པ་ནི་གང་གི་ཕྱིར་སྤྲོས་པ་མེད་པ་ཉིད་དུ་གྲུབ་པ་ཡིན་ན།",
    "གང་གི་ངོ་བོ་གང་ཡིན་པ་དེ་མེད་པར་འགྱུར་བ་དེ་ལ་དེའི་ངོ་བོ་ཉིད་དུ་བརྗོད་པ་ནི་མེད་དོ།",
    "རྨི་ལམ་བཞིན་ཞེས་བྱ་བ་ནི་རང་གི་སེམས་ཙམ་ལས་ཡང་དག་པར་སྤྲུལ་པ་ཡིན་གྱི་རྒྱུ་གཞན་ལ་ལྟོས་པ་ནི་མ་ཡིན་ནོ།",
    "དད་པའི་ཤུགས་ནི་དད་པ་ཙམ་མོ།",
    "རྨོངས་པ་གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "རང་གི་སེམས་ཙམ་ཉམས་སུ་མྱོང་བའི་དངོས་གྲུབ་ནི་ང་སྟེ་དེས་ནི་དེ་མི་ཤེས་པའོ།",
    "ཡང་ན་ཇི་ལྟར་མར་མེས་བསྐལ་བ་མང་པོར་སྔོན་ནས་བསགས་པའི་མུན་པ་རྣམས་ཀྱང་གང་དུ་ཡང་སོང་བ་མེད་གར་ཡང་གནས་པ་མེད་པ་དེ་བཞིན་དུ་རང་བཞིན་གྱིས་ཞི་བར་འགྱུར་བ་ཡིན་ནོ།",
    "རིགས་ཀྱི་བུ་དེ་བཞིན་དུ་ཐོག་མ་མེད་པའི་དུས་ནས་ཡོངས་སུ་བསགས་པའི་མ་རིག་པའི་བག་ཆགས་ཀྱང་ཡེ་ཤེས་ཀྱི་སྣང་བ་བསྐྱེད་པ་ཙམ་གྱིས་གང་དུ་ཡང་སོང་བ་མེད་གང་དུ་གནས་པར་འགྱུར་བའང་མེད་བཞིན་དུ་འགགས་པ་ཡིན་ནོ།",
    "རང་གི་དངོས་ཉིད་མྱ་ངན་འདས།",
    "རང་གི་དངོས་ཉིད་དེ་རང་གི་ངང་ཚུལ་གྱིས་མྱ་ངན་ལས་འདས་པའི་བདག་ཉིད་ཀྱི་ཕྱིར་ཏེ།",
    "དུག་གི་དུམ་བུ་གང་ཉིད་ཀྱིས།",
    "དེ་ཉིད་ཤེས་པར་ཞེས་བྱ་བ་དུག་གི་རང་བཞིན་ཤེས་པའི་དུག་དེས་ནི་བདེ་བར་ཉེ་བར་འགྲོའོ།",
    "དུག་གིས་དུག་ནི་སེལ་བར་བྱེད།",
    "སྲིད་པའི་འཆིང་བ་ལས་ཞེས་ཏེ་ཕྱིན་ཅི་ལོག་གི་བདག་ཉིད་ཀྱི་སེམས་ནི་སྲིད་པའོ།",
    "གང་གིས་རྣམ་པ་ཡི་གེ་སྟེ་ཨེ་ལྟ་བུ་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ་བྷ་ག་ཡིན་ནོ།",
    "མཆོག་གི་མཐར་ནི་བདེ་བ་ཐོབ་པ་ཞེས་བྱ་བ་ལ།",
    "བདེ་བ་ནི་དོན་དམ་པའི་བདེ་བ་ཙམ་མོ།",
    "བཙུན་མོའི་ཁུ་བ་མ་བྱིན་པ་ཞེས་བྱ་བ་ལ།",
    "སྔར་བསྟན་པ་དེ་ནི་བཙུན་མོ་སྟེ།",
    "གཞན་གྱི་བུད་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་གཞན་ཞེས་བྱ་བ་ནི་ཕུལ་དུ་བྱུང་བའོ།",
    "ཁམས་གསུམ་ཐམས་ཅད་ཤིན་ཏུ་མནན་པའི་སྐུ་ནི་བུད་མེད་དོ།",
    "མིང་གི་ཁྱད་པར་གཞན་བདག་མེད་མ་ལ་སོགས་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ནི་རང་འོད་མཛེས་ཏེ་རང་གི་སེམས་སྣང་བ་༡༧༩བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མོད་ཀྱི་སོ་སོར་སྣང་བའི་ཕྱིར་བརྫུན་པ་ཡང་མ་ཡིན་ཏེ།",
    "སྔགས་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི་རྣམ་པར་རྟོག་པའོ།",
    "བསམ་གཏན་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི་ཡང་དག་པའི་ཤེས་པ་སྟེ།",
    "རོལ་པ་ཞེས་བྱ་བ་ནི་དེ་དག་ཐམས་ཅད་བདག་མེད་མ་ལ་སོགས་པ་དང་དབྱེར་མེད་པའི་བཙུན་མོར་བྱས་ཏེ།"
  ]
}