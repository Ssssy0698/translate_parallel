    "དུར་ཁྲོད་ཅེས་པ་ལ་སོགས་པ་སྟེ་དེར་ནང་གི་བདག་ཉིད་ཀྱི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་སྔོན་དུ་བྱས་ཏེ་བཟའ་བ་དང་ལོངས་སྤྱོད་བྱ་བ་དང་།",
    "སྐྱེ་བོ་དང་བྲལ་བའི་ཁྱིམ་དུ་གསང་བའི་གནས་སུ་རིགས་ཀྱི་ཕོ་ཉ་མོ་ཐམས་ཅད་གོས་དང་བྲལ་བ་རྣམས་དང་།",
    "སྒྲུབ་པ་པོ་ཡང་ཕྱག་རྒྱ་ལྔ་ཡིས་བརྒྱན་པ་རང་རང་གི་གནས་སུ་རྣལ་འབྱོར་མ་རྣམས་སྐྲ་གྲོལ་བ་སྒྲུབ་པ་པོ་ཡང་གཙུག་ཕུད་བཅིངས་པའོ།",
    "ཚོགས་ཀྱི་བདག་པོ་ནི་སྟག་གི་པགས་པའི་སྟེང་དུ་འཁོར་ལོའི་དབུས་སུའོ།",
    "རང་རང་གི་རིགས་ཤི་བ་རྣམས་ཀྱིའོ།",
    "ཐུན་མོང་དུ་ནི་སྔགས་ཀྱི་སྟོབས་ཀྱིས་སམ་ལྷའི་ངེས་པས་སོ།",
    "རང་གི་རང་རིགས་ཀྱིས་སྨིན་པའི་རིགས་ཀྱི་བུ་མོ་རྣམས་ཀྱིས་སོ།",
    "དབུས་སུ་རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་མེད་ན་བ་བྱུང་གི་ཆུ་ཡིས་གྲུ་བཞི་པ་བྱས་ཏེ།",
    "གང་དུ་དགེ་སློང་རྡོ་རྗེ་འཛིན་པ་དག་གི་ནང་ནས་རྒན་པ་རྨོངས་པ་དང་གཞོན་པ་སྟོན་པ་པོ་ཡིན་ན་དེར་གཞོན་པ་ཚོགས་ཀྱི་བདག་པོ་རྒན་པོ་རྨོངས་པ་ནི་ཁང་པ་གཞན་དུ་ཚིམ་པར་བྱའོ།",
    "ཚོགས་ཀྱི་གཙོ་མོའི་གཡོན་དུ་ཐབས་སྦྱིན་པའི་བདག་པོས་གཞག་པར་བྱའོ།",
    "རྣམ་པ་གཞན་དུ་ན་ཐབས་མེད་པར་ཚོགས་ཀྱི་གཙོ་མོས་མྱོས་བྱེད་དང་ཤ་བཟའ་བར་མི་བྱའོ།",
    "དེ་ནས་ཚོགས་ཀྱི་བདག་པོ་ལ་སོགས་པ་ལ་གཡོན་སྐོར་དུ་བཟའ་བ་དང་སྟོན་མོ་དབུལ་༡༣༨བ་བར་བྱ་ཞིང་བཏུང་བ་ནི་ཁམ་ཕོར་རམ་ནཱ་རི་ཀ་ལ་སོགས་པའི་སྣོད་དུ་དབུལ་བར་བྱའོ།",
    "ལག་པ་གཡས་པས་ཨཱ་ཡིག་གིས་རྒྱས་པར་བྱའོ།",
    "ཐལ་མོ་བཀབ་ནས་ཧཱུྃ་ཡིག་གིས་འབར་བར་བྱའོ།",
    "ཨོཾ་ཆེ་གེ་མོ་ཨཱ་ཧཱུྃ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གི་སྔགས་ཀྱིས་བསྔགས་པར་བྱས་ནས་བཟའ་བར་འགྱུར་བ་ཇི་སྲིད་པ་ས་ལ་གཞག་པར་བྱའོ།",
    "གང་གི་ཚེ་འགའ་ཞིག་འཐབ་པ་དང་རྩོད་པ་བྱེད་པ་དེ་གདོན་པར་བྱའོ།",
    "གང་གི་ཚེ་དགེ་སློང་དམ་དགེ་ཚུལ་ལམ།",
    "ད་ནི་ནང་གི་ཚོགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་གསལ་བར་བྱ་སྟེ་གསུངས་པ་ཡང་།",
    "དེ་ལྟར་སྒྲུབ་པ་པོས་བཟའ་བ་དང་སྟོན་མོ་དང་བཏུང་བ་ལ་སོགས་པ་རྣམས་ཀྱིས་སྐུའི་རྡོ་རྗེ་རིམ་པར་བྱས་ནས་མཐར་ལྔ་པ་རེག་བྱའི་ཡུལ་མྱོང་བར་བྱེད་དོ།",
    "བརྟགས་ལ་བཞག་ནས་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་འགྲུབ་པར་བྱའོ་ཞེས་བསྟན་པར་མོས་པ་བསྐྱེད་ནས་འཁྱུད་པ་དང་འོ་བྱེད་པ་དང་འཇིབ་པ་དང་།",
    "སེན་མོ་འདེབས་པ་དང་སིད་ཡིག་དང་།",
    "བུང་བའི་སྒྲ་ཡིས་རྩ་རྣམས་རྒྱས་པ་ལ་སོགས་པ་བྱས་ནས་དེ་བཞིན་གཤེགས་པའི་སྐྱིལ་མོ་ཀྲུང་དང་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་དང་།",
    "ལས་ཀྱི་སྐྱིལ་མོ་ཀྲུང་ལ་སོགས་པ་བཅིང་བ་བཅིངས་ནས་ལས་ལ་གནས་པར་འགྱུར་རོ།",
    "དེ་ནས་ཤེས་རབ་དང་ཐབས་སྙོམས་པར་ཞུགས་པས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་བསྲུབས་པ་༡༣༩བ་ལས་ལྷན་ཅིག་སྐྱེས་པའི་མེ་རབ་ཏུ་སྦར་ནས་ཕུང་པོ་ལ་སོགས་པའི་རང་བཞིན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྤྱི་བོ་ནས་བརྩམས་ནས་རྩ་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་གཉིས་སུ་འབབ་པའི་རྒྱུན་གྱི་རྣམ་པས་ཨཱ་ལི་དང་ཀཱ་ལིར་ཞུ་བར་གྱུར་ནས།",
    "འདོད་ཆགས་དང་ཆགས་བྲལ་དང་ཆགས་པ་བར་མའི་རིམ་པས་གང་དེ་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ངོ་བོ་ཉིད་སོ་སོར་རང་གི་བདག་ཉིད་ཀྱིས་རིག་པར་བྱ་བ་མཛད་དོ།",
    "ངག་གི་བརྡ་ཡིས་ཐ་སྙད་དུ་བྱའོ།",
    "རྒྱུ་གང་གི་ཕྱིར་མཚན་མ་དང་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པས་སྲོག་གཅོད་པར་འགྱུར་བ་རྒྱུ་དེའི་ཕྱིར་རྣལ་འབྱོར་པས་མཚན་མ་མེད་པ་ཁ་ན་མ་ཐོ་བ་མེད་པ་གོ་ཀུ་ལ་སོགས་པ་བཟའ་བར་བཅོམ་ལྡན་འདས་ཀྱི་བཀས་གསུངས་སོ།",
    "འདིར་ནམ་མཁའ་ལ་སོགས་པ་༡༤ཨ་ཡོན་ཏན་རེ་རེ་འཕེལ་བའི་དབྱེ་བས་བླངས་ནས་བདུད་རྩི་ལྔ་དང་གཅིག་ཏུ་བྱས་ཏེ་རྫས་བཅུ་པོ་རྣམས་བརྟག་པར་བྱའོ།",
    "ཕྱག་རྒྱ་ཆེན་མོ་ཅི་ལྟ་བུ།",
    "ཆེན་མོ་ཡང་འདི་ཡིན་ལ།",
    "ཕྱག་རྒྱ་ཡང་ངོ་ཞེས་པས་ཕྱག་རྒྱ་ཆེན་མོ་སྟེ།",
    "འདིར་ཕྱག་རྒྱ་བཟང་མོ་ནི་ལུས་ཕྲ་བ་རྫི་མ་དང་བཅས་པའི་སྐྲ་ཅན།",
    "རོལ་མོ་ཤེས་ཤིང་༡༤བ་གར་ཤེས་པ།",
    "གླུ་ལེན་ཤེས་ཤིང་རོལ་བ་མོ།",
    "ལྷ་མོ་ཆེན་མོ་འདི་གཅིག་པུ།",
    "མཐའ་ཡས་ཡོན་ཏན་སྟེར་བ་མོ།",
    "རྟག་ཏུ་སྐལ་བ་བཟང་མོར་ཤེས།",
    "དེ་རྙེད་ནས་ཞེས་པ་ཕྱག་རྒྱ་ཆེན་མོ་བརྗོད་པའི་མཚན་ཉིད་ཅན་ཡང་དག་པར་བསྐྱེད་ནས།",
    "དེ་ལྟར་གྱུར་པ་བརྟན་པ་དང་གཡོ་བའི་རང་བཞིན་གྱིས་བདག་ཉིད་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་མཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བ་རྒྱུད་ཀྱི་རྒྱལ་པོ་གང་གིས་འབྱེད་པར་བྱེད་པ་དེ་ཁོ་ན་མཚོན་པར་བྱ་ཞེས་པ་ངེས་པའི་དོན་ཏོ།",
    "འདིར་སྲོག་གཅོད་པ་ལ་སོགས་པའི་དམ་ཚིག་རྣམས་ནི་རྣམ་པ་གཉིས་ཏེ་དྲང་བའི་དོན་དང་ངེས་པའི་དོན་གྱིས་སམ་ཕྱི་རོལ་དང་ནང་གི་བདག་ཉིད་དོ་ཞེས་པའོ།",
