    "ཞེས་པའི་དོན་དང་དགོས་ཆེད་མཚམས་སྦྱོར་རྣམས་སུ་གསལ་པོ་མ་གསུངས་ཤིང་གཞན་དུའང་སྔོན་ཆད་མ་མཐོང་བས་བརྟག་བྱར་འདུག་གང་ལ་ཕོག་པ་དེ་དངོས་གྲུབ་ཀྱི་བརྡར་སྤྱི་བོར་བཅིང་།",
    "བྱང་བུའི་ཁར་དར་ལྟ་བུ་སྦྱང་བ་མ་རན་བར་འགེབ་སྲོལ་ཀྱང་ལ་ལར་འདུག་གལ་ཏེ་གཟུགས་བྱང་མ་འགྲུབ་ན་མིང་བྱང་ཙམ་མམ།",
    "ལྷོ་སྒོའི་མགོ་འདིར་ལས་རྡོར་གྱིས་ཕྱག་སྔོན་དུ་འགྲོ་བས་ལྷོ་སྒོའི་ས་བཅད་རྣམས་། བསྒྲགས་མཐར་ཞུ་འབུལ་གྱི་སྙན་གསན་དབབ་པའི་སྲོལ་ཞིག་ཀྱང་འདུག་པ་ཁུངས་དང་ལྡན་མིན་མ་ཤེས་སོ།",
    "ཞེས་སོགས་སྨོས་རིགས་པ་ལ་མ་སྨོས་པ་དེར་། གདའོ།",
    "ཞེས་པ་འདུག་ཀྱང་།",
    "འདིར་བྱང་རྟགས་སུ་གྲགས་པ་ལ་ཡིད་ཆེས་མིན་སྣ་ཚོགས་དཔེ་དུ་མ་ཡོང་འདུག་ཀྱང་།",
    "འདིར་པར་མ་ཐམས་ཅད་དུ་གོས་བཟུང་ཞེས་འདུག་པ་མ་དག་སྟེ།",
    "རྣ་ལྟག་གཡོན་རྣམས་སུ་བཞག་པ་སྟེ་འགའ་ཞིག་འདི་ལ་ཡང་རྡོ་རྗེའི་ཕྱག་རྒྱ་དེ་ཁ་མཛད་འདུག་ཀྱང་།",
    "ཚེ་འདས་ཀྱི་ཚེ་ཐོག་མེད་ནས་ཀྱི་སྡིག་སྒྲིབ་ཐམས་ཅད་ཡི་གེ་བཾ་འྀ་ཀཾ་ནག་པོའི་རྣམ་པར་འདུག་པ་སོགས་རིམ་པར་བརྗོད།",
    "སྡིག་ལྡན་ཚེ་འདས་ཞེས་བརྗོད་མཁན་ཡོད་འདུག་ཀྱང་།",
    "སེང་གེའི་འདུག་སྟངས་ཀྱིས་དྲན་པ་དང་སྣང་བའི་མཚན་མ་ཡིད་ལ་བྱེད་བཞིན་དུ་ཉལ་ལོ་། ནངས་པར་ཐོ་རངས་ནམ་གྱི་བརྒྱད་ཆ་ལུས་པ་ན་ལེ་ལོ་མེད་པར་ལངས་ཏེ་གོས་རྣམས་བཀོད་པ་མཛེས་ཤིང་ཚུལ་དང་མཐུན་པར་བགོས།",
    "སྟན་ལ་་། རྡོར་སྐྱིལ་གྱིས་འདུག་སྟེ།",
    "རང་ཉིད་སྒྲུབ་གྲོགས་དངབཅས་པ་དེ་ལ་ཁ་ཕྱོགས་པར་འདུག་སྟེ་ཁྲུས་དང་གཙང་སྦྲ་བྱ་བ་ནས་བཟླས་པའི་བར་བདག་བསྐྱེད་བཞིན་བྱས་རྗེས།",
    "སའི་དབུས་ཀྱི་སྐུ་བརྙན་བསྡུས་པའི་ཤུལ་དུ་ཁྲིའུའི་ཁར་སློབ་དཔོན་རྡོར་དྲིལ་ཐོགས་ཏེ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འཁོད།",
    "འདི་ལ་སྔོན་བྱོན་ཕལ་གྱིས་དོགས་དཔྱོད་མ་མཛད་འདུག་ཀྱང་ཁྲོ་པོ་ཪེམེ་ལྟར་འབར་བ་ཡོངས་སུ་གྱུར་པའི་རྡོ་རྗེ་གནོད་སྦྱིན་ཞེས་བྱུང་བ།",
    "གནས་སྲུང་བ་ནི་ང་གང་དུ་འདུག་པའི་ཡུལ་འཁོར་དང་ཉེ་སྐོར་ལ་བར་ཆད་སྲུང་བ།",
    "འོན་ཀྱང་མེ་ཏོག་དོར་དུས་རྡོ་རྗེ་འཁོར་ལོ་པདྨའི་སྟེང་དུ་འདུག་ལ།",
    "ལྷོ་སྒོའི་འགོ་འདིར་ལས་རྡོར་གྱི་ཕྱག་སྔོན་དུ་འགྲོ་བས་ལྷོ་སྒོའི་ས་བཅད་རྣམ་གྲངས་མཐར་ཞུ་འབུལ་གྱི་སྙན་གསན་ཕབ་པའི་སྲོལ་ཞིག་ཀྱང་འདུག་པ་ཁུངས་དང་ལྡན་མིན་མ་ཤེས་སོ།",
    "འདིར་པར་མ་ཐམས་ཅད་དུ་གོས་ཟུང་ཞེས་འདུག་པ་མ་དག་སྟེ་སྟོད་གཡོགས་སྨད་གཡོགས་མཚོན་པའི་གོས་སམ་དར་ཟུང་སྟེ་གཉིས་དགོས་པའི་དོན་ནོ།",
    "གལ་ཏེ་ལོང་མེད་ན་ཨོཾ་རུ་རུ་སྤུ་རུ་ཛཱ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ན་སརྦ་ཨརྠ་སཱ་དྷ་ཡ་སྭཱཧཱ།",
    "རང་འདུག་པའི་གནས་ཡུལ་ས་ཕྱོགས་ཐམས་ཅད་བགེགས་བསྲུང་བ་དང་།",
    "བཞུགས་སུ་གསོལ་ཞེས་བྲིས་པ་སོགས་མ་དག་པ་མང་ཙམ་འདུག་ཀྱང་ཐམས་ཅད་ཞུ་མི་ཚས།",
    "ཕྱོགས་སོ་སོའི་བུམ་པའི་སྐེའམ་བུམ་གོས་ཀྱི་ལོགས་དང་མདུན་གྱི་དེ་སྟེང་འོག་མཆུ་ཏོའི་ལོགས་ལ་འདོགས་སྲོལ་འདུག།",
    "བུམ་པ་རང་ལ་ཞབས་ར་མེད་པས་མཐིལ་ཀྱོང་ཙམ་ཡོད་པ་སྔར་གྱི་རྒྱ་གར་གྱི་བཟོ་རྒྱུན་རྣམས་ལ་ཡོད་འདུག་ལགས།",
    "འདིར་ལས་བུམ་སྔོན་དུ་བསྒྲུབ་པ་ནི་དེ་མན་ཆད་ཀྱི་བསངས་སྦྱང་ཕལ་ཆེར་ལས་ཆུས་བྱེད་དགོས་པས་དེ་སྔོན་དུ་བསྒྲུབ་དགོས་པར་གདའ།",
    "རྒྱན་དང་ལོངས་སྤྱོད་མཐོང་བ་ལ་ཆགས་ན་ལྷར་སྐྱེ་བའི་མཚན་མ་ཡིན་ཀྱང་རང་སེམས་ཀྱིས་བཟོས་པ་ཡིན་པས།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "དེ་ནས་བཛྲ་མུཡིས་ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས།",
    "བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "འདུག་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་མ་ཡེངས་པར་ཡོངས་སུ་སྤྱོད་པར་བྱེད་པའོ།",
    "ཡིད་དང་མཐུན་པའི་གནས་སུ་སྟན་བདེ་བ་ལ་འདུག་ལུས་དྲང་པོར་བསྲང་།",
    "ཁྲུས་སྔོན་ལ་བྱས་ནས་གྲལ་ལ་འདུག་པ་ཡིན་ཀྱང་འདིར་ཁྲུས་ཆུ་རྗེས་ལ་བཏང་བ་འདི་ཁའི་ད་ལྟའི་ལག་ལེན་ཚོ་དང་བསྟུན་པ་ཡིན།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་པོ་ཁམས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་་ཉིད་ཀྱི་ངོ་བོ་ཡི་གེ་ཧྲཱི་དཀར་པོ།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "ན་མ་ཨཱརྻ་ཛྙཱ་ན་སཱ་ག་ར་བེ་རོ་ཙ་ན།",
    "གནས་འདི་ཀ་ཡིན་འདུག་པས་ཁྱད་པར་དུ་འཕགས་པའོ།",
    "བདག་ཉིད་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "བགྲོད་མིན་འགྲོ་བ་འདོད་པ་ཡིས།",
    "བསམ་གཏན་སྤེལ་ན་འོག་མིན་འགྲོ།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡི།",
    "བྱུང་རང་བྱུང་བསྟན་པ་གཅེས་འཛིན་རྣམས།",
    "ཆད་པ་ཡིན་པས་རྒྱུན་ཆགས་པར་མི་འདུག་པའི་ཕྱིར་རོ།",
    "ཤིང་ལ་སོགས་པ་དེདག་སྔོ་རིལུ་བ་དེ་ཁོ་ན་ལྟར་འདུག་ཅིང་སྨོན་པའི་མཆན་ཉིད་ཅན་དུ་ཡང་མིའགྱུར་རོ།",
    "སེམས་ལྷུན་གྱིས་གྲུབ་པར་མཉམ་པ་ཉིད་དུ་འདུག་པ་གང་ཡིན་པའོ།",
    "གཞན་གྱིས་གསོད་པས་འཆི་བར་འགྱུར་གྱི་བདག་ཉིད་འཆིབར་མི་འགྱུར་བ་ནི་མངལ་ན་འདུག་པ་དང་སྒོ་ང་ན་འདུག་པོ་རྣམས་ཡིན་ནོ།",
    "དགྲ་བཅོམ་པ་ཕུང་པོ་ལྷག་མ་མད་པར་ཡོངས་སུ་མྱ་ངན་ལས་འདུགདེ་དུས་ཀྱི་སྐྱེ་མཆེད་དྲུག་ལ་སྐད་ཅིག་མ་ཕྱི་མ་མེད་པའི་ཕྱིར་གནས་པ་མེད་དོ།",
    "རྒྱུཡལ་བར་འདུག་པའི་འབྲས་བུ་དང་འབྲས་བུ་བར་དུ་ཆོད་པ་རྣམས་ལྟ་བུའོ།",
    "བདག་པོའི་རྐྱེན་ནི་གནས་སྐབས་ཐམས་ཅད་དུ་མི་སྒྲིབ་པའི་ངོ་བུར་གནས་པསོ་བདགུ་པའི་རྒྱུན་འདིའི་བྱ་བ་ནི་གནས་སྐབས་ཐམས་ཅད་དུ་མི་སྒྲིབ་པའི་དངོས་པོར་འདུག་པ་གང་ཡིན་པ་འདི་ཉིད་ཡིན་ནོ།",
    "དེ་ཡང་རང་ཉིད་ཀྱི་ཐུགས་ཉམས་སུ་ཐང་ལྷོད་མེད་པར་བསྟར་ཞིང་གདུལ་བྱ་ཉེ་རིང་མེད་པ་འགོད་པ་ལ་འཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པ།",
    "ཡིད་སློང་སློང་པོར་འགྱུར་བ་ཞིག་ནི་འཆར་དཀའ་བ་འདུག།",
    "པར་ད་ནི་གང་ནས་བསམས་ཀྱང་དོན་མེད་ཀྱི་འགྲོ་འདུག་སོགས་བྱ་བ་དང་།",
    "འཛེམ་མེད་དུ་བྱེད་ཤེས་ཤིང་སྤོབས་པར་འདུག་ན།",
    "དཔྱད་བཟོད་མི་བཟོད་དང་རང་རྩོམ་༥༧ན་དང་།",
    "དེ་ཡང་གཞན་དུ་བསྒྱུར་མི་བཏུབ་ཅིང་མི་སྨོན་པར་སྐྱོན་ཡོན་ཤེས་པའི་བློ་གྲོས་དང་རང་ཚུགས་ཐུབ་པའི་གྱོང་ཤ་དང་བཅས་པ་ཞིག་མ་བྱུང་ན།",
    "རྒྱལ་བའི་བཀའ་ལས་ཡི་གེ་ན་གཅིག་ཀྱང་འདོར་ཏུ་མེད་པར་གདམས་ངག་ཏུ་གོ་བ་ལ་བྱེད་ཟེར་བས་དེ་ཤིན་ཏུ་ཡིན་པར་འདུག་གསུངས་པ་ལྟར་ཏེ།",
    "ཧ་དཔྱད་ན་མི་གདའ་ཇི་ལྟར་ལགས།",
    "དེ་ལ་འདིར་རྗེ་ཉིད་ནས་ལམ་གྱི་དཀའ་གནས་ལས་བརྩམས་ཏེ་དོགས་གཅོད་མང་དུ་གནང་བྱུང་བ་འདི་དག་ནི་ཤིན་ཏུ་ཕྲ་ཞིང་རྟོགས་དཀའ་བ་ཤ་སྟག་ཏུ་འདུག་པས་བླུན་རྨོངས་བདག་འདྲས་འདིའོ་ཞེས་ཁ་ཚོན་བཅད་ཡོངས་འཛིན་གསན་ཡིག་བཀའ་གདམས་མེས་པོའི་ཞལ་ལུང་། སྟོད་ཆ།",
    "དམན་པའི་ཕྲག་དོག་དང་མཁས་པའི་ང་རྒྱལ་སོགས་ཐུགས་ཀྱི་ཐ་པ་དང་རང་རོང་མེད་པའི་མཚན་ཡོངས་འཛིན་གསན་ཡིག་བཀའ་གདམས་མེས་པོའི་ཞལ་ལུང་། སྟོད་ཆ།",
    "དེ་ལ་འདིར་རྗེ་ཉིད་༩༦བ་ནས་ལམ་གྱི་བཏུ་ཕྲ་ཞིང་རྟོགས་དཀའ་བ་ཤ་སྟག་ཏུ་འདུག་པས་བླུན་རྨོངས་བདག་འདྲས་འདིའོ་ཞེས་ཁ་ཚོན་བཅད་པར་མི་ནུས་ཀྱང་།",
    "དེ་ཉིད་སྦས་པའི་རྣལ་འབྱོར་པ་ཞིག་ཡིན་འདུག་ཅིང་།",
    "གླེགས་བམ་དེ་སྐབས་སུ་མ་བབ་པ་སུ་ཡིན་གྱིས་མདུན་དུ་ཡོད་ཀྱང་མི་མཐོང་བ་ཞིག་ཡིན་སྐད་མ་ཐོས་སམ་ཞེས་གསུངས་ནས་ཞལ་གྱིས་བཞེས་པར་མི་མཛད་འདུག།",
    "ཞེས་གསུངས་འདུག་ཅིང་ཁོང་ཉིད་ཀྱིས་ཀྱང་།",
    "བར་འདིར་པཎ་ཆེན་འཇིགས་མེད་གྲགས་པ་ཟེར་བ་ཞིག་འདུག།",
    "ཚུལ་འདི་བསམ་ཞིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "འཇམ་དཀར་དང་༡༤༣ན་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་ལུང་རྗེས་གནང་།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "དམིགས་བརྩེ་མའི་ལས་ཚོགས་བཞེས་འདུག་པ་འདིའི་མིང་མ་བཀོད་སྣང་བ་བཞིན།",
    "འཇིགས་བྱེད་ཀྱི་རྫོགས་རིམ་བཀའ་རྒྱ་མ་ཞི་ཁྲོ་སྦྲགས་སྒྲུབ་དང་བཅས་པ་བཞེས་འདུག་པ་ལྟ་བུ་དང་།",
    "འདུག་ས་འདི་ཉིད་དུ་བྱིན་གྱིས་རློབས་ཤིག།",
    "འདིས་ཀྱང་རང་གཞན་ཐམས་ཅད་ཀྱི་རྒྱུད་ལ་ཕན་ཐོགས་པར་གྱུར་ཅིག། རབ་འབྱམས་རྒྱལ་བ་སྲས་བཅས་ཀུན་གྱི།",
    "ལྟ་བ་སྐྱོང་བའི་ཚེ་དགག་བྱ་བཀག་པའི་མེད་དགག་སྟོང་སངས་བློ་ཡུལ་དུ་ཤར་ནས་དེའི་ངང་དུ་འཇོག་པ་ཡིན་འདུག་ཀྱང་ཐོག་༡༨ན་མར་དགག་བྱ་ཆུག་མེད་ཅིག་ངོ་འཕྲོད་དགོས་ཏེ།",
    "གཞན་གྱི་གཉན་ཟེར་བའི་གནས་༦༢འདི་ནོན་ཆེ་བར་འདུག་ཡོངས་འཛིན་ཡེ་ཤེས་རྒྱལ་མཚན་གྱི་གསུང་འབུམ། ན་",
    "ཕྱི་མ་བདེ་འགྲོ་ཙམ་ཐོབ་ཀྱང་གནས་དེ་ན་ཡང་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས་མ་འདས་འདུག་པས།",
    "ལོངས་སྤྱོད་གང་ལ་སྤྱད་ཀྱང་སྡུག་བསྔལ་གྱི་ལོངས་སྤྱོད་དུ་འདུག་པས།",
    "གཙོ་བོ་ཡང་རང་ལ་ཐིམ་པས་བྱིན་གྱིས་བརླབས་པར་བསམ།",
    "པགས་པ་དུམ་བུར་གཏུབས་པ་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཅི་འདོད་ཀྱི་དངོས་པོར་གྱུར་ཕཊ་ཞེས་༡༣ན་བརྗོད་ནས་རང་རང་ཇི་ལྟར་འདོད་པའི་དངོས་པོས་ཚིམ་པར་བསམ།",
    "ངའོ་སྙམ་པའི་བློ་འདིས་ང་ཞེས་པ་འདི་ཇི་འདྲ་ཞིག་ཏུ་བཟུང་འདུག་བློ་ཁ་ནང་དུ་ཕྱོགས་ནས་དལ་བུས་བརྟགས་པའི་ཚེ།",
    "དེ་ཡང་སྣང་ཚུལ་བརྟགས་པའི་བློ་ནི་ཁོ་རང་དང་དུས་མཉམ་ལ།",
    "དེ་རྗེས་ང་རང་ངོས་པ་དེ་ཕུང་པོ་འདི་རྣམས་དང་གཅིག་ཏུ་ཡིན་ན།",
    "ཕུང་པོ་ལྔ་ཡང་གཅིག་ཏུ་གྱུར་པའི་ཕྱིར་ན་ང་རང་ངོས་པ་དེ་ཕུང་པོ་རྣམས་དང་གཅིག་ཏུ་འོང་ས་མི་འདུག་སྙམ་དུ་ངེས་ཤེས་མྱོང་ཐོག་ནས་དྲང་བ་བསྐྱེད།",
    "དེ་རྗེས་ངར་འཛིན་གྱི་བཟུང་བ་ལྟར་གྱི་ང་རང་ངོས་པ་དེ་ཕུང་པོ་འདི་རྣམས་དང་ཐ་དད་དུ་གྲུབ་ན།",
    "དེ་འདྲ་གཏན་ནས་མི་འདུག་སྙམ་དུ་ངེས་པ་ན།",
    "ལས་དང་པོ་པ་རྣམས་ལ་ང་རིལ་པོ་མི་འདུག་པ་སྙམ་པའི་སྐྲག་པ་སྐྱེ་བ་ཞིག་དུས་དེར་དགོས་སོ།",
    "ང་རང་ངོས་ནས་མ་གྲུབ་བསྒོམས་པས་ངེས་ཤེས་ཤུགས་དྲག་པོ་སྐྱེས་པ་ན།",
    "གཞུག་སྡུག་བསྔལ་ལས་མ་འདས་འདུག་པས།",
    "འགྲོ་འདུག་ཞི་ཞིང་སྤྱོད་ལམ་དེས་པ་ལྟར།",
    "གླིང་རང་སའི་ཡོན་ཏན་བརྗོད་ཀྱི་མི་ལང་ཡང་།",
    "རང་རང་མཐུ་ཡིས་ཐོབ་ལ་དགའ་བྱེད་ཅིང་།",
    "འོན་ཀྱང་རང་ལྡོག་མ་འདྲེས་དགག་དགོས་ཚང་།",
    "རང་རང་འདོད་ཞེན་གྱིས་སྦྱར་ལྟོས་གྲུབ་ཀྱི།",
    "ཤིན་ཏུ་རྣམ་དག་འོག་མིན་འགྲོ།",
    "ཀུན་ཀྱང་རང་བསྟིམ་ང་རྒྱལ་བཟུང་བ་དང་།",
    "ཀུན་བྱེད་རྒྱལ་པོ་རང་བྱུང་རང་ལ་ཐིམ།",
    "རང་རང་རིགས་ཀྱི་ཡུམ་དང་བཅས་པ་རྣམས།",
    "ཀུན་ལ་རང་རང་སྒོ་མ་བཞི་བཞིར་ལྡན།",
    "དུས་ཀྱང་སོ་སོར་མི་རྟོག་དུས་མེད་དུས།",
    "དུས་ཀྱང་རང་རང་སྐལ་པའི་རྗེས་འགྲོ་བ།",
    "དམིགས་པ་གསལ་བ་དང་མ་ཡེངས་པ་བྱས་ཙ་ན་ཉམས་དགའ་ཤེས་པ་གསལ།",
    "རིག་པ་ལྷན་ནེར་ཕེབས་པ་འོང་བར་འདུག།",
    "སྐྱིད་སྡུག་ཅི་སྔ་འགྱུར་བཀའ་མ་པའདུག་ལྟོས་དང་དཀོར་ཟན་ཚོ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཤ་ཡི་ཟ་ལུགས་དང་།",
    "འདུག་ན་གནས་མི་རྟག་པས་དག་པའི་ཞིང་ཁམས་ཡིད་ལ་བྱ།",
    "གལ་ཏེ་ཡོད་ཀྱང་དེ་ལ་སྐྱོབ་པའི་ནུས་པ་ཞན་པ་དང་ཡང་ན་གཞན་སྐྱབས་པའི་མཐུ་རང་ལ་མེད་ཅིང་རང་སྐྱོབ་བྱེད་གཞན་མེད་པ་དང་།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "རབ་ཏུ་དོག་པའི་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "འགྲེང་འདུག་དང་བརྐྱང་བསྐུམ་སོགས་གཡོ་ཞིང་འགུལ་བའི་ཚེ་ལྷུ་ཚིགས་རྣམ་པར་འགྱུར་ནས་ས་ལ་འགྱེལ་བ་དང་།",
    "ཡུལ་འདི་ཀར་འདུག་ཞེས་པའི་ས་ཚུགས་མེད་པར་འགྲོ་དགོས་པའི་དུས་ལ་བབ་པས་སྐྱབས་དང་རྒྱམ་མགོན་མེད་པར་ཡིད་ལུས་བག་ཆགས་ཀྱི་བྱད་གཟུགས་ཙམ་ལ་བརྟེན་ནས་ཚོར་བ་ཐམས་ཅད་སྡུག་བསྔལསྣང་བ་ཐམས་ཅད་འཇིགས་སྐྲག་ཏུ་འཆར་བའི་ཚེ་གཅེས་པར་བསྐྱངས་འེ་། འགྲེལ་པའི་ལུས་ནི་ཐ་གུས་བཅིངས།",
    "སྐད་ཅིག་དུས་ཆ་གཉིས་སུ་འགྱུར།",
    "བཞོན་པ་དབུལ་བ་དང་རང་ཡང་ཞབས་འབྲིང་དུ་འགྲོ་། པའི་ཚེ་ན་ལམ་ཕྱགས་དར་བྱེད་པ་དང་།",
    "སྐུ་དྲུང་དུ་ངོ་ཟུམ་གནག་ཅིང་ངམ་ནག་ནག་བྱས་ནས་སྔ་འགྱུར་བཀའ་མ་པའདུག་པ་དང་།",
    "ཏིང་ངེ་འཛིན་གྱི་སེམས་གཞན་དུ་མི་གཡེང་བར་བྱེདབཏང་སྙོམས་ཀྱིས་སེམས་བྱིང་མརི་ཉིས་རྒོད་མེད་པར་རྣལ་དུ་འདུག་པར་བྱེད་དོ།",
    "དེ་ལྟར་ཉམས་སུ་བླངས་པས་ཐ་སྙད་དུ་བླང་དོར་གྱི་སྒོ་ནས་ལམ་སྒྲུབ་པ་ཐམས་ཅད་ལ་འཁོར་གསུམ་དུ་ཞེན་པ་དང་བྲལ་བས་ཡེ་ཤེས་ཀྱི་ཚོགས་རྫོགས་ཤིང་རང་བཞིན་ཡེ་ལ་བསམས་༤༤ཁཎ།",
    "༡ སྐབས་གཉིས་རིང་གནང་འདུག་ཕྱི་ལོ་༡༩༩༤ ནས་༡༩༧།",
    "ཚོགས་མིའང་འབོར་ཆེན་གསར་བཙུགས་ཐུབ་པ་བྱུང་ཐོག་ཕྱོགས་ཐོན་གྱིས་ཞལ་འདེབས་བསྡུ་རུབ་བྱས་ནས་ལག་ཡོང་མི་ཉུང་བ་ཞིག་བྱུང་འདུག།",
    "ཡང་དེ་སྔ་ནས་ཟས་དོད་༣༥ ནས་༧ སྤར་འདུག་ཀྱང་།",
    "སྐབས་སྔ་ཕྱིའི་རྒྱུན་ལས་རྣམས་ཀྱི་མཚན་གཞུང་དང་ལས་གནས་མི་འདུག་པས།",
    "སྐབས་དེར་ཚོགས་མི་གསར་བཞུགས་ཀྱི་ལོ་དུས་ཚེས་གྲངས་གཏན་འཁེལ་མེད་པར་ག་དུས་ཡིན་ཡང་འཛུལ་ཆོག་པར་བྱེད་འདུག་ལ།",
    "རྒྱུ་རྐྱེན་ཁ་གསལ་མི་ལྡན་ནའང་རང་བཞིན་སྟབས་ལེགས་ཀྱིས་བྱུང་བ།",
    "འཛམ་གླིང་རང་ལུས་འདོམ་གང་གྲུ་བཞི་སྟེ།",
    "ལོ་ཟླ་ཞག་དུས་ཆུ་ཚོད་དང་།",
    "བཙས་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་དང་།",
    "ཕན་ཚུན་འགལ་ཟླར་གྱུར་པས་རྒྱལ་ཁབ་སུ་ལ་ཡང་རང་ཉིད་ཀྱི་འདོད་དོན་བསྒྲུབ་རྒྱུའམ།",
    "འགྲོ་འདུག་སྤྱོད་གསུམ་གྱི་གཤིས་ལུགས།",
    "བཙས་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་དང་གཟའ་སྐར་སོགས་ལ་བསྐོར་པའི་རྩིས།",
    "མིའི་འདུག་གནས་སམ་དངོས་རྫས་འཇོག་སའི་རྩིག་དངོས་ཀྱི་མིང་།",
    "ཡུན་རིང་རང་ཉིད་གང་ལ་འདྲིས་པའི་འཛིན་སྟངས་བློས་མི་གཏོང་མཁན།",
    "དུས་བཀག་བཅོལ་འཇོག་དུས་ཡུན་རྒྱས་བཅད་ལྟར་གཏན་འཁེལ་གྱི་སྐྱེད་ཁ་འཐོབ་རྒྱུ་ཡོད་པའི་དངུལ་ཁང་སོགས་སུ་དངུལ་བཅོལ་འཇོག་བྱེད་སྟངས།",
    "དེ་ནི་སྤྱིར་བཏང་རང་བྱུང་གཏེར་དངོས་ཀྱི་ཚུལ་དུ་བྱུང་བ་མ་ཟད་བཟོ་སྐྲུན་བྱས་པའང་ཡོད།",
    "ཚོང་ལས་ནང་ཉོ་ཚོང་བྱས་པའི་ཅ་དངོས་གང་ཞིག་དུས་ཚོད་ངེས་ཅན་བར་ལོངས་སུ་སྤྱོད་ཐུབ་རྒྱུའི་ཁས་ལེན་དང་།",
    "ད་ལྟའི་སྐྱིད་སྡུག་བཙས་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་དང་གཟའ་སྐར་སོགས་ལ་བསྐོར་པའི་རྩིས་འབྲས།",
    "ཕྱི་སྐོགས་འདུག་ན་ཕྲལ་ནས་བརྟགས།",
    "ལྟ་ཞིབ་ཙམ་གྱི་ཆེད་ངོ་བཅར་ཞུ་མཁན་གྱི་གང་ཟག་དུས་ཡོལ་ཟིན་པ།",
    "རློན་པའི་སྟེང་དུ་ཉལ་བའམ་འདུག་དྲགས་པ།",
    "གང་ཟག་གང་ཞིག་དུས་མཚམས་ངེས་ཅན་ཞིག་ལ་དེའི་ཚབ་ཏུ་གཞན་ཞིག་བཀོལ་སྟངས།",
    "རང་ཉིད་དང་རང་ཉིད་ཀྱི་འཇོན་ཐང་ལ་ཡིད་ཆེས་དང་གདེང་སྤོབས་ཡོད་པ།",
