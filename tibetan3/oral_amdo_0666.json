    "ཆགས་སོགས་ཧ་ཅང་ཤས་ཆེ་བས་དང་པོར་སྤྱད་པ་རྣམ་སྦྱོང་གི་དམིགས་པ་སྐབས་སུ་གང་བབ་ལ་གཙོ་བོར་བརྟེན་ནས་མོས་པ་ཡིད་བྱེད་ཙམ་གྱིས་ཀྱང་དེ་དག་གིས་ངར་མ་བཅག་པར་དང་པོ་ནས་གཞན་ཁོ་ན་ལ་བརྟེན་ན་ཞི་ལྷག་རྗེས་མཐུན་པའང་འགྲུབ་དཀའ་སྟེ།",
    "དམིགས་པ་དེ་ལ་གང་གིས་སེམས་འཇོག་པ།",
    "རང་གི་སྒྲུབ་ཁང་གི་ནང་དཀར་གསལ་ཆུང་བར་བྱས་ཏེ་སྐར་ཁུང་ཆུང་ངུ་བཞག་སྟེ།",
    "དེ་གང་བྱེད་ཀྱང་དེའི་ཚེ་ཁ་དོག་དབྱིབས་ཆེ་ཆུང་གྲངས་སོགས་སྔར་རང་གིས་གང་བསམ་དེ་ལས་གཞན་ཤར་བྱུང་ན་དེའི་རྗེས་སུ་མི་འབྲང་བར་ཐོག་མའི་དེ་ལ་དམིགས་དགོས་ཤིང་།",
    "ཡིད་ནི་ཉོན་མོངས་འཁྲིགས་པར་འགྱུར་ཏེ་འགྲུབ་དཀའ།",
    "དེ་ཙམ་ལ་རེ་ཞིག་ཆོག་ཤེས་བྱས་ནས་དེ་ལ་སེམས་བཟུང་སྟེ་བློ་དེའི་རྒྱུན་བར་མ་ཆད་དུ་བསྐྱངས་པས་ཅུང་ཟད་བརྟན་པའི་གནས་ཆ་ཙམ་བྱུང་བ་ན།",
    "དེ་ཡང་སྐུའི་ཆ་ཕྲ་རགས་གཉིས་ལས་ཕྱི་མ་འཆར་སླ་བས་རེ་ཞིག་དེ་ལ་དམིགས་ལ་རྒྱུན་དུ་སྤྱི་ལ་འཛིན་ཞིང་།",
    "ཡང་ཆ་ཤས་འགའ་ཞིག་གསལ་བར་འཆར་ན་སྐུ་སྤྱི་ཡིད་ཡུལ་ནས་མ་ཤོར་པའི་ངང་ནས་ཆ་ཤས་དེ་ལའང་སེམས་བཟུང་ལ་དེ་མི་གསལ་བར་སོང་།",
    "དེས་ན་དེའི་གཉེན་པོར་དམིགས་རྟེན་ལ་སེམས་བཞག་མ་ཐག་འདི་ལྟར་དམིགས་པར་བཞག་གོ་སྙམ་ཏུ་བསམ་པ་ཆ་ཕྲ་མོ་ཞིག་བསྐྱེད་ལ།",
    "དེ་དག་གི་གཉེན་པོར་དེ་དག་བྱུང་མ་བྱུང་དང་དམིགས་པ་དེ་བློའི་ཡུལ་ནས་ཤོར་མ་ཤོར་སོགས་བལྟས་ཏེ་ཤེས་པར་བྱ་བའི་ཤེས་བཞིན་བསྟེན་དགོས་ལ།",
    "དམིགས་པའམ་མྱོང་བ་གསལ་ཙམ་རིག་ཙམ་སོགས་འཛིན་རྣམ་ལ་དམིགས་ནས་དྲན་པ་བསྟེན་པའི་ངང་ནས་སེམས་དམིགས་པ་ལས་གཞན་དུ་འཕྲོ་མི་འཕྲོ་ལ་སེམས་ཀྱི་ཟུར་ཕྲ་མོ་ཞིག་གིས་སོ་ལྟ་བ་ལྟར་བྱ་ར་ཡང་ཡང་བྱས་ཏེ་སེམས་འཛིན་པ་ནི་ཤེས་བཞིན་སྐྱོང་ཚུལ་ཐུན་མོང་མ་ཡིན་པ་དངོས་ཡིན་ཏེ་གཙོ་བོར་བྱིང་རྒོད་འགོག།",
    "དེ་ལ་སེམས་ནང་དུ་ཧ་ཅང་བསྡུས་པས་སེམས་ཀྱིས་དམིགས་པ་འཛིན་པའི་འཛིན་སྟངས་ཀྱི་ངར་ལྷོད་དེ་འཕང་དམའ་རུ་སོང་ནས་ལ་འ་ས་གསདྭངས་གསལ་གྱི་ཆ་གཉིས་ཀ་ཡོད་ཀྱང་དམ་པར་མི་འཛིན་པས་ངེས་ཤེས་དམ་སྦྲེང་ངེ་དེ་ལས་ཞན་དུ་སོང་བ་ཕྲ་མོ་ཡིན་ལ།",
    "སེམས་དམིགས་པར་གནས་ཀྱང་འཛིན་སྟངས་ཧར་གྱིས་ཤོར་ནས་དྭངས་ཆའང་མེད་ཅིང་དྲན་པའི་ཤུགས་ཀྱང་ཞན་དུ་སོང་སྟེ་མུན་པར་གནས་པ་ལྟ་བུ་ནི་ཆེས་རགས་པ་ཡིན་ཏེ།",
    "དཔེར་ན་སོར་མོས་དངོས་པོ་ཤིན་ཏུ་ནོན་དཀའ་བ་ཞིག་མནན་པའི་བར་སྐབས་ཤིག་ཏུ་དམ་སྦྲེང་ངེ་བའི་ཤུགས་ཞན་དུ་སོང་བ་དང་དེ་ཤོར་ལ་ཁད་པ་དང་ཤོར་པའང་མི་ཚོར་བ་སྲིད་པ་བཞིན་ནོ།",
    "དེ་དག་གི་གཉེན་པོར་དམིགས་པ་ཅུང་ཟད་སྤྲོས་ཏེ་སེམས་རྒྱ་ཆེ་བར་གཟེངས་བསྟོད་པས་བྱིང་བ་ལས་སེམས་ཅུང་ཟད་འཕྲོ་བར་བྱས་ལ་བསྒོམ།",
    "ཡང་ན་གཅོད་ཀྱི་དབྱིངས་རིག་བསྲེས་པ་ལྟར་དུ་རང་གི་ལྟེ་བར་ཐིག་ལེ་དཀར་དམར་ལྕོག་སྒོང་ཙམ་ཞིག་གསལ་བཏབ་ལ།",
    "སྤྱོད་ལམ་ཡང་འགྲོ་འཆག་དང་ཕྱོགས་དང་ཟླ་སྐར་སྒྲོན་མེ་སོགས་ལ་བལྟ་བ་ཆུ་གྲང་གིས་ཁྲུས་བྱེད་པ་གོས་སྲབ་མོ་གྱོན་པ་སོགས་དང་།",
    "རྒོད་པ་ལའང་འདོད་པའི་ཡུལ་ཡིད་དུ་འོང་བའི་རྣམ་པ་འཆར་ལ་ཁད་པ་ཕྲ་མོ་དང་།",
    "ཡང་ཉོན་མོངས་ཅན་གྱི་འདུན་པ་དང་འདོད་པ་གཉིས་སམ་ཡུལ་ལྔ་ལ་ཆགས་པའི་ལྔ་ཡོད་དོ།",
    "དེ་དག་གི་གཉེན་པོར་སེམས་ནང་དུ་བསྡུས་ནས་དམིགས་པར་གླན་པ་སྟེ་དམིགས་པ་ལ་གསལ་ངར་བཏོན་ཅིང་དྲན་པས་དམ་པར་འཛིན་པ་དང་།",
    "ཡང་དེ་དག་གི་གཉེན་པོར།",
    "བརྩོན་འགྲུས་རྣམས་ཀྱང་ཉམས་པར་གྱུར་ཏ་རེ།",
    "དེའང་དང་པོར་བསྒྲིམས་ཏེ་འཇུག་པའི་ཡིད་བྱེད་ཀྱིསསྐབས་ཡིན་པས་བྱིང་རྒོད་གཡེངས་པ་སོགས་ཕྲ་མོ་ཙམ་ཡན་ཆད་ཀྱང་རིག་ནས་དེ་མ་བསལ་ན་ལང་ལ་ཤོར་ནས་འགོག་མི་ནུས་སོ།",
    "གནས་ཆ་ཅུང་ཟད་བྱུང་རེས་ཀྱིས་བྱིང་ཟོན་བྱས་ནས་གསལ་ངར་འདོན་པ་སྟེ།",
    "དེ་གཉིས་རེས་མོས་ཀྱིས་གནས་ཆ་དང་གསལ་ངར་ལྡན་པ་གཉིས་ཚོགས་འབྱུང་ཕྱིར་འབད་དགོས་སོ།",
    "དེ་ལྟར་མིན་པར་སྔར་བོད་ཀྱི་སྒོམ་ཆེན་དུ་རློམ་པ་འགའ་ཞིག་གིས།",
    "ཅེས་གསུངས་པའི་ཚིག་ཟིན་ཙམ་ལ་འཁྲུལ་ནས་ཧ་ཅང་གློད་དྲགས་པས་བྱིང་བ་ཕྲ་མོའི་མུན་ཁུང་ནས་ཚེ་ཟད་པ་མི་ཚོར་བ་དང་།",
    "བདག་གི་མི་བརྟན་ཞིང་ཉོན་མོངས་ཀྱིས་སེམས་དཀྲུགས་པས་ནི་ཅི་ཞིག་བགྱི།",
    "དེ་ལྟར་བསྐྱངས་པས་དང་པོར་བྱིང་རྒོད་ཀྱི་དཔལ་ཆོགས་ཤིང་མཐར་དེ་གཉིས་ཀྱིམཐའ་ཕྲ་མོ་དང་ཡང་བྲལ་ཏེ་སེམས་དམིགས་པ་ལ་མཉམ་པར་རྒྱུན་ཆགས་སུ་གནས་ཐུབ་པའི་དབུས་རྙེད་པའི་མཚམས་ནས་སྔར་ལྟར་སེམས་གཟེངས་བསྟོད་༡ཡཔ་དང་ནང་དུ་འགུགས་པའི་བྱིང་རྒོད་ཀྱི་ཟོན་ཧ་ཅང་བྱེད་ཆེ་བ་འདུ་བྱེད་པའམ་རྩོལ་ཆེ་ན་དེ་ཉེས་པ་ཡིན་ཏེ་དེས་སེམས་གཡེང་བར་འགྱུར་རོ།",
    "ཆ་དག་གིས་ནི་བཀྲུ་བར་བྱ།",
    "དལ་འགྱུར་ཏིང་འཛིན་ཉོན་མོངས་སྲུང་།",
    "འགའ་ཞིག་གིས་སེམས་གནས་དགུ་པ་ཐོབ་མ་ཐག་ནས་རྗེས་མཐུན་པ་དང་།",
    "སྤྱིར་ཞི་ལྷག་རྗེས་མཐུན་དང་དངོས་གཞི་ནི་བསམ་གཏན་དང་པོའི་ཉེར་བསྡོགས་དང་དངོས་གཞིར་སྦྱར་ནས་སྦྱོར་བྱུང་གི་སྒོ་ནས་ཐོབ་ཚུལ་གྱི་རིམ་པ་ནི།",
    "ཉོན་མོངས་རྣམ་སྦྱོང་གི་ལས་དང་པོ་བའི་ཡིད་ལ་བྱེད་པ་གསུམ་ལས།",
    "གསུམ་པ་ནི་དེ་ཐོབ་ནས་མོས་པ་ཡིད་བྱེད་མ་ཐོབ་ཀྱི་བར་གྱི་ཞི་གནས་ཏེ།",
    "མོས་པ།",
    "མོས་པ་ཡིད་བྱེད་ནི་ཉོན་མོངས་རྣམ་སྦྱོང་གི་ཡིད་བྱེད་དང་པོ་སྟེ་འདི་ནས་བཟུང་ལྷག་མཐོང་དངོས་ཀྱང་ཐོབ་ཅིང་།",
    "འདི་མན་ཆད་ཀྱི་ལྔ་པོ་ཉོན་མོངས་རྣམ་སྦྱོང་གི་ཡིད་བྱེད་ཡིན་ནོ།",
    "ཡང་དེ་དག་ལ་འཇིག་རྟེན་པའི་ལམ་དང་འདས་ལམ་གཉིས་རེ་ཡོད་དོ།",
    "རང་རྒྱུད་ཐོག་མེད་ནས་ཉོན་མོངས་པའི་ཕྱོགས་ལ་གོམས་ཆེ་བས་གང་ལའང་འབད་རྩོལ་དྲག་པོ་མ་བྱས་པར་ཉིན་རེ་ལ་ཐུན་གཅིག་གཉིས་ཙམ་བསྐྱངས་པས།",
    "ཉོན་མོངས་ནིམ་པ་ཁ་བའི་ཁུ་བས་རླན་བསྒོས་ཞིན་པ།",
    "མངར་བའི་ཆུ་ཐིགས་རེ་རེས་རོ་ཞིམ་དངོས་པོར་བགྱི་བརམི་ནུས་ལྟར།",
    "དཔེར་ན་གཙུབ་ཤིང་གཙུབས་ནས་མེ་འདོན་པར་འདོད་པས་ཅུང་ཟད་རེ་གཙུབས་ནས་ཡང་ཡང་ངལ་གསོས་ན་མེ་ཐོན་མི་སྲིད་པས་མེ་མ་བྱུང་བར་དུ་རྒྱུན་མ་ཆད་པར་གཙུབ་དགོས་ལ།",
    "ཞི་གནས་དང་པོར་བསྒོམ་མ་ཐག་ཏུ་ཉམས་རྟོགས་གང་ཡང་མེད་ཀྱང་བདུན་རེ་གཉིས་ལ་འབད་ནས་བསྒོམས་པས་དང་པོར་སེམས་ཅུང་ཟད་གནས་པ་འབྱུང་ཞིང་།",
    "བདག་གིས་སེམས་མཉམ་པར་བཞག་པར་བྱ།",
    "ཞི་ལྷག་གི་རྣལ་འབྱོར་ཚུལ་ལའང་དེ་བཞིན་དུ།",
    "དུས་ཡུན་ཐུང་གིས་འཁྲུལ་བ་མི་ཆོད་ཀྱི།",
    "མཉམ་རྗེས་དེ་ཟུང་ལ་ཐུན་མོང་དུ་ཉེར་མཁོའི་རིམ་པ་བསྡུས་ཏེ་མགོ་སྨོས་ཙམ་བྱེད་པའོ།",
    "ཐལ་འགྱུར་བའི་ཐུན་མོང་མ་ཡིན་པའི་ལྟ་བ་རྣམ་དག་འཚོལ་ཚུལ་ནི།",
    "དང་པོར་གང་ཟག་གི་བདག་མེད་བཙལ་ནས་བསྒོམས་ཤིང་།",
    "ཇི་ལྟར་ཁྱོད་ཀྱིས་བདག་གི་འདུ་ཤེས་ནི།",
    "སྔོན་དུ་གང་ཟག་གི་བདག་མེད་ཀྱི་ལྟ་བ་བསྐྱེད་ནས།",
    "དེ་ལ་ཡང་དགེ་སྡིག་གི་རྣམ་དབྱེ་གང་ཡང་མཁ་༡༣༣ ཡམི་ཤེས་པར་ཚེ་འདི་ཁོ་ནའི་ལུང་རིགས་གང་ཡང་ཁས་མི་ལེན་པའི་མི་ཕལ་བའི་ཕལ་བ་སེམས་དུད་འགྲོ་དང་ཁྱད་པར་ཆེར་མེད་པ་ནི་འདིར་བརྗོད་པར་བྱ་བ་མིན་ལ།",
    "དེ་ལྟར་ན་ཕྱི་རོལ་བའི་རྟགས་སྨྲ་བ་ནས་ཐལ་འགྱུར་བའི་བར་ཐམས་ཅད་ཀྱི་ལས་འབྲས་ཀྱི་འབྲེལ་བའི་རྟེན་དུ་ངའམ་བདག་ཅེས་བྱ་བ་ཁས་ལེན་ཡང་ལེན་ཚུལ་མི་འདྲ་སྟེ།",
    "ཆད་སྨྲ་བ་མ་ཟད་རྟག་སྨྲ་སྐྱེ་བ་སྔ་ཕྱི་ཁས་ལེན་པ་དག་གིས་ཀྱང་ངའམ་བདག་ནི།",
    "དེ་དག་གིས་ཀྱང་བདག་ལྟ་དང་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་གཉིས་ཀྱི་དམིགས་ཡུལ་ལམ་རྟེན་དུ་བདག་ཡ་འཇོག་ཚུལ་མི་མཐུན་མོད་ཀྱང་།",
    "ཞེས་པ་ལྟར་རང་རྒྱུད་པ་མན་ཆད་ཀྱིས་རང་རང་གི་ཕུང་བོ་སྤྱིའམ་དེའི་ཆ་ཤས་འགའ་ཞིག་སོགས་བདག་ལྟ་དང་བདག་མེད་ཀྱི་ལྟ་བའི་རྟེན་དུ་འདོད་ལ།",
    "དེ་ཡང་མང་བཀུར་བ་ཁ་ཅིག་གིས་ཕུང་བོ་ལྔ་ཆར་གྱི་ཚོགས་པ་གང་ཟག་ཏུ་དང་།",
    "ཁ་ཅིག་གིས་གང་ཟག་གི་གདགས་གཞི་ལ་ཕུང་བོ་ལྔ་ཡོད་ཀྱང་དེའི་ནང་ནས་སེམས་གཅིག་པུ་དང་།",
    "འདི་ལྟར་ཁོ་བོ་ཅག་ཀྱང་ཐ་སྙད་དུ་རྣམ་པར་ཤེས་པ་ལ་གང་ཟག་གི་སྒྲ་དངོས་སུ་འདོགས་ཏེ།",
    "འགའ་ཞིག་གིས་ཕུང་བོའི་བཀོད་པ་ཙམ་གང་ཟག་ཏུ་འཇོག་ལ།",
    "དགེ་སློང་དག་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་གང་སུ་དག་ཅིག་བདག་དང་བདག་གིར་ལྟ་བ་འདི་ནི་ཕུང་བོ་ལྔ་པོ་འདི་ཁོ་ན་ལ་བལྟའོ།",
    "མཁས་པས་བདག་གི་ཤིན་ཏུ་ནི།",
    "གཞན་ཡང་དེ་སོ་སོས་རང་རང་གིས་འདོད་པའི་བདག་ནི་རྟོག་པས་བཏགས་པ་ཙམ་མ་ཡིན་པར་ཚུར་ལ་རང་བཞིན་གྱིས་གྲུབ་པ་ཞིག་མ་བཞག་ན་ལས་འབྲས་ཀྱིས་འབྲེལ་བའི་རྟེན་དང་བག་ཆགས་བགོ་གཞི་ཆད་པ་སྟེ་མེད་པར་འགྱུར་བར་གོ་བ་སྟེ།",
    "དེ་ལྟ་ན་ཡང་གང་ཟག་གི་རང་ལྡོག་སྤྱི་བཏགས་ཡོད་དུ་འདོད་ཀྱང་གཞི་ལྡོག་བྱེ་བྲག་ནི་རྫས་ཡོད་ཡིན་པ་དང་བདག་ནི་བཏགས་དོན་བཙལ་ཏེ་རྙེད་པ་ཞིག་ལ་འཇོག་པས་ཐལ་འགྱུར་བའི་ལུགས་ལྟར་ན་བཏགས་ཡོད་ཀྱི་དོན་དངོས་ཚང་ངོ།",
    "འོ་ན་ཐལ་འགྱུར་བའི་ཐུན་མོང་མ་ཡིན་པར་འཇིག་ལྟ་སོགས་ཀྱི་དམིགས་ཡུལ་འཇོག་ཚུལ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དེ་ཡང་དཔེར་ན་ཤིང་རྟ་རང་གི་ཡན་ལག་འཕང་ལོ་སོགས་ལ་བརྟེན་ནས་བཏགས་པ་ཙམ་ཡིན་གྱི།",
    "རྣམ་བདུན་གྱི་རིགས་པ་སོགས་ཀྱིས་དཔྱད་དེ་བཙལ་པའི་ཚེ་ན་ཡན་ལག་ཚོགས་པ་དང་རེ་རེ་བ་དང་ཡན་ལག་གི་དབྱིབས་སོགས་གང་ཡང་ཤིང་རྟ་མིན་པ་ལྟར།",
    "ཕུང་བོའི་ཡ་གྱལ་རེ་རེ་བ་དང་།",
    "ཚོགས་ཅན་གྱི་ཕུང་བོ་དང་དེ་དག་གི་རྒྱུན་དང་རྒྱུན་བཅས་དང་།",
    "དེ་ཡང་ཐོག་མར་གདགས་གཞི་ཕུང་བོ་ཚོགས་པ་རྒྱུན་བཅས་སྟེང་དུ་བདག་དང་གང་ཟག་ཅེས་སྒྲས་བཏགས་ཤིང་དེ་ལ་བརྟེན་ནས་གདགས་གཞི་དེ་སྐྱེ་འཕགས་ཀུན་གྱི་ཡིད་ལ་ཤར་བའི་ཚེ་ན་དེ་ལ་བརྟེན་དནས་ངའོ་སྙམ་དུ་ངང་གིས་སྐྱེས་པའི་བློའི་ཡུལ་ཙམ་སྟེ།",
    "དེ་བཞིན་ཁམས་ནི་རེ་རེ་ཡང་།",
