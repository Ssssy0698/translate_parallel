    "སྒྲིམ་གློད་མེད་པར་ལུས་སེམས་གང་བདེར་གཞག།",
    "དྲན་པའི་རྣམ་པར་རྟོག་པ་མི་འབྱུང་སྟེ།",
    "བསམ་གཏན་ལྷ་དང་མཚུངས་པར་རྒྱལ་བས་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "གསུངས།",
    "གང་ཡང་གཞི་གཞག་དགོངས་པར་ཤེས་པར་བྱ།",
    "གང་དུ་འདི་ལྟར་འཇོག་ཅེས་མི་རྟོག་པར།",
    "བདག་ལ་མི་བསམ་གཞན་ལ་མི་རྟོག་པར།",
    "རྒྱུ་འབྲས་ལ་ཟློས་འཁོར་འདས་མཉམ་པར་བརྗོད།",
    "དགོངས་པ་མི་གཡོ་མཉམ་པར་གནས་པ་ཡིན།",
    "གཉིས་སུ་བཟུང་བས་རྒྱུ་འབྲས་སྲིད་པར་འཁྲུལ།",
    "རྩལ་ལས་རོལ་པར་ཤར་དུས་ངོས་བཟུང་ལ།",
    "ཤར་དུས་ངོས་གཟུང་སྤང་བླང་མ་བྱས་པས།",
    "རགས་པར་སྣང་བ་ནུབ་པས་དེར་འཛིན་ནུབ།",
    "ཕྲ་བ་ཆེས་ཕྲ་འཛིན་པར་བཅས་ནུབ་པས།",
    "དུག་གསུམ་རྩལ་ལས་རོལ་པར་ཤར་ཏོ་ཅོག།",
    "དང་བཅོས་བསྒྱུར་གང་ཡང་མི་བྱེད་པར།",
    "རྩལ་ལས་རོལ་པར་ཤར་བའི་ཆོ་འཕྲུལ་ལ།",
    "རྩལ་ལས་རོལ་པར་ཤར་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "གཉིས་ཀ་རྩལ་ལས་རོལ་པར་ཡེ་ཤར་བས།",
    "བང་མཉམ་འགྲོས་མཉམ་གཞི་ནས་གཡོས་པར་མཉམ།",
    "རྐྱེན་བྱུང་འདུས་བྱས་རྒྱུ་འབྲས་མ་འདས་པས།",
