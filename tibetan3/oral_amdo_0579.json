    "དེའི་སྟེང་དུ་ཧཱུྃ་སྟེ་ཡི་གེ་གསུམ་མས་རིམ་གྱིས་གཅིག་ལ་གཅིག་ཐིམ་ནས་ཧཱུྃ་གི་ཐིག་ལེ་ནཱ་དར་གྱུར་པའི་བར་ནི་སྒྲ་ཡིན་ལ།",
    "དེ་རྫོགས་པར་བྱེད་པ་ཡན་ལག་གི་ཀུན་དུ་སྤྱོད་པ་དང་།",
    "དེའི་སྔོན་དུ་རྒྱུའི་ཀུན་སྤྱོད་སྔོན་དུ་སོང་བས་ཉམས་སུ་ལེན་པའི་རྟེན་གྱི་གང་ཟག་བགྲངས་ན་བཞིར་འགྱུར་རོ།",
    "ལྔ་གང་གིས་མྱུར་དུ་ཤེས་འགྱུར་བ།",
    "གཉིས་པ་དེ་རྫོགས་པར་བྱེད་པ་ཡན་ལག་གི་ཀུན་དུ་སྤྱོད་པ་ལ་གསུམ་༣༤༧སྟེ་དང་པོ་གཉིས་རྫོགས་པར་བྱེད་པའི་ཡན་ལག་དང་།",
    "ཕུང་པོ་ཁམས་དང་སྐྱེ་མཆེད་སྦྱང་བསྒྱུར་དང་ཚོགས་གཉིས་བསག་པ་དང་།",
    "ཐུན་མོང་གི་དངོས་གྲུབ་དང་།",
    "མཆོག་གི་དངོས་གྲུབ་དང་།",
    "ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་གསུམ་སྟེ།",
    "འཁོར་ལོ་བདེ་མཆོག་དྷཱི ། གི་ལམ་དང་འབྲས་བུ་མ་ལུས་པ་བསྟན་ཅིང་།",
    "དག་པ་རྗེས་སུ་དྲན་པ་ནི་ཅིག་སྤྱོད་ལམ་གྱི་རྣལ་འབྱོར་གྱི་ཁོངས་སུའང་བསྡུ་མོད་ཀྱི།",
    "འདིར་བསྐྱེད་རིམ་བརྟན་པར་བྱེད་པ་ཡིན་པས་མཉམ་གཞག་གི་ཁོངས་སུ་བསྡུའོ།",
    "བསྡུས་པ་ལ་དགའ་བས་རང་གི་ལུས་ལ་ཇི་ལྟར་གྲུབ་པ་ཙམ་ཞིག་བསྒོམ་བའོ།",
    "རང་གི་ལུས་གདོད་ནས་གྲུབ་པའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་དྲན་པ་དང་།",
    "ཞེས་བརྗོད་ཅིང་དོན་དྲན་པར་བྱ་བ་གསུང་གི་དགའ་བ།",
    "ཧཱུྃ་ནི་གཟུང་འཛིན་གཉིས་དང་བྲལ་བའི་ཡིད་ཡེ་ཤེས་ལྔའི་རང་བཞིན་ནོ་ཞེས་མོས་པ་ནི་ཐུགས་ཀྱི་དགའ་བའོ།",
    "ཞེས་ཅི་ནུས་ཀྱི་མཐར་ཐལ་མོ་སྦྱར་ཏེ།",
    "ཁྱེད་རྣམས་ཀྱིས་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "དེའི་ཆེད་དུ་བདག་གིས་ལམ་ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱིའོ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད་། སྐད་ཅིག་ཉིད་ལ་འཆར་བ་གང་།",
    "བཅུ་ལུ་ཁྲིད་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཅེས་མོས་གུས་དྲག་པོས་གསོལ་བ་བཏབ་པས།",
    "རྒྱུ་ལོང་ལ་སོགས་པ་ནི་གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "ཞལ་རེ་རེ་བཞིན་སྤྱན་གསུམ་གསུམ་དང་ལྡན་ཞིང་མཆེ་བ་བཞི་བཞི་གཙིགས་པ།",
    "བཞི་པ་ན་ཁྲག་གིས་བཀང་བའི་ཐོད་པ།",
    "པདྨ་དང་ཉི་མའི་སྟེང་ན་ཞབས་གཡས་བརྐྱངས་པས་དུས་མཚན་མ་དམར་མོ་དང་།",
    "རལ་པའི་ཐོར་ཚུགས་སྤྱི་བོར་བཅིངས་པའི་རྩེར་ཡིད་བཞིན་གྱི་ནོར་བུས་སྤྲས་ཤིང་གཡོན་ན་ཚེས་གཅིག་གི་ཟླ་བ་དང་མཚོགས་མའི་སྟེང་ན་བཅུ་གཅིག་ཚོགས་རྡོ་རྗེས་མཚན་པ།",
    "དབུ་རེ་རེ་ལ་མི་མགོ་སྐམ་པོ་ལྔ་ལྔས་བརྒྱན་ཅིང་རློན་པ་ལྔ་བཅུའི་དོ་ཤལ་ཅན།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "དེའི་པང་ན་ཡུམ་རྡོ་རྗེ་ཕག་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་མ་སྤྱན་གསུམ་དང་ལྡན་པ།",
    "ཕྱག་གཡོན་ལུ་ཁྲིད་པས་བདུད་དང་གདུག་པའི་ཁྲག་གིས་གང་བའི་ཐོད་པ་འཛིན་པས་ཡབ་ལ་འཁྱུད་པ།",
    "གཡས་པས་སྡིགས་མཛུབ་དང་བཅས་པའི་གྲི་གུག་གིས་ཕྱོགས་ཐམས་ཅད་དུ་བསྡིགས་པ།",
    "ཕྱིའི་ཧེ་རུ་ཀའི་ཕྱག་གཡས་ཀྱི་དང་པོ་ལ་མཁའ་འགྲོ་མ་ནག་མོ།",
    "གཡོན་གྱི་དང་པོ་ལ་ཁཎྜ་རོ་ཧཱ་དམར་མོ།",
    "གཉིས་པ་ལ་གཟུགས་ཅན་མ་སེར་མོ།",
    "གཡས་ཀྱི་གསུམ་པ་ན་ཁ་རྫུན་གསུམ་མ་གསུམ་པ་ན་ཁྲ་གདོང་མ་སྔོན་མོ།",
    "ལྔ་པ་ན་ཁྱི་གདོང་མ་དམར་མོ།",
    "དྲུག་པ་ན་ཕག་གདོང་མ་སེར་མོ།",
    "བཞི་པ་ན་གཤིན་རྗེ་ཕོ་ཉ་མོ་གཡས་སེར་གཡོན་དམར་བ།",
    "སྤྱི་བོ་པུལླི་ར་མཱ་ལ་ཡར་ཁཎྜ་ཀ་པཱ་ལི་དང་རབ་ཏུ་གཏུམ་མོ།",
    "རྣ་བ་གཡོན་པ་གོ་དཱ་ཝ་རཱིར་སུ་ཝཱི་རེ་དང་བརྟན་པའི་བློ་ཅན་མ།",
    "མཆན་ཁུང་གཉིས་ཀ་མ་རཱུ་པར་ཨདྨ་རི་དང་ཨེ་རཱ་ཝ་ཏཱི་ནུ་མ་གཉིས་ཨོ་ཏྲེར་རྡོ་རྗེ་རལ་པ་ཅན་དང་འཇིགས་བྱེད་ཆེན་མོ་སྟེ་ཞིང་།",
    "མགྲིན་པ་ལམ་ཀར་རྡོ་རྗེ་བཟང་པོ་དང་ཤིན་ཏུ་བཟང་མོ་སྟེ་ཚནོ།",
    "འདོམས་བར་ཧི་མཱ་ལ་ཡར་མིག་མི་བཟང་དང་ཁ་གཱ་ན་ན་སྟེ་ཉེ་བའི་ཚནྡོ་རྣམས་གསུང་གི་འཁོར་ལོ་ཁ་དོག་དམར་པོ་ས་ལ་སྤྱོད་པའོ།",
    "སོར་མོ་བཅུ་དྲུག་ནཱ་ག་རར་དཔལ་ཧེ་རུ་ཀ་དང་ཤིན་ཏུ་དཔའ་མོ།",
    "པུས་མོ་གཉིས་ཀུ་ལུ་ཏཱར་རྡོ་རྗེ་སེམས་དཔའ་དང་བརྩོན་འགྲུས་ཆེན་མོ་སྟེ་ཉེ་བའི་དུར་ཁྲོད་རྣམས་སྐུའི་འཁོར་ལོ་ཁ་དོག་དཀར་པོ་ས་འོག་ན་སྤྱོད་པའོ།",
    "སྐུ་ལ་ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་པ་གཡས་བརྐྱང་བའི་གནས་པས་བཞུགས་པའོ།",
    "རབ་ཏུ་གཏུམ་མོ་ལ་སོགས་པའི་དཔའ་མོ་རྣམས་ནི་ཞལ་གཅིག་ཕྱག་གཉིས་མ་གཡོན་ཐོད་པ་བསྣམས་པས་ཡབ་ལ་འཁྱུད་པ།",
    "སྤྱན་གསུམ་མ་དྲག་མོའི་གཟུགས་ཅན་མ།",
    "ཧཱུྃ་སརྦ་བཱི་ར་ཡོ་གི་ནི་ཀཱ་ཡ་ཝཱ་ཀ་ཙིཏྟ་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོ་ཉཧཾ།",
    "ཞེས་བརྗོད་པས་བདག་གིས་བསྒོམས་པའི་ལུས་དཀྱིལ་དང་།",
    "དཔའ་བོ་དང་དཔའ་མོའི་ཉེར་བཞི།",
    "ཡབ་ཀྱི་རྐང་བརྒྱད་དང་སྒོ་མཚམས་མ་བརྒྱུད་རྣམས་སྤེལ་བའི་སྔགས་ལན་རེ་བརྗོད་པས་ལྷ་གསལ་གདབ་པའི་ཚུལ་གྱིས་མཆོད།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཤྲཱི་ཙཀྲ་སམྦ་ར་མཎྜལ་ཙཀྲ་སརྦ་བཱི་ར་ཡོ་གི་ནི་ཨབྷཾ་པྲ་ཏཱི་ཙྪ་སྭཱ་ཧཱ།",
    "སརྦ་བུདྡྷ་ཀྵེ་ཏྲ།",
    "རང་གི་ལྕེ་རྩེ།",
    "རང་གི་ལྕེ་ལ་བདུད་རྩི་མྱངས་པས་ཕྱི་ནང་གི་ལྷ་ཐམས་ཅད་དགྱེས་ཤིང་།",
    "རིན་ཆེན་བཞི་པོ་གང་མོས་པ་གཉིས་མེད་དུ་བཟླ་བར་གསུངས་པས།",
    "མཐར་ཐལ་མོ་སྦྱར་ཏེ།",
    "མྱུར་དུ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་གོ་འཕང་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "རང་གི་ལྟེ་བར་པད་ཟླའི་སྟེང་དུ་ཧཱུྃ་ལས་རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ་རྡོར་དྲིལ་འཛིན་ཅིང་།",
    "དྷཱི ། ཡུམ་རྡོ་རྗེ་སྙེམས་མ་དཀར་མོ་གྲི་ཐོད་འཛིན་པ་དང་མཉམ་པར་སྦྱོར་བ།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱི་ནང་གི་ལྷ་ཐམས་ཡཅད་དང་།",
    "སླར་ཡང་རང་བཅུ་དྲུག་སྐད་ཅིག་གིས་ཧེ་རུ་ཀ་ཡབ་ཡུམ་ལུས་དཀྱིལ་གྱི་ལྷ་དང་བཅས་པའི་སྐུར་གྱུར་པར་བསམས་ལ་དག་དྲན་རྒྱས་བསྡུས་གང་རུང་བྱའོ།",
    "རང་གི་གནས་རྣམས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེའི་སྟེང་དུ།",
    "ཚིགས་ཆེན་༣༢༨བརྒྱད་ལ་ཕཊ་ཧཾ་ལྗང་གུ་རྟ་མཆོག་གི་ངོ་བོ།",
    "ཡུམ་གྱི་ལྟེ་བར་ཨོ་བོ་དམར་མོ་རྡོ་རྗེ་ཕག་མོ།",
    "ཁར་ཧྲི་མཾ་དཀར་མོ་རྨོངས་བྱེད་མ།",
    "སྤྱི་བོར་ཧྲེ་ཧྲི་སེར་མོ་སྐྱོད་བྱེད་མ།",
    "ཚིགས་ཆེན་བརྒྱད་ལ་ཕཊ་ཕཊ་དུད་ཀ་ཙཎྜི་ཀའི་ངོ་བོར་མོས་པ་ནི་ཡབ་ཡུམ་གྱི་གོ་ཆ་དང་།",
    "པུ་ཛཱ་སོགས་ཉེར་བཞི་བརྗོད་པས་ལུས་དཀྱིལ་གྱི་ལྷ་རྣམས་རང་རང་གི་གནས་སུ་ཐིམ་པར་ལ་མའི་སྔགས་བརྗོད་ཅིང་བསམ་པ་ནི་གོ་ཆ་ཆེན་པོ་དང་།",
    "རོལ་མོ་གླུ་དབྱངས་སིལ་སྙན་སོགས་མཆོད་རོལ་མོ་གླུ་དབྱངས་སིལ་སྙན་སག་མ་ནས་། མཁའ་ལ་སྤྱོད་པའི་གནས་སུ་འཁྲིད་པར་ཤོག།",
    "བདེན་པ་དེས་ཀྱང་ལྷ་མོ་དེ་དག་གིས།",
    "ཐོད་པ་ལ་སོགས་པའི་སྣོད་དུ་ཤ་ཆང་གི་དམ་འཛིན་པའི་བར་མ་ཆགསརྫས་དང་བཅས་པའི་གཏོར་མ་བཤམ།",
    "དེ་ལཱུ་ཁྲིད་ནས་ལྷ་ཐམས་ཅད་ཀྱི་ལྗགས་ལ་ཧཱུྃ་ལས་རྡོ་རྗེ་སྦུ་གུ་ཅན་ཧཱུྃ་གིས་མཚན་པ་བསམ།",
    "གཏོར་མ་ལས་ཐོད་པ་བདུད་རྩིས་གང་བ་དུ་མ་ཆད་དེ་ཐམས་ཅད་ཀྱི་ཕྱག་ཏུ་བཞག་པས་གསོལ་བར་བསམ་ཞིང་ལག་པ་རྡོ་རྗེ་ཐལ་མོ་ཁ་༣༥༩ཕྱེ་ལ།",
    "ཕྱི་ནང་གིས་མཆོད།",
    "ཁ་ཟས་ལ་ལག་པ་གཡོན་པའི་མཐེབ་སྲིན་གྱིས་རེག་སྟེ།",
    "ཨོ་ཨཱཧཱུྃ་ཞེས་བརྗོད་པས་བདུད་རྩིའི་རང་བཞིན་དུ་བརླབས་ལ་ནང་གི་སྦྱིན་སྲེག་གི་ཚུལ་དུ་ཚིམ་པར་རོལ་པའི་མཐར་བདག་མེད་པའི་ངང་དུ་ངལ་བསོ།",
    "ནུབ་མོ་ཉལ་བའི་ཚེ་རྡོ་རྗེ་སེམས་དཔའ་བསྡུ་བའི་རིམ་པས་འོད་གསལ་ལ་འཇུག།",
    "འདིར་གཞུང་གི་དངོས་བསྟན་བསྡུ་བ་གསུམ་གྱི་རྫོགས་རིམ་ཅུང་ཟད་བརྗོད་ན་གསུམ།",
    "ཡི་གེ་མཆོག་གི་གནས་གྱུར་པ།",
    "ཡན་ལག་གི་དཔེ་དུ་མས་མཚོན་པ་སྟེ།",
    "ཧཱུྃ་གི་གདན་ཟླ་བ་ཞབས་ཀྱུ་ལ།",
    "དེ་ནས་ཡན་ལག་གི་དཔེ་ནི་ངོ་བོ་ཉིད་ཀྱི་སྟེང་དུ་གཏན་ལ་དབབ་སྟེ།",
    "གོང་གི་སྤྲོས་པ་རྣམས་ནི་ཆ་ལུགས་སམ།",
    "མར་ལ་མར་བཞག་པ་སྟེ་ཡན་ལག་གི་དཔེ་ལྔས་མཚོན་པ་ཡིན་ནོ།",
    "དང་པོ་བདག་གི་བློ་སྣང་གི་དཀྱིལ་འཁོར་ནི་ཞིང་སྐྱེས་ཀྱིས་སྤྲུལ་ལ།",
    "འབྲིང་གི་རབ་མཁའ་སྤྱོད་ཀྱི་རིག་པ་འཛིན་པ་ཐོབ་པར་འགྱུར་བ་ནི་གནས་སྐབས་ཀྱི་འབྲས་བུ་ཡིན་ལ།",
    "རྣལ་འབྱོར་གསང་མཐའ་འཁོར་ལོ་བདེ་མཆོག་གི།",
    "ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་བརྙེས་པའི་གྲུབ་ཆེན་ལཱུ་ཨི་པ།",
    "ཐེག་ཆེན་པ་གཉིས་ཀྱི་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པས་རྒྱུད་སྦྱང་བ་དང་།",
    "དེ་ལྟ་མིན་པའི་བསྐྱེད་རིམ་ལམ་དུ་སློབ་པ་སྔར་སོང་བ་ཡིན་ན།",
    "རྗེས་གཞིག་གི་རིམ་པའི་བསམ་གཏན་སྒོམ་ཚུལ་ལོ།",
    "ལྕེའི་རྩེ་མོ་ཅུང་ཟད་གྱེན་དུ་ལྡོག།",
    "ལག་པ་གཉིས་མཉམ་གཞག་གི་ཕྱག་རྒྱ་བྱའོ།",
    "ཕྱི་དྲོ་མེའི་དུས་སུ་བསྒོམ་མོ།",
    "གསུམ་བཞི་པ་ལ་རྩ་འདབ་རེ་བཞི་པ་ཞིག་ཡོད་པའི་འཁོར་ལོའི་དབུས་དྲང་པོ་ན།",
    "མུ་ཏིག་གི་རྡོག་པོ་ལ་སིན་རས་བྱུགས་པ་ལྟ་བུའི་ཧཱུཾ་ཡིག་ཤིན་ཏུ་གསལ་ཞིང་འཚེར་བའི་ཐིག་ལེའི་སྟེང་ན།",
    "དེ་ལྟར་མི་ནུས་ན་རེ་ཞིག་ཆེ་བ་ལ་སེམས་གཏད་ལ།",
    "དེ་དང་དབྱེར་མེད་དུ་སོང་བ་ལྟར་བྱས་ནས་འཛིན་པར་གསུངས་པས།",
    "འདི་ལྟར་བསྐྱངས་པས་སེམས་རྒོད་པ་ཕྲ་མོ་དང་ཡང་བྲལ་བའི་མི་རྟོག་པ་ཤིན་ཏུ་མཐུག་པ་དང་།",
    "བྱིང་བ་ཕྲ་མོའང་ཆོད་པས་རིག་པ་ངར་དང་ལྡན་པའི་གསལ་དངས་ཆེ་བ་དང་།",
    "ལུས་དང་སེམས་ལ་བདེ་བའི་ཉམས་ཆེ་བ་རྣམས་འབྱུང་མོད་ཀྱང་།",
    "འདི་ཐུན་གཅིག་ནི་ཞག་གཅིག་གི་དྲུག་ཆའོ།",
    "ཐུན་འཁྱོངས་པའི་བརྟན་པ་ནི།",
    "བྱིང་རྒོད་དང་བྲལ་བར་ཐུན་ངེས་ཅན་དུ་འཁྱོངས་པའོ།",
    "ཡང་ན་ལྟེ་བའི་པདྨ་ལ་གནས་པའི་ཉི་མ་དང་ཟླ་བ་བསྐོར་བའི་ནང་ན་ཡོད་པའི་ས་བོན་ཧཱུྃ་ལས་བྱུང་བའི་པདྨའི་རྩ་བ་ལྟར་འོད་ཟེར་གྱི་རི་མོ་ལ་སེམས་བརྟན་པར་བྱེད་པའི་སྒོ་ནས་རྩ་གཉིས་ལ།",
    "གཏུམ་མོ་སྦར་ལས་སྤྱི་བོའི་ཟླ་བ་ཞུ་ནས།",
    "ཐུན་འཁྱོངས་པའི་འོག་ཏུ་རང་གི་སྣ་བུག་གང་རུང་རེ་རེ་བར་རྒྱུ་བའི་འཕོས་མ་༣༦༩ཐག་པའི་སྐབས་ངོས་བཟུང་ལ།",
    "དེའང་ལན་རེ་རེ་གཉིས་གཉིས་ཙམ་ལ་ངེས་པ་མེད་ཀྱི་འགལ་རྐྱེན་གཞན་མེད་ན།",
    "སྣ་བུག་གི་རྒྱུ་བ་ཞན་དུ་སོང་བའི་མཐར་ཞིབ་ཏུ་བརྟགས་པ་ན།",
    "རྒྱུ་བ་ཕྲ་མོའང་ལོག་པ་ཞིག་འོང་།",
    "ལྡོག་ཚུལ་དེ་ངེས་དཀའ་ན་ལུས་དྲང་པོར་གཡོ་འགུལ་མེད་པར་བདེ་མོར་གནས་པའི་དུས་སུ།",
    "བརྟག་པ་འདི་ཁྱད་པར་དུ་ལྟ་བ་མན་ཆད་ཀྱི་ཐུར་སེལ་འོག་གི་སྣ་སྒོར་འབྱུང་འཇུག་བྱེད་མ་བྱེད་རྟོག་པ་ལ་གལ་ཆེ་བ་ཡིན།",
    "སྣ་བུག་གི་རྒྱུ་བ་ཕྲ་མོའང་ལོག་པ་ལ་ཐིམ་དཀའ་སླ་གཉིས་ལས།",
    "ལྟེ་བའི་ཧཱུཾ་ཡིག་གི་ནཱ་ད་ལ་གཞུག།",
    "དེའི་རང་གདངས་ཨཱཝཡིག་གི་གདངས་སུ་བསམ།",
    "དེ་ནས་དྷུ་ཏཱིའི་ནང་གི་ཧཱུཾ་ངམ་ནཱ་ད་ལས་ཕྱིར་འགྲོ་བའི་ཚེའང་དྷུ་ཏཱིའི་ནང་ནས་ཕྱིར་འགྲོ་བར་བསམ་ཞིང་།",
    "གདམས་ངག་གི་དམ་པའོ།",
    "དེར་། མ་སོང་བར་རེ་ཞིག་ལ་ཐུན་ཆུང་ལ་གྲངས་མང་བར་བྱའོ།",
    "གོམས་པའི་མཐར་ཕར་ལ་མོས་པ་བྱས་པ་ཙམ་མིན་པར་ཚུར་ལ་རང་གི་གདངས་ཡི་གེ་གསུམ་གྱི་གདངས་སུ་འཆར་བའི་གསུང་གི་ང་རྒྱལ་འཕོས་པ་འབྱུང་སྟེ།",
    "དེའང་དང་པོར་དྷ་ཏཱིའི་ནང་ནས་འབྱུང་འཇུག་བྱེད་པར་མོས་པ་ཙམ་ཡིན་ཀྱང་།",
    "འདི་ལའང་དང་པོར་བུག་རེ་རེ་བར་རྒྱུ་བཞིན་པ་ན།",
    "དེ་ནས་སྲོག་དྷུ་ཏཱིར་༣༧༦གནས་པ་འོང་ལུགས་ནི་འབྱུང་འཇུག་གང་རུང་རེའི་ཡུད་ཚད་ཀྱི་གནས་པ་ནི་དང་པོར་ཆེད་དུ་བྱ་དགོས་ལ།",
    "དེ་གོམས་པ་ཡུན་བསྲིངས་ན་མཚམས་ཤིག་ནས་ཆེད་དུ་མ་བྱས་ཀྱང་རང་གི་ངང་གིས་གནས་པ་ཞིག་འོང་།",
    "དབྱངས་གསལ་གཟུགས་བརྙན་བཞིན་དུ་ཤར་བར་བསམ་མོ།",
    "ཡུམ་རྡོ་རྗེ་ཕག་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་རྡོ་རྗེ་དང་ཐོད་པ་འཛིན་པས་འཁྱུད་པར་བསམ་མོ།",
    "དེ་ནས་སྐད་ཅིག་གིས་གསང་གནས་གཉིས་རྡོ་རྗེ་དང་པདྨར་བྱིན་གྱིས་བརླབ།",
    "རང་ཉིད་བདེ་མཆོག་དངོས་དང་ཡུམ་ཕག་མོ་དངོས་ཡིན་པར་ང་རྒྱལ་བརྟན་པོ་བསྐྱེད་ལ།",
    "བདེ་བའི་རང་བཞིན་གྱི་འོད་ཟེར་དམར་པོ་འཕྲོས་པ་ཕོག་པས་སྣོད་བཅུད་ཐམས་ཅད་འོད་ཀྱི་རྣམ་པར་བྱས་པར་བསམ་མོ།",
    "ནཱ་དའང་སྒྲའི་རྩེ་མོ་བརྒྱ་སྟོང་གི་ཆ་ཙམ་དུ་བྱས་པ་ལ་སོམས་གཟུང་ངོ།",
    "རང་གི་ལྟེ་བའི་སྣང་བ་མི་འཆར་ཡང་།",
    "ནཱ་དའང་མི་དམིགས་པར་བྱས་ལ་ལྟེ་བའི་དབུས་ཀྱི་དྷུ་ཏཱིའི་ནང་གི་ཐད་ཀ་ཙམ་དུ་དམིགས་ལ་སེམས་གཡོ་མེད་དུ་གཟུང་ངོ།",
    "ལམ་མཐོན་པོར་སོང་བའི་སྐབས་ཀྱི་ལྡོག་པ་དང་།",
    "ཞེས་བདེ་རྫོགས་གསུངས་པའི་དོན་ལ་འདིའི་གཙོ་བོ་འོད་གསལ་ཡིན་མོད་ཀྱང་།",
    "སྟོང་པ་བཞི་གའི་དུས་སུ་དེ་ཁོ་ན་ཉིད་ཀྱི་ལྟ་བ་དྲན་པར་བྱས་ནས་བདེ་སྟོང་སྦྱོར་བ་ཡིན་མོད་ཀྱང་།",
    "ཐིག་ལེ་གཞུང་གི་སྦྱོར་ཤེས་ན།",
    "ཕག་མོ་ལྟེ་བའི་རྩར་གནས་པ།",
    "གཞན་གསུམ་ལའང་སྦྱར་རོ་། ལྟེ་བའི་རྩ་བར་ཕག་མོ་ནི།",
    "གཏུམ་མོ་ཨ་ཐུང་དང་།",
    "མས་བརྟན་གྱི་ལྷན་སྐྱེས་བྱང་སེམས་གྱེན་དུ་ལྡོག་པ་སྤྱི་གཙུག་ཏུ་ཕྱིན་པ་ན་སྐྱེ་བས་སྤྱི་གཙུག་གི་ཧཾ་ཡིག་ཧེ་རུ་ཀར་། བསྟན་པའོ།",
    "དེ་ནས་སྲོག་གི་སྟེང་དུ་ཡིད།",
    "མ་འཕོས་ཀྱང་སྔར་གྱི་ལམ་དེ་ཉིད་ནས་མར་འོང་བ་ལྟར་མི་བྱེད་པར་གར་སོང་ཆ་མེད་དུ་འགྲོ་བ་དང་།",
    "ཕྱིར་ལོག་ཀྱང་སྤྱི་བོའི་བར་དུ་ཐལ་གྱིས་འགྲོ་བའི་ངེས་པ་མེད་པར་གནས་དམའ་མོ་ནས་གྲམ་ནས་འགྲོ་བའང་འོང་བས།",
    "འདི་ལ་ནི་ལུགས་ལྡོག་གི་། སྣང་མཆེད་ཐོབ་གསུམ་འོད་གསལ་གྱི་ཡེ་ཤེས་སུ་མི་རུང་ཡང་།",
    "ཟུང་འཇུག་གི་སྐུའི་སྒྱུ་ལུས་ཏེ་གསུམ་ཡོད་དེ།",
    "དངོས་ལ་བརྟེན་ནས་ཡུལ་ས་སྒྲ་ལ་སོགས་པའི་མཉམ་གཞག་ཏུ་བསྐྱངས་པའི་བདེ་སྟོང་གིས་རྒྱས་བཏབ་སྟེ།",
    "ཉི་མ་རེ་རེ་བསྒྲུབ་པར་བྱ།",
    "རང་གིས་སྔར་ཉམས་སུ་མྱོང་བའི་བདེ་ཆེན་དྲན་པར་བྱས་ལ།",
    "སླར་ཡང་ཕྱི་ནང་གི་ཐབས་གཉིས་གང་རུང་ལ་བརྟེན་ནས་སྟོང་ཕྱོགས་དང་སྣང་ཕྱོགས་ཀྱི་རྫོགས་རིམ་ཚན་པ་གཉིས་བསྐྱེད་ནས།",
    "འོད་གསལ་མངོན་དུ་ཕྱོགས་པར་བྱས་ལ་གཉིད་ཀྱང་འོད་གསལ་ཉིད་དུ་མོས་པར་བྱས་ཏེ་ཉལ་ལོ།"
  ]
}