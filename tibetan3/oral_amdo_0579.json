    "ཐལ་ཆེན་གྱི་ཚོམ་བུ་ནི།",
    "ཁྲག་གི་ཐིག་ལེས་མཁུར་ཚོས་གཡས་གཡོན་གསལ་བ།",
    "ཞག་གི་ཟོ་རིས་ནི་དཔའ་བོ་གཡུལ་དུ་བསད་པའི་ཞག་ཆེན་པོས་ཟོ་བ་ལྟ་བུ་སྨིན་མ་གཉིས་ཀྱི་སྟེང་དུ་ཡོད་པ་ལ་བྱེད།",
    "རྗེ་བཙུན་རྩེ་མོས།",
    "ཕྱག་གི་དག་པ་སྟོང་པ་ཉིད་ལྟ་བུའོ།",
    "རང་རེ་ས་སྐྱ་པ་ནས་བརྒྱུད་པའི་དུར་ཁྲོད་བདག་པོའི་བསྐྱེད་ཆོག་ཏུའང་།",
    "དེ་འགོག་ན་ཧ་ཅང་ཐལ་ལོ།",
    "གཅེར་བུའི་གཟུགས་ལ་མཚན་མ་གྱེན་དུ་སྒྲེང་བ་ཞེས་གསུངས་པས་ཡུམ་དངོས་སུ་མ་བསྟན་པ་བཞིན་མཚན་མ་གྱེན་སྒྲེང་གི་ཤུགས་ལས་ཡུམ་བཞེད་པར་བསྟན།",
    "ཨ་མོ་གྷ་བཛྲ་གྱིས་ལྷ་བཅུ་བདུན་མའི་སྒྲུབ་ཐབས་ལས་ཀྱང་མཚན་མ་གྱེན་སྒྲེང་འབའ་ཞིག་གསུངས་པས་ཡུམ་རྣམས་མ་བསྟན།",
    "རང་གི་བསམ་ཚོད་རྒྱ་གར་དུའང་འཇིགས་བྱེད་བཅུ་གསུམ་མ་འདི་བྱུང་ཡོད་པ་འདྲ་སྟེ།",
    "དེའི་ནང་གི་འཇིགས་བྱེད་དེ་འང་ཞལ་གཅིག་ཕྱག་གཉིས་པ་ཡུམ་རོ་ལངས་མ་དང་མཉམ་པར་སྦྱོར་བ་ཞིག་འདུག་པས་འཇིགས་བྱེད་ལ་ཡུམ་གཏན་ནས་མེད་གསུངས་པའང་མི་རིགས་པར་འདུག་སྙམ་དུ་སེམས་སོ།",
    "རྗེས་འབྲངས་མཁས་པ་འགའ་ཞིག་གིས་ཡུམ་ཡོད་པར་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་ལ་བརྟེན་ནས་སྒྲུབ་པ།",
    "འཇིགས་བྱེད་དཔའ་གཅིག་གི་སྒྲུབ་ཐབས་ཐམས་ཅད་ལ་ཡུམ་མེད་པའི་ཕྱིར་དང་།",
    "དེ་ལ་བཀོད་པའི་ལྷ་ནི་གདོང་དྲུག་གི་རྒྱུད་ལས།",
    "ཐུགས་རྡོ་རྗེའི་བར་གྱི་༢༧༦ལྷ་རྣམས་རང་རང་གི་ས་བོན་ལས་ཕྱག་མཚན་ས་བོན་གྱིས་མཚན་པ་ལས་ལྷར་བསྐྱེད་པ་ཡིན།",
    "སྔགས་གསུམ་དག་པ་སྐུ་གསུམ་མོ།",
    "ཞེས་བརྗོད་ལ་དེ་དག་གི་དོན་སྔར་བཞིན་ཡིད་ལ་བསམ་པར་བྱའོ།",
    "སྔགས་ཕྲེང་རང་རང་གི་ཁ་དོག་ནི།",
    "ཨ་མོ་གྷ་བཛྲ་གྱི་དཔའ་བོ་གཅིག་པའི་སྒྲུབ་ཐབས་ལས།",
    "སོ་༥ བསྟོད་པ་བྱས་ཤིང་དུས་གསུམ་དུ་ཡང་དག་པར་བསྒོམ་མོ།",
    "ཞེས་སོགས་ཚིག་རྐང་དྲུག་གིས་བདུད་རྩི་བྱིན་གྱིས་བརླབས་ལྕེ་ལ་མྱོང་བར་བསྟན།",
    "དེ་ལྟར་བྱས་པས་ཁ་ཟས་བུ་ལོན་ཅན་དུ་མི་འགྱུར་སོཞིང་ཚོགས་རྫོགས་པའི་ཐབས་སུ་འགྲོ་བ་ཡིན་གསུངས།",
    "དྲན་རྟོགས་ཐམས་ཅད་གསལ་སྟོང་ཟུང་འཇུག་གི་ཆོ་འཕྲུལ་དུ་བསམས་ལ།",
    "འདིས་མཚོན་རྣམ་དཀར་མཆོད་སྤྲིན་ཀུན་བཟང་གི།",
    "ཚུལ་འདིས་། གཞན་ཕན་རེ་བ་ཆེར་མེད་མོད།",
    "རང་གི་གནས་ཁང་འདི་ཉིད་༩ ༢༡། ། མལ་གྱི་སྣང་བ་ཐམས་ཅད་མི་དམིགས་ཏེ་འོད་གསལ་སྟོང་པ་ཉིད་དུ་ཐིམ་པའི་ངང་ལས་དག་གསལ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ལས་གྲུབ་པའི་རྡོ་རྗེའི་ས་གཞི་ར་བ།",
    "དེའི་སྟེང་གི་ཆ་ལ་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་རྡོ་རྗེ་ལངས་མ།",
    "ནོར་ལྷ་གཏེར་བདག་གི་ཚོགས་སྤྲིན་འཐིབས་པ་བཞིན་བཞུགས་པར་བསམ་པ་ནི་སྐྱབས་སུ་འགྲོ་བའི་ཡུལ་ལོ།",
    "གང་གིས་སྐྱབས་སུ་འགྲོ་བའི་ཡགང་ཟག་ནི།",
    "ཞེས་བརྒྱ་ཚར་སྟོང་ཚར་ལུས་སེམས་ལ་འགྱུར་བ་མ་བྱུང་གི་བར་དུ་བྱས་པའི་མཐར།",
    "དེའི་ཆེད་དུ་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་ལམ་གྱི་རིམ་པ་ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱིའོ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "དཔེ་དང་གཏན་ཚིགས་དང་ལུང་རིགས་གང་གི་སྒོ་ནས་ཀྱང་བརྗོད་པར་མི་ནུས་ཏེ།",
    "ངག་གི་ལམ་འདིས་ཚིག་གི་སྤྱོད་ཡུལ་མིན།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "ཐོག་མར་རྡོར་སེམས་བསྒོམ་བཟླས་སྐབས་བྷེ་ར་ཝ་བཞི་སྦྱོར་གྱི་ཡིག་བརྒྱ་གསུངས་པ་མཐའ་གཅིག་ཏུ་གསུངས་པའི་ངེས་པ་མེད་པས་རྡོར་སེམས་ཡིག་བརྒྱ་སྤྱི་ལྟར་གསུང་ཚུལ་བསྟོད་ཚིག་ཁྲིད་ཡིག་གི་དཀྱུས་སུ་གསུངས་པ་གཞན་དང་ཚིག་ཟུར་ཅུང་མི་མཐུན་པས།",
    "ངག་གི་ལམ་འདི་ཡིད་ཀྱི་སྤྱོད་ཡུལ་མིན།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "རྡོ་རྗེའི་ཚིག་རྐང་གི་ལུང་འདྲེན་སོགས་ཁོངས་རྣམས་ཀྱང་ཕུད་ནས།",
    "རང་ལ་བསྟིམ་མོ།",
    "ཐུན་མོང་མ་ཡིན་པ་ནི།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "རེག་ལ་མ་འབྱར་བའི་རྣམ་པས་ཐོ་བརྩེགས་ཀྱི་ཚུལ་དུ་བཞུགས་པའི་མདུན་དུ་ཡི་དམ་སོགས་དྷཱི ། སྐྱབས་ཡུལ་ལྟར་བསམ།",
    "བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཨོཾ་གུ་རུ་བུདྡྷ་བོ་དྷི་སཏྭ་ས་པ་རི་ཝཱ་ར་ཨནྡྷཾ།",
    "རྒྱུ་དེ་དག་ལས་གྲུབ་པའི་ལྷ་མོ་ཕྱག་ན་ཤ་ལྔ་བདུད་རྩི་ལྔ་དག་པ་ཡེ་ཤེས་ལྔའི་རང་བཞིན་བདུད་རྩིས་གང་བའི་ཐོད་པ་ཐོགས་པ་ནམ་མཁའ་གང་བར་སྤྲོས་ཏེ་ཕུལ་བས་ཟག་མེད་ཀྱི་བདེ་བ་རྒྱས་པར་བསམས་ཏེ།",
    "ཨོ་གུ་རུ་བུདྡྷ་བོ་དྷི་ས་ཏྭ་ས་པ་རི་ཝཱ་ར་པཉྩ་ཨ་མྲྀ་ཏ་ཧཱུཾ།",
    "དེ་དག་ཐམས་ཅད་རྡོ་རྗེ་རོ་ལངས་མར་གྱུར་ཏེ་གཉིས་སུ་མེད་པར་འཁྱུད་ནས་སྙོམས་པར་ཞུགས་པས་བདེ་སྟོང་གི་ཡེ་ཤེས་རྒྱས་པར་བསམས་པས་གསང་མཆོད་དང་།",
    "རང་གི་ཕུང་པོ་དེ་ཚོ་བ།",
    "རིག་པ་འཇམ་དཔལ་དུ་གསལ་བའི་ཕྱག་གཡས་ཀྱི་རལ་གྲི་སྨིན་མཚམས་སུ་རེག་པ་ཙམ་གྱིས་ལྟག་པའི་བདུད་སྒོའི་བར་ཐོགས་མེད་དུ་ལིང་གིས་བཅད་མདུན་དུ་ཐོད་པའི་སྒྱེད་པུ་གསུམ་རང་བྱུང་དུ་བྱུང་བའི་སྟེང་དུ་བཀལ་བས་རོ་ཆེ་ལ་སྟོང་གསུམ་གྱི་ཚད་དང་མཉམ་པའི་ཐོད་པ་ཕྱི་དཀར་ལ་ནང་དམར་བར་གྱུར།",
    "དེ་ནས་རང་གི་རྐང་པ་གཡོན་པ་དུམ་བུ་གསུམ་བྱས་ཏེ་བསྒྱུར།",
    "འདོད་ཡོན་དྲུག་གི་རང་བཞིན་དུ་བསམ།",
    "དེ་བཞིན་དུ་སྐྱབས་ཡུལ་རྣམས་ལ་རེ་རེ་ནས་དམིགས་པ་གཏད་ལ་དབུལ།",
    "མཐར་ལྷ་མོ་བདུད་རྩི་ཐོགས་པ་གྲངས་མེད་པ་སྤྲོས།",
    "རང་གི་དཔྲལ་བ་ནས་ཞུགས།",
    "རེ་རེའི་མཐར་ཡང་ཅི་གནས་སུ་མཉམ་པར་གཞག།",
    "ཅུ་གཅིག་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "རང་གི་སྤྱི་གཙུག་ནས་ཞུགས།",
    "ཕུང་ཁམས་སྐྱེ་མཆེད་ལྷ་དང་ལྷ་མོ་ཡི།",
    "ནང་གསལ་བྱེད་ཀྱིས་ཕྱེ་ན་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་དུ་གདོད་མ་ནས་གནས་ལ།",
    "བསྐད་ཅིག་གིས་སྲུང་བའི་འཁོར་ལོ་དུར་ཁྲོད་གཞལ་ཡས་ཁང་དང་བཅས་པའི་དབུས་སུ་པདྨ་དང་ཟླ་བའི་སྟེང་དུ་རང་གི་སེམས་ཉིད་དྷིདམར་སེར་ལས་རལ་གྲི་སྔོ་བསངས་ཡེ་ཤེས་ཀྱི་མེའི་ཚྭ་ཚྭ་འཕྲོ་བ།",
    "ཡང་རལ་གྲི་དྷིས་མཚན་པ་རེ་འཇིགས་ཁྲིད་རེར་མོས་སུ་བྱེད་ཅིང་།",
    "དེར་འཇའ་ཡལ་བ་བཞིན་སོང་བར་བསམས་ལ་རིག་པ་བརྗོད་མེད་དུ་གཞག།",
    "ཁྲོ་བོ་གཤིན་རྗེ་གཤེད་ཀྱི་ལྷ་ཚོགས་དཔག་ཏུ་མེད་པ་སྤྱན་དྲངས་ནས་རང་ཉིད་ལ་ཐིམ་པས་རང་དང་ཉི་མ་ཕྱོགས་དང་བཅས་པ་འོད་དུ་ཞུ་ནས་ཉི་མའི་དཀྱིར་འཁོར་འབར་ཞིང་ཚ་བ་དཔག་ཚད་བརྒྱའི་ཁྱོན་ཙམ་དུ་གྱུར་པ་ལ་སེམས་འཛིན་པར་བྱེད།",
    "མཐར་དཔག་ཚད་བརྒྱའི་ཁྱོན་ཙམ་ཧཱུྃ་གིས་མཚན་པ།",
    "སྣའི་སྟེང་ན་བཅུ་བཞི་གཉེར་ནག་པོ་གསུམ་ཉེ་རེ་བ།",
    "རྭ་གཉིས་སྔོ་བསངས་རྩེ་མོ་ཤིན་ཏུ་རྣོ་བ་རྟ་རྔ་བརྒྱར་གཤགས་པའི་ཚད་ཙམ་ཟོང་ངེ་བ་རྩ་བ་རུས་རྒྱན་ཁྲོལ་ལེ་བ།",
    "མགུལ་གྱི་ཁྲོ་གཉེར་རིམ་པ་གསུམ་ཉེ་རེ་འཇིགས་ཁྲིད་བ་རྣམས་ལ་རིམ་བཞིན་སེམས་འཛིན་པར་བྱེད་ཅིང་།",
    "དེ་ལྟ་བུའི་མ་ཧེའི་ཞལ་དེ་ཐད་ཀར་གཟིགས་པ་ལྟ་བུ་མ་ཡིན་པ་ནུ་མ་གཡོན་པའི་ཐད་ཙམ་དུ་ཕོགས་ཤིང་།",
    "ཞལ་གྱི་ནང་ཐམས་ཅད་ཁྲག་དྲོན་མོས་ཁེངས་ཏེ།",
    "ཞལ་གྱི་གྲྭ་ནས་ཁྲག་གི་རྒྱུན་དམར་ན་ར་ར་འཛག་བཞིན་པ།",
    "འཇིགས་ཁྲིད་ལས་བཞི་བདེ་བླག་ཏུ་འགྲུབ་པའི་ཆེད་དུ་དཀར་སེར་དམར་ལྗང་གི་ཁ་དོག་ཏུ་རིམ་པས་བསྒྱུར་ཞིང་སེམས་འཛིན།",
    "ཁོང་སྟོང་ཁྱོད་ཀྱི་སྐུ་ལ་མེད།",
    "དེ་དག་མེད་པའི་ཁོང་སྟོང་ཟོ་བ་ལྟ་བུའམ་མ་ཡིན་ཏེ་བར་སྣང་གི་འཇའ་ཚོན་ལྟ་བུ།",
    "དེའི་ཕྱིར་རོལ་དུ་ཡུམ་རྡོ་རྗེ་རོ་ལངས་མ་དཀར་མོ་གྲི་ཐོད་འཛིན་པ་གཡོན་བརྐྱངས་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པ་སོ་གཉིས་ཀྱིས་བསྐོར་བ།",
    "ཡུམ་དམར་མོ་བཅུ་དྲུག་གིས་བསྐོར་བ་དང་།",
    "ཡུམ་སྔོན་མོ་བརྒྱད་ཀྱིས་བསྐོར་བ།",
    "ཡུམ་སེར་མོ་དྲུག་ཅུ་རྩ་བཞིས་བསྐོར་བ།",
    "སྣང་བ་ཐམས་ཅད་ཧཱུྃ་གི་སྒྲ་འུ་རུ་རུ་སྒྲོགས་པར་བསམས་ལ།",
    "ལྷ་དང་ལྷ་མོའི་རང་བཞིན་གསལ་བཏབ་ནས།",
    "དེའི་གཡས་ཀྱི་རྩེ་མོར་ཐིག་ལེ་དམར་པོ་ཡུངས་ཨ་། འབྲུ་ཙམ་སྣུམ་ལ་འདྲིལ་བ།",
    "རྭ་རྩེ་ཤིན་ཏུ་ཕྲ་བ་རྟ་རྔ་བརྒྱར་གཤགས་པའི་ཚད་ཙམ་དེའི་ནང་ནས་མར་སོང་སྟེ་རྭའི་སྦོམ་སར་སླེབ་པ་དང་།",
    "རྣམ་སྣང་གི་རིགས་ཀྱི་གཙོ་འཁོར་རྣམས་མུན་ཁུང་དུ་སྒྲོན་མེ་བཏེག་པ་ལྟར་གསལ་བར་བྱས།",
    "སྐུ་སྨད་ནས་རིམ་བཞིན་གྱེན་དུ་སོང་སྟེ་རྭ་རྩེའི་ཐིག་ལེ་གཉིས་ལ་ཐིམ་པས་ཡུངས་འབྲུ་ཙམ་གསལ་ཞིང་འཚེར་བ་ལ་སེམས་བཟུང་།",
    "འཇིགས་བྱེད་དཀར་པོའི་རྭ་གཉིས་ཤིན་ཏུ་ཕྲ་བའི་རྩེར་ཐིག་ལེ་དཀར་པོ་མིག་གིས་བལྟར་མི་བཟོད་པ་ཙམ་རེ་བསྒོམ།",
    "རྭ་རྩེའི་ནང་ནས་སོང་སྐུ་ལུས་གང་བས་ཤིན་ཏུ་གསལ་བར་བྱས།",
    "འོད་ཟེར་ཕྱིར་འཕྲོས་ལྷ་མོ་སོ་གཉིས་པོ་གསལ་བར་བྱས།",
    "མས་ཡར་རིམ་བཞིན་རེས་མོས་སུ་སེམས་འཛིན་པ་སྟེ།",
    "དཔེར་ན་གཟུགས་༢༩༨ཀྱི་ཕུང་པོའི་དྲི་མ་སྦྱོང་ན་རྣམ་སྣང་གི་རང་བཞིན་ཡིན་བའི་ཆ་ནས་སྦྱང་གཞི་ཡིན་ལ།",
    "མཁས་གྲུབ་ཏུ་རློམ་པ་ཕལ་མོ་ཆེའི་རྣ་བའི་སྤྱོད་ཡུལ་དུ་མ་གྱུར་པའི་གསང་ཆེན་དེ་ཙམ་མོ།",
    "མ་ཧེའི་ཞལ་གྱི་བསྐྱེད་རིམ་ཟབ་མོའི་ལམ།",
    "རྡོ་རྗེའི་བཟླས་པ་ཐུན་མོང་བ་དང་།",
    "དང་ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཀྱི་དང་པོ་ལའང་སྒྲ་ལ་སེམས་གཟུང་བ་དང་།",
    "མདུན་གྱི་ས་གཞི་ལ་ནན་གྱིས་སོང་བར་བསམས་ལ།",
    "ཕྱིར་འབྱིན་པའི་ཚེ་ཧཱུྃ་མཐིང་ག་ཧཱུྃ་གི་སྒྲ་དང་བཅས་པར་བསམས་ཏེ་ཡེ་མ་ཡེངས་པར་སྔར་བཞིན་ཉམས་སུ་བླངས་ཏེ།",
    "གཉིས་པ་ཐུན་མོང་མ་ཡིན་པའི་རྡོར་བཟླས་ནི།",
    "ཅེས་པའི་སྔགས་ཕྲེང་ཁ་དོག་མཐིང་ག་རང་སྒྲ་སྒྲོགས་པའི་རྣམ་པ་ཅན་ནར་གྱིས་སོང་སྟེ་སྨིན་མཚམས་སོར་བཅུ་དྲུག་ཙམ་གྱིས་བར་སྣང་ལ་ཁྱི་འཇིགས་ཁྲིད་ལི་ལི་བྱེད་པར་བསམ།",
    "དེ་ལྟར་བྱས་པས་འོག་གི་བུམ་པ་ཅན་སོགས་གང་བསྒོམས་ཀྱང་གེགས་ཆེར་མི་འབྱུང་ཞིང་།",
    "ཅུང་ཟད་བྱུང་བ་སྲིད་ནའང་དེ་ཉིད་ངང་གིས་སེལ་བར་འགྱུར་རོ་གསུངས།",
    "སྐད་ཅིག་གིས་རྣམ་སྣང་གི་རིགས་ཀྱི་རྡོ་རྗེ་འཇིགས་བྱེད་དཀར་པོ་མ་ཧེའི་ཞལ་ཅན།",
    "རྣམ་སྣང་གི་ཅོད་པན་ཅན།",
    "དེའི་ནང་ཁ་ནས་སོར་བཞི་ལྔ་ཙམ་བཅལ་བའི་ཐད་ཙམ་ན་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་འོད་ཀྱི་རང་བཞིན་གཉིས་ཁ་སྦྱར་བའི་དབུས་སྟེང་འོག་གང་ལའང་མ་རེག་པར།",
    "ངོ་བོ་གཉིས་མེད་ཀྱི་ཡེ་ཤེས་རྣམ་པ་དྲོད་ཀྱི་རང་བཞིན་རེག་བྱ་ཚ་བའི་བདག་ཉིད་ཅན་གྱི་ཨཱ",
    "ཆུ་ཤིང་གི་སྡོང་པོ་ལྟར་དྲང་བ།",
    "མདའ་སྨྱུག་འབྲིང་པོ་ཙམ་ཁོང་སྟོང་འོད་ཀྱི་རང་བཞིན་ཡར་སྣ་ཚངས་བུག་དང་མར་སྣ་པདྨ་སྟེང་མའི་ཟེའུ་འབྲུ་ཕུག་སྟེ་ཨ་ལ་རེག་པ།",
    "དེའི་གཡས་སུ་རོ་མ་དམར་མོ་མེའི་རང་བཞིན་དང་།",
    "རོ་རྐྱང་གི་ནང་ནས་སོང་སྟེ་སྣ་བུག་གཉིས་ནས་སོར་བཅུ་དྲུག་གི་ཚད་ཙམ་དུ་སོང་།",
    "རོ་རྐྱང་གི་ནང་ནས་ཐོགས་མེད་དུ་སོང་བར་བསམས་ལ།",
    "དེ་བཞིན་དུ་རྣམ་སྣང་གི་འཇིགས་བྱེད་ནཱ་དའི་བར་དུ་བསྡུས་ཏེ་རིན་འབྱུང་གི་འཇིགས་བྱེད་དུ་བསྒོམ།",
    "དེ་ནས་མགྲིན་པའི་བར་རྩ་གསུམ་སོ་སོར་སོང་།",
    "དེ་ལས་འོད་ཟེར་སེར་པོ་བདེ་བ་ཆེན་པོའི་རང་བཞིན་གསེར་སྐུད་ལྟ་བུ་གཉིས་གྱེན་དུ་ནར་གྱིས་རོ་རྐྱང་གི་ལམ་ནས་སོང་།",
    "ལྟེ་བར་ཁ་སྦྱར་བས་ཨཱལྟེ་བའི་རྩ་འཁོར་ཐམས་ཅད་རིན་འབྱུང་གི་རང་བཞིན་འོད་སེར་པོ་བདེ་བའི་རང་བཞིན་དེས་མེར་གྱིས་ཁེངས་པར་བསམ།",
    "བུམ་ཆེན་གཅིག་གིས་ལུས་ཀྱི་རྩ་གནས་ཐམས་ཅད་ཁེངས་བར་བསམ།",
    "ངག་ཉམས་ཨོཾ་དང་རཏྣ་དྷིཀ་སོགས་རིན་འབྱུང་གི་སྔགས་ཤུགས་འབྱུང་དུ་འདོན་པ།",
    "དེ་ལས་འོད་ཟེར་དཀར་པོ་ཤེལ་དཀར་གྱི་སྐུད་པ་ལྟ་བུ་གཉིས་རོ་རྐྱང་གཉིས་ནས་སོང་སྟེ།",
    "ངག་ཉམས་ཨ་རོ་ལིཀྲ་སོགས་འདོན།",
    "ནགས་ཚལ་ཆེན་པོ་མེས་ངག་ཉམས་ཨ་རོ་ལིཀྲ་སོགས་འདོརཚིག་པ་སོགས་འདྲ།",
    "གསུམ་པ་གཏུམ་མོ་ཡེ་ཤེས་ཀྱི་མེའི་མདའ་བྱང་སེམས་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་བསྣུན་པས་བྱང་སེམས་བདུད་རྩིའི་ཆུ་རྒྱུན་འབེབས་པའི་ཐབས་ལ་བཞི་སྟེ།",
    "ཕྱག་མཚན་ས་བོན་མེ་ལྕེ་ཉོན་མོངས་སྲེག་བྱེད།",
    "གཡས་སུ་རོ་མ་དམར་ཉེར་ལྔ་མོ་དང་གཡོན་དུ་རྐྱང་མ་དཀར་མོ་གཉིས་མདའ་སྨྱུག་འབྲིང་པོ་ཙམ།",
    "གསང་གནས་བདེ་སྐྱོང་གི་འཁོར་ལོ་ཐམས་ཅད་ཁེངས།",
    "ཚེག་སྒྲ་དང་བཅས་ལམ་ལམ་འབར་སོང་བ་ལྟར་ཡས་མར་བདུད་རྩི་སྐྱ་སིབ་སིབ་བབས།",
    "རང་གི་ལུས་འོད་ཀྱི་རང་བཞིན་དུ་གསལ་བའི་ལྟེ་བར་ཉི་ཡ་མའི་སྟེང་དུ་མ་ཧེའི་མགོ་བོ་ཁ་དོག་ནག་པོ་མཐེབ་ཚིགས་ཙམ་མཚུལ་བ་མདུན་ཕྱོགས་ལ་བསྟན་པ།",
    "རྭ་སྔོ་བསངས་བའི་རྭ་རྩེ་ཤིན་ཏུ་ཕྲ་བ་སྤུའི་རྩེ་མོ་བརྒྱར་གཤགས་པའི་ཚད་ཙམ་ནག་སིང་ངེ་བ།",
    "འཇིགས་ཁྲིད་མགོ་བོ་བརྒྱད་དམ་དགུ་བརྩེགས་མར་བསྒོམ་མོ།",
    "གཞན་རྐྱེན་ཕྱག་རྒྱ་ལ་མ་ལྟོས་པར་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་བདེ་ཆེན་གྱི་ཡེ་ཤེས་བསྐྱེད་ཅིང་དེས་རྒྱུད་བྱིན་༣༧གྱིས་བརླབ་པའམ་གཏུམ་མོ་ཞེས་བྱ་སྟེ།",
    "འདིས་རོ་རྐྱང་གི་འགྱུ་བ་བཅད་ནས་གཟུང་འཛིན་གསོད་པར་བྱེད་པས་ན་གཏུམ་པ་ཡིན་ལ།",
    "ཡི་གེ་ཞེས་པ་མཚན་ཉིད་པ་ནི་རང་གི་ངག་གི་གདངས་ཡིན་ལ།",
    "ཐུན་མོང་དུ་ཉམས་སུ་བླང་བྱ་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱའི་ཉམས་ལེན་ནི།",
    "རང་གི་ལུས་ལ་རྩ་གསུམ་འཁོར་ལོ་ལྔ་སྔར་བཞིན་བསམས་པའི་སྤྱི་བོ་བདེ་ཆེན་གྱི་འཁོར་ལོའི་དབུས་ཀྱི་ཧཾ་ཡིག་ཕ་ལས་ཐོབ་བའི་ཁམས་དཀར་པོ་ཉིང་དྭངས་སུམ་དྭངས་ཀྱི་ངོ་བོ་དེ་ཉིད།",
    "ཡུམ་རྡོ་རྗེ་རོ་ལངས་མ་དཀར་མོ་གྲི་ཐོད་འཛིན་པ་ལ་འཁྱུད་པ།",
    "འཁོར་རྡོ་རྗེ་རོ་ལངས་མ་དཀར་མོ་སོ་གཉིས་ཀྱིས་བསྐོར་བ།",
    "དེ་ནས་རང་གི་གསང་བ་ཧཱུྃ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པའི་ལྟེ་བ་ལ་ཧཱུཾ་གིས་མཚན་པ།",
    "ཡུམ་གྱི་མཁོའ་ཨཾ་ལས་པདྨ་འདབ་མ་ལྔ་པ་ཨཾ་གིས་མཚན་པ།",
    "སྦྱོར་མཚམས་ནས་བྱང་སེམས་བབས་པས་འཁོར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་སྐུ་ལུས་ཁྱབ།",
    "རྩ་འདབ་ཐམས་ཅད་ཁེངས་པས་རང་གི་རྒྱུད་ལ་དགའ་བའི་ཡེ་ཤེས་སྐྱེས་བྱུང་སྙམ་དུ་བསམས་ལ།",
    "འཁོར་གྱི་ལྷ་མོ་རྣམས་ཀྱི་སྐུ་ལུས་ཁེངས།",
    "དེ་ལྟར་བདེ་བ་ལྷང་གིས་སྐྱེས་པས་དེའི་ངང་ལ་ཆེར་གྱིས་བལྟས་པ་ན་སྐྱེ་འགག་གནས་གསུམ་ཐམས་ཅད་དང་བྲལ་ཞིང་།",
    "སྐལ་བ་དང་མི་ལྡན་པ་རྣམས་ཀྱི་སྤྱོད་ཡུལ་དུ་མ་གྱུར་པའི་གསང་ཆེན་ཟབ་མོ་དེ་ཙམ་མོ།",
    "གསུམ་པ་ལྕེ་ཆུང་གི་རྩ་བར་ཟུག་པ་དེ་ཐབས་འདིས་ལམ་དུ་བྱས་པས་ཁ་སྐམ་པ་སོགས་དང་།",
    "དེ་ལྟར་བསྒོམས་པས་དུ་བ་ལ་སོགས་པའི་ཕྱི་ནང་གི་རྟགས་རྣམས་ནི་དཀར་དམར་སེར་སྔོ་ལྗང་མཐིང་གའི་འོད་རྟགས་འཇིགས་ཁྲིད་རྣམས་འབར་བ།",
