    "མཐར་དེ་ལྟར་སྒོམ་བྱེད་ཀྱི་ཤེས་པ་ཉིད་ཀྱང་རང་གར་འགགས་ཏེ་གཉིས་མེད་ཀྱི་ཡེ་ཤེས་རྣམ་གྲངས་པ་མ་ཡིན་པའི་རྟག་ཡོད་འཆར་རོ།",
    "གངས་ཅན་གྱི་མཁས་པ་ལ་ལ་སྔར་གོ་སྒྲུབ་ཏུ་ནི་རང་རང་ལས་དབྱེ་བ་དྲུག་དྲུག་ཏུ་སོ་སོར་བསྡུས་པ་ཡིན་ལ།",
    "བར་ཆད་མེད་པའི་རྩེ་སྦྱོར་ལ་བལྟོས་ནས་རང་རང་ལ་ལམ་བཞི་བཞིར་འཆད་དགོས་པ་ཡིན་ཏེ།",
    "ཚེ་སྔ་མའི་ལས་གསོག་དུས་ཀྱི་ཕུང་པོ་ལྔ་པོ་དེ་འདུ་བྱེད་ཡིན་ནོ།",
    "སློབ་དཔོན་གྱི་འགྲེལ་པའི་དོན་བཟང་བར་གདའ་བས།",
    "དཔེ་དང་རང་ལྡོག་ངོས་བཟུང་བ་དང་།",
    "གནས་ངན་ལེན་གྱི་སྒྲིབ་པ་དེ་མཚན་ཉིད་པ་ཀུན་ལ་དྲིས་པས་ངོས་མི་ཟིན་པ་འདུག་སྟེ།",
    "དེས་ན་སྣང་བ་དང་རང་བཞིན་མེད་པ་གཉིས་པོ་དེ་སྤྱོད་པའི་ཚེ་ན་སྣང་བ་དང་།",
    "དེ་ཡོད་ན་སེམས་དཔའ་སོགས་གཞན་ལ་ཀུན་རྫོབ་པའི་རྣམ་པར་སྣང་དུ་མི་རུང་དགོས་པ་ལས་སྣང་འདུག་པའི་ཕྱིར།",
    "ཁོ་བོའི་འགྲེལ་ཚུལ་འདི་ཉིད་འཕགས་སེང་དང་མི་མཐུན་པ་འདུག་ཅེས་ཞེན་པར་སྨྲ་བ་རྣམས་སྡང་སྨྲས་སུ་མ་བྱེད་པར་འཆད་ཉན་གྱི་སྒོ་ནས་གཏན་ལ་འབེབས་པར་མཛོད་ཅིག།",
    "དཀྱིལ་འཁོར་གྱི་ཤར་སྒོར་དཀྱིལ་འཁོར་ལ་ཕྱོགས་པས་འདུག་ལ།",
    "ཕྱག་ན་རང་རང་མཚན་མ་འཛིན།",
    "མེ་ཏོག་དབུལ་ཞིང་བསླང་བ་སོགས་དཀྱིལ་ཆོག་སྤྱི་འགྲོ་ལྟར་བྱེད་པ་བོད་ལ་ལར་འདུག་ཀྱང་།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ན་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཆུ་དེ་ནས་བུམ་པ་གང་ཁྱེར་བ་གནས་ཁང་དུ་གཏོར་ཞིང་རང་ཉིད་ཁྲུས་དང་བཏུང་བ་སོགས་བྱ།",
    "ལོ་སྟོང་བར་སྒྲ་དེ་ལ་ཉན་ཅིང་འདུག་གོ།",
    "སྲིན་པོའི་གྲོང་ན་འདུག་པ་དེ།",
    "མེ་ཏོག་དུས་དེར་ལྷན་ཅིག་བྱུང་།",
    "བྱེ་མའི་རྡུལ་བརྩེགས་ཕྲག་པ་ལ་ཞོན་ཉི་མའི་ཆུ་རྒྱུན་མེ་ཏོག་དུས་འདིར་རི་དྭགས་ལུས་ལ་ངལ་བ་སྟེར།་",
    "ལྕགས་ཀྱི་སྒྲོ་ལྡན་ཏེ་བུང་བས་ཆུ་སྐྱེས་ཀྱི་སྦྲང་རྩི་འཐུང་མི་འདོད་ཀྱང་སྐལ་ངན་མ་འདིས་འཐུང་བར་འདོད་པ་དེ་འདྲ་ཡང་སྙམ་འདུག་གོ།",
    "དལ་བར་འདུག་པ་མི་རིགས་སོ།",
    "བི་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "དུས་བཞིའི་རྩ་ལ་གང་བྱུང་རང་ལ་འོང་།",
    "དང་པོ་ཚ་ནས་ལྡོག་དུས་ལྡོག་ཚུལ་ལྡོག་རྗེས་བརྟག་བརྟག།",
    "ལྡོག་དུས་རླངས་མ་ཡལ་བར་ལྡོག་ན་ཚ།",
    "བསིལ་དྲོད་རང་རང་ནུས་པ་ཐད་དུ་འབྱུང་ཚ་བ་སེལ་བྱེད་སྔོ་ཡི་སྦྱོར་བ་ནི།",
    "སྐྱིད་པར་འདུག་དང་བྱིས་པ་རྒན་པོ་དང་།",
    "བི་ཤ་རྩེ་ཙ་ནི་ལག་སོར་འདུ་བྱེད་ཞན།",
    "འདུག་དང་ཉིན་གཉིད་ལོག།",
    "ཚིགས་ཁ་སྦོ་ཞིང་བརྐྱང་སྐུམ་བསྐུམ་འགྲོ་འདུག་དཀའ།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "དོན་ལྔ་རྣམས་ལ་རང་རང་གང་བབས་རྩ།",
    "སྨིན་ན་རང་རང་སོ་སོའི་གཉེན་པོ་བཏང་།",
    "ཆང་འཐུངས་འགྲོ་འདུག་རྗེས་སུ་རྐང་པ་ལྕི།",
    "སྣོད་རྣམས་རང་རང་གང་ལ་བབས་པ་དེ།",
    "ཚིགས་མིག་དམིགས་ན་ཞིང་རྐྱང་རུས་ཞེན་རུས་པ་ལྷང་ལྷང་ན་བ་དང་སྐུམ་བརྐྱང་བསྐུམ་འགྲོ་འདུག་དཀའ།",
    "འཕོངས་སྟོད་ཉལ་ཏེ་འགྲོ་འདུག་ལངས་པ་སྤང་།",
    "རང་རང་སྤྱོད་ལམ་ཁ་ཟས་དེ་དང་མཐུན།",
    "ལུས་ལ་འབྱར་ཞིང་ཁྲོད་ན་འདུག་པ་དང་།",
    "བརྡེག་དུས་ཉི་མས་དྲོས་ཤིང་མདངས་གསལ་བར།",
    "མཁལ་ཚད་ཆང་འཐུངས་འགྲོ་འདུག་བྱས་ཚེ་ན།",
    "དེ་རྨ་རྣམས་ཚ་བ་སྐྱེ་ཞིང་ཟུངས་ཆུང་ཡིས་ཟུག་ཆུང་རང་འབྱོར་བྱེད་པ་ཡིན།",
    "མཚོན་ཕོག་དུས་ན་འགྱེལ་འབུབ་བུབ་ཟ་ཟི་མེད།",
    "དོན་ཟིན་ཕོག་དུས་ཤེས་པ་ཟི་ཞིང་འབུབ་འཚུབ།",
    "ཁྲག་དུས་ཚ་བ་སྟོད་ཤོར་ཡེན་ལ་གཏད།",
    "རྣག་དུས་གསེ་བསེ་རུ་བྲག་སྤོས་ཅོང་ཞི་དང་།",
    "གང་འདུག་དེ་ཡི་སྟེང་དུ་ལུམས་བྱ་ཞིང་།",
    "མེ་ཉི་བསིལ་གྲིབ་སྙོག་སྙེག་ཅིང་འདུག་མི་ཚུགས།",
    "སྣོད་དུ་ཁོ་རང་ནུབ་ཙམ་ཆུ་ལ་གཙོ་བཙོ།",
    "བརླན་རླན་བསིལ་ཡིད་བདེར་གུས་པས་རོ་རྩ་ཙ་ནུས།",
    "རང་ལས་སྐྱེས་ཤིང་རང་ལས་བྱུང་།",
    "ཉེ་དགའ་འདུག་པ་དེས་རྒྱང་རིང་པོ་ཁོ་ན་ནས་མགོ་སྤྲ་བའི་མེ་ཏོག་ལྟར་སྐྱ་བ།",
    "ཉིན་པར་ཅུང་ཟད་ཅི་ཐོས་པ་དེ་དག་དགོངས་ཀ་འདུག་ནས་ཕན་ཚུན་སྨྲ་བར་བྱེད་པ་ཡིན་པས།",
    "ཅང་མི་སྨྲ་བར་འདུག་པར་བྱ་བ་གང་ཡིན་པ་དེས་སླར་སྨྲའམ་ཞེས་དེ་རྣམས་ཀྱིས་དེ་སྨྲར་བཅུག་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "སླ་བས་གལ་ཏེ་འདུག་ན།",
    "ཕན་ཆ་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅེས་ནན་ཏན་ཆེན་པོས་ཞུ་མཆིད་ཚིགས་བཅད་ཀྱི་ལམ་ནས་སྤེལ་བ་འདི་ལྟར།",
    "སྐབས་འདིར་ཡན་ལག་བདུན་པའི་ཚིགས་སུ་བཅས་པ་མང་ཙམ་འདུག་ཀྱང་ཡི་གེ་མང་བས་མ་བྲིས།",
    "གང་སྣང་ཐམས་ཅད་ཡིག་འབྲུ་ཤིན་ཏུ་ཆེ་བ་མང་པོས་གང་ནས་ཁྲ་ཆེམ་ཆེམ་འདུག་པ་ལ།",
    "ལྡེབ་ཕྲེང་མི་ཚང་བའང་འདུག་པས་དེ་རྣམས་སྟོང་པ་མི་བཞག་ཀ་མེད་བྱུང་བ་བཅས་ལ་བརྟེན་ནས་ད་དུང་ཞུ་བཅོས་མ་ཐུབ་པ་ཤིན་ཏུ་མང་བ་དང་།",
