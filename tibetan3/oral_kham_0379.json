    "དགོངས་དག་དེ་ནོར་འདུག་གསུངས་བྱུང་།",
    "ཁྱེད་རང་དོགས་པ་ཟ་ས་དེ་འདྲ་ཨེ་ཡོད།",
    "ཁང་པ་ཡང་སྟོང་པར་ལུས་འདུག་ཡིན་ནའང་།",
    "པ་ལགས་ཀྱིས་གཟིམ་ཤག་ལ་ལྡེང་ངེས་ཀྱི་དཀར་ཡོལ་ཉོ་རོགས་ཞེས་བཏང་འདུགཔེ་ཅིན་དུ་སྐུ་དྲག་དང་གཞུང་ཞབས་རྣམ་པ་ག་ས་ག་པར་ཕེབས་ནས་གོས་ཆེན་དང་ཅ་ལག་ཙག་ཙིག་ཉོ་བཞིན་འདུག་ང་ཉིན་རྟག་པར་མིས་འདྲུད་འཁོར་ལོ་ལ་བསྡད་དེ་ཅ་ལག་རྙིང་པ་དང་།",
    "ཁྱེད་རང་ལ་འདི་འདྲ་ག་ཚོད་ཡོད་ཟེར།",
    "ང་ལ་ལམ་འགྲོ་ཏོག་ཙམ་འདུག་དཔེར་ན།",
    "ཧོང་ཀོང་ནས་མི་ཚང་མང་པོ་སྤོ་བཞིན་འདུག་དངུལ་དེ་བཏོན་ནས་ཁང་པ་ཞིག་ཉོས་ན་ཡག་པོ་འདུག་ཅེས་ལབ་དུས།",
    "ཁང་པ་ཞིག་ཉོས་ན་ཡག་པོ་འདུག་དེང་སང་ཁང་པའི་གོང་ཚད་ཧ་ཅང་མར་ཆག་འདུག་ལབ་པ་ཡིན།",
    "འདུག་ས།",
    "གཡོག་པོ་འདུག་ས་གཉིས།",
    "དེས་ལོ་གཉིས་གསུམ་གྱི་རྗེས་ལ་ཁྲི་བརྒྱ་ཐམ་པ་བྱས་ནས་གཞན་པ་ལ་བཙོངས་འདུག་དེང་སང་ཁང་པ་དེ་ལ་ཕལ་ཆེར་ཨ་སྒོར་ཁྲི་སུམ་བརྒྱ་ཙམ་གནས་ཀྱི་མེད་དམ།",
    "དཀའ་ལས་ཁག་པོ་འདུག་གནམ་གྲུའི་ནང་ཆུ་ཚོད་དྲུག་བདུན་འགྲོ་དགོས་དུས་དཀའ་ལས་ཁག་པོ་འདུགདེ་ནི་རྒྱ་གར་ལ་བསྡད་ན་རྒྱ་མིའི་གནས་ཚུལ་མང་པོ་ཤེས་ཀྱི་མི་འདུག་བོད་ལ་འགྲོ་མི་ཐུབ་པ་དང་།",
    "རྒྱ་ནག་ལ་ཡང་འགྲོ་ཐུབ་ཀྱི་མི་འདུག་དེར་བརྟེན།",
    "ཕྱི་ལོ་༡༩༦༧ ནས་མགོ་བཙུགས་ཏེ་ཐོག་མར་ཕིན་བཟོ་དགོས་མིན་ནམ་བསམ་ཡང་ཆུ་ཧ་ཅང་དཀོན་པོ་ཡིན་པས་དཀའ་ལས་ཁག་པོ་འདུག་དེ་ནས་ཐུག་པ་བཟོས་པ་ཡིན།",
    "བོད་རིགས་རྣམས་འབྲས་ལྗོངས་སུ་འདུག་ཐུབ་ན།",
    "བཀོད་སྒྲིག་བྱེད་པར་ཕྱག་ལས་གནང་ཐུབ་ཀྱི་མི་འདུག་དེའི་ཚབ་ཏུ་ལོ་གཞོན་པ་ཞིག་གཏོང་ཐུབ་ན་ཡག་པོ་འདུག་ཅེས་སྐད་ཆ་བྱུང་སྟབས་རྒན་ཡེ་ཤེས་ཚུར་སྐད་བཏང་སྟེ།",
    "ང་རང་མཚམས་མཚམས་ལ་ཁོའི་སར་བཅར་གྱི་ཡོད།",
    "ངས་ཕེབས་ན་མ་འགྲིག་པ་མི་འདུག་ཀྱང་།",
    "ཁྱེད་རང་ལ་ངོ་ཤེས་པ་ཡང་མང་པོ་ཡོད་པས་འབྲེལ་བ་དེ་བཟོ་བར་ཁྱེད་རང་འགྲོ་རོགས།",
    "ངས་ཅང་ཅིན་ཀོ་ལ་ང་རང་ཐའེ་ཝན་དང་རྒྱ་གར་དབར་འབྲེལ་བ་བཟོ་བར་བཏང་ཚུལ་ཞིབ་ཕྲ་ཞུས་པ་དང་།",
    "གཡུ་ཐོག་བཀའ་ཤག་ཏུ་ཕེབས་ཀྱི་མི་འདུག་གསུངས་བྱུང་།",
    "སྐུ་གཟུགས་བདེ་པོ་མི་འདུག་གསུངས་བྱུང་།",
    "དེར་བདག་པོ་རྒྱག་ཉན་གྱི་མི་འདུག་ཕུད་དགོས་ཀྱི་འདུག་གསུངས་བྱུང་།",
    "གཙོ་བོ་གཡུ་ཐོག་དང་ཟུར་ཁང་གཉིས་ནས་འབུམ་དྲུག་བདུན་གཡར་མ་གཡར་མི་འདུག་གཡར་ན་འབུམ་༢ དང་༣ ཙམ་གཡོར་དགོས་ཀྱི་འདུག་ཅེས་གསུངས་པར་བརྟེན།",
    "གནས་ཚུལ་དེ་འདྲ་ཞིག་ཐོན་འདུག་མགྱོགས་པོར་རྒྱ་གར་ལ་ཡོང་ནས་སྐད་ཆ་དེ་ཚོ་གཙང་མ་བཟོས་ན་མ་གཏོགས་ཡག་པོ་མི་འདུག་གསུངས་བྱུང་།",
    "དེ་ངེས་པར་དུ་གསལ་པོ་བཟོ་དགོས་ཀྱི་འདུག་ཞུས་པ་ཡིན།",
    "ང་རང་དེ་ལ་ཧ་ཅང་ཕངས་པོ་འདུགཕྱི་ལོ་༢༡༦ ཟླ་༨ པའི་ནང་འབྲུག་རྒྱལ་ཡུམ་གྱིས་ངའི་སར་མི་གཅིག་བཏང་སྟེ།",
    "ཁྱེད་རང་ཡོང་བ་ཧ་ཅང་ཡག་པོ་བྱུང་ཟེར།",
    "ཕྱི་རྒྱལ་ནས་ཡོང་མཁན་རྒྱ་རིགས་ཚོ་ཧང་སངས་ཀྱི་འདུག་གསུངས་བྱུང་།",
    "ཁོས་ལན་རྒྱག་ཐུབ་ཀྱི་མི་འདུགསྐབས་དེའི་ཕྱག་ཡིག་ནི་གཤམ་གྱི་འདི་ལགས། ། མཁྱེན་རླབས་མཚུངས་བྲལ་མི་རྗེ་ཏེང་ཞའོ་ཕིང་མཆོག་ལ།",
    "དེ་བཀག་ན་མ་གཏོགས་ཡག་པོ་མི་འདུག་བསམ་པ་དང་།",
    "རྒྱ་ལོ་དོན་གྲུབ་ཁྱེད་རང་ཡར་ཡར་ཕྱིན།",
    "གང་ལ་འགྲོ་བཞིན་འདུག་བསམ་བློ་ཐོངས་དང་།",
    "ཁོ་རང་ལ་ནུས་པ་ཞིག་ཡོད་པས།",
    "ང་རང་པེ་ཅིང་ནས་ཧུའུ་ཡའོ་པང་ལ་ཐུག་པ་དང་།",
    "དོ་སྣང་དང་དོགས་ཟོན་ཧ་ལས་པ་བྱེད་ཀྱི་འདུག་ཧ་ཅང་གཟབ་ནན་བྱེད་ཀྱི་འདུག་ག་དུས་ཡིན་ནའང་།",
    "ཁོ་ཚོས་ལས་ཀ་ཡག་པོ་བྱེད་ཀྱི་འདུག་ཨང་།",
    "ཁོ་ཚོས་ལས་ཀ་ཡག་པོ་བྱེད་ཀྱི་འདུག་ཡིན་ན་ཡང་།",
    "ང་རང་མི་གཅིག་བང་ཆེན་གྱི་ཚུལ་དུ་ཕར་འགྲོ་ཚུར་འགྲོ་བྱེད་དགོས་པ་དེ་དཀའ་ལས་ཁག་པོ་འདུག་དེར་ལས་འགན་ལྗིད་པོ་དང་།",
    "ཕར་བཀའ་གནང་བ་ལན་སྐྱེལ་རྒྱུ་ལས་སླ་པོ་མི་འདུག་གཟུགས་པོའི་སྟེང་ནས་མ་ཡིན་པར་བསམ་བློའི་ཐོག་དཀའ་ལས་ཁག་པོ་འདུག་ང་རང་འདི་ལྟར་ཕར་འགྲོ་ཚུར་འགྲོ་བྱེད་པ་དེ་གང་འཚམ་ཞིག་ནས་ཕར་ཡང་མ་སླེབས་ཚུར་ཡང་མ་སླེབས་པ་ཆགས་ཉེན་ཆེ་བས།",
    "ཕན་ཚུན་དབར་གོ་བ་ལོག་པར་འགྲོ་བའི་ཉེན་ཁ་འདུག་པས།",
    "རྒྱ་ནག་ཕྱོགས་ནས་ཀ་ལཱི་ཀ་ཏར་གྲུ་གཟིངས་ཐོག་ནས་གོ་ལག་ཕབ་འདུག་ཟེར་བ་དེ་གོ་ལག་མིན་པར་རླངས་འཁོར་རྙིང་པ་ཁ་ཤས་གྲུ་ཁ་ནས་ཕབ་འདུག་དེ་སྐོར་རྩད་གཅོད་བྱས་པར།",
    "ཉིན་བཅུ་གྲངས་ལས་མི་འདུག་དེར་བརྟེན།",
    "དེ་ལའང་རྒྱ་མི་ཁོང་ཁྲོ་ཟོས་ནས་བསྡད་འདུགཡང་།",
    "དོན་མེད་དུས་ཚོད་འཕྲོ་བརླག་ཏུ་འགྲོ་བཞིན་འདུག་སྟབས།",
    "ཁྱེད་ཀྱིས་ད་བར་ཐའེ་ཝན་ལ་འབྲེལ་བ་མ་བྱས་པར་ལོ་མང་པོ་འགྲོ་བཞིན་འདུག་པས་ད་ཆ་འབྲེལ་བ་ཞིག་བྱས་ན་ལེགས་པ་དང་།",
    "ང་རང་ལོ་ན་མཐོ་ཞིང་གཟུགས་གཞི་བདེ་བོ་མེད་པ་དང་།",
    "ད་ཆ་བོད་དུ་ཕེབས་ནས་བཞུགས་དགོས་ཀྱི་འདུག་བསམ་གྱི་ཡོད།",
    "ཕྱི་ལོ་༡༩༨༥ ལོར་ང་རང་བོད་ལ་ཕྱིན་པ་ཡིན།",
    "ང་ཕོད་བཅས་ལ་ཐུག་འཕྲད་ཀྱི་དུས་ཚོད་བཀོད་སྒྲིག་བྱས་འདུག་པས།",
    "ཁྱེད་རང་དང་ཨ་རིའི་བར་དུ་ལོ་བཅུ་གྲངས་མང་པོའི་འབྲེལ་བ་དང་།",
    "གལ་ཆེན་པོར་བརྩི་བཞིན་འདུག་ཅེས་བཤད།",
    "ཕྱིས་སུ་དམིགས་ཡུལ་ལྟེ་བ་དེ་བརླགས་འདུགཕྱི་ལོ་༢༦ ལོར་ང་རྒྱ་ནག་ལ་བསྐྱོད་སྐབས།",
    "མཚན་སྨད་དང་སྐྱོན་འཛུགས་ཀྱི་གནས་ཚུལ་དེ་རིགས་ལ་རྣམ་པ་ཚོས་དོ་སྣང་དགོས་ཀྱི་འདུག་ཞུ་སྐབས།",
    "ལྷ་སར་འབྱོར་ནས་ནོར་བུ་གླིང་གའི་འཁྲིས་དེར་མགྲོན་ཁང་ཞིག་འདུག་པ་དེའི་ནང་བསྡད་པ་ཡིན།",
    "རྒྱ་མིས་ང་མི་མང་པོ་ཐུག་པ་ལ་འཛེམས་དགོས་ཀྱི་འདུག་སྟབས།",
    "ནོར་བུ་གླིང་ག་ཉམས་ཆག་ཆེན་པོ་ཕྱིན་འདུག་ཡིན་ནའང་།",
    "བདག་པོ་ཡག་པོ་བསྐྱོན་འདུག་ཞུ་དུས།",
    "གཞན་པ་དེ་ཚོ་ཤེས་ཀྱི་མི་འདུག་སྐབས་དེར།",
    "གཞན་པ་མི་འདུག་ཁོ་ཚོ་རྒན་པ་ཁ་ཤས་ཀྱིས་བོད་སྐད་ཤེས་ཀྱི་འདུག་ཆུང་བ་དེ་ཚོས་མི་ཤེས་པས།",
    "ང་འགྲོ་དུས་མི་ཚང་བཞི་བཅུ་ལྷག་ཅིག་འདུག་ཉེ་ཆར་ངས་ཁ་པར་ཞིག་བཏང་བར།",
    "དེང་སང་མི་ཚང་དྲུག་ཅུ་འདུག་ཟེར།",
    "ཧོང་ཀོང་ལ་ཕྱི་རྒྱལ་གྱི་མི་ཡིན་པ་ཡི་ཤུ་བླ་ཆེན་རྒན་འཁོགས་ཤིག་འདུག་ཡི་ཤུ་བླ་ཆེན་དེས་རྒྱ་མིའི་གནས་ཚུལ་སྐོར་མང་པོ་མཁྱེན་པ་དང་།",
    "ང་རང་ཡི་ཤུ་བླ་ཆེན་དེའི་སར་ཐེངས་ཤིག་བཅར་བ་ཡིན།",
    "དེང་སང་ང་ཡི་ཐང་ཆད་ཀྱི་འདུག་སྟབས།",
    "འཇུ་ཆེན་སོགས་ཕེབས་དུས་ལི་ཞན་ཉན་ལ་ཐུག་འདུག་ཕྱི་ལོ་༢༢ ལ་འཐབ་ཕྱོགས་གཅིག་གྱུར་གྱི་མགོ་གཙོ་གཞོན་པ་མ་གཏོགས་ཐུག་ཐུབ་མི་འདུག་ཀྱང་།",
    "ཁོས་ཧྲིན་ཀྲིན་དུ་སྣེ་ལེན་གྱི་ལས་ཀ་བྱེད་ཀྱི་འདུག་ཁོས་ལབ་སྟངས་བྱས་ན།",
    "དེ་ནས་ངས་མི་དམངས་ལ་ཞབས་འདེགས་ཞུ་ཟེར་བའི་རྒྱ་ཡིག་ཡིག་འབྲུ་ལྔ་དེ་ལག་ལེན་དང་རྩ་བ་ནས་མཐུན་གྱི་མི་འདུག་ཡི་གེ་དེ་དག་བསུབ་རོགས་གནང་ཞུས་པ་ཡིན།",
    "ཡི་གེ་དེ་བཀོག་ན་ཡག་པོ་འདུག་ལབ་པ་ཡིན།",
    "ཁོས་ཁྱེད་རང་བོད་ལ་འགྲོ་འདོད་མི་འདུག་གམ་ཞེས་སྐད་ཆ་འདྲི་བཞིན་འདུག་ངས་ཁོ་ལ་ད་ང་བོད་ལ་འགྲོ་རྒྱུ་ཡིན།",
    "གང་དྲག་ཅི་དྲག་ཅིག་གནང་རོགས་ལབ་འདུགང་ཕྱིར་རྒྱ་གར་ལ་འབྱོར་རྗེས།",
    "ཁྱེད་རང་ཁོང་ཁྲོ་གཏིང་ནས་ལངས་ཏེ་ཚུར་ཕེབས་འདུག་སྐུ་མཁྱེན།",
    "སྐུ་ཚབ་གསར་པ་ཞིག་གཏོང་རོགས་ལབ་ཀྱི་འདུག་ཟེར་ནས་སྙན་སེང་ཞུ་སྐབས།",
    "ཁྱེད་རང་ངོས་ལེན་མ་བྱས་ནའང་།",
    "སྐབས་ཤིག་ཁོས་ཉ་འཛིན་བྱེད་ཀྱི་ཡོ་ཆས་གཅིག་པུ་ལ་ཨ་སྒོར་ཁྲི་བཅུ་བཏང་ནས་ཉོས་ཡོད་འདུགབཞི་པ།",
    "ལས་ཀ་བྱེད་ཐུབ་རྒྱུ་ཕར་ཞོག་གོམ་པའང་རྒྱག་ཐུབ་ཀྱི་མི་འདུག་སྐུ་སྒེར་ཡིག་ཚང་དང་།",
    "ཁོ་ཚོར་འབྲེལ་བ་བྱེད་ཀྱི་མིན་ལབ་ཀྱི་འདུགངས་ཁོ་ཚོར་བཀའ་ཤག་དང་སྐུ་སྒེར་ཡིག་ཚང་ལ་འབྲེལ་བ་མ་བྱས་ན་དངོས་ཡོད་གནས་ཚུལ་དང་མཐུན་གྱི་མི་འདུག་ཁོ་ཚོར་ལས་འགན་ཡོད་པ་དང་།",
    "ངས་དེ་ལྟར་བསམ་གྱི་འདུགབོད་ཀྱི་སྲིད་དོན་གནས་སྟངས།",
    "ཧོང་ཀོང་ལ་ཆ་བཞག་ན་རྒྱ་མིའི་རྐུབ་ལ་རྒྱུག་མཁན་ཁྲ་ཁྲ་མང་པོ་འདུག་ཧོང་ཀོང་དང་བསྡུར་ནས་བལྟས་ཚེ།",
    "བཙན་བྱོལ་སྒྲིག་འཛུགས་འདི་ཡག་ཐག་ཆོད་འདུག་ལབ་ཐུབ་ཀྱི་མི་འདུག་སྟེ།",
    "དེ་ལས་ཤུགས་ཆེ་ཙམ་བྱེད་དགོས་ཀྱི་འདུག་རྒྱ་གར་གཞུང་ལ་མཚོན་ན།",
    "རྒྱ་ནག་ནང་ལོགས་ཀྱི་གནས་ཚུལ་ཧ་ཅང་འཁྲུག་པོ་འདུག་རྒྱ་ནག་གཞུང་དང་མི་དམངས་དབར་དང་།",
    "ལས་ཀ་དེ་ཡིན་གཅིག་མིན་གཅིག་གནང་དགོས་ཀྱི་འདུག་མ་གནང་བར་དེ་ལྟར་ལྷག་ན།",
    "སོ་སོའི་ནུས་པ་དེ་སྤྱི་པའི་ཐོག་འདོན་དགོས་ཀྱི་འདུག་དཔེར་ན།",
    "ཟིན་བྲིས་བཟོ་དགོས་པའི་བཀའ་མངགས་གནང་འདུག་དེའི་ཐོག་རོགས་པ་གནང་མཁན།",
    "གཟབ་ནན་གནང་ནས་གཉིད་སད་པ་ནང་བཞིན་ལས་ཀ་རྩོམ་དགོས་ཀྱི་འདུགརྒྱ་གར་གཞུང་ངམ།",
    "བོད་པ་ཚོ་ལ་སྐད་ཆ་དྲིས་ནས་ཁྱེད་རང་རྒྱ་མི་ཡིན་ནམ་བོད་པ་ཡིན་ཞེས་དྲིས་ན།",
    "གཉིས་ཐོག་ལ་ཕྱིན་ནས་ཆོ་མི་འདུག་བསམ་གྱི་འདུག་གང་ཡིན་ཟེར་ན།",
    "ང་གཅིག་པུ་དེ་ལྟར་འགྲོ་བསྡད་པ་དེ་ཡག་པོ་མི་འདུག་ངས་འདི་ནས་ཕྱིར་འཐེན་བརྒྱབས་ན།",
    "ང་བདེ་བོ་མི་འདུག་ང་རྒྱ་ནག་ཏུ་ཡོང་ཐུབ་ཀྱི་མི་འདུག་བཀའ་ཤག་དང་འབྲེལ་བ་གནང་རོགས་གནང་།",
    "ངས་ཞུས་པ་དེར་བདག་སྤྲོད་གང་ཡང་བྱེད་ཀྱི་མི་འདུག་ཞུས་པ་ཡིན།",
    "ཁ་ཤས་ཡོང་ནས་ང་ལ་རྒྱ་མི་ཨོ་ཙམ་འདུག་ཟེར།",
    "ཁྱེད་རང་འདི་ལ་ཡིན་གཅིག་མིན་གཅིག་སྡོད་དགོས།",
    "ག་བ་ཞིག་ནས་རྡོག་རྡོག་ཅིག་ག་དུས་ཐོན་གྱི་ཡོད་ན་བསམ་གྱི་འདུག་ཤེས་ཀྱི་མེད།",
    "ཏན་ཏན་གནས་ཚུལ་ཞིག་འདུག་བྱས་ཙང་།",
    "ང་རང་ཡིན་ན།",
    "ང་རང་བྲོས་བྱོལ་དུ་ཡོང་བ་དང་རྒྱ་གར་དུ་འགྲོ་མཁན་ཡིན་ཞུས་པ་ཡིན།",
    "ཞིག་གད་བ་གཡང་ཟ་བའི་ཁ་ན་འདུག་པའི་ཡལ་ག་འབྲས་བུ་སྨིན་པའི་ལྷོད་ཀྱིས་ཧུད་ཅིང་ཁ་དོག་སེར་བོར་གྱུར་བཞིག་མཐོང་ངོ།",
    "འདུག་འདུག་པ་ལས།",
    "སློབ་དཔོན་དྷརྨ་མ་འཇིགས་ཤིགཅེས་བརྗོད་འདུག་པས།",
    "མདའ་མདེའུ་རྣོན་པོ་ཅིན་ཕྱུང་ནས་བདག་ཉིད་ཆེན་པོ་དེ་གངན་འདུག་པ་དེ་ལོགས་སུ་རྟ་མགྱོགས་པ་དེ་བརྒྱུགས་པ་དང་།",
    "འགྲེ་གང་འདུག་པ་མཐོང་ངོ།",
    "གསང་ས་ནས་ལྷུང་སྟེ་སྣད་པའི་ཚོར་བ་མྱོང་བནི་སེམས་ལ་ཁྱབ་པར་གྱུར་ཏེ་འགྲོ་ཞིང་འདུག་པ་མཐོང་ངོ།",
    "ཕས་བུ་ལ་སློབ་པ་བཞིན་དུ་ཕན་གནོད་བླང་དོ་ར་བསྟན་ནས་རི་དྭགས་རྣམས་ཀྱིས་གོན་དང་བདག་པོ་བྱེད་ཅིང་འདུག་གོ།",
    "ཡོན་ཏན་ལ་བལྟས་ཏེ་མི་སྨྲ་བར་འདུག་གམ།",
    "རུ་ས་ཕན་བཏགས་པ་རྗེས་སུ་བསྐྱངས་ཏེ་མི་སྨྲ་བར་འདུག་གམ།",
    "འབབ་ཆུའི་འགྲམ་ཞིག་ན་ཡང་འདུག་གོར་མཆག་གོ།",
    "གསོལ་ཀ་བའི་ལག་ནས་རལ་གྲི་འདུག་པ་བླངས་ཏེ།",
    "འཇིག་རྟེན་རྣམས་དོན་ཡོད་པར་བྱེད་པ་དེས་སྙིད་རྗེ་སྐྱེས་པར་གྱུར་ནས་ཡུལ་གྱི་བདེ་། བ་ལ་སེམས་ཆགས་པར་གྱུར་པའི་རྒྱལ་པོ་ད་གཞལ་མེད་ཁང་གཙང་མ་བཟང་པོ་ཞིག་ན་འདུག་པ་དེའི་མདུན་དུ་ཚངས་པའི་འཇིག་རྟེནནས་འོད་འབར་ཞིང་བབས་ཏེ་འོངས་པར་གྱུར་ཏོ།",
    "ས་ལ་འགྲོ་བ་བཞིན་དུ་ནམ་མཁའ་ལའང་འཆག་པ་དང་འདུག་པར་བྱེད་ལ།",
    "ཞེས་འདུག་པ་ལྟར་ན།",
    "འདུག་པ་འདྲ།",
    "ཕྱོགས་ཕྱོགས་སུ་བལྟས་པ་ན་བདག་ཉིད་ཆེན་པོ་དེས་སྐད་ལུང་བསྟན་པ་བཞིན་དུམཚོ་དེ་དང་མི་རིང་བ་ཞིག་ན་གླང་པོ་ཆེ་ཤི་ནས་རིང་བོམ་ལེན་པའི་རོ་ཞིག་འདུག་པ་མཐོང་ངོ།",
    "མ་འཇུངས་ཤིང་རང་བཞིན་བཟང་བའི་ཕྱིར་རྒྱལ་པོས་རྒྱལ་ཚབ་ཀྱི་ལོངས་སྤྱོད་བྱེད་དུ་འཇུག་གོ།",
    "དེ་དེ་ན་འདུག་པའི་དྲུང་དུ་བྲམ་ཟོ་ལོགས་པར་སྨྲ་བ་ལ་མཁས་པ་ཞིག་འོངས་ཏེ།",
    "དེའི་ཚེ་རྒྱལ་པོ་ངལ་ནས་རྟ་ལས་བབས་ཏེ་འདུག་པ་ན།",
    "ལུས་རབས་གཟུགས་ནི་ཐམས་ཅད་མི་དང་འདྲ་ལ་རྐང་པ་འབའ་ཞིག་ཁྲ་བོར་འདུགགྲོ།",
    "གདོང་ནི་ཁ་སྐུ་རིང་པོ་འཇིངས་ཕས་ངམ་གནག་པར་གྱུར་པ་ཁྲོས་ཤིང་རྔན་པའི་མིག་བགྲད་ཅིང་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "བྱང་སེམས་ཟླ་བའི་བྱད་གཟུགས་བཟང་པོ་ཕུན་སུམཆོགས་པ་ལ་ཡད་ཆགས་ནས་མིག་བགྲད་དེ་ལྟ་ཞིང་ངལ་བསོ་ཤིང་འདུག་གོ།",
    "སྨོད་ཅིང་འདུག།"
  ]
}