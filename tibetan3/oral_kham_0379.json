    "གླང་པོ་ཆེའི་འདུག་སྟངས་ཀྱིས་ལྟ་བ་མིག་མི་འཛུམ་པར་ནམ་མཁའ་ལ་ཧར་པོར་ལྟ་གཡས་གཡོན་དུ་མི་ལྟའོ",
    "ལུས་མི་འགུལ་འདུག་སྟངས་གོང་དུ་བསྟན་པ་ལས་མ་ཞིག་པར་གནས་པའོ",
    "ངོ་མཚར་བ་སྤྲོས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བར་བྱེད་སྐུ་གསུམ་མཚན་མ་དང་བྲལ་བ་ཐངས་ཀྱི་འབྲས་བུ་མིང་དུ་བྱ་བའོ་པ་ཅེས་བྱ་བ་ནི་ཡིད་ཀྱི་སེང་གེ་ཡིད་ཀྱི་རིག་པའི་ཆོ་འཕྲུལ་དྲན་པ་ལ་བལྟས་པས་དྲན་མེད་དུ་གྲོལ་དྲན་མེད་ལ་བལྟས་པས་བློ་འདས་སུ་ཟངས་འདུག་པས་ཡེ་ནས་སྐྱེ་མེད་དུ་གོ་བའོ",
    "འདུག་སྟངས་རྣམ་ཟངས་གསུམ་བསྟེན་པས་གྲོལ་ས་ཅེར་ཚད་ཟིན",
    "ཞག་ལྔ་ཙམ་འཕྲལ་གྱི་བདེ་བ་དང་ཡུན་གྱི་བདེ་བ་ལ་བསམས་ཏེ་འཇིག་རྟེན་འདི་ཡི་བདེ་བ་བག་ཙམ་ཡུད་ཙམ་སྐད་ཅིག་ཙམ་ལས་མི་འདུག་ཕྱི་མའི་བདེ་བ་ཐོབ་པར་བྱའོ།",
    "འདུས་བྱས་ཐམས་ཅད་རྟག་ཏུ་མི་རྟག་འཆི་པར་འདུག་ཨང་སྙམ་པ་རྒྱུད་ལ་སྐྱེས་པ་ངདང་",
    "བྱས་འཇིག་རྟེན་གྱི་པ་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྒྱུར་འདུག་ཨང་དོན་མེད་རྟག་ཏུ་སྡུག་བསྔལ་སྙམ་པ་རྒྱུད་ལ་སྐྱེས་པ་དང་",
    "འགྱུ་བྱེད་དང་བྲལ་བའི་རིག་པ་བསམ་པ་འདུག་པར་གཞུག་པ་འདི་ཉིད་ནི",
    "རིག་པ་རང་སྣང་ཡིགག་དབྱིངས་ཀྱི་ཡུལ་དུ་ཐ་དད་ཟེར་བའང་འདུག་གཟུགས་ཐམས་ཅད་རང་གཞན་མ་གྲུབ་པ་གནས་གང་དུ་གཏན་ལ་དབབ་པ་དང་",
    "དེ་ནས་ལུས་ངག་ཡིད་ཀྱིས་བྱ་བ་ཅི་ཡང་མི་བྱ་བར་ལྷ་དང་སྔགས་ལ་སོགས་པ་ལྟ་སྒོམ་གྱི་བྱ་བ་ཡང་མེད་པར་ཐ་མལ་པ་ལྟར་ཤིན་ཏུ་དལ་བར་ཞག་དགུ་ནས་བཅུ་ཙམ་དུ་ཤེས་པ་གང་ཡང་འཕྲོས་པར་འདུག་ན་དེ་ལ་ཡུན་རིང་བར་རྣལ་དུ་མ་བཅོས་པའི་རིག་པ་འདི་ཡིན་ང་",
    "ཡན་ལག་མགོ་སྒྲིལ་བ་ལུས་བསྒུལ་བ་དྲག་ཏུ་བསྐུམ་པ་ཙོག་པུར་འདུག་པ་ཉལ་བ་དང་",
    "ལངས་པ་དང་འདུག་པ་ལ་སུག་བཞི་སར་བཙུགས་ཏེ་འགྲོ་བ་གན་རྐྱལ་ཉལ་བ་རྐང་ལག་བཞི་གནམ་ལ་བསྟན་ཐང་བཅད་དེ་བརྒྱང་བ་གཡབ་པ",
    "ལུས་ཙོག་པུར་འདུག་སྟེ་རྐང་པའི་ལོང་བུ་གཉིས་སྦྱར་ཏེ་གཤིབས",
    "ལུས་ཀྱི་འདུག་སྟངས་འདི་ལྟར་གྱིས",
    "རིག་པ་འདི་ཉིད་མངོན་སུམ་མིག་ལ་དུ་མ་མཐོང་འོད་གསལ་བའི་ངོ་བོ་ཞིང་བལྟར་མེད་པས་ཡིད་འདི་ཁོ་ན་ཡིན་པར་འདུག་སྙམ་པ་ནི་ཡིད་ཀ་དཔྱོད་དོ",
    "སེམས་གནས་མི་རྟོགས་པ་བག་ཙམ་པ་གཅིག་ལ་ཆགས་ནས་བདེ་བར་འདུག་སྙམ་པ་ཡིན་ཏེ",
    "དོན་ནི་ནམ་མཁའ་ལ་བསྟན་པའི་རིག་པ་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་འཁྲུལ་པ་མེད་པའི་ཤེས་པ་དེ་ཧྲིག་ཧྲིག་དུ་འདུག་ཀྱངགཟུང་བ་ཡུལ་གྱི་ཆ་དང་འཛིན་ཆ་ཤེས་པས་རྟག་ཏུ་མེད་དེ་སྣང་བ་རང་སྣང་",
    "དེ་ལྟར་སྣ་ཚོགས་སུ་འདུག་པའི་སྣང་བ་ཐམས་ཅད་དེའི་རིག་པའི་ངོ་བོ་ལས་མ་འདས་པའོ",
    "དེ་ཡང་རིང་བ་རྒྱུད་ཀྱི་ངོས་ནས་བལྟས་ན་ཕྲ་བར་འདུག་སྟེ",
    "བར་གྱི་ངོ་ནས་བལྟས་ན་ལུ་གུ་རྒྱུད་ཀྱི་ཚིག་ཐིག་ལེར་འདུག་པས་གསལ་བ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཡིན་པས་གཞན་ན་ཡོད་པ་ནི་མ་ཡིན་ནོ",
    "བསྐྱེད་སྣང་བ་རང་ཆས་ཡིན་པས་པར་བྱ་བའི་གཞལ་ཡས་ཁང་འདུག་གམ",
    "ཐམས་ཅད་རང་ལ་ཤར་བས་མཆོད་ཅིང་བཤགས་པའི་བདག་པོ་འདུག་གམ",
    "མིང་ཐམས་ཅད་དང་བྲལ་བས་སྡོམ་པར་བྱ་བའི་དམ་ཚིག་འདུག་གམ",
    "མ་རིག་པ་ལ་སོགས་འཁྲུལ་པ་གྲུབ་ནས་འདུག་གམ",
    "མཇིང་པ་ཡིད་ཙམ་དགྱེ་བར་བྱ་བ་ནི་ལུས་ཀྱི་འདུག་སྟངས་སོ",
    "ཁྱིམ་མུན་ནང་དུ་འདུག་པའོ",
    "དེའི་བར་དུ་དེ་ལྟ་བུའི་ཉམས་སྐྱེས་ནས་འདུག་ན་ལུས་རྣལ་དུ་འབེབས་ཕྲ་པ་ཞེས་བྱ་སྟེ་སོར་ཆུད་པའི་དོན་དུ་ཡང་དུར་ཁྲོད་དེར་གཏང་སྟེ",
    "དེ་ལྟར་བྱུང་ཙ་ན་ཡང་ཡིད་སོར་ཆུད་པར་བྱ་ཞིང་རྣལ་དུ་ཕབས་པའི་ཐབས་ཞག་བཅུ་ནས་ཟླ་བ་ཕྱེད་དུ་ཡིད་དལ་བར་གནས་པར་བྱའོ",
    "ད་ནི་ལུས་ལ་རིག་པ་གནས་པས་རྣལ་འབྱོར་པ་རྣམས་ལུས་ཀྱི་འདུག་སྟངས་ཀྱི་མན་ངག་གབ་པ་རྣམས་མངོན་དུ་ཕྱུངས་ཏེ་བསྟན་པའོ",
    "དེ་ཀུན་ལ་སྐྱོ་ན་འདུག་སྟངས་དེ་མ་ཡིན་པ་རྣམས་ལ་ཡང་ལུས་སྦྱང་བར་བྱའོ",
    "དེའི་ཕྱིར་ན་སྔོན་དུ་འགྲོ་བ་ལུས་ཀྱི་འདུག་སྟངས་འདི་རྣམས་དང་ཞག་དུ་མར་སེམས་སྦྱང་ཞིང་ལུས་གཅུན་པ་ནི་རབ་ཏུ་གཅེས་སོ",
    "འདུག་སྟངས་རྣམས་ལ་རང་ལུས་སྦྱང་",
    "འདི་ལྟར་གཏན་ལ་ཕབ་ནས་ཉམས་སུ་བླངས་པས་རྟགས་ནི་འདོད་པ་མེད་ཀྱང་རང་བཞིན་དུ་འབྱུང་ངེས་སོ",
    "རི་དྭགས་དམན་པའི་ཚུལ་གྱིས་འདུག་འདུ་འཛི་སྤངས་པའི་ས་ཕྱོགས་སུ",
    "ཐ་མལ་པ་ནི་ཚུལ་གྱིས་འདུག་དགྲ་གཉེན་མེད་པའི་ས་ཕྱོགས་སུ",
    "སྤྲང་པོ་ལྟ་བུའི་ཚུལ་གྱིས་འདུག་ཡུལ་དམིགས་མེད་པའི་ས་ཕྱོགས་སུ",
    "ཅི་དགར་སྤྱོད་པའི་ཚུལ་གྱིས་འདུག་ཨེ་མ་ཧོ",
    "ང་རང་མཐོང་ལ་ཐམས་ཅད་མེར་ཉམས་སུ་ལེན་པ་གསང་བའི་དེབས",
