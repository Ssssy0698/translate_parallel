    "སྤྱིར་བཏང་ང་རང་ཡང་འདྲ་ཆགས་བོ་དང་སྒམ་པོ་བྱེད་རྒྱུར་དགའ་བོ་མེད།",
    "འདི་ལོ་དགོན་བ་གསར་བ་ཞིག་བཞེངས་འདུག་བའི་ཉེ་འགྲམ་དུ་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོའི་གཟིམ་ཆུང་ཞིག་ཀྱང་གསར་བཞེངས་ཞུས་འདུག།",
    "འདི་དག་རང་འགུལ་གྱིས་བྱུང་བ་མིན་པ་དང་རང་འགུལ་གྱིས་གཏོརབཤིག་ཡོང་ཐབས་མེད་ན།",
    "བླ་ཆེན་མཆོག་ནས་༧གོང་ས་མཆོག་མཇལ་བར་ཤིན་ཏུ་དགྱེས་མཉེས་ཆེན་པོ་དང་བཅས་ཕེབས་ཁར་༧གོང་ས་མཆོག་ཁྱེད་རང་ངའི་སྤུན་མཆེད་ངོ་མ་དང་ཁྱད་མེད་ཡིན་བས་ངའི་ཁང་བ་འདི་ཁྱེད་ཀྱི་གཟིམ་ཤག་ཡིན་དགོངས་དེ་ནིའུ་ཡོག་ཏུ་ག་དུས་ཕེབས་ཀྱང་ངེས་པར་དུ་ཆིབས་བསྒྱུར་གནང་རོགས་ཞེས་ཞུ་གནང་མཛད།",
    "ད་ཆ་བོད་ཡུལ་དེ་རྒྱ་མིའི་མི་སེར་སྤེལ་ཡུལ་ཆགས་ཀྱི་འདུག།",
    "བྱེད་ཀྱི་མི་འདུག་ཅེས་རྒྱབ་བཤུད་བྱས་ན་ཕན་ཐོགས་མི་འདུག།",
    "ཨ་རིའི་མི་ཡང་ཁ་ཤས་སླེབས་འདུག།",
    "ཁོང་ཚེས་༧གོང་ས་མཆོག་སྐུ་ཚེ་༧ཞབས་བད་བརྟན་པ་དང་ཐུཌ་བརྩེའི་སྐྱབས་འོག་ནས་མི་འདོར་བའི་སྐྱབས་འཇུག་ཞུསདགོང་དྲོ་འཛམ་གླིང་བཀྲིན་རྗེས་དྲན་ཚེགས་བ་ནས་ྨགོང་ས་མཆོག་ལ་གསོལ་སྟོན་གཟབ་རྒྱས་ཤིིག་འདེགས་འབུལ་ཞུས་གསོལ་སྟོན་དུ་ས་གནས་དེ་གའི་གནས་ཡོད་མི་གྲངས་སྐོར་མགྲོན་འབོད་གནང་འདུག།",
    "ཡིན་ནའི་ཁྱེད་ཚེ་སྐྱིད་སྣང་དོད་བོ་འདུག།",
    "ང་རང་སྐྱེས་ཤིང་འཚར་ལོངས་བྱ་ཡུལ་གྱི་ལུང་པ་དང་།",
    "ང་རང་ཆུང་ཆུང་སྐབས་ནས་སེམས་འགུལ་ཆེན་པོ་ཐེབས་པ་ཞིག་ནི།",
    "ཁོ་རང་དང་མཉམ་དུ་དཀའ་ལས་རྒྱག་མཁན་རྒྱལ་སྲུང་བློན་ཆེན་ཕིང་ཏེ་ཧེ་དང་།",
    "བསམ་བློ་ཡག་པོ་བཏང་སྟེ་ལས་ཀ་དེ་ཏན་ཏན་ཞིག་བྱེད་དགོས་ཀྱི་འདུག་ཅེས་རྗོད་ཀྱི་ཡོད།",
    "ང་རང་ཕྱི་ལོ་༡༩༤༩ ལོར་རྒྱ་གར་ལ་འབྱོར་སྐབས།",
    "བོད་གཞུང་དང་རྒྱ་གར་དབར་ལ་འབྲེལ་བ་གང་ཡང་མི་འདུག་རིམ་བཞིན་བདེ་སྐྱིད་གླིང་གའི་ཨིན་ཇིའི་སྐུ་ཚབ་ཀྱི་ཚབ་ལ་རྒྱ་གར་གྱི་སྐུ་ཚབ་ཕེབས་ནས་འབྲེལ་བ་ཡག་པོ་བྱུང་བ་དང་།",
    "ང་རང་བཅས་གསུམ་དང་མཉམ་དུ་རྒྱ་རིགས་ཡིན་པ་ཧྥུ་ལིན་བཟའ་ཚོ་གཉིས་དང་།",
    "མགྲོན་པོ་འདུག་ས།",
    "ཚོང་རྒྱག་མཁན་ཡོད་འདུག་ལ།",
    "ཁོང་གཉིས་ཀྱི་འབྲེལ་ལམ་ཧ་ཅང་ཡག་པོ་ཡོད་འདུག་ཡིན་ནའང་།",
    "ཚ་ཐབ་དེའི་ནང་གསེར་དང་དངུལ་གྱིས་ཁེངས་འདུག་ཟེར།",
    "ཁྱེད་རང་མ་ངུ་ཞིག་ཡང་བསྐྱར་མིང་ཐོ་གསར་པ་བསྡུ་རུབ་ཀྱིས་ཁྱེར་ཤོག་ཅེས་གསུངས་པས།",
    "ད་ལྟ་ཁྱེད་རང་སྡུག་པོ་བྱུང་ནའང་།",
    "སྒོ་རའི་ནང་ལ་རྟ་དྲེལ་མང་པོ་འདུག་ལ།",
    "ངའི་ཕ་མ་གཉིས་ཀས་ཡང་སྲིད་བརྟག་དཔྱད་ཞུ་སྒོར་རང་བཞིན་གྱིས་ངོས་ལེན་བྱས་འདུག་པ་ལྟར།",
    "མཱ་པུ་ཧྥང་ལའང་ཞུ་བ་འཐེན་རོགས་གསུངས་འདུག་ཀྱང་།",
    "པ་ལགས་ཀྱིས་ཁྱེད་རང་གཅིག་པུར་རྟ་བཞོན་ནས་འགྲོ་ཐུབ་ཀྱི་ཡོད་དམ་ཅེས་དྲིས་བྱུང་།",
    "རྣ་ཡག་སོགས་བརྒྱ་ཕྲག་དུ་མ་ཁྱུ་དང་ཁྱུ་བྱས་ནས་འགྲོ་བཞིན་ཡོད་པ་མཐོང་རྒྱུ་འདུག་ལ།",
    "གཞུང་ཞབས་སྐུ་དྲག་སྐོར་ཞིག་ཀྱང་ཕེབས་འདུག་དེ་ནས་བྱང་འབུམ་ཆེན་དུ་གཞུང་འབྲེལ་ཕེབས་བསུ་གཉིས་པས་མཇལ་ཕྱག་ཞུ་སྐབས།",
    "མཱ་པུ་ཧྥང་ལ་བསྟུན་ཤེས་གནང་སྟངས་སོགས་ཐབས་མཁས་པོ་དང་འཇོན་པོ་ཞེ་དྲགས་བྱུང་འདུགཕྱི་ལོ་༡༩༣༩ ཟླ་༡ ཚེས་༨ སྟེ།",
    "ལྷ་ཕེབས་པ་སོགས་མང་པོ་འདུགདེ་ནས་ཐོག་མར་ནོར་བུ་གླིང་གར་ཕེབས་པ་དང་།",
    "རྒྱ་ནག་ནས་ཕྱིར་ག་དུས་ཕེབས་མིན་གཏན་འཁེལ་བ་ཞིག་མེད་སྟབས།",
    "ང་རང་རྒྱ་ནག་ལ་སློབ་སྦྱོང་དུ་མ་ཕྱིན་སྔོན་ལ།",
    "སྐབས་དེར་ང་རང་ལོ་བཅུ་གཉིས་ཙམ་ཡིན།",
    "ཁྱེད་རང་གཉིས་ཀྱིས་སེམས་ཁྲལ་གནང་མི་དགོས།",
    "ཁོང་མ་བཟུང་གོང་ལ་ངའི་པ་ལགས་གཤེགས་འདུག་ང་དེ་དུས་རྒྱ་ནག་ལ་ཡོད།",
    "རོགས་པ་གནང་རོགས་ཞུས་འདུག་རྭ་སྒྲེང་ཛ་སག་ལོག་རྗེས།",
    "ང་རང་གཅིག་པུ་སྡོད་ས་དང་།",
    "སྐབས་དེར་གནམ་གྲུ་ཤི་ཨན་དང་ལན་ཀྲོའུ་ལ་འབབ་པ་ལས་ཟི་ལིང་ལ་འབབ་ཐུབ་ཀྱི་མི་འདུག་ལན་ཀྲོའུ་ནས་སྣུམ་འཁོར་ལ་བསྡད་དེ་ཟི་ལིང་ལ་འགྲོ་བཞིན་ཡོད།",
    "མི་ཚང་མས་དངུལ་རྣམས་དངོས་ཟོག་དང་གསེར་ལ་བརྗེ་ཐབས་བྱེད་ཀྱི་འདུགསྐབས་དེར།",
    "ཕྱི་ལོ་༡༩༤༩ ལོར་གུང་ཁྲན་ཏང་ནན་ཅིན་ལ་མ་སླེབས་གོང་དེར་ང་རང་ཧོང་ཀོང་ལ་ཕྱིན་ནས་ཟླ་བ་གཉིས་ལ་བསྡད་པ་ཡིན།",
    "རྒན་འཁོགས་ཁོང་རྗེས་སུ་རྒྱ་ནག་ནས་ཧོང་ཀོང་ལ་སླེབས་འདུག་ང་ཁོང་དང་འབྲེལ་ལམ་ཧ་ཅང་ཡག་པོ་ཡོད།",
    "ནིའུ་ཡོག་དུས་བབ་དང་།",
    "མགྱོགས་པོར་བོད་ལ་ལོག་ན་ཡག་པོ་འདུག་ཟེར།",
    "ཏར་གྱི་ཐོག་ལ་ཡབ་གཞིས་སྲས་རྒྱ་ལོ་དོན་གྲུབ་རྒྱ་ནག་ཏུ་བསྡད་ན་བོད་ཀྱི་བསྟན་པ་ཆབ་སྲིད་ལ་གནོད་ཀྱི་འདུག་ཅེས་བྲིས་འདུག་སྐུ་ངོ་རྣམ་པ་ཚོས་ཏར་ལན་ལ།",
    "མིང་རྟགས་འགོད་དགོས་ཆགས་འདུག་དངོས་གནས་བྱས་ན།",
    "ང་རང་དེར་གནས་ཚང་གཡར་ནས་བསྡད་པ་དང་།",
    "ཕྱི་ལོ་༡༩༤༩ ལོར་ང་རང་བོད་ལ་ལོག་རྒྱུའི་འཆར་གཞི་ཡོད་ཀྱང་།",
    "ང་ཀ་ལོན་སྦུག་ལ་ཕྱིན་ནས་དེ་སྐོར་བཀའ་ཤག་ལ་སྙན་སེང་ཞུ་དགོས་ཞེས་ནེཧ་རུས་མངགས་ཆ་གནང་འདུགཉིན་དེར།",
    "ཀྲུའུ་ཏེ་ཡིས་ང་ལ་ཡི་གེ་ཞིག་ཀྱང་བསྐུར་འདུག་ཡི་གེའི་ནང་།",
