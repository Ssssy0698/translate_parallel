    "མྱོང་བར་མི་འགྱུར་ནའང་རང་བཞིན་ལྷུན་གྲུབ་ཀྱི་རྩལུ་ལམ་གདངས་འགགས་པ་མེད་པ་ལས་རོལ་པ་སྣ་ཚོགས་པ་འཁོར་འདས་ཅིར་ཡང་སྣང་རུང་བ་ཡིན་ནོ།",
    "དེ་ཡང་ངོ་བོ་རིག་པ་ཡོན་ལ་བཞག་དུས་སེམས་གང་དགར་རང་སངས་ལ་བསྐྱར་བ་ཡིན་ནོ།",
    "སྤང་གཉེན་གང་ཡིན་ཡོན་ཀྱང་རང་གྲོལ་རྗེས་མེད་དུ་གྱུར་པ་ཤིན་ཏུ་ངོ་མཚར་བ་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་པའོ།",
    "དྱེ་ལྟར་ལྟ་བརྒྱ་སྒོམ་སྤྱོད་གསུམ་ཟུང་འཇུག་ངང་ལ་གོམས་སུ་འཇུག་པ་ལས་གཞན་པའི་རྟོགས་པར་བྱ་བའི་འབྲས་བུ་ཞེས་པ་ཡོད་པ་མ་ཡིན་པས་བསྒྲབ་མི་དགོས་ཏེ་དེ་ཉིད་ཀློང་དུ་ཕེབས་ཙ་ན།",
    "བསྙེན་པ་ལ་འཇུག་དུས་དང་།",
    "བཟོ་རིག་པའི་ཞབས་ཏོག་རྒྱུ་གསེར་དངུལ་ལ་སོགས་པ་ཟས་ནོར་གྱི་ཕུང་པོ་ཆེན་པོ་དགོས་པ་འདུག་ནའང་།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྤྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྤྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར།",
    "གང་ཞིག་མ་སྤྱད་ཕྱེད་ཀྱི་ཆུ་ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་བེེགས་ཀྱུ་ཡིས།",
    "ལག་པའི་རྒྱབ་ཀྱིས་སོད་ཅིག་ངེས་པར་རབ་ཏུ་བརྗོད་དེ་མངོན་དུ་ཕྱོགས་པས་འདུག་ཅིག་འདུག་ཅིག་གོ།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནབ།་",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོ་རང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀི་ང་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སི་དང་འདིར་ནི་ངྐ་ཉིད་དོ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར།",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "ལྷ་དང་རང་འཇིགས་ཕ་མེས་དང་།",
    "བྱེད་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "བརྒྱ་བྱེན་ལ་སོགས་པ་འདི་དག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རང་རང་ལས་ལ་ཉེར་སྤྱོད་པས།",
    "རང་རང་རྒྱུ་བ་ལས་རབ་གྲུབ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད་ཅེས་པ་སྟེ།",
    "དེ་བཞིན་དུ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར་ཏེ་རིམ་པ་འདི་ནི་སྔར་བརྗོད་པ་ཡིན་ནོ།",
    "དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་སྟེ་ཉིན་ཞག་དྲུག་ཅུ་རྩ་བཞི་ལ་དེ་ནི་ཆ་དམན་ཟླ་བ་སྟེ་ཟླ་བའི་ཆ་ཉམས་པའོ་ཞེས་པའི་དོན་ཏོ།",
    "འདི་དག་རྣམས་ཀྱང་རང་བཞིན་གསུམ་སྟེ་གཡོ་བ་ལུག་ལ་སོགས་པ་དང་བརྟན་པ་གླང་ལ་སོགས་པ་དང་མཉམ་པ་གཉིས་ཀྱི་རང་བཞིན་འཁྲིག་པ་ལ་སོགས་པའོ།",
    "ཉིན་ཞག་དུས་ཐུན་བརྒྱད་ཀྱི་བདག་ཉིད་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་དག་ལས་ལྷན་ཅིག་སྐྱེས་པའི་སྐུ་ནི་པདྨ་གསུམ་ལ་རང་བཞིན་དང་རང་བཞིན་མེད་པའི་དབྱེ་བས་སོ།",
    "དེའི་ཕྱིར་གསང་བའི་པདྨ་དང་གཙུག་ཏོར་གྱི་པདྨ་དང་ལྟེ་བའི་པདྨ་ལ་རྣམ་པར་དག་པའི་སྒུ་ལྷག་པའི་ལྷ་སྟེ་རང་བཞིན་རྔེད་པ་མ་བརྟགས་པ་དང་རང་བཞིན་པྲ་ཕབ་པ་ལྟ་བུའོ།",
    "རིགས་པ་འདི་ལས་མངལ་ནས་སྐྱེས་པའི་བྱིས་པ་གང་ཞིག་དུས་མ་ཡིན་པར་འཆི་བར་འགྱུར་བ་༥།",
    "དེ་ཡི་དབུས་སུ་རང་རང་བསམ་པས་མི་བདག་ནི་བོད་པ་སྟེ།",
    "ཞེས་པ་དེབ་འདིའི་ལྡེབ་༥༩༨ང་༡འདི་༦ང་༡༥པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་སྔ་སྣར་རོལ་ཆད་འདུག་ཁྱེ་པེ་སྣར་གྱི།",
    "གཞན་ནི་ཡོད་པའི་ལུས་ལྔ་ཞེས་པ་ནི་ཁ་ཟས་ཅན་གྱི་ལུས་དང་འོད་ཀྱི་ལུས་དང་རང་བཞིན་ཅན་གྱི་ལུས་དང་།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་པར་༤གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཅི་ལྟར་འགྲོ་ཞེས་པ་ནི་འདིར་སད་པའི་དུས་སུ་སད་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱ་བ་དང་བཅས་ཤིང་།",
    "འོག་ཏུ་ཡེ་ཤེས་ཀྱི་ཁམས་ལས་སྐྱེས་པ་ཡིད་ནི་ཀུན་ཏུ་བཟང་པོ་ཁ་དོག་སྔོན་པོ་ཞལ་གསུམ་པ་ཕྱག་དྲུག་པ་ཁ་དོག་དུས་ཀྱི་འཁོར་ལོ་ལྟ་བུ་སྟེ་ཤར་གྱི་སྒོའི་གཡོན་དུ་ར་བའི་རྩིག་པ་ལའོ།",
    "རང་རང་ཞིང་དུ་རབ་ཏུ་གཞུག་ཅེས་པའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "རྣམ་པར་དག་པ་དེས་ལྷ་རྣམས་ཀྱི་སྟབས་དང་འདུག་སྟངས་ཙུ་རྣམ་པར་དག་པར་འགྱུར་ཏེ་གཡོ་བ་མེད་པ་ལས་སོ་ཞེས་པ་ངེས་པའོ།",
    "ཨོཾ་ལོ་ཙ་ནེེ།",
    "ཐབ་དང་འདུག་སྟངས་༡ལ་སོགས་པའི་ཆོ་གས་གྲུབ་པར་འགྱུར་བ་ཇི་སྲིད་ཉིད་དུའོ།",
    "དེ་བཞིན་དུ་བྱང་དུ་ར་པ་ཙ་ནཱ་༧ཡ་ཏེ་ན་མ་ཞེས་པ་སྟེ་བཛྲ་ཏཱིཥྛ་ལ་སོགས་པ་ཡི་གེ་རྣམས་སོ།",
    "གལ་ཏེ་འཆད་པར་འགྱུར་བའི་འདུག་སྟངས་བཅིངས་ནས་ཐུན་ཚོད་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱེད་པར་མི་ནུས་ན་དེའི་ཚེ་ཐུན་ཕྱེད་གཅིག་སྦྱིན་སྲེག་བྱས་ནས་བསྒྲུབ་པར་བྱ་སྟེ་གཉི་ག་གསུངས་སོ།",
    "ད་ནི་ཞི་བ་ཞེས་པ་ལ་སོགས་པས་ཞི་བ་ལ་སོགས་པའི་ལས་སྒྲུབ་པའི་དོན་དུ་འདུག་སྟངས་རྣམས་གསུངས་ཏེ།",
    "འདིར་ཞི་བ་ལ་སོགས་པ་ལ་རིམ་པས་འདུག་སྟངས་རྣམས་སུ་འགྱུར་རོ།",
    "རྒྱས་པ་ལ་རྡོ་རྗེའི་འདུག་སྟངས་ནི་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དང་གཡོན་པ་ཡང་བརླ་གཡས་པའི་སྟེང་དུ་སྟེ་ཐད་ཀར་གན་རྐྱལ་གྱིས་སོ་ཞེས་པ་ནི་རྡོ་རྗེ་འདུག་སྟངས་སོ་༧།",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ།",
    "དེ་དག་ཀུན་ལ་གསོལ་བ་བཏབ་ནས་སེང་ལྡེང་རང་བཞིན་སྲ་བའི་ཕུར་བུ་རྣམས་ཀྱིས་༥ས་ལ་གདབ་སྟེ་འཆད་པར་འགྱུར་བའི་རིམ་པས་སོ་ཞེས་པ་ནི་གསོལ་བ་གདབ་པའི་ངེས་པའོ།་།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།་།",
    "ཨོཾ་བེ་རོ་ཙ་ནཱ་ཡ་ན་མ།",
    "ཨོཾ་ལོ་ཙ་ནཱ་ཡི་ན་མ།",
    "ལྔ་པ་ནི་ཟར་མ་དང་བ་ར་ཊཱི་དང་བརྨྱོ་ཏྲེདང་ཀུ་ལན་ཐ་དང་ཙ་ན་ཀ་ནག་པོ་སྟེ་ལེ་ཚེ་སྦྱར་བའི་ཆས་འབྲུ་ལྔ་ཇི་ལྟར་རྙེད་པ་གཟུང་བར་བྱའོ།",
    "ཁུ་ཚུར་གྱིས་མཐེ་བོ་བསྡམས་པ་དག་བརླ་གཡས་པ་༥དང་གཡོན་པའི་སྟེང་དུ་རྡོ་རྗེའི་འདུག་སྟངས་ཙིལ་གནས་པ་ནི་རྡོ་རྗེའི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "མངོན་དུ་ཕྱོགས་པ་སྟོན་པར་གྱུར་ན་འདུག་ཅིག་ཅེས་བརྗོད་པའོ།",
    "སླར་ཡང་རང་བཞིན་རྣམས་ཀྱིས་རྣམ་པ་མང་པོར་རིག་པར་བྱའོ་ཞེས་པ་ནི་ལྟ་སྟངས་ཀྱི་བརྡའི་ངེས་པའོ།",
    "ཕྱེད་དང་གཅིག་དུས་རི་བོང་ཅན།",
    "དེ་བཞིན་དུ་གཡོན་གྱི་གདོང་པ་གང་ཡིན་པ་དེ་ནི་གཡས་ཀྱི་སྟེ་དེའི་ཁ་དོག་ཉིད་ཀྱང་རང་འོད་ཅེས་པར་མི་འགྱུར་རོ།",
    "འདི་དག་དུས་ཀུན་རྣལ་འབྱོར་རྣམས་ལ་བདེ་མཉམ་འབྲས་བུ་སྟེར་།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "དེ་བཞིན་དུ་བཟའ་བར་བྱ་བ་དང་བཟའ་བར་བྱ་བ་མ་ཡིན་པ་བྱེད་ཅིང་རང་དང་གཞན་གྱི་གཟུགས་ཡོངས་སུ་སྒྱུར་བར་བྱེད་དོ།་",
    "དེ་ལ་དེ་ནས་དཔལ་ལྡན་རྡོ་རྗེ་འཆང་ཞེས་པ་ལ་སོགས་པ་ནས་ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག་ཅེས་པའི་མཐར་ཐུག་པ་༢ནི་གསོལ་བ་འདེབས་པའི་ཚིགས་སུ་བཅད་པ་བཅུ་དྲུག་གོ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཞེས་པ་ནི་འཁོར་ལོ་གསུམ་གྱི་སྡོམ་པའི་མཁའ་འགྲོ་མ་རྣམས་ཏེ་དེ་རྣམས་རིགས་ལྡན་མའི་སྦྱོར་བ་ལ་ཐུན་མཚམས་ཀྱི་དབྱེ་བ་དང་།",
    "དེ་ལྟར་རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྒྱུ་བ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ་ཞེས་པ་ནི་ངེས་པའོ།",
    "གང་ཞིག་ནུས་མ་བྷ་ག་ཞེས་བྱ་དེ་ནི་རྣམ་གསུམ་བགྲོད་ལྡན་ཡི་གེ་གསུམ་དང་རང་བཞིན་གསུམ།",
    "སྐྱེ་པེ་སྣར་འདུག་ཇེ་པེ་སྣར་པའོ།",
    "དེབ་འདིའི་ལྡེབ་༧༤༡ང་༡བྱེད་༧༤༣ང་༡པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་ལྡེབ་འདིའི་བསྡུར་མཆན་ཉྩཔའི་མཚལས་སུ་པེ་ལ་བསྐྱར་ཟློས་སུ་འཁོད་འདུག་པས་བསྡུར་མཆན་དུ་པེ་བསྐྱར་ཟློས་མ་ས་བཀོད་ཡོད།",
    "པེ་སྣར་ཤེག་རོ་ཙ་ནས།",
    "འཆི་བ་ན་ཡང་འདུག་བླ་ཡི།",
    "མེ་འདུག་པ་ན་མུན་པ་མེད།",
    "མཚན་གཞི་སོགས་གང་ཡིན་པ་འདི་དག་ཐམས་ཅད་སེམས་ལ་གསལ་བོ་ཞིག་ཤར་དགོས་པར་འདུག་ལམ་རིམ་དངོས་བསྟན་གྱི་སྐྱེས་བུ་ཆེ་འབྲིང་ཆུང་གསུམ་འཇོག་པའི་སྐབས་སུ་ལམ་དངོས་བསྟན་གྱི་སྐྱེས་བུ་ཆུང་ངུ་ཞིག་ཡིན་ཚེ་ངེས་པར་དུ་ཚེ་ཕྱི་མའི་དོན་དུ་གཉེར་བ་ཞིག་དགོས་ལ།",
    "ང་རང་ཉིད་གཅིག་པུས་ཁུར་དུ་བླངས་ཏེ།",
    "འཇུག་དོན་དང་གསུམ་ཡོད་པར་འདུག་ཀླད་དོན་ཞེས་པ།",
    "སྟོབས་ལྡན་བློ་གསལ་དད་ཆེ་བ་ཞེས་པ་འདི་གཅིག་པུ་ཤེས་ན་ཤིན་ཏུ་འཚམ་པོ་འདུག་སྟོབས་དང་ལྡན་པ་ནི་གཙོ་བོ་བརྩོན་འགྲུས་ལ་གོ་དགོས།",
    "མི་ལོ་སྟོང་ཕྲག་མང་པོ་འདུག་ཐུབ་པ་དེ་འདྲའི་མི་ཁོམ་པ་ཞིག་ཡིན།",
    "རང་རང་ལས་བྱུང་རྐྱེན་གྱིས་འཇིག།",
    "རང་རང་ལས་བྱུང་རྐྱེན་གྱིས་འཇིག།",
    "ལམ་རིམ་གཤེན་བསྟན་གསལ་བའི་སྒྲོན་མེ་ནས་གསུངས་པ་ནི་ཤིན་ཏུ་ཡག་པོ་ཡིན་ལ་འདི་ལྟ་བུའི་གསུང་སྟངས་ཡག་པོ་ཞིག་ལམ་རིམ་གཞན་པས་གསུངས་མེད་པར་འདུག་དེ་ཉིད་ལས་ཇི་ལྟར་གསུངས་ཡོད་ཅེ་ན།",
    "འདི་ནས་ངན་འགྲོའི་སྡུག་བསྔལ་ལ་དབྱེ་བ་ཕྱེ་ནས་གསུང་བཞིན་འདུག་ཙན་དན་སོལ་བའི་ཞུགས་ནང་དུ།",
    "ཙན་དན་གྱི་མེ་བསྲེགས་པའི་སོལ་བ་དེ་ཡང་བསྐྱར་འབར་བས་ཚེ་ན་མེ་གཞན་དང་མི་མཚུངས་པ་ཞིག་ཡིན་པར་འདུག་ཙན་དན་སོལ་བའི་ཞུགས་ནང་དུ།",
    "ཅེས་གསུངས་པ་མཐོང་སྟེ་དཔེ་རྒྱུན་མི་གཅིག་པ་ཡོད་པར་འདུག་དཔེ་བཞག་ན་དགྲ་ཞིག་ཡོད་ན་དགྲའི་འཇིགས་པ་ལས་སྐྱོབ་པའི་ཕྱིར་དུ་རང་ཉིད་ལ་ཕན་ཐོགས་པའི་གོ་ཁྲབ་མཚོན་ཆ་ཕས་རྒོལ་བྱེད་ནུས་ཀྱི་མགོན་དང་དཔུང་སོགས་གྲ་སྒྲིག་བྱེད་པ་ལས་དགྲས་རྒོལ་ན་ཅི་མི་སྙམ་པའི་ངང་འདུག་མི་བཟོད་ལྟར།",
    "ལས་འབྲས་ཀྱི་དབུ་ཡི་སྐབས་ནས་གསུངས་པར་འདུག་དེ་ཡིན་ན་སྲོག་གཅོད་བྱེད་ཀྱི་གཉེན་པོ་ཙན་དུག་ཅེས་པ་ཞིག་ཡོད།",
    "ཤ་ཟ་མཁན་ལྟོགས་སྐོམ་མྱོང་བའི་དུས་སུ་ཤ་ཟ་རྒྱུ་ཡོད་པ་སྔར་བསགས་པའི་ལས་ཀྱི་འབྲས་བུ་ཡིན་དགོས་པར་འདུག་དཔེར་ན་ལས་ཀྱི་འབྲས་བུ་ངེས་པ་ཟེར་དུས།",
    "གསོད་སེམས་ཡུན་རིང་དུ་བརྩམས་ཀྱང་སྲོག་མ་བཅད་པའི་ལས་ཤིག་ཡོད་འདུག་དེ་ཉིད་ལས།",
    "དེ་ལྟར་མ་བྱས་ན་བྱས་བསགས་ཀྱི་དབྱེ་བ་འདི་ཅ་དག་ཅིག་ཡོང་ཐབས་མེད་པར་འདུག་ཡང་ལུང་དེ་ཉིད་ལས།",
    "འདི་ལ་སྐུ་ཡི་ཁྱད་པར་དང་ཡེ་ཤེས་ཀྱི་ཁྱད་པར་ཡོད་པར་འདུག་དེས་ན་འདིའི་སྟེང་ནས་དག་པ་གཉིས་ལྡན་གྱི་སྐུ་ཞེས་པ་ངོས་ཟིན་དགོས།",
    "ལམ་བདེན་མེད་ན་སྒྲིབ་པ་སྦྱང་ཐུབ་ཀྱིན་མི་འདུག་དེས་ན་ལམ་བདེན་ཞེས་པའི་ལམ་དང་བསམ་པ།",
    "སྐྱབས་སུ་འགྲོ་ཚུལ་དེ་འདྲ་ཡིན་པར་འདུག་མྱུར་དུ་སྒྲོལ་མཛད་སྐྱབས་གནས་བསྟེན།",
    "དཔེར་ན་འཁར་བ་འཆང་དང་ཞེས་པའི་འཁར་བ་འདི་ལ་གསུངས་ཚུལ་འདི་འདྲ་ཞིག་ཡོད་པར་འདུག་ལག་རྟེན་ལ་འཁར་བ་ཟེར་བ་ཞིག་ཡོད།",
    "ཞི་གནས་འདི་ཕྱག་ལེན་གྱི་ངོས་ནས་ཨ་ལ་སོགས་པར་བལྟས་ཏེ་སེམས་འཛིན་པར་བྱེད་ཀྱིན་འདུག་སེམས་འཛིན་པའི་ཐབས་དེ་ཡུལ་གང་ལ་དམིགས་ན་ཡང་ཆོག་སྟེ།",
    "སྔར་བས་རགས་དང་རང་སར་ཞི།",
    "ཚིག་རྗེས་མ་དཔེ་ཅན་གྱི་སྟེང་ནས་སྔར་བས་རགས་དང་རང་སར་ཞི།",
    "ཐ་ན་ཉོན་སྒྲིབ་ཀྱི་ས་བོན་ཡང་རྩ་བ་ནས་སྤངས་མི་ནུས་པར་འདུག་ཉོན་སྒྲིབ་ཀྱི་ས་བོན་རྩ་བ་ནས་སྤང་དགོས་ན་བདེན་པ་མངོན་སུམ་དུ་མཐོང་དགོས།",
    "མཁས་པའི་གསུང་རྒྱུན་ལ་མཁའ་ལྡིང་ཁྱུང་ལ་སྐྱེ་གནས་བཞི་བོ་ཡོད་པ་དང་ཀླུ་ལའང་སྐྱེ་གནས་བཞི་བོ་འདུག་དེ་བས་ཁྱུང་ཆེན་གྱིས་ཀླུ་ཟིལ་གྱིས་གནོན་ཡང་སྐྱེ་གནས་ཀྱི་སྟེང་ནས་ཟིལ་གྱིས་མི་གནོན་པ་ཞིག་ཀྱང་ཡོད།",
    "མ་ཞེས་པ་སེམས་སྡུག་བསྔལ་གྱིས་བཟུང་བའི་མྱ་ངན་གྱི་སྒྲ་བརྗོད་དོན་ནི་སྙིགས་མའི་དུས་འདིར་སྐྱེས་པ་བླངས་ཏེ་སྟོན་པ་ཁྲི་གཙུག་རྒྱལ་བའི་བསྟན་པ་ལའང་གཤེ་སྐུར་འདེབས་པའི་གཏམ་ཡང་འདུག་བ་ས་ང་ན་ཨང་ཞེས་མྱ་ངན་གྱི་སྒྲ་ཕྱུང་།",
    "ཐོགས་མེད་ཀྱི་ལུགས་སོགས་ནང་ཕན་ཚུན་མི་མཐུན་པ་འདུག་པས་མི་ཚད་དགག་བཞག་ཀྱང་མང་པོ་མཛད་ཡོད།",
    "སྟོན་པ་གཤེན་རབ་ཀྱི་བཀའི་ནང་དོན་ཐུབ་པའི་བཀའ་ལ་མེད་པ་ཤིན་ཏུ་མང་པོར་འདུག་སྟེ་རྒྱུའི་བོན་བཞི་བོ་དང་།",
    "བན་བོན་སྔགས་གསུམ་ཡོངས་རྫོགས་གཤེན་རབ་ཀྱི་རྗེས་འབྲང་མིན་པ་གཅིག་ཀྱང་མི་འདུག་སྟེ།",
    "ཀླུང་རྟའི་སྐོར་ཁ་ཚང་ལག་ལེན་དུ་འདེབས་ཀྱིན་འདུག་པས་དེ་ནི་གཤེན་རབ་ཀྱི་རྗེས་འབྲང་ཡིན་པ་ལས་ཐུབ་པའི་རྗེས་འབྲང་མིན།",
    "ངས་འདི་ལྟར་ཉན་ཐོས་དང་རང་རྒྱལ་ཞེས་བརྗོད་ན།",
    "གཤེན་རབ་རྣམ་རྩོད་པ་དང་རང་རྟོགས་གཤེན་རབ་པས་ཉོན་སྒྲིབ་སྤངས་ཤིང་།",
    "གཤེན་རབ་རྣམ་རྩོད་པ་དང་རང་རྟོགས་གཤེན་རབ་ཀྱི་དགྲ་བཅོམ་པའི་གོ་འཕང་ཐོབ་ཡོད་པ་ཞིག་ཡིན་ན།",
    "དགེ་ལེགས་ཀུན་གྱི་འབྱུང་གནས་ཁྱེད་རང་བསྔགས།",
    "མཐུན་རྐྱེན་འདི་གཞན་སྟེང་ནས་འབྱོར་རྒྱུ་ཞིག་དང་རང་སྟེང་ནས་འབྱོར་རྒྱུ་ཞིག་ཡོད།",
    "དེ་ཡང་རང་ཉིད་མི་ཁོམ་པའི་གནས་བརྒྱད་དུ་མ་སྐྱེས་ཀྱང་།",
    "སོས་དལ་བའི་ངང་སྐྱིད་པོར་འདུག་པ་དེ་ལས་བླུན་པོ་ཞིག་གང་ན་ཡོད།",
    "ཡེ་གཤེན་གྱི་ནང་དུ་གཤེན་རབ་རྣམ་རྩོད་པ་དང་རང་རྟོགས་གཤེན་རབ་པ་ཐམས་ཅད་འདུ།",
    "རང་གནས་པའི་ས་འདི་ནས་ཀྱང་རང་ལས་ཆུང་བ་ཤི་བ་མང་ཞིང་།",
    "འབྲལ་མི་ཕོད་པའི་གདུང་སེམས་ཀྱིས་མཐའ་ནས་བསྐོར་ཡང་རང་མི་འཆི་བར་མི་ཕན་པར་མ་ཟད།",
    "འདུག་ས་འདུག་གནས་ལ་མཚོན་ན།",
    "འདུག་གནས་གང་བཟང་དང་གང་སྐྱིད་པ་དེ་ལ་མི་བལྟ་བར།",
    "དཀའ་ཐུབ་ཀྱི་འཚོ་བ་ཞིག་ལ་བརྟེན་ནས་འདུག་དགོས།",
    "དེ་ལྟར་བྱས་ན་ཁོ་རང་ལ་ཆགས་སྡང་རྨོངས་གསུམ་གང་སྐྱེས་ཀྱང་།",
    "སྔོན་གྱི་ཞེ་སྡང་རང་བཞིན་གྱིས་མེད་འགྲོ་ཞིང་།",
    "དེའི་དོན་རང་རང་འཆི་བའི་དུས་སུ་ཚེ་སྔ་མའི་ལུས་རྟེན་འདི་དོར་ན་མི་འདོད་པར་དེ་ལ་ཆགས་ཞེན་དྲག་པོ་སྐྱེས་པ་དང་།",
    "སྡུག་བསྔལ་མྱོང་ཤེས་མཁན་དེ་འདྲ་ཞིག་ཡིན་དགོས་པར་འདུག་ཚོར་བ་དང་རྒྱུད་ཀྱིས་བསྡུས་པ་ཞིག་མ་ཡིན་ན།",
    "ཁྱབ་པ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཟེར་བ་འདིའི་གོ་དོན་འདི་འཇོག་དུས་འདི་འདྲ་ཞིག་ཟེར་གྱིན་འདུག་སྟེ།",
    "མཐོ་སྲིད་རྩེ་ནས་མནར་མེད་ཀྱི་བར་དུ་སྣོད་བཅུད་ཐམས་ཅད་ལ་འདིས་མ་ཁྱབ་པ་ཞིག་མི་འདུག་ཟེར་བཞིན་ཡོད།",
    "སྤྱི་གཙུག་ནས་རྐང་མཐིལ་བར་ཁྱབ་པས་ན་ཁྱབ་པ་གསུངས་འདུག་འདི་ལ་འུ་ཅག་ལ་བློ་ངོར་མི་བདེ་རྒྱུ་དེ་འདྲ་ཡོང་རྒྱུ་ཡོད།",
    "ཁོ་རང་ཡོད་སའི་གངས་རི་མཚོ་གསུམ་ཟེར།",
    "ཁོ་རང་འཁྲུལ་སྣང་ཤར་བ་ཡིན།",
    "འདི་ཡི་དྭགས་ཀྱི་སྡུག་བསྔལ་ལ་གནས་ན་འདུག་པ་དང་།",
    "ང་རྒྱལ་ནི་གཞན་ལ་བལྟས་ན་ང་རང་བཟང་སྙམ་པ་སྟེ་སེམས་ཁེངས་པའི་རྣམ་པ་ཅན།",
    "རང་རྒྱུད་གང་བའི་རྣམ་པ་ང་རང་གཞན་ལས་ཁྱད་པར་བ་ཡིན་པའམ་མཆོག་ཏུ་འཛིན་པ་འདི་ང་རྒྱལ་ཡིན།",
    "ཕྱི་རོལ་བས་ལྟ་བ་ངན་པ་རྒྱུད་ལྡན་གྱི་གང་ཟག་དེའི་ཕུང་པོ་ལ་དམིགས་ནས་གཞན་ལས་ཁོ་རང་མཆོག་ཏུ་འཛིན་པ་ཡིན།",
    "གླང་ཆེན་སྨྱོན་པར་འཕྲད་ཀྱང་རང་སྲོག་འདོར་དུ་འཇུག་པ་ལས།",
    "ཚེ་ཅི་ཙམ་ལ་འདུག་པ་དེའི་ཚེ་ཇི་སྲིད་བར་དུ་ཡོད།",
    "ཉེར་ལེན་གྱི་ཕུང་པོ་ལྔ་བོ་དེ་སྐད་ཅིག་སྐད་ཅིག་ལ་རྟག་ནས་མི་འདུག་པར་འཇིག་ནས་འགྲོ་བཞིན་ཡོད་པ་དེ་ལ་མི་རྟག་ཅེས་བྱ་ཞིང་།",
    "སྡོམ་དྲ་འཐེན་མཁན་ཡང་ཁོ་རང་ཉིད་ཡིན་པས་རང་ཉིད་ཀྱིས་རང་ཉིད་བརླགས་པ་དེ་བཞིན་དུ།",
    "འདུག་ས་ནི་གཡའ་རི་གངས་བྲག་ཡིན།",
    "མཐོན་པོ་ཞིག་མཐོ་ས་ནས་འདུག་མི་ནུས་པར་ཐ་མར་རྒུད་འགྲོ་བ་ཡིན་ལ།",
    "རྒྱུ་འབྲས་ཚུལ་བཞིན་དུ་སྤྱོད་པའི་བླང་དོར་གྱི་གནས་འདི་ལ་ཁོ་རང་རྨོངས་ནས་ཡོད།",
    "དེ་ཡིས་ལས་གང་ཞིག་བསག་རྒྱུ་ནི་ལྟ་ཞོག་ཐ་ན་གཟུགས་དེ་ཡག་མི་ཡག་ཀྱང་ཤེས་ཀྱིན་མི་འདུག་པས།",
    "དེ་ལ་ཉེས་པ་ཡོད་པར་འདང་མི་རྒྱག་པར་ཡོད་པས་མ་བྱིན་ལེན་གྱི་ཕམ་པ་ནམ་བྱུང་བ་མི་ཤེས་མཁན་ཡང་འདུག་སྔོན་རྗེ་བཙུན་དམ་པ་འུ་ཡུག་ཡོན་པོར་བཞུགས་པའི་སྐབས།",
    "དེ་བཞིན་དུ་རིགས་དྲུག་པོ་ཚང་མར་ནང་གསེས་ཀྱི་དབྱེ་རྒྱུ་འདུག་མིའི་དབྱེ་བ་ཤེས་ན་གཞན་རྣམས་ཡང་རིག་འགྲེས་པས་ཤེས་སླ།",
    "སྐྱེ་བ་ཕྱི་མའི་བར་དུ་འདུག་མི་དགོས་པར་དུས་ད་ལྟའི་སྟེང་དུ་སྨིན་པ།",
    "ད་ལྟ་བྱས་པ་ཚེ་ཕྱི་མར་སྡུག་བསྔལ་མྱོང་བཞིན་པ་ཞིག་འདུག་དེ་བདུད་གཏོ་བུ་དོད་དེ་ལྟ་བུ་ཡིན་ཟེར།",
    "ཚེ་གསུམ་པའམ་དེའི་ཕྱི་མ་རྣམས་སུ་བརྒྱུད་ནས་བྱུང་བ་དེ་འདྲ་ཞིག་ཀྱང་འདུག་སྐྱེ་བ་ཕྱི་མ།",
    "དེ་དག་ཐམས་ཅད་ལ་ལས་བྱས་པའི་འབྲས་བུ་བརྒྱུད་ནས་ཡོང་བ་ཞིག་ཀྱང་འདུག་དེ་ནི་བདུད་ཁྱབ་པ་ཡིན་པར་གསུངས།",
    "དམན་ལམ་གྱི་གཟེབ་ཏུ་འཆིང་བ་ཡིན་ཟེར་བ་འདུག་སྟེ།",
    "དེ་ལས་ལྷག་པའི་ལྟ་བ་མཐོན་པོ་ཞིག་མི་འདུག་ཅེས་པའི་ལྟ་བ་དེ་འདྲ་ཞིག་ཡིན་དགོས།",
    "སྡིག་ལྟུང་རྣམས་སྟོབས་བཞིའི་བཤགས་སྡོམ་བྱེད་ཚུལ་ཞེས་ཐབས་ཤེས་གཉིས་ཀྱི་སྒོ་ནས་གསུངས་འདུག་དང་པོ་སྡོམ་གསུམ་ལ་སློབ་དགོས་ཚུལ་ནི།",
    "དེར་མ་ཟད་སྟོང་གསུམ་འཇིག་རྟེན་གྱི་ཁམས་གཞན་ཡོད་པ་ཤེས་འདུག་ལ།",
    "ཞེས་འདི་ལྟར་གསུངས་འདུག་ལ།",
    "ད་ནི་ང་ཡིས་མང་པོ་ཤེས་འདུག་ཟེར་ནས།",
    "སྡོམ་པ་གོང་མ་སྟེགས་བུ་བྱས་ན་སྡོམ་པ་ཕྱི་མ་ཡང་མི་འཆལ་བར་བཟུང་འདུག་སྟེ།",
    "གཅིག་ལ་གཅིག་བརྟེན་ཡིན་ཞེས་ཙོང་ཁ་པས་འདི་ལྟར་གསུངས་འདུག་ལ།",
    "དེ་ལྟ་བུའི་གསུངས་ཚུལ་འདུག་ལ།",
    "རང་རང་རྣ་བས་གོ་བ་ཙམ་གྱིས་བཞག་སྟེ་གཤར་སྦྱངས་མི་བྱེད་པ་དང་།",
    "དང་པོའི་བློ་ཅན་རང་དང་རང་འདྲ་རྣམས།",
    "རང་རང་སྒྲ་སྐད་ཇི་བཞིན་གོ།",
    "ངའི་བློ་ངོ་ན་འདི་འདྲ་ཞིག་འདུག་ས་བདུན་པའི་བར་དུ་ཉོན་སྒྲིབ་ཡོད།",
    "སྒོམ་ལམ་བར་ཆད་མེད་ལམ་གྱི་ངོས་སྐལ་གྱི་བསྒོམ་བྱ་དེ་ལ་ཡོད་འདུག་འདི་འདྲ་ཞིག་ཨེ་འདུག་ས་བརྒྱད་པ་ཐོབ་ན་ཐེག་དམན་གྱི་ལམ་དུ་མར་ལྟུང་རྒྱུ་ཨེ་ཡོད།",
    "གསེར་ལྟ་བུའི་སེམས་བསྐྱེད་ཡོད་པ་ཡིས་གཞན་དུ་མི་འགྱུར་དེ་ཟེར་ཞིང་འདུག་འཕགས་པ་རང་ལམ་གྱི་ངོ་བོ་གཞན་དུ་མི་འགྱུར་བ་ཡིན་ཕྱིར།",
    "དེ་ལྟར་གསུངས་པ་ཞིག་འདུག་པས་མ་རིག་པ་འོད་གསལ་པར་དེ་ལྟར་གོ་བ་ཞིག་བླངས་ཆོག་ཟེར།",
    "འདིའི་མན་སྒྲ་མི་འདུག་སྒྲ་བཤུ་མཁན་ནས་སྒྲ་བཤུ་བ་ནི།",
    "དེ་གཉིས་ནི་གོ་རིམ་བཞིན་རྟེན་བརྟེན་པ་ཡིན་ཞིང་རང་བཞིན་གྱི་རིགས་ཙམ་དེ་རྒྱུར་ཡོད་ལ་ཡོན་ཏན་མངོན་དུ་མ་གྱུར་པས་འབྲས་བུར་མེད་ཅིང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "ཤེས་སྒྲིབ་ཀྱི་ཕྱོགས་གཅིག་གཟུང་རྟོག་ཀྱང་སྤང་རུང་དུ་འདུག་པ་འབྲིང་སྟེ་རང་རྒྱལ་གྱི་རིགས་དང་།",
    "སྒྲིབ་པ་གཉིས་ཀ་སྤང་རུང་དུ་འདུག་པ་མཆོག་ཐེག་ཆེན་གྱི་རིགས་ཏེ།",
    "གདུལ་བྱའི་སེམས་ཇི་ལྟར་འདུག་པ་ལྟར་རྟོགས་པ་གཞན་གྱི་སེམས་ཤེས་པ་དང་།",
    "མི་ན་བར་སྟན་ཆེས་མཐོ་བར་འདུག་པ་ལ་མ་ཡིན་ནོ།",
    "ཡང་ན་གཡེང་བ་སྟེ་སེམས་རྣལ་དུ་མི་འདུག་པའི་ཕྱིར་རམ།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "རྣལ་དུ་འདུག་པའི་དམིགས་པ་སྟེ།",
    "དེ་བཞིན་ཉིད་དང་རང་བཞིན་རྣམ་དག་ནི་ཡོན་ཏན་དང་ཡོན་ཏན་ཅན་གྱི་ཚུལ་དུ་ཡོད་དེ།",
    "སྤྱི་མཚན་ལས་བརྩམས་ནས་དོན་གསུམ་པོ་འདི་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིས་དག་པས་དཔེ་གསུམ་ཆར་དང་ཀུན་མཁྱེན་རོང་སྟོན་ཆེན་པོའི་གསུང་འབུམ།",
    "དེ་ཡང་རང་བཞིན་དུ་གནས་པའི་རིགས་རྐྱེན་གྱིས་གསོས་པ་ལས་བྱུང་བ་ལའང་མི་འཁྲུལ་ལོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་མི་སྟོང་ན་མི་འགྱུར་བས་རྐྱེན་གྱིས་གསོས་བཏབ་པར་མི་རུང་ངོ།",
    "དྲི་མ་དང་བྲལ་བའི་ཡོན་ཏན་རང་བཞིན་དང་རང་བཞིན་ཅན་གྱི་ཚུལ་གྱིས་དབྱེར་མེད་འབྲལ་མི་རུང་དུ་ལྡན་པའི་ཕྱིར།",
    "གླིང་བདག་མཆོག་དང་རིན་ཆེན་གཟུགས་ཏེ་དཔེ་དགུ་དང་རང་བཞིན་གྱིས་དྲི་མ་མེད་པའི་ཁམས་མཚུངས་པ་ཉིད་དོ།",
    "དེ་བཞིན་ཉིད་དང་རིགས་ཀྱང་རང་བཞིན་དུ་བསྡུས་སོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡུལ་ཡང་མ་ལགས་སོ།",
    "འདི་དག་ཀྱང་རང་བས་གཞོན་པ་ལ་སོགས་པ་ཕྱག་རྒྱར་བྱིན་གྱིས་བརླབས་པ་ལ་བྱའི་སྒྲ་ཇི་བཞིན་པར་ནི་མ་ཡིན་ཏེ།",
    "རྣལ་འབྱོར་པས་དེའི་སྟེང་དུ་འདུག་ལ།",
    "ལོ་ཙ་ན་ལ་སོགས་པའི་ཡུམ་རྣམས་ཀྱི་དམིགས་པ་བསྟན་ཏེ།",
    "མ་ལོག་པ་དང་འགྲོ་བ་དང་འདུག་པ་ཐམས་ཅད་དུ།",
    "གོང་མའི་ཤ་དེ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་ཤི་བའམ།",
    "མཐར་ཐུག་པའི་སྐབས་སུ་རྟོག་པ་གང་ལ་ཡང་རང་བཞིན་གྱིས་མི་འཕྲོ་བས་ན་རང་གཟུགས་ཀྱིས་བྱ་བའི་དོན་ཏོ།",
    "སྦལ་བསྣམས་ན་འདི་ཕྱག་མཚན་བྲི་བ་ལ་མི་མཐུན་པར་གདའ་ན་ལེགས་པར་དཔྱོད་ཅིག།",
    "ས་འོག་དང་ས་སྟེངས་ས་བླ་ན་གནས་པའི་འདུག་པ་རྣམས་ཀྱི་མགྲིན་པ་འདོན་པའི་ཕྱིར་རོ།",
    "རང་རང་ལྷའི་ཞལ་དང་།",
    "མཉམ་པའི་འདུག་སྟངས་ཀྱིས་གནས་ལ།",
    "ནཱ་ག་གེ་སར་རྣམས་ཀྱི་ཕྱེ་མའམ་ནཱ་ག་གེ་སར་རྣམས་ཀྱི་ཕྱི་མ་ཤ་ཀ་ར་དང་བཅས་པའི་འདུག་པ་དང་།",
    "རང་ཉིད་བྱེད་ཅིང་རང་ཉིད་འཕྲོག།",
    "ཙ་ནི་མིག་གཡོན་པར་རོ།",
    "དེ་ཡང་རང་བཞིན་གྱི་སྐུ་ལས་བྱུང་བའོ།",
    "དེ་བཞིན་དུ་ཡང་གྲུབ་པའི་རྣལ་འབྱོར་པའི་རང་བཞིན་གྱིས་དེའི་སྟེང་དུ་འདུག་སྟེ།",
    "དེ་བཞིན་དུ་བཅོམ་ལྡན་རྡོ་རྗེ་འཆང་པོ་ཡང་རང་སྣང་བའི་ཤེས་རབ་དང་ལྡན་པ་དེའི་གཟུགས་ཀྱི་རང་བཞིན་ཞེས་དགོངས་སོ།",
    "དེ་ཕྱིར་འདིར་བརྟག་དུས་ནི་མེད།",
    "དེར་གསུངས་པ་ཐོ་རངས་གདོང་དག་པ་ལ་སོགས་པ་བྱས་ཏེ་བསམ་གཏན་གྱི་གནས་སུ་ཞུགས་ནས་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "དར་དང་རྒྱན་ལ་སོགས་པས་བརྒྱན་པ་སྤོས་ཀྱིས་བདུག་པ་རུ་བདེ་བའི་སྟན་གྱི་སྟེང་དུ་འདུག་སྟེ།",
    "གདོང་དག་པ་ལ་སོགས་པ་བྱས་ལ་བསམ་གཏན་གྱི་གནས་སུ་ཞུགས་ནས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "བདེ་བའི་སྟན་གྱི་སྟེང་དུ་འདུག་སྟེ།",
    "ཙ་ན་ཀའི་རི་ལུ་ལྟ་བུར་འོད་ཟེར་རྣམས་སྣའི་རྣམ་པར་ཤེས་པ་ལས་བྱུང་ནས་ཡི་དགས་ཀྱི་འགྲོ་བ་རྣམས་རྣམ་པར་འཇོམས་པའོ།",
    "དེ་རྣམས་རང་རང་ལུང་རྣམས་སུ།",
    "སྐྱེ་བ་འབུམ་ཕྲག་དུས་ནས་སུ།",
    "རི་ལུ་ཙ་ན་ཀའི་ཆད་ཙམ་བྱས་ཏེ་བཟའ་བར་བྱའོ།",
    "དེ་ལྟར་བསྡུས་ན་ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིད་ྡྷལོ་ཙ་ནི་སྭཱ་ཧཱ་ཞེས་སོ།",
    "བསྐུལ་ཚིག་དང་བཅས་པའི་སྔགས་ཞེས་པ་ནི་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་སྭཱ་ཧཱ་ཞེས་པ་དང་སྤེལ་བའོ།",
    "རང་རང་སྣ་བའི་མཆོག་ནི་འཛིན།",
    "ཡོད་ཚད་གདུང་བ་ལྕི་བའི་སྐྱོ་ཉམས་ཤིག་མངོན་འདུག།",
    "སུས་ཀྱང་འགོག་ཐབས་མི་འདུག།",
    "དཔྱིད་འགོའི་ཁུ་བྱུག་སྒྲོག་དུས།",
