    "ཁྱེད་རང་ལས་དག་པའི་སྐྱེས་བུ་ཞིག་ཡིན་ངེས་པའི་ཡིད་ཆེས་བྱུང་ལ་ངའི་བསམ་པ་རྫོགས་པ་ཡིན།",
    "ཀྱེེ་རྡོར་གྱི་སྒྲུབ་མཆོད་ཚུགས་ཡོད་འདུག་པ་དེར་ཚོགས་སུ་ཞུགས་ཡོད་འདུག་ལ།",
    "ཐུན་མཚམས་རྣམས་སུ་ཞལ་སློབ་ཉུང་ཤོས་ཤིག་ལ་སྣང་གསུམ་གྱི་ཉམས་ཁྲིད་ཅིག་བསྩལ་མཛད་པ་དེ་མཁྱེན་རབ་འོད་ཟེར་ལའང་ཆ་ཚང་ཐོབ་ཡོད་འདུག་པ་མ་ཟད།",
    "རྣམས་ལ་སྣང་གསུམ་གྱི་ཉམས་ཁྲིད་བསྩལ་བའི་སྐབས་དེར་གསུངས་མཛད་པ་ཁོ་བོའི་ཡིད་ལ་གསལ་པོར་དྲན་གསོས་ཀྱི་ཡོད་འདུག་ལོ་དེའི་དབྱར་ཟླ་ར་བ་ནས་སྟོན་ཟླ་འབྲིང་པོའི་བར་ལ།",
    "ཁྱེད་རང་མྱུར་དུ་དེར་ཕེབས་ན་ངས་ངོ་སྤྲོད་ཡང་གསལ་བྱེད་ཆོག་ཅེས་གསུངས་པ་བཞིན།",
    "སྐུལ་མ་མཛད་ཡོད་འདུག་པ་བཞིན་ཕྱི་མ་རྒྱུད་དང་།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་སེང་ཧ་མུ་ཁའི་བསྙེན་སྒྲུབ་འདི་གསུམ་ཚད་དང་ལྡན་པ་ཞིག་སྐྱོལ་ཤོག་ཅེས་བཀའ་ལུང་ཕེབས་ཡོད་འདུག་པ་བཞིན།",
    "དུ་སླར་ལོག་ཡོད་འདུག་པ་དང་།",
    "ང་རང་དཀའ་ལས་ཁེགས་ནས་ཤར་རྒྱག་འགྲོ་ཐུབ་ཀྱི་མི་འདུག་ང་ལ་ངལ་གསོ་ཡུད་ཙམ་ཞིག་རྒྱག་བཅུག་རོགས།",
    "ཁྱེད་རང་ཡོངས་སུ་གྲོལ་བར་འགྱུར་ངེས་པ་ཡིན་ཞེས་ལུང་བསྟན་གནང་བྱུང་བ་བཞིན།",
    "ཚག་ཧྲག་དྲག་པོ་ཞེས་བྱ་བའི་གནས་དེར་གནས་འདུས་ཡོད་འདུག་པ་དང་།",
    "ཁོ་སྐུ་དྲུང་དུ་སླེབས་དུས་ཉེ་སྐོར་དེར་མཆོད་མེ་མང་ཞིག་ཡོད་པ་ཚང་མ་སྦར་ཚར་ནས་ཡོད་འདུག་པ་མཐོང་།",
    "ཅེས་ཟེར་གྱི་འདུག་པས་ངེས་ཤེས་ཐུབ་པ་ཡིན་ནོ།",
    "སྲིད་པ་མི་རབས་མཆེད་དགུ་ནི་མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པ་ལྟ་བུ་ཞིག་ཡིན་པར་འདུག་སྟེ།",
    "པོ་ཞིག་ཏུའང་ངོས་འཛིན་སྲོལ་བྱུང་འདུག་དེའི་སྐོར་ཁ་གསལ་བ་ཞིག་ནི།",
    "རང་རང་ཡུལ་དུ་སྐད་རིགས་སོ་སོར་བསྒྱུར།",
    "བརྩམས་པའི་ལུགས་དེ་བྱུང་བ་ཡིན་ཞེས་ཤོད་སྲོལ་ཡོད་འདུག་གང་ལྟར་ཡང་།",
    "བོན་གཤེན་ཆེན་པོ་འགའ་ཤས་ཀྱི་བྲིས་ཐང་རྙིང་མམ་རྣམས་སུ་གསལ་པོར་མཇལ་དུ་ཡོད་འདུག་པ་དེ་ལ་ཟེར་བ་ཡིན།",
    "ཕྱོགས་མཚམས་བརྒྱད་དུ་སྤར་ཁ་བརྒྱད་བཀོད་དེ་ལོ་ཟླ་ཞག་དུས་དང་།",
    "སུ་ཞིག་སྐྱེ་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་ཀྱི་འབྱུང་ཁམས་སོ་སོའི་གནས་ལུགས་དེ་ལ་བརྟེན་ནས་ཚེ་འདིར་ལེགས་ཉེས་ཀྱི་རྐྱེན་ཅི་དང་ཅི་ཞིག་ཡོད་པ་དང་།",
    "ལར་ཡང་གྲོས་དེ་འདྲ་ཞིག་བྱས་པ་གདའ་བས།",
    "ཁྱུང་པོ་བློ་གྲོས་རྒྱལ་མཚན་དུས་རབས་༡༤གྱིས་མཛད་པའི་རྒྱལ་རབས་བོན་གྱི་འབྱུང་གནས་སོགས་ཀྱི་དཔེ་རྣམས་སུ་མི་མཐུན་པ་འགའ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "འོ་ན་ཕྱག་སོར་དང་ལྕེ་ངོ་མཚར་ཆེ་བ་གཅིག་འདུག་པ།",
    "ཤོད་ཚུལ་དེའང་ཕལ་ཆེར་གཉའ་ཁྲིའི་ཚིག་དོན་དང་མཐུན་གྱི་ཡོད་འདུག་གནའ་རབས་སུ།",
    "ཞེས་ལུང་འདྲེན་དྲངས་གནང་འདུག་པ་དེ་རིགས་ཀྱིས་ངེས་ཤེས་རྙེད་ཐུབ་པ་ཡོད།",
    "ཞེས་སོགས་གསལ་རྒྱས་སུ་གསུངས་མཛད་འདུག་པ་དེ་ལའང་དཔྱད་གཞིག་ནན་ཏན་དུ་བྱེད་དགོས་པ་འདུག་སྤུ་དེ་གུང་རྒྱལ་ནི་བོད་ཀྱི་ཐོག་མའི་རྒྱལ་རབས་གནམ་གྱི་ཁྲི་བདུན་དང་བར་གྱི་ལྡིང་གཉིས་ཏེ།",
    "ཁྱེད་རང་ལག་པ་བདེ་པོ་དང་།",
    "ལྷ་བབ་ཡི་གེའི་ཚུགས་སུ་བྲིས་པའི་ཚིག་རྐང་པ་བཞི་ཡོད་འདུག་ངས་ཞིབ་ནན་གྱིས་བལྟས་ཏེ་བཀླགས་པས།",
    "ཅེས་གསུངས་སྟངས་འདི་ལ་དཔྱད་ན་དེང་དུས་ཡོངས་གྲགས་སུ་ཁེགས་ཞེས་པ་འདི་རིགས་ལ་ངོས་འཛིན་གནང་བ་འདྲ་ཞིག་འདུག་ལ།",
    "གསེར་ཆུང་གཅིག་དུང་ཆུང་གཅིག་དུག་མདེལ་གཅིག་དང་གསུམ་གདའོ།",
    "བན་དེ་རྣམས་ལ་ཁ་སྡང་བའི་ངན་སྨྲས་བྱས་པ་མི་ཉུང་བ་ཞིག་ཡི་གེར་འཁོད་ཡོད་འདུག་པ་ནི་རྒྱལ་རབས་བོན་གྱི་འབྱུང་གནས་ཐོབ་གསར་༡༤༦ཤ་བ་ལས།",
    "ཡུལ་འདི་ན་ཕ་མེད་པའི་བུ་ཞིག་ཡོད་པ་དེས་གནོད་འདུག་ཟེར།",
    "ཞེས་དཔེ་རྙིང་བྲིས་མ་ཤོག་གྲངས་ཡོད་པར་འཁོད་འདུགཡང་དེ་ལས་ཅུང་རྒྱས་པ་ནི་རྒྱལ་པོའི་བཀའ་ཐེམས་བཀའ་བཀོལ་མ་ཟེར་བའི་ནང་།",
    "གནམ་ནས་འོངས་པའི་བཙན་པོ་ཅིག་འདུག་པས་རང་ཅག་རྣམས་ཀྱི་རྗེར་ཞུའོ་ཟེར་ནས་གཉའ་བ་ཁྲི་ལ་བཏེག་རྒྱལ་པོར་བཀུར་བས་རྗེ་གཉའ་ཁྲི་བཙན་པོ་ཞེས་གྲགས་སོ།",
    "ད་ལྟ་རྒྱལ་གཤེན་དོ་མཉམ་ཙམ་གདའ་སྟེ།",
    "ཁྱེད་རང་ད་ལྟ་རང་འཆི་དགོས་པའི་ཁྱབ་པ་མེད་དེ།",
    "གནམ་ནས་འོངས་པའི་བཙན་པོ་གཅིག་འདུག་པས།",
    "བོད་ཡུལ་གྱི་སློབ་དཔོན་བེ་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་སོགས་རྒྱ་བོད་ཀྱི་པཎ་གྲུབ་མང་དུ་བྱོན་པའི་ཕྱིར།",
    "བེ་རོ་ཙ་ན།",
    "འདིར་དྲལ་གྱི་སྙན་དུ་གདའ་སྟེ།",
    "ཆབ་ལ་རོལ་ཏུ་མཚོ་མ་ཕམ་དུ་གཤེགས་འདུག་ནས།",
    "སྲིད་པ་མི་རབས་མཆེད་དགུ་ནི་མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པ་ལྟ་བུ་ཞིག་ཡིན་པར་འདུག་སྟེ།",
    "ལ་དྭགས་ཀྱི་ཡུལ་རྣམས་ཡིན་འདུག་པ་དེ་ཀུན་ཞང་ཞུང་བར་བའི་མངའ་ཁོངས་སུ་ཡོད་པས་ཀྱང་ཤེས་ཐུབ་ཅིང་།",
    "གནས་འདིའི་མིང་ཡིག་རྙིང་རྣམས་སུ་རྔུལ་མཁར་ཞེས་བཀོད་ཡོད་འདུག་ནའང་།",
    "ཁྱུང་ལུང་དངུལ་མཁར་རང་ལ་གནའ་མི་ཚོས་གཞི་རིམ་སུམ་བརྩེགས་སུ་བཟོས་ཡོད་འདུག་པ་དེར་གནའ་བོའི་རྒྱལ་པོ་དང་།",
    "དེང་དུས་ཐོག་ཁའི་ཆ་གཅིག་བརྡིབས་ནས་ཡོད་པ་དེ་འདྲ་ཞིག་འདུག་པ་དེ་ནི་ཕལ་ཆེར་རྒྱལ་པོར་སྐུ་མགྲོན་ཚོས་མཇལ་ཁ་ཞུ་གནས་ཤིག་ཡིན་ལས་ཆེ་བ་དང་།",
    "དེང་དུས་སུ་ཐོག་གང་ཡང་མེད་པ་ཞིག་ཡོད་འདུག་པ་དེ་ནི་ཕལ་ཆེར་རྒྱལ་བློན་ལྷན་འཛོམས་ཀྱི་འདུག་གནས་ཤིག་ཡིན་ལས་ཆེ་བ་དང་།",
    "བྱེ་རྡོ་ལས་གྲུབ་པའི་བྲག་ཕུག་ཆེ་ཆུང་སྣ་ཚོགས་པ་ལས་གཞན་འགའ་ཡང་སྣང་དུ་མེད་པ་ནི་ཁྱུང་ལུང་དངུལ་མཁར་གྱིས་གསལ་བར་བསྟན་ཏེ་ཡོད་འདུག་ཁྱུང་ལུང་དངུལ་མཁར་རང་དང་།",
    "རྡོ་འབུམ་ཆེན་པོ་ཁག་གཉིས་བཞེངས་ཡོད་འདུག་པ་དང་།",
    "དངུལ་མཁར་གྱི་མདུན་རིའི་རྩེ་རྣམས་སུ་རྡོ་བརྩིགས་ཀྱི་ལྷ་ཁང་ཡང་མི་ཉུང་བ་ཞིག་གསར་བཞེངས་བྱས་ཡོད་འདུག་པ་དང་།",
    "ཁྱུང་ལུང་དངུལ་མཁར་གྱི་མདུན་དུ་ཡོད་པའི་ཆུ་བོ་དེའི་ཕར་ཕྱོགས་ཤིག་ན་བཞེངས་ཡོད་འདུག་པས་མཚོན།",
    "དེང་དུས་ཀྱི་པར་སིག་ལ་གཏུག་སྲོལ་ཡོད་འདུག་པ་དེ་ནི།",
    "དུང་གཤེན་མཚོན་ཆ་ཅན་ནོ་ཞེས་གསལ་རྒྱས་སུ་གསུངས་མཛད་པ་དེ་ལའང་དཔྱད་གཞིག་ནན་ཏན་དུ་གནང་དགོས་པ་འདུག་སྤུ་དེ་གུང་རྒྱལ་ནི་བོད་ཀྱི་ཐོག་མའི་རྒྱལ་རབས་གནམ་གྱི་ཁྲི་བདུན་དང་བར་གྱི་སྟེང་གཉིས་ཏེ།",
    "བཙན་པོ་དང་བཙད་པོ་ཞེས་པའི་ཚིག་འདི་གཉིས་ཀྱང་ཅི་བདེར་བྲིས་འདུག་པའི་དོན་གཅིག་ཏུ་སྣང་བ་ནི།",
    "སྐ་ལི་ཤུ་ཞེས་པ་ལྟ་བུའི་རིགས་མིང་ལ་སཱ་ཞེས་པའི་ཐ་སྙད་ཅིག་ཀྱང་བྱུང་ཡོད་འདུག་པ་དེ་དང་།",
    "གཞིར་བཞག་བྱེད་ཀྱི་ཡོད་འདུག་པ་དེ་དག་ལ་གཞིགས་ན།",
    "དེ་སྐབས་ང་རང་ལ་གོ་རྟོགས་མངོན་གསལ་ཐོན་པ་འགའ་ཞིག་བྱུང་བ་ནི།",
    "མེ་རིའི་ལྕོག་ཅེས་བྱ་བ་མེ་རིའི་གཤིན་པོའམ་སྒྲུབ་པ་གནང་མཁན་རྣམས་ཀྱིས་སྒྲུབ་པ་གནང་ཡུལ་སྒྲུབ་ཁང་ཞིག་བཞེངས་སྲོལ་བྱུང་འདུག་པའི་ལྕོག་ཅེས་བྱ་བའི་མེ་རིའི་སྒྲུབ་ཁང་དེའི་བཀོད་དབྱིབས་དང་།",
    "དེ་ལ་བརྟེན་ནས་ལུས་ཀྱི་བཀོད་དབྱིབས་ལའང་འགྱུར་ལྡོག་ཅི་རིགས་བྱུང་བར་བརྟེན་རིམ་གྱིས་མིའི་འགྲོ་བ་ཆགས་པར་སྙམ་པའི་ལྟ་ཚུལ་དང་ཤོད་ཚུལ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "འོན་ཀྱང་བོད་ཀྱི་བོན་པོ་རྣམས་ལ་རྒྱ་གར་གྱི་དབྱུག་པའི་ཤན་ཞུགས་འདུག་ཅེས་བྱ་བའི་ལྟ་ཚུལ་དེ་དང་།",
    "བོད་ཀྱི་ཐོག་མའི་རྒྱལ་པོའི་མཚན་ལ་ཉག་ཁྲི་ཞེས་འཁོད་ཡོད་འདུག་པ་དེ་ལ་དཔྱད་ན།",
    "ཞང་ཞུང་སྲིད་པའི་རྒྱལ་པོ་ཁྲི་ཝེར་གསེར་གྱི་བྱ་རུ་ཅན་གྱིས་སྟོན་པར་བསྙེན་ཅིང་བཀུར་ནས་བོན་གྱི་བསྟན་པ་ཕྱོགས་ཀྱི་ཐ་གྲུ་ཀུན་ཏུ་དར་ཞིང་རྒྱས་པར་མཛད་པའི་དུས་རབས་དེ་ནས་བཟུང་བརྩི་དགོས་པ་འདུག་སྙམ་སྟེ།",
    "དག་སྣང་དད་པ་བྱས་ན་རན་ཙམ་གདའ།",
    "ལྷ་ཁང་མཆོད་རྟེན་བཤིག་དུས་སྔོན་ཐོན་པ།",
    "དགེ་སྦྱོང་ཆེན་པོའི་རང་ལུགས་མིན་ཙམ་གདའ།",
    "གལ་ཏེ་ང་རང་ནང་ལ་ལོག་ན་གཡས་གཡོན་ཁྱིམ་མཚེ་རྒན་རྒོན་ཚོས།",
    "ཁོག་ཏུ་ཁོ་རང་གསོད་འདོད་ཡོད་ཀྱང་གདོང་པ་མཐོང་དུས་འཛུམ་མདངས་སྟོན།",
    "ཅི་ལྟར་བསམས་ཀྱང་ད་དུང་ང་རང་མི་ཡུལ་འདི་ན་འཚོ་བ་འདྲ།",
    "འོན་ཀྱང་ཕྱི་ནང་གང་ལ་བལྟས་ཀྱང་ད་དུང་ང་རང་འཚོ་བ་འདྲ།",
    "རང་རང་ཡིད་ལ་གང་དགོས་འདེདདགུའི་ཆར",
    "ཨ་ར་པ་ཙ་ན་ཡ་ཏེ་ན་མ",
    "འཆག་དང་འདུག་དང་འགྲེང་དང་ཉལ་བན།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས",
    "མི་རྟག་དུས་ཀྱི་མཐའ་འདི་ན།",
    "མཐའ་དམག་དུས་འཁྲུགས་ལང་པ་སོགས",
    "བདེ་བའི་སྟན་འདུག་བསམ་གཏན་གྱི",
    "ཅེས་གསུངས་འདུག་པས།",
    "འདུག་པའི་མལ་སྟནམནོལ་བཡོད་ན་ཡང་།་",
    "མི་ཤེས་གཏི་མུག་མུན་པསའཐིབས་ཙ་ན།",
    "དགྲ་ལ་ཞེསྡང་མེ་ལྟར་འབར་ཙ་ན།",
    "དག་པའི་ཞིང་དུ་སྐྱོལ་ཅིག་མངལ་སྒོ་ལས་ཀྱི་སྡུག་བསྔལ་བྱུང་ཙ་ན།",
    "ཕྱི་ནང་འགལ་རྐྱེན་བར་ཆད་བྱུང་ཙ་ན།",
    "མཚོ་སྐྱེས་རྒྱལ་བའིཕྱོག་དུས་རྒྱལ་བའི་སྐུ་གསུང་ཐུགས།",
    "དཔེ་གཅོད་འདོད་མི་གདའ་ན་གཡོར།",
    "རང་འདྲིས་རྡོ་རྗེའི་སྤུན་དང་རང་སློབ་ཀྱི་ཚོགས་ལ།",
    "རིང་འདྲིས་རྡོ་རྗེའི་སྤུན་དང་རང་སླེབ་ཀྱི་ཚོགས་དག།",
    "ཀུན་ཀྱང་རང་རིག་ལམ་གྱི་ངོར་རྫོགས་ཏེ།",
    "གཞན་ཡང་རང་འགྲོ་ཕྱོགས་ཀྱི་རྐུན་མ་རང་ལ་གནོད་པ་ཐམས་ཅད་བྲིས་ལ་གཞུག་གོ།",
    "བྱེ་བྲག་དུས་ཀྱི་འཁོར་ལོར།",
    "བརྟན་པའི་སྦ་སྟེགས་སྟན་ལ་འདུག།",
    "བརྟན་པའི་སྦ་སྟེགས་སྟན་ལ་འདུག་ཅེས་བྱ་བ་ནི་བདུད་ལ་སོགས་པས་མི་ཕྱེད་པ་བརྟན་པའི་སྦ་སྟེགས་ཀྱི་སྟན་ལ་འདུག་པའོ།",
    "གང་རང་བཞིན་གཞན་དུ་བསྒྱུར་བར་ནུས་པ་དེའི་ཤེས་པ་ཉིད་ཀྱི་ངོ་བོ་ཉིད་ཀྱང་མ་ཡིན་ལ་རྟག་པ་ཉིད་ཀྱང་མ་ཡིན་ཏེ།",
    "ཇི་ལྟར་རྣ་བས་ཀྱང་སྒྲ་ཐག་རིང་པོ་ན་འདུག་པ་ཐོས་ལ།",
    "དངོས་པོ་ཞེས་བྱ་བ་ནི་དེ་དངོས་སུ་འདུག་པའི་ཕྱིར་དངོས་པོའམ།",
