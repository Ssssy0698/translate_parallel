    "ལེགས་སྦྱར་རྒྱ་མཚོར་རི་བྱིའི་ཁྱོར་ཆུ་བཞིན།",
    "གངས་ཅན་སྐད་ཚུལ་ནོར་འཛིན་ཁྱོན་ཡངས་པ།",
    "རྣམ་དཔྱོད་གོམ་གཅིག་གིས་གནོན་སྲེད་མེད་བུ།",
    "མགོན་ཁྱོད་ཀ་ཡིག་རྐྱང་འཇུག་གསུང་བ་ན་། ཀེ་ལ་ཤ་དང་ཀ་ལིང་ཀོ་ཤམྦྷི།",
    "ལན་ཀན་རྩེ་མོར་ཀོག་གིས་ཀེར་ལངས་ནས།",
    "མན་ལན་མི་དཀུའི་སྤོས་སྦྱར་རོལ་མོ་དཀྲོལ།",
    "ཇི་སྐད་སྨྲ་ཡང་ཡིན་རེ་སྐན་ཞེས་དང་།",
    "སྐྱེད་མོས་ཚལ་དུ་རྒྱ་སྐྱེགས་སྒྱུ་གང་སྐྱུད།",
    "སེམས་སྐྱོ་སྐྱི་གཡའ་སྐྱ་རེངས་ཤར་ཚེ་སྐྱུགས།",
    "འཕུལ་མེད་ལ་མགོ་ཅན་དུ་ཁྱོད་བཞེད་ཅིང་།",
    "འཁར་རྩེར་འཁྲེན་ཀྱང་སེམས་འཁོལ་འཁྱོག་པོའི་འཁོར།",
    "འཁྱོམས་ཚེ་འཁྱོག་པར་འཁྱུས་ཀྱང་འཁྱགས་ཤིང་ཁུམས།",
    "གྲོ་དང་གྲོ་ཞུན་ནམ་གྲུ་མོན་གྲུའི་དུས།",
    "མོན་སྲན་གྲེའུ་ངམ་གྲོག་གྲ་ཟུར་དུ།",
    "གཡོ་སྒྱུས་སྐྱིད་ལུག་སྒྲེན་མོས་སྐྱོགས་རྡོ་ལ།",
    "ལུས་སྒེག་སྒོང་འགྲིལ་སྒོར་སོང་སྒང་དུ་སྒོམ།",
    "མངག་གཞུག་ཐུགས་མངའ་མངར་སྐྱུར་བཙུན་མོའི་མངལ།",
    "རྔམས་ཤིང་རྔ་མོ་རྒན་གཟུང་འཐུག་རྔམ་ཆེ།",
    "འདི་རྣམས་བ་རའི་བརྩེགས་འཕུལ་ཁྱོད་བཞེད་ཅིང་།",
    "ལྕག་པོད་མགོ་ལྕོགས་མཉན་ལྕོག་ལྕག་གིས་གཞུས།",
    "ཇེ་ཁྱོད་ཇེ་མཐོ་ཇག་པའང་རྐྱང་པར་བཞེད།",
    "ཉམས་དགའ་ལག་ཞྭ་ཉེ་རེག་ཉམ་ཆུང་ཉུང་།",
    "ཉོན་མོངས་ཉམས་མཛད་ཉིས་འགྱུར་ཉེ་བར་མཆོད།",
    "རྟ་རྒོད་རྟོད་པར་བཅིངས་དང་མོང་རྟུལ་བས།",
    "བརྟུལ་བ་དྲག་པོས་ཀུན་བརྟགས་ཞིབ་མོར་བརྟག།",
    "བཞུགས་སྟངས་བཀུར་སྟི་སྟོན་མོ་སྟོང་གྲོགས་བཅོལ།",
    "མནོལ་སྡིག་ལས་ཀྱིས་མནར་ཁྱོད་མནར་མེད་འགྲོ།",
    "མ་༩ པསུ་༧སྐཞས་ཚོ་༡མོའཚམཚོ་བརྣབ་སེམས་ལྐོག་བརྣོག་གྲེ་པར་བརྣངས་པ་དང་།",
    "གཞན་ཡང་སྣག་གི་གཉེན་མཚམས་སྣང་གསལ་སྣམ།",
    "དཔྲལ་བའི་དཔངས་མཐོ་དཔའ་བོ་དཔུང་གི་དཔལ།",
    "ནམ་ཕྱེད་དབུགས་ཕྱུང་ཕྱལ་པས་ཕྱག་ཀྱང་རེག།",
    "བྱི་མོའི་བྱད་བཞིན་ཕྱིན་ཡང་བྱི་བློ་འདྲ།",
    "བཞེས་སོགས་འཕུལ་མེད་བཞེད་ཅིང་དམག་དཔུང་དམོད།",
    "ཆང་གི་ནུ་རྫི་གླང་རྫི་མིག་གི་རྫི།",
    "འགིའུ་ཝཾ་པི་ཝཾ་ཝ་དང་ཕ་ཝཾ་དང་།",
    "བསྒོབ་རྣར་གཟོན་གཟུངས་སྤོབས་གཟིགས་ཤིང་གཟིར།",
    "གཡང་བླན་བློན་པོ་བླ་དྭགས་ལག་གིས་བླངས། ཟློག་པའི་སྔགས་ཟློས་ཟླ་མང་ཟློས་གར་བགྱིས།",
    "བར་ཆད་བཟློག་ཕྱིར་བཟླས་བརྗོད་ལད་མོ་བཟླས།",
    "སྲམ་དང་སྲེ་མོང་སྲོག་འཕྲོག་སྲིན་པོ་ཡིས།",
    "སྲོ་མ་ར་ཙ་སྲིང་མོ་འཕུལ་མེད་བཞེད།",
    "རྩྭ་བ་མོའི་ཧྲད་དང་གོས་ཧྲུལ་ཧྲིག་གེ་བལྟ།",
    "ཕུན་སུ་མ་མོ་ཤམ་རྔ་ཡབ་གེ་སར་སོགས།",
    "སླང་སྒོང་པུས་སམ་བཅས་མ་བས་དམ་པ་མགར་བས་མ་གསན་པ་མ་ལྟམོའི་སླང་ལ།",
    "སེ་མོ་དོ་ལ་ན་མཐའ་མེད་པར་བཞེད།",
    "སེ་མོ་སྐྲ་ཤད་ཕྱག་དར་ཙུམ་པ་ན།",
    "རང་གི་ལག་དར་ནེའུ་གསིང་བ་འཕུལ་ནོར།",
    "འོན་ཀྱང་མོའུ་འགལ་ལྟར་རུང་བའང་ཡོད།",
    "ཨ་མ་སོགས་ལ་ར་མགོ་ས་མགོ་ནོར།",
    "ག་ང་གཉིས་མཐར་གི་དང་ད་བ་ས།",
    "གོང་འོག་ཚིག་གི་འབྲེལ་བརྗོད་ཚུལ།",
    "བཙུན་མོ་མིག་བཙུམ་ལག་པ་བཙིར།",
    "ཚོས་བཙོད་བཙོན་བཟུང་ཚོས་ཀྱིས་བཙོས།",
    "ཟོང་དུ་བཙོངས་སོགས་བ་འཕུལ་ཙའོ།་ ལམ་བགགས་བགད་གད་མོ་པས་བགེགས་ཀྱི་ཉམས་སད་པའི་བགམ།",
    "དགོངས་བཞེད་བཞོན་པར་འོ་ཞོ་སོགས། བཟའ་བ་བཟའ་མི་རྒྱ་མོ་བཟའ་སོགས་ཀྱང་ངོ་བཟང་པོ་བཟབས་ནས་བཟས།",
    "མི་བློ་བསྲལ་ཅན་ཞེས་པའོ།་གྱེན་དུ་བསླངས་དང་བསློངས་མོ་བསླངས།",
    "ཡོངས་འདུ་ས་བརྟོལ་ལྗོན་ཤིང་ངོ། གྲི་བརྡར་ཕར་བརྡལ་ཕྱལ་མར་བརྡལ་བྱེད་རོལ་མོ་བརྡུངས།",
    "ལྕབསམ་བརྣག་བཀས་བཅད་དུ་རང་གི་བརྣག་པ་རྫོགས་པར་བྱ་བའི་ཕྱིར་དང་ཞེས་པ་ལྟ་བུའོ་བརྣག་བཀའ་བཟོད་པའི་མིང་སྦས་པའི་བསྣོགས།",
    "སྲིན་པོར་བརྫུས་ནས་རལ་པ་བརྗེས། བཅོམ་བརླག་ཡུལ་ཞིག་གི་མིང་བརླག་ཚེ་བརླ་ཤ་འདར།",
    "བརླིང་པོ་ཡ་མ་བརླ་རྙིང་པོ་མེད་པའི་དོན་ཞིག་འདུག། བལྟོས་མིག་གིས་བལྟར་རུང་བལྟ་བྱ་བལྟས།",
    "ཁྲོ་གཏུམ་གཏུམ་མོ་སེ་གོལ་གཏོགས།",
    "ཉིན་མོའི་གདུགས་དང་རྙེད་ལ་གདུང་།",
    "གནས་གཞི་བརྟག་གཞིག་ཉོན་མོངས་གཞིལ།",
    "སྟག་གཟིག་གཟིགས་ནས་རི་གཟར་གཟིམས།",
    "གཡུང་དྲུང་གཡུང་མོ་རིགས་ངན་ཀྱི་དོན་ལོག་གཡེམ་མི་བརྩོན་པའི་གཡེལ།",
    "གྲུ་ལ་གཙུགས་པའི་ཤིང་དང་ཆས་པའི་མིང་གཡོར་མོ་སོགས། གཤགས་འབྱེད་ཕྱེད་གཤགས་གཤའ་མར་དྲང་པོའི་དོན་གཤལ།",
    "ཡོད་དགུ་སྐྱེ་དགུ་དང་བཟང་དགུ་པོ་དགའ་བ་དགུན་དུས་ཉིན་དང་མཚན་མོའི་དགུང་།",
    "དགོངས་པ་དགོངས་མོ་དགོན་དུ་དགྱེས།",
    "དབྱིབས་དགྱེའི་དགྲ་བོ་བདེ་ལ་རྒྱན་དང་རྒོད་པ་དང་གད་མོ་སོགས་དགོད།",
    "ཏོག་གི་དབལ་བུ་དབུས་ཀྱི་བརྡ་རྙིང་དེར་གདུགས་དབུབ།",
    "བྲེད་ནས་འཁྲིས་དང་རོལ་མོ་འཁྲོལ།",
    "འཇབ་བུ་འཇིག་མ་རེག་འཇམ་འཇིབས།",
    "འཐབ་མོ་མུན་འཐིབས་སྲབ་འཐུག་ཆད་པ་འཐུད།",
    "དབྱེར་ཞིང་རྗེས་འབྲང་འབྲི་མོ་འབྲིང་།",
    "མཇུག་མ་མི་མཇེད་སསབགྱི་ནང་ཁྲོ་ཡབས་མབབཙཐལྟཨཏྠ་ཨ་ཏྟཱཨུཏུའུ་ག་༡༣༦ཡ་༡༩མག་ཏི་ཀ་ཀཉྩ་ཀཱཎ་མཱ་མཱ་མ་མཎོརྩ་ཏཱ་ཝུ་ཀ་བྷསཞིང་ལ་སོགས། མཉན་ཡོད་དང་མཉམ་རྣ་བས་མཉན།",
    "མཚོན་ཆ་སྐྱོན་མཚང་མིང་གི་མཚན།",
