    "ཉེས་བྱས་ལས་ཀྱི་རྣམ་སྨིན་མི་བཟོད་ན",
    "ཡལ་ཡོལ་བཏང་སྙོམས་ལེ་ལོ་མ་མཛད་པར",
    "ཞེས་བཤགས་པ་ཐམས་ཅད་ཀྱི་རྒྱུད་དྲི་མ་མེད་པའི་རྒྱལ་པོ་ལས་ཟུར་དུ་བཀོལ་བའོ།",
    "སྡིག་སྒྲིབ་ཉེས་ལྟུང་དྲི་མའི་ཚོགས་ཐམས་ཅད་བྱང་ཞིང་དག་པར་མཛད་དུ་གསོལ།",
    "ལུས་སེམས་ཟག་མེད་ཀྱི་བདེ་བས་མྱོས་པར་བསམ་ཞིང་།",
    "རྡོ་རྗེ་སེམས་དཔའ་དགྱེས་ཤིང་འཛུམ་པར་མཛད་དེ།",
    "ཞེས་གནང་བ་བྱིན་ཏེ་འོད་དུ་ཞུ་བ་རང་ལ་བསྟིམ།",
    "མཐར་བདེ་སྟོང་བརྗོད་བྲལ་གྱི་ངང་ལ་མཉམ་པར་གཞག།",
    "མཎྜལ་འབུལ་བའི་ཆོ་ག་ཚོགས་གཉིས་སྤྲིན་ཚོགས་མཎྜལ་འབུལ་བའི་ཆོ་ག་ཚོགས་གཉིས་སྤྲིན་ཚོགས་བཞུགས་སོ།",
    "རྒྱས་པར་བྱེད་ན་ཚོམ་བུ་བཞི་བཅུ་རྩ་གཅིག།",
    "དབུས་སུ་ལྷ་དང་མིའི་འདོད་པའི་ཡོན་ཏན་མ་ཚང་བ་མེད་པ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ལེགས་པར་བཀོད་དེ།",
    "བཅོམ་ལྡན་འདས་དཔལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་རིགས་ལྔ་གང་ཆེན་མཚོའི་སྐུ་དང་གསུང་དང་ཐུགས་མི་ཟད་པ་རྒྱན་གྱི་འཁོར་ལོ་ལ་བརྟེན་པའི་ཞིང་ཁམས་འབྱམ་ཀླས་པ།",
    "རྣམ་པར་རྒྱལ་བའི་རྒྱལ་མཚན།",
    "ཕྱི་ནང་ཀུན་ཏུ་ཡང་ལེགས་པར་བཀོད་པའི་གནས།",
    "ལྷུན་གྲུབ་ལོངས་སྐུའི་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "གདོད་ནས་རྣམ་དག་འོད་གསལ་ཞིང་ནི་མ་སྐྱེས་ལྷུན་རྫོགས་འདུས་མ་བྱས།",
    "རང་སྣང་དག་པས་ལེགས་པར་ཕུལ་བ་ཡིས།",
    "དྲི་མེད་འོད་ཟེར་ཞེས་བྱས་བཀོད།",
    "འདིར་གཤེགས་བདག་ལ་དགོངས་ཤིང་བཞུགས་སུ་གསོལ།",
    "འགྲོ་ཀུན་སྐྱོན་བྲལ་ཡོན་ཏན་རྫོགས་པར་ཤོག།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ལེགས་པར་བཀོད་དེ་བཅོམ་ལྡན་འདས་དཔལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་རིགས་ལྔ་གངས་ཆེན་མཚོའི།",
    "སྐུ་དང་གསུང་དང་ཐུགས་མི་ཟད་པ་རྒྱན་གྱི་འཁོར་ལོ་ལ་བརྟེན་པའི་ཞིང་ཁམས་རབ་འབྱམས་མཐའ་ཀླས་པ་ཚངས་ཆེན་གྱི་བསྐལ་པ་ཆེན་པོས་ལེགས་པར་བརྒྱན་པ་འདི་ཉིད།",
    "རྣམ་པར་རྒྱལ་བའི་རྒྱལ་མཚན།",
    "རྟག་པར་རྒྱུན་གྱི་འཁོར་ལོར་འབུལ་ལོ།",
    "ལྷུན་གྲུབ་ལོངས་སྐུའི་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་ཅིང་ལྷུན་གྱིས་གྲུབ་པ་འདི་ཉིད།",
    "གདོད་ནས་རྣམ་དག་འོད་གསལ་ཞིང་ནི་མ་སྐྱེས་ལྷུན་རྫོགས་འདུས་མ་བྱས།",
    "རང་སྣང་དག་པས་ལེགས་པར་ཕུལ་བ་ཡིས།",
    "བལ་ཡུལ་ཞེ་དགོན་གྱི་པར་གསར་འདིར་གསར་བཞག་བྱས་པས་ལུང་རྒྱུན་ལ་ཞིབ་རྟོག་དགོས་པ་ཡིན་ནོ།",
    "ལྟར་སྣང་ཐ་མལ་བ་རྣམས་དང་ཤིན་ཏུ་མཉམ་པར་སྤྱོད་པ",
    "གསང་བ་སུས་ཀྱང་བརྟག་པར་དཀའ་བ",
    "དུས་སུ་བབས་པའི་ཚེ་གང་ཟག་དེའི་རྒྱུད་ལ་བྱིན་གྱིས་བརླབས་པས་སད་པར་གྱིས་ཤིག",
    "སྐལ་ལྡན་ཅིག་ཅར་བའི་རིགས་ཅན་འགའ་ཞིག་ལ་ཕན་པར་འགྱུར་རོ",
    "ཟབ་ལམ་གྱི་རྟོགས་པ་ཁྱད་པར་ཅན་རྒྱུད་ལ་སྐྱེ་བར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཁྱད་པར་གྱི་སྔོན་འགྲོ་འོ།",
