    "རང་འདོད་གདན་ལ་འདུག་ཅིག་གཞོན་ནུ་ཀྱེ།",
    "དེས་ན་སྔར་གྱི་འགྱུར་རྙིང་རང་སོར་བཞག་ན་ལེགས།",
    "རྒྱས་པར་གཞུང་རང་ལས་ཤེས་པར་བྱའོ།",
    "དེ་དག་ཉམས་སུ་ལེན་པ་དང་རང་རྒྱུད་ལ་བསྐྱེད་པའི་ཕྱི་རོལ་བ་ཇི་སྙེད་ཅིག་བྱུང་བས་སོ།",
    "བྷོ་ཊ་ནི་བོད་ཅེས་པའི་སྒྲ་ཕར་ལ་ཟུར་ཆག་པ་ཡིན་ཏེ་གཞན་གྱི་འབོད་པའི་རང་མིང་རང་ལ་ཟུར་ཆག་པ་མི་འཐད་ལ་རྒྱ་ནག་པས་ཐུ་བྷོད་ཅེས་པའང་བོད་ཅེས་པའི་སྒྲ་དང་ཁད་ཉེ།",
    "གང་ཞིག་དུས་གསུམ་ཚིག་ལ་འཕུལ་མེད་དང་།",
    "རང་དང་རང་མ་ཡིན་པ་སེལ་བའི་ཚུལ་གྱིས་འཇུག་པའི་ཕྱིར།",
    "ཚོ་སྨོན་ཙྪཱ་ཚོ་ཚོ་ཚོ་དེ་ཡང་རང་ཅག་ཁ་བ་རི་པའི་མེས་པོ་ནི་གངས་ལྗོངས་ས་མཐོ་རང་ནས་སྐྱེས་གནས་འཕེལ་གསུམ་བྱུང་བའི་མི་རྒྱུད་ཅིག་ཡིན་ཞིང་།",
    "མི་དང་ཎྞཾ་ཀྱི་མི་དབར་གྱི་འབྲེལ་བ་དང་མི་དང་རང་བྱུང་ཁམས་དབར་གྱི་འབྲེལ་བ་སོགས་ལ་འགྲེལ་བརྗོད་བྱ་རྒྱུའི་ཐབས་རྩལ་ཉག་ཅིག་དེ་ཡིན་ལ།",
    "ཕྱིས་སུ་རྫོགས་ཆེན་གྱི་གཞུང་ལུགས་ནང་ཐ་སྙད་དེ་དག་ལྷན་ཅིག་སྐྱེས་པའི་རིག་པ་དང་མ་རིག་པ་ཞེས་པར་འཕེལ་རྒྱས་ཕྱིན་ཡོད་ཡོད་ཚུལ་ནི་གཅིག་མཚུངས་ཡིན་འདུག་ལ།",
    "བོན་ལུགས་གཅིག་པུ་མ་ཡིན་པར་རྙིང་མ་བའི་གྲུབ་མཐས་ཀྱང་རང་ཉིད་ཀྱི་གཞུང་ལུགས་རྣམས་ནང་གསེས་དགུ་རུ་དབྱེ་བ་ཡིན།",
    "ཨ་རིའི་རོ་པིན་ཞེས་པའི་དངོས་མང་བཤམས་སྟོན་ཁང་དུ་ཉར་ཚགས་བྱས་པའི་སྒྱུ་རྩལ་དངོས་རྫས་འགའ་ཞིག་འདུག་པ་དེའི་ཐོག་བྲིས་པའི་ལྷ་རྣམས་ནི་གོང་གསལ་ཆོ་གའི་དཀྱིལ་འཁོར་དེའི་ཁོངས་སུ་གཏོགས་པ་ཡིན།",
    "ཁྱིམ་ཚང་ལྔ་པོའི་བར་ཀྱི་འབྲེལ་བ་ནི་སྤྱིར་བཏང་ཕན་ཚུན་གཉེན་སྒྲིག་བྱེད་པ་དང་ཡང་ན་བླ་སློབ་ཀྱི་འབྲེལ་བའི་ཐོག་ནས་རྒྱུན་སྐྱོང་བ་ཡིན་འདུག།",
    "ཀུན་གྲོལ་གྲགས་པའི་གསུང་རྩོམ་ནང་ནས་ཞི་ཁྲོའི་ཆོ་གའི་དཀྱིལ་འཁོར་སྐོར་དེ་ནི་སྙན་གྲགས་ཆེ་ཤོས་དེ་ཡིན་ལ་ཁོང་རང་ཉིད་ནས་ཀྱང་དེ་ལ་མཉེས་ཤོས་མཛད་པར་གྲགས།",
    "དེང་དུས་ཀྱི་བློ་གཟུ་བོར་གནས་པའི་བན་བོན་གྱི་ལྟ་སྤྱོད་གཉིས་ཀར་ཞིབ་འཇུག་གནང་མཁན་ཕྱི་ནང་མཁས་པའི་འདོད་ཚུལ་ཡང་དེ་ལྟར་ཡིན་འདུག་པ་ནི་མ་བརྟགས་བྱུང་རྒྱལ་དུ་སྨྲས་པའི་གཏམ་ནི་ག་ལ་ཡིན་སྲིད།",
    "རྩོམ་ལུས་ཉིད་ཡུག་གཅིག་ཏུ་སྒྲིལ་ནས་འཁོད་པ་ལས་དུམ་མཚམས་དང་ས་བཅད་སོགས་གང་ཡང་དབྱེ་མི་འདུག་ལ།",
    "གནའ་བོའི་བོད་ཀྱི་བཙན་པོ་རྣམས་ནི་བློན་པོ་དང་སྐུ་གཤེན་རྣམས་ལ་བརྟེན་ནས་སྲིད་སྐྱོང་བ་ཡིན་འདུག་ལ།",
    "དེ་ནི་དྲན་པ་ཨ་དཀར་དགོངས་འདུས་དཀྱིལ་འཁོར་གྱི་ལྷ་གཙོ་བོའི་གྲས་ཤིག་ཡིན་ཚུལ་འཁོད་འདུག་ཐང་གའི་རྒྱབ་ངོས་ཀྱི་ཡི་གེའི་ཐོག་ཏུ་ཨ་དཀར་ས་ལེ་འོམ་ཨ་ཡང་ཨོམ་དུ།",
    "ཨ་ཨོམ་ཧུམ་གྱེར་པུང་དྲན་པ་མུ་ལ་ཉེ་ལོ་ཡོ་ཧུམ་དུ་ཞེས་པ་འཁོད་འདུག་པ་མ་ཟད།",
    "ངོས་འཛིན་གསལ་པོ་བྱེད་མི་ཐུབ་པར་ལུས་པའི་སྐུ་དེའི་གཡས་དུ་སེང་གེ་བཞོན་པའི་སྐུ་ཞིག་འདུག་པ་དེ་ནི་ཕལ་ཆེར་རྨ་ཆེན་སྤོམ་ར་ཡིན་པ་འདྲ།",
    "གཤམ་གྱི་གཡོན་ཟུར་ན་ཕྱག་བཅོ་བརྒྱད་ཅན་གྱི་ཁྲོ་བོའི་ལྷ་ཞིག་བཞེངས་འདུག་ཅིང་།",
    "བཞུགས་ཁྲི་ནི་རྟ་གཉིས་ཀྱིས་བཏེགས་ནས་ཡོད་ལ་སྐུ་གཙོ་བོ་དེའི་མཐའ་འཁོར་དུ་གཟེར་མིག་ནང་དུ་འཁོད་པ་ལྟར་གཤམ་འོག་དུ་འཁོད་པའི་སྐུ་རྣམས་འཁོད་འདུག་ཏེ།",
    "དབལ་གསས་རྔམ་པ་ནི་ཞལ་གསུམ་ཕྱག་དྲུག་དང་ཡབ་ཡུམ་གྱི་སྐུར་ཡང་བཞེངས་སྲོལ་འདུག་ཅིང་།",
    "བོན་གྱི་ཐང་གའི་སྟེང་མེ་རིའི་གཡས་གཡོན་གཉིས་སུ་ཁྱུང་ཆེན་བཞི་འཁོད་འདུག་པ་དེ་དག་གཡོན་ནས་གཡས་སུ་བརྩིས་ན།",
    "ཀུ་བྱི་མང་ཀེ་སོགས་ཀྱང་བཞེངས་པ་འདུག་པ་དེ་དག་ནི་གཟུགས་དང་།",
    "ངམ་རྗེ་རྩོལ་པོས་ཡེ་རྗེའི་སྤྱན་ལ་དམིགས་ནས་མདའ་ཞིག་འཕང་ཡང་དེ་ཡེ་རྗེའི་སྤྱན་ལ་མ་ཕོག་པར་ཞྭ་ལ་ཕོག་དུས་དེ་ནས་བཟུང་མདའ་དེ་ནི་བཀྲ་ཤིས་པའི་མཚོན་བྱེད་དུ་བརྩི་བའི་སྲོལ་བྱུང་ལ།",
    "རྒྱ་གར་གྱི་གཏམ་རྒྱུད་ནང་དུག་སེལ་གྱི་ནུས་པ་ལྡན་པའི་རྨ་བྱའི་སྒྲོའི་སྐོར་གླེང་ཚུལ་དེ་གཉིས་ཀྱང་འདྲ་མཚུངས་སུ་འདུག་ལ།",
    "མི་དང་ལྷ་རུ་ལྡེབ་ཙ་ན།",
    "ཟེར་ལོ་འདུག་ལོ་མ་ཟེར་ཅིག་བྱ་བ་སྤྱན་ལམ་གང་བྱེད་ཀྱང་།",
    "རང་རང་ཕྱག་ཏུ་འབུལ་གྱིས་བཞེས།",
    "བུ་སྲིང་དཔལ་དང་ལྡན་ཙ་ན།",
    "འོན་ཀྱང་དུས་མཚུངས་སུ་བོན་པོ་རྣམས་ཀྱིས་ཀྱང་རང་ཉིད་ཀྱི་རྟེན་གཞི་བསྐྲུན་འགོ་བརྩམས་ཡོད།",
    "བོད་སིལ་པོའི་དུས་སུ་དར་སྤེལ་ཕྱིན་པའི་བོན་དེ་ཉིད་ནི་སྔར་གྱི་བོན་གཞུང་ཉིད་རྒྱུན་མཐུད་བྱས་པ་ཞིག་ཡིན་མིན་སྐོར་ལ་ད་ཕན་ཞིབ་འཇུག་བྱ་མཁན་ཧ་ལམ་བྱུང་མི་འདུག་ཁོ་བོའི་འདོད་ཚུལ་ལྟར་ན།",
    "རྫོགས་པ་ཆེན་པོའི་གཞུང་ནི་བི་རོ་ཙ་ནས་དུས་རབས་བརྒྱད་པའི་སྐབས་སུ་རྒྱ་གར་ནས་གདན་དྲངས་པར་གྲགས།",
    "ཤྲཱི་སི་ནི་བི་རོ་ཙ་ནས་རྒྱ་གར་གྱི་ཡུལ་དུ་མཇལ་བའི་སློབ་དཔོན་གྱི་གྲས་ཤིག་ཡིན་ལ།",
    "རྫོགས་ཆེན་ཞེས་པའི་ཚིག་དེའི་འོག་བི་རོ་ཙ་ནས་བསྒྱུར་བར་གྲགས་པའི་བཀའ་རྣམས་ཚུད་པ་མ་ཟད།",
    "དེ་ལྟ་བུའི་རྩོད་རྙོག་ཅིག་དུས་རབས་འགའ་ཞིག་ནང་དུ་འཁྲུན་ཐག་མ་ཆོད་པར་ལུས་ཡོད།",
    "བོད་དུ་དར་བའི་བསམ་གཏན་གྱི་ལྟ་བ་ནི་རང་ཚུགས་ཅན་གྱི་གཞུང་ལུགས་ཤིག་ཏུ་ངོས་འཛིན་གྱིས་ཉམས་ལེན་བྱས་ཚུལ་ནི་བསམ་གཏན་མིག་སྒྲོན་ཞེས་པའི་དཔེ་རྙིང་ནང་དུ་གསལ་པོ་འཁོད་འདུག་གོ།",
    "མི་དང་མི་མིན་འགྲོ་བོ་མཐའ་ཡས་པ།",
    "ཚོགས་ཤིན་ཏུ་སྙན་པའི་ནོར་བུའི་རྒྱུད་མང་སྟོང་ཕྲག་དུས་གཅིག་འཁྲོལ་བྱེད་པའོ།",
    "དམ་ཚིག་ཆེན་པོས་ངེས་གསང་བསྟན་དང་བསྟན་འཛིན་གང་དུ་འདུག་ཀྱང་སྐྲངས།",
    "གཡོས་སྐཙྪཱ་པ་རང་རང་ཕྱག་མཚན་དང་ནི་གཡོན་པ་གཏེར་གྱི་ནའུ་ལེ་འཛིན།",
    "བྱས་ཡང་འབྲས་ཉུང་འཁྲུལ་རྟོག་རྒྱ་ཡན་ལ་འབྱམས་འདུག།",
    "བློ་བྲལ་རིག་པའི་རང་ཚུགས་ཟིན་པ་ཞིག་མི་འདུག།",
    "བསླབ་གསུམནོར་བུའི་མཛོདཀྱིས་འབྱོར་དུས་ནི་མི་འདུག།",
    "གཞན་གྱི་དམར་བཟུང་ཡང་རང་རྒྱུད་ནི་ཐ་མལ།",
    "གསེལལྟ་སྒོམ་འབྲས་བུས་དྲེད་ཚད་རྙེད་དུས་ཞིག་མི་འདུག།",
    "སྡུག་བསྔལ་སྲིད་མཚོའི་ཕ་རོལ་སྒྲོལ་ངེས་ཤིག་མི་འདུག།",
    "འཇིགས་སྐྲག་འཁྲུལ་སྣང་སྔལ་བཟོད་ཐབས་རང་མི་འདུག།",
    "སྔགས་སུཁ་པར་རློམ་ཡང་དག་སྣང་ནི་མི་འདུག།",
    "གཞན་དོན་བརྩོན་པར་རློམས་ཀྱང་རང་འདོད་ཀྱི་རྙེད་ཚོལ།",
    "ཐོས་ཀྱང་རང་རྒྱུད་ལམ་འབྱོར།",
    "རྒྱུ་འབྲས་ཁ་ལ་ཡོད་ཀྱང་ལག་ལེན་ལ་མི་འདུག།",
    "སྦྲང་པོའི་ལེགས་ཉེས་སྐྱིད་སྡུག་ཁྱེད་རང་མཁྱེན།",
    "ཐུགས་རྗེ་རྒྱུན་ཆད་མེད་ལཁྲ་འབྲུག་དུས་པ་ཕྱིམལ།",
    "གེགས་མེང་ཡོངས་སུ་འགྲུབ་པའི་རྒྱུར་གྱུར་ཅིགཅེས་པའང་ཤཱཀྱའི་དགེ་སློང་འདུགསུམ་སྤྱོད་པ་འགྱུར་མེད་པདྨ་རྣམ་རྒྱལ་གྱིས་གུས་ཤིང་དྭངས་བའི་བློས་བརྗོད་པདོན་དང་ལྡན་པ་ལ་གྲུལ་ཅིག་བརྦ་མངྒ་ལཾ།",
    "དེའི་སྟོད་དུ་ཉེབར་འདུགནས་སྟོང་ཕྲག་བརྒྱུད་ཉིན་ཞག་གསུམ་ཐུན་གསུམ་དུ་བཟླས་པར་བྱའོ།",
    "ཉེ་བར་འདུག་སྟེ།",
    "པནྟིཏྟཾནཔའཡོན་སེང་རག་འདུག།",
    "ལྟོ་འཕྱེའི་ཙུང་རང་།",
    "དེ་རྟག་ཏུ་ལྷ་ཐམས་ཅདལ་འདུག་པ་དང་།",
    "ཡུལ་དེར་འཁོད་པའི་སྐྱེ་བོ་རྣམས་ཀྱང་རང་བཞིན་བཟང་ཞིང་འདྲིས་ཤིབ་བདེ་བ།",
    "ཞང་པོ་སོགས་མཉམ་བཞུགས་ཡོད་འདུག་པར།",
    "འཇམ་དབྱངས་དོན་གྲུབ་ཅེས་མིང་གསོལ་སྩལ་གནང་འདུག་པའི་མིང་དེ་བྱིས་པ་ནས་ད་ལྟ་བར་བརྗེ་བསྒྱུར་མ་བྱས་པའི་མིང་ཡིན།",
    "དེ་ཙམ་དད་གུས་འཁྲུངས་ཡོད་མེད་མ་ངེས་ཀྱང་ལྷན་སྐྱེས་ཀྱི་དགའ་ཚོར་བློ་ལས་འདས་པ་ཞིག་སྐྱེས་པ་དྲན་གྱི་འདུག་གསལ་སྣང་ནི་སྤྱན་གྱི་དཀར་ནག་དང་།",
    "ང་རང་ངོས་དུས་རྒྱུན་དང་།",
    "དུད་པ་བློས་མི་བཟོད་པ་ཐུལ་འདུག་པས།",
    "ཞུ་ཤེས་ས་མི་འདུག་བུ་འཇམ་དབྱངས་སྐུ་བསོད་མེ་འབར་བ་དང་།",
    "རྒྱུ་རྐྱེན་རྟེན་འབྱུང་ཟེར་བ་བསླུ་བ་མེད་སྟབས་དུས་ད་ལྟ་ཡང་རང་ངོས་ཡ་མཚན་སྐྱེ་དགོས་པ་འདི་ལྟར་བྱུང་མྱོང་།"
