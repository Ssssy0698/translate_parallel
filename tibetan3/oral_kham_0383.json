    "ཁྱེད་ཀྱིས་ཀྱང་དེ་ལྟར་བྱེད་འདུག་གསུངས་ཤིང་སྐུའི་མཛད་སྤྱོད་མཐུན་པ་དང་།",
    "ཀླུ་དང་གཟའ་རིགས་སྲུང་བའི་མན་ངག་དུས་འཁོར་ལུགས།",
    "སྤྱིར་ཁྱེད་རང་སྤུན་རྣམས་ཀྱི་ཚེ་ལ་ཐར་རྩེ་ཡང་དར་ཞིང་རྒྱས་པར་འབྱུང་།",
    "ཁྱེད་རང་ཀུན་སྤྱོད་ཐམས་ཅད་ད་ལྟའི་འདི་བཞིན་དུ་གྱིས་དང་།",
    "ད་ལྟའི་ངོར་པའི་ཞབས་དྲུང་ཐམས་ཅད་ཀྱི་ནང་ནས་ཁྱེད་རང་དྲག་ཤོས་སུ་འདུག་གསུངས་པ་། དང་ངེད་ཀྱི་ཡི་དམ་གྱི་ལྷ་བཅུ་གཉིས་པོ་དེ་རབ་གསེར་ཟངས་ལས་གྲུབ་པ།",
    "དེང་སྐབས་ཨེ་ཝཾ་པའི་བསྟན་པའི་ཉམས་ལ་ཕན་པ་ཐར་རྩེ་ཁོ་ནར་འདུག་གཤིས།",
    "རང་རང་བདོག་པའི་མེ་ཏོག་ཀུན།",
    "དེ་ལ་བརྟེན་ནས་ཁུ་བོ་མཁན་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོས་ཀྱང་བྱིས་པ་འདི་ཤིན་ཏུ་བཙུན་པ་ཞིག་འདུག་ཅེས་ཡང་ཡང་བཀའ་སྩལ་པ་ཞིག་ཡིན་ན།",
    "གཞན་རྣམས་ལའང་ཡང་ཡང་བཀའ་སྩལ་འདུག་པས།",
    "དེའང་མང་མཁར་དུ་ཕྱིན་ན་ཞོར་དུ་ཕུན་ཚོགས་གླིང་ལ་སོགས་པའི་གནས་ཁྱད་པར་ཅན་འདྲའང་མཇལ་བར་འདུག་ཅེས་བཀའ་ཕེབས་ནའང་།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱང་བསྡད་པས་ཆོག་ཅེས་ཡང་ཡང་བཀའ་སྩལ།",
    "ངོར་ཆེན་གྱི་སྐུའི་གཡས་ངོས་སུ་བཞུགས་འདུག་པས་ལེགས་པར་མཇལ་ཏེ་གསོལ་བ་བཏབ།",
    "དེའི་གཡས་ངོས་སུ་རྗེ་འདི་སྐུ་དངོས་བཞུགས་འདུག་པས།",
    "གཉིད་སད་ནས་ཀྱང་བསམ་བཞིན་དུ་དད་ཤུགས་ཀྱི་མཆི་མ་རྒྱུན་མི་ཆད་པར་འོང་བ་ཞིག་འདུག་མངོན་སུམ་ལས་ཀྱང་གསལ་བའི་རྨི་ལམ་དེ་ལྟ་བུ་ཞིག་བྱུང་བས་རྗེ་འདི་སྐུ་ཁམས་ཅི་འདྲ་ཞེས་དྲིས་བྱུང་བ་དང་།",
    "གྱིས་ཁྲིག་གེར་གང་འདུག་ཅེས་གླིང་།",
    "དེ་ན་མི་ནག་པོ་འཇིགས་སུ་རུང་བ་ཞིག་འགྲོ་ཡིན་འདུག་པ་ཀུན་བསོད་ལ་ཕྱི་མིག་ཅིག་བལྟས་ནས།",
    "དེ་ཉིན་ཐོ་རངས་ནས་བཟུང་ནམ་མཁའ་ཐམས་ཅད་ཁ་དོག་སྣ་ཚོགས་པའི་སྤྲིན་གྱིས་གང་བ་ཞིག་ནི་ངེས་པར་འདུག་ཅིང་།",
    "པདྨ་དཀར་པོ་ལ་སོགས་པ་མེ་ཏོག་མང་པོས་མཛེས་པར་ཁེབས་པས་ས་ཕྱོགས་རྣམས་ཉམས་དགའ་དགའ་ལྟར་འདུག་པ།",
    "དབུ་གདུགས་ལྟར་འདུག་པ།",
    "འཇིག་རྟེན་བདེ་དང་རང་སྲོག་ལ།",
    "ཁྱེད་རང་ཡང་བསྙེན་པ་ཞིག་གྱིས་། ཤིག་གསུངས་ནས།",
    "དག་པ་འདི་ན་བཞེད་པ་འདུག་པ་ཡིས།",
    "ཁྱེད་རང་ནས་དེ་སྔའང་བསྟན་པ་ལ་ཕན་ཐོགས་ལེགས་པར་མཛད་ཡོད་ཚོད་འདུག་པ་དང་།",
    "ནུབ་ཕྱོགས་ནས་དང་པོ་ཟླ་བ་དཀར་ཞིང་འོད་ཆེ་བ་ཞིག་ཤར་ནས་ཚུར་ཙམ་སླེབས་པ་དང་།",
    "དགུ་པ་རྗེས་མའི་ཚེས་གཅིག་ཙམ་ལ་གྲོལ་བས་ཆོག་དེ་བར་བྲེལ་བ་མི་འདུག་གསུངས།",
    "ཁྱེད་རང་ནས་འདི་རིགས་དཀའ་ལས་ཆེའང་རྗེས་སོར་འཕྲད་འོང་གསུངས་ཏེ་ཞིང་འདིར་བཞུགས་ཐུབ་པའི་ཞལ་བཞེས་ནི་མ་ཐོབ།",
    "ཁྱེད་རང་ནས་དམ་ཚིག་ལ་བསྲུང་སྡོམ་དང་།",
    "གཞན་གྱི་ཁ་དོག་སོགས་ཞིབ་པར་མ་ངེས་ཀྱང་ལྔ་ཙམ་ཞིག་འདུག་སྙམ་པའི་ངང་ནས།",
    "གོས་དང་འགྲོ་འདུག་ཟས་བླངས་ཟས་ཟ་བ།",
    "དེལྟར་སྡོམ་གསུམ་བཅས་དང་རང་བཞིན་གྱི།",
    "གནམ་མཚོའི་དྲུང་རང་བྱོནེ།",
    "འདི་འདྲ་རྙེད་པ་མི་འདུག།",
    "བྱས་ཀྱང་ཡོང་ས་མི་འདུག།",
    "མ་གཏོགས་འགྲོ་ས་མི་འདུག།",
    "ལོང་སྟེང་ལོང་བུ་བཞག་སྟེ་འདུག་པ་སོགས་དང་ཁྲི་འོག་རྐང་བ་བཅུ་གཉིས་འདུག་པ་དང་།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོདདང་།",
    "རང་རང་སོ་སོའི་གནས་ཡུལ་ཇིསྙེད་ནས།",
    "སླར་ཡང་རང་མདུན་ནམ་མཁའི་དབུས།",
    "འདུགསྤྱི་བོར་པད་ཟླ་བརྩེགས་པའི་སྟེང་།",
    "ཁྱད་པར་སྡོམ་གསུམ་བཅས་དང་རང་བཞིན་གྱི།",
    "འཕགསམ་ཡང་རང་ལ་ཐིམ་པར་གྱུར།",
    "མཆོད་རྫས་དངོས་སུ་བཤམས་དང་རང་རིགས་ཀྱི།",
    "མགྲོན་རྣམས་རང་རང་གནས་སུ་དགྱེས་བསྐྱེད་ལ།",
    "རང་ལས་བྱུང་ཞིང་རང་ལ་གནོད།",
    "དེཡང་རང་གསེར་གྱི་མཆོད་རྟེན་འཇིག་རྟེན་གྱི་ཁམས་འགེངས་པ།",
    "དེ་གཉིས་ནི་གོ་རིམ་བཞིན་དུ་རྟེན་དང་བརྟེན་པ་ཡིན་ཞིང་རང་བཞིན་གྱི་རིགས་ཙམ་དེ་རྒྱུར་ཡོད་ལ་ཡོན་ཏན་མངོན་དུ་མ་གྱུར་པས་འབྲས་བུར་མེད་ཅིང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "དང་པོ་ནི་གལ་ཏེ་གཞན་ལ་གནོད་པ་མི་བྱེད་ཀྱང་རང་ཉིད་འབྱོར་པའི་ཚེ་རྒྱགས་པ་དང་།",
    "ཤེས་སྒྲིབ་ཀྱི་ཕྱོགས་གཅིག་གཟུང་རྟོག་ཀྱང་སྤང་རུང་དུ་འདུག་པ་འབྲིང་སྟེ་རང་རྒྱལ་གྱི་རིགས་དང་།",
    "གདུལ་བྱའི་སེམས་ཇི་ལྟར་འདུག་པ་ལྟར་རྟོགས་པ་གཞན་གྱི་སེམས་ཤེས་པ་དང་།",
    "འཛིན་པ་འཁྲུལ་པའི་རྒྱུ་དང་རང་བཞིན་བསྟན་པ།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "མིན་པར་སྟན་ཆེས་མཐོ་བར་འདུག་པ་ལ་མ་ཡིན།",
    "འོ་ན་དེ་གཉིས་ཀྱི་ཉེས་དམིགས་དང་ཕན་ཡོན་དེ་དག་དུས་ཇི་སྲིད་ན་མྱོང་བར་འགྱུར་ཞེ་ན།",
    "ཡང་ན་གཡེང་བ་སྟེ་སེམས་རྣལ་དུ་མི་འདུག་པའི་ཕྱིར་རམ།",
    "ཕུང་པོ་རྣམས་ནི་དུས་གཞན་ན་ཡང་བརྟན་པར་འདུག་གོ་ཞེས་ཟེར་རོ་ཞེས་བྱུང་ངོ།",
    "བདག་ཉིད་འདུག་པ་ནི་དེ་ལྟ་བུའི་འབད་རྩོལ་ལ་མ་ལྟོས་པར་ཀ་བུམ་ལ་སོགས་པ་དམིགས་པ་ལྷན་སྐྱེས་སོ།",
    "བན་ཚུལ་སྣ་ཚོགས་ཞིག་ཡོད་འདུག་སྟེ།",
    "ཁོ་རང་བ་ཁྲུལ་བ་ལས་དོན་དུ་མེད་སྙམ་དུ་ཤེས་ཀྱང་།",
    "རིགས་པ་གཞན་གྱིས་ཀྱང་རང་རིག་མི་འཐད་པར་བསྟན་པ།",
    "ཁོ་རང་ལ།",
    "འགྲེང་འདུག་ཉལ་དང་འཆག་པར་མི་བྱའོ།",
    "མཐུན་པའི་གོས་ཡིད་ལ་བྱས་ཙ་ན།",
    "ང་མེ་ཁང་འདིར་ཞག་གཅིག་འདུག་གོ།",
    "རང་ཉིད་འདུག་པའི་ས་ཕྱོགས་གནས་ཁང་དག་པའི་གཞལ་མེད་ཁང་འཇའ་ཟེར་འོད་ཕུང་འཁྲིགས་པའི་ཀློང་དུ།",
    "མཆོད་རྟེན་ལ་ཡང་རང་བཞིན་ལྷུན་གྲུབ་ཀྱི་མཆོད་རྟེན།",
    "དེ་བཞིན་དུ་སྒྲ་པ་དེ་ཉིད་ཀྱིས་བདེ་གཤེགས་མཆོད་རྟེན་བརྒྱད་ལ་བསྟོད་པ་ཞིག་མཛད་འདུག་པར་ཡང་།",
    "རང་རང་ཕྱག་མཚན་མེ་ཏོག་ཆུན་པོ་ལ།",
    "འདུག་སྟངས་ལྷོད་ཅིང་དེས་པའི་ངང་ཚུལ་ཅན།",
    "སྔར་ཁྱེད་ཀྱི་རྒྱལ་པོ་རྣམས་ཀླུས་བསད་འདུག།",
    "ད་ཁྱེད་རང་རྒྱལ་པོར་ཞུའོ་ཟེར་ཏེ།",
    "དེ་ཡང་ད་ལྟ་ང་ལ་ནུས་པ་མེད་རྒྱལ་པོ་འདིའི་སྲས་སུ་གྱུར་ན་ནུས་པ་འདུག་དགོངས་ཏེ།",
    "སྐྱེས་ལན་བཟང་པོ་འདོད་དུ་འོང་སྙམ་པ་ཙ་ན།",
    "སྲོག་ཆགས་མི་འགྲོ་འདུག་སོགས་དང་།",
    "མགྲིན་པ་ལ་ཡང་རང་སོར་བཞི།",
