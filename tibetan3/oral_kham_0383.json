    "ངེད་ཀྱང་འབྲང་འདུག་པ་ལ།",
    "ཁོང་པའི་དཔོན་པོ་དེས་ཀྱང་འདོན་ཀྱིན་འདུག་དེ་ནས་ཡུན་མི་རིང་བར་རྒྱལ་བུ་ཆེན་པོའི་འབུལ་བ་སླེབ་བྱུང་།",
    "སྔ་ནས་ལུང་སྟོན་པའི་སྔགས་པ་ཆེན་པོ་དེའི་གཡས་གཡོན་དུ་རྣལ་འབྱོར་ཆེ་ཆུང་གཉིས་ལྷན་ཅིག་ཏུ་ཁྲི་ལ་བཞུགས་པའི་མདུན་དུ་བདག་ཉིད་ལྟ་ཡིན་འདུག་པ་རབ་ཏུ་གསལ་བར་བྱུང་།",
    "དེ་ཡང་ཁོ་བོའི་འཕྲིན་ལས་བསྒྲུབ་པ་ལ་འགྲོ་འདུག་པ་མྱུར་པོར་ཚུར་སླེབ་འོང་བ་ཡིན་སྙམ་པ་རྨིས།",
    "ལར་མཁའ་འགྲོ་མ་རྣམས་ཀྱིས་འཕྲིན་ལས་ཅི་ནས་ཀྱང་སྒྲུབ་འདུག་པ་ཡིན་སྙམ་པ་བྱུང་ངོ།",
    "ཞེས་གསུངས་པའི་དོན་དུ་འདུག་སྙམ་པ་བྱུང་ངོ།",
    "བསྔོ་འཕྲོ་བཞག་ནས་མགོན་པོ་གསོལ་བཏབ་ཟེར་ནས་དགའ་ཚོར་བྱེད་པ་འདུག་པ་ལ།",
    "དེར་དར་ལ་བབ་པ་ཙམ་དུ་གདའ།",
    "གཅིག་ཉམས་འཕར་ནས་ལུས་ཉམས་སྣ་དགུ་བྱེད་འདུག་རྗེས་སུ་གངས་དཀར་ཆེན་པོའི་རྩ་བ་ནས་བསུ་བ་བྱེད་མི་གྲལ་བསྒྲིགས་ནས་བྲེང་ཆགས་སུ་བྱུང་བ་ལ།",
    "དྲུང་ནས་གཏོར་མ་མཛད་པའི་དུས་ལ་རྣལ་འབྱོར་མ་གཉིས་རྒྱུན་པར་གཡས་གཡོན་བཞེངས་འདུག་ངོ་མཚར་ཆེ་ཟེར།",
    "གཞན་ཡང་དེར་འཚོགས་བང་རི་ཁྲོད་ལ་སོ་སོ་ལ་མཚན་ལྟས་ཁྱད་པར་ཅན་མང་དུ་བྱུང་བར་འདུག་སྐོར་ཅིག་ཨེ་སླེབ་ན།",
    "ཚོགས་གཏོར་བྱས་ཙ་ཅིས་ཀྱང་བཞེས་པ་འདུག་སྙམ་པ་བྱུང་།",
    "ལར་གསོལ་བ་བཏབ་ན་མ་མཁའ་འགྲོ་རྣམས་གང་དུ་བཞུགས་ཀྱང་བསྲུང་སྐྱོབ་ལ་བྱོན་འདུག་སྙམ་ནས་ཚོགས་གཏོར་ཕུལ།",
    "མཛའ་རྒོའི་ཚུར་ངོས་ན་ཡོད་ཟེར་བ་ཤིན་ཏུ་གསལ་བར་རྨིས་པས་གཏོར་མ་ཐེབ་ངེས་པར་འདུག་སྙམ།",
    "ཚོགས་པ་དེ་རྣམས་གཞི་བདག་ཡིན་པར་འདུག་སྙམ།",
    "རྐྱ་པ་དམར་ཆས་བྱས་པ་མང་པོ་མར་རྒྱ་ཡུལ་དུ་འགྲོ་འདུག་པ་རྣམས་ཁོ་བོས་ཡུན་རིང་དུ་བསྐྱལ།",
    "ངེད་ཀྱི་མདུན་དུ་ལངས་ཏེ་ཤིན་ཏུ་དགྱེས་ནས་དབྱངས་འཐེན་ཡིན་འདུག་པ་དང་།",
    "མགོན་པོའི་འཕྲིན་ལས་ད་རུང་ཡང་དཔོན་སློབ་ཀྱི་བསྟན་པ་ས་སྨད་ཁ་ཅིག་ཏུ་དར་བར་འདུག་སྙམ།",
    "རྩ་རུ་ཡོང་འདུག་པའི་ཉམས་སྣང་དང་།",
    "ཅིག་ངུས་ནས་མཆི་མའི་རྗེས་ཅིག་གདའ་ཟེར་ལ།",
    "རྟ་ཤ་མང་པོ་སྤུངས་པའི་དབུས་ན་བདག་ཉིད་འདུག་པ་དང་།",
    "ཡང་འཕྲིན་ལས་བཅོལ་བས་བན་དྷེ་མང་པོས་སྤྲུལ་ཅིག་དེད་ནས་འབྲོས་ཡིན་འདུག་པ་ཅིག་རྨིས་པས།",
    "བྱེད་པའི་སྐབས་སུ་ལུས་པ་སྲོག་ཆགས་འབུ་སྲིན་མང་པོ་ཐོན་པ་ལ་འགྲོ་ཡིན་འདུག་པའི་ཕྱི་རྗེས་སུ་བལྟས་པས་ལམ་དུ་འབུ་ཤི་བའི་རོ་ཀར་བྲེང་ངེ་སྣང་བ་རྨིས།",
    "ས་གསོལ་བ་བཏབ་པས་མི་མ་ཡིན་ཀུན་ཀྱང་གསོལ་བ་ཏི་རི་རི་འདེབས་པ་འདུག་གསུང་པ་དང་།",
    "སྐོར་ཅིག་འགྲོ་དགོས་པ་འདུག་སྙམ་བྱུང་བ་ཡིན།",
    "རྗེས་སུ་བལྟས་པས་གྲུ་ཞིག་ལཁད་པ་འདུག་གོ།",
    "ཁྱེད་ཀྱི་སྲུང་མ་བཟང་པོ་ཡོད་འདུག་ཕྱིན་ཆད་ལོ་དུས་སུ་ཤིང་ཐོག་ཁམ་བུ་འབུལ་བ་ཞུ་ཟེར་ནས་བསུ་སྐྱེལ་བྱས་སོ།",
    "ད་དམ་རྫས་མི་སྐྱེལ་བ་ཅི་ཡིན་ཟེར་ནས་ཁྲོ་འདུག་པ་ལ་གཉིད་སད་པ་སྐྲག་ཅིང་ཡིད་མི་བདེ་བ་བྱུང་ཞིང་རྒྱུག་འོང་བ་ལགས་ཟེར།",
    "དེ་ལ་བར་ཆད་མེད་པའི་བརྡ་འདུག་སྙམ།",
    "དེ་མ་ཐག་གཞན་བྱ་ནག་མང་པོ་འདུས་ནས་དེའི་སྟེང་དུ་སྤུངས་ན་ཐོབ་ཤ་བཀྱེ་འདུག་པ་རྨིས།",
    "མི་གཉིས་ཤི་འདུག་ཟེར།",
    "དྲུང་དུ་འདུག་པ་ནི་ཨེ་མ་ཕོད་གསུངས་ནས་དགྱེས་བཞིན་བཞུགས་ཡོད་པ་རྨིས།",
    "བསྐང་བཤགས་ཀྱང་གལ་ཆེ་བར་འདུག་སྙམ།",
    "འཕྲལ་ཉིད་དུ་བློ་གྲོས་འཕེལ་བར་འདུག་སྙམ་པ་ཡང་བྱུང་ངོ།",
    "དགུ་གཏོར་འདི་དྲག་པོ་ལས་ལ་མྱུར་བར་འདུག་སྙམ་པ་བྱུང་ངོ།",
    "ཕྱི་ན་བར་ཆད་མེད་པའི་ལྟས་སུ་འདུག་སྙམ་པ་བྱུང་ངོ།",
    "གཞན་དོན་གྱི་གྲོགས་ལ་ལུས་དང་གྲིབ་མ་བཞིན་དུ་འབྲང་བ་འདུག་སྙམ་པ་བྱུང་ངོ།",
    "འདམ་པ་ལ་སོགས་པའི་མི་བདེ་བ་ཅིག་ཏུ་འདུག་ཡོད་པ་ལ།",
    "ཨ་ཀ་ཉིན་ཙ་རི་ལ་སྔོན་གྱི་ལས་འདི་ལྟ་བུ་ལ་འདུག་དགོས་པ་བྱུང་སྙམ་ནས།",
    "ཁོ་བོ་བདེ་མཆོག་ལྷ་ཁང་དུ་འདུག་ཡོད་པ་ལ།",
    "འོག་ཚོགས་ཁང་དུ་ཁོ་བོ་ཕྱིན་ནས་འདུག་པའི་ཚེ།",
    "མཁའ་འགྲོ་མ་མང་པོ་རིམ་པ་བཞིན་དུ་བྱུང་ནས་ཁོ་བོའི་མདུན་དུ་བཞུགས་ཡོད་པ་སོགས་ངོ་མཚར་མང་དུ་འདུག་གདའ་ཟེར།",
    "ཅིག་ཀྱང་ཕྱིར་མ་ལོག་པར་ནང་དུ་ཐིམ་པ་བྱུང་ཟེར་བ་འདུག་ཚོགས་གཏོར་རྒྱ་ཆེན་བཤམས་སྤོས་མ་ཕུལ་ནས་སྤྱན་འདྲེན་བྱས་པའི་རྟགས་ཨེ་ཡིན་སྙམ།",
    "ལ་ལས་ཁུར་ཁུར་བ་འདུག་པ་རྨིས་ཟེར།",
    "གདུལ་བྱ་དེ་ཀུན་མི་མ་ཡིན་དུ་འདུག་སྙམ།",
    "ནངས་པར་སློབ་དཔོན་གྱི་དྲུང་པས་ནི་མདང་རྟགས་དངོས་སུ་སྟོན་ཡོད་པ་འདུག་ཅི་ལྟར་བྱས་པ་ལ།",
    "ཡི་དམ་གྱི་སྐུ་གྲིབ་སེལ་བའི་བརྡར་འདུག་དེ་ནས་ཁམས་དྭངས་པར་གྱུར་ཏོ།",
    "བདག་ཉིད་ཁྲི་མཐོན་པོ་ལ་འདུག་པ་རྨིས།",
    "རྒྱ་ནག་པོ་རྡོ་གཅལ་གང་ནས་འབྱོན་ཞུ་བྱེད་པ་འདུག་ཟེར།",
    "ད་ཅིས་གནོད་བྱེད་བན་དྷེ་དེ་རྟའི་སུག་པས་བརྒྱབ་ནས་བསད་འདུག་ཟེར་བ་རྨིས།",
    "ཞག་གཅིག་ཕྱི་ན་མི་འགྲུབ་པར་འདུག་ཟེར།",
    "ཅིག་བཤམས་ཡོད་པའི་སྟེང་དུ་ཁོ་བོ་འདུག་ནས།",
    "ཉེ་གནས་ཁོ་རང་ལ་བྱུང་བ་དང་།",
    "དེ་ལ་གོ་རྒྱུ་གདའ།",
