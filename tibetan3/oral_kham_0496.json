    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "འགྱུར་བའི་སྡུག་བསྔལ་བཞི་ཡི་སྣོད་དུ་གྱུར་ཅིང་རང་ཉིད་ནི།",
    "འགྲོ་འདུག་ཉལ་བ་དང་།",
    "འཐབ་པ་མེད་ན་མི་འོང་དེ་ཙ་ན།",
    "ཚུར་མཐོང་རང་ག་བའི་བསམ་བརྗོད་ལས་འདས་བ་ནི་སྨོས་ཅི་དགོས།",
    "ངེས་འབྱུང་རང་འཁྲུངས་སུ་མངའ།",
    "རྣོ་འཆང་རང་ཉིད་ཀྱི་མྱོང་བ་ལ་སྦྱར་བའི་བདེ་ལམ་གྱི་ཁྲིད་ཉིན་ལྔ་དང་།",
    "དགུང་ལོ་ང་དྲུག་བ་ཤིང་བྱ་ལོའི་ཚོ་འཕྲུལ་ཡར་ངོའི་དགར་བ་དང་བོར་ཉེ་བའི་བུ་སློབ་གྲོགས་ལྡེ་སྣོད་འཛིན་བ་རྣམས་ཀྱི་བཞེད་བ་སྐོང་བ་དང་རང་ཉིད་ཀྱི་བག་ཆགས་ཁྱད་པར་ཅན་ཞོག་ཚུལ་སྟོན་པའི་ཕྱིར།",
    "ས་ཉེས་ཇི་རྔྷི་བྲག་ཅི་འབྱུང་རྒྱུས་ཡོད་རྣམས་ལ་ངེས་ཤེས་ཡང་དག་སྐྱེད་བ་ཞིག་གདའ།",
    "སྒྱུ་ལུས་ཆགས་སྣང་རང་གྲོལ།",
    "སྙིགས་མའི་གྲོགས་ལ་བློ་གཏད་མི་འདུག་ཅེས་གསུངས་པའི་རང་མཚང་སྤྱོད་ངན་ཁྱི་ལུད་ཀྱི་དྲི་བྲོ་བ་རྒྱང་རིང་དུ་དོར་ཏེ།",
    "ཡང་རང་རིག་ཡོད་དེ།",
    "སྣར་གྱི་བས་རྨུགས་ཚེ་དུག་ཞུགས་འདུག་སྙམ་དུ་དྲན་པ་བཞིན་ནོ།",
    "གལ་ཏེ་ཇིར་གྱི་སྒྲ་འཛིན་ལས་ཚུལ་གཞན་གཟུགས་འཛིན་གྱི་ཚུལ་དེ་ཉིད་ཚུལ་གཞན་ཡིན་ཡང་གླི་འཛིན་དང་རང་བཞིན་གཅིག་ཡིན་བས་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "དེ་སྐད་ཅིག་གཉིས་པར་ཞིག་པ་ན་ཡང་རང་བཞིན་གྱིས་འགགས་པའི་ཕྱིར་བདག་གཏན་བད་དུ་འགྱུར་བས་ན་དེ་བདག་མ་ཡིན་ནོ།",
    "ལུས་མ་ཟད་ཚོར་བ་ཡང་རང་བཞིན་གྱིས་གྲུབ་བ་མིད་དི།",
    "ཚོར་བ་མ་ཟད་ཚོར་བ་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་བ་མིན་ཏེ།",
    "འདུ་གྱེད་ཀྱིས་བསྡུས་པ་ཐམས་ཅད་ཀྱི་སྙེ་བ་དང་གནས་པ་དང་འགག་པའང་རང་བཞིན་གྱིས་མ་གྲུབ་པས་ན།",
    "དེ་ལྟར་རང་བཞིན་གྱིས་མི་སྐྱེ་བ་དེ་ཡང་རང་བཞིན་གྱིས་སྐྱ་ངན་ལས་འདས་པ་ཡིན་ལ།",
    "དོན་ཁས་བླངས་པ་ལ་གནས་བ་ཉིད་དུ་འདུག་བས་མིང་མ་སྦྱར་བར་ཟད་དོ།",
    "ཐ་མ་ཚད་ངེས་ཀྱི་སེལ་བྱར་གསུངས་འདུག་ན།",
    "ཁྱབ་ན་རྒྱན་དང་རིགས་རྒྱན་སོགས་ལས་སུང་བོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུའང་མ་ཐུབ་བ་དེ་རང་མྱ་བའི་བདག་རང་བཞིན་གྱིས་མེད་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཏུ་གསུངས་འདུག་བས།",
    "རང་ལུགས་གཉིས་རྐར་ཕུང་བོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུའང་མ་གྲུབ་པའི་རྟགས་ཀྱིས་རང་མྱ་བའི་བདག་མེད་ངེས་སུ་སྒྲུབ་པ་སྦྱོར་བ་ལྟར་སྣང་དུ་གསུངས་པ་དང་།",
    "རྗེ་ཤེར་རྒྱམ་གསན་ཐོར་ལོ་གྱོན་ཆད་འདུག་བས་གནང་མཁན་ཚོས་མཉམ་འཇོག་དགོས།",
    "ལྕང་སྐྱས་ནན་གྱིས་བསྒྲུབས་འདུག་པས་མདུན་བ་ད་ལ་འཁོར་སྔགས་ཀྱང་ཆད་མེད་བྱས།",
    "རྣལ་འབྱོར་རོལ་བར་རྟགས་གྱེད་པར་གསུངས་འདུག་པས་ཉན་ལོག་བྱས་འདྲ།",
    "ལམ་རིམ་མཇུག་དང་ཇིགས་རིམ་སྟོད་དུ་ཕན་ཚུན་མཚམས་སྦྱར་འདུག་བ་བཞིན་གང་ཟག་གཅིག་འཚང་རྒྱ་བའི་ཉམས་ལེན་སྟོན་པའི་གདམས་ངག་ཏུ་གོ་དགོས་བས།",
    "དབེན་སའི་བརྒྱུད་རིམ་མི་དག་པའི་བདེན་ཁ་བུལ་འདུག་འདྲ།",
    "སློབ་དཔོན་གཞན་ཚོའི་ཉེས་ཆ་བཀག་གས་བཀོད་འདུག་པ་ལ་གསུངས།",
    "དཀྱིལ་འཁོར་རྫོགས་པར་མཐོངདུ་མི་རུང་བས་མིག་རས་འཆིང་ཞེས་པའི་རྫོགས་ཀྱི་ནུས་བ་མ་ཐོན་འདུག་དཀྱིལ་ཆོག་ལས་མ་ཁཾ་སོགས་ས་བོན་དང་མིང་ཡིག་ཅི་རིགས་པར་སྦྱར་བ་ཞིབ་ཆ་ཆེ།",
    "ཟང་བར་ཇི་འགྲོའི་བདུད་རྩི་ཐབ་སྐབས་ཁ་ག་ཞུ་བ་ལས་སྒྲུབ་གསུངས་འདུག་བ་འདི་ཕ་རྒྱུད་ལ་ཡང་རུང་ཟེར་དགོས་སམ་དཔྱད།",
    "ལྔ་བ་རང་ནས་གཞན་ཚོར་ཉིན་བཅོ་བརྒྱད་མའི་ལྗགས་བཀོད་མཛད་འདུག་བས་དཀྱིལ་འཁོར་ཐགས་མ་མི་བཞེད་པ་མིན་འདྲ།",
    "ཞེས་ཚིགས་བཅད་གསུམ་སྔགས་བཅས་རྒྱས་ཀུ་རུ་ཀུ་འདི་གསལ་བར་བརྟན་འདུག་དགྲ་ནག་ལེའུ་བཅོ་ལྔ་བར་ཡང་རིགས་བྱེད་མ་ཞལ་བཞི་བ་ཞིག་བསྟན།",
    "འཇམ་རྡོར་གྱི་ཞལ་གསུམ་ཕྱག་དྲུག་བ་དེ་ཀུན་ལ་སྤྱོར་རྒྱུ་བྱས་འདུག་ཀྱེ་རྡོར་ཡིག་སྣའི་རིགས་སོགས་དོག་ཟིན་ལྟར་གསུངས།",
    "བདེ་གསང་ཀྱེ་རྡོར་སོགས་རང་རང་རིགས་གཅིག་པ་རྣམས་ཐགས་ན་ལེགས་པ་ལ་བསམ།",
    "དེས་ན་དོན་འདི་སྐོར་ལ་ཁྱེད་རང་ངེད་ཚོ་བས་རྟོག་དཔྱོད་དང་གོ་ཚོར་བ་ཐུགས་མད་དེ།",
    "ཞེས་གསུངས་པ་འདི་རྗེ་ཡབ་གྲས་ཀྱི་གཞུང་གཞན་དང་སྒྲས་ཟིན་མི་མ་ན་པ་ལྟ་བུར་འདུག་ཅིང་།",
    "ཁྱེད་ཀྱིས་འབྱུ་མས་ཅད་ནས་རྡོག་གཅིག་ཏུ་བསྒྲིལ་བར་མཛད་འདུག་སྟེ།",
    "གཉིས་སྣང་འཁྲུལ་བའི་སེམས་ཁོ་རང་ཤེས་སྒྲིབ་ཏུ་འཇོག་པར་བཞེད་བ་ག་ལ་ཡིན།",
    "རིམ་བ་བཞི་བའི་འོད་གསལ་གྱི་རྗེས་སུ་བྱུང་བའི་རང་བཞིན་བརྒྱད་ཅུའི་རྟོག་པ་དེ་ཤེས་སྒྲིབ་ཡིན་པར་གསུངས་མེ་འདུག་འདི་མི་ལམ་མིན་འདུག་པས་མིག་ལེགས་བར་ཟུ་ལ་ལྟོས་ཤིག་འདི་དག་སྔར་མ་མཐོང་བ་མིན་འདྲ་ཡང་།",
    "ཞེས་དྲངས་འདུག་བས།",
    "སྒྱུགད་རྒྱངས་སུ་ཀུན་བཏུས་ཅ་འགྲེལ་གྱི་ཅག་བདེན་གྱི་མཚན་གཞི་སྟོ་ན་པའི་ཐད་ཇི་ལྟར་བྱུ་འགྲེལ་བའི་ཚུལ་ཁྱེད་ལ་འོལ་སྤྱིའང་ལེགས་པོ་མ་ཤར་འདུག་པ་ལ།",
