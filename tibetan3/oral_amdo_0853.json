    "མ་མོ་ཞེས་བྱ་བ་ནི་ཕག་མོའི་རིགས་ལས་བྱུང་བའོ།",
    "རིགས་ཀྱི་གཙོ་མོ་ཞེས་བྱ་བ་ནི་གཤིན་རྗེ་མའི་རིགས་ལས་བྱུང་བའོ།",
    "རིགས་ཀྱི་ལྷ་མོ་ཞེས་བྱ་བ་ནི་རྨོངས་བྱེད་མའི་རིགས་ལས་བྱུང་བའོ།",
    "བྱིས་བཅས་མོ་ཞེས་བྱ་བ་ནི་སྐྱོང་བྱེད་མའི་རིགས་ལས་བྱུང་བའོ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་བུ་མོ་ཞེས་བྱ་བ་ནི་སྐྲག་བྱེད་མའི་རིགས་ལས་བྱུང་བའོ།",
    "ཞེས་བྱ་བ་ནི་གཏུམ་མོའི་རིགས་ལས་བྱུང་བའོ།",
    "ཙཎྜ་ལཱིའི་ལྐུབུད་མེད་ཅེས་བྱ་བ་ནི་ཡང་གཤིན་རྗེ་མའི་རིགས་སོ།",
    "བུ་མོ་ཆེན་མོ་ཞེས་བྱ་བ་ནི་ཡང་རྨོངས་བྱེད་མའི་རིགས་སོ།",
    "བུ་མོ་ཡང་འདོད་ཅེས་བྱ་བ་ནི་ཡང་སྐྱོད་བྱེད་མའི་རིགས་སོ།",
    "དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་ཡང་གཏུམ་མོའི་རིགས་སོ།",
    "ཏྲི་ཤ་ཀུ་དེ་རྣམས་ཀྱི་བུ་མོ་ནི་ཕག་མོའི་རིགས་སོ།",
    "ཧེ་མ་གི་རི་དང་།་",
    "ཨོ་ཌི་ཡ་ན་རྣམས་ཀྱི་ནི་གཏུ་མོའི་རིགས་ཏེ།",
    "ཡུལ་འདི་རྣམས་ཀྱི་བུ་མོ་གང་ཞེས་བྱ་བ་ནི་ཁྱབ་པ་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་ལ་རབ་ཏུ་གཏུམ་མོ་དང་།",
    "གཏུམ་མིག་མ་ནི་ཕག་མོའི་རིགས་ལས་བྱུང་བའོ།",
    "སྣ་ཆེན་མོ་ནི་རྨོངས་བྱེད་མ་དང་།",
    "གཏུམ་མོའི་རིགས་ལས་བྱུང་བའོ།",
    "འཇིགས་བྱེད་ཆེན་མོ་ནི་རྨོངས་བྱེད་མའི་རིགས་སོ།",
    "ཆང་འཐུང་མ་ནི་ཕག་མོ་དང་གཏུམ་མོའི་རིགས་སོ།",
    "ལྷ་མོ་སྔོ་བསངས་མ་དང་།",
    "ཤིན་ཏུ་བཟང་མོ་ནི་གཏུམ་མོ་དང་རྨོངས་བྱེད་མའི་རིགས་སོ།",
    "དུམ་སྐྱེས་མ་ནི་ཕག་མོ་དང་སྐྲག་བྱེད་མའི་རིགས་སོ།",
    "གཏུམ་མོའི་རིགས་སོ།",
    "ཤིན་ཏུ་དཔའ་མོ་དང་སྟོབས་ཆེན་མ་ནི་གཤིན་རྗེ་མའི་རིགས་སོ།",
    "བརྩོན་ཆེན་མ་ནི་ཕག་མོའི་རིགས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་མཁའ་འགྲོ་ལྔ་ནི་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མ་ལྔའོ།",
    "དེ་དག་འུདེ་ཉིད་ཆེན་མོ་སྟེ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཡེ་ཤེས་ལ་སོགས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ནི་དེ་དག་གིས་ཞི་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་གྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པའི་རྡུལ་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་ལྷའི་རྣལ་འབྱོར་ཅན་གྱིས་ཙནྡན་དམར་པོས་དཀྱིལ་འཁོར་གྲུ་གསུམ་བྱས་ལ་དེའི་དབུས་སུ་འཇིག་རྟེན་སྐྱོང་བ་ལ་སོགས་པ་བལྟ་སྟེ།",
    "ཕྱི་རོལ་གཡས་དང་གཡོན་དུ་བདུད་རྩི་ལྔ་དང་ལྡན་པའི་བཟའ་བ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱིས་བཀང་བའི་གཏོར་མ་གཉིས་བཤམས་ལ་གཏོར་མ་གཡོན་པ་ནི་རང་གི་ལྷའི་ཞལ་དུ་དབུལ་བར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་ཕྱི་ནང་གི་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་མ་རྣམས་བསྒོམས་ཏེ་མཉེས་པར་བྱའོ།",
    "ཙནྡན་གྱི་དཀྱིལ་འཁོར་གྲུ་གསུམ་བྱུགས་པའི་དབུས་སུ་ཟླུམ་པོར་བསྐོར་ལ་དར་ཞུཐིག་བཞིས་རེའུ་མིག་དགུར་བྱའོ།",
    "གཡོན་པ་གླང་པོ་ཆེའི་མགོར་ཐལ་མོ་བཞག་པ་གླང་པོ་ཆེ་ལ་ཞོན་པའོ།",
    "ཟླ་བ་མོ་ལ་སོགས་པ་ནི་ནག་པོ་ཀྱེལྟ་བུའོ།",
    "དྲག་མོ་ལ་སོགས་པ་ནི་འཇིགས་བྱེད་ལྟ་བུའོ།",
    "ཡེ་ཤེས་བེེགས་ཀྱུའི་བྱེ་བྲག་གིས།",
    "དེ་ལྕགས་ཀྱུ་ལྔ་ཞེས་བྱ་བ་གོ་ཀུ་ད་ཧ་ན་ཞེས་བྱ་བ་དང་བཅས་པའི་བདུད་རྩི་ལྔ་སྟེ་དེ་དག་གིས་གཏོར་མའི་སྣོད་བཀང་སྟེ་རྡོ་རྗེ་མཁའ་འགྲོ་དང་རུ་ཏྲ་ནག་པོ་ལ་སོགས་པ་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ལྷ་རྣམས་ཚིམ་པར་བྱ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེའི་གཞུང་གི་ཚོགས་ནི་རིམ་པར་ཕྱེ་བ་སྟེ་བཅོ་བརྒྱད་པའོ།",
    "དབུས་སུ་ཞེས་བྱ་བ་ནི་ནང་གི་དཀྱིལ་འཁོར་རོ།",
    "རི་མོ་མཛེས་པས་བསྐོར་བར་བྱ།",
    "ཞེས་བྱ་བ་ནི་པདྨ་འདབ་མ་བརྒྱད་ཀྱི་ཕྱི་རོལ་དུ་རི་མོ་ཟླུམ་པོར་བསྐོར་བའོ།",
    "ཞེས་བྱ་བ་ལ་མཐེ་བོས་མཇེ་ཆུང་གི་སེན་མོ་མནན་ཏེ།",
    "སོར་མོ་ལྷག་མ་གསུམ་བསྒྲེང་བ་འདི་ནི་བ་དན་གསུམ་པའི་ཕྱག་རྒྱ་ཡིན་ལ་རྡོ་རྗེ་འབར་བ་དང་བཅས་པའོ།",
    "ཞེས་བྱ་བ་ནི་གཤོར་ལྟ་བུའི་ཐོད་པ་ཁྲག་གིས་བཀང་བའོ།",
    "ཡང་ན་ར་ཅ་ནོ་ཞེས་བྱ་བ་ནི་མཚན་མོ་རྒྱུ་བས་ན་ཟླ་བ་ལ་བྱ་ལ་ཟླ་བ་ཕྱེད་པའི་དབྱིབས་ལྟ་བུའི་མཚན་མ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ནུབ་ཏུ་འཇིགས་བྱེད་མ་སྟེ་ས་བོན་ཕྲེ་ལས་བྱུང་ཞིང་ལག་པ་གཉིས་ཀྱི་སྙིམ་པ་ཁྲག་གིས་བཀང་སྟེ་འཐུང་བའོ།",
    "ལྷོར་ནི་ཞིབ་མོའོ།",
    "གཞན་ཡང་འདིར་གང་གི་ས་བོན་མ་བསྟན་པ་དེ་དག་གི་ས་བོན་ནི་རང་གི་མིང་གི་ཡི་གེ་ལ་ཐིག་ལེས་བརྒྱན་པ་ཡིན་པར་བལྟ་སྟེ།",
    "བསམ་གཏན་གྱིས་སོ་སོར་རེ་རེ་ཞིང་རང་རང་གི་ས་བོན་ལས་བསྐྱེད་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྐར་མའི་ཚོགས་དང་བཅས་པའི་གཟའ་རྣམས་རང་རང་གི་མིང་གི་ས་བོན་ལས་བྱུང་བའོ།",
    "ཡང་ན་རང་རང་གི་དམ་ཚིག་ལས་བྱུང་བ་སྟེ།",
    "མ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣལ་འབྱོར་མ་བཞིའི་སྒྲུབ་པའི་ཐབས་ལ་འཇུག་པ་ཡིན་ཏེ།",
