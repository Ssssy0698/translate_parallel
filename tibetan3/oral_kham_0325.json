    "རྒྱབ་ཀྱི་ཡི་གེ་ལྟོས་ཟེར་བས་དོ་བྷ་ཤི་བྱ་བ་ཅིག་ཞིག་འདུག།",
    "གཏོར་མ་ཡེ་མ་འཁྱགས་པར་འདུག་ལྟས་ནི་བཟང་པོར་གོ་སྟེ།",
    "གཡུ་ཕྲན་བཅུ་འདུག་པ་ཐ་མ་ཡང་ཕྱེད་ཕྱེད་སྐུར།",
    "ང་ལ་ནི་གྲོས་ཀྱང་མི་འདྲི་བར་འདུག་སྟེ།",
    "ཁྱེད་ཀྱིས་འཕགས་པ་ལ་བསྟོད་པ་བྱས་པའི་གཤམ་ན་དོན་གསུམ་བར་ཆད་དགྲ་ལས་རྒྱལ་བྱ་བ་གཅིག་བདོག་པར་གདའ་བ་དེ་གསུམ་གང་ལགས་གསུང་།",
    "གསེར་གྱི་འདེགས་དང་ཏོག་འོད་འབར་བ་འདུག།",
    "བོད་ཀྱི་རྒྱལ་ཁམས་ཀྱང་སྐལ་བ་དང་ལྡན་པར་འདུག་སྙམ་ནས།",
    "སྐུ་བྱད་བཟང་ཞིང་མཛེས་པ་ལྷ་ཡིན་ནམ་སྙམ་པ་འདྲ་ཅིག་ཞིག་བཞུགས་འདུག།",
    "སྔར་ནས་འདྲིས་ཆེ་བས་གོ་བཅད་འདུག།",
    "རྒྱལ་བུ་བྱོན་ཁར་བྲམ་ཟེ་རྒས་ཟེར་བའི་དཔེ་བྱུང་ད་ནི་ང་འཆི་བར་འདུག་པས་ལོང་མེད།",
    "དེ་ཁོ་ན་བཞིན་བྱས་པས་ཕྱིས་བརྟག་ཅིང་དཔྱད་པས་ཤིན་ཏུ་དྲིན་ཆེ་བར་བྱུང་འདུག་པས་གོ་བཅད་པ་ཡིན་ནོ།",
    "སྟོན་གྱི་སྐར་མའི་ནང་ན་ཟླ་བ་རྒྱས་པ་བཞིན་བཞུགས་འདུག།",
    "ཇོ་བོ་ཁར་ས་པ་ཎ་ཤིང་སྐུའི་ཐུགས་ཀ་ན་བཞུགས་འདུག།",
    "བོད་དུ་བྱོན་པར་འདྲ་འདྲ་ནས་ད་ཕྱིར་ལ་གཤེགས་ན་བདག་རྗེས་མེད་ཕྱིར་ལ་སྟོང་ལོག་བྱེད་པར་འགྲོ་བར་འདུག།",
    "འཕྱོངས་མཆོངས་ཟིན་གྱི་རྗེས་སུ་ལག་ནས་ཟིན་པས་གྲུབ་ཐོབ་མ་ནོར་བ་དང་མཇལ་འདུག་སྙམ་ནས་ངོ་མཚར་སྐྱེས།",
    "དེ་ཡིན་ན་ཐུགས་རྗེ་ཆེན་པོ་དངོས་ཡིན་པར་འདུག་སྟེ་མི་སྲིད།",
    "རྗེ་བཙུན་གྱི་འཕྲང་མི་བདེ་བ་ཀུན་སྒྲོལ་ནས་མགུལ་པ་ཆད་ཆད་བཞད་ཅིང་འདུག་གོ།",
    "རྣལ་འབྱོར་པ་དེ་ཁྲོ་ཕུ་བའི་ཇོ་སྲས་ཀྱིས་སྤྱན་དྲངས་པར་གདའ་བས།",
    "ཅིར་སྣང་རང་སོར་བཞག་ན་བྱ་བྲལ་ལྷུན་གྱིས་འགྲུབ།",
    "བུ་རམ་མངར་བར་ཤེས་ཀྱང་རོ་མ་མྱོང་ན་དོན་མི་འདུག་གསུང་ངོ།",
    "བགྱི་བ་དེ་མད་པར་གདའ་ཨང་ཞུས་པས།",
    "དམ་པའི་སྤྲུལ་པར་འདུག་ཅེས་ཀྱང་ཟེར་རོ།",
    "ཇོ་གཤེན་བྱ་བ་དང་གསུམ་ཁོ་བོ་དང་བཞིས་ཡིད་གཏད་པས་བཞི་ཀ་འཐུན་མཐུན་པར་ཟམ་པ་ལ་གཤེགས་པ་མ་མཐོང་པར་ཕ་ཀར་རྟ་ཁྲིད་པ་མེད་པར་བྱོན་འདུག།",
    "བདག་ཀྱང་རང་ཉིད་ཉེས་པས་མཐུ་མེད་ན།",
    "སྐུ་མཚམས་ཤིན་ཏུ་དམ་པར་བཅད་ཀྱང་ལོ་ཙཱ་བ་དངོས་སུ་འདུག་པར་གསན་ནས་མཚམས་ཧག་རྡོལ་དུ་མཛད་དེ་བང་རྒྱུགས་ནས་ཕྱག་འཐེན་མཛད།",
    "གལ་ཏེ་གནང་བར་འདུག་ན་བསྡད་སྙམ་ནས་ཞུས་པས་ཤིན་ཏུ་ཡང་བགྱིད།",
    "ཉི་མ་ནུབ་ཕྱོགས་ནས་ཤར་བྱུང་ཡང་དོན་འདི་འགྲུབ་པ་ཡིན་གྱིས་རྒྱ་རྒན་ཁོ་ཁས་ལེན་ཅིང་འདུག་གྱིས་གཅིག་གསུང་གསུངས།",
    "འདི་འདྲའི་མཐའ་ནས་ཕར་ཡུལ་དུ་ལྡོག་དུས་ཕལ་ཆེར་མི་འོང་སྙམ་པ་ཡང་བྱུང་།",
    "གནས་པོས་བླ་ཚེ་བརྐུས་པ་ལསྩོགས་པའི་བར་ཆོད་མང་པོ་འདུག་གོ།",
    "བྲུན་ཤོར་པའི་རྗེས་དུ་མ་འདུག་གོ།",
    "ཐང་ཀ་ལ་ནགས་ཐིབ་པ་འདུག།",
    "མཆོད་རྟེན་གཅིག་འདུག་པ་བྲང་ཁང་དུ་སྤྱན་དྲངས་ཏེ་ཕྱག་མཆོད་བྱས་ནས་བར་ཆད་མེད་པར་གསོལ་བ་བཏབ།",
    "འདིར་འོང་པས་ཅི་ཡང་མི་འདུག་སྟེ།",
    "ཕྱིས་དུས་ཚོད་རྩིས་པས་ལོ་ཙཱ་བས་དེ་ཀའི་སྔ་ཉིན་ཡུལ་ནས་བཏེགས་སྟེ་སྤྱན་འདྲེན་དུ་ཆས་པར་འདུག་གོ།",
    "དེ་ག་འདིར་འདུག་གོ་བསོ་ཐོ་ལེ།",
    "ཤ་ཁ་ར་ཕུལ་གང་བསྐུར་འདུག།",
    "དགེ་སློང་བསོད་སྙོམས་པ་ཤཱཀྱའི་དཔལ་བཟང་པོས་ཁྲོ་ཕུ་ལོ་ཙཱ་པ་ལ་ཐུགས་དགྱེས་པའི་སྒོ་ནས་ཤིས་པ་བརྗོད་པའོ་། ཞེས་བྱ་བ་འདུག་གོ།",
    "བྱམས་པའི་རྟེན་ཆེན་པོ་བཞེངས་མཁན་དེ་ཁྱེད་ཀྱི་ཁུ་བོའམ་མེས་པོ་ཞིག་ཡིན་ནམ་ཁྱེད་རང་ཡིན་གསུང་གསུངས།",
    "འདི་ནི་བཙུན་ཆུང་ལྟ་བུ་གཅིག་འདུག་པས།",
    "འགྲོ་གསུང་པའི་ཐོག་ལ་མ་ཆུད་ན་ནི་རྒྱ་གར་པ་ཟ་འདོད་པ་མང་པོས་ཐུགས་ནུར་བ་ལ་ཚེགས་མི་འདུག་པས་བློ་མ་བདེ་བ་ལས།",
    "འདིར་ལྡེབ་ངོས་གཉིས་ཙམ་བྲིས་མ་གཞན་ཞིག་ལ་འདུག་པ་འདིར་བཅུད་པ་ཡིན།",
    "ཤིན་ཏུ་རིང་དུ་སྦྱངས་པའི་ལས་ཅན་དུ་འདུག་པས་མ་ཧཱ་ལོ་ཙཱ་བ་ཞེས་བརྗོད་ཅིག་གསུང་།",
    "བི་ཀྲ་མ་ཤི་ལའི་བྱི་དོར་བྱེད་མཁན་དང་དུས་མཚུངས་སུ་འདུག་གསུང་།",
    "རྒྱལ་པོ་ཁོང་རང་ཡང་ཀ་ཅས་ཡིད་ཀ་ཆད་ཞེད་པ་ལས་མི་འོང་།",
    "གཅིག་དག་པར་བྱེད་པར་འདུག་གོ་གསུང་སྐད།",
    "དེའི་ཚེ་སིང་གྷ་གླིང་ནས་དགྲ་བཅོམ་པས་བསྐུར་པའི་ཟ་མ་ཏོག་དེ་ཁ་ཕྱེ་བས་རིང་སྲེལ་གཅིག་ལ་ལྔར་འཕེལ་འདུག་གསུང་གསུངས་ནས།",
    "སྐོགས་པ་འདི་ཀུན་ཡང་འཚོལ་དགོས་ན་ཡེ་མི་རྙེད་པར་འདུག་པས་གཉེར་གྱིས་གསུང་།",
    "ཕྱིའི་རྒྱ་མཚོ་ནས་ནོར་བུ་ལོན་ན་རྫོངས་ཚར་རམ་གཞན་དུ་དཀའ་བར་འདུག་གསུང་།",
    "མཉམ་བཞག་དུས་གཅིག་ཐོ་རངས་རྔ་བརྡུངས་ཚེ།",
    "བེཌཱུརྱའི་ཡི་གེ་ཏཾ་གསུམ་འདུག་པ་གནང་ནས།",
    "མཉམ་བཞག་དུས་གཅིག་ཐོ་རངས་རྔ་བརྡུངས་ཚེ།",
    "ཕྱིར་བྱོན་པ་དེ་ཁོ་ན་ཉིད་ན་བཞུགས་འདུག།"
  ]
}