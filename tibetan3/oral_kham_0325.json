    "དོན་དུ་མི་འགྱུར་བ་ཡིན་པ་གདའ།",
    "དེ་མིན་ནའང་རང་ཉིད་ཀྱི་རྒྱུད་ལ་ལམ་རྣམ་པར་དག་པའི་བག་ཞག་ཤིན་ཏུ་བརྟན་པ་ཞིག་ལུང་རིགས་ཀྱིས་ཕུ་ཐག་ལེགས་པར་བཅད་པའི་ངེས་ཤེས་གཏིང་ཐུག་པ་ནས་སྐྱེ་བ་ཞིག་བཞག་པ་ནི་གདོན་མི་ཟ་བར་འདུག་པས་ཅིས་ཀྱང་མཇལ་བའི་ཐབས་ཤིག་མཛད་པར་ཞུ།",
    "དེ་སྐྱེ་བའི་སྣོད་དུ་རུང་བའི་ཡོན་ཏན་རྣམས་སྐྱེས་པའང་དཀའ་བའི་རིགས་སུ་ཡོད་ཚོད་དུ་འདུག།",
    "རང་གཞན་ཐམས་ཅད་བསླུས་ནས་ལྟུང་ཉེན་གདའོ།",
    "སྡོམ་གསུམ་རབ་དབྱེ་སོགས་སུ་ཡང་མང་དག་གསུངས་འདུག་པ་དང་།",
    "གཞན་ཡང་རྒྱ་བོད་གཉིས་ཅར་དུ་ལྟ་སྒོམ་སྤྱོད་གསུམ་ལ་ནོར་བ་མཐའ་ཡས་ཤིག་འདུག་ཅིང་།",
    "སྤྱིར་རྒྱལ་བས་གསུངས་པའི་གདམས་ངག་རྣམས་ལྟ་སྒོམ་སྤྱོད་གསུམ་དུ་མ་འདུས་པ་མེད་པས་ན་ཉམས་ལེན་པ་རྣམས་ཀྱང་ནོར་མ་ནོར་ཐུགས་རྟོག་འཇུག་ན་འདི་གསུམ་ལ་འཇུག་རྒྱུར་འདུག་ནས།",
    "ཡང་མཉམ་པར་བཞག་དུས་བྱིང་བ་ཕྲ་རགས་སྐྱེ་ཚུལ་ཇི་ལྟར་འོང་།",
    "ཡང་བདེ་གསལ་མི་རྟོག་པ་སྒོམ་གྱི་ཡང་རྩེ་ཡིན་ཟེར་བ་ཞིག་ཡང་འདུག་པ།",
    "མ་ཡིན་ན་རྒྱ་གར་མཁས་པ་རྣམས་ཀྱིས་སྒོམ་དུ་གསུངས་འདུག་པ་དེ་ནོར་རམ།",
    "སེམས་ཁོ་རང་གང་དུ་ཡང་འཕྲོ་མི་འཇུག་པར་ཙེན་ནེ་འཇོག་པས་ན་འཇོག་སྒོམ་ཟེར་བ་ཡིན་སྙམ་ན་ནི།",
    "དེང་ནི་དགེ་པ་ཀུན་ལ་ཡོན་ཏན་དུ་ལྟ་བས་སོ་སྙམ་ན་དེ་ནི་ལྟ་སྒོམ་ལ་ཁྱད་མི་འདུག་ཅེས་སྨྲས་པའི་ལན་དུ་སྤྱོད་པ་ལ་ཁྱད་ཡོད་དོ་ཞེས་སྨྲ་བ་ཡིན་ཏེ་དེ་ནི།",
    "མི་མཐུན་པ་དེ་ནི་ཁྱི་ལ་སེང་གེ་ཡིན་ཞེས་པ་དང་ཁྱད་པར་ཅི་འདུག་མཐུན་ན་ནི་ཀླུ་སྒྲུབ་ཀྱི་ལྟ་སྒོམ་ལ་ན་དེའི་གོལ་ས་རྟག་ཆད་དུ་མ་ཤོར་བ་ཤིག་དགོས་པ་ཡོད་པས།",
    "དེ་ལྟ་ན་རྐྱག་གཏད་མི་འདུག་པས་རི་ཕུག་ཏུ་ཞེན་ལས་མ་བཞུགས་པར་ཅི་དྲན་ལག་ལ་བླངས་བས་ཆོག་པ་གདའ་བ།",
    "གང་ལ་ཡང་མི་ལྟ་བ་དེ་ཀ་ལྟ་བའི་མཆོག་ཏུ་རྒྱལ་བས་གསུངས་འདུག་པ་ཅི་ཡིན་སྙམ་ན།",
    "སྦྱིན་པའི་ངོ་བོ་གསུམ་ལ་རྣམ་རྟོག་ཞུགས་ན་ནི་དམིགས་བཅས་ཀྱི་སྦྱིན་པར་འགྲོ་བར་འདུག་ལ།",
    "གཞན་ཡང་འགའ་ཞིག་སེམས་འདི་ཁ་དོག་དང་ད་དབྱིབས་གང་དུ་གྲུབ་འདུག་ལེགས་པར་བལྟས་པའི་ཚེ།",
    "དེ་གཉིས་གང་དུ་ཡང་མ་གྲུབ་པར་མཐོང་བ་དེ་ཀ་སེམས་མཐོང་བ་ཡིན་སྙམ་པ་འདུག་སྟེ།",
    "དེ་ལྟ་ན་རྭ་རྣོལ་རིང་བ་དེ་བོང་བུའི་མགོ་ལ་གྲུབ་བམ་རྟའི་མགོ་ལ་གྲུབ་འདུག་ལེགས་པར་བལྟས་པའི་ཚེ།",
    "ཡང་འགའ་ཞིག་སེམས་འདི་ཁ་དོག་དུ་འདུག་གམ་དབྱབས་སུ་འདུག་བལྟས་ནས་དེ་གཉིས་གང་དུ་ཡང་མ་མཐོང་བའི་ཆ་སེམས་མ་གྲུབ་པོ་ཞེས་དོ་སྤྲོད་པ་འདུག་སྟེ།",
    "དེ་ལྟ་ན་ཁྱི་འདི་སེང་གེར་འདུག་གམ་ཝར་འདུག་ལེགས་པར་བལྟས་པས་དེ་གཉིས་གང་དུ་ཡང་མ་མཐོང་བའི་ཚེ་ཁྱི་མ་གྲུབ་པ་ཡིན་ཞེས་སྨྲ་ནུས་སམ།",
    "ཡང་འགའ་ཞིག་སེམས་འདི་དེ་ལྟར་བལྟས་པའི་ཚེ་ཁ་དོག་དང་དབྱིབས་གང་དུ་ཡང་མ་མཐོང་བ་དེ་སེམས་ཀྱི་གནས་ལུགས་སམ་ངོ་བོ་མཐོང་བ་ཡིན་ཞེས་ངོ་སྤྲོད་པ་འདུག་སྟེ།",
    "དེ་ལྟ་ན་ཁྱི་དེ་སེང་གེ་དང་ཝར་ཨེ་འདུག་བལྟས་པའི་ཚེ།",
    "ཡང་འགའ་ཞིག་འདི་སྙམ་དུ་སེམས་པ་ཡང་འདུག་སྟེ།",
    "འགའ་ཞིག་ནི་རྟོག་པ་ཡིན་ཕྱིན་ཆད་བཟང་ངན་གང་འདུག་དགག་རྒྱུ་ཡིན་ཟེར་བའི་ཚན་པ་གཅིག་དང་།",
    "སྟོང་པ་ལ་ཡང་རང་སྟོང་དང་གཞན་སྟོང་གཉིས་ཡོད་པའི་ནང་ནས་ཟླ་གྲགས་དང་སེང་བཟང་འདོད་པའི་རང་སྟོང་དན་པ་དེ་མིན་གྱི།",
    "གསུངས་ན་ལྟ་བ་ལ་ཁྱད་འོང་རྒྱུར་འདུག་གམ་མི་འདུག་ཁྱད་པར་དུ་སེམས་འདི་དང་སེམས་ཀྱི་གནས་ལུགས་ལ་ཁྱད་པར་ཨེ་འདུག།",
    "གནས་ལུགས་སྟོང་པ་ཉིད་ཀྱང་འཚོལ་ལུགས་གང་འདྲ་ཅིག་བྱེད་དགོས་པར་འདུག་རྣམས།",
    "ཉམས་ལེན་ལ་རྩེ་གཅིག་ཏུ་གཞོལ་འདོད་ཁ་ཅིག་ནི་ཐོས་བསམ་ལ་གེགས་སུ་འཛིན་པར་འདུག།",
    "ད་དུང་རྒྱུད་མ་ཐུལ་འདུག་ཟེར་བ་ཡང་སྣང་ཞིང་།",
    "དེ་བས་ཀྱང་ཆེ་བའི་དགག་བྱ་ཅིག་འདུག་ནས་ཡང་སྐྱོན་ཅན་དེ་རྣམས་ལ་དེ་ཙམ་གྱིས་ཕུན་སུམ་ཚོགས་ཟེར་བའི་ཁ་ན་མེད་ཀྱི་བཏང་སྙོམས་སུ་བཞག་རྒྱུ་ཡིན་ནོ།",
    "ཡང་རང་ཉིད་སྔན་ཆད་འདི་རྣམས་ལ་རྣམ་དཔྱོད་མ་ཞུགས་ཤིང་།",
    "དགོས་པ་སྔ་མ་དེ་རྣམས་ཀྱིས་སེལ་ནུས་པར་འདུག་ནས།",
    "འདུག་པ་དང་།",
    "དེ་ལྟར་བདག་ཉིད་ཆེན་པོ་དེ་ལུས་བཙོང་བའི་ཕྱིར་གྲོང་བར་དུ་འདུག་ནས།",
    "ཀྱེ་མ་བདག་ནི་སྐལ་བ་དམན་པ་ཞིག་གོ་སྙམ་དུ་སེམས་ཤིང་མཆི་མ་བླགས་ནས་འདུག་གོ།",
    "བྲམ་ཟེའི་ཁྱེའུ་ཆ་བྱད་དུ་སྤྲུལ་ནས་དེའི་མདུན་དུ་འདུག་སྟེ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "མིག་ཨུཏཔལ་སྔོན་པོ་ལྟ་བུ་སྐྲ་མཐོན་མཐིང་དུ་འདུག་ཅིང་ནུ་མ་རབ་ཏུ་རྒྱས་པ།",
    "དེ་ད་ལྟ་གང་ན་འདུག།",
    "ཕྱོགས་འདིར་རང་རང་མགུལ་པ་བྲེགས་པ་བཞིན།",
    "ད་ནི་བདག་ཐེལ་རང་དུ་བསྡད་པས་ཆོག་པར་འདུག་སྙམ་པར་བྱུང་སྟེ།",
    "དགུང་ལོ་བཅུ་གསུམ་པའི་ཚེ་བདེ་མཆོག་ལྷན་སྐྱེས་ཀྱི་སྒོམ་བཟླས་ལ་བཞུགས་པའི་དུས་གཅིག་ན་བསྐྱེད་བཟླས་ལའང་མུན་ཁང་བྱས་ན་དགའ་རིགས་སུ་འདུག་གསུང་ནས་མུན་ཁང་དུ་ཐུགས་དམ་མཛད་པའི་སྔ་དྲོ་ཞིག་ལྷའི་ཏིང་ངེ་འཛིན་བརྟན་པའི་ཚེ།",
