    "ཁྱེད་རང་གཡས་གཡོན་གྱི་མཛེས་སྡུག་ལ་མི་ཆགས་པར།",
    "ཁྱེད་རང་གཡས་གཡོན་གྱི་མཛེས་སྡུག་ལ་མི་ཆགས་པར།",
    "ང་རང་གཡང་རོང་དང་བྲག་གཟར་ལ་མཆོངས་པར་སྤོབས།",
    "ཁྱེད་རང་གང་དུ་བཞུགས།",
    "ཁྱེད་རང་མྱུར་དུ་ཕེབས་རོགས།",
    "ཁྱེད་རང་ཐོབ་འདོད་ཀྱི་སྐོམ་པས།",
    "ནམ་ཟླ་འཁྱག་པོར་འགྱུར་བཞིན་འདུགབདག་སེམས་ཀྱི་གཙང་ངོགས་སུ།",
    "ང་རང་ཁུ་སིམ་སིམ་གྱི་རང་ཉིད་དང་བསྡོངས་ནས་ཁུ་སིམ་སིམ་ངང་བསྡད་ཡོད།",
    "ཁྱེད་རང་གངས་རིའི་ཁ་གཏད་དུ་ལངས་ནས་མིག་ཆུ་བཞུར་ཀྱང་།",
    "ང་ཅིས་ཀྱང་རྨི་ལམ་གྱི་བདེ་བར་རོལ་ཐབས་མི་འདུགསང་ཞོགས་ཀྱི་ཉི་འོད་རྣོན་པོས།",
    "ང་རང་འདི་ལྟར་གཉིད་པ་ནི་ཚེ་གང་ལ་གཉིད་པ་མ་ཡིན་ནམ།",
    "ང་རང་ནམ་ཡང་སད་སད་ལ་སྡོད་དགོས།",
    "བདག་ལ་གུ་ཡངས་གཏོང་ཐབས་མི་འདུགབདག་ད་ལྟ་མྱུར་དུ་རྨོ་འདེབས་ལ་ཞུགས་དགོས།",
    "བདག་ཡོད་པས་ཁྱེད་རང་ནམ་ཡང་གྲོགས་མེད་ཁེར་རྐྱང་ག་ལ་ཡིན།",
    "སྨག་རུམ་གྱིས་ང་རང་མནན་ཏེ།",
    "ཙ་ནྡན་དྲི།",
    "སྤྲིན་ལྟ་བུའི་ན་བཟའ་མན་གདའ།",
    "རང་བཞིན་མེད་པའི་གསུང་རང་བཞིན་གྱིས་སྒྱུ་མ་ལྟར་མ་འགག་པར་སྣང་བ་ཞེས་བྱ་བ་ནི།",
    "རང་བཞིན་མེད་པའི་གསུང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དངོས་པོ་མེད་པ་ནི།",
    "ཚོར་བའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "འདུ་ཤེས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "འདུ་བྱེད་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "རྣམ་པར་ཤེས་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སྣའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ལྕེའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ལུས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ཡིད་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "གཟུགས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "དྲིའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "རོའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "བོན་གྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སའི་ཁམས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ཆུའི་ཁམས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "མེའི་ཁམས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ནམ་མཁའི་ཁམས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "མ་རིག་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "འདུ་བྱེད་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "རྣམ་པར་ཤེས་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "མིང་དང་གཟུགས་ཀྱི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ཚོར་བའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སྲེད་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "ལེན་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སྲིད་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སྐྱེ་བའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པའི་ངོ་བོ་འདི་ཞེས་བྱ་བའི་བོན་ཉིད་ཅིར་ཡང་རང་བཞིན་གྱིས་བྱས་པ་ཡང་མེད།"
