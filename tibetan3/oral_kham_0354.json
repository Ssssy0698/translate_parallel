    "རྣམ་སྣང་ཡབ་ཡུམ་དབུས་མའི་མདུན་དུ་འདུག་ནས།",
    "འདིའི་ལུས་དཀྱིལ་གྱི་ལྷ་རྣམས་ཞུ་བ་འདྲ་ཞིག་འདུག་ཀྱང་མ་ཞུ་བར་བཞུགས་ནས་སྦྱོར་པསགསང་བསྐྱེདབསྐྱེདཆུང་པའི་སྐབས་ཕྱི་དཀྱིལ་གྱི་ལྷ་རྣམས་ལུས་ལ་སྤྱད་པའི་དུསསུ་ཞུབ་ཡིན་གསུང་ངོ།",
    "སྟན་བདེ་བ་ལ་ཁ་བསྐུ་མདུན་དུ་བཤམསཡལྷོར་ཕྱོགས་ཏེ་འདུག་པའམ་འདུག་པར་མས་ནས།",
    "དེའི་འོག་ཏུ་མཆོད་། ཡུལ་སོགས་གཟུང་བ་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དེ་བཞིན་དུ་འཛིན་པ་པོ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་བའི་བདག་ཉིད་དེ་འོ་སྙམ་པའི་སྔགས་དོན་དྲན་བཞིན་པའིཨོཾ་སུ་བྷ་ཝས་ཞེས་སོགས་བརྗོད་དེ་ཁམས་གསུམ་སྣོད་བཅུད་ཐམས་ཅད་རང་བཞིན་གྱིས་གྲུབ་པས་སྟོང་བཞིན་དུ་སྣང་མ་དོར་བའི་བདེན་སྟོང་སྒྱུ་མ་ལྟ་བུརབསྒོམ།",
    "སྐྱེ་དང་འཇིག་དང་རང་བྱུང་བ།",
    "ཟིན་བྲིས་རྙིང་པ་རྒྱས་བསྡུས་གཉིས་འདུག་པའི་བསྡུས་པ་ལམ་དག་པ་དང་མ་ཚང་བ་རྣམས་བཅོས།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "ཡང་ཆོགའི་ཚིག་ལ་བརྟག་དུསའདི་ནས་བཟུངསྟེ་སང་ཉི་མ་མ་ཤར་བར་བསྙེན་གནས་ཡན་ལག་བརྒྱད་པའསློབ་དཔོན་གྱིས་གཟུང་དུ་གསོལ།",
    "ཚིག་སྤྱི་ཙམ་མིན་པར་མཁས་པ་བསྟེན་ནས་སྦྱོང་དགོས་པར་འདུག་སྙམ་དུ་སེམས་པ་རྒྱུན་མ་ཆད་པ་བྱུང་བས་རྒྱུ་བྱས་ཏེ།",
    "འཕན་ཡུལ་གྲབ་ཀྱི་ཕུར་སྒྲུབ་ཕུག་རྙིང་པ་ཆུ་ཤིང་སོགས་འཛོམ་པ་ཞིག་འདུག་པ་དེར་ཕེབས།",
    "རྫོབའི་སྤྱིལ་ཆུང་རང་ཤོང་ཁང་བུ་རུ།",
    "སེམས་ལ་འཆར་སྒོ་ཇི་ལྟར་འདུག།",
    "དུས་རྒྱུན་འདུག་གནས་གང་ཡིན་སོགས་ཀྱི་དྲིབ་མཛད་པར།",
    "དེ་ནས་བཟུངསྟག་རྩེར་འདིར་ལེགས་པོ་མི་འོང་བ་འདུག་གསུང་།",
    "ངེད་རྣམས་ཀྱིས་སྤྲུལ་པའི་སྐུ་ལ་ཞལ་ཏ་ཞུ་འདོད་ཀྱང་ཞུ་མི་ཤེས་པ་འདུག།",
    "ད་དྲ་རྒས་པས་ལ་རྗེས་མ་ནས་དཔོན་པོའི་ཞབས་ཕྱིར་འགྱུར་བ་ཞིག་མི་འོང་བ་འདུག་པས།",
    "ཁྱེད་རངམཆོད་ཡོན་གྱི་བར་དུ་ཕྲ་མ་མི་ཚུད་པ་མཛོད་ཚང་མང་པོ་མ་བཞེས།",
    "སྐྱ་མིན་སེར་མིན་གྱིས་ལུང་པ་གང་འགྲོ་བ་འདུག་ཐེམ་ནས།",
    "ངེད་ངེད་ཀྱི་རྣ་བ་ལ་གོ་དགོས་པ་དེ་མི་གོ་མི་འདུག་ཐམས་ཅད་ཀྱིས་ངོ་འཛིན་བྱེད་པ་ལས་དེ་འདྲ་ཞུ་མཁན་མི་འོང་བ་འདུག།",
    "གསུང་གླེང་སྔ་ཕྱི་འདི་རྣམས་ལ་སྒྲོ་སྐུར་འདུག་གམ་མི་འདུག།",
    "ང་རང་གང་འདོད་བྱེད་རྒྱུམ་འོང་བ་འདི་འདྲ་གསུང་དབུ་ཕུར་ཕུར་མཛད་པ་ལེས་ཞལ་བཞེས་བཟང་བ་མ་བྱུང་།",
    "དཔོན་པོ་ཡབ་སྲས་དང་ཁྱེད་རང་ཟླ་བ་རྣམས་དྲུང་།",
    "ཁྱེད་རང་རྣམས་མགྱོགས་ཙམ་ཟོ་ལ།",
    "ཐུགས་དམ་ལ་དད་པ་འདྲེན་པ་མཛད་ནས་བཞུགས་འདུག།",
    "འདུག་ས་འདི་ཉིད་དུ་དྲུང་དུ་གསལ།",
    "རྗེ་བཙུན་གྱི་ཐུགས་དང་རང་སམས་དབྱེར་མེད་དུ་འདྲེས་པ་ལ་དར་ཅག་མཉམ་པར་བཞག།",
    "མཐའ་དག་དུས་འོག་གནས་སུ་བྱེར་གྱུར་ཅིག།",
    "རང་རང་ལྕགས་ནས་འབྱེད་པ་སྟེ།",
    "རང་རང་སྐྱེས་སྨེ་དབུས་བཟུང་ནས།",
    "དེ་བཞིན་ལོ་ཟླ་ཞག་དུས་བཞིའི།",
    "སླེབ་ཚེ་ལོ་ཡིན་ཟླ་ཞག་དུས།",
    "དེ་ཡང་རང་སོར་རྣམ་པ་ལྔ།",
    "ཞེས་སོགས་གསུངས་འདུག་པ་ལྟར་རྗེ་ཉིད་ཀྱི་འཕྲིན་ཡིག་ཁག་ལ་ཞིབ་ཏུ་མཇལ་ན་སྐབས་དེའི་གནས་ཚུལ་ཟོ་ཟུར་ནས་རགས་ཙམ་ངེས་ཐུབ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ།",
    "རབ་བྱུང་བཅུ་གཉིས་པའི་ཆུ་ཁྱི་ལོ་སྟེ་སྤྱི་ལོ་༡༧༤༢ ལོར་རྗེ་ཉིད་ཀྱི་ཙ་ན།",
    "སྔར་དེ་དག་༡་ནས་བ་ན་ས་ནམ་འཡཡལ་བྱ་༤ ས་ཁྲག་འབབ་པའི་ཚོད་དུ་འདུག་པའི་ངང་ཚུལ་དེ་གླེང་མི་འདོད་ཀྱང་།",
    "སྐབས་དེར་ཟི་ལིང་མཁར་དུ་ཧུའུ་ཁི་ཞེས་པའི་ཡི་གེ་མེད་ན་མི་སུ་ཡིན་ཡང་འདུག་ཏུ་མི་འཇུག་པས།",
    "འོ་ན་ང་རང་མཚོ་སྔོན་པོར་འགྲོ་དགོས།",
    "ཁོང་ལོ་བརྒྱད་ཅུ་བར་ངེས་པར་འདུག་ངེས།",
    "ང་རང་ལུགས་རྙིང་བདུན་པའི་ཉི་ཤུ་དགུ་ལ་སྨད་ཕྱོགས་སུ་བསྐྱོད་དགོས།",
    "བཀའ་འ་༣ ན་ས་ག་ཙ་ནའ་ན།",
    "ང་རང་ཟླ་༥ བའི་དཀྱིལ་ལ་བྱ་ཁྱུང་ལ་ཡོང་རྩིས་ཡིན།",
    "ཡོན་བདག་ང་རང་ཁོ་ན་ཡིན།",
    "རྒྱ་ལོ་ཉི་ཤུ་ནས་ངེད་དུས་འཁོར་གྱི་བསྙེན་པ་འདུག་རྩིས།",
    "ལོ་སྨད་ང་རང་ཟི་ལིང་ངམ་རང་དགོན་ཅི་རིགས་པར་འདུག་རྩིས།",
    "ང་རང་སེམས་བདེ།",
    "འཚོ་བ་འདུག་ས་སོགས་ཤིན་ཏུ་ལེགས།",
    "ཁ་ཏ་རྒྱས་པ་ངོ་ཐུག་དུས་བཤད།",
    "གཞན་ཡང་རང་གཞན་གྱི་ལུས་ལོངས་སྤྱོད་དུས་གསུམ་བསགས་པའི་དགེ་ཚོགས་དང་བཅས་པ་ཕངས་པ་མེད་པར་ཕུལ་བ་ལགས་ན།",
    "དང་པོ་ཡང་སྤྱིར་འཇིག་རྟེན་ན་མི་གྲངས་ཧ་ཅང་མང་ནའང་རང་ཉིད་ལ་ལུས་རྟེན་གཅིག་པོ་འདི་མ་གཏོགས་མེད་པས།",
    "སྐྱེས་ཡོད་ཕྱིན་འཆི་ཁར་ལུས་ལ་བཏབ་པའི་རྟགས་དེ་ཇི་མ་ཇི་བཞིན་བྱིས་པའི་ལུས་སྟེང་ན་ཤར་འདུག་པ་དེ་མངོན་སུམ་དུ་མཐོང་རྒྱུ་ཡོད་པ་ཡིན།",
    "འདི་བབ་འ་་ཅན་བཞི་ངསབན་ལྟར་ལོས་ཡིན།",
    "རང་རང་གང་དུ་འདུག་སའི་ཁང་བའི་ནང་དུ་སྟབས་བདེ་བ་དང་སྟབས་འགྲིགས་པ་ཡིན་ན།",
    "དེ་ཚེ་རབས་སྔ་མ་ཞིག་ལ་ལས་འབྲེལ་ཞིག་ཡོད་པ་ལོས་ཡིན།",
    "རྒྱུ་དེ་ཡང་རང་དང་མཐུན་པའི་རྒྱུ་ལས་སྐྱེས་པ་མ་གཏོགས་མི་མཐུན་པའི་རྒྱུ་ལས་སྐྱེས་པ་དཔེར་མི་སྲིད།",
    "འགྲོ་རང་རང་སྐལ་བ་དང་འཚམ་པའི།",
    "གཞི་ལྔ་དང་རང་སྤྱིའི་མཚན་ཉིད་ཀྱི།",
