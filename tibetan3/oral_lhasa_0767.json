    "འདིར་རིགས་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་རྣམ་པར་མི་རྟོག་པ་༡ཉིད་དུ་གྱུར་ཏོ།",
    "དགའ་བ་ཡིད་འོང་དོན་ཆེན་འདོད་པས་ཞེས་བྱ་བས་གསུངས་ཏེ།",
    "དོན་དམ་པ་ནི་ཡང་དག་པར་སྤྱོར་བའི་བདེ་བ་ཆེན་པོ་སྟེ།",
    "བདག་ལ་དགྱེས་པར་མཛད་ཅིང་སྟེན་ཟུཔར་མཛད་དུ་གསོལ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འཇིག་རྟེན་རྣམས་ཀྱི་དོན་བྱ་བའི་ཕྱིར་དུས་རྟག་ཏུ་ཡང་དག་པར་བརྩོན་པའོ།",
    "སྤྱོད་པ་དྲི་མེད་ནི་རབ་ཏུ་དགའ་བ་སྐྱེད་པར་བྱེད་པའི་འཇུག་པའོ།",
    "དགེ་ལེགས་ཐོབ་པར་མཛད་པས་ན་ཀུན་དུ་བཟང་པོའོ།",
    "བདག་ལ་དགྱེས་པར་མཛོད་ཅེས་བྱ་བ་ནི་བདག་ལ་ལོངས་སྤྱད་པར་མཛོད་ཅིག་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྒུ་དང་གསུང་དང་ཐུགས་ཀྱི་དམ་ཚིག་རྡོ་རྗེ་ནི་དོན་ཡོད་པར་གྲུབ་པ་ཡིན་ཞིང་།",
    "དོན་ཡོད་པར་གྲུབ་པའི་སྒོ་ནས་ལས་ཀྱི་རིགས་ཀྱི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་དམ་ཚིག་གོ།",
    "བདག་ནི་འདོད་པའི་ཡོན་ཏན་ལྔ་རྣམ་པ་མང་པོས་དགའ་ཞིང་མཆོག་ཏུ་ཟད་པ་མེད་པའི་བདེ་བ་རྒྱས་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བདག་ཉིད་ཕུལ་དུ་བྱུང་བ་༤ཡིན་པར་སྟོན་ཏོ།",
    "དེ་དག་ལ་ཉེ་བར་ལོངས་སྤྱོད་པ་སྲེནི་སྙོམས་པར་འཇུག་པའི་བྱ་བས་བདེ་བ་ཆེན་པོའི་རོ་མྱོང་བའི་མཚན་ཉིད་དེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་རྣམས་སོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་བརྒྱད་ཀྱི་མཚན་ཉིད་རྣམ་པར་དག་པའི་རང་བཞིན་ཅན་གྱི་ཁམས་གསུམ་གྱི་སེམས་རྡོ་རྗེ་ལ་གནས་ཤིང་ཐུགས་མཉམ་པ་ཉིད་ལ་སྟེ།",
    "སློབ་དཔོན་རབ་ཏུ་དགའ་བའི་འབྱུང་གནས་གོ་ཆའི་ཞལ་སྔ་ནས་ཀྱིས་མཛད་པ་བཞུགས།"
  ]
}