    "རྒྱུ་རྣམ་པར་དཔྱད་ན་མེད་པའི་ཕྱིར་ནམ་མཁའ་ཆེན་མོ་ནི་འོད་དཔག་ཏུ་མེད་པ་ཡིན་ཞིང་།",
    "དེའི་རང་བཞིན་ཅན་གྱི་གོས་དཀར་མོའོ།",
    "ཡང་ཞེས་བྱ་བའི་སྒྲ་ནི་ཚིག་གི་རྒྱན་ཡིན་ནོ།",
    "གསུང་གི་གསང་བ་ནི་སོ་སོ་༡ཡང་དག་པར་རིག་པ་བཞིས་གསལ་བར་གྱུར་པའི་གསུང་རྡོ་རྗེར་བྱིན་ཀྱིས་རློབ་པར་བྱེད་པའི་སྔགས་སོ།",
    "སྔགས་ཏེ་སྐུ་རྡོ་རྗེ་ལ་སོགས་པ་རྣམས་ཀྱི་མཚན་དང་དཔེ་བྱད་དང་སོ་སོ་༡ཡང་དག་པར་རིག་པ་བཞི་དང་ལྡན་པའི་གསུང་གི་འཇུག་པ་དང་།",
    "གང་དག་གིས་ཤེ་ན།",
    "གོས་དཀར་མོ་དང་།",
    "འདོད་པ་ཞེས་བྱ་བ་ནི་འོང་བ་སྟེ་ཀུན་དུ་བཟང་མོ་ལ་སོགས་པ་ཡིན་ཞིང་།",
    "རེ་ཞིག་སེམས་ཉིད་ནི་སྐྱེ་བ་ལ་སོགས་པའི་རྣམ་པ་དང་།",
    "རེ་ཞིག་ལུས་ལ་སོགས་པ་ཉིད་མི་དམིགས་ན།",
    "སྣའི་རྩེ་མོར་ཞེས་བྱ་བ་ནི་པདྨའི་སྣ་རྩེའོ།",
    "ཡང་ན་ལྷ་མོ་བཞི་དང་ལྡན་པའི་གསང་བ་ལྔའི་བདག་ཉིད་དམ།",
    "དེ་ཁོ་ན་བཞིན་དུ་ཞེ་སྡང་རྡོ་རྗེའི་རྣལ་འབྱོར་པས་ཀྱང་རྡོ་རྗེ་རྩེ་མོ་དགུ་པའི་ལྟེ་བར་ཞེ་སྡང་རྡོ་རྗེའོ།",
    "འཁོར་ལོ་ལ་སོགས་ཞེས་བྱ་བ་ནི་ལྷག་༢མ་ལུས་པའི་ཕྱག་མཚན་ཟླུམ་པོ་དང་ཐུང་ངུ་དང་རིང་པོའི་བྱེ་བྲག་གིས་ཐ་དད་པ་རྣམས་ཏེ།",
    "རང་གི་རིག་མའི་པདྨའི་སྣ་རྩེ་ན་གནས་པའི་རྡོ་རྗེ་ལ་སོགས་པའི་མཚན་མའི་ནང་ན་གནས་པའི་རང་གི་ས་བོན་ལས་བྱུང་བའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་བདག་ཉིད་དམ།",
    "ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་གྱི་རང་གི་འདོད་པའི་ལྷའི་གཟུགས་སོ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་རིག་མ་དང་ལྡན་པའོ།",
    "རང་གི་འདོད་པ་ལྷའི་དཀྱིལ་འཁོར་གྱི་གོ་འཕང་གིས་འགྲོ་བ་མ་ལུས་པའི་བྱ་བ་བྱེད་པའི་ཕྱིར།",
    "སྔགས་སྤྱོད་པའི་མཆོག་གི་ལེའུ་དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པས་གསུངས་ཏེ།",
    "འདི་ལྟ་བུ་ཞེས་བྱ་བ་རང་གི་འདོད་པའི་ལྷར་དམིགས་པའི་སྒོ་ནས་ཡུལ་ལ་ཉེ་བར་ལོངས་སྤྱོད་པས་མྱུར་བ་ཉིད་དུ་འགྲུབ་པར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེ་བས་ན་ཡུལ་ཐམས་ཅད་ཀྱིས་རང་གི་ལྷག་པའི་ལྷའི་རང་བཞིན་ཅན་གྱི་བདག་ཉིད་དང་།",
    "རྨོངས་པ་གང་གིས་འཆིང་འགྱུར་བ།",
    "དཀའ་ཐུབ་ཅེས་བྱ་བ་ནི་རང་གི་ཡན་ལག་གཅོད་པ་ལ་སོགས་པ་རྣམས་སོ།",
    "ཟླ་བ་རེ་རེ་ཞིང་བསྙེན་གནས་སྲུང་བ་ལ་སོགས་པའོ།",
    "སློང་མོ་ཟ་ཞིང་མི་བཟླས་ཏེ།",
    "སློང་༥མོ་ཉིད་འབའ་ཞིག་ལ་རྒྱུ་བས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པས་དེ་བས་ན།",
    "ཡང་དང་ཡང་དུ་གོམས་པར་བྱ་བ་ཡིན་པས་ན་ཡོན་ཏན་ནི་གཟུགས་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་རྣམས་ཏེ་ཆུ་སྐྱེས་ལས་བྱུང་བ་དེ་རྣམས་བསྟེན་པར་བྱའོ།",
    "མཉེས་པར་༧བྱ་བ་ནི་དམན་པ་དང་བར་མ་དང་མཆོག་གི་བྱེ་བྲག་གིས་ཐ་དད་པའི་གཟུགས་ལ་སོགས་པའི་ཡུལ་༨རྣམ་པར་སྣང་མཛད་ལ་སོགས་བྱེཔའི་རང་བཞིན་གྱི་གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པ་ལྷ་མོའི་རྣམ་པར་གྱུར་པ་རྣམས་ཀྱིས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེ་བས་ན།",
    "ཡང་ཞེས་བྱ་བའི་སྒྲ་ནི་ཚིག་གི་ཁ་བསྐང་བའོ།",
    "དེར་ཞེས་བྱ་བ་ནི་རང་རང་གི་དཀྱིལ་འཁོར་དུའོ།",
    "དེ་བཞིན་དུ་འོད་དཔག་ཏུ་མེད་པ་ལ་སོགས་པའི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་རང་གི་སྔགས་ཀྱི་གླུ་ལེན་ཅིང་རང་གི་ལྷ་རྣམས་སྤྲོ་བར་བྱའོ།",
    "རང་གི་ཁུ་བའི་ཐིགས་པ་ཡིས།",
    "བདག་གི་སེམས་ཀྱང་དེ་དང་འདྲ།",
    "རང་རང་གི་སྔགས་ལས་ཡོངས་སུ་གྲུབ་པའི་ལྷ་ཐམས་ཅད་ཀྱི་རང་བཞིན་གྱི་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་སྟེ།",
    "དེའི་རྡུལ་ཕྲ་རབ་རེ་རེ་ལས་ཡང་དག་པར་གྲུབ་པའི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་གཟུགས་བསམས་ལ།",
    "དེ་ནས་བདུད་རྩི་དེས་རང་གི་ལུས་ལ་གནས་པའི་ལྷ་རྣམས་ཀྱི་འཁོར་ལོ་ཚིམ་པར་བྱ་སྟེ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་ཐབས་དང་ཤེས་རབ་རྗེས་སུ་དྲན་པ་བསྒོམས་པ་དེ་དག་གིས་ནི།",
    "སྲིད་པ་དང་ཞི་བ་རོ་གཅིག་པའི་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ལ་ལྷག་པར་མོས་པའི་དེ་ཁོ་ན་ཉིད་ལ་བརྟེན་ནས།",
    "ཅེས་བྱ་བ་ནི་ཡུལ་ཐམས་ཅད་ལ་ཉེ་བར་ལོངས་སྤྱོད་པ་བསྒོམས་པའི་སྒོ་ནས་རང་གི་ལྷག་པའི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་འགྲུབ་པའོ།",
    "བྱོལ་སོང་ལས་ཀྱང་ཞེས་བྱ་བ་ནི་གལ་ཏེ་དེ་ལྟ་བུའི་རྣམ་པ་ཅན་མ་རྙེད་ན།",
    "ཁ་ཅིག་ན་རེ་གླང་པོ་དང་རྒོད་མ་ལ་སོགས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "གསུང་གི་དཀྱིལ་འཁོར་ལ་ནི་ཤར་དང་ནུབ་དཀར་པོ་དང་སྔོན་པོ་ཡིན་ཞིང་ལྷོ་དང་བྱང་ནི་ཇི་ལྟར་གནས་པ་བཞིན་ཡིན་ནོ།",
    "གསུང་གི་དཀྱིལ་འཁོར་ལ་ནི་ཁ་དོག་དམར་པོ་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ལྷ་མོ་ནི་ཨུཏྤ་ལའི་ཕྱག་མཚན་བསྣམས་པའོ།",
    "ཛཱ་ཏི་རྣམ་གསུམ་ཞེས་བྱ་བ་ནི་གདོལ་པ་མོ་དང་།",
    "མེ་ཏོག་ཀཎི་ཀ་ལ་སོགས་པ་རྣམས་ནི་མཱ་མ་ཏཱི་ལ་སོགས་པ་ལྷ་མོ་རྣམས་ཀྱི་དངོས་པོ་དང་ཐ་མི་དད་པའི་བཙུན་མོ་རྣམས་ཀྱི་བྷ་ག་སྟེ།",
    "བཙུན་མོ་གཞོན་ནུའི་ནམ་མཁའི་ཁམས།",
    "མེ་ཏོག་བསམས་ཞེས་བྱ་བ་ནི་ལྷ་དང་ལྷ་མོའི་ཡང་དག་པར་སྤྱོར་བ་བྱས་ནས་སོ།",
    "གང་ཞིག་གིས་ཤེ་ན།",
    "དེ་བཞིན་དུ་པདྨས་མཚན་པ་ནི་གསུང་གི་དཀྱིལ་འཁོར་རོ།",
    "མཱ་མ་ཏཱིའི་གཟུགས་སུ་རྣམ་པར་བསྒོམ་༡པ་རྡོ་རྗེ་སེམས་དཔས་བདག་གིས་བྱས་པ་ཉིད་ཡིན་པའི་ཕྱིར་མཆོག་གོ།",
    "བདག་པོའི་ཕྱག་རྒྱར་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཆང་གི་ཕྱག་རྒྱ་ཆེན་པོར་རོ།་།",
    "བདག་གི་ལུས་ཞེས་བྱ་བ་ནི་འཁོར་ལོའི་ལྟེ་བ་ན་བཞུགས་པའི་བདག་པོའི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་བཞུགས་པའོ།",
    "དོན་དམ་པའི་དག་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་གྱི་དམ་ཚིག་གི་ལེའུ།",
    "ཅི་བཅོམ་ལྡན་འདས་ཀྱིས་བུད་མེད་ལ་བརྟེན་ནས་ཤ་འཁོན་ཞུགས་པ་བཞིན་དུ་འདི་གསོད་སེམས་ཀྱིས་ཀུན་ནས་བབེེང་བ་ཡིན་པར་གསུངས་སམ་ཞེ་ན།",
    "མི་བསྐྱོད་པའི་རྣལ་འབྱོར་པས་ཀྱང་ཉོན་མོངས་པའི་དུག་གིས་ནོན་པ་རྣམས་ཡང་དག་པར་འདོན་པར་བྱེད་དོ།",
    "རྡོ་རྗེས་ཞེས་བྱ་བ་ནི་རང་གི་ལག་ན་ཐོགས་པ་དང་།",
    "རང་གི་གསང་བ་དང་གདན་ལ་སོགས་པས་སོ།",
    "ལག་པ་གཡས་པ་ན་གནས་པའི་རྡོ་རྗེ་འབར་བས་བསྣུན་ཏེ་ཐལ་བར་བྱས་པ་བལྟ་བར་བྱའོ།",
    "ཉི་མ་བྱེ་བ་ཕྲག་བརྒྱའི་འོད་དང་ལྡན་པའི་རང་གི་གསང་བའི་རྡོ་རྗེ་འབར་བས་བསྣུན་ཏེ་ཐལ་བར་བྱས་པར་བསམ་པར་བྱའོ།",
    "མདུན་ན་ཡི་གེ་རེ་ལས་བྱུང་བའི་གྲུ་གསུམ་གྱི་རྣམ་པའི་ཤིང་རྟ་ལ་གནས་པ།",
    "ཞེ་སྡང་གིས་རབ་ཏུ་ཕྱེ་བའི་ལུས་དང་།",
    "ཁྱད་པར་དུ་འཕགས་པ་ལ་ལྷག་པར་མོས་པ།",
    "གཞན་མི་གཙང་བ་དང་འདྲེས་པའི་འོ་མའི་བཏུང་བའི་བུམ་པ་ལ་སྨོད་ཅིང་འཐུང་བ་བཞིན་དུ་ལྷག་པར་མོས་པ་ཡོངས་སུ་རྫོགས་པ་སྙེཕྱེད་སྨིན་པར་གྱུར་པ་ལ་ནི་མ་ཡིན་ནོ།",
    "བདག་གིས་མི་ཤེས་རབ་ཏུ་མི་ཤེས་ཞེས།",
    "ཤིན་ཏུ་ཐལ་ཆེས་པས་ཆོག་གོ།",
    "དེ་ནས་རང་གི་བ་སྤུའི་བུ་གའི་གསེབ་རྣམས་ནས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཚོསྤྲོ་སྟེ།",
    "རྡོ་རྗེ་གསུམ་གྱིས་ཞེས་བྱ་བ་ནི་ངག་གིས།",
    "རང་གི་ཁྱིམ་དགང་བར་བྱ་བའོ།",
    "གཏི་མུག་གི་རིགས་ཀྱི་དམ་ཚིག་ནི་རིགས་རི་༡ཐམས་ཅད་ཀྱི་ཐུན་མོང་བ་ཉིད་ཡིན་ནོ།",
    "ཟག་པ་མེད་པའི་དགའ་བ་མཆོག་གི་རང་བཞིན་ཉིད་ཡིན་པའི་ཕྱིར་དག་པའོ།",
    "དཔག་མེད་ཆེ་ཞེས་བྱ་བ་ནི་དེའི་དབུས་སུ་བདག་ཉིད་གོས་དཀར་མོར་རྣམ་པར་བསྒོམས་པའི་གར་མཁན་གྱི་བུ་མོ་དང་སྙོམས་པར་ཞུགས་པའི་འོད་དཔག་ཏུ་མེད་པར་རོ།",
    "བུད་མེད་རྣམ་པར་སྦྱོར་བ་ཞེས་བྱ་བ་ནི་རིག་མའི་ཚོགས་ཀྱི་དཀྱིལ་འཁོར་པ་ཡང་དག་པར་ཕྱུང་སྟེ།",
    "ཀུན་དུ་ཁྱབ་པའི་ཤེས་རབ་ལྷ་མོའི་གཟུགས་སུ་གྱུར་པ་དེ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་ཚིག་གི་བརྫུན་སྙེསྨྲ་བ་སྟེ་དེ་རྣམས་ཀྱིས་སོ།",
    "རང་གི་འདོད་པའི་ལྷའི་གོ་འཕང་ཐོབ་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་ཚིག་རྩུབ་པོ་ནི་འགྲོ་བ་དྲུག་གི་སྐྱེས་བུ་སྔོན་༡དུ་བྱེད་ཅིང་རྨོངས་པ་རྣམས་ལ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་བསླབ་པའི་གནས་གཞན་དང་གཞན་དག་ཀྱང་སྐྱེ་བོ་དེ་དང་དེ་རྣམས་ཀྱི་སྐྱོན་དག་ལ་གཟིགས་ནས།་",
    "ཡང་དག་པ་མ་ཡིན་པའི་ཚིག་གི་ལམ་རྡོ་རྗེའི་གནས་ཞེས་བྱ་བ་ལ་བདེན་པ་ནི་ཡང་དག་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཁར་༤གཞོང་དང་རྒྱ་ཤུག་གི་འབྲས་བུའི་ཚུལ་བཞིན་དུ་རྟེན་དང་བརྟེན་པ་མེད་པས་འདོད་པའི་ཁམས་ལ་སོགས་པ་ན་གནས་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཟླ་བ་དྲུག་དང་གསུམ་དང་གཉིས་དང་ཕྱེད་དང་གཉིས་དང་གཅིག་དང་ཟླ་བ་ཕྱེད་དེ་སྒྲུབ་པ་དྲུག་གིས་ལྷ་མ་གྲུབ་པ་དེའི་ཚེ་བདུན་པ་བཙན་ཐབས་ཀྱི་སྒྲུབ་པ་བརྩམས་ན་ཉིད་ཀྱིས་གསུངས་པའི་དམ་ཚིག་ལས་འདས་པའི་འཇིགས་པས་ངེས་པ་ཁོ་ནར་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཉོན་མོངས་པའི་བུད་ཤིང་བསྲེག་པའི་ཕྱིར་འབར་བའོ།",
    "དེ་ལས་བྱུང་བའི་སྔགས་ནི་ཡི་གེ་ཧཱུཾ་ལ་སོགས་པ་རྣམས་ཡིན་ཞིང་རང་གི་ལྷའི་ཏིང་ངེ་འཛིན་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཚུལ་ལོ།",
    "གཏི་མུག་གི་རིགས་ཀྱི་ལྷ་རྣམས་ཀྱི་སྐུ་ལ་སོགས་པ་རྣམས་གྲུབ་པར་བྱ་བའི་ཕྱིར་འདའ་བར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཡིན་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྒུ་དང་གསུང་དང་ཐུགས་ཀྱི་དམ་ཚིག་ལ་དམིགས་པའོ།",
    "ཚིག་གི་ལམ་ངེས་པར་བརྗོད་པ་ཞེས་བྱ་བ་ལ།",
    "རང་གི་གཟུགས་སུ་ཞེས་བྱ་བས་ནི་འདི་སྐད་དུ་བསྟན་པ་ཡིན་ཏེ།",
    "རྡོ་རྗེའི་འོད་ཟེར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཡི་གེ་ཧཱུཾ་ལས་བྱུང་བའི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་རྣམས་ཀྱིས་ཏྲེནམ་མཁའི་དབྱིངས་མ་ལུས་པ་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རྣམས་ལ་ཀུན་དུ་རེག་སྟེ་རྡོ་རྗེ་འཆང་ཆེན་པོའི་རྣམ་༧པར་ཡོངས་སུ་གྱུར་པར་བསམས་ལ།",
    "རང་གི་དཀྱིལ་འཁོར་རང་སྔགས་ཀྱིས།",
    "དེའི་དབུས་གནས་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་ཟླ་བ་ལ་རང་གི་ས་བོན་ནོ།",
    "རང་གི་ཕྱག་མཚན་གྱི་མཚན་མའི་ལྕགས་ཀྱུར་བསམ་པར་བྱའོ།",
    "ཆད་པའི་རིམ་པའི་དུས་སུ་ནི་རང་གི་རྡོ་རྗེས་བརྟག་་པར་བྱའོ།",
    "རྡོ་རྗེ་ཆེན་པོ་ཆེ་གེ་མོ།",
    "རྣམ་རྟོག་གིས་ནི་འགྲུབ་མི་འགྱུར།",
    "མི་ཕྱེད་པའི་ཡེ་ཤེས་བསྒྲུབ་པ་ལ་ཞུགས་པའི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་རང་གི་འདོད་པའི་ལྷའི་སྐུ་དང་གསུང་དང་ཐུགས་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།་།",
    "མཆོག་སྩོལ་བ་དག་རྣམ་པར་གཟིགས།",
    "དངོས་པོ་ཐམས་ཅད་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་ཀྱི་ཕུང་པོ་ལ་སོགས་པ་རྣམས་ཏེ།",
    "དེའི་བྷ་གར་ཡིད་ཀྱི་རང་བཞིན་གྱིས་བྱེ་རང་གི་ལྷའི་གཟུགས་སུ་ཞུགས་ཏེ།",
    "དེ་ལྟར་ན་ལྷ་མོའི་ཐུགས་ཡང་དག་པར་བསྒུལ་བར་འགྱུར་རོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི་མཱ་མ་ཏཱིའོ།",
    "རང་གིས་ཡོངས་སུ་བརྟགས་པ་རྣམས་ཏེ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ།",
    "རང་གི་ཏིང་ངེ་འཛིན་ལས་རང་གི་ལྷའི་གཟུགས་ཉིད་རྣམ་པར་སྤྲོས་ལ།",
    "འདི་རྣམས་ཞི་བའི་ངང་གི་རྒྱུ་རུ་འགྱུར།་།",
    "བསམ་མོ།",
    "སྐུ་ཡོད་ན་གསུང་འཇུག་པའི་ཕྱིར་སྐུའི་རྟེན་ལ་གསུང་གི་ཡི་གེ་རྣམ་པར་བཀོད་དོ།",
    "སེམས་ཀྱིས་ཀུན་དུ་བརྟགས་པའི་དོན་ཡང་དག་མེད་པར་མི་འཇུག་པས་དེའི་ཕྱིར་གསུང་གི་རྟེན་ལ་ཐུགས་ཀྱི་ཡི་གེ་རྣམ་པར་དགོད་པ་མཛད་དོ།",
    "ཡེ་ཤེས་རྡོ་རྗེ་དག་གིས་ཞེས་བྱ་བ་ནི་སྒྲུབ་པ་པོས་སོ།",
    "ཞེས་བྱ་བ་ནི་གསུང་རྡོ་རྗེའི་དཀྱིལ་འཁོར་དུ་རང་གི་སྔགས་ལས་གྲུབ་པའི་འོད་དཔག་ཏུ་མེད་པའོ།",
    "དེའི་ཕྱིར་དེའི་ལྷ་མོ་གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པ་དྲུག་དང་།",
    "ནམ་མཁའ་རྡོ་རྗེའི་དབུས་ཞེས་བྱ་བ་ནི་བཙུན་མོའི་པདྨའི་དབུས་སུའོ།",
    "རང་གི་སྔགས་ཀྱི་དམ་ཚིག་བསྐྱེད།",
    "ཀུན་དུ་བཟང་མོའི་པདྨ་ལས་ཛི་ན་ཛིཀ་ཅེས་བྱ་བའི་སྔགས་ལས་བྱུང་བའི་སྐུ་རྡོ་རྗེ་ཕྱུང་སྟེ་བཅུག་པའི་སྒོ་ནས་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུགས་སུའོ།",
    "ཞེས་བྱ་བ་ནི་ཡི་གེ་ཨོཾ་ལས་བྱུང་བའི་འོད་ཟེར་དཀར་པོ་ལ་སོགས་པའི་ཚོགས་རྣམས་ཀྱིས་རང་གི་ལུས་ཀུན་དུ་གསལ་བར་བྱས་ལ།",
    "བ་སྤུའི་བུ་གའི་གསེབ་ནས་བྱུང་བ་དེ་རྣམས་ཀྱི་རྩེ་མོ་ལས་རབ་ཏུ་གྲུབ་པའི་རྣམ་པར་སྣང་མཛད་རྣམས་སྤྲོས་པས་ནམ་མཁའི་དབྱིངས་མ་ལུས་པ་ཀུན་དུ་ཁྱབ་པར་བྱས་ཏེ།",
    "གཞན་དག་ན་རེ་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་ཉིད་དུ་བརྟགས་ཏེ།",
    "རང་གི་སྔགས་ཀྱི་སྐྱེས་བུ་བསྐྱེད།་།",
    "ཨ་རོ་ལོཀ་ཅེས་བྱ་བ་འདིས་སྔ་མ་བཞིན་དུའོ།",
    "ཨ་ནི་ངག་གི་ལམ་གཞག་སྟེ།",
    "ཞེས་བྱ་བ་ནི་དེ་ལས་བྱུང་བའི་འོད་ཟེར་དམར་པོ་ལ་སོགས་པའི་རྩེ་མོ་ལས་གྲུབ་པའི་འོད་དཔག་ཏུ་མེད་པ་རྣམས་སྤྲོས་པས་ནམ་མཁའ་ཀུན་དུ་བཀང་སྟེ།",
    "དེ་བཀུག་ནས་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "དེའི་ལྟེ་བའི་ཡི་གེ་ཨོཾ་ནི་ཡེ་ཤེས་ཨོཾ་མོ།",
    "དེ་བཀུག་ནས་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "དེའི་ལྟེ་བའི་ཡི་གེ་ཨོཾ་ནི་དམ་ཚིག་ཨོཾ་མོ།",
    "སྔ་མ་བཞིན་དུ་དམ་ཚིག་གི་དཀྱིལ་འཁོར་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་བྱས་ཏེ།",
    "བདག་གི་ལུས་ལ་སྣང་མཛད་གཞག་ཞེ།",
    "དེའི་དབུས་སུ་རྡོ་རྗེ་འཆང་གི་ང་རྒྱལ་དང་ལྡན་པས་འདུག་སྟེ།",
    "རང་གི་སྙེང་གའི་ཟླ་བ་ལ་ཡི་གེ་ཨོཾ་བཀོད་ལ།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་ཚོགས་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རྣམས་ལ་ཀུན་དུ་རེག་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུགས་སུ་ཡོངས་སུ་གྱུར་པ་བསྡུས་ནས་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "གསལ་བའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་བཙུན་མོའི་ནམ་མཁའི་དབྱིངས་ཀྱི་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཏེ།",
    "དེ་བཞིན་དུ་རང་གི་དཀྱིལ་འཁོར་ན་གནས་པའི་འོད་དཔག་ཏུ་མེད་པའི་རྣལ་འབྱོར་པས་ལུས་ལ་སོགས་པའི་གནས་ན་གནས་པའི་པདྨའི་ལྟེ་བ་ལ་ཡི་གེ་ཨཱ་ཛོསྣདང་།",
    "རོལ་མོ་འདི་དག་རབ་ཏུ་བསྒོམ།",
    "འོད་ཟེར་ཀྱི་རྩེ་མོ་ལས་བྱུང་བའི་འཕགས་པ་འཇམ་པའི་རྡོ་རྗེའི་སྤྲིན་སྤྲོས་པ་རྣམས་ཀྱིས་ལྐུནམ་མཁའ་ཀུན་དུ་བཀང་སྟེ།",
    "ཞེས་ཞེབྱ་བ་ནི་ཕུལ་དུ་བྱུང་བ་འཐོབ་ཅིང་ལྷ་རྣམས་ཀྱིས་རྗེས་སུ་གནང་བ་བྱིན་པའི་རྣལ་འབྱོར་པ་འཇམ་པའི་རྡོ་རྗེ་ལ་སོགས་པ་གང་ཡང་རུང་བའི་རྣལ་འབྱོར་དང་ལྡན་པས་རང་གི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་ལས་བྱུང་བའི་བདུད་རྩི་ལྔ་ཆ་མཉམ་པར་བྱས་པ་མ་ཤ་གཅིག་བླངས་ཏེ།",
    "ཟངས་མ་ཤ་གཅིག་དང་རྔུལ་མ་ཤ་གཉིས་དང་གསེར་མ་ཤ་བཞི་གོ་རིམས་བཞིན་དུ་གཏུམས་པའི་རི་ལུ་བྱས་ལ་རང་གི་ཁའམ་རིག་མའི་བྱའི་མཆུར་བཅུག་སྟེ།",
    "དེའི་ནང་ན་གནས་པའི་དཀྱིལ་འཁོར་དང་བཅས་པའི་རང་གི་བདག་པོ་ནམ་མཁའ་དང་མཚུངས་པའི་རྣམ་པར་བསམས་ལ།",
    "ཁ་ཅིག་ན་རེ་ཁ་ཐམས་ཅད་དུ་བཅུག་ལ་བསྒྲུབ་པར་བྱའོ་ཞེས་ཟེར་རོརང་གི་སྔགས་ཀྱིས་རབ་བསྒོམས་ནས།",
    "ཞེས་བྱ་བ་ནི་རང་གི་དཀྱིལ་འཁོར་ལ་གནས་པའི་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་དང་ལྡན་པའམ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་དཀྱིལ་འཁོར་ན་གནས་པའི་རྡོ་རྗེ་འཆང་ཆེན་པོའི་རྣལ་འབྱོར་རམ་མི་བསྐྱོད་པའི་རྣལ་འབྱོར་བྱས་ལ།",
    "དེའི་ནང་ན་གནས་པའི་རྡོ་རྗེའི་རིགས་བསྒོམ་ཞིང་འབར་བར་གྱུར་པ་དེ་ཁོ་ན་བཞིན་དུ་རང་གི་རིག་མ་ཟློས་ཤིང་བླང་བར་བྱའོ།",
    "རི་རབ་སུམ་ཅུ་རྩ་དྲུག་གི་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་སྙེད་ཀྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་སོ།",
    "རང་གི་སྔགས་ཀྱིས་རལ་གྲི་བསྒོམརྐ།",
    "དེའི་དབུས་སུ་དེ་ཁོ་ན་བཞིན་དུ་རང་གི་བདག་པོ་བསམ་པའོ།",
    "དེ་བཞིན་དུ་འདོད་ཆགས་དང་ཞེ་སྡང་གི་རིགས་དག་པ་ནི་རང་གི་ལྷའི་རྣལ་འབྱོར་གྱིས་ཡི་གེ་ཨ་དང་ཡི་གེ་ཧཱུཾ་དག་གིས་རི་ལུ་བསྒྲུབ་པར་བྱའོ།",
    "འཕགས་པ་སྟོབས་པོ་ཆེ་ལ་སོགས་པའི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཀྱང་རིམ་པ་དེ་ཁོ་ན་བཞིན་དུ་རང་གི་ཕྱག་མཚན་རྣམས་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར་རྩེ་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེའི་བྱེ་ཕྱིར་རྡོ་རྗེ་ལྕགས་ཀྱུ་ལ་སོགས་པ་བསྒྲུབ་ཆོཔ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་བུད་མེད་ལ་སོགས་པ་དགུག་པ་གསུངས་ཏེ།",
    "སྤྱོར་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བདག་ཉིད་གསུམ་གྱི་རང་བཞིན་ཅན་གྱི་དཔལ་རྡོ་རྗེ་འཆང་གི་གཟུགས་སུ་གྲུབ་པའི་བར་དུའོ།",
    "དེ་བཞིན་དུ་ལྷ་ལ་སོགས་པའི་བུ་མོ་རྣམས་ཏིང་ངེ་འཛིན་གྱིས་བཀུག་སྟེ།",
    "དེ་ནས་ལྕགས་ཀྱུ་དེས་དེ་ཁོ་ན་བཞིན་དུ་ཡེ་ཤེས་ཀྱི་ལྷ་ལ་སོགས་པ་བཀུག་ནས་རང་གི་བཀའ་ལ་སྦྱར་བ་དང་ཉེ་བར་ལོངས་སྤྱོད་པར་བྱ་བའོཞྭ།",
    "རང་གི་ལྷའི་རྣལ་འབྱོར་ཀྱིས་རིག་མ་ཐམས་ཅད་རྗེས་སུ་མཉེས་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར་རྡོ་རྗེའི་སྐུ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་རང་གི་ལྷའི་རྣམ་པར་ཡང་དག་པར་བསྐྱེད་ལ།",
    "རང་གི་ལྕེ་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཁ་དོག་དམར་བའི་སྣགཟུགས་དང་།",
    "དེའི་རྩེ་མོར་ཡི་གེ་ཧོ་ཁ་དོག་དམར་པོ་འོད་ཟེར་ལྔ་འབར་བ་རྣམ་པར་བསམ་སྟེ།",
    "ཤ་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་མཐུ་ཐོབ་པའི་རྣལ་འབྱོར་པས་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པའི་དངོས་གྲུབ་ཀྱི་བྱེ་བྲག་གི་སྒོ་ནས་བཀུག་སྟེ།",
    "ཅེས་བྱ་བ་ནི་ནུས་པ་མེད་པས་ཀྱང་གང་གི་ཚེ་གོམས་པར་བྱེད་པའི་དུས་པྱམ་རྙེད་པ་དེའི་ཚེ།",
    "དེ་བཞིན་དུ་འོད་དཔག་ཏུ་མེད་པའི་རྣལ་འབྱོར་པས་ནི་རང་གི་ཡེ་ཤེས་སེམས་དཔའ་དང་རྡོ་རྗེ་འཆང་གིས་བྱིན་གྱིས་བརླབས་པའི་ཅོད་པན་རྣམ་པར་བསམས་ཏེ།",
    "རང་གི་ལྕེའི་རྩེ་མོ་ལ་འོད་དཔག་ཏུ་མེད་པའི་རང་བཞིན་གྱི་ཡི་གེ་ཨ་བསམ་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱོར་བས་ལྕེའི་རྩེ་མོ་ལ་ཡི་གེ་ཨོཾ་བསམ་པར་བྱའོ།",
    "ཤ་ཆེན་དམ་ཚིག་མཆོག་གིས་ནི།",
    "ཞེས་བྱ་བ་ནི་ཐུན་མོང་དང་མཆོག་གི་རྣལ་འབྱོར་གྱི་བྱེ་བྲག་གོ།",
    "རང་བཞིན་མེད་པར་ལྷག་པར་མོས་པའི་སྒོ་ནས་རང་གི་ཡི་གེ་གསུམ་ལ་བཅུག་ནས།",
    "དེ་ནས་ཡི་གེ་ཧཱུཾ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་ཁྱཚོགས་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རྣམས་ལ་ཀུན་དུ་རེག་སྟེ།",
    "དཔལ་རྡོ་རྗེ་འཆང་གི་རྣམ་པར་བསམས་ལ།",
    "དེ་ནས་དེ་ཉིད་ཀྱི་རང་གི་ཐུགས་ཀར་ཡེ་ཤེས་སེམས་དཔའ་རྣམ་པར་བསྒོམས་ཏེ།",
    "གཞུང་དེ་ཙམ་གྱིས་ཐུན་མོང་གི་སྒྲུབ་པ་བསྟན་ཏེ།",
    "ཐུན་མོང་མཆོག་གི་དབྱེ་བ་ཡིས།",
    "རྡོ་རྗེ་བཞི་པོས་ཐུན་མོང་སྟེ།",
    "སྐུ་བྱིན་གྱིས་བརླབས་པའི་རྗེས་ཐོགས་ལ་གོག་མའི་ཆུ་སྐྱེས་ལ་གནས་པའི་ཡི་གེ་ཨའི་འོད་ཟེར་ལས་བྱུང་བའི་གོས་དཀར་མོ་རང་གི་སྤྲུལ་པའི་ཚོགས་ཀྱི་དབུས་ན་གནས་པ་རྣམ་པར་སྤྲོས་ལ།",
    "དེ་ཉིད་ཀྱི་སྤྲུལ་པའི་ཚོགས་ཀྱི་དབུས་ན་བཞུགས་པ་འོད་དཔག་ཏུ་མེད་པ་མཉེས་པར་བྱས་ཏེ་བཀུག་ནས་མདུན་ན་པདྨའི་གདན་ལ་བཞུགས་པ་ལ་ཚིགས་སུ་བཅད་པ་དག་གིས་གསོལ་བ་༣ཏབ་པ་ནི་བསྐུལ་བའོ།",
    "དེའི་ཚེ་རང་གི་གཟུགས་ཏེ།",
    "རང་གི་ལྷའི་རྣམ་པར་ངེས་པར་བསམས་ལ།",
    "དབུ་རྒྱན་ལ་ནི་བདག་པོ་ཞེས་བྱ་བ་རང་གི་ཅོད་པན་གྱི་གནས་ན་བཞུགས་པའི་རིག་མ་དང་སྙོམས་པར་ཞུགས་པའི་རང་གི་དེ་བཞིན་གཤེགས་པའམ།",
    "མཚན་མ་དེ་རྣམས་ཀྱི་སྒོ་ནས་སྔགས་ཀྱི་ཐིག་ལེ་དམ་པའི་རང་བཞིན་དུ་རང་གི་སེམས་བརྟན་པར་གྱུར་པར་ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "ཡན་ལག་དྲུག་པོ་དེ་རྣམས་ཀྱིས་ནི་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་སྒོ་ནས་ཡོངས་སུ་གྲུབ་པའི་མཆོག་གི་རྣལ་འབྱོར་བསྟན་ཏེ།",
    "མཆོག་གི་ཡེ་ཤེས་བདུད་རྩི་ཉིད།",
    "རྣལ་འབྱོར་བརྩོན་པ་དག་གིས་བྱ།",
    "བརྙེས་པའི་ཡན་ལག་དྲུག་གིས་ནི།",
    "གཞན་དག་གིས་ནི་བསྒྲུབ་འགྱུར་ན།",
    "སྣ་ཡི་རྩེ་མོར་རབ་ཏུ་བརྟག།",
    "ཡོངས་སུ་གྲུབ་པའི་མཆོག་གི་རྣལ་འབྱོར་སྟོན་པའི་ཕྱིར་རྡོ་རྗེ་སྒྲུབ་པ་ཆེན་པོའོ།",
    "མཚན་མོའི་ཐོ་རངས་དང་ཉེ་བའི་ཐུན་ཕྱེད་ནས་བཟུང་སྟེ།",
    "ཉིན་མོ་ཐུན་ཕྱེད་ཀྱི་བར་ནི་ཐུན་དང་པོའོ།",
    "ཉིན་མོའི་ལྷག་མའི་ཆུ་ཚོད་ནས་བརྩམས་ཏེ།",
    "མཚན་མོའི་ཆུ་ཚོད་ལ་ཐུག་པ་ནི་གསུམ་པའོ།",
    "མཚན་མོའི་ཐུན་ཕྱེད་དང་གཉིས་པ་ནས་ཐུན་གསུམ་པ་ལ་ཐུག་པ་ནི་ཐུན་བཞི་པ་སྟེ།",
    "དེ་ནས་ལྷ་མོ་རྣམས་ཀྱང་བསྐུལ་བའི་གླུ་བཞིས་བསྐུལ་བས་སད་ནས་འགོ་བ་མ་ལུས་པ་རྣམས་ཀྱི་དོན་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ཏེ།",
    "ལྷ་མོ་རྣམས་ཀྱིས་བསྐུལ་གྱུར་པས།",
    "ཉེ་བར་སྒྲུབ་པའི་སྡོམ་པ་སྟེ་རྗེས་སུ་རྣལ་འབྱོར་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱི་སྐུ་རྡོ་རྗེ་སྤྲུལ་པ་དང་བཅས་པ་མདུན་ན་བཞུགས་པ་ཡེ་ཤེས་ཀྱི་མིག་གི་གྲུཡུལ་དུ་བྱས་པའི་ཕྱིར་ཡུལ་ལོ།",
    "དེ་བཞིན་དུ་གསུང་རྡོ་རྗེ་དང་ཐུགས་རྡོ་རྗེ་དག་གིས་ཡང་དག་པར་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་གསོལ་བ་གདབ་པར་བྱའོ།",
    "སྔགས་ཀུན་ཏེ་ཡི་གེ་དང་སྒྲའི་རང་བཞིན་རྣམས་ཀྱི་དོན་ནི་རང་གི་ལྷའི་འབྲས་བུའི་ངོ་བོ་ཡིན་ཞིང་དེའི་དོན་དུ་བརྗོད་པ་ནི་བཟླས་པ་སྟེ།",
    "རྡོ་རྗེ་དབྱེ་བ་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པས་༦ནི་རང་གི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨའི་སྟེང་གི་ཟླ་བ་ལ་གནས་པའི་རྡོ་རྗེའི་ལྟེ་བར་ཡི་གེ་ཧཱུཾ་བསམ་པ་དང་།",
    "ཞེས་བྱ་བ་ནི་སྐུ་ལ་སོགས་པའི་ཡེ་ཤེས་སྐྱེརྣམ་པར་བཀོད་པ་རྣམས་ལས་རང་གི་ཡི་གེ་རྣམས་དང་རང་གི་ཕྱག་མཚན་རྣམས་དང་རང་གི་ལྷའི་གཟུགས་རྣམས་སྤྲོ་བའམ།",
    "ཡི་གེ་རེ་རེ་ལས་ཡི་གེ་གསུམ་དང་ཕྱག་མཚན་གསུམ་དང་གཟུགས་གསུམ་སྤྱོ་བའམ།",
    "ཡང་ན་རེ་རེ་ལས་ཅིག་ཊུཅར་རང་གི་ཡི་གེ་དང་ཕྱག་མཚན་དང་རང་གི་ལྷ་སྤྲོ་བ་སྟེ།",
    "ཡི་གེ་གསུམ་བཟླས་པ་དེ་ནི་རྡོ་རྗེའི་རིགས་གཙོ་བོར་གྱུར་པ་ཡིན་དུ་ཟིན་ཀྱང་རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གསུང་དང་ཐུགས་རྡོ་རྗེའི་རྣལ་འབྱོར་པ་དག་གིས་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨ་ལ་གནས་པའི་གེཆུ་སྐྱེས་དང་རྡོ་རྗེའི་ལྟེ་བ་དག་ལ་ཡི་གེ་ཨཱ་དང་ཧཱུཾ་བསམས་ལ།",
    "རང་གི་ཡི་གེ་ལ་སོགས་པ་སྤྲོ་བ་དང་བསྡུ་བ་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དོན་ཡོད་གྲུབ་པའི་རྣལ་འབྱོར་པས་འགྲོ་བ་མ་ལུས་པའི་བྱ་བ་སྒྲུབ་པའི་ཕྱིར་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨའི་སྟེང་གི་ཟླ་བ་ལ་གནས་པའི་རལ་གྲི་ལ་ཡི་གེ་ཧཱ་སྤྱོརྣམ་པར་བཀོད་དེ།",
    "འཕགས་པ་གཤིན་རྗེ་མཐར་བྱེད་ལ་སོགས་པའི་ཁྲོ་བོ་གང་ཡང་རུང་བའི་རྣལ་འབྱོར་པས་ནི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨའི་སྟེང་གི་ཉི་མ་ལ་གནས་པའི་རང་གི་ཕྱག་མཚན་ལ་བཟླས་པར་བྱ་བ་རྣམ་པར་བཀོད་དེ་རང་གི་ངག་རྡོ་རྗེས་བསྒྲགས་པའི་སྒྲ་དཔག་ཚད་བྱེ་བའི་ཚད་དང་ལྡན་པའི་དཀྱིལ་འཁོར་ན་གནས་པའི་ལྷའི་འཁོར་ལོས་ཐོས་པར་གྱུར་ཅིག་སྙམ་དུ་ལྷག་པར་མོས་པའི་སྒོ་ནས་སྒེག་པ་དང་བཅས་པའི་ཁྲོ་བོའི་ཚིག་གིས་བཟླས་པར་བྱའོ་ཞེས་བྱ་བ་འདི་ནི་ཁྲོ་་སྣབོའི་བཟླས་པའོ།",
    "དེའི་དེ་ཉིད་ནི་ངེས་པར་འབྱེད་པའི་ཤེས་རབ་ལྷ་མོའི་གཟུགས་སུ་ཡོངས་སུ་གྱུར་པའོ།",
    "དམ་ཚིག་རྡོ་རྗེ་ཅན་ཞེས་བྱ་བ་ནི་གཏི་མུག་གི་རིགས་ཀྱི་ལྷ་རྣམས་ཀྱི་སྟེ།",
    "དེ་ཉིད་ཐུན་མོང་ཡིན་པ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "དམ་ཚིག་རྡོ་རྗེ་ཞེས་བྱ་བ་རིགས་ཐམས་ཅད་ཀྱི་ལྷ་རྣམས་ཀྱི་མ་ནིང་གི་བཟླས་པ་སྟེ།",
    "སྐྱེས་པ་དང་བུད་མེད་ཀྱི་རྣམ་པར་རྟོག་པ་མེད་པའི་སྙེཕྱིར་རོ།",
    "འདི་ནི་རིག་པ་ཡང་ཁྲིན་ལ་ཆེན་མོ་ཡང་ཡིན་པས་ན་རིག་པ་ཆེན་མོའོ།",
    "འདོད་པ་ནི་དངོས་པོ་ཐམས་ཅད་ཀྱི་མཆོག་གི་དོན་ཆེན་པོ་སྟེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེ་བས་ན་འདོད་པའི་ཡོན་ཏན་ལྔ་ལ་ཉེ་བར་ལོངས་སྤྱོད་པ་ཉིད་ཀྱི་སྒོ་ནས་དེ་རྣམས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་བསྟེན་ན་འགྲུབ་པར་འགྱུར་ཀྱི་འདོད་པ་འདོད་ཆགས་དང་བྲལ་བའི་སྒོ་ནས་ནི་མ་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དོན་དེ་ཉིད་ལ་ཞུགས་པའི་མཆོག་གི་ལས་ཅན་གྱི་སྒྲུབ་པ་པོས་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལས་བྱུང་བའི་འོད་ཟེར་དཀར་པོ་སྤྲོས་པ་རྣམས་ཀྱིས་དངོས་པོ་ཐམས་ཅད་ལ་ཀུན་དུ་རེག་ནས་སྣང་བ་མེད་པར་བྱ་བ་སྟེ།",
    "འོད་ཟེར་ལྔའི་བྱེ་བྲག་གིས།",
    "སྐུ་གསུམ་རྡོ་རྗེའི་བྱེ་བྲག་གིས།",
    "ཞེས་བྱ་བས་ནི་སྤྲོས་པའི་གཟུགས་རེ་རེ་ཞིང་སྐུ་གསུམ་གྱི་བདག་ཉིད་ཅན་དང་རྡོ་རྗེ་གསུམ་གྱི་ཤཱརང་བཞིན་ཅན་ཉིད་ཡིན་པར་བསྟན་ཏོ།",
    "དེའི་ངོ་བོ་ནི་གོས་དཀར་མོའི་གཟུགས་ཏེ་དེས་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་གཟུགས་ཅན་མཆོད་་ན།",
    "ཞེས་བྱ་བ་དེའི་དབུས་སུ་བདག་ཉིད་རང་གི་ལྷག་པའི་ལྷར་བསམས་ཏེ།",
    "སྐུ་གསུང་རྡོ་རྗེ་རང་གི་གཟུགས།",
    "རང་གི་བདག་པོའི་འོ།",
    "ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨའི་སྟེང་གི་ཟླ་བ་ལ་གནས་པའི་སྔགས་རྣམས་ཀྱི་དོན་ནི་ཞི་བ་ལ་སོགས་པ་སྟེ།",
    "རང་གི་ཡེ་ཤེས་ཀྱི་ལྷའི་ཐུགས་ཀར་པདྨའི་སྟེང་གི་ཟླ་བ་ལ་བསྒྲུབ་བྱ་བསམ་སྟེ།",
    "རང་གི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨ་ལ་གནས་པའི་ཟླ་བ་སེར་པོ་ལ་རྒྱས་པའི་དོན་དུ་གཉེར་བ་བཅུག་སྟེ།",
