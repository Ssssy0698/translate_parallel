    "གོས་དཀར་མོའི་མཚོ་སྐྱེས་སུ་གསུང་གི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་གནས་པའི་པདྨའི་སྟེང་གི་ཟླ་བའི་གདན་ལའོ།",
    "རྡོ་རྗེ་ནམ་མཁའ་ཞེས་བྱ་བ་ནི་ལྷ་མོ་རྡོ་རྗེ་ནམ་མཁའ་མའོ།",
    "མཱ་མ་ཀྲིའི་པདྨའི་ནང་ན་གནས་པའི་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་གནས་པའི་པདྨའི་སྟེང་གི་ཉི་མའི་གདན་གྱི་དབུས་སུ་བདག་ཉིད་ཡི་གེ་ར་ལས་བྱུང་བའི་ནམ་མཁའ་ལྟ་བུའི་མེའི་དཀྱིལ་འཁོར་གྲུ་གསུམ་འབར་བའི་ཡི་གེ་རེ་གྱིས་མཚན་པ་ལ་བཞུགས་པ་རྡོ་རྗེ་འཆང་ཆེན་པོ་དང་མཚུངས་པའི་མི་བསྐྱོད་པར་རྣམ་པར་བསྒོམས་ལ།",
    "རང་གི་བ་སྤུའི་བུ་ག་ནས་བྱུང་བའི་འོད་ཟེར་གྱི་སྒོ་ལས་སྤྲོས་པའི་རྡོ་རྗེ་སྲིན་པོ་དྲག་པོ་མི་བཟད་པ་རྣམས་དང་ཅེ་སྤྱང་དང་བྱ་རོག་དང་བྱ་རྒོད་དང་ཁྱི་རྣམ་པ་ཐ་དད་པ་རྣམས་ཀྱིས་ནམ་མཁའི་དབྱེངས་ཀུན་དུ་བཀང་ལ།",
    "ལྷ་རྣམས་ཐམས་ཅད་ཞལ་གསུམ་མོ།",
    "གཞུང་གི་དོན་དང་མན་ངག་ལས།",
    "བདག་གི་ནུས་པ་ཡང་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "དེའི་སྤྱན་ནི་ཤེས་རབ་ཀྱི་སྤྱན་དུ་གྱུར་པའམ་རང་གི་རིག་སྔགས་ཀྱི་རྣལ་འབྱོར་པ་རྡོ་རྗེའི་གནས་སུ་ཁྲིད་པར་བྱེད་པས་སོ།",
    "༦ ཁམས་གསུམ་དག་གི་ནང་ན་གནས་པའི་གདུག་པ་རྣམས་འཇིགས་པར་བྱེད་པས་ན་ཁམས་གསུམ་དག་ནི་འཇིགས་པར་བྱེད་པའོ།",
    "ཉོན་མོངས་པའི་བུད་ཤིང་མ་ལུས་པ་བསྲེག་པའི་བདག་ཉིད་ཀྱི་འོད་ཀྱིས་འབར་བ་ཉིད་ཡིན་པའི་ཕྱིར་འབར་བ་རྣོན་པོ་ཅན་ནོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ངེས་པར་འཇོམས་པར་བྱེད་པའི་མཚན་ཉིད་ཅན་གྱི།",
    "དེའི་ཕྱིར་རེ་རེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲོ་བའི་དོན་བྱེད་དུ་བཅུག་ལ་དེ་བཀུག་ནས་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "འོད་ཟེར་སྤྲིན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རང་གི་བ་སྲུ་ལས་བྱུང་བའི་འོད་ཟེར་སྣ་ཚོགས་ཀྱི་སྤྲིན་གྱི་ཕྱ་འཁོར་ལོས་ནམ་མཁའ་ཀུན་དུ་གང་བར་བསམ་པར་བྱའོ།",
    "ཕྱག་གི་མཆོག་ཏུ་རྣམ་པར་བསྒོམས་པ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་གཡས་པའི་རྩ་བའི་ཕྱག་གིས་ཐུགས་ཀར་ཁ་ཕྱེ་བ་དེའི་རྩ་བ་གཡོན་པ་དྲིལ་བུ་དང་བཅས་པས་གཟུང་བའི་ཐབས་མཚོན་པར་བྱེད་པའོ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནི་སྐུའི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་གནས་པའི་པདྨའི་སྟེང་གི་ཉི་མའི་གདན་ནོ།",
    "གཤིན་རྗེའི་རྣམ་པས་འཆི་བདག་གི་བདུད་འཇོམས་པར་བྱེད་པའི་ཕྱིར་གཤིན་རྗེ་གཤེད་དོ།",
    "ཉོན་མོངས་པ་རྣམས་ཀྱིས་འཕམ་པར་བྱ་བ་མི་ནུས་པ་ཉིད་ཡིན་པའི་ཕྱིར་གཞན་གྱིས་མི་ཐུབ་པའོ།་།",
    "པདྨ་མཐར་བྱེད་གང་གིས་རྣམ་པ་ཐམས་ཅད་དུ་གདུག་པའི་ཕུང་པོའི་བདུད་ཀྱི་རང་བཞིན་ཅན་ཚངས་པ་གནོན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "གང་གིས་ཤེ་ན་ཁྲོ་བོའི་འཁོར་ལོས་ཏེ།",
    "འདི་གང་གིས་བྱ་ཞེ་ན།",
    "དེ་བཞིན་དུ་ཆུ་ལྷ་དང་བདེན་བྲལ་གྱི་ཕྱོགས་དག་གི་དབུས་ན་གནས་པའི་རྩིབས་ལ་ཁྲོ་བོ་དཔལ་གནོད་མཛེས་རྒྱལ་པོ་བསམ་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་འདའ་བར་མི་བྱ་བ་ཉིད་ཡིན་པའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་བདག་པོ་ནི་རྡོ་རྗེ་འཆང་ཆེན་པོའོ།",
    "དེའི་བཙུན་མོ་ནི་སྔགས་ཀྱི་ལྷ་མོའོ།",
    "འདི་ཉིད་གདན་ཁ་དོག་སེར་པོ་ལ་སོགས་པར་བསམ་པའི་བྱེ་བྲག་གིས་ཞི་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་རབ་ཏུ་བསྒྲུབ་ཀྱེཔའོ།",
    "རྡོ་རྗེ་འཛིན་གྱི་བཙུན་མོའི་མཆོག་འདི་ཞེས་བྱ་བ་ནི་བླ་ན་མེད་པའོ།",
    "དེ་བཞིན་དུ་ཐམས་ཅད་ལ་རིགས་ཀྱི་བྱེ་བྲག་གི་སྒོ་ནས་ཤེས་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་རྣལ་འབྱོར་གྱིས་རོ་ལངས་ལ་སོགས་པས་སྒྲུབ་པ་རྣམས་ལའོ།",
    "དེའི་དམ་ཚིག་ནི་གོས་དཀར་མོ་སྟེ།",
    "གང་ལ་དེ་གཟིགས་ཤིང་ཡེ་ཤེས་ཀྱི་སྤྱན་གྱིས་ཡུལ་དུ་བྱ་བ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་གཏི་མུག་གི་རིགས་ཀྱི་དཀྱིལ་འཁོར་པ་རྣམས་སོ།",
    "དེ་ནས་ལྷ་རྣམས་ཀྱིས་རྗེས་སུ་གནང་བར་གྱུར་ཅིང་བཟླས་པ་འབུམ་བྱས་པས་བུད་མེད་ཀྱི་ཐོད་པ་བཟང་པོ་མ་ཆག་པ་བླངས་ཏེ།",
    "གནོད་སྦྱིན་མོ་ལ་སོགས་པ་རྣམས་ཀྱང་དེ་བཞིན་དུ་དགུག་པར་བྱའོ།",
    "ཡང་ན་ཀ་ཞེས་བྱ་བ་བདེ་བ་ཡིན་ཞིང་དེ་སྲུང་ས་བར་བྱེད་ཅིང་འཕེལ་བར་བྱེད་པས་ན་ཀ་པཱ་ལ་སྟེ་ཐོད་པ་ནི་བུ་མོ་གཞོན་ནུ་མའི་ལུས་སོ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་རྣལ་འབྱོར་དང་ལྡན་པས་ཐོད་ལེ་ཚོཀོར་དང་རོ་བསྲེགས་གཀྱི་མེ་ལ་བསྲེགས་པའི་སྨྱོ་བྱེད་ནི་ཤིང་གི་སོལ་བ་དང་བ་བླ་དང་ཨཱ་རི་ཥཱའི་ལོ་མ་དང་དུག་ལ་སོགས་པ་རྐང་པ་གཡོན་པའི་སྲིན་ལག་གི་ཁྲག་དང་བཅས་པ་རྣམས་བཏགས་ཏེ།",
    "མཉེ་ཞིང་ཆེ་གེ་མོ་རཱཀྵ་གེསཱ་ཏི་བྷྱོ་མོ་ཙ་ཡ་ཏི་ཞེས་བྱ་བའི་བསྐུལ་བའི་ཚིག་དང་ལྡན་པའི་སྔགས་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་ན་རྡོ་རྗེ་གཉིས་ཀྱི་རྣམ་པར་སེམས་ཡང་དག་པར་སྤྱོར་བས་ངུ་ཞིང་ཤིང་གི་ཡལ་ག་ཆག་པ་ལ་སོགས་པ་ཡིད་ཆེས་པ་སྟོན་པ་སྔོན་དུ་འཀྲོ་བས་གདོན་མི་ཟ་བར་གཏང་རྒེབར་བྱེད་པའམ་དུག་མེད་པར་འགྱུར་རོ།",
    "དུར་ཁྲོད་དུ་སོང་སྟེ་མཚན་ཕྱེད་ཀྱི་དུས་སུ་རོ་བསྲེགས་ཀྱི་ཐལ་བས་མེ་ཐབ་གྲུ་གསུམ་བྱས་ལ།",
    "ཧ་ན་ནཱ་གི།",
    "མྱུར་དུ་ཆར་ཕོབ་ཅིག་ཅེས་བྱ་བའི་བསྐུལ་བའི་ཚིག་དང་ལྡན་པའི་ཡི་གེ་ཧཱུཾ་གི་སྔགས་ཁྲི་བཟླས་པར་བྱའོ།",
    "དེ་ལས་བྱུང་བའི་འཇོམས་པ་ནི་འདོད་པའི་རྒྱལ་པོ་སྟེ་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་འཇོམས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "རྐང་པ་གཡས་པའི་མཛུབ་མོའི་ཁྲག་དང་ལན་ཚྭ་དང་ཉུངས་མར་ཚ་བ་དང་སྐེ་ཚེ་ལ་སོགས་པ་རྣམས་ཀྱིས་ལྷ་ཆེན་པོ་ལ་སོགས་པའི་གཟུགས་བརྙན་རང་གི་ལྷ་མོ་དང་ལྡན་པ་བྲིས་ཏེ།",
    "བུ་མོ་མཐུ་ཆེན་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་སྤྱན་ལ་སོགས་པ་རྣམས་སོ།",
    "དེ་ཉིད་རང་གི་དཀྱིལ་འཁོར་གྱི་བདག་པོ་ག་ཉིད་ཡིན་པའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཀུན་ཀྱི་བདག་པོ་སྟེ།",
    "དེས་ནི་འདི་སྐད་དུ་ཇི་ལྟ་བ་བཞིན་དུ་འཕགས་པ་གནོད་མཛེས་རྒྱལ་པོའི་རྣལ་འབྱོར་དང་ལྡན་པས་བུད་མེད་ཀྱི་ཐོད་པ་མཚན་དང་ལྡན་པ་ལ་སྤྱན་ལ་སོགས་པ་རྣམས་ཀྱི་ནང་ནས་གང་ཡང་རུང་བའམ་ལྷ་ལ་སོགས་པའི་བུ་མོ་རྐང་པ་གཡོན་པའི་ཨ་ན་མི་ཀའི་ཁྲག་གིས་བྲིས་ཏེ།",
    "ཚིག་ཏུ་བརྗོད་པས་འདའ་བར་བྱ་བ་མ་ཡིན་པའི་ཕྱིན་ཅི་མ་ལོག་པའི་དོན་སྟོན་པར་བྱེད་པའི་སྒྲའི་ཚོགས་ནི་གསུང་གི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་ཀྱིས་ལྷགནས་སོ།",
    "འཁོར་ལོ་ཆེན་པོ་ནི་གསུང་རྡོ་རྗེ་ལ་སོགས་པ་རྣམས་ཀྱི་རང་གི་དཀྱིལ་འཁོར་ཏེ།",
    "མིའི་བུ་མོ་མཆོག་ཅེས་བྱ་བ་ནི་རྒྱལ་པོའི་བུ་མོའོ།",
    "ནམ་མཁའི་བུ་མོ་ཞེས་བྱ་བ་ནི་ནམ་མཁའི་རྡོ་རྗེ་སྤྱན་ནོ།",
    "དེ་ནས་དེ་སོང་སྟེ་ནམ་མཁའ་ན་ཉི་མའི་དཀྱིལ་འཁོར་ལ་གནས་པའི་ནམ་མཁའ་དུརྡོ་རྗེ་སྤྱན་དེ་ཁོ་ན་བཞིན་དུ་བཀུག་ནས་འོངས་ཏེ་གཏད་པར་བསམས་ན་གདོན་མི་ཟ་བར་འགུགས་པར་འགྱུར་རོ།",
    "ནམ་མཁའ་ལ་སྤྱོད་པའི་ལྷའི་བུ་མོ་ལ་སོགས་པ་དགུག་༡པ་ཡང་དེ་དང་འདྲའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་རྣམས་ཀྱི་བུ་མོ་ནི་ལྷ་མིན་བུ་མོའོ།",
    "འོན་ཀྱང་གཡོན་བརྐྱང་བས་བཞུགས་པ་གཡས་དང་གཡོན་གྱི་རྩ་བའི་ཕྱག་དག་གིས་རྡོ་རྗེ་ལྕགས་ཀྱུ་དང་ཞགས་པ།",
    "དེའི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འཕགས་པ་འཇམ་དཔལ་གྱི་རྣལ་འབྱོར་དང་ལྡན་པས་གཡས་པའི་རྩ་བའི་ཕྱག་ཏུ་རང་གི་སྔགས་ལས་བྱུང་བའི་འཕགས་པ་གཤིན་རྗེ་གཤེད་ཡོངས་སུ་གྱུར་པར་བྱས་ནས་རྡོ་རྗེ་ལྕགས་ཀྱུ་བསམས་ཏེ།་",
    "ཕྱག་རྒྱའི་ཁྱད་པར་ནི་ལྷ་དེ་དང་དེ་རྣམས་ཀྱི་རང་གི་རིག་མ་དང་གཉིས་སུ་མེད་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་ཁྱད་པར་རྐྱེ་རང་གི་ཕྱག་མཚན་གྱི་ལྕགས་ཀྱུའི་ཁྱད་པར་ཏེ།",
    "མ་མོའི་གནས་སམ་ཞེས་བྱ་བ་ལ་སོགས་པས་གསུངས་ཏེ།",
    "ཁྱད་པར་དུ་ཞེས་བྱ་བ་ནི་བུད་མེད་དང་མ་ནིང་བསྐྲད་པ་ལ་རང་དང་རྗེས་སུ་མཐུན་པར་རོ།",
    "རྡོ་རྗེའི་ཚིག་གིས་སྔགས་ཟློས་ཤིང་དགྲ་བོའི་སྒོ་རུ་སྦས་ན་སྒོད་པར་འགྱུར་རོ།"
  ]
}