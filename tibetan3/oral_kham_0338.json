    "དེ་ནམ་རྒྱུན་བཞིན་དམ་པོར་འདུག་ཡིན་ནའང་།",
    "ཡིན་ན་ཡང་ཁོས་སྐོར་ར་བྱེད་ཀྱི་འདུག་དེ་ནས་ཉ་ཐག་དེ་ཡར་མི་ཡོང་བ་འདུག་ལ།",
    "ཁོས་ཁོའི་སྐོར་ར་ཡི་ཐག་རིང་བའི་ཆ་དེ་བྱེད་ཀྱི་འདུག་ཁོས་བཤད།",
    "ཁོའི་རུས་པའི་རྐང་ནས་ཐང་ཆད་འདུག་ཡིན་ན་ཡང་།",
    "ཁོའི་ཟུར་གྱི་གཤོག་པ་གཉིས་རྒྱ་ཆེར་བཀྲལ་ནས་འདུག་སྐོར་ར་འདིའི་སྐབས་ལ་རྒད་པོས་ཉ་འདིའི་མིག་དང་འཇིབ་ཉ་གཉིས་ཀྱིས་ཁོའི་མཐའ་ལ་སྐོར་ཏེ་རྐྱལ་རྒྱག་པ་མཐོང་ཐུབ།",
    "ཁོའི་འཆི་བ་དེ་ཁོའི་ནང་ལ་འདུག་ཆུའི་ནང་ནས་ཡར་མཐོན་པོར་བསྒྲེངས།",
    "རྒྱ་མཚོའི་རྦ་རླབས་དང་འགྲོགས་ནས་ཆུ་ཁར་གཡེངས་འདུག་དེ་རྒད་པོས་རང་ལ་ཡོད་པའི་མིག་ཤེས་གསལ་ལ་མི་གསལ་བ་དེས་ཞིབ་ལྟ་ཐུང་ཐུང་ཞིག་བྱས།",
    "འཐབ་འཁྲུག་ཚར་བའི་རྗེས་ལ་གཡོག་ལས་མང་བོ་བྱེད་རྒྱུ་བསྡད་འདུག་ཁོས་ནམ་མཁའ་ལ་ཡར་བལྟས་ཤིང་དེ་ནས་ཁོའི་ཉ་ལ་བལྟས།",
    "དེའི་ཚབ་ལ་ཁོ་ད་ནི་རྒྱ་མཚོའི་ཁར་གཡེངས་ནས་འདུག་རྒད་པོས་གྲུ་ཆུང་དེ་ཁོ་ཡོད་སར་ཕར་དེད།་",
    "ཁོའི་གནས་བབ་ལ་བལྟས་ན་རྒྱ་མ་ཆིག་སྟོང་ལྔ་བརྒྱ་ལས་མང་བ་འདུག་ཁོས་བསམས།",
    "ལྷན་པ་ཅན་གྱི་གྲུ་དར་དེས་གྲུ་འཐེན་ནས་ལྷོ་ནུབ་ཕྱོགས་ལ་གྲུ་བསྐྱོད་པའི་མགོ་བརྩམས་སྐབས་དེར་རྒྱུ་ཡི་ཕྱེད་ཀ་ཞིག་ཟུར་ལ་སྙེས་ནས་འདུག་ལྷོ་ནུབ་ཀྱི་ཕྱོགས་དེ་གང་ཡིན་མིན་སྟོན་པ་ལ།",
    "ཉ་སཱར་ཌིན་རྣམས་རུལ་འདུག་དེ་བས།",
    "ཉི་འོད་འོག་འདུག་དེ་ནས་ཁོ་རྒྱ་མཚོའི་ནང་ཡང་བསྐྱར་ཟགས།",
    "ཡིན་ན་ཡང་ཁོས་དྲི་མ་ཡང་བསྐྱར་སྣུམ་ཐུབ་ཀྱི་འདུག་ཡང་ན་ཁོ་ལ་དེའི་ཤུལ་རྙེད་ཀྱི་འདུག་ཁོ་ཁ་ཕྱོགས་འདི་ལ་མགྱོགས་པོ་དང་སྟོབས་ཆེན་པོས་རྐྱལ་བརྒྱབ།",
    "དེ་ནས་ཁོ་རང་རང་ལ་ཐག་པ་ཐུང་ངུ་དེས་ཐེངས་གཉིས་བཀྱིགས་ནས་ཡང་བསྐྱར་སྒྲེ་ལོག་ཅིག་བརྒྱབ།",
    "ཉ་ལ་སོ་བཏབ་པའི་སྐབས་དེར་ཁོས་ཁོ་རང་རང་ལ་སོ་བཏབ་པ་ལྟར་ཚོར།",
    "འདི་ན་འདུག་ཁོས་སྐད་ཆེན་པོས་བཤད།",
    "ཁོ་ཁོ་རང་ལ་འབྲེལ་བ་ཡོད་པའི་དོན་དག་ཚང་མའི་སྐོར་ལ་བསམ་བློ་གཏོང་རྒྱུར་དགའ།",
    "མཚོ་རྩྭ་སེར་པོའི་དུམ་བུ་འགའ་ཡང་འདུག་མཐའ་ན་ཁོས་བྱིའུ་ཞིག་ཀྱང་མི་མཐོང་།",
    "ཁོ་ཚོས་དྲི་མ་ཞིམ་པོ་ཚོར་ནས་དགའ་འདུག་ལ།",
    "ཁོ་འཆི་བཞིན་དུའང་ཁོ་ལ་ཐོབ་པའི་ཤ་དེ་མིད་བཞིན་འདུག་ཉ་ཐུག་གཞན་པ་དེས་ཉ་ལ་གཏོར་བཅོམ་བྱེད་བཞིན་པའི་རྐྱེན་གྱིས་གྲུ་ཆུང་དེ་ད་དུང་ཡང་ཡོམ་ཡོམ་བྱེད་ཀྱི་འདུག་གྲུ་ཆུང་དེ་རྒྱ་ཆེན་པོར་ཡོམ་ཆེད་རྒད་པོས་གྲུ་དར་གྱི་དར་ཡུག་གློད་ཅིང་།",
    "པགས་པ་དེ་མཁྲེགས་པོར་འདུག་བརྟེན་གྲི་འཛུགས་རྒྱུར་ཡང་ཁག་ཙམ་འདུག་གཞུས་པ་དེས་ཁོའི་ལག་པ་ཙམ་མ་ཟད་ཕྲག་པ་ལ་ཡང་ན་ཟུག་བཟོས།",
    "ཁོས་ད་དུང་ཉ་ལ་མཆེ་བ་བཙུགས་ནས་བསྡད་འདུག་རྒད་པོས་ཁོའི་མིག་གཡོན་མའི་ནང་གྲི་བཙུགས།",
    "ད་དུང་ཁོའི་ཁྲ་ཐིག་རྣམས་ལྷང་ངེར་འདུག།",
    "ཁ་ངས་ང་ལ་གྲི་འདིའི་ཆེད་དུ་རྡོ་ཞིག་ཡོད་ན་བསམས་ཀྱི་འདུག་གྲུ་ཁྱེམ་ལ་བཀྱིགས་པའི་ཐག་པ་ལ་བརྟག་དཔྱད་བྱས་རྗེས་རྒད་པོས་བཤད།",
    "ཁྱེད་རང་ལ་ཡོད་པ་རྣམས་ཀྱིས་ཅི་ཞིག་བྱེད་ཐུབ་མིན་བསམ་བློ་ཐོངས།",
    "དོན་ལ་ཁྱད་པར་བཟོ་བའི་རྨ་ཁ་གང་ཡང་མི་འདུག་ཁྲག་འཛགས་པ་དེས་གཅིག་བྱས་ན།",
    "ཐུག་གཞན་པ་དེ་ཕར་འགྲོ་ཚུར་འོང་བྱེད་ཀྱིན་འདུག་ལ།",
    "པ་ད་ང་ཕར་ཆེས་ཐག་རིང་ས་ལ་འགྲོ་མི་རུང་བ་འདུགཁོས་བསམས།",
    "ཉ་དེ་ཆེས་ཐབས་རྡུགས་ངང་འཕྲོ་བརླག་ལ་བཏང་འདུག་སྟབས།",
    "དེ་ཚོ་ཤི་མི་འདུག་ཁོས་དེ་ཚོ་ཟུམ་པ་དང་འབྱེད་པ་ཙམ་གྱིས་མི་ཚེའི་སྡུག་བསྔལ་དེ་ལས་སླ་བོར་འདྲེན་ཐུབ་ཀྱི་འདུག་ཁོ་གྲུ་མཇུག་ལ་རྒྱབ་བསྟན་ནས་སྙེས་པ་དང་ཁོ་ཤི་མེད་པ་ཤེས།",
    "ད་ཆ་ངས་དེ་ཚོ་འདོན་རྒྱུ་ལ་ང་ཤིན་ཏུ་ཐང་ཆད་ནས་འདུག་ངས་སྐྱེ་སྣོད་བླངས་ནས་ངའི་ཕྲག་པ་ལ་གཡོགས་ན་བཟང་།",
    "དེ་ན་ཁོའི་མཆེ་བ་ཡིས་མི་ཆོད་པའི་ཉ་ཡི་མགོ་ལྗིད་ཆེ་བའི་ཆ་དེར་འཇུས་འདུག་ཁོས་དེར་ཐེངས་གཅིག་དང་གཉིས་དང་ཡང་བསྐྱར་གཞུས།",
    "ཁྱེད་རང་ལ་འཐུང་རྒྱུ་འདྲ་དགོས་སམ།",
    "ངས་ཁྱེད་རང་དྲན་བྱུང་།",
    "ཁོ་ད་དུང་ཡང་ཁ་མར་བསྟན་ནས་ཉལ་འདུག་ལ།",
    "༡༩༢༦ ལོར་ཉི་མ་ཡང་ཤར་འདུག་ཅེས་པ་དེ་ཐོན་པ་མཉམ་དུ།",
    "དྲུང་ན་འདུག་པའི་རྣལ་འབྱོར་པ།",
    "དུས་ཀྱི་ཀུན་སློང་དུ་གྱུར་པའི་མ་རིག་པ་གཉིས་ཡོད་པ་གང་ཞིག་དུས་ཀྱི་ཀུན་སློང་དུ་གྱུར་པའི་མ་རིག་པ་ཡིན་ན།",
    "དེའི་ས་མཚམས་ལས་གསོག་དུས་ནས།",
    "ཁོ་རང་དུ་རྒྱུར་པའི་འདོད་པ་ཉེ་བར་ལེན་པ།",
    "འཕེན་བྱེད་ཀྱི་ལས་དེས་ཀྱང་རང་ཉིད་ཀྱིས་ཕྱུང་ཟིན་པའི་འཕངས་འབྲས་ཏེ།",
    "སྡུག་བདེན་མི་རྟག་པ་རྟོགས་པའི་གཞི་ཤེས་ཀྱི་རྣམ་པ་ལ་གཞི་ཤེས་ཁོ་རང་འཇོག་པ་གང་ཞིག་དེའི་དོན་རྣམ་ལ་སྡུག་བདེན་མི་རྟག་པ་འཇོག་དགོས་པའི་ཕྱིར།",
    "བདེ་བའི་སྐབས་སྐད་ཅིག་ཀྱང་མི་འདུག་སྟེ།",
    "སྔར་བདག་མེད་སྒྲུབ་པའི་རྟགས་སུ་བཀོད་པའི་ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཐ་དད་ཀྱིས་སྟོང་བ་ནི།",
    "ག་མཐའ་སྐྱོར་མ་དང་བང་ལེན་མ་སོགས་ཀྱི་བརྩི་ཚུལ་གང་ཡིན་པ་དང་རང་ལུགས་ལ་གང་གཙོ་ཆེ་བ་ལགས།",
    "དེས་ན་རང་ལུགས་ལ་སྦྱོར་བའི་མཉམ་ཉིད་ལ་སྦྱོར་བ་རང་རང་འཇོག་པ་ཡིན་ཏེ།",
