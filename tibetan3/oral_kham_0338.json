    "ཕས་རྒོལ་འཇོམས་ལ་རྩོད་མཁས་ཕྱོགསཾ་གླང་རང་།",
    "བྷོབཟློག་དུས་ལ་བབ་པོ་ས་མཱ་ཡ།",
    "ལོ་ཟླ་ཞག་དུས་ལྷ་རྣམས་དང་།",
    "ཁྲོ་ཆུ་དག་ཀྱང་རང་བཞིན་བྱེར།",
    "ཆུ་ཡང་རང་བཞིན་སྐེམ་པར་འགྱུར།",
    "བྱིན་པ་གཉིས་ཅུང་ཟད་བསྣོལ་ཏེ་ཙོག་པུའི་ཚུལ་དུ་འདུག་པའམ།",
    "སྡོམ་པ་གསུམ་དང་འགལ་བའི་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་།",
    "གཙོ་བོའི་ཐུགས་ཀ་དང་རང་ཡི་དམ་དུ་གསལ་བའི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་འཕྲོས།",
    "སྡོམ་པ་གསུམ་དང་འགལ་བའི་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་།",
    "ཨཱ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་།",
    "ཁ་བལྟ་ཕྱོགས་ལྷོ་ནས་བྱང་དུ་ཕྱོགས་པར་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འཁོད་དེ།",
    "ཐབ་ཀྱི་མེ་མཚམས་ཀྱི་འདུག་ཁ་ཁྱེར་གྱི་ཀུ་ཤའི་གདན་ལ་བཞུགས་པར་གྱུར།",
    "གཙོ་བོའི་ཐུགས་ཀ་དང་རང་ཡི་དམ་དུ་གསལ་བའི་ཐུགསཀོའི་ས་བོན་ལས་འོད་ཟེར་འཕྲོས།",
    "གཙོ་བོའི་ཐུགས་ཀ་དང་རང་ཡི་དམ་དུ་གསལ་བའི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་འཕྲོས།",
    "ལོ་ཟླ་ཞག་དུས་ལྷ་རྣམས་དང་།",
    "གཙོ་བོའི་ཐུགས་ཀ་དང་རང་ཡི་དམ་དུ་གསལ་བའི་ཐུགས་ཀའི་ས་བོན་ལས་འོད་ཟེར་འཕྲོས།",
    "གནའ་བོའི་ཀེ་རི་སེའི་ལྷ་སྒྲུང་དང་ཡང་སྦྲེལ་འདུག་དམངས་ཁྲོད་སྒྲུང་པ་སོགས་ཀྱི་ངག་ལ་བརྟེན་ནས་མི་རབས་ནས་མི་རབས་སུ་རྒྱུན་ཁམས་བསྲིངས།",
    "གཏམ་རྒྱུད་ལ་ལ་ཞིག་དུས་རབས་དྲུག་པའི་བར་དུ་ཁུངས་དེད་ཆོག་ལ།",
    "ཁྲུང་ཁྲུང་བརྗོད་བྱ་གཞན་ལྷའི་སྒྲོན་མེ་དང་ཨ་ལེ་པ་པ་དང་ཇག་རྐུན་བཞི་ཕོ་མི་སྣ་གྲགས་ཅན་གཞན་འགའ་བརྗོད་གཞིར་གྱུར་འདུག་པའི་ངག་རྒྱུན་ཡིན།",
    "ཇག་པ་རྣམས་ཕྱིར་འོངས་ཏེ་ཁོ་རང་དམར་གསོད་བྱས།",
    "ཨ་ལེ་པ་པས་ཕུ་བོའི་བེམ་པོ་ཕྱིར་རང་ཡུལ་དུ་བསྐྱལ་པ་ཇག་པ་རྣམས་ཀྱིས་ཤེས་ཏེ་མི་མངགས་ཏེ་ཨ་ལེ་པ་པའི་འདུག་གནས་བཙལ།",
    "ཐོག་སོ་རིམ་པ་དྲུག་པའི་ནང་ཟས་ལ་རྔམ་པ་རྣམས་ཀྱི་མདུན་དུ་རོ་བརྒྱའི་ཟས་སྣ་བྱུར་བུར་མངོན་ཡང་འཁྲུལ་སྣང་དུ་གྱུར་འདུག་དག་ཞིང་རི་བོའི་རྩེ་ཡི་ས་སྟེང་སྐྱིད་གླིང་དུ་བེ་ཅི་ཨར་ཡལ་ཞིང་འཕགས་མ་པེ་ཡ་ཐིག་ལེ་སི་མངོན་བྱུང་།",
    "བར་སྐབས་དེར་ཁོང་རང་ལ་མ་ཉེས་ཁག་གཡོགས་ཐེབས་ཏེ་ཐེངས་གཉིས་ལ་བཙོན་འཇུག་བྱས།",
    "ཁོ་རང་དེ་མ་ཉིད་དུ་དེའི་སྟེང་མཆོངས་ནས་བྱིས་པ་ཐང་ལ་བླངས།",
    "མཐར་ཐང་ཅི་ཁི་ཏིག་ཟླ་དཀར་རྟ་པ་རུ་བརྫུས་པའི་ཁ་ལ་སི་ཁི་དང་ཕྲད་དེ་འཐབ་པ་ན་དེས་ཁོ་རང་ཕམ་པར་བརྒྱབ།",
    "ཧྲ་ཧྲི་པི་ཡ་ལོ་ནས་ལོའི་བར་ནི་དུས་རབས་བཅུ་དྲུག་པའི་མཇུག་དང་དུས་རབས་བཅུ་བདུན་པའི་མགོར་དབྱིན་ཇིའི་རྩོམ་པ་པོ་ཀུན་གྱི་ཏོག་ཏུ་གྱུར་འདུག་པར་མ་ཟད།",
    "གསར་རྩོམ་སྤྱིའི་སེམས་འགྱུ་ནི་སྤྲོ་བས་བཏེགས་འདུག་པ་ཞིག་གོ།",
    "དུས་སྐབས་དེར་བརྩམས་ཤིང་ཀུན་ལ་ཆ་ཡོད་དུ་གྱུར་འདུག་པ་ནི་ལི་ཕྲ་སྐུ་རབས་གསུམ་པ་དང་ལོ་མུས་འུག་དང་ཀྲའོ་ལེ་ཡུ་བེ་ཉི་སེའི་ཚོང་པ་སོགས་ཡིན།",
    "འདི་ལྟ་བུའི་སྐད་བརྡའི་ཁྲོད་གཏིང་མི་ལོན་པའི་གནས་ལུགས་ཀྱིས་ཕྱུག་འདུག་པ་ཞིག་ཀྱང་ཡིན།",
    "རཱ་པིན་ཟུན་གླིང་ཕྲན་དེའི་སྟེང་རང་ཁོ་ན་ལོ་ངོ་བཅུ་བདུན་འགོར་བའི་ཉིན་ཞིག་ལ་ཁོས་མཚོ་འགྲམ་དུ་མིའི་རུས་ཀྱིས་བཀང་འདུག་པ་དང་མེ་བུས་པའི་ཤུལ་ཡོད་པ་མཐོང་།",
    "ཚུལ་དེ་མཐོང་ནས་ཁོ་རང་སྔངས་ཤིང་སྐྲག་དེ་ནས་བཟུང་ཁོས་དུས་རྒྱུན་དོགས་ཟོན་བྱས་བྱས་ལ་བསྡད་པ་ལས་གཞན།",
    "ལམ་བར་དུ་ཁོ་རང་མི་ཚེ་ཕྱེད་ཀ་ཙམ་ལ་བསྡད་མྱོང་བའི་གླིང་ཕྲན་དེ་བརྒྱུད་སྐབས་དེར་ཡོད་པའི་གྲུ་པ་དེ་དག་དང་སི་ཕེན་པ་དེ་རྣམས་ཀྱིས་ཀྱང་གཞིས་བཏབ་ནས་འཚོ་བ་རོལ་བཞིན་ཡོད།",
    "དེ་གའི་གཞིས་ཀ་རུ་ཁོས་སྨྱོས་འདུག་པའི་ཞིང་པའི་ན་ཆུང་མཛེས་མ་ཞིག་དང་ལུས་ཡོངས་མཚོན་བཏབ་པའི་ཕོ་གསར་རྨས་མ་གཉིས་ཀྱི་ཡ་ང་བའི་ཤི་སྟངས་དེ་མཐོང་བར་མ་ཟད།",
    "ཅན་ཨའེ་ཡིས་ང་རང་སེམས་འགུལ་ཐེབས་སུ་བཅུག་ངའི་ཚབ་བྱས་ནས་རྩོམ་མཁན་ལ་གུས་འདུད་བྱེད་རོགས།",
    "འོན་ཀྱང་ནམ་ཡིན་ཡང་སྡུག་བསྔལ་དུ་བྱིང་འདུག་དུས་རྒྱུན་མུ་རུ་སྦྲེལ་ནས་དཀའ་ངལ་ལ་ཕྲད་ཀྱིན་ཡོད་ལ་དེ་དང་བསྟུན་ནས་ནོར་འཁྲུལ་ཡང་བཟོ་བཞིན་ཡོད།",
    "ངས་ད་དུང་རང་ལ་ཅུང་ཟད་ལྷག་འདུག་པའི་ཚེ་བསོད་ཡོད་ཚད་བཀོལ་ནས་ཀླད་པ་དར་བ་དཀྲུག་དཀྲུག་བྱས་ཏེ་བྱ་བ་འདི་སྒྲུབ་ངེས་ཡིན།",
    "རྩོམ་མཁན་རང་འོད་སྟོང་འབར་བའི་འབྱུང་འགྱུར་ལ་ཡིད་ཆེས་ཀྱིས་ཁེངས་ཡོད་པའང་བསྟན་འདུག་ལོ་ནས་ལོའི་བར་གྱི་ཨུ་རུ་སུའི་གསར་བརྗེ་སྐབས་དང་པོའི་སྐབས།",
    "རྐྱེན་དེས་རྨོ་བོས་ཁོ་རང་བརྒྱལ་རག་བར་གཅར་རྡུང་བྱས་པས་ཁོར་ན་ཚ་ཚབས་ཆེན་ཞིག་བྱུང་།",
    "ཅང་མ་འགོར་བར་མ་ཐིག་ཨར་གྱིས་རང་ལ་མངལ་ཆགས་འདུག་པ་ཤེས།",
    "འོན་ཀྱང་ཁོ་རང་སེམས་འགུལ་མ་ཐེབས།",
    "ལྷག་དོན་ཁུར་བོར་གྱུར་འདུག་པའི་ཁྲ་ལིར་དེ་བས་ཀྱང་ཁ་ཡ་བྱས་ན་མི་འདོད།",
    "སྟོང་སེམས་བཅངས་འདུག་ཁྲ་ལིས་ཨོའུ་ཡེ་ཉིར་རྒྱུ་ནོར་དེ་འདྲའི་མང་བོ་ཞིག་ཡོད་པ་ཤེས་རོགས་རམ་བྱས་ནས་གཞན་ལ་དོམ་བྱས་ཡོད་པ་རྣམས་སེལ།",
