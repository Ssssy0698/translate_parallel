    "གཉན་རིམས་ནག་པོ་སུམ་འདྲིལ་ནི་དུག་འཁྲུགས་ཏྲེ་ཏྲེ་ཧོ་ལྟ་བུ་བཅས་ཕན་ཚུན་མ་འདྲེས་པར་ཕྱེ་ཤེས་དགོས།",
    "ལྕེ་སྟེང་དུ་ཐོར་པ་ཆེ་ཙམ་ཡོད་ན་ལྕེ་བཞར་གྱིས་བཞར་ནས་ཁྲག་མིད་པར་མི་འགྲོ་བར་བྱ།",
    "ཁྱད་པར་རྐེད་པ་རུས་ཚིགས་བཞི་པོ་ན།",
    "ཁྱད་པར་རྩ་ལྤགས་ཆུ་རྒྱུས་རུས་པ་དང་།",
    "འདྲིལ་བའི་སྐྲན་རྣམས་མ་ལུས་བཤིགས་པར་བྱེད།",
    "༣ ཀྱི་ལྕེ་གསུམ་པའི་བཅིང་ལུམས་བྱས་པ་ཡིས།",
    "ན་ཟུག་གཅོག་ཅིང་རྨ་རྣམས་སོས་པར་འགྱུར།",
    "སྦྱར་ཞིང་བྱུགས་པས་རྨ་རྙིང་སོས་པར་འགྱུར།",
    "དང་པོར་མིང་རྣམས་ཐོས་པར་བྱ།",
    "དེ་རྗེས་ལྟ་ཞིང་ལེགས་པར་བརྟག།",
    "ཡང་དང་ཡང་དུ་འདྲིས་པར་བྱ།",
    "བསྡུས་པའི་མིང་ཡང་ཤེས་པར་བྱ།",
    "སྟོན་དུས་སྐར་མ་རི་ཥི་ཤར་བའི་དུས་སུ་ལྷག་པར་བཏུ་དགོས་པ་དང་།",
    "ཤིར་ཁན་ཁྲོལ་བུ་བྱས་ཏེ་མར་ཁུའི་ནང་དུ་བཙོས།",
    "རྣོ་འདོན་རྩང་གཡེར་ཚ་འདེབས་ཙམ་བསྲེས་གསུངས།",
    "༣སྲམ་ཤ་མ་རུལ་མ་སུངས་བ་གནས་གཙང་སར་བསིལ་བར་བསྐམས་ནས་གླ་རྩི་དྲི་ཐོན་ཙམ་གྱི་ནང་དུ་ཞག་གཅིག་སྦངས།",
    "མངོན་མཁྱེན་ཅན་ལས་སོ་སྐྱེའི་སྤྱོད་ཡུལ་མིན།",
    "མངོན་ཤེས་ལྡན་པས་བྱས་པ་ཡི།",
    "རིགས་པས་མི་ཆོད་མཁས་པས་གསུངས།",
    "བར་སྣང་ཁམས་ནས་བ་སྤུ་སྣ་སྒོར་འཇུག་ཅེས་གསུངས་པ་ལྟར་ཡིན་པས།",
    "དེ་གཉིས་སོ་སོར་ཞིབ་པར་བཏུལ་ལ་དར་ཚགས་སུ་དྲངས།",
    "སྟོབས་དང་བཀྲག་མདངས་རྒྱས་པར་འགྱུར་བ་སོགས་ཀྱི་ཡོན་ཏན་དུ་མ་དང་ལྡན་ནོ།",
    "རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མས་རྗེས་སུ་བཟུང་ནས་དངུལ་ཆུ་གྲུབ་པའི་གདམས་པ་ཉེ་བརྒྱུད་དུ་གནང་བ་མ་ཉམས་པར་གནས་ཡོད་པ་དེ་ལས་རིམ་བཞིན་བརྒྱུད་པ།",
    "གཉིས་པ་བཙོ་བཀྲུའི་ལག་ལེན་རིམ་པར་བརྒྱུད་ཚུལ།",
    "དེ་ལས་ཅུང་ཟད་མཐོ་ན་ལེགས་གསུངས།",
    "ལྕགས་བརྒྱད་ངོས་འཛིན་པར་བྱེད་པ་ལ།",
    "གསེར་གཞན་ཆགས་པ་གསེར་དམར་ཡིན་པར་གྲགས།",
    "ཁམས་བརྒྱད་ངོས་འཛིན་པར་བྱེད་པ་ལ།",
    "འབྲིང་འོད་དང་ལྡན་པ་ཁ་དོག་ལྗང་འོད་ཅུང་ཟད་ཡོད་པ་གསེར་གཤོག་ལྟར་རིམ་པར་བརྩེགས་ནས་ཕྱེ་རྒྱུ་ཡོད་པ་དེ་གཉིས་གང་རུང་།",
    "དྭངས་ལ་དཀར་ཤས་ཆེ་བ་ཞིག་མ་བྱུང་བར་དུ་གཡའ་དུག་ལེགས་པར་འདོན་དགོས།",
    "སྲུབས་མཚམས་རྣམས་སུ་ཚྭ་འདམ་གྱིས་ལེགས་པར་བྱུགས་ནས་ཉི་མར་བསྐམས།",
    "སླར་ཡང་དེ་ལྟར་བཙོ་བཀྲུ་ཐེངས་གསུམ་བྱས།",
    "སླར་ཡང་དེ་ལྟར་ཐེངས་གསུམ་བྱས།",
    "གསུམ་པ་སྲེག་རྫས་བྱུག་ཚུལ་ཞ་གཤོག་གཡའ་བྲལ་རྒྱ་མ་༡སྲང་༥ལ་རང་མཉམ་གྱི་ལྡོང་རོས་རྒྱ་མ་༡སྲང་༥ ཉིས་འགྱུར་གྱི་མུ་ཟི་དུག་མ་ཕྲལ་བ་རྒྱ་མ་༣ཞིབ་པར་བཏུལ་བའི་ཕྱེ་མར་ར་འོས་སྐྱོ་མ་བྱས་ལ།",
    "རང་མཉམ་ཨ་རུ་ཤའི་ཕྱེ་མ་སྲང་༥ཉིས་འགྱུར་ཚ་ལ་ཆུ་མ་བཅད་པའི་ཕྱེ་མ་རྒྱ་མ་༡སུམ་འགྱུར་གྱི་མུ་ཟི་རྒྱ་༡སྲང་༥ལྕགས་ཕྱེ་མཉམ་པོར་བ་ཆུའི་ནང་དུ་འདམ་འཐག་ཡུད་ཙམ་བྱས་ཏེ་མཐེབ་ཀྱུ་མང་དུ་བྱས་ནས་ཉི་མར་བསྐམས།",
    "རས་ཚགས་སུ་དྲངས་ཏེ་བཀྲུ་བཤལ་ལེགས་པར་བྱས་པ་དེ་ལྟར་བཙོ་བཀྲུ་ཐེངས་༣བར་དུ་བྱ།",
    "དེ་ལྟར་བཙོ་བཀྲུ་ཐེངས་བཞི་བྱས་རྗེས་ཉི་མར་བསྐམས།",
    "ཆུ་སྐྱུར་རྡོ་ལྔ་པོ་སོ་སོར་སྲན་ཆུང་ཙམ་ཁྲོབ་བརྡུངས་བྱས་ནས་སོ་སོར་འཇོག་༢ པ་བླ་དང་།",
    "དེ་ཞིབ་པར་བཏུལ་ལ་ཚགས་སུ་དྲངས་ནས་བཞག་གོ།",
    "འདིར་སྔོ་བོང་དཀར་ཕྱེ་མ་རྒྱ་མ་༡བཅས་བསྲེས་རྗེས་མཚུར་གཉིས་ཀྱི་གྲུངས་ཆུས་སྐྱོ་མ་ཞོ་ཙམ་བྱས་ལ་དེའི་ནང་དུ་སྣུམ་ནག་སྲང་༢བླུགས་ཏེ་རྡོ་གཞོང་དུ་འདམ་འཐག་ཉིན་༣བྱ།",
    "སྐམ་ཞད་ཡོད་ཚེ་ར་གཅིན་དང་དར་བ་རན་པར་སབ་ལ་ཆུ་ཚོད་༡༢བར་ཐང་ལྷོད་མེད་པར་འཕུར་མཉེ་བྱ།",
    "དེ་ནས་གྲིབ་སྐམ་བྱས་པ་ཞིབ་བཏགས་ཚགས་སུ་དྲངས།",
    "སྲེག་སྣོད་གྲང་རྗེས་ཞིབ་པར་བཏུལ་ལ་སྣོད་གཙང་ནང་དུ་བླུགས་སོ།",
    "མི་གྲངས་ཉི་ཤུ་བཞུགས་སའི་རྐུབ་སྟེགས་དང་དངུལ་ཆུ་བསྙལ་བྱེད་ཀྱི་གདན་ཁེབས།",
    "གྲངས་ཉི་ཤུ་བཞུགས་སའི་གདན།",
    "ཉིན་བཅུ་གསུམ་པར་དགོས་པའི་རྒྱ་མ་༡བཅས་ཞིབ་པར་བཏུལ།",
    "ཉིན་བཅུ་བཞི་པར་ཡང་རྒྱ་མ་༡ཙམ་དང་།",
    "ཉིན་བཅོ་ལྔ་པར་དགོས་པའི་རྫ་གསར་ལོངས་མ་སྤྱོད་པ་ཞིབ་བཏུལ་བྱས་ནས་དར་ཚགས་སུ་དྲངས་པ་རྒྱ་མ་དྲུག་ཙམ།",
    "ཉིན་བཅོ་བརྒྱད་པར་དགོས་པའི་སྒོག་སྐྱ་སྐམ་རློན་ཤུན་པ་ཕྲལ་བ་རྒྱ་མ་༣ཙམ།",
    "ཉིན་ཉེར་དགུ་བར་དགོས་པའི་བཙན་དུག་རྒྱ་ཕྱེད་ཙམ་ཞིབ་པར་བཏུལ་ནས་དར་ཚགས་སུ་དྲངས།",
    "དེ་ཆང་སྐྱུར་གྱིས་འདམ་ཐག་ནས་འཕང་ལོ་བྱས་ཏེ་ཉི་མར་བསྐམས།",
    "ཉིན་སོ་གཉིས་པར་མུ་ཟི་དཀར་སེར་གང་རུང་དྭངས་ཤིང་ལྷད་མེད་པར་ཁྲམ་ཁྲུམ་དུ་བརྡུངས་པ་རྒྱ་མ་༡ལྷག་ཤུ་དག་དཀར་པོ་དང་རམ་རྩ་གཉིས་བཙོས་པའི་ཁུ་བའི་ནང་དུ་ཞག་གསུམ་བསྙལ་རྗེས་ལྷོག་ཅིག་བསྐོལ་ནས་ཁུ་བ་ཕྱིར་དོར།",
