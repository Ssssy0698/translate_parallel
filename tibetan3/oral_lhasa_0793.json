    "བྱ་བ་ངན་ཞེན་གྱི་ལེ་ལོ་སྤོང་བ་ལ་སྒྲུབ་པ་ཁྱད་པར་སོགས་སོ།",
    "སྤྱིའི་རྣམ་པར་བཞག་པ།",
    "སྦྱོར་བ་བར་ཆད་མེད་པ་རྣམ་གྲོལ་ལམ་ཁྱད་པར་ལམ་གང་ལ་བྱེད་ཀྱང་དེ་དག་རིམ་ཅན་དུ་སྐྱེ་བ་མ་གཏོགས་པ་ཅིག་ཅར་དུ་སྐྱེ་བ་ག་ལ་སྲིད།",
    "སྤང་བྱ་ཅིག་ཅར་བའི་ཟླས་དྲངས་པའི་སྤང་བྱ་རིམ་གྱིས་པ་གཉིས་ཞེས་པར་བྱ་ལ་འདིར་ནི་འབྲས་བུ་མཐར་གྱིས་པ་ཞེས་བྱ་སྟེ།",
    "འདི་ལ་འབྲས་བུ་སྔ་མ་དོར་ནས་ཕྱི་མ་མངོན་དུ་བྱས་པ་དགོས་ན་རྒྱུན་ཞུགས་ཀྱི་སྔོན་དུ་འབྲས་བུ་མི་སྲིད་པས་སོ།",
    "དེ་ལ་སྒོམ་སྤང་གཅིག་ནས་ལྔའི་བར་སྤངས་པ་ཡོད་ཀྱང་དེའི་སྤང་བྱའི་གཙོ་བོ་མཐོང་སྤང་ཡིན་ལ་དེ་མཐོང་ལམ་གྱི་སྔོན་དུ་རྫོགས་པར་སྤང་མི་ནུས་ཏེ།",
    "རྒྱུན་ཞུགས་ཞུགས་པ་གཉིས་རྟོགས་པ་མཚུངས་པ་དང་འབྲས་གནས་གསུམ་ཡང་དང་པོར་ཐོབ་པའི་དུས་བཅུ་དྲུག་པ་ཐོབ་པ་དང་དུས་མཉམ་དུ་མཚུངས་པ་ལ་དགོངས་ནས་ཞར་བྱུང་དུ་གསུངས་པར་གོ་བར་བྱའོ།",
    "འདོད་པ་ལས་འདོད་ཆགས་དང་བྲལ་བ་ཡང་ཡིན་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་མཐར་གྱིས་པའི་ཕྱིར་མི་འོང་ཐོབ་པའི་ལམ་ཡང་རིག་པར་བྱའོ།",
    "བསམ་གཏན་དང་པོ་ནས་གོང་མ་ཅི་ཡང་མེད་པ་མན་ཆད་ལ་ཆགས་པ་དང་བྲལ་བའམ་མ་བྲལ་ཡང་རུང་བའི་སྤངས་པ་དང་རྟོགས་པའི་ཁྱད་པར་སྔ་མ་ལྟ་བུ་དང་ལྡན་པ་སྟེ།",
    "བཅུ་དྲུག་པའི་ཚེ་ན་འབྲས་བུ་ཙམ་ལ་གནས་ཀྱི་འབྲས་བུ་ཁྱད་པར་ཅན་དུ་བྱེད་པའི་ལམ་ལ་མ་ཞུགས་པའི་ཕྱིར་འབྲས་བུ་ཕྱི་མའི་ཞུགས་པ་ཞེས་མི་བྱའོ།",
    "འབྲས་ཐོབ་འབྲས་བུ་ཁྱད་པར་གྱི།",
    "འབྲས་གནས་ཁྱད་པར་བྱ་བའི་ཕྱིར།",
    "ཁ་ཅིག་ཐོད་རྒལ་བའི་འབྲས་གནས་ལ་བཅུ་དྲུག་པའི་རྟོགས་པ་ལ་གནས་བཞིན་པས་ཁྱབ་པས་འབྲས་གནས་ཙམ་པོ་ཁོ་ན་ཡིན་ལ་ཁྱད་པར་ཅན་མེད་ཟེར་རོ།",
    "དེའི་ཞུགས་པ་མཐོང་ལམ་པར་ངེས་པ་དང་དེས་ཐོབ་པའི་འབྲས་གནས་ཐོད་རྒལ་བར་འགལ་བས་སོ།",
    "འབྲས་བུ་དེ་གཉིས་བཅུ་དྲུག་པ་དང་དུས་མཉམ་དུ་མངོན་དུ་བྱས་པའི་ཕྱིར་རོ།",
    "དང་པོའི་མཚམས་སྦྱོར་ལམ་ནས་འཛིན་པར་ཀུན་ལས་བཏུས་པ་འདོད་དེ།",
    "གང་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ལ་མཐོང་བའི་ལམ་གྱི་སེམས་ཀྱི་སྐད་ཅིག་བཅོ་ལྔ་ལ་གནས་པའི་གང་ཟག་གོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་སྟན་གཅིག་པ་ནས་བཟུང་སྟེ་དང་པོའི་འབྲས་བུ་མ་ཐོབ་པའི་བར་དུའོ།",
    "འདི་ལ་ཡང་ཁྱད་པར་གསུམ་སྟེ།",
    "སྐྱེ་བའི་ཁྱད་པར་རོ།",
    "འདོད་པར་སྐྱེ་བ་བདུན་ལེན་པའོ།",
    "ཁྱད་པར་གསུམ་དང་ལྡན་པ་སྟེ།",
    "འདོད་པའི་ལྷ་མི་རིགས་མཐུན་གཅིག་ཏུ་སྐྱེ་བ་གཉིས་སམ་གསུམ་ལེན་པ་སྐྱེ་བའི་ཁྱད་པར་ཏེ།",
    "སྔོན་རྣམ་པ་གསུམ་དང་བཞི་པ་སྤངས་པའམ་༡ བདུན་དང་བརྒྱད་སྤངས་པ་འབྲས་བུ་ཐོབ་པ་ནི་ཇི་སྲིད་དུ་འབྲས་བུ་ཁྱད་པར་ཅན་གྱི་ལམ་མངོན་དུ་མ་བྱས་པ་དེ་སྲིད་དུ་རིགས་ནས་རིགས་སུ་སྐྱེ་བའམ་བར་ཆད་གཅིག་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་དྲུག་པ་སྤངས་པའི་རྣམ་གྲོལ་ལམ་ལ་གནས་བཞིན་པ་ན་འབྲས་གནས་ཙམ་པོ་དང་དགུ་པའི་བར་སྤོང་བ་ལ་བརྩོན་པ་ན་ཁྱད་པར་ཅན་ནོ།",
    "དེ་ལ་ཡང་འབྲས་བུ་ཙམ་དང་ཁྱད་པར་ཅན་ལ་གནས་པ་གཉིས་སོ།",
    "དེ་གསུམ་ག་སྐྱེས་འདའ་བ་ཡིན་པར་རང་འགྲེལ་ལས།",
    "གནས་གཙང་ལྔར་སྐྱེ་བའི་སྐྱེས་འདའ་བ་ནི་སྤེལ་མ་རྣམས་སྒོམ་དགོས་སོ།",
    "ཕྱེད་དུ་འཕར་བ་ནི་སྔར་ལྟར་ཚངས་རིས་སུ་སྐྱེས་ནས་བར་པ་རྣམས་དོར་ཏེ་གནས་གཙང་རྣམས་སུ་སྐྱེས་ནས་གནས་གཞན་འགའ་ཞིག་བོར་ཏེ་འོག་མིན་དུ་འདའ་བའོ།",
    "ས་ཐོབ་པའི་བྱང་སེམས་ཀྱི་རྣམ་སྨིན་གྱི་སྐྱེ་བ་འཆད་པར་འགྱུར་བས་ཤེས་སོ།",
    "འདི་དག་གནས་གཙང་དུ་སྐྱེ་བའི་རྒྱུ་སྤེལ་མ་སྒོམ་ཚུལ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དེའི་ཕྱིར་རྒྱུན་ཆགས་གསུམ་ལ་ཇི་སྲིད་འདོད་པར་སྙོམས་པར་འཇུག་པའི་སྒོ་ནས་རྫོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་བལྟའོ་ཞེས་པ་ལྟར་རོ།",
    "ལྔ་པ་ལ་ནི་བཅོ་ལྔ་སྟེ་ཞེས་པ་ཙམ་ལས་མ་གསུངས་སོ།",
    "ཞེས་གསུངས་ཤིང་གང་སྤེལ་ལས་ཀྱང་ངོ།",
    "འོ་ན་ལྷག་མ་རྣམས་ལ་ཡང་གསུམ་སྤེལ་དང་སྤེལ་ལུགས་ཁྱད་མེད་པའི་ཕྱིར་གསུམ་སྤེལ་ནུས་ན་ཐམས་ཅད་སྤེལ་ནུས་པར་འགྱུར་ཞེ་ན།",
    "དང་པོ་ལ་ནི་སེམས་གསུམ་ཞེས་བྱ་བ་ནི་གང་ཟག་དེ་ལ་ནུས་པ་དེ་ཙམ་ཞིག་ཡོད་པ་སྟེ་དེ་བཞིན་དུ་འོག་མ་རྣམས་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་གནས་གཙང་དུ་སྐྱེ་བའི་རྒྱུ་ནི་ཟག་བཅས་ཡིན་ཏེ།",
    "ས་གོང་འོག་ལ་ཞི་རགས་སུ་ལྟ་བ་ནི་འོག་ས་ལས་རྒྱལ་བའི་ལམ་ཡིན་ལ་དངོས་གཞི་ཟག་བཅས་ནི་སྤོང་ལམ་ཡིན་པར་འགལ་བའི་ཕྱིར་ཏེ།",
    "སྙོམས་འཇུག་རྣམས་ཀྱི་རོ་མྱངས་ཏེ་འབྲས་བུ་ཆེའི་བར་དུ་སྐྱེ་ཞིང་གནས་གཙང་བོར་ཏེ་གཟུགས་མེད་དུ་རིམ་གྱིས་སྐྱེས་ནས་སྲིད་རྩེར་འདའ་བའོ།",
    "འཕར་གསུམ་ལ་རིམ་པ་ལྟར་གཟུགས་ཀྱི་སྐྱེ་སྲིད་དུ་སྐྱེ་བ་གཉིས་དང་གསུམ་དང་བཞི་བླངས་ནས་གནས་གཙང་དང་།",
    "སྲིད་རྩེར་འགྲོ་ནི་སྲིད་རྩེར་མ་ངེས་ཀྱང་གཟུགས་མེད་ཀྱི་རྟེན་ལ་འདའ་དགོས་པར་སེམས་སོ།",
    "དབྱེ་བ་དེ་དག་ཕྱིར་མི་འོང་འདོད་པར་ཚེ་གྱུར་ལའང་རུང་ངམ་ཞེ་ན།",
