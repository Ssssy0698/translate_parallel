    "མོས་པར་འདོད་པས་མི་བསླབ་པའི་ཚུལ་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་བསླབ་པར་བྱའོ་ དེ་ནས་བཅོམ་ལྡན་འདས་ལ་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཀོད་པ་གཅིག་པའི་ཏིང་ངེ་འཛིན་ལ་འཇུག་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཐོག་མ་ཉིད་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་དྲི་བ་བྱ་དགོས་ཏེ།",
    "བཀོད་པ་གཅིག་པའི་ཏིང་ངེ་འཛིན་ལ་འཇུག་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་དབེན་པའི་མལ་སྟན་རྣམས་བསྟེན་པར་བྱ།",
    "འདུ་འཛི་མེད་པ་ལ་དགའ་བར་བྱས་ལ་མཚན་མ་ཐམས་ཅད་ཡིད་ལ་མི་བྱ་བར་སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ་འདུག་ནས།",
    "དངོས་པོར་ལྟ་བ་ཅན་དག་ནས་ཡོད་པར་ལྟ་བ་ཅན་དག་གི་བར་གྱིས་བསྒྲུབ་པར་མི་ནུས་སོ།",
    "མི་གཞན་ཞིག་གིས་དེར་མི་དེ་ལ་འདི་སྐད་དུ།",
    "གང་དང་གང་གི་ཚེ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཏིང་ངེ་འཛིན་འདི་ལ་མཉམ་པར་འཇོག་པ་དང་།",
    "ཉི་མའི་དཀྱིལ་འཁོར་གྱི་འོད་ཟེར་དག་གིས་སའི་དཀྱིལ་འཁོར་གྱི་མཐའ་གང་ཡང་མ་ཁྱབ་པ་མེད་དོ།",
    "ཏིང་ངེ་འཛིན་འདི་ཐོབ་ནས་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་འདོད་ན།",
    "དེ་ལྟར་ན་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་ཏིང་ངེ་འཛིན་འདི་ཐོབ་ནས།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས་བསྟན་པ་འདི་ཐོས་ནས་རྨོངས་པར་མི་འགྱུར་བ་དང་།",
    "དེ་དག་གི་སྟོན་པ་ནི་ང་ཡིན་ནོ།",
    "གང་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཐོས་ཏེ།",
    "དེ་ལ་འདི་སྐད་ཅེས་རིགས་ཀྱི་བུ་ཁྱོད་མཉན་པས་ཅི་ཞིག་བྱ།",
    "ཐོས་ནས་མ་དད་ཅིང་ཕྱིར་ནུར་ཏ་རེ།",
    "དེ་སྐད་འདྲི་ན་བདག་གིས་དེ་སྐད་ཅེས་བགྱིའོ།",
    "གཞན་ཡང་བདག་ལས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཉན་པར་འཚལ་ཏེ།",
    "དེང་ཁྱོད་། བཅོམ་ལྡན་འདས་དང་གཏམ་ཅི་ཞིག་བྱས་ཞེས་འདྲི་ན།",
    "དེ་ལ་བདག་གིས་འདི་སྐད་དུ་གལ་ཏེ་ཁྱོད་དེ་ཉན་པར་འདོད་ན་དེ་མཉན་ཏོ་སྙམ་དུ་ཡིད་ལ་མ་གཏོད།",
    "འདི་ན་དེ་ལ་བདག་གིས་དེ་སྐད་བརྗོད་པར་བགྱིའོ།",
    "གལ་ཏེ་འདྲི་བའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་ལྟར་གནས་ཤིང་།",
    "འཇམ་དཔལ་ཁྱོད་ཀྱིས་འདི་ལེགས་པར་སྨྲས་པ་ལེགས་སོ།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་ལ་ཡང་ཕྱིས་འདི་སྐད་ཅེས་གྱིས་ཤིག།",
    "དེ་བཞིན་གཤེགས་པ་ལ་བསྙེན་བཀུར་བྱ་བར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་བདག་གི་སྟོན་པའོ་ཞེས་སྨྲ་བར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་མཁས་པར་བསྒྲུབ་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་བར་དུ་བསྒྲུབ་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་དངོས་པོ་མེད་པའི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "བརྗོད་དུ་མེད་པ་ནི་ཡོད་པ་མ་ཡིན་ཞིང་དམིགས་སུ་མེད་དོ་ཞེས་དེ་ལྟར་ཤེས་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་དངོས་པོ་མེད་པའི་བར་གྱི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "ཡང་དེ་ལ་ཞུམ་པ་མེད་པར་འདོད་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་ལ་དངོས་པོ་མེད་པའི་བར་གྱི་ཚུལ་གྱིས་བསླབ་པར་བྱའོ།",
    "གང་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་མ་སྐྱེས་པ་དང་།",
    "ལྷའི་རོལ་མོའི་སྒྲ་དག་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ལ་ཡང་མཆོད་ཅིང་བཅོམ་ལྡན་འདས་དང་།",
    "བདག་གིས་ཀྱང་མ་བྱུང་བ་དང་།",
    "མ་སྐྱེས་པའི་བར་འདི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་འཛམ་བུའི་གླིང་འདིར་སྤྱོད་པར་འགྱུར་བ་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྟན་པ་འདི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གི་རྣ་ལམ་དུ་ཚེགས་ཆུང་ངུས་གྲགས་ལ།",
    "ཐོས་ནས་ཀྱང་མོས་པ་དང་།",
    "མོས་ནས་ཀྱང་འཛིན་པ་དང་།",
    "འཆང་བའི་བར་དུ་བགྱིས་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་གིས་བདག་ཅག་གི་འདི་ནི་ལྷས་བསྒྲུབས་པའོ།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་གི་དོན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྟན་པ་འདི་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ལྟས་འདི་དག་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྟན་པ་འདི་བྱིན་གྱིས་བརླབས་པ་ཤེས་པ་བྱའོ།",
    "ངེས་དོན་དཀྲུགས་པར་གྱུར་ཏ་རེ།",
    "གདམས་པ་སྣ་རེས་གང་ཟག་གྲོལ་བར་ངེས",
    "སྙིགས་དུས་གཏེར་ལ་མོས་པའི་སྐལ་ལྡན་རྣམས",
    "མཁར་ཆེན་གྲུབ་པའི་རྒྱལ་མོའི་གསུང་གི་སྤྲུལ་བ།",
    "མཚན་ཨ་བྷྱ་ཏཱ་རེ་ཐབས་ཤེས་ཟུང་",
    "གཏེར་གསར་རྙིང་གི་བསྟན་པ་ཕྱོགས་བཅུར་སྤེལ་ཞེས་གསུངས་པ་ལྟར།",
    "མཁར་ཆེན་ཛྙཱ་ན་སཱ་རའི་གསུང་གི་སྤྲུལ་པ།",
    "རྒྱལ་ཡུམ་ཕག་མོ་མཚོ་རྒྱལ་ཟུང་གི་སྤྲུལ",
    "ཞིང་འདིའི་འགྲོ་ངོར་མི་མོའི་ཚུལ་བཟུང་ནས།",
    "ཏཱ་རེ་དེ་ཝཱིའི་ཞབས་ལ་གསོལ་བ་འདེབས།",
    "སྐྱེ་དགུ་རྫོགས་ལྡན་གསར་བའི་དྲི་བསུང་གིས།",
    "༡ཕག་མོའི་གསང་སྒྲུབ་པདྨའི་རྒྱ་ཅན།་",
    "ཕག་མོའི་ཚོགས་མཆོད།",
    "༡༤ཕག་མོ་དཀར་མོའི་ཟབ་སྒྲུབ་བཀའ་རྒྱ་ཅན།་",
    "༢༣བདེ་སྟོང་རྫོགས་རིམ་ཟབ་མོ།",
    "༢༤ ཕག་མོའི་གསང་བའི་ཟབ་སྒྲུབ་བཀའ་རྒྱ་ཅན།་",
    "རྡོ་རྗེ་ཕག་མོའི་ཚོགས་མཆོད།་",
    "༣༡ཕག་མོའི་མེ་མཆོད།",
