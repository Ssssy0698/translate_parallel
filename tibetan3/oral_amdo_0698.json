    "ཚོར་བ་སྐྱེ་བའི་རྒྱུ་ལྟ་བུར་ཡོངས་སུ་འགྱུར་བའི་ཡུལ་གྱི་རྣམ་པ་ཇི་ལྟ་བུ་ཡིན་པས་གཅོད་པར་བྱེད་པ་ནི་རེག་པ་ཞེས་བྱའོ།",
    "དཔེར་ན་ཁབ་མི་གཡོ་ཞིང་བྱེད་པ་མེད་མོད་ཀྱི།",
    "མོས་པ་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "མོས་པའི་རང་བཞིན་དང་།",
    "མོས་ཉུ་༡པའི་ཡུལ་ནི་ངེས་པའི་དངོས་པོ་ཁོ་ན་ཡིན་ཀྱི།",
    "མ་ངེས་པའི་དངོས་པོ་ལ་མོས་པ་མི་འཇུག་པས་ན་ཡུལ་ངེས་པར་བསྟན་ཏོ།",
    "དེ་ལ་མོས་པ་ཞེས་བྱའོ།",
    "རང་གི་ལྟ་བ་ལས་མུ་སྟེགས་ཅན་ལ་སོགས་པ་རྒོལ་བ་གཞན་ཀྱིས་ལྟ་བ་གཞན་དུ་བསྒྱུར་སྙེབར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དྲན་པ་ཡང་འདྲིས་པའི་དངོས་པོ་ལ་སེམས་མ་བརྗེད་པར་འབྱུང་གི་མ་འདྲིས་པའི་དངོས་པོ་ལ།",
    "སྡུག་བསྔལ་དང་ཀུན་འབྱུང་གི་བདེན་པ་ལ་ཉེས་པར་བརྟག་པ་ཡང་སྡུག་བསྔལ་གྱི་བདེན་པ་ལ་མི་རྟག་པ་དང་སྡུག་བསྔལ་བ་དང་།",
    "ཉོན་མོངས་པ་རྣམས་སྤོང་བར་བྱེད་པར་འགྱུར་བའི་སྐྱེས་བུའི་ཚིག་ནི་མི་སླུ་ཤི་བའི་ལུང་ཞེས་བྱའོ།",
    "དེ་ལ་བརྫུན་གྱི་རྒྱུ་ཉོན་མོངས་པ་ཐམས་ཅད་མ་སྤངས་པ་དང་སྡུག་བསྔལ་ཐམས་ཅད་མ་སྤངས་པ་དང་།",
    "དེའི་ཚིག་བསྒོམས་ན་ཡང་ཉོན་མོངས་པ་སྤོང་བར་མི་འགྱུར་བ་སྟེ།",
    "དཔེར་ན་ཨ་མྲའི་ཤིང་གི་ཡལ་ག་འདི་ལ་འབྲས་བུ་གཅིག་སྨིན་པས་ན་ཐམས་ཅད་སྨིན་ཏོ་ཞེས་དཔོག་པ་ལྟ་བུའོ།",
    "ཡི་དྭགས་དང་བྱོལ་སོང་ངོ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་དང་།",
    "དེ་ལ་ལས་དང་ཉོན་མོངས་པས་བསྐྱེད་པས་གཟུགས་ལ་སོགས་པ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་འབྲས་བུར་གྱུར་པ་ལ་ནི་སྡུག་བསྔལ་གྱི་བདེན་པ་ཞེས་བྱ་སྟེ།",
    "ལས་དང་ཉོན་མོངས་པ་གཉིས་ལ་ནི་ཀུན་འབྱུང་གི་བདེན་པ་ཞེས་བྱ་སྟེ།",
    "ལས་དང་ཉོན་མོངས་པ་ཡང་སྤངས་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་ཡང་བཀག་པ་ལ་ནི་འགོག་པའི་བདེན་པ་ཞེས་བྱ་སྟེ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་གཉིས་ལ་སྡུག་བསྔལ་ཡོད་དེབྱེ།",
    "བདག་གིས་ཤེས་ཀྱང་རུང་།",
    "ཉེ་བའི་ཉོན་མོངས་པའི་རྙོག་པ་དངས་ཤིང་གསལ་བར་བྱེད་པས་ན་སེམས་དང་བ་ཞེས་བྱའོསྐེ།",
    "ཡིད་ཆེས་ཤིང་དང་བ་ཞེས་བྱ་བ་སྨོས་པས་ཆོག་མོད་སེམས་ཞེས་བྱ་བའི་སྒྲ་སྨོས་ཇི་དགོས།",
    "བདག་གིས་ཀྱང་ལས་འདི་བྱས་ན་བདག་ལ་འདི་འཇིག་རྟེན་པ་རྣམས་སྨོད་པ་དང་།",
    "འདིར་ཡང་ཞེ་སྡང་གི་གཉེན་པོར་གྱུར་པ་ལ་ཞེ་མི་སྡང་བ་ཞེས་བྱ་བའི་དོན་དུ་བལྟའོ།",
    "ལན་དུ་ཞེ་སྡང་གི་གཉེན་པོ་སྟེ་བྱམས་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཞེ་སྡང་གི་གཉེན་པོ་ཞེས་བྱའོ།",
    "ཡང་ན་ཞེ་མི་སྡང་བ་ཡང་ཞེ་སྡང་གི་གཉེན་པོ་ཡིན་ལ།",
    "ཞེ་སྡང་གི་གཉེན་པོ་ནི་གཞན་ཡང་ཡོད་པར་བསྟན་པའི་ཕྱིར་བྱམས་པ་སྨོས་ཏེ།",
    "གཏི་མུག་གི་གཉེན་པོ་སྟེ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སྣང་བ་བྱུང་ན་མུན་པ་མེད་པར་འགྲོ་བ་བཞིན་དུ་གཏི་མི་མུག་པ་སྐྱེས་ན་གཏི་མུག་མེད་པར་འགྲོ་བས་གཏི་མུག་གི་གཉེན་བོ་ཞེས་བྱའོ།",
    "དེའི་མཐུས་ཁྱོན་མོངས་པའི་ས་བོན་རྩ་ནས་མ་བཏོན་མ་བཅོམ་དུ་ཟིན་ཀྱང་ཁྱོན་མོངས་པ་རྣམས་སྐྱེ་བའི་སྐབས་མི་འབྱེད་པ་ནི་སོ་སོར་རྟོག་རྗོ་པ་ཞེས་བྱའོ།",
    "དེ་ལ་གནས་ངན་ལེན་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ཀྱི་ས་བོན་དང་ཤེས་བྱའི་སྒྲིབ་པའི་ས་བོན་ལ་བྱའོ།",
    "དེ་ལ་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ཀྱི་ས་བོན་ནི་ཉན་ཐོས་རྣམས་ལ་སྒྲིབ་པོ།",
    "ལུས་ལས་སུ་རུང་བ་ནི་རེག་བྱའི་ཁྱད་པར་ཡིན་ཏེ།",
    "ལུས་ཀྱི་རེག་བྱའི་ཁྱད་པར་ལ་ཇི་ལྟར་ན་ཤིན་ཏུ་སྦྱངས་པ་ཞེས་བྱ།",
    "ལུས་ཀྱི་རེག་བྱ་ལུས་ལས་སུ་རུང་བ་དེ་སེམས་ལས་སུ་རུང་བ་མ་ཡིན་དུ་ཟིན་ཀྱང་ལུས་ལས་སུ་རུང་བ་དེས་རྒྱུ་བྱས་ནས་སེམས་ལས་སུ་རུང་བ་སྐྱེད་པས་ན།",
    "ལུས་དང་སེམས་ལས་སུ་རུང་བའི་གནས་འཕོས་ནས་ལས་སུ་རུང་བའི་མཐུས་ཉོན་མོངས་པའི་སྒྲིབ་པ་མ་ལུས་པར་སྤོང་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ལེ་ལོ་ལ་བརྟེན་ཏེ་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་ལ་སེམས་འཇུག་པ་སྲུང་བྲཞིང་།",
    "དེ་ལ་འཇིག་རྟེན་པའི་ལམ་གྱིས་ཉོན་མོངས་པ་བཅིལ་བ་ནི་རྣམ་པར་སེལ་བའོམཐོང་བའི་ལམ་གྱིས་ཉོན་མོངས་པ་སྤངས་པ་ནི་རྣམ་པར་འཇོག་པའོ།",
    "ཉོན་མོངས་པ་མེད་པར་གནས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་ཐབས་སམ་རྒྱུར་གྱུར་པའི་བཏང་སྙོམས་ལ་བྱ་སྟེ།",
    "བཏང་སྟོམས་ནི་འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པའི་ཚོགས་ལ་འགལ་བ་ཡིན་པས།",
    "བཏང་སྟོམས་སྐྱེས་པར་གྱུར་ན་གདོན་མི་ཟ་བར་ཉོན་མོངས་པ་རྣམས་སྐྱེ་བའི་བགེགས་བྱེད་པར་འཇུག་པས་ན་བསལ་བ་ཞེས་བྱའོ།",
    "གང་གི་ཕྱིར་བཏང་སྙེམས་ལ་གནས་པའི་དུས་ན།",
    "དེ་ལྟར་བཏང་སྙོམས་ཀྱི་ཉོན་མོངས་པ་སེལ་བར་བྱེད་པ་དང་།",
    "ཉོན་མོངས་པ་མེད་པར་གནས་ཤིང་སྤྱོད་པ་ཡིན་པས་ན།",
    "བཏང་སྙོམས་ཀྱི་ལས་ཀྱང་ཉོན་མོངས་པ་སྐྱེ་བའི་སྐབས་མེད་པར་བྱེད་པའི་རྟེན་བྱེད་པའོ།",
    "གཞན་གྱི་སྡུག་བསྔལ་བསལ་བར་བྱ་བའི་དོན་དུ་བདག་ཉིད་འབད་པ་སྣ་ཚོགས་ཀྱིས་ཟུ་སྙུག་བསྔལ་སྣ་ཚོགས་ཉམས་སུ་ལེན་པར་བྱེད་པས་ན་བདག་གི་སྡིག་སྒྲིབ་ཅེས་ཀྱང་བྱའོ།",
    "ཡང་ན་རྒྱལ་པོས་བཀའ་གར་སྩལ་བའི་བཀའ་བཞིན་བྱེད་པའི་མི་དེ་ལ་རྒྱལ་པོའི་སྐྱེས་བུ་ཞེས་བྱ་བ་བཞིན་དུ་ཉོན་མོངས་པའི་མཚན་ཉིད་སྲེད་པས་གང་དུ་བཏང་བ་བཞིན་དུ་འཇུག་པར་བྱེད་པའི་ཕུང་པོ་ལ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཞེས་བྱ་སྟེ།",
    "བརྩལ་རྔོ་བ་ཆེན་པོས་ཀྱང་དབྱུང་བར་བཀའ་དུ་བ་དེ་བཞིན་དུ་འདོད་ཆགས་འདིས་ཀྱང་ཆགས་པར་བྱ་བའི་རང་གི་ཡུལ་ལ་ཞེན་ཏམ།",
    "རེག་པ་མེད་པར་གནས་པ་དང་།",
    "དེ་ལ་རེག་པ་ཞེས་བྱ་བ་ནི་བདེ་བ་ལ་བྱ་སྟེ།",
    "བདེ་བ་དང་ལྷན་ཅིག་ཏུ་གནས་པ་ནི་རེག་པར་གནས་པའོ།",
    "བདེ་བ་མེད་པར་གནས་པ་ནི་རེག་པ་ཉུམེད་པར་གནས་པ་སྟེ།",
    "ང་རྒྱལ་ཐམས་ཅད་ཀྱང་འཇིག་ཚོགས་སུ་ལྟ་བ་ལ་བརྟེན་ནས་འབྱུང་ཞིང་ཕུང་པོ་ལྔ་བདག་དང་བདག་གི་མེད་པ་ལ་བདག་དང་བདག་གིར་སྒོ་བཏགས་ནས་གཞན་གྱི་ཕུང་པོ་བས་བདག་གི་ཕུང་པོ་ཁྱད་ཞུགས་པར་འཕགས་སོ་སྙམ་དུ་ལྷག་པར་ཟློས་ཞིང་སེམས་ཁེངས་པའི་མཚན་ཉིད་དོ།",
    "ངག་མ་གུས་པ་ནི་དེ་དག་གི་ཡོན་ཏན་མི་བརྗོད་པའོ།་།",
    "སེམས་མ་གུས་པ་ནི་དེ་དག་ལ་དགའ་བར་མི་སེམས་ཤིང་ཚོད་ཡོད་པར་སེམས་པའོ།",
    "ང་རྒྱལ་ཐམས་ཅད་ཀྱང་སེམས་ཁེངས་པའི་མཚན་ཉིད་དུ་ཐ་མི་དད་དུ་ཟིན་མོད་ཀྱི་ང་རྒྱལ་གྱེས་པྱདམིགས་པར་བྱ་བའི་ཡུལ་ཐ་དད་པའི་སྒོ་ནས་ང་རྒྱལ་རྣམ་པ་བདུན་དུ་འགྱུར་བར་བསྟན་པའི་ཕྱིར།",
    "ལན་དུ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་རྣམས་ལ་བདག་གམ་བདག་གིར་ཡང་དག་པའི་རྗེས་སུ་ལྟ་སྟིཞིང་གང་སེམས་ཁེངས་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེལྡུ།",
    "བདག་དེ་བདག་གིས་ཤེས་པ་ལྟ་བུར་གཞན་གྱིས་མི་ཤེས་སོ་ཞེས་གང་སེམས་ཁེངས་པ་ནི་ངའོ་སྙམ་པའི་ང་རྒྱལ་ཞེས་བྱའོ།",
    "ལན་དུ་གོང་མའི་བྱེ་བྲག་མ་ཐོབ་པར་བདག་གིས་ཐོབ་པོ་སྙམ་དུ་གང་སེམས་ཁེངས་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ལན་དུ་བྱེ་བྲག་མང་པོས་འཕགས་པ་བས་བདག་ཅུང་ཟད་ཅིག་གིས་ཆུང་ངོ་སྙམ་དུ་གང་སེམས་ཁེངས་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "འདི་བས་རིགས་དང་ཤེས་ཉེན་རྗོདང་ནོར་ལ་སོགས་པ་ཅུང་ཟད་ཅིག་གིས་བདག་ཆུང་ངོ་སྙམ་དུ་སེམས་ཤིང་གང་སེམས་ཁེངས་པ་ནི་ཆུང་བའི་ང་རྒྱལ་ཞེས་བྱའོ།",
    "བདག་གིས་ཀུན་ཐོབ་པོ་སྙམ་དུ་ང་རྒྱལ་བྱེད་ཀྱི།",
    "ངན་སོང་གསུམ་དུ་སྐྱེས་པ་ནི་ཡིད་དུ་མི་འོང་བའོ།",
    "ལམ་མོ།",
    "དེ་ལ་ཉོན་མོངས་པ་གཞན་དང་མི་ལྡན་ཞིང་མ་འདྲེས་པའི་མ་རིག་པ་ནི་ལྷན་ཅིག་སྐྱེས་པའི་མ་རིག་པ་ཞེས་བྱ་སྟེ།",
    "ཁོང་ཁྲོ་བ་ལ་སོགས་པ་ཉོན་མོངས་པ་གཞན་དང་འདྲིས་ཤིང་འགྲོགས་པའི་མ་རིག་པ་ནི་ཡོངས་སུ་བརྟགས་པའི་མ་རིག་པ་ཞེས་བྱའོ།",
    "ལོག་པར་གཏན་ལ་འབེབས་པ་དང་ཐེ་ཚོམ་སྐྱེད་པ་དང་ཀུན་ནས་ཉོན་མོངས་པ་སྐྱེ་བའི་གནས་སྦྱིན་པའི་ལས་ཅན་ནོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་སྐྱེ་བའི་རྟེན་བྱེད་པ་ནི་མ་རིག་པ་ཡོད་པ་ལས་འདོད་ཆགས་དང་ཁོང་ཁྲོ་བ་དང་ཉོན་མོངས་པ་གཞན་བྱུང་བའི་ཕྱིར་རོ།",
    "གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་ཀྱི་ཉོན་མོངས་པ་ཐམས་ཅད་ལ་ལུང་དུ་མི་སྟོན་པ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པ་དང་བཅས་པའི་ལྟ་བའོ།",
    "མུ་སྟེགས་པ་རྣམས་བདག་རྟག་པ་ལ་སོགས་པར་ལྟ་བ་ནི་ཉོན་མོངས་པ་དང་བཅས་པའི་ལྟ་བ་ཞེས་བྱ་སྟེ།",
    "ཉོན་མོངས་པ་དང་བཅས་པའི་ལྟ་བ་ལྔ་ལ་བྱ་བའི་ཕྱིར།",
    "ལྟ་བ་ལྔ་པོ་དེ་དག་ཀྱང་ཉོན་མོངས་པ་ཅན་གྱི་རང་བཞིན་དུ་ཁྱད་པར་མེད་མོད་ཀྱི་ལྟ་བ་དེ་དག་གིས་དམིགས་པར་བྱ་བའི་ཡུལ་ལ་རྣམ་པ་ཐ་དད་པར་དམིགས་པའི་སྒོ་ནས་ལྟ་བ་རྣམ་པ་ལྔར་གཞག་གོ།",
    "ལྟ་བ་དེ་དག་གིས་དམིགས་པར་བྱ་བའི་ཡུལ་ནི་ཕུང་པོ་ལྔ་ཡིན་ཏེ།",
    "ཕུང་པོ་ལྔ་ལ་འཇིག་ཚོགས་ལ་ལྟ་བས་ནི་བདག་དང་བདག་གིར་རྣམ་པར་ལྟ།",
    "ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་རྣམས་ལ་བདག་གམ་བདག་གིར་ཡང་དག་པར་རྗེས་སུ་ལྟ་བ་སྟེ།",
    "གང་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་ལ་ཕུང་པོ་ལྔ་ནི་མི་རྟག་པ་དང་དུ་མའི་རང་བཞིན་ཡིན་པས་བདག་དང་བདག་གི་མེད་པ་ཡིན་ན།",
    "རང་གི་རྒྱུད་དུ་གཏོགས་པའི་ཕུང་པོ་ལྔ་ལ་ནི་བདག་ཏུ་ངེས་པར་འཛིན་ཅིང་ལྟ།",
    "གཞན་གྱི་རྒྱུན་རྔུ་དུ་གཏོགས་པའི་ཕུང་པོ་ལྔ་ལ་ནི་བདག་གིར་ངེས་པར་འཛིན་ཅིང་ལྟ་བ་ནི་འཇིག་ཚོགས་ལ་ལྟ་བ་ཞེས་བྱའོ།",
    "ཕུང་པོ་ལྷག་མ་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་།",
    "འདུ་བྱེད་ལ་ནི་བདག་གིར་ལྟ་སྟེ།",
    "ཕྱིན་ཅི་ལོག་དང་ལྡན་པའི་ཕྱིར་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ཞེས་བྱའོ།",
    "བདག་དང་བདག་གིར་ལྟ་བ་འདི།",
    "བདག་དང་༦དངོས་པོ་ཡོད་པར་ལྟ་བ་ནི་མ་ཡིན་གྱི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པྱྀལ་བདག་དང་བདག་གིར་ལྟ་བར་ཅི་མངོན།",
    "གང་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "འཇིག་ཚོགས་སུ་ལྟ་བས་ཕུང་པོ་ལྔ་ལ་བདག་དང་བདག་གིར་བལྟས་པ་དེ་ལ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དཔེར་ན་ཤིང་མེས་ཚིག་ནས་ཐལ་བར་གྱུར་པ་སླར་ཤིང་དུ་མི་འགྱུར་བ་བཞིན་དུ་འདིར་ཤི་ཕན་ཆད་རྒྱུན་ཆད་དེ་ཕུང་པོ་གཞན་ལེན་པ་མེད་དོ་ཞེས་ལྟ་བ་ནི་ཆད་པར་ལྟ་བ་ཞེས་བྱའོ།",
    "གཏི་མུག་དང་ལྡན་ཞིང་རྨོངས་པ་དང་བཅས་པ་ལ་ནི་རྟག་པ་དང་ཆད་པར་སྩོལྟ་བ་འབྱུང་གི།",
    "གང་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བྱེད་པ་ལ་སྐུར་ཞེས་ཚིག་རེ་རེ་དང་སྦྱར་རོ།",
    "ལས་དེ་དག་གི་འབྲས་བུ་བདེ་བ་དང་སྡུག་བསྔལ་མྱོང་བ་མེད་ཅེས་སྨྲ་བ་ནི་འབྲས་བུ་ལ་སྒུར་པ་ཞེས་བྱའོ།",
    "དེ་ལ་བྱེད་པ་ཡང་རྣམ་པ་གསུམ་མོ།",
    "དེ་ལ་མ་རིག་པ་དང་སྲེད་པ་དང་ལེན་པ་གསུམ་ནི་ཉོན་མོངས་པའི་ཡན་ལག་ཏུ་གཞག་།",
    "རྣམ་པར་ཤེས་པ་དང་མིང་དང་གཟུགས་དང་སྐྱེ་མཆེད་དྲུག་དང་རེག་པ་དང་ཚོར་བ་དང་སྐྱེ་བ་དང་རྒ་ཤི་དང་བདུན་ནི་སྡུག་བསྔལ་གྱེ་ཡན་ལག་སྟེ།",
    "རྣམས་ལ་ནི་ཐམས་ཅད་གྲེད་དོ་ཞེས་སྐུར་པ་འདེབས་པ་འབྱུང་གི།",
    "འཇིག་ཚོགས་སུ་ལྟ་བ་ཡང་བདག་དང་བདག་གི་༢མེད་པ་ལ་བདག་དང་བདག་གིར་ཕྱིན་ཅི་ལོག་ཏུ་ལྟ་བ་དང་།",
    "འདི་ལྟར་མར་ཀུན་ཀྱང་དྲི་མི་ཞིམ་པ་ཡིན་མོད་ཀྱི་གང་ལྷག་པར་དྲི་མི་ཞིམ་པ་དེ་ལ་མར་དྲི་མི་ཞིམ་པ་ཞེས་བྱ་བ་དང་།",
    "གང་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "མཐར་འཛིན་པར་ལྟ་བ་དང་ལོག་པར་ལྟ་བ་སྟེ་གསུམ་མོ།",
    "དེའི་གནས་ཀྱི་ཕུང་པོ་ལ་མཆོག་དང་དམ་པར་འཛིན་པ་འབྱུང་གི།་",
    "གང་ཤེས་རབ་ཉོན་མོངས་པ་ཅན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སྒྲེན་མོར་འཕྱན་པ་ལ་སོགས་པའི་ལུས་ཀྱི་ཆ་ལུགས་འཛིན་པ་དང་།",
    "ཉོན་མོངས་པ་དྲུག་གི་རང་བཞིན་དང་ལས་བསྟན་ནས།",
    "ཉོན་མོངས་པ་དྲུག་ལས་དུ་ཞིག་ནི་ཡོངས་སུ་བརྟག་པ་འབའ་ཞིག་ཡིན་ལ།",
    "དེའི་ལན་དུ་ཉོན་མོངས་པ་དེ་དག་ལས་ལྟ་བ་འོག་མ་གསུམ་དང་།",
    "ཉོན་མོངས་པ་དེ་དག་ལས་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་དང་།",
    "དྲུག་པོ་དེ་དག་གི་ནང་ནས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་ཉན་ཐོས་རྣམ་པར་སྨྲ་བ་པ་རྣམས་ནི་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ཀྱང་རྫས་སུ་ཡོད་པར་འདོད་མོད་ཀྱི།",
    "དེ་ནས་ཁྲོ་བའི་འོག་ཏུ་འདིས་བདག་ལ་གནོད་པ་འདི་ལྟ་བུ་ཞིག་བྱས་པས་ལན་མ་ལོན་བར་དུ་མི་གཏོང་པྱངོ་སྙམ་དུ་སེམས་ཤིང་ཞེ་སྡང་གི་བསམ་པ་རྒྱུན་དུ་སེམས་ལ་འཇོག་ཅིང་མདུད་པར་འཛིན་པ་མི་གཏོང་བ་ནི་ཁོན་དུ་འཛིན་པ་ཞེས་བྱའོ།",
    "འདིས་བདག་གི་མཛའ་བོ་ལ་གནོད་པ་སྔོན་བྱས།",
    "འདིས་བདག་གི་དགྲ་ལ་སྔོན་ཕན་བཏགས།",
    "ཕྱིས་ཕན་འདོགས་པར་་བྱེད་པས་འདི་ལ་གནོད་པར་མི་བྱ་བར་མི་གཏོང་ཐུངོ་སྙམ་དུ་ཞེ་སྡང་གི་བསམ་པ་རྒྱུན་དུ་མི་གཏོང་བ་ནི་ཁོན་དུ་འཛིན་པ་ཞེས་བྱའོ།",
    "འདི་ཡང་ཞེ་སྡང་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "དེའི་ལན་དུ་བདག་གི་ཁ་ན་མ་ཐོ་བར་མཁྱུད་ཡེཔའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་དུ་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "ཕྲག་དོག་གི་རང་བཞིན་བསྟན་པའི་ཕྱིར།",
    "ཕྲག་དོག་གི་རང་བཞིན་དང་མཚན་ཉིད་གང་ཞེ་ན་རྨྱེཞེས་དྲིས་པའི་དོན་ཏོ།",
    "སེམས་ཁྱད་པར་འཁྲུགས་པ་ཞེས་བྱ་བ་ནི་ཞེ་སྡང་གི་ཤས་ཀྱིས་སེམས་མི་བཟོད་པར་གྱུར་པ་སྟེ།",
    "འདི་ཡང་ཞེ་སྡང་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "དུས་ཐམས་ཅད་དུ་བདག་གི་སེམས་མི་བདེ་ཞིང་འཁྲུག་པ་སྐྱེ་བར་འགྱུར་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "འདི་ཡང་འདོད་ཆགས་དང་གཏི་མུག་གི་ཤས་ཀྱིས་ཡོན་ཏན་ཡོད་པ་མ་ཡིན་ཀྱང་ཡོན་ཏན་ཅན་དུ་སྟོན་ཅིང་སྒོགས་པར་བྱེད་པས་འདོད་ཆགས་དང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བའི་ཕྱིར་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "བདག་གི་ཉེས་པ་འཆབ་པའི་ཐབས་གཟུང་བ་སྟེ།་",
    "བདག་ཉིད་ཀྱིས་སྲོག་གཅོད་པ་ལ་སོགས་པའི་སྐྱོན་བྱས་པ་ནི་བདག་གི་ཉེས་པའོ།",
    "བདག་གི་ཉེས་པ་འཆབ་པ་ནི་བདག་གི་ཉེས་པ་མཁྱུད་པའམ་སྦེད་པའོ།",
    "དེའང་གཞན་དག་གིས་ཁྲོད་ཀྱིས་ཉེས་པ་འདི་ལྟ་བུ་ཞིག་མ་བྱས་སམ་ཞེས་དྲིས་ན།",
    "འཆབ་པ་ཡང་བདག་གི་ཁ་ན་མ་ཐོ་བ་འཆབ་པ་ཡིན་ལ་གཡོ་ཡང་རང་གི་ཉེས་པ་འཆབ་པའི་ཐབས་འཛིན་པ་ཡིན་པས་དེ་གཉི་ག་ཉེས་པ་འཆབ་པ་བྱེད་པར་ཟད་ན་ཁྱད་པར་ཇི་ཡོད།",
    "བདག་གི་ཕུན་སུམ་ཚོགས་པ་ལ་ཆགས་ནས་རབ་ཏུ་དགའ་བའི་སེམས་ཀྱིས་ཡོངས་སུ་འཛིན་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བདག་གི་ཕུན་སུམ་ཚོགས་པ་ནི་བདག་ལ་ཡོད་པ་འབྱོར་པ་ལ་བྱ་སྟེ།",
    "ལང་ཚོ་དར་ལ་བབ་པ་དང་།",
    "ཡིད་རྣོ་བ་ལ་སོགས་པ་གཞན་པས་ཁྱད་ཞུགས་པར་འཕགས་ཤིང་ཕུལ་དུ་བྱུང་བ་ལ་ནི་བདག་གི་ཕུན་སུམ་ཚོགས་པ་ཞེས་བྱའོ།",
    "མིང་གིས་སྨོས་པའི་བདག་གི་ཕུན་སུམ་ཚོགས་པ་ལ་ཞེན་ནས་གཏོང་མི་ཕོད་པ་ནི་ཆགས་པ་སྟེ།",
    "འདིའི་ལས་ཀྱང་ཉོན་མོངས་པ་ཐམས་ཅད་སྐྱེ་བའི་རྟེན་བྱེད་པའི་ལས་ཅན་ཏེ།",
    "རྒྱགས་པའི་རྒྱུས་ཉོན་མོངས་པ་དྲུག་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་གཞན་ཡང་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་གསུམ་ནི་རྣམ་པར་འཚེ་བའི་མིང་གི་རྣམ་གྲངས་སོ།",
    "འདི་ཡང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་ལྕེགཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་པེབཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "འདིའི་ལས་ཀྱང་ཉོན་མོངས་པ་དྲུག་དང་གཡོ་དང་སྒྱུ་ལ་སོགས་པ་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་སྐྱེ་བའི་རྒྱུའམ་གྲོགས་བྱེད་པའོ།",
    "འདིའི་ལས་ཀྱང་ཉོན་མོངས་པ་དྲུག་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་སྐྱེ་བའི་གྲོགས་སམ་རྒྱུ་བྱེད་པའོ།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།་།",
    "འདིའི་ལས་ཀྱང་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་སྐྱེ་བའི་གྲོགས་བྱེད་པའོ།",
    "རྩེད་མོ་བྱས་པ་ལ་སོགས་པ་རྗེས་སུ་དྲན་ཏེ།",
    "མི་གཡོ་བའི་མཚན་ཉིད་དང་གསུམ་མོ།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་བཏགས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "ལེ་ལོ་གང་ཡིན་པ་དག་གིས་ཉོན་མོངས་པའི་སེམས་མི་བསྲུང་བ་དང་།",
    "དྲན་པ་ཉོན་མོངས་པ་ཅན་ཏེ།",
    "དྲན་པ་གང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་ལ་སོགས་པའི་ཉོན་མོངས་པ་དང་ལྡན་པའི་དྲན་པ་ལ་ནི།",
    "དྲན་པ་ཁྱོན་མོངས་པ་ཅན་ཞེས་བྱའོ།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "དྲན་པ་ཉམས་པ་རྣམས་ཉོན་མོངས་པའི་ཡུལ་བུད་མེད་ལ་སོགས་པ་འབའ་ཞིག་ལ་སེམས་འཇུག་པའི་ཕྱིར་རོ།",
    "དྲི་དང་རོ་དང་རེག་གོ།",
    "དེའང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་མིག་གི་རྣམ་པར་ཤེས་པ་ནས་ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་དུ་རྣམ་པར་ཀྱེཤེས་པ་ལྔའི་ཚོགས་ལ་ནི་རང་བཞིན་ཀྱིས་གཡེང་བ་ཞེས་བྱ་སྟེ།་",
    "ངག་གི་སྤྱོད་པ་སྨྲ་བ་དང་མི་སྨྲ་བར་བྱ་བ་དང་།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "འགྱོད་པ་ལུང་དུ་མ་བསྟན་པ་གཉིས་ནི་གཏི་མུག་གི་ཤས་ལས་བྱུང་བ་འུའགྱོད་པ་དེ་དག་ནི་གཏི་མུག་མེད་པའི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "འདི་ཡང་གཏི་མུག་གི་ཤས་ལས་བྱུང་བས་ན་རྫས་སུ་མེད་ཀྱི་བཏགས་པར་ཡོད་པར་རིག་པར་བྱའོ།",
    "དཔེར་ན་ཚིག་གིས་འདི་ནི་སྣམ་བུ་འདི་ནི་བུམ་པ་ཞེས་དོན་སྨྲ་བར་བྱེད་པ་དེ་བཞིན་དུ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་འདི་ནི་སྣམ་བུ་འདི་ནི་བུམ་པའོ་ཞེས་ཡིད་ལ་སྨྲ་ཞིང་ཡིད་ཀྱིས་རྟོག་པ་ནི་ཡིད་ཀྱིས་བརྗོད་པ་ཞེས་བྱའོ།",
    "རྟོག་པ་དེ་ཡང་གང་གི་ཕ་ལས་བྱུང་ཞེ་ན།",
    "དཔེར་ན་ཚིག་གིས་སྤྱོདོན་གྱེ་དངོས་པོ་སྨྲ་བ་བཞིན་དུ་ཡིད་ཀྱིས་ཀྱང་བུམ་པ་འདི་ནི་ལེགས།",
    "ཉན་ཐོས་རྣམ་པར་སྨྲ་བ་པ་རྣམས་ནི་སེམས་དང་མི་ལྡན་པའི་འདུ་བྱེད་ཐམས་ཅད་རེ་རེ་ནས་རྫས་སུ་ཡོད་པར་འདོད་ཀྱང་།",
    "ནམ་སེམས་འགགས་ཁྲུཔའི་ཚེ་ལྡུམཚན་ཉིད་ཐོབ་པར་གྱུར་པའི་སྐད་ཅིག་མ་གཉིས་པ་ཕན་ཆད་འགོག་པའི་སྟོམས་པར་འཇུག་པ་ཞེས་གདགས་པ་བཞིན་དུ་འདུ་བྱེད་སེམས་དང་མི་ལྡན་པ་གཞན་ཡང་གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བ་དེ་དག་གིས་ཐོབ་པར་བྱ་བར་བཙལ་ནས།",
    "གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བའི་བདག་གིས་བསྐྱེད་པའི་འདུ་བྱེད་སེམས་དང་མི་ལྡན་པ་དེ་དག་གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བའི་ངོ་བོ་ཉིད་ཡིན་ནོ་ཞེས་ཀྱང་མི་གདགས།་",
    "ཁུ་ཚུར་དང་སོར་མོ་གཅིག་པར་ཡང་མི་གདགས་ཐ་དད་པར་ཡང་མི་གདགས་པ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་སོར་མོ་དང་ཁུ་ཚུར་གཅིག་པ་ཞེས་གདགས་སུ་ཡང་མི་རུང་སྟེ།",
    "སོར་མོ་དང་ཁུ་ཚུར་ཐ་དད་པ་ཞེས་ཀྱང་གདགས་སུ་ཡང་མི་རུང་སྟེ།",
    "ཁྱ་ཚུར་ནི་སོར་མོ་བསྡུས་པ་ལས་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་དང་གཞན་དུ་མི་གདགས་སོ་ཞེས་སྤྱི་ཙམ་དུ་བསྟན་པ་དེ་དག་ཀྱང་ཁྱད་པར་དུ་ན་མིང་གིས་གང་དང་གང་ཡིན་པ་མི་ཤེས་པས་ཁྱད་པར་ཤེས་པར་འདོད་ནས་དེ་དག་ཀྱང་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "འདུ་བྱེད་སེམས་དང་མི་ལྡན་པ་དེ་དག་གི་ནང་ནས་རྙེད་པའི་རང་བཞིན་ཇི་ལྟ་བུ་ཡིན་ཞེས་དྲིས་པའི་དོན་ཏོ།",
    "དེ་ལྟར་རྒྱུ་བསྐྲུན་པས་དེས་བརྟས་པར་གྱུར་ནས་བདག་གི་འབྲས་བུ་བསྐྱེད་པར་བྱ་བ་ལ་མཐུ་དང་ལྡན་པར་གྱུར་ཏེ།",
    "གཞན་གང་གིས་ཀྱང་བར་དུ་གཅད་མི་ནུས་པར་འབྲས་བུ་བསྐྱེད་པའི་མཐའ་མའི་སྐད་ཅིག་མ་འབྲས་བུ་སྐྱེས་ནི་མ་སྐྱེས།",
    "དེ་ནས་དེ་ལས་རང་གི་འབྲས་བུ་གྲུབ་སྟེ།",
    "བྱོལ་སོང་དང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་དང་།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དེ་དང་པོའི་བསམས་པའམའདུ་ཤེས་གང་གིས་སྟོམས་པར་འཇུག་ཅེ་ན།",
    "དེ་ལ་མིག་གི་རྣམ་པར་ཤེས་པ་ནས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་དུ་རྣམ་པར་ཤེས་པ་དྲུག་ནི་མི་བརྟན་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་ཞེས་བྱ་སྟེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་ཉོན་མོངས་པའི་ཡིད་གཉིས་ནི་བརྟན་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་ཞེས་བྱ་སྟེ།",
    "ཉོན་མོངས་པའི་ཡིད་ཀྱང་ཟག་པ་མེད་པའི་ལམ་ཀྱི་བདེན་པའི་དུས་དང་།",
    "དེ་ལྟར་ན་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དྲུག་གི་ཚོགས་སེམས་ལས་བྱུང་བ་དང་བཅས་ཏེ་རྒྱུ་བཀག་པས་ན་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ་བ་ཡང་གཟུགས་ཀྱི་དུས་ཀྱི་ཁྱད་པར་ལ་གདགས་ཀྱི་རྫས་སུ་མེད་དོ།",
    "སྲིད་པའི་རྩེ་མོ་ནས་པྱགྱེན་དུ་བསྐྱོད་པ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཅུང་ཟད་མེད་ཅུང་ཟད་མེད་མིན་སྐྱེ་མཆེད་ལས་འཕགས་པ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་དེས་ཅུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་མན་ཆད་ཀྱི་ཉོན་མོངས་པ་དང་འདོད་ཆགས་ཀུན་སྤངས་པ་ན་ཅུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་ཞེས་བྱའོ།",
    "འཕགས་པ་ཅུང་ཟད་མེད་པའི་འདོད་ཆགས་དང་བྲལ་བ་དེ་ཐུསྲིད་པའི་རྩེ་མོ་ཅུང་ཟད་མེད་ཅུང་ཟད་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་ཉོན་མོངས་པ་སྤོངས་པའི་ཆོཕྱིར་ཆས་ཤིང་ཉོན་མོངས་པ་སྤང་བའི་ཕྱིར་བརྩོན་པ་ནས་སྲིད་པའི་རྩེ་མོ་ནས་འུགྱེན་དུ་བསྐྱོད་པ་ཞེས་བྱའོ།",
    "དེ་ལ་སོ་སོའི་སྐྱེ་བོ་འཇིག་རྟེན་པའི་ལམ་ལ་སྟོམས་པར་འཇུག་པ་རྣམས་སྲིད་པའི་རྩེ་མོའི་འདོད་ཆགས་དང་མ་བྲལ་ཡང་ཅུང་ཟད་རྔེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་ཡོད་པས་སྲིད་པའི་རྩེ་མོ་ལས་གྱེན་དུ་བསྐྱོད་པ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སོ་སོའི་ཀླུསྐྱེ་བོ་འཇིག་རྟེན་པའི་ལམ་ལ་སྙོམས་པར་ཞུགས་པ་རྣམས་ནི་ཅུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་བྱེ་ཡང་སྲིད་པའི་རྩེ་མོའི་ཉོན་མོངས་པ་མཐོང་བས་སྤང་བ་དང་།",
    "དེ་ནས་སྲིད་པའི་རྩེ་མོའི་སེམས་ཕྲ་མོ་བསྐྱེད་དོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་དུ་སེམས་ལས་བྱུང་བའི་འཁོར་དང་བཅས་པ་དྲུག་ལ་བྱ་སྟེ།",
    "དེ་ལ་འགོག་པའི་སྙོམས་པར་འཇུག་པའི་ཚེ་སེམས་དང་སེམས་ལས་བྱུང་བ་མི་བརྟན་པ་འབའ་ཞིག་འགག་གི་བརྟན་པ་མི་འགག་གམ་སྙམ་པ་ལ་བརྟན་གྱོ་པ་ཡང་འགག་པར་བསྟན་པའི་ཕྱིར།",
    "ཉོན་མོངས་པའི་ཡིད་གཉིས་ལ་བརྟན་པ་གཅིག་འཁོར་དང་བཅས་ཏེ་འགགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིར་སེམས་བརྟན་ཞུཔ་གཉིས་ལས་འགོག་པའི་ཚེ་འདི་ཁོ་ན་འགགས་སོ་ཞེས་དམིགས་ཀྱིས་བུམ་ཕྱིར་ཟིན་ཀྱང་ཉོན་མོངས་པའི་ཡིད་དེའི་ཚེ་ན་འགགས་པར་རིག་པར་བྱའོ།",
    "དེ་ལྟར་ན་རྣལ་འབྱོར་པ་དེ་འདོད་པའི་ཁམས་ལ་གནས་ཤིང་སྙོམས་པར་ཞུགས་ན་ནི་འཇུག་པའི་རྣམ་པར་ཤེས་པ་གོང་མ་དྲུག་གི་སྟེང་དུ་ཉོན་མོངས་པའི་ཡིད་ཀྱིས་བསྣན་ཏེ་བདུན་འགག་གོ།",
    "གཟུགས་ཀྱི་ཁམས་སུ་སྙོམས་པར་ཞུགས་རྔུན་ནི་གོང་མ་བཞིའི་སྟེང་དུ་ཉོན་མོངས་པའི་ཡིད་ཀྱིས་བསྣན་ནས་ལྔ་འགག་གོ།",
    "གཟུགས་སྐེད་པའི་ཁམས་སུ་སྙོམས་པར་ཞུགས་ན་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་སྟེང་དུ་ཉོན་མོངས་པའི་ཡིད་ཀྱིས་བསྣན་ནས་གཉིས་འགག་གོ།",
    "དང་པོ་སྟོམས་པར་འཇུག་པའི་ཚེ་འདུ་ཤེས་དང་ཚོར་བ་གཉིས་སུན་འབྱེན་ཏོ།",
    "འདུ་ཤེས་དང་ཚོར་བ་གཉིས་སུན་ཙོཕྱུང་ནས་སེམས་ཇེ་ཕྲ་ཇེ་ཕྲར་གཏང་བ་དང་སེམས་དེས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་འཇུག་པའི་རྣམ་པར་ཤེས་པ་དྲུག་དང་།",
    "ཉོན་མོངས་པའི་ཡིད་ཀྱི་ས་བོན་ཡོད་པ་མཐུ་ཉམས་པར་བྱའོ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་གཉིས་ལ་ཁྱད་པར་ཅི་ཞིག་གིས་དབྱེ་ཞེ་ན།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་འཕགས་པ་འཇུག་པས་ན་དེ་ལྟར་གང་ཟག་གིས་རྔུཁྱད་ཞུགས་སོ།",
    "འགོག་པའི་སྟོམས་པར་འཇུག་པ་ནི་ཅུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདོད་ཆགས་དང་བྲལ་ཞིང་སྲིད་པའི་རྩེ་མོའི་ཉོན་མོངས་པ་སྤང་བར་བྱ་བའི་ཕྱིར་བརྩོན་ལ།",
    "ས་ཡང་སྲིད་པའི་རྩེ་མོ་ཉིད་དུ་གནས་པར་གཏོགས་པས་སས་ཁྱད་ཞུགས་སོ།",
    "འགོག་པའི་སྟོམས་པར་འཇུག་པ་ནི་རྣམ་པར་ཤེས་པ་དྲུག་གི་སྟེང་དུ་ཉོན་མོངས་པའི་ཡིད་ཀྱིས་སྙེབསྣན་ཏེ་རྣམ་པར་ཤེས་པ་བདུན་འཁོར་དང་བཅས་ཏེ་འགོག་པའི་རང་བཞིན་ཡིན་པས་རང་བཞིན་ཁྱད་ཞུགས་སོ།",
    "ལྷ་དང་མི་དང་ལྷ་མ་ཡིན་དང་བྱོལ་སོང་ལ་སོགས་པ་འགྲོ་བ་ཐ་དད་པ་དང་།",
    "ས་ཀྱིས་ནི་ངན་སོང་གསུམ་དུ་སྐྱེ་བར་བྱེད་དོ།",
    "ལྷ་དང་མི་དང་བྱོལ་སོང་དང་ཡི་དྭགས་དང་།",
    "བུད་མེད་ཀྱང་བུད་མེད་དང་ཆ་ལུགས་མཐུན།",
    "བྱོལ་སོང་ཡང་ནང་དབྱེ་ན་རྟ་ཡང་རྟར་ཆ་ལུགས་མཐུན་པ་ལ་སོགས་པ་ཆ་ལུགས་མཐུན་པ་ཞེས་བྱའོ།",
    "ཕུང་པོ་ལྔ་སྟེ་ནང་གི་འདུ་བྱེད་ལས།",
    "འདིར་ནང་གི་འདུ་བྱེད་སྐྱེས་པ་ལ་སྐྱེ་བ་ཞེས་བྱ་བར་འདོད་ཀྱི།",
    "དེ་ལྟར་དེ་དག་གི་རྒྱུན་གཞན་དུ་གྱུར་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་དག་གི་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྔ་རྣམས་དག་གིའོ།",
    "ཐ་མར་འཆི་བའི་སྲིད་པ་ཕུང་པོ་ལ་ཐུག་གི་བར་དུ་སྐད་ཅིག་མར་གནས་པ་ལ་སྐད་ཅིག་མ་སྔ་མ་སྔ་མ་ནི་རྒྱུ་སྐད་ཅིག་མ་ཕྱི་མ་ཕྱི་མ་ནི་འབྲས་བུར་གྱུར་པའི་སྐད་ཅིག་མ་རྣམས་རྒྱུན་མ་ཆད་པ་ལ་རྒྱུན་ཅེས་བྱ་བའམ།",
    "དེའི་ལན་དུ་དེ་ལྟར་དེ་དག་གི་རྒྱུན་རྗེས་སུ་འབྲང་བའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་དག་གིས་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྔ་རྣམས་ཀྱིའོ།",
    "དེའི་ལན་དུ་དེ་ལྟར་དེ་དག་གི་རྒྱུན་འཇིག་པའོ་ཞེས་བྱ་བ་སྨོས་ཆཏེ།",
    "དེ་དག་གི་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྔ་དག་གིའོ།",
    "དོན་དུ་ནི་མི་ལ་སོགས་པ་རིས་མཐུན་པར་སྐྱེས་པའི་ཕུང་པོ་རྒྱུན་ཆད་དེ་ཤི་ནས་བྱོལ་སོང་ལ་སོགས་པའི་ཕུང་པོ་རིས་མི་མཐུན་པའི་ཕུང་པོ་གཞན་བླངས་པ་ལ་མི་རྟག་པ་ཞེས་བྱའོ།",
    "ནང་གི་འདུ་བྱེད་ཕུང་པོ་ལྔ་སྟེ།",
    "འཇིག་པ་ཞེས་མ་གྲགས་ལ་ནང་གི་འདུ་བྱེད་རྣམས་ལ་སྐྱེ་བ་དང་འཇིག་པ་ལ་ནི་སྐྱེ་བ་དང་།",
    "ནང་གི་འདུ་བྱེད་རྣམས་ཀྱི་སྐྱེ་བ་དང་།",
    "མིང་གི་ཚོགས་ཀྱི་རང་བཞིན་དེ་ལ་མིང་ཞེས་བྱ་བའི་དོན་བསྟན་པའི་ཕྱིར།",
    "མིང་གི་ཚོགས་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "མིང་གི་ཚོགས་ཀྱི་རང་བཞིན་དང་།",
    "དེ་བས་ན་མིང་གི་ཚོགས་འདི་ཡང་གཟུགས་དང་།",
    "ཚིག་གི་ཚོགས་ཀྱི་རང་བཞིན་བསྟན་པའི་ཕྱིར་ཚིག་གི་ཚོགས་གང་ཞེ་ན་ཞེས་དྲིས་ཏེ།",
    "ཚིག་གི་ཚོགས་ཀྱི་རང་བཞིན་དང་མཚན་ཉིད་གང་ཞེ་ན་ཞེས་དྲིས་པའི་དོན་ཏོ།",
    "དེ་ལྟར་ཚིག་གི་དོན་གྱི་ཁྱད་པར་སྟོན་པར་བྱེད་པས་ན།",
    "མིང་གིས་མེ་ཞེས་བརྗོད་པ་ཙམ་དུ་བསྟན་པ་ལས་ཚིག་གིས་རྔུམེ་ཚ་བ་ཞེས་བརྗོད་ན།"
  ]
}