    "དེ་དག་ནི་ཉོན་མོངས་པ་ཅན་དང་།",
    "རྟོག་པའི་ཚུལ་དུ་བྱེ་བྲག་མེད་ཀྱང་དམིགས་པ་དང་རྣམ་པའི་བྱེ་བྲག་གིས་ཕན་ཚུན་ཐ་དད་དོ།་།",
    "དེ་ལ་འཇིག་ཚོགས་ལ་ལྟ་བ་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་རྣམས་ལ་གང་བདག་དང་བདག་གིར་ལྟ་བའོ།",
    "ལོག་པར་ལྟ་བ་ནི་ལྟ་བ་གང་གི་རྒྱུའམ་འབྲས་བུའམ།",
    "ཉེ་བའི་ཉོན་མོངས་གཉིས་རྣམ་གཉིས།",
    "འདི་ཡང་ཀུན་ནས་མནར་སེམས་ཀྱི་རང་བཞིན་ཡིན་པས་ཁོང་ཁྲོ་བ་དང་ཐ་དད་པ་མ་ཡིན་མོད་ཀྱི་འདི་ནི་ཁོང་ཁྲོ་བའི་དུས་སྐབས་ཀྱི་བྱེ་བྲག་ལ་བཏགས་པའི་ཕྱིར་ཁོང་ཁྲོ་བའི་ཆར་གཏོགས་པ་སྟེ།",
    "འདི་ཡང་ཁྲོ་བ་བཞིན་དུ་ཞེ་སྡང་གི་དུས་སྐབས་ཀྱི་བྱེ་བྲག་ལ་གདགས་པ་ཡིན་པས་དེའི་ཕྱིར་བཏགས་པའི་ཡོད་པར་རིག་པར་བྱའོ།",
    "འཆབ་པ་ནི་བདག་གི་ཁ་ན་མ་ཐོ་བ་མཁྱུད་པ་སྟེ།",
    "དེ་ལ་ཕན་པར་འདོད་པའི་གླེང་བར་བྱེད་པས་དུས་སུ་ཁྱོད་འདི་ལྟ་བུ་བྱེད་པའོ་ཞེས་བསྟན་ན་གཏི་མུག་གི་ཆར་གཏོགས་པས་ཁ་ན་མ་ཐོ་བ་མཁྱུད་པ་ནི་འཆབ་པའོ།",
    "འཆབ་པ་ནི་གཏི་མུག་གི་ཆར་གཏོགས་པ་ཉིད་དེ།",
    "འདི་ནི་འགྱོད་པ་དང་རེག་པར་མི་གནས་པའི་རྟེན་བྱེད་ཀྱེཔའི་ལས་ཅན་ནོ།",
    "འགྱོད་ན་གདོན་མི་ཟ་བར་ཡིད་མི་བདེ་བ་དང་མཚུངས་པར་ལྡན་པར་འགྱུར་བས་རེག་པར་མི་གནས་སོ།",
    "འདི་ནི་ངག་གི་ཉེས་པར་སྤྱོད་པ་སྐྱེད་པའི་ལས་ཅན་དང་ཤེ།",
    "རེག་པར་མི་གནས་པའི་ལས་ཅན་ཏེ།",
    "ཐོས་པ་ལ་སོགས་པ་ཡོན་ཏན་གྱེ་ཁྱད་པར་མཐོང་ནས་ཞེ་སྡང་གི་ཆར་གཏོགས་པ་མི་བཟོད་པར་བྱ་བའི་རྗོ་སེམས་ཁོང་ནས་འཁྲུག་པ་ནི་ཕྲག་དོག་གོ།",
    "རང་གི་གནས་ལ་ཁྱབ་པར་འཁྲུག་པས་ཁོང་ནས་འཁྲུག་པ་སྟེ།",
    "དེ་སྔོན་དུ་འགྲོ་བའི་ཕྱིར་རེག་པར་མི་གནས་པ་སྟེ།",
    "ཡིད་མི་བདེ་བ་དང་རེག་པར་མི་གནས་པའི་ལས་ཅན་ཞེས་བྱའོ།",
    "གཡོ་ནི་རང་གི་ཉེས་པ་བཅབ་པའི་ཐབས་བཟུང་བ་སྟེ།",
    "རང་གི་ཉེས་པ་བཅབ་པའི་ཐབས་ནི་གཞན་མགོ་རྨོངས་ང་།",
    "དེ་ནི་རྙེད་པ་དང་བཀུར་སྙི་ལ་ལྷག་པར་ཆགས་ནས་འདོད་ཆགས་དང་གཏི་མུག་དེ་གཉིས་ཀྱིས་བདག་གི་ཉེས་པ་བཅབ་པའི་ཕྱིར་གཞན་མགོ་རྨོངས་པར་བྱེད་པས་དེ་གཉིས་འདུས་པ་ལས་མེདེ་གདགས་སོ།",
    "རྒྱགས་པ་ནི་བདག་གི་ཕུན་སུམ་ཚོགས་པ་ལ་ཆགས་པའི་རབ་ཏུ་དགའ་བ་སྟེ།",
    "ཕྱུག་པ་དང་བློ་དང་ཡིད་གཞུངས་པ་ལ་སོགས་པ་མཆོག་ཏུ་གྱུར་པ་ནི་རང་གི་ཕུན་སུམ་ཚོགས་པའོ།",
    "འདི་ནི་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "ངོ་ཚ་མེད་པ་ནི་ཁ་ན་མ་ཐོ་བས་བདག་ལ་མི་འཛེམ་པའོལས་དེ་དག་༡གི་ཆ་མ་ཡིན་པར་ཤེས་བཞིན་དུ་ཡང་གང་ཁ་ན་མ་ཐོ་བས་མི་ཁྱེའཛེམ་པ་དེ་ནི་ངོ་ཚ་གྲེད་པ་སྟེ།",
    "དེ་གཉིས་ནི་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་གྲོགས་བྱེད་པའི་ལས་ཅན་ནོ།",
    "རང་གི་རྒྱུད་ནི་མེད་དོ།",
    "འདི་ནི་ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་གྲོགས་བྱེད་པའི་ལས་ཅན་ཏེ།",
    "གཏི་མུག་གི་ཆ་ལ་བཏགས་པས་གཏི་མུག་གི་ཆར་གཏོགས་པ་ཉིད་ཡིན་གྱི་གུད་ན་མེད་དོ།",
    "བག་མེད་པ་ནི་ཆགས་པ་དང་ཞེ་སྡང་དང་གཏི་མུག་དང་ལེ་ལོ་གང་ཡིན་པ་དག་གིས་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་ལ་སོགས་པ་ལས་ཟིསེམས་མི་སྲུང་བ་དང་།",
    "བརྗེད་ངས་པ་ནི་དྲན་པ་ཉོན་མོངས་པ་ཅན་ཡིན་ཡེནོ།",
    "ཉོན་མོངས་པ་ཅན་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་དང་མཚུངས་པར་ལྡན་པའོ།",
    "རྣམ་པར་གཡེང་བ་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གི་ཆར་གཏོགས་པ་སེམས་རྣམ་པར་འཕྲོ་བའོ།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གང་དག་གིས་ཏིང་ངེ་འཛིན་ཀྱི་དམིགས་པ་ལས་ཕྱི་རོལ་དུ་གཡེང་བར་བྱེད་པ་དེ་དག་ལ་ཇི་ལྟར་མཐུན་མཐུན་དུ་རྣམ་པར་གཡེང་བ་གདགས་སོ།",
    "ཤེས་བཞིན་མ་ཡིན་པ་ནི་ཉོན་མོངས་པ་དང་མཚུངས་པར་ལྡན་པའི་ཤེས་རབ་སྟེ།",
    "དེ་ནི་གཏི་མུག་གི་ཆ་ལ་གདགས་པས་གཏི་མུག་གི་ཆར་གཏོགས་པ་སྟེ།",
    "དཔྱོད་པ་ཡང་སེམས་པ་དང་ཤེས་རབ་ཀྱི་བྱེ་བྲག་གི་བདག་ཉིད་དོ།",
    "དེ་གཉིས་ནི་རེག་པར་གནས་པ་དང་མི་གནས་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "ཉོན་མོངས་པ་དང་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།་།",
    "གཉིད་ཀྱང་ཉོན་མོངས་པ་ཅན་གྱི་སེམས་ཀྱིས་འཕངས་པ་དང་།",
    "ཉོན་མོངས་པ་ཅན་གྱི་སེམས་དང་མཚུངས་པར་ལྡན་པ་ནི་ཉོན་མོངས་པ་ཅན་ནོ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་སེམས་ཀྱིས་བྱེའཕངས་པ་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་སེམས་དང་མཚུངས་པར་ལྡན་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "འདོད་པ་དང་གནོད་སེམས་དང་རྣམ་པར་འཚེ་བའི་རྟོག་པའི་ཉོན་མོངས་པ་ཅན་ནོ།",
    "དེ་བཞིན་དུ་གཞན་ལ་གནོད་པ་བྱ་བའི་ཉྪཐབས་དཔྱོད་པ་ནི་ཉོན་མོངས་པ་ཅན་ནོ།",
    "གཞན་ལ་ཕན་གདགས་པའི་ཐབས་དཔྱོད་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "དེ་ལ་འགྱོད་པ་དང་གཉིད་དང་རྟོག་པ་དང་དཔྱོད་པ་ཉོན་མོངས་པ་ཅན་དེ་དག་ཉིད་ཉོན་མོངས་པ་སྟེ།",
