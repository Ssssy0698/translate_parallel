    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་འདི་དག་ལ་ཡོངས་སུ་སྨིན་པར་བྱེད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་འཛིན་པ་ལགས།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ནང་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཕྱི་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རང་བཞིན་སྟོང་པ་ཉིད་། དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་བཞི་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞི་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྟོབས་ལྔ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བསམ་གཏན་བཞི་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སྨོན་པ་མེད་པ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཏིང་ངེ་འཛིན་རྣམས་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "མི་འཇིགས་པ་བཞི་དངོས་པོ་དང་རྫས་དང་། མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བྱམས་པ་ཆེན་པོ་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཐམས་ཅད་ཤེས་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དངོས་པོ་དང་རྫས་དང་མཚན་མར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་འཛིན་པ་ལགས།",
    "དེ་རྣམ་པར་རྟོག་པ་དང་།",
    "རྣམ་པར་དཔྱོད་པ་ཉེ་བར་ཞི་ནས་ནང་ཡོངས་སུ་དང་སྟེ།",
    "བདེ་བ་ལ་རྣམ་པར་དཔྱོད་པ་བཏང་སྙོམས་པའོ་ཞེས་བརྗོད་པ་སྟེ།",
    "དེ་རྣམ་པ་ཐམས་ཅད་དུ་གཟུགས་ཀྱི་འདུ་ཤེས་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "ཐོགས་པའི་འདུ་ཤེས་རྣམས་ནུབ་པར་གྱུར་ཅིང་།",
