    "ཧོར་སྤྱི་ལས་ཐོག་དང་པོ་གྲགས་པ་རྣམ་རྒྱལ་ནས་སྔ་གཞུག་ཏུ་ཧོར་སྤྱི་ལས་ཐོག་དགུ་བྱུང་ཞིང་གཞུང་ས་ནས་མཁན་རིམ་རེས་མོས་ཞེས་མཁན་ཆུང་དང་རིམ་བཞིའི་གོ་མིང་ཡོད་པའི་སྤྱི་ཁྱབ་ལོ་བཞི་རེའི་མཚམས་སུ་བསྐོ་བཞག་གིས་རེས་མོས་སུ་གཏོང་སྲོལ་ཆགས་ཡོད་ལ།",
    "དེ་འོག་ལས་བྱ་རྩེ་ཤོད་དྲུང་རིགས་གཅིག་རེ་དང་།",
    "རུ་དཔོན་གཅིག་དང་སྲུང་བྱ་དམག་མི་ལྔ་བཅུའི་གྲུབ་པའི་གཞུང་སའི་ཞབས་སྡོད་སྣེ་མོ་ལས་འཛིན་པས་ཧོར་ཚོ་བ་སོ་དགུའི་སྲིད་དོན་དང་།",
    "ས་བོད་བྱང་རྒྱུད་ནི་གནའ་སྔ་མོ་ནས་མིའི་རིགས་འཚོ་སྡོད་བྱེད་པའི་གནས་ཤིག་ཡིན།",
    "བོད་བཙན་པོའི་རྒྱལ་རབས་སྐབས་སུ་སུམ་པ་སྟོང་གི་བུ་ཆུང་ཟེར་བའི་ཡུལ་གྱི་བྱེ་བྲག་དང་།",
    "ཧོར་ཚོ་བའམ་ཧོར་ཤོག་ཁ་སོ་དགུར་འབོད་པའི་ཡུལ་འདིའི་སྲིད་ཀྱི་སྐྱོང་ལུགས་ཀྱང་དུས་རབས་རིམ་བྱུང་གི་འཕེལ་འགྱུར་ཁྲོད་དུ་ལུ་གུ་རྒྱུད་དུ་ཟམ་མ་ཆད་པར་རིམ་གྱིས་བྱུང་ཡོད།",
    "ཉིན་མོ།",
    "གེ་མོ།",
    "ཧོར་སྤྱི་ལས་ཐོག་དང་པོ་གྲགས་པ་རྣམ་རྒྱལ་ནས་སྔ་གཞུག་ཏུ་ཧོར་སྤྱི་ལས་ཐོག་དགུ་བྱུང་ཞིང་གཞུང་ས་ནས་ལོ་བཞི་རེའི་མཚམས་སུ་མཁན་རིམ་རེས་མོས་ཞེས་མཁན་ཆུང་དང་རིམ་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "བཞིའི་གོ་མིང་ཡོད་པའི་སྤྱི་ཁྱབ་པ་ལོ་རེར་བསྐོ་བཞག་གིས་རེས་མོས་སུ་གཏོང་སྲོལ་ཆགས་ཡོད་ལོ།",
    "དེ་འོག་ལས་བྱ་རྩེ་ཤོད་དྲུང་རིགས་གཅིག་རེ་དང་།",
    "རུ་དཔོན་གཅིག་དང་སྲུང་བྱ་དམག་མི་ལྔ་བཅུའི་གྲུབ་པའི་གཞུང་སའི་ཞབས་སྡོད་སྣེ་མོ་ལས་འཛིན་པས་ཧོར་ཚོ་བ་སོ་དགུའི་སྲིད་དོན་དང་།",
    "ཧོར་སྤྱི་ལས་ཐོག་དང་པོ་གྲགས་པ་རྣམ་རྒྱལ་སྐབས་ནས་སྔ་ཕྱིར་ལས་ཐོག་དགུ་བྱུང་ཡོད་པའི་གནས་ཚུལ་གཤམ་དུ་བཀོད་པའི་རེའུ་མིག་དང་པོར་གསལ།",
    "གཅིག་ནས་སྔ་མོའི་ཁྲལ་འུ་ལམ་ལུགས་ཀྱི་རྨང་གཞིའི་སྟེང་ཧོར་ཚོ་པ་སོ་དགུའི་ཐེམ་དུད་ལ་ཞིབ་བཤེར་གྱི་དུས་སྐབས་སོ་སོར་རིམ་པ་བཞིན་དུ་སྒོ་ཁྲ་མིང་གཞུང་དང་།",
    "དེ་མིན་དུས་སྐབས་སོ་སོར་ཁ་མཆུ་གྱོད་གཏུགས་བྱུང་བར་དཔྱད་མཚམས་ཁྲ་མ་སོང་བའི་ཡི་གེཕན་ཚུན་རྐུ་ཇག་མི་རྒྱག་པའི་མནའ་གན།",
    "ཧོར་སྤྱི་སེར་སྐྱ་ངོ་ལས་རེས་འཁོར་ཐོག་ས་སྲུང་རུ་དམག་ཀྱང་དབུས་གཙང་འགྲོ་རེས་ཀྱིས་བསྡད་རྒྱུན་ལོ་བཞི་རེའི་མཚམས་གསར་རྙིང་བརྗེ་ལེན་མཛད་རྒྱུའི་རྒྱས་དཔྱད་བཞིན་མཁན་ཆུང་གཡུ་ཐོག་པས་ཧོར་སྤྱི་གནང་པའི་ལོ་དུས་རྫོགས་མཚམས་སུ་ཧོར་ཚོ་སོ་དགུ་སྤྱི་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "གསུམ་ནས་ཧོར་སྤྱི་རྩེ་ཤོད་མཁན་རིམ་རེས་འཁོར་ངོ་ལས་ཐོགལས་བྱ་རྩེ་ཤོད་དྲུང་རིགས་གཅིག་རེ་དང་།",
    "རུ་དཔོན་གཅིག་དང་སྲུང་བྱ་དམག་མི་ལྔ་བཅུ་ས་གནས་སུ་ཕེབས་བསྐྱོད་ཐོག་ས་གནས་རང་གི་དཔོན་ཁག་རྣམས་ཀྱང་རིམ་པ་བཞིན་དུ་དཔོན་གནས་ལྔ་པ་དང་།",
    "ཚོ་པ་ཆེ་ཁག་གི་དེ་སྔའི་བརྒྱ་དཔོན་ཁག་དཔོན་གནས་རིམ་པ་དྲུག་པར་བསྒྱུར་བ་དཔོན་ཁག་ཉེར་ལྔ།",
    "དེ་མིན་བརྒྱ་དཔོན་འོག་གི་དཔོན་འགོ་ཁག་ཅིག་རིམ་པ་བདུན་པའི་ལྡིང་དཔོན་དུ་བསྒྱུར་པའི་དཔོན་ཁག་ཞེ་གསུམ་ཡོད།",
    "རེའུ་མིག་དང་པོ།",
    "ཧོར་སྤྱི་ལས་ཐོག་རིམ་བྱོན་གྱི་གནས་ཚུལ་རེའུ་མིག་སྤྱི་ལོ་སྤྱི་ལོ་ར",
    "འདུད་ནར་བུ་མིསམོ་ལོའི་བོད་ཟླ་པའི་པ་ཚེས་ཉིན།་།",
    "དོན་གྲུབ་རྒྱལ་པོ་དཔོནག་ཤིང་བྱི་ལོ་སྟེ་འགུག་གིསརྒྱུཧོར་ཚོ་སོ་ནང་མི་སེར་སྤྱི་མགྲིན་ལས་བག་མ་ནས་རྒྱལ་བློནམཚན་ལོ་ལོར་ཞབས་འཁོད་ཀྱི་བདེ་སྡུག་སྙན་ད་ལྟ་ཞུསད་གཙང་མོདའ་དཔོནབཟོས་ཏེ་བཀའ་ཤོག་ལ་ལས་ཞབས་གནས་དབྱུང་།",
    "རེའུ་མིག་ཏུ་རྟགས་བཀོད་པ་ནི་གནས་སྐབས་སུ་གཏན་མ་འཁེལ་བར་ཞིབ་འཇུག་བྱེད་རྒྱུར་ལུས།",
    "གི་དུས་མཇུག་ཏུ་བྱུང་བའི་བོད་བྱང་རྒྱུད་ཀྱི་སྤྱི་ཁྱབ་རིམ་པའི་ས་གནས་སྲིད་འཛིན་ཞིག་ཡིན།",
    "བཀའ་ཤག་གིས་སྲིད་སྐྱོང་ཡོངས་འཛིན་སྟག་བྲག་ལ་ཧོར་སྤྱི་མེད་པ་བཟོས་ཏེ།",
    "ཧོར་སྤྱི་མཁན་རིམ་རེས་མོས་གཏོང་སྲོལ་ལས་བྱང་སྤྱི་མཁན་རིམ་སྦྲེལ་པོ་ཞེས་རྩེ་དྲུང་མཁན་ཆུང་དང་ཨ་པ་ཤོད་དྲུང་རིམ་བཞིའི་གོ་གནས་ཡོད་པ་སྦྲེལ་པོ་གསར་བསྐོ་བགྱིས་ཏེ་གཏོང་བ་དང་།",
    "རེའུ་མིག་གཉིས་པ།",
    "བྱང་སྤྱི་ལས་ཐོག་རིམ་བྱོན་གྱི་གནས་ཚུལ་རེའུ་མིག་སྤྱི་ལོ་སྤྱི་ལོ་ལོ་དུས་བྱང་སྤྱིའི་ལས་ཐོག་ཙ་སྤྱི་ཁྱབ་པ།",
    "རེའུ་མིག་ཏུ་རྟགས་བཀོད་པ་ནི་གནས་སྐབས་སུ་གཏན་མ་འཁེལ་བར་ཞིབ་འཇུག་བྱེད་རྒྱུར་ལུས།",
    "ཀྱིཧོར་སྤྱི་སྟེ་ཧོར་ཚོ་བ་སོ་དགུའི་སྤྱི་ཁྱབ་ཀྱི་བསྐོ་བཞག་གནས་བཞི་པའི་རྩེ་དྲུང་མཁན་ཆུང་དང་ཤོད་དྲུང་རིམ་བཞི་རེས་འཁོར་དང་།",
    "ཧོར་སྤྱི་དང་བྱང་སྤྱི་གཉིས་ཀ་རྒྱས་དཔྱད་འཆར་གཞི་ཕྱག་རྟགས་བཞིན་ལོ་བཞི་རེའི་མཚམས་སྤྱི་ཁྱབ་པ་གསར་རྙིང་བརྗེ་ལེན་བྱེད་པ་དང་།",
    "གསར་པའི་ས་སྲུང་གྲ་བཞི་རུ་དམག་གི་ཕོགས་ཐོབ་བཅས་ཆུ་ཁྱི་ཟླ་ཚེས་བར་རྙིང་པས་སྤྲོད་རྒྱག་དང་འབྲེལ་གཞུང་འབབ་རྩིས་ཞུ་དང་།",
    "འབྲུ་རིགས་ད་ལམ་གསར་པར་རྩིས་སྤྲོད་མ་བྱུང་གཤིས་བསྡད་སོང་གཞུང་རྩིས་རྙིང་པས་བྱེད་རྒྱུ་སྨོས་མེད་ཐོག་ད་༦་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "བོན་ལུགས་མཁའ་འགྲོའི་སྐུ་ལི་མ་གཅིག་ཞེས་པ་ད་ལམ་ཆད་སོང་བ་སྐུ་དེ་ག་གསང་གྲགས་ཀྱི་འབྲི་རུར་དངོས་པོ་ལག་ཡོད་གཞུང་ཁྲ་ཨང་འཁོད་གསལ་རས་འཛར་ཨང་འཁོད་པའི་ཀོ་དམར་ལག་སྒམ་ནང་དངུལ་གྱི་སྦྲུལ་པང་རྟག་བརྒྱད་ཚ་གསེར་ཅན་བྱིན་རྟེན་རང་འགྲིགས་ཞེས་ནཔ་དེའི་ནང་ནོར་འཁྲུལ་གྱི་འཇུན་ཐོལ་གྱུར་བདུན་པ་སླར་དངོས་པོ་ཞིབ་བཤེར་སྐབས་གོང་གསལ་གའུ་ནང་ནས་སྐུ་འདི་ལོན་ན་སྨོས་མེད།",
    "ཧོར་སྤྱི་མཁན་རིམ་ལས་རེས་དང་།",
    "རྒན་པོ་སོགས་ལས་ཚན་ཁག་གི་བསྐོ་བཞག་དང་འཕོ་ལེན་གྱི་སྐོར་གྱི་གཞུང་ཡིག་༣ ཆབ་འབངས་བདེ་སྡུག་གི་སྐོར།",
    "འབུ་སྤུས་ཚོང་གི་གྱོད་དོན།",
    "༧ ནོར་སྲིད་གཏོང་ཡོང་གི་སྐོར།",
    "ཞབས་བརྟན་རིམ་གྲོའི་འགྲོ་སོང་གི་ཐོ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་དུ་པར་དུ་བཏབ།་",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།་",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པར་དུ་བཏབ།",
    "བདེ་སྐྱིད་བཟང་མོ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏང་།",
    "སི་ཁྲོན་དཔེ་སྐྲུན་ཚོགས་པ་དང་སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "སི་ཁྲོན་དཔེ་སྐྲུན་ཚོགས་པ་དང་སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "སི་ཁྲོན་དཔེ་སྐྲུན་ཚོགས་པ་དང་སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གིས་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ནང་པར་དུ་བཏབ།",
    "བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གི་སྤྱི་གས་ཉྩ།",
    "ལྕགས་སྦྲུལ་བོད་ཟླ་པའི་ཚེས་ཉིན་སྲིད་སྐྱོང་གིས་ཞིབ་འཇུག་སོང་།་",
    "ལས་གཞི་འདི་ཆོག་མཆན་ཐོབ་པའི་ཨང་གྲངས་ནི་ཡིན།་",
    "ཞིབ་འཇུག་གི་ལས་ཀ་གནང་མུས་ཡིན།",
    "རང་རྟོགས་ཡོད་མིན་ལ་མ་ལྟོས་པར་ལུགས་བསྒྱུར་སྟོབས་བསྐྱེད་ལ་རེ་བའི་སྲིད་ལུགས་གསར་བསྒྱུར་གྱི་མཛད་སྒོ་རབ་དང་རིམ་པར་སྤེལ་ཡོད།",
    "བདག་གིར་བཟུང་བའི་ལམ་སྲོལ་དངོས་སུ་ཆགས།",
    "བཙན་པོའི་རྒྱལ་རབས་འཐོར་ཞིག་ཏུ་སོང་རྗེས།",
    "ལོ་ངོ་བཞི་རྒྱུ་ཙམ་རིང་བོད་ཁམས་ཧྲིལ་པོ་གཅིག་འོག་གཅིག་གིས་མི་འདུ་བའི་སིལ་བུར་ལུས་ཤིང་།",
    "གངས་ལྗོངས་འཛིན་མའི་ཁྱོན་དུ་ཡི་རངས་རྗེས་སུ་འགྲོ་བའི་སྐྱེ་ཚོགས་ཇེ་མང་དུ་ཕྱིན།",
    "ལྷ་འབངས་མི་སེར་དུད་ཁྱིམ་༡༢༨ ༡༩ཙམ་བཅས་ཡོད་པ་རེད།",
    "སྐུ་དྲག་གི་མངའ་ཐང་འཕེལ་བར་ཚད་བཀག་ངེས་ཅན་ཡོད་ཕྱིར།",
    "རིམ་པས་གཞུང་ས་ནས་ཁོང་ཚོའི་ཕ་གཞིས་གང་ཡོད་བུ་རབས་ཚ་བརྒྱུད་ཀྱིས་རྒྱུན་འཛིན་བྱས་ཆོག་པར་ཁས་བླངས་པ་དང་།",
    "ཁོང་ཚོས་འཛིན་སྤྲས་བྱེད་པའི་གཞིས་ཀ་རྣམས་གཞུང་ས་ནས་བདག་སྐྱོང་བྱ་རྒྱུར་རྩིས་སྤྲོད་བྱེད་དུ་བཅུག་ཡོད་པ་རེད།",
    "བྱེ་བྲག་འབྱོར་སྟོབས་འཁོས་ཀ་ཆེ་ཆུང་གི་ཁེ་ཕན་ལ་གཏུག་པའི་སྙོམ་སྒྲིག་ཆེ་ཙམ་བྱས་ཡོད་ཅིང་།",
    "གཞིས་ཡུལ་ཐག་ཉེ་ཟླ་སྒྲིལ་དུ་སོང་སྟེ་དཔུང་ཁ་བཙན་པའི་སྐྱོན་དུ་འགྲོ་བ་ལྟར་མ་ཡིན་པར།",
    "དེ་བསྟུན་སྒེར་པ་སྐུ་དྲག་གི་གཞིས་ཀ་མངའ་རིས་ཀྱི་འཛིན་ཐོབ་ལའང་ངེས་ཆ་དེ་ཙམ་མེད་ཅིང་།",
    "དེ་ལས་ཁག་ཅིག་གཞུང་གི་ལས་སྣེ་ཞབས་སྡོད་ཆེ་ཆུང་གི་ཕོགས་རྟེན་དུ་སྤྲོད་ཀྱི་ཡོད་པ་དང་།",
    "དེ་བྱིངས་ཁྲལ་པ་དྲགས་རིགས་ལ་བོགས་མར་བཏང་སྟེ་ཁྲལ་བོགས་བསྡུ་ལེན་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "མ་གཞི་བྱས་ན་ཕོགས་རྟེན་འཛིན་ཐེབས་དེ་རིགས་ཞབས་སྡོད་སོ་སོའི་ལས་གནས་བསྐོ་འཕོ་དང་བསྟུན་ནས་སྤྲོད་ལེན་བྱེད་དགོས་མོད།",
    "དུས་རབས་བཅོ་བརྒྱུད་པའི་དུས་མཇུག་ལ་སླེབས་དུས་གཞུང་གཞིས་བསྡོམས་༡༩ཙམ་ཡོད་པའི་རྒྱ་ཁྱོན་སོན་ཁལ་༢༣༢༨ ༡ཙམ་ཟིན་གྱི་ཡོད་པ་རེད།",
    "སྐྱིད་རྡོ་གསུམ་ཚུགས་ལྟར་ཆེ་ཆུང་དང་མཐོ་དམན་གྱི་དབྱེ་ཁྱད་ཆེར་མེད་པའི་གོང་བུ་གཅིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "གཞིས་ཀ་བྱ་བ་ཡང་ས་ཆ་གང་ཡིན་པ་དེའི་ནང་གི་ས་ཁང་མི་ཕྱུགས་དང་།",
    "རི་ཆུ་རྩི་ཤིང་སོགས་ཐམས་ཅད་ཚུད་པའི་མངའ་རིས་ཤིག་ཡིན་པ་ལས་ས་ཞིང་གཅིག་པུ་མ་རེད་ལ།",
    "འགའ་རེར་བརྒྱ་ཆ་ལྔ་བཅུ་ཟིན་པའང་ཡོད་པ་རེད།",
    "རང་བཞག་ནི་གཞིས་ཀའི་བདག་པོ་རང་ནས་མངའ་ཚབ་གཞིས་སྡོད་བསྐོ་གཏོང་གིས་གཉེར་སྐྱོང་དོ་དམ་བྱེད་པའི་ས་ཞིང་ཡིན་ཞིང་།",
    "དབྱར་ཆུ་འདྲེན་དང་དགུན་ལུད་གསོག་སོགས་ས་ཞིང་འདེབས་ཁོལ་དང་འབྲེལ་བའི་ལས་རིམ་ཡོད་དགུ་སྒྲུབ་ཀྱི་ཡོད་པ་རེད།",
    "ལག་ཤེས་ཡོད་མཁན་འཚོ་ཐབས་འཚོལ་ཕྱིར་ཡུལ་གཞན་དུ་སོང་ནའང་འདྲ།",
    "སྐྱེ་འཆི་ཐོ་འགོད་དང་མི་བོགས་བསྡུ་སྐུལ་སོགས་ཀྱི་སྦྲེལ་ཐག་བཙན་པོས་དམ་དུ་བསྡམས་པ་ལས་ཐར་ཐུབ་ཀྱི་ཡོད་པ་མ་རེད།",
    "གཞུང་རྒྱུག་གི་ཁྲལ་རྒྱབ་སྟོངས་རྙིང་དང་།",
    "གུང་བཀའ་བློན་སོགས་མི་དྲག་གི་འདོན་མི་སེར།",
    "ཡང་ན་ཁྲལ་པའི་དུས་ཚང་རྩ་སྟོངས་སུ་སོང་བ་སོགས་ཀྱི་གནས་ཚུལ་བྱུང་ན་མ་གཏོགས་གང་བྱུང་དུ་བསྡུ་ལེན་བྱེད་སྲོལ་མེད་དེ།",
    "ཁྲལ་པས་རང་ལ་འཁྲི་བའི་ཁྲལ་རིགས་རྣམས་ནར་འགྱངས་མེད་པར་དུས་ཐོག་ཏུ་སྤྲོད་ཐུབ་ཕྱིན་རང་གི་ཁྲལ་རྟེན་ཕ་གཞིས་དེ་མི་རབས་ནས་མི་རབས་བར་ཤུལ་འཛིན་བྱེད་ཆོག་པ་མ་ཟད།",
    "ཅ་གཞིས་ཀ་སོ་སོ་གནས་ཚད་དམའ་མོའི་ངང་ནས་རང་མཁོ་རང་སྒྲུབ་བྱེད་པ་ལས།",
    "ལུགས་མཐུན་བེད་སྤྱོད་ཀྱིས་ཐོན་ཁུངས་གསར་འབྱེད་སོགས་བྱས་ན་འཐུས་པ་ཡིན་མོད།",
    "འཕྲལ་འཕྲལ་རྩོད་དཔྱོད་ཐོག་ནས་འགལ་བ་པོའི་སྟེང་རྩ་ར་རྒྱངས་འབུད་དང་།",
    "ས་རིགས་རྒྱུ་དངོས་གཞུང་ལེན་སོགས་སྐབས་སྦྱར་གྱི་ཉེས་པ་ཡན་སོང་མེད་པ་གཏོང་ངེས་ཡིན་པའི་བཀའ་བཙན་ལྗིད་ནོན་ཆེ་བཙིའབེབས་ཀྱི་ཡོད་པ།",
    "བཀའ་ཤག་གི་བཀའ་ཡིག་ཤོག་ལྷེ་གཅིག་གིས་དཔོན་འགོ་གནས་ལས་དབྱུང་ཞིང་།",
    "དེ་མིན་ཐོན་སྐྱེད་ལག་རྩལ་གྱི་བསྒྱུར་བཀོད་དང་མཐོར་འདེགས་སོགས་ཀྱི་ཐད་ལ་སྣང་བ་སྤུ་ཙམ་གཏོང་གི་མེད་དེ།",
    "གཞུང་ས་ནས་ཁོང་ཚོའི་འཚོ་རྟེན་ཕ་གཞིས་གང་ཡོད་ཕ་ཚ་བུ་བརྒྱུད་ཀྱིས་རྒྱུན་འཛིན་བྱས་ཆོག་པ་མ་ཟད།",
    "གཞིས་ཀའི་འབབ་ཡོང་ལ་བརྟེན་ནས་རྩོལ་མེད་དུ་འཇིག་རྟེན་ཕུན་ཚོགས་ཀྱི་འདོད་ཡོན་ལ་ལོངས་སུ་སྤྱོད་པ་གོམས་ལོབས་སུ་སོང་ཐ་ན་གཞིས་ཀའི་དམིགས་རྟེན་དུ་གྱུར་པའི་གཞུང་གི་ལས་འཁྲིར་ཡང་དང་བ་སྟོན་པར་མི་སྟེ།",
    "གཡོག་རིགས་ཚབ་གཏོང་གིས་ཁྲལ་སེལ་ཙམ་བྱེད་ཀྱི་ཡོད་པ་རེད་ལ།",
    "སྐུལ་གཏོང་བྱས་པའི་མངའ་ཚབ་དཔོན་ཚབ་དེ་དག་གིས་ནི་འདོད་གནག་ཞེ་བཅངས་ཀྱིས་བཀའ་གཏན་གཡོ་ཞུས་ཐོག་ནས་གཞུང་འབབ་དང་ཁྲལ་རིགས་སྔར་འཁྲི་མི་སྒྲུབ་པ་དང་ན།",
    "ས་ཞིང་སྒེར་བདག་གིས་ཁྲལ་རིགས་གཞུང་རྒྱུགས་ཐོག་ནག་པོ་ཡོར་འགེལ་བྱེད་པ།",
    "གཞུང་གི་ལར་རྒྱ་དང་འབངས་ཀྱི་འཚོ་ཚིས་སོགས་ཀུན་ལ་གནོད་ཚབས་ཆེན་པོ་བྱེད་ལ།",
    "གཞུང་རྒྱུག་གི་ཁྲལ་རྒྱབ་སྟོངས་རྙིང་དང་།",
    "སྤྲོད་བུད་ཀྱི་ས་རིགས་སོགས་སྟོངས་ཡིན་ཚུལ་ལ་བསྙད་དེ་འདེབས་བདག་བྱེད་པ་སོགས་ལ་བརྟེན་ནས་ས་ཞིང་གི་གཞི་རྒྱ་ཆེ་རུ་གཏོང་ཐབས་བྱེད་པ་དང་།",
    "བུད་སྟོངས་ས་ཞིང་སྒེར་བདག་གིས་ཁྲལ་རིགས་གཞུང་རྒྱུག་ཐོག་ནག་པོ་ཡོར་འགེལ་བྱེད་པ་སོགས་ལ་བརྟེན་ནས་གཞུང་འབབ་དང་ཁྲལ་རིགས་སྔར་འཁྲི་སྒྲུབ་མི་དགོས་པ་བྱེད་པ་སྟེ།",
    "ཁྲལ་རྟེན་ས་ཞིང་མང་ལ་མི་ཆ་ཉུང་བའི་ཁྲལ་པའི་དུད་ཚང་ལ་མངའ་བདག་གིས་བཀོད་ཁྱབ་བྱས་ཏེ་མི་ཅུང་མང་བའི་ཁྲལ་པའི་དུད་ཚང་ནས་ཁྲལ་རོགས་གཏོང་སྲོལ་ཡོད་ལ།",
    "སིག་མི་ཡོང་བའི་བཀོད་ཁྱབ་གནང་བ་སོགས་ཡོད་མོད།",
    "རང་འཚམ་གྱིས་གཞིས་ཀ་དང་ཁ་བྲལ་ཆོག་གི་ཡོད་པ་མ་རེད་ལ།",
    "གཞུང་ས་ནས་ཀྱང་མི་རྩ་ཕྱིར་གྱུར་རིགས་ལ་ཡུལ་འགུག་ཁུངས་འཇུག་བྱེད་པ་ལས་བུད་སྟོང་ཁུངས་མེད་དུ་བཞག་མི་ཆོག་པའི་བཀའ་རྒྱ་ལྗིད་ནོན་ཆེ་བ་རིམ་པར་སྩོལ་གྱི་ཡོད་པར་བརྟེན།",
    "བོད་ཀྱི་ཕྱི་ཕྱོགས་ཉོ་ཚོང་ལ་སྔ་ན་མེད་པའི་འཕེལ་རྒྱས་ཆེན་པོ་བྱུང་ཡོད་མོད།",
    "གཞིས་ཀའི་ཐོན་སྐྱེད་དང་ཁ་བྲལ་བའི་གྲོང་མི་རང་རྐྱ་འཕེར་བ་འབྱུང་ཐབས་ཡོད་པ་མ་རེད།",
    "ཚོང་ར་གཙོ་ཆེ་བ་ཚང་མ་རྒྱ་གར་དབྱིན་གཞུང་གི་ཚོང་པའི་རེད།",
    "དགོས་ངེས་ཀྱི་རྒྱུ་སྟོབས་ཡོད་མཁན་རྐྱང་རྐྱང་རེད།",
    "ཚོང་ར་ཁག་དང་འབྲེལ་བ་བྱེད་ནམཁན་མངའ་བདག་གི་གཞིས་ཀ་ཡིན་པ་ལས་ཞིང་པའི་དུད་ཁྱིམ་མིན་པའི་ཕྱིར།",
    "ཚོང་ལས་ཀྱི་ཁེ་སྤོགས་ཡོད་ཚད་ཀྱང་ཞིང་བྲན་བདག་པོའི་སྦྲ་ཁུག་ནང་རེད་ལ།",
    "ཁྲལ་བོགས་དེ་བས་ལྕི་བ་བསྡུ་རྒྱུའི་རེ་འདོད་ཆེ་ནས་ཆེ་རུ་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "འུ་ལག་བཙན་སྐུལ་སོགས་བྱེད་པའི་ལམ་ནས་ཞིང་བྲན་རྣམས་ལ་ཤ་ཟད་རུས་ལ་གཏུགས་པའི་བཙིར་གནོན་བཤུ་གཞོག་གིས་མ་རྩ་གསོག་སྒྲུབ་བྱས་ཏེ།",
    "ཧིན་བོད་ཉོ་ཚོང་ཐོག་ནས་བག་མེད་འཚོ་བའི་དགོས་མཁོ་སྐོང་ཐབས་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "མཆ་གཏེར་རྡོ་བསྔོག་འདོན་ཚུད་པའི་ལས་ཚན་དར་བར་སྐུལ་འདེད་ཀྱང་གཏོང་ཐུབ་མེད་པ་དེ་ར་སྤྲོད་བྱས་ཡོད་པ་རེད།",
    "དངོས་ཟོག་དེ་རིགས་ནི་མངའ་བདག་ཁག་གིས་རྒྱ་ཁྱབ་ཞིང་བྲན་རྣམས་ཀྱི་ལག་ནས་བཙན་བསྡུ་བཙན་འཕྲོག་བྱས་པ་ཤ་སྟག་རེད།",
    "དེ་བས་གཞིས་ཀའི་བྲན་ཁྱིམ་རྣམས་མི་སེར་སྤེལ་མཁན་གྱི་ཚོང་པ་དང་བཀས་བཀོད་རྒྱུད་འཛིན་ཞིང་བྲན་བདག་པོའི་ཉེས་བཙིར་འོག་མུ་གེའི་སྒང་ལ་ཟླ་ལྷག་གི་སྐལ་བ་བཟུང་བར་གྱུར་པས།",
    "ཨེར་ཏི་ཎིར་སྦྱོར་འཇགས་བསྩལ་བ་ནི་མངོན་གསལ་དོད་པོ་རེད།་",
    "ལྕགས་སྟག་ཞིབ་གཞུང་གི་ཤོག་གྲངས་ལ་གསལ།",
    "དུང་དཀར་ཚིག་མཛོད་ཆེན་མོ་ཀྲུང་གོའི་བོད་རིག་པ་དཔེ་སྐྲུན་ཁང་།",
    "འི་ལྕགས་སྟག་ཞིབ་གཞུང་གི་འགོ་མཆན་ཁག་ལ་གསལ།་",
    "དུང་དཀར་ཚིག་མཛོད་ཆེན་མོ་ཤོག་གྲངས་ལ་གསལ།",
    "ལྕགས་སྟག་རྒྱ་ཁྱབ་ཞིབ་གཞུང་ཁག་གི་གཤམས་བསྡོམས་གཏན་འཁེལ་ཕྱག་རྟགས་འགྱུར་མར་གསལ།",
    "ལྷག་པར་དུ་རྒྱུ་ཡིག་གི་ལམ་ནས་དེ་འབྲེལ་གྱི་ཞིབ་འཇུག་བྱས་པའི་དཔྱད་འབྲས་མི་ཉུང་ཙམ་ཐོན་ཡོད་མོད།",
    "དེ་ལས་ཐོབ་པའི་ངོས་འཛིན་ཡང་ངེས་ཤེས་འདྲོང་ཐུབ་པ་རེད།་",
    "མིང་གི་བྱུང་འཕེལ་ལེགས་པར་རྟོགས་གྱུར་ན།",
    "ནི་ཚིག་གི་ཐུང་བའི་མཐར་ཐུག་པ་སྙད་པ་སྟེ།",
    "དངོས་པོ་གང་ཞིག་གང་ཟག་གིས་ཐོག་མར་ངོས་འཛིན་ཚེ།",
    "དྲེད་མོང་།",
    "མིང་གི་འཕེལ་སྲོལ་མང་ཡང་།",
    "མིང་གཞི་དང་མིང་མཐའ་སྦྱར་བའི་ས་མིང་གི་འཕེལ་སྲོལ།",
    "འཕུལ་རྟེན་རྣམས་ཀྱི་འཇུག་ཡུལ་ཡིན་མོད།",
    "སྐབས་འདིར་དོན་གྱི་ངོ་བོ་ཞིག་སྟོན་པའི་སྒྲ་གཉིས་ཡན་ལས་མིང་གི་གཞི་མར་གྱུར་པའི་སྒྲ་ལ་ཟེར་བ་ཡིན།",
    "མིང་མཐའ་མི་གཅིག་པ་སྦྱར་ནས་མིང་དུ་མ་རེ་བྱུང་བ།",
    "༢ ས་པ་བྲིས་པའི་གཟུགས་རིས་ལ་རི་མོ་ཟེར་བ་ལྟ་བུ་སོགས་ནང་པ་སངས་སོ།",
    "རི་མོའི་རི་ནི།",
    "འདི་རིགས་མིང་གི་འཕེལ་སྲོལ་གཞན་དག་བསལ་པ་ཞ་༥ དཔག་ལས་ཀྱང་ཡོད་པ་རིག་པར་བྱའོ།",
    "རྒྱ་སྐད་དུ་མོ་ཀུའུ་ཟེར་བའི་སྤང་སྐྱེས་བཟའ་རུང་བ་ཞིག་ལ་ཤ་མོ།",
    "༢ མིང་མཐའ་གུ་ངུ་འུ་བུ་གོང་འགྲིག་སྦྱར་ནས་མིང་དུ་མ་རེ་བྱུང་བ།",
    "ར་དང་རེའུ།",
    "རེང་བུ་ལྟ་བུ་སོགས་རིགས་བསྒྲེ་བར་བྱའོ།",
    "གང་མིང་གཞིར་བཟུང་ནས་འབྲེལ་ཡོད་ཀྱི་མིང་རྣམས་སྦྱར་བའི་མིང་གི་འཕེལ་སྲོལ།",
    "ལག་གི་བླ།",
    "རེ་དེའུ།",
    "ལྟ་བུ་སོགས་འབྲེལ་གཞི་སྟེ་མིང་གི་ཆ་ཤས་གཙོ་བོ་སྔ་མ་དང་།",
    "དེ་ས་ན་བཞིན་གོང་གི་ལག་པ་རང་ལྡོང་དུ་བཟུང་ནས།",
    "དེའི་སྒྲ་གདངས་ཅུང་ཟད་རེ་བསྒྱུར་ནས།",
    "མཚོན་དོན་གྱི་མིང་གང་འཚམ་ཞིག་སྦྱར་ནས་མིང་དུ་མ་རེ་བྱུང་བ།",
    "ཁལ་རྟ་ལྟར་གོ་ཆོད་པའི་ཤིང་གིས་བཟོས་པའི་འདྲུད་བྱེད་ལ་ཤིང་རྟ་དང་།",
    "ནསདམའ་འབེབས་བྱེད་པའི་སྒོ་ནས་བུད་མེད་ལ་ནག་མོ་ལག།",
    "མིང་གཞི་ཞིག་གི་སྒྲ་ཅུང་ཟད་བསྒྱུར་ནས་མིང་དུ་མ་རེ་བྱུང་ན་ས་༦དག་དཀར་ནག་བ།",
    "རྡོ་རིལ་རིལ་ལ་གོར་ག་དངུལ་གྱི་དོང་ཚེ་ལ་སྒོར་མོ།",
    "ཁོངས་སུ་གཏོགས་པ་ལ་སྐོར་ཏེ་ཚན་རིག་གི་སྐོར་ལྟ་བུ།",
    "ཟས་བསིལ་མ་ལ་བསིལ་གཟན་ཟེར་བ་རྣམས་མིང་གི་རྣམ་གྲངས་ཡིན་ལ།"
  ]
}