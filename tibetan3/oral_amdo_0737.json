    "འཛུགས་སྒང་གྲོལ་གསུམ་གྱི་སྟོན་མོ།",
    "རེ་ཐོབ་ཀྱི་ཡོད་ཡཾན་ལ་༢༥༨༤༤ སར་གཞན་ཁ་༣༡ ན་༣ ལས་རིགས་དང་རྒྱུ་ཚའི་མིང་།",
    "ཨ་༢༢༢༣༩༧༥པར་ཤིང་བཅུ་དྲུག་རེར་རིན་འབྲུ་ཁལ་ལྔ་རེ་བརྩིས།",
    "འཛུགས་སྒང་གྲོལ་གསུམ་གྱི་སྟོན་མོ།",
    "དེའི་རིན་ཐང་ཐད་དེང་སང་ལྷ་སར་འབྲུ་ཁལ་རེར་སྒོར་བཅུ་བཞི་རེ་བྱེད་པའི་ཐང་གཞིར་བརྩིས་ན་སྒོར་ས་ཡ་དྲུག་དང་ཉིས་འབུམ་ཁྲི་མེད་དྲུག་སྟོང་དྲུག་བརྒྱ་བཞི་བཅུ་ཞེ་བརྒྱད་ཡིན་ཞིང་།",
    "མི་དམངས་ཤོག་སྒོར་ལ་བརྩིས་ན་པོད་རེར་མ་གནས་སྒོར་ཉིས་ཁྲི་དགུ་སྟོང་བརྒྱ་དང་སུམ་ཅུ་སོ་དགུ་དང་སྒོར་ཟུར་གཅིག་སྐར་དགུ་ཡིན།",
    "དཔར་ཁང་གི་སྒྲིག་སྲོལ་ལམ་ལུགས་སྐོར།",
    "དེང་སང་གི་དུས་སྐབས་གང་ཡིན་རུང་དཔར་གཞི་གསར་སྐྲུན་གྱི་མ་གནས་ནི་ཧ་ཅང་མཐོ་པོ་ཡིན་པས།",
    "དཔར་ཁང་དོ་དམ་པར་གླུ་མང་བ་སྤྲོད་ལེན་གྱི་རིགས་བྱེད་མི་ཆོགའོན་ཀྱང་དོ་དམ་པར་ལོ་གཅིག་གི་འཚོ་བ་ལྡང་ངེས་ཀྱི་འབྲུ་དངུལ་ཤ་མར་སོགས་ཕོགས་ཐོབ་ཟུར་དུ་སྤྲོད་ཀྱི་ཡོད།",
    "དེང་སྐབས་ཀྱི་རང་འགུལ་འཕྲུལ་དཔར་ནི་དཔར་གཞི་སྒྲིག་སྦྱོར་ཐེངས་གཅིག་གིས་དཔེ་དེབ་ཆ་ཚང་ཁྲི་ཁ་ཤས་དཔར་འདེབས་བྱེད་ཆོག་གི་ཡོད་པས་དཔར་གྲངས་ཇི་ཙམ་མང་བ་དེ་ཙམ་གྱིས་མ་གནས་ཆུང་ཞིང་།",
    "དཔར་འདེབས་མ་བྱས་གོང་སྔོན་ཚུད་ནས་འབྲེལ་ཡོད་ཚན་པ་དང་སྒེར་ཁག་ལ་དྲིལ་བསྒྲགས་བྱས་ཏེ་གདེང་ཚོད་ཡོད་པའི་གྲངས་ཀ་ངེས་ཅན་ཞིག་བྱུང་མཚམས་གཞི་ནས་དཔར་འདེབས་བྱེད་དགོས་ཀྱི་ཡོད་པ་རེད།",
    "སྐབས་འདིར་དཔར་ཁང་ཆེ་བ་ཁག་གི་སྒྲིག་སྲོལ་ལམ་ལུགས་ངོ་སྤྲོད་ཞུ་ཐུབ་ན་བསམ་རུང་།",
    "དཔར་གླ་ཇ་འཁོར་དྲུག་དགུ་དང་སྦག་ཆེན་གཉིས་སྦག་ཆུང་གསུམ་བཅས་དགོས་པས་སྣག་ཤོག་གི་རིན་དང་དཔར་གླ་བཅས་བསྡོམས་ན་ཇ་འཁོར་དྲུག་བརྒྱ་དང་ལྔ་དེང་རབས་བོད་རིག་པའི་སྐོར་གྱི་དཔྱད་རྩོམ་གཅེས་བཏུས།",
    "དེང་སྐབས་ལྷ་སར་འབྲུ་ཁལ་རེར་སྒོར་བཅུ་བཞི་རེ་བྱེད་པའི་ཡུལ་ཐང་ལྟར་བརྩིས་ན་སྒོར་བཞི་ཁྲི་བཞི་སྟོང་བདུན་བརྒྱ་ལྔ་བཅུ་ང་བཞི་དང་སྒོར་ཟུར་ལྔ་ཡིན་པས།",
    "བཟའ་ཆས་དངོས་ཟོག་བཅས་ཀྱི་རིན་ཐང་ལོ་རེ་བཞིན་ལྡབ་འཕར་འགྲོ་བ་དང་།",
    "སྣག་ཤོག་གི་རིན་བཅས་ལ་ཤ་ཁུ་རང་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "ཐིམ་ལྟར་གཙང་དག་གིས་གཏོང་ཡོང་འགོ་ཐུག་ཙམ་ལས་ཁེ་བཟང་གང་ཡང་མེད་ཚོད་རེད།",
    "དཔར་འདེབས་བྱེད་པའི་དུས་ཚོད་ཀྱང་བོད་ཟླ་གསུམ་པའི་ཚེ་བརྒྱད་ནས་དགུ་པའི་ཚེས་བརྒྱད་བར་ཟླ་བ་དྲུག་གི་དུས་ཚོད་ནང་དཔར་འདེབས་བྱེད་པ་མ་གཏོགས་དེ་མིན་གང་བྱུང་དུ་དཔར་འདེབས་མི་ཆོག་པའི་ཐོག་དཔར་ཁང་ནང་དུ་ཆང་འཐུང་བ་དང་།",
    "འབྱུང་འགྱུར་ད་དུང་ལོ་ངོ་བཅུ་ལྷག་དཔར་འདེབས་མུ་མཐུད་བྱེད་ཐུབ་པའི་གདེང་ཚོད་ཡོད་པ་དེར་བརྟག་ན།",
    "༢ ལོ་རེར་དཔར་འདེབས་བྱ་རྒྱུའི་གྲངས་ཚད་དེ་ལོ་རེའི་དགོས་མཁོ་དང་བསྟུན་ནས་ཚོད་འཛིན་བྱེད་བདེ་བ།་",
    "ནས་༧ སས་ཡན་ཅནབརྒྱ་ལྷག་ཙམ་བར་རྒྱུན་འཁྱོངས་བྱེད་ཐུབ་པ།",
    "དེང་སྐབས་བོད་ཡིག་གི་དེབ་གཟུགས་དཔེ་སྐྲུན་གྱི་མགྱོགས་ཚད་ལེགས་པོ་དེ་དང་།",
    "དེབ་གཟུགས་དཔེ་སྐྲུན་གྱི་སྤུས་ཚད་ཞན་པའི་གནས་ཚུལ་ལེགས་བཅོས་ཡོང་རྒྱུར་སྐུལ་མ་གཏོང་ཐུབ་ཀྱི་རེད།",
    "དཔེ་སྐྲུན་གྱི་གྲངས་འབོར་ལོ་རེ་ལས་ལོ་རེ་ཇེ་ཉུང་དུ་སོང་བ།",
    "ནོར་ཐ་གཙཆེས་འཁྲུལ་དང་ཆ་མ་ཚང་བའི་སྐྱོན་ཆ་ཡོད་ངེས་པས་ལེགས་བཅོས་དང་ཁ་སྐོང་གི་དགོངས་འཆར་༥ཅན་ལྷུག་སྩལ་ཡོང་བའི་རེ་བ་ཞུ།",
    "པར་སྐྲུན་ལས་རིགས་ཁག་གི་གླ་ཕོགས་དང་བྱ་དགའ།",
    "པར་ཁང་གི་སྒྲིག་སྲོལ་ལམ་ལུགས།",
    "འདིར་རིགས་པས་སྒྲུབ་པའི་དཔེ་རྙིང་པར་སྐྲུན་གྱི་དགེ་མཚན་དང་ཕན་ནུས་སོགས་དུས་ཚོད་དང་འཚོ་བ་དངོས་ཀྱིས་ར་འཕྲོད་ཅིང་དངོས་དཔང་དུ་མས་གསལ་ཁ་ཐུབ་པ་བཅས་ལུང་ངོས་དཔང་དུ་རིགས་གང་གིས་ཀྱང་བསྙོན་དུ་མེད་པའི་དྲང་སྲོང་གི་བདེན་ཚིག་ཁོ་ན་ཡིནའ་པ་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "འོན་ཏེ་གཞུང་ལུགས་ཐོག་ནས་པར་སྐྲུན་གྱི་རིག་པ་ཞིག་སྟེགཏན་ལ་དབབ་པར་སྔར་གྱི་དཔྱད་གཞི་བྱ་ཡུལ་སོགས་ཤིན་ཏུ་ད་བེན་མོད།",
    "ཡིན་ན་ཡང་འདིར་དེ་འདྲའི་ངལ་བ་ཀུན་སེལ་ནས་རང་རེ་རྣམས་ལ་གོ་རིམ་ཁ་གསལ་ལ་ནང་དོན་ཁག་ཚགས་དམ་པ་བཅས་གོང་འོག་འབྲེལ་ཆགས་པའི་གཞུང་ཞིག་ངོ་སྤྲོད་གནང་ཡོད།",
    "འོན་ཀྱང་ཕྱོགས་ཕྱི་ནང་གཉིས་ཀའི་ཞིབ་འཇུག་གི་འབྲས་བུར་བརྟག་དུས་གང་ལྟར་ཆ་ཚང་དང་གཞུང་དྲང་བའི་ཞིབ་འཇུག་འབྲས་བུ་ད་ཕན་སྨིན་ཐུབ་མེད་པས།",
    "གཡུང་དྲུང་བོན་གྱི་སྟོན་པ་གཤེན་རབ་མི་བོ་ཆེའི་སྐོར་ལ་ཞིབ་འཇུག་གནང་བའི་དཔྱད་རྩོམ་མང་པོ་མེད་ལ་ཡོད་པ་དེ་དག་གི་དགོངས་ཚུལ་མང་ཕལ་ཆེར་འོལ་ཚོད་དང་གང་དྲན་གྱི་རྣམ་པ་མཚོན་གྱི་ཡོད།",
    "གཤེན་རབ་ཅེས་པ་དེ་དངོས་སུ་བྱོན་མྱོང་ཡོད་ལ་དེ་ནི་ཕལ་ཆེར་བོད་ཀྱི་བཙན་པོ་སྤུ་ལྡེ་གུང་རྒྱལ་གྱི་དུས་མཚུངས་པར་འཇོག་གི་ཡོད།",
    "ས་ཅ་༦ཞིག་གི་ནང་དུ་སྐྱེ་བོ་ཕལ་ཆེར་ཡིད་བཏོན་རུང་བའི་འབྲས་བུ་ཞིག་ཐོན་ཐུབ་རྒྱུ་ནི་ཤིན་ཏུ་དཀའ་བའི་བྱ་བ་ཞིག་རེད།",
    "ཡིན་དུས་རབས་བཅུ་གཅིག་ཡན་ལ་འགྲོ་ཐུབ་ཀྱི་མེད་པ་བཅས་ཀྱི་དཀའ་ངལ་འཕྲད་ཡོདནའང་དཀའ་ངལ་དེ་དག་གི་རྐྱེན་གྱིས་གཡུང་དྲུང་བོན་ལ་ཞིབ་འཇུག་བྱེད་ཐབས་བྲལ་བ་དང་ག་ཡང་ན་ཞིབ་འཇུག་བྱེད་རིན་མེད་པ་ནི་རྩ་བ་ནས་མ་ཡིནནས།",
    "དེར་བརྟེན་ང་ཚོའི་ལས་འགན་ནི་སྔར་ལས་ལྷག་པའི་སྒོ་ནས་བོན་གྱི་དཔེ་རྙིང་གྲགས་ཅན་འཚོལ་བསྡུ་དང་དབྱེ་ཞིབ་གོ་བསྡུར་ཞིབ་འཇུག་བཅས་བྱེད་རྒྱུ་དེ་ཡིན་པ་རྟོགས་དགོས།",
    "ཀུན་སློང་དེ་འདྲའི་རྐྱེན་པས་བདག་གིས་ཉེ་བའི་ལོ་ཤས་རིང་གཡུང་དྲུང་བོན་ལ་དོ་སྣང་དང་རྒྱལ་ཁབ་ཕྱི་ནང་གི་དཔྱོད་ལྡན་མང་པོས་གཡུང་དེང་རབས་བོད་རིག་པའི་སྐོར་གྱི་དཔྱད་རྩོམ་གཅེས་བཏུས།",
    "དང་ངོ་སྙ་ལི་ཤུ་སྟག་རིང་གིས་སྟག་གཟིག་གི་ཡུལ་དུ་རྫུ་འཕྲུལ་གྱིས་གཤེགས་ཏེ།",
    "བ་གོར་བི་རོ་ཙ་ན་གཉིས་ཀྱིས་བསམ་ཡས་གླིང་གི་ལྷོ་ནུབ།",
    "མི་རུང་བ་སྣ་ཚོགས་བྱུང་སྐད་ཡང་སང་ཕོད་ལྕགས་མོ་བྱ་ལ།",
    "ནུབ་མོ་རྟ་ལ་ཁལ་བཀལ་ནས།",
    "བཟའ་རྒྱུ་དྲངས་ནས་མི་གཞན་ལ་མ་སྟོན་ཅིག་རང་གི་ཡུལ་དུ་ཕྱིན་ལ་བོན་སྤེལ།",
    "བལ་པོའི་མོ་འདེབས་ཤིང་གཞན་དུ་སོང་བ་དང་གཏོ་སྟོན་གྱི་དབུ་ཆག་ནས་འདས་སོ།",
    "དེར་སྔར་གྱི་གཏེར་སྒོ་བཅོལ་བའི་ཡོན་བདག་མོན་ནས།",
    "ཁོང་གི་གཏེར་སྒྲོ་མཐོང་ནས་ཡོན་བདག་མོ་ངས་སོས་པར་བྱ།",
    "ཁྲིབ་འདི་ཁྱོད་རང་ཟུངས།",
    "ཁོང་རང་གིས་ཀྱང་བོན་ཞུས་སྐད།",
    "གཡུང་དྲུང་ལྷའི་སྐད་ལས་སྙ་ལི་ཤུ་སྟག་རིང་གིས་བོད་སྐད་དུ་བསྒྱུར་བའོ།",
    "བོན་ལ་ཞིབ་འཇུག་གི་སྤྲོ་བ་སྐྱེས་པའི་མཁས་པ་ཚོས་སྟོན་པའི་མཛད་རྣམ་༦ ཉྩ།",
    "ཀཚོལ་ཞིབ་དང་མཐའ་དཔྱོད་བསྡུས་མ་ལ་ཞིབ་འཇུག་བྱེད་རྒྱུའི་སྐལ་བཟང་ཐོབ་པ་རེད།",
    "མི་དཔེ་ཁུངས་བཙུན་ཞིག་ལག་སོན་མ་བྱུང་བས་ད་ལྟའི་བར་ནར་འགྱངས་སོང་།",
    "དེར་བརྟེན་ད་ཡོད་ང་ཚོའི་མཇལ་བཞིན་པའི་མ་དཔེ་ཡང་གཏེར་ནས་ཐོན་མ་ཐག་པའི་དཔེ་དང་པོ་དེ་མིན་པ་མཁྱེན་དགོས།",
    "རྒྱུ་རྐྱེན་དེ་ལ་བརྟེན་ནས་ད་ཡོད་ཀྱི་མ་དཔེ་འདི་དག་ལ་ས་རིན་ཐང་གང་ཡང་མེད་པར་སེམས་ན་ནི་ཤིན་ཏུ་ཐལ་དྲགས་པའི་ལྟ་ཚུལ་ཞིག་ཡིན།",
    "བཙུན་མོ་ལ་བཙུན་མོ།",
    "དེ་བཞིན་ཚིག་རྐང་རེ་རེའི་མཇུག་ཏུ་ཚིག་ཤད་ཀྱི་དོད་དུ་རྟོགསའདི་ལྟ་བུ་སྦྱར་བ་བཅས་གནའ་རབས་བོད་ཡིག་ཡིག་རྙིང་རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་ལ་སོགས་དང་དེ་བཞིན་ཏུན་ཧོང་ནས་ཐོན་པའི་བོད་ཡིག་གི་འབྲི་སྲོལ་མང་པོ་མངོན་གསལ་དོད་པོ་མཐོང་རྒྱུ་ཡོད་པ་མ་ཟད་དེ་དག་དཔེ་ཚའི་མགོ་ནས་མཇུག་བར་ཚང་མར་མཐོང་རྒྱུ་ཡོད།",
    "དཔོའི་ཟ་ཐང་མོ་ཁབ་ཏུ་བཞེས་པའི་ལེའུ།",
    "ས་སབ་བསྟན་པ་རྣམ་གསུམ་རྗེས་བཞག་གི་མཛད་པའི་ལེའུ་༣༦ནས་༣༩བརབཞག་གི་པའི་མི་གས་ལེའུ་བཅུ་གཉིས་པ།",
    "མཛད་པ་བཅུ་གཉིས་ཀྱི་བཀྲ་ཤིས་འོལ་མོ་གླིང་དུ་མཛད་པའི་ལེའུ་༨༤ནས་༨༥བར།",
    "སྟོན་པ་ཞིང་གི་བཀོད་པ།་",
    "ག་འོལ་མོ་ལུང་གི་བཀོད་པའི་ལེའུ་༨༨ནས་༩༣བར་ཀྱིལེའུ་ཉི་ཤུ་རྩ་གསུམ་པ།",
    "དེ་ནི་ཤིན་ཏུ་འཁྲུལ་བ་དང་ཞིབ་ཏུ་མ་བརྟག་པའི་འོལ་ཚོད་སྨྲས་པའི་ལྟ་བ་རང་རེད།",
    "བོན་ཉིད་རང་སྒྲ་སྒྲོགས་པ་ལ་སྒྲ་སྐད་གང་གིས་བསྒྱུར་དུ་མེད་དོ།",
    "ལྷོ་འཛམ་བུ་གླིང་གི་དམིགས།",
    "གནས་མཆོག་དམ་པ་འོལ་མོ་ལུང་རིང་གི་རྒྱལ་ས་གླིང་བརྒྱད་ཀྱི་དབུས་གཡུང་དྲུང་དགུ་བརྩེགས་ཀྱི་རྩེ་ལ།",
    "སྔོན་གྱི་སྟོན་པ་རྣམས་ཀྱང་འདི་རུ་འགྲོ་བ་མིའི་ཆ་ལུགས་སུ་བྱོན་ནས་དེ་དག་བོན་གྱི་སྒོ་མོ་བརྒྱད་ཁྲི་བཞི་སྟོང་ལས་དྲངས་ཏེ་གསུངས་པའི་ཆསྐད་ཅེས་བྱའོ།",
    "སྟོན་པ་དང་རྒྱལ་པོ་ལ་སོགས་མཐོ་རིགས་ཀྱི་མི་རྣམས་ཐོག་མར་བྱོན་ཁུངས་སྟེང་ཕྱོགས་ལྷ་ལས་བབས་པའི་ལྟ་བ་འདི་ནི་བོད་རང་གི་གནའ་སྔ་མོའི་བསམ་བློ་མཚོན་སྟངས་ཀྱི་ཤོད་སྲོལ་ཆེས་རྙིང་བ་ཞིག་ཡིན་མོད།",
    "དེར་བརྟེན་སྟོན་པའི་བཀོལ་པའི་སྐད་དེ་ལྷ་ཡི་སྐད་ཅེས་ཆེ་བསྟོད་བྱས་པ་དེ་ནི་བོད་རང་གི་གནའ་སྔ་མོའི་ཤོད་སྲོལ་འཁྲུལ་མེད་ཡིན་པ་བརྗོད་མེད་རེད།",
    "གཡུང་དྲུང་ལྷ་ཡི་སྐད་ཅེས་པ་དེ་ནི་ཡུལ་འོལ་མོ་ལུང་རིང་དུ་སྤྱོད་པའི་སྐད་རིགས་དེ་ལ་གོ་དགོས།་",
    "དེར་བརྟེན་འོལ་མོ་ལུང་རིང་གངས་ཅན་ཏི་སེའི་བྱང་ཕྱོགས་སུ་ཡིན་པ་ཤུགས་ཀྱིས་བསྟན་ཡོད།",
    "སྐྱེ་བོ་མང་པོ་ཞིག་གིས་སྟག་གཟིག་འོལ་མོ་ལུང་རིང་ཞེས་ཨེ་ཤ་ཡའི་ནུབ་རྒྱུད་ཁ་ཚེའི་རྒྱལ་ཁོངས་གང་རུང་ཞིག་ལ་ངོས་འཛིན་གནང་གི་ཡོད་མོད།",
