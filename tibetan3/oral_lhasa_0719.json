    "བསམ་པ་ཇི་ལྟ་བ་རྣམ་པར་དབྱེ་བ་ད་ང་།",
    "བག་ལ་ཉལ་ཇི་ལྟ་བ་རྣམ་པར་ད་བྱེ་བ་དང་།",
    "སྤྱོད་ཡུལ་ཇི་ལྟ་བ་བཞིན་དབྱེ་བ་ཤེས་པ་ཉེ་བར་སྒྲུབ་པ་ཞེས་གསུངས་པའོ།",
    "སྤྱོད་ཡུལ་ཐམས་ཅད་ཤེས་པ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ཞེས་གསུང་ས་པའོ།",
    "ཁམས་ཀྱི་ཐིབས་པོ་ཇི་ལྟ་བ་བཞིན་དུ་ཉེ་བར་སྤྱོད་པ་དང་ལྡན་པ་ཞེས་གསུངས་པའོ།",
    "ཚོགས་ཇི་ལྟ་བུ་ལ་གནས་པ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ཞེས་གསུངས་པའོ།",
    "གུས་པར་བྱེད་པ་དང་།",
    "ཚིམ་པར་བྱེད་པ་དང་།",
    "མྱ་ངན་གྱིས་གདུང་ས་རིམས་བཏབ་འཁྲུགས་པ་ཡུལ་ལ་མངོན་ཕྱོགས་རྣམ་པར་ཉམ་ངར་ག་ནས།",
    "གུས་པར་བྱེད་ཅེས་བྱ་བ་ནི་མཐུན་པའི་སྤྱོད་ལམ་གྱིས་༨གནས་པ་ལ་ཡིན་གྱི།",
    "མཚམས་སྦྱར་བ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་ཚིག་དང་ཡི་གེ་གོ་རིམས་བཞིན་དུ་བསྟན་པའི་གོ་རིམས་བཞིན་དུ་དོན་རྣམ་པར་འབྱེད་པའོ།",
    "དོན་དང་མི་ལྡན་པར་མ་ཡིན་ཏེ།",
    "ད་གའ་བར་བྱེད་ཅེས་བྱ་བ་ནི་ཡང་དག་པར་བསྟན་པར་བྱ་བ་རྣམས་ལ་ཡང་དག་པར་སྟོན་ཏོ།",
    "ཚིམ་པར་བྱེད་ཅེས་བྱ་བ་ནི་ཡང་དག་པར་གཟེངས་༡བསྟོད་པར་བྱ་བ་རྣམས་ཡང་ད་ག་པར་གཟེངས་༢བསྟོད་པའོ།",
    "དོན་སོ་སོ་ཡང་ད་ག་པར་རིག་པ་དང་།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་རྟག་པར་རྒྱུན་དུ་འབྱུང་ངོ་ཞེས་གསུངས་པའོ།",
    "གོ་བར་བྱེད་པ་ནི་ཇི་ལྟར་ཤེས་པའི་ཡུལ་དེ་ཉིད་བརྗོད་པས་གཞན་ཁོང་དུ་ཆུད་པར་བྱེད་པ་སྟེ།",
    "གཞན་དག་བརྗོད་པས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ད་ག་ནི་རྣམ་པ་བཅུར་རྣམ་པར་གནས་ཏེ།",
    "རྣམ་པར་བྱང་བའི་མཚན་ཉིད་རྣམ་པ་ལྔ་སྟེ།",
    "དེ་ལ་མ་འདྲེས་པར་བསྟན་པ་ནི་སུ་མིང་གོ་བུ་ཅ་བར་འགྱུར་བ་དེ་ལ་དེ་ཉིད་ཀྱིས་སྟོན་གྱི་གཞན་གྱིས་མ་ཡིན་པའོ།",
    "རྣམ་གྲངས་མང་པོས་དོན་དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ར་རོ།",
    "འདུས་བྱས་ཐམས་ཅད་ཀྱི་སྤྱིའི་མཚན་ཉིད་ད་དང་།",
    "དོན་སོ་སོ་ཡང་དག་པར་རིག་པས་འདས་པ་དང་།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པས་འདས་པ་ད་ང་།",
    "རིགས་དེས་བསྡུས་པར་རིག་པར་བྱའོ།",
    "བརྗོད་པའི་ད་ངོས་པོའི་ཚུལ་གྱི་༢མཚན་ཉིད་ནི་དུས་གསུམ་ལས་ལྷག་པ་མེད་པར་རིག་པར་བྱའོ།",
    "རྗེས་སུ་མཐུན་པར་བསྟན་པའི་མཚན་ཉིད་ད་དང་།",
    "དོན་སོ་སོ་ཡང་དག་པར་རིག་པས་དོན་རབ་ཏུ་དབྱེ་བ་རབ་ཏུ་ཤེས་ས་སོ།",
    "སུ་ད་པེའི་རྣམ་གྲངས་ཇི་སྙེད་ཀྱིས་༢ཁོང་དུ་ཆུད་པར་འགྱུར་བའོ།",
    "དོན་སོ་སོ་ཡང་དག་པར་རིག་པས་རྗེས་སུ་རྟོག་༡པའི་ཤེས་པས་དེ་བཞིན་དུ་རྣམ་པར་གཞག་པ་རབ་ཏུ་ཤེས་ས་སོ།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པས་ཀུན་རྫོབ་ཤེས་པས་སྟོན་༐",
    "རྗེས་སུ་རྟོག་༤པའི་ཤེས་པས་དེ་བཞིན་དུ་རྣམ་པར་གཞག་པ་ནི་རྗེས་སུ་རྟོག་པའི་ཤེས་པས་འདི་ཇི་ལྟ་བ་དེ་བཞིན་དུ་གཞན་ཡང་དེ་བཞིན་དུ་རྣམ་པར་འཇོག་པའཇོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པས་དོན་དམ་པ་ཤེས་པ་ལ་མཁས་པ་ནི་རྣམ་གྲངས་མ་ནོར་བ་ལ་སྤོབས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དོན་སོ་སོ་ཡང་དག་པར་རིག་པས་ཕུང་པོ་ད་ང་།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པས་འགྲོ་བ་ཐམས་ཅད་སྨོན་པའི་སྒྲ་དབྱངས་ཤིན་ཏུ་སྙན་པའི་ཡི་གེ་རྣམས་ཀྱིས་སྟོན་ཏོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་ད་ག་པར་རིག་པས་ཕྱི་ཕྱིར་ཞིང་སྣང་བ་མུ་མེད་པས་སྟོན་ཏོ་ཞེས་གསུངས་པའོ།",
    "དེ་ལ་ཚུལ་གཅིག་པ་མི་འཁྲུགས་པ་ནི་བདག་ནི་བདག་མེད་པར་ཤེས་པར་བྱེད་ད་དོ།",
    "ཕུང་པོ་ལ་སོགས་པ་ལ་མཁས་པ་༢ནི་བདག་མེད་པར་རབ་ཏུ་རྟོགས་པར་འགྱུར་ཏེ།",
    "བྱེད་པ་པོར་འཛིན་པའི་གཉེན་པོར་གོ་རིམས་བཞིན་དུ་རིག་པར་བྱའོ།",
    "རྣམ་པར་གྲོལ་བའི་མཚན་ཉིད་དང་།",
    "དེ་ལ་ཡང་དག་པར་གཞོལ་བ་ཐ་དད་པ་མེད་པ་ནི་དམིགས་པ་ཐ་དད་པ་མེད་པ་ཉིད་དུ་རིག་པར་བྱའོ།",
    "དོན་སོ་སོ་ཡང་ད་ག་པར་རིག་པས་ས་བཅུ་རྣམ་པར་དགོད་པ་དང་།",
    "བསྟན་པ་རབ་ཏུ་རྣམ་པར་དབྱེ་བ་ལ་འཇུག་ག་གོ།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པས་ས་ཇི་ལྟ་བ་བཞིན་དུ་ལམ་ཉེ་བར་སྒྲུབ་པ་མ་འདྲེས་པར་༢སྟོན་ཏོ།",
    "ས་ཇི་ལྟ་བ་བཞིན་དུ་ལམ་ཉེ་བར་སྒྲུབ་པ་མ་འདྲེས་པར་སྟོན་ཏོ་ཞེས་བྱ་བ་ནི་གདམས་ངག་ཕྱིན་ཅི་མ་ལོག་པའོ།",
    "དངོས་པོ་དང་མཚན་རྣམ་པར་དབྱེ་བ་ཐ་དད་པ་ཁོང་དུ་ཆུད་པར་བྱ་བ་རབ་ཏུ་ཤེས་ས་སོ།",
    "རྣམ་པར་གཞག་པའི་མཚན་ཉིད་ད་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པས་སྦྱོར་བ་དང་།",
    "སོ་སོ་ཡང་ད་ག་པར་རིག་པས་སྦྱོར་བ་ནི་གང་ལ་བརྟེན་ནས་སྟོན་པའོ།",
    "བསམ་པ་ཇི་ལྟ་བ་ཞེས་བྱ་བ་ནི་འདིར་ཁམས་འདི་ལྟ་བུར་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྣང་བ་དང་ལྡན་པའི་གཟུངས་ཞེས་གསུངས་པའོ།",
    "བློ་གྲོས་བཟང་པོ་ད་ང་ལྡན་པའི་གཟུངས་ཞེས་གསུངས་པའོ།",
    "མཐའ་ཡས་པ་དང་ལྡན་པའི་གཟུངས་ཞེས་གསུངས་པའོ།",
    "ཐོས་ནས་ཀྱང་བརྗེད་པར་མི་བྱེད་དེ།",
    "ཇི་སྐད་ཐོས་པ་ཡང་ཚད་༡མེད་པར་རྣམ་པར་ཕྱེ་ནས་སྟོན་ཏོ།",
    "སྒྲ་སྐད་ཀྱི་ཡན་ལག་ཐ་དད་པ་རྣམ་པར་ཕྱེ་བ་རྣམས་༨ཀྱིས་གོ་བར་བྱེད་ད་དོ།",
    "དེ་དེ་བས་ཀྱང་ཤས་ཆེར་ཡེ་ཤེས་ཀྱི་སྣང་བ་འདི་ལྟ་བུ་རབ་ཏུ་འཛིན་པར་རྩོམ་སྟེ།",
    "འདི་རྣམས་ནི་བརྡ་ཕྲད་པར་སླ་བས་རྣམ་པར་དབྱེ་བ་མ་བྱས་སོ།",
    "ས་དགུ་པ་ལ་ཞིང་ཡོང་ས་སུ་དག་པར་བྱ་བ་དང་།",
    "འདི་ནི་ཁྱད་པར་རོ།",
    "དེ་ལ་ཡོང་ས་སུ་སྦྱང་བ་བྱས་པའི་ས་ཡོངས་སུ་རྫོགས་པ་ནི་ཤིན་ཏུ་རྣམ་པར་ཕྱེ་བ་རྣམ་པར་འབྱེད་པ་ཉིད་ཀྱིས་ས་དགུ་པོ་རྣམས་ཡོངས་སུ་རྫོགས་པར་རིག་པར་བྱ་སྟེ།",
    "ཚོགས་བསགས་པར་བྱ་བ་མཐའ་ཡས་པ་བུ་ཤིན་ཏུ་བསགས་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྣམ་པར་དབྱེ་བ་རྣམ་པ་ཐ་དད་པ་ལ་མཁས་པ་ཞེས་གསུངས་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྤྱོད་ཡུལ་ལ་འཇུག་པས་མཐུན་པར་གྱུར་པའི་འདུ་ཤེས་ཡིད་ལ་བྱེད་པ་ཞེས་གསུངས་ཏེ།",
    "དེ་ལྟར་ཡོངས་སུ་སྦྱང་བ་བྱ་བའི་ས་ཡོངས་སུ་རྫོགས་པས་ས་བཅུ་པ་རྣམ་པར་གཞག་པ་བསྟན་ན་ནས།",
    "དེ་ལ་ཏིང་ངེ་འཛིན་ཡོངས་སུ་རྫོགས་པ་ཐོབ་པ་ནི་ཏིང་ངེ་འཛིན་དྲི་མ་མེད་པ་འཁོར་དང་བཅས་པ་མངོན་དུ་གྱུར་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "བསྒྲིབ་མི་དགོས་པར་མངོན་དུ་གྱུར་པས་མངོན་དུ་འགྱུར་བ་ཞེས་བྱའོ།",
    "དེ་ཡང་ཏིང་ངེ་འཛིན་རྣམ་པ་དགུས་དྲི་མ་མེད་པ་ཉིད་རྣམ་པ་བརྒྱད་དུ་རིག་པར་བྱ་སྟེ།",
    "འོད་ཟེར་རྣམ་པ་ཐམས་ཅད་ཀྱི་མེ་ཏོག་ཅེས་བྱ་བ་ཞེས་གསུངས་པའོ།",
    "རྒྱ་མཚོ་ལྟ་བུར་འབྱོར་པ་ཞེས་བྱ་བ་ཞེས་གསུངས་པའོ།",
    "ཞིང་ཡོངས་སུ་དག་པར་བྱེད་པ་དྲི་མ་མེད་པ་ཉིད་ནི་མཐའ་ཡས་པ་དང་།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་དག་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་ཅིང་ལྡང་ང་ངོ།",
    "ཏིང་ངེ་འཛིན་གྱི་བྱ་བ་ཇི་སྙེད་པ་ཉམས་སུ་མྱོང་བས་ཏིང་ངེ་འཛིན་ཡོང་ས་སུ་རྫོགས་པར་སྟོན་ཏོ།",
    "དེ་ལྟར་ཏིང་ངེ་འཛིན་ཡོང་ས་སུ་རྫོགས་པ་ཐོབ་པས་ས་རྣམ་པར་གཞག་པ་བསྟན་ན་ནས།",
    "དེ་མངོན་དུ་གྱུར་མ་ཐག་ཏུ་སྟོང་གསུམ་འབུམ་ཕྲག་བཅུའི་གཏོས་དང་མཉམ་པའི་ཞེས་གསུངས་པའོ།",
    "འཇིག་རྟེན་གྱི་ཡུལ་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ་ཞེས་གསུངས་པའོ།",
    "ཤིན་ཏུ་གནས་པ་ནི་ལེགས་པར་གནས་པའོ།",
    "ལྷའི་ཡུལ་ལས་ཡང་ད་ག་པར་འདས་པ་ཞེས་གསུངས་པའོ།",
    "འོད་ཟེར་དཔག་ཏུ་མེད་པས་རྒྱས་པའི་ལུས་ཅན་ཞེས་གསུངས་པའོ།",
    "སྟོང་གསུམ་འབུམ་ཕྲག་བཅུ་༤ཚང་བའི་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་ཇི་སྙེད་ཀྱི་པདྨ་འི་འཁོར་དང་ལྡན་པ་ཞེས་གསུངས་པའོ།",
    "པདྨ་དེ་དག་ཀྱང་ཕན་འདོགས་པའི་ལས་ཅན་༡པདྨ་དེ་དག་ལ་འཁོད་པར་སྣང་སྟེ།",
    "ལས་གསུམ་དང་ལྡན་པར་རིག་པར་བྱ་སྟེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཡོངས་སུ་དག་པར་འགྱུར་ར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་འཁོར་གྱི་ད་ཀྱིལ་འཁོར་གྱིས་ཀྱང་རྣམ་པར་རིག་པར་འགྱུར་ར་རོ།",
    "བྱུང་ནས་ཀྱང་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པའི་འཁོར་གྱི་ད་ཀྱིལ་འཁོར་ཐམས་ཅད་སྣང་བར་བྱས་ཏེ།",
    "ཏྲརྣམ་གྲངས་གཞན་དུ་ན་ངེས་པར་འགྱུར་བ་ནི།",
    "བྱ་བ་ལ་བག་ཡོད་པར་ལེགས་པར་སྡོམ་པ་ཅན་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "འཇིག་རྟེན་ལ་ལན་བཅུ་བསྐོར་བ་བྱས་ནས།",
    "ཏིང་ངེ་འཛིན་འབུམ་ཕྲག་༥བཅུ་ལ་སྙོམས་པར་འཇུག་ག་གོ།",
    "རྡོ་རྗེ་དང་བཀྲ་ཤིས་ལས་བདུད་ཀྱི་དགྲ་ལས་རྣམ་པར་རྒྱལ་བ་ཞེས་བྱ་བའི་འོད་ཟེར་ཆེན་པོ་ཅིག་འོད་ཟེར་གྱི་འཁོར་གྲངས་མེད་པ་འབུམ་ཕྲག་བཅུ་བཅུ་འབྱུང་སྟེ།",
    "བྱུང་ནས་ཀྱང་ཕྱོགས་བཅུ་སྣང་བར་བྱས་ནས་ཆོ་འཕྲུལ་མུ་མེད་པ་ཡང་དག་པར་བསྟན་ཏོ་༧།",
    "འཇིག་རྟེན་ལ་ལན་བཅུ་བསྐོར་བ་བྱས་ཏེ།",
    "ནམ་མཁའི་ཁམས་ཀྱི་མཐས་གཏུགས་པ་ཐམས་ཅད་སྣང་བར་བྱས་ནས་ཕྱིར་ལོག་སྟེ།",
    "བྱང་༡སེམས་དཔའི་འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱི་སྟེང་ནས་བསྐོར་བ་བྱས་ནས་བཀོད་པ་ཆེན་པོ་བསྟན་ཏེ།",
    "དེ་དག་ནི་དོན་རྣམ་པ་ལྔ་ད་ང་འབྲེལ་བར་རིག་པར་བྱ་སྟེ།",
    "འགག་༡པས་རྣམ་པར་བྱང་བར་འགྱུར་བ་དང་།",
    "གཟུགས་ཀྱི་ཁམས་ཡང་དག་པར་འགྲུབ་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཡང་ད་ག་པར་འགྲུབ་པ་དང་།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་ཁམས་ཡང་ད་ག་པར་འགྲུབ་པ་དང་།",
    "ནམ་མཁའི་ཁམས་ཡང་དག་པར་འགྲུབ་པ་དང་།",
    "ཡང་དག་པ་དང་ཡང་དག་པ་མ་ཡིན་པ་བསྟན་པའི་ཁམས་ཡང་ད་ག་པར་འགྲུབ་པ་དང་།",
    "མྱ་ངན་ལས་འདས་པའི་ཁམས་ཡང་ད་ག་པར་འགྲུབ་པ་དང་།",
    "འཆགས་པ་ཡང་དག་པར་འགྲུབ་པ་དང་།",
    "ཉན་ཐོས་ཀྱི་སྤྱོད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་ད་ང་།",
    "མྱ་ངན་ལས་འདས་པ་ཀུན་དུ་བསྟན་པ་ཡང་ད་ག་པར་འགྲུབ་པ་དང་།",
    "རྣམ་པར་དབྱེ་བས་བརྟག་པ་ཡང་ད་ག་པར་འགྲུབ་པ་ཡང་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་གསུངས་པའོ།",
    "དེ་བཞིན་གཤེགས་པར་སྤྲུལ་པ་དང་།",
    "སྤྲུལ་པ་ཐམས་ཅད་ལ་རྟོག་པ་ཡང་རྟོག་པ་མེད་པ་ཉིད་དུ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་གསུངས་པའོ།",
    "ཡེ་ཤེས་སུ་བྱིན་གྱིས་བརླབ་པ་ཡང་༤ཡང་དག་པ་རྟཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་གསུངས་པ་སྟེ།",
    "དེ་ལ་ཡེ་ཤེས་སུ་བྱིན་གྱིས་བརླབ་པ་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སུ་རིག་པར་བྱའོ།",
    "སྤྱོད་པ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་དང་།",
    "སྐྱེ་བ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་དང་།",
    "བལྟམས་༢ིཔ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་དང་།",
    "རྣམ་པར་འཕྲུལ་པ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་ད་ང་།",
    "ཚེའི་ཚད་བྱིན་གྱིས་བརླབ་པ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་དང་།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འད་འ་བ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་དང་།",
    "བསྟན་པ་གནས་པ་ལ་ཆ་ཕྲ་བ་འཇུག་པའི་མཁྱེན་པ་དེ་དག་ཐམས་ཅད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་གསུངས་པ་སྟེ།",
    "དེ་ལ་རྣམ་པར་འཕྲུལ་པ་ནི་གོམ་པ་བདུན་བོར་བ་ལ་སོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དུས་དང་དུས་མ་ཡིན་པ་རྣམ་པར་དཔྱད་པ་གསང་བ་དང་།",
    "ད་བང་པོ་རྣམ་པར་དབྱེ་བ་གསང་བ་དང་།",
    "རང་བཞིན་ཐུགས་སུ་ཆུད་པ་གསང་བ་དེ་དག་ཐམས་ཅད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་གསུངས་པ་སྟེ།",
    "བསྐལ་པ་གཅིག་ལ་བསྐལ་པ་གྲངས་མེད་པར་ཡང་ད་ག་པར་གཞོལ་བ་ཉིད་ད་དང་།",
    "བསྐལ་པ་གྲངས་མེད་པ་ལ་བསྐལ་པ་གྲང་ས་མེད་པར་ཡང་ད་ག་པར་གཞོལ་བ་ཉིད་ད་དང་།",
    "བསྐལ་པ་ལ་སྐད་ཅིག་ཏུ་ཡང་ད་ག་པར་གཞོལ་བ་ཉིད་ད་དང་།",
    "བསྐལ་པ་མ་ཡིན་པ་ལ་བསྐལ་པར་ཡང་དག་པར་གཞོལ་བ་ཉིད་ད་དང་།",
