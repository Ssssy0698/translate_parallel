    "སྤྱན་ལ་སོགས་པ་དང་གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ཀྱི་གནས་སུ་ནི་སྣ་ཚོགས་པདྨའི་འདབ་མ་ལ།",
    "བཅུ་དྲུག་ཆ་དང་ཚོགས་ལས་བྱུང་བའི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བཅུ་དྲུག་ཆ་དང་ཚོགས་ནི་བཅུ་དྲུག་ཆ་དང་ཚོགས་ཏེ།",
    "དེ་རྣམས་ལས་བྱུང་ཞིང་སྐྱེས་པ་གང་ཡིན་པ་དེ་ནི་བཅུ་དྲུག་ཆ་དང་ཚོགས་ལས་བྱུང་བའི་ཞེས་བྱའོ།",
    "མཐའ་ཡས་པའི་སྤྲུལ་པ་རྣམས་ཀྱིས་འགྲོ་བ་མཆོག་གི་དོན་རྣམས་བྱས་ནས་རྒྱལ་བ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱི་སྐུ་རུ་བསམ་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "རྡོ་རྗེ་འཛིན་པ་དེ་ལྟ་བུ་དེ་རྣམས་ཀྱིས་འགྲོ་བ་མཆོག་གི་དོན་རྣམས་བྱས་ཤིང་བསྒྲུབས་པར་གྱུར་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་ནི་ཐུབ་པ་མཆོག་གི་རང་བཞིན་གྱི་ཕྲ་རབ་ལས་རྣམ་པར་བསྒྲུབས་པ་ཡིན་པས་ན་འདི་ནི་ཐུབ་མཆོག་ཕྲ་རབ་ལས་བསྒྲུབས་པའོ།",
    "གང་གི་གཡས་པ་དང་གཡོན་པའི་ཞལ་སྔོ་བ་དང་དམར་བ་མངའ་བ་དེ་ནི།",
    "ལྷག་མའི་ཕྱག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་གི་ལྷག་མ་རྣམས་ཀྱིས་རྡོ་རྗེ་དང་།",
    "པདྨ་དག་བསྣམས་པར་མཛད་པ་དག་གང་ཡིན་པ་དེ་ནི་ལྷག་མའི་ཕྱག་གིས་རྡོ་རྗེ་རལ་གྲི་དང་པདྨ་རིན་ཆེན་བསྣམས་པ་ཞེས་བྱའོ།",
    "གཞན་ཡང་དེ་དག་གི་ཁྱད་པར་བསྟན་པའི་ཕྱིར།",
    "ཤེས་རབ་དང་ཐབས་གཉིས་སུ་མེད་པའི་མཚན་ཉིད་ཅན་དེའི་བདག་ཏུ་བསམ་མོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ཉིད་ཀྱི་སྐུ་ནི་རང་གི་ངོ་བོ་ཉིད་དེ།",
    "དེས་ནང་གི་ལུས་ཀྱི་དབུས་སུ་རྒྱལ་བའི་ཚོགས་རྣམས་ཞེས་བྱ་བ་རྒྱལ་བའི་ཚོགས་སྣེརྣམས་མ་ལུས་པ་སྟེ།",
    "རིག་མ་དེ་དག་ཐམས་ཅད་རང་གི་རིག་མའི་ནང་དུ་ཆུད་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ལ་སྤྱན་ལ་སོགས་པའི་ལྷ་མོ་དང་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་མ་ལུས་པ་བྱེཡུལ་ཡིན་ན།",
    "སྤྱན་ལ་སོགས་པའི་ལྷ་མོ་དང་གཟུགས་ལ་སོགས་པ་མ་ལུས་ཡུལ་གྱིས་ཞེས་བྱ་སྟེ།",
    "གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་དགུ་པོ་རང་གི་རིག་མ་ཞེས་བྱ་བ།",
    "རང་གི་སོ་སོར་སྣང་བའི་རིག་མ་དེའི་ནང་དུ་ཆུད་པར་བྱའོ།",
    "རང་གི་ལུས་ལ་བཅུག་ནས།",
    "དེ་བཞིན་དུ་གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ཀྱང་དབྱུང་བར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་བ་དང་།",
    "དེ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་རང་གི་ས་བོན་རྣམས་ལས་འབྱུང་ཞིང་གདོན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཆོ་ག་བཞིན་ཞེས་བྱ་བ་ནི་གཉིས་པོ་དག་གིས་སོ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལྷ་མོའི་པདྨའི་ནང་དུ་བཞུགས་པའོ།",
    "མཉམ་པ་མེད་པ་ཤེས་རབ་ཆགས་པས་ཞུ་བར་བྱས་པར་ཞེས་བྱ་བ་ལ་ཤེས་རབ་ནི་རྡོ་རྗེ་སེམས་དཔའི་ལྷ་མོ་སྟེ།",
    "ཀྱེ་རྡོ་རྗེའི་ཐུགས་མི་ཕྱེད་པའི་ཐུགས་དང་ལྡན་པ་ཁྱོད་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གང་གིས་ཤེ་ན།",
    "མཱ་མ་ཏཱི་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་མི་སྲིད་པར་གྱུར་པས་སོ།",
    "ད་ནི་རང་གི་རིགས་ཀྱི་བདག་པོའི་སྒོ་ནས་སྤྱན་ལ་སོགས་པའི་ལྷ་མོ།",
    "རྡོ་རྗེ་སྐུ་ཁྱོད་ཅེས་བྱ་བ་ལ་སོགས་པས་སྐུལ་བར་བྱེད་དོ།་",
    "ཀྱེ་རྡོ་རྗེའི་་སྐུ་ཁྱོད་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "ད་ནི་ཁྱོད་ནི་རྡོ་རྗེ་གསུང་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པས།",
    "ན་བཟའ་དཀར་མོ་རང་གི་རིགས་ཀྱི་བདག་པོའི་སྒོ་ནས་ཡང་དག་པར་སྐུལ་བར་བྱེད་དེ།་",
    "ཁྱོད་ནི་རྡོ་རྗེ་གསུང་སྟེ་ཞེས་བྱ་བ་ནི།",
    "གསུང་རྡོ་རྗེའི་སྒོ་ནས་བཅོམ་ལྡན་འདས་སོ་སོར་རྟོག་ཕྱེཔའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཉིད་དུ་གྱུར་པས་རྡོ་རྗེ་གསུང་ཁྱོད་ཅེས་༦བོད་པ་སྟེ།",
    "ཀྱེ་རྡོ་རྗེའི་གསུང་ཁྱོད་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "འཇིག་རྟེན་དག་གི་དོན་དང་དགོས་པ་མཛད་ལ་རབ་ཏུ་བརྩོན་ཞེས་བྱའོ།",
    "ད་ནི་ཁྱོད་ནི་རྡོ་རྗེ་འདོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་སྒྲོལ་མ་རང་གི་རིགས་ཀྱི་སྒོ་ནས་སྐུལ་བར་བྱེད་དོ།",
    "དེ་ལ་འདི་ལྟར་བོད་པ་ནི་ཀྱེ་རྡོ་རྗེ་འདོད་པ་ཁྱོད་བདག་ལ་དགྱེས་པར་མཛོད་ཅིག་བྱེཅེས་བྱ་བར་སྦྱར་རོ།",
    "རང་གི་སྔགས་ཀྱི་ལུས་སུ་རང་ཉིད་གྱུར།",
    "དེ་གང་ལ་ཡོད་པའི་རང་གི་སྔགས་སུ་གྱུར་པ་དེ་ནི།",
    "སྣང་བའི་འོད་ཟེར་གྱིས་བརྒྱན་པའི་རང་གི་སྔགས་ཀྱི་ལུས་སུ་གྱུར་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་དག་གིས་བརྒྱན་པས་ན།",
    "དེར་རྡོ་རྗེའི་ལྟེ་བའི་དབུས་ན་གནས་པའི་ཧཱུཾ་ལས་རང་གི་མཚན་མ་ལས་བྱུང་བའི་ཐུགས་རྡོ་རྗེ་བསམ་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་དག་གི་ལྟེ་བའི་དབུས་ཀྱི་ཆ་དེར་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཨཱ་་སྒོདང་ཨོཾ་གཉིས་ལས་གསུང་གི་རྡོ་རྗེ་དང་།",
    "ཞེས་བྱ་བ་ལ་ཤེས་རབ་དམ་པ་ནི་རང་གི་སོ་སོར་སྣང་བའི་ཤེས་རབ་པོ།",
    "འདི་དག་གིས་ནི་ཐུགས་རྡོ་རྗེར་བྱིན་གྱིས་བརླབ་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཐུབ་པའི་མཆོག་གི་འོད་ཟེར་ལས་བྱུང་བ་རིག་པའི་ཚོགས་ཕྱག་ན་བུམ་པ་ཐོགས་ཏེ།",
    "རང་གི་རིགས་ཀྱི་བདག་པོར་སྣང་བའི་ཅོད་པན་དུ་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ཐུབ་པའི་མཆོག་རྣམས་ཀྱི་འོད་ཟེར་དེ་རྣམས་ལས་ཀྱང་བྱུང་བའི་རིག་པའི་ཚོགས་རྣམས་ནི་ཐུབ་པའི་མཆོག་གི་འོད་ཟེར་ལས་བྱུང་བའི་རིག་པ་སྟེ།",
    "འཇམ་པའི་རྡོ་རྗེའི་རྣལ་འབྱོར་པ་བདག་ཉིད་ཀྱི་རང་གི་རིགས་ཀྱི་གཙོ་བོར་སྣང་བའི་ཅོད་པན་དུ་གྱུར་པ་ལྡུསྟེ།",
    "རང་གི་རིགས་ཀྱི་བདག་པོ་ནི་མི་བསྐྱོད་པ་ཡིན་ལ།",
    "ལྔ་པོ་གང་དག་གིས་ཤེ་ན།",
    "ཧཱུཾ་གིས་འདབ་མ་བརྒྱད་པོ་རྣམ་པར་སྤྲུལ།",
    "ཡི་གེ་ཧཱུཾ་གིས་འདབ་མ་བརྒྱད་པ་རྣམ་པར་སྤྲུལ་ཞིང་བསྐྱེད་པ་གང་ཡིན་པ་དེ་ནི།",
    "ཧཱུཾ་གིས་འདབ་མ་བརྒྱད་པ་རྣམ་པར་སྤྲུལ།",
    "ཐབས་དང་བཅས་པར་གྱུར་པའི་རང་གི་ལུས།",
    "དེས་ཐབས་དང་བཅས་ཤིང་ལྡན་པར་བྱུང་བའི་རང་གི་ལུས་ཅན་གྱི་སྔགས་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཐུགས་ཀའི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ཟླ་བ་ལ་གནས་པའི་རལ་གྲིའི་ཆང་གཟུངས་ལ་འདུག་པའི་ཟླ་བ་ལ་བརྟེན་པའི་རང་གི་སྔགས་ནི་ཐུགས་ཀའི་ཟླ་བའི་སྔགས་ཏེ།",
    "ཧཱུཾ་གི་རྡོ་རྗེ་ལས་བྱུང་དྲི་མེད་པ།",
    "ལྷ་མོའི་པདྨའི་ནང་ན་གནས་པ་སྟེ།",
    "མ་ལུས་པ་ཡང་ཡིན་ལ་མི་བསྤྱོད་པ་ལ་སོགས་པའི་རང་གི་དཀྱིལ་འཁོར་པ་ཡང་ཡིན་པས་མ་ལུས་པའི་དཀྱིལ་འཁོར་པ་སྟེ།",
    "གང་གི་རལ་པ་དང་ཅོད་པན་མཛེས་པ་དེ་ནི་རལ་པ་ཅོད་པན་མཛེས་དང་ཞེས་བྱའོ།",
    "དེ་རྣམས་ཀྱི་འོད་ཟེར་དེས་འབར་བའི་རྒྱན་དང་བཅས་པ་གང་ཡིན་པ་དེ་ནི་སྣ་ཚོགས་པའི་རིན་ཆེན་མཆོག་གི་འོད་ཟེར་འབར་བས་བརྒྱན་ཞེས་བྱའོ།",
    "དྲེ་ཥ་ར་ཏི་ཞེས་བྱ་བས་ལྷ་མོ་མཱ་མ་ཏཱི་བསྐུལ་ལ།",
    "རཱ་ག་ར་ཏི་ཞེས་བྱ་བས་གོས་དཀར་མོ་བསྒུལ་ལ།",
    "ལྷ་མོ་འདི་རྣམས་ངེས་པའི་མཚན་མ་ནི།",
    "སྤྱན་ལ་སོགས་པ་ལྷ་མོ་འདི་རྣམས་ཀྱི་ཕྱག་མཚན་ནི་འཁོར་ལོ་བཟང་པོ་དང་།",
    "དེ་ཉིད་གསུམ་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས།",
    "རེག་རྡོ་རྗེ་ནི་དོན་ཡོད་པར་གྲུབ་པ་ལྟ་བུ་ལ་འདིའི་ཕྱག་མཚན་གཙོ་བོ་ནི་ལྷའི་གོས་སོ།",
    "གཞན་གྱིས་མི་ཐུབ་ཅེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ལ་སོགས་པའི་བདུད་གཞན་རྣམས་ཀྱིས་མི་ཐུབ་པའོ།",
    "ཕྱག་ལ་སོགས་པ་གསུང་གི་རྡོ་རྗེ་འདྲ།",
    "གང་གིས་གདུག་པ་དུ་མ་རྣམ་པར་གནོན་པར་མཛད་ཅིང་ཤིན་ཏུ་ཞལ་འཇིགས་སུ་རུང་བ་གང་ལ་མངའ་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "གསང་མཐོ་ཞིང་དགོད་ཅིང་གང་གིས་རི་བོ་རྣམས་སྒྱེལ་སེབར་མཛད་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "འཁོར་ལོ་བསམ་མོ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "ཤེས་རབ་ནི་བུད་མེད་ཀྱི་ཚུལ་ལོ།",
    "ཙནྡན་བཟང་སོགས་མེ་ཏོག་གིས་མཛེས་དབུལ།",
    "གོས་དཀར་མོའི་དབུ་རྒྱན་ལ་ནི་འོད་དཔག་ཏུ་མེད་པའོ།",
    "རེག་རྡོ་རྗེའི་དབུ་རྒྱན་ལ་ནི་དོན་ཡོད་པ་ཤེགྲུབ་པའོ།",
    "རང་གི་ས་བོན་འོད་རྣམས་ཀྱིས།",
    "ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་སྔགས་ཀྱི་འོད་ཟེར་རྣམས་ཀྱིས་གཟུགས་ལ་སོགས་པས་ཐམས་ཅད་དྲངས་ནས་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "ཤེས་རབ་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་ཤེས་རབ་ནི་རང་གི་སོ་སོར་སྣང་བའི་རིག་པ་སྟེ།",
    "དེའི་བ་སྲུའི་བུ་ག་རེ་རེ་ནི་ཤེས་རབ་བ་སྤུ་རེ་རེ་སྟེ།་",
    "དེ་རྣམས་ལས་བྱུང་བ་གང་ཡིན་པ་དེ་ཤེས་རབ་བ་སྲུ་རེ་རེ་ལས་བྱུང་བའོ།",
    "དེ་ལྟར་ན་ཤེས་རབ་ཀྱི་བ་སྤུ་རེ་རེ་ལས་བྱུང་བ་ཡང་ཡིན་ལ་འོད་ཟེར་རྣམ་པ་སྣ་ཚོགས་པ་རྒྱ་ཆེན་པོའི་ཚོགས་ཀྱང་ཡིན་པས་ན་ཤེས་རབ་བ་སྲུ་རེ་རེ་ལས་བྱུང་བའོ།",
    "གང་གིས་མ་ལུས་པའི་ནམ་མཁའི་གཏོས་ཏེ།་",
    "ཤེས་རབ་ཀྱི་བ་སྤུ་རེ་རེ་ལས་བྱུང་བའི་འོད་ཟེར་གྱི་སྒོ་རྣམས་ངེས་པར་བྱུང་བ་ཡིན་པས་ན་འོད་ཀྱི་སྒོ་ལས་ངེས་པར་བྱུང་བའོ།",
    "དེ་ལྟ་བུའི་གཟུགས་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་སོ།",
    "རང་གི་ཡིད་ཉིད་ལྷག་པའི་ལྷ་ཡིན་ཏེ།",
    "གཙོ་བོའི་ལྷ་རང་གི་ཡིད་ཉིད་ཡིན་ལ།",
    "བདུད་དང་ཉོན་མོངས་པ་ལ་སོགས་པ་རྣམས་ཀྱིས་དཀྲུག་པར་མི་ནུས་པས་ན་མི་བསྐྱོད་པའོ།",
    "རྡོ་རྗེ་ཞི་བ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བ་དང་།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་རང་བཞིན་གྱིས་དག་པ་ཡིན་པས་ན་རང་བཞིན་དག་པའོ།",
    "ཉོན་མོངས་པ་དང་ལས་དང་ཤེས་བྱའི་སྒྲིབ་པའི་བག་ཆགས་ཀྱི་གོས་པ་དང་བྲལ་བ་གང་ཡིན་པ་དེ་ནི་གོས་པ་མེད་ཅེས་བྱའོ།",
    "དེ་ལྟར་དེའི་ངོ་བོ་ཉིད་དུ་བསམས་ནས་རང་གི་ལྕེ་ལ་ཡི་གེ་ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པའི་བདག་ཉིད་ཅན་གྱི་ལྕེ་བསམས་ལ།",
    "འདི་དག་ནི་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་ཏོ།",
    "རང་གི་སྔགས་ཀྱི་ནང་དུ་ཆུད་པར་བྱས་ལ།",
    "རང་གི་གསང་སྔགས་ནང་དུ་ཆུད་པར་བྱ།",
    "གང་གི་ཕྱིར་གཟུགས་ལ་སོགས་པའི་རྣམ་པ་དང་བྲལ་བ་ཡིན་པ་དེས་ན་དེ་ནི་འཛིན་པ་མ་ཡིན་ཏེ།",
    "ཞུགང་གི་ཕྱིར་སེམས་གཟུགས་ལ་སོགས་པའི་ཞུརྣམ་པ་དང་བྲལ་བ་ཡིན་པ་དེས་ན་གཟུང་བ་རྣམས་ཀྱང་ཅི་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཐོག་མའི་སྒྲས་ནི་ཀ་བ་ལ་སོགས་པའི་སྟེང་གི་ཆ་གཟུང་ཉུངོ།",
    "ཀ་བ་ལ་སོགས་པ་གཅིག་པུ་ཉིད་ལ་ཐོག་མ་དང་དབུས་དང་ཐ་མའི་གེཆའི་བྱེ་བྲག་གིས་དུ་རང་བཞིན་ཐ་དད་པར་ཉེ་བར་དམིགས་པ་ཡོད་པ་ལ་གཅིག་པ་ཉིད་དུ་ཁས་བླངས་ནས་སྤྱོད་ཅག་ལྟར་རང་ཉིད་སླུ་ཙོབར་ཇི་ལྟར་བྱེད།",
    "ཞེས་བྱེ་བྱ་བ་སྨོས་ཏེ་རྡུལ་ཕྲ་རབ་རེ་རེའི་ངོ་བོར་ཡང་མཐོང་བ་མ་ཡིན་ཞིང་ཤེས་པ་མ་ཡིན་ཏེ།",
    "རྡུལ་ཕྲ་རབ་རྣམས་ནི་རང་གི་ངོ་བོར་སྣང་བ་མ་ཡིན་ཏེ།",
    "དྲུག་གིས་ཅིག་ཅར་སྦྱར་བས་ན།",
    "དེ་ཡང་ཕྱི་རོལ་གྱི་དོན་ཡོད་པར་སྨྲ་བ་འདི་དག་གི་གཞུང་ལུགས་ནི་རྡུལ་ཕྲ་རབ་རྣམས་ཕན་ཚུན་ཕྲད་པ་ལས་རྡུལ་ཕྲ་རབ་གཉིས་ལ་སོགས་པའི་རིམ་གྱིས་ཆ་ཤས་ཅན་དུ་མ་ལ་སོགས་པ་བསྐྱེད་པའི་སྒོ་ནས་ཆ་ཤས་ཅན་གྱི་ཧུརྫས་གཙོ་བོ་སྐྱེད་དུ་པར་བྱེད་པར་འདོད་དོ།",
    "དེ་ལ་རེ་ཞིག་ཆ་ཤས་ཀྱིས་འབྱར་བར་ནི་མི་བྱེད་དེ།",
    "གང་གི་ཕྱིར་རྡུལ་ཕྲ་རབ་ཐམས་ཅད་རྡུལ་ཕྲ་རབ་གཅིག་གི་ནང་དུ་ཞུགས་པས་སའི་དཀྱིལ་འཁོར་ལ་སོགས་པའི་བསགས་པའི་མཚན་ཉིད་ཅན་མེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "དྲུག་གིས་སྦུག་ཅར་སྦྱར་བས་ན།",
    "གང་གི་ཕྱིར་རྣམ་པར་ཤེས་པ་ལ་ཡང་ཕྱོགས་ཀྱི་ཆ་ཤས་ཀྱི་དབྱེ་བ་ཡོད་དོ།",
    "གཟུགས་ཅན་ཡིན་པའི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པ་ནི་གཅིག་དང་དུ་མ་དང་བྲལ་བ་ཡིན་པ་དེ་ཤེས་པ་ལ་ཡང་མཉམ་མོ།",
    "གཟུགས་ནི་ཆུ་དང་ཞེང་དང་ཕྱོགས་དང་ལྡན་པ་ཡིན་ལ་འདི་ནི་རྣམ་པར་ཤེས་པ་ལ་ཡང་ཁྱད་པར་མེད་པར་ཡོད་ན་ཀུན་རྫོབ་ཏུ་ཡོད་པར་ཐལ་བར་ཇི་ལྟར་མཉམ་པར་འགྱུར་བ་མ་ཡིན།",
    "རང་གི་རྒྱུད་ཉིད་ཀྱང་གཟུགས་ལ་སོགས་པར་བརྟགས་པ་ནི་ཕྱི་རོལ་གྱི་དོན་མེད་དུ་ཟིན་ཀྱང་རང་གི་བག་ཆགས་ཙམ་ལས་བྱུང་བའི་ཕྱིར་རོ།",
    "དཔལ་བདེ་མཆོག་གི་རྒྱུད་ཕྱི་མ་ལས་ཀྱང་།",
    "རང་གི་ངོ་བོ་ཙམ་ལ་གཞག་པའི་རྣམ་པར་རྟོག་པ་ནི་འབྲས་བུ་ཁ་ན་མ་ཐོ་བ་མེད་པ་ཉིད་ཡིན་པས་དག་པ་ཞེས་བྱ་བའི་མིང་འཐོབ་པར་འགྱུར་ཏེ།",
    "རང་གི་ངོ་བོ་ཙམ་ལ་གནས།",
    "དེ་བས་ན་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་གྱི་དངོས་པོ་འདི་རྣམས་ནི་ངེས་པར་བརྟགས་ན་དེ་ཁོ་ན་ཉིད་དུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་གནས་སོ།",
    "དེ་ཡང་གཟུང་བ་ལ་སོགས་པ་མེད་པར་བསྟན་པས་རང་གི་སེམས་ཉིད་ལ་རང་གི་སེམས་གཞུག་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་བདག་དང་བདག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བདག་དང་བདག་གི་བ་དེ་གཉིས་ཀྱི་རྣམ་པར་རྟོག་པ་ནི་བདག་དང་བདག་གིར་ལྷརྣམ་རྟོག་ཅེས་བྱ་སྟེ།",
    "དག་པའང་བདག་དང་བདག་གིར་རྟོག་པའི་རྣམ་པར་རྟོག་པའི་རྒྱུན་དེའི་ཕྱིན་ཅི་ལོག་མེད་པ་དེའི་རང་གི་ངོ་བོ་ཉིད་ཙམ་དེས་རྣམ་པར་ཤེས་པར་བྱ་ཞིང་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "གང་གི་ཚེ་ཡང་བདག་ལ་སོགས་པར་སྒྲོ་བཏགས་པ་དང་བྲལ་བའི་རང་གི་ངོ་བོའི་དེ་ཉིད་མཐར་ཐུག་པ་དེའི་ཚེ་ནི་སེམས་ཀྱི་རྒྱལ་པོ་དེ་རྣམ་པར་དག་པ་ཡིན་ཏེ་བདག་དང་བདག་གིར་ལོག་པར་རྟོགས་པ་ལས་ལྡོག་པ་ཉིད་ནི་དག་པ་སྟེ།",
    "གང་གི་ཕྱིར་གཟུང་བ་ལ་སོགས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "གཏན་ཚིགས་གང་གི་ཕྱིར་གཟུང་བ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་དང་བྲལ་ཞིང་མེད་པ་ཡིན་པར་ཐམས་ཅད་དུ་སྟེ།",
    "བྱེས་པ་རྣམས་ཀྱིས་སོ་སོར་ཤེས་པར་གྱུར་པའི་ཀུན་རྫོབ་ཀྱི་རང་བཞིན་གང་ཞིག་ཡིན་པའི་ཀུན་རྫོབ་ཏུ་བྱིས་པས་ཤེས་པ་དེའི་རང་གི་ངོ་བོ་དོན་དམ་པའི་རང་བཞིན་འཕགས་པས་མཁྱེན་པ་དེ་ཉིད་ནི་རང་ཉིད་ཀྱི་ངོ་བོ་ཞིག་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ཀུན་རྫོབ་ཀྱི་རང་བཞིན་རིག་པ་དང་ལུང་གི་དབྱེ་བས་རྣམ་པར་དཔྱད་ན།",
    "དངོས་པོ་གཅིག་གི་དེ་ཉིད་གང་གིས་མཐོང་།",
    "ཡང་ན་ཐམས་ཅད་མེད་ཅེས་བྱ་བ་ནི་གང་གི་ཕྱིར་བྲལ་བའི་མེད་པར་གྱུར་པ་ཕན་ཚུན་ལྡོག་པ་མེད་པ་ཉིད་ཀྱིས་རང་བཞིན་གཅིག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཐ་དད་པར་རྣམ་པར་གཞག་བྱེ་གི།",
    "ཞེས་བྱ་བ་ནི་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ལྷ་མོར་གྱུར་པ་རྣམས་ནི་ཡུལ་གྱི་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "དེ་ནི་མ་ལུས་པའི་ལྷ་མོ་སྤྱན་ལ་སོགས་པའི་ཚོགས་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "ཡང་ཞེས་བྱ་བའི་སྒྲ་ནི་སྔ་མ་ལ་ལྟོས་པའི་ཚིག་གིས་བསྡུ་བ་སྟེ།",
    "སྟོབས་དང་མེ་རྣམ་པར་དག་པ་ནི་གོས་དཀར་མོའོ།",
    "བདག་ཏུ་རྣམ་པར་རྟོག་པ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དེ་བདག་གོ་ཞེས་བལྟ་བའོ།",
    "རྐང་གཉིས་མཆོག་གིས་ཐམས་ཅད་དུ།",
    "དེས་རེག་པས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་དང་ལྡན་པར་གྱུར་ཏོ་ཞེས་དེ་བསམ་པར་བྱའོ།",
    "རྩེ་གཅིག་པ་དང་ལྡན་པའི་སེམས་ཉིད་ནི་དངོས་པོ་མ་ལུས་པ་ཀུན་གྱི་བདག་ཉིད་དེ་རང་གི་སེམས་ཀྱི་རྒྱལ་པོ་ལ།",
    "བདག་གི་སེམས་འདི་ཉིད་དཀྱིལ་འཁོར་མ་ལུས་པའི་འཁོར་ལོ་ལྟ་བུ་ཡིན་གྱིས་འདི་ལས་ཕྱི་རོལ་དུ་གྱུར་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་ངེས་པར་བྱས་ལ།",
    "སྔ་མ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་བཞིན་དུའོ།",
    "དེ་རྣམས་ཀྱི་སྤྲིན་དང་དེའི་བཀོད་པ་དེ་དག་གིས་སྐུ་ལ་སོགས་པས་ནམ་མཁའི་ངོས་ཀུན་དུ་བཀང་བའི་རྗེས་ཐོགས་ལ་ཀུན་དུ་སྤྲོ་བར་བྱ་ཞིང་ཡོངས་སུ་སྟེ།",
    "དེས་ཕྱོགས་བཅུ་ན་གནས་པའི་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་བཀུག་ནས་རང་གི་ལུས་ལ་བཅུག་སྟེ།",
    "ལྷ་མོའི་པདྨའི་ནང་ན་གནས་པར་གྱུར་པ་དང་།",
    "རང་གི་ལྷ་མོའི་ལུས་ལས་འོད་ཟེར་གྱི་སྒོ་ནས་གཟུགས་རྡོ་རྗེ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་རང་གི་ཁ་དོག་དང་ཕྱག་མཚན་འཛིན་པ་ཕྱུང་སྟེ།",
    "མཐར་ནི་རང་གི་ལུས་ལ་གཞུག་པར་བྱ།",
    "ཞེས་བྱ་བ་ནི་བཟླས་པའི་མཐར་སྐུ་རྡོ་རྗེ་ལ་སོགས་པ་བཏོན་པ་རྣམས་ཤིན་ཏུ་མཛེས་བཞིན་དུ་རང་གི་ལུས་ལ་གཞུག་པར་བྱའོ།་།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་དང་ཐིག་ལེའི་རྣལ་འབྱོར་ལ་ཡང་ཡན་ལག་བཞི་བཞི་སྟེ།",
    "རང་གི་ལྷ་ཡི་རྣམ་པའི་ང་རྒྱལ་ཡིད་ལ་བྱས་ནས་ནི།",
    "རང་གི་འདོད་པའི་ལྷའི་རྣམ་པར་སེམས་བསྐྱེད་པར་བྱས་པ་འཛིན་པས་བྱའོ།",
    "འདི་ནི་གཟུགས་ཀྱི་རྣམ་པར་ཤེས་པའོ་ཞེས་དེ་ལྟར་ནང་གི་བདག་ཉིད་ཅན་ནོ།",
    "དེའི་ཡུལ་རྣམས་ནི་གཟུགས་ལ་སོགས་པ་སྟེ་དེ་དག་གིས་བྱས་པའི་ཕྱིར་རོ།",
    "རང་རང་གི་ངོ་བོ་རྣམ་པར་དག་པ་ནི་བདག་ཉིད་ཀྱི་ངོ་བོ་ཉིད་བུ།",
    "རོ་ནི་གསུང་གི་རྡོ་རྗེ་ཉིད་དུའོ།",
    "རེག་བྱ་ནི་དམ་ཚིག་རྡོ་རྗེ་ཉིད་དུ་སྟེ།",
    "གང་གི་ཕྱིར་དངོས་པོ་འདི་དག་ཐམས་ཅད་ནི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་སྤངས་པ་ཡིས།",
    "ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་ནི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པ་དང་།",
    "ཡང་ན་གང་གིས་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་སྤངས་པར་གྱུར་པའི་སྔགས་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "རང་གི་ཁ་ཟས་དེ་ལྟར་བསམས་ནས་ཡང་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སྦྱིན་སྲེག་གི་ཆོ་ག་ནི་སྦྱིན་སྲེག་གི་ཀྱེཆོ་གའི་བྱ་བ་སྟེ།",
    "ཕུང་པོ་དང་ཕྱེཁམས་དང་སྐྱེ་མཆེད་རྣམས་ཉིད་ནི་བེེམས་པོའི་ཚུལ་ཉིད་ཀྱི་བུད་ཤིང་ཡིན་ལ།",
    "ཇི་ལྟར་ན་ལུས་འདི་ལྟ་བུའི་སེམས་ཀྱི་ལུས་དང་ངག་གི་རང་བཞིན་གྱི་ལས་ཕྱག་རྒྱ་དང་སྔགས་ཀྱི་རྣམ་པར་འགྱུར་ཞེ་ན།",
    "རྒྱུ་གང་གི་ཕྱིར་དངོས་པོ་གཅིག་པུ་ཉིད་ལའང་བློ་ཡིས་སྣ་ཚོགས་པའི་ཀུན་དུ་རྟོག་པ།",
    "རྨི་ལམ་དུ་བུ་མོ་བརྒྱན་པ་མཐོང་བ་ལ་སོགས་པའོ།",
    "ཐ་མལ་པའི་རྣམ་པར་རྟོག་པ་ནི་བདག་དང་བདག་གིར་རྣམ་པར་རྟོག་པའོ།",
    "གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་དངོས་པོ་གང་ཞིག་གང་དང་ལྷན་ཅིག་ཏུ་མི་མཐུན་པར་ལན་ཅིག་ཏུ་གྱུར་པའམ་ཞེས་བྱ་བ་དུས་གཅིག་གི་ཚེ་ན་མི་མཐུན་པར་གྱུར་པ་ཡིན་པས།",
    "གང་གི་ཕྱིར།",
    "མི་མཐུན་པར་གྱུར་པར་མཐོང་ཞིང་ཉེ་བར་དམིགས་པ་ཡང་དང་ཡང་དུ་ཡིད་ལ་བྱེད་པས་ལྗུ་བསླབས་པ་གང་ཡིན་པ་དེ་རྣམ་པར་འཕེལ་ཞིང་རབ་ཀྱི་མཐར་ཐུག་པར་གྱུར་པ་ནི་རང་གི་མི་མཐུན་པའི་གཉེན་པོར་གྱུར་ཅིང་སྲིད་པའི་སྡུག་བསྔལ་ཤིན་ཏུ་འགག་པར་བྱེད་ཅིང་མཆོག་ཏུ་ངེས་པར་བྱེད་པའི་རང་བཞིན་ཅན་ཡིན་ཏེ།",
    "དེ་བས་ན་སྲིད་པའི་སྡུག་བསྔལ་དང་ལྷན་ཅིག་མི་མཐུན་པ་ཉིད་ཀྱིས་ན་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་རྣམ་པ་མཐོང་བའི་སེམས་བསླབས་པས་ཀྱང་རྣམ་པར་འཕེལ་ཞིང་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་རྣམ་པའི་སེམས་དེ་བགྲོད་ཀྱེཔ་རྒྱས་པར་གྱུར་པ་ན་རང་གི་མི་མཐུན་པའི་སྲིད་པའི་སྡུག་བསྔལ་ཡང་དང་ཡང་དུ་འགོག་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཐ་མལ་པ་ཡང་ཡིན་ལ་རང་གི་ངོ་བོ་ཡང་ཡིན་པས་ན་ཐ་མལ་པའི་རང་གི་ངོ་བོ་སྟེ།",
    "བདག་དང་བདག་གི་ངོ་བོ་ལ་སོགས་པ་ཀུན་དུ་སྣང་བའི་རང་བཞིན་ནོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་སེམས་ལ་བདག་གི་མེད་པ་དང་ལྡན་པས་ཀྱང་།",
    "ཐ་མལ་པའི་རང་གི་ངོ་བོ་ལས་ལྡོག་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གང་གི་ཕྱིར་འདིར་ཐ་མལ་པའི་རང་གི་༡ངོ་བོ་ལ་ཡོད་ཀྱང་ཞེས་བྱ་བ་བདག་མེད་པ་དང་ལྡན་དུ་ཟིན་ཀྱང་།",
    "གལ་ཏེ་སྦྱིན་པ་ལ་སོགས་པ་ཐ་མལ་པའི་རང་གི་ངོ་བོ་དང་མཐུན་པར་མཐོང་བར་གྱུར་པ་དེའི་ཚེ།",
    "རང་གི་མི་མཐུན་པའི་ཐ་མལ་པ་རང་གི་ངོ་བོ་ལས་སྡོག་པར་བྱེད་པར་འགྱུར་ན།",
    "གང་གི་ཚེ་མ་མཐོང་ན་དེ་ལྟར་ལྡོག་པར་བྱེད་པ་༤ཅི་ལྟར་ཡིན།",
    "ཡེ་ཤེས་བསམ་ཡས་སྐད་ཅིག་གིས་བསྒྲུབས་པ།",
    "པའི་ཕྱིར་སྐད་ཅིག་གིས་ཏེ།",
    "དག་༤གིས་ཤེས་པའི་ང་རྒྱལ་གྱིས་བྱས་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "༡༣༣༩པེ་སྣར་ཆོ་ག་པེ་སྣར་གིཚོགས་ཀྱི།",
