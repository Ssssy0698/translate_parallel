    "བོད་ཀྱི་སྔ་ཕྱིའི་མཁས་པ་རྣམས་ཀྱིས་ཤིང་རྟའི་སྲོལ་འབྱེད་ཀྱི་རྣམ་བཞག་ལ་མཐའ་དཔྱོད་རྒྱས་པར་མཛད་འདུག་ནའང་།",
    "བོད་ཀྱི་མཁས་པ་རྣམས་ཀྱིས་ལྷ་དང་མི་ལ་ཕྱོགས་ཞེན་བྱས་ནས་བྱམས་མགོན་ཤིང་རྟའི་སྲོལ་འབྱེད་དུ་མ་བཞག་པ་ཙམ་ལས་འཐད་སྒྲུབ་ཀྱི་རིགས་པ་གཞན་མེད་ལུགས་གསུངས་འདུག་པ་དེ་ལའང་དགོངས་པ་བཞེས་ས་ཞིག་ཡོད་ངེས་ཀྱང་།",
    "ཏཱརནཱཐས་ཀྱང་ཕལ་ཆེར་དེ་བོད་ཀྱི་སྐད་ཆ་ཡིན་བཟོ་འདུག་ཅེས་གསུངས་པ་མ་ཟད།",
    "ཞེས་བྱུང་བ་དེ་ཡང་ཨུ་རྒྱན་གྱི་སློབ་དཔོན་ཞེས་པའི་ཚབ་ཏུ་འཕུར་འགྲོའི་སློབ་དཔོན་ཞེས་གསུངས་འདུག་འགྲོ་ལྡིང་ངམ་འཕུར་འགྲོ་ཨུ་རྒྱན་གྱི་བོད་སྐད་ཡིན་ན་དེའི་སྐད་དོད་དུ་ལེགས་སྦྱར་གྱི་སྐད་ལ་ཨུ་རྒྱན་ཟེར་བ་ཞིག་ཡོང་ཐབས་མེད།",
    "ཚིག་དོན་ཇི་ཡིན་བཅས་འགྲེལ་བརྗོད་གནང་མཁན་ཞིག་བྱུང་ན་གསེར་གྱི་མཎྜལ་མ་འབྱོར་ཡང་རང་ནུས་དང་འཚམས་པའི་མཎྜལ་ཞིག་ངེས་པར་དུ་འབུལ་རྒྱུའི་འདུན་པ་ཡོད།",
    "བོད་དུ་ཐེངས་གཉིས་པ་ཕེབས་དུས་འཕགས་པ་གནས་བརྟན་པའི་དགེ་སློང་སེར་པོ་གནང་སྟེ་ཕེབས་འདུག་རཱཧུལ་གྱིས་བོད་ཀྱི་སྐོར་བྲིས་པའི་དེབ་ཀྱི་ནང་ཟུར་ཟའི་ཚུལ་དུ་བོད་པ་རྣམས་སྒྱུ་མ་དང་ུ་འཕྲུལ་ལ་དགའ་བས།",
    "བོད་མི་ཚོའི་ནང་ཞི་བ་འཚོ་དང་ཀམལཤིའལ་གྱི་མཚན་ཤེས་མཁན་ཡང་དཀོན་པོ་འདུག་",
    "ཅེས་བྲིས་འདུག་དེང་རབས་ཀྱི་ཤེས་བྱའི་གནས་ལ་བློ་གྲོས་ཡངས་ཤིང་ཡུལ་གྲུ་མང་པོར་ཕེབས་བཞུགས་དང་།",
    "ལམ་དེ་ཀུན་གྱི་འཇིགས་པ་དྲན་ཙ་ན།",
    "ངའི་སེམས་ཆགས་ས་ཁྱེད་རང་ལས་གཞན་པ་སུ་ཞིག་ཡོད།",
    "དེ་འདྲའི་བསམ་བློ་འཁོར་དུས་ཞེན་ཐག་མི་ཆོད་པ་འདུག་ཅེས་ཞུས་པར།",
    "ཕྱིས་སུ་ལེགས་སྦྱར་སྐད་ཀྱི་སནཱཏན་ཞེས་པ་བོད་སྐད་དུ་གཡུང་དྲུང་ཞེས་བསྒྱུར་འདུག་དཔེར་ན།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་ལ་སོགས་པས་བསམ་ཡས་སྒྲ་སྒྱུར་གླིང་དུ་སྔ་དྲོ་རྒྱ་སྐད་ནས་གཙུག་ལག་བསྒྱུར།",
    "བོན་ལ་ཕྱི་བོན་དང་ནང་བོན་གཉིས་ཡོད་པར་གསུངས་འདུག་པས་འབྲི་གུང་སྐྱོབ་པའི་གསུང་ལ་ཁུངས་ལུང་ཚད་ལྡན་ཞིག་ཡོད་ངེས་ཀྱང་།",
    "ཟློས་གར་ཞེས་བགྲང་གནང་མཛད་འདུག་ནའང་།",
    "བཀའ་གདམས་པའི་དམ་པ་རྣམས་ཀྱིས་ང་ཐོས་དུས་ཙ་ན་བསམ་པ་བདོ།",
    "དེའང་རང་དོན་དུ་མ་ཡིན་པར་གཞན་གྱི་དོན་དུ་བྱེད་འདོད་ཀྱི་ཀུན་སློང་ལ་ལྷག་པའི་བསམ་པ་ཞེས་ཟེར།",
    "གོང་ས་ཆེན་པོས་གསར་གཏོད་མཛད་པའི་ལྟ་གྲུབ་ལ་ཉམས་ཞིབ་བྱེད་མཁན་ཕལ་ཆེ་བ་ནུབ་ཕྱོགས་པའི་མི་རིགས་ཡིན་པ་ལྟ་བུ་འདུག་པས།",
    "དངོས་གསལ་དོད་པོ་མེད་པ་ཅི་རིགས་ཀྱི་ཤན་ཤུགས་འདུག་སྟབས།",
    "རང་ཉིད་གོས་རྒྱན་དཀར་པོ་སྐྱིལ་ཀྲུང་ངམ་ཙོག་པུའི་ཤར་བལྟས་འདུག་ལ།",
    "ག་དུས་གཞི་ནས་བྱུང་བ།",
    "དབུགས་འགྲོ་སྟངས་ཀྱི་ཐོག་ནས་ག་དུས་འཆི་མིན་བརྟག་དཔྱད་བྱས་ཚེ་ཧ་ཅང་ཐིག་པོ་ཡོད།",
    "སྐྱོན་ཟེར་བ་དེ་དང་རང་གཙོ་བོ་བྱེད་རྒྱུའི་སྒེར་སེམས་དེ་གཉིས་བར་འབྲེལ་བ་གང་འདྲ་ཡོད་མེད་སོགས་ལ་ཉམས་ཞིབ་ནན་པོ་བྱས་ཚེ་བསམ་བློ་རྒྱ་ཆེན་པོ་གཏོང་རྒྱུ་ཡོད་པ་མ་ཟད།",
    "བདེ་སྡུག་གང་ཡང་མ་ཡིན་པའི་བཏང་སྙོམས་བཅས་གང་བྱུང་ཡང་ཁོ་རང་ལ་ཤུགས་རྐྱེན་གང་ཡང་ཐེབས་ཀྱི་མེད་སྟབས་སྡོད་སྐུམ་ལྡན་པའི་ཡོན་ཏན་ཏེ།",
    "བཞི་པ་ཁེར་རྐྱང་དུ་གནས་པ་སྟེ་ཁོ་རང་ཁེར་རྐྱང་ཡིན་པ།",
    "དཔེར་ན་ཆུའི་ཡོན་ཏན་ནི་བརླན་ཞིང་གཤེར་བ་ཡིན་པས་དེ་དང་ཐུག་དུས་བརླན་གཤེར་ཆགས་པ་དེ་ཆུའི་ཡོན་ཏན་ཡིན་སྟབས་དེ་ལ་གཤེར་བ་ཟེར།",
    "རྗེས་སུ་ཁོ་རང་གཉིས་ཀྱང་སོ་སོའི་གཟུགས་པོ་ལ་མེ་འབར་ནས་ཤི་བ་ཡིན་པར་བཤད།",
    "དེའི་ནང་ནས་དུམ་བུ་གཅིག་དགྲ་ཡི་གནོད་པ་མེད་ཀྱང་རང་བཞིན་གྱིས་ཉམས་ཆག་ཤོར་བ།",
    "དེའི་ཐད་ང་རང་ལ་ཉམས་མྱོང་ཧ་ཅང་ཕུན་སུམ་ཚོགས་པོ་ཡོད།",
    "ཡང་རྟ་དང་གླང་པོ་ཆེ་སོགས་ལ་ཆ་བཞག་ན་དགྲ་ཕྱོགས་དང་རང་ཕྱོགས་དབྱེ་བ་ཆོད་ཙམ་ཡོད།",
    "ད་ལྟ་ཐུགས་དམ་ལ་བཞུགས་འདུག་ཟེར་བ་དེ་ཚོ་ཡང་དེའི་དུས་སུ་ཡིན་ཅིང་།",
    "མི་དམངས་ཀྱི་ཆེད་དུ་ཞབས་འདེགས་ཞུས་ཟེར་བའི་མི་དམངས་དེའི་ནང་རང་ཉིད་ཚུད་ཡོད་པ་ལས་རང་ཟུར་དུ་དགར་བ་ཞིག་མིན།",
    "དེ་ཡང་རང་རྟོགས་ཡོད་པའི་བྱ་སྤྱོད་བཟང་པོ་ཞིག་ཡོད་དགོས།",
    "གཞན་གྱིས་རང་ལ་དགོངས་དག་ཐུགས་བདེན་ཞུས་ནའང་ད་དུང་རང་ཉིད་ཁྲོས་ནས་སྡོད་པ།",
    "ངལ་གསོ་རྒྱག་དུས་ངལ་གསོ་རྒྱག་དགོས་པ་ལས་བརྩོན་འགྲུས་བྱེད་སྐབས་གཉིད་ཀྱང་མ་ཉལ་བར་བྱེད་པ་ལྟ་བུ་དང་།",
    "ད་འདི་མ་བྱུང་ན་ཐབས་མི་འདུག་བསམ་པ་དེ་ནི་འདོད་ཆགས་ཀྱི་དམིགས་པ་ཡིན་པས།",
    "ལུས་ནི་ཧ་ཅང་ཡང་རྒྱབ་ཏུ་མི་དགྱེ་ཧ་ཅང་མདུན་དུ་མི་སྒུར་བར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་དགོས་ཤིང་།",
    "མཆུ་ཏོ་ཡང་རང་བབ་ཏུ་འཇོག་དགོས་པ།",
    "སྤྱི་ལོའི་དུས་རབས་བཞི་པ་ནས་ལྔ་པའི་མཇུག་བར་བྱུང་བ་ཡིན་ཚོད་འདུག་སློབ་དཔོན་འདིའི་ཡབ་ནི་རྒྱལ་རིགས་དང་།",
    "སློབ་དཔོན་འདི་ཉིད་སྐུ་ཚེའི་སྨད་དུ་རྒྱ་གར་ལྷོ་ཕྱོགས་སུ་བྱོན་པའི་དུས་སྤྱི་ལོའི་དུས་རབས་དང་པོའི་འགོ་ཚུགས་པ་ཡིན་ཚོད་འདུག་ཀྱང་།",
    "སྦྲུལ་འདུག་གོ་སྙམ་པའི་བསམ་བློ་སྐྱེས་པ་ཡིན།",
    "བསམ་བློའི་ཐོག་ནས་ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་གཉིས་ཀྱི་ཁྱད་པར་ཕྱེ་བ་ནི་སྟོང་པ་ཉིད་ཀྱི་དོན་རྟེན་འབྱུང་ཡིན་པའི་གོ་བ་ཚིག་ཙམ་དུ་མ་ལུས་པ་ཞིག་དགོས་པ་དེར་ཐུག་པ་ཡིན།",
    "ཕུང་པོ་ལྔ་ལས་ཟུར་དུ་ང་ཟེར་བ་ལིང་ལིང་ཞིག་འདུག་བསམ་པའི་བསམ་ཚུལ་དེ་ནོར་འཁྲུལ་ཡིན་པས་དེ་མེད་པ་བཟོ་དགོས་པ་ཡིན།",
    "ཤིང་རྟ་འཁོར་ལོ་ཟེར་བ་དེའི་མིང་དེ་ཇི་ལྟར་བྱུང་མིན་དང་དེའི་ཐ་སྙད་འདོགས་སྟངས་ཀྱི་གཞི་འཛིན་ས་དེ་གང་དུ་འདུག་གམ་བརྟད་དཔྱད་བྱ་རྒྱུ་སྟེ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་དེ་ཕར་ངོས་སུ་གནས་ཡོད་ནའང་རང་ལ་འཆར་སྣང་ཡོང་མི་ཐུབ།",
    "ཤིང་ཡིན་ནའང་འདྲ་དེ་རྣམས་ཕྱི་རོལ་ཡུལ་གྱི་ཐོག་ནས་ཚུར་གྲུབ་བསྡད་འདུག་གམ།",
    "དེ་ཡོད་དང་མེད་ཀྱི་བསམ་བློ་དེ་ནི་དེ་ལ་མིང་གཅིག་བཏགས་ནས་གཞི་ནས་འདུག་བསམ་པའི་འཆར་སྣང་ཞིག་བྱུང་བ་ལས།",
    "དེ་བཞིན་རྟའི་མཇུག་མ་ཞིག་ཡོད་པར་ཆ་མཚོན་ན་འདིར་རྟའི་མཇུག་མ་ཞིག་འདུག་ཟེར་བ་ལས་འདིར་རྟ་འདུག་རྩ་བ་ནས་ཟེར་སྲོལ་མེད་ཅིང་།",
    "དཔེར་ན་ང་རང་ལ་ཆ་བཞག་ན།",
    "སོན་དེ་ག་དུས་ཡིན་ནའང་སོན་དེ་རང་བྱས་ནས་སྡོད་པ་ལས་ཡར་མྱུ་གུ་སྐྱེ་རྒྱུ་རྩ་བ་ནས་ཡོང་མི་སྲིད།",
    "དེར་བརྟེན་སྟོང་པ་ཉིད་ཀྱི་ལྟ་བ་དེ་ཤེས་རྟོགས་མ་བྱུང་གོང་ཡོད་པ་དང་རང་བཞིན་དུ་གྲུབ་པ་གཉིས་ཀྱི་དབྱེ་བ་དེ་ཡག་པོ་ཞིག་ཆོད་མི་ཐུབ།",
    "དེ་མིན་ན་མི་འདུག་བསམ་པ་ཞིག་ཡོད།",
    "འོ་ན་བཀྲ་ཤིས་གང་དུ་འདུག་གམ་ཞེ་ན་བཀྲ་ཤིས་དེ་ཕུང་པོ་ལྔ་ཚོགས་པ་དེ་ལ་བརྟེན་ནས་མིང་བཏགས་ཙམ་ཞིག་ལས་མེད།",
    "མིང་འདོགས་ས་ཁོ་རང་བཀྲ་ཤིས་མིན།",
    "མི་ལོང་བ་ཞིག་ཡོད་ན་དེ་མིང་འདོགས་སའི་གཞི་ཡིན་པ་ལས་ཁོ་རང་མིན།",
    "དེ་ཁོ་རང་ཡིན་ན་ཁོ་རང་མིག་ལོང་བ་ཡིན་དུས་ང་དེ་ཡང་ལོང་བ་ཞིག་ཡོང་དགོས་པས་དེ་འདྲ་ཡོང་མི་སྲིད།",
    "རང་ལས་སྐྱེ་བ་དང་གཞན་ལས་སྐྱེ་བ་གཉིས་བཀག་ཚར་རྗེས་གཉིས་ཀ་ལས་སྐྱེ་བ་དེ་དེ་གཉིས་དང་ཆབས་ཅིག་ཏུ་བཀག་ཐུབ་པ་ཡིན་པས་དེའི་སྐོར་རྒྱས་པོ་ཞུ་དགོས་པ་མི་འདུག་བཞི་པ།",
    "དེས་འབྲས་བུ་ཁོ་རང་རང་བཞིན་གྱིས་སྐྱེ་བ་ཞིག་ལས་དེ་ལ་རྒྱུ་དང་རྐྱེན་གང་ཡང་མེད་དེ།",
    "དངོས་པོ་གང་འདྲ་ཞིག་ཡིན་ནའང་རང་བཞིན་གྱིས་གྲུབ་པ་མིན།",
    "ང་ཟེར་བ་དེ་ཕུང་པོ་ལྔ་དང་གཅིག་པ་བྱས་ནས་འདུག་གམ།",
    "ཡང་ན་ཕུང་པོ་ལྔ་དང་ལོགས་བཀར་བྱས་ནས་འདུག་གམ་དེ་རིག་པ་གཏོང་དགོས།",
    "གཅིག་ཡིན་པ་འགོག་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དད་ཡིན་པ་འགོག་པའི་རིག་པ་དེ་གཉིས་བསྡོམས་པའི་རིག་པ་དེ་ལ་གཅིག་དུ་བྲལ་ཞེས་བརྗོད་པ་ཡིན།",
    "ཁོང་རང་ཉིད་ཀྱི་ལྟ་བ་ངོ་མ་དེ་གང་ཡིན་མིན་གསུངས་མེད།",
    "དེ་བཞིན་འདི་སྙན་པོ་འདུག་བསམ་པའི་འཆར་སྣང་།",
    "དེ་སྙན་པོ་མི་འདུག་བསམ་པའི་འཆར་སྣང་།",
    "དེ་ཞིམ་པོ་འདུག་བསམ་པའི་འཆར་སྣང་།",
    "འདི་ཞིམ་པོ་མི་འདུག་བསམ་པའི་འཆར་སྣང་དེ་ཚོ་ཚང་མ་འཆར་སྣང་ཤ་སྟག་ཡིན།"
  ]
}