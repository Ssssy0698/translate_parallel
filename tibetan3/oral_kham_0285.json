    "གཏེར་མང་དུ་འདུག་པ་ལ་འགའ་ཙམ་ལས་མ་བླངས།",
    "སྤྱིར་སད་མི་བདུན་རབ་ཏུ་བྱུང་ཚེ་བེ་རོ་ཙ་ན་རཀྵི་ཏ་ཞེས་རྣམ་སྣང་སྲུང་བའམ་རྣམ་སྣང་འཚོར་མིང་བརྗེས་པ་ཡིན་ཡང་སླར་ཡང་རྣམ་པར་སྣང་མཛད་ཉིད་དུ་བཏགས་པའོ།",
    "བདག་རང་བེ་རོ་ཙ་ན་ཡང་།",
    "ཤྲཱི་སིདྷ་དང་༣༤ན་དགའ་རབ་རྡོ་རྗེ་སོགས་བེ་རོ་ཙ་ན་དང་དུས་མི་མཚུངས་སོ་སྙམ་དུ་དོགས་པར་མི་བྱ་སྟེ་གྲུབ་ཆེན་དེ་རྣམས་ནི་སྐལ་ལྡན་ལ་ད་ལྟར་ཡང་མཇལ་དུ་ཡོད་པའི་ཕྱིར་རོ།",
    "བདག་བེ་རོ་ཙ་ན་སྟོབས་ལྡན་ནག་པོའི་དཀྱིལ་འཁོར་ལ་བབས་སོ།",
    "འོ་ན་མི་སྒོམ་མམ་དྲིས་པས་ང་གང་ལ་ཡེངས་འདུག་གསུངས་པས་དྲི་རྒྱུ་ཟད།",
    "གཞན་འདི་རྣམས་ཕལ་ཆེར་མཐུན་པར་འདུག་ལ།",
    "དེ་ན་ཌཱ་ཀི་གདོང་བཞི་པ་ཞིག་འདུག་པའི་མདུན་ཞལ་དཀར་པོ་ནས།",
    "ཟངས་སྒྲོམ་ཕྱག་ཏུ་ཕུལ་བས་མང་པོ་ཡོད་པར་འདུག་དཀར་ཆག་ཀློགས་གསུངས་ནས་བཀླགས་པས།",
    "ཡུལ་དང་བུ་སྨད་ཀྱང་མ་ཉམས་པར་འདུག་༦༡ན་སྟེ་ཚིགས་བཅད་ཀྱི་དོན་གོ་ནས་རི་བོའི་རྩེར་བསྒོམས་པས་གྲུབ་པ་ཐོབ་སྟེ་ཡུལ་དེ་བཏུལ་ཏོ།",
    "དེ་ནས་ཤིན་ཏུ་ཕྲ་བས་ཁོང་རང་གཉིས་མ་གཏོགས་པས་མ་གོ།",
    "ཁྱི་ལ་རྡོ་ཕོག་སར་སྨུག་ཁྱུར་གྱིས་སྐྲངས་འདུག་སྐད་དེ་བདག་གཞན་བརྗེ་ནུས་པ་དེ་དང་།",
    "གསེར་གླིང་དུ་བྱོན་པས་ལྷའི་ཡུལ་འདྲ་ཞིང་བསྟན་པ་དར་བར་འདུག།",
    "ཁ་སང་མགྲོན་བཙུན་ཞིག་འདུག་པ་དེ་ཡིན་ནམ་ཟེར་ནས་བཙལ་པས་བཞུགས་འདུག་སྟེ་རྡོ་རྗེ་གདན་དུ་དེའི་བསྙེན་བཀུར་བཞེས་ཤིང་བཞུགས།",
    "བ་ཅི་གེ་རའི་གླིང་ན་གྲུབ་ཐོབ་ཤ་སྟག་ཡིན་ཟེར་ནས་ངས་བལྟར་ཕྱིན་པས་མི་བདེན་པར་འདུག་ཟེར།",
    "བོད་ནས་ཚུར་མི་ལྡོག་པར་འདུག།",
    "བྱེད་པར་མི་འདུག་བོད་རྒྱལ་པོས་ངེད་ཀྱི་མི་རྐུར་བཏང་བར་འདུག།",
    "ཇོ་བོ་ཡང་གཤེགས་པ་ལ་དགྱེས་པར་འདུག་མ་བཏང་ན་གཞན་དོན་གྱི་བར་ཆད་དུ་འགྲོ།",
    "མཁས་པ་མང་པོས་ཇོ་བོ་ལ་ལྟ་བ་གང་བཞེད་ཞུས་པས་ཁྱེད་རང་གང་འདོད་གསུངས་ཏེ་དབུ་སེམས་སོགས་གཏམ་རྙིང་ལྟར་འདི་འདོད་ཞུས་པ་ན།",
    "སྣང་བ་སེལ་ལམ་མི་སེལ་ཞུས་པས་འབྲས་ཆན་ལ་རབ་རིབ་དག་པ་ལྟ་བུ་ཡིན་གྱི་ཁྱེད་རང་དཔྱོད་དང་གསུངས།",
    "གསང་སྔགས་ལ་ང་རང་མཁས།",
    "དེའི་དུས་ཀྱི་བསྟན་པ་ལྟ་བུ་རྒྱ་གར་དུ་ཡང་མ་བྱུང་པ་འདུག།",
    "འབྲོམ་གྱིས་ཁུ་སྟོན་མི་དགྱེས་པར་འདུག་པས་བདག་དབུ་རུར་མཆི་ལགས་སམ་ཞུས་པས།",
    "དགྲ་བཅོམ་པ་ཞིག་ཀྱང་འདུག།",
    "འདོན་པར་བརྩམས་པས་གཏེར་སྲུང་གཉན་པོ་ཞིག་འདུག་སྟེ་དེ་རིང་ཙམ་ཟིན་ཞིག་འབྲིར་བཏང་གཞན་མི་སྟེར་ཟེར་ནས་རྣལ་འབྱོར་པ་དང་སྟོན་པ་སོགས་བཞིས་སྣག་སྨྱུག་ཅི་རྙེད་ཀྱིས་བྲིས་པས་ལྷག་དུམ་ཞིག་ལུས།",
    "དེ་ནས་ཞག་གཉིས་ན་རང་བཞིན་གྱི་རྣལ་འབྱོར་མ་ལྷ་རྣམས་ཀྱིས་བསུས་ནས་གཤེགས་གསུངས་ཏེ་རྣལ་འབྱོར་པས་ཕྱིན་པས་གྲོངས་མ་ཐག་དུ་འདུག།",
    "ཁོ་བོ་འོང་མི་དགོས་པར་འདུག་པ་ལ་གསུངས་ནས་གདམས་པ་ཤས་ཤིག་གནང་།",
    "ཁུ་སྟོན་གྱིས་ཇོ་བོས་ཀྱང་མི་ཆེན་པོ་མི་མཁྱེན་པར་གདའ་དེ་ལྟར་མཛད་པ་མ་ལགས་ཞུས་པས།",
    "ཁྱེད་རང་ཡང་རི་ལ་སྒོམས་གསུངས།",
    "རྒྱ་གར་ལ་འབྱོན་པ་འདུག་པས་མྱུར་དུ་བྱོན་ཟེར་བ་བྱུང་།",
    "ངས་བསྒོམས་པ་ཡིན་ཏེ་རྟོགས་པ་དེ་ཁོང་གཉིས་མཐོ་བར་འདུག་གསུང་སྐད།",
    "ཆུ་མིག་གཉིས་འདུག་པ་སྒྲོམ་དུ་དྲངས།",
    "ཡང་ལན་གཅིག་ཇ་གསོལ་དུས་རྟོགས་པ་ཞིག་ཕུལ་དང་གསུང་བ་ལ་གཟུང་བའི་ཡུལ་སྒྱུ་མའི་རང་བཞིན་ལ་ཞེན་ཞིང་ཆགས་པ་མི་གདའ་འོ།",
    "ཀླུ་ཆེ་བ་ཞིག་༣༧ན་འདུག་པ་བཏུལ་ནས་ཕ་བོང་ཐག་ཐུག་རྣམས་བཅག་ཅིང་སྦས་ཏེ་བྱ་ཡུལ་བཏབ།",
    "ཕྱག་བཙལ་བས་སྐུ་རགས་ཆད་དེ་ཡོས་འཐོར་བས་ཞལ་བ་ཁྱབ་པས་ཕྲིན་ལས་ཆེན་པོ་ཡོང་པར་འདུག་གསུངས།",
    "རྣམས་མི་འདུག་པས་གཤེགས་ངེས་ཟེར་སྐད།",
    "རྨ་བྱ་བྱང་བརྩོན་རྩོད་པའི་སེང་གེ་ཡང་རང་བཞིན་གྱི་གཟུགས་འདོད་རྒུར་བསྒྱུར་བ་གྲུབ་ཅིང་སློབ་དཔོན་ཟླ་བའི་ལུགས་མཛད།",
    "ཁོང་རང་རི་ལ་མ་ཐོགས་པར་འབྱོན་སྐད།",
    "འུ་ཡུག་པས་ས་པཎ་ལ་རྩོད་དུ་བྱོན་པས་གྲལ་དབུ་ཞིག་མཛད་ཀྱི་འདུག།",
    "འཁྱགས་ནས་འཆི་བར་འདུག་པས་ལུས་ཀྱི་དྲོད་ལ་བཅར་ཏེ།",
    "དུར་ཁྲོད་ན་འདུག་ཟེར་ཏེ་འོངས་པས་འཇག་སྤྱིལ་གྱི་སྒོ་ན་མཎྜལ་བྱེད་ཅིང་འདུག།",
    "ཐོག་མཐའ་གཉིས་མགོ་ཞབས་ལོག་རུང་འདུག་པས་འདིའང་བསྒྱུར་བར་ཞུ་བྱས་པས་འདི་ཙམ་ཞིག་ཕྱི་རབས་ཀྱི་རྣལ་འབྱོར་པ་ལ་སྟོན་པའི་ཕྱིར་འཇོག་གསུངས་པ་དེང་སང་ཡང་ཡོད་སྐད།",
    "མི་ཐམས་ཅད་གཉིད་ཀྱིས་མྱོས་ཏེ་རྒྱལ་པོ་ཨིནྡྲ་བྷཱ་ཏིས་རྣལ་འབྱོར་པས་ཉི་མ་བཟུང་བ་ཞིག་འདུག་ཟེར་ནས་རྩད་བཅད་པས་བི་མ་ལས་རྣལ་འབྱོར་པ་འདི་འདྲ་ཞིག་འདུག་ཟེར་ཏེ་ཉི་མ་གཏོང་བར་ཞུས་པས་འདི་བཏང་ན་ང་ལ་ཆང་རིན་མེད་གསུངས།",
    "དེས་འབྲས་ཆན་དྲངས་པའང་སོ་མར་འདུག་སྟེ་ལོ་བཅུ་གཉིས་ལོན།",
    "ང་རང་ཁྱེའུ་གསལ་བའི་འོད།",
