    "ཁྱེད་རང་ལྟར་ན་མངོན་སུམ་ཤུགས་རྟོགས་མངོན་སུམ་དུ་མི་འདུ་བ་དང་།",
    "ཤེས་བྱའི་ཡུལ་མ་ཡིན་ནས་མ་རྟོགས་པ་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའི་དངོས་པོ་ལྟ་བུའོ།",
    "མངོན་སུམ་དུ་མ་ཟད་རྗེས་སུ་དཔག་པ་ལས་ཀྱང་རང་མཚན་གྱི་དངོས་པོ།",
    "རྨནནཐད་ཀའི་བྱེ་བྲག་ཕྱོགས་ལ་ལྟོས་པས་རྫས་ཐ་དད་ལ་གོང་མའི་བྱེ་བྲག་དུས་ལ་ལྟོས་པས་དེ་ལྟར་བ་དངོས་པོ་འདས་མ་འོངས་དངོས་པོ་མེད་པས་གཅིག་པ་བཀག་པའོ།",
    "དེ་དང་རང་མཚན་ལ་འབྲེལ་པ་གཉིས་ཀ་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ནམ་མཁའ་དང་རང་བཞིན་ལ་ཁྱད་མེད་ཀྱང་དྲུག་པའི་སྒྲས་ཐ་དད་དུ་ཕྱེ་བ་དང་།",
    "མ་སྦྱར་ན་སྤྱི་ལ་སྦྱར་ཡང་རང་མཚན་གོ་མི་ནུས་པས་བར་དེར་ལམ་སྟོན་པ་ལ་སྡོང་དུམ་ལ་འདྲི་བ་ལྟར་མི་དགོས་པའི་སྤྱི་བོར་ལ་རང་མཚན་ཉིད་ལ་དངོས་སུ་བརྡ་སྦྱོར་ཅིག།",
    "ཐོག་མ་མེད་པའི་བག་ཆགས་བརྟས་པ་ལ་སྣང་བར་འཁྲུལ་པའི་ཤུགས་གོམས་པ་དེས་བརྡའི་དུས་ན་དོན་རང་མཚན་དང་སྤྱི་མ་ཕྱེ་བར་འདི་བུམ་པ་ཞེས་བརྡ་བཏགས་ལ་ཕྱིས་བུམ་པར་ཆུ་ལུགས་ཤིག་ཅེས་བརྗོད་པ་ནའང་རང་མཚན་གྱི་བུམ་པར་ཆུ་བླུགས་སམ་དོན་སྤྱིའི་བུམ་པར་བླུགས་ཞེས་མི་འདྲི་བར་འཇུག་ཡུལ་དོན་རང་མཚན་ཉིད་གོ་བ་ཡིན་ཏེ།",
    "གལ་ཏེ་དོན་སྤྱི་ཅིའང་མེད་པ་ལ་བརྡ་བྱས་པས་ཀྱང་རང་མཚན་གོ་ན།",
    "འོ་ན་ཁྱེད་རང་བརྡ་ཆད་བྱེད་པ་མ་ཡིན་ནམ་སྙམ་ན།",
    "དོན་སྤྱི་དང་རང་མཚན་གཉིས་གཅིག་ཏུ་བསྲེས་ནས་བརྡ་ཆད་ཀྱི་སྔགས་ཀྱིས་འཁྲུལ་ཏུ་འཇུག་ལ།",
    "རང་རང་ངོ་བོ་ལ་གནས་པའི།",
    "དངོས་པོ་ལའང་རང་གཞན་གཉིས་སུ་ཁ་ཚོད་ཆོད་ཅིང་།",
    "ཁྱེད་རང་ལྟར་ན་བདག་གཅིག་པས་འབྲེལ་ན་རང་བཞིན་གྱི་དངོས་པོ་དང་དེ་ལས་བྱུང་བས་འབྲེལ་ན་འབྲས་བུའི་དངོས་པོར་འགྱུར་རོ།",
    "གཅིག་ལ་འདུག་པ་འབྲེལ་པ་མེད།",
    "རྒྱུ་འབྲས་གཉིས་པོ་འདི་ནི་གཅིག་ཤོས་དངོས་པོ་ལས་གཞན་དུ་གཅིག་ཤོས་དངོས་མེད་དུ་འདུག་པ་ན།",
    "ལྡན་པ་ལ་སོགས་པ་དེ་དག་དོན་ལ་འབྲེལ་པ་མེད་ཀྱང་ཁྱེད་རང་ལྟར་གཞན་སེལ་གྱིས་སྦྲེལ་ན་བློ་ངོར་འབྲེལ་པ་ཅི་སྟེ་མི་འགྲུབ་སྙམ་ན།",
    "དངོས་ནའང་རང་གྲུབ་རྒྱུ་ཅི་དགོས།",
    "མི་རྟག་ནའང་ཤིང་ཁོ་རང་འཇིག་པས་མེ་མི་དགོས་སོ།",
    "མྱུ་གུ་རང་རང་རྒྱུ་ལ་ལྟོས།",
    "ཐ་དད་ན་གནས་སྐབས་མི་རྟག་པས་དོན་བྱེད་ཀྱང་རང་བཞིན་རྟག་པས་དོན་བྱེད་མི་ནུས་པར་འགྱུར་རོ།",
    "ཕྱིས་མུན་པ་ནུས་མེད་འགགས་པ་ཉིད་སྣང་བ་སྐྱེས་པ་ཡིན་པས་སྐྱེ་འགག་དུས་མཉམ་སྟེ་སྲང་མདའི་མཐོ་དམན་བཞིན་ནོ།",
    "རྟ་དང་འབྲེལ་པའི་བ་ལང་ཞེས་ལྷན་ཅིག་ཏུ་འདུག་པ་ལ་འབྲེལ་པར་འདོགས་པ་བཞིན་ཐ་དད་ལ་འགལ་བར་བཏགས་པ་ཡིན་གྱི་འགལ་བ་མཚན་ཉིད་པ་མ་ཡིན་ནོ།",
    "རང་རང་བསྐྱེད་བྱེད་ཀྱི་རྒྱུ་ཐ་དད་དང་ཐ་མི་དད་ཀྱིས་བསྐྱེད་པའམ།",
    "ཙ་ནསྱཱ།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "འབྲས་བུ་དང་བྱེ་བྲག་གྲུབ་པའི་ཤུགས་ཀྱིས་རྒྱུ་དང་སྤྱི་གྲུབ་པ་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་ཡིན་ལ།",
    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་རིག་པ་ཕྱི་མ་བསྐྱེད་པར་གྲུབ་པས་རིག་པ་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པ་ཙམ་དངོས་སུ་ཁེགས་པ་ན་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་ཏེ་སྒྲོན་མ་ཙམ་གྱིས་འོད་འབྱིན་པར་གྲུབ་པས་འོད་མི་འབྱིན་པའི་སྒྲོན་མའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་པ་བཞིན་ནོ་ཞེས་གསུང་ངོ།",
    "བེམ་པོ་ལས་ལོག་པའི་ཕྱིར་རང་རིག་མངོན་སུམ་བཞིན་ཞེས་བཀོད་པ་ན་མངོན་སུམ་དང་རང་རིག་ཁྱབ་མཉམ་ཡང་དཔེ་དང་ཤེས་འདོད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "མི་དམིགས་པ་ཐམས་ཅད་དཔེ་ལ་སྣང་རུང་མི་དམིགས་པར་འདུ་ལ་དེ་བདག་གཅིག་པའི་འབྲེལ་པ་ལ་བརྟེན་པས་རང་བཞིན་གྱིས་རྟགས་ཡིན་ཅིང་དེ་དག་བཟློག་པས་མི་དམིགས་པའི་འགལ་བའང་རང་བཞིན་འགལ་བའི་ལྟར་སྣང་དུ་འདུ་བས་འགལ་བའང་རང་བཞིན་དང་འབྲས་འགལ་གཉིས་ཉིད་དེ།",
    "ཞེས་བརྗོད་པས་དགག་སྒྲུབ་སྒྲ་དོན་ལ་བྱས་ཀྱང་རང་མཚན་གོ་བ་ཡིན་ཏེ།",
    "གནས་སྐབས་འགྱུར་ཡང་རང་བཞིན་རྟག་པར་འདོད་པ་དང་།",
    "གཞན་དག་ལུང་དང་རང་ཚིག་ཟེར།་",
    "རང་ཚིག་དང་ཁྱད་པར་མེད་པས་དེ་ཁས་བླངས་ནས་འགལ་ཡང་རང་ཚིག་དང་འགལ་བ་དང་།",
    "བརྗོད་འདོད་ཀྱི་གྲགས་པ་ཁས་མི་ལེན་ན་ཁྱེད་རང་ཁས་ལེན་པའི་རི་བོང་ཅན་ལ་སོགས་པར་འདོད་པའང་འཇིག་པས་ཐ་སྙད་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "དམ་བཅའ་དང་རང་ཚིག་འགལ་བ་དཔེར་ན་དགེ་སྦྱོང་མ་སྦྲུམ་མའམ་བདག་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཞེས་བསྲེགས་བསྲེས་ཏེ་མི་སྨྲ་བར་འདུག་ན་སྐབས་དོན་གྲུབ་བོ་སྙམ་ན།",
    "མི་སྨྲ་བར་འདུག་གམ།",
    "ཁྱེད་རང་དེར་མི་འདོད་པའི་ཕྱིར་སྐྱེས་བུ་རྐུན་མ་ལ་རྟགས་མ་ཡིན་ནོ།",
    "དེའང་རང་དོན་དུ་དོན་གྱི་སྐྱོན་འབའ་ཞིག་དཔྱད་ལ་གཞན་དོན་དུ་བློ་དང་སྒྲའི་སྐྱོན་ཡང་དཔྱད་དོ།",
    "ལུགས་འདི་ལ་སྤྱིར་གཏན་ཚིགས་ཡང་དག་ལ་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་གཉིས།",
    "མེ་དང་སྤུ་ལོང་བྱེད་པ་ཕན་ཚུན་འགོག་པ་ན་རྒྱུ་དང་འགལ་བ་དམིགས་པ་དང་རང་བཞིན་འགལ་བའི་འབྲས་བུ་དམིགས་པ་གཉིས་དང་།",
    "མཆོད་རྟེན་ལ་ཡང་རང་བཞིན་ལྷུན་གྲུབ་ཀྱི་མཆོད་རྟེན།",
    "དེ་བཞིན་དུ་སྒྲ་པ་དེ་ཉིད་ཀྱིས་བདེ་གཤེགས་མཆོད་རྟེན་བརྒྱད་ལ་བསྟོད་པ་ཞིག་མཛད་འདུག་པར་ཡང་།",
    "རང་རང་ཕྱག་མཚན་མེ་ཏོག་ཆུན་པོ་ལ།",
    "འདུག་སྟངས་ལྷོད་ཅིང་དེས་པའི་ངང་ཚུལ་ཅན།",
    "སྔར་ཁྱེད་ཀྱི་རྒྱལ་པོ་རྣམས་ཀླུས་བསད་འདུག་དེ་ངེད་ཀྱིས་མདང་ནུབ་བཏུལ་གྲུབ་པས།",
    "ད་ཁྱེད་རང་རྒྱལ་པོར་ཞུའོ་ཟེར་ཏེ།",
    "དེ་ཡང་ད་ལྟ་ང་ལ་ནུས་པ་མེད་རྒྱལ་པོ་འདིའི་སྲས་སུ་གྱུར་ན་ནུས་པ་འདུག་དགོངས་ཏེ།",
    "སྐྱེས་ལན་བཟང་པོ་འདོད་དུ་འོང་སྙམ་ཙ་ན།",
    "སྲོག་ཆགས་མི་འགྲོ་འདུག་སོགས་དང་།",
    "མགྲིན་པ་ལ་ཡང་རང་སོར་བཞི།",
    "མགྲིན་པ་ལ་ཡང་རང་སོར་ཕྱེད་བཞི།",
    "མཐོང་བ་ཙམ་ལ་ཕན་ཡོན་དཔག་ཏུ་མེད་པ་ཅན་བསྟན་པ་དང་རང་གཞན་ལ་ངེས་པར་ཕན་པ།",
    "ཕོ་འཁོར་གཡས་བསྐོར་དུ་བྲིས་ཏེ་སྟེང་འོག་ཏུ་ཁ་སྦྱར་ནས་རྟེན་གྱི་ནང་དུ་བཅུག་དུས།",
    "ཕོ་འཁོར་སྟེང་དུ་འཇོག་དུས་ཡབ་ཡུམ་མི་འགྲིག་ཅིང་འཆོལ་ནས་འགྲོ་བས་གཡོན་སྐོར་དུ་བཀོད་པ་ཡིན་གྱི།",
    "རྗེ་བཙུན་གྱི་ཐུགས་སྲས་ཎ་རོ་བནྡྷེ་གཤིན་རྗེ་གྲགས་ཀྱིས་ཞབས་རུབ་བཞེད་པར་འདུག་ཅིང་།",
    "སྟངས་སྟབས་འདུག་སྟབས་བཟླས་བརྗོད་དང་།",
    "འདུག་སྟངས་ཀྱི་དེ་ཉིད་ཀྱང་ཤེས་དགོས་ཏེ།",
    "ཕྱག་གསུམ་བཙལ་ནས་གྲལ་ལ་འདུག།",
    "ཞེས་སོགས་རྒྱས་པར་གསུངས་པ་དེ་ཉིད་འདྲེན་པར་མཛད་ནས་ཕྱག་ལེན་མཛད་པ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "གཞན་ཡང་རང་བཞིན་གྱི་གནས་ནས་སྤྱན་དྲངས་པ་དེ་བསྟིམ་དགོས་ཤིང་།",
    "ལག་ལེན་པ་ཕྱི་མ་རྣམས་ཀྱིས་དེ་ལྟར་དུ་མཛད་ཀྱིན་འདུག་པས།",
    "དོན་ལ་མ་དག་ཚུལ་ངོར་ཆེན་གསུངས་ཞེས་པ་བཀོད་འདུག་པ་ནི།",
    "རྒྱས་པའི་ལས་འགྲུབ་པའི་ཆེད་ཡིན་པས་གོས་ཁ་དོག་སེར་པོ་ཅན་གྱོན་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སྣམ་སྦྱར་སོགས་བཞག་ནས་གྲལ་ལ་འདུག་གོ།",
    "མཛད་པར་བསམ་ཞིང་རང་ཉིད་ཀྱིས་ཀྱང་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ནས་དཔོན་སློབ་ཐམས་ཅད་སྟན་ལ་ཙོག་པུར་འདུག་སྟེ།",
    "སྣམ་སྦྱར་སོགས་བཞག་ནས་གྲལ་ལ་འདུག་གོ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་ཤི་གསོན་ཐམས་ཅད་ཀྱི་དོན་དུ་བཞེངས་པ་ཞིག་འདུག་པ་རྗེས་སུ་ཡིད་རང་སྟེ།",
    "ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "སྔོ་སེར་འདུག་ན་མཐོན་ཀ་ཞེས་སུ་འབོད།",
    "ཚ་ཚ་བཏབ་ནས་ཀུན་རིག་ལ་བརྟེན་པའི་རབ་གནས་ཉིན་གང་མ་མཛད་པའི་ཕྱག་སྲོལ་བཟང་པོ་ཞིག་འདུག་ནའང་།",
    "ལེགས་པར་བརྟགས་ན་ཆོ་ག་རྒྱས་འབྲིང་བསྡུས་གསུམ་གྱི་རྣམ་གཞག་གང་དང་ཡང་མི་མཐུན་པ་ཞིག་འདུག་པ་ནས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན།",
    "དེ་ལྟར་བགྱིས་ན་བསྟན་དང་རང་གཞན་ལ།",
    "ཁ་ཅིག་དུས་འཁོར་རྒྱུད་འགྲེལ་ལ་སྟོང་གསུམ་ཆད་དོ་ཞེས་པ་ཡང་མ་བརྟགས་པའོ།",
    "གདོང་ནས་མཇུག་དུས་མེའི་བར་གྱིས་གཡོན་དུ་བསྐོར་བའི་ཚུལ་གྱིས་ཁྱིམ་དང་རྒྱུ་སྐར་འཁོར་ལོ་ཕྱེད་ཁྱབ་ནས་གནས་ལ།",
    "ལྷོ་གླིང་ཤར་མའི་དབུས་དྲང་པོ་དང་དེའི་ནུབ་མཐའ་གཉིས་དགུན་ཉི་ལྡོག་དུས་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "སྟོང་ཕྲག་བདུན་ཅུ་རྩ་ལྔ་ལས་ཞེས་སོགས་དང་ཅིའི་ཕྱིར་ཁྱེད་རང་ལའང་མི་འགལ་བར་འགྱུར་བ་སོམས་ཤིག།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "ངེས་པར་འཇམ་པའི་མལ་ཆ་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་སྲུང་བ་བྱས་ནས་ནི།",
    "གཟུགས་ཞེས་པའི་སྐད་དོད་རཱུ་པ་ཞེས་པ་གཟུགས་དང་རང་བཞིན་གཉིས་ཀ་ལ་འཇུག་པས་སྐབས་འདིར་རང་བཞིན་ཞེས་སྒྱུར་དགོས་པ་ལ་གཟུགས་ཞེས་བསྒྱུར་བ་འགྱུར་སྐྱོན་ཡིན་ཞེས་དྭོགས་གཅོད་དང་བཅས་ནས་གསུངས་སོ།",
    "ལུས་ཀྱི་འདུག་སྟངས་བྱེད་བཅིངས་ཀྱི་ངེས་པ་དང་།",
    "མིག་གཉིས་གྱེན་ལ་བཟློག་པའི་ལུས་ཀྱི་འདུག་སྟངས་ལྔ་ནི་བྱེད་པ་ལྔ་ཡིན་ལ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ཇི་ལྟར་འདུག་པ་ལུས་ཀྱི་འདུག་སྟངས་ཀྱི་ངེས་པ་དང་།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "སྔར་བརྗོད་པའི་སྤྲིན་མེད་པའི་ནམ་མཁའ་ལས་བྱུང་བའི་སྣང་བ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བའི་སེམས་ལས་བྱུང་བས་ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བའོ།",
    "ཉིན་རྟགས་ཀྱི་འབར་བ་སོགས་ཀྱི་སྣང་བ་གང་ཡིན་པ་དེ་ནི་སྤྲིན་མེད་པའི་ནམ་མཁའ་ལྟར་སྣང་བའི་རྣམ་པ་ཅན་གྱི་སེམས་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་བ་ལས་བྱུང་བས་ན་ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ་དེ་ཡང་ཇི་ལྟ་བུ་སྙམ་ན།",
    "སྒོམ་ཚུལ་དངོས་ནི་གཞན་ལུགས་མི་འཐད་པར་བསྟན་པ་དང་རང་ལུགས་གཉིས་ལས།",
