    "སྲེད་པ་མ་སྤངས་པར་ལས་དང་ལུས་དག་སྤོང་ནུས་པ་མ་ཡིན་ཏེ།",
    "སྲེད་པ་མ་སྤངས་པར་དེ་དག་ཟད་པར་སྤོང་བའི་ནུས་པ་མེད་པའི་ཕྱིར།",
    "དཀའ་ཐུབ་ཀྱིས་ལས་ཀྱི་ནུས་པ་འདྲེས་ཤིང་ཟད་པར་བྱེད་པ་དགག་པ།",
    "དེ་ལྟ་ན་ལས་སྲེད་གཉིས་ཀ་སོ་སོར་ཟད་པའི་དོན་དུ་འབད་པར་རིགས་ཏེ།",
    "སྲེད་པ་མ་སྤངས་པར་སྤོང་མི་ནུས།",
    "ལུས་འདིའི་སྔོན་གྱི་ལས་ཡུལ་གང་དུ་བྱས་པ་དང་།",
    "ཚུལ་ཇི་ལྟར་བྱས་པ་སོགས་ནི་ཤིན་ཏུ་ལྐོག་གྱུར་རོ།",
    "དཀའ་ཐུབ་དེ་ལ་ལས་ཐམས་ཅད་ནུས་པ་གཅིག་ཏུ་འདྲེས་པར་བྱེད་པའི་མཐུ་ཡོད་པའི་ཕྱིར།",
    "ཡང་སྲེད་པ་བཅོམ་ན་ལས་མཐའ་དག་ཀྱང་བཅོམ་པར་འགྱུར་བས་ལས་ཀྱི་གཉེན་པོ་མེད་པ་འགལ་ལོ་ཞེ་ན།",
    "སྲེད་པ་མ་སྤངས་པར་ལས་མཐའ་དག་ཟད་པར་བྱེད་ནུས་པའི་གཉེན་པོ་ནི་སུ་ཡང་མེད་དོ།",
    "ཡང་ན་གཞུང་སྔ་མས་༢ ༣སྲེད་པ་ཟད་པར་སྤངས་ན།",
    "ཟད་ཀྱང་མེད་པར་བྱེད་ནུས་པར་བསྟན་ནས།",
    "ཤིང་རྟ་ཆེན་པོ་དུ་མས་སྟོབས་བཞི་ཚང་བའི་བཤགས་པས་མྱོང་ངེས་ཀྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་འབྱིན་པ་ཡང་འདག་པར་གསུངས་པའི་ཕྱིར་རོ།",
    "གཉེན་པོ་དང་མ་ཕྲད་ན་མྱོང་ངེས་པའི་དོན་དུ་གསུངས་སོ།",
    "སྲེད་པའི་སྐྱོན་རྣམས་དང་ལྡན་པ་རྣམས་ལས་གསོག་པར་བྱེད་པར་འགྱུར་གྱི།",
    "པ་དེར་ནི་སྲིད་པ་ལས་གྲོལ་བའི་ལམ་གྱི་གཙོ་བོ་མ་བསྟན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ཁོ་ན་ཉིད་མཁྱེན་པ་ཡིན་ཏེ།",
    "མཁྱེན་པ་བརྟན་པ་ཡིན་ཏེ།",
    "མ་ལུས་པའི་ཁྱད་པར་མཁྱེན་པར་གྲུབ་སྟེ།",
    "སྐྱོབ་པ་ལས་མཁྱེན་པ་རྣམ་དག་དཔག་འདོད་ནས་དེ་ལྟར་གསུངས་པའི་ཕྱིར།",
    "སྐབས་འདིར་སྐྱོབ་པའི་རྟགས་ལས་མཁྱེན་པ་རྣམ་དག་དཔོག་པ་ཡིན་པས།",
    "རིམ་པ་བཞིན་དུ་དེ་ཁོ་ན་ཉིད་མཁྱེན་པ་སོགས་དེའི་ཕྱིར།",
    "དེ་ལྟར་སྦྱོར་བའི་རྒྱུ་དུས་ཀྱི་ལམ་དེ་སྐབས་འདིར་སྟོན་པར་བསྟན་པའི་ཕྱིར།",
    "གཞན་གྱི་དོན་དུ་མིན་ན་མཁྱེན་པ་ཁྱད་པར་ཅན་འགྲུབ་པ་མི་སྲིད་དོ།",
    "མ་ལུས་པ་མཁྱེན་པའི་ཆེད་དུ་སྦྱོར་བ་བརྩོན་འགྲུས་ཀྱིས་ལམ་གོམས་པར་མཛད་པ་དེ་ལས་ཏེ་དེའི་ཕྱིར།",
    "ཞེས་སོགས་རྣམ་པ་དུ་མར་རྗེས་དཔག་འདི་ཡི་རྟེན་སྦྱོར་བའང་གསུངས་པ་མཐོང་བའི་ཕྱིར།",
    "དེའི་དོན་ལ་ཡང་དང་ཡང་དུ་འདོར་༢༦བ་ལེན་ཕྱིན་ཅི་མ་ལོག་པར་བྱའོ།",
    "སྟོན་པའི་བསྟན་པ་ཆེས་རིགས་པས་ལེགས་པར་གྲུབ།",
    "གཞལ་བྱ་ལ་ལོག་པར་རྟོག་པ་འགོག་པ་ཡང་གྲངས་ངེས་རྟོགས་པའི་ཡན་ལག་ཏུ་ཡིན་ཏེ།",
    "མི་གསལ་བ་གཟུང་ཡུལ་དུ་བྱས་པའི་སྒོ་ནས་སྒྲོ་འདོཊ་གསར་དུ་གཅོད་པ་དང་།",
    "གསལ་བ་གཟུང་ཡུལ་དུ་བྱས་པའི་སྒོ་ནས་སྒྲོ་འདོགས་གསར་དུ་གཅོད་པ་གཉིས་རང་རིག་མངོན་སུམ་གྱིས་རྟོགས་ཀྱི་དེ་ལས་གཞན་ཡོད་ན་རང་རིག་མངོན་སུམ་གྱིས་དམིགས་དགོས་པ་ལ་མ་དམིགས་པའི་ཕྱིར།",
    "འོག་ནས་འཆད་པའི་རྟགས་དུ་མ་བཀོད་པ་དོན་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དོན་བྱེད་ནུས་པ་གཟུང་ཡུལ་དུ་བྱས་ནས་སྒྲོ་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "དོན་བྱེད་མི་ནུས་པ་གཟུང་ཡུལ་དུ་བྱས་༢ ༧བ་ནས་སྒྲོ་འདོགས་གསར་དུ་གཅོད་པ་ཞེས་རང་རིག་མངོན་སུམ་གྱིས་ཤུགས་ལ་རྟོགས་པའི་རྟགས་ཀྱི་རྣམ་གྲངས་སྟོན་པ་ཙམ་ཡིན་གྱི།",
    "དེ་ཙམ་ལ་བལྟོས་པ་མིན་པར་རང་ཉིད་ངོ་བོའི་སྒོ་ནས་གྲུབ་པ་མེད་ན་རང་འཛིན་གྱི་བློ་མེད་༢༨ན་པའི་ཡུལ་གཉིས་སུ་ངེས་པའི་ཕྱིར།",
    "ད་ནི་འདི་དཔྱད་པར་བྱ་སྟེ།",
    "སྒྲ་དེ་གྲག་པར་ངས་མ་ཐོས་སོ་ཞེ་ན།",
    "ཕ་རོལ་པོས་ངག་སྨྲས་པའི་སྒྲ་གྲག་པའི་རྣམ་པར་ཐོས་སམ་མ་ཐོས་ཞེས་དྲིས་མ་ཐག།",
    "དེ་ལྟ་ན་དངོས་པོ་གང་ཡང་རྟག་པ་མཐའ་གཟུང་མ་གཏོགས་ཅུང་ཟད་ཀྱང་ཁས་ལེན་མི་ནུས་པར་འགྱུར་ཞིང་།",
    "སྒྲ་འཛིན་མངོན་སུམ་དུ་ངེས་པ་གཞིར་བྱས་ལ།",
    "མི་རྟག་པར་ཡོངས་སུ་གཅོད་མི་ནུས་ན།",
    "རྟག་མི་རྟག་ལ་གཉིས་མ་ཡིན་གྱི་ཕུང་གསུམ་ཁས་ལེན་དགོས་པར་འགྱུར་བ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་དུ་བའི་རྟགས་ལས་དུ་ལྡན་ལ་ལ་མེ་ཡོད་པར་གསར་དུ་རྟོགས་པའི་བློར་ངེས་པ་གཞིར་བཟུང་ནས།",
    "བསྟན་བཅོས་འདིར་དོན་དམ་པར་ཡོད་པ་ཡིན་ཏེ།",
    "སྤྱིར་ངོ་བོ་ཉིད་མེད་པར་སྨྲ་བ་དང་།",
    "འབྲས་བུ་བསྐྱེད་པའི་བྱ་བ་བྱེད་པ་འདི་ཉིད་དོན་དམ་པར་གྲུབ་མ་གྲུབ་འབའ་ཞིག་ལ་རྩོད་ལ།",
    "དོན་དམ་པར་ཡོད་པའི་དོན་ལེགས་པར་གྲུབ་པས།",
    "དེ་ལ་ཀུན་རྫོབ་ཏུ་ཡོད་པ་ཞེས་པའི་མིང་བཏགས་མིང་སྟོན་བྱས་ཀྱང་།",
    "ཀུན་རྫོབ་ཏུ་ཡོད་པར་མི་འགྱུར་རོ་ཞེས་འདོད་དོ།",
    "ངོ་བོ་ཉིད་མེད་པར་སྨྲ་བ་ལ།",
    "དོན་དམ་པར་མེད་པར་བཞེད་ལ།",
    "ལུགས་དང་པོའི་གཞུང་ལེགས་པར་བཙུགས་ནས་སྒྲུབ་པའི་ཆེད་དུ།",
    "དོན་ལྡོག་མི་མཐུན་པར་རྩོད་པའི་ཚུལ་གསལ་བར་མི་སྣང་བའི་ཕྱིར་རོ།",
    "ཞེས་དོན་དམ་གྱི་ཁྱད་པར་སྨོས་པའི་དགོས་པ་ནི།",
    "དོན་བྱེད་ནུས་པ་ལ་དོན་དམ་པར་དོན་བྱེད་ནུས་པ་དང་མི་ནུས་པ་གཉིས་སུ་འབྱེད་པ་ནི།",
    "མི་མཐུན་པའི་ཚུལ་ལ་སོགས་པའི་རྣམ་གཞག་ལེགས་པར་མ་གོ་བའི་བབ་ཅོལ་འབའ་ཞིག་ཡིན་ནོ།",
    "དོན་བྱེད་ནུས་པ་དོན་དམ་པར་ཡོད་པའི་མཚན་གཞི་དང་།",
    "རྣལ་འབྱོར་སྤྱོད་པ་པ་དག་དོན་བྱེད་ནུས་པ་གང་ཡིན་པ་བདེན་པ་གཉིས་སུ་བྱས་པའི་དོན་དམ་བདེན་པར་མི་བཞེད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཐམས་ཅད་ལ་དོན་དམ་པར་དོན་བྱེད་པའི་ནུས་པ་མེད་པའི་སྐུ་རོ།",
    "དོན་དམ་པར་ཡོད་པའི་མིང་མི་འདོགས་ཀྱང་དོན་གྲུབ་བོ།",
    "དོན་དམ་པར་གཅིག་དང་དུ་མ་གང་དུ་གྲུབ་དཔྱད་པ་ན།",
    "དོན་བྱེད་ནུས་པ་དེ་ཀུན་རྫོབ་ཏུ་གྲུབ་པར་འདོད་ཀྱི།",
    "དོན་དམ་པར་གྲུབ་པར་མི་འདོད་དོ་ཞེ་ན།",
    "འབྲས་བུ་བསྐྱེད་པ་ཀུན་རྫོབ་ཏུ་ཡང་མི་འགྲུབ་པར་ཐག་ཁྲ་ལ་སྦྲུལ་དུ་རློམ་པ་ལྟར་འགྱུར་ལ།",
    "དོན་དམ་པར་སྐྱེ་བའི་དོན་ལེགས་པར་གྲུབ་པའི་ཕྱིར།",
    "སྤྱི་མཚན་ཀུན་ལ་དོན་བྱེད་ནུས་པ་དེ་ཡོད་པར་འགྱུར་ན།",
    "དེས་གཞན་ཡང་གོ་དགོས་པར་བསྟན་པ་ན།",
    "སྤྱི་མཚན་གྱིས་རང་འཛིན་ཤེས་པ་བསྐྱེད་མི་ནུས་པར་བསྟན་པ་དེ་ལས་ནི་དོན་གཞན་ཡང་རྟོགས་པར་བྱ་སྟེ།",
    "སྐྲ་ཤད་བདེན་པར་མེད་པ་དེ་ལྟ་བུའི་དངོས་པོ་སྟེ་བདག་ཉིད་ཤེས་བྱ་ཡིན་པ་ལ་བཀག་པ་མེད་དེ།",
    "དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་བཀག་པའི་སྒོ་ནས་དགག་པ།",
    "དངོས་པོ་དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་ཡིན་པ་དགག་པ།",
    "སྒྲའི་བརྗོད་བྱ་དོན་དམ་པར་དེ་ཉིད་དང་གཞན་དུ་བརྗོད་དུ་མེད་པ།",
    "གསལ་བ་རང་མཚན་དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་མིན་པ།",
    "དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་མེད་དེ།",
    "ཅེས་པ་སྟེ་གཟུགས་སོཊ་དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་ཡིན་ན་སྒྲ་བརྗོད་ཙམ་གྱིས་ཕྱི་རོལ་གསལ་བར་སྣང་བར་འགྱུར་ལ།",
    "དེས་ན་སྤྱི་མཚན་དངོས་པོ་ཡིན་ན་སྒྲའི་བརྗོད་བྱ་དོན་དམ་པར་གྲུབ་པར་འགྱུར་ལ།",
    "དོན་དམ་པར་སྒྲའི་བརྗོད་བྱ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེ་དངོས་པོ་ཡིན་ན་བུམ་པར་འགྱུར་དགོས་པས་སོ།",
    "རྨི་ལམ་ལ་སོགས་པའི་ཤེས་པ་རྣམ་པ་གཞན་དུ་གཟུང་དོན་དང་མི་ལྡན་པར་མཐོང་བའི་ཕྱིར།",
    "ལྡན་པ་མ་ཡིན་པའི་འདུ་བྱེད་གཟུང་དོན་དུ་བྱས་པ་ལས་ཀྱང་སྐྱེ་བ་མིན་ཏེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་སྣང་བའི་ཕྱིར།",
    "རུང་ཡུལ་དེར་གནས་པའི་སྐྱེས་བུ་གཞན་གྱིས་མི་ཤེས་པར་རང་ཉིད་ཁོ་ནས་ཤེས་པ་དེ་ཤེས་པ་དེའི་བདག་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "གསལ་བའི་མཚུངས་པ་མིན་པར།",
    "གལ་ཏེ་ཡང་གསལ་བས་གསལ་བར་བྱས་པ་ལས།",
    "སྤྱི་འཛིན་པ་ཡི་རྣམ་པར་ཤེས་པ་ལ་སྣང་བ་དེ་དང་རྗེས་སུ་འབྲེལ་བའི་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པའི་ཆ་བསྙོན་མི་ནུས་པར་རྣམ་པར་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "པའི་འོག་ཏུ་མེ་ལ་རག་ལས་པ་ལྟ་བུའི་འབྲེལ་བ་འཛིན་པར་བྱེད་ལ།",
    "རང་བཞིན་མེད་པར་གྲུབ་སྟེ།",
    "འདི་ཡན་ཆད་སྒྲའི་བརྗོད་བྱ་དོན་དམ་པར་བརྗོད་དུ་མེད་པར་བསྟན་བཞེད་པ་ཡིན་ལ།",
    "སྣམ་བུ་ལ་སོགས་པའི་བརྗོད་བྱ་འགའ་ཞིག་ལས་གཞན་དུ་བརྗོད་པར་བྱ་བའི་དངོས་པོར་འདོད་དོ་ཞེ་ན།",
    "མིང་གང་ལས་བློ་འཁྲུལ་པ་མེད་པར་འཇུག་པའི་མིང་དེ་དོན་དེའི་དངོས་མིང་དང་།",
    "སོགས་པའི་མཉན་པ་སྐྱེ་བོས་བྱས་པ་ཡིན་པའི་ཕྱིར།",
    "རྣ་བ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་རང་མཚན་གཟུང་དོན་དུ་ཡོད་པ་ཅན་ལ་འདས་པ་ལ་རྟོག་པ་དང་སྣང་ཚུལ་མཚུངས་པ་དེ་དག་མེད་པའི་ཕྱིར།",
    "སྤྱི་ཡན་གར་བ་ཙམ་གཟུང་དོན་དུ་བྱས་ནས་འཛིན་པའི་ཕྱིར།",
    "བརྡ་ལ་བལྟོས་པ་མེད་ན་ཡང་རིགས་ཐ་དད་མེད་པར་འཛིན་པའི་བློ་འགའ་ཞིག་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "བ་ལང་མ་ཡིན་པ་ལས་ལོག་པར་མཚུངས་ཤིང་།",
    "ཐ་དད་དུ་མི་སྣང་བས་མེད་པར་གྲུབ་ན།",
    "མིག་ལ་སོགས་པ་ཡང་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དངོས་པོ་གཟུང་དོན་དུ་བྱས་ནས་ཤེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདས་མ་འོངས་སོགས་ལ་རྟོག་པའི་བློ་རྣམ་པ་གཞན་དུ་དངོས་མེད་གཟུང་ཡུལ་དུ་བྱེད་པར་མཐོང་བའི་ཕྱིར།",
    "དེ་འཛིན་པའི་མངོན་སུམ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱི་སྒོ་ནས་དངོས་པོའི་དོན་སྤྱི་དེ་གཟུང་ཡུལ་དུ་བྱས་ནས་ཤེས་ཤིང་འཛིན་པ་ཡིན་པའི་ཕྱིར།",
    "དོན་དུ་གཉེར་བྱའི་འབྲས་བུ་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་རྣམ་༢༢༡བ་པར་དཔྱོད་པའི་རྟོག་ལྡན་རྣམས་ཀྱི་དོན་བྱ་བ་ནི།",
    "གཞལ་བྱ་ཡིན་ན་རང་མཚན་ཡིན་པས་ཁྱབ་པ་གཞུང་འདིས་བསྟན་པར་འདོད་པ་ནི།",
    "བཞོ་བཀལ་ལ་སོགས་པའི་འབྲས་བུ་དོན་གཉེར་གྱིས་འབྲས་བུ་དེ་འདོད་པའི་ཕྱིར་ཏུ་དེ་ཡོད་མེད་དུ་དཔྱོད་པར་བྱེད་ལ།",
    "རྟགས་དེ་ལ་བརྟེན་པའི་རྗེས་དཔག་དང་སྒྲོ་འདོགས་གཉིས་འཛིན་སྟངས་མཚུངས་པར་འདོད་པའི་ཕྱིར།",
    "ཡང་རྗེས་དཔག་དེས་དགག་གཞི་འཇལ་བར་འདོད་པ་ཡང་རྟགས་གསུམ་གྱི་རྣམ་དབྱེ་སོ་སོར་མི་ངེས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དཔྱད་ནས་གཞི་འགར་དེ་མེད་པར་ངེས་ན་ལྡོག་པར་བྱེད་ལ།",
    "མཚོན་བྱའི་ཐབས་བསླབ་ཉེས་པ་དང་འདྲ་ཞེས་གསུངས་པ་དེ་ཉིད་སླར་འོངས་པ་ཡིན་ཏེ།",
    "གཞལ་བྱ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་དངོས་ཀྱི་མ་ངེས་པར་གསུངས་པ་དག་ཀྱང་མཐོང་ནས་སེལ་བའི་ངོར་དང་འཁྲུལ་པའི་ངོར་ཡིན་ནོ།",
    "རྣམ་པར་བཅད་རྒྱུ་སྒྲ་རྟག་པ་ལྟ་བུ་ལ་བརྗོད་དམ།",
    "རྣམ་བཅད་ཀྱི་གཞི་སྒྲ་ལ་རྟག་པ་རྣམ་པར་བཅད་པ་ལྟ་བུ་ལ་བརྗོད།",
    "ཡོད་པ་དང་གཞལ་བྱ་ལ་ཁྱད་པར་ཕྱེ་བས་དགོས་པ་ཅི་ཞིག་འགྲུབ་པར་འགྱུར།",
    "ཡོད་ན་མི་རྟག་པའི་སྤྱི་ཁྱབ་བསྒྲུབས་པས་དགོས་པ་ཅི་ཞིག་འགྲུབ་པར་འགྱུར།",
    "ལུགས་ཁ་ཅིག་གཞལ་བྱ་ཡིན་ན་རང་མཚན་ཡིན་པས་ཁྱབ་པར་འདོད་བཞིན་དུ།",
    "ཡང་རྟགས་དང་བསྒྲུབ་བྱ་སོགས་ཡིན་ན་དངོས་མེད་ཡིན་པས་༢༢༣ན་ཁྱབ་པར་འདོད་པ་དག་ཀྱང་སེམས་རྣལ་དུ་ཞོག་ལ་སྨྲོས་ཤིག།",
    "དེ་ལྟར་ན་འགའ་ཞིག་དེ་དངོས་པོ་ཉིད་ཡིན་ནོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "འོ་ན་འདུས་མ་བྱས་ཀྱི་ནམ་མཁའ་ཤེས་བྱ་ཡིན་མིན་དཔྱོད་པའི་རྟེན་དངོས་པོར་ཇི་ལྟར་རུང་ཞེ་ན།",
    "དེ་ལ་ཐོག་མར་འདུས་བྱས་ཀྱི་ནམ་མཁའ་ཡོད་མེད་ཐེ་ཚོམ་ཟ་བར་གསལ་བས་དེ་སྒྲུབ་དགོས་པ་ཡིན་ལ།",
    "འདུས་མ་བྱས་ཀྱི་ནམ་མཁའི་མཚན་གཞི་ལེགས་པར་གྲུབ་པ་ཡིན་པས།",
    "དེར་ཡང་དཔྱད་པར་བྱ་བའི་གཞི་དང་།",
    "གཉིས་ཀྱི་གྲངས་ངེས་སྒྲུབ་པར་འགྱུར་ལ།",
    "རང་མཚན་དངོས་སུ་སྣང་ཡང་འཁྲུལ་པ་ཡིན་པར་བཞེད་དེ།",
    "ཡང་ན་གཞལ་བྱ་གཉིས་སུ་འབྱེད་པ་མི་འཐད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྣང་ན་གཞན་དང་མ་འདྲེས་པར་སྣང་བས་མ་འཁྲུལ་བར་འགྱུར་ཞིང་།",
    "དཔྱད་པ་སྒོ་གསེབ་ན་ཡོད་པར་དཔྱད་ནས།",
    "རྗེས་དཔག་ཀུན་དེ་དང་མཚུངས་པར་སྟོན་པར་མཛད་དོ།",
    "དེ་སྣང་བའི་བློ་ལྟར་སྣང་དག་ཇི་ལྟར་ཞེན་པ་བཞིན་གྱི་དོན་མེད་པར་མཚུངས་ནའང་།",
    "ཆེ་ཆུང་སོགས་ཀྱི་དོན་ཐམས་ཅད་ཁྱད་པར་དུ་རྟོགས་པ་མི་འགྱུར་བར་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "དེའི་ཚེ་དུ་ལྡན་ལ་ལ་གོ་བྱེད་དུ་བའི་རྗེས་སུ་འགྲོ་བའི་མེ་ཙམ་སྤྱིའི་ངོ་བོ་ཉིད་དུ་རྟོགས་ནུས་ཀྱི་ཁྱད་པར་ཐམས་ཅད་རྟོགས་མི་ནུས་པ་དེས་ནའི་ཕྱིར།",
    "མྱོང་སྟོབས་ཀྱིས་སྒྲོ་འདོགས་གཅད་པར་བྱ་བ་དང་།",
    "སྤྱིར་རང་མཚན་མིན་པའི་གཞལ་བྱ་མེད་པར་འདོད་ན།",
    "དེས་སྤྱི་སོགས་གཞལ་བྱ་མིན་པར་སྒྲུབ་ནུས་པ་འགལ་ལོ།",
    "མེད་དགག་ཡན་གར་བ་དངོས་སུ་རྟོགས་པར་བྱེད།",
    "ཤུགས་ཡུལ་ཡང་མིན་པར་སྟོན་པ་མིན་ཏེ།",
    "དེ་ཡིན་ན་ཡང་ཅིག་ཤོས་ཡིན་པར་འགལ་བའི་ཕྱིར།",
    "ངག་སྨྲ་བའི་སྐྱེས་བུ་དེ་ཡི་སེམས་ཀྱི་ངོ་བོ་ངེས་པར་གྲུབ་སྟེ།",
    "གལ་ཏེ་དེ་དག་ཡོད་ན་དམིགས་སུ་རུང་བ་ལས་མ་དམིགས་པ་ཡིན་ན་དེ་དག་མེད་པ་ཉིད་དུ་རྟོགས་པར་འགྱུར་ལ།",
    "རྣམ་རྟོག་མེད་པར་སྤྱི་འཛིན་མིན་པ་དེའི་ཕྱིར།",
    "དེ་ནི་དེ་ལ་རྟོག་པར་འདོད།",
    "རྟགས་ལ་བལྟོས་པ་མེད་པར་ཡོད་པས་རྗེས་དཔག་མིན་པའི་ཕྱིར།",
    "དཔེར་ན་ཁྱད་པར་མཐོང་བའི་བློ་བཞིན།",
    "འཕྲོས་དོན་རྒྱས་པར་བཤདཔ།",
    "འཕྲོས་ཚུལ་ནི་འཆད་པར་འགྱུར་རོ།",
    "ཁ་དོག་ལ་མི་རྟག་པ་དེ་ཉིད་དེ་ལྟར་མི་རྟག་པ་རང་མཚན་པའི་རྣམ་པར་སྣང་བར་གྲུབ་པས་ཚོཊ་དོན་རང་མཚན་པ་སྒྲུབ་ཅིང་རྟོགས་པའི་ཕྱིར།",
    "རང་བཞིན་རྟགས་ཀྱི་རྟགས་ཅན་རྗེས་དཔག་ཉིད་རྟགས་འཛིན་ཡིན་ནོ་ཞེས་འདོད་པ་འཐད་པར་དཀའོ།",
    "རྟཊ་ཅན་རྗེས་དཔག་རྒྱུ་འབྲས་སུ་སྟོན་པར་སྣང་བས་འབྲེལ་བ་འཛིན་པའི་བློ་རྟགས་འཛིན་དུ་མ་བསྡུས་ན།",
    "ལ་མེ་རང་མཚན་དེའི་དངོས་པོ་ལ་བསླུ་བར་བྱེད་པ་ཉིད་མིན་ཡང་འཁྲུལ་པར་རྣམ་གཞག་བྱས་པ་ཡིན་ཏེ།",
    "འདོད་པ་སྔ་མའི་དུས་ཀྱི་ལྷ་སྦྱིན་དེ་ཕྱི་མའི་དུས་ན་འགཊ།",
    "གལ་ཏེ་སྔ་ཕྱི་ཕན་ཚུན་དུས་མི་མཚུངས་ཀྱང་ལྷ་སྦྱིན་གྱིས་ཡ་གྱལ་གཉིས་ཀ་ཁས་བླངས་པས་སྐྱོན་དང་བཅས་པའོ་ཞེ་ན།",
    "ཕྱིས་ཐོབ་པའི་སྔོན་པོ་སྔར་མེད་པར་ཁས་༢ ༣ ༢ ན་བླངས་ཀྱང་སྔོན་པོ་དེ་ལ་མངོན་སུམ་དུ་འབྲེལ་བ་ཡང་ཡིན་ལ།",
    "བྱས་པ་དེའི་ཁྱབ་བྱེད་ཀྱི་ངོ་བོ་ཡིན་པའི་ཕྱིར།",
    "མ་དམིགས་པའི་རྟགས་ཀུན་ལ་དགག་པ་འགྲུབ་པའི་དོན་གྱི་ཐབས་ལ་ཐ་དད་པའི་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "དེ་ནི་ཐབས་དང་བཅས་པ་བཀག་པ་མེད་པར་དགག་པ་འགྲུབ་པར་འདོད་པ་ཡིན་པའི་ཕྱིར།",
    "དཔེར་ན་ངག་སྨྲ་བ་ལ་སོགས་པས་ངག་སྨྲ་བའི་སྐྱེས་བུ་ཕ་རོལ་པོ་ཀུན་མཁྱེན་མིན་པར་བསྒྲུབ་པ་དང་འཇིག་རྟེན་གཞན་ལ་སོགས་པ་མེད་པར་བསྒྲུབ་པ་བཞིན་ནོ།",
    "ངག་སྨྲ་བ་ལ་ཀུན་མཁྱེན་མེད་དེ།",
    "དེ་འདྲ་མི་སྲིད་པར་སྒྲུབ་འདོད་པ་གང་ཞིག་སྔར་བཀོད་པའི་འགལ་དམིགས་རྟགས་སུ་མི་རུང་བའི་ཕྱིར།",
    "ཕྱིར་རྒོལ་གྱིས་མི་དམིགས་པ་ནི་དེ་ལྟ་བུའི་མེད་པ་ངེས་བྱེད་མིན་པར་རབ་ཏུ་བརྗོད་ཟིན་པའི་ཕྱིར།",
    "མེས་ནོན་པའི་གཞིར་ཁ་བ་རྒྱུན་ཆགས་སུ་གནས་པ་མེད་པར་བསྒྲུབ་པ་ལ་མེས་ཁྱབ་པར་ནོན་པ་རྟགས་སུ་བཀོད་པ་དང་།",
    "སླར་ཡང་སྐད་ཅིག་གཉིས་པར་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "རང་ཉིད་ལྡོག་ན་དེ་ལོག་པའི་སྟོབས་ཀྱིས་འབྲས་བུ་དང་ཁྱབ་བྱའི་དངོས་པོ་རྣམས་ལྡོག་པར་བྱེད་པ་ཡིན་ཏེ།",
    "བསྒྲུབ་བྱ་འགྲུབ་པ་མི་འཁྲུལ་བའི་འབྲེལ་བ་ལ་བལྟོས་པར་བསྟན་པའི་ཕྱིར།",
    "རྟག་མི་རྟག་ཅི་ཡང་རུང་བ་ལ་སྲིད་པར་འདོད་པས་སྦྱར་དུ་རུང་བའི་ཕྱིར།",
    "མི་འཁྲུལ་བའི་འབྲེལ་བ་ལ་བལྟོས་པར་འདོད་པ་དེ་ལའང་འབྲེལ་ཡུལ་གང་ཡང་རུང་བ་ལོག་པས་ལྡོག་པ་གོ་བར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཁ་དོག་མ་དམིགས་པའི་རྟགས་ལས་མི་རྟག་པར་རྟོགས་པའང་རྗེས་དཔག་ཏུ་བསྟན་པའོ།",
    "སྤྱིའི་རྟེན་ཁ་དོག་སྐད་ཅིག་ཐ་མ་དེ་གཟུང་དོན་དུ་བྱས་པའི་སྒོ་ནས་རིགས་འདྲ་ཐ་མ་དང་འབྲེལ་བ་མེད་པ་ཅན་དུ་གྲུབ་པའི་ཕྱིར།",
    "སྐབས་ལ་ལར་ཁ་དོག་མི་རྟག་པར་མི་ཤེས་པའི་རྒྱུ་ཡོད་དེ།",
    "དེས་ན་མྱུ་གུ་བསྐྱེད་པའི་ནུས་ལྡན་དུ་རྗེས་སུ་དཔག་པ་འཇུག་པར་བརྗོད་པ་ལ་རྒྱུ་ཡོད་པ་ཡིན་ཏེ།",
    "དེ་འདྲའི་བློ་གྲོས་ཆེན་པོས་དངོས་པོ་མཐོང་ཙམ་ཉིད་ལས་མི་རྟག་པ་སོགས་རྣམ་པ་ཐམས་ཅད་ངེས་པར་བྱེད་པའི་ཕྱིར།",
    "གཉིས་པ་ནི་མངོན་སུམ་གྱིས་དངོས་པོའི་རང་བཞིན་ཐམས་ཅད་མཐོང་ན་རྟོག་པས་ཀྱང་ཐམས་ཅད་ངེས་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་བརྡ་བརྟགས་པའི་སྒྲ་དུ་མ་འཇུག་པར་འགྱུར་ཏེ།",
    "རིགས་མཐུན་རིགས་མི་མཐུན་ཐམས་ཅད་ལས་ལྡོག་པར་རང་རྒྱུ་ལས་སྐྱེས་ཤིང་།",
    "བའི་དངོས་པོ་མེད་པར་གྱུར་པ་ལ་མི་རྟག་ཅེས་བརྗོད་པ་ཡིན་པའི་ཕྱིར།",
    "ཚུལ་དེ་ལྟར་ན་ཡང་ཁ་དོག་མི་རྟག་པར་རྟགས་ལས་རྟོགས་པའི་ཚུལ་གཉིས་པ་ཡིན་པས།",
    "གཞན་གྱིས་བཏགས་པའི་མི་རྟག་པ་རྒྱས་པར་དགག་པ་དང་།",
    "དེས་ན་མཐའ་གཉིས་སུ་ཆོད་པའི་དབུས་ན་ཡོད་པའམ་དབུས་ན་ཡོད་པ་དེ་ལ་འཕྲོད་འདུའི་འབྲེལ་བ་གྲུབ་པར་བརྗོད་པའི་ངང་ཚུལ་ཅན་གྱི་དོན་དེ་ཉིད་མི་རྟག་པ་ཉིད་ཀྱི་སྒྲའི་དོན་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་འཕྲོད་འདུ་འབྲེལ་བ་མི་རྟག་པར་འདོད་དོ།",
    "དེ་གཉིས་ཀྱི་ཁྱད་པར་དུ་བྱས་པའི་ཡོད་པ་དང་དེ་དང་འཕྲོད་འདུ་འབྲེལ་བ་མི་རྟག་པ་ཡིན་ནོ་ཞེ་ན།",
    "དངོས་པོ་སྔར་མེད་ལྡན་པར་ཁས་བླངས་པ་མིན་པའི་ཕྱིར།",
    "སྔར་མཐོང་བའི་མེ་དང་ཕྱིས་ཀྱི་མེ་དེ་མཚུངས་པར་འཛིན་པ་ཡིན་པའི་ཕྱིར།",
    "མཁས་པས་དྲན་པར་ཤེས་ཏེ།",
    "དེར་མངོན་སུམ་ཉིད་ཀྱིས་འགྲུབ་པར་འགྱུར་བའི་ཕྱིར།",
    "མངོན་སུམ་རྟོག་པར་གྲུབ་མཐས་བསླད་ཅིང་སྒྲོ་བཏགས་པ་ཡིན་པས།",
    "དུས་དེའི་ཚེ་རྟོག་པ་ཡོད་ན་སྔར་རྟོག་པ་ཇི་ལྟར་གྱུར་ཅེས་སླར་ཡང་རྗེས་ཐོབ་ཏུ་ཅུང་ཟད་རྣམ་པར་རྟོག་ན་སྔར་ཁོ་བོའི་རྣམ་༢༣༩བ་རྟོག་འདི་འདྲར་གྱུར་ཏོ་ཅེས་རིག་དགོས་པ་ལ་དེ་ལྟར་མ་རྟོགས་པའི་ཕྱིར།",
    "དེ་རྒྱས་པར་འཆད་པ་ནི།",
    "ཁྱད་པར་རང་མཚན་རྣམས་ལ་དོན་དམ་པར་རྗོད་བྱེད་ཀྱི་སྒྲ་དག་འཇུག་པ་སྲིད་པ་ཡོད་པ་མིན་ཏེ།",
    "དོན་དམ་པར་བརྡ་འཇུག་པ་མེད་པའི་ཕྱིར།",
    "ཁྱད་པར་རང་མཚན་ཕན་ཚུན་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཕྱིར།",
    "འདི་དག་ནི་དོན་དམ་པར་རང་མཚན་བརྡའི་ཡུལ་ཡིན་པ་འགོག་པར་བྱེད་པ་ཡིན་གྱི་སྤྱིར་རང་མཚན་བརྡའི་དངོས་ཡུལ་དང་རྟོག་པའི་དངོས་ཡུལ་ཡིན་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "འདི་དག་དོན་དམ་པར་བརྡ་སྦྱོར་བ་ཡིན་ན།",
    "བར་སྣང་དགོས་པར་སྟོན་པ་ཡིན་གྱི་རང་མཚན་བརྡའི་དངོས་ཡུལ་དུ་མི་རུང་བར་སྟོན་པ་མ་ཡིན་ཏེ།",
    "དེ་གཉིས་ཀ་ད་ལྟ་མཚུངས་པར་ཡུལ་ལ་འཇུག།",
    "དངོས་པོ་འཛིན་པའི་ཕྱོགས་སྟོབས་དང་ལྡན་པ་དེ་ནི་མཚུངས་པར་ཡོད་པ་ཡིན་པའི་ཕྱིར།",
    "དྲུག་ཀ་རྒྱུ་ནུས་པ་མཚུངས་པར་ཡོད།",
    "འཇུག་ཤེས་དྲུག་པོ་གཞན་ལྔ་ལྔས་བར་དུ་ཆོད་ན་ཡང་ཅིག་ཅར་དུ་ཡུལ་འཛིན་པར་འཁྲུལ་པའི་ཕྱིར།",
    "ཁ་ཅིག་ཡི་གེ་ཉན་ཤེས་ཀྱིས་མི་ཐོས་པར་འདོད་པ་དང་།",
    "ཡིད་རྟོག་དེ་གཉིས་ཀྱི་བར་ཆོད་མ་ཆོད་ཀྱི་སྣང་བ་ལ་ཡང་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་པའི་ཕྱིར།",
    "ཡིད་གཟུགས་མཛེས་ལ་ལྷག་པར་ཆགས་པས་གཞན་སྒྲ་འཛིན་བསྐྱེད་པའི་དེ་མ་ཐག་རྐྱེན་གྱི་ནུས་པ་ཉམས་ནས་དེ་མ་སྐྱེས་པ་ཡིན་པའི་ཕྱིར།",
    "མགལ་མེ་མྱུར་དུ་འཇུག་པའི་རྗེས་སུ་འགྲོ་བའི་མིག་ལ་གནོད་པ་བྱས་པ་ཅན་ལས་བསླད་པར་སྐྱེས་པའི་ཕྱིར།",
    "གལ་ཏེ་ད་ལྟ་བརྡ་ལ་མ་བྱང་བའི་ཡིད་དེ་ཉིད་དོན་ལ་དཔྱོད་བྱེད་དུ་ཡོད་པ་དེས་ན་དེ་ཕྱིས་བརྡ་འཛིན་པར་འདོད་དོ་ཞེ་ན།",
    "ཡིད་བློ་རྟོག་པ་དུས་ཕྱིས་བརྡ་འཛིན་པར་འགྱུར་བའི་ཕྱིར།",
    "དང་པོར་སོ་སོར་གཟུང་ནས་ཕྱིས་དེ་དག་བསྡོམ་པར་བྱས་ཏེ་འདི་བ་གླང་དཀར་པོའོ་སྙམ་པ་དེ་ལྟར་རྟོགས་དགོས་པའི་ཕྱིར།",
    "རྟོག་མེད་ལ་སྒྲ་རང་མཚན་དང་ཁ་དོག་དབྱིབས་སོགས་ཀྱི་རྣམ་པར་གསལ་བར་སྣང་བའི་ཕྱིར།",
    "སྣལ་མ་གཅིག་ལོཊ་སུ་བཀར་བར་བྱས་ལ་འབྲས་དུས་ཀྱི་སྣལ་མ་ལ་སྣལ་མ་ཞེས་པའི་སྒྲས་སྟོན་ལ་འཇུག་པར་འགྱུར་བའི་ཕྱིར།",
    "༢ ༤༥བ་ཆད་པ་མེད་པར་བགོ་བ་ལ་སོཊ་པའི་དོན་བྱེད་ནུས་པར་སྣང་བའི་དངོས་པོ་གཅིག་ལ་སྣམ་བུའི་མིང་འཇུག་པའི་ཕྱིར།",
    "རྟེན་དང་བརྟེན་པར་ཐ་སྙད་བྱེད་པ་རྟོག་པས་བཏཊ་པ་འབའ་ཞིག་ཏུ་ཤིན་ཏུ་གསལ་ཏེ།",
    "ཆེན་པོ་ལ་སོགས་པའི་སྒྲ་༢༤༦བ་ཉེ་བར་བཏགས་པ་ལས་འཇུག་པར་འདོད་དོ་ཞེ་ན།",
    "ཡང་དྲུག་པོ་ལས་དོན་གཞན་པའི་ཚིག་དོན་གང་ལ་བལྟོས་པར་མཐོང་བ་མི་འཐད་པའི་ཕྱིར།",
    "ཐ་སྙད་ཀྱི་དུས་སུ་དོན་གོ་བའི་ཆེད་དུ་བྱས་པའི་ཕྱིར།",
    "སྒྲ་པས་སྒྲའི་ཆ་ཤས་འགའ་ཞིག་ལ་སྐད་ཀྱི་བྱིངས་དང་རྐྱེན་ལ་སོགས་པར་མིང་བཏགས་པ་བཞིན་ནོ།",
    "ཤིང་གསལ་རྫས་ཐ་དད་པ་རང་འཛིན་ཤེས་པས་རིགས་ཐ་དད་མིན་པར་རྟོགས་པ་ལ་ཕན་པ་དེ་བཞིན་དུ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་རྣམས་ཕྱི་རོལ་དོན་བྱེད་ནུས་པ་རང་མ་ཡིན་རྣམ་པར་གཅོད་པ་ལ་དོན་དམ་པར་རིག་པ་མེད་དེ།",
    "ཞེས་པར་སྒྲུབ་ཟིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཤིང་འཛིན་རྟོག་པའི་སྣང་བ་ཕྱི་རོལ་གྱི་ཤིང་དུ་གྲུབ་པར་སྣང་བས་ཕྱི་རོལ་གྱི་ཤིང་ཡིན་ལ།",
    "ཤིང་ཞེས་པའི་སྒྲས་ཕྱི་རོལ་དོན་གྱི་ཆ་ཅི་བརྗོད་ཅེས་འདྲི་བ་དེ་ལ་ཤིང་མ་ཡིན་ལས་ལྡོག་པའི་གཞན་སེལ་བརྗོད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "ཡང་ནི་སྒྲ་དོན་བརྗོད་བྱ་ཡིན་པར་མ་ཟད་ཅེས་པའོ།",
    "དེ་ལ་ཤིང་མ་ཡིན་ལས་ལོག་པར་སྣང་བ་ཤིང་གསལ་རྣམས་ལ་རྗེས་སུ་འགྲོ་བ་འབད་མེད་དུ་གྲུབ་ཟིན་ལ།",
    "དེ་ལྟར་ཤིང་ཞེས་པའི་མཉན་པ་གཞན་སེལ་བརྗོད་པར་བྱེད་དེ།",
    "དོན་གྱི་སེལ་བ་བརྗོད་པར་སྒྲུབ་མ་ཐག་པ་ཡིན་པའི་ཕྱིར།",
    "སྔར་བརྡ་བྱས་པ་དྲན་པ་ཡི་རྒྱུ་ཅན་གྱི་ཕྱིས་ཐ་སྙད་ཀྱི་དུས་སུ་མཐོང་བའི་དོན་དང་།",
    "གང་ལ་རྗོད་བྱེད་ཀྱི་སྒྲ་ངེས་པར་འགོད་པའི་ཡུལ་དེ་ལ་དམིགས་ནས་རྟོག་པ་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར།",
    "འདོད་པ་ཡིས་འཇུག་པར་འགྱུར་བ་དེས་ནའི་ཕྱིར།",
    "དང་པོ་ནི་ཤེས་པ་ཐམས་ཅད་འདིའོ་སྙམ་པའི་རྟོག་པར་འདོད་ན།",
    "དེ་མཐོང་༢༥༡ན་བ་མེད་པའི་ཕྱིརརིགས་པ་དེས་ནི་གཟུགས་འཛིན་དེ་དང་དུས་མཚུངས་པའི་རྣམ་པར་ཤེས་པ་རྫས་གཞན་གྱིས་མྱོང་བ་མ་ཡིན་པར་བསྟན་པ་ཡིན་ཏེ།",
    "གཉིས་ཀ་ཡུལ་གྱི་དོན་སྤྱི་ཙམ་ལ་རྟོག་པར་མཚུངས་པའི་ཕྱིར།",
    "རང་དུས་ན་སྐད་ཅིག་དུ་མས་༢༥༡བར་དུ་ཆོད་པའི་འདས་པ་མངོན་སུམ་གྱིས་འཛིན་པར་འགྱུར་ལ།",
    "རང་རྒྱུད་ལ་བློ་ཡོད་པ་རྟགས་ལ་བལྟོས་དགོས་པར་འགྱུར་ན།",
    "ཡོད་ན་རང་རྒྱུད་ལ་བློ་མངོན་སུམ་གྱིས་གྲུབ་པར་ཁས་བླངས་པར་འགྱུར་རོ་ཞེས་པའོ།",
    "དེར་ཡིད་གཟུགས་ལས་གཞན་ལ་རྣམ་པར་གཡེང་བ་སྲིད་པའི་ཕྱིར།",
    "བརྡ་བཏཊ་པ་མེད་པར་ཁྱད་པར་རང་མཚན་གཟུང་དོན་དུ་བྱས་ནས་འཛིན་པའི་ཕྱིར།",
    "གསལ་བ་ལ་བལྟོས་མེད་ཀྱི་སྤྱི་ཡན་གར་བ་ཙམ་གཟུང་དོན་དུ་བྱས་ནས་འཛིན་པ་ཡིན་ན་ནི།",
    "དུའང་སྒྲུབ་ཟིན་ཅིང་འོག་ཏུ་ཡང་འཆད་པར་འགྱུར་རོ།",
    "ཁྱབ་པར་བྱེད་པའི་རང་བཞིན་ཡུལ་ཤེས་ཞེས་པའི་ཐ་སྙད་སྦྱར་བར་འོས་པ་དེ་ལོག་པའི་ཕྱིར།",
    "ཞེས་གསུངས་པས་རྡུལ་བསགས་པ་དག་ནི།",
    "རིམ་གྱིས་གཟུང་ཡང་འཛིན་པ་མྱུར་བས་ཅིག་ཅར་འཛིན་པར་སྒྲོ་འདོགས་པའི་ཕྱིར་རྟོག་པ་ཡིན་ནོ་ཞེ་ན།",
    "བློ་རྣམས་དག་ནི་ཐམས་ཅད་ཀྱང་ཡུལ་དུས་མྱུར་བར་འཛིན་པར་མཚུངས་པའི་ཕྱིར།",
    "རྟགས་འདི་དུ་མ་རྟགས་སུ་བཀོད་ནས་གཅིག་མ་ཡིན་པར་བསྒྲུབ་པ་མ་ཡིན་ཏེ།",
    "སྔོ་སེར་སོགས་སོ་སོར་རྣམ་པར་དབྱེ་བ་ནུས་པ་ནི།",
    "དུས་གཅིག་དང་དོན་གྱི་རྣམ་པ་དུ་མ་ཅན་དུ་མཚུངས་པར་རྟོགས་པའི་ཕྱིར།",
    "རང་འཛིན་བློ་མ་འཁྲུལ་བ་ལ་སྣ་ཚོགས་ཀྱི་རྣམ་པ་གཏད་པའི་སྒོ་ནས་སྣ་ཚོགས་པའི་ངོ་བོའི་རྣམ་པར་སྣང་བའི་ཕྱིར།",
    "དེ་ལྟ་མིན་པར་ཆ་ཐུག་པ་མེད་པར་ཁས་ལེན་ན།",
    "བདེན་པའི་གཅིག་དང་དུ་མ་ལས་མ་གཏོགས་པའི་བདེན་པར་གནས་པའི་གོ་སྐབས་མེད་པའི་ཕྱིར་ཅེས་པའོ།",
    "དེ་བདེན་པར་ཡོད་ན།",
    "རགས་པར་སྣང་བ་དེའི་བདག་ཉིད་ཕྱི་རོལ་གྱི་དོན་༢༦ བ་ཆ་མེད་གཅིག་ལ་བཀག་པ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "རྡུལ་ཕྲན་མང་པོ་ལ་ཡང་སྣང་ཚུལ་དེ་སྣང་བ་ལྟར་བདེན་པར་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར།",
    "གཉིས་མེད་ཀྱི་ཤེས་པར་མ་ཟད་གཉིས་སྣང་དེ་ཡི་ཡང་དེ་ཁོ་ན་ཉིད་ཡིན་ཏེ།",
    "ཤེས་བྱ་ཙམ་གཞིར་བྱས་པ་ལ།",
    "བྱས་མི་རྟག་ཐ་དད་པའི་ཆ་ལ་སོཊ་པ་རྣམས་ནི་ཀུན་བརྟགས་ཡིན་ལ།",
    "ཤེས་སྒྲིབ་མཐའ་དག་ཟད་པར་འགྱུར་བའི་དམིགས་པ་མཐར་ཐུག་ཡིན་པས།",
    "རྣམ་པར་དག་པའི་དམིགས་པ་ཞེས་ཀྱང་བྱ།",
    "རྣམ་པར་དག་པའི་དམིགས་པར་འགྱུར་བས།",
    "དེ་ལ་དམིགས་ནས་བསྒོམས་པས་ཀྱང་ཤེས་སྒྲིབ་ཟད་པར་བྱེད་ནུས་པར་འགྱུར་རོ།",
    "ཕྱི་མ་ལྟར་ན་ཡོངས་གྲུབ་ཏུ་བྱས་པ་དང་འགལ་ལོ་ཞེ་ན།",
    "ཤེས་པའི་ཡུལ་ཙམ་འདུས་མ་བྱས་ཡིན་ཞིང་།",
    "ཐམས་ཅད་མཁྱེན་པ་ཐོབ་པ་ལ་སྒྲིབ་པའི་གཙོ་བོ་ཡང་འདི་ཡིན་པས་འདི་ཉིད་བག་ཆཊ་དང་བཅས་པ་མ་ལུས་པར་མ་སྤངས་བར་དུ་ཐམས་ཅད་མཁྱེན་པ་ཐོབ་མི་ནུས་པ་ཡིན་ནོ།",
    "མངོན་སུམ་མིན་པར་འགྱུར་ཏེ།",
    "དོན་དམ་པའི་བདེན་པ་མ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "མེད་པར་དགག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་བུམ་མེད་ཀྱང་དོན་དམ་པར་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འགྱུར་མེད་ཡོངས་གྲུབ་ནི་རིགས་པས་ལེགས་པར་བརྟགས་པ་ན་རང་བཞིན་སེམས་པའི་བློ་མཐར་ཐུག་པ་དེས་རྙེད་པའི་ཕྱིར་རོ།",
    "ས་ཕྱོགས་ལ་སོགས་པ་ཡང་དོན་དམ་པར་ཡོད་པས་དོན་དམ་བདེན་པར་འགྱུར་རོ་ཞེ་ན།",
    "བདེན་པ་གཉིས་སུ་བྱས་པའི་ཀུན་རྫོབ་ཀྱི་བདེན་པར་བཞེད་པར་གསལ་ལོ།",
    "དོན་དམ་པར་ཡོད་མེད་རྩོད་པའི་དོན་དམ་དང་།",
    "གཟུང་འཛིན་རྫས་ཐ་དད་རྣམ་པར་བཅད་ཙམ་གྱི་མེད་པར་དགག་པ་དེ་ཉིད་ལ་རྩེ་གཅིག་ཏུ་མཉམ་པར་བཞག་པར་བྱའོ།་",
    "ཡང་དག་པར་མེད་དོ་སྙམ་དུ་ཡང་དང་ཡང་དུ་འདྲིས་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་གཉིས་སུ་སྣང་བ་ཅན་དོན་དམ་པར་ཡོད་དོ་ཞེ་ན།",
    "གཟུགས་སུ་རུང་བས་གཟུགས་མཚོན་པར་བྱེད་པའི་ཚེ།",
    "མཚོན་པར་བྱ་བ་གཟུགས་དེ་གཟུང་བྱ་ལོགས་སུ་ཆད་པ་ལྟར་སྣང་བ་དང་།",
    "འདིས་མཚོན་པར་བྱེད་པའི་མཚན་ཉིད་གཟུགས་སུ་རུང་བ་དེ་འཛིན་བྱེད་བློའི་ཕྱོགས་སུ་ཆད་པ་ལྟར་སྣང་བའི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་སྣང་བ་ལས་མཚན་ཉིད་ཀྱིས་མཚོན་བྱ་མཚོན་པའི་ཚུལ་གཞན་ཡོད་པ་མ་ཡིན་ལ།",
    "མཚན་ཉིད་ལས་སུ་བྱ་བ་དེ་འཇོག་པར་བྱེད་པའི་འཛིན་པའི་ཕྱོགས་སུ་ཚུར་ཆད་པ་ལྟར་སྣང་བ་ལས་མ་གཏོཊ་པའི་མཚན་ཉིད་ཀྱིས་མཚོན་བྱ་བློ་ཡུལ་དུ་མཚོན་མི་ཤེས་ལ།",
    "ཤེས་པ་དེ་དོན་དམ་པར་ཡོད་པར་ལན་དུ་མར་སྒྲུབས་པའི་ཕྱིར་རོ།",
    "མཚོན་པར་བྱེད་པའི་མཚན་ཉིད་དེ་དག་ཀྱང་མཚན་ཉིད་བདེན་པར་གྲུབ་པ་དང་བྲལ་བ་ཡིན་ཏེ།",
    "མཚན་ཉིད་དེ་ཐམས་ཅད་བྱ་བ་དང་བྱེད་པ་ཡི་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར།",
    "འདིར་བྱ་བྱེད་དོན་དམ་པར་མ་གྲུབ་པའི་དོན་ནི།",
    "དེའི་རྗེས་སུ་ལས་སུ་བྱ་བ་མཚོན་བྱ་ངོ་བོ་སྔར་མེད་གསར་པ་ལྟ་བུར་གྲུབ་པར་སྣང་ལ།",
    "ལས་ལ་བྱ་བ་བྱེད་པའི་ཚུལ་དེ་དོན་དམ་པར་གྲུབ་ན་བསྐྱེད་བྱ་སྐྱེད་བྱེད་ཉིད་དུ་འགྱུར་བས་བྱ་བྱེད་བདེན་པ་བས་སྟོང་པ་ཞེས་བྱའོ།",
    "འདི་ནི་ཕྱི་རོལ་གྱི་དོན་ཁས་བླངས་ནས་ཀྱང་རྣམ་གཞག་དེ་ལྟར་བྱས་པ་ལ་འགལ་བ་མེད་དོ།",
    "ཐུབ་པས་བཀའ་དང་པོར་ཕྱི་རོལ་དོན་གྱི་རྣམ་གཞག་གསུངས་པ་མི་རིགས་པར་འགྱུར་ཏེ།",
    "རོལ་དོན་དུ་གྱུར་པའི་ཕུང་པོ་མི་རྟག་པའོ་ཞེས་རྟོགས་པར་མི་བྱེད་ལ།",
    "རྣལ་འབྱོར་སྤྱོད་པ་པས་ཀྱང་ཕྱི་རོལ་དོན་གྱིས་དབེན་པའི་སྒྲ་འདི་མི་༢༦༦ན་རྟག་པའོ་སྙམ་དུ་རྟོགས་དགོས་པར་མི་བཞེད་པས།",
    "དེ་འདྲའི་རྣམ་དབྱེ་ཕྱི་རོལ་གྱི་དོན་ལ་འཇུག་པར་འགྱུར་བ་ཙམ་ཡིན་པའི་ཕྱིར།",
    "ལྐོག་ཤལ་ལ་སོགས་པའི་དོན་དུ་མ་མཐོང་བ་མེད་པར།",
    "ཡོན་ཏན་ཏེ་ཁྱད་པར་དང་།",
    "༢༦༧བ་གཙོ་བོ་ཁྱད་པར་གྱི་རྒྱལ་ཚབ་རྗེའི་གསུང་འབུམ།",
    "གཞི་དག་ཏུ་འགྱུར་བའི་དུ་མ་ཅིག་ཅར་རྟོགས་པར་འདོད་དོ་ཞེ་ན་ཡང་།",
    "གལ་ཏེ་སྔར་རྫས་བཟུང་ནསཕྱིས་ཡོན་ཏན་ལ་སོཊ་པའི་ཁྱད་པར་གཟུང་བའི་ཕྱིར་རིམ་གྱིས་དུ་མ་རྟོགས་པར་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།"
  ]
}