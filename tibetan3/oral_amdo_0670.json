    "རྩ་བ་གཉིས་པ་ངོས་འཛིན་བརྟག་པ་ལ་སྡོང་པོ་གསུམ་བལྟ་བ་ལྕེ་དང་ཚུ་གཉིས་ལ་བལྟ་བ་དང་རེག་པ་རྩ་ལ་ལ་སྡོང་པོ་གསུམ་གསུམ།",
    "དཔྱད་ལ་རེ་རེ་སྟེ་གསུམ་རེ་རྣམས་དྲིལ་བས་ཡལ་ག་བཞི་བཅུ་རྩ་བདུན་བཞི་བཅུ་རྩ་བདུན་གྱེས་པ་ཡིན།",
    "དེའང་བུད་མེད་ལ་བཅུ་གཉིས་ལོན་ནས་ལྔ་བཅུའི་བར་དུ།",
    "དངས་མ་ལས་བྱུང་ཟླ་རེར་བསགས་པའི་ཁྲག་བུ་སྣོད་ཀྱི་རྩ་ཆེན་གཉིས་ནས་ནག་ཅིང་དྲི་བྲལ་བ།",
    "གཉིས་དང་བཞི་དང་དྲུག་དང་བརྒྱད་པ་བུ་མོར་འགྱུར།",
    "ཟླ་མཚན་མང་བོ་བུ་མོར་སྐྱེ་བར་འགྱུར།",
    "ཁམས་ལས་དབུགས་དང་པགས་པ་རེག་བྱ་སྐྱེད།",
    "ཉལ་པོ་རྩོལ་དྲག་མཚན་མོ་གཉིད་མི་ལོག།",
    "དེ་ལས་ཕོ་མོ་མ་ནིང་རིམ་པར་འགྱུར།",
    "དེ་བས་གནོད་པའང་ཕན་པའང་བསྲེས་ནས་ཅུང་ཟད་རེབྱིནརྩྭ།",
    "དེའི་དུས་མ་དང་བུ་གཉིས་ཐང་རེ་ལུས་ཀྱི་བཅུད་འཕོ་རེས་བྱས་པས་ཕྱིའི་ལུས་ཡང་གཟི་མདངས་འཕོ།",
    "མ་ཡི་རྟགས་དེ་རྣམས་གོང་ལས་ལྡོག་པ་བུ་མོ་སྐྱེ་བའི་རྟགོས།",
    "བུད་མེད་སྔར་བུ་བཙའ་མྱོང་བའི་གྲོགས་གིས་བསྐོར་ནས་བཙའ་བར་བྱ།",
    "སྐྲ་ལོ་ཕོ་གྱོ་མོ་གྱོའི་རྫ་དང་འདྲ།",
    "མཆིན་མཆེར་གཉིས་ནི་བཙུན་མོ་ཚེ་ཆུང་འདྲ།",
    "ཀླད་པའི་ལྡང་ཚད་རང་གི་སྙིམ་པ་གང་།",
    "འཁོར་ལོ་དྲུག་གི་དབུས་ན་ནི།",
    "བར་ཐག་སོར་མོ་བཅུ་གཉིས་དང་།",
    "ཡང་སྣ་ཧཾ་གི་རང་བཞིན་གྱིས་དར་ཚའི་དྭངས་མས་བཀག་པའི་ཚུལ།",
    "དེ་ལས་གྱེས་པ་ལུས་ཀྱི་ཕྱི་ནང་བར་གསུམ་དུ་བརྒྱ་ཉི་ཤུ་རེ་དང་།",
    "སྲོག་གི་རྩ་བ་ཡིན་ཕྱིར་རྩ་ཞེས་བྱ།",
    "༡༦ ༡༧༡ ༨ ༡༩ ༡༡ ༡༡༡ ༡ ༡༢ ༡༡༣ ༡༡༤ ༡༡༥ ༡༡༦ ༡༡༧ ༡༡༨ ༣༩ ༡༢ ༡༢༡༡༢༢ ༡༢༣ ༡༢༤ ༡༣༥ ༡༢༦ ༡༢༧ ༡༢༨ ༡༢༩ ༡༣ ༡༣ ༡ ༡༣༢ ༡༣༣ ༡༣༤ ༡༣༥༡༣༦ ༡༣༧ ༡༣༨ ༣༣༩ ༡༤ ༡༤༡ ༡༤༢ ༡༤༢ ༡༤༤ ༡༤༥ ༡༤༦ ༡༤༧ ༡༤༨ ༡༤༩༡༥ ༡༥ ༡ ༡༥༢ ༡༥༣ ༡༥༤ ༡༥༥ ༡༥༦ ༡༥༧ ༡༥༨ ༡༥༩ ༡༦ ༡༦༡ ༡༦༢ ༡༦༣༡༦༤ ༡༦༥ ༡༦ ༡༦༧ ༡༦༨ ༡༦༩ ༡༧ ༡༧༡ ༡༧༢ ༡༧༣ ༡༧༤ ༡༧༥ ༡༧༦ ༡༧༧༡༧༨ ༡༧༩ ༡༨ ༡༨ ༡ ༡༨༢ ༡༨༣ ༡༨༤ ༡༨༥ ༡༨༦ ༡༨ ༧ ༡༨༨ ༡༨༩ ༡༩མགོ་ལ་རེ་གཉིས་སྐེ་ལ་སོ་གསུམ་དང་།",
    "བུད་མེད་ལ་མངལ་སྒོ་ནུ་མ་གཉིས་ཀྱིས་ལྷག།",
    "ཁྲག་གིས་བརླན་ཞིང་སྲོག་འཚོ་ཤ་ཡིས་གཡོགས།",
    "རྐང་གིས་བཅུད་འགྱུར་ཁུ་བས་མངལ་འཛིན་བྱེད།",
    "དངས་མ་དེ་ཉིད་ལུས་ཟུངས་བདུན་པོ་རང་རང་གི་མེ་དྲོད་ཀྱིས།",
    "རང་རང་གི་ལུས་ཀྱི་རྒྱུ་ཡི་གཙོ་བོ་ཁུ་ཁྲག་གི་ཉེས་པ་ཤས་ཆེ་ཆུང་དང་མངལ་གནས་པའི་ཚེ་མའི་ཟས་དང་སྤྱོད་ལམ་གྱིས།",
    "ཟས་སྐོམ་ཞིབ་མོར་སྨུག་ཅིང་འདུ་ར་འདུ་ར་པོ་འདྲུལ་བར་བྱེད་པ་ཡིན།",
    "དང་པོ་རྟེན་གྱིས་དབྱེ་ན་ཕོ་མོ་མ་ནིང་གསུམ།",
    "གླུ་དང་དགོད་དང་འཐབ་མོ་མདའ་ལ་དགའ།",
    "དབྱིབས་དགྱེ་བཀྲེས་སྐོམ་ཉོན་མོངས་ཐན་པ་བཟོད།",
    "གཟའ་སྐར་ངན་པ་དང་མཚན་མོ་ལམ་དུ་འཇུག་དགོས་པ་ངན།"
  ]
}