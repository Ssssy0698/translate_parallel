    "དོན་གོ་བར་གདའ་ན་བཟོད་པར་གསོལ།",
    "གྲོགས་ཧ་དུ་དཀར་པོ་ལ་སོགས་པ་རྣམས་དགྱེས་པར་གདའོ།",
    "མནལ་སད་ནས་གསུང་རྣམས་མ་བརྗེད་པར་འདུག་སྟེ།",
    "དོན་འཁྲུལ་པར་གདའ་ན་བཟོད་པར་གསོལ།",
    "རྒྱ་གར་ལ་མྱུར་དུ་འབྱོན་པའི་ཐུགས་འདུན་དྲག་པོ་དང་བཅས་ལྷོ་བྲག་ཏུ་ཕེབས་པ་ལས་ཡབ་ཡུམ་གཉིས་ནི་སྐུ་གཤེགས་འདུག་སློབ་དཔོན་དང་ཇོ་བོ་ཆེན་པོ་རྣམས་ཀྱིས་སྣ་ལེན་བཟང་པོ་བྱས།",
    "སྒང་རྒྱུད་ན་མི་མང་པོ་ལོང་ལོང་འདུག་པ་ལ་སུ་ཅི་བྱེད་པ་ཡིན་དྲིས་པས།",
    "མར་པ་མགོ་ལེགས་ཀྱིས་བསམ་པ་ལ་ང་དང་རུས་པའི་ཕ་ཚན་དུ་ཡང་འགྲོ་བ་འདུག་ཅིང་།",
    "རྙིང་པ་འགའ་ཞིག་ཀྱང་གསོལ་འདུག་པ་ལ།",
    "ན་བཟའ་སོ་མ་གཞན་ཡང་འགའ་འདུག་པ་ལ་མི་བཞེས་པ་འདི།",
    "ཕྱག་རྫས་ལ་སྲེད་པོ་རང་ཡོད་རིགས་སུ་འདུག་པས།",
    "ད་ཁྱེད་དགའ་བ་འདུག་པས་གྱོན་པ་ཡིན།",
    "ཡར་བལ་བོད་མཚམས་ན་ཐོན་ཙ་ན།",
    "ཡུལ་ལ་སྟོད་ཚོ་བཞིར་ཕྱིན་ཙ་ན།",
    "གོ་ལུགས་དགོངས་པ་འདི་ལྟར་གདའ།",
    "ཐབས་ལམ་ལ་བརྟེན་ནས་འཁྲིད་མཛད་པ་འདུག་གསུངས་པ་ལ།",
    "ང་རང་ཡིན་བྱས་པས།",
    "རྒྱ་ནག་ལ་བྱོན་པའི་ཐོག་མར་བོད་ལ་འབྱོན་དགོངས་པ་གདའ་བས་ལྷ་ས་བར་གྱི་ས་སྣ་དང་ཞབས་ཏོག་པ་མི་དུ་དགོས་པ་གཏོང་ཞུས་པས།",
    "རྗེ་མར་པའི་ཐུགས་ལ་པཎྜི་ཏ་བཟང་པོ་འདིས་ངའི་ངན་རྟོགས་ཅུང་ཟད་དེ་མངོན་མཁྱེན་གྱིས་དགོངས་འདུག་སྟེ།",
    "ཕ་ཇོ་ང་ན་སོ་རྒས་ནས་གདའ།",
    "ང་རང་མར་པ་ལོ་ཙཱ་ལ།",
    "ད་དཔལ་ནཱ་རོའི་དྲུང་དུ་མྱུར་བར་འགྲོ་དགོས་པར་འདུག་པས།",
    "སང་རང་འགྲོ་གསུངས་ནས་རྗེས་ཆོག་རྣམས་མཛད་དོ།",
    "དེ་མཁའ་འགྲོའི་ལུང་བསྟན་ཡིན་པར་འདུག་སྟེ།",
    "ཞུས་པ་ཚོར་བ་མི་འདུག་པས་དཔེ་རྣམས་ལྟ་གསུངས།",
    "ཅི་ལ་ཐུག་རུང་རྒྱ་གར་ལ་འགྲོ་གསུངས་མི་གསན་པར་འདུག་པས་གཞན་བྱ་ཐབས་ནི་མ་བྱུང་།",
    "ནཱ་རོ་པ་སྤྱོད་པ་ལ་གཤེགས་ནས་མི་མ་ཡིན་གྱི་ཚོགས་དཔོན་མཛད་པ་མ་གཏོགས་མི་དང་མི་མཇལ་བ་འདུག་ཟེར།",
    "ཁྱེད་ལ་ཐུགས་བརྩེ་བའི་གསུང་མང་པོ་རང་ཡང་ཡང་འབྱོན་གྱིན་འདུག་འབྱོན་ཁར་ཁོ་ཡོང་ངེས་ཡིན་པས་འདི་རྣམས་སྤྲོད་གསུངས།",
    "ནཱ་རོ་པའི་ཞབས་རྗེས་འདུག་པའི་ས་སྤྱི་བོར་བཞག་ནས་བཙལ་བས།",
    "ཉམས་ལ་བྱེ་སྟོང་ཞིག་ན་བཞུགས་འདུག་པ་ལ་གསོལ་བ་བཏབ།",
    "བལྟས་པས་རོ་ལ་སོགས་པ་ཅི་ཡང་མི་འདུག་ཐོར་མ་གཅིག་རྩིབ་ལོགས་ལ་གོས་འདུག་པ་ལྡགས་པས།",
    "ཐང་ཆད་པའི་ངང་བཞུགས་འདུག་པ་ལ་གསོལ་བ་བཏབ་གདམས་ངག་ཞུས་པས།",
