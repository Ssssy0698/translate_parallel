    "ཐ་སྙད་དུའང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པ་སོགས་བཞེད་པའི་ཕྱིར་རོ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "ཞེས་པ་ལྟ་བུས་ཀྱང་རང་རྒྱུད་མ་བསྟན་པར་རྣམ་པ་ཀུན་ཏུ་མཚུངས་སོ།",
    "ཞེས་པ་ལྟ་བུའི་དཔེ་དོན་དེ་རྣམས་ཀྱིས་ཀྱང་རང་རྒྱུད་མ་བསྟན་པར་འདོད་དགོས་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་མྱུ་གུ་བདག་ལས་སྐྱེ་མེད་དུ་སྒྲུབ་པའི་ཚེ་དངོས་སྨྲ་བ་ལ་མྱུ་གུའི་ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་དོན་ལྡོག་གཅིག་ཏུ་འཆར་ལ།",
    "འཇུག་པ་ལས་ཀྱང་རང་རྒྱུད་གསལ་བར་གསུངས་ཏེ།",
    "བྱེ་བྲག་སྨྲ་བའི་ལུགས་ལའང་རང་རིག་མེད་པའི་ཕྱིར།",
    "བྱེད་སྒྲས་ཀྱང་རང་གཞན་གཉིས་ཀ་སྟོན་པར་བྱེད་པ་བཞིན་དུ།",
    "ཤེས་པས་ཀྱང་རང་གཞན་གཉིས་ཀ་རིག་པར་བྱེད་པ་དེའི་ཕྱིར་རང་རིག་པ་ཞེས་བྱ་བ་ཡོད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་སེམས་ཙམ་པས་ཤེས་པ་ད་ལྟའི་སྐད་ཅིག་ཆ་མེད་ཀྱི་རང་རིག་གཅིག་ཉིད་ལ།",
    "རང་མྱོང་བའི་དྲན་པ་མི་འདོད་ཀྱང་གཞན་མྱོང་བའི་དྲན་པ་ཁྱེད་རང་འདོད་པ་དང་འགལ་ལོ།",
    "རྣམ་རིག་མིང་དུ་ལྟ་བྱ་སྟེ་། མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "རང་རྒྱུད་པའི་ལུགས་ཀྱི་སྒྲ་ཇི་བཞིན་པ་ལ་ནི་ངེས་པ་ཅི་ཡང་མི་འདུག་ཅིང་ཞེ་འདོད་གོ་དོན་དུ་བླངས་ནས་བཀག་ན།",
    "གཞན་དུ་ན་ཕུང་པོ་དང་བདག་ཀྱང་རང་ལུགས་ལ་དོན་གཅིག་པར་འདོད་དགོས་སོ།",
    "སྤྱོད་པའི་རྒྱུད་དུ་མདུན་གྱི་བྲིས་སྐུ་དང་རང་ཉིད་གཉིས་ཀ་ལྷར་བསྒོམས་ནས་གྲོགས་པོ་ལྟ་བུའི་དངོས་གྲུབ་ལེན་ལ།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་སྟེ།",
    "གང་དག་དུས་གསུམ་མགོན་པོ་རྣམས།",
    "སུ་ལ་འདུག་ཀྱང་དོར་བྱ་ཡིན་ཏེ།",
    "དཔལ་ལྡན་ས་སྐྱ་པ་ངེད་ལའང་རང་བཟོ་དེ་འདྲ་འདུག་ནའང་མཁས་པ་རྣམས་ཀྱིས་བཞད་གད་གྱིས་ཏེ།",
    "ཞེས་པའི་མཇུག་ན་ཡོད་ཟེར་ཡང་ཇི་ལྟ་བ་བཞིན་མི་འདུག་པས།",
    "ཀྱེ་མ་ཐམས་ཅད་མི་རྟག་པར་ཁྱད་མེད་དོ་ཞེས་སྨྲས་ནས་སྟན་ལས་བབས་ཏེ་འདུག་གོ།",
    "དེ་སྙེད་ཅིག་ལགས་ཏེ་འདི་ལས་ལྷག་པ་མེད་དོ་ཞེས་སྨྲས་ནས་ཁྲི་ལས་བབས་ཏེ་ས་ལ་འདུག་གོ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "གཞན་ཡང་གསང་སྔགས་རྙིང་མ་བའི་སྤྱོད་པ་བྱེ་བྲག་ཏུ་དགག་པ་ལ་ཚིགས་སུ་བཅད་པ་མཛད་འདུག་ནའང་འདིར་མ་བྲིས་སོ།",
    "ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་རིང་ལ་བི་རོ་ཙ་ནས་རྒྱ་གར་ནས་ཁུངས་བཙལ་ཏེ།",
    "འཁོར་ལོ་སྡོམ་པའི་གཞུང་གདམས་ངག་དུས་ཀྱི་འཁོར་ལོའི་སྦྱོར་དྲུག་དང་སོགས་པ་ཀྱེ་རྡོ་རྗེའི་སྦྱོར་དྲུག་དང་གསང་འདུས་པའི་དང་བཅས་པ་དང་།",
    "རང་རང་གཞུང་ལས་ཐེག་གསུམ་གྱི།",
    "རང་རང་ཆོ་གས་རིམ་བཞིན་དུ།",
    "བདེན་ཚད་དེ་ཡང་རང་རྒྱུད་པས།",
    "ཡེ་ཤེས་ཚོགས་བསག་དུས་སུ་ཡང་།",
    "རང་རང་གདུལ་བྱའི་བློ་ཉིད་ལ།",
    "ཚིག་དེ་ལ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "ཀུན་སློང་གཉིས་པོ་སྔ་ཕྱིའི་ཚིག་མ་དག་པ་འདུག་པས།",
    "རྟགས་ལ་དཔྱད་པ་ཅུང་ཞིག་འདུག་ཀྱང་བཏང་སྙོམས་སུ་བཞག་ནས།",
    "ཡོད་པ་དང་ཡོད་མཐའི་ཁྱད་སོགས་ཕྱོགས་སྔ་མས་ལེགས་པར་ཕྱེ་འདུག་པའི་ཕྱིར་རོ།",
    "རགས་པའི་རྣམ་གཞག་འདི་ལའང་འཁྲུལ་ནས་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་རྒྱུད་པ་མན་ཆད་ཀྱི།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་མི་སློབ་ལམ་ཡང་ཐོབ་པར་འགྱུར་ཏེ།",
    "སྤྲུལ་པ་དང་རང་རྒྱུད་པའི་ཕྱོགས་སྐྱོང་གཉིས་སུ་ཡོད་པ་ལས།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་སྐུར་སྟོན་པ་ལ།",
    "དཔལ་ལྡན་ཨ་ཏི་ཤས་འཕགས་པ་ཐོགས་མེད་ཀྱི་དགོངས་པ་ཡང་རང་སྟོང་དུ་གནས་སོ་ཞེས་ཐོགས་མེད་ངོ་བོ་ཉིད་མེད་པར་སྨྲ་བའི་ཕྱོགས་སུ་འཐེན་པར་མཛད་པ་ནི།",
    "གནམ་རྒྱན་ལ་འབྲི་ལུགས་རྣམ་དག་གཅིག་སྨྲ་རྒྱུ་འདུག་པའི་ཕྱིར་རོ།",
    "སྐྱོན་ཕྱི་མ་ནི་སྤྱིར་ལྷ་རང་རང་སོ་སོ་ལ་བཞུགས་ཚུལ་རྒྱབ་སྤྲོད་སོགས་ཉེས་པ་མེད་པ་དང་།",
    "ས་བཅད་ཀྱི་ཡི་གེ་ཅུང་ཟད་མ་དག་འདུག་པས།",
    "ཕྲིན་ལས་ལ་སོགས་པ་འདི་ལྟར་དུ་ཡོད་པར་འདུག་དགོངས་ཤིང་མཁྱེན་ནས།",
    "ཁོང་རང་ཞབས་རྟོག་པ་གཅིག་དང་བཅས་པ་རྒྱ་གར་གྱི་གནས་སུ་འགྲོ་བར་ཆས་ཏེ་ཡར་བྱོན།",
    "དཔོན་དེ་རྟ་ལ་ཆིབས་ནས་གདན་བཏིང་སྟེ་དེ་ལ་བཞུགས་འདུག་འཁོར་རྣམས་རོང་རོང་འདུག་དེར་སྐྱེས་མཆོག་མར་པས་འདི་ཇི་ལྟར་ཡིན་དྲིས་པས།",
    "ཁ་རག་པ་ཤིན་ཏུ་མཉེས་ནས་ཁྱེད་རང་ངའི་གཡོག་གྱིས།",
    "སྒྲ་སྒྱུར་གྱི་སྐད་མཁས་པོ་མཁྱེན་ཞིང་འདུག་ནས།",
    "ད་ཀུ་སུ་ལུའི་སྒོམ་ཆེན་པར་ཡོད་པར་འདུག་པས་མི་ཞུ།",
    "ཁོང་རང་དང་མི་རྫུ་དགུ་རུ་རྫུ་བ་གཅིག་ཡོད་དོ།",
    "ནཱ་རོ་པ་ཇི་ལྟར་གསུང་བ་བཞིན་དུ་གཟིམས་བཞུགས་འདུག་པ་དང་མཇལ།",
    "རྡོ་རྗེ་གདན་བཞི་འཆད་ཀྱིན་འདུག་པ་དང་མཇལ་བས།",
    "ང་ལ་མི་འབྲང་འདུག་གམ་ཞེས་གསུང་།",
    "ཅེས་གསུངས་ཞིང་འབར་བའི་རྣམ་པ་བྱེད་ཀྱིན་འདུག་དེའི་དུས་སུ་མར་པ་བློ་གྲོས་ཀྱིས།",
    "དོན་དམ་པར་སྐྱོན་པ་མིན་པར་གདའ་ལགས།",
    "མཉེས་མཉེས་མང་པོ་མཛད་ཀྱིན་གདའ་ཞུས་པས།",
