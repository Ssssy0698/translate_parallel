    "ལེན་དུ་བྱོན་པས་རྔོན་པས་རི་དྭགས་བཤོར་བའི་ཕྱིར་ནགས་ལ་མེ་བཅུག་ནས་འདུག་པས།",
    "པོ་ཏི་ཡང་ཚིག་ཡོད་སྙམ་ཙ་ན།",
    "མཐོང་ནས་གམ་དུ་གཏུགས་ཙ་ན།",
    "གླང་རྒན་དར་གྱིས་གཡོགས་གདའོ།",
    "བདེ་མཆོག་དུས་འཁོར་ལ་སོགས་པའི་རྒྱུད་འགྲེལ་མང་པོ་གསན་ཞིང་།",
    "དེ་ནས་གདུལ་བྱ་མ་གཏོགས་སྐུ་སྐྱེ་བ་མི་ལེན་གསུངས་པར་གདའ།",
    "འདི་ལ་ངེད་རང་དཔྱལ་པའི་མི་སྤྱད་རྣམས་ཀྱང་ཚང་འདུག་ཅིང་།",
    "དྲུང་གདན་ས་པའི་སྲས་ཡིན་ངེས་སུ་འདུག་པས།",
    "ནམ་མཁའ་སྤྲིན་མེད་དུ་དག་པ་ལ་འཇའ་འོད་ཀྱི་བཀོད་པ་འདོད་ཁམས་ཀྱི་ལྷའི་མཆོད་རྫས་ཀྱི་བཀོད་པ་བས་ཀྱང་ཁྱད་པར་འཕགས་པ་ལྟ་བུ་མེ་ཏོག་འདབ་མ་གསུམ་པ་དང་ལྔ་པ་དང་བརྒྱད་པ་ལ་སོགས་ནི་ཁ་དོག་ཕལ་ཆེར་དཀར་པོ་དང་སྣ་ཚོགས་དང་དམར་སེར་ལྗང་ཁུར་འདུག་པ་དབྱིབས་ཚད་ཕུབ་ཙམ་དང་ཁུ་འཕངས་ཙམ་གྱི་ནམ་མཁའ་གང་བ་ནི་མི་ཀུན་གྱི་མཐུན་སྣང་དུ་གྲུབ་པ་བྱུང་ངོ།",
    "ལུས་ཟུངས་དྭངས་མ་བདུན་རྒྱུད་ཀུན་ཀྱང་ལུས་ཟུངས་རང་རང་མེ་དྲོད་ཀྱིས།",
    "ཉི་མར་འདུག་པའི་ཚེ་མགོ་བོའི་རླངས་པའི་གྲིབ་མ་མེད་ན་འཆི།",
    "ཟས་འགྲངས་རྗེས་སུ་དལ་བར་འདུག་པ་དང་ཉིན་གཉིད་ལོག་རླན་སྟེང་ཉལ་དང་དགུན་སྨད་ཆུར་ཞུགས་པ་དང་གྲང་དུས་གོས་སྲབ་འཁྱགས།",
    "རྔུལ་ཟད་རྟགས་ལྤགས་འགས་བ་སྤུའི་བུ་ག་རྣམས་ཕྱེ་སྟེ་འགྲེང་བ་དང་རང་བཞིན་གྱིས་འབྱི་བ་སྟེ་ལྷུང་བར་འགྱུར།",
    "རྒྱུ་ནི་རང་རང་སྐྱེད་པའི་རྒྱུའི་རྐྱེན་ཚབ་ལ་སོགས་དུས་གདོན་ཟས་སྤྱོད་མི་འཕྲོད་པར་བསྟེན་པ་དེ་ཉིད་ཡིན་ཏེ།",
    "འགྲོ་འདུག་གཉིད་ལོག་ཐབས།",
    "དང་བོ་འགྲོ་འདུག་ཆུ་ལ་བྱིང་སྙམ་ཐེ་ཚོམ་དང་བཅས་པའི་གྲུ་འམ་མི་སྲུན་བཞོན་པ་རྟ་གླང་མ་དུལ་བ་དང་།",
    "སྨུག་ཆུང་མདན་ཡོན་ནི་ཟུར་བས་བ་ཡག་པ་ཟེར་ཡང་རང་ལུགས་མེ་སྡོང་ཚེར་སྔོན་འདྲ་རུང་མེ་ཏོག་དམར་སྨུག་ཚེར་ཆུང་ཆིག་སྐྱེས་དག་ཀྱང་དེ་བཞིན་ནོ།",
    "དང་བོ་སློང་བའི་རྒྱུ་རྐྱེན་དུགྱུར་པ་ཟས་ཇི་ལྟ་བུ་དང་སྤྱོད་ལམ་ཉལ་འདུག་འགྲོ་འཆག་རྣམས།",
    "ལྡན་པ་དང་འདུས་པ་དང་རང་རང་ཆ་མཉམ་དུ་འདུག་ན་གཉེན་པོའང་བསིལ་དྲོད་ཆ་མཉམ་དང་གང་ཤས་ཆེ་བ་ལ།",
    "ཁུང་དྲོ་འདུག་ཡིད་འོང་ཚིག་སྨྲ།",
    "༡༢༨༣ ཚིགས་ཁ་གཡོ་ཞིང་བརྐྱང་བསྐུམ་འགྲོ་འདུག་གྱོང་མཉེན་པོ་མེད་པ།",
    "འདིར་ཏ་ཙ་ནི་འུ་སུ།",
    "༡༦༧༡༥ལྕེ་མཆུ་རྙིལ་དཀར་འགྲོ་འདུག་བྱས་ཚེ་གསུས་པ་ལྡིག་ལུག་པའོ།",
    "༡༧༥༩འཇིག་ཟས་བྲ་བོ་སྔོ་ངད་སྐྱུར་དང་རྟ་ཞོན་ཉལ་བོ་འགྲོ་འདུག་དང་།",
    "རླན་སྟེང་དང་ཁ་ཡེང་མ་ཡིན་འདུ་འཛི་མེད་པར་དབེན་པར་འདུག་གོས་མ་འཁྱགས་མ་རྔུལ་དྲོ་ཞིང་ཡང་བ་བགོ་༡༨༦༧བསིལ་གནས་རྐྱང་ཚད་གནས་ནེའུ་གསིང་སྟེང་དང་ཆུ་ཡི་འགྲམ།",
    "༢༤༥༧དེ་ནས་ཞག་གསུམ་ཁྲག་དུས་ཁྲག་ལ་བབས་ཚ་བ་རྐྱང་བའི་རྟགས།",
    "༢༨༦༣དེ་འོག་ཤིང་ཀུན་ཤུ་ཏི་འུ་སུ་ནག་པོར་བཞེད་ཀྱང་འདིར་སྤུ་འབྲུ་ལ་གསུངས་འདུག་སྐྱེར་བར་ཤུན།",
    "འདིར་རྩ་ཚིག་ཏུ་དབྱེ་བ་ཡོད་ཀྱང་ས་བཅད་མི་འདུག་པས་ཡི་གེ་འབྲི་དུས་ཆད་པ་ཡིན་ནམ་སྙམ་ཞེས།",
    "༣༤༢༡ས་བཅད་ནང་དུ་མི་འདུག་ཀྱང་དབྱེ་བ་སྤྱི་དང་བྱེ་བྲག་རྣམ་པ་གཉིས།",
    "ལཟིན་ཀྱང་ཕོག་དུས་ཤེས་པ་ཟི་ཞིང་འཚུབ།",
    "༤༤༥དབུགས་ཐུང་དགྱེ་དགུ་མི་ཤེས་པང་འཚོས་པང་དུ་བཟུང་འདུག་དགོས།",
    "༤༩༡༡༢ཡོད་སར་མི་འདུག་པ་སྤང་རྒལ་རྐང་ནང་དུ་མདེའུ་ལུས་པ་རྙི་བ་ཆད་དང་རུས་པ་འཐམས།",
    "བེ་རོ་ཙ་ན་ཨོཾ།",
    "༥༥༢་༡༣ས་གཞི་སྐམ་རླན་དང་བསིལ་དྲོད་སྙོམས་པ་དང་ཡིད་བདེར་གྱུར་པས་རོ་ཙ་ནུས།",
    "འགྲོ་འདུག་མང་བས་རྩ་ཡང་འཚུབ་པ་འོང་།",
    "དེ་དག་གང་ཡང་རང་རྩ་དར་དུས་སུ།",
    "དགྲ་ཡིས་ཚུགས་ཏེ་ཁོ་རང་རྒྱལ།",
    "འདུག་ཀྱང་རྒྱུ།",
    "དམར་སེར་སྐ་དང་དུགས་སྔོའི་ཆེ་འདུག་ན།",
    "ཆུ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་།",
    "ཆུ་ཡི་ཁ་དོག་ཇི་ལྟར་འདུག་ཀྱང་།",
    "ཁ་དོག་ཇི་འདྲ་འདུག་ཀྱང་རོ་མངར་མེད་པ་གྲང་བའི་ཆུ།",
    "ཁམ་པར་འདུག་ན་ཤ་སོགས་མ་ཞུའི་རྟགས།",
    "ཞག་དུས་བསྲོས་ཀྱིན་ཞག་གསུམ་བར་དུ་བཞག་ལ།",
    "༦༥༡ སྐྱེ་སར་དང་གཙང་སར་སྐྱེས་དང་བསིལ་དྲོད་རང་རང་ནུས་པ་མཚུངས་པར་སྐྱེ་དུས་སུ་རྩ་བ་ལོ་ཡལ་སོགས་རང་རང་དུས་ལྟར་བཏུས་པ་དང་།",
    "གསུམ་པ་ས་བཅད་ལྔ་བར་འདུག་ཀྱང་དུག་དང་ཕྲལ་བ་རྩ་སྡོང་གཉིས་ཀྱི་དུག་ནི་ལྤགས་དང་རྐང་གཉིས་དུག་ཡིན་སྟེ་རྩ་བའི་ལྤགས།",
    "མ་ནུ་པུཥྐར་ལུག་ཆུང་ལུག་མིག་ལས་ཆུང་བ་ཨ་ཞང་བཅའ་སྒ་ཞེས་བྱ་སྟེ།",
    "ཞེས་ཤ་མ་དུར་བྱིད་ཅེས་དུར་བྱིད་དམར་ནག་ཏུ་འདུག་པ་དེ་དྲག་བཤལ་ལ་བསྔགས།",
    "གཏམ་མི་སྨྲ་མི་འགུལ་ཙོག་བུར་འདུག་པ་དང་།",
    "མི་སྨྲ་མི་གྲང་ཙོག་བུར་གོས་དྲོན་གྱོན་ནས་འདུག་པར་བྱ།",
    "མི་ཐུབ་ན་ཙོག་བུར་འདུག་ལ་སྣོད་དུ་བཏང་།",
    "ཁ་ཆར་བུ་ཡུག་དུས་མི་བསྲེག་པར་ཕྱག་རྡུམ་གྱིས་གསུངས།",
    "དེ་ལ་རྩིབ་མའི་གོ་བར་གང་ན་འདུག་བཙལ་ཏེ་དབུལ།",
    "༦༤༨༦ནང་དོག་ཅིང་འཐེན་སྡོད་བྱེད་ན་ཡང་སྲན་བཟོད་འདུག་ན་ཟོ་བླངས་བཏང་།",
    "ཚ་ལོག་གྲང་ལོག་གམ་ཚ་གྲང་འཁྲུལ་བའི་ཐུར་ལོག་དེའི་རྟགས་བཅོས་ཐབས་རང་རང་སྐབས་ལྟར་བྱ།",
    "གཉའ་གཅོག་དུས་སྤང་བླང་ཨུར་ཚུགས་མིན་པར་མཛངས་པ་སྡར་ཏེ་ཝ་འདྲས་དགོས།",
    "ཁྱད་པར་གྲྭ་ཚང་རང་ལ།",
    "བློ་དང་ལྡན་པ་སོགས་ཀྱིས་ཀྱང་ཇི་བཞིན་པའི་ལམ་འདི་སྐྱོན་མེད་པ་ཞིག་རྟོགས་པར་དཀའ་ནལྷག་པའི་ལྷའི་བྱིན་གྱིས་མ་བརླབས་པ་དང་རང་ཉིད་ཀྱང་ཇི་ལྟ་ཇི་སྙེད་ཀྱི་གནས་ལ་དཔྱོད་པའི་བློ་སྟོབས་ཞན་པ་རྣམས་ཀྱིས་རྟོགས་པར་དཀའ་བ་སྨོས་ཅི་དགོས་ཀྱི།",
    "དེ་བཞིན་དུ་རིགས་པ་ཡང་དག་པས་གྲུབ་པའི་ཕྱིར་གསང་སྔགས་རྙིང་མའི་ལུགས་འདི་རང་སྟོང་ཡིན་ཀྱང་རང་སྟོང་གཞན་སྟོང་གཉིས་ཀྱི་ཟླས་ཕྱེ་བའི་རང་སྟོང་ཀྱང་མ་ཡིན་ཏེ།",
    "རང་རང་ངོ་བོ་སྟོང་པའི་ཕྱིར།",
    "ཡང་རང་རྒྱུད་པ་མན་ཆད་ཀྱིས་ཆ་མེད་གཉིས་པོ་ནས་རང་མཚན་གྱིས་གྲུབ་པའི་ཀུན་རྫོབ་བར་འདི་སྣང་ལ།",
    "དེ་འདྲའི་ཡིད་ཆད་སྐྱེ་བ་མེད་ཀྱི་རྟིང་གཞན་དག་སུ་མ་མགུ་ཡང་ཞེ་བློ་བདེ་བས་ཡིད་བདེ་ཁྱད་པར་ཅན་ཐོབ་པ་གཞན་པས་མཐོང་དུ་མེད་ཀྱང་རང་དོ་མཚར་ཆེའོ་སྙམ་དུ་ཡིད་ཆེས་ཕྱིར་མི་ལྡོག་པར་འགྱུར་རོ།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "དོན་ཡང་དག་ཅི་ཤེས་འདི་ཤེས་མེད་ཅིང་རང་དགར་སེམས་གནས་པའམ་འཇོག་པ་ཙམ་ནི་ཕྱིན་ཅི་ལོག་པའི་ཕྱི་རོལ་པ་རྣམས་ལ་ཡང་ཡོད་པས་སོ་ཞེ་ན།",
    "དེ་ཡང་རང་བཞིན་གསལ་བའི་ཆ་ལ་གདོད་ནས་ལྷུན་གྲུབ་ཏུ་བཞུགས་པའི་རང་མདངས་སྐུ་དང་ཡེ་ཤེས་ཀྱི་རང་བཞིན་གཏན་ལ་འབེབས་པ་ལ།",
    "ཁོ་རང་རང་རྐྱ་ཐུབ་པའི་རང་མཚན་དུ་ཡོད་པའི་ཕྱིར།",
    "གོང་དུ་དབྱིངས་ལ་སྣང་སྟོང་རང་བཞིན་གཉིས་མེད་པས།",
    "ཡང་འགའ་ཞིག་ལ་གནོད་པ་བསྟན་པའི་སྐྱོན་ཡང་རང་ལ་མི་འཇུག་སྟེ།",
    "ཙ་ནི་དཔྱད་པས་དྲངས་པའི་མཉམ་གཞག་ཁྱད་པར་ཅན་ཡིན་པས་ན་ངེས་ཤེས་སྒྲོན་མེའི་རྣམ་བཤད།",
    "ཡང་ན་ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་དུ་མེད་པ་དེ་རང་བཞིན་མེད་པས་ཁྱབ་སྟེ།",
    "གང་ཟག་ཕུང་པོ་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་དུ་འཛིན་ཚུལ་ལ་གཉིས་ཡོད་དེ།",
    "རང་བཞིན་གྱིས་མེད་དེ་ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུའང་མ་གྲུབ་པའི་ཕྱིར།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུ་ཡང་མེད་པ་དེ།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུའང་མ་གྲུབ་བོ།",
    "བདག་དེ་ཕུང་པོ་དང་རང་བཞིན་ཐ་དད་དུ་ཡོད་པ་ཇི་ལྟར་འགོག་ཚུལ་ཡང་།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུའང་མ་གྲུབ་པའི་ཕྱིར།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུའང་མ་གྲུབ་པའི་ཕྱིར།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུའང་མ་གྲུབ་པའི་ཕྱིར་ཞེས་པའི་རྟགས་འདི་དང་།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་དང་ཐ་དད་གང་དུའང་མ་གྲུབ་ན།",
    "ཁྱབ་བྱེད་སྣང་རུང་ཡིན་ན་ཁྱབ་བྱེད་མ་དམིགས་པའི་རྟགས་འཇུག་དུས་དང་།",
    "འཇུག་དུས་ཀྱི་སྒོ་ནས་འགལ་བར་འཇོག་དགོས་པའི་ཕྱིར།",
    "གསུང་ལན་འདི་ལ་ལེགས་ཆ་འདུག་ཀྱང་།",
    "དྲག་པོའི་སྦྱིན་སྲེག་དུས་ཀྱི་བྱིན་ཟའི་ཕུང་པོ་རྣམས་ཀྱི་ཆོག་ཁྲིགས་བྱས།",
    "རྩེད་སྣ་མང་བ་དང་ཁྲོམ་ཆེ་བར་འདུག།",
    "འདི་དང་རྩེས་དང་བསམ་གཏན་གླིང་གཉིས་སྲུང་མ་རང་བཞིན་གྱིས་འདུག་པའི་གནས་ཁྱད་པར་ཅན་དུ་གདའ།",
    "ཆུ་ཚན་དེ་གཟི་ཆེན་གྱིས་བདག་ཏུ་བཟུང་བ་ཞིག་ཡིན་པར་བྱེད་འདུག་པས་སླེབ་གདོང་འབྲུག་དང་སེར་ཆོལ་གྱི་གནམ་ངོའི་རྣམ་པ་ཡོད་ཙམ་དང་སྡོད་རིང་མི་ཚོགས་ཆེས་སྐྱོན་གྱིས་ནམ་མཁའ་ཧ་ཅང་ལེགས་པ་མ་བྱུང་།",
    "ཚེ་བདག་དང་ཁྲོ་ཆུ་སླར་ཉན་དགོས་པ་འདུག་ཅེས་སྙན་གསན་གནང་།",
    "ཕྱག་ཕྱིར་ཆད་དཀར་ལོ་ཙཱ་བ་འདུག་པར་སྒྲའི་སྐོར་གྱི་དྲི་བ་བྱས་པས་གོང་ར་ལོ་ཙཱ་བ།",
    "ཐོག་མར་བསྙེན་༢༦ན་རྫོགས་གནང་བཞེད་ལ་ནང་སོ་ཨ་ནོར་གྱིས་གཙོས་དྲུང་འཁོར་རྣམས་ཀྱིས་མཆོད་དཔོན་པ་བསྐུལ་བའི་ཞལ་ངོ་འཁྲོལ་ཆུངས་པས་རབ་ཏུ་སྡོམ་པ་བཞེས་རྒྱུ་འཐེན་ཙམ་དང་དེ་མིན་སྐོར་ཅིག་དགེ་ཚུལ་ཙམ་གནང་བ་བརྟན་པ་ཡོང་ཚུལ་གྱི་སྙན་སྒྲོན་ཞུས་འདུག་པར་བརྟེན་ཐུགས་འགྱུར་པའི་དགོངས་བསྟད་བཞིན་ཕྱི་དྲོ་ཞབས་དྲུང་མ་ཆེན་དགེ་ཚུལ་དུ་བསྒྲུབས།",
    "སྟག་རྩེ་ནས་གསེར་སྐུ་གྲ་ཚར་བཞེང་བ་མཛད་འདུག་པར་མེ་ཏོག་གཏོར།",
    "བཀའ་ཤོག་ཤུབས་བཅས་གཉིས་འདུག་པའི་གཅིག་རྒྱ་སོག་བར་གྱི་གཞུང་དོན་ལ་ཕེབས་པ་ཡིན་སྣང་།",
    "རྒྱ་ནག་ཏུ་གླང་པོ་ཆེ་གསོན་པོའང་མང་དུ་མཐོང་རུང་མཆེ་བ་དེ་འདྲ་ཡོད་པ་ཡེ་མི་འདུག་པས་ཁྱད་དུ་འཕགས་པ་ཞིག་ཡིན་པར་མངོན།",
    "གྲོང་སྨད་ནས་ཚངས་པ་དུང་ཐོད་ཅན་ལ་ལུང་བསྟན་ཞུ་མི་བཏང་འདུག་པར་བསྙུན་བབས་དང་བར་ཆད་ཀྱི་ངོ་ཆེ།",
    "དྲུང་འཚོ་བ་ལྷག་བསམ་ཉིན་སྟར་གྱི་ཕྱག་རྩ་ཞུ་བར་བཏང་བ་བཟང་ངན་ཐག་ཆོད་ཀྱི་གསལ་ཁ་མ་རྙེད་རུང་ཆུ་རྟགས་ཀྱི་བབས་ལ་བལྟས་ན་ཆབ་གསོག་བྱུང་དོགས་ཆེ་བ་འདུག་པས།",
    "སངས་རྒྱམ་པ་འབྱོར་བའི་སྐད་ཆ་ལའང་བཞེང་འདུག་སོགས་དཀའ་ལས་ཆེན་པོ་ཡོད་འཕྲོས་ཟེར་བས་སྟག་རུ་ནས་ལ་སཾ་ཊ་བསྐུར་བར་ཡང་སངས་རྒྱམ་པས་ཟེར་བ་དང་དབྱིབས་མཚུངས་གཤིས།",
    "འོར་ནས་ཅན་བཏང་༤༦ན་བར་ཁ་འོར་གཉིས་ཀྱིས་ཁུར་འཁུར་པོ་བྱས་འཕྲོས་མི་འདུག།",
    "པགས་རིགས་སོགས་གཏོས་ཆེ་བ་ཡོད་འདུག་ཀྱང་ཁྲ་མ་ཞིབ་པ་མི་སྣང་།",
    "མཆོད་ཡོན་གཉིས་གཤེགས་པའི་གནས་གཤིས་འགངས་ཆེ་དྲགས་པས་བགེགས་ཆགས་སངས་པ་ལས་ཀྱང་འོས་མ་མཆིས་ཤིང་ཐོས་བསམ་གྱི་སྐལ་བ་ཞན་ཞིང་སྲིད་ཀྱི་བཀའ་བབས་པ་ལྟ་བུའི་ལས་ངན་པ་ཞིག་ཀྱང་ཡོད་ཚོད་དུ་འདུག་པས་འདི་ལོ་ཁམས་ནན་ཏར་བདེ།",
    "བྲག་དབར་གྲ་ཚང་པར་བསྟན་དར་སྐུའི་ཞུ་རྟེན་ཀྱང་འདུག་པ་དང་བཅས་མས་དྲོ་གྱང་གྲོང་འོག་གཞིས་ཀ་ཐེམ་འཛིན་བཅུ་དྲུག།",
    "རོང་གྲགས་པ་པའི་མས་སྲིབས་སྐྱ་རིལ་ལ་གནང་འདུག་པའི་ས་ཚབ་སྒྲོལ་སྦུག་ཁུང་རོང་ཐང་སྤེའི་ཁང་པ་འོག་ཐོག་ཐེམ་འཛིན་གཅིག།",
    "རས་ཀྱིས་མཚོན་པའི་ཡིག་རྟེན་དཔངས་བསྟོད་པ་འདུག།",
    "སང་འབྲས་སྤུངས་ཀྱི་མཆོད་ཁང་ཡས་མས་ཀྱི་སྐུ་བརྙན་འགའ་ཞིག་ལའང་མཚོན་བསྣུན་པ་བྱས་འདུག་པས་ཁོག་པ་སྐོར་ཅིག་གདོང་དཀར་དུ་བསྐྱལ་བས་མཚམས་ཆོད།",
    "དཀྱིལ་འཁོར་སྡིངས་ཀྱི་ཟངས་ཁྲ་ཤིན་ཏུ་ཧྲུལ་པའི་བྱེའུ་སོགས་ཀྱིས་གནོད་པ་ཆེ་བ་འདུག་པར་གསར་བཟོ།",
    "གྲོང་སྨད་ཉེ་སྐོར་དུ་གཡོག་རིས་དུད་ཆེན་ཉུང་བ་འདུག་པས་ཉང་བྲན་ན་༨བ་ག་ཅན་གོང་འོག་སྒང་མགོ་བ་དང་བཅས་པའི་ཐེམ་གསུམ།",
    "རྒྱལ་བ་བཙོང་ཁ་པའི་སྐུ་དགའ་ལྡན་ལྷ་ཁང་དུ་སྤོས་པར་རྣམ་རྟོག་བྱེད་མཁན་འདྲ་ཡོད་འདུག་པའི་སྟབས་སྔར་གྱི་བཞུགས་གནས་སུ་གདན་དྲངས།",
    "བོན་འདི་ལ་བོད་ཀྱི་ལྷ་རྣམས་དགའ་བར་མ་ཟད་ཀླུ་ལ་ལྷག་པར་མངའ་བརྙེས་པ་ཞིག་ཡོད་ཚོད་དུ་འདུག།",
    "ཚེས་བཅུ་བཞི་ལ་གོང་ནས་རྒྱལ་པོའི་དགོངས་རྫོགས་གནང་བ་ལེན་པར་རཏྣ་མཆེད་འབྱོར་བའི་གནང་སྦྱིན་ལྔ་བཅུ་མ་ཉི་ཤུ་དང་གོས་དར་གཏོས་ཆེ་བ་བྱུང་འདུག་པ་སྔར་གྱི་དགོངས་རྫོགས་རྣམས་འདི་ག་ནས་ཁུར་ཁུར་ཏེ་བཏང་བས་བསྔོ་རྟེན་གྱི་ཚུལ་དུ་འབུལ་རྒྱུ་ཡིན་ཚུལ་ནན་ཆེ་བར་མཆོད་ཡོན་ནང་མཚམས་སུ་དེ་འདྲའི་པར་བཀབ་མ་དགོས་ཀྱང་ཐུགས་དང་བསྟུན་ཏེ་བསྔོ་སྨོན་གྱིས་རྒྱས་བཏབ།",
    "ངག་མ་རྒྱས་པར་འདུག་པ་དེ་ལན་བསྲིངས།",
    "ཨོཾ་གསུམ་མའི་འབྲུ་འབུམ་སོགས་ཐུགས་དམ་ཤིན་ཏུ་སྨིན་པ་ཡོད་འདུག་པས་མཁའ་སྤྱོད་དུ་གཤེགས་པར་མངོན།",
    "མི་དེ་ཅ་པོ་ལ་དགའ་ཚོར་ཆེར་མི་བྱེད་ཀྱང་ཡོན་དུ་དངུལ་སྲང་བཅུ་དང་གོན་པ་ཆ་ཚང་བྱིན་པར་དངུལ་ཚུར་སློག་འདུག།",
    "བདེ་ཆེན་རབ་བརྟན་ཕྱོགས་ནས་མཆེད་པའི་སྤྲེའུའི་རྐུན་མ་ཞིག་ནི་བྱུང་བར་གདའ།",
    "དྲུང་འཚོ་སྤྱན་གཡས་པ་དང་སྒར་པ་གྲོང་པ་དཔོན་བཟང་ལྟ་བུ་ཡོད་ན་འདི་ནི་འདིའོ་ཞེས་ཐོག་མ་ནས་ལུང་སྟོན་ཚོད་དུ་གདའ།",
    "རྗེ་མི་ལར་རྩམ་པ་ཙམ་ཡང་མ་འབྱོར་བར་ཟྭ་ཚོད་ཀྱི་དཀའ་ཐུབ་ལ་བརྟེན་ནས་གཅིག་པུར་བཞུགས་པའི་དུས་ཀྱི་གསུང་མགུར་རྣམས་ཡི་གེར་འཁོད་འདུག་པའི་སྣག་ཤོག་སམ་ཊ་ཡི་གེ་འདྲི་བའི་རྩོལ་བ་སུས་བྱས།",
    "ངེད་ཀྱིས་ནི་ཁོང་པ་ཞལ་དྲི་ཞིམ་པོ་མི་འདུག་པས་པར་བཀབ་མ་བསྲིངས།",
    "ཡར་ཀླུངས་མཐིལ་གྱི་འདྲེན་པ་ཚོར་འཁྲུལ་པ་མི་མངའ་བས་རྗེ་བཙུན་གོང་མའི་གསུང་ལ་ཞུས་དག་དགོས་པར་གདའ།",
    "རྨི་རུ་ལྟ་བུ་ནས་བཙལ་ཡང་རྙེད་པར་གདའ་འོ།",
    "ཟུང་མཁར་ཨ་ཇོ་དཔལ་བོའི་གཏེར་མའི་རྡོ་རྗེ་དྲག་རྒྱལ་མའི་སྒྲུབ་སྐོར་ཆ་ཚང་བ།",
    "རྩམ་འཐོར་འདི་ལ་ཐམས་ཅད་དགའ་བ་འདུག་པས་གསེར་སོགས་ཀྱི་སྟེར་ཆ་ལེགས་པ་བྱས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "དེས་ཡར་སྟོད་ཀྱི་མཆོད་རྟེན་ནང་ནས་སཱཙྪ་རྙེད་པ་གཏེར་ཡིན་མིན་འདྲི་བ་སོགས་ཟོག་རྫུན་ཅི་ཡང་བྱེེད་འདུག་པ་ར་ཐང་འདི་དྭགས་ལྷ་སྒམ་པོ་དང་གསལ་བ་སྒང་ཁམས་ཀྱི་སྤོ་བོ་གསུམ་ན་མིན་པ་མེད་སྙམ་ནའང་དེ་ནི་མང་པོ་སླེབས་འདུག་པས་མཆོག་དམན་མཐའ་དག་གྲུང་པོ་མ་བྱས་ན་མགོ་ལ་གཡོག་པར་ཚེགས་མི་སྣང་ངོ།",
    "ཕ་ཡོད་ཙ་ན་བུ་ཡང་མེད།",
    "བུ་ཡོད་ཙ་ན་ཕ་ཡང་མེད།",
    "ཚུར་གནང་སྐྱེས་ཀྱང་དིང་སང་དབུས་གཙང་དུ་གྲུ་བཞི་ལམ་མེར་བཞུགས་པའི་བླ་ཆེན་རྣམས་ལས་ཁོང་དཔོན་སློབ་བཀག་པོར་ཕེབས་ནའང་ལྷ་ཆེན་པོའི་རོའི་དཔེ་ལྟར་སྤྱན་བབས་མཐོ་བར་འདུག་ཅིང་ཕར་འབུལ་ཡང་གཟེངས་བསྟོད།",
    "དཔེ་འདི་ཚོ་ལུས་ན་སྲས་ཀྱང་ཐུགས་བློ་བསྒྱུར་དོགས་འདུག་པས་ཚང་མ་བཞེས་དགོས་ཚུལ་ནན་ཞུས་ལ་བརྟེན་དྲངས་པར་གསར་བཞེངས།",
    "རྒྱལ་པོ་མགྱོགས་ཙམ་འབྱོན་རྩིས་འདུག་པ་ནས་དེ་བཞིན་གཤེགས་པའི་འཕེལ་གདུང་།",
    "ཁལ་ཁ་ཨུ་རང་ཁང་བིང་ཐུ་དའི་ཆིན་སྐོར་ལ་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་བསྐུར།",
    "མངའ་རིས་གྲ་ཚང་སོགས་དང་གྲ་ཚང་རང་དང་གྲ་པ་རྒན་གཞོན་བྱེད་པ་བཟང་ངན་དང་བསྟུན་པའི་ཇ་ཆང་ཐུག་པ་བག་ཚས་མཚོན་ཉིན་གནངས་ཆག་དང་གཞེས་ཆག་སྣ་ཚོགས་ཀྱི་འུ་ལག་རྣམས་ཚིམ་ཞིང་འགོ་ལུང་བཟོ་བོ་སོགས་ལའང་ཚན་གྲངས་ཀྱིས་གཙོས་པའི་ཨར་སྟོན་རྒྱས་པར་བྱུང་།",
    "པད་ཚལ་བཙུན་པས་བར་ཁམས་སུ་མཁའ་འགྲོའི་ངོ་འཛིན་ཆེས་པའི་བྱེད་འཛོལ་ཆེ་བར་བཀའ་སྐྱོན་བབས་ལྕི་བ་བྱུང་འདུག་ནའང་སྔར་བྱས་ལ་བསམ་པད་ཚལ་རྙིང་ཁུངས་རང་སློག་བྱས་པར་གཞིས་ཀ་ཐེམ་འཛིན་བཅུ་དྲུག།",
    "འཇུན་རྩེ་ཞོལ་ས་འདྲེས་ཆེས་པའི་བདག་པོ་མ་གཅིག་ཕྱིན་སུ་ལའང་འཛིན་བདེ་མི་འདུག་པས་ཟླ་འདྲིལ་ཁྱད་ནས་འཇུན་ཞོལ་བར་ས་ཚབ་དང་ས་སྣོན་སྦྲགས་པར་ཤེལ་གྲོང་གཞིས་ཀ་ཤར་གྱི་ཁང་པ།",
    "བསྔོ་སྨོན་དང་བྱང་བུ་བཞུ་བར་ཐུགས་དམ་སྨིན་པོ་ཡོད་འདུག་པ་དང་མཐུན་པའི་མཚན་མ་ལེགས་པ་བྱུང་།",
    "དེ་དང་མཐུན་པ་སྲེག་སྦྱངས་དུས་ཨ་དང་དུང་རང་བྱོན་གདུང་ལྕགས་གཅོད་སོགས་མཚན་ལྟས་ལེགས་པར་བྱུང་སྣང་བས་ལྷ་གནས་ཁྱད་པར་ཅན་ཞིག་ཏུ་འཕོས་པ་ཡིན་ནམ་སྙམ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་གཙོ་རྐྱང་།",
    "ཟླ་༩ ཚེས་༡༦ ཉིན་སྙན་ཕུལ་ངོ་བཤུས་བཅས་འདིར་ཟླ་༡༢ ཚེས་༢༡ ཉིན་འབྱོར་སྐོར་གང་ཅིའི་གོ་བསྡུར་བྱེད་ཁྱད་དང་བཅས་ཁྱེད་རང་ངོ་མ་འདི་ག་བཞུགས་སྒར་དུ་ཕྱི་ཟླ་༡༢ ཚེས་༣ ཚུན་ངེས་འབྱོར་དགོས་རྒྱུ་དང་།",
    "དེ་བཞིན་ཚོགས་པ་བཅུ་གསུམ་གྱི་འགོ་འཐུས་ཡིན་ཟེར་བཞུགས་སྒར་དུ་མི་མང་པོ་ཞིག་དཔུང་ཤེད་ལྟ་བུར་ཆེད་འབྱོར་བྱུང་འདུག་པ་དེ་སྐབས།",
    "དང་རང་གཞུང་ལ་གནས་དུས་ཚོད་རྩིས་ཀྱི་བྱ་སྤྱོད་སུ་ཐད་ནས་བྱུང་ཡང་།",
    "རྒྱ་མིའི་འོག་ལ་སྐྱིད་པ་འདུག་ཅེས་ལབ་ན།",
    "རྒྱ་གར་ནང་འབྱོར་སྐབས་དེ་འགྲིགས་ཀྱི་མི་འདུག་པས་རིས་མེད་ཞིག་དགོས་ཀྱི་འདུག་ཅེས་སྲིད་བྱུས་གསར་བ་ཞིག་བཏིང་པ་ཡིན།",
    "ང་རང་ལ་ཆ་བཞག་ན།",
    "ཁོ་རང་གསོན་པའི་སྐབས་ལ་ཡང་བསྙད་སེ་བསྐོ་སིའི་རྙོག་མ་གཏིང་སློང་ཤ་སྟག་བྱས་བྱུང་ལ།",
    "ད་ཆ་བྱ་ཐབས་གང་ཡང་མི་འདུག་རྐྱེན་ངན་དེ་འདྲ་ཞིག་བྱུང་བཞིན་དུ།",
    "ཕྱིས་ན་རྒྱུན་སྐྱོང་ཐུབ་པ་ནི་བྱུང་མི་འདུག་ཡང་མཚམས་འདིར།",
    "ཚང་མས་བསམ་བློ་ཡག་པོ་ཐོངས་སོགས་ཟེར་བ་བྱུང་འདུག་དེ་ལྟར་བཟུང་བཀག་མུར་སྐུ་མཆེད་ལྷ་ལོ་དང་བུ་སྐལ་བནྡེ་བྱམས།",
    "མཆོད་རྟེན་བརྒྱད་པོའི་གཤམ་འོག་ལུང་མཐིལ་སྡོང་གསེང་དུ་མཇལ་གྲོགས་མང་པོའི་མཉམ་ཞག་སྡོད་སར་འདས་གྲོངས་སུ་གྱུར་འདུག།",
    "༧ཤར་སྐྱབས་མགོན་ཚང་དང་འབྲལ་མེད་ལྟ་བུ་བྱུང་འདུག་ཅིང་།",
    "ད་ལམ་གོ་ཆོད་འདུག་སྤྱིར་ན་དཔོན་པོ་ངེད་གཉིས་འདིར་རྒྱུན་རིང་པོར་མཉམ་དུ་བསྡད་པ་ཡིན།",
    "སྐབས་དེར་ལྷན་བཅར་རྒྱ་མི་འགོ་ཁྲིད་རྣམས་ཁ་སྐྱེངས་ཏེ་ནང་དུ་འགྲོ་མ་འདོད་པར་ར་སྐོར་ཕྱི་ལོགས་ནས་བསྡད་པ་ཡིན་འདུག་ཅིང་།",
    "ཟླ་༧ ཚེས་༡༢ ཉིན་ཟི་ལིང་དུ་འབྱོར་རྒྱུའི་ཕེབས་འདུག།",
    "ཅེས་གསལ་འདོན་གནང་འདུག་རྩིས་ཞིབ་སྤྱི་ཁྱབ་འགན་འཛིན་གནང་རིང་དེར།",
    "སྐབས་དེར་ཁས་ལེན་ཡི་གེ་ཞིག་ལ་ས་རྟགས་བཀོད་པ་དྲན་གྱི་འདུག་ཕལ་ཆེར་སྐབས་དེའི་ཕོགས་འབབ་ཀྱང་ཡི་གེ་དེར་གསལ་ཡོད་པ་ཡོད།",
    "༢ ཡིན་པ་གསལ་འཁོད་འདུག་ཅིང་།",
    "ཕྱི་ལོ་༡༩༨༢ ཟླ་༦ ཚེས་༢ ནས་ཕྱི་ལོ་༡༩༨༤ ཟླ་༦ ཚེས་༣ ཉིན་བར་ལས་ཁུར་ཞུས་འདུག་པ་དང་།",
    "སྐུ་ངོ་ཀུན་གླིང་དེའི་ཉིན་ཕེབས་འདུག་ཅིང་།",
    "ཨིན་ལན་མི་དམངས་དང་བོད་མིའི་བར་གྱི་འབྲེལ་བའི་སྐོར་འདྲི་རྩད་བྱེད་ཀྱི་འདུག་པར།",
    "ཡང་ཁོང་ནས་རྗེས་སུ་ཕྱིར་འཁོར་མཚམས་ལྷོད་མཇལ་ཡོང་རྒྱུ་བརྗོད་འདུག་ཅིང་།",
    "དེ་བཞིན་༧གོང་ས་མཆོག་མཇལ་བཅར་ཞུ་རྒྱུ་ཡང་གང་ལེགས་འདུག་ཅེས་བརྗོད།",
    "རྒྱ་ནག་ནང་ལོ་གཅིག་རིང་བསྐྱོད་འཐུས་ཆོག་རྒྱུ་ཞེས་བཀོད་འདུག་པར།",
    "སྐུ་ཞབས་ཇི་འབྱོར་ཏེ་ཝི་ས་གསར་པ་ཤོག་ལྷེ་རྐྱང་པ་རྒྱ་ཡིག་བྱས་པ་ཞིག་འཁྱེར་ཡོང་འདུག།",
    "གཞན་ལས་བྱེད་གཅིག་བཅས་མཉམ་སྡོད་བྱས་འདུག་དགོང་དྲོར་གསོལ་ཚིགས་སར་རན་རིན་ནས།",
    "ཡང་དུས་ཚོད་ཀྱང་ཕན་ཚུན་བསྒྱུར་ཆོག་རྒྱུ་བཅས་བརྗོད་འདུག།",
    "ཀན་སུའུ་ཁོངས་སྔོན་ལ་བསྐྱོད་ལེགས་ཞུ་འདུག་པར།",
    "ཀའོ་ཅིང་ཀྲང་འཐབ་ཕྱོགས་གཅིག་གྱུར་མི་རིགས་ཅུས་ཀྱི་ཐིན་ཀྲང་བཅས་ཕེབས་འདུག་ཅིང་།",
    "དེ་རིང་གསོལ་ཚིགས་ཁོངས་ཉ་ཤ་བཟོས་འདུག་གལ་ཏེ།",
    "ཐུག་འདོད་ཡོད་ཚེ་གྲ་སྒྲིག་ཞུ་འཐུས་བརྗོད་འདུག་པར།",
    "དེང་སྐབས་གང་དུ་བཞུགས་གདན་འཇགས་མིན་སོགས་ཞུ་འདུག་པར།",
    "དད་རྟེན་དང་བྱིན་རྟེན་དགོས་ལུགས་ཞུ་འདུག་པར་འབུལ་ཞུ་ཞུས།",
    "སློབ་ཕྲུག་ཉི་ཤུ་སྐོར་འདུག་ཅིང་།",
    "འབའ་བ་སྐལ་བཟང་འགྱུར་མེད་ནས་དེ་དོན་སེམས་ལ་བཅངས་ཏེ་གང་ཡོང་ཞུ་མུས་སུ་ཡོད་ཞུ་འདུག་ཕྱི་དྲོ་ཆུ་ཚོད་གཉིས་ཐོག་མི་རིགས་དཔེ་སྐྲུན་ཁང་དུ་བསྐྱོད།",
    "ཀོ་ཁྲུའུ་ཀྲང་བཅས་ཕེབས་འདུག་ཐོག་མར་ཕན་ཚུན་ངོ་སྤྲོད་ཞུས་རྗེས།",
    "ཁྱེད་རང་བཅས་རྣམ་པ་གསུམ་ལ་བཀའ་འདྲི་བཀའ་སློབ་ཞུ་དགོས་བཀའ་མངགས་ཡོད་ལུགས་སྐོར་དང་།",
    "གཉེན་ཉེ་དུའི་མི་རྩ་མཐུག་ལ་དེ་དག་ཀྱང་ཀུན་ལ་བྱམས་ཤིང་མཐུན་པར་གནས་པ་ཞིག་ཡིན་འདུག་སྟབས།",
    "དེ་མི་ཆོག་ཅེས་བརྗོད་འདུག་པར།",
    "གྱོན་ཆས་ཀྱང་བསྒྱུར་འདུག་ཟེར།",
    "བཅིངས་འགྲོལ་དམག་མིའི་དུས་ཆེན་མཉམ་འཁེལ་འདུག་སྟབས།",
    "༧གོང་ས་མཆོག་ལ་སྐྱབས་འཇུག་ཞུ་རོགས་ཞེས་གསུང་འདུག་ཚེས་༣ ཉིན་བྲའུ་དཔོན་གྱི་ཉེ་འབྲེལ་དང་།",
    "ཀན་སུའུ་ཁོངས་སུ་དྲུག་ཉིན་ཞའི་ཁོངས་སུ་བཞི་ཡོད་ཟེར་འདུག།",
    "འདིར་བོད་རིགས་ཁྲི་གསུམ་ཡོད་འདུག་བཀྲ་ཤིས་ཕྱུག་ལུང་ཐང་དུ་འབྲོག་པའི་ཁྱིམ་ཚང་ཞིག་ཏུ་འཁྲིད།",
    "༧གོང་ས་མཆོག་ཧ་ཅང་མཇལ་འདོད་ཆེན་པོ་འདུག་ཅེས་གསུངས།",
    "ཕྱིས་ན་དེ་དག་ལས་མང་དག་ཅིག་དང་ལྷན་ཡིག་འབྲེལ་རྒྱུན་མར་གནང་བའི་མ་ཟིན་སྐོར་མང་དག་བཅས་ཡིག་ཚགས་ཁག་ཏུ་འདུག་ནའང་།",
    "མཛད་འཆར་དང་འབྲེལ་བྱེད་སྒོ་གཅིག་གྱུར་པ་སྤྱིའི་སྐོར་ནི་དེ་ཙམ་གསལ་འགོད་གནང་མི་འདུག་ནའང་།",
    "ལར་སྤོ་བཤུགས་ཀྱི་ཐག་ཆོད་ལྟ་བུ་བྱུང་འདུག་ཀྱང་།",
    "ཞལ་སློག་ས་སོགས་གང་ཅིའི་ཐོག་ནས་དཀྱུས་རྟགས་དང་ཉམས་དམའ་བའི་མཐོང་ཚུལ་ཞིག་ཚང་མར་བྱུང་འདུག།",
    "རན་རིན་གཉིས་ནས་ཁྱེད་རང་ཐུག་འཕྲད་དུ་ཕེབས་དགོས་པའི་ལན་བསྐུར་བྱུང་།",
    "ཕལ་ཆེར་མཇལ་ཁའི་སྐོར་མིན་ནམ་སྙམ་པ་འདུག་གསུངས་བྱུང་།",
    "ཁྱེད་རང་ཉེ་དུས་གོ་ས་འཕར་ལུགས་གོ་ཐོས་བྱུང་།",
    "ལི་ཛུ་མིན་དང་རྒྱ་མི་གཅིག་བཅས་འདུག་༧གོང་ས་མཆོག་ལ་འབུལ་རྒྱུའི་ཕྱག་བྲིས་རྟགས་ཐེལ་འབྱར་མ་ཞིག་དང་།",
    "ཞིབ་ཕྲ་འགོད་པ་ལས་དོན་མང་པོ་ཞིག་ད་ལྟའི་སྐབས་ན་ཕྱིར་བསྒྲགས་རུང་མིན་སོགས་སྣ་ཚོགས་སུ་འདུག་སྟབས།",
    "བྱས་ན་ཡག་པོ་བྱུང་འདུག་སྐུ་མདུན་ལ་འཚམས་འདྲི་དང་ཐུགས་རྗེ་ཆེ་ཞུ་རོགས་གནང་།",
    "སླད་འབྲེལ་བ་ཞུ་བདེའི་ཁྱད་འདུག་གསུངས།",
    "ཧ་ཅང་ཡག་པོ་བྱུང་འདུག་བཀའ་དྲིན་ཆེ།",
    "རོང་པོའི་གསེར་ཁྲི་བཅས་ལ་གོང་བཞིན་གནས་ལུགས་ཞུས་འདུག།",
    "འབོ་མི་ཞེས་འབོད་སྲོལ་དེ་ནི་ཡུལ་སྐད་ཀྱི་སྒྲའི་ཁྱད་ཀྱིས་ཡིན་འདུག་ཚུལ་འདིའི་ཐོག་ཤུགས་ཆེ་ཙམ་གནང་གལ་ཆེ།",
    "ཤེས་རྟོགས་ཡོང་བ་དེས་ཕན་ཐོགས་འདུག་༧གོང་ས་ཆེན་པོར།",
    "མཐོང་ཙམ་ཉིད་ནས་སྐལ་ལྡན་གདུལ་བྱའི་རྒྱུད་ལ་ཐར་བའི་ས་བོན་འགོག་མེད་བདེ་ལེགས་སུ་བསྐྲུན་པའི་མཐོང་བ་དོན་ལྡན་གྱི་སྐུའི་བརྙན་པར་གཟི་བྱིན་ཐིག་ལེ་འོད་སྟོང་ཕྱོགས་བཅུར་འཕྲོ་བ་ཞིག་འདུག་པར།",
    "དེ་དུས་སྐུ་ཚབ་ཆེད་གཏོང་མི་སྣ་གཙོ་བོ་ང་རང་བསྐོ་བཞག་གནང་།",
    "ང་རང་བལ་ཡུལ་དུ་འབྱོར་མཚམས་མི་སྣ་མང་པོར་ཕན་ཚུན་འབྲེལ་བ་གང་ཐུབ་བྱས་རྗེས།",
    "ཞེ་དྲག་འདུག་ཐུབ་མིན་མི་ཤེས།",
    "ནང་ཁྲོལ་ཅིག་ལ་རྨ་འདྲ་པོ་ནག་ཐིག་ཅིག་འདུག་ཅེས་དེ་འདྲའི་གནས་ཚུལ་ཞིག་ཤེས་བྱུང་།",
    "ཞེས་ཚུར་ཕེབས་རྒྱུ་དེ་ཁག་པོ་ཆགས་པའི་རྣམ་པ་འདུག་ཅེས་ཟེར་གྱི་འདུག།",
    "ཁོ་རང་གཉིས་ལ་གོ་བསྡུར་བྱས།",
    "ད་ལྟ་ཏག་ཏག་ཅིག་དྲན་གྱི་མི་འདུག་དེའི་རྗེས།",
    "བོད་ལྕགས་ཡོས་ཕྱི་ལོ་༢༡༡ ནང་བོད་ནང་རང་ལུས་མེར་བསྲེགས་ཀྱི་ལས་འགུལ་རིམ་བསྟུད་བྱུང་བ་བརྗོད་གཞིར་དྲངས་འབྲེལ།",
    "རྗེ་དེ་ཉིད་ཀྱི་དམིགས་གཏད་བསྐྱངས་རིམ་བཞིན་ཕྱོགས་གང་ཐད་ནས་བདག་སྐྱོང་ཐུགས་སྣང་གནང་འདུག་ནའང་།",
    "ཞེས་བཀོད་གནང་འདུག་པས་མཚོན།",
    "འདི་ནས་སློབ་ཐོན་རིགས་ཀྱིས་བོད་ནང་རང་འཚོའི་ལས་དོན་གཉེར་མཁན་ཕྱོགས་གཉིས་ཀར་ཕན་ཐོགས་ངེས་ཅན་འབུལ་ཐུབ་པ་ཞིག་ཏུ་ཡར་རྒྱས་གཏོང་འཆར་གྱིས་ཡོད་ཅིང་།",
    "ད་ནི་སྔར་ལས་དྲགས་སྐྱེད་གང་ལེགས་བྱུང་འདུག་པས།",
    "ཁ་སང་དེ་རིང་གནམ་གཤིས་དེ་ཙམ་ཡག་པོ་མི་འདུག་ཡར་མར་མ་ཕེབས་ན་ལེགས་པ་མེད་འགྲོ།",
    "རྒྱ་སྒོར་ཁྲི་དང་བཅས་འཁྲུངས་གཞིས་སུ་ཕུལ་འདུག་ཟླ་༧ ཚེས་༢༨ ཉིན་རླངས་ཚང་བན་བརྒྱས་ཕེབས་བསུ་དང་བཅས།",
    "ལམ་ཁ་དག་ཏུ་ཕེབས་བསུར་བཅར་མཁན་མང་པོ་བྱུང་འདུག།",
    "བོད་ནས་གདུང་རྟེན་བཞེངས་མི་ཆོག་རྒྱུ་བཅས་བརྒྱུད་བསྒྲགས་གོ་བསྡུར་བྱས་སྐད་འདུག་ཅིང་།",
    "གཞན་གཉིས་ཀྱིས་ནི་གསན་བསམ་རྒྱ་ཆེ་གནངས་འདུག་ཅིང་།",
    "གཞན་ཕན་གྱི་མཛད་པ་རྒྱ་གང་ཆེ་མཛད་འདུག་ཅིང་།",
    "སྐྱ་བོའི་གྱོན་གོས་ཆ་ཚང་ཞིག་བཅས་ཕུལ་བ་དེས་ཕན་ཐོགས་བྱུང་འདུག་ཅིང་།",
    "ཐུགས་བློ་བདེ་ཙམ་བྱུང་འདུག་ནའང་།",
