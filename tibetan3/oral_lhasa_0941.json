    "ཁྲོ་རྒྱལ་རྡོ་རྗེ་ཤུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཤ་རུས་ཀྱི་ཞལ་ཟས་རྣམས་ཁྱད་པར་དུ་བཤམས།",
    "སྐུ་གཟུགས་མདུན་མཎྜལ་སྟེང་པད་དཀར་འདབ་བརྒྱད་ལྟེ་བར་ཚོམ་བུ་དཀར་པོ་འགོད།",
    "ཁ་སརྦ་ཎི་ལྷ་ལྔའི་རྗེས་༧བ་གནང་བཅའ་གཞི་ལ།",
    "སྒྲོལ་ལྗང་ཁ་ཆེ་པཎ་ཆེན་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "སྒྲོལ་མ་ཡིད་བཞིན་ནོར་བུའི་རྗེས་གནང་བཅའ་གཞིར།",
    "སྒྲོལ་མ་ནོར་སྦྱིན་མའི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཕྱག་རྡོར་ས་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཕྱག་རྡོར་གཏུམ་པོ་ཁྲ་ཐོགས་ཀྱི་རྗེས་གནང་བཅའ་བཞིར།",
    "ཕྱག་རྡོར་གོས་སྔོན་ཅན་འགྲོ་བཟང་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཕྱག་རྡོར་ཁང་བརྩེགས་མའི་རྗེས་གནང་བཅའ་གཞིར།",
    "སིནྡྷུ་ར་སྙོམས་པར་བཀྲམ།",
    "ལས་བུམ་སྤྱི་དང་མཐུན་པར་བཤམས།",
    "རྟ་མགྲིན་ཁྱུང་གཤོག་ཅན་ཇོ་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྟ་མགྲིན་ཁ་ཆེ་པཎ་ཆེན་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྟ་མགྲིན་སྐྱེར་སྒང་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཐོ་རངས་སྐར་ཁོངས་གཉིས་གསུམ་ཙམ་ལ་བུམ་པ་གཙང་མར་ཆུའི་གཏིང་ནས་ཆུ་བླངས་ཏེ་ནམ་མཁའ་མ་མཐོང་བར་བྱས་བཤམས་པ་རྣམས། ༨༣",
    "མི་གཡོ་སྔོན་པོ་བཀའ་གདམས་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "མི་གཡོ་བ་དཀར་པོའི་རྗེས་གནང་བཅའ་གཞི་ལ།",
    "ཚེ་དཔག་མེད་བ་རི་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཚེ་དཔག་མེད་དཀར་པོ་མེ་ཏྲིའི་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "མཎྜལ་པད་དཀར་འདབ་བརྒྱད་ལྟེ་པར་ཚོམ་བུ་དཀར་པོ་བཀོད།",
    "གཙུག་ཏོར་རྣམ་རྒྱལ་ལྷ་དགུའི་རྗེས་གནང་བཅའ་གཞིར།",
    "འཇམ་དཀར་ཁ་ཆེ་པཎ་ཆེན་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "འཇམ་དཔལ་མཚན་བརྗོད་ཀྱི་གླེགས་བམ་བཞུགས་སུ་གསོལ།",
    "འཇམ་དབྱངས་གང་བློ་མའི་བསྟོད་སྒྲུབ་མར་གྲགས་པའི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཞིབ་པར་བཏགས་ལ་སྦྲང་རྩི་དང་།",
    "རྗེ་བཙུན་བྱམས་པ་ནི་རི་ཏི་པའི་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྫ་བུམ་དུ་གཞོན་ནུ་མ་གཙང་མའི་ཆུ་བླུག།",
    "ཀུ་རུ་ཀུལླེའི་༡༤བ་གསང་སྒྲུབ་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྩ་བ་ཞགས་པར་བྱས་པའི་ཨུཏྤལ་ལྕགས་ཀྱུ་དང་།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ལྗང་སྔོན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཁྲོ་བོ་བགེགས་མཐར་བྱེད་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "གཙུག་ཏོར་༡༦ན་གདུགས་དཀར་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཁྲོ་རྒྱལ་སྨེ་བརྩེགས་དུད་ཀའི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཁྲོ་བོ་སྨྲེ་བརྩེགས་ལྗང་གུའི་རྗེས་གནང་བཅའ་གཞིར།",
    "དུས་འཁོར་ཁྱུང་ཁྲ་རྒྱུད་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "དེ་འོག་སེར་པོ་བྱས་པ་བཀོད།",
    "ཏིང་ཤག།",
    "བཞི་པ་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་བའི་སྒྲོལ་མ། ༡༨",
    "དྲུག་པ་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་སྒྲོལ་མ། ༡༨༢",
    "དཀྱུས་ལྟར་བྱས་ན་དགུ་པ་མཆོག་སྩོལ་བའི་སྒྲོལ་མ། ༡༨༥",
    "བཅུ་གསུམ་པ་ཡོངས་སུ་སྨིན་པར་མཛད་པའི་སྒྲོལ་མ། ༡༨༩",
    "རྣམ་སྲས་སེར་ཆེན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྣམ་སྲས་མདུང་དམར་རྟ་སྔོན་ཅན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "༢༡ན་རྣམ་སྲས་ལྗང་སེར་བེ་ཅོན་ཅན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྣམ་སྲས་གསུང་མཆོག་ལུས་ངན་པོའི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྣམ་སྲས་དྲག་ཅན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྣམ་སྲས་ནག་པོ་རྟ་སྔོན་ཅན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྣམ་སྲས་དཀར་པོ་ཚེ་འཛིན་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "རྣམ་སྲས་ལྗང་གུ་སེང་ཞོན་མ་ཉྫ་ནའི་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "མཎྜལ་པད་དཀར་འདབ་བརྒྱད་ཀྱི་སྟེང་མཉྫིའི་ཁར་རྟེན་གཏོར་དཀར་པོ་རི་རབ་གླིང་བཞིའི་རྣམ་པ་ཅན་ནོར་ལྷ་སྣ་ཚོགས་ཀྱིས་གང་བའི་སྣོད་དུ་བཤམས།",
    "ཛམ་ལྷ་ནག་པོ་ཁ་ཆེ་པཎ་ཆེན་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཛམ་ལྷ་དཀར་པོ་ལྷ་ལྔ་ཇོ་བོ་ལུགས་ཀྱི་རྗེས་གནང་བཅས་གཞིར།",
    "ཛམ་ལྷ་དམར་པོ་སྲོག་སྒྲུབ་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "མཎྜལ་སྟེང་བ་ལྕིས་བྱུགས་པར་པད་དཀར་འདབ་བརྒྱད་བཅད་དམར་སྐྱས་མཚན་པའི་ལྟེ་བར་ཚོམ་བུ་དམར་པོ།",
    "ཛམྦྷ་ལ་ལྗང་གུ་དུས་འཁོར་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཁྱད་པར་མེ་ཏོག་སྣ་ཚོགས་ཀྱིས་གང་བའི་སྣོད་རྣམས། ༢༢༢",
    "མ་རྙེད་ན་ཤིང་ཏོག་བིལ་བས་དོད་བྱས་པས་ཆོག།",
    "གནོད་སྦྱིན་རྡོ་རྗེ་བདུད་འདུལ་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཕྱི་ནང་གསང་གསུམ་གྱི་སྒོ་ནས་རྗེས་གནང་བྱེད་པར་སྤྲོ་ཚེ་བཅའ་གཞིར།",
    "གནོད་སྦྱིན་ཨ་པ་ར་ཛི་ཏའི་རྗེས་གནང་བཅའ་གཞིར།",
    "གྷི་ཝཾ་བསྲེས་པར་བྱུགས།",
    "སྣོད་གཙང་མར་དཀར་གཏོར་གསུམ་དང་།",
    "འབྲས་དང་དཀར་གསུམ་སོགས་བཟང་བ་གཙང་མའི་སྤུངས་གཏོར་བཤམས།",
    "མྱུར་མཛད་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ཕྱག་དྲུག་པ་ནག་པོ་བར་ཆད་ཀུན་སེལ་གྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "མགོན་དཀར་ཡིད་བཞིན་ནོར་བུའི་རྗེས་གནང་བཅའ་གཞིར།",
    "མགོན་པོ་ཕྱག་བཞི་གྲུབ་ཆེན་ཞི་བ་སྦས་པའི་ལུགས་ཀྱི་རྗེས་གནང་བཅའ་གཞིར།",
    "ཡེ་ཤེས་མགོན་པོ་ཞལ་གཅིག་ཕྱག་བཞི་པའི་རྗེས་གནང་བཅའ་གཞིར།",
