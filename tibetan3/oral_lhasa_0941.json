    "སྡོམ་པ་ཚུལ་བཞིན་དུ་བསྲུང་བའི་སྒོ་ནས་སློབ་དགོས་གསུངས།",
    "དེ་ལྟ་བུའི་བདག་འཛིན་གྱི་གཉེན་པོར་བདག་མེད་པར་རྟོགས་པའི་ཤེས་རབ་བསྐྱེད་དགོས་པས།",
    "དེའི་ཆེད་དུ་བཅོམ་ལྡན་འདས་བདག་མེད་མའི་དཀྱིལ་འཁོར་དུ་འཇུག་པར་བྱའོ་སྙམ་པ་ཞིག་མཛོད་གསུངས།",
    "བདེ་བ་ཆེན་པོ་ལམ་གྱི་སྲོག་ཏུ་འཛིན་པར་བྱ་བ་ཡིན་པས་བདེ་བ་ཆེན་པོའོ།",
    "སྐབས་འགར་མི་སློབ་པ་མིན་པར་དུས་དང་གནས་སྐབས་ཐམས་ཅད་དུ་སློབ་དགོས་པ་ཡིན་པས་དེ་ལྟར་བསླབ་པར་བྱའོ་སྙམ་པའི་སྒོ་ནས་བྱང་སྡོམ་འཛིན་པ་དང་།",
    "དེ་ཡང་མ་བརྟག་མ་དཔྱད་པར་མི་སྐྱེ་བས་ན།",
    "སྡིག་སྒྲིབ་དག་པ་ལ་༧༡བ་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་པས།",
    "ལོག་པར་གཡེང་པ་དང་།",
    "མཚམས་མེད་སོགས་ཀྱི་ཉེས་ལྟུང་ཆེན་པོ་རྣམས་ཀྱང་དག་པར་འགྱུར་བ་ཡིན།",
    "མཆོག་ཐུན་གྱི་དངོས་གྲུབ་སྒྲུབ་པར་བྱ་བ་ཡིན།",
    "ཐུགས་ཀྱི་ཡོན་ཏན་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་མཁྱེན་བརྩེ་ནུས་གསུམ་གྱི་ངོ་བོ་ཡིན་ལ།",
    "དེའི་ནང་ནས་ཀྱང་མཁྱེན་པའི་ཡོན་ཏན་མཐའ་དག་གཅིག་བསྡུས་ཀྱི་བདག་ཉིད་ཡིན་པས།",
    "རང་ཅག་རྣམས་ཀྱང་རྗེ་བཙུན་འཇམ་དཔལ་དབྱངས་ལ་བརྟེན་ནས་མཁྱེན་རབ་ཀྱི་ཡོན་ཏན་ཁྱད་པར་ཅན་མྱུར་དུ་ཐོབ་དགོས་པས།",
    "དེས་རྒྱུ་བྱས་ནས་གདུལ་བྱའི་དོན་བྱེད་པ་ལ་ཁྱད་པར་ཤིན་ཏུ་ཆེ་བ་ཡིན།",
    "དེའི་ཆེད་ཡི་དམ་ལྷ་འདི་དང་འདི་ལ་བརྟེན་ནས་གཞན་དོན་བསྒྲུབ་པར་བྱའོ་སྙམ་པ་དང་།",
    "དཀྱིལ་ཐང་ལ་ཉིས་བརྩེགས་སུ་གནང་བ་ཡང་དོགས་པའི་གནས་ལས།",
    "སྤྱི་བཀའ་དང་ཟུར་བཀའི་ཁྱད་པར་ཡོད་དམ་མེད།",
    "འགའ་ཞིག་ནི་འཇམ་དཔལ་གསང་ལྡན་ཟུར་བཀའ་མེད་གསུངས་ཚུལ་ཡོད།",
    "དེ་ལྟ་བུའི་ལམ་ལ་འབད་པར་བྱ་བའི་ཚེ།",
    "དེའི་ངོ་བོ་སྟོང་པར་ངེས་པ་དེ་ནི་བདེ་སྟོང་དབྱེར་མེད་བསྐྱེད་པ་ཡིན་ལ།",
    "ཕྱི་རོལ་དུ་གྲུབ་པར་འཛིན་པའི་སེམས་ཙམ་པའི་ལྟ་བ་དང་།",
    "ཡི་དམ་གྱི་ལྷ་ཁྱད་པར་ཅན་ཞིག་ལ་བརྟེན་ནས།",
    "དང་པོ་ལ་དམིགས་ནས་གདམས་ཚུལ་ཡོད་པར།",
    "མ་བསླབ་ན་དེར་བགྲོད་ཚུལ་གཞན་མེད་པས་ལམ་འོག་མ་འོག་མ་མ་བསླབ་པར་ལམ་གོང་མ་ཞི་གནས་དང་ལྷག་མཐོང་།",
    "གསང་སྔགས་ཀྱི་ལམ་ལྟ་བུར་འཇུག་པར་བྱ་བ་མི་ཡོང་བས།",
    "བཟློག་པའི་རིམ་པ་ཤེས་པའི་སྒོ་ནས་ལམ་གྱི་གོ་རིམ་མི་བཟློག་པར་འོག་མ་ནས་སློབ་འཇུག་དགོས།",
    "འཇིག་རྟེན་ན་དྲེགས་པ་ལྷ་དང་ཀླུ་དྲི་ཟ་གནོད་སྦྱིན་སོགས་ཀྱི་རང་ལུས་ལ་མི་གཙང་བར་རྟོགས་པ་ནི་ཤིན་ཏུ་དཀའ་བས་ན།",
    "སྐྱེས་བུ་ཆུང་ངུའི་ལམ་ལ་རིམ་པར་མ་སྦྱངས་པར་བློ་ཁ་ཕྱིར་བལྟས་ཀྱི་བསམ་པ་ཙམ་གྱིས་གར་ཡང་མི་སླེབ་པས་ན་བློ་ཁ་ནང་དུ་བལྟ་དགོས།",
    "དབྱངས་ཅན་མ་རྣམས་ཀྱང་ངོ་བོ་ཐ་དད་པ་མ་མཆིས་པས་དེ་ཁོ་ན་ཉིད་རྟོགས་པའི་ཤེས་རབ་དེ་དང་དེའི་རྣམ་པར་བསྟན་ནས།",
    "བྱང་སེམས་ཀྱི་རྩ་ལྟུང་ཉེས་བྱས།",
    "སྔགས་ཀྱི་སྡོམ་པ་དང་ལྡན་ན་སོ་ཐར་བྱང་སེམས་ཀྱི་སྡོམ་པའི་མི་མཐུན་ཕྱོགས་ཀྱིས་མི་གོས་པར་བསྲུང་དགོས་པའི་དོན་ཡིན།",
    "དེ་ན་སྡོམ་པ་གསུམ་གྱིས་མི་མཐུན་ཕྱོགས་དང་མ་འབྲེལ་བའི་སྒོ་ནས་རྣམ་པར་དག་པ་ཞིག་བསྲུང་ནས་ཐབས་ཤེས་ཟུང་དུ་འབྲེལ་བའི་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་ལ་བསླབ་སྟེ།",
    "ཡེ་ཤེས་རང་སྣང་ལས་གྲུབ་པའི་དཀྱིལ་འཁོར་མངོན་སུམ་དུ་བཞུགས་ཡོད་སྙམ་པ་དགོས་གསུངས།",
    "དེའི་ཆེད་ཡི་དམ་གྱི་ལྷ་འདི་ལ་བརྟེན་པར་བྱའོ་སྙམ་པ་དང་།",
    "དེ་ལྟར་སྙིགས་མའི་དུས་སུ་དམུ་རྒོད་པའི་གདུལ་བྱ་རྣམས་གདུལ་བའི་ཆེད་ཁྲོ་བོའི་རྣམ་པར་བསྟན་པ་ཡིན་པས།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རིགས་མ་ཚང་བ་ལྟ་བུ་ཡོད་ཀྱང་གཙོ་བོ་འོད་དཔག་མེད།",
    "རིགས་རྣམ་སྣང་དུ་བྱས་ནས་དེའི་དམ་ཚིག་བསྲུང་བ་ལས།",
    "རིགས་ལྔ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་ཁྱད་པར་མེད་པར་བསྲུང་དགོས།",
    "ལུས་ཐ་མལ་གྱི་སྣང་ཞེན་མེད་པར།",
    "གསང་སྔགས་ཀྱི་སྡོམ་པའི་རྟེན་དུ་བྱང་སྡོམ་ངེས་པར་སྔོན་དུ་འགྲོ་དགོས་པ་བཞིན་དུ་བྱང་སྡོམ་ལ་རབ་སོ་ཐར་གྱི་སྡོམ་པ་བརྟན་པོ་དགོས་པ་ཡིན་འདྲ།",
    "རྩ་ལྟུང་སོགས་ཀྱིས་ཀྱང་སྡོམ་པ་གཏོང་ན་བྱང་སྡོམ་མེད་པར་སྔགས་སྡོམ་གནས་པ་ཨེ་ཡོད།",
    "བྱང་སྡོམ་ལ་བརྟེན་ནས་སྔགས་སྡོམ་སྐྱེ་ཡང་གནས་པ་ལ་སྔགས་སྡོམ་གྱི་༧༨ན་རྟེན་བྱང་སྡོམ་དགོས་མིན་སོགས་དཔྱོད་རྒྱུ་ཡོད་པ་གསུངས།",
    "ཀུན་སློང་ཞན་པ་སོགས་ཡོད་སྲིད་པས་གཞན་ལ་ཕན་ཐོགས་མེད་པར་མ་ཟད།",
    "འཆད་ཉན་སོགས་ཀྱི་རྟེན་དུ་འགྱུར་བར་གསུངས་པས།",
    "འོན་ཀྱང་རྩ་ལྟུང་འབྱུང་མི་སྲིད་པར་ཁས་བླངས་དཀའ།",
    "རང་ཉིད་གཅེས་པར་འཛིན་པའི་བློ་དགྲར་མཐོང་ནས་བདག་མེད་པ་དང་།",
    "བྱང་སེམས་གཉིས་གཅེས་པར་འཛིན་པའི་སྒོ་ནས་ལམ་ལ་སློབ་དགོས་པ་ཡིན།",
    "མ་བརྟགས་མ་དཔྱད་པར་བསམ་པའི་ཚེ་དགོས་པ་ཡོད་པར་དྲན་པ་ཞིག་འབྱུང་ཡང་།",
    "སྟོབས་བཞིའི་བཤགས་སྡོམ་བྱེད་པ་གལ་ཆེ་བ་ཡིན།",
    "དེ་ལྟར་མ་ཡིན་པར་གྲགས་འདོད་ཀྱི་སྒོ་ནས་ཤེས་རབ་ཆེ་བ་སོགས་འདོད་ན།",
    "དེ་ལ་བརྟེན་ནས་བསླབ་པ་གསུམ་གྱི་བསྟན་པ་འཕེལ་བའི་ཆེད་དུ་དམིགས་ནས་བྱས་ན།",
