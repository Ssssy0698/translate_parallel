    "དེ་ལ་གལ་ཏེ་ས་བོན་དང་ཤིང་ལྗོན་པ་དང་བུ་དག་གཞན་ཉིད་ཡིན་པར་གྱུར་ན་འཇིག་རྟེན་གྱི་ཐ་སྙད་དེ་དག་མི་སྲིད་པར་འགྱུར་བ་ཞིག་ན་སྲིད་པས་དེའི་ཕྱིར་ས་བོན་དང་མྱུ་གུ་གཉིས་གཞན་ཉིད་དུ་བརྗོད་པར་མི་ནུས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་ས་བོན་ཡོད་པ་ཉིད་ཡིན་ན་འགག་པར་འགྱུར་གྱིས་མེད་ན་མི་འགྱུར་བས་འདི་ཡང་སྐྱེ་བ་སྔ་ལ་འགག་པ་འཕྱི་བར་འགྱུར་རོ།",
    "སྐྱེ་བའང་སྲིད་པར་མི་འགྱུར་རོ།",
    "ཞེས་གསུངས་སོ།",
    "དེའི་ཕྱིར་སྐྱེ་བ་དང་འགག་པ་གཉིས་ལ་སྔ་ཕྱིའི་རྣམ་པར་བཞག་པ་མེད་པས་ཅིའི་ཕྱིར་འགག་པ་སྔར་བཀག་ལ་སྐྱེ་བ་ཕྱིས་བཀག་ཅེས་བྱ་བ་དེ་ཀླན་ཀར་མི་རུང་ངོ།",
    "དེ་གཉིས་ལ་སྔ་ཕྱིའི་རྣམ་པར་བཞག་པ་མེད་པ་དེ་ཉིད་རབ་ཏུ་བསྟན་པའི་ཕྱིར་སློབ་དཔོན་གྱིས་འདིར་འགག་པ་སྔར་གཟུང་བ་མཛད་ལ་སྐྱེ་བ་ཕྱིས་བརྟགས་སོ།",
    "སྐྱེ་བ་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཞེས་ངེས་པར་འཛིན་པར་བྱེད་དོ།",
    "དེ་དག་ནི་གཞན་ཡིན་པར་མི་འཐད་དོ།",
    "དེ་ལྟ་བས་ན་རྒྱུ་ལ་སོགས་པ་རྐྱེན་རྣམས་མྱུ་གུ་ལ་སོགས་པ་དངོས་པོ་རྣམས་ལས་གཞན་ཉིད་ཡིན་པར་མི་འཐད་དོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ནི་གཞན་གྱི་གཞུང་ལུགས་ཀྱང་ངེས་པར་གཟུང་བའི་ཕྱིར་ཏེ།",
    "དེས་ན་གཞན་གྱི་གཞུང་ལུགས་དག་ལ་ཡང་དངོས་པོ་རྣམས་སྐྱེ་བ་མི་འཐད་པར་རབ་ཏུ་བསྟན་པ་ཡིན་ནོ།",
    "མ་ཡིན་ཏེ་དངོས་པོ་རྣམས་ཀྱི་སྐྱེ་བ་འདི་བརྟག་པར་བྱའོ།",
    "གཉི་ག་ལ་ཡོད་པར་གྱུར་ན།",
    "འདི་ལྟར་མིག་ལ་སོགས་པ་ནི་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་བྱ་བའི་རྐྱེན་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྐྱེ་བ་ཡིན་ནོ།",
    "འདི་ལྟར་མིག་ལ་སོགས་པ་ནི་རྣམ་པར་ཤེས་པ་སྐྱེ་བའི་བྱ་བ་དེ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རྐྱེན་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱང་རྣམ་པར་ཤེས་པ་ལ་འཇུག་གོ་ཞེས་ཟེར་བ་ནི་བྱ་བ་བརྟགས་ན་མི་འཐད་པས་མིག་ལ་སོགས་པ་དག་དེ་སྒྲུབ་པར་བྱེད་པ་ཡིན་པར་ག་ལ་འགྱུར།",
    "གནས་མེད་པ་ལ་མི་འཇུག་པས་རྣམ་པར་ཤེས་པ་མ་སྐྱེས་པ་དེ་ཡང་མེད་པ་ཡིན་ལ།",
    "དེ་མེད་ན་སྐྱེ་བའི་བྱ་བ་དེ་ལ་གནས་པ་ཡོད་པར་ག་ལ་འགྱུར།",
    "རྣམ་པར་ཤེས་པ་སྐྱེས་པ་ལ་ཡང་སྐྱེ་བའི་བྱ་བ་མི་འཇུག་སྟེ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེས་ཟིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལ་འདི་སྙམ་དུ་རྣམ་པར་ཤེས་པ་སྐྱེ་བཞིན་པ་ལ་སྐྱེ་བའི་བྱ་བ་ཡོད་པར་སེམས་ན།",
    "སྐྱེས་པ་དང་མ་སྐྱེས་པ་མ་གཏོགས་པར་སྐྱེ་བཞིན་པ་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱེ་བ་དང་མ་སྐྱེས་པ་གཉིས་ལ་སྐྱེ་བའི་བྱ་བ་མི་འཇུག་པར་ནི་བསྟན་ཟིན་པས་དེའི་ཕྱིར་སྐྱེ་བའི་བྱ་བ་མེད་དོ།",
    "དེ་ལ་འདི་སྙམ་དུ་རྐྱེན་དང་མི་ལྡན་པའི་བྱ་བ་ཡོད་པར་སེམས་ན།",
    "གལ་ཏེ་ཡོད་པར་གྱུར་ན་རྟག་ཏུ་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་འགྱུར་རོ།",
    "མིག་ལ་སོགས་པ་ནི་སྐྱེ་བའི་བྱ་བ་སྒྲུབ་པར་བྱེད་པས་རྣམ་པར་ཤེས་པའི་རྐྱེན་དུ་འགྱུར་ན།",
    "སྐྱེ་བའི་བྱ་བ་དེ་མི་འཐད་པར་ནི་སྔར་རབ་ཏུ་བསྟན་ཟིན་ཏོ།",
    "དེ་མེད་པའི་ཕྱིར་དེ་སྒྲུབ་པར་བྱེད་པ་ཡོད་པར་ག་ལ་འགྱུར།",
    "དེ་སྒྲུབ་པར་བྱེད་པ་མེད་པའི་ཕྱིར་མིག་ལ་སོགས་པ་སྐྱེ་བར་བྱ་བའི་རྐྱེན་མ་ཡིན་ནོ།",
    "བྱ་བ་མེད་ན་ཇི་ལྟར་རྐྱེན་རྣམས་བྱ་བ་དང་ལྡན་པར་འགྱུར།",
    "བྱ་བ་དང་ལྡན་པ་ཡང་མེད་པས་དེའི་ཕྱིར་རྐྱེན་དུ་རྣམ་པར་བརྟག་པ་ནི་དོན་མེད་པ་ཉིད་དོ།",
    "རྐྱེན་ཉིད་དེ་ལ་ཡང་རྐྱེན་ཡོད་པར་འགྱུར་ཞིང་།",
    "འདི་ལྟར་སྣམ་བུ་མེད་པའི་རྐྱེན་རྒྱུ་སྤུན་དག་ཡིན་ནོ་ཞེས་བསྟན་པར་མི་རིགས་སོ།",
    "ཞེས་བྱ་བ་འདི་ཉེ་བར་གནས་པ་དེའི་ཚེ་དངོས་པོ་ཕྱིས་སྐྱེ་བར་འགྱུར་བ་དེ་ལ་ལྟོས་ནས་ཁྱེད་ཀྱི་རྐྱེན་འགྲུབ་པར་འགྱུར་བ་གང་ལ་ཡོད།",
    "ཞེས་བསྟན་པར་མི་རིགས་སོ།",
    "ཁོ་བོ་སྐྱེས་པ་ལ་ཡང་རྐྱེན་གྱི་བྱ་བ་ཡོད་དོ་ཞེས་མི་སྨྲ་སྟེ་འོན་ཀྱང་སྣམ་བུ་ཡོད་པའི་རྐྱེན་རྒྱུ་སྤུན་ཡིན་པར་ཐ་སྙད་འདོགས་པར་བྱེད་པས་སྣམ་བུ་དེའི་རྐྱེན་རྒྱུ་སྤུན་དག་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་དེ་འཐད་པར་འགྱུར་རོ།",
    "རྒྱུ་ནི་སྒྲུབ་པར་བྱེད་པའོ།",
    "ད་ནི་མེད་པ་ཡང་སྒྲུབ་པར་མི་བྱེད་དེ་མེད་པའི་ཕྱིར་རོ།",
    "ཡང་ན་ཅི་ཞིག་བྱས་ན་རྒྱུའི་རྒྱུ་ཉིད་དུ་འགྱུར།",
    "འདི་ནི་མ་ཡིན་ནོ་ཞེས་བྱེ་བྲག་བསྟན་པ་དེ་ཡོད་པར་ག་ལ་འགྱུར།",
    "དེ་ལྟ་བས་ན་མེད་པ་ཡང་སྒྲུབ་པར་མི་བྱེད་དོ།",
    "ད་ནི་ཡོད་མེད་ཀྱང་སྒྲུབ་པར་མི་བྱེད་དེ།",
    "དེ་ལྟར་ན་ཡོད་མེད་ཀྱང་སྒྲུབ་པར་མི་བྱེད་དོ།",
    "དེ་ལྟར་ཡིན་ན་སྒྲུབ་པར་བྱེད་རྒྱུ་ཞེས་བྱ་བ་དེ་མི་རིགས་སོ།",
