    "ཅེས་པ་འདི་ཡང་རབ་བྱུང་བཅུ་བདུན་པའི་ས་འབྲུག་པོའི་༡༩༨༨དབྱར་ཟླ་ཐ་ཆུང་གི་ཉེར་བདུན་ཉིན་རབ་བཟང་སྡིངས་སུ་སྤྲོ་གསེང་ལོཐེག་སྐབས།",
    "ཉེ་གནས་སྟོབས་ཚང་བསམ་འགྲུབ་སོགས་དད་འདུན་ཅན་དུ་མའི་འདོད་མོས་ལྟར།",
    "རང་ཉིདསྐདཅིག་གིས་དཔལ་རྡོ་རྗེའཇིགས་བྱེད་ཀྱི་སྐུར་བཞེངས་པར་གྱུར།",
    "སྟོང་བའི་ངང་ནས་བསང་རྫས་རྟེན་རྫས་རྣམས་རང་གི་མིང་ཡིག་དང་པོ་ཐིག་ལེས་བརྒྱན་པ་ཞུ་བ་ལས་བྱུང་བའི།",
    "ཁྱད་པར་ས་ཆ་ཡུལ་ཕྱོགས་འདི་དག་གི།",
    "རྣལ་འབྱོར་བདག་གིས་ཡིད་ཆེས་བརྟན་པའི་མཐུས།",
    "མིག་གི་ཡུལ་དུ་མཛེས་པའི་གཟུགས་ཀྱི་མཆོག།",
    "ལུས་ལ་རེག་ན་བདེ་བར་རེག་བྱའི་མཆོག།",
    "ཅེ་སྤྱང་འཕར་བ་སྟག་གཟིག་གཅན་གཟན་དང་།",
    "ཁུ་བྱུག་འཇོལ་མོ་ལ་སོགས་སྤྱན་གཟིགས་དང་།",
    "དམ་རྫས་སྤྱན་གཟིགས་མཆོད་གཏོར་འདི་བཞེས་ལ།",
    "སྐྱེ་དགུའི་ཕན་བདེའི་རེ་བ་རྒྱལ་བའི་བསྟན།",
    "ཡིད་འོང་འཇོ་སྒེག་ལང་ཚོ་ཀུན་དགའི་དཔྱིད།",
    "ཤིས་བརྗོད་དབྱངས་དང་འབྲེལ་བའི་བསྟོད་ཚིག་གིས།",
    "སྔོན་གྱི་སློབ་དཔོན་ཆེན་མོའི་མཛད་པའི་བརྔོན་ཆོག་རྣམས་ལ་གཞི་བྱས་ཏེ་ཤཱཀྱའི་བཙུན་པསྟོད་རྒྱུད་མཁན་ཟུར་ནོར་བུ་སྤྲུལ་མིང་གིས་སྦྱར་བའོ།",
    "ན་མོ་གུ་རུ་བཛྲ་ར་ཡ།",
    "འདིར་ལྷུན་པོ་དཔལ་བརྩེགས་ལ་གནས་པའི་གཞི་བདག་གི་བསང་མཆོད་བྱེད་པར་འདོད་པས།",
    "བསླུ་མེད་སྐྱབས་གཅིག་མ་གི་ཥཱ་ཡའི།",
    "རྣམ་གསུམ་དབྱེར་མེད་ཞབས་པད་གཙུག་གིས་མཆོད།",
    "བདག་གིས་དད་གུས་སྔགས་དང་ཏིང་འཛིན་གྱིས།",
    "ནམ་ཡང་རེ་ཞིང་ལྟོས་ཚེ་འཕྲིན་ལས་བཞི།",
    "མཐར་ཐུག་དོན་གཉིས་ལྷུན་གྱིས་འགྲུབ་ཅེས་ལྷུན་པོདཔལ་བརྩེགས་ལ་གནས་པའིགཞི་བདག་གི་བསང་མཆོད་ལེགས་ཚོགས་ཀུན་འགྲུབ་ཅེས་བྱ་བ་འདི་ནི།",
    "ན་མོ་གུ་རུ་བཛྲ་པཱ་ཀྵྀ་ཡ།",
    "འོ་མ་དང་ཆུ་གཙང་གི་བསྲུས་པའི་ཟན་ལ།",
    "གཞན་རྔ་རོལ་དུང་དང་སིལ་སྙན་སོགས་རོལ་མོ།",
    "སྔོན་དུ་འགྲོ་བའི་ཡི་དམ་གང་རུང་གི་བདག་བསྐྱེད་དམ།",
    "ཅེས་པ་དང་སྔགས་དྲུག་ཕྱག་དྲུག་གིས་བྱིན་གྱིས་བརླབས་ལ།",
    "དུ་བའི་སྤྲིན་ཚོགས་ལྷ་ལམ་ཁྱོན་གང་བ།",
    "དབྱངས་སུ་སྒྲོག་པའི་རོལ་མོའི་ཚོགས་ཀྱིས་མཆོད།",
    "བདག་གིས་བསམ་པའི་སྟོབས་དང་ནི།",
    "རེ་ལྟོས་གུས་མཆོད་ལྷུར་ལེན་བདག་ཅག་ལ།",
    "དཀར་གསལ་ལང་ཚོ་རྫོགས་པ་མཛེས་པའི་སྐུ།",
    "མོས་ལྡན་དོན་སྤུབ་ཚེ་བརྟན་སོགས་སྦྱིན་བདག་རྣམས་ཀྱིས་བསྐུལ་བའི་ངོར།",
    "བསང་བདུག་བྱ་ཞིང་ཆུ་གཙང་བྲན་ལ་སྤྱན་གཟིགས་གང་འབྱོར་བཤམས།",
    "སིལ་སྙན་དུང་སོགས་རོལ་མོ་དང་སྤྲོ་ན་གར་རོལ་སོགས་ཀྱང་བྱ།",
    "བདག་གིས་མཆོད་ཅིང་བསྟོད་པའི་གནས་མཆོག་འདིར།",
    "རྣམ་དཀར་མོས་པ་སྔགས་དང་ཏིང་འཛིན་གྱིས།",
    "མཆོག་གསུམ་བདེན་པ་གཟུངས་སྔགས་མོས་པའི་མཐུས།",
    "སྣ་ཚོགས་རོལ་མོ་སིལ་སྙན་གླུ་དབྱངས་སོགས།",
    "མོས་ལྡན་བདག་ཅག་དཔོན་སློབ་འདིར་འཁོད་རྣམས།",
    "དུས་ཀྱི་སྦྱོར་བ་བཟང་བོར་བདག་ཅག་གི།",
    "རིན་ཆེན་སྣོད་ཡངས་སྟོང་གི་ཁྱོན་མཉམ་དུ།",
    "འོ་མའི་རྒྱུན་གྱི་འདོད་འཇོ་ཞོལ་མོའི་ཚོགས།",
    "བདེ་བ་མཆོག་སྟེར་བཙུན་མོ་རིན་ཆེན་དང་།",
    "མཆོད་གཏོར་སྤྱན་གཟིགས་ཆས་གོས་བཞོན་པ་སོགས།",
    "གཡུ་འབྲུག་སྔོན་མོའི་སྟེང་ན་རབ་ཏུ་འགྱིང་།",
    "སྙན་བརྗིད་འབུད་དཀྲོལ་རོལ་མོའི་བྱེ་བྲག་བཅས།",
    "དཀོར་ཆ་སྤྱན་གཟིགས་མཐུན་རྫས་མ་ཚང་མེད།",
    "སྒྲ་སྙན་རྐང་གླིང་རོལ་མོའི་ཚོགས་རྣམས་འབུལ།",
    "སྟོབས་ལྡན་ལ་བསང་བརྔོན་གྱི་ཆོ་ག་འདོད་དོན་འགྲུབ་པའི་གླུ་དབྱངས། ། ན་མོ་གུ་རུ་བཛྲ་དྡྷ་ར་ཡ།",
    "ཡི་དམ་གང་རུང་གི་རྣལ་འབྱོར་རྒྱས་པའམ།",
    "སྤྲོ་ན་སྔགས་དྲུག་ཕྱག་རྒྱ་དྲུག་གིས་བྱིན་གྱིས་བརླབས།",
    "རོལ་མོའི་དབྱངས་དང་བཅས་འདི་ལྟར།",
    "རོ་བརྒྱའི་ཟས་དང་གདངས་སྙན་རོལ་མོའི་ཚོགས།",
    "ཏ་ལའི་འདབ་མ་རྒྱས་པའི་བསང་ཤིང་ཚོགས།",
    "ན་བུན་ཕུང་བོ་འཐིབས་པའི་བསང་གིས་མཆོད།",
    "པ་སངས་ལྟར་དཀར་ལྷ་ལུག་ཞོལ་ཕོ་མོ།",
    "བཟོད་པར་བཞེས་ནས་རྣལ་འབྱོར་བདག་ཅག་གི།",
    "བདག་གི་ཕྱུག་གཡང་སྤེལ་ཕྱིར་གཤེགས་སུ་གསོལ།",
    "གནས་འདིར་བསང་གི་མགྲོན་དུ་སྤྱན་དྲངས་ན།",
    "ན་མོ་གུ་རུ།",
    "སྤྱན་གཟིགས་གང་འབྱོར་རྒྱས་པར་བཤམས།",
    "དུང་དཀར་རྔ་སིལ་སོགས་རོལ་མོ་རྣམས་སྟ་གོན་བྱས་ཏེ།",
    "ཨོཾ་སརྦ་བིད་གུ་ར་གུ་ར་གུ་ར་གུ་ར་སོགས་སྔགས་དྲུག་ཕྱག་དྲུག་གིས་བྱིན་ཀྱིས་བརླབས།",
    "དྲི་བཟང་གིས་བསྒོས་སྤོས་ཆབ་བྱུགས་པ་དང་།",
    "རྔ་སིལ་དུང་དཀར་སྙན་པའི་རོལ་མོ་སོགས།",
    "རེག་བྱ་མཆོག་གིས་བདེ་སྟེར་ལྷ་ཡི་གོས།",
    "ཡིད་འོང་རོལ་མོའི་ཆ་བྱད་གླུ་གར་དང་།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་མཆོག་གྱུར་པའི།",
    "ཞོལ་གཡག་ཕོ་མོ་སྲུང་རྟགས་དར་ཚོན་མཛེས།",
    "ཐིག་ལེ་རི་མོར་མཛེས་པའི་སྟག་གཟིག་གུང་།",
    "རྒྱུན་བཟང་ཆུ་ཀླུང་ཚོགས་རྣམས་ཕྱོགས་ཀུན་འབབ།",
    "རེས་འགའ་དཔའ་གཏུམ་ཉམས་ལྡན་ཀླུ་མ་བཙན།་",
    "ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པ་དང་།",
    "སྟོང་གསལ་མཁའ་ལ་སྤྲིན་བཞིན་མོས་སྟོབས་ཀྱིས།",
    "དམ་རྫས་སྤྱན་གཟིགས་མཆོད་གཏོར་གསེར་སྐྱེམས་སོགས།",
    "གནམ་ས་བར་སྣང་ཁྱོན་ཀུན་གང་བ་འདིས།",
    "སྟག་གཟིག་དོམ་དྲེད་སོགས་གཅན་གཟན་རིགས།",
    "མདའ་མདུང་མཚོན་ཆ་གོ་ཁྲབ་སོགས་སྤྱན་གཟིགས་སྣ་ཚོགས།",
    "འཛམ་བུའི་ཤིང་གིས་མཚན་པའི་མ་",
    "བདག་ཅག་མོས་པའི་མཆོད་སྤྲིན་བསྟར་བའི་དབུས།",
    "ཁང་བཟང་རིན་ཆེན་རྒྱ་ཕིབས་ཏོག་གིས་མཛེས།",
    "སྔགས་དྲུག་གིས་བྱིནགྱིས་བརླབས་ཏེ་འབུལ་བ་ནི།",
    "གང་གྲའི་སྲིང་མོ་ཀླུང་ཆེན་འཇུ་ལག་འགྲམ།",
    "སྐད་ཅིག་ཉིད་ལ་མིང་གི་ལྷག་མར་མཛོད།",
    "སྒྲ་འཛིན་དཔྱིད་གྱུར་རོལ་མོའི་དབྱངས་སྙན་སྒྲོག།",
    "ནོར་འཛིན་བུ་མོའི་བཞིན་རས་འདར་བྱེད་ཅིང་།",
    "གོང་མོ་ངང་ངུར་མཐིང་རིལ་བྷ་མ་ར།",
    "ཏིང་འཛིན་གཟུངས་དང་རིག་སྔགས་མོས་པའི་སྟོབས།",
    "ལྕགས་རི་དཀར་བོའི་ཁྱོད་ཀུན་འགེངས་པར་མཛོད།",
    "གང་གི་མཐུ་སྟོབས་རྟ་བདུན་རོལ་བ་ཡིས།",
    "མོས་པའི་ཞིང་ལ་འདོད་པའི་ཆར་བ་འབེབས།",
    "དབུ་ལ་དངུལ་དཀར་རྨོག་མོ་རྒོད་འཕུ་ལྡེམ།",
    "གདུག་ཅན་སྲོག་གི་སྤུ་གྲི་འཇིགས་པའི་གཟུགས།",
    "རྣམ་དཔྱོད་སོར་མོའི་འཕྲུལ་གྱི་འཕེན་མཁས་པ།",
    "ཕན་དང་བདེ་བའི་དབྱིག་གི་ཆར་འབེབས་པ།",
    "རྐྱེན་ངན་བར་ཆད་མིང་གི་ལྷག་མར་མཛོད།",
    "མཐུ་སྟོབས་རྫུ་འཕྲུལ་དཔུང་གིས་སྟོབས་བསྐྱེད་དེ།",
    "འཇིག་རྟེན་བདེ་ཞིངསོགས་ཤིས་བརྗོད་ཅིརིགསབརྗོད་དེ་མེ་ཏོག་གི་ཆར་དབབ་པར་བྱའོ།",
    "ཀ་དད་ཅན་འགའ་ཞིག་གིས་བསྐུལ་པ་དང་།",
    "བདེ་ལྡན་ཞིང་གི་མགོན་པོ་འོད་དཔག་མེད།",
    "དཔའ་རིས་ནོར་འཛིན་ཐིག་ལེ་བྱེ་བྲག་གི།",
    "སྲིད་འདིར་མཐོ་བའི་ནོར་འཛིན་སྒེག་མོ་ཡི།",
    "གནས་འདིར་བསང་གི་མགྲོན་དུ་སྤྱན་དྲངས་ན།",
    "གསེར་གཡུའི་རྒྱ་བབས་ཏོག་གིས་མཛེས་པ་ཡི།",
    "དུང་གླིང་རྔ་སིལ་རོལ་མོ་ཕྱོགས་ཀུན་འཁྲོལ།",
    "བདེན་པ་མ་མཐོང་སྐྱེ་བོ་བདག་ཅག་གིས།",
    "རྫུན་གྱི་རི་མོ་ཇི་སྙེད་ཤར་བ་ལས།",
    "ན་མོ་གུ་རུ་བཛྲ་དྡྷ་ར་ཡ།",
    "སྟོང་བའི་ངང་ལས་རང་རང་གི་མིང་ཡིག་དང་པོ་ཐིག་ལེས་བརྒྱན་པ་ཞུ་བ་ལས་བྱུང་བའི་བསང་རྫས་རྣམས་དང་མཆོད་གཏོར་སྤྱན་གཟིགས་དང་།",
    "གསང་གསུམ་ཡོན་ཏན་དྲན་པས་མོས་གུས་ཀྱིས།",
    "བསང་དུད་རོལ་མོ་དང་བཅས།",
    "བསྟན་དང་བསྟན་འཛིན་ནོར་བུའི་རྒྱན་ཕྲེང་གིས།",
    "རྣམ་པར་སྒེག་པའི་ངོ་མཚར་འབུམ་ཕྲག་གི།",
    "བསང་མཆོད་འཕྲིན་ལས་སྤེལ་བཞིན་བདག་ཅག་གིས།",
    "བར་ཆད་ཀུན་སེལ་བདེ་སྟོང་ལམ་བཟང་གི།",
    "ནང་གི་འཁོར་ཚོགས་དྲེགས་པ་ཐམས་ཅད་བསང་།",
    "བཀྲ་ཤིས་རྟགས་རྫས་སྤྱན་གཟིགས་མཆོད་སྤྲིན་གྱིས།",
    "གཟུངས་རིགས་མོས་པའི་འབྲུག་སྒྲ་བཞད་པ་ཡིས།",
    "རོ་བརྒྱའི་ཞལ་ཟས་སྣ་ཚོགས་རོལ་མོའི་སྒྲ།",
    "འདོད་པའི་བདེ་སྟེར་འཇམ་མཉེན་རེག་ལྡན་གོས།",
    "ཤྭ་བ་དུང་གི་རྭ་བཅུ་དགུང་དུ་རྒྱས།",
    "སྤྲང་རྩིའི་ཆང་གིས་མྱོས་པའི་ཟློས་གར་རྩེ།",
    "འཇིགས་རུང་རི་མོ་རྣམ་བཀྲ་སྟག་གཟིག་གུང་།",
    "རྩེད་འཇོས་དགའ་བསྐྱེད་སྤྲ་སྤྲེའུ་དྲེད་མོང་སོགས།",
    "ཏིང་འཛིན་གཟུངས་དང་རིག་སྔགས་མོས་པའི་སྟོབས།",
    "འདོད་འཇོའི་བ་དང་རེ་སྐོང་དཔག་བསམ་ཤིང་།",
    "མཆོག་དང་ཐུན་མོང་འདོད་དགུའི་དངོས་གྲུབ་སྩོལ།",
    "སྣང་དགྲ་གནོད་བྱེད་ཐལ་བའི་རྡུལ་དུ་རློགས།",
    "རྩེ་མོ་འོད་གསལ་ཉི་ཟླའི་ལམ་དུ་བསྙེགས།",
    "གཞོང་བའི་རེ་འདོད་སྐོང་བ་ཁྱེད་ལ་བསྟོད།",
    "རེས་འགག་ཟ་འོག་འབོལ་སྟན་བརྩེགས་པའི་ཁྲིར།",
    "འགྱུར་མེད་རྡོ་རྗེའི་རི་མོ་གཙུག་རྒྱན་དུ།",
    "དེ་ཕྱིར་མགྲིན་པ་ངག་གི་ལོངས་སྤྱོད་ཀྱི།",
    "དཀར་གསུམ་མངར་གསུམ་གཙོ་བོར་གྱུར་བའི་མཆོད་གཏོར་སྤྱན་གཟིགས་སོགས་ཅི་འབྱོར་བཤམས།",
    "ས་ཆེན་ཁྱོན་ལྟར་ཡངས་པའི་སྣོད་བཟང་བོར།",
    "རྣམ་ཀུན་གྲགས་པའི་ལྷ་ཀླུ་གཞི་བདག་གིས།",
    "སྔགས་དྲུག་དང་ཕྱག་རྒྱ་དྲུག་གིས་བྱིན་གྱིས་བརླབས་ལབདེན་སྟོབས་བརྗོད།",
    "སྣ་ཚོགས་མོས་པའི་ཁམས་དང་བསམ་པ་བཞིན།",
    "འདི་སྣང་བདེ་བར་འཁྲུལ་བའི་འཆིང་ཐག་གིས།",
    "ཁྱད་པར་འཛམ་གླིང་ཡངས་པའི་བྱང་གི་ཕྱོགས།",
    "རབ་དཀར་ཆུ་འཛིན་གློག་གི་རོལ་གར་དང་།",
    "འཁོར་དམག་དཔུང་ཚོགས་དང་བཅས་གནས་འདིར་བྱོན།",
    "རྣར་སྙན་ཡིད་འབབ་རོལ་མོའི་འབྲུག་སྒྲ་སྒྲོག།",
    "འབར་བའི་མེ་དང་དྲི་ཞིམ་བསང་གི་རྫས།",
    "དེ་ལྟར་བསང་མཆོད་ཕུལ་ནས་བསང་བརྔོན་གཏོང་བར་འདོད་པས་གྱེར་དབྱངས་རོལ་མོབཅས་བསང་དུད་ཆེར་བཏང་ལ།",
    "ས་དང་བར་སྣང་ནམ་མཁའི་ཁྱོན་བཀང་བས།",
    "སྣང་གསལ་དྲི་ཆབ་ཞལ་ཟས་རོལ་མོའི་སྒྲ།",
    "རིན་ཆེན་དང་གིས་མཛེས་པའི་རྒྱལ་མཚན་དང་།",
    "ས་དང་བར་སྣང་ནམ་མཁའི་ཁྱོད་བཀང་བས།",
    "ཟ་འོག་རྒྱལ་མཚན་རྩེ་མོའི་ཏོག་བཞིན་དུ།",
    "དགེ་མཚན་བྱེ་བའི་འོད་ཀྱིས་ཁྱོན་འགོངས་པ།",
    "ཚངས་ལ་མ་ནོར་དགེ་ལྡན་ལུགས་བཟང་གི།",
    "འགྲོ་བའི་ཕན་བདེ་མོག་པོར་བྱས་པ་ཡི།",
    "ཤིས་བརྗོད་པ་ཅི་རིགས་བྱས་ཏེ་མེ་ཏོག་གི་ཆར་དབབ་པར་བྱའོ།",
    "རང་རངགི་མིང་ཡིག་ལས་བྱུང་བའི་བསང་རྫས་རྣམསདང་མཆོད་གཏོར་བརྔན་ཆས་གསེར་སྐྱེམས་སོགས་བཟའ་བཅའ་བཏུང་བའི་བྱེ་བྲག་སྣཚོགས་པ་མཆོད་ཡུལསྤྱི་དང་ཁྱད་པར་ཡུལསྐྱོངཆེན་པོ་དགེ་ལེགས་རབ་བརྟནའཁོར་དང་བཅས་པ་དགྱེས་པ་བསྐྱེད་པའི་མཆོད་སྦྱིན་བསམ་གྱིས་མི་ཁྱབ་པ་འཛད་པ་མེདཔ་ནམ་མཁའ་མ་ཛོད་ཀྱི་རང་བཞིན་ཅན་དུ་གྱུར།",
    "རང་བྱུང་མིག་གི་བདུད་རྩིར་འདོད་པར་འཇོ།",
    "གདངས་སྙན་རོལ་མོའི་བྱེ་བྲག་ཀུན་གྱིས་མཆོད།",
    "ཕྱི་ཡི་སྤྱན་གཟིགས་རྟ་གཡག་ར་ལུག་བྱ།",
    "ནང་གི་ཆས་གོས་བཞོན་པ་ཕྱག་མཚན་རྒྱན།",
    "གསེར་འོད་གློག་གི་རྩེ་དགའ་དང་འགྲོགས་པའི།",
    "སྔོན་དུས་རང་གིས་ཁས་བླངས་དམ་བཅའ་དང་།",
    "དགུང་སྔོན་དབྱིངས་ནས་དག་པའི་ལྷ་མིག་གིས།",
    "གང་གིས་བཞེད་པ་ཇི་བཞིན་འགྲུབ་པར་མཛོད།",
    "གཞན་ཕན་བསམ་པ་མཆོག་གིས་རང་གཞན་གྱི།",
    "རྣམ་དཀར་སྣང་བ་དཀར་བོས་འཇིག་རྟེན་ཁྱོད།",
    "ཚངས་པ་ཆེན་པོ་དུང་གི་ཐོར་ཚུགས་ཅན།",
    "ས་དང་བར་སྣང་ཁྱོན་ཀུན་བཀང་སྟེ་འབུལ།",
    "བཀའ་གཉན་ཚངས་པ་དུང་གི་ཐོར་ཚུགས་ཅན།",
    "ཕྱེ་མར་ཞོ་འོ་མ་ཇ་ཕུད་ཆང་དཀར་མོ་ལགགཡས།",
    "མཆོད་གཏོར་སྤྱན་གཟིགས་རྣམས་ལ་དམིགས་ཏེ་མཐ་ཏས་བསངས།",
    "ཞེས་པ་ལན་གསུམ་དང་སྒྲོ་ན་སྔགས་དྲུག་དང་ཕྱག་རྒྱ་དྲུག་གིས་ཀྱང་བྱིན་གྱིས་བརླབས།",
    "བདགགི་བསམ་པའི་སོགས་ཀྱིས་བདེན་སྟོབས་བརྗོད།",
    "རབ་བརྗིད་ལྷུན་ཆགས་རྩེ་མོ་མཁའ་ལ་བསྙེགས།",
    "བརྒྱ་བྱིན་གྲོང་གི་ངོ་མཚར་ལ་འགྲན་པ།",
    "དཀར་གསལ་ཟླ་བ་རྒྱས་པའི་ཞལ་བཟང་གི།",
    "དགྱེས་པའི་འཛུམ་སྟོན་ཞི་བའི་གཟིགས་སྟངས་མཛད།",
    "རེས་འགའ་ཁྲོ་དང་ཆགས་དང་སྒེག་པའི་གར།",
    "གདུང་དབྱངས་གཡབ་དར་རོལ་མོས་འབུལ་ལགས་ན།",
    "སྟེང་གི་ལྷ་དང་འོག་གི་ས་བདག་ཀླུ།",
    "རོལ་མོའི་སྒྲ་སྒྲོག་ཞལ་ཟས་སྣ་ཚོགས་བཤམས།",
    "དཀར་མོ་ལག་གཡས་ཕྱེ་མར་བཤོས་བུ་སོགས།",
    "རྔ་དུང་ཆ་ལང་ལ་སོགས་རོལ་མོའི་སྒྲ།",
    "ཁྲི་སྟན་བླ་རེ་བ་དན་རྒྱལ་མཚན་འབུལ།",
    "བདེ་ཆེན་བསྐྱེད་པའི་བཙུན་མོ་རྣམ་བཞི་བསང་།",
    "བདག་ཅག་རེ་འདོད་ཡིད་སྡུསན་བསྐང་བར་མཛོད།",
    "རྟག་ཏུ་ནམ་མཁའི་མཐོངས་ནས་ལྷ་མིག་གིས།",
    "ཡོན་ཏན་རྒྱ་མཚོ་མཆོག་གི་བཀྲ་ཤིས་ཤོག།",
    "ཀུ་སྭ་མི་སྙམ་བཛྲ་ཡིས་རབ་བྱུང་བཅུ་གསུམ་པའི་ཆུ་མོ་གླང་གི་ལོར་རང་གི་སྐྱེས་ཡུལ་དུ་བསྐྱོད་སྐབས།",
    "སིལ་སྙན་སྣ་ཚོགས་རོལ་མོའི་གྱེར་དབྱངས་དང་།",
    "ཅང་ཤེས་རྟ་དང་ཞོལ་ཕོ་ཞོལ་མོ་དང་།",
    "ཆ་བྱད་བསང་དང་གོ་མཚོན་སྤྱན་གཟིགས་དང་།",
    "ཕ་རོལ་འཇོམས་པའི་རྭ་གདེང་ཞོལ་ཕོ་མོ།",
    "ཟ་བྱེད་འབར་བའི་དཔུང་གི་ཚོགས་དང་བཅས།",
    "ཤ་ཟའི་རིགས་ཅན་མཐའ་དམག་དཔུང་གི་ཚོགས།",
    "ས་གསུམ་དགྲ་བགེགས་མིང་གི་ལྷག་མར་མཛོད།",
    "ཆའཛམ་གླིང་ནོར་འཛིན་ཡངས་པའི་བྱང་གི་ཕྱོགས།",
    "ཐམས་ཅད་བསང་གི་མགྲོན་དུ་སྤྱན་དྲངས་ན།",
    "ལྷ་མིའི་མནོལ་གྲིབ་སེལ་བྱེད་བསང་གི་རྫས།",
    "ཨོཾ་ཏཱ་རེ་ཏུ་",
    "རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "བཀའ་གདམས་ལྷ་བཞིའི་ནང་གི་སྒྲོལ་མའི་གཟུངས།",
    "སྟག་དོང་གཟིག་ཐུབས་འཁོར་གསུམ་ཆས་ཀྱིས་སྒེག།",
    "ཉམས་དང་འགྱུར་བ་སྟོང་གིས་བཞུགས་པ་ལ།",
    "རང་གི་ཐུགས་ཀུའི་ཧཱུཾ་ཡིག་འོད་ཟེར་གྱིས།",
    "རེག་པའི་མོད་ལ་མདུན་གྱི་ནམ་མཁའ་རུ།",
    "གདུགས་དང་རྒྱལ་མཚན་བླ་རེ་གོ་མཚོན་རྟ།",
    "རྫོགས་ལྡན་དབྱར་གྱི་དགའ་མའི་ལང་ཚོ་བཞིན།",
    "ཡིད་བཟང་སྲས་པོའི་དཔུང་ཚོགས་བཀྲ་ཤིས་བོམ་སྔོན་གྱི་བསང་མཆོད། ། རང་ཉིད་ལྷའི་ང་རྒྱལ་དང་ལྡན་པས་བསང་རྫས་བྱིན་གྱིས་བརླབས་ལ།",
    "གཡུ་འབྲུག་སྔོན་མོའི་གདན་སྟེང་ན།",
    "ཡུམ་མཆོག་ཀླུ་མོ་ཡིད་འོང་མ།",
    "གདངས་སྙན་རོལ་མོ་སྣ་ཚོགས་འཁྲོལ།",
    "གཡུ་འབྲུག་སྔོན་མོ་རྫུ་འཕུལ་ཅན།",
    "རྩེ་མོར་གནས་བཅས་ལྷ་གཉན་དྲག་རྩལ་ཅན།",
    "ཡུམ་མཆོག་ཀླུ་ཡི་བུ་མོ་ཡིད་འོང་མ།",
    "ཡིད་ལྟར་མགྱོགས་པས་བསང་གི་མགྲོན་དུ་བྱོན།",
    "རྟ་ནོར་ར་ལུག་ལ་སོགས་སྤྱན་གཟིགས་རིགས།",
    "གིས་བདུད་རྩིར་བྱིན་བརླབས་པའི།",
    "པ་འདི་ནི་སྟོབས་ཚང་ཕུན་ཚོགས་ཚེ་རིང་གིས་རྩོམ་སྐུལ་ཞུས་པ་ལྟར།",
    "སྟག་ལུང་ཞྭ་དམར་ཕྱོགས་ཀྱི་གཞི་བདག་གི་བསང་བསྔོན།",
    "འཚོ་བའི་སྲོག་གི་བཅུད་ལེན་གྱུར་པ་ཡི།",
    "མཆོད་གཏོར་དམ་རྫས་སྤྱན་གཟིགས་སྣ་ཚོགས་ཀྱིས།",
    "དེ་ཡང་སྤྱན་གཟིགས་རྟེན་དང་མཐུན་རྫས་མཆོད་གཏོར་གསེར་སྐྱེམས་རྣམས་ཕྱག་ལེནལྟར་བཤམས།",
    "ནམམཁའ་མཛོད་ཀྱི་སྔགས་རྒྱ་དང་སྔགས་དྲུག་ཕྱག་དྲུག་གིས་བྱིན་གྱིས་བརླབས་ལ་འདི་སྐདདོ།",
    "རྩེ་མོ་རབ་དཀར་གངས་རི་བརྗིད་ཆགས་པ།",
    "ལྷ་སྲིན་དྲེགས་པའི་ཚོགས་ཀྱི་དམག་གི་དཔུང་།",
    "དཔའ་བའི་སྲས་དགུ་མཛངས་མའི་སྲས་མོ་དགུ།",
    "མདའ་དར་སྟག་གཟིག་གུང་གསུམ་བསགས་པའི་ཚོགས།",
    "ནག་པོ་དགྲ་དང་བགེགས་ཀྱི་དཔུང་ཚོགས་ཆོམས།",
    "གི་བསྒྱུ་ཆེའོ་ལྷ་རྒྱལ་ལོ།",
    "ཡིད་འཕྲོག་སྒེག་མོ་མཛེས་པའི་ཆས་ཀྱིས་བརྒྱན།",
    "ལྷ་ཡི་སྲས་དང་སྲས་མོ་བཅོ་བརྒྱད་དང་།",
    "མཆོག་དཀར་སྲ་བའི་གཞུ་ལྡན་གཟིག་ཐུབས་བཅིངས།",
    "ཆིབས་སུ་གསེར་གྱི་ཤ་བ་ཡུ་མོ་བཅིབས།་",
    "ཕྱག་ན་གནམ་ལྕགས་ཐོག་གི་མདའ་གཞུ་བསྣམས།",
    "ཕྱག་ན་སྟག་གི་ལྤགས་པའི་རྒྱལ་མཚན་འཛིན།",
    "གཉན་ཆེན་ཐང་ལྷས་གཡུ་འབྲུག་སྔོན་མོ་བཅིབས།",
    "ལན་ལྔའམ་བདུན་གང་རུང་གིས་གཏོརམ་འབུལ།",
    "རྣམ་འདྲེན་ཐམས་ཅད་གཟིགས་པའི་སྤྱན་སྔ་རུ།",
    "རྒྱུན་བཟང་ཆུ་ཀླུང་ཚོགས་རྣམས་ཕྱོགས་ཀུན་འབབ།",
    "མཆོད་ཅིང་བསྟོད་ན་ཁས་བླངས་ཡུལ་ལྷ་རྨ་རྒྱལ་སྦོམ་རའི་བསང་མཆོད། ། ཆམ་རི་རབ་དཀར་གངས་རིའི་རྩེ་མོ་ནས།",
    "གནོད་བྱེད་དགྲ་བགེགས་ཐལ་བའི་རྡུལ་དུ་རློགས།",
    "དགེ་ལྡན་ནོར་བུའི་གླིང་གི་གཡོན་རྒྱབ་ཀྱི།",
    "སྤང་རི་མཐོན་པོ་རྩེ་མོ་མཁའ་ལ་བསྙེགས།",
    "གཡས་པའི་ཕྱག་གིས་མདུང་རིང་མཁའ་ལ་འཕྱར།",
    "རྗེས་སུ་སྟག་གཟིག་དོམ་དྲེད་རོལ་དུ་ཁྲིད།",
    "ཡུམ་མཆོག་ཀླུ་མོ་དུང་སྐྱོང་འབྲུག་ལ་བཅིབས།",
    "སྒོ་ཕྱུགས་གཅན་གཟན་ལ་སོགས་སྤྱན་གཟིགས་ཚོགས།",
