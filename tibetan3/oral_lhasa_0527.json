    "དེང་ནས་བཟུང་སྟེ་བྱིན་གྱིས་བརླབ་ཅིང་དངོས་གྲུབ་སྦིན་པར་བྱའོ་གསུངས།",
    "སྔགས་བདག་ཁྱབ་འཇུག་རྡོར་ལེགས་སོགས་ཀྱི་སྒྲུབ་ཐབས་མན་ངག་ཡོངས་རྫོགས་གནང་སྟེ་བསྟན་པའི་རྒྱལ་ཚབ་ཆེན་པོར་མངའ་གསོལ།",
    "ཁྱད་པར་སྐབས་འགར།",
    "དམ་ཅན་རྣམས་ཀྱིས་རང་གཟུགས་བསྟན་ནས་ཅི་བགྱིའི་བཀའ་ཉན་པར་ཞལ་གྱིས་བཞེས།",
    "དམ་ཅན་བྱིས་པ་གཡུ་རྣ་ཅན་དུ་སྤྲུལ་ནས་ཉིན་བཞིན་བཟོ་བོའི་གྲོགས་བྱས།",
    "སླར་ཡང་དེ་འདྲ་མང་པོ་ཁ་གསོས་ཏེ་མནན་པར་བརྩམ་པ་ན།",
    "མཆིམས་ཕུ་ནས་ཟབ་གཏེར་གྱི་ཤོག་དྲིལ་འགའ་ཞིག་སྤྱན་འདྲེན་པ་གནང་།",
    "ལྷ་སར་བྱོན་ནས་ཇོ་བོ་མཇལ་དུས་ཇོ་བོའི་མཛོད་སྤུ་ནས་འོད་ཟེར་སྤྲོས་ཏེ་རྗེ་ཉིད་ཀྱི་མཛོད་སྤུར་ཐིམ་པས་བྱ་རྒོད་ཕུང་པོ་དང་།",
    "བསྟན་བཅོས་རྩོམ་དགོས་ཚུལ་སོགས་བཀའི་གནང་བ་ཐོབ་ཚུལ་ཐ་དག་ནི་བརྗོད་དུ་མི་ལང་ངོ།",
    "ངས་དབུས་གཙང་འདིར་འཁྲུག་པ་ཆེན་པོ་གཅིག་བྱེད་བསམས་ཀྱང་།",
    "མཁས་པ་ཀུན་ཞལ་འཆམ་པར།",
    "ད་ལྟ་དབུས་གཙང་གཉིས་ལ་བསམ་ཡས་པ་ལས་མཁྱེན་རབ་རྒྱས་པ་མི་བཞུགས་ཞེས་འཇམ་དཔལ་གྱི་སྤྲུལ་པར་ངེས་ཤེས་རྙེད་ནས་གཙུག་ཏུ་བཀུར་བས་གནས་སྐབས་འཁྲུག་པ་ཞི་བས་སྐྱེ་དགུ་བདེ་སྐྱིད་ཀྱི་དཔལ་ལ་སྦྱོར་བ་དང་།",
    "རྒྱ་མར་ཕེབས་ཏེ་ཞག་ཤས་སུ་བཞུགས།",
    "དེ་ནས་བསམ་ཡས་སུ་བྱོན་ནས་བཞུགས།",
    "དེ་ནས་མཆིམས་ཕུར་ཕེབས་ནས་འདི་རྒྱ་གར་དུར་ཁྲོད་བསིལ་བའི་ཚལ་དང་མཚུངས་པ་ཡིན་པས།",
    "སྒྱུ་ལུས་འདི་དུར་ཁྲོད་ཆེན་པོ་འདིར་འཇོག་པ་ཡིན་གསུངས་ནས།",
    "ངེད་རྣམས་འདིར་ཅུང་ཞིག་སྡོད་པར་ཞུས་པས།",
    "ལོག་པར་ཐོས་པ་དེ་བས་སྡིག་ཆེ་བས།",
    "གཞུང་བཟང་འདི་འདྲས་སྤྲོས་པ་མ་བཅད་ན།",
    "ཅིག་ཆར་ཐོས་པར་དཀའ་བ་མ་ཡིན་ནམ།",
    "བརྒྱ་ཕྲག་གཞུང་ལ་ཅིག་ཆར་སྦྱངས་པར་འགྱུར།",
    "སྣང་བ་གུ་ཡངས་གང་ལྟར་བྱས་ཀྱང་ཆོག།",
    "ནམ་ཡང་འདི་དང་འབྲལ་བར་མ་བྱས་ན།",
    "རྟོགས་པར་དཀའ་བ་རྟོག་གེའི་བསྟན་བཅོས་བཞིན།",
    "སྤྲོ་བ་མེད་ཀྱང་ཀུན་མཁྱེན་བརྒྱུད་པའི་གཞུང་།",
    "ཐོབ་པར་ངེས་ཀྱི་ངེས་ཤེས་ཡང་ཡང་སྐྱེད།",
    "ཀུན་མཁྱེན་གཞུང་ལས་བྱིན་བརྒྱུད་ཐོབ་པ་ཡིན།",
    "མཁྱེན་བརྩེའི་དཀྱིལ་འཁོར་གང་བས་མཛེས་བྱས་ཤིང་།",
    "དོན་གྱི་ཀུན་གཞི་རང་བཞིན་འདུས་མ་བྱས།",
    "མི་མཁས་བདེན་པར་ཞེན་པས་རྟག་ཏུ་འཁོར།",
    "ཇི་སྲིད་གཟུང་འཛིན་དབྱིངས་སུ་མ་ནུབ་པར།",
    "འཁྲུལ་པའི་སེམས་གདུལ་སླད་དུ་འབད་པར་མཛོད།",
    "མེད་སྣང་སྟོང་པའི་གཟུགས་བརྙན་ཤེས་པར་མཛོད།",
    "ཐོག་མ་གང་ལས་བྱུང་བ་བརྟག་པར་གྱིས།",
    "སྲིད་ནས་ཞི་བར་རབ་ཏུ་འདྲེན་པར་མཛད།",
    "དུས་རིང་ཐོག་མཐའ་མེད་པར་བཞུགས་པ་ལས།",
    "ཁྱད་པར་མི་མཇེད་འཇིག་རྟེན་དོན་མཛད་པ།",
    "དེ་ན་རྣམ་པར་སྣང་མཛད་གངས་ཆེན་མཚོའི།",
    "ཁྱད་པར་ཟེའུ་འབྲུ་དབུས་མའི་སྟེང་ཉིད་ན།",
    "བཅུ་དྲུག་རྡུལ་བྲལ་བཅུ་བདུན་དག་པར་སྣང་།",
    "མི་མཇེད་ཐུགས་ཀྱི་ཐུགས་ཏེ་ཁྱད་པར་ཞིང་།",
    "ཁྱད་པར་སྟོང་གསུམ་མི་མཇེད་འཇིག་རྟེན་འདིར།",
    "སྟོང་རྣམས་སོ་སོར་སེམས་བསྐྱེད་འཚང་རྒྱར་གསུངས།",
    "དེས་ན་ཚུལ་འདི་དོན་གྱི་དགོངས་པར་བཟུང་།",
    "ཞིང་དང་སྟོན་པར་སྤྲུལ་པས་འགྲོ་ཀུན་གྱི།",
    "འགྲོ་བའི་དོན་དུ་ཞིང་ཁམས་རྣམ་པར་བཀོད་པའི་ལེའུ་སྟེ་གཉིས་པའོ།",
    "ཁྱད་པར་མི་མཇེད་འཇིག་རྟེན་བསྟན་པ་ནི།",
    "ཆུར་ནི་སུམ་འགྱུར་ཀུན་ལ་ཤེས་པར་བྱ།",
    "ཆུ་ཡི་ནང་དུ་རི་གླིང་ཀུན་མཚུངས་པར།",
    "དབུས་ན་རྣམ་པར་རྒྱལ་བའི་ཁང་བཟངས་མཆོག།",
    "འཕངས་སུ་ཕྱེད་དང་གསུམ་སྟེ་གསེར་ལས་བྱས།",
    "ལོངས་སྤྱོད་དགའ་བ་ལྷག་པར་འཕེལ་བ་ཡིན།",
    "རིན་ཆེན་སྐྱེད་ཚལ་རྫིང་བུ་ཆུ་བྱས་གང་།",
    "དེ་ཉིད་འོད་ཀྱིས་ཕྱོགས་རྣམས་གསལ་བར་བྱས།",
    "རྫོགས་བྱེད་ལྷ་ཡི་ལས་ཀྱིས་རྫོགས་བྱས་པས།",
    "བཟོད་པར་དཀའ་དང་རྟ་མཆོག་རབ་མྱུར་རོ།",
    "འཕགས་པའི་གནས་གཞན་གཙང་རིས་རྣམ་ལྔའོ།",
    "འོག་མིན་བར་དུ་མཐོ་ཁྱད་ཤེས་པར་བྱ།",
    "ནམ་མཁར་བརྟེན་ནས་རིམ་པར་གནས་ཚུལ་ནི།",
    "པདྨ་རྣམ་པར་བརྩེགས་པའི་ནམ་མཁའ་ལ།",
    "སྤྲིན་ཆེན་རྣམ་པར་རོལ་པའི་ནམ་མཁའ་ལ།",
    "བརྟེན་པར་བསྟན་པས་ཡོད་ན་མིང་བཞི་ཡི།",
    "ཉིན་མཚན་ལ་སོགས་དུས་ཚིགས་ཡོད་པར་གྱུར།",
    "དེ་ནས་ལེ་ལོས་གསོག་འཇོག་བྱས་པ་ཡིས།",
    "བྲམ་ཟེ་ཞེས་གྲགས་གཙང་སྦྲ་སྤྱོད་པ་བྱུང་།",
    "འཇིག་རྟེན་ཆགས་པའི་བསྐལ་པ་ལགས་པར་གསུངས།",
    "བར་བསྐལ་ཉི་ཤུ་རང་བཞིན་གནས་པར་འདོད།",
    "ཉི་ཤུ་པར་གྱུར་མ་བྱིན་ལེན་སྤངས་པས།",
    "འཁོར་གྱི་དངོས་པོ་བརྒྱད་ལ་སོགས་པར་གྲགས།",
    "དེ་ལྟར་གནས་ཚེ་ཁྱད་པར་གཞན་བསྟན་པ།",
    "ཆེད་དུ་བྱས་པའི་གནས་ཀྱང་མཚུངས་པ་ཉིད།",
    "གཞན་གསུམ་མཚུངས་པར་བསམ་གཏན་སྐྱེ་བ་ནི།",
    "འོད་གསལ་ལྷར་སྐྱེས་གླིང་རྣམས་སྟོངས་པར་གྱུར།",
    "བསམ་གཏན་གཉིས་པ་ཐོབ་པར་བསྒྲགས་པའི་སྒྲ།",
    "འོད་གསལ་ལྷར་སྐྱེས་ཚངས་གནས་སྟོངས་པར་གྱུར།",
    "རིམ་གྱིས་ཆུ་ཐིགས་གཅིག་ཀྱང་མེད་པར་བྱེད།",
    "ཐམས་ཅད་ལྷག་མ་མེད་པར་སྲེག་པ་ཡིན།",
    "བསམ་གཏན་གཉིས་པ་མན་ཆད་ཞིག་པར་འགྱུར།",
    "བསམ་གཏན་གསུམ་པ་མན་ཆད་ཞིག་པར་འགྱུར།",
    "མི་བརྟན་མེད་པར་འགྱུར་བའི་སྐབས་ཡོད་ན།",
    "ཚེ་རིང་བསྐལ་པར་གནས་པ་དེ་ཡོད་ཀྱང་།",
    "ཁྱད་པར་རི་རབ་རྩེར་གནས་ལྷ་རྣམས་ཀྱི།",
    "རྩེ་དགའི་དུས་སྟོན་ཉིན་མཚན་ཕྱད་པར་སྤྱོད།",
    "རི་རབ་ཆུ་མཚམས་ཐུག་པར་བསུ་བ་ལས།",
    "རྟག་ཏུ་འབྲལ་མེད་སྐྱོ་ངལ་མེད་པར་བསྟེན།",
    "གོང་མ་མཉེས་བྱས་གྲུབ་ཐོབ་བརྒྱུད་པ་འཛིན།",
    "ཕྱག་བཞེས་མཐོང་བས་དོན་གཉིས་སྒྲུབ་ལ་མཁས།",
    "རབ་ཏུ་གུས་པ་ཆེན་པོས་བསྟེན་པར་བྱ།",
    "འབྲལ་མེད་རྒྱུན་དུ་བསྟེན་པར་གདམས་པ་ཡང་།",
    "གང་ན་བཞུགས་པའི་ཡུལ་ཕྱོགས་དེར་བགྲོད་དེ།",
    "ཐོག་མ་ཉིད་ནས་མཉེས་བྱས་ཡང་དག་བཙལ།",
    "རྙེད་ནས་སྐྱོ་ངལ་མེད་པར་བསྟེན་བྱ་སྟེ།",
    "དེ་སླད་དམ་པ་རྣམས་ལ་བསྟེན་པར་བྱ།",
    "གཞན་དུ་མི་བགྲང་འགྱོད་པར་ཡོང་མི་བྱ།",
    "བཞུད་ཚེ་མ་གནང་མདུན་འགྲོས་ཞབས་རྗེས་བརྫི།",
    "སྐུ་ལ་ཚད་འཇལ་ན་བཟའ་བཞུགས་གདན་འགོང་།",
    "རྗེས་བཟུང་འགྲོ་བ་གཞན་ལའང་གུས་པར་བྱ།",
    "མ་དད་ལོག་པར་ལྟ་དང་ཁོང་ཁྲོ་དང་།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་ཡོན་ཏན་བསམ་བྱས་ལ།",
    "དམ་པའི་གོ་འཕང་ཐོབ་པར་བྱེད་དོན་དུ།",
    "ཀུན་སྤྱོད་སྐལ་བ་ངན་པ་འགོས་པར་འགྱུར།",
    "གཏན་གྱི་བདེ་བ་འཕྲོག་པར་ཡོང་མི་ནུས།",
    "སྐྱེ་བོ་དེ་ནི་བདུད་ཀྱིས་བསླུས་པ་ལགས།",
    "དེ་ནས་རིམ་པར་ཁྲིད་པའི་ཚུལ་གྱིས་བཤད།",
    "མཎྜལ་ལ་སོགས་བཀོད་པས་བརྒྱན་པར་བྱ།",
    "སྐྱོན་རྣམས་སྤངས་ལ་གུས་པས་མཉན་པར་བྱ།",
    "མ་ཡེངས་གུས་པའི་ཚུལ་གྱིས་མཉན་པར་བྱ།",
    "ལྡན་བྱས་རབ་དྭང་གུས་པའི་ཡིད་ཀྱིས་མཉན།",
    "རྟག་པར་སྨྲ་སོགས་སྔོན་མཐའ་བཅོ་བརྒྱད་དང་།",
    "དམ་བཅའ་བཅུ་ལས་གྲོལ་བ་སྒྲུབ་པར་འདོད།",
    "མཁའ་ལྟར་ཁྱབ་བདག་ཁྱད་པར་དགུ་ལྡན་ཉིད།",
    "སྤྱི་དང་ཁྱད་པར་ཚུལ་གཉིས་རིམ་པ་ལས།",
    "དོན་སྣང་ཤེས་པར་འདོད་དང་མི་འདོད་ལས།",
    "ཁྲུས་དང་གཙང་སྦྲ་ཀུན་ཏུ་སྤྱོད་པ་ཡིས།",
    "རྗེ་ཁོལ་ལྟ་བས་དངོས་གྲུབ་ཐོབ་པར་འདོད།",
    "སྤྱོད་པའི་རྒྱུད་དུ་གཙང་སྦྲ་དག་དང་ནི་ སྤུན་གྲོགས་ཚུལ་གྱིས་དངོས་གྲུབ་འདོད་པ་ཡིན།",
    "རྣལ་འབྱོར་རྒྱུད་དུ་གཙང་སྦྲ་གྲོགས་ཙམ་ལ།",
    "གཉིས་མེད་བསྒོམས་པས་དངོས་གྲུབ་ཐོབ་པར་འདོད།",
    "གཞི་དང་ལམ་དང་འབྲས་བུའི་ཁྱད་པར་གྱིས།",
    "ཕྱི་ནང་གསང་བའི་རང་བཞིན་ཤེས་པར་བྱ།",
    "ཁྱད་པར་ཕུང་པོ་ཁམས་དང་སྐྱེ་མཆེད་ཀུན།",
    "བསྒོམས་པས་ཚེ་འདིར་དངོས་གྲུབ་ཐོབ་པར་བཞེད།",
    "བསམ་པའི་ཤེས་རབ་ངེས་པར་རྒྱུད་ལ་བསྐྱེད།",
    "ཁྱད་པར་བསམ་བྱ་རྣམ་པ་ལྔ་ཉིད་ལས།",
    "ཤིན་ཏུ་གྲངས་མང་རབ་ཏུ་བསམ་བྱས་ནས།",
    "དཀར་པོའི་ལས་འཕྲོ་སད་པར་བསྟན་པ་ཡང་།",
    "དལ་འབྱོར་དཔེས་མཚོན་རྙེད་པར་དཀའ་བ་ཡང་།",
    "དུག་སྦྲུལ་གཟེབ་བཞིན་ངེས་པར་སྤང་འཚལ་ལོ།",
    "དལ་འབྱོར་ཆུད་གསོན་ཕུང་ཁྲོལ་ལགས་པས་སྤང་།",
    "ཉིན་མཚན་ཀུན་ཏུ་དགེ་ལ་བརྩོན་པར་བྱ།",
    "དལ་འབྱོར་རྙེད་པར་དཀའ་བ་བསམ་པའི་ལེའུ་སྟེ་བཅུ་གསུམ་པའོ།",
    "དབུ་བ་རྡོས་འདྲའི་ལུས་ཀྱང་ཤེས་པར་གྱིས།",
    "ལོ་བརྒྱའི་ནང་དུ་ངེས་པར་མེད་པར་འགྱུར།",
    "གྲོང་རྣམས་སྟོངས་ཤིང་མེད་པར་གྱུར་པའི་དཔེས།",
    "འབྱོར་ཚེ་དྲེགས་པས་སྙེམས་པ་མེད་པར་མཛོད།",
    "བདག་བྱས་བཟུང་སྟེ་བཏང་བ་འགའ་ཡང་མེད།",
    "སྤྱོད་ལམ་ཀུན་ཏུ་འཆི་བ་དྲན་པར་བྱ།",
    "གོམས་པའི་ཚད་ནི་འདུས་བྱས་འཇིག་པར་མཐོང་།",
    "དགེ་ལ་རབ་བརྩོན་ཚེ་འདི་འཁྲུལ་པར་ཤེས།",
    "ཚེ་མི་རྟག་པར་བསམ་པའི་ལེའུ་སྟེ་བཅུ་བཞི་པའོ།",
    "ཚོགས་བསགས་དམ་པ་རྣམས་ཀྱི་ནོར་མཆོག་ལགས།",
    "འཆི་བ་བསམས་དང་ལས་འབྲས་ཡིད་ཆེས་བྱས།",
    "བདུད་ཀྱིས་བྱིན་བརླབས་དུས་སུ་འགྲིབ་པར་གསུངས།",
    "དགེ་ལེགས་མི་འགྲུབ་གཏན་དུ་སྲིད་པར་འཁྱམས།",
    "དད་པ་བསྐྱེད་པའི་ཐབས་ལ་འབད་པར་བྱ།",
    "ལོག་པར་གཡེམ་སྤངས་ཁྱིམ་ཐབ་དགྲ་ཟླ་མེད།",
    "འཁྱལ་པ་སྤངས་པས་ཚིག་བཟུང་འོས་པར་འགྱུར།",
    "མ་བྱིན་བླངས་པས་དབུལ་ཞིང་ཕོངས་པར་འགྱུར།",
    "ལོག་པར་གཡེམ་པས་ཁྱིམ་ཐབ་དགྲ་ཟླར་བཅས།",
    "འགྲོ་བ་རྣམས་ཀྱིས་ལེགས་པར་བསྒྲུབ་པ་ནི།",
    "ལས་མ་ཟད་པར་འཁྲུལ་སྣང་སྟོངས་མི་སྲིད།",
    "དགེ་ཚོགས་ལས་བྱུང་ཤེས་ནས་འབད་པར་མཛོད།",
    "ཤེས་རབ་ཡེ་ཤེས་ཚོགས་གཉིས་བསྟེན་པར་མཛོད།",
    "མྱུར་དུ་འདའ་བའི་ཐབས་ལ་འབད་པར་བྱ།",
    "མནར་མེད་བར་བསྐལ་གཅིག་ཏུ་གནས་པར་གསུངས།",
    "བློ་བཟང་རྣམས་ཀྱིས་བགྲོད་ཕྱིར་བརྩོན་པར་བྱ།",
    "ཉི་མཁའ་བཞིན་ཏེ་ལྷུན་གྲུབ་འདུས་མ་བྱས།",
    "མི་བདེན་བསླུ་ཕྱིར་ཀུན་རྫོབ་བདེན་པ་ལགས།",
    "འགྱུར་མེད་རང་བཞིན་དོན་དམ་བདེན་པར་འདོད།",
    "པད་ནང་སྐུ་འདྲར་མཁས་པས་ཤེས་པར་བྱ།",
    "རང་ལ་ཡོད་པའི་གནས་ལུགས་ཤེས་པར་མཛོད།",
    "དེ་ཕྱིར་གནས་ལུགས་འོད་གསལ་མཁྱེན་པར་མཛོད།",
    "གནས་སྐབས་དེ་གསུམ་མཚུངས་པར་སྐྱབས་སུ་འགྲོ།",
