    "ཀྱེ་མ་བད་ག་ཅག་དེ་ལས་ལེགས་པར་ཐར།",
    "བསྐལ་པ་བརྒྱད་ཅུར་ད་མྱལ་བར་གནས་པར་གྱུར།",
    "སྐྱབས་༦ཀྱང་མེད་དེ་དཔུང་གཉེན་མེད་པར་གྱུར།",
    "ཚུལ་མིན་སྤངས་ཏེ་ཡེ་ཤེས་སྦྱོར་གྱིས་ཤིགགང་ཞིག་བདག་ཉིད་བསླབ་པར་མི་འདོད་པ།",
    "རིགས་ངན་བུ་འདྲར་ང་རྒྱལ་སྤངས་བྱས་ལ།",
    "མྱུར་བ་ཁོ་ནར་འདོར་བར་འགྱུར་ཞེས་གསུངས་ས་སོ།",
    "ཡོ་བྱད་བསྙུངས་པར་སྟོན་པའོ།",
    "སྐད་ཅིག་གཅིག་ལ་ནི་༡རི་གཞན་དང་གཞན་ལ་བདག་ཉིད་སྟོན་པའོ་ཞེས་གསུངས་ས་སོ།",
    "ཡུལ་འཁོར་སྐྱོང་རྙེད་པ་དང་བཀུར་སྟི་ལ་ལྷག་པར་ཆ་གས་པ་ནི།",
    "ཡང་ས་རྣམས་སོ་ཞེས་གསུངས་སོ།",
    "སོ་སོ་སྐྱེ་བོ་ཡིན་པར་ཤེས་བཞིན་དུ་རྙེད་པ་དང་།",
    "བད་ག་ལ་བསྟོད་ཅིང་གཞན་ལ་སྨོད་པར་བྱེད་ན།",
    "ཕམ་པར་བྱས་ནས་ཉེ་བར་སྤྱད་པའི་ལོངས་སྤྱོད་དབྱིག་དང་།",
    "བཅོམ་ལྡན་འདས་མང་དུ་བསྐྱེད་ལགས་ས་སོ།",
    "བདེ་བར་གཤེགས་པ་མང་དུ་བསྐྱེད་ལགས་ས་སོ།",
    "སོ་སོའི་སྐྱེ་བོ་ཡིན་པར་ཤེས་བཞིན་དུ།",
    "ཐ་ན་བསོད་སྙོམས་ཅིག་ཙམ་ཡོངས་སུ་ལོང་ས་སྤྱོད་པར་བྱེད་ན།",
    "སྡོམ་པའི་གནས་བཀའ་སྩལ་པ་དེ་ནི་ངོ་མཚར་ལགས་ཏེ།",
    "སུ་ཞིག་འབྲས་བུ་མ་ཐོབ་པར་ཐ་ན་ད་ད་པས་སྩལ་བ།",
    "ཆབ་སྣོད་གང་ཙམ་ཡང་ལེན་པར་འགྱུར་ལགས།",
    "མགོ་དང་གོས་ལ་མེ་འབར་བ་ལྟ་བུས་གནས་པར་བྱ་ཞིང་།",
    "འབྲས་བུ་མ་ཐོབ་པར་ཐ་ན་དད་པས་སྦྱིན་པ་ཆུ་སྣོད་༡གང་ཙམ་ཡང་བླང་བར་མི་བྱའོ།",
    "ཕམ་པར་བྱས་ནས་ཉེ་བར་སྤྱོད་པའི་ལོངས་སྤྱོད་དབྱིག་ད་ང་།",
    "བཅོམ་ལྡན་འདས་མང་དུ་བསྐྱེད་ལགས་ས་སོ།",
    "བདེ་བར་གཤེགས་པ་མང་དུ་བསྐྱེད་ལགས་ས་སོ།",
    "སོ་སོའི་སྐྱེ་བོ་ཡིན་པར་ཤེས་བཞིན་དུ།",
    "ཕམ་པར་བྱས་ནས་ཉེ་བར་སྤྱད་པའི་ལོངས་སྤྱོད་དབྱིག་ད་ང་།",
    "བཅོམ་ལྡན་འདས་མང་དུ་བསྐྱེད་ལགས་ས་སོ་། བདེ་བར་གཤེགས་པ་མང་དུ་བསྐྱེད་ལགས་ས་སོ།",
    "སོ་སོའི་སྐྱེ་བོ་ཡིན་པར་ཤེས་བཞིན་དུ་དེ་རྙེད་པ་དང་།",
    "བ་ཡིན་པར་༢ཁས་འཆེ་བར་བྱེད་ཅིང་།",
    "ཐ་ན་བསོད་སྙོམས་ཅིག་༢ཙམ་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད་ན།",
    "ཕམ་པར་བྱས་ནས་ཉེ་བར་སྤྱད་པའི་ལོངས་སྤྱོད་དབྱིག་དང་།",
    "བཅོམ་ལྡན་འདས་མང་དུ་བསྐྱེད་ལགས་སོ།",
    "བདེ་བར་གཤེགས་པ་མང་དུ་བསྐྱེད་ལགས་ས་སོ།",
    "སོ་སོའི་སྐྱེ་བོ་ཡིན་པར་ཤེས་བཞིན་དུ།",
    "དགྲ་བཅོམ་པ་དཔེ་སྟོན་པ་ལྟར་དཔེ་སྟོན་པར་ཡང་བྱེད་ལ།",
    "ཐ་ན་གཞན་གྱིས་བྱིན་པའི་ད་ད་པས་བྱིན་པ་བསོད་སྙོམས་ཅིག་༢ཙམ་ཡོང་ས་སུ་ལོངས་སྤྱོད་པར་བྱེད་ན།",
    "གང་དུ་འགའ་ཞིག་ལ་སྨོན་པར་བྱེད་ན།",
    "ཆེར་ན་མྱ་ངན་ལས་འདས་པ་ལ་སྨོན་པར་བྱེད་ན་ཡང་།",
    "འོད་སྲུངས་དེ་དག་དབུགས་འབྱིན་པར་བྱེད་པ་བརྗོད་པར་བྱ་སྟེ།",
    "བསྐལ་པ་ལས་ལྷག་པར་བདེ་བའི་ཡོ་བྱད་ཐམས་ཅད་ཀྱིས་བཀུར་སྟིར་བྱས།",
    "ཡང་ད་ག་པར་ཞུགས་པ།",
    "པར་བདེ་བའི་༢ཡོ་བྱད་ཐམས་ཅད་ཀྱིས་བཀུར་སྟིར་བྱས།",
    "བསོད་སྙོམས་ཡོངས་སུ་ལོངས་སྤྱད་པ་དེའི་དོན་དེ་ཡོངས་སུ་ཉམས་པར་བྱེད་པ་དེ་ལྟར་ན་༤།",
    "ཕས་ཀྱི་ད་གྲས་ཀྱང་ཡོངས་སུ་ཉམས་པར་བྱེད་མི་ནུས་སོ་ཞེས་གསུངས་སོ།",
    "བཟའ་བ་བཏུང་བ་མ་མཆིས་ཆབ་ཚན་ནང་ན་བདག་གནས་ལགས།",
    "མཁས་ཤིང་གཙང་སྦྲ་སྤྱོད་ལམ་ལྡན།",
    "ཞེས་གསུངས་སོ།",
    "བདག་ནི་ནུས་པ་སྐལ་བ་དང་ལྡན་པ་ཤིན་ཏུ་སྟོབས་དང་ལྡན་པའོ་། བདག་ནི་དོན་དང་དོན་རྣམ་པར་ངེས་པ་ལ་མཁས་པའོ།",
    "ཡོ་བྱད་རྣམས་རྙེད་པར་གྱུར་ཅིག་སྙམ་དུ་གང་སེམས་ཀྱིས་རྟོག་ཅིང་།",
    "ཡང་དག་མིན་པའི་ངོ་བོའི་རྒྱགས་པས་ཆགས་པར་འགྱུར།",
    "ནམས་ཀྱང་དག་པར་འགྱུར་བ་མིན།",
    "འདི་ནི་དེ་བཞིན་གཤེགས་པ་ཀུན་གྱིས་མཁྱེན་པར་འགྱུར།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་དུ་འགྲོ་བར་བྱེད་པར་འགྱུར་རོ་ཞེས་གསུང་ས་ས་སོ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་དུ་འགྲོ་བར་བྱེད་པར་འགྱུར་ཏེ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་དུ་འགྲོ་བར་བྱེད་པར་འགྱུར་རོ།",
    "གྲོགས་པོ་དག་གཞན་ཡང་ཟས་གང་མ་བྱིན་པར་ལེན་པ་ཉིད་ད་དང་།",
    "གཞན་གྱི་ལོངས་སྤྱོད་རྣམ་པར་བཅོམ་པ་ཉིད་ད་དང་།",
    "སྤྱོད་ལམ་དག་པར་ཉེ་བར་སྟོན་པ་ཉིད་ད་དང་།",
    "གྲོགས་པོ་དག་གཞན་ཡང་གང་༢སྟོན་པ་མ་ཡིན་པར་སྟོན་པར་ཁས་འཆེ་བ་ཉིད་ད་དང་།",
    "དགེ་སྤྱོང་མ་ཡིན་པར་དགེ་སྤྱོང་དུ་ཁས་འཆེ་བ་ཉིད་ཀྱིས་ལོངས་སྤྱོད་པར་བྱེད་པ་སྟེ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་དུ་འགྲོ་བར་བྱེད་པར་འགྱུར་རོ།",
    "རྣམ་པར་སྒྲོགས་པའི་རྒྱལ་པོ་ཞེས་བྱ་བའི་དགེ་སློང་མང་དུ་ཐོས་པ།",
    "སྣ་ཚོགས་པ་གཏམ་པར་བྱེད་པ་༢སྤོབས་པ་བཟང་བ།",
    "ཡོ་བྱད་རྣམས་རྙེད་པར་ཡང་གྱུར་ཏོ།",
    "དེ་རྣམ་པར་སྒྲོགས་པའི་རྒྱལ་པོ་ལ་གཤེ་བར་བྱེད།",
    "བསྔགས་༥པ་ཡང་མ་ཡིན་པ་རྒྱས་པར་བྱེད་པར་གྱུར་ཏོ།",
    "འབྲས་བུ་ཐོབ་པ་ལས་ཡོངས་སུ་ཉམས་པར་གྱུར་ཏོ།",
    "དེ་དང་དེ་དག་དེར་ལོ་བྱེ་བ་ཕྲག་དྲུག་ཏུ་འཚེད་པར་གྱུར་ཏོ།",
    "འོད་སྲུངས་དེའི་ཚེ་དེའི་དུས་ན་དགེ་སློང་རྣམ་པར་སྒྲོགས་༐",
    "ལྷ་སྦྱིན་༢ནི་མི་ཆེན་པོའི་མཚན་སུམ་ཅུ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "འཇིག་རྟེན་མཁྱེན་པ།",
    "སྲིད་པར་ཀུན་ཏུ་སྦྱོར་བ།",
    "བཀའ་ཡང་དག་པས་སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འད་ས་པར་གྱུར་ཏོ།",
    "སྤྱོད་ལམ་དེ་ཉིད་ལ་ཡང་ད་ག་པར་བསྐུལ་ཏེ།",
    "དམིགས་པ་བུ་ཅན་གྱི་ལྟ་བ་ལ་ཡང་དག་པར་བསྐུལ་ལོ།",
    "དགེ་སློང་དེ་ནི་ཏིང་ངེ་འཛིན་ལ་མཁས་པར་གྱུར་ཏོ།",
    "སྦྱངས་པའི་ཡོན་ཏན་གྱི་སྡོམ་པ་ལྷུར་ལེན་པར་གྱུར་ཏེ།",
    "དགེ་སློང་སྤྱོད་པའི་བློ་གྲོས་གང་ན་གནས་པའི་གཙུག་ལག་ཁང་དེར་ཕྱིན་ནས་དེ་ན་༤གནས་པར་གྱུར་ཏེ།",
    "གྲོང་དུ་འགྲོ་ཞིང་དེ་དག་ཏུ་ཟས་ཀྱི་བྱ་བ་བྱས་ནས་ཕྱིར་འོང་བར་གྱུར་ཏོ།",
    "དེས་དེ་དག་ཏུ་རིགས་བརྒྱ་སྟོང་དུ་མ་དད་པར་བྱས་པར་གྱུར་ཏོ།",
    "དེའི་འཁོར་ཇི་སྙེད་པ་དེ་དག་ཀྱང་ཚུལ་ལ་མཁས་པར་གྱུར་ཏོ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་སྤྱོད་པ་རྣམ་པར་ད་ག་པས་༨དེའི་འཁོར་གྱིས་དེ་ཟེར་བ་ལྟར་མ་མཉན་ཏེ་༩།",
    "དེའི་འཁོར་རྣམས་ཀྱང་སྤྱོད་ལམ་ཐ་མལ་པ་ཅན་དུ་མཐོང་ནས་དེས་ཀྱང་དེ་ལ་མ་དད་པའི་སེམས་བསྐྱེད་༡པར་གྱུར་ཏེ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་དུས་གཞན་ཞིག་ན་དགེ་སློང་སྤྱོད་པའི་བློ་གྲོས་དེ་འཆི་བའི་དུས་བྱས་པར་གྱུར་ནས།",
    "དེ་དེ་ལྟར་འཆི་བའི་དུས་བྱས་པ་དང་།",
    "ཚེ་རབས་དྲུག་ཅུར་མི་སྙན་པར་བརྗོད་པ་ཐོབ་པར་གྱུར་ཏོ།",
    "ཚེ་རབས་སྟོང་ཕྲག་སུམ་ཅུ་རྩ་གཉིས་སུ་རབ་ཏུ་བྱུང་བ་ལས་ཕྱིར་བབས་པར་གྱུར་ཏོ།",
    "དེ་རབ་ཏུ་བྱུང་ནས་ལོ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་དྲུག་ཏུ་མགོའི་ཐོད་ལ་མེ་འབར་བ་ལྟར་རྣམ་པར་སྤྱད་ཀྱང་།",
    "དེའི་སྤྱོད་པ་ཐམས་ཅད་ལ་ཡིད་ཆེས་པར་བྱའོ།",
    "དེ་སྙམ་དུ་སེམས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་སུ་བདག་བསྲུང་བར་འདོད་པ་དེས་གཞན་སུའི་སྤྱོད་པ་ལ་༢༢ཡང་བརྟག་པར་མི་བྱའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཡང་མྱུར་དུ་འཐོབ་པར་འགྱུར་རོ་ཞེས་གསུངས་ས་སོ།",
    "ལོག་པར་ལྟ་བའི་ཁྱིམ་རྣམས་སུ་སྐྱེས་ས་སོ།",
    "ལྕེ་མེད་པར་གྱུར་ཏོ།",
    "དེ་ནི་ནམ་དུ་ཡང་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པར་བརྗོད་པར་མི་བྱ།",
    "དེ་ནི་གཟུགས་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱང་གཟུགས་མེད་པར་༢ཉེ་བར་འགྲོ་བར་བརྗོད་པར་མི་བྱའོ།",
    "ནམ་མཁའི་ཁམས་ཀྱི་གཟུགས་བསྟན་པར་འདོད་དུ་ཟད་ད་དོ།",
    "ཀླུའི་ཉེས་པ་གསུམ་གྱིས་༢ཀྱང་གོས་པར་མི་འགྱུར་ར་རོ།",
    "སྡུག་བསྔལ་རྣམས་ཀྱིས་ཟིལ་གྱིས་མི་ནོན་པར་བརྗོད་པར་བྱའོ་། རིགས་ཀྱི་བུ་འདི་ལྟ་སྟེ་དཔེར་ན།",
    "དེར་འཆི་བའི་དུས་བྱེད་པར་མི་འགྱུར་ར་རོ།",
    "བླངས་པས་༧ཀྱང་རྨོངས་པར་མི་འགྱུར་རོ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་དག་པར་བསྟན་པ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ།",
    "སྐྱེ་བོ་མང་པོ་ལ་༡ཡང་དག་པར་གཟེངས་བསྟོད་པ་སྐྱེ་བོ་མང་པོ་ལ་༢ཡང་དག་པར་དགའ་བར་བྱེད་པ་བྱུང་ནས།",
    "༡བསམ་གཏན་བཞི་ཡང་ཐོབ་པར་གྱུར་ཏོ།",
    "སྐྱེ་བོ་མང་པོ་རབ་ཏུ་དགའ་བར་བྱས་ཀྱང་།",
    "ང་ནི་ཚངས་པར་སྤྱད་ནས་ཡུན་རིང་བ་ཡིན་གྱི་དེ་ནི་གསར་བུ་སྟེ།",
    "བསྙེན་པར་རྫོགས་ནས་རིང་པོར་མ་ལོན་པ་ཡིན་གྱིས།",
    "དེ་ལྟར་ཡིད་ཆེས་པར་མ་བྱེད་ཅིག་ཅེས་ཟེར་ར་རོ།",
    "དགེ་སློང་འཚོ་བ་ཡོང་ས་སུ་དག་པ་དེ་ལ་སྐྱེ་བོ་དེ་དག་རབ་ཏུ་དད་པས་དེ་ལྟར་དེས་སྐྱེ་བོ་དེ་ད་ག་ལ་དབྱེ་ན་༧བྱས་ཀྱང་༐",
    "འཆི་བའི་དུས་བྱས་ནས།",
    "ཐམས་ཅད་དུ་ཡང་ལྕེ་མེད་པར་གྱུར་ཏོ།",
    "ལས་དེའི་རྣམ་པར་སྨིན་པས་ང་སྙིགས་མ་ལྔའི་དུས་ན།",
    "བུ་ཏྲ་ལས་དེའི་རྣམ་པར་སྨིན་པས་དུས་ཀྱི་སྙིགས་མའི་ཚེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་མཁྱེན་བཞིན་དུ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་ནི་ལས་ཀྱི་སྒྲིབ་པ་དེ་དང་ལྡན་པར་བདག་ཅག་ཉིད་ཀྱིས་མཐོང་ལགས་ས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་འདུ་ཤེས་བསྐྱེད་པ་མ་གཏོགས་པར་འདུ་ཤེས་གཞན་བསྐྱེད་པར་མི་བྱའོ།",
    "དེ་ལ་དགོང་ས་ཏེ་དེ་བཞིན་གཤེགས་པ་མི་འཁྲུགས་པས་ཐུགས་དམ་བཞེས་པ།",
    "ཏིང་ངེ་འཛིན་ཐོབ་པར་འགྱུར་བ་དེ་དག་ཐམས་ཅད་ནི་དེ་བཞིན་གཤེགས་པའི་མཐུས་ཐོབ་པར་གྱུར་༦ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་སྤངས་པར་འགྱུར་ར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་མཐུར་ཤེས་པར་བྱ་བ་ཡིན་ན།",
    "དེ་ནི་ལུང་མནོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "ཇི་ཙམ་དུ་མི་སྙན་པར་བརྗོད་པ་དེ་སྲིད་དུ་ལྕེའི་སྐྱེ་མཆེད་མེད་པ་ཐོབ་པར་འགྱུར་ར་རོ།",
    "ཀ་ཤི་ཀའི་རྒྱལ་པོ་གང་ཡིན་པས་མགོ་བྱིན་༡པར་གྱུར་པ་དེ་འཆལ་བའི་ཤེས་རབ་ཡིན་ནམ།",
    "གསོལ་པ་བཅོམ་ལྡན་འད་ས་དེ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་ས་སོ།",
