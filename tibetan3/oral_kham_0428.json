    "རི་སྒང་མ་གཏོགས་ཕྱོགས་བཞི་མཚམས་བརྒྱད་པོར་སྤྲིན་གྱི་ཕུང་པོ་སྙོམས་པོར་བཏིང་འདུག་པ་དེ་གྲངས་ལས་འདས་པའི་གཡང་དཀར་ཕན་ཚུན་གཏུགས་ཏེ་ཉལ་བ་དང་འདྲ་ལ།",
    "བྲག་སྐེད་ན་ཕར་ཚུར་ལ་མི་ཐར་བའི་བུག་པ་ཞིག་འདུག་འདི་ནི་ངག་རྒྱུན་དུ་གེ་སར་མདའ་ཤུལ་དུ་གྲགས་པ་དེ་ཡིན་ངེས་ལ།",
    "སབ་སིབ་ཀྱི་མཐོང་ཚད་ན་རྩྭ་ཐང་དང་ནམ་མཁའ་གཅིག་ཏུ་འབྲེལ་འདུག་འོན་ཀྱང་།",
    "བྱ་བྱེའུའི་སྙན་རན་ལ་ཉེ་བའི་ཉི་མས་ཉ་ཟླར་བསུ་མར་བཏང་བ་འཇེབས་ཀྱི་རོལ་དབྱངས་ཁྲོད་ན་རྫི་བོའི་གཞས་གླུ་ཡིན་འདུགདང་རྟ་ཕོའི་འཚེར་སྐད།",
    "ངེད་ཅག་ཧ་འཁུམ་ལ་རྒྱུན་མི་ཆད་པར་འགོས་ཤིག་ཅེས་སྐུལ་ཅང་འབྲལ་མི་འདོད་པའི་ངང་ནས་རི་ལས་འབབ་མ་བཏང་འདུག་ལ།",
    "ང་རང་དང་བར་ཐག་ཧ་ཅང་མི་རིང་བའི་ཀྱི་གླུ་དབྱངས་ལེན་བཞིན་ཕྱོགས་ཀུན་ཏུ་བསྐྱོད་པ་ན།",
    "དཀར་གསལ་ལེར་འགྱིང་ནས་འདུག་པས།",
    "ཇེ་མཛེས་དང་བཀྲག་མདངས་ཇེ་ཆེ་རུ་འགྱུར་བཞིན་འདུག།",
    "དེ་ལྟར་ཡུད་ཙམ་གྱིས་དཔེ་ཁང་དུ་འབྱོར་བ་ན་སྒོ་ལ་གཏད་བརྒྱབ་འདུག་པས་དེ་ལ་དོགས་པ་སྐྱེས།",
    "གདོན་འདྲེ་དཔེ་ཁང་དུ་མི་འདུག་པས།",
    "སྐབས་འགར་ང་རང་སེམས་སྐྱིད་པོ་རང་མ་བྱུང་ན།",
    "ངའི་སེམས་ལ་ང་དང་རུས་མཐུན་མིང་མཚུངས་ཀྱི་གྲོགས་པོ་དེས་ང་རང་དྲིན་གྱིས་བསྐྱངས་པ་ཡིན་པས།",
    "ཞིབ་འཇུག་བྱ་ཐབས་སོགས་ལ་མཁོ་བའི་ཆ་རྐྱེན་དཀའ་ངལ་ཆེ་བ་རྣམས་དེང་རབས་ཀྱི་འཕྲུལ་ཆས་ཅན་དང་རང་འགུལ་ཅན་དུ་འགྱུར་ཡོད་ན་ཡང་།་",
    "ཡི་སྒེར་གྱི་ཁྱིམ་ཚང་བཅས་སྐུ་དཔར་གང་ཡོད་ཀྱི་དཔར་ཐོ་མཛད་བྱང་མེད་པ་ཞིག་འདུག་པ་དེའི་ཁ་བྱང་དུ་ག་ངས་ཅན་གྱི་ལྗོངས་སུ་བཀའ་དང་བསྟན་བཅོས་སོགས་ཀྱི་གླེགས་བམ་པར་གཞི་ཇི་ལྟར་ཡོད་པ་རྣམས་ནས་དཀར་ཆག་པར་ཐོར་ཕྱོགས་ཙམ་དུ་བཀོད་པ་ཕན་བདེའི་པད་ཚལ་བཞད་པའི་ཉིན་བྱེད་ཅེས་འཁོད་ཡོད།",
    "དཔྱད་གཞི་དེ་ལ་ཡང་རང་ཉིད་འཚོ་པ་དངོས་ལ་ཞུགས་ཏེ་ཤེས་རྟོགས་དང་ཆ་རྒྱུས་ལོན་པར་བྱས་པའི་མི་དང་བྱ་བ་དངོས་པོ་སོགས་དངོས་བརྒྱུད་ཀྱི་དཔྱད་གཞི་དང་།",
    "གསུངས་པ་བྱ་བ་ལས་ཀྱི་འཁོར་ལོ་སོགས་ཟེར་བ་ལས་མི་འདུག་པས་གང་གསུམ་ངོས་འཛིན་ལགས།",
    "འདི་སྐབས་ཀྱི་དངོས་བསྟན་ནི་མཚོན་བྱ་དོན་གྱི་རཀྟ་ཡིན་འདུག་པས།",
    "ཞི་ཁྲོ་ཚར་གཅིག་ཕན་ཡོན་མཉམ་སྨྲ་སྲོལ་འདུག་པ།",
    "རྗེ་བཙུན་མི་ལ་སོགས་ཀྱིས་ཀྱང་དེ་ལྟར་གསུངས་པར་གདའ།",
    "ཡཕམཡཕའོ་༢ ༣༩༧༡ ལམྨསཾ་༢བྦོདྷ་ཝི་ཀ་མ་ལ་སཔ་ཀ་ཙམ་གསམ་པ་མནམ་རྣམས་༩ཚ་མའོན་ཀྱང་དེང་སང་དེ་དག་དང་རྒྱབ་འགལ་དུ་སྤྱོད་པ་ནི་ལྔ་བརྒྱ་ཐ་མའི་རང་རྟགས་ཉིད་ཟང་མར་བསྟན་པ་ཡིན་འདུག་པས་ཅི་བྱར་ཡོད།",
    "དེ་བས་ཚུལ་མཐུན་མི་ཡོང་བ་མཉམ་པོ་ལ་གྲོང་ཆོག་དེ་ཉིད་ཚིག་དག་ཅིང་ཕྱག་བཞེས་མ་འཁྲུལ་བ་བསྒོམ་བྱའི་ཕྱོགས་མགོ་ཤེས་ཙམ་ཞིག་བྱུང་ན་ཁྱད་ཆེན་པོ་འདུག་པས་དེ་བཞིན་འདོམས་པར་ཞུ། དྲི་བ་ཉེར་དྲུག་པ།",
    "རྡུལ་གཅིག་སྟེང་ན་ཞེས་སོགས་ལུང་འདི་ཚོའི་དོན་གཉིས་སྣང་ཅན་རྣམས་ཀྱི་ངོར་འགལ་འདུ་ལྟ་བུར་སྣང་ཡང་རང་བཞིན་ཤེས་པའི་རྟོགས་ལྡན་གྱི་ངོར་སྐྱོན་མེད་དེ།",
    "མི་ནོན་དོགས་སོགས་ཀྱི་དམིགས་པ་སྣ་ཚོགས་དང་གནོད་པ་བྱུང་དོགས་ཀྱི་སྲུང་འཁོར་སོགས་གཅད་བྱ་གཅོད་བྱེད་གོ་ལྡོག་ཉན་ཆེ་བ་མང་དུ་འདུག་པའང་ལས་དང་པོ་པ་ལ་དགོངས་པས་སྐྱོན་མེད་སྙམ་ལགས།",
    "བཀའ་བརྒྱུད་སྤྱི་ལ་མ་གྲགས་ཤིང་ཕག་གྲུ་བཀའ་བརྒྱུད་ཀྱི་ཞལ་ངག་ཡིན་འདུག་པས།",
    "ཞེས་གསུངས་འདུག་པ་དང་།",
    "ཞེས་གསུངས་འདུག་པ་དང་།",
    "ས་ལ་བརྟེན་པའི་བརྟན་མ་སོགས་ལོ་ཟླ་ཞག་དུས་ཀྱི་ས་བདག་དང་འདིར་གནས་ཀྱི་ལྷ་ཀླུ་རྣམས་མཆོད་སྦྱིན་པོ་འདིར་རྒྱུ་བའི་ཐེ་སེ་གྲུལ་བུམ་སོགས་དང་།",
    "མིའི་ཤ་རྣམས་རང་རང་ས་བོན་གྱིས་མཚན་པའོ།",
    "མཚོན་བྱེད་ཨ་ར་པ་ཙ་ན།",
    "གཞན་ཡང་རང་ཉིད་འཇམ་དཔལ་གསལ་བ་ཡི།",
    "དེ་ཡང་རང་སེམས་ཀྱིས་གསལ་སྣང་དང་འཆར་སྒོ་ཙམ་དུ་ཤེས་པར་བྱ་ཞིང་།",
    "དེ་ཡང་རང་སེམས་དང་དབྱེར་མེད་དུ་འདྲེས་ཤིང་།",
    "ཀུན་ཀྱང་དུར་ཁྲོད་ཆས་རྫོགས་འཇིག་དུས་ཀྱི།",
    "དཔའ་བོའི་འདུག་སྟངས་བགྲད་པ་ནི།",
    "ལོ་ཟླ་ཞག་དུས་བཀྲ་ཤིས་འཕེལ་གྱུར་ཅིག།",
    "འོད་ཟེར་དེ་དྷཱུ་ཏིའི་དབྱིབས་བརྒྱུད་གསང་རང་ཧེ་རུ་ཀའི་རྡོ་རྗེའི་བུ་གར་ཞུགས་ཏེ་གྱེན་ལྡོག་ས་བོན་ལ་ཐིམ་པས་སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ་ཐོབ་པར་བསམ་པ་ནི་སྒྲུབ་པའི་དོ་བའི་པདྨོ་ནས་ཐོན།",
    "དེ་ཡང་རང་ལྷུན་གྲུབསེམས་གཉུག་མའི་ངོ་བོར་རྫོགས།",
    "རྨི་ནོར་བཞི་། ལྟས་མཚན་མ་ངན་པ་ལོ་ཟླ་ཞག་དུས་ཀྱི་སྐག་རིགས་སོགས་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ཞི་ཞིང་ཚར་གཅོད་པ་དང་།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བ།",
    "དེ་ནས་སྤྱི་བོར་འདུག་ནས་ནི།",
    "ལོ་ཟླ་ཞག་དུས་སྤར་སྨེའི་སྐག་རིགས།",
    "གནས་འདིར་མ་འདུག་གཞན་དུ་དེངས།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འདུ་ཤེས་འཛིན་སྟངས་སོགས་མཐོང་ཐུབ།",
    "རྒྱབ་ལ་བོའུ་གཅིག་གདའ་ལེ་དེ།",
    "འོག་དེ་ན་རྟ་ཞིག་གདའ་ལེ་དེ།",
    "འོག་འདི་ན་རྟ་ཞིག་གདའ་ལེ་དེ།",
    "རྗེས་འདི་ན་ཁྱི་ཞིག་གདའ་ལེ་དེ།",
    "ལུང་པ་ཨ་ཤུ་སྤུན་གསུམ་གདའ།",
    "ལུང་པ་ཟས་མེད་སྤུན་གསུམ་གདའ།",
    "ལུང་པ་ཆུ་མེད་སྤུན་གསུམ་གདའ།",
    "ལུང་པ་རྡོ་མེད་སྤུན་གསུམ་གདའ།",
    "ལུང་པ་རྩྭ་མེད་སྤུན་གསུམ་གདའ།",
    "ནོར་རྗེས་མ་ལྷས་ནས་མི་ལང་འདུག་པདྨེ་ཧཱུཾ།",
    "འབྲི་ཟིལ་དཀར་འོ་འོ་རྫོ་རན་གདའ།",
