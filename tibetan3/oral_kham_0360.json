    "མི་དང་རང་བྱུང་ཁམས་ཀྱི་འབྲེལ་བ།",
    "སྲོག་ཉེན་ཐུག་དུས་ཀྱང་ཡོད།",
    "གྲུབ་འབྲས་ཀྱང་མི་ཉུང་བ་བླངས་འདུག་འོན་ཀྱང་བོད་བརྒྱུད་ནང་བསྟན་གྱི་སྐོར་ནས་ཞིབ་འཇུག་བྱས་པ་ཉུང་།",
    "ང་རང་ནི་སྤྱི་ལོ་༡༩༦༢ལོར་གཞིས་ཀ་རྩེར་སྐྱེས་པ་དང་།",
    "དེ་ཡིས་འོད་ནི་དྲང་ཐིག་ལྟར་འགུལ་སྐྱོད་བྱེད་ཐུབ་པ་དང་འབར་རྫས་མི་མཐུན་པར་ཐུག་དུས་ཁ་ཕྱོགས་འགྱུར་བའི་འཕྲོ་ཐིག་འོད་ཐིག་ཅིག་ཏུ་ཆ་འཇོག་བྱས་ཡོད།",
    "འོན་ཀྱང་འདི་ལ་ཞིབ་འཇུག་དང་བསྔོག་འདོན་བྱེད་མཁན་གྱི་ལག་རྩལ་དང་ཞིབ་འཇུག་མི་སྣ་མང་བོ་མི་འདུག་སྒྲིག་ཆས་ཡིན་ན་ཕྱི་རོལ་ནས་གདན་དྲངས་ན་འགྲིག་ཡོད།",
    "ང་རང་ལ་མཚོན་ན་སྐད་ཆ་དེ་ལ་ཐེ་ཚོམ་སྐྱེས་ཡོད།",
    "ང་རང་ཡར་ཀླུང་གཙང་པོའི་འགྲམ་རྒྱུད་དུ་སྐྱེས་པས་ཆུ་རྐྱལ་བར་དགའ་བོ་ཡོད།",
    "ཁྱིམ་མི་དག་ལྟོགས་ནས་མཆུ་ཏོའང་སྔོན་པོ་ཆགས་འདུག་དེ་ནས་ཞིབ་འཇུག་ཁང་ནས་ལས་ཀ་བྱེད་བཞིན་ཡོད།",
    "ང་རང་ཉིད་ལ་མཚོན་ན་སྒྲ་སྙན་གཏོང་ཤེས་པར་བྱུང་བ་མ་ཟད།",
    "ཡང་ན་ལྟ་རྒྱ་དང་ཐོས་རྒྱ་སོགས་ཆེ་རུ་འགྲོ་བར་ཕན་ཐོགས་ཆེན་པོ་འདུག་པས།",
    "ང་རང་གཅིག་ནས་པེ་ཅིན་གྱི་གནམ་གཤིས་ལ་མི་ལོབས་པ་དང་།",
    "དེ་དུས་སློབ་ཚན་མང་པོ་འདུག་དཔེར་ན།",
    "དམ་པ་གང་ཉིད་ལྷ་སར་བཞུགས་དུས་ཀྱང་ང་རང་རྒྱུན་པར་འགྲོ་བ་ཡིན།",
    "སྤྱིར་བཏང་དམ་པ་གང་ཉིད་དུས་ཚོད་བཅུ་གཅིག་པའི་ཐོག་གཟིམ་གོམས་ཆགས་འདུག་རུང་།",
