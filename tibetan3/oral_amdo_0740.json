    "དེ་ཉིད་ནི་ནང་གི་རིག་པ་དང་ཤེར་ཕྱིན།",
    "མུན་པ་དག་གིས་མཐར་ཞེས་པ་ནི་མཚན་མོའི་དུས་སུ་མཚན་མོའི་རྣལ་འབྱོར་དང་ཉིན་མོའི་དུས་སུ་ཉིན་མོའི་རྣལ་འབྱོར་གྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་རྣལ་འབྱོར་ལྟ་བ་གང་ཡིན་པ་དེ་ནི་མཚན་མོ་ནམ་མཁའ་ལ་ལྟ་ཞིང་ཉིན་མོ་བླ་གབ་མེད་པ་ལ་ལྟའོ།",
    "འཛག་པ་མེད་པའི་མཆོག་གི་བདེ་བ་ཆེན་པོའི་རོ་གཅིག་པའི་འོད་གསལ་བ་དེའི་དབུས་སུ་གཟུགས་བརྙན་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་བདག་ཉིད་ཅན་རྣམས་སྒོམ་བྱ་ནི་ལྟ་བར་བྱའོ།",
    "ཡེ་ཤེས་བདེན་པ་གཉིས་སུ་མེད་པར་གྱུར་པའི་སྐད་ཅིག་རྫོགས་པ་ནི་རྟོགས་པ་སྟེ་ཏིང་ངེ་འཛིན་ཞེས་པ་ཏིང་ངེ་འཛིན་གྱི་ཡན་ལག་གི་མིང་ཅན་ནོ།",
    "ཁྲོ་བོའི་རྒྱལ་པོ་ཕེབས་ན་མཚོན་ཆས་མཛེས་པའི་ལག་པ་དག་གིས་བདུད་ཀྱི་ཚོགས་ལ་སྡིགས་བྱེད་ཅིང་།",
    "གཡོན་བརྐྱང་ལ་སོགས་སྟབས་རྣམས་དང་ནི་བཅིང་བ་དག་གིས་རྡོ་རྗེའི་གར་གྱི་གར་བྱེད་དེ།",
    "བཞད་དང་ཧཱུྃ་གི་ཡི་གེ་འདྲེས་པ་དགྲ་ལ་འཇིགས་པ་སྟེར་བ་དང་ནི་རྡོ་རྗེའི་གླུ་ཡང་བྱེད།",
    "ཁྲོ་བོའི་རྒྱལ་པོ་ཕེབས་ན་མཚོན་ཆས་མཛེས་པའི་ལག་པ་དག་གིས་བདུད་ཀྱི་ཚོགས་ལ་སྡིགས་བྱེད་ཅིང་།",
    "དེ་བཞིན་དུ་གཡོན་བརྐྱང་ལ་སོགས་སྟོབས་རྣམས་དང་ནི་རྣམ་མང་བཅིང་བ་དག་གིས་རྡོ་རྗེའི་གར་གྱི་གར་བྱེད་དོ།",
    "བར་སྣང་ལ་ཡང་རྣམ་མང་བཅིང་བ་དག་གིས་ཞེས་པ་གར་བྱེད་དོ།",
    "ཅི་སྟེ་བཞད་པར་བྱེད་ན་དེའི་ཚེ་ཧཱུྃ་གི་ཡི་གེ་འདྲེས་པས་དགྲ་སྟེ་བདུད་ཀྱི་ཚོགས་ལ་འཇིགས་པ་སྟེར་བ་དང་ནི།",
    "མཚན་མ་གང་གིས་བསྐྱེད་པ་དེ་ཡང་དེའི་ཕྱག་གི་ཕྱག་རྒྱར་འགྱུར་ཏེ།",
    "མཆོག་གི་ལྷའི་སྐུ་རྡོ་རྗེ་བྱིན་གྱིས་བརླབ་པར་གྱུར་པས་རི་བོ་འབྱིན་པ་ལ་སོགས་པ་སྐུའི་བྱ་བ་བྱེད་དོ།",
    "མེ་ཕེབས་པས་ནི་སྲེག་པར་འགྱུར་ཏེ་གང་གི་ཚེ་གོས་དཀར་མོས་བྱིན་གྱིས་བརླབ་པར་གྱུར་པ་དེའི་ཚེ་གང་ལ་རེག་པ་དེ་སྲེག་པར་བྱེད་དོ།",
    "འདིར་གང་གི་ཚེ་ལྷའི་མིག་ཕེབས་པར་གྱུར་ན་དེའི་ཚེ་མཆོག་གི་གཟུགས་དང་མི་མཐོང་བའི་རྫས་ཀྱང་མཐོང་བར་འགྱུར་རོ།",
    "གང་གི་ཚེ་ལྷའི་ཡིད་ཕེབས་པར་གྱུར་ན་དེའི་ཚེ་གཞན་གྱི་སེམས་ཀྱི་ཡེ་ཤེས་པར་འགྱུར་རོ།",
    "གང་གི་ཚེ་ལྷའི་ལྕེ་ཕེབས་པར་གྱུར་ན་དེའི་ཚེ་ལྷའི་རོ་མྱོང་བར་འགྱུར་ཞིང་།",
    "བསྙེན་པའི་དབྱེ་བ་དང་ནི་རྣམ་མང་དམ་ཚིག་སྔགས་ཀྱི་བཟླས་པ་སོགས་ཀྱི་འགའ་ཞིག་དག་གི་ཚེ།",
    "དེ་བཞིན་དུ་སྔགས་ཀྱི་བཟླས་པ་ལ་སོགས་པ་དག་གིས་ཀྱང་ཕེབས་པར་འགྱུར་གྱི།",
    "དེའི་ཚེ་དང་པོར་ཁུ་བ་ནོར་བུའི་རྩེ་མོ་དང་།",
    "རང་གཞན་ཆ་ཡིས་རྣམ་རྟོག་གིས།",
    "ཆགས་དང་ཆགས་བྲལ་མཐའ་ཐོག་ལ་གནས་སྐད་ཅིག་མ་ཡང་ཁྱབ་བདག་གི་ནི་དབུགས་ཀྱི་གྲངས་འཕེལ་ལོ།",
    "དེ་དག་གིས་སོ།",
    "གསང་བར་རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོ་ལ་སྐད་ཅིག་མ་བརྒྱ་ཕྲག་སུམ་ཅུ་རྩ་དྲུག་རྣམས་ཀྱིས་འཕེལ་ཏེ།",
    "དེའི་རྟེན་ནམ་རྒྱུ་ནི་རྣམ་ཀུན་མཆོག་གི་སྟོང་པ་སྟེ།",
    "དེ་ལྟ་བུའི་སྒྲིབ་བྲལ་གྱི་སྟོང་པ་སོ་སོ་རང་གིས་རིག་བྱེད་དེ་གདོད་ནས་སྒྲིབ་བྲལ་དུ་གནས་པས་མངོན་དུ་བྱས་པ་ན་སྒྲིབ་མེད་དུ་འགྱུར་བ་དང་མ་བྱས་པ་ན་སྒྲིབ་བཅས་སུ་འགྱུར་བ་མེད་དེ།",
    "ཉོན་མོངས་ལ་སོགས་ཉམས་པ་རྫོགས།",
    "དཔེ་གཞན་ཡང་ནམ་མཁའ་དག་པ་ལ་རབ་རིབ་ཀྱིས་འབྲལ་བའི་མིག་གིས་བལྟས་པ་བཞིན་ནོ།",
    "འདིར་ས་དང་པོ་ཐོབ་པ་ལས་འཇིག་རྟེན་གྱི་ཁམས་གཅིག་གི་མཐར་ཐུག་པར་མ་མཐོང་བའི་དོན་ཡང་དག་པར་མཐོང་ངོ།",
    "ས་ལྔ་པ་ཐོབ་པ་ལས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་བཅུ་དྲུག་གི་མཐར་ཐུག་པར་རོ།",
    "ས་དགུ་པ་ཐོབ་པ་ལས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཉིས་བརྒྱ་ལྔ་བཅུ་རྩ་དྲུག་གི་མཐར་ཐུག་པར་རོ།",
    "ས་བཅུ་གཅིག་པ་ཐོབ་པ་ལས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཉི་ཤུ་རྩ་བཞི་ལྷག་པའི་སྟོང་ཕྲག་གཅིག་གི་མཐར་ཐུག་པར་ལྐོག་ཏུ་གྱུར་པའི་དོན་ཡང་དག་པར་མཐོང་ངོ།",
    "སྟོང་གཅིག་ཅེས་བྱ་བ་ནི་མི་མཇེད་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་དབུས་ནས་སྟེང་དང་འོག་ཏུ་སྟོང་ཕྲག་རེ་རེ་སྟེ།",
    "དེ་བཞིན་དུ་སྟོང་ཕྲག་གཉིས་དང་གསུམ་མོ།",
    "དེས་ཀྱང་མ་གྲུབ་ན་ཕྱིའི་ཕྱག་རྒྱ་ཟླ་བ་དྲུག་གིས་འཐོབ་སྟེ།",
    "ལོ་ཕྱེད་ཀྱིས་ནི་བསྔགས་པ་རྣམས་ཀྱི་མཆོག་གི་ལུས་ལ་དཀར་བའི་མཛེ་འཕྲོག་དེ་ལ་གཞན་ལྟ་ཅི།",
    "ཆང་གི་བཏུང་བ་དང་།",
    "དེའི་ཕྱིར་ཏིང་ངེ་འཛིན་གྱི་དག་པ་དྲི་མ་མེད་པར་གྱུར་པ་ནི་ཉིན་ཞག་འགའ་ཞིག་དག་གིས་ཏེ་ལོ་གསུམ་དང་ཕྱོགས་གསུམ་གྱི་ཉིན་ཞག་རྣམས་ཀྱིས་ཡེ་ཤེས་ལུས་ནི་འགྲུབ་པར་འགྱུར།",
    "སྲོག་གིས་རོ་ཡི་འགྲོ་བ་རྣམས་ལ་གནས་པ་ཐམས་ཅད་བཀུག་ཅིང་ཉོན་མོངས་བདུད་རྣམས་བཅོམ་བྱས་ནས།",
    "སྲོག་གི་རོའི་འགྲོ་བ་རྣམས་ལ་གནས་པ་སྟེ།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་བདུད་རྣམས་བཅོམ་བྱས་ནས་རྫུ་འཕྲུལ་དང་ཀུན་མཁྱེན་གྱི་ས་བཅུ་གཉིས་འཆད་པར་འགྱུར་བ་རྣམས་དང་།",
    "ཡེ་ཤེས་ཐོབ་ན་མི་ཟད་མཆོག་གི་གནས་སུ་རབ་འགྲོ་གང་དུ་སླར་ཡང་སྐྱེ་བ་ལྡན་པ་མིན།",
