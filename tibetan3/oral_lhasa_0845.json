    "ལན་ཆགས་ཤ་འཁོན་གཉེར་ནས་བསྡད་ཡོད་ཀྱང་།",
    "ཡིན་ན་ཡང་ད་ལྟའི་གནས་སྐབས་ལ་ཐབས་ཤེས་གཞན་ཅི་ཡང་མེད་པར།",
    "དེ་ཐིམ་པས་རྐྱེན་བྱས་ནས་རང་ངོས་ནས་ཀྱང་སྐྱབས་ཡུལ་རྣམས་ལ་དད་པ་ལྷག་པར་དུ་འཕེལ།",
    "བཅད་དུ་མེད་པའི་དག་པར་བརྗོད།",
    "ཅེས་གསུངས་པ་བཞིན།",
    "སོ་སོའི་ངོས་ནས་ནམ་རྒྱུན་ཁ་འདོན་དགེ་སྦྱོར་ལ་བརྩོན་ཐག་ཆོད་ཡོད་པར་མ་ཟད།",
    "ཡིན་ན་ཡང་འདིའི་ནང་ནས་དམིགས་པ་སྣོན་པ་རྒྱག་རྒྱུ་ཡོད་ན་བརྒྱབས་ཆོག་ངེས་པར་དུ་ཆོ་ག་གཅིག་རྐྱང་པ་འདོན་དགོས་པ་ཅང་ཨེ་ཡོད་སྙམ།",
    "དེས་མཚོན་པའི་དགེ་ལུགས་པའི་འདོན་པ་འདོན་མཁན་གྱི་ནང་ལ་ཡང་དེ་དེ་བཞིན་བྱས་ཏེ།",
    "དེ་མིན་སྦྱར་ཡང་འགྲིག་པར་སྙམ།",
    "དོན་དམ་གྱི་སྒོམ་རྒྱག་མཁན་ཚོས་འདོན་པ་ཉུང་ཙམ་བྱས་ན་ལེགས།",
    "བཀོད་པའི་ཁྱད་པར་ཕུན་སུམ་ཚོགས་པར་གྱུར།",
    "བདེ་སྟོང་དབྱེར་མེད་ལྷ་ལམ་ཡངས་པར་ཀུན་བཟང་མཆོད་སྤྲིན་འཁྲིགས་པའི་དབུས།",
    "སྣང་བ་ལྷ་སྒྲུབ་ཅེས་བརྗོད་པའི་སྣང་བ་ལྷར་བསྒྲུབ་པའི་སྒྲུབ་བྱེད་གཙོ་བོ་དེ།",
    "འཁྱག་རོམ་ཆུར་ཞུ་བའི་གནས་སྐབས་ལ་ཡང་ཆུའི་རང་བཞིན་ལ་སྔ་ཕྱི་གཉིས་ཀར་ཁྱད་པར་མེད་པ་བཞིན།",
    "ཤེས་པར་གྱུར་པའི་ཤེས་སྒྲིབ་ཡོད་མེད་དཀའ་ལས་བརྒྱབས་ཀྱང་ཐག་རྩ་ནས་མི་ཆོད་པ་འདི་ལས།",
    "གང་ལྟར་དེ་དག་གསང་འདུས་གཞིར་བཞག་སྟེ་གསང་འདུས་ཀྱི་ལྷ་སོ་གཉིས་དང་།",
    "སྤྱིར་བཏང་ལྟར་ན་ལུས་བསྐྱེད་ལ་འདུས་པའི་ལྷ་སོ་གཉིས་བཀོད་ནས།",
    "ཡིན་ན་ཡང་གསང་བདེ་འཇིགས་གསུམ་ཡ་མ་བྲལ་བ་ཞེས་པའི་དོན་གཙོ་བོ་དེ་རྫོགས་རིམ་གྱི་ཉམས་ལེན་གྱི་ཐོག་ནས་གསུངས་པ་དང་།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་རྣལ་འབྱོར་ལ་གནས་ནས་ཞེས་གསུངས་པ་ལྟར།",
    "ཡོ་བྱད་བྱིན་བརླབས་བྱས་པའི་མཇུག་ཏུ།",
    "དངོས་གཞི་ནི་ཚིགས་སུ་བཅད་པའི་སྒོ་ནས་བརྗོད་ན་འཇུག་པ་བདེ་བས་ཡིད་མ་ཡེངས་པར་འདི་ལྟར་འདོན་ཞིང་།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་བཀྲམས་པ་སོགས་ལམ་རིམ་གྱི་སྐབས་ནས་བྱུང་བ་ལྟར་བྱས་ཏེ།",
    "དེ་ཡང་སང་བྱ་གནངས་བྱས་མི་འགྱངས་པར།",
    "འཕྲལ་དུ་ཛ་དྲག་པའི་སྡུག་བསྔལ་མངོན་གྱུར་པ་མང་པོ་ཞིག་མྱོང་དགོས་པར་མ་ཟད།",
    "གཞན་གྱི་བདེ་སྡུག་དེ་རང་དང་འབྲེལ་བ་ཡོད་པར་བརྟེན།",
    "ལྟོ་ཆས་ལ་མཚོན་ན་ཡང་ལོ་བཞི་བཅུ་ལྔ་བཅུའི་རིང་སྨྱུང་གནས་ལ་བསྡད་པའི་སྐབས་མ་གཏོགས།",
    "ཉི་མ་གཅིག་ཀྱང་ལྟོ་ཆས་ལ་གྱོང་མ་སྤྲད་པར་བསྡད་པ་ཡིན།",
    "མི་གཙང་བའི་གོང་བུ་དང་མི་གཙང་བའི་རྐྱལ་བ།",
    "གང་ལྟར་འདས་པའི་མི་ཚེ་འཕྲོ་བརླག་ཏུ་བཏང་བའི་ཉམས་མྱོང་ཤེས་པར་བྱས་ཏེ།",
    "ཚེ་ལྷག་ཇི་ཙམ་ཡོད་པ་དེ་དོན་དང་ལྡན་པ་ཞིག་ཅིས་ཀྱང་བྱ་སྙམ་པར་མ་ཟད།",
    "ད་ལྟ་གདན་འདིའི་སྒང་ལ་བསྡད་ནས་ལོ་འདི་དང་ཟླ་བ་འདི།",
    "ཐོག་མ་མེད་པ་ནས་དུས་ད་ལྟའི་བར་དུ་སྡུག་བསྔལ་མི་འདོད་པ་དང་བདེ་བ་འདོད་པ་དེ་བཅོས་མི་དགོས་པར་ཡོད་ཀྱང་།",
    "བྱམས་བརྩེའི་བློ་མེད་པའམ་སེམས་བཟང་པོ་མེད་པར་རང་ཉིད་བསམ་པ་ངན་པ་ཡིན་ན།",
    "གཞན་གྱིས་ཀྱང་བསམ་པ་ངན་པར་རྩིས་ཏེ་ནམ་ཡིན་ཡང་དྭོགས་པ་དང་ཐེ་ཚོམ་ཟ་བར་མ་ཟད།",
    "སོ་སོ་རྒྱུན་དུ་སེམས་མི་སྐྱིད་པར་ཞེད་སྣང་ངང་སྡོད་དགོས་པའི་འབྲས་བུར།",
    "གཞན་གྱིས་ཐུག་ཙམ་བྱས་ཀྱང་ཚིག་པ་ཟོས་ཏེ་སྐད་ལོག་རྒྱག་པ་སོགས་ཐུག་ཙམ་ཡང་མི་བཟོད་པ།",
    "དུད་འགྲོ་ཁྲོས་བསྡད་པ་དེས་གཡས་དང་གཡོན་ལ་འཆའ་བ།",
    "ཁྱི་ཁྲོས་བསྡད་པ་ཞིག་ལ་ཆ་བཞག་ན།",
    "ལྟོ་ཆས་བཟའ་བའི་སྐབས་སུ་ཡང་ཁོའི་ཉེ་འཁྲིས་སུ་གང་ཞིག་སླེབས་མི་ཡོང་ངམ་སྙམ་པའི་དྭོགས་པས་ཧར་ཧར་ཞེས་ཟེར་བར་མ་ཟད།",
    "དེར་བརྟེན་རང་གཞན་རོགས་གསུམ་སུ་ལ་བལྟས་ཀྱང་སེམས་བཟང་པོ་བྱས་ན་སྐྱིད་པོ་ཡོད་ཅིང་།",
    "སེམས་ངན་པ་བྱས་ན་སྐྱིད་པོ་མེད་པ་དེ་བརྒྱ་ཆ་བརྒྱ་ཐམ་པ་ཐག་གཅོད་ཐུབ།",
    "ཡང་སེམས་བཟང་པོ་ཞེས་པར་རིམ་པ་ཧ་ཅང་མང་པོ་ཡོད་དེ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "དེ་ཐམས་ཅད་ཁ་སྟབས་གཅིག་ཡིན་པར་བརྟེན།"
  ]
}