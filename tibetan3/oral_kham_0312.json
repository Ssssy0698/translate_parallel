    "མཁས་པའི་དགའ་སྟོན་དུ་རྒྱལ་པོ་འདི་སྟོན་པ་འདས་ནས་ལོ་བརྒྱ་ན་བྱོན་པར་བཞེད་པ་དང་ལོ་བརྒྱ་ཉི་ཤུ་ན་བྱོན་པར་བཞེད་པ་གཉིས་བཀོད་འདུག་ཀྱང་ཕལ་ཆེར་བཞེད་ཚུལ་རྗེས་མ་སྟེ་ལུང་དོན་དངོས་ལྟར་ན་སྤྱི་ལོ་སྔོན་ལོ་དང་རགས་རྩིས་སྤྱི་ལོ་སྔོན་ལོ་ཡས་མས་སུ་འཁྲུངས་པ་དོན་ལ་ཉེ་པར་སེམས་སོ།",
    "ཡི་གེ་དེས་བྲིས་པའི་ཤོག་དྲིལ་སྐོར་ཞིག་དུས་རབས་པ་ནས་པའི་དུས་སུ་ཤིན་ཅང་དང་ལི་ཡུལ་འུ་ཐེན་ས་ཆར་རྙེད།",
    "སྟན་བདེ་ལ་བསམ་གཏན་གྱི་སྤྱོད་ལམ་གྱིས་འདུག་ལ།",
    "ཅེས་པའི་ཚིག་ལ་བསམ་འདུག་ནའང་།",
    "ཤར་བ་ལ་འཇུག་པར་གདའ་སྟེ།",
    "ཅེས་སོགས་ཀྱི་རྣམ་དབྱེ་མང་དུ་གདའ་ཞིང་།",
    "གོང་མ་དེ་ནི་སྤྱིར་མཚན་བཅས་ཀྱི་རྫོགས་རིམ་དུ་འདུག་པས་ན།",
    "དེ་གསུམ་ག་ཡང་རང་སེམས་ཀྱི་རྣམ་རོལ་ལས་ནི་མ་འདས་སོ།",
    "ངོ་ཁྲོ་འགྲེལ་ཆེན་དུ་ནི་འདི་དང་བྷ་སནྟུ་སོགས་ལ་དགག་པ་མཛད་འདུག་རུང་།",
    "ཞེས་ལུང་བསྟན་འགའ་ལ་འདུག་པ་དེ་ཡང་ཤིན་ཏུ་བདེན་ནམ་ཞེས་རང་ཉིད་ཁོ་ན་སེམས་ལགས།",
    "ཕ་རོལ་པོའི་ལུས་དང་རང་ལུས་གཉིས་ཀ་ལྷར་གསལ་དགོས་སམ་མི་དགོས་གསུངས་པ་ནི།",
    "ཏེ་ཚངས་བུག་ཏུ་འཇག་མ་ཚུགས་པ་ནི་ཞག་གསུམ་བཞི་ལས་ཕྱིར་མི་འགྱངས་པར་འདུག་ལགས་པ་ནི་མངོན་སུམ་ཚད་གྲུབ་སྟེ།",
    "ཡིད་ལ་མི་བྱེད་པ་འདི་གོ་བདེ་བར་གདའ།",
    "ཉི་ཚེ་བའི་སྟོང་པ་གཉིས་ནོར་དོགས་འདུག་གསུངས་པ་ཐུགས་བདེན་ཏེ།",
    "ཏིང་འཛིན་ཐམས་ཅད་ཀྱི་རྩ་བ་ནི་འདི་གཅིག་པུར་འདུས་གདའ་བ་དང་།",
    "སྟོང་རང་བཞིན་འོད་གསལ་བ།",
    "དེ་ཉིད་བོད་ཡུལ་དུ་ཡང་འབྲོམ་སྟོན་རྒྱལ་བའི་འབྱུང་གནས་སོགས་སུ་སྤྲུལ་ཏེ་བསྟན་པའི་བྱ་བ་མཛད་པར་ཨོ་རྒྱན་གྱི་ལུང་བསྟན་མང་པོར་གདའ་འོ།",
    "རྟགས་ཙམ་འཛིན་གྱི་ལྔ་བརྒྱ་རྣམས་ཡོད་པར་གསུང་མཁན་མང་བར་གདའ་ནའང་།",
    "ལྷན་ཐབས་མ་འདི་ཁོ་ན་མང་བར་གདའ་བས།",
    "སྟོན་པ་བཞུགས་སྐབས་སུ་དགེ་སློང་འགའ་ཞིག་ལྷམ་ལ་མི་གཙང་ལྗན་ལྗིན་སོགས་ཀྱིས་གོས་པ་སྟན་ལ་འདུག་པས།",
    "སྟོན་པས་ད་ཕྱིན་ཆད་མཆིལ་ལྷམ་གྱོན་བཞིན་སྟན་ལ་འདུག་པར་མི་བྱེད་ཅེས་བཅའ་བ་མཛད་པ་སྟེ།",
    "འོན་ཀྱང་དགེ་སློང་མ་རྣམས་ལ་ནུ་མ་སོགས་སྒྲིབ་ཕྱིར་ཤིང་ང་དཔུང་བཅད་དུ་གྲགས་པ་ཞིག་ཡོད་པར་གདའ་ཞིང་།",
    "འདི་གཉིས་འཕྲལ་བའི་སྲོལ་མི་འདུག་གསུངས་པ་ལ།",
    "འདིས་མཚོན་ཏེ་སྐབས་ཐོབ་ཀྱི་བྱེ་བྲག་ཤེས་དགོས་པར་གདའ་ཡང་།",
    "ཁྲུས་སྔོན་ལ་བྱས་ནས་གྲལ་ལ་འདུག་པ་ཡིན་ཀྱང་འདིར་ཁྲུས་ཆུ་རྗེས་ལ་བཏང་བ་འདི་ཁའི་ད་ལྟའི་ལག་ལེན་ཚོ་དང་བསྟུན་པ་ཡིན།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་པོ་ཁམས་དང་སྐྱེ་མཆེད་རྣམས་མི་དམིགས་ཏེ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཀྱི་ངོ་བོ་ཡི་གེ་ཧྲཱི་དཀར་པོ།",
    "མནལ་མལ་དུ་ཡབ་རྒན་གད་གཡང་ཞིག་ལ་འཆར་ལ་ཁད་འདུག་པ་ལ།",
    "ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "མི་གསུང་བར་ཞུ་ཞེས་ཞུས་སོ་ཞེས་ཁོང་རང་གཉིས་ལས་ཐོས་སོ།",
    "དེ་རྣམས་ལས་ཆེ་བ་ཅིག་འདུག་པ་དྲིས་པས།",
    "དེ་གཉིས་ལས་ཆེ་བ་ཅིག་འདུག་པ་དྲིས་པས།",
    "ཅེས་གསུངས་འདུག་པ་འདི་སྒྲ་རྒྱན་བྱ་དཀའ་བ་དང་།",
    "འདིར་སྔོན་བྱོན་མཁས་པས་གྲོང་ཚིག་སྙན་ངག་ཏུ་རློམ་པ་ཞེས་བཀའ་བཀྱོན་གནང་བའང་དོན་གྱིས་སྟོངས་ཤིང་རྒྱན་གྱིས་དབུལ་བ་ལྟ་བུའི་མཐའ་གཉིས་སུ་ལྷུང་བའི་རིགས་ལ་དགོངས་པ་ལོས་ཡིན།",
    "བྱ་དངོས་སྤྱི་ཡོངས་ཀྱི་སྒྲིག་སྲོལ་དང་རང་བཞིན།",
    "རང་བྱུང་ཁམས་ཀྱི་བྱ་དངོས་སྤྱིའི་གཅིག་འགྱུར་དང་སྣ་མང་རང་བཞིན།",
    "འགྲོ་བ་མིའི་གཉུག་གཤིས་ཀྱི་བདེན་པ་དང་རང་བཞིན་གྱི་ལེགས་བྱང་དག་གསལ་བར་བྱས་ཏེ་མིའི་རིན་ཐང་དང་།",
    "ཡིས་མི་སུ་ཡིན་ཡང་རང་ཉིད་སྐྱེས་པ་ཙམ་ནས་འཇིག་རྟེན་གྱི་བྱ་དངོས་སྣ་ཚོགས་པའི་ངོ་བོ་དང་རང་བཞིན་རྟོགས་ནས་ཡོད་པ་མིན་ལ།",
    "བྱེ་བྲག་ཏུ་འཇིག་རྟེན་ནི་རྣམ་པའི་ཆ་ནས་སྣ་མང་རང་བཞིན་ཅན་ཡིན་ཡང་ངོ་བོའི་ཆ་ནས་གཅིག་གྱུར་རང་བཞིན་དུ་གནས་ལ།",
    "རྗེས་སུ་དྲི་བ་དེའི་དངོས་ལན་འཚོལ་ཉུལ་བྱ་ཆེད་འཇིག་རྟེན་གྱི་འབྱུང་ཁུངས་དང་རང་བཞིན་ལ་རྟོག་འཇུག་བྱེད་པའི་མཚན་ཉིད་སྨྲ་བའི་མཁས་པ་དུ་མ་ཞིག་བྱུང་ཞིང་།",
    "ཨེན་གྷི་སི་དང་རང་བྱུང་རྩོད་སྒྲུབ་སྨྲ་བ།",
    "ས་གཤིས་བཅས་ཀྱི་དམར་དཔེ་འཚོལ་སྡུད་བྱེད་དུ་བཅུག་པས་སྒྲར་ཝིན་ལས་རིགས་དེ་ལ་ཤིན་ཏུ་མཉེས་པར་གྱུར་ཞིང་རང་འགུལ་གྱིས་སྐྱེ་དངོས་ཀྱི་རིགས་ལ་ཞིབ་འཇུག་བྱེད་པའི་མགོ་ཚུགས།",
    "ཁོ་རང་ཆུང་དུས་ནས་ལྷིང་འཇགས་ཀྱི་གནས་སུ་བསྡད་དེ་རང་སྟོབས་ཀྱིས་བསམ་གཞིག་བྱེད་པར་ཧ་ཅང་དགའ་ལ་སློབ་གླིང་དེར་ལོ་བརྒྱད་ལ་སྡོད་པའི་རིང་གནའ་རབས་རྩོམ་རིག་དང་།",
