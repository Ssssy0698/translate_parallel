    "དྲང་སྲོང་བཟོད་པ་ཅན་ལུས་དྲང་པོར་བཞག་སྟེ་ཤིན་ཏུ་སེམས་ཤིང་འདུག་པར་མཐོང་ནས་དེ་ལ་དད་པའི་སེམས་སྐྱེས་ཏེ་མེ་ཏོག་སྣ་ཚོགས་ཀྱིས་གཏོར་ཏོ།",
    "འོན་ཀྱང་རྒྱལ་པོའི་བཀའ་ཚུལ་གྱིས་བཅག་པར་རིགས་པ་མ་ཡིན་པས་མཆོད་སྟོན་ཆེན་པོ་བཤམས་ནས་མ་བོས་པར་གང་རང་འོངས་པ་ལ་བསོད་སྙོམས་སྦྱིན་ནོ།",
    "དེ་མ་ཐག་ཏུ་ལྷགས་ནས་གྲལ་གྱི་ཐོག་མ་ལ་འདུག་གོ།",
    "ང་བདག་དུས་མཁྱེན་གྱི།",
    "ཡུལ་དེར་ཕྱིན་ན་བློན་པོ་ཞིག་ལ་གནས་ཤིང་འདུག་པ་ལས།",
    "རྔོན་པ་དེ་དག་གཉེན་དང་བཅས་པ་ཐམས་ཅད་གྱོད་ལ་ཐོགས་པར་འགྱུར་རོ་སྙམ་བསམས་ནས་མི་དགའ་ཞིང་འདུག་པ་ལས།",
    "འོད་མའི་ཚལ་ནས་ཕྱིར་བྱུང་སྟེ་སྒོའི་ཐེམ་པ་ལ་འདུག་ནས་སྐད་ཆེན་པོ་ཕྱུང་སྟེ་སྨྲེ་སྔགས་འདོན་ཅིང་དུས་སོ།",
    "བདག་ཁྱིམ་ན་འདུག་པའི་ཚེ་ན་ཆུང་མ་དང་བུས་གཙེས།",
    "རྒྱལ་པོའི་ཐབས་བཏང་སྟེ་རིལ་པ་བདག་སྲང་ཞིང་འདུག་པ་ལས་རྒྱལ་པོ་དེ་ཚེའི་དུས་བྱས་ནས།",
    "ཡོན་ཏན་དང་ལྡན་པ་ཞིག་ཡུལ་དེ་ན་འདུག་པ་ལས།",
    "དེ་ལ་སུ་ཞིག་འདུག་པར་དགའ་ན།",
    "བྲམ་ཟེ་གཅིག་ཅིག་ཡོན་ཏན་དང་ལྡན་ཡང་རང་བཞིན་གྱིས་སྲེད་པ་ཅན་ཞིག་ཡིན་པས།",
    "ནོར་ཁུད་པ་ཞིག་ཡོད་པ་གདའ་སྟེ།",
    "དེའི་ཚེ་ན་བཙུན་པ་ཀཱ་ཏྱཱ་ཡ་ན་ཆེན་པོ་ཡུལ་ཨ་པ་དེ་ན་འདུག་པ་ལས་ཡུལ་དེ་ན་ཁྱིམ་བདག་ལོངས་སྤྱོད་དང་ལྡན་པ་སེར་སྣ་ཅན།",
    "གྲོང་དེ་ན་ཡང་ཁྱིམ་བདག་ཕྱུག་པོ་བུ་མེད་པ་ཞིག་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་ཐོས་བཞིན་དུ་ཙང་མི་སྨྲ་བར་འདུག་གོ།",
    "གཡོག་ཁ་ཅིག་འགྲོར་མ་བཏུབ་སྟེ་ཁང་པའི་འོག་ན་འདུག་པ་ལས།",
    "རྟ་དག་ཅིག་དེར་འོངས་ནས་ཀ་བ་ལ་བསྙོགས་པ་དང་ཁང་པ་རྡིབ་ནས་ཁང་པའི་འོག་ན་འདུག་པ་དག་ཁ་དག་གོ།",
    "མི་བཟོད་དེ་འདུག་ཏུ་མི་བཏུབ་པའི་རིགས་སོ།",
    "རྫུན་མ་ལགས་པས་རྟག་ཏུ་གདའོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་ཡིད་གཞུང་ལ་བློ་གསལ་ཏེ།",
    "ཁྱེད་ཉལ་བའི་ཚེ་ངའི་མིང་ཐོས་ན་འདུག་པའི་རིགས་སོ།",
    "འདུག་པའི་ཚེ་ཐོས་ན་ལྡང་བའི་རིགས་སོ།",
    "འདུག་པ་ལས་ཐོས་ན་འགྲེང་། བའི་རིགས།",
    "བདག་དུས་མ་མཆིས་པར་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་མཆིར་གནང་བར་བགྱི་ན་ནི།",
    "དེ་ལ་བུ་མེད་བས་རྟག་ཏུ་མི་དགའ་སྟེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ལས་ཇི་ལྟར་བྱས་ན་བུ་ཡོད་པར་འགྱུར་ཞེས་ཚངས་པ་དང་།",
    "སྐྲ་མཐོན་མཐིང་དུ་འདུག་པ།",
    "མ་སེམས་པར་འདུག་ཅིག་ཅེས་བསྒོའོ།",
    "སྐྲ་མཐོན་མཐིང་ཁར་འདུག་པ།",
    "ཁོ་བོས་གསོལ་བ་བཞིན་དུ་ཟླ་བ་གཉིས་ཤིག་འདིར་འདུག་སྟེ།",
    "དངུལ་གྱི་མཁར་ན་འདུག་པའི་ཀླུ་དེ་ནི།",
    "བེ་ཌཱུཪྻའི་མཁར་ན་འདུག་པའི་ཀླུ་དེ་ནི།",
    "གསེར་གྱི་མཁར་ན་འདུག་པའི་ཀླུ་དེ་ནི།",
    "རྒྱལ་པོའི་སྟན་ལ་འདུག་ན་གཟི་བརྗིད་དང་མཐུར་ལྡན་པ་དང་།",
    "སྐྲ་མཐོན་མཐིང་དུ་འདུག་པ་མ་ཡིན།",
    "བུ་འདུག་པའི་གནས་དབྱར་དགུན་དང་།",
    "མ་སེམས་པར་འདུག་ཅིག་ཅེས་བསྒོའོ།",
    "དེ་ནས་གསེར་གྱི་རིའི་དྲུང་དུ་ཕྱིན་ཏེ་གསེར་གྱི་བྱེ་མའི་སྟེང་དུ་འདུག་ནས་དེད་དཔོན་དེས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གལ་ཏེ་མཁར་སྒོ་བཅད་ཅིང་འདུག་ན།",
    "སྒོ་ཡང་དམ་དུ་བཅད་པ་ལས་དྲུང་ན་རྡོ་རྗེའི་གཏུན་འདུག་པ་བླངས་ཏེ་སྒོ་བརྡུངས་པ་དང་།",
    "རྒྱལ་བུ་དགེ་དོན་འདུག་པའི་ཚེ་བྱ་ངང་པ་གཅིག་གསོས་པ་དེ་ལ་རྒྱལ་པོས་འདི་སྐད་ཅེས་བསྒོའོ།",
    "རྒྱལ་བ་དེ་ན་འདུག་པ་དང་ཕྲད་དོ།",
    "དེའི་ཚེ་ན་བྱ་ངང་པ་ཡང་ཡི་གེ་དང་ཕྱིར་ཡུལ་དུ་ཕྱིན་ཏེ་ཡི་གེ་བཀླགས་ནས་རྒྱལ་བུ་དགེ་དོན་ཡང་འདུག་པར་ཤེས་པས།",
    "ཁྱིམ་ན་འདུག་ན་ནི།",
    "ཞེས་འགྲོ་བའི་ཞག་དུས་ཕོག་གོ།",
    "ཁྱེའུ་མི་གདུང་བ་ཡང་སློབ་དཔོན་གྱིས་བསྒོ་བ་བཞིན་དུ་ཕྱིར་འདུག་གོ།",
    "ད་ལྟར་རབ་ཏུ་བྱུང་ནས་དགྲ་བཅོམ་སྟེ་ཉེས་པའི་སྐྱོན་ཐམས་ཅད་ཟད་ནས་ད་ལྟར་གནས་ཁང་ན་འདུག་གོ།",
    "ཐམས་ཅད་མི་དང་འདྲ་སྟེ་རྐང་པ་འབའ་ཞིག་ཁྲ་བོར་འདུག་གོ།",
    "སུ་ཏ་སོ་མ་ཕྱིར་ཡུལ་དུ་ཕྱིན་ཙམ་ན་བྲམ་ཟེ་དེ་ཡང་ད་དུང་འདུག་སྟེ་རབ་ཏུ་དགའ་ནས་བྲམ་ཟེ་ལ་སྦྱིན་པ་བྱིན་ནོ།",
    "མིར་སྐྱེས་ལ་རྒྱལ་པོ་མ་ཐོབ་ན་ཐ་མལ་བར་འདུག་ན་ཡང་ཅི་རུང་།",
    "ང་སྔོན་རི་ལ་འདུག་སྟེ་འཇིག་རྟེན་ལ་མི་དགའ་བ་ལས་ནན་གྱིས་རྒྱལ་པོར་བཅུག་སྟེ།",
    "བྱ་དེའི་རྒྱབ་ལ་འདུག་ནས་བྱས་ཁྱེར་ཞིང་ནམ་མཁའ་ལ་འཕུར་འགྲོའོ།",
    "དེའི་ཚེ་ཡུལ་དེ་ན་བྲམ་ཟེ་དབྱིག་བ་ཅན་ཞེས་བྱ་བ་ཞིག་འདུག་སྟེ།",
    "དེའི་དྲུང་ན་ཐ་ག་པ་ཞིག་ཐགས་འཐག་ཅིང་འདུག་པའི་སྟེང་དུ་ལྷུང་ནས་ཐ་ག་པ་དེ་ཚེ་འཕོས་པ་དང་།",
    "དབྱིག་པ་ཅན་དེའི་སྟེང་དུ་འདུག་པ་དང་།",
