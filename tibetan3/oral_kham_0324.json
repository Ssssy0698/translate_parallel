    "ཁོ་རང་སྒོ་ཁར་ལངས་ནས་མགོ་བོ་ཡར་བཏེགས་ཏེ་ཕྱོགས་བཞིར་བལྟས་པས།",
    "ཁོ་རང་སྔར་བཞིན་མུན་ནག་དེའི་ཁྲོད་ཀྲོང་ངེར་ལངས་ཤིང་།",
    "གཅེན་པོ་རྗེའུ་མིན་ཡིག་འབྲི་སྒྲོག་ཙེའི་འགྲམ་དུ་བསྡད་ཅིང་ཁོའི་གཞོགས་སུ་ཇིན་གྱིས་སྤྲོ་བ་ཆེན་པོས་རྗེའུ་མིན་གྱི་སྐད་ཆར་ཉན་བཞིན་འདུག་རྗེའུ་ཧུའི་ཡི་རྡོག་སྒྲ་ཐོས་པ་དང་རྗེའུ་མིན་གྱིས་མགོ་བོ་ཡར་བཏེགས་ནས་རྗེའུ་ཧུའི་ཡི་གདོང་ལ་བལྟ་ཙམ་བྱས་རྗེས་ཁོའི་ད་ཆའི་སྐད་ངན་དེ་དྲན་པས་ཇིན་ལ་གཏད་ནས་དགོད་བཞིན་ཇིན་ལྟོས་དང་།",
    "ཁྱེད་རང་སེམས་སྡུག་བྱེད་མི་དགོས།",
    "བྱས་ན་ཁྱེད་རང་ལ་སེམས་དོན་གང་ཡོད་དམ།",
    "ཨ་ཙི།",
    "འཁར་རྔ་རྡུང་བའི་རྗེས་ན་ཕེབས་བྱམས་གཉིས་འགྲོ་བཞིན་འདུག་ལ་ཕེབས་བྱམས་འགྱོགས་མིའི་གོམ་པ་དལ་ཞིང་།",
    "ཁྱེད་རང་ལ་ལས་ཀ་གཞན་མེད་ན་ཕྱིན་ན་འགྲིག་ཅེས་གསུངས།",
    "ཐ་ན་མི་ཚེ་ལ་བསུན་སྣང་སྐྱེས་ཀྱི་འདུག་ཅེས་གསུངས་ཏེ་སྤྱན་གཉིས་བཙུམས་ཤིང་ཕྱག་གཉིས་སྣོལ་མར་བྲང་ཁའི་སྟེང་བཞག་ནས་མནལ་ལ་ཡུར་བ་ལྟར་གནས།",
    "ད་ལྟ་དུས་རབས་ག་པར་སླེབས་འདུག་གམ།",
    "ཁྱེད་རང་ཆུང་དུས་སྤོ་བོ་ལགས་ཀྱི་ཁྱིམ་དུ་བསྐྱལ་ནས་ཡི་གེ་བསླབས་པ་དང་།",
    "ཡིན་ནའི་ཁྱེད་རང་བསམ་བློ་གཏོང་དང་།",
    "ཡང་བསྐྱར་རྙོག་གྲ་འཚལ་ཏེ་སྤུན་ཉེ་ཚོའི་རྒྱག་གཏམ་ཉན་འདོད་མེད་པར་ཁུ་སིམ་མུར་ཚེ་མཇུག་བསྐྱལ་ན་སྙམ་གྱི་འདུག་ཅེས་གསུངས་ཀྱིན་དབུགས་ཧལ་བཞིན་མུ་མཐུད་གསུངས་མ་ཐུབ་པར་གྱུར།",
    "ཁྱེད་རང་ལ་དེའི་ཐད་བསམ་ཚུལ་གང་འདྲ་ཞིག་ཡོད་དམ།",
    "ཁོ་རང་ཕ་མ་གཉིས་པོའི་བྱམས་བརྩེའི་གཅེས་སྐྱོང་འོག་རིམ་གྱིས་འཚར་ལོངས་བྱུང་།",
    "ལྷག་པར་ཁོ་རང་རྫས་འགྱུར་རིག་པར་དད་ཞེན་ཆེ།",
    "འོན་ཀྱང་ཁོ་རང་མལ་ཁང་དུ་ལོག་རྗེས།",
    "འོན་ཀྱང་ཁོ་རང་ད་དུང་ཡང་ཁོའི་ཁ་སྤྲོད་དུ་ཉལ་བའི་རྒྱུས་མངའ་རྩ་བ་ནས་མེད་པའི་ན་གཞོན་མ་དེ་ལ་ཁ་ཡ་བྱེད་དགོས།",
    "ངས་ཁྱེད་རང་ལ་ཤིའི་ཧྲུའུ་ཁེ་ལས་ཀུང་སིར་ལས་ཀ་ཞིག་བཙལ་ཡོད།",
    "བྱས་ཙང་ངས་སང་ཉིན་ཁྱེད་རང་ཀུང་སིའི་ལས་བྱ་ཁང་དུ་ཁྲིད་ཆོག་ངེད་ཁྱིམ་ཀུང་སིའི་མ་རྐང་འཇོག་མཁན་གྱི་གྲས་ཡིན་ལ།",
    "ང་དང་ཏུང་ཧྲི་མི་ཉུང་བ་ཞིག་བློ་ཉེའི་གྲོགས་པོ་ཡིན་པས་ཁོ་ཚོས་ཁྱེད་རང་ལ་རོགས་པ་བྱེད་སྲིད།",
    "དེ་མིན་ལས་བྱ་དཀྱུས་མ་ཁ་ཤས་འདུག་ཧོང་ཅིང་ལིས་ཁོ་ལ་སྐད་ཆ་ཚིག་ཁ་ཤས་དྲིས་པ་དང་།",
    "དེ་རྗེས་ཁོ་རང་གཞི་ནས་བརྩེ་བའི་ཆུང་མའི་འགྲམ་དུ་ལོག་ཅིང་།",
    "ཉིན་གཉིས་པའི་ཞོགས་པ་ཆུ་ཚོད་བཅུ་པ་ཙམ་ལ་ཁོ་རང་ཞོགས་བཟས་གྲུབ་རྗེས་ཀུང་སིར་ལས་ཀར་ཐོན།",
    "མི་ཚོས་མངོན་ལྐོག་གང་རུང་ནས་ཁོ་རང་དམིགས་འབེན་ཞིག་ལྟར་འཐབ་རྩོད་ཀྱི་མདའ་རྩེ་ཁོ་ལ་གཏད་ཡོང་ཞིང་།",
    "ཁོ་རང་ཡོངས་སུ་ཡིད་ཐང་ཆད་པར་གྱུར།",
    "ཁོ་རང་ཁོའི་གཅུང་པོ་གཉིས་ལ་འགྲན་ཡ་མི་ཕོད་ཅིང་།",
    "འོན་ཀྱང་ཁོས་ཤེས་མི་སྲིད་པ་ནི་ཁོ་རང་ཡང་དེ་སྔོན་བྱིས་པའི་སྐབས་ཕ་མ་གཉིས་པོའི་དེ་འདྲའི་གཅེས་སྐྱོང་དང་།",
    "ཁོ་རང་ལས་བྱ་ཁང་དུ་སླེབས་ནས་རྐུབ་སྟེགས་སྟེང་མར་བསྡད་དེ་ཇ་ཕོར་པ་གང་དོ་བཏུང་ཚར་བ་དང་།",
    "དེང་སང་ཉིན་ཤས་རིང་ང་རང་གཟུགས་པོ་མི་བདེ་བས་ཁྱེད་ཚོར་བལྟ་བར་ཡོང་ཁོམ་མ་བྱུང་ཞེས་བཤད།",
    "བྱས་ཙང་ང་རང་ཡང་རས་ཏོག་ཙམ་ཉོ་འདོད།",
    "ཇིན་གྱིས་ཁོའི་ངང་ཚུལ་དེ་མཐོང་བ་དང་ཅུང་ཟད་དགོད་བཞིན་ཁྱེད་རང་སེམས་ཁྲལ་བྱེད་མི་དགོས།",
    "ཅན་ཡུན་ནི་ཧའེ་ཧའེ་ཞེས་རང་ཉིད་གཅིག་པུ་ཁུ་སིམ་མུར་དབུགས་རིང་གཏོང་བཞིན་འདུགཅན་ཡུན་ཁྱེད་རང་གཅིག་པུ་དབུགས་རིང་བཏང་ནས་སེམས་དོན་གང་ཡོད་དམ།",
    "ཕལ་ཆེར་ཁོ་རང་ལ་འཚོ་བའི་གནོན་ཤུགས་ཆེ་དྲགས་པས་ཡིན་ནམ།",
    "རྗེའུ་ཧུའི་ཡིས་ཁོའི་དཔུང་པ་ནས་བཟུང་སྟེ་ཁོ་ལ་ལྟ་བཞིན་ཧ་ལས་པའི་ངང་ཧུའི་རུའུ་ཁྱེད་རང་བྲེལ་བ་འདི་འདྲ་དོན་དག་གང་ཡོད་དམ་ཞེས་དྲིས།",
    "ཁོས་ཡབ་མེས་མཐོང་རིམ་བཞིན་ཁོང་ལ་གཡོལ་གང་ཐུབ་བྱེད་ཀྱི་ཡོད་ལ་ཡབ་མེས་དང་ཁོ་རང་སེམས་ནང་ནས་རྒྱང་ཐག་ཧ་ཅང་རིང་པོ་ཆོད་ཡོད་པ་རྟོགས།",
    "ན་བཟའ་དག་ཀྱང་རློན་རྐྱང་ཆགས་ནས་སྟོབས་ཞན་ནུས་མེད་ངང་དེ་གར་གཟིམ་འདུག་ཡབ་མེས་སྐྱེས་ས་ནས་ཀླད་པ་མཁྲེགས་བཟུང་དང་མི་དང་འབྲེལ་འདྲིས་དཀའ་བ་དེ་འདྲ་ཡིན་ནམ།",
    "ཁོའི་བསམ་པར་ཡབ་མེས་ཀྱིས་ཁོ་རང་གསུངས་གནང་སྟེ་འདི་གར་ཡུན་རིང་ལངས་ནས་སྒུག་བསྡད་པ་དང་།",
    "ཁོ་སྒོ་ཁར་སླེབས་པ་དང་ཡབ་མེས་ཀྱིས་ཡང་བསྐྱར་ཁྱེད་རང་ཡར་ཤོག་དང་།",
    "ཡབ་མེས་ཀྱིས་ཁྲེལ་དགོད་ཅིག་དགོད་དེ་ཧ་ཅང་རྫིག་ཉམས་ལྡན་པའི་འདྲེན་བྱེད་ཁོའི་ངོ་ལ་ལྟ་བཞིན་ཁྱེད་རང་སྐྱག་རྫུན་མ་ཤོད།",
    "འོན་ཀྱང་ངའི་ཁ་ཏར་མ་ཉན་པར་ད་ཆ་མ་རབས་ཐ་ཤལ་ཤ་སྟག་ཆགས་འདུག་ཁྱེད་ཚོ་ལྟོས་དང་།",
    "ཡབ་མེས་དེ་བས་ཁོང་ཁྲོས་རབ་ཏུ་ནོན་ཏེ་ཁྱེད་རང་ད་དུང་ཁ་རྒྱགས་པ་ཡོང་།",
    "ཁྱེད་རང་དེ་རིང་ནས་བཟུང་ཕྱི་ལོགས་སུ་ཕྱིན་ཆོག་མི་ཡོང་།",
    "ངས་ཁོང་ལ་བྱེད་རྒྱུ་གང་འདུག་གམ་བལྟས་ཆོག་ཅེས་ཆིག་ལབ་བརྒྱབ།",
    "གཅེན་པོ་རྗེའུ་ཤིན་གྱིས་མུ་མཐུད་སྔོན་ལ་ཁྱེད་རང་ཉིན་ཤས་རིང་ཁྱིམ་དུ་སྡོད་དང་།",
    "རྗེའུ་ཧུའི་ཡིས་གཅེན་པོ་རྗེའུ་མིན་གྱིས་ཁོ་རང་ལ་ཁྲེལ་དགོད་བྱེད་པ་ལྟར་སྣང་བས་ཁོ་རང་བཟོད་སྒོམ་མ་ཐུབ་པ་ལྟར་དགོད་རྒྱུ་གང་འདུག་གམ།",
    "མི་དེས་རྡོ་ཟམ་བརྒྱུད་ནས་མདུན་དུ་ཡོང་ཞིང་སྐྲ་ཡི་ལན་བུ་རྒྱབ་ཏུ་དཔྱང་འདུག་མི་དེ་དེ་བས་མདུན་དུ་ཇེ་ཉེར་བཅར་བ་དང་།",
    "ཁྱེད་རང་སེམས་ཁྲལ་བྱེད་མི་དགོས།",
    "གཟབ་གཟབ་གནང་ཨང་ཞེས་འབོད་བཞིན་འདུག་པས།",
    "ཁོང་ཉ་འཛིན་སྟེགས་བུའི་སྟེང་དཔེ་དེབ་ཀློག་བཞིན་འདུག་རྗེའུ་ཧུའི་ཡིས་དེ་ལྟར་ལན་བཏབ།",
    "སུས་ཁྱེད་རང་ལ་གཡོལ་གྱི་འདུག་གམ།",
    "མ་ཟད་ཁྱེད་རང་ལ་དུས་ཚོད་མེད་པ་ག་ལ་ཡིན་ཏེ།",
    "ཁྱེད་རང་ད་དུང་སྐད་ཆ་མི་ཤོད་པ་གང་ཡིན་ནམ།",
    "ཁྱེད་རང་ད་ཆ་ང་ལ་དགའ་པོ་མེད་པ་ཡིན་ནམ།",
    "ཡང་མིན་ན་མི་གཞན་གྱིས་ཐོས་ཡོང་བསམ་གྱི་འདུག་གམ།",
    "ངས་ལྕམ་སྐུ་ཞབས་ལ་ཁྱེད་རང་སྔ་ཙམ་ཕྱིར་མནའ་མར་གཏོང་རོགས་ཞུ་ཡི་ཡིན།",
    "ངས་ཁྱེད་རང་ངའི་ཆུང་མར་ཉར་རོགས་ཞུ་ཡི་ཡིན།",
    "ཐ་ན་ངས་ད་བར་ཁྱེད་རང་ལ་རྣམ་འགྱུར་ཡག་པ་ཞིག་བསྟན་མ་མྱོང་བས་ངས་ཁྱེད་རང་ལ་དགོངས་པ་མ་འཚོམས་ཟེར་རྒྱུ་ཡིན།",
    "ངས་ཁྱེད་རང་ལ་ཚིག་ཟ་བྱེད་ག་ལ་སྲིད།"
  ]
}