    "དགྲ་ལྷ་སོགས་སུ་བརྩིས་ནས་གོང་དུ་བཀུར་ནས་མཆོད་སྲོལ་ཡོད་པས་ཡིན་འདུག་ལ།",
    "བསྐང་གསོའི་ཆོ་ག་ལ་བརྟེན་ནས་གནའ་དུས་ཀྱི་རྣམ་པ་རྟོགས་ཐབས་ཀྱང་མི་འདུག་ལ་བརྟན་མ་བཅུ་གཉིས་ནང་དུ་ཚེ་རིང་མཆེད་ལྔ་དང་།",
    "བི་རོ་ཙ་ན།",
    "ཡིག་རྙིང་སྔ་ཤོས་དེ་གཉིས་སུ་བརྟག་དུས་གནའ་བོའི་བོན་གྱི་ཆོ་གའི་རིགས་ཧ་ཅང་མང་པོ་ཞིག་ཡོད་པའི་སྐོར་གསལ་པོར་འཁོད་འདུག་ལ།",
    "༡ཞེས་འཁོད་འདུག་པ་འདི་ཡིན་འདུག་ལ།",
    "༦ཞེས་ཐང་དེབ་ལས་བསྒྱུར་བ་བཀོད་འདུག་པས་ཀྱང་ཤེས་ཐུབ་ལ།",
    "ཐོག་མར་སྐུ་ལྷ་གསོལ་བ་དང་ཆོ་ག་སྤྱི་མཐུན་པ་གནོད་པར་དོགས་པ་དེ་ཡང་སློབ་དཔོན་པད་མས་སྐུ་ལྷ་དམ་འདོགས་ཀྱི་ཆོ་ག་བྱས་པའི་རྗེས་སུ་འཆམ་པ་ཡིན་འདུག་སྟེ།",
    "བོན་སྒོ་བཞིའི་དགོངས་པ་དང་འཕེལ་རྒྱས་བཏང་བ་ཅི་ཙམ་འདུག་དཔེར་ན་ཕ་མྱེས་མགོན་ལྷ།",
    "༡༢ཞེས་འཁོད་འདུག་པ་དང་།",
    "༡༥ཞེས་གསུངས་པ་ལ་བརྟེན་ནས་དྭགས་བརྒྱུད་པ་ལ་བླུན་བསྒོམ་ཞེས་པའི་མིང་འདོགས་རིམ་པས་བྱུང་བ་ཡིན་འདུག་ལ།",
    "༡༦ཞེས་སོགས་ཀྱིས་ཐོས་བསམ་བཀག་ལུགས་ལ་དམིགས་ཕུགས་ནས་བརྗོད་འདུག་པས།",
    "༢༦ཞེས་སོགས་བཀོད་འདུག་པ་ལ་བསམས་ནའང་།",
    "དེ་ཕྱིན་ཆད་ཀར་འབྲུག་ཕལ་ཆེར་ཐ་སྙད་ཀྱི་སྤྲོས་པ་ལ་དབུ་འཁོར་ནས་སྔོན་གྱི་སྒྲུབ་ཚུགས་བཟང་པོ་དེ་ཅུང་ཟད་ཉམས་པར་སེམས་༢༨ ཞེས་བཀོད་པ་བཞིན་དུ་བྱུང་བ་ཡིན་འདུག་ལ།",
    "ཀར་འབྲུག་གཉིས་སུ་གདའ་ནའང་།",
    "༣ཞེས་ཕུར་ལྕོགས་བྱམས་པར་གསུང་ཚུལ་འཁོད་འདུག་པས།",
    "སྔོན་འབྲི་གུང་པའི་བསྟན་པ་དར་དུས་རྗེ་མི་ལའི་སྒྲུབ་གནས་ཀུན་ཏུ་སྒྲུབ་གྲྭ་ཚུགས་པ་བྱུང་འདུག་ཅིང་།",
    "ད་ལྟ་རྗེ་མི་ལའི་སྒྲུབ་གནས་མང་ཚེ་བ་ས་སྟོང་ལུང་སྟོང་མི་མེད་ཁྱི་མེད་དུ་གྱུར་ནས་ཡོད་པ་འདི་བྱུང་འདུག་དྭགས་པོ་བཀའ་བརྒྱུད་ཀྱི་གདན་ས་སྒམ་པོ་ཡང་མངའ་ཐང་ཉམས་མགོ་ཚུགས་ནས་རིམ་པས་ཉམས་མགོ་ཚུགས་ཤིང་།",
    "ཁྱད་པར་སྙིགས་མའི་ཡིད་ཅན་ལ་ཚུལ་གནས་ཀྱི་དགེ་སྦྱོར་ལས་ཟོག་པོ་བྲིན་ཚུལ་གསུངས་བ་ལྟར་དེ་ཉིད་མ་རྟོགས་པའི་སྐྱེ་བོ་རྣམས་འབྲུག་པར་དད་པ་ཞིག་འདུག་པར།",
    "༣༣ ཞེས་བཀོད་འདུག་པས་མཚོན་ལ།",
    "བཀའ་བརྒྱུད་ཀྱི་གདན་ས་རྣམས་རྙིང་མའི་གདན་ས་ཡིན་ཚུལ་གསལ་བར་བཀོད་འདུག་པས་ཀྱང་གསལ་བར་རྟོགས་ཐུབ་པ་ཡིན་ནོ།",
    "གང་ཟག་གསར་དད་དང་རང་ཚུགས་མེད་ཅིང་།",
    "ཀླུ་དགོངས་གླེང་མཁན་ཚོས་ཀྱང་རང་ཕྱོགས་སུ་འཐེན་པ་དང་།",
    "ད་ནི་ངོ་ཡང་ཚ་བར་འདུག་གསུངས་འདུག་༡ཞེས་དང་།",
    "བདུད་འཇོམས་ཀྱིས་ཤོག་བུ་གནང་བ་ཡང་ཁོ་རང་ལ་གཙང་བཤུས་བྱེད་སར་སྤྲད་པར་གོ་དགོས་པ་ལས་གསར་དུ་བྲིས་པའི་དོན་གཏན་ནས་མིན།",
    "ཞེས་པའི་ཚིགས་བཅད་བར་དུ་བྲིས་འདུག་པ་དེ་གནང་ནས་འདི་ལ་ལྟོས།",
    "རྫོགས་པ་ཆེན་པོ་རང་བྱུང་རང་ཤར་གྱི་རྩ་བའི་རྒྱུད་ལེའུ་བཅུ་གསུམ་པ།",
    "བཀའ་བརྒྱད་དྲག་པོ་རང་བྱུང་རང་ཤར་ཆེན་པོ་རྩ་བའི་རྒྱུད་ལེའུ་ཉེར་དྲུག་པ།",
    "རྒྱལ་ཚབ་རང་བྱུང་རང་ཤར་དུ་བྱོན་པ་ལེའུ་ཉེར་ལྔ་པ།",
    "ཀོང་པོ་སོགས་ཡུལ་འགའ་ཞིག་ཏུ་ལའང་འདི་དང་མཐུན་པའི་ལོ་གསར་བྱེད་པ་སྣང་ངོ་༡ ཞེས་བཀོད་འདུག་གཏམ་འདིའི་ཁུངས་ནི་རྒྱལ་བཞེད།",
    "༢ཞེས་གསུངས་འདུག་དེའི་ཁུངས་ཡང་ཟུར་མཁར་བའི་རྡོ་རིང་དྲིས་ལན་དུ་ཧོར་ཟླ་དང་པོ་མཆུའི་ཟླ་བ་ལ་དཔྱིད་ཟླ་ར་བར་བྱེད་པ་འདི་ཕྱི་མ་རྒྱུད་གཡུ་ཐོག་མགོན་པོའི་ཕྱག་དཔེ་དངོས་དང་རྒྱ་ནག་དང་ཧོར་ཐམས་ཅད་མཐུན་ཞིང་།",
    "༤ཞེས་གསལ་པོར་བཀོད་འདུག་པ་འདི་ལ་ཇི་ལྟར་འགྲེལ་དགོས།",
    "རང་ཉིད་ལ་ཡང་རང་བསྟན་ལ་བརྩེ་བ་དང་དད་འདུན་བྱེད་ཆོག་པ་དང་།",
    "༡ཞེས་འཁོད་འདུག་ལ།",
    "༨ ཞེས་གསལ་པོར་བཀོད་འདུག་ལ།",
    "དེ་ནི་ཁྱབ་ཆུང་ངུའི་རྣམ་གཞག་གཅིག་ཡིན་འདུག་སྟེ།",
    "བྲང་ཞོམ་སྐྲ་མཚམས་ཡོ་བར་གདའ།",
    "འཇིག་རྟེན་ཡོངས་ཀྱི་འདུག་ལུགས་ཡིན།",
    "མཁས་པ་རྣམས་ཀྱིས་ནོར་ནས་འདུག།",
    "ལྷ་བྲིས་པ་ཕྱོགས་གཞན་ནས་གདན་དྲངས་པ་ཁོ་ན་མིན་པར་འབྲི་གུང་རང་ས་ན་ལྷ་བྲིས་པའི་རྒྱུན་ལེགས་པོ་ཡོད་པར་མཚོན་ཡོད་ལ།",
    "བླ་རབས་ལ་གྲུབ་ཆེན་བརྒྱད་བཅུས་བསྐོར་བ་སྤུས་གཙང་རིག་ཡོད་འདུག་པ་ལས།",
    "དཔེ་བཞག་ན་འདྲ་མ་འདི་འདྲ་གདའ།",
    "ཞེས་གདའ་སྒྲས་རྣམ་པ་གསལ་བྱེད།",
    "འདི་ནས་ཞེས་བྲིས་འདུག་པས་དང་།",
    "གོང་གསལ་གནས་དག་དུས་དེར་གྱང་རོ་ལས་མ་གནས་པའི་ཕྱིར།",
    "ཞེས་གསུངས་འདུག་པ་ནི་སྤྱིར་བཏང་ལྟར་བྱས་ན་བཟློས་སྐྱོན་དུ་ཕྱིན་པར་སྙམ་ཏེ།",
    "ཞེས་གསལ་པོར་བཀོད་འདུག་དུས་རབས་ཉི་ཤུའི་ལོ་རབས་ལྔ་བཅུའི་སྔ་རྗེས་སུ་བོད་དུ་འདྲ་རིས་འབྲི་སྲོལ་གྱི་རྒྱུན་ཤས་དར་ཡོད་ན་ཡང་།",
    "བོད་ཀྱི་རྩོམ་དངོས་མ་ནི་འདི་ཚོ་ཡིན་འདུག་སྟེ།",
    "ཁ་བྱང་དུ་ཐུབ་བསྟན་འོད་གསལ་བསྟན་པའི་ཉི་མ་ཞེས་བཀོད་གནང་འདུག་སྟེ།",
    "ཁ་བྱང་དུ་ས་སྐྱ་པ་༤་ཀ་རྒྱལ་མཚན་དང་ལ་བཟང་ཞེས་བྲིས་འདུག་པར་བརྟེན།",
    "ད་ཆར་ཕུན་སུམ་ཚོགས་པའི་དཔེ་མཛོད་འདི་གྲུབ་པར་གྱུར་འདུག་དང་ཐོག་གདན་སའམ་རི་ཁྲོད་དམ་ལྷ་ཁང་སོགས་གནས་མ་ངེས་པ་རྣམས་སུ་དུས་མ་ངེས་པར་བརྩམས་པའི་ཡི་གེ་རྣམས་འབྲི་བ་པོ་མ་ངེས་པའི་སོར་རྩེའི་སྒྱུ་རྩལ་ལས་ཐོན་པའི་གནའ་དཔེ་དེ་རྣམས་འདིར་འདུས་པ་ལས་རྣམ་པ་འདི་རིམ་པར་གྲུབ་པ།",
    "གནའ་དཔེ་རྣམས་འབྲས་སྤུངས་སུ་ཕྱོགས་བསྡུས་བྱས་རྗེས་ཐོར་གྱུར་མི་ཡོང་བའི་ཆེད་དུ་དཀར་ཆག་ཐོ་འགོད་ཞིབ་ཕྲ་ཞིག་བྱས་ཡོད་འདུག་པ་ནི།",
    "དེའི་ཚབ་མཚོན་ཡི་གེའི་སྒྱུ་རྩལ་ཀྱི་འཕེལ་རིམ་ཡང་ལག་མཐིལ་དུ་སྐྱུ་རུ་ར་བཞག་པ་ཇི་བཞིན་མཐོང་ཐུབ་ཀྱི་འདུག་དཔར་མ་ལ་པེ་ཅིན་དཔར་མ་དང་།",
    "སྒྲུང་དཔེ་སོགས་ཚང་མའི་ནང་དུ་གསལ་པོར་འཁོད་འདུག་སྟེ།",
    "བསད་ཀྱང་སྟོང་ལ་དྲེས་ཐག་གཅིག་༧ཅེས་བཀོད་འདུག་པས་མཚོན་ཐུབ་ལ།",
    "སྐྱེ་མེད་པའི་མིང་བཏགས་འདུག་ཅིང་།",
    "དཔེ་མི་སྲིད་པ་བཞིན་དུ་ཇི་ཙམ་སྨོད།",
    "ལྷག་པར་དབུགས་ཁང་མཇལ་བར་འགྲོ་བའི་སྲོལ་རྒྱ་ཁྱབ་ཅན་ཡིན་འདུག།",
    "ཐོག་མར་བསམ་ཡས་དགོན་དང་འབྲེལ་བའི་དབུགས་ཁང་འདི་ཉིད་ག་དུས་བྱུང་བ་ཡིན་མིན་དཔྱད་ན།",
    "སྐབས་དེར་རྒྱལ་པོ་པེ་ཧར་ཞེས་པ་འདི་ཉིད་ཡོད་པའི་དོན་མིན་པར་འདུག་སྙམ།",
    "པེ་ཧར་ཅོག་ནི་རྒྱལ་པོའི་རྟེན་ཁང་ཡིན་འདུག་ཅིང་།",
    "༥ཞེས་བཀོད་འདུག་པ་ལ་བསམ་ན།",
    "ཐིག་ལེ་སྟེ་དྭངས་མ་ནི་སེམས་ཀྱི་རྟེན་དུ་གསལ་པོར་གསུངས་འདུག་པ་ལས།",
    "རྩ་ཆད་དུ་གྱུར་པའི་སྣང་ཚུལ་འདི་རིག་དུས་ནང་པར་ཞེན་ཆེ་བ་ལ་ལས་སེམས་ཕམ་ཆེན་པོ་བྱེད་པ་དང་།",
    "དེ་དག་དང་འབྲེལ་ཡོད་པ་ཡིན་འདུག་པ་མཐོང་ཐུབ་སྟེ།",
    "བསམ་ཡས་ནི་གནའ་བོའི་བོད་མིང་རང་ཡིན་པ་ནི་བྲག་དམར་བསམ་ཡས།",
    "དཔེར་ན་ཉང་པོ་རི་ཁ་དགོན་དེ་རྒྱ་བཟས་རྒྱང་ནས་རིག་དུས་ད་གའ་བོ་བྱུང་བས་རིག་དགའ་དགོན་དུ་བཏགས་ཚུལ་ལྟ་བུ།",
    "དོན་དངོས་དང་མི་མཐུན་པའི་མ་དག་རྒྱུན་འབྱམས་ཀྱི་ཐ་སྙད་བཀོལ་བའི་ནོར་འཁྲུལ་ཆེན་པོ་ཞིག་ཆགས་འདུག་པས།",
    "དབུས་ཀྱི་གྲྭ་ས་ཆེན་པོ་དྲུག་ཅེས་བོས་སྲོལ་ཡོངས་ཁྱབ་ཏུ་བྱུང་འདུག་ལ།",
    "ཁ་དར་གནང་བ་ཞེས་པའི་སྲོལ་ཡང་བྱུང་འདུག་པས།",
    "༧ཞེས་འཁོད་འདུག་པ་ལས།",
    "༡༣ ཞེས་བཀོད་འདུག་དེའི་ཐོག་ལྟས་ངན་བརྒྱད་ཅུ་རྩ་གཅིག་དེ་ནི་ལྟས་ངན་པ་ལས་ཀྱང་ངན་པ་ཞིག་ལ་གོ་དགོས་པ་གསལ་ལ།",
    "ཐན་ལྟས་དེ་ལྟས་ངན་ཡིན་པ་ཤོད་མི་དགོས་ཀྱང་ཡོངས་གྲགས་ཀྱི་ལྟས་ངན་བརྒྱད་ཅུ་དང་ཐ་དད་ཡིན་པའི་བཟོ་ཞིག་འདུག་ལ།",
    "དམངས་ཀྱིས་ཉི་མ་གོས་ཕུད་འདུག་ཅེས་དོགས་པ་ཟ་བ།",
    "ཞབས་ཕྱི་ཁ་ཤས་ལ་རྨི་ལྟས་ངན་པ་འགའ་བྱུང་འདུག་༢༢ཞེས་འཁོད་ཅིང་།",
    "སྐྱབས་མགོན་རྣམ་གཉིས་ཟླ་བ་གཅིག་ནང་སྐུ་གཤེགས་པའི་སྔ་ལྟས་སུ་ངོས་འཛིན་བྱས་འདུག་པས་མཚོན།",
    "གལ་ཏེ་འབྲེལ་བ་མེད་ན་དེ་ལྟས་ངན་དུ་ངོས་འཛིན་བྱ་དགོས་མི་འདུག་ཀྱང་དེ་ཅི་ཡིན།",
    "ཞེས་འཁོད་འདུག་ཁོང་ནི་ལྷོ་ཁ་འཕྱོང་རྒྱས་ཚེ་རིང་ལྗོངས་སུ་འཁྲུངས་པ་ལས་མལ་གྲོར་འཁྲུངས་པ་ག་ལ་ཡིན།",
    "དེ་རྗེས་ས་ཡོས་ལོ་སྤྱི་ལོ་༡༨ ༡༩དང་ལྕགས་འབྲུག་ལོར་སྤྱི་ལོ་༡༨༢བསྐྱར་ཞིབ་བྱེད་སྐབས་ལོ་དེ་གའི་དགུང་གྲངས་གཤམ་དུ་ཨང་འགོད་བྱས་པ་ཡིན་འདུག་པས་སོགས་ཀྱིས་དུས་ཚོད་གང་ཙམ་ཤེས་ཐུབ་པ་ཡིན་ལ།",
    "རིགས་ཀྱི་དབྱེ་བས་རིགས་དེ་ལ་བོད་རིགས་ཞེས་འབོད་སྲོལ་བྱུང་འདུག་མི་རིགས་དེའི་མེས་པོ་རྣམས་ནི་ས་མཐོ་ཞིང་རི་ཚོགས་མཐུག་པའི་ཁྲོད་དུ་གནས་ཀྱང་།",
    "༦ཅེས་བཀོད་འདུག་ལ།",
    "༨ ཞེས་འཁོད་འདུག་པ་དང་།",
    "མ་དགོངས་པ་ཤེས་བྱ་ལ་མི་སྲིད་པ་ཡིན་པའི་འདུ་ཤེས་སྲ་བརྟན་དུ་གནས་འདུག་ལ།",
    "བོད་སྡུག་དུས་ཁོང་ཁོ་ནས་སྐྱོབ་འགྲོ་བ་སོགས་དྲིལ་བསྒྲགས་མཛད་ཡོད་ལ།",
    "ད་ལྟའི་བར་དུ་དགག་དང་འགོག་བཞིན་འདུག་པས།",
    "ཞེས་ཀྱང་བཀོད་འདུག་ལ།",
    "སྔགས་རྙིང་མའི་རྒྱུད་འཛིན་ཚོས་ཀྱང་རང་ཉིད་ཀྱི་སྔགས་རྒྱུད་རྣམས་འཕེལ་རྒྱས་བཏང་ཞིང་།",
    "བན་རྩེའི་ཁྱད་ཀྱིས་གྲྭ་མི་གཙང་དང་གཙང་བའི་དབྱེ་གསལ་མེད་པའི་འདྲེས་མ་ལ་གོ་རིམ་བཞིན་ཡང་མི་འདུག་ཅིང་།",
    "༩ཞེས་སོགས་བཀོད་འདུག་པས།",
    "མཁན་ཆེན་དབུ་དམར་ར་༥ཞེས་པ་གསལ་པོར་བཀོད་འདུག་ལ།",
    "༦ཞེས་བཀོད་འདུག་ལ།",
    "མཁན་ཆེན་གྱི་ཁྲིར་མངའ་གསོལ་བ་ཞེས་ཆེད་དུ་གོ་སར་བསྐོ་བ་ལྟ་བུ་མི་འདུག་ཡང་རང་ཉིད་ལ་སྐུ་དྲིན་ཧ་ཅང་ཆེ་བའི་ངོས་ནས་ཀྱང་མཁན་ཆེན་ཞེས་བོས་པའི་རྒྱུན་ཡང་དར་ཁྱབ་བྱུང་ཡོད།",
    "༣ཞེས་གསུངས་འདུག་པ་དང་།",
    "གནོད་པའི་རིགས་བསླབ་མི་ཆོག་ཅེས་གཏན་ལ་ཕབ་འདུག་པས་ཤེས་ཐུབ།",
    "དུས་བསྟུན་གྱིས་གོམ་པ་སྤོས་ཐུབ་པ་བྱུང་བ་ཡིན་འདུག་ལ།",
    "༡ ཞེས་བཀོད་འདུག་པས།",
    "རྒྱ་གར་དུ་ནང་པ་བས་ཕྱི་པ་ཁྱབ་ཆེ་བ་ཡིན་འདུག་པས།",
    "ཕྱིས་ཀྱི་བཀའ་བརྒྱུད་པའང་རང་སྟོང་སྨྲ་བའི་ཕྱོགས་སུ་འཁུམ་པ་ཆགས་པ་དང་།",
    "ཞིང་བཅུ་ཟེར་བ་དེ་ཡིན་འདུག་འོན་ཀྱང་ཞིང་བཅུ་ཚང་བ་ཞེས་པ་དེ་ནི་ཕར་ཕྱོགས་ཁོ་ན་མ་ཡིན་པར་རང་ཕྱོགས་སུའང་ཡོད་འདུག་པ་ནི།",
    "ང་རྒས་ནས་སྡོད་ལོང་ནི་མི་འདུག་རྒྱང་མིག་རང་བལྟ་དགོས་པས་མིག་ཀྱང་ཚ།",
    "རང་གཞན་གྱི་ནོར་ཐམས་ཅད་གསོད་དགོས་པ་འདུག་ཟེར་སྐད།",
    "གཞན་གྱི་རིམ་གྲོ་པ་འདི་ཡང་རང་ལ་གནོད་པ་ཆེ་སྟེ།",
    "༡༤ཞེས་བཀོད་འདུག་རྨོངས་པ་ལ་ལས་ཁོས་གཏོར་བཟློག་སོགས་ལ་དགག་པ་བྱེད་པ་ནི་ལོག་ལྟ་སྟེ།",
    "སྲན་མ་མ་ཐུབ་ཡོས་ལ་ཆེམ་ཚེམ་ཟེར་བ་དེ་འདུག་དཔེར་ན་ནང་སོ་སྒར་པས་ཐམས་ཅད་བརྡུངས་པས།",
    "ནང་བསྟན་ནི་འཚེ་བ་མེད་པའི་ལྟ་གྲུབ་དང་སྤྱོད་པ་མངའ་བ་ཅིག་ཡིན་པ་ནི་རང་གཞན་ཀུན་གྱིས་ཁས་ལེན་པ་འདི་ཡིས་ཀྱང་མཚོན་བཞིན་འདུག་སྙམ།",
    "ཉམས་མཚོན་ཁྱད་པར་བའི་ངག་སྦྱོར་མེད་པའི་ལྟ་བ་བྱུང་འདུག་ལ།",
    "༦ཞེས་བཀོད་འདུག་པ་ནི་ཉམས་མཚོན་གྱི་སྒྲ་རྒྱན་ན་མ་ཟུང་ལྡན་གྱི་སྒྲ་རྒྱན་ཤ་སྟག་ཡིན་པས།",
    "འདུག་པའི་སྒོ་སྟབས་ཁྲིག་སེ་ཁྲིག།",
    "དར་ལྕོག་ལྷེབ་ལྷེབ་སོགས་ཟུང་ལྡན་ཉམས་རྒྱན་གྱིས་བོད་ཀྱི་སྐད་ཆའི་ནང་དུ་ཁྱབ་ཆེ་བར་སྤྱོད་བཞིན་འདུག་ལ།",
    "དམངས་ཁྲོད་ཀྱི་ལྡེའུ་གླུ་ཤགས་སོགས་ཀྱི་ཁྲོད་དུ་རྒྱུན་མ་ཆད་པར་ཉར་གསོག་བྱས་འདུག་པ་ནི་ངོ་མཚར་ཆེན་པོ་ཡིན།",
    "བོད་ཀྱི་བརྡ་སྤྲོད་ཀྱི་ཐ་སྙད་ཀྱི་སྤུས་ཚད་རྟོགས་བཞིན་འདུག་པས།",
    "སྤྱོད་པ་འཚེ་བ་མེད་པ་ཞེས་པ་དེ་དོན་དངོས་ཐོག་ཅི་ཞིག་ལ་ཟེར་བའི་ཚུལ་དེ་ཐོག་མར་ཤེས་དགོས་རྒྱུ་ནི་གལ་ཆེན་པོ་ཞིག་ཆགས་འདུག་ལ།",
    "བོད་དུ་འང་ཆེན་པོས་ཀུན་ཀྱང་ཤ་ལ་མཉེས་པའང་དེ་བཞིན་ཁུངས་སྐྱེལ་བྱ་སྲོལ་འདུག།",
    "འདེབས་ལས་སོགས་ཀྱིས་སྡིག་དང་མ་འདྲེས་པ་ཡིན་འདུག་ལ།",
    "གང་ལྟར་སྤུས་གཙང་ནི་ཧ་ཅང་ཉུང་ངུ་རུ་གྱུར་འདུག་པས།",
    "ཚེས་བཅུ་པ་ཞེས་པ་ནི་རྙིང་མ་བ་ཡིན་ཤུག་བྱེད་པའི་ལུགས་ཤིག་ཆགས་འདུག་སྙམ།",
    "༡ཞེས་བཀོད་འདུག་པ་ལས།",
    "དེ་མཚུངས་སུ་གཏེར་སྟོན་ཡར་རྗེ་ཨོ་རྒྱན་གླིང་པས་སྤྱི་ལོ་༡༣༢༣མཛད་པའི་བཀའ་ཐང་ཤེལ་བྲག་གམ་པདྨ་བཀའ་ཐང་༢དུ་གུ་རུ་ཚེས་བཅུ་ལ་འཁྲུངས་ཚུལ་བཀོད་མི་འདུག་ལ།",
    "གུ་རུའི་མཛད་པ་རྣམས་ཚེས་བཅུ་དང་སྦྲགས་གནང་མི་འདུག་པས།",
    "ཐ་སྙད་དེ་ལ་སླར་ཡང་བསྐྱར་གཞིགས་བྱ་དགོས་པ་ཆགས་འདུག་སྙམ།",
    "བཟའ་བཏུང་དེ་མིའི་སོར་མཛུབ་ཀྱི་ཚོད་མར་འདུག་ཐེ་ཚོམ་མེད་པར་གསོལ་བ་ལ་རོ་མཆོག་བརྒྱ་དང་ལྡན་པ་བྱུང་།",
    "ཐེག་ཆེན་སེམས་བསྐྱེད་དང་བྲལ་ན་གསང་སྔགས་ནི་མུ་སྟེགས་པ་དང་ཆ་ཡིན་འདུག་པས།",
    "འོད་ཚུར་འདུས་བཱིདམར་པོ་སྔགས་དང་བཅས་པ་འོད་དུ་ཞུ་ནས་བདུད་རྩིའི་རྣམ་པར་ལྟེམ་མེར་འདུག་པའི་ངང་ལས།",
    "མར་མི་དྭགས་གསུམ་ནས་བརྒྱུད་པར་གསལ་བར་འཁོད་འདུག་ཀྱང་།",
    "༤༢ཞེས་ཁུངས་གང་ལ་གཏུགས་མིན་ཡང་བསྟན་གནང་འདུག་པས།",
    "རྗེ་བཙུན་མིད་ལ་འཕྲིན་ལས་རྒྱས་པ་ལ་སྟོན་པ་དར་བློས་ངའི་གདུལ་བྱ་ལ་གནོད་པར་འདུག་སྙམ་པའི་ཕྲག་དོག་ཤུགས་ཆེན་ལངས་ནས་རྩོད་པ་བྱས་པ་དང་།",
    "དེ་བཞིན་དུ་གང་དུ་སླེབས་ཀྱང་རང་ཉིད་དྲིལ་བསྒྲོགས་ཤིང་།",
    "ཉེ་དུས་བོད་ནས་བྱུང་ཟེར་བའི་མཆོད་རྟེན་གྱི་ནང་གཞུག་འཁོར་ལོ་གསེར་བྲིས་མ་ཆེས་རྙིང་མ་ཡང་༦འདུག་པ་ཁོ་བོས་དངོས་སུ་མཐོང་བྱུང་།",
    "མི་སྒེར་གྱིས་ཉར་བའི་རྟེན་རྙིང་ཕྲུ་གུས་བརྐུས་ནས་ལྐོག་ཚོང་བྱེད་མཁན་ཡང་ཐོན་འདུག་པས།",
    "ཅེས་འགྲེལ་འདུག་པས་ཤེས་ཐུབ།",
    "བོད་དུ་པན་ཆེན་སོགས་ལོགས་སུ་དགར་བ་འགལ་འདུག་སྙམ།",
    "ད་དུང་མང་པོ་ཞིག་བྲིས་མི་འདུག་ཅེས་བསྟོན་པ་འདི་ཅུང་མ་ལེགས།",
    "དེ་དང་རང་ཡུལ་བར་གྱི་ཧེ་བག་གང་ཡོད།",
    "ད་ལྟ་བོད་དང་རྒྱ་ནག་ནང་དུ་ཉ་སྲོག་བླུ་འབོར་ཆེན་བྱེད་ཀྱིན་འདུག་དེས་ཉ་ཚོང་མཁན་ཚོ་ཕྱུག་པོ་ཡོང་རྒྱུར་ཕན་ཆེན་བཏགས་ཡོད་པས་ཉ་ལས་འཕེལ་རྒྱས་བྱུང་ཡོད་ལ།",
    "དེ་ནི་གཞན་དང་རང་མཉམ་པར་བལྟ་བ་དང་།",
    "༡ཞེས་སོགས་ཞིབ་ཙམ་བཀོད་འདུག་པ་དང་།",
    "༢ཞེས་གསུངས་འདུག་པས་ན།",
    "༦ཞེས་འཁོད་འདུག་ལ།",
    "༡ ཞེས་དང་ཡང་ཨོ་རྒྱན་པ་ལས་བརྒྱུད་པ་གཞན་ཡང་གསུངས་འདུག་ལ།",
    "༡༢ཞེས་ཞིབ་རྒྱས་སུ་བཀོད་འདུག་པས།",
    "༡༦ཞེས་རིམ་པས་བསྟན་འདུག་ལ།",
    "༡༧ཞེས་བརྡེག་ཐབས་ཀྱི་ཀུན་སློང་རྣམས་གསལ་བར་བསྟན་འདུག་པས།",
    "༢ཞེས་སོགས་བཀོད་འདུག་པས་ཀྱང་།",
    "༡ཅེས་འཁོད་འདུག་ལ།",
    "དགོས་པ་སོགས་འདྲི་བརྩད་བྱ་མཁན་ཡང་འདུག་པས།",
    "སྔོན་དུས་པར་ཤིང་དུ་བརྐོས་པ་ཡོད་འདུག་པའི་ངོས་༢་པ་ལས།",
    "དེས་ཁམས་པ་དབུ་སེ་ལ་གནང་ནས་རིམ་པས་བརྒྱུད་དེ་གྲུབ་ཆེན་ཀརྨ་པ་ཤིའི་གསུང་འབུམ་གྱི་ནང་ནས་འཁོར་ལོའི་འདིའི་ཕན་ཡོན་མང་བར་འདུག་པ་སོགས་དར་རྒྱས་ཡུན་གནས་སུ་བྱུང་བའོ།",
    "༥ཞེས་གསལ་བར་འཁོད་འདུག་དེས་ན་བཙན་པོའི་སྐབས་སུ་དར་བའི་བཞེད་སྲོལ་ཡོད་པ་མ་ཟད།",
    "མ་ཎི་འཁོར་ལོའི་ཁུངས་དང་ག་དུས་བྱུང་བ་ཁུངས་སྐྱེལ་དངོས་ཡོད་མེད།",
    "མ་ཎི་འཁོར་ལོའི་སྐོར་རྩ་བ་ནས་གསུངས་མི་འདུག།",
    "བློན་ཆེན་མགར་སྟོང་བཙན་ལ་མ་ཎི་ལག་བསྐོར་ཡོད་པ་ལྟ་ཞོག་བཙན་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་ཡབ་སྲས་སོགས་སྔ་དར་དུས་སུ་བྱུང་མྱོང་མི་འདུག་ལ།",
    "༡༢ཞེས་གསུངས་འདུག་པར་གཞིགས་ན།",
    "ཆུ་འཁོར་གྱི་སྒྲོས་ཀྱི་རྩ་བར་དངུལ་ཆུ་དངོས་སུ་བྱུང་བ་ཆུ་དཔོན་གྱིས་བླངས་འདུག་པ་དང་།",
    "༡༤ཞེས་བཀོད་པ་ནི་མ་ཎི་བཀའ་འབུམ་གྱི་དགོངས་པ་ཡིན་པ་ལྟར་བཀྲལ་འདུག་ཀྱང་།",
    "དེའི་བཀའ་ལན་དུ་ལུགས་འདི་བཞིན་ཇོ་བོ་རྗེ་ཡབ་སྲས་དང་རྗེ་ཙོང་ཁ་པ་ཆེན་པོའི་ཕྱག་བཞེས་སུ་ཕེབས་པ་ཞིག་མིན་འདུག་ཅིང་།",
    "རྗེ་བཙུན་བློ་བཟང་ཡེ་ཤེས་གཉིས་ཀྱི་སྐུ་རིང་ལ་འཁོར་ལོ་མང་དུ་འཛུག་པར་མཛད་འདུག་ཅིང་།",
    "༡༧ཞེས་འཁོད་འདུག་པས།",
    "༡༨ ཞེས་སོགས་མང་དུ་བཀོད་འདུག་པ་དང་།",
    "མ་ནི་འཁོར་ལོ་གཅིག་པུ་བསྐོར་ན་འགྲིག་པ་འདུག་ཕྱོགས་གཞན་ཞིག་ནས་བསམ་ན།",
    "འདུ་ཁང་ནང་དུ་ཡང་བསྐོར་བཞིན་འདུག་པའང་།",
    "ཅེས་གསུང་པར་གྲགས་པའི་གཏམ་རྒྱུད་སོགས་འདུག་པས།",
    "གནས་ཤིང་སྤྱོད་པ་ནི་སྤྱོད་ཅིང་འདུག་པའོ།",
    "གཞན་གྱི་སྡུག་བསྔལ་ཡལ་བར་འདོར་བ་ནི་ཐ་མལ་པར་འདུག་པ་ཉིད་དོ།",
    "གལ་ཏེ་ཐ་མལ་པར་བདག་འདུག་ནའོ།",
    "དོགས་མེད་མི་གཡོ་ཞེས་བྱ་བ་འདིའི་བསྡུས་པའི་དོན་ནི་གང་འདུག་པ་དང་།",
    "ཇི་ལྟར་འདུག་པ་དང་།",
    "ཅིའི་ཕྱིར་འདུག་པ་སྟེ།",
    "ཇི་ལྟར་གླགས་མི་ལྟ་བར་འདུག་ཅེ་ན།",
    "ནགས་ཚལ་སྟུག་པོའི་ནང་དུ་འདུག་པ་ནི་ལུས་ཀྱི་སྡུག་བསྔལ་ཡིན་ཏེ།",
    "གཅིག་པུར་གྲོགས་ཀྱི་། ནང་འདུག་འདྲ།",
    "ཇི་སྲིད་དུ་འདུག་པ་དེ་སྲིད་དུ་ཡང་མི་བདེ་བའི་གནས་སུ་གྱུར་ཅིང་མི་བདེ་བའི་གཞིར་གྱུར་པ་སྟེ།",
    "མི་གཡོ་བར་དེ་བཞིན་འདུག་པ་ཞེས་བྱ་བ་ནི་ལུས་ཀྱི་ཚོར་བ་ལ་སོགས་པས་སོ།",
    "ངོ་མཚར་ཆེར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི་མི་གཡོ་ཞིང་དེ་བཞིན་དུ་འདུག་པའི་ཕྱིར་ཏེ།",
    "རྨད་དུ་བྱུང་བ་ནི་མི་གཡོ་བར་དེ་བཞིན་འདུག་པ་སྟེ།",
    "སྣུམ་པ་ཡང་ཡིན་ལ་རྣམ་པ་སྣ་ཚོགས་པ་ཡིན་པས་སྣུམ་སྣུམ་ལྟར་འདུག་པ་རྣམ་པ་དུ་མའི་ཤིང་ལྗོན་པ་སྟེ།",
    "ལོ་མ་རྣམས་ཀྱིས་བརྒྱན་པའི་ཤིང་ལྗོན་པ་སྣུམ་སྣུམ་ལྟར་འདུག་པ་རྣམ་པ་དུ་མའོ།",
    "ལོ་མ་རྣམས་ཀྱིས་བརྒྱན་པའི་ཤིང་ལྗོན་པ་སྣུམ་སྣུམ་ལྟར་འདུག་པ་དུ་མས་གང་བ་སྟེ་སེམས་མེད་པའི་དགའ་པའོ།",
    "དེ་ལ་མིག་ཚུགས་ལྟ་ཞིང་བྲིས་བཞིན་འདུག།",
    "འདུག་བཞིན་དུ་ཞེས་བྱ་བ་སྟེ་མཚོན་རྡེག་པར་བྱེད་དོ།",
    "ཆུ་ཀུན་ཐ་མལ་འདུག་ལས་རབ་ཏུ་གཡོས།",
    "ཆུ་ཀུན་ཐ་མལ་འདུག་ལས་རབ་ཏུ་གཡོས།",
    "ཆུ་ཐ་མལ་པར་འདུག་པ་ལས་རབ་ཏུ་བསྐྱེད་པ་ཉིད་ནི་སྒྲ་སྒྲོགས་པ་དང་།",
    "དགྲ་རྣམས་སྟོབས་ཆེ་ཞིང་དེའི་གནས་ན་འདུག་པ་དང་།",
    "པདྨའི་ལོ་མ་ནི་རྒྱན་འཁྲུགས་ཤིང་འདུག་པར་མཐོང་ཞེས་བྱ་བ་དེ་དག་བསྟན་པར་གྱུར་པའོ།",
    "ཚངས་བའི་འཇིག་རྟེན་དུ་སྐྱེས་བ་ལས་ཀྱང་རིགས་པར་མཐོང་། བའོ་། བཀའ་མཆིད་གདའ་བ་ཞེས་བྱ་བ་ནི་བདེ་བར་འགྱུར་བའི་ཡོན་ཏན་སྟོན་པ་ཡིན་ནོ།",
    "འདི་ན་འདུག་པའི་མི་རིགས་སོ་ཞེས་བྱ་བའི་ལན་ནི་འདི་ན་མཆིས་པ་ལས།",
    "གལ་ཏེ་གུད་དུ་མཆིས་ཀྱང་རྒ་ཤི་མེད་པར་འགྱུར་ན་འདི་ན་འདུག་པའི་མི་རིགས་ན་དེ་མེད་པས་སོ།",
    "རྒ་བ་མེད་པ་ནི་མ་ཡིན་པར་འགྲོ་བར་ནི་མི་རིགས་པས་འདུག་པ་ནི་རིགས་པ་ཉིད་དེ་དེའི་ཕྱིར་སྨྲས་པ།",
    "བདེ་བར་འདུག་བཞིན་དུ་ཞེས་བྱ་བ་ནི་བག་ཚ་བ་མེད་པར་རོ།",
    "བཟོད་པར་གསོལ་བ་ནི་མི་སྨྲ་བར་འདུག་པ་དེ་ལའོ།",
    "གནས་པའི་སྐྱོན་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་ཏུ་འདུག་པ་ལ་སོགས་པའི་སྐྱོན་ཡིན་ཏེ།",
    "དཀའ་ཐུབ་ཀྱི་ནགས་ན་འདུག་། བཞིན་དུ་སྤྲེའུ་ཆེན་པོ་མེད་པར་བྱས་པའོ།",
    "འདུག་པ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་གྱུར་པས་འགྲོ་བའི་སྐབས་མེད་དོ།",
    "འབབ་ཆུའི་འགྲམ་ན་འདུག་པར་ངེས་པའི་ཕྱིར།",
    "མཚོན་ཆ་ཐོགས་ཏེ་ཞེས་བྱ་བ་ནི་གང་སྔར་བསྟན་པའི་གསོལ་ཀ་བའི་ལག་ན་རལ་གྲི་འདུག་པ་བླངས་ཏེ་ཞེས་བྱ་བ་དེ་ཉིད་སྟོན་ཏོ།",
    "དེས་བརྟན་པ་འདུག་པའི་ཚུལ་ནི་བཟོད་པ་སྨྲ་བ་ཡིན་ནོ།",
    "ཞེས་བྱ་བའི་སྒྲ་སྨྲ་ཞིང་འདུག་པའོ།",
    "གཞལ་མེད་ཁང་ཞེས་སྨོས་པས་ནི་བདག་ཉིད་ཕྱོགས་དེ་ན་འདུག་པའོ།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ།",
    "མ་འཇུངས་ཤིང་རང་བཞིན་བཟང་བའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་ནི་རྒྱུ་ཕུན་སུམ་ཚོགས་པ་བསྟན་ཏོ།",
    "ལྷ་དེ་ལས་ཅི་ལེགས་པར་མཛད་ཅིང་བཀའ་གྲོས་མཛད་པའི་དུས་ལ་བབ་པོ་ཞེས་གསོལ་ཏོ་ཞེས་བྱ་བ་དེ་གཉི་ག་དུས་ལ་བབ་པ་ཉིད་དུ་བསྟན་པ་དེའི་དེ་ལྟར་མི་བྱ་བའི་རྒྱུ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "བགྲད་པ་དང་འཇིགས་འཇིགས་ལྟར་འདུག་པ་ནི་བགྲད་པ་དང་འཇིགས་འཇིགས་ལྟར་འདུག་པ་སྟེ།",
    "དེ་ནས་སྨིན་དྲུག་དུས་རྟག་ཏུ་གཞོན་ནུར་གནས་སོ་གླང་པོའི་གདོང་།",
    "མེ་ཡིས་བསྲེགས་དང་རང་བཞིན་སྒྱུར།",
