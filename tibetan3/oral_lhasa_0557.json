    "སྟོབས་ལྔ་ལམ་གྱི་རིམ་པར་སྒྲིགས་དང་ཟབ།",
    "སྔོན་བྱོན་རྒོད་ལྡེམ་སྤྲུལ་རབས་ནོར་བུའི་ཐིག་ལེར་བཟླུམས་འདྲ་པདྨའི་འཕྲིན་འདེགས་ཟླ་མེད་ཀྱི་བཀའ་དྲིན་མི་ཆུང་ཞིང་རྒན་པོའི་ཚེ་ལྷག་ལུས་ངག་ཡིད་ཀྱི་བགྱི་བའང་སྲས་བཅས་རྒྱལ་བའི་མཆོད་སྤྲིན་དུ་འགྱུར་ངེས་ཟབ་གསང་ཏིང་འཛིན་མི་ལྷོད་པ་མཁྱེན་མཁྱེན།",
    "བསྒྱུར་བཀོད་ཚངས་པའི་གཡོ་བ་གནས་མ་ལགས།",
    "མཁས་དང་མི་མཁས་མཁྱེན་པའི་རྩལ་ཤུགས་ཏེ།",
    "ངོ་ཚ་བྲལ་བའི་དབྱིངས་ན་རྨོངས་པར་མཉམ།",
    "ཏང་གཉིས་འཐབ་མཐར་རྣམ་པར་རྒྱལ་བའི་སྲིད།",
    "རྡོ་སྦིས་གཉིས་ཀྱི་པད་འཛུམ་ལྷུག་པར་གྲོལ་བས་སྤྲོ་བ་བརྟས།",
    "ཁྲི་རྒན་ཐིན་གྱི་ཀྲང་དུ་མཛེས་པར་བཞུགས།",
    "རྗེས་ནས་དགེ་རྩ་རླབས་ཆེན་བྱས་པས་ཆོག།",
    "རླབས་ཆེན་ཤེས་རབ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "གསལ་བའི་ཤེས་རབ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "རྣལ་མའི་གཤིས་ལ་ལོག་པར་རྟོག་པ་དང་།",
    "མྱུར་བའི་ཤེས་རབ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "ཕ་མཐའ་གཏུགས་པ་མེད་པར་འཇུག་པའི་ཚུལ།",
    "ཟབ་པའི་ཤེས་རབ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "ཆུ་བཟང་འདོད་རྩེའི་ཧམ་པའི་མཚོ་དཀྲུགས་པར།",
    "ནས་ཕྱེ་རྟེན་དུ་བཙུགས་ཏེ་མཐོལ་ལོ་བཤགས།",
    "བླ་བྲང་འཇམ་དབྱངས་ཤན་ཀྲང་ལ་གནང་བ། ། ལུགས་གཉིས་དཀྱེལ་ཡངས་མཉྫར།",
    "མི་འགྱངས་པར་མན་ཏེན་དུ་བསྐྱོད་དགོས།",
    "ཡང་ན་ངན་རྒྱབ་འདྲེས་བྱས་པ་གང་རུང་ལས་མ་འདས་པས།",
    "འཇམ་དབྱངས་མཁྱེན་རབ་རལ་གྲིའི་སོ་རྣོན་གྱིས།",
    "དངོས་འཕྲད་འཕྲོས་ཞིབ་མ་བགྱིས་པར་ཡིག་འགྲུལ་ཙམ་གྱིས་བསྒྲུབ་པར་བྱ་བ་མིན།",
    "ཡང་ན་ངན་རྒྱབ་གདོན་འདྲེས་བྱས་པ་གང་རུང་ལས་མ་འདས་པས་ཐག་རིང་པོ་ནས་མུན་ནག་ལག་ནོམ་བྱེད་པར་མི་སྤྲོ་སྟེ།",
    "པེ་ཅིན་ནས་བྱ་རྒོད་སྟོབས་ལྡན་ལ་གནང་བ། ། བྱ་རྒྱལ་རྒོད་པོ་མཁའ་ལ་ལྡིང་བའི་སྟོབས།",
    "མཚོ་སྔོན་མི་རིགས་བདུན་གྱི་མི་དམངས་ཀྱི་ཚབ་བྱས་ནས་ཞུ་བ་འབུལ་རྒྱུ།",
    "ལྕགས་ལོ་ལ་གནང་བ། ། ལྕགས་ལ་ལོ་ཡི་བཙན་གནོན་མི་བཟད་པས།",
    "འཕྲིག་པར་དཀའ།",
    "རི་དྭགས་འཁྱུག་པའི་ས་དེ་མཛེས་པར་འཚལ།",
    "ཤེས་པར་གྲགས་ཀྱང་རྨོངས་པའི་མུན་པ་འཐིབས།",
    "པེ་ཅིན་ནས་རྡོ་སྦིས་གྲྭ་ཚང་ལ་གནང་བ། ། ལས་བྱེད་རྣམས་ལ་འདི་སྐད་དུ།",
    "ཁོ་བོ་སླེབས་ཚེ་ངེས་པར་འཕིགས།",
    "ཡེ་ཤེས་རབ་གསལ་རོལ་པར་བྱིན་གྱིས་རློབས།",
    "ཆིས་ཅན་ཁྲང་ལ་གནང་བ། ། ཅན་ཁྲང་ཞེས་པ་རིང་པོར་མཐོང་བ་སྟེ།",
    "ཕ་མ་བུ་གསུམ་ལྷང་ལྷང་བཞུགས་ལགས་སམ།",
    "རྡོ་སྦིས་ནང་ཆེན་ལ་གནང་བ། ། ཨ་ལགས་ཨ་ལགས་མང་པོའི་རྩེ་རྒྱུན་མཛོད།",
    "གྲགས་པ་གྲགས་པ་གཞན་ལས་འཕགས་པར་མཛོད།",
    "དེ་རང་བྱས་ན་དགེ་འོ་སྙམ།",
    "ངེས་པར་འཕིགས་ཐུབ་དེ་བཞིན་སྒྲིམས།",
    "དེ་ཆོར་ངེས་པར་ཐོས་དགོས་པའི།",
    "གནས་ཚུལ་ཞིབ་གསལ་རྨོག་མཐོ་ཕེབས་པའི་ཉམས།",
    "འདི་འདྲ་ཤར་བ་ངེས་པར་སྐལ་བ་བཟང་།",
    "བདག་ཉིད་སྒྲོག་པར་འདོད་ནའང་བསྒྲགས་པས་ཆོག།",
    "ངེས་པར་དགོས་པའི་གནས་སྐབས་འགངས་ཆེན་ཡོད།",
    "དེ་ཡིས་འཇུག་པར་མི་བྱ་ཞེས་གསུངས་པ།",
    "ཁྱད་པར་ཅན་གྱི་རྟེན་ལ་དགོངས་པ་ཡིན།",
    "དེ་བཞིན་ངེས་པ་ཅུང་ཟད་གསུངས་པ་ཡང་།",
    "པེ་ཅིན་ནས་ཆིས་ཅན་ཁྲང་ལ་གནང་བ། ། ཆིས་ཡུའུ་འབར་བས་ལྕགས་བྱ་མཁའ་ལ་ལྡིང་།",
    "སྐྱུར་ལ་མངར་བའི་ཞོ་གསར་བལྡགས་ལགས་སམ།",
    "ནུར་ལ་དཀར་བའི་འོ་ཇ་འཐུངས་ལགས་སམ།",
    "ཚོ་ལ་ཞིམ་པའི་ཤ་གསར་ཟོས་ལགས་སམ།",
    "སེར་ལ་འཇམ་པའི་མར་གསར་བརྫིས་ལགས་སམ།",
    "ཕ་རྒན་མཆོད་ཁང་ནང་ན་རྫིག་ལགས་སམ།",
    "འདོད་སྐད་དྲི་ཟའི་དབྱངས་ལྟར་སྙན་ལགས་སམ།",
    "པེ་ཟན་སི་ཡི་གསེར་མཛོད་བདེ་ལགས་སམ།",
    "བདག་ཅག་དགའ་མགུའི་ངང་ནས་འཕྲད་པར་འགྱུར།",
    "ངས་རྣམ་པར་དཔྱད་པ་དུ་མས་གྲུབ་བོ།",
    "ཀུན་ནས་འདོགས་པའི་མུ་ཅོར་འཕེལ་གསུངས་པ།",
    "ཞག་གསུམ་ལོན་ཚེ་གཡེང་བས་ཁྱེར་གསུངས་པ།",
    "ད་ང་ཅང་མི་འགོར་བར་ཡོང་ངེས་ཡིན།",
    "མི་ལུས་དོན་ལྡན་བྱས་པ་ངོ་མ་ཡིན།",
    "ཤེས་པར་མཛོད་ལ་དགའ་དགའ་སྐྱིད་སྐྱིད་ཀྱིས།",
    "རྒྱལ་པཎ་ཕེབས་ལས་མ་ལྷག་ན་ཡང་མཉམ།",
    "འདམ་དབྱིས་སོགས་ཀྱིས་རྡོ་སྦིས་རང་བརྡ་ཡང་མཐིལ་ཐོན་པར་དཀའོ།",
    "ཚང་ལ་མ་ནོར་གདམས་པས་མཛེས་ལགས་སམ།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་མཚན་མའི་ཕུལ།",
    "མཚོ་དང་རྫིང་བུའི་ཁྱད་པར་ཕྲ་ཞིབ།",
    "ཡི་མུག་བློ་ཡིས་ལྕིགས་པར་དཀའ་ཡང་།",
    "དམ་པའི་སྤྱོད་དུ་ས་པཎ་གསུངས་པས།",
    "སུ་ལ་མངའ་ཡང་ངོ་མཚར་ལགས་སོ།",
    "གནང་བ་ནན་དུ་ཞུས་ཀྱང་མི་ལོན།",
    "ལས་འཕྲུལ་ལྡོག་པར་དཀའ་བས་བག་ཁུམ།",
    "ལྷག་པར་ལྷ་མིའི་རྣམ་འདྲེན་ཆེན་པོར།",
    "ཡོངས་ལ་མཛེས་ཤིང་བརྗིད་པར་བཞུགས་སམ།",
    "ད་མུས་བཞིན་དུ་བརྩོན་པར་དམ་བཅའ།",
    "བླ་འོག་མཐོང་བའི་མིག་རྒྱང་མེད་པར།",
    "ཨ་ལགས་བླ་ཁོ་བསྟན་པའི་སྲོག་ཤིང་།",
    "ཨ་ཨུ་མ་གསུམ་འཛོམས་པར་མཛོད་ཅིག།",
    "སྐུ་མཛད་མེ་ཏོག་རྒོད་བཞིན་བཞུགས་ལགས་སམ།",
    "རྒན་པོ་འདུ་གསུམ་པའང་པེ་ཅིན་དང་ཤིན་ཅང་ནས་ཕྱིར་འཁོར་ཏེ་སང་གནངས་མ་འགྱངས་པར་རྡོ་སྦིས་རང་དགོན་དུ་བསྐྱོད་ངེས།",
