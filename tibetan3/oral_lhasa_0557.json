    "གཞན་གྱི་ཕྱོགས་ལ་ཤིང་བཞིན་ཚུགས་པར་གྱིས།",
    "བློ་ལ་འཐད་པ་མེད་པའི་དོན་མ་ལགས།",
    "ཆིས་ཅན་ཁྲང་ལ་གནང་བ། ། ཆེན་ཧུས་འཇིགས་རུང་དྲག་པོའི་ཟིལ་ཆེན་པོས།",
    "འགྱིང་ཉམས་བཟོད་པར་དཀའ་བ་བཟློག་ཏུ་གསོལ།",
    "འཇིག་རྟེན་གསུམ་པོ་དཔར་ལ་འགོད་དོ་ཟེར།",
    "ནག་པོའི་བསམ་པ་རྫོགས་པར་གྱུར་ཅིག་གུ།",
    "བདེ་བར་བཞུགས་པ་ཅིས་ཀྱང་དགའ་སྤྲོའི་ཡུལ།",
    "ལྷ་སའི་གནས་ཚུལ་འདི་ན་ལྷང་ལྷང་གསལ།",
    "བརྗོད་ན་ཆེན་ཧུ་ཆད་པས་གཅོད་པར་འགྱུར།",
    "ས་སྟེང་མ་ཎིས་འགེབས་པར་བྱེད་པ་ལས།",
    "ལྷ་ལས་འབབ་པ་ལྷ་བཞིན་མཛེས་ལགས་ཀྱང་།",
    "ཧ་ཧོལ་བྱིས་པའི་འཇའ་འཚོལ་མ་ལགས་པར།",
    "མཐུན་འགྱུར་གཅེས་རྒུའི་སྤྲོས་པ་མི་ལྷོད་པར།",
    "སྒེག་པའི་འགྲོས་ཀྱིས་མིག་སྔར་འགྲིམ་པར་མཛོད།",
    "ཁོ་བོས་ཀྱང་ལུས་གྲིབ་ལྟ་བུར་འགྲོགས་པའི་རིགས་ཀྱི་ལྷ་སྲུང་ཁྱད་པར་ཅན་གུར་མགོན་ལྷ་བརྒྱད་དང་།",
    "རབ་འབྱམས་སྨྲ་བའི་མིང་དང་རྗེས་མཐུན་པར།",
    "ཟིན་ན་བསྐུར་ཏེ་དཔར་དུའང་ཁོད་འོང་སྙམ།",
    "དད་པའི་རྟེན་གྱི་འདྲ་དཔར་བཅས།",
    "ཕྱག་བྲིས་རྟེན་ལྡན་བཅས་ལེགས་པར་འཕྲོད།",
    "མ་འཇིགས་མ་ཞུམ་དགའ་ཞིང་སྐྱིད་པར་མཛོད།",
    "ཁྱེད་མཁྱེན་ཁྱེད་མཁྱེན་སྙམ་པ་གཅིག་པུས་ཆོག།",
    "ས་ལེ་སིང་ངེར་དྲན་པར་མཛོད་ཅིག་གུ།",
    "རྭ་ཆེན་རྣམ་པར་རོལ་པའི་ངང་ཚུལ་ཅན།",
    "འཇང་ཚ་དྷརྨ་ཀ་རས་ལེགས་པར་འཕྲོད།",
    "འདུས་ལོང་མཐར་ཐོན་གྱིས་སྤྱི་བྱེའི་བྱེད་སྒོ་བརྗིད་པར་ཐོས་པས་སེམས་རངས།",
    "ད་ནི་བསང་ཆེན་གཏིབས་པས་བཤགས།",
    "བསྲིངས་པའི་ཡི་གེ་ལེགས་པར་འཕྲོད།",
    "འདི་བསྐྲུན་རྣམ་པར་དཀར་བ་གངས་རིའི་ཏོག།",
    "དམ་པ་རྣམས་ལ་བཟོད་པར་གསོལ།",
    "བྱམས་སྐྱོང་ཇི་ལྟར་བྱས་ན་ཡང་།",
    "ལུང་རྒྱུམ་མཁྱེན་རྒྱམ་སོགས་གལ་བོ་ཆེའི་རིགས་མེད།",
    "ཨ་རྐྱང་བཅོལ་བའི་ནུས་པ་མི་འདོན་པར།",
    "སྐྱོན་འདོན་རོལ་རྩེད་བཅས་སྐོམ་སེལ་དུ་ཕྱི་ཉིན་ཚེས་༡༧ལ་བསྲིངས་པར་སྙམ་རྟོག་ཞོག།",
    "རྒྱ་གར་དུ་སོག་པོ་བཟང་པོ་ལ་གནང་བ། ། བཟང་པོར་མཐོང་ན་སྤྲོ་བའི་རྣམ་འགྱུར་མང་།",
    "ལྕགས་ལོ་ལ་གནང་བ། ། རིག་བྱེད་མེ་ཏོག་ཐོད་ཅན་ལྕགས་ལོ་ཀྱེ།",
    "བཞི་པར་སིངྒ་ལ་ཡི་དོགས་པ་ཡོད།",
    "གཅིག་ཏུ་དཔྱད་པར་སྤོབས་པའི་གནས་མ་ལགས།",
    "རིང་མིན་གཞིས་བྱེས་འཛུམ་ངོ་འཕྲོད་པར་འགྱུར།",
    "གོང་ན་བཞུགས་པའི་བསླུ་མེད་གསུམ་གྱི་དྲིན།",
    "བྱམས་པ་དགེ་ལེགས་ཕ་ཡུལ་བསྐྱོད་པ་གཙང་།",
    "རྡོ་སྦིས་ཨ་ལགས་ནོར་བུ་ལ་གནང་བ། ། གུས་པས་བསྟེན་ན་ནམ་ཡང་མི་བསླུ་བ།",
    "རིང་མིན་ཡོངས་འཛིན་མི་འགྱུར་གསེར་གྱི་ལྷུན་པོ་རྣམ་གཉིས་དགྱེས་པ་སྐྱེད་པའི་མཆོད་སྤྲིན་དུ་འཁྲིགས་པར་འགྱུར་རོ།",
    "དག་པོར་ཡོད་གཤིས་འདི་ཉིད་གཞིར་བཟུང་སྟེ་དཔར་ཤིང་།",
    "དཔར་ཡིག་དཔར་ཤིང་ཆེ་ཆུང་དང་།",
    "དཔར་ཡིག་རགས་ཞིབ་དཔར་རྐོན་སོགས་ཆ་ཀུན་ནས་མཚར་སྡུག་འགྲན་མེད་གཟི་བརྗིད་ཅན་ཞིག་ཡོང་རྒྱུའི་ཐུགས་ཁུར་ད་ལྟའི་ཉི་ཟླ་ཟུང་ནས་ཅིས་ཀྱང་མཛད་པ་མཁྱེན་མཁྱེན་ཞུ།",
    "ཟག་ཟད་དམ་པའི་གཤིས་ལུགས་ཀྱི་མཉེས་མཚོ་མཁའ་ལ་འཕྱུར་བས་གཞན་ཕན་ཤིས་བརྗོད་བྱིན་འབེབས་ཀྱི་རྗེས་འཛིན་བཀའ་དྲིན་མི་དམན་པར་ཞུ་བ་བཅས་པེ་ཅིན་ནས་གུས་ཞབས་པ་ཤེས་རབ་རྒྱ་མཚོས་རབ་ཏུ་དང་བ་ཆེན་པོས་ཕྱག་བཅས་ཟླ་ཚེས་ལ་ཕུལ།",
    "དཔར་གྲུབ་མ་ཐག་ང་ལ་མ་མཐའང་དཔེ་གྲངས་ཉི་ཤུ་ལས་མི་ཉུང་བ་གསོལ་རས་བཀའ་དྲིན་སྐྱོངས།",
    "རྒྱལ་བས་བསམ་མི་ཁྱབ་བཞི་གསུངས་པ་ལ།",
    "གུས་པ་ཆེན་པོའི་དབྱིངས་སུ་བདེ་བར་བཞུགས།",
    "ཀླུ་སྒྲུབ་འཕགས་པས་གསུངས་པ་ཐུགས་ལ་སྣོམས།",
    "སྟོན་པས་མ་བྱས་པ་དང་མི་འཕྲད་ཅིང་།",
    "བྱས་པ་ཆུད་མི་ཟ་ཞེས་གདམས་པ་ཡང་།",
    "ད་སྟེ་ཟླ་བ་གཉིས་ཙམ་ན་རང་གནས་ཕྱོགས་ལས་རྣམ་རྒྱལ་དུ་སླེབ་པར་འགྱུར་རོ་སྙམ་ལ།",
    "མདའ་བཞིའི་རྒྱལ་མཚན་ལ་གནང་བ། ། མདའ་ནི་དང་པོར་དར་བའི་མཚོན་ཆའི་མདའ།",
    "སྨོན་པའི་ཡུལ་དུ་དར་ཞིང་རྒྱས་པར་སྨོན།",
    "ཧ་ཧོ་འབྲོག་པ་སྐྱིད་པར་གྱུར་ཅིག་ཨ།",
    "རྩེ་མཚར་ནང་ན་རྟག་པར་ཛ་ཡནྟུ།",
    "ཁྱེད་ཀྱི་ཡི་གེ་རྟེན་བཅས་ལེགས་པར་འཕྲོད་པ་དགའ་སྤྲོའི་ཡུལ་དུ་ཆེ།",
    "དཔར་བརྐོའི་བླ་བྲང་དཔར་གསར་མ་དཔེར་བྱུང་བ་ལེགས།",
    "ཕྱི་མ་ལ་ཡང་འཇུག་མེད་ནའང་མཉམ་པར་མི་འཇོག་པ་ལྟ་བུ་ཡོང་།",
    "སུམ་རྟགས་དང་བརྡ་དག་ལ་ཐོས་བསམ་འགྲོ་ལུགས་གང་ཡང་མེད་པར་ཚིག་ལ་ཞུ་དག་གཏོང་བ་དང་།",
    "གསུངས་ཕྱིར་ཞེས་བཀའ་སྩལ་པ་དེ་ལགས་ཏེ།",
    "ཡི་དམ་ཁྱད་པར་ཅན་གྱི་བྱིན་མཐུ་དང་།",
    "སྐུ་ཞབས་ཚ་རོང་ལ་གནང་བ། ། གང་ནས་ཇི་ལྟར་འབད་ཀྱང་མཐར་ཐུག་ན།",
    "སྐུ་ཞབས་ལྡེ་འཆང་བློ་རྒྱན་ལ་གནང་བ། ། བློ་ཆེན་ཉི་མ་འབུམ་གྱི་གཟི་འབར་ཞིང་།",
    "རྒན་པོའང་ལོ་ཚོད་ལ་དཔགས་པའི་རྒས་རྒུད་གང་ཡང་མ་མཆིས་པར་བསྟན་འགྲོའི་ཉེར་འཚོར་བསམ་སྦྱོར་མི་དམན་པའི་མུར་ཡོད་པ་ནང་གཏམ་ལྷུག་མའི་གནས་ཚུལ་ཤས་ཙམ།",
    "ཚེ་འདི་ཕྱི་ཉིན་ཀུན་ཏུ་སྐྱོབ་པར་ངེས།",
    "ག་ལེ་ལྷོད་ལྷོད་བྱས་ན་སླེབ་ཆ་ཆེ།",
