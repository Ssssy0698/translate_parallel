    "འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་དམྱིགས་སོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་དམྱིགས་སོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་མྱི་དམྱིགས་སོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་མྱི་དམྱིགས་སོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་མྱི་དམྱིགས་སོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་མྱི་དམྱིགས་སོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མྱི་དམྱིགས་སོ།",
    "འདུས་བྱས་ཀྱི་ཁམས་མྱི་དམྱིགས་སོ།",
    "འདུས་མ་བྱས་ཀྱི་ཁམས་མྱི་དམྱིགས་སོ།",
    "འགག་པར་མྱི་བྱེད་དོ།",
    "དེ་གཡེང་བ་མྱེད་པའི་སེམས་དང་ལྡན་པར་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དང་ལྡན་པའི་ཡིད་ལ་བྱ་བ་དང་མ་བྲལ་བ་ཡིན་ཏེ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་འཛིན་པ་ལགས།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ལ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་མྱི་དམྱིགས་སོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་མྱི་དམྱིགས་སོ།",
    "རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བ་འམ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བ་འམ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བ་འམ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བ་འམ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བ་འམ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བ་འམ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྟོང་ཞེས་བྱ་བའམ།",
    "རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བའམ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བ་འམ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བ་འམ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སྟོང་ཞེས་བྱ་བའམ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་སྟོང་ཞེས་བྱ་བ་འམ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྟོང་ཞེས་བྱ་བའམ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་སྟོང་ཞེས་བྱ་བ་འམ།",
    "འདུས་བྱས་ཀྱི་ཁམས་སྟོང་ཞེས་བྱ་བ་འམ།",
    "འདུས་མ་བྱས་ཀྱི་ཁམས་སྟོང་ཞེས་བྱ་བ་འམ།",
    "མྱིའི་ཡོ་བྱད་གཞན་གང་ཡང་རུང་བ་སྦྱིན་པ་གང་དང་གང་གཏོང་ཡང་དེས་སྦྱིན་པ་དེ་སྟོང་པ་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མཐོང་ངོ།",
    "གང་ལ་ཡོངས་སུ་གཏོང་བ་དེ་ཡང་སྟོང་པ་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མཐོང་སྟེ།",
    "གཞན་ཡང་སྲོག་གཅོད་པ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་མ་བྱིན་པར་ལེན་པ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "མ་བྱིན་པར་ལེན་པ་སྤོང་བའི་ལེགས་པ་རྗོད་པ་ཡིན།",
    "གཞན་ཡང་འདོད་པས་ལོག་པར་གཡེམ་པ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "འདོད་པས་ལོག་པར་གཡེམ་པ་སྤོང་བའི་ལེགས་པ་རྗོད་པ་ཡིན།",
    "གཞན་ཡང་བརྫུན་དུ་སྨྲ་བ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་ཕྲ་མ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་ཞེ་གཅོད་པའི་ཚིག་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་ཚིག་ཀྱལ་པ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་ཆགས་སེམས་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་གནོད་སེམས་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "གཞན་ཡང་ལོག་པར་ལྟ་བ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བ་ཡིན།",
    "ལོག་པར་ལྟ་བ་སྤོང་བའི་ལེགས་པ་རྗོད་པ་ཡིན།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་འཛིན་པ་ལགས།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་འཛིན་པ་ལགས།",
    "དེ་ཡང་ཅི་ནས་ཀྱང་འདུས་བྱས་ཀྱི་ཁམས་ལ་རབ་ཏུ་བཀོད་པ་ཡང་མ་ཡིན།",
    "འདུས་མ་བྱས་ཀྱི་ཁམས་ལ་རབ་ཏུ་བཀོད་པ་ཡང་མ་ཡིན་པ་དེ་ལྟར་རབ་ཏུ་འགོད་དོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་འཛིན་པ་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་ཏིང་ངེ་འཛིན་མ་གཏོགས་པར་ཉན་ཐོས་ཀྱི་ཏིང་ངེ་འཛིན་ཏམ།",
    "ཏིང་ངེ་འཛིན་གང་ཇི་སྙེད་པ་དེ་དག་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་སྟེ།",
    "ལུགས་དང་མྱི་མཐུན་པར་སྙོམས་པར་འཇུག་ཅིང་རྣམ་པར་ལྡང་ངོ།",
    "དེ་རྣམ་པ་ཐམས་ཅད་དུ་གཟུགས་ཀྱི་འདུ་ཤེས་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "ཐོགས་པའི་འདུ་ཤེས་རྣམས་ནུབ་པར་གྱུར་ཅིང་།",
    "དེ་རྣམ་པ་ཐམས་ཅད་དུ་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་མཐའ་ཡས་སོ་ཞེས་ཏེ།",
    "དེ་རྣམ་པ་ཐམས་ཅད་དུ་ཆུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "དེ་རྣམ་པ་ཐམས་ཅད་དུ་འདུ་ཤེས་མྱེད་འདུ་ཤེས་མྱེད་མྱིན་སྐྱེ་མཆེད་ལས་ཡང་དག་པར་འདས་ཏེ།",
    "ལུགས་དང་མྱི་མཐུན་པར་སྙོམས་པར་འཇུག་ཅིང་རྣམ་པར་ལྡང་ངོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་ལུགས་དང་མཐུན་པ་དང་།",
    "ལུགས་དང་མི་མཐུན་པར་སྙོམས་པར་འཇུག་ཅིང་རྣམ་པར་ལྡང་སྟེ།",
    "དེ་རྣམ་པར་རྟོག་པ་དང་།",
    "རྣམ་པར་དཔྱོད་པ་ཉེ་བར་ཞི་ནས་ནང་ཡོངས་སུ་དང་སྟེ།",
    "བདེ་བ་ལུས་ཀྱིས་མྱོང་ལ་འཕགས་པ་རྣམས་ཀྱིས་དེ་ལ་དྲན་པ་དང་ལྡན་པ་བདེ་བ་ལ་རྣམ་པར་སྤྱོད་པ་བཏང་སྙོམས་པའོ་ཞེས་བརྗོད་པ་སྟེ།",
