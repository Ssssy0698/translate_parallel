    "མོ་ནི་ཞན་པའི་ཚུལ་གྱིས་འཇུག།",
    "ཤིན་ཏུ་མོ་ནི་མཉམ་པས་སོ།",
    "མོ་ནི་བདག་དང་མ་འོངས་ཕྱིར།",
    "ཤིན་ཏུ་མོ་ཡིག་མོ་ནི་མཁྱེན་མཉམ་མངའ་ཕྱིར་མཉམ་པར་གཞོག་རོ།",
    "རི་བོ་བཏང་བཟུང་བཏང་ཟུང་ཡང་ཟེར་ཏེ་རི་ཞིག་གི་མིང་བཏང་སྙོམས་སུ་བཞག་པ་དང་།",
    "སྒྲོ་ཚིག་གི་བཏགས་པ་ཀླུས་ཡིན་བཏེག་ཁ་བཏགས་འཐག་བཏགས་ཐགས།",
    "རྒྱལ་པོའི་བཙུན་མོའི་མིག་དང་བཙུམ་བྱ་དང་བཙུམས་པ་གོས་འཚེམ་བྱ་བཙེམས་ཟིན་པ་དང་།",
    "གཞན་ཟོང་དུ་བཙོངས་པ་དང་ཚོས་ཀྱིས་བཙོས་པ།",
    "དེ་རྣམས་ནི་ཙ་ཡིག་བས་འཕུལ་ཅན། ལམ་དུ་འགྲོ་བ་བགགས་འདས་པ་པ་དང་གད་མོ་བགད་པ།",
    "རྐང་པའི་གོམ་དང་དམུས་ཤིང་བ་མོས་ས་ཕ་རལ་པ་བགོམས་ཤིང་བགྲང་ད་ལྟ་བ་བགྲེང་འཕྲེང་འང་བགྲངས་འ་ཡས་ནའམ་འབ་འདས།",
    "དར་བའི་བདེ་སོགས་བས་འཕུལ་དའོ། གནས་སུ་བཞག་ཟིན་པ་དང་གད་མོ་བཞད་འདབ་ཆགས་བཞེད་ཅེས་པའང་།",
    "ཧོཙེས་ས་ས་ཏི་ཏི་ཝིཏིཙྪང་ཏྟཾ་དཀ་བཟའ་བཅའ་དང་རྒྱ་མོ་བཟའ་བ་ལ་མ་བཟའ་སོགས་བཟའ་ཤིང་རབ་བྱེད་སོགས་བ་བཟང་པོ་བཟབས་གཟབས་ཀྱང་འཐད་དོ་ནས་སྦྱིན།",
    "ཟས་བཟས་ཟིན་མྱོས་པའི་བཟི་ཆང་གི་བ་དང་།",
    "བཟེ་བཟོ་ལྟ་མེད་རེ་མེད་དང་ལས་ལ་བཟུར་བ།",
    "བསང་གི་གཏོར་མ་ཞབས་བསིལ་ལྷམ་ཕུད་པ་ངལ་བསོས་རྣམ་ཐོས་སྲས་བུ།",
    "གྲངས་སུ་བསྒྲང་ནས་ས་དབྱིབས་འབུད་པོ་འང་ངོ་བསྒངས་ཟན་སོགས་ཀྱི་གོང་བུར་དྲིལ་བ་དང་མགོ་བསྒྲེ་བ་མཉམ་པ།",
    "བསྙེལ་མེད་བརྗེད་མེད་བསྙེན་ཉེ་རིང་གི་དོན་སྲིང་ཡོ་བྱད་བསྙུངས་ཉུང་ངུ།",
    "མཚོན་ཆ་བསྣམས་དང་ཞིབ་མོར་བསྣུར་འཐག་པ།",
    "བས་འཕུལ་པ་ལ་ར་ཡིག་བཏགས་པའོ། གྱེན་དུ་ཕྱར་བསླང་དང་ཟས་ནོར་སློང་བྱེད་པ་མོ་བསླངས་ཟིན་པ།",
    "ལེ་བརྒན་ཟེར་མོད་གད་བརྒྱངས་བྱེད་པ་སྨྲ་བའི་ཁ་བརྒྱ་པ་ལྟ་བུ།",
    "བརྒྱུགས་ཤིང་བརྒྱུངས་སྐལ་ཚིག་གི་ཀླད་པ་པར་བརྒྱུད་བར་མ་ཆད་མང་བརྒྱབ་རྒན་མར།",
    "བུད་མེད་བརྗོད་འདྲིད་པའི་དོན་དང་རྔོན་པས་བརྗོན།",
    "མི་བརྗེད་པའི་གཟུངས་ཐོབ་ཚིག་གི་བརྗོད་བརྗོད་པ་བྱ་དང་།",
    "བ་ཡིས་འཕུལ་བའི་རྟ་ཡིག་གོ། གོ་བྱེད་ཀྱི་བརྡ་ཐབས་དང་གཡབ་མོ་བརྡུལ་ཕྱིར་མཚོན་ཆ་བརྡེག་རྒྱག་པ།",
    "ཡུལ་གཅོད་གཅེས་འཛིན་གཅིག་གི་གཅིག།",
    "གཉའ་རེངས་ངན་ལངས་ཤོར་བ་གཉུག་སེམས་མ་བཅོས་པ་མ་ཉག་སྣའི་ཤིང་སོགས་པོར་གཉིབ་དོད་པ།",
    "ཁྲོ་བོའི་གཏུམ་དང་གཏུམ་མོ་དང་།",
    "མཆོད་རྫས་གདུགས་དང་ཉིན་མོའི་གདུགས།",
    "ཡུལ་གཙང་གི་ཕྱོགས་སུ་གཙང་ཆུ་འཐོར་བ་གཙོ་ལྷའམ་མིའི་བོ་གཙགས་ཀྱི་བཙག་བྱ་དང་བཙགས་པ།",
    "ལག་ན་གཞོང་ཤིང་གི་གཞོང་པ་སོགས་ཐོགས་གཞོན་ནུ་ན་ཚོད་གཞོན་དང་།",
    "དགང་སྦྱིན་སྲེག་གི་གཟར་བླུགས་ཧོམ་གཟར་འབྱམས་གཟར་ཡང་ངོ་གཟར་གཟར་བུ་དང་།",
    "གཅན་གཟན་སྟག་གཟིག་སྤྱན་ཀྱིས་གཟིགས་ནས་གཟིམ་པར་གཟིམས་པ།",
    "ཀོ་བའི་གྲུ་ཤིང་གི་གཟིངས་དང་ཉི་ཟེར་གཟིངས་དྲང་བའི་གཟུ་བོ་དང་།",
    "བུད་མེད་གཡོན་མིག་མ་གཡུལ་སྤྱོད་པ་གཡེར་སྣང་གཡེལ་ཅན་བག་ཅན་གཡལ་བའམ་གླལ་བའང་ངོ།",
    "གཡུང་རིགས་ངན་པའི་མོ་རྣམ་གཡེང་དང་ལོག་རང་གི་ཆུང་མ་མིན་པ་ལ་སྤྱོད་པ་གཡེམ་དང་།",
    "གཡང་ལ་ས་མི་གཡོ་བ་གཡོར་མོ་གྲུའི་དར་བོ་ཆེ་སོགས།",
    "འགབ་ཀྱི་མཐའི་ཤམ་གཤམ་དང་མོ་བུ་མེད་པའི་བུད་མེད་གཤམ་དང་།",
    "གཤེན་གཤེན་རབ་ནི་མཆོག་གི་མིང་ཡིན་པས་ས་མཐའ་བྱེད་པ་ཤིན་ཏུ་ནོར་རབ་གཤེན་པོ་ཕྱི་རབས་གཤེན།",
    "གཤེ་སྨད་པར་བར་བྱེད་དང་སོང་བའི་གཤེགས་བདེར་གཤེགས་དེ་བཞིན་གཤེགས་པ་སོགས།",
    "གསོང་དྲང་པོར་པོར་སྨྲ་བ་དང་སྦ་བྱ་གསོང་བསྐུལ་ཚིག།",
    "ལྷ་གསས་གཤེན་གསུམ་ལྟ་བུའོ་གསལ་ལྕགས་སྲེག་གི་ཤིང་བ་དྲི་གསུར་དང་།",
    "གསས་མོ་ལྷ་འདྲེ་འབབས་པ་སྙན་གསང་བ་དྲི་ཆུ་གསིལ་བ།",
    "དས་ཤ་རི་དབུ་ཆེན་གྱི་དག་ཡིག་ལས་སྔོན་འཇུག་གི་མ་ནིང་དས་འཕུལ་དྲུག་ལ་དཔའ་བའི་ཡི་གེ་ཟེར་འཕུལ་དྲུག་ཏུ་བཞེད་དེ་དཔེར། ལྕེ་རྩེ་དཀན་ནན་ཞེས་ཀྱང་འཐད་སྦྱར་ཁ་དོག་དཀར།",
    "དཀྱུས་མ་རྒྱུན་དུ་རྒྱུགས་པའི་ཟོང་དཀྱུས་པར་རྒྱུག་པར་དཀྱུས་རྒྱུག་པ་མོ་བྱེད།",
    "ཀུན་ཉོན་མོངས་ཀྱི་མིང་ནས་དཀྲིས་དང་གོས་ཀྱི་དཀྲིས་ལུས་ལ།",
    "བསྟན་པ་གོང་འོག་དཀྲུགས་ཞོ་དཀྲུགས་སོགས་དཀྲུགས་དང་རོལ་མོ་དཀྲོལ།",
    "མདུན་དུ་དགུག་བཀུག་པ་དང་མཚན་མོའི་དགུང་ནི་མཚན་ཕྱེད།",
    "དགུང་སྔོན་དགུ་ཚིགས་སྐྱ་མོ་དགེ་ཞིང་ཐུགས་དགེས་དགྱེས་པའང་ངོ།",
    "ཟོང་རྒྱུ་དགྲམ་པ་དགུང་མོ་ལོན་པ་དགོངས་པ་དགྲོལ་དཀྲོལ།",
    "༧ ཐམི་ཐ་ ཐབབབས་ཐབཟཎལུས་ཀྱི་དཔུང་པ་དཔུང་རྒྱན་སོགས་དམག་གི་དཔུང་དཔུང་བུ་ཆུད་ནི་རྐང་དམག་གོ།",
    "ཚོན་གྱི་དབྱིག་བྱུག་པ་མོར་དབྱིག་ཤོག་བུ་སོགས་དབྱིག་དབུར་བ།",
    "དབལ་ཕུར་པའི་ནི་ཏོག་དང་རྩེ་མོ་དང་།",
    "ཞ་ཉེའི་དབྱར་སྣོད་ཀྱི་སྟེགས་བུ་འདབ་དབྱལ་བུད་མེད་མོ་སོགས།",
    "མཐོ་མིན་དམའ་མོ་དང་ཁ་དོག་དམར་པོ།",
    "དམག་གི་བསད་པའི་ཉེས་དམིགས་དམིགས་ལོང་ཁྲིད་པ་བུ་མེད།",
    "ཉམས་ཆུང་དམས་དམོད་སྨོད་བཙུགས་དམུས་སུན་ཕྱུང་བ་དབྱུང་དང་།",
    "དམོད་བཅོལ་བྱེད་པ་དམོད་པ་བོར་བ་དམིགས་གཏད་བྲལ་བ།",
    "གོམ་པ་འཁྱོར་བ་གཞན་ལ་འཁྱོམ་ད་ལྟ་བ་འཁོར་ཁང་བ་འགེབས་འཁྲིལ་ལྡེམ་འཁྲིས་བ་འདུ་བ་དང་སེམས་འཁྲུགས།",
    "འཁྲིག་ཕོ་མོའི་ཚིག་གདུགས་འཁྱིར་འཁར་རྔ་འཁྲོལ།",
    "ཁྲལ་སོགས་ནོག་འཁྲི་དང་ཕོ་མོ་འཁྲིག་འདོད་པ་སྤྱོད་པ།",
    "ཁྱིམ་ལ་འཁྲེན་ཞེན་དང་རོལ་མོ་འཁྲོལ།",
    "འཁྲི་ཤིང་འཁྱིད་གང་མ་འཁྱོལ་ཅེས།",
    "དེ་སོགས་འ་ཡིས་འཕུལ་བའི་ཁ། སྐྱེ་བ་འགག་པ་འགའ་རེ་འགའ་ཞིག་མི་མཐུན་འགལ།",
    "འགན་ཁྱོགས་ཁུར་འཁུར་ཤིང་སོགས་འགས་པ་གཡོ་འགུལ་དང་།",
    "དོན་འགྲུབ་མགོ་འགེམས་འཇོམས་འཐབ་མོ་འགྱེད་བྱེད།",
    "རང་གི་མ་ཚོར་བའི་འཇབ་བུ་དང་འཇབ་ཟིན་རེག་བྱ་འཇམ་པ།",
    "མཁའ་ཡི་འཇའ་ཚོན་བརྡ་རྙིང་གི་གཞའ་ཚོན་བློ་ཡིས་འཇལ་གཞལ་བ།",
    "འཇའ་ཁང་པ་བཀྱགས་པའི་བརྡེག་འཇའ་ས་བཀའཤོག་འཇའ་མོ་བུད་མེད་གླེན་མ་དང་།",
    "སྨད་འཚོང་མིང་གི་འཇུང་མཐུན་དང་།",
    "ཡུལ་འཇོམས་པ་བྱེད་སོགས་འས་འཕུལ་ཇའོ། ཞིབ་མོར་བཏགས་འཐག་པ་དང་འོས་པའི་ཡིད་ལ་འཐད།",
    "འཐབ་བྱས་པ་མོར་འཐོན་གྲུབ་པ་ཡང་བར་སྣང་ལ་སྤྲིན་འཐིབས་ཟིན་པ་འཐོར།",
    "རྐང་བ་ན་བ་དང་འཐེང་བ་མལ་བལ་གོས་ལྷག་གི་འཐེབ་ཀྱིས་འཐུམ་གཏུམས་དང་བསྐུམས་ཞེས་ཀྱང་མཐོང་།",
    "སྤྱོད་ཚིག་གི་ཞེ་སུན་པ་འཐིང་སླད་མུན་པ་འཐིབས་གཏིབས།",
    "མཆུ་ཡིས་ཤ་ཟུང་གི་འཐོག་པ་ནང་ནས་ཕྱིར་འཐོན་པ།",
    "རྗེས་སུ་འདེད་པ་གསོལ་བ་བདག་ལ་སྟེར་བ་འདེབས་གནས་སུ་འདོང་སོང་།",
    "ཡི་གེར་འདྲི་དང་གླེང་མོ་འདྲི།",
    "གནས་ངན་སོང་ནས་འདྲེན་པ་དང་ཕྱོགས་གཅིག་ཏུ་འདྲིས་པ།",
    "འཕོང་འཕོང་གི་དཔྱོད་དང་འཕོང་གི་རྩལ་གིས་གཞན་འཕམ་ཕམ་འཕལ་རི་མོའི་ཀ་འགྲིག།",
    "ཕ་རིགས་ཆོ་མ་རིགས་འབྲང་ལེགས་ལ་ཡེ་འབྲོག་བྱེད་པ་ཕྱིར་འབུད་སོང་ཅིག།",
    "གྲོང་ལས་ཐག་རིང་བའི་དགོན་གྱི་གནས་འབྲོག་གི་གནས།",
    "འབྲུབ་དགྲ་བགེགས་ཁུང་གི་ཁ་འབྱེད་པ་དང་གཞན་ལ་འབྱོལ་བྱོལ་ཞིང་འབྱེར་བྱེར་བ།",
    "ལུས་ཀྱི་མོ་མཚན་མངལ་སོགས་མས་འཕུལ་ལྡན་པའོ།་དུར་གྱི་མཆད་ཁྲོད་པ་ས་ཡི་གེའི་མཆན།",
    "མཆི་མ་མིག་གི་མཆིལ་ཁའི་མ་མཆན་མཆན་ཁུང་ཡང་ངོ་གྱི་བུ།",
    "དེ་དག་རྣམས་ནི་ཇ་ཡིག་མས་འཕུལ་ལྡན། རྣ་བས་མཉན་ཉན་དང་མཉན་ཡོད་ཡུལ་ཞིག་གི་མིང་གནས།",
    "སོར་མོའི་མཐེ་བོང་དང་མཐེའུ་ཆུང་།",
    "མིག་གིས་མངོན་སུམ་དུ་མཐོང་རྣམས་ན་མས་འཕུལ་གྱི་ཐའོ། མེ་ཡི་མདག་མ་དང་ནི་དུས་ཀྱི་མདངས་ཞག་ལྟ་བུ།",
    "དེ་སོགས་ན་ཡིག་ལ་མ་སྔོན་དུ་འགྲོའོ། སྐྱོན་གྱི་ངན་མཚང་དང་མིང་གི་མཚན་བརྟགས།",
    "གྲི་མདུང་སོགས་མཚོན་ཆ་རོང་འབྲོག་གི་མཚེར་ས་ནི་མས་འཕུལ་བའི་ཚའོ།་འཕྲིན་ལས་ཀྱི་མཛད་པ་དང་མཐུན་པའི་མཛའ་དགའ།",
    "ཕོ་དཔའ་བོ་མོ་མཛངས་མ་མཛའ་གྲོགས་པོའི་བོའི་བང་མཛོད་དུ་མཛེས།",
    "གནོད་མཛེས་ནོར་ལྷའི་མིང་མཛུབ་ལག་པའི་མོ་མཛོད་སྨིན་མཚམས་ཀྱི་སྤུ་དཀར་པོ།",
    "ཟས་ཇ་རྒྱུགས་ལྟ་བུ་ཀྱི་རྒྱུགས་དང་རང་གི་རྒྱུད་དང་།",
    "ལམ་རྒྱ་གྲམཤོ་རྒྱན་བཅའ་བ་སོ་རྒྱན་རྩེད་མོའི་དང་རྒྱལ་ཐོབ་པ།",
    "རྔུལ་གཟན་འདུལ་གོས་རོལ་མོ་ཅང་ཏེའུ་དྲེའུ་ཆུང་དང་།",
    "དུད་འགྲོ་རྔ་མོ་རྗེའུ་རྔ་མོའི་ཕྲུག་གུ་དང་།",
    "མཛོ་མོ་རྡོ་ལེ་རྟོལ་གོག་རྟོ་ལེ་རྟོད་པས་བཅིངས།",
    "མོང་རྟུལ་བླུན་པོ་རྟུལ་བརྟུལ་ཡང་རུང་ཞུགས་ཆེ་བ་རྟེན་ཅིང་འབྲེལ་བ་ཙམ་དང་།",
    "རྣ་བ་རྩེ་མོ་རྣོ་ཡང་དག་པའི་རྣལ་མའི་དོན།",
    "བལ་སོགས་སྐུད་པ་རྨེལ་བ་དང་གཉེན་གྱི་རྨོ་མིབ་མོ་མོ།",
    "དེ་དག་ལ་སོགས་པ་ནི་མ་ཡིག་ར་མགོ་ཅན། ཤིང་སོགས་ཀྱི་རྩ་བ་རྩེ་དང་མོ་རྩངས་རྩང་ཕག་པ་དང་།",
    "སྔོ་ཡི་རྩི་ཐོག་དང་རྩེད་མོ་རྩེས་ཤིག་རྩིས་དཀར་ནག་མཁན་རྩེན་རྩེད་མོ་རྩེ་བ།",
    "ཞོ་རྩབས་གྲོང་ཚིག་གི་ད་ར་རྩབ་ཤིང་ཏོག་གི་ཁུ་བ་མོ་སེར་སེར་མོ་བའི་གོས་རྩའི་གོས་འབྱུང་།",
    "ཞིབ་པ་རྩིང་བ་སྤུ་ཡི་འབྲི་གཡག་གི་རྩིད་པ་དང་།",
    "རྩིས་པ་མཁས་པ་རྩིས་བྱེད་པ་རེག་བྱ་རྩུབ་པ།",
    "རྩེ་ཕན་ཚུན་མོ་རྩེ་བ་དང་རྩེད་པའང་དང་རྗེས་། ཟདཔ།",
    "ཚིག་མི་བདེན་པའི་རྫུན་སྨྲ་བ་དང་ཟོག་གི་རྫ་བ་འདམ་རྫུ་བ།",
    "རེའུ་སྔོ་ལྡུམ་ལྕག་ལྕེ་ལྕམ་བ་ལྕམ་པ་ལྕམ།",
    "མཉེན་ལུས་༦༤ཀ་ལྡེམ་སོགས་བདེ་བའོ་ལྕོག་ལྕག་ཤིང་གི་ཡལ་ག་ཕྲ་མོ་མ་གྲི་ཡི་ལྕགས་པོ།",
    "ལག་རས་སོགས་ཀྱི་ལྕིབས་ཚ་སྣ་ཚ་མོ་ལྕིབས་བྱེད་སྒོ་ཡི་ལྕིབས་དང་།",
    "སྤྱན་ལྕིབས་སྤྱན་ཕྱིས་ལྕི་མོ་སྲིང་མོ་ལྕི་ཁུར་བ་དང་།",
    "ལྟར་ཙམ་སྣང་ལྟག་སེང་གེ་ལྟག་བཅད་ལྟ་བུ་ཡོན་ཏན་ཅན་གྱི་གོང་ན་སྡོད་པར་ཆོད་ལྟ་པ་ལོག་གི།",
    "རེ་ལྟོས་འཆའ་བ་ལྟ་ཕར་ཞོག་ཞོག་མདའ་ཡི་ལྟོང་ཉག་ཕྲན་གྱི་སྟོང་།",
    "གཉའ་བའི་ལྟག་པ་མཚར་བའི་ལྟད་མོ་ལ་མིག་གིས་ལྟ།",
    "སྐོམ་བླུད་ལྡད་མེ་ལྡེ་འདེ་མིང་གི་ལྡེ་བུ།",
    "ཤིང་གི་སེང་ལྡིང་ཀྱང་ལོགས་ཀྱི་ལྡེབས།",
    "སྐྱོ་ཕྲ་མ་མ་སྔ་སྔོན་མ་རྒྱལ་བའི་དོན་བཙན་སྐྱ་རེངས་ཤར་བ།",
