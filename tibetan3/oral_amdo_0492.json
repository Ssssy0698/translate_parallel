    "ཞེས་གསུང་ཞིང་སམ་མན་མས་པ་བསམ་བསམ་ཐམས་མ་། ཁྱེད་རྣམས་ལ་གཏད་པར་མོས་པ་མཛོད།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་ལུས་སོགས་ནས་བྷཉྫ་མོཀ་ཧོ།",
    "དེ་ནས་ཁྱེད་རྣམས་རང་རང་སོ་སོའི་ཐབས་སུ་གསལ་བ་དང་ཤེས་རབ་རྣམས་ཀྱང་རང་རང་གི་ཕྱོགས་སུ་འཁོད་པ་སྔར་བཞིན་གསལ་གདབ་པའི་དཔྲལ་བར་ཨོ་ནས་གསང་བར་ཀྵཤེས་རབ་རྣམས་ཀྱི་པདྨ་ཨ་ལས་ནས་འདབ་བརྒྱད་ཀྱིས་མཚན་པ།",
    "ཀུན་རྫོབ་ཏུ་ཁྱད་པར་གྱི་དགའ་བའི་མཐར་ལྷན་ཅིག་སྐྱེས་པའི་སྐད་ཅིག་བདག་གིས་བརྗོད་པ་གང་ཡིན་པ་འདི་དང་།",
    "དོན་དམ་པའི་བདེ་བ་ནི་ཕྱག་རྒྱ་ཆེན་མོ་བསྒོམས་པ་ལས་སྐྱེས་པའི་མི་འགྱུར་བའི་བདེ་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེས་ན་བདེ་བ་ཆེན་པོ་འདི་ནི་ཁྱོད་ཀྱིས་བསྲུང་བར་བྱའོ།",
    "སྡོམ་པའང་འདི་ཡིན་པས་བུ་ཁྱོད་ཀྱིས་ལེགས་པར་སྲུངས་ཤིག་ཅེས་པའི་དོན་ཡིན་ནོ།",
    "བུ་ཁྱོད་མ་མཔསབསམས་ས་བབ་མས་། མ་མ་།",
    "དེ་ལྟར་དོན་དམ་པའི་ལེའུ་ལྔ་པ་ལས་ཕྱག་རྒྱ་ཆེན་མོའི་ཡེ་ཤེས་རྒྱ་ཆེར་བརྗོད་པར་བྱ་སྟེ།",
    "རང་གི་སེམས་འདིའི་སྣང་བ་ལ་གཞུག་པར་བྱ་སྟེ།",
    "རྣམ་རྟོག་གི་སྤྲོ་བསྡུ་ཐམས་ཅད་དོར་ནས་ཅིར་ཡང་མི་སེམས།",
    "ཡིད་ལ་བྱེད་པ་ཐམས་ཅད་སྤངས་ནས་སྟོང་པ་ཉིད་ཟབ་མོ་དམིགས་པ་མེད་པ་ཤེས་པར་བྱས་ནས།",
    "དགེ་ཚུལ་གྱི་རྟེན་ཅན་རྣམས་ལ་ཁྲུ་གཉིས་པར་རེ་ཁཱ་ལྔ་དང་ལྡན་པའི་དབུས་སུ་པདྨ་མེད་པའི་ཤིང་སྟན་དུ་བཅས་པ།",
    "རང་ཉིད་ཧཱུཾ་དང་རྡོ་རྗེ་ལས་སྐྱེས་པའི་བཅོམ་ལྡན་འདས་དཔལ་དུས་ཀྱི་འཁོར་ལོ་དྲི་མ་མེད་པའི་འོད་ཟེར་ལྔ་འཕྲོ་བ་ནས་སྙོམས་པར་འཇུག་པས་གནས་པའི་སྐུའི་རྣམ་པ་ཅན་རེ་རེར་གྱུར་པར་མོས་པ་མཛོད།",
    "ཐུགས་ཀ་ནས་བུ་མོ་དང་གཞོན་ནུ་མ་རྣམས་སྐབས་སུ་གང་བབ་ཀྱི་གྲངས་དང་མཐུན་པར་སྤྲུལ་ཏེ།",
    "དགེ་ཚུལ་གྱི་རྟེན་ཅན་རྣམས་ལ་བུ་མོ་བཞི་དང་།",
    "གཞོན་ནུ་མ་གཉིས་ཀྱིས་བུམ་པ་བཞི་དང་རྒྱལ་རྣམ་རྒྱལ་གཉིས་ཏེ་དྲུག་གི་ཆུ་དང་།",
    "ཁྱིམ་པའི་རྟེན་ཅན་རྣམས་ལ་བུ་མོ་གཅིག་དང་།",
    "གཞོན་ནུ་མ་གཅིག་གིས་བུམ་པ་གཅིག་དང་རྒྱལ་རྣམ་རྒྱལ་བུམ་པ་སྟེ་གཉིས་ཀྱི་ཆུ་དང་།",
    "སྟོང་པའི་ངང་ལས་ཧཱུྃ་ཧཱུྃ་ལས་སྟེང་འོག་གི་བུམ་པ་ནས་ལྷའི་དལ་འགྲོའི་ཆུས་སུམ་གཉིས་ཙམ་གང་བར་གྱུར།",
    "ཨཱི་དང་རལ་གྲི་ལས་སྐྱེས་པའི་སྒྲོལ་མ་ནག་མོ་ནས་འཛིན་པ།",
    "རོལ་མོའི་སྒྲ་དང་གླུ་དང་གར་དང་མེ་ཏོག་དང་གུར་གུམ་ལ་སོགས་པས་ཆར་འབེབས་བཞིན་པས་མཆོད།",
    "ཁྱེད་རྣམས་རང་རང་གི་རྟེན་དང་མཐུན་པའི་དམིགས་པ་སོ་སོར་བྱས།",
    "སྤོས་སྣོད་རྔ་ཡབ་ནག་པོ་ལས་སྐྱེས་པའི་ནག་མོ་འབར་བ་མོ་དང་དུ་བ་མ་ནག་མོ་ནས་འཛིན་པ།",
    "སྲིད་པའི་ཟུག་རྡུ་ཉོན་མོངས་པ་དང་རྣམ་རྟོག་གི་ཟག་པ་ཟད་པའི་དགྲ་བཅོམ་པ།",
    "ཨོཾ་བཛྲ་ཧེ་ཏུ་ཚྭ་ཞེས་སོགས་ནས་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་ནུ་རཱ་ག་ཡཱ་མི་ཞེས་གསུང་ཞིང་ཕྱོགས་བཞི་སྟེང་འོག་རྣམས་སུ་མདའ་རེ་འཕངས་པར་བསམས་པའི་བར་རྗེས་གནང་རྣམས་གཞུང་ལྟར་སྦྱིན་ནོ།",
    "ཤོང་པ་ལྷ་དང་དཀྱིལ་འཁོར་དང་དམ་ཚིག་གི་རྣམ་དག་སྟོན་པ་ལྟར་ནའང་འདིར་སྔར་བཞིན་བརྗོད་དོ།",
    "སྟོང་པའི་ངང་ལས་སྤྱི་གཙུག་གི་འཁོར་ལོ་ཀུ་ས་ལི་རྒྱལ་མཚན་བཟང་པོས།",
    "ཧཾ་ལས་སྐྱེས་པའི་སྤྱི་གཙུག་གི་འཁོར་ལོ་མི་བསྐྱོད་པ་ལྗང་གུ་ཞལ་གསུམ་ཕྱག་དྲུག་པར་བསྐྱེད།",
    "དེ་ཉིད་ཁྱེད་རྣམས་ཀྱི་སྤྱི་བོའི་རྒྱན་དུ་བྱིན་པར་མོས།",
    "ཐལ་ཆེན་བསང་སྦྱངས།",
    "དེ་ཉིད་ཁྱེད་རྣམས་ཀྱི་སྐུའི་རྒྱན་དུ་བྱིན་པར་མོས།",
    "ཅེས་བརྗོད་པས་རོ་མཉམ་པར་གྱུར་ཏེ་ཁྱེད་རྣམས་ཀྱི་ལུས་སྐུ་རྡོ་རྗེར་གྱུར་པར་མོས།",
    "བཅོམ་ལྡན་བདག་གིས་སྦྱིན་ལགས་ཀྱིས།",
    "དཔལ་ལྡན་གསུང་གི་རྡོ་རྗེ་ནས་ཁྱེད་རྣམས་ཀྱི་ངག་གསུང་རྡོ་རྗེར་གྱུར་པར་མོས།",
    "དཔལ་ལྡན་ཐུགས་ཀྱི་རྡོ་རྗེ་ནས་ཁྱེད་རྣམས་ཀྱི་ཡིད་ཐུགས་རྡོ་རྗེར་གྱུར་པར་མོས།",
    "ཁྱེད་རྣམས་ཀྱི་སྟེང་དུ་གདུགས་དཀར་པོ་གསེར་གྱི་ཡུ་བ་ཅན་རེ་བཟུང་།",
    "ཕྱག་ཐལ་མོ་སྦྱར་ནས་དཀྱིལ་འཁོར་ལ་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་པར་བསམ་ཞིང་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ད་ནི་ཁྱོད་ཉིད་དཀྱིལ་འཁོར་གྱིས།",
    "དེ་ལ་ཁྱེད་རྣམས་ཤིན་ཏུ་དགའ་ཞིང་སྤྲོ་བའི་ཚིག་གིས་ཆེད་དུ་བརྗོད་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཨོཾ་པཉྩ་ཨ་མྲྀ་ཏ་ཨ་བྷི་ཥེ་ཀེ་ཎ་ཨ་བྷི་ཉྩམི།",
    "སྐབས་འགར་འདི་ལས་སྤྲོས་པ་ལ་མོས་པས་ནི།",
    "ཐུན་མོང་བློ་ཡིས་རྣམ་པར་དཔྱད་དཀའི་གནས།",
    "སླད་མར་མིང་ཙམ་ཐོས་པའི་ལམ་སོང་ཚེ།",
    "བསམས་ན་ལེགས་པའི་བློ་གྲོས་ཅི་ཡང་འཕེལ་། བསྒོམས་ན་མི་རིང་མཆོག་གི་དངོས་གྲུབ་སྟེར།",
    "མཁྱེན་རབ་རྗེས་མཛད་པའི་ལྷན་ཐབས་ལ་སོགས་པ་ལུགས་སྲོལ་འདིའི་ལག་ལེན་ཕྲ་མོ་ཚུན་ཆད་ཐུགས་ཀའི་དཔལ་གྱི་བེའུར་ལེགས་པར་ཆུད་ཅིང་།",
