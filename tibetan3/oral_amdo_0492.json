    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ནས་འགྱུར་ཏ་རེ།",
    "གསང་མ་གསང་གི་ཕན་ཡོན་ཉེས་དམིགས་གཉིས་ཀའི་སྒོ་ནས་དམ་ལ་གཞག་པ་ནི།",
    "འདི་ནི་ཁྱོད་ཀྱི་ནས་ཨུ་ད་ཀ་ཋ།",
    "སློབ་དཔོན་ལ་རྡོ་རྗེ་སེམས་དཔའ་དུས་ཀྱི་འཁོར་ལོ་དངོས་ཡིན་སྙམ་པའི་མོས་གུས་བྱས་པས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཀ་ནས་ཐུགས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཐམས་ཅད་རྡོ་རྗེ་བཞིའི་རྣམ་པ་དཔག་ཏུ་མེད་པར་སྤྱན་དྲངས་ནས་ཁྱེད་རྣམས་ཀྱི་ཡི་གེ་བཞི་ལ་གཉིས་སུ་མེད་པར་ཐིམ་པར་མོས།",
    "འོད་ཟེར་འཕྲོས་པས་ལུས་ཀུན་ཏུ་ཁྱབ་ཅིང་གང་བར་གྱུར་༣ ཡས་མས་ས་ལམ་ ། པར་མོས་པ་མཛོད།",
    "རྐང་ལག་གིས་གར་བྱེད།",
    "ངག་གིས་རྡོ་རྗེའི་གླུ་ལེན་ཅིང་།",
    "གསང་བར་ཀ་སྟེ་ཤེས་རབ་ཀྱི་རིགས་གསུམ་སྟེ་དྲུག་གིས་མཚན་པར་གསལ་བཏབ་པས་བསྲུངས་པར་མོས་ལ་ལྷག་པའི་ལྷའི་དཀྱིལ་འཁོར་ལའང་གཟིགས་པ་རེ་མཛོད་ཅིག་དེ་ནས་སྣང་བ་དྲི་ཞིང་དངོས་གྲུབ་ཀྱི་ལྟས་བརྟག་པ་ནི།",
    "ཁྱེད་རྣམས་མིག་མིག་རས་དང་བཅས་ཏེ་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་གཟིགས་པ་རེ་བྱས་པས།",
    "རང་རང་གི་མིག་ལམ་ན་ཁ་བག་མ་བསམ་ཡས་མས་མས་ལས་མའདས་སམ་མམ་ཡས་མས་སམ་པས་བསམ་པ་བསམཡས་བསགས་སམ་མ་བསགས་བག་གཡས་ལམ་དོག་དཀར་སེར་ལ་སོགས་པ་གང་སྣང་བ་ཞིག་ངེད་ལ་སྨྲ་དགོས་པས།",
    "དེ་ནས་ཁྱེད་རྣམས་ཀྱི་ལག་པའི་མཐེ་བོང་གཉིས་ནས་ལས་ཀྱི་རྡོ་རྗེའི་ཕྱག་གཡས་པ་རྡོ་རྗེ་དང་བཅས་པས་བཟུང་ནས་རྡོ་རྗེའི་གར་བྱ་ཞིང་སྔགས་བཟླས་བཞིན་པར་དཀྱིལ་འཁོར་ལ་བསྐོར་བ་ལན་གསུམ་དུ་བྱས་པར་མོས་ལ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་པ་ལན་བདུན་གྱིས་བསྔགས་ཏེ་ཐལ་མོ་སྦྱར་བའི་བར་དུ་བྱིན་ལ།",
    "དད་མོས་སྔོན་དུ་འགྲོ་བས་དཀྱིལ་འཁོར་ལ་ཕུལ་བར་དམིགས་ཏེ།",
    "དེ་ནི་ཁྱོད་ཀྱི་རིགས་ཀྱི་ལྷ།",
    "དེའང་ཧེ་ཞེས་པ་ནི་བོད་པ་སྟེ་དེས་ཁྱེད་རྣམས་ལ་བོས་ནས་བཛྲ་པ་ཤུ་ཞེས་པ་ནི་རྡོ་རྗེ་ལྟོས་ཤིག་ཅེས་པ་སྟེ་ཀྱེ་རྡོ་རྗེའི་དཀྱིལ་འཁོར་ལྟོས་ཞེས་བསྐུལ་བ་ཡིན་པས་དཀྱིལ་འཁོར་ལེགས་པར་གཟིགས་ཤིག་ཅེས་བསྒོ།",
    "གཡས་གཡོན་དུ་རི་དྭགས་ཕོ་མོ།",
    "ནུབ་དང་བྱང་གི་སྒོའི་གཡོན་གཉིས་དང་།",
    "ཤར་དང་བྱང་གི་སྒོའི་དབུས་རྣམས་སུ་པདྨ་དམར་པོ་དང་ཟླ་བའི་གདན།",
    "གསུང་གི་ལྷ་སྣམ་གྱི་ཤར་དུ་ཡི་དྭགས།",
    "ཕྱོགས་སུ་དམར་པོ་དང་མཚམས་སུ་དཀར་པོ་རེ་རེ།",
    "མཚམས་སུ་དཀར་པོ་རེ་རེ།",
    "གཞལ་ཡས་ཁང་གི་ས་གཞི་དང་སྟེང་ཐོག་ཐམས་ཅད་ཀྱི་དབུས་སྔོན་པོ།",
    "མཚམས་སུ་དཀར་པོ་རེ་རེ།",
    "དེའི་ཕྱིར་འདོད་མ་རྣམས་ཀྱང་སེར་མོ།",
    "ཤིན་ཏུ་དགའ་བའི་བློས་སློབ་དཔོན་གྱི་ཞབས་ལ་ཕྱག་བྱས་པར་མོས་ཏེ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་བཞིན་དུ་ཆུས་ཀྱང་སྦྱངས་པར་མོས་པ་མཛོད།",
    "སིང་རས་དཀར་པོས་ཀྱང་སྦྱངས་པར་མོས་པ་མཛོད།",
    "དེ་ནས་ཉེ་རེག་བྱ་བའི་དོན་དུ་ཁྱེད་རྣམས་ཙོག་པུར་བསྡད་པའི་པུས་མོ་གཉིས་ཀྱི་བར་དུ་ལག་པ་གཡོན་པའི་ཁྱོར་མོར་ཆུ་བཟུང་།",
    "གཡས་པའི་གུང་སྲིན་གྱིས་ཆུ་ནས་བླངས་ཏེ་ཁའི་ཟེའུ་འབྲུ་ལ་སོགས་པའི་གནས་རྣམས་སུ་ཉེ་རེག་བྱས་པས་འབགས་པ་དང་མ་དག་པའི་དྲི་མ་རྣམས་སྦྱངས་པར་མོས་པ་མཛོད།",
    "སློབ་དཔོན་ལ་གཟིགས་ཏེ་ཁའི་ཟེའུ་འབྲུ་ལ་ལན་གསུམ།",
    "མཆོད་ཡོན་དུང་ཕོར་རེ་མདུན་དུ་ཕུལ་བས་སྦྱངས་ཨོ་ཧཱིཔྲ་བྷཱ་ཝསཏྟཱ་ར་ཨཧཱུྃ་པྲ་ཏིཙྪ་སྭཱ་ཧཱ།",
    "སརྫ་ར་ཛའི་བདུག་སྤོས་ཀྱིས་བདུགས་ཏེ་སྦྱངས་པར་མོས་པ་མཛོད།",
    "རེ་རེ་ལའང་གནས་སུ་དཀྲི་བ།",
    "ནང་ཆོག་གིས་ལྷར་བསྐྱེད་པ།",
    "ཁྱེད་རྣམས་ལས་ཀྱི་རྡོ་རྗེ་དང་ལྷན་ཅིག་དཀྱིལ་འཁོར་ལ་གཡས་ཕྱོགས་ནས་བསྐོར་བ་བྱས་ནས་བྱང་སྒོར་ཁྲིད་པར་མོས་ཏེ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་ནས་ནང་གི་ཆོ་གས་ལྷར་བསྐྱེད་པའི་དོན་དུ་སློབ་དཔོན་གྱིས་ཨོ་ནས་ཞེས་བརྗོད་པས་ཁྱེད་རྣམས་བསང་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་བྱང་ཕྱོགས་སྐུ་རྡོ་རྗེའི་ཞལ་ནས་ཞུགས།",
    "སྐད་ཅིག་གིས་སྐུ་རྡོ་རྗེ་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་ཐོ་བ་ནས་བགྲང་ཕྲེང་འཛིན་པ་ལ་གོས་དཀར་མོ་དམར་མོས་འཁྱུད་པ།",
    "སེམས་དཔའ་སེམས་མ་ཁྲོ་བོ་ཁྲོ་མོའི་ཚོགས་རྣམས་མདུན་གྱི་ནམ་མཁར་བཛྲ་ས་མཱ་ཛ",
    "ཞལ་ཕྱག་གི་རྣམ་པ་ཅན་ལྷ་མོའི་པདྨ་ནས་འཐོན་ཏེ།",
    "སྟོང་པའི་ངང་ལས་ཧ་ཧཱུྃ་ལས་སྟེང་འོག་གི་བུམ་པ་ནས།",
    "ཨཱི་དང་རལ་གྲི་ལས་སྐྱེས་པའི་སྒྲོལ་མ་ནག་མོ་ནས་འཛིན་པ།",
    "ཨཱ་དང་པདྨ་ལས་སྐྱེས་པའི་མཱ་མ་ཀཱི་དཀར་མོ་ནས་འཛིན་པ།",
    "ལྭ་དང་འཁོར་ལོ་ལས་སྐྱེས་པའི་སྤྱན་མ་སེར་མོ་ནས་འཛིན་པ།",
    "ཨོཾ་པྲཛྙཱ་སོགས་ལན་གཅིག་གིས་འོག་གི་བུམ་ཆུ་ལོ་ཙ་ནེ་དང་མཱ་མ་ཀཱི་དང་པཎྜ་ར་དང་།",
    "ཏཱ་ར་རྣམས་ལན་གཉིས་ཀྱིས་རང་རང་གི་ཕྱོགས་མཚམས་ཀྱི་བུམ་པ་གཉིས་གཉིས་དང་།",
    "བཛྲ་དྷ་ཏཱིཤཱ་རི་ལན་གཅིག་གིས་སྟེང་གི་བུམ་ཆུ་རྣམས་བསྡུས་ལ།",
    "སེམས་དཔའ་སེམས་མ་རྣམས་ཀྱིས་གདུགས་དང་རྒྱལ་མཚན་དང་བ་དན་དང་ན་བཟའ་དང་རོལ་མོའི་སྒྲ་དང་གླུ་དང་གར་དང་མེ་ཏོག་དང་གུར་གུམ་ལ་སོགས་པས་ཆར་འབེབས་བཞིན་པས།",
    "ཁྲོ་བོ་ཁྲོ་མོ་རྣམས་ཀྱིས་ཡི་གེ་དྲུག་གི་སྒྲ་དང་བཅས་པས་བར་ཆད་ཀྱི་བགེགས་བསྐྲད།",
    "རྡོ་རྗེ་དྲིལ་བུ་འཛིན་ཞིང་མེ་ཏོག་གི་ཆར་འབེབས་པ་དང་བཅས་ཏེ།",
    "ངག་གི་དྲི་མ་སྦྱང་བའི་ཕྱིར་ལས་ཀྱི་རྡོ་རྗེ་དང་ལྷན་ཅིག་དཀྱིལ་འཁོར་ལ་གཡས་སྐོར་གྱིས་བསྐོར་བ་བྱས་ནས།",
    "ལྷོ་སྒོར་ཁྲིད་པར་མོས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དམར་དཀར་ནག་པའི་ནས་མཱ་མ་ཀཱི་དཀར་མོས་འཁྱུད་པ།",
    "སྤོས་སྣོད་དང་རྔ་ཡབ་ནག་པོ་ས་ས་མ་། ལས་སྐྱེས་པའི་ནག་མོ་འབར་མ་དང་།",
    "དུ་བ་མ་ནག་མོ་ནས་འཛིན་པ།",
    "དེ་ལྟར་ལྷོ་ཕྱོགས་གསུང་གི་ཞལ་དུ་ནས་འབྲས་བུ་ཐོབ་བོ།",
    "༡༡ ཁ་ལ་པ་བ་མ་སམ་།་། གཡས་སྐོར་གྱིས་བསྐོར་བ་བྱས་ནས་ཤར་སྒོར་ཁྲིད་པར་མོས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "གདུ་བུ་རྣམས་ཧཾ་ཧདང་རྡོ་རྗེ་ལས་གནོད་མཛེས་དང་ཤིན་ཏུ་སྔོན་མོ་སྔོ་དམར་དཀར་བའི་ནས་འཛིན་པ།",
    "དེ་རྣམས་ཀྱི་དཔྲལ་བར་ཨོ་ནས་ཡེ་ཤེས་པ་ཁྲོ་བོ་ཁྲོ་མོའི་རྣམ་པར་ཛ",
    "དེའི་འོད་ཀྱིས་དཀྱིལ་འཁོར་ལས་ཁྲོ་བོ་ཁྲོ་མོར་སྤྱན་དྲངས་པ་དང་།",
    "ལས་ཀྱི་རྡོ་རྗེ་དང་ལྷན་ཅིག་པས་དཀྱིལ་འཁོར་ལ་གཡས་སྐོར་གྱིས་བསྐོར་བ་བྱས་ནས་ནུབ་སྒོར་ཁྲིད་པར་མོས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཟབ་མོའི་དེ་ཁོ་ན་ཉིད་སྟོན་པར་གྱིས་ཤིག་པའི་དོན་ཡིན་པས།",
    "དུང་འབུད་པ་དང་།",
    "དྲིལ་བུ་འཁྲོལ་བ་རེ་མཛོད་ཅིག་ཐམས་ཅད་ནམ་མཁའི་སོགས་ནས།",
    "དེ་ལ་ཁྱེད་རྣམས་ཀྱིས་ཀྱང་ཐལ་མོ་སྦྱར་ཏེ་ཇི་ལྟར་གསུང་བ་དེ་ལྟར་བདག་གིས་བསྒྲུབ་བོ་སྙམ་པས་འདིའི་རྗེས་ཟློས་མཛོད",
    "གཉིས་པ་རྗེས་གནང་གི་ཡན་ལག་དང་།",
    "ཁྱེད་རྣམས་ལ་བགེགས་ཀྱི་བར་ཆད་མེད་པ་དང་དམན་པ་དང་འབྲིང་དང་འབྲིང་གི་རབ་ལ་སོགས་པ་དངོས་གྲུབ་གང་འདོད་པ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་བ་དང་།",
    "དོན་དམ་པའི་སྔགས་ཀྱི་དངོས་གྲུབ་ཀྱིས་ཞིང་དག་པར་བྱ་བའི་ཆེད་དུ་སྔགས་ཀྱི་རྗེས་གནང་ངམ་བཟླས་ལུང་གི་དོན་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "ཐུགས་ཀའི་ས་བོན་ལ་ཐིམ་པར་མོས་ནས་སྔགས་འདི་མ་ས་ལ་སམ་རྣམས་ཀྱི་རྗེས་ཟློས་མཛོད།",
    "བཅོམ་ལྡན་བདག་གིས་སྦྱིན་ལགས་སོགས་ཞེས་བརྗོད་ཅིང་མེ་ཏོག་མགོ་བོར་བཞག་ཁྱེད་རྣམས་ཀྱང་སློབ་དཔོན་ལ་མེ་ཏོག་འཐོར་བ་དང་བཅས་པས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཚིག་གིས་བརྗོད་དུ་མེད་པར་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་མེད་ཅིང་།",
    "ཞེས་གསུང་ཞིང་འཕེན་པའི་ཚུལ་རེ་མཛོད་ཅིག་ཅེས་བརྗོད།",
    "དེ་ལྟར་ནུབ་ཕྱོགས་ཡེ་ཤེས་ཀྱི་ཞལ་དུ་རྗེས་གནང་གི་ནས་ས་བདུན་པ་ཐོབ་པར་བྱེད་དོ།",
    "ཆེ་གེ་མོ་རྡོ་རྗེ།",
    "དེ་དག་གིས་སློབ་དཔོན་ཏེ།",
    "དེའང་རྡོ་རྗེ་ཐུགས་ཀྱི་དམ་ཚིག་གི་སླད་དུ།",
    "དེ་ཉིད་ཁྱེད་རྣམས་ཀྱི་ཕྱག་གཡས་སུ་རྡོ་རྗེ་ཐུགས་ཀྱི་དམ་ཚིག་གི་སླད་དུ་བྱིན་པར་མོས་པ་མཛོད།",
    "དྲིལ་བུ་གསུང་གི་དམ་ཚིག་གི་སླད་དུ།",
    "དེ་ཉིད་ཁྱེད་རྣམས་ཀྱི་ཕྱག་གཡོན་དུ་དྲིལ་བུ་གསུང་གི་དམ་ཚིག་གི་སླད་དུ་བྱིན་པར་མོས་པ་མཛོད།",
    "ཕྱག་རྒྱ་སྐུའི་དམ་ཚིག་གི་སླད་དུ།",
    "ཞེས་པ་སྟེ་དེའི་དོན་ནི་ཡིད་ཀྱི་ལུས་ཏེ་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱའི་དམ་ཚིག་རང་གི་ལྷག་པའི་ལྷ་ཡབ་ཡུམ་ཁ་སྦྱོར་གྱི་རྣལ་འབྱོར་དང་ནམ་ཡང་མ་བྲལ་བར་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་ཀྱི་ལུས་བརྟན་པར་བྱེད་པ་དེ་ལ་ཕྱག་རྒྱའི་དམ་ཚིག་ཅེས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་རབ་ཏུ་བསྒྲགས་པས་ན།",
    "ཁྱོད་ཀྱིས་ཀྱང་དམ་ཚིག་འདི་དང་མ་བྲལ་བའི་སྒོ་ནས།",
    "མཐར་ཐུག་དེ་ཁོ་ན་ཉིད་ཀྱི་རྡོ་རྗེ་དྲིལ་བུ་ཆེན་པོ་རྣམས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་དང་གསུང་གི་དམ་ཚིག་ཏུ་ཟུངས་ཤིག་དེའི་སྟེང་དུ་ལུས་ཕྱག་རྒྱའི་དམ་ཚིག་རྡོ་རྗེ་སེམས་དཔའ་ཡབ་ཡུམ་དུ་བྱིན་གྱིས་བརླབས་པས།",
    "འདིར་སྲོག་གཅོད་པ་ལ་སོགས་པའི་དམ་ཚིག་ནི་རྣམ་པ་གཉིས་ཏེ་དྲང་བའི་དོན་དང་ངེས་པའི་དོན་གྱིས་ཕྱི་རོལ་དང་ནང་གི་བདག་ཉིད་དོ།",
    "དུད་འགྲོའི་སྐྱེ་གནས་སུ་འགྲོ་བ་བཟློག་པའི་དོན་དུ་གཞན་གྱི་བུད་མེད་འཕྲོག་པ།",
    "ལས་ཀྱི་ཕྱག་རྒྱའི་དངོས་གྲུབ་ཀྱི་དོན་དུ་གདོལ་པ་མོ་ལ་སོགས་པ་མི་སྨད་པ།",
    "ངེས་དོན་དུ་རང་གི་ལུས་ལ་སྲོག་བཀག་སྟེ་རྣལ་འབྱོར་པའི་ཁུ་བ་གཙུག་ཏོར་དུ་དགག་པ་སྲོག་གཅོད་པ།",
    "ཕྱག་རྒྱ་མོ་འཕྲོག་པ་ནི།",
    "དཔྲལ་བར་ས་བཅུ་པའི་གནས་སུ་བརྟན་པ་གཞན་གྱི་བུད་མེད་འཕྲོག་པ།",
    "དེ་ལྟ་བུའི་ཕྱི་དང་ནང་གི་དམ་ཚིག་གི་རྣམ་པར་དག་པ་བསྟན་ནས།",
    "ཁྲོ་བོ་ཁྲོ་མོ།",
