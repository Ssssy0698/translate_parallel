    "སེམས་ལ་སྒྱུ་རྩལ་གྱི་སྐུ་ཁྲུས་ལན་གཅིག་གསོལ་དུ་འཇུག་ན་དེ་ཡང་སྙན་ངག་གི་ཡོན་ཏན་ཅི་ལ་མིན།",
    "ཉནཅནང་མཚར་ལྷ་ཡི་རོལ་མོ།",
    "དེ་སྔོན་ཟླ་ཟེར་དུ་འཁོད་པའི་སྙན་རྩོམ་དག་ལ་རེ་རེ་བཞིན་དཔྱོད་པའི་རྔོ་མི་ཐོགས་མོད།",
    "སྒྱུ་རྩལ་སྤྲོ་སྣང་གི་གཤིས་ཀ་སྐྱེད་དུ་བསྲིངས་པ་ནི་རིན་ཐང་མི་ཆུང་བ་ཙམ་དུ་མ་ཟད།",
    "འདོད་ཆགས་ཀྱིས་ཐམས་ཅད་ང་གཅིག་པུས་བཟའ་ཞིང་ང་གཅིག་བུས་གྱོན་ལ་ང་གཅིག་བུས་སྤྱོད་དགོས་ཟེར་ཏེ་ཐམས་ཅད་དམར་ཧྲེང་ཧྲེང་དུ་རྒྱུ་ཚེ་དགེ་དང་ཡིག་ཚངས་ཀྱིས་འཚོ་བ་དག་གི་བསམ་བློའི་ལོངས་སྤྱོད་དང་སྒྱུ་རྩལ་གཤིས་རྒྱུད་ནི་རིན་ཐང་གཞལ་དུ་མེད་པ་འགྲོ་བ་མིའི་ཁྱད་ནོར་ཞིག་ཏུ་མཐོང་བ་གོར་མ་ཆག་དེས་ན་ང་ཚོས་སྤྱི་བབ་ནས་བརྟག་ན་སྙན་ངག་འདི་དག་ལ་རྩོམ་རིག་སྒྱུ་རྩལ་གྱི་མཛེས་ཉམས་ཁྱད་དུ་ཐོན་ཅིང་།",
    "དེ་དང་དུ་མཉམ་དུ་སྙན་ངག་འདི་དག་གིས་ང་ཚོར་བསམ་བློ་སོ་མ་གྱ་ནོམ་པ་ཞིག་བསྣམས་འདུག་པ་དེ་རེད།",
    "སྤྱིར་སྙན་ངག་ལེགས་པོ་ཞིག་ཡིན་ན་མཐའ་གཅིག་ཏུ་བསམ་བློ་ཟབ་མོ་གང་རུང་ཞིག་ཅིས་ཀྱང་ཡོད་དགོས་པར་འདོད་པའི་གྲས་སུ་ཕྲན་པ་ནམ་ཡང་འདུག་མ་མྱོང་ལ།",
    "བསྐལ་བའི་བར་དུ་གནས་པར་འགྱུར་གསུང་གི།",
    "ཁྱོད་ཀྱི་སྣང་སེམས་འདྲེན་སྟོབས་དང་བསམ་པ་འགུགས་ནུས་ཀྱི་དྲག་ཤུགས་དང་ལྡན།",
    "ཤན་འཇུག་གི་ནུས་པ་དབལ་རྣོ་ཞིང་གཏིང་དུ་འགྲོ་བ་ཐ་ན་དེ་འཕྲལ་བློ་ཐོག་ནས་སྐྱོར་ཐུབ་པ་ཞིག་ཏུ་འོང་།",
    "དེར་བསྟུན་ནས་སྙན་ངག་གི་༡།",
    "གཞན་སྙན་ངག་འདི་དག་གིས་ང་ཚོའི་ལོ་ངོ་བཅུ་ཕྲག་དུ་མའི་རིང་གི་རྗེས་ཤུལ་དང་འཕོ་འགྱུར་བསྟན་ཡོད།",
    "དེ་སྔོན་ང་ཚོས་གང་དུའང་བྲིས།",
    "དེ་སྔོན་ང་ཚོས་ཅི་ཡང་བྲིས་ཏེ།",
    "ང་ཚོ་རེ་དགའ་སྟེ།",
    "ཉམས་འུར་ཐེངས་གཅིག་གིས།",
    "ང་ཚོའང་འུ་ཐུག་པ་ཡོད་དེ།",
    "མནོ་བསམ་རེ་རེས་དྲུད་འོང་ཡིག་འབྲུ་དེ་ཚོ།",
    "གལ་ཏེ་ང་ཚོ་ད་དུང་མུ་མཐུད་ནས་མདུན་དུ་སྐྱོད་དགོས་ན།",
    "གལ་ཏེ་དེང་ཕྱིན་ང་ཚོ་མདུན་སྐྱོད་ཀྱི་ཁ་ཕྱོགས་གང་ཡིན་ངེས་དགོས་ན།",
    "དེ་སྔོན་ཇི་ལྟར་འོང་བ་དང་ད་ལྟ་ག་ཚོད་དུ་བསླེབས་ཡོད་པ་རྟོགས་པར་བྱེད་ཆེད་རྒྱབ་ཕྱོགས་སུ་བསྒྱུར་ཟིན་པའི་རྐང་རྗེས་ལ་དཔྱོད་པ་ནི་སྣང་ཆུང་གི་གནས་སུ་མཐོང་བར་མི་འོས་ཏེ།",
    "འདི་ལ་བརྟེན་ནས་ང་ཚོས་ཡོ་བ་སྲོང་དགོས་ཤིང་།",
    "སྙན་ངག་གི་རིག་པ་འདིའི་ལས་སུ་བབས་པ་ནི་སྔར་མེད་པའི་རིག་པའི་ཁྱབ་ཁོངས་ལ་ཚོད་འཇུག་བྱེད་ཅིང་།",
    "བརྗོད་བྲལ་བརྗོད་པ་ངག་གི་རྒྱལ་ཁམས་མཐོང་།",
    "དེས་ན་སྙན་ངག་གི་སྐད་ཆ་ནི་སྔོན་དུ་ཐོན་པ་རིག་པའི་ཁྱབ་ཁོངས་གསར་བར་མཚོན་ན་ལྐོག་གྱུར་སྦས་ཡུལ་འབྱེད་བྱེད་རལ་གྲིའི་རྩེ་མོ་ལྟ་བུ་ཞིག་ཏུ་འགྲུབ།",
    "དེ་ཙམ་རང་རེའི་སྙན་རྩོམ་གསར་བའི་བརྒྱུད་རིམ་འདི་ལས་བརྟག་ཀྱང་རྟོགས་ནུས་ཏེ།",
    "འགའ་ཞིག་དང་དུ་མི་ལེན་པའམ་ཐ་ན་བོད་སྐད་མིན་པར་སྒྲོག་ཁྲོའང་ཡོད་མོད།",
    "ད་ལྟ་དེ་དག་ལས་མི་ཉུང་བ་ཞིག་སྙན་ངག་གི་ཐུན་མིན་རྗོད་སྟངས་ཙམ་དུ་ཁས་འཆེ་ཞིང་།",
    "ད་དུང་གོང་སྨྲས་དེ་དག་དང་མཉམ་དུ་གླེང་དགོས་པ་ནི་དགེ་མཚན་འབའ་ཞིག་གིས་བསྡུས་པའི་བྱ་བ་མེད་པ་བཞིན་སྙན་ངག་འདི་དག་ལ་མཚོན་ནའང་ཆ་གང་རུང་ན་དགེ་མཚན་མ་ཡིན་པར་སྨྲ་རུང་བ་ཡོད་དེ།",
    "ཞིབ་ཏུ་གསེད་འགྲོལ་གྱི་ངལ་བའང་བསྟེན་མ་ནུས་པས་འདིར་ས་བཅད་སྟོངས་དོགས་ཀྱིས་གླེང་བསླངས་པ་ཙམ་མོ།",
    "དེ་དག་གི་ཐུན་མིན་རིན་ཐང་ཡང་ཡིན།",
    "སུ་ཞིག་ལ་རྩིས་མི་ཆེ་ཡང་རང་རེ་ཚོས་བརྩི་མཐོང་མ་བྱས་ཐབས་མེད་ཡིན།",
    "དེ་ལྟར་ན་ཟླ་ཟེར་སོགས་སུ་འཁོད་པའི་སྙན་ངག་དང་རྩོམ་རིག་འདི་དག་ང་ཚོར་བཀའ་དྲིན་ཆེ་ལ།",
    "དེ་དག་གི་རྩོམ་པ་པོ་དག་བཀའ་དྲིན་ཤིན་ཏུ་ཆེ།",
    "ཁོང་རྣམ་པས་ང་ཚོ་མགོ་འཐོམ་ལ་འུ་ཐུག་པའི་སྐབས་དེར་རང་ནུས་ཀྱི་ལས་ལ་འཇུག་པའི་དྲན་སྐུལ་དང་དཔེ་འདོན་ལེགས་པོ་ཞིག་བྱས་སོང་ཞིང་།",
    "དེ་ཚོར་བརྟེན་ནས་ང་ཚོ་དཔལ་ལྡན་འཛམ་བུ་གླིང་བའི་མི་གྲལ་གྱི་སྟར་འཕྲེང་འཕང་མི་དམའ་བར་འཚོ་ཐུབ་པ་བྱུང་ཡོད།",
    "དེ་ཚོ་རང་རེ་དཀྱུས་མ་དག་གི་སྣང་ངོར་མཛད་རྗེས་ཆེན་པོར་མཐོང་བས་རྩོམ་ཐུང་འདི་ག་བརྒྱུད་ནས་སླར་ཡང་ཁོང་རྣམ་པར་ངོ་སོ་ཐེངས་ཤིག་བསྟོད་པ་ཡིན་ལ།",
    "བཅུ་ཕྲག་བཞི་ཡི་འདབ་མཛེས་མེ་ཏོག་གི།",
    "འགྱུར་མེད་གཡུང་དྲུང་རི་མོའི་རྒྱ།",
    "མཐོ་རིས་བུ་མོའི་སྙེམས་པ་འཕྲོག།",
    "བཀྲ་ཤིས་ཚིག་གིས་རབ་ཏུ་བསྔགས།",
    "བདེ་ལེགས་ཚིག་གི་སྲད་བུ་ལ་བརྒྱུས་ཏེ།",
    "ཨེ་མ་རང་རང་གིས་ཚུགས་རེ་བཅོས་ན།",
    "རྒྱལ་བུ་དོན་གྲུབ་ཀྱིས་གཟིགས་པའི་རྒན་པོ།",
    "མཚར་མཚར་སྙན་སྙན་གྱི་གསུང་གི་དྲིལ་ཆུང་།",
    "རྣ་བའི་བུ་ག་རུ་འཇེབས་པ་ཙམ་མོ།",
    "གཡབ་མོས་མ་བོས་ཀྱང་འཚངས་ཀ་བརྒྱབ་བྱུང་།",
    "སྔོན་བྱོན་བཀའ་གདམས་པའི་མཛུབ་ཚུགས་ཟབ་མོར།",
    "རྒས་པའི་ཡལ་ག་འཁྱོག་པོའི་ཚང་ཚིང་འཁྲིགས།",
    "རང་གིས་རང་ལ་སྐྱུག་རེ་བྲོ་བའི་ཚུལ།",
    "ཉ་མོ་ཆུ་ལ་འཕྱོ་འདྲའི་བདེ་འཁྱུག་ཅན།",
    "ན་ཚོད་སྐྱ་རེངས་ཐོག་མར་གཟུགས་ཀྱི་ཁམས།",
    "དྲང་ཞིང་མཉེན་ལྕུག་སྨྱུག་མའི་ལང་ཚོ་ལྡེམ།",
    "ཡན་ལག་གྱོང་ལ་སོར་མོ་ཤིང་ལྟར་རེངས།",
    "དབུགས་ཐེངས་གཅིག་ལ་བརྒྱ་མཐུད་སྟོང་གི་ཚོགས།",
    "ལང་ཚོའི་མེ་ཏོག་སྒང་བུ་འབུས་པ་ན།",
    "ཐོན་པ་མིན་ནམ་རང་ཡང་འཕྱང་མོ་ཉུག།",
    "ཤ་འཛེར་སྟོང་དང་སྨེ་ཐིག་ཁྲི་ཕྲག་གི།",
    "མིག་གིས་མ་བསྒོས་པར་ཡང་མགོ་སྐྱེས་ལྗོན།",
    "སྟོན་མཇུག་བ་མོ་མགོ་ལ་བབས་པའམ།",
    "ཆབས་ཅིག་གཙུག་གི་སྐྲ་ལོ་ཀུན་བྱི་ནས།",
    "ཁྲག་གི་རྒྱ་མཚོ་ཅིག་ཅར་ཉིད་དུ་བསྐམས།",
    "ཐོད་ལ་བཏགས་པར་གཉེར་མའི་མིང་གིས་འབོད།",
    "དཀྱུས་རིང་མིག་གི་བུང་བ་མཚར་སྡུག་ཅན།",
    "མཁན་སྲིན་བུ་ཕྲ་མོའི་གཤོག་རྡེབ་སྒྲ་སྐད་ཀྱང་།",
    "བདུན་ཅུར་ཉེ་བའི་ལམ་འཕྲང་དོག་མོར་ཡང་།",
    "རྟ་འདུར་དབྱངས་གསུམ་གྲེ་འགྱུར་འཇོལ་མོའི་སྐད།",
    "འདི་ཙམ་ཞེས་བྱར་སྤྱན་སྟོང་གཟིགས་རེ་སྐན།",
    "ཀྱེ་ཧུད་རེ་བའི་པདྨར་སྨིན་པའི་རྩིས།",
    "བྱ་སྐད་འགྱུར་ཁུགས་སྙན་མོས་དྲང་སྲོང་ལ།",
    "འབོལ་ཞིང་བདེ་བའི་སྟན་ལ་སྐྱིལ་མོ་ཀྲུང་།",
    "སྤྲེའུའི་ངང་ཚུལ་རེ་ཡང་བཟུང་བ་དྲན།",
    "འཆད་རྩོད་རྩོམ་ལ་མཁས་པའི་འཕོང་གི་གྲྭར།",
    "ན་སོ་སྟོད་ལ་མཁས་པའི་གཟིགས་མོར་བཤམས།",
    "དབྱངས་ཅན་ལྷ་མོ་མགྲིན་པའི་ཁང་བཟང་དུ།",
    "ཚངས་སྲས་བུ་མོའི་ཕྱག་གི་པི་ཝང་མཆོག།",
    "སྒྲོ་བཏགས་ཟ་ཟིའི་རོལ་མོ་འཁྲོལ་བའི་སྒྲ།",
    "མེ་འོད་འབར་བའི་གཡུ་འབྲུག་སྔོན་མོ་ཡི།",
    "ག་ལ་སོང་ཡང་གཞན་རྒྱུས་མི་ཤེས་མགོ་མཐོ་བའི།",
    "ང་རྒྱལ་ཅན་ཁྱོད་རིག་ན་ཁོག་ནས་དགོད་རེ་བྲོ།",
    "ཉ་འཛིན་གཉིས་པ་ཁྱོད་ལས་སྐྱིད་པོ་སུ་ཞིག་ཡོད།",
    "ཏ་ཐཱ་ག་ཏའི་བསྟན་ལ་རེ་ཞིག་དུང་བྱས་ཀྱང་།",
    "ན་ནིང་བྱ་བ་དྲན་ན་རང་སྡུག་མྱོང་གི་སྔ་ལྟས་རེད།",
    "པ་རི་པི་རིའི་རང་གི་འདོད་པ་གཅིག་པུ་ལས།",
    "བ་རེ་བོ་རེའི་བྱ་བར་རྒྱུན་དུ་འབད་འབད་ཀྱང་།",
    "ཛ་དྲག་དུས་ཀྱི་གཡུལ་ངོར་ཁྱོད་ཀྱིས་ལྟད་མོ་རུ།",
    "འ་ཆད་འུ་ཐུག་བོང་བུས་གཟིག་ལྤགས་གྱོན་པའི་འཕྲུལ།",
    "ཡ་རབས་སྐྱེ་བོས་མཐོང་ཚེ་ཁྱོད་ལ་མཆིལ་ཞགས་འབུལ།",
    "རྭ་ལྟར་སེམས་རྒྱུད་གྱོང་བའི་བསམ་གནག་གང་གི་བློར།",
    "ཨ་ཁུ་ཁུ་ལོར་འབོད་པའི་གཏམ་དེ་སྙན་ན་ཡང་།",
    "བརྩེ་སེམས་ཀྱི་ཞགས་པ་ཡུག་གཅིག་གིས།",
    "གངས་དཀར་བོའི་རང་གཟུགས་འཕོས་པའི་མོད།",
    "རང་སྐད་ཀྱིས་གླེང་མོལ་བགྱིད་པའི་ཚེ།",
    "སྙན་ཚིག་གི་ངག་སྒོ་ཡངས་པ་མོ།",
    "བཅུ་དྲུག་ལང་ཚོའི་ཕང་བར་ཉེར་རྩེན་པའི།",
    "སྙན་འཇེབས་དབྱངས་ཀྱི་མཛའ་མོ་རྣ་བའི་བཅུད།",
    "དཀྲོལ་མཁས་མཚོ་བྱུང་ལྷ་མོས་ཤིས་པ་སྩོལ།",
    "ཀན་ལྷོ་གཡང་ལྡན་ཕྱུག་མོའི་ཕང་བར་གཏོར།",
    "བསྒྱུར་བཅོས་སྒོ་འབྱེད་རིན་ཆེན་ལྡེ་མིག་གིས།",
    "ཕྱི་ནང་ནོར་ལྷའི་མཛོད་ཀྱི་སྒོ་མོ་བརྒྱ།",
    "སྨིན་ལེགས་གཡང་ལྡན་ཕྱུག་མོས་དགའ་སྟོན་གྱི།",
    "སུམ་རྩེན་ལྷ་ལས་བབས་སམ་འཕྱང་མོ་ཉུག།",
    "བྱམས་ལྡན་མ་ཡུམ་གང་གིས་སྐྱེད་སྲིང་བའི།",
    "དོན་དུ་འཁྱོལ་བའི་ནང་རིག་སྐྱེད་ཚལ་འདིར།",
    "གང་གི་ལང་ཚོ་ལ་ཆགས་མི་ན་ཀས།",
    "བབས་པའི་རིག་བྱེད་ལྷ་མོ་ཐིག་ལེའི་མ།",
    "ཁྱོད་ཀྱི་འཛུམ་བག་གཞན་གཅིག་དཔའ་རྩེ།",
    "དེང་གི་མཚར་ལོངས་གུར་གུམ་མདངས་བསྲེས་ཏེ།",
    "གངས་གཞོན་ཡིད་མཁར་སྨིན་འདི་ཁྱོད་ཀྱི་དགེ།",
    "ཚངས་སྲས་བུ་མོའི་ཕྱག་གི་རྒྱུད་མངས་ལ།",
    "པིར་རྩེ་ཅུང་ཟད་རེག་པའི་དབྱངས་སྙན་འདི།",
    "ཁྱོད་ཀྱི་ལང་ཚོས་བདག་ལ་དུག་བཞིན་གཙེས།",
    "ཁྱོད་ཀྱི་འཛུམ་བག་དེ་ཁོ་བོའི་མནར་གཅོད་དངོས།",
    "ཁྱོད་ལ་ཚོར་འགུལ་མེད་འདི་ཅི།",
    "བློ་ཡི་ཁྱེར་སོ་ཁྱོད་ཀྱིས་གཏན་དུ་བཟུང་།",
    "སྡུག་གི་ཁ་བའང་ཁྱོད་ཀྱིས་དྲག་ཏུ་ཕབ།",
    "བདག་སེམས་ཀྱི་ས་གཞི་ཁྱོན་ཆུང་བས།",
    "ངས་ཁྱོད་ལ་བཀའ་དྲིན་ཞུ།",
    "ཁྱོད་ཀྱི་འཛུམ་མདངས་དེ་བདག་གི་ལག་རྟེན་ཡིན་ལ།",
    "ཁོ་བོའི་ངག་ན་བཟླས་ཤིང་ཟློ་བཞིན་པའང་ཁྱོད་ཀྱི་རྫུན་ཚིག་གོ།",
    "ད་ལྟའི་སྐྱོ་གདུང་གི་འབྲས་བུར་སྨིན་བྱུང་།",
    "ལག་ཟུང་གིས་གུར་ཀུམ་གསར་བ་མཐོན་པོར་གཡུག་སྟེ།",
    "བདག་གི་བགྲོད་ལམ་ལ་ཤིས་པའི་དྲི་བསུང་བསྒྲིགས་རོགས།",
    "བདག་དང་བདག་གི་མཐོང་སྣང་།",
    "སྒེའུ་ཁུང་ལས་མཚན་ལྗོངས་དང་ཟླ་གོར་མཐོང་ཐེངས་རེར།",
    "ཁྱིམ་མཚེས་བུ་མོ་ཚོའི་གླུ་སྐད་དང་དགོད་སྒྲ་ཐོས་ཐེངས་རེར།",
    "ཁྱོད་དང་ཁ་གཏད་དུ་ཀྲོང་ངེར་འགྱིངས་པ་ཡོ་འབོག་སྡོང་རྐང་འགའ།",
    "ཐག་རིང་གི་གནས་ན་ལམ་ལམ་འཚེར་བའི་གློག་ཞུ་དམར་བོ།",
