    "དཀའ་སྤྱད་ཀྱིས་མི་ལོ་བཞི་བཅུར་བཞུད་པའི་ཁྱད་མཚར་ལམ་ཡིག་མཆོག་གསར་དུ་ཆས་པའི་ང་ཚོ་ལ་སྨོན་འདུན་དང་ཡིད་ཆེས་སུ་བསྩལ།",
    "ཞི་བདེ་དང་བདེ་སྐྱིད་ཀྱིས་བདག་གིར་བཟུང་བའི་རྨད་བྱུང་ཡུལ་ལྗོངས་འདིར།",
    "རྔ་རྡུང་འཁར་དཀྲོལ་གྱི་ཟིང་ལོང་ཆེན་པོ་ཞིག་གིས།",
    "ཁྱོད་ཀྱི་བྱམས་བརྩེ་ཡི་ཕང་བར་སྙེ་ཚེ།",
    "འཇིགས་སྣང་གིས་ཁེངས་པའི་ལས་མཐུན་དེ་ལ།",
    "ཁྱོད་ཀྱི་ལྷག་བསམ་གྱི་མཆི་མ་སེམས་ཁོང་དུ་ལྷུང་ཞིང་།",
    "བགྲང་བྱ་སུམ་ཅུའི་སྔ་རོལ་གྱི་དེང་གི་ཉིན་མོར།",
    "ཉིད་ཀྱིས་ཕ་ཡུལ་ལ་བཅངས་པའི་རེ་འདུན་དང་ཡིད་ཆེས་མཚོན་ཞིང་།",
    "དཔྱིད་ཀྱི་སྨོན་འདུན་ཁྲོད་ཁྱོད་ཀྱིས་སླར་ཡང་།",
    "ད་ནི་དཔྱིད་ཀྱི་རྨོན་འདེབས་ལ་རེམ་ཞེས་ཡང་ཡང་བསྐུལ།",
    "དེ་ནས་བཟུང་ཁྱོད་ཀྱི་རེ་སྨོན་དྲགས་ཤིང་གླུ་སྒྲ་སྙན།",
    "དེ་ནས་བཟུང་བདག་གི་སྒེའུ་ཁུང་རབ་རིབ།",
    "སྐྱོ་གདུང་སྲབ་མོ་ཞིག་ནམ་ཡང་རྨི་ལམ་གྱི་མཇིང་བར་འཁྲིལ།",
    "ཁྱོད་བདག་གི་རྨི་ལམ་ནང་འཛུལ་བའི་མཚན་མོ་ནམ་ཞིག་ངས་རང་གི་དགོད་སྒྲ་ལས་བསྟན་དོན་གཞན་ཞིག་བཙལ།",
    "བདག་ལ་ཀུ་རེ་མེད་ལ་ཁྱོད་ལ་འཛུམ་དམངས་མེད་པའི་ཉིན།",
    "སུས་ཀྱང་ཁེར་རྐྱང་གི་དྲན་པ་རུམ་ལ་ཉར་དོན་མེད།",
    "ངས་ཁྱོད་དྲན་པའི་གདུང་བ་སུ་ལ་བརྗོད།",
    "ཁྱོད་ངའི་ཡིད་ཀྱི་སྒེའུ་ཁུང་ལས་ཕྱི་རུ་འཕུར་ཉིན་ནས་བཟུང་།",
    "བདག་གི་ཁེར་རྐྱང་གི་མཚན་མོ་རེ་རེ།",
    "བདག་དང་བདག་གི་ཁང་མིག་ཆུང་ཆུང་།",
    "ཁྱོད་ཀྱི་ཡིད་སེམས་འདྲེན་པའི་ལྕགས་ཀྱུ་ཨེ་ཡིན་སྙམ།",
    "བ་རེས།",
    "ཐག་རིང་གི་ལྗོན་ལོ་དང་བྱིའུ་ཚོགས་ཀྱི་གཤོག་ཟུང་ལེབ་མོ།",
    "ད་དུང་རེ་འདུན་ཞིག་ལ་སྙེག་པའི་སུ་ཞིག་གི་གོམ་སྒྲ་ཡང་མོ།",
    "ངས་དྲན་མི་བཟོད་པ་ནི་ཁྱོད་ཀྱི་གྲུང་ཤ་དོད་པའི་མིག་འབྲས་ཟུང་།",
    "དགུན་གཞུང་ཧྲིལ་བོ་ངང་གིས་འདས་པའི་དཔྱིད་འགོ་ཞིག་ལ།",
    "ཁྱོད་དང་རྒྱང་ཐག་ཧ་ཅང་རིང་བའི་རི་གྲོང་ཞིག་ན།",
    "བདག་གིས་འདོད་འདུན་གསར་བའི་བློ་མོས་ཁུ་བྱུག་གི་མགྲིན་པར་བཅོལ་འདོད།",
    "བདག་གིས་སེམས་གཏིང་གི་བདེ་སྡུག་ཡོད་ཚད་སྐྱ་རེངས་ཀྱི་འཛུམ་མདངས་སུ་བརྫུས་འདོད།",
    "རང་སེམས་ལ་དུས་ཚིགས་ཤིག་གི་སྔོན་བརྡ་བཏང་ཡང་།",
    "མེ་ཏོག་ཅིག་གི་འདབ་མ་རྙིད་འདུག་པ་མཐོང་།",
    "ཁྱོད་ནམ་མཁའ་ནས་བབས་པ་ཁོ་ན་ཞིག་ཏུ་གྱུར་ཏེ།",
    "ཁྱོད་དང་གངས་རི་དཀར་བོ་གཏམ་རྒྱུད་དུ་བྲིས་ཤིང་།",
    "རྗེས་སོར་གྱི་ལོ་ཟླ་རིང་མོའི་ནང་།",
    "ཁྱོད་དང་འབྲེལ་བའི་འདུ་ཤེས་ཀྱི་འཕེལ་འགྲིབ།",
    "ཁྱོད་ནི་ཇི་འདྲའི་མིང་དོན་མི་མཚུངས་པ་ཞིག་ཡིན་མོད།",
    "གང་ལྟར་ཀྱང་བདག་དང་ཁྱོད་ཀྱི་བར་ཐག་ནི།",
    "རིག་པའི་འཇག་རྩྭ་ཟོས་པའི་འདོ་རིག་གི་རྟ་མཆོག།",
    "གདོད་མའི་མུན་ཁང་ཕུག་གི་སྲན་ཕུང་ལ་མི་ཆགས།",
    "རབ་སོ་བདུན་དུ་གྲགས་པ་འབྲི་ཀླུང་གི་སྐེད་པ།",
    "འགྲུངས་ཀྱང་དྭངས་པ་མེད་པ་རྙོག་ཀླུང་གི་འབབ་རྒྱུན།",
    "ང་ཡི་མ་ནི་རྒས་མེད་གངས་དཀར་གྱི་ལྷ་མོ།",
    "ཁྱོད་ནི་ཤ་ཁྲག་སྩོལ་བའི་དྲིན་ཆེན་གྱི་ཨ་མ།",
    "ང་ནི་ཁྱོད་ཉིད་སྐྱོང་བའི་བསླུ་མེད་ཀྱི་བདག་པོ།",
    "ཚེ་སྲོག་གསར་བ་རྙེད་ས་ཁྱོད་ཉིད་ཀྱི་ཕང་བ།",
    "རུས་པའི་ཕྱི་རྗེས་འཇོག་ས་ཁྱོད་ཉིད་ཀྱི་ཕང་བ།",
    "སུ་དང་གང་གི་གནོད་པས་ང་རང་ལ་མི་ཚུགས།",
    "དེ་ངག་གིས་ལྷང་ལྷང་སྒྲོག་པ་སྙན་ངག་གི་འཚེར་སྒྲ།",
    "ལྗོངས་འདི་ཀུན་མཁྱེན་མཆོག་གི་གདུལ་ཞིང་རང་ལོས་ཡིན།",
    "རྒྱབ་རི་གླང་ཆེན་ཐལ་ཀར་ཉལ་འདྲ་ཡི་མདུན་ན།",
    "བསྟན་འགྲོའི་བདེ་སྐྱིད་སྲོག་གི་རྩ་བ་རང་ལོས་ཡིན།",
    "ནང་དུ་རིམ་གཉིས་རྣལ་འབྱོར་ཟབ་མོ་ཡི་གདེངས་ལྡན།",
    "གང་གི་ཐུགས་སྨོན་མཐུ་ལས་གྲུབ་པ་རང་ལོས་ཡིན།",
    "སྟོབས་འབྱོར་རིགས་རྒྱུད་ཐང་གི་རྒྱལ་རབས་བཞིན་དར་བ།",
    "ཀུན་མཁྱེན་ཆེན་པོའི་ཐུགས་བསྐྱེད་མཐུ་སྟོབས་ཀྱི་དཔུང་གིས།",
    "ཁྱོད་གསུང་སྒྲུབ་པའི་སྲས་ཀྱི་ཐུ་བོ་རུ་གྱུར་ཏེ།",
    "ལྷ་ལྡན་ཞིང་གི་མཐོད་ཐོས་བརྗོད་པ་ངོ་མཚར་གཏམ་གྱི་རོལ་མོ།",
    "བརྗིད་ཆགས་ཡིད་འོང་པོ་ཏཱ་ལ་ཡིས་སུམ་རྩེན་སྒེག་མོའི་ཁེངས་པ་ཕྲོགས།",
    "ཇོ་མོ་བླ་རིའི་དབུ་འཕང་མཐོ་བས་ནམ་མཁའི་སྒོ་འཕར་ཐོལ་གྱིས་བརྟོལ།",
    "མ་ཕམ་གཡུ་ཡི་མཚོ་མོ་ཆེ་དེས་གཡའ་དག་ནམ་མཁའི་རང་མདངས་འཛིན།",
    "གངས་རིའི་རྒྱལ་བོ་གངས་སེང་དཀར་མོ་དྲག་ཏུ་ཁྲོས་པའི་གད་རྒྱངས་ཡང་།",
    "གཏང་རག་ཚིག་གི་མགྲིན་གླུ་དང་བཅས་ལྷ་ལྡན་པདྨའི་ཚལ་དུ་ཐལ།",
    "སེང་གེ་ཁ་འབབ་ཁ་ནས་སྐྱུགས་པས་ཛ་ཧུའི་བུ་མོ་བག་ལ་ཞ།",
    "རྒྱ་བཟའ་གོང་ཇོས་འཕྲུལ་གྱིས་བཞེངས་པ་རྒྱ་སྟག་འགྱིང་འདྲའི་ར་མོ་ཆེ།",
    "གངས་ལྗོངས་དབྱིག་གི་བློ་གྲོས་མ་ཡི་ལྟེ་བ་པདྨའི་དགའ་ཚལ་ན།",
    "སྐྱིད་པའི་ལྗོངས་ན་གཡུ་འབྲུག་སྔོན་མོ་ས་ལ་འགྱུ་བའི་ངང་ཚུལ་གྱིས།",
    "སྐྱིད་ཤོད་གཞུང་ན་གྱ་གྱུའི་འགྲོས་ཀྱིས་རང་ལུས་འཁྱོག་ལ་འཆང་བ་མོ།",
    "སྲིད་གསུམ་སྲིད་པའི་ཁྱོན་ཀུན་ཁྱབ་པས་རིགས་དྲུག་འགྲོ་བ་སེམསས་ཅན་ཀུན།",
    "རྒྱ་ཕིབས་གསེར་གྱི་འཁོར་ལོས་མཛེས་པ་ར་ས་འཕྲུལ་སྣང་གཙུག་ལག་སྐྱིད་ཆུ་སྔོན་མོ་འཁྱུག་འགྲོས་མ་ཁྱོད་རླབས་དཀར་ཟེགས་མ་གཏོར་བས་ན།",
    "དགུ་ཚིགས་སྐྱ་མོས་ཕྲག་དོག་མིག་ཆུ་ཁ་བའི་ཟོལ་གྱིས་ས་ལ་བསྙིལ།",
    "རྒྱ་གར་པཎ་གྲུབ་བྱེ་བའི་གཙུག་གི་ནོར་བུ་ཉི་མ་འོད་པོ་ཆེ།",
    "བདེ་ལྡན་ཞིང་གི་རྗེས་སུ་ཆགས་པའི་སྙེ་ཐང་ལྷ་ཡི་ཞིང་ཁམས་ན།",
    "མ་དགཞན་གསོས་བུ་མོའི་གྲེ་འགྱུར་མ་འགག་སྙན་འཇེབས་ངག་གིས་མགྲོན་དག་བསུ།",
    "འཇམ་མགོན་རིང་ལུགས་ཉིན་མོར་བྱེད་པ་བསྐལ་བའི་མཐར་ཡང་གནས་བྱེད་ན།",
    "ངོ་མཚར་འཕྲུལ་གྱིས་ས་འདིར་དྲངས་ཞེས་བརྒྱ་བྱིན་མིག་སྟོང་ལྡན་པས་བློ་བཟང་ཉིན་བྱེད་སྟོང་གི་བདག་པོ་ཀུན་གསལ་མཁའ་ལ་རྩེན་པ་ན།",
    "བསིལ་ལྡན་འཛིན་མའི་ཁྱོན་ཀུན་སྒྲིབ་པའི་མུན་པའི་དཔུང་ལ་རོལ་བ་ལྷས།",
    "དཔལ་གྱི་བསམ་ཡས་འཕྲུལ་གྱིས་བཞེངས་པའི་ངོ་མཚར་རི་མོ་ཕྱག་གི་སྣ་ཚོགས་འགྲོ་འདུལ་སྤྲུལ་བའི་འོད་ཀྱིས་གངས་ལྗོངས་འཛིན་མ་ཁྱབ་པའི་ཚེ།",
    "རང་བྱུང་མཆོད་རྟེན་སྤུན་ལྔའི་མེ་ཏོག་འགྲོ་ཀུན་མིག་གི་གཟིགས་མོར་འཛུམ།",
    "ཡུལ་འདིའི་གཡང་གི་དཔལ་དུ་བརྗིད་པ་གསེར་མངལ་ཅན་གྱིས་སྤྲུལ་དང་མཚུངས།",
    "བཀྲ་ཤིས་རི་མོའི་ཚན་ཁ་འབར་བའི་མཆིམས་ཕུ་ལྷ་ཡི་ཁང་བཟང་ན།",
    "དེ་ཚེ་དེ་ལ་ཁྲ་འབྲུག་ཅེས་བའི་མིང་གི་རོལ་མོ་ལྷ་ཡིས་དཀྲོལ།་",
    "གངས་ལྗོངས་སྒེག་མོའི་སྐལ་བར་སྨིན་ཞེས་ལྷ་རྣམས་སྨྲ་བའི་ཅ་ཅོ་སྒྲོག།",
    "གནམ་སྔོན་ཞུན་མ་ས་ལ་འཕོས་འདྲའི་གཡུ་ཡི་མདངས་ལྡན་མཚོ་མོ་ཆེ།"
  ]
}