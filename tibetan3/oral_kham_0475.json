    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་དེ་གང་ལས་ལྡོག་པ་དེ་ལ་ནི་ཐེ་ཚོམ་སྐྱེད་པར་མི་འགྱུར་ཏེ་འོན་ཀྱང་རང་ཉིད་ཡོད་པས་དེ་མེད་པས་གོ་བར་འགྱུར་ལ་འགལ་ཟླ་མེད་པར་གོ་ན་ཡང་ཅིག་ཤོས་ཡོད་པར་གོ་བར་འགྱུར་བའི་ཕྱིར་དེས་ཐེ་ཚོམ་སྒྲུབ་པར་མི་འགྱུར་ན་འདི་ནི་ཐེ་ཚོམ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "མཉན་པར་བྱ་བ་ཡང་རང་ཡུལ་ལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་འགལ་བ་དམིགས་པ་ཡིན་ནོ།",
    "བསྒྲུབ་བྱ་ཡང་སྒྲུབ་པ་དང་དགག་པ་འགལ་བས་ཐ་དད་པ་ན་གཏན་ཚིགས་ཀྱང་གཉིས་ཡིན་ལ་སྒྲུབ་པ་ཡང་རང་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པའི་ཕྱིར་གཏན་ཚིགས་ཀྱང་གཉིས་ཏེ་དེའི་ཕྱིར་ཡུལ་གསུམ་དུ་གནས་པས་གཏན་ཚིགས་གསུམ་དུ་གནས་པ་ཡིན་ནོ།",
    "དགག་པའི་སྒོ་ནས་འཇུག་པ་རྒྱུ་དང་རང་བཞིན་མི་དམིགས་པ་གཉིས་ཏེ་བཞི་ཡིན་ནོ།",
    "རིག་བྱེད་རང་ཉིད་ཀྱང་རང་ཉིད་རིག་པར་བྱེད་པ་མིན་ཏེ་ཤེས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དང་རང་བཞིན་དེ་དག་ཁོ་ན་ཞེས་སྦྱར་རོ།",
    "གཉིས་པ་ལུང་རང་ཉིད་རང་དང་འགལ་བ་སྒྲུབ་པའི་གཏན་ཚིགས་སུ་མི་འཐད་པ་ནི།",
    "དེ་བཞིན་དུ་ཚིག་ཕྲད་དེ་ཁོ་ན་དང་འདོད་པ་དང་རང་ཉིད་ཀྱི་ཚིག་གསུམ་གྱིས་ནི་སྒྲུབ་པར་བྱེད་པ་མིན་པ་དང་དོན་གྱིས་བསྒྲུབ་བྱར་བརྗོད་པ་དང་རྒོལ་བས་ཁས་བླངས་པ་གསུམ་གཟུང་བར་རིག་པར་བྱའོ།",
    "སྨྲས་པ་ཙམ་དང་རང་ཉིད་འདོད་པ་མ་ཡིན་པ་བཞི་ལ་ནི་མཚན་ཉིད་དེ་འཇུག་པ་མེད་པའི་ཕྱིར་རོ།",
    "དང་པོ་ལ་གཉིས་ཏེ་ཁས་བླངས་དང་རང་ཚིག་ཐ་དད་དུ་འདོད་པའི་ལུགས་དགག་པ་དང་།",
    "གསུམ་པ་འབྲས་བུ་དང་རང་བཞིན་ཕྱེ་བའི་རིག་རལ་གྱི་རྣམ་ངེས་རྒྱན་གྱི་མེ་ཏོག་དགོས་པ་བརྗོད་པ་ལ་དང་པོ་སྒྲུབ་པའི་དགོས་པ་ནི།",
    "གཅིག་ཏུ་ངེས་པ་དམིགས་པ་དེ་ཡང་རང་རིག་པའི་ཞེས་སྦྱར་ཏེ་དེའི་ཕྱིར་ཤེས་པའི་རྒྱུ་བྱེད་ཅིང་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡང་ཡིན་པས་རྩོད་པ་གཉི་ག་སྤངས་པ་ཡིན་ནོ།",
    "ཁྱད་པར་ཉིད་འཆད་པ་ན་གཅིག་པུ་ནི་ཐམས་ཅད་ཀྱང་རང་བཞིན་དང་ཐ་མི་དད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ད་ལྟ་ཆར་པ་བལྟར་རུང་བ་ལ་ནི་དེས་འདས་པའི་ཆར་པ་རྗེས་སུ་དཔོག་ལ་ས་ཕུག་ན་འདུག་པ་ལ་སོགས་པ་བལྟར་མི་རུང་བའི་ཚེ་ནི་ད་ལྟར་ཆར་འབབ་པ་དཔོག་སྟེ་མ་འོངས་པ་རྩེ།",
    "བསྟན་བཅོས་མི་ཤེས་པ་རྣམས་ཀྱང་དེ་ལྟར་མི་འཛིན་པ་དེའི་ཕྱིར་ཞེས་བྱ་བ་དང་གཞན་ལ་དེ་ཉེ་བར་ཞེས་བྱ་བ་དང་བདག་ལ་མཐོང་བ་དེ་ཙམ་གྱིས་ཞེས་བྱ་བ་དང་རང་བཞིན་མི་དམིགས་པ་དང་འགལ་བ་དམིགས་པ་དང་འགལ་ཁྱབ་དམིགས་པ་ལས་ཀྱང་ལྡོག་པ་མི་གྲུབ་པ་དེའི་ཕྱིར་ཞེས་སྦྱར་རོ།",
    "བཅས་དང་རང་བཞིན་བསམ་པའི་རང་གཟུགས་དང་།",
    "རྒྱས་པར་རང་རང་སྒྲུབ་ཐབས་སུ་གསལ་ལོ།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་དུ་འདུག་པ་མ་ཡན་པ་མ་འདུག་པ་འགྲེང་བ་མ་ཡན་པ།",
    "སྐུ་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "ང་རང་ཟླ་བོ་གཞན་མེད་པར་འཁྱམས་ཞིང་། འདུག་པ་ལ།",
    "ཁྱེད་རང་རྣམས་ལུས་བགྲངས་ཏེ།",
    "ནམ་མཁའ་མཐིང་བཟང་རང་བཞིན་གནས་རྣམས་ལས།",
    "རང་རང་ངེ་ད་དུངས་བྲན་གཡོག་དང་བཅས་པ་ལ་གསོལ་ལོ་མཆོད་དོ།",
    "རང་རང་མཐུན་པའི་གདན་སྟེང་དུ།",
    "སྐུ་མཁར་གཡས་སུ་བལྟས་ཙ་ན།",
    "བྲག་དཀར་རྒོད་གཤོག་བརྐྱང་པ་འདྲ་ སྐུ་མཁར་གཡོན་དུ་བསྟས་ཙ་ན།",
    "སྐུ་མཁར་རྒྱབ་ཏུ་བལྟས་ཙ་ན།",
    "ནམ་འཆི་ངེས་མེད་འདི་ལ་བསམ་ཙ་ན།",
    "མ་གྱུར་འགྲོ་བའི་གནས་ཚུལ་མཐོང་ཙ་ན།",
    "གསུམ་པ་སྤྱིར་རང་གར་འགྲོ་གར་འདུག་ཐམས་ཅད་དུ།",
    "འགྲོ་ཆག་ཉལ་འདུགཐམས་ཅད་དུ།",
    "མེ་ཐབས་དྲུག་ཆིངས་རྣམ་པར་འདུག།",
    "སྨྱོན་ཐམས་ཅད་ཀྱི་རྩ་བ་ཞེན་པར་འདུག་གེ་",
    "རང་དབེན་པའི་གནས་སུ་འདུག་པའི་ཚེ།",
    "སྐུ་གསུམ་གྱི་རང་ཞལ་སྟོན་ཅིང་གདའ་སྟེ།",
    "འཁྱིལ་འཁྱིལ་འདུག་གྱད་ཆུ།",
    "སྐྱེས་བུ་དམ་པ་རྣམས་ལེགས་པ་དང་སྙན་པའི་ཚིག་ཐོས་ན་༧ཧ་ཅང་མི་སྨྲ་བར་འདུག་པའི་རིགས་མ་ཡིན་པས་ན་ལེགས་སོ་ལེགས་སོ་ཞེས་པའི་ཚིག་གཉིས་པ་ནི་དགའ་བ་དང་།",
    "མེ་ཏོག་ཐོགས་ཏེ་སྒོ་ཕྱོགས་འདུག།",
    "མེ་ཏོག་ཐོགས་ཏེ་སྒོ་ཕྱོགས་འདུག།",
    "ཤར་གྱི་སྒོར་འདུག་པར་བྱ་བ་ཉིད་དོ།",
    "ཡང་ན་མེའི་ནང་དུ་རྣལ་འབྱོར་པ་ལ་ཁ་བལྟས་ཏེ་འདུག་པའི་མེ་ལྷ་ཉིད་མཐོང་བར་འགྱུར་བ་ཉིད་དོ།",
    "དེའི་རྗེས་ལ་ཨོ་བེ་རོ་ཙ་ན་ཨོཾ་པཱ་པཾ་ཤཱནེེ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "རྔ་དང་ཀེ་ཀོར་རྣམས་ཀྱི་སྒྲ་སྙན་པ་འབྱིན་པ་ཞིག་བཅོམ་ལྡན་འདས་ཀྱི་སྦྱན་སྔར་འདུག་གོ་ཞེས་པ་ནི་འདིར་ལྷའི་བུ་དེ་ཉིད་དེ།",
    "དེ་ལས་ཡང་དག་པར་བྱུང་ཞིང་རང་ཉིད་ལྷའི་སྒུ་ཕྱག་རྒྱ་ཆེན་པོར་བསྐྱེད་ལ།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "གཉིས་པ་ནི་ལོ་ཙ་ནཱ་༡དང་།",
    "ཀླུའི་རྒྱལ་པོ་མིག་མི་བཟང་རྣམས་ཀྱིས་ཀྱང་རང་རང་སྐྱེད་པར་བྱེད་པ་དང་།",
    "ལྷོ་ནུབ་མཚམས་སུ་ནི་སྲིན་པོ་མི་རོ་ལ་ཞོན་པ་ཁ་དོག་དམར་ནག་ཏུ་འདུག་པ་བཞིན་ཁྲོས་པ་ལག་པ་གཡས་པས་རལ་གྲི་འཛིན་པ་གཡོན་པས་མི་མགོ་འཛིན་པ་བྲི་བར་བྱའོ།",
    "དེ་བས་ན་གཟའ་རྣམས་ཀྱིས་ཀྱང་རང་རང་བསྐྱེད་པའི་ས་བོན་ཕུལ་བ་སྟེ།",
