    "རང་ལས་གཞན་ཕོ་མོ་མ་ནིང་གསུམ་གྱི་བསྟེན་བྱ་སྟེན་བྱེད་གཉིས་དང་ཅི་རིགས་པར་གཞན་དུ་སྦྱོར་བར་བྱེད་ན་སྟེ་བཅད་པ་དང་མ་བཅད་པ་དང་།་",
    "ཡན་༨༤ན་ལག་གི་རྣམ་པ་རྨའི་སྒོ་ལ་མ་རེག་པར་འཇུག་པ་གཉིས་ཀྱང་སྦོམ་པོའོ།",
    "རོ་མྱོང་བ་ལ་གནོད་པ་མ་ཡིན་ཏེ་བསྒྲིབས་པ་ཙམ་དེས་གཡོགས་པ་ལ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་རེག་པར་མི་འགྱུར་བ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དང་པོ་ལ་གསུམ་ལས་ཐུན་མོང་བ་བརྟེན་གྱི་མཚན་ཉིད་ནི།",
    "ཚོར་བས་གཟིར་བ་གང་རུང་གིས་བདག་དགེ་སློང་གི་དངོས་པོར་མི་ཤེས་ན་ཤེས་པ་རང་བཞིན་གྱིས་ཉམས་པ་ཡིན་ཏེ།",
    "དགེ་ཚུལ་མའི་བསླབ་པ་སྐྱེས་པ་ལ་རེག་པ་སྤོང་བ་ནི་འཁྲུགས་པ་མ་ཡིན་ནོ།",
    "བསྟེན་པའི་ཕྱིར་གཞན་ལ་ཁས་བླངས་པ་དེ་ནི་དགེ་སློང་གི་སྦོམ་པོའོ།",
    "ཡན་ལག་གི་རྣམ་པ་གླང་ཤུ་ལ་སོགས་པས་རྡོལ་བའི་ཕྱིར་རོ་མ་མྱོང་ན་ཡང་སྦོམ་པོའོ།",
    "ཡན་ལག་གི་རྣམ་པ་ལས་སུ་མི་རུང་བ་བཅུག་ན་ཡང་སྦོམ་པོ་སྟེ་རོ་མྱོང་བ་ལས་སུ་རུང་བ་ལ་ལྟོས་པའི་ཕྱིར་རོ།",
    "ཤིང་དང་བ་སོ་དང་རྡོ་བ་དང་གོས་ལས་བུ་མོའི་གཟུགས་བྱས་པ་ལ་བརྩལ་བ་ན།",
    "སོང་ལ་མི་ཚངས་པར་སྤྱོད་ཅིག་ཅེས་གཞན་ལ་བསྒོ་ན་སྦོམ་པོའོ།",
    "མ་ཉམས་བཞིན་དུ་འཁྲུལ་པ་འགའ་ཞིག་གིས་བདག་ནི་དགེ་སློང་གི་དངོས་པོ་ལས་ཉམས་པའོ་སྙམ་པའི་བསམ་པ་ཅན་གྱིས་བཅུག་པ་ལ་ཡང་ན་སྨད་པ་མེད་དོ།",
    "ཡན་ལག་གི་རྣམ་པ་ཟིན་པ་སྤང་བའི་ཕྱིར་རོ།",
    "ཆུ་ཀླུང་གང་ན་ཡན་ལག་གི་རྣམ་པ་ཆུ་ན་གནས་པའི་སྲོག་ཆགས་དག་གིས་འཛིན་པའི་འཇིགས་པ་ཡོད་པའི་ཆུ་ཀླུང་དེར་དགེ་སློང་གིས་སྒྲེན་མོར་བརྒལ་བར་མི་བྱའོ།",
    "ཆུ་ཀླུང་དེར་དགེ་སློང་གིས་བུད་མེད་ལ་མ་རེག་པར་ཤེས་བཞིན་དུ་གྲུ་བརྒལ་བར་བྱའོ།",
    "བ་ལང་གི་ནང་དུ་ཡང་ཤེས་བཞིན་དུ་འགྲོ་བར་བྱའོ།",
    "དེ་དག་ནི་བུད་མེད་ལ་རེག་པ་སྤང་བའི་ཕྱིར་རོ།",
    "ཕོ་མོའི་མཚན་ལེགས་པར་སོ་སོར་བརྟག་པར་བྱས་ནས་རབ་ཏུ་དབྱུང་བར་བྱ་སྟེ།",
    "དགེ་སློང་གིས་གཅིག་པུ་བླ་གབ་མེད་པར་གློས་ཕབ་ནས་གཉིད་ལོག་པར་མི་བྱའོ།",
    "དགེ་སློང་གཅིག་པུ་བླ་གབ་མེད་པར་གློ་ཕབ་སྟེ་གཉིད་ལོག་པ་དེའི་ཤམ་ཐབས་བུད་པ་ན་དགེ་སློང་དེ་ལ་བུད་མེད་ཀྱིས་བརྩལ་བ་ལ་བརྟེན་ནས་བསླབ་པ་འདི་བཅས་སོ།",
    "གྲོགས་མོ་ཡོང་དུ་ཟིན་ཀྱང་གློས་ཕབ་ནས་གཉིད་ལོག་པར་ཡང་མི་བྱའོ།",
    "གང་ཟག་ནོར་ཅན་གྱིས་ཉོན་མོངས་པ་འདོད་པས་ཀུན་ནས་བསླང་སྟེ།",
    "སྦྱོར་བ་གཅིག་གིས་ནང་དུ་རིན་ཐང་ཚང་བའོ།",
    "སྦྱོར་བ་ལུས་ངག་ཏུ་གྲུབ་ཅིང་མ་འཁྱོགས་པས་རྐུ་བར་རྩོམ་པའོ།",
    "དགེ་སློང་རང་གིས་བརྐུའམ།",
    "གཞན་རང་གིས་དངོས་སུ་བརྐུར་བཅུག་པ་དག་གིས་ཕམ་པར་འགྱུར་རོ།",
    "ཁྱོད་སོང་ལ་རྫས་འདི་ལྟ་བུ་རྐུས་ཤིག་ཅེས་མངགས་པས་རང་གིས་བརྐུའམ་གཞན་བརྐུར་བཅུག་པས་ཀྱང་ཕམ་པར་འགྱུར་རོ།",
    "སེམས་གང་གིས་བརྐུས་ན་ཕམ་པར་འགྱུར་ཞེ་ན།",
    "ཡན་ལག་གི་མཚན་ཉིད་དང་།",
    "མཐར་ཐུག་གི་རབ་དབྱེའོ།",
    "རྩ་བའི་བདག་པོའམ་གནས་སྐབས་ཀྱི་སྐབས་གྱི་བདག་པོའི་བསམ་པས་བདག་གིར་བྱས་པ་དང་།",
    "བདག་པོས་དུད་འགྲོ་ལ་བཟའ་བཏུང་གི་ཕྱིར་རྩྭ་ཆུ་ལྟ་བུ་བྱིན་པ་ལ་ནི་དུད་འགྲོ་ཉིད་བདག་པོ་ཡིན་གྱི་ཞལ་ཏ་བྱེད་པ་བདག་པོ་མ་ཡིན་ཏེ།",
    "རྔོན་པ་ལ་སོགས་པ་ལིངས་པ་དག་གིས་ནགས་མེས་གཏོང་བ་ལ་སོགས་པ་དག་གི་བཟུང་བའི་ཕྱིར་རི་དྭགས་དང་བྱ་དང་སྡིག་སྦྲུལ་ལིངས་བཏབ་པ་༨༧བ་རྣམས་ལ་ནི་ལིངས་པ་མིན་པ་བདག་པོ་ཉིད་མིན་པས་དེ་རྐུ་སེམས་ཀྱིས་ལེན་ན་ལིངས་པ་ལ་བརྐུས་པར་འགྱུར་རོ།",
    "གང་གི་རིན་ཐང་བརྩི་ཞེ་ན།",
    "རྫས་ཀྱི་རིན་ཐང་ནི་གང་དུ་བརྐུས་པའི་གནས་དང་གང་གི་ཚེ་བརྐུས་པའི་དུས་ཀྱིས་རྫས་དེའི་རིན་ཐང་བརྩིའི་གནས་དུས་གཞན་གྱི་རིན་ཐང་མི་བརྩིའོ།",
    "རང་གི་ལ་རྐུ་སེམས་མེད་པ་སྨོས་ཅི་དགོས་ཤེ་ན།",
    "དཔེར་ན་ཁྱེད་ཀྱིས་ཆེ་གེ་མོའི་ཡོ་བྱད་དེ་ཤེས་སམ།",
    "འོ་ན་དེ་བརྐུས་ཞེས་པ་ལྟ་བུ་ལ་འདི་ནི་ཁོ་རང་གི་ཡིན་ནོ་སྙམ་ནས་ལེན་པ་ལྟ་བུའོ།",
    "རིན་ཐང་གི་ཡན་ལག་མ་ཚང་བའི་ཕྱིར་རོ།",
    "རང་གི་རྫས་བརྐུས་ན་ཅིར་འགྱུར་ཞེ་ན།་",
    "རང་གི་རྫས་རིན་ཐང་ཚང་བ་ཞི་ག་གཞན་སྐྱིན་པ་གཞལ་དུ་གཞུག་པའི་ཕྱིར་དུ་རྐུ་སེམས་ཀྱིས་བརྐུས་ན་ཡང་སྦོམ་པོའོ།",
    "རང་གི་རྫས་ལ་འགྲོ་བ་གཞན་གྱིར་འདུ་ཤེས་པས་བརྐུས་ན་ཡང་སྦོམ་པོའོ།",
    "བདག་གིར་བྱ་བའི་བསམ་པ་མེད་པར་བདག་པོ་དང་བྲལ་བའི་བསམ་པ་ཙམ་གྱིས་ཕྲལ་ན་ཅིར་འགྱུར་ཞེ་ན།",
    "རང་གིས་བདག་གིར་མ་བྱས་པར་འདམ་རྫབ་ལ་སོགས་པར་སྦ་བ་དང་།",
    "རྐུ་བར་བྱ་བའི་རྫས་ལ་ནོམ་པའི་སྔ་རོལ་གྱི་རང་གི་གནས་ནས་ཁྲི་ལས་ལྡང་བ་དང་།",
    "གཞན་གྱི་རྫས་རང་གིས་ཁྱེར་བ་བདག་པོ་མངོན་སུམ་ན་ཡོད་ལ་གོམ་པ་བསྐྱེད་པའམ།",
    "ཕྲི་བའི་སྒོ་ནས་རྐུ་ན་གོམ་པ་རེ་རེ་ལ་སྦྱོར་བའི་སྦྱོར་བ་ཐ་དད་པ་ཡིན་ཏེ།",
    "གྲུ་ཕུར་པ་ལས་བགྲོལ་བ་ནི་གྲུ་ལ་རེག་པ་མིན་པས་སྦྱོར་བའི་སྦྱོར་བ་ཡིན་ནོ།་",
    "གསུམ་པ་མཐར་ཐུག་གི་རབ་དབྱེ་ནི།",
    "རྨ་ཚོ་ན་རེ།",
    "འོ་ན་རྫས་བདག་གིས་ལྐོག་ཏུ་ཞལ་ཏ་བས་སྦས་པ་རྐུ་བའི་ཚེ་གནས་ནས་སྤོས་ན་ཕམ་པར་འགྱུར་རོ།",
    "འོག་གཟུར་གཤགས་ཀྱི་སྟེ་རྐུ་བའི་ཚེ་རྒྱལ་བ་ན་བརྐུས་པར་ཐལ།",
    "རྒྱ་ན་རེ།"
  ]
}