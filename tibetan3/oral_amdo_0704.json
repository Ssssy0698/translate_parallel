    "ལོ་བཅུ་ལོན་པ་ལྔ་པ་དངམི་ལྡན་དག་གིས་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "གོང་གི་ལུང་དེ་དག་གིས་མི་གནོད་དེ།",
    "ཕ་མས་མ་གནང་བ་ལྟ་བུ་རེ་ཞིག་པའི་བར་ཆད་དང་།",
    "བར་ཆད་རྣམས་སྐྱེས་པ་དང་བུད་མེད་ཀྱི་རྟེན་གང་ལ་བཞག་ཅེ་ན།",
    "བུད་མེད་ཀྱིས་དུབ་པ་ལྟ་བུ་སྐྱེས་པ་ཁོ་ན་ལ་བཞག།",
    "དགེ་སློང་མའི་ཕམ་པ་ཐུན་མོང་མིན་པ་བཞི་ལྟ་བུ་ནི་བུད་མེད་ཁོ་ན་ལ་བཞག།",
    "ཕ་མ་བསད་པ་སོགས་ཕལ་ཆེ་བ་སྐྱེས་པ་དང་བུད་མེད་གཉིས་ཀ་ལ་བཞག་གོ།",
    "རང་རང་གི་སྐབས་ཀྱི་སྡོམ་པ་སྦྱིན་དུ་རུང་བའི་འགེགས་བྱེད་པས་བར་ཆད་བྱེད་ཅེས་བྱའོ།",
    "འགལ་རྐྱེན་རྣམས་ནི་མ་བསད་པ་མ་ཡིན་ནམ་ཞེས་དགག་ཚིག་གིས་དྲི་ལ།",
    "དྲིས་ནས་བར་ཆད་དང་མི་ལྡན་ན་ཁོ་བོས་ཁྱོད་རབ་ཏུ་བྱུང་བར་བགྱིའོ་ཞེས་པ་ལྟ་བུ་སྐབས་དབྱེ་ལ།",
    "བར་ཆད་དང་ལྡན་ན་སོང་ཤིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "དག་༣༦ན་གིས་ཞེས་མང་ཚིག་སྨོས་པ་ནི་བསྙེན་པར་རྫོགས་པར་བྱེད་པ་དག་གིས་གསང་སྟེ་སྟོན་པ་བསྐོས་ནས་དེས་དྲིས་པ་ལ་དེ་དག་གིས་དྲི་ཞེས་བཏགས་པ་ཡིན་ནོ།",
    "གནས་གཅིག་གི་དྲུང་དུ་དགེ་ཚུལ་གཅིག་ལས་ལྷག་པ་གཉིས་སོགས་ཉེ་བར་བཞག་པར་མི་བྱ་སྟེ་དེ་གཉིས་ཡན་ཆད་གནས་གཅིག་ཏུ་བཞག་ན་རྩེ་ཞིང་གཡེང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རྒན་པས་ལོ་ཉི་ཤུ་མ་ལོན་ན་གནས་གཞན་ལ་རེ་ཤིག་གནས་པའི་དོན་དུ་གཏད་པར་བྱའོ།",
    "དེ་ལ་རེ་ཤིག་གཏད་པ་ཡིན་གྱི་གཏན་དུ་བྱིན་པ་མིན་པའི་ཕྱིར་རོ།",
    "ཁྱོད་བུ་ལོན་ཅན་ཡིན་ནམ་བཏང་སྟེ་བོར་ལ་དེའི་གནས་སུ་ཁྱོད་ལ་ལ་ལའི་བུ་ལོན་མང་ཡང་རུང་ཉུང་ཟད་ཆགས་པ་མེད་དམ་ཞེས་སོགས།",
    "རབ་བྱུང་གི་ཚེ་བུ་ལོན་ཆགས་པ་མིན་ནམ་ཞེས་གསུས་པ་དང་འདི་གཉིས་གང་བྱས་ཀྱང་རུང་ངོ།",
    "བསྙེན་པར་རྫོགས་པར་བྱེད་པ་དག་གིས་ནི།",
    "ངན་སོང་གསུམ་རང་རང་གི་སྡུག་བསྔལ་གྱི་གཡེངས་པའི་ཕྱིར་རམ།",
    "ངན་སོང་བ་རྣམས་ངོ་ཚ་ཤེས་པ་དང་ཁྲེལ་ཡོད་ཤས་ཆེན་པོ་མེད་པའི་ཕྱིར།",
    "རྟེན་གཅིག་ལ་ཉོན་མོངས་པ་གཉིས་ཀྱིས་གནོད་པའམ།",
    "དེ་ལ་སྡོམ་པ་མི་སྐྱེ་བའི་རྒྱ་མཚན་རྟེན་གཉིས་ཀུའི་ཉོན་མོངས་ཤས་ཆེ་བའི་ཕྱིར་རམ།",
    "སྐྱེས་ཙམ་ནས་ཕོ་མོ་གཉིས་ཀུའི་མཚན་ཡོད་པའམ།",
    "ཟླ་ཕྱེད་མོའི་འདོད་པ་བསྟེན་པའི་ཟླ་བ་ཕྱེད་པའི་མ་ནིང་དང་།་",
    "གཟུགས་ཁམས་པ་ལ་ཕོ་མོའི་མཚན་མེད་ཀྱང་མ་ནིང་མིན་ནོ།་།",
    "འདིས་ཉམས་པ་མ་ནིང་གི་རྒྱུད་ལ་སྡོམ་པ་ཡོད་པར་བསྟན་ཟེར་རོ།",
    "དགེ་སློང་མ་འདོད་ལོག་གིས་སུན་ཕྱུང་བ་དང་།",
    "གང་ཡང་རུང་བ་ཞེས་པས་གང་རུང་གཅིག་གིས་ཀྱང་སྡོམ་པ་མི་སྐྱེ་བར་བསྟན་པ་ཡིན་ནོ།",
    "ད་། རིནབདག་རྒྱུ་གཏོང་གིས་རྫོགས་པར་གྱིས་ཤིག་ཟེར་ན་རྫོགས་པར་བྱའོ།",
    "བུད་མེད་ཤས་ཆེར་བསྟེན་པས་དུབ་པ་དང་།",
    "ལང་ཚོ་ལ་མ་བབ་པར་རྒས་པས་ཉམས་པ་བཞིན་དུ་གྱུར་པ་གཏའ་གམ་དང་།",
    "ཐུན་མོང་བའི་སྤྲོས་པ་བུད་མེད་གྱི་ཆོ་གའི་ཁྱད་པར་རོ།",
    "གང་གི་ལག་ནས་ཟ་མ་བཟའ་བ་མི་བྱ་བ་དེ་ལྟ་བུ་རབ་ཏུ་དབྱུང་བར་མི་བྱའོ།",
    "མི་རྣམས་སྐྲ་ནི་དང་པོ་ནས་དཀར་བ་བཀག་གི།",
    "ཕག་གི་མགོ་ལྟ་བུ་དང་།",
    "སོའི་བར་མེད་པའམ་སོ་གཅིག་པུ་ཀེ་རེ་འདུག་པའི་སོ་གཅིག་པ་དང་།",
    "རྐང་པ་གཉིས་གཅིག་གི་སྟེང་དུ་གཅིག་འདོར་ཞིང་འགྲོ་བ་ཉམས་པའོ།",
    "ལག་རྡུམ་ལ་སོགས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་སྐྲ་སེར་ལ་སོགས་པ་རྣམ་པ་དེ་ལྟ་བུ་དག་གི་དགག་པ་དེ་ཡང་རབ་ཏུ་བཟུང་བར་བྱའོ།",
    "མཚམས་ནང་གཅིག་པོ་དེར་བཞི་ལ་སོགས་པ་ཚིག་གཅིག་གིས་ཅིག་ཅར་བསྙེན་པར་རྫོགས་སུ་མི་རུང་སྟེ།",
    "མཚམས་རེ་རེ་བསྒྲུབ་བྱ་གཉིས་གཉིས་ཏེ་བཞི་གཅིག་ཅར་བྱར་རུང་སྟེ།",
    "བཙུན་པ་གསོལ་བ་གཅིག་དང་ལས་གཅིག་གིས་གང་ཟག་བཞི་བསྙེན་པར་རྫོགས་བགྱིད་ན་ལས་ཀྱང་བགྱིས་ལ་དགེ་སློང་དེ་དག་ཀྱང་འདས་པ་དང་བཅས་པར་མི་འགྱུར་བ་མཆིས་སམ།",
    "སྐྲ་དང་སེན་མོ་བྲེག་པའི་ཆོ་ག་ལུས་གཙང་མས་གོས་བགོ་བའི་ཕྱིར་ཁྲུས་བྱ་བའོ།",
    "གཙུག་ཕུད་ཀྱང་བྲེག་གོ་ཞེས་སྟེར་ན་དེའི་ཞེས་གསུང་མོད།",
    "དེ་གཉིས་ཀྱི་ཁྱད་པར་ནི་འདྲེག་མཁན་དཀོན་མོད་ཀྱིས་བཞག་ལ།",
    "ཁ་ཅིག་རྟགས་འདྲེ་བ་ཤས་ཆེ་ཆུང་གིས་ཡིན་ཟེར།",
    "སྐྲ་བྲེག་མོད་གཙུག་ཕུད་མི་བྲེག་རིམ་ཞེ་ན།",
    "སེན་མོ་མཐའ་དམའ་ཞིང་དབུས་མཐོ་བ་སྤུ་གྲིའི་སོ་ལྟ་བུའམ།",
    "སེན་མོ་དེ་དག་མཛེས་པར་བྱ་བའི་ཕྱིར་མཚོན་གྱིས་སྤྱིལ་བར་མི་བྱའོ།",
    "ཞེས་གང་གིས་གནས་གང་དུ་ཇི་ལྟར་བྲེག་ཅིང་དོར་བར་བྱ་ཞེ་ན།",
    "སེན་མོ་བཅད་པ་ཡང་བཏིང་བ་ནས་དོར་བའི་བར་དེ་བཞིན་ནོ།",
    "དགེ་སློང་མ་དེ་འདྲེག་མཁན་སྐྱེས་པ་ལ་ཀུན་ཏུ་ཆགས་པར་གྱུར་ན་ཞལ་ཏ་བྱེད་པ་མོས་ཆགས་པར་མི་འགྱུར་བའི་ཐབས་རྗེས་སུ་བསྟན་པར་བྱའོ།",
    "ཕུ་ནུ་མོ་དྲན་པ་ཚུལ་བཞིན་ཉེ་བར་བཞོག་ཅིག།",
    "དགེ་སློང་མ་འདི་ལ་ན་ཚོད་དང་བསྟུན་ནས་མ་དང་སྲིང་མོ་དང་བུ་མོའི་འདུ་ཤེས་ཉེ་བར་ཞོག་ཅིག་ཅེས་སོ།་",
