    "ཕ་མ་གཉིས་གས་མོན་སྲས་རྡེའུ་ལ་སོགས་པའི་ཕྱེ་མ་གླ་རྩི་ལ་སོགས་པའི་དྲིས་བསྒོས་པས་བཀྲུར་རུང་ངོ་།་།",
    "དགེ་སློང་མས་ནམ་ཡང་བུད་མེད་ལ་ཕྱེ་མས་མི་གཏོར་རོ།",
    "ཀུན་ཏུ་ཞེས་སྨོས་པ་ནི་འགྲེལ་པ་བྱེད་པ་ན་རེ་གཞུང་མཛེས་པ་སྒྲུབ་པའི་ཕྱིར་ཟེར་རོ།",
    "ཁ་ཅིག་ན་རེ།",
    "འདོད་ཆུང་ཆོག་ཤེས་ཀྱི་བཅང་དུ་རུང་བ་ཙམ་དུ་ཡང་བསྟན་པ་ཡིན་གསུང་པ་ལ་གཞན་དག་ན་རེ།",
    "གོས་གཞིར་དེ་མ་གཏོགས་པ་བཅུ་གསུམ་རང་རང་གི་མིང་གིས་སྨོས་པའི་ཕྱིར།",
    "ཁྲུས་ཁང་དེར་འོག་ཏུ་སོ་ཕག་གི་གཅལ་དགྲམ་མོ།",
    "སོ་ཕག་གི་དུམ་བུས་དྲུད་པས་རྐང་པ་གཉིས་ལས་གཞན་པའི་ལུས་ལ་དྲུད་པར་མི་བྱའོ།",
    "སོ་ཕག་གི་དུམ་བུ་དེ་ནི་གྲི་སོགས་རྣོན་པོ་དང་།",
    "རྒྱ་མཚོའི་དབུ་བ་སོགས་བཞར་སྤྱད་གཉིས་ཀྱི་མཚོན་པའི་དཔེ་ཡིན་པས་དེ་དག་གིས་ཀྱང་མི་དྲུད་དོ།",
    "དགེ་སློང་མས་ནི་ཁྲུས་སམ་གཞན་གྱི་ཚེ་ལུས་ཀྱི་ཆ་གང་དུ་ཡང་ཁུ་ཚུར་དག་དང་གོས་དྲིལ་བ་དག་ཡན་ཆད་གང་གིས་ཀྱང་དྲུད་པར་མི་བྱའོ།",
    "བུད་མེད་ནི་འདོད་ཆགས་ཤས་ཆེ་བས་རྐྱེན་དེས་ཉོན་མོངས་པའི་འགྱུར་བ་བསྐྱེད་པ་སྤང་པའི་ཕྱིར་རོ།",
    "མ་མོ་ལས།",
    "འདི་ནི་རེག་བྱ་བསྟེན་པ་བཀག་གམ་སྙམ་པ་བསལ་བའི་ཕྱིར་གནང་བའོ།",
    "བསྲོ་ཁང་གི་ཁང་པ་གང་དུ་བྱ་ཞེ་ན།",
    "བསྲོ་ཁང་གི་ཁང་པ་བྱ་བ་ནི་གྲམ་ས་ཆེ་བར་བཟང་སྟེ།",
    "བསྲོ་ཁང་གི་སྒོར་སྒོ་གླེགས་དང་དེ་བཅད་པའི་ཐབས་སྒོ་གཏན་དང་།",
    "ཆུ་དྲོན་བཞག་པའི་ཕྱིར་དུ་བསྲོ་ཁང་གི་ནང་གི་ཕྱོགས་སུ་བཞག་སྟེགས་བྱའོ།",
    "བདེ་བར་གནས་པའི་རྐྱེན་མེ་བུད་པའི་གནས་ཀྱི་སར་འོག་ཏུ་སོ་ཕག་གི་གཅལ་གཞུག་པར་བྱའོ།",
    "མེ་སྦ་བ་དེའི་ཆེད་དུ་ལྕགས་ཀྱི་ཐལ་ཕྱགས་ནལ་ཟེ་བཅང་བར་བྱའོ།",
    "རྐང་པ་ས་ལ་བཞག་པ་ན་རྡུལ་གྱིས་གོས་པས་བསྲོ་ཁང་གིས་གཞིར་སྐྱེ་བ་ཉིད་ཀྱིས་སམ་སྦངས་པས་གཤེར་བའི་རྩྭ་གཤེར་བ་དག་དགྲམ་མོ།",
    "རྫས་ཀྱི་བླ་ཁང་སྐྱོང་གིས་ཕྲུགས་སྤྱད་དེ་ལུང་མིག་ནས་ཐ་གུས་བཏགས་ཏེ་དབེན་པར་བཞག་གོ།",
    "བསྲོ་ཁང་དེར་དགེ་སློང་གིས་ཁྲུས་མི་བྱའོ།",
    "ཆུ་ཚ་བ་དེར་ཆུ་གྲང་མོས་བསྲེའོ།",
    "བཀྲུ་བཤལ་དང་ཆག་ཆག་གི་ཆུ་ལ་སོགས་པར་ཡང་ཚ་ན་གྲང་མོས་བསྲེའོ།",
    "ཁྲུས་ཁང་དེར་ཐལ་བ་དང་བ་ལང་གི་ལྕི་བ་དང་སོ་ཤིང་གིས་བཀང་བའི་གྱོ་མོ་དག་བཞག་པར་བྱའོ།",
    "དེའི་ཕྱིར་ཚ་བའི་དུས་ནི་དགེ་སློང་གིས་འཇུག་ངོགས་གང་ཡང་རུང་བར་ཁྲུས་བྱ་ལ།",
    "ཁོ་བོ་ཁྱེད་ཅག་ལས་གང་རུང་ཡིན་ནོ་ཞེས་ཤན་བསྲེ་བས་ཉེ་བར་གནས་པར་གྱུར་ན་བསྲོ་ཁང་དེར་གནས་པར་གཏོགས་པའི་དགེ་སློང་རྣམས་ཀྱིས་ཤན་བསྲེ་བ་དེ་ངེས་པར་ཤེས་པར་བྱ་བའི་ཕྱིར་ཁྱོད་སུ་ཡིན་ཞེས་དྲི་བར་བྱ་ཞིང་ནང་དུ་མ་ཞུགས་པ་འཇུག་འདོད་པ་ལ་དྲི་བར་བྱ་བ་དེའི་ཆེད་དུ་དགེ་སློང་སྒོ་བ་བསྐོའོ།",
    "གང་གི་ཕྱིར་བསྐོ་ན་གཞན་དེར་མི་འཇུག་པར་བྱ་བའི་ཕྱིར་རོ།",
    "བསྲོ་ཁང་དེར་སྐུ་མཉེ་སོགས་བྱི་དོར་གྱི་ལས་ནི་རང་གི་ལྷན་ཅིག་གནས་པ་དང་ཉེ་གནས་དག་གིས་བྱའོ།",
    "གཞན་མ་མོ་ལས་ནི་གཞོན་༤༦བཏེརབས་དག་གིས་བྱའོ།",
    "བྱི་དོར་གྱི་ལས་ཀྱི་ངོ་བོ་ནི་མེ་སྦར་བ་དང་ཟངས་དང་འབྲུ་མར་དང་སོ་ཤིང་དང་བ་ལང་གི་ལྕི་བ་དང་།",
    "ལྷན་ཅིག་གནས་པ་ལ་སོགས་པ་དེ་དག་གི་བྱི་དོར་གྱི་ལས་ནི་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལའོ།",
    "ལྷན་ཅིག་གནས་པ་དང་ཉེ་གནས་དག་གིས་བསྲོ་ཁང་དེར་ཁྲིའུ་དང་ཉ་ཕྱིས་སོགས་སྣོད་སྤྱད་དག་ཀྱང་གཙང་སྦྲ་ཉིད་བྱས་ནས་རངརང་གི་གནས་ཇི་ལྟ་བར་གཞག་གོ།",
    "བུམ་པ་དང་རས་ལ་སོགས་པའི་སྣོད་སྤྱད་ཐམས་ཅད་ལ་ཆོ་ག་དེ་བཞིན་དུ་གཙང་སྦྲ་བྱས་ནས་རང་རང་གི་གནས་ཇི་ལྟར་གཞག་གོ།",
    "འཇུག་ལྡོག་གི་སྤྱོད་ལམ་མཛེས་པ་དང་།",
    "རི་དྭགས་ཕྲ་མོ་ལྟ་བུའི་ཉོན་མོངས་པས་མི་ཐུབ་པའི་ཕྱིར་རོ།",
    "ཁྱི་ལྟ་བུའི་ཉོན་མོངས་པས་ཕམ་པར་བྱས་པའི་ཕྱིར་རོ།་།",
    "གཅན་གཟན་ཕྲ་མོས་ཕམ་པར་མི་ནུས་པའོ།",
    "འཚོ་བ་མི་གཙང་གཅན་གཟན་ཕྲ་མོས་ཕམ་པར་ནུས་པའོ།",
    "དེ་འབའ་ཞིག་གིས་བཀྲུའམ་ཞེ་ན།",
    "མི་རྩུབ་པའི་ཕྱིར་བཀུ་མཉེ་བྱས་པ་དེ་དང་བྲལ་བའི་ཕྱིར་སྲན་ཆུང་གི་ཕྱེ་མ་ལ་སོགས་པ་ཁྲུས་ཆལ་གྱིས་ལུས་བཀྲུས་ཏེ་ཁྲུས་བྱའོ།",
    "ཁྲུས་བྱས་པའི་འཇུག་ཏུ་གཙུག་ལག་ཁང་གི་གར་བབ་བབ་ཏུ་རྐང་པ་མི་བཀྲུའོ།",
    "གཙུག་ལག་ཁང་གི་སྟེང་ཡང་ཐོག་གི་སྒོ་ལ་ལྟོས་པའི་ཤར་ལྷོའི་མཚམས་སུའོ།",
    "དེས་ན་གསེར་ལས་བྱས་པ་སོགས་བཀག་གི།",
    "གང་ཟག་གི་ཆོལ་ཟངས་ནི་གནས་ཁང་གི་སྒོ་གླེགས་ཀྱི་ཕག་ཏུའོ།",
    "གཙུག་ལག་ཁང་ཉམས་པ་སྤང་བའི་ཕྱིར་དུ་གཙུག་ལག་ཁང་གི་ཕྱོགས་གང་དུ་ལྷུང་བཟེད་ཀྱི་བྱི་དོར་ལ་སོགས་པ་བྱས་པ་དེར་ཆུས་བྱུག་གོ་ཡང་ན་རྣམ་པ་གཞན་གྱིས་བསྐུའོ།",
    "གང་གིས་བསྐུ་ན་བ་ལང་༤༨བ་གི་ལྕི་བའམ་འཇིམ་པས་སོ།",
    "མཐེ་བོའི་ཚིགས་ཀྱི་ཕྱོགས་གཅིག་ནས་བརྩམས་ཏེ་ཚིགས་ཀྱི་ཕྱོགས་གཅིག་གི་བར་སྟེ།",
    "བརྩམས་ཏེ་ཚིགས་དེ་ཉིད་ཀྱི་ཕྱོགས་གཅིག་གི་བར་དུ་ལྟོ་རོལ་ནས་གཞལ་བ་ཞེས་དང་།",
    "དེས་ན་མཐེབ་སོར་གཅིག་གི་ལྷག་མ་སྨད་ཀྱི་ཆར་ཤོང་བ་དེ་ནི་རིགས་པ་ཡིན་ནོ།",
    "འབྲས་འཕེལ་པོའམ་ཐུག་པོ་ཆེ་སྐམ་པོ་ཡུལ་མ་ག་དྷ་དབུས་འགྱུར་འཆང་གི་བྲེའུ་ཆུང་གང་ཤོང་བ་དེ་ནི་རིགས་པ་ཡིན་ནོ།",
    "བྲེའུ་ཆུང་གི་ཚད་གང་ཞེ་ན།",
    "ཁྱོར་བ་ཉི་ཤུ་རྩ་གཅིག་ཤོང་བ་སྟེ།",
    "མ་ག་དྷའི་བྲེའུ་ཆུང་དོ་ལ་ནི་བོད་ཀྱི་བདུན་ཕུལ་བཞི་དང་ཁྱོར་དོ་ཡོད་དོ་ཞེས་སོ།",
    "ཚོད་མ་དག་མང་བ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་ཚོད་མ་ཇི་ཙམ་གྱིས་འབྲས་ཆན་སྤག་ནུས་པ་དེའི་ཚད་ཁོ་ནའི་ཚོད་མ་འདིར་བཟུང་གི་ལྷག་པ་ནི་མ་ཡིན་ཞེས་དང་།",
    "དགེ་སློང་གིས་བྱིན་གྱིས་བརླབ་རུང་གི་ལྷུང་བཟེད་ཆུང་ངུར་རིགས་པ་ཡིན་ནོ།",
    "ཁའི་ཆའི་མཐའ་ཁོ་ན་ནས་མཐེ་བོའི་ལྟོ་གང་གི་ལྷག་མར་འབྲས་ཐུག་པོ་ཆེ་མ་གདྷའི་བྲེའུ་ཆུང་གང་ལས་ལྷག་པ་དོར་མ་ཆོག་པ་སྲན་ཚོད་དང་བཅས་ཚོད་མ་དང་བཅས་པ་ཤོང་བ་དེ་ནི་ལྷུང་བཟེད་འབྲིང་དུ་རིགས་པ་ཡིན་ནོ།",
    "ལྷུང་བཟེད་ཆུང་བ་ཚོང་འདུས་འགུར་མོའི་གསེར་བྲེའི་འབྲས་ཆན་བྲེ་ལྔ།",
    "མཐེ་བོའི་ལྟོ་གང་གི་གོས་ལ་བཞི་གསུམ།",
    "དགེ་སློང་མས་དགེ་སློང་གི་ལྷུང་བཟེད་ཆུང་ངུ་ལས་ལྷག་པ་མི་བཅང་སྟེ།",
    "དགེ་སློང་གི་ལྷུང་བཟེད་ཆུང་ཚད་དེ་དགེ་སློང་མའི་ལྷུང་བཟེད་ཆེ་ཚད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་དག་གི་ཆུང་ངུ་ནི་འབྲས་ཐུག་པོ་ཅེ་བཙོས་པ་སྲན་ཚོད་དང་བཅས་ཚོད་མ་དང་བཅས་པ་འགྲངས་པ་ཙམ་ཤོང་བ་ཡིན་ནོ།",
    "ཆོམ་རྐུན་གྱི་འཇིགས་པ་དང་བཅས་པའི་གནས་སུ་འགྲོ་ན་བྱིན་གྱིས་བརླབ་རུང་གི་ལྷུང་བཟེད་ཆུང་ཚད་ལས་ཀྱང་ཆུང་བའི་ལྷུང་བཟེད་ཆུང་ངུས་འགྲོ་བར་བྱའོ།",
    "དེ་དག་ནི་དྲང་སྲོང་གི་སྣོད་ལ་མ་གུས་པ་སྤང་བའི་ཕྱིར་རོ།",
    "ལྷུང་བཟེད་རྡོའི་སྟེང་དུ་རེ་ཞིག་ཀྱང་མི་བཞག་སྟེ་འཆག་པ་སྤང་དགོས་པས་སོ།",
    "ཁྱམས་ལ་སོག་ས་པའི་ཕྱོགས་གར་བབ་བབ་ཏུ་ལྷུང་བཟེད་རེ་ཤིག་མི་བཞག་གོ།",
    "ལྷུང་བཟེད་དེ་ཡུལ་གཞན་དུ་བསྐུར་བ་ནི་སྣོད་ལ་ལུང་ཐག་བཏགས་ཏེ་མཆན་ཁུང་གིས་ཁུར་ན་བཟང་ངོ་།་།",
    "གང་ཟག་གིས་མི་སྲེལ་ལོ།",
    "ལྷུང་བཟེད་ཀྱི་བུ་གུའི་ལྷན་པར་བུ་རམ་དང་རྒྱསྐྱེགས་ཀྱི་ཚིག་མ་ལ་ཅ་དང་སྤྲ་ཚིལ་དང་རོ་ཉེ་ཞ་ཉར་དཀར་པོ་དང་ཚོན་མོ་སྟེ་ཉེ་ནག་པོ་དག་མི་བཟང་སྟེ་མི་སྲ་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱེ་མ་ཞེ་ན།",
    "དེ་འབའ་ཞིག་གིས་གླནནམ་ཞེ་ན།",
    "ལྕགས་ལྷུང་གི་ལྷན་པ་བསྟན་ཟིན་ནས།",
    "ལྕགས་ལྷུང་ནར་མར་ཟས་ལ་སྤྱོད་པ་ཉིད་ན་ཟླ་བ་དྲུག་གི་འོག་ཏུ་ཁ་བསྒྱུར་བའི་ཕྱིར་དུ་སྲེག་པར་འོས་པ་ཉིད་ཡིན་ནོ།་།",
    "ཐབས་གང་གིས་བསྲེག་ན་ལྷུང་བཟེད་སྲེག་པ་དེའི་ཆེད་དུ་རྫ་བོ་བསྲེལ་བར་བྱའོ།",
    "རྫ་བོ་དེ་ཉིད་དུ་རྫ་མཁན་གྱིས་བྱས་ནས་གྲུབ་པའམ་དབྱིབ་མོ་ཡང་རུང་ངོ།",
    "༥༢ན་དབྱིབ་མོ་ཇི་ལྟར་བྱ་ན།",
    "རྫ་གཞན་ཐལ་བས་བཀང་སྟེ།",
    "དེ་ནས་བ་ལང་གི་ལྕི་བ་དང་སོག་མས་རྫ་བོ་བཅར་ཏེ་མེ་སྦར་རོ།",
    "ཁྱིམ་པ་ལ་དགེ་སློང་གི་གནས་རྣམས་བརྗོད་པར་མི་བྱ་སྟེ།",
    "འདི་བྱ་དཀའ་འོ་སྙམ་ནས་རབ་བྱུང་གི་བར་ཆད་སྤང་བའི་ཕྱིར་རོ།",
    "ཐུན་མོང་དུ་ཇི་ལྟར་བྱ་བ་དང་།",
    "ཡོན་བདག་གིས་རྙེད་པ་སྦྱོར་བའི་གནས་ཁང་དང་ལས་ལ་མི་བསྐོ་བ་དང་ཉེ་གནས་དགེ་ཚུལ་ལ་སོགས་པའི་སྟ་གོན་གྱིས་གནས་དེ་བཙལ་བར་བྱའོ།་།",
    "གནས་མཚན་ཉིད་པ་ཡོད་ན་ཡང་གཞོན་ནུའི་ནང་ནས་རྒན་པ་ལ་རེ་ཞིག་གི་གནས་ཉིད་ཀྱིས་བྱ་བ་ཞུ་བར་བྱ་སྟེ།",
    "འོས་པ་གནས་ཡོངས་སུ་ཚོལ་བ་ལ་ཞུགས་པ་ནི་གནས་མེད་ན་རེ་ཞིག་མི་གནས་པར་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "གནས་པས་ལས་སུ་བསྐོས་པར་སོང་བ་ན་ལས་སུ་བྱ་བ་དེ་གཞན་བྱུང་ན་གཞན་དེ་སྒྲུབ་པའི་ཕྱིར་མ་ཞུས་ཀྱང་ཉེས་པ་མེད་དེ།",
    "ཆོ་ག་གང་གིས་གཟུང་ཞེ་ན།",
    "འོ་ན་ཐལ་མོ་སྦྱར་ནས་ལེན་ནམ་ཞེ་ན།",
    "གང་གིས་གནས་བཅས་པ་འཇིག་ཅེ་ན།",
    "ཐབས་གང་གིས་ཀྱང་དྲང་པོར་མི་བྱེད་པ་ཉིད་ཡི་ན་ན།",
    "གཉིས་པ་ཐུན་མོང་དུ་ཇི་ལྟར་བྱ་བ་ནི།",
    "མཚན་མོ་ཁའི་ནང་དུ་དྲི་མ་གནས་པ་ནི་མ་བཀྲུས་པ་ཉིད་ཡིན་པས།",
    "སོ་ཤིང་གིས་ཁ་སྦྱངས་ནས་སོ་ཤིང་དེ་དབེན་པར་དོར་རོ།་།",
    "ལྕེ་བཞར་བའི་དོན་འདི་ལ་སོ་ཤིང་གི་ཚལ་བས་ལྕེ་བཞར་དུ་རུང་ངོ།",
    "སོ་ཤིང་གི་ཚལ་བ་དེ་ཧ་ཅང་བཟུར་མི་རྣོ་བར་བྱ་བའི་ཕྱིར།",
