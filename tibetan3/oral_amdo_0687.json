    "སྤྱི་ལོ་༢༥ལོར་ཀརྨ་བི་ཤྭའི་གེ་སར་སྟོང་ཐང་གི་ལས་རའི་ནང་དུ་ཞུགས་ནས་ལོ་གཉིས་ལྷག་ཙམ་ལས་གཞིའི་ཡན་ལག་གི་དབུ་འཛིན་བྱེད་རིང་།",
    "ཁོང་གི་ཀརྨ་སྒར་བྲིས་ཀྱི་ལག་རྩལ་མཚོན་བྱེད་ཀྱི་ཞལ་ཐང་ནི།",
    "ཆུ་ཁྱུང་པོ་བཅས་པའི་དཔུང་ཚོགས་ཀྱིས།",
    "མོང་བཟའ་ཁྲི་ལྕམ་རུ་ཡོང་བཟའ།",
    "གཙང་གི་རྒྱལ་པོ་མར་མུན།",
    "དེ་ནས་རིམ་བཞིན་ཡབ་མེས་དུས་སུ་ངོ་ལོག་བྱས་པའི་ཆབ་འབངས་མཐའ་དག་སླར་ཡང་བཙན་པོའི་མངའ་འོག་ཏུ་བཅུག་ལྕགས་སྟག་སྤྱི་ལོ་༦༣ལོར་མོང་བཟའ་ཁྲི་ལྕམ་ཁབ་ཏུ་བཞེས།",
    "བོད་ཀྱི་ཤར་ཕྱོགས་སུམ་པའི་ཡུལ་དུ་བློན་ཆེན་པོ་མྱང་མང་པོ་རྗེ་ཞང་སྣང་གིས་དམག་བརྒྱབ་མ་དགོས་པར་རྒྱལ་ཁམས་ཡོངས་རྫོགས་ཐབས་མཁས་ཀྱི་བྱ་བ་ལ་བརྟེན་ནས།",
    "དམག་དཔུང་གིས་གཡུལ་བཤམས་མ་དགོས་པར་བྱང་ངོས་ཀྱི་རྒྱ་དང་འ་ཞས་དཔྱ་ཁྲལ་འཇལ་ཞིང་།",
    "དབུ་རུ་ཤོད་ཆེན་གྱི་སའི་ལྟེ་བ་འོ་ཐང་གི་མཚེའུའི་འགྲམ་དེར།",
    "ཆུ་འབྲུག་སྤྱི་ལོ་༦༣༢ལོར་བལ་པོ་རྒྱལ་པོ་དང་འབྲེལ་བ་བཙུགས་ཏེ་བལ་པོ་རྒྱལ་པོའི་སྲས་མོ་བལ་བཟའ་ཁྲི་བཙུན་ཁབ་ཏུ་བསུས།",
    "པཎྜི་ཏ་ལྷ་རིག་པའི་སེང་གེ་ལས་སྒྲ་ཀ་ཙན་དབྱངས་གསུམ་སོགས་ལེགས་སྦྱར་གྱི་བརྡ་སྤྲོད་རིག་པའི་གཞུང་རྣམས་ལ་ལོ་ངོ་དྲུག་གི་བར་དུ་འབད་བརྩོན་ཆེན་པོས་གསན་སྦྱོང་གནང་བས་མཁས་པའི་རྩེར་སོན།",
    "ལེགས་སྦྱར་གྱི་དབྱངས་གསལ་ལྔ་བཅུ་པོ་རེ་རེ་ལ་བོད་ཡིག་གི་སྒྲ་ཚབ་རེ་རེ་བྱས་པའི་ཚེ།",
    "དེ་ནས་བོད་དུ་ཕྱིར་ལོག་ཁར་སྒྲ་རིག་པ་ཁག་གི་རྒྱ་དཔེ་དང་།",
    "ི་གཙུག་ལག་ཁང་གི་རྨང་གཞི་བཏིང་།",
    "བཟའ་མོང་རྗེ་ཁྲི་དཀར་ཁབ་ཏུ་བཞེས།",
    "སྣུབས་བཙན་ཏོ་རེ་གཉིས་ཀྱིས་བློན་པོ་བྱས།",
    "སྲིང་མོས་བཙན་པོ་སྲོང་བཙན་སྒམ་པོ་ལ་འཕྲིན་བཏང་ནས་དམག་འབེབས་ཤིང་ཞང་ཞུང་མངའ་འོག་ཏུ་བསྡུ་དགོས་པའི་བརྡ་ལྟར་བོད་དམག་བཏང་སྟེ་ཞང་ཞུང་མངའ་འོག་ཏུ་བསྡུས།",
    "ཁོད་དཔོན་བློན་ཆེན་པོ་མགར་སྟོང་བཙན་ཡུལ་ཞང་ཞུང་གི་ཁོད་བཅའ་ཡུལ་ཁྱུང་ལུང་རྡོལ་མཁར་དང་།",
    "ཁོད་དཔོན་དེ་དག་གིས་ཀྱང་རང་བློ་སྒེར་གཅོད་ཀྱིས་ཁོད་མ་བཅས་པར།",
    "ལོ་དེར་རྒྱ་ནག་ཐང་གི་རྒྱལ་པོའི་སྲས་མོ་ཝུན་ཤིང་ཀོང་ཇོ་བོད་དུ་གདན་དྲངས།",
    "ཐ་མ་ཟངས་ཡིག་ལྕགས་ཡིག་སྟེ་དྲུག་པོ་རེ་རེ་ལ་ཆེ་ཆུང་གཉིས་རེ་དབྱེ་བས་བཅུ་གཉིས་སོ།",
    "བྱང་ཐང་གི་ས་མཁན།",
    "ཁྲོམ་རྟགས་ཀྱི་ཕྱག་རྒྱ་རུ་མཚོན་ཞེས་པ་འདི་ནི་དམག་གི་བཀའ་ཤོག་མཚོན་བྱེད་ཀྱི་ཐེལ་ཙེ་ཡིན།",
    "ཞེས་གསལ་བ་འདི་ནི་ལས་ཚན་སོ་སོའི་མི་སྣ་རྣམས་ལ་བཟང་ངན་གྱི་དབྱེ་བ་ཕྱེས་པའི་རྟགས་སུ་དངོས་པོ་དང་མིང་གི་སྒོ་ནས་མཚོན་རྟགས་རེ་གནང་སྟེ་བཟང་ལ་བསྟོད་བསྔགས་དང་།",
    "དམག་གི་རུ་སྒར་བརྒྱད་དུ་བཏབ།",
    "དམག་གི་རུ་ཆེན་བརྒྱད་ཅེས་པ་ནི།",
    "དམག་གི་བཞེད་པ་ནི་མཚོ་ལ་ཁ་བ་འབབ་བཞིན་དུ་འོང་སྐད།",
    "རུ་རྟ་མཚལ་བུ་གཟིག་རིས།",
    "གཡོ་རུ་སྟོད་ཀྱི་དམག་དཔོན་ནི་མྱང་སྟག་གཟིག་གཡུ་བཙན།",
    "རུ་རྟ་མོག་རོ་བུན་བུན།",
    "དམག་གི་བཞེད་པ་ནི་མཚོ་ལ་སྦྲང་ཆར་འབབ་པ་བཞིན་དུ་འགྲིམས་ནས་འོང་ངོ།",
    "དམག་དཔོན་མཆིམས་རྒྱལ་གཟིགས་ཤུད་རིང་།",
    "གཡོ་རུ་སྨད་ཀྱི་དམག་དཔོན་ནི་མཆིམས་རྒྱལ་གཟིགས་ཤུད་རིང་།",
    "དམག་གི་བཞེད་པ་ནི་སྤང་ལ་མེ་ལྕེ་མཆེད་པ་བཞིན་འོང་ངོ།",
    "དམག་གི་བཞེད་པ་ནི་སྤང་ལ་མེ་ལྕེ་མཆེད་པ་བཞིན་འོང་ངོ།",
    "དམག་གི་བཞེད་པ་ནི་གངས་ལ་སེང་གེ་འགྲིམ་པ་བཞིན་འོང་སྐད་དོ།",
    "དཔུང་རོགས་ནི་མཆིམས་བཙན་བཞེར་ལྷ་གཟིགས།",
    "དམག་གི་བཞེད་པ་ནི་གངས་ལ་སེང་གེ་འགྲིམ་པ་བཞིན་འོང་སྐད་དོ།",
    "ཡུལ་ཆེན་སོ་སོའི་དཔོན་པོ་རྣམས་ཀྱིས་གོང་གི་བཙན་པོའི་བཀའ་ལུང་ལ་བརྩི་བཀུར་དང་།",
    "མོན་འབྲལ་ཁ་བཞི་མན་ཆད་ན།",
    "གྲུ་གུ་གསེར་མིག་ཅན་གྱི་ཆུང་མ་ཧོར་མོ་བང་མདུང་ཅན་བྱ་བ་ནུ་མ་གཡས་པ་མེ་བཙས་བསྲེགས་ཏེ་འཇིགས་རྔམ་སྟོན་ཅིང་།",
    "མདའ་སྤར་མོ་གསུམ་གྱི་མགོ་ཙམ་པ་འཕེན་པའི་ཚེ་ན་རྡོ་ལེབ་ལའང་ཅུར་ཏེ་འགྲོ་བ་འཇིགས་པ་ཅན་ལ་ཇི་མི་སྙམ་པར་འཐབས་ཚེ།",
    "དཔའ་ཚན་དུ་སྟག་གི་སྤྱིལ་བུ་ཕུབ།",
    "གདོང་ཁྲག་གིས་བྱུགས་ཏེ་སླར་མི་ལྡོག་པའི་རྩིས་སུ་བྱས་ནས་རྒོལ་བས་གྲུ་གུ་བཏུལ།",
    "ལྗང་མོ་ཐག་མདུང་གི་ཅུར་ཏེ་འགྲོ་བ།",
    "ཐལ་བྱུང་དུ་ཕུག་པ།",
    "རྩེ་མོ་བཙུགས་ནས་དམག་གསེབ་ཏུ་རྒྱུག་པ་ལ་རྒོལ་བའི་ཚེ་དཔའ་ཚན་དུ་རལ་གྲི་ལ་རི་མོ་བྲིས།",
    "རྒྱའི་སོ་མཁར་གྱི་ལྕགས་རིའི་སྟེང་དུ་རྟ་པ་དགུ་སྒྲིག་རྒྱུགས་པའི་ནང་ནས་མི་མཁར་ཐུང་ཙམ་གྱིས་སྟ་རེའི་ཁ་ཁྲུ་རེ་ཙམ་པ་ཐོགས་ཏེ་རྒོལ་བའི་ཚེ།",
    "ལྟོང་ལྟོང་གི་བུ་ཕྱུགས་མཚམས་ཀྱིཀྱིས་དཔོན་བྱས།",
    "སྲིན་མོའི་དཔུང་འགོ་གཡོན་གནོན་པ་ལ་ཡར་ཀླུང་ཁྲ་འབྲུག་བྱམས་པ་མི་འགྱུར་བའི་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་དཔུང་འགོ་གཡས་གནོན་པ་ལ་དབུ་རུ་ཀ་ཚལ་གྱི་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་དཔྱི་འགོ་གཡས་གནོན་པ་ལ་གཡས་རུར་གཙང་འགྲམ་གྱི་ལྷ་ཁང་བཞེངས།",
    "༤ གྲོམ་པ་རྒྱང་གི་ལྷ་ཁང་།",
    "སྲིན་མོའི་དཔྱི་འགོ་གཡོན་གནོན་པ་ལ་རུ་ལག་ཏུ་གྲོམ་པ་རྒྱང་གི་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་གྲུ་མོ་གཡས་པ་གནོན་པ་ལ་ཀོང་པོ་བུ་ཁང་བཞེངས།",
    "སྲིན་མོའི་གྲུ་མོ་གཡོན་པ་གནོན་པ་ལ་ལྷོ་བྲག་ཁོ་ཐིང་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་པུས་མོ་གཡོན་གནོན་པ་ལ་མང་ཡུལ་བྱམས་སྤྲིན་དགེ་རྒྱས་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་པུས་མོ་གཡས་གནོན་པ་ལ་བྱང་པྲ་དུན་རྩེའི་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་ལག་མཐིལ་གཡས་གནོན་པ་ལ་ཁམས་ཀློང་ཐང་སྒྲོལ་མ་ལྷ་ཁང་བཞེངས།",
    "༢ མོན་སྐྱེར་ཆུ་ལྷ་ཁང་།",
    "སྲིན་མོའི་ལག་མཐིལ་གཡོན་གནོན་པ་ལ་མོན་སྐྱེར་ཆུ་ལྷ་ཁང་བཞེངས།",
    "སྲིན་མོའི་རྐང་མཐིལ་གཡས་གནོན་པ་ལ་མཚལ་རིགས་སྒྲོལ་མ་ལྷ་ཁང་བཞེངས།",
    "བོད་ཡུལ་དབུས་སུ་མོང་གི་ཁྱིམ་རྒྱུད་དུ་འཁྲུངས།",
    "སྐབས་དེར་བན་བོན་གང་གི་ལུགས་ཡིན་མ་གསལ།",
    "མོང་བཟའ་ཁྲི་ལྕམ།",
    "༢ རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་བཙུན་མོ་གཉིས་པ་མི་ཉག་བཟའ་རུ་ཡོང་བཟའ་ནི།",
    "མཚོ་མ་ཕམ་རྒྱལ་པོའི་སྲས་མོ་རུ་འཁྲུངས།",
    "སྲོང་བཙན་སྒམ་པོའི་སྲིང་མོ་སད་མ་ཀ་ཞང་ཞུང་རྒྱལ་པོའི་བཙུན་མོར་ཕྱིན་པ་དང་དུས་མཚུངས་ཙམ་ན།",
    "མཛད་རྗེས་གཙོ་བོར་ཐེམ་བུ་ལྐོག་གི་ལྷ་ཁང་བཞེངས།",
    "སྲོང་རྒྱལ་པོ་མོ་བཞི་པ་བལ་བཟའ་ཁྲི་བཙུན་ནི།",
    "དེང་དུས་བལ་པོའི་རྒྱལ་ས་ཀ་ཏེ་མན་ཏུར་ཤིང་འབྲུག་སྤྱི་ལོ་༦༣༢བཙན་གྱི་སྲས་མོ་རུ་འཁྲུངས།",
    "གཙོ་བོར་ས་ཕག་སྤྱི་ལོ་༦༣༩ལོར་ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་བཞེངས།",
    "༥ རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་བཙུན་མོ་ལྔ་པ་རྒྱ་བཟའ་ཀོང་ཇོ་ནི།",
    "རྒྱ་ནག་ཐང་གི་རྒྱལ་པོ་ཐང་ཐའེ་ཙུང་གི་སྲས་མོ་རུ་འཁྲུངས།",
    "མཛད་རྗེས་གཙོ་བོར་རྒྱ་སྟག་ར་མོ་ཆེའི་ལྷ་ཁང་བཞེངས།",
    "དེ་ནས་ཐང་བོད་དམག་འཁྲུག་གི་རུ་འདྲེན་པ་གཙོ་བོ།",
    "བོད་དམག་ཆིག་སྟོང་གིས་ཐང་དམག་བརྒྱད་ཁྲི་ཕམ་དུ་བཅུག་སྟེ་རྒྱལ་ཁ་ཐོབ།",
    "དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་ལྟར་ན་འབྲི་སེ་རི་གུང་ཐུན་འབྲི་སེ་རི་གོང་ཐུན།",
    "ལྷ་གཟིགས་ཤོག་པོ་བརྟན་བཟང་།",
    "བློན་པོ་དེ་དག་གི་ལས་འགན་ནི།",
    "འཇང་གི་ཚོ་ཁག་བཅུ་གཉིས་དང་།",
    "ཡུམ་འ་ཞ་བཟའ་མོང་ག་ས་ཁྱི་སྤྱི་ལོ་༦༣༨ལོར་སྐུ་བལྟམས།",
    "ཀླུ་འཕེལ་གྱི་འབྲི་ཆུ་ཁ་ནི་དམག་འཁྲུག་གི་ཐབས་ཇུས་འགོད་ཡུལ་གཙོ་བོ་ཡིན་པ་དང་།"
  ]
}