    "རྣམ་པར་སུན་འབྱིན་པ་ཀུན་ཏུ་སྤྱོད་པའི་སྟོབས་དང་།",
    "དེ་ལ་ཞེས་པ་ལས་བཟློག་པའི་སྟོབས་ན་སྡོམ་པ་ཡང་དག་པར་བླངས་པས་མི་བྱེད་པའི་སྡོམ་པའོ།",
    "དེས་ན་ཉེས་པར་སྤྱད་བས་འབྲས་བུ་འབྱིན་མི་ནུས་པར་འགྱུར་རོ།",
    "ཚངས་པར་སྤྱོད་པ་ཡང་དག་པར་རབ་ཏུ་སྟོན་ཏོ།",
    "བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ཏེ།",
    "དགའ་བ་ཅན་སྲོག་བརྗོད་པའི་ཉེས་དམིགས་བཅུ་ནི་འདི་དག་ཡིན་པས་རག་པར་བྱ་སྟེ།",
    "རྨོངས་པ་དང་བཅས་པར་འཆི་བའི་དུས་བྱེད་པ་དང་།",
    "ཚེ་ཐུང་བར་འགྱུར་བའི་ལས་བྱས་ཤིང་བསྩགས་པས་ལུས་ཞིག་སྟེ།",
    "གལ་ཏེ་འདི་ནས་ཤི་འཕོས་ཏེ་འདིར་མ་རྣམས་དད་བསྐལ་པ་མཉམ་པར་སྐྱེས་ན་ཡང་།",
    "དགའ་བ་ཅན་༥ སྲོག་གཅོད་པའི་ཉེས་དམིགས་བཅུ་པོ་དེ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "དགའ་བ་ཅན་མ་བྱིན་པར་ལེན་པའི་ཉེས་དམིགས་བརྙན་འདི་དག་ཡིན་པ་རིག་པར་བྱ་སྟེ།",
    "དུས་མ་ཡིན་པར་འགྲོ་བར་འགྱུར་བ་དང་།",
    "ཆད་པས་བཅད་པས་གཅོད་པར་འགྱུར་ཏེ།",
    "ལོངས་སྤྱོད་ཀྱི་འཕོངས་པར་འགྱུར་བའི་ལས་བྱས་ཤིང་བསྩགས་པས་ལུས་ཞིག་སྟེ།",
    "འདི་ནི་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེས་ན་ཡང་།",
    "དགའ་ན་དམ་བྱིན་པར་ལེན་པའི་ཉེས་དམིགས་བཅུ་ནི་དེ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "དགའ་བ་ཅན་འདོད་པས་ལོག་པར་གཡེམ་པའི་ཉེས་དམིགས་བརྙན་འདི་དག་ཡིན་པར་རིག་བར་བྱའོ།",
    "དེ་ཁོན་དང་བཅས་པར་འགྱུར་བ་དང་།",
    "དེའི་བུ་དང་ཆུང་མ་མ་སྲུངས་པར་འགྱུར་བ་དང་།",
    "དེའི་ནོར་མ་སྦས་མ་བསྲུངས་པར་འགྱུར་བ་དང་།",
    "དེའིསྲེག་མ་སྦས་མ་བསྲུངས་པར་འགྱུར་བ་དང་།",
    "བློན་པོ་དག་ཡིད་ཕེབས་པར་མི་འགྱུར་བ་དང་།",
    "འགྲན་ཟླ་དང་བཅས་པར་མི་འགྱུར་བའི་ལས་བྱས་ཤིང་བསྩགས་པའི་ལུས་ཞིག་སྟེ།",
    "ཅི་སྟེ་སྐྱེས་པར་གྱུར་ན།",
    "ཆུང་མ་མ་བསྲུངས་པར་འགྱུར་ཏེ།",
    "དགའ་བོ་ཅན་འདོད་པས་ལོག་པར་གཡེམ་པའི་ཉེས་དམིགས་བཅུ་ནི་དེ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "དགའ་བ་ཅན་རྫུན་སྨྲ་བའི་ཉེས་དམིགས་བཅུ་ན་འདི་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "མི་མ་ཡིན་པས་གླགས་རྙེད་པར་འགྱུར་བ་དང་།",
    "ཡང་དག་པ་མ་ཡིན་པའི་མི་སྙན་རྩཔས་རྒྱ་ཆེར་གྲགས་པར་འགྱུར་བ་དང་།",
    "མི་སྙན་པར་བརྗོད་པ་མད་བར་འགྱུར་བའི་ལས་བྱས་ཤིང་བསྩགས་པས་ལུས་ཞིག་སྟེ།",
    "ཟླའདིར་མི་རྣམས་དང་བསྐལ་པ་མཉམ་པར་སྐྱེས་ན་ཡང་།",
    "དགའ་བཅན་བརྫུན་སྨྲ་བའི་ཉེས་དམིག་བཅུ་ནི་དེ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "བཅོས་པའི་ཆང་བག་མེད་པའི་གནས་ཀྱི་ཉེས་དམིགས་སུམ་ཅུ་རྩ་ལྔནི་འདི་དག་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ལོངས་སྤྱོད་ཐོབ་པ་མི་ཐོབ་པར་འགྱུར་བ་དང་།",
    "ལོངས་སྤྱོད་ཐོབ་པ་ཡོངས་སུ་ཟད་ཅིང་ཡོངས་སུ་གདུགས་པར་འགྱུར་བ་དང་།",
    "གསད་མི་ཐུབ་པར་འགྱུར་བ་དང་།",
    "པར་འགྱུར་བ་དང་།",
    "མར་མི་འཛིན་པར་འགྱུར་བ་དང་།",
    "ར་མི་འཛིན་པར་འགྱུར་བ་དང་།",
    "དགེ་སྦྱོང་དུ་མི་འཛིན་པར་འགྱུར་བ་དང་།",
    "བྲམ་ཟེར་མི་འཛིན་པར་འགྱུར་བ་དང་།",
    "རིགས་ཀྱི་གཙོ་བོ་ལ་བསྙེན་བཀུར་མེད་པར་འགྱུར་བ་དང་།",
    "བསླབ་པ་ཡང་དག་པར་བསླབས་པ་ལ་མ་གུས་པར་འགྱུར་བ་དང་།",
    "སྐྱེ་བོ་མང་པོ་དག་དང་མི་མཐུན་པར་འགྱུར་བ་དང་།",
