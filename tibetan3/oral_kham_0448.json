    "ཐ་སྙད་དུ་འཁྲུལ་བའི་འཁྲུལ་སའི་ཞེས་པ་ལ་ལྷུན་རྩེ་པར་མ་དང་བཀྲིས་འཁྱིལ་མཆན་རྐྱང་པར་མར་འཁྲུལ་བའི་ཞེས་པ་ཆད་འདུགཅན་དོན་ནི།",
    "སྐྱེ་བ་འདོད་ཀྱང་རང་མཚན་གྱིས་སྐྱེ་བ་མེད་པ་ནི།",
    "རང་བཞིན་གྱིས་མ་སྐྱེ་ཞེས་བརྗོད་པའི་རང་བཞིན་ཞེས་པ་དེ་མ་ཐོས་པར་མ་སྐྱེས་པར་བཟུང་འདུག་པ་རྣ་བ་མེད་པ་དང་།",
    "ཡོད་ན་རང་བཞིན་གྱིས་ཡོད་དགོས་པར་བསམ་ནས་སྐྱེས་ན་ཡང་རང་བཞིན་གྱིས་སྐྱེས་དགོས་པར་འདོད་པ་སོགས་བྱུང་།",
    "དེའི་ཡུལ་རང་བཞིན་མེད་པ་བདེན་གྲུབ་བཀག་ཚེ་ཡང་རང་བཞིན་མེད་པ་བདེན་འཛིན་གྱི་ཡུལ་བཀག་ཚུལ་ནིཁོ་བོ་ཅག་ནི་ཁྱེད་ཅག་ལྟར་མི་འདོད་ཀྱི།",
    "འདི་ལྟར་གལ་ཏེ་སྟོང་བ་ཉིད་ཡིན་པ་དེའི་གཉེན་པོ་སྟོང་བ་ཡང་རང་བཞིན་གྱིས་ཡོད་ཅུང་ཟད་ཅིག་ཡོད་ན།",
    "རང་རང་བཞིན་མེད་པར་བརྗོད་པའི་ཚིག་ཀྱང་རང་བཞིན་མེད་པསབཞིན་བཟློག་མི་ནུས་པར་འགྱུར་ཞེས་བརྩད་རྗེས།",
    "ཟློག་བྱེད་ཀྱི་ཚིག་ཀྱང་རང་བཞིན་གྱིས་མེད།",
    "དངོས་པོ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་མེད་ན།",
    "རང་བཞིན་ལ་མ་བཅོས་པ་དགོས་པས་བྱས་པ་ཡིན་པ་དང་རང་བཞིན་ཡིན་པ་གཉིས་གཞི་གཅིག་ལ་འདུར་མི་རུང་ངོ།",
    "སྔར་མེད་གསར་དུ་བྱུང་བ་མིན་པ་ཆུའི་ཚ་བ་རྐྱེན་མེ་ལ་ལྟོས་པ་ལྟ་བུ་མ་ཡིན་པར་དང་པོ་ཉིད་ནས་གཞན་ལ་མ་ལྟོས་པར་རང་བཞིན་གྱིས་སྟོང་བ་ཚུ་རོལ་དང་ཕ་རོལ་དང་རིང་ཐུང་སོགས་གཞི་འགའ་ཞིག་ལ་ལྟོས་ནས་བཞག་པ་ལྟར་མ་ཡིན་པར་གཞི་གང་ལ་ལྟོས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་བ་ལས་མ་འདས་པས།",
    "སྤྱིར་དེ་དེའི་ངོར་དོན་དམ་བདེན་པ་བཏགས་པ་བ་མ་ཡིན་པར་གསུངས་ཀྱང་འདིས་ལམ་རིམ་ཆེ་བ་ལ་ཡང་ཞིབ་ཆ་འདོན་དགོས་པར་འདུག་གོ།",
    "དེ་ལྟ་ནའང་རང་ལས་ཐ་དད་དུ་མ་གྲུབ་བཞིན་དུ་ཐ་དད་དུ་སྣང་བའི་ཕྱིར་འཁྲུལ་ཤེས་སུ་འགྱུར་ལ།",
    "འདོད་པའི་ཕྱིར་སོགས་འཕངས་པ་ཡིན་འདུག་གོ།",
    "དོན་དམ་པར་སྤྲོས་བྲལ་ཡིན་ཡང་རང་ངོས་ནས་གྲུབ་མི་དགོས་པ་ནི།",
    "ཕ་རོལ་འཇོམས་པ་དང་རང་གྲགས་འདོད་པ་ཙམ་གྱིས་བྱས་པ་མིན།",
    "དེ་ཡང་དོན་དམ་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་ངའོ་སྙམ་པ་དགག་དགོས་ཀྱང་ཐ་སྙད་པའི་ང་དང་ངའི་ལོངས་སྤྱད་བྱ་དགག་མི་རིགས་པའི་ཁྱད་པར་འབྱེད་དགོས་པ་འདི་བརྗེད་མི་རུང་གསུངས།",
    "དེའི་ནང་དུ་ཐ་སྙད་ཚད་གྲུབ་ཀྱི་སྐོར་གསལ་བོར་བྱས་འདུག་དེ་ཡང་།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་འདོད་པ་དེའི་ལུགས་ལ་འདི་ལྟར།",
    "འདོད་པ་ཡོད་ཀྱང་རང་ལ་དམ་བཅའ་དང་རང་ཕྱོགས་མེད་ལ།",
    "ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ།",
    "དངོས་སུ་ཁོ་རང་ལུགས་ཀྱིས་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་ཁས་བླངས་ཞེས་འདོད་མི་རུང་སྟེ།",
    "ཡོད་ཀྱང་རང་རྒྱུད་དུ་མི་འགྱུར་ཏེ།",
    "ཞི་འཚོ་ཡབ་སྲས་སོགས་ཀྱང་རང་མཚན་གྱིས་གྲུབ་པ་ལ་མ་འཁྲུལ་བར་བཞེད་དེ།",
    "ཕྱི་མ་ཡིན་ན་ན་རྟགས་ཀྱི་དོན་ཀུན་རྫོབ་ཏུ་ཡོད་པ་ཁྱེད་རང་ལ་མ་གྲུབ།",
    "ཀུན་རྫོབ་ཏུ་ཁྱེད་རང་ལ་མ་གྲུབ།",
    "གཞན་གྲགས་ཀྱི་སྦྱོར་བ་ལ་རྟགས་རུང་ཡང་རང་རྒྱུད་ཀྱི་སྦྱོར་བ་ལ་དེ་མི་རུང་བའི་ཚུལ་ནི།",
    "རྡོ་རྗེ་ཟེགས་མ་ལ་སོགས་པའི་རིགས་པ་རྣམས་ཀྱིས་རྒྱུ་འབྲས་དང་བདེན་བཞི་སོགས་བཀག་འདུག་པར་།",
    "དེ་ཡང་རང་རྒྱུད་འགོག་མཁན་གཙོ་བོ་སློབ་དཔོན་ཟླ་བ་གྲགས་པ་ཡིན།",
    "ཁྱད་པར་རང་བཞིན་གྱིས་དང་རང་ངོས་ནས་དང་ངོ་བོ་ཉིད་ཀྱིས་ཞེས་སོགས་ལྟ་བུ་སྦྱར་མི་དགོས་ཏེ།",
    "ཡན་ལག་ཅན་གྱི་ཤིང་རྟ་རང་བཞིན་གྱིས་མེད་ན་ཤིང་རྟའི་ཡན་ལག་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་ཁོ་ནར་འགྱུར་ཏེ།",
    "སྤྱི་ལ་དེ་ལྟར་ཁྱབ་པ་གྲུབ་པ་ན་བྱེ་བྲག་བདེན་པར་ཡོད་ནའང་བདེན་པའི་གཅིག་དང་བདེན་པའི་དུ་མ་གང་རུང་དུ་ཡོད་དགོས་པའི་ཁྱབ་པར་ཐག་ཆོད་པས་དེ་འདྲའི་ང་དེ་ཡོད་ཕྱིན་ཆད་ཕུང་བོ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་དང་ཐ་དད་གང་རུང་ལས་འོས་མི་འདུག་ཅིང་།",
    "གཞན་ཡང་བདག་ཕུང་རང་ངོས་ནས་གྲུབ་པའི་གཅིག་ཡིན་ན་ཡུལ་དུས་དང་ཆ་ཐམས་ཅད་ནས་གཅིག་ཡིན།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཏུ་གྲུབ་པ་ལ་གནོད་བྱེད་བསྟན་པ་ལ་གསུམ་ལས་མཚམས་སྦྱར་བ་ནི་དེ་ལ་ཐོག་མར་སོགས་ཏེ་སླའོ།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་ངོ་བོ་གཅིག་ཀྱང་ངོ་བོ་གཅིག་པ་གཤིས་ལུགས་སུ་གྲུབ་མི་དགོས་སོ་སྙམ་ན།",
    "གལ་ཏེ་ཕུང་བོ་དེ་བདག་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་ན་དེ་ལྟར་གཅིག་ཡིན་པ་དེའི་ཕྱིར་ཕུང་བོ་དེ་མང་པོ་ཡིན་པས་བདག་དེ་དག་ཀྱང་ཕུང་བོའི་གྲངས་བཞིན་དུ་མང་བོར་འགྱུར་རོ་ཞེས་པའོ།",
    "གལ་ཏེ་ཕུང་བོ་དེ་བདག་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་ན་ནི་ཕུང་བོ་སྐད་ཅིག་སྐད་ཅིག་ལ་སྐྱེ་འཇིག་བྱེད་པ་བཞིན་དུ་བདག་རང་བཞིན་གྱིས་གྲུབ་པ་དེ་ཡང་སྐད་ཅིག་སྔ་ཕྱིར་སྐྱེ་བ་དང་འཇིག་པ་ཅན་དུ་འགྱུར་བས་དེ་ནི་ཤིན་དུ་མི་འཐད་དེ་རང་བཞིན་གྱིས་གྲུབ་པ་ལ་སྐད་ཅིག་སྔ་ཕྱིར་སྐྱེ་འཇིག་བྱེད་པ་ན་སྐད་ཅིག་སྔ་ཕྱི་མ་འབྲེལ་བས་རྟག་ཆད་དུ་འགྱུར་བ་དང་སྐྱེ་བ་དྲན་པ་སོགས་མི་འཐད་པས་སོ།",
    "ང་ལས་ནུས་དུས་ཀྱི་ངར་གྱུར་པ་མེད་པའི་ཕྱིར་དེ་ལྟར་དྲན་པ་མིན་ཡང་ལམ་རིམ་ཆུང་བ་ལས་སྐྱེ་བ་དྲན་པའི་དུས་སུ་ཡུལ་དང་དུས་དང་རང་བཞིན་བྱེ་བྲག་པས་ཁྱད་པར་དུ་མ་བྱས་པར་སྤྱིར་ང་ཞེས་དྲན་པའི་དྲན་ཚུལ་ཁྱད་པར་བ་ལེགས་པར་ཤེས་དགོས་སོ་ཞེས་དང་རྩ་ཤེའི་ཊཱིཀ་ཆེན་ལས་ཚེ་འདིའི་ལྷ་བྱིན་གྱིས་གང་ལ་དམིགས་ནས་ངའོ་སྙམ་པ་སྐྱེ་བའི་དམིགས་པར་གྱུར་པའི་བདག་ནི་ཚེ་རབས་སྔ་མ་རྣམས་སུ་ཡོད་པས་དེ་ལྟར་དྲན་པ་མི་འགལ་ལ་ཞེས་སོགས་ཤིན་ཏུ་རྒྱས་པར་གསུངས་པ་ལྟར་ཡུལ་དུས་སོགས་བྱེ་བྲག་པའི་ང་ཚེ་རབས་སྔ་མ་རྣམས་སུ་འདི་དང་འདིར་སྐྱེས་ཁྱད་པར་དུ་མ་བྱས་པར།",
    "འདུག་སྙམ་དུ་དྲན་པ་དང་།",
    "༧༣༦ བདག་ཕུང་བོ་དང་རང་བཞིན་ད་ནི་དཀྱུས་མའི་སོགས་ཏེ།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་ཐ་དད་པར་འདོད་པ།",
    "དེ་བཞིན་དུ་བདག་ཕུང་བོ་དང་རང་བཞིན་ཐ་དད་པའི་ཕྱོགས་ལ་ཡང་དེ་ལྟར་ཐ་དད་དུ་ཡོད་ན་དཔེ་གཟུགས་དང་སེམས་བཞིན་དུ་ཕན་ཚུན་དོན་གཞན་དུ་སོ་སོར་བློ་གནོད་མེད་ཀྱིས་མཐོང་དགོས་པ་ལས།",
    "ཐ་སྙད་ཤེས་པས་རང་བཞིན་གྱིས་གྲུབ་པར་གནོད་ཀྱང་རང་བཞིན་མེད་པ་དེས་འགྲུབ་པའི་སྐྱོན་མེད་པ་ནི་དེ་ལྟ་ནའང་སོགས་ཏེ་དོན་སླའོ།",
    "ཚུལ་དེ་ལས་གཞན་དུ་ཡོད་ཚུལ་མི་འདུག་སྙམ་དུ་བློས་རྦད་དེ་ཐག་བཅད།",
    "དེ་ལྟར་མེད་པའི་ཚུལ་དེ་བློ་ངོར་འཆར་བ་ན་གང་འཆར་བ་དེ་ཉིད་བློས་ཚིར་གྱིས་བཟུང་ནས་དེ་ལྟར་སྣང་ཚུལ་ལྟར་གྱི་ང་དེ་མི་འདུག་སྙམ་དུ་ངེས་ཤེས་དྲངས།",
    "ཡང་རང་སྡོད་པའི་ཁང་བར་མི་བརྟེན་པ་ལྟར་རྟེན་བརྟེན་པའི་ཚུལ་དུ་ཡང་མེད།",
    "རང་བཞིན་གྱིས་སྟོང་ཡང་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་བའི་སྒྱུ་མ་བྱས་པ་ལྟ་བུར་འགྱུར་བ་ཡིན་གྱི།",
    "གང་ཟག་སུ་ཡང་རང་བཞིན་གྱིས་འཆི་བ་མེད་ལ།",
    "གཟུགས་བརྙན་ལ་སོགས་ཀྱི་དཔེ་དེ་དག་ཀྱང་རང་ངོས་ནས་གྲུབ་པའི་རང་བཞིན་མེད་པར་རྟགས་ལ་བརྟེན་ནས་རྟོགས་དགོས་པར་འགྱུར་བ་ཡིན་ན།",
    "གཉིས་རང་བཞིན་གཅིག་དང་རང་བཞིན་ཐ་དད་གཉིས་སུ་ཁ་ཚོན་ཆོད་པ་ཡིན་ནོ།",
    "མཉམ་བཞག་དེ་ལས་ལངས་པའི་རྗེས་ཐོབ་ཏུ་དགག་བྱ་བཀག་པའི་ཤུལ་དུ་ལྷག་མར་ལུས་པ་གང་འདུག་བརྟགས་པ་ན་ངའི་མིང་ཙམ་ཞིག་ལྷག་པར་སྣང་ལ།",
    "དཔྱད་པ་མང་ནས་འཇོག་དུས་གནས་ཆ་ཆུང་ན་འཇོག་སྒོམ་དང་།",
    "ཐམས་ཅད་བེ་རོ་ཙ་ན་སོགས།",
    "དེ་དང་རང་དོན་དུ་ཉེར་ཞི་དོན་གཉེར་དུ་མཚུངས་པའི་ཕྱིར།",
    "འོག་མིན་འགྲོ་ཡིན་ཏེ།",
    "ཉན་རང་རང་རྒྱུད་པའི་ལམ་རྣམས་སྤང་བྱ་མི་མཐུན་པའི་ཕྱོགས་དང་།",
    "སློབ་དཔོན་ཡང་རང་ཉིད་དམ་པ་རྣམས་དང་སྤྱོད་པ་མཐུན་པར་བསྟན་པའི་ཕྱིར་དང་།",
    "བག་ཆགས་བཞག་ཅིང་བརྗེད་བྱང་དུ་བྱ་བ་དང་རང་ལས་བློ་གྲོས་དམན་པ་དག་ལ་རྟོགས་པ་བསྐྱེད་པའི་སྒོ་ནས་རང་གཞན་ལ་ཕན་འདགས་པའི་དོན་དུའོ།",
    "སྔ་རབས་པ་དག་དུས་མཉམ་པའི་མཁྱེན་གསུམ་དང་།",
    "འདི་ལ་སྔ་རབས་པ་དག་ཉན་རང་རང་རྒྱུད་པའི་གཞི་ཤེས་ཡིན་ལ།",
    "དེ་དག་མེད་པས་ན་དེ་མ་ཐག་པའི་རྐྱེན་མེད་པས་ཡིད་ཤེས་ཀྱང་རང་བཞིན་མེད་དོ།",
    "དེ་དང་རང་རྒྱལ་རྣམས་ཞི་བ་དོན་གཉེར་དུ་མཚུངས་པའི་ཕྱིར་རོ།",
    "ཉན་རང་རང་རྒྱུད་པའི་ལམ་རྣམས་ནི་ཤེར་ཕྱིན་གྱི་གཟུགས་བརྙན་ཡིན་པས་བཏགས་པ་ཙམ་དུའང་མི་རུང་སྟེ།",
    "འོག་མིན་འགྲོ་ནས་ལུས་མངོན་བྱེད་བར་གྱིས་དབྱེ་གཞི་དང་།",
    "འོག་མིན་འགྲོ་འཕགས་གསུམ་གྱི་དབྱེ་གཞི་ཡིན་པས་དེ་དག་དུ་འདུ་བར་དགོངས་ནས་གྲངས་འཛིན་དུ་མ་བགྲང་།",
    "སྲིད་རྩེའི་མཐར་ཐུག་པར་འགྲོ་བ་གཉིས་ཀྱི་དང་པོ་འོག་མིན་འགྲོ་ནི།",
    "ཉན་ཐོས་ཡོད་ཀྱང་རང་ལས་དམན་པའི་ཕྱིར་འགྲན་ཟླ་དང་བཅས་པར་མི་འགྱུར་རོ།",
    "དེ་དག་ཀྱང་རང་བཞིན་གྱིས་བདེན་པས་སྟོང་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་ན།",
    "དེ་དག་དུས་མཉམ་པའི་དཔེར་ཇི་ལྟར་རུང་ཞེ་ན།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆགས་པ་མ་མཆིས་པ་དེའི་ཕྱིར་བྱང་ཆེན་ཞེས་བགྱི་བའི་གྲངས་སུ་མཆིའོ་ཞེས་སོ།",
    "སང་ཉིན་ལྷ་འདྲེས་བཤིག་འདུག་གོ།",
    "རྒྱལ་པོ་ཆེན་པོ་མཚོ་བསུབས་པའི་སྟེང་དུ་ལྷ་ཁང་བརྩིག་མི་བཏུབ་པར་འདུག་པ།",
    "རྩ་ཕྱག་བཅུ་པོ་ལས་མི་འདུག།",
    "ངོ་མཚར་ཆེ་ལ་མགྱོགས་པ་ཞིག་བཞེངས་ཚར་འདུག་ནའང་།",
    "རང་བྱོན་དུ་གདའོ་ཞུས་པ་དང་།",
    "མཐུན་རྐྱེན་སྒྲུབ་པའི་གསོལ་བ་འདེབས་ཀྱིན་ཡོད་ཙ་ན།",
    "རྒྱལ་པོ་མེད་པར་ཤིང་བཟོ་བ་ཆ་ལུགས་དབྱེར་མི་ཕྱེད་པའི་སྟེའུ་ཐོགས་པ་བརྒྱ་རྩ་བརྒྱད་དུ་འདུག་སྟེ།",
    "སེང་གེ་བརྒྱ་རྩ་བརྒྱད་ཀྱི་སྣའི་བཟོ་བྱེད་ཀྱིན་འདུག་པས།",
    "ལྷ་སའི་འོག་ཁང་ལ་ཉིན་ཞག་གཉིས་ལ་ཟིན་པ་བྱས་ཟེར་བར་འདུག་སྟེ།"
  ]
