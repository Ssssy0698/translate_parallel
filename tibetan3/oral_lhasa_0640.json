    "དེ་རྣམས་བསྐྱབ་སཨསསསམས་ས་༣པའི་དོན་དུ་ཞེས་བྱ་བ་ཕན་པར་མཛད་ཅིང་བསྐྱང་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྟག་ཏུ་བརྩོན་ཞེས་བྱ་བ་ནི་དུས་རྟག་པར་རྒྱུན་དུ་བརྩོན་ཞིང་འབད་པར་མཛད་པ་སྟེ།",
    "དེ་ཁྱད་པར་གྱི་དཀའ་ཐུབ་ལ་སྤྱད་པས་མསཆས་ཚངས་པ་ཆེན་པོ་ལས་འཇིག་རྟེན་གསུམ་གྱི་བདག་པོར་གྱུར་པའི་མཆོག་བླངས་ནས་དེས་བསམས་པ།",
    "དེ་བས་ན་དེ་དང་པོར་བརླག་པར་བྱ་སྟེ།",
    "དེ་བརླག་ནས་གེགས་ཁ་མེད་པར་ས་གསུམ་རྣམ་པར་གནོན་པར་བྱའོ་སྙམ་ནས།",
    "ཁྱབ་འཇུག་བསད་པའི་ཕྱིར་བརྩོན་པར་བྱེད་པ་དང་།",
    "བསྙེངས་བགྱིད་གང་ཞེས་བྱ་བ་ནི་གང་ལས་བསྙེངས་ཤིང་འཇིགས་པར་བྱེད་པའོ།",
    "ལེ་ལན་གྱིས་ནི་གཏུགས་པར་གྱུར།",
    "གལ་ཏེ་མ་འགགས་པ་ལ་སོགས་པས་དྲང་སྲོང་གནས་ངན་ལ་མ་མམས་མ་ཁག་ན་གསལ་ལགས་ནས་གསས་མས་མས་སངས་པས་ས་༥ པས་སངས་མག་པ་ལ་ཀ་ག་ཆགས་། བསྙེན་བཀུར་མ་ཡིན་པ་མི་བྱེད་དེ།",
    "དེ་རྣམས་འདི་ལྟར་བརླག་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་རྣམས་བརླག་ཅིང་གཏུགས་པར་གྱུར་པའོ།",
    "རྣམ་པར་བསྒྲལ་ཅེས་བྱ་བ་ནི་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་མཛད་དོ།",
    "འདིར་ཡབ་དང་སྲས་མཇལ་བར་བྲེ་བོ་ཟས་ལ་སོགས་པས་ཁྱད་པར་རྟོགས་དྲུག་ཅུ་ཐམ་པ་པར་མཛད་པ་དང་།",
    "རྣམ་བསམས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་དཔྱད་པའོ།",
    "དད་པ་དང་ལྡན་ཞིང་ཡིད་དྭང་བ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "དེ་ལྟརཐམས་ཅད་མཁྱེན་མིན་པའི།",
    "ཐམས་ཅད་མཁྱེན་མིན་པའི་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མ་ཡིན་པ་སྟེ།",
    "དེས་བྱས་པའི་གྲུབ་པའི་མཐའ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པའི་མཐའ་ཞེས་བྱའོ།",
    "དེའི་སྐྱོན་ཡིན་པས་ན་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིནཔའི་གྲུབ་པའི་མཐའི་སྐྱོན་ནོ།",
    "སྟོན་པ་ཞེས་བྱ་བ་ནི་ལྷ་དང་མི་རྣམས་ལ་སྟོན་པར་མཛད་པའོ།",
    "ཅི་ཕྱིར་སེམས་པར་བྱེད་ཅེ་ན།",
    "རང་ཉིད་སྐྱོན་བྱེད་པ་ནི་དེ་ལྟ་ནའང་སེམས་པར་མི་བྱེད་ཅིང་རྟོགས་པར་མི་བྱེད་དོ།",
    "དེ་ཉེས་པ་དང་བཅས་པར་གྱུར་པ་མ་ཡིན་གྱི།",
    "ཐོབ་བགྱིད་པ་ཞེས་བྱ་བ་ནི་རྙེད་པར་བྱེད་པའོ།",
    "ཡང་དག་པ་ཞེས་བྱ་བ་ནི་ངེས་པར་མངའ་བར་འགྱུར་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐོབ་པར་གྱུར་ཅིག་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ་༧༥།",
    "མགོན་པོ་ཁྱད་པར་འཕགས་བསྟོད་པ།",
    "ཁྱད་པར་དུ་འཕགས་པའི་བསྟོད་པ་སློབ་དཔོན་མཐོ་བཙུན་གྲུབ་རྗེས་མཛད་པ་རྫོགས་སོ།",
    "ཟླ་བའི་འོད་ཟེར་ཟིལ་གནོན་ལེགས་པར་སྐྱེས་གྱུར་པ།",
    "ཁྱད་པར་དུ་འཕགས་པ་ཞེས་བྱ་བ་དེ་བཞིན་གཤེགས་པའི་བསྟོད་པ།",
    "རྣམ་པར་ཐར་ལ་བསྐྲུན་བས་མུ་སྟེགས་བྱེད་ཀྱི་མུན་པ་འཇོམས་བྱེད་པའི།",
    "དེ་ཡི་འགྲེལ་པ་དེ་འདིར་རྫོགས་པར་བྱས།",
    "མི་ཉམས་འཕེལ་ཕྱིར་འཕྲུལ་པར་གསར་སྐྲུན་གྱིས།",
    "རང་བཞིན་རྫོགས་པ་ཆེན་པོའི་ལམ་གྱི་ཆ་ལག་སྡོམ་པ་གསུམ་རྣམ་པར་ངེས་པ་ཞེས་བྱ་བའི་བསྟན་བཅོས་བཞུགས་སོ།",
    "མཁྱེན་བརྩེའི་འོད་དཀར་ངེས་གསང་གྲུ་ཆར་འབེབས།",
    "གསང་ཆེན་སྨིན་གྲོལ་ལམ་མཆོག་མ་བསྟེན་པར།",
    "ཕུར་པའི་རྒྱུད་དང་དུས་འཁོར་ལས་གསུངས་ཤིང་།",
    "སྟོན་པར་ཁས་བླངས་ཚུར་ཤོག་གསོལ་བཞི་དང་།",
    "རྒྱལ་པོས་མ་གནང་ལ་སོགས་གནས་པ་དང་།",
    "བྱ་རོག་སྒྲོད་མི་ནུས་སོགས་ཁྱད་པར་དང་།",
    "གསོད་རྐུ་རྫུན་སྨྲ་འདོད་པས་ལོག་པར་གཡེམ།",
    "ལྷག་རྣམས་ཉམས་སུ་ལེན་པར་དཔུང་བཟང་བཤད།",
    "ཞུམ་པ་སྤོང་ཕྱིར་རགས་པ་བཅུར་དྲིལ་གསུངས།",
    "བྱིན་ལེན་རྩྭ་སྔོན་ཁྲོད་དུ་མི་གཙང་འདོར།",
    "གནང་བས་ཉེས་མེད་བཅུ་གསུམ་མ་གཏོགས་པ།"
  ]
}