    "རོ་མཉམ་པ་ལས་ནང་གི་རེག་བྱའི་ལྟ་བ་ཕྱིའི་དངོས་པོ་ལས་རྙེད་པ་མེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་དུས་སུ་གང་གི་མིག་ལ་སོགས་པ་སྟོང་པ་ཉིད་དུ་མཐོང་ཞེས་ནང་སྟོང་པ་ཉིད་འདི་ལྟར་ཚོར་ན་དེའི་ཚེ་འདོད་པའི་དགའ་བའི་མཚན་ཉིད་མོས་པས་སྤྱོད་པ་ཐོབ་པར་འགྱུར།",
    "གང་ཞིག་ཛཱ་ལན་དྷ་ར་ལ་སོགས་པ་དེ་ནི་འཇིག་རྟེན་ཀྱི་ལམ་གང་ཞིག་ནང་གི་དེ་ནི་ཁྱད་པར་ཅན་གང་ཕྱི་དང་ནང་དེ་དག་དང་བྲལ་བ་དེ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་ལ་བརྟེན་པ་དེ་ནི་གནས་ཀྱི་བསྟན་པའོ།",
    "དེའི་དུས་སུ་ཕྱི་ནང་བདེ་བ་རྣམས་ལ་ཕྱི་ནང་བདེ་བས་སྟོང་པ་ཞེས་ཕྱི་ནང་སྟོང་པ་ཉིད་གང་གི་ཚེ་ཤེས་པ་དེའི་ཚེ་འགྲོ་བའི་དགའ་བའི་མཚན་ཉིད་དྲི་མ་མེད་པ་གང་ཞིག་བདེ་བ་ངལ་སོ་བའི་གནས་དེ་ནི་ཉེ་བའི་ཞིང་ངོ།",
    "དེ་ལ་ནུ་མ་རེག་པ་ལས་སྐོམ་པ།",
    "དེའི་དུས་སུ་གང་དོན་དམ་པའི་བདེ་བ་མྱ་ངན་ལས་འདས་པའི་མཚན་ཉིད་དེ་ནི་མྱ་ངན་ལས་འདས་པའི་མཚན་ཉིད་ཀྱི་སྟོང་པ་ཞེས་དོན་དམ་པ་སྟོང་པ་ཉིད་གང་གི་ཚེ་དེ་ལྟར་ཤེས་པ་དེའི་ཚེ་མདུང་གི་དགའ་བའི་མཚན་ཉིད་སྦྱང་དཀའ་བའོ།",
    "དེའི་དུས་སུ་ཆགས་པ་དང་བྲལ་བ་དེ་དག་རྟག་པ་དང་ཆད་པ་བཅོམ་པ་དེ་དག་གཉིས་ཀྱིས་སྟོང་པ་ཞེས་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་གང་གི་ཚེ་དེ་ལྟར་ཤེས་པ་དེའི་ཚེ་འབར་བའི་དགའ་བའི་མཚན་ཉིད་མི་གཡོ་བའོ།",
    "བདེ་བ་ལ་རླབས་འུཔ་ཐོབ་པ་ཞེས་གང་ཞིག་དྲན་པའི་རྣམ་པར་ཤེས་པ་དེ་ནི་ཉེ་བའི་དུར་ཁྲོད་དེ་ལ་སྐེའི་སྒྲ་ལས་བ་སྤུ་ལངས་པ་དེའི་དུས་སུ་བདེ་བ་ལ་སྤྱོད་པས་ཐོག་མ་དང་ཐ་མ་དབུས་ཀྱི་དངོས་པོ་མེད་པ་དེ་ལ་ཡང་འགྲོ་བ་མེད་འོང་བ་མེད་པ་ཐོག་མ་དང་ཐ་མ་དབུས་ཀྱིས་སྟོང་པའི་ཕྱིར་ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་གང་གི་ཚེ་དེ་ལྟར་ཤེས་པ་དེའི་ཚེ་ཐིག་ལེའི་དགའ་བའི་མཚན་ཉིད་ལེགས་པའི་བློ་གྲོས།",
    "ཡང་དག་པའི་བདེ་བས་རྙེད་པ་ལ་གང་ཞིག་རང་གི་ངོ་བོའི་དཔྱོད་པ་དེ་ནི་ཉེ་བའི་རིང་པོའོ།",
    "བདེ་བ་གལ་སྐྱེས་པ་ཆད་པ་གང་དུ་སྐྱེད་པ་དེ་ནི་ལམ་མོསྐེ།",
    "དེ་དག་མཉམ་པར་སྤྱོར་བའི་གང་མཆོག་གི་དགའ་བ་ལ་དེ་ནི་གནས་ལ་སོགས་པའི་དོན་ཤེས་ནས།",
    "ཅེས་བྱ་བ་ནི་བདག་གི་དགོངས་པའོ།",
    "བདེ་བའི་སྒྲ་ནི་རྟག་ཏུ་མ་ནིང་གི་རྟགས།",
    "ཡང་ན་ནང་གི་རྟགས།",
    "ནང་གི་རྟགས་ལས་རྣལ་འབྱོར་པས་ཕྱིའི་ཡུལ་ལ་སོགས་པས་མ་འཁྲུལ་པ་ཉམས་སུ་མྱོང་བ་ལ་ཐིམ་པ།",
    "ལྷན་ཅིག་སྐྱེས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཕག་མོ་དེ་དང་ལྷན་ཅིག་བཅོམ་ལྡན་འདས་སྲུབ་དང་བསྲུབ་ཐབས་ཆེན་པོའི་གནས་སུ་བཞུགས་ཤིང་ཐབས་དང་བཅས་པའི་ནམ་མཁའ་ལ་སྤྱོད་པ་ལ་སོགས་པ་གྲུབ་རྫོགས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐ་མ་ནི་གཏི་མུག་གི་མཚན་ཉིད་རླག་པ་ཅན།",
    "ཇི་ལྟར་རང་གིས་རྫོགས་པ་ཞེས་གཞན་གྱི་ཡང་དེ་བཞིན་དོན་བྱེད་དོ།",
    "ཡང་ཐ་མ་ནི་མངལ་གྱི་དབུས་སུ་འོག་གི་ཆ་ལ་ཁུ་བ་འབབ་པ།",
    "མཆོག་ནི་སྟེང་གི་ཆ་ལ་རང་བྱུང་འབར་མེ་མ།",
    "རེག་བྱའི་རྩ་ནི་སྐྱེ་བའོ།",
    "ཡེ་ཤེས་གཉིས་ཀྱི་སྣང་བ་ཆེན་པོའི་དམ་ཚིག་སྤྱོད་པ་ལས་རེག་བྱ་བྱེད།",
    "ནང་གི་སྒྲ་ནི་བདེ་བ་ཆེན་པོའི་འཁོར་ལོ།",
    "འོན་ཀྱང་རང་གི་སྐྱོན་གྱིས་མི་ཤེས་སོ།",
    "འོན་ཀྱང་རང་གི་སྐྱོན་དང་ཡོན་ཏན་ལས་འབྲས་བུ་སྐྱེའོ།",
    "མཐོང་བ་རེག་པ་གཉིས་དང་ནི།",
    "དེ་ལ་མཐོང་བས་རེག་པས་ཐོས་པ་དྲན་པས་ཉམས་སུ་མྱོང་བའི་སའི་འབྲས་བུ་ཇོབ་པར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རེག་པས་མཆོག་གི་དགའ་བ།",
    "དམ་ཚིག་ཅེས་བྱ་བ་ནི་ལྷ་མོའི་བདག་ཉིད་ཀྱི་རྩ།",
    "ལྷ་མོའི་བདག་ཉིད་རྩ་ཚུལ་གྱིས་འབིགས་ནས་དཀྱིལ་འཁོར་དུ་འཇུག་པ།",
    "བརྩོན་འགྲུས་ཆུང་ན་ཡང་ཉམས་པ་ལ་སོགས་པའི་དོན་སྤྱོད་པས་ཕྲ་མོའི་དངོས་གྲུབ་བརྒྱད་འདིར་ཐེ་ཚོམ་མེད་པར་རྙེད་དོ།",
    "ཁྲག་ཅེས་བྱ་བ་ནི་དེ་རང་རྣམ་པར་སྨིན་པ་ལས་མཆོག་གི་དགའི་ཟུ།",
    "དམར་གྱི་སྒྲ་ནི་ཕག་མོ།",
    "མྱོང་བ་ཙམ་གྱིས་ནི་རང་གི་ངོ་བོ་རྙེད་པར་འགྱུར་ཞེས་དགོངས་སོ།",
    "དེ་དག་གིས་ཁ་ལ་ཁྱམྱོང་གཟུང་བླང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡང་ན་འགྲོ་བ་གནས་པ་གཉིད་ལོག་པ་སད་པ་ཟས་ཟོས་པ་མ་ཟོས་པ་ལེགས་དགྱེས་ལ་སོགས་ལོངས་སྤྱོད་ལ་རྒྱུན་མ་ཆད་པ་རང་གི་ངོ་བོ་ཡོངས་སུ་ཤེས་པ་རང་གིས་ཉམས་སུ་སྩོང་བའི་དགའ་བ་མཛེས་པའི་རྣམ་པས་རྣལ་འབྱོར་པ་ཉིད་ཐོབ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་ཡང་ཚེས་མར་ངོའི་བརྒྱད་པ་ལ་གྲུབ་པར་བྱས་པ་མར་ངོའི་སྒྲ་ནི་མཚན་མོ།",
    "སོགས་པའི་སྒྲ་ནི་འདབ་མ་གསུམ་པ་དེ་རུ་གྲུབ་པར་བྱས་པ་དེའི་ནང་གི་སྟེ་བའི་དབུས་སུ་རང་གིས་ལེན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡང་ན་དངོས་པོ་དང་དངོས་པོ་མེད་པར་འཛིན་པ་སྤངས་པའི་ཡེ་ཤེས་ཀྱི་ལྟ་བས་མཚན་ཉིད་དང་བྲལ་བའི་རང་གི་ངོ་བོས་ཉམས་སུ་པྱོང་།",
