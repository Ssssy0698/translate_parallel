    "དེ་ཡང་མཁའ་འགྲོ་རྣམས་ཀྱི་རང་བཞིན་གྱི་ཡི་གེ་རེ་རེ་ལས་བསྐྱེད་པར་འགྱུར་རོ།",
    "རོལ་མོ་ཞེས་བྱ་བ་ནི་ཁམས་སྣ་ཚོགས་ཀྱིས་ཀུན་དུ་འགྲོ་བའོ།",
    "དང་གི་ཡི་གེས་གཞལ་མེད་ཁང་ན་ལོངས་སྤྱོད་པའི་ལྷ་དང་འཇིག་རྟེན་སྐྱོང་བ་རྣམས་སོ།",
    "རོལ་མོ་ཞེས་བྱ་བ་ནི་རོལ་མོ་བྱེད་པ་པོའོ།",
    "དེ་ནི་ཚངས་པ་རྡོ་རྗེ་འཆང་གི་སྤྲུལ་པའི་སྐུ་ལས་བྱུང་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཀྱང་མཐའ་ཡས་ཞེས་བྱ་བ་ནི་མཐའ་མེད་པའི་འཇིག་རྟེན་གྱི་ཁམས་སྤྲོ་བའི་དུས་རྣམས་སུ་རེ་རེ་ལ་ཡང་སྟོང་ཕྲག་ཏུ་འགྱུར་རོ་ཞེས་བྱ་བར་དགོངས་ཏེ།",
    "ཨཏྤའི་ཚིག་གིས་ཕག་གདོང་མ།",
    "ཡི་གེ་བཅུ་དྲུག་རྣམས་ཀྱིས་དེའི་རྣམ་པའི་དེ་ཁོ་ན་ཉིད་ཅེས་བྱ་བས་ཞག་གི་དབྱེ་བས་སམ་དཀར་པོ་དང་ནག་པོའི་ཕྱོགས་རྣམས་ཀྱིས་ཏེ་ཀྱང་གི་ཡི་གེས་ཤེས་པར་བྱ་སྟེ།",
    "འདི་རྣམས་ཐམས་ཅད་ཉིན་མོ་སྟེ།",
    "རིམ་པ་ཇི་ལྟར་མཚན་མོ་ཡང་།་།",
    "རྩེན་པའི་དུས་ཀྱིས་གང་གི་སེམས།",
    "དགོད་གྱུར་མི་མོ་ལྟ་བ་ཡི།",
    "མེ་ཡིག་གིས་ནི་རྟག་བདག་ཉིད།་།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་ཕྱེད་དང་བཅས་པའི་ཚིགས་སུ་བཅད་པས་བཅོམ་ལྡན་འདས་མ་རྡོ་རྗེ་ཕག་མོས་བཅོམ་ལྡན་འདས་ལ་ཞུས་པའོ།",
    "དགྱེས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་བཅོམ་ལྡན་འདས་ཀྱི་ལན་ཏེ།",
    "གང་གི་སྤྱོད་ཡུལ་ཡིན་ཞེ་ན་གསུངས་པ།་",
    "ཁམས་དེ་རྣམས་ཐམས་ཅད་རེ་རེ་ལ་བརྒྱད་དུ་ཤེས་པའི་མཚན་ཉིད་རྣམས་ཀྱིས་དུ་མ་སྤྲོ་བ་དང་སྡུད་པ་ནི་རང་བཞིན་ཀྱིས་སོ།",
    "དེ་རྣམས་ཀྱིས་བདག་གི་བར་འཛིན་པའི་བག་ཆགས་རྣམས་ཀྱིས་བུ།",
    "ཁམས་གསུམ་པ་དུ་མ་བདག་ཉིད་ལས་བྱུང་བ་རྣམས་ཀྱིས་བདག་གི་བའི་ཁམས་དུ་མར་བྱུང་བའི་རྣམ་པར་ཤེས་པ་སྟེ་དངོས་པོ་དང་དངོས་པོ་མེད་པའི་བདག་ཉིད་ཅན་གྱི་རྫས་བྱེད་དང་བྲལ་བའོ།",
    "དེའི་ཁྱབ་བྱའི་གཟུགས་ནི་ཡང་དག་རྟོགས་ཞེས་བྱ་བ་ནི་རང་གི་བག་ཆགས་ལས་བྱུང་བའི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་གྱི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ཤར་བའོ།་།",
    "གང་གི་ཕྱིར་ན་ཀུན་སྡོབ་དང་དོན་དམ་པའི་ཡེ་ཤེས་སོ།",
    "དེ་ཁོ་ན་ཉིད་ཅེས་བྱ་བ་སྟེ་མར་མེའི་རྩེ་མོ་ལྟར་རྒྱུན་མི་འཆད་པར་རབ་ཏུ་འཇུག་པས་རབ་ཏུ་འཇུག་གོ།",
    "རྩ་ནི་བསྡུས་པ་སྟེ་ཀུན་དུ་སོན་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "འདིར་རྗེས་སུ་གནང་བ་ཡང་ཇི་ལྟར་བཅོམ་ལྡན་འདས་སྔོན་དུ་རྡོ་རྗེ་ཕག་མོས་བསྟན་པའི་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སྤྲུལ་པའི་སྒུའི་རྣམ་པར་དག་པ་ཡིན་པས་སྐྱེ་བར་འགྱུར་ཞེ་ན།",
    "ཐིག་ལེའི་རྣལ་འབྱོར་དང་ཕྲ་མོའི་རྣལ་འབྱོར་དང་དེ་བཞིན་དུ་བསྙེན་པ་དང་བསྒྲུབ་པ་དང་སྒྲུབ་པ་ཆེན་པོ་དང་ཉེ་བའི་བསྙེན་པ་ཡང་ཡོད་དོ།",
    "ཡང་གི་ཡི་གེ་ལས་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་ནི་སྒྲུབ་པ་ཆེན་པོའོ།",
    "སླར་ཡང་ཡང་གི་ཡི་གེས་ཉེ་བར་བསྙེན་པ་དང་རྣལ་འབྱོར་མ་རྣམས་སྡོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ཡང་བསྙེན་པ་གཉིས་ཞེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "ཐིག་ལེའི་རྣལ་འབྱོར་གྱིས་བརྗོད་དུ་མེད་པའི་རང་གི་རིག་པའི་ཡེ་ཤེས་ཀྱི་རྣམ་པ་ཞེས་བྱ་བའི་དོན་ཏོ།་།",
    "ཕྲ་མོའི་རྣལ་འབྱོར་རྣལ་འབྱོར་མོ།",
    "དེ་ལ་དེ་བཞིན་དུ་པདྨའི་སྣའི་རྩེ་མོ་དེ་ཉིད་དུ་ཕྲ་མོའི་སྲོག་རྣམ་པར་གཟུང་བ་ལས་བདེ་བའི་རང་བཞིན་ཉིད་དེ་དེ་ལྟར་རྣལ་འབྱོར་མའི་རྒྱུད་སུམ་ཅུ་རྩ་དྲུག་གི་ནང་དུ་གྱུར་པའི་རྒྱུད་ནི་རྣལ་འབྱོར་གྱི་རྒྱུད་དོ།",
    "དེ་ལྟར་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཅན་ཐིག་ལེའི་རྣལ་འབྱོར་དང་ཕྲ་མོའི་རྣལ་འབྱོར་དང་གཉིས་ཀའི་རྒྱུད་རྣམས་ཀྱིས་ཀྱང་སྤྲུལ་པའི་སྐུའོ།",
    "དེ་ལྟར་རེ་རེའི་དཀྱིལ་འཁོར་ལ་བརྒྱད་ཅུས་ལྷག་པའི་བརྒྱ་ཕྲག་གི་དབུགས་རྒྱུ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་དུས་བཞི་རྣམས་ཀྱི་ཞག་གཅིག་གི་ཚད་དོ།",
    "དེ་ལ་དཀྱིལ་འཁོར་སོ་སོའི་ཆ་ནི་འབུམ་ཕྲག་བདུན་དང་ཁྲི་ཕྲག་བདུན་དང་སྟོང་ཕྲག་བདུན་ལ་བརྒྱ་ཕྲག་དྲུག་གིས་ལྷག་པའོ།",
    "དེ་ཡང་བྱེ་བ་བདུན་དང་འབུམ་ཕྲག་བདུན་ཅུ་རྩ་བདུན་ལ་ཁྲི་ཕྲག་དྲུག་གིས་ལྷག་པའོ།",
    "རྡོ་རྗེའི་ནི་རྡོ་རྗེ་འཆང་གི་སྟེ་དཔལ་ཧེ་རུ་ཀའི་བདག་ཉིད་དུ་སྐྱེས་པའི་དུས་བཞིའི་དབྱེ་བའི་ངོ་བོས་དང་ཞལ་བཞི་དགའ་བ་བཞི་སྟེ་དེ་བརྒྱད་གཉིས་ཞེས་བྱ་བའོ།",
    "དུས་རེ་རེ་ལ་དགའ་བ་བཞིར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་ལག་པས་ལག་པ་ལ་རེག་པ་ཙམ་གྱིས་དགའ་བྲལ་ཏེ་ཁྱད་པར་ཅན་གྱི་འདོད་ཆགས་སྐྱེ་བ་འདི་ནི་ལག་སྤྲད་ཀྱི་རྒྱུད་དོ།",
    "ཇི་ལྟར་ཟླ་བའི་ཆ་ཤས་རྣམས་ཀྱིས་འཕེལ་བ་དང་ཟད་པའི་རྒྱུ་ཉིད་ཀྱི་དཔེ་རང་གིས་མཐོང་ངོ།",
    "དེས་ན་དང་གི་ཡི་གེ་བསྙུ་བའོ།",
    "བུད་མེད་ཀུན་ཞེས་བྱ་བ་ནི་བུད་མེད་སྒྱུ་མ་ཐམས་ཅད་དེ།",
    "བུད་མེད་ཉིད་ཐོབ་ནས་ཤེས་རབ་ཀྱི་གཟུགས་ནི་རྟག་ཏུ་ཕྱག་རྒྱ་ཞེས་བྱ་བ་བྱེསྟེ་ཕྱག་རྒྱ་ཆེན་པོ་དེའི་ཚེ་འདི་ཞེས་བྱ་བའོ།",
