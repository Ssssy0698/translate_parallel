    "གཞན་དག་གིས་དགྲ་སྟ་དང་སྡིགས་མཛུབ་ཞགས་པ་དང་ལྡན་པའོ།",
    "གཡོན་པས་དེ་བཞིན་དུ་ཁྲོ་གཉེར་ཅན་གྱི་ནུ་མ་དང་གཞན་དག་གིས་དགྲ་སྟ་དང་ཞགས་པ་འཛིན་པའོ།་།",
    "གཞན་དག་གིས་དགྲ་སྟ་དང་ཞགས་པ་འཛིན་པ་སྟེ།",
    "རྩ་བའི་ཕྱག་དག་ན་འདོད་པའི་རྒྱལ་པོའི་ཕྱག་རྒྱས་རྡོ་རྗེ་ལྕགས་ཀྱུ་དང་ཞགས་པ་བསྣམས་ཤིང་གཞན་དག་གིས་མདའ་དང་གཞུ་བསྣམས་པ།",
    "འོན་ཀྱང་ཕྱག་གཡས་པ་དག་གིས་འོད་ཟེར་དཀར་པོ་དང་ལྡན་པའི་རྡོ་རྗེ་དང་འཁོར་ལོ་བསྣམས་པ།",
    "འོན་ཀྱང་གཡས་པའི་རྩ་བའི་ཕྱག་གིས་རྡོ་རྗེ་རལ་གྲི་བསྐྱོད་ཅིང་།",
    "འོན་ཀྱང་མདུན་དུ་རྩ་བའི་ཕྱག་གིས་གཙུག་ཏོར་བསྣམས་ཤིང་།",
    "འོག་ཏུ་པདྨ་དང་ཉི་མའི་གདན་ལ་གཡོན་བརྐྱང་བས་ཐགས་བཟངས་རིས་དང་ཀླུ་རྣམས་དང་སའི་ལྷ་མོ་མནན་ནས་བཞུགས་པའོ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་དང་ལྡན་པར་བསམ་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་སེམས་དཔའི་བྱེ་སྐྱིལ་མོ་ཀྲུང་གིས་རང་གི་རིག་མ་དང་བཅས་པའོ།",
    "ལྷ་མོ་རྣམས་ནི་བདག་པོ་རྣམས་དང་ངོ།",
    "དེ་ནས་རང་གི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱི་ལྕགས་ཀྱུ་རྣམས་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རྣམས་བསྡུས་ནས་ཆུའི་རླབས་བཞིན་དུ་དཀྱིལ་འཁོར་པ་རྣམས་ལ་བཅུག་སྟེ།",
    "རྡོ་རྗེའི་ལྷའི་བུ་མོ་དང་།",
    "དེའི་ནང་དུ་བརྟན་པ་དང་གཡོ་བའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་བདག་ཉིད་ཀྱི་རང་གི་འཁོར་ལོ་བདག་པོ་དང་བཅས་པའམ།",
    "ལྷ་མོ་བཞིས་ཡོངས་སུ་བསྐོར་བའི་གསང་བ་ལྔའི་བདག་ཉིད་བལྟ་བར་བྱའོ།",
    "རང་གི་རིགས་ཀྱི་དེ་བཞིན་གཤེགས་པའི་རྣལ་འབྱོར་པས་ནི་ཙ་ན་ཀའི་འབྲས་བུའི་ཚད་ཙམ་གྱི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་དང་།",
    "རང་གི་རིགས་ཀྱི་དོན་ཡོད་པར་གྲུབ་པའི་རྣལ་འབྱོར་པས་ཨུཏྤལ་ལྗང་གུའི་འདབ་མ་ལྟ་བུའི་རལ་གྲི་ནས་ཀྱི་འབྲུའི་ཚད་ཙམ་བསམས་ལ།",
    "རང་གི་རིག་མའི་ཁ་ནས་ཡེ་ཤེས་ཀྱི་རིག་མའི་ཞལ་དུ་བཅུག་ལ།",
    "རང་གི་རྡོ་རྗེའི་ལམ་དང་ཡེ་ཤེས་སེམས་དཔའ་དེའི་ལམ་ནས་བཅུག་ལ།",
    "དེ་བཞིན་དུ་ལྷ་ཐམས་ཅད་ཀྱི་རྣལ་འབྱོར་པ་བདག་ཉིད་ཀྱིས་རང་གི་སྔགས་དགོད་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ནི་རྡོ་རྗེ་བཟླས་པའི་རིམ་པའོ།",
    "སྔགས་དེ་རྣམས་ལས་ཕྱག་མཚན་དང་ལྷ་རྣམས་རིགས་ཀྱི་བྱེ་བྲག་གི་སྒོ་ནས་རྣམ་པ་གསུམ་རིམ་གྱིས་སམ་ཅིག་ཅར་དུ་སྤྲོ་བར་བྱ་སྟེ།",
    "ཡང་ན་དཀྱིལ་འཁོར་ན་གནས་པའི་སྐུ་རྡོ་རྗེའི་རྣལ་འབྱོར་པས་སྒྱུ་མ་ལྟ་བུའི་སྐུ་ལ་སོགས་པར་ལྷག་པར་མོས་པའི་སྒོ་ནས་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་པདྨའི་ཟླ་བ་ལ་ཡི་གེ་ཨོཾ་རྣམ་པར་བཀོད་དེ།",
    "ཁྲོ་བོའི་རྣལ་འབྱོར་པས་ནི་དཔག་ཚད་བྱེ་བའི་ཚད་དང་ལྡན་པའི་དཀྱིལ་འཁོར་ན་བཞུགས་པའི་ལྷའི་འཁོར་ལོས་གསན་པར་བྱའོ་སྙམ་དུ་ལྷག་པར་མོས་པའི་སྒོ་ནས་བཟླས་པ་བྱས་ཏེ།",
    "ཀླུ་རྣམས་སྙན་པ་ཡིད་འོང་དག་གིས་བསྐུལ་བར་བསམ་བྱས་ཏེ།",
    "ཁྱོད་ནི་རྡོ་རྗེ་སགསུང་སྟེ་ཀུན་ལ་ཕན་ཞིང་ཐུགས་བརྩེ་བ།",
    "འཇིག་རྟེན་དག་གི་༦དགོས་པའི་དོན་མཛད་པ་ལ་ཤིན་ཏུ་བརྩོན།",
    "ཁྱོད་ནི་རྡོ་རྗེ་འདོད་པ་དམ་ཚིག་མཆོག་གི་ཕན་ཡོན་ཆེ།",
    "ཅེས་ལྷ་མོ་རྣམས་ཀྱིས་ཡང་དག་པར་སྐུལ་བར་བྱེད་དོ།",
    "རྣལ་འབྱོར་པ་འགའ་ཞིག་གང་གི་ཚེ་བཀྲེས་པ་དང་སྐོམ་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་བྱུང་བ་དེའི་ཚེ།",
    "ལྷའི་ང་རྒྱལ་གྱིས་བྱ་བ་མ་ལུས་པ་བསྒྲུབ་པ་ལྷུར་ལེན་ཅིང་ལྷ་རྣམས་ཀྱིས་རྗེས་སུ་གནང་བ་བྱེན་པས་གང་གི་ཚེ་ཟླ་བ་དྲུག་དང་གཉིས་དང་ཕྱེད་དང་གཉིས་དང་གཅིག་དང་ཕྱེད་དང་ཞག་བདུན་པའི་བསྒྲུབ་པ་དྲུག་གིས་ལྷ་རྣམས་མ་གྲུབ་པ་དེའི་ཚེ་ཞག་བདུན་པའི་སྒྲུབ་པ་བརྩམ་པར་བྱ་སྟེ།",
    "ཧཱུཾ་གི་ས་བོན་ལས་བྱུང་བའི་གཞལ་ཡས་ཁང་གི་ནང་ན་གནས་པའི་ཚོགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་བཞུགས་པའི་རྡོ་རྗེ་འཆང་ཆེན་པོ་ལ་སོགས་པ་གང་ཡང་རུང་བའི་རྡོ་རྗེའི་རིགས་ཀྱི་རྣལ་འབྱོར་དང་ལྡན་པས།",
    "གལ་ཏེ་དེ་ལྟ་ན་མ་གྲུབ་པ་དེའི་ཚེ་རང་གི་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀ་ན་གནས་པའི་པདྨའི་སྟེང་གི་ཟླ་བ་ལ་གནས་པའི་རྡོ་རྗེའི་ལྟེ་བའི་ཧཱུཾ་ལས་བྱུང་བ་གནོད་མཛེས་རྒྱལ་པོ་དང་མཚུངས་ཤིང་ས་བོན་གསུམ་གྱིས་བྱིན་གྱིས་བརླབས་པའི་རྡོ་རྗེ་ལྕགས་ཀྱུ་རང་གི་ཁ་ནས་ཕྱུང་༦སྟེ།",
    "ཡང་དག་པར་སོང་ནས་རྡོ་རྗེ་ལྕགས་ཀྱུ་འབར་བས་དེའི་ཐུགས་ཀར་བརྡབ་ཅིང་།",
    "རྡོ་རྗེ་ཆེན་པོ་ཆེ་གེ་མོ།",
    "ཁྱོད་ཀྱི་སྒྲུབ་པ་ལ་གནས་ཤིང་།",
    "དེའི་ཡང་སྟེང་གི་ཡི་གེ་ར་དང་།",
    "དེའི་སྟེང་གི་ཕཊ་ལས་བྱུང་བའི་གྲུ་གསུམ་འབར་བ་བསྐལ་པའི་མེ་ལྟར་འབར་བ་ཡོངས་སུ་བསམས་ཏེ།",
    "རང་གི་རྡོ་རྗེ་སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་འབར་བར་རྣམ་པར་བསམས་ནས།",
    "དེ་དག་ཐམས་ཅད་ཀྱིས་ཐལ་བ་ཉིད་དུ་བྱས་པར་བལྟས་ལ།",
    "དེའི་རྣམ་པར་ཤེས་པ་མར་མེ་ལྟ་བུ་ཡི་གེ་ཏྟྭཾ་གི་གཟུགས་ཅན་ཡོངས་སུ་གྱུར་པར་བྱས་ནས།",
    "རང་གི་ལུས་ལ་ཡང་བཅུག་སྟེ།",
    "༢དེ་ལྟ་བུའི་ཞལ་དང་ཕྱག་ལ་སོགས་པ་དང་ལྡན་ཞིང་འཁོར་ལོ་དང་བཅས་པའི་བཅོམ་ལྡན་འདས་གཟིགས་ནས།",
    "འོ་ཞེས་བྱ་བའི་སྒྲ་ནི་གང་གི་ཕྱིར་གྱི་དོན་ཆེན་ནོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་དང་བྲལ་བ་ཉིད་ཡིན་པའི་ཕྱིར་རྙོག་པ་མེད་པའོ།་",
    "གང་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་རོ།",
    "སྒུ་དང་གསུང་དང་ཐུགས་ཞེས་བྱ་བ་ནི་ནང་གི་བདག་ཉིད་ཅན་ནོ།",
    "མཆོག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ལ་གཟིགས་ཏེ་བཞུགས་སོ།",
    "ཕྲག་དོག་གི་སྤྱོད་པ་རྣམས་དེ་དག་པར་བྱེད་པའི་ཐབས་ཡང་དག་པར་བསྟན་པ་ཉིད་ཀྱི་སྒོ་ནས་འགུགས་པར་བྱེད་པའི་ཕྱིར།",
    "དེའི་རིགས་ནི་ཕྲག་དོག་གི་བདག་ཉིད་ཅན་ནོ།",
    "ཞེ་སྡང་ལ་སོགས་པའི་རིགས་ལྔ་པོ་འདི་རྣམས་ཐབས་དང་ཤེས་རབ་ཀྱིས་དག་པར་ལྷག་པར་མོས་པའི་སྒོ་ནས་བསྟེན་ན།་",
    "འདོད་ཆགས་འཛིན་པ་ནི་འོད་དཔག་ཏུ་མེད་པ་ཡིན་ཞིང་དེ་རྗེས་སུ་མཉེས་པར་བྱེད་པའི་རྡོ་རྗེ་ནི་གོས་དཀར་མོ་སྟེ།",
    "དེ་བྱ་བ་དང་འཛིན་པ་དང་ལེན་པ་ལ་སོགས་པ་རབ་ཏུ་དགའ་བ་རྗེས་སུ་མཐུན་པའི་སྤྱོར་བ་རྣམ་པ་ཐ་དད་པ་རྣམས་ཀྱིས་གང་གིས་སླུ་ཞིང་ཡང་དག་པར་སྦྱོར་བར་བྱེད་པ་ནི་དེ་རྣམ་པར་སླུ་༤བ་རྡོ་རྗེ་སྟེ་འཕགས་མ་སྒྲོལ་མ་ཡིན་ཞིང་།",
    "བུད་མེད་བདེ་མཆོག་དགའ་བ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཆོག་ཕུན་སུམ་ཚོགས་པ་ནི་བཙུན་མོའི་མཆོག་ཕུན་སུམ་ཚོགས་པ་ཞེས་བྱ་བའི་སྒྲས་བསྟན་ཏོ།"
  ]
}