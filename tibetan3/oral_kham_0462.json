    "འཁྲུལ་འཁོར་ཙོག་པུར་འདུག་སྟེ།",
    "དེ་ནས་ནམ་ཐོ་རངས་ཀྱི་ནམ་མཁའ་མཐོང་སར་འདུག་སྟེ།",
    "མི་ཐུབ་ཙ་ན་སྣ་རས་རང་གནས་སུ་ཉལ་ཞི་རུ་བཞག་སྟོང་སྒྲེགས་བྱུང་ནས་འཆི་བ་བླུས་སོ།",
    "གང་དུ་འདུག་པའི་གནས་རྣམས་སུ།",
    "གདམས་པ་དེ་རྒྱུད་ལ་ཉམས་སུ་ལེན་ཙ་ན།",
    "དངོས་དང་རྨི་ལམ་གང་ལའང་དེ་བྱུང་ཙ་ན།",
    "ཕན་ཆ་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅེས་ནན་ཏན་ཆེན་པོས་ཞུ་མཆིད་ཚིགས་བཅད་ཀྱི་ལམ་ནས་སྤེལ་བ་འདི་ལྟར།",
    "སྐབས་འདིར་ཡན་ལག་བདུན་པའི་ཚིགས་སུ་བཅས་པ་མང་ཙམ་འདུག་ཀྱང་ཡི་གེ་མང་བས་མ་བྲིས།",
    "གང་སྣང་ཐམས་ཅད་ཡིག་འབྲུ་ཤིན་ཏུ་ཆེ་བ་མང་པོས་གང་ནས་ཁྲ་ཆེམ་ཆེམ་འདུག་པ་ལ།",
    "ལྡེབ་ཕྲེང་མི་ཚང་བའང་འདུག་པས་དེ་རྣམས་སྟོང་པ་མི་བཞག་ཀ་མེད་བྱུང་བ་བཅས་ལ་བརྟེན་ནས་ད་དུང་ཞུ་བཅོས་མ་ཐུབ་པ་ཤིན་ཏུ་མང་བ་དང་།",
    "ཡིག་ནོར་ཡིན་ངེས་རྣམས་དག་བཅོས་གནང་འདུག།",
    "དོགས་གཞི་ཅན་ནམ་ཐག་མ་ཆོད་པའི་ཚིག་དོན་རྣམས་མ་དཔེ་སོར་བཞག་ལས་བཅོས་མི་འདུག།",
    "མཐུན་མི་མཐུན་ཅུང་ཟད་འདུག་པས་ཐང་ཡིག་བཞིན་བྲིས་པ་ཡིན་ནོ།",
    "ཁྱེའུ་འདི་ནི་པདྨ་འབྱུང་གནས་སུ་འདུག་གོ་བྱས་ནས་པད་སྡོང་དང་བཅས་པ་ཁྱེར་ཏེ་འོངས།",
    "དེ་ཀུན་ལ་ཡང་རྒྱུད་འདི་རྣམས་མི་གདའ།",
    "ད་དུང་འཁོར་ལོ་མ་བྱིན་པར་འདུག་པ་ཞུས་ཤིག་གསུངས།",
    "བདག་བེ་རོ་ཙ་ན་སྟོབས་ལྡན་ནག་པོའི་དལ་ལ་བབས་སོ།",
    "ལྷོ་ནུབ་ལ་ཐེག་དུས་མུ་ཁྲི་བཙད་པོ་བྱིས་པ་ལོ་བཅུ་གསུམ་ལོན་ཡང་ཟེར།",
    "ས་བརྟགས་པའི་ཕྱྭ་མཁན་དང་བཅས་པ་སྟ་གོན་མཛད་འདུག།",
    "སློབ་དཔོན་གྱིས་ཁྲོ་བོ་བཅུར་སྤྲུལ་པས་ཁོ་རང་གཉིས་སྨྱོ་སྟེ།",
    "ལན་གཅིག་དུས་ཀྱི་ཐ་མ་ལ།",
    "ད་ལྟ་ཡང་རང་ཐག་སྣའི་རྒྱབ་རི་བསྙིལ་བའི་རྗེས་ཡོད་པ་དེ་ཡིན།",
    "ཆུ་ཚན་དྲག་ཏུ་ཁོལ་བའི་ནང་ན་སྲོག་ཆགས་མང་པོ་འདུག་པ་ལ་དགོངས་པ་མཛད་པས་ཆུ་དྲོ་འཇམ་པ་ཙམ་དུ་བྱུང་།",
    "ཚོང་པ་འགའ་འདུག་པས་དེ་རྣམས་ལ་གྲོ་ཐོབ་གསུངས་པས།",
    "ཤར་རིའི་བྲག་ཕུག་དེ་ན་བུ་ཆུང་ངུ་བའི་སྐད་ད་ལྟ་ཡང་འདུག།",
    "དེ་ནས་ནུར་ཙམ་ཕྱིན་པའི་ས་ལ་མ་རྨོས་པའི་ལོ་ཐོག་རྒྱ་ཆུང་ངེ་བ་ཞིག་ལ་འབྲས་བུ་སི་ལེ་བ་འདུག་པ་ལ་སྲུས་ཡང་ཟོས།",
    "ནང་ནས་འཇིམ་སྐུ་གཅིག་ཀྱང་མེད་པར་སྟོང་སང་ངེ་འདུག་པ་ཡིད་ཆེས།",
    "ཁ་ཕྱེས་པའི་ནང་ན་ཆུ་སྐྱ་ཉོག་གེ་འདུག་པས།",
    "ཁྱུང་སྦྲུལ་བཟུང་བ་གཅིག་འདུག་པས་སློབ་དཔོན་ཡིན་བསམ་དགོངས་པ་ཀློད།",
    "བྲག་དམར་མགྲིན་བཟང་འདི་མེས་བསྲེག་ན་སྔགས་མཁན་འདི་གསོད་ཐུབ་པར་འདུག་བསམ།",
    "དེ་ལྟར་ཐམས་ཅད་འོང་ངེས་པར་འདུག་པས།",
    "ཀླུ་དེ་ཡང་རྒྱལ་པོ་ལ་ཕུད་ཞེ་གནག་པར་འདུག།",
    "ངེད་ཅག་བློན་པོ་ཀུན་རང་རང་སོ་སོར་གྱེས་ནས་འགྲོ།",
    "ཡང་རྒྱལ་བློན་འཛོམ་པ་དཔའ་བརྗིད་ཆེ་དགོངས་པར་གདའ་ན།",
    "དེར་བློན་པོ་རྣམས་ག་ལེར་ལངས་ནས་གྱོལ་གྱོལ་བྱུང་སྟེ་ཐམས་ཅད་སྐྱེངས་ནས་དཔའ་ཞུམ་མེར་འདུག།",
    "སྔར་དུས་ལྕགས་སྨྱུགས་ཀྱིས་བྲིས་པའི་ཤོག་འཁྱར་གཉིས་སྣར་ལྕེ་སྣའི་དཔེའུ་ན་འཁྱར་བ་ཞིག་ལ་འདུག།",
    "བེ་རོ་ཙ་ན་དང་།",
    "སློབ་དཔོན་རྒྱལ་པོའི་གདན་ས་ལ་རིངས་པར་འདུག།",
    "བེ་རོ་ཙ་ན་རྫོགས་པ་ཆེན་པོ་ལེན་པར་བཏང་།",
    "བན་ྡྷེ་བེ་རོ་ཙ་ན་རབ་ཏུ་བསད།",
    "ད་ལྟ་ལོང་པོ་ན་འདུག་པ་ལ་པོ་ཏི་བདུན་བཞུགས་ཟེར་རོ།",
    "གང་རུང་གཅིག་བྱེད་པར་འདུག་པས་རྟོག་ཅིག་བྱས་པ་དང་།",
    "ངས་དེ་རིང་ཤར་སྒོར་ཕྱིན་པས་མི་ཀུན་མཐུན་པར་རྗེས་འབངས་བསད་ན་ལང་བ་མི་ཡོང་ཟེར་གྱིན་འདུག་བྱས་པས་རྗེ་འདར།",
    "ངས་ཞལ་ལྕེ་མི་ཆོད་པར་འདུག་གོ།",
    "ཕྱོགས་ཀྱི་དགྲ་ཐམས་ཅད་ཐུལ་བར་འདུག་ཟེར།",
    "འཛམ་བུ་གླིང་ཐམས་ཅད་བོད་ཀྱི་རྒྱལ་པོས་མངའ་འོག་ཏུ་བསྡུས་ནས་གེ་སར་གྱི་ཡུལ་འཇོམས་སུ་འོང་བར་འདུག་ཅེས་ཐོས་ནས།",
    "ཐང་ཡིག་ལས་མཁར་ཆེན་བཟའ་མཚོ་རྒྱལ་འདིའི་དུས་སུ་ཕུལ་ཟེར་བ་འདུག་ཀྱང་ཐོག་མ་ནས་ཕུལ་བར་མངོན།",
    "སྐབས་འདིར་རྒྱལ་པོ་རྗེ་འབངས་ལ་སྒྲུབ་པ་བཀའ་བརྒྱད་གནང་ཟེར་བ་ཡང་འདུག།",
    "གདུལ་བྱ་ལ་སོགས་བྱེ་བ་ཕྲག་བརྒྱ་སྔར་ལྟར་འདུག།",
    "སྤྲུལ་པ་གདུལ་བྱ་བྱེ་བ་ཕྲག་བརྒྱ་ལ་སོགས་པ་སྔ་མ་ལྟར་འདུག།",
    "སྤྲུལ་པ་དང་གདུལ་བྱ་བྱེ་བ་ཕྲག་བརྒྱ་གོང་ལྟར་འདུག།",
    "དེ་ལས་བརྒྱལ་བ་སངས་ཙ་ན་བྲག་དཀར་ན་འགྱེལ་ནས་འདུག།",
    "ཐང་ཡིག་ཚིགས་བཅད་ལྷུག་ཕལ་ཆེར་ལ་འདུག་ཀྱང་།",
    "དེ་ལྟར་ན་དུས་རྟགས་འཆོལ་བར་འདུག།",
    "སློབ་དཔོན་པདྨའི་ཤོག་དྲིལ་ཁོ་ན་འདུག་སྟེ།",
    "ནང་ནག་ཕྱི་དཀར་ས་སྐྱ་པའི་དཔོན་ཆེན་རྣམས་ལ་ཟེར་པར་འདུག།",
    "རིག་འཛིན་ཆེན་པོ་ཀུ་མཱ་ར་ཛའི་གཟའ་མཐུ་འཇིགས་པོ་དེ་ཡང་འདིའི་སྒྲུབ་སྐོར་དུ་འདུག།",
    "མི་ཐུབ་ལྔ་འབྱུང་རང་ལ་ཡིད་མི་ཆེས།",
    "ཉང་པོ་རུ་བདེ་ཆེན་གླིང་པ་ཞེས་པའི་གཏེར་སྟོན་གཅིག་བྱུང་བས་དེ་དང་དུས་འགྲིགས་པར་འདུག།",
    "ཟུར་མཁར་གྱི་ཨ་ཇོ་དཔལ་པོ་དང་།",
    "བྱི་བས་ཕད་པ་སོགས་མང་པོ་བྱུང་བས་ཆུད་ཟོས་ཏེ་འདུག།",
