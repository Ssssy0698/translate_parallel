    "གྲོགས་པོ་མེད་པར་སྡུག་ནས་འདུག་པ་མཐོང་།",
    "ཕྱིས་སུ་བི་མ་ལས་གཡུང་དྲུང་ནི་བོན་གྱིས་བཏགས་པའི་མིང་དུ་འདུག་པས་བརྗེ་དགོས་གསུངས་ནས།",
    "ཕྱིས་སུ་བི་མ་ལས་གཡུང་དྲུང་ནི་བོན་གྱིས་བཏགས་པའི་མིང་དུ་འདུག་པས་བརྗེ་དགོས་གསུངས་ནས།",
    "གཡུང་དྲུང་དཔལ་གྱི་སེང་གེ་དེས་ལོ་བཞི་ལོན་ཙ་ན།",
    "དེ་ནས་ལོ་ཡོལ་ཙ་ན་བློན་པོ་མགོན་པོ་བརྟེན་གྱིས་གསན་ནས་གྲི་བརྒྱབ་སྟེ་བསད།",
    "ང་གཡུང་དྲུང་དེ་བོན་པོས་བཏགས་འདུག་པས་ཆོད།",
    "དེ་ནས་རྒྱལ་པོ་ལ་ཚེ་ཆུ་འཐུང་མ་བཅུག་དུས་ཨོ་རྒྱན་གྱིས་རྒྱལ་སྲིད་ཀྱི་བཞེད་པ་མེད།",
    "ད་ཆོག་ད་ཆོག་ད་མི་འདུག།",
    "ད་ཆོག་ད་ཆོག་འདིར་མི་འདུག།",
    "འདི་གཏོར་ཚེ་མ་ཆོད་ན་ནི་བློན་པོའི་གྲལ་ན་འདུག་དགོས་ཟེར་ནས།",
    "འབྲོག་དམངས་འཚོ་བ་དངོསགཞིར་རང་ཉིད་ཆ་རྒྱུས་མེད་པས་དཔྱད་ཞིབ་རགས་ཤིང་འགལ་འབྲེལ་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་འདུག་པ་མང་བ་དང་།",
    "རིག་དར་གྱི་རྒྱུད་པར་གྲགས་པའི་མི་རིགས་འདི་ནི་རང་བྱུང་ཁམས་ལ་འཐབ་རྩོད་གཉའ་གནོན་བྱེད་པ་ཞིག་མ་ཡིན་པར་རང་བྱུང་ཁམས་ལོངས་སྤྱོད་བྱ་ཤེས་ཤིང་རང་བྱུང་ཁམས་ལ་མཐུན་སྦྱོར་གྱིས་རང་བྱུང་ཁམས་ཀྱི་ཡོན་ཏན་ལེན་ཤེས་པའི་མི་རིགས་ཡ་རབས་ཤིག་ཡིན་པའང་རྟོགས་ནུས་སོ།",
    "འདི་བཞིན་ཐེ་བོའི་ཡུལ་ནས་སྤྱི་ཟླ་དང་པོའི་ནང་དུ་ཕལ་ཆེར་ལོ་གསར་གྱི་དགའ་སྟོན་ལ་རོལ་ཏེ་འདུག་གོ།",
    "རྟ་མགྱོགས་པའི་བང་རྩལ་འགྲན་པ་ནི་དུས་ད་ལྟའི་བར་དུ་མ་ཉམས་པར་གདའ།",
    "གཞན་གྱིས་བལྟས་ན་ཡིད་སྨོན་འཆོར་བའི་ཚོད་དུ་འདུག་གོ།",
    "དྲི་མེད་ཁ་དར་དཀར་པོ་མཐོ་རུ་བཏེགས་ཤིང་གུས་གུས་ཞུམ་ཞུམ་གྱི་སྒོ་ནསཨ་ཞང་ཚང་ལ་ཞུ་བ་ངོ་དགའ་བྱེད་པ་ཡིན།",
    "རྒན་པོ་ཚོས་བསྔགས་བརྗོད་ཆོ་ལོ་དེ་འཐོབ་པར་ནང་སྔ་ལངས་དང་དགོང་འཕྱི་ཉལ་གྱིས་རང་གང་བབས་ཀྱི་ལས་ལ་རྩེ་གཅིག་ཏུ་འཇུག་སྲོལ་ཅིག་གདའ་འོ།",
    "ངེས་པར་དུ་ཨ་ཞང་ཚང་ལའང་འགྲོ་དགོས་པས།",
    "ཁ་བ་མེད་ས་ཞིག་འཚོལ་དུ་འགྲོ་བ་ལས་ཕྱུགས་ཟོག་གཅིག་ཀྱང་ལུས་ས་མི་འདུག་ཟེར་ནས།",
    "ད་དུང་ཟས་གོས་གནས་མལ་གྱི་སྤྱོད་ལམ་དང་འགྲོ་འདུག་འཆགས་སྟངས་ཀྱི་སྤྱོད་ལམ་ལ།",
    "བང་སྣེ་རྡོ་ལ་འཐོག་ཐུག་རབ་གདའ།",
    "གསོད་གཅོད་ལ་ཀུན་ནས་རྔམ་ཞིང་རང་ཉིད་ཁོ་ནའི་ཕྱིར་དུ་འདུར་རྒྱུག་ལ་བྲེལ་བ་ཞིག་ཡིན་པ་ནི།",
    "ད་ལྟའང་ད་དུང་གྲགས་སྙན་སྐྱེས་པ་ལྔ་བའི་གླུ་དབྱངས་ཀྱིས་ཀུན་ནསའཁྱུད་ཅིང་གདའ་འོ།",
    "ཡིད་འགུལ་ཐེབས་པའི་ངང་རང་དང་མཉམ་གཅིག་ཏུ་ཡོང་བའི་གྲུ་དཔོན་ལ་འདི་སྐད་དོ།",
    "ཁྱེའུ་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་ལོ་བརྒྱད་ལོན་པ་ཙམ་ཞིག་འདུག་པ་དང་།",
    "ཁྱེའུ་འདི་པད་མའི་འབྱུང་གནས་སུ་འདུག་གོ་ཞེས་ཟེར་བས་མཚན་ཡང་དེ་ལྟར་པད་མ་འབྱུང་གནས་སུ་གྲགས།",
    "ཅེས་པ་སོགས་ཀྱི་འགྲེལ་བརྒྱབ་འདུག་ནའང་།",
    "དོན་དུ་གེ་སར་ནི་ཁོ་རང་ཉིད་དང་ངོ་བོ་དབྱེར་མེད་པའི་སྤྲུལ་བར་བསྟན་པ་དེ་དང་།",
    "འདི་ལྟ་བུའི་ཁང་པར་ང་རང་དགའ་པོ་གཏན་ནས་མེད།",
    "ང་རང་ནས་སེམས་སྡུག་ཆེན་པོ་བྱེད་ཀྱི་ཡོད།",
    "སེམས་ནང་དེ་མ་ཐག་ཨ་ཙི།",
    "ཧ་ཧ་ཧ་ཞེས་བྲིས་འདུགཡང་ལ་ལས་ལམ་འགྲམ་གྱི་ཚོང་ཁང་སོ་སོའི་སྒོ་ཁ་ན།",
    "ཡང་ན་འཛེམ་བག་མི་དགོས་པ་ཞིག་བྱས་འདུག་དེ་བས་ས་ཆ་འབོར་ཆེན་ཞིག་བདག་འཛིན་བྱས་པ་མ་གཏོགས།",
    "ང་རང་ཐང་ཆེན་དེའི་ཐོག་ཐེངས་གཅིག་འགྲོ་མྱོང་ཡོད།",
    "ཚ་བ་བཟོད་ཐབས་དཀའ་བ་ཞིག་འདུག་སྤང་ཐང་ཁ་ཤས་བཟོས་ཡོད་ནའང་དེ་ཚང་མ་ལྕགས་དྲས་སྐོར་ནས་མི་རྣམས་ལ་འགྲོ་མི་ཆོག་པའི་ཉེན་བརྡའི་ཡི་གེ་བྲིས་འདུག་དེ་མིན་ཐང་ཆེན་གྱི་དཀྱིལ་དུ་ད་དུང་མི་བཟོས་ཆུ་བོ་ཞིག་ཡོད་ལ།",
    "མི་སུ་ཞིག་ཀྱང་ཉེ་འགྲམ་དུ་འགྲོ་མི་ཐུབ་པར་གྱུར་འདུག་ཐང་ཆེན་ཧྲིལ་པོ་དེར་རྡོ་ཡིས་བཟོས་པའི་རྐུབ་སྟེགས་གཉིས་མ་གཏོགས་མེད་པས།",
    "༡༤། ང་རང་ཧ་ཅང་ཡ་མཚན་པའི་ངང་བོད་རིགས་རྩོམ་པ་པོ་ཞིག་ནས།",
    "དེང་རབས་ཅན་གྱི་བཟོ་གྲྭ་ཞིག་ཤི་མ་གསོན་གྱི་ཁྱིམ་ཚང་རང་བཞིན་གྱི་ལས་སྣོན་ཁང་ཆུང་ཆུང་གཅིག་ཏུ་གྱུར་བའི་གནས་སྟངས་འདི་ནི།",
    "དེར་བརྟེན་ང་རང་ཧ་ཅང་ཡ་མཚན་ཆེན་པོ་བྱུང་།",
    "སླར་ཡང་རང་ཉིད་ཀྱི་ཤ་ཉེར་ཁག་ཐེག་བྱེད་ཀྱི་ཡོད་ལ།",
    "རྩ་མེད་དུ་འགྲོ་ལ་ཉེ་བའི་གནས་སུ་གྱུར་ཡོད་པར་བསམ་བཞིན་འདུག།",
    "ངའི་བསམ་པར་འདི་ལྟར་བསམ་བློ་གཏོང་དགོས་ཀྱི་འདུག་ཐོག་མར་ཕྱི་ལོག་ཏུ་ཡོད་པའི་བོད་མི་ཚོ་བཙན་བྱོལ་བ་ཆགས་པས།",
    "མིག་ལ་ཧ་ཅང་ཡ་མཚན་གྱི་ཚོར་བ་ཞིག་སྤྲོད་ཀྱི་འདུག་ཕྱི་ལུགས་གྱོན་ཆས་གྱོན་པ་དེ་ཚོ་ནི།",
    "མར་རྒྱུགས་ཞེས་སྐད་ཅོར་རྒྱག་བཞིན་འདུགམྱུར་སྐྱོབ་དུས་སུ་སེམས་གསོ་དང་བལྟ་བར་ཡོང་བའི་མི་མཚམས་ཆད་ཀྱི་མེད་པ་དང་།",
    "ཡིན་ན་ཡང་རང་ཉིད་ལ་གྱོང་རག་པར་སྐྲག་ནས་མིག་ཟུར་ལས།",
    "ས་གནས་དཔོན་རིགས་ཀྱིས་ཀྱང་ས་དེར་ཤོ་རྒྱག་རྒྱན་འཇོག་བྱེད་བཞིན་པ་རྩད་ཆོད་འདུགགོང་བརྗོད་གནས་ཚུལ་དེ་དག་དངོས་གནས་ཡིན་མིན་ངས་བདེན་དཔང་བྱེད་ཐུབ་ཀྱི་མེད་ན་ཡང་།",
