    "མེ་དང་རང་བཞིན་འབྲེལ་བའི་ཕྱིར་ཏེ།",
    "དེ་གང་དུ་འདུ་ན་འབྲས་བུ་མ་དམིགས་པ་རང་བཞིན་མ་དམིགས་པར་འདུ་བ་དེ་བཞིན་དུ་འདི་ཡང་རང་བཞིན་མ་དམིགས་པར་འདུ་བའོ།",
    "རིག་བྱེད་རང་ཉིད་ཀྱིས་བྱས་པ་དེ་གཉིས་ལ་བྱེ་བྲག་ཅི་འདུག་བརྟག་པར་གྱིས་ཤིག།",
    "དེ་ཉིད་སྟོན་པའི་སྒྲུབ་པའི་ངག་མེད་པར་འདོད་པ་ཐམས་ཅད་བཀག་ནས་འདུག་གོ།",
    "སྐྱེ་བ་འཇིག་པའི་རྒྱུ་ཡིན་པ་ཁེགས་པས་རྒྱུ་ལས་སྐྱེ་བ་མེད་པ་ཅན་གྱིས་བྱས་པ་ལ་ཡང་རང་བཞིན་མི་འཇིག་པར་གནས་པའི་ངེས་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའོ།",
    "གང་དག་དེ་གཉིས་དངོས་འགལ་མ་ཡིན་པར་སྨྲ་བ་ཐམས་ཅད་གཞུང་འདིས་བཀག་ནས་འདུག་གོ།",
    "དེ་ཡང་རང་བཞིན་དང་འབྲས་བུ་གཉིས་ལ་གནས་པ་ཡིན་ཏེ།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "འདིས་ནི་མངོན་སུམ་གྱིས་སྒྲོ་འདོགས་གཅོད་པ་བཀག་འདུག་གོ།",
    "གཞུང་འདིས་ནི་མངོན་སུམ་གྱིས་གཟུང་བའི་ཡུལ་ངེས་པ་དང་རྟོགས་པར་འདོད་པ་ཐམས་ཅད་བཀག་ནས་འདུག་གོ།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "ཐ་དད་ཡིན་ཡང་རང་རིགས་གཅིག་ཏུ་རྟོགས་པའི་དོན་ཅན་གྱི་ཤེས་པ་བསྐྱེད་པ་ལ་སོགས་པའི་དོན་གཅིག་སྒྲུབ་པ་ལ་རང་རང་བཞིན་གྱི་ནུས་པ་སོ་སོར་ངེས་པ་ཡིན་ཏེ།",
    "གཞན་སེལ་བའི་སྒོ་ནས་བ་ལང་རང་མཚན་དེ་འཐོབ་པ་དང་རིག་པའི་དོན་ཅན་ཡིན་ཏེ།",
    "དོན་བ་ལང་རང་མཚན་ལ་མི་བསླུ་བར་ཡོད་པར་འདོད་དེ།",
    "བ་ལང་རང་མཚན་གྱི་དངོས་པོ་ཐ་དད་པ་རྣམས་ལ་བརྒྱུད་ནས་བརྟེན་པ་ཅན་ཡིན་པའི་ཕྱིར།",
    "ཉན་པ་པོའི་རྒྱུད་ལ་སྣང་བ་ལྟར་གྱི་གཟུང་དོན་མེད་པ་ཡིན་ཡང་རིགས་མཐུན་མི་མཐུན་གྱི་དངོས་པོ་ཀུན་ལས་ཐ་དད་པའི་བ་ལང་རང་མཚན་གྱི་དངོས་པོ་ཙམ་གྱི་ས་བོན་ཅན་གྱི་བློ་སྐྱེད་པར་བྱེད་པའི་ངག་ཡིན་པའི་ཕྱིར།",
    "གཞན་སེལ་བའི་སྒོ་ནས་བ་ལང་རང་མཚན་འཇུག་ཡུལ་དུ་བྱེད་པ་ཅན་ཡིན་ཏེ།",
    "གཞོ་ཁལ་གྱི་བྱ་བ་དེ་བྱེད་པའི་བ་ལང་རང་མཚན་ལ་བརྒྱུད་ནས་བརྟེན་པའི་ངོ་བོ་ཅན་ཡིན་པའི་ཕྱིར་ཏེ།",
    "བ་ལང་རང་མཚན་དང་བརྒྱུད་ནས་འབྲེལ་བའི་སྒོ་ནས་དེ་འཐོབ་པ་ལ་མི་བསླུ་བ་དེའི་ཕྱིར།",
    "བློ་འཁྲུལ་བས་གཞན་སེལ་དང་རང་མཚན་གྱི་དངོས་པོ་གཅིག་པ་ལྟར་དུ་རྟོགས་པའི་ཕྱིར་རོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "གསལ་བ་དང་རང་བཞིན་ཐ་དད་པ་དེས་ནའོ།",
    "གློག་ལ་སོགས་པ་རྒྱུན་མི་བརྟན་པའི་དངོས་པོ་གང་ལ་རང་གྲུབ་ཙམ་ནས་འཇིག་ངེས་སུ་འགྱུར་ཞེས་བྱ་བ་དེ་ལས་གཞན་རྒྱུན་བརྟན་པར་འདོད་པའི་རི་ལ་སོགས་པ་ལའང་རང་གྲུབ་ཙམ་ནས་ངོ་བོ་ཉིད་ཀྱིས་འཇིག་ངེས་སུ་འགྱུར་ཏེ།",
    "སྐྱེས་བུས་མ་བྱས་ཀྱང་རང་བྱུང་དུ་འདོད་དེ།",
    "ནམ་མཁའ་ལ་སོགས་པ་རྟག་པ་ལས་ཀྱང་རང་འཛིན་ཤེས་པ་སྐྱེ་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "བུམ་པའི་དངོས་པོ་དང་རང་བཞིན་ནམ་རྒྱུ་འབྲས་ཀྱི་འབྲེལ་བ་གང་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཤིང་ཙམ་དང་རང་བཞིན་འབྲེལ་བའི་ཕྱིར།",
    "བྱས་པ་དེ་ཡོད་ཙམ་དང་རང་ཆས་སུ་མི་རྟག་པ་དང་རྗེས་སུ་འབྲེལ་བར་རོ།",
    "རྒྱུ་དང་རང་བཞིན་ལྡོག་བྱེད་ཡིན་པར་གོང་དུ་བསྒྲུབས་པ་དེའི་ཕྱིར།",
    "འབྲས་བུ་དུ་བ་དང་རང་བཞིན་བྱས་པ་དེ་གཉིས་པོ་ཁོ་ནས་མེ་དང་མི་རྟག་པའི་དངོས་པོ་ཡོད་པར་འགྲུབ་སྟེ།",
    "རྟགས་འགོད་པ་སྐབས་སུ་བབ་པ་ལ་བརྟེན་ནས་འདུག་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "གལ་ཏེ་ལུང་དོན་བསྒྲུབ་བྱ་ཡིན་ཡང་རང་ཉིད་སྨོས་པ་དོན་མེད་དུ་མི་འགྱུར་ཏེ།",
    "ཡང་ན་ཁྱེད་རང་མི་འདོད་པའི་བུམ་པའི་ཟླ་བཅས་བསྒྲུབ་བྱ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེས་ན་ཚིག་བརྗོད་བྱ་སྟོན་པ་དང་མ་འབྲེལ་ཞིང་མི་བདེན་པར་དམ་བཅས་པ་ན་ལུང་དང་རང་ཚིག་གཉིས་ཀར་གྱིས་གནོད་པ་ཡིན་ཏེ།",
    "རིགས་སྒོར་ལུང་དང་རང་ཚིག་དང་འགྲེལ་བའི་དཔེར་བརྗོད་ཐ་དད་དུ་གསུངས་པའི་དགོས་པ།",
    "བཞི་པ་རིགས་སྒོར་ལུང་དང་རང་ཚིག་དང་འགལ་བ་ལ་དཔེར་བརྗོད་ཐ་དད་དུ་གསུངས་པའི་དགོས་པ་ནི།",
    "གལ་ཏེ་རི་བོང་ཅན་ཡང་རང་རྒྱུ་ལས་ཟླ་བར་སྐྱེས་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ལ་ཁས་བླངས་སྔ་ཕྱི་དང་རང་ཚིག་དངོས་ས་ཤུགས་དང་།",
    "ཡིད་ཆེས་ཀྱི་བསལ་བ་ལ་ཁས་བླངས་དང་རང་ཚིག་ལ་བརྟེན་པ་གཉིས་ཡོད་པ་ལས།",
    "བྱེད་པའི་དབྱེ་བ་མེད་ན་འོ་ན་བསྟན་བཅོས་དང་རང་ཚིག་འདི་དག་ལ་དབྱེ་བ་ཅི་ཡོད་ཅེ་ན།",
    "གལ་ཏེ་འོ་ན་སྔར་ཁས་བླངས་པ་དང་རང་ཚིག་དང་འགལ་བ་གཉིས་པོའི་གེགས་བྱེད་པའི་ཡུལ་ལ་བྱེ་བྲག་ཅི་ཞིག་ཡོད་དེ།",
    "ཁས་བླངས་དང་རང་ཚིག་གཉིས་ལ་གེགས་བྱེད་པའི་ཡུལ་གྱི་དབྱེ་བ་མེད་ཅིང་།",
    "དེ་ལྟར་ན་བསྒྲུབ་བྱའི་མཚན་གཞི་ལ་བརྟགས་ན་ཁྱེད་རང་ལའང་མཚུངས་སོ་ཞེ་ན།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་གྱི་སྐྱེ་བ་མེད་པས་ཡོད་པའམ་མེད་པ་གང་ཡང་མི་སྐྱེ་སྟེ།",
    "དེ་ལྟ་ན་ཡང་རང་རྒྱུད་ཀྱི་རྗེས་དཔག་དོན་མེད་དེ།",
    "གཞན་ལུགས་སུན་འབྱིན་པ་ལ་ཡང་རང་རྒྱུད་ཀྱི་རྗེས་དཔག་སྦྱོར་བ་དོན་མེད་པ་ཡིན་ནོ།",
    "རང་ཕྱོགས་སྒྲུབ་པ་ལ་ཡང་རང་རྒྱུད་དོན་མེད་དེ།",
    "དེ་ལྟར་ན་རང་ལུགས་སྒྲུབ་པ་ལ་ཡང་རང་རྒྱུད་ཀྱི་སྦྱོར་བ་དོན་མེད་དོ།",
    "འགྲོ་བ་པོ་མིན་འགྲོ་བ་མིན།",
    "གནས་པ་པོ་མིན་འགྲོ་བ་མིན།",
    "སྐྱེ་བའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "མུན་པ་གང་སེལ་བས་མར་མེ་གཞན་གསལ་བྱེད་དུ་འགྱུར་བ་མར་མེ་ཡུལ་གང་ན་འདུག་པ་དེ་ན་ཡང་མུན་པ་མེད་དེ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "འགལ་ཟླར་གྱུར་པའི་ཕྱིར་མུན་པས་ཀྱང་རང་གཞན་གཉིས་ཀ་སྒྲིབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་གང་ལས་རྒྱུ་དང་རྐྱེན་དོན་མེད་པར་འགྱུར་བ་སྐྱེ་བའི་སྔ་རོལ་དུ་དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་གྱི།",
    "དངོས་པོ་ཡོད་ན་ཡང་རང་བཞིན་ནམ་གཞན་དངོས་ཞིག་ཏུ་འགྱུར་དགོས་ཏེ་དེའི་ཕྱིར་དེ་དག་ཀྱང་ཡོད་དོ་ཞེ་ན།",
    "དེ་ལྟ་ན་བཅིངས་པ་ཡིན་པའི་ཕྱིར་དང་གྲོལ་བཞིན་པ་ཡིན་པའི་ཕྱིར་བཅིངས་པ་དང་གྲོལ་བ་དག་དུས་གཅིག་པར་འགྱུར་ན།",
    "དེ་ཡང་རང་བཞིན་ལུང་མ་བསྟན།",
    "འདི་ལྟར་རང་བཞིན་མེད་ཅིང་རང་བཞིན་གྱིས་སྟོང་པ་དེའི་ཕྱིར།",
    "ཅི་སྟེ་རང་བཞིན་མེད་པ་ལ་བྱ་བྱེད་མི་རུང་བའི་ཕྱིར་ཉེས་པ་སོ་ན་འདུག་གོ་སྙམ་ན།",
    "རང་བཞིན་དང་བཅས་པ་ཁོ་ན་ལ་བྱ་བ་མ་མཐོང་བའི་ཕྱིར་དང་རང་བཞིན་མེད་པ་རྣམས་ཁོ་ན་ལ་བྱ་བ་མཐོང་བའི་ཕྱིར་རོ།",
    "སྤྲུལ་པ་གང་ཞིག་སྤྲུལ་པ་གཞན་སྤྲུལ་པ་པོ་ནི་སྟོང་ཞིང་རང་བཞིན་མེད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་མེད་པའི་སྤྲུལ་པ་དེ་རྣམས་བྱ་བ་དང་བྱེད་ལས་དང་བྱེད་པ་པོ་ལ་སོགས་པའི་ཐ་སྙད་ཡོད་པ།",
    "རང་བཞིན་མེད་པའི་བྱེད་པ་པོ་དེས་བྱས་པའི་ལས་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
    "ཚིག་གསལ་རང་ནའང་འདུག་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡོད་ན་འཆི་བ་དང་སྐྱེ་བ་དག་དུས་གཅིག་ཏུ་འགྱུར་ན།",
    "དེ་ལྟར་རྣམ་པ་ཐམས་ཅད་ཀྱིས་དཔྱད་པ་ན་ཉེ་བར་བླང་བ་དང་ཉེ་བར་ལེན་པ་པོ་རྣམ་པ་ཀུན་གྱིས་སྟོང་ཞིང་རང་བཞིན་མེད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་དེ་བཞིན་གཤེགས་པ་རང་བཞིན་མེད་པ་དེ་ལྟར་འགྲོ་བ་འདིའི་རང་བཞིན་ཡང་རང་བཞིན་མེད་པར་ཤེས་པར་བྱ་སྟེ།",
    "མི་གཙང་རང་བཞིན་ཤེས་བཞིན་དུ།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "གང་བརྟེན་ནས་གདགས་པ་དེ་ནི་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་ཡིན་ཞིང་གང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་ནོ།",
