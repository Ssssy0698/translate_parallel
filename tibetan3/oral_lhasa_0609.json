    "བསྒྲིམ་མི་དགོས་པར་ཡིད་རྣལ་དུ་ཕེབས་ཤིང་ལྷུན་གྱིས་གྲུབ་པས་གྲུབ་པ་ཐོབ་བོ།",
    "ཡུལ་ཁང་ནོར་རྫས་ཐམས་ཅད་ལ་བདག་ཏུ་འཛིན་པ་མེད་པར་དེ་རྣམས་ལ་ཞེན་པ་ཆུང་དུ་འགྲོ་དགོས་སོ།",
    "དེའི་ཚེ་བདག་འཛིན་མ་སྤོངས་པར་རང་སར་གྲོལ་བས།",
    "བདུན་པོ་དེ་ཁྱད་པར་གྱི་ཟབ་དོན་བདུན་ཡིན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དང་།",
    "ལེ་ལོ་དང་བཏང་སྙོམས་སུ་མི་འཇོག་པར་རྩ་བྲལ་དུ་ཉམས་སུ་ལེན་པས།",
    "རྒྱལ་པོ་གདན་ལ་བཞུགས་ཀྱང་འདོད་པ་ཤུགས་ལས་འགྲུབ་པ་ལྟ་བུའོ།",
    "བྱིང་རྨུགས་རྒོད་འཐིབས་ལ་སོགས་པའི་ཉེས་སྐྱོན་མེད་པར་ཤེས་བཞིན་གྱི་བྱ་རས་ཟིན་པ།",
    "སྐམ་སར་ཕྱིན་པར་བྱེད་དོ།",
    "ཐར་ས་གང་དུ་ཐར་ན་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་ཐར་ནས་རྣམ་རྟོག་ཐམས་ཅད་ཡེ་གྲོལ་ཡེ་དག་ཏུ་ཤེས་ཏེ་སྐུ་གསུམ་དུ་སངས་རྒྱའོ།",
    "དཔེར་ན་ཀ་ར་ཐམས་ཅད་གཟུགས་བརྙན་ཅི་བྱས་ཀྱང་མངར་བར་རོ་གཅིག་པ་ལྟར།",
    "ཚོགས་དྲུག་མ་བཅོས་ལྷུག་པར་བཞག་པས་ཡུལ་དྲུག་ཕྱག་རྒྱ་ཆེན་པོར་འཆར་རོ།",
    "གཉིས་པ་དྲན་རྟོག་སྟོང་པར་ཤེས་༢༡༩བ་པས་རྐུན་མ་ངོ་ཤེས་པ་ལྟ་བུ་ནི།",
    "རྣམ་རྟོག་ཅི་བྱུང་ཡང་ངའི་ངོ་བོ་སྟོང་པར་ཤེས་པས་དྲན་པ་ཙམ་གྱིས་མི་གནས་སོ།",
    "གཉིས་པ་སྣང་བ་སྟོང་པར་ཐིམ་པ་ལན་ཚྭ་ཆུ་ལ་ཐིམ་པ་ལྟ་བུ་ནི།",
    "དེ་གཉིས་ཀྱི་དོན་ཤེས་པར་བྱེད་འདོད་པས་གཏན་ལ་དབབ་པ་ནི།",
    "དཔེར་ན་སྒྱུ་མ་མཁན་གྱིས་བྱས་པའི་སྐྱེས་པ་དང་།",
    "མེད་པ་ལ་ཡོད་པར་འཛིན་པ་སྒྱུ་མ་ལྟ་བུའོ།",
    "བློའི་ཡུལ་ལས་འདས་ཚིག་ཏུ་བརྗོད་པས་ཐོག་ཏུ་ཕེབས་མི་སྲིད་པ་ཡིན་ནོ།",
    "གསུམ་པ་དེ་རྟོགས་པར་བྱེད་པའི་ཐབས་གཏེར་གྱི་ཁ་བྱང་ལྟ་བུ་ནི།",
    "དཔེར་ན་ཉི་མ་ལ་ཉེ་རིང་མེད་པར་ཀུན་ལ་སྙོམས་ནས་འགྲོ་བ་ལྟར།",
    "བརྟན་པར་གྱིས་ཞེས་གསུངས་པས།",
    "ཐུགས་རྗེ་ཆེན་པོའི་བྲིས་སྐུ་ལ་སོགས་པ་མཛེས་པར་བཀྲམ་སྟེ།",
    "དེ་ཉིད་གསལ་ལ་མ་བསྒྲིབས་པར་འཆར་བ་དེ་ཡེ་ཤེས།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་ཏེ་སྤྱི་བོ་ནས་རྐང་མཐིལ་ཡན་ཆད་ཁྱབ་ལུས་ཀྱི་སྡིག་སྒྲིབ་དག་ནས་ཐུགས་རྗེ་ཆེན་པོའི་སྐུར་གྱུར་པར་སྒོམ།",
    "རང་གཞན་གྱི་འཁོར་ལོངས་སྤྱོད་གང་ལ་ཡང་ཆགས་པར་མི་བྱ།",
    "རྫས་ཡོ་བྱད་ཐམས་ཅད་ཚོགས་སུ་བཏང་བས་ལུས་ངག་ཡིད་གསུམ་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་གསུང་ཐུགས་དང་འདུ་འབྲལ་མེད་པར་འགྱུར་རོ།",
    "རིག་པ་རྟེན་མེད་སྟོང་པར་ཡལ་དུ་གཞུག།",
    "རྒྱུན་དུ་བཟླས་བརྗོད་བྱས་ན་ལྟ་ཅི་སྨོས་སོ།",
    "རས་གཙང་མ་ལ་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་མཚན་ཉིད་དང་ལྡན་པ་བྲིས་ནས།",
    "མགྲིན་པར་ཨཱ་ལ་པདྨ་རཱ་གའི་ཡི་གེ་དྲུག་པས་བསྐོར་བ་བྲི།",
    "དེ་ལ་སོམ་ཉི་མ་བྱེད་ཅིག་ཅེས་གསུངས་པས།",
    "ད་ལྟར་བྱས་པ་ལྟ་བུ་མ་ཡིན་ནམ་མཁའ་ལྟར་ཡེ་གནས་སུ་དགོངས་པ་ཆེ་བའོ།",
    "བསྐྱེད་པའི་རིམ་པ་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་སྐད་ཅིག་དྲན་རྫོགས་སུ་གསལ་བཏབ་ལ་སྣང་ལ་རང་བཞིན་མེད་པར་ཉམས་སུ་ལེན།",
    "ངག་བཟླས་པ་སྔགས་ཀྱི་རིམ་པ་ཨོཾ་མ་ཎི་པདྨེ་ཧཱུཾ་ཞེས་གྲག་སྟོང་རྒྱུན་ཆད་མེད་པར་ཉམས་སུ་ལེན།",
    "ཐོས་བསམ་དད་པ་ལ་བརྟེན་ལ་རྟོགས་པ་ཐག་ཆོད་པར་མཐར་དབྱུང་།",
    "འབྲས་བུ་ཡེ་དག་ཡེ་གྲོལ་སྤངས་ཐོབ་མེད་པར་ལ་བཟླ།",
    "རང་ཉིད་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་སྣང་ལ་རང་བཞིན་མེད་པར་སྒོམ།",
    "ༀམ་ཎི་པདྨེ་ཧཱུཾ་ཞེས་པ་གྲག་སྟོང་རྒྱུན་ཆད་མེད་པར་བཟླས།",
    "གདན་ཉི་ཟླ་པདྨ་བགེགས་ཀྱི་སྟེང་ན་ཞབས་གཉིས་གྱད་ཀྱི་དོར་སྟབས་སུ་བཞུགས་པ།",
    "ཏིང་ངེ་འཛིན་ལ་གསལ་འགྲིབ་མེད་པར་རིག་པ་གསལ་བཏབ།",
    "ཉིན་མཚན་མེད་པར་ལྷའི་ང་རྒྱལ་བྱ།",
    "སེམས་མི་འགྱུར་བའི་གདེངས་དང་ལྡན་པར་བྱའོ།",
    "དེ་ལྟར་བགེགས་རིགས་སྟོང་ཕྲག་བརྒྱད་ཅུ་རྩ་བཞིས་རྐྱེན་བྱས་ནས་ན་སྟེ་འགྲོ་བའི་སྲོག་ལ་རྒོལ་ལོ།",
    "རིག་པ་གསལ་ལ་རྟོག་པ་མེད་པར་བཞག་པས་རྒྱུ་འདོད་གས་ཞི་གདོན་ས་གདོན་ཞི་འབྲས་བུ་ལོངས་སྐུ་ཐོབ་བོ།",
    "གཞན་ན་བ་ཡིན་ཡང་ལུས་ལ་ཆགས་པ་མེད་པར་གང་འདོད་པ་༢༣བ་སྦྱིན་ནོ།",
    "དེ་ལྟར་བྱས་ན་གདོན་དེ་ལས་ངན་ཡི་དགས་གནས་ལས་ཐར།",
    "ཨོཾ་ཡེ་ཤེས་རྣམ་ལྔས་དུག་ལྔ་སྤྱིཪ་འཇོམས་པར་བྱེད།",
    "མས་ཞེ་སྡང་འཇོམས་པར་བྱེད།",
    "ཎིས་གཏི་མུག་འཇོམས་པར་བྱེད།",
    "པད་ཀྱིས་འདོད་ཆགས་འཇོམས་པར་བྱེད།",
    "མེས་ང་རྒྱལ་འཇོམས་པར་བྱེད།",
    "ཡི་དྭགས་བཀྲེས་སྐོམ་གྱི་སྡུག་བསྔལ་དུ་མ་འགགས་པར་ཤར།",
    "རྙེད་ན་མཚམས་འདིར་གཞུག་པར་བྱའོ།",
    "རྒྱལ་པོ་ཉིད་དང་དུས་མཚུངས་སྔར་གྱི་བཀའ་དྲིན་བརྗོད་པར་མི་ནུས་ཀྱང་།",
    "རྟགས་གསུངས་པ་ཐམས་ཅད་དུས་དེ་ཉིད་དུ་རྫོགས་པ།",
    "ཁ་ཙམ་མ་ཡིན་པར་སྐྱབས་འོག་ཏུ་ཚུད་ངེས་པའི་གསོལ་བ་ཐོག་མར་གདབ་བོ།",
    "འཕགས་པ་ནམ་མཁའི་རྒྱལ་པོའི་སྐུ་གསུང་ཐུགས་འགྲུབ་པར་བྱས་ལ།",
    "དེ་ལྟར་སྐུ་ཡོངས་སུ་རྫོགས་པར་འཛམ་བུའི་གླིང་བྱེ་བ་ཕྲག་བརྒྱ་ལ་སོགས་པར།",
