    "རྣམ་པར་རྟོག་པ་མ་མཆིས་པའི་སླད་དུ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "བཅོམ་ལྡན་འདས་སྒྱུ་མའི་སྐྱེས་བུ་ནི་རྣམ་པར་མི་རྟོག་པའི་སླད་དུ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "བཅོམ་ལྡན་འདས་གཟུགས་བརྙན་རྣམ་པར་མི་རྟོག་པའི་སླད་དུ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "མི་སྡུག་པར་འགྱུར་བའི་ངོ་བོ་ཉིད་མི་དམིགས་པའི་སླད་དུའོ།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་ཡང་སྡུག་པ་འམ་མི་སྡུག་པར་འགྱུར་བ་གང་ཡང་མ་མཆིས་སོ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "སྤྲུལ་པ་ནི་མི་རྟོག་རྣམ་པར་མི་རྟོག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་དེ་ནི་མི་རྟོག་རྣམ་པར་མི་རྟོག་པའོ།",
    "འཁྲུལ་འཁོར་དེ་ནི་རྣམ་པར་མི་རྟོག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་དེ་ནི་རྣམ་པར་མི་རྟོག་པའོ།",
    "ཚེ་དང་ལྡན་པ་རབ་འབྱོར་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འབའ་ཤིག་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡང་རྣམ་པར་མི་རྟོག་པ་ཡིན།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་བསམ་གཏན་གྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡང་རྣམ་པར་མི་རྟོག་པའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡང་རྣམ་པར་མི་རྟོག་པའོ།",
    "ཚེ་དང་ལྡན་པ་རབ་འབྱོར་ཅི་གཟུགས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པ་ཡང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཕ་རོལ་དུ་ཕྱིན་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྟོང་པ་ཉིད་ཐམས་ཅད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྟོང་པ་ཉིད་དང་མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པ་ཡང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་ཡང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུས་བྱས་ཀྱི་ཁམས་དང་།",
    "འདུས་མ་བྱས་ཀྱི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣམ་པར་རྟོག་པ་ལས་བྱུང་བ་ཡོངས་སུ་བཟུང་སྟེ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་ལན་ཅིག་ཕྱིར་འོང་བ་དང་།",
    "རྣམ་པར་རྟོག་པ་མེད་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སྤྱོད་པས།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་དང་།",
    "དོན་འདི་ལ་སྤྱོད་ཀྱང་ཡང་དག་པའི་མཐའ་གང་མངོན་དུ་བྱས་པས།",
    "རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་དབེན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་དུ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་དབེན་པའོ།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་འདི་ལྟར་གང་ཞུམ་པར་འགྱུར་བ་དང་།",
    "སྒྱིད་ལུག་པར་མི་འགྱུར་ལ།",
    "མི་འཇིགས་མི་སྔང་སྐྲག་པར་མི་འགྱུར་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སྤྱོད་པ་ལགས་སོ།"
  ]
}