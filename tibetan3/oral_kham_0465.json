    "བྱས་ན་ཁྱེད་རང་སློབ་སྦྱོང་མ་ཚར་བར་བསྡད་ན་ཟེར་སྐབས།",
    "ད་དུང་འགོ་ཁྲིད་ཆེ་བ་ཚང་མ་ཕེབས་པར་དངོས་འབྲེལ་ཡག་པོ་འདུག་མི་གོ་བ་ཅན་ལ་ཞུ་ཤེས་པ་དང་།",
    "ཨ་ཙི་དགོངས་པ་བཞེས་དང་སྤུན་ཟླ་ཚོ།",
    "དེའི་སྐོར་ལ་གུས་པས་བསམ་བློ་གཏོང་སྐབས་དངོས་འབྲེལ་ཞེ་འཁོན་སྐྱེ་ཡི་འདུག་གང་ལགས་ཟེར་ན།",
    "མིག་ཆུ་བཏང་ནས་སྡུག་བསྔལ་ཆེན་པོ་བྱེད་ཀྱི་འདུག་སླད་ཕྱིན་གལ་སྲིད་བོད་རང་བཙན་མ་བྱུང་བ་དང་།",
    "བོད་མི་མང་པོ་ཞིག་སེམས་ཕམ་ཆེ་བས་ཚེ་སྲོག་ལ་ཉེན་ཁ་ཡང་འདུག་པར་བརྟེན།",
    "བོད་ནང་རྒྱ་མིས་བརྒྱ་ཆ་བརྒྱད་ཅུ་ཁེངས་འདུག་གསུངས་པ།",
    "གོང་འོག་དུས་ཚོད་ལ་དཔྱད་ན།",
    "མཐོ་མཐའ་ལོ་བཞི་བཅུ་ཞེ་ལྔ་བར་གྱི་ཚད་གཞི་བཟུང་ནས་འགྲོ་ཐེངས་དང་གཉིས་བཟོས་འདུག་དཔེར་ན།",
    "ཁོ་རང་ནི་དེ་དུས་ལོ་ཉི་ཤུ་རྩ་ལྔར་སླེབས་ཡོད།",
    "ཡང་ག་དུས་བཙན་ཤེད་བྱས་ཡོང་ངམ་བསམས་ནས་མི་ཚང་མ་སྡུག་བསྔལ་གྱི་གནས་ཤིག་བཟོས་འདུག་དེ་དང་ཆབས་ཅིག་ལྷ་ས་ནས་ཀྱང་གོང་གསལ་བཞིན་བཙན་ཤེད་བྱས་ནས་ནང་མི་འམ།",
    "བོད་མི་ཁ་ཤས་ཀྱི་བསམ་པར་དངོས་འབྲེལ་ཡག་པོ་འདུག་བསམས་ནས་རླངས་འཁོར་གོག་ཧྲུལ་ཉོ་མཁན་འཚང་ཁ་ཤིག་ཤིག་བྱུང་རྗེས།",
    "ལྷ་སྐུ་ལ་ཆགས་སྡང་མི་སྐྱེ་བ་གདའོ།",
    "ང་ནི་ཡི་དམ་བརྡའི་མཚོན་བྱེད་དུ་འདུག།",
    "གསང་སྔགས་ནས་འདི་ཚེ་གཅིག་ལུས་གཅིག་ལ་སངས་རྒྱའོ་ཞེས་བྱ་བའི་ཐག་མང་པོ་བཅད་འདུག་སྟེ་གཞན་གྱིས་ཆ་མེད།",
    "དེ་མིན་ན་མི་ཐོབ་པར་འདུག་གསུངས།",
    "ང་ལ་རྒས་པའི་གོག་སྐད་མི་འདུག་གསུངས།",
    "འདི་ལས་བར་ཆད་ཆེ་བ་མི་འདུག་གོ་གསུངས།",
    "ང་ལ་ན་ནིང་ཙ་ན་བྱུང་།",
    "དུས་རྒྱུན་ཏུ་ཉམས་དགའ་ཡལ་ལེ་ཙམ་ཡོང་མ་མྱོང་ཟེར་བ་འདུག་སྟེ།",
    "འཁོར་འདས་ཐམས་ཅད་སེམས་ལས་བྱུང་བར་འདུག།",
    "བར་ཆད་བདུད་དཔུང་བཟློག་པའི་དམག་དཔོན་དུ་འདུག།",
    "ཡོན་ཏན་ཐམས་ཅད་བསྐྱེད་པའི་ས་གཞི་རུ་འདུག།",
    "སྡུག་བསྔལ་གྱི་ཆུ་བོ་སྒྲོལ་བའི་གཉན་པ་རུ་འདུག།",
    "ང་རང་ལ་ནི་མེད་གསུངས།",
    "ཐུགས་ཡིད་འདྲེས་པ་ལ་གསོལ་བ་ཞིག་རང་འདེབས་དགོས་པར་འདུག་གོ་སྐལ་ལྡན་ཀུན་ངས་གོ་བ་ཡིན་ཏེ་གསུངས་སོ།",
    "སླར་དེ་ལ་བར་ཆད་འཇུག་པའི་རྒྱུ་ཡིན་ཟེར་བ་མང་པོ་འོང་བར་འདུག་སྟེ་མ་གོ་བ་ཡིན།",
    "གསང་སྔགས་ནས་ཚེ་གཅིག་ལ་སངས་རྒྱའོ་བྱ་བའི་གདམས་ངག་ཇི་སྙེད་ཅིག་འདུག་སྟེ།",
    "ཐུགས་ཡིད་གཅིག་ཏུ་འདྲེས་པ་ལ་གསོལ་བ་རང་འདེབས་དགོས་པའི་ཞད་དུ་གདའོ།",
    "ཀུན་རྫོབ་དུ་སྣང་བ་དེ་ཡང་ངོ་བོ་རང་བཞིན་གྱིས་སྟོང་པར་འདུག་པས་འཛིན་པ་དང་བྲལ་བ་དེ་རྣལ་འབྱོར་གྱི་རྒྱུད།",
    "དེ་ལྟར་སྣང་བ་དང་སྟོང་པ་དབྱེར་མེད་དུ་འདུག་པ་དེ་ཟུང་འཇུག་བློ་ལས་འདས་པ་བླ་ན་མེད་པའི་རྒྱུད།",
    "ས་རྡོ་རི་བྲག་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་དངོས་པོ་ཐམས་ཅད་འཛུམ་དམུལ་ལེ་སོ་སེག་གེ་བྱས་ནས་དགའ་ཡལ་ལེ་འདུག་པར་བསྒོམ།",
    "པད་གནས་ལངས་དང་འདུག་པ་འམ།",
    "ཡོདཔ་མ་ཡིན་པ་ལས་བརྟགས་པ་དེ་ཤེས་པའི་ཕྱིར་ཏོ་འདི་ལ་བདེན་པ་གང་ཡིན་ཞེས་དེ་ལྟར་བརྟགསོན་ཡང་ད་ལྟ་འཆུབ་བར་ཡོངས་སུ་ཤེས་པའི་ཕྱིར་བྱིས་བ་སོ་སོའི་སྐྱེ་པོའི་གནས་སྐབས་ཀྱི་འོག་རོལ་ཏུ་རྣམ་པར་ཤེས་པ་ཁོ་རང་འགག་པར་འགྱུར་ཞིང་དེ་ལམ་སྣང་བར་འགྱུར་རོ།",
    "སྣཚོགས་པདྨའི་སྟན་ལ་འདུག།",
    "རབ་ཏུ་དོག་པོ་མུན་ནག་འཐིབས་པོར་འདུག་པའི་མི།",
    "ཉིད་ཀྱི་དོན་དུ་པདྨ་ཁ་ཕྱེ་ལྷག་གེར་འདུག་པ་ཡི།",
    "ལྷ་ཆུ་བོ་ང་རླབས་ཆིལ་ཆིལ་འདུག་པ་ཡིས།",
    "གཞན་ཡང་རང་བཞིན་འགྱུར་བར་མི་འགྱུར་ཏེ་རྟག་པའི་ཕྱིར་སྐྱེས་པའི་རང་བཞིན་ནོ།",
    "དེ་ལྟ་བུ་དེ་དག་དུས་ཇི་སྲིད་མི་གོ་ཞེ་ན།",
    "མཚན་བེ་རོ་ཙ་ན་ཞེས་བགྱི་བས་བྱིས་པ་ལྕགསཛི་ཁྱེའུ་འངོས་དང་།",
    "འབྲུག་དུས་མིན་དུ་བསྒྲགས་པ་དང་།",
    "མར་ཕྱེད་གསུམ་སྐོར་འདུག་པ་གསུམ་སྐོར་ཤ་སྟག་ཏུ་བསྒྱུར།",
    "རྟེན་གསུམ་མཆོད་རྫས་ཆས་དངོས་སོགས་ཚན་མི་ཆུང་ཙམ་འདུག་ཀྱང་ཚང་མ་མིང་སྨོས་བྲིར་མ་ལྡང་བས་ཧ་ལམ་རྟེན་གསུམ་མཆོད་རྫས་དང་།",
    "ཁང་དཔོན་ལོགས་བཅད་བྱས་ཀྱང་ལྟོ་འབྱོར་ཡོང་རིགས་མི་འདུག་པ་མཆོད་གཞིས་བྱིངས་དང་ཕྱོགས་མཚུངས་གྲས་སུ་མི་སེར་དུད་འཛིན་༣༢ན་བརྒྱད།",
    "ཧུང་ཐའི་ཇི་མ་ནས་ཕེབས་བཞེད་འདུག་པ་དང་།",
    "དཔོན་ཆུང་མི་བཟང་རང་རང་གོ་བབས་ཀྱི།",
    "འདི་ཉིན་ཁང་སེར་མའི་ཐད་ནས་པོ་ཏ་ལར་འཇའ་གུར་ཁྱད་མཚར་བའང་བྱུང་༦༤ན་འདུག།",
    "དགོན་སར་ཨ་ཇོ་ཁུངས་ཀྱི་བོགས་མཁར་ཁལ་བཅོ་ལྔ་བྲེ་ལྔ་ཕུལ་གསུམ་སུམ་ཆ་གཅིག།",
    "ཨ་ཇོར་སེལ་༧༣ན་འདོན་སྐུ་རིམ་རྟེན་རྣམས་བསྡོམས་རུའི་ཁལ་བརྒྱ་དང་བརྒྱད་ཅུ་གྱ་གཅིག་བྲེ་ལྔ་ཕུལ་གསུམ་ལྷག་བཅས་རྣམས་མཆོད་རྒྱུན་དུ་བསམས་གནས་པ་བྱས།",
    "བྱམས་ཁང་རྒྱབ་པར་ཁོག་ཞུགས་འདུག་པས་འབུལ་ཡོན་སྦྱར་ཏེ་རྣམ་རྒྱལ་གྲ་ཚང་ནས་དྭངས་མ་བཅུད་འདྲེན་ལ་བརྟེན་པའི་ཞབས་བརྟན་དང་།",
