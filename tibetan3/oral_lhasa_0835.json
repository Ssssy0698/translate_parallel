    "དེས་ཤིང་མེད་པར་བྱས་པའི་དཔེར་བཀོད་པ་ལ་གནོད་པ་བརྗོད་པ་ཡིན་ལ།",
    "ནག་པ་ཤི་བའི་རྗེས་སུ་འདིས་ནག་པ་བསད་དོ་ཞེས་པ་མི་རིགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "བུམ་པ་གནས་པའི་སྐབས་མི་སྲིད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དིས་ནི་ཐོ་བ་སོགས་རྐྱེན་བུམ་པ་ཞིག་པ་ལ་བུམ་པའི་འཇིག་པར་བསམས་ལ།",
    "གཞུང་འདིས་བསྟན་པར་འདོད་པ་ནི་མི་རིགས་ཏེ།",
    "ཞིག་འཇིག་གཅིག་ཏུ་འདོད་པའི་ལུགས་ལེགས་པར་གནས་པར་འགྱུར་རོ།",
    "རྟག་དངོས་སུ་ཁས་ལེན་དགོས་པས་གྲངས་ཅན་གྱི་ལུགས་ལེགས་པར་གནས་པར་འགྱུར་རོ།",
    "འཇིག་པའི་རྫས་ཡིན་ན་དངོས་པོའི་འཇིག་པ་ཞེས་དྲུག་སྒྲ་མི་འཐད་པར་འགྱུར་ལ།",
    "རང་རྒྱུ་ལས་འཇིག་པར་སྐྱེས་པ་ལ་བརྟག་པ་མཚུངས་པ་སྤང་བ་ནི།",
    "ཡང་བུམ་པ་ཕྱིས་ཞིག་ནས་མེད་པར་འགྱུར་རོ།",
    "དངོས་པོ་སྐད་ཅིག་མར་སྨྲ་བས་ཕྱིས་བུམ་པ་ཞིག་ནས་མེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "དོན་གཞན་དེ་ལ་བལྟོས་པར་འགྱུར་བ་འཐད་པའི་ཕྱིར།",
    "དངོས་པོ་འཇིག་པར་སྐྱེས་པས་ཁྱབ་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྤྱོད་པ་པ་རིག་བྱེད་ཀྱི་སྒྲ་བརྡ་མ་སྦྱར་ཡང་དོན་སྟོན་པའི་ནུས་པ་ཡོད་པར་འདོད་པ་དག་ལ་ཡང་།",
    "སྔགས་མ་བྱས་པ་བྱེ་བྲག་ཏུ་དགག་པའོ།",
    "སྐྱེས་བུས་མ་བྱས་པའི་ཕྱིར།",
    "མ་བྱས་པར་འདོད་རིགས་པའི་ཕྱིར།",
    "རྣམ་པར་རྟོག་པའི་བག་ཆགས་ལས་བྱུང་བའི་རྟོག་པ་དེས་སྒྲོ་བཏགས་པའི་སྤྱོད་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར།",
    "གལ་ཏེ་སྐྱེས་བུས་མ་བྱས་པའི་ཚིག་ཡིན་ན།",
    "སྐྱེས་བུས་བྱས་པའི་ངག་ཁོ་ན་ལ་ལོག་པའི་དོན་ཅན་ཉིད་མཐོང་བའི་ཕྱིར།",
    "མི་མཐུན་ཕྱོགས་ལ་ཡོད་པར་དོགས་པར་འགྱུར་གྱི།",
    "དེ་ལ་མེད་པར་ངེས་པའི་ཕྱིར་ཏུ་ལྡོག་ན་གནོད་པ་ཅན་གྱི་གཏན་ཚིགས་མ་བསྟན་པའི་ཕྱིར།",
    "ལོག་པའི་དོན་ཅན་ལ་སྐྱེས་བུས་མ་བྱས་པ་མེད་དེ།",
    "སྐྱེས་བུས་བྱས་༡ ༡༦བ་པ་མཐོང་བའི་ཕྱིར་ཅེ་ན།",
    "ལོག་པའི་དོན་ཅན་ལ་མ་བྱས་པའི་ཚིག་མེད་དེ་མ་མཐོང་བའི་ཕྱིར།",
    "ཡོད་པར་ཡང་མ་མཐོང་བའི་ཕྱིར།",
    "གཞུང་འདིས་ཀྱང་ལྡོག་ཁྱབ་ཡོད་པའི་གཞི་དེ་ཉིད་ལ་རྗེས་ཁྱབ་ཡོད་པར་བསྟན་གྱི།",
    "རིག་བྱེད་ཀྱི་སྔགས་སྐྱེས་བུས་མ་བྱས་པ་དགག་པ་དང་།",
    "སྔགས་སྐྱེས་བུས་བྱས་པར་བསྒྲུབ་པ་དང་།",
    "སྐྱེས་བུས་མ་བྱས་པའི་སྒྲུབ་བྱེད་ལྟར་སྣང་དུ་བསྟན་པའོ།",
    "དེ་ལ་མི་ལྟོས་པར་དངོས་པོའི་ནུས་པ་ཡིན་པ་དགག་པའོ།",
    "བརྡ་ལ་མི་ལྟོས་པར་ཡི་གེའི་དངོས་པོའི་ནུས་པ་ཉིད་ལས་ཞི་སོགས་ཀྱི་འབྲས་བུ་འབྱིན་པ་ཡིན་ནོ་ཞེ་ན།",
    "གོ་རིམ་ལོག་པར་སྦྱར་བ་ལས་འབྲས་བུ་མི་འགྲུབ་སྟེ།",
    "ཡི་གེ་ལས་དོན་གཞན་པའི་གོ་རིམ་ཁྱད་པར་ཅན་གྱིས་ཞི་སོཊ་ཀྱི་འབྲས་བུ་འབྱིན་དགོས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "འབྲས་བུ་འབྱིན་པ་ཆོ་ག་བྱས་པ་ལ་བལྟོས་པ་ཡིན་ནོ་ཞེ་ན།",
    "བརྡ་ལ་མི་ལྟོས་པར་ཡི་གེའི་དངོས་པོའི་ནུས་པ་ཁོ་ན་ལས་དེ་ལྟར་འབྲས་བུ་འབྱིན་པའི་ཕྱིར།",
    "རྐྱེན་གྱིས་ལེགས་པར་བྱས་པ་མིན་པའི་ཕྱིར།",
    "འབྲས་བུའི་ཁྱད་པར་འབྱིན་པ་རིགས་བཟང་ངན་ཙམ་གྱིས་བསྒྱུར་ནུས་པ་མ་ཡིན་གྱི།",
    "༡ ༡ ༨ན་རིགས་བཟང་ངན་ཡང་བརྡ་ལ་མི་ལྟོས་པར་ངོ་བོ་ཉིད་ཀྱིས་སོ་སོར་མ་ངེས་པ་ཡིན་ཏེ།",
    "སྐྱེས་བུ་ཁྱད་པར་ཅན་གྱིས་བརྡ་ཇི་ལྟར་བྱས་པ་བཞིན་དུ་ཞི་སོགས་ཀྱི་འབྲས་བུ་འབྱིན་པའི་ཕྱིར།",
    "སྔགས་རྐྱེན་གྱིས་ཁྱད་པར་བྱར་མེད་པ་ཅན་ཡིན་པའི་ཕྱིར།",
    "གསལ་བ་དེ་ནི་དུག་ཞི་བ་སོགས་ཀྱི་འབྲས་བུ་འབྱིན་པར་སྦྱོར་བ་ཡིན་ནོ་ཞེ་ན།",
    "ཡིད་ལ་ཤར་བའི་སྤྱིའི་རང་བཞིན་རྣམས་སོ་སོར་མ་ཕྱེ་བར་སྤྱིར་ཞི་སོཊ་ཀྱི་འབྲས་བུ་འབྱིན་པའི་ངོ་བོ་གཅིག་ཏུ་བརྗོད་པར་འདོད་པས་ཀུན་ནས་བསླངས་ནས་བརྡ་བརྗོད་པའི་ཕྱིར།",
    "ས་ར་ཞེས་པ་ལས་མཚོ་གོ་བའི་འབྲས་བུ་ཐ་དད་མེད་པར་འགྱུར་ཏེ།",
    "ཡི་གེ་དེ་གཉིས་ཀྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་པའི་ཕྱིར།",
    "དེ་སྐྱེས་བུས་བྱས་པར་སྒྲུབ།",
    "མ་བྱས་པ་དགག་པའོ།",
    "ཡི་གེ་སྔ་ཕྱི་དེའི་ཁྱད་པར་ཅན་གྱི་ཡི་གེ་དེ་དག་ནི།",
    "རང་འཛིན་རྣ་བའི་ཤེས་པས་གཟུང་དོན་དུ་བྱས་ནས་རིམ་ཅན་དུ་ངེས་པར་འགྱུར་བ་ཡིན་པའི་ཕྱིར།",
    "ཉན་ཤེས་སྔ་མ་སྔ་མ་དེས་བསྐྱེད་པའི་ཉན་ཤེས་ཀྱི་ཡུལ་དུ་ཡོད་པ་ཅན་གྱི་ཡི་གེ་དེ་དག་ཐོས་པ་མྱུར་མིན་དལ་བུས་ཐོས་པར།",
    "སྔ་མ་དེ་དྲན་པ་ལ་བལྟོས་ནས་ཕྱིས་ཕྱི་མའི་བདག་ཉིད་ལ་དྲན་པ་བསྐྱེད་པར་བྱེད་པའི་ཕྱིར།",
    "ཚོགས་རྒྱུན་ལེགས་པར་འཇོག་མ་ཤེས་པས་ནོངས་པའི་ལྟག་ཆོད་འབའ་ཞིག་ཡིན་ནོ།",
    "དེ་སྐྱེས་བུས་བྱས་པའི་ཕྱིར།",
    "སྐྱེས་བུས་བྱས་པའི་དཔེའོ།",
    "སྐྱེས་བུའི་འདོད་པ་དང་མི་འགལ་བར་གྲུབ་པ་ཅན་གྱི་གོ་རིམ་ཡིན་ན་རྟག་པར་གནས་པ་འགལ་བའི་ཕྱིར་རོ།",
    "འདུས་མ་བྱས་སུ་མི་འཐད་པར་མ་ཟད།",
    "བྱེད་པ་པོའི་སྐྱེས་བུ་ཁྱད་པར་ཅན་ཡོད་པར་བསྒྲུབ་པ་ནི།",
    "དེའི་གསང་སྔགས་འགའ་ཞིག་བྱེད་པར་འགྱུར་བ་ལས།",
    "སྐྱེས་བུ་ཁྱད་པར་ཅན་མེད་ན་དོན་ངེས་༡༢བ་འདོད་པ་འགལ་བའོ།",
    "སྐྱེས་བུ་ཁྱད་པར་ཅན་སྒྲུབ་པའི་རིགས་པ་འདི་ཉིད་ཀྱིས་ནི་བསལ་བ་ཡིན་ཏེ།",
    "འདིས་སྐྱེས་བུ་ཁྱད་པར་ཅན་ཡོད་པར་གྲུབ་པའི་ཕྱིར།",
    "ཁྱད་པར་ཅན་སྤོང་བའི་སྒྲུབ་བྱེད་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ཁོ་བོས་དོན་འདི་བརྗོད་པར་བྱེད་པས་ཟུང་ཞིག།",
    "འདི་ཁོ་བོའི་དོན་མིན་ཞེས་བརྗོད་པར་མི་བྱེད་པའི་ཕྱིར།",
    "གཞན་གྱིས་མིན་པའི་ཁྱད་པར་ཡང་ནི་སུ་ཡིས་ཀྱང་བྱས་པ་མི་འཐད་པའི་ཕྱིར།",
    "སྐྱེས་བུ་ཁྱད་པར་ཅན་སྤོང་བའི་སྒྲུབ་བྱེད་མཐུན་དཔེ་མཐོང་ཙམ་གྱིས་འགོད་པ་ལྟར།",
    "དོན་ལུང་ལ་བལྟོས་པ་མེད་པར་མངོན་སུམ་གྱིས་ཤེས་སྲིད་པའི་ཕྱིར།",
    "གལ་ཏེ་དེའི་དོན་དེ་ཁོ་ན་ལ་འཇུག་པར་གྲགས་པ་ལས་བརྒལ་ནས།",
    "ཁྱི་ཤ་ཟ་བ་ལ་འཇུག་པར་རྟོག་པ་ལ་རྒྱུ་ཅི་ཡོད་ཅེ་ན།",
    "འཇིག་རྟེན་གྱི་གྲགས་པ་ཉིད་ཀྱིས་༡༢༢བ་སྒྲའི་དོན་ངེས་པར་འདོད་པ་ལ་དགོས་པ་བསྐྱེད་པར་བྱེད་དེ།",
    "སྐྱེས་བུ་གཞན་གྱིས་གང་ལ་ཡང་མ་བསྙད་པར་བདག་ཉིད་ཀྱིས་ལམ་གཡས་མ་འདི་ཡིན་ཞེས་སྨྲ་བ་གཉིས།",
    "རིག་བྱེད་ལ་བརྡ་ལ་མ་ལྟོས་པར་ངོ་བོ་ཉིད་ཀྱིས་དོན་མཐའ་གཅིག་ཏུ་ངེས་པ་སྟོན་པའི་ནུས་པ་མེད་པའི་ཕྱིར།",
    "བརྗོད་འདོད་ཀྱིས་བཞག་པའི་དོན་གྱི་ངེས་པ་མ་གཏོཊ་པར།",
    "སྐྱེས་བུས་མ་བྱས་པ་ལ་རྒྱུ་དེ་མེད་པ་དང་།",
    "དོན་སོ་སོར་ངེས་པའི་རྒྱུ་དེ་ནི་སྐྱེས་བུས་བྱས་པ་མིན་པ་ལ་མེད་པའི་ཕྱིར།",
    "བརྡ་ལ་མི་ལྟོས་པར་རང་བཞིན་གྱི་དོན་སོ་སོར་ངེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "བརྡ་ལས་རྗོད་བྱེད་རྣམས་རང་བཞིན་གྱིས་དོན་ལ་འབྲེལ་བའི་ཁྱད་པར་གསལ་བར་བྱེད་པས་དོན་མེད་མིན་ནོ་ཞེ་ན།",
    "རྟགས་རིམ་པ་བཞིན་དུ་དངོས་པོ་རྣམས་རྟག་པར་བསྟན་པའི་ཕྱིར་དང་།",
    "ལུང་ལ་བལྟོས་པའི་རྗེས་དཔག་དང་འགལ་བ་བརྗོད་པར་བྱེད་པའི་ཕྱིར།",
    "དེས་ན་བསྐལ་དོན་མ་དམིགས་པས་མེད་ངེས་སུ་མི་འགྲུབ་པར་གྲུབ་པ་ནི།",
    "བློ་ལ་སོགས་པའི་མངོན་གྱུར་གྱི་གནས་རྣམས་ལ་དཔྱད་པ་ལེགས་པར་དག་ཅིང་།",
    "རང་ཚིག་འགལ་བ་སོགས་མེད་པའི་དཔྱད་པ་དག་ནས་ཤིན་ཏུ་ལྐོག་གྱུར་གྱི་དོན་ལ་མི་སླུ་བར་རྗེས་སུ་དཔོག་པར་བྱེད་པ་ཡིན་གྱི།",
    "རང་དོན་རྗེས་དཔག་གཏན་ལ་འབེབས་པའི་ཡན་ལག་ཏུ་ཚུལ་གསུམ་ངེས་བྱེད་ཀྱི་ཐབས་རྒྱས་པར་གཏན་ལ་ཕབ་ལ།",
    "དེ་ཇི་ལྟ་བ་བཞིན་མི་རྟོགས་པའི་རྒྱུ་ཡང་སྒྲ་རྟོག་སེལ་བས་འཇུག་པའི་ཚུལ་ཕྱིན་ཅི་མ་ལོག་པར་མ་རྟོགས་པ་ལས་ཡིན་པཔས།",
    "དེ་ལ་སེལ་བའི་རྣམ་དབྱེ་མ་ཤེས་ན་སྒྲོ་འདོགས་མ་ཆོད་པ་ལ་ཆོད་སྙམ་པ་དང་བཅད་མི་དགོས་པ་ལ་དགོས་སོ་སྙམ་དུ་ཕྱིན་ཅི་ལོག་ཏུ་ཞེན་པས་དོན་ཆེན་པོ་ལས་ཉམས་པར་འགྱུར་བས་དེ་བཟློག་པའི་དོན་དུ་ཡང་མཛད་དོ།",
    "དེ་ནས་ཕྱིར་རྒོལ་གྱིས་མངོན་རྗེས་ཀྱིས་མ་དམིགས་པས་མེད་པར་མི་འགྲུབ་ཀྱང་།",
    "ལུང་དེ་ཡང་སྐྱེས་བུས་མ་བྱས་པ་ལ་རྣམ་པ་ཀུན་ཏུ་མི་རུང་སྟེ།",
    "དེས་སྨྲས་པའི་ཚིག་ལ་བརྟགས་ནས་དཔྱད་པ་ལེགས་པར་དག་ན་ཁས་ལེན་པ་ཡིན་གྱི།",
    "ཞེས་ཤེས་པར་བྱ་བའི་དོན་དུ་མཛད་དོ།",
    "བདག་ལ་སོགས་པའི་རྟག་པ་འགས་འབྲས་བུ་བྱེད་པར་སྨྲ་བའི་ཕྱིར་དང་།",
    "འགྲོ་བ་ལ་མཐའ་གཅིག་ཏུ་ཕན་པར་བཞེད་པའི་ཐུགས་རྗེ་ཆེན་པོ་ཡིན་ལ།",
    "བདག་མེད་རྟོགས་པའི་ཤེས་རབ་གཞན་གྱི་དོན་དུ་གོམས་པར་བྱེད་པའི་སྟོན་པའོ།",
    "དང་པོ་གཏན་ལ་དབབ་བྱ་ཁྱད་པར་གྱི་གཞི་དང་།",
    "ཅེས་པ་ལྟ་བུའི་ཀུན་མཁྱེན་ཤེས་བྱེད་ཀྱི་རྒྱུ་ཡང་མེད་དོ།",
    "སྦྱོར་བ་ཕུན་ཚོགས་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་གཞན་དོན་དུ་གོམས་པར་བྱེད་པ་ནི་སྤྱོད་པའི་གཙོ་བོ་ཡིན་ལ།",
    "ལམ་དེ་ནས་ཚུལ་ཇི་ལྟར་བྱོན་པའི་ཤེས་བྱེད་ཡང་དག་སྟོན་པར་མཛད་དོ།",
    "བསྟན་པ་སྐྱོན་མེད་པར་སྒྲུབ་པའི་སྒོ་ནས།",
    "འོན་ཏེ་མ་ཡིན་ཞེས་རྣམ་པར་དཔྱད་པ་ན།",
    "ཐུབ་པའང་མཚན་ཉིད་དེ་དང་ལྡན་པར་བསྟན་པའོ།",
    "ཁྱད་པར་རོ།",
    "མའི་མཚན་ཉིད་མ་ཞུགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གཞུང་སྔ་མའི་དོན་ཡང་སྒྲ་བྱུང་ཕྱི་མ་དང་མཐུན་པར་སྦྱར་རོ།",
    "དེ་ཡང་གཞན་ལ་བལྟོས་ས་ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྒྱང་འཕེན་གྱི་རྒྱུད་ཀྱི་རྗེས་དཔག་རང་ལས་ངེས་མ་ཡིན་པར་འགྱུར་རོ།",
    "མཚན་ཉིད་མི་སླུ་བ་རང་སྟོབས་ཀྱིས་ངེས་མི་ངེས་ལས་རྣམ་པར་འབྱེད་ན་སྐུ་བ།",
    "རྒྱང་འཕེན་གྱི་རྒྱུད་ཀྱི་རྗེས་དཔག་རང་ངེས་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེ་བསླུ་བས་ཁྱབ་པར་འདོད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "འོ་ན་རྗེས་དཔག་ལ་རང་ངེས་ཀྱིས་མ་ཁྱབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཇི་ལྟར་རྟོགས་པའི་དོན་ཐོབ་པ་ལ་རང་སྟོབས་ཀྱིས་ངེས་པ་དྲངས་པའི་ཕྱིར་མི་སླུ་བའི་དོན་ལེགས་པར་གྲུབ་བོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་བཀའ་ཉིད་ལ་སྦྱར་རོ།",
    "གསར་དུ་མི་སླུ་བ་ཞེས་པའི་ཁྱད་པར་བསྟན་པ་ཡིན་ནོ།",
    "སྔ་མས་ཀྱང་དོན་དམ་པའི་མཚན་ཉིད་བསྟན་པར་འགྱུར་ཏེ།",
    "འོ་ན་ཕྱི་རོལ་གྱི་དོན་ལ་སོགས་པ་གསུངས་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "གསར་དུ་རྟོགས་པར་བྱར་མེད་པའི་ཕྱིར།",
    "ཤེས་སྒྲིབ་མ་ཟད་པར་འགྱུར་ལ།",
    "དང་པོའམ་གསར་དུ་མི་སླུ་བ་ཞེས་པའི་ཁྱད་པར་དོན་མེད་པར་འགྱུར་ཞིང་།",
    "རྣམ་མཁྱེན་སྐད་ཅིག་དང་པོའི་རྗེས་དེ་མ་ཐག།",
    "རྣམ་མཁྱེན་སྐད་ཅིག་གཉིས་པ་དེ་གསར་དུ་སྐྱེས་སམ་མ་སྐྱེས།",
    "རྟག་པར་ཁས་ལེན་དགོས་པར་འགྱུར་ལ།",
    "གཉིས་པ་ཕན་ཆད་རྣམ་མཁྱེན་སྐད་ཅིག་དང་པོ་དེས་འབྱུང་འགྱུར་དུ་རྟོགས་པས།",
    "ཡང་རྟོགས་པར་བྱར་མེད་དོ་ཞེ་ན།",
    "རྣམ་མཁྱེན་སྐད་ཅིག་དང་པོ་སྐྱེས་ཕྱིན་ཆད་ཤེས་བྱ་གསར་ཡོད་མི་སྲིད་ན།",
    "དངོས་པོ་གང་ཡིན་རྟག་པར་འགྱུར་ལ།",
    "རྣམ་མཁྱེན་༡༣༣བ་སྐད་ཅིག་དང་པོའི་ཁྱད་པར་དོན་མེད་ལ།",
    "དེ་གསར་རྟོགས་རྣམ་མཁྱེན་སྐད་ཅིག་གཉིས་པ་ཕན་ཆད་དུ་ངེས་པར་ཁས་ལེན་དགོས་སོ།",
    "བྱུང་ཟིན་དང་འབྱུང་འགྱུར་ཐམས་ཅད་དེའི་རྒྱུ་འབྲས་སུ་ཤུགས་ལ་རྟོགས་མི་ནུས་པའི་ཀུན་མཁྱེན་མི་སྲིད་པས།",
    "སྐད་ཅིག་གཉིས་པ་ཕན་ཆད་ལ་གཞལ་བྱ་གསར་རྟོགས་མི་སྲིད་པར་ཁས་ལེན་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ཉིད་བྱུང་ཟིན་སྐད་ཅིག་གཉིས་པ་ཕན་ཆད་དུ་གསར་དུ་རྟོགས་པར་བྱར་ཡོད་དོ།",
    "འོ་ན་གང་ཟག་དེའི་༡ ༣༤ན་རྒྱུད་ལ་སྔར་བྱུང་མ་ཟིན་པའི་བྱུང་ཟིན་ཕྱིས་ཡོད་དགོས་པས་དེ་ལ་གསར་རྟོགས་ཡོད་པར་འགྱུར་ལ།",
    "དེས་མཚོན་ནས་གཞན་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "དེར་གྱུར་པ་ཉིད་གསུངས་པའི་ཕྱིར།",
    "མཁྱེན་ཡིན་པ་དགག་པ་དང་།",
    "ཐམས་ཅད་ཀྱི་གནས་ལུགས་ཇི་ལྟར་གནས་པ་མངོན་སུམ་དུ་ཤེས་པ་ཀུན་མཁྱེན་དུ་བསྒྲུབ་པའོ།",
    "འཛིན་པར་འགྱུར་རོ།",
    "སྟེའུ་བཞིན་དབྱིབས་ཀྱི་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར།",
    "བློ་སྔོན་དུ་བཏང་ནས་བྱེད་པ་པོ་ཡོད་པར་གྲུབ་ལ།",
    "དེའི་དངོས་རྒྱུ་ལ་རིམ་ཅན་ཡོད་པར་གྲུབ་བོ།",
    "ཅེས་པའི་རྟགས་ལས་དེ་དག་སྐྱེས་བུས་བྱས་པར་རྗེས་སུ་དཔོག་རིགས་པ་མ་ཡིན་ཏེ།",
    "དབྱིབས་ཞེས་པའི་སྒྲ་འཇུག་པར་མཚུངས་པས་སོ།",
    "རྟགས་སུ་བཀོད་པའི་སྤྱི་དང་ཁྱད་པར་ལ་བརྟགས་ནས་སྐྱོན་བརྗོད་པ་འབྲས་མཚུངས་ཀྱི་ལྟག་ཆོད་ཡིན་ཏེ།",
    "ཁྱད་པར་ལ་བརྟགས་ནས་སུན་འབྱིན་ན།",
    "རིགས་པ་ཅན་པས་ཁྱད་པར་ལ་བརྟགས་ནས་སྐྱོན་བརྗོད་པ་འབྲས་མཚུངས་ཀྱི་ལྟག་ཆོད་ཡིན་པ་རྐང་མིག་པ་འདོད་ཅིང་སློབ་དཔོན་ཡང་བཞེད་དོ།",
    "ཁྱད་པར་ལ་བརྟགས་ནས་སུན་འབྱིན་བརྗོད་པ་ནི།",
    "སྔར་ཡོད་རྩོལ་བས་གསལ་བའི་འབྲས་བུ་ཡིན་ཞེས་བརྟག་པ་བྱེད་པ་དང་མཚུངས་པར་བརྟག་པ་འཇུག་གོ།",
    "དེ་བཞིན་དུ་སྒྲ་མི་རྟག་སྒྲུབ་ལ་བྱས་པ་རྟཊ་སུ་བཀོད་པ་ལ་ཡང་།",
    "བུམ་པའི་བྱས་པ་འགོད་ན་མ་གྲུབ་པ་དང་།",
    "དབྱིབས་དང་ལྡན་པའི་རིགས་ཀྱི་ཁྱད་པར་བུམ་པ་སོགས་ལ།",
    "གཅེར་བུ་བ་ལ་སོགས་ཀྱི་སྒྲུབ་བྱེད་ལྟར་སྣང་གཞན་ཡང་དཔྱད་པ་བྱས་ནས་འགོག་ནུས་པ་ཡིན་ཏེ།",
    "གཏན་ཚིགས་ལ་ངོ་བོ་དང་ཁྱད་པར་གཉིས་ལ་ངོ་བོ་གཙོ་སྟེ།",
    "བྱས་པའི་ངོ་བོ་སྒྲའི་སྟེང་དུ་འགོད་ཚུལ་དང་མཐུན་པར་གྲུབ་པ་ན།",
    "ཁྱད་པར་ནམ་མཁའི་ཡོན་ཏན་དང་དོན་གཅིག་ལ་འདུ་བའི་བྱས་པ་སྒྲ་ཡི་སྟེང་དུ་མ་གྲུབ་ཀྱང་གནོད་བྱེད་མ་ཡིན་པ་བཞིན།",
    "ཡང་ན་སྒྲ་ཡི་སྟེང་དུ་གྲུབ་ན་ཁྱད་པར་ནམ་མཁའ་ལ་བརྟེན་པའི་སྒྲ་ལ་མ་གྲུབ་ཀྱང་གནོད་བྱེད་མིན་པ་བཞིན།",
    "ལུས་ཅན་གྱི་སྒྲ་འཇུག་པར་འདོད་ལ།",
    "སྒྲ་ནི་འཁྲུལ་པ་མེད་ན་ཡང་སྒྲུབ་བྱེད་སྐྱོན་ལྡན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "ཞིང་དེ་ལྷག་པར་རྨོ་བ་སོགས་སོ་ནམ་ལེགས་པར་བྱས་པ་ན།",
    "སྟོན་ཐོག་དེ་ཡི་ཁྱད་པར་ཕུལ་དུ་བྱུང་བ་མཐོང་བའི་ཕྱིར།",
    "དེས་ན་རྐྱེན་གསུམ་ཚོགས་མ་ཚོགས་ལ་ཁྱད་པར་གྲུབ་པ་ཡིན་ཏེ།",
    "གང་བསྒོམས་པས་ཀུན་མཁྱེན་དུ་འགྱུར་བའི་སྒྲུབ་བྱེད་ཀྱི་ཐབས་ཅུང་ཟད་ཀྱང་མེད་པའི་ཕྱིར།",
    "དེ་འདྲའི་ཀུན་མཁྱེན་ཡོད་པ་རྟགས་ལས་མི་ཤེས་ཏེ།",
    "མངོན་སུམ་གྱིས་གྲུབ་ན་ཡང་དེ་ཉིད་ཀུན་མཁྱེན་དུ་འགྱུར་རོ།",
    "འདིས་ཤེས་བྱ་ཐམས་ཅད་ཤེས་སོ་ཞེས་ངེས་མི་ནུས་པས་ཀུན་མཁྱེན་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་དང་།",
    "ཀུན་མཁྱེན་༡ ༤བ་ངོས་གཟུང་བའོ།",
    "ཕནཐབས་མི་ཤེས་བཞིན་དུ་སྟོན་པར་བྱེད་པའི་གང་ཟག་འགའ་ཞིག་ལ་སྟོན་པར་གཟུང་ནས།",
    "དེ་མཁྱེན་པའི་ཡེ་ཤེས་ཡོད་མེད་རྣམ་པར་དཔྱད་པར་བྱ་ཡི།",
    "སྲིན་བུའི་གྲངས་མ་ལུས་པ་མཁྱེན་པ་ཡིན་མིན་ཐོག་མར་དཔྱད་པར་མི་བྱ་སྟེ།",
    "གྲོལ་བ་དོན་གཉེར་ངེད་ལ་སྲིན་བུའི་གྲངས་མ་ལུས་པ་མཁྱེན་པ།",
    "དེ་ལྟར་དཔྱད་པའི་ཚེ་སྟོན་པར་འཛིན་པའི་སྔོན་དུ་དེ་ལ་བྱང་གྲོལ་གྱི་ལམ་མཁྱེན་པའི་ཡོན་ཏན་ཡོད་པར་ཤེས་སམ་མི་ཤེས།",
    "མི་ཤེས་ན་བསྟེན་པར་བྱ་བ་དང་།",
    "བསྟེན་པར་བྱ་བ་མ་ཡིན་པའི་རྣམ་དབྱེ་མི་བྱེད་པར།",
    "ཐོག་མར་གང་ཕྲད་པ་དེ་བསྟེན་པར་རིགས་སོ་ཞེ་ན།",
    "གྲཊ་པ་སོགས་ལས་ཀྱང་ཕྱོགས་ཙམ་རྟོགས་པར་འགྱུར་རོ།",
    "སྲིན་བུའི་གྲངས་ཐམས་ཅད་རིག་པར་མཛད་པ་ཙམ་གྱིས་གྲོལ་བ་དོན་གཉེར་གྱི་འདོད་པ་རྫོགས་པ་མ་ཡིན་ཏེ།",
    "མིན་ཡང་རུང་གྲོལ་བ་དོན་གཉེར་གྱི་སྟོན་པར་རིགས་ཏེ།",
    "གཞན་དག་ཐམས་ཅད་བཟོ་ཤེས་པ་ཀུན་མཁྱེན་གྱི་དོན་དུ་འདོད་པ།",
    "ཀུན་མཁྱེན་གྱི་ཐ་སྙད་འཇིག་རྟེན་ན་བརྗོད་པ་ལྟར་རོ།",
    "རིགས་པ་མཁྱེན་པས་ཐམས་ཅད་ཀྱི་བྱེད་པ་པོ་ཀུན་མཁྱེན་ཡིན་ན།",
    "ངན་འགྲོའི་སྡུག་བསྔལ་༡༤༡ལ་སོཊ་པ་ཡང་དེས་བྱས་པས།",
    "དེའི་རྗེས་སུ་སྡུག་བསྔལ་ཞི་བའི་ཐབས་ལ་གོམས་པར་བྱས་པ་ལས་སྟོན་པར་འགྱུར་དགོས་པའི་ཕྱིར།",
    "སྐྱོབ་པ་རྟགས་ཀྱི་བསྒྲུབ་བྱར་བྱས་ནས་དེ་བསྒྲུབ་པ་ལ་ཡང་།",
    "ཐོག་མར་འདི་གྲུབ་དགོས་པའི་ཚུལ་ནི་འོག་ཏུ་འཆད་པར་འགྱུར་རོ།",
    "བདེན་བཞིའི་གནས་ལུགས་རྟོགས་པ་མཐར་ཐུག་པར་འགྱུར་བའི་ཚུལ་བསྒྲུབ་པ་ལས་ཀུན་མཁྱེན་འགྲུབ་པས་ཕྱི་མའི་མངོན་མཐོ་ཙམ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པ་དངོས་པོ་སྟོབས་ཞུགས་ཀྱི་རིགས་པས་གྲུབ་པའི་ཚུལ་ལེའུ་འདིར་རྒྱས་པར་སྟོན་པ་ཡིན་ནོ།",
    "མངོན་མཐོའི་ཁྱད་པར་འདོད་པའི་ལྷ་དང་།",
    "ཚངས་པ་ལ་སོགས་པ་འགའ་ཞིག་ནི་ཤིན་ཏུ་ལྐོག་ཏུ་གྱུར་པས་ལུང་ལ་བརྟེན་ནས་རྗེས་སུ་དཔོག་པར་བྱེད་པ་ཡིན་ལ།",
