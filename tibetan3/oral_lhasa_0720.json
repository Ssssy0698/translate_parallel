    "སློབ་ཕྲུག་དཔར་ཡིག་འབྲི་མཁན།",
    "དཔར་རྐོ་བ།",
    "འབྲུ་མ་བརྒྱུཁལ་གཅིག་དང་ཞོ་གང་ལ་ཇ་སྦག་ཆུང་གཅིག་ས་སྔ་འབྲུ་ཁལ་ལྔ་ལ་ཇ་སྦག་ཆེན་གཅིག་དེ་ལ་སྦག་ཆུང་བཞི་ཡོད་འབྲུ་ཁལ་ཉི་ཤུ་ཐམ་པར་ཇ་འཁོར་དྲུག་གཅིག་དེ་ལ་སྦག་ཆེན་བཞི་ཡོད་བཅས་རྩི་བ་ནི་སྐབས་དེའི་འབྲུ་དང་ཇ་གཉིས་ཀྱི་རིན་མཉམ་ཚད་གཞི་ཡིན།",
    "པར་བརྐུས་པ།",
    "མ་ལྡང་བ་རྣམས་ཕོ་ལྷ་བ་རང་ཉིད་སྒེར་གྱིས་ཁ་གསབ་བྱས་ཡོད།",
    "དཔར་ཡིག་འབྲི་གཞིའི་ཤོག་བུའི་ཐོན་ཁུངས་ནི།",
    "དེ་ལ་ཡང་དུག་ཤོག་དང་ཤིང་ཤོག་རིགས་གཉིས་ཡོད་པའི་ནང་ནས་དུག་ཤོག་ལ་ཡི་གེ་བྲིས་ན་མིག་ལ་གནོད་པར་བརྟེན།",
    "དཔར་ཡིག་འབྲི་གཞིའི་ཤོག་བུ་ནི་དུག་ཤོག་མ་འདྲེས་པའི་ཤིང་ཤོག་གཙང་མ་སྲབ་མཐུག་སྙོམས་ལ་འཇམ་པོ་ཡོད་པ་ཞིག་དགོས་ཤིང་དེ་ལྟར་བྱུང་ན་དཔར་ཡིག་འབྲི་མཁན་གྱི་མིག་ལ་མི་གནོད་པ་དང་།",
    "དཔར་ཡིག་འབྲི་བྱེད་སྣག་ཚ་ནི།",
    "གཞན་ཡང་སྣག་ཚའི་རྒྱུ་དང་དཔར་ཤིང་གས་སྡོམ་ལ་དགོས་པའི་ཀོ་སྤྲིནསྦྱར་བཅས་ཡིན།",
    "དཔར་ཤིང་འདུལ་སྦྱོང་སྐབས་དཔར་ཤིང་ལ་བྱུགས་རྒྱུའི་སྣུམ།",
    "ནི་བྲེ་ཁ་༥༩ ༡༨པར་ཡིག་འབྲི་བྱེད་ཤོག་བུ།",
    "༦༡༡ས་སྣག་ཚའི་རྒྱུ་སྒྲོན་དྲེག་༥༨༢པར་རྐོའི་ལག་ཆ་བཟོ་བྱེད་ལྕགས།",
    "སནྣཔརྨཧམ་པས་འཇམ་བརྡར་འོལ་ཁོག་སྤུས་ལེགས།",
    "ནམས་ལགས་ད་༤༨༩༩སོལ་བ་སྤུས་ལེགས་འདེགས།",
    "གས་པས་དབལ་པར་ཤིང་སྟག་སྤང་སྤུས་ལེགས།",
    "ངོ་གྲངས་བམ་རྩམ་པར་གསར་དད་དགོས་ཆ་ཉོ་རིན་དངུལ་སྲང་༦ ༢༥༦༧ ལས་མ་ཀ་སཀ་ཀོ་དེང་རབས་བོད་རིག་པའི་སྐོར་གྱི་དཔྱད་རྩོམ་གཅེས་བཏུས།",
    "པར་ཡིག་འབྲི་བྱེད་ཤོག་བུ་ཉིན་བྲེ་ག་༡༨༨༤།",
    "༡༩༡ན་བསྣག་ཚའི་རྒྱུ་སྒྲོན་དྲེག་༡༡་རྣམ་པར་རྐོའི་ལག་ཆ་བཟོ་བྱེད་ལྕགས།",
    "༡༥༣༩རཔོ་པར་ཤིང་སྟག་སྤང་སྤུས་ལེགས།",
    "བས་ས་པར་ཤུབས་བཟོ་བྱེད་སྣམ་བུ་དཀར་པོ།",
    "དཔར་ཤིང་བཅས་རིན་སྤྲད་ནས་ཉོས་པ་དང་།",
    "ཞུ་དག་པ་རིམ་པ་གསུམ་དང་པར་ཞུས་པའི་གླ་བསྡོམས།",
    "པར་ཡིག་འབྲི་མིའི་གླུ་བསྡོམས།",
    "༡༩༤༥༥སག་ཁ་པར་ག་སར་གཏོད་ལས་ས་བལཀ་༣་བའ་ཤོག་བུའི་རིན་བསྡོམས།",
    "དཔར་གཞི་གསར་སྐྲུན་བྱས་རྗེས་བཙུནཚོང་ལས་བྱེད་རྒྱུའི་བསམ་བློ་བཏང་ཚེ།",
    "དཔར་གཞི་གསར་སྐྲུན་གྱི་སྦྱིན་བདག་མང་ཆེ་བ་ནི་སྒེར་པ་འབྱོར་ལྡན་ཁག་ཡིན་པས།",
    "བརྔན་པ་སོགས་རང་ཉིད་དང་ཉེ་འབྲེལ་སྤུན་མཆེད་བུ་ཕྲུག་བཅས་ཀྱི་ལྟོ་གོས་སྡོད་གནས་སོགས་ཀྱི་ཆེད་དུ་བེད་སྤྱོད་བཏང་ན་ཉེས་དམིགས་ཤིན་ཏུ་ཆེ་བར་གསུངས་ཡོད་པར་བརྟེན།",
    "ཡོང་འབབ་དེ་རྣམས་དཔར་ཤིང་དང་།",
    "དཔར་པ་ལས་བཟོ་ཚོས་ལས་གྲྭ་ཚུགས་རིང་རྒྱུགས་རང་འཁུར་བྱས་ཏེ་ཡོང་རྒྱུ་ཡིན་སྟབས་དཔར་གླ་ལེན་སྐབས་གླ་ལྟོ་ཆབས་སྒྲིལ་གྱིས་རྩིས་རྒྱག་སྤྲོད་ལེན་བྱེད་པ་དེ་ཚོ་པས་པ་། འཚོལ་ཞིབ་དང་མཐའ་དཔྱོད།",
    "ནི་དཔར་པ་ཚོའི་ཡོང་འབབ་ཡིན།",
    "དཔར་གྲངས་ཇི་ཙམ་ཉུང་བ་དེ་ཙམ་གྱིས་མ་གནས་མཐོ་ལ་གྱོང་གུན་ཆེ་བ་ཡོད་སྟབས།",
    "དཔར་འདེབས་འགྲེམ་ཚོང་བྱས་པའི་རིན་འབབ་དེང་སང་སྒོར་བརྒྱད་སྟོང་ལྷག་ཙམ་ཟིན་གྱི་ཡོད་པ་དེ་རྣམས་ཀྱང་ལས་བཟོའི་གླ་ཕོགས་དང་།",
    "གཞན་ཡང་དེ་སྔ་ཤོག་ངོས་རྒྱབ་མདུན་གཉིས་ཀར་ཤོག་རོ་མེད་ཅིང་འཇམ་ཤ་དོད་པའི་དཔར་ཤོག་བེད་སྤྱོད་གཏོང་དགོས་པ་ལས།",
    "༤༤པའ་དཔར་འདེབས་བྱས་ན་དཔར་ཤིང་ཟད་གྲོན་ཆེ་སྟབས།",
    "ར་ཆ་རྒྱུ་ད་དཔར་འདེབས་སྣག་ཚ་ནི་བོད་ནས་ཐོན་པའི་སྒྲོན་དྲེག་བཏུལ་མའི་སྣག་ཚ་དང་།",
    "ད་ཕན་ལོ་ངོ་བཅུའི་རིང་ལ་ཡང་མུ་མཐུད་དཔར་འདེབས་བྱས་ཡོད་པ་དང་།",
    "གོང་གསལ་གྱི་གནས་ཚུལ་དེའི་ཐོག་ནས་དཔར་ཤིང་ཐོག་དཔར་རྐོ་བྱེད་པའི་དཔེ་སྐྲུན་བྱ་གཞག་དེར་རྗེས་ལུས་ཀྱི་ཕྱོགས་དང་སྐྱོན་ཆ་མི་ཉུང་བ་ཞིག་ལྡན་པ་སྨོས་མེད་ཀྱང་དེ་ནི་ལས་དོན་དངོས་ཀྱི་ནང་ལེགས་བཅོས་གཏོང་ཐུབ་པ་ཞིག་ཡིན་པ་མ་ཟད།",
    "ཚེ་༤ དཔར་འདེབས་བྱེད་པའི་ཁ་གྲངས་ཉུང་མཐར་ཁྲི་གསུམ་ལོན་ཐུབ་པ་བཅས་ཡིན།",
    "གབས་དཔེ་གཟུགས་གང་འདོད་ལྟར་ཉོས་ཆོག་པས་དཔར་ཁང་ཕན་ཚུན་བར་དུ་གཞོགས་འདེགས་ཀྱི་རབང་མཉམ་ལས་ཡག་པོ་ཡོང་ཐུབ་པ་མ་ཟད།",
    "དཔེ་གཟུགས་དཔེ་སྐྲུན་གྱི་སྤུས་ཚད་ལེགས་པོ་གཉིས་ཕན་ཚུན་འགྲན་སྡུར་བྱས་པ་བརྒྱུད།",
    "གསུང་རྩོམ་འདིའི་བརྗོད་བྱ་བོད་ཡིག་དཔེ་རྙིང་པར་སྐྲུན་གྱི་དགེ་མཚན་དང་ཉམས་མྱོང་།",
    "པར་སྐྲུན་བྱེད་པའི་ལས་ཡུན།",
    "པར་སྐྲུན་གྱི་ལས་རིགས་རྣམ་གྲངས།",
    "པར་སྐྲུན་ལག་རྩལ།",
    "པར་སྐྲུན་གྱི་དགོས་ཆའི་འགྲོ་གྲོན།",
    "པར་ཤིང་བེད་སྤྱོད་ཀྱི་དུས་ཡུན།",
