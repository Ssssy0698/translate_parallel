    "ད་སྒོས་སྤུ་བོའི་ཡུལ་ནས་བྱོན་པའི་བོད་ཀྱི་རྒྱལ་པོ་དེ་ལ་མཚན་སྤུ་རྒྱལ་ཞེས་ཐོགས་པར་གོ་དོན་གཞན་དག་མང་པོ་འཚོལ་བའི་དགོས་པ་མ་མཐོང་ཞིང་།",
    "མ་ཎི་བཀའ་འབུམ་ཤིང་པར་སྟོད་ཆའི་ཤོག་གྲངས་བདུན།",
    "འ་བོད་ཀྱི་རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་པེ་ཅིན་ལྕགས་པར་མའི་དེབ་ངོས་པ།",
    "འི་བོད་ཆེན་པོའི་སྲིད་ལུགས་དང་འབྲེལ་བའི་རྒྱལ་རབས་དེབ་ཐེར་དཀར་པོ་ལྷ་སའི་ཤིང་པར་ཤོག་གྲངས་གྱི་རྒྱབ་ཐང་ཡིག་གསར་རྙིང་ལས་བྱུང་བའི་བོད་ཆེན་པོའི་སྲིད་ལུགས་མཚོ་སྔོན་ལྕགས་པར་མའི་དེབ་ངོས་པ།་",
    "བོན་ལུགས་འཛིན་པ་རྣམས་ཀྱིས་གནམ་གྱི་ལྷ་མི་ཡུལ་གྱི་རྗེ་བོར་བྱོན་པར་སྨྲ་བ་དང་།",
    "བོན་པོ་གནམ་ལ་དགའ་བས་གནམ་ལས་བབ་པར་སྨྲས་ཚུལ་དང་།",
    "རྒྱ་གར་ཤཱཀྱའི་རྒྱལ་རྒྱུད་ལས་ཆད་པ་ཡིན་ཚུལ་མང་དུ་སྣང་ཡང་དག་པར་མ་མཐོང་ཞེས་བསམ་ཤེས་དང་བཅས་ལུང་རིགས་གཉིས་ཐད་ནས་དགག་སྒྲུབ་གནང་བའམ།",
    "ཡང་འཇུག་སོགས་ཀྱི་རྣམ་གཞག་ཆ་ཚང་བ་འདི་བོད་ཀྱི་ཡི་གེའི་བྱེད་པོ་དེ་ཉིད་ཀྱིས་ཆེས་ཐོག་མ་ནས་དུས་གཅིག་ཏུ་གསར་བཟོས་མཛད་པར་གྲགས་ཤིང་།",
    "ཡང་ན་བོད་ཀྱི་ཡི་གེ་ལ་ཞིབ་འཇུག་སྨྲ་བ་སུས་ཀྱང་འདི་ལ་དོགས་སློང་ཙམ་ཡང་མ་བྱས་པ་སྨོས་མ་དགོས་པ་དེ་ལྟར་ཡིན་ནའང་།",
    "ཡང་ན་འབྲི་ཀློག་ལ་བཟོ་བཅོས་བྱས་པ་སོགས་རྐྱེན་སྣ་ཚོགས་ཤིག་ལ་རག་ལས་པར་མངོན།",
    "དབྱངས་གསལ་གྱི་ཡི་གེ་རྣམས་ཕྱོགས་བསྡུས་དང་གསར་བཏོད་བྱས་པ་རྩོད་མེད་ཡིན།",
    "འོན་ཀྱང་དེང་དུས་རྩང་བོད་ལ་གཙང་བོད་དང་ས།",
    "སྐད་ཆ་བཅས་ལ་ཕྱིས་འགྱུར་ལྡོག་བྱུང་བ་དང་བསྟུན་ནས་ཡི་གེ་འབྲི་ཚུལ་དང་སྦྱོར་ལུགས་སོགས་ཀྱི་ཐད་ལའང་ཡང་བསྐྱར་བཟོ་བཅོས་བྱས་པར་སྙམ།",
    "ལྷག་པར་ཤོག་དྲིལ་སོགས་ཡིག་རྙིང་བྲིས་མ་དག་ན་མགོ་འདོགས་ཀྱི་ཡི་གེ་བརྩེགས་མར་བྲིས་པ་ཆེས་མང་པོ་ཞིག་སྔ་ཕྱིའི་གོ་རིམ་ལྟར་གྱིས་ཅུང་གསེག་ནས་བྲིས་པ་དང་།",
    "ཕྱི་མ་དེ་ཕ་སྔ་ཕྱི་རིམ་པ་བར་མ་ཆད་པར་བྲིས་པ་ཞིག་ཡིན་དགོས་པ་རྩོད་མེད་ཡིན་ཀྱང་།",
    "ད་དུང་ཡང་ཚིག་དག་པར་ཀློག་པའམ་སྔོན་གྱི་ཀློག་དང་མཐུན་པར་ཡོད་པ་བོད་ཀྱི་ས་མཐའ་མང་པོ་ན་ཡོད་ཅིང་།",
    "ཁྱིམ་ལ་ཁི་ཡ་མ་ལྟ་བུར་ཀློག་ཅེས་པ་སོགས་ཀྱི་དོན་རྣམས་ཕན་ཚུན་ཆ་མཐུན་པར་སྣང་།",
    "ལྷག་པར་རྟགས་འཇུག་རང་ལས།",
    "ཅིའི་ཕྱིར་འཇུག་པར་བྱེད་ཅེ་ན།",
    "རྟག་བརྟག་ལྟ་བུ་གྲངས་ཀྱིས་མི་ཆོད་པའི་ཐ་སྙད་འདི་རིགས་བདག་གཞན་དང་དུས་གསུམ་སོགས་ཀྱི་རྣམ་གཞག་ཅི་ཡང་མི་སྟོན་པར།",
    "དེང་དུས་ཡི་གེ་དེ་གསུམ་གྱི་ཀློག་ཚུལ་ལ་ཁྱད་པར་ཆེན་པོ་ཡོད་པ་སོགས་ལ་བསམས་ན།",
    "དེ་ནི་ཡུལ་སྐད་ཀྱི་ཁྱད་པར་དང་ཡི་གེ་ཟོར་ཡང་བ་ཙམ་མ་ཡིན་པར།",
    "སྐབས་ཤིག་ན་ལེགས་སྦྱར་ཡི་གེ་ལ་དཔེ་བལྟས་ནས་ལེགས་སྦྱར་གྱི་ཀློག་ཁོ་ན་ལྟར་བྱས་པ་ཤོག་དྲིལ་ཡི་གེ་ལས།",
    "ཡང་ན་སྒྲ་གཟུགས་གཉིས་ཀྱི་འབྲེལ་བ་ལ་གཞིགས་ཏེ་ཡི་གེ་སྤྱིའི་བྱུང་འཕེལ་ལ་དཔྱད་གླེང་བྱས་པ་ཅུང་ཉུང་།",
    "བོད་ཀྱི་སྔ་རབས་བརྡ་སྤྲོད་རིག་པའི་ཞིབ་འཇུག་ཕྱོགས་ལ་སྣེ་སྟོན་གྱི་ནུས་པ་ཐོན་པར་མ་ཟད།",
    "ཉི་ཁྲིའི་མི་ཡི་རྒྱུད་པ་དེ་ཚོར་སྤྲ་མིའི་གདོད་མའི་རང་རྟགས་མེད་པར་གྱུར་ཟིན་པས་དེང་རབས་ཀྱི་མིའི་ཁོངས་སུ་གཏོགས་པ་དང་།",
    "ཁབ་མིག་ཀྱང་སྐྱོན་མེད་དུ་བསྡད་ཡོད་པས་མཐོང་བ་ཙམ་གྱིས་ཧ་ལས་དགོས་པ་ཡོད།",
    "ཆ་ཙོ་མི་ཕྱག་གར་གཉིས་ཀྱིས་བྱས།",
    "དེ་ནི་མཁར་གྱི་དང་པོ་ཡིན་པར་གྲགས།",
    "རྒྱལ་པོ་གཉའ་བར་བཏེགས་ནས་འགྲོ་བ་སོགས་ཀྱི་ལྡེབས་རིས་བྲིས་ཡོད་པར་གྲགས།",
    "བོན་གྱི་ལྷ་སྐུའི་སྣང་བརྙན་དང་།",
    "གླུད་གཟུགས་བཟོ་བ་སོགས་བྱས་ཡོད་པས།",
    "ཐང་ག་དེ་ཚོའི་ལྷ་སྐུའི་བྲིས་ཚུགས་ཐད་སྐུ་གཟུགས་ཀྱི་འགྱིང་ཉམས་མཉེན་ཆ་དོད་པོ་དེ་ཙམ་མེད་ལ།",
    "བལ་ལུགས་ཀྱི་བྲིས་རྒྱུན་འདི་ཉིད་དར་བ་ནས་རོང་ངགག་ངལུགས་བྱིའུ་སྒང་པའི་བྲིས་རྒྱུན་གསར་བཏོད་བྱུང་བའི་བར་ལོ་ངོ་དྲུག་བརྒྱ་ཙམ་རིང་བལ་རིས་ཀྱི་འབྲི་སྲོལ་འཕེལ་བ་དེ་ནི་རང་ལུགས་བྱིའུ་སྒང་པར་འགྱུར་ལྡོག་བྱུང་བའི་དུས་ཚོད་ཡིན།",
    "དབུས་གཙང་ཕྱོགས་ཀྱི་དགོན་གནས་དང་།་",
    "ལྷ་སྐུ་ཞི་དྲག་རྣམས་ཀྱི་ཞལ་གྱི་རྣམ་འགྱུར་དང་།",
    "སྐུ་གཟུགས་ཀྱི་སྟངས་སྟབས།",
    "ལྷ་སྐུའི་བྲིས་ཚུགས་ཐད་ལེགས་ཆ་དུ་མ་གསར་དུ་བསྣན་པ་སྟེ།",
    "དགྲ་གེགས་གདུག་པ་ཅན་ཐམས་ཅད་སྐད་ཅིག་ཏུ་འཇོམས་པར་བྱེད་པའི་ཚོར་བ་ལྡན་སྟབསལ་ཉིན་གསས།",
    "ལྷག་པར་དུ་ཐང་གའམ་ལྡེབས་རིས་ཀྱི་རྒྱབ་ལྗོངས་སུ་འ་༣༣",
    "མཁྱེན་ལུགས་ཀྱི་བྲིས་རྒྱུན་ཇི་ལྟར་དར་བ་དང་།",
    "མེ་ཏོག་ལ་སོགས་པ་རྣམས་སློབ་དཔོན་མ་བསྟེན་པར་རང་ཉིད་ཀྱི་བརྩོན་པར་བརྟེན་ནས་འབྲི་ཤེས་པ་དང་།",
    "ནམ་ཞིག་རྡོ་པ་བཀྲ་ཤིས་རྒྱལ་པོའི་སྙན་པ་གསན་ཏེ་ཐུགས་ལ་ལྷ་སྐུ་སྦྱོང་རྒྱུའི་འདུན་པ་ཤུགས་ཆེན་སྐྱེས།",
    "ལྷག་པར་དུ་དྲག་པོའི་རིགས་ཀྱི་རིགས་རྣམས་ལྷུག་ཆ་འཚམས་ལ་སྤྱང་ཤ་དོད་པ་བཅས་ཡོདབཙཆ།",
    "སྐུ་ཆུང་ངུའི་དུས་ཡབ་ཡུམ་གཉིས་ཀྱིས་སློབ་དཔོན་གྱི་དྲུང་དུ་བསྐྱལ་ནས་ཡི་གེ་འབྲི་ཀློག་བསླབ་པས་ཚེགས་མེད་དུ་མཁྱེན།",
    "འཕགས་ཡུལ་མངོན་སུམ་མཐོང་བཞིན་བྱས།",
    "ཉམས་འགྱུར་འབུམ་གྱིས་ཁྱད་པར་བྱས།",
    "ཞེས་གསལ་བར་ལྟར་ལགས་སོ།",
    "སྤྱི་ལོ་ལོར་ཇོ་བོ་རྗེ་བོད་དུ་ཕེབས་རྗེས་དེ་ལས་དབུ་བརྙེས་ཤིང་འབྲོམ་སྟོན་པ་སོགས་ཀྱིས་སྲོལ་བཏོད་དེ་དར་ཞིང་རྒྱས།",
    "དེའི་མཐུ་པར་མཛད་པའི་བཀའ་གདམས་པའི་བསྟན་པ་བོད་ཁམས་ཧྲིལ་པོར་ཁྱབ་པ་དང་།",
    "ཝ་ཡིག་བཏགས་པའི་རྭ་ཡིག་སྤྱད་གྲངས་གཞན་གཉིས་ལས་ལྷག་པར་མང་ངོ།",
    "འབྲི་ཚུགས་གཞན་ཞིག་ནི་མིང་ཡིག་དང་པོར་ཝ་འདོགས་བོར་ཏེ་ར་ཡིག་རྐྱང་པར་བྱས་དེང་རབས་བོད་རིག་པའི་སྐོར་གྱི་དཔྱད་རྩོམ་གཅེས་བཏུས།",
    "ཡི་གེ་བ་དང་ཞུས་དག་པ་སོགས་ཀྱིས་མ་ཕྱིའི་ར་ཡིག་རྐྱང་པ་དག་ཝ་འདོགས་ཅན་དུ་བཅོས་སྲིད་པ་ལས་དེ་ལས་ལྡོག་པར་བཅོས་དཀའ་བའི་ཕྱིར་རོ།",
    "ཅེས་གསུངས་པ་ལྟར་ར་ལ་ཝ་བཏགས་པའི་འབྲི་ལུགས་འདི་ཅིག་ཤོས་ལས་ཆེས་སྔ་བར་སྣང་།",
    "དེ་ལས་ལྡོག་སྟེ་ཡིག་སྐད་དམ་ཡི་གེ་ཙམ་པོ་བའི་གཟུགས་ཀྱིས་དོད་བྱས་པའི་ངག་སྦྱོར་དེ་དག་ནི་འགྱུར་བ་འགྲོ་དཀའ་བ་ཡིན་པ་དེང་རབས་བརྡའི་གཞུང་ལས་ཡང་ཡང་སགསུངས་ལ།",
    "དེ་ཡང་ཡུལ་འདིའི་མིང་དུ་གྲུབ་བྱེད་ཀྱི་ཡི་གེ་ར་ཡིག་དེ་མ་གས་ཉིད་ལ་འཛིན་པ་སེམས་ཀྱི་གནས་ལུགས་སོགས་དང་སྦྱར་ནས་ཆེ་བསྟོད་བྱས་པ་ཞིག་ཡིན་ལ།",
    "བཞུགས་པ་ཤེས་ནས་ཞུས་པས་གླེགས་བམ་པོ་ཏི་ཚང་བ་བཀའ་རྒྱ་དང་བཅས་ཏེ་གནང་ལུགས་དང་དེས་ཕུ་ཆུང་བ་དང་དེས་ཀ་མ་བ་རྣལ་འབྱོར་རིན་ཆེན་རྒྱལ་མཚན་ལ་གནང་ཞིང་དེས་ཀྱང་སྟབས་ཁ་བ་ཞང་སྟོན་དར་མ་རྒྱལ་མཚན་ལ་གནང་ཞིང་།",
    "པ་མགཞན་ཡང་སྲོང་བཙན་སྒམ་པོས་བྱང་དུ་མི་རྒོད་བཏུལ་བར་ཕེབས་པ་དང་ནས།",
    "སྤྲགས་སོགས་སུ་བཞུགས་པར་གསུངས་པའི་དུས་སུའམ།",
    "བློན་ཚེ་སྟོང་བཙན་འ་ཞ་ཡུལ་ན་མཆིས་པར་ལོ་གཆིག་ཅེས་གསུངས་པའི་སྐབས་སུ་ཡིན་སྲིད་ཅིང་།",
    "མིང་དུའམ་སྲོང་བཙན་བཞུགས་ཁྲི་ཞེས་འབོད་བཞིན་མཆིས་པས་སྲོང་བཙན་ཕེབས་མྱོང་བ་ནི་བདེན་ཤས་ཆེ་ཞིང་།",
    "ས་པཎ་ཞེས་གསུངས་པས་བཀའ་གདམས་པའི་ར་ནི་བི་ར་ཛ་སྟེ་རྡུལ་དང་བྲལ་བའི་ཕྱིར་རོ་༧ ཉགྱིས།",
    "ཡུལ་གྱི་ཆེ་བ་འདོན་པའི་ཕྱིར་དེ་དག་ཀྱང་༧རྒྱལ་སྲིད་སྣ་བདུན་སོགས་ཀྱི་གཟུགས་དང་སྦྱར་བའང་བྱས་ཡོད་དོ།",
    "འཚོ་བ་གཉེར་ལུགས་སོགས་སྣང་ཚུལ་སྣ་ཚོགས་པ་དག་ལ་ཞིབ་ཕྲའི་དཔྱད་པ་གནང་ཐུབ་ན་ཡུལ་གྱི་མིང་དེ་གང་ལ་བརྟེན་ནས་ཐོགས་པའི་ངེས་པའང་རྙེད་པར་སྲིད་དོ།",
    "དང་ལ་རྒྱུ་བབ་གོང་དུ་བརྗོད་པ་ལྟར་རྭ་སྒྲེང་ཞེས་པའི་ཡུལ་མིང་འདིའི་འབྲི་ལུགས་ལ་ཚེག་ཁྱིམ་གཉིས་བར་ཆཅ་དར་པར་འབྲི་ཚུལ་མི་གཅིག་པ་མ་བྱུང་རུང་ཚེག་ཁྱིམ་དང་པོ་དེ་ཉིད་ལ་ར་ཡིག་ལ་ཝ་འདོགས་ཡོད་ས་ར་དེ་བཞིན་རལ་ཞེས་པའི་འབྲི་ལུགས་བྱུང་ར་མེད་གཉིས་དང་དེ་ལས་ཀྱང་ཝ་བཏགས་པ་མང་བབཏགས་པ་མང་།",
    "མཐའ་གཅིག་ཏུ་ན་ཡུལ་ལུང་གང་ཡོད་པའི་མིང་དེ་ཉིད་རྗེས་སུ་གྲུབ་པའི་མིང་ཡིན་༡ གནའ་ཐོག་མའི་མི་རྣམས་བློ་རིག་གམ་རྣམ་དཔྱོད་དེ་ཙམ་མི་བཀྲ་བས་པར་ངེས་པ་མེད་ལ།",
    "དེ་ཡང་ངེས་པར་ཕྱི་མ་ཁོ་ན་ཡིན་སྙམ་ཏེ།",
    "ར་བ་ཞེས་པ་བསྡུས་དང་མ་བསྡུས་གཉིས་ཀ་ལས་མ་བསྡུས་པ་མང་བ་དང་ཡུལ་འདིའི་མིང་ཡིག་ཏུ་སྤྱད་པའི་རྭ་ཡིག་ལ་ནི་དེ་འདྲའི་གདམ་ང་བྱས་པ་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "འདིའི་སྐོར་ལས་ཅུང་ཟད་འཕྲོས་ཏེ་རྭ་སྒྲེང་ཞེས་པའི་སྒྲེང་ཡིག་ལ་ཅུང་ཟད་དཔྱད་པར་བྱའོ།",
    "དེ་ཡང་ཞིབ་པར་བསམ་ན།",
    "དེང་རབས་སྐད་བརྡའི་གཞུང་ལས་ཀྱང་དེ་ལྟར་ལན་མང་དུ་གསུངས་པས་སོ།",
    "འོན་ཏེ་མིང་ཡིག་དང་པོ་དེ་ཉིད་དུད་འགྲོའི་བྱེ་བྲག་རའམ་མགོ་སྐྱེས་རྭ་ཅོ་གང་རུང་ལ་དམིགས་པ་དེ་བཞིན་ཉིད་དུ་ཡིན་པར་ངེས་དེང་རབས་བོད་རིག་པའི་སྐོར་གྱི་དཔྱད་རྩོམ་གཅེས་བཏུས།",
    "ཡུལ་འདིའི་མིང་ཡིག་དང་པོའི་འབྲི་ཚུགས་ཀྱི་ཁྱད་པར་ར་ཡིག་ཝ་འདོགས་ཡོད་མེད་གཉིས་སྟེང་རལ་དང་བཅས་གསུམ་དུ་མཆིས་པ་དང་།",
    "ངག་ནས་འདོན་ཚུལ་ལའང་ར་ཡིག་དབྱངས་དང་པོ་དང་གསུམ་པ་བཞུགས་པ་གཉིས་བཅས་བྱུང་ཞིང་།",
    "ད་དུང་འདིའི་སྐོར་གྱི་དཔྱད་གཞི་དང་རིགས་པས་དཔྱད་རྒྱུར་ལུས་པའི་དོན་མང་པོ་ཞིག་ཀྱང་སོ་ན་ལུས་ཡོད་པས་འདི་ཙམ་གྱིས་སླ་ཐབས་སུ་ཁ་ཚོན་གཅོད་སྔ་བྱས་ན་དོན་དངོས་དང་མཐུན་དཀའ་བའང་སྲིད་པས།",
    "དེ་ལ་ཕ་མས་ལྷག་པར་བརྩེ་བ་ལྟར།",
    "ལེགས་པར་དཔྱད་དེ་བདེན་ཁར་གཏོང་བའི་ལུགས།",
    "ཕྱི་རབས་པ་ཀུན་ཀྱང་ཅི་བསམ་མེད་པར་དེ་འདྲའི་འདོད་པའི་རྗེས་སུ་འབྲངས་ཏེ།",
    "གལ་ཏེ་དེ་ཉིད་རྣམ་པར་དཔྱོད་པའི་ཚེ།",
