    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་རྒྱུ་འབྲས་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་པ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་ཡོད་མེད་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་པ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་སྣང་སྟོང་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་ཉི་མ་དགུ་ཤར།",
    "རེག་པ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་གསལ་རིག་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རེག་པ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སུ་སྟོན་པའོ།",
    "རེག་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་པ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་སྣོད་བཅུད་གཉིས་སུ་སྟོན་པའོ།",
    "རེག་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པ་ཤེས་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "རེག་པ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་ཟག་པ་ཟག་མེད་དུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "རེག་པ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་ཁམས་དང་སྐྱེ་མཆེད་དུ་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་ཉི་མ་དགུ་ཤར།",
    "རེག་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "རེག་པ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "བོན་གཡུང་དྲུང་གི་དབྱིངས་དགུ་ནི་ལས་དང་སྤྱོད་པར་སྟོན་པའོ།",
    "རེག་ནི་ས་དང་ལམ་དུ་སྟོན་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་ས་དང་ལམ་དུ་སྟོན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བ་ནི་ས་དང་ལམ་དུ་སྟོན་པའོ།",
