    "རིང་དུ་བོར་ནས་ཤིང་སྐམ་རེངས་པའི་དྲུང་།",
    "བསིལ་སྐྱོབས་རེ་བཅན་རྣམས་ཤིན་ཏུ་འཁྲུལ།",
    "བཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱན་ལ་བཞི་ཁས།",
    "རབ་དམར་བརྗིད་ཆགས་བླམ་དྲག་པོ་ཁྱོད།",
    "ཁྱོད་ཀྱིམཁྱེན་པའི་ཀློང་དུ་མ་ཆུད་པའི།",
    "ལན་བརྒྱར་དཔྱད་ཀྱང་བདག་ཡིད་འཕྱང་མོ་ཉུག།",
    "ཁྱོད་གསུང་གཅིག་གིས་བློ་ལྡན་ཆེསམང་པོའི།",
    "མཁྱེན་རབ་ཟབ་མོའི་ཀློང་དུ་ཆུབ་པར་ངེས།",
    "གཡོ་མེད་འདེགས་པར་བཟོད་པའི་ས་འཛིན་ཁྱོད།",
    "སྔོ་བསང་བུ་མོ་རྒྱུ་སྐར་རྒྱལ་པོ་ཡིས།",
    "ཕུ་བོ་སྐྱ་རེངས་དང་འགྲོགས་སྲིད་པའི་མིག།",
    "དམ་པ་ཁྱོད་ནི་ལུང་དང་རྟོགས་པའི་ཚེས།",
    "ཐ་སྙད་སྟག་གི་གསོབ་ཏུ་བརྫུབ་དག།",
    "རོ་བརྒྱའི་ཟས་དང་མཛེས་པའི་བཙུན་མོ་བཅས།",
    "གྲོགས་དག་ནང་གི་དེ་ཉིད་རྟོགས་པ་ལ།",
    "ཉོནམོངས་རྣམ་རྟོག་འགྲོ་འོང་མ་ཤེས་བཞིན།",
    "སྒྲུབ་བརྒྱུད་བསྟན་པཚུགས་འདིས་བློ་རེ་བདེ།",
    "ཡངན་ངུར་སྨྲིག་གོས་འདི་དམག་གི་གོ་ཁྲབམིན།",
    "བློ་གསལ་སྐྱེས་བུ་འདུས་པ་དཔུང་ཚོགས་མིན།",
    "གནས་པ་བདག་གི་ཡིད་ཀྱང་དགའ་བར་བྱེད།",
    "འཛག་པའི་ཚིག་གི་ཟེག་མ་འཕྲོ་བ་འདིས།",
    "བརྩོན་པའི་མོས་གུས་སྐྱ་རེངས་འབའ་ཞིག་གིས།",
    "ཅུ་བཞི་པ་ཕྲ་མོའི་རྒྱན་ལ་གཉིས་ལས།",
    "དང་བོ་ཟུར་གྱི་ཕྲ་མོ་ནི།",
    "རང་གི་གནས་ཚུལ་སྨྲ་བར་མ་བཟོད་པས།",
    "ཉག་གཅིག་གིས།",
    "བསྟན་དགྲམིང་གི་ལྷག་མ་བྱས་འདི་ཅི།",
    "སྐུ་ངོ་ཙོག་རྩེའི་སྟེང་གི་ཞལ་དཀར་ཡང་།",
    "བདུན་པ་ངོ་མཚར་འཕེལ་བ་རྨད་བྱུང་གི་ཉམས་ནི།",
    "ཐུན་བཞིའི་རྣལ་འབྱོར་བཙུནམོ་འཛུམ་པའི་ཞལ།",
    "བརྒྱད་པ་འཇིགས་པ་འཕེལ་བའཇིགས་རུང་གི་ཉམས་ནི།",
    "ཚེ་འདིར་མཆོག་གི་ས་ལ་འགོད་པར་མཐོང་།",
    "རེ་ཞིག་རང་གི་བསྟི་གནས་ཉིད་དུ་སོང་།",
    "རེ་འདུན་ཡང་དག་འགྲུབ་པའི་རྐྱེན་དུ་བྱུང་།",
    "གཙུག་གི་ནོར་བུ་དགྲ་ལ་སྦྱིན་པནི།",
    "ངོམཚར་བཀོད་པ་གཅིག་གི་ཆར་མི་ཡོད།",
    "མཐོང་ན་མི་མཐུན་མེད་པའི་སྟོན་པ་ཁྱོད།",
    "ལུས་སྐྱེས་གཡོ་ཞིང་མོས་པ་འཕེལ་བ་དང་།",
    "སྲེད་ལྡན་ཁྱོད་ཀྱིས་བགྲོད་བྱརམ་གྱུར་པའི།",
    "གསུང་གི་རྔ་སྒྲ་ཟབ་རྒྱས་དབྱངས་སུ་སྒྲོག།",
    "མདའ་རྣོན་སྟོང་གིས་མ་ཕིབས་ངོ་མཚར་ཆེ།",
    "ས་སྐྱོང་ཁྱོད་ནི་མང་པོས་བཀུར་བ་དང་།",
    "དཔུང་ཚོགས་ཡན་ལག་བཞི་དང་མི་ལྡན་ཞིང་།",
    "ཉོན་མོངསདགྲ་རྣམས་ཕམ་པར་བྱེད་འདི་མཚར།་",
    "ད་ལྟ་རང་རེའི་ལྗོངས་འདིར་ནོར་བུའི་མཚན།",
    "དགུན་གྱི་གྲང་རེག་ཁ་བའི་རྡུལ་ཕྲན་དང་།",
    "ཨརྱ་དེ་བ་ཡེ་ཤེས་སྤྱན་གཅིག་གིས།",
    "འདི་ནང་ཁྱོད་ཀྱིས་དབུམ་ལུགས་གཉིས་ཀྱི་ གསལ་བྱེད་དེ་ཙམ་རྩོམ་ལ་སྙེམས་མི་འཚལ།",
    "ཁྱོད་ཀྱི་སློབ་ཚོགས་ངང་པའི་བུ་མོ་ཡིས།",
    "སྐྱེས་སྦྱངས་ཡོན་གྱིས་ཕྱུག་པའི་མཁས་མཆོག་གིས།",
    "གཉིས་པ་བྱ་བ་ལྷན་ཅིག་བརྒྱལ་བའི་བསྟན་ལ་ལྷག་པར་མོས་པ་དང་།",
    "འདིར་གང་གི་སྐྱབས་འཇུག་རྡོ་རྗེ་གུར་ཁང་དུ་རྣམ་ཀུན་བདེ་བར་འཚོ་བའི་གུས་པའང་གང་སྐུའི་ཟླ་ཞལ་དད་པའི་ཡིད་མཁའ་འགོག་པ་མེད་མཐུས་ཟག་ཕུང་ག་བག་བཞི་སལམ་ལྷུང་ཙམ་དུལཆིས་ཞུ།",
    "གནས་སྐབས་དམིགས་མེད་བརྩེ་ཆེན་གྱིས་ཉེ་བར་འཁྱུད་པའི་ཟབ་མོའི་བཀའ་མཆིད་ཀྱི་ཕེབས་ཚོགས་ཀྱང་ཚངས་པའི་རལ་ཀླུང་ལྟར་གཙུག་གི་རྒྱན་དུ་ལྕགས་སྩོལ་ཡོད་པར་ཞུབས་སྐུགས་མཁྱེན།",
    "ཞེས་སྒྲིབ་བྲལ་ཡེ་ཤེས་སྤྱན་གྱིས་གཟིགས་པ་གཅེར་བུར་མ་ཕོད་ཙམ་དུ་ཞུ་འདེགས་ན་གཞོནམཛངས་མའི་སེར་འཕྲུལ་ལས་བསྐྲུན་པའི་ཕྱག་བསིལ་ཡང་ཁེབས་ཀྱིས་གཙོས་པའི་ཟེང་སྣ་རྡོར་འཛིནས་ཡིགྲངས་ལྡན་བཅས་གུས་འབངས་ཆེ་གེ་མེས་྾྾།",
    "འདིར་གང་སྐུ་ཡོངས་འདུ་ལྗོན་པའི་གྲིབ་བསིལ་དུ་འཚོ་བའི་གུས་པའང་གསར་འཚོའི་ཚ་གདུང་གིས་ཕུང་པོའི་མྱུ་གུ་རློན་པ་མ་སྐམ་ཙམ་དུ་མཆིས།",
    "གུས་པ་སྐྱབས་འཇུག་ཟབ་མོའི་རྡོརྭ་ལས་ནམ་གཞར་འདོར་བ་མེད་ཁར་ཐུགས་རྗེས་རྗེས་འཛིན་གྱི་བཀྲའ་ཆབ་ཟབ་མོའི་ཕེབས་ཚོགས་ཀྱང་དབམ་བཞིའི་རྒྱུན་ལྟར་ལྷུགས་སྩོལ་ཡོད་པར་ནུབ་མཁྱེན།",
    "གཟིགས་འདེགས་སྟོན་ཟླ་འབུམ་གྱི་དཔལ་ལའང་ཅོ་འདྲིར་འོས་པའི་ལྷ་གོས་ཉིན་མོར་བདེ་ལེགས་ཀྱིས་གཙོས་པའི་ཟོང་སྣ་གསེར་རིའི་གྲངས་ལྡན་བཅས་གུས་པ་ཆེ་གེ་མོས་ཟླ་ཚེས་༞།",
    "འདིར་གུས་པའང་སྐྱབས་ཡུལ་རྒྱས་ཀྱི་བྱིན་མཐུས་ཟག་ཕུང་ལུས་ཀྱི་ལྗོན་པར་འའཆི་ལྟས་སྟ་རེས་མ་ཟིན་ཙམ་དུ་མཆིས།",
    "ཞེས་སྤྱན་ཟུང་གི་འཇུག་པ་གཅེར་མིན་ཙམ་དུ་ཞུ་རྟེན་ལྷ་རས་དང་དབྱིན་ལོར་དེ་ཉིད་གྲངས་ལྡན་བཅས་གུས་པ་ཆེ་གེམོས་ཟླ་ཚེས་༞།",
    "ཞེས་གུས་པ་ཆེ་གེ་མོས་ཟླ་ཚེས་༞༞།",
    "ཞེས་གཟིགས་རྟེན་མཚོན་བྱེད་ལྷ་མི་བཅས་གུས་པ་",
    "འདིར་གང་གི་ཆབ་སྲིད་གདུགས་དཀར་ཀྱི་འོག་ཏུ་འཚོབའི་གུས་འབངས་པ་ཉིད་ཀྱང་།",
    "སླད་མའི་ཆར་ཡང་པག་བསམ་ལྗོན་པའི་གཟུགས་ཀྱི་ཟླ་བོར་འཚོ་གཞེས་བརྟན་ངོས་ཐུགས་བརྩེ་དགོངས་པའི་དབྱིངས་ནས་ནམ་གཞའ་བསྙེལ་བར་མེད་པར་གང་འདོད་ཀྱི་རེ་འབྲས་སྦྱར་སོན་ཡོད་པའི་སྐྱབས་ ། འཇུག་དང་།",
    "ཞབས་རིམ་མཛད་སྒོ་བྱ་དགོས་ཀྱི་རིགས་ལ་ཆབ་ཤོག་རྡོ་རྗེའི་རེ་ཁཱ་ཕྲན་པའི་གཙུག་རྒྱན་དུ་བསྐུར་གནང་ཡོད་པ་ར་ཞུ་བས་སྐུགས་མཁྱེན།",
    "ཞེས་སྤྱན་རས་པདྨ་འཛུམ་པའི་དགའ་སྟོན་དུ་ལྷ་གོས་རེག་འཇམ་གོ་སྣམ་ཡུགས་ཀྱིས་གཙོས་པའི་སྨར་ཟོང་སྣ་འདྲེས་ཚེས་པའི་གྲངས་ལྡན་བཅས་གུས་འབངས་ཆེ་གེ་མོས་༞༞ ལྷ་བཙུན་རྒྱལ་ལྕམ་ལྟ་ཐུ་ལ་འབུལ་ན།",
    "གུས་པར་ཐུགས་བརྩེའི་དྲི་བསྲུང་གིས་བསུས་པའིི་བཀའ་མཆིད་ཟིལ་དངར།",
    "གྱི་ཕེབས་ཚོགས་ཀྱང་འཕྲོག་བྱེད་བུ་མོའི་རྒྱུན་ལྟར་སྤྱིར་སྩོལ་ཡོད་པར་ཞུ་མཁྱེན།",
    "རྟེན་གཅེར་མིནཱ་ཙམ་དུ་ལྷ་རས་དྲི་མེད་ཀྱིས་གཙོས་ཟོང་སྣ་མཆོག་གསུམ་གྲངས་ལྡན་བཅས་གུས་པ་ཆེ་གེ་མོས་ཟླ་ཚེས་༞༞།",
    "དེང་བགྲང་ཡས་བསྐལ་པར་ཚོ་ཀས་ཟུང་རླབས་ཆེན་སྤྱོད་པའི་དཔལ་ལས་བལྟམས་པའི་གང་སྐུ་ལྷ་མིའི་འཇིག་རྟེན་ཀུན་གྱི་མཆོད་འོས་སུ་གནམ་བསྐོས་ལུང་གི་ཤོམོ་བབ་སྟེ།",
    "དེར་སྔོན་གོམས་ལེགས་བྱས་ཀྱི་འབྲས་བཟང་ཕྱག་རྩེཪ་སྨིན་མཐུསསྐུ་དང་མཛད་ཕྲིན་ཡར་བླའི་དཔེ་ལྟར་དགེར་བཞུགས་ནས་ཐུགས་བརྩེ་མི་བསྐྱད་པའི་གསུང་གསལ་ཕྱག་བྲིས་སྐྱེས་བཟང་གིས་བརྒྱན་པའི་གནང་སྦྱིན་ཕྱག་རྒྱ་ཉམས་མེད་ལག་སོན་གྲུབ་པའི་མོད་ལ།",
    "ཞེས་གཟིགས་རྟེན་སྟོང་མིན་ཙམ་དུ་ལྷ་མེ་བཅས་༞།",
    "སླད་ནས་རང་གིས་ཡོན་ཏན་སློབ་འོས་ཀྱི་རིགས་མཐར་འཁྱོལ་ཟིན་དུས་ ཁྱོད་རའི་དྲིན་ལན་ཀྱང་དེར་དུས་བསབས་པར་བྱ་སྙམ་པའི་རེ་རྒྱ་ཡོད་པ་བཅས།",
    "མཛའ་ན་མོ་ལ་མཚར་སྡུག་གི་བདུད་རྩི།",
    "ཐ་སྙད་བརྡ་དག་གི་བསྟན་བཅོས་ངོ་མཆེར་འཕྲུལ་རྒྱི་ལྡེ་མིག་ལ་ཤོག་ལྡེབ་༤༦།",
    "སྐྱེ་བོའི་ཚོགས་ཀྱི་ཉོན་མོངས་སྐྱོབ་པའི་ཕྱིར་ན་ཐུགས་རྗེ་ཆེན་པོ་ཡང་དག་བསྐྱེད་བ་ཅན།",
    "འགྲོ་རྣམས་ཕྱོགས་གཅིག་གང་གི་བློ།",
    "རྒྱལ་གྱུར་དེ་གསུང་ཟབ་མོ་གང་།",
    "ཡོད་པ་རྣམས་ལ་བདག་གིས་ནི།",
    "དེ་སྲིད་གང་གིས་གཟུང་བར་བྱ།",
    "གང་གིས་རབ་ཏུ་བྱེད་པ་འདིའི་དགོས་པ་འདི་ཡིན་ནོ་ཞེས་བརྗོད་པས་དགོས་པའི་ཁྱད་པར་དག་གི་རབ་ཏུ་བྱེད་པ་ནི་ཐབས་སུ་ངེས་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་རྟོག་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་དགོས་པ་དོན་དུ་གཉེར་བ་རྣམས་ནི་དེའི་ཐབས་ངེས་པ་དེ་ཡོད་པ་ལས་ཡིན་ཏེ།",
    "གང་གིས་ཇི་ལྟར་དོན་གང་བརྗོད་པར་འདོད་པ་དེ་ཇི་ལྟ་བར་དེས་རྗེས་སུ་མི་སྒྲུབ་པོ།",
    "གཞན་ཅུང་ཟད་ཅིག་ཡིན་ཞེས་དེ་ལྟ་བུའི་དངོས་པོའི་ཐེ་ཚོམ་སྔར་འཇུག་པ་ན་གང་གིས་བསལ་བར་ནུས།",
    "བྱ་རོག་གི་སོ་རྟོག་པ་བཞིན་ནོ།",
    "དེ་ལ་དེ་བསྟན་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཚིག་གི་བདག་ཉིད་འདིས་ནི་རབ་ཏུ་བྱེད་པའི་དགོས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་ངག་གིས་བརྗོད་པར་བྱ་བ་རྟོགས་པ་ནི་ངག་གི་དགོས་པ་ཡིན་ཏེ།",
    "དེ་ཡང་འདི་ལ་ཡོད་དེ་ཚིག་གི་ནང་ཚན་རྣམས་དང་དག་ཕན་ཚུན་དུ་འབྲེལ་པ་ལས་བསྡུས་པའི་དོན་རྟོགས་སོ།",
    "རང་གི་ངོ་བོ་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་པ་དེ་བསྟན་པ་ནི་རབ་ཏུ་བྱེད་པའི་དགོས་པ་ཡིན་ཏེ།",
    "དེས་ཀྱང་རབ་ཏུ་བྱེད་པ་དག་གི་དགོས་པ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "དག་རང་གི་དོན་རྟོགས་པའི་མཚན་ཉིད་ཀྱི་དགོས་པ་ཉིད་ལ་རྟོག་པ་དང་ལྡན་པ་འཇུག་པར་མི་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་ལྐོག་ཏུ་གྱུར་བའི་དོན་རྟོགས་པ་གང་ཡིན་པ་དེ་ནི་ངེས་བའོ།",
    "རྗེས་སུ་དཔག་པའི་རྟེན་གང་ཡིན་པ་ཞེས་བྱ་བ་ཐུན་མོང་དུ་རྣམ་པར་སྦྱོར་རོ།",
    "དཔེར་ན་འདི་བྲམ་ཟེ་མོར་བདེན་ནོ་ཞེས་པ་དང་།",
    "དེ་རང་གི་དོན་དང་འབྲེལ་པ་མེད་པས་ངེས་པ་ན་དེ་མི་སླུ་བར་རིགས་པ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "གཞན་ཡང་འབྲེལ་པ་མེད་པ་ལས་མ་ཡིན་པའི་ཕྱིར་དེ་ཐམས་ཅད་ལས་ཐམས་ཅད་རྟོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་མཚན་ཉིད་ཁོ་ནའི་བདག་ཉིད་དོ།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་དེ་ལ་ཉེ་བར་མཁོ་བའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་གཞན་རྟོགས་པ་ན་གཞན་ལ་འཇུག་པ་ཡིན་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "དེ་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་གྱི་རྗེས་སུ་དཔག་པར་ཁས་བླངས་པར་འགྱུར་རོ།",
    "རང་གི་། མཚན་ཉིད་ཀྱི་སྤྱི་ཡིན་ན་རྗེས་སུ་དཔག་པ་ལ་ཇི་ལྟར་སོ་སོར་སྣང་བ་ཡིན་ཞེས་བསམ་པར་བྱ་སྟེ།",
    "གསལ་བའི་དངོས་པོ་སྤྱི་ལས་གཞན་པའི་ངོ་བོའི་སྤྱི་མི་འདོད་པས་བྱེ་བྲག་པའི་ལྟ་བ་ཁས་ལེན་པར་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་ངོ་བོ་དང་།",
    "གཏན་ཚིགས་ཞེས་བྱ་བས་ནི་རང་གི་ངོ་བོ་བསྟན་ཏོ།",
    "གང་གི་ཕྱིར་དེ་ནི་རྣམ་པ་བཞིར་གནས་ཏེ།",
    "དེ་ཇི་ལྟར་དེ་དག་གིས་དེ་མེད་པར་གོ་བར་འགྱུར།",
    "དེས་ན་གང་གི་ཕྱིར་གཏན་ཚིགས་རྣམ་པ་གསུམ་ལས་གཞན་པའི་གཏན་ཚིགས་ལྟར་སྣང་བ་ཡིན་པ་དེའི་ཕྱིར།",
    "འོན་ཀྱང་དེ་རྣམས་ལ་གཏན་ཚིགས་དགག་པ་ནི་གཏན་ཚིགས་སུ་རྨོངས་པ་འབའ་ཞིག་གིས་གཞན་ལ་གྲགས་པ་དེ་ཉིད་དེ་ལ་སྒྲོ་འདོགས་པ་འམ་ཐེ་ཚོམ་ཟ་བ་དེ་འགལ་བ་དམིགས་པས་བསལ་ཏོ།",
    "ལྷན་ཅིག་མི་གནས་པའི་མཚན་ཉིད་ཀྱི་འགལ་བ་མེད་ན་གང་གིས་ན་དེའི་རིགས་པས་ཐམས་ཅད་ལ་ཉེ་བར་བརྗོད་དམ།",
    "གང་དང་གང་འགོག་པ་དེ་དང་དེ་ལ་འགལ་བར་རྟོགས་པ་མ་ཡིན་ན་གང་གིས་ཇི་ལྟར་མེད་པ་འགའ་ཞིག་དང་འགལ་བར་རྟོགས་ཞེས་རྩོད་པ་ཡིན་ཏེ།",
    "དེ་ཡང་རྟེན་དང་བརྟེན་པའི་དངོས་པོའི་བདག་ཉིད་ཡིན་ན་ཕན་འདོགས་པ་མེད་པར་ཧ་ཅང་ཐལ་བར་འགྱུར་བས་མི་འགྲུབ་པོ།",
    "གང་འདི་ལྟར་གྱུར་པ་ནི་ཁོ་བོ་འབའ་ཞིག་མ་ཡིན་གྱི་ཁྱོད་ཀྱིས་ཀྱང་མཐོང་ངོ་ཞེ་ན།",
    "དེ་ཅུང་ཟད་གཅིག་ལ་ལར་འཇིག་པ་འམ་མ་ཡིན་པ་དང་གང་གང་ལ་ཅུང་ཟད་ཅིག་རག་ལས་པའམ་རག་ལས་པ་མེད་པ་དེ་ལྟ་མ་ཡིན་ན་ཁྱད་པར་མེད་པའི་ཕྱིར་འདོད་པའི་ཡུལ་དང་དུས་རྫས་བཞིན་དུ་ཡུལ་ལ་སོགས་པ་གཞན་ན་ཡོད་པ་ལ་གང་གིས་ན་བསལ་པར་ནུས།",
    "གཏན་ཚིགས་ལྟར་སྣང་བ་གི་བར་འགྱུར་རོ་སྙམ་ནས་དེའི་མཚན་ཉིད་མ་བརྗོད་དོ།",
    "དེ་ལྟ་ན་མིག་གིས་གཟུང་བར་བྱ་བ་ཡིན་ན་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རིགས་མཐུན་པ་ཁོ་ན་ལ་ཡོད་པ་ཞེས་བྱ་བ་ངེས་པར་གཟུང་བས་གཏན་ཚིགས་ཀྱི་ལྡོག་པ་གྲུབ་མོད།",
    "གང་གི་ཚེ་ཞེ་ན།",
    "འདིར་ཡང་གི་སྒྲ་ནི་གང་གཞན་གྱིས་བསྟན་པ་ལ་རེ་བ་དང་བཅས་པ་དེས་ན་དོན་འདིའི་མཚན་ཉིད་བརྗོད་པས་རྟོགས་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "མཆོད་སྦྱིན་གྱི་མ་ཡིན་བ་བཞིན་དུ་དེས་ན་གཞན་ལ་མི་འཇུག་པས་ཐུན་མོང་མ་ཡིན་པ་ཉིད་དུ་ཐུན་མོང་བ་ནི་མ་ཡིན་པས་དེའི་། ཆས་ཁྱབ་པ་དང་འགལ་ལོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིས་ཀྱང་ཕྱོགས་སུ་བྱས་པས་གཞན་ལ་འཇུག་པ་གདོན་མི་ཟ་བར་འཕངས་པ་ནི་མེད་ན་གང་གི་མཚན་ཉིད་ལ་གནོད་པར་དོགས་པ་ཡིན།",
    "དེའི་ཕྱིར་རང་གི་བསྒྲུབ་པར་བྱ་བ་དང་འབྲེལ་པ་ལས་ཀྱང་གཏན་ཚིགས་ལ་ཁྱབ་པ་འགྲུབ་སྟེ།",
    "དེའི་ཆས་ཁྱབ་པ་ཞེས་བརྗོད་པ་རང་གི་བསྒྲུབ་པ་བྱ་བ་དང་།",
    "དེ་ལ་ལྟོས་པས་གཞན་ལ་མི་འཇུག་པས་ཐུན་མོང་མ་ཡིན་པ་སྲིད་པར་། དོགས་པས་དེ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་བཟློག་པ་གཞན་དག་ལ་འཇུག་པ་མ་ངེས་པ་ནི་དེ་གཉི་ག་ལས།",
    "བསྒྲུབ་བར་བྱ་བ་ལ་འཇུག་པ་དང་རྣམ་པར་གཅོད་པ་དག་གིས་ཐམས་ཅད་བསྡུས་པས་གཏན་ཚིགས་དེ་ལ་ཐེ་ཚོམ་ཟ་བར་འགྱུར་རོ།"
  ]
}