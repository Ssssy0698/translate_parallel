    "དབྱངསཅན་ལྷ་མོ་ཁྱོད་ཀྱི་བཞིན་རསནི།",
    "ཁྱོད་ཞལ་འཛུམ་པའི་རླབས་ཕྲེང་ཕྲ་མོས་ཀྱང་།",
    "ཤེས་རབ་གསུམ་གྱི་ལང་ཚོ་རྒྱས་པར་བྱེད།",
    "གཟིགས་ནས་གཞན་ལ་འདོམསམ་ཁས་ཁོ་བོའི་རྗེ།",
    "ཤེས་བྱ་མ་འདྲེས་ཅིག་ཅར་གཟིགས་པ་ཡི།",
    "ལྟ་བའི་མིག་གིས་དཔྱད་དེ་བགྲོད་པའམ།",
    "ཇི་ལྟར་བརྟགས་ཀྱང་བདག་ཡིད་འཕྱང་མོ་ཉུག།",
    "རྒྱལ་བའི་དགོངས་པ་གང་གིས་མཚོན་དུ་མེད།",
    "དེ་དག་ཉིད་དང་ཀུན་གཟིགས་པདྨ་དཀར།",
    "རང་གི་རང་ཉིད་དཔེ་རུ་མཚོན་པར་གྱིས།",
    "ཁྱོད་ནི་བརྩེ་བས་ཕྱག་ན་པདྨོདང་།",
    "མཁས་མཆོག་ཁྱེད་ནི་སྒྲ་དབྱངས་ལྷ་མོ་བཞིན།",
    "ལྷ་མོ་ཁྱོད་ནི་འཇམ་དཔལ་དཔའ་བོ་བཞིན།",
    "མགོན་པོ་ཁྱོད་ཀྱིས་གདུལ་བྱ་དྭང་བ་འདྲེན།",
    "གསལ་དག་སྙན་པའི་ངག་གི་འདོམས་པ་ནི།",
    "བྱིལ་བཞིན་དུ་སྟག་མོ་འཛུམ་རིས་བཀྲ།",
    "བུད་མེད་རྣམས་བཞིན་སྐྱེས་པ་གཡོ་སྒྱུ་ཆེ།",
    "གཡོ་མེད་བདག་ལ་གཟིགས་ཤིག་དབྱངས་ཅན་ཨ།",
    "ཕྱག་གི་པདྨ་ཕྲག་གོང་གཡོ་བའི་རྩེར།",
    "རིག་པའིརལ་གྲི་འཛིན་པའི་ལྷ་ཁྱོད་ཀྱིས།",
    "སོར་མོའི་གེ་སར་མཛེས་པའི་ལྡིང་ཁན།",
    "བསྔགས་པའི་ཉི་མ་འཇུག་པའི་དྲི་བཟང་གིས།",
    "མིག་གི་འགྱུར་ལྡོག་གློག་གི་གྱ་གྱུཅན།",
    "མཁས་གྲུབ་ཡོངས་ཀྱི་ཕྲིན་ལས་མོག་པོར་བྱེད།",
    "རང་རང་མོས་པའི་བློ་དང་མཚམས་པ་ཡི།",
    "ལས་དང་མཆོག་གི་དངོས་གྲུབ་མ་ལུས་པ།",
    "ཤེས་བྱ་ནང་གི་དེ་ཉིད་གསལ་མ་ལགས།",
    "འདི་ནི་ཁྱོད་སྐུ་མ་ཡིན་གངས་ཀྱི་རི།",
    "ཁྱོད་གསུང་ཅི་ཞིག་སེངྒང་རོ་ངེས།",
    "ཤེས་རབ་གསུམ་གྱི་ལུས་རྩལ་རྒྱས་པའི་མོད།",
    "མགོན་ཁྱོད་བློ་གསར་སྐྱེ་བོ་ཚོགས་པའིདབུས།",
    "གཙུག་གི་རྒྱན་དུ་འོས་པ་ཁྱོད་ལས་གཞན།",
    "བསླབ་གསུམ་རེས་འཇོག་མེད་པར་བསྟེན་པར་བྱ།",
    "དོན་གཅིག་གི་གསལ་བྱེད་ནི།",
    "དད་པའི་རྗེས་འབྲངས་དག་གིས་སྒྲུབ་བརྒྱུད་བཟུང་།",
    "ཚངས་པའི་སྲསམོ་ཡིད་མཁར་འགོག་པ་མེད།",
    "གསེར་གྱི་བཅུད་ལེན་དངུལ་ཆུ་སྲང་གཅིག་གིས།",
    "ཁྱོད་ཀྱི་དགོངས་པ་གང་།",
    "གལ་ཏེ་མཁས་པའི་ཤེས་རབ་ཉག་གཅིག་གིས།",
    "རང་ཡང་འཇིགས་པའི་བློ་སྣང་བསྐྱེད་མོད་ཀྱང་།",
    "བདག་གིས་སྐྱོབས་པའི་ནུས་པ་ཐོབ་པར་སྨོན།",
    "གཞན་དོན་ཐུགས་རྗེས་རེ་བ་སྐོང་ནུས་པའི།",
    "མི་མངོན་དབྱིངས་སུ་གཤེགས་པའི་ཚུལ་ལ་གཟིགས།",
    "གཞན་དོན་འགྱུརན་རང་གི་སྲོག་ཀྱང་གཏོང་།",
    "མཁས་པ་གཟུགས་དང་ལང་ཚོ་ཆེས་དམན་ཀྱང་།",
    "དང་པོ་གཅིག་གི་ལྡོག་པ་ཅན་ནི།",
    "ཁྱོད་ལ་ཟག་མེད་ཡོན་ཏན་རྫོགས་པས་སོ།",
    "ཅི་འདོད་མོད་ལ་སྩོལ་བའི་དཔལ་མངའ་ཡང་།",
    "འདོད་དགུའི་ཆར་འབེབས་བསམ་པའི་རེ་བ་། སྐོང་ དགའ་བདེའི་དཔལ་ལ་སྤྱོད་པའི་མཐུ་མངའ་ཡང་།",
    "དོན་དམ་ག་ཟིགས་པའི་བློ་དང་མི་ལྡན་ཕྱིར།",
    "འདྲེན་མཆོག་ཁྱོད་ལས་ཡིད་བཞིན་ནོར་བུ་དམན།",
    "མགོན་ཁྱོད་གསུང་དང་ལྷ་ཡི་རྔ་སྒྲ་ཆེ།",
    "ཁྱོད་ཀྱིས་གདུལ་བྱ་མཆོག་གི་ས་ལ་འགོད།",
    "ནང་གི་ཡེ་ཤེས་སྣང་བ་འགོག་པར་བྱེད།",
    "མ་ཕྱིས་ངང་གིས་དྭངས་པ་སྟོན་ཀའི་མཁར།",
    "གཉིས་པ་ནང་གི་རྒྱུ་ཅུང་ཟད་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
