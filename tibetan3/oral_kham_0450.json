    "འཆི་བ་ལ་ཇེ་ཉེ་ཇེ་ཉེར་འགྲོ་བ་དེར་འདུག།",
    "རང་བས་རྒན་པ་ཡང་ཅི་ཙམ་ཞིག་ཤི་འདུག།",
    "མཉམ་པ་དང་གཞོན་པ་ཡང་ཅི་ཙམ་ཞིག་ཤི་འདུག་བསམས་ན་ད་ལྟ་ཡོད་པ་བས་ཤི་བ་མང་།",
    "དེ་དག་ཀྱང་ཚེ་ཚད་དུ་ཐུབ་ནས་ཤི་བ་ཙམ་ཆེར་མི་འདུག།",
    "བྱས་ནས་ཕྱི་བཤོལ་དུ་འཇོག་པའི་ཐབས་རང་འདུག་གམ་སྙམ་དུ་བསམ།",
    "གོམས་དགོས་ལྷོངས་སུ་གྱུར་དགོས་པ་འདུག།",
    "དེ་ཡང་སྟོད་བཏུབས་ཙ་ན་སྨད་འགྲིག།",
    "སྨད་བཏུབས་ཙ་ན་སྟོད་འགྲིག།",
    "བཟོད་པའི་གོ་སྐབས་ཅུང་ཟད་ཀྱང་མི་འདུག་སྟེ་ལན་ཅིག་དེར་སྐྱེས་ཟིན་ནས་ཟློག་པའི་ཐབས་མེད།",
    "འགྲོ་སྡོད་ཀྱི་ས་ཙམ་ཡང་མི་རྙེད་པའི་ཚུལ་ཙམ་དུ་ཡོད་པར་གདའ།",
    "དེ་ལས་སྐྱོབ་པའི་སྐྱབས་ཞིག་དགོས་པར་འདུག།",
    "ལས་འབྲས་སེབ་ཚགས་སུ་གཏོང་བའི་ལུགས་ཀྱང་འདུག་སྟེ།",
    "བཅུ་བོ་དེ་དག་དུས་རྒྱུན་དུའམ་དལ་བར་འདུག་པའི་དུས་སུ་མི་བྱེད་པར་མ་ཟད།",
    "ཡང་དགེ་སྡིག་གཉིས་མ་ཡིན་པའི་ལས་ལུང་མ་བསྟན་ཞེས་བྱ་བ་འགྲོ་འཆག་ཉལ་འདུག་སོགས་ངེས་མེད་སྣ་ཚོགས་པ་ཞིག་འདུག་པ།",
    "དེ་དག་ལ་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མེད་ཀྱང་དོན་མེད་དུ་དུས་འདའ་པར་འདུག།",
    "དྲན་ན་གཞན་མི་དགོས་སྐྱེ་བའི་སྡུག་བསྔལ་གཅིག་པུ་ལ་བསམ་ཀྱང་མིར་སྐྱེས་པ་ལ་གྲོག་ཅི་ཡང་མི་འདུག།",
    "མིའི་འགྲོ་བ་མངལ་སྐྱེས་ཀྱི་སྡུག་བསྔལ་ནི་དེ་ལྟ་བུར་འདུག།",
    "འདུག་པ་ན་ཚ་དོ་ཐག་པ་ཆད་པ་བཞིན་སྡོད།",
    "ཕ་མ་སྤུན་ཟླ་ཁྱིམ་ཐབ་གྲོགས་ལ་སོགས་པ་མེད་ཐབས་མེད་པ་དང་བྲལ་ཙ་ན།",
    "ཐོས་བསམ་གྱི་གོ་བ་ཙམ་ཞིག་ཡོད་པ་སྲིད་ནའང་རང་བློའི་འཆར་ཚུལ་ལ་བརྟགས་ན།",
    "གང་ཡང་མི་ཤེས་པའི་མུན་ཐོམ་མེ་བའི་རྣམ་རྟོག་གཅིག་འདུག་པ་འདི་ཀ་ཡིན།",
    "ཡང་རང་ངམ་རང་ཕྱོགས་ལ་གནོད་ན་དེ་ལ་ཞེ་སྡང་འབྱུང་སྟེ།",
    "རང་གཅིག་པུ་གྲོལ་བའི་ཐབས་སྒྲུབ་པ་དེ་ཁྲེལ་མེད་གདོད་ཆུང་ཕྱི་ཐག་མེད་པ་གཞན་དོན་སྤངས་པའི་ཐར་བར་འདུག་པ།",
    "དེའི་རྒྱུར་བྱམས་པ་དགོས་པར་འདུག།",
    "དེའི་རྒྱུར་བྱས་པ་ཤེས་ཤིང་དྲིན་དུ་བཟོ་བ་དགོས་པར་འདུག།",
    "རྒྱུ་འབྲས་རིམ་པ་ལྟར་མཛད་པ་འདི་ཁར་འདུག།",
    "དེ་རྣམས་རྒྱུ་འབྲས་བདུན་ཡིན་བྱ་བ་ཡོད་པས་རྒྱུ་འབྲས་བདུན་གྱི་ཐ་སྙད་ཀྱང་ཕྱིས་ཀྱི་གསར་བྱུང་རང་མིན་པ་གོ་དགོས་སོ།",
    "དང་པོ་ནི་རྩ་བའི་མ་བྱ་བ་ཚེ་འདི་བསྐྱེད་པའི་མ་ལ་ཟེར་བ་ལགས་ཏེ་འདི་བདག་ལ་དྲིན་ཆེ་བར་འདུག།",
    "ལས་ལ་འཁོལ་བ་དང་ཆད་པས་བཅད་པ་སོགས་དངོས་སུ་རང་ཡང་སྡུག་བསྔལ་འདི་མི་མྱོང་བྱ་བ་མེད་པ་དེར་འདུག།",
    "གད་ཁ་གཡང་ཁ་ཅིག་ནས་མར་ལྷུང་ལ་ཁད་ཁད་འདུག་ན་བདག་ཅི་ཙུག་བྱེད།",
    "སྡུག་བསྔལ་དེ་བདག་གྀ་ཐོག་ཏུ་བབས་ན་ཆ་ཤས་ཙམ་ཡང་བཟོད་པའི་གླགས་མི་འདུག།",
    "མ་འདི་རྣམས་བདེ་དགོས་པར་འདུག།",
    "སྐྱིད་དགོས་པར་འདུག་པ་ལ།",
    "འོན་ཀྱང་དེའི་ནུས་པ་བདག་ལ་མི་འདུག།",
    "གཉེན་པོས་མ་སླེབ་པར་ཐུན་ཚོད་གཅིག་འདས་ན་སེམས་བསྐྱེད་གཏོང་བ་ཡིན་པར་འདུག།",
    "ང་བདག་ཅེས་པ་གནས་ཚུལ་ལ་གྲུབ་པ་ཡེ་མེད་པར་འདུག་སྙམ་དུ་བསམ།",
    "དེས་ན་ལུས་ཞེས་བྱ་བ་བློས་བཏགས་པ་མ་གཏོགས་བདེན་པར་མི་འདུག།",
    "བདེ་སྡུག་བཏང་སྙོམས་མྱོང་བ་སོགས་ཚོར་བར་འདུག་སྟེ།",
    "མཐོ་དམན་བཟང་ངན་མིང་དོན་སྣ་ཚོགས་འཛིན་པ་སོགས་འདུ་ཤེས་སུ་འདུག་སྟེ།",
    "ད་ཤེས་པའི་རྣམ་གྲངས་དེ་ཐམས་ཅད་ཀྱང་རིག་རིག་ཏུར་ཏུར་པོར་འདིའི་རྣམ་འགྱུར་མ་གཏོགས་ཚུགས་ཐུབ་ཏུ་མི་འདུག།",
    "ད་ལྟའི་རིག་པ་སྐད་ཅིག་མ་བྱས་ཀྱང་རང་ངོས་ནས་བདེན་པར་གྲུབ་པ་མེད་དེ་སྐད་ཅིག་གཅིག་པོ་དེ་ལའང་སྔ་མ་དང་འབྲེལ་བ་སྐྱེ་བའི་ཆ་གཅིག་དང་།",
    "གང་ཡང་གཅིག་པུའི་ངོ་བོ་མ་གྲུབ་པ་དེར་གདའ།",
    "ཡང་རང་གཞན་སྣོད་བཅུད་མཐོང་ཐོས་གཟུགས་ཅན་ཐོགས་བཅས་ཐམས་ཅད་ནི།",
    "ད་འདི་ལ་གེགས་སེལ་གྱི་ཐ་སྙད་གསུང་བར་གདའ།",
    "དགྲ་གཉེན་ལོངས་སྤྱོད་གཏམ་སོགས་ཀྱི་རྣམ་རྟོག་རགས་པ་དེ་ཀ་འདུག་ན།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "དེ་གཉིས་ནི་གོ་རིམ་བཞིན་དུ་རྟེན་དང་བརྟེན་པ་ཡིན་ཞིང་རང་བཞིན་གྱི་རིགས་ཙམ་དེ་རྒྱུར་ཡོད་ལ་ཡོན་ཏན་མངོན་དུ་མ་གྱུར་པས་འབྲས་བུར་མེད་ཅིང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ་ཞེས་སོ།",
    "གལ་ཏེ་གཞན་ལ་གནོད་པ་མི་བྱེད་ཀྱང་རང་ཉིད་འབྱོར་པའི་ཚེ་རྒྱགས་པ་དང་།",
    "ཤེས་སྒྲིབ་ཀྱི་ཕྱོགས་གཅིག་གཟུང་རྟོག་ཀྱང་སྤང་རུང་དུ་འདུག་པ་འབྲིང་སྟེ་རང་རྒྱལ་གྱི་རིགས་དང་།",
    "གདུལ་བྱའི་སེམས་ཇི་ལྟར་འདུག་པ་ལྟར་རྟོགས་པ་གཞན་གྱི་སེམས་ཤེས་པ་དང་།",
    "སྤྱོད་ཡུལ་གོང་དང་རང་ས་ཡི།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "མི་ན་བར་སྟན་ཆེས་མཐོ་བ་ལ་འདུག་པ་མ་ཡིན།",
    "འོ་ན་དེ་གཉིས་ཀྱི་ཉེས་དམིགས་དང་ཕན་ཡོན་དེ་དག་དུས་ཇི་སྲིད་ན་མྱོང་བར་འགྱུར་ཞེ་ན།",
    "ཡང་ན་གཡེང་བ་སྟེ་སེམས་རྣལ་དུ་མི་འདུག་པའི་ཕྱིར་རམ།",
    "ཕུང་པོ་རྣམས་ནི་དུས་གཞན་ན་ཡང་བརྟན་པར་འདུག་གོ་ཞེས་ཟེར་རོ་ཞེས་བྱུང་ངོ།",
    "བདག་ཉིད་འདུག་པ་ནི་དེ་ལྟ་བུའི་འབད་རྩོལ་ལ་མ་ལྟོས་པར་ཀ་བུམ་ལ་སོགས་པ་དམིགས་པ་ལྷན་སྐྱེས་སོ།",
    "ཨ་ཇོ་གནའ་བས་མ་ཞུས་པའི།",
    "ཉ་ཡི་བརྒྱུད་པ་ཚར་ཉེན་འདུགད་ནི་མཁྱེན་ལྡན་ཚང་མ་ཡིས།",
    "ཆེ་བའི་ཆུ་ཀླུང་རང་དགར་འགྲོ་བཅུག་ནས།",
    "མི་མང་དོན་བྱེད་ཟེར་ཞིང་རང་འདོད་སྒྲུབ།",
    "གཞན་མགོ་བསྐོར་ཐུབ་རིག་པ་ང་རང་གྲུང་།",
    "ཁྱེད་རང་འདུ་ཁང་སྟེང་དུ་སྤོས་གསུངས་པ་ལྟར་དེ་ནས་བཟུང་འདུ་ཁང་ཡང་རྩེར་ཕྱགས་ཕེབས་ཏེ་བཞུགས།",
    "འཇིམ་པ་ཁོ་ན་ཚོན་གང་ཙམ་ལས་མི་འདུག་པར་གསུངས།",
    "ད་ནི་བཏོན་པ་དང་མ་བཏོན་པ་གཉིས་ཀྱིས་བསྟན་པ་ལ་གང་ཕན་མི་ཤེས་པར་འདུག་གསུངས་ཏེ་ཞལ་བཞེས་མ་གནང་བ་ལ་སླར་ནན་གྱིས་ཞུས་པས།",
    "དགོན་འདིར་འཆད་ཉན་བྱས་ཚུལ་ཁྱེད་རང་རྣམས་ངེས་པ་དེ་ཡིན།",
    "མི་དེ་ཐམས་ཅད་ཀྱིས་རྒད་པོ་ལས་ཅན་ཞིག་ཅེས་ཟེར་ནས་བལྟ་བར་འདུག་པ་རྨིས་ཞེས་ཐོས།",
    "ཞེས་གསུངས་པ་ལྟར་གཡོ་དང་སྒྱུ་མེད་ཅིང་རང་བཞིན་དྲང་བས་གསུང་ནི།",
    "དེ་དག་ནི་སྐུའི་སྐྱེ་བ་འདིའི་མཛད་པ་ཇི་ལྟ་བ་བཞིན་འདུག་པས་ངོ་མཚར་བར་སྣང་ངོ།",
    "ད་ང་འཆི་བར་འདུག་པས་བན་དྷེ་ལ་ངོ་ཞིག་ཐུག་དགོས་ཟེར་ནན་ཆེར་བྱས་པས།",
    "ཕྱུགས་ཉོ་འཚོང་བྱེད་པ་དང་མི་གཞན་གྱི་བྱ་སྤྱོད་འགྲོ་འདུག་ཐམས་ཅད་སྨྱོན་པའི་ཟློས་གར་ལྟར་ཡིད་དུ་མི་འོང་ཞིང་།",
    "དབུས་སུ་ཕེབས་མ་བཅུག་ཕྱིན་འདིར་ཅིས་ཀྱང་མི་འདུག་ཕྱོགས་གཞན་ཞིག་ཏུ་ལྡོམ་འགྲོ་ཡང་ན་འཆི་བ་ཡིན་དེ་ལས་འོས་མེད་གསུངས་འགགས་མཛད།",
    "ཁོ་རང་གཉིས་ཀྱིས་ཀྱང་ཕེབས་པར་གནང་།",
    "དེ་ནས་རྗེ་འདི་ཁུ་ཚན་གཉིས་དང་མི་གཞན་འགའ་ཞིག་འདུག་པ་མཉམ་དུ་ཕྱིན་ཁོང་ལ་མཇལ་བས།",
    "དེ་ནས་སྐུ་ཞང་ཕྱིར་འབྱོན་ཁ་གཞན་གྱིས་བསྐུལ་མ་དང་རང་ཉིད་ཀྱང་བཞུགས་འདོད་ཆེན་པོ་བྱུང་ནས་ཞང་བོ་ལ་གནས་ཚུལ་ཞུས་པས།",
    "རྗེ་འདིའི་ཞལ་ནས་དེ་འདྲ་ཅང་མེད་དཔོན་སློབ་ལ་ཞུ་བ་ཡིན་འགྲོ་ཞུས་པས།",
    "ཉམས་མཚར་འབྲས་སྤུངས་གླིང་ཐམས་ཅད་ལ་དེ་ལྟར་གྲགས་འདུག་གསུངས།",
    "དེ་ནི་ད་ལྟ་བསམ་ན་སྙན་པ་ལྷས་སྒྲོག་ཟེར་བ་དེ་ཡིན་འདུག་པས།",
    "ད་ནི་ཚེ་འདི་ངེས་པ་འགའ་མི་འདུག་པས་རི་ཁྲོད་ཅིག་འགྲིམ་དགོས།",
    "ཁོང་ལ་ཡང་གཅིག་གཏད་བྱུང་བའི་མི་དེ་ཤིན་ཏུ་ཉམ་ཐག་པ་འདུག་པས།",
    "མི་ཆེན་མཐའ་དག་ལ་དེའི་ལུགས་ཀྱི་ཞུ་སྟབས་བསྒྲིག་འདུག་ཟེར།",
    "ཉམས་སྣང་ལ་ཤར་བའི་དགོན་དེ་འདི་ཡིན་པ་འདུག་སྙམ་པ་ཤར་གསུངས།",
    "རྒྱུད་ཆེན་ཕེབས་ཁར་ཁྱེད་གསང་སྔགས་ཀྱི་བདག་པོ་གཅིག་འདུག་ཀྱང་།",
    "ཆབ་གཏོར་ཞིག་མཛད་ཀྱིན་འདུག་དེ་གར་ཕེབས་དགོངས་པས།",
    "དེ་རྗེས་མཚམས་བསྡམས་ཏེ་ཁྲིད་དམིགས་སྐྱོང་བར་མཛད་པའི་སྲོལ་འདུག་པའི་ལུགས་མཛད།",
    "གཞིས་ཀ་རྩེར་ས་དགེ་ཐམས་ཅད་འཚོགས་དུས་དེ་མེད་མི་རུང་འདུག་ཟེར་ནས།",
    "དེ་ན་ས་ཀར་འབྲུག་མང་བོ་འདུག་པས།",
    "དེ་ཀ་ཆོག་པ་འདུག་གསུངས།",
    "རྗེ་འདི་འདྲ་མ་བྱུང་འདུག་པས།",
    "རྣམ་གཉིས་ཕན་ཚུན་དད་གུས་ཆེ་བས་ངོ་བསྟོད་ཡིན་བསམ་འདུག་ཀྱང་།",
    "ཅེས་པ་ཡིན་འདུག་དེ་ནས་མྱུར་མཛད་ཡེ་ཤེས་མགོན་པོ་ཕྱག་དྲུག་པའི་རྗེས་གནང་བར་ཆད་ཀུན་སེལ་དང་།",
    "ལྷག་ཏུ་ཞྭ་ལུ་བའི་དྲུག་ཅུ་བའི་རྩ་ཚིག་ལ་ཟིན་བྲིས་གནང་ཡོད་པ་དེ་ལྟ་བུ་དེ་ཕྱིན་གྱི་མཁས་པ་སུས་ཀྱང་མ་གོ་འདུག་སྙམ་པ་ཤར།",
    "ཞལ་བཞེས་གནང་ནས་ཕྱིས་སུ་གང་ཞུས་ལྟར་རྒྱུད་གྲྭ་བཙུགས་འདུག་ཅེས་སྤྲོ་དགའ་ཡང་ཡང་མཛད།",
    "དེ་རྗེས་ང་རང་དགེ་འཕེལ་ལ་ཁྱེད་ཀྱི་སྐུ་མདུན་དུ་ཡར་ཡོང་།",
    "ལྟས་གཞན་ཡང་ལེགས་པོ་མི་འདུག་པས།",
    "ཁོ་རང་བདེན་པར་བཟུང་ནས་གཏོར་སྒམ་དེ་ངས་ཞག་གཅིག་གཉིས་ནས་ཐབས་བྱས་ཁྱེར་ཡོང་།",
    "ང་རང་གཉིས་ཀྱི་ལམ་མགོ་ཐོན་པ་བྱས་ཡོད།",
    "མི་ཚོ་ལ་མགོ་བསྐོར་ཅིག་ཡིན་འགྲོ་གསུངས།",
    "རྫུ་བྱས་པ་མཁྱེན་འདུག་ཀྱང་གཞུང་ལ་ཕོག་དོགས་ནས་གཞན་ལ་གསུང་བར་མི་མཛད།",
    "རྗེ་འདིའི་ཞལ་ནས་འདི་ནི་མགོན་པོ་དངོས་གནས་པ་ཡིན་འདུག་གསུངས།",
    "སྔ་སོར་དེའི་ལས་སྣ་ལ་རྩོད་འདུག་ཆེ་ཡང་།",
    "ད་ཕྱིན་ཆད་གང་ཐད་ནས་དཀའ་བར་འདུག་དེ་ལས་མཆོད་གཞི་གཅིག་ཞུས་ན།",
    "དེ་ལ་ཅི་འདུག་ལྟོས་གསུངས།",
    "སྡོམ་བརྩོན་ཕལ་བའི་ཚུལ་གྱིས་འདི་ན་འདུག།"
  ]
}