    "དབྱིབས་ལེགས་པ་གཅིག་གདའ་ཡིས་བཞེས་ཤིག་ཅེས་ཡོན་ཏན་ཅི་རིགས་པར་བརྗོད།",
    "དེའི་འོག་ཏུ་ཁོང་སྤྲོ་བར་གདའ་བས་དགག་དབྱེ་བྱེད་པ་བསྐོ་བའི་གསོལ་གཉིས་ཀྱི་ལས་ཀྱི་ཐོག་མར་གསོལ་བའི་ལས་ལ་ཐུགས་གཏད་པར་ཞུ་བྱས་ལ།",
    "གཞོན་ན་ཐུགས་གཏད་པར་ཞུ་བ་ཕུལ་ལ་སྤྱོད་ལམ་ཙོག་པུར་འདུག་སྟེ།",
    "བརྒྱན་པ་ཐོགས་ཏེ་རྒན་ལོགས་སུ་འདུག་ནས་ལན་གསུམ་བརྗོད་པའོ།",
    "ཡུལ་དགེ་སློང་བཞིའི་མདུན་དུ་འདུག་སྟེ།",
    "སྤྱོད་ལམ་ཙོག་པུར་འདུག་སྟེ།",
    "བྱ་བ་རྩོམ་པའི་ཚེ་ཉིད་ལ་འདི་རུང་བར་འདུག་གམ་མི་རུང་བར་འདུག་སྙམ་དུ་འཕྲལ་ལ་རྟོག་པ་ཡིན་ཏེ།",
    "འགའ་ཞིག་སློབ་དཔོན་རྩོམ་པ་ལ་མཁས་པས་ང་རང་ཚིག་རྒྱན་ཡིན་ཟེར།",
    "སེམས་བྱུང་ལ་གཙོ་བོ་དང་གཙོ་སེམས་ལ་འཁོར་དུ་བཞག་འདུག་པའི་ཕྱིར་ཞེ་ཟ་ན་སྐྱོན་མེད་དེ།",
    "ཞིག་ནས་འདུག་པའི་བསྐལ་པ།་",
    "དེ་ཉིད་དེ་ཉིད་མ་མཐོང་རང་བཟོར་སྤྱོད།",
    "པར་བྱེད་པས་སོ་ན་འདུག་པ་ལ་སྒྲིབ་པའི་ཕྱིར་དང་།",
    "རང་བཞིན་དུ་མི་འདུག་པ་ཉིད་དང་།",
    "དེ་དག་ཀྱང་རང་དང་དུས་མཉམ་ལ་རྒྱུ་གཉིས་དང་།",
    "ཚངས་པ་ཆེན་པོའི་མདུན་དུ་འདུག་སྟེ་ཚིག་འདོན་པས་དེའོ།",
    "བརྒྱ་བྱིན་སྟན་གཅིག་ལ་འདུག་པ་ན་མིག་འབྱེད་འཛུམ་ཡོད་མེད་མ་གཏོགས་པ་ཁྱད་པར་མེད་པར་བཀའ་སྩལ་བས་སོ།",
    "མཐར་ཐུག་དུས་ནི་སྐད་ཅིག་འདོད།",
    "དེ་ལ་ཚེས་བཅོ་ལྔ་ལ་ངོ་གདོང་དང་བཅས་པ་བཀྲུས་ནས་བསྙེན་གནས་བྱས་ཤིང་བློན་པོའི་ཚོགས་ཀྱིས་བསྐོར་ཏེ་འདུག་པ་ན།",
    "ཉི་མ་ལྡོག་དུས་ངོས་འཛིན་པ་ལ་བྱེད།",
    "ཞིག་ནས་འདུག་པའི་བསྐལ་པ།",
    "ཞིག་ནས་འདུག་པ་ཚན་གཅིག་དང་དུས་མཉམ་པའོ།",
    "ཕུང་པོ་བཞི་ལས་དོན་གཞན་དུ་གྱུར་པའི་འདུས་བྱས་ཞེས་གསུངས་པ་ནི་ལྡན་མིན་འདུ་བྱེད་རྫས་སུ་གྲུབ་ཅིང་རང་གང་ལ་ལྡན་པའི་གནས་སྐབས་ཅན་དེ་ལས་རྫས་གཞན་དུ་འདོད་པའི་ལུགས་སོ།",
    "ཡང་དད་པས་དང་ཆ་འཛིན་པ་ཡང་རང་སྟོབས་དང་།",
    "གཞན་གྱི་ཡུལ་ན་འདུག་པ་ལྟར་རོ་ཞེས་གསུངས་ལ།",
    "དཔེར་ན་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་དེས་རྟོག་པའི་ཡུལ་ལ་ཞེན་པ་མ་ཡིན་ཡང་དེའི་རྫས་ལ་ཡུལ་ལ་ཞེན་པའི་ཆ་ཡོད་པ་ནི་རྟོག་པ་ཡིན་གྱི་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་མ་ཡིན་པ་བཞིན་ནོ།",
    "བཏང་སྙོམས་ནི་དུག་གསུམ་མེད་པ་བརྩོན་འགྲུས་དང་བཅས་པ་ལ་གནས་ནས་སེམས་རྣལ་དུ་འདུག་པའི་སེམས་བྱུང་།",
    "རང་རང་བསྣན་པས་ཉི་ཤུ་རྩ་གཅིག་དང་ལྡན་ཏེ།",
    "སྔར་བག་ཆགས་བསྒོ་བར་བྱ་བའི་གཞི་དེ་འབྲས་བུ་དེ་དང་དེ་སྐྱེད་པའི་ནུས་པ་དང་མི་ལྡན་པའམ་ནུས་པ་མཐུ་ཆུང་ངུར་འདུག་པ་ལ་ཕྱིས་ནུས་པ་དང་ལྡན་པའམ་ནུས་པ་མཐུ་ཅན་དུ་གྱུར་པ་དགོས་པའི་ཕྱིར་རོ།",
    "ཆ་ལས་ཕྱི་རོལ་ལྟ་བུར་འདུག།",
    "རྣམ་པར་ཤེས་པ་དང་མིང་དང་གཟུགས་མདུང་ཁྱིམ་ལྟར་གཅིག་ལ་གཅིག་བརྟེན་པའི་ཚུལ་གྱིས་འདུག་པར་གསུངས་པ་གང་ཡིན་པ་དེའང་མི་རུང་སྟེ།",
    "འདུག་པའི་བྱ་བས་སྨྲ་བ་པོར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "གནས་པ་པོ་མིན་འགྲོ་བ་མིན།",
    "དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་དུ་མེད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེས་ཀྱང་བརྗོད་པར་མི་ནུས་ཏེ།",
    "བགྲོད་པར་བྱ་བའི་ལས་ལམ་གསུམ་ཀ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་དེའི་ཁོངས་སུ་འདུས་པས་སྐྱེ་མཆེད་རྣམས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ་སྙམ་ན་ཕུང་པོ་རང་བཞིན་གྱིས་མ་གྲུབ་པར་བསྟན་པའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་འདི་བཀོད་པ་ཡིན་ནོ།",
    "ཡོད་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁོ་བོ་ཅག་དུས་གསུམ་རྫས་སུ་འདོད་པས་མ་འོངས་པ་ན་རྩ་བའི་སྐྱེ་བ་སྐྱེ་བཞིན་པ་ཡོད་པ་དེས་སྐྱེ་བའི་སྐྱེ་བ་བསྐྱེད་པར་བྱེད་ལ།",
    "སྣང་མུན་ཡུལ་གཅིག་ཏུ་འགལ་བས་མར་མེ་དང་ནི་ཡུལ་གཞན་གང་དག་ལ་མར་མེ་དེ་འདུག་པ་ན་བསལ་བྱའི་མུན་པ་མེད་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་དུས་གཉིས་པར་འགག་བཞིན་མ་ཡིན་པ་དེ་ནི་དངོས་པོར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "མཚན་ཉིད་སྐྱེ་དང་གནས་དང་འཇིག་པ་རྣམས་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར་ན་འདུས་བྱས་ཀྱི་མཚན་གཞི་གཟུགས་སོགས་རྣམས་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "རབ་ཏུ་བྱེད་པའི་འབྲེལ་ནི་དེ་ལྟར་ཉེ་བར་ལེན་པའི་ཕུང་པོ་དང་ཉེ་བར་ལེན་པ་པོའི་བདག་གཉིས་ཕན་ཚུན་ལྟོས་དཀཟ་ད་༥ཧ་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་མི་འགལ་ཏེ།",
    "ལྟོས་པ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་སྟེ།",
    "རང་ཉིད་སྔ་ཞིང་རང་དང་གཞན་གྱི་རྒ་ཤི་ཕྱི་བ་ཡིན་པའི་ཕྱིར།",
    "ཁྱབ་བྱེད་རང་བཞིན་དང་ནི་གཞན་དངོས་དག་ཡོད་ན་དངོས་པོ་གྲུབ་པར་འགྱུར་ན་ཡང་རང་བཞིན་དང་གཞན་དངོས་མ་གྲུབ་པའི་ཕྱིར།",
    "གཉིས་པ་ནི་ཆུད་མི་ཟ་དེ་ཡང་རང་བཞིན་ལུང་དུ་མ་བསྟན་པ་སྟེ།",
    "དེས་ན་ལས་ཐ་སྙད་དུ་འགགས་ཀྱང་རང་བཞིན་གྱིས་མི་འགག་པའི་དོན་ནི།",
    "ཟ་བ་པོ་དེ་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་སྟེ།",
