    "སྐུ་ཚེའི་ཚད་ཀྱང་བདུན་ཅུ་ལྷག་པར་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "རྟོགས་པ་ལ་བོགས་ཆེན་པོ་ཐོན་པར་བྱུང་ཞེས་ཕེབས།",
    "དེའི་རྐྱེན་གྱིས་ཐུགས་ཀྱི་མྱ་ངན་ཀྱང་རིམ་པར་སངས་ཤིང་ཡིད་རྣལ་དུ་ཕེབས་ཏེ་བཞུགས་པར་གྱུར་ཏོ་ཞེས་གྲགས་སོ།",
    "སྨིན་གྲོལ་གསན་བཞེས་ཐབས་ཚུལ་དུ་མས་ཐེག་དགུའི་གླིང་ལ་སྤྱོད་པའི་ཚུལ།",
    "རྒྱལ་བའི་བསྟན་ལ་རིམ་པར་འཇུག་པའི་ཚུལ།",
    "གནས་ཚང་དུ་བྱས་པ་བློ་དང་ལྡན་པའི་སྐལ་བཟང་སུ་ཞིག་མཆིས།་",
    "སྨིན་གྲོལ་གསན་བསམ་དང་གཙོ་ཆེར་འབྲེལ་བའི་སྐུ་གཞོན་དུས་ཀྱི་རྣམ་པར་ཐར་བའི་གནས་སོ་སོར་ཕྱེ་ནས་བསྟན་པའི་སྐབས་སོ།",
    "སྒོམ་སྒྲུབ་ཉམས་ལེན་དང་གཙོ་བོར་འབྲེལ་མེ་བའི་སྐུ་ཚེ་སྟོད་ཀྱི་རྣམ་པར་ཐར་བའི་གནས་སོ་སོར་ཕྱེ་ནས་བསྟན་པ།",
    "དུས་གསུམ་གཤེགས་པའི་རྣམ་འདྲེན་ཡོངས་ཀྱི་མཁྱེན་བརྩེའི་སྟོབས།",
    "ལེགས་པར་བསྟན་པའི་མངའ་བདག་མཚུངས་མེད་དཔལ་ལྡན་ཤར་རྫ་བ།",
    "བསླབ་གསུམ་རིམ་གཉིས་བདུད་རྩིའི་བཅུད་ལ་རྟག་པར་རོལ་པའི་ཐབས་མཁས་ཀྱིས།",
    "དེ་ཡང་དོན་གཉིས་པ་སྒོམ་སྒྲུབ་ཉམས་ལེན་དང་གཙོ་བོར་འབྲེལ་བའི་སྐུ་ཚེའི་སྟོད་ཀྱི་རྣམ་པར་ཐར་བའི་གནས་སོ་སོར་ཕྱེ་ནས་འགོད་པ་ལ།",
    "ཁྱད་པར་བསྟན་པའི་བདག་པོ་དམ་པ་ཡབ་སྲས་དང་མཉམ་མེད་ཡབ་སྲས་ཀྱི་རྗེས་བཞག་འདི་ནི་བཀའ་སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པའི་བབས་སོ་ཡིན་ལ།",
    "དཀའ་བ་སྤྱོད་དབེན་པར་རྟོགས་པའི་བཅུད་ལ་ལོངས་སྤྱོད་ཕྱིར།",
    "བཞེས་གལ་རིང་ནས་སྨོན་པའི་འདུན་མ་བཤམས་ལ་རིངས།",
    "པ་ཉིད་རྫ་སྟེང་ཆེན་ཡུལ་དགོན་བྱིངས་ནས་གདན་འདྲེན་ཞུས་ནས་ཆགས་ཕེབས་སྐབས།",
    "བཀའ་བཞིན་བསྒྲུབ་པའི་ཐུགས་འདུན་སྐྱེས་ཏེ་དྲན་པ་ཡབ་སྲས་ཀྱི་དྲིལ་སྒྲུབ་ཀྱི་སྐུ་མཚམས་ཞག་བརྒྱར་བཞུགས་པའི་ཉེ་གནས་པ་བྱས།",
    "སྨིན་གྲོལ་གྱི་གདམས་པ་མཐའ་ཡས་པ་ཞུས་ནས་དེ་སྔོན་སྒྲུབ་པ་དང་ཉམས་ལེན་ཡང་སྐབས་ཅི་རིགས་སུ་འབད་རྩོལ་བྱས་ཀྱང་།",
    "མ་དེ་ནས་དགུང་ལོ་སོ་གཉིས་བཞེས་པའི་སྐབས་སུ་མཆོག་སྤྲུལ་ཉི་མ་འོད་ཟེར་དང་དབྲ་སྲས་ཟླ་བ་གྲགས་པ་གཉིས་གྲྭ་སར་མཆོད་མཇལ་ལ་ཕེབས་གྲབས་གནང་བཞེད་སྐབས།",
    "ཕྱིས་སུ་དེ་ལ་བརྟེན་ནས་སྔོན་འགྲོ་བཀའ་ལུང་རྒྱ་མཚོ་བརྩམ་པ་ཡིན་གསུངས།",
    "བསང་གསོལ་དང་རྒྱུན་སྤྱོད་རིགས་ཀྱི་ལུང་རྣམས་གནང་བར་མཛད།",
    "ད་འཇའ་གུར་ནང་བསྡད་དགོས་པ་ཡིན་ཟེར་ནས།",
    "དེ་རྗེས་སྨོན་རྒྱལ་རྣལ་འབྱོར་པ་སྐལ་བཟང་རྡོ་རྗེ་བྱ་བ་བྱོན་ནས་ཞང་ཞུང་སྙན་བརྒྱུད་ཀྱི་འོད་གསལ་བདུན་སྐོར་གྱི་ཁྲིད་ཅིག་གནང་བར་ཞུས་པས།",
    "དེ་ཙམ་ལ་བློ་གཏད་བྱས་ནས་ཚེ་འདིའི་འདུན་མ་བསམ་པ་བཞིན་འོང་བའང་དཀའ་ཞིང་།",
    "ཉིད་ཀྱིས་ཀྱང་ཐུགས་ཉམས་ལ་ཧ་ཅང་འཐད་ཅིང་དགྱེས་ཚོར་ཆེ་བས་དེར་བཞུགས་པའི་འདུན་མ་གཏོང་བར་གནང་།",
    "དབེན་གནས་དེ་ཡང་གནས་ཆེན་གཡུང་དྲུང་ལྷུན་པོ་ཞེས་འཆི་མེད་རྒྱལ་བ་ཡབ་སྲས་ཀྱིས་ལན་ཅིག་མིན་པར་བསྔགས་པའི་གནས་ངོ་མཚར་རྨད་དུ་བྱུང་བ་དང་ལྡན་པ།",
    "གང་ཟག་ཐ་མལ་རང་ག་བ་དག་ཀྱང་གནས་དེར་སླེབ་པ་ཙམ་གྱིས་ཚེ་འདིའི་སྣང་བ་རང་འགགས་སུ་བྱེད་པར་ནུས་པ་སོགས་ཕྱི་ནང་གསང་བའི་ཡོན་ཏན་གྱི་ཁྱད་པར་མཐའ་ཡས་པ་དང་ལྡན་པ་ཞིག་ཡིན་ལ།",
    "དྲང་སྲོང་དང་གཙང་གཙུག་པའི་ཚོགས་དུ་མས་ཆེད་དུ་བཀང་བ་ལྟར་ཡོངས་སུ་གཏམས་པས་ཉེ་བར་བརྒྱན་པ་སྟེ།",
    "ཆོ་ག་འི་དབེན་གནས་འདི་འདྲ་མཆོག་ཏུ་རྙེད་པར་དཀའ།",
    "གསང་བར་རྩ་གསུམ་ལྷ་ཚོགས་བཞུགས་པའི་གནས།",
    "ལ་བརྟེན་ནས་བཞུགས།",
    "བཏུང་བའང་བ་ལུའི་ཁུ་བ་ཁོ་ན་ལ་བྱས།",
    "ཆང་གཏན་ནས་མི་བཞེས་པ་དང་པགས་གོས་སྤང་བ་སོགས་ཀུན་སྤྱོད་དངོས་གཙང་བ་མཛད།",
    "གཏང་ནས་བྱ་བྲལ་ཀུན་སྤངས་ཀྱི་རྣམ་པར་བཞུགས་པའང་།",
    "དེ་ལྟར་རྗེས་སུ་སྒྲུབ་པར་ཟེ་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "དངོས་སུ་སྒྲུབ་པ་ལ་འཇུག་པའི་ཚེ་འདུན་པ་དང་བརྩོན་འགྲུས་དྲག་པོའི་སྒོ་ནས་རྩེ་གཅིག་ཏུ་ཉམས་ལེན་ལ་འབད་པར་མཛད་དེ།",
    "རྒྱལ་འཕགས་གོང་མའི་མཛད་སྤྱོད་དང་ངེས་པར་མཚུངས་པའི་ངང་ཚུལ་ལ་གནས་པ་ཁོ་ན་སྟེ།",
    "སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པའི་མཛེས་རྒྱན་དུ་འགྱུར་བཟོད་པའི་རྣམ་པར་ཐར་བ་ཆེས་ངོ་མཚར་བའོ།",
    "དེའི་རྩལ་ལས་ཉམས་ཀྱི་མགུར་དུ་མ་ཆེད་དུ་མ་བཅོས་པར་བརྡ་དང་རྐྱེན་ཅུང་ཟད་ཙམ་ལ་བརྟེན་ནས་སྣང་བ་དཔེ་རུ་ཤར་བའི་ཚུལ་དུ་ཀློང་རྡོལ་དུ་བྱུང་སྟེ།",
    "པ་དེ་ལྟར་དབེན་པར་བཞུགས་པས་ཚེ་འདིའི་སྣང་བ་ཐམས་ཅད་སྦྲུལ་ཤུན་ལྟར་དོར།",
    "ཇི་ལྟ་བའི་དགོངས་པ་རྒྱུད་ལ་འཁྲུངས་པས་ཇི་སྙེད་པའི་མཁྱེན་རབ་ཀྱི་ཀློང་རྡོལ།",
    "ལྷུང་བཤགས་དྲི་མེད་མཆོག་སྦྱོང་།",
    "དམར་ཁྲིད་དགོངས་པ་ཡོངས་འདུས་རྣམས་ཀྱི་ལུང་གསན་པའང་གནང་།",
    "དེ་སྐབས་སུ་དགེ་སྦྱོང་གཡུང་དྲུང་བསྟན་འཕེལ་དེར་བྱོན་པ་ལ་ཉམས་ལེན་སྐོར་གྱི་བཀའ་འབྲེལ་གནང་ཞིང་རྗེ་ནས་ཀྱང་སངས་གླིང་དྲན་པ་དྲག་པོའི་ལུང་གསན་པར་གནང་།",
    "དེང་སང་བཀའ་གཏེར་རིང་བརྒྱུད་ཀྱི་བདུད་རྩིའི་ཆུ་རྒྱུན་གཙང་མ་ལ་ལོངས་སྤྱོད་པར་མི་ནུས་པར་ཉེ་བརྒྱུད་ཡིན་ལོའི་ཤོམ་གྱིས་རྟོག་བོན་ཟོལ་མ་སྤེལ་བ་དང་།",
    "བཀའ་རྟེན་སུམ་བརྒྱ་བ་རྩ་འགྲེལ་དུ་མ་སོགས་རྒྱས་བསྡུས་མང་དུ་བཞུགས་པ་ལས་བཏུས་ཏེ།",
    "གཅོད་ལ་བརྟེན་ནས་མི་ངོར་གྲོང་འགྲིམ་གནང་བ་ལྟ་ཅི།",
    "གཅོད་པ་ཡིན་ཞེས་ཁ་ཕོ་འདོན་པར་ཡང་གཏན་ནས་མི་གནང་ཡང་།",
    "པར་གནང་བས་ཕྱིས་སུ་གཅོད་ཀྱི་ཉམས་ལེན་པ་ཀུན་ལ་བཀའ་དྲིན་མཆོག་ཏུ་ཆེ་བར་གྱུར་ཏོ།",
    "དེ་ཡང་ཤེལ་དཀར་གྱི་བུམ་པ་ནི་སྔགས་ཀྱི་དམ་ཚིག་ནི་རང་བཞིན་གྱི་ངོ་བོ་རྣམ་པར་དག་པ་མཚོན་ལ་བརྩེགས་མ་ནི་བཙའ་དཀའ་བ་ཡིན་པས་གསང་སྔགས་ཀྱི་དམ་ཚིག་བསྲུང་དཀའ་བའི་ཚུལ་དང་།",
    "སྤུ་གྲི་ནི་སྔགས་སྡོམ་བསྲུང་བ་ལ་དྲན་ཤེས་བག་ཡོད་ཆེས་ཆེར་བསྟེན་དགོས་པའི་བརྡ་ཡིན་སྙམ་ཞེས་ཞལ་ནས་དངོས་སུ་གསུངས།",
    "དེ་ལ་བརྟག་ན་དམ་ཚིག་མ་ཉམས་པའི་རྟགས་འོང་བ་ནི་དེ་དུས་རྣམས་སུ་དཔོན་སློབ་དམ་གཙང་ཁོ་ན་འདུ་བ་དང་།",
    "གསུངས་ནས་སྤྱན་བར་སྣང་ལས་མི་གཡོ་བར་གནས་ལུགས་ཀྱི་ངང་དུ་དར་གཅིག་བཞུགས་ནས་སྣང་།",
    "ཤར་བའང་བྱུང་ཞེས་གསུངས།",
    "མིང་དང་རུས་ཡིད་ལ་མ་བྱས་པར་སྙོམ་ཆུང་ཁོ་ནའི་ངང་དུ་བཞུགས།",
    "བསྐལ་པར་བསྒྲུབ་ཀྱང་དོན་མེད་ཚེགས་སུ་འགྱུར།",
    "ལྷུན་གྲུབ་ཐོད་རྒལ་གྱི་ཉམས་ལེན་གཉིས་རྩལ་དུ་བཏོན་ནས་སྔར་མུས་བཞིན་ཐུན་བཞི་དང་འབྲེལ་བའི་ཉམས་ལེན་བསྐྱངས་པ་ལ་གཙོ་བོར་བྱས།",
    "བཞུགས་ཀྱང་ཚུལ་གོས་སྣ་གསུམ་འབྲལ་མེད་ཀྱི་ན་བཟའི་ཚགས་བསྡོམ་པ་དང་།",
    "གསལ་ཕྱག་བསྐོར་དང་ནི་བཟླས་བརྗོད་ལ་སོགས་པར།",
    "བསྐྱལ་བས་རྟགས་མཚན་ལེགས་པ་མང་དུ་བྱུང་ཞེས་གསུངས།",
    "སེམས་ཉིད་གཏན་ལ་ཕེབས་པ་དང་།",
    "བུའི་བཀའ་སྲོལ་ཨ་ཁྲིད་ཐུན་མཚམས་བཅོ་ལྔ་བ་གཞུང་དང་རྒྱབ་སྐྱོར་གཙོ་བོར་བྱས།",
    "དང་དབྲ་སྲས་གཉིས་ལ་སྨར་ཁྲིད་ཀྱི་རྒྱུན་ཡུན་རིང་པོར་བསྐྱངས་པ་གནང་བས་སྐུ་ཚེ་སྔོན་མའི་ལས་འཕྲོ་སད་པའི་མཐུས་ངོ་སྤྲོད་སྐབས་སེམས་རིག་དྭངས་སྙིགས་ཕྱེད་ནས་ཡེ་ཤེས་ནང་ནས་ཤར་བའི་ཉམས་རྟོགས་བཟང་པོ་འཁྲུངས།",
    "དམ་པའི་ངང་ཚུལ་ལྷུག་པར་གསལ་བས་ཁོང་རྣམ་གཉིས་སློབ་གྲས་དཀྱུས་མ་དག་དང་མི་མཉམ་པའི་ཐུགས་གཙིགས་སུ་མཛད་དོ།",
    "དངོས་གཞིའི་སྐོར་ལ་ལྟ་སྒོམ་གྱི་གནས་དང་ཤན་འབྱེད་ཀྱི་དོགས་སེལ་སྨར་བ་གནང་བ་གསན།",
    "རྫོགས་རིམ་སེམས་དོན་གྱི་ཞལ་ཤེས་མྱོང་ཁྲིད་དུ་གནང་།",
    "དམར་ཁྲིད་དུག་ལྔ་རང་གྲོལ་གྱི་ཁྲིད་དང་བཅས་པ་ལེགས་པར་གསན་པར་གནང་ངོ།",
    "དགུངས་གྲངས་ཞེ་གཉིས་བཞེས་པའི་ལྕགས་བྱིའི་གནམ་ལོ་ལ།",
    "སྐབས་ཤིག་ན་སྨོན་རྒྱལ་བདུད་འདུལ་གླིང་པའི་གདུང་སྲས་འཆི་མེད་བསྟན་འཛིན་དེར་བྱོན་ནས་མཇལ་འཕྲད་དགྱེས་སྤྲོ་གནང་།",
    "ཊི་ཀ་སྒ་སྟོན་གསུངས།",
    "པ་ཞིག་ཡིན་པར་རིང་ནས་ཐུགས་ལ་ངེས་བཞིན་མཇལ་འཕྲད་མཛད་པར་དགོངས་ནས་མཚམས་རྒྱ་ཀློད་དེ་བྲག་དཀར་མཆོག་སྤྲུལ་མདུན་བྱོན་ནས་མཇལ་དར་དང་གསུང་མཆིད་རྒྱས་པར་ཞུས།",
    "འོན་ཀྱང་དགོངས་བརྟག་ཅིག་བྱ་གསུངས།",
    "ཉམས་རྟོགས་ཀྱི་ཤན་འབྱེད་དང་རྟོགས་པ་མཐར་ཐུག་ཉམས་ཞེན་གྱི་ཤུན་པ་དང་བྲལ་དགོས་ཚུལ་གྱི་ཞལ་ཤེས་ཀྱང་མང་དུ་གསུངས།",
    "སྐྱབས་རྗེ་དམ་པ་གང་ཉིད་མཚམས་ལས་གྲོལ་ནས་བདུན་ཚིགས་ཞེ་དགུ་ཞིག་བཞུགས་པར་གནང་ནས།",
    "ཞེས་ཇི་སྐད་གསུངས་པ་ལྟར་རི་ཁྲོད་བཟུང་ནས་འཚོ་ཆས་ཀྱིས་ཕོངས་པ་ནམ་ཡང་མ་བྱུང་ཞིང་།",
    "ཚོགས་གཉིས་རིམ་གྱིས་རྫོགས་པར་འགྱུར།",
    "ཞེས་གསུངས་པའི་ཚུལ་ཕྱག་ལེན་དུ་བསྟར་བ་ཁོ་ན་སྟེ།",
    "བོན་ཞིག་ཁྱུང་ནག་སོགས་དང་ཚུལ་མཚུངས་བའི་བྱ་བྲལ་གྱི་རྣམ་པར་ཐར་བའོ།",
    "ཞེས་སོགས་གསུངས་པས་མཚོན་ནོ།",
    "ཚེ་འདིའི་བྱ་བ་དང་གསོག་འཇོག་སོགས་བཞག་ནས་དབེན་པའི་གནས་སུ་རང་ཉིད་གཏན་བདེའི་བཙན་ས་འཛིན་པ་ལ་སྦྱོར་གང་ཐུབ་དགོས་སོ་ཞེས་རྗེ་ཉིན་ནས་སྐུ་ཉམས་སུ་བསྟར་བ་དང་རྗེས་འཇུག་ཀུན་ལའང་དེ་བཞིན་དུ་འདོམ་པར་མཛད་པ་ཡིན་པས།",
    "ཕྱི་རབས་ཀྱི་གཤེན་པོ་རྣམས་ཀྱིས་ཀྱང་ཚུལ་བཞིན་དུ་ངེས་པར་བྱས་ནས་སྔོན་བྱོན་རྒྱལ་བ་གོང་མའི་མཛད་པ་མ་ནོར་བ་རྗེས་འཇུག་གདུལ་བྱའི་ལག་ལེན་དུ་ཐེབས་པ་ཞིག་དགོས་པ་ཡིན་ནོ།",
    "གཏེར་ཆེན་ཡབ་ཡུམ་གཙོར་བྱས་པའི་ཕྱོགས་ཀྱི་འདུས་པ་མང་དུ་ཚོགས་པ་རྣམས་ལ།",
    "དབེན་པར་ཚུལ་བཞིན་བརྟེན་ནུས་པ་དང་།",
    "ཞིག་བྱས་ན་དེར་བསྡད་པས་ཆོག་ཅེས་ཞལ་ཏ་ཕེབས་མཚམས།",
    "འདིར་ཆགས་ན་བསྟན་པ་རྒྱུན་རིང་བ་ཙམ་ཞིག་འོང་བའི་ལྟས་མངོན་གསུངས།",
    "དད་འདུས་སེར་སྐྱ་དུ་མ་ཚོགས་སར་ཨ་ཁྲིད་དང་སྔོན་འགྲོ་བཀའ་ལུང་རྒྱ་མཚོ་གཉིས་ཀྱི་ཁྲིད་རྒྱས་པ་ཞིག་གནང་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "ཞལ་ཏ་གནང་བས་ཐུགས་ནང་གཅིག་འདྲེས་སུ་གྱུར།",
    "དགོངས་བརྟག་དང་རྨི་ལམ་ཡ་མཚན་པ་བྱུང་བ་སོགས་ཀྱི་ངེས་པ་བརྟན་པོ་ཐུགས་ལ་ཡོད་པར་བརྟེན་ཁྱེད་ཟབ་གཏེར་གྱི་བདག་པོ་ཆེན་པོར་བཞུགས་པས་གཏེར་ཁ་གང་ཡོད་འདིར་འབེབས་པའི་བཀའ་དྲིན་སྩལ་གནང་ཞུས་པས།",
    "གཏེར་ཆེན་མཆོག་ནས་དུས་བབས་ཡིན་པར་ཆོག་ཅེས་དགྱེས་པའི་གསུང་གནང་ནས་སྐུ་མཚམས་དམ་པོར་མཛད་ནས།",
    "གནས་ཆེན་གཡུང་དྲུང་ལྷུན་པོའི་དཀར་ཆགས་རིན་ཆེན་གཏེར་མཛོད་དང་ལུང་བསྟན་ཐོབ་ཚུལ་བཅས་གཏན་ལ་ཕབ་ནས་གནང་།",
    "ཞེས་སོགས་ཀྱི་སྐབས་ནས་གསུངས་པ་དང་སྐྱབས་རྗེ་བྲག་དཀར་མཆོག་སྤྲུལ་གྱིས་ལུང་དུ་བསྟན་པ་རྣམས་གུང་འགྲིགས་པར་མངོན་བས།",
    "ཁྱུང་དབོན་ཉི་མ་རྒྱལ་མཚན་སོགས་གཉུག་མར་གནས་པ་དང་ཕྱོགས་ནས་འདུས་པའི་བླ་གྲྭ་ཆེ་གྲས་སུམ་ཅུ་སྐོར་དང་གྲྭ་བཙུན་ཅི་རིགས་འདུས་པ་རྣམས་ལ་ཐོག་མར་རི་ཁྲོད་དུ་གསང་སྔགས་མ་རྒྱུད་དང་འབྲེལ་པར་གྲུབ་ཆེན་གྱི་ཚོགས་སྟོང་།",
    "བོན་སྐྱོང་སྐོང་གསོལ་བཅས་རྒྱས་པར་མཛད་ནས་གནས་ཆེན་བྱིན་འབེབས་ཀྱི་དགོངས་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "དེ་ནས་ས་ག་ཟླ་བའི་ཚེས་བཅུ་ལ་གནས་སྒོ་འབྱེད་པར་དགོངས་ནས་གཏེར་སྟོན་ཡབ་ཡུམ་ཞབས་གྲས་ལྷན་རྒྱས་དང་འདུས་པ་ཀུན་དང་བཅས་ཉི་མ་ཤར་བ་དང་དུས་མཚུངས་སུ་སེར་ལུང་མདར་ཞབས་བསྐྱོད་པས།",
    "གནས་ཀྱི་དབུ་རྩེ་ནས་འཇའ་གུར་ཕུབ་ཅིང་ཕྱོགས་ཀུན་ཏུ་འཇའ་འོད་འཕྲོ་བ་དང་མཉམ་དུ་ཆར་ཟིལ་བུར་འབེབས་ཤིང་དབྱར་རྔའི་སྐད་སྙན་པར་སྒྲོག་པའི་དགེ་མཚན་མཐོང་།",
    "ཤོད་ཀླུང་དགའ་ཡག་བཞི་ལ་གཏའ་རུ་ཟུངས་ཞེས་བས་ཤོད་ཅེས་པ་ཀླུ་ཆུ་ཐང་དུ་ཟབ་གཏེར་གྱི་དངོས་གྲུབ་ཡོད་པར་དགོངས་ནས་ཞག་གཅིག་བཞུགས།",
    "ཞི་བ་ཀུན་བཟང་རྒྱལ་འདུས་ཀྱི་ཚོགས་མཆོད་དང་རི་ཁྲུས་དང་ལྷ་འདྲེའི་དམ་བསྒྲགས་གནང་མཐར་ཟབ་གཏེར་གྱི་དངོས་གྲུབ་བརྙེས།",
    "ཕྱིར་ཉིན་སེ་ར་ཁོག་ནས་ཞབས་བསྐོར་དུ་ཕེབས་ནས་དཀར་ཆགས་ནང་འཁོད་བཞིན་རང་བྱོན་བཀའ་རྟགས་སོགས་རྒྱང་ནས་མཚོན་ཏེ་གསུངས་པ་རྣམས་ཀུན་ཀྱིས་ཚེགས་མེད་དུ་རྙེད་པས་ཐམས་ཅད་ངོ་མཚར་ཞིང་ཡིད་ཆེས་པ་ལས་བྱུང་བའི་དད་པ་བླ་ལྷག་ཏུ་ཐོབ།",
    "བྱང་ཕྱོགས་ཆུ་ཀླུང་ཐང་ལ་ཕེབས་ནས།",
    "ནུབ་ཕྱོགས་ར་འོ་དགའ་བ་ཚལ་དུ་བཞུགས།",
    "འབེབས་བཅས་གནང་།",
    "དབུ་ཞྭ་ཕྱག་རྗེས་རང་བྱོན་སོགས་ངོ་སྤྲོད་གནང་ནས་ཕེབས།",
    "ལྷོ་ཕྱོགས་བྲག་ཁྲ་ཡག་སྒར་བབས་ནས་བཞུགས།",
    "དྲག་པོ་སྐུ་གསུམ་ཕུར་བའི་ཚོགས་དང་བསང་ཁྲུས་བྱིན་འབེབས་བཅས་གནང་ཞིང་།",
    "བསྐོར་ལམ་དང་ཕན་ཡོན་ཁྱད་པར་དུ་མཚོ་གསུམ་ལ་བསྐོར་བ་བྱས་ན་ཕན་ཡོན་ཆེ་ཚུལ་སོགས་བསྒྲགས་ནས།",
    "འཛིན་མཁའ་འགྲོའི་ཚོགས་སྐོང་རྒྱས་པ་དང་སྲུང་མའི་སྐོང་གསོལ་སོགས་གནང་ནས་དགྱེས་པར་བཞུགས་སོ།",
    "སྙན་གྲགས་དུང་སྒྲ་སྲིད་གསུམ་ཁྱབ་པར་སྒྲོགས།",
    "ད་ལན་སྔོན་འགྲོའི་ཁྲིད་ཡིད་འདི་པར་ལ་བཀོད་ན་གདུལ་བྱ་མཆོག་དམན་ཀུན་ལ་ཕན་ཆེན་པོ་ཐོགས་པའི་རྟགས་མཚན་ཡང་གསལ་བས་ཐུགས་ངེས་མཛད་དགོས་གསུངས་པའི་ཞལ་ཏ་ཕེབས་པས།",
    "དེ་ལྟར་ན་མཐུན་རྐྱེན་དུ་ནོར་ལོངས་སྤྱོད་ཆེན་པོ་ཞིག་ཡོད་དགོས་པར་སྣང་།",
    "ཁྱད་པར་དུ་པར་བརྐོ་བ་ལ་ཟ་ཡོན་གྱི་རྒྱུ་ནོར་ཆེན་པོ་དགོས་པས་བསྒྲུབ་ནུས་སམ་ཞེས་གསུངས་པས།",
    "གཏེར་ཆེན་པའི་ཞལ་སྔ་ནས་ད་ལན་པར་རྐོས་འདི་དང་བློ་མཐུན་འོང་དགོས།",
    "དཔལ་མགོན་རྗེས་གནང་བཅས།",
    "ལོག་པའི་འབྲས་བུ་དམ་སྲིའི་རིགས་ཀྱི་གདུགས་སེམས་ཀྱི་རྒྱུ་བྱས།",
    "དགོད་བཞིན་དུ་ནི་ལས་བྱས་ན།",
    "སྙིགས་མའི་དུས་ངན་འདི་ལྟ་བུར་འགྲོ་བ་རྣམས་ཀྱི་ལམ་སྟོན་དུ་བསྟན་པའི་སྒྲོན་མེ་ཉི་ཞུར་ཙམ་མཆིས་པ་འདི་ཡང་རིམ་པར་ཇེ་ནུབ་ལས་མེད་ཅིང་།",
    "དོད་འབོད་པའི་སྣང་བ་ཞིག་བྱུང་གསུངས།",
    "གཉེན་པོ་བསྟེན་པ་བས་ཡུལ་ངན་སྤང་ན་དགའ་བ་ཡིན་པས་གནས་ངེས་མེད་ཅིག་བྱས་ནས་ཕེབས་ན་གུ་ཡངས་ལ་སོས་དལ་ཞིང་དགེ་སྦྱོར་ཡང་བསམ་པ་བཞིན་ལེགས་པ་ཞིག་འགྲུབ་ཅིང་།",
    "འགྲོ་དོན་ཡང་སྔོན་སྨོན་གྱིས་གར་འཕེན་ལས་འོས་ཅི་ཡོད་ཅེས་ཐུགས་ལ་དགོངས་ནས་བྱོན་པ་ལ་ཐུགས་རྩེ་གཏད་པར་གནང་ངོ།",
    "རྗེ་ཉིད་ནས་སྒུག་རི་ལྡིང་དཔོན་ཨ་རྟ་ལགས་ཀྱི་མངའ་དབྲ་སྟོན་པཎྚི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "དེའི་མཚམས་སུ་མགོ་ལོག་བསྲེ་ཐར་ན་ཡོད་པའི་རང་དགོན་གྱི་བླ་གྲྭ་རྣམས་ལ་གཞུང་སར་སྙན་སྒྲོན་ཕུལ་བ་དང་བཀའ་ལུང་གནང་ཚུལ་སོགས་བསྟན་དགོན་ལ་ཕན་པའི་ཐུགས་བསྐྱེད་ཀྱིས་ཡི་གེ་ཡང་བརྗོད་པར་མཛད།",
    "མཁྱེན་པས་བོན་སྒོ་ཇི་སྙེད་ཐུགས་སུ་ཆུད།",
