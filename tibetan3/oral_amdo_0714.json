    "དགེ་སློང་གི་མདུན་དུ་འདུག་སྟེ།",
    "སྦྱིན་བདག་གམ་ཞལ་ཏ་བྱེད་པ་རིང་དུ་སོང་ན་ཡང་རུང་བ་བྱས་པ་དེ་མི་ཉམས་སོ།",
    "བདག་ཉིད་ཀྱིས་ལུས་འཚོ་བའི་དོན་དུ་ཟོང་གིས་བཟའ་རུང་བྱེད་དུ་གཞུག་པ་རུང་ཞིང་།",
    "ལྕགས་དང་ས་ལས་བྱས་མིན་བདག་གིར་མིན།",
    "ཤིང་གི་ལྷུང་བཟེད་བདག་གིར་མི་བྱའོ།",
    "གལ་ཏེ་ལྷུང་བཟེད་རུང་བ་མེད་ན་མི་རུང་བའི་ལྷུང་བཟེད་དེ་དག་བསྙེན་རྫོགས་ཀྱི་སྔོན་རོལ་དུ་བདག་གིར་བྱས་སམ་མ་བྱས་ཀྱང་རུང་།",
    "དེ་དག་གིས་དགེ་སློང་གཅིག་ལ།",
    "མཐར་ཐུག་བཅུ་གཅིག་པའི་སྐྱ་རེངས་དང་པོ་ཤར་བ་སྟེ།",
    "གཞན་རབ་ཏུ་བྱུང་བའི་ཕྱིར་བཅང་བ་ནི་རང་གི་ཡིན་པ།",
    "འདིར་ཚོད་མ་ནི་མང་བ་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་ཚོད་མ་དེ་ཇི་ཙམ་གྱི་འབྲས་ཆེན་སྤགས་པར་ནུས་པ་དེའི་ཚད་ཁོ་ནའི་ཚོད་མ་འདིར་གཟུང་གི་ཞེས་གསུངས་པ་དང་།",
    "མ་ག་དྷའི་བྲེའུ་ཆུང་དོ་ལ་ནི་བོད་ཀྱི་བདུན་ཕུལ་བཞི་དང་ཁྱོར་དོ་ཡོད་དོ་ཞེས་པའི་བདུན་ཕུལ་ནི་ཕུལ་བདུན་ཡིན་ནོ།",
    "དགེ་སློང་མས་དགེ་སློང་གི་ལྷུང་བཟེད་ཆུང་ངུ་ལས་ལྷག་པ་མི་བཅང་ངོ།",
    "དེ་དག་གི་ཚད་ཙམ་བཅང་ངོ།",
    "བསོད་སྙོམས་པ་ཞིག་གིས་རྫའི་ལྷུང་བཟེད་ལག་ནས་ཤོར་ནས་དུམ་བུ་ལྔར་གྱུར་ཏོ།",
    "ཡོད་པ་ཉིད་ལ་རང་གི་རིན་གྱིས་ལྷུང་བཟེད་གཞན་ཚོལ་བ་དང་།",
    "ཞེ་སྡང་གིས་དང་།",
    "གཏི་མུག་གིས་དང་།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "དེ་ནས་དགེ་སློང་གི་འཁོར་དེའི་ལྷུང་བཟེད་ཐམས་ཅད་ཀྱི་ནང་ནས་ཐ་ཆད་གང་ཡིན་པ་དེ་ལྷུང་བཟེད་སྦྱིན་པ་པོའི་དགེ་སློང་གང་ཡིན་པ་དེ་ལ།",
    "དགེ་སློང་ཁྱོད་ཀྱིས་ལྷུང་བཟེད་འདི་བྱིན་གྱིས་བརླབ་པར་མི་བྱ།",
    "ཉེ་དགས་ཡུག་ས་མོ་ལྔ་བརྒྱ་ལས་དོག་པ་རྙེད་པས་འཐག་མཁན་སྤྱི་ཅེར་ཅན་ལ་འཐག་ཏུ་བཅུག་ཅིང་།",
    "སླར་ཡུག་ས་མོ་ལྔ་བརྒྱ་ལས་སྔར་བཞིན་དོག་པ་རྙེད་ནས་སླར་འཐག་ཏུ་བཅུག་པ་དང་།",
    "སྦྱོར་བ་གླ་རྔན་མེད་པ་རང་གིས་བསྒོ་བས་སམ།",
    "རང་ལ་ཉེ་དུས་རེས་འགའ་བཏགས་ལ།",
    "རིན་མེད་པའི་ཐ་ག་པ་ཉེ་དུ་མ་ཡིན་པས་རེས་འགའ་བཏགས་ཀྱང་།",
    "སྦྱིན་པོས་བསྒོས་ལས་རང་གི་བཀྱེད་གྲུབ་ལའོ།",
    "མཉན་ཡོད་དུ་ཁྱིམ་བདག་ཅིག་གི་ཆུང་མས་ཉེ་དགའ་ཟང་ཟིང་ཅུང་ཟད་ཀྱིས་བསྡུའོ་ཟེར་ནས་འཐག་མཁན་ལ་འཐག་ཏུ་བཅུག་པ་ཉེ་དགས་ཐོས་ཏེ།",
    "མོས་འདི་མ་ཡིན་པ་གཞན་ཞིག་འབུལ་ཟེར་ནས།",
    "ཉེ་དགས་བསླབས་པ་ལྟར་སྲང་བར་དུ་འོངས་ཏེ་རས་མོའི་ཕང་པར་བཞག་པ་ཉེ་དགས་ཚམ་ཚོམ་མེད་པར་བླངས།",
    "དགེ་སྦྱོང་གི་ཚུལ་ཚིག་གོ་ཟེར་བའི་སྐབས་དེ་གསོལ་པས་བཅས་སོ།",
    "དགེ་སློང་རང་ལ་སྦྱིན་པར་སྦྱིན་བདག་གིས་བསམས་པ།",
    "སྦྱོར་བ་སྦྱིན་བདག་གིས་མངགས་པ་ལས་ཁོ་ལག་ཆེ་བ་དང་།",
    "དེའི་རྐྱེན་གྱིས་སྦྱིན་བདག་གི་དོག་པ་ཟད་པ་དང་།",
    "སྦྱིན་བདག་གིས་དགེ་སློང་ཁྱོད་ཀྱི་ཕྱིར་གོས་འཐག་ཏུ་བཅུག་གི་དུས་དུས་སུ་བཞུད་ལ་གཟིགས་ཤིག་ཅེས་གནང་བ་མ་ཐོབ་པ་ནི་དངོས་གཞིའི་བྱེད་པ་པོའོ།",
    "ལུས་ངག་གིས་ཕྲོགས་དེ་ལུས་དེ་བྲལ་ལའོ།",
    "སྦྱོར་བ་ལུས་ངག་གཞན་ལ་བཅོལ་བའི་འཕྲོག་པ་གསུམ་པོ་གང་རུང་གིས་སྔར་རང་གིས་སྦྱིན་པའམ།",
    "འོ་ན་གཙུག་ལག་ལས་རང་གིས་བྱིན་པ་ཁོ་ན་ཡན་ལག་ཏུ་གསུངས་ཏེ།",
    "བདེན་མོད་ཀྱི།",
    "འདི་ལྟར་རང་གིས་བྱིན་པ་ཕྲོགས་ན་ཉེས་པར་འགྱུར་བ་ལས་གཞན་གྱིས་བྱིན་པ་ཕྲོགས་ན་ཆེས་ཉེས་པར་འགྱུར་བར་ཤེས་པར་བྱའོ།",
    "དགེ་སློང་གི་ཡོ་བྱད་གཞན་ཡང་ཕྲོགས་ན་དངོས་གཞིའི་ཁ་ན་མ་ཐོ་བར་འགྱུར་རོ།",
    "གཞན་དོན་གྱི་ཕྱིར་ཚིག་གིས་ཕྲོགས་ཀྱང་དངོས་གཞིར་འགྱུར་རོ།",
    "རྒོད་བག་གིས་ཕྲོགས་པ་ནི་ཉེས་བྱས་སོ།",
    "བརྟད་པ་ལྔ་ལ་བདག་གིར་བྱ་སྔས་དང་།",
    "དབྱར་གྱི་ནང་ལོགས་སུ་བདག་གིར་བྱེད་ནའོ།",
    "རི་བྲག་ན་ཁྱིམ་བདག་དད་པ་ཅན་གཅིག་གིས་གཙུག་ལག་ཁང་ཕུན་སུམ་ཚོགས་པ་ཞིག་བྱས་ཏེ།",
    "དགེ་སློང་རྣམས་གཞན་དུ་སོང་ངོ།",
    "དེའི་ཚེ་བྱང་ལམ་གྱི་ཚོང་པས་རྙེད་པ་སྦྱར་ཏེ་དགེ་སློང་བཟང་པོ་སྤྱན་དྲོངས་ཤིག་དབྱར་འདས་པ་དང་འོངས་ཏེ་མཁོ་བ་བསྟབ་བོ་ཟེར་ནས་སོང་ངོ།",
    "དེ་སྦས་ནས་རྒན་པས་སྤྱན་དྲོངས་ཤིག་དེ་སོང་བ་དང་།",
    "འདི་སྨོད་ཀྱི་གནས་དབྱུང་གྱིས་ཤིག་མྱུར་དུ་བཟོད་པར་མ་གསོལ་ན་ལྟག་པའི་སྤུ་འབྱི་ཡི་གསོལ་ཅིག་གསོལ་བས་རྒན་ཞུགས་དྲང་བས་བཟོད་པ་བྱའོ་ཟེར་ནས་སོང་ངོ།",
    "ཞོག་ལ་དགག་དབྱེ་མཛད་ནས་བགོས་ཤིག་ཟེར་ནས་གནས་ཁང་དུ་བཅུག་ནས་སོང་ངོ།",
    "གོས་སྦྱིན་པའི་དུས་ལས་སྔ་བར་བདག་གིར་བྱས་སམ།",
    "གོས་སྦེད་པ་མ་བསྐོས་པ་དག་གིས་གོས་སྦྱིན་པའི་དུས་ནི།",
    "གཞན་དུ་ཞག་བདུན་སྐྱ་རེངས་ཤར་བ་ལའོ།",
    "མཐར་ཐུག་ཞག་བདུན་པའི་སྐྱ་རེངས་ཤར་བ་ཚུན་ཏེ།",
    "བར་ཆད་འགའ་ཞིག་གིས་ཞག་བདུན་ལ་སོགས་པར་ཐལ་ན་ཉེས་པ་མེད་དོ།",
    "དབྱར་སྔ་མར་ཁས་ལེན་པས་ཀྱང་རང་གི་དུས་ཡིན་ནོ་ཞེས་འཚོལ་བར་བྱེད་ཅིང་འཆང་བར་བྱེད།",
    "དབྱར་གནས་གྲོལ་བའི་འོག་གི་ཟླ་བ་ཕྱེད་ཀྱི་དུས་མ་ཡིན་པ་དེ་ལས་ཀྱང་ཕྱི་བར་བཅངས་པ་གང་རུང་།",
    "སྦྱོར་བ་ཁྱིམ་པ་ཉེ་དུ་མ་ཡིན་པ་ལ་དབྱར་གྱི་རས་ཆེན་དག་གིས་བསླངས་པ་དང་།",
    "ཁྱིམ་བདག་གཅིག་གིས་གཙུག་ལག་ཁང་གཅིག་སྒྲ་གཅན་འཛིན་ལ་གང་ཟག་གིར་ཕུལ་ལོ།",
    "ཁྱོད་སོང་ལ་ཁྱིམ་བདག་ལ་ཁོ་བོའི་ལུས་ངག་ལ་སྨད་པར་མི་བྱེད་དམ་ཞེས་སྨྲོས་ཤིགསྨྲས་པས།",
    "དགེ་སློང་དག་སྒྲ་གཅན་འཛིན་ལ་གཙུག་ལག་ཁང་ཕྱིར་བྱིན་ཅིག་བྱིན་ཏེ་རེ་ཞིག་བྱུང་བའོ།",
    "དགེ་སློང་ཞིག་གིས་ཁྱིམ་བདག་དད་པར་བྱས་ནས།",
    "ཉེ་དགས་ཐོས་ནས་རས་དེ་ཆེན་པོ་ལ་འོས་པ་ཞིག་འོང་གི་ཁོ་བོས་མ་ཕྲོགས་ན་མིང་མི་གཟུང་ངོ་སྙམ་ནས་དེ་ལྟར་བྱས་པ་དང་།",
    "བསམ་པ་དེ་ལྟ་བུར་ཤེས་བཞིན་དུ་བདག་གིར་འདོད་པ།",
    "གཞན་ཡང་དགེ་སློང་བྲམ་ཟེའི་བུ་མོས་ཞུས་པ་ལས།",
    "བྱིན་གྱིས་མ་བརླབ་པར་བདག་གིར་བྱེད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བདག་གིས་འདི་ཉམས་སུ་བླང་ངོ།",
    "གཙུག་ལག་ཁང་གི་བདག་པོ་བཅོམ་མམ།",
    "དགེ་སློང་དག་གིས་གཙུག་ལག་ཁང་དེ་ཡལ་བར་མི་དོར་བར་དགེ་སློང་གང་གཙུག་ལག་ཁང་དེ་ལ་རྗེས་སུ་ཆགས་པ་ཤས་ཆེན་པོ་ཡོད་པ་དེ་དེར་བསྲུང་མར་གཞུག་ཅིང་།",
    "ལོ་གཞན་ལྔ་ནི་ཉེན་ཀོར་གྱི་གཙུག་ལག་ཁང་དང་ལྷན་ཅིག་འཚོ་བ་ཐུན་མོང་དུ་བྱ་བས་འདའ་བར་བྱ་ཞིང་།",
    "གཙུག་ལག་ཁང་དེ་དང་ཉེན་ཀོར་གྱི་གཙུག་ལག་ཁང་དེར་རྙེད་པ་ནི་ཐུན་མོང་བ་ལ་གསོ་སྦྱོང་ནི་ཐ་དད་པ་བྱ་བའི་ཕྱིར།",
    "མི་སྟེར་ན་ནན་གྱིས་བསྐུལ་ལ་དེ་དག་གི་ཕྱིར་སྦྱིན་པར་བྱ་བ་ཉིད་དོ།",
    "གཙུག་ལག་ཁང་གི་ཡོ་བྱད་དག་ཕན་ཚུན་གཡར་གཏོང་བ་ལ་ཉེས་པ་མེད་དོ།",
    "བསམ་པ་རང་གི་ཆེད་དུ་འདོད་པས།",
    "མཐར་ཐུག་རང་རང་གིས་སྤྱད་པའི་དུས་ལས་ཡོལ་བ་སྟེ།",
