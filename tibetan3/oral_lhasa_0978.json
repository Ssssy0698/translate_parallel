    "ལྷག་མཐོང་ལ་མ་ཡིན་རྨུགས་པ་དང་གཉིད་ནི་ལྷག་མཐོང་ལ་སྒྲིབ་པར་བྱེད་ལ་ཞི་གནས་ཡོངས་སུ་རྫོགས་པ་ལ་མ་ཡིན།",
    "དང་པོ་ནི་ངོ་བོ་ཉིད་དང་མཚན་ཉིད་དང་ཕན་ཚུན་རྗེས་སུ་མཐུན་པའི་སྒྲིབ་པ་ཡིན་པས་རྨུགས་པ་ནི་ཞི་གནས་ལ་སྒྲིབ་པར་བྱེད་ལ།",
    "རྒོད་པ་ནི་ལྷག་མཐོང་ལ་སྒྲིབ་པར་བྱེད།",
    "རྨུགས་པ་ནི་ཞི་གནས་ལ་སྒྲིབ་པར་བྱེད་དོ།",
    "གཉིས་པ་ནི་ངོ་བོ་ཉིད་དང་མཚན་ཉིད་དང་ཕན་ཚུན་བཟློག་པའི་སྒྲིབ་པ་ཡིན་པས་རྨུགས་པ་ནི་ལྷག་མཐོང་ལ་སྒྲིབ་པར་བྱེད་ལ།",
    "རྒོད་པ་དེ་ནི་ཞི་གནས་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལ་སོགས་པ་ལས།",
    "ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པའོ།",
    "རིགས་ཀྱི་བུ་རྣམ་པ་ལྔ་ཤེས་པར་བྱ་དགོས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་ཡང་དག་པར་ལན་དུ་གསུངས་པ་སྟོན་ཏོ།",
    "རྣམ་པ་ལྔར་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་དེ་ཉིད་ལས་རྣམ་པར་གཡེང་བ་རྣམ་པར་སེལ་བར་བྱེད་པའི་ཕྱིར་རྣམ་པར་སྨོད་པ་ཞེས་བྱ་སྟེ།",
    "འདི་ཉིད་ཀྱི་འགྲེལ་པ་ལས་རྣམ་པར་གཡེང་བ་ནི་རྣམ་པ་ལྔ་ཡོད་དེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་རྣམ་པར་གཡེང་བ་ནི་འདི་ལྟ་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཕ་རོལ་གྱི་ཡུལ་ལ་འཕྲོ་བ་གང་ཡིན་པའོ།",
    "ཡིད་ལ་བྱེད་པའི་རྣམ་པར་གཡེང་བ་ནི་འདི་ལྟ་སྟེ།",
    "རྣམ་པ་ལྔ་ལས་མཚན་མའི་རྣམ་པར་གཡེང་བ་བཏོན་ནས་ངོ་བོ་ཉིད་ཀྱི་རྣམ་པར་གཡེང་བ་བསྣན་པས་སོ།",
    "ངོ་བོ་ཉིད་མེད་ཀྱིས་མཛད་པའི་འགྲེལ་པ་ལས་ནི་རྣམ་པར་ཕྱེ་བ་མེད་དོ།",
    "དེའི་ཕྱིར་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་རྣམ་པར་གཡེང་བ་ནི་རྣམ་པ་དྲུག་ཡོད་དེ།",
    "ངོ་བོ་ཉིད་ཀྱི་རྣམ་པར་གཡེང་བ་དང་།",
    "ཕྱི་རོལ་དུ་རྣམ་པར་གཡེང་བ་དང་།",
    "ནང་དུ་རྣམ་པར་གཡེང་བ་དང་།",
    "མཚན་མའི་རྣམ་པར་གཡེང་བ་དང་།",
    "གནས་ངན་ལེན་གྱི་རྣམ་པར་གཡེང་བ་དང་།",
    "ཡིད་ལ་བྱེད་པའི་རྣམ་པར་གཡེང་བའོ་ཞེས་འབྱུང་སྟེ།",
    "ངོ་བོ་ཉིད་ནི་དྲུག་པར་འབྱུང་ངོ།",
    "མཉམ་པར་གཞག་པ་མ་ཡིན་པས་དེའི་ཕྱིར་ལོགས་ཤིག་ཏུ་ངོ་བོ་ཉིད་ཀྱིས་རྣམ་པར་གཡེང་བ་ཞེས་བསྟན་ཏོ།",
    "ཡིད་ལ་བྱེད་པའི་རྣམ་པར་གཡེང་བ་དང་།",
    "ཕྱི་རོལ་དུ་སེམས་རྣམ་པར་གཡེང་བ་དང་།",
    "ནང་དུ་སེམས་རྣམ་པར་གཡེང་བ་དང་།",
    "མཚན་མའི་རྣམ་པར་གཡེང་བ་དང་།",
    "གནས་ངན་ལེན་གྱི་རྣམ་པར་གཡེང་བའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་གྲངས་བཞིན་དུ་མིང་བཀོད་པའོ།",
    "དེ་ལ་སྤྱི་ནི་རྣམ་པར་གཡེང་བ་ལྔ་ཞེས་བསྟན་པའོ།",
    "འདི་ལྟར་མིང་ལ་བྱེད་པ་དེ་ཉིད་རྣམ་པར་གཡེང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་དམན་པའི་སེམས་ཀྱིས་ཡིད་ལ་བྱེད་པ་ཞེས་བསྟན་པ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "ཡུལ་རྣམ་པ་གསུམ་པོ་དག་ལ་རྣམ་པར་གཡེང་བ་ཐ་དད་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "སྙོམས་པར་འཇུག་པའི་རོ་མྱང་བའམ།",
    "བདག་གོ་སྙམ་དུ་ང་རྒྱལ་བསྐྱེད་པ་སྟེ་བདག་ཏུ་ལྟ་བའི་ང་རྒྱལ་དང་མཚུངས་པར་ལྡན་པའི་རྣམ་པར་གཡེང་བ་དེ་ཉིད་ལ་གནས་ངན་ལེན་ཞེས་བྱའོ།",
    "དེ་ལ་གནས་ངན་ལེན་གྱི་རྣམ་པར་གཡེང་བ་ཞེས་བྱ་བ་ལ་ལྟ་བ་དང་ང་རྒྱལ་གྱི་ས་བོན་ནི་གནས་ངན་ལེན་ཞེས་བྱ་སྟེ།",
    "རྣམ་པར་གཡེང་བའི་ངོ་བོ་ཉིད་དེ་ཡང་རྣམ་པ་དྲུག་གོ་ཞེས་བསྟན་ལ།",
    "དེ་ལ་ངོ་བོ་ཉིད་རྣམ་པར་གཡེང་བ་ལ་བརྟེན་ནས་རྣམ་པར་གཡེང་བའི་ངོ་བོ་ཉིད་བསྟན་པས་ཕན་ཚུན་འགལ་བ་མེད་དོ།",
    "རྣམ་པར་གཡེང་བ་ནི་རྣམ་པ་གཉིས་ཡོད་དེ།",
    "དེ་ཡང་ངོ་བོ་ཉིད་རྣམ་པར་རྟོག་པ་ཡང་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "གཞན་ཡང་རྣམ་པར་ཤེས་པ་ལྔ་པོ་དག་ལས་རྣམ་པར་གཡེང་བ་ཞེས་བསྟན་པ་ནི་གཞན་དག་ལས་བྱུང་བ་བསྟན་པ་ཡིན་གྱི།",
    "དེས་ན་རྣམ་པར་ཤེས་པ་ལྔ་པོ་དག་ལ་རྣམ་པར་གཡེང་བ་ཞེས་བྱ་བས་ན་དེའི་ཕྱིར་ཕན་ཚུན་འགལ་བ་མེད་དོ།",
    "ཞིབ་ཏུ་དེ་ཉིད་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "རྒྱ་ཆེར་དེ་ཉིད་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཡིད་ལ་བྱེད་པའི་རྣམ་པར་གཡེང་བ་ནི་འདི་ལྟ་སྟེ།",
    "འདི་ཉིད་ཀྱི་འགྲེལ་པ་ལས་སྙོམས་པར་འཇུག་པ་གཞན་ལས་སྙོམས་པར་འཇུག་པ་དང་།",
    "བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་དང་།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་རྙིང་འགྱུར་ལས་ནི་སེམས་པ་ཞེས་འབྱུང་སྟེ།",
    "ཕྱི་རོལ་གྱི་དམིགས་པའི་ཡུལ་ལ་སེམས་རྣམ་པར་འཕྲོ་བར་གཏོང་ན།",
    "དེ་ནི་ཕྱི་རོལ་དུ་སེམས་རྣམ་པར་གཡེང་བ་ཡིན་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་ཕྱི་རོལ་དུ་སེམས་རྣམ་པར་གཡེང་བ་སྟོན་ཏོ།",
    "འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་དག་ལ་སེམས་རྣམ་པར་འཕྲོ་བའོ་ཞེས་འབྱུང་སྟེ།",
    "ཕྱི་རོལ་དུ་འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་དག་ལ་སེམས་རྣམ་པར་འཕྲོ་བར་རིག་པར་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་ནི་ཕྱི་རོལ་གྱི་ཡུལ་ཞེས་འབྱུང་ངོ།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ནི་དམིགས་པ་ལ་སེམས་རྣམ་པར་འཕྲོ་བ་ཞེས་འབྱུང་ངོ།",
    "དེ་ལ་སེམས་རྣམ་པར་འཕྲོ་བར་གཏོང་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་གཡེང་བ་རྣམ་པ་གསུམ་གྱི་བདག་ཉིད་ཡང་དག་པར་བསྟན་ཏེ།",
    "འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་དག་ལ་སེམས་རྣམ་པར་འཕྲོ་བ་དང་།",
    "འདྲེས་པའི་མཚན་མ་རྣམས་ལ་རྣམ་པར་འཕྲོ་བ་དང་།",
    "ཡུལ་སྔ་མ་གཉིས་ལས་གཞན་པའི་དམིགས་པའི་ཡུལ་ལ་སེམས་རྣམ་པར་འཕྲོ་བའོ།",
    "བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་ནི་ཏིང་ངེ་འཛིན་གྱི་རོ་མྱང་བ་དང་།",
    "རྣམ་པར་གཡེང་བའི་སེམས་མཐོ་དམན་དུ་གྱུར་པ་དང་།",
    "བཞི་པ་ནི་སྙོམས་པར་འཇུག་པའི་རོ་མྱང་བ་སྟེ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་བཅུ་དང་།",
    "ངོ་བོ་ཉིད་ཀྱི་དང་ཕྱི་རོལ་དུ་གཡེང་བས་ནི་མ་ཐོབ་པ་གང་ཡིན་པ་ཐོབ་པར་མི་འགྱུར་རོ།",
    "གནས་ངན་ལེན་གྱི་གཡེང་བས་ནི་རྣམ་པར་གྲོལ་བ་ཐོབ་པར་མི་བྱེད་དོ།",
    "གཞན་ཡིད་ཆེས་པར་བྱ་བ་སྔོན་དུ་བཏང་སྟེ།",
    "འདི་ཉིད་ཀྱི་འགྲེལ་པ་ལས་གཞན་གྱིས་བདག་ལ་ཡོན་ཏན་དང་ལྡན་པར་ཡིད་ཆེས་པར་བྱ་བའི་ཕྱིར་དེའི་མཚན་མ་སྟོན་པ་སྟེ།",
    "བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་ནི།",
    "མཚན་མའི་སེམས་རྣམ་པར་གཡེང་བ་ནི་འདི་ལྟ་སྟེ།",
    "གནས་ངན་ལེན་གྱི་ས་བོན་གྱིས་རྒྱུ་དང་རྐྱེན་བྱས་ནས་བསྐྱེད་པའི་བདག་ཏུ་ལྟ་བ་དང་ངའོ་སྙམ་དུ་ང་རྒྱལ་སྐྱེད་པར་བྱེད་པས་ལྟ་བ་དང་ང་རྒྱལ་དང་མཚུངས་པར་ལྡན་པའི་རྣམ་པར་གཡེང་བ་ཉིད་ལ་གནས་ངན་ལེན་ཅེས་བྱ་སྟེ།",
    "གནས་ངན་ལེན་གྱི་རྣམ་པར་གཡེང་བ་ནི་ངར་འཛིན་པ་དང་།",
    "ལན་དུ་གསུངས་པ་སྟེ།",
    "དེ་ནི་སྒྲིབ་པ་གཉིས་སུ་རྣམ་པར་རྟོག་པའི་ངོ་བོ་ཉིད་དེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "སྒྲིབ་པ་གཉིས་ལས་རྣམ་པར་རྟོག་པ་ལས་བྱུང་བ་གང་ཡིན་པའོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ནི་ཀུན་དུ་རྨོངས་པ་གཉིས་ལ་སོགས་པ་བསྟན་པའི་ཕྱིར་ཡང་དག་པ་ལས་བརྩམས་ཏེ།",
    "བརྗོད་པ་ཀུན་དུ་རྨོངས་པ་གཉིས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྒྲིབ་པ་གཉིས་ལ་བརྟེན་ནས་སོ་སོའི་སྐྱེ་བོའི་ངོ་བོ་ཉིད་རྣམ་པར་གཞག་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "གཉིས་པ་ལོག་པར་སྒྲུབ་པ་གཉིས་ལས་ལྷན་ཅིག་སྐྱེས་པའི་ཕྱོགས་གཅིག་དང་།",
    "ལས་ཀྱི་རྣམ་པ་སྣ་ཚོགས་ལ་ཀུན་དུ་རྨོངས་པ་ཞེས་གསུངས་པ་ཉིད་དེ་ཞིབ་ཏུ་དེ་ཉིད་ལས་བསྟན་པ་བཞིན་ནོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ནི་འདི་ལྟ་སྟེ།",
    "ཐོས་པ་དང་བསམས་པ་དང་བསྒོམས་པའི་ཤེས་རབ་ལ་སྒྲིབ་པར་བྱེད་པས།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "གཟུངས་ཁྱད་པར་དུ་འཕགས་པ་དང་།",
    "གཟུངས་ཀྱིས་བསྐྱེད་པའི་ཤེས་རབ་ཁྱད་པར་དུ་འཕགས་པ་རྣམ་པ་གསུམ་ལ་སྒྲིབ་པར་བྱེད་ལ་ཀུན་དུ་རྨོངས་པ་ཉི་ཤུ་རྩ་གཉིས་ལས་འདོད་པའི་འདོད་ཆགས་ཀྱི་ཀུན་དུ་རྨོངས་པ་དང་།",
    "ཐོས་པའི་གཟུངས་ཡོངས་སུ་རྫོགས་པ་ལ་ཀུན་དུ་རྨོངས་པ་ཡང་སྡུད་པར་བྱེད་དོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ཐོས་པ་དང་བསམས་པ་དང་བསྒོམས་པ་བརྗེད་པར་བྱེད་པའི་མ་རིག་པ་ཞེས་འབྱུང་སྟེ།",
    "དོན་གྱིས་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ཀུན་དུ་རྨོངས་པ་རྣམ་པ་གཉིས་བསྟན་པ་དང་མཐུན་ནོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་བསྟན་པ་བཞིན་ནོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་སྐྱེས་པའི་བདག་ཏུ་ལྟ་བ་དང་།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ལས་ལྷན་ཅིག་སྐྱེས་པའི་ཕྱོགས་གཅིག་དང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་པའི་འཇིག་ཚོགས་ལ་ལྟ་བ་ལ་སོགས་པས་བསྡུས་པ་གང་ཡིན་པའོ།",
    "སྙོམས་པར་འཇུག་པའི་སྲེད་པ་དང་།",
    "སྙོམས་པར་འཇུག་པ་ལ་སྲེད་པ་དང་།",
    "སྙོམས་པར་འཇུག་པ་ལ་སྲེད་པའི་ཀུན་དུ་རྨོངས་པ་དང་།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་ཞེས་མ་གསུངས་པ་ནི།",
    "ཡང་དག་པར་ཀུན་དུ་རྨོངས་པ་རྣམ་པ་གཉིས་ཁོ་ནར་མ་ཟད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ངེས་པའི་ཚིག་བསྟན་པ་ཡང་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ནི་ཤེས་བྱའི་སྒྲིབ་པ་ལས་ལྷན་ཅིག་སྐྱེས་པའི་ཕྱོགས་གཅིག་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ལ་གཅིག་ཏུ་མངོན་དུ་ཕྱོགས་པ་ཉིད་ཡིད་ལ་བྱེད་པ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "འཕགས་པ་ས་བཅུ་པའི་འགྲེལ་པ་ལས་ནི་ལུས་ཡོངས་སུ་གཙང་ངོ་སྙམ་པའི་ང་རྒྱལ་གྱི་སྒྲིབ་པ་ཞེས་འབྱུང་ངོ།",
    "མངོན་དུ་ཕྱོགས་པ་ཞེས་བྱ་བས་ནི་ཀུན་དུ་རྨོངས་པ་གཉིས་ཡང་དག་པར་བསྡུ་བ་ཡིན་ཏེ།",
    "མིང་ཉིད་ཀྱིས་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "དེ་ལ་ངེས་པའི་ཚིག་བསྟན་པ་ཡང་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "རྣམ་པར་བྱང་བ་མེད་པའི་ལམ་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "ས་དྲུག་པར་ཞུགས་པའི་ཚེ་ཡོངས་སུ་སྤོང་བར་བྱེད་པ་དེས་ན།",
    "དེ་ནི་འདིར་རྣམ་པར་བྱང་བ་ཡོད་པ་ཉིད་དུ་འཛིན་ཅིང་།",
    "བརྟགས་ན་བརྡ་ཕྲད་པར་འགྱུར་རོ།",
    "ལུགས་ལས་ལྡོག་པའི་མཚན་མ་ཡོད་པ་ཉིད་དུ་འཛིན་པས་མཚན་མ་དེ་གཉིས་ཡོངས་སུ་བཟུང་བའི་ཕྱིར་ས་བདུན་པའི་གྱ་ནོམ་པ་མཚན་མ་མེད་པའི་ལམ་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "ས་བདུན་པར་ཞུགས་པའི་ཚེ་ཡོངས་སུ་སྤོང་བར་བྱེད་པས་དེས་ན་ས་བདུན་པས་ནི་ཀུན་དུ་རྨོངས་པ་རྣམ་པ་གཉིས་དང་།",
    "ཕན་ཚུན་འགལ་བ་མེད་པ་ཡང་གོང་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་བརྒྱད་པ་མཚན་མ་མེད་པ་ལས་རྩོལ་བ་དང་བཅས་པའི་སྒྲིབ་པ་ནི་འདི་ལྟ་སྟེ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་མིང་གཅིག་སྨོས་པ་ཡང་སྤྱིར་ཀུན་དུ་རྨོངས་པ་གཉིས་བསྡུས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "དགུ་པ་གཞན་ལ་ཕན་འདོགས་པ་སྒྲུབ་པར་མི་འདོད་པའི་སྒྲིབ་པ་ནི་འདི་ལྟ་སྟེ།",
    "དེས་ས་དགུ་པའི་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "དེ་ལ་རྣམ་པ་ཐམས་ཅད་དུ་ཚིག་ལ་མཁས་པ་ཞེས་བྱ་བ་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལ་སྤྱིར་རྣམ་པ་ཐམས་ཅད་ཚིག་ལ་མཁས་པ་ཞེས་བྱའོ།",
    "བརྟགས་ན་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་དང་།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "ཡོངས་སུ་སྦས་པ་དང་དེས་བསྐྱེད་པའི་བྱ་བ་དག་ལ་སྒྲིབ་པར་བྱེད་དེ།",
    "ས་བཅུ་པར་ཞུགས་པའི་ཚེ་ཡོངས་སུ་སྤོང་བར་བྱེད་པ་དེས་ན་ས་བཅུ་པས་ཀུན་དུ་རྨོངས་པ་རྣམ་པ་གཉིས་དང་།",
    "དེ་ནི་འདི་ལྟར་དེས་བསྐྱེད་པའི་བྱ་བ་དག་ལ་སྒྲིབ་པར་བྱེད་པ་ཞེས་བསྟན་པ་ཉིད་དོ།",
    "ཡང་ན་སྤྱིར་ཀུན་དུ་རྨོངས་པ་གཉིས་བསྡུས་པར་བསྟན་ཏོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "དེ་བཞིན་གཤེགས་པར་འགྱུར་ཏེ།",
    "ས་བཅུ་གཅིག་པ་ལ་ནི་ཤེས་བྱའི་སྒྲིབ་པ་ཤིན་ཏུ་ཕྲ་བ་དང་མཆོག་ཏུ་ཆེས་ཤིན་ཏུ་ཕྲ་བའི་གཉེན་པོར་གྱུར་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་ཕྱོགས་གཅིག་ཏུ་ཤེས་བྱའི་སྒྲིབ་པ་བསྟན་པ་ཡིན་ནོ།",
    "མཐོང་བ་ཐོབ་པར་བསྟན་པ་སྟེ།",
    "མཐོང་བ་ཐམས་ཅད་འཐོབ་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "ལེགས་པར་བསམས་པ་དང་།",
    "ལེགས་པར་གཞག་པའི་དེ་བཞིན་ཉིད་དེ་ཉིད་ནང་དུ་ཡང་དག་པར་ཡིད་ལ་བྱེད་དེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པ་སྟོན་ཏོ།",
    "རྒྱུའི་གནས་སྐབས་སུ་སྤྱོད་པ་རྣམས་བརྩོན་འགྲུས་ཀྱིས་སྒྲུབ་པར་བསྟན་པ་དང་།",
    "དེ་ལ་དང་པོ་དེ་བཞིན་ཉིད་རྣམ་པ་བདུན་ལས་བརྩམས་ཏེ་ཞེས་བྱ་བ་ནི་བརྟག་པར་བྱ་བའི་ཡུལ་སྨོས་པ་སྟེ།",
    "དེ་བཞིན་ཉིད་བདུན་པོ་དག་ལ་རྟོག་པར་བྱེད་པས་སོ།",
    "ཐོས་པ་ཞེས་བྱ་ནི་ཉན་པར་བྱེད་པའོ།",
    "འདི་ལྟར་བསམས་པའི་ཤེས་རབ་ནི་བསྟན་པ་དག་ལ་སེམས་པར་བྱེད་པས་ཤེས་རབ་བསྐྱེད་ནས།",
    "དེ་ལ་ཐོས་པའི་ཤེས་རབ་ཀྱིས་ནི་དེ་བཞིན་ཉིད་བདུན་ལ་བརྟེན་ནས་ལེགས་པར་གཏན་ལ་འབེབས་སོ།",
    "ལེགས་པར་བསམས་པས་ཞེས་བྱ་ནི་བསམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་སོ།",
    "ལེགས་པར་གཞག་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་དེ་བཞིན་ཉིད་རྣམ་པ་བདུན་ལ་བརྟེན་ནས་ནང་དུ་ཡིད་ལ་བྱེད་པའི་ཕྱིར་རོ་ཞེའོ།",
    "དེས་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་མཚན་མ་རྣམ་པར་སེལ་བ་བསྟན་པ་སྟེ་འདི་ནི་དང་པོའོ།",
    "དམིགས་པར་བྱ་བ་གང་ཡིན་པ་དེ་ནི་ཕྱི་རོལ་ཞེས་བྱའོ།",
    "རྒྱ་ཆེར་ནི་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "མིང་ལ་སོགས་པའི་མཚན་མ་རྣམ་པ་ལྔ་རྒྱ་ཆེར་འབྱེད་པ་ནི་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ལེགས་པར་སེམས་པར་བྱེད་པས་རྣམ་པར་ཤེས་པ་ནི་འཇོག་ལ་མཚན་མ་ནི་རྣམ་པར་སེལ་བར་བྱེད་དོ།",
    "རྣམ་པར་སེལ་བ་ཉིད་བསྟན་པ་དང་།",
    "དེས་དེ་ལྟར་སྤྱོད་པ་དེ་དག་ལ་མང་དུ་གནས་པའི་ཕྱིར་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་སེམས་ལེགས་པར་སྦྱོར་བ་བསྟན་པའོ།",
    "དེ་ལ་མཚན་མ་རགས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་གཡེང་བའི་གནས་སྐབས་སྟོན་པས་ཡོངས་སུ་བཟུང་བའི་མཚན་མ་རྣམས་སོ།",
    "ས་འོག་མ་ལ་རགས་པར་ལྟ་བའི་མཚན་མ་རགས་པ་ཐམས་ཅད་དོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "རྣམ་པར་རིག་པའི་མཚན་མའམ།",
    "དེ་ཡང་རྣམ་པ་བཅུ་གཅིག་ཏུ་བསྡུས་ནས་བསྟན་པར་བྱའོ།",
    "འོག་མ་རྣམས་ཀྱང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ངེས་པར་འབྱིན་པ་གང་ཡིན་པ་དེ་ནི་ལམ་གྱི་མཚན་ཉིད་དོ་ཞེས་འབྱུང་སྟེ།",
    "འདུས་བྱས་ཀྱི་མཚན་མའམ་འདུས་མ་བྱས་ཀྱི་མཚན་མ་ཞེས་བྱ་བ་ནི་དྲུག་པ་འདུས་མ་བྱས་ཀྱི་མཚན་མ་བསྟན་པའོ།",
    "སྐྱེ་བ་ལ་སོགས་པའི་མཚན་ཉིད་རྣམ་པ་བཞི་དང་ལྡན་པ་གང་ཡིན་པ་དེ་ནི་འདུས་བྱས་ཀྱི་མཚན་མ་ཞེས་བྱའོ།",
    "དེ་ལས་བཟློག་པ་གང་ཡིན་པ་དེ་ནི་འདུས་མ་བྱས་ཀྱི་མཚན་མ་ཞེས་བྱ་སྟེ།",
    "སྔར་བསྟན་པའི་འདུས་བྱས་དང་འདུས་མ་བྱས་དང་།",
    "སྡུག་བསྔལ་རྣམ་པར་འགྱུར་བ་དང་བཅས་པ་ཉིད་ཀྱི་མཚན་མའམ།",
    "སྡུག་བསྔལ་རྣམ་པར་འགྱུར་བ་མེད་པ་ཉིད་ཀྱི་མཚན་མ་ཞེས་བྱ་བ་ནི་བརྒྱད་པ་སྡུག་བསྔལ་རྣམ་པར་འགྱུར་བ་དང་བཅས་པ་ལ་སོགས་པའི་མཚན་མ་བསྟན་པའོ།",
    "སྡུག་བསྔལ་དང་བདེ་བའི་ཚོར་བ་གཉིས་ནི་སྡུག་བསྔལ་རྣམ་པར་འགྱུར་བ་དང་བཅས་པ་ཉིད་ཀྱི་མཚན་མ་ཞེས་བྱའོ།",
    "བཏང་སྙོམས་ཀྱི་ཚོར་བ་གང་ཡིན་པ་དེ་ནི་སྡུག་བསྔལ་རྣམ་པར་འགྱུར་བ་མེད་པ་ཉིད་ཀྱི་མཚན་མ་ཞེས་བྱའོ།",
    "ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་གང་ཡིན་པ་དེ་ནི་སྡུག་བསྔལ་རྣམ་པར་འགྱུར་བ་མེད་པ་ཉིད་ཀྱི་མཚན་མ་ཞེས་བྱའོ།",
    "བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་དང་།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་ཐ་དད་པའི་མཚན་མའམ།",
    "བདག་མེད་པ་འདི་གཉིས་ཀྱང་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཅིའི་ཕྱིར་དེ་དག་ལ་རྣམ་པར་སེལ་བར་བྱ་བ་ཞེས་བསྟན་ཅེ་ན།",
    "གོང་དུ་བསྟན་པ་བཞིན་དུ་མངོན་དུ་མི་སྣང་བའི་ཕྱིར་རྣམ་པར་སེལ་བ་ཞེས་བྱའི།",
    "མཐོང་བའི་ལམ་ཉིད་ཡང་དག་པར་བསྟན་པ་དང་།",
    "འདི་ནི་དང་པོ་མཐོང་བའི་ལམ་ཉིད་ཡང་དག་པར་བསྟན་པ་སྟེ།",
    "གཞན་ཡང་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས།",
    "སྦྱོར་བ་བར་ཆད་མེད་པའི་ཤེས་པ་འདི་སྐྱེས་པའི་ཚེ་དེ་བཞིན་ཉིད་ཁོང་དུ་ཆུད་པར་འགྱུར་བས་རབ་ཏུ་རྟོག་པའི་གནས་སྐབས་ཞེས་བྱའོ།",
    "མཐོང་བའི་ལམ་གཉིས་པོ་དེ་ཡང་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་དང་།",
    "ས་རབ་ཏུ་དགའ་བ་ལ་གནས་པར་འགྱུར།",
    "ཕྱི་མའི་མཐའ་ཇི་སྲིད་པར་ཐམས་ཅད་ལ་ཕན་འདོགས་པར་བྱེད་དོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ཕན་ཡོན་རྣམ་པ་དྲུག་ཡོད་པར་སྟོན་ཏེ།",
    "ཕན་ཡོན་རྣམ་པ་དྲུག་པོ་འདི་རྒྱ་ཆེར་རྣམ་པར་འབྱེད་པ་ནི།",
    "དེའི་ཕྱིར་དེ་ཉིད་ལས་འདི་ཉིད་ནི་ཡང་དག་པ་ཉིད་སྐྱོན་མེད་པར་ཞུགས་པ་ཞེས་ཀྱང་བྱའོ།",
    "ཐོག་མ་ཁོ་ནར་ཡང་དག་པ་ཉིད་དུ་ངེས་པར་ཞུགས་པ་ཡང་ཡིན་པའི་ཕྱིར་རོ།",
    "མྱ་ངན་ལས་འདས་པའོ་ཞེས་གསུངས་སོ།",
    "མཐོང་བའི་ལམ་གྱིས་འགོག་པར་བྱེད་པའི་ཕྱིར་སྐྱོན་མེད་པ་ཞེས་བྱའོ།",
    "མཐོང་བའི་ལམ་གྱིས་འགོག་པར་བྱེད་པའི་ཕྱིར་སྐྱོན་མེད་པ་ཞེས་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "གཞན་ཡང་ས་དེའི་ཕན་ཡོན་ཡང་ཡོངས་སུ་མྱོང་བ་ཡིན་ནོ་ཞེས་བྱ་བ་འདིས་ནི་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ཕན་ཡོན་གཞན་དྲུག་བསྟན་པ་དག་བསྡུས་པར་སྟོན་ཏོ།",
    "དེས་སྔར་ཞི་གནས་དང་ལྷག་མཐོང་ཐོབ་པའི་ཕྱིར་དམིགས་པ་རྣམ་པ་གཉིས་ཀྱང་ཐོབ་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་གཟུགས་བརྙན་གྱི་དམིགས་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་གཟུགས་བརྙན་གྱི་དམིགས་པའོ།",
    "དེས་ད་ལྟར་མཐོང་བའི་ལམ་ཐོབ་པའི་ཕྱིར་ཡང་དངོས་པོའི་མཐའི་དམིགས་པ་ཡང་ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདིས་ནི་གཉིས་པ་དངོས་པོའི་མཐའི་དམིགས་པའི་ཕན་ཡོན་སྟོན་ཏོ།",
    "གཅིག་ཁོ་ན་མ་ཡིན་པས་ཚིག་ཟློས་བུར་གོང་མ་གོང་མ་ཞེས་གསུངས་སོ།",
    "གཉིས་པ་ནི་དམིགས་པ་རྣམ་པ་གསུམ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དམིགས་པ་རྣམ་པ་གསུམ་དང་ལྡན་པར་བསྟན་ཏེ།",
    "རྗེས་ལས་ཐོབ་པའི་ཡེ་ཤེས་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་གཟུགས་བརྙན་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་གཟུགས་བརྙན་གྱི་སྤྱོད་ཡུལ་རྣམ་པ་གཉིས་ཡིད་ལ་བྱེད་པ་མ་ཡིན་པས་སོ།",
    "གཏན་ཚིགས་དེས་ན་ས་བཅུ་པོ་ཀུན་ལ་ཡང་ཡུལ་རྣམ་པ་གསུམ་པོ་དག་ཚང་བར་ཡོད་པར་མངོན་ནོ།",
    "མཚན་མ་ཡོངས་སུ་བསལ་བའི་ཕྱིར་གནས་ངན་ལེན་རྣམས་ཀྱང་རྣམ་པར་སེལ་བར་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གསུམ་པ་དཔེ་དང་དོན་དུ་སྦྱར་བ་སྟོན་ཏོ།",
    "མཚན་མ་ཡོངས་སུ་བསལ་བའི་ཕྱིར་མཚན་མའི་འཆིང་བ་ཐམས་ཅད་རྣམ་པར་སེལ་ཏོ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་རྣམ་པར་མ་བཞག་པའི་བདེན་པ་ལ་སྤྱོད་པ་ནི་མཚན་མ་ལ་སྤྱོད་པ་ཡིན་ཏེ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ཇི་སྐད་དུ་སྦྱོར་བའི་གནས་སྐབས་ལ་གནས་པ་དེས་མཚན་མའི་འཆིང་བ་ཡོངས་སུ་མ་བསལ་བས།",
    "དེའི་ཕྱིར་སའི་མདུན་རོལ་པས་འཆིང་བ་གཉིས་མི་སྤོང་བར་རིག་པར་བྱའོ།",
    "གསེར་རྣམ་པར་དག་པ་ལ་རྣམ་པ་གསུམ་ཡོད་དེ་སྐྱོན་རྣམ་པར་དག་པ་དང་།",
    "གར་བུ་རྣམ་པར་དག་པ་དང་།",
    "ལས་སུ་རུང་བ་རྣམ་པར་དག་པའོ།",
    "ཆ་ཕྲ་བ་བསལ་བས་ཅི་ཙམ་དུ་གསེར་ཕྱེ་དག་པར་འགྱུར་བ་ཁོ་ན་ལུས་པར་གྱུར་པའོ།",
    "དེ་ལ་གར་བུ་རྣམ་པར་དག་པ་ནི་དེ་ཉིད་བཞུ་ནས་གར་བུར་གྱུར་པ་གང་ཡིན་པའོ།",
    "སྙིགས་མ་ལ་མི་ཕྱོགས་པ་ཉིད་ཀྱིས་སྐྱོ་བར་བྱས་ལ།",
    "ཇི་ལྟར་བསམས་པའི་དོན་ཡང་དག་པར་འགྲུབ་པའི་ཕྱིར་འགྲོ་བར་ཡང་དག་པར་འགྱུར་རོ་ཞེས་འབྱུང་ངོ།",
    "དགོས་པ་ཡོངས་སུ་གྲུབ་པའི་དམིགས་པ་ཡང་ཐོབ་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་གཉིས་པ་འབྲས་བུའི་གནས་སྐབས་ཞེས་བྱ་བ་སྟོན་ཏེ།",
    "གཞན་ཡང་གནས་འདི་ལ་བརྟེན་ནས་དམིགས་པ་རྣམ་པ་བཞི་ལས་བཞི་པ་དགོས་པ་ཡོངས་སུ་གྲུབ་པའི་དམིགས་པ་ཡང་ཐོབ་པར་འགྱུར་བའོ།",
    "ཡོན་ཏན་ཡངས་ཤིང་རྒྱ་ཆེར་རབ་ཏུ་འདྲེན་པར་འགྱུར་ལགས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་བཅུ་བདུན་པ་མཐུ་དང་ཡོན་ཏན་ཡངས་ཤིང་རྒྱ་ཆེ་བའི་བར་དུ་འདྲེན་པའི་སྒོ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "ལན་དུ་གསུངས་པ་སྟེ།",
    "ཡོན་ཏན་ཡངས་ཤིང་རྒྱ་ཆེ་བ་ཇི་སྙེད་ཡོད་པ་དག་རབ་ཏུ་འདྲེན་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ལན་དུ་ཡང་དག་པར་གསུངས་པ་སྟོན་ཏོ།",
    "མཐུ་དང་ཡོན་ཏན་རྒྱ་ཆེ་བ་རབ་ཏུ་འདྲེན་པར་འགྱུར་བས་སོ།",
    "བརྟག་པ་དང་ལན་དུ་གསུངས་པ་སྟེ།",
    "དེ་ལ་མཁས་པ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་ཤེས་པར་བྱེད་པའི་སེམས་སོ།",
    "སྐྱེ་བ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་སེམས་ཏེ།",
    "སྣོད་བརྟན་པར་གནས་པའི་རྣམ་པར་རིག་པའི་སྐྱེ་བ་རྣམ་པར་མི་རིག་པ་ནི་འདི་ལྟ་སྟེ།",
    "རྟག་པར་རྒྱུན་མི་འཆད་པའི་ཕྱིར་བརྟན་པར་གནས་པ་ཞེས་བྱའོ།",
    "ལེན་པའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་བསྟན་པའོ།",
    "དམིགས་པའི་རྣམ་པ་ཡང་ཡུལ་གྱི་རྗེས་སུ་གཅིག་ཁོ་ན་མ་ཡིན་པའི་ཕྱིར་རྣམ་པ་སྣ་ཚོགས་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དམིགས་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ཞེས་བྱ་བ་ནི་ཡུལ་ལ་མིང་དུ་བཏགས་པ་སྟེ།",
    "ཡུལ་ལ་དམིགས་པའི་རྣམ་པར་ཤེས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཟག་པ་དང་བཅས་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བསྟན་པ་དང་།",
    "ཟག་པ་མེད་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བསྟན་པའོ།",
    "འདི་ནི་དང་པོ་སྟེ་འདི་ལྟར་དུས་གཅིག་ཏུ་ཅིག་ཅར་གཟུགས་ལ་སོགས་པའི་ཡུལ་ཐམས་ཅད་འཛིན་པ་རྣམ་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་ནི་རྣམ་པར་ཤེས་པ་ལྔ་པོ་དག་དང་དུས་གཅིག་ཏུ་རྣམ་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའམ།",
    "དེ་བཞིན་གཤེགས་པ་མང་པོ་མཐོང་བ་རྣམ་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་ཟག་པ་མེད་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བསྟན་པའོ།",
    "ཕྱིས་ཐོབ་པ་འདི་ཡང་ཟག་པ་དང་བཅས་པའི་སེམས་ལ་ལྟོས་ན་ནི་རྣམ་པར་མི་རྟོག་པ་ཞེས་བྱའོ།",
    "ངོ་བོ་ཉིད་ཀྱི་ཡེ་ཤེས་ལ་ལྟོས་ན་ནི་རྣམ་པར་རྟོག་པ་ཞེས་བྱའོ།",
    "ཇི་ལྟར་སྐད་ཅིག་མ་གཅིག་ལ་ཏིང་ངེ་འཛིན་མང་པོ་ལ་སྙོམས་པར་འཇུག་ཅེ་ན།",
    "རྣམ་པ་གཞན་དུ་ན་ཇི་ལྟར་འོས་པ་བཞིན་དུ་ཏིང་ངེ་འཛིན་རྣམས་ལ་སྙོམས་པར་འཇུག་པ་ཡིན་གྱི་ཡང་དག་པར་སྐད་ཅིག་མ་གཅིག་ལ་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པ་ནི་མ་ཡིན་ནོ།",
    "མཚན་མ་ཆུང་ངུ་ལ་དམིགས་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "འདོད་པའི་ཁམས་དང་ལྡན་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་གསུམ་པ་སྟོན་ཏོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ་ཡང་འདོད་པའི་ཁམས་སུ་ནི་རྒྱུ་ཆུང་ངུའི་དམིགས་པ་རྣམ་པར་རིག་པས་དམིགས་པ་ཆུང་ངུའི་དམིགས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "མཚན་མ་ཆེན་པོར་གྱུར་པ་ལ་དམིགས་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "གཟུགས་ཀྱི་ཁམས་དང་ལྡན་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བཞི་པ་སྟོན་ཏེ།",
    "མཚན་མ་མེད་པ་ལ་དམིགས་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་འདི་ལྟ་སྟེ།",
    "བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ནི་གཟུགས་མེད་པའི་ཁམས་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་དང་།",
    "ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་དང་ལྡན་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་དྲུག་པ་བསྟན་པའོ།",
    "མཚན་མ་མཐར་ཐུག་པ་ལ་དམིགས་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་དང་ལྡན་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བདུན་པ་སྟོན་ཏེ།",
    "ཡང་ན་མཚན་མ་ལྔ་པོ་དེ་དག་ཅི་རིགས་པར་རྣམ་པར་ཤེས་པ་དྲུག་པོ་དག་དང་སྦྱར་རོ།",
    "མཚན་མ་མེད་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "འཇིག་སྟེན་ལས་འདས་པའི་རྣམ་པར་རིག་པ་དང་།",
    "འགོག་པ་ལ་དམིགས་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བརྒྱད་པ་སྟོན་ཏེ།",
    "དེ་ལ་འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་རིག་པ་ཞེས་བྱ་བ་ནི་ཟག་པ་མེད་པའི་ལམ་གྱི་བདེན་པ་དང་།",
    "མཚུངས་པར་ལྡན་པའི་རྣམ་པར་ཤེས་པ་ཟག་པ་དང་བཅས་པའི་སྤྲོས་བའི་མཚན་མ་རྣམས་ཡོངས་སུ་སྤངས་པའི་ཕྱིར་མཚན་མ་མེད་པ་ཞེས་བྱའོ།",
    "འདིར་ཟག་པ་མེད་པ་རྣམ་པར་དག་པའི་རྣམ་པར་ཤེས་པ་བརྒྱད་པོ་དག་ཀྱང་གཏོགས་སོ།",
    "སྡུག་བསྔལ་དང་ལྡན་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "སྡུག་བསྔལ་དང་མཚུངས་པར་ལྡན་པའི་རྣམ་པར་རིག་པ་ནི་ངན་འགྲོའི་རྣམ་པར་རིག་པ་ལྟ་བུའོ་ཞེས་འབྱུང་ངོ།",
    "ཚོར་བ་འདྲེན་མ་དང་ལྡན་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "འདོད་པ་ན་སྤྱོད་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བ་ནི་སེམས་བཅུ་པ་བསྟན་ཏེ།",
    "ཡི་དགས་དང་དུད་འགྲོ་ལས་ཁ་ཅིག་ནི་འཇུག་པའི་རྣམ་པར་ཤེས་པ་དང་མཚན་མཚུངས་པར་ལྡན་པ་སྡུག་བསྔལ་གྱི་ཚོར་བ་དང་།",
    "མཚུངས་པར་ལྡན་པའི་རྣམ་པར་རིག་པ་ནི་འདོད་པའི་ཁམས་ཀྱི་རྣམ་པར་ཤེས་པ་ལྟ་བུའོ་ཞེས་འབྱུང་ངོ།",
    "དགའ་བ་དང་ལྡན་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "བསམ་གཏན་དང་པོ་དང་གཉིས་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བཅུ་གཅིག་པ་བསྟན་ཏོ།",
    "བདེ་བའི་ཚོར་བ་ཡང་ཡོད་པར་སྟོན་པས་སོ།",
    "མཚུངས་པར་ལྡན་པའི་རྣམ་པར་རིག་པ་ནི་བསམ་གཏན་དང་པོ་དང་གཉིས་པའི་རྣམ་པར་ཤེས་པ་ལྟ་བུའོ་ཞེས་འབྱུང་ངོ།",
    "བདེ་བ་དང་ལྡན་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "བསམ་གཏན་གསུམ་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བ་ནི་སེམས་བཅུ་གཉིས་པ་བསྟན་ཏོ།",
    "བདེ་བ་དང་མཚུངས་པར་ལྡན་པའི་རྣམ་པར་རིག་པ་ནི་བསམ་གཏན་གསུམ་པ་ལྟ་བུའོ་ཞེས་འབྱུང་ངོ།",
    "སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བཅུ་གསུམ་པ་སྟོན་ཏོ།",
    "འདི་ལྟར་བསམ་གཏན་བཞི་པ་ཡན་ཆད་ཀྱི་ས་པ་རྣམས་གཅིག་ཏུ་ཚོར་བ་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་པས་སོ།",
    "འདིར་ནི་ཟག་པ་དང་བཅས་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ཡང་གཏོགས་སོ།",
    "ཚོར་བ་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་པའི་རྣམ་པར་རིག་པ་ནི་བསམ་གཏན་བཞི་པ་དང་།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་པའི་བར་གྱི་རྣམ་པར་ཤེས་པ་ལྟ་བུའོ་ཞེས་འབྱུང་ངོ།",
    "དད་པ་ལ་སོགས་པ་དང་ལྡན་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བཅོ་ལྔ་པ་བསྟན་ཏེ།",
    "ཟག་པ་མེད་པའི་རྣམ་པར་ཤེས་པ་བརྒྱད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ལུང་མ་བསྟན་པ་དང་ལྡན་པའི་རྣམ་པར་རིག་པ་སྐྱེ་བ་ནི་འདི་ལྟ་སྟེ།",
    "དེ་གཉི་ག་དང་མི་ལྡན་པའི་རྣམ་པར་རིག་པའོ་ཞེས་བྱ་བས་ནི་སེམས་བཅུ་དྲུག་པ་སྟོན་ཏོ།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདི་ཡང་བརྟག་པ་དང་ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "དེ་ལ་མཁས་པ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་ཤེས་པར་བྱེད་པའི་སེམས་ཏེ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་རབ་ཏུ་ཤེས་པའོ་ཞེས་བྱ་བས་ནི་གཉིས་པ་ལན་དུ་གསུངས་པ་བསྟན་ཏེ།",
    "འདི་ལྟར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དང་མཐུན་པའི་སེམས་རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་རབ་ཏུ་ཤེས་པར་གྱུར་ནས།",
    "ཡང་ན་རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་ཅེས་བྱ་བ་ནི་དེ་བཞིན་ཉིད་རྣམ་པ་བདུན་ལས་རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་དེ།",
    "དེ་ནི་སོ་སོར་བརྟག་པར་ནུས་པའི་ཤེས་པ་ལ་རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་ཅེས་བྱ་སྟེ།",
    "རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་ནི་འདི་ལྟ་སྟེ།",
    "ཡུལ་ལ་བརྟེན་ནས་གནས་པ་གང་ཡིན་པ་དེ་ནི་སེམས་ཀྱི་གནས་ལ་མཁས་པ་ཞེས་བྱའོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "འདི་ཡང་བརྟག་པ་དང་ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "མཚན་མའི་འཆིང་བ་དང་གནས་ངན་ལེན་གྱི་འཆིང་བ་དེ་དག་ལས་སེམས་འདི་བསླང་བར་བྱའོ་ཞེས་བྱ་བ་ལ་མཁས་པའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་ལན་དུ་གསུངས་པ་སྟེ།",
    "ཡོངས་སུ་ཤེས་པའི་སེམས་དེ་ལ་མཁས་པར་གྱུར་ན།",
    "འདི་ཡང་བརྟག་པ་དང་ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཚན་མའི་འཆིང་བ་དང་གནས་ངན་ལེན་གྱི་འཆིང་བའི་གཉེན་པོའི་སེམས་གང་ཡིན་པ་དེ་འཕེལ་བ་དང་དེ་བསགས་པར་གྱུར་པའི་ཚེ་འཕེལ་བར་གྱུར་ཏོ།",
    "བསགས་པར་གྱུར་ཏོ་ཞེས་རབ་ཏུ་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་འཕེལ་བ་ལ་མཁས་པ་ཞེས་བྱའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་ལན་དུ་གསུངས་པ་སྟེ།",
    "དེ་བསགས་པར་གྱུར་པའི་ཚེ་འཆིང་བའི་གཉེན་པོར་གྱུར་པའི་སེམས་དང་མཐུན་པར་གྱུར་པའི་ཤེས་རབ་ལ་སོགས་པས་རབ་ཏུ་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་འཕེལ་བ་ལ་མཁས་པ་ཞེས་བྱའོ།",
    "འདི་ཡང་བརྟག་པ་དང་ལན་དུ་གསུངས་པས་བསྟན་ཏོ།",
    "འབྲི་བ་ལ་བྱེ་བྲག་ཡོད་པ་ཡང་གོང་དུ་བསྟན་པའི་འཕེལ་བ་དང་བསགས་པ་ལས་བཟློག་པར་རིག་པར་བྱའོ།",
    "འདི་ཡང་བརྟག་པ་དང་ལན་དུ་གསུངས་པས་སྟོན་ཏོ།",
    "ཡོངས་སུ་བསལ་བ་རབ་ཏུ་ཤེས་པ་ཞེས་བྱ་བ་ནི་གཉིས་པ་ལན་དུ་གསུངས་པ་སྟེ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་བཅུ་སྟེ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་དང་།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་ལ་བྱེ་བྲག་ཅི་ཡོད་ཅེ་ན་སྨྲས་པ།",
    "འདི་ནི་ཟད་པར་གྱི་སྐྱེ་མཆེད་དོ་ཞེས་ཟེར་བས་སོ།",
    "འབྲས་བུ་གང་ཡིན་པ་དེ་ནི་ཟད་པར་གྱི་སྐྱེ་མཆེད་ཅེས་བྱའོ།",
    "བཅོམ་ལྡན་འདས་བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་སྐད་དུ་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སུ་ཚོར་བ་ཐམས་ཅད་མ་ལུས་པར་འགག་པར་འགྱུར་རོ་ཞེས་གང་གསུངས་པ་ལ།",
    "ཚོར་བ་གང་དག་དེར་གཏན་དུ་འགག་པར་འགྱུར་ལགས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་བཅོ་བརྒྱད་པ་ལྷག་མ་མེད་པའི་དབྱིངས་སུ་ཚོར་བ་འགག་པར་འགྱུར་བ་བསྟན་པའི་སྒོ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "ཞུ་བ་དེ་ཉིད་ཡང་དག་པར་གསོལ་བ་ཉིད་དོ།",
    "འདི་ཡང་བརྟག་པ་དང་ལན་དུ་གསུངས་པ་སྟེ།",
    "ཚོར་བ་རྣམས་ཡང་དག་པར་བསྟན་པ་དང་།",
    "ལྷག་མ་དང་བཅས་པ་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་གཏན་དུ་འགག་པར་འགྱུར་བ་བསྟན་པའོ།",
    "འདི་ལྟར་ཟག་པ་དང་བཅས་པའི་ས་བོན་ནི་ད་ལྟར་གྱི་འབྲས་བུའི་རྟེན་བྱས་པས་སོ།"
  ]
}