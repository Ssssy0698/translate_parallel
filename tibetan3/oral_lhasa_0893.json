    "ཁྱད་པར་གོང་མའི་ལུང་རིགས་ཟླ་ཉིས་སྨིན་པར་མ་ནུས་པའི།",
    "གཡོ་ཟོག་མིན་པར་དད་པའི་མགོ་ལྕོག་ལན་སྟོང་ལྡེམ།",
    "རིས་བྲལ་རྒྱལ་བསྟན་སྤྱི་དང་ཁྱད་པར་དུ།",
    "བཞུགས་ཏེ་འབྲལ་མེད་རྗེས་འཛིན་སྐྱབས་འཇུག་ཀྱི།",
    "ཨེ་མ་ཞི་བའི་ནགས་མཐོངས་གང་ན་པར།",
    "ཡབ་སྲས་དྲིལ་སྒྲུབ་ཀྱི་ཚོགས་དང་སྙན་བརྒྱུད་ཀྱི་ཚོགས་བསྡུས་ལ་བརྟེན་ནས་ཚོགས་ལྔ་ཁྲིར་ལོངས་པ་འབུལ་བར་གནང་།",
    "འབུལ་ཚོགས་བཅས་སྤོམ་མཐོར་གནང་ནས་བསྟན་འགྲོའི་དོན་དུ་འགྱུར་བའི་ཐུགས་སྨོན་གྱི་རྒྱས་འདེབས་པའི་བཀའ་དྲིན་བསྐྱངས།",
    "གདུལ་བྱའི་སྣང་ངོར་བདུད་ཀྱི་རིགས་ཀྱི་གླགས་མ་རྙེད་པར་བསྟན་ལ་དོས་འཛུགས་ཀྱི་རྐྱེན་བཟློག་པའི་ཚུལ་བསྟན་པའང་།",
    "ཁྱབ་པར་སྤྱི་དོ་གམ་མཐོང་མཇལ་བར་འདོད་པའི་མི་མིན་རིགས།",
    "བདེ་འདུས་ལས་བཞི་རྒྱུན་ལྔའི་སྦྱིན་སྲེག་རྫས་སྤོམ་མཐོ་བ་དང་བཅས་ཉི་ཁྲི་ཆིག་སྟོང་དུ་ལོངས་པ་ཚད་ལྡན་འབུལ་བར་གནང་།",
    "སྐབས་འགའ་ཐོ་རངས་ཅུང་ཟད་བསྙེལ་ཚུལ་ལས་གཉིད་ཀྱང་སྤངས་ནས་བསྐོར་བ་མཛད་པ་སོགས་མཚན་བཅས་མཚན་མེད་གང་ལའང་ཆུ་བོའི་རྒྱུན་གྱི་དགེ་སྦྱོར་ལ་བརྩོན་པ་མཛད་ཚུལ་སོགས་ལ་དཔགས་ན་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བའི་རྣམ་པར་ཐར་བ་ཟླ་དང་བྲལ་བ་སྟེ།",
    "གཅིག་ཡིད་ལྷུང་ལྷ་རི་སྒར་དུ་འཛུགས་པར་གནང་ནས།",
    "འཁོར་ལོ་རྒྱུན་དུ་བསྐོར་བ་པོའི་ལོག་དང་ཡོན་བཅས་ཐེབས་སྦྱོར་རྒྱུན་འཇགས་སུ་གནང་ནས་དགེ་ཚོགས་རླབས་པོ་ཆེའི་རྒྱུན་འགྱུར་བར་མཛད།",
    "འདི་ལོར་སྐུ་མདུན་དུ་བཅར་མི་གལ་ཆེའི་རིགས་འགའ་དབྲ་སྟོན་པཎྜི་ཏའི་གསུང་འབུམ་ཕྱོགས་བསྒྲིགས།",
    "ཀུན་སྤྱོད་པ་ཀུན་བློ་བཟོདེ་ནས་དགུང་གྲངས་བདུན་ཅུ་བཞེས་པའི་ས་འབྲུག་ལོ་སྔར་རྒྱུན་གྱི་སྔོན་འགྲོའི་ཁྲིད་ཟིན་མཐར།",
    "བདེ་འདུས་ཚོགས་སུམ་སྟོང་ལྷག་དགོངས་འདུས་སྦྱིན་སྲེག་ལྔ་སྟོང་ཙམ་འགྲུབ་པར་མཛད།",
    "ལོ་འདིའི་སྟོན་ཀའི་དུས་སུ་ཕྱོགས་སོ་སོའི་དད་ལྡན་རྣམས་ཀྱིས་སྙན་བསྐུལ་བཞིན་ཀུན་ལ་མཇལ་ཞུས་ཀྱི་བཀའ་ཕེབས་སྩལ་ནས་རྫ་ཡུལ་སྟོད་སྨད་ཡུལ་འབྲོག་ཉེ་རིང་ཕྱོགས་འདུས་ཀྱི་མི་སྣ་སྟོང་ཕྲག་ལས་བརྒལ་བ་ལ།",
    "ངས་ནི་བཤདགེ་མ་ཀ་དག་དབྱིངས་སུ་སྙོམས་པར་ཞུགས་ཚུལ་སྟོན།",
    "སྒྲུབ་བཤེདེ་ནས་རྗེ་ཉིད་དགུང་ལོ་དོན་གཅིག་བཞེས་པའི་ས་སྦྲུལ་ལོ་ལ།",
    "སེམས་དོན་རྩད་གཅོད་འབྲེལ་བར་བདག་མེད་ཀྱི་གོ་དོན་སོགས་སེམས་ལ་གང་ཕན་གྱི་ཁྲིད་མང་དུ་གནང་བའི་བཀའ་དྲིན་སྩལ།",
    "འདི་སྐབས་སྔ་ཕྱིར་གྲྭ་ཚང་ལས་ཚན་དུ་མར་མཇལ་ཞུས་དང་ཞལ་བསྒོས་རིགས་བསྟན་དོན་དུ་འགྱུར་གང་ཆེའི་བསླབ་སྟོན་སོགས་ཐུགས་བཞེས་ཆེས་ཆེར་གནང་ཞིང་རྒྱུན་གྱི་ཐུགས་དམ་ཉམས་བཞེས་སོགས་ཀྱང་ཆགས་མེད་ཡར་ལྡན་དུ་མཛད་དོ།",
    "རྗེ་ཉིད་ནས་ཐུགས་གཤིས་ཀྱིས་བོན་ལ་འཆད་ཉན་རིགས་གང་འདོད་ཕྱིར་ལྡོག་མཛད་མ་མྱོང་བ་ལྟར་བཞུགས་ཤིང་།",
    "ཁྱད་པར་གསེར་ཞྭ་དང་རྟ་བེར་སོགས་བོད་ཀྱི་བཅོས་མའི་ཆ་ལུགས་རིགས་ནི་སྐུ་ཚེའི་རིང་ལ་བརྟེན་མ་མྱོང་ཞིང་དུས་རྟག་ཏུ་བསྟན་དང་འགྲོ་ལ་སྨོན་པའི་ལྷག་བསམ་གྱིས་ཅི་བསྒྲུབ་ཐམས་ཅད་བསྟན་དོན།",
    "ཅི་མཛད་ཐམས་ཅད་གཞན་དོན་དུ་རང་ཤུགས་ཀྱིས་འགྱུར་བའི་འཕགས་ཆེན་དམ་པའི་རྣམ་པར་ཐར་བ་མངོན་དུ་གྱུར་པ་སྟེ།",
    "དད་པས་མཇལ་བའི་སྐྱེ་བོ་ཀུན་ཀྱིས་མཐོང་ཐོས་སུ་གྱུར་པའི་ཚུལ་འདིས་མཚོན་ནས་ཤེས་པར་བྱའོ།",
    "ག་ད་བ་ས་འདུལ་ལ་ཇི་བཞིན་ཉམས་སུ་བསྟར་བའི་རྣམ་པར་ཐར།",
    "བཀོད་ལེགས་པར་གནང་ནས།",
    "མགོན་ཆེན་བརྒྱད་དང་བཅས་རྒྱུ་དངོས་ཕུན་སུམ་ཚོགས་པའི་སྒོ་ནས་བཟོ་ཁྱད་བཀོད་པ་རྨད་དུ་བྱུང་བ་བསྐྲུན་པར་མཛད།",
    "རྗེས་ཀྱི་ལེགས་སོའི་གནང་སྦྱིན་སོགས་གཟབ་རྒྱས་སུ་སྩལ་བའི་སྒོ་ནས་ཡིད་ཡོངས་སུ་མགུ་བར་མཛད།",
    "ཅི་ཡོན་ཏན་ཆ་ཤས་ཙམ་ཡང་ཟླ་མེད་པའི་རྣམ་པར་ཐར་བའོ།",
    "རྗེ་ནས་ཕྱིས་སུ་ལྷ་ཁང་རྗེས་བཞག་གསར་བཞེངས་ཤིག་དགོངས་ཀྱང་དངོས་སུ་ནི་མ་གསུངས།",
    "རྒྱུན་གྱི་རྣལ་འབྱོར་རིག་སྟོང་དབྱེར་མེད་ཀྱི་དགོངས་པའི་ཀློང་དུ་མཉམ་པར་སྐྱོང་ངོས་ནས་མཚན་བཅས་ཀྱི་བོན་སྤྱོད་ལའང་བརྩོན་པར་མཛད།",
    "དྲེལ་དམར་གྱི་བསྙེན་སྒྲུབ་དང་འབྲེལ་བར་ཚོགས་གཏོར་རྒྱ་ཆེར་འབུལ་བར་གནང་ཞིང་ཉིན་མཚན་དུས་དྲུག་ཏུ་གཏོར་མ་འབུལ་བར་མཛད་ཅིང་།",
    "ཏིང་ངེ་འཛིན་ལ་ཡུན་རིང་བོར་འབྱམས་ནས་ཞུ་བསྐུལ་མ་བྱས་ན་གསོལ་ཆས་དུས་ལས་ཡོལ་བ་ལན་དུ་མར་བྱུང་།",
    "བཞིན་སྐུ་ཆས་མཆོད་ཆ་ཡོངས་རྫོགས་རྗེའི་མདུན་དུ་འབུལ་བ་འབྱོར་བས་མཆོད་ཆོག་དང་བསྔོ་བ་དམིགས་པ་མེད་པའི་མཚམས་སྦྱོར་རྒྱས་པར་མཛད།",
    "བཟླས་སྔགས་བྱེ་བ་གཅིག་དང་ཚེ་སྒྲུབ་འབུམ་བཞི་བཅས་རྫོགས་པར་གནང་བའི་བཀའ་དྲིན་སྩལ།",
    "ལར་ཚེ་འདིའི་མཐུན་རྐྱེན་ཙམ་ལས་བསྟན་དོན་ལ་མི་ཕན་པའི་སྲུང་མའི་རིགས་དེ་དཀོར་བདག་ཟེར་བ་ཡིན་གྱི་བསྟན་སྐྱོང་ཟེར་བ་མིན་ཞེས་བཀའ་ཕེབས་ཞིབ་པར་གནང་བར་མཛད།",
    "སྙན་བརྒྱུད་ཀྱི་དངོས་གྲུབ་ཞེས་པ་གང་ཡིན་གཏན་ལ་འབེབས་རྒྱུའི་སྐལ་པ་ནི་མ་བྱུང་པར་སྣང་ངོ།",
