    "མི་བསྐྱོད་པ་ལ་སོགས་པའི་རིགས་བཞི་རྣམས་ཀྱང་རང་ཉིད་ཀྱིས་རང་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཉིད་དུ་བྱིན་གྱིས་བརླབས་ནས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་སེམས་མ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་བཅིངས་ནས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཕྱག་གསུམ་འཚོལ་ལ།",
    "ཁྱེད་རང་རྣམས་ཧཱུཾ་ལས་རྡོ་རྗེ་སེམས་དཔའི་ཤརམར་རྡོ་རྗེ་ཧཱུྃ་མཛད་ཀྱི་ཞེས་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལག་ན་འདུག།",
    "ཁྱེད་རང་རྣམས་རིགས་ལྔའི་སྐུར་རིམ་བཞིན་གསལ་ཞིང་ང་རྒྱལ་ལ་གནས་པས་ཕྱག་རྒྱ་སློབ་དཔོན་དང་ལྷན་ཅིག་ཏུ་འཆིང་བར་མཛོད།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་གཞན་ཕྱག་རྒྱ་ལ་མི་མཁས་པ་གང་ལ་ཡང་ཕྱག་རྒྱ་གཅིག་ཀྱང་སྟོན་པར་མ་བྱེད་ཅིག་དེ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "བཛྲ་ཀརྨ་ཨི་དཾ་བཛྲ་བེ་རོ་ཙ་ན་ཨ་དྷི་ཏིསརྦ་ཏ་ཐཱ་ག་ཏ་ཨཱ་ཙཱརྨ་སྭཱ་ཧཱ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལག་ན་འདུག།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་བཏུད་ཙམ་དང་བཅས་ནས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལག་ན་འདུག།",
    "ཅེས་བརྗོད་ཝལ་ཁྱེད་རང་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་བཏུད་ཙམ་དང་བཅས་ནས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དཀྱིལ་འཁོར་གྱི་ཤར་ཕྱོགས་སུ་སྣ་ཚོགས་པདྨ་འདབ་མ་བརྒྱད་པའི་ལྟེ་བར་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཏཱཾ་ལས་ཁྱེད་རང་རྣམས་དོན་གྲུབ་ནོར་བུའི་འོད་ཅན་ཕྱག་གཡས་ས་གནོན་གྱི་ཕྱག་རྒྱས་ནོར་བུའི་རྡོ་རྗེ་བསྣམས་པ།",
    "ཁྱེད་རང་རྣམས་དེ་བཞིན་གཤེགས་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་བཏུད་ཙམ་དང་བཅས་པས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་འདུད་ཙམ་དང་བཅས་ནས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཧཱུྃ་ཨདེ་ནས་དཀྱིལ་འཁོར་ལ་མེ་ཏོག་དབུལ་བ་ནི་ཁྱེད་རང་རྣམས་ཀྱིས་ཀ་པུ་ཊ་སྤྱི་བོར་བཅིངས་ནས་ཕབ་སྟེ་དཀུ་གཡོན་དུ་ཁུ་ཚུར་གཡོན་བཔའི་ཁར་གཡས་པ་ཕུབ་པའི་གཡས་མཐེའུ་ཆུང་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མིག་འབྲས་ཧཱུྃ་ལས་རྡོ་རྗེར་བསྐྱེད་དེ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་བཏུད་ཙམ་དང་བཅས་པས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཀ་པུ་ཊ་སྤྱི་བོར་བཅིངས་ནས་ཕབ་སྟེ་དཀུ་གཡོན་དུ་ཁུ་ཚུར་གཡོན་པའི་ཁར་གཡས་པ་ཕུབ་པའི་གཡས་མཐེའུ་ཆུང་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མིག་འབྲས་ཧཱུཾ་ལས་རྡོ་རྗེར་བསྐྱེད་དེ།",
    "བཛྲ་ལོ་ཙ་ནི་ཧཱིཨོ་བཛྲ་ཨ་བྷི་ཥིཉྩ།",
    "བཛྲ་ལོ་ཙ་ནི་ཧིཨོ་བཛྲ་ཨ་བྷི་ཥིཉྩ།",
    "ཁྱེད་རང་རྣམས་དེ་བཞིན་གཤེགས་པ་དང་།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་བཏུད་ཙམ་དང་བཅས་ནས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མིག་འབྲས་ཧཱུཾ་ལས་རྡོ་རྗེར་བསྐྱེད་དེ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཕྱོགས་ལ་མགོ་བོ་དུད་ཙམ་དང་བཅས་ནས་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཀ་པུ་ཊ་སྤྱི་བོར་བཅིངས་ནས་ཕབ་སྟེ་དཀུ་གཡོན་དུ་ཁུ་ཚུར་གཡོན་པའི་ཁར་གཡས་པ་ཕུབ་པའི་གཡས་མཐེའུ་ཆུང་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མིག་འབྲས་ཧཱུཾ་ལས་རྡོ་རྗེར་བསྐྱེད་དེ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལག་ན་འདུག།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཀྱང་རྡོ་རྗེ་དེ་མགོ་བོར་ཞོག་ལ་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ས་མ་ཡ་ཐོསྭོ་ཞེས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་ཚོགས་ཞིང་རང་ལ་བསྡུ་བ་ནི།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "དེ་ནས་ཚོགས་ཞིང་རང་ལ་བསྡུ་བ་ནས་བདག་རྫོགས་ཀྱི་བཟླས་པའི་བར་སྔར་བཞིན་བྱ།",
    "ལ་ལར་འཇིག་དུས་ཉི་མ་འཆར་ཀ་བྱེ་བའི་འོད་ཟེར་ཚོགས་ནི་འཇིགས་ཆེན་འབར།",
    "ད་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་དཀྱིལ་འཁོར་དུ་འཇུག་པ་དང་།",
    "ལ་ལར་འཇིག་དུས་ཉི་མ་འཆར་ཀ་བྱེ་བའི་འོད་ཟེར་ཚོགས་ནི་འཇིག་ཆེན་འབར།",
    "མཚམས་འདིར་བདག་འཇུག་དུས་སུ།",
    "ཁྱེད་རང་རྣམས་ཧཱུཾ་འདི་དཀྱིལ་འཁོར་ལྷོ་མར་ཧཱུཾ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྟེང་དུ་བླ་བྲེ།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ཐབས་དང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་རྟ་། བདུན་གྱིས་དྲངས་པའི་ཤིང་རྟའི་སྟེང་དུ་པད་ཟླ་ལ།",
    "ཨཱ་ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་པད་ཟླ་ལ་འཇམ་དཔལ་གཞོན་ནུ་ལོ་བརྒྱད་ལོན་པ་ལྟ་བུ།",
    "དེའི་སྟེང་དུ་ཁྱེད་རང་སྣ་ཚོགས་པད་ཟླ་ལ་ནམ་མཁའ་མཛོད་ཞལ་དཀར་པོ།"
  ]
}