    "གངས་ལྗོངས་བསྟན་པའི་མངའ་བདག་རྗེ་བཙུན་ས་སྐྱ་པའི་བསྟན་འཛིན་ཀུན་གྱི་གཙུག་རྒྱན་དམ་པར་ཡང་ནས་ཡང་དུ་བསམ་བཞིན་དུ་སྐྱེ་བ་བཞེས་པའི་ཚུལ་འདི་ལྟར་ཐོས་ཏེ།",
    "སླར་སེམས་དཔའ་ཆེན་པོའི་ཞབས་པད་ལ་གཏུགས་ཏེ་སྤྱན་སྔར་འབྲལ་མེད་བཞུགས།",
    "ཕྱག་གཡས་པ་རྗེ་འདི་ཉིད་ཀྱི་དབུ་ལ་བཞག་གཡོན་པས་ཕྱག་ཕྲེང་ལ་གྲངས་སུ་གནང་ནས་བཅུ་གཅིག་ཞལ་གྱི་གཟུངས་རིང་བརྒྱ་རྩའི་རིང་ཞབས་སྐོར་གནང་བ་ལ་ཉིན་གཅིག་བཀའ་ལུང་ལ།",
    "ཅི་ལགས་ཞུས་པས།",
    "སྦྱོང་དཀྱིལ་གྱི་བརྒྱུད་པ་ཁོ་ལ་ཐུག་པ་ཞིག་ཡོང་གསུངས་པའི་མ་འོང་ལུང་བསྟན་ཀྱང་བྱོན་པ་ཡིན་ཞེས་ཀྱང་ཐོས་སོ།",
    "རྗེ་འདི་ཉིད་དགུང་ལོ་བཅུ་གཅིག་བཞེས་པའི་ཚེ།",
    "དེའི་ཕྱི་ལོ་དགུང་ལོ་བཅུ་གཉིས་བཞེས་སྐབས་སེམས་དཔའ་ཆེན་པོའི་དྲུང་དུ་ཤོག་གསུངས་ནས་བྱོན་པས།",
    "སེམས་དཔའ་ཆེན་པོའི་གསུངས་ནས།",
    "དེ་ནས་རྟེན་གསུམ་གྱི་ནང་དུ་བཞུགས་སུ་ཆུག་གསུང་བའི་ལུང་བསྟན་སྩལ་ཅིང་།",
    "ད་ལྟ་ངས་ལོན་པའི་ལོ་གྲངས་འདི་ཙམ་གྱི་ཚེ་ཐུབ་པ་ཡིན་ཞེས་བཀའ་སྩལ་གནང་བ་ལ་ཚེམས་དེ་ཐུགས་གཉེར་སྐབས་མངའ་རིས་བ་དབོན་པོ་ནམ་བློས་ནན་བསྐྱེད་ཞུས་ནས་ཕྱེད་བཅག་ནས་གནང་དགོས་བྱུང་།",
    "ཕྱེད་ལྷག་དེ་སྐུ་འབྲུམ་བསྙེལ་སྐབས་དེ་དབུ་སྔས་ཀྱི་རྩིག་སྲུབས་སུ་བཞག་པ་བྱི་བས་ཁྱེར་ནས་ཕྱག་ཏུ་མ་བྱུང་བ་ལ་ཐུགས་ལས་གནང་ཞིང་།",
    "དེ་ཀས་ཡོང་གསུངས་པའི་བཀའ་སྩལ་བྱུང་གསུངས་ཤིང་།",
    "ཐུགས་དམ་བརྒྱ་རྩ་མ་ཚེ་གཟུངས་ཆག་མེད་དུ་གནང་བར་ངེས་ལ།",
    "དབོན་ཆུང་དེ་ཀུན་ལ་བསྟན་པ་འཛིན་པའི་སྐྱེས་བུ་ཁྱད་པར་ཅན་ཞིག་ཡོང་ངེས་ཡང་ཡང་གསུངས་པར་གྲགས་ཤིང་།",
    "འཕུར་མ་ཐུབ་པ་དེ་སྒྲིབ་པ་ཤས་ཆེ་བ་ཡིན་གསུངས་ཤིང་།",
    "ལྷག་མ་རྣམས་ཀྱང་ཆུས་བཀྲུས་ནས་བཞེས་པའི་ངང་ལ་མནལ་སད་བྱུང་རྗེས་དགོངས་པ་ལ།",
    "དེ་ལྟར་གསུང་ངག་གནང་རྗེས་སྟོན་སེར་རྗེ་སེམས་དཔའ་ཆེན་པོས་བསམ་གཏན་ཕུག་ཏུ་སྐུ་མཚམས་དམ་པར་མཛད་པ་གྲོལ་འཕྲལ།",
    "ཕྱིས་དེ་བཞིན་རང་བྱུང་གསུངས་ཤིང་།",
    "དབྱར་དེ་རྗེ་སེམས་དཔའ་ཆེན་པོ་བསམ་གཏན་ཕུག་ཏུ་སྐུ་མཚམས་གནང་བཞེད་ལ།",
    "གླང་ཐང་ནས་སྤྱན་སྔ་ཀུན་དགའ་རྡོ་རྗེའི་དྲུང་དཔོན་སློབ་དྲག་བསྡུས་ཕེབས་པའི་ཞལ་ངོར།",
    "རྗེ་སེམས་དཔའ་ཆེན་པོ་བསམ་གཏན་ཕུག་ཏུ་སྐུ་མཚམས་ལ་ཕེབས་པའི།",
    "གདུང་འབུལ་ལ་ཞབས་གཏད་ཕེབས་བྱུང་སྐབས།",
    "སྡོམ་རིགས་སོགས་གཞུང་ཆེན་རྣམས་ལ་སྦྱངས་བརྡར་གནང་བའི་མུ་ནས།",
    "ཟླ་བ་བཅུ་གཉིས་པའི་ཚེས་བརྒྱད་ལ་རྩིས་བཞེས་ཙམ་མཛད།",
    "སྤྱི་ཁང་སྒོས་ཁང་སོ་སོའི་ལས་གྲྭ་བཙུགས་སྐབས་རྗེ་ཉིད་ཀྱིས་ཀྱང་གནས་རྙིང་སོགས་ནས་ཤིང་ཆ་སྒྲུབ་པ་གནང་ནས་མུས་པའི་སྤྱི་ཁང་དེ་ཉིད་འདེབས་པ་གནང་ཞིང་།",
    "ཁོ་ལ་ཚེ་རིང་ཐུང་ཅི་ཡོང་ལགས་ཞུས་པས།",
    "མཁའ་འགྲོ་ཀུན་སྤྱོད་རྗེ་བཙུན་གྱི་འགྲེལ་བའི་སྟེང་ནས་མཛུབ་ཁྲིད་ལེགས་པར་སྩལ་ཅིང་།",
    "སྦྱོང་རྒྱུད་ཀུན་མཁྱེན་ཉིད་ཀྱི་ཊཱིཀྐའི་སྟེང་ནས་མཐའ་གཅོད་རྒྱ་ཆེར་བཀྲལ་ནས་གསུངས་ཤིང་།",
    "ནཱ་རོ་མཁའ་སྤྱོད་སོགས་ཐུགས་དམ་རྒྱུན་བཞེས་མཐའ་དག་དང་།",
    "རྣམ་རྒྱལ་འཇོམས་སོགས་རྗེས་གནང་ཟུར་བཀའ་དུ་མ།",
    "ཀུན་མཁྱེན་ཉིད་ཀྱིས་མཛད་པའི་སྔགས་འབུམ་ཕལ་ཆེར་གྱི་ལུང་།",
    "མི་གཡོ་བ་སྔོན་པོ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "ལུང་འགའ་ཞིག་དང་བཅས་པ་གསན་གསུངས།",
    "ལྷ་རྩེའི་ག་ཡ་དྷ་རའི་སྒྲུབ་ཕུག་རྣམས་ཀྱི་གནས་མཇལ་གནང་རྗེས།",
    "དེ་ནས་ཐུབ་བསྟན་རྣམ་རྒྱལ་བར་ཕྱག་ཕྱིར་ཕེབས།",
    "ལོ་ངོ་བརྒྱད་དུ་ཉེ་ཙམ་ཞབས་པད་བརྟན་པར་མཛད་སྐབས།",
    "དེར་སྐུ་འབྲུམ་ལེགས་པར་དྭངས་ནས་མུས་སུ་བྱོན་ཅིང་།",
    "སྒྲུབ་པ་ལུང་སྦྱིན་པའི་བར་ཡང་དང་ཡང་དུ་ནོད་པར་མཛད་ཅིང་།",
    "རྣམ་རྒྱལ་འཇོམས་ཀྱི་རྗེས་གནང་།",
    "མགོན་པོ་ལྕམ་དྲལ་ལྷ་བརྒྱད་སོགས་རྗེས་གནང་སྒོ་དུ་མ་དང་།",
    "དེ་ནས་རྗེ་ཉིད་དགུང་ལོ་ཉེར་བདུན་དུ་ཕེབས་ས་ཕག་ལོ་ཟླ་བ་བཅུ་གཉིས་པའི་གནམ་གང་ལ།",
    "རྗེ་ཉིད་ཀྱིས་ཀྱང་ཕྱག་ཕྱིར་ཕེབས་ཏེ།",
    "སྔོན་རྗེ་སེམས་དཔའ་ཆེན་པོ་སྟ་ཏེ་ལུང་དུ་བཞུགས་དུས་ཉེ་གནས་ཕྱག་གཡོག་མཛད་ཅིང་།",
    "དེ་ནས་དགུང་ལོ་སུམ་ཅུ་སོ་གཉིས་ལ་ཕེབས་སྐབས།",
    "ལམ་འབྲས་ཤིག་གནང་བཞེད་མཛད་དུས།",
    "རྗེ་གྲུབ་ཆེན་བསམ་གཏན་ཕུག་ན་བཞུགས་ཡོད་པས།",
    "རྗེ་འདི་ལ་ཡར་སྤྱན་དྲོངས་གསུངས།",
    "དེ་སྐབས་སྔོན་རྗེ་སེམས་དཔའ་ཆེན་པོའི་གསུངས་ནས།",
    "ཁོང་པ་ཆུ་བཤན་གྱིས་གསུངས།",
    "དེའི་ཚུལ་རྣམས་རྒྱས་པར་འོག་ཏུ་འཆད་དོ།",
    "གསོལ་དཔོན་ཐུགས་རྗེ་སོགས་ལ་གནང་བར་གྲགས་ཤིང་།",
    "གདོང་ཡངས་སུ་བཞུགས་རིང་ནོར་འཛིན་གྱི་བཅུད་ལེན་ཁོ་ནའི་བཀའ་ཐུབ་ལ་བརྟེན་པར་མཛད་ཅེས་ཀྱང་སྒྲོག་ལ།",
    "སྐུ་མཚམས་ཀྱི་མུ་ཡང་སྔ་རྟིང་ལོ་དྲུག་ཙམ་གྱི་རིང་མཛད་པར་མངོན་ཞིང་།",
    "ནེ་རིང་སེམས་མ་སོགས་ཀྱིས་ཞུས་ནས་གསུང་ངག་ཚར་གཉིས་ཀྱང་གནང་སྐད་དོ།",
    "དགུང་ལོ་སོ་བཞིར་ཕེབས་པ་རྟ་ལོ་གླིང་ཁ་བདེ་བ་ཅན་གྱི་ཁྲི་ཐོག་ཏུ་ཕེབས་ཏེ།",
    "དེའི་ཕྱི་ལོ་རྗེ་ཉིད་གླེ་ལུང་དུ་གདན་དྲངས་ཏེ་གསུང་ངག་གནང་སྐབས།",
    "ཐུབ་པ་དགོངས་གསལ་གྱི་ལུང་ཞིག་གནང་།",
    "གནས་སྐབས་དེ་དག་ཏུ་ཡང་གཙོ་བོར་གྲུབ་ཆེན་ཉིད་ཀྱི་སྤྱན་སྔར་འབྲལ་བ་མེད་པར་བཞུགས་ཏེ།",
    "ཚེ་སྒྲུབ་སྲུང་ཟློག་སྦྱིན་སྲེག་ཕྱི་གཏོར་ནང་གཏོར་སོགས་ཁོར་མར་གནང་ཞིང་།",
    "ཕྱི་རྟེན་ཁང་བུ་བརྩེགས་པ་གཉིས་བཞེངས་པར་མཛད་ནས།",
    "དུས་མཆོད་ལ་གསང་འདུས་མི་བསྐྱོད་རྡོ་རྗེའི་བསྒྲུབ་མཆོད་འཛུགས་པ་གནང་ཞིང་།",
    "གསང་འདུས་འཇམ་པའི་རྡོ་རྗེའི་སྒྲུབ་མཆོད་ཀྱང་འཛུགས་པ་གནང་རྗེས།",
    "དགུང་ལོ་ཞེ་བཞི་བཞེས་པ་འབྲུག་ལོ་ལྷ་སར་ཇོ་སྐོར་ལ་ཞབས་བཙུགས་ཕེབས་སྐབས།",
    "ལས་གཤིན་བཅུ་གསུམ་མའི་རྗེས་གནང་།",
    "གུར་མགོན་བཅུ་གཅིག་མའི་རྗེས་གནང་།",
    "གདོང་གཉན་ཅན་གྱི་རྗེས་གནང་།",
    "དེ་སྐབས་ན་ལེནྡྲ་ནས་སྤྱན་འདྲེན་བྱུང་བ་ལ་ཞལ་བཞེས་ཀྱི་སྒོ་ཡོད་ཙམ་གནང་ནས།",
    "གྲལ་བཞུགས་རྣམས་བཞད་གད་དིར་བ་བྱུང་ཞེས་གྲགས་ཤིང་།",
    "སྔ་ཕྱིར་འཇམ་དཀར་རྗེས་གནང་།",
    "ཇ་གོས་དར་སོགས་འབུལ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་འབུལ་བ་གནང་ཞིང་།",
    "དུར་ཁྲོད་བདག་པོའི་རྗེས་གནང་རྣམས་གསན་ཅིང་།",
    "རྗེ་ངོར་ཆེན་གྱི་ཕྱག་དམ་ནན་བསྐྱེད་དང་བཅས་དབེན་གནས་གདོང་ཡངས་སུ་བཞུགས་པའི་སྤྱན་སྔར་སོན་པ་ན།",
    "ཆིབས་ཀྱི་ཁ་ལོ་བསྒྱུར་ནས་ཕེབས་སྐབས།",
    "རྗེ་ཉིད་བཞུགས་པའི་རིང་དུས་བདེ་ཞིང་ཕན་ཚུན་འཁྲུག་ལོང་སོགས་ཀྱི་གཡེང་བ་གཏན་ནས་མེད་པ་དང་།",
    "ཁོས་དྲུང་པ་གར་འབྱོན་པ་ལགས་ཞུས་པས།",
    "སྟོན་བཙས་ཆོད་ཙམ་ལ་ཕེབས་འཕྲལ་རང་།",
    "དེའི་དགུན་གླིང་ཁ་ཉིད་དུ་གསུང་ངག་ཚར་གཅིག་གནང་ནས།",
    "ཁྱི་ལོ་ཤར་ཙམ་ལ་སླར་ཡང་ཤར་ཕྱོགས་ལ་ཆིབས་ཁ་བསྒྱུར་ཏེ་ཕེབས་སྐབས།",
    "རིན་ཆེན་གླིང་དུ་གསུང་ངག་ཚར་གཅིག་གནང་ཞིང་།",
    "ད་དུང་ཇ་སྦྱོར་གཅིག་ཐོབ་མི་འགྲོ་གསུངས།",
    "དེ་མ་ཁད་མི་གཅིག་བྱུང་པ་ལ་མ་འགྲོ་གསུངས་པས།",
    "ཁོས་བཀའ་ལ་མ་ཉན་པར་ཕྱིན་པས།",
    "ད་ཅི་མ་ཕྱིན་ན་ཡོང་བ་ཡོད་གསུངས།",
    "སྐབས་དེར་ངོར་ཨེ་ཝྃ་ནས་རྗེ་ངོར་ཆེན་གྱིས་གཙོ་བོར་བཀའ་སྩལ་གནང་ཞིང་།",
    "དབེན་གནས་བསམ་གཏན་ཕུག་ཏུ་ཁ་གསོའི་བསྙེན་པ་ཞག་བདུན་མ་ཞིག་གནང་རྗེས།",
    "ཉེར་གསུམ་ནས་གནམ་གང་བར་ལ་ཚུལ་བཞིན་སྒྲུབ་པར་མཛད་པས།",
    "མགོན་པོའི་ཞལ་འབག་ཤིན་ཏུ་གཉན་པ་ཞིག་བཟོ་བ་གནང་ཞིང་།",
    "འབྲུག་ལོ་རྗེ་ཉིད་ཀྱི་ཡུམ་བདེ་བར་གཤེགས་པ་ལ་དགོངས་རྫོགས་ཀྱི་རིམ་པ་ཆོ་ག་ལམ་སྟོན་སོགས་རྒྱ་ཆེར་གནང་བས།",
    "ཕ་མ་གཉིས་ཀྱིས་མི་ལུས་གཙང་མ་ཐོབ་གསུངས་དགྱེས་དགྱེས་གནང་ཞེས་གྲགས་སོ།",
    "སླར་ཡང་ཤར་ཕྱོགས་ལ་ཕེབས་སྐབས།",
    "ལྷ་སར་ཇོ་མཇལ་དང་།",
    "སླར་གཙང་ཕྱོགས་ལ་ཕེབས་པའི་སྒྲོ་དབྱེར་གསོལ་རན་ནས།",
    "ཕྱག་གཡོག་པ་རྣམས་ཀྱིས་བཞུགས་གྲབས་བྱས་པས་ད་ལྟ་རང་འགྲོ་གསུངས།",
    "མྱུར་ཐབས་ཕེབས་པ་གནང་བས།",
    "སྤྲེལ་ལོ་དབྱར་སོས་གཙང་ལ་ཕེབས་དུས།",
    "གླིང་ཁར་ཕེབས་ནས་བཞུགས་སྐབས།",
    "ཨེ་ཝྃ་ནས་རྗེ་ངོར་ཆེན་གྱི་བཀའ་ཤོག་ནན་བསྐྱེད་ཕེབས་ཏེ།",
    "དེའི་ཉིན་ནས་ཚོགས་ལ་ལམ་འབྲས་གསུངས།",
    "སྒྲུབ་མཆོད་གྲོལ་འཕྲལ་ཡར་ལ་ཆིབས་ཁ་བསྒྱུར་ཏེ་གླིང་ཁར་ཕེབས་ནས་ལམ་འབྲས་ཚར་གཅིག་གསུངས་འཕྲལ།",
    "སྟོན་ཡ་མ་བདེ་ལྡན་ཕུག་ཏུ་ཐུབ་པའི་ལུགས་སྐུ་རྒྱབ་མཐོ་བཞི་པ་ཞིག་བཞེངས་པ་གནང་བའི་རབ་གནས་ནུབ་མནལ་ལམ་དུ་རྗེ་སེམས་དཔའ་ཆེན་པོ་དང་མཇལ་བའི་དགེ་མཚན་ཁྱད་པར་ཅན་བྱུང་ཞིང་།",
    "ལོ་དེའི་ཟླ་བ་བཅུ་པ་ལ་ངོར་དུ་ཕེབས་ནས་ཡབ་སྲས་ཞལ་རྒྱས་པའི་མཉེས་ཚོར་དཔག་ཏུ་མེད་པའི་ངང་ནས།",
    "སླར་ཨེ་ཝྃ་དུ་ལོ་དེ་ཉིད་ཀྱི་ཟླ་བ་བརྒྱད་པའི་ཉེར་ལྔ་ལ་ཕེབས་ནས།",
    "ཟླ་བ་དགུ་པའི་ས་མཆོད་ལ་ངོར་དུ་ཕེབས།",
    "དེ་ནས་ཡར་ཕྱོགས་ལ་ཆིབས་ཁ་བསྒྱུར་བ་གནང་ནས་མཇད་དུ་ཕེབས་སྐབས།",
    "དེ་ལྟར་ན་མུས་རང་ལ་འབྱོན་པ་འཐད་གསུངས་དཔོན་སློབ་ལྷན་དུ་གླིང་ཁར་ཕེབས་ཏེ།",
    "དེར་ཞག་འགའ་ཡར་གཏོར་འབུལ་བརྒྱ་རྩ་ཆེར་གཏད་གནང་ནས།",
    "ས་གའི་ཚེས་གསུམ་གྱི་འགྲུབ་སྦྱོར་སྟེང་དུ་རྗེ་ལྷ་མཆོག་སེང་གེ་པ་སྐུའི་རྒྱལ་ཚབ་ཏུ་མངའ་གསོལ་གནང་བའི།",
    "ཟླ་བ་གཅིག་ལས་མ་བཞུགས་པའི་བསྐྱར་ལོག་དགོས་པ་འདི་བྱུང་།",
    "ཟླ་བ་ལྔ་པ་ལ་གླིང་ཁར་ཕེབས་ནས་ཨེན་ཙམ་བཞུགས་རྗེས།",
    "ཟླ་བ་དྲུག་པའི་ཚེས་དྲུག་ལ་མཇད་མཐོང་སྨོན་དུ་བྱང་པ་བདག་པོ་ཡབ་སྲས་ཀྱིས་སྤྱན་འདྲེན་ཞུ་བ་གནང་།",
    "ཚེས་བཅུ་གསུམ་ལ་ཆིབས་ཁ་བསྒྱུར་བའི་བཅུ་གཅིག་སྔ་ཕྱེད་ཙམ་ལ་གླིང་ཁར་ཕེབས་མཚམས་གསོལ་ཇ་ཞིག་གྲོལ་རྗེས།",
    "ཟླ་བ་དགུ་པའི་ས་མཆོད་ལ་ཐོག་ཕུབ་ཀྱི་དགའ་སྟོན་རྒྱ་ཆེར་གནང་།",
    "སེམས་དཔའ་ཆེན་པོའི་སྐུ་རྐང་གང་པ་གཅིག་རྣམས་སྒྲུབ་པར་མཛད།",
    "གནང་ནུབ་རང་མགུལ་སྔར་མལ་དུ་སོར་ཆུད་ཅིང་།",
    "གསུང་ངག་ལེགས་པར་གྲོལ་རྗེས།",
    "རྒྱུ་དངོས་པོའི་གནང་སྦྱིན་སྟོབས་ཆེ་བ་གནང་ནས་ཀྱེ་རྡོ་རྗེའི་སྒྲུབ་མཆོད་ཀྱི་རྒྱུན་ཡང་གསར་འཛུགས་མཛད།",
    "འདི་སྐབས་བདག་ཆེན་ཤར་ནས་མཇལ་བ་ལ་ཕེབས་དུས།",
    "བླ་བྲང་ཤར་ན་ཡོད་པའི་རྗེ་བཙུན་གྲགས་པའི་སྟོང་རྡོའི་ལྷག་མ་ལུས་པ་འབུལ་ལགས་ཞུ་བ་གནང་བ་ལ།",
    "ས་གའི་ཉེར་བདུན་ལ་གླིང་ཁར་ཕེབས་པ་ལས་མ་བྱུང་བས་དུས་འགྱངས་ཤིང་།",
    "རོང་ཆབ་ཚན་ལ་བཞུགས་དུས་ས་གའི་གནམ་གང་ལ་སླེབ་པ་ཙམ་ལས་ཞབས་དྲུང་དུ་མ་འབྱོར་བ་ནས།",
    "སྨིན་དྲུག་ཟླ་བ་གཉིས་བྱུང་བའི་དང་པོའི་ཚེས་བརྒྱད་ལ་གླིང་ཁ་ནས་བསམ་གཏན་ཕུག་ཏུ་ཕེབས་ཏེ་བསྙེན་པ་ཁ་གསོའི་ཐུགས་དམ་གནང་རྗེས་ཉེར་གསུམ་གྱི་གསོལ་ཐོན་འཕྲལ་ལ།",
    "ཁྱད་པར་གྱི་ལྟས་ངོ་མཚར་བ་སྔར་དང་མཚུངས་པ་ལ།",
    "ས་ལ་འབབ་མི་ཐུབ་པར་ནམ་མཁའ་ལ་ཡལ་འགྲོ་བ་རྣམས་གཟུགས་ཁམས་པའི་ལྷའི་མེ་ཏོག་ཡིན་པར་བྱེད།",
    "ཁྱད་པར་བདག་ཆེན་ཏའི་བསྭེ་ཏུ་ནམ་མཁའ་ལེགས་པས་ནན་བསྐྱེད་གསོལ་བ་བཏབ་ནས།",
    "བཞུགས་པ་སྟེང་ནང་སོར་གནང་ནས།",
    "ལྷག་ཀྱང་ནས་ཕུལ་དགུ་ཙམ་བྱུང་བས་ཀུན་ཡ་མཚན་གྱི་གནས་སུ་གྱུར་པའི་གྲུབ་རྟགས་གནང་ཞེས་ཐོས་ཤིང་།",
    "ཀྱེ་རྡོར་མངོན་རྟོགས་ཡན་ལག་དྲུག་པ་མུས་ཆེན་གྱིས་མཛད་པའི་བར་ཡང་བཞེངས་ནས་པར་ཁང་དུ་བཞུགས་སུ་གསོལ་ཞིང་།",
    "གསུང་ངག་གྲོལ་རྗེས་མུས་སུ་ཕེབས་ནས་ས་ལོ་ཐམས་ཅད་མཁྱེན་པའི་ཞལ་སྔ་ནས།",
    "བསམ་གཏན་ཕུག་ཏུ་ལོ་སྒྲུབ་གནང་བའི་སྐུ་ཆས་ཐམས་ཅད་ཕྱག་ནས་གནང་སྟེ།",
    "ཀ་དྲུག་མར་བཞེངས་པ་གནང་ནས།",
    "ཡབ་བཀའ་ཡུམ་བཀའ་ཟུང་འབྲེལ་དུ་ཚོགས་པ་ཡོངས་ཀྱིས་ཐོབ་པར་མཛད་ཅིང་།",
    "གསུང་ངག་གྲོལ་རྗེས་སྟོན་ཡར་ཕེབས་ནས།",
    "ནས་ཁལ་བརྒྱ་དང་བརྒྱད་ཅུ་བཙུགས་པ་གནང་རྗེས།",
    "དབྱར་ཡ་མ་བདེ་ལྡན་ཕུག་ཏུ་བདག་ཆེན་ཀུན་དགའ་བཀྲ་ཤིས་སྐུ་མཆེད་ཀྱིས་གཙོ་མཛད་ལ་གསུང་ངག་གནང་སྐབས།",
    "དངུལ་གར་ལུགས་གནང་བའི་ས་ཆེན་གྱི་སྐུ་དང་།",
    "ཀུན་མཁྱེན་དང་གྲུབ་ཆེན་གྱི་སྐུ་སྔར་གྱི་སེམས་དཔའ་ཆེན་པོའི་དངུལ་སྐུ་དང་མཉམ་པ།",
    "གང་ལ་གང་འོས་དགེ་ཕྱོགས་སུ་ཐོང་པའི་ཕྱག་ལེན་གནང་ཞིང་།",
    "རྗེ་ཉིད་ཀྱིས་འོད་བཞུ་གནང་རྗེས།",
    "ཐུབ་བསྟན་རྣམ་རྒྱལ་ནས་སྤྱན་འདྲེན་ཞུ་མི་དང་ལྷན་ཅིག་གཙང་གཞུང་ལ་ཕེབས་ལམ་བསྒྱུར་ཏེ།",
    "སྒྲུབ་མཆོད་རྒྱུན་གཏན་བཙུགས་པ་ལ་ཆ་རྐྱེན་དཔག་མེད་སྦྱོར་བ་གནང་ནས།",
    "ཐུབ་བསྟན་ཡངས་པ་ཅན་དུ་ཞག་འགའ་སྐུ་བསྙེལ་གནང་དུས།",
    "འདི་སྐབས་ངོར་དུ་མུས་ཆེན་གྱི་ཚེས་བརྒྱད་དུས་ཆེན་ལ་དམིགས་པའི་གསེར་ཞོ་བཞི་བཅུ་སྦྱོར་བ་གནང་ནས།",
    "གླིང་ཁར་ཕེབས་པའི་མཚམས་ལྷོ་རྩའི་ཇོ་བོའི་དྲུང་དུ་དཀར་མེའི་རྒྱུན་དང་།",
    "གཅོད་ཁྲིད་རྣམས་གསུངས།",
    "ཕྱི་རྟེན་གདུང་ཚ་བཞུགས་པའི་ཁང་བརྩེགས།",
    "ཡ་མ་བདེ་ལྡན་ཕུག་པ་ལ་ཆོ་འཕྲུལ་ཟླ་བ་ལ་རྒྱུད་ཚུགས་གསུངས།",
    "ཇ་སྡུམ་གཅིག་རྣམས་གནང་ཞིང་།",
    "པུ་ཏྲ་ནང་སོ་སོགས་སུ་གཏོར་གསོས་ཧོར་བཟློག་ལ་དམིགས་པ་ཡང་སྒྲུབ་པ་གནང་ཞིང་།",
    "གླིང་དབོན་ཏིང་ངེ་འཛིན་འོད་ཟེར་བས་གཙོ་མཛད་ལ་གསུང་ངག་གནང་སྐབས།",
    "རྗེས་གནང་རིགས་གཏད།",
    "ས་ལོ་ཐམས་ཅད་མཁྱེན་པའི་ཞལ་སྔ་ནས།",
    "ཀརྨ་འཕྲིན་ལས་པར་གྲགས་པ་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་ལྷ།",
    "ཏིང་འཛིན་འོད་ཟེར་ལ་སོགས་ཏེ་དབུས་གཙང་ཁམས་གསུམ་གྱི་བསྟན་འཛིན་དངོས་སུ་མཚན་སྨོས་པ་དེ་དག་དང་།",
    "སྤྲེལ་ལོ་ཤར་འཕྲལ་གསང་སྔགས་རྡོ་རྗེ་གླིང་དུ་སང་ཕོད་བྱ་ལོ་ཆོ་འཕྲུལ་མན་རྒྱུད་ཚུགས་གསུངས་གསེར་ཞོ་ཉི་ཤུ་དང་།",
    "ནས་ཁལ་བརྒྱའི་གནང་སྦྱིན་མཛད་ཅིང་།",
    "མ་ཎིའི་ལུང་གནང་རྗེས།",
    "བྱ་བཏང་རྗེའི་ན་བཟས་གཙོས་པའི་གྲལ་འགྱེད་རྒྱ་ཆེར་གནང་ནས་བསྔོ་བའི་རྒྱས་འདེབས་དང་།",
    "སྔར་གྱི་རྒྱུད་སྒྲིགས་འདོན་གྱི་འཐུད་དུ་གསེར་སྲང་དོ་གནང་།",
    "སོ་སོར་གྱེས་གསུངས་པའི་བཀའ་ལུང་གནང་རྗེས་སྐུ་མཚམས་སེའི་ངང་ནས།",
    "སེམས་དཔའ་ཆེན་པོའི་དགུང་ལོ་ཙམ་བཞུགས་དགོས་ཞེས་གསོལ་བ་བཏབ་པས།",
    "འོན་ཀྱང་ལས་བསགས་པ་མེད་གསུངས།",
    "གསོལ་དཔོན་རྣམ་གཉིས་ཀྱིས་གླིང་ཁར་ཕེབས་དགོས་པའི་ནན་བསྐྱེད་ཞུས་པ་ལ།",
    "ཚེས་ནས་བདེ་བ་ཅན་དུ་འགྲོ་བཀའ་ལུང་ཕེབས་པ་ལ།",
    "ཁོང་རྣམས་བསམ་གླིང་ཁ་བདེ་བ་ཅན་དུ་ཕེབས་གསུངས་པར་གོ་ནའང་།",
    "ཚེས་གསུམ་གྱི་སྔ་དྲོའི་ཆ་ལ་གླིང་ཁར་ཕེབས་ཤིང་།",
    "ཞབས་སྐོར་ཡང་མ་ཆག་པར་གནང་།",
    "པུར་ཟླ་བ་གཅིག་མ་ཞུ་བར་བཞོག་གསུངས་ཤིང་།",
    "ཚ་ཚ་རབ་གནས་ཀྱི་བར་གནང་ནས།",
    "ཕྱག་གཉིས་ནམ་མཁའ་མཛོད་ཀྱི་ཕྱག་རྒྱ་དབུ་དཔྲལ་དུ་འཇོག་པ་གནང་ནས།",
    "སེམས་དཔའ་ཆེན་པོ་ཡབ་སྲས་རྣམས་གང་དུ་བཞུགས་པའི་ཞིང་ཁམས་དེར།",
    "སྤྲིན་ཐོར་པ་བྱུང་བ་རྣམས་ཀྱང་འཇའ་ཚོན་གྱི་རྣམ་པར་འཆར་བ་དང་།",
    "དགོང་ཕྱོགས་བདག་ཆེན་སྐུ་མཆེད་ཀྱིས་ཚོགས་དབུ་གནང་ནས་ཀྱེ་རྡོར་གྱི་སྒྲུབ་མཆོད་དང་།",
