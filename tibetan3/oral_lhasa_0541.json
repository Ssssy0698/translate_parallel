    "རྣམ་པར་དབྱེ་བའང་ཅུང་ཟད་བསྟན།",
    "བར་ཚེག་མི་བྱེད་བླུན་པོའི་ས་ཚ་བ་ཀའི་མེས་པར་༢༧ ནས་ཚེས་སབ་ཏོ།",
    "ཁ་ཆེའི་ཡི་གེ་ལ་དཔེར་མཛད་ནས་ལྷ་སའི་སྐུ་མཁར་མ་རུ་བྱ་བར་རྗེ་བློན་མཚམས་བཅད་ནས་བརྩམས་པར་གྲགས་ལཱཉྩའི་ཡི་གེ་དཔེར་མཛད་ནས།",
    "དོན་ཡང་ལེགས་པར་གཏན་ལ་ཕབ།",
    "དོན་འདི་ལེགས་པར་བཀོད་པ་ཉིད།",
    "ལེགས་པར་སྦྱར་བའི་སྐད་ཀྱི་བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་དག་ཐོས་ཞིང་ཆ་༩འ་ཨཱཝ་ཝ་མ་ས་ཤས་ཙམ་རིག་ལ།",
    "སླར་ཡང་ཡར་སྟོད་རབ་བརྟན་ལྷུན་པོ་སྒང་དུ་པར་དུ་བཞེངས་པའི་ཚེ།",
    "དགའ་ལྡན་ཕུན་ཚོགས་གླིང་དུ་པར་དུ་བསྒྲུབས་པའོ།",
    "བཀས་པར་བཀའ་མཆིས་བཀའ་བློ་བདེ་བ་དང་།",
    "གནང་བཀག་ཤེས་ནས་བསྙེན་བཀུར་ལག་པས་བཀན།",
    "མདངས་བཀྲ་མགོ་དཀར་བྱས་ཤིང་བློ་རྒྱ་བསྐྱེད།",
    "སྒྲིབ་སེལ་སྒྲོས་གཙང་སྒྱུ་འཕྲུལ་སྒྱུ་རྩལ་སྒྱུར།",
    "རྒྱུ་རྐྱེན་མེད་པར་རྒྱོབ་ཅེས་བརྒྱུད་བཀག་སྨྲ།",
    "མཉམ་པར་འཇོག་དང་འཇོ་སྒེག་འས་འཕུལ་བཞེད།",
    "རྗེ་དཔོན་རྗེབ་འདབ་རྗེན་པར་བཟས་པས་རྫུད།",
    "གཏི་མུག་གཏིང་མཐོང་གཏན་ཚིགས་གཏན་ལ་ཕེབས།",
    "བྱ་བཏང་སྦྱིན་པར་བཏང་སྦྱིན་པར་བཏང་སོགས་བས་འཕུལ་བཞེད།",
    "སྟེགས་པའི་སྟེགས་བུས་སྟག་ཁྲོས་སྟོང་པར་སྒོམ།",
    "བསྟི་བསྟང་བསྟི་གནས་བསྟིང་ཚིག་མིན་པར་བསྟོད།",
    "འདུས་བྱས་འདུ་ཤེས་འོས་འདོམ་གང་འདུན་དུ་ཡང་།",
    "མར་མེའི་སྡོང་བུའང་ས་མགོར་བཞེད་པ་ལགས།",
    "པུས་བཙུགས་པཎྜི་ཏ་དང་པར་གཏང་གཏིང་།",
    "ཕྱི་རབས་སྲེན་ཕྱེའང་རྐྱང་པར་བཞེད་ཕྱག།",
    "མགོ་སྨྱུ་སྣ་ཕབ་སྨེག་མེ་སྤྱན་ཀ་བྱས།",
    "བཞེངས་བཞུགས་དཀའ་ཡང་མར་བཞུས་བཞོན་པ་བཤོ།",
    "ཁུར་བཞེས་བཞིན་བཟང་ཇ་བཞུར་བཞིབ་པར་འོས།",
    "གཟེངས་བསྟོད་གཟི་མདངས་ཕྲག་པར་གཟར་ཞིང་གཟོད།",
    "ཇི་སྲིད་རྒྱལ་སྲས་འོད་སྲུང་བཞུགས་དེ་སྲིད།",
    "སྲེའུ་སྲིད་ཀྱང་སྲི་ཞུ་བྱས་པས་སྲུན།",
    "བཞག་གནས་སུ་ཟིན་བྱད་བཞིན་མར་བཞུ་བཞུགས་སྟན་ལ།",
    "བཞུན་པོ་ནོར་དང་གཡོག་འབྱོན་བཞུད་བཞེངས་ནས་བཞེས་ཟས།",
    "འཕྲོ་བསྒྱུར་གཅོམ་ཁ་རོག་པར་བསྐུངས་བྱ་བ་བསྐུངས་བཞགས་པའི་དོན།",
    "བཟབས་པའི་བསྟར་ལ་སོགས་པའོ། ཉེས་བསྡམས་བསྡུ་བྱ་བསྡུ་ཕྱིར་བསྡད་སྟན་ལ།",
    "ས་བརྐོ་བརྐོས་དང་སྲ་བརྐྱང་ཡན་ལགས་སོགས་བརྐྱངས། བརྒལ་ལན་བརྒྱ་ཕྲག་བརྒྱད་ཅུ་བརྒྱད།",
    "བརྩོན་འགྲུས་བརྩམས་པ་ལེགས་པར་བགྲང་བྱ་བརྩིས། རྡོག་བརྫིས་མི་བརྫི་བརྫུན་ཚིག་ནོར་གྱི་བརྫངས།",
    "གས་འཕུལ་བཅུ་གཅིག་ཏུ་བཞེས་དཔེར།",
    "གཙིགས་ཆེན་ཡུལ་གཙང་པའི་གཙོ་བ་སོགས། རྣམ་གཞག་ཉེར་གཞག་མཉམ་གཞག་ནམ་གཞུག་བྱེད་གཞུག།",
    "བསྟེག་པར་གཟས་པ་སྟེ།",
    "བརས་པར་འབ་ན་ཟླ་མཚམས་པའི་དོན།",
    "གཉེས་གཤིན་གཤིབ་ལུགས་བཤགས་བུས་པའི་སྨོད་གཞུང་བ།",
    "བདེ་གཤེགས་དེ་ནི་གཤེགས་སོགས་སོ།་ གྲངས་ཀྱི་གཉིས་མེད་གསུང་བས་གསང་སྔགས་གསུངས།",
    "བཀས་བསགས་པས་ས་ལྷ་མའི་མིས་བྱས་ན་མིང་ལས་རིགས་མང་ཡང་ཕྱིར་བ་པའིསི་སས་སསསཔསས་བློ་འཚབས་ཆུ་འཚག་ནང་དུ་འཚངས།",
    "འཛེར་པར་འཛར་ནས་གྱེན་དུ་འཛེག།",
    "རྟིང་པར་རྟག་མགོས་རྣམ་རྟོག་དང་།",
    "རྡོ་བ་རྡོ་རྗེ་ལ་སོགས་སོ། རྣག་རུལ་བའི་དང་རྣམ་པར་རྣམ་པ་རྣམས།",
    "སྒོམ་བྱེད་ལྷ་སྒོམས་ཟས་སྒོངས་ཤིག།",
    "སྒྲུང་གཏམ་སྒྲུབ་ཐབས་ལྷ་སྒྲུབས་ཤིག།",
    "རྩལ་སྟོབས་མི་གཙང་བ་འབབ་སའི་སྟོར་ཁུང་བོར་སྟོར་སོགས། ཞེ་སྡང་དགེ་སྡིག་སྡིག་ཡབཅས་པ་༡ བ་ཁ་༡༤ ༤༡༡ཀ་༡ མ་༥ཀ་ཥ་ཥ་མཛུབ་སྡིགས་སྐུལ་ཚིག་ཡིན་པས་སྔོན་འཇུག་མེད།",
    "སྦྱངས་པ་སྦྱངས་དང་ལེགས་པར་སྦྱར།",
    "གཙང་སྦྲ་གྲོགས་སྦྲན་ས་ལེ་སྦྲམ།",
    "ད་དྲག་ངེས་པར་ཐོབ་པ་དེར།",
    "མཁྱེན་ཅིང་ཟེར་ཅེས་མྱུར་སྩོལ་ཅིག།",
    "ལེགས་པར་བཀོད་པ་དེ་ལས་སླར་ཡང་ལེགས་བཏུས་རིན་ཆེན་ཟ་མ་ཏོག།",
    "རྣམ་རྟོག་བཅོམ་ནས་རྣམ་མཁྱེན་གྱི།",
    "གནང་བཀག་སྣོད་བཀང་གོས་སོགས་བཀྲ་ཤིས་རྣམ་བཀྲ་བཀྲག་མདངས་ཅན།",
    "ཐམས་ཅད་མཁྱེན་ཅེས་བསྔགས་པ་མ་འཁྲུལ་བར།",
    "མཁྱེན་པ་སྲ་མཁྲེགས་མཁོ་བའི་ནོར།",
    "ལྷ་རིསབཞེས་ནས་དིནིཔརཔབསྙེན་དང་།",
    "བྱས་པའི་བགྱིས་དང་གྲོངས་ཀྱི་བགྲང་།",
    "དོན་སྒྲུབ་སྒྲུབ་ཐབས་ལྷ་སྒྲུབསཤིག།",
    "མུ་ཏིག་ཏིང་ཤགས་ཏ་ལ་ཏིལ།",
    "ཏ་རྐྱང་ཡིན་པར་ཤེས་པར་བྱ། སྦྱིན་གཏོང་གཏོར་མ་མེ་ཏོག་གཏོར།",
    "རྐང་པའི་རྟིང་པ་མི་གཙང་ཟུག།",
    "གདན་བཞུགས་འབྲུ་གདབ་གདམ་ང་འདམ་ཀ་བྱེད་ཟེར་བྱེད།",
    "སྟན་ལ་བསྡད་དང་ཉེས་པ་བསྡམས།",
    "གནས་ངན་ལེན་དང་གནོད་གཅོད་པ་ སངས་གནང་གནས་བརྟན་གས་འཕུལ་ལོ།",
    "སྣང་བ་མཐོང་སྣང་མི་གཙང་སྣབས།",
    "པ་སངས་པང་པ་པར་བུ་དང་།",
    "གཙང་སྦྲ་སྦྲང་མ་ས་ལེ་སྦྲམ།",
    "ངུར་སྨིག་མགོ་སྨྱུང་གཙང་སྨེ་དང་།",
    "མ་མགོ་ས་ཡིས་བརྒྱན་པར་བྱ།",
    "གཙང་སྦྲ་གཙང་ཁང་ཆུ་གཙང་མ་ མཆེ་གཙིགས་གཙུག་ལག་གཙེར་བས་གཙེས།",
    "ར་མགོ་ལྡན་པའི་ཙ་ཡིག་ལགས། བརྩད་ཅིང་བརྒལ་ནས་བརྩམ་བྱ་བརྩམས།",
    "བགྲང་བའི་བརྩི་དང་ལེགས་པར་བརྩིས།",
    "མཚོན་ཆ་རྒྱལ་མཚན་བྱས་པས་མཚེངས།",
    "འཚོ་གཞེས་གཞོགས་སློང་དུས་གཞེས་གནངས།",
    "བཞུན་པོ་འབྱོན་བཞུད་བཞུགས་ནས་བཞེངས།",
    "དགོངས་བཞེད་ཟས་བཞེས་འོ་མ་བཞོ།",
    "གསོལ་བཞི་ཁུར་བཞེས་ཁུ་བ་བཞུར།",
    "གཟར་བུ་གཟར་ཐག་ཕྲག་པར་གཟར།",
    "རི་སུལ་དབེན་པར་ས་ལོ་སྤྲེའུའི་ལོ་རང་ལོ་སོ་བརྒྱད་པ།",
