    "དེ་ཐིམ་པས་རྐྱེན་བྱས་ནས་རང་གི་ལུས་སེམས་ལ་དགའ་བདེ་སྐྱེས་པའི་མོས་པ་བྱ།",
    "གཞི་ནས་བསྐྱར་དུ་ང་ཚོའི་བློ་ལ་ཅི་འདྲ་ཞིག་འཆར་གྱི་འདུག་བསམ་བློ་བཏང་བ་ན།",
    "བློ་དགའ་ལྷང་ལྷང་ཞིག་བསམ་ནས་དེ་བདེ་བ་ཆེན་པོའི་མོས་པར་བསྐྱེད་པ་དང་།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་ཞལ་གཅིག་ཕྱག་གཉིས་པ་ཞིག་ལ་ལྷང་གིས་བསྐྱེད་ནས།",
    "མ་དག་པའི་སྣོད་བཅུད་འདི་ཐམས་ཅད་འོད་གསལ་གྱིས་བྱིན་གྱིས་བརླབས་ནས་དག་པ་རབ་འབྱམས་འབའ་ཞིག་ཏུ་གྱུར་སོང་སྙམ།",
    "ང་ལ་ཆ་བཞག་ན་ཞོགས་པ་རྟག་པར་གཉིད་སད་པ་དང་སྐབས་རེར།",
    "གང་གི་ཐུགས་བརྩེས་ཉེར་བཟུང་ནས།",
    "བཞད་མོ་བཞད།",
    "བདག་ཀྱང་དེ་དག་གི་རྗེས་སུ་འབྲངས་པའམ་བསླབས་ནས་དལ་བ་ཐོབ་པ་དོན་དང་ལྡན་པ་ཞིག་ཅིས་ཀྱང་བྱ་སྙམ་པ་དང་།",
    "བདག་ཉིད་གསང་བདེ་འཇིགས་གསུམ་སོགས་ལྷག་པའི་ལྷ་གང་རུང་གི་རྣལ་འབྱོར་དང་ལྡན་པའི་སྐུ་ལས་འོད་ཟེར་འཕྲོས།",
    "བཅུད་ཐམས་ཅད་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་གྱི་དག་པ་རབ་འབྱམས་འབའ་ཞིག་ཏུ་བསམ།",
    "གང་གི་ཐུགས་རྗེ་བདེ་བ་ཆེན་པོའི་དབྱིངས།",
    "སྐྱབས་ཡུལ་གསལ་བཏབ་ཚར་བའི་རྗེས་ལ་སྐྱབས་སུ་འགྲོ་བ་དང་བདུད་རྩི་འབེབས་སྦྱང་གི་དམིགས་པ་བྱས་ནས།",
    "འདི་དག་གི་དོན་ཞིག་བྱེད་ཐུབ་ན་བསམ་པའི་བློ་བསྐྱེད་པ་དང་།",
    "སྐབས་འདིར་རང་གི་སེམས་ལ་རྦད་དེ་འགུལ་བསྐྱོད་མ་ཐོན་བར་དུ་སེམས་བསྐྱེད་འབྲས་བུ་ལམ་བྱེད་ཀྱི་དམིགས་པ་བྱེད་པའམ།",
    "རྣམ་མཁྱེན་དོན་གཉེར་གྱི་སེམས་དུ་རེ་བ་ཞིག་བསྐྱེད་པའི་མཚམས་སུ།",
    "གཞན་དོན་འབད་མེད་ལྷུན་འགྲུབ་བྱེད་ཐུབ་པ་ཞིག་བདག་གིས་བྱ་རྒྱུ་ཡིན་བསམ་ནས་སེམས་ལ་དམ་བཅའ་འཇོག་པ་དང་།",
    "རང་གི་ལུས་ལས་འོད་ཟེར་གྱི་ཚོགས་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ།",
    "དེ་ནས་རང་གི་ཐུགས་ཀ་ནས་རྡོ་རྗེ་སློབ་དཔོན་དཔག་ཏུ་མེད་པའི་ཚོགས་སྤྲོས་ཏེ།",
    "དང་གང་གིས་མནར་ནས་ཡོད་པའི་རིགས་དྲུག་དེ་དང་དེའི་སྡུག་བསྔལ་བསལ་ནས།",
    "གནས་པར་བདག་གིས་བྱའོ།",
    "མཚམས་རེར་དེ་ལ་སྐྱོན་ཞིག་ཀྱང་འདུག་སྟེ།",
    "རྒྱ་ཐུབ་ན་ཡག་པོ་རེད་སྙམ་པ་དང་།",
    "དེ་ལས་ཀྱང་ལོ་གསུམ་ལ་འཚང་རྒྱ་ཐུབ་ན་འདི་ང་ལ་དགོས་པའི་གདམས་པ་རེད་དྲན་ཏེ།",
    "འདི་ལྟ་བུ་སུས་ནུས་སྙམ་དུ་ཡིད་རྦད་དེ་ཞུམ་ནས་ཕྱིར་ཤིག་བརྒྱབས་ཡོང་གི་རེད་གསུངས་པ་ཧ་ཅང་བདེན་པ་རེད།",
    "ང་ལ་མཚོན་ན་མྱུར་བ་མྱུར་བར་ཞེས་པ་ལས་གྲངས་མེད་གསུམ་ཟེར་བ་དེ་ཕན་ཐོགས་ཆེ་བ་འདུག་ཕན་ཐོགས་སྡུག་ས་ནས་ཡོང་གི་ཡོད་དམ་ཅི་ཡིན་མི་ཤེས།",
    "བསྐལ་བ་གཅིག་དང་བསྐལ་བ་གཉིས་ཞེས་པ་ཧ་ཅང་དུས་ཐུང་ཐུང་རེད་སྙམ་ནས་སེམས་གཏིང་ནས་འཕྲལ་མར་བློ་ཁོག་བསླེབ་ཡོང་བ་དེ་གལ་ཆེན་པོ་རེད།",
    "ལོ་ཁ་ཤས་ཀྱི་ནང་ལ་དག་པ་དང་མ་དག་པའི་སྒྱུ་ལུས་མངོན་དུ་བྱས་ནས་ཟུང་འཇུག་གི་གོ་འཕང་ཐོབ་ཐུབ་པའི་ཟབ་ཁྱད་ཡོད་ཅེས་གསུངས་པ་ཡིན།",
    "ཁྱད་པར་གྱི་སྔོན་འགྲོཁྱད་པར་གྱི་སྔོན་འགྲོ་ལ་ད་ལྟའི་རྩ་ཚིག་གི་ནང་ལ།",
    "བདག་ཉིད་གསང་བདེ་འཇིགས་གསུམ་སོགས་ལྷག་པའི་ལྷ་གང་རུང་གི་རྣལ་འབྱོར་དང་ལྡན་པའི་སྐུ་ལས་འོད་ཟེར་འཕྲོས།",
    "སྣོད་ཐམས་ཅད་གཞལ་ཡས་ཁང་དང་བཅུད་ཐམས་ཅད་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་གྱི་དག་པ་རབ་འབྱམས་འབའ་ཞིག་ཏུ་བསམ།",
    "དེ་ཅི་འདྲ་ཞིག་རེད་ཅེས་བརྗོད་ན།",
    "དེའི་ཟབ་ཁྱད་ཐུན་མོང་མ་ཡིན་པ་ནི་ཕྱི་ནང་གི་འགལ་རྐྱེན་སེལ་རྒྱུ་དང་།",
    "འཇིགས་བྱེད་སྔོན་འགྲོའི་ཚུལ་དུ་བྱས་ནས་ཕྱི་ནང་གི་མི་མཐུན་ཕྱོགས་སེལ་ཏེ་བར་ཆད་ཀྱིས་མི་ཚུགས་པར་བྱེད་པ།",
    "བྱུང་ན་གསང་བ་འདུས་པའི་རྣལ་འབྱོར་གྱིས་སྐུ་གསུམ་ལམ་འཁྱེར་ཨ་མ་ལྟར་གཙོ་བོར་བཟུང་བའི་ཐོག་ནས་ཟབ་ཁྱད་འདོན་པ་དང་།",
    "ནམ་རྒྱུན་ནས་སོ་སོའི་གནས་བཞི་པོ་དེར་སྔགས་འཁོར་འགོད་པའི་ཐོག་ཀ་རེ་ཀོ་རེ་བྱེད་རྒྱུ་གོམས་ཡོད།",
    "བདག་ཉིད་གསང་བདེ་འཇིགས་གསུམ་སོགས་ལྷག་པའི་ལྷ་གང་རུང་གི་རྣལ་འབྱོར་དང་ལྡན་པའི།",
    "ཁྱད་པར་གྱི་སེམས་བསྐྱེད་པ་དེ་དག་བསྒོམ་ཟིན་པའི་རྗེས་ལ་སྐྱབས་ཡུལ་རང་ལ་མར་ཐིམ་པའི་མོས་པ་བྱས་ཏེ།",
    "ལྷག་པར་དུ་སེམས་གཏིང་ནས་དགའ་བདེ་ཁྱད་པར་ཅན་སྐྱེས་སོང་བསམ་པ་ཞིག་ཡོང་བ་དང་།",
    "ས་ཆུ་ལ་ཐིམ་པའི་རྟགས་སྨིག་རྒྱུ་ལྟ་བུའི་རྣམ་པ་ཤར་སོང་སྙམ།",
    "རང་ཡང་སྨད་སྟོད་ནས་འོད་དུ་ཞུ་ནས་ཧཱུཾ་ཡིག་ལ་ཐིམ་ནས་དུ་བ་ལྟ་བུའི་སྣང་བ་ཤར་སོང་སྙམ།",
    "དེ་ནས་ཧཱུཾ་གི་ཞབས་ཀྱུ་ཨུ་ཧ་ལ་ཐིམ་ཏེ་མཁའ་སྣང་མེ་འཁྱེར་ལྟ་བུའི་སྣང་བ་ཤར་སོང་སྙམ།",
    "དེ་ནས་ཧ་ཧའི་མགོ་བོ་ལ་ཐིམ་ནས་མར་མེ་ཏ་ལ་ལར་འབར་བ་ལྟ་བུའི་སྣང་བ་ཤར་སོང་སྙམ་སྟེ།",
    "རིམ་ལྔ་གསལ་སྒྲོན་གྱི་ནང་ལ་ཡང་དེ་ཡོད་པ་རེད།",
    "ཧཱུཾ་གི་ཞབས་ཀྱུ་ཨུ་ཧ་ལ་ཐིམ་པ་ཐིམ་པ་གསུམ་པ།",
    "རྣལ་འབྱོར་མ་ལྟ་བུ་ཡིན་ན་ནཱ་ད་འཁྱོག་གསུམ་ཅན་ཞིག་སྒོམ་དགོས་པ་དང་།",
    "འདིར་ངེས་པར་དུ་འཁྱོག་གསུམ་མ་སྒོམ་ཡང་ཁྱད་མེད།",
    "དལ་གྱིས་ནཱ་ད་འཁྱོག་མས་ནས་ཡར་རྩེ་མོའི་བར་དུ་དང་།",
    "དམིགས་རྟེན་མི་འཁྲུག་པའི་ཆེད་དུ་རྩེ་མོ་ཤིན་ཏུ་ཕྲ་མོ་ཞིག་འཇོག་ན་དེ་ལྟར་དང་།",
    "ཐམས་ཅད་སྟོང་པ་འོད་གསལ་གྱི་གནས་སྐབས་ཤར་སོང་སྙམ་པ་དང་།",
    "མོས་ངོ་ལ་སྣང་བ་ཐམས་ཅད་ལ་རྗེས་གཞིག་གི་སྡུད་རིམ་གྱི་དམིགས་པ་བྱེད་པས།",
    "མོས་ངོར་དེ་ལ་སླར་ལྡང་བ་མེད་པའི་ཚུལ་གྱིས་མཉམ་པར་བཞག་པར་བསམ་སྟེ།",
    "ཕོ་རོག་གི་ཕྲུ་གུ་སྐྱེས་པའི་སྐབས་སུ་དཀར་པོ་དང་།",
    "དེ་ཉིད་རང་གི་སྤྱི་བོར་བྱོན་པར་མ་ཟད།",
    "དགྱེས་པ་ཆེན་པོའི་སྒོ་ནས་མར་རང་ལ་ཐིམ་པའི་མོས་པ་བྱ།",
    "བདེ་སྟོང་གི་ཡེ་ཤེས་ཀྱི་མོས་པ་བསྐྱེད་པའི་ཐོག་ནས་འདིར་གསུངས་པ་རྣམས་ཀྱི་ཉམས་རྒྱས་པ་བྱེད་ན།",
    "ཧ་ཱུཾ་གི་ཞབས་ཀྱུ་ཨུ་ཧ་ལ་ཐིམ་མཁའ་སྣང་མེ་འཁྱེར་ལྟ་བུ།",
    "ཐིམ་རིམ་དེ་དག་ལ་བསམ་བློ་བཏང་ན་གང་འཚམ་ཞིག་ནས་ང་ཞེས་པ་དེ་གབ་ས་མེད་པ་ལྟ་བུ་ཆགས་ཐུབ་མོད།",
    "འོད་གསལ་དེ་བདག་རེད་དམ་ཞེ་ན།",
    "བདག་དེའི་འོད་གསལ་རེད་མ་གཏོགས་འོད་གསལ་དེ་བདག་ཏུ་བཞག་ན་བདེ་བོ་མེད།",
    "འོ་ན་སུའི་འོད་གསལ་རེད་དམ་ཞེ་ན།",
    "བདག་གི་འོད་གསལ་རེད་ཅེས་བརྗོད་དགོས་པས་བདག་ད་དུང་ཡོད་དགོས།",
    "འོད་གསལ་དེ་བདག་གིར་འཛིན་མཁན་གྱི་བདག་ཅིག་ཡོད་དགོས་ཀྱང་བདག་དེ་མཛུབ་མོ་གཟུག་ས་དང་གབ་ས་མེད་པས།",
    "མིང་རྐྱང་བཏགས་ཡོད་ཙམ་གྱི་སྟེང་ནས་བཞག་ན་མ་གཏོགས་མཛུབ་མོ་གཟུག་ས་མེད་པ་ཆགས་ཚར་བ་རེད།",
    "འཛམ་བུ་གླིང་འདིའི་སྒང་ལ་ཉོན་མོངས་ལ་སྐྱོན་དུ་མི་བལྟ་བར་དང་དུ་བླངས་ཏེ།",
    "གཞན་ལ་མཐོང་ཆུང་གཏོང་བ་སོགས་བྱེད་པའི་མི་ཞིག་ཡིན་ན་དེ་འཇོན་པོ་རེད་ཅེས་བསྟོད་བསྔགས་གཏོང་བར་མ་ཟད།",
    "དེ་དག་ནི་ཉོན་མོངས་དང་དུ་ལེན་པ་ཡིན།",
    "ད་དུང་ཁ་གཏིང་མི་མཚུངས་པའི་གཡོ་སྒྱུ་ཅན་གྱི་མི་དེ་ཡོན་ཏན་ཆེན་པོ་རེད་ཅེས་རྦད་དེ་བྱབ་ལུང་པ་གང་སྐྱེལ་གྱི་འདུག་པས།",
    "ཉོན་མོངས་ལ་སྐྱོན་དུ་བལྟས་ཏེ་སེམས་འདུལ་དགོས།",
    "ཞེས་གསུངས་པ་བཞིན་ཉོན་མོངས་དུག་གསུམ་དང་དུ་ལེན་པ་དང་།",
    "རེ་ས་གཞན་ན་མེད་པའི་བློ་ལྟོས་བཅས་ཏེ་གདུང་ཤ་གས་དྲག་པོས།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྩལ་དུ་གསོལ།",
    "དེ་ནས་ཕྱི་ནང་གི་དེ་ཉིད་བཅུ་ལ་སོགས་པ་དང་ལྡན་པའི་ཚུལ་བསམ་ནས།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྩལ་ཏུ་གསོལ།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "གངས་ཅན་མཁས་པའི་གཙུག་རྒྱན་རེད་མདའ་བ།",
    "རེད་མདའ་བས་འདི་ཁྱེད་རང་ལ་འོས་པ་འདུག་གསུངས་ནས།",
    "གངས་ཅན་མཁས་པའི་གཙུག་རྒྱན་རེད་མདའ་བ།",
    "གཞུང་ཆེན་མོར་བལྟ་བ་གསུམ་འཛོམས་བྱུང་ན་རིང་པོ་མི་ཐོགས་པར་ལྟ་བ་རྟོགས་ཐུབ་ཅེས་གསུངས་པ་ལ་བརྟེན་ནས།",
    "ཟབ་མོ་རྟེན་འབྱུང་གཏམ་གྱི་བགྲོ་བ་མཛད།",
    "བུདྡྷ་པ་ལི་ཏའི་ཕྱག་དཔེ་སྔར་ནས་ཡོད་མུས་ཡིན་ཀྱང་།",
    "དེའི་ཕྱི་ཉིན་མི་ཞིག་གིས་བུདྡྷ་པ་ལི་ཏའི་ཕྱག་དཔེ་ཞིག་ཕུལ་བ་ལྟར་གཟིགས་པ་ན།",
    "ནམ་ཞིག་རེས་འཇོག་མེད་པར་ཅིག་ཅར་དུ།",
    "ཞེས་པའི་ཉམས་མྱོང་དེ་དུས་བྱུང་བ་རེད།",
    "རེད་མདའ་བས་ཚིག་བསྒྱུར་གནང་ནས་ཕྱིར་གནང་བ་རེད།",
    "ཡང་དེའི་སྒང་ལ་སྣོན་པ་ཅུང་ཟད་རེ་བརྒྱབས་ཏེ་དམིགས་བརྩེ་བ་དགུ་སྐོར་བཟོས་པ་རེད།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "དམིགས་མེད་བརྩེ་བའི་གཏེར་ཆེན་སྤྱན་རས་གཟིགས།",
    "སྐུ་ཡིས་ཆེ་དང་གསུང་གིས་གསལ།",
    "ཧ་ཅང་ཐུན་མོང་མ་ཡིན་པ་ཞིག་ཡིན་པར་མ་ཟད།",
    "ཟུང་འཇུག་ཕྱག་རྒྱ་ཆེན་པོ་སྒོམ་མཁན་ཞིག་གིས་ལོག་རྟོག་རྣམས་འགོག་པ་ཙམ་དུ་མ་ཟད་རྣམ་རྟོག་ཕྲ་མོ་རྣམས་དང་།",
    "སློབ་དཔོན་ཀླུ་བྱང་གི་ལས་མཐའ་རྣམ་འབྱེད་དུ།",
    "སྣང་བ་རྣམ་གསུམ་མ་དག་བར་དུ་མགོ་དང་རྐང་ལག་སྦྱིན་པ་གཏོང་བ་སོགས་བསྐལ་བ་ནས་བསྐལ་བར་བསླབས་ཀྱང་ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་ཐོབ་མི་ནུས་མོད།",
    "གཉིས་མེད་ཐུན་མོང་མ་ཡིན་ཁྱབ་པའི་སྐུ།",
    "དེ་མེད་པ་ངས་ཀྱང་ཤེས་ཟེར་བའམ་དེ་མ་རེད་ཅེས་ཐག་གཅོད་པ་དེར་ཤེས་རབ་འཆལ་བ་ཟེར།",
    "ལ་ཁའི་གོང་གི་ཙནྜྲ་ལི།",
    "སྐུ་ཡིས་ཆེ་དང་གསུང་གིས་གསལ།",
    "འོད་དང་བདུད་རྩིའི་རྡུལ་ཕྲ་རབ་རེ་རེ་ནས་ཀྱང་ཨ་ལི་ཀཱ་ལི་དང་།",
    "འོད་དང་བདུད་རྩིའི་རྡུལ་ཕྲ་རབ་རེ་རེ་ནས་ཀྱང་ས་བོན་དྷཱི་ཡིག་གི་རྣམ་པར་བྱུང་བས་ཤེས་རབ་མྱུར་བ།",
    "འོད་དང་བདུད་རྩིའི་རྡུལ་ཕྲ་རབ་རེ་རེ་ནས་ཀྱང་ཕྱག་མཚན་གྱི་རྣམ་པར་བྱུང་བས་ཤེས་རབ་ཟབ་པ་བཅས་བསྒྲུབ།",
    "རྡུལ་ཕྲ་རབ་རེ་རེ་ནས་ཀྱང་གླེགས་བམ་གྱི་རྣམ་པར་བྱུང་ནས་འཆད་པའི་ཤེས་རབ།",
    "རྡུལ་ཕྲ་རབ་རེ་རེ་ནས་ཀྱང་རལ་གྲིའི་རྣམ་པར་བྱུང་ནས་རྩོད་པའི་ཤེས་རབ།",
    "རྡུལ་ཕྲ་རབ་རེ་རེ་ནས་ཀྱང་གླེགས་བམ་དང་གླེགས་རས་ལྷན་ཅིག་པའི་རྣམ་པར་བྱུང་ནས་རྩོམ་པའི་ཤེས་རབ་འཕེལ་བར་མོས་པའི་སྒོ་ནས་ཤེས་རབ་སྒྲུབ་སྐོར་གྱི་དམིགས་པ་སྦྱངས།",
    "མངོན་སྤྱོད་ཀྱི་ལས་སྒྲུབ་པ་སོགས་མང་པོ་ཡོད་ཀྱང་རེ་རེ་ནས་དྲན་གྱི་མི་འདུག་པས་ཁྲིད་ཡིག་ཚོར་བལྟས་ན་ཤེས་ཐུབ།",
    "མཛུབ་མོ་གཟུག་ས་མེད་པའི་ཚུལ་ལ་བསམ་བློ་ཇི་ཙམ་ཐུབ་ཐུབ་ཅིག་བཏང་ན།",
    "སྔོན་ལ་བདེ་སྟོང་དབྱེར་མེད་རང་གི་རྒྱུད་ལ་ཚང་བར་བྱས་རྗེས།",
    "ཅི་འཕྲོས་མོལ་འཕྲོས་བྱས་ནས་ཕར་བསྒྱུར་ན་མ་གཏོགས་བདེ་བོ་མི་འདུག་རབ་བེ་རུབ་བེ་ཞིག་བཏོན་ན་ཁྱད་པར་མེད།",
    "ཨོ་ཨོ་ཞེས་བཏོན་བསྡད་ན་མིས་ཅང་ཤེས་ཀྱི་མ་རེད་ལ་བརྩད་གཅོད་བྱེད་མཁན་ཡང་ཡོད་པ་མ་རེད།",
    "ཁྱེད་རང་ཚོ་བོད་ནས་འབྱོར་བའི་ལྷ་ས་པ་ཚོགས་ལ་དགའ་བོ་ཡོད་ན་སང་ཉིན་ཚོགས་རྫས་ཞིམ་པོ་དེ་འདྲ་འཁྱེར་ཤོག་ཨང་།",
    "སང་དགོང་ང་ཚོ་ཚང་མས་ཚོགས་ཤིག་ཕུལ།",
    "བདག་གིས་སྦྱིན་ཚོགས་བགྱིས་པའི་ཚོགས་རྣམས་ཀྱིས།",
    "གང་གི་ཐུགས་བརྩེས་ཉེར་བཟུང་ནས།",
    "གང་གི་ཐུགས་བརྩེས་ཉེར་བཟུང་ནས།",
    "ཞེས་ང་ཚོའི་རྒྱུད་ཀྱི་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་ལ་བརྟེན་ནས་ཉེས་པ་དེ་དག་ཡོང་བ་ཡིན་པས་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་རྣམས་ཉེས་པ་ཀུན་གྱི་རྩ་བ་ཡིན་ཏེ།",
    "བདག་མེད་པ་ལ་བདག་ཏུ་ཞེན་པ་སོགས་ཕྱིན་ཅི་ལོག་གི་ལྟ་བ་དེ་དག་གིས་རྐྱེན་བྱས་ཏེ་ཉོན་མོངས་འདྲ་མིན་སྐྱེ་ཡོང་བ་དང་།",
    "ཁྱོད་ཀྱི་སྨྲ་བ་ཟླ་མེད་པར།",
    "དོན་བཞིན་གཟིགས་ནས་ལེགས་གསུངས་པ།",
    "ཆུ་ཐིགས་པ་རེ་རེས་སྣོད་ཁེངས་མི་ཐུབ་ཀྱང་ཐིགས་པ་བསགས་ན་རྒྱ་མཚོའི་དཔེ་ལྟར་ཡིན།",
    "མ་བརྗེད་པར་དེའི་ཐོག་ལ་སྣོན་པ་རྒྱག་གིན་ཕྱིན་ན།",
    "ང་ཚོར་མི་ལུས་ཐོབ་ཡོད་པར་མ་ཟད།",
    "ང་ཚོ་བོད་པར་བོད་ཡིག་སྤུས་དག་པོ་ཞིག་ཡོད་པ་འདིས།",
    "སློབ་དཔོན་ཆེན་པོ་དེ་དག་གི་བསྟན་བཅོས་རྣམས་ལེགས་སྦྱར་གྱི་སྐད་དུ་མཛད་ཡོད་ཀྱང་།",
    "སྔོན་གྱི་ལོ་པཎ་བཀའ་དྲིན་ཅན་རྣམས་དང་མཁས་པ་ཆེན་པོ་དེ་དག་གིས་ཆ་ཚང་བོད་ཡིག་ནང་བསྒྱུར་བའི་བཀའ་དྲིན་ལ་བརྟེན་ནས་ང་ཚོས་ལེགས་སྦྱར་བསླབ་མི་དགོས་ཤིང་།",
    "བོད་ཡིག་ཀྱང་ཧ་ཅང་ཡར་རྒྱས་ཕྱིན་ནས་ལེགས་སྦྱར་གྱི་སྐད་དང་དོ་མཉམ་ཆགས་པ་རེད།",
    "དེར་བརྟེན་ང་ཚོ་བོད་པ་ལ་ཆ་བཞག་ན།",
    "སྟོད་པ་ཚོས་གྲངས་ཀ་རྒྱག་སྐབས་རག་གཅིག་རེ་གཅིག་རག་གཉིས་རེ་གཉིས།",
    "ཟེར་བ་ལྟ་བུ་རེད།",
    "བཞད་མོ་བཞད།",
    "ཟེར་བ་ལྟ་བུ་རེད།",
    "བཞད་མོ་བཞད།",
    "བོད་ཡིག་གིས་དུས་ད་ལྟའི་བར་ལོ་སྟོང་ཕྲག་ལྷག་གི་རིང་ལ་བྱ་བ་ཆེན་པོ་བྱས་ཡོད།",
    "ཁྱེད་ཚོ་སྤོ་ལགས་རྨོ་ལགས་ཚོ་ཡིན་ཀྱང་ཕྱོགས་གཅིག་ནས་ང་ཚོ་ཁྱིམ་པ་མི་ནག་ཡིན་པ་དང་།",
    "ནོར་ལ་རང་གིས་ལེན་དང་མཚུངས།",
    "རང་རྒྱུད་ལ་ཆ་བཞག་ཀྱང་རང་གི་ཉེས་པ་འགོག་དགོས་ལ།",
    "བདེ་སྡུག་ཀྱང་རྒྱུ་འབྲས་ཀྱི་རྟེན་འབྱུང་གི་རང་བཞིན་ཡིན་པས།",
    "སེམས་མ་དུལ་བར་བྱེད་པའི་རྩ་བ་ཕྱིན་ཅི་ལོག་གི་ལྟ་བས་བྱེད་པ་ཡིན་པས་ཕྱིན་ཅི་མ་ལོག་པའི་ལྟ་བ་སྐྱེ་དགོས།",
    "ཕྱིན་ཅི་མ་ལོག་པའི་ལྟ་བ་སྐྱེས་པའི་སྒོ་ནས་ཕྱིན་ཅི་ལོག་གི་རྟོག་པས་དྲངས་པའི་སེམས་མ་དུལ་བ་རྣམས་མེད་པ་བཟོ་དགོས་པར་བརྟེན།",
    "ཕྱིན་ཅི་ལོག་གི་ལྟ་བས་བསྐྱེད་པའི་བློ་མ་དུལ་བ་ལ་བརྟེན་ནས་རང་གཞན་ཕོངས་པ་ཡིན་པས།",
    "དེར་བརྟེན་སེམས་བཟང་པོ་བྱེད་པའི་རྒྱབ་རྟེན་ལ་ཟབ་མོ་སྟོང་པ་ཉིད་ཀྱི་ལྟ་བའམ་རྟེན་འབྱུང་གི་དེ་ཁོ་ན་ཉིད་དང་།",
    "ཐོག་མར་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པ་ལས་མགོ་བཤེས་གཉེན་བསྟེན་ཚུལ་ནས་བཟུང་སྟེ།",
    "མཇུག་ཞི་ལྷག་གི་ལམ་ཡོངས་རྫོགས་ལ་གོ་བ་ཆགས་པར་བྱས་ཏེ།",
    "ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པའི་ལམ་ལེགས་པར་སྦྱངས་རྗེས།",
    "ཐོས་བསམ་སྒོམ་གསུམ་ཡ་མ་བྲལ་བའི་ཐོག་ནས་འཆར་ཅན་རང་ཉིད་ཀྱིས་ཉམས་བཞེས་གནང་བ་དེ་དག་ཉམས་མྱོང་གི་ཐོག་ནས་གསུངས་པ་བཞིན།",
    "ད་རེས་ཐོག་མར་༧གོང་ས་ལྔ་པ་ཆེན་པོས་མཛད་པའི་ལམ་རིམ་འཇམ་དཔལ་ཞལ་ལུང་གི་ལུང་དང་།",
    "དེར་བརྟེན་ང་ཚོ་ཚང་མས་ཧུར་ཐག་འབད་ཐག་བྱེད་དགོས་པ་ཡིན།",
    "ཚང་མས་ཧུར་ཐག་འབད་ཐག་བྱེད་རྒྱུ་དེ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "བརྟན་པོ་དེ་འདྲ་ཞིག་ཡོད་པ་ཧ་ཅང་ཡག་པོ་རེད།",
    "ད་རེས་ང་ཚོ་ཉིན་ཤས་རིང་ཐུག་ནས་ཁྱེད་ཚོ་དགའ་བོ་བྱུང་ཡོད་ཀྱི་རེད་ལ།",
    "ཡ་རབས་ཤིག་གི་ཐོག་ནས་མི་ཚེ་སྐྱེལ་རྒྱུ་དེ་གལ་ཆེན་པོ་ཡིན།",
