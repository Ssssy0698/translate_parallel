    "ཉིན་མཚན་ཀུན་ཏུ་དཔྱད་པ་བྱེད་རྒྱུ་ཞིག་ཡོང་གི་ཡོད།",
    "དེ་ལ་ཐོག་མར་ཐོས་བྱུང་གི་ཤེས་རབ་ལ་གོ་བ་ཆགས་པ་དང་།",
    "དེ་ནས་བསམ་བྱུང་གི་ཤེས་རབ་ཀྱིས་དཔྱད་པ་བྱས་ཏེ་སོ་སོའི་སེམས་ལ་ངེས་པ་ཐོབ་པ།",
    "བསམ་བྱུང་གི་ངེས་པ་ཐོབ་པའི་དོན་དེར་འདྲིས་ཤིང་གོམས་པར་བྱས་ནས་གཤིས་རྒྱུད་ལ་རྟོགས་པའི་ཡོན་ཏན་སྐྱེ་བའི་བསམ་བློ་གཏོང་དགོས་པ་ལྟར།",
    "བསམ་བློ་དེ་ཙམ་གཏོང་མི་ཐུབ་པའི་ང་ཚོ་བོད་པ་སྤྱི་བྱིངས་དང་ཀོ་རི་ཡ་སོགས་ཡིན་ན་ཡང་རེད།",
    "ང་ལ་ལེགས་ཉེས་ཅི་བྱུང་ཡང་ཁྱོད་མཁྱེན་བསམ་ན་དེ་ནང་པ་ཡིན་ནམ།",
    "བཞད་མོ་བཞད།",
    "བདེ་བ་དང་སྡུག་བསྔལ་ནི་རང་རང་གི་རྒྱུ་དང་རྐྱེན་ལ་བརྟེན་ནས་བྱུང་བ་ཐག་གིས་ཆོད་པ་དང་།",
    "སེམས་མེད་བེམ་པོ་དང་ནང་ཤེས་པ་རྣམས་རང་རང་གི་རྒྱུ་དང་རྐྱེན་ལ་བརྟེན་ནས་ཡོང་བར་མ་ཟད།",
    "དེ་དང་རིགས་མཐུན་པའི་རྒྱུ་ལ་བརྟེན་ནས་རང་གིས་གཞན་ལ་གནོད་པའི་བྱ་བ་དངོས་སུ་ཐོན་པའམ།",
    "དེ་བཞིན་དུ་རང་གི་ཤེས་པའི་སྟེང་ནས་ཚོར་བ་བདེ་བ་ཡོང་བའི་རྒྱུ་ལ་ཤེས་པ་དང་མྱོང་ཚོར་ཡོད་པ་དེས་བདེ་བ་སྐྱེ་བའི་རྐྱེན་བྱས་པའམ།",
    "ལས་ཀྱི་འབྲས་བུར་རང་ལ་བདེ་བ་ཡོང་གི་ཡོད་སྟབས།",
    "ལས་སམ་བྱ་བ་ནི་བྱེད་པ་པོ་ཞིག་གིས་ཀུན་ལས་བསླངས་ཏེ་བྱུང་བ་ཡིན་པས།",
    "ང་ཚོ་སྡུག་བསྔལ་མི་འདོད་པ་དང་བདེ་བ་འདོད་པ་ཤ་སྟག་ཡིན་པར་མ་ཟད།",
    "དེ་ལྟར་མིན་པར་རང་རང་གི་རྒྱུ་དང་རྐྱེན་ལ་བརྟེན་ནས་སྐྱེ་ཡོང་བ་ཡིན་སྟབས།",
    "ད་ལྟའི་ང་ཚོའི་སེམས་དེ་ཅི་འདྲ་ཞིག་ཏུ་ཡོད་དམ་སྙམ་ན།",
    "དེ་ནི་ཉོན་མོངས་དུག་གསུམ་གྱི་ངང་ལ་གནས་ཡོད།",
    "རང་གི་ངང་གིས་འགྲོ་བ་ཞིག་ཆགས་ཡོད།",
    "ད་རེས་ང་ཚོར་མི་ལུས་ཐོབ་ནས་བསམ་བློ་གཏོང་རྒྱུ་ཡོད་པའི་ཐོག་ལ་ནང་གི་རྐྱེན་དལ་འབྱོར་དང་།",
    "བྱེད་དོ་བྱེད་དོ་ཟེར་བཞིན་ཉི་ཤ་ཐལ།",
    "མ་བྱུང་མ་བྱུང་ཟེར་བཞིན་བཅུ་ཕྲག་ཐལ།",
    "ཞེས་གསུངས་པ་ལྟར་འགྲོ་རྒྱུ་རེད།",
    "ད་རེས་དལ་འབྱོར་གྱི་མི་ལུས་ཐོབ་ཅིང་བླང་དོར་གྱི་གནས་ལ་བསམ་བློ་ཅུང་ཟད་གཏོང་རྒྱུ་ཡོད་པའི་གོ་སྐབས་འདི།",
    "མ་འོངས་པར་རེ་བ་རྒྱག་ས་རྩ་ནས་མེད་པའམ།",
    "དེར་བརྟེན་ད་རེས་དལ་འབྱོར་གྱི་མི་ལུས་ཐོབ།",
    "གོ་སྐབས་བཟང་པོ་བྱུང་བ་ཆུད་ཟོས་སུ་མ་སོང་བའི་ཉམས་ལེན་བྱེད་དགོས།",
    "བོད་མི་རིགས་ཆགས་དང་འཇིག་ཅི་ཞིག་འབྱུང་མིན་མི་ཤེས་པའི་དུས་ཚོད་ཐབས་སྐྱོ་བོ་དང་ཚབས་ཆེན་པོ་འདི་ལྟ་བུ་ད་རེས་མ་གཏོགས་བྱུང་མེད།",
    "ཡང་ན་སེམས་ཞུམ་ནས་ད་ངས་ཅི་ཡང་ཡོང་ས་མ་རེད་བསམ་པ་ཡིན་ན་ནོར་འཁྲུལ་ཆེན་པོ་ཡིན་པར་མ་ཟད།",
    "སོ་སོ་སྒེར་ངོས་ནས་བསམ་ན་ད་རེས་ལྟ་བུའི་དུས་ཚོད་ཡག་པོ་ཞིག་སྔར་བྱུང་མྱོང་མེད་པ་ལྟ་བུ་ཡིན།",
    "དུས་ད་ལྟ་ཡང་འཛམ་བུའི་གླིང་སྤྱིའི་གནས་ཚུལ་གྱི་འོག་ནས་རེ་བ་ཡོད་པའི་གནས་ཚུལ་ཞིག་ཡིན་པས།",
    "རྣམ་མཁྱེན་རྒྱལ་བའི་གོ་འཕང་ཐོབ་པའམ་ཁ་སྦྱོར་ཡན་ལག་བདུན་ལྡན་གྱི་མི་སློབ་པའི་ཟུང་འཇུག་གི་གོ་འཕང་འཐོབ་པ་ལ་སློབ་པའི་ཟུང་འཇུག་ཐོབ་པ་སྔོན་དུ་འགྲོ་དགོས་པ་དང་།",
    "སྒྱུ་ལུས་འོད་གསལ་ཟུང་འཇུག་གི་རྟོགས་པ་དེ་དག་རྙེད་དགོས།",
    "གུང་ལ་མི་སློབ་པའི་ཟུང་འཇུག་གི་གདམས་ངག་ཞུས།",
    "སེང་ཁྲིའི་སྟེང་དུ་ཁྲི་ཆེན་པོ་ཞིག་གི་སྒང་ལ་ཁྲི་ཆུང་ཆུང་ལྔ།",
    "གྲོགས་པོ་གྲོགས་མཆེད་རྣམས་རང་གི་རྒྱབ་ངོས།",
    "དེ་དག་གི་ཐུགས་རྒྱུད་ལ་ཡོད་པའི་སྤངས་རྟོགས་ཀྱི་ཡོན་ཏན།",
    "བློ་ལ་དེ་དག་གི་གོ་ནུས་རྣམས་འདྲིས་པ་ཞིག་ཡོད་དགོས།",
    "ཞེས་པའི་བདག་གི་ཚིག་དེ་བརྗོད་པ་ན།",
    "ང་ཚོའི་བློ་ལ་རང་དགར་བདག་ཅེས་ཤར་པ་དེ་ཙམ་ལ་མི་འཇོག་པར།",
    "ང་ཚོས་དེ་དག་མཇལ་མི་ཐུབ་ཅིང་།",
    "རང་གི་མདུན་དུ་ཁྲི་ཆེན་པོ་གཅིག་དང་།",
    "ཁྲི་དབུས་མ་ལ་བསྟན་པའི་བདག་པོ་སྟོན་པ་བཅོམ་ལྡན་འདས་མཉམ་མེད་ཤཱཀྱ་སེངྒེ་དགེ་སློང་གི་རྣམ་པ་ཅན།",
    "གསུང་ཚངས་པའི་དབྱངས་ཀྱིས་གདུལ་བྱའི་ཁམས་དང་མོས་པ་དང་འཚམ་པར་གསུང་གི་འཕྲིན་ལས་མཛད་བཞིན་པ།",
    "དཔག་བསམ་གྱི་ཤིང་གི་སྡོང་པོ་ཞིག་ཡོད་པར་བསམ་དགོས་ཀྱང་།",
    "སྐྱབས་ཡུལ་གསལ་འདེབས་ཚུལ་འདི་འདྲ་ཞིག་རེད།",
    "སྡུག་བསྔལ་གྱི་རྒྱུ་ཉོན་མོངས་དུག་གསུམ་ལ་རྦད་དེ་ཧབ་ཐོབ་ཤིག་ཤིག་གིས་འགྲོ་བའི་བཟོ་ལྟ་བུ་དང་།",
    "ད་ལྟ་སྡུག་བསྔལ་ཡོད་ཀྱང་མདུན་ལམ་བཟང་པོ་ཞིག་ཡོད་ན་རེ་བ་རྒྱག་ས་ཞིག་ཡོད་ཀྱང་དེ་མེད་པར་མ་ཟད།",
    "ད་ལྟ་སྡུག་བསྔལ་མྱོང་བཞིན་པའི་ངང་ནས་སྡུག་བསྔལ་ཕྱི་མ་ཡོང་བའི་ལས་ལ་རང་གི་ངང་གིས་འཇུག་འགྲོ་བ་ཞིག་དང་།",
    "བརྙས་དམོད་ཤོར་བ་དང་།",
    "བདག་གི་སྦྱིན་སོགས་བགྱིས་པའི་ཚོགས་རྣམས་ཀྱིས།",
    "ལྟོས་ས་ལྟོས་འཇོག་གིས་གཏེ་པོའི་དཀྱིལ་གྱི་གཟུགས་བཟང་ཟེར་བ་བཞིན།",
    "དེའི་ནང་ནས་ཀྱང་མང་པོ་ཞིག་གིས་ཉོན་མོངས་དང་དུ་ལེན་པ་དང་།",
    "དེ་དག་ལ་བལྟས་ན་ང་ཚོས་ཉོན་མོངས་སྐྱོན་དུ་ལྟ་བ་ཙམ་དུ་མ་ཟད་ཉོན་མོངས་ཀྱི་རྩ་བ་རྩད་བཅད་ནས།",
    "ཉོན་མོངས་སྐྱོན་རྣམས་མ་ལུས་འཇིག་ཚོགས་ལ།",
