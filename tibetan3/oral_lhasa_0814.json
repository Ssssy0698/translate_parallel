    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ཡེ་ནས་བདེ་བའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "རྣམ་པར་ཤེས་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སྡུག་བསྔལ་དང་བྲལ་བའོ།",
    "༧ གསོལ་པ་དཔྱད་ཀྱི་འབུམ་ནི་ཇི་ལྟར་ལགས།",
    "རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུགས་པ་དགུ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་བདུད་རྩིའི་རྒྱ་མཚོའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་གཡུ་འབྲང་བདུད་རྩིའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "བརྩོན་འགྲུས་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་དྲི་མ་མེད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པར་ཤེས་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པར་སྟོང་པ་ཉིད་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུགས་པ་དགུ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་མུ་གེའི་རྒྱུན་གཅོད་པའི་འོད་དང་འདྲའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་གསོ་ཉི་མ་དགུ་ཤར། ཆ་",
    "པར་བྱེད་དོ།",
    "ལུས་ནི་སྒྱུ་མ་ལྟ་བུར་ཡིན་པར་ངོས་བཟུངས་སོ།",
    "ལུས་ནི་བྲག་ཆ་ལྟ་བུར་ཡིན་པར་ངོས་བཟུངས་སོ།",
    "ལུས་ནི་མིག་ཡོར་ལྟ་བུར་ཡིན་པར་ངོས་བཟུངས་སོ།",
    "ལུས་ནི་ཆུ་ཟླ་ལྟ་བུར་ཡིན་པར་ངོས་བཟུངས་སོ།",
    "རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་ཉི་མ་དགུ་ཤར། ཆ་",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སྒྱུ་མའི་རང་བཞིན་ཅན་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "བྱས་སྟོང་པ་ཉིད་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་མི་རྟག་པའི་རང་བཞིན་ཅན་ནོ།",
    "གཙང་མ་མཛོད་ཀྱི་དཀའ་བཅད་དོ།",
    "མ་བཅོས་པར་འཇོག་པའོ།",
    "རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "དེ་བཞིན་དུ་སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སེམས་ཉིད་སྐྱེ་བ་མེད་པའི་རང་བཞིན་ཅན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྣང་བ་རང་ལ་རང་ཤར་བའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ནི་སྣང་བ་རང་ལ་རང་ཤར་བའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ནི་སྣང་བ་རང་ལ་རང་ཤར་བའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ནི་སྣང་བ་རང་ལ་རང་ཤར་བའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་སྣང་བ་རང་ལ་རང་ཤར་བའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་སྣང་བ་རང་ལ་རང་ཤར་བའོ།"
  ]
