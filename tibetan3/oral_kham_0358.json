    "རྗེ་འདིས་ང་རང་གདན་ས་གོ་མཐོ་བ་ལས་རྒྱལ་ཁམས་གཞན་ལ་བཀོད་པ་ཐུབ་མཁན་མིན་ཡང་།",
    "གོང་མའི་མི་སྣ་སོགས་ཐམས་ཅད་ངོ་མཚར་སྐྱེས་ཏེ་སྐུ་བསོད་ཅན་ཞིག་འོང་བ་འདུག་ཅེས་གླེང་།",
    "ཁོང་སྐུ་ཚེ་ཤིན་ཏུ་ཡུན་རིང་བཞུགས་ཡོད་པ་འདྲ་སྟེ་བློ་སྦྱོང་དོན་བདུན་མའི་གཏམ་ཐེག་མཆོག་ཉེ་ལམ་ནི་དགུང་ལོ་གྱ་གཅིག་ཏུ་ཕེབས་པ་རབ་བྱུང་བཅུ་བཞི་པའི་ས་ཕག་ལོར་བརྩམས་འདུག་ཁོང་དགུང་གྲངས་བརྒྱད་ཅུ་ལྷག་བཞུགས་རིང་དུས་ཚོད་སྐད་ཅིག་ཙམ་ཡང་ཆུད་ཟོས་སུ་མི་བཏང་བར་འཆད་རྩོད་རྩོམ་གསུམ་ལ་འབད་པ་ལྷུར་ལེན་མཛད་ཅིང་།",
    "འོན་ཀྱང་རང་རྣམ་འདི་དགུང་ལོ་དོན་གཅིག་ཏུ་ཕེབས་པའི་སྐབས་སུ་བརྩམས་འདུག་པས།",
    "ས་ཁྱི་ལོར་༡༨༩༨གུང་ཐང་རང་དགོན་དུ་གདན་དྲངས་ཏེ་འཇིགས་བྱེད་ཁང་ཚན་གསར་འཛུགས་དང་འདུ་ཁང་གསར་བཞེངས་སོགས་ལ་རབ་གནས་སོགས་མཛད་ཅིང་དགོན་དེར་མཁས་གྲུབ་ནོར་བུ་གླིང་ཞེས་བཏགས།",
    "ཟླ་བ་བཅུ་གཅིག་པའི་ཚེས་བཅུ་གཉིས་ལ་སྐུ་གོང་མའི་བླ་བྲང་དང་ཉིན་ལམ་གཅིག་འགྱངས་པའི་བར་ཨ་བ་བ་གྷ་ཝང་རང་ཉིད་རྟ་པ་གཉིས་བརྒྱ་ལྷག་དང་བཅས་བསུ་བར་འབྱོར།",
    "ཤྲཱི་ཝན་སངྒུ་རུ་བྷ་ག་ཝན་བེ་རོ་ཙ་ན་ཡེ་ན་མ་བོད་སྐད་དུ།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་སྟེ།",
    "དེ་རྗེས་ལངས་ནས་འདུག་པ་བལྟ་བར་བྱ།",
    "དྲི་ཟ་པི་ཙ་ན་ཞེས་བྱ་བ་དང་།",
    "ཨ་ར་པ་ཙ་ན་འདིའི་ཁུང་འདྲེན་པ་ཡང་འབྲེལ་མེད་དེ།",
    "ཁྱེད་རང་བྱེད་པའི་འབྱུང་གཏོར་གཅིག་པུ་དེ་ཙམ་ལ་ཟེར་བ་ཡིན་ནམ།",
    "ཁྱེད་རང་རྒྱུན་དུ་བྱེད་པའི་ལག་ལེན་དང་འགལ་ལོ།",
    "ད་ལྟ་ཁྱེད་རང་སྔོན་འགྲོ་གཏོར་མ་བྱེད་པ་པོ་རྣམས་ཀྱང་གཏོར་མ་ཙམ་ལས་ས་ཆོག་གཞན་མི་བྱེད་པ་དང་འགལ་བའི་ཕྱིར་དང་།",
    "ཐ་སྙད་ལ་སྔོན་འགྲོ་གཏོར་མ་ཞེས་སྐབས་འདིར་མ་གསུངས་ཀྱང་ཨ་ར་པ་ཙ་ནའི་དཀྱིལ་ཆོག་ལས་ཀྱང་།",
    "ཀུན་རིག་ལས་སྔོན་འགྲོ་གཏོར་མ་མེད་པར་ཨ་ར་པཱ་ཙ་ན་ལས་བླངས་པ་མ་ཡིན་ནོ།",
    "ཨ་ར་པཱ་ཙ་ན་ལས་བླངས་པའང་མིན་ལ།",
    "གཞན་ནས་ནི་ཁྱེད་རང་ཡང་མི་ལེན་པའི་ཕྱིར།",
    "དེ་བས་ཨ་ར་པཱ་ཙ་ནའི་ས་ཆོག་དང་སྔོན་འགྲོ་གཏོར་མ་གཉིས་ཕྱོགས་གཅིག་ཏུ་བྱས་ནས།",
    "ཨ་ར་པཱ་ཙ་ནའི་དཀྱིལ་ཆོག་དང་དངོས་སུ་འགལ་ཞིང་།",
    "ཡང་ཁྱེད་རང་སྲུང་འཁོར་རྒྱས་པ་ཁོ་ནས་འདིས་སྲུང་འཁོར་གྱི་གོ་ཆོད་པར་ཡང་འདོད་པས།",
    "རས་ཡུག་མེད་པའི་ཁ་ཚར་ལྟར་རྣམ་དག་མ་ཡིན་པར་འདུག་པའི་ཕྱིར།",
    "གཞན་དུ་ན་བཞན་དག་བཀོད་པར་འདུག་པས་འདིར་མ་སྨོས་སོ།",
    "འདིར་བསྟན་པའི་བུམ་པ་ནི་བདུད་རྩི་འཁྱིལ་པའི་བུམ་པར་འདུག་པའི་ཕྱིར།",
    "དེ་དང་འདིའི་ལས་བུམ་ལ་དབྱེ་བའི་ཐ་དད་མི་འདུག་པའི་ཕྱིར།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གཉིས་ཐ་དད་དུ་གསུངས་ཤིང་གཅིག་ཏུ་ཡང་གསུངས་འདུག་པའི་ཕྱིར།",
    "བདག་འཇུག་དུས་སུ་བུམ་པ་དེ་གཉིས་ཀ་བཤོམ་པ་ལ།",
    "དེ་བརྒྱུད་འདིའི་དགོངས་པ་མིན་པ་འདུག་པའི་ཕྱིར།",
    "མ་གསུངས་པའི་ཚིག་མང་པོ་བཅུག་པའི་གྱེར་དབྱངས་སྣ་ཚོགས་བྱེད་པ་རྣམས་ཀྱང་རང་བཟོའི་དྲི་མས་ཆོ་ག་མ་དག་པར་བྱེད་པའི་བདུད་ལས་འབའ་ཞིག་ཡིན་པས་ཤེས་ལྡན་རྣམས་ཀྱིས་རྒྱང་དུ་དོར་བར་བྱའོ།",
    "སྐྱིལ་ཀྲུང་དུ་འདུག་པས་ལུས་ཀྱི་ཀུན་སྤྱོད་བསྟན།",
    "དེ་ལ་དེ་མི་དགོས་བཞིན་དུ་བྱས་འདུག་པའི་ཕྱིར།",
    "འོན་ཀྱང་རང་དགའ་ནི་མ་ཡིན་ཏེ།",
    "ལྷག་ཆད་ཀྱི་སྐྱོན་དུ་མི་འགྱུར་བ་འདུག་ལགས།",
    "ཡིད་བྱིན་གྱིས་བརླབས་པ་ཡིན་གསུང་པར་གདའ།",
    "ལྷའི་ཁང་པར་ཇི་ལྟ་བ་བཞིན་དུ་བཞུགས་པ་འདུག་སྟེ།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཁྲོ་བོ་རྣམས་མདུན་གྱི་ནམ་མཁའ་ལ་བཞུགས་པར་བཞེད་པ་གདའ་ཞིང་།",
    "མཁས་པ་སྔ་མའི་བཞེད་པ་མང་དུ་གདའ་ནའང་།",
    "ཞེས་སོ་ཞེས་ལུང་དང་བཅས་ཏེ་གསལ་བར་གསུངས་གདའ་ལགས།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་ནས།",
    "ཞེས་རྗེ་བཙུན་ཆེན་པོས་གཞན་ཕན་འོད་ཟེར་སོགས་ལས་གསུངས་གདའ།",
    "ཞེས་གསུངས་པའི་ཚུལ་དང་མཚུངས་པ་ཡང་ཡིན་པ་གདའ་ལགས།",
    "སྐབས་འདིར་ལམ་དང་ཐབས་ལ་འཇུག་པ་ཡིན་པར་གདའ་ལགས།",
    "ལྷ་དངོས་སུ་མི་བསྐྱེད་པ་བསྡུས་པ་ཡིན་བྱས་ཀྱང་འགལ་བ་མི་ཡོང་བ་གདའ་ལགས།",
    "ཞེས་གསུངས་པ་བཞིན་ཡིན་གསུང་བ་གདའ་ལགས།",
    "མཆུ་བུག་པ་ཅན་འདི་སྒོར་བ་ལ་འགལ་བ་ནི་མི་གདའ་ལགས།",
    "རང་རང་སྔགས་ཀྱིས་བཏབ་པ་ཡི།",
    "བྱས་ཀྱང་འགལ་བ་མི་གདའ་ལེགས་ཤིང་།",
    "ཕྱག་རྒྱ་བཞིའི་རྒྱས་འདེབས་མཛད་པ་གདའ་ནའང་།",
    "མ་བྱས་ཀྱང་ཆོག་ཆད་པའི་སྐྱོན་དུ་མི་འགྱུར་བ་འདུག་ལགས།",
    "བུམ་བཟླས་ལ་བུམ་སྔགས་བཟློས་དགོས་པ་རྗེ་བཙུན་ཆེན་པོའི་དགོངས་པར་གདའ།",
    "ཅུང་ཟད་དཔྱད་རྒྱུ་གདའ་ནའང་།",
    "འཕོག་ཐུག་དུམ་ཙམ་ཡོང་པ་གདའ་བས་གསལ་བར་མ་བརྗོད།",
    "ཕྲིན་ལས་རྒྱས་འབྲིང་བསྡུས་བཞིར་དབྱེ་བ་ཤིན་ཏུ་ཡང་བཞེད་པར་གདའ་ལགས།",
    "དེས་ན་ཕྱག་རྒྱ་མ་གཏོགས་སྒྲུབ་པའི་ཡན་ལག་གཞན་རྣམས་སྐབས་འདིར་དོད་ཙམ་ཚང་བ་འདུག་ལགས་ཀྱང་།",
    "ཅི་ནས་ཀྱང་མ་ཡིན་གསུངས་པ་གདའ་ལགས་ཤིང་།",
    "རིན་ཆེན་འཕྲེང་མཛེས་སོགས་ན་གསལ་བས་འདིར་བྲི་མི་དགོས་པ་འདུག་ལགས།",
    "འབྲིང་རང་བཞིན་གྱི་གནས་ནས་སྤྱན་འདྲེན་པའི་དཀྱིལ་འཁོར།",
    "རིགས་ལྔ་ཡུམ་བཞི་སྒེག་སོགས་རྣམས་ལ་ཡང་སྦྱར་ཏེ་མཛད་པར་གདའ།",
    "ཕྱག་ཆེན་འཆའ་བ་མཛད་པ་ཡིན་པ་གདའ་ལགས།",
    "གཞན་དུ་མ་བྱས་ན་ཆོ་ག་ཆད་པའི་སྐྱོན་དུ་འགྱུར་གསུངས་པར་གདའ་ལགས།",
    "གཞན་ཡང་འདི་དག་ལ་དཔྱད་པ་དང་རྣམ་པར་དཔྱད་པ་མང་དུ་འདུག་ནའང་།",
    "ཞེས་གསུངས་གདའ་ལགས།",
    "དེ་ལྟར་བདུན་བརྒྱུད་ལ་ངོས་འཛིན་ལུགས་མང་དུ་གདའ་ནའང་འདིར་ནི།",
    "ང་རྒྱལ་འཛིན་པ་འདི་ཀུན་རིག་སོགས་དཀྱིལ་འཁོར་གཞན་བཅུ་ག་ལ་མི་དགོས་པ་འདུག་ལགས།",
    "མཁས་གྲུབ་དུ་མའི་བཞེད་པར་གདའ།",
    "བདག་འཇུག་དུས་ང་རྒྱལ་འཛིན་དགོས་པ་འདུག་ལགས།",
    "དེས་ན་ལུགས་དེ་གསུམ་གང་རུང་གཅིག་བྱས་པས་འགལ་བ་མི་ཡོང་པ་གདའ་ལགས།",
    "ཉམས་དགའ་བ་དང་ཤེས་པ་ཆགས་པའི་དགོས་པ་ཡོད་གསུངས་པ་གདའ་ལགས།",
    "ཞེས་གསུངས་པའི་དགོངས་པར་གདའ།",
    "ཞེས་གསུངས་པ་ལྟར་ཡིན་པ་གདའ་ལགས།",
    "ཞེས་གསུངས་འདུག་ལགས།",
    "དམ་པ་ཁ་ཅིག་བཞེད་པར་གདའ་ལགས།",
    "གཞན་པས་འོད་ཟེར་དུ་ཡང་བཀྲུ་སྔགས་རྩ་རིག་ཏུ་གསུངས་འདུག་ལགས།",
    "དེའི་ཚུལ་མཚུངས་ཡང་ཡིན་པ་གདའ་ལགས།",
    "མངོན་དགའི་ཞིང་སོགས་རང་གང་འདོད་པའི་ཞིང་དམིགས་རྟེན་དུ་བྱས་ཏེ་གནས་སྤོར་བར་གདའ།",
    "འོན་ཀྱང་རང་བཞིན་རྣམ་དག་ལ་གྱ་ནོམ་ལྷར་ཞེན་དང་།",
    "དེ་ལ་འཁོར་གསུམ་མི་རྟོག་པས་རྒྱས་ཐེབ་པ་གལ་ཆེ་བ་རང་ཡིན་པ་གདའ་ལགས།",
    "ང་རང་ད་ལན་གྱི་དང་པོ་དང་།",
    "འབྲི་གཡག་ཅེས་པ་ལྟ་བུ་ཡང་རང་དང་ཐད་ཀར་འབྲེལ་བ་བྱུང་བའི་བྱ་དངོས་གཞིར་བཟུང་ནས་རྩོམ་འབྲི་བྱས་པ་ཞིག་ཡིན་ཅིང་།",
    "འདས་པའི་ལོ་ཟླའི་ནང་འཆར་བའི་བསམ་འདུན་སྤྱི་དང་བྱེ་བྲག་ལ་མིག་ལྟ་དང་བསམ་གཞིགས་བསྐྱར་མ་བྱས་སྔར་བཞིན་བླ་ན་མེད་པའི་བསམ་འདུན་ཞིག་བརྗིད་ཆགས་ས་འཛིན་ཇོ་ཙ་ན།",
    "ཁྱེད་རང་ཧ་ཅང་སྤྱང་པོ་ཡོད་པ་མ་ཟད།",
    "འོན་ཀྱང་རང་སེམས་གཅུན་མཁན་དང་།",
    "སྐབས་དེར་བཟའ་ཟླས་དངོས་པོ་འདི་དག་སྐྱེལ་མཁན་དེ་ཁྱེད་ཀྱི་སློབ་གྲོགས་ཡིན་ཟེར་པད་མ་རིག་འཛིན་གྱིས་བཟའ་ཟླར་ད་དུང་གྱི་འདུག་ཅེས་དོན་ངོ་མ་བཤད།",
    "ལ་ཁོང་རང་ཉིད་ལའང་དེ་མཚུངས་སུ་མི་ཚེའི་བགྲོད་ལམ་གསར་པ་ཞིག་འཆར་འོང་བའི་སྤྲོ་སྣང་འཕེལ།",
    "ལེགས་སྐྱེས་ཀྱི་གནས་ཚུལ་ཤེས་རྟོགས་བྱས་ཙ་ན།",
    "བྱེད་ཆོག་པ་ཞིག་ཡིན་སྙམ་གྱི་འདུག་ཅེས་དང་།",
    "གསར་རྩོམ་ཆུ་ཀླུང་བརྡོལ་ཞེས་པ་ཞིག་བྲིས་ན་ཧ་ཅང་འཚམས་པོ་ཡོང་བ་འདུག་སྙམ་པའི་དྲན་འཆར་ཞིག་ཀྱང་ཡིད་ལ་འཁོར།",
    "ལེགས་ཤོས་ཡིན་ཞེས་ཤོད་ཁག་པོ་འདུག་གཉིས་པ།",
    "རང་རང་བཞེད་སྲོལ་སྐད་སྙན་སྒྲོག་པའི་དུས།",
    "མི་རྣམས་དགའ་བ་སྐྱེ་འོས་པའི་འཕེལ་རྒྱས་བྱུང་ཡོད་ཅེས་བརྗོད་ཀྱི་འདུག་པས་དེའི་ཐོག་ནས་ཀྱང་ཁྲང་ཀྲང་ཚེ་རིང་སྒྲོལ་དཀར་ལགས་ཀྱིས་མདུན་སྐྱོད་བྱེད་པའི་ལམ་དུ་དཀའ་ངལ་ཇི་ཙམ་འཕྲད་ཀྱང་ཕྱིར་བཤོལ་མ་གནང་བའི་རྟུལ་ཕོད་ཅན་གྱི་གཟུགས་བརྙན་ཞིག་འཆར་གྱི་འདུག་ཀ་༧ ཕྱི་སྤུས་ཚད་འགག་སྒོ་ནན་པོ་སྲུང་།",
    "དམངས་ཁྲོད་རྩོམ་རིག་མྱུར་སྐྱོབ་ལེགས་སྒྲིག་སོགས་ཀྱི་བྱ་བར་འབད་འབུངས་ངང་ཞུགས་ཏེ་གྲུབ་འབྲས་ཀྱང་གཡུར་དུ་ཟ་བ་ཐོབ་སྟེ་མཚན་སྙན་གྲགས་ཀྱང་རང་དགར་ཁྱབ་ཡོད།",
    "ཁོང་རང་ཉིད་ལ་དམངས་ཁྲོད་རྩོམ་རིག་ཕྱོགས་བསྡུས་གསུམ་གྱི་སྔོན་ཐོན་ལས་དོན་པའི་མཚན་སྙན་དང་བྱ་དགའ་ཐོབ་པ།",
    "མདའ་རྟའི་རྟ་རྒྱུག་དུས་ཆེན།",
    "གསུམ་ནི་སླད་ཕྱིན་ཁྱེད་རང་ནས་མུ་མཐུད་དེ་ལས་ཞོར་གྱི་རྩོམ་འབྲིའི་བྱ་བར་ཞུགས་གནང་རྩིས་ཡོད་དམ་མེད་བཅས་ཡིན་ཞེས་ཞུས་པ་ཡིན།་",
    "ཁྱེད་རང་ལ་གསར་རྩོམ་གངས་ལྗོངས་རྩོམ་རིག་བྱ་གཞག་ལ་ལེགས་སྐྱེས་འབུལ་བའི་མི་ཚེ།",
    "འོན་ཏེ་ང་རང་ཆུང་སོ་དཀར་གྱི་དུས་ནས་རྒས་སྐྲ་དཀར་གྱི་དབར་དགའ་བའི་ལས་ཀ་བཀངས་མཐོའི་ཕུལ་བྱུང་མི་སྣ།",
    "གསོན་ཉམས་དོད་ཅིང་མི་སེམས་རབ་ཏུ་འགུལ་བ་ཞིག་ཡིན་པ་ནི་བྱ་དངོས་མང་པོ་ཞིག་ནས་མི་རྣམས་ལ་ར་སྤྲོད་ཡོང་བཞིན་གདའདཔེར་ན།",
    "ཡོང་རིན་ཆོག་འདུག་སྙམ་པའི་ཚོར་སྣང་སྐྱེས།",
    "སླར་ཡང་རང་བདག་འབྲི་གཡག་དགུ་བཅུ་དང་།",
    "ནང་མི་ཚོས་མགོ་བོར་མེ་ཤོར་ཡང་འཕུར་འཕུར་གཏོང་ཁོམ་མེད་པ་ལྟར་ཡར་འགྲོ་མར་འོངས་བྱེད་མཁན་ཚོར་སྣེ་ལེན་ཞུ་བཞིན་གདའ།",
    "ཚོད་རྩིས་བྱས་ན་སྔ་དྲོ་ཆུ་ཚོད་བཞི་ཙམ་གྱི་ནང་ཁེ་བཟང་སྒོར་ནས་ཆག་བཟོ་མི་འདུག་ཅེས་བརྗོད་ཀྱི་འདུག།",
    "ཁྱེད་རང་འབྲས་སྤུངས་ཀྱི་གྱེན་ལམ་དུ་སྐུ་ལས་ཁག་སྟེ་རྟ་ཕོ་ཆིབས་པ་ཨེ་ཡིན།",
    "ཁྱེད་རང་ཕ་ཡུལ་གང་ནས་ཡིན་ནམ།",
    "ཚོང་འདུས་ནང་བྲིན་ཁ་རྒྱུག་ཤོས་ཀྱི་གྲས་ཡིན་འདུག་ཅིང་།",
