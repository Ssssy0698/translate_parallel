    "ཕྱི་ནང་གསང་གསུམ་ལུང་བསྟན་དཔག་མེད་གནང་།",
    "༤་ཐོག་མར་མཁྱེན་རབ་རྒྱ་མཚོས་འདི་སྐད་ཟེར།",
    "ངེས་པར་ཡིན་གྱི་གཞན་དུ་འགྱུར་མི་སྲིད།",
    "གཟུགས་སྐུས་འགྲོ་དོན་མཛད་པ་དེ་ལྟར་ལགས།",
    "དོན་གྱི་བཞུགས་ཚུལ་མཉམ་རྗེས་བློ་ལས་འདས།",
    "མཉམ་གཞག་བྱས་ཀྱང་དོན་ལ་གཞི་གནས་ཏེ།",
    "འགལ་བར་གྱུར་ན་དབྱིངས་ནས་བཟོད་པར་བཞེས།",
    "ཡུམ་གྱི་ཞལ་ནས་བདག་འདི་སྐད་གསུངས།",
    "འབྲལ་མེད་སྤྱི་གཙུགས་ཏུ་བཞུགས་ལས།",
    "དབུས་གཙང་དག་པའི་ཞིང་ཁམས།",
    "དགོས་མེད་བྱས་ན་ནོར་རྫས་འདོད་དགུ་འབྱུང་།",
    "གཞན་དོན་བྱས་ན་རང་དོན་ཞོར་ལ་འགྲུབ།",
    "མཉམ་པར་བཞག་བློ་བྱས་གྱུར་ཀྱང་།",
    "ཇི་ཙམ་སྒོམ་བློ་བྱས་གྱུར་ཀྱང་།",
    "སྣང་སེམས་འདྲེས་པར་བྱིན་གྱིས་རློབས།",
    "མཐོ་དམན་མེད་པའི་ཁྱབ་བརྡལ་ཆེན་པོར་བཞུགས།",
    "ཁྱི་ལོ་ཚུན་ལ་དབུས་གཙང་འབྱོན་པས་ཡོང་།",
    "ཁས་བླངས་གཉེར་ལེན་བཀའ་སྒྲུབ་དམ་འཆའ་བྱས།",
    "སྔ་ཕྱི་ཀུན་ཏུ་མགུར་མ་འདི་སྐད་བྱས།",
    "འགྲོ་ལ་ཉེ་རིང་མེད་པའི་གདམས་པ་གནང་།",
    "གང་ལའང་ཞེན་འཛིན་མེད་པར་མཛོད།",
    "གོལ་ས་ཤོར་ས་མེད་པར་མཛོད།",
    "མ་བཅོས་ལྷུག་པར་བཞོག་དང་སྐལ་ལྡན་ཚོ།",
    "བོད་ཡིག་ཀ་ཁའི་སླབ་བྱ་འདི་ཉིད་བྱས།",
    "ང་ང་ཡིན་བྱས་ཀྱང་ཕན་མི་ཡོང་།",
    "ཟ་ཟ་ཉལ་བསྡད་པས་འགྲུབ་མི་ཡོང་།",
    "གནས་ལུགས་དོན་ལ་ཚིག་བརྩོད་མང་དུ་བྱས།",
    "དེ་དུས་ང་ཡིས་མགུར་མ་འདི་སྐད་བྱས།",
    "རང་གཞན་ཀུན་ལ་ཕན་ཕྱིར་བཀོད་པར་བྱ།",
    "མ་རྟོགས་ལོག་རྟོགས་ཕྱོགས་རྟོགས་བྱས་པས་ལན།",
    "སྐུ་གསུམ་འབྲས་བུ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "མི་འགྱུར་རྡོ་རྗེའི་གདན་ལ་བཞུགས་སུ་གསོལ།",
    "བདག་སོགས་གདུལ་བྱའི་སྣང་ངོར་བཞུགས་སུགསོལ།",
    "རང་བྱུང་རིག་པ་ཡེ་ནས་རྣམ་པར་དག།",
    "རྡོ་རྗེ་ཕག་མེས་དངོས་སུ་གདམས་པ་གནང་།",
    "ཤེས་བྱའི་མཁའ་ལ་མཁྱེན་པའི་དཀྱིལ་འཁོར་རྒྱས།",
    "དངོས་སུ་བྱོན་ནས་ཁ་བྱང་ཤོག་དྲིལ་གནང་།",
    "འབྲེལ་ཚད་དོན་ལྡན་དུས་གསུམ་མཁྱེན་པ་ལ།",
    "ཀུན་བཟང་དགེས་པའི་ཀློང་དུ་ཐོལ་ལོ་བཤགས།",
    "དགེ་འདིས་མཚོན་ནས་ལེགས་བྱས་ཇི་སྙེད་ཀུན།",
    "མཁྱེན་རབ་རྒྱ་མཚོས་ཕུལ་བའི་བསྟོད་པ་ཡིན།",
    "མཁའ་འགྲོ་གཏེར་བདག་རྣམས་ལ་བཀའ་གནང་ཞུས།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་བབས་ནས་བསུ་བ་བྱས།",
    "གཞན་ཡང་འབུལ་བ་རྣམ་གྲངས་མང་དུ་བྱས།",
    "དེ་སྐད་བཀའ་ལུང་ནན་ཆེར་གནང་པ་དང་།",
    "དེ་རིང་ཁྲོམ་། གཏེར་དགོས་ན་བྱས་པས་ཆོག།",
    "དུས་ལ་མ་བབ་ཁྲོམ་གཏེར་བྱས་གྱུར་ན།",
    "ཕ་ཁྱེད་གང་དུ་བཞུགས་སམ་ཅི།",
    "བྱིན་གྱིས་རླབས་པར་མཛད་དུ་གསོལ། ། དེ་སྐད་གསོལ་བ་བཏབ་པ་ཡིས།",
    "མདུན་གྱི་ནམ་མཁར་ཕེབས་ནས།",
    "དབུ་སྐྲའི་ཐོར་ཅོག་ཁྲེལ་བྱས་པས།",
    "ཅིས་ཀྱང་ནུབ་ལ་ཕེབས་དགོས་ཟེར།",
    "ལུང་བསྟན་ཞིབ་རྒྱས་མང་དུ་གསུངས།",
    "ཅེས་བྱས་ཚེས་པ་བཅོ་ལྔའི་ཉིན།",
    "སྤྲང་མེས་པའི་སྤྱི་གཙུགས་རྒྱན་དུ་བཞུགས།",
    "མཁྱེན་པའི་བདག་པོས་བཞེངས་པའི་གཙུག་ལག་ཁང་།",
    "ལྷག་ཆད་མེད་པར་ཡི་གེར་བྲིས།",
    "ཉི་མ་ཕྱེད་བྱས་བོད་དུ་སླེབས།",
    "སྒང་རིང་ཡོན་བདག་རྣམས་ཀྱིས་བསྙེན་བཀུར་བྱས།",
    "དེ་ནས་བན་པར་རྗེའི་དྲུང་དུ་ཕྱིན།",
    "དཔག་མེད་པར་སྟོན།",
    "བདེ་ཆེན་འཁོར་ལོའི་བར་དུ་ལེགས་པར་གང་།",
    "འོད་ཟེར་རྒྱལ་པོས་ལེགས་པར་བྲིས་པ་ལ།",
    "དྲིན་ཆེན་རྗེ་ལ་བརྟན་བཞུགས་ཕུལ་བའི་ལེའུ་སྟེ་ཉི་ཤུ་གཅིག་པའོ།་",
    "དངོས་པོའི་རིགས་བྱས་ཁྱད་པར་མེད་དོ་ཞེས།",
    "སྒར་སོགས་རྒྱག་ལོང་མེད་པར་གདན་འདྲེན་མཛད།",
    "ཇི་ལྟར་མཛད་ཀྱང་འགལ་བ་མེད་ལགས་ཏེ།",
    "དེ་སྐད་བྱས་པས།",
    "གདན་ལ་བཞུགས་ཚེ་མགུར་མ་འདི་སྐད་ཐེན།",
    "གང་ལྟར་བྱས་ཀྱང་བློ་སེམས་བདེ་པོར་ཡོད།",
    "སྦས་ཡུལ་གནས་སྒོ་ལེགས་པར་ཕྱེ་ནས་ཡོད།",
    "སྦ་གསང་མེད་པའི་བཀའ་ལུང་འདི་སྐད་གནང་།",
