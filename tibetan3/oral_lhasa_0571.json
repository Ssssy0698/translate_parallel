    "ལྷ་རྣམས་དེར་ཞུགས་ནས་དོན་སེམས་ཤིང་འཇལ་ལ་ཉེ་བར་རྟོག་པར་བྱེད་དོ།",
    "དེ་རྣམས་དགའ་ལྡན་ཉེ་བར་འགྲོ་ཞེས་གསུངས་སོ།",
    "གཟུགས་མེད་པར་སྐྱེས་པ་རྣམས་ནི།",
    "རྣམ་པར་ཤེས་པའི་ཟས་རྣམ་པ་གསུམ་གྱིས་ནི།",
    "རྒྱུན་མི་འཆད་པར་ཉམས་སུ་མྱོང་བའི་ཕྱིར་རོ།",
    "སྡུག་བསྔལ་འདྲེས་པར་ཡོད་པ་འཁྲིག་པའི་སྦྱོར་བ་བྱེད་པ་ཡང་ཡོད་དེ།",
    "སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་ཀྱི་ནི་གཉིས་ཀྱི་གཉིས་སྤྲད་པས་གདུང་བ་མེད་པར་འགྱུར་རོ།",
    "ཕན་ཚུན་མིག་ཚུགས་སུ་བལྟས་པ་ཙམ་གྱིས་གདུང་བ་མེད་པར་འགྱུར་རོ།",
    "བདེ་བ་སྐྱེ་བ་རྣམ་པར་གཞག་ཅེ་ན།",
    "ཚངས་པར་སྤྱོད་པ་ཚོལ་བའོ།",
    "དེའི་གོང་དུ་སྐྱེ་བ་རྣམ་པར་མི་གཞག་གོ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་གྱི་སྐྱེ་མཆེད་ཀྱི་དོན་དུ་ལོག་པའི་ཚངས་པར་སྤྱོད་པ་ཚོལ་བ་ལ་འཇུག་སྟེ།",
    "དེ་ནི་ཚངས་པར་སྤྱོད་པ་བླ་ན་མེད་པ་མ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་ལུས་རྣམ་པར་གཞག་པ་ནི་འདི་ཡིན་ཏེ།",
    "རྒྱན་གྱི་སྦྱོར་བ་དང་ལྡན་པར་གནས་པ་ན།",
    "དེ་དག་དེ་ལྟར་གནས་པས་དྲན་པ་བརྗེད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་ལྷ་ཡིད་འཁྲུག་པར་བྱེད་པ་ཞེས་བྱ་བ་དག་ཡོད་དེ།",
    "དེ་དག་གང་ཚེ་གཅིག་ལ་གཅིག་མིག་ཚུགས་སུ་རྟོག་པར་བྱེད་དེ།",
    "དེ་ལྟར་དེ་དག་རྟོག་པ་ན་གཅིག་ལ་གཅིག་འཁྲུག་པར་བྱེད་དོ།",
    "རྣམ་པར་སྨིན་པའིརང་བཞིན་ལུས་སྐྱེ་བ་ཡོངས་སུ་མ་རྫོགས་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ནི་ཉི་མ་རྣམ་པར་སྣང་བྱེད་ཀུན་ཏུ་བརྒྱུ་ཞིང་ཕྱོགས་སྣང་བར་བྱེད་པ་ཞེས་པ་ནས།",
    "དེ་ལས་ཕྱི་རོལ་གྱི་འཇིག་པའི་རྐྱེན་གྱིས་དེ་དག་འཇིག་པར་འགྱུར་བ་ཡིན་གྱི།",
    "ངེས་པར་བསྐལ་པར་གནས་པ་འཕེན་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཕྱི་རོལ་གྱི་སྣོད་རྣམས་ནི་བསྐལ་པར་གནས་ཤིང་།",
    "ལས་ཀྱི་འཕེན་པ་ཡོངས་སུ་རྫོགས་པ་ན་འཇིག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ལོ་བཅུའི་བར་དུ་འཕེན་པར་བྱེད་པ་དག་ཀྱང་ཡོད་དོ།",
    "ཕྱིའི་རྐྱེན་གྱིས་འཇིག་པར་མི་འགྱུར་རོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ནི་ཞིག་པར་གནས་སོ།",
    "ཚེ་ལོ་བརྒྱད་ཁྲི་ལ་ཐུག་པར་འགྱུར་བ་དང་།",
    "ཚེ་ནུར་ནས་སླར་ཚེ་ལོ་བརྒྱད་ཁྲི་བ་ལ་ཐུག་པར་འགྱུར་བའི་དུས་ཀྱང་ཡོད་དེ།",
    "དེའི་ཕྱིར་རུས་པ་རྙིང་པ་དག་ཀྱང་སྐོལ་ཞིང་སྲོག་འཛིན་པར་བྱེད་ལ།",
    "ཏིལ་གྱི་འབྲུ་རྙེད་པར་གྱུར་ན།",
    "དེ་དག་རྒྱུ་དེ་དང་རྐྱེན་དེས་ཚེ་འགྲིབ་པར་མི་འགྱུར་ཞིང་།",
    "མུ་གེ་ཡང་མེད་པར་འགྱུར་རོ།",
    "གང་ཚེ་མི་རྣམས་ཚེ་ལོ་ཉི་ཤུ་ཐུབ་ཅིང་སྐྱེ་བ་དེ་ཉིད་མེད་པར་གྱུར་ནས་འགྲིབ་པ་དེའི་ཚེ།",
    "རྒྱུ་དེ་དང་རྐྱེན་དེས་ཚེ་འགྲིབ་པར་མི་འགྱུར་ཞིང་།",
    "ཚེ་འགྲིབ་པར་འགྱུར་བ་དེའི་ཚེ།",
    "ལན་ཚུའི་རོ་རྣམས་ནི་ཐམས་ཅད་ནམ་ཐམས་ཅད་དུ་མེད་པར་འགྱུར་རོ།",
    "སྐྱེ་བ་ལས་སླར་ཚེ་འགྲིབ་པར་མི་གྱུར་རོ།",
    "ཚེ་ཡང་བརྒྱད་ཁྲི་ལ་ཐུག་པར་འགྱུར་རོ།",
    "གསུངས་པས།",
    "འཕེལ་འགྲིབ་གཉིས་གཉིས་སྡོམ་པའི་ཁུག་པ་ཡིན་པར་འཆད་དེ།",
    "དགོངས་པ་བརྟག་པར་དཀའོ།",
    "དེ་ལྟར་གནས་པའི་བར་གྱི་བསྐལ་པ་རྣམས་རྫོགས་པ་ན་འཇིག་པའི་བསྐལ་པ་རྩོམ་པར་བྱེད་དོ།",
    "འོག་ཏུ་སྣོད་ཀྱི་འཇིག་རྟེན་འཇིག་པར་འགྱུར་རོ།",
    "ཚུལ་དེས་མིའི་འཇིག་རྟེན་སྟོང་པར་འགྱུར་རོ།",
    "ཐན་པ་བྱུང་བས་ཉི་མའི་དཀྱིལ་འཁོར་འདི་ཉིད་ཀྱིས་རབ་ཏུ་ཤས་ཆེར་སྲེག་པར་གངས་ཅན་རིག་བཅུད་ལས།",
    "བསྲེག་པར་བྱ་བའི་དངོས་པོ་རྣམ་པ་དྲུག་ཡོད་པའི་ཕྱིར།",
    "དེ་ལ་བསྲེག་པར་བྱ་བའི་དངོས་པོ་དྲུག་པོ་གང་ཞེ་ན།",
    "ལྟེང་ཀ་ཆེན་པོ་དག་ནི་ཉི་མའི་དཀྱིལ་འཁོར་གཉིས་པས་སྲེག་པར་བྱེད་དོ།",
    "ཆུ་ཀླུང་ཆེ་ཆུང་དག་ནི་ཉི་མའི་དཀྱིལ་འཁོར་གསུམ་པས་བསྲེག་པར་བྱེད་དོ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ནི་ཉི་མའི་དཀྱིལ་འཁོར་ལྔ་པ་དང་དྲུག་པའི་ཕྱོགས་ཀྱིས་སྐེམས་པར་བྱེད་དོ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་དྲུག་པ་དང་བདུན་པས་སྲེག་པར་བྱེད་དོ།",
    "ཆུ་ལས་བྱུང་བའི་དངོས་པོ་རྩ་ལ་སོགས་པ་དག་ནི་དང་པོ་ཉིད་ཀྱིས་སྐེམས་པར་བྱེད་དོ།",
    "བརྟན་ཞིང་སྲ་བའི་དངོས་པོ་དག་ཉིད་ནི་གཉིས་ཀྱིས་སྲེག་པར་བྱེད་དོ།",
    "གང་ཚུན་ཆད་མེས་འཇིག་པ་ལན་བདུན་འདས་པར་གྱུར་པ་དེའི་འོག་ཏུ་བསམ་གཏན་གཉིས་པ་ཉིད་ལས་བྱུང་བའི་ཆུའི་ཁམས་འབྱུང་སྟེ།",
    "ཆུའི་ཁམས་དེ་ཉིད་ཀྱིས་སྣོད་ཀྱི་འཇིག་རྟེན་ལན་ཚྭ་བཞིན་དུ་ཞུ་ནས་ཆུ་ཡི་ཁམས་དེ་ཡང་སྣོད་ཀྱི་འཇིག་རྟེན་དང་ལྷན་ཅིག་ཏུ་མེད་པར་འགྱུར་རོ།",
    "མེད་པར་གྱུར་ནས་ཀྱང་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་གནས་སོ།",
    "གང་ཚུན་ཆད་ཆུས་འཇིག་པ་ལན་བདུན་འདས་པར་གྱུར་པ་དེའི་འོག་ཏུ་མེས་འཇིག་པ་ལན་གཅིག་འབྱུང་ལ།",
    "ལས་ཟད་པ་ཞིག་དེ་ནས་ཤི་འཕོས་ནས་བསམ་གཏན་གསུམ་པར་སྐྱེ་ལ།",
