    "བརྟགས་པ་ནི་རྣམ་པར་གཞག་པ་སྟེ།",
    "འབྲས་བུའི་དུས་སུ་ངེས་པར་གནས་པས་རྫོགས་སོ།",
    "རྟ་བབས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཏིང་ངེ་འཛིན་གྱི་ཡན་ལག་རྒྱས་པར་བསྟན་ཏེ།",
    "དངོས་དང་དངོས་པོ་མེད་པར་འཛིན་པ་ལས་གྲོལ་བ་ནམ་མཁའི་ཁམས་དང་མཉམ་པ་ལ་བརྟེན་པ་ཞི་བར་གནས་པའི་ཁྱད་པར་ནི་སེམས་ཀྱི་བླ་བྲེའོ།",
    "ད་ནི་སྐད་ཅིག་མ་བཞིའི་དགའ་བ་རྣམས་བསྟན་པར་བྱ་སྟེ།",
    "ཟུར་ལ་སོགས་པར་སོན་པའི་རྡོ་རྗེའོ།",
    "རྣམ་པར་ཉིད་པའི་མཚན་ཉིད་དགའ་བྲལ་རྟོག་པ་འདི་ནི་ཟུར་ཐམས་ཅད་དེ།",
    "དེ་ཉིད་ཐམས་ཅད་རྟོགས་པར་བསྟན་ཏེ།",
    "ཅེས་གསུངས་པའོ།",
