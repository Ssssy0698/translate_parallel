    "གཡུང་མོ་ཞེས་བྱ་བ་ལ་ཇི་ལྟར་མཆོད་ཅེ་ན།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་སྟོན་ཀའི་ཟླ་བ་ཉ་བའི་གཟུགས་སུ་བསྒོམ་མོ།",
    "ས་བོན་འདི་ལྟ་བུ་ཧཱུྃ་གི་རྣམ་པར་སེམས་གྱུར་པ་དེ་ཉིད་སེམས་དཔའ་ཞེས་བརྗོད་དེ་ཞེས་བྱ་བ་ནི་ས་བོན་དུ་སྐྱེས་པ་དེ་ཉིད་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་གསུངས་པའོ།",
    "རྣམ་པར་སྤྲོ་བ་ཞེས་པ་ནི་རང་གི་ས་བོན་དེ་ཉིད་ལས་སོ།",
    "ཅི་སྤྲོ་ཞེས་པ་ནི་རང་གི་སྐུ་འདྲ་ཞེས་པ་སྟེ་དགྱེས་པའི་རྡོ་རྗེའི་སྐུ་ལྟ་བུ་སྟེ།",
    "འདི་དག་ཐམས་ཅད་རང་གི་སྔགས་ཀྱི་ས་བོན་ལ་གཅིག་ཏུ་གྱུར་པ་ནི་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་སོ།",
    "འཛིན་པར་བྱེད་ཅེས་པ་ནི་ཚིག་གི་ལྷག་མའོ།",
    "འདིར་ཤྭ་ས་ཏིའི་ཚིག་གི་དོན་རྣམ་པར་སྦྱར་བས་སོ།",
    "ཚིག་གོང་མ་ལ་འོག་གི་བ་མར་བསྒྱུར་ཏེ་བཏགས་ན་སྨའོ།",
    "ཡི་གེ་རྣམས་རྣམ་པར་བསྒྱུར་བའི་ངེས་པའི་ཚིག་གིས་དེ་རྣམས་ཀྱི་གནས་སུ་བྱ་བ་སྟེ།",
    "ཡང་གལ་ཏེ་རོའི་གནས་གནས་ཞེས་བྱ་བའི་རིགས་པ་འདིས་དུར་ཁྲོད་ལྟ་ཡིན་མོད།",
    "དེ་ལྟར་རེ་ཞིག་ཕྱག་གཉིས་པའི་དགྱེས་པའི་རྡོ་རྗེའི་རྣལ་འབྱོར་བཞི་གསུངས་ནས།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ཞེས་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་དེ་ཁོ་ན་ཉིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "སྙོམས་པར་འཇུག་པ་ཞེས་པ་ནི་དེས་གནས་པ་ཞེས་བྱ་བའི་ཚིག་གི་ལྷག་མའོ།",
    "ཁ་ཅིག་ན་རེ་ཕྱག་གཉིས་མའི་ཤེས་རབ་མ་ནི་གཡུང་མོ་ཡིན་པས་དེས་འཁྱུད་པས་སོ།",
    "ལྷ་མོ་རྣམས་ལ་ནི་ཅི་རིགས་པར་རོ།",
    "མ་མོ་བརྒྱད་ཀྱིས་ཞེས་པ་ནི་གོ་རཱི་ལ་སོགས་པ་རྣམས་ཀྱིས་སོ།",
    "སྤྱི་བོར་རང་གི་རིགས་ཀྱི་བདག་པོར་འགྱུར།",
    "ཉི་མའི་གུང་དང་སྲོད་ཀྱི་མཚམས་སུ་དགྱེས་པའི་རྡོ་རྗེའི་བདག་ཉིད་དུ་སྐད་ཅིག་གིས་བསྐྱེད་ལ།",
    "ལྷ་ནི་རང་གི་ལྷ་སྟེ།",
    "སྐད་ཅིག་སོ་སོ་ལ་ཡང་དེའི་ལྷག་པར་མོས་པར་བྱའོ།",
    "རེག་པ་པོ་ཡང་མེད་དེ་འདིས་ནི་སྐྱེ་མཆེད་བཅུ་པོ་གཟུགས་དང་མིག་ལ་སོགས་པ་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་ཁམས་ནས་ཇི་སྲིད་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་དུའོ།",
    "གལ་ཏེ་དེའི་ཚེ་གཉིས་ཀྱི་༢༤༢བ་ཚུལ་གྱིས་སྐྱེ་མཆེད་བཅུ་གཉིས་དང་གང་ཟག་ཀྱང་ཡོད་པ་མ་ཡིན་ན་གང་གི་ཚུལ་གྱིས་ཡོད་ཅེ་ན།",
    "གང་གི་ཕྱིར་དམ་པ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་ཡིན་ལ་དོན་ནི་དེའི་ཡུལ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྲིང་མོ་ཞེས་བྱ་བ་ནི་བྱམས་པ་བརྟན་པའོ།",
    "གཏུམ་མོ་ཞེས་པ་ནི་ང་རྒྱལ་བཅོམ་པ་དང་ངང་ཚུལ་ཞི་བའོ།",
    "བྲམ་ཟེ་མོ་ཞེས་པ་ནི་ཁ་ན་མ་ཐོ་བས་འཇིགས་པའོ།",
    "ངོམ་པ་དང་ཁྲོས་པས་དེའམ་གཡོག་གིས་གཞན་ལ་གསང་བ་སྨྲས་པས་གསང་གཏམ་ལས་ཉམས་པའོ།",
    "ཕྱག་རྒྱ་ཞེས་པ་ནི་གང་གིས་རྡོ་རྗེ་དང་པདྨ་ལ་སོགས་པ་འདི་དག་གི་རིགས་སུ་མཚོན་པར་བྱེད་པའོ།",
    "རྣམ་པ་གསུམ་དུ་བྱས་ཏེ་སྐུ་གསུང་ཐུགས་ཀྱི་དབྱེ་བ་ཞེས་གསུངས་པས་རང་གི་ལུས་དང་ངག་ཡིད་རྣམས་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་སུ་ལྷག་པར་མོས་ཤིང་དེ་ཁོ་ན་ཉིད་དུ་སྦྱོར་བ་སྟེ་གོ་སླ་བ་ཉིད་དེ།",
    "ལྔ་ཞེས་པ་ནི་རང་གི་ལུས་བྱུང་བ་ལྔ་སྟེ།",
    "ཞེས་པ་ནི་བདག་ཉིད་ཀྱི་ཕུང་པོ་ལྔ་ལ་ཡང་རིགས་ལྔར་ལྷག་པར་མོས་པར་བྱའོ།",
    "དེ་ལ་དམིགས་པའི་ཡང་དག་པའི་༢༤༤ཨ་ཡེ་ཤེས་བདེ་བ་ཆེན་པོའི་རང་བཞིན་ནི་འཁྲུལ་བའི་མཚན་མ་ཐམས་ཅད་ནུབ་པས་སྤྲོས་པ་མེད་པའོ།",
    "ཡང་དག་པའི་ཡེ་ཤེས་འདི་ཉིད་ཀྱི་ས་བོན་དང་བཅས་པའི་ཉོན་མོངས་པ་ཟད་དེ།",
    "མཆོག་ཏི་བདེ་བ་ཞེས་པ་ནི་ཟག་པ་མེད་པའི་མཆོག་གི་བདེ་བ་བསྟན་པ་ཉིད་ཀྱིས་སོ།",
    "གང་གིས་དེ་མི་ཤེས་པ་དེ་གཉིད་ལོག་པའོ།",
    "ཁྲུས་མཁན་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམས་ནི་བསྟན་པའོ།",
    "རང་གིས་ཞེས་པ་མངོན་སུམ་ལྟ་བུར་རོ།",
    "ཉམས་སུ་མྱོང་བའི་འཇིག་རྟེན་པའི་བདེ་བ་ལ་དེ་ཉིད་དུ་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་མོས་ཏེ།",
    "དེ་ལྟར་མོས་པའི་སྒོ་ནས་དམིགས་པ་དང་ལྡན་པར་བྱས་ཏེ།",
    "དེ་ལྟར་ཡུན་རིང་དུ་བསྒོམས་པའི་བདེ་བ་ཆེན་པོའི་འདིས་གང་གིས་ཞེས་པ་ནི་གནས་སྐབས་གང་གིས་འདིར་འཆི་བར་འགྱུར་རོ།",
    "འདིར་ནི་བདེ་བ་ཆེན་པོ་དེ་ལས་གཞན་དུ་ཕྱི་དང་ནང་གི་དམིགས་པ་སོ་སོར་མྱོང་བ་མེད་པས་འཆི་བ་སྟེ།",
    "ཤ་སྦྲང་ལ་སོགས་པས་ཟོས་པ་དང་ཐལ་ལྕག་དང་།",
    "རང་གིས་མྱོང་ཞེས་བྱ་བ་ནི་མངོན་སུམ་དུ་མྱོང་བའོ།",
    "ནང་གི་ནི་བདེ་བ་སྟེ་དོན་གྱི་ལྷན་ཅིག་སྐྱེས་པའོ།",
    "གང་གིས་འགྲོ་ཞེས་པ་ནི་རྟགས་གང་གིས་ཤེས་པར་བྱེད་པའོ།",
    "ཅེས་པ་ནི་རིགས་ནི་མི་མཐུན་པ་ནི་དད་པའི་སྲོག་ཆགས་ནི་རང་རང་གི་དབྱིངས་ཐ་དད་པས་དབྱེ་སྟེ།",
    "དེ་ལྟར་ན་འདི་ཐམས་ཅད་དོན་དམ་པར་རང་བཞིན་ཡོངས་སུ་དག་པར་མཉམ་པ་ཉིད་ཀྱི་དེ་ཁོ་ན་ཉིད་དུ་ལྷག་པར་མོས་པ་སྟེ།",
    "རྡོ་རྗེ་བུ་མོ་ནི་དེའི་རིགས་རྣམས་ཀྱི་ནང་ནས་ཕུལ་དུ་བྱུང་བ་ཉིད་དེ་གཞན་གྱིས་མི་སྤྱོད་པའི་ཕྱིར་ཞེས་བྱ་བར་དགོངས་སོ།",
    "གཞན་གྱི་རིགས་བྱུང་ཞེས་བྱ་བ་ནི་རང་གི་ཡི་དམ་གྱི་ལྷ་ལས་གཞན་དེའི་རིགས་ལས་བྱུང་བའོ།",
    "སྔགས་ཀྱི་དག་པ་ཞེས་པ་ནི་སྔགས་སུ་མོས་པའི་གླུ་སྟེ་གླུར་བླངས་པའོ།",
    "ཐལ་བ་ནི་ཐལ་བས་བྱུགས་པས་སོ།",
    "ཞེས་པ་ནི་གནས་སྐབས་ཐམས་ཅད་དུ་དགྱེས་པའི་རྡོ་རྗེར་མོས་པས་སོ།",
    "དགྱེས་པའི་རྡོ་རྗེ་ཉིད་དུ་ལྷག་པར་མོས་པ་བརྟན་པར་སྦྱོར་ན་ཕྱིའི་སྦྱིན་སྲེག་ལ་སོགས་པ་སྤང་ངོ།",
    "རྐང་པའི་རི་མོ་ཉིད་དཀྱིལ་འཁོར་རོ།",
    "དེ་ཡང་དམ་ཚིག་གི་ཡན་ལག་ཉིད་ཀྱིས་ན་ཤེས་པར་བྱའོ།",
    "སྲིང་མོ་ཞེས་པ་ནི་རྣལ་འབྱོར་མའོ།",
    "སོར་མོ་གཅིག་ཅེས་པ་ནི་ལེགས་པར་འོངས་སམ་ཞེས་པའི་དོན་ཏོ།",
    "གཉིས་ཞེས་པ་ནི་སོར་མོའོ།",
    "མཛུབ་མོ་ཞེས་པ་ནི་སྡིགས་མཛུབ་བོ།",
    "ཐོད་བསྟན་པར་བྱ་ཞེས་པ་ནི་མཐེའུ་ཆུང་དང་སྲིན་ལག་གཉིས་མཐེ་བོས་མནན་ནས་སོར་མོ་ལྷག་མ་རྣམས་ཀྱིས་ཐོད་ལྟ་བུར་སྟོན་པའོ།",
    "མཚམས་ཞེས་པ་ནི་དཔྲལ་བའི་དབུས་ཀྱི་སྟེང་གི་མཚམས་ཀྱི་མཐའོ།",
    "ཕྱག་རྒྱ་ཞེས་པ་ནི་སོར་མོ་གཅིག་ལ་སོགས་པ་སྟོན་པའོ།",
    "ཕྱག་རྒྱའི་ལན་ཞེས་པ་ནི་སོར་མོ་གཉིས་ལ་སོགས་པ་སྟོན་པའོ།",
    "དམ་ཚིག་གིས་ནི་ཞེས་པ་ནི་བརྡས་སོ།",
