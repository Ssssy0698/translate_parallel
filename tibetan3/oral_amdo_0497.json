    "ཁྱོད་ཀྱིས་འདི་སྤོངས་ཤིག་ཅེས་སྨུ་བར་བྱའོ།",
    "དེ་ནས་ལུས་ཀྱི་ལྷ་ལ་སོགས་པ་ཁྱེར་ནས་རང་གི་སྐུ་གསུང་ཐུགས་གསུམ་ལ་ཐིམ་པར་བསམ་པར་བྱའོ།",
    "ཁྲོ་བོ་དཔག་ཏུ་མེད་པས་༢༡༩ཨ་མཚོན་ཆ་དཔག་ཏུ་མེད་པ་བཟུང་ནས་གཅོད་པ་ལ་སོགས་པ་བྱེད་པར་བསམ་པར་བྱའོ།",
    "ལྟེ་བ་ལ་གནས་པའི་པདྨ་ཡང་བསྲེགས་ནས་ཐལ་བར་གྱུར་པར་བསམ་པར་བྱའོ།",
    "དེས་བསྲེགས་པས་ཐལ་བར་གྱུར་པར་བསམ་པར་བྱའོ།",
    "རེངས་པར་བྱེད་པ་ལ་སེར་པོར་བསམ་པར་བྱའོ།",
    "རེངས་པར་བྱེད་པ་ནི་ངན་པའི་སེམས་བྱའོ།",
    "སྐྱེད་མོས་ཚལ་ཞེས་བྱ་བ་ནི་དམ་ཚིག་མེད་པའི་མི་མི་གནས་པ་རྣལ་འབྱོར་པའི་ཡིད་དུ་འོང་བ་ལ་ནི་སྐྱེད་མོས་ཚལ་ཞེས་བྱའོ།",
    "ནང་གི་ཉི་མ་ལ་སོགས་པས་ཤེས་རབ་ཇི་ལྟར་དགའ་བ་བཞིན་དུ་བྱའོ།",
    "ཡང་ན་འོག་ཅེས་བྱ་བ་ནི་ཐུན་མོང་གི་དངོས་གྲུབ་པོ།",
    "སྟེང་དུ་ཞེས་བྱ་བ་ནི་ཐུན་མོང་མ་ཡིན་པའི་དངོས་གྲུབ་པོ།",
    "རྡོ་རྗེ་རྩེ་གཉིས་པ་དང་མེ་ཏོག་གི་ཏིང་ངེ་འཛིན་ལ་གནས་ལ།",
    "དེ་ཡང་རང་གིས་གོ་བ་དང་ཉོན་མོངས་པ་མེད་པའི་བདེ་བའི་རང་བཞིན་ནོ།",
    "དེ་ཡི་དགེ་རྩ་བདག་གིས་གང་ཐོབ་པས།",
    "གཞན་དག་ན་རེ་རྒྱུད་ཆེན་པོ་ལས་རྟོག་པ་གཉིས་པ་འདི་བཏུས་ཏེ།",
    "གཞན་ནི་འདི་གསང་ཆེན་མཆོག་གི་དོན་གཞན་ཡིན་ནོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་སོ།",
    "འགྱུར་བས་དེ་གཉིས་གསལ་བའི་ཕྱིར་འདི་སྐད་བདག་གིས་ཞེས་ཚིག་གཉིས་སྨོས་སོ།",
    "དེ་ལ་བདག་གིས་ཞེས་པ་ནི་བདག་གིས་སྟོན་པ་པོ་ཉིད་ལས་ཐོས་པ་ཡིན་གྱི་ཐོས་པ་གཞན་དང་གཞན་ལས་འོངས་པ་མ་ཡིན་པའོ།",
    "འདི་ཁོ་ན་སྐད་བདག་གིས་ཐོས་ཀྱི་གཞན་དུ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྗེས་སུ་མཐུན་པའི་གནས་སུ་རེས་འགའ་སྟོན་པ་པོ་བཞུགས་པ་དང་།",
    "གང་གི་ཕྱིར་གསང་བ་གསུམ་བསྡུས་པ་དེའི་ཕྱིར་གྲུ་གསུམ་མོ།",
    "གང་གི་ཕྱིར་གོང་ནས་གོང་དུ་ཡངས་པ་ནི་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་རིམ་པས་རྣམ་པར་དག་པ་དེའི་ཕྱིར་གོང་ནས་གོང་དུ་ཡངས་པའོ།",
    "དེ་ཉིད་རྡོ་རྗེ་བཙུན་མོ་སྤྱན་ལ་སོགས་པའི་བྷ་ག་སྟེ།",
    "རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་ཡང་དེ་ཡིན་པས་དེ་སྐད་ཅེས་བྱ་སྟེ་ཁྱབ་པར་བསྡུ་བའོ།",
    "རྗེ་བཙུན་ཞེས་བྱ་བ་ནི་མཆོག་གི་ལྷ་སྟེ།",
    "ཚིག་འདིའི་མཐར་ཡང་སྔ་མའི་ཚིག་ལས་འདི་ཞེས་བྱ་བའི་སྒྲ་བླངས་ལ་སྦྱར་ཞིང་རང་གི་དོན་ཡང་རྟོགས་པར་བྱ་སྟེ།",
    "དྲིས་ཚིག་གསུམ་ཇི་ལྟ་བ་བཞིན་དུ་ལན་གསུམ་མོ།",
    "དེ་ལ་སྲིད་པ་གསུམ་ཉིད་སྲིད་པ་གསུམ་མོ།",
    "གང་ལས་དེ་ནམ་ཡང་འཇིག་པ་མ་ཡིན་པས་རྒྱུན་དུ་འབྱུང་ཞིང་འཁོར་མོར་ཏེ་རྟག་པར་འབྱུང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷག་མ་ཕྱིས་པས་ངེས་པའི་ཚིག་གིས་སོ།",
    "དྲི་ཚིག་གཞན་གསུམ་མོ་ཅིའི་དོན་དུ་ཞུས་ཤེ་ན།",
    "གང་གིས་ཞེས་པ་ནི་གང་གིས་ཚིག་རྣམ་པར་སྦྱར་ཞེས་པའོ།",
    "ཅེས་དཔལ་རྡོ་རྗེ་རྩེ་མོ་ལས་གསུངས་སོ།",
    "གང་གིས་ན་འདི་དང་པོར་ཡིན་ཞེ་ན།",
    "ཁམས་གསུམ་པ་འདི་ནི་སེམས་ཙམ་མོ་ཞེས་གསུངས་སོ།",
    "གང་གི་ཕྱིར་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པ་གསལ་བར་སྣང་བས་རྣམ་པར་ཤེས་པ་ལས་ཕྱི་རོལ་གྱི་དོན་དུ་མེད་དོ།",
    "རྡུལ་ཕྲ་མོ་དུ་མ་ཡང་མ་ཡིན་ཏེ།",
    "ནང་གི་དངོས་པོར་ཡོད་པ་མ་ཡིན་ཏེ་གཅིག་དང་དུ་མའི་རང་བཞིན་དང་བྲལ་བས་སྔ་མ་བཞིན་ནོ།",
    "སྣང་བ་དེ་ཉིད་ལ་འཇིག་རྟེན་པས་མཚན་མའི་རྣམ་པར་དམིགས་ནས་གཉིས་སུ་བརྟགས་ཤིང་གཉིས་སུ་བཟུང་བས་སྡུག་བསྔལ་ཐམས་ཅད་ཀྱི་རྒྱུར་གྱུར་པ་ཇི་སྲིད་གང་གིས་རྣམ་པར་སྣང་བ་འཇུག་པ་དེ་སྲིད་དུ་དོན་དམ་པའི་བདེན་པ་མཐོང་བ་མ་ཡིན་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གཅིག་པུས་གྲོལ་བ་ནི་མྱུར་བ་ཉིད་དུ་ཉོན་མོངས་པ་རྣམས་སྤངས་ཏེ་དགྲ་བཅོམ་པ་ཉིད་དུ་བྱེད་དོ།",
    "དེ་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཉིད་ཀྱིས་གྲོལ་ཏེ་གཅིག་གིས་མ་ཡིན་ནོ།",
    "དེས་བཅིངས་ཏེ་གྲོལ་བ་རྣམས་ཀྱང་དེ་དང་དེ་རྣམས་ཀྱི་སྟོབས་ཀྱིས་འགྲོ་བ་ཐམས་ཅད་ཀྱི་དོན་གྱི་རྒྱུད་སྐུ་གསུམ་གྱི་ནམ་མཁའི་མཐར་ཐུག་གི་བར་དུ་གནས་སོ།",
    "ཞེས་པ་ནི་བདག་གི་ཡེ་ཤེས་དངོས་པོ་ཐམས་ཅད་དུ་སྣང་བའོ།",
    "གང་གི་ཕྱིར་ལུས་ལས་མ་སྐྱེས་ཤེ་ན།",
    "སེམས་ཙམ་ནི་རྣམ་པར་རིག་པ་ཙམ་མོ།",
    "སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་གཞུང་གིས་ཀྱང་ཡེ་ཤེས་ཀྱི་རྣམ་པ་བདེན་པ་ཉིད་དུ་རྣམ་པར་ཤེས་པར་བཞེད་པ་ཡིན་ཞེ་ན།",
    "ཞེས་པ་ནི་གང་གི་ཕྱིར་བརྫུན་པ་ཉིད་དེ།",
    "དེ་དང་དེའི་རང་གི་ངོ་བོ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཕྲ་མོ་མ་ལུས་པའི་ཧཱུྃ་དང་དབྱངས་དང་ཟླ་བ་དང་ཐིག་ལེ་མེད་པ་དང་།",
    "ཐིག་ལེ་ཡུངས་ཀར་གྱི་འབྲུ་ཙམ་གྱི་ཕྲ་མོ་དང་།",
    "དེ་བྱིན་གྱིས་བརླབས་པས་རང་གི་ལུས་ཉིད་རྣལ་འབྱོར་པའི་རྡོ་རྗེའི་ལུས་སོ་དེ་ཉིད་དེའི་རྟེན་གྱི་དཀྱིལ་འཁོར་རོ།",
    "བཟང་མོ་གཡོན་པ་མ་གཉིས་གང་།",
    "མ་མོ་དང་ནི་ས་བ་རི།",
    "དེ་གཉིས་དག་ནི་གཏུམ་མོའོ།",
    "གཉིས་ཀ་གཡུང་མོར་འདོད་པའོ།",
    "གཟུགས་བཟང་མ་དང་ཐུན་མོང་མ།",
    "ཐུབ་པས་རྐུན་མོར་གསུངས་པའོ།",
