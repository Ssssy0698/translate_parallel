    "མི་མཉམ་པ་དག་ཏུ་རྣམ་པར་སྤྲོས་ཤིང་ནམ་མཁའི་དབྱིངས་ཀྱིས་མཐའ་ཀླས་པར་ཁྱབ་ཅིང་རྒྱས་སོ།",
    "དགྱེས་པའི་འོད་ཟེར་གྱིས་ཡེ་ཤེས་ཀྱི་ཆོ་འཕྲུལ་ཡན་ལག་བདུན་རྣམ་པར་བཀོད་པས་དྲེགས་བྱེད་ཀྱི་ཚོགས་ཐམས་ཅད་རབ་ཏུ་འཇིགས་པར་མཛད་དེ།",
    "ཡང་འཁོར་གྱི་དྲེགས་བྱེད་གཞན་རྣམ་པར་འཇོམས་པའི་བཀོད་པའི་ཡན་ལག་བདུན་རྣམ་པར་བསྟན་ཅིང་།",
    "དེ་དང་མཐུན་པའི་གདུལ་བྱ་དེ་ཉིད་རབ་ཏུ་གཞོམ་པར་མཛད་དོ།",
    "ཞི་བའི་ཕྲིན་ལས་ཀྱིས་གཞན་དག་རྣམས་ཀྱང་ཕྲིན་ལས་རྒྱ་ཆེན་པོ་ལ་རྣམ་པར་སྦྱོང་ཞིང་།",
    "དེ་ལྟར་རིགས་ཀྱི་དཀྱིལ་འཁོར་གཞན་ཡང་རྣམ་པར་དབྱེ་སྟེ།",
    "དབུགས་དབྱུང་བ་བསྡུས་པའི་རིམ་པ་སྟེ་རྒྱ་ཆེར་སྤྲོས་པ་ནི་རྒྱས་པའི་ཚུལ་དུ་ཤེས་པར་བྱའོ།",
    "རུ་ཏྲ་ལ་སོགས་པའི་གདུལ་བྱ་སྤྱི་དང་ཁྱད་པར་གྱི་ལམ་པ་རྣམས་ཏེ།",
    "ཐམས་ཅད་བདག་ཉིད་འཇུག་པར་བྱེད།",
    "གང་ཞིག་བདག་དང་གཞན་གྱི་དོན་བསྒྲུབ་པར་བྱ་བ་ཐམས་ཅད་ཀྱི་ལམ་དུ་བྱ་བ་ནི།",
    "གནས་དང་དུས་ལ་སོགས་པའི་བྱེ་བྲག་བཞིན་དུ་ཤེས་པར་བྱས་ལ།",
    "ཡིད་བདེ་བའི་ངོ་བོ་ཉིད་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པའི་སྟེན་གནས་སུ་གྱུར་པ་འདིས་སྒྲུབ་པར་འགྱུར་བའོ།",
    "དེ་ཉིད་ཚོགས་ཀྱིས་གྲུབ་པར་བྱེད།",
    "བསྒྲུབ་བྱས་ལས་ཀྱི་རིམ་པ་དག།",
    "ལེགས་སྨིན་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "ལེའུ་དྲུག་པར་གསུངས་པ་ཡིན་ཏེ།",
    "གྲུབ་པའི་རིམ་པ་དག་ནི་སོ་སོའི་ཆོ་ག་ལས་ཞེས་པར་བྱའོ།",
    "རྡོ་རྗེ་ལྟ་བུའི་གནས་ལ་བཞུགས།",
    "ཐམས་ཅད་བདག་ཉིད་རྟག་ཏུ་བཞུགས།",
    "ལོངས་སྤྱོད་བཞིའི་དགྱེས་པས་འཁོར་ལོ་ཐམས་ཅད་ཀྱི་བདག་ཉིད་དུ་འཕྲོ་འདུ་མཛད་པའི་ལས་ལ་རྟག་ཏུ་བཞུགས་པའོ།",
    "བདེ་ཆེན་གསང་བའི་གནས་བཞུགས་ཏེ།",
    "ལས་མཛད་འཕྲོ་འདུས་རྟག་ཏུ་བཞུགས།",
    "གླུ་དང་སིལ་སྙན་རྣམ་པར་སྤྲུལ།",
    "མར་མེ་དྲི་ལ་སོགས་ལྡན་པར།",
    "ག་པུར་ལ་སོགས་པའི་རྫས་ཁྱད་པར་ཅན་དག་ཀྱང་གཞག་པར་བྱའོ།",
    "དྲི་ཆུ་རྣམས་ཀྱང་སོ་སོའི་གནས་རྣམས་སུ་དགྲ་མ་པར་བྱའོ།",
    "ཞལ་ཟས་དག་ཀྱང་གནས་བརྒྱད་དུ་དགྲམ་པར་བྱའོ།",
    "དེ་དག་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ཆོ་ག་ནི་སྒྲུབ་ཐབས་ལས་ཞེས་པར་བྱའོ།",
    "རིགས་བསྡུས་པའི་དཀྱིལ་འཁོར་གྱི་སྒོ་ནས་བརྩམ་པར་བྱ་བ་དང་།",
    "རིགས་ཀྱི་དཀྱིལ་འཁོར་རིམ་བཞིན་པའི་སྒོ་ནས་བརྩམ་པར་བྱའོ།",
    "དེར་བསྒྲུབ་པར་བྱ་བའི་ལས་བྱ་བ་ལ།",
    "དཀྱིལ་འཁོར་གང་ཡང་རུང་བའི་སྒོ་ནས་ལྷའི་གྲངས་བཞིན་དུ་རྣལ་འབྱོར་པ་དུ་ཡོད་པས་སོ་སོའི་གདན་དུ་ཡོད་པ་ལ་གནས་པར་བྱའོ།",
    "རས་དེ་ཉིད་པདྨས་མཚོན་པར་བྱའོ།",
    "ཕག་རྒྱའི་ཆ་ལུགས་གནས་པར་བྱ།",
    "གནས་སུ་བཏབ་སྟེ་གཞག་པར་བྱ།",
    "དེ་ལྟར་སྔོན་དུ་འགྲོ་བའི་ཡན་ལག་དང་ལྡན་པ་དེས་ནི་ཚོགས་ཀྱི་འཁོར་ལོའི་རིམ་པ་ལ་འཇུག་པར་བྱ་སྟེ།",
    "དེ་ནས་རྣམ་པར་འཕུལ་བར་མཛད།",
    "དཔའ་བོ་ཡབ་ཡུམ་གྱི་དཀྱིལ་འཁོར་གྱི་སྒོ་ནས་ལྷ་སུམ་ཅུ་པོ་དག་རྣམ་པར་འཕྲུལ་བའོ།",
    "ཡང་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་འཕྲུལ་བའི་ཕྱིར།",
    "རྒྱབ་མ་ཆགས་འཛད་དམར་པོའི་ཞལ་གཡོན་པ་རྨོངས་མཛད་སེར་པོར་བཞུགས་པ།",
    "འཇིགས་པར་བྱེད་པ་དང་།",
    "ཞལ་བཞི་ཕྱག་བརྒྱད་ན་མདའ་དང་གཞུ་འགེངས་པ་ལས་ཚངས་པའི་མགོ་བོ་བཞི་སྦྱངས་པ་གཡོན་བརྐྱང་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "ཁ་ཊྭཱཾ་ག་ལ་བརྟེན་བཅས་ནས་ཞབས་གཡས་པ་བཏེག་པའི་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "གཡས་བརྐྱང་བའི་སྟབས་ཀྱིས་བཞུགས་ཤིང་རྨོངས་བྱེད་ཀྱི་མདངས་དང་ལྡན་པའོ།",
    "གཡོན་ན་མེ་ཐབ་འཛིན་པ་གཡོན་བརྐྱང་བའི་གར་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "གཡོན་གཉིས་ཀྱིས་ཐོད་པ་དང་ཞགས་པར་བཅས་པ་ཁ་ཊྭཱཾ་ག་སེ་རལ་ཁར་ཐོགས་པའོ།",
    "ཕྱག་ལྔ་བཅུ་ཕྲག་གཉིས་ཞབས་ཉི་ཤུ་རྩ་བཞིས་མཛེས་པར་པདྨའི་དཀྱིལ་འཁོར་ལ་བཞུགས་པ།",
    "ཡང་རྡོ་རྗེ་ཉི་མའི་དཀྱིལ་འཁོར་རྣམ་པར་འཕྲུལ་བའི་ཕྱིར།",
    "གདན་པདྨའི་དཀྱིལ་འཁོར་ལ་བཞུགས་ཤིང་ཡུམ་མཱ་མ་ཀཱི་དང་གཉིས་སུ་མེད་པར་འཁྲིལ་བའོ།",
    "ཁྱད་པར་གྱི་རྟགས་ཀྱིས་རྣམ་པར་སྤྲས་པའོ།",
    "མདུན་དུ་རང་འོད་ཀྱི་སྣང་བ་ཡུམ་དམ་ཚིག་སྒྲོལ་མ་དང་ཞལ་སྦྱོར་གྱི་ཚུལ་དུ་འཁྲིལ་ནས་བཞུགས་པའོ།",
    "དེ་ལྟར་བརྟེན་པའི་ལྷའི་དཀྱིལ་འཁོར་རྣམས་ཀྱི་བཞུགས་གནས་ལྷའི་གཞལ་ཡས་ཁང་ཇི་ལྟ་བུ་ཞེ་ན།",
    "རྟ་བབས་བཞི་ཡིས་མཛེས་པར་བྱས།",
    "སྒོ་སྲུང་དང་ནི་ལྡན་པར་བྱ།",
    "ཅེས་པ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་དྲུག་གསུངས་ཏེ།",
    "དངོས་གྲུབ་ཀྱི་རྫས་ཁྱད་པར་ཅན་ལ་བརྟེན་ནས་འདོད་པའི་དོན་སྒྲུབ་པའི་ཕྱིར་བདུད་རྩི་ལྔ་གྲོགས་དང་བཅས་པ་ལས།",
    "ཚིགས་སུ་བཅད་པ་བཞི་པས་དེ་ཉིད་ཀྱི་མཚན་ཉིད་ངེས་ཚིག་དང་བཅས་པར་བསྟན་པ།",
    "ཞེས་པ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གསུམ་གསུངས་ཏེ།",
    "འདིས་ནི་བསྲུང་བ་བྱས་པས་དཔལ།",
    "བསྲུང་བ་བྱས་པས་དེ་ཉིད་དུ་རིགས་རྣམ་པ་ལྔའི་སྐུ་གསལ་ཞིང་འགྲུབ་པར་འགྱུར་བ་དང་ཁོང་དུ་ཡང་འཐུངས་ཤིང་གནས་གསུམ་དུ་ཡང་བྱུགས་པས་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་དྲི་མ་གསུམ་དང་བྲལ་བའི་སྐུ་འགྲུབ་པར་འགྱུར་རོ།",
    "གནས་རྣམས་ཀུན་དུ་བརྒྱན་བྱས་པས།",
    "དེ་ནས་ཁྲུས་བྱས་དྲི་ཞིམ་ལུས།",
    "དེ་ལ་ཁ་དྲི་ཞིམ་པོར་བྱས་པའི་སྤོས་ནི་ལེའུ་དགུ་པ་ལས།",
    "གཏམ་གྱིས་འདྲིས་པར་བྱ་བ་དང་།",
    "དེ་ལས་བྱུང་བའི་བདེ་བ་ཆེན་པོས་ཐབས་དང་ཤེས་རབ་ཀྱི་རྒྱུད་རིམ་པར་གྱུར་ནས་དཀྱིལ་འཁོར་གསལ་བ་དང་།",
    "རྣམ་པར་འདས་པས་རྣམ་པར་བརྒྱན།",
    "ལེགས་པའི་ལམ་ཀུན་དང་ལྡན་པའི་ཆེ་བའི་ཡོན་ཏན་རྣམ་པར་བཀོད་པ་ཀུན་གྱིས་བརྒྱན་པར་འགྱུར་རོ།",
    "ཡོད་མེད་གཉིས་ཀྱི་ངོ་བོར་བཞུགས་པ་ཡིན་ཏེ།",
    "བདེ་བ་ཆེན་པོའི་རང་བཞིན་དུ་བཞུགས་པའོ།",
    "དེ་ལྟ་བུའི་བདེ་བར་གཤེགས་པ་ལ་བཞེངས་བཞུགས་མི་མངའ་ཡང་།",
    "ཤིན་ཏུ་མྱ་ངན་ཡོངས་འདས་པར།",
    "རྣམ་པར་འདས་པས་མཛེས་པར་བྱས།",
    "རང་ཉིད་ཀྱི་སྣང་བ་རྣམ་པར་འདས་པས་མཛེས་པར་བྱས་པའི་གླུས་བསྐུལ་བར་བྱས་པའོ།",
    "གདུང་བ་རྣམ་པར་སེལ་བྱེད་ཅིང་།",
    "སྣ་ཚོགས་ཕྲིན་ལས་རྣམ་པར་སྦྱོར།",
    "བསྒྲུབ་པར་བྱ་བའི་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་ནང་ན་མཆོག་ཏུ་གྱུར་པས་ཡོན་ཏན་ཐམས་ཅད་ལ་སྦྱོར་བར་བྱེད་པས་སྣ་ཚོགས་འབྲང་བའོ།",
    "དེ་རབ་ཏུ་གྲུབ་པས་ནི་འཇིག་རྟེན་གསུམ་གྱི་གནས་ཐམས་ཅད་ཟིལ་གྱིས་མནན་ཅིང་ཡོན་ཏན་གྱི་སྣང་བ་ཐམས་ཅད་སྐད་ཀྱི་རྒྱུད་ལ་སྟོན་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་གསུམ་གྱིས་ཕྱག་བྱས་པ།",
    "འཇིག་རྟེན་གསུམ་དུ་སྐུའི་བཀོད་པ་རྣམ་པར་སྤྲོ་བ་མཛད་ཅིང་ཀུན་གྱི་ཕྱག་གནས་སུ་གྱུར་བ།",
    "ཧེ་རུ་ཀའི་ཡོན་ཏན་གྱི་འབྲས་བུ་དག་མངའ་བརྙེས་པར་དྲག་པོ་ཆེན་པོའི་སྐུ་སྟོན་ཅིང་།",
    "འཇིག་རྟེན་གསུམ་གྱི་དྲེགས་བྱེད་རུ་ཏྲ་ལ་སོགས་པའི་ཚོགས་རྣམས་འཇོམས་པར་མཛད་པ་དང་།",
    "འཇིག་རྟེན་གསུམ་གྱི་འདོད་པར་བྱ་བ་ཨ་ར་ལླིའི་ངོ་བོར་རྣམ་པར་འགྲུབ་པའོ།",
    "ཞེས་པ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་ཕྱེད་དང་གསུམ་གསུངས་ཏེ།",
    "དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་ཀྱི་ཡོན་ཏན་གྱིས་རྣམ་པ་ལ་དམིགས་ཤིང་སྦྱོར་བར་བྱེད་པའི་གླུ་འདི་ལན་ཅིག་བླངས་པ་ཙམ་གྱིས་ཀྱང་བདེ་བ་གཉིས་ཀྱི་དངོས་གྲུབ་འབྱུང་ཞིང་སྐུ་གསུང་ཐུགས་བརྟན་པར་འགྱུར་བ་དང་གྲུབ་པ་སློང་བར་བྱེད་དོ།",
    "མཆོག་ཏུ་རྟག་པའི་རྣལ་འབྱོར་བདེ་བས་བདེ་བསྒྲུབ་པར་མཛོད།",
    "ཆགས་པ་རྣམ་པ་གཉིས་དང་ལྡན་ཞིང་སྦྱོར་བའི་བདེ་བ་ལ་ལོངས་སྤྱོད་པས་ཡོན་ཏན་གྱི་རྣམ་པ་མང་པོ་གྲུབ་པར་མཛད་དེ།",
    "གཉིས་དང་གཉིས་འཁྱུད་པའི་རྣམ་པས་བདེ་བ་ཆེན་པོ་མཚོན་པར་བྱེད་པ་བྷག་དང་ལིངྒའི་མཚན་མ་དགའ་བའི་པདྨ་སྟེ།",
    "མཆོག་ཏུ་རྟག་པར་རྒྱུན་མི་ཆད་པའི་རྣལ་འབྱོར་བའི་བདེ་བ་གྲུབ་པར་མཛོད་ཅེས་པའོ།",
    "སྐལ་བཟང་མཆོག་ལ་དགྱེས་པར་གནས་པ་དང་།",
    "འགྲོ་བའི་རྒྱུད་ནི་རྣམ་པ་སྣ་ཚོགས་གདུལ་བ་གསལ་བར་མཁྱེན།",
    "རྒྱལ་བ་ཀུན་གྱི་བདག་ཉིད་རྣལ་འབྱོར་བདེ་བའི་དབྱིངས་ནས་མཁའ་འགྲོ་བདེ་བའི་དཀྱིལ་འཁོར་སྟོན་པར་མཛད་པའོ།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "རྟག་ཏུ་བརྗོད་པས་བདེ་བར་གཤེགས་པའི་ཡོན་ཏན་ཐམས་ཅད་རྒྱུད་ལ་སྦྱོར་ཞིང་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ལན་ཅིག་ཙམ་བརྗོད་པས་ཀྱང་སོ་སོའི་ལས་འགྲུབ་པར་བྱེད་ན་གྲངས་བཞིན་དུ་བསྙེན་པ་དང་།",
    "ལས་དག་འགྲུབ་པར་བྱེད་དོ།",
    "དགའ་བ་ཆེན་པོས་མཉེས་པར་མཛད།",
    "ཐིག་ལེ་གནས་སུ་མཚན་བྱས་ནས།",
    "མ་ལུས་ལུས་པ་མེད་པར་འགྲུབ།",
    "རྣམ་པར་འཕྲུལ་པའི་སྐུ་སྣ་ཚོགས་སུ་སྣང་བ་དག་གསལ་བར་སྟོན་ཅིང་ཡོན་ཏན་གྱི་རྣམ་གྲངས་ཐམས་ཅད་གསལ་བར་རྫོགས་པའོ།",
    "རྣམ་པར་སྤྲུལ་པས་འགྲུབ་པར་འགྱུར།",
    "གར་དང་རྣམ་པར་འགྱུར་བའི་གླུ་དབྱངས་ཀྱིས་ཕྱོགས་བཅུར་འཁྲིགས་པར་སྤྲོ་ཞིང་བསྡུ་སྟེ།",
    "བདེ་བ་ཡང་དག་སྒྲུབ་པར་བྱེད།",
    "ཕྲིན་ལས་ཀྱི་ལྷ་དག་ནི་ཞར་ལས་བྱུང་བའི་འཕྲུལ་པ་ཡིན་པས་ཤུགས་ཀྱིས་ཤེས་པར་བྱའོ།",
    "རྡོ་རྗེ་སེམས་དཔར་མཉམ་སྦྱོར་བའོ།",
    "དཀྱིལ་འཁོར་རྣམ་པར་བཀོད་པ་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའི་ཆ་ལུགས་གཉིས་དང་མཉམ་པར་སྦྱོར་ཞིང་དངོས་གྲུབ་ཀུན་གྱི་བདེ་བ་དག་མཐོང་ཞིང་དཀྱིལ་འཁོར་རྣམ་པ་གཉིས་མཐོང་བར་འགྱུར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔར་མཉམ་སྦྱོར་བའི།",
    "ཚིག་སུ་བཅད་པ་གསུམ་གསུངས་ཏེ།",
    "དེས་ན་ཆེ་བའི་ཡོན་ཏན་འདོད་པའི་ལོངས་སྤྱོད་ཐམས་ཅད་ཀྱི་གནས་ལ་བཞུགས་པའི་དངོས་གྲུབ་ཆེན་པོ་གསལ་བར་འགྱུར་རོ།",
    "གཉིས་མེད་དཀྱིལ་འཁོར་མཉེས་བྱས་ནས།",
    "རྟོགས་པར་བྱ་བ་ཐམས་ཅད་ཀུན།",
