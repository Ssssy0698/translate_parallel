    "ཕྱག་ན་སྐུ་འཁོར་དང་བཅས་པ་ས་སྐྱ་ནས་ཆིབས་ཁ་བསྒྱུར་ཏེ་ཧོར་ཡུལ་དུ་ཕེབས།",
    "ལྷ་སར་འབྱོར་སྐབས་འཕགས་པ་ཇོ་བོའི་སྐུ་མདུན་དུ་རབ་ཏུ་བྱུང་།",
    "དེ་ནས་འགྲོ་མགོན་འཕགས་པ་དཔོན་འཁོར་དང་བཅས་པ་ཐད་ཀོར་ལེང་ཀྲའུ་ལ་ཕེབས་པ་དང་།",
    "ས་སྐྱ་པཟློ་ཏས་ལམ་བར་ལུགས་གཉིས་ཀྱི་བྱེད་སྒོ་རྒྱ་ཆེར་སྤེལ་ནས་ཕེབས་ལམ་དུ་ལོ་གཉིས་ཙམ་འགོར་འགྱངས་བྱུང་།",
    "བོད་འདི་མེས་རྒྱལ་གྱི་མངའ་ཁོངས་སུ་དངོས་སུ་སྒྱུར་རྒྱུའི་སྐོར་ལ་ཧོར་གོ་དན་རྒྱལ་པོ་དང་བཀའ་གྲོས་ལེགས་པར་མཛད།",
    "ལྷག་པར་དུ་དགུང་ལོ་དྲུག་ཅུ་ལྷག་ཙམ་དུ་ཕེབས་ཟིན་པའི་རྗེས་སུ་དཀའ་ངལ་གང་ལའང་མ་འཛེམས་པར་བོད་མི་དམངས་ཀྱི་བསམ་འདུན་ལྟར་མེས་རྒྱལ་གོང་བུ་གཅིག་གྱུར་ཡོང་བའི་ཆེད་དུ་དངོས་སུ་ལེང་ཀྲོའུ་དུ་ཕེབས།",
    "ཡོན་གོང་མས་ལས་ཞྭ་ནག་པོ་ཞིག་གནང་བས་ཕྱིས་རྐརྨ་བཀའ་བརྒྱད་ཞྭ་ནག་པ་ཞེས་གྲགས།",
    "དཔོན་རིགས་ལ་ལས་འགྲོ་མགོན་འཕགས་པའི་མཚན་འཁྱེར་ནས་དཔོན་ཆེན་ཀུན་དགའ་བཟང་པོས་གོང་མ་དང་འགྲོ་མགོན་འཕགས་པ་ལྷག་བསམ་རྣམ་དག་མེད་ལུགས་དབྱིན་སྦྱོར་མང་ཙམ་བྱས་སྟབས།",
    "དེ་རྫུན་རྐབ་རྡོལ་ཡོང་སྙམ་ནས་འགྲོ་མགོན་འཕགས་པར་དུག་བཏང་ནས་བཀྲོངས་ཟེར།",
    "ཀརྨ་པ་རང་བྱུང་རྡོ་རྗེས་ལྷ་སྟེང་བཏབ།",
    "བདག་ཆེན་བཟང་པོ་དཔལ་ས་སྐྱའི་གདན་སར་ཕེབས།",
    "དུས་འཁོར་རྩ་རྒྱུད་གསུངས་ནས་ལོ་ཉིས་སྟོང་ཉིས་བརྒྱ་དང་བཞི་འདས་པ་བུ་སྟོན་གྱིས་གསུངས།",
    "སྦྱི་ལོ། ལྕགས་ཕག་ཕག་གྲུ་ཁྲི་དཔོན་གྱིས་འབྲི་གུང་དུ་དམག་དྲངས་ཏེ་འབྲི་གུང་པར་ཕམ་ཉེས་ཆེན་པོ་བྱུང་།",
    "སྤྱི་ལོ་ལོར་སྣེའུ་གདོང་རྩེའི་ཁྲི་ལ་འཁོད་དེ་ལོ་ལྔ་བཞུགས།",
    "རྒྱལ་ཚབ་རྨ་རིན་ཆེན་གཙང་ཉང་སྟོད་རི་ནང་དུ་འཁྲུངས།",
    "རྗེས་སུ་ཙོང་ཁ་པ་གཉལ་སྟོད་ར་གྲོང་དུ་བཞུགས་པ་དང་མཇལ།",
    "འདི་ནི་སྐུ་ཆུང་ངུའི་དུས་སུ་ས་སྐྱར་ཡུན་རིང་བཞུགས།",
    "དམག་སྲིད་ཀྱི་བྱ་བ་ཤིན་ཏུ་མཁས་པར་གྱུར།",
    "འདི་ནི་གཙང་སྟོད་འོལ་པ་ལྷ་རྩེར་འཁྲུངས།",
    "སྤྱི་ལོ་ལ་གཙང་རི་བོ་ཆེར་གཤེགས།",
    "གསེར་གྱི་དམ་ཁ་བཅས་གནང་།",
    "ཙོང་ཁ་པའི་གདན་ས་རི་བོ་དགའ་ལྡན་རྣམ་པར་དག་པའི་གླིང་ཕྱག་བཏབ།",
    "མིང་གོང་མ་ཆེན་པོས་སླར་ཡང་ཙོང་ཁ་པར་གདན་ཞུའི་གསེར་ཡིག་བཏང་།",
    "མིང་གོང་མ་ཡུང་ལོས་རིན་སྤུངས་པ་ནམ་མཁའ་རྒྱལ་པོར་དཔའ་ངར་ཅན་གྱི་དམག་དཔོན་ཞེས་པའི་མིང་གནང་།",
    "པཎ་ཆེན་ལུང་རིགས་རྒྱ་མཚོ་བཀྲ་ཤིས་ལྷན་པོའི་གདན་སར་ཕེབས།",
    "རྐྱང་ཐང་སྒང་དུ་གཙང་དམག་དང་གཡུལ་འགྱེད།",
    "གཙང་དམག་རྣམས་ཕམ་སྟེ་ལྕོག་པོ་རིར་བྲོས།",
    "བོད་སོག་དཔོན་རིགས་དང་བཅས་པ་དཔལ་ལྡན་འབྲས་སྤུངས་ནས་ཆིབས་ཁ་བསྒྱུར་ཏེ་མེས་རྒྱལ་རྒྱལ་ས་པེ་ཅིང་དུ་ཕེབས།",
    "གོང་མ་ཆེན་པོས་བསུ་བ་ཞབས་ཏོག་གང་ལེགས་གནང་བ་མ་ཟད།",
    "དགའ་ལྡན་ལྔ་མཆོད་སྐབས་ཏཱ་ལའི་ཞབས་འབྲིང་དང་བཅས་པ་ལྷ་སར་འབྱོར།",
    "ཟླ་ཚེས་ཉིན་གོ་ཤྲི་བསྟན་འཛིན་རྒྱ་མཚོ་བགྲང་བྱ་བདུན་ཅུ་དོན་གསུམ་ལ་ཕེབས་ཏེ་དགོངས་པ་རྫོགས།",
    "དེའི་དུས་སུ་འབྲུག་པས་བོད་ལ་དཔུང་འཇུག་ཐེངས་གཉིས་ཙམ་བྱས།",
    "ལྷ་ས།"
  ]
}