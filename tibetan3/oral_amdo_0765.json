    "གང་གི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཏེ།",
    "དེ་ལ་སྐྱེ་བ་མེད་དེ་ཞེས་བྱ་བ་ནི་དེ་ལ་ཀུན་ནས་ཉོན་མོངས་པའི།",
    "གང་གི་ཚེ་དེ་ཉིད་རྡོ་རྗེའི་གནས་ཡིན་པ་དེའི་ཚེ་དེ་བཞིན་གཤེགས་པ་རྣམས་མཛད་པ་མེད་པ་དང་།",
    "སྐུ་ལ་སོགས་པ་མི་མངའ་བ་ཡིན་ན་དེ་རྣམས་ཀྱི་སྐུ་དང་གསུང་གི་ཁྱད་པར་སྣ་ཚོགས་པས་སྙེདེ་རྣམས་ཀྱིས་འགྲོ་བ་མ་ལུས་པའི་དོན་མཛད་པ་གཞན་དག་གིས་ཇི་ལྟར་དམིགས་པར་འགྱུར་ཞེ་ན།",
    "རང་གི་བྱ་བ་ལ་སྨྲ་བར་འདོད་པ་མེད་པ་དེ་བས་ན་འདི་ནི་རྨི་ལམ་ལྟ་བུའོ།",
    "མཆོག་ཏུ་གནས་གྱུར་པ་ཀུན་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་ས་བོན་ཟད་པ་ཅན་གང་ཡིན་པ་དེ་ནི་མྱ་ངན་ལས་འདས་པ་ཡིན་ལ།",
    "དེ་ལ་དེ་དག་གི་གདམས་ངག་བརྗོད་པར་བྱ་བ་ཡིན་ལ།",
    "བདག་གི་ལུས་དང་ངག་དང་སེམས་ཉིད་རྡོ་རྗེ་ཡིན་ཏེ།",
    "ལྷའི་སྐུ་ལ་སོགས་པར་མོས་པ་ནི་དངོས་གྲུབ་ཀྱི་རང་བཞིན་ཡིན་ལ།་",
    "དེ་བས་ན་དེ་དག་ནི་རང་གི་ལུས་ལ་སོགས་པ་ལ་གནས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "འོན་ཀྱང་ཐ་དད་པ་མེད་པའི་ཕྱིར་རང་གི་ལུས་ལ་སོགས་པ་ལ་གནས་པ་ནི་ཐོབླ་སྟེ།་",
    "༨ ལྷའི་སྐུ་ལ་སོགས་པ་ནི་རང་གི་སེམས་ཀྱི་ཡུལ་ཉིད་ཡིན་པའི་ཕྱིར་རམ་རང་གི་སེམས་ལ་སྣང་བའི་ཕྱིར་དང་རྟེན་དང་བརྟེན་པ་དག་ཐ་དད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "སེམས་དང་སེམས་ལ་དེ་དག་ནི་མི་གནས་པ་ཉིད་ནི་དཔེར་ན་སྟེང་དང་འོག་གི་ནམ་མཁའ་རྟེན་དང་བརྟེན་པའི་ངོ་བོ་ཉིད་དག་ཅིང་སྟོང་པ་ནི་གཟུགས་ཅན་མ་ཡིན་པ་ཉིད་ཀྱིས།",
    "དེ་བས་ན་རང་གི་ལུས་དང་ངག་དང་སེམས་རང་གི་ལྷའི་སྒུ་དང་གསུང་དང་ཐུགས་ནི་རང་གི་སེམས་ཉིད་ཡིན་ཏེ།",
    "དེའི་བདག་ཉིད་ལས་མ་གཏོགས་༢པར་རང་གི་སེམས་སྣང་བར་མི་རུང་བའི་ཕྱིར་རོ།",
    "འདིས་ནི་རང་གི་ལུས་དང་ངག་དང་སེམས་ལ་རང་གི་ལྷའི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ཚུལ་དུ་མོས་ཤིང་གཉི་གའི་སྐུ་དང་གསུང་དང་ཐུགས་རང་གི་སེམས་ཙམ་ཉིད་དུ་མོས་པར་བྱའོ།",
    "འདི་ནི་འདིར་སེམས་ལ་དམིགས་པ་ཡིན་ལ་འདི་ཉིད་ནི་འདིར་དངོས་གྲུབ་ཕྲ་མོའི་གདམས་པ་ཡིན་ནོ་ཞེས་གསུང་བར་འགྱུར་རོ།",
    "དེ་ལ་གདམས་ངག་གི་སྐབས་དབྱེ་བའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདི་སྙམ་དུ་གང་གི་ཚེ་ནམ་མཁའ་༥རྡོ་རྗེ་ལ་གནས་པ་དང་བྱུང་བ་ཡིན་ན།",
    "རང་གི་ལུས་དང་ངག་དང་སེམས་ལ་རང་གི་ལྷའི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ཚུལ་དང་།",
    "རང་གི་སེམས་ཙམ་ཉིད་དུ་སྣང་བ་ལས་གནས་པ་དང་།",
    "གང་གི་ཚེ་དེ་ཉིད་ལ་ཡིན་པ་དེའི་ཚེ་དེ་ཉིད་དེ་ཁོ་ན་ཉིད་ཀྱི་མཆོག་ཡིན་པ་དེ་ལྟར་ན།་",
    "གཞན་ཡང་རང་གི་མཚན་ཉིད་དག་བརྫུན་གྱི་རྣམ་པའི་ཁྱད་པར་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་དེ་དག་ལ་དེ་གནས་པ་མ་ཡིན་ནོ།",
    "རང་གི་ལྷའི་སྒུ་ལ་སོགས་པ་རྣམས་ནམ་མཁའ་རྡོ་རྗེ་ལ་སྣང་ཞིང་དེ་ཉིད་ལྷ་རྣམས་ཀྱི་ཡང་དེ་ཁོ་ན་ཉིད་ཀྱི་མཆོག་མཐོང་བ་ཡིན་ནོ།",
    "དེ་ནས་དེའི་རང་གི་ལུས་ལ་སོགས་པ་ཉིད་ཡོད་ན་རང་གི་ལུས་ལ་སོགས་པ་ཉིད་དུ་དེ་ལྟར་སྣང་བའི་ཕྱིར་རོ།",
    "དེ་ནས་དེའི་རང་གི་སེམས་ཙམ་ཉིད་ཡོད་ན་རང་གི་སེམས་ཉིད་དེ་ལྟར་སྣང་བའི་ཕྱིར་རོ།",
    "རང་ཉིད་ཀྱི་སེམས་ཉིད་ཡིན་པས་ན་རང་གི་སེམས་ཏེ།་",
    "ཅང་མི་སྨྲ་བར་ཞེས་བྱ་བ་ནི་ངག་གི་རྣམ་པར་རྟོག་པ་མེད་པར་རོ།",
    "ཉོན་མོངས་པ་གེཟད་པར་བྱེད་པས་རྡོ་རྗེ་སྟེ།",
    "སེང་གེའི་དམ་ཚིག་གི་རྒྱལ་པོའོ།",
    "ཐུགས་ཀྱི་རྡོ་རྗེ་དེ་ནི་རྡོ་རྗེ་འཆང་གིས་སྤྲུལ་པའི་ཏིང་ངེ་འཛིན་གྱི་དཀྱིལ་འཁོར་རོ།",
    "དེ་ལ་ལྷ་མོ་རྣམས་ནི་གསུང་གི་གསང་བའོ།",
    "ཁྲུ་ནི་བཅུ་དྲུག་ཅེས་བྱ་བ་ནི་ལོགས་རེ་རེ་ཞིང་ཁྲུ་བཞིའམ་ཁྲུ་བཅུ་དྲུག་པ་ཉིད་དོ།",
    "ཁྲུ་སྟོང་གི་བར་ཡིན་ནོ།",
    "འཁོར་ལོ་ནི་བྲི་བར་བྱ་ཞེས་བྱ་བ་ནི་དེའི་དཀྱིལ་འཁོར་གྱི་ཕྱེད་ཀྱི་ཚད་ཙམ་རྡོ་རྗེའི་ཐིག་བཏབ་ནས་ཀ་བ་བརྒྱད་ཀྱིས་མཛེས་པར་བྱས་པའི་རེའུ་ཆ་བརྒྱད་པ་ནང་གི་དཀྱིལ་འཁོར་ཟླུམ་པོའོ།",
    "མི་བསྐྱོད་པ་ལ་སོགས་པ་ཞེས་བྱ་བ་ནི་དེའི་ངོས་ཀྱི་རེའུ་ཆ་རྣམས་ལ་སྟེ།",
    "སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་མཆོག་རྣམས་གྲྭ་ཀུན་དུ་ཞེས་བྱ་བ་ནི་སྐུའི་མཆོག་དང་གསུང་གི་མཆོག་དང་།",
    "གོས་དཀར་མོ་དང་།",
    "དེ་རྣམས་ནི་གོ་རིམས་བཞིན་དུ་ནང་གི་དཀྱིལ་འཁོར་གྱི་མེ་ལ་སོགས་པའི་མཚམས་དག་ལ་དགོད་པར་བྱའོ།་།",
    "ལྷ་མོ་རྣམས་ནི་མང་པོའི་ཚིག་དང་སོགས་ཞེས་བསྡུས་པར་འགྱུར་ཏེ།",
    "དེ་ལ་རྒྱལ་མོ་རྣམས་ཀྱི་སྤྱན་དང་།",
    "དེ་རྣམས་ཀྱི་བཀོད་པ་ནི་རེ་རེ་ཞིང་མཚན་མའི་རྣམ་པར་བསྡུས་ནས་གནས་༢ཇི་ལྟ་བ་བཞིན་དུ་དགོད་པའོ།",
    "འོད་དཔག་ཏུ་མེད་པ་དེ་ཉིད་ཀྱི་རང་གི་སྐུ་དང་རང་གི་དཀྱིལ་འཁོར་གང་ཡིན་པ་དེ་དག་ནི་གནས་ཏེ་བཞིའོ་༤།",
    "གསུང་གི་རྡོ་རྗེ་ནི་འོད་དཔག་ཏུ་མེད་པ་སྟེ།",
    "དེ་རྣམས་ཀྱི་ཚོགས་ནི་རང་གི་མཚན་མའི་རྣམ་པ་ཇི་ལྟ་བ་བསྡུས་ནས་གནས་ཞེཇི་ལྟ་བ་བཞིན་དུ་དགོད་པའོ།",
    "བུད་མེད་དང་།",
    "དེ་བས་ན་ཡི་གེ་གསུམ་པོ་འདི་དག་གིས་དཀྱིལ་འཁོར་གྱེ་ཐིག་གདབ་པ་དང་ཚོན་དགྱེ་བ་དག་པའོ་ཐུཞེས་བྱ་བར་དགོངས་སོ།",
    "ཐིག་གདབ་པ་དང་ཚོན་དགྱེ་བ་གང་ཡིན་པ་དེ་དང་དེ་དག་སློབ་དཔོན་རང་ཉིད་ཀྱིས་རྟག་ཏུ་བྱའམ་ཞེ་ན།",
    "སྔགས་ནི་རང་གི་ལྷ་ཉིད་དོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ།",
    "ལོ་བཅུ་བྱེ་གཉིས་ལོན་པའི་ཁྱེའུ་དང་བུ་མོ་དག་ལྷག་པར་གནས་པ་ཅི་རིགས་པར་ལྷ་དང་ལྷ་མོའི་གཟུགས་དེ་དག་ལ་ས་ཡེ་ཤེས་ཀྱི་ལྷ་གཉིས་དག་ཕབ་ནས་ཏེ།་",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ལྷ་དེ་དག་གི་སྙོམས་པར་ཞུགས་པའོ།",
    "ཐུསྔགས་རྣམས་ཐམས་ཅད་ཀྱི་གསང་བ་ཞེས་བྱ་བ་ནི་གསུང་གི་དཀྱིལ་འཁོར་རྟེན་དང་བཅས་པའི་དེ་ཁོ་ན་ཉིད་དོ།",
    "རྡོ་རྗེ་དྲི་མེད་གསུམ་དག་གིས་༤ནི་རྡོ་རྗེ་ཅན་ཏེ་དེ་ནི་དཀྱིལ་སའཁོར་གྱི་བདག་པོའོ།",
    "དམ་ཚིག་གི་དཀྱིལ་འཁོར་ཡང་མ་གྲུབ་ཏུ་ཟིན་ཀྱང་བྲི་བར་བྱའོ།",
    "གཞན་དག་ན་རེ་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་དམ།",
    "དེ་དག་ཆུད་པར་དགོད་པ་ནི་སྐུའམ་ཡེ་ཤེས་ཀྱི་ཐིག་གི་རྣམ་པར་ནང་དུ་ཆུད་པར་ཕྱདགོད་པ་སྟེ་བསྟེམ་པར་བྱའོ།",
    "གསུང་གི་དཀྱིལ་འཁོར་གྱི་དོན་དུ་ནི་དཀར་པོ་དང་སེར་པོ་དང་ནག་པོ་དང་ལྗང་གུ་དང་དམར་པོའོ།",
    "ཐིག་སྐུད་འབའ་ཞིག་ལ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཀྱང་གི་སྒྲའི་དོན་ཏོ།",
    "ཐུགས་དང་སྐུ་དང་གསུང་དང་ནོར་བུ་དང་སྣ་ཚོགས་ཀྱི་དཀྱིལ་འཁོར་དུ་ཇི་ལྟར་ཐིག་གདབ་པ་བཞིན་དུ་ཚོན་གྱི་གཞི་ལ་པཉྩ་རེ་ཁཱའི་༤དོན་དུ་རྡུལ་ཚོན་ཕྱི་རོལ་ནས་བརྩམས་པའི་རིམ་གྱིས་ཀུན་གྱི་ནང་དུ་ལྔ་པ་སབྱ་བའི་ཚུལ་གྱིས་དགྱེ་བར་བྱའོ།",
    "གཞན་དག་ན་རེ་གནས་ལྔ་དག་ཏུ་ཞེས་བྱ་བ་ནི་ཇི་ལྟ་བའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་རྣམས་སུའོ།",
    "སྔགས་རྒྱུད་བདག་པོས་ཞེས་བྱ་བ་ནི་ལྷ་གང་གི་བུམ་པ་གང་ཡིན་པ་དེའི་སྔགས་ཀྱིས་དེ་ལ་བཟླས་པའི་ཕྱིར་དང་།",
    "བདག་པོ་སྟེ་རང་གི་ལྷའི་རང་བཞིན་དུ་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "བརྟེན་པའི་བློས་ནི་ཞེས་བྱ་བ་ནི་ཅི་རིགས་པར་བདག་ཉིད་དམ་བུམ་པ་ལ་སོགས་པ་ལ་ལྷ་ལ་སོགས་པའི་མོས་པ་བརྟན་པའོ།",
    "གི་ཆོ་ག་བསྟན་པར་བྱ་བའི་ཕྱིར་དངོས་གྲུབ་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།་",
    "རང་གི་ལྷའི་གཟུགས་ཞེས་བྱ་བ་ནི་བདག་ཏུ་མོས་པར་བྱས་པའི་དཀྱིལ་འཁོར་གྱི་བདག་པོའི་དཀྱིལ་འཁོར་པ་ཐམས་ཅད་ཀྱིས་ཡོངས་སུ་བསྐོར་བའོ།",
    "ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་རྣམ་སྣང་གི་ཚིགས་སུ་བཅད་པ་བསྟན་པ་ཡིས་སོ།",
    "དམ་ཚིག་ཀྱང་ཞེས་བྱ་བ་ནི་དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་པའོ།",
    "ཀྱང་གིས་ནི་དབབ་པ་ཡང་སྟེ།",
    "འདི་དག་གིས་ཤྱིནི་ཞེས་བྱ་བས་ནི་དམ་ཚིག་བཞི་པོ་ཡིས་སོ།",
    "བཅོམ་ལྡན་བདག་གིས་སྩལ་ལགས་ཀྱིས།",
    "བཅོམ་ལྡན་བདག་གིས་གཟུང་ལགས་ཀྱིས།",
    "རྡོ་རྗེ་ནི་རང་གི་ལྷའི་རང་བཞིན་གྱི་ཡེ་ཤེས་སེམས་དཔའོ།",
    "སྔགས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་བུད་མེད་ནི་ལྷ་མོ་བཞི་སྟེ།",
    "འོ་ན་བྱ་བ་གང་གིས་གནས་ཤེ་ན།",
    "ཡིད་ཆེས་པ་ཞེས་བྱ་བ་ནི་སྔགས་ཀྱི་ཆེ་བའི་བདག་ཉིད་ཡིད་ཆེས་པའི་ཡན་ལག་སྐྱེས་བུའི་རང་གི་བྱེད་པའོ།",
    "རྡོ་རྗེ་གསང་བའི་ཚིག་དག་གིས།",
    "ཞེས་བྱ་བ་ནི་སྡོད་ལ་བབས་པའི་སྐུ་རྡོ་རྗེ་ལ་སོགས་པ་བཙུན་མོ་དང་བཅས་པ་བྲིས་པའི་དཀྱིལ་འཁོར་དུ་སྔར་ཇི་སྐད་གསུངས་པའོ།",
    "སྔགས་ཆེན་པོ་ནི་ཡི་གེ་ཨོཾ་མོ།",
    "ཀྱང་གི་སྒྲས་ནི་མི་སྣང་བ་ལ་སོགས་པ་ཡང་སྦྱར་ཏེ།",
    "དེའི་དོན་གྱི་ཚིག་གི་མཆོག་ནི་གསང་བའི་ཁྲོ་བོ་དེ་རྣམས་ཀྱི་ས་བོན་གྱི་ཚིག་ཡིན་ཏེ།",
    "ཧྲི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རང་གི་འདོད་པའི་ལྷའི་སྦྱོར་བ་དང་ལྡན་པས་མདུན་གྱི་ནམ་མཁའ་ལ།",
    "ཆོ་ག་བཞིན་ཞེས་བྱ་བ་ནི་ཡི་གེ་ཨོཾ་ཧཱུཾཉིད་ལས་མདུང་རྩེ་ལ་སོགས་པ་སྤྲོས་པ་དང་་དམ་ཚིག་གི་མངག་གཞུག་པ་ལ་བྱིན་གྱིས་བརླབས་ལ་བདག་ལ་གྲུབ་པར་གྱུར་ཅིག་ཅེས་བྱ་བའི་བསམ་པས་བརྡེག་པ་ནི་འདིར་ཆོ་ག་ཡིན་ནོ།",
    "དེ་ལ་དམ་ཚིག་ནི་དམ་ཚིག་གི་མངག་གཞུག་པའོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་དེ་ལ་ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་བསྐྱེད་པའི་དམ་ཚིག་གི་ཛེེམངག་གཞུག་པའོ།",
    "དེ་རྣམས་ཀྱི་དམ་ཚིག་གི་གནས་བཞི་ནི་དམ་ཚིག་གི་གནས་བཞི་སྟེ།",
    "དམ་ཚིག་བསྐུལ་བ་ནི་ཨཱ་ལ་སོགས་པའི་རང་གི་དེ་ཁོ་ན་ཉིད་ཀྱིས་སད་པའོ།",
    "དེ་ནས་དམ་ཚིག་གི་ཚིག་འདི་དག་གིས་ཅི་ཞིག་བྱེད་ཅེ་ན།",
    "དམ་ཚིག་གི་མངག་གཞུག་པའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་ལུས་དང་ངག་དང་ཡིད་ནི་རྡོ་རྗེ་གསུམ་མོ།",
    "དེ་ཉིད་འབེན་རྔུདུ་བྱས་ནས་རྩ་ལས་བྱུང་བའི་གཞུ་དམར་པོ་ལག་པ་གཡོན་པས་གཟུང་ལ་གཞུའི་རྒྱུད་འདྲེན་པར་བྱེད་པ་ཅན་སོར་མོ་ལྔའི་ནང་ན་གནས་པའི་ཡི་གེ་ར་ལས་བྱུང་བའི་མདའ་བྱེཨུཏྤ་ལ་དམར་པོ་ཁ་མ་བྱེ་བའི་མདེའུ་དང་ལྡན་པའི་མདའ་ལྔ་ལྟོང་ཕྱ།",
    "འཛིན་པར་བྱེད་པའི་གཡས་ཀྱི་ཁུ་ཚུར་ཅོད་པན་གྱི་མཐར་འཇོག་པ་ནི་མདའ་ལྔའི་སྦྱོར་བ་དག་གིས་ནི་དབུ་རྒྱན་རྩེ་མོར་རོ།",
    "དེ་རྣམས་ཀྱི་རབ་གསང་བ་ནི་ནང་གི་ནོར་རོ།",
    "ཨོཾ་ནི་མིག་གི་དབུས་བསམས་ནས།",
    "ཉོན་མོངས་ཆེས་བྱེཞེས་བྱ་བ་ནི་ངལ་བ་ཆེན་པོ་ཡིན་ཏེ།",
    "ལྕེའི་རྩེ་མོ་ལ་ཡི་གེ་ཨོཾ་བསམ་པ་ཁ་དེར་གཏད་པར་བྱ་སྟེ།",
    "དེའི་དམ་ཚིག་གི་མཆོག་ནི་ས་བོན་གྱི་མཆོག་གོ།",
    "རྡོ་རྗེ་ཆེན་མོ་ནི་སྐུལ་རུབྱེད་མ་དེ་ཉིད་དེ་དེའི་བསྒོམས་ཀེཔའི་དོན་གྱི་ཚིག་ནི་ས་བོན་ནོ།",
    "ལུས་དང་ངག་དང་སེམས་ཞེས་བྱ་བ་ནི་ཉི་མ་དང་པདྨ་དང་ཡི་གེ་ལྕུ་མོ།",
    "ཡང་ན་ཙ་ལེ་ཙུ་ལེ་ཙུནྡེའི་དོན་གྱི་ཤེ་ཡི་གེ་གསུམ་མོ།",
    "གནས་ལྔ་དག་ཏུ་ཞེས་བྱ་བ་ནི་ཅོད་པན་གྱི་སྟེང་གི་བར་སྣང་ལའོ།",
    "ཆོ་ག་ཡིས་ཞེས་བྱ་བ་ནི་ལྔ་པོ་ཡང་རང་གི་རིག་པ་རྗེས་སུ་མཉེས་པའི་ཆོ་གས་གནས་པའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་སྦྱོར་བ་དང་ལྡན་པས་སྣོད་ལ་སོགས་པར་རྨུགས་འཛིན་གྱི་མཛོད་སྲུ་རུ་གནས་པ་ཡི་གེ་རྫ་སེར་པོའི་འོད་ཟེར་རྣམས་ཀྱིས་གེ་སྒྲུབ་པ་པོ་ཀུན་དུ་འགེངས་པར་བྱེད་པར་བསམས་ལ་ལག་པ་གཡས་པའི་སོར་མོའི་རྩ་བ་རྣམས་ལ་རྡོ་རྗེ་ཆུ་དེ་བདུད་རྩིར་མོས་པར་བྱས་ལ་ཕྱིའི་ཞུཆུ་དེའི་སྤྱི་བོར་སྔགས་བཟླ་ཞིང་སྦྱིན་པར་བྱའོ།",
    "དེའི་དོན་གྱི་སྐྱེཏོག་གི་དཔལ་ནི་རྒྱལ་མཚན་མཛེས་པའོ།",
    "གནོད་སྦྱིན་མོ་ཐམས་ཅད་ཀྱི་ཚིག་ནི་བསྡུས་པའོ།",
    "རིན་ཆེན་བཞི་ལས་བྱས་ཞེས་བྱ་བ་ནི་ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་གི་ངོས་རྣམས་ཤེལ་དང་ཨིནྡྲ་བེེ་ལ་དང་པདྨ་རཱ་ག་དང་མརྒད་ལ་སོགས་པའི་རི་བོའོ།",
    "གི་འོད་ཟེར་རྣམས་ཀྱིས་བཀུག་ནས་ཡི་གེ་སྤྱོ།",
    "གཟུགས་གཅིག་དག་ནི་ཞེས་བྱ་བ་ནི་རྒྱུད་གཞན་དག་གི་རྗེས་སུ་འབྲངས་ནས་ལོངས་སྤྱོད་ལྡན་མ་ལ་སོགས་པ་གནོད་སྦྱིན་མོའམ།",
    "རྡོ་རྗེའི་བྱེ་བྲག་གིས་ཏེ།",
    "གནོད་སྦྱིན་མོ་ཐམས་ཅད་ཀྱི་མཉམ་པ་ཉིད་ནི་བསྡུས་པ་སྟེ།",
    "གནོད་སྦྱིན་མོའི་སྒྲུབ་པའི་ཐབས་སོ།",
    "དངོས་གྲུབ་ཕྲ་མོ་ཞེས་བྱ་བ་ནི་དངོས་གྲུབ་དམན་པའི་བྱ་བའི་ཁྱད་པར་རོ།",
    "དངོས་གྲུབ་ཕྲ་མོ་དག་ལ་གནས་པ་རྣམས་སོ།",
    "དེ་ལྟར་ཐུན་མོང་གི་ཁྱད་པར་གསུངས་ནས་ཐུན་མོང་མ་ཡིན་པའི་རྡོ་རྗེ་འཆང་བའི་གཙོ་བོ་ནི་ཐུགས་ཀྱི་རྡོ་རྗེ་གཙོ་བོར་གྱུར་པའོ།",
    "དངོས་གྲུབ་མཆོག་གི་བྱ་བའི་ཁྱད་པར་ནི།",
    "དེའི་གཟུགས་དང་གསང་བ་དང་སྔགས་ཀྱི་དངོས་གྲུབ་རྣམས་ནི་སྐུ་དང་ཐུགས་དང་གསུང་གི་ཁྱད་པར་རོ།",
    "སྔགས་ཀྱིས་གྲུབ་ཅིང་ཞེས་བྱ་བ་ནི་སྔགས་ཏེ་ངག་གི་བྱ་བ་གྲུབ་པའོ།",
    "ཡིད་བཞིན་ནོར་བུའི་བདག་པོར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་དངོས་གྲུབ་ཐམས་ཅད་ཀྱི་རྩེ་མོ་ཡིན་ཏེ།",
    "དངོས་གྲུབ་མཆོག་འདོད་པ་རྣམས་ཀྱིས་ནི་ཡན་ལག་དྲུག་གི་བསྙེན་པ་དང་ཉེ་བར་བསྒྲུབ་རྐྱཔའི་འབྲས་བུ་ལ་གནས་པས་རིག་པའི་བརྟུལ་ཞུགས་ཟླ་བ་དྲུག་གི་བར་དུ་སྤྱད་བྱེལ།",
    "གཉི་ག་ལྷ་ལ་སོགས་པར་མོས་པ་ནི་གསུང་གི་བརྟུལ་ཞུགས་སོ།",
    "ཟླ་བ་དྲུག་གིས་ཞེས་བྱ་བ་ནི་བརྟུལ་ཞུགས་ཀྱི་དུས་སུའོ།",
    "རྐུ་བ་ནི་རང་གི་ལྷའི་ཆ་ལུགས་འཛིན་པའོ།",
    "བསད་པ་ནི་ལྷར་མོས་པས་ཐ་མལ་པའི་ང་རྒྱལ་ལོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་རིག་པའི་བརྟུལ་ཞུགས་གསུངས་ནས་འོད་དཔག་ཏུ་མེད་པ་དང་མི་བསྐྱོད་པ་༤དག་གིས་ཐོགསུངས་པ་ལ།",
    "དེའི་ལྕགས་ཀྱུ་མོ་ནི་འགུགས་པར་བྱེད་པ་སྟེ་གོས་དཀར་མོའོ།",
    "གསུང་གི་རྡོ་རྗེ་ནི་འོད་དཔག་ཏུ་མེད་པའོ།",
    "སྒྲུབ་པ་པོའི་ཕྱིའི་རིག་མ་འགའ་ཞིག་གིས་རྒྱབ་ཀྱིས་ཕྱོགས་ན་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "རང་གི་ཕྱག་རྒྱའམ་ཞེས་བྱ་བའི་སྒྲས་ནི་ངེས་པར་གཟུང་བ་སྟེ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་རང་གི་སྣང་བ་ཁོ་ན་ཡིན་གྱི་ཕྱི་རོལ་གྱི་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡིག་གསུམ་རྡོ་རྗེ་ཅན་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཡི་གེ་གསུམ་མོ།",
    "དེ་རྣམས་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡིན་པའི་ཕྱིར་དེ་རྣམས་ཀྱི་རང་བཞིན་ཅན་ཀྱི་རིག་མ་དང་སེམས་བརྟན་ནེེ་པར་གཟིགས་པ་ན།",
    "རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་བསྙེན་པ་དང་ཉེ་བའི་སྒྲུབ་པ་དག་གིས་རྡོ་རྗེ་གསུམ་དུ་གྲུབ་པའོ།",
    "རིག་པའི་བརྟུལ་ཞུགས་ཉིད་ནི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་དེ།",
    "དམ་ཚིག་གི་མཆོག་གོ།",
    "དེ་དག་གི་དེ་ཁོ་ན་ཉིད་གསུམ་ནི་རྡོ་རྗེ་གསུམ་པོ་ཡིན་ཞིང་དེ་ཁོ་ན་ཉིད་ཀྱང་དེ་བཞིན་ཉིད་ཡིན་པ་དེ་བས་ན།",
    "ཡན་ལག་གི་དོན་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "གཅིག་གིས་ནི་མཚན་ཉིད་ཡིན་ལ་བཞིས་ནི་མཚན་ཉིད་ཀྱི་རིགས་པས་སོ།",
    "བསྟོད་པ་ལྔ་པའི་བརྒྱད་པས་ནི་རྡོ་རྗེ་འཆང་གི་བདག་ཉིད་ཅན་གྱི་གསང་བའི་ཚུལ་ཉིད་དུ་གསུངས་པ་ཡིན་ནོ།",
    "བཞི་པར་བསྡུས་པའི་དཀྱིལ་འཁོར་དག་ནི་དཀྱིལ་འཁོར་གསུམ་མོ།",
    "རྡོ་རྗེ་གསུམ་དང་དེ་བཞིན་དུ་བཞི་པ་དག་གི་ཚོགས་ཡང་དག་པར་བསྡུས་པ་ནི་རྡོ་རྗེ་གསུམ་མཆོག་གོ།",
    "མཆོག་གི་མཆོག་ཅེས་བྱ་བ་རྣམས་སོ།",
    "དེ་བས་ན་མཆོག་གི་མཆོག་གོ།",
    "དེ་བས་ན་ཤིན་ཏུ་ཟབ་པ་འདི་ལ་ཡོད་པས་རབ་ཏུ་ཟབ་མོ་སྟེ།",
    "དེ་རྣམས་ཀྱི་རང་བཞིན་ནི་རང་གི་མཚན་ཉིད་དོ།",
    "ཕྲ་མོ་གསུམ་པོ་བསྡུས་པ་དེ་རྣམས་ཀྱེདམིགས་པས་ན་གོས་པ་མེད་པའོ།",
    "གསུང་གི་གསང་བ་ཡིན་པའི་ཕྱིར་གསང་བའོ།",
    "དེ་རྣམས་དང་དེ་དག་གི་མིང་དང་བློ་རྣམས་མི་དམིགས་པས་ཡང་དག་པར་མཚོན་པའི་ཕྱིར་རོ།",
    "དེའི་རྗེས་ལ་རང་གི་སྔགས་སུ་སྔགས་གསུམ་པོ་རིམ་བཞིན་དུ་བཅུག་སྟེ།",
    "ཡུན་རིང་དུ་བརྟན་པར་གྱུར་པའི་མཚན་ཉིད་རྒོ་མཆོག་ཏུ་སོང་བས་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་བརྙེས་སོ།",
    "གསུང་གི་གསང་བ་ཡིན་པའི་ཕྱིར་རྡོ་རྗེའོ།",
    "དེ་ཉིད་གསུངས་པ་ངོ་བོ་ཉིད་ཅེས་བྱ་བ་སྟེ་རང་རང་གི་ངོ་བོ་སྟེ།",
    "གསུང་གི་གསང་བ་ཉིད་ཡིན་པས་ན་རྡོ་རྗེའོ།",
    "གསང་བ་གསུམ་པོའི་རྡོ་རྗེ་འདི་དག་གི་རྡོ་རྗེ་རྣམས་ཀྱི་སེམས་དཔའ་དེ་ནི་རྡོ་རྗེ་༧སེམས་དཔའོ།",
    "གང་གི་ཕྱིར་དག་པ་ཉིད་ནི་བག་ཆགས་དང་བཅས་པའི་སྒྲིབ་པ་ཐམས་ཅད་ཡོངས་སུ་ཟད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་སྔར་ཡང་དེ་ཟད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ནི་རྡོ་རྗེ་འཆང་གི་དེ་ཁོ་ན་ཉིད་ཡིན་པས་དེ་ལྟར་ན་ངོ་མཚར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཁོ་ན་ཉིད་གང་གིས་མཐོང་བ་ནི་དེ་དག་འགྲུབ་པར་བུའགྱུར་རོ།",
    "དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་བརྗོད་པར་བྱ་སྟེ།",
    "དམ་ཚིག་བཞི་ནི་ཞེས་བྱ་བ་ནི་བཅུ་དྲུག་པ་ལས་ཁྱོད་ཀྱིས་སྲོག་ཆགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་གསུངས་པའོ།",
    "ཐམས་ཅད་རང་གི་སེམས་ཙམ་དུ་མཐོང་བས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་རྣལ་འབྱོར་པ་ཉིད་ཡིན་པའི་ཕྱིར་གསུང་གི་རྡོ་རྗེ་ཡང་དག་ཡིན་ལ།",
    "གསུང་གི་རྡོ་རྗེ་ཡི་གེ་ཆེའོ།",
    "ཇི་ལྟར་རྡོ་རྗེ་དམ་ཚིག་གི་མཐུས་དམན་པའི་ཟས་ཀྱི་དངོས་གྲུབ་གསུངས་ནས།་",
    "ཇེག་པ་དམན་པ་ལ་མོས་པ་རྣམས་ཀྱི་ནི་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔགས་དང་ཕྱག་རྒྱ་དང་དམ་ཚིག་གི་མཐུ་ལས་བྱུང་བའི་སྐུ་རྡོ་རྗེའོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་རྣལ་འབྱོར་པས་རྣམ་པར་རིག་པ་ཙམ་ཉིད་དུ་མོས་པ་ལ་གནས་པར་བྱས་ནས་སོ།",
    "དེ་ཉིད་ཀྱིས་ནི་སྦྱོར་བ་འདི་ནི་བུད་མེད་ཀྱི་གཟུགས་ཀྱིས་སྦྱོར་བ་མེད་པ་དེཡིན་པར་ཤེས་པར་བྱའོ།",
    "རང་གི་སྡུག་བསྔལ་ཟད་པ་ཙམ་ལ་མོས་པ་དོན་དུ་གཉེར་བ་ཉིད་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ཐམས་ཅད་ཀྱི་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་པ་ཐམས་ཅད་དེ་ཇི་ལྟར་འདོད་པའི་བུད་མེད་སྤངས་ཏེ།",
    "ལྷ་མོ་ཞལ་གཅིག་པ་ཕྱག་གཉིས་པ་ལྷ་མོ་རྡོ་རྗེ་ཞི་བ་མོ་དང་སྙོམས་པར་འཇུག་པ་དང་ཕྱག་ལྷག་མ་རྣམས་ཀྱིས་བགྲང་ཕྲེང་དང་དབྱུག་པ་དང་སྤྱི་བླུགས་དང་པདྨ་བསྣམས་པ།",
    "ཕྱག་དྲུག་པ་ཕྱག་གཉིས་ཀྱིས་འཁྱུད་པ་དཀར་མོ་ཕྱག་གཉིས་པ་དང་སྙོམས་པར་འཇུག་པ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིག་མ་ལ་ཉེ་བར་ལོངས་སྤྱོད་པའི་བསམ་པ་ནི་འདོད་ཆགས་ཀྱི་ལམ་མོ།",
    "བུད་མེད་ཀུན་ཞེས་བྱ་བ་ནི་བུད་མེད་ཐམས་ཅད་དོ།",
    "གསུང་གི་རྡོ་རྗེ་ཉིད་དུ་འགྱུར་བ་ནི་སྔ་མའི་རྗེས་སུ་འབྲངས་ནས་ཤེས་པར་བྱའོ།",
    "གནོད་སྦྱིན་མོ་ལ་སོགས་པ་སྒྲུབ་རྩེཔ་ལ་ནི་དེ་རྣམས་ཀྱི་རྡོ་རྗེ་དམ་ཚིག་དང་བཅས་པའི་ཚིགས་སུ་བཅད་པ་ལྔས་གསུངས་པ་ཡིན་ཏེ།",
    "བུད་མེད་ནི་གནོད་སྦྱིན་མོ་རྣམས་སོ།",
    "རྡོ་རྗེ་ས་འོག་ཅེས་བྱ་བ་ནི་ས་འོག་གི་བུ་མོ་བསྒྲུབ་རཱིཔའོ།",
    "དག་བྱེད་ཅེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་དུ་མོས་པའི་ཡི་གེ་གསུམ་གྱིས་ཉྪདག་པར་བྱས་པའི་ཕྱིར་རོ།",
    "ལུས་ཀྱི་དངོས་གྲུབ་ཀྱི་ཕྱིར་དམ་ཚིག་གི་རྡོ་རྗེ་ནི་ལུས་ཀྱི་ལས་ཐམས་ཅད་རོ་གཅིག་པའོ།",
    "མ་ལུས་པ་ནི་ངག་གི་ལས་སོ།",
    "ཚིག་གི་དངོས་གྲུབ་ཀྱི་གནས་ཀྱང་དེ་ཡིན་ལ།",
    "འདིར་ཡང་གསུང་གི་རྡོ་རྗེའི་སྤྱོར་བ་ལ་གནས་ནས་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "ཡང་ན་ཕྱག་བྱེད་པ་དེའི་ཚེ་རྡོ་རྗེ་འཆང་བའི་ང་རྒྱལ་འདོར་བར་འགྱུར་བ་དེ་བས་ན་འདིས་ཐབས་གང་གིས་ཕྱག་བྱ་ཞེ་ན།",
    "རང་གི་ལྷ་ལ་ཇི་ལྟར་ཕྱག་བྱ་རྔུཞེ་ན།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་ཕྱག་བྱ་བའི་རང་གི་ལྷ་སྟེ།",
    "དེ་རྣམས་ཀྱི་བསམ་གཏན་ནི་རང་གི་ལུས་དང་ངག་དང་ཡིད་དག་ལའོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་རྔུནི་རང་གི་ལྷ་ཉིད་དེ་དེའི་བསམ་གཏན་ནོ།",
    "སྔགས་ཟློས་པས་ནི་རང་གི་ལྷའི་རྣལ་འབྱོར་རོ།",
    "དེའི་སྐུ་དང་གསུང་དང་ཐུགས་དང་རང་གི་ལུས་དང་ངག་དང་ཡིད་གཅིག་ཏུ་བྱེད་པའོ།",
    "བསམ་གཏན་རྡོ་རྗེས་བསྐུལ་བར་བྱ་ཞེས་ཀྱེབྱ་བ་ནི་བསམ་གཏན་ལས་བྱུང་བའི་རང་གི་ལྷའི་རྣམ་པར་སྦྱོར་བར་བྱ་བའོ།",
    "སྐབས་ཉིད་ཡིན་པའི་ཕྱིར་རང་གི་ལུས་དང་ངག་དང་ཡིད་ལའོ།",
    "དེ་དག་གིས་ཀྱང་འདའ་བར་བྱ་བ་ཉིད་མ་ཡིན་པས་ན་དམ་ཚིག་གོ།",
    "ཡེ་ཤེས་ཀྱི་ཉི་མར་བྱས་པ་དེ་དག་གིས་རེ་རེས་ཡོངས་སུ་གང་བ་དབུལ་ཞེས་བྱ་བ་ནི་ལྷ་བཤོས་ཀྱི་བསམ་པས་སོ།",
    "རྡོ་རྗེ་ཐམས་ཅད་མི་སྣང་བར་མོས་པ་ནི་དངོས་གྲུབ་ཕྲ་མོའི་ཉེ་བར་མཚོན་པ་ཡིན་ནོ།་།",
    "བདེ་བར་གཤེགས་པའི་སྐུ་དང་གསུང་གི་སྦྱོར་བ་ལྷག་མ་བདག་ཉིད་ཀྱི་ལུས་དང་བློ་རྒྱས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "རང་གི་སྐུ་དང་གསུང་དང་ཐུགས་ཉིད་ནི་སྐུ་ལ་སོགས་པ་དམིགས་སུ་མེད་པའི་རྡོ་རྗེ་ཡིན་ཏེ།",
    "རང་གི་སེམས་ཙམ་ཉིད་ཀྱིས་ཞུཇི་ལྟར་སྣང་བ་བཞིན་དུ་མེད་པར་སྣང་བའི་ཕྱིར་རོ།",
    "རྡོ་རྗེ་འཆང་དག་གི་སྐུ་དང་གསུང་དང་ཐུགས་ཧྥུརྡོ་རྗེ་དམིགས་སུ་མེད་པ་ནི་རང་གི་སེམས་ཙམ་ཉིད་ཀྱིས་ཇི་ལྟར་སྣང་བ་བཞིན་དུ་མེད་པ་ཉིད་དུ་སྣང་བའོ།",
    "གལ་ཏེ་ལོག་པར་གཟུང་བ་ཡིན་ན་ཇི་ལྟར་དཔལ་རྡོ་རྗེ་རྩེ་མོ་ལས་དཀྱིལ་འཁོར་གྱི་བདག་པོ་ངོ་བོ་ཉིད་ཀྱི་སྐུར་བྱེ་གསུངས་ཤེ་ན།",
    "སྐུ་ལ་སོགས་པའི་རྡོ་རྗེ་ནི་གསང་བ་གསུམ་མོ།",
    "ཁམས་གསུམ་པ་ཐམས་ཅད་ནི་དམ་ཚིག་གི་དཀྱིལ་འཁོར་ཆེན་པོའོ།",
    "དེ་རྣམས་ཀྱི་རྡོ་རྗེ་གསུམ་ནི་གསང་བ་གསུམ་མོ།",
    "བུད་མེད་དང་སྐྱེས་པའི་རྣམ་པ་དང་ལྡན་པའི་བདག་ཉིད་ཅན་ལ་འདིར་ཕྱག་རྒྱ་ཆེན་པོ་བལྟ་བར་བྱའོ།",
    "དེའི་རྡོ་རྗེ་སྟེ་འཁོར་ལོས་སྒྱུར་བའི་སྤྱི་བོ་དང་གསང་བ་ནི་གནས་ཇི་ལྟ་བ་བཞིན་དུ་གསུམ་མོ།",
    "དབྱིངས་གྱུར་པ་ཞེས་བྱ་བ་ནི་ཁམས་གསུམ་གྱི་ལྷ་མོ་བཞི་ལས་རིགས་ཀྱི་དབྱེ་བས་གཅིག་གོ།",
    "འདི་རྣམས་ཀྱི་སོ་སོའི་རང་གི་ཐུགས་ཀའི་ས་བོན་ནོ།",
    "དེའི་དོན་ནི་རང་གི་ས་བོན་ནོ།",
    "འབྲས་བུ་ནི་སྐད་ཅིག་གིས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལ་སྡོམ་པ་ནི་ཁྱུ་མཆོག་གི་སྒྲས་གསུངས་སོ།",
    "རྡོ་རྗེ་གསུམ་འབྱུང་ཞེས་བྱ་བ་ནི་རིགས་གསུམ་གྱི་ཐུན་མོང་ངོ།",
    "གསུང་གི་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་གསུང་གི་རྡོ་རྗེས་རྣམ་པར་སྤྲོས་པའི་རང་གི་ལུས་ཀྱིས་ཏེ།",
    "གང་གིས་ཤེ་ན་རྡོ་རྗེ་གསུམ་གྱི་གེདམ་ཚིག་སྟེ།",
    "སྒྲུབ་པ་དང་སྒྲུབ་པ་ཆེན་པོའི་རྣལ་འབྱོར་དག་ལས་ལངས་ནས་འདི་ལྟར་ཡང་དང་ཡང་དུ་མོས་པར་བྱས་ཏེ་འདིར་བདག་གི་ཕ་དང་མ་ནི་ཐབས་དང་ཤེས་རབ་བོ།",
    "བདག་གི་ལུས་དང་ངག་དང་ཡིད་གང་ཡིན་པ་དེ་དག་ནི་རྡོ་རྗེ་རྣམས་སོ།",
    "ཁམས་གསུམ་པ་ཉིད་ནི་དམ་ཚིག་གི་འཁོར་ལོ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་ས་ལ་སོགས་པ་གང་ཡིན་པ་དེ་དུ་ནི་སྤྱན་ལ་སོགས་པ་ཡིན་པ་དེའི་ཕྱིར་དེའི་རང་བཞིན་ཅན་གྱི་ཁམས་གསུམ་ནི་བདག་གི་གཞལ་ཡས་ཁང་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཉམ་པ་ཉིད་དུ་གནས་པ་ནི་གསང་བ་གསུམ་གྱི་ཚོགས་རོ་གཅིག་གི་ཚུལ་དུ་མཆོག་ཏུ་བདེ་བ་དང་ཡིད་བདེ་བ་ཉམས་སུ་མྱང་དྷིབའོ།",
    "ཅིའི་ཕྱིར་འཁོར་ལ་གཟིགས་ཤེ་ན།",
    "ཅང་མི་གསུང་བར་གྱུར་པ་ནི་དེ་རྣམས་ཉིད་ཀྱི་ཚིག་གི་གོ་སྐབས་དབྱེ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་དེ་རྣམས་ལ་དེ་དག་གི་གཉིས་སུ་བྱེད་པ་ཅིའི་ཕྱིར་སྤོང་ཞེ་ན།",
    "ཇི་སྙེད་པ་ཞེས་བྱ་བ་ནི་རེ་རེའི་བར་དུ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྡོ་རྗེ་འཛིན་པ་ཁྱེཐམས་ཅད་ཀྱི་དངོས་གྲུབ་ཀྱི་དམ་ཚིག་ཛེེ་ནི་ཐུན་མོང་གི་རྒྱུ་ཉིད་དམ་དེ་ཁོ་ན་ཉིད་དེ་དང་པོའི་རྡོ་རྗེ་འཆང་ངོ།"
  ]
}