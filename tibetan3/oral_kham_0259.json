    "སྔགས་འཆང་རང་བྱུང་རྡོ་རྗེ་ཡི།",
    "སྔགས་འཆང་རང་བྱུང་རྡོ་རྗེ་ཡི།",
    "སྔགས་འཆང་རང་བྱུང་རྡོ་རྗེ་ནི།",
    "སྔགས་འཆང་རང་བྱུང་རྡོ་རྗེ་ནི།",
    "གྲུབ་ཐོབ་ཨོ་རྒྱན་པ་གནམ་ས་གཉིས་ཀྱི་ཀ་བ་ལྟ་བུ་དེ་འབྱོན་ཞིང་འདུག་གསུངས་ནས་གྲབས་ཡུལ་ཆེར་བྱས།",
    "པའང་སྐྱེ་བ་འདི་ཉིད་ལ་ཨར་ཏ་ཉོར་གྱི་རྒྱལ་ས་ན་འདུག་པའི་དུས་སུ།",
    "རྟེན་ཞིག་མྱུར་དུ་བཞེངས་བྱས་པས་འདི་ན་འདུག་པ་རྣམས་ཀྱིས་བཞེངས་ཟིན།",
    "དེ་ཡང་ལུས་སེམས་འབྲལ་བའི་སྔ་ལྟས་སུ་འདུག་ཀྱང་།",
    "སྔར་གྱི་སྐུ་བཞི་ངོ་སྤྲོད་ཀྱི་གདམས་ངག་ལ་ཡང་སྐུ་གསུམ་ཡིད་བྱེད་ཀྱི་འཕྲོ་འདུ་སྣ་ཚོགས་པར་ཡོད་པར་འདུག་པ་སྟེ།",
    "བདེ་བར་བྱུང་བའི་སྐབས་སུ་རྩ་ན་ཁོང་གསུམ་འདུག་པ་ལ་སུ་ལ་ཡང་མ་ཟློ་གསང་བྱ་བ་ལས་ལུས་གཡོ་འགུལ་མི་ཤེས་པ་ཞག་མང་རབ་ཏུ་བྱུང་ཞིང་།",
    "དབྱར་གཞུང་ཆེན་བཞིན་དུ་ནམ་ཟླ་ཕྱོགས་མེད་དུ་དྲོས་པ་ལ་སོགས་པའི་རྟགས་མང་པོ་འདུག་པ་དེ་རྐྱེན་ངན་དངོས་གྲུབ་འཆར་ཞིང་།",
    "བཀའ་སྲུང་དགོངས་པ་རྫོགས་པར་མཛད་པའི་ཀརྨ་པ་རང་བྱུང་རྡོ་རྗེ་ཡང་འཆི་དགོས་པར་འདུག་པའི་ཕྱིར་ན།",
    "སྔགས་འཆང་རང་བྱུང་རྡོ་རྗེ་ཡང་།",
    "མ་འོངས་པའི་བྱེ་བྲག་འདི་རྣམས་ལ་མང་པོ་ཤེས་ཤིང་དྲན་པར་འདུག་སྟེ།",
