    "དེར་རྨི་ལམ་དུ་བློ་མ་བདེ་ནས་མཆི་མ་མང་པོ་བྱུང་འདུག་པའི་འཕྲོ་ལ་གཉིད་སད་གསུངས།",
    "རྗེ་བཙུན་མ་སྒྲོལ་མ་འདི་སྐྱེ་བ་བདུན་དུ་བར་མ་ཆོད་པའི་ཡི་དམ་ཡིན་ངོ་ཤེས་པར་འདུག་གསུངས།",
    "ཁོང་དམ་ཚིག་གཙང་བའི་རྟགས་སུ་འདུག་གསུངས།",
    "ཡང་ནུབ་ཅིག་སྨར་ཁམས་སྨད་ཀྱི་ས་ཆ་ཞིག་ན་ཁང་པ་བཟང་པོ་ཞིག་བྱས་འདུག་པའི་ནང་ན།",
    "མི་དཀར་སེང་བ་གཅིག་དང་གཉིས་འདུག་པ་ལ།",
    "ཨེ་ཐོན་ཡང་མི་ཤེས་པར་འདུག་པས།",
    "ང་རང་དངོས་བཞུགས་པ་དང་འདྲ་གསུངས།",
    "གཞན་ཡང་དེ་དུས་དྲུང་ན་ཡོད་པ་རྣམས་ཀྱིས་ཐུགས་ཀྱི་ལྟས་ཇི་འདྲ་གདའ་ཞུས་པས།",
    "ད་ལན་རྒྱུན་བཟང་བ་འདི་འཆི་ཁར་ཕྱིན་པའི་བསུ་བར་འདུག་གསུངས།",
    "འཇའ་ཚོན་འདི་རྣམས་དཔའ་བོ་མཁའ་འགྲོའི་འོད་ཟེར་དུ་འདུག་གསུངས།",
    "སླད་མ་བྱེད་གསུང་བ་འདུག་པ་བཞིན་བཅོས་སླད་མེད་པར་སོར་བཞག་ཏུ་བྲིས་པའོ།",
    "ད་ནི་སྐྱོ་པོས་ངའི་ཁ་མི་རྙེད་པར་འདུག་གསུངས།",
    "རང་རང་སོ་སོའི་དཀར་ཆག་ནང་ན་གསལ།",
    "རང་རང་སོ་སོའི་དཀར་ཆག་ནང་ན་གསལ།",
    "རང་རང་སོ་སོའི་དཀར་ཆག་ནང་ན་གསལ།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བ།",
    "རང་སྣང་རང་སྟོང་རང་རིག་མ་འདྲེས་པ།",
    "རིག་དང་རང་རིག་ཡིན་གྱི་གཞན་རིག་མིན།",
    "མ་མཐོང་ཇི་ལྟ་བུ་གདའ་ལགས་ཞུས་པས།",
    "ཀུན་དགའ་བྱམས་པ་བྱོན་རྒྱུ་འདུག་པ་མ་མཐོང་།",
    "རུས་ཐུམ་ཞིག་བྱུང་འདུག་ཅེས་གསུངས་པས།",
    "མི་རྣམས་ད་ལྟ་ང་ལ་ཐེ་ཚོམ་འཛམ་བུའི་གླིང་འདིར་ང་རང་འོངས་པ་ཡིནབྱེད་དེ་མྱུར་དུ་སོལ་འགྲོ་བ་ཡིན།",
    "ཕྱི་རོལ་གྱིས་ཕྱོགས་རྣམས་འདྲེ་མེ་ཀེམ་ཀེམ་གྱིས་གང་འདུག་པ་ལ།",
    "དེ་ནས་བཞུགས་གདན་ལ་ཟླ་བའི་སྟེང་ན་འདུག་པ་ཡང་ང་ཡིན།",
    "གླང་པོ་ཆེའི་སྟེང་ན་འདུག་པ་ཡང་ང་ཡིན་གསུངས།",
    "ལྷའི་བདུད་རྩི་ཁ་དོག་ནག་པོ་དེ་བཟང་ཟེར་བར་འདུག་པ་དེ་ལྟར་ལགས་སམ་ཞུས་པས།",
    "དྲུང་ཉིད་ཀྱང་ཕྱག་དང་ཕྱག་རྒྱ་མཛད་ཅིང་འདུག་པ་ལ།",
    "ཁྱེད་རང་རྣམས་སྒྲུབ་པ་གྱིས།",
    "ཁྱེད་རང་རྣམས་ཡན་ལག་བདུན་པ་གྱིས་ཤིག་གསུངས་ནས།",
    "མཐའ་བྲལ་ངང་ལ་གནས་ཤིང་གདའ།",
    "བདེ་ཆེན་སེམས་ལ་འཆར་ཞིང་གདའ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གདའ་བདུན་རྡོ་རྗེའི་མགུར་དང་།",
    "དེའི་ཚེ་འདིར་སྒོམ་ཆེན་པ་ཕལ་གྱིས་ཡི་དམ་རྗེ་བཙུན་མ་ལ་བྱེད་ཅིང་ཡོད་པར་འདུག་གསུངས།",
    "ཁང་བཟང་དམར་ཟང་ངེ་བ་སྒོ་དང་ངེ་འདུག་ངས་དེ་ལ་ལྟས་ཀྱིན་ཕྱིན་པས།",
    "ཆམ་པ་དེ་དྲག་འདུག་གསུང་ནས་སྐུ་བཀྲག་མདངས་དང་ལྡན་པ་ཞལ་ཟིལ་པ་ཕྲུམ་མེ་བཞུགས་འདུག་ཟེར།",
    "སྣོད་བཅུད་ཐམས་ཅད་སྣང་ལ་རང་བཞིན་མེད་པ་འཇའ་ཚོན་ལྟ་བུར་འདུག་དེ་རྣམས་དང་མཇལ་དུས་བདེ་སྟོང་ཕྱག་རྒྱ་ཆེན་པོར་ལྷན་ལྷན་འགྲོ་བར་འདུག་གསུངས།",
    "འཛམ་བུ་གླིང་ནས་འདིར་འོང་ཙ་ན།",
    "འདུན་པ་དེ་གལ་ཆེ་བར་འདུག་གསུངས།",
    "མནལ་ལམ་ལ་བསྙད་པའི་ཟོལ་གྱིས་ཅུང་ཟད་ཞལ་དུ་ཤོར་བ་མ་གཏོགས་ཡེ་མི་གསུང་བར་འདུག་གོ།",
    "གོང་མ་སྐུ་ཁམས་བཟང་བའི་དྲུང་དུ་མཇལ་ཞིང་བསྟན་པའི་བྱ་བའང་འགྲུབ་པར་གདའ་གསུངས་སོ།",
    "ཁྱེད་རང་རྣམས་ཀྱང་འུ་ལག་མ་ཞོན་གསུངས།",
    "རྒྱལ་བརྒྱུད་དང་མི་དཔོན་ཐམས་ཅད་དང་པྲཛྙཱ་ཝང་དམའ་ཕབ་འདུག་པ་བདེ་བར་བཏང་།",
    "དྷརྨ་ཙིང་ཝང་དང་དིང་འཇུ་ཕིང་ཆང་དམག་བསགས་ཏེ་འཐབ་དུས་བཏབ་ནས་རྩོད་པར་འདུག་པ་ཞལ་ཏས་འཁྲུག་པ་བཅག་དེའི་སྐབས་སུ་སླར་ཡང་གོང་ནས་ལུང་དང་གནང་སྦྱིན་བསྐུར་ནས་མི་དཔོན་མང་པོ་སྤྱན་འདྲེན་དུ་སླེབས།",
    "དབྲ་འབྲུ་སྒོ་ལྡིང་འཁྲུགས་པའི་དམག་སོགས་མཐའ་ཡས་པ་འདུག་པ་རྣམས་ཞི་བར་མཛད་དེ།",
    "མི་ཆེན་གྱིས་བརྙེའི་ཕྱག་བླངས་འདུག་རྒྱལ་ཁམས་མ་བདེ་བ་དེས་ལེན།",
    "དུས་སྐབས་ཀྱི་སྟོབས་ཀྱིས་དེ་རྣམས་བཟློག་པར་དཀའ་བར་འདུག་པས།",
    "ནུབ་ཕྱོགས་སུ་འགྲོ་བའི་ཞུ་བ་ནན་ཅན་བྱེད་དགོས་པར་འདུག་ལམ་དུའང་གདུལ་བྱ་མང་པོ་ཞིག་ལ་སྐལ་པ་དང་འཚམས་པར་ཕན་གདགས་དགོས་པ་ཡོད་ཅེས།",
    "རྒྱལ་ཁམས་ཀྱི་བྱ་བ་རྣམས་ཁྱེད་རང་ཡོན་མཆོད་ཀྱིས་མཛད་པ་མི་འཐད་དམ།",
    "མི་དཔོན་དེ་གཉིས་དེ་ཀྱིས་དེ་མ་ཐག་ཏུ་གསུང་དེ་རྣམས་ཡུ་གུར་གྱི་ཡི་གེ་ལ་འདེབས་ཤིང་འདུག།",
    "དེ་ཕྱིན་ཆད་ནས་ལྷའི་བསྟོད་པ་སོགས་ཚིགས་བཅད་རྩོམ་པ་ལ་བསམ་མནོ་གཏོང་མི་དགོས་པར་འདུག་གསུངས།",
    "སེམས་ཀྱི་སྤྲུལ་བསྒྱུར་ལ་ཡང་ཕྱི་རོལ་དུ་ཚེག་སྒྲ་ལ་སོགས་རྟགས་མཚན་གསལ་བར་འོང་བ་འདི་མཚར་བར་གདའ་ཨང་།",
    "ཡུལ་ཁམས་ཕྱོགས་དེར་བཞུགས་པར་ཀུན་གྱིས་ཞུས་ཀྱང་མ་གནང་བརའདིར་རི་དྭགས་སྡོད་པ་ཞིག་མྱུར་པོར་འོང་པར་འདུག་ཅེས་ཉེ་འཁོར་དུ་གནས་པ་ལ་གསང་ཚིག་ཏུ་གསུངས་སོ།",
    "བསྟུན་དེ་སངས་ཀྱིས་དྭངས་འདུག་པ་དང་།",
    "དེའི་བར་ལ་བསྙུན་དེ་དྭངས་འདུག་པ།",
    "དྲག་འདུག་གསུངས།",
    "དེ་ཀ་རང་ལ་གཞི་བྱེས་ཐམས་ཅད་ཀྱིས་ཆུ་རྡོ་དཀར་པོ་ཁུ་ཚུར་ཙམ་མང་པོ་ཁྱེར་ལ་ཐད་ཕ་ཀིར་ཤོག་གསུངས།",
    "ཁོ་རང་རྣམས་ཡོད་སར་ཆར་རྨུགས་དང་འབྲུག་སྒྲ་ཆེར་གྲག་ཅིང་།",
    "མནལ་སད་མ་ཐག་བསྐྲུན་ཡང་དྭངས་འདུག་པས།",
    "དེ་བར་ལ་བསྟུན་དྭངས་གདའ་བ་ཇི་ལྟར་མཛད་པ་ལགས་ཞུས་པས།",
    "གཏིང་ཟབ་ཕུག་ཏུ་སྔར་ཡོད་པའི་ཆུ་དེ་སྐམ་འདུག་པ་ལ།",
    "དེ་ནི་གཞི་བདག་བཟང་བའི་དྲིན་ཡིན་གསུངས་པར་གདའ།",
    "འདིར་གནས་ཁྱད་འཕགས་ཤིག་ཡོད་པའི་སྒོ་འབྱེད་པ་ལ་ང་རང་སླེབ་འོང་བ་ཡིན་གསུངས་པའི་ཚིག་དེ།",
    "ད་དོན་ཐོག་ཏུ་ཕེབས་འདུག་ཅེས་གླེང་བར་གདའ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཐམས་ཅད་དུ་ཕྱག་རྒྱ་ཆེན་པོ་ལ་འཇོག་པའི་ངང་ནས་ནམ་ལངས་ནས་ཉི་དྲོས་ཀྱི་བར་ཏིང་ངེ་འཛིན་ལ་བཞུགས།",
    "ངེད་ད་ལན་མི་འཆི་ཁྱེད་རང་རྣམས་སེམས་ཁྲལ་མི་དགོས།",
    "ད་བོད་ན་མེད་ཟེར་ཞིང་དུས་ཚོད་བསྒྲིགས་པས་འདས་ཚོད་དང་གཅིག་རང་དུ་གདའ།",
    "དེ་ལ་སྐྱེ་བོ་ཀུན་གྱིས་ཤིང་མཆི་མས་བརྣངས་ཏེ་ལུས་ས་ལ་བརྡབ་པར་བྱསསྒོམ་ཆེན་འདི་སྨྱོས་འདུག་ཟེར།་",
    "རང་རང་སོ་སོའི་བསམས་པ་ལ།",
    "ཡོན་ཏན་བསྟན་ཀྱང་མི་མཐོང་བར་སྐྱོན་སྦས་ཀྱང་མཐོང་བ་དེ་ཀ་མང་བར་གདའ།",
    "མཛོ་རྟ་དེད་ནས་ལ་ལུང་མང་པོར་ཕྱིན་ལུགས་རྣམས་ཡི་གེར་འགོད་པའི་གྲབས་འདུག་པ་ངེད་ཀྱིས་བཟློག་ཡི་དམ་མཁའ་འགྲོ་དང་ཞལ་མཇལ་ཚུལ་དང་།",
    "ས་ར་ཧ་རྣམས་ཐོ་བརྩེགས་སུ་སྣང་ཞིང་རང་ཉིད་ལ་ཐིམ་པར་སྣང་བ།",
    "དེ་ལྟ་བུའི་ཉེ་ལོགས་མི་དམན་པའི་ཁྲིའི་བཀོད་པ་ལ་བདག་ཉིད་ཀྱང་བདེ་བར་འདུག་པ་མཐོང་སྟེ་འདི་ལྟ་བུ་དག་བསམས་པར་གྱུར་ཏོ།",
    "གནས་ནང་འདུག་ཚེ་འཁྲུལ་བའི་རྨི་ལམ་ན།",
    "ཡང་ནི་གནས་དེར་ཐོ་རངས་ནུབ་ཅིག་དུས།",
    "རབ་ཏུ་གང་དབུས་བདག་ཉིད་འདུག་ནས་ཀྱང་།",
    "ཡབ་ཀྱི་རྨི་ལམ་དུའང་དཀྱིལ་འཁོར་རབ་ཏུ་བཀྲ་བའི་དབུས་སུ་བུམ་པ་བཟང་པོ་འདུག་པ་ལ་ཕྱག་མཆོད་བྱས་གསོལ་བ་བཏབ་པ་རྨིས།",
    "གླང་ལོ་ཟླ་བ་དང་པོའི་ཡར་ཚེས་ཀྱི་སྔ་དྲོ་ཞིག་དྲུང་ན་ཡོད་པ་རྣམས་ཡེངས་པའི་བར་ལ་ཇི་ལྟར་བཞེངས་མ་མཐོང་བ་ལ་ཕར་ཆམ་ཚུར་ཆམ་མཛད་ནས་བཞད་ཅིང་འདུག་པ་ལ་གོག་མ་དགོས་པར་འབྱོན་ཐུབ་པ་ལགས་སམ་ཞུས་པས་འགྲོ་ཐུབ་གསུངས།",
    "ཁྱེད་ལ་གསེར་ཞིག་ཀྱང་སྟེར་བར་འདུག་གསུང་སྟེ་ཅི་གར་དུ་མཇལ་ཞིང་དེ་བཞིན་དུ་བྱུང་།",
    "ཤེས་རབ་བརྩོན་འགྲུས་འོང་བར་འདུག་ཅེས་གསུངས་པས།",
    "ཁོང་རང་གཅིག་པུར་བཅིབས་ནས་བྱོན་ནོ།",
    "དེ་རྣམས་ཅི་འདྲ་འདུག་ཞུས་པས།",
    "ནངས་ཤིག་ང་མདང་ཀརྨར་ཕྱིན་གསུང་དེ་ཅི་འདྲ་འདུག་ཞུས་པས།",
    "ལ་ལས་སེང་གེ་ལ་བཅིབས་ནས་ནམ་མཁའ་ལ་བྱོན་པར་མཐོང་བ་ལ་སོགས་པ་མཐོང་སྣང་རྣམ་པ་མང་པོ་འདུག་པ་དེ་ཀུན་ད་ལྟ་དྲན་ནམ་ཞུས་པ་ལ།",
    "ཁྱེད་ཀྱང་མཎྜལ་ཕུལ་ཞིང་མཆི་མ་ཕྲི་ལི་ལི་འདུག་པ་དེ་ཡིན།",
    "བ་རི་ན་རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མ་མང་པོ་འདུག་གསུངས།",
    "དཔལ་མ་མགོན་གྱིས་ནམ་མཁའ་གང་ནས་འདུག་གསུངས།",
    "ཁྱེད་ཀྱིས་སྦ་ལྕག་བཅད་འདུག་ཨོཾ་གསུངས་པས་ཁོང་ཤིན་ཏུ་དད་དེ་ཞབས་ལ་གཏུགས་སོ།",
    "འདོམ་དོ་ལྷག་ཙམ་འདུག་པའི་སྟེང་དུ།",
    "འདིར་དགེ་སྦྱོར་འཕེལ་པོར་འདུག་ཅེས་གསུངས་པ་དང་།",
    "མཚན་བཟང་པོ་ཐོས་ནས་ལན་ཞིག་མཇལ་བསམས་པའི་སེམས་བཞིན་ད་ལྟ་གོ་ཡུལ་དབུས་ཀྱི་རྒྱལ་ཁམས་ཀུན་བདེ་བར་འདུགས་ཆེན་པོ་ལ་བཞུགས།",
    "གྲུ་ཁ་དེ་ན་ཤན་སྟོང་ཕྲག་གསུམ་ཙམ་འདུག་ཆུ་ཕར་ཁ་ན་རྒྱལ་ཆས་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པའི་གླང་པོ་ཆེ་སུམ་ཅུ་ཙམ་ལ་རྒྱུན་དུ་མས་མཛེས་པར་བྱས་ཤིང་།",
    "ཕྱི་ན་བསུ་བའི་བཀོད་པ་ཅི་འདུག་ནང་ན་ཡང་འདུག་ཅིང་།",
    "ཁྱད་པར་གསེར་གྱི་ཁྲབ་རྨོག་ཁོ་ན་གྱོན་པ་ཉིས་བརྒྱ་ཙམ་འདུག་མཇལ་འཛོམ་གྱི་ཁང་པ་དེའི་སྒོ་ལྷོར་ལྟ་བ་རིམ་པ་ལྔའི་ནང་མ་གསེར་འབའ་ཞིག་ལས་བྱས་པ།",
    "དེ་ནས་གོང་མའི་མདུན་དུ་རྩེ་སྣ་རྣམས་མུས་ཀྱིས་ཡོང་འདུག་འབྱོན་དུས་གོང་མ་མཆོད་ཡོན་སྒོ་དབུས་མ་ལ་བྱོན་ངེད་རྣམས་གཡོན་ལ་འགྲོ་བ་བཅོལ།",
    "ལས་ཀ་ཅན་གྱི་མི་ཆེན་འབུམ་ཕྲག་ལྔ་ཙམ་གྱིས་ཕྱག་འབུལ་འདུག་སྟག་གཉིས།",
    "རྒྱ་བན་སུམ་སྟོང་ཙམ་གྱིས་ཉེས་པ་བྱས་པའི་དོན་ལ་བཙོན་དུ་བཟུང་ནས་ཤི་བའི་ཉེན་འདུག་པ་ཞལ་ཏ་མཛད་དེ་སྲོག་བསྐྱབས།",
    "སྔར་དྲུང་རང་བྱུང་བའི་དུས་ནས་ཚལ་པས་ཕུལ་བའི་གཡོར་པོ་དོལ་གྱི་མཆོད་གཞིས་རྣམས།",
    "རིང་པོ་མི་ཐོགས་པར་གཞན་དོན་རྒྱ་ཆེན་པོ་གཞན་ཞིག་ཡོང་བར་འདུག་གསུང་ནས་ཐ་མའི་མཛད་པ་ལུང་དུ་བསྟན།",
    "ཤེས་པར་འདུག་འཆད།",
    "མདུན་ན་གྲུམ་ཟེ་ཞིག་བཏིང་འདུག་པ་ལ་དེར་བཞུགས་གསུངས་ནས།",
    "སྒར་པའི་གསེར་ཐོག་འགྲུབ་པར་འདུག་སྟེ།",
    "སྤང་གཤོངས་ཤིན་ཏུ་བདེ་བར་ཆ་ཐེར་དཀར་པོ་ཕུབ་འདུག་པའི་གསེབ་ཏུ་ཕྱིན་པས།",
    "ངེད་ཀོང་པོ་ཐམས་ཅད་ལ་བཀའ་དྲིན་ཆེ་བ་འདུག་ཕྱག་རྫས་དངོས་པོ་ལ་ཕོངས་པ་ནི་གནང་མི་དགོས།",
    "ང་མི་འཆི་བ་ཞིག་འོང་བར་གདའ།",
    "རྒྱ་བོད་ཀྱི་མཚམས་འདིར་སྨྱོན་པའི་བརྟུལ་ཞུགས་ཅན་ཞིག་སོགས་ང་ལ་སྤྲུལ་པ་བདུན་འོང་བར་འདུག་གསུངས།",
    "ན་མ་ཚར་བར་ཡུལ་གཞན་མི་སྤོ་འདུག།",
    "མེ་ཏོག་ཡུ་བ་ཅན་འོད་དང་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ཆར་བབ་པའི་ནང་ནསཞིག་དུས་ཕྱིས་རྟེན་སྒྲོམ་དུའང་བཞུགས།",
    "ཐོས་ནས་མཇལ་དུ་འགྲོ་བསམ་པ་ན་རྨི་ལམ་དུ་ཡུམ་གྱི་པང་ན་བཞུགས་འདུག་པ་ལ་དབུ་ཞྭ་སོགས་ཕུལ་བ་རྨིས་པ།",
    "རྗེ་གོང་མ་རྣམས་ཀྱིས་ཟླ་བ་འདི་ལ་གསུང་འདི་བྱོན་པ་སོགས་འདུག་གྲུབ་རྟགས་མང་དུ་བསྟན་འདུག་པ།",
    "ས་ར་ཧ་པས་མདའ་བསྲང་ཚུལ་མཛད་འདུག་པ་ཨེ་མཐོང་།",
    "བྱང་ཕྱོགས་ན་ཕ་དམ་པ་བར་ཐུལ་མན་ནས་བཞུགས་འདུག་འདི་རྣམས་ཁོ་བོ་ཡིན་གསུངས།",
    "དེར་ཕེབས་ཙ་ན་དྲུང་གོང་མའི་གཟིམ་གུར་བཤམས་ཡོད་པའི་ནང་དུ་ཕེབས་ནས་ངའི་ཡིན་གསུངས་ཤིང་།",
    "འདི་སྒྲོལ་མ་འདི་ཕྱག་དྲུག་པར་འདུག་གསུངས་ཤིང་ལྗགས་ཀློག་མ་ཕུལ་བའི་སྐབས་ཡིན་རུང་།",
    "ད་དུང་སློབ་དཔོན་པདྨའི་སྐུ་ཡོད་འདུག་པའང་ཕུལ་དགོས་གསུངས་པར་དད་གུས་བླ་ལྷག་ཏུ་སྐྱེས།",
    "ད་འགྱུར་འདུག་མི་འགྲོ་གསུངས།",
    "བོ་རོ་ཙ་ནི།",
    "མི་ཆེན་གྱི་གྲལ་གྱི་ཚུལ་མ་གཏོགས་སྡོད་ལུགས་གང་བྱུང་དང་ལག་པ་འགྲམ་པ་ལ་བརྟེན་པ་སོགས་མྱ་ངན་གྱི་འདུག་སྟངས་མི་བྱེད།",
    "ཀོང་པོའི་ནས་རིགས་སུ་འདུག་པ་བཅས་ཤེས་ཏེ།",
    "ཁོ་རང་གཙུག་ཕུད་བྲེག་ཅིང་བསྟན་པ་ལ་འཇུག་པར་ཞུས།",
    "འཚོལ་བའི་བཀའ་གནང་བས་རྙེད་དེ་དབུས་མ་དེ་ལ་གསུང་ཆོག་དུས་ཀྱི་གཎྜི་མཛད།",
    "ཕྱག་དཔེ་སྩལ་ནས་གང་གཞན་ལུགས་འདྲེས་པའམ་ཁྱད་ཐོན་གྱི་ཟུར་ཆ་གང་འདུག་ལ་ཤོག་གཟེར་ཐོབ་ཅེས་གནང་བ་ལྟར་མཛད་ནས་ཕུལ་བས།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པ་དེ་གཞན་དང་རང་མི་འདྲ།",
    "ཐེལ་གྱི་གོས་བྱེད་དགོས་པ་འཆར་བ་ནས་ཡང་ཡང་མཇལ་དཀའ་བར་འདུག་པས་གུས་ཕྱག་ནན་བསྐྱར་དང་སྨོན་འདུན་གསོལ།",
    "རྗེ་འདི་ལ་པཎ་ཆེན་ནས་བསྔགས་བརྗོད་དཔེ་མེད་མཛད་འདུག།",
    "ཏཱ་ར་ནཱ་ཐས་འགོས་ལོས་ཕྱག་ཆེན་གྱི་ཞེན་རྐེ་ཆད་ཆད་ལ་འཐེན་ཀྱིན་བསྡད་པས་པཎ་ཆེན་འདི་དང་ཐུག་པ་ན་སྔགས་རྒྱུད་རྒྱ་མཚོ་ཙམ་བཤོལ་འདུག་གསུངས་པ་དེའོ།",
    "ཁྲོམ་དེའི་ཁྲོད་ན་མི་ངུ་བ་སུ་ཡང་མི་འདུག་ང་ལས་མགོ་མ་ཁྲེགས་པའི་མི་མེད།",
    "དེ་ནས་ད་ནི་རྗེ་ཐམས་ཅད་མཁྱེན་པ་མཇལ་དགོས་པར་འདུག་གསུངས་ནས་སྒར་ཆེན་གཙང་ནས་སྐྱི་ཤོད་དུ་ཕེབས་ཚེ་སྐུ་ཅུང་ཟད་བསྙུན་བཞིན་མཇལ་དུ་བྱོན།",
    "ཁྱེད་རང་རྣམས་འདི་གཉིས་ཀྱིས་སྡུག་ཏུ་མི་འཇུག་གསུངས།",
    "ད་ཁྱེད་ངའི་རྩར་བྱོན་བྱུང་བས་འགྱོད་མི་དགོས་པར་འདུག་གསུངས།",
    "ལྕགས་ཕྲེང་ཞིག་ཡོད་པ་གོང་བུ་གཅིག་ཏུ་ཞུ་ཡང་ཁོང་རང་ལ་ཅུང་ཟད་ཀྱང་གནོད་མ་ནུས་པ་སོགས་སོ།",
    "དགུང་ལོ་ཉེར་གསུམ་ལ་ད་ནི་དགེ་སྦྱོར་ཆུ་བོ་རྒྱུན་གྱི་རྣལ་འབྱོར་ཀླུངས་སུ་ཆུད་པར་བྱེད་པ་ལ་དབེན་པ་གཅིག་བསྟེན་དགོས་པར་འདུག་སྙམ་དུ་དགོངས་ཏེ་ཞུས་པ་ན།",
    "འདིའི་གནས་ནི་ཡང་རང་བཞིན་གྱི་རྣམ་པར་དག་པའི་དུས་ཀྱི་ཚེ་ནའང་དག་དོན་གྱི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡང་དམིགས་སུ་མེད་པའི་རང་།",
    "རྒྱལ་པོའང་བདེ་སྤྱོད་དུ་གྱུར་འདུག་པས་སློབ་དཔོན་ལ་གུས་མཆོད་ཕུལབཅུད་ལེན་དང་གནོད་སྦྱིན་མངག་གཞུག་ཏུ་གྲུབ།",
    "དེ་ནི་གཞན་སྟོང་པ་ཡིན་ཞིང་ལམ་འབྲས་སོགས་ལ་བརྟག་ན་མི་གཅིག་པའི་ངེས་པ་ཡང་མི་འདུག་གོ།",
    "དེ་ནས་སད་ཙ་ན་རྒྱལ་པོ་ཤིན་ཏུ་དད།",
    "བུ་ལ་ཕྱག་དར་བའི་དྲུང་ནས་མི་འཆི་བའི་གདམས་པ་ཞུས་ཤིག་ཅེས་བསྐུལ་བ་ལྟར་ཞུས་པས་རྫའི་བུམ་སྟོང་ཞིག་ཏུ་ལག་པ་ཆུག་ལ་ཅི་འདུག་པ་མྱུར་བར་སྨྱོས་གསུངས་པས་རྒྱལ་པོས་ཅི་ཡང་མི་འདུག་ཞུས་པས།",
    "ཕྱི་ཞིག་ན་དེ་བ་ཧུ་རཱི་ཞེས་པ་དེ་ཞིང་ཐམས་ཅད་དུ་བཙལ་ཀྱང་མ་རྙེད་པརབི་ཀོ་ཊར་ཤིང་ཤི་སྨྲའི་སྡོང་པོའི་ཁོང་ནང་དུ་རྡུལ་ཕྲན་གཅིག་ལ་བརྫུས་ནས་འདུག་པ་དེའི་ཅོ་ཏོ་ནས་དྲངས་ཏེ་གྲུབ་པའི་རལ་གྲིས་བསྣུན་ནས་ཚར་བཅད་དོ།",
    "དེ་ནས་མཁའ་འགྲོས་ལུང་བསྟན་ཏེ་མ་ཏདྷི་པ་བཙལ་བས་དེ་ནི་མི་གཞན་ལས་ཉིས་འགྱུར་གྱིས་ཆེ་བ་ཞིག་འདུག་པར་དཔལ་གསང་བ་འདུས་པ་འཕགས་སྐོར་སོགས་ཞུས།",
    "ཡན་ལག་དུས་དགྲ་ནག་པོ་སྟེ།",
    "ཁོ་རང་ཁྲོས་ནས་མཐུ་བྱས་པས་ཉེ་དུ་ཐམས་ཅད་ཁ་བཏག་ཡི་ཆད་པས་ཉེ་དུ་རྣམས་གསོས་ནས་གཏད་པས་ཁོ་དད་དེ་གདམས་པ་ཞུས་པས་གྲུབ་ཐོབ་ཉི་ཟླ་འཛིན་ཞེས་པར་གྱུར།",
    "དོན་ཤེས་ཟེར་བ་རྫུན་དུ་གདའ་ཟེར།",
    "ཞེས་པའང་འདུག་དེ་ནས་ཤར་ཕྱོགས་སུ་ཏེ་ལོ་འཚོལ་དུ་ཕེབས་པར།",
    "དེ་ལ་ཞེན་ཞེན་ལྟར་མཛད་འདུག་པས།",
    "བློན་པོའི་ཆུང་མ་འགྲོ་ཡང་བག་མ་ཞིག་འགྲོ་ཡིན་འདུག་པ་ལ་ཡང་སྔ་མ་ལྟར་གསུངས་བ་དང་།",
    "འདིར་ཆུ་དང་མེ་ཏོག་མི་འདུག་ཞུས་པས།",
    "རྩོད་པར་ཞུས་པས་རྒྱལ་བའི་བསྟན་པ་ལ་ཕན་པར་དགོངས་ནས་དེའི་ནང་པར་རྩོད་པ་མཛད་ཙ་ན།",
    "དེ་སྐབས་ཇོ་བོ་རྗེ་དབུས་ཀྱི་ཀ་ཆེན་ཛྷཱན་ཤྲཱི་མི་ཏྲའི་ཉེ་གནས་ཡིན་འདུག་ནཱ་རོ་པ་རྒྱ་གར་ཤར་ཕྱོགས་སུ་བྱོན་པ་ལྗོངས་མེ་ཏོག་རྒྱས་པར་དཔལ་ནཱ་རོ་པ་དང་མཇལ།",
    "པནྡི་ཏ་དེ་ནི་ནཱ་རོ་པས་ཀྱང་ཞེས་འབུལ་དགོས་པ་ཞིག་འདུག་ཅིང་།",
    "དེ་ནས་གཉོས་དང་འཕྲད་དེ་འབེལ་གཏམ་མཛད་པ་ཁོ་རང་མི་སྨྲ་བར་གྱུར།",
    "དུས་དེར་བོད་རྣམས་བདེ་དགྱེས་གསང་གསུམ་ཁོ་ན་ཟེར་བའི་སྐབས་ཡིན་འདུག་པས།",
    "ཚེམས་མཆེ་བའི་སྒྲོམ་གྱི་ནང་དུ་སྔར་མེད་པའི་ཏཱ་ལའི་ལོ་མ་ལ་ལི་ཁྲིས་སིངྒ་ལའི་ཡི་གེར་བྲིས་པའི་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྒྲུབ་ཐབས་འདུག་པ་མཁའ་འགྲོས་གནང་བར་གོ་ནས།",
    "འབེལ་གཏམས་མཛད་ཚུལ་རྣམས་མི་འདུག་ཀྱང་།",
    "བསྲེ་འཕོ་སོགས་གནང་བ་ཡིན་ཟེར་གྱིན་འདུག་ཟེར་བ་སྣང་།",
    "རྒྱ་གར་བ་གཉིས་ཀྱང་གསང་འདུས་ཞུས་མ་རྙེད་ནས་རྗེ་མར་པའི་དྲུང་དུ་གསང་འདུས་ཞུ་བ་ལ་འོང་བ་དང་འཕྲད་དེ་རྗེ་མར་པའང་གཤེགས་ནས་མི་བཞུགས་པས་ཁོང་གསུམ་ཀས་མཚུར་སྟོན་ལ་འདུས་པ་ཞུས་པ་ཡིན་འདུག་ཅིང་།",
    "བོད་འདིར་མར་འགོས་གཉིས་ཞེས་འདྲ་མཉམ་དུ་བྱེད་ཀྱི་འདུག་ནའང་།",
    "མས་དབུས་ཁྱིམ་སོའང་ཟིན་འདུག་པས་ཕ་ནོར་རྣམས་ཕྱིར་སྤྲོད་དྲངས།",
