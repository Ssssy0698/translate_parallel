    "བཅོམ་ལྡན་འདས་གཟུགས་སྐྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ནི་སྨོས་སུ་མ་མཆིས་པའོ།",
    "བཅོམ་ལྡན་འདསརྣམ་པར་ཐར་བརྣམས་ནི་སྨོས་སུམ་མཆིས་པའོ།",
    "བཅོམ་ལྡན་འདས་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པརྣམསནི་མཚནམམམཆིས།",
    "བཅོམ་ལྡན་འདས་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ན་སྤོས་སུ་མ་མཆིས་པའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་ཐར་བའི་སྒོ་སྟོང་པ་ཉིད་དང་།",
    "བཅོམ་ལྡན་འདས་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ནི་མཚན་མམམཆེས།",
    "བཅོམ་ལྡན་འདས་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམཨནི་སྨོས་སུ་མ་མཆིས་པའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་བ་ཐམསཅད་མཁྱེན་བཉིད་ནིམཚན་མ་མམཆིས།",
    "བཅོམ་ལྡན་འདས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་སྨོསསུ་མ་མཆིས་པའོ།",
    "གལ་ཏེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཚན་མ་མ་མཆིས་པ་ཞིག་ལགས་ཏེ།",
    "སྨོས་སུ་མ་མཆིས་པར་ཐུགས་སུ་ཆུད་དེ།",
    "དེ་ནི་ནིམ་བླན་མྱེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱང་ཆུ་བཏུ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་གྱི་རྒྱུད་ཀྱི་དོགས་པམམཆིས་པར་བགྱིའོ།",
    "སེམསཅན་ཡོངསསུ་སྨིན་པར་བགྱི་བ་དང་ཡང་མྱི་འབྲལ་བར་འགྱུར་ཏེ།",
    "ཀློག་ཅིང་ཀུན་ཆུབ་པར་བགྱིད་པ་དང་།",
    "ད་ན་ཕྱིར་མྱྀ་ལྡོག་པའི་ས་ལ་གནས་པར་རིག་པར་བགྱིའོ།",
    "ཀུན་ཆུབ་པར་བགྱིད་དོ།",
    "ཀུན་ཆུབ་པར་བགྱིད་པ་དང་།",
    "བཅོམ་ལྡན་འདས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་གང་ལགས་པ་དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་ཡོངས་སུ་བསྒྲུབས་པར་བལྟའོ།",
    "འདིལས་བྱུང་བནི་དི་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་དེ་བཞིན་གཤགས་པའི་སྟོབས་བཅུའོ།",
    "འདི་ལས་བྱུང་བའི་སོ་ས་ཡང་དག་པར་རིག་པ་བཞིའོ།",
    "གླགས་རྙེད་པར་ཕྱི་འགྱུར་ཏེ།",
    "འདུས་པའི་བྲོ་དེ་ཡང་ཞི་བར་འགྱུར་ཞིང་རྣམ་པར་མི་འཕེལ་ལོ།",
    "རན་པ་ཕུན་སུམ་ཚོགས་པར་བགྱིད་དོ།",
    "ཆབ་རྟོགས་པཅན་གྱི་ནང་དུ་སྩལན་བརྒྱད་དང་ལྡན་ཞིང་ཁ་དོག་གཅིག་པར་འགྱུར་རོ།",
    "མྱིམ་ལགས་པ་ལས་གྱུར་པ་ཐམས་ཅང་ཀྱང་མམཆིས་པར་འགྱུར་ཏེ།",
    "རྣམ་པོ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཚིག་བླདྭགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པའི་ཡོན་ཏན་ལྟ་ཅི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོན་ཏན་ལྟ་ཅི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོན་ཏན་ལྟ་ཇི་སྙེདཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "ཡོན་ཏན་ལྷ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཕྱི་སྟོང་བ་ཉིད་ཀྱི་ཡོན་ཏནརྗོད་པར་བགྱི་སྟེ།",
    "བཅོསྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཆེན་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་དོན་དུམ་པ་ད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འགས་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཅི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "འདུས་བྱས་སྟོང་པ་ཇིསྙེད་ཅིག་བརྗོད་པར་བགྱིསྟེ།་",
    "དེ་བཞིནུགཤེགས་པའི་སྐུ་གདུང་དེ་དག་ཀྱང་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་ཡོན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་ང་དག་ཀྱང་འདུས་མ་བྱསབཅོམ་ལྡན་འདས་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སཱ་དཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདུས་ཐོགས་དང་ཐམ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་དོར་བསྐྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇིས་དཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སུད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་དངོས་པོ་སྐྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྐད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་དངོས་པོ་མྱེདབཉིད་སྟོང་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་དྲན་པཉེ་བརགཞག་པ་བཞིའི་ཡོན་ཏན་ལྟ་ད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཡང་དག་པར་སྤོང་བ་བཞིའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "ཡང་དག་པར་སྡོང་བརྣམས་ཀྱི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་རྫུ་འཕྲུལ་གྱི་རྐངཔ་བཞིའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འོངས་སྐྱོབས་ལྔའི་ཡོན་ཏན་ལྕེ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་འཕགས་པའི་ལམ་ཡན་ད་པའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིགེ་བརྗོད་པར་བགྱི་སྟེ།",
    "དེ་བཞིན་གཤགས་པའི་སྐུ་གདུང་དེ་དག་ཀྱང་།",
    "བཅོམ་ལྡན་འདས་བསམ་གཏན་བཞིའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞིའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "གཟུགས་སྤྱོད་པའི་སྙོམས་པར་འཇུག་པརྣམས་ཀྱི་ཡོན་ཏནནི་ཚེད་མམཆིས་སོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པརྣམས་ཀྱི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུའི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "དེ་བཞིན་གཤིགས་པའི་སྐུ་གདུང་དེ་དག་ཀྱང་མཐར་བྱས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་སྣོད་དོ།",
    "སྨོན་པ་མྱེད་པའི་ཡོན་ཏན་ལྟ་ཇསྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཏིང་ངེ་འཛན་རྣམས་ཀྱི་ཡོནཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་མི་འཇིགས་པ་བཞིའི་ཡོན་ཏན་ལྟ་ཇི་སྙེདཚིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིའི་ཡོནཏན་ལྟཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "སོསོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་ཐམས་ཅད་ཤེས་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྐད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ལམ་གྱིརྣམ་པ་ཤེས་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་ཡོན་ཏནན་ཚེདྲམ་མཆིས་སོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པ་ཐམསཅདམཁྱེན་པ་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྐྱིད་ཅིག་བརྗོང་བར་བགྱི་སྟེ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡོན་ཏནན་ཚདམ་མཆིས་སོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སྣོད་དོ།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིནི་ཉིདི་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།་",
    "བཅོམ་ལྡན་འདས་མནར་བ་དེ་བཞིན་ཉིད་ཀྱི་ཡོན་ཏན་ལྟ་ཇི་སྙེད་ཅིག་བརྗོད་པར་བགྱི་སྟེ།",
