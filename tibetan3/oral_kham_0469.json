    "དུག་ལྔ་སྐྱེ་དུས་ངོས་གཟུང་རང་གློད་པས།",
    "འཛིན་པའི་སེམས་དང་རང་བཞིན་བྲལ་བ་ཡིན།",
    "སེམས་ཉིད་ཡེ་ཤེས་ཀྱི་ངང་དུ་འདུས་པའི་ཚེ་ཡིན་པས་དེའི་དུས་སུ་འཛིན་པའི་སེམས་དང་རང་བཞིན་བྲལ་བ་ཡིན་པ་དང་།",
    "གཞན་མགོ་གནས་སྐབས་འདོན་མ་ཐུབ་ཀྱང་རང་མགོ་ཐོན་པ་ཞིག་རན་པའི་དུས་ལ་བབས་ཡོད་དེ།",
    "འདིར་བཞུགས་རྣམ་པ་ཡང་སང་ཉིན་ནས་མང་ཆེ་བ་རང་རང་སོ་སོའི་ཕྱོགས་སུ་ཕེབས་རན་པ་ཡིན་པ་ནི།",
    "བླངས་ནས་ཐིག་ལེ་བགྱིས་ན་མི་གདའ་བར་འགྱུར།",
    "སལ་དཀྱིལ་གྲུ་བཞིར་སྦྱོངལ་དུ་བྱུགསའདུའི་སྟན་བཏིལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས་གཙང་སྤྲུལ།",
    "ཆུ་ཤིང་ལོ་མའི་དབྱིབས་འདུག།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "བདག་འདུག་པ་དང་བགེགས་ཐམས་ཅད་མི་འབྱུང་ཞིང་རིག་དྲང་སྲོང་སྨྲསསོ།",
    "ཤིནཏུམཉམགཞག་དུས་གསུམདུ།",
    "ཤརཕྱོགསལ་འདུག་པར།",
    "ཤིན་ཏུ་མཉམ་གཞག་དུས་གསུམ་དུ།",
    "ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས།",
    "ཚུལ་ཇི་ལྟ་བ་བཞིན་དུའདུག་བཟླས་བརྗོད་བྱེད་ཅིང་མི་བརྗོད་པར་བྱའོ།",
    "མར་དང་འོ་ཐུག་སྦྱིན་ཞིང་ཀུ་གའི་ཁྲལ་འདུག་སྟེ།",
    "བདག་ཀྱང་གཞན་ཞིང་རང་བཞིན་གཞན།",
    "སྐྱེས་བུ་དག་ལོངས་སྤྱོད་དང་སྤྱོད་པ་པོའི་ངོ་བོར་གཅིག་པ་ཉིད་དུ་ཡོད་པ་དེའི་ཚེ་ཡང་རང་བཞིན་ནི་བདག་གོ་ཞེས་བྱ་བའི་ཤེས་པར་སྐྱེ་བར་མི་རིགས་ཏེ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི།",
    "ཞབས་གཉིས་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པ།",
    "བུ་བན་ཆུང་རང་སྣང་བ་གང་བདེར་བཞུད།",
    "ལར་ཚེ་འདི་ཡུད་ཙམ་གཅིག་ཏུ་འདུག།",
    "གཅིག་པུར་འདུག་དུས་བཙུན་ཚུགས་བཟུང་བ་མཆོག།",
    "དུས་མིན་འགྲོ་དོན་གཉིས་མེད་སེང་གེར་འགྲོ།",
    "ཕྱོགས་རིས་མེད་ཀྱང་རང་རྐང་བཟུང་ན་འཚོང་།",
    "འདུག་ཚུལ་འདི་བཞི་སེམས་ལ་སྐོར་རྫོགས་བྱ།",
    "སེམས་རྒྱུད་ཐུལ་ན་འདུག་ས་གར་ཡང་འདྲ།",
    "ཟབ་ཀྱང་ཡིད་ཡུལ་འདུག་པའི་གོ་བ་བསལ།",
    "ཅེས་གང་དྲན་ཟོལ་བྱུང་བརྗོད་པའི་ནེ་ཙོའི་པདྨེ་འདི་ནི་རང་ལོ་ཉེར་བཞི་བར་དཔལ་སྤུངས་སྒྲུབ་ཁང་དུ་སྡོད་སྐབས་བྲིས་པར་གདའོ།",
    "སྐྱོན་མཚང་རང་ལ་ཡོད་དོ་དིང་རི་བ།",
    "མཐོ་ཡང་རང་ལ་མི་ཕན་ཀུན་དང་འགྲས།",
    "མཁས་ཀྱང་རང་རྒྱུད་མི་ཁྲོལ་རྩོད་པ་འཕེལ།",
    "ནམ་ཕུགས་མི་རྟག་ངེས་ཀྱང་འདུག་ཆུས་གཟབ།",
    "ཟས་ནོར་འཁོར་ལ་ཆགས་ཞེན་ཆེ་འདུག་ན།",
    "ཀྱེ་མ་ལུང་དུས་བསྟན་པའི་མཇུག་དུས་སྐྱེས།",
    "ཞེས་པའང་རང་གཞན་ལ་ཉེ་བར་མཁོ་བས་མཚམས་སྦྱར་ཏེ།",
    "དེ་ནས་བསྔོ་སྔགས་ཟུར་པ་འགའ་ཞིག་འདུག་པ་འབྱུང་ཁུངས་དང་ལུང་།",
    "ཞེས་ལན་གསུམ་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་རྒྱུད་ལ་སྐྱབས་སུ་འགྲོ་བའི་སྡོམ་པ་སྐྱེས་པར་བསམ།",
    "སེམས་མཆོག་བསྐྱེད་ཅིང་རང་འདོད་ཕུག་ཏུ་བཅུག།",
    "གཉིད་ལོག་མྱོས་ཤིང་རང་མྱོས་རྣམས།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "ཞག་དུས་ཀྱི་སྲི་དང་།",
    "ཡོས་ཀྱི་ཟླ་བ་བཅུ་གཉིས་དང་ཞག་དུས་ཀྱི་སྐག་གྱུར་ཅིག།",
    "སྦྲུལ་གྱི་ཟླ་བ་གཉིས་པ་དང་ཞག་དུས་ཀྱི་སྐག་གྱུར་ཅིག།",
    "རྟ་ཡི་ཟླ་བ་གསུམ་པ་དང་ཞག་དུས་ཀྱི་སྐག་གྱུར་ཅིག།",
    "སྦྲེལ་གྱི་ཟླ་བ་ལྔ་པ་དང་ཞག་དུས་ཀྱི་སྐག་གྱུར་ཅིག།",
    "བྱའི་ཟླ་བ་དྲུག་པ་དང་ཞག་དུས་ཀྱི་སྐག་གྱུར་ཅིག།",
    "ཁྱི་ཟླ་བ་བདུན་པ་དང་ཞག་དུས་ཀྱི་སྐག་གྱུར་ཅིག།",
    "ཨོ་རྒྱན་དུས་གསུམ་མཁྱེན་པའི་ཐུགས་རྗེ་ཡིསའཁྲུལ་སྣང་རང་སར་གྲོལ་བར་ཐེ་ཚོམ་མེད",
    "དུས་ངན་དེ་འདྲའི་དུས་ལ་སླེབ་ཙ་ན",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་ཀྱང་།",
    "ཕྱག་ལེན་གྱི་རྒྱུན་འདྲ་མིན་མང་པོ་འདུག་ཅིང་།",
    "མ་གཅིག་དུས་གསུམ་རྒྱལ་བ་ཀུན་གྱི་ཡུམ།",
    "ཨ་ར་པ་ཙ་ན་ཡ་ཏེ་ན་མ།",
    "ཛ་དྲག་དུས་གཏུགས་རང་བཞིན་གྱི་ཕྱག་དེབ་འདོན་སྤེལ་གྱི་ལས་གཞི།",
    "འཁྲུལ་པ་ཡིན་ཡང་རང་མཚན་སྣང་བ་ལ་བལྟོས་ཏེ་འཁྲུལ་པའི་བློ་ལས་འགྲོ་ས་མེད་ཀྱང་།",
    "རང་རང་སོ་སོས་སྡུག་བསྔལ་གྱི་ཁུང་བུའི་ནང་དུ་འཛུལ་བ་ལྟ་བུ་ཞིག་ཆགས་ཡོད།",
    "ཆུས་གནོད་པ་སྐྱེལ་གྱི་འདུག་ན་ཆུ་དེའི་ཆུ་རྩ་ནས་འགོག་པའི་ཐབས་ཤེས་བྱེད་དགོས་པ་ལྟར།",
    "དེ་ཡང་རང་བཞིན་གྱིས་འགྱུར་བ་འགྲོ་བ་ཞིག་ཡིན་པས་ན།",
    "བརྩོན་འགྲུས་སོགས་ཀྱི་ཉམས་ལེན་གང་འདྲ་ཞིག་འདུག་གམ།",
    "ཞེས་དུས་ཚོད་ག་དུས་ཡོད་ཀྱང་།",
    "ཞེས་ཕ་ཡུལ་སྤོང་བ་རྒྱལ་སྲས་ལག་ལེན་དུ་གསུངས་འདུག་ཅིང་།",
    "ཨ་ཙི་མི་གཙང་བར་གཙང་བར་ཞེན་པས་མགོ་སྐོར་འདི་ལྟར་ཐེབས་ཀྱི་འདུག་མགོ་ལོག་འདི་འདྲ་རྩེད་ཀྱི་འདུག་བསམ་པ་དང་།",
    "ང་རང་བཞིན་གྱིས་མ་གྲུབ་བཞིན་དུ་ང་རང་བཞིན་གྱིས་གྲུབ་པར་འཛིན་པའི་ངར་འཛིན་དེས་གཞི་བྱས་པ་ཧ་ཅང་གསལ་པོ་ཡིན།",
    "གདེང་དང་ལྡན་པ་ཞིག་འདུག་ན་བཤེས་གཉེན་དུ་བྱས་ཤིང་།",
    "སེམས་འཕང་འདི་ཙམ་ཞིག་བྱས་ན་རྒོད་པ་སྐྱེ་བ་འདུག་བསམ་པའི་སེམས་འཕང་མཐོ་པོ་ཆགས་ན།",
