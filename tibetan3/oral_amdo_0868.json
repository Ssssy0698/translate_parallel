    "ཀྱེ་མ་ཡབ་གཅིག་བདག་གི་སྐྱབས།",
    "བདག་གིས་དེ་ཙམ་བསྒྲུབས་ཀྱང་རྟགས་མ་བྱུང་ན་ཐུགས་རྗེ་རེ་ཆུང་ཞེས་འཁངས་པས།",
    "ང་དང་པོ་ནས་ཡོངས་ཏེ་ཁྱོད་རང་གི་སྒྲིབ་པས་མ་མཐོང་ལ།",
    "ཡིད་མི་ཆེས་ན་ཁྱོད་རང་ཕྲག་པར་ཁུར་ལ་སྟོན་ཅིག་གསུངས་ནས་ཁྲོམ་གྱི་དབུས་སུ་ཕྱིན་ཏེ་བསྟན་པས་སུས་ཀྱང་མ་མཐོང་བས་ཡིད་ཆེས།",
    "ཁྱོད་ཅི་འདོད་གསུངས་པ་ལ་ཐེག་ཆེན་དར་བར་ཞུ་འཚལ་བྱས་པས།",
    "གཞོན་ནུ་ནས་ཁ་ཆེར་སློབ་དཔོན་ཆེན་པོ་འདུས་བཟང་གི་དྲུང་དུ་ཕྱིན།",
    "ཁྱོད་ནི་སྐྱེ་བ་ལྔ་བརྒྱར་པཎྜི་ཏར་གྱུར་པས་སྐྱེས་ཐོབ་ཀྱི་ཤེས་རབ་ཆེ་བ་ཡིན།",
    "ཁྱོད་སོ་སོ་སྐྱེ་༥",
    "བྱ་ཡི་གྲེ་བར་སོང་བ་མེད།",
    "ཁོ་བསྟན་བཅོས་རྩོམ་པ་ལ་མཁས་པས་ཚིག་གི་རྒྱན་ཡིན་ཟེར།",
    "ཁྱོད་ཀྱི་སློབ་དཔོན་སུ་ཡིན་བྱས་པས།",
    "ངུ་མི་དགོས་ངས་ཁྱོད་ལ་བྱིན་གྱིས་བརླབས་ཀྱི་ཁྱིམ་དུ་སོང་གསུངས་དེ་ནས་མཁྱེན་རབ་ཐོགས་མེད་དུ་གྱུར་ལ།",
    "བདག་མ་རྙེད་ནས་ཕྱི་ནང་གིས་བསྒྲིབས་སམ་སྙམ་ནས་ཕྱོགས་བཞིར་མར་མེ་བཞི་སྤར།",
    "དེ་རིགས་པས་སུན་འབྱིན་ནུས་མོད་ཀྱི་འོས་མིན་ནོ་སྙམ་ནས་ནཱ་ལེནྡྲར་བྱོན་ཏེ།",
    "དབྱིག་གཉེན་གཤེགས་ནས་རི་བོ་འབིགས་བྱེད་ཀྱི་ངོས་སུ་བཞུགས་ཏེ་རང་གི་བསྟན་བཅོས་ཐོར་བ་རྣམས་གཅིག་ཏུ་བསྡུ་བར་བཞེད་ནས།",
    "ཞེས་བྲིས་པའི་མོད་ལ་ས་གཡོ་བ་དང་།",
    "མུ་སྟེགས་ཀྱི་སྟོན་པ་དག་ཤིང་བཞིན་དུ་རེངས་པའི་ལྟས་ཁྱད་པར་ཅན་དུ་མ་བྱུང་།",
    "དེར་དེའི་ཉེ་ལོགས་ན་མུ་སྟེགས་ཀྱི་སྟོན་པ་ཐུབ་རྒྱལ་ནག་པོ་ཞེས་བྱ་བ་ཞིག་ཡོད་པས་མངོན་ཤེས་ཕྲ་མོས་བལྟས་པས།",
    "ཀུན་ལས་བཏུས་ནི་མུན་པའི་ཀུན་ལས་བཏུས་ཞེས་སྨོད་པ་ལ་རང་གིས་འགྲེལ་པ་བྱས་ཏེ་མུ་སྟེགས་མང་པོ་ཚར་བཅད་པས།",
    "གཉིས་པ་ཞུས་པས་ཕྱོགས་གླང་གི་དགོངས་པ་བཞིན།",
    "ང་ལའང་ཁྱོད་ལྟ་བུ་ལས་མ་བྱུང་།",
    "པཎྜི་ཏའི་བྱ་བ་གཞན་ཡང་བྱ་དགོས་པས་རས་སྣུམ་སྟ་གོན་གྱིས་ཤིག་ནུབ་མོ་འཆད་དོ་གསུངས་ནས་དེ་ལྟར་བྱས་པས།",
    "ད་ཁྱོད་ཀྱིས་ངའི་ནོར་བ་རྣམས་ཕྱོགས་སྔར་གྱིས་ལ་ཀུན་ལས་བཏུས་ལ་འགྲེལ་པ་གྱིས་ཤིག་ཅེས་རྗེས་སུ་གནང་ངོ།",
