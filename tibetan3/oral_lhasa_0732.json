    "ཅེས་སུམ་ཅུ་པ་དང་རྟགས་ཀྱི་འཇུག་པའི་དོན་བསྡུས་སི་ཏུའི་དགོངས་རྒྱན་གྱིས་བཅད་དུ་དག་རིན་པས་བྲིས་པའོ། ། སུམ་ཅུ་བ་དང་རྟགས་ཀྱི་འཇུག་པ་ལས་བརྩམས་པའི་དྲིས་ཚིག་དཔྱིད་ཀྱི་ཕོ་ཉ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དབྱངས་ལྔ་ཡ་ར་ལ་ཝ་འི་འདོགས་གསུངས་ན།",
    "དེ་ཉིད་ཚེ་སྐབས་ལ་སྒྲ་ཡིན་གསུངས་ན།",
    "དངོས་སམ་ཤུགས་ཀྱིས་བྱེད་པ་མ་སྟོན་པར།",
    "ཤེས་བརྗོད་འཇུག་པར་བྱེད་ན་དངོས་པོ་དང་།",
    "ཅི་སོགས་མཚུངས་པར་འཇུག་པའི།",
    "མཁས་རྣམས་ཕྱག་བཞེས་མཐུན་པར་མཛད་འདི་ཅི།",
    "བེམས་པོར་འཇུག་གམ་ཤེས་པར་འཇུག་ཅེས་འདྲི།",
    "། མི་སྲིད་སྲིད་པར་མི་འགྱུར་རོ།",
    "བདག་སྒྲ་དངོས་དང་ཁྱད་པར་མེད་པས་ན།",
    "མེན་བཀུར་བ་བྱེད་དང་བཟླས་པར་བྱེད།",
    "བསྔགས་པར་བྱེད་དང་བགྲང་བར་བྱེད་ལ་སོགས།",
    "བྱེད་པའི་ལས་ལ་འཇུག་ན་བྱེད་པ་པར།",
    "འཇུག་པར་སེང་ན་ཁྱེད་ཅག་ཅི་སྟེ་སྨྲ།",
    "ཁྱད་པར་མེད་ཅིང་བ་ཡིག་དོན་མེད་འགྱུར།",
    "བ་ཡི་སྔོན་འཇུག་མེད་ཀྱང་འདས་པར་གེ།",
    "ཅེས་གསུངས་མ་ནིང་ག་ད་གཉིས་པ་ཡང་།",
    "ད་ལྟའི་དུས་ལ་འཇུག་པར་གཞུང་ལས་བཤད།",
    "གཅག་པར་འགྱུར་དང་དགབ་པར་འགྱུར་བ་སོགས།",
    "ལས་ལ་འབད་པར་བྱ་དང་འཇུག་པར་བྱ།",
    "འཇུག་པར་མཐོང་ན་བྱ་བར་མི་འཇུག་གང་།",
    "དུས་གཉིས་མ་གཏོགས་འདས་པར་འཇུག་མི་འཇུག།",
    "སྡང་དང་ཕྲག་དོག་མ་ལགས་བཟོད་མཛད་རིགས།",
    "། སྙན་ངག་ལེའུ་བར་པའི་དཔེར་བརྗོད་དབྱངས་ཅན་རྒྱུད་མངས་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ཟབ་ཞི་སྤྲོས་བྲལ་འོདགསལ་འདུས་མ་བྱས།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྤྱན་གྱི་འགྲན་ཟླར་འགྱུར།",
    "མཐར་བཞི་རྣམ་པར་གནོན་པའི་ངོ་མཚར་མཐོ།",
    "ཉི་ཟླ་འོད་དང་ལྡན་ཡང་མཁྱེན་ཆ་བྲལ།",
    "ཀླུ་སྒྲུབ་ཞབས་དང་མཚུངས་ཞེས་བརྗོད་པར་འདོད།",
    "ངོམས་མེད་འགྲན་པར་མཚུངས་ཀྱང་སོ་སེར་འགལ།",
    "དོན་དམ་བདེན་པས་སྟོང་པར་ལྟ་བ་དག།",
    "མཚུངས་པར་རློམས་ཀྱང་ཁྱད་པར་གནམ་སཙམ།་",
    "འདྲེན་པའི་ཐབས་ཚུལ་མཛད་ལ་ཁྱད་པར་མེད།",
    "རྣམ་གསུམ་ངུར་སྨྲིག་གྲོས་ཀྱིས་མཛེས་པ་ལགས།",
    "མཁྱེན་པས་རྗེ་བཙུན་བརྟན་པའི་འཁོར་ལོ་དང་།",
    "འཇིག་རྟེན་གསུམ་གྱི་ཁོང་ན་ཁྱབ་པར་བྱེད།",
    "ཐུགས་ཀྱི་བུམ་པར་བཟུང་བས་ག་ས་རིའི་ཁྲོད།",
    "སྣང་བར་བྱས་སོ་རྒྱལ་བའི་ཕྲིན་ལས་ཀྱིས།",
    "སྐྱེས་དགུས་ལེགས་བྱས་བརྩོན་པའི་འབྲས་བུ་དང་།",
    "དྲེགས་ལྡན་གླང་ཆེན་སྨྱོན་པརིང་དུ་བཏང་།",
    "མརིག་རྣམ་རྟོག་འཇོམས་པར་མི་ནུས་པས།",
    "འཁྲུལ་སྣང་བདེན་པར་བཟུང་བའི་ཞེན་ཡུལ་ནུབ།",
    "ལྷག་བསམ་རྣམ་པར་དཀའ་བའི་བསླབ་སྟོན་འདིས།",
    "གུས་ལྡན་སློབམའི་ལག་པད་ཟུམ་པར་བྱེད།",
    "ངག་དངབློ་ཡི་སྤོབས་པ་ཟུམ་པར་བྱེད་ དྲུག་པ་འགོག་པའི་རྒྱན་ཁ་ཉི་ཤུ་རྩ་གསུམ་ལས།",
    "དཔལ་ལྡན་བླམ་བཞུགས་སམ་མ་བཞུགས་ཞེས།",
    "མི་དཔྱོད་བཞུགས་ཀྱང་སྐུ་བརྙན་ཙམ་ཡིན་གྱི།",
    "མང་ཐོས་གདམས་པར་ཤར་བའི་བློ་རྙེད་ཀྱང་།",
    "བདག་ནི་དབེན་པར་འགྲོ་ཡིས་ཅི་དགར་གྱིས།",
    "རྩེ་གཅིག་མཉམ་པར་འཇོག་པའི་རྣལ་འབྱོར་ལ།",
    "འདི་ནང་ཁྱེད་ཚོའི་བསམ་པ་དང་མཐུན་པར།",
    "བདག་ཀྱང་འདོད་པའི་ཡུལ་ལ་འཇུག་པར་སྤྲོ།",
    "བུ་དང་ཆུང་མའང་དགྲ་ལ་སྦྱིན་པར་བྱེད།",
    "བརྩེ་བའི་ཁུར་ཆེན་བཞེས་པའི་བྱངསེམས་རྣམས།",
    "གཅིག་པུར་དབེན་པར་གཤེགས་པའི་ངང་ཚུལ་མཛེས།",
    "བདེན་གཉིས་མཉམ་པར་གཞལ་བའི་རིགས་པ་འདིས།",
    "བཟང་པོའི་ཞིང་ལས་ལོ་ཏོག་རྣམ་པར་འཕེལ།",
    "མ་བྲིས་སྲིད་པའི་འཁོར་ལོ་རྣམ་པར་བཀྲ།",
    "གླིང་བཞི་མཁའ་ལ་ཆགས་ཐོགས་མེད་པར་རྒྱུ།",
    "ཐེཚོམ་ཅིག་ཅར་ཆོད་པར་མཛད་པས་ན།",
    "ཅིག་ཅར་བསྡུས་ཏེ་དབེན་པར་གཤེགས་པའི་ཤུལ།",
    "ངེམ་པར་སྤྱོད་པའི་འཕུར་ལྡིང་མི་བྱེད་པར།",
    "ལང་ཤོར་ངན་པར་གོམས་པའི་དྲི་མ་འདི།",
    "འབྲེལ་ཚད་ཡང་དག་ལམ་ལ་འགོད་པར་བྱེད།",
    "མང་ཐོས་གདམས་པར་ཤར་བའི་བློ་མེད་པར།",
    "མཚན་ལྡན་བླམ་མཉེས་པར་མ་བྱས་ཤིང་།",
    "སེམས་ཀྱི་གནས་ཆ་ཙམ་ཡང་ཤེས་པར་དཀའ།",
    "བཞུགས་པའི་གམ་ནས་ལྷགས་པའི་དྲི་གཞོན་གྱིས།",
    "བུང་བ་སྦྲང་རྩིར་སྤྱོད་པའི་ཁྱད་པར་ཡིན།",
    "མི་གཙང་ལུས་ལ་བསྒོས་པའི་སྐྱེ་བོ་འགའ།",
    "ཙནྡན་དུད་པ་ཐོངས་། ཞེས་མཛེས་པར་སྒྲ།",
    "གཞོན་ནུའི་དུསནས་ཐ་སྙདམཁས་པར་སྦྱངས།",
    "ཞང་དོན་རིག་པ་ཙམ་ལའང་མ་ཆགས་པར།",
    "སྙནཚིག་རྩོམ་པས་རྒྱལ་བསྟན་མཛེས་པར་བྱེད།",
    "ཞིང་འདིར་བསྟན་འགྲོའི་དཔལ་དུ་བཞུགས་པ་ཡི།",
    "ལྗོངས་འདིའི་ལྷ་སྐལ་འབྲུག་པའི་གདུང་འཛིནཔ།",
    "ངལ་བརྒྱ་བསྟེན་པའི་དཀའ་ཚེགསམི་དགོས་པར།",
    "ལོ་མང་མཐུ་ཡི་ཁང་པར་མ་ཞུགས་ཤིང་།",
    "རལ་པའི་ཁུར་ཆེན་སྤྱི་བོར་འཆིང་མིན་པར།",
    "ཕྱག་སོར་བརྐྱངས་ཏེ་བཞེས་པར་མི་བཟོད་པར།",
    "སྦྱོར་གྲོལ་འཆལ་པར་སྤྱོད་པའི་སྒོམ་ཆེན་དག།",
    "ཞུམ་པར་མི་བྱ་སྐལ་ལྡན་གདུལ་བྱ་རྣམས།",
    "ཞག་འགའ་དབེན་པའི་གནས་སུ་གནང་བ་ཞུ།",
    "ཁྱེད་ཅག་མ་གྱེས་ལྷན་ཅིག་བཞུགས་འཚལ་ལོ།",
    "ཅིག་ཅར་གཞོམ་པར་མཛད་པའི་མཐུ་མ་པའ་ཡང་།",
    "བདུན་པ་ངེས་པར་འགོག་པའི་སྦྱར་བནི།",
    "གཉའ་ཁྲིའི་རིགས་ལས་བྱུང་བམ་ལགས་ཀྱང་།",
    "འཆི་མེད་བདུད་རྩིའང་མགྲིན་པར་མྱང་མིན་པར།",
    "རྣམ་པར་གཡེང་བའི་བློ་ཡང་རིམ་གྱིས་ཟད།",
    "སྤྲིན་དབྱངས་སྙན་པར་སྒྲོག་པ་ཉིད་ཀྱིསནི།",
    "ལྷགམ་མེད་པར་ཅིག་ཅར་ཉིད་དུ་ཕྲོགས།",
