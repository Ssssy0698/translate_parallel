    "འདི་ལྟར་གང་ཁོ་ནའི་རྗེས་སུ་འགྲོ་བ་དང་གང་ལྡོག་ན་ལྡོག་པ་དེ་ཉིད་དེས་ཁྱབ་པར་བརྗོད་དེ་དེའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་ན་ཁྱབ་པ་ཡིན་ནོ།",
    "འམ་གྱི་སྒྲས་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ནི་དོན་མཚུངས་པར་བསྟན་གྱི་ཚིག་ནི་མ་ཡིན་ནོ།",
    "གང་དང་གང་ལྡོག་པ་ངེས་པས་དེ་ཡང་ལྡོག་། པ་དེས་ཁྱབ་པར་འགྲུབ་ཀྱི་བཟློག་པ་ནི་མ་ཡིན་ནོ།",
    "དེས་ན་ཁྱབ་པར་བྱ་བའི་ངོ་བོའི་ཁྱབ་པ་ནི་ལྡོག་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ན་གཏན་ཚིགས་ཀྱི་ཁྱབ་པར་བྱ་བ་སྤངས་པ་ཡིན་ནོ།",
    "ལྡོག་པའི་བདག་ཉིད་ནི་ལྡོག་པར་བྱེད་པ་ཁྱབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར།",
    "ཅིག་ཤོས་དེ་མེད་པ་ལ་མེད་པ་ཁོ་ན་ཁྱབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "མངོན་སུམ་གྱི་རྗེས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ལ་མ་གཏོགས་པ་རྟོགས་པ་མེད་དོ་ཞེས་བསྟན་ཏོ།",
    "གང་ཡང་མངོན་སུམ་ལ་ནམ་མཁའི་ཆའི་ངོ་བོ་སྣང་བ་ལ་སོགས་པ་དུ་བའི་བདག་ཉིད་དང་ལྡན་པར་མཐོང་བ་འདི་མེ་དང་ལྡན་པར་མཐོང་བ་ནི་མེད་པ་དེའི་ཕྱིར་ཇི་ལྟར་ས་ཕྱོགས་ཀྱི་དུ་བ་མངོན་སུམ་ལ་རབ་ཏུ་གྲུབ་པ་ཡིན་ན།",
    "དུ་བ་ཡིན་པའི་ཕྱིར་ཞེས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེ་ན།",
    "ས་ཕྱོགས་ཉིད་ལ་ཡང་མེ་བསྟན་པར་བྱ་བ་ཡིན་གྱི་དུ་བ་ནི་མ་ཡིན་ནོ།",
    "དུས་ལ་སོགས་པ་ལྟོས་པར་འདོད།",
    "དཔེར་ན་ཆུ་སྐྱར་དང་ལྡན་པའི་ཤིང་ལ་སོགས་པ་ཡུལ་ལ་སོགས་པ་ལ་ལྟོས་ནས་ཆུ་སྒྲུབ་པར་བྱེད་པའམ།",
    "སྒྲ་ལ་བྱས་པ་ནི་རྐྱེན་ཐ་དད་པས་ཐ་དད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་བ་རྗེས་སུ་། དཔོག་པ་བཞིན་ནོ།",
    "མི་འཛིན་ཅེས་བྱ་བ་ལ་རྟགས་ལ་སོགས་པ་མངོན་སུམ་གྱིས་འཛིན་པ་སྤངས་པ་ཡིན་ན་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར།",
    "ཕན་འདོགས་པར་ནི་མི་འདོད་ཕྱིར།",
    "དང་པོར་རྣམ་རྟོག་མེད་པར་ཡོད།",
    "ངེས་པར་བྱེད་པའི་བློ་དེ་ཡང་།",
    "ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་གཞན་གྱིས་རྣམ་པར་རྟོག་པ་སྐྱེའོ།",
    "དེ་ལྟ་ན་དུ་བ་དེ་ཉིད་ཕྱོགས་ལ་འབྲེལ་པར་ངེས་པ་ནི་གང་འདི་ལ་འདིའོ་ཞེས་ངེས་པར་བྱེད་པ་དང་།",
    "རྟེན་དང་བརྟེན་པའི་རྣམ་པར་གནས་པ་མེད་པའི་ཕྱིར་རོ།",
    "མངོན་སུམ་གྱིས་ཉམས་སུ་མྱོང་བ་ལས་ཕྱི་ནས་རྣམ་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་དེ་ཉིད་དེ་བཞིན་དུ་གནས་པ་དོན་གཉིས་ལ་བརྟེན་ནས་རྣམ་པར་རྟོག་པ་དཱི་སྒྲོ་འདོགས་པ་ཁོ་ན་སྟེ།",
    "སྤྱིའི་ཐ་སྙད་ཀྱང་རིགས་མི་མཐུན་པའི་ལྡོག་པ་དངོས་པོ་ལ་མི་བརྟེན་པ་ནི་མ་ཡིན་པར་རྒྱ་ཆེར་བྱས་སོ།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེས་ན་སྤྱིའི་རྣམ་པར་རྟོག་པའི་དྲན་པ་ཁོ་ན་བཟང་བ་ལ་འཛིན་པ་ཡིན་ལ།",
    "གང་འགའ་ཞིག་མངོན་སུམ་གྱིས་མི་འཛིན་པར་འགྱུར་རོ།",
    "དྲན་དང་རྣམ་པར་ཤེས་པ་འདི།",
    "ཐ་དད་མེད་པར་གང་བརྗོད་ན།",
    "ངེས་པར་དྲན་པའི་ནུས་པ་ཡིས།",
    "དེ་ལ་རྟགས་འཛིན་པ་ཡང་ཐུག་པ་མེད་པར་འགྱུར་ཏེ་རྗེས་སུ་དཔག་པ་དེ་ནི་གཞན་གྱི་སྟོབས་ཀྱིས་སྐྱེ་ལ་དེ་ཡང་སྤྱིའི་ངོ་བོ་སྟེ།",
    "རྟགས་ནི་རྣམ་པར་བསལ་བ་ན།",
    "ཅུང་ཟད་ཡོད་པར་བསྟན་དུ་མེད།",
    "གཞན་གྱིས་རྟོགས་པར་འགྱུར་ན་སླར།",
    "དེ་བཞིན་ཤེས་པར་བརྟག་ན་ནི།",
    "རྟོགས་པར་བྱེད་པ་ཡོད་མ་ཡིན།",
    "སྤྱིའི་མཚན་ཉིད་ནི་རྗེས་སུ་དཔག་པའི་ཡུལ་ཡིན་ནོ་ཞེས་བྱ་བ་ཡང་གང་གསུངས་པ་ན།",
    "དེ་ལ་སྤྱིའི་མཚན་ཉིད་ནི་རྗེས་སུ་དཔག་པ་ཁོ་ནའི་ཡུལ་ཡིན་ནོ་ཞེས་ངེས་པར་གཟུང་བར་མི་བྱ་སྟེ།",
    "མངོན་སུམ་གྱི་རྗེས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་དང་།",
    "དེ་ནི་རྣམ་པར་རྟོག་པ་གཞན་གྱི་འང་ཡུལ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲུབ་པའི་རྣམ་པར་རྟོག་པ་འདིའི་ས་བོན་དུ་བ་དང་བཅས་པ་མཐོང་བ་དང་ལྡན་པ་མངོན་སུམ་གྱིས་ཞེས་བྱ་བར་འབྲེལ་ཏོ།",
    "དབེན་པ་ནི་མ་འབྲེལ་པའོ་ཞེས་འདིར་རྣམ་པར་སྦྱར་རོ།",
    "འདི་ལྟར་དོན་གཞན་ལས་ལྡོག་པ་ནི་ཕན་ཚུན་ཐ་དད་ཀྱང་སྤྱིར་ཉེ་བར་མཐོང་བས་དེ་དག་ཐ་དད་པའི་ངོ་བོ་། མི་མངོན་བ་ལ་ཐ་མི་དད་པའི་རང་བཞིན་དུ་སྒྲོ་བཏགས་ནས་རྣམ་པར་རྟོག་པ་སྐྱེའོ།",
    "དེ་ན་བདག་ཉིད་མཐོང་བ་དང་ལྡན་པར་གྱུར་པའི་སྐྱེས་བུ་ལ་དེ་མ་ཐག་ཏུ་དྲན་པ་རྟགས་ཤེས་པ་སྐྱེའོ་ཞེས་བྱ་བར་འབྲེལ་ཏོ་། དྲན་པ་ནི་དྲན་པའོ།",
    "འདི་མངོན་སུམ་གྱི་རྗེས་ལ་བྱུང་བའི་རྟོགས་པ་ལ་སྤྱི་སྣང་བས་ངེས་རྟགས་རྣམ་པར་འཇོག་གོ།",
    "དེ་ཐ་དད་པ་ནི་དོན་དམ་པར་དེ་གཞན་ལས་ལྡོག་པའི་ཡུལ་ཅན་གྱི་རྟགས་ཤེས་པ་གང་དགག་པ་དང་སྒྲུབ་པའི་བདག་ཉིད་དོ།",
    "ངེས་པའི་ཤེས་པ་རྣམས་ནི་སྒྲོ་འདོགས་པ་རྣམ་པར་གཅོད་པའི་འབྲས་བུ་ཅན་ཡུལ་མེད་ཀྱང་དེའི་ཡུལ་དུ་བརྗོད་དོ་ཞེས་གསུངས་སོ་། རྟོགས་པར་བྱེད་པ་པོས་ངེས་པའི་དོན་ནི་ཇི་ལྟར་མཐོང་བ་ཐ་དད་པ་དེའི་ཡུལ་ཅན་ཡིན་པ་དེའི་ཕྱིར་དྲན་པའི་ངོ་བོ་དོན་དམ་པ་མ་ཡིན་ནོ།",
    "དངོས་པོའི་ཡུལ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་མངོན་སུམ་ལ་སོགས་པ་དེས་ནི་མེད་པའི་ཆ་མ་ཡིན་ལ་དངོས་པོ་ཉིད་རྟོགས་པ་ཡིན་ཏེ།",
    "སྒྲུབ་པའི་རྣམ་པར་རྟོག་པ་ནི་སྤྱི་མ་བཟུང་བས་དྲན་པ་ཉིད་སྲིད་པའི་ཕྱིར་རོ།",
    "དགག་པའི་རྣམ་པར་རྟོག་པ་ལ་ཡང་རྟགས་ཤེས་པ་མི་འདོད་དོ།",
    "རང་བཞིན་གྱིས་མ་འདྲེས་པའི་ངོ་བོ་མེད་ན་མེད་པའི་ཆ་ཡོད་པར་གྱུར་པ་ཡང་རིགས་པ་མ་ཡིན་ནོ།",
    "ཅི་དཀའ་ཐུབ་ཀྱི་ལ་ཏུ་བའི་རིགས་པ་ཁས་ལེན་པར་བྱེད་དམ།",
    "མཚན་ཉིད་མི་མཐུན་པར་རབ་ཏུ་འཇུག་པར་མཐོང་བའི་མངོན་སུམ་གྱི་སྟོབས་ཀྱིས་དྲན་པ་སྐྱེས་པ་ཡིན་གྱི།",
    "གང་རྟགས་ཀྱི་སྟོབས་ཀྱིས་བསྐྱེད་པའི་རྣམ་པར་བཅད་པའི་ཡུལ་ལ་ཡང་དྲན་པ་ཡོད་པ་ནི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཐོང་ངོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་གཟུང་བར་བྱ་བའི་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་འགའ་ཞིག་གོམས་པ་ལ་སོགས་པའི་རྐྱེན་ལ་ལྟོས་པའི་ཕྱིར་རྣམ་པ་འཛིན་པར་བརྗོད་དོ།",
    "དགག་པའི་རྣམ་པར་རྟོག་པ་ནི་སྔོན་མེད་པའི་དོན་རྟོགས་པ་མེད་པའི་ཕྱིར་སྔོན་མེད་པའི་དོན་རྣམ་པར་ཤེས་པ་སྤངས་པ་ཡིན་ནོ།",
    "དེ་སྔོན་མེད་པའི་རྣམ་པར་ཤེས་པ་མི་སྲིད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལས་གཞན་ཡང་དངོས་པོ་འཛིན་པ་རྣམ་པར་མི་རྟོག་པའི་མངོན་སུམ་གྱི་ཡུལ་ཉིད་ནི་དངོས་པོའོ།",
    "རིགས་ལ་སོགས་པ་ནི་བྱེ་བྲག་ཏུ་རྟོགས་པ་ནི་བློ་ཡིས་མངོན་བར་ཞེན་པར་བརྗོད་དེ།",
    "རྟོགས་པར་བྱེད་པ་པོས་སྒྲུབ་པའི་རྣམ་པར་རྟོག་པ་སྤྱིའི་རྣམ་པ་དོན་བྱེད་པ་སྒྲུབ་པ་མ་རྟོགས་པ་རྟོགས་པ་མེད་དོ།",
    "ཅུང་ཟད་ཅིག་ཀྱང་དེས་བསྒྲུབ་པར་བྱ་བ་ཁས་མ་བླངས་ཏེ།",
    "ཐ་མི་དད་པའི་ཤེས་པའི་མཚན་ཉིད་བརྗོད་པ་འམ་གཞན་ལ་ནི་བསལ་བས་བསྒྲུབ་པར་བྱ་བའི་དོན་བྱེད་པར་ཉེ་བར་བཏགས་པ་ཡིན་ནོ།",
    "འོག་ཏུ་ནི་དུས་ཕྱིས་དེའི་མཐུ་ལས་སྐྱེས་པའི་རྣམ་པར་རྟོག་པ་ཅན་གྱི།",
    "རྣམ་པར་ཤེས་པའི་བཟུང་བ་ཡིན་པས་སོ།",
    "ཕྱིས་ནི་ཐམས་ཅད་དུ་ཅུང་ཟད་ཅིག་ཀྱང་དོན་བྱེད་པར་ཉེ་བ་བཏགས་པ་མེད་དོ།",
    "འདི་ནི་དེ་ལྟར་རྟོགས་པ་མེད་པའི་ཕྱིར་དོན་བྱེད་པ་སྒྲུབ་པར་བྱེད་པ་ནི་ལྟ་བའི་ཤེས་པ་ཡིན་ནོ་ཞེས་བྱའོ།",
    "སྤྱི་ནི་ཅུང་ཟད་ཅིག་ཀྱང་དོན་བྱེད་པར་ཉེ་བར་བརྟག་པར་མི་བྱའོ་ཞེས་རྣལ་མ་དང་སྦྱར་རོ།",
    "གལ་ཏེ་སྔོན་པོ་ཡིན་ནོ་ཞེས་མཐོང་བའི་རྗེས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ལས་སྣང་བའི་སྤྱི་དོན་བྱེད་པར་ཅིས་ན་བརྟག་པར་མི་བྱ།",
    "འོ་ན་ཏེ་ཐ་མི་དད་པའི་ཤེས་པའི་མཚན་ཉིད་དང་བརྗོད་པའི་རང་བཞིན་བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་པས་མ་གྲུབ་པ་ཡིན་ཏེ།",
    "རྣམ་པ་དེ་ལྟ་བུས་བསྒྲུབ་པར་བྱ་བའི་དོན་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་ཐ་མི་དད་པའི་ཤེས་པ་དང་བརྗོད་པའི་བདག་ཉིད་ཀྱི་དོན་བྱ་བ་སྒྲུབ་པར་བྱེད་དོ།",
    "གསལ་བ་གཅིག་ཁོ་ན་མཐོང་བའི་དུས་སུ་སྔོན་པོ་ལ་སོགས་པའི་ངོ་བོ་གསལ་བར་སྣང་བ་ན་དེ་ཇི་ལྟར་མཐོང་བ་མེད་པར་བརྟགས་ནས་བདག་ཉིད་ལ་བདག་ཉིད་སླུ་བར་བྱེད་དམ།",
    "འདིའི་ལན་ནི་གཞན་དུ་ཡང་རྙེད་པར་སླ་བའི་ཕྱིར་རོ།",
    "ཉེ་བར་བཏགས་པར་མི་འདོད་དོ།",
    "འཁྲུལ་པར་བརྗོད་པ་དེ་འཁྲུལ་པ།",
    "ཡང་ན་ཁྱབ་པར་ཉེ་བར་དམིགས་པར་འགྱུར་ན་དེ་ནི་དེ་ལ་རྟོགས་པ་མེད་པ་ག་ལ་ཡིན།",
    "གསལ་བ་གཅིག་ལ་ཉེ་བར་དམིགས་པར་གྱུར་ན་ཡང་འཇིག་རྟེན་ན་གསུམ་པོ་མ་ལུས་པ་ཁྱབ་པའི་ངོ་བོ་འམ་མ་ལུས་པའི་རྟེན་ལ་ཁྱབ་པ་མཐོང་བར་འགྱུར་ན།",
    "རྣམ་པར་རྟོག་པས་དེ་མཐོང་བར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "ངེས་པས་ཡུལ་དུ་བྱས་པ་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་མི་རིགས་ཏེ།",
    "བརྟེན་པའི་ཕྱིར་བློ་ནི་འཇིག་པ་མེད་པར་འགྱུར་ན་སྐད་ཅིག་མར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ཕྱོགས་སྔ་མར་བྱས་ནས།",
    "སྐྱེ་བ་མེད་པར་འདོད་པ་ཡིས།",
    "རིགས་དེ་འབྲེལ་པར་མི་འདོད་ན།",
    "བདག་ཉིད་དེས་སྔོན་པོའི་བསྒྲུབ་པར་བྱ་བའི་དོན་བྱ་བ་བྱེད་པར་རང་བཞིན་མཐོང་བ་ཉིད་ལྟ་བའི་ཤེས་པ་ཞེས་བའོ།",
    "སྤྱི་དོན་མེད་པའི་བྱ་བ་བྱེད་པ་ནི་མ་ཡིན་ཏེ་སྔོན་པོ་བསྒྲུབ་པར་བྱ་བའི་དོན་བྱེད་པའི་སྔོན་པོ་དང་ལྷན་ཅིག་ཏུ་བྱུང་ནས་བྱེད་པར་འགྱུར་བའི་། གསལ་བའི་རང་བཞིན་ཉིད་སྤྱི་ཡིན་པར་འདོད་དོ་ཞེ་ན།",
    "སྔོན་པོའི་རྣམ་པར་རྟོག་པའི་ཡུལ་གྱི་སྔོན་པོའི་སྤྱིས་སྔོན་པོའི་དོན་གྱིས་བསྒྲུབ་པར་བྱ་བ་བྱེད་པ་གཙོ་བོ་ལ་སོགས་པ་བྱེད་པ་ཡིན་ནོ།"
  ]
}