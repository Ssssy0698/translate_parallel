    "རང་བཞིན་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "སྟོབས་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "བསམ་གཏན་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "སྨོན་པ་མེད་པ་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "མི་འཇིགས་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "བྱམས་པ་ཆེན་པོ་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུ་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "དགྲ་བཅོམ་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཤིན་ཏུ་དབེན་པར་མ་གྱུར་ན།",
    "དེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་མི་འགྱུར་རོ་ དེ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་མི་འགྱུར་རོ།",
    "དེ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་མི་འགྱུར་རོ།",
    "དེ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པར་མི་འགྱུར་རོ།",
    "དེ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པར་མི་འགྱུར་རོ།",
    "དེ་འདུས་བྱས་སྟོང་པ་ཉིད་དུ་མི་འགྱུར་རོ་ དེ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེ་ཡང་དག་པར་སྤོང་བ་རྣམས་སུ་མི་འགྱུར་རོ།",
    "དེ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པར་མི་འགྱུར་རོ།",
    "དེ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་སུ་མི་འགྱུར་རོ།",
    "དེ་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་སུ་མི་འགྱུར་རོ།",
    "སྨོན་པ་མེད་པར་མི་འགྱུར་རོ།",
    "དེ་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིར་མི་འགྱུར་རོ།",
    "དེ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་འདུས་བྱས་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཇི་ལྟར་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཇི་ལྟར་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཇི་ལྟར་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཇི་ལྟར་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཇི་ལྟར་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཇི་ལྟར་ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཤིན་ཏུ་དབེན་པ་དང་།",
    "ཡོངས་སུ་མི་འཇུམ་ཞིང་མི་འཇིགས་མི་དངང་སྐྲག་པར་མི་འགྱུར་ན།",
    "དེ་ནི་སྤྱོད་དོ་ཞེས་བགྱི་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་།",
    "བདག་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་ཉེ་བར་གྱུར་ཏོ་སྙམ་ཡང་མི་བགྱིད་དོ།",
    "མི་གཡོ་བ་དང་རྣམ་པར་རྟོག་པ་མ་མཆིས་པའི་། སླད་དུ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "སྒྱུ་མའི་སྐྱེས་བུ་ནི་རྣམ་པར་མི་རྟོག་པའི་སླད་དུ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "གཟུགས་བརྙན་རྣམ་པར་མི་རྟོག་པའི་སླད་དུ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "མི་སྡུག་པར་འགྱུར་བའི་ངོ་བོ་ཉིད་མི་དམིགས་པའི་སླད་དུའོ།",
    "དེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལའང་སྡུག་པའམ་མི་སྡུག་པར་འགྱུར་བ་གང་ཡང་མ་མཆིས་སོ་ བཅོམ་ལྡན་འདས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་མི་རྟོག་པའི་སླད་དུའོ།",
    "སྤྲུལ་པ་ནི་མི་རྟོག་རྣམ་པར་མི་རྟོག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ནི་མི་རྟོག་རྣམ་པར་མི་རྟོག་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འབའ་ཞིག་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འོན་ཏེ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན།",
    "འོན་ཏེ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན།",
    "འོན་ཏེ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན།",
    "འོན་ཏེ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་། རྟོག་པ་ཡིན།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པའོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པའོ།",
    "ཅི་གཟུགས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཚོར་བའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུ་ཤེས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུ་བྱེད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མིག་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣ་བའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྣའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལྕེའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལུས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཡིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "གཟུགས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྒྲའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དྲིའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རོའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྣའི་རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སའི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཆུའི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མེའི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ནམ་མཁའི་ཁམས་། ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མ་རིག་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུ་བྱེད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མིང་དང་གཟུགས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྐྱེ་མཆེད་དྲུག་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཚོར་བའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྲེད་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལེན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྲིད་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྐྱེ་བའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྒ་ཤིའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ནང་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྟོབས་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "བསམ་གཏན་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སྨོན་པ་མེད་པའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "མི་འཇིགས་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "བྱམས་པ་ཆེན་པོའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུའང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུས་བྱས་ཀྱི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "འདུས་མ་བྱས་ཀྱི་ཁམས་ཀྱང་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནམ།",
    "རྒྱུན་དུ་ཞུགས་པར་བརྗོད་པ་ཅི་ལས་གྱུར།",
    "དགྲ་བཅོམ་པར་བརྗོད་པ་ཅི་ལས་གྱུར།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་རྒྱུན་དུ་ཞུགས་པར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་ལན་ཅིག་ཕྱིར་འོང་བར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་ཕྱིར་མི་འོང་བར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་ཕྱིར་མི་འོང་བའི་འབྲས་བུར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་དགྲ་བཅོམ་པར་བརྗོད་དོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལས་དགྲ་བཅོམ་པ་ཉིད་དུ་བརྗོད་དོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པར་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ན།",
    "དོན་འདི་ལ་སྤྱོད་ཀྱང་ཡང་དག་པའི་མཐའ་གང་མངོན་དུ་བྱས་པས་ཉན་ཐོས་ཀྱི་སའམ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ།",
    "རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "རྣམ་པར་ཤེས་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ་ རྫུ་འཕྲུལ་གྱི་རྐང་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དབེན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའོ།",
    "ཡོངས་སུ་ཞུམ་པར་མི་འགྱུར་ལ།",
    "དེའི་ཡིད་འཇིགས་པར་མི་འགྱུར་ན།",
    "དེ་ནི་འདི་ལྟར་གང་ཞུམ་པར་འགྱུར་བ་དང་།",
    "སྒྱིད་ལུག་པར་མི་འགྱུར་ལ།",
    "མི་འཇིགས་མི་དངང་སྐྲག་པར་མི་འགྱུར་ན།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པ་ལགས་སོ།",
    "དེ་ནི་འདི་ལྟར་གང་ཞུམ་པར་འགྱུར་བའམ།",
    "གནས་གཙང་མའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱིས་ཀྱང་།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "ནང་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "ཕྱི་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའོ།",
