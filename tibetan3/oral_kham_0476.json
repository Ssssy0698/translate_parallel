    "ད་སྐུ་ངོ་ཁྱེད་རང་སྐྱོན་མེད་དེ།",
    "མཁའ་དཔྱོད་ཅེས་ཚིག་སྒྲ་ཡག་པོ་མི་འདུག།",
    "སང་ཉིན་པ་ཀོ་ནས་མེ་འཁོར་ནང་བཞུགས་ཏེ་ལྡི་ལིར་འབྱོར་བྱུང་བ་ལ་དྭགས་རྡ་རམ་ས་ལར་ཁ་ན་ཌ་གཞུང་ཚབ་ནས་ཚང་མར་གྲ་སྒྲིག་བྱས་འདུག་ཀྱང་།",
    "ཁང་ཆེན་ཞིག་ནང་ཚང་མ་མཉམ་སྡོད་བྱ་དགོས་སྡོད་བགས་ཕེབས་པོ་རང་མི་འདུག་པ།",
    "ལྟ་བསྐོར་ཟིན་པ་དང་གནམ་ཐང་དུ་ཁྲིད་བྱུང་བ་དེར་ངལ་གསོ་རྒྱག་མི་རྣམས་ཀྱང་སླེབས་འདུག་ཚང་མ་འཛོམས་པ་དང་།",
    "རྐུབ་སྟེགས་ཅོག་ཙེ་སོགས་དགོས་མཁོ་ཆ་ཚང་འདུག།",
    "ང་རང་དགོངས་པ་ཞུས་ཟིན་སྟབས་འཁུར་མ་བྱས་པར་སྤྱི་མཚུངས་ཁུ་སིམ་དུ་བསྡད་ཀྱང་རྒྱ་གར་ནས་འབྱོར་བའི་ངའི་ཡི་གེ་ཁ་བསྔོགས་པ་དང་།",
    "ང་སྒེར་གྱི་ཧ་ཡང་ནང་ཐུགས་པ་བསྐོལ་བ་ཐུགས་པ་ཧ་ཡང་རང་འགྲིགས་རྐུས་འཁྱེར།",
    "ད་ལམ་མིང་ཐོའི་ནང་ནས་འཐེན་དགོས་ཟེར་འདུག་པ།",
    "ངའི་ཁྱིམ་ཚང་གྷ་རང་བྷེ་དུ་ཁོ་ཚོས་འདམ་འདུག།",
    "དེར་ཟླ་གཅིག་ལྷག་ཙམ་བསྡད་དེའ་རིང་ཁ་ལག་དུས་གསུམ་ཟ་ཁང་ནས་བཟའ་རྒྱུ་དང་།",
    "སང་ཉིན་དེ་ཉིན་གུང་ཙམ་ལ་ཁོང་འབྱོར་བྱུང་བ་མཉམ་དུ་འཇམ་དཔལ་ལགས་ཀྱང་འདུག།",
    "སྲན་ཊེ་འགའ་ཤས་འདུག་པ་ཁང་གླ་སྤྲད་འཕྲོས་བྷང་ནང་སན་ཊེ་འགའ་ཤས་ལྷག།",
    "འགའ་ཤས་རྫོགས་འགའ་ཤས་སྤུན་དོགས་ས་ལ་འཁྱིལ་དེ་ལྟ་བུའི་བྲེལ་བྲེལ་ཚུབ་ཚུབ་དངངས་སྐྲག་ཁོ་ནའི་ངང་ནས་ལས་ཀ་བར་མཚམས་འཇོག་རྒྱུའི་དྲིལ་བརྡ་སྐད་ཆེན་པོ་ཡོད་ཀྱང་རྣ་བས་རྩ་བ་ནས་ཐོས་ཀྱི་མི་འདུག་རོགས་པས་ཡོང་ནས་ད་མཚམས་བཞོག་ལབ་དགོས་བྱེད་ཀྱི་འདུག།",
    "ད་ནི་རྐང་ལག་བརྒྱ་ཙམ་ཡོད་ཀྱང་ད་དུང་ཉུང་སྐྱོན་ལས་མང་སྐྱོན་མི་འདུག་བསམ་པ་དྲན།",
    "འཇམ་དཔལ་ལགས་ཀོ་ཕི་ནས་ང་རང་མཉམ་འཁྲིད་ཐོག།",
    "མི་དེ་ཡག་པོ་མི་འདུག་ཅེས་ཟེར་འདུག།",
    "དེར་ཉིན་མཚན་མེད་སྒོ་དམ་པོར་བརྒྱབ་ནས་མི་སུ་དང་ཡང་འབྲེལ་བ་མ་བྱས་པར་བསྡད་ཡོད་ཚོད་འདུག།",
    "ཁོང་ང་གཉིས་མཉམ་དུ་ལས་ཀ་བྱེད་སྐབས་ལས་ཀ་སྐྱིད་པོ་རྩ་བ་ནས་མི་འདུག།",
    "དེ་ལ་ཡི་གེ་འདི་སྤྲོད་ཟེར་བ་ལྟར་ངས་ཕྱིན་པས་སློབ་གྲ་ཧ་ཅང་ཆེན་པོ་ཞིག་འདུག་དེའི་ཕྱི་སྒོ་དེར་ཡར་འཛུལ་བས་སྒོ་མདུན་དེར་མི་སྤོའོ་དམག་ཆས་གྱོན་པ་ཞིག་དང་།",
    "ཁོས་ཁྱེད་རང་སང་ཉིན་ཆུ་ཚོད་༨པར་འདིར་འབྱོར་བ་ཤོག་ཟེར་ངོ་སྤྲོད་ཅིག་བྱས་བྱུང་རྗེས་ནང་དུ་ལོག་ནས་ད་ཉིན་གྱི་གནས་ཚུལ་རྣམས་སྐད་ཆ་བྱས་ནས་སང་ཉིན་གྱི་གྲ་སྒྲིག་བྱེད་དགོས་རྣམས་བྱས།",
    "སང་ཉིན་དེར་འགོ་འཁྲིད་སྤོ་ནུ་ཝས་ཁྱེད་རང་ཉིན་ལྟར་རྐང་ཐང་དུ་ཡར་ཕྱིར་ཐེང་གཉིས་འགྲོ་རྒྱུ་དཀའ་ངལ་ཆེ་བས་ངས་སྣུམ་འཁོར་ནང་མཉམ་དུ་འཁྲིད་ཆོག།",
    "སྐྱེ་དམན་བཞི་བཅས་གཏན་འཇགས་ལྟ་བུ་མི་བརྒྱད་འདུག།",
    "ཕྲུག་གུར་ཀློག་ཏུ་བཅུག་པས་དེ་རང་ཟེར་འདུག།",
    "ཁྱེད་རང་ཨར་པོ་རྒྱག་འདོད་ཡོད་ན་ཨར་པོ་རྒྱག་མི་ཁུར་ཏོ་མར་སལ་ངོ་འཕྲད་ཀྱིས་སྐད་ཆ་བྱས་ན་འཐུས་རྒྱུ་ཟེར་བར།",
    "ཁྱེད་རང་ཁང་པ་རྒྱབ་ན་ཕོམ་ཤོག་འདི་བརྒྱངས་དགོས་དེ་ངས་གཞུང་ལ་བཏང་ནས་བཀའ་འཕྲོལ་བྱུང་ན་ས་ཆ་དང་།",
    "དེ་ནས་རྫོགས་ཏེ་སྒོ་རྒྱབ་ཚར་འདུག།",
    "ངའི་སྤུན་མཆེད་ཁོ་ཁ་ས་ཕྱིན་འདུག་ཀྱང་།",
    "བུ་ལོན་ཐོབ་མི་འདུག།",
    "འཛིན་ཆས་གསར་པ་རྣམས་འོར་མི་དང་མཉམ་དུ་ཚོང་མི་སྦྱིན་བདག་སོ་རས་ཀྲི་ཁོ་རང་ཡང་སླེབས་བྱུང་བ་ཁོང་དང་།",
    "ཁང་པའི་མཐའ་བསྐོར་དུ་སྤང་གདིངས་རྒྱུ་སྤང་ཉོས་ནས་གདིངས་རྒྱུ་ང་རང་དང་།",
    "རྗེས་འདེད་དུ་ཡོང་ནས་འདིར་ཡོང་དགོས་བྱུང་ཞེས་གསུང་འདུག་པར།",
    "དེ་འགྲིབ་ཁའདུག་ཕེབས་ཡུལ་གཞན་དུ་མེད་སྟབས་འདི་གར་ལྷོད་བཞུགས་གནང་འཐུས་བྱས་ནས་བཞུགས་ཡུལ་སོགས་གྲ་སྒྲིག་འཐུས་ཚང་ཐོག།",
    "ལག་པ་གཡུག་ཙམ་གཡུག་ཙམ་བྱེད་ཀྱི་འདུག།",
    "ང་གཉིས་ལ་རུ་ལོའི་ཞེས་གུར་ཞིག་ཡོད་པ་དེ་ཁྱེད་རང་གཉིས་ལ་གཡར་གྱི་ཡིན།",
    "ཕང་སེ་བཅས་ཡག་པོ་འདུག།",
    "ཕང་སེ་ཤེས་ཀྱི་འདུག།",
    "གླིང་ག་དེའི་རིང་ང་རང་ཡང་སྣང་བ་ཡང་པོ་སྐྱིད་པོ་བྱུང་བ་བཞིན་རོགས་པ་རྣམས་ཀྱང་སྐྱིད་པོ་བྱུང་འདུག།",
    "མི་དེ་མགོ་དཀར་པོ་ཞེ་དྲག་ཆགས་འདུག།",
    "ངེས་སྙན་སེང་ཞུས་ཆོག་གསུང་འདུག་པ།",
    "བོད་མིའི་ཞབས་འདྲེན་བཟོ་མི་འདྲ་པོ་ཞིག་ཆགས་ཀྱི་འདུག།",
    "དེ་ལྷ་དེའི་ཆོ་འཕྲུལ་ཡིན་པ་འདྲ་ག་དུས་ཡིན་ཀྱང་ང་ལ་ལྷ་དེས་ཟིང་ཆ་སླངས་ཀྱིན་འདུག།",
    "གཞི་ནས་ང་རང་ལྷ་ལ་དགའ་པོ་རང་མེད་ཅེས་ཞུས།",
    "ང་ལ་ཐད་ཀར་ཡི་གེ་གཏོང་བདེ་པོ་མི་འདུག་ན་རྟ་ར་ལགས་བརྒྱུད་བཏང་ན་འགྲིགས་ཞེས་བཀའ་ཕེབས།",
    "ཁྱེད་རང་དེར་ལས་ཀ་བྱེད་འདོད་འདུག་གམ་ཟེར་བར་ལས་ཀ་ཇི་ཡིན།",
    "བཟོ་གྲྭ་ཆུང་ཆུང་ཞིག་འདུག་པ་དེའི་ནང་དང་།",
    "ལས་སློབ་གཉིས་ཀྱི་ལས་ཀ་ང་རང་གཅིག་པོས་ཆ་ཚང་བྱས་པ་ཡིན།",
    "ང་རང་རྒྱ་གར་དུ་སྡོད་རིང་འདིར་ཕུན་ལྷ་ལགས་དང་།",
    "ཉིན་གཅིག་ང་རང་གཅིག་པོ་པག་སྟོད་མ་དེའི་སྒོ་འགྲམ་དེར་རྐུབ་སྟེགས་བྱས་ནས་སྒྲོལ་མ་འདོན་བཞིན་བསྡད་ཡོད་པ།",
    "བལྟ་སྐོར་གྱིས་རིན་ཇི་ཡིན་དྲིས་པར་ཌོ་ལར་སྟོང་ཕྲག་༤༥ཡིན་ཟེར་འདུག།",
    "གསང་སྤྱོད་གཉིས་འོག་ཤོད་བཅས་འདུག།",
    "བྱང་ངོས་ཚོང་ཁང་བཟོས་ནས་ཁང་པ་རིང་པོ་ཞིག་འདུག་པ་དེ་ལ་བཟོ་བཅོས་བྱས་ནས་ཉལ་ཁང་གཅིག་དང་།",
    "ང་རང་འབྱོར་ནས་ཀྱང་ལོ་འཕྲོས་མ་རྫོགས་པ་བསྡད་རིང་ཁང་གླ་ཆ་ཚང་དུས་ཐོག་སྤྲད་བྱུང་།",
    "དེ་ནས་ང་རང་རྒྱ་གར་དུ་ཐོན་གཏན་འཁེལ་ནས་ཕར་ལམ་གནམ་གྲུའི་ཊི་ཀ་སི་ཕུན་ལྷས་གནང་བྱུང་།",
    "གདན་གཉེར་ཚང་སྐུ་ངོ་བློ་བཟང་ཟླ་བ་ལགས་གནམ་ཐང་དུ་ང་བསུ་བར་ཕེབས་འདུག་པ་མཇལ།",
    "རྡ་སར་གཏན་སྡོད་ཚ་རྡོར་ཞབས་གྲས་བློ་བཟང་ཚེ་འཕེལ་ལགས་ཀྱང་སུད་ཊར་ཉོ་བར་ལྡི་ལིར་འབྱོར་འདུག་པ་གནང་ཉིན་རྡ་སར་མཉམ་ཐོན་བྱ་རྒྱུའི་སྐད་ཆ་བྱས།",
    "སྐྱེད་བྱེད་སྐབས་དེར་ཝ་ཎ་མཐོ་སློབ་ཏུ་སྙན་གསུམ་སློབ་འཁྲིད་གནང་བར་ཕེབས་ནས་བཞུགས་མི་འདུག།",
    "ཚོང་ཆས་སོགས་སྔོན་མ་ང་རང་རྡ་སར་སྡོད་སྐབས་ཡོད་པ་དེ་རང་ཕལ་ཆེར་རང་འཇགས་ལས་འགྱུར་བ་གང་ཡང་ཕྱིན་མི་འདུག།",
    "སྐྱེད་མ་ཡང་ཐུགས་མཉེས་པོ་བྱུང་ནས་སྐྱིད་པོ་བྱུང་གསུང་འདུག།",
    "རྩིས་དཔོན་ཞྭ་སྒབ་པས་ངས་རྒྱལ་རབས་འབྲི་སྐབས་ང་ལ་གནས་ཚུལ་མ་གསུང་པ་གསུང་འདུག་པ།",
    "དེའི་ནང་གསལ་འགོད་བྱ་རྒྱུ་ཡིན་གསུང་འདུག།",
    "མ་ཚབ་རྣམས་ཕྲུག་གུར་འཇིགས་སྣང་བྱས་ཏེ་སྡོད་དགོས་པ་སོགས་ཕལ་ཆེར་གྱོན་པ་ཕྱི་ནང་སློག་པ་ནང་བཞིན་ཆགས་ཚར་འདུག།",
    "བུ་ཕྲུག་སོགས་ཚང་མ་འཛོམས་འདུག་ཐོག་མར་བུ་ཁྱིམ་འགན་འཛིན་སྟག་ལྷ་མཁའ་འགྲོ་ལགས་དང་།",
    "ཕྱི་རྒྱལ་བ་དེ་ཚོས་ཁྱེད་རང་ལུང་པ་ག་ནས་ཡིན་ཟེར་བ་ལས།",
    "ཕྱི་རྒྱལ་བ་ཡིན་པར་ཆ་འཇོག་བྱེད་ཀྱི་མི་འདུག།",
    "ཉིན་གུང་རྒྱབ་སྐུ་ངོ་དོན་རྒྱུས་ལགས་ཕལ་ཆེར་ཉིན་ལྟར་སྐུ་རྩེད་གནང་བར་ཕེབས་ནས་འཕྱི་པོ་མ་གཏོགས་གཟིམ་ཤག་ཏུ་ལོག་ཕེབས་ཀྱི་མི་འདུག།",
    "ཉིན་ལྟར་སྐུ་རྩེད་གནང་བར་ཕེབས་ཀྱི་འདུག།",
    "རྡོར་དུན་དུ་རྨ་བྱའི་གཟིམ་ཤག་ཅིག་འདུག་པ་དེར་ཞག་གཅིག་བསྡད།",
    "མགོ་དེ་ཁྲ་ཁྲ་བྱས་འདུག།",
    "འདི་ཕྱོགས་ཚོས་མི་འདུག་གམ།",
    "གོང་ཆེན་པོ་བྱེད་ཀྱི་འདུག་གམ་ཞེས་བཀའ་ཕེབས་པར།",
    "བར་དེར་མ་སུ་རིར་ཕྱིན་པས་མཐོང་ཚུལ་གང་བྱུང་ཞེས་བཀའ་འདྲི་གནང་འདུག་པར།",
    "སྒྲིག་ལམ་སོགས་གང་ཅི་ཞན་དུ་ཕྱིན་འདུག་ཞུས་པར།",
    "ཁ་ན་ཌ་དང་བསྡུར་བ་ཡིན་འགྲོ་གསུངས་བྱུང་བར།",
    "སང་ཉིན་དེར་བསྙུན་གཞི་སངས་དྲག་ཏུ་ཕྱིན་འདུག་ཀྱང་།",
    "དམ་པ་དེས་སྐྱེད་མ་ང་གཉིས་ལ་ན་ཚ་རྩ་བ་ནས་མི་འདུག།",
    "ངས་དེ་འདྲ་དཔེ་མི་སྲིད་གང་ཡང་གནང་དོགས་མེད།",
    "དེ་བཞིན་སྐྱེད་བྱེད་རང་ལའང་དགོངས་བསྐོར་ཞུས་པས་བཤུགས་བཅོས་བྱེད་ཀྱི་མིན་གསུངས་འདུག།",
    "མཐུན་རྐྱེན་ཞན་པོ་འདུག་ན་ནང་དུ་ཕེབས་ལེགས་ཞུས་པས།",
    "ནང་དུ་ཚ་བ་ཆེན་པོ་འདུག་གསུངས་བྱུང་།",
    "འོ་ན་ཡོང་ཆོག་གསུངས་འདུག་པ།",
    "མཐར་ཁྱེད་རང་གཉིས་མཉམ་དུ་འབུལ་གཅིག་བསགས་ན་ཏན་ཏན་ཕན་ཐོག་ཡོང་རྒྱུར།",
    "རྩེ་གཟིམ་འགན་ཏུ་མཁན་མགྲོན་ཆེ་བས་ཁྱེད་རང་ལ་ལས་ཚན་འདི་འདྲ་ཞིག་བསྐོ་གཞག་གནང་བ་ཡིན་བཀའ་སྒྱུར་མཇལ་དར།",
    "དངུལ་ཡང་སྒོར་འབུམ་བརྒྱད་ལ་ཉེ་བ་ལྷག་འདུག་པ་འབུམ་དྲུག་སྐུ་སྒེར་ཡིག་ཚང་དུ་བཅོལ་པོ་ཞུས་ཤིང་།",
    "ཤོག་ལྷེ་དེ་བཞིན་བཀའ་ཤག་ཏུ་གནང་འདུག་པ་ཉིན་གཅིག་བཀའ་ཤག་ཏུ་ཡོང་རོགས་ཞེས་ལན་བསྐུར་འདུག་པ་ལྟར་ཕྱིན་པས་བཀའ་བློན་འཇུ་ཆེན་ཐུབ་བསྟན་རྣམ་རྒྱལ་དང་།",
    "བློ་བཟང་དར་རྒྱས་བཅས་འདུག་པ་འཇུ་ཆེན་ནས་ཉིད་ཀྱི་༧གོང་ས་ཆེན་པོར་དགོངས་འཆར་ཤོག་ལྷེ་འབུལ་གནང་བཀའ་ཤག་ཏུ་གནང་བྱུང་བ་དེ་སྐོར་བཀའ་བསྡུར་ཞུ་རྒྱུའི་ཆེད་ད་ཉིན་གདན་འདྲེན་ཞུས་པ་ཡིན།",
    "ཁྱེད་རང་ངའི་སར་སྐད་ཆ་ཤོད་པར་ཤོག་ཅེས་ངས་ཟེར་གྱི་འདུག་གསུང་རོགས་གནང་།",
    "བོད་པའི་མི་གཅིག་བཅས་མཉམ་དུ་འདུག་པ།",
    "ཁྱེད་རང་ད་ཕྱིན་པའི་སྐྱེ་དམན་དང་མཇལ་ནས་ཕང་སེའི་སྐད་སྐྱོན་གྱི་འདུག་ཟེར་འདུག།",
    "སློབ་ཕྲུག་རྣམས་ཚང་མ་བཅས་སྤྱི་ཐབ་ཏུ་གསོལ་སྟོན་གྲ་སྒྲིག་བྱས་འདུག་པ་དེར་བཅར།",
    "ད་ནི་རིམ་པས་ཕྱིར་ལོག་བྱ་རྒྱུར་བརྟེན་སྐྱེད་མ་གཅིག་པུར་བཞུགས་རྒྱུ་སེམས་ནང་བཟོད་ཐབས་མི་འདུག་ཀྱང་།",
    "འོན་ཀྱང་རང་ལ་ཁག་རྩ་བ་ནས་མེད།",
    "ང་རང་ཡང་དོན་པ་ཡིན་ཤོག་ལྷེ་དེ་ཡང་སྒོ་འགྲམ་ནས་བླངས་ཡོད།",
    "གང་མཚམས་ནས་ཁུག་གཅིག་ཏུ་པུ་ལི་སིའི་བཟོ་ལྟ་བུའི་མི་གཅིག་འདུག་པ་ཁོ་ལ་ཕ་རན་སེའི་སྐད་ཐོག་ནས་འགྲོ་ལམ་ཇི་ཡིན་དྲིས་པར།",
    "ཁོའི་རྗེས་དེད་ནས་ཕྱིན་པས་ཕྱིར་དོན་ས་དེར་སླེབས་བྱུང་ཁང་སྟོང་ཞིག་ནང་མི་ཚང་མ་སྒྲིགས་བསྡད་འདུག།",
    "བསྟན་འཛིན་ཨ་བྷི་རྡུའི་པགས་༣༩༤ནང་བསྡད་ནས་གྲ་སྒྲིག་བྱས་འདུག་པ་དགོང་དྲོའི་ཁ་ལྷག་ཟས་རྗེས་ཉལ།",
    "དེང་སང་ཉེ་ཆར་ཚུར་ལོག་ཡོང་གྲབས་ཡིན་པས་ལས་ཀ་ཞིག་འཚོལ་གྱི་ཡོད་ན་ཁྱེད་རང་ལ་ལས་ཀ་སྤྲོད་རྒྱུ་ཡོད་ན་ང་ལ་སྤྲོད་རོགས་ལབ་པར།",
    "དོ་ནུབ་ཡར་ལམ་ང་གཉིས་མཉམ་དུ་འགྲོ་ཞེས་ལབ་ནས་ཀོང་རྩེ་བྷིད་དུ་འབྲིང་རིམ་སློབ་གྲ་ཆེན་པོ་ཞིག་འདུག་པ་དེར་ཁྲིད་ནས་དེ་ནང་རྣམ་ཀུན་ལས་ཀ་བྱེད་མི་འགོ་བྱེད་ཨ་ཅེ་གཅིག་ཐེ་བས་མི་གྲང་བཅུ་གྲངས་ཞིག་འདུག་པ།",
    "ཁུག་སྐྱོག་ཡོད་ཚད་བསྔོགས་ནས་འདིར་བཙོགས་པ་འདུག་ཅེས་སུན་པོ་ཞེ་དྲག་བཟོས་བྱུང་།",
    "པུ་ལི་སི་ལང་གྷོ་བྷར་གྱིས་ཁྱེད་རང་ཁོ་ལ་ཤོད་དགོས་གང་ཡང་མེད།",
    "ཁྱེད་རང་ངའི་སར་ལས་ཀ་བྱེད་ཀྱི་ཡིན་ནམ་ཟེར་བ།",
    "མི་དམངས་ཐ་སྐྱོའི་རིགས་ལའང་རང་འཁོས་ལ་དཔགས་པའི་ས་ཁང་དང་།",
    "ང་རང་ནི་བོད་ཅེས་པ་ལས།",
    "ངོ་མཚར་རྫུ་འཁྲུལ་སོགས་གང་ཡང་མི་འདུག།",
    "ཁ་སྔོན་སྤྱི་ཟླ་དགུ་པའི་ནང་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོས་སྤྱི་འཐུས་ཚོགས་གཙོའི་གསར་མཇལ་དམ་འབུལ་སྐབས་བཀའ་སྤྱི་ལྷན་སར་སྩལ་བའི་བཀའ་སློབ་དེ་ནི་༧གོང་ས་༧སྐྱབ་མགོན་སྐུ་གོང་མས་ཆུ་སྤྲེ་ལོར་སྩལ་བའི་ཞལ་གདམས་བཀའ་སློབ་དང་ཆ་མཚུངས་པ་ཞིག་འདུག་ན་སྐབས་དེར་ཡང་བཀའ་སློབ་ཇི་བཞིན་སྲིད་བཀའ་དང་།",
    "ང་རང་སྐབས་དེར་ཕྱི་ཐོན་ལག་འཁྱེར་དུས་ཚོད་རྫོགས་ནས་གཞི་ནས་གསར་ཞུ་བྱ་དགོས་དང་དེ་བཞིན་ལས་ཀ་གསར་པ་ཐོབ་འཕྲལ་ལ་བརྟེན་དགོངས་ཞུ་བྱ་ཐབས་མེད་པ་སོགས་སྐབས་དེར་འཕྲལ་རྐྱེན་མང་པོ་ཞིག་འཕྲད་ཀྱང་།",
    "རྒྱ་མིས་མེ་སྒྱོགས་རྒྱག་པའི་ཉིན་ངས་ཁོང་ལ་ད་མི་ཚང་མ་བྲོས་ཚར་འདུག།",
    "སླར་ཡང་ནོར་གླིང་དུ་ཡོང་རྗེས་ནོར་གླིང་ས་མ་བརྟན་སྟབས་གཙང་ཆུ་བརྒལ་བགྲོད་ཀྱིས་ལྷོ་ཁ་ཕྱོགས་བསྐྱོད་སྐབས་ཆུ་ནང་མེ་སྒྱོགས་ཐེབས་ནས་གྲོང་འདུག།",
    "བོད་དོན་སྐོར་རོགས་རམ་གང་ཡོད་ཁོ་ལ་མ་གཏོགས་གཞན་དག་ལ་སྤྲད་མ་ཆོག་པའི་བཀའ་བཏང་བ་དེ་ཁྱེད་རང་བོད་བཙན་བྱོལ་གཞུང་ནང་སྐུ་བཅར་བཀའ་བློན་དང་།",
    "དབུ་ཐོད་དུ་དབུ་གཡབ་ཙམ་ཡང་མི་འདུག།",
    "གནས་སྟང་ཀྱི་བབས་ལ་བལྟས་ནས་བློ་ཕམས་ཀྱང་ཅི་ཆེ་བྱུང་བ་དེ་བཞིན་ཕྱི་རྒྱལ་བོད་ཞེན་ཅན་རྣམས་ལའང་སྣང་བ་དེ་རང་བྱུང་འདུག།",
    "ས་རུབ་ཙམ་བྱས་འདུག་པ་དེ་ཉིན་ཉིན་གང་ཇ་དང་།",
    "ང་རང་ཡང་བློ་ཕམས་བྱུང་།",
    "དེ་སྔོན་སྐུ་ངོ་སྣེ་ཤར་འདིར་བཞུགས་སྐབས་ཀྱང་ངས་ཡང་ཡང་མཇལ་གྱི་ཡོད་གསུང་འདུག་ཀྱང་།",
    "སྔོན་མ་ནང་བཞིན་བློ་བགས་ཕེབས་པོ་ཞིག་རྩ་བ་ནས་མ་བྱུང་གསུང་འདུག།",
    "ཉིན་གཅིག་ང་རང་དང་།",
    "མར་ས་གཞི་སྔོན་པོ་ལས་གཞན་གྱི་མཐོང་སྣང་རྩ་བ་ནས་མེད་པ་དེས་སེམས་ནང་གང་ཡང་མི་སེམས་པའི་ཚོར་བ་ཧ་ཅང་གུ་ཡང་ཤིག་རང་ཤུགས་ཀྱིས་འཆར་ཡོང་བ་དེས་སེམས་ལ་ངལ་གསོ་ཆེན་པོ་ཐེབས་ཀྱི་འདུག།",
    "དུང་དཀར་མང་པོ་འདུག་པ་ངས་དེ་ནས་གང་མཚམས་ཤིག་སྒྲུག་ནས་དྲན་རྟེན་དུ་ཉར་ཡོད།",
    "གལ་ཏེ་སྙན་སེང་ཞུས་འགབ་ཆེ་ཚེ་གཙོ་བོ་ཁོ་རང་བཞུགས་སྒར་དུ་ཆེད་བཅར་ཞུས་ནས་གདན་ཞུ་སྙན་སེང་ཞུ་རྒྱུ་ཡང་།",
    "གནས་ཚུལ་དེས་ཌོག་ཊ་བོད་པར་ཞེན་པ་གཏིང་ནས་ལོག་སྟེ་བྱམས་པ་ཁོ་རང་ལ་ཌོག་ཊས་བརྗོད་གསལ།",
    "ཌོག་ཊས་ལག་ཐོག་ཏུ་ཌོ་ལར་སྟོང་ཕྲག་ཉི་ཤུ་སྤྲོད་རྒྱུ་བྱས་འདུག་ཀྱང་།",
    "ང་རང་དང་།",
    "སུད་སིར་ཡོད་པའི་བུ་རྒན་པ་བློ་བཟང་ཚེ་བརྟན་བར་ཞི་ནས་སྔ་ལོ་བོད་དུ་ལྟ་བསྐོར་དུ་ཕྱིན་ནས་བོད་མིའི་བདེ་སྡུག་ལ་མྱོང་ཞིབ་བྱུང་སྟབས་ཁོ་པར་ཡིད་འགྱུར་ཆེན་པོ་ཐེབས་འདུག།",
    "འཇིགས་ཞུམ་སོགས་གང་ཡང་མ་བྱུང་ཞེས་ཟེར་འདུག།",
    "ཆུ་ཀ་ལར་འཁྱགས་བརྒྱབ་ནས་སྐྱོན་ཤོར་ཏེ་ཁང་པ་འགའ་ཤས་ལ་སྐྱོན་ཆེན་པོ་བཟོས་ཡོད་འདུག།",
    "མི་གྲངས་ནི་ཕལ་ཆེར་སྟོང་ཕྲག་སུམ་ཅུ་ལྷག་ཙམ་ཡོད་འདུག་ཅེས་དང་།",
    "དེ་བཞིན་ང་རང་དང་མཉམ་དུ་སྤྱི་དོན་ངལ་བ་ལྷུར་ལེན་བྱེད་པོ་འདས་གསོན་རྣམས་ལའང་འདི་ཕྱི་ཚེ་རབས་ཀུན་ཏུ་རྗེས་འཛིན་ཐུགས་སྨོན་༧སྐྱབས་འཇུག་ཡོད་པ་ཞེས་༧སྐྱབས་ཞུ་རྟེན་སྤྲུགས་འབུལ་ལམ་ཞུས་པར།",
    "དེ་ཚོ་ནི་རྒྱ་དམར་ཁོ་རང་ལག་གྲ་མ་སྒྲིག་པའི་བར་སྐལ་དུས་སྐབས་སྐྱེལ་ཆེད་གཡོ་རྒྱུའི་རྒྱུད་ལམ་ཞིག་ལས།",
    "སྐྱེ་རབས་དཔག་བསམ་འཁྲི་ཤིང་ལས་གཡས་ཀྱི་ཆ་ཤས་ཞིག་དུས་རབས་བཅུ་གཅིག་པའི་ནང་ཤམ་པོའི་ཉེ་འདབས་ནས་བྱུང་བའི་འབྲུག་རྭ།",
    "དེར་ཤམ་པོ་ཁོ་རང་མི་དཀར་གཡུའི་རྨིག་མ་དང་དུང་སོ་འཁོར་མར་ཡོད་པ་ལོ་བཅུ་དྲུག་ལོན་པའི་ན་ཚོད་ཅན་གཅིག་ཏུ་བྱས་ནས་བྱུང་སྟེ།",
    "མི་བས་ལྷ་འདྲེ་ཁས་བླངས་དང་དམ་བཅའ་ལ་གནས་པར་འདུག་གསུངས།",
    "འདི་ཉིད་སློབ་དཔོན་ཆེན་པོ་པད་མ་འབྱུང་གནས་དང་རྭ་ལོ་ཙཱ་བ་སོགས་ཀྱིས་དམ་ལ་བཏགས་ཤིང་དམ་ལ་འདོགས་ཚུལ་ནིཔད་མ་བཀའ་ཐང་ལས་དེ་ནས་ཤམ་པོ་ལུང་དུ་བྱོན་ཙ་ན།",
    "མཁས་པ་ཆེན་པོ་ཁེར་ན་ཞེས་པ་དེས་སྟོན་པའི་འདས་ལོ་སྤྱི་ལོའི་སྔོན་གྱི་ལོ་སུམ་བརྒྱ་བདུན་ཅུ་ཐམ་པ་སྟེ་ལྕགས་ཕག་ལོ་༣༧ལ་བཞེད་འདུག་གོ།",
    "འོན་ཀྱང་རང་བློས་ལྕོགས་ཚོད་ཀྱིས་གཤིབ་བསྡུར་ཞིག་བྱས་ན།",
    "འདི་ནི་བོད་ཀྱི་བཤེས་གཉེན་ཕལ་ཆེ་མི་༩ བས་བཞེད་པར་འདུག་ཀྱང་འདི་ཉིད་ལ་རྣམ་པར་དག་པའི་རྒྱབ་རྟེན་འདུག་ཅིང་དཔལ་དུས་ཀྱི་འཁོར་ལོ་དང་ཕྱོགས་ཙམ་དུའང་མ་འགྲིགས་པས་སྒྲ་ཇི་བཞིན་པ་ནི་ནམ་དུའང་མ་འགྲིགས་པས་སྒྲ་ཇི་གཏམ་རྒྱུད་གསེར་གྱི་ཐང་མའི་ཟིན་ཐོ།",
    "ཞེས་གདམས་ཡོད་པ་ནི་ངེས་པར་དེ་ག་རང་དུ་འདུག་སྟེ།",
    "འོན་ཀྱང་ཞོ་ལྟ་བུའི་ཀླད་པ་ཁོ་རང་ནི་བེམ་པོ་ཡིན་པས་ཤེས་པར་ག་ལ་རུང་།",
    "ལྷའི་རྣམ་པ་སོགས་མང་པོ་ཟེར་ཀྱང་ཡིན་ངེས་པ་བྱང་སེམས་ཁྱིམ་པའི་རྣམ་པར་འདུག་སྙམ།"
  ]
}