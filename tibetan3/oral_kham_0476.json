    "བཏང་ཚེས་ལ་ལན་བཟོས་ན་མ་གཏོགས་དེ་བྱིང་ཕར་སྔོན་དུ་བཏང་བའི་གནས་ཚུལ་དེ་རང་ལེབ་བཤུས་རྒྱབ་འདུག་པ་ལན་གཏོང་ཡས་མི་འདུག་བྱས་པས།",
    "ང་རང་ནང་ཟིང་ལ་དགའ་པོ་མེད་ཙང་།",
    "ལས་བྱེད་བདག་གཉེར་ལ་གོ་བསྡུར་བྱེད་དགོས་ཡོད་ཚུལ་སོགས་ཀ་ཀོར་ཁོ་ནས་རྩ་ནས་སྤྲད་མ་བྱུང་བ་ཤོད་སྟངས་ལ་བལྟས་ཚེ་སྡུག་གྱོང་གཏོང་རྩིས་བྱེད་འདུག་པ།",
    "ངས་ཡར་ཁོ་རང་མདུན་ཐད་ཀར་ཕྱིན་ནས་གུས་འདུད་སོགས་རྩ་བ་ནས་མ་བྱས་པར་ལམ་སེང་ཁ་སྤྲོད་དུ་རྐུབ་སྟེགས་ཤིག་སྒང་བསྡད་ནས།",
    "སྐུ་ངོ་ཁྱེད་རང་ང་སྒང་ཏོག་སྡོད་རིང་ཕོགས་མ་སྤྲད་པ་དེ་སྤྱོད་ཀྱི་ཡིན་ནམ་མིན་བྱས་པར།",
    "ལམ་སེང་ཕུལ་ཆོག་ཟེར་འདུག་པ།",
    "བྱུང་འཛིན་ཞིག་བྲིས་ནས་ཁྱེར་ཏེ་སྐུ་ངོ་ཕ་ལྷས་འདི་སྐུ་ངོ་ཁྱེད་རང་ལ་ཕུལ་ནས་བྱུང་འཛིན་འདིར་མིང་རྟགས་སྐྱོན་རོགས་ཞུས་གསུང་འདུག་ཟེར་བར་དངུལ་དེ་བླངས་ནས་གྲང་བཤེར་གྱིས་འཛིན་དེར་མིང་རྟགས་བརྒྱབ་ནས་སྤྲད་པ་ཡིན།",
    "དངུལ་དེ་ཆ་ཚང་ཉིན་ཤས་རྗེས་རི་ནག་ཡ་པ་སྟོབས་རྒྱལ་ལགས་སྒང་ཏོག་ཏུ་ཐོན་གྱི་འདུག་པ་ཁོང་གདོང་ཕ་མ་གཉིས་ལ་བསྐུར་བ་ཡིན།",
    "ང་རང་ཡང་དེར་ཡོད།",
    "ང་རང་སྐུ་མདུན་དུ་བཅར་ནས་སྒང་ཏོག་ཏུ་སྐྱེད་བྱེད་བསྙན་མནར་ལ་མཇལ་འཕྲད་དུ་བཅར་རྒྱུར་ཡར་ལམ་འགོག་མེད་ཤར་གཏོང་ཡོང་བ་ཞུས་པར།",
    "པཱ་ལགས་བསྙུན་བབས་སྡུག་པོ་མི་འདུག་གམ་ཞེས་བཀའ་འདྲི་གནང་བར།",
    "དེ་ནས་བར་དེར་གནས་ཚུལ་འདྲ་མི་འདྲ་མང་པོ་བྱུང་ཡོད་ཀྱང་ཁྱེད་རང་བློ་ཕམས་མི་དགོས།",
    "དེ་ནས་སང་ཉིན་ང་རང་གཅིག་པོ་མེག་གྷན་ནས་བྷ་སེར་བཞུགས་ཏེ་པ་ཀོར་འབྱོར།",
    "རོང་སྦུག་བརྒྱུད་སྒང་ཏོག་ཏུ་འབྱོར་སྐབས་སྐྱེད་བྱེད་བསྙུན་གཞི་དུག་གཡའ་བྱུང་འདུག་པ་ཐོག་མར་གཞི་ལྕི་ཡོད་འདུག་ཀྱང་།",
    "ང་འབྱོར་སྐབས་དབེན་ཅན་དུ་བཞུགས་འདུག་པ་དྭངས་སྐྱེད་ཡག་པོ་བྱུང་འདུག།",
    "ཉིན་གཅིག་སྒང་ཏོག་དོན་གཅོད་རྩིས་དཔོན་རྣམ་སྲས་གླིང་པས་རྡ་ས་བཞུགས་སྒར་ནས་སྩལ་བའི་བཀའ་རྒྱ་ཞིག་ངའི་སར་སྐྱེལ་བར་བཏང་འདུག།",
    "ཀུན་གླིང་བཅས་ལྷན་རྒྱས་འདུག་ཀྱང་།",
    "ལྡི་ལི་དོན་གཅོད་གཉིས་ཀྱི་རྩིས་ཁྲར་དྲི་བ་གཏོང་དགོས་མང་ཤོས་འདུག་པ་ཁུངས་སོ་སོར་དྲི་བ་བཏང་བར།",
    "ནང་སྲིད་གཙོ་འཛིན་མགྲོན་ཆེ་ཕ་ལྷས་ཕྱོགས་བསྐྱོད་སྐབས་ཐེང་འགའ་ཤས་གནམ་གྲུར་ཕྱིན་འདུག།",
    "དོན་དུ་འགའ་ཤས་རང་འདོད་གང་ཡོད་བྱེད་ས་མེད་པ་སྦུག་སུབ་དྭགས་པོ་ཞིག་བྱུང་ནས་ང་ལ་མི་དགའ་མང་པོ་བྱུང་འདུག་རུང་།",
    "ང་རང་ལམ་ཞོར་པ་ཀོ་ནས་ཌལ་ཧོར་སློབ་གྲར་ལྟ་བསྐོར་ལ་ཕྱིན་པ་ཡིན།",
    "ང་གཉིས་ནས་བྱམས་པ་རྣམས་རྒྱལ་གྱོན་ཆས་ཕྲན་བུ་དྲག་པོ་འདུག།",
    "ང་དཀའ་ལས་ཁག་པོ་ཞེ་པོ་གཅིག་འདུག་ཅེས་གསུང་ནས།",
    "བཀའ་བློན་ལ་སྐུ་ངལ་ཞེ་དྲག་འདུག།",
    "ཀིར་ཏི་ཕྱག་མཛོད་གཉིས་ནས་དེ་དོན་རང་ཡིན་ཐུགས་ཁག་མི་འདུག་ཀྱང་།",
    "འདི་ལོ་ནས་བྱས་ཏེ་ཐོབ་ཆ་ཆུང་དུ་བཏང་འདུག་པ་ལས།",
    "དེའི་ཐོག་སེམས་ཤུགས་ཀྱང་ཧ་ཅང་ཆེན་པོ་འདུག།",
    "རྒྱལ་གཅེས་ཀྱི་སེམས་ཤུགས་ཀྱང་ཧ་ཅང་ཆེན་པོ་ཞིག་འདུག།",
    "དེ་སྐབས་ཉིན་གཅིག་༧སྐྱབས་རྗེ་རྡོ་རྗེ་འཆང་སྐུ་མདུན་དུ་མཇལ་ཁ་ཞིག་ལ་བཅར་བས་འདིར་སྐྱིད་ལོས་འདུག་ཅེས་བཀའ་འདྲི་ཕེབས་པ།",
    "ད་དུང་ཡང་སེམས་པ་སྐྱིད་པོ་རང་མི་འདུག་ཞུས་པས།",
    "འདི་སྐབས་ཤིག་ཏུ་སྒང་ཏོག་ནས་ཕ་མ་རྣམས་གཉིས་ཀྱིས་ཕྱག་བྲིས་སྩལ་དོན་གཅུང་པོ་བྱམས་པ་བཀྲིས་ཐབས་ཤེས་བུ་ཕྲུག་བཅས་འབྲུག་བརྒྱུད་རྒྱ་གར་ནང་རྡོར་གླིང་དུ་འབྱོར་འདུག་ཅེས་གསུང་པ་ལྟར།",
    "ང་རང་ལའང་ཐབས་ཤེས་ཀྱི་ནུས་པ་ལྡེང་ངེས་མེད་སྟབས་ངས་ཡབ་གཞིས་ས་ཆེ་རྒྱལ་དོན་མཆོག་ལ་རྡོར་གླིང་དུ་ཕྱག་བྲིས་ཤིག་ཕུལ་ནས་རྒྱ་གར་དུ་གཏན་སྡོད་ལག་འཁྱེར་ཐོབ་ཐབས་རོགས་རམས་གནང་རོགས་ཞུས་པར།",
    "སྙན་སེང་དང་འབྲེལ་༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོའི་མཇལ་ཁར་བཅར་ནས་དད་རྟེན་སྐུ་པར་མཚན་རྟགས་འབྱར་མ་ཞིག་ཀྱང་གསོལ་རས་སྩལ་འདུག།",
    "ཐབ་ཚང་ནས་མེ་བླང་ཏེ་ང་སྡོད་སར་སངག་འདུགས་ཀྱི་ཡོད།",
    "ཕྲུག་གུ་ཆུང་སྟབས་དེ་ཙམ་སྣང་བ་མི་འདུག་ཀྱང་།",
    "ང་རང་ཧ་ཅང་སེམས་འཕམས་པོ་ཞིག་བྱུང་།",
    "སྡོད་གནས་སོགས་གང་ཅིའི་རོགས་རམ་ཡག་ཐག་ཆོད་གནང་འདུག།",
    "དུས་ཚོད་འདིའི་ནང་མ་སུ་རི་སློབ་གྲ་ནས་གཞི་རིམ་སློབ་སྦྱོང་དང་པོ་ཐོན་པ་མི་གྲང་བརྒྱད་འདུག་པ།",
    "རྒྱ་གར་གཞུང་ནས་འགན་ལེན་མེད་ཅེས་གསུང་འདུག་པ།",
    "ད་ཆ་བོད་ཕྲུག་རྣམས་ཀྱི་མཐོ་འབྲིང་སློབ་སྦྱོང་ལ་རྒྱ་གར་གཞུང་ནས་རོགས་རམ་གནང་རྒྱུའི་འཆར་གཞི་འགན་ལེན་མེད་ཅེས་གསུང་སྟངས་ལ་བལྟས་ཚེ་ང་རང་བོད་ལུགས་སློབ་སྦྱོང་རྙིང་པའི་འགྲོ་སྟངས་ལས།",
    "དེང་དུས་ཀྱི་སློབ་སྦྱོང་འགྲོ་སྟངས་ལ་རྒྱུས་མངའ་མེད་སྟབས་ནོར་འཁྲུལ་བྱུང་མེད་དམ་སྙམ་གྱི་འདུག་དོགས་སེལ་ཆེད་ངས་ཁྱེད་རང་ལ་དྲི་བ་འགའ་ཤས་ཞུ་འདོད་བྱུང་།",
    "ཁོ་ཚོ་ཚང་མ་ཤེས་ཚད་ཡག་པོ་འདུག།",
    "རྗེས་སོར་ཁྱེད་རང་ཁག་པོ་བྱས་ཡོང་ངམ་ཞེས་འཇིགས་བསྐུལ་ཡང་བྱས་བྱུང་།",
