    "སྐད་ཆ་དེ་གོ་བ་ཡིན་སྟབས་ཁྱེད་རང་ལ་བཀའ་འདྲི་ཞུ་བར་ཡོང་བ་ཡིན།",
    "འོན་ཀྱང་དེའི་ནང་གྲྭ་ཆས་གྱོན་པ་མི་འདུག།",
    "ཁ་རས་ཤིག་བཞེས་རྐང་འཁོར་ཞིག་བཞོན་ནས་སླར་ཡང་ནོར་གླིང་གཞུང་སྒོའི་འགག་ཏུ་ཕེབས་འདུག་པ་ཁོང་ལ་རྣམ་ཀུན་རྒྱ་མི་དང་འབྲེལ་བ་ཡོད་པའི་དྭོགས་པ་བྱེད་མི་མང་པོ་ཡོད་ཁར།",
    "ཆས་གོས་གྱོན་སྟངས་དེས་མི་དམངས་རྣམ་རྟོགས་ཆེ་རུ་ཕྱིན་ནས་འགའ་ཤས་ཀྱིས་ཁོང་ལ་རྡོ་བཞུས་འདུག་པར།",
    "སྐད་འབོད་ཀྱི་འབྲུག་སྒྲ་ལྡིར་བཞིན་འདུག།",
    "མནའ་གན་འཇོག་མི་ཡང་ཕལ་ཆེར་འདུག་པ་ངས་ཚང་མར་ད་ཉིན་གྱི་གནས་ཚུལ་འདི་༧རྒྱལ་བ་ཡིད་བཞིན་ནོར་བུའི་སྐུ་ཕྱྭའི་ཉེན་ཁ་འགོག་པ་དང་།",
    "ཅེས་གསུང་འདུག་པ་ལྟར་ཆིབས་བསྒྱུར་གྱི་སྒྲ་སྒྲིག་དང་འབྲེལ་གདན་ཞུ་ཚགས་ཚུད་གནང་ཐུབ་པ་དེ་ཡང་གལ་ཆེའི་བྱས་རྗེས་ཤིག་ཡིན་ངེས་ཀྱང་།",
    "འབྲས་བཟའ་མི་གཉིས་དབྱེ་འབྱེད་བྱེད་དགོས་ཞེས་ཚང་མ་དགོངས་བཞེས་རྩེ་མཐུན་འདུག་ཀྱང་།",
    "ང་གཉིས་བཀའ་ཚབ་སྣེ་ཤར་འཁྲིས་གཤམ་དེར་གདན་ཐོབ་གཅིག་པ་སྟོང་པ་ཞིག་འདུག་པ་དེར་སྡོད་ཅེས་དབུ་ནན་གནང་འདུག་ཀྱང་།",
    "དེ་ནས་ཕྱིར་ཐོན་ནས་ང་རང་གཉིས་ནོར་གླིང་དུ་གནས་ཚང་རྩེ་གཟིམ་འགག་ལས་འཕར་བློ་བཟང་བསྟན་འཛིན་གྱི་ལས་ཤག་ཏུ་ཡོད་པས་དེར་ལོག་སྟེ་ངལ་གསོ་ཕྲན་བུ་རྒྱབ་དགོང་དྲོའི་ལྟོ་ཟས་རྗེས་ནོར་གླིང་གཞུང་སྒོའི་སྒོ་ཕིབས་འོག་དེར་ཕྱིན་ནས་མཚན་གང་དེར་བསྡད།",
    "གསང་བ་ཕྱི་ཤོར་སོགས་མི་འབྱུང་ཆེད་མཚན་གུང་དེར་རྒྱལ་སྒོ་གཞུང་སྒོར་ཡོད་པའི་གང་རྩེ་བ་མི་བརྒྱ་ཐམ་པ་དེ་ཁྲིད་ནས་ཆིབས་བསྒྱུར་སྔོན་ཙམ་ལ་བདེ་སྐྱིད་གླིང་གའི་རྒྱལ་སྒོའི་འཁྲིས་གླིང་བསྐོར་ལམ་བར་ང་རང་ཡང་མཉམ་དུ་ཕྱིན་པ་ཡིན།",
    "ང་རང་རྒྱལ་སྒོ་གཞུང་སྒོར་འགྲོ་སྐབས་སྐུ་སྲུང་དམག་མི་རྣམས་འཇམ་ཆགས་གེར་རང་འཇགས་བསྡད་འདུག་ཁམས་རིགས་གང་རྩེ་བ་རྣམས་གཅིག་ཀྱང་མི་འདུག།",
    "ཁམས་རིགས་རྣམས་གཞུང་སྒོར་མ་བསྡད་པར་དེའི་འཁྲིས་ཕེབས་ལམ་བྱང་ངོས་གླིང་གའི་ནང་ཕྱིན་ནས་ཀི་ཧི་ཀི་ཧི་ཞེས་ནག་ཁུང་ནང་མེ་མདའ་གྲངས་མེད་འཕེན་རྒྱག་བྱེད་ཀྱི་འདུག།",
    "མེ་མདའ་མ་རྒྱག་བྱས་ཀྱང་ཉན་འཇོག་རྩ་བ་ནས་བྱེད་ཀྱི་མི་འདུག།",
    "མེ་སྒྱོགས་ཀྱི་སྒྲ་སྐད་ཀྱིས་རྣ་བའང་འོན་ཞིང་ཡིད་ཤིན་ཏུ་བསུན་པས་སྐད་དེ་མེད་ས་ཞིག་ཏུ་སླེབས་རོགས་བྱས་ན་བསམ་པ་ལས་གཞན་པའི་ཅི་བསམ་མི་འདུག།",
    "དམག་སྒར་ལ་བསྟོར་སྐྱོན་གང་མཚམས་བྱས་འདུག།",
    "མི་རྟ་མང་པོ་བསད་ནས་རོ་གང་མཚམས་འདུག།",
    "ཁྱེད་ཚོ་དཔའ་མ་ཞུམ་ཨང་ཞེས་འམ་གཅིག་བདམས་ནས་ཟེར་གྱི་འདུག།",
    "དེ་ནས་ང་རང་ཁོང་གཞུང་སྒོར་ཡོད་པའི་གང་རྩེ་བ་ཡང་ཚང་མ་ཕྱིན་ཚར་འདུག།",
    "ད་ག་རང་ཟེར་བ་མ་གཏོགས་ལན་ཚིག་གཅིག་ལབ་ཐུབ་ཀྱི་མི་འདུག།",
    "ཁ་ཟས་ཁ་ལ་འགྲོ་བ་མི་འདུག།",
    "དེ་ནས་གནས་ཚང་གཟིམ་འགག་ལས་འཕར་བློ་བཟང་བསྟན་འཛིན་ཤག་ཏུ་ཕྱིན་པས་གཟིམ་འགག་ཁོང་རང་ཞོག་པ་དེ་རང་ལ་རྒྱལ་སྒོ་ལྷོ་སྒོའི་འཁྲིས་དེར་མེ་སྒྱོགས་ཐེབས་ནས་གྲོང་ཡོད་འདུག།",
    "ཁྱེད་རང་སྒུགས་བཞིན་ཕེབས་ཨང་ཟེར།",
    "བྱེ་རགས་སྒང་མི་འགའ་ཤས་བསད་དེ་རོ་འདུག།",
    "སྨར་ཁམས་ལས་དྲུང་ཚང་འཆི་མེད་རྒྱུན་མཚན་སོགས་ཁམས་རིགས་འགའ་ཤས་བཅས་འདུག།",
    "ང་ནང་དུ་སླེབས་པ་དང་ཚང་མས་ཁྱེད་རང་ཐར་བ་ཡག་པོ་བྱུང་ཞེས་དགའ་པོ་བྱེད་ཀྱི་འདུག།",
    "དེ་མཉམ་ཇ་ཐང་ཁོག་ཏིར་གང་ཡང་སྤྲད་བྱུང་བར་རིན་འབབ་ཡེ་དར་ལགས་སུ་དངུལ་ཤོག་ལོར་ཕྲན་བུ་བསྣམས་རྒྱུ་འདུག་པ་ནས་སྤྲད།",
    "ཁྱེད་རང་ཕྱིར་ཕེབས་གནང་ཚེ་བར་ཞི་ཤག་ཏུ་གཅུང་པོ་ངག་འཇིགས་ལ་ང་ཕན་པོ་བརྒྱུད་ལྷོ་ཁ་ཕྱོགས་འགྲོ་རྒྱུ་ཡིན།",
    "ངས་གླེང་བྱུང་ན་ཡང་འགྲིགས་འདུག་པ་གཡར་རོགས་ལབ་པར།",
    "དེ་བཞིན་ཡེ་ཤེས་དར་རྒྱས་ལགས་སུ་སེར་སྨད་གྲྭ་ངོ་ཤེས་ཤིག་ནས་རྟ་སྒ་རང་འགྲིགས་སྔོན་པོ་གཅིག་ལམ་ཁར་སྤྲད་འདུག་པ་སྐལ་བཟང་ཀུན་དགའ་བསྐྱོན་ནས་ཕན་ཐོག་ཆེན་པོ་བྱུང་འདུག།",
    "དེ་ནས་ཚུར་བླ་སྤྱིའི་སར་ཡོང་སྐབས་གྲ་པ་དེ་ཚོའི་རྣམ་འགྱུར་ཕྲན་བུ་མི་འདྲ་ཞིག་བསྟན་གྱི་འདུག་པ་དེ་གའི་མུར་བླ་སྤྱི་ཚུགས་ཡུལ་སྒོ་འགྲམ་སླེབས་པ་དང་ནང་དུ་མ་བཏང་བར་གཟིམ་ཆུང་ཉི་འོད་ནང་འཁྲིད་བྱུང་།",
    "ལྷ་སར་གནས་ཚུལ་ཇི་བྱུང་ཧ་རྩ་བ་ནས་གོ་མི་འདུག་སྟབས་ལམ་སེང་ལྷ་སར་བརྩད་དཔྱོད་བྱེད་པར་མི་བཏང་ཡོད་འདུག།",
    "རོགས་པ་རྣམས་ཀྱི་ད་ཁ་ཁར་བཞུགས་ཞེས་ཚང་མས་གསུང་འདུག།",
    "ཕ་ར་གཉིས་གྲལ་འགོར་གདན་མཐོ་ཙམ་ཞིག་སྒང་བསྡད་འདུག།",
    "ད་ཆ་ཇི་འགའ་བཀའ་སློབ་ཡོད་པ་ཞེས་གསུང་འདུག་པ།",
    "དེ་བཞིན་ལྷ་སའི་གནས་ཚུལ་བཀོད་ནས་ད་ཆ་ཉིད་རང་ཡང་ཇི་འགབ་དགོངས་བཞེས་གནང་རན་ཞེས་སློབ་སྟོན་ཡི་གེ་སྐྱེལ་བར་བཏང་བས་སང་ཞོག་ཉི་མ་མ་ཤར་གོང་བང་མི་ཕྱིར་ལོག་བྱུང་བ་དེ་གདོང་ལམ་ཡིག་བསྐུར་འདུག།",
    "སང་ཉིན་ང་ཁྱེད་རང་རྣམས་མཇལ་བར་ཡོང་རྒྱུར་ང་མ་ཡོང་བར་མ་འགྲོ་རོགས་ཞེས་ཟེར་འདུག།",
