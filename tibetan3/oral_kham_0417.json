    "ཁྱེད་རང་ཚང་མར་ཐུགས་རྗེ་ཆེ་ཟེར་རྒྱུ་ཡིན།",
    "དྲང་པོས་གཞུང་བསྲངས་བྱེད་མཁན་ཞིག་ལ་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་འདུག་དཔེར་ན་རྒྱ་གར་ནང་ལ་ཆ་བཞག་ན་ཡང་།",
    "དེ་གལ་ཆེན་པོ་འདུག་ཡུལ་པ་ཚོ་ལ་མཐུན་པོ་བྱེད་དགོས།",
    "ལྷག་དོན་དེ་རིང་ཕྲུ་གུ་ཚོ་ཐུག་པའི་སྐབས་ལ་ཚང་མ་གྲུང་ཏོག་ཏོག་ཡག་ཐག་ཆོད་འདུག་དགའ་པོ་བྱུང་།",
    "ཡིན་ན་ཡང་གོང་དུ་ལས་བསྡོམས་ཀློག་པ་ལྟར་ཡར་རྒྱས་གང་ལ་གང་འཚམ་ཕྱིན་འདུག་དོན་དག་མེད་པའི་སེམས་ཁྲལ་བྱས་ན་ཕན་ཐོགས་གང་ཡང་མེད།",
    "རང་རང་སོ་སོའི་སེམས་རྒྱུད་ལ་ཞུ་དག་གཏོང་རྒྱུ་དང་།",
    "ཁྱེད་རང་ཚང་མ་སེམས་སྐྱིད་པོ་བྱས་ནས་སྡོད་རོགས་བྱེད།",
    "དེ་རིང་ངས་ནང་པའི་ཞབས་འདྲེན་རང་ཞུས་མི་འདུག་འགྲིག་ཙམ་བྱས་འདུག་བསམ་ན་ཕོ་རྒོད་པོ་ངས་དེ་རིང་གོ་ཆོད་པོ་བྱས་འདུག་བསམ་ནས་དགའ་བ་སྒོམ།",
    "ཡང་དེ་རིང་ངས་ནང་པའི་ཞབས་འདྲེན་ཞུས་འདུག་ངས་མི་ལ་དོན་དག་མེད་པར་ཁ་རྩོད་བྱས།",
    "མགོ་སྐོར་བཏང་བ་སོགས་སོ་སོས་འགྱོད་པ་སྐྱེས་གཞིའི་གནས་ཚུལ་བྱུང་འདུག་ན།",
    "ཁོས་ཐབས་སྡུག་འདི་ལྟ་བུ་བྱས་འདུག་བསམས་ནས་སོ་སོས་སོ་སོར་དམའ་ཕབ།",
    "ང་རང་ལ་ཆ་བཞག་ནའང་དཀའ་ངལ་དང་འགན་ཆེན་པོ་ཞིག་འཁྲི་ཡོད་ནའང་།",
    "ང་རང་ཡང་གང་ཐུབ་ཀྱི་བསམ་པ་བཟང་པོའི་ཉམས་ལེན་བྱེད་ཀྱི་ཡོད།",
    "དེང་སང་བོད་སྐད་ཐོག་ནས་བྱེད་དགོས་ཀྱི་འདུག་བོད་སྐད་དེ་གསལ་ཤོས་དང་།",
    "རུས་རྩིས་ས་ཡོད་པ་ཞིག་འདུག་ཅེས་གང་དུ་ཡིན་ན་ཡང་ཕལ་ཆེ་བར་བསྔགས་བརྗོད་ཐོབ་མཁན་ཞིག་ཆགས་ཡོད།",
    "དེ་རིང་ང་རང་དགའ་པོ་བྱུང་།",
    "ལེགས་པ་ཡོད་པ་ལྟ་བུ་ཞིག་འདུག་དཔེར་ན།",
    "ཤེས་དགོས་པ་མང་པོ་ཞིག་འདུག་ག་",
    "ཕྱོགས་གཅིག་ནས་ང་རང་སྒེར་གྱི་ངོས་ནས་ཀྱང་དེ་སྐོར་ཤེས་འདོད་ཆེན་པོ་ཡོད།",
    "དེ་ལ་འགྱུར་བ་འགྲོ་དོན་མི་འདུག་དེང་སྐབས་བོད་ནང་ལྟོ་གོས་ཕྲན་བུ་དྲག་ཏུ་ཕྱིན་པ་དང་།",
    "ཀྲུང་གོའི་ས་མཚམས་ཟེར་མཁན་ཡང་འདུག་དེ་ལྟར་ཟེར་མི་རུང་།",
    "ཁོ་རང་རྡོ་རྗེ་གདན་ལ་སླེབས་ནས་ཀྱང་མཐོང་ཚུལ་དེ་ལྟར་རང་བྱུང་།",
    "ཞིབ་ཚགས་སུ་བཏང་ནས་སྐད་ཆ་ཤོད་རྒྱུ་གལ་ཆེན་པོ་འདུག་དཔེར་ན།",
    "ཆུ་ཐོག་འོར་འདྲེན་གང་འདྲ་ཞིག་བྱས་འདུག་གམ།",
    "དེ་མིན་གསེར་དངུལ་ཟངས་ལྕགས་ཀྱི་སྐུ་གསུང་ཐུགས་རྟེན་ཡོངས་རྫོགས་རྒྱ་ནག་ལ་དབོར་འདུག་དཔེར་ན།",
    "ད་ལྟ་ངས་གྲངས་ཀ་ལམ་སེང་ཤོད་ཐུབ་ཀྱི་མི་འདུག་པ་ལས།",
    "དེ་དང་དེ་ལྟ་བུའི་རྒྱ་རིགས་སློབ་ཕྲུག་དེ་ཚོས་ཀྱང་ཤོད་ཀྱི་འདུག་རྒྱ་ནག་ནང་ལ་སྲིད་བྱུས་གུ་ཡངས་ཡོད་ལུགས་ཟེར་ནའང་།",
    "རྒྱ་རིགས་དེ་དང་པོ་བོད་ཀྱི་རྨ་ཆུ་རྒྱ་ཐང་དུ་བབས་པའི་ཆུ་ཆེན་རྒྱ་སྐད་ཧོང་ཧཱ་གཙང་པོ་སེར་པོ་ཟེར་བའི་རྒྱུད་ལ་ཆགས་འདུག་དེ་རིམ་པས་མི་རིགས་འཕེལ་རྒྱས་ཆེན་པོ་ཕྱིན་པ་དང་།",
    "གང་སར་རྒྱ་མི་སླེབས་འདུག་རྩ་བ་ནི་སོ་སོའི་ལྟོ་གོས་མགོ་གྲུང་པོ་དང་།",
    "སྔོན་མ་ཡིན་ན་མི་བསད་ཀྱི་འདུག་གཏོར་བཅོམ་བྱེད་ཀྱི་འདུག་ཅེས་བརྗོད་ན་དེ་ལས་ལྷག་པའི་ཚིག་མང་པོ་ཤོད་དགོས་ཀྱི་མི་འདུག་དེང་སང་གཏོར་བཅོམ་ནི་བྱེད་ཀྱི་མེད།",
    "བསགས་ནས་ཕན་ཐོགས་མི་འདུག་ཟེར་བ་དེའི་ཐོག་ནས་ཕུགས་བཙན་པོ་མེད་པའི་ངོས་འཛིན་གསལ་པོ་བྱེད་ཀྱི་ཡོད་པའི་རྟགས་མཚོན་གྱི་ཡོད།",
    "དེ་བོད་སྐད་སྐྱོ་དྲགས་པས་བྱས་མི་འདུག་དཔེར་ན།",
    "སློབ་ཚན་གཞན་དག་དུས་རབས་ཉི་ཤུ་པའམ།",
    "སོ་སོའི་ལུང་པ་ནི་ཁ་ཐབས་སྐྱོ་ཐག་ཆོད་ཆགས་ཏེ་མི་རིགས་ཁོ་རང་རྩ་མེད་འགྲོ་བའི་ཉེན་ཁའི་མཚམས་སུ་སླེབས་ཡོད།",
    "ཡག་པོ་འདུག་ཅེས་ཤོད་རྒྱུ་ཞིག་བཟོས།",
    "ཚུར་ཕྱོགས་ལ་གོང་གསལ་འགྱུར་བ་གསུམ་པོ་ཡོང་རྒྱུའི་ཉེན་ཁ་ཆེན་པོ་འདུག་གཟབ་གཟབ་བྱེད་དགོས།",
    "གཞན་གྱིས་བོད་པས་མི་འཇོན་པའི་ཁ་འཕང་ལག་འཕྱིས་བྱེད་ས་ཆགས་ན་དེ་ཡག་པོ་མི་འདུག་ངེས་པར་དུ་གཟབ་གཟབ་བྱེད་དགོས།",
    "རྩ་བའི་མི་རིགས་ཁོ་རང་བརླག་རྒྱུ་དང་།",
    "འོན་ཀྱང་མང་ཆེ་བ་ནི་མི་རིགས་ཀྱི་དོན་ལ་སེམས་ཤུགས་ཡོད་པ་ཧ་ཅང་གསལ་ཐག་ཆོད་འདུག་དེ་ལ་རྗེས་སུ་ཡི་རངས་ཡོད།",
    "ང་རང་ད་ལམ་འདིར་གཙོ་བོ་ས་ཆའི་བབས་དང་།",
    "ང་རང་ལ་ཆ་བཞག་ན།",
    "དེས་ཕན་གྱི་འདུགཆ་",
    "ད་དུང་ཡིན་ན་ཡང་ཤུགས་བརྒྱབ་ནས་སྡོད་དགོས་ཀྱི་འདུག་ཉ་",
    "དེ་ཡག་པོ་གང་ཡང་མི་འདུག་ལྷག་བསམ་ཐོག་སྐྱོན་ཡོད་རུང་མེད་རུང་།",
    "ཁོ་རང་རྒས་པོ་ཆགས་འདུག་ཤིན་ཅང་བ་གང་འཚམ་ཞིག་ཏུར་ཀིའི་ནང་ཡོད་སྟབས།",
    "དེ་ལྟར་བྱས་འདུག་ཡག་པོ་བྱུང་།",
    "ང་རང་ཡང་དགའ་པོ་བྱུང་།",
    "ཐོན་སྐྱེད་ཀྱི་ལས་རིགས་གསར་པ་གང་དང་གང་བྱེད་རྒྱུ་འདུག་དེ་ལྟ་བུའི་བསམ་བློ་གཏོང་དགོས།",
    "དེ་གལ་ཆེན་པོ་འདུག་སྤྱི་ས་བར་ས་བྱས་ནས་འཐུས་ཤོར་བཏང་ན།",
    "དེང་སང་འཛམ་གླིང་ཐོག་བོད་པའི་གནས་ཚུལ་འདི་དོ་སྣང་ཤིན་ཏུ་ཆེན་པོ་བྱེད་ཡུལ་ཞིག་ཆགས་འདུག་དེ་ལྟར་ཡོང་རྐྱེན་ནི་བོད་ལོ་རྩིས་ན་འདི་ལོའི་ནང་དང་།",
    "ཡིན་ནའང་བོད་པའི་སེམས་ནང་རང་བཞིན་དུ་བོད་རྒྱ་མིའི་མངའ་ཁོངས་ཡིན་བསམ་པ་ཞིག་གཏན་ནས་མེད་ལ།",
    "རྒྱ་མི་ཐོག་མར་ཡོང་དུས་བོད་པའི་སེམས་ནང་རང་བཞིན་དུ་རྒྱ་མི་སླེབས་བྱུང་ཞེས་ཕྱི་མི་གསར་པ་ཞིག་སླེབས་བྱུང་སྙམ་པ་ཞིག་ཡོད།",
    "བོད་རྒྱ་ཆེའི་མི་དམངས་ལ་བདེ་སྐྱིད་མི་འདུག་ཅེས་རྟག་ཏུ་ཤོད་ཀྱི་ཡོད།",
    "ཁོ་རང་བོད་ལ་ཐེངས་གཉིས་ཕྱིན་པ་ཡིན།",
    "ཐེངས་གཉིས་པ་འགྲོ་དུས་བདུན་ཕྲག་གཉིས་བསྡད་དེ་གནས་ཚུལ་ལ་ཉམས་ཞིབ་བྱེད་སྐབས་བོད་ལ་རྒྱ་མིས་ཡག་པོ་རྩ་བ་ནས་བྱས་མི་འདུག་ཁོང་རང་ལ་ཆ་བཞག་ན་དེ་སྔ་རྒྱ་མིར་དགའ་པོ་ཡོད།",
    "མདེའུ་སྟེང་ནས་ཕོག་སྟེ་གཤམ་ནས་ཐོན་འདུག་དེས་རྟགས་གང་ཞིག་བསྟན་ཡོད་ཅེ་ན།",
    "ཚུར་དྲིན་ལན་ལོག་འཇལ་བྱེད་ཀྱི་འདུག་སྙམ་པའི་བསམ་བློ་འཁོར་གྱི་ཡོད་བཟོ་འདུག་པ་དེར་ཁག་མི་འདུག་བོད་པ་དེ་དག་ལ་ཧ་ཅང་ཡག་པོ་བྱས་ཀྱང་།",
    "ཡར་ཐོན་པ་ཞེས་ཤོད་སའི་མི་དེ་དག་སྔོན་དང་པོར་རྒྱུགས་ནས་རྒྱ་མི་རྣམས་ཧོན་འཐོར་བའི་གནས་ཚུལ་བྱུང་འདུག་ཉེ་དུས་ཀྱི་ལྷ་སའི་གནས་ཚུལ་ལ་ཆ་བཞག་ན།",
    "དེ་ལ་རྗེས་སུ་རྒྱ་མིས་ཚིག་རྩ་བསྒྲུགས་ཏེ་ཁོང་ཁྲོ་བྱེད་ཀྱི་འདུག་ཀྱང་ཁྱད་པར་མི་འདུག་རྒྱ་མི་ཁོང་ཁྲོ་ཟ་ནས་ཁོ་རང་རྐང་པ་བརྡབས།",
    "ཁོང་ཁྲོ་ཞེས་པ་དེས་ཁོང་ཁྲོ་བྱེད་མཁན་ཁོ་རང་སེམས་པ་མ་སྐྱིད་པ་བཟོ་རྒྱུ་ལས།",
    "ང་ལ་གང་ཞིག་བརྗོད་ཀྱང་ཁྱད་པར་རྩ་བ་ནས་མི་འདུགཏ་",
    "རྒྱ་མི་བོད་ལ་ཡོང་བར་ཧ་ལས་རྒྱུ་གང་ཡང་མི་འདུག་ཡིན་ནའང་རྒྱ་མི་བོད་ལ་ཡོང་ནས་བོད་པ་སྡུག་པོ་མྱོང་དགོས་པ་ཞིག་དང་།",
    "ཡག་པོ་གང་ཡང་མི་འདུགཐ་",
    "ད་ལྟའི་དུས་ཚོད་ལ་བོད་ནང་རང་མི་རང་ལས་ཐུབ་པ།",
    "སེ་འབྲས་དགའ་གསུམ་ལ་རྒྱ་མིས་ལས་དོན་རུ་ཁག་བཙུགས་ཏེ་དམ་དྲག་བྱེད་ཀྱི་འདུག་གང་ལྟར་ལྷ་ཁང་དང་།",
    "མ་གཞི་འུར་ཤོབ་ལྟ་བུ་ཆགས་ཀྱི་འདུག་ཀྱང་།",
    "སྐབས་དེར་ང་རང་ལོ་བཅུ་དྲུག་ཙམ་ཡིན།",
    "ང་རང་དགེ་སློང་ཡིན་པ་འདི་ལ་སྤོབས་པ་ཡོད་ལ།",
    "ཡང་ཏཱ་ལའི་ལོག་སྤྱོད་པ་ཞེས་བརྗོད་དུས་ཀྱང་ང་དགེ་སློང་རང་བྱས་ནས་བསྡད་པ་ལས།",
    "ང་ལ་ཁྱད་པར་གང་ཡང་མི་འདུག་འཛམ་གླིང་ཐོག་བོད་པའི་མི་དང་།",
    "དེ་བཞིན་ཨ་རིའི་སྲིད་འཛིན་ཟུར་པ་ཀ་ཊར་ཉེ་ཆར་བོད་ལ་ཕེབས་ཏེ་ཁོང་ནས་ཀྱང་བོད་པའི་གནས་ཚུལ་དོ་སྣང་གནང་ནས་ང་ཐུག་འདོད་བྱེད་ཀྱི་འདུག་དེ་ལྟ་བུའི་གནས་ཚུལ་ཐོག་ནས་ཁ་སྔོན་ཕྱི་ཟླ་དགུ་པར་ཨ་རིར་བསྐྱོད་པ་ཡིན།",
    "གཡག་འདེད་མཁན་གྱི་རྒྱ་མི་འབྲོག་པ་དེ་ལྟར་འདུག་ཟེར།",
    "བོད་ཀྱི་ས་ཆ་ནས་བཀོག་སྟེ་རྒྱ་ནག་ལ་འཁྱེར་ཐབས་ཡོད་ན་ཁྱད་པར་མི་འདུག་ཀྱང་།",
    "སྐྱོན་བརྗོད་ལྟ་བུ་ཞིག་ཏུ་མངོན་ནས་སྐྱོན་བརྗོད་བྱེད་ཀྱི་འདུག་ཅེས་མ་བརྗོད་པར།",
    "ཞེན་ཁོག་འགྲན་ཟླ་བ་བྲལ་བ་ཞིག་འདུག་པ་དེ་ནི་གཟི་བརྗིད་ཡིན་ལ།",
    "དེ་བཞིན་འཚར་ལོངས་ཡོང་བཞིན་པའི་གཞོན་སྐྱེས་སློབ་ཕྲུག་ཚོ་ནི་དེ་བས་ཧ་ལས་དགོས་པའི་སེམས་ཤུགས་ཆེན་པོ་འདུག་ཁ་སང་བོད་ནས་བྲོས་བྱོལ་ཡོང་བའི་ཕྲུ་གུ་ལོ་བཅུ་གྲངས་བྱས་པ་ཞིག་ཐུག་བྱུང་།",
    "ཡོད་ཟེར་གྱི་འདུག་དེ་དུས་གང་ཞིག་བྱས་སམ་ཞེས་བརྗོད་པར།",
    "རླངས་འཁོར་དང་སྦག་སྦག་དེ་ལྟར་ལ་མེ་རྒྱག་པར་ཕྱིན་པ་ཡིན་ཟེར་གྱི་འདུག་པས་ཧ་ལས་བྱུང་།",
    "རྒྱ་མིའི་རྒྱུག་ཁྱི་རྒྱུག་ནག་ཡིན་པ་ལྟ་བུ་དེ་འདྲས་ནང་དོན་སོ་སོའི་མི་རིགས་ཀྱི་ཞེན་ཁོག་ཧ་ལས་པ་ཡོད་པ་དེ་ཚོའི་གྲས་ལ་ངས་ཐུགས་རྗེ་ཆེ་ཟེར་གྱི་འདུག་ཅེས་ཁྱེད་ཚོས་བརྗོད་རོགས།",
    "ང་རང་ལ་ཏཱ་ལའི་ལོག་སྤྱོད་པ་ཟེར་ནའང་འདྲ།",
    "སྤུས་དག་པོ་འདུག་གཞིས་ཆགས་ཆེ་ཁག་ཁ་ཤས་ཀྱི་ཁང་པར་མཚོན་ན།",
    "དེ་ལྟར་ཡིན་སྟབས་ང་རང་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "ངོས་ནས་བསྐྱར་ཟློས་བྱེད་དགོས་པ་མི་འདུག་ཀྱང་།",
    "བོད་པའི་བཙོན་པ་ཟེར་བ་ཐ་དད་སོ་སོ་ཡིན་པའི་བག་ཆགས་མཐུག་པོ་ཡོད་པ་ཤིན་ཏུ་གསལ་པོ་འདུག་དེ་ལྟ་བུའི་དངོས་ཡོད་ཀྱི་གནས་ཚུལ་ཐོག་ནས་བོད་རྒྱ་ཆེའི་མི་མང་རྣམས་རྒྱ་མིའི་འོག་ལ་སྡོད་འདོད་མེད་པ་ཆགས་ཡོད།",
    "ཚུར་ཙམ་དེར་འབོམ་འབར་གས་བྱུང་འདུག་ཟེར་བའི་གནས་ཚུལ་ཡོང་དུས་དོ་སྣང་བྱེད་ཀྱི་ཡོད་པ་ལྟ་བུ་དང་།",
    "དེ་ལྟ་བུའི་ཛ་དྲག་གནས་ཚུལ་མ་བྱུང་ན་དོ་སྣང་མི་བྱེད་པ་དེ་ནི་མི་སྤྱོད་ལས་འདས་པའི་བྱས་ཉེས་ལ་དོན་གྱི་རྒྱབ་སྐྱོར་བྱེད་པ་ལྟ་བུ་ཞིག་ཆགས་ཀྱི་འདུག་ཅེས་ངས་ཤོད་ཀྱི་ཡོད།",
    "ཕྲུ་གུའི་བསམ་བློར་ཕ་མས་དྲིན་ཆུང་བཏང་འདུག་བསམ་པ་དེ་ལྟར་ཡོང་བའི་ཉེན་ཁ་ཡོད།",
    "དེ་མིན་ཡོ་རོབ་ལུང་པ་འདྲ་མིན་གྱི་ནང་ལ་གང་འཚམ་ཡོད་སྟབས་དེ་ལྟར་བྱེད་ཐུབ་ན་ཁྱད་མཚར་མི་འདུག་གམ།",
    "ཕར་ཙམ་དེར་སྤྱིར་བཏང་ཁྱིམ་པའི་འཚོ་བ་སྐྱེལ་སྟངས་འཆར་ཅན་དེ་ལྟར་བྱས་ན།",
    "ཡིན་ན་ཡང་དངོས་ཡོད་གནས་ཚུལ་ལ་མ་འགྲུབ་ན་བྱེད་ཐབས་གང་ཡང་མི་འདུགཉ་",
    "ཕྱི་དྲོ་དགོང་བཅད་བྱེད་ཐུབ་ན་ཧ་ཅང་ཡག་པོ་འདུགཏ་",
    "ང་རང་སྒེར་གྱི་ངོས་ནས་འཕྲལ་ཕུགས་ཀྱི་བསམ་བློ་བཏང་ན།",
    "གོམས་གཤིས་འཇགས་ཐུབ་པ་བྱེད་དགོས་ཀྱི་འདུག་དེ་ལྟ་བུའི་གནས་ཚུལ་གྱི་ཆ་ནས་ད་ལྟའི་གནས་སྐབས་ནས་བཀའ་ཤག་དང་།",
    "དེ་ལྟར་ཡིན་སྟབས་རྒྱ་མི་བློ་གཡེང་བྱེད་དགོས་དོན་མི་འདུག་ཉ་",
    "དེ་ནི་ཧ་ལམ་རྨོངས་དད་ལྟ་བུ་ཆགས་ཀྱི་འདུག་ངས་འགན་མ་འཁུར་ན་མང་གཙོ་དངོས་གནས་མིང་དོན་མཚུངས་པ་ཡག་པོ་ཞིག་མི་ཡོང་ངམ་སྙམ་པའི་བསམ་བློ་དེ་འཁོར་གྱི་འདུག་དེ་ནི་བསམ་པ་རྣམ་པ་དག་ཡིན།",
    "དཔེར་ན་ང་རང་ཡང་ལོ་ལྔ་བཅུ་ང་གྲངས་ལ་སླེབས་ཡོད།",
    "འགྲིགས་འདུག་གམ།",
    "དེའི་འོག་ནས་གང་ཐུབ་ཀྱི་ཁེ་ཕན་སྒྲུབ་ཐབས་བྱེད་རྒྱུ་དེ་ཡིན་སྟབས་ད་ལྟ་རྒྱ་མིར་ཁག་མི་འདུག་ཀྱང་།",
    "རྒྱ་གར་ནང་ཆ་བཞག་ནའང་བོད་མི་ཚོ་བློ་ཕམ་ཆེན་པོ་ཡོད་པ་ལྟ་འདུག་དེ་ལྟ་བུའི་བློ་ཕམ་ཡོང་སྲིད་ལ།",
    "རྩ་བའི་བོད་དོན་ཐོག་ལ་སྲིད་བྱུས་འགྱུར་བ་གང་ཡང་མེད་ཟེར་གྱི་འདུག་དེ་རྗེས་ང་རང་འདི་ཕྱོགས་མ་ཐོན་བར་གནས་ཚུལ་གསར་པ་གང་ཡང་མ་བྱུང་།",
    "ཕྱི་ལ་ཡོད་པའི་བོད་པ་ཚོའི་ནང་ནས་བློ་ཕམ་བྱེད་མཁན་མང་པོ་འདུག་ལ།",
    "ཕྱོགས་མང་པོའི་ཐད་ནས་བསམ་བློ་གཏོང་དགོས་ཀྱི་འདུག་ཅ་",
    "ངས་རྒྱ་མི་ཐུག་དུས་ཚང་མར་བོད་པས་རྒྱ་མི་རིགས་ལ་ངོ་རྒོལ་བྱེད་དགོས་དོན་མེད་ཅེས་རྟག་པར་བརྗོད་ཀྱི་ཡོད།",
    "ཉིན་གཅིག་ང་རང་སྤྱན་བསལ་གླིང་ཁར་བསྐྱོད་དེ་ཁོང་དང་སྐད་ཆ་བྱུང་།",
    "མང་གཙོ་བྱེད་དགོས་ཀྱི་འདུག་ཅེས་ཤོད་ཀྱི་ཡོད།",
    "བོད་ས་འགྲིམས་ཏེ་བྲོས་ཡོང་རིང་ཁོ་རང་རྒྱ་མི་ཡིན་ཡང་བོད་པས་ལྟོ་ཆས་སྟེར་བ་དང་།",
    "བོད་མི་རིགས་འདི་ཤིན་ཏུ་བཟང་པོ་དང་ཡ་རབས་འདུག་ཅེས་ཁོ་རང་ཧ་ལས་ནས་མིག་ཆུ་གཏོང་གྲབས་ངང་བརྗོད་བྱུང་།",
    "དངོས་པོ་ཡར་རྒྱས་ཕྱིན་པའི་ལུང་པའི་ནང་རང་བཞིན་གྱི་མིའི་དཀའ་ངལ་དང་།",
    "འདི་ཟླའི་ཟླ་དཀྱིལ་ཙམ་ལ་ང་རང་ལྡི་ལིར་བསྐྱོད་རྒྱུ་ཡིན།",
    "དེར་བརྟེན་རྒྱ་གར་གྱི་མི་སྣ་བསམ་བློ་གཏོང་མཁན་སུ་འདྲ་ཞིག་ཡིན་ཀྱང་རང་བཞིན་གྱིས་བོད་ཀྱི་གནས་ཚུལ་འདི་རྒྱ་གར་ཐད་གལ་ཆེན་པོ་ཡིན་པ་དང་རྒྱ་གར་གྱི་སྲུང་སྐྱོབ་དང་།",
    "གཞུང་འདེད་ས་ཡོད་པའི་མི་ཞིག་ཡིན་པའི་བསྔགས་བརྗོད་བྱེད་ཀྱི་འདུག་ད་དུང་ཡང་ཚང་མས་མི་ཡ་རབས་ཤིག་དང་།",
    "ཁྱེད་རང་རྒན་པ་ཚོས་དོ་སྣང་བྱེད་དགོས།",
    "ད་ལྟ་ལས་བསྡོམས་ནང་ཞིབ་ཚགས་འཁོད་པ་ལྟར་ལས་དོན་མང་པོ་ཞིག་ཐད་ཡར་རྒྱས་མང་པོ་བྱུང་འདུག་མ་གཞི་དེང་སང་དུས་ཚོད་དབྱར་གཞུང་འཁེལ་ཡོད་ལ།",
    "ག་དུས་ཡིན་ཀྱང་སྒོ་ཕྱེ་ཡོད།",
    "གནས་ཚུལ་རྟོགས་པ་བྱ་རྒྱུ་གལ་ཆེན་པོ་འདུགཆ་",
    "མངགས་ས་ཡག་པོ་ཞིག་ཡོང་བ་འདུག་སྙམ་པ་དེ་རིང་ཚང་མ་འཛོམས་སར་ཞུས་ན་བསམ་པ་དྲན་བྱུང་།",
    "ད་དུང་ཡིན་ན་ཡང་རང་དོན་རང་གཅེས་བྱེད་དགོས།",
    "ངས་ཁྱེད་རང་ལ་དམིགས་བསལ་མཇལ་དར་ཞིག་འབུལ་གྱི་ཡིན།",
    "སྔོན་མ་ལས་བསྡོམས་བྱས་པ་དེ་ནས་ད་ལྟ་བར་དུ་ལས་ཀ་མང་པོ་ཞིག་བྱས་དང་བྱེད་བཞིན་པ་རྣམས་ཡག་པོ་བྱུང་འདུག་འདི་གའི་ལས་ཀ་བྱེད་མཁན་ཚོ་དང་།",
    "དེ་ལས་བལ་གོས་ཚོང་བར་ཕྱིན་ན་དེས་སྐབས་འཕྲལ་དངུལ་ལམ་སེང་བཟོ་ཐུབ་ཀྱི་འདུག་བསམ།",
    "དེའི་ཐོག་ནས་སྒེར་བེད་གང་འདྲ་ཞིག་སྤྱད་དགོས་ཀྱི་འདུག་གམ།",
    "ལྷག་པར་དུ་རྒྱ་མིའི་ལས་བྱེད་བོད་མིའི་ནང་ནས་བརྒྱ་ཆ་དགུ་བཅུ་གོ་དགུ་སོ་སོའི་མི་རིགས་ཀྱི་དོན་དག་བསམ་སྡོད་མཁན་ཡིན་པ་གསལ་པོ་འདུག་ཕྱི་ལ་བཅིངས་དཀྲོལ་དམག་མིའི་ཆས་གོས་གྱོན་པ་དང་།",
    "ཚང་མས་སེམས་ཤུགས་མ་ཆག་པར་རིག་པ་བསྒྲིམས་ནས་ནུས་པ་བཏོན་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཇ་",
    "དེས་ན་ཚང་མས་དུས་རྒྱུན་ལྡན་ནས་སྤྱི་དོན་ལ་དོ་སྣང་བྱས་ནས་ཤེས་པ་བྱེད་རྒྱུ་གལ་ཆེན་པོ་འདུག་ལྷོད་ཡངས་བྱས་ན་མི་འགྲིགས།",
    "བོད་དེ་ཤོར་རྒྱུའི་ཉེན་ཁ་འདུག་བསམ་པའི་དངངས་སྐྲག་སླེབས་པར་བརྟེན་རྒྱ་མིས་ཕྱོགས་གཅིག་ནས་བོད་ནང་རྒྱ་མི་ཕོན་ཆེ་གཏོང་བ་དང་།",
    "དེ་སྔ་ཡིན་ན་ང་རང་ལ་བསམ་འཆར་གསར་པ་ཞིག་བྱུང་ན།",
    "གནས་ཚུལ་དེ་ལ་གཞིགས་པའི་བསམ་བློ་གཏོང་རྒྱུ་གང་འདུག་གམ།",
    "སྡུག་སྐད་རྒྱག་མཁན་ཤ་སྟག་ལས་མི་འདུག་བོད་མི་མཐོ་རིམ་མི་སྣ་ནས་བཟུང་།",
    "གནས་ཚད་ལོངས་པ་བཟོ་རྒྱུ་གལ་ཆེན་པོ་འདུག་ད་",
    "ནན་ཙམ་བྱེད་དགོས་ཀྱི་འདུག་ལྷག་པར་འཁྲུག་རྩོད་ཀྱི་གནས་ཚུལ་བྱུང་ན།",
    "གཤིས་ཀར་གཞིགས་ནས་སོ་སོ་སྐྱེ་བོ་བྱས་ནས་བོད་སྤྱི་པར་ཕན་ཐོགས་ཆེ་བ་འདུག་ན།",
    "བྱེད་སྟངས་གང་དགའ་བ་འདུག་སྨིན་པོ་ཞིག་ཡོང་བ་བྱེད་དགོས།",
    "བཙན་བྱོལ་ཁྲོད་ཕེབས་རྗེས་འབྲེལ་ཡོད་མཁས་པ་ཁག་ལ་འདིའི་སྐོར་དྲི་གཏུགས་ལེགས་པར་མཛད་དེ་ཅུང་ཟད་འཐུས་སྒོ་ཚང་བར་བཀོད་པ་ཞིག་ཡིན་འདུག་པས།",
    "འདི་ཉིད་ཀྱང་ཕྱོགས་འདིར་དཔེ་རྒྱུན་ཤིན་ཏུ་དཀོན་པོར་གྱུར་འདུག་སྟབས།",
    "དེའི་བར་བོད་མི་༡༣༢༡༥སྐོར་འཕེལ་རྒྱས་བྱུང་བར་བྲིས་འདུག།",
    "ཞེས་འཁོད་འདུག།",
