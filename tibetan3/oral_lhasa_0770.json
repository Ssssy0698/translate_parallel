    "ད་ནི་དགའ་བྲལ་ཀྱི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་སྤྲུལ་པའི་ཐིག་ལེ་གསུངས་པ།",
    "ཁམས་ཀུན་ཁྱབ་པར་བྱེད་པས་ནི།",
    "དེ་བས་ན་བདག་ཉིད་བཞི་དང་འབྱེལ་པར་བྱས་ནས།",
    "རྡོ་རྗེ་བཟླས་པའི་རིམ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་རྣམས་ཀུན་ཀྱང་དག་པར་བྱས་ནས་ཡེ་ཤེས་བདུད་རྩི་ལྟ་བུར་གྱུར་པར་བྱས་པ་ནི་དེའི་ལས་སོ།",
    "ཨོཾ་གྱི་ངོ་བོར་འོང་བྱས་ནས།",
    "དེ་ཡང་བཀྲུས་ནས་དག་བྱས་ནས།",
    "དེ་རྣམས་ཀྱང་ཟླ་བ་ལྟ་བུར་ཞུ་བའི་ཆུས་བཀྲུས་ནས་དག་པར་བྱས་ཏེ།",
    "ཆུའི་དཀྱིལ་འཁོར་ཞེས་པ་ནི་ཟླུམ་པོ་མགྲིན་པར་མཚན་མ་ལ་གནས་པའོ།",
    "དེ་བཞིན་གཉིས་ལས་ཞེས་པ་ཡང་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དལ་བུས་འབྱུང་ཞེས་པ་ཡང་སྔ་མ་ལྟར་ཤེས་པར་བྱའོ།",
    "དེ་བས་ན་དེར་དེ་ལྟ་བུའི་ཡེ་ཤེས་རྙེད་པར་འགྱུར་བ་ལ་སོམ་ཉི་དང་ཡིད་གཉིས་མ་བྱེད་ཅིག་ཅེས་པའོ།",
    "ད་ནི་རྣལ་འབྱོར་ཆེན་པོ་དེའི་བཟླས་པའི་གྲངས་གསུངས་པ།",
    "དེ་ནི་དགུ་བརྒྱར་རྣམ་པར་བསྒྲེས།",
    "ཞེས་པ་ནི་བུག་པ་གཅིག་ཏུ་ཕྱག་རྒྱ་བཞི་ལ་དགུ་བརྒྱར་རྣམ་པར་བསྒྲེས་པ་སྟེ།",
    "གནས་པའི་དུས་གཉི་ག་བེེམས་པོ་མེད་ཅིང་ཀུན་འདུས་སེལ་བ་བཅུ་གཉིས་ལ་སོགས་པའི་དོན་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "མིག་འཕྲུལ་ནི་ཕེ་ན་ཨ་རྩ་ཤོ་བྱ་བའི་མིང་སྙན་སྲེཔའི་བྱས་ཁྱེར་བ་སྩལ་ཏྲེབས་གཞན་ངེས་པ་ལྟར་སྣང་ཡང་དེ་ལྟར་མ་ཡིན་པའོ།",
    "ལས་དང་པོ་པ་༥་ལ་སོགས་པས་བསླབ་པར་བྱའོ་ཞེས་སོ།",
    "མན་ངག་མེད་པར་མི་རྟོགས་པར་བསྟན་པའི་ཕྱིར།",
    "ཕྱི་རོལ་ཞེན་པ་ཡོངས་སུ་སྤངས་པའི་ཕྱིར་གསུངས་པ།",
    "དེ་ལ་གནས་པས་ཕྱི་རོལ་ཀྱི་བཟླས་པ་ཡང་མི་འགལ་བར་གསུངས་པ་དོན་དེ་ལ་གནས་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཆོ་ག་ལ་གནས་པ་ཞེས་པ་ནི་གསུངས་པའི་བརྟུལ་༡ཞུགས་ལ་སོགས་པའི་ཆོ་གའོ།",
    "ཐེ་ཚོམ་མེད་པར་ངེས་པས་ན།",
    "ལམ་ཁྱད་པར་ཅན་ཀྱི་འབྲས་བུ་ཁྱད་པར་ཅན་དུ་འགྱུར་བ་བསྐྱེད་པས་ན།",
    "ད་ནི་དེ་རྣམས་ཀྱི་དོན་མཇུག་བསྦུ་བ་གསུངས་པ།",
    "ཐིག་ལེ་འགོག་པར་མི་འགྱུར་ཏེ།",
    "དེ་ནས་ཆགས་པར་འགྱུར་བའི་དུས་སུ་གོང་མ་ལྟར།",
    "དེ་ལ་ཕྱི་རོལ་པ་རྣམས་ཀྱིས་འཁྲུལ་པར་གསུངས་པ་དེ་ལས་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེ་བས་ན་དེ་ལས་སྟོང་པ་ཉིད་དུ་ཁས་བླངས་པའི་སྐྱེ་བོ་རྣམས་ཀྱིས་དུས་ལས་བྱུང་བ་ལ་སོགས་པས་སྒོ་འདོགས་ཤིང་དེའི་ལམ་ལ་འཇུག་པར་བྱེད་དོ།",
    "འཇིག་༦པ་རྣམས་སྤངས་པའི་ཞེས་པ་ནི་མི་རྟག་པ་ལ་སོགས་པའི་བསྐལ་པ་རྣམ་པར་སྤངས་པའོ།",
    "ཕྱི་རོལ་གྱི་སྟོང་ཞེས་ཏེ་ཕྱ་དངོས་པོར་འཛིན་པ་བཟློག་པའི་ཕྱིར་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་ཀྱང་གོང་མ་ལྟར་བྱས་ནས།",
    "དཀྱིལ་འཁོར་འཁོར་ལོའི་ཏིང་ངེ་འཛིན་ལ་སོགས་པ་སྔ་མ་བཞིན་ཤེས་པར་བྱས་ནས་ཞེས་སོ།",
    "ཞེས་པ་ནི་དབུགས་འཇུག་པའི་སྤྱོད་པའི་སེམས་ཀྱིས་ཧུགསང་བའི་ངོ་བོའི་སེམས་ཡང་དག་པར་བཟུང་བ་སྟེ།",
    "ཡང་དག་པར་སྐྱེད་བྱུཔར་བྱེད་པའི་མི་ཤིགས་པའི་ཐིག་ལེ་ཁ་དོག་སྣ་ཚོགས་པའི་འོད་ཟེར་ལྔ་འབར་བ་རྣམ་པར་གསལ་བར་བྱའོ་ཞེས་སོ།",
    "གནས་རྟེན་མཚན་མ་དང་བཅས་པ་གསལ་བར་བྱས་ནས།",
    "ཡང་སྤྲོས་པ་གསུངས་པ།",
    "རྟེན་རྣམས་གསལ་བར་བྱས་པ་ནི་ཡེ་ཤེས་ཐིག་ལེའོ།",
    "ནང་གསལ་ཞེས་པ་ནི་གཞག་བླཔའི་འོད་ཟེར་གྱིས་ཞེས་པ་ནི་གནས་བཅུ་དྲུག་ཏུ་གཞག་པའི་འོད་ཟེར་ཕྱིར་བྱུང་ནས་ཕྱིའི་ལུས་དང་དཀྱིལ་འཁོར་དང་རྟེན་དང་བཅས་པ་གསལ་བར་བྱས་ནས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ན་བཞུགས་པའི་སྤྱན་སྔར་གཤེགས་ཏེ་བདུད་རྩི་ཞུ་བར་བྱས་ནས།",
    "དེ་ཡང་དེ་བཞིན་དུ་གྱུར་ནས་བདག་ལ་ཐིམ་པར་བྱས་ཏེ་བདག་ཉིད་ཀྱང་མི་སྣང་བར་གྱུར་ཏེ།",
    "འཁོར་ལོ་ཡང་ཡེ་ཤེས་སེམས་དཔར་ཞུགས་པར་བྱའོ།",
    "ཡེ་ཤེས་སེམས་དཔའ་ཡང་མི་སྣང་བར་གྱུར་ནས་དེའི་ཐུགས་ཀྱི་མཚན་མ་འབའ་ཞིག་ལ་དམིགས་པར་བྱའོ།",
    "མཚན་མ་དེ་ཡང་བསྡུ་བར་བྱས་ནས་མི་ཤིགས་པའི་ཐིག་ལེར་སེམས་གཟུང་བར་བྱའོ།",
    "ཞེས་པ་ནི་ཡང་དག་པར་རྫོགས་པའི་དེ་མ་ཐག་ཏུ་གཏོང་བ་སྟེ།",
    "རིམ་པར་བཅུག་ནས་ཐིམ་བྱས་ཏེ།",
    "ཇི་སྲིད་སྣང་བའི་ཐིག་ལེ་ལ་ཐིམ་པ་དེ་སྲིད་ཀྱི་བར་དུ་བསྡུས་ནས་དེ་ལ་སེམས་དགོད་པར་བྱའོ།",
    "བརྟན་པའི་སྟོབས་ལས་ཤིན་ཏུ་ཡོངས་སུ་དག་པའི་སྐུ་ཡང་ནམ་ཞིག་ན་འཇུག་པར་འགྱུར་བའོ།",
    "ལྔ་པོའི་མཚན་མ་བཟློག་པའི་ཐབས་གསུངས་པ།",
    "དེ་ཡང་ཐིག་ལེ་ལ་གོམས་པར་བྱེད་པའི་དུས་སུ་སེམས་ཡང་དང་ཡང་དུ་བཟུང་བས་གླལ་བ་དང་དགོད་པ་དང་འདར་བ་དང་།",
    "ཐིག་ལེ་ཡང་དག་སྤྲོ་བྱས་ནས།",
    "ཞེས་པ་ནི་སྣང་བའི་ཐིག་ལེའི་དམིགས་པ་བཏང་ནས་ཡི་གེ་དང་མཚན་མ་དང་ཡེ་ཤེས་སེམས་དཔའ་ལ་སོགས་པ་ལ་དམིགས་པར་བྱ་བ་ནི་གོང་མའི་རིམ་པ་ལྟར་ཀུན་དུ་དུ་ཁྱབ་པར་བྱས་པས་དེ་ལྡོག་པར་འགྱུར་རོ་ཞེས་སོ།",
    "དེའི་འབྲས་བུ་གསུངས་པ་འདི་ནི་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེའི་ཕུན་སུམ་ཚོགས་པ་ནི་དེའི་ཐོབ་པར་བྱ་བ་སྟེ་སྟོབས་བཅུ་ལ་སོགས་པའོ།",
    "བརྟགས་པ་ཐམས་ཅད་ཀྱང་ཐིམ་པས་ན་ཡོངས་སུ་དག་པས་སྐུ་གཙང་ངོ།",
    "རྣམ་པར་རིག་པ་ཕན་ཚུན་ངེས།",
    "ད་ནི་དེ་ལྟ་བུའི་དོན་དེ་གོང་ནས་གསུངས་པའི་རིམ་པས་བསྒོམས་ནས་བསྒྲུབ་པའི་བདག་ཉིད་ཅན་དུ་འགྱུར་བར་གསུངས་པ།",
    "ད་ནི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ལ་དེ་ལྟར་གོམས་པར་བྱས་པས་དེ་མངོན་དུ་བྱ་བའི་ཐབས་གསུངས་པ།",
    "སྒྲུབ་པ་མཆོག་ཅེས་པ་ནི་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་སྒྲུབ་པའི་ཐབས་ཏེ་གཞན་ལས་དམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ཡང་འོག་ནས་ཇི་སྐད་དུ་གསུངས་པ་བརྩམ་པར་བྱའོ་ཞེས་སོ།",
    "མངོན་དུ་བྱེད་པའི་ཕྱག་རྒྱ་གསུངས་པ།",
    "དེ་ནས་ཇི་སྐད་དུ་གསུངས་པ་བཞིན་དུ་བསྒྲུབ་པ་བརྩམ་པར་བྱའོ།",
    "མཁའ་འགོ་མ་ནི་བདག་ཉིད་གོམས་པ་ཁྱད་པར་ཅན་ལའོ།",
    "དེ་ཡང་ཕྱིའི་བརྟུལ་ཞུགས་ཀྱི་སྐབས་སུ་རང་བཞིན་ནམ་སྤྲུལ་པར་སྣང་བ་དེའི་སྤྱི་གཟུགས་ཀྱི་ལུས་རྒྱུད་ཅིག་ཅར་བྱིན་གྱིས་རློབ་པར་བྱེད་པའམ་ཡན་ལག་བདུན་པ་ལ་སོགས་པའི་དབྱེ་བས་བྱེན་གྱིས་ཟློབ་པར་བྱེད་པའོ།",
    "དྷིབར་བྱ་ཞེས་ཏེ་རོལ་པར་བྱའོ།",
    "དེའི་ཐབས་གསུངས་པ།",
