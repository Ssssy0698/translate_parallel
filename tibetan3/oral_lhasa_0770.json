    "སྣ་ཚོགས་པདྨའི་སྟེང་ན་ཟླ་བ་ལ་གནས་པ་རྡོ་རྗེ་སེམས་དཔའི་སྐུར་གྱུར་ཏེ་ཞེས་ཏེ་དང་པོའི་རྡུབྱ་བ་མངོན་དུ་བྱས་ནས་དེ་ལས་དེར་འགྱུར་ཏེ།",
    "འབྲས་བུའི་ཡན་ལག་གསུམ་གསུངས་པ།",
    "ཞེས་པ་ནི་ཁྱད་པར་བྱེད་པ་གནས་ལས་གཡོས་པའི་ཚེ་ན།",
    "སེམས་ཀྱི་རང་བཞིན་མ་ཤེས་པའི་ལས་སུ་སྨྲ་བས་དེ་ལ་ཤི་བའི་སྲིད་པ་ཞེས་འདོགས་པར་བྱེད་དོ།",
    "དེ་ཕྱིན་ཆད་ཉི་མ་བདུན་ལ་སོགས་པའི་དུས་སུ་ལས་སུ་སྨྲ་བས་བར་མ་དོར་འདོགས་པར་བྱེད་པ་ལས་ཀྱི་རྫུ་འཕྲུལ་གྱི་ཤུགས་དང་ལྡན་པ་བྱིས་པ་ལོ་ལྔ་ལོན་པ་ཙམ་དུ་གནས་ཤིང་རྡོ་རྗེས་ཀྱང་མི་ལྡོག་པ་དྲིའི་ཟས་ལ་ལོངས་སྤྱོད་པ་དེ་འགྲུབ་པའི་ཚེ་ན་གོས་ཀྱི་ཕྱེརྐྱེན་གྱིས་དཔེ་མེད་བདེ་རྫོགས་རྟོགས་ཞེས་ཏེ་ལོངས་སྤྱོད་རྫོགས་པའི་སྒུ་མངོན་དུ་བྱེད་དོ།",
    "ཡང་དག་ཏུ་ནི་རྟོགས་པར་འགྱུར།",
    "དེ་མི་འགལ་བའི་དཔེ་གསུངས་པ།",
    "གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཡིད་ལ་བྱེད་པའི་དུས་ཀྱང་གསུངས་པ།",
    "དེའི་སྦྱོར་བ་གཞན་གསུངས་པ་དེ་བས་ཞེས་པ་ལ་སོགས་པའོ།",
    "ད་ནི་དམ་པས་གསོལ་བ་བཏབ་པ་གསུངས་པ།",
    "དོན་འདི་ལ་སྦྱོར་བ་འདི་ནི་ཡང་དག་པའི་རྣལ་འབྱོར་པ་རུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།་།",
    "དེ་སྟོན་པར་བྱེད་པ་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་རྣམས་སྟོན་པར་བྱེད་པའི་གོང་ན་མེད་པའི་ལུང་ཆེན་པོ་ནི་འདུས་པའོ།",
    "དེ་བས་ན་བརྩམ་པར་གྱིས་ཞེས་ལུང་གནང་བ་སྟེ་གསོལ་བ་བཏབ་པ་ཞེས་ཉེ་བར་སྤྱོད་པའོ།",
    "ད་ནི་དོན་གོང་མ་ཇི་ལྟ་བ་བཞིན་དུ་སྦྱངས་ཤིང་རྟོགས་པས་ས་འོག་མ་ཐམས་ཅད་འགྲུབ་པས་དེ་ལ་འབད་པར་གསུངས་པ་དེ་བས་ཞེས་པ་ལ་སོགས་པའོ།",
    "མ་འོངས་རྣལ་འབྱོར་ཆེ་ཞེས་པ་ནི་གོང་དུ་གསུངས་པའི་འཇུག་པའི་སྐྱེས་བུའོ།",
    "རབ་མཉེས་ཏེ་ཞེས་པ་ནི་གོང་དུ་གསུངས་པའི་རྗེས་སུ་མཐུན་པའོ།",
    "ཡང་དག་འདོད་པས་བླངས་བྱས་ནས།",
    "གླུ་དབྱངས་ཀྱིས་བདག་ལ་བསྟོད་པ་ནི་ཚིགས་སུ་བཅད་པའི་མཛོད་ལས་ཤེས་པར་བྱའོ།",
    "སྤྲིན་རྣམས་མེད་པ་ལྟ་བུར་ཤེས་པར་འགྱུར།",
    "དེ་བས་ན་དེའི་རྒྱུའི་སྤྲུལ་པ་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ཕྱག་རྒྱའི་རིམ་པས་གོང་ནས་གསུངས་པ་ལྟར་རྟོགས་ནས་དཔེ་མཁྱུད་སྣོད་རུང་འགའ་ལ་ཡང་སྤང་བའི་ཕྱིར་རོ།",
    "ཞེས་པ་ནི་དེའི་ཉེ་འཁོར་རྣམས་ནི་སྐྱེཁྱད་པར་དུ་སྣོད་དུ་རུང་བ་མང་བས།",
    "ཅུང་ཟད་བསྡུས་པ་ཞེས་པ་༧ནི་གོང་དུ་གསུངས་པ་རྣམས་སོ།",
    "སྔོན་གནས་ཞེས་པ་ནི་པརྦ་ཏའོ།་།",
    "སྐལ་ལྡན་དོན་འགའ་བྱས་ཞེས་པ་ནི་སྔོན་ལས་མ་གཏོགས་་རྐཔ་རྣམས་ཀྱིའོ།་།",
    "ད་ནི་དེ་ལྟ་བུས་དད་པར་བྱས་ཏེ།",
    "གཏམ་རྒྱུད་རྒྱས་པར་ཤེས་བྱས་ནས།",
    "དེ་གོང་དུ་གསུངས་པའི་ཐབས་ཀུན་གྱིས་མཉེས་པར་བྱས་ཏེ་ཞེས་སོ།",
    "རབ་ཏུ་བྱེད་པ་ནི་ཤིན་ཏུ་ལེགས་པར་བྱེད་པའི་ཕྱིར་ན་སྟེ།",
    "བསམ་པར་བྱ་ཞེས་པ་ནི་འཐད་སྒྲུབ་ཀྱིས་ཡང་དང་ཡང་དུ་བློ་ངེས་པར་བྱའོ་༢།",
    "དེ་ལ་རབ་བརྟེན་ཞེས་པ་ནི་བསམ་པ་དེ་ལ་རབ་ཏུ་བརྟེན་ཏེ་དེ་ཉིད་ཁྱད་པར་ཅན་དུ་བྱ་བའི་ཕྱིར་དགོན་སོགས་རབ་ཏུ་བརྟེན་་བྱས་ཞེས་ཏེ་གོང་མ་ལྟར་རོ།",
    "ཇི་བཞིན་རབ་ཏུ་རྟོགས་པ་༥བྱས་པ་ཡིས།",
    "དེ་ཉིད་ཡང་དག་པར་རྟོགས་པས་བརྟུལ་ཞུགས་ལ་སོགས་པས་ལྷག་མ་ཟད་པས་ཚེ་འདི་ཉིད་ལ་ཞེས་ཏེ།",
    "འཐུང་བ་ནི་རོ་མྱང་བ་དང་ངོམས་པར་བྱེད་པའོ།",
    "ས་བོན་ཉམས་བྱས་ཏེ་ཞེས་པ་ནི་དེ་ལས་བྱུང་བ་དང་བཅས་པ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོར་ཤེས་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་ཕྱག་རྒྱ་ཆེན་པོ་ལ་ལས་དང་པོ་ལ་སོགས་པ་ཡང་འཇུག་པར་བསྟན་པ་སྟེ།",
    "རྩེ་གཅིག་པའི་སྦྱོར་བའི་སེམས་ཀྱིས་བརྩོན་འགྲུས་བསྐྱེད་ལ་སྔོན་གྱི་རིམ་པ་ཁོ་ན་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "སྦྱོར་བའི་བྱ་བ་མ་བྱས་ན་དེས་སྐད་ཅིག་ཙམ་དུ་ཡང་མི་སྡོད་དེ་མེད་པར་བྱེད་དོ།",
    "དེ་བས་ན་སྐྱེ་བ་འདི་ཆུད་གསན་པར་མི་བྱ་སྟེ།་",
    "དེར་དེ་རབ་ཏུ་འགྱུར་བ་ན་སེམས་གཞན་རྣམ་པར་བཀག་ནས།",
    "སེམས་ནི་ཡང་དག་བརྟན་པར་གྱིས་ཤིག་ཅེས།",
    "དེས་མཚན་ཉིད་ལྔ་དང་ལྡན་པར་བྱ་བ་དང་།",
    "ཐབས་ཀྱིས་སྟེར་བ་མྱོང་བ་ལ་སོགས་པ་རྒོ་གསལ་བར་མ་བྱས་པའོ།",
    "རྣལ་འབྱོར་ཆེན་པོའི་རྒྱུད་ཅེས་པ་ནི་རྣལ་འབྱོར་ཆེན་པོ་སྟོན་པར་བྱེད་པའི་གཞུང་སྟེ་ཐབས་གཙོ་བོར་བྱེད་པའི་རྒྱུད་དང་།",
    "དེ་རྣམས་ཀྱི་དོན་རྣམས་ནི་མི་སླུ་༡བའི་དེ་ཁོ་ན་ཉིད་རྒྱུ་དང་གོམས་པར་བཅས་པའོ།",
    "རོ་སྨད་མེད་པའི་ཁ་ཁྲིད་ཀྱིས་་ནམ་མཁའ་ལ་ཁྲིད་ནས་འཛམ་བུ་གླིང་ལ་སོགས་པར་འགྲོ་བ་ནི་སྨྱོན་ཚིག་ལྟ་བུར་སྣང་ཡང་།",
    "རྒྱུ་གཉིས་དང་མི་ལྡན་པ་རྣམས་དོན་ཁྱད་པར་ཅན་དང་བྲལ་བར་གསུངས་པ།",
    "མན་ངག་ཅེས་པ་ནི་ཨུ་པ་དེ་ཤ་ན་སྟེ་རི་ཐབས་ཀྱིས་སྟེར་ཞེས་པ་ནི་ཤེས་པར་བྱེད་པའི་མན་ངག་ཅེས་པར་སྦྱར་རོ།",
    "དེ་ལྟར་དམ་པ་རྣམས་ཀྱི་ལམ་ཡིན་པར་བསྟན་ནས།",
    "ད་ནི་༤ཁོ་ན་ལ་བློ་བརྟན་པོར་བྱ་བ་གསུངས་པ།",
    "དེ་ལྟར་ཞེས་པ་ནི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་རྟོགས་ཤིང་གོམས་པ་ལས་བྱུང་བའི་ལམ་འདི་སྲིད་པའི་སྡུག་བསྔལ་གྱི་གཉེན་པོ་ཡིན་ཞིང་ལམ་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་པ་སྟེ་སྲས་དང་ལྡན་པའི་བདེ་བར་གཤེགས་པ་རྣམས་ཀྱི་ལམ་ཡིན་པར་རབ་ཏུ་ཤེས་པར་བྱས་ནས་སུ་ཞེས་སོ།",
