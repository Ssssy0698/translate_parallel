    "ངོ་མཚར་རྒྱས་པ་ཕུལ་བྱུང་རང་བཞིན་མཚན་ཉིད་རྣམས་ཀྱིས་ལྔོ་གསལ་བར་བྱེད།",
    "རྗེ་བོ་ལོངས་སྤྱོད་ཀྱིས་ལོང་རང་བཞིན་བྱིས་སྨོད་དཔལ་གྱི་རྣམ་འཕྲུལ་ལྡན་ཞིང་འཕྱར།",
    "རིན་ཅེན་འུརབ་འབར་ཤེལ་དང་གསེར་གྱི་བ་གམ་ཧརྨེ་པརློ་ཀ་རྤཱ་ཐ་ར་ཙ་ནཱ་ཤ་ཡ་ནཱ་རྙི་རཱ་མ།",
    "སླར་ཡང་རང་བཞིན་འདི་འདྲར་གྱུར།",
    "དཱིརྒྷ་དྷྱཱ་ན་ནི་ལཱི་ན་ལོ་ཙ་ན་ཡུ་ཤཾ་ནི་མཛེས་པ་དག་ནི་དེ་ཡིས་བསྟན།",
    "ཀླུ་ཡི་ནཱ་མ་ཙ་ནཱ་གེནྡྲ་མཱུརྙིབི་སྨི་ཡ་ཀཱ་རི་རྡེ།",
    "ཛི་ན་སྲེ་ཏི་བྱུ་བ་ཎ་སུ་པུ་བྱེ་པྲ་བ་ཙ་ནཱ་མྲྀ་ཏེ།",
    "གང་ཞིག་དུས་མིན་ཉེར་བགྲོད་འ་དང་།",
    "ཨ་ཙིནྟ་གྱིས་ཚིམ་མི་འགྱུར།",
    "ཨ་ཙིནྟ་ཡ་ད་པུ་སྒྱུ་ཨཱོཾ་ནུ་ཏ་ནོབྱེ་བ་རབ་བཟང་མྱ་ངན་རྒྱ་ཡིས་ཐེབས།",
    "ཨ་ཙིནྟ་ཡཏྤ་རི་ཏྲ་ཎ་ས་ཀལྤ་སཱབེེ་ཚོམ་དེར།",
    "རང་རང་དག་ལ་དེས་དི་ཤཾ།",
    "དེ་སྐད་ཏེ་ཏཱུཏྟ་མ་པཱ་ཧ་བྷ་ག་བཱན་ཛྙཱ་ན་ལོ་ཙ་ན།",
    "གང་དུ་མྱ་ངན་ས་ན་ཤ་མ་རྣ་ཏཏྠ་སཱ་དེ་ན་ཤཱསྟུརྻསྨིཛེེ་྾་ད་དྷ་ཏི་ན་པུ་ན་ཤོ་ཙ་ནཱ་ལོ་ཙ་མིག་ལ་སླར་ཡང་མཆི་མ་དག་ནི་མི་འཛིན་པ།",
    "བཞིན་བགྲོད་མིན་འགྲོ་བ་དང་།",
    "ཡ་དི་མེ་སྤྲུ་ཏི་ལུདྡྷཱ་ཡཱ་བ་ཙ་ནཱ་ནུ་དམན་རྔོ་པའི་འབྲས་བུ་ཟ་བའི་དུལ་བ་དེ་ལ་འདུད།",
    "ཇྀ་ག་པྲ་སཾ་ག་པཉྩ་མེ་ཏོག་དུས་སུ་རབ་ཞུགས་ཤིང་།",
    "ཁྱད་པར་བྱིས་ནི་བཀྲ་བར་བཀོད་ཅིང་ཙ་ནཱ་ར་མྱུ་བ་དཱ་ནཱ་བ་ལཱི།",
    "བསམ་པ་ལ་བརྟེན་མིག་ནི་ལ་ལོ་ཙ་ན་གྱ་བི་བྷཱ་བྱཱ་ཏེ་ཀོ་པྱ་དྷྲི་ཏི་པྲ་ཀཱ་ར།",
    "དེ་ཡི་མིག་གྱ་ཙ་ཏབྱི་ལོ་ཙ་ན་རུ་ཙི་པྲ་ཏྱསྟ་ཥྤེ་ཏྲ་ཤྲི་ཡ།",
    "བསྟེ་ཙནྡྲ་ཤ་ཏཱ་ནི་ལོ་ཙ་ན་ཡུ་གེ་མྦི་ལོཏྤ་ལཱརྨཱ་བ་ཛྭ་བཱ་པར་འོངས་སམ་བྱས།",
    "བྷཱུ་ཡཱཛྫ་གཁྲོ་ཙ་ན་ཛཱི་བ་བྱུ་ཏཱ་ཀལྤ་ཀྵ་ཡེ་གྱ་ཀྵ་ཡ་སཱ་ཀྵི་བྷཱ་ཡོ།",
    "ཡལ་འདབ་སུམ་ཅུ་རྩ་དྲུག་པའི་རྒྱ་སྐད་ཙ་ཏུ་ར་སོགས་རྐང་པ་གཅིག་བོད་སྐད་དུ་མ་བསྒྱུར་འདུག་པ།",
    "ཞེས་སོགས་ཤློ་ཀ་གཉིས་ལ་སྐད་ཤན་སྦྱར་ཡོད་པའི་གླེགས་བམ་རྣམས་སྒོ་མཐུན་པར་རྒྱ་སྐད་མི་འདུག་པས།",
    "ཅེས་པ་འདི་རྫོགས་མཚམས་སུ་རྒྱ་དཔེར་པནྡྲསྦི་སོགས་ཚིག་རྐང་གཉིས་ཀྱི་སྐད་དོད་འདུག་པ་སྐད་ཤན་སྦྱར་ཡོད་པའི་གླེགས་བམ་ཚོར་བོད་སྐད་དུ་མ་བསྒྱུར་བར་ས་སྟོང་བཞག་འདུག་ཅིང་།",
    "ཐམས་ཅད་མཁྱེན་པ་བཙོང་ཁ་བ་ཆེན་པོའི་ཕྱག་དཔེ་སྐད་ཤན་སྦྱར་མེད་པ་དེར་ཡང་ཚིག་རྐང་གཉིས་པོ་དེ་མི་འདུག་པས།",
    "རྣམ་དཔྱོད་ཀྱི་རྩལ་དང་ལྡན་པ་རྣམས་ལ་སྐད་ཤན་སྦྱར་ཡོད་པ་འདི་བློ་བསྐྱེད་ཤིན་ཏུ་ཆེ་བ་འོང་འདུག་པས།",
    "འཛིག་རྟེན་ཐམས་ཅད་ཀྱི་སྟེང་ན་འདུག་པའི་གནས་འཇིག་རྟེན་འས་པ་ཞེས་བྱ་བ་གདུགས་དཀའ་པོ་གྱེན་དུ་བསླངས་པ་ལྟ་བུ་ཞོའམ་ཀུ་མ་ད་ལྟར་དཀར་བ།",
    "བདེན་པ་གཉིས་ཀྱི་མཚན་ཉིད་ནི་སེམས་ཙམ་པ་དང་རང་རྒྱུད་པའི་སྐབས་གང་ལྟར་འཇོག་ཀྱང་ཆོག་ལ།",
    "ཞེས་གསུངས་ཤིང་རང་རྒྱལ་དང་ས་ས་རྒྱས་ཀྱི་ས་ལ་ཡང་དེ་ལྟར་གསུངས་པ་དང་།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་དོན་རྟོགས་པས་བཟློག་དགོས་པར་གསུངས་པ་དང་།",
    "འོ་ན་ཁོ་རང་ལ།",
    "གཞན་གསུམ་ནི་འཕྲོས་པ་ཡན་ལག་ལྟ་བུ་དང་རང་འགྲེལ་ཡོད་དོ། ་ྩདེབ་ཤ་མ་ན་ལྷའི་དགེ་སྦྱོང་།",
    "དེ་ནི་ཚིག་འཁྲི་ལ་བློ་རྩེ་གཏད་པ་ཙམ་མ་གཏོགས་སྐབས་འདིར་རང་རྒྱུ་དང་རང་འབྲས་ཞེས་པའི་ཁྱད་པར་མ་སྦྱར་བར།",
    "གཡོ་དང་རང་བཞིན་སྟོང་པར་མཐོང་བ་ཡི།",
    "བྱང་སེམས་ས་དང་པོ་པ་འདིས་པོ་སྐྱེ་དང་ཉན་འང་ཐམས་ཅད་ལས་ཤིང་རང་ལམ་དུ་རིགས་ངེས་པ་ཐོབ་པས་དེ་གཤེགས་པ་རྣམས་ཀྱི་རིགས་སུ་སྐྱེས་པ་དང་།",
    "དེ་རྗེས་གདགས་གཞི་ཕུང་ཁམས་སོགས་ཀྱང་རང་བཞིན་མེད་པར་སྨར་ཀྱི་རིག་འགྲོས་ཙམ་གྱིས་གཏན་ལ་འབེབས་པར་བྱདེ་ཐུབ་པའི་ཕྱིར།",
    "བསྒྲུབ་བྱ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཐུབ་པ།",
    "ཞེས་པའི་སྦྱོར་བ་གཉིས་འཀོད་འདུག་ཀྱང་གཏན་ཚིགས་མ་གྲུབ་པར་འགྱུར་བས།",
    "ཕྱི་རྒོལ་བྱས་ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་མི་ཕྱེད་པ་ལྟར།",
    "ཡོད་པར་འཛིན་པ་དང་རང་བཞིན་གྱིས་ཡོད་པར་འཛིན་པ་གཉིས་ཀྱང་།",
    "སྐབས་འདིར་རྣམ་མཁྱེན་གྱིས་ཁོ་རང་ཇི་ལྟར་རམཁྱེན་ཚལ་ལ།",
    "དས་ཁོ་རང་གཉིས་སྣང་དང་བཅས་པའི་ཚལ་གྱིས་རྟོགས་པའང་ཡིན་ཏེ།",
    "འདིའི་རྒྱན་དང་སྐར་ཅིག་གང་ལ་ཡང་རང་ཐབ་པའི་དུས་ལས་དུས་གཉིས་པར་གནས་པ་ནི་ཐ་སྙད་དུ་ཡང་མེད་པས།",
    "དེ་གཉིས་ཁོ་རང་ལ་རྒྱ་ཡོད་མེད་ཀྱི་ཁྱད་པར་ཡོད་པའི་ཕྱིར།",
    "ཤེལ་གོང་རང་༡དེ་ཀ་ཛེ་བོ་དྭངས་པའི་དྭངས་ཆ་གཅིག་དང་གཉིས་གཅིག་ཆར་སྐྱེ་བ་དང་།",
    "གཞན་ཡང་རང་རིག་ལ་ཡུལ་ཡུལ་ཅན་གྱི་སྣར་བ་དང་།",
    "རྣམ་འགྲེལ་ལྟར་སྤྱི་མཚན་དང་རང་མཚན་པཔྱད་ནས་འཛེག་པ་མི་འཐད་པའི་ཕྱིར།",
    "གལ་ཏེ་ཚང་མ་དང་གཞལ་བྱ་དག་དུས་གསུམ་དུ་རང་བཞིལ་མ་གྲུབ་པར་ཁས་བླངས་པ།",
    "ཐེ་ཚོམ་ཡང་རང་བཞིན་གྱིངས་ཡོད་དོ།",
    "དེ་ཡན་ལག་ཅན་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཡིན་པའི་ཕྱིར།",
    "ཟ་ཊྛབ་ཁྱཚར་གཅད་ཀྱི་གནས་ཀྱང་རང་བཞིན་གྱིས་མེད་དེ།",
    "འདུག་དེ་ལ་འདིར་འདུ་ཤེས་སྣ་ཚོགས་པའི་ཡོ་ལང་ལ་སྤྱོད་པའི་སྐྱེ་འགྲོ་སྤྱི་དང་།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "གལ་ཏེ་འཆད་པར་འགྱུར་བའི་གདན་ནམ་འདུག་སྟངས་བཅིངས་ནས་ཐུན་ཚོད་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱེད་པར་མི་ནུས་ན།",
    "ད་ནི་ཞི་བ་ཞེས་པ་ལ་སོགས་པས་ཞི་བ་ལ་སོགས་པའི་ལས་བསྒྲུབ་པའི་དོན་དུ་འདུག་སྟངས་རྣམས་གསུངས་ཏེ།",
    "འདིར་ཞི་བ་ལ་སོགས་པ་རྣམས་ལ་ལས་ཀྱི་དབྱེ་བས་རིམ་པས་འདུག་སྟངས་སམ་གདན་ཡོངས་སུ་བཀོད་པ་རྣམས་སུ་འགྱུར་རོ།",
    "རྒྱས་པ་ལ་རྡོ་རྗེའི་འདུག་སྟངས་ནི་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དུ་དང་གཡོན་པ་ཡང་བརླ་གཡས་པའི་སྟེང་དུ་བཞག་པ་སྟེ་ཐད་ཀར་གན་རྐྱལ་གྱིས་སོ་ཞེས་པ་ནི་རྡོ་རྗེའི་གདན་ནོ།",
    "ལྷ་མིན་ཞེས་པ་ནི་ལྷ་མིན་གྱི་འདུག་སྟངས་ཏེ།",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ།",
    "གོ་རོ་ཙ་ན་བྷཾ་ཝཾ་ངམ།",
    "བི་བྷུ་ཏི་ཙནྡའི་མཆན་ལ་ལྔ་བརྩེགས་སུ་འདུག་ཟེར།",
    "རིང་པོ་ལ་ཡི་གེ་བརྩེགས་པ་འདུག་ནའང་འོག་མ་རྣམས་ལ་མི་འདུག་པས་མི་དགོས་པ་འདྲའོ་རཾ་ཡིག་ལས་གྲུབ་པ་ཤེས་རབ་མཐར་བྱེད་དམར་པོ་ནི་མིག་གཡོན་པའི་སྒོ་ནས་ཕྱུང་སྟེ་ལྷོའི་རྩིབས་སུ་ཟླ་བའམ་ཉི་མའི་གདན་ལ་གཞག་པར་བྱའོ།",
    "འདུག་སྟངས་དང་སྟངས་སྟབས་འདམ་ཁ་ཅན་ལྟ་བུར་གསུངས་པ་ནི་དྲང་བའི་དོན་ཏེ།",
    "དཀྱིལ་འཁོར་གྱི་ཤར་གྱི་སར་འདུག་ལ་སྔར་བརྗོད་པའི་བསྲུང་བའི་འཁོར་ལོ་བསྒོམས་ནས།",
    "འདུག་སྟངས་རྐང་པ་གཡོན་པ་སྐྱིལ་ཀྲུང་ཕྱེད་པ་སྟེ་རྐང་པ་གཡས་པའི་མཐིལ་ས་ལ་བཞག་པ་དང་།",
    "དེ་བཞིན་དུ་ཐུགས་ཀྱི་ར་བ་རྣམས་ཀྱི་དཔངས་ནི་རང་རང་རྡུལ་ཚོན་སེར་པོའི་དཔངས་སུམ་འགྱུར་ཏེ།",
    "འདིས་མཚོན་ནས་ལས་སོ་སོ་ལ་རང་རང་དང་མཐུན་པའི་གང་བུམ་བཞི་བཞི་ཟུར་བཞིར་བཞག་པར་བསྟན་ཏོ།",
    "དེ་ནས་སློབ་དཔོན་གཙོ་བོའི་ཤར་གྱི་ཞལ་གྱི་ཕྱོགས་ཉིད་དུ་བལྟས་ལ་འདུག་སྟེ།",
    "ཨོ་བེ་རོ་ཙ་ནཱ་ཡ་ན་མ་རྣམ་པར་སྣང་མཛད་ལ།",
    "ཨོ་ལོ་ཙ་ནཱ་ཡེ་ན་མ་སྤྱན་མ་ལ།",
    "མདུན་མངོན་དུ་ཕྱོགས་པས་སྟོན་པར་གྱུར་ན་འདུག་ཅིག་འདུག་ཅིག་ཅེས་བརྗོད་པའོ།",
    "གསོན་ལུས་ཐམས་ཅད་ནི་ཕྱོགས་ཤེས་འདོད་དུ་གྱུར་པས་མཐུན་དཔེ་མི་སྲིད་ལ།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དེ་ཡང་སྒྲིབ་བྱེད་རྟོག་པ་ལ་ཤིང་རང་མཚན་དུ་ཞེན་པ་དེས་བསྒྲིབ་བྱ་ཤིང་གསལ་རྣམས་ཀྱི་བདག་། ཉིད་དམ་ངོ་བོ་ཐ་དད་ཀྱང་།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "ཤིང་རང་མཚན་མྱོང་བའི་བག་ཆགས་ལས་སྐྱེས་ཤིང་།",
    "དེ་ལྟར་ཡིན་ཀྱང་རང་མཚན་ཁོ་། ན་ལ་བརྡ་བཏགས་པ་ཡིན་ན།",
    "སྤྱི་རྐྱང་པ་དང་རང་མཚན་རྐྱང་པ་བརྡ་ཡུལ་དུ་མི་འཐད་པས་སྤྱི་དང་ལྡན་པའི་གསལ་བ་ལ་བརྡ་བྱེད་དོ་ཞེས་འདོད་དོ།",
    "སྔར་ཤེས་རྒྱུའི་སྤྱི་དེ་ད་ལྟ་མཐོང་བ་འདི་ལའང་ཡོད་པར་འདུག་གོ་སྙམ་དུ་ཤེས་པར་འགྱུར་གྱི་འདི་སྔར་གྱི་དེའོ་སྙམ་དུ་འཁྲུལ་པར་མི་འགྱུར་རོ།",
    "དེས་ན་གལ་ཏེ་སྤྱི་ཁོ་རང་དངོས་པོར་ཡོད་པ་ཞིག་ན་གསལ་བ་ཀུན་མེད་ཀྱང་དེ་འཛིན་འབྱུང་ལ།",
    "ལྡོག་པ་ཀུན་ལ་ཡོད་ཀྱང་རང་རྐྱ་ཐུབ་པའི་དངོས་པོར་མེད་ལ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "ཁྱད་པར་གང་ཡང་གསར་དུ་མ་བསྐྱེད་ཀྱང་རང་གྲུབ་ཟིན་ཀྱི་སྤྱི་དེ་གསལ་བས་ཡུལ་དེརའཇོག་པའམ་གནས་པར་བྱེད་དོ་ཟེར་ན།",
    "གཅིག་འཇིག་པ་ན་དེ་དང་རང་བཞིན་གཅིག་པའི་གཞན་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "རྗེས་དཔག་ཀྱང་རང་བཞིན་གྱི་རྟགས་མེད་དེ་རང་བཞིན་དེ་ནི་བསྒྲུབ་བྱ་ཡིན་པས་སོ།",
    "དེ་ལྟ་ན་སྒྲ་དང་དོན་དང་འབྲེལ་བ་གསུམ་དངོས་པོ་ཐ་དད་པ་ཀ་བ་བུམ་པ་སྣམ་བུ་བཞིན་དུ་ཡོད་པར་འགྱུར་བའི་ཕྱིར་དེ་འཛིན་གྱི་བློ་ཡང་ཐ་དད་དུ་འཛིན་པ་སྣ་ཚོགས་པའི་ཚུལ་དུ་འགྱུར་གྱི་མིང་དོན་བསྲེས་ནས་གཅིག་ཏུ་ཞེན་པར་མི་འགྱུར་ལ་དེ་ལྟ་ན་འབྲེལ་། བ་དངོས་པོར་ཡོད་པ་དེས་མིང་དོན་འབྲེལ་བ་ལ་ཅི་ཞིག་ཕན་ཏེ་ཁོ་རང་རང་རྐྱ་བར་འགྱུར་རོ།",
    "སྒྲ་ཙམ་ལས་ཐ་དད་དུ་ཚིག་འབྲུ་ཡོད་དོ་ཞེས་བྱ་བ་འདི་ལ་ཤིན་ཏུ་ཆེས་དད་པར་བྱ་བ་ཞིག་ཏུ་འདུག་གོ་ཞེས་ཤིན་ཏུ་ཆེས་མི་དད་པར་སྟོན་པའི་བསྟིང་ཚིག་གོ།",
    "རྒྱུ་དེ་ལས་དངོས་པོ་གཞན་སྐྱེས་པས་ཤིང་ནི་སྔ་མ་བཞིན་དུ་འཇིག་པ་མེད་པར་གནས་པའི་ཕྱིར་ཤིང་རང་ཉིད་ནི་མཐོང་བ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཕྱོགས་གཉིས་པ་ལྟར་འཇིག་པ་ཤིང་ལས་གཞན་ཉིད་མ་ཡིན་པར་འདོད་ན་ཤིང་རང་ཉིད་འཇིག་པ་ཉིད་ཀྱི་ངང་ཚུལ་ཅན་དུ་འགྱུར་ལ།",
    "གཞན་ཐ་དད་པར་མི་འཐད་པས་ན་ཤིང་རང་ཉིད་རྒྱུ་གཞན་ལ་མི་ལྟོས་པར་འཇིག་པར་གྲུབ་བོ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་ངེས་ན་སྒྲོན་མེ་སྣང་ཙམ་གྱིས་དངོས་པོ་གསལ་བ་ལྟར་རིག་བྱེད་ཀྱི་སྒྲ་སྣང་ཙམ་ནས་དོན་གོ་བ་ལས་སྐྱེས་བུས་ཚིག་འདི་ནི་འདིའི་དོན་ཅན་ནོ་ཞེས་བརྡ་སྦྱར་བ་ཡང་དོན་མེད་པ་ཅན་ཉིད་དུ་འགྱུར་རོ།",
    "གཞན་ལུགས་དགག་དང་རང་ལུགས་འགྲེལ་བཞག།",
    "འབྲས་བུ་གང་ཞིག་དུས་རྟག་ཏུ་རྒྱུ་དེ་ཡི་རྗེས་སུ་འཇུག་པའམ་དེ་ལ་རག་ལས་པའི་ཕྱིར་མེད་ན་མི་འབྱུང་པར་ངེས་ཤིང་།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་ཚུལ།",
    "དུས་མཉམ་པར་གནས་པ་ཞེས་པ་འདི་ཅི་ཞིག་དུས་དེར་ཕན་ཚུན་ཕན་མ་བཏགས་བཞིན་བུམ་སྣམ་ཚོགས་པ་ཙམ་ལྟ་འགྲེལ་བུ་ཡིན་ན་ནི་རྟེན་བརྟེན་པར་ཡང་མི་རུང་ལ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་པའོ།",
    "ཁྱད་པར་འཕེལ་ཡང་རང་བཞིན་ཉིད།",
    "གཞན་ཡང་རང་ཉིད་ཆགས་བྲལ་གྱི་སྐྱེས་བུ་ཡིན་པར་ཡང་བསྒྲུབསཟིན་ཏོ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་ཚུལ།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡིས།",
    "ལྟར་སྲང་མདའི་མཐོ་དམན་དག་དུས་གཅིག་ཉིད་དུ་མཐོང་བ་དེ་བཞིན་དུ་ས་བོན་འགག་བཞིན་པ་ན་མྱུ་གུ་སྐྱེ་བར་འགྱུར་རོ།",
    "མཐོ་དམན་གྱི་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་ཡོད་ཀྱི།",
    "དེའི་ཕྱིར་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་དུ་མི་རིགས་པ་ཁོ་ནའོ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་སྟེ།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་བདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་ཏེ་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རྟག་པ་དང་ཆད་པ་མེད་པ་ཉིད་དོ།",
    "དེ་ཕྱིར་དེ་ལྟར་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་མེད་པས་རྟག་པ་དང་ཆད་པར་ལྟ་བ་རྒྱང་རིང་དུ་སྤངས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་འབྱུང་གཉིས།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པ་ནི་ཡོད་པ་ལྔ་རིག་དཔེ་ཚོགས་ལས།",
    "འདི་ལས་ཀྱང་རང་རིག་པ་ཡོད་པ་མ་ཡིན་པས་དེ་ཉིད་ཀྱིས་དེ་འཛིན་པ་མ་ཡིན་ནོ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ལྟར་ཕར་འདུག་ཅིག།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་ཏུ་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
    "ཇི་ལྟར་ཉིད་ཀྱི་སྤྱོད་པ་དང་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་སྤྱོད་པ་དག་དུས་གཅིག་ཏུ་རང་ཉིད་ཀྱི་བ་སྤུའི་ཁུང་བུར་སྟོན་པར་མཛད་པ།",
    "གཏོད་ན་དེའི་ཚེ་དངོས་པོ་མེད་པའི་རྣམ་པ་དང་རྗེས་སུ་འདྲེལ་བའི་རྣམ་པར་ཤེས་པ་དངོས་པོའི་རང་བཞིན་དུ་མི་འཐད་པས་དེ་འདི་དག་ནི་འགའ་ལ་འགལ་བའི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་དུས་གཅིག་ལ་གཅིག་ཏུ་མེད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་མཆོག་ཏུ་རྗེས་སུ་ཚོལ་བ་ཉིད་ནི་དེའི་ཕྱིན་ཅི་མ་ལོག་པའི་ལམ་དེ་ཡང་རང་བཞིན་མེད་པ་སྐྱེ་བ་མེད་པའི་རང་བཞིན་གྱི་ཕྱིར་སྣང་བ་མེད་པའོ་ཞེས་བྱ་སྟེ།",
    "དེ་ཡང་རང་བཞིན་ནི་དངོས་པོའི་ངོ་བོའི་ཕྱིར་དང་།",
    "འདུས་བྱས་ལ་ཡང་རང་བཞིན་མི་འཐད་དེ།",
    "འོ་ན་གཉི་ག་ཡང་རང་བཞིན་གྱིས་མ་སྐྱེས་པར་མཉམ་ལ།",
    "འོན་ཀྱང་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་ལྔ་ཆར་ཡང་རང་བཞིན་མེད་པར་བསྒྲུབ་པའི་དོན་དུའོ།",
    "དེ་སྤོང་བའི་ཐབས་ཀྱང་རང་བཞིན་ཁས་མ་བླངས་པ་ཡིན་ནོ་ཞེས་བྱ་སྟེ།",
    "གང་མི་རྟག་པ་དེ་ཡང་རང་བཞིན་མེད་པའོ་ཞེས་གསུངས་པར་འགྱུར་ཏེ།",
    "དེ་ནི་མི་རྟག་པ་དང་རང་བཞིན་ཡོད་པ་འགལ་བའི་ཕྱིར་རོ།",
    "བདག་ཏུ་འཛིན་པའི་མིང་ཅན་དེ་ཡང་རང་བཞིན་མེད་པའི་ལས་ཀྱིས་བསྐྱེད་པའི་ཕྱིར་རང་བཞིན་མེད་པའོ་ཞེས་གསལ་བར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "རང་བཞིན་མེད་པའི་ལས་ཀྱིས་བསྐྱེད་པའི་ཕྱིར་རོ་ཞེས་ཡིན་དུ་ཆུག་ན་ཡང་གང་ཡང་བདག་ཏུ་འཛིན་པ་ངར་འཛིན་པའི་མཚན་ཉིད་ཅན་འདི་ཡང་རང་བཞིན་མེད་པའི་ལས་ཀྱིས་བསྐྱེད་པའི་ཕྱིར་རང་བཞིན་དང་བཅས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གང་ཡང་འདི་བདག་ཏུ་སྒྲོ་བཏགས་པས་བསྐྱེད་པའི་ངར་འཛིན་པ་དེ་ཡང་རང་བཞིན་མེད་པའི་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པའི་མཚན་ཉིད་ཅན་གྱི་རྣམ་པར་རྟོག་པས་བསྐྱེད་པའི་ཕྱིར་རང་བཞིན་མེད་པ་ཁོ་ནའོ་ཞེས་བྱ་བ་གྲུབ་བོ།",
    "གང་ཡང་རང་བཞིན་དང་བྲལ་བའི་ཕྱིར་ལས་སྟོང་པའོ་ཞེས་ཁོང་དུ་ཆུད་པ་དེ་ནི།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་མེད་པ་ཡང་རང་བཞིན་མེད་པའི་འབྲས་བུ་རྫོགས་པར་བྱེད་པ་པོ་ཉིད་དུ་གསལ་བར་བྱེད་པ་ཤིན་ཏུ་གསལ་བར་དཔེར་ཉེ་བར་བསྟན་པས་གསུངས་པ།",
    "དེ་ཡང་གང་རང་བཞིན་མེད་པ་མཐོང་བ་དེ་ནི་དོན་དམ་པ་མཐོང་ལ་ངོ་བོ་མི་དམིགས་པས་ཀྱང་དེ་ལ་མི་བདེན་པ་ལས་སྐྱེས་པ་ལ།",
    "དེ་ཡང་རང་ལྔ་རིག་དཔེ་ཚོགས་ལས།",
    "གང་ཡང་རང་བཞིན་མེད་པ་སྟེ་དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་བཞིན་དུ་རྟོག་པ་མེད་པ།",
    "སླར་ཡང་ཅིའི་ཕྱིར་ན་འདི་དག་ཀྱང་རང་བཞིན་མེད་པ་དང་རྟོག་པ་ཙམ་དུ་ཡོད་པ་གཉིས་ཁས་ལེན་པར་བྱེད།",
    "གལ་ཏེ་སླར་ཡང་རང་བཞིན་ཡོད་པ་ཉིད་པས།",
    "གཟུགས་ནི་ཤིན་ཏུ་ཡང་རང་བཞིན་མེད་དོ།",
    "དེ་ཡང་རང་བཞིན་དུ་སྒྲོ་འདོགས་པ་ལ་ཞུགས་པའི་ཕྱིར་དང་།",
    "དེ་ཡང་རང་བཞིན་གྱིས་མི་དམིགས་པའི་ཕྱིར་མི་བརྟེན་པའོ།",
    "རབ་ཏུ་བརྩོན་པའི་བསྔགས་པ་བརྗོད་ཀྱང་རང་བཞིན་གྱི་བརྩོན་པ་མི་འཚོལ་བ་དང་།",
    "འགྱུར་རྩོམ་ཡང་དེ་ཙམ་འཐུས་ཚང་མང་པོ་མི་འདུག་གང་ལྟར་བོད་ཀྱི་བསྟན་པ་དང་ཆབ་སྲིད་ཀྱི་ཚེ་སྲོག་བསྲིང་དགོས་ཚེ།",
    "སྤྱི་བྱེ་ཀུན་ལ་མ་འོངས་པར་ལམ་འདི་ལས་ལྷག་པ་ཞིག་མེད་ཚོད་འདུག་པས།",
    "དེར་གོ་བ་ཡག་པོ་ཞིག་ཆགས་ན་ཕན་ཐོགས་རྒྱ་ཆེན་ཡོད་པར་སྙམ་གྱི་འདུག་སསབ་ཀབ་གཉིས།",
    "གནས་ལུགས་དེ་དང་མཐུན་པའི་བླང་དོར་གྱི་ལྟ་བ་ཞིག་ཀྱང་རང་རྒྱུད་ལ་སྐྱེ་འོང་བར་གསུངས་ཡོད།",
    "གལ་ཏེ་ཅིས་ཀྱང་རང་རྒྱུད་ལ་ལུང་རྟོགས་ཀྱི་ཡོན་ཏན་བསྐྱེད་མ་ཐུབ་ན།",
    "གཞན་སུ་ཡང་བསྟེན་པ་ལ་དགོས་པ་མེད་ཅེས་བན་༣ ན་ཟླ་གདམས་ཀྱི་འདུག་དཔེར་ན།",
    "དེ་གཉིས་ཀའི་མཐུན་རྐྱེན་སྒོ་ཀུན་ནས་བསྒྲུབ་རྒྱུ་བཅས་ལ་སྦྱར་དགོས་ཀྱི་འདུག་གང་ལྟར་གཞིའི་རྣམ་གཞག་ལ་རིགས་པས་དཔྱད་ཅིང་།",
    "དང་པོ་དེ་ཧ་ཅང་གལ་ཆེ་བས་དེ་ལ་ངེས་པར་དུ་འུ་ཚོས་གོ་བ་ཡག་པོ་ཞིག་ལོན་དགོས་ཀྱི་འདུག་གོ་བ་ཡག་པོ་ཟེར་བ་ནི་རྨོངས་དད་དང་ངག་རྒྱུན་གྱི་རྗེས་སུ་བརྒྱུགས་པ་ཙམ་མིན་པར།",
    "ང་རང་ལོ་ཆུང་དུས།",
    "མི་སུ་ཡིན་ཡང་རང་དང་ཕུགས་བསམ་གཅིག་པ་རྣམས་གྲོགས་སུ་བསྟེན་རྒྱུ་ནི།",
    "ད་ཆུ་ཚོད་ཀྱང་འཕྱི་བོ་ཆགས་འགྲོ་ཡི་འདུག་དེ་ཙམ་གྱིས་ཆོག་པར་བྱེད།",
    "འདི་ད་གང་བོ་འདུག་པས་དྲོ་བའི་ཆེད་དུ་གྱོན་པ་ཡིན་ཟེར།",
    "ད་རུང་རྒྱུན་འཛིན་བྱེད་དགོས་པར་འདོད་པ་ལ་དངོས་གནས་མཚར་སྣང་སྐྱེ་ཡི་འདུག་མཚན་ཉིད་ལ་སྦྱངས་པ་ནི་གནས་ལུགས་ཤེས་པའི་ཆེད་ཡིན་པས།",
    "འདི་ད་གྲང་བོ་འདུག་པས་དྲོ་བའི་ཆེད་དུ་གྱོན་པ་ཡིན་ཟེར།",
    "གླེན་པ་དེས་བོད་ཡུལ་གྲོང་པའི་ལུང་པ་རུ་གྲྭ་ཆས་ལས་སྐྱ་ཆས་དྲོ་བ་ཙམ་ཡང་ཤེས་མི་འདུག་པས།",
    "དེར་ཅང་སྨྲ་དགོས་མི་འདུག་གཉིས།",
    "སྔར་གྱི་འོས་ཤོག་འཕེན་ཡུལ་དེ་ནོར་འདུག་སྙམ་ན།",
    "ལྟ་བ་ལོག་འདུག་གསུངས་སོ།",
    "དེ་ལ་ཟས་དྲངས་པ་སོགས་བྱེད་ཀྱི་འདུག་པས།",
    "གཞན་གྱིས་ལྟ་ལོག་པ་ཟེར་ནས་ཁ་གཏང་ཡོང་ཟེར་གྱི་འདུག་ད་ནི་ནང་པ་ཚོར་ནང་པའི་ལྟ་གྲུབ་ཀྱི་དགོངས་པ་ལབ་ཀྱང་།་",
    "སྤོངས་པ་བསམ་གཏན་ཁོ་ན་ཡིན་པར་གསུངས་འདུག་པས།",
    "དེ་བོད་ལ་ཉུང་བར་ཁག་མི་འདུག་གཉིས་པ།",
    "རྗེས་མར་ཁྱེད་ཀྱིས་ཚང་རྩིས་རྒྱག་དུས།",
    "དོན་དངོས་ཐོག་ལམ་ལུགས་ཟེར་བ་ནི་སྣོད་ཅིག་དང་མཚུངས་ཀྱི་འདུག་པས།",
    "སྟབས་ཀྱང་དེ་བདེ་པོ་འདུག།",
    "བཟུང་འདུག་རིམ་པས་ས་སྔོན་ཁ་ནས་རྒོད་ཚང་མདའ་དང་།",
    "དཔྱིད་ཀའི་སྐབས་སུ་འབྲོག་པ་རྣམས་རི་སྨད་དགུན་མཚེར་གྱི་ཐག་ཉེ་ལ་སྦྲ་ཕུབ་སྟེ་འདུག་པ་དང་དེ་ལ་དཔྱིད་མཚེར་ཟེར་ཞིང་དཔྱིད་ཟླ་གསུམ་གྱི་རིང་དེར་གནས་སྡོད་བྱེད།",
    "ཕུན་སུམ་ཚོགས་ཤོས་ཀྱི་སྐབས་ཡིན་པས་འབྲོག་པ་རྣམས་ས་མཐོ་སར་སྦྲ་ཕུབ་སྟེ་འདུག་པ་དང་དེ་ལ་དབྱར་མཚེར་ཟེར་ཞིང་དེ་རུ་དབྱར་ཟླ་གསུམ་གྱི་རིང་གནས་སྡོད་བྱེད་པ་ཡིན།",
    "དགུན་ཁ་ནི་གནམ་གཤིས་ཆེས་གྲང་ངར་ཆེ་བའི་སྐབས་སུ་འཁེལ་གྱི་ཡོད་པས་ལུང་པའི་མདའ་རུ་ཁང་པའི་ནང་དུ་འདུག་པ་ཡིན།",
    "སྟོན་ཀའི་སྐབས་སུ་འབྲོག་པ་རྣམས་དབྱར་མཚེར་ལས་དམའ་ཙམ་དང་དགུན་མཚེར་ལས་མཐོ་ཙམ་ལ་སྦྲ་ཕུབ་ནས་འདུག་དེ་ལ་སྟོན་མཚེར་ཟེར་ཞིང་དེ་ཡོད།",
    "ང་རང་ལོ་བདུན་ཙམ་ནས་ཟོག་རྫི་དང་།",
    "ང་རང་བྱིས་དུས་ཀྱི་སྐབས་སུ་རྩེད་རོགས་ཕྲུ་གུ་གཞན་མེད་པ་རྟག་ཏུ་རང་ཉིད་གཅིག་པུས་ཁེར་རྩེད་རྩེ་ནས་སྡོད་ཀྱི་ཡོད།",
    "དེ་ནི་རུ་རུ་ཕུ་ཟེར་བའི་ལུང་པ་དེ་ནས་རྒྱ་མི་དང་བོད་མི་དབར་འཁྲུག་འཛིང་ཤུགས་ཆེན་བྱུང་བའི་སྐབས་སུ་བོས་དགྲ་དང་སྒྲོགས་སྒྲ་སོགས་ཀྱི་སྐད་ཡིན་འདུག་ས་དེར་རྒྱ་བོད་གཉིས་ཕྱོགས་ནས་མི་གྲངས་གྲངས་མེད་ཤི་རྨས་བྱུང་ཡོད་པ་གོ་ཐོས་བྱུང་།",
    "ང་རང་ཤུག་པ་འཐུ་རུ་འགྲོ་དུས་ཤུག་པའི་ཡལ་ག་བཅག་མི་ཐུབ་པ་དང་།",
