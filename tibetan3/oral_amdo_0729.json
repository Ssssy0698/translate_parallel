    "འདི་ནི་བདག་གི་གྲོགས་ཏེ་གྲུ་གཅིག་ཏུ་ཞུགས་པའོ།",
    "འདིས་ཇི་ལྟར་བསླབ་པར་བྱ་བ་དེ་བཞིན་དུ་བདག་གིས་ཀྱང་བསླབ་པར་བྱའོ།",
    "འཇམ་ད་པལ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱི་རང་རྒྱལ་བ་རྣམས་ལ།",
    "བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་གཤེ་བར་བྱེད།",
    "རང་རྒྱལ་བ་རེ་རེ་ལ་ཡང་སྦྱིན་བདག་ལྷའི་གོས་དང་།",
    "རང་རྒྱལ་བ་དེ་དག་གི་སྦྱིན་བདག་དེ་དག་ཐམས་ཅད་ཀྱང་རྒྱུན་དུ་ཞུགས་པར་གྱུར་པ་དང་།",
    "ཕྱིར་མི་འོང་བ་དེ་དག་གི་བདོག་པ་ཐམས་ཅད་འཕྲོག་པར་བྱེད།",
    "དེ་ནས་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་ག་གིས།",
    "དེ་ནས་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་འགའ་ཞིག་གིས་ཡོང་ས་སུ་བརྟག་པ་བཟུང་སྟེ།",
    "དེ་ལ་༤རང་རྒྱལ་བ་དེ་དག་ལ་བསྐལ་པ་༥གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ད་དུ།",
    "བསྐལ་པ་བརྒྱ་འམ་བསྐལ་པ་སྟོང་ཕྲག་གིས་ཀྱང་བརྗོད་པར་སླ་༡༧བ་མ་ཡིན་ནོ་ཞེས་གསུངས་ས་སོ་༐།",
    "མི་གྲུམ་པོ་རྐང་པ་གཉིས་དང་བྲལ་བ་འདི་ནས་བྱང་གི་གླིང་དུ་འགྲོ་བར་འདོད་པའམ།",
    "ཇི་སྲིད་དུ་གང་བད་ག་གི་མཛའ་བོ་ཡིད་དུ་འོང་བ་དེ་ལ་སྔོན་དོན་མ་ཡིན་པ་བྱས་སོ་ཞེས་བྱ་བའི་བར་ད་ང་།",
    "བདག་གི་མི་མཛའ་ཞིང་ཡིད་དུ་མི་འོང་བ་ཞེས་བྱ་བའི་བར་ད་ང་། ༐",
    "ལེགས་པར་བསྒོམས་པས་མོས་པར་བྱས་ཏེ་རྫོགས་པར་བྱས་ནས་གནས་ཀྱི་༦ཆགས་པ་དང་ལྡན་བུ་ི་པས་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་ད་ང་།",
    "རྒྱལ་བ་༡ཐམས་ཅད་དང་ཐུན་མོང་མ་ཡིན་པའོ་ཞེས་བྱ་བ་གསུངས་སོ་༐།",
    "བྱ་ལོག་པར་ལྟུང་ཞིང་སྡུག་བསྔལ་གྱུར་ཏ་རེ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་ཞིག་གིས་ནི།",
    "ཡོངས་སུ་བརྟག་པ་བཟུང་སྟེ་༡རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས་ཁྲོས་ཏེ་སྡང་བའི་སེམས་ཀྱིས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་ཞིག་གིས་༡ནི།",
    "རང་གི་སེམས་ཀྱི་རྒྱུད་ལས་སྐྱེས་པའི་ཉོན་མོངས་པ་རྣམས་འཇོམས་པར་བྱེད་པར་ཟད་ཀྱི།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས་༢ཁྲོས་ཏེ་གནོད་སེམས་ཀྱི་སེམས་ཀྱིས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་ཞིག་གིས་ནི།",
    "འཇམ་ད་པལ་རིགས་ཀྱི་བུ་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་ཞིག་གིས་ནི།",
    "དེ་ནས་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་ག་གིས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་སྙེད་༐",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས་ནི།",
    "འཇམ་ད་པལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིག་ས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "རིགས་ཀྱི་བུ་འམ་རིག་ས་ཀྱི་བུ་མོ་གཞན་ཞིག་གིས།",
    "འཇམ་ད་པལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "བསྐལ་པ་རྒྱ་མཚོ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་སྙེད་ཀྱི་དད་པས་རྗེས་སུ་འབྲང་༤བ་དག་ལ་ཉིན་གཅིག་བཞིན་དུ་ལྷའི་ཟས་རོ་བརྒྱ་དང་ལྡན་པ་བྱིན་པ་དང་།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་ཞིག་གིས།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "དེ་བཞིན་དུ་ལྷའི་གོས་རྣམས་སྦྱིན་པ་བྱིན་པ་བས་འཇམ་དཔལ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས་བརྒྱད་པ་གཅིག་ལ་ཉིན་གཅིག་ཟན་གཅིག་བྱིན་ན།",
    "འཇམ་ད་པལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་སྙེད་ཀྱི་བརྒྱད་པ་ལ་ཉིན་གཅིག་བཞིན་དུ་ལྷའི་ཟས་རོ་བརྒྱ་དང་ལྡན་པ་བྱིན་པ་དང་།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་སྙེད་ཀྱི་རྒྱུན་དུ་ཞུགས་པ་དག་ལ།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
    "བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་སྙེད་ཀྱི་ལན་ཅིག་ཕྱིར་འོང་བ་ད་ག་ལ་ཉིན་གཅིག་༤བཞིན་དུ་ལྷའི་ཟས་རོ་བརྒྱ་ད་ང་ལྡན་པ་བྱིན་པ་དང་།",
    "འཇམ་ད་པལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས།",
