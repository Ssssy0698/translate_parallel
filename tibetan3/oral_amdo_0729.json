    "ཆེ་གེ་མོ་ཞིག་གིས་བདག་ལ་འདི་སྐད་དུ་སྨྲས་ཏེ།",
    "བད་ག་གིས་ཚར་བཅད་ཅིང་སྤོབས་པ་མེད་པར་བྱས་ས་སོ།",
    "བདག་གིས་ལེགས་སོ་ཞེས་བྱ་བ་རྙེད་ད་དོ།",
    "ཚིག་གིས་བདག་ལ་འགས་ཀྱང་དགོས་པ་མེད་པར་སྨྲ།",
    "དེ་ལྟ་བུའི་རང་བཞིན་ཅན་གྱི་དགེ་སློང་གི་དྲུང་ནས་སྐྱེ་བོ་མང་པོ་འབྱེད་པར་བྱེད་པ་སྐྱེས་བུ་དམ་པ་མ་ཡིན་པ་དེ་དག་གི་༡སྤྱོད་པ་དག་ལ་ལྟོས།",
    "གཞན་སྲོག་ཆགས་སྟོང་ཕྲག་བརྒྱ་ཚང་བ་ཡང་མ་སོང་ང་ངོ།",
    "དེ་ད་ག་ཀྱང་མ་སོང་བས་མཐོ་རིས་སུ་སྐྱེ་བ་དང་།",
    "དེ་ཐང་ཅིག་༢གིས་ལྡང་བར་གྱུར་ཏོ།",
    "འོད་སྲུངས་ཁྱོད་ཀྱིས་དེ་ལྟར་ནི་བལྟ་༢བར་མི་བྱའོ།",
    "འོད་སྲུང་ས་ཁྱོད་དེའི་ཚེ་དེའི་དུས་ན།",
    "འོད་སྲུངས་ཁྱོད་ཀྱིས་དེ་ནི་དེ་ལྟར་བལྟ་བར་མི་བྱའོ་། དེ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "ཁྱོད་དེ་ལྟར་གཞན་ཞིག་ཡིན་སྙམ་དུ་སེམས་ན།",
    "འོད་སྲུངས་དེའི་ཕྱིར་ཁྱོད་མོས་པར་བྱ་ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "དེའི་ཡང་ཕ་རོལ་གྱི་ཆེས་ཕ་རོལ་ཞིག་གི་༤དུས་ན།",
    "རང་གི་དོན་རྗེས་སུ་ཐོབ་པ།",
    "ཤ་སྟག་གི་ཚོགས་༡སུ་གྱུར་ཏོ།",
    "རང་གི་དོན་རྗེས་སུ་ཐོབ་པ།",
    "བཀའ་ཡང་དག་པས་སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་ཤ་སྟག་གི་ཚོགས་སུ་གྱུར་ཏོ།",
    "ངན་ངོན་ལ་མོས་པ་འཁོར་གྱི་ནང་ན་སྤྱོད་པ་སྟེ།",
    "སྦྱངས་པའི་ཡོན་ཏན་གྱི་སྡོམ་པ་ལ་མོས་པར་གྱུར་ཏོ།",
    "བད་ག་ཅག་གི་ནང་ནས་སུས་ཀྱང་གྲོང་དུ་འཇུག་པར་མི་བྱའོ།",
    "ཁྱོད་ནི་ཤེས་བཞིན་མེད་པར་སྤྱོད་པ་ཡིན་ཏེ།",
    "ཉུང་ངུ་སྨྲ་བ་༢མ་ཡིན་གྱིས་ཁྱོད་༤གྲོང་དུ་འགྲོ་བས་ཀྱང་ཅི་ཞིག་བྱ་སྟེ།",
    "གྱི་ཁྱོད་༦གྲོང་དུ་མ་འདོང་༧བར་བསམ་གཏན་གྱི་བདེ་བས་རྣམ་པར་སྤྱོད་ཅིག་ཅེས་བསྒོའོ།",
    "ཁྱོད་༡༧གཙུག་ལག་ཁང་འདི་ན་མ་གནས་ཞེས་བསྒོའོ།",
    "དགེ་སློང་དེའི་སེམས་བསྲུང་༡༧བའི་ཕྱིར་རང་གི་འཁོར་རྣམས་བོས་ཏེ་འདི་སྐད་ད་དུ།",
    "ང་ཡང་དེ་ལྟ་བུའི་ཐབས་ཕྲ་མོས་༢དེ་ལ་མ་དད་པའི་སེམས་བསྐྱེད་ད་དེ།",
    "རིགས་ཀྱི་བུ་ལས་ཀྱི་སྒྲིབ་པ་དེ་ལྟ་བུ་མི་འདོད་པ་དེ་དག་གིས་༤གཞན་གྱི་སྤྱོད་པ་ལ་༥ཁོང་ཁྲོ་བར་མི་བྱའོ།",
    "འདི་སྙམ་དུ་ཕ་རོལ་གྱི་སེམས་ནི་བདག་གིས་མི་ཤེས་ཏེ།",
    "༩གང་ཟག་གིས་གང་ཟག་ལ་ཚོད་བཟུང་ན།",
    "འཇིག་རྟེན་གྱི་ཁམས་སྨིག་རྒྱུ་ཅན་དུ་དེ་བཞིན་གཤེགས་པ་རྣམ་པར་གཟིགས་པའི་ང་རོ་ཅན་ཞེས་བྱ་བ་བྱུང་བར་གྱུར་པ་དེའི་ཚེ།",
    "གཙུག་ལག་ཁང་རེ་རེར་༡ཡང་དགེ་སློང་སྟོང་སྟོང་གནས་པར་གྱུར་ཏོ།",
    "གླུ་དབྱངས་དང་རོལ་མོ་བྱས་ས་སོ།",
    "ཇི་སྲིད་འཆོའི་མཐར་ཐུག་གི་བར་དུ་གཟུངས་མ་ཐོབ་པར་འཆི་བའི་དུས་བྱས་ཏེ།",
    "རིགས་ཀྱི་བུ་དེ་ལྟ་བས་ན་ཁྱོད་མོས་པར་བྱའོ།",
    "ཁྱོད་ཀྱིས་༢ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ནི་ཉོན་མོངས་པ་རྣམས་ཀྱིས་འདོད་པའི་ལོངས་སྤྱོད་ལ་གནས་པར་བརྗོད་པར་མི་བྱ།",
    "ད་པེར་ན་ཀླུ་ཐམས་ཅད་ཀླུ་ཉིད་དུ་སྤྱིར་༢སོང་བ་ཡིན་པས་ཀླུའི་རྒྱལ་པོ་མ་དྲོས་པ་ནི་ཀླུའི་བགྲང་བར་ཡང་འགྲོ་ལ།",
    "རིགས་ཀྱི་བུ་ཀླུའི་སྐྱོན་གསུམ་པོ་འདི་དག་གིས་གོས་པར་མི་འགྱུར་ར་རོ།",
    "ཉོན་མོངས་པ་དང་།",
    "ཡིན་པ་༢སྙམ་དུ་ཁྱོད་སེམས་ན།",
    "ཁྱོད་ཀྱིས་དེ་ལྟར་མི་བལྟ་༤སྟེ།",
    "བདག་ཅག་གིས་མཆོད་རྟེན་ན་ནམ་དེ་བཞིན་གཤེགས་པ་མཐོང་ངོ།",
    "བདག་ཅག་གི་༢མདུན་ན་སང་ས་རྒྱས་བཞུགས་སོ་སྙམ་དུ་བསམ་མ་མོ།",
    "བད་ག་ཉིད་ཀྱིས་༢གང་ཚིགས་སུ་བཅད་པ་ཉོས་པ་ནི་རང་གི་ལུས་ཡོངས་སུ་བཏང་བ་དང་།",
    "བུ་དང་བུ་མོ་ཡོངས་སུ་བཏང་བ་དང་།",
    "ཇི་ཙམ་དུ་ཁོང་ཁྲོ་བའི་མིག་གིས་ལྟ་བ་དེ་སྲིད་དུ་ལོང་བའི་སྐྱེ་མཆེད་ཐོབ་པར་འགྱུར་ར་རོ།",
    "དགེ་སློང་རྒྱལ་བའི་བློ་གྲོས་ཞེས་བགྱི་བར་གྱུར་ཏེ་བཅོམ་ལྡན་འདས་བདག་གིས་དེ་ལྟ་བུའི་ཚུལ་འདི་མ་འཚལ་བ་ས།",
    "ཕྱིན་ཅི་ལོག་གི་སྡུག་བསྔལ་རྣམ་པ་དེ་ལྟ་བུ་མྱོང་བར་གྱུར་ཏོ།",
    "གང་གིས་༥གང་གཱའི་བྱེ་སྙེད་ཀྱི།",
    "འདི་ལྟར་མི་བླུན་པོ་དེ་དག་ངན་སོང་དུ་འགྲོ་བར་བདུད་ཀྱིས་བྱིན་གྱིས་བརླབས་པའི་ཕྱིཕྱིར།",
    "ཐམས་ཅད་ཀྱི་གསོང་པོར་སྨྲ་བ་ཞེས་བྱ་བ་དང་།",
    "གསོང་པོར་སྨྲ་བ་ཞེས་བྱ་བ་ད་ང་།",
    "བཞི་པོ་དེ་དག་གིས་ཟིལ་གྱིས་མནན་པར་གྱུར་ཅིང་ལྡང་བར་མ་ནུས་སོ།",
    "ལྷག་པར་མོས་པ་བྱེ་བ་ཁྲག་ཁྲིག་དྲུག་ཅུ་རྩ་བརྒྱད་པོ་དེ་དག་ནི།",
    "ཤ་ར་དྭ་༤ཏིའི་བུ་དེ་ལྟར་དམ་པ་མ་ཡིན་པ་དེ་དག་ག་གིས།",
    "དེ་དག་གི་ལོག་པར་ལྟ་བ་ཡོང་ས་སུ་འཛིན་པར་གྱུར་ཏོ། ༐",
    "སྐྱེས་བུ་དམ་པ་མ་ཡིན་པ་བཞི་པོ་དེ་དག་གི་རྗེས་སུ་འབྲང་བ།",
    "དེ་དག་གི་སྨྲ་བ་ལ་གུས་པར་ཉན་པར་གྱུར་པ་དེ་རྣམས་ཀྱིས།",
    "སྦྱོར་ཞིང་འབད་ལ་ནལ་འབྱོར་དུ་བྱེད་པ་དེ་དག་གིས་ནི་ནམ་ཡང་ཟས་ཡོངས་སུ་སྦྱོར་བའི་ལས་བྱས་པ་མ་ཡིན་ན་ནོ།",
    "དེ་དག་གིས་༨ནམ་དུ་ཡང་རྗེས་སུ་མཐུན་པའི་བཟོད་པ་ཡང་མ་སྐྱེད་ན།",
