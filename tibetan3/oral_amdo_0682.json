    "དེ་ལྟར་ཉིན་འགའ་འགོར་རྗེས་ཁོས་ལས་མེད་དལ་འདུག་གི་།",
    "ཕྱི་ཉིན་ནས་བཟུང་གསེར་ཉས་ཇི་འདྲའི་འཁྱུག་རྩེད་ངོམ་ཡང་ཁོ་རང་གྲག་འགུལ་ཅི་ཡང་མེད་པར་ཅེ་རེར་བསྡད།",
    "དུས་ཡུན་ཧ་ཅང་རིང་པོ་འགོར་བས་ཁོའི་སེམས་ལ་ཆུ་ངོས་སུ་ཤར་བའི་རང་གི་གཟུགས་བརྙན་དེར་བལྟས་ན་སྙམ་སྟེ་རྐེད་པ་སྒུར་ནས་ཞིབ་ཏུ་བལྟ་དུས་སྐྲ་རིང་བོ་དེ་ཕྲག་པ་ནས་ཆུ་ནང་དུ་ལྷུང་།",
    "ཁོ་ལ་འཇིགས་སྐྲག་གི་རྔུལ་ཆུ་འཐོར་ནའང་ཐབས་གཞན་མེད་པས་མྱུར་དུ་ལག་ཕྱིས་བླངས་ཏེ་མགོར་དཀྲིས།",
    "ནས་ལས་ཀ་ཞིག་སྟེར་བའི་རེ་བ་ཞུས།",
    "ཁོ་གཅིག་པོས་མེ་མི་རྣམས་ཀྱིས་ཁོ་ལ་ལས་ཀ་ཅི་ཞིག་བྱིན་ན་བཟང་ཏོག་ལྡུམ་རར་ལས་ཀ་བྱེད་དུས་གནམ་ངོ་ཧ་ཅང་བ་མི་ཤེས་མོད་འོན་ཀྱང་མི་ཚང་མ་ལག་གཉིས་ལ་དྭངས་ལ་ཉི་འོད་ཚ་གདུག་ཆེ་བས་ཞྭ་མོ་ཕུད་དེ་གསེར་རྩི་འགོས་པའི་བུ་ཆུང་འདིར་ཧ་ཅང་དགའ་།",
    "མྱུར་དུ་མེ་ཏོག་མཛེས་ཤིང་སྡུག་ལ་དྲི་ཞིམ་པ་རྩ་ཆེན་ངའི་མགོ་ན་རྨ་མང་པོ་ཡོད་པས་ཁྱེད་ཀྱིས་གཟིགས་ཞིག་ཁྱེར་ཤོག་ཅེས་བཤད།",
    "འོན་ཀྱང་སྲས་མོས་བྱས།",
    "དགྲ་བོས་བཙན་སྔར་བཞིན་ཁོ་རང་བོས་ཏེ་ཞྭ་འཕྲོག་པར་བརྩམས་འཛུལ་བྱེད་བཞིན་ཡོད་པས་ང་ཡང་དམག་ལ་འགྲོ་མོད་ཁོས་ཞྭ་དམ་པོར་བསྡམས་དེ་ཕུད་དུ་མ་བཅུག་རྒྱུ་ཡིན་ཅེས་ལན་བཏབ།",
    "གཞོན་ནུ་རྟ་མཆོག་དེར་ཞོན་ནས་གྱེས་ཁབ་དེར་རྒྱལ་ཁབ་གཞན་ཞིག་གིས་བཙན་འཛུལ་མཇལ་ཞུས་རྗེས་བྱ་འཕུར་བ་ལྟར་དམག་དཔུང་བྱས་ཏེ་དམག་འཁྲུག་ཆེན་པོ་ཞིག་ལངས་གྲབས་ཁྲིད་དེ་གཡུལ་སར་སོང་།",
    "རྒྱལ་བོས་མངའ་འབངས་རྣམས་བསྡུས་ཏེ་དམག་མི་ཕལ་ཆེར་དགྲ་དམག་གིས་བསད་ཚར་ལ་འགོག་རྒོལ་གྱི་སྟ་གོན་བགྱིས།",
    "མེད་ཚེ་ཆག་སྒོ་ཆེན་པོ་བྱུང་ཁོ་ཐག་རེད་ཅེས་གང་ཐོན་དུ་བྲོས།",
    "སྨོད་བྱས་མོད་ཁོས་ལན་ཅི་ཡང་མ་བཏབ་པར་གཏོར་བ་ལྟར་དགྲ་དམག་གཅིག་ཀྱང་མ་ལུས་པར་བསྡད།",
    "ཚར་གཅོད་བྱས་རྗེས་རང་ཕྱོགས་ཀྱི་དམག་མི་དགོང་མོར་རྒྱལ་བློན་འབངས་མི་རྣམས་ཀྱིས་རྣམས་ད་དུང་ཧད་དེ་ལུས་འདུག་ཁོས་རང་གི་སྐྱ་མི་རྒྱུས་མེད་དེ་གླེང་བཞིན་བསྡད་ལ།",
    "དེ་ནི་རྒྱུས་མེད་ཀྱི་སྐྱ་མི་ཞིག་ཡིན་ལྕགས་གླང་རྒྱལ་ཕྱིར་ཡོང་ནས་ཁྱོད་ལ་དོན་དག་ཅི་ལ་ཁོས་དམག་དཔུང་ཁྲིད་དེ་འཐབ་པས་གཡུལ་ཡོད་ཅེས་དྲིས།",
    "འོན་ཀྱང་ཁོའི་ལག་ཏུ་རྐང་གྱོལ་རྒྱལ་ཁའི་ངང་ཕྱིར་སླེབས་བྱུང་ཞེས་སྐད་གསེར་གྱི་ཀུ་ཤུ་ཐོབ་མ་ཐག་རྟར་ཞོན་ནས་ནགས་ཚལ་གྱི་ཕྱོགས་སུ་བྲོས་སོང་།",
    "བློན་པོ་ཞིག་ཁོ་དང་ཐག་ཧ་ཅང་ཉེ་བས་མདའ་འཕངས་ཏེ་མདའ་མོ་ཁོའི་རྐང་།",
    "ཡིན་ནའང་མི་འདི་དགོད་བྲོ་བ་ཞིག་རེད།",
    "སྲས་མོས་དེ་དག་རྒྱལ་བོར་ཞུས་ཚེ་མྱུར་བར་མཇལ་དུ་ཡོང་དགོས་པའི་བཀའ་ཕབ།",
    "གཞོན་ནུ་རྒྱལ་བོའི་མདུན་དུ་བཅར་སྐབས་ད་རུང་ཞྭ་གོན་ཡོད་པས་སྲས་མོས་པྲ་ཚག་གིས་ཁོའི་མདུན་དུ་སོང་ནས་ཞྭ་མོ་འཕྲོག་པ་ན་གསེར་སྐྲ་ཕྲག་མགོར་ལྷུང་བས་མི་ཚང་མ་ཧ་ལས་སོང་།",
    "རྒྱལ་བོས་ཁྱོད་ཀྱིས་འདི་འདྲ་ཞིག་བསྒྲུབས་ཐུབ་ན་ལྡུམ་ར་གཉོར་མཁན་ཞིག་བྱེད་དོན་ཅི།",
    "ཁྱོད་ནི་རྒྱལ་ཁབ་གང་དང་ཁྱོད་ཀྱི་ཕ་མ་སུ་ཡིན་ཞེས་དྲིས་པར།",
    "རྒྱལ་བོས་ད་ལྟ་ངས་ཐམས་ཅད་ཤེས་སོང་།",
    "ད་ལྟ་ཁྱོད་ཀྱིས་ཅི་འདོད་པ་སྨྲོས་དང་ངས་བསྒྲུབ་ཐུབ་པ་བསྒྲུབ་ངེས་ཡིན་ཞེས་བཤད།",
    "གཞོན་ནུས་འཛུམ་དམུལ་དམུལ་གྱིས་སྲས་མོར་གཅིག་བལྟས་ཏེ།",
    "རྒྱལ་བོ་ལགས་སྲས་མོ་ངའི་ཆུང་མ་བྱེད་དུ་བཅུག་ན་ཨེ་ཆོག་ཅེས་བཤད།",
    "སྲས་མོའི་གདོང་དམར་པོར་གྱུར་ཏེ་མགོ་སྨད་ནས།",
    "གཉེན་སྒྲིག་བྱེད་སྐབས་ཁོའི་ཡབ་ཡུམ་ཀྱང་སྔགས་བཏབ་སྟེ་དུག་མཚོ་རུ་འཕངས་པས་མི་རྒོད་སྟོན་མོར་ཕེབས་ཏེ་དགའ་སྤྲོའི་དཔལ་གྱིས་ཁེངས།",
    "ནི་ཁྱོད་ཀྱིས་དེ་སྔ་བསྐྱབས་མྱོང་བའི་ལྕགས་གླང་རྩོམ་སྒྲིག་འགན་འཁུར་བ་མགོན་པོ།",
    "ནེའུ་གསིང་གི་རྩྭ་ཕྲན་ལྗང་གུ།",
    "ཚེ་སྲོག་གི་གོ་དོན་བཀྲལ།",
    "བརྩེ་དུང་གི་གླུ་དབྱངས་བླངས།",
    "གཡའ་དང་སྤང་གི་མཚམས་ནས།",
    "རི་དང་བྲག་གི་ཁ་ནས།",
    "གསོམ་སྡོང་གི་ལོ་མ་ལྗང་གུ།་",
    "གཅོང་རོང་གི་གྲོག་མོ།",
    "སོགས་རང་བྱུང་ཁམས་ཆེན་མོ་ལས་རྣམ་པར་རྒྱལ་ཏེ།",
    "མཚོ་སྔོན་ཁྲི་ཤོར་རྒྱལ་མོ་རུ་འབབ་པའི་གཙང་བོ་སྟེ་པུ་ཧ་།",
    "ཁྱེད་ཀྱི་ལུམས་པ་མེད་པའི་བརྩོན་འགྲུས་ཀྱི་བཞུར་རྒྱུན་དེའི་དྲན་སྐུལ་གྱི་ལྕག་གིས་བདག་ལ་བྲབས་ཤིང་།",
    "འབྱུང་འགྱུར་གྱི་ལས་དོན་ཐད་འགྱུར་མེད་ཀྱི་བརྩོན་པ་བསྐྱེད་དུ་བཅུག་ཁྱེད་ཀྱི་དྭངས་ཤིང་གཙང་བའི་འབབ་རྒྱུན་གྱིས་བདག་གི་མ་རུང་བའི་བསམ་པ་གཙང་མར་བཀྲུས་ཤིང་།",
    "ཡུན་རིང་གི་བྱ་བའི་ཁྲོད་དུ་གཞན་ཕན་གྱི་ལྷག་བསམ་སྐྱེས་སུ་བཅུག་ཁྱེད་ཀྱི་སྙན་ཞིང་འཇེབས་པའི་ལྷུང་ལྷུང་གི་བཞུར་སྒྲ་དེས་བདག་རྨོངས་མུན་གྱི་གཉིད་ལས་བསླངས་ཤིང་།",
