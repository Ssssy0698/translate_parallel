    "གསུམ་པ་ཟ་འཆག་ཉལ་འདུག་སོགས་སྤྱོད་ལམ་ཀུན་ཏུ་འཆི་བ་མི་རྟག་པ་དྲན་པར་བྱ་ཞིང་ཡང་དག་པའི་ལམ་ལ་བསྐུལ་མ་གདབ་པར་བྱ་སྟེ།",
    "རྒྱུན་འགག་པ་དང་རྒྱུན་འགྱུར་བ་དང་ཕྲ་བའི་མི་རྟག་པ་གསུམ་མེད་པས་རིམ་པར་རྟག་པ་དང་བརྟན་པ་དང་འཕོ་འགྱུར་མེད་ཅིང་རང་བཞིན་སྤྲོས་དང་བྲལ་བ་སྟོབས་སོགས་ཡོན་ཏན་གྱི་རང་བཞིན་གྱིས་ལུས་རྫོགས་པ་སྟེ།",
    "དེ་ནི་ངོ་བོ་སྟོང་ཞིང་རང་བཞིན་གསལ་བ།",
    "བརྟན་པ་ཐོབ་ནས་དབྱེར་མེད་ཟུང་དུ་འཇུག་དུས་ཀྱང་སྣང་སྟོང་ངམ་བསྐྱེད་རྫོགས་ལྡོག་པ་དེ་བཞིན་དུ་གནས་སོ།",
    "དང་པོར་དབེན་ཞིང་ཡིད་དུ་འོང་བའི་གནས་དག་ཏུ་སྟན་བདེ་བར་འདུག་ནས།",
    "གཅིག་བསྡོམས་འདི་འདྲ་གཞན་ན་འདུག་གམ་སོམས།",
    "བདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "ནང་ཕ་མ་རྡོ་རྗེའི་སྤུན་སྲིང་དང་རང་ལུས་ལ་སྨོད་པ།",
    "མཐར་ཐུག་དུས་གསུམ་གྱི་རྒྱལ་བ་རྣམས་གང་ལས་གཤེགས་ཤིང་གཤེགས་ལ་གཤེགས་པར་འགྱུར་བའི་བགྲོད་པ་གཅིག་པའི་ལམ་མཆོག་མཐར་ཐུག་པ་ནི།",
    "ཕལ་དག་རང་རང་བྱ་བའི་ལས་ཀྱིས་སོ།",
    "དེ་ཡང་རང་ལུགས་ཀུན་མཁྱེན་ཆེན་པོ་དང་།",
    "རང་རང་ལམ་གྱི་ངོས་ནས་ཡོངས་སུ་རྫོགས།",
    "འོ་ན་རྒྱུ་རྒྱུད་དེ་རིག་པ་འགྱུར་མེད་ལ་དེ་བཞིན་དུ་བྱེད་པར་འདུག་པས།",
    "དེ་བཞིན་ཉིད་དང་རང་བཞིན་ཐུགས་རྗེ་སོགས་བཅུ་གཉིས་སུ་དབྱེ་ཡང་།",
    "སྟན་བདེ་བ་ལ་འདུག་ནས་སྐྱབས་སེམས་སྔོན་དུ་འགྲོ་བས།",
    "བདག་ཀྱང་རང་བཞིན་དེ་ལས་མ་འདས་པས།",
    "འདུག་གམ་བར་སྣང་ན་མེད་རྒྱ་མཚོའི་ནང་ནའང་མེད།",
    "ཚྭ་ས་འདས་ནགྲུང་བཀྲེས་སྐོམ་གཅིག་ཟའི་འཚེ་བས་འཇིགས་འ་ཁ་འཐོར་མི་ཡུལ་བྱ་དང་རི་དྭགས་སོགས་ རྩོན་པས་གཙེ་ཞིང་རང་རང་གནོད་པས་ཉེན།",
    "མཐུ་སྟོབས་ཉམས་པས་འགྲོ་འདུག་བསྒྲིལ་བསྐྱོད་དཀའ།",
    "རིགས་དང་རང་བཞིན་ཀུན་སྤྱོད་སྐལ་བ་ངན།",
    "མཐར་ཡང་རང་ཉིད་ལུས་ཅན་ཀུན་གྱི་སྐྱབས།",
    "རང་རང་བདེ་བར་གནས་ཏེ་དགའ་བ་བསྒོམ།",
    "རང་རང་གཞུང་ནས་གསུངས་པའི་ལུང་མནོས་ཏེ།",
    "མི་གནས་ཏེ་སེམས་ལ་སྐྱེ་འགག་གནས་གསུམ་གྱི་ཆ་མེད་ཅིང་རང་བཞིན་མཉམ་པའི་ངང་དུ་བཞག་པ་ཉིད་དོ།",
    "སྒོ་གསུམ་རྩོལ་མེད་དུ་གྲོལ་བས་ཁོ་བོ་གང་ན་འདུག་པའི་དོན་མཐོང་ངམ་སྟེ་ས་ནི་སྐལ་བ་དམན་པས་སུས་ཀྱང་མི་མཐོང་ཁོ་བོ་གང་ན་འདུག་བཅོ་ལྔ་པ་ཀློང་གྱུར་རྟོགས་པའི་རྩལ་ཆེན་བསྟན་པ།",
    "དེ་ལྟར་བཞག་དུས་གཏད་མེད་ཡུལ་ལ་ངེས་མེད་ཀྱི་སྣང་བ་ཤར།",
    "ཕྱིས་དེ་ཡང་རང་བཞིན་མེད་པར་རྟོགས་པ་ལྷག་མཐོང་སྟེ་དགོངས་པ་ངེས་འབྲེལ་ལས།",
    "གནས་དབེན་པའི་ཕྱོགས་སུ་བདེ་བའི་སྟན་ལ་རབ་ཏུ་འདུག་ནས།",
    "དང་པོ་སེམས་དང་སེམས་བྱུང་རང་ངོ་བརྟགས་པ་།",
    "ཐ་མ་གར་འགྲོ་དབྱིབས་དང་ཁ་དོག་ཅི་ལྟ་བུ་འདུག་སྙམ་དུ་སྐད་ཅིག་ཀྱང་མ་ཡེངས་པར་བརྟགས་ཤིང་དཔྱད་པའི་ཚེ་འདི་ལྟར་ཡུལ་ཤེས་གཉིས་ཀ་ངོ་བོ་མེད་པར་མཐོང་བར་འགྱུར་ཏེདཀོན་བརྩེགས་ལས།",
    "དང་པོ་འདོད་སེམས་རྩེ་གཅིག་ཏུ་འཇོག་དུས་བསམ་གཏན་དང་པོའི་ཉེར་བསྡོགས་མི་ལྕོགས་ནའ་བས།",
    "གང་དག་ཁྱིམ་གྱི་ནང་ན་འདུག་བཞིན་དུ།",
    "དེའང་གཤིས་ལ་སེམས་འདིའི་རང་བཞིན་གང་ནས་ཀྱང་མ་འོངས་ཏིམིམི་འགྲོ་མི་གནས་པའི་རང་ལུགས་ཕྱམ་ཕྱལ་ལེ་བ་ཞིག་དུས་རྒྱུན་ཡོད་དེ།",
    "རྣལ་འབྱོར་པས་ནི་འཕྲོས་སམ་གནས་ཀྱང་རང་བབས་བཅོས་བསླད་མེད་པའི་ཞི་ལྷག་ཤེས་པར་གྲོལ་བ་ཡིན་ནོ།",
    "འགྲོ་དྲུག་གནས་སུ་རང་རང་སྟོན་པར་སྣང་།",
    "ཕྱོགས་ངན་བདུད་གཅོད་སོགས་སྤར་སྨེ་གཟའ་སྐར་ལོ་ཟླ་ཞག་དུས་ཀྱི་ཉེས་པ་དང་ལྷ་འདྲེས་མི་ཚུགས་ཤིང་།",
    "གཟུགས་ཁ་དོག་དངོས་པོ་ཅིར་འདུག་ལྟོས།",
    "ཕྱི་སྣང་བ་སྣ་ཚོགས་མཐོང་ཙ་ན།",
    "སྙན་མི་སྙན་གྱི་སྒྲ་སྐད་ཐོས་ཙ་ན།",
    "བློ་སྤ་སྤོ་མང་པོ་འཆིང་བའི་རྒྱུ་ ཡིན་སྙམ་གྱི་སྒོམ་གྱིས་བསླུ་ཉན་གདའ།",
    "བཅོས་མ་ཡི་སྤྱོད་པས་འཆིང་ཉན་གདའ།",
    "ཨོཾ་ཨཱབཛྲ་མ་ཧཱ་གུ་རུ་ཨ་ཛི་ཏ་བི་ཛ་ཡ་ཨ་ར་པ་ཙ་ན་དྷཱི",
    "བཅས་དང་རང་བཞིན་ཉམས་པའི་སྡིག་ཀུན་བཤགས།",
    "བཅས་དང་རང་བཞིན་ཉམས་པའི་སྡིག་ལྟུང་ཀུན།",
    "མི་དམིགས་པ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་རྣམ་པ་ཉིད་ཡིན་པས་དངོས་པོའི་ཡུལ་ཅན་ལས་འདས་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་རང་རིག་པས་གྲུབ་པའི་ཕྱིར།",
    "དམིགས་པར་བྱ་བ་ཡང་རང་རང་ལ་ངེས་པ་ཡིན་པའི་ཕྱིར་ན།",
    "གལ་ཏེ་བྱ་བའམ་རྗོརྣམ་པར་རྟོག་པའི་ཕྱི་རོལ་རྟོགས་པར་བྱེད་པ་ཡང་རང་རྒྱུད་ཁོ་ན་ཡིན་ཏེ།",
    "འབྱེལ་པ་དང་མ་འབྱེལ་པ་བརྗོད་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་བརྗོད་པ་ནི།",
    "འོ་ན་ཕྱི་རོལ་ན་འདུག་པ་མཐོང་བ་ཡིན་ནོ་སྙམ་ན།",
    "ཅི་སྟེ་ཡང་རང་བཞིན་གང་ཞིག་རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་རང་བཞིན་དེ་ནི་ཐ་དད་པའམ་ཐ་མི་དད་པ་ཡིན་ཡང་སླ་སྟེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཅི་ལྟར་ཐ་དད་ཅེ་ན།",
    "འོན་ཏེ་ཡང་ཤེས་པ་བཞིན་དུ་དེ་མེད་པར་ཡང་རང་ཉིད་ལས་འགྲུབ་པ་དེས་ན།",
    "ཐུག་པ་མེད་པ་མ་ཡིན་ན་དེ་ལྟ་ན་དོན་མེད་པ་ཡང་རང་ལས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཤེས་པ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པ་མ་ཡིན་པས་ན་ཐུག་པ་མེད་པ་ཁོ་ནའོ།",
    "ཅི་སྟེ་ཡང་མངོན་སུམ་གྱི་ཡུལ་དང་རང་བཞིན་ཡུལ་གཅིག་ཉིད་དུ་རྣམ་པར་རྟོག་པས་ཞེན་པར་བྱེད།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་དང་འབྱེལ་པའི་ཕྱིར་གོ་བར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "སྐད་ཅིག་སོ་སོར་མི་འཇིག་ན་མཐའི་སྐད་ཅིག་ལ་ཡང་རང་བཞིན་དེ་ཉིད་ཡིན་ཏེ།",
    "ཀྱེསྒོག་ཏུ་གྱུར་པ་ལ་འཇུག་ཀྱང་རང་བཞིན་དངོས་སུ་མེད་པ་ཁོ་ནའོ་རྔོ་སྙམ་ན།",
    "འོན་ཀྱང་འདུག་བཞིན་དུའོ།",
    "འདིར་ཡང་རང་རྔོབཞིན་དུ་འགྱུར་རོ་སྙམ་ན་སྣ་ཚོགས་པ་ནི་འདིར་ཞེས་བྱ་བའོ།",
    "གཞན་ཡང་རང་རིག་པ་ཡིན་ན་ནི་ཤེས་པ་གཞན་རིག་པ་ལ་དགོས་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་བདག་དེ་ཡང་རང་རིག་པའམ་གཞན་རིག་པར་འགྱུར་ཞེས་པའི་བརྒལ་ཞིང་བརྟག་པ་འདི་ཉིད་ལས་འཕར་བ་མ་ཡིན་ནོ།",
    "གཞན་ལ་ཕྱོགས་པས་ཀྱང་རང་བཞིན་གཞན་ཁོ་ན་རིག་པ་དེས་ནའོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་རྣམས་འབྱེལ་པ་སྟེ།",
    "འུདིས་ནི་ཡིད་ཀྱི་མངོན་སུམ་དང་རང་རིག་པ་ཡང་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་རང་རིག་པ་ལ་སོགས་པའོ།",
    "འདོད་ཆགས་དང་འདོད་ཆགས་མེད་པ་དག་དུས་གཅིག་ཏུ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་དུས་མཚུངས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "བློས་ཅི་བྱ་དེས་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་དགོངས་པའོ།",
    "དེའི་ཚེ་ངེས་པ་ཡང་རང་ཉིད་ནུས་པ་མེད་པར་ཇི་ལྟར་བྱེད།",
    "གཞན་ལ་ཡང་རང་བཞིན་དུ་གྱུར་པའི་ཉམས་སུ་པྱོང་བའི་ངོ་བོ་ཡོད་ན་དེའི་གཞན་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པ་མཐའ་ཡས་དག་འཆད་པ་ནི་སོ་ན་འདུག་གོ་ཞེ་ན།",
    "གསལ་བ་ཡང་རང་ལས་འགྱུར་བ་ཉིད་དེ་ལྟར་ན་མཐོང་བ་ནི་རང་ཉིད་ཁོ་ན་གསལ་བར་ཁས་ལེན་པ་དེ་བཞིན་དུ་གསལ་བར་བྱེད་པ་ཐ་དད་པས་ཅི་ཞིག་བྱ་ཞེས་དགོངས་པའོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་རིག་པར་བྱ་བའི་དོན་ཏོ།",
    "གཉིས་ཀའི་རང་བཞིན་ཞེས་བྱ་བ་ནི་རྫས་དང་རང་རིག་པའི་རང་བཞིན་ནོ།",
    "གལ་ཏེ་ཡུལ་ཐ་དད་པས་གཅིག་མ་ཡིན་ན་དེའི་ཚེ་བདག་ཀྱང་རིག་པར་བྱེད་པ་དག་ཀྱང་རང་བཞིན་ཐ་དད་པས་ན་ཇི་ལྟར་གཅིག་ཡིན།",
    "དེ་ལས་ཞེས་བྱ་བ་དང་རང་བཞིན་ལས་ཐ་དད་པར་མི་མཐོང་བའི་ཕྱིར་དུཐ་དད་པར་མ་གྲུབ་པོ་ཞེ་ན།",
    "གལ་ཏེ་ཇི་ལྟར་བློ་རང་རིག་པས་གྲུབ་པར་ཁས་བླངས་ནས་དོན་ཡོངས་སུ་འདོར་བ་དེ་བཞིན་དུ་དོན་ཡང་རང་རིག་པར་ཁས་བླངས་ནས་བློ་དོར་བར་བྱའོ་སྙམ་ན།",
    "དེའི་ཞེས་བྱ་བ་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ལ་ནི་ཇི་ལྟར་ཐ་དད་པར་མཐོང་རང་བཞིན་དེ་ཉིད་ནི་གཞན་དུ་འགྱུར་བ་མ་ཡིན།",
    "འོན་ཀྱང་གང་ལ་ཡང་རང་རིག་པ་ཡོད་པ་དེ་ལ་ནི།",
    "འོན་ཀྱང་རང་རིག་པ་ལའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཉིད་དེ་རིང་ན་འདུག་པའི་དངོས་པོ་ཉིད་གསལ་བའི་ཕྱིར་ཐག་རིང་པོ་མ་ཡིན་ནོ་ཞེས་རྗོད་བུཔར་བྱེད་དེ།",
    "རྣམ་པ་དང་བཅས་པ་ན་ཡང་རང་རིག་པ་ཁོ་ནའོ།",
    "པེ་འར་ངྐདོན་ཡོངས་སུ་འདོར་བ་དེ་བཞིན་དུ་དོན་ཡང་རང་རིག་པས་ཁས་བླངས་ནས།",
    "འབྲས་བུའི་གནས་སྐབས་ཀྱང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའི་དབྱེ་བས་རྣམ་པ་གཉིས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་ཚིག་རྣམས་ཀྱིའོ་ཞེས་དེ་ལྟར་དྲན་པའི་སྐྱེས་བུ་ནི་ངེས་པར་སྦྱར་བར་བྱ་བ་ནི་མངོན་དུ་ཕྱོགས་པ་ལ་འདུག་པ་ཞེས་སྦྱར་རོ།",
    "སྔར་དམིགས་པའི་དུ་བ་དང་རང་བཞིན་མཚུངས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངེས་པར་བརྗོད་པར་འདོད་པ་གང་ཡང་རང་ཁོ་ནས་ཞེས་ངེས་པར་བཟུང་བ་མ་ཡིན་གྱིས་འོན་ཀྱང་མཐོང་བ་ཁོ་ནའོ་ཞེས་སོ།",
    "གཞན་གང་རང་བཞིན་གཞན་གྱིས་སྟོང་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཧཱུཾགཏན་ཚིགས་མ་ངེས་པ་ཉིད་དུ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པ་ཞེས་བྱ་བ་ནི་མདུན་ན་འདུག་པའི་རྣམ་པ་ཅན་ལས་རྣམ་པ་ཅན་གཞན་པའོ།",
    "གལ་ཏེ་མདུན་ན་འདུག་པ་རྣམ་པ་དང་ལྡན་པ་རྣམ་པ་བཟུང་བ་ན་རྣམ་པ་དང་ལྡན་པ་གཞན་གྱིས་འཛིན་ན་དེའི་ཚེ་རྣམ་པ་དང་ལྡན་པ་གཞན་ལ་གནས་པའི་རྣམ་པ་ཡང་མ་ཀླུབཟུང་བར་འགྱུར་རོ།",
    "གཞན་གྱི་རྟོགས་པ་ཡང་རང་ལ་གྲུབ་པའི་རྟགས་ཀྱིས་རྗེས་སུ་འབྲང་བ་ཁོ་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་གྱི་ཐག་རིང་ན་འདུག་པ་ཞེས་སྨྲས་སོ།",
    "གལ་ཏེ་བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་ཡང་རང་ཉིད་སྨོས་པས་སྟོན་པ་ཡིན་ན།",
    "དེས་ན་རྟོག་པ་སྔོན་དུ་བྱེད་པ་མ་ཡིན་པར་འཇུག་པའི་དོན་དུ་ཡང་རང་ཉིད་སྨོས་པ་དོན་མེད་དོ།",
    "དེའི་ཕྱིར་རྟོག་པ་གཉི་ག་ལ་ལྟོས་ནས་ཀྱང་རང་ཉིད་སྨོས་པ་དོན་མེད་པ་ཁོ་ནའོ།",
    "དེ་བཞིན་དུ་འདི་ཡང་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདོད་པའི་སྒྲས་ཀྱྀབརྗོད་པར་བྱ་བ་འདི་ཡང་རང་རིག་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པར་བྱ་བའི་རུང་བ་ཉིད་དེ་ལས་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ་དེ་བས་ན།",
    "གལ་ཏེ་ཐམས་ཅད་ཀྱི་ཚེ་སྤྱི་ཁྱད་པར་ཉིད་ཡིན་ན་དེའི་ཚེ་གོང་བུ་རྒྱང་རིང་པོ་ན་འདུག་ཀྱང་།",
    "དེ་ལྟ་ཡིན་དང་སྲང་དམའ་བའི་ཁྱད་པར་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་བྱཉེས་པ་སོ་ན་འདུག་གོ།",
    "འདིས་ནི་འདུག་པར་ཡང་མི་བྱ་འགྲོ་བར་ཡང་མི་བྱ་ཞེས་བྱ་བའི་ཚུལ་བསྟན་པ་ཡིན་ནོ།",
    "བླ་འོག་ཏུ་ཞེས་བྱ་བ་སྟེ་དངོས་པོ་མེད་པ་འོག་ཏུ་གནས་པའི་སྟེང་ན་དངོས་པོ་འདུག་པར་རྟོགས་པ་ནི་མེད་དོ།",
    "གསལ་བའི་རང་བཞིན་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པ་དག་ཏུ་སྣང་བའི་ཕྱིར་སྤྱི་དང་རང་བཞིན་གཉི་ག་ཡིན་ནོ་ཞེས་དོགས་པ་ནི།",
    "དེའི་འོག་ཏུ་ཡང་རང་བཞིན་གཉིས་པའི་སྤྱི་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་འོ་ན་སྤྱི་དེ་ཡང་རང་བཞིན་གཉིས་པ་ཡིན་པའི་ཕྱིར་དེ་ལ་ཡང་སྤྱི་གཞན་འཕྱོ་བར་འགྱུར་རོ།",
    "འོན་ཀྱང་རང་བཞིན་ཁོ་ནས་ཁྱབ་པ་ཡིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་གཞན་ཡིན་པ་ནི་སྒྲའི་རང་བཞིན་གཞན་ཡིན་པའོ།",
    "འབྱུང་ཁུངས་མ་ཡིན་ནོ་ཞེས་ཟུར་ན་འདུག་པའི་རྩོད་པ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་སྒྲོ་བཏགས་པ་མི་བདེན་ཡང་རང་བཞིན་མེད་པར་སྒྲའི་དོན་ཅི་ལྟར་ཡིན་ཏེ།",
    "མེ་ལ་སོགས་པའི་ཚོགས་པ་དུ་བ་སྐྱེད་རྒྱཔར་བྱེད་པ་གང་ཡིན་པ་རྔུ་དེའི་དུ་བ་སྐྱེད་པའི་རང་བཞིན་དེ་ཉིད་གལ་ཏེ་འཁྲུལ་པའི་ཡུལ་དུ་འདོད་པ་གཞན་གྱིས་ཇེཡང་རང་བཞིན་ཡིན་ན།",
    "རྟགས་དུ་བ་ལས་རྟོགས་པ་ཡང་རང་བཞིན་དེ་ཉིད་ཀྱིས་ཡིན་ཏེ།",
    "གྲུབ་པའི་མི་དམིགས་པ་དེས་ཀྱང་རང་ཉིད་ཙམ་གྱི་བྱེའཇུག་པ་གང་ལ་ཡོད་པ་སྟེ་དེ་དག་ཤྱིདགག་པར་བྱ་བ་མེད་པའི་རྣམ་པར་གཞག་རྔུཔ་དེའི་གོ་བྱེད་དེ་འཇུག་པ་ཡིན་ནོ།",
    "ཤེས་པ་ནི་རང་ཉིད་ཀྱིས་འགྲུབ་པས་ན་དེ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པའི་ཕྱིར་ཐུག་པ་མེད་པ་མ་ཡིན་ནོ།",
    "དངོས་པོ་མེད་པ་ནི་ནམ་ཡང་རང་ལས་འགྲུབ་པ་མི་སྲིད་པས་ན་ཐུག་པ་མེད་པ་ཁོ་ནའོ་ཞེས་ལན་བརྗོད་པ་ནི་དེ་ནི་ཞེས་བྱ་བའོ།",
    "རིག་པ་མི་དམིགས་པ་ནི་གསལ་བར་ཡང་རང་བཞིན་མི་དམིགས་པར་འཆད་དེ་དང་སྐྱེངོ།",
    "འབྲས་བུ་དང་རང་བཞིན་འབའ་ཞིག་ཏུ་ནི་མ་ཟད་ཀྱི་རྒྱུ་དང་ཁྱབ་བྱེད་མི་དམིགས་པར་ཡང་ངོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་རང་བཞིན་མི་དམིགས་པ་ལས་རང་བཞིན་འགལ་བ་དམིགས་པ་ཅི་ལྟར་གཞན་མ་ཡིན་ཞེ་ན།",
    "འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཡང་རང་བཞིན་མི་དམིགས་པ་ལས་གཞན་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི་འགལ་བའི་ཞེས་བྱ་བའོ།",
    "ཁྱབ་བྱ་གང་ཡིན་པ་དེ་སྦྱར་བ་གང་ཡིན་པ་དེར་ནི་སྟེ་༧འགལ་བའི་འབྲས་བུ་དང་ཁྱབ་བྱ་དམིགས་པར་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་དག་ཀྱང་འདུ་བའི་ཕྱིར་རོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་འབྲས་བུ་དང་རང་བཞིན་དག་མི་དམིགས་པར་འདུ་བ་ནིའོ།",
    "གལ་ཏེ་འབྲས་བུ་དང་རང་བཞིན་དག་གཞན་ཀྱིས་མི་དམིགས་པའི་ནང་དུ་འདུ་བར་བརྗོད་པ་མ་ཡིན་ནམ།",
    "འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཞེས་བརྗོད་པ་ཙམ་གྱིས་ནི་འབྲས་བུ་དང་རང་བཞིན་བྱི་གཏན་ཚིགས་མི་དམིགས་པའི་མཚན་ཉིད་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "༡༥༣༢པེ་སྣར་དང་རང་བཞིན།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་ལ་གོང་འོག་འཆོལ་འདུག་པས་ཀ་ཁའི་རྟགས་བརྒྱབ་ནས་བསྒྲིགས་ཡོད།",
    "གོ་མ་ཆོད་འདུག་ཅེས་བཀའ་བཀྱོན་གནང་བའི་གོང་མའི་ཡི་གེ་བབ་པར།",
    "ད་ལོ་དབྱར་ཁ་ངེད་གཉིས་ཟི་ལིང་མཁར་དུ་ཐུག་དུས།",
    "འཆར་སྒོ་མྱུར་ཞིང་རྩོམ་འོང་བ་ལ་ཧ་ལས་དགོས་པའི་ཚོད་དུ་གདའ།",
    "བཤན་པའི་མདུན་གྱི་ར་ལུག་བཞིན་ཐར་ཐབས་ཡོད་མེད་ཙམ་ཡང་འདང་མི་རྒྱག་པར་འཐོམས་སེ་འདུག་པ་ནི།",
    "ཞེང་དུ་གཞུ་འདོམ་སུམ་ཅུ་ཙམ་དང་དྲུག་དུས་གཞུ་འདོམ་བཞི་བཅུའི་ཡན་ཆད་སླེབ་ཅིང་།",
    "ཟབས་སུ་ཁྲུ་གསུམ་བཞི་ཙམ་དང་དྲུག་དུས་འདོམ་གཉིས་ལྷག་སླེབ།",
    "དེའི་ནང་ཤིན་ཏུ་ཡངས་པའི་ཚོད་དུ་གདའ།",
    "བོན་དར་ཡོད་ཚོད་འདུག་ལྷག་པར་དཔའ་རིས་ཕྱོགས་འདིར།",
    "ངེད་ཅག་བོན་གྱི་བསྟན་པ་མུན་ནག་བཞིན་དུ་གཏོང་བའི་སྔ་ལྟས་བྱུང་འདུག་ཟེར།",
    "བཀྲ་ཤིས་རྟགས་མཚན་གྱི་རྣམ་པར་ཆགས་འདུག་གོ།",
    "གོ་མ་ཆོད་འདུག་ཅེས་བཀའ་བཀྱོན་གནང་བའི་གོང་མའི་ཡི་གེ་བབ་པར།",
    "དེ་ཕྱག་ན་ག་འདྲ་ཞིག་འདུག་གསུངས་པར།",
    "ང་དེའི་སྡིག་ཙ་འཕར་བ་ལ་སེམས་གཡེངས་ནས་ཁས་བླངས་ཚར་འདུག་པས།",
    "ང་རང་སྟོན་ཟླ་འབྲིང་བོའི་ཚེས་མགོར་འདི་ནས་ཐོན་པར་བྱེད་གསུངས།",
    "རྗེས་ཕོད་ག་འདྲ་ཡོང་ཞེས་གསུངས་ཀྱང་སྣང་དག་བཏང་མི་འདུག་དེ་སྐབས་ལོ་མཇུག་བར་དུ་བཞུགས་ནས་ཨ་ལག་ཤར་ཕེབས་སྐབས།",
    "ཁོ་འདི་ན་ཟླ་བ་གསུམ་ཙམ་འདུག་རྒྱུ་ཡིན།",
