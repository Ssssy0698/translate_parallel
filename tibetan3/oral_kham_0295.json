    "བོད་ཟླ་༡༡ ཚེས་༢༥ ཉིན་རྒྱན་འཇུག་དུས་བཟང་།",
    "འདི་ལྟར་ཡིན་གསུང་མཁན་ཡང་འདུག་",
    "ངེས་པར་ཞག་དེ་ཡི་ནང་དུ་ཁོ་རང་ཡུལ་གཞན་དུ་བྲོས་སམ།",
    "རྒྱལ་པོས་ལན་གསུམ་གྱི་བར་དུ་བསྐུལ་ཀྱང་ཐམས་ཅད་དཔའ་ཞུམ་ཞིང་ཡིད་ཁོངས་དུ་ཆུད་དེ་གདོང་སྨད་ཞིང་འདུག་པ་ན།",
    "མུ་སྟེགས་པ་རྣམས་གང་དུ་འདུག་པ་དང་།",
    "རྟེན་གྱི་སྟེང་དུ་ཟན་ཁུག་དང་གོས་ཧྲུལ་བཞག་པ་སོགས་བྱུང་འདུག།",
    "ལྷ་ཁང་དུ་བཞག་པའི་ཡོ་བྱད་རྣམས་ཕྱིར་བཏོན་ཏེ་སྒོ་ལྕགས་ཀྱིས་བསྡམས་ནས་དེར་འདུག་ཏུ་མ་གཞུག།",
    "ལག་པ་གཉིས་ཀྱིས་གཙུག་ལག་ཁང་ལ་འཁྱུད་འདུག།",
    "མེའི་གནོད་པ་བསྲུང་བ་ཡིན་ཟེར་བ་ཞིག་རྨིས་འདུག།",
    "གཞན་ཡང་ཡུལ་གྲུ་དུ་མར་བྱུང་འདུག་པ་རྣམས་དང་ཆ་མཐུན་པ།",
    "འབྲས་སྤུངས་གླིང་བསྲེ་བྱས་པར་ཁྱད་མེད་ཅིག་དགོས་རྒྱུར་འདུག་ཀྱང་།",
    "ཁས་བླངས་ཐོག་ཏུ་ཁེལ་བ་མི་གདའ་འོ།",
    "ཁྱད་ཨེ་འདུག་ཀུན་སློང་སེམས་ལ་དྲིས།",
    "མཐའ་དབུས་ཀྱི་སྐྱེ་རྒུ་དྲག་གཞན་རང་རང་སོ་སོའི་འཁོས་འབྱོར་ལ་གཞིགས་པའི་གསོལ་ཇ།",
    "ས་སྐྱ་དང་རྙིང་མ་བཅས་ལྷན་དུ་ཚོགས་ཀྱང་ཕྱིས་སུ་ས་སྐྱ་དང་རྙིང་མ་ཕེབས་ཀྱི་མི་འདུག།",
    "ཤེས་ལྡན་དག་བདག་ཅག་འབའ་ཞིག་ལ་འདུག་པ་དང་།",
    "ཤེས་ལྡན་དག་བདག་ཅག་འབའ་ཞིག་ལ་འདུག་པ་དང་།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་རྣམས་ཀྱིས་དེང་ཕྱིན་ཆད་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་རྣམས་ཀྱིས་དེང་ཕྱིན་ཆད་འདུག་པ་དང་།",
    "འདུག་པ་ནི་རྣལ་འབྱོར་ཏེ།",
    "དཔའ་བོ་འཇའ་མཚོན་མ་དང་རང་བྱོན་ལ་སོགས་པའི་རྟེན་ངོ་མཚར་ཅན་དུ་མ་བྱོན་ཞིང་རབ་ཏུ་གནས་པའི་སྐབས་ཀྱང་ལྟས་ངོ་མཚར་ཅན་ཡང་མང་དུ་བྱུང་བ་དང་།",
    "དེ་ཉིན་བཀའ་བློན་མན་ནས་ལས་དཀྱུས་ཤོད་སྐོར་དཔོན་རིགས་རྣམས་ཀྱང་མཆོད་མཇལ་དང་འབྲེལ་ཞོལ་ནས་ཁང་སྟེང་རང་རང་གདན་ཐོབ་ཀྱི་གྲལ་ལ་འཁོད་པ་ཇ་དང་འབྲས་བསིལ་གཏོང་།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷིཞེས་ཕྱག་བརྡབས་ནས།",
    "འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་དང་།",
    "ཡེ་ཤེས་པ་ཕབ་དུས་སམ་ཀྲི་ཏའི་སྐད་ཐོགས་མེད་དུ་བྱུང་ཞེས་ཁ་ཆེ་པཎ་ཆེན་གསང་འདུས་ལ་མཁས་པའི་བག་ཆགས་སད་པར་འདུག་གསུང་།",
    "ཇུན་གར་དམག་དུས་དེ་མར་རྗེ་ཙོང་ཁ་པའི་སྐུ་བཞེངས་པས་སྐྱོན་ཆ་བྱུང་མེད་ཅེས་གསུང་།",
    "གནས་པའི་ཡུལ་འདི་སྨོན་དགོས་པ་ཞིག་འདུག་ཅེས་གསུངས་པས་སྨོན་ཞེས་པའི་མིང་དེ་ལྟར་བྱུང་།",
    "འདི་ཡང་བཀའ་གདམ་པ་གོང་མ་རྣམས་ཀྱི་མཛད་སྒོ་ཞིག་ཡིན་འདུག་གོ།",
    "རྒྱན་འཇུག་དུས་བཟང་།",
    "ཇི་ལྟར་ཡིན་ཞུས་པར་ད་ལྟ་དྲན་གྱི་མི་འདུག་གསུངས།",
    "ཞིག་ལ་ཕྲན་བཀའ་འགུགས་གནང་བར་མདངས་དགོང་རྨི་ལམ་དུང་དགའ་ལྡན་དུ་སླེབ་འདུག།",
    "དེའི་རིང་རང་ཉིད་དབུ་ཞྭ་བཞེས།",
    "ཀུན་ཏུ་ཞུམ་པོར་བྱས་ནས་བསྐུམ་ཞིང་བསྐུམས་ནས་འདུག་ན།",
    "དབྱར་གྱི་དུས་སུ་འགྲོ་འདུག་མང་པོ་བྱེད་པ་སྤངས་ཏེ།",
    "དེའི་མདུན་དུ་འདུག་སྟེ།",
    "ཚུལ་དང་མཐུན་པར་ཙོག་པུར་འདུག་སྟེ།",
    "རྒྱན་འཇུག་དུས་བཟང་།",
    "མཇལ་དར་ཡང་རང་གནས་སུ་གདན་དར་མཚོན་བྱེད་དུ་འཇོག་ཅིང་།",
    "རང་རང་འཁོར་འདུལ་སྒོ་བཞི་བསྲུང་།",
    "སྔོན་གྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཕྱག་ལེན་ཡང་ཡིན་ཞིང་རང་ཉིད་ཀྱང་དམ་པ་གོང་མ་དེ་རྣམས་ཀྱི་མཛད་སྤྱོད་བཟང་པོ་སྨོན་པའི་ཡུལ་དུ་བྱས་ནས། དབྱར་གནས་པ་ཞལ་གྱི་བཞེས་པའི་",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ང་རང་བུ་བཟང་།",
    "ཁོ་རང་སྐྱོན་ཆེ་ཟེར་བ་ཡང་མཚང་དུ་མི་བརྩི་བ།",
    "སྐྲ་དཀར་གཉེར་མ་ལྷག་དུས་སུའང་།",
    "ང་ཐོས་དུས་ཙ་ན་བསམ་སྒོམ་བདེ།",
    "ང་བསམ་དུས་ཙ་ན་ཐོས་སྒོམ་བདེ།",
    "ང་སྒོམ་དུས་ཙ་ན་ཐོས་བསམ་བདེ།",
    "དེང་སང་ཁ་བྱང་ལག་བྱང་འགྲོ་བ་ནི་ངེས་པར་གལ་བོ་ཆེར་འདུག་ལགས།",
    "རྩོད་པ་ལ་ཧུར་འདོན་མི་བྱེད་པ་སྐོར་ཅིག་འདུག་སྟེ་ཡང་ཡང་དམིགས་བསལ་དང་རྒྱལ་ཁ་སྟེར་མི་ཤེས་པས།",
    "ཞེས་གསུངས་འདུག།",
    "དབུ་ཚད་གཉིས་ན་ལྟ་བ་ཇི་ལྟར་བསྐྱེད་ཚུལ་ཤེས་རབ་ཀྱི་བསླབ་པ་སྟོན་པ་ཡིན་ཙ་ན།",
    "ཡང་འདི་ན་སྟོན་པའི་ན་བཟའ་གྱོན་ཏེ་བྲེ་ལོག་རྒྱ་ལོག་ཁེ་དང་ཕན་ཚུན་ཚོང་བྱེད་མཁན་ཇི་སྙེད་འདུག་པ།",
    "ཁྱེད་ཚོ་ལ་སྐལ་བ་ཤིན་ཏུ་ཆེ་འདུག་སྟེ།",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "འཁྲུལ་བ་མཁས་པ་ལའང་སྲིད་ཟེར་ཙ་ན།",
    "དེ་འདྲའི་མཐོང་ཐོས་དོགས་གསུམ་གྱི་རིགས་གང་ན་ཡོད་ཀྱང་འདུག་པ་མེད་པ་སྨོས་ཅི་དགོས།",
    "ཟླ་༦ཚེས་༢༥ ལ་རྒྱན་འཇུག་དུས་བཟང་།",
    "རྡོ་དྲིལ་སོགས་ལྷའི་ངོ་བོ་བསྐྱེད་དེ་རྟེན་གསུམ་དང་ཁྱད་མེད་པས་གུས་པར་བྱས་ནས་མདུན་དུ་དྲིལ་གདན་གྱི་སྟེང་དུ་བཞག་ནས་ཡར་ལངས་མར་འདུག་སྐབས་སུ་ཡང་འགོམས་གཡུགས་དང་།",
    "དབྱངས་ཀྱི་ང་རོ་དང་བཅས་ན་ཤིན་ཏུ་དགྱེས་པར་འདུག་པས་འདི་བཞིན་བྱེད་པ་ཡིན་གསུངས་ནས།",
    "དེ་ནས་དབྱངས་སྦྱངས་བ་རྣམས་ལའང་འདིའི་གཏོར་མ་མ་བཤམས་པར་དབྱངས་བྱ་མི་རུང་བར་འདུག་པས་མ་བྱེད་གསུངས།",
    "གཏོར་མ་བྱས་ནས་དབྱངས་ཀྱི་ང་རོ་བྱས་པའི་ཚེ་དགའ་བའི་རྣམ་འགྱུར་སྣ་ཚོགས་བྱེད་པར་འདུག་ཅེས་བཀའ་སྩལ་ཏོ།",
    "སྔོན་གྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཕྱག་ལེན་ཡང་ཡིན་ཞིང་རང་ཉིད་ཀྱང་དམ་པ་གོང་མ་དེ་རྣམས་ཀྱི་མཛད་སྤྱོད་བཟང་པོ་སྨོན་པའི་ཡུལ་དུ་བྱས་ནས། དབྱར་གནས་པ་ཞལ་གྱིས་བཞེས་པའི་",
    "སྔོན་གྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཕྱག་ལེན་ཡང་ཡིན་ཞིང་རང་ཉིད་ཀྱང་དམ་པ་གོང་མ་དེ་རྣམས་ཀྱི་མཛད་སྤྱོད་བཟང་པོ་སྨོན་པའི་ཡུལ་དུ་བྱས་ནས།",
    "རྒྱན་འཇུག་དུས་བཟང་།",
    "ཚེས་༢༥ ཉིན་རྒྱན་འཇུག་དུས་བཟང་།",
    "དེ་ནས་ལུས་ཙོག་པུར་འདུག་སྟེ།",
    "མཇལ་དར་ཀྱང་རང་གནས་སུ་གདན་དར་མཚོན་བྱེད་དུ་འཇོག་ཅིང་།",
    "དེའི་སྔ་དྲོ་ཆུ་ཚོད་བརྒལ་བ་འདུ་འཛོམས་ཀྱིས་རང་རང་བློ་ནུས་དང་བསྟན་པའི་ཕྱག་མཆོད་བགྱིསགཉིས་པ་ཙམ་ལ་མང་ཇ་ཚོགས་ཏེ།",
    "ས་དམ་གྱི་ཡུལ་ཡིན་ཟེར་མཁན་ཀྱང་འདུག།",
    "དེའི་རྟེན་གཙོར་ཇོ་བོ་མཐོང་གྲོལ་ཆེན་པོ་ཡིན་པའི་ངག་རྒྱུན་ཞིག་ཀྱང་འདུག།",
    "ཆད་ལས་བྱུང་བ་ཡིན་ཟེར་སྲོལ་འདུག།",
    "དམིགས་གསལ་སྦྱིན་བདག་ཡོད་ཚེ་ཐུག་པ་བག་རིལ་ཁུར་ཚུར་ཙམ་དེ་འདྲ་གཏོང་སྲོལ་ཡོད།",
    "རྒྱན་འཇུག་དུས་བཟང་།",
    "དེ་བྱིངས་རྣམས་རང་རང་བློ་འཛིན་ཡོད་རིགས་རྣམས་སྐྱོར།",
    "འོན་ཀྱང་རང་རང་སོ་སོའི་བློ་འཛིན་ཇི་ཡོད་རིགས་སྐྱོར་ནས་མཚན་སྐྱོར་གནང་མཁན་ཡང་ཆེས་མང་པོ་ཡོད།",
    "དེ་ཉིན་གསོལ་ཇ་ཐེངས་བདུན་བཏང་དགོས་འདུག།",
    "རང་རང་ཞེ་འདོད་ཇི་བཞིན་འབྲེལ་མིན་གང་ལའང་སྔར་སྣང་ཕྱིར།",
    "བུམ་པའང་ཁོ་རང་འདྲེས་མེད་དང་།",
    "དེ་ལྟར་འཁྲུལ་དུས་ཉིད་ནའང་རང་བཞིན་བདེན་པར་གྲུབ་པ་མེད་དེཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོ་ལས།",
    "ཆར་ཡང་རང་བཞིན་ཐ་དད་དུ་འབབ་པ་ནས།",
    "འཇུག་པ་ལསབདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིརའདི་དག་རྟག་པ་མ་ཡིན་ཆད་མ་ཡིན།",
    "དོན་དམ་པར་དེ་གཉིས་ཀའང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ནམ་མཁའ་ལྟ་བུའི་ངང་ལས་གཞན་དུ་གྲུབ་པ་མེད་པར་འདོད་དོ།",
    "སྤྱོད་འཇུག་ལསསྐྱིལ་ཀྲུང་འདུག་དང་རྒྱབ་མི་བསྟན།",
    "བདེན་པ་གཉིས་ཆར་དུའང་རང་བཞིན་ཡོད་མིན་པསའདི་དག་རྟག་པ་མ་ཡིན་ཆད་མ་ཡིན།",
    "དེ་ཡང་རང་བཞིན་སྦྱངས་པ་ཡིས།",
    "ཁ་ཅིག་དུས་མཐའ་ཅིག་ཆར་བ།",
    "རང་རང་ཐབས་དང་ཤེས་རབ་མཆོག།",
    "འགྲོ་དང་འདུག་དང་ཉལ་བ་ན།",
    "ཞེས་ཡོངས་སུ་དག་པ་འབྲས་བུའི་འགྱུར་སྔ་དུས་ཀྱི་དབྱིངས་དང་རང་བཞིན་དུ་གནས་པའི་རིགས་ལ་ངོ་བོའི་ཆ་ནས་འགྱུར་བ་དང་བཟང་ངན་གྱི་ཁྱད་པར་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "དྲུག་པ་བཀྲི་བ་དང་ངེས་པའི་དོན་དུ་གསུངས་པའི་སྡོམ་པ་ཇི་སྙེད་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པའི་ཚུལ་དུ་འདུས་ཤིང་རྣམ་པར་དག་པ་ནི་གོང་དུ་བསྟན་པ་གསང་བསྟན་བཅོས་བཞིན་ནོ།",
    "ལུས་ཀྱི་ནི་ཕྱག་རྒྱ་དང་བྲོ་དང་གར་དང་ལྟ་སྟངས་དང་འདུག་ཚུལ་ལ་སོགས་པ་དང་།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "ཤིང་རྟ་ལ་སོགས་རྟ་ལ་འདུག་སྤྱོད་པ།",
    "གཞན་གྱི་ཡིན་ཏེ་མ་གནང་ཡང་རང་ཉིད་འཚོ་བའི་ཕྱིར་དུ་བརྐུ་བའི་སེམས་ཀྱིས་གཏན་དུ་འབྲལ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "བྲམ་ཟེ་སེར་སྐྱ་ཞི་བ་ཟེར་བ་མཁས་པ་ཞིག་འདུག་པ་དེ་བོས་ནས་དེ་དང་ལྷན་དུ་དྲི་ལན་གྱིས་བརྩད་ནས་དེ་ཕམ་པར་བྱས་པས།",
    "ཞེས་སྨྲས་ཏེ་ཁོ་རང་ཤི་བར་གྱུར།",
    "རྒྱལ་བྱེད་ཚལ་གྱི་སྒོ་ན་འཆག་ཅིང་འདུག་གོ།",
    "འདུན་པས་སེམས་ཁོང་དུ་ཆུད་དེ་འདུག་པ་ན་བར་སྐབས་མི་མང་པོ་དེར་འདུས་ཏེ་གར་བྱེད་པ་ན་སྒོ་བ་གཡེང་ནས་འདུན་པ་ནང་དུ་ཞུགས་ཏེ་སྤྱོད་ལམ་ཞི་བས་ཕྱིན་པ་ན་བྲམ་ཟེས་དེ་མཐོང་ནས་བཙུན་པ་འདུན་པ་བྱོན་པ་ལེ་གདན་འདིར་བཞུཊ་ཤིག་བྱས་དེའི་སྐབས་དེར་གཏམ་གྱི་གོ་སྐབས་མ་རྙེད་ནས་ཁོ་བོའི་ཕྱེ་ཉུང་ཤས་འདི་འཚག་ཏུ་ཆུག་ཅིག་སྨྲས་པས།",
    "དེ་དང་ཧ་ཅང་ཐག་མི་རིང་བ་ན་རྫིང་བུ་རྡོ་རྩིགས་ཅན་ཞེས་བྱ་བའི་འགྲམ་ན་ཉིན་ལ་འདུག་སྟེ།",
    "རྒྱ་མཚོའི་བྱིན་དང་བཞིར་བཅས་ལྷན་གཅིག་ཏུ་འདུག་གོ།",
    "སྟན་གཅིག་དུ་འདུག་སྣོད་གཅིག་ཏུ་ཟ།",
    "འདུ་ཤེས་མ་ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་ཞག་བཅུར་འཆང་འདོད་རྒྱུན་མ་ཆད་འཁྲུལ་བ།",
    "དེ་རྣམས་བམ་པོ་སྦྲེལ་ཏེ་གཉུག་མར་གནས་པ་ལ་བཅོལ་རང་རང་རྣམས་སྟོད་པོ་རྙེད་དེ།",
    "ཀུན་སློང་རང་དགར་བྲལ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་འཁྲུད་བ་འཚེད་པ་འཆག་པ་ཐམས་ཅད་དམ་གང་རུང་འཚོལ་བའི་ཚིག་སྨྲ་ཞིང་དོན་གོ་བར་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་གོས་སློང་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་ཟླ་ལ་སྦགས་པར་ཤེས་པ་རང་དགར་དངོས་སུ་ཕུལ་བའི་གོང་དུ་འབུལ་ལོང་མེད་པར་སྔ་ཚོམ་དུ་སློང་བར་འདོད་བ་རྒྱུན་མ་ཆད་བའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་བླང་བའམ་ནང་ཚན་ཅན་གྱི་སྟན་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉི་ཀྱི་དོན་དུ་བླང་བའི་སྟན་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་བལ་ཁུར་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་དགའ་བོ་བཏང་ནས་གཅེར་བུ་པ་དེ་ཁྲག་སྐྱགས་ནས་འཆི་བར་འདུག་པས་གོས་ཐར་སྦྱིན་གསུངས།",
    "ཀུན་སློང་རང་དགར་ཁེ་སྤོགས་འདོད་པས་རང་ཉིད་ཀྱི་དོན་དུ་སྐྱེད་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་སློང་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རྐུ་སེམས་དང་ཡིད་གཅུགས་བ་ཁྱད་པར་ཅན་ལས་གཞན་པའི་སྒོ་ནས་དྲན་པ་མ་བྱིན་པར་རང་དོན་དུ་འཐག་ཏུ་འཇུག་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཤེས་པ་ན་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་བསྟེན་པའི་སྐབས་སུ།",
    "ཀུན་སློང་རང་དགར་ཞག་དྲུག་ཏུ་བྲལ་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "ཀུན་སློང་རང་དགར་རྐུ་སེམས་ལས་གཞན་པའི་བདག་ཉིད་ལ་བསྒྱུར་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "ཀུན་སློང་རང་དགར་བསམ་པ་ཐག་པ་ནས་སྐྱོ་སྔོགས་བྱེད་པའི་ཚིག་སྨྲ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་ཚིག་ལྔའམ་དྲུག་ལས་ལྷག་པར་སྟོན་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "ཀུན་སློང་རང་དགར་བསྙེན་པར་མ་རྫོགས་པ་དང་ཅིག་ཅར་རམ།",
    "ཀུན་སློང་རང་དགར་བསྙེན་པར་མ་རྫོགས་པ་ལ་གཞན་གྱི་གནས་ངན་ལེན་བརྗོད་པའི་ཚིག་སྨྲ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་ས་བོན་ནམ་སྐྱེ་བ་ཉམས་པར་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་བསྒོ་བ་རྣར་གཟོན་གྱི་ཚིག་སྨྲ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "འདུག་པའམ་གཞན་དུ་འགྲོ་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "གསུམ་བ་སྦྱོར་བ་དེ་ལྟར་བཞག་ནས་དེ་ཉིད་དུ་འདུག་གམ་འགྲོ་བར་རྩོམ་པའོ།",
    "ཀུན་སློང་དེ་ལྟ་བུའི་གནས་སུ་རྩྭ་དང་ལོ་མའི་གདིང་བ་བཏིང་ནས་དེ་ཉིད་དུ་འདུག་པའི་ཚེ་གནས་ཕན་ཕུན་དུ་གྱུར་བ་རང་དགར་ཡལ་བར་འདོར་བའམ་གཞན་དུ་འགྲོ་འདོད་རྒྱུན་མ་ཆད་པའོགསུམ་པ་སྦྱོར་བ་དེ་ལྟར་འདུག་པའི་ཚེ་བན་ཕུན་དུ་གྱུར་པ་རང་དགར་ཡལ་བར་འདོར་བའམ་གཞན་དུ་འགྲོ་བར་རྩོམ་པའོ།",
    "ཀུན་སློང་རང་དགར་སྐྱོད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་ཕྱིས་གནོན་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "གང་དུ་འདུག་པའི་གནས་ནི།",
    "གང་ལ་འདུག་པའི་དངོས་པོ་ནི།",
    "ཀུན་སློང་རང་དགར་རྩ་བ་དབྱུང་བ་ལ་འདུག་པ་སོགས་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "གསུམ་པ་སྦྱོར་བ་དེ་ལྟ་བུ་ལ་འདུག་པ་སོཊ་བྱེད་པར་རྩོམ་པའོ།",
    "བཞི་པ་མཐར་ཐུག་འདུག་པའམ་ཉལ་བའི་བྱ་བ་རྫོགས་པའོ།",
    "ཀུན་སློང་རང་ཉིད་ཀྱི་དོན་མ་ཡིན་པར་དུད་འགྲོའི་སྲོག་ལ་གནོད་པར་མཐོང་ཡང་ལྟོས་མེད་དུ་སྲོག་ཆགས་དང་བཅས་བ་ལ་སྤྱོད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རིམ་པ་གསུམ་ལས་ལྷག་པར་ཅིག་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "དབེན་པ་གཅིག་འདུག་པ་དང་འགྲེང་བ་དང་།",
    "ཀུན་སློང་རང་དགར་དགེ་སློང་མའི་གོས་བྱེད་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "ལེགས་པར་སྨྲ་བ་དང་བསྙེན་པར་རྫོགས་པར་བྱེད་པ་མིན་པ་དང་རང་ལས་ནོར་ཐ་དད་པའོ།",
    "ཀུན་སློང་རང་དགར་མཛའ་ངོ་དང་བཤེས་ངོ་ཙམ་གྱི་ཕྱིར་སྟེར་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་དགེ་སློང་མ་དང་ལྷན་ཅིག་པའི་ལམ་དུ་འགྲོ་འདོད་རྒྱུན་མ་ཆད་བའོ།",
    "གང་དང་ལྷན་དུ་འདུག་པའི་ཡུལ་ནི།",
    "ཀུན་སློང་འདུག་པར་འདོད་པའོ།",
    "གསུམ་པ་སྦྱོར་བ་འདུག་པར་རྩོམ་པའོ།",
    "བཞི་པ་མཐར་ཐུག་གཉིས་ཀས་འདུག་པ་རྫོགས་པའོ།",
    "འདུག་པའི་གནས་སུ་འགྲེང་བ་ཙམ་ལས་གཞན་སྔ་མ་བཞིན་ནོ།",
    "གསུམ་པ་ངོ་བོ་ནི་འདུག་པ་ཞེས་པ་ལ་འགྲེང་བ་ཞེས་བརྗེ་བ་མ་གཏོཊ་སྔ་མ་བཞིན་ནོ།",
    "བཞི་པ་ཡན་ལག་ལའང་འདུག་པའི་གནས་སུ་འགྲེང་བ་ཞེས་བརྗེ་བ་མ་གཏོགས་ཡན་ལག་བཞི་བོ་སྔ་མ་བཞིན་ནོ།",
    "ཡང་ཡང་ཟས་ཟ་མུ་སྟེགས་འདུག་པའི་སར།",
    "ཀུན་སློང་རང་དགར་མགྲོན་དུ་བོས་པ་ཟས་གཉིས་པ་ཟ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ནམ་མཁའ་ལ་འདུག་པ་མ་ཡིན་པ།",
    "འདུག་གནས་དེར་ཞག་གཅིག་ལོན་པའོ།",
    "ཀུན་སློང་རང་དགར་འདུག་གནས་སུ་ཞིག་ལོན་པའི་ཟས་ཟ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་ངག་མཚན་ཉིད་ལྔ་ལྡན་གྱིས་བསླངས་ཏེ་གནས་གཞན་དུ་ཟ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་སྤངས་བ་རྫོགས་ཤིང་ལྷག་པོར་མ་བྱས་པ་ཟ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་ཟས་སྤངས་པ་སྟོབས་པར་འདོད་པ་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་འདུས་ཤིང་ཟ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་བྱིན་ལེན་མ་བྱས་པར་ཟ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
