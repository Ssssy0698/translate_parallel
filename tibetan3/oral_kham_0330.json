    "རྒྱུན་རིམས་པ་ཏོལ་གསེར་མེ་ཧོང་ལེན་ལྔ་པར་པ་ཏྲ་སྒ་སྐྱ་ཉིན་གཅིག་མི་གཏར་བཞི་པོ་རང་རང་རྩ།",
    "རྒྱུན་རིམས་སོགས་གཞན་བཞི་པོ་རང་རང་ཚ་ལ་གཏར་བས་རིམས་ཀྱི་ཚ་བ་འདོན་ཏེ།",
    "རྭ་གཞོབ་ནི་ར་ཡི་རྨང་རྨོངས་གཞོབ་ཡིན་ཟེར་མཁན་ཡང་འདུག་དུད་པ་རལ་པ་ཅན་བྱ་བལ་ནི་ཆུ་བལ་བྱ་བྲུན་ནི་རྒོད་བྲུན།",
    "རང་རང་རྩ་གཏར་རང་སོར་རང་གསང་བསྲེགས།",
    "ནི་ལྟ་བའི་སྟེང་ན་ཁྲག་རོ་ལུག་ཤིག་ཙམ་ཆལ་ཆིལ་འདུག་ན་ལྷ་བས་མནའ་བསྐྱལ་བས་ཕྱིར་མི་ལྡོག་རྨ་ཆས་སྦང་མ་ཞོ་བཙགས་ནི་ཞོ་རས་ཀྱི་སྙིགས་མ་བཙགས།",
    "སྨྲ་འདོད་ཞེ་ས་མཁས་ཞེས་པ་འཁྲུག་ཟེར་བ་ཡིན་པས་ནོར་བ་ཡིན་ལ་འགྲོ་འདུག་བྱེད།",
    "རྣག་དུས་ཟུངས་ཟད་པས་དཔེར་ན་མདའ་ཟད་རྟགས་དགྲ་བྱུང་བ་འདྲ།",
    "ཐ་མ་སྨིན་པ་རྣག་དུས།",
    "གར་འདུག་དེ་ཡི་སྟེང་དུ་མེ་ཏོག་སྣ་ཚོགས་ཀྱེ་ལུམས་བྱ་ཞིང་།",
    "གཉིད་མེད་རྣ་གླུ་ལེན་ནི་རྣ་བ་ངུ་བའམ་དཔེ་ལ་ལར་སྣ་གླུ་འདུག་སྨྲེ་ཅོང་གཅོང་འདོན་སྨྲེ་སྔགས་དང་གཅོང་སྐད་དུ་འདོན།",
    "སྲན་ཞེས་གཟའ་དུག་དཀར་པོ་གཉིས་ལ་ཟེར་བ་འདུག་ཀྱང་ཐེ་ཚོམ་དང་།",
    "རྒྱརྒྱ་སྣེ་དམར་པོ་བྲིས་པའང་འདུག་མཆན།",
    "འོ་མ་སྙིམ་པ་བརྒྱད་འདི་ལ་ཆུ་བོ་ཞེས་བྲིས་འདུག་ཀྱང་།",
    "མི་ཐུབ་ཙོག་པུར་འདུག་ལ་སྣོད་དུ་བཏང་།",
    "སྐད་གཉིས་སྨྲ་བ་བེ་རོ་ཙ་ན་གཉིས་ཀྱིས་བསྒྱུར།",
    "གཞུང་དོན་འཆོལ་བའི་སྐྱོན་འདུག་ཅིང་།",
    "གནས་ཀྱང་ཧ་ཅང་མི་ཚ་མི་གྲང་རན་དྲོ་གྲིབ་མར་འདུག།",
    "གནས་ཀྱང་སེར་བུ་དྲག་པོའི་ངད་མེད་དྲོ་མིན་བསིལ་བར་འདུག།",
    "བརླན་ལ་མི་འདུག་མི་འགྲོ་ལུས་ལ་ཆར་བས་གཤེར་མི་བྱ།",
    "ཚིལ་དང་ཏིལ་མར་མི་བཟའ་ཟིལ་བར་མི་འགྲོ་འདུག་མི་བྱ།",
    "གནས་ཀྱང་བསྲོ་ཁང་དྲོན་པོར་མེ་དང་སྟན་མཐུག་ལྡན་པར་འདུག།",
    "རྗེས་སུ་ལེགས་ལམ་མ་བྱུང་ཡང་རང་བློར་འགྱོད་པ་མི་སྐྱེ་བ་དཔེར་ན་བྲག་སོགས་ལ་རྡོག་པ་གཏད་ན་མི་འགྱུར་བ་དེ་ལྟར་ཡིད་དམ་བཅའ་བརྟན་པོས་བྱ་ཞིང་གྱ་ཚོམ་དུ་མི་འཇུག་ཅེས་པའོ།",
    "སེམས་ལ་གཡོ་སྒྱུ་དང་རང་ཕྱོགས་འབའ་ཞིག་སྐྱོང་བ་དང་།",
    "མིག་ནས་བྱུང་བའི་མཆི་མ་དང་གཞུང་ལ་ལར་མཆིལ་མ་ཞེས་འདུག་པ་ཕྱི་མ་དག་གམ་སྙམ།",
    "ཡང་མགོ་ཟླུམ་ཞེས་ཤ་གསེབ་ཏུ་མདེའུ་ལུས་པ་གར་འདུག་བརྟག་བྱེད་ལ་དང་པོ་མགོ་སྲན་མ་ལྟར་ཟླུམ་པ་ཞིག་བཏང་སྟེ་བརྟག་ལ་དེས་མ་རྟོགས་ན།",
    "རིམ་གཉིས་ཀྱི་རྣམ་གཞག་བྱ་སྤྱོད་ལའང་ཡོད་པར་འདོད་པ་ལྟ་བུ་འཕགས་ཡུལ་གྱི་གཞུང་དང་མཁས་པ་ལ་མ་གྲགས་པ་དུ་མ་བོད་ཡུལ་གྱི་མཁས་པ་རྣམས་ལ་ནང་ནོར་དུ་བཞུགས་འདུག་གོ་ཞེས་པ་ནི་ཞར་བྱུང་ངོ།",
    "རྒྱུ་ཚོགས་པ་དྲུག་ལྡན་དེ་ལས་ནི་སྙན་གྲགས་དང་འདོད་ཡོན་སོགས་ཚེ་འདི་དང་ཕྱི་མར་ཡང་རང་གཞན་བདེ་འགྲོའི་འབྲས་བུས་འབྱུང་ཞེས་པའི་དོན་ནོ།",
    "དཔེར་ན་དཔྱིད་ཤིང་ཁམས་ཀྱི་མ་ཆུ་ཁམས་མཁལ་རྩ་དང་རང་རྩ་ཤིང་ཁམས་མཆིན་རྩ་དར་ན་བཟང་།",
    "མཁལ་རྩ་དྲག་ན་མགྲོན་ལ་དགྲའམ་གྱོད་ངོ་འདུག་ཅེས་སྨྲའོ།",
    "མ་དང་རང་རྩ་གཞི་ལ་གནས།",
    "དེར་གནས་པས་ན་འདུག་པར་གྱུར་པའི་ཚེ་སྟེ་འདུག་པར་གྱུར་པ་ནི་གནས་པར་མཛད་པ་སྟེ།",
    "འདུག་པར་གྱུར་པ་དེ་ཡང་སུ་ཞིག་ཡིན་ཞེ་ན།",
    "ད་ནི་བདེ་བ་ཆེན་པོ་རྡོ་རྗེ་སེམས་དཔའི་གཞལ་ཡས་ཁང་བསྒོམས་པའི་སྟོབས་ཀྱིས་བསྐྱེད་ནས་དེར་འདུག་སྟེ།",
    "དེར་གནས་པ་ནི་བཞུགས་པ་སྟེ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པའི་ཚུལ་གྱིས་དེར་ཇི་སྲིད་གནས་ཤིང་འདུག་པ་དེ་སྲིད་ཀྱི་བར་དུའོ།",
    "དེ་ནས་དེ་བཞིན་དུ་འདུག་ལ་ཅི་འདོད་པར་ནི་བཟླས་བརྗོད་བྱའོ།",
    "དེ་ལྟར་སྙིམ་པའི་མེ་ཏོག་གཏོར་བས་ཨོཾ་མ་ཧཱ་སུ་ཁ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཟློས་ཤིང་རང་ཉིད་ཀྱིས་དཀྱིལ་འཁོར་འཕྱག་པར་བྱའོ།",
    "ལངས་པ་དང་ནི་འདུག་པ་དང་།",
    "དེ་བཞིན་འདུག་ལ་དེ་བཞིན་ལངས།",
    "དེ་ནས་མདུན་དུ་འདུག་ལ་དེ་ཁོ་ན་ཉིད་འདི་ལན་ཅིག་བརྗོད་པར་བྱའོ།",
    "དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོས་པདྨ་དེ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ།",
    "དེ་ནས་ཨོཾ་དྷཱི་བེ་རོ་ཙ་ན་ཧཱུཾ།",
    "དེའི་མདུན་དུ་འདུག་ལ་གསང་བའི་ལྕགས་ཀྱུ་མ་བཅིངས་ཏེ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་དེ་བཞིན་དུ་འདུག་ལ་བདག་ཉིད་ལ་སྤྲོ་བ་བསྐྱེད་པར་བྱའོ།",
    "ཤེ་ཥའི་མདུན་དུ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་ཤེ་ཥའི་ཕྱག་རྒྱ་ཆེན་པོས་འདུག་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེའི་སྤྱན་སྔར་འདུག་ལ་ཧཱུཾ་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་ཁོ་ན་ཉིད་དང་།",
    "འདིར་ཡང་རང་ཉིད་འཇུག་པས་དཀྱིལ་འཁོར་དུ་འཇུག་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།"
  ]
}