    "ཞིང་གི་ཁྱད་བཞི་པ་དང་བཅུ་པས་ནི་ཡོན་ཏན་གྱི་ཞིང་ལ་སྦྱིན་པའོ།",
    "ལྷག་མ་ནི་ཟང་ཟིང་གི་སྦྱིན་པ་གཙོ་ཆེ་ཞེས་བྱ་བར་ཡང་རུང་ངོ།",
    "བཅུ་ཚན་འདི་ལ་གྲངས་ངེས་པ་དང་གོ་རིམས་ངེས་པར་མི་བསམ་མོ།",
    "ལུས་ངག་གི་ལས་ཡོངས་སུ་དག་པ་དང་།",
    "གཉིས་པ་ནི་ལྷག་མ་གསུམ་མོ།",
    "ངག་གི་ལས་ཡོངས་སུ་དག་པ་བདེན་པའི་ཚིག་བརྗོད་པ་སྟེ།",
    "དང་པོ་དྲུག་གིས་ནི་ལུས་ཀྱི་རྐྱེན་གྱིས་མི་འཕྲོགས་པ་སྟོན་ལ།",
    "གོ་ཆའི་བརྩོན་འགྲུས་ནི་དེ་དག་གི་སྔོན་དུ་འགྲོ་བའོ།",
    "པ་ཡང་དེ་དག་གི་རྒྱུ་ཉིད་དུ་དོན་གྱིས་གནས་སོ།",
    "དང་པོ་ནི་ནང་གི་ཁྲོ་བ་ཉེ་བར་ཞི་བས་ཕྱི་རོལ་གྱི་གནོད་པ་བཟློག་པའི་ཕན་ཡོན་དང་ལྡན་པ་སྟོན་ཏོ།",
    "བདག་གི་བཟོད་པའི་འབྲས་བུ་དེ་ལ་ཐོབ་པར་སྨོན་པ་སྟོན་ཏོ།",
    "བཅུ་པ་ནི་ཟང་ཟིང་གི་སྦྱིན་པའོ།",
    "བཅུ་བདུན་པར་ཆང་གི་ཉེས་པའོ།",
    "ཉི་ཤུ་པར་ནི་གཞན་གྱིས་ཡོན་ཏན་དང་ལྡན་པར་རེ་བ་བསྒྲུབ་པའོ།",
    "དེ་ལྟར་སྦྱིན་པས་འདུན་པར་བྱས་ནས་སྙན་པར་སྨྲ་བས་གདམས་པར་བྱས་ཤིང་དོན་སྤྱོད་པས་གདམས་ངག་གི་དོན་བསྒྲུབ་པ་ལ་བཙུད་ལ།",
    "གཞན་དག་ལ་སྤྱོད་པ་རླབས་པོ་ཆེ་བསྒྲགས་ཤིང་མོས་པ་བསྐྱེད་དུ་གཞུག་གོ།",
    "མ་སྨད་པ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་སྟེ་གདུལ་བྱ་མཆོག་གི་ཡུལ་དུ་གྱུར་པའི་ཕྱིར་རོ།",
    "ཐུབ་པ་ནི་སྤྱི་མིང་བྱེ་བྲག་ལ་འཇུག་པ་སྟེ་ཐུབ་པ་ནི་ལུས་དང་ངག་དང་ཡིད་ཡང་དག་པར་བསྡམས་པ་ཡིན་ལ་དེ་ཐུན་མོང་མ་ཡིན་པ་དང་ལྡན་པ་ཐུབ་པའི་མཆོག་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེའི་སྐུ་ཚེ་སྔ་མའི་སྤྱོད་པ་སྟག་མོ་ལ་ལུས་བྱིན་པ་ལ་སོགས་པ་ནི་རྨད་དུ་བྱུང་བ་སྟེ་བྱ་དཀའ་ཞིང་ཕན་འདོགས་པ་ཆེ་བའི་ཕྱིར་རོ།",
    "དེ་བདག་གིས་སྙན་དངགས་ཀྱིས་མཆོད་དེ་རྗོད་བྱེད་དེས་བརྗོད་བྱ་ལ་དགའ་བ་བསྐྱེད་དོ་ཞེས་བྱ་བའོ།",
    "དགོས་པ་བརྗོད་པ་དང་དགོས་པ་དེ་དང་ལྡན་པ་བརྩམ་པར་ཞལ་གྱིས་བཞེས་པ་སྟེ་ཚིགས་སུ་བཅད་པ་རེ་རེ་དང་རིམ་པ་བཞིན་ནོ།",
    "སྙན་དངགས་དེ་ཡང་སྤྲོས་པས་འཇིགས་པ་ལ་བརྗོད་བྱ་བསྡུས་པས་ཁྱད་པར་དུ་བྱས་པ་སྟེ་འཇིག་རྟེན་མཆོག་གི་སྤོང་བ་དམ་པའི་ཕྱོགས་ཙམ་གྱིས་ཤེས་པར་བྱ་བ་སྟེ།",
    "མཉན་དུ་རུང་བར་བྱ་བའི་ཕྱིར་ལུང་དང་གཙུག་ལག་རིག་པར་མི་འགལ་ལམ་ངག་གིས་འདི་བརྩམས་སོ་ཞེས་བྱ་བའོ།",
    "དེ་ལ་ཐུན་མོང་མ་ཡིན་པའི་རང་དོན་བརྩོན་པས་གཞན་དོན་བརྩོན་པ།",
    "དེ་དག་ནི་རང་གི་དོན་ལ་བརྩོན་ཏེ་འཚེ་བ་ལ་སོགས་པས་བདག་ཉིད་ཀྱི་དོན་བསྒྲུབ་སྟེ།",
    "རྐང་པ་གསུམ་པས་ནི་རང་གི་དོན་ཕུན་སུམ་ཚོགས་པ་བསྟན་ཏེ།",
    "ཚིགས་སུ་བཅད་པ་གཅིག་དང་གཉིས་དང་གཅིག་གིས་རིམ་པ་བཞིན་ནོ།",
    "དེ་ལ་དོན་དང་པོ་ཡང་ཡུལ་གང་ལ་གང་ཟག་གིས།",
    "ཡུལ་ནི་རྐང་པ་དང་པོ་གསུམ་མོ།",
    "གང་ཟག་ནི་བདག་གིས་ཞེས་བྱ་བའོ།",
    "འཇིག་རྟེན་མཆོག་གི་སྤྱོད་པ་དམ་པའི་ཕྱོགས་ཙམ་གྱིས།",
    "བདག་གིས་སྙན་དངགས་འདི་བརྩམས་སོ་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ཡང་དགོས་པ་གང་གིས་རྩོམ་ཞེ་ན།",
    "རོལ་མོ་དང་།",
    "འཕོང་གི་སློབ་དཔོན་དང་།",
    "བྱམས་པའི་མཚམས་ལས་འདས་ཞེས་བྱ་བ་ནི་བྱམས་པའི་མཚམས་ནི་བྱམས་པ་ཤིན་ཏུ་ཆུང་ཡང་བདག་གམ་བདག་གི་བུ་ལ་བྱམས་པ་ཡིན་ལ་དེ་ཡང་མེད་པས་དེ་ལས་འདས་པའོ།",
    "འདམ་བུ་མེས་ཚིག་བཞིན་ཞེས་བྱ་བ་ནི་འདམ་བུ་མེས་ཚིག་པ་ནི་ཞུམ་ཞིང་ཐལ་བར་མྱུར་དུ་འགྱུར་ཏེ།",
    "ཕྲུག་གུ་བསད་ལས་གཅེན་མོ་བསྲུང་བ་དང་ཞེས་བྱ་བ་ནི་ཕྲུག་གུ་བསད་པ་ལས་བསྲུང་བ་ནི་རྒྱུ་གང་གིས་བསད་པ་ལས་བསྲུང་ཞེ་ན།",
    "གཅེན་མོ་བསྲུང་སྟེ་གསོད་དུ་མི་གཞུག་པའོ།",
    "གཅེན་མོ་ལས་ཀྱང་དེའི་ཕྲུག་གུ་བསྲུང་ཞེས་བྱ་བ་ནི་གཅན་མོའི་སྲོག་བསྲུངས་བ་ལས་ཀྱང་མའི་ནུ་ཞོའི་སྟོབས་ཀྱིས་ཕྲུག་གུ་བསྲུང་བའོ།",
    "སྟག་མོ་ལ་ལུས་བྱིན་པའི་རབས་ཏེ་རྟོགས་པ་བརྗོད་པ་དང་པོའོ།",
    "སླུ་བའི་ཚིག་ནི་རྩུབ་མོ་དེའི་བསྐྱིན་པ་བསབ་པ་ནི་ཅི་ཡང་མེད་ཅེས་བྱ་བ་སླུ་བའི་ཚིག་ཉིད་རྩུབ་པ་སྟེ་མི་འདོད་པའི་འབྲས་བུ་བསྒྲུབ་པའི་ཕྱིར་རོ།",
    "གསོ་སྦྱོང་གི་ཡན་ལག་བརྒྱད་པའོ།",
    "སྐྱབས་སུ་རེ་ཞིང་མི་འཚོར་དོགས་ནས་དེ་ལ་ཞུགས་ཞེས་བྱ་བ་ནི་གཞན་གྱི་གླའི་ཡས་བྱེད་པའི་དགོས་པ་སྟོན་ཏེ།",
    "ས་ཆེན་སྐྱོང་བའི་ས་ཆེན་པོ་དེ་ནི་རྒྱ་མཚོ་ཆེན་པོའི་གོས་གྱོན་པ་སྟེ་གོས་ཀྱིས་ལུས་གཡོགས་པ་ལྟར་རྒྱ་མཚོ་ཆེན་པོས་འཛམ་བུའ་གླིང་གི་ས་ཆེན་པོ་མཐའ་བསྐོར་བའི་ཕྱིར་རོ།",
    "རྟེན་གྱི་ཁྱད་པར་ནི་སྐྱེ་བོ་མཆོག་གི་ཚུལ་ལོ།",
    "ཡང་ན་རང་གི་ངོ་བོ་སྟེ་དམ་པའི་སྤྱོད་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཟན་དྲོན་ཆངས་གཅིག་གི་རབས་ཏེ་གསུམ་པའོ།",
    "ཡང་ན་པདྨ་མཆོག་གི་ལྷུང་བཟེད་ཐོགས་པས་ཏེ་ལག་པ་པདྨས་མཛེས་པར་བྱས་པ་ལྟར་ལྷུང་བཟེད་ཀྱིས་ཕྱག་བརྒྱན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ཕྱིར་ཁྱོད་ནི་བཟའ་བར་འདིར་འོངས་སོ།",
    "ནོར་བསྒྲུབ་པའི་རྒྱུ་ནི་བདག་གི་བློ་ཡིས་ལྕོགས་ཤིང་ཞེས་བྱ་བ་ལ་སོགས་པ་རྐང་།",
    "རྐང་པ་གཉིས་པ་ནི་ཚོང་གི་ཁྱད་པར་ཏེ།",
    "ང་ཡིས་བསླུས་པ་ནི་བརྒྱ་བྱིན་བདག་གིས་སོ།",
    "བདག་གིས་པགས་པ་ཨ་ཛྙི་གྱོན།",
    "རང་གི་སྤུ་ཡིས་ཤུན་ལྤགས་བྱས།",
    "གང་གིས་གྲགས་པ་ཞེ་ན་རང་བཞིན་ཕུན་སུམ་ཚོགས་པ་ཞེས་བྱ་བ་སྟེ་དེའི་། ཡོན་ཏན་ནོ།",
    "བཀུར་སྟི་བྱ་བ་ཡོངས་སུ་བཟུང་ཞིང་ནི་བཀུར་སྟི་བདག་གིར་བྱ་བའོ།",
    "དེའི་རྗེས་སུ་བཟུང་བ་ཡང་བདག་གིས་བདག་གིར་བྱ་བའོ།",
    "རི་བོང་གི་རབས་ཏེ་དྲུག་པའོ།",
    "སྐད་ཅིག་གཅིག་གིས་མཛའ་འགྱུར་ལ།",
    "དེ་དག་གིས་ནི་གཟུ་ལུམས་ཅན་ཏེ་ལེགས་པར་དཔྱོད་པའི་ཤེས་རབ་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་ཁྱོད་ལ་ཚེ་རིང་བ་འམ་ཡོ་བྱད་འཕེལ་བ་ལ་སོགས་པའི་མཆོག་སྦྱིན་གྱིས་སློང་ཤིག་ཅེས་འདིར་ཡང་ཁྱོད་ལ་མཆོག་སྦྱིན་ཞེས་སྨྲས་སོ།",
    "བསྟེན་པས་ཁྱོད་ལ་ཅི་ཞིག་ཅེས་བྱ་བ་ནི་དེ་མཐོང་བ་ལ་སོགས་པའོ།",
    "བསྟེན་པ་གཞན་འདོད་པས་ཁྱོད་མི་བསྟེན་པ་ལྟ་བུར་གྱུར་ཏེ།",
    "བརྟན་པ་ནི་མི་གཡོ་བ་ཡིན་ན་ཁྱོད་ནི་བསྟེན་པ་གཞན་འདོད་པས་གཡོ་པ་དང་བཅས་པས་མི་བསྟེན་པའོ།",
    "ཡང་གྲོགས་སྐལ་བ་དང་ལྡན་པ་དག་ལ་ནི་བདག་གིས་ཀྱང་ཕན་པ་བརྟན་པས་ཕན་གདགས་པར་ནུས་པ་སྨོས་ཞེས་པ་ལས་བཟློག་པའོ།",
    "དགོས་པ་གང་གིས་ཤེ་ན།",
    "དངོས་པོ་དང་བསམ་པ་དང་ཞིང་གི་ཁྱད་པར་གསུམ།"
  ]
