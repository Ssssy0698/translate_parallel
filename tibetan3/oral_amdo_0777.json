    "ལུས་ཁམས་ལ་ཚ་གྲང་འཐབ་པ་སོགས་ཀྱིས་སློང་གིན་ཡོད།",
    "བཅུད་མེད་པ་རྒྱུན་དུ་བསྟེན་པ་སོགས་ཀྱིས་སློང་གིན་ཡོད།",
    "སྣུམ་ཚིལ་གྱི་རིགས་བསྟེན་མང་བ་སོགས་ཀྱིས་སློང་གིན་ཡོད།",
    "ལུས་ཟུངས་ལ་ཕོག་ཐུག་བྱུང་བ་སོགས་ཀྱིས་སློང་གིན་ཡོད།",
    "མི་ལུས་ཀྱི་བྱང་ཁོག་སྨད་ཀྱི་ཆར་ཡར་སྣེ་རྒྱུ་གྲོག་དང་མར་སྣེ་ཆུ་སོ་རུ་འབྲེལ་བའི་སྣོད་དྲུག་གི་ཡ་ལ་བྱའོ།",
    "གཅིན་ལམ་ལ་གཉན་ཁ་རྒྱས་པ་སོགས་ཀྱིས་སློང་གིན་ཡོད།",
    "དེང་གི་འགྲོ་བས་ཕན་ཞེས་ཟོལ་གྱིས་སྨྲ།",
    "ཨ་མའི་ནུ་རིན་འཇིག་རྟེན་འཚོ་རིན་ཡིན།",
    "ལག་ལེན་དང་ཚོད་ལྟ།",
    "མོག་ཆུང་ཕུར་ཁོ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་བོད་ཡིག་རྩོམ་སྒྲིག་ཁང་།",
    "བཀྲ་ཤིས་ཀྱི་བྱ་བ་དེར་ངོ་འཛུམ་པད་མོ་བཞད་པ་ལྟ་བུའི་སྒོ་ནས་དགའ་འབོད་བྱེད་པ་རེད།",
    "དེ་ནས་རྒྱལ་རྩེ་བརྒྱུད་གྲོ་མོ་ཤར་གསིང་མ་བར་གྱི་རླངས་འཁོར་འགྲོ་ལམ་ལེགས་འགྲུབ་བྱུང་ནས་བོད་ཀྱི་ཚོང་པ་འགའ་ཤས་ཀྱིས་ཧིན་རྡུ་ནས་དབྱིན་ཇིའི་རླངས་འཁོར་ཉོས་ཏེ་སྒང་ཏོག་ནས་ཤར་གསིང་མ་བར་རླངས་འཁོར་འགྲོ་ལམ་མེད་པའི་ཉིན་གསུམ་གྱི་སར་མི་ཧྲེང་གི་སྟབས་སླ་བརྒྱབ་སྟེ་ཤར་གསིང་མར་ལྷུ་སྒྲིག་གིས་སྐྱེལ་འདྲེན་བྱ་བར་ཞུགས་པ་འདི་ནི་རྒོད་ཕྲུག་གཤོག་རྩལ་རྫོགས་ཏེ་ནམ་འཕངས་གཅོད་པ་ལྟ་བུར་སྣང་།",
    "དེ་ནས་ཡུན་རིང་མ་སོང་བར་ཁོང་གྲྭ་སའི་སྒྲིག་ཁོངས་ནས་འཐེན་ཞིང་།",
    "སྐབས་དེར་ཁོང་ལ་མ་རྩ་རྒྱུ་དངུལ་སྒོར་མོ་བརྒྱ་སྐོར་ཞིག་ཡོད་པ་དེ་དག་གིས་འབྲི་གུང་ནས་གྲོ་མ་ཉོས་ཏེ་ལྷ་སར་བཙོང་པ་དང་།",
    "ལ་ཁྲའི་ཅོག་ཙེ་སོགས་དང་བརྗེ་ཚོང་བྱེད་རིང་སྐབས་རེ་ལམ་འཁེལ་གམ་པ་བྱང་ཐང་སོགས་ནས་ལྟོ་ཐེངས་རེ་གཉིས་སློང་དགོས་ཀྱང་བྱུང་ལུགས་གསུངས་མྱོང་།",
    "དེ་ནས་བོང་བུ་གཅིག་ཉོས་ཏེ་གོང་བཞིན་དངོས་ཟོག་ཉོ་ཚོང་ལོ་ཤས་བྱས་རྗེས་མ་རྩ་གང་འཚམས་འཕེལ་རྒྱས་བྱུང་སྟེ་ཁལ་རྒྱབ་བཅུ་གྲངས་ལོངས་པའི་ཚོང་ཟོག་ཉོ་སྒྲུབ་ཀྱིས་མཚོ་སྣ་ནས་བརྡལ་གླར་བཏང་སྟེ་རྩེད་ཐང་ནས་རྩིས་ལེན་བྱེད་པ་སོགས་ཚོང་འཁོས་འཐབ་ལེན་ལོ་བཅུ་ཙམ་བྱེད་རིང་ཁེ་འབབ་གང་ལེགས་བྱུང་བ་རེད།",
    "ད་དུང་ཚོང་ལས་གཙོ་བོ་དངུལ་ཚོང་ཡང་རྒྱག་གི་ཡོད་པ་རེད།",
    "རི་འགོག་དམག་འཁྲུག་སྐབས་སུ་རྒྱ་གར་ནས་རས་ཆ་ཕོན་ཆེན་ཉོས་ཏེ་ཡུན་ནན་སོགས་སུ་བཙོང་བའི་རིན་དངུལ་རྒྱ་གར་དུ་དབྱིན་སྒོར་དང་དངུལ་བརྗེས་རྒྱུག་གི་ཡོད་པ་རེད།",
    "ཀུན་གླིང་དང་རྭ་སྒྲེང་བླ་བྲང་དང་དེ་བས་ཉེ་པོ་བྱེད་པ་རེད།",
    "བལ་གོང་འཕར་མཚམས་ཚོང་བསྒྱུར་བྱས་པར་ཁེ་བཟང་ལྡབ་མང་པོ་ཡོང་གི་ཡོད་པ་རེད།",
    "དེ་བཞིན་རྒྱ་གར་ནས་བྱུ་རུ་དཀྲུགས་མ་སྒམ་དོ་པོ་ཉོ་སྒྲུབ་བྱས་པ་རྣམས་སྐུ་དྲག་དང་འབྱོར་ལྡན་ཁག་ལ་ཚོང་གི་ཡོད།",
    "བོད་དངུལ་སྲང་གསུམ་རེའི་སྐུ་འགྱེད་གཏོང་ཐེབས་རྡོ་ཚད་ཆིག་སྟོང་ལྔ་བརྒྱ་དང་།",
    "རྭ་སྟོད་ཉག་རེ་ཁམས་ཚན་ལ་མང་ཇ་གཅིག་དང་།",
    "ལི་མའི་བཀའ་གདམས་མཆོད་རྟེན་གཉིས་བཅས་ཕུལ་བ་རེད།",
    "སྲིད་སྐྱོང་ནས་ཀྱང་ཐུགས་སྣང་གཙང་བའི་བཀའ་མོལ་དང་སོག་ཆས་གྱོན་སྟངས་ཚུན་བཀའ་སློབ་གནང་བ་དང་འབྲེལ་ཁ་བཏགས་ཨ་ཤེ་ཞིག་གཡོགས་པ་དེ་གྱོན་བཞིན་ཁྱིམ་དུ་ཕྱིར་འབྱོར་སྐབས་གདན་ས་གསུམ་དང་།",
    "ཚོང་པ་ཁག་བྲག་གཡབ་ཀྱི་མི་སེར་སོགས་མང་པོས་རྟེན་འབྱུང་ལེགས་འབུལ་རྒྱ་ཆེ་ཕུལ་སོང་།",
    "བྲག་བླའི་ལྷ་སའི་ལས་དོན་མཐའ་དག་དོན་གཅོད་འགན་འཁུར་ལྷོད་མེད་སྒྲུབ་ཀྱི་ཡོད་པ་རེད།",
    "རྭ་སྒྲེང་ཚོང་པར་དབྱིན་སྒོར་ཁྲི་སུམ་ཅུ་སོ་དྲུག་སྤྱད་ནས་རིན་འབབབ་ཕྱི་ལོ་ཟླ་བ་བཞི་པའི་ནང་གསེར་རྐྱང་ལེན་རྒྱུ་བྱས་པ་རེད།",
    "སྐབས་དེར་འདས་པོའི་སྤུན་མཆེད་ཐུབ་བསྟན་སྦྱིན་པ་ནས་འདས་མཆོད་དང་རྒྱུ་དངོས་ཀྱི་བདག་གཉེར་ལོ་གཅིག་ཙམ་བྱས་རྗེས་ཐུབ་བསྟན་སྦྱིན་པ་ཡང་གྲོངས་པ་རེད།",
    "དེ་ནས་ལྡེ་འཆང་འདས་པོའི་ཕྱི་ནང་སྣོད་བཅུད་ཚང་མ་གཡོག་རིགས་ཁ་ཤས་ཀྱིས་བདག་བཟུང་ཐོག་ལྡེ་མིག་ཐད་སྐབས་རེར་འབྲས་སྤུངས་ཉག་རེ་ཁམས་༣།་",
    "འབྲས་སྤུངས་ཉག་རེ་ཁམས་ཚན་ལ་སྐུ་འགྱེད་དངུལ་སྲང་ལྔ་དང་ཞོ་གསུམ་རེའི་ཐེབས་རྩ།",
    "ར་མོ་ཆེ་ཇོ་བོའི་སྤྱན་སྔར་མཆོད་སྤྲིན་སྟོང་ཚར།",
    "རྩེ་རྣམ་རྒྱལ་གྲྭ་ཚང་ལ་སྐུ་འགྱེད་སྲང་ལྔ་རེ་དང་གསོལ་ཇ།",
    "རྭ་སྟོད་ཉག་རེ་ཁམས་ཚན་གསུམ་གྱི་སྐུ་ཚབ་ལ་ཟེར།",
    "སྔར་སྲོལ་ལྟར་ན་བྲག་བླས་མི་སེར་འགོ་པ་རེ་བསྐོ་གཞག་གིས་ལྷ་སར་གཏན་སྡོད་བྲག་བླའི་མངགས་བྱ་ཚང་མ་བསྒྲུབ་དགོས་པ་དང་།",
    "ལྷ་སར་བྲག་བླ་སྒེར་གྱི་མི་སེར་ཐེམ་དུད་ཆིག་སྟོང་སྐོར་དང་ཀོང་པོ་སོགས་སུ་ཐེམ་དུད་ཆིག་སྟོང་སྐོར་ཡོད་པ་དེ་དག་གི་འགོ་ཚོ་དང་།",
    "མི་བོགས་མི་རེ་ནས་དངུལ་སྲང་གང་ཞོ་ལྔ་རེ་ལོ་ལྟར་བསྡུ་ལེན་སོགས་ཀྱི་ལས་འགན་སྒྲུབ་དགོས་པ།",
    "དེ་རྗེས་འབྲས་བློ་གླིང་གྲྭ་ཚང་གི་ཕྱག་སྦུག་ཀོང་པོ་ཡེ་ཤེས་ཕུལ་བྱུང་དང་།",
    "ཕྱག་སྦུག་ནས་གནས་ཚུལ་དེ་ཤེས་རྗེས་ཁྱོད་རང་གཅིག་པུས་གསེར་ཚོང་བྱས་པ་མ་ཚད་གསེར་རིན་སྒེར་ཉར་འོས་མིན་ཡིན་བརྗོད་བྱུང་བར་དེ་ལན་ངོས་ནས་ཐོག་མར་ང་ཚོ་ཐུན་མོང་ཐོག་གསེར་རྒྱུ་འདེགས་བྱས་པར་གསེར་སྲང་བདུན་སྟོང་དྲུག་བརྒྱ་ཞེ་བདུན་ཡོད་པ་ནས་ད་ལྟ་གསེར་སྲང་བཞི་སྟོང་བཞི་བརྒྱ་ལས་མི་འདུག་ཅིང་།",
    "ད་ཕན་གསེར་དངུལ་མཛོད་ཁང་གི་ལྡེ་མིག་ཁྱོད་ཚོས་ཉར་ཚགས་བྱས་པ་མ་རེད་དམ།",
    "སུས་འཁྱེར་སོང་ངམ།",
    "བཞེས་ཐུག་གཅིག་སྐུ་འགྱེད་རྭ་ཡང་དཀར་པོ་གཉིས་རེ།",
    "ཊམ་དཀར་རེའི་གཏོང་ཐེབས།",
    "འབྲས་སྤུངས་ཉག་རེ་ཁམས་ཚན་ལ་མང་ཇ་དང་།",
    "ཁམས་ཚན་བཅས་ལ་མཆོད་བསྙེན་རྒྱས་བསྡུས་གོང་གསལ་འབྲས་སྤུངས་དང་ཕྱོགས་མཚུངས་གཏོང་རྒྱུ་སོགས་ཀྱི་འཆར་གཞི་བཟོ་བ་གནང་སོང་།",
    "ཇ་མོ་ཅན་སེང་གེ་ལམ་པར་སྒམ་ཉི་ཤུ་རྩ་ལྔ།",
    "འབྲུ་རུའི་ཀ་ན་སུ་ཁལ་བརྒྱ་དང་སུམ་ཅུ་སྐོར་བཅས་བླངས་པ་རེད།",
    "གཡོག་བློ་བཟང་རྒྱལ་མཚན་བཅས་ཡོང་དགོས་ཞེས་པའི་བརྡ་ཐོ་འབྱོར་དོན་བཅར་བར་རྩེ་མགྲོན་གཉེར་ཆེན་མོ་བརྒྱུད་བཀའ་དཔྱད་བཏང་དོན་བྲག་བླར་བོད་དངུལ་རྡོ་ཚད་སུམ་ཁྲི་ལྔ་སྟོང་དང་།",
    "ཅོ་ཅོ་ང་རང་གཉིས་སོ་སོར་ཞོ་གང་སྐར་ལྔ་རེ་བཅས་འབུལ་དགོས་པ་དང་།",
    "གོང་གསལ་མི་བཞི་གྲྭ་སའི་སྒྲིགས་ཁོངས་ནས་དབྱུང་སོང་།",
    "རྩེད་ཐང་ཕུར་འབྲས་སྤུངས་སྔགས་པ་གྲྭ་ཚང་གི་གཞིས་ཀའི་ཐོག་འབྲོག་ཁག་གཅིག་གནས་ཆུང་ཁང་གསར་ནང་ཕྱ་སྒམ་མཆོད་གཤོམ་ཤིང་ཁྲོལ་རྩི་ཅན་ནང་ནང་རྟེན་ལི་མའི་སྐུ་མང་པོ་དང་།",
    "ཐབ་ཚང་གི་མཁོ་དངོས་སོགས་མང་ལེགས།",
    "དོས་ཁང་ཆེན་པོ་ཞིག་གི་ནང་ཇ་མར།",
    "ཉག་རེ་ཁམས་ཚན་དུ་བཅོལ་བཞག་བྱས་པའི་རྒྱ་སྒམ་ཀོ་དམར་གྱིས་བཏུམ་པ་ལྕགས་དཀྲོལ་གསེར་ཚགས་ཅན་གྱིས་ཤན་པ་དྲུག་ཅུ་སྐོར་དང་།",
    "གཞན་ཡང་དོ་པོ་ཁང་པ་ཁ་ཤས་ཡོད་འདུག་པ་དེ་དག་བོད་དམག་བརྒྱ་ཐམ་པས་ཉིན་ཤས་རིང་དབོར་སོང་།",
    "ང་རང་ནས་ལོ་མང་རིང་དཀའ་ངལ་བརྒྱབ་པའི་འབྲས་བུ་སྟོང་ཟད་དུ་གྱུར་སོང་བསམ་པ་བཅས་ལས་གཞན་གྱི་བྱ་ཐབས་དབེན་པ་བཅས་སོ།",
    "ཚེ་རིང་མཚོ་མོ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ཞིང་འགྲེམས་སྤེལ་བྱས།",
    "སྦྲག་ཨང་ཁ་པར་ཨང་གྲངས་མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་སྐུལ་འོདཔར་སྒྲིག་ཁང་ནས་པར་བསྒྲིགས།",
    "དཔར་ཤོག་དཔར་གྲངས་དེབ་རེར་སྒོར་བ་ས་བས་ཀ་ཆ་ཏན་ཀར་སབ་ཆ་༧ ༤ ཐཁ་",
    "གླུ་ཐལ་སྦྱར་མ་ཞེས་བྱ་བའི་པོད་ཅིག་ལོགས་སུ་མཛད།",
    "ཕྱི་ལོ་༡༩༡༣ ལོར་སྨྲ་བའི་ཁྱུ་མཆོག་ཆེན་པོར་འཛམ་གླིང་ན་ཆེས་རྩི་མཐོང་བྱེད་པའི་ནོ་བེལ་བྱ་དགའ་ཡང་སྙན་ངག་གི་དུམ་བུ་འདིར་ཐོབ།",
    "འདས་ལོ་བརྒྱ་ཕྲག་བཅུ་པའི་རྗེས་སུ་རིམ་པར་དར་རྒྱས་སུ་སོང་བའི་ཚིག་རྒྱན་གྱི་རྣམ་གཞག་དང་རྩོམ་འགྲོས་གསར་པ་ཇི་སྙེད་ཅིག་བྱུང་བ་ཐམས་ཅད་བོད་སྐད་ཀྱི་བགོ་སྐལ་དུ་མ་ཐོབ།",
    "ཆེ་བའི་ཡོན་ཏན་དུ་མས་བརྒྱན་པའི་གླུ་ཡི་སྙིམ་པའམ་གླུ་ཐལ་སྦྱར་མ་བོད་སྐད་དུ་བསྒྱུར་བ་འདི་ཡི་པར་གྱི་འདུ་བྱེད་དང་པོ་ལྡི་ལི་བོད་ཀྱི་ཁང་པ་ནས་བསྐྲུན་འདག་ཅིང་།",
    "ཝཱ་ཎ་དབུས་བོད་ཀྱི་ཆེས་མཐོའི་གཙུག་ལག་སློབ་ཁང་གི་ངེས་སྟོན་པ་ཤཱཀྱའི་དགེ་སྦྱོང་ཟམ་གདོང་པ་བློ་བཟང་བསྟན་འཛིན་དུ་འབོད་པས།",
    "༢གང་ཚེ་ཁྱོད་ཀྱིས་གླུ་དབྱངས་ལེན་པར་གསུངས་པ་དང་།",
    "བདག་ནི་འདི་རུ་ཁྱོད་ཉིད་ཀྱི།",
    "༢༣ཀྭ་ཡེ་བདག་གི་ཡིད་བཅུགས་གྲོགས།",
    "༣༢འཛམ་བུ་གླིང་གི་གང་ཟག་གཞན།",
    "ཁ་བདག་ནི་ས་ཡི་ཁྱོན་ཡངས་པར།",
    "ཁྱོད་ནི་སེང་ཁྲིར་བཞུགས་བཞིན་པར།",
    "བདག་གི་གླུ་གཞས་མཐའ་མ་དེར།",
    "ཟློས་གར་དང་གཞན་ཡང་སྙན་རྩོམ་རིགས་ཕུན་སུམ་ཚོགས་པ་ཞིག་བརྩམས་ནས་བང་ག་ལའི་རིག་གཞུང་ཇེ་ཕུན་སུམ་ཚོགས་སུ་མཛད་པ་དང་ཆབས་ཅིག་རྣལ་འབྱོར་པ་དག་གི་ཉམས་མགུར་དང་མཚུངས་པའི་གླུ་རིགས་དུ་མ་ཞིག་དགོངས་དབྱིངས་ནས་གྱེར་བ་རྣམས།",
    "དེ་ཡང་ཟབ་མོ་རྟེན་འབྱུང་ལ་བསྟོད་པ་ལས།",
    "མཛད་པ་ཀུན་ལས་གསུང་གི་ནི།",
    "ཞེས་གསུངས་པ་ལྟར་ཕྱི་ནང་གི་ལྟ་བ་སྟོན་བྱེད་ཀྱི་རིག་གཞུང་ངམ་བསྟན་བཅོས་ཅི་འདྲ་ཞིག་ཡིན་ན་ཡང་འགོ་བརྗོད།",
    "ཉིན་མོ་མེད་ཅིང་མཚན་མོ་དག་ཀྱང་མེད།",
    "བུ་ཕྲུག་རྣམས་ནི་ཨ་མ་དྲིན་ཅན་མས།",
    "འདི་ལྟར་དགོངས་པ་ཅན་གྱི་སྙན་རྩོམ་འདི་ཉིད་སྣང་མེད་དུ་བཞག་ག་ལ་ཕོད་ཅེས་ཁོ་བོའི་བློ་ངོར་སེམས་ཤུགས་སྤྲོ་ཤུགས་ཤིག་སྐྱེས་པའི་མོད་ལ།",
    "འཛམ་གླིང་སྐད་རིགས་གཞན་དུ་ཕབ་བསྒྱུར་བྱས་པའི་གླུ་ཐལ་སྦྱར་མའི་འགྱུར་ཕལ་ཆེར་ཚིག་ལྷུག་ཏུ་ཡོད་བ་ཤ་སྟག་ཡིན་པ་དང་།",
    "ཡིག་ཕྲེང་གི་རིང་ཐུང་དང་ཚེག་བར།",
    "འོན་ཏང་སྐབས་འགར་རྩོམ་པ་པོའི་བསམ་ཡུལ་འཇིག་རྟེན་བྱེད་བོ་ཚངས་པ་ཡིན་ནམ་ཡང་ན་རང་འབྱུང་གི་ཁམས་ཡིན་ནམ་བློ་གྲོས་ཀྱི་ཡོལ་གོར་མ་ཚུད་པ་འགའ་ཡང་འདུག་སྟེ།",
