    "རྣམ་སྣང་མངོན་བྱང་གི་ལུང་གིས་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་བསྒོམས་པས་འཇའ་ཚོན་ལྟ་བུའི་སྐུ་འགྲུབ་པར་གསུངས་ཤིང་།",
    "དཔེར་ན་སྒྲ་བྱས་པ་དེ་སྒྲ་མི་རྟག་པ་ཡིན་ཀྱང་སྔ་མ་བརྗོད་པའི་ཚིག་གིས་ཕྱི་མ་བརྗོད་མི་དགོས་པ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་སྒྲོན་གསལ་དུ་དྲངས་པས་ཀྱང་ལྷའི་རྣལ་འབྱོར་ལ་དག་མ་དག་གཉིས་སུ་བྱེད་པ་ཙམ་སྟོན་མོད་ཀྱང་།",
    "རྫོགས་རིམ་ཟུང་འཇུག་གི་སྐུ་སྐྱེད་པ་ལུང་དེས་སྟོན་པར་མི་བཞེད་དེ།",
    "དེ་དག་གིས་འདིའི་རྫོགས་རིམ་རྣམས་སྟོན་པར་བཞེད་པ་མིན་ནོ།",
    "མཐའ་དྲུག་གི་ཡ་གྱལ་གྱི་སྒྲ་ཇི་བཞིན་མ་ཡིན་པ་ནི།",
    "དེ་ནི་ངན་སོང་སྦྱོང་རྒྱུད་ནས་ཀོ་ཊཱ་ཁྱ་ལ་སོགས་པའི་སྒྲས་ཕྱག་ན་རྡོ་རྗེའི་མཚན་བཅུ་བསྟན་པར་གསུངས་པས།",
    "འདི་ལ་པཎྜི་ཏ་སྐལ་ལྡན་གྲགས་པ་ནི་དེ་གཉིས་ཤིན་ཏུ་ཐ་དད་དོ་ཞེས་འགལ་བར་འདོད་མོད་ཀྱང་།",
    "སྣ་ཡི་རྩེ་མོར་ནན་ཏན་དུ།",
    "སྣ་ཡི་རྩེ་མོར་ཡུངས་ཀར་བསམ།",
    "རྒྱུད་འདིར་མཐར་ཐུག་གི་དོན་ཉིད་དགོངས་དགོངས་མིན་དང་།",
    "མཐའ་དྲུག་གིས་ནི་འཆིང་བས་བཅིངས་པས།",
    "སྣ་ཡི་རྩེ་མོར་ཡུངས་ཀར་བསམ།",
    "མཐའ་ནི་རྩེ་མོའམ་སྒོ་སྟེ།",
    "འགལ་བའི་ཚིག་གི་སྦྱོར་བ་ཡིས།",
    "ཡང་སྔར་གྱི་ངེས་དོན་སྦས་པ་ནི་གཞུང་གཅིག་གིས་དྲང་ངེས་ཀྱི་དོན་གཉིས་ཀ་སྟོན་པ་ན་དངོས་ཟིན་དྲང་དོན་ཡིན་པས་སྦས་པ་ཡིན་ལ།",
    "མ་ངེས་པ་འགའ་རེ་ནི་སྣང་ངོ།",
    "ཆགས་པ་བར་མ་ཉེ་བར་མི་དམིགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྣང་བ་གསུམ་ལ་སྒྲ་འགལ་བའི་ཚིག་གིས་བསྟན་ཞིང་བཀག་པས།",
    "ཕྱག་རྒྱ་ཞེས་བྱ་བ་ལ་སོགས་པའི་གསང་སྔགས་ཀྱི་གཞུང་གི་རྡོ་རྗེའི་ཚིག་རྣམས་ཀྱི་དངོས་ཟིན་གྱི་དོན་ནི།",
    "པདྨ་ཞེས་པའི་དོན་གཉིས་པ་ནི་འདབ་མ་བརྒྱད་པ་ལ་སོགས་པའི་མེ་ཏོག་ལས་གཞན་པའི་བུད་མེད་ཀྱི་བྷ་ག་མཚན་མ་སྟེ་ཤེས་རབ་བོ།",
    "ཕྱག་རྒྱ་ཞེས་པའི་དོན་གཉིས་པ་ནི་ལག་པའི་ཕྱག་རྒྱ་ལ་སོགས་ལས་གཞན་པའི་བཙུན་མོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྡོ་རྗེའི་ཚིག་རྣམས་ཀྱི་དོན་ནི་མ་ངེས་པའི་དོན་ཏོ།",
    "ནང་གི་ཏིང་ངེ་འཛིན་དང་ཕྱིའི་བྱ་བ་ལ་སོགས་པའི་ཆ་གཉིས་ཀ་སྟོན་པ་རྣལ་འབྱོར་གྱི་རྒྱུད་དང་།",
    "ཕྱི་ནང་གི་ཀུན་སྤྱོད་ཆ་མཉམ་པར་སྟོན་པ་སྤྱོད་པའི་རྒྱུད་དང་།",
    "སྐལ་ལྡན་གྲགས་པས་སྒྲ་ཇི་བཞིན་མ་ཡིན་པས་བརྡ་ཙམ་སྟོན་གྱི་བསྐྱེད་རྫོགས་གང་ཡང་སྟོན་མི་ནུས་ཞེས་ཟེར་མོད་ཀྱང་།",
    "གཞུང་དེ་རྣམས་ཀྱི་མིང་གི་མཐའ།",
    "ནང་གི་ཏིང་ངེ་འཛིན་ཤས་ཆེ་ཞིང་ཕྱིའི་བྱ་བ་ཤས་ཆུང་བའི་ཚུལ་གྱིས་སྟོན་པའི་གཉིས་ཀའི་རྒྱུད་དང་།",
    "གཙོ་ཆེར་ཐུན་མོང་གི་དངོས་གྲུབ་སྒྲུབ་པ་གཙོ་བོར་སྟོན་པའི་རྟོག་པའི་རྒྱུད་རྣམས་ཀྱི་གཞུང་གི་ཚད་ཇི་ལྟར་ལགས་ཞེས་ཞུས་སོ།",
    "བླ་ན་མེད་པའི་རྣལ་འབྱོར་ཆེན་པོའི་རྒྱུད་ཀྱི་མིང་གི་གཙོ་བོ་ལ་སྟོང་ཕྲག་བཅུ་གཉིས་ཞེས་བྱ་སྟེ།",
    "རྒྱུད་ཀྱི་མིང་གི་གསལ་བའི་དབྱེ་བ་རྒྱས་པར་ཕྱེ་ན་གྲབས་མེད་དོ།",
    "རྒྱུད་འདིར་རྣལ་འབྱོར་ཆེན་པོའི་རྒྱུད་ཀྱི་ཚད་གསུངས་པ་ནི་ཐབས་རྒྱུད་ཀྱི་ཡིན་ཞེས་ཁ་ཅིག་གསུངས་མོད་ཀྱང་།",
    "ཐབས་ཤེས་ཀྱི་རྒྱུད་གཉིས་ཀའི་ཐུན་མོང་བར་གསལ་ཏེ།",
    "དེ་དག་གི་མིང་གཅིག་ཏུ་བསྡོམས་ན་སྟོང་ཕྲག་སུམ་ཅུ་རྩ་བཞིའོ།",
    "བྱ་བའི་རྒྱུད་ལ་མཆོག་དང་ཐུན་མོང་སྒྲུབ་པ་གཙོ་བོར་སྟོན་པའི་དབྱེ་བས་བྱ་བ་དང་རྟོག་པའི་རྒྱུད་ཅེས་གཉིས་སུ་ཕྱེ་བ་ཙམ་ཡིན་པས།",
    "རྒྱུད་དང་རྟོག་པའི་མིང་གི་མཐའ་མའི་ཡི་གེ་ཇི་སྙེད་པ་ནི།",
    "དགྲ་ནག་གི་རྒྱུད་ལས།",
    "འདུས་པ་གང་གིས་མི་ཤེས་པ།",
    "བཅོམ་ལྡན་འདས་ཞེས་བོས་ནས་རྒྱུད་ལྔ་པོ་དེ་རྣམས་ཀྱི་ཐབས་གང་གིས་བསྒྲུབ་བྱ་སྒྲུབ་པའི་བྱེད་པ་དང་།",
    "བཙུན་མོའི་འཁོར་གྱི་དབུས་སུ་ཡང་དག་པར་བཞུགས་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "བཙུན་མོའི་བྷ་ག་ལ་རོལ་པའི་ཚུལ་གྱིས་སོ།",
    "བགྲོད་བྱ་མིན་པ་ལ་བགྲོད་པ་ལ་སོགས་པ་འཇིག་རྟེན་གྱི་སྤྱོད་པ་དང་འགལ་བ་རྨད་དུ་བྱུང་བའི་རྡོ་རྗེའི་ཚིག་རྣམས་ཀྱི་དོན་མཐའ་དྲུག་གང་གིས་རབ་ཏུ་དཔྱོད་པར་བྱེད་པ་ནི་ཆོ་གའོ།",
    "མཐའ་དྲུག་གིས་རྒྱུད་དོན་དཔྱད་དེ་རྟེན་དེས་བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ནི་སྒྲུབ་པ་པོའོ།",
    "རིག་པའི་ལྷ་མོ་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཏེ་དེ་རྣམས་དང་ལྷན་ཅིག་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་དགོད་པ་སྟེ་བཀོད་པའི་གོ་འཕང་ནི་བསྒྲུབ་པར་བྱ་བའོ།",
    "ཕྱིའི་ཁྲུས་དང་གཙང་སྦྲ་ལ་སོགས་པའི་ལས་ཀྱི་བྱ་བ་གྲངས་སྣ་ཚོགས་པ་རྒྱ་ཆེན་པོ་ནི་ཐབས་གང་གིས་སྒྲུབ་པའི་བྱེད་པ་ཡིན་ལ།",
    "འདིས་ནི་ནང་གི་ལྷའི་རྣལ་འབྱོར་ཡང་མཚོན་པ་ཡིན་ནོ།",
    "དེའི་རྒྱུའི་རྟོག་པ་ནི་ཉོན་མོངས་ཀྱི་རྩ་བ་དངོས་པོ་ལ་བདེན་པར་འཛིན་པའོ།",
    "ལྷ་མོ་བཞིས་ཞུས་ལས།",
    "རྒྱན་བདུན་སོ་སོའི་མིང་གི་དབྱེ་བའོ།",
    "དེ་གང་གིས་བརྒྱན་པར་བྱེད་པ་ནི་བདུན་ནམ་ཉེར་བརྒྱད་དོ།",
    "གཉིས་པ་ནི་དེ་དག་གི་ལྷག་མ་བཅུ་བཞིར་འདོད་དོ།"
  ]
}