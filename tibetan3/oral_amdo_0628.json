    "ཕ་མའི་ཁུ་ཁྲག་གིས་ནོན་པས་མུན་པའི་གླིང་དུ་ཚུད་པ་དང་འདྲ།",
    "གཉེན་བྱམས་པ་མ་འཁྱོངས་དོགས་ནས་ཆགས་ཞེན་འཁྲི་བས་སྡུག།",
    "མིག་གིས་གཟུགས་མི་མཐོང་།",
    "གང་གིས་མཐོང་ཡང་ཡིད་གར་མི་འོང་འཆི་རན་ཟེར།",
    "དར་མ་ནས་རྒན་པོ་དང་རྒན་མོར་འགྲོ།",
    "བརྒྱ་ལ་བྱུང་ཡང་མཚན་མོ་བརྒྱ་ཉལ་བས་ལྔ་བཅུ་ཐམ་པ་གཉིད་དུ་སོང་།",
    "ཉིན་མོ་ལྔ་བཅུ་ཐམ་པ་ཡང་གཉིད་དང་།",
    "ད་ལྟར་བདག་གི་ལུས་ལ་གཅེས་སྤྲས་བྱས་ནས་གསོས་ཀྱང་།",
    "འཆི་བའི་ཚེ་བདག་རང་གིས་ཁུར།",
    "བདག་ངན་སོང་དུ་འགྲོ་བ་ལ་ཕན་མེད།",
    "སྨྲ་མཁས་ཀྱང་འཆི་བདག་གིས་བདུད་ལ་ཤགས་མི་ཐུབ།",
    "ཟས་ནོར་ཇི་ཙམ་ཡོད་ཀྱང་རང་གིས་ཀྱང་ཟ་མི་ནུས།",
    "བར་མཉམ་གཉིས་ལ་སྟོན་མོ་བཀྱེ།",
    "དམ་ཚིག་དྲི་མ་མེད་ཅིང་དག་པ་ཤེལ་གོང་ལྟ་བུའི་ནོར་གྱིས་རང་སེམས་གཡོ་སྒྱུ་མེད་པར་རང་གིས་མ་ཁྲེལ་བར་བསྲུང་།",
    "ངོ་ཚ་ཤེས་ཤིང་ཁྲེལ་ཡོད་པ་ཕ་མས་མི་སླུ་བ་ལྟ་བུའི་ནོར་གྱིས་རང་གི་དོན་དུ་ངོ་ཚ་སྲུང་།",
    "གཞན་གྱི་དོན་དུ་ཁྲེལ་ཡོད་པ་ཕ་མས་མི་སླུ་བ་ལྟ་བུའི་ནོར་གྱིས་རང་གི་དོན་དུ་ངོ་ཚ་སྲུང་།",
    "གསུམ་པ་ཉོན་མོངས་པ་རང་དགར་མི་གཏོང་བར་གཉེན་པོ་བཅུག་པ་ལ་བསླབ་པ་ནི།",
    "ཉོན་མོངས་པ་ཞེ་སྡང་གི་མེ་ཆེར་འབར་བ་ལ།",
    "ཞེ་སྡང་གི་མེ་འབར་ནས་རང་རྒྱུད་ཚུར་ལ་བསྲེག་པ་ཡིན་པས།",
    "གཏི་མུག་གི་མུན་པ་ཆེན་པོ་འཐིབས་པ་དེས།",
    "གཏི་མུག་གི་མུན་པས་བསྒྲིབ་ནས་མ་ཡིན་པ་ཡིན་པར་བཟུང་།",
    "རང་གི་བུད་མེད་ཡོད་བཞིན་དུ་བུད་མེད་གཞན་ལ་མི་ཚངས་པར་མི་སྤྱད།",
    "བདག་པོ་ཅན་གྱི་བུད་མེད་ལ་འདོད་པས་མི་གཡེམ་མོ།",
    "ངག་གི་བཞི་ལ།",
    "ངོས་རེ་ལ་དཔག་ཚད་བཅུ་གཉིས་ཡོད་པའི་དབུས་ན།",
    "ལྷོ་ན་དཔའ་གཏུམ་སྟག་གི་མགོ་ཅན།",
    "ནུབ་ན་སྟོབས་ལྡན་ཕག་གི་མགོ་ཅན།",
    "བྱང་ན་རག་ཤ་གླང་གི་མགོ་ཅན།",
    "ནུབ་བྱང་ན་ཨ་བ་གླང་གི་མགོ་ཅན།",
    "བྱང་ཤར་ན་ལྕགས་གདོང་༩༨ན་ཁྱུང་གི་མགོ་ཅན་ནོ།",
    "སྟ་རེས་ཀྱང་གཤོག་གོ།",
    "དེ་ནས་ནུབ་སྨད་དུ་ལྕགས་ཀྱི་གཏན་ཚན་ལ་བཞག་ནས་ལྕགས་ཀྱི་ཕ་བོང་གིས་མནན་ཏེ་མར་ནག་འཚེར་བ་བཞིན་དུ་བྱེད་དོ།",
    "དེའི་འཁོར་ན་སྡིག་ཅན་དེ་ལྕགས་ཀྱི་ཕ་བོང་ཆེན་པོ་གཅིག་གིས་ལུས་ཀྱི་ཕྱེད་མནན་ནས་ལྕགས་ཀྱི་ཕག་རྒོད་ཀྱིས་ཟ་བར་བྱེད་དོ།",
    "དེ་ནས་དམྱལ་དཔོན་གྱིས་རྒྱ་གད་བྱས་མདུང་གིས་ཕུག་ནས་བྱང་སྟོད་དུ་ཕྱིན་པ་དང་།",
    "ལྕགས་ཀྱི་གཏན་པ་ལ་མགོ་བོ་བཞག་ནས་ལྕགས་ཀྱི་ཕ་བོང་གིས་མནན་ནས་བཅད་དེ་ཡང་སོས་པར་བྱེད་དོ།",
    "ཉུང་མ་འཁྱག་པ་ལྟར་ཆུ་བུར་ཐུག་གིས་བྱུང་བའོ།",
    "ཆུ་བུར་རྡོལ་བ་ཅན་ནི་ཆུ་བུར་བརྡོལ་ནས་རྨར་སོང་པའོ།",
    "རང་གི་གྲོགས་གང་ལ་ཆགས་པ་དེས་ཡར་བོས་ནས།",
    "རྩེ་མོར་སླེབ་པའི་ཚེ་མར་འབོད་ནས་ཕྱིན་པས་ཚེར་མ་ཐམས་ཅད་རྩེ་མོ་ཡར་བསྟན་ནས་ལུས་འབིགས།",
    "རྩེ་མོར་ལྕགས་ཀྱི་བྱ་ཁྲས་ལུས་ཀྱི་ཤ་རྣམས་འཐོག།",
    "དེར་སྐྱེ་བའི་རྒྱུ་ནི་བྱི་བོ་བྱས་ནས་གཞན་གྱི་ཆུང་མ་དང་ཁྱོ་བརྐུས་པས་སྐྱེའོ།",
    "དེའི་ཕྱི་རོལ་ན་ཐལ་ཚན་གྱི་ཆུ་བོ་རབ་མེད་ཡོད་དེ།",
    "བྲེ་ལ་སྐྱོན་བྱས་ན་ལྕགས་ཀྱི་བྲེ་མོ་ཆེར་ལུས་གཏུབ་ཅིང་འགྱེངས་སོ།",
    "སྲང་ལ་སྐྱོན་བྱས་ན་ལྕགས་ཀྱི་སྲང་གི་ནང་དུ་ལུས་གཏུབས་ཤིང་འཇལ་ལོ།",
    "ཉི་ཚེ་བ་ནི་ཉིན་མོ་ལན་རེ་དང་མཚན་མོ་ལན་རེ་འཆི་བ་ལ་ཟེར།",
    "དེ་གཉིས་ནི་རང་གི་༩༩བ་ཕྱུགས་གཞན་ལ་གསོད་དུ་བཅུག་པ་ལས་སྐྱེའོ།",
    "དམྱལ་ཁམས་བཅུ་དྲུག་གི་ཆེ་ཚད་ནི།",
    "ལོ་བརྒྱ་བརྒྱ་ནས་ཏིལ་རེ་རེ་བཏོན་པས་དེ་རྣམས་ནམ་ཟད་པ་དང་ཚེ་འཕོ།",
    "ནང་གི་སྒྲིབ་པ་ཅན་བྱ་བ་མགོ་སྐོན་པ་ཙམ།",
    "ཉིན་མོ་གྲིབ་སོ་བྱུང་ནས་དགོངས་མོ་ཤིན་ཏུ་འགགས་ནས་འོང་།",
    "སྒོ་ཁྱུད་ཀྱི་སྒྲིབ་པ་ཅན་བྱ་བ་ཁ་ལ་མེ་འབར་བ་ཟོས་ཚད་ཁྲོ་ཆུ་ཁོལ་མར་སོང་ནས་ཁོང་བསྲེག་པར་བྱེད་དོ།",
    "བྱོལ་སོང་དུ་སྐྱེས་པ་ནི།",
    "གླིང་བར་དུ་ཉི་ཟླའི་འོད་མེད་པས་རང་གི་གཟུགས་མི་མཐོང་བ་དང་།",
    "ཉིང་ཤ་ཉིང་གིས་ཟ་བ་དང་།",
    "གཡང་དང་རྦབ་ཏུ་ལྷུང་བ་མང་པོ་ཡོད་དེ་དེ་དག་གི་ཚེ་ཚད་བར་བསྐལ་རེ་ཐུབ་པའང་ཡོད་དོ།",
    "བྱོལ་སོང་ཁ་འཐོར་བ་བྱ་བ་རྐང་བཞི་པའི་གཅན་གཟན་དང་རི་དགས་གྲངས་མེད་དེ།",
    "ནམ་མཁའ་ལྡིང་གིས་འཇིགས་པ་ལ་སོགས་པ་སྡུག་བསྔལ་ཤིན་ཏུ་ཆེའོ།",
    "ཚེ་ནི་བར་གྱི་བསྐལ་པ་རེ་ཐུབ་བོ།",
    "དེ་ལྟར་ངན་སོང་གསུམ་གྱི་སྐྱེ་གནས་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་པས།",
    "རང་གི་ལུས་ཀྱི་ཕུང་པོ་འདི་མི་རྟག་ནམ་འབོར་ཆ་མེད།",
    "ཕ་དང་མ་དང་ཁྱོ་དང་ཆུང་མ་དང་།",
    "ཁྱད་པར་དུ་མི་རྟ་ཁྱི་དང་རང་གི་ཕྱུགས་མི་བསད་རྣམ་སྨིན་ཆེ།",
    "འབྲིང་གིས་བདག་གཞན་མཉམ་པོ་ལ་བློ་སྦྱང་།",
    "སྤྱིར་དྲུག་དྲུག་སུམ་ཅུ་རྩ་དྲུག་གིས་བསྟན་པ་ལ།",
    "སྔོན་ལ་རང་གི་ལུས་སེམས་བསྐྱེད་པའི་ཕ་མ་དང་།",
    "རང་གི་ཚེ་གཅིག་གིས་འབྲེལ་བའི་གྲོགས་དང་ལན་ཆགས་ཀྱི་བུ་ཚ་དང་།",
    "ཤ་ཁྲག་གི་འབྲེལ་བར་གྱུར་པའི་སྤུན་དང་སྲིང་མོ་དང་ཉེ་གཞི་དང་།",
    "ངག་འཁྱལ་དང་བཞི་ངག་གིའོ།",
    "པའི་བློ་ཕྲ་མོ་ཡང་སྤང་ངོ།",
    "ངག་འཁྱལ་མི་བྱ་གསོང་པོར་སྨྲ།",
    "བསྡུ་བ་རྣམ་པ་བཞིའི་སྒོ་ནས་དོན་བྱ་བ་ལ་སྦྱིན་པར་བསྡུ་བ་ནི་ཟང་ཟིང་གི་སྦྱིན་པས་བསྡུ་བའོ།",
    "བཞི་པ་སྒྲིབ་གཉིས་སྤང་ཞིང་ཚོགས་གཉིས་བསག་པ་ནི།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་དུག་ལྔ་རྣམ་རྟོག་ཡིན།",
    "དེ་གང་གིས་སྤོང་ན་ལུས་ལྷ་ཐུགས་རྗེ་ཆེན་པོར་སྒོམ།",
    "ཉོན་མོངས་པ་སྐྱེ་བའི་ཡུལ་འཁོར་དང་འདུ་འཛི་གཡེང་བ་ཡིན་པས་དེ་རྣམས་དང་ཐག་བསྲིངས་ལ།",
    "མཚན་མོ་ནམ་སྟོད་དང་ནམ་སྨད་ལ་གཉིད་སྤངས་ལ་ཐུགས་རྗེ་ཆེན་པོའི་བསྐྱེད་རྫོགས་ཟུང་འབྲེལ་སྒོམ།",
    "དཔེར་ན་ལོང་སྤྲང་ཅིག་གིས་ང་རྒྱལ་པོ་ཡིན་ཞེས་ཁས་བླངས་ཀྱང་མི་བདེན་པ་དང་འདྲའོ།",
    "རྩོལ་སྒྲུབ་དང་བྲལ་བ་དེ་རང་གིས་རང་ལ་རྫུན་བཏབ་པས་ངན་སོང་དུ་འགྲོའོ།",
    "ནོར་རྫས་སྤྱད་མ་ལེགས་པ་དེ་རྔ་མོའི་ལུས་སུ་སྐྱེས་ནས་གྲོད་པ་ཆེ་ལ་མི་འགྲངས།",
    "ནོར་བདག་དེ་རྔ་མོའི་བདག་པོར་གྱུར་ནས་བཀོལ་སྤྱད་ཀྱི་ལན་ཆགས་འདོད་དུ་འོང་།",
    "ཐུགས་རྗེ་ཆེན་པོས་རིགས་དྲུག་སྤྱི་ལ་ཐུགས་རྗེའི་སྤྱན་གྱིས་ཁྱབ་པར་གཟིགས་ཤིང་།",
    "ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་བྱེ་བ་ཕྲག་བརྒྱར་སྤྲུལ་ནས་འགྲོ་བའི་དོན་མཛད་པར་གསུངས་པས།",
    "ཡང་སྒོས་སུ་བོད་ཁ་བ་ཅན་གདུལ་བྱར་གཟིགས་པས་བཀའ་དྲིན་ཆེའོ།",
    "བསྒོམ་བྱའི་ཡུལ་མ་གྲུབ་བདག་གིར་འཛིན་པ་དང་བྲལ།",
    "གྲག་པ་ལུང་གི་འཁྱེར་སོ་ནི།",
    "གསང་སྔགས་ཀྱི་ལམ་ཟབ་མོ་ཚེ་འདི་ལ་རྒྱུ་ལུས་ངག་ཡིད་གསུམ་མ་སྤངས་པར།",
    "བདུན་པ་བློ་ཆུང་གི་གང་ཟག་གིས་སྔགས་ལ་སྐུར་པ་བཏབ་པའི་སྐྱོན་བསྟན་པ་ནི།",
    "གསང་སྔགས་ཐབས་ཟབ་མོ་རྟོགས་པར་དཀའ་བ་བསྒྲུབས་ན་ཚེ་འདིར་འཚང་རྒྱ་བ་དེའི་དོན་མ་རྟོགས་ཉམས་སུ་བླངས་པས།",
    "མེ་ཏོག་རྙིང་པ་ལ་སོགས་པ་ལྷ་ལ་མིས་ཕུལ་བའི་མཆོད་རྫས་ལ་མི་འགོམ་མོ།",
    "དུས་བཟང་པོ་ལ་ཁྲུས་དང་གཙང་སྦྲ་ཉེ་རེག་དང་འཐོར་འཐུང་།",
    "སྐུའི་དམ་ཚིག་ཏུ་རང་གི་ལུས་སྲོག་བསྐྱེད་པའི་ཕ་མ་དང་།",
    "རང་གི་བློའི་མ་རིག་པ་སེལ་བའི་སློབ་དཔོན་དང་།",
    "དམ་ཚིག་གཅིག་གིས་སྤེལ་བའི་མཆེད་དང་ལྕམ་དྲལ་རྣམས་ལ།",
    "ངག་གི་སྒོ་ནས་ཕ་མ་ལ་འཇམ་པོར་སྨྲ།",
    "སློབ་དཔོན་ལ་ཞེ་ས་དང་མཆེད་གྲོགས་ལ་གསོང་པོར་སྨྲ།",
    "སློབ་དཔོན་ལ་མོས་གུས་ཀྱི་བསམ་པ་བསྐྱེད།",
    "ཕྲག་དོག་གིས་མཆེད་ལྕམ་ལ་ཡིད་འཁོན་དང་ཟུར་འགྲས་བྱས་ན།",
    "མཆེད་ལྕམ་ལ་དམ་ཚིག་ཉམས་ན་བྱོལ་སོང་དུ་འགྲོའོ།",
    "གསུང་གི་དམ་ཚིག་བསྲུང་མཚམས་ནི།",
    "འབྲིང་གིས་ཐུན་བཞིའམ་གསུམ།",
    "ཐ་མས་ཀྱང་ཉིན་རེ་ནུབ་རེ་ལ་ཐུན་རེ་བསྒོམ་མོ།",
    "གསུང་གི་དམ་ཚིག་ཉམས་པའི་སྐྱོན།",
    "ཕྱག་རྒྱ་མི་བྱེད་པར་གཞན་ནོར་ལ་མ་བྱིན་པར་ལེན་པ་ཕྱི་མ་ལ་ངན་སོང་གི་གཡང་སར་ལྟུང་ངོ།",
    "དད་པ་མེད་པ་མི་སྐྱ་ཕོ་མོ་ལྟ་བུ་སྣོད་དང་མི་ལྡན་པ་ལ་གསང་སྔགས་ཟབ་མོ་གསང་བར་འོས་པས།",
    "ཐུགས་རྗེ་ཆེན་པོ་སྤྱན་རས་༡༡༡ན་གཟིགས་བྲམ་ཟེའི་ཁྱེའུར་སྤྲུལ་པ་ལ།",
    "དཔེར་ན་བཟའ་ཤིང་གི་ར་བར་དུག་གི་སྡོང་པོ་ཅིག་སྐྱེས་ན།",
    "དུག་གི་སྡོང་པོ་དང་བཟའ་ཤིང་དེ་ན་ཇི་ཙམ་ཡོད་པ་དུག་ཏུ་བཏང་ནས་མེད་པར་བྱེད་དོ།",
    "གཟའ་ཤིང་གི་བདག་པོས་དུག་དེ་མཐོང་མ་ཐག་ཏུ་རྩ་བ་ནས་ཕྱུང་ནས་གཞན་དུ་བོར་ན་བཟའ་ཤིང་རྣམས་དུག་ཏུ་མི་འགྲོའོ།",
    "ལུང་པ་གཅིག་གི་ཆུ་ལ་ཡང་ལྷན་ཅིག་ཏུ་མི་འཐུང་ངོ།",
    "དམ་ཚིག་གི་དཔེ་བསྟན་པ་ནི།",
    "གསང་སྔགས་ཀྱི་སྒྲུབ་པ་ཐམས་ཅད་གཞི་ཐམས་ཅད་དམ་ཚིག་གིས་བཟུང་ན་མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་ཅི་འདོད་འབྱུང་ངོ།",
    "ཉམས་ན་ལུས་ངག་ཡིད་གསུམ་ངན་སོང་གསུམ་དུ་ཚིག་པས་དམ་ཚིག་ཅེས་བྱའོ།",
    "བྱ་བའི་རྣལ་མ་ལ་རྩོལ་མེད་ཀྱི་ངང་གིས་འབྱོར་ན་རྣལ་འབྱོར་གྱི་ངེས་ཚིག་ཡིན།",
    "རང་གསལ་གྱི་རྣལ་མ་ལ་བསམ་མེད་ཀྱི་ངང་གིས་འབྱོར་ན་རྣལ་འབྱོར་གྱི་ངེས་ཚིག་ཡིན།",
    "རྣམ་རྟོག་རང་བྱུང་གི་རྣལ་མ་ལ་རང་ཞི་རང་དག་ཏུ་འབྱོར་ན་རྣལ་འབྱོར་གྱི་ངེས་ཚིག་ཡིན།",
    "སྒོམ་མེད་རྣལ་མའི་སྟེང་དུ་ཡེངས་མེད་ངང་གིས་འབྱོར་ན་རྣལ་འབྱོར་གྱི་ངེས་ཚིག་ཡིན།",
    "ཅེར་མཐོང་གི་རྣལ་མའི་ཐོག་ཏུ་འཛིན་མེད་ཀྱི་ངང་གིས་འབྱོར་ན་རྣལ་འབྱོར་གྱི་ངེས་ཚིག་ཡིན།"
  ]
