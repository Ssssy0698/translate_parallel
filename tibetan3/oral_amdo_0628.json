    "གཉེན་དང་འབྲེལ་བར་འཛིན་པ་ཡང་རང་གི་སེམས།",
    "དེ་ལྟར་ཉིན་མོ་སྣང་བ་ལམ་༣༧བ་དུ་ཁྱེར་བས་ཐུགས་རྗེ་ཆེན་པོའི་དགོས་པ་རྒྱུན་མི་འཆད་པའོ།",
    "གཉིས་པ་མཚན་མོ་གཉིད་དང་རྨི་ལམ་ལམ་དུ་འཁྱེར་བ་ལ་མ་ཎི་བཀའ་འབུམ།",
    "ཐོ་རངས་གཉིད་སད་ནས་གསལ་སྟོང་གི་ཡེ་ཤེས་གསལ་བཏབ་པའོ།",
    "རྨི་ལམ་ལ་དངོས་པོ་མ་གྲུབ་པས་རང་གི་སེམས་ཀྱི་འཁྲུལ་པ་ཡིན་པར་ཤེས་པས།",
    "རྨི་ལམ་དུ་བདེ་སྡུག་གི་རྣམ་པ་ཅི་བྱུང་ཡང་རང་གྲོལ་དུ་འགྲོའོ།",
    "དམ་པ་དྲུག་གིས་ཟིན་པར་བྱས་ནས།",
    "ཞེས་རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པ་བྱས་ནས་བགྲངས་པས།",
    "མར་མེ་དང་རོལ་མོ་ལ་སོགས་པ་དང་།",
    "ནང་གི་འདོད་ཡོན་ལྷ་མོ་མང་པོས་མཆོད།",
    "རང་གི་བདུན་ཚིགས་རང་གིས་བྱ་བ་དང་གཉིས།",
    "རང་གི་རོ་བསྲེགས་རང་གིས་བྱ་བ་དང་གསུམ།",
    "རང་གི་རོ་རྫོངས་རང་གིས་བྱ་བ་དང་བཞི།",
    "རང་གི་རོ་ཟན་རང་གིས་གཏད་པ་དང་ལྔ།",
    "རང་གི་རོ་ཁུར་རང་གིས་བྱས་ལ་སྦ་བ་དང་དྲུག་གོ།",
    "རང་ཐུགས་རྗེ་ཆེན་པོར་སྐད་ཅིག་གིས་བསྐྱེད་ལ་ལག་པ་མཆོད་སྦྱིན་གྱི་ཕྱག་རྒྱ་བཅས་ལ།",
    "དེ་ཡང་རང་གི་འཁོར་ལོངས་སྤྱོད་ལ་གནོད་དམ་སྙམ་ན་བློས་མ་ཐོངས་པ་ཡིན་པས།",
    "འོ་ན་ཁྱོད་ཀྱིས་ང་ལ་བུ་དང་།",
    "༤ན་བུ་མོ་དང་ནོར་ལ་སོགས་པ་སྲོང་དང་ཟེར་ནས་སུན་འབྱིན་པ་འོང་བས།",
    "གཉིས་པ་རང་གི་བདུན་ཚིགས་རང་གིས་བྱ་བ་ནི།",
    "གནམ་སྟོང་ལ་དེ་ཚོའི་བར་ན་ཞག་བདུན་རེ་ཡོད་པས།",
    "སྟེང་ལྷ་དང་ལྷ་མ་ཡིན་གྱི་སྲིད་པ་བར་མི་དང་བྱོལ་སོང་གི་སྲིད་པ།",
    "དེ་ལྟར་ཟླ་བ་རེ་ལ་སྦྱིན་གཏང་ཐེབས་བཞི་རེ་བཏང་ནས་བདུན་ཚིགས་རྒྱུན་མི་བཅད་དེ།",
    "གསུམ་པ་རང་གི་རོ་བསྲེག་རང་གིས་བྱ་བ་ནི།",
    "ཆགས་ཞེན་དང་བག་ཆགས་ངན་པ་ཐམས་ཅད་བཏུལ་ལ་བསྲེགས་ནས་རང་གི་སེམས་ཀྱི་རྣམ་པ་ཧྲཱི་དཀར་པོ་ཅིག་ཏུ་གྱུར་བར་བསམ་མོ།",
    "འོད་དུ་ཞུ་ནས་ཐུགས་རྗེ་ཆེན་པོའི་སྐུར་གྱུར་པར་བསམ་མོ།",
    "ཞིབ་པ་རང་གི་རོ་རྫོངས་རང་གིས་བྱ་བ་ནི་དུས་ནམ་ཡང་རུང་སྟེ།",
    "རང་གི་ཁྱིམ་མ་ཡིན་པ།",
    "དེ་ནས་གཟུག་ཏུ་གསིལ་དེ་ནས་ཤ་ཁམ་རེ།",
    "ཁྲག་ཐིགས་རེ།",
    "ཕྱི་མ་ངན་སོང་དུ་མི་འགྲོའོ།",
    "༤ ༢ན་ལྔ་པ་རང་གི་རོ་ཟན་རང་གིས་བཏང་བ་ནི།",
    "བཀྲག་དང་གཟི་མདངས་དང་ལྡན་པར་བསམ་མོ།",
    "དྲུག་པ་རང་གི་རོ་ཁུར་རང་གིས་བྱེད་པ་ནི།",
    "མཚོན་པ་སྣང་བ་ཚོགས་ལམ་མོ།",
    "རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པ་བྱས་ལ།",
    "བློ་སྣང་གི་རྫས་ཐམས་ཅད་ཚོགས་སུ་ཕུལ་ཏེ།",
    "རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པ་བྱས་ལ།",
    "སྒོས་རང་གི་ཉེ་འབྲེལ་ལ་སོགས་པ་ཐམས་ཅད།",
    "ཡང་སྒོས་སུ་རང་གི་ལུས་འདི་ལ་ཞེན་པས།",
    "ཞེན་སྣང་གི་མཚན་མ་ཐམས་ཅད་ཚོགས་སུ་འབུལ་ཏེ།",
    "རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པ་བྱས་ན།",
    "རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པས།",
    "རེག་བྱ་བདེ་འཇམ།",
    "དེ་ཐམས་ཅད་རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པ་བྱས་ལ།",
    "རང་ཐུགས་རྗེ་ཆེན་པོར་མོས་པ་བྱས་ལ།",
    "ལོངས་སྤྱོད་ལྡན་ཞིང་ཚོགས་རྫོགས་ནས།",
    "སྤྱོད་པའི་གཏོར་མ་གསུམ་མོ།",
    "རང་གི་སེམས་ཉིད་སྐྱེ་བ་མེད་པ་གཏོར་སྣོད།",
    "བག་ཆགས་རང་རླག་ཏུ་སོང་ན་གཏོར་མ་ཐེངས་པའོ།",
    "མོས་གུས་བསམ་པ་དག་ན་གཏོར་མ་ཐེངས་པ་ཡིན་ནོ།",
    "འདུས་བྱས་དང་སྐྱེ་འཇིག་གི་དྲི་མ་གཉིས།",
    "ཏིང་འཛིན་དང་དུ་བླངས་ལ་བསྐྱེད་རྫོགས་ཟུང་འབྲེལ་སྒོམ་མོ།",
    "ཆང་དང་བུད་མེད་ལ་དགའ་ན་ཉེས་པའི་རྩ་བ་ཡིན་པས་སྤང་།",
    "ཉོན་མོངས་མི་སྤོངས་ན་ཡུན་རིང་དུ་བསྒོམས་ཀྱང་མིང་གི་སྒོམ་ཆེན་དུ་གོལ།",
    "དམ་བཅའི་གཙོ་བོ་རང་གི་ལུས་ཐུབ་པ།",
    "ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་ཆེན་པོ་བཟོད་དུ་རེ་བ་འདི་ཡང་ཤིན་ཏུ་བླུན།",
    "ཚེ་འདིར་རྟག་ཏུ་རེ་ནས་དོན་དུ་གཉེར་བ་འདི་ཡང་ཤིན་ཏུ་བླུན་ནོ།",
    "གསང་སྔགས་གསང་བའི་སྒོར་ཞུགས་ནས་དམ་ཚིག་མི་བསྲུང་བར་གསང་སྔགས་ཕྲག་ཚོང་བྱེད་པའི་སྔགས་པ་ཀུན་ངོ་རེ་ཚ།",
    "ལུས་ལ་བྱི་དོར་བྱས་ནས་གསེར་གཡུ་ལ་སོགས་རྒྱན་གྱིས་བརྒྱན་པའི་སྐྱེས་པ་བུད་མེད་འཕྱོར་སྒེག་ཅན་ཚོ་ངོ་རེ་ཚ།",
    "སྐྱོན་འོང་བ་བདུན་ལ་ཐོས་པ་ཆུང་ན་ཐེ་ཚོམ་དང་རེ་དོགས་ཀྱི་སྐྱོན་འོང་།",
    "འབྲས་བུ་རེ་དོགས་དང་བཅས་པ་སྐྱོན།",
    "འབྲས་བུ་མེ་ཤིང་རྒྱུ་ཟད་རྐྱེན་ཟད་དུ་སོང་ན་སྐྱོན་མེད།",
    "དམ་ཚིག་ཤེལ་གོང་ཡེ་དག་དྲི་མེད་རྣམ་དག་ཏུ་སོང་ན་སྐྱོན་མེད།",
    "དུག་ལྔ་རང་སར་གྲོལ་ན་ངན་སོང་གཞི་མ་མེད།",
    "མོ་མཐོང་དད་པ་ཅན་ཁོང་ལ་ཐེ་ལེས་ཐོབ།",
    "ཉོན་མོངས་སྲིད་པ་དང་འབྲལ་མི་ཕོད།",
    "སྒོམ་སར་བུད་མེད་ཁྲིད་པ་བདེ་རུ་རེ་ཡང་སྡུག་སྟེ་ཞན།",
    "སྒོམ་སར་ལོངས་སྤྱོད་བྱེད་པ་རྒྱགས་སུ་རེ་སྟེ་ཞན།",
    "སྒོམ་སར་འདུ་ལོང་བྱེད་པ་ལེགས་སུ་རེ་སྟེ་ཞན།",
    "སྒོམ་སར་ལོང་གཏམ་བྱེད་པ་དགའ་རུ་རེ་སྟེ་ཞན་ནོ།",
    "རང་སེམས་༤༩བ་རང་གིས་མཐོང་ནས་རང་ངོ་ཤེས་ན་བཟང་ངོ།",
    "ཉེ་འབྲེལ་ཆགས་སྡང་གི་རྒྱུ་ཡིན་པས་རྒྱང་བསྲིང་ནས་སྡོད་པ་གལ་ཆེ།",
    "འོང་བས་ངན་སོང་གི་སྡུག་བསྔལ་དྲན་པ་གལ་ཆེ།",
    "དཀོན་ཡི་མཆོག་གསུམ་ལ་སྐྱབས་སུ་སོང་ནས་བསླུས་པ་མེད།",
    "ལྷ་ཐུགས་རྗེ་ཆེན་པོ་ལ་མོས་པ་གདུལ་བྱ་དུས་ལ་བབ་པ་ཡིན།",
    "ལུས་ལ་རང་གིས་རྒས་པར་ཚོར་ན་འཆི་བའི་བྱ་གཏོང་བྱུང་བ་ཡིན་ནོ།",
    "མཁས་པའི་ཞལ་མ་མཐོང་བར་ཤེས་སུ་རེ་བའི་བནྡེ་བླུན་ཏེ་ངན།",
    "དཔོན་སློབ་དཀོར་ལ་སྤྱོད་པ་ངན་སོང་རིན་གྱིས་ཉོ་བས་ངན་ཏེ་ལྔ།",
    "འབྲས་བུ་ཐམས་ཅད་རེ་དོགས་མེད་པར་ལ་བཟླའོ།",
    "རུས་སྦལ་འཁར་གཞོང་དུ་བཅུག་ན་རྐང་ལག་གིས་འགུལ་མི་ནུས་པ་ལྟར།",
    "རི་གཟར་ཁ་ནས་བུད་ཉིལ་༥༦བ་བས་ས་རྡོ་ཅི་འདུག་བུད་སྣ་ལ་འཁྱེར་བ་ལྟར།",
    "སྐྱར་མོས་ཉ་ཁྱེར་བ་ཁ་ནས་ཤོར་བས་བཟའ་བའི་ཞེན་པ་ལོག་པ་ལྟར།",
    "དྲན་རྟོག་ཐམས་ཅད་རང་ཞི་རང་བྱུང་དུ་སྒོམ་མོ།",
    "ཅི་སྣང་ཅི་སྲིད་ཐམས་ཅད་ཡེ་ཤེས་རང་བྱུང་གི་སྣང་བར་སྤྱད།",
