    "ད་ནི་ཐ་མལ་དགག་པའི་ཕྱིར་བདགགི།",
    "ལུས་ཉོནམོངས་པ་ཁོ་ན་ར་ཟད།",
    "ཡིད་ནི་བརྟན་ནམ་གཡོ་ཞེས་བྱབ་ནི་བསྐྱེད་པའི་རིམ་པ་སྤྱིའི་མཚན་ཉིད་ཙམ་མོ།",
    "རང་གི་སེམསབརྟན་པ་ནི་ཡིད་མི་གཡོ་བར་རོ།",
    "བདག་མེད་རྣལ་འབྱོར་ནི་བདག་མེད་པར་བསྒོམས་པར་ལྡནཔའི་བུད་མེད་དོ།",
    "བུད་མེད་གཟུགས་ནི་སྤང་ཞེས་པ་ནི་ཕྱག་རྒྱའི་རྟེན་རྣམ་པརབསྒྱུར་བ་སྟེ་བསྟན་པའོ།",
    "ཉོན་མོངས་པའི་སྐྱེ་བ་ཡིན་པསསོ།",
    "དེ་དག་གིས་ནི་བསྐྱེད་པའི་རིམ་པ་ཐབས་ཀྱི་ཆོ་གདག་པར་བྱས་ནས།",
    "ཡངཕྱག་རྒྱ་ཆེན་པོ་ནི་ཤེས་རབ་ལྷ་མོ་བླ་ན་མེད་པའོ།",
    "བཙུན་མོ་བྷ་ག་བདེ་ཆེན་དུ།",
    "ཡང་རྡོ་རྗེ་བཙུན་མོ་ནིགཟུགསདང་ལང་ཚོ་ལ་སོགས་པ་དང་ལྡན་པའོ།",
    "བྷ་ག་ནི་བྱ་རོག་གིགདོང་ཅན་ཏེ་ཡེ་ཤེས་ཀྱི་སྐལ་བ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "ཡང་རྡོ་རྗེ་བཙུན་མོ་ནི་རྡོ་རྗེ་ལུསརྩའོ།",
    "ཡང་རྡོ་རྗེ་བཙུན་མོ་ཤེས་རབ་ལྷ་མོ་བླ་ན་མེད་པའོ།",
    "མཆོག་དགའ་དགའ་བྲལ་དང་པོ་ནི་གསུམ་པའམ་ཁྱད་པརཏེ་ཀུན་རྫོབ་དང་དོན་དམ་མོ།",
    "འོ་ན་ལས་ཀྱིས་ཆོ་ག་མོད་ལྷ་བསྐྱེདཔ་ཅི་དགོས་ཤེ་ན།",
    "འོ་ན་བསྐྱེད་མི་དགོས་པསབསྐྱེད་རིམ་མ་ཡིན་ནོ་ཞེ་ན་དེའི་ཕྱིར་བསྐྱེད་ཙམ་ཉིད་ན་ཞེསབྱ་བ་ནི་ལུས་ལྷར་བྱས་པ་ཙམ་མོ།",
    "དུག་གི་དུམ་བུ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ལྟ་བཤེས་རབ་ཀྱིས་སྤྲོ་བ་དང་མཚན་མས་སྤྲོས་པའི་དཔེ་སྟེ་དེ་ཡངམུ་སྟེགས་སུ་འབྲེལ།",
    "དེ་ཡང་རྟག་ཆད་ཀྱི་སྤྲོས་པ་དུག་གི་དེ་ཉིདཤེས་མི་གནོད་ལ་མ་ཤེས་ན་གནོད་པ་སྟེ།",
    "གང་དང་གང་གི་སྤྱིར་ཉོན་མོངས་པ་དང་མཚུངསཔར་ལྡན་པའི་སེམས་སོ།",
    "དེ་ཉིད་ལས་དང་ཉོན་མོངས་པའོ།",
    "དེ་དག་གིས་སྤྱིར་བསྟན་ནས་སྒོམཔ་ཁྱད་པར་དུ་བསྟནཔའི་ཕྱིར།",
    "རྣམ་གྲོལ་ནི་དེ་ཁོ་ནཉིད་ལ་མོས་པ་ཙམ་ནི་མ་ཡིན་གྱི།",
    "ལྷན་ཅིག་སྐྱེས་པའི་རང་གིམཚན་ཉིད་སྐྱེ་བའིཕྱིར་རོ།",
    "འདོད་ཆགས་ལ་སོགས་སེམས་ལྔ་ནི་ཉོནམོངས་པའི་གནས་སྐབས་སོ།",
    "རྒྱུད་ཀུན་གྱི་གླེང་གཞིནི་ཨཨེ་ཝཾ་མོ།",
    "གང་གིས་སྡོམ་ནམ་ཡཱ་སྟེ་དབངརྣམ་པ་བཞིའི་ཚུལ་གྱིས་སྡོམ་སྟེ།",
    "ས་མ་ཡ་སྟེ་དེ་དག་གི་དུས་སུ་བཟའ་བ་ཚོགས་ཀྱི་འཁོར་ལོདང་།",
    "ནང་གི་སྙོམས་འཇུག་རང་ལུས་ལ་བརྟེན་པ་དང་།",
    "དེ་དགནི་གང་གིས་སྡོམཔ།",
    "གཞན་ཡང་དམཚིག་གི་ཕྱག་རྒྱའི་དགའ་བ་བཞི་དང་།",
    "དང་པོས་ནི་རྡོ་རྗེའཆག་གི་རིགས་སུ་བྱེད་དོ།",
    "གཉིས་པས་ནི་རྡོ་རྗེ་འཆང་གི་སྲས་སུབྱེད་དོ།",
    "གསུམ་པས་ནི་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ལ་འགོད་ངོ།",
    "བཞི་པས་ནི་རྡོ་རྗེ་འཆང་གི་ངོ་བོརབྱས་ཏེ་གཞན་དོན་ཡོངས་སུ་རྫོགས་པའི་གོ་འཕང་ལ་འདོད་དོ།",
    "ཤེས་རབ་ནི་དེ་མ་ཐག་གི་ཕྱག་རྒྱའོ།",
    "དེནས་གོངགི་བྲྗོད་ནས་བཏང་པར་འབྲེལ་ཏེ།",
    "བྲྗོད་པར་བྱས་པ་ཞེས་པ་ནི་དེམ་ཐག་གི་མན་ངག་གོ།",
    "ཇི་ལྟརརིགས་པ་ནི་རིགས་པ་གང་གིས་སོ།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་གསད་པར་བྱ།",
    "ཕརོལ་བུད་མེད་བསྟེན་པར་གྱིས།",
    "ཞེས་བྱ་བ་ནི་འདི་དག་གི་དགོངས་པནི་བཞི་སྟེ།",
    "བཅུ་ན་མོ་ཞུ་བ་མ་བྱིན་པནི་ཟླ་བ་མ་ཡིན་པར་ཉི་མ་བླང་བའི་མན་ངག་གོ།",
    "གཞན་གྱིབུད་མེད་རང་མཚུངས་མཛེས།",
    "ནམ་མཁའི་མཐོང་དང་སེན་མོ་མཐོང་།",
    "ཕ་རོལ་གྱི་བུད་མེད་བསྟེན་པ་ནི་གཞན་ཕརོལ་སྲོག་གི་སྐྱབས་སུ་གྱུར་ན་འདོད་པ་ལོགས་པར་ཀྱང་སྤྱོད་དེ།",
    "ཡང་ནའདོད་ནསྟེ་ཟབ་མོ་ལ་མོས་ནའོ།",
    "ལྷའི་ས་བོན་ལས་མོས་པ་མི་མཐུན་པ་འཇུགམི་ནུས་པས་ཀ་བ་ཙ་སྟེ་གོ་ཆའམ་ཁྲབ་བོ།",
    "དེའི་ཕྱག་རྒྱ་ནིགཡུང་མོ་ལ་སོགས་གོ་སླའོ།",
    "རང་གིདམ་ཚིག་རིགས་རྙེད་ནས།",
