    "དེའི་ཕྱིར་རིམ་པ་ངེས་པ་དང་ལྡན་པ་དེ་དག་སྐྱེས་བུས་མ་བྱས་པར་འདོད་ལ།",
    "ཤུགས་ཀྱིས་བཟློག་པ་ནི་སྐྱེས་བུས་བྱས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་གྲུབ་པོ།",
    "རྐན་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པས་སུན་འབྱིན་པར་བྱེད་དེ།",
    "རིམ་པ་ངེས་པ་དང་ལྡན་པར་མ་གྲུབ་སྟེ།",
    "འདི་ཐམས་ཅད་ཡི་གེ་རྣམས་ལ་ཡང་བརྟག་པར་ནུས་སོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "འདི་འདྲ་གང་དེ་བསྟན་པར་མཐོང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་སྤྱོར་བ་ལྔས་གལ་ཏེ་གཞན་སེལ་བའི་མཚན་ཉིད་ཀྱི་སྤྱི་གཅིག་ཉིད་དུ་སྒྲུབ་པར་བྱེད་པ་༥དེའི་ཚེ་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པས་ཀྱང་གནོད་པར་སྟོན་པ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་༡༡གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "དམིགས་གཟུང་བ་ལང་ཉིད་བརྗོད་པར།",
    "དེས་ན་གྲུབ་པ་ལ་སྒྲུབ་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟར་སྒྲུབ་པ་ལ་གཏན་ཚིགས་མ་༦གྲུབ་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་གཞན་སྤངས་ནས་དེ་ཙམ་ཤེས་པར་འདོད་པ་ལ་གཞན་ལས་ལྡོག་པ་དང་གཞན་སེལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་གྲངས་རྣམས་ཀྱིས་བརྗོད་པ་ཡིན་ནོ།",
    "གཞན་ཡང་མ་བརྗོད་པ་ན་ཡང་རྒོལ་བས་འདོད་པས་ཡུལ་དུ་བྱས་པ་གང་ཡིན་པ་གེཁོ་ན་བསྒྲུབ་བྱར་འདོད་ལ།",
    "ཐབས་འདིས་ག་གཅིག་ཉིད་དུ་བསྟན་པར་འདོད་པ་ཡིན་ལ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཞེས་བྱ་བ་ལ་༦འདིར་ཡང་བརྗོད་པ་ཞེས་རྟགས་༧དང་རྣམ་པར་དབྱེ་བ་ཡོངས་སུ་བསྒྱུར་ལ་སྦྲེལ་བར་བྱའོ།",
    "མཚུངས་པར་རྟོག་པའི་ཤེས་པ་གཅིག་ཉིད་དུ་ཞེན་པའི་ཕྱིར་རོ།",
    "གང་ཚེ་སྒྲ་ཙམ་ལེགས་བྱས་པའི།",
    "མྱུར་བ་དང་དལ་བ་དང་བར་མའི་རྣམ་པར་ཤེས་པ་སྐྱེ་ལ།",
    "འདི་སྙམ་དུ་སྒྲ་དེ་ཉིད་མྱུར་བ་ལ་སོགས་པའི་ངོ་བོས་རྣམ་པ་གཞན་དུ་སྣང་བ་དེ་ནི་དེའི་དམིགས་པར་འགྱུར་ཏེ།",
    "ཤེས་པ་རྣམ་པ་མེད་པར་སྨྲ་བའི་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པ་ནི་དོན་དུ་གཏོགས་པ་ཉིད་ཉམས་སུ་མྱོང་བ་ཡིན་ཀྱི།",
    "འོན་ཏེ་སེར་པོ་ལ་སོགས་པའི་རྣམ་པ་གལ་ཏེ་དོན་དུ་གཏོགས་པ་མ་ཡིན་པ་དེའི་ཚེ་གདོན་མི་ཟ་བར་དེ་ཤེས་པར་གཏོགས་པར་འགྱུར་དགོས་ཏེ།",
    "དེ་ལྟ་༤ཡིན་དང་ཤེས་པར་གཏོགས་པ་ཡིན་ན་ཇི་ལྟར་ཤེས་པ་རྣམ་པ་མེད་པ་ཞེས་བརྗོད་པར་བྱ་ཞེ་ན།",
    "འོན་ཀྱང་ཤེས་པ་རྣམ་པ་མེད་པར་སྨྲ་བའི་ཕྱོགས་ཁས་བླངས་ནས་ཤེས་པའི་ཡུལ་མེད་པ་འདི་བརྗོད་དེ་༥།",
    "གང་ཞིག་ཤེས་པ་རྣམ་པ་མེད་པར་འདོད་པ་དེ་ཉིད་ལ་འདིར་ལན་བརྗོད་པར་བྱའོ།",
    "གསལ་བྱེད་ཡོད་པར་རིགས་མ་ཡིན།",
    "ཁྱད་པར་ཅུང་ཟད་ཀྱང་མི་བྱེད་པ་དེ་ནི་གསལ་བར་བྱེད་པར་རིགས་སྙེ་༡པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་གང་སུ་ཡང་རུང་བ་གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་གསལ་བར་བྱེད་པའི་ལེགས་པར་བྱེད་པའི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་སྒྲ་ཙམ་སྟེ།",
    "སྒྲ་ལ་བློ་ཐ་དད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "རྣ་བ་ལེགས་པར་བྱས་སུ་ཟིན་ན་ཡང་།",
    "འོན་ཏེ་མི་ནུས་ཞེས་བྱ་བ་འདི་བརྗོད་པར་བྱ་དགོས་སོ།",
    "རྣ་བ་ལེགས་པར་བྱས་ན་དོན་༥།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་བརྗོད་པར་བྱ་ལརྣ་བ་ལེགས་པར་བྱས་པ་དོན་མེད་པར་ཡང་མི་འགྱུར་རོ།",
    "རྣ་བ་ལེགས་པར་བྱས་ན་ཡང་སྒྲ་དམིགས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་ཕྱོགས་འདི་ལ་ཡང་རྣ་བ་ལེགས་པར་བྱས་པ་དོན་མེད་པ་ཉིད་ཡིན་ནོ།",
    "སྤྱོར་བ་ནི་གང་དག་གང་སྐྱེད་༡པར་བྱེད་པར་མི་རུང་བའི་གནས་སྐབས་ལས་ཁྱད་པར་མེད་པ་དེ་ནི་དེ་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རྣ་བ་ལེགས་པར་བྱས་ན་ཡང་སྒྲ་ཤེས་པར་སྐྱེད་པར་མི་རུང་གནས་སྐབས་ལས་ཁྱད་པར་མེད་དོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པའོ།",
    "གལ་ཏེ་སྒྲ་ཤེས་པ་སྐྱེད་པ་ལ་རྒྱུ་ཡིན་པར་འདོད་པར་གྱུར་ན།"
  ]
}