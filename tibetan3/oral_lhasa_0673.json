    "ཕྱོགས་མེད་པར་སྦྱིན་པ་བྱེད་པ་ཉིད་སྟོན་ཏོ།",
    "མི་གནས་པར་སྦྱིན་པ་ཉིད་ནི་ལན་དང་རྣམ་པར་སྨིན་པ་མི་འདོད་པ་ལྐུཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལུས་འདི་ཁོ་ན་གནས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སྟོབས་ཡོད་པར་བྱ་བའི་ཕྱིར་ཏེ་༡་༧།",
    "ཚངས་པར་སྤྱོད་པ་རྗེས་སུ་གཟུང་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ལུས་གནས་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་གང་ཞེ་ན།",
    "ཚོར་བ་གསར་ནི་མི་སྐྱེ་བར་བྱས་ནས་ཞེས་བྱ་བ་ནི་ཧ་ཅང་བཟའ་དྲགས་པ་ལས་སྐྱེ་བ་གང་ཡིན་པའོ།",
    "འདིས་ནི་ཟས་ཆུང་ངུ་དང་ལྷག་པར་ཟ་བ་ཡོངས་སུ་སྤོང་བར་བྱེད་དོ།",
    "དེ་ལྟ་བུས་ཞེས་བྱ་བ་ནི་ཚོད་ཡང་དག་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་དག་ཀྱང་ཚངས་པར་སྤྱོད་པ་རྗེས་སུ་བཟུང་འུ་བ་ལྟར་སྔར་བསྟན་པ་གང་ཡིན་པའོ།",
    "དེ་ལ་ཧ་ཅང་བཟའ་དྲགས་པའི་སྐྱོན་མེད་པའི་ཕྱིར་ཁ་ན་མ་ཐོ་བ་མེད་པ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་སེམས་ཐམས་ཅད་ཀྱིས་བསམས་ནས་རྣམ་པར་ལྟ་བ་ནི་རྒྱུ་བ་ན་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཚོར་བ་དང་འདུ་ཤེས་ཤེས་བཞིན་པ་ནི་བསམ་གཏན་པ་དང་གཟུགས་མེད་པའི་མཉམ་པར་གཞག་པ་ལ་གནས་པ་ན་སྟེ།",
    "རྣམ་པར་རྟོག་པ་ཤེས་བཞིན་པ་ནི་ལངས་ཤིང་མཉམ་པར་མ་བཞག་ཤྱི་པ་ལ་གནས་པ་ཡིན་ནོ།",
    "སེམས་པའི་མཚན་ཉིད་ནི་འདིར་རྣམ་པར་རྟོག་པ་༧ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལྟར་ན་རྣམ་པར་ཤེས་པ་གནས་པ་བཞི་དག་ལ་དྲན་པ་དང་ཤེས་བཞིན་མཆོག་དང་ལྡན་པ་ཉིད་ཡིན་པར་ཡོངས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "དུས་གཞན་དུ་ཡང་རྗེས་སུ་འཇུག་པས་གནས་པར་རིག་པར་བྱའོ།",
    "མྱངས་པ་རྣམས་ལེགས་པར་བདེ་བར་འཇུ་སྟེ།",
    "མྱངས་པ་རྣམས་ལེགས་པར་བདེ་བར་འཇུ་ཞེས་བྱ་བས་ཧཱུཾའཆད་དེ།",
    "འདིས་ནི་ཟས་ཀྱི་རྣམ་པ་ཐམས་ཅད་དུས་སུ་ངལ་བ་མེད་པར་འཇུ་བར་ཤེབྱེད་པ་སྟོན་ཏོ།",
    "སྩོགས་ཐོབ་ཡིན་པར་བཞེད་འདིར་ནི།",
    "དེ་ལ་ཟེགས་པ་ཉིད་དུ་འགྱུར་བ་ནི་རྣམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དྲི་བསུང་ཆུང་བར་འགྱུར་བའི་ཕྱིར་ནི་རྣམ་པར་འགྱུར་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "བཟློག་ཏུ་ཟིན་ཡང་རྒྱུ་བསགས་པ་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་རྣམ་པ་ཀུན་ཏུ་རྒྱུ་བ་ཉིད་ཡིན་པས་སེལ་བར་བྱེད་དེ།",
    "ས་བོན་ཡང་དག་པར་འཇོམས་པའི་ཕྱིར་རོ།",
    "ལྷ་ལ་གུས་པ་དང་མ་གུས་ང་རྣམས་ལ་ལོངས་སྤྱོད་རྒུད་པ་དང་ཕུན་སུམ་ཚོགས་པར་དམིགས་པའི་ཕྱིར་དང་།",
    "སྐྱེ་བ་དམན་པ་དང་ཁྱད་པར་དུ་འཕགས་པ་དམིགས་པའི་ཕྱིར་དང་།",
    "འགོག་པར་འགྱུར་བར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་སྡུག་བསྔལ་ཉིད་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "གཞན་ཡང་དགའ་བའི་འདོད་ཆགས་ཀྱི་རྒྱུ་ལས་བྱུང་བའི་ཚེ་ཕྱི་མ་ལ་སྡུག་བསྔལ་སྐྱེ་བ་དེའི་གཉེན་པོར་གོ་རིམས་བཞིན་དུ་གསུམ་གསུངས་པ་ཡིན་ནོ།",
    "ཆགས་པ་ཟད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སྲིད་པ་ཟད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སྙུག་བསྔལ་ཟད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དེ་སྨོས་པ་ཡང་འཕྲོག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གྲོ་ཞིན་རྡུསྐྱེས་དེ་བས་ན་མཉམ་པ་ཉིད་དུ་རྟོགས་པར་བྱས་ལ་དེ་ལ་ཡང་མཚན་མར་ཟུང་ཤིག།",
    "འདིས་ནི་མཉམ་པ་ཉིད་དུ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "མཉམ་པ་ཉིད་དེས་ཁེངས་པར་མི་འགྱུར་བའི་ཕྱིར་དང་།",
    "མི་གཡོ་བར་འབར་བ་ཉིད་དུ་ཡང་དག་པར་སྡུད་པར་བྱེད་པ་སྟོན་ཏེ་གོ་རིམས་བཞིན་ནོ།",
    "དགེ་སློང་དག་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་ཐོས་པ་དང་མི་ལྡན་པ་རྣམས་ནི་ཕུང་པོ་ལྔ་པོ་འདི་དག་ལ་རྟག་པ་ཉིད་དང་བརྟན་པ་ཉིད་དུ་ཡང་དག་པར་རྗེས་སུ་ལྟ།",
    "དེ་ལ་ཁྱེཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་རྣམས་ནི་འདུས་བྱས་ཀྱི་མཚན་ཉིད་སྐྱེ་བ་དང་འཇིག་པ་གཉིས་དང་ཡང་ལྡན་པ་ཡིན་ལ།",
    "དེ་ལ་ཀུན་ཏུ་རྨོངས་པ་ནི་རྗོགོ་རིམས་བཞིན་དུ་རྟག་པ་ལ་སོགས་པ་ཉིད་དུ་ཞེས་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལྟ་བ་གཉིས་དང་གཉིས་ཀྱིས་ཡོངས་སུ་བསྟན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འདིར་གཙང་བར་ཕྱིན་ཅི་ལོག་པར་མ་སྨོས་སོ།",
    "རྙེད་པ་དང་བཀུར་སྟེ་འདོད་པ་ཉིད་ཀྱིས་གཞན་ལ་ཡོན་ཏན་ཡིད་ཆེས་པར་བྱ་བའི་བསམ་པས་སྤྱོད་ལམ་ལེགས་པར་གནས་པ་དང་།",
    "ཡུལ་དབེེན་པར་གནས་པ་དང་།",
    "རྙེད་པ་ཁྱད་པར་ཅན་མི་ལེན་པ་ཉིད་ཀྱིས་དང་།",
    "རྙེད་པ་དང་བཀུར་སྟེའི་བསམ་པས་རྗེས་སུ་མཐུན་པར་སྙན་པར་སྨྲ་བ་དང་།",
    "རྙེད་པའི་བསམ་པས་དེ་ལ་སྦྱིན་པར་མི་བྱེད་པ་ལ་སྨོད་པ་དང་།",
    "གཞན་ལ་སྦྱིན་པར་བྱེད་པ་ལ་སྨོད་པ་དང་།",
    "རྙེད་པས་རྙེད་པར་བྱེད་འདོད་པ་ཡང་རྣམ་པ་གསུམ་སྟེ།",
    "སྦྱིན་པར་བྱེད་པ་རྒྱ་ཆེ་བར་བསྔགས་པར་བྱེད་པ་དང་།",
    "གཞན་མགུ་བར་བྱ་བའི་ཕྱིར་སྨྲ་བ་འདིར་ཁ་གསག་ཡིན་པར་དགོངས་ཀྱི་ཐམས་ཅད་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་ཕ་རོལ་གྱི་ཁ་ན་མ་ཐོ་བ་རྣམས་ལ་འཇིགས་པར་ལྟ་བ་དང་།",
    "དེ་ལ་ཇི་ལྟར་ཤེས་པར་བྱ་བ་ལྟ་བུས་མར་ཤེས་པ་ནི་མར་འཛིན་པ་སྟེ།",
    "དེ་ལ་གུས་པར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ལྡང་བ་དང་སྙན་པར་སྨྲ་བ་ལ་སོགས་པ་བྱ་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་ཕ་རོལ་གྱི་ཁ་ན་མ་ཐོ་བ་རྣམས་ལ་འཇིགས་༢་པར་ལྟ་བས་སོ།",
    "འཇིགས་པ་ནི་ཉེས་དམིགས་ཡིན་པར་ཏེརིག་པར་བྱའོ།",
    "ཟས་དང་སྐོམ་དང་བཟའ་བ་དང་བཅའ་བ་དང་བཞོན་པ་དང་གོས་ལ་སོགས་པ་སྦྱིན་པར་བྱེད་པ་གང་ཡིན་པ་སྟེ།",
    "དེ་ནི་སྦྱིན་པར་བྱ་བས་ན་སྦྱིན་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཐ་དད་པར་སྨོས་པ་ནི་ཁྱད་པར་དང་ཁྱད་པར་མེད་པར་སྦྱིན་པའི་དབྱེ་བས་སྙེཡང་དག་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "ཚུལ་ཁྱེམས་ཡང་དག་པར་བླངས་ནས་གནས་པ་ནི་ཉིན་ཞག་གཅིག་པ་དང་།",
    "ལྷག་མ་རྣམས་ཀྱིས་ནི་ཡང་དག་པར་བསྒྲུབ་པ་དེ་ཉིད་ཀྱི་རྒྱུ་དང་།",
    "ལེགས་པར་ཞུགས་པ་ནི་སུ་དག་ཡིན།",
    "འདིར་ནི་ངེས་པར་ལེགས་པ་ལས་བརྩམས་ནས་ཡང་དག་པར་སྨྲ་བ་དང་།",
    "བརྩོན་པ་རྣམས་ནི་གང་དག་ཡང་དག་པར་རབ་ཏུ་བརྩོན་པ་རྣམས་སོ།་།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་བདེ་བའི་ཚོར་བ་ལ་ནི་འདོད་ཆགས་རྒྱས་པར་འགྱུར་ལ།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་ཁྱམ་ཡིན་པ་ལ་ནི་མ་རིག་པའོ་ཞེས་གསུངས་སོ།",
    "མ་ལུས་པར་སྤང་བར་བྱ་བའི་ཕྱིར་རོ།",
    "གང་སུ་དག་འདོད་ཆགས་མ་ལུས་པར་སྤངས་པ་བྱེ་ཞེས་བྱ་བ་ནི་ས་ལས་དང་ས་བོན་ལས་དང་།",
    "རྣམ་པ་ལས་མ་ལུས་པར་སྤངས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྤངས་པས་ནི་རྣམ་པར་གྲོལ་བ་སྟོན་ལ།་",
    "ཡོངས་སུ་ཤེས་པས་ནི་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བའོ།",
    "བུམ་པ་ལེགས་པར་གང་བའོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "འཇིག་རྟེན་པའི་སྙོམས་པར་འཇུག་པ་དག་ལས་བཟློག་ནས་ཇི་སྲིད་དུ་བགྲོད་པར་བྱ་བར་གཤེགས་པའི་ཕྱིར་དང་།",
    "ཕྱིར་མི་ལྡོག་པར་གཤེགས་པའི་ཕྱིར་ཏེ།",
    "མྱ་ངན་ལས་འདས་པར་གཤེགས་པ་དག་ནི་དེ་ལྟར་དུ་གཤེགས་པ་དག་ཡིན་ནོ།",
    "ལྟ་བ་དང་ང་རྒྱལ་དང་མ་རིག་པ་ནི་དེ་འདྲེན་པར་བྱེད་པ་དག་ཡིན་ཏེ།",
    "ཚངས་པར་སྤྱོད་པའི་འདམ་གྱིས་ཟིལ་གྱིས་ནོན་པ།",
    "ཚངས་པར་སྤྱོད་པའི་འདམ་ནི་རྙེད་པ་དང་བཀུར་སྟེ་གང་ལ་ཆགས་ན་འཕགས་པའི་མྱ་ངན་ལས་འདས་པའི་ལམ་ཡན་ལག་བརྒྱད་པར་མི་འདོང་བ་སྟེ།",
    "དེ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་ཚངས་པར་སྤྱོད་པའི་འདམ་ཡིན་པར་གསུངས་སོ།",
    "མྱ་ངན་ལས་འདས་པར་མི་འགྲོ་བ་དང་།",
    "ཚེ་ཕྱི་མ་ལ་ངན་འགྲོར་འགྲོ་བའི་ཉེས་དམིགས་རྣམ་པ་གསུམ་ཡོད་པར་སྟོན་ཏོ།",
    "རང་ཉིད་ཀྱིས་འུསྐྱོན་ཡིན་པར་བསྟན་པ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་གྱི་རྣམ་པར་སྨིན་པ་ཅན་གྱི་ཉེས་དམིགས་ཡོད་དེ།",
    "ཡང་སྲིད་པ་རྔུཔར་གྱུར་པ་ལ་ཚེ་ཕྱི་མ་ལ་སྐྱེ་བ་དང་རྒ་བ་དང་འཆི་བར་འགྱུར་བ་ཞེས་བྱ་བའི་ཉེས་དམིགས་ཡོད་དེ་ཡུན་རིང་པོར་སྐྱེ་བ་དང་རྒ་བ་དང་འཆི་བ་འདྲེན་པའི་ཕྱིར་རོ།",
    "ལྷག་མཐོང་དང་ལྡན་པ་ཁྱིམ་སྟོང་པ་རྣམས་རྒྱས་པར་བྱེད་པ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་མཁས་པ་རྣམས་ཀྱིས་མ་སྨད་པ།་",
    "འདི་ལྟར་ཅུང་ཟད་ཅུང་ཟད་ཅེས་བྱ་བ་གསུངས་པ་བཞིན་ནོ།",
    "དེ་ཐོབ་པར་བྱེད་པའི་ལམ་གང་ཡིན་པའོ།",
    "དེ་ལ་རྗེས་སུ་བརྩོན་པ་ནི་ཇི་ལྟར་དེ་ལ་བརྩོན་པར་བྱ་བ་དེ་ལྟར་བརྩོན་འགྲུས་མི་གཏོང་བ་ཉིད་ཀྱིས་བརྩོན་པའི་ཕྱིར་ཏེ།",
    "དེའི་འབྲས་བུ་དང་བཅས་པ་ཉིད་དུ་བྱེད་པའི་ཕྱིར་ཡུལ་འཁོར་གྱི་བསོད་སྙོམས་འབྲས་བུ་ཡོད་པར་ཟ་བའོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་དང་།",
    "སྦྱིན་པར་བྱེད་པ་རྣམས་ལ་ཡང་དག་པར་སྒྲུབ་པ་ཡོངས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "བསྟན་པ་ལ་ནི་རྟག་ཏུ་ལས་ཁྱད་པར་དུ་འཕགས་པ་ལ་སྦྱོར་བའི་ཕྱིར་དང་།",
    "ཕྱིན་ཅི་མ་ལོག་པར་སྦྱོར་བའི་ཕྱིར་དང་།",
    "རྣམ་པར་མ་གཡེངས་པར་སྦྱོར་བའི་ཕྱིར་དང་།",
    "ཆོག་མི་ཤེས་པར་སྦྱོར་བའི་ཕྱིར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་ལ་ནི་དོན་མཐུན་པ་ཉིད་དུ་ཁྲུསྦྱོར་བའི་ཕྱིར་རོ།",
    "སྦྱིན་པར་བྱེད་པ་རྣམས་ལ་ནི་དེའི་སྦྱིན་པ་འབྲས་བུ་ཆེན་པོ་ཉིད་དུ་སྤྱོར་བའི་ཕྱིར་རོ།",
    "མི་རིགས་པར་ཆགས་པས་ཟིལ་གྱིས་ནོན་པ་དང་།",
    "དཔེར་ན་འདོད་པས་ལོག་པར་གཡེམ་པའམ་ལིངས་འདེབས་པ་ལྟ་བུའོ།",
    "མི་རིགས་པས་ཆགས་པ་ནི་མི་རིགས་པར་ཆགས་པ་སྟེ།",
    "བདེ་འགྲོ་ཡོངས་སུ་ཚོལ་ཞུབ་ལ་བརྩམས་ནས་མི་རྣམས་ལ་ལོག་པར་སྒྲུབ་པ་རྣམ་པ་གསུམ་ཡོད་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཕུན་སུམ་ཚོགས་པ་དེ་གཉིས་ཀའི་ཁྱད་པར་དང་།",
    "དེ་ལས་ཕྱིར་ཕྱོགས་པར་བྱེད་པའི་གཞི་དང་།",
    "དེ་ལས་ཕྱིར་ཕྱོགས་པར་བྱེད་པའི་གཞི་ནི་འདོད་པ་རྣམས་རོ་ཆུང་བ་ཉིད་དང་།",
    "དེའི་འོག་ཏུ་བདེ་འགྲོར་གྱུར་དུ་ཟིན་གྱིས་ཀྱང་མི་རྣམས་ཀྱིས་འདོད་པར་བྱ་བ་དག་ནི་མི་གཙང་བ་དང་།",
    "ཉེས་དམིགས་ཡང་དག་པར་རབ་ཏུ་བསྟན་པ་ཡིན་ནོ།",
    "རྣམ་པར་བྱང་བ་ཡང་དག་པར་རབ་ཏུ་བསྟན་པ་ཡིན་ནོ།",
    "སྐྱོན་རྔེད་པར་ནི་ཉམས་བདེ་བ་ཞེས་བྱ་བས་སོ།",
    "ཡོངས་སུ་སྨིན་པ་ཕུན་སུམ་ཚོགས་པ་ཡོངས་སུ་བསྟན་པར་རིག་པར་བྱའོཛུ།",
    "རྣམ་པར་གྲོལ་བ་རྣམས་ཀྱི་རྒྱུར་འགྱུར་བ་ནི་གོ་རིམས་བཞིན་དུ་ཡོངས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "དེའི་ཐོབ་པ་ལ་སོགས་པ་དང་དེ་དང་མི་ལྡན་པར་གནས་གྱུར་པ་ནི་རྣམ་པར་གྲོལ་བའོ།",
    "བདག་མེད་པ་ཉིད་དུ་ཡིད་ལ་བྱེད་དོ་ཞེས་གང་གསུངས་པ་འདི་ནི་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ལྟ་བ་ཡིན་ལ།",
    "མྱ་ངན་ལས་འདས་པའོ་ཞེས་འཆི་བ་མེད་པའི་དབྱེངས་ལ་སེམས་ཉེ་བར་སྦྱོར་བ་ཞེས་གང་གསུངས་པ་འདི་ནི་འདོད་ཆགས་དང་བྲལ་བའོ།",
    "དེས་དེ་ལྟར་ཤེས་ཤིང་དེ་ལྟར་མཐོང་བ་ན་འདོད་པའི་ཟག་པ་ལས་སེམས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "མ་རིག་པའི་ཟག་པ་ལས་སེམས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ་ཞེས་གང་གསུངས་པ་འདི་ནི་རྣམ་པར་གྲོལ་བའོ་ཞེས་ཟེར་ཏེ།",
    "ཕྱིས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་བསམ་པས་བརྗོད་དགོས་སོ།",
    "དེ་ལ་བྱི་དོར་བྱས་པ་ནི་ཕན་པའི་དངོས་པོ་ཉེ་བར་སྒྲུབ་པ་ཉིད་ཀྱིས་སོ།",
    "སྲེད་པ་ལ་ལོག་པར་སྒྲུབ་པ་ལས་དང་བཅས་པའམ།",
    "སྲེད་པ་ལས་ལོག་པར་བསྒྲུབ་པ་ཡིན་པར་ཡོངས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "སོ་སོར་བརྟགས་ནས་དེ་ལ་སེམས་འཇོག་པར་བྱེད་དེ།",
    "གང་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་ཆེད་དུ་བརྗོད་པ་ཆེད་དུ་བརྗོད་པར་མཛད་དོ་ཞེས་བྱའོ།",
    "ལྟ་བ་ཐམས་ཅད་རྣམ་པར་འཇོམས་པའི་ཕྱིར།",
    "ཕྱོགས་འདིས་ནི་བློ་དང་ལྡན་པ་རྣམས་ཀྱིས་ཚིག་གཞན་རྣམས་ཀྱི་དོན་ཡང་དག་བུཔར་བྱའོ།",
    "རབ་ཏུ་དབྱེ་བ་ནི་བརྗོད་པར་བྱ་བ་དེ་གཟུགས་ཅན་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པའི་ས་ཏྲེཡང་བྱས་པ་ཡིན་ནོ།",
    "དཔེར་ན་དེ་ཉིད་ལས་རྣམ་པར་ཤེས་པའི་རྐྱེན་གྱིས་མིང་དང་གཟུགས་ཞེས་བྱ་བ་ལ།",
    "ཚོར་བའི་ཕུང་པོ་ནས་རྣམ་པར་ཤེས་པའི་ཕུང་པོའི་བར་དུའོ།་།",
    "འདུ་བྱེད་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་༦་ཤེས་པ་ཞེས་བྱ་བ་ལ།",
    "རྣམ་པར་ཤེས་པ་གང་ཞེ་ན།",
    "དེ་བཞིན་དུ་དེ་ལས་ས་ཆེན་པོ་འདི་ཚིག་པར་འགྱུར་བ་དང་།",
    "མེད་པར་འགྱུར་བ་དང་།",
    "གཞི་མཐོང་བ་མ་གཏོགས་པར་སུ་ཞིག་དད་པར་འགྱུར།་",
    "སུ་ཞིག་ཡིད་ཆེས་པར་འགྱུར་ཞེས་གསུངས་ནས་སྤྱན་ལེགས་ཀྱི་སྐྱེས་པའི་རབས་བསྟན་པ་ནི་བདག་ཉིད་ལ་དད་པ་ཉིད་དུ་འགྱུར་བར་ཡིད་ཆེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "རྙེད་པར་དཀའ་བ་ཉིད་དུ་ཡོངས་སུ་བསྟན་པའི་ཕྱིར་ཏེ།་",
    "ཡུལ་ལ་ཡང་དག་པར་སྡོམ་པའི་ཕྱིར་དང་།",
    "ཚངས་པར་སྤྱོད་པ་རྣམ་པ་གསུམ་གྱི་རྒྱུ་ཉིད་ཀྱིས་ཀྱང་ཡིན་ཏེ།",
    "ཚངས་པར་སྤྱོད་པ་རྣམ་པ་གསུམ་ནི་སྤོང་བ་ཡང་དག་པར་ལེན་པ་དང་།",
    "འདྲེན་རྔུམ་ནི་དེ་ལས་གཞན་པའི་འདོད་ཁམས་སུ་རྣམ་པར་སྨིན་པར་བྱེད་པ་ཡིན་ནོ།",
    "དཀར་པོ་ནི་གཟུགས་དང་གཟུགས་མེད་པར་རྣམ་པར་སྨིན་པར་བྱེད་པ་ཡིན་ནོ།",
    "བདེ་འགྲོ་དང་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ཤེལས་འདས་པའི་རྣམ་པར་དག་པའི་རྒྱུ་ཉིད་ཀྱིས་ཀྱང་ཡིན་ནོ།",
    "རྣམ་པར་གྲོལ་བའི་རྟེན་ཉིད་ཀྱིས་ཀྱང་ཡིན་ནོ།",
    "རྣམ་པར་གྲོལ་བར་བྱེད་པས་ཀྱང་ཡིན་ཏེ།",
    "གཉིས་པས་ནི་སེམས་མཉམ་པར་མ་བཞག་པ་མཉམ་པར་འཇོག་པར་བྱེད་པ་ཡིན་ཞིང་གསུམ་པས་ནི་སེམས་མཉམ་པར་བཞག་པ་རྣམ་པར་གྲོལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་བཞུགས་ཟིན་ཀྱང་།",
    "དེ་བཞིན་དུ་ཚེ་དང་ལྡན་པ་གསུས་པོ་ཆེ་ཆེན་པོ་རབ་ཏུ་ཤེས་པར་བྱེད་ཅིང་རབ་ཏུ་ཤེས་པར་བྱེད་པས་ན་དེའི་ཕྱིར་ཤེས་རབ་ཅེས་བྱའོ།",
    "གཞན་འགག་ཅིང་འགག་གོ་ཞེས་བྱ་བ་གསུངས་པ་དང་།",
    "ཚེ་རབས་ཕྱི་མ་ལ་གོང་དུ་འགྲོ་ཞིང་ཁྱད་པར་དུ་འགྲོ་བ་དང་།",
    "མཐོ་རིས་སུ་ཉེ་བར་འགྲོ་བ་ཡིན་ནོ་ཞེས་གསུངས་པ་ལ་ཇི་ལྟར་ན་སེམས་སྐད་ཅིག་པ་ཚེ་ཕྱི་མ་ལ་གོང་དུ་འགྲོ་བར་འགྱུར།",
    "ཁ་ཅིག་ལས་བྲམ་ཟེའི་བདེན་པ་གསུམ་དག་ཅེས་གསུངས་པ་དང་།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་དང་དོན་དམ་པའི་བདེན་པའོ་ཞེས་གསུངས་པ་དང་།",
    "ཁ་ཅིག་ལས་བདེན་པ་ནི་གཅིག་ཁོ་ན་སྟེ་གཉིས་པ་མེད་དོ་ཞེས་གསུངས་པ་དང་།",
    "ཁ་ཅིག་ལས་ལས་ཀྱང་ཡོད་རྣམ་པར་སྨིན་པ་ཡང་ཡོད་ལ་བྱེད་པ་པོ་ནི་རྔུམི་དམིགས་སོ་ཞེས་གསུངས་པ་དེ་ལྟ་བུའི་རང་བཞིན་ནི་སྔ་ཕྱི་འགལ་བར་བརྒལ་བ་ཡིན་ནོ།",
    "ཉི་མའི་འོད་ཀྱིས་ཟླ་བའི་འོད་ལྟ་བུའོ་ཞེ་ན་ཡོད་པར་རབ་ཏུ་གྲུབ་ན་ནི་འདི་ཤེས་པར་ཡང་ནུས་ན་ཡོད་པར་རབ་ཏུ་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "འོད་ལ་སོགས་པ་གང་ལ་ཡང་སྲ་བ་ལ་སོགས་པ་ཉིད་ཡོད་པར་རབ་ཏུ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "དེ་དག་མི་དམིགས་པ་ནི་མེད་པའི་ཕྱིར་མ་ཡིན་གྱེ་ཟིལ་ཀྱིས་ནོན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་ཤེས་པར་བྱ།",
    "འོ་ན་ནི་ཆུ་དང་རྡོ་བ་ཊུལ་སོགས་པ་རྣམས་ལ་ཡང་རྐྱེན་གྱི་བྱེ་ཁྱད་པར་དང་ཕྲད་པས་མཚན་ཉིད་བརྟས་པའི་ཕྱིར་སྲ་བ་ཉིད་དང་།",
    "སྐྱེས་པའི་ཕྱིར་མ་ཡིན་པ་འདི་ཇི་ལྟར་ཤེས་པར་བྱ།",
    "སའི་དྲི་ནི་སྔ་ནས་ཀྱང་དམིགས་པ་ཉིད་ཡིན་ན་དེ་ཆུས་གཏོར་ན་བརྟས་པར་འགྱུར་བར་ཤེས་པར་བྱ་ཏེནུས་སོ།",
    "གང་ཞིག་རྐྱེན་དང་ཕྲད་པས་བརྟས་པར་གྱུར་པར་ཤེས་པར་རུང་བ་སྲ་བ་ལ་སོགས་པ་རྣམས་ནི་རྐྱེན་མེད་ན་ཆུ་ལ་སོགས་པ་རྣམས་ལ་དེ་ལྟར་ཡོད་པར་མི་དམིགས་སོ།",
    "དེ་དག་ལས་གང་ཡང་རུང་བ་ཞིག་དང་འགལ་བར་བརྒལ་བ་ཡང་རིགས་པ་དང་འགལ་བར་བརྒལ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་ལྟར་འདས་པ་དང་མ་འོངས་པ་ནི་མེད་པ་ཉིད་ཡིན་པར་མངོན་སུམ་ཡིན་ཏེ།",
    "འགག་པ་ན་གང་དུ་ཡང་སྩོགས་པར་མི་འགྲོའོ།",
    "དགེ་སློང་དག་དེ་ལྟར་ན་མིག་ནི་ཅེམ་སྐྱེས་པ་ལས་སྐྱེ་ཞིང་སྐྱེས་ནས་ཀྱང་འཇིག་གོ་ཞེས་གསུངས་པས་དེ་དང་འདིར་འགལ་བ་ཡིན་ནོ།",
    "ལུས་ཀྱི་ཉེས་པར་སྤྱད་པ་རྣམ་པ་བཞི་སྟེ།",
    "སྐྱེས་ནས་འཇིག་པར་འགྱུར་བས་ན།",
    "བྱེད་དོ་ཞེས་བྱ་བ་ནི་མི་འཇིག་ཡིན་པར་མིན།",
    "གྲིབ་མ་ཡང་ཅི་ཞིག་ཡིན་པར་བརྗོད་པར་བྱ་ཕྱོཞེ་ན།",
    "རྐྱེན་གསུམ་ལས་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བའི་རྫས་སྐྱེ་ལ།་",
    "བྱ་བ་མེད་པར་ཡང་ཡུལ་གང་ལ་སྐྱེ་བ་དེའི་རྣམ་པར་སྐྱེས་པས་ན་དེ་རྣམ་པར་ཤེས་པར་བྱེད་དོ་ཞེས་བྱ་སྟེ།",
    "མེ་འབར་ཞིང་འགྲོ་བར་བྱེད་དོ་ཞེས་རྗོད་ཁྲུཔར་བྱེད་ཀྱི།",
    "རྣམ་པར་ཤེས་པ་ལ་ནི་བསམ་སྤུཔའི་བྱ་བ་འགའ་ཡང་མེད་དོ།",
    "དངོས་པོ་དང་བྱེད་པ་དང་གཞི་ལ་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་འདི་འབྱུང་ངོ་ཞེ་ན།",
    "བྱཱ་ཀ་ར་ཎ་ལས་ཀྱང་འདི་མ་ངེས་པར་སྨྲས་པ་ཡིན་ཏེ།",
    "འོན་ཏེ་གཞན་ལ་མི་ལྟོས་བྱེཔར་འཇུག་པ་ཞིག་ཡིན།",
    "དེའི་ཕྱིར་མེས་སྲེག་པར་བྱེད་དོ།",
    "འཚེད་པར་བྱེད་དོ་ཞེས་བྱེད་པ་པོར་ཐ་སྙད་གདགས་པར་མི་རུང་སྟེ།",
    "འདོད་པ་མེད་པར་དབུགས་དབྱུང་བའི་ཕྱིར་དང་།",
    "འདི་ལྟར་འཕུལ་བར་བྱེད་པ་ལ་མ་ལྟོས་བླཔར་ནི་གྲུ་འགྲོ་བ་ཡང་མེད་ལ་ལྗོན་ཤིང་འགུལ་བ་ཡང་མེད་དོ།",
    "གཞི་ལ་མི་ལྟོས་པར་ཆུ་གནས་པ་ཡང་མེད་དོ།",
    "ཅི་ཞིག་ཏུ་བརྗོད་པར་འདོད།",
    "དེ་བཞིན་དུ་འབྱིན་པར་བྱེད་པ་ན་རྔེ་འབྱུང་ངོ་ཞེས་བྱ་བ་ཡང་ཅི་ཞིག་བརྗོད་པར་འདོད་པ་ཡིན།",
    "བརྗོད་པར་འདོད་པ་ལས་༢་དེའི་སྤྱོར་བར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་རུང་ན་བྱེད་པ་པོ་དང་བྱ་བའི་དབྱེ་བ་མེད་ཀྱང་རྣམ་པར་ཤེས་པར་བྱེད་པས་ན་རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་འདི་ཡང་ཅིའི་ཕྱིར་མི་རུང་།",
    "ཅིའི་ཕྱིར་ན་འདི་ལ་བྱེད་པ་པོ་མེད་བཞིན་དུ་བརྗོད་པར་འདོད་ཅེ་ན།",
    "རྣམ་པར་ཤེས་པ་ཙམ་ལ་བྱེད་པ་པོ་ཉིད་དུ་ཐ་སྙད་འདོགས་ཀྱི་བདག་ཏུ་ལྟ་བས་ཀུན་ཏུ་བརྟགས་པའི་བྱེད་པ་པོ་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "ལམ་འདི་ཡུལ་བཅོམ་བརླག་ཏུ་འགྲོའོ་ཞེས་གང་ཇི་སྐད་དུ་ཟེར་བ་ཡང་དེ་དག་ལ་བརྗོད་པར་འདོད་པ་བྱེད་པ་པོ་འགའ་ཡང་ཅི་ཞིག་ཡོད་དེ།",
    "རྒྱལ་ལ་སྐྱེས་གང་ཡིན་པ་དེའི་མིག་དེ་ལ་བརྟེན་ནས་རྣམ་པར་ཤེས་པ་སྐྱེའོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "ཇི་ལྟར་སྔར་ཁྲུས་བྱས་ནས་ཕྱིས་ཟ་བ་ལྟ་བུར་སྔར་ཁ་གདངས་པའམཛེེ།",
    "མིག་འཛུམས་པར་བྱེད་ལ།",
    "ཕྱིས་ཉལ་བའི་དོན་འདིར་ནི་ཁོང་དུ་ཆུད་པར་མི་འགྱུར་རོ།",
    "དེ་ནི་སྔར་ཧཱུཾའགེངས་པའམ་ཙོ་འཇུག་པར་བྱེད་ལ་ཕྱིས་འཆར་བའམ།",
    "དཔེར་ན་མར་འཐུངས་ནས་སྟོབས་དང་ལྡན་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལྟ་བུ་སྟེ།",
    "ཟས་ཟ་བ་དག་ལྟར་སྔ་ཕྱི་ཙམ་དུ་རྟོགས་པར་བྱ་བ་མ་ཡིན་བྱུ་ངྐུ།",
    "སྦྱོར་བ་འདི་ཅི་ནས་ཀྱང་རྒྱུའི་དོན་ཁོ་ན་ཡིན་པར་ཤེས་པར་བྱའི།",
    "སྐྱེ་བའི་འོག་ཏུ་རྣམ་པར་ཤེས་པ་སྐྱེས་པ་ཡིན་ནོ།",
    "ཅི་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ཀྱིས་བདག་ཏུ་བཅས་པ་ཡིན་ནམ།",
    "འོན་ཏེ་བདག་མེད་པ་ཡིན་ན་ཇི་ལྟར་དེ་བདག་མེད་པར་སྐྱེ་བ་དག་ལ་བྱེད་པ་པོ་ཡིན་པ་དེ་བཞིན་དུ་བརྟེན་ནས་ཞེས་བྱ་བ་ཡང་གྲུབ་པ་ཡིན་ནོ།",
    "གལ་ཏེ་སྐྱེ་བ་བསྐྱེད་པར་བྱ་བའི་བདག་ཏུ་གྱུར་པ་ཡིན་ན་ཇི་ལྟར་རང་ལ་བྱེད།",
    "ཁ་སྤུ་བྱེད་ཅེས་བྱ་བ་ནི་འདྲེག་པར་བྱེད་ཅེས་བྱ་བར་རྟོགས་སོ།",
    "རྐྱལ་པ་ལ་བྱེད་ཅེས་བྱ་བ་ཉེད་པར་བྱེད་ཅེས་བྱ་བར་རྟོགས་སོ།",
    "སྦྱང་དུ་འབྲས་བྱེད་ཅེས་བྱ་བ་ནི་འཇོག་པར་བྱེད་ཅེས་བྱ་བར་རྟོགས་སོ།",
    "ཕའི་ཚིག་བཞིན་བྱེད་ཅེས་བྱ་བ་ནི་དེས་སྨྲས་པ་བཞིན་དུ་སྒྲུབ་པར་བྱེད་ཅེས་བྱ་བར་རྟོགས་སོ།",
    "དེ་ལྟ་བས་ན་སྐྱེ་བའི་བྱེད་པ་པོའི་བྱེད་ཅེས་བྱ་བའི་དོན་བརྗོད་པར་བྱ་དགོས་སོ།",
    "གལ་ཏེ་སྐྱེད་པར་བྱེད་པའི་དོན་ཡིན་ནོ་ཞེ་ན།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་ཡོད་པ་ཉིད་དུ་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "མིག་ལ་སོགས་པ་འདས་པ་དང་མ་འོངས་པ་དག་ནི་ཇི་ལྟར་རིགས་པར་བསྟན་དུ་ཡོད་ཅིང་ཐོགས་པ་དང་བཅས་པའི་ཕྱིར་རོ།",
    "ཡང་ན་གཟུགས་ཉིད་དུ་ཡང་འདོད་པར་མི་བྱ་སྟེ།",
