    "གཞན་ཡང་བོན་སྒོ་བཞི་མཛོད་ལྔ་རུ་ཕྱེས་ཏེ་རང་རང་ཆེད་དུ་བྱས་པའི་གདུལ་བྱ་རྣམས་ལ་བསྟན།",
    "གཞན་གྱི་དད་རྫས་ཆུད་མ་ཟོས་པ་ཞིག་དགོས་རྒྱུ་ཡིན་འདུག།",
    "ཕུ་འགྲོ་མདའ་འདུག།",
    "དུར་ཁྲོད་བདག་པོ་ནས་བཤགས་པའི་བར་ཉེར་དྲུག་དུས་གཏོར་བཞིན།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "གཞན་ཡང་རང་ཉིད་དམ་པའི་སྤྱོད་པ་དང་མཐུན་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "འདི་དེང་སང་ཤེས་པ་ཉུང་ངུ་ལས་མི་གདའོ།",
    "སྟོང་པ་ཉིད་དང་རང་འབྲས་སྡུག་བདེན་གྱི་རྒྱུར་གྱུར་པའི་གཟུགས་ལ་སོགས་པ་གཉིས་དོན་དམ་པར་ཐ་མི་དད་ཅིང་དབྱེར་མེད་པ་ཉིད་ཀྱིས་སོ།",
    "བསམ་གཏན་སྤེལ་ན་འོག་མིན་འགྲོ།",
    "འོག་མིན་འགྲོ་འཕཪ་གསུམ་སྲིད་རྩེཪ་འགྲོ་རྣམས་བསྡུས་ནས་གོང་འཕོ་སྟེ་ལྔ།",
    "འོན་མིན་འགྲོ།",
    "འོག་མིན་འགྲོའི་མིང་ཅན་ནི་གཞན་དོན་དུ་ཚངས་རིས་ནས་འོག་མིན་གྱི་བར་དུ་སྐྱེས་ནས་འཚང་རྒྱ་བའི་བྱང་སེམས་འཕགས་པ་དེ་ཉིད།",
    "གཞན་དོན་དུ་ཚངས་རིས་ནས་འོག་མིན་གྱི་བར་དུ་སྐྱེས་ནས་འཚང་རྒྱ་བའི་ཆ་ནས་ཕྱིར་མི་འོང་འོག་མིན་འགྲོའི་མིང་ཅན་ཏེ།",
    "འབྲིང་ནི་རང་འབྱུང་རང་ཞིའོ།",
    "གཟུགས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མ་ལགས་ཞེས་སོགས་གསུངས་སོ།",
    "གང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དང་།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆགས་པ་མ་མཆིས་པ་དེའི་ཕྱིར།",
    "ཆུབ་ཀྱི་ཤིང་རྩ་བ་གསེར་ལས་བྱས་པ་ལྷུན་བེཌཱུརྱར་འདུག་པ།",
    "ཉན་ཐོས་དང་རང་རྒྱས་དང་བྱང་སེམས་ཀྱི་ལམ་ཤེས་པའི་ལམ་ཤེས་གསུམ་ལས།",
    "རྣམ་མཁྱེན་ཡིད་བྱེད་དང་ལྡན་པའི་ཐབས་མཁས་པ་དང་རང་བཞིན་མི་དམིགས་པར་རྟོགས་པའི་ཤེས་རབ་ཀྱི་སྒོ་ནས་སོ།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་སྟེ།",
    "ནང་རང་ལུས་ལ་གཟུགས་ཅན་དུ་འདུ་ཤེས་པའི་སྒོ་ནས་སོ།",
    "ནང་རང་ལུས་ལ་གཟུགས་ཅན་མ་ཡིན་པ་མིང་དུ་འདུ་ཤེས་པའི་སྒོ་ནས་སོ།",
    "ཡུལ་རང་བཞིན་གྱིས་སྐྱེ་མེད་ཡིན་པ་དེ་བཞིན་དུ་ཡུལ་ཅན་མཉམ་གཞག་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "དཔོན་སློབ་གཉིས་ཀ་ལ་ལྟོས་པའི་སྐྱོན་ནི་སྔ་ཕྱི་གྲངས་བཞིན་དུ་འཆད་པ་པོ་དང་ཉན་པ་པོ་སྔ་མ་དང་ཕྱི་མ་གང་རུང་དང་འབྲེལ་པས་སྐྱོན་དུ་གྱུར་པ་ནི་སློབ་དཔོན་གཅིག་པུར་འདུག་པ་ལ་དགའ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུངས་པ།",
    "བྱིས་པ་སོསོའི་སྐྱེ་བོ་རྣམསཀྱི་སིམཾསཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཉན་ཐོས་དང་རངསངསརྒྱས་རྣམས་ཀྱིསེམས་དང་།",
    "སྐཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་ཡང་རང་བཞིནལྷོདཔ་ཉིད་ཀྱི་ཕྱིརོ།",
    "འདུསབྱས་སྟོང་བཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དྲནཔ་བརགཞག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོངཔ་ཉིད་ཀྱི་ཕྱིར།",
    "འཕགསཔའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡང་རང་བཞིན་སྟོངཔཉིདཀྱི་ཕྱིར།",
    "ཚོར་ཡང་རང་བཞིན་སྟོང་པ་ཉིདཀྱི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱིཕྱིར།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གང་འདུགགསབརྙན་ལྟ་བའི་འདུ་བྱེདདེ་ནིམབཅིངས་མ་གྲོལ་བའོ།",
    "ཉན་ཐོས་དང་རང་སངས་བྱེད་ཅིང་།",
    "སྡུག་བསྔལ་མི་འདོད་ཅིང་རང་བཞིན་གྱིས་སྡུག་བསྔལ་བར་གྱུར་པའི་སྐྱེ་བོ་ལ་སྡུག་བསྔལ་གྱིས་རྣམ་པ་འགེད་པས་ཅི་ཞིག་བྱ་སྟེ།",
    "གལ་ཏེ་འཇིག་རྟེན་ན་ལྷ་སྦྱིན་བདེ་བར་ཉལ་འདུག་གོ་ཞེས་སོགས་ཀྱི་ཐ་སྙད་མཐོང་བས་བདེ་བ་ཡོད་དོ་ཞེ་ན།",
    "པ་ན་རྗེ་བོ་ལ་གཏོང་བ་པོར་སེམས་ཤིང་རང་ཉིད་ལ་དམའ་བར་སེམས་ཀྱི་མི་ཁེངས་པ་དེ་བཞིན་དུ།",
    "ཕན་པ་དང་མི་ཕན་པ་རྗེས་སུ་སྟོན་པ་པོ་མེད་ཅིང་རང་ཡན་དུ་གྱུར་པས་སོ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "ངེས་པར་ཏེ་མཐའ་གཅིག་ཏུ་མི་དགེ་ཞིང་རང་གཞན་གྱི་རྒྱུད་སྲེག་པ་དང་གཞན་ལ་གནོད་པ་སོགས་དོན་མ་ཡིན་པ་སྐྱེད་ཅིང་།",
    "གཞན་ལ་གཏོང་བ་པོ་དང་རང་ཟ་བ་པོ་དང་།",
    "དེ་ལྟར་ནའང་རང་བཞིན་ཡིན་པའི་ཕྱིར་མི་འཇིགས་སོ་ཞེ་ན།",
    "དངོས་པོ་དང་རང་བཞིན་དང་བདག་དང་རྟག་པ་རྣམས་ནི་རྣམ་གྲངས་ཡིན་ལ།",
    "སྣ་ཚོགས་རྟག་པར་མི་རིགས་ཞེས་པ་སོ་ན་འདུག་གོ།",
    "འགྲོ་བ་དང་འོང་བ་དང་འདུག་པ་ལ་སོགས་པ་བྱ་བ་ཅི་ཡང་མེད་དོ།",
    "ས་བོན་ལ་སོགས་པ་ཡོད་ཀྱང་འབྲས་བུ་མྱུ་གུ་དང་མེ་ཏོག་ལ་སོགས་པའི་སྐྱེ་བ་དང་འཇིག་པ་དག་དུས་རྟག་ཏུ་མེད་པའི་ཕྱིར་དང་།",
    "གཉིས་ཀའང་རང་བཞིན་མེད་པར་མཚུངས་པའི་ཕྱིར་གཅིག་མཐོང་ལ་གཅིག་མི་མཐོང་ཞེས་བྱ་བར་མི་རིགས་སོ།",
    "རྣམ་པར་ཤེས་པའང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
