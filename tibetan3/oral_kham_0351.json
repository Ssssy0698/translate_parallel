    "སྐུ་ཚེ་རིང་པའི་འཕེན་པའང་མེད་འདུག་པའི་སྟབས་ཀྱིས་བཏང་སྙོམས་སུ་བཞག།",
    "ད་ཡན་ནོ་ཡོན་དེ་སྡིག་ལ་རྔམས་ཤིང་མི་བསྲུན་པ་སྲིན་པོའི་རིགས་ཅན་ལྟ་བུ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཁོ་བོ་འགྲོ་ཁར་ཐུག་པ་ལ་བྱོན་པར་འདུག།",
    "ལོགྱིས་ཀྱང་དེ་དང་མཐུན་པ་ཞིག་གསུངས་པ་ལ་ཡིད་ཆེས་ཀྱི་གནས་སུ་མཛད་དགོས་རྒྱུར་འདུག་ཀྱང་།",
    "ལྷ་དཀར་པོ་ཞིག་དང་མཇལ་བ་བྱུང་འདུག།",
    "ཁྲི་ཐོགས་ཏུ་གདན་དྲངས་འདུག་ལགས།",
    "འཁྲུངས་ནས་ཟླ་བ་བཅུ་ལས་མི་འགྲོ་བ་འདུག་སྟེ།",
    "ཞབས་དྲུང་ཐམས་ཅད་མཁྱེན་པའི་སྐུ་སྐྱེ་ཡིན་མིན་ཅི་ཡིན་རུང་ཐ་མལ་གྱི་ཉམས་ནི་མི་འདུག།",
    "གཞན་མ་བཱི་ཇིས་ལུང་བསྟན་འདྲ་མང་པོ་གསུངས་འདུག་སྟེ།",
    "སྔོན་མེད་པའི་ཡིད་ལ་དགའ་བའི་ཉམས་ལྷང་ལྷང་བ་ཤར་བསྙུང་འདུག།",
    "ཁྲི་མཐོན་པོ་སེང་གེའི་གཟུགས་ཀྱིས་བཏེག་པ་ཞིག་འདུག་པའི་འཁྲིས་སུ་སླེབས་ཙ་ན།",
    "ད་སྣེ་གདོང་རྩེར་འབུལ་དགོས་འདུག་བཀའ་ཕེབས།",
    "རྣམ་དཔྱོད་ཀྱི་རྩལ་ཅུང་ཟད་ཙམ་ཡང་མི་ལྡན་པའི་བླ་ཆེན་གྱི་མིང་གོག་སྐམ་པོ་ཐམས་ཅད་ལ་ཁོང་པ་ཐུགས་མགུ་མཁན་ཞིག་མིན་པ་འདུག་ཀྱང་།",
    "སྐུ་ཡོན་འབུལ་མཁན་ལ་ཡོན་ཏན་ཡོད་མེད་ཀྱི་རྣམ་དབྱེ་ཕྱེད་པོ་ཞིག་མེད་འདུག་པ་དང་།",
    "དོན་གཉིས་རླབས་པོ་ཆེ་ལྷུན་གྱིས་གྲུབ་པ་ཞིག་འོང་རྒྱུར་འདུག་ཀྱང་།",
    "རྒྱལ་ཁང་རྩེར་བཞུགས་སྐབས་ཡིན་འདུག་པས།",
    "ཁྱད་པར་ངེད་ན་ཚོད་མཐོསཔས་སོག་ཡུལ་དུ་སྐུ་ཞབས་སུ་སླེབ་པ་ཞིག་མི་ཡོང་འདུག་ཀྱང་།",
    "མཐོང་བས་དོན་དང་ལྡན་པར་གྲགས་པ་ཀུན་ལ་མ་བྱུང་འདུག།",
    "འདིར་ལོ་གསུམ་ཙམ་བཞུགས་ཀྱང་ཟླ་བ་གསུམ་ཙམ་གྱི་ཡུན་ཚད་ཀྱི་ཉམས་ལས་མི་ཡོང་བ་འདུག་པས།",
    "དགའ་ལྡན་སྤྱི་སྒེར་བྱིངས་ཀྱི་སྔོན་ལ་འབྱོན་པ་དེ་ཕྱག་མཛོད་གུ་གྲིས་ཁྱེད་རང་བྱིངས་ལས་གཡེར་དུ་འཐོན་པ་ཞིག་མཛོད།",
    "ཨ་བོ་ཧོར་འདྲའི་སྤྱོད་ཚུལ་དང་ལྡན་པ་ཞིག་མིན་པར་གདའ་ཡང་།",
    "དཀོན་ཅོག་ལ་གུས་ཤིང་རང་སྲིད་སྐྱོང་མཁས་པ།",
    "ལུགས་གཉིས་ཀ་ནས་འོས་པ་ཞིག་མི་འདུག་པས།",
    "མི་འ་རྒྱ་པས་པར་དག་པའི་ཞིང་དུ་གཤེགས་པ་སྟབས་མ་འགྲིག་འདུག།",
    "དེ་བདུད་ཀྱི་སྤྲུལ་པ་ཡིན་པའི་ཕྱོགས་མང་མང་པོ་ཞིག་འདུག་པ་ལ།",
    "བདག་བསྟོད་གཞན་བསྟོད་མང་པོ་ཞིག་འདུག་པའི་ནང་ནས་ཚིག་སྤྱོར་ལེགས་པར་མཐོང་།",
    "རང་ཉིད་ཀྱང་དད་སྤྲོས་ཀུན་ནས་བླངས་ཏེ་རྗེའི་ཞབས་དྲུང་རང་དུ།",
    "སྙན་སྒྲོན་ལེགས་པོ་ཡིན་འདུག།",
    "ཡ་མཚན་པའི་གནས་ཤིན་ཏུ་ཡིན་པར་གདའ།",
    "སྔ་ཕྱིར་བཀའ་ཕེབས་གནང་བའི་ལྷོངས་ལ་ཡང་གུས་ཉམས་ཆེ་བ་འདུག།",
    "གཡེར་ཁ་ཁལ་ཁེབས་སོགས་གྲ་གཅིག་པ་ཞིག་བྱུང་ན་ཡོང་རྒྱུར་འདུག།",
    "དེའི་ལན་དུ་ཕྱག་མཛོད་གུ་གྲིས་ང་རང་ཡང་དེ་ཀ་བསམ་སྟེ།",
    "བརྒྱ་ལ་བྱེད་དམ་སྟོང་ལ་བྱེད་ལྟ་བུར་འདུག་པས།",
    "ཡར་རྒྱབ་པས་ཞུས་པའི་ཟུར་ཙམ་དུ་ཡང་མི་སླེབས་འདུག།",
    "ད་ཆ་རང་ཕྱོགས་སུ་འགྱུར་བ་ལྟ་བུ་ཡིན་འདུག་པས།",
    "བྱ་རོག་ལུག་པའི་བརྟུལ་ཞུགས་ཡུན་རིང་དུ་འཛིན་པ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "འཕྲལ་གྱི་སྣང་ཚུལ་དབུ་བླ་རྣམས་ཀྱིས་གདུང་བརྒྱུད་ཞལ་ངོར་ཕྱག་འབུལ་བ་སོགས་འཇམ་དབྱངས་འཁོན་གྱི་རིགས་སུ་ག་བྱུངས་པ་རྣམས་འགྲན་གྱི་ཟླ་མེད་དུ་འཛིན་པར་གདའ།",
    "ཡུལ་ཕྱོགས་རང་རང་གུས་མཆོད་བྱས།",
    "དུས་ཕྱིས་ཀྱང་མི་དེ་འདྲའི་རིས་འདུག་ཅེས་ཐུགས་ཁྲེལ་བའི་གསུང་ལོས་ཡང་ཡང་གནང་།",
    "སོར་ཕྱེད་ཀྱིས་འཇལ་རིན་མི་གདའ་ཡང་།",
    "སྟོན་པ་ཤཱཀྱ་ཐུབ་པས་བྱམས་པའི་ཏིང་ངེ་འཛིན་གྱི་སྒོ་ནས་བདུད་བཏུལ་བར་འདུག།",
    "དན་འབག་ཡས་སྣ་མས་སྣ་ལ་ཐེམ་པ་བཅོལ་ནས་སྡོད་དགོས་པའི་དུས་ཚོད་འདི་ལ་ལས་སྦྱོར་མི་བྱེད་ན་ག་ཙ་ན་བྱེད།",
    "མཐོང་བརྒྱུད་ཀྱི་ཕྱག་ལེན་ལ་མ་ལྟོས་པའི་རང་བཟོ་མང་པོ་བྱེད་ཡོད་འདུག་གོ།་",
    "འདི་ཐུགས་རྗེའི་ཤུགས་ཡིན་པར་འདུག་ཞུས་པས།",
    "འདི་རུ་སྐྱེ་བ་མ་བླངས་ཞེས་མཐའ་མི་འདུག་གསུང་སྐད།",
    "གཟིམས་ཁང་གོང་སྤྲུལ་པའི་སྐུ་གཉིས་སྦྱིན་སྲེག་སྡུགས་མཁན་ཡིན་འདུག་པར།",
    "རབ་ཏུ་བྱུང་བའི་རྟག་ཁོ་ན་ཡིན་འདུག་ཅེས་སྨྲ་སྐད།",
    "ཉམས་སྣང་དེ་འགགས་ཚར་འདུག།",
    "དྲུང་འཁོར་རྣམས་ཀྱིས་སྟོང་སྐོར་བ་བདེན་ཞེས་གླེངས་འདུག་ཀྱང་།",
    "གནང་སྒོ་འདི་འདྲ་སྤྱོ་སྤྱོད་དང་ཁྱད་པར་མི་འདུག་ཅེས་སྐུར་པ་སྣ་ཚོགས་ཤིག་བཏབ།",
    "རྙིང་མའི་ལུང་བསྟན་ན་བོད་སོག་པོས་འཛིན་པ་ཡོད་ཟེར་བ་འདུག་པ་དང་།",
    "འཇམ་གང་ཆགས་ཀྱི་ཐབས་མཛོད་ཕེབས་འདུག་པས་ཀྱང་ཤེས་ནུས་སོ།",
    "ལུས་ཅན་མཐའ་དག་དུས་མཁྱེན་རྒྱལ་པོ་ཡི།",
    "ངེད་རྣམས་ཀྱིས་གྲབས་བྱེད་ཞུས་འདུག་པའི་ཨཱ་ཙརྱ་གཙོ་བོ་དེ་མགོན་པོ་ཕྱག་དྲུག་པ་དང་།",
    "བཀྲ་ཤིས་ལྷུན་པོའི་མཁན་ཐོག་ཏུ་གདན་འདྲེན་པ་འདུག།",
    "གླེགས་བམ་དེ་ལམ་རིམ་ཆེ་བར་འདུག།",
    "རིང་མིན་འགྲོ་རྣམས་སྐལ་བཟང་དགའ་སྟོན་ལ།",
    "ནང་དུ་འཁོར་ལོ་སྡོམ་པའི་ལྷ་ཚོགས་ཐམས་ཅད་བཞུགས་འདུག་པའི་གཙོ་བོའི་སྐུ་ལས་འོད་ཟེར་སྔོན་པོ་འཕྲོས་པས།",
    "ང་རང་འགྲོས་པའི་གྲབས་བྱས་པས་དེ་ཙུག་མ་བྱེད་འདི་ལ་སྐྱོན་མེད།",
    "གཉིད་སད་པ་ན་སྐྱོ་སྣང་དྲག་པོ་སྔར་ཡོང་མ་མྱོང་བ་ཞིག་གདའ་འོ།",
    "དྲིལ་བུ་དུ་མ་འདུག་པ་རྣམས་ཀྱང་སྐད་སྙན་པ་འབྲུག་ཙམ་སྒྲོག།",
    "ཁང་པ་གཡབས་སྒོར་ཉི་མ་དྲོ་བ་ཞིག་ཏུ་སླེབས་ཨ་ཇོ་ལགས་སྐུ་མཆེད་ཀྱིས་ཇ་བུར་སོ་གོས་ཀྱི་བཀོད་པ་ཡང་བཤམས་བྱུང་།",
    "ད་ལམ་ཐབས་མི་གདའ་བས་སྟོད་ལགས་ཞུས་པས།",
    "འདིའི་མཚམས་སུ་ལ་ལྷ་ཡིག་འབྲུ་ཁ་ཤས་འདུག་རུང་འབྲི་ཐབས་མ་རྙེད།",
    "རྡོ་རྗེ་དྲིལ་བུ་གསིལ་ཞིང་བཞུགས་འདུག།",
    "གཞན་ཡང་ཕྱག་མཚན་གྱི་བྱེ་བྲག་མང་པོ་འདུག།",
    "ད་དུང་མཛད་ན་ཁེ་ཆེ་བ་འདུག་སྟེ་ཐེ་ཚོམ་ལས་མི་འདུག།",
    "སང་དེ་ག་ཆུ་ལ་མ་འཛེམས་པར་ཕྱིན་པས་ཁང་པ་སོགས་རྨི་ལམ་སོར་བཞག་གདའ།",
    "གཉིད་སད་ནས་ཀྱང་ཤིན་ཏུ་གསལ་བ་འདུག་པས་ཟིན་བྲིས་བྱས་ན་ཐུབ་ངེས་འདུག་སྟེ།",
    "ང་སྦྱིན་སྲེག་ཅིག་བྱེད་ཀྱི་འདུག་པ་ལ།",
    "ཇི་སྐད་གསུངས་པ་ཞིག་འདུག་གོ།",
    "མཚན་ཅན་ཞིག་གདའ་འོ།",
    "ནམ་མཁའ་ལའང་དཀྱིལ་འཁོར་གྱི་ཐིག་རྫོགས་པ་ཞིག་སྐྱ་ཏ་ལེ་འདུག་པ་རྨིས།",
    "མན་ངག་མ་ཐོབ་པས་དགེ་སྦྱོར་བྱེད་ལུགས་ཇི་ལྟ་བ་ནི་མ་བྱུང་འདུག།",
    "ཨ་སྐྱབས་ཀྱིས་གསོལ་ཇ་ཞུས་རྗེས་གསོལ་ཁ་ཞུ་ཡི་འདུག་པས།",
    "བིརྙ་པ་ལགས་སམ་ཟེར་བ་ཞིག་འདུག་པ་ལ།",
    "དེ་དང་རང་སེམས་འདྲེས་པའི་གནས་ལུགས་ལ་ངོ་སྤྲོད་མཛད།",
    "ངས་ནི་ཉི་འོད་ཐམས་ཅད་འོད་ཟེར་ཁ་དོག་སྣ་ལྔར་འདུག་གསུངས།",
    "སྦྱོར་དྲུག་བསྒོམས་པའི་ཡོན་ཏན་རྣམ་ཀུན་མཆོག་ལྡན་གྱི་སྟོང་གཟུགས་ཤར་བར་འདུག་གསུངས།",
    "ཕྱག་རྡོར་འཆི་བདག་འཇོམས་པ་༣༦ན་ཚེར་ཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "རྫོགས་པ་ཆེན་པོ་རང་བྱུང་རང་ཤར་གྱི་ཉམས་འཁྲིད་ལུང་བཅས།",
    "ས་དགོངས་པ་ལ་འཐད་རྒྱུ་རང་མ་བྱུང་འདུག།",
    "སྔར་ཁྱེད་ཀྱིས་ནན་ཏན་མཛད་པར་བརྟེན་དེ་ཙམ་བསྡད་ཡོད་ད་ཆ་དེ་འདྲ་མཛད་ནས་ཅི་གནང་ཁྱེད་རང་ལ་བལྟོས་བཅས་ཐམས་ཅད་རྗེས་སུ་འཛིན་ཞེས་ཞལ་གྱིས་འཆེས་པ་ནི།",
    "ལར་ང་རང་ཐ་མལ་སྙོམས་ལས་ཅན།",
    "བེང་ལ་བརྒྱ་དང་ཞེ་བརྒྱད་རྣམས་ཆ་ཤས་ཙམ་ཡིན་འདུག་རུང་རྗེས་འཇུག་རྣམས་ཀྱི་མིག་རྒྱན་ལ་ཕན་ནམ་སྙམ་གྱིས་བྲིས་སོ།",
    "ཁྱེད་མཆེད་གྲོགས་ཚོའི་ཐུགས་ལ་ཇི་ལྟར་གདའ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "ལྐེ་ཡང་འགྱོད་མེད་ཀྱི་བློ་བདེ་གཞན་ལས་ལྷག་པ་ཞིག་གདའ་བས།",
    "སྔར་གུང་ཐང་དུ་གནང་རྩིས་ཀྱི་གཏོར་གཤོམས་གྲུབ་མཚམས་གནམ་ངོ་ཆེན་པོ་སློ་བུར་དུ་བྱུང་བ་འོང་གསེབ་ཏུ་བསྒོར་ན་དཔོན་སློབ་གཉིས་གར་སྐུར་འདེབས་བྱུང་དོགས་ཀྱི་གཞོལ་བ་གནང་འདུག་པ་ད་ལམ་ཞལ་གསང་འཁྲིད་དང་ཤིས་བསྟན་པའི་རྗེས་གནང་ཡང་ཞུ་ཁ།",
    "ཚེ་འདིའི་མདུན་མ་སྒྲུབ་པའི་ཞེ་འདོད་མེད་པ་ཞིག་གདའོ།",
    "ཐ་རངས་ཐུལ་མེད་ཀྱི་ཞིང་ལ་ཡིད་སྨོན་མེད་པ་ཞིག་གདའོ།",
    "འཇའ་གུར་འཇའ་སྐྱ་འདུག།",
    "གཏེར་སྒོ་གཏེར་རྟགས་ཁ་བྱང་བཏབ་འདུག་བྲག་ཕུག་འདི་བཞིན་ལ་དཔགས་ན་ཟབ་གཏེར་བཞེས་རྒྱུ་ཞིག་ཀྱང་ཡོད་པར་མངོན།",
    "ད་འཆི་བ་ལ་འཇིགས་པ་མི་གདའོ།",
    "བན་རྒན་ང་རང་བསླུ་མེད་ཡིན་ནམ་སྙམ།",
    "འདི་སྐྱིད་ཕྱི་མར་ཨ་སྐྱིད་ང་རང་ཤེས།",
    "གཏོར་གཞིས་རྣམས་ཡུན་རིངས་པས་གསར་དུ་སྤོ་དགོས་འདུག་ཅེས་བསྟབ་པ་དང་ཚང་མ་ཆབས་ཅིག་པར་སྤལ་གྱི་ཡང་ཐོག་ཏུ་རྒྱས་པར་འབུལ་བ་མཛད་ནས་བྱམས་པར་སང་ཞོགས་ཐོར་ཇ་མི་དགོས་ད་དུང་ཇ་ཞིམ་པོ་སྐོལ་གསུངས་བྱམས་པས་སྙུང་བ་བཞིན་མེད་དམ་ཆབ་སྐོལ་ཨེ་བཞེས་ཞུས་པར་ན་ཚ་མེད་པར་ཆུ་སྐོལ་ག་ལ་དགོས་ཞེས་བ་འད།",
    "ཁྱབ་བདག་ཞ་ལུ་པ་ཆེན་པོ་ཐུགས་བྲེལ་ཆོད་དེ་འདིར་བྱོན་དུས་ལྟས་ཡ་མཚན་པ་བྱུང་ཚུལ་ཙམ་ལས་བདེ་གཟར་སོགས་ཀྱི་གཡེང་བ་དང་རྗེ་ཉིད་ཀྱང་ཡར་ཐེགས་པར་རིང་ཁྱད་འདུག་གཤིས་ཞག་མང་དུ་སྦྲེལ་བའི་འདི་དུས་ཞིབ་ཆ་མ་འཚལ།",
    "འགའ་ཞིག་སློབ་དཔོན་བེེ་རོ་ཙ་ནའི་སྤྲུལ་པ་ཞེས་བསྔགས་རྗོད་བྱེད་སྣང་བ།",
    "མ་འོངས་པ་ན་བསྟན་པ་ལ་ཕན་པ་ཞིག་འོང་བར་འདུག་ཅེས་མ་འོངས་མངོན་སུམ་དུ་མཁྱེན་པའི་བཀའ་སྩལ་གྱི་བསླབ་སྟོན་གནང་ངོ།",
    "དེ་དང་མཉམ་དུ་ཟླ་གཅིག་བསྡད་ནའང་བློ་བསྐྱེད་དཔག་ཏུ་མེད་པ་ཡོང་བ་འདུག་ཅེས་པ་བསྔགས་པ་མཛད་དོ།",
    "འཇམ་དབྱངས་སྟག་ལུང་བྲག་པའི་གསུང་རྒྱུན་ཡོངས་སུ་རྫོགས་པར་ཐོབ་པ་ཁོ་བོ་ཙམ་དུ་འདུག་པས།",
    "བཙས་མ་ཐག་པ་ནས་ཧྲཱི་དང་དྷཱི་དང་ཨ་ར་པ་ཙ་ན་སོགས་འབའ་ཞིག་འདྲེན་པ་བྱུང་ཞིང་།",
    "ཕྱིས་གཏམ་དེ་བདེན་པའི་ངེས་པ་མི་འདུག།",
    "གཙུག་ཕུད་འབུལ་མི་ཤིན་ཏུ་མང་བ་འདུག་པ་དང་ལྷན་ཅིག་པར།",
    "ནག་ཚོ་ལོ་ཙཱ་བ་བྲི་ཀ་མ་ལ་ཤཱི་ལར་བཞུགས་སྐབས་ནཱ་རོ་པ་ཕེབས་པ་ལ་ཇོ་བོ་ཆེན་པོས་ཕྱག་མི་འཚལ་བར་འདུག་པས།",
    "ཁྱེད་རང་ཡང་ཞག་ཤས་འདི་ཁར་སྡོད་ལ།",
    "སླད་ཁོང་རང་སླེབ་ནས་ཞིང་ནས་འཐུས་པའི་འབུ་སྲིན་ཐུ་བ་གང་གཏད་ནས་ཚོས་ལ་ཟོ་ཞིག་ཟེར།",
    "དོ་ནུབ་མུན་པའི་སྟབས་ཀྱིས་ཡོང་མི་ཐུབ་པར་འདུག།",
    "ལོ་ཙཱ་བས་ཁྲིད་ཡོངས་པ་དེ་པིཎྜ་ཏ་གཞའ་མ་མིན་པར་འདུག།",
    "ད་མི་འཇོག་པར་འདུག་ཟེར་འགྲོ་གྲབས་བྱེད།",
    "མངའ་བདག་ཁྲི་རལ་ལས་མ་གཅིག་ལབ་སྒྲོན་སྔ་བ་སོགས་མི་འགྲིགས་པའི་རྫུན་གྱི་རྫོབ་རྟགས་མང་དུ་འདུག།",
    "འདུ་འཛི་འཕེལ་ཡང་རང་དོན་ཡལ་འདོར་བའི།",
    "ཐུགས་དམ་གྱི་ངང་རང་དུ་བཞུགས་པས་གདངས་བསྐྱེད་ཆེ་བར་བྱུང་།",
    "ཕལ་ཆེར་བེག་རྩེ་འདི་བཀའ་ཉན་བྲན་གཡོག་རང་བྱེད་པ་ཅིག་ཡོད་འདུག་པས།",
    "བསྟེན་མཆོད་བྱས་ན་མཚན་མ་མྱུར་བར་འོང་བ་འདུག།",
    "རིམ་གྲོས་ཟློག་པར་འདུག།",
    "ལར་རྒྱལ་བ་གཉིས་པའི་བསྟན་པ་འདི་ཐུགས་རང་ལ་གཅགས་པའི་ཉམས་ཆེན་པོ་བརྗོད་ལས་འདས་པར་གདའ་བས།",
    "ཕྱིས་བསམས་ཚེ་ལོ་དེའི་འཇུག་ཏུ་ཁར་ཁ་ཨ་ས་ལང་འོང་རྒྱུ་ཡིན་པ་ལ་དགོངས་པར་འདུག།",
    "ཨ་ས་ལང་ཕར་མཚོ་ཁར་ལོག་ན་ཕ་དང་ཨེ་འཕྲད་ཞུས་པས་མི་འཕྲད་ཅིང་བར་ཆད་ཆེ་བ་འདུག་གསུངས།",
    "དཔོན་ཡང་སྐུ་ཁམས་བཟང་བར་འདུག།",
    "བརྟག་པ་འདི་ཅི་འདྲ་ཡིན་བསམས་པ་ཤར་བ་རྗེས་སུ་གླེང་བརྗོད་བྱུང་འདུག།",
    "ཡོད་ཚོད་དུ་འདུག་ཀྱང་འདི་ཞེས་བརྗོད་པའི་ཡུལ་ལས་འདས་སོ།",
    "དེ་ཡང་སེམས་ངོ་ཇི་བཞིན་མ་འཕྲོད་པའི་སྐྱོན་དུ་འདུག་གོ།",
    "དབུ་ཐོད་དང་ཚེམས་འཕེལ་བའི་དུང་གཡས་འཁྱིལ་རྣམས་གདུང་རྟེན་དུ་བཞུགས་འདུག་པས།",
    "བྲག་ལ་ཟིལ་པ་ཁ་བ་བབས་པ་ཙམ་འདུག་པའི་འོག་ནས་འཛེང་རྡོ་དཀར་པོ་སོགས་སྤྱན་དྲངས་པ་ཡིན་ཏེ།",
    "དུས་ཕྱིས་མཐུ་སྟོབས་དང་ནུས་པ་རིག་འཛིན་ཆེན་པོ་འདི་ཉིད་ལས་ལྷག་པ་ནི་མ་བྱུང་པ་འདུག།",
    "འབྲི་གུང་དཔལ་འཛིན་སོགས་ཀྱི་རིག་པ་རྣོན་པོར་རློམ་པའི་རྩོད་པ་ལ་ལན་བཟློག་ཏུ་མེད་པའི་སོམ་ཉི་ཟ་བ་མི་འདུག་པས་གནོད་པར་མ་ནུས་ཀྱང་།",
    "རྫུན་པོ་ཏ་ཚེ་སྒྲུབ་རྒྱལ་བ་འདུས་པའི་སྐོར་ལ་ཡང་སྐྱོན་མང་པོ་འདུག་པ་རྣམས་ཡི་གེ་མངས་ཀྱི་དོགས་པས་འདིར་མ་བཀོད།",
    "གཙོ་བོར་ཉིད་དགོངས་འདུས་ཀྱི་གཏེར་ཞབས་སྡུད་པར་ཞལ་གྱིས་བཞེས་འདུག་པ།",
    "སྡིག་བློན་རྣམས་གྱིས་སློབ་དཔོན་པདྨ་མངའ་བདག་ལ་དུག་གཏོང་བར་འདུག་ཅེས་སྒྲོག་པ་ལྟ་བུའོ།"
  ]
}