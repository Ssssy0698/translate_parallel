    "དེ་ཡང་རང་བཞིན་གྱིས་བརྟན་ཅིང་སྒམ་པ།",
    "འཕགས་པའི་གནས་བརྟན་བཅུ་དྲུག་དེར་འབྱོན་པ་ཡོད་པས་གྲབས་ཡུལ་མ་ཐོགས་པ་གལ་ཆེ་གསུང་བ་ཞིག་འདུག་པས།",
    "སྒོའི་ཕྱི་རོལ་དེར་ཕེབས་བསྒུགས་ཞུ་ཞིང་བཞུགསཡོད་ཙ་ན།",
    "ང་ནང་དུ་སྤྱོན་གསུངས་བྱུང་བ་དང་ནང་དུ་བྱོན་ཙ་ན།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པ་ནི་བཞུགས་མི་འདུག།",
    "ཐམས་ཅད་ང་རང་ཡིན་གསུང་བ་དང་།",
    "ཉིན་གཅིག་འོད་ཀྱི་གུར་ཁང་ཞིག་འདུག་པ་ལ་ཕྱག་མང་དུ་མཛད་པས།",
    "བྱང་ཕྱོགས་པ་རྣམས་ལྗང་ཁུར་འདུག་གསུངས།",
    "ཀྵེ་ཏྲ་པཱ་ལ་འདིས་མི་མགོ་ཞིག་ཁྱེར་འདུག་གསུངས།",
    "ཞལ་ཐང་དེའི་རྒྱབ་ན་གཟུངས་སྔོན་གྱི་ཕྱག་བྲིས་མ་ཡང་ཡོད་འདུག་པས།",
    "འདི་ངའི་ཐེའུ་ཚེ་ཡིན་པ་འདུག་གསུང་བ་སོགས་ངོས་འཛིན་མཛད་པ་ནི་གྲངས་ཀྱིས་མི་ཆོད་དོ།",
    "ཡབ་ཀྱིས་འོ་ན་འདི་ཅི་ཡིན་པ་འདུག་པ་ཞེས་ཞུག་པས།",
    "ཡིན་ངེས་ན་གང་ས་ནས་ལེགས་པ་འདུག།",
    "ད་ལམ་ངེད་ཁམས་ཅུང་ཟད་མ་བདེ་བ་འདིས་འོང་མི་ཐུབ་པ་འདུག་པ་ནས།",
    "ཚུལ་མ་ཡིན་པའི་བྱ་བ་འདི་ལས་ཆེ་བ་གཞན་ན་མེད་པ་ལྟ་བུར་འདུག་པས།",
    "འདི་ནི་ཕུངས་འཚེངས་ཀྱི་གཞི་ཆེན་པོར་གདའ་བ་ནས།",
    "མཐའ་དག་ཀྱང་མ་ཡེངས་པར་ཐུགས་དམ་ཤུགས་དྲག་ཏུ་བྱེད་དགོས་པ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "སྔགས་སྔ་མ་དེ་འཇམ་དཔལ་གྱི་སྔགས་ཡིན་འདུག་པ་འཇམ་དཔལ་རྩ་རྒྱུད་ལས་གསུངསཔ་དེ་དྲན་ནས་ལུང་ཞུས་སོ།",
    "ང་རང་སྲོང་བཙན་སྒམ་པོ་བྱེད་དུསརྒྱབ་པ་ཡིན་གསུངས།",
    "གཞན་ཡང་རང་གཞན་གྱི་འཁྲུངས་རབས་དང་སྐྱེས་རབས་སྣ་ཚོགས་གསུང་བ་སོགས་བརྗོད་ཀྱིས་མི་ལང་ཞིང་།",
    "སྔོན་མ་ཚོ་བློ་ལ་མ་ཟིན་བརྗེད་འདུག་གསུངས།",
    "འདུག་པ་ཨེ་མཐོང་།",
    "ཡབ་ཀྱིས་ཞལ་གཅིག་ལས་མི་འདུག་པ་ཞུས་པར།",
    "ཡང་ཉིན་གཅིག་ངའི་གདན་དེ་དམས་འདུག་གསུངས་ནས་ས་གདན་གྱི་སྟེང་དུ་འབོལ་ཁ་གདན་སོགས་མང་དུ་བརྩེགས་ཀྱང་།",
    "ཁོང་ང་ལ་དད་པ་ནི་མེད་ཅེས་གསུང་བ་ཡང་ཡོད་འདུག།",
    "ཕྱག་གཡོག་མི་ནུསཔར་འདུག་པས་པཎ་ཆེན་བསོད་གྲགས་པས་ཀྱང་།",
    "དྲུང་དུ་འཁོད་པ་རྣམས་ཀྱིས་ཅི་འདུག་པ་ཡིན་ཞུས་པས།",
    "ད་ལྟ་ཡང་འདི་ཁར་བཞུགས་འདུག་གསུངས།",
    "མི་གཉིས་པོ་དེ་ཁོང་གཉིས་ཀྱི་སྤྲུལ་པར་འདུག།",
    "ང་གཟིམས་ཆུང་དུ་འདུག་པའི་མདུན་དུ།",
    "ངོས་གཅིག་ལ་ཕུག་པ་མགོ་ཤོང་བ་ཙམ་ཞིག་ཡོད་པ་ཞིག་འདུག།",
    "ལྕགས་ཁང་དེའི་ནང་ན་རོ་ཆེན་པོ་ཁང་པ་ཙམ་ཞིག་འདུག།",
    "གཡོན་ན་ཁྲག་ནག་པོ་འཛག་ཅིང་འདུག།",
    "མིག་ཕྱིར་བལྟ་བ་ཞིག་འདུག་པས།",
    "ཕྱི་འདི་ན་སྔར་མེད་པའི་དུར་ཁྲོད་ཅིག་འདུག་པས།",
    "མཚོ་ནག་པོ་ཆེན་པོ་ཞིག་འདུག་པ་དེ་མི་གསུམ་ཙམ་གྱི་དཔངས་སུ་འབར་ཞིང་འབྱུག་པ།",
    "དེ་ནས་བལྟས་ཙ་ན་ཕྱི་བལྟས་ནང་གསལ།",
    "ནང་བལྟས་ཕྱི་གསལ་བ་ཞིག་འདུག་དེ་ནས་ཨ་ཙ་ར་ཆུང་བ་ཞིག་བྱུང་ནས།",
    "སྤྱན་ཕྲ་སེ་བ་བྱེད་དགོས་འདུག་གསུངས་དགོངས་པ་ཅན་གྱི་བཀའ་ཕེབས།",
    "ལམ་རིམ་ཡིན་པ་འདུག་ཞུས་པས།",
    "སྐུ་རིམ་པ་རྣམས་ཀྱིས་ཨེ་ཟིན་བལྟས་འདུག་པས།",
    "ངའི་སྐུ་བྲིས་པ་དེ་སྟོན་དང་ཟེར་བསྟན་པས་ལེགས་འདུག།",
    "ང་རང་གུ་རུ་པདྨ་ཡིན།",
    "བྲག་རི་དམར་པོ་གཉིས་ཀྱིས་བར་ལ་ཕྱིན་པས་ཟངས་ཀྱི་བུམ་པ་ཁ་གཅོད་ཡོད་པ་ཞིག་འདུག་པའི་རྩར་སླེབ་པ་དང་མཉམ་དུ།",
    "དེ་གཉིས་གས་ང་ལ་ཡང་བཀུར་སྟི་བྱས་སློབ་དཔོན་ཡོན་མཆོག་པ་ལ་ཡང་དགའ་བའི་རྣམ་འགྱུར་སྟོན་གྱི་འདུག་གསུངས།",
    "གནས་ཁང་མུན་པ་ནག་པོ་ཡོད་པའི་ནང་ན་འདུག་ཅིང་།",
    "དེའི་ལོགས་གཅིག་ལ་དཀར་ཁུང་སྣག་བུམ་གྱི་ཁ་རྒྱ་ཙམ་ཞིག་འདུག།",
    "ཕྱག་གཡས་རལ་གྲི་འཕྱར་པ་ལས་འོད་ཟེར་རྒྱང་ངེར་འཕྲོ་བ་ཞིག་བཞུགས་འདུག།",
    "མར་བལྟས་ཙ་ན་འཛམ་བུ་གླིང་ཡིན་ཟེར་བའི་ཀོ་བ་ཙམ་ཞིག་འདུག།",
    "འཇའ་འོད་དཀར་པོ་ཞིག་ཤར་འདུག་པའི་སྟེང་ན།",
    "བལྟས་པས་རྗེ་དྲུང་གང་བཞུགས་འདུག་ཅིང་།",
    "གོ་རིམ་ཆོ་ག་ལག་ལེན་རྣམ་པར་དག་པ་འདི་ལྟ་བུ་མཐོང་ཙ་ན།",
    "མི་མགོ་བསྐོར་ནས་ཚེ་འཕྱིད་པ་དག་མཐོང་ཙ་ན།",
    "ཡེ་ཤེས་ཆེན་པོའི་བདུད་རྩིས་ཁྱབ་པར་འགྱུར་བ་འདི་ལྟ་བུ་དག་མཐོང་ཙ་ན།",
    "ཀློངས་ལའི་རྩེ་ན་ང་ཅུང་ཟད་ངལ་གསོ་ཞིང་འདུག་པས།",
    "མ་བྱས་ན་མི་འོང་བ་འདུག་གསུང་།",
    "གུ་གེ་བདག་པོའི་གདུང་བརྒྱུད་འདི་ལ་མངའ་བདག་ཙེ་ལྡེ་བྱ་བ་ཞིག་བྱུང་འདུག་པ་དང་།",
    "གུས་བཏུད་དང་བཤགས་པ་ཕུལ་འདུག་ཀྱང་།",
    "མགོན་པོ་འདིའི་སྐུ་༤༦ན་ཁྱེར་ས་མེད་པ་འདུག་སྟེ།",
    "ཁྱེད་རང་སྐོར་ལམ་དུ་བྱོན་དང་།",
    "རང་བྱོན་ཞིག་འོང་བ་འདུག་ཟེར་བའི་སྒྲ་ཞིག་བྱུང་།",
    "གསང་བའི་ཡི་དམ་རྡོ་རྗེ་གདན་བཞི་བྱས་ན་ལེགས་ཚོགས་ཆེ་བ་འདུག་ཟེར་བ་ཞིག་བྱུང་བས།",
    "དེ་ནུབ་ཁྲག་ཅིག་དགོས་རྒྱུར་འདུག་ཀྱང་མི་རྙེད་པ་འདྲ་ཞེས་གསུང་།",
    "བལྟས་ཙ་ན་འོ་མ་བྱོ་འདུག་པ་དེས་ཁྲག་དེ་རྣམས་དག་འདུག།",
    "གང་ལྟར་ན་ཡང་ཁོང་གཉིས་གཏོར་མ་ལ་ཧམ་པོ་བྱེད་ཀྱིན་འདུག་པས།",
    "སུ་ར་ཀ་ར་གཉིས་བྱུང་བ་ཡིན་ཚོད་འདུག་པ་རྣམས་བརྗེད་ཐོར་བཀོད་པ་ཡིན་ཞེས་སོ།",
    "མགོན་པོ་ཞལ་བཞི་པ་རྣམས་ཀྱི་ཆོ་འཕྲུལ་ཡིན་པར་འདུག།",
