    "དུས་གཞན་དུ་སླར་ཡང་རྒྱུ་སྐར་དེ་ཉིད་ཟིལ་གྱིས་གནོན་པར་འགྱུར་ར་རོ།",
    "ཇི་ལྟར་གང་དག་བདེ་བ་དང་སྡུག་བསྔལ་རྒྱུ་སྐར་ལ་རག་ལས་པར་བརྩི་བ་ད་ང་།",
    "དེ་བས་ན་གང་དག་བདག་ལ་ནུས་པ་མེད་པ་དེ་དག་ཇི་ལྟར་གཞན་ལ་ནུས་པར་འགྱུར།",
    "དེའི་ཕྱིར་དགེ་སྦྱོང་ངམ་དགེ་སྦྱོང་དུ་ཁས་འཆེ་བས་རྒྱུ་སྐར་བསམ་པར་མི་བྱའོ།",
    "འཇིག་རྟེན་ལ་སྣ་ཚོགས་པར་སེམས་པར་བྱེད་ད་དོ།",
    "ཐོས་པ་དང་མི་ལྡན་པ་བྱིས་པ་གཟའ་གཞན་དག་སེམས་པར་བྱེད་ཅི་ང་།",
    "འཇིག་རྟེན་ལས་འད་ས་པའི་རྒྱུ་སྐར་ཉི་ཤུ་རྩ་བརྒྱད་སེམས་པར་མི་བྱེད་དོ།",
    "ཡང་དག་པར་སྡོམ་པ་དང་།",
    "གང་དག་བསམས་ཏེ་ཡང་ད་ག་པར་སོ་སོར་བརྟགས་ནས་དེ་དག་དང་༧བྲལ་བ་ལས་མྱ་ངན་ལས་འདས་པ་འཐོབ་པར་འགྱུར་བ།",
    "ལུས་ལ་སུམ་ཅུ་རྩ་དྲུག་པོ་སེམས་པར་མི་༨བྱེད་ད་དོ།",
    "མྱ་ངན་ལས་འད་འ་བར་འགྲོ་བར་བྱེད་པར་འགྱུར་ར་རོ།",
    "ཟླ་བ་ཕྱེད་དང་ལྡན་པར་སེམས་པར་བྱེད་ཀྱི།",
    "མི་དང་མི་མ་ཡིན་པའི་ཆེའི་འདུ་བྱེད་ཟད་པའི་དུས་ནི་སེམས་པར་མི་བྱེད་དོ།",
    "བསམ་གཏན་དང་ཀློག་པ་ལ་བར་དུ་ག་ཅོད་པ་སེམས་པར་བྱེད།",
    "འཇོག་པར་བྱེད།",
    "འཚེ་བར་བྱེད་དོ་ཞེས་གཞན་དག་ལ་འདོམས་༢པར་བྱེད་ད་དོ།",
    "སྡུག་བསྔལ་བ་ད་ང་ཡིད་མི་བདེ་བ་ལས་སྒྲོལ་བར་བྱེད་པར་མི་འགྱུར་རོ།",
    "མྱ་ངན་ལས་འདའ་བའི་ཕྱིར་དང་བདེ་བའི་ཕྱིར་དང་ཞི་བའི་ཕྱིར་འབྲས་བུ་ད་ང་བཅས་པར་འགྱུར་གྱི།",
    "སེམས་པ་ནི་སྐྱེས་བུ་བརྒྱ་ཕྲག་སྟོང་བརླག་པར་གྱུར་ཅིང་།",
    "དེ་ད་ག་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་ད་ང་གཏི་མུག་སྐྱེད་པར་བྱེད་པར་འགྱུར་ར་རོ།",
    "ཡིད་མི་བདེ་བ་དང་བྲལ་བའི་གོ་འཕང་འཐོབ་པར་འགྱུར་བ།",
    "ཟག་པ་མེད་པའི་གོ་འཕང་མྱ་ངན་ལས་འད་ས་པ་འདི་ལ་དགེ་སྦྱོང་ངན་པ་ད་གེ་སྦྱོང་དུ་ཁས་འཆེ་བས་གདོན་མི་ཟ་བར་བསླབ་༢པར་བྱའོ།",
    "གང་ཞིག་ཤེས་ཀྱང་གཏན་དུ་བའི་བདེ་བ་བྱེད་པར་མི་འགྱུར།",
    "མྱ་ངན་ལས་འདས་པའི་མཐར་ཐུག་པར་བྱེད་པར་མི་འགྱུར་གྱི།",
    "དེ་ལྟར་ན་དགེ་སློང་རྒྱུ་སྐར་སེམས་པ་དང་བརྩི་བ་ནི་སྨད་པར་འགྱུར་རོ་ཞེས་གསུངས་ས་སོ།",
    "རིག་པའི་གནས་བཅུ་གཉིས་པོ་དེ་མ་ལུས་པར་འཇིག་རྟེན་ན་དར་བར་འགྱུར་བ་ནི་མེད་ད་དོ།",
    "གང་ལྷ་ད་ང་དྲང་སྲོང་རྣམས་ཀྱིས་བསྟན་པ་དེ་རབ་ཏུ་བྱུང་བ་རྣམས་ལ་རྗེས་སུ་མཐུན་པར་བསྟན་པར་ཅིའི་ཕྱིར་མི་འགྱུར་ཞེ་ན།",
    "ལོག་པར་ལྟ་བའི་བར་ལ་བརྩོན་པ་ཡོད་པའི་གཏམ་ནི་རབ་ཏུ་བྱུང་བ་ལ་རྗེས་སུ་མཐུན་པར་བརྗོད་པར་མི་བྱའོ་ཞེས་གསུངས་ས་སོ།",
    "འདི་ནི་འབྲས་བུ་མེད་པར་འགྱུར།",
    "སྨིན་པར་སྣང་བ་དེ་ཡི་ཕྱིཕྱིར།",
    "ཞེས་གསུངས་སོ་༐།",
    "བསམ་གཏན་ད་ང་ཀློག་པ་ལས་ཉམས་པར་འགྱུར་རོ།",
    "བས་མཐའི་གྲོང་ན་གནས་པ་བསྟེན་༧པར་མི་བྱའོ།",
    "ལེ་ལོ་ཅན་དང་ལྷན་ཅིག་གནས་པར་མི་བྱའོ།",
    "ཞིམ་ལྟོ་ཅན་ད་ང་ལྷན་ཅིག་གནས་པར་མི་བྱའོ།",
    "ལྟར་བསྟེན་༢པའམ་འགྲོགས་པར་བྱེད་པ་ནི།",
    "ངེས་པར་དེ་ལྟ་བུའི་ངང་ཚུལ་ཅན་དུ་འགྱུར་རོ་ཞེས་སེམས་པར་བྱེད་ད་དོ།",
    "དེ་གཞན་གྱི་སྐྱོན་དེས་གོས་པར་༐",
    "དེའི་ཕྱིར་དེ་དག་ལ་བརྟེན་པར་མི་བྱའོ།",
    "གཙང་སྦྲ་སྟེན་བྱེད་ངང་པ་ནི།",
    "རོ་དང་འགྲོགས་པར་འོས་མ་ཡིན།",
    "ལ་བརྟེན་༡༧པ་ཐབས་དུ་མས་སྨད་པ་ནི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ཐམས་ཅད་ཀྱིས་སྨད་དོ།",
    "དེ་ནི་གཏན་༢དུ་བའི་ཞི་བ་བསྟེན་པར་འགྱུར་ར་རོ།",
    "གདོན་མི་ཟ་བར་ལེགས་པ་༤འཐོབ་པར་འགྱུར་ར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་བསྟེན་པའོ།",
    "དེ་བསྟེན་པ་ན་བསམ་གཏན་དང་ཀློག་པ་ལས་ཉམས་པར་འགྱུར་ར་རོ།",
    "དེས་དེ་མངལ་ཆགས་པར་གྱུར་པ་དེའི་ཚེ་རྒྱལ་པོ་འདི་སྙམ་དུ་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པ་༢ིགཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པར་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པ་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པར་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "དགེ་སློང་དག་གཞན་ཡང་རྒྱལ་པོ་དུས་མ་ཡིན་པར་བསྟེན་པ་ལ་སྦྱོར་བ་དེའི་ཚེ་གང་དག་དེའི་ཡིད་དུ་མི་འོང་བ་དེ་དག་འདི་སྙམ་དུ་འགྱུར་ཏེ།",
    "ཁོང་ཁྲོ་བ་མེད་པས་སྦྱིན་པ་དེ་གཉིས་ལ་གནས་པར་བྱའོ།",
    "ཡོ་བྱད་༢རྣམས་ཡོངས་སུ་བཏང་ཞིང་མགྲོན་༢དུ་གཉེར་བར་བྱེད་དོ་ཞེས་གསུངས་ས་སོ།",
    "སྦྱིན་པ་དེ་ནི་འདུསམ་བྱས་ལ་བསྔོས་པ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་བྱེ་བྲག་འཐོབ་པར་འགྱུར་བ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ལེགས་པར་བྱས་པ་གདོན་མི་ཟ་བ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ཡང་དག་པར་བསྔོས་པ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་བསྔོས་པ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་བཏང་བ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཕྱིར་བསྒྲུབས་པ་སྟེ།",
    "བློན་པོ་ཆེན་པོ་ལ་ཡང་དག་པར་སྟོན་པ་དེ་ལྟར་གདོལ་པའམ།",
    "གདོལ་བུ་ལ་ཡང་ད་ག་པར་སྟོན་ན།",
    "བསླབ་ཅིང་༤སྦྱིན་པ་སྦྱིན་པར་བྱའོ་སྙམ་སྟེ།",
    "དེ་སྦྱིན་པ་ཡང་སྦྱིན་ཞིང་སྦྱིན་པ་དེས་ཁེང་ས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "མང་དུ་ཐོས་པས་༥རྒྱགས་ཤིང་དྲེགས་པས་སྦྱིན་པ་མི་སྦྱིན་གྱི་ཅི་སྦྱིན་པ་དེ་ཡང་བསྟི་སྟང་དུ་བྱས་ཤིང་སྦྱིན་པས་༦སྦྱིན་པར་བྱེད་དོ།",
    "བཙུན་པར་བྱས་ཤིང་སྦྱིན་པ་སྦྱིན་པར་བྱེད་ད་དོ།",
    "ཚང་ས་པ་མཚུངས་པར་སྤྱོད་པ་དག་མཐོང་ན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་ིལ་སྤོས་སམ།",
    "ཀུན་ཆུབ་པར་བྱེད་ད་དོ།",
    "རྣམ་པར་དག་དང་རྣམ་དགུ་སྟེ།",
    "རྣམ་པར་དག་པའི་སྦྱིན་པའོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཁ་ན་མ་ཐོ་བ་མེད་པ་ཐམས་ཅད་ཡོངས་སུ་གཏོང་བ་དང་།",
    "སུ་གང་འདོད་པ་དེ་ལ་དངོས་པོ་དེ་སོ་སོར་སྦྱིན་པར་བྱེད་པ་ནི།",
    "སྦྱིན་པའི་༢ངོ་བོ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་རྣམ་པ་གཉིས་ཏེ།",
    "ཇི་སྐད་སྨོས་པ་འདི་ལས་མ་གཏོགས་པའི་ལྷག་མ་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོང་ས་སུ་གཏོང་བ་ནི།",
    "ཕྱི་རོལ་གྱི་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོངས་སུ་གཏོང་བ་ཁོ་ན་ཞེས་བྱའོ།",
    "གཞན་ལ་རག་ལས་པར་བྱེད་ཅིང་བདག་ཉིད་གཞན་དག་ལ་སྦྱིན་པར་བྱེད་ད་དེ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོང་ས་སུ་རྫོགས་པར་བྱེད་པར་འདོད་དེ་༡།",
    "དེ་ད་བང་བར་བྱ་བའི་ཕྱིར་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་བཏང་བའི་སེམས་ཀྱིས་སྦྱིན་པར་བྱེད་དེ།",
    "ཅི་ཞིག་ནི་སྦྱིན་པར་མི་བྱེད།",
    "ཇི་ལྟར་ནི་སྦྱིན་པར་བྱེད་ཇི་ལྟར་ནི་སྦྱིན་པར་མི་བྱེད་ཅེ་ན།",
    "ཕན་པར་མི་འགྱུར་བའམ།",
    "སྦྱིན་པ་གང་ཕན་པར་ནི་འགྱུར་ལ།",
    "འདི་མན་ཆད་ནི་རྒྱས་པ་རྣམ་པར་དབྱེ་བ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ཕ་རོལ་ལ་༢རག་ལས་པར་བྱེད་པར་བདག་ཉིད་སྦྱིན་པར་མི་བྱེད་ད་དེ།",
    "བདུད་ཀྱི་རིས་ཀྱི་ལྷ་རྣམ་པར་ཐོ་༩འཚམས་པའི་བསམ་པས་སློང་དུ་འོངས་པ་རྣམས་ལ་ཡང་དེ་དག་ཉིད་ལ་གནོད་པ་དང་།",
    "ཡན་ལག་གསེ་ཞིང་སྦྱིན་པར་མི་བྱེད་དོ་༢།",
    "ཕ་རོལ་ལ་གནོད་པར་བྱ་བའི་ཕྱིར་འདོད་དེ་སློང་ན།",
    "སློང་བ་རྣམས་ལ་ནི་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "ཕ་རོལ་ལ་ཕན་པར་བྱ་བའི་ཕྱིར་འདོད་དེ་སློང་ན།",
    "སློང་བ་རྣམས་ལ་སྦྱིན་པར་བྱེད་དོ།",
    "དངོས་པོ་དེས་ཀྱང་སྡུད་པ་དང་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཕྱིར་ར་རོ།",
    "ཇི་ལྟ་བུ་ནི་སྦྱིན་པར་བྱེད་ཅེ་ན།",
    "ལྷ་རྟེན་༦རྣམས་སུ་ཕྱུགས་གསོད་པ་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "སྲོག་ཆགས་དེ་དག་ལ་གནོད་པར་བྱ་བའི་ཕྱིཕྱིར།",
    "སློང་ན་སྦྱིན་པར་མི་བྱེད་དོ།",
    "གནོད་པ་བྱེད་དུ་གཞུག་པའི་ཕྱིར་ཡང་དགྲ་རྣམས་ཀྱི་དགྲ་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "གནོད་པར་འགྱུར་བ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ།",
    "བཏུང་བ་བསོད་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ།",
    "རྡེག་པར་བྱེད་པའམ་དུག་འཐུང་བའམ།",
    "རག་ལུས་པར་བྱ་བ་ཡིན་ན།",
