    "ཡོངས་སུ་ཟིན་པ་རྣམས་ལེགས་པར་བརྡ་མ་སྤྲད་པ་ད་ང་།",
    "ཡིད་མི་དགའ་བཞིན་དུ་གཞན་འདོད་པ་རྣམས་ལ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ་། ལེགས་པར་བརྡ་སྤྲད་དེ་ཡིད་ད་གའ་ཞིང་འདུན་༢པར་གྱུར་དུ་ཟིན་ཀྱང་།",
    "ངས་པ་༦རྣམས་ལ་སྦྱིན་པར་མི་བྱེད་དོ།",
    "བརྗེད་ངས་པ་༡རྣམས་ལ་རྒྱལ་སྲིད་སྦྱིན་པར་ཡང་མི་བྱེད་དོ།",
    "ཞོ་ཤས་འཚོ་བའི་བར་དག་ལ་གནོད་པ་བྱས་ནས་ཕ་རོལ་སློང་བ་རྣམས་ལ་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོངས་སུ་གཏོང་བར་ཡང་མི་བྱེད་དོ།",
    "ཕ་རོལ་ལ་གནོད་པར་བྱས་ཤིང་ཉམ་ང་བར་བྱས་པས་ཀྱང་མ་ཡིན་ན་ནོ།",
    "ཇི་ལྟར་དམ་བཅས་པ་ལས་བསྐྱུངས་ཏེ་སློང་བ་ལ་སྦྱིན་པར་མི་བྱེད་ཀྱི།",
    "ཐ་ཆད་སྦྱིན་པར་མི་བྱེད།",
    "ངན་པ་དང་ཐ་ཆད་སྦྱིན་པར་དམ་བཅས་སུ་ཟིན་ཀྱང་།",
    "བཟང་པོ་ཡོད་ན་བཟང་པོ་འབའ་ཞིག་སྦྱིན་པར་བྱེད་ད་དོ།",
    "ཡིད་འཁྲུགས་༡པས་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ།",
    "དྲངས་སོ་ཞེས་སྨོས་པར་ཡང་མི་བྱེད་ད་དོ།",
    "ལྟ་བ་ངན་པ་མཆོག་ཏུ་འཛིན་ཅིང་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དེ།",
    "དགེ་མཚན་དང་བཀྲ་ཤིས་དང་སྦྱར་ཏེ་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱི་སྦྱིན་པ་ཙམ་ཤིན་ཏུ་རྣམ་པར་ད་ག་པས་ཀྱང་༩འཇིག་རྟེན་པ་ད་ང་།",
    "འཇིག་རྟེན་ལས་འདས་པའི་འདོད་ཆ་གས་དང་བྲལ་བ་རྣམ་པར་དག་པར་༡འགྱུར་བར་ཡང་མི་འཛིན་ཏེ།",
    "སྦྱིན་པ་ནི་རྣམ་པར་དག་པར་འགྱུར་བའི་ཚོགས་ཙམ་འབའ་ཞིག་ཡིན་པར་འཛིན་ཏོ།",
    "འབྲས་བུ་ལ་ལྟ་ཞིང་སྦྱིན་པར་མི་བྱེད་ད་དེ།",
    "གཞན་གྱིས་བཀྲི་བ་མེད་པར་སྦྱིན་པ་སྦྱིན་པར་བྱེད་ད་དེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱས་པར་རིག་པར་བྱའོ།",
    "དེ་ལྟ་བུ་དང་མཐུན་པ་༩རྐྱེན་དུ་མི་འབབ་པའི་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "ཚིགས་སུ་བཅད་པ་ལ་བརྟེན་ཅིང་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་དོ་༤།",
    "ད་བང་ཕྱུག་ལ་བརྟེན་ཅིང་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ།",
    "སྦྱིན་བད་ག་ཡིན་པར་ཤེས་ནས་བཀུར་སྟིར་༦བྱེད།",
    "བཀྲེན་པའི་ཚུལ་དུ་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དེ།",
    "ཉུང་ངུ་ལས་ཀྱང་ཕལ་ཆེར་སྦྱིན་པར་བྱེད་ན་མང་པོ་ལས་ལྟ་ཅི་སྨོས།",
    "འདི་སྦྱིན་པ་འདིས་བྲིད་དེ་ཡིད་ཆེས་པར་བྱས་ལ་དེའི་འོག་ཏུ་བསླུ་བར་བྱའོ་སྙམ་སྟེ།",
    "གཞན་དག་ལ་གླགས་བཙལ་བའི་ཕྱིར་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་ད་དོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་ད་དོ།",
    "གཞན་དག་ལ་འཚེ་བའི་ཕྱིར་གཞན་ད་ག་ལ་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད།",
    "བསྐྲད་པའི་ཕྱིར་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "བདག་དང་༡༧ཕ་རོལ་ལ་རུང་བ་སྦྱིན་པར་བྱེད་ཀྱི་མི་རུང་བ་༡༧ནི་མ་ཡིན་ནོ།",
    "ཚུལ་བཞིན་དུ་བྱེད་ཀྱི་ཚུལ་བཞིན་མ་ཡིན་པར་ནི་མི་བྱེད་ད་དོ།",
    "སེམས་མ་གཡེངས་པས་སྦྱིན་པར་བྱེད་ཀྱི་སེམས་གཡེངས་པས་ནི་མ་ཡིན་ན་ནོ།",
    "སྦྱིན་པ་བརྒྱངས་༢ཏེ་སྦྱིན་པར་མི་བྱེད་ཀྱི་ལ་གོར་དུ་མྱུར་དུ་སྦྱིན་པར་བྱེད་ད་དོ།",
    "གཞན་དག་ལ་སུ་༥ཅི་འདོད་པ་དེ་ལ་དེ་སྦྱིན་པར་བྱེད་ད་དོ།",
    "སྦྱིན་པ་ན་ཤེས་རབ་ཅན་གྱི་སྦྱིན་པ་ཁོ་ན་སྦྱིན་པར་བྱེད་ད་དོ།",
    "སྡུག་པ་ཤོས་ལ་སྦྱིན་པ་སྦྱིན་པར་༐",
    "སློང་བ་དེ་ལ་འདི་སྐད་དུ་སྡུག་པ་འདི་ལ་སྦྱིན་པར་བྱེད་པའི་ད་ངོས་པོ་འདི་༢ངས་༐",
    "ཤད་ཀྱིས་སྦྱོང་༧བར་བྱས་ཏེ་གཏོང་བར་བྱེད་དོ།",
    "ཁྱེད་ནོར་འགོད་པ་མེད་པར་ང་ལ་ཕན་གདགས་པ་ཆེན་པོས་ཉེ་བར་གནས་པར་གྱིས་ཤིག།",
    "ང་ནི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོང་ས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་སློང་བ་པོ་འདོད་ཀྱིས།",
    "དགའ་བར་བྱས་ནས་རིགས་ཀྱི་བུ་འདི་བད་ག་ཅག་༥ལ་སེམས་དགའ་བར་འགྱུར་རོ་སྙམ་སྟེ།",
    "དེ་བཞིན་དུ་བྱེད་པར་འགྱུར་ར་རོ།",
    "རིམ་གྱིས་གོམས་པར་བྱེད་པ་དེ་དེ་དང་།",
    "མ་ཆགས་པ་ཆུང་ངུ་ལ་བརྟེན་ནས་འབྲིང་ཐོབ་པར་འགྱུར་ལ་འབྲིང་ལ་བརྟེན་ནས་ཆེན་པོ་ཐོབ་པར་འགྱུར་ར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་གང་ད་ག་ཆགས་པའི་རང་བཞིན་ཅན་དང་།",
    "དེའི་ཉེས་པར་སྤྱོད་པ་གཞན་དག་ལ་ཡང་འཆབ་པར་བྱེད་ན།",
    "དེའི་༢འདོད་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་ལ།",
    "ཅི་ནས་ཀྱང་དེ་སྐྱེངས་པར་མི་འགྱུར་བ་དང་།",
    "བྲིད་པ་དེ་ཡང་དེས་སྔར་མ་རྟོགས་ཏེ་ཕྱིས་རྟོགས་པར་གྱུར་ན་ཡང་།",
    "འབྲིད་པའི་གང་ཟག་དེ་ལ་གཞི་དེས་གླེང་བའམ་དྲན་པར་མི་བྱེད་ལ་དེའི་སྒྱུ་ཐབས་ཀྱིས་མ་བྱིན་པར་ལེན་པ་དེ་དག་ཐམས་ཅད་ལ་ཡང་བསམ་པས་རྗེས་སུ་ད་གའ་བར་བྱེད་དེ།",
    "སེར་སྣ་ཅན་རྣམས་ཀྱང་སྦྱིན་པར་བྱེད་བྱ་འདོད་པར་གྱུར་༡ན།",
    "སྦྱིན་པ་དེ་ཡང་སློང་བ་རྣམས་ལ་ལེགས་པར་སྦྱིན་པར་བྱེད་ད་དོ།",
    "ཉེས་པར་༤བྱིན་པ་གང་ཡིན་པ་དེ་མེད་པར་འགྱུར།",
    "མི་བདོག་བཞིན་དུ་ཤེས་རབ་ཅན་གྱིས་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་ཡིན་ན་ནོ།",
    "གླེགས་བམ་དུ་བྱས་པའང་སྦྱིན་པར་མི་བྱེད་དོ།",
    "ཆགས་པའི་རང་བཞིན་ཅན་གླེགས་བམ་འཚོང་བར་འདོད་པའམ་སྦེད་༦པར་འདོད་པའ་མ།",
    "དེ་ཤེས་པས་དོན་དུ་གཉེར་བ་མ་ཡིན་པ་ལ་ཡང་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "ཤེས་པར་༧འདོད་པ་ལ་ནི་གལ་ཏེ་གླེགས་བམ་བདག་ལ་དགོས་པའི་དོན་བྱས་ཟིན་ན་དེ་ལ་ཅི་བདེར་སྦྱིན་པར་བྱེད་ད་དོ།",
    "ཡང་ན་གཞན་བྲིས་ཏེ་སྦྱིན་པར་བྱེད་དོ།",
    "པ་ཁོ་ན་༤མ་ཡིན་གྲང་སྙམ་དུ་བརྟག་པར་བྱའོ།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ར་རམ།",
    "འགྱོད་པར་ཡང་མི་འགྱུར།",
    "གལ་ཏེ་འོས་པ་མ་ཡིན་པར་མཐོང་ན་ནི་དེས་རྟོག་པ་དེ་ཉིད་ལ་བརྟེན་ནས་བཞིན་བཟངས་དག་འདི་༢ནི་གཞན་གྱི་ཡིན་ཏེ།",
    "ཁྱེད་ལ་སྦྱིན་པར་གནང་བ་མེད་དོ་ཞེས་དེ་ལ་ཚིག་འཇམ་པོས་གོ་བར་བྱེད་དོ།",
    "ཡང་ན་གཞན་དེའི་ཉིས་འགྱུར་རམ་སུམ་འགྱུར་སྦྱིན་ཞིང་རིམ་གྲོ་དང་བཀུར་སྟིར་བྱས་ནས་གཏོང་བར་བྱེད་ད་དེ།",
    "བདག་ཅག་ལ་སྦྱིན་པར་༐",
    "དེའི་ཕྱིར་སྦྱིན་པར་མི་བྱེད་དོ་སྙམ་དུ་ཤེས་པར་བྱེད་ད་དེ།",
    "ཤེས་རབ་ཅན་གྱི་སྦྱིན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་ནས་སྦྱིན་པར་བྱེད་ད་དེ།",
    "དེ་ཉེས་པ་འདི་ནི་བདག་མ་གོམས་པས་ལན་ནོ་སྙམ་དུ་མྱུར་བ་མྱུར་བར་ཤེས་རབ་ཀྱིས་རྟོགས་པར་འགྱུར་ཞིང་།",
    "དེས་ན་བད་ག་དེ་ལྟར་ལོངས་སྤྱོད་རྣམས་ཀྱང་ཡོད་ལ་སློང་བ་པོ་ཡང་ལེགས་པར་འོངས་བཞིན་དུ་སྦྱིན་པ་ལ་སེམས་མི་འཇུག་གོ་། གལ་ཏེ་དེ་ལྟར་སོ་སོར་བརྟགས་ནས་སྦྱིན་པ་མ་བྱས་ན་ཕྱི་མ་ལ་ཡང་བདག་༡སྦྱིན་པ་ལ་ཞེ་སྡང་བར་འགྱུར་རོ་སྙམ་དུ་རྟོགས་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཚེ་འདིའི་སྡུག་བསྔལ་གཞན་ལ་ཕན་འདོགས་པའི་རྒྱུ་སྦྱིན་པ་ལས་བྱུང་བ་༢དེས་བདག་འཆི་ཞིང་དུས་བྱེད་པར་གྱུར་༤དུ་ཟིན་ཀྱང་།",
    "བད་ག་ལ་༢སྦྱིན་པ་ཁོ་ན་ལེགས་པར་འགྱུར་གྱི།",
    "གཞན་ཡང་སློང་བ་པོ་ལེགས་པར་འོངས་པ་ན།",
    "དེ་སྤངས་ཏེ་སོ་སོར་བརྟགས་༨ནས་དངོས་པོ་དེ་སྦྱིན་པར་བྱེད་ད་དོ།",
    "སྦྱིན་པ་ལ་གེགས་བྱེད་པའི་གཉེན་པོ་རྣམ་པ་བཞི་ཤེས་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "སོ་སོར་ཡང་དག་པར་རིག་པ་ལ་ཏྲ་བརྟེན་པ་ད་ང་།",
    "ལྷག་པའི་བསམ་པ་རྣམ་པར་དག་པའི་སྦྱིན་པ་ལ་བརྟེན་པ་དང་།",
    "འདི་མན་ཆད་ད་ཀའ་བའི་སྦྱིན་པ་ལ་སོགས་པ་གཞན་ཐམས་ཅད་ནི་ཐམས་ཅད་ཀྱང་སྦྱིན་པ་འདི་ཉིད་ཀྱི་བར་ཏུ་དབྱེ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་འམ།",
    "དུས་ལ་བབ་པ་དང་གཞན་ལ་མི་གནོད་པར་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་གང་ཡིན་པ་འདི་ནི།",
    "མི་བརྟེན་པར་སྦྱིན་པ་དང་།",
    "རྒྱུན་མི་འཆད་པར་སྦྱིན་པ་ད་ང་།",
    "སྣོད་སྤྱད་རྣམ་པ་སྣ་ཚོགས་འདོད་པ་རྣམས་ལ་ནི་སྣོད་སྤྱད་རྣམ་པ་སྣ་ཚོགས་སྦྱིན་བྱ་པར་བྱེད་པ་དང་།",
    "སྣང་བས་ཕོངས་ཤིང་འདོད་པ་རྣམས་ལ་ནི་སྣང་བ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "གཙང་མ་དང་།",
    "རུང་བ་༢སྦྱིན་པར་བྱེད་པའོ།",
    "ཆུ་ལ་སོགས་པའི་འཇིགས་པ་ལས་ཡོངས་སུ་སྐྱོབ་༦པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ནི་རྣམ་པ་བཅུར་རིག་པར་བྱ་སྟེ། ༐",
    "རྣམ་པར་སྨིན་པ་ལ་མི་ལྟ་བའོ།",
    "མི་སྐྱོ་བར་༢ལ་གོར་དུ་སྐྱེན་པར་སྦྱིན་པར་བྱེད་ད་དེ།",
    "སྐྱེན་དུ་བྱེད་པ་དེ་ལྟ་བུར་ནི་སློང་བ་པོ་རྙེད་པ་ལས་བརྩམས་ཏེ་དེ་ལྟར་སྐྱེན་པར་མི་བྱེད་དོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་དག་པར་འགྱུར་རོ་ཞེས་ལྟ་བས་མཆོག་ཏུ་འཛིན་པར་མི་བྱེད་ད་དོ།",
    "ཕྱིས་ཅིག་ཅར་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡང་མཚུང་ས་ལ་སློང་བ་པོ་སྔ་ཕྱི་དང་།",
    "ལོངས་སྤྱོད་ཇི་ལྟར་བྱུང་བ་བཞིན་དུ་སྦྱིན་པ་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པར་མཐོང་ང་ངོ།",
    "མི་བཟོད་པ་དང་ཡིད་མ་ཆེས་པ་བསྐྱེད་པའི་འོག་ཏུ་མ་བསླངས་པར་ཡང་ཁ་ཅིག་ལ་བསྩགས་༢པའི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པའི་ཕྱིར་ཏེ།",
    "གཞན་ལ་འགྲན་པའི་ཕྱིར་ཡང་སྦྱིན་པར་མི་བྱེད་ད་དོ།",
    "ལོ་མ་སྐམ་པོ་ལྟ་བུ་ཡིན་པར་འཛིན་པ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "རྣམ་པར་སྨིན་པ་ལ་མི་ལྟ་བའི་སྦྱིན་པ་གང་ཞེ་ན།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཐམས་ཅད་མཁྱེན་པ་དང་མཐུན་པའི་རྣམ་པར་སྨིན་པ་སྐྱེ་དགུ་རྣམ་༢ལ་ཕན་པ་ད་ང་བདེ་བ་བགྱིད་པ་༢བསྟན་ལགས་སོ།",
    "སྦྱིན་པའི་༤རྣམ་པར་སྨིན་པ་འཆབ་མི་འཚལ་བ་ལགས།",
    "དྲང་སྲོང་ཆེན་པོ་གཞན་ཡང་སྦྱིན་པ་ལྔ་ཡོངས་སུ་རྫོགས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་སྦྱིན་པ་ཡོངས་སུ་དག་པ་གང་ལགས།",
    "གཞན་ཡང་སྦྱིན་པ་བླ་ན་མེད་པར་ལྟ་བ་ལྔ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ད་ང་།",
    "རྣམ་པར་གྲོལ་བ་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བ་ཕུན་སུམ་ཚོགས་པ་ལ་སྦྱིན་པ་བྱིན་ན་སྦྱིན་པ་ཆེན་པོ་ཡིན་ནོ།",
    "མི་བདོག་པ་དེའི་བསམ་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ནི་སྦྱིན་པ་ཆེན་པོ་ཡིན་ཏེ།",
    "བྱིན་པར་གྱུར་ཅིག་སྙམ་དུ་བསམས་༦ནས་སྦྱིན་བྱིན་ལ།",
    "སྦྱིན་པ་བྱིན་ནས་དངོས་ལ་གནས་པར་བྱེད་པ་མེད།",
    "ཆུང་ངུ་བཏང་ལ་མང་པོ་དཔག་ཏུ་མེད་པར་འགྱུར།",
    "སྤྱོད་ཚེ་ལོངས་སྤྱོད་མཐའ་ཡས་རྒྱས་པ་ཐོབ་པར་འགྱུར།",
    "ཅེས་གསུངས་སོ།",
    "མཁས་པ་ད་ག་རྣམ་པ་སུམ་ཅུ་རྩ་བདུན་གྱིས་སྦྱིན་པ་སྦྱིན་པར་བྱེད་ད་དོ།",
    "དེ་བཞིན་གཤེགས་པས་རྗེས་སུ་གནང་བའི་༤སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "དངོས་པོ་གསུམ་ཡོངས་སུ་དག་པར་༥རུང་བའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གཏོང་བ་ལ་ལོངས་སྤྱོད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་བ་རྟག་ཏུ་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "གཟུགས་བཟང་བ་ཡང་ད་ག་པར་འགྲུབ་པ་ཁ་དོག་ཕུན་སུམ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "གྲགས་པ་ཕུན་སུམ་ཚོགས་པ་ཡང་དག་པར་༡འགྲུབ་པ་དྲི་ཕུན་སུམ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་རོ་བྲོ་བའི་མཆོག་མཁྱེན་པའི་དཔེ་བྱད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་རོ་ཕུན་སུམ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "ཆེ་བའི་༢རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་རྒྱ་ཆེ་བའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གྱ་ནོམ་པའི་ལོངས་སྤྱོད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་གྱ་ནོམ་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་བཀྲེས་པ་ད་ང་སྐོམ་པ་སེལ་བའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བཟའ་བའི་སྦྱིན་པ་སྦྱིན་པ་ད་ང་།",
    "རྣམ་པར་སྨིན་པ་སྲིད་པ་ཐམས་ཅད་དུ་སྐོམ་པ་སེལ་བའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་སྐོམ་གྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གྱ་ནོམ་པའི་གོས་ཀྱི་རྙེད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་གོས་ཀྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་རིགས་མཐོན་པོའི་རིགས་དང་ལྡན་པའི་རྙེད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་མལ་ད་ང་སྟན་གྱི་སྦྱིན་པ་སྦྱིན་པ་ད་ང་།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞིའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བཞོན་པའི་སྦྱིན་པ་སྦྱིན་པ་ད་ང་།",
    "རྣམ་པར་སྨིན་པ་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་ད་ང་།",
    "དཔེ་བྱད་བརྒྱད་ཅུའི་རྙེད་པ་ཏྲ་ཡང་དག་པར་འགྲུབ་པ་ཁྲུས་ཀྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "གནོད་སེམས་སྤངས་པའི་རྙེད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་བྱམས་པ་ལ་བརྟེན་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "མི་དགའ་བ་སྤངས་པའི་རྙེད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་ད་གའ་བ་ལ་བརྟེན་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་རྗེས་སུ་ཆགས་པ་དང་ཁོང་ཁྲོ་བ་སྤངས་པའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བཏང་སྙོམས་ལ་བརྟེན་པའི་སྦྱིན་པ་སྦྱིན་པ་ད་ང་།",
    "རྣམ་པར་སྨིན་པ་འགྲོ་བ་ཀུན་དུ་ལུས་དྲི་ཞིམ་པའི་རྙིད་པ་ཡང་དག་པར་འགྲུབ་པ་བདུག་སྤོས་སྣ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གྱ་ནོམ་པའི་དྲིའི་ལུས་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་དྲིའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་འགྲོ་བ་ཐམས་ཅད་དུ་ད་བང་བསྐུར་བའི་རྒྱལ་སྲིད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་ད་ར་ད་ང་།",
    "རྣམ་པར་སྨིན་པ་ལྷའི་མིག་དང་རྫུ་འཕྲུལ་གྱི་རྙེད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་མར་མེའི་སྦྱིན་པ་སྦྱིན་པ་ད་ང་།",
    "རྣམ་པར་སྨིན་པ་དབྱངས་སྙན་པའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་དྲིལ་བུའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་བཟའ་བ་སྣ་ཚོགས་པའི་རྙེད་པ་ཡང་ད་ག་པར་འགྲུབ་པ་སྣ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "འཇིགས་པའི་སྦྱིན་པ་ད་ག་ལས་བཟློག་པར་འགྱུར་ར་རོ།",
    "ཤཱ་རིའི་བུ་འདི་ལ་མཁས་པས་སྨད་པའི་སྦྱིན་པ་གང་ཡིན་པ་དེ་དག་ལ་ཐམས་ཅད་ཀྱི་༡ཐམས་ཅད་དུ་མི་སྤྱོད་ཅིང་ལྷག་པར་མི་སྤྱོད་དེ།",
    "ཇི་ལྟར་སྦྱིན་པ་སྦྱིན་པར་བྱ་ཞེ་ན།",
    "ཇི་ལྟར་སྔར་བསྟན་པ་བཞིན་དུའོ་ཞེས་གསུངས་ས་སོ་༐།",
    "མ་དད་པར་སྦྱིན་པ་མེད་ད་དོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་སུ་མ་བསྔོས་པའི་སྦྱིན་པ་མེད་དོ།",
    "དུས་ལ་མ་བབ་པར་སྦྱིན་པ་མེད་ད་དོ།",
    "དྲང་སྲོང་ཆེན་པོ་སྦྱིན་པའི་རྣམ་པར་སྨིན་པ་དང་།",
    "སྦྱིན་པའི་རྣམ་པར་དབྱེ་བ་དང་།",
    "ནོར་རྣམས་རྣམ་པར་གཏོང་བར་བྱེད་ན།",
    "དྲང་སྲོང་ཆེན་པོ་རྣམ་པ་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་སྦྱིན་པ་ཡོངས་སུ་མ་ད་ག་པར་བལྟའོ།",
    "དྲང་སྲོང་ཆེན་པོ་གཞན་ཡང་ཕན་གདགས་པའི་ལན་དུ་ཕན་འདོགས་པར་བྱ་བའི་ཕྱིར་སྦྱིན་པ་བྱིན་ན་དེ་ཡང་ཡོངས་སུ་མ་དག་པ་ཡིན་ན་ནོ།",
    "དེས་བདག་ཡོང་ས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རྒྱལ་པོ་ལ་སྦྱིན་པ་སྦྱིན་ན་༢དེ་ཡང་ཡོངས་སུ་མ་དག་པ་ཡིན་ན་ནོ།",
    "ཚིག་པ་ཟ་བར་བྱས་ནས་སྦྱིན་པ་སྦྱིན་ན།",
    "གང་ཡང་སྦྱིན་པ་བྱིན་ན་འདིའི་རྣམ་པར་སྨིན་པ་ཡོད་ད་མ་མེད་ཅེས་ཐེ་ཚོམ་ཟ་ན།",
    "གང་ཡང་སྦྱིན་པ་བྱིན་ནས་གང་བད་ག་ལས་ཁྱེར་བ་ཐམས་ཅད་ཀྱིས་༢ཚེ་ཕྱི་མ་ལ་སླར་སྦྱིན་པར་འགྱུར་རོ་སྙམ་དུ་འདི་ལྟ་བུའི་སེམས་བསྐྱེད་ན།",
    "བདག་སྦྱིན་བདག་ཏུ་གྲགས་པར་འགྱུར་རོ་སྙམ་སྟེ།",
    "གང་ཡང་ཚེ་འདི་ལ་སྦྱིན་༧པས་འཇིག་རྟེན་ཕ་རོལ་དུ་རྙེད་པར་འགྱུར་རོ་སྙམ་པའི་སེམས་ཀྱིས་༨སྦྱིན་པ་བྱིན་ན།",
    "དྲང་སྲོང་ཆེན་པོ་རྣམ་པ་སུམ་ཅུ་རྩ་གཉིས་པོ་འདི་དག་ནི་སྦྱིན་པ་བྱིན་པ་ཡོངས་སུ་དག་པ་མ་ཡིན་པར་བལྟའོ།",
    "གདོན་མི་ཟ་བར་མྱུ་གུ་སྐྱེ་ནུས་པར་འགྱུར་ཏེ།",
    "སེར་སྣའི་དྲི་མ་བསལ་ཞིང་གཏོང་བའི་སེམས་ཀྱིས་ལེགས་པར་བྱིན་གྱིས་བརླབས་པ་དེའི་སེམས་བདོག་པ་ཐམས་ཅད་ཡོངས་སུ་གཏོང་བ་ལ་གནས་པར་འགྱུར་རོ།",
    "དེ་༧སྦྱིན་པ་སྦྱིན་པ་ན་ཐ་དད་པ་བཞི་བྱེད་པར་མི་འགྱུར་ཏེ།",
    "ཡོངས་སུ་བསྔོ་བ་ཐ་དད་པར་མི་བྱེད་པ་དང་།",
    "བསམ་པ་ཐ་དད་པར་མི་བྱེད་པའོ།",
    "འདི་ལ་སྦྱིན་པར་བྱའོ།",
    "འདི་ལ་སྦྱིན་པར་མི་བྱའོ།",
    "འདི་ལ་མང་དུ་སྦྱིན་པར་བྱའོ།",
    "འདི་ལ་ཉུང་ངུ་སྦྱིན་པར་བྱའོ།",
    "འདི་ལ་གྱ་ནོམ་པ་༩སྦྱིན་པར་བྱའོ།",
