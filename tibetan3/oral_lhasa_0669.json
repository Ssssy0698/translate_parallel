    "རང་དང་གཞན་ལགནས་པའི་སྨིན་པར་བྱེད་པ་དང་།",
    "གྲོལབར་བྱེད་པའི་ནི་ཡང་དག་པར་ཕྲད་པར་བྱེད་པའི་བཞི་བའིརྣམ་པའོ།",
    "གལ་ཏེ་ཀུན་མཁྱེན་གསུམ་ཀ་ལ་ཡང་ངེས་འབྱེད་ཀྱིཆ་དང་མཐུན་པ་བྲྗོད་ཟིན་པ་མ་ཡིན་ནམ།",
    "ཀུན་མཁྱེན་གསུམ་དུ་བྲྗོད་པའི་ངེསཔར་འབྱེད་པའི་ཆ་དང་མཐུན་པའིསྟོབས་ཀྱིས།",
    "འདིར་ཡང་ནི་མཡིན་ཏེ་ཀུན་མཁྱེན་གསུམ་དང་འབྲེལ་བའི་ངེས་འབྱེད་ཀྱི་ཆདང་མཐུན་པ་ཐོབ་པ་ནི་དེ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པའིཕྱིར་དང་།",
    "ཁྱད་པར་གྱི་ལམ་ལ་དེའི་བྱེད་པ་མེད་པའི་ཕྱིརརོ།",
    "ཁྱད་པརཐམས་ཅད་མེད་པའི་ཕྱིར་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱིཕྱིར་ཀུན་མཁྱེན་གསུམ་གྱི་རྣམ་པ་རྣམས་ཁྱད་པར་ཁོ་ནར་ཉེབར་བཀོདདོ།",
    "དེ་ཡང་དམིགསཔ་དང་རྣམ་པའི་ཁྱད་པར་རྟོགས་ན་བདེ་བླག་ཏུ་རྟོགས་པའིཕྱིར་དེ་གཉིས་བྲྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "བདག་ཉིད་སོ་སོ་ལ་ངེསཔ་ཁོ་ན་ཡིན་པ་དེས་ན་དེ་ལ་བརྟེན་བ་ཁོ་ནར་རྟོགས་པརབྱའོ།",
    "ཡུལརྣམས་བྲྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "སྐུར་བའི་མཐའ་དང་བྲལ་བའི་ཟབཔའི་ཁྱད་པར་དང་ལྡན་པ།",
    "བསམ་པ་ལ་སོགས་པའི་ཤེས་པ་ནི་ཁྱད་པར་ཅན་ཡིན་ནོཞེས་བྱ་བའོ།",
    "བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་པའི་རང་བཞིན་དུ་ཐ་དད་པ་མེདཀྱང་ས་དགུ་ལ་བརྟེན་པའི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་རྣམ་པརརྟོག་པའི་དབྱེ་བས་རྣམ་པ་དགུ་ཉིད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱལ་བའི་ཡུམ་དང་དེ་ལསཞེས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་རངབཞིན་གཅིག་ལ་ཐ་དད་པ་མི་འདོད་པའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་སོ།",
    "ལམ་གྱི་བྱེད་པ་མེད་པར་བྲྗོད་ན།",
    "སྒྲོ་བཏགས་པ་རྣམ་པར་བཅད་ལ།",
    "དེཁོ་ནའི་རང་བཞིན་ཅན་གྱི་བྱེད་པ་རྣམ་པར་འཇིག་མི་ནུས་པའིཕྱིར་རོ།",
    "རང་བཞིན་ལ་ཡང་ཉེ་བར་བསྟན་པའི་རྣམ་པར་རྟོག་པ་གཉིསའཇུག་པ་ན།",
    "གང་ཡང་རུང་བར་གནས་པའི་ཕྱིར་དང་གཅིག་ལ་འདོདཔ་སྒྲུབ་པར་བྱེད་ན།",
    "གཞན་ལ་བཏགས་པའི་ངོ་བོ་དགག་པར་མི་ནུསཔའི་ཕྱིར་རོ།",
    "ཡང་དག་པའི་ཀུན་རྫོབ་ལ་བརྟེན་པའི་རྒྱུ་དངའབྲས་བུའི་དངོས་པོ་འདི་ནི་རང་ཉིད་ཀྱིས་ཊཱི་ཀཱར་རྒྱས་པརབསྒྲུབཔའི་ཕྱིར་ན་འདིར་མི་སྤྲོའོ།",
    "ཁྱད་པར་གྱི་ལམ་རྟོགས་པའི་མཐུས།",
    "དེའི་རྟེན་གྱི་ཐ་སྙདབྲྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "སྒྲོ་འདོགས་ཀྱི་རྣམ་པར་རྟོགཔ་ལོག་པ་མཉམ་པ་ཉིད་དེ་བཞིན་ཉིད་ཅེས་བྱ་བའི་མིང་ཙམ་དུཤེས་པར་བྱའོ།",
    "གཉིས་པ་ཡང་སྒྲུབ་པར་བྱེད་པདང་གནོད་པར་བྱེད་པ་དེ་ལ་བརྟེན་པའི་ཐ་སྙད་ཀྱི་ཡུལ་ཅན་མིདམིགས་པ་ན།",
    "བཅུ་པ་གཟུགས་ཀྱི་སྐུའི་ཆེད་དུ་བྱབའི་མཚན་ཉིད་ཞིང་རྣམ་པར་དག་པ་བྲྗོད་པ་ནི་གཉི་ག་དངམཉམ་པ་ཉིད་དུ་ཞེས་བྱ་བ་སྟེ་རྟོགས་སླའོ།",
    "ཀུན་མཁྱེན་གསུམ་གྱིས་བསྡུས་པསརྫོགས་པ་ཡིན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པདང་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་སྒྲུབ་པར་བྱེད་པ་ཉིདཀྱིས་ན་ཐབས་ལ་མཁས་པ་ནི་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་དུ་གཞནགྱི་དོན་གྱི་རབ་ཏུ་དབྱེ་བ་དང་།",
    "རྣམ་པ་དེ་རྣམས་སུ་ཡུལདུ་བྱས་ཏེ་སྐྱེད་པ་དང་།",
    "དེའི་དུས་ན་ཡངངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ལ་སོགས་པའི་མིང་ཅན།",
    "ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོའི་དབྱེ་བས་ཐ་དད་པའི་ཁྱདཔར་གྱི་ལམ་ཡོངས་སུ་དག་པ་ནི།",
    "ཡུལ་དག་བྲྗོད་པར་བྱ་བཡིན་པའི་ཕྱིར།",
    "འཛིན་པའི་རྣམ་པར་རྟོག་པ་སོསོར་འཇུག་པ་དང་ལྡོག་པའི་རྟེན་ཅན་ཉིད་ཀྱི་གཞིར་གྱུར་པ་དགལ་སོ་སོར་དབྱེ་བ་རྣམ་པ་དགུ་སྟོན་པ་ནི།",
    "ངེས་པར་འབྱེད་པའིཆ་དང་།",
    "གཟུང་བའིརྣམ་པར་རྟོག་པ་དང་པོ་ཞེས་བྱ་བའོ།",
    "གཟུང་བདང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་གཉིས་ཀྱིས་སྲིད་པ་དང་།",
    "དེ་དག་ལྷག་མ་མེད་པར་སྤང་བར་བྱ་བ་ཡིན་ནོཞེས་བྱ་བའོ།",
    "རབ་ཏུ་དབྱེ་བ་གཉིས་བྲྗོད་པར་བྱ་བ་ལས།",
    "སེང་གེ་ལྟ་བུར་རྣམ་པར་རོལ་པས་ན་དེདང་མཐུན་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་མི་དམིགསཔའི་སྦྱོར་བས་ལུགས་དང་མཐུན་པ་དང་།",
    "འདོདཔར་གཏོགས་པའི་ཞེས་བྱ་བའོ།",
    "འདོད་པ་ན་སྤྱོད་པ་མཉམ་པར་མ་བཞག་པའི་ཤེསཔ་མཚམས་སུ་བྱས་པའི་ཕྱིར།",
    "ཡུལ་གྱི་དབྱེ་བསསྔ་མ་བཞིན་དུ་རྟོགས་པར་བྱའོ།",
    "གཞན་ཡང་ལམ་གཉིས་ག་ཡངསོ་སོར་མི་མཐུན་པའི་ཕྱོགས་སུ་གྱུར་པའི་རྣམ་པར་རྟོག་པ་རྣམཔ་བཞི་བཤདཟིན་པའི་ཕྱིར་ན།",
    "སྔམ་བཞིན་དུ་ཞེས་བྱ་བ་སྟེ་རྟོགས་པར་སླའོ།",
    "སྤང་བྱ་རྣམས་བྲྗོད་པར་བྱ་བ་ལས།",
    "སངསརྒྱས་ཉིད་སྒྲུབ་པར་བྱེད་པ་ནི་མཚན་ཉིད་ཡིན་ཞེས་བྱ་བའོ།",
    "དེའི་དམིགས་པ་ལ་སོགས་པ་ཇི་ལྟ་བུ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པནི་དམིགས་པ་ལ་སོགས་པ་བྲྗོད་པ་སྟེ་རྟོགས་པར་སླའོ།",
    "ཁྱད་པར་གྱི་ལམ་ལ་གནས་པ་ལ།",
    "ཐོག་མ་མེད་པའི་དུས་ཙམ་གྱི་བག་ཆགས་ཀྱི་ས་བོན་ཅནགྱི་རྣམ་པར་རྟོག་པ་མི་མཐུན་པའིཕྱོགས་དུ་མ་སྐྱེས་པས་སྐྱེས་པ་ཉིད་ཀྱིས།",
    "དེ་ལྟ་ན་ཡང་དེ་དག་བརྟན་པར་གྱུར་པ་མ་ཡིན་ཏེ།",
