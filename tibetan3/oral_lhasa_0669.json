    "སྐྱེ་བོ་ཐམས་ཅད་བདེའོ་ཞེས་རབ་ཏུ་དགའ་བས་ཆེད་དུ་བརྗོད་པའི་དབྱངས་ཀྱིས་ཁྱབ་པར་བྱས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཝ་རཱ་ཎཱ་སིར་འབབ་ཆུ་གནོད་པ་ཅན་གྱི་འགྲམ་དུ་བཞུགས་པ་ན།",
    "སྐད་ཀྱང་སྐྱེ་བོས་མི་ཐོས་པར་བྱས་སོ།",
    "གྲགས་པ་སྒུག་པའི་ཕྱིར་ཞབས་འཆག་ཅིང་བཞུགས་སོ།",
    "སྟོན་པའི་སྤྱན་སྔར་འོངས་ཏེ་ཞབས་ལ་ཕྱག་བྱས།",
    "གྲགས་པ་སྟན་དེ་ལ་འཁོད་བཞིན་པ་རྒྱན་དང་བཅས་བཞིན་པར་དགྲ་བཅོམ་པ་ཐོབ་བོ།",
    "དེ་ནས་སྟོན་པས་གྲགས་པ་དགྲ་བཅོམ་པ་ཐོབ་པས་ཁྱིམ་དུ་གནས་པའི་སྐབས་མེད་པར་ཁྱིམ་བདག་ལ་བརྡའ་སྤྲོད་པར་མཛད་པས།",
    "དེ་ཡང་དད་ཅིང་ནང་བར་ཁྱིམ་དུ་སྤྱན་འདྲེན་པའི་ཞུ་བ་བྱས་ཏེ་ཕྱིར་ལྡོག་གོ།",
    "དབེན་པར་བསྒོམས་པས་ཡུན་རིང་མ་ལོན་པར་དགྲ་བཅོམ་པ་ཐོབ་སྟེ།",
    "ཅན་བྲམ་ཟེའི་གཟུགས་སུ་སྤྲུལ་ནས་དཀྲུགས་མ་བྱས་པ་ཡང་མཚུགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ཤིང་དྲུང་ན་བཞུགས་པ་མཐོང་སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེར་གཤེགས་པར་རིག་ནས།",
    "བྲམ་ཟེ་དང་ཆུང་མ་གཉིས་གྲོས་བྱས་ཏེ།",
    "ཀརྵ་པ་ན་ལྔ་སྐྱིན་པར་བླང་ངོ།",
    "མཐུན་ནས་དེ་བཞིན་དུ་བྱས་ཤིང་།",
    "ཆུང་མ་ཡང་ཡིད་མི་བདེ་བཞིན་དུ་ཁྱིམ་གྱི་ཕྱག་དར་བྱས་པས་ས་འོག་ནས་གསེར་གྱི་བུམ་པ་གསེར་གྱིས་གང་བ་རྙེད་དེ།",
    "ལྟེངས་རྒྱས་འོད་སྲུངས་རལ་བ་ཅན་དེ་ལྟ་བུ་ཡིན་པར་དགོངས་སོ།",
    "སྐྱེ་བོ་རྣམས་ཀྱིས་དགྲ་བཅོམ་པར་བཀུར་ཞིང་།",
    "རང་ཉིད་ཀྱང་དགྲ་བཅོམ་པར་རློམ་པ་ཞིག་གོ།",
    "བཅོམ་ལྡན་འདས་གདན་བཤམས་པ་ལ་བཞུགས་ནས།",
    "དེ་ན་ཀླུ་གདུག་པ་ཞིག་གནས་པས་མཐོ་འཚམ་པར་འགྱུར་དུ་མི་འོང་ངམ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་མེ་ཁང་དུ་བྱོན་ནས་བཞུགས་པ་ན།",
    "བཅོམ་ལྡན་འདས་མེའི་ཁམས་ལ་སྙོམས་པར་ཞུགས་པས་ཁང་པ་ཐམས་ཅད་མེ་རབ་ཏུ་འབར་བར་གྱུར་ཏོ།",
    "མེ་བསད་པར་འདོད་ན་ཡང་བསད་མ་ཐུབ་བོ།",
    "ཡང་མེ་ཁང་ཐམས་ཅད་མེས་སྲེག་པར་མཐོང་སྟེ།",
    "སྐྱེ་བོའི་ཚོགས་མང་པོ་དང་བཅས་པས་མེ་གསོད་པར་མ་ནུས་པ་ལའང་དེ་དང་འདྲའོ།",
    "དེ་མཁྱེན་ཏེ་གཞན་ཞིག་ཏུ་གཤེགས་སོ།",
    "འོད་སྲུངས་བཟའ་བཅའ་དང་ཡོ་བྱད་ཀྱི་ཚོགས་མང་པོ་དང་བཅས་པར་གྱུར་པ་ན།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་འོད་སྲུངས་ཀྱི་བསྟི་གནས་ནགས་ཚང་ཚིང་ན་བཞུགས་སོ།",
    "འོད་སྲུངས་ཀྱི་གདུགས་ཚོད་ལ་འབྱོན་པར་ཞུས་ཏེ།",
    "དེ་ནས་སྤྱན་འདྲེན་པར་ཕྱིན་པ་ན།",
    "ལྷུང་བཟེད་བཀང་ནས་འོད་སྲུངས་ཀྱིས་བཤམས་པའི་སྟན་ལ་བཞུགས་སོ།",
    "སྔོན་མེད་པའི་བཀོད་མའི་ཆུ་འདི་ཅི་ཞེས་ཞུས་པས་དེའི་ཚུལ་གསུངས་སོ།",
    "དེའི་འགྲམ་ན་ཤིང་ཨ་རྫུ་ན་དྲང་པོར་སྐྱེས་པ་ཞིག་ཡོད་པ་ལ་རྫིང་ནས་བཞེངས་པར་བཞེད་པའི་ཚེ།",
    "ནའི་ཡལ་ག་སྔོན་མ་དུད་པ་ལས་དུད་པར་མཐོང་ནས།",
    "ཡང་དེ་འགྲེམས་པའི་གཞི་དགོས་པར་བྱུང་ནས།",
    "དགེ་སྦྱོང་ཆེན་པོ་ལ་ཆུས་གནོད་པར་མ་གྱུར་ཏམ་སྙམ་སྟེ།",
    "དེ་ནས་གྲུའི་ནང་དུ་ཕེབས་ཤིང་ཇི་ལྟར་གྲུ་ལ་ཞུགས་པ་དེ་བཞིན་དུ་ཆུའི་སྟེང་ནས་ཀྱང་གཤེགས།",
    "ཁོ་བོ་ནི་དགེ་སྦྱོང་ཆེན་པོའི་དྲུང་དུ་ཚངས་པར་སྤྱོད་ན།",
    "དགྲ་བཅོམ་པར་བཀུར་བ་འདི་ཡང་ལན་གཉིས་ཀྱི་བར་དུ་དགེ་སྦྱོང་ཆེན་པོའི་སྤྱན་སྔར་རབ་ཏུ་བྱུང་བར་ཁས་བླངས་ནབ།",
    "ལྟེང་རྒྱས་སུ་ཇི་ཙམ་བཞེད་པར་བཞུགས་ནས།",
    "ག་ཡ་མགོའི་མཆོད་རྟེན་གྱི་རི་ལ་བཞུགས་ནས།",
    "ཆོ་འཕྲུལ་རྣམ་པར་འཕྲུལ་པ་དུ་མ་ཡང་མཛད་དེ།",
    "དེ་ལས་བབ་པ་ཡང་དག་པར་ལེགས་པ་ལ་སྨོན་པའོ།",
    "ག་ཡའི་རི་ལ་བཅོམ་ལྡན་འདས་ཉིད་དགྲ་བཅོམ་པ་སྟོང་དང་ཐབས་ཅིག་བཞུགས་ཤིང་།",
    "ཆོ་འཕྲུལ་རྣམ་པར་འཕྲུལ་པ་སྟོན་པའི་གཟི་བྱིན་མཐོང་ནས།",
    "དེས་བློར་མ་ཆུད་ཅིང་ལོག་པར་སེམས་པས།",
    "དེ་ནས་རྒྱལ་པོ་གནས་ལྔ་ལ་ལྷག་པར་རྩེ་གཅིག་ཏུ་སྨོན་ཅིང་སེམས་པར་གྱུར་ལ།",
    "རྒྱལ་པོའི་ཡིད་དུ་ཆེས་འཐད་པར་གྱུར་ཏེ།",
    "རྒྱལ་པོས་ནང་མི་ཞིག་ལ་སྤྱན་འདྲེན་པར་བཀའ་བསྒོས་ནས།",
    "སྟོན་པ་ཀྱང་ཅང་མི་གསུང་བར་གནང་ངོ།",
    "ཡང་སྔར་བཞིན་དོགས་པ་སྐྱེས་ཏེ་བསྡད་པ་ན།",
    "ཅི་དགེ་སྦྱོང་ཆེན་པོ་འོད་སྲུང་ཀྱི་དྲུང་དུ་ཚངས་པར་སྤྱོད་དམ།",
    "འོད་སྲུངས་དགེ་སྦྱོང་ཆེན་པོའི་དྲུང་དུ་ཚངས་པར་སྤྱོད་པ་ཡིན་སྙམ་ཐེ་ཚོམ་དུ་གྱུར་པ་ལས།",
    "སྟོན་པས་དེ་མཁྱེན་ཏེ།",
    "བདག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཉན་ཐོས་ལགས་སོ།",
    "ལྟེང་རྒྱས་འོད་སྲུངས་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་ཕྱག་བྱས་ཏེ་སྟན་ལ་འཁོད་པ་ན།",
    "ཇི་ཙམ་ན་དུས་ལ་བབ་པར་མཁྱེན་ནས་བཅོམ་ལྡན་འདས་འཁོར་དང་བཅས་པ་ལྗོངས་རྒྱུ་ཞིང་།",
    "རྒྱལ་པོའི་ཁབ་ཀྱི་ཤིང་དྲུང་དང་ཉེ་བར་བྱོན་པར།",
    "རྒྱལ་པོས་གདུགས་ཚོད་ལ་སྤྱན་འདྲེན་པར་སྙམ་གནན་ནས།",
    "སྟོན་པ་བཞུགས་པའི་གནས་གཙུག་ལག་ཁང་དུ་བྱས་ཏེ་ཕུལ།",
    "བཅོམ་ལྡན་འདས་དེ་ད་ལྟར་གང་དུ་བཞུགས།",
    "དེ་ནས་ཀུན་དུ་རྒྱུ་གཉིས་ཀྱིས་འཁོར་རྣམས་ལ་རིག་པར་བྱས་ཏེ།",
    "ཀུན་དུ་རྒྱུ་གཉིས་པོ་བྱས་ཏེ།",
    "འཕགས་པ་རྟ་ཐུལ་ཤིང་དྲུང་ན་བཞུགས་པ་མཐོང་སྟེ།",
    "དང་པོར་རྟ་ཐུལ་གྱི་ཞབས་ལ་ཕྱག་བྱས་སོ།",
