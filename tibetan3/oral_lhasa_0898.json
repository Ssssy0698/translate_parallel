    "དེ་ལྟར་སྲོག་ཡོངས་སུ་གཏོང་བ་ལ་མི་ལྟ་ཞིང་བྱམས་པར་བྱེད་པ་དེའི་བྱམས་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟེ།",
    "རུས་གོང་ལ་ནི་བརྟེནབྱས་ནས།",
    "ལྷག་པར་གཟུགས་མི་སྡུག་པའི་ཆ་བྱད་འཛིན་པར་གྱུར་པའི་མི་རྣམསའ་མ་ལ་འགྲོ་ཞིང་བ་དེ་ལྟར་བརྗོད་དོ།",
    "འདི་ཡི་འཇིག་རྟེན་རྣམས་འཇིག་པར་འགྱུར་རོ།",
    "ཚངས་པོ་འཇིག་རྟེན་གྱི་བར་དུ་འཇིག་རྟེན་འཇིག་པར་འགྱུར་རོ་ཞེས་བརྗོད་དོ།",
    "ཐམས་ཅདམཁྱེན་པ་དོན་དུ་གཉེར་བའི་ཕྱིར་རྫོགས་པར་བྱེད་དོ།",
    "སེམས་དཔའ་ཆེན་པོ་ལ་གནང་བ་མ་བྱིན་ཏེ།",
    "གཞན་ཡང་བསྐལ་པ་འབུམ་ཕྲག་གཅིག་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྫོགས་པར་བྱས་ནས་འ་ཁྲུང་ངོ།",
    "༡ ཁྱེད་རྣམས་གཤེགས་པར་ཞུ་ཞེསལྷ་དེ་རྣམས་བཏང་ནས་དགའ་ལྡན་གྱི་ལྷ་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཏེ།",
    "དེ་དེ་ལྟར་ལྷ་རྣམས་ཀྱིས་དམིག་བ་རྗེས་སུ་དྲན་པ་རྣམས་འཁོར་དུ་བྱས་ཤིང་དེར་རྒྱུའོ།",
    "མིའི་དྲི་མ་བསལ་བའི་ཕྱིར་ཁྲུས་བྱས་ཏེ།",
    "དེ་ལ་བཞུགས་པའི་བྲམ་ཟེ་རྣམས་ལ་མར་གསར་དང་།",
    "རྒྱལ་པོ་ཆེན་པོ་འཇིགས་པར་མ་བྱེད་ཅིག།",
    "ཡང་དག་པར་སྒྲ་སྒྲོགས་སོ།",
    "གོང་པོ་རྣམས་ཀྱིས་འགྲོ་ཤེས་པར་གྱུར་ཏོ།",
    "དུད་ཁ་གྲོ་རྣམས་ཕན་ཚུན་ལ་ཇིགས་པ་མེད་པར་གྱུར་ཏོ།",
    "རྟ་རྣམས་སྐད་སྙན་པའི་རྣམ་པར་གྱུར་ཏོ།",
    "ཕྱོགས་ཐམས་ཅད་རབ་ཏུདངས་པར་གྱུར་ཏོ།",
    "དུས་མ་ཡིན་པར་སྦྱིན་ལ།",
    "ཆུ་ཀླུང་རྣམས་འགྲོ་བ་མེད་པར་གནས་སོ།",
    "གནས་ཐམས་ཅད་ཉིད་དུ་ཁ་དོག་ལྔ་པོའི་ེཔདྨས་སའི་སྟེང་ཐམས་ཅད་ཁྱབ་པར་གྱུར་ཏོ།",
    "རྙེད་པ་དང་གྲགས་པ་ཐོབ་པར་གྱུར་ཏོ།",
    "རྒྱལ་པོས་ལེགས་སོ་ཞེས་བརྗོད་ནས་གནང་ངོ།",
    "དེས་ཤིང་སཱ་ལའི་ལག་བཟུང་པར་སེམས་པར་གྱུར་ཏེ།",
    "མའི་རུནས་མི་གཙང་བ་ཅུང་ཟད་ཀྱིས་ཀྱང་མ་གོས་པར་དགཅིང་འཇིགས་པ་མེ་ད་པ་བཞིན་ནོ།",
    "དོ་༤ཇིལྟར་ཡང་རུམ་དུ་ཞུགས་ཙམ་དང་བལྟམས་ཙམ་ན་སུམ་ཅུ་རྩ་གཉིས་སྔོན་གྱི་མཚན་མ་བཞིན་དུ་སྐྱེས་པར་གྱུར་ཏོ།",
    "ཞང་པོ་འ་དིས་བདག་ལ་དོན་མེད་ཅིང་དགོས་པ་མེད་དོ་ཞེས་བརྗོད་པར་བསམས་སོ།",
    "ཁ་ཟས་བཟང་པོ་ལ་ལོངས་སྤྱོད་ཅིང་བཀུར་སྟི་ཆེན་པོ་བྱས་ནས་མཚན་ཉིད་ཇི་ལྟ་བུ་ཞེས་དྲིས་སོ།",
    "འདི་ནི་ཁྱིམ་ན་གནས་པའི་མད་པས་མཐའ་གཅིག་ཉིད་དུ་ཁྱིམ་ན་མི་གནས་པར་སངས་རྒྱའོ།",
    "འདི་ནི་སྔར་གྱི་གཞི་བྱས་པས་ཕྱིས་མིར་གྱུར་པ་ནཤེས་རབ་དང་ལྡན་ནོ།",
    "བྲམ་ཟེ་བདུན་ལས་ལྷག་པར་གྱུར་ནས་། འདི་ཡི་མཚན་ཉིད་རིག་པར་ལྡན་ནས་ཁྱིམ་དུ་གནས་པའི་མདེ་ཡང་མད་དོ།",
    "གཞོན་ནུ་དོན་གྲུབ་རབ་ཏུ་བྱུང་ནས་ཐེ་ཙོམ་མད་པར་དེ་སངས་རྒྱ་བར་འགྱུར་རོ།",
    "དེ་ཐམས་ཅད་འདུན་པ་གཅིག་པར་མ་ནུས་པར་སྐྱོ་བོ་བཞི་པོ།",
    "རྒྱལ་པོ་འཛིན་པའི་ཞིང་རྨོ་བའི་ཐོང་པ་སླར་ཡང་གསེར་ལས་བྱས་པར་གྱུར་ཏོ།",
    "རྒྱལ་བོ་རྒྱན་ཐམས་ཅདཀྱིས་བརྒྱན་པར་བྱས་ནས་བློན་པོ་འཁོར་དང་བཅས་པ་ཞིང་རྨོ་བའི་གནས་སུ་གཤེགས་ཏེ།",
    "ངའི་གནས་ཕུན་སུམ་ཚོགས་པར་འགྱུར་རོ་ཞེས་བསམས་ནས།",
    "ནུམ་བསྣུན་པ་རྣམས་ཁ་ཟས་ཟ་བའི་ཕྱིར་ཕན་ཚུན་དུ་འགྲོ་ཞིང་དམ་ཐག་ཅུང་ཟད་ཐོས་པར་གྱུར་ཏོ།",
    "ལྷ་གཞོན་ནུ་འདི་ལྟ་བུའི་ཚུལ་གྱིས་བཞུགས་སོ།",
    "དེའི་དེ་བཞིན་དུ་ཕུན་སུམ་ཚོགས་པ་ཆེན་པོ་རྗེས་སུ་ཚུད་པར་བྱེད་དོ།",
    "འདི་ནས་ཞག་བདུན་བ་ལ་ཉེ་དུ་རྣམས་ལ་བཟོ་བསྟན་པར་བགྱིའོ།",
    "རྒྱལ་བོས་དེ་བཞིན་དུ་བྱས་སོ།",
    "སླར་ཡང་བཟློག་སྟེ་ཁང་བཟང་དུ་གཤེགས་ནས་རྒྱལ་པོས་དྲིས་བ་སྔར་བཞིན་དུ་བྱས་ནས།",
    "བའི་རྡོ་ལེབ་ཀྱི་སྟན་ལ་བཞུགས་སོ།",
    "རང་ལ་རྒྱན་གྱིས་བརྒྱན་པར་སེམས་སོ།",
    "དེའི་རིམ་གྲོ་པ་དང་མཚུངས་པར་གྱུར་ནས།",
    "ལྷའི་བུ་མིན་པར་ཤེས་སོ།",
    "དེ་ཡི་ཕ་ནི་ངེས་པར་ཞི།",
    "དེས་དོན་གྲུབ་གཞོན་ནུ་བདག་ལ་ཆགས་༧༡ ཤིང་ཞན་པར་གྱུར་པས་སེམས་རྟེན་བསྐུར་བ་ཡིན་པས།",
    "དེས་སེམས་བདེ་བ་སྐྱེས་པར་གྱུར་ཏོ།",
    "དེའི་རྒྱན་དུ་བྱས་བ་ནི་ཉེ་བར་ལྡན་པ་བརྒྱ་བྱིན་གྱི་ལོ་བྲང་དང་མཚུངས་པའི་ཁང་བཟངས་ཆེན་པོ་ཡངས་ཤིང་།",
    "རྣམ་པ་སྣ་ཚོགས་བའི་དྲི་ད་བས་གང་བའི་རོ་དང་ལྡན་པའི་དུར་ཁྲོད་དང་མཚུངས་པར་བསམས།",
    "བློན་པོ་མདུན་པ་ཐམ་པ་ལ་སྔས་བྱས་ནས་ཉལ་ལོ།",
    "གྲགས་འཛིན་མའི་གནག་སུ་གཤེགས་ཏེ་སྒོ་ཕྱེ་ནས་དེ་མ་ཐག་པར་ཉལ།",
    "དོན་གཉིས་། དན་བསྔགས་ལྡན་གྱི་རྒྱབ་ཏུ་བཞུགས་པ་ཉིད་དུ་བློན་པོ་འདུན་པས་རྗེས་ནས་བཟུང་བ་དང་ལྷན་ཅིག་ཉིད་དུ་བསྔགས་ལྡན་བར་བཙིར་ནས་ཁྲུ་བཅོ་བརྒྱད་པའི་ལྕགས་རིའི་མཐོ་ཚད་ལ།",
    "གལ་ཏེ་སྒོ་མ་ཕྱེད་པར་གྱུར་ན་ཇི་ལྟར་བསམས་པ་དེ་བཞིན་དུ་གསུམ་པོའི་ཞེན་གང་ཡང་རུང་བ་གཉེག་དེས་བདའ་ར་རོ།",
    "གླིང་ཕྲན་སྟོང་ཕྲག་གཉིས་ཀྱིས་ཡོངས་སུ་བསྐོར་བའི་གླིང་ཆེན་པོ་བཞིའི་རྒྱལ་སྲིད་བྱེད་པར་འགྱུར་རོ།",
    "གནོད་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་འམ།",
    "བསྔགས་ལྡན་བགྲོ་བའི་ལམ་ལ་མངོན་དུ་ཕྱོགས་བར་བྱས་ནས་བྱོན་ནོ།",
    "པར་གྱུར་ཏོ།",
    "རལ་པ་ལྟར་གདོན་པར་མི་ནུས་པར་ཤིན་ཏུ་ཐོགས་པར་གྱུར་ཏོ།",
