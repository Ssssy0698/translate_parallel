    "ཡངས་པ་ཅན་གྱི་ནགས་ཚལཆེན་བོ་ཁང་པ་བརྩིགས་པའི་གནས་སུ་བཞུགས་སོ།",
    "དེར་དེ་དང་དེའི་གནས་རྣམས་སུ་བཞུགས་ཤིང་དེ་དང་དེའི་གནས་ཉིད་ཐོབ་ཅེས་བརྗོད་དོ།",
    "ལྷགོན་ཏྲེ་དང་མཚུངས་པའི་ཆུང་མ་རྣམས་གཞན་གྱི་བྲན་གྱི་ཕྱིར་སྦྱིན་པར་བཏང་ངོ།",
    "བྱ་བ་འབུམ་ཕྲག་དུམ་ལ་སྙོམས་པར་ཞུགས་ནས་མཉམ་པར་གནས་ཏེ་ཞག་བདུན་དུ་དེ་ཉིད་དུ་བཞུགས་སོ།",
    "རྣམ་པར་གྲོལ་བ་དང་བདེ་བ་སོ་སོར་རིག་ཅིང་བཞུགས་སོ།",
    "གཞན་ཡང་ལྷ་གང་དང་གང་ཞིག་ད་དུང་ཡང་ངེས་པར་དོན་གྲུབ་ལ་བྱ་བ་ཡོད་དམ།",
    "རྣམ་པར་རྟོག་པ་ཡོངས་སུ་བསྐྱོད་དོ་ཞེས་བསམསཞས།",
    "སྟོན་པས་ལྷ་རྣམས་ཀྱི་རྣམ་པར་རྟོག་པ་མཁྱེན་ནས།",
    "དེ་རྣམས་ཀྱི་རྣམ་པར་རྟོགབ་ཉེ་བར་ཞི་བར་བྱ་བའི་ཕྱིར།",
    "བདེ་བས་སོ་སོར་རིག་པར་མཛད་ནས་བཞུགས་སོ།",
    "དེའི་ཕྱིར་བདག་འདི་དང་མཚུངས་པར་མ་གྱུར་ཏོ་སྙམ་ནས་རི་ཚོ་བཅུ་བྲིས་སོ།",
    "སྙོམས་པར་འཇུག་པའི་ཡེ་ཤེསདང་།",
    "ཇི་ལྟར་དེ་བླ་ན་མེད་པ་ཉེ་བར་སྐྱེ་བ་རྣམ་པར་གྲོལ་ལ།",
    "སྐྲ་དཀར་པོར་གྱུར་པར་བྱིན་གྱིས་བརླབས་སོ་ཞེས་ཟེར་རོ།",
    "དྲིའི་གཙང་ཁང་ཤིན་ཏུ་ཡངས་པར་བཞུགས་པ་བཞིནརྣམ་པར་གྲོལ་བ་དང་།",
    "དེར་ཡང་རྣམ་པར་གྲོལ་བ་དང་།",
    "བདེ་བ་སོ་སོར་རིག་པར་བྱེད་པ་ཉིད་ཀྱིས་བཞུགས་སོ།",
    "ཞལ་ཟས་གསོལ་བ་མེད་པར་གྱུར་ཏོ།",
    "སྟོན་པས་དེ་གསོལ་བས་སྐུ་དངས་པར་གྱུར་ཏོ།",
    "ལྷར་གྱུར་པས་ཤིང་རྟཐམས་ཅད་བྱིང་ནས་འགྲོ་བར་མི་ནུས་པར་བྱིན་གྱིས་བརླབས་པས།",
    "བཙུན་པ་བཅོམ་ལྡནུབ་ངས་བཟའ་བ་འདི་ཐུགས་རྗེ་ཆེན་པོ་བསྐྱེད་ལ་སོ་སོར་བཞེས་པར་ཞུ་ཞེས་སྟོན་པའི་དྲུང་དུ།",
    "སླར་ཡང་སྲན་མ་ནུ་དྷའི་ཁ་དོག་ཅན་གྱི་རྡོ་ལས་བྱུང་བའི་ལྷད་བ་ཁྲོད་བཞི་ཕུལ་ལོ་། བཅོམ་ལྡན་འདས་ཀྱིས་ལྷའི་བུ་བཞི་པོ་རྣམས་ལ་རྗེས་སུ་བརྩེ་བས་ལྷུངབོ་ཟད་བཞི་པོ་བཞེས་ཏེ།",
    "སྟོན་པས་དེ་རྣམས་ལ་གནང་བ་བྱིན་ནོ།",
    "གནས་བརྟན་ལྔ་སྔས་དེ་བཞིན་གཤགས་བ་བྱོན་པ་རིང་པོ་ཉིད་ནས་མཐོང་སྟེ།",
    "བཅོམ་ལྡན་འདས་ལ་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་རྣམས་ཀྱི་སེམས་དང་སྤྱོད་པ་ཤེས་པར་ནུས་པའི་ཡེ་ཤེས་ཡོད་དོ།",
    "ཟླ་རྣམས་གནས་པར་མི་ནུས་པས་ཕྱག་ཕུལ་ཞིང་བ་སྲུང་བ་དང་བསྙེན་བཀུར་ཐམས་ཅད་བྱས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དག་སློང་དག་བཅོམ་ལྡན་འདས་དང་དེ་བཞིན་གཤེགས་པའི་མིང་དང་ལྡན་པ་ཞེས་ཐ་མལ་པའི་ཚིགབརྗོད་པར་མི་རུང་ངོ།",
    "སླརཡངཧི་མ་གཉིས་པ་ལ་དགྲ་བཅོམ་པའི་འབྲས་བུ་གྲུབ་པར་བྱེད་དོ།",
    "གཞན་ཡང་སླརདེའི་གྲོགས་པོ་ལྔ་ལྡནུ་རྩ་བཞིས་རབ་ཏུ་བྱུང་ཞིང་དག་སློང་དུ་གྱུར་ནས་དགྲ་བཅོམ་པར་བྱེད་དོ།",
    "སྟོན་པས་དབྱར་བཞུགས་ནས་དགག་དབྱེ་བྱས་ཏེ་དག་སློང་དྲུག་ཅུ་པོ་རྣམས་ཕྱོགས་ཕྱོགས་སུ་བཏང་ནས།",
    "དེ་རྣམས་ལས་ཐམས་ཅད་ཀྱི་མཐའི་ཕྱི་མ་རྒྱུན་དུ་ཞུགས་པར་གྱུར་ལ།",
    "ཡང་ན་ལྟེང་རྒྱས་འོད་སྲུངས་ཀྱིས་དག་སྦྱོང་ཆེན་པོའི་རྗེས་སུ་ཚངས་པར་སྤྱོད་པ་སྤྱད་ཅེས་བསམས་སོ།",
    "གནས་བརྟན་ལ་ཚིགས་སུ་བཅད་པ་གསུངས་སོ།",
    "འདི་རྣམས་དྲི་མ་ལེགས་བར་རྟོགས་བྱས་ནས།",
    "དུ་བཞིན་གཤེགས་པ་ལ་ཕྱག་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འཁོད་དོ།",
    "འདས་ཀྱིས་ཁོ་བོས་འདིད་ལྟར་ཁོ་ན་མ་ཡིན་པར་ལྟེང་རྒྱས་འོད་སྲུངས་བཏུལ་ལ།",
    "མི་ཐམས་ཅདཀྱིས་སྟོབས་བཅུར་འི་གཟུགས་མཆོག་ཐོབ་པར་འདོད་པ་བདག་ཉིད་ཀྱི་སྐུ་ལ་བལྟ་བས་ཚིམ་པར་མ་ནུས་སོ།",
    "འདི་ལྟ་བུའི་གཟུགས་ཀྱི་འགནས་སུ་དེ་བཞིན་གཤེག་༧ པའི་མཚན་དང་དཔེ་བྱད་བཟང་བོ་ལསོགས་པའི་རབ་ཏུ་བྱེད་པ་ཐམས་ཅད་ཀྱང་གཟུགས་ཀྱི་སྐུ་དཔལ་གྱི་བསྔགས་པར་བྱ་བར་འོས་སོ།",
    "དེས་རྣམ་པར་བརྟགས་སོ།",
    "དགའདུན་སོ་སོ་ལ་ཇིལྟར་རིགས་པ་བསྟོད་པ་རྗོད་པར་བྱེད་དོ།",
    "སྟོན་པས་བརྒྱ་བྱིན་གྱིས་སྐབས་ཕྱེ་བའི་ལམ་དུདག་སློང་སྟོང་ཕྲག་གཅིགའཁོར་དུ་བྱས་ནས་རྒྱལ་པོའི་ཁབ་ཀྱི་ནང་དུ་གཤེགས་སོ།",
    "མའི་ཚལ་ཡོངས་སུ་གཏོང་ཞིང་སྟོབས་བཅུ་པའི་ཕྱག་ཏུ་ནུ་བསྒྲེངས་ནས་དེར་ཀུན་དགའ་ར་བ་བཞེས་ནས།",
    "སྟོན་པས་འོད་མའི་ཚལ་གྱི་ཀུན་དགའ་ར་བ་བཞེས་ནས་རྒྱལ་པོ་ལ་རྗེས་སུ་ཡི་རང་བར་མཛད་ཅིང་སྟན་ལས་བཞེངས་ཏེ།",
    "བས་སེམས་རབ་ཏུ་དངས་པར་གྱུར་ཏེ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ཐོབ་པར་གྱུར་ཏོ།",
    "དེ་གཉིས་པོའང་སྟོན་པའི་ཉན་ཐོས་ཀྱི་མཆོག་ཏུགནས་པར་གཟུང་ངོ།",
    "སླར་ཡང་དེ་བཞིན་གཤགས་པའི་འོད་མའི་ཚལ་དེ་ཉིད་དུབཞུགས་སོ།",
    "སླར་ཡང་འཕགས་པ་ཞེས་བྱ་བར་ཞིག་བར་མར་གནས་པར་གྱུར་ཏོ།",
    "སུ་ཞིག་ངའི་ཚིག་བཞིན་བྱེད་པར་སོམས།",
    "དགག་དབྱེ་བྱས་ནས་སྟེང་རྒྱུས་སུ་གཤེགས་ཤིང་དེར་ཟླ་བ་གསུམ་བཞུགས་ཏེ།",
    "སྟོབས་བཅུ་པའི་ཉེ་དུ་དང་ཕུད་པར་བྱེད་པའི་ལམ་དུ་འགྲོ་བའི་དུས་ཡིན་ནོ།",
    "དེ་ནས་སྟོན་པ་ལ་འཆར་ཀས་དབྱངས་སྙན་པོས་གཤོགས་པའི་བསྔགས་པར་འོས་པའི་བསྔགས་པ་གསུངས་སོ།",
    "བུ་བཞུགས་ལ་གསོལ་ཅིག།",
    "སྟོང་ཕྲག་ཉི་ཤུའི་དགུ་སློང་འཁོར་དུ་བྱས་ནས་རྒྱལ་བོ་ཆེན་པོ་ཉིད་བལྟ་བའི་ཕྱིར་བྱོནནོ།",
    "རྒྱལ་པོ་ཐུགས་ཚིམ་པར་གྱུར་ནས་སྨྲས་པ།",
    "བཅོམ་ལྡནའདས་བཞུགས་པའི་གནས་རྟོག་ཅིང་ཤཱཀྱ་ནྱ་གྲོ་དྷའི་ཀུན་དགའ་ར་བ་ཡིད་དུ་འོང་བ་སྟ་གོན་བྱས་སོ།",
    "དེར་ཐམས་ཅད་ཉེར་བསྡོགས་བྱས་ནས་སྤོས་དང་མ་ཏོག་སོ་སོ་ལག་ཏུ་ཐོགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཞེས་ནས་ན་གྲོ་དྷའི་ཀུན་དགའ་ར་བ་ཉིད་དུ་བྱོན་ནོ།",
    "པར་འདོད་ཀྱང་ད་ལྟ་ཕྱག་བྱེད་དུ་གཞུག་དགོས་ཏེ།",
    "བསམ་གཏན་དང་ལྡན་པར་འཇུག་བ་བསྐྱེད་དགོས་སྙམ་སྟེ།",
    "ཕྱག་བྱེད་པར་མི་ནུས་པའི་ཤཱཀྱའི་རིགས་གཅིག་ཀྱང་མེད་དོ།",
    "བཅོམ་ལྡན་འདས་བཞུགས་ནས་དུ་རྣམས་དང་འདུས་པར་གྱུར་པ་འ་ཐམས་ཅད་སེམས་གཅིག་ཏུ་གནས་སོ།",
    "འཆི་བའི་དུས་སུ་གདུགས་དཀར་པོའི་འོག་ཏུ་དཔལ་གྱི་མལ་སྟན་གྱི་སྟེང་དུ་གཟིམས་པ་ཉིད་ན་དགྲ་བཅོམ་པ་ཐོབ་པར་གྱུར་ཏོ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་དུ་བྱས་ནས།",
    "ཞབས་ཀྱི་སྟང་དུ་མགོ་བོངཞག་ནས་ཇི་ལྟར་འདོད་པའི་ཕྱག་བྱས་སོ།",
    "མི་འམ་ཅི་ཟླ་བའི་སྐྱེས་རབས་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ནོར་གྱི་བདག་པོ་བྱེད་པར་འགྱུར་བར་དགོས།",
    "སྔར་རུས་པ་མཐོང་ནས་ཁྱེད་ཀྱི་བུ་ཤིའོ་ཞེས་ཟེར་ག་ལ་ཡིད་ཆེས་པར་མ་བྱས་སོ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ཐོབ་པར་གྱུར་ཏོ།",
    "དེ་ལ་བསྐོར་བ་རྣམས་ལ་གནས་བརྟན་ཆེན་པོ་བརྒྱད་ཅུའི་བཞུགས་གནས་སོ།",
    "བསྟི་གནས་ལ་སོགས་པའི་བཞུགས་གནས་དང་།",
