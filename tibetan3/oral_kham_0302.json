    "ཡན་ལག་དང་ཡན་ལག་ཅན་དག་དུས་མཚུངས་པར་འཛིན་པར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་འགྱུར་བ་ཡང་རང་བཞིན་གྱི་རྗེས་སུ་འགྲོ་བ་ཅན་ཡིན་ཏེ།",
    "དེང་སྐབས་ཁོ་རང་ཡིག་རྒྱུགས་གྲ་སྒྲིག་བྱེད་པར་བྲེལ་བ་ཡིན་པས།",
    "ཡང་ན་ཏེ་རཱིའི་ལམ་དུ་ཡོད་པའི་ཇ་ཁང་ལ་འོ་མ་སྐྱེལ་དུ་འགྲོ་བ་སོགས་ག་དུས་ཡིན་ན་ཡང་ཉི་གདུགས་དེ་ཁྱེར་ནས་འགྲོ་ཡི་ཡོད།",
    "ཉི་གདུགས་དེ་ཁྱེད་ལ་བེད་སྤྱོད་མེད་པས་ང་ལ་བཙོངས་ན་གང་འདྲ་འདུག་ངས་ཁྱེད་ལ་ཧིན་སྒོར་ལྔ་སྤྲད་ཆོག་ཅེས་བཤད།",
    "དེ་ནི་ཟུག་རྔུ་ཧ་ཅང་ཆེ་བའི་ཉམས་མྱོང་ཞིག་ལོས་ཡིན།",
    "ལྐུགས་པ་ཁྱེད་རང་འདི་ལ་བེད་སྤྱོད་གང་ཡོད་དམ།",
    "འདི་གང་འདྲ་འདུག་ཅེས་དྲིས།",
    "ཞེས་སོགས་གསུངས་པ་བཞིན་དུ་འདུག་པས་འདི་ཞེས་བྱ་བའི་ངོ་སྤྲད་རྒྱུ་དང་།",
    "དེ་ཡང་རང་ཞེ་སྡང་རྡོ་རྗེར་གསལ་བའི་ཐུགས་ཀར་ཉི་མའི་སྟེང་དུ་ཧཱུྃ་རིང་པོ་དེ་ལས་ཁྲོ་བོ་བཅུ་དཔག་ཏུ་མེད་པ་འཇིག་རྟེན་གྱི་ཁམས་ཁྱབ་པར་སྤྲོས།",
    "འདིར་བགེགས་ཀྱི་གཙོ་བོ་བཀུག་པ་འདི་རྣམས་ཕྱོགས་སྐྱོང་རང་རྒྱུད་པ་ཡིན་ནམ་སྙམ་ན།",
    "ཕྱོགས་སྐྱོང་རང་རྒྱུད་པ་དང་།",
    "ཕྱི་རོལ་གཏོར་མའི་སྐབས་རྣམས་སུ་ནི་ཕྱོགས་སྐྱོང་རང་རྒྱུད་པ་སྤྱན་དྲངས་ནས་མཆོད་གཏོར་འབུལ་ཞིང་འཕྲིན་ལས་འཆོལ་བ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "འོན་ཀྱང་འཇམ་དཔལ་སེང་ལྡན་ལ་འཇམ་དབྱངས་དར་འབོལ་ལ་བཞུགས་པ་ཡང་བྱས་འདུག་ལ།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཡང་རང་གཙོ་བོར་གསལ་བའི་རྩ་ཞལ་གྱི་སྣ་རྩེར་ཟླ་བའི་དཀྱིལ་འཁོར་སྲན་མ་ཕྱེད་པ་ཙམ་གྱི་སྟེང་དུ་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ་ཡུངས་འབྲུ་ཙམ་བསྒོམ།",
    "གཟུགས་ཀྱི་ལུས་དབེན་དང་རང་བཞིན་གྱི་ལུས་དབེན་དང་།",
    "གནས་དབེན་པར་འདུག་ལ་རྡོ་རྗེ་དང་པདྨ་བྱིན་གྱིས་བརླབས་པ་སྔོན་དུ་འགྲོ་བས་སྙོམས་པར་ཞུགས་པས་རྩ་ཕྲན་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་གཉིས་ན་གནས་པའི་བྱང་སེམས་རྣམས་རྩ་སོ་གཉིས་སུ་བབས།",
    "དེ་ནང་རང་ལུས་འཇུག་པ་དང་།",
    "དེ་ལྟར་བསྒོམས་པས་སེམས་གོམས་ཙ་ན་ཐམས་ཅད་སྒྱུ་མའི་ལྷའི་སྐུའི་སྣང་བར་འཆར་བར་འགྱུར་རོ།",
    "མཐར་མི་དམིགས་པའི་ངང་ལ་བཞག་ཡང་རང་རྡོ་རྗེ་འཆང་ཆེན་པོའི་སྐུར་གསལ་བ་དེ་ཐུགས་རྡོ་རྗེ་སྔོན་པོ་ཞལ་གསུམ་ཕྱག་དྲུག་པ་ཐུགས་ཀར་ཧཱུྃ་ཡིག་དང་བཅས་པའི་རྣམ་པར་བསྒྱུར་བ་སྔར་བཞིན་དུ་བསྡུ་བ་དང་།",
    "དེ་ཡང་དང་ཡང་དུ་ནུས་ཚད་དུ་བསྒོམས་པ་ལས་ཇི་ཞིག་ཙ་ན་ཡི་གེར་འཛིན་པ་དང་ཡང་བྲལ་ཏེ་མི་རྟོག་པའི་ངང་ལ་ཕྱམ་སྟེ་འགྲོའོ།",
    "རྨང་གཞིའི་ཤེས་བྱ་འདྲིས་ཆེ་བ་ཞིག་བསྐྱུར་ནས་གསར་བ་ཞིག་སླད་ནས་རྨང་གཞིར་གསོ་དགོས་པར་ཆགས་འདུག་པས།",
    "བོན་འཁོར་སོགས་མང་དུ་འདུག་ཀྱང་།",
    "དངོས་པོ་དང་རང་མཚན་དོན་བྱེད་ནུས་པ་དོན་དམ་བདེན་པ་འདུས་བྱས་རྣམས་དོན་གཅིག་ཏུ་འདོད།",
    "འཁོར་གསུམ་ཞེས་པ་དེ་གསུམ་གྱི་སྟེང་དུ་མགོ་འཁོར་འདུག་ཅེས་པའི་བརྡ་ཆད་དུ་འདོད་པ་ནི་ཐུགས་མཉམ་མ་བཞག་པའི་སྐྱོན་ཡིན་པར་སེམས་སོ།",
    "ཁ་དོག་ནག་པོ་ཡིན་པར་འདྲ་ཡང་རང་ནང་ན་ཡོད་པའི་གཟུགས་མཐོང་ཐུབ་མི་ཐུབ་ཀྱིས་འཇོག་པའང་ཡོད་ལ།",
    "དེ་ཡང་རང་ཡུལ་དུ་གྱུར་པའི་ཚོར་བ་བདེ་སྡུག་བཏང་སྙོམས་གསུམ་ཉམས་སུ་མྱོང་བའི་ཆ་ནས་བཞག་པའི་སེམས་བྱུང་དང་མཚུངས་སོ།",
    "ཞུགས་ནས་ཀྱང་རང་ཡུལ་ལ་གཏོད་ཅིང་བརྟེན་པར་བྱེད་པའི་སེམས་བྱུང་ལྟ་བུ་ལ་ཟེར།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཡིད་མངོན་དང་རང་རིག་གང་རུང་ཡིན་ན་གཉིས་པ་ཡིན་པས་ཁྱབ་པ་ཡོད་དོ།",
    "དེ་བཞིན་རྟག་པ་དང་རང་བཞིན་གཅིག་ཡིན་ན།",
    "དངོས་བོ་དང་རང་བཞིན་གཅིག་ཡིན་ན་རང་བཞིན་གཅིག་ཡིན་པས་མ་ཁྱབ་པའང་འདྲའོ།",
    "ཐ་དད་དང་རང་ལྡོག་ཐ་དད་དོན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "བུམ་པ་དངོས་པོ་དང་རང་བཞིན་གཅིག་ཡིན་ཡང་།",
    "ཤེས་བྱ་མ་ལུས་པ་མཁྱེན་པ་མཁྱེན་བྱ་མཁྱེན་བྱེད་དེ་འདས་མ་འོངས་ད་ལྟ་གསུམ་དུ་འཇོག་པ་སོགས་བྱ་ཚིག་དུས་གསུམ་དགར་ཚུལ་གྱི་རྣམ་བཞག་རྒྱས་པར་བརྡ་སྤྲོད་ཀྱི་གཞུང་ལུགས་རྣམས་སུ་གསལ་བས་འདིར་མི་འགོད་དོ།",
    "ཡང་རང་དོན་ལེའུར།",
    "དངོས་བོ་དང་རང་བཞིན་མཚུངས་པའི་རྣམ་གྲངས་སོ་སོ་བ་གང་ཞིག་དངོས་པོ་ཁེགས་སྟོབས་ཀྱིས་ཀ་བ་ཡང་ཁེགས་དགོས་པའི་ཕྱིར་རོ།",
    "དེ་དག་གང་དུ་ཡོད་པའི་ས་དེར་མི་ཡང་རྗེས་འགྲོའི་ཚུལ་གྱིས་ཁྱབ་ནས་ཡོད་པ་ལྟར་འབྲལ་དུ་མེད་པ་ལྟ་བུར་ཆགས་འདུག་པ་བཞིན་ཡིན་ལ།",
    "བྱེ་བྲག་ཟེར་བ་ཙམ་ལ་བསམ་བློ་གཏོང་ཚེ་ཁྱབ་ཆུང་བ་ཞིག་བསམ་གྱིན་འདུག་ཀྱང་།",
    "འཛམ་གླིང་ཐོག་མི་རིགས་སུ་འདྲ་ཞིག་ཡིན་ཀྱང་རང་རིགས་དང་རང་རིགས་ཀྱི་ཡོན་ཏན་ལ་ཤ་ཚ་མི་བྱེད་པ་སུ་ཞིག་ཡོད་དེ།",
    "ང་རང་རང་ཁྱིམ་དུ་གཏོང་རོགས་ཞེས་ཟེར།",
    "ཉིན་འགའི་རྗེས་ནས་སྔར་བཞིན་དྲན་མེད་དུ་གྱུར་ནས་སླར་སོས་ཚེ་སྔར་གྱི་ལོ་ལན་རང་དུ་འདུག་པས་མི་ལིས་ཀྱི་ཕ་མ་གཉིས་ངོ་མི་ཤེས་པ་ལྟ་བུ་གྱུར་ཏོ།",
