    "དད་ལྡན་འབྲོག་པ་རེ་ལྟ་བཞིན་གཏོ་རྒན་མ་ཞེས་ཇོ་རྒན་མ་དེ་ལ་རྣམས་ཀྱིས་མཐོང་ན་འཕྱས་ཡོང་བ་རེད་ཅེས་རྫིག་སྡིགས་མོ་བྱས།་",
    "འགྱེལ་ནས་ཤི་རྫུ་བྱེད་པ་བཞིན་གནམ་ལ་ཅེ་རེར་སྐྱེ་མཐོང་ན་མཐོང་དུ་ཆུགས།",
    "ཁོ་ད་བསྡད་ཡོད་པ་སུ་ཞིག་གིས་མ་མཐོང་ངམ།",
    "སྐབས་དེར་ཇོ་མོ་རྒན་པ་དེ་ཨ་ལོག་ཅིག་བརྒྱབ་བདེ་ཅུས་སུ་རང་སྐྱོན་ངོས་ལེན་ཞུ་རུ་ཕྱིན།",
    "ཇོ་ལྷ་སྒྲོལ་མ་ཕྱིར་ཁོ་རང་གི་ལག་ཏུ་འབྱོར།",
    "དགོན་གྱི་ར་སྐོར་ཧྲིལ་བོ་འོད་ཆེམ་ཆེམ་དུ་བཏང་སྟོན་ཁར་གསེར་ཁོ་དང་བུ་མོ་སྒྲོལ་མས་བས།",
    "ཇོ་མོ་ཚང་མས་དེ་ཅི་ཞིག་རེད་ཅེས་ཡར་གཉེན་སྒྲིག་བྱས་ཤིང་མགོ་སྦྲ་གསར་བ་ཞིག་གི་ནང་ལངས་ནས་རུབ་ཚོགས་བརྒྱབ།",
    "གསེར་ཁོས་མོ་རྒན་པ་དེ་ལ་འཇིམ་པའི་སྒྲོལ་སྐུ་ཞིག་ཡོད་དེ།",
    "མ་ལ་མིག་གཡེང་གིས་ལྷ་དང་མིའི་བར་དུ་ཤིན་ཏུ་ད་ཅིའི་ཛ་དྲག་ཆེ་བའི་འགག་རྩའི་དུས་སུ་ཇོ་མོ་ཟབ་པའི་འབྲེལ་བ་ལྐོག་གྱུར་ཅིག་ཡོད་པར་དཔྱད་བགྲེས་པ་དེ་སར་འགྱེལ་ནས་གཟན་འོག་ནས་སྒྲོལ་པ་གཏོང་བ་འདྲ།",
    "དོགས་གཞི་ཁུངས་ནས་མི་གཉིས་མངགས་ཡོང་སྟེ་ཁྱོད་ཚང་མང་བོ་བསླངས་པས་སོ་འབྲད་འགའ་ཞིག་བརྒྱབ་གིས་ལྷ་སྐུ་ཞིག་བོར་ཨེ་མྱོང་ཞེས་དྲིས།",
    "འུ་ཚང་གི་ལྷ་སྒྲོལ་ཅོར་བཙལ་དུ་ཕྱིན།",
    "ད་ལྟ་མགྱོགས་པོ་མེད་པར་འཚམས་པོར་བདེ་མོར་ལག་ཏུ་ཚུད་པ་མགྱོགས་པོར་ཟི་ལིང་དུ་ལྷ་སྐུ་ངོས་འཛིན་བྱ་རུ་།",
    "ལྷ་སྒྲོལ་མའི་འགྲམ་དུ་ལྷ་སྒྲོལ་མ་ལས་ཅུང་སོང་།",
    "སྐྱེས་པའི་སྐུ་སྤུན་ལྟ་བུའི་སྒྲོལ་སྐུ་ཆུང་ཆུང་ཞིག་སོང་།",
    "ཆ་གསེར་ཁོས་ཟི་ལིང་དུ་འགྲོ་དགོས་ན་ཙོག་པུར་ཡོད་པ་ཧ་ཅང་མི་ཚར་བ་ལ་ཨང་སེམས་གཅིག་གོ་གཉིས་ཆོད་རེད།",
    "མ་གཞིར་མི་སྒྲོལ་མར་ཕྲུ་གུ་འཁོར་འདིའང་ངེད་ཚང་གི་རེད་དམ།",
    "གྲྭ་རྒན་དེ་ད་ཆ་ཧ་ལམ་གྲོངས་སོང་ཏུ་རྟ་བརྒྱུགས་པ་རེད།",
    "འོན་ཀྱང་སྐུ་འབུམ་དུ་ཡོད་རྒྱུ་རེད།",
    "ད་སྔོན་ཟི་ལིང་ཕྱོགས་ནས་བོད་ཀྱི་ཕྱིན་ནས་རྒྱང་ཕྱག་མང་བོ་ཕུལ་ཐལ་ཆེ་བ་ཡིན་པ་ལྷ་རྟེན་ལ་འཇུག་པ་མི་དམན་པའི་གྲྭ་རྒན་ཞིག་འདྲ།",
    "ཟླ་ཁ་མ་གང་བར་ལམ་དུ་བུ་མོ་ཞིག་ཐོག།",
    "ཆེད་འབད་ནས་སྡོད་པ་ལས་ལྷ་སྐུ་ངོས་འཛིན་བྱ་རུ་དུ་ཕེབས་པའི་གྲྭ་རྒན་དེས་ཁྱོད་ཀྱི་ལྷ་སྐུ་མཐོང་མ་འགྲོ་ཁོམ་མ་བྱུང་།",
    "བུ་མོ་ཆུང་ཆུང་དེ་མཇལ་སྐོར་ཐག་དྲན་སྐུལ་ཐེབས་པ་བཞིན་རང་གི་རུམ་ནས་ལྷ་གྱི་ལམ་དུ་སྐྱེས་པ་ཡིན་པས་མིང་ཡང་ལམ་བཟང་སྐུ་ཆུང་ཆུང་ཞིག་ཚུར་བླངས་ཏེ་འགྲམ་དུ་བཞག་སྟེ།",
    "སྒྲོལ་མ་ཞེས་བཏགས་ཤིང་བང་ཞག་ཚང་རྗེས་རང་འདི་གཉིས་མ་སྨད་རེད།",
    "ལམ་བཟང་མོ་ཕོག་སྟེ་དབུགས་མཐུད་དུ་སྲོག་གི་རྟ་རྔ་དཔྱངས་ཚ་༢གང་ག་དམ།",
    "འདུག་ཞལ་ཆེམས་བཞག་ནས་ལྷ་སྐུ་འདིའི་བདག་དག་ཏུ་ངེད་གཉིས་ཀྱིས་རང་རང་གི་ས་ནས་རང་སྐུ་ཉར།",
    "དེའི་ཕྱིར་བདག་ཉར་བཅུག་པས་རེ་ཞིག་གཏོལ་མེད་དུ་གྱུར།",
    "དེ་ནས་ཉི་མ་འགའ་ཞིག་འགོར་རྗེས་སོང་ནས་བལྟས་དུས།",
    "ངེད་ཀྱི་བུ་ཆུང་གིས་ཞིག་ཡོད་པ་དེ་ལ་བསྟན་ཀྱང་།",
    "ཁྱོད་ཀྱི་ཨ་མ་དང་ངེད་གཉིས་ཅིག་ཤར་ཡོང་བ་ནི་དེ་དུས་ཤམ་ཐབས་དམར་པོ་ཆུང་དུས་ཁྱིམ་མཚེས་ཡིན།",
    "བར་སྐབས་དེར་ཨ་མས་གཙང་དག་པའི་ཞིང་ཁམས་སུ་བསླེབས།",
    "ཕྱིར་ཡོང་ཁར་རུ་བརྗེས་ན་ཅི་འདྲ་རེད་ཅེས་དྲིས་མྱོང་།",
    "ཆེ་བ་ལྷ་སའི་གླིང་ནས་གཏམས་གཏམས་ནས་སྒྲོལ་སྐུ་མ་སྨད་འདི་ཆུང་བ་དང་བརྗེས་ན་ང་ཚོས་གྱོང་རེག་པ་མ་གཉིས་ཉོས།",
    "ཕྱིར་རང་ཡུལ་དུ་བསླེབས་ནས་ཁྱོད་ཀྱི་ཨ་མའི་མཚན་ལ་སྒྲོལ་མ་ཟེར་བས་ལག་རྟགས་ལྟ་བུར་ཆུང་བ་རེད་དམ་ཞེས་ཁོས་ཐེངས་འགའ་ཞིག་ལ་མི་འཐད་དེ་བྱིན།",
    "ཆེ་བ་རང་གི་སར་ཉར།",
    "དེ་ནས་ང་ཚོས་སྒྲོལ་སྐུ་བརྗེས་ཏེ་ཆེ་བ་ཁྱོད་ཀྱི་ཨ་མས་ཉར།",
    "ཆུང་རྩོམ་སྒྲིག་འགན་འཁུར་པ་ཚེ་རིང་མཁར་ཡིན་བ་རང་གིས་ཉར།",
    "འགའ་རེས་ར་རོ་བའི་རྗེས་སུ་མགོ་ལྷག་པ་འཐུངས་ན་ལྷ་གཉན་མཐུ་བོ་ཆེ་དག་གིས་ཁྲིད་དང་ཁ་འཛིང་ལག་འཛིང་བྱས་ནས་གོ་གནས་བཀའ་ཆད་ཐོག་ལྟར་བབ་ཀྱང་རང་གིས་ཉོས་པ་ཡ་ཕབ་པའམ་ཏང་གི་སྐྱིད་སྡུག་ལས་ཕུད་པ།",
    "དེའི་རྗེས་ཆང་རྐྱལ་འཐུངས་ནས་ནག་མོ་བསྐྲད་པ།",
    "འགའ་རེས་བུ་གཞན་དག་ཚང་མས་ཀྱང་རེ་རེ་བཞིན་དེ་འདྲའི་ལོན་ལེན་ཆེ་བས་དབུལ་པོ་ཆགས་པ།",
    "འགའ་རེས་མནའ་ཚིག་ཅིག་འབོར་བཞིན་རེ་རེ་བཞིན་སྒོག་།",
    "དེ་ནི་ཁོ་ཚོས་སྒྲུབ་པའི་སོགས་འཐུངས་པའི་ལག་རྗེས་རེ་ཞིག་བརྗོད་མི་ཐུན་མོང་དུ་ཆང་རག་གཅོད་པའི་ཆོ་ག་བསྡུས་མ་ལང་།",
    "དེ་སྔོན་སོ་སོ་རེ་རེས་མངོན་ལྐོག་གང་།",
    "ཕུག་ལམ་རིང་མོ་ཞིག་བྲད་ཅིང་བྲུས་ནས་ས་ཐོག་རུང་ནས་ཆང་གཅོད་ཆོ་ག་དང་མནའ་སྒོག་དཔང་ཏུ་བུད་མ་ཐག་པའི་བྱི་ལོང་སྣ་བརྡོལ་བཞིན་རེ་འཛུགས་དུ་མ་བྱས་ཀྱང་འབྲས་བུ་སྨིན་མ་མྱོང་།",
    "འཇིག་རྟེན་འདིས་ཀྱང་ཁོ་ཚོར་ཧད་ཧད་རེ་རེར་ཆང་འཐུང་རྟོགས་བརྗོད་རེ་རེ་ཡོད་པ་ལས་དུ་ལྟ་ཞིང་བཀྱེད་བཀྱེད་ཀྱིས་བྱོལ་ནས་འགྲོ།",
    "འགའ་ཞིག་གིས་ནི་དགུན་གསུམ་ཙག་ངར་ཆེ་དུས་རིན་པ་མང་དུ་བྱིན་ཀྱང་མཐར་དྭངས་ཤིང་ཆང་འཐུངས་ནས་ཐང་སྟོང་དུ་ཞག་ལ་ལུས་ཏེ་སད་ནས་འཇིག་རྟེན་འདིའི་ཕ་རོལ་ཏུ་བསླེབས།",
    "མཛུབ་མོ་མི་ཚང་བར་གྱུར་པ་དང་།",
    "འགའ་རེ་ནི་ཨོཾ་ག་ཏེ་ག་ཏེ་པཱ་ར་ག་ཏེ་པཱ་ར་སཾ་ག་ཏེ་བོ་དྷི་སྭཱ་ཧཱ།",
    "ཆང་རག་གི་རབ་རིབ་དང་།",
    "མནར་གཅོད་དང་ངར་སེམས་ཁོང་དུ་ཆུད་པའི་ལས་བྱེད་དཀྱུས་མ་ཞིག་སྤོབས་ཚང་མར་གྱེས་ཕྱག་ཕུལ་ཏེ་འཚོ་བ་གསར་བ་ཡིན་ཀྱང་འདི་གར་བསླེབས་ནས་ཕྱིར་སོང་དུས་བྱ་ཞིག་བསྐྱར་དུ་སྐྱེལ་མགོ་བརྩམས།",
    "ཁོ་ཚོ་རེ་ཞིག་གོམས་ཀྱིན་མེད།",
    "འཕྱོ་ཞིང་གཟི་ཉམས་ཀྱིས་འཁྱུད་པས་གཉའ་ཆག་ཅུང་ཙམ་ལས་མ་འགོར་པར་གཉེན་རྟགས་རྒྱག་ཉམས་སྨད་པའི་རྒྱ་ལས་ཐར་ནས་ལམ་བཟང་གི་སྣ་མཁན་དང་།",
    "རྒྱ་མཚོ་སྔོན་མོ་ཆང་ལ་གྱུར་ཀྱང་།",
    "ད་ཆ་ཁ་གཏད་ཧུབ་པོ་གང་གི་རེ་བ་མེད།",
    "ཁྲི་ཤོར་རྒྱལ་མོ་མོ་ཐེ་འཇོལ་ཧ་ཅང་དཀའ།",
    "ཡུལ་ཚོར་བསླེབས་པ་ན་ཨ་ལགས་ཤིག་གམ་ཨ་ཕ་དཔོན་པོ་ཞིག་བསླེབས་པ་ན།",
    "དམ་བེ་ཁེར་མ་ཨ་མ་སླེབ་པ་བཞིན་ལས་བྱེད་ཡོད་ཚད་འཛུམ་མིག་ཞིག་མདུན་དུ་བཞག་ལས་བྱེད་རྣམས་ཀྱིས་རྒྱབ་ཧྲིག་ཧྲིག་བཟི་མིག་ཟུམ་ཟུམ་གྱིས་བརྒྱུགས་ཡོང་།",
    "རྫི་ལྟ་བུར་བར་བར་བཞེས་དང་བཞེས་ཞེས་ལབ་པ་ནས་ལག་འཇུ་བྱས་མ་ཐག་ཆང་རག་དམ་བེ་ཞིག་ལས་མི་གཅིག་གིས་ཀྱང་ཁམ་བུ་གང་མི་འཐུང་བས་རང་འཁོར་རྒྱག་ཞོར་དགོད་སྒྲ་དང་བསྟོད་སྒྲ་ཉོབ་པ་ལ་ཨང་།",
    "མགྲོན་པོ་དང་པོ་ཁྱོན་ནས་ཡིད་མ་ཆེས།",
    "རྗེས་སུ་ཆང་འཐུང་རོགས་ཡོད་པ་མ་རེད།",
    "ལྟར་ན་གཞིས་བདག་གིས་མགྲོན་པོར་འཐུང་རོགས་མཐོན་པོ་སྲིད་ཀྱི་ཁྲི་ལ་མངའ་གསོལ།",
