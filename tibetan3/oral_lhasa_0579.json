    "སྙན་པར་སྨྲ་བའི་ཡིད་འཕྲོག་གཏམ་ནི་སྲིད་གསུམ་གདུལ་བྱའི་རྣ་བར་སྙན།",
    "བདེན་གཉིས་རང་བཞིན་སྤང་བླང་མ་ངེས་པར།",
    "གང་ལ་ཆགས་དང་སེར་སྣའི་དྲི་བྲལ་གཏོང་ལ་དགའ་བའི་སེམས་ཀྱི་ཁྱད་པར་རིན་ཆེན་གཏེར།",
    "འགྲོ་མང་ཡོངས་སུ་ཚིམ་པར་མཛད་པའི་སྣ་ཚོགས་འབྱོར་བ་ཤིན་ཏུ་རྒྱ་ཆེའི་རླབས་ཕྲེང་ལས།",
    "ཀུན་ནས་ཞི་བའི་ཡོན་ཏན་ཡོངས་རྫོགས་སྟོན་ཀའི་ཟླ་ལྟར་རྣམ་པར་དག།",
    "ཐམས་ཅད་མཁྱེན་པ་དྲི་མེད་འོད་ཟེར་རྒྱལ།",
    "འདུ་ཤེས་སྣ་ཚོགས་རྣམ་པར་བཤིགས་པའི་ཡེ་ཤེས་རྡོ་རྗེ་མི་ཕྱེད་བརྟན།",
    "སོ་སོ་རིག་བཞིའི་མཁྱེན་རབ་མཐའ་ཡས་པས།",
    "ཚུལ་འདི་བསྟོད་འདོད་གཅམ་བུས་མ་ལགས་རབ་བསྔགས་དོན་དང་ལྡན་པ་སྟེ།",
    "རྣམ་པར་མི་རྟོག་བསམ་ཡས་ཡོན་ཏན་མཛོད།",
    "དེ་དེའི་མངོན་བརྗོད་ཕྱོགས་བཅུའི་རྒྱལ་བས་བསྐལ་པར་བགྲངས་ཀྱང་མཐར་གཏུགས་མེད།",
    "མཛད་པའི་ཚུལ་ལ་སླར་ཡང་བསྔགས་པར་སྤྲོ།",
    "རྟག་ཏུ་མི་གཡོ་མཉམ་ཉིད་ངང་ལ་བཞུགས།",
    "བཅུ་ཕྲག་རིག་གཞུང་རྣམ་པར་འབྱེད་ལ་ཟླ་དང་བྲལ་བའི་སྤོབས་པ་ཅན།",
    "ཟུང་འཇུག་རིག་སྟོང་མཉམ་ཉིད་ཚད་ལ་ཕེབས།",
    "མཁྱེན་རབ་ཉི་མ་འབར་བའི་འོད་རྣོན་གྱིས།",
    "མཁྱེན་རབ་དྲི་མེད་རིན་ཆེན་སྟེགས་བུ་ཉེར་བཟུང་ནས།",
    "ཁྱད་པར་གསང་ཆེན་ངེས་པའི་མཐར་ཐུག་དོན།",
    "ལེགས་པར་འདོམས་ལ་འགྲན་ཟླ་ཀུན་བྲལ་བའི།",
    "མ་སྦྱང་བདག་ལྟས་ཕྱོགས་ཙམ་དཔོག་པར་དཀའ།",
    "མཁྱེན་བརྩེའི་ཕུང་པོ་གཅིག་ཏུ་བསྡོམས་པའི་དཔྱིད།",
    "ཕུན་ཚོགས་ལེགས་བྱས་འབྱོར་བ་མཐའ་ཡས་ཤིང་།",
    "ལྟ་ཇི་སྙེད་མ་འདྲེས་མཁྱེན་པའི་ཐུགས།",
    "རྒྱལ་ཀུན་མཁྱེན་པའི་ཆུ་ཀླུང་བྱེ་བ་སྟོང་།",
    "གང་དུ་འདུས་པའི་མཁྱེན་མཆོག་གངས་ཆེན་མཚོ།",
    "རྣམ་པར་རོལ་བ་གཅིག་ཏུ་ངེས་པར་རྙེད།",
    "བློ་གྲོས་བུང་བའི་ལེགས་བྱས་དབྱངས་སྙན་འབུམ།",
    "འཆད་མཁས་མཚོ་བྱུང་མགྲིན་པར་རོལ་བའི་གླུས།",
    "འབྲལ་མེད་བསྟེན་པར་སྨོན་བཞིན་ཕྱོགས་ཙམ་བསྔགས།",
    "ཕྱོགས་ཙམ་མཚོན་པར་ནུས་མིན་པའི།",
    "མཁྱེན་དང་བརྩེ་བའི་རླབས་ཕྲེང་ཅན།",
    "ལེགས་པར་སྨྲ་བའི་མཆོག་བརྙེས་པས།",
    "རྙོག་མ་ཅན་དུ་བྱས་པའི་ཚེ།",
    "མཁས་པར་རློམ་པའི་ང་རྒྱལ་གྱིས།",
    "རྣམ་པར་གཡེང་བའི་ཚོགས་སྤངས་ཏེ།",
    "རྣམ་པར་མི་རྟོག་ཕ་རོལ་ཕྱིན།",
    "སྙན་པར་སྨྲ་བའི་སྤྲིན་གྱི་སྒྲ།",
    "རྣམ་པར་བསྔགས་འོས་ཇི་སྙེད་པ།",
    "རྣམ་པར་དབེན་ཡང་ཟོལ་སྤྱོད་གོས།",
    "དེ་ལས་ཐོབ་པའི་ལེགས་བྱས་ཀྱིས།",
    "ཤིན་ཏུ་མི་གཡོ་ཞི་བའི་དབྱིངས་ནི་མཁའ་ལྟར་རབ་ཡངས་སྤྲོས་པ་ཀུན་གྱིས་རྣམ་པར་དབེན།",
    "འོད་གསལ་ཐིག་ལེ་ལྷུན་གྱིས་གྲུབ་གང་འདུས་མ་བྱས་པ་སྐུ་དང་ཡེ་ཤེས་ཀུན་གྱི་མཛོད།",
    "གཞན་ཕན་ཐུགས་བསྐྱེད་ཟླ་ཞུན་བསྐྱིལ་བའི་ཆུ་གཏེར་ལས་འཁྲུངས་མཁྱེན་བརྩེའི་འོད་དཀར་རླབས་ཕྲེང་ལས།",
    "མ་ལུས་སྐྱེ་དགུའི་ལེགས་ལམ་རབ་སྣང་ཀུན་དགའི་མཚོ་སྐྱེས་རྣམ་པར་འཛུམ་པའི་དགེ་མཚན་འདབ།",
    "བསླབ་གསུམ་གདེངས་ཅན་རྣམ་པར་རོལ་བའི་དཔལ་གྱིས་ཡོངས་བཟུང་འཇིག་རྟེན་རྒྱན།",
    "ལེགས་པར་སྨྲ་བའི་ཡོན་ཏན་ཀུན་རྫོགས་ཚངས་དབྱངས་རྒྱ་མཚོའི་རྗེས་འགྲོ་ཞིང་།",
    "ཟབ་ཡངས་མཁྱེན་རབ་སྦྱིན་ཆེན་བརྩེགས་ལས་བརྒལ་བརྟག་རྩོད་པའི་འབྲུག་སྒྲ་སྒྲོག།",
    "འཇིག་རྟེན་འཇིག་རྟེན་འདས་པའི་བློ་གྲོས་མ་ལུས་ཡོངས་ཟླུམ་མཁྱེན་པའི་གཏེར།",
    "རྙོགས་མར་བྱས་པའི་རང་བཟོའི་ལམ་མང་གངས་ལྡན་ལྗོངས་འདིར་བྱུང་གྱུར་ཀྱང་།",
    "མཁྱེན་བརྩེའི་ཉི་ཟླ་མཆོག་ཏུ་གསལ་གང་ནུབ་རིར་གཟིམས་པ་ཅང་བདེན་ནམ།",
    "ཉི་མ་མིན་ཡང་གདུལ་བྱའི་པདྨོ་རྣམ་པར་རྒྱས་བྱེད་སྐྱེ་དགུའི་མིག།",
    "གང་དང་འགྲོགས་པས་ཡོན་ཏན་བསུང་ཞིམ་རྣམ་པར་འཕེལ་བའི་རང་བཞིན་ནི།",
    "ཞིང་ཀུན་འགེངས་པའི་མི་ཡི་སེངྒེ་འཇིག་རྟེན་སྒྲོན་མེར་ཕེབས་པའི་ཚེ།",
    "དེང་ནས་བཟུང་སྟེ་གཞན་ལ་ཕན་པར་རོ་གཅིག་ཉིད་ལས་རང་དོན་གྱི།",
    "མངོན་སུམ་མཐོང་ལས་སྨིན་གྲོལ་བདུད་རྩིའི་དབུགས་འབྱིན་ཆེན་པོ་འཐོབ་པར་ཤོག།",
    "དེ་ལས་ཐོབ་པའི་ལེགས་བྱས་དྲི་མེད་སྟོན་ཁའི་ཟླ་བའི་རྗེས་འགྲོ་བ།",
    "བདག་བློ་ཉེས་བརྒྱའི་མི་གཙང་ཕུང་པོ་ཤིན་ཏུ་སྨད་པའི་རང་བཞིན་ཡང་།",
    "ཀུན་གྱི་མཁྱེན་བརྩེའི་ཆུ་ཀླུང་འབུམ།",
    "ཁྱེད་ཀྱི་ཚུལ་འདི་བརྟགས་པར་དཀའ།",
    "སྲིད་པར་འཇུག་དང་སྐྱེ་བར་སྟོན།",
    "མཁྱེན་རབ་པདྨོ་ཁ་ཕྱེ་ལས།",
    "འགྲོ་གཞན་དབེན་པར་བསྐུལ་བའི་སླད།",
    "དབེན་པར་དགྱེས་པའི་ཚུལ་ཡང་སྟོན།",
    "རྣམ་པར་འབྱེད་ལ་བསྙེངས་བྲལ་བའི།",
    "ལེགས་པར་གསུངས་པ་དེ་བཞིན་དུ།",
    "ཨེ་མ་མཁྱེན་བརྩེའི་དཀྱིལ་འཁོར་རྒྱས།",
    "མཁྱེན་བརྩེའི་ཉི་ཟླ་དང་འགྲོགས་པས།",
    "འགྲོ་བའི་ལེགས་བྱས་རྒྱ་མཚོའི་གོས།",
    "ཆ་གཅིག་ཁོ་ནས་སྣང་བར་བྱས།",
    "སྣང་བར་བྱས་སོ་ཤེས་བྱའི་ཡུལ།",
    "གསལ་བར་བྱས་སོ་ལྔ་བདོའི་སྨག།",
    "དགའ་བར་བྱས་སོ་སྐལ་བཟང་ཡིད།",
    "ཉམས་པར་བྱས་སོ་ཡིད་སྲུབས་དཔུང་།",
    "འདབ་སྟོང་རྣམ་པར་རྒྱས་སོ་ཀྱེ།",
    "ཚུལ་འདི་བརྗོད་པར་དོན་ལྡན་ཞིང་།",
    "གཏམ་འདིས་ཤིན་ཏུ་དོན་ལྡན་བྱས།",
    "ལེགས་བྱས་དྲི་མེད་སྟོན་ཟླའི་དཔལ།",
    "དབེན་པར་ཞི་བའི་བདུད་རྩི་བརྙེས་དེར་འདུད།",
    "ཞི་བའི་ནགས་སུ་བགྲོད་པར་འདོད་པའི་བློ།",
    "མཚོན་མིན་ཆོག་ཤེས་ནོར་གྱིས་འབྱོར་བ་ལགས།",
    "ཟད་མེད་དགའ་སྟོན་ཁྱད་པར་དུ་མ་ཞིག།",
    "བསམ་གཏན་པ་དག་སྙོམས་པར་འཇུག་པའི་གནས།",
    "ཡིད་འཕྲོག་ཤར་རིའི་ཕྲག་པར་པདྨོའི་གཉེན།",
    "སྐར་ཚོགས་པདྨོའི་འདབ་ཕྲེང་ཆེར་འཛུམ་པར།",
    "བག་ཕེབས་ལུས་ཀྱི་བདེ་ཉམས་བསྒྱུར་དང་བཅས།",
    "མཁའ་འགྲོའི་ཚོགས་ལ་རྟག་ཏུ་བསྟེན་པ་ལགས།",
    "ཡལ་འདབ་འཚམ་པར་བཀོད་པའི་གྲིབ་བསིལ་ནི།",
    "རྒྱལ་དང་རྒྱལ་སྲས་ཀུན་གྱིས་བསྟེན་པ་ལགས།",
    "ནམ་མཁའ་དྭངས་པས་དབྱིངས་སྣང་ལྷག་པར་གསལ།",
    "གོང་མའི་རྗེས་སྙོགས་རྒྱལ་བ་དགྱེས་པ་ལགས།",
    "རང་གྲོལ་རྟོགས་པར་སེམས་བསྐྱེད་དོ།",
    "སྡིག་ལྟུང་ཀུན་བཤགས་དུས་གསུམ་གྱི།",
    "ཡེ་གྲོལ་ཆེན་པོར་རྟོགས་པར་མཛོད།",
    "ཚེ་འདིར་ཕྱིན་པར་བྱིན་གྱིས་རློབས།",
    "བློས་བྱས་ཉམས་ཀྱིས་མ་བཅིང་བར།",
    "མངོན་སུམ་རྗེན་པར་རྟོགས་བྱིན་རློབས།",
    "སྐྱབས་གནས་ཀུན་གྱི་མཁྱེན་བརྩེའི་གཏེར།",
    "ཁྱད་པར་རྔ་ཡབ་དཔལ་རི་ནས།",
    "ཕྱི་ནང་མཆོད་སྤྲིན་རྒྱུན་མི་ཆད་པར་མཆོད།",
    "མྱ་ངན་མི་འདའ་བཞུགས་པར་གསོལ་བ་འདེབས།",
    "ནམ་ཞིག་དགོངས་ཀློང་རོ་གཅིག་འདྲེས་པར་ཤོག།",
    "རྣམ་པར་འཁྱམས་པའི་མགོན་མེད་བདག།",
    "ཐུགས་རྗེ་བཏང་སྙོམས་མ་མཛད་པར།",
    "ལམ་བཞི་འབྱོངས་པར་མཛད་དུ་གསོལ།",
    "སྐུ་གསུམ་ཐོབ་པར་མཛད་དུ་གསོལ།",
    "དེ་རིང་བཏང་སྙོམས་མ་མཛད་པར།",
    "མགྲིན་པར་ཐིམ་པས་ངག་སྒྲིབ་དག།",
    "བཅས་བཅོས་མེད་པར་མཉམ་པར་བཞག།",
    "རང་གཞན་དོན་གཉིས་ལྷུན་གྱིས་འགྲུབ་པར་ཤོག།",
    "སྡིག་ལྟུང་ཀུན་བཤགས་དུས་གསུམ་གྱི།",
    "ལེགས་བྱས་རྒྱ་མཚོར་རྗེས་ཡི་རང་།",
    "འཇིག་རྟེན་སྒྲོན་མེ་མཛད་དེ་རྟག་བཞུགས་གསོལ།",
    "བློས་བྱས་འཁྲུལ་པའི་འཆིང་བ་རང་སར་གྲོལ།",
    "ཐུགས་ཡིད་བསྲེས་ཏེ་མཉམ་པར་བཞག།",
    "བླང་དོར་བྲལ་བའི་ཐུགས་དམ་དགྱེས་པར་བསྐྱེད།",
    "ཨཱུརང་གཞན་རྣམ་པར་དག་པའི་ཡེ་ཤེས་ལ།",
    "ཀུན་རྟོག་འཆལ་བར་སྤྱོད་པའི་བློས་བྱས་ཀྱིས།",
    "གཉིས་མེད་མཉམ་པ་ཆེན་པོར་སྦྱངས་ཤིང་བཤགས།",
    "བདེ་བ་ཆེན་པོ་འདུས་མ་བྱས།",
    "སྲིད་ཞིར་མི་གནས་སྐྱིལ་ཀྲུང་བཞུགས",
    "དབྱིངས་ལྔ་སྟོང་ཆེན་ཕྱག་རྒྱ་ཡིས་འཕོ་འགྱུར་མེད་པར་རྒྱས་བཏབ་པས་སྐྱེ་འཆི་འགྱུར་མེད་ཡེ་ཤེས་ཀྱི",
    "དགའ་བཞི་བདེ་བ་ཆེན་པོར་རོལ་རང་བྱུང་ཡེ་ནས་འདུས་མ་བྱས་མ་བསྐྱེད་ཡོངས་རྫོགས་དོན་གྱི་ལྷ",
    "ལས་ཅན་བརྒྱུད་འཛིན་རིམ་པར་བྱོན་རྣམས་ལ།",
    "ཁྱད་པར་རོ་སྙོམས་ཆེན་པོའི་བརྟུལ་ཞུགས་ཀྱིས།",
    "བློ་བྲལ་རྟོགས་པའི་རྩལ་ཆེན་རྫོགས་པར་ཤོག།",
    "མཛད་སྤྱོད་རྒྱ་མཚོ་མཐའ་རུ་ཕྱིན་པར་ཤོག།",
    "དགེ་ཞིང་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་དམ་པ་མྱུར་དུ་ཐོབ་པར་ཤོགཨོཾ་ཨཱ་ཧཱུྃ་མ་ཧཱ་གུ་རུ་སརྦ་སིདྡྷི་ཧཱུྃ",
    "རང་བྱུང་འོད་གསལ་ཀུན་ཁྱབ་འདུས་མ་བྱས་དེ་བཞིན་ཉིད་དབྱིངས་རྣམ་པར་དག་པ་ལ་བགེགས་ཞེས་བྱ་བ་མིང་ཡང་མ་གྲུབ་པས་རིག་རྩལ་འགགས་མེད་ཡེ་ཤེས་རྡོ་རྗེའི་གུར་ཡོངས་གྲུབ་གསང་བའི་མཚམས་ལས་འདའ་མ་བྱེད་བཛྲ་ཛྷ་ན་རཀྟ་ཧཱུྃ",
    "ཞབས་གཉིས་སྐྱིལ་ཀྲུང་དྲང་པོའི་སྟབས་སུ་བཞུགས་སྐུ་གསུང་ཐུགས་ལས་འོད་ལྔའི་འཕྲོ་འདུ་འཁྲུགས་ཐུགས་སྲོག་དྭངས་མ་འོད་ཀྱི་ཚོམ་བུར་གསལ་དེ་ཡི་ཕྱི་རིམ་ཡེ་ཤེས་འོད་ལྔའི་དལ",
    "གཙང་མར་སྦྱར་བའི་ཞབས་བསིལ་གངྒའི་རྒྱུན",
    "ལྷ་སྔགས་ཡེ་ཤེས་རོལ་བ་ལམ་གྱིས་གསལ",
    "སྐུ་ནི་ལྷོ་ནུབ་སྲིན་པོའི་སོགས་དངདུས་ངན་སྙིགས་མའི་མཐའ་ལ་སོགས་དང་ལྔ་བརྒྱ་ཐ་མ་སོགས་ཤུ་ལོ་ཀ་བཞི་ལ་གོང་བཞིན་འགྲེས་གཅིག་པར་བྱ",
    "འདོད་དོན་ཐེ་ཚོམ་མེད་པར་འགྲུབ",
    "ལྔ་བ་ཐུགས་དམ་སྐོང་ཞིང་བཤགས་པ་ནི",
    "བདེ་བར་གཤེགས་པ་སོགས་ནས་ཨ་ལ་ལ་ཧོཞེས་གཙང་རྨེ་མེད་པར་ལོངས་སུ་སྤྱོད་པར་བྱའོ",
    "དཔལ་ཆེན་རོལ་པའི་ཕམ་ཕབ་འདི་བཞེས་ལ་ཕྱི་རུ་འགལ་རྐྱེན་རིགས་རྣམས་ཚར་གཅོད་ཅིང་",
    "ཞི་བའི་ཕྲིན་ལས་འགྲུབ་པར་མཛོད"
  ]
