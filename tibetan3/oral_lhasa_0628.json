    "སྨོན་བསྐྱེད་པ་བརྩོན་འགྲུས་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པརགྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོནབརྒྱ་དཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྨོན་བསྐྱེད་པ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "ཤེསརབ་ཀྱིཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོན་བམྱེད་ཅེས་བྱབར་རྣམ་བར་རྟོག་པར་མི་འགྱུར།",
    "སྨོནཔ་མྱེད་པ་ཤེསར་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྐྱེ་བརྒྱད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་བ་སྐྱེ་བསྐྱོད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར།",
    "བརྩོན་འགྲུས་ཀྱིཕ་རོལད་ཏུ་ཕྱིནང་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེབ་མྱེད་བ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕརོལ་ཏུ་ཕྱིནཔ་འགག་བསྐྱེ་དཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་བསྐྱེདཔ་སྦྱིནཔའིཕ་རོལ་ཏུ་ཕྱིནཔ་ཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕརོལ་ཏུ་ཕྱིན་བ་འགག་པ་མྱེད་ཅེས་བྱབར་རྣམ་པར་རྟོག་བརམྱི་འགྱུར།",
    "བརྩོན་འགྲུས་ཀྱིཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་པསྐྱདཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་བ་མྱེད་པ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱིསཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་བམྱེདཅེས་བྱབར་རྣམ་པར་རྟོག་པརམྱ་འགྱུར།",
    "འགག་བམྱེདཔ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཤིས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་བམྱེད་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པཞེས་བྱབར་རྣམ་པར་རྟོག་པརམྱི་འགྱུར་རོ།",
    "སྦྱིན་པའིཕ་རོལ་ཏུ་ཕྱིན་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཤི་བ་བརྩོན་འགྲུས་ཀྱིཕ་རོལ་ཏུ་ས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཤེསརབའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྦྱིན་པའི་བ་ན་པོན་ཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "བཟོད་པའི་ཕརོལ་ཏུ་ཕྱིན་བདབེན་ཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེནཔ་བཟོདཔའི་ཕ་རོལ་ཏུ་ཕྱིན་བཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྗེ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཁས་གཏན་གྱི་འརོལ་ཏུ་ཕྱིན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མིའགྱུར།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏིུན་པ་དབེན་ཞེས་བྱབར་རྣམ་པར་རྟོག་བར་གྱི་འགྱུར།",
    "དབེ་བ་ཤེས་རབཀྱི་རོལ་ཏུ་བྱིན་པཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "སྟོང་པ་ཉི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་སྟོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཕྱིན་བསྟོང་པ་ཉིདི་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཕྱི་ནང་སྟོང་བ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱའགྱུར་རོ།",
    "ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྟོང་པ་ཉིད་འདུས་བྱས་སྟོང་པཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར།",
    "སྟོང་པ་ཉིད་འདུས་མ་བྱས་སྟོང་ར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའལས་འདས་པ་སྟོདཔ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་མཐའ་ལས་འདས་པ་སྟོངཔ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཐོག་མངང་ཐམ་མེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོརབ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉད་སྟོངཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྟོང་པ་ཉིད་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་མྱི་དམིགས་པསྟོང་པ་ཉི་དཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པ་མྱེད་པ་སྟང་ངར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དངོས་པོ་མྱེད་པ་བྱ་བར་རྣམ་པར་རྟོག་པརམི་འགྱུརརོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར།",
    "སྟོང་པ་ཉིད་ངོ་བོ་ཉིད་སྟོངཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "དངོས་བོ་མྱེད་པའིངོ་བོ་ཉིད་སྟོང་ངཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་བ་ཉིད་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟག་པར་མྱི་འགྱུར་རོ། ནང་སྟོང་བ་ཉིད་མཚནམ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར་རོ།",
    "ཕྱི་སྟང་པ་ཉིད་མཚནམ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ནང་སྟོང་པ་ཉིད་མཚན་མམེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཕྱི་ནང་སྟོང་བཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་མཚན་མམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚནམམྱེདཔ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་། མཚནམ་མྱེ་ད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚནམ་མྱེདཔཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པརརྟོག་པར་མི་འགྱུར་རོ།",
    "མཚནམཆེད་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀའགྱུར་རོ།",
    "འཇུས་བྱས་སྟོང་པ་ཉིད་མཚནམ་མེདཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "མཚནམམྱེདཔ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱའགྱུར་རོ།",
    "མཐའལས་འངས་པ་སྟོང་པ་ཉིང་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་མཚན་མ་མྱེད་པ་མཐའ་ལས་འདས་པ་སྟོང་བ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྭ་མྱི་འགྱུར་རོ། ། ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་མཚན་མ་མྱད་ཅེས་བྱུང་རྟོག་པར་མྱ་འགྱུར།",
    "མཚན་མ་མྱེད་བ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱ་འགྱུར།",
    "མཚན་མ་མྱེདཔརང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མཚནམ་མྱེད་བཅོས་ཐམས་ཅད་སྟོང་པ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།་",
    "རྣམ་བར་རྟག་པར་མྱྀ་འགྱུར།",
    "མཚན་མམྱེད་པ་དངོས་པོ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་བཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མྱ་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ངོ་བོའདི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མ་འགྱུར་རོ།",
    "དངོས་པོ་སྐྱེད་པའི་ངོ་བོ་ཉིདར་རྣམ་པར་རྟོག་བར་མྱྀ་འགྱུར།",
    "བོ་སྐྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པརཏོག་པར་མི་འགྱུརརོ།",
    "ནང་སྟོང་པ་ཉིད་སྨོནཔ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་འགྱུར།",
    "དཅེས་ཁྱབ་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ས་བྱབར་རྣམ་པར་རྟོག་པ་ར་མྱ་འགྱུར།",
    "སྐྱོནཔ་བྱེད་པ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྨྱོན་པ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་བྱེད་པཆེན་པོ་སྟོསབྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྨོན་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མྱ་འགྱུར།",
    "སྨོན་པ་ཆྱེད་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྨོན་པ་བྱེད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་། བར་མི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་འངུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པརམྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་བ་ཉིད་སློན་བམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མེད་པ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱབ་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་མྱེད་པམཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ་ཐོག་མ་དུབར་མྱེདཔ་སྟོང་པ་ཉིད་སྨོན་བསྐྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "སྨོན་པ་མྱེདཔ་ཐོག་མ་དང་ཐམ་མེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པརརྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་སྨོན་བསྐྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར་སྨོན་བཀྱེད་པ་དོར་བརྩེསྟོང་པ་ཉིདཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུརརོ།",
    "སྨོན་པ་བྱེདཔར་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར་རོ།",
    "མྱི་དམྱགས་པ་སྟོང་པ་ཉིད་སྨོན་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོནཔ་མེད་བསྐྱིད་མུག་པ་སྟོ་ད་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་སྨོན་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིང་ཅེས་བྱབང་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་བ་ཉིང་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དངོས་པོ་མེད་པའི་ངོབོ་སྨོན་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར།",
    "སྐྱེ་བམྱིད་པ་ནང་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་སྐྱོ་བཀྱེདཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་བྱ་སྟོང་བ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྐྱེབཀྱེ་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་དོན་དམ་པ་སྟོངབ་ལ་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་བ་ཉིད་སྐྱེབ་སྐྱེ་དཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བསྐྱེད་པ་འདུས་བྱས་སྟོང་བ་ཉིད་ཅེས་བྱ་བར་རྣམ་བར་རྙོག་པར་མི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པཉིད་སྐྱེ་བ་དཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེབཆོད་པ་འདུས་མ་བྱས་སྟོངཔ་ཉིད་ཅེས་བྱ་བར་རྣམ་པརརྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེདཔ་མཐའལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་ཕྱི་འགྱུར་རོ།",
    "། ཐོག་མ་དང་ཐམ་མྱེད་པ་སྟོང་བམེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཐོགམ་དང་མམྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར་རོ།",
    "དོར་བ་མྱེདཔ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེདཅེས་བྱ་བ་རྣམ་ཕར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བགྱེད་པ་དོར་བམྱེད་བ་སྟོང་པ་ཉི་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྐྱེ་བསྐྱེདཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བམྱེད་པ་མ་ད་མྱགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོམྱེད་བསྟོང་པ་ཉིདི་སྐྱེ་བམེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བམེད་པ་ས་པོམྱེདཔའི་ངོ་བོ་འདི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་འགག་པ་མྱེ་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཐོག་མ་དང་ཐ་མ་ཀྱེད་པ་སྟོངས་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པརམྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཐོག་མ་དངཐམ་མྱེད་པ་སྟོང་པ་ཉིང་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འགག་བམྱེད་བ་དེར་བསྐྱེད་བསྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཅེས་བྱ་རྣམ་པར་རྟོག་པར་པར་འགྱུརརོ།",
    "མྱགས་པ་སྟོང་པཏིང་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འགུགཔམེདཔ་དངོས་པོབྲཱཉིང་སྟོང་པ་ཉིད་འགུག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "འགག་པ་མྱེད་པ་དངོས་པོ་མྱེད་པའི་ངོབོ་ཞིིང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པརརྟོག་པར་མི་འགྱུར་རོ།",
    "ནང་སྟོརབ་ཉིདཞིཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཞིབ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པརརྟོག་པར་མི་འགྱུར་རོ།",
    "སྟོང་བ་ཉིང་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀའགྱུར།",
    "ཞིབ་དོན་དམ་པ་སྟོང་བཉིདཅེས་བྱ་བ་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིང་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞིབ་འབུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞིབ་མཐའལས་འདས་པ་སྟོ་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར་རོ།",
    "ཐོགམ་དང་ཐམ་སྐྱེད་པ་སྟོང་བཉིད་ཞི་ཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞིབ་ཐོག་མ་དངཐ་མ་མྱེད་པ་སྟེང་པ་ཉིང་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དོར་བམྱེདཔ་སྟོང་པ་ཉིདཞི་ཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཞི་བ་རང་བཞིན་སྟོང་པ་ཉིང་ཅེས་བྱ་བར་རྣམ་ཁར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཞིབ་སྐྱིད་རྩིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོམྱེད་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་དངོས་པོ་མྱེ་བསྟོང་བཉིངཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཞིབ་ངོ་བོ་ཉིད་སྟོང་བ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོདཔ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞིབ་དངོས་པོམྱེད་པའི་དོབོ་ཉིད་སསྟོང་པ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་ར་རྟོག་པར་མྱ་འགྱུར།",
    "ཕྱི་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་ཕྱི་སྟོང་བ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་ཕྱི་ནང་སྟོང་བ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོདཔ་ཉིད་སྟོད་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར།",
    "དབེན་པ་སྟོང་པ་ཉིད་སྟོད་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "དབེན་བ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱབར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེནབ་དོན་དམ་པ་སྟོང་བ་ཉིང་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དབེན་བའདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིང་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "དབེནཔ་འངུས་མབྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "མཐའལས་འདས་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པམཐའ་ལས་འངས་བ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོགམ་དང་ཐམ་མྱེད་པ་སྟོད་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དོར་བམྱེད་པ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྕོང་པ་ཉིད་དཔོན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་ནམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དབེན་པ་དངོས་པོ་སྐྱེད་པ་སྟོངབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་བ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་ཀྱིའགྱུར་རོ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུརདབེན་པ་དངོས་བོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་བ་ཉིད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དྲནབ་ཉེ་བརག་ཞག་པ་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྟོང་བཉིད་དྲན་བཉེ་བརག་ཞག་བརྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ་། དྲན་པ་ཉེ་བར་གཞག་པརྣམསམཚན་མ་མྱེད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མམྱེད་པདྲན་བ་ཉེ་འརག་ཞག་པརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་དྲན་པ་ཉེབར་གཞག་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྐྱེ་བམྱེད་པ་དྲན་པ་ཉེཔར་གཞག་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "འགག་པམྱེད་པདྲན་པ་ཉེ་བར་གཞག་པརྣམས་ཤེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པརྣམས་ཞིཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཞིབ་དྲན་པ་ཉེ་བརགཞུག་པ་རྣམས་ཞེས་བྱ་བརརྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་བརྣམས་དབེན་ཞེས་བྱབ་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "བདྲན་པ་ཉེ་བརགཞག་པརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱེ་འགྱུར།",
    "སྟོང་པ་ཉིང་ཡང་དག་པར་སྔོང་བརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དྲག་པར་སྤོང་བརྣམས་མཚན་མ་མྱོད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚནམ་མྱེད་པ་ཡང་དག་པར་སྤོང་བརྩམས་ཞེས་བྱབར་རྣམ་བར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་མྱེད་པ་ཡང་དག་པར་སྤོང་བརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སློང་བ་རྣམས་སྐྱེ་བསྐྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མི་འགྱུར།",
    "སྐྱེ་མྱེད་པ་ཡང་ངག་བར་སྤོང་བ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བརྣམས་འགག་པམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "འགག་པ་མེད་པ་ཡང་དག་པར་སྡོད་བ་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་བར་སྤོང་བ་རྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཡངདག་པར་སྡོང་བརྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར།",
    "དབེན་པ་ཡངདག་པར་སྤོང་བརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུརརོ།",
    "སྟོང་པ་ཉིད་རྫུའཕྲུལ་གྱི་རྐང་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱབ་རྣམ་པར་རྟོག་པ་དམི་འགྱུར།",
    "ཛུའཕྲུལ་གྱི་རྐང་པ་རྣམས་མྱེད་ཅེས་བྱབར་རྣམ་པ་རྟོག་པར་མི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རྫུ་འཕྲུལ་གྱིཤོང་པ་རྣམས་ཞེས་བྱབར་རྣམ་པར་རྟོག་པརམྱི་འགྱུར་རོ།",
    "སྐྱོ་བསྐྱེད་པ་རྫུ་འཕྲུལ་གྱིན་པ་རྣམས་ཞེས་བྱ་བརརྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཛྫུའཕྲུལ་གྱིད་རྣམས་འགག་པ་སྐྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མིའགྱུར།",
    "འགག་བསྐྱེད་བརྫུའཕྲུལ་གྱི་རྐང་བརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "རྫུའཕྲུལ་གྱི་རྐང་བརྣམས་ཞིཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུརཞིགརྫུ་འཕྲུལ་གྱི་རྐང་བརྣམས་ཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པརྣམས་དབེན་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་རྫུ་འཕྲུལ་གྱི་དངས་རྣམས་ཞེས་བྱབར་རྣམ་པར་རྟོག་པ་མྱ་འགྱུར་རོ།",
    "སྙན་པསྐྱེད་པ་དྲབང་པོ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོབས་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་བ་ཉིད་སྟོབས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོ་བས་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚནམ་མྱེདཔ་སྟོབས་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་སྨོན་པ་མེདཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོནབམྱེདཔ་སྟོབས་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་པས་འགག་བཅདཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་བ་བྱེད་པ་སྟོབས་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་ནི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞིབ་སྟོབས་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱའགྱུར།",
    "དབེན་པ་སྟོབས་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་གྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྨོནཔ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་སྐྱོག་ཁར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱུད་བ་སྐྱེ་བམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར།",
    "སྐྱེ་བམྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལས་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་ར་མྱ་འགྱུར།",
    "འགག་བ་མྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱདཔ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བའཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "དབེན་པ་རཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་འཕགས་པའི་བདེན་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "འཕགས་པའི་བདེན་པ་རྣམས་སྨོན་པ་མྱེད་ཅེས་བྱར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པམྱེད་པའཕགས་པའི་བདེན་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྐྱེ་བ་མྱེདཔ་འཕགས་པའི་བདེ་ན་བ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་བདེནཔ་རྣམས་ལགག་པ་སྐྱེ་དཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་སྐྱེད་པའཕགས་པའི་བདེན་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "ཞིབ་འཕགས་པའི་བདེན་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་དབེན་ཞེས་བྱ་བང་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར།",
    "དབེན་པ་འཕགས་པརྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྨོནབམྱེད་པབསམ་གཏན་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར་རོ།",
    "བསམ་གཏན་རྣམས་སྐྱེ་བམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བསྐྱེ་དབ་བསམག་མས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏནརྣམསའགག་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་བསམ་གཏན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏའ་རྣམས་ཞིཞེས་བྱ་བར་རྣམ་པར་རྟག་པར་མྱྀ་འགྱུར།",
    "བསམ་གཏན་རྣམས་དབེར་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར།",
    "དབེན་པ་བསམ་གཏན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བྱ་བར་རྣམ་པར་རྟོག་པ་མྱི་འགྱུར་རོ།",
    "མཚན་མ་མྱེད་པ་ཚད་ར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར་རོ།",
    "སྐྱེ་བམྱེད་བཚང་མྱེད་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཚང་མྱེད་པ་རྣམས་འགག་པ་མྱེད་ཅེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམསསྟོད་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་གཟུགས་མྱེད་བའི་སྙོམས་པར་འཇུག་བརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "གཟུགས་མྱེདཔའི་སྙོམས་པར་འཇུག་བརྣམས་མཚན་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་ཆུ་འགྱུར།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་སྨོནཔ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་བརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པ་ར་མྱི་འགྱུརརོ།",
    "གཟུགས་དབའི་སྙོམས་པར་འཇུག་པརྣམས་ལག་པ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མྱ་འགྱུར།",
    "འགག་བམྱེད་པགཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུརརོ།",
    "གཟུགས་མྱེདཔའི་སྙོམས་པ་བརྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པ་གྱི་འགྱུར།",
    "ཞིང་གཟུགས་མྱེད་པའི་སྙོམས་པརའཇུག་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བརམྱ་འགྱུར་རོ།",
    "དབེན་བ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་ཀྱི་རྟོག་པར་མི་འགྱུར་རོ།",
    "རྣམ་པར་ཐར་བ་བརྒྱད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "རྣམ་པརཐར་བ་བརྒྱད་སྨོན་པསྐྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "རྣམ་པར་ཐརཔ་བརྒྱད་སྐྱེ་བམྱིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེདཔ་རྣམ་བར་ཐར་བ་བརྒྱད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར་རོ།",
    "རྣམ་པར་ཐརབ་བརྒྱད་འགག་པམྱེད་ཅེས་བྱ་པར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར།",
    "རྣམ་པརཐར་བ་བརྒྱད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "རྣམ་པར་ཐརང་བརྒྱད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་རྣམ་པར་ཐར་བ་བརྒྱད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར་རོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་༦། ། སྦྱོང་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་བར་མྱ་འགྱུར།",
    "སྟོང་པ་ཉིད་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ་བརརྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མཐར་ཁྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུམཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མྱི་འགྱུར།",
    "མཚན་མཆྱེདཔ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྨོན་པམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིའགྱུར།",
    "སྨྱོན་བམྱེད་པ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་ཁར་འཇུག་པ་དགུ་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྐྱེ་བ་སྐྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བམྱེད་པ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "འགག་བ་མྱེད་པ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པརའཇུག་པདགུའིཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཞིབམཐར་ཀྱིས་གཞས་པའ་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར་རོ་མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ་བར་རྣམ་པར་རྟག་པར་མྱའགྱུར།",
    "དབེན་པ་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཤེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱ་འགྱུརརོ།",
    "སྨོན་བ་མྱེད་པ་མཚན་མ་སྐྱེད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར།",
    "རྣམ་པར་ཐར་བའི་སྒོ་སྟོང་བ་ཉིད་དང་།",
    "སྨོན་པམྱེད་པ་བར་རྣམ་པརརྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་མྱེད་བ་སྐྱེ་བཀྱེདཅེས་བྱ་བར་རྣམ་པ་ར་རྟོག་པརམྱི་འགྱུར།",
    "སྐྱོན་བམེད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "སྨོན་བ་མྱེད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་སྐྱེད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "རྣམ་པར་ཐར་བའི་སྒོ་སྟོང་པ་ཉིད་དང་།",
    "སྨོན་པ་མྱེད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མ་ངོན་པར་ཤེས་པ་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་བར་གྱི་འགྱུར།",
    "མངན་པར་ཤེས་བརྣམས་འགག་པ་བྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར།",
    "དབེནཔམངོན་བར་ཤེས་པ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཏིང་ང་འཛིན་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་བ་ཉིད་ཏིངངེ་འཛིན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བརརྣམ་པར་རྟོག་བར་མྱ་འགྱུར།",
    "མཚནམ་མྱེད་བ་ཏིང་ངེ་འཛན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱྀ་འགྱུར།",
    "སྨོན་པཆྱེད་པ་ཏིང་ངེའཛིན་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཏིརི་ངེ་འཛིན་རྣམས་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བམྱེད་པ་ཏིང་ངེ་འཛིན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འགུག་བསྐྱེད་པ་ཏིང་ངེ་འཛིན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མ་འགྱུར།",
    "ཞི་བ་ཏིང་ངེ་འཛིན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།་",
    "ཏིང་ངེ་འཛིན་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཏརི་ངེ་འཛིན་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོངཔ་གཟུངས་ཀྱི་སྒོ་རྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར་རོ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་མཚན་མ་མྱེདཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་གྱི་འགྱུར།",
    "གཟུངས་རྣམས་སྨོན་པ་མེད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར།",
    "སྨྱོན་བསྐྱེདཔ་གཟུངས་ཀྱི་སྒོ་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར་རོ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་འགག་བམྱེད་ཅེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར།",
    "འགག་པ་མྱེད་པག་ཟུངས་ཀྱི་སྒོརྣམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་གཟུངས་ཀྱི་སྒོ་རྣམས་ཞིཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་གྱུར།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་དབེནཔ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་སྟོད་ཞེས་བྱབར་རྣམ་པར་རྟོག་པརགྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྨོན་པ་བྱེད་པ་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བརུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱའ་གྱུར།",
    "སྐྱེབ་སྐྱེད་པ་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུརརོ།",
    "འགག་པ་མྱེདཔདེབཞིནིགཤེགསཔའིསྟོབསབཅུཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུའི་ཞེས་བྱ་བར་རྣམ་པས་རྟོག་པར་མྱ་འགྱུར།",
    "ཞིབ་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་དེ་བཞིན་གཤེགས་པའི་སྟོབ་ས་བཅུ་ཞེས་བྱ་པར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མི་འཇིགས་པ་བཞི་སྟོད་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱིད་གྱུར།",
    "སྟོདཔ་ཉིད་མི་འཇིགས་པ་བཞི་ཞེས་བྱ་བརརྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མཚནམ་བྱེད་པ་མྱ་འཇིགས་པ་བཞིཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་མྱེད་པ་མྱི་འཇིགས་པ་བཞི་ཞེས་བྱ་བར་རྣམ་པརརྟོག་པར་མྱྀ་འགྱུར་རོ།",
    "མྱི་འཇིགས་པ་བཞི་སྐྱེ་བམེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བསྐྱེད་པ་མྱ་འཇིགས་པ་བཞིཞས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "མི་འཇིགས་པ་བཞི་འགག་པ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མྱི་འཇིགས་པ་བཞི་ཞིའི་ཁྱབརན་ར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་མྱ་འཇིགས་པ་བཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུརརོ།",
    "མྱི་འཇིགས་པ་བཞིདབེན་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་མྱ་འཇིགས་པ་བཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པ་པ་གྱུར་རོ།",
    "སྟོང་པ་ཉིདསོ་སོ་ཡང་དག་བར་རིག་བ་བཞི་ཞེསབྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར་རོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་མཚན་མ་མྱེད་ཅེ་བས་རྣམ་པར་རྟོག་བརམྱི་འགྱུར།",
    "སྐྱེ་བམྱོད་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སོ་སོ་ཡང་དགཔར་རིག་པ་། བའི་ཞི་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མི་འགྱུར།",
    "ཞིབ་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "སྲོ་སོ་ཡངདགུ་པར་ཆིག་པ་བཞི་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དཔེནཔསོསོ་ཡང་དག་པར་རིག་པ་བཞིཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མི་འགྱུར་རོ།",
    "བྱམས་ཕ་ཆེན་པོ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར།",
    "སྟོད་པ་ཉིདེ་བྱམས་པཆེན་པོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བྱམས་པ་ཆེནཔོ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "སྨོན་པ་མྱོདཔ་བྱམས་པཆེན་པོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བྱམས་བཆེན་པོ་འགག་བམྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགྲག་པ་མྱེ་དཔ་བྱམས་པཆེན་པོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཞིབ་ཉམས་བཆེན་པོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བྱམས་པཆེན་པོ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དབེན་པ་བྱམས་བཆེན་པོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འགག་པ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིདི་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འཁྲས་བུ་མཆཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར།",
    "མཚན་མམྱེད་བརྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར་རོ།",
    "རྒྱུན་ཏུ་ཞུགས་ན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རྒྱུན་ཏུ་ཞུགས་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "སྐྱེ་བ་མྱིད་བ་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་བར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "འགག་བམྱེདཔ་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟག་པར་མྱི་འགྱུར་རོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱྀ་འགྱུར།",
    "ཞིབ་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར་རོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུམཚན་མ་མྱེདཅེས་བྱ་བར་རྣམ་པར་རྟོག་བར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་མེད་པ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ་། ལན་ཅིག་ཕྱིར་ལོང་བའི་འབྲས་བུ་སྟེ་བམེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་འགག་པ་མྱེ་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱ་འགྱུར།",
    "འགག་པ་བྱེད་པ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་འགྱུར་རོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུའིཞེས་བྱབར་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "ཞི་བ་ལནཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་བ་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "ཕྱིར་མྱི་འོ་བའི་འབྲས་བུ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
