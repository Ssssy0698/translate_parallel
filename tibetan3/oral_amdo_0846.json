    "གང་གི་ཚེ་གཉིས་པོ་འདིར་མི་འགྱུར་ཞེ་ན།",
    "༢༡ཡུ་༡༤༢ ༤གང་གི་ཚེ་ཞེ་ན་ཤ་ཟ་ལ་སོགས་པ་གཞན་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་རྒྱུ་གཞན་ཡོད་ན།",
    "དེ་ལྟ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་སྲོག་ལ་སོགས་པ་དང་ལྡན་པ་ཉིད་ཅི་ལྟར་ལྡོག་པ་ཅན་མ་ཡིན་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེས་གསུངས་སོ།",
    "རང་གི་བདག་ཉིད་དམ་རྒྱུའི་དངོས་པོར་གྲུབ་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ན་ཞེས་བྱ་བ་ནི་རང་གི་བདག་ཉིད་ལ་སོགས་པ་མ་གྲུབ་པས་ནའོ།",
    "ཁྱད་པར་ཐུན་མོང་མ་ཡིན་པ་ལ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་གཉི་ག་མེད་དོ།",
    "དེས་ཞེས་བྱ་བ་ནི་རང་གི་བདག་ཉིད་ལ་སོགས་པར་མ་གྲུབ་པས་ནའོ།",
    "བདག་ལྡོག་པར་བྱེད་པ་ཉིད་མ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་བདག་ལྡོག་པ་ལ་ནི་སྲོག་ལ་སོགས་པ་ལྡོག་པས་ཁྱབ་པ་འགྲུབ་པོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་མཐུན་ཕྱོགས་ཀྱི་ཁྱབ་པ་མེད་པར་ལྡོག་པའི་ཁྱབ་པ་མི་འགྲུབ་པ་དེའི་ཕྱིར་རོ།",
    "༡༤༢༧ཡིན་ལ་བདག་གི་སྒྲས་ནི་རང་བཞིན་བཟུང་བ་ཡིན་ནོ།",
    "བདག་རྟོགས་པ་མེད་ན་ཡང་མིག་ལ་སོགས་པ་དེ་མ་རྟོགས་ན་བདག་གི་རང་བཞིན་དང་།",
    "དེའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་བདག་གི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་རང་བཞིན་ཞེས་བྱ་བ་ནི་བདག་གི་རང་བཞིན་ནོ།",
    "འོན་ཏེ་བུམ་པ་ལ་སོགས་པ་ལ་བདག་གིས་དབེན་པར་ིདམིགས་པས་དེ་མེད་པར་ངེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ནི་བདག་གི་དབེན་པར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་དུ་ཟད་མོད་དེས་ཅིར་འགྱུར་ཞེ་ན།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་ཁྱབ་པ་འགྲུབ་པ་ཉིད་ཀྱིས་སོ།",
    "མཐོང་བ་དག་གིས་ཏེ་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་ཉིད་ཀྱིས་ཏེ།",
    "ཐལ་བ་ལྡོག་པ་བརྗོད་པ་ནི།",
    "རང་གི་རིགས་དེ་ཉེ་བར་ལེན་པའི་རྒྱུ་ལས་བྱུང་བ་ཡིན་ནོ།",
    "༧༢༡༡༤༣༢ནོ་། ཕན་ཚུན་ལྟོས་པའི་རྒྱུ་དང་རྐྱེན་གྱི་ཚོགས་པ་དེ་ཙམ་ལས་ེབདག་གི་མཐོང་བའི་དངོས་པོའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ལ་བརྟེན་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་འདིར་བདག་ཉེ་བར་སྦྱོར་བ་མེད་དུ་ཆུག་མོད།",
    "གང་གིས་ཞེས་བྱ་བའོ།",
    "བདག་གཞན་གྱིས་མྱོང་བ་ལ་ཡང་བདག་གཞན་གྱི་དྲན་པ་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ཡིན་དང་ཞེས་བྱ་བ་ནི་ཐུན་མོང་དུ་རྟོགས་པ་ནའོ།",
    "འོན་ཏེ་དྲན་པ་ལ་སོགས་པ་ནི་བདག་གིས་བྱིན་གྱིས་བརླབས་པར་རྟོགས་པའི་ཕྱིར་ཅི་ལྟར་དེར་མི་རྟག་སྙམ་ན་དྲན་པ་ལ་སོགས་པ་ནི་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་གནས་སྐབས་ཀྱི་ཚོགས་ཉིད་ལུས་ཡིན་པ་དེ་ཉིད་ཀྱི་ཕྱིར་ངེད་༧ཀྱི་ཕྱོགས་གྲུབ་པ་ལ་གནོད་པ་མེད་དོ།",
    "གང་གི་ཕྱིར་དྲན་པ་འབྲས་བུ་ཡིན་པ་དེས་ན་མྱོང་བ་ལས་ཅི་སྟེ་མ་ཡིན་ཏེ་བདག་ཁས་བླངས་པས་ཅི་ཞིག་བྱ།",
    "དེ་ཡང་བདག་གི་འབྲས་བུ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ཉིད་ཅེས་བྱ་བ་ནི་བདག་གིའོ།",
    "གཅིག་ཏུ་རྟོགས་པ་ཞེས་བྱ་བ་ནི་མཐོང་བ་སྔ་མའི་ཡུལ་ཉིད་བདག་གིས་རྟོགས་སོ་ཞེས་བྱ་བ་བདེན་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "ཡིན་མོད་དེ་ལས་ཅིར་འགྱུར་ཞེ་ན།",
    "གཏན་ཚིགས་མི་མཐུན་པའི་ཕྱོགས་ཉིད་ལས་རྣམ་པར་འཆད་༤པ་ཞེས་བྱ་བ་ལྡོག་པའི་ཚིག་གིས་མཐུན་པའི་ཕྱོགས་ལ་གནས་པ་ཉིད་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ཕྱིར་ཞེས་བྱ་བ་ནི་དོན་གྱིས་གོ་བས་ཡོད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ན་ཁྱེད་ཀྱིས་ཀྱང་ལྡོག་པ་བསྟན་པ་གཅིག་གིས་༧ རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་གཉི་ག་བསྟན་པར་བྱ་བས་ེསོ།",
    "རྩེ་༢༡༡༤༣༨གིས་ཀྱང་གཉི་ག་བསྟན་པར་བྱས་པ་ཡིན་ནོ།",
    "མེད་པ་ལ་ནི་འགའ་ཞིག་དང་ལྡན་པ་སྔོན་དུ་སོང་བའི་བྲལ་བ་མེད་པའི་ཕྱིར་ན།",
    "གོར་མ་ཆག་པར་མེད་པ་ཉིད་ཡིན་མོད།",
    "གལ་ཏེ་གང་གིས་རྣམ་པ་གཞན་མེད་པར་འགྱུར་བ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་གང་གི་རྣམ་པ་གཞན་མེད་པ་ཉིད་དུ་འགྱུར་བ་ཅི་ལྟར་ན་གཞན་དེའི་ངོ་བོར་མེད་ཅེ་ན་དངོས་པོའི་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་གང་གིས་ཡོངས་སུ་གཅོད་པར་འགྱུར་བ་ཚིག་བཞིན་དུ་དེའི་ཡུལ་ཅན་གྱི་བློར་ཡང་ཅི་ལྟར་འགྱུར་ཞེ་ན།",
    "གཞིའི་ངོ་བོར་ཡུལ་དུ་བྱེད་མོད་སྙམ་ན།",
    "གང་གི་ཕྱིར་ཕྱི་རོལ་ལ་བརྟེན་པའི་དགག་བསྒྲུབ་ཀྱི་ཐ་སྙད་མི་འཐད་པ་དེའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་ཕྱི་རོལ་ལ་རྟེན་པ་མིན་པས་སོ།",
    "གང་གི་ཕྱིར་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་བརྟེན་པས་སོ།",
    "གཉི་གའི་ཐུན་མོང་པ་ཡིན་པས་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "འོ་ན་ཅི་ལྟར་སྒྲའི་དོན་གཉི་གའི་ཐུན་མོང་བ་ཡིན་ཞེ་ན།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེས་ན།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གཉི་ག་ལ་ཐུན་མོང་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་དམིགས་པ་ཕྱི་རོལ་གྱི་རང་བཞིན་དུ་མེད་པར་སྟོན་པར་བྱེད་དེ།",
    "རང་རིག་པ་ཞེས་བྱ་བའོ་འདི་ཉིད་གཞུང་འཛུགས་པ་ནི་རང་གི་ཞེས་བྱ་བའོ།",
    "ཐུག་པ་མེད་པས་རང་གི་ངོ་བོས་ེལས་དམས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་གིས་རང་གིས་ངོ་བོ་ལས་ཉམས་པར་ཐཱའབྲུའགྱུར་བ་ཅི་ལྟར་ཐུག་པ་མེད་ཅེ་ན།",
    "དངོས་པོ་ཉེ་བར་ལེན་པ་ཅན་ཉིད་ཀྱང་དགག་པར་མི་འཐད་དོ་ཞེས་བརྗོད་པའི་དོན་དུ་རང་གི་ངོ་བོར་ཞེས་སྨྲས་སོ།",
    "དངོས་པོའི་ཉེ་བར་ལེན་པ་ཅན་དགག་པའི་གཞིར་གྱུར་པ་ཡང་རང་གི་ངོ་བོས་ཞེས་བྱ་བ་དངོས་པོའི་ཉེ་བར་ལེན་པ་ཅན་མ་ཡིན་པའི་རང་བཞིན་དུ་རྟོགས་པས་ན་སྟེ།",
    "ཕྱི་དང་ནང་གི་རང་བཞིན་དག་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཕྱི་དང་ནང་གི་རང་བཞིན་དང་བྲལ་བ་ཉིད་ཡིན་ན་རང་བཞིན་མེད་པ་ཁོ་ན་མ་ཡིན་ནམ།",
    "ཅིའི་ཕྱིར་ཐ་སྙད་འདི་ཕྱི་དངང་ནང་གི་རང་བཞིན་ལ་བརྟེན་པ་མ་ཡིན་ཞེ་ན།",
    "སྒྲ་ོཞེས་བྱ་བའོ་དེ་ལས་ཞེས་བྱ་བ་ནི་ཕྱི་དང་ནང་གི་རང་བཞིན་ལས་མ་གཏོགས་པའོ།",
    "སྒྲོ་བཏགས་པའི་རང་གི་ངོ་བོ་ནི་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་ངོ་བོ་ཞེས་བྱ་བ་ནི་འཁྲུལ་པའི་རང་བཞིན་དུའོ།",
    "གལ་ཏེ་དེ་ཉིད་གཞན་གྱི་རང་གི་ངོ་བོར་རྟོག་ན།",
    "ལན་ནི་དེ་ཉིད་ཅེས་བྱ་བ་སྟེ་དོན་ལ་མ་རེག་པ་ཉིད་དོ།",
    "དོན་ལ་མ་རེག་པ་དེ་ཡང་སྣང་བ་ཁོ་ན་ཡིན་པས་ཅི་ལྟར་མི་བདེན་པས་། ཅིའི་ཕྱིར་ཞེ་ན།",
    "དོན་ལ་མ་རེག་ཀྱང་དོན་ལ་རེག་པ་ཉིད་དུ་ངེས་པ་སྐྱེད་པའི་ཕྱིར་མི་བདེན་པ་ཉིད་དོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "ཉིད་ཀྱི་ཚིག་གིས་ནི་དོན་ལ་མ་རེག་པ་བདེན་པར་བརྗོད་པའོ།",
    "གང་གིས་དེ་སྐྱེད་པས་དེའང་མི་བདེན་པར་འགྱུར་བ་ངེས་པ་ཡང་འཁྲུལ་པ་ནི་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གང་གི་ཕྱིར་སྒྲ་འཇུག་པའི་ཕྱིར་ཡོད་དོ་ཞེས་ཐ་སྙད་དུ་བྱེད་པ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "གང་གི་ཕྱིར་མེའི་སྒྲ་ལས་མེ་མ་ཡིན་པ་ལས་ལྡོག་པ་མ་ལྡོག་ཀྱང་།",
    "མེད་མོད་ཀྱི་དེ་ལྟ་ན་ཡང་ཐ་སྙད་ནི་འགྲུབ་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མ་བསྒྲུབས་པ་དང་མ་བཀག་པར་ཐལ་ཞེ་ན།",
    "གང་གི་ཕྱིར་དམིགས་པའི་རྣམ་པར་དབྱེ་བས་ཡོད་པ་རྣམ་པར་དབྱེ་བར་འགྱུར་བ་དེས་ནའོ།",
    "ཅི་གང་གིས་བསྡུ་བའི་ཞེས་བརྗོད་པ་རྣམ་པ་གཞན་ཡང་ཡོད་དམ་ཞེ་ན།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ལྡན་པ་རྣམ་པ་དུ་མ་ཡོད་པ་དེའི་ཕྱིར་སྐབས་འདིར་རོ།",
    "གང་གི་ཕྱིར་གནོད་བྱ་སྐད་ཅིག་མ་ཉིད་གནོད་པར་བྱེད་པ་སྔོན་པོ་ཉིད་དང་ལྷན་ཅིག་བསྡུས་པར་འོས་པ་མ་ཡིན་ནོ།",
    "སྐད་ཅིག་༦ གི་རང་བཞིན་དང་བྲལ་བར་བཟུང་ཡང་ཅི་ལྟར་དེས་༧བཀག་སྙམ་ན།",
    "གལ་ཏེ་རེས་འགའ་ནི་སྔོན་པོ་ངེས་པར་མི་འགྱུར་བ་དེའི་ཚེ་སྐད་ཅིག་ཉིད་ལ་གང་གིས་གནོད་སྙམ་ན་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གང་གིས་ཕྱིར་སྔོན་པོའི་རང་བཞིན་འཛིན་པས་ངེས་པ་༤ཡིན་ཡང་དེ་དང་ཐ་མི་དད་པའི་སྐད་ཅིག་གསལ་བར་མ་བྱས་སོ་ཞེས་བྱ་བར་ཡང་ཅི་ལྟར་འགྱུར་ཏེ་མ་ཡིན་པ་ཁོ་ནའོ།",
    "ཡུལ་གཅིག་གི་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་མོད་ཀྱང་ཞེས་བྱ་བ་ག་བ་ཉིད་མེད་ཀྱང་།",
    "གང་གི་ཚེ་ཞེས་བྱ་བའོ་། གཉི་ག་ཡང་ཞེས་བྱ་བ་ནི།",
    "མེ་དང་མེ་མ་ཡིན་པ་ལ་སོགས་པ་ཐུན་མོང་པའི་ངོ་ལས་གནོད་པར་བྱེད་པ་ཁོ་ནའོ།",
    "ཁྲ་བོ་ལ་སོགས་པ་ལས་གང་ཡང་རུང་བའི་བ་ལང་གི་གསལ་བ་ཡོད་དོ་ཞེས་རྟོགས་པར་འགྱུར་གྱི།",
    "འོན་ཏེ་སྤྱི་དོན་བྱ་བ་བྱེད་པ་མ་ཡིན་མོད།",
    "ཧ་ཅང་ཐལ་བ་བརྗོད་པ་ནི་ངེས་པ་ཐམས་ཅད་ཅེས་བྱ་བའོ།",
    "གང་གིས་དེ་མཐོང་བས་དེར་ཐེ་ཚོམ་དུ་འགྱུར་བ་གང་ཞིག་གང་ལ་སྲིད་པ་དང་འཁྲུལ་པ་ཡང་ཡིན་ཞེ་ན།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་སྔོན་པོའི་སྒྲས་ཁྱད་པར་གཅིག་གིས་ཁྱད་པར་དུ་བྱས་པའི་དོན་དེ་རང་གི་རང་བཞིན་དུ་རྟོགས་པར་བྱས་ནས།",
    "སྔོན་པོའི་སྒྲ་ལ་སྔོན་པོ་ཉིད་ཁུ་བྱུག་ལ་སོགས་པ་དང་མཐུན་པའམ་ཐུན་མོང་མ་ཡིན་པ་ཞིག་རྟོགས།",
    "བསྒྲུབ་པ་དང་དགག་པ་དག་གིས་མ་རེག་པའི་རང་བཞིན་གཞན་རྣམས་བཏང་སྙོམས་ལྟ་བུ་དང་ངོ།",
    "དེས་ན་གང་གིས་མེད་པར་འགྱུར་བ།་",
    "འཆད་པ་ནི་ཁོ་བོ་ཅག་གིས་ཞེས་བྱ་བའོ།",
    "ཕྱིན་ཅི་ལོག་གི་ཐ་སྙད་རྟག་པ་ཉིད་ཀྱི་ཐ་སྙད་དེ་མི་རྟག་པ་ཉིད་ཟིན་པའི་ཕྱིར་རོ།",
    "ཕྱིན་ཅི་ལོག་གི་ཐ་སྙད་ཀྱང་ཡུལ་ནི་རྟག་པ་ཉིད་དེ་དེ་བསལ་ཾབའི་ཕྱིར་ཏེ་བཟློག་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་གང་གིས་རྟོགས་སྙམ་ན།",
    "བདག་གིས་ངོ་བོར་རོ།",
    "གང་གིས་ཚེ་སྒྲ་རྟག་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་དེའི་ཚེ་སྒྲ་ལས་རྟག་པ་ཉིད་དེ་དང་བྲལ་བར་རོ།",
    "གང་གི་ཚེ་འཁྲུལ་པ་མ་ཞུགས་ཤེ་ན།",
    "གལ་ཏེ་ཡང་ཐེ་ཚོམ་དང་ཕྱིན་ཅི་ལོག་མེད་པ་དེ་ལྟ་ཡང་བཏང་སྙོམས་ཀྱི་ཡུལ་བཟློག་པ་ཉིད་སྒྲ་དང་རྣམ་པར་རྟོག་པ་དག་གི་ཡུལ་ཡིན་ནོ་། མེའི་རང་གི་ངོ་བོ་ཉིད་དོན་དུ་ཅི་སྟེ་མི་འདོད་ཅེ་ན།",
    "འོན་ཏེ་རང་གི་ངོ་བོ་མ་ཡིན་པ་ཡང་དེ་རྟོགས་སོ་ཞེ་གཞན་དུ་ཞེས་བྱ་བ་སྟེ།",
    "གང་གི་ཕྱིར་ཡང་དག་ེམ་ཡིན་ཡང་ཡང་དག་པ་ལྟ་བུར་སྟོན་པར་བྱེད་པ་དེས་རྣམ་པར་རྟོག་ིཔའམ་སྒྲའམ་ཐ་སྙད་དུ་བྱེད་པ་དེ་བསླད་པ་ཉིད་ཀྱང་ཤེས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་གིས་ནི་འཇིག་རྟེན་པའི་ལམ་གང་ཡིན་པ་དེར་གནས་པ་ན་བྱིས་པ་དང་།",
    "གང་གི་ཕྱིར་དེ་ལྟར་སྲོག་ལ་སོགས་པ་གཞན་ལས་ལྡོག་པར་མ་གྲུབ་པ་དེའི་ཕྱིར་རོ།",
    "དེས་ན་གང་གི་ཚེ་བདག་མེད་པ་འགའ་ཞིག་ལས་ལྡོག་པར་མཐོང་བ་དེའི་ཚེ་དོན་གྱི་སྲོག་ལ་སོགས་པ་བདག་དང་བཅས་པ་ཁོ་ན་ལ་ངེས་ཀྱི་མི་མཐུན་པའི་ཕྱོགས་ལ་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་རེ་ཞིག་བུམ་པ་ལ་སོགས་པ་མཐོང་བ་དག་ལ་མ་མཐོང་བས་བདག་མེད་པར་གྲུབ་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "འོན་ཏེ་གང་དུ་ལྡོག་པ་མཐོང་བ་དེར་མེད་མོད་ཡུལ་ལ་སོགས་པས་བསྐལ་པ་གཞན་ལ་གོ་ཅི་ལྟར་ཞེ་ན།",
    "གཅིག་གི་ངོ་བོར་ངེས་པ་ཉིད་དུ་ཞེས་བྱ་བ་སྟེ།",
    "གང་གིས་ཞེས་བྱ་བ་སྟེ་འགལ་བས་སོ།",
    "དེ་ལྟ་ཡིན་མོད་སྙམ་ན།",
    "ངེས་པ་དེ་ཡང་བདག་གི་འབྲས་བུའམ།",
    "བདག་གི་རང་བཞིན་གྱིས་ཡིན་པར་འགྱུར་ཏེ་གཞན་དུ་ངེས་པ་མི་འཐད་པའི་ཕྱིར་རོ་ེ།",
    "རྒྱུ་གང་གིས་ན་རིགས་པ་ཅན་དེ་ནི་ལྡོག་པ་མེད་པ་དངོས་པོར་འདོད་པ་མ་ཡིན་པས་སོ།",
    "གང་གིས་ཕྱིར་རང་གི་ཉེས་པས་དངོས་པོའི་དངོས་པ་ལ་སོགས་པ་ལ་འཁྲུལ་པ་ཅན་ནི།",
    "གཞན་ཡང་ཞེས་བྱ་བའོ་། འཇུག་པ་ནི་ཡང་ཞེས་བྱ་བ་ནི་དུ་བ་ལ་སོགས་པ་ནི་མེ་ཉིད་འཇུག་པར་བྱེད་པ་ནི་ཡིན་གྱི།",
    "སྒྲུབ་པར་བྱེད་པ་མཐོང་བ་དང་མ་མཐོང་བའི་མཚན་ཉིད་ཅན་མེད་པར་ཅི་ལྟ་བུར་གྱུར་པ་ཞིག་ཅེས་ན་རྗེས་སུ་འགྲོ་ལྡོག་དག་གི་སྒྲུབ་བྱེད་དུ་གྱུར་པའོ།",
    "ལྡོག་པ་ཡང་ཡོད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ཁྱོད་ཀྱི་ནི་བདག་མ་མཐོང་བ་ཡིན།",
    "ཡང་སྲོག་ལ་སོགས་པ་དེ་དང་འབྲེལ་པ་ལས་རྟོགས་པ་ཡིན་ན་སྲོག་ལ་སོགས་པའི་འབྲེལ་པ་དེ་ཡང་ཚོགས་པ་ཐ་དད་པ་ཁོ་ན་ལས་འབྲས་བུ་ཐ་དད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རང་བཞིན་གྱི་ངེས་པ་མེད་པར་མི་འགྲུབ་པོ་ཞེས་བྱ་བའོ།",
    "དོན་མི་འགྲུབ་པོ་ཞེས་བྱ་བ་ནི་བདག་གི་མཚན་ཉིད་ཀྱི་དོན་མི་ངེས་པའོ།",
    "བདག་གི་སྒྲུབ་པར་བྱེད་པ་དོགས་པ་ནི།",
    "ལན་ནི་དེ་སྐུལ་བར་བྱེད་པའི་རང་བཞིན་གྱི་བདག་གི་སྒྲུབ་པར་བྱེད་པ་དེ་ཡང་མི་རིགས་སོ།",
    "སྐར་ཁུང་གི་ནང་ན་ཞེས་བྱ་བའོ།",
    "བདག་ལ་ཡང་བྱེད་པ་ཡོད་མོད།",
    "དཔེར་ན་སྐར་ཁུང་གི་ནང་ནས་ལྟ་བའི་དཔེས་བདག་དང་པོ་འགྲུབ་པ་དེ་བཞིན་དུ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མེད་པས་ཐ་དད་པ་དང་ཐ་མི་དད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་རོ།",
    "གང་གི་ཡང་ཞེས་བྱ་བ་ནི་སྲོག་ལ་སོགས་པའིའོ།",
    "རང་བཞིན་གང་གིས་ཞེས་བྱ་བ་ནི་མེ་མ་ཡིན་པའི་རང་བཞིན་གྱིས་སོ།",
    "དེ་ལྟར་དེ་དག་གི་རང་བཞིན་ངེས་པ་ཡིན་ནོ།",
    "དཔེར་ན་འབྲས་བུ་དུ་བ་རང་གི་མཐོང་བ་འབྲས་བུར་གྱུར་པ་ཡོད་ན་རྟོགས་པ་དེ་བཞིན་དུ་འབྲས་བུ་༧གྱུར་པའི་རྟགས་མཐོང་བ་ན་ཡང་དེའི་རྒྱུ་གོ་བར་བྱེད་དོ།",
    "གང་གི་ཕྱིར་གཤེར་བའི་ནུས་པ་གང་ལས་རུལ་བར་འགྱུར་བ།",
    "གང་གིས་ཕ་རོལ་པོའི་བཞིན་དུ་འདི་པའི་ལྟར་ན་ཡང་།",
    "དེས་ན་བདག་གཅིག་གི་ལྟར་ན་ཡང་རུལ་བའི་འབྲས་བུ་འཁྲུལ་པར་ཅི་ལྟར་འགྱུར།",
    "༡༤༩༡འོ་མ་དག་རང་བཞིན་གང་གིས་བརླན་པའི་རྟོགས་པའི་རྟེན་ཡིན་པའི་རང་བཞིན་དེ་ཉིད་ཀྱིས་རུལ་བའི་འབྲས་བུ་བྱེད་པ་དེའི་རྟེན་ཡིན་ལ།",
    "མེ་ཐ་དད་ཀྱང་ཆ་གང་གིས་དེ་མེའི་རྟོགས་པའི་རྒྱུ་ཉིད་ཀྱིས་རང་བཞིན་གྱིས་༤དེ་ལས་གཞན་ལས་ལྡོག་པས་མར་རྟོགས་པའི་རྟེན་ཡིན་ལ།",
    "ཅི་ལྟར་དུ་བ་རང་གི་རྒྱུ་ལ་མི་འཁྲུལ་པ་དེ་བཞིན་དུ་འབྲས་བུ་གཞན་ཡང་དེ་བཞིན་ཏེ།",
    "དུ་བ་དང་བུད་ཤིང་གི་འགྱུར་བ་དག་གིས་ཡིན་ཏེ།",
    "སྔོན་པོ་ནི་སྔོན་པོ་ཉིད་ཀྱི་རང་བཞིན་ཡིན་པས་ཅི་ལྟར་དེ་མེད་པར་འགྱུར་རང་གི་རང་བཞིན་གྱིས་ེམཚོན་པར་བྱ་བའི་དངོས་པོ་ནི་དེ་མེད་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "གང་གིས་དེ་མེད་པས་མེད་པར་འགྱུར་བ་བསྐྱེད་པར་བྱ་བ་ཉིད་ནི་དངོས་པོའི་མཚན་ཉིད་མ་ཡིན་ཏེ།",
    "མཇུག་སྡུད་པ་ནི་དེ་ལྟར་ན་རེ་ཞིག་ཅེས་བྱ་བའོ།",
    "དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་གི་འགལ་བ་དང་༤དངོས་པོ་ཉིད་མ་ཡིན་ནའོ།",
    "ཐུན་མོང་གི་མ་ངེས་པ་ཁོ་ན་མ་ངེས་པར་རིགས།",
    "ཐུན་མོང་མ་ཡིན་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "རང་གི་ཕྱོགས་ཞེས་བྱ་བ་ནི་རིག་༤པས་རང་ཕྱོགས་འཛིན་པ་ནི་རིགས་ཀྱི་ཐུན་མོང་བ་ཁོ་ན་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ལ་ནི་ཁྱེད་ལ་རིགས་པ་ཅི་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་མཉན་བྱ་ཉིད་ཀྱིས་རང་གི་རྟེན་ལ་འདི་ཉིད་ལྡོག་པར་ཅི་ལྟར་བྱེད།",
    "དེ་ཞེས་བྱ་བ་ནི་ཐེ་ཚོམ་མོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་ཐེ་ཚོམ་མོ།",
    "༡༤༩༧ལྡོག་པ་ངེས་པ་ཉིད་ཀྱིས་ཐེ་ཚོམ་ཟ་མོད་སྙམ་ན།",
    "ཅི་གང་གིས་འདི་སྐད་བརྗོད་པ་སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོས་འདི་ལྡོག་པ་གཅིག་ཏུ་ངེས་པ་ཅན་དུ་གསུངས་སམ་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་མཉན་པར་བྱ་བ་ཉིད་ཀྱི་རྟག་པ་དང་མི་རྟག་པ་དག་ལས་ལྡོག་པ་གང་ཡིན་པ་དེ་ལས་རྟག་པ་དང་མི་རྟག་པ་གཉི་ག་ལ་རྣམ་པར་གཅོད་པ་བསྒྲུབ་པ་ནི་གཞན་མ་ཡིན་གྱི།",
    "གང་ཞིག་ལྡོག་པ་སྔོན་དུ་སོང་བའི་སྒྲུབ་པའི་ངེས་པར་བྱེད་པ་དེ་ཁོ་ན་གཏན་ཚིགས་ཡིན་ཏེ།",
    "དེ་ཡང་རེས་འགའ་མེད་པར་འགྱུར་རོ་ཞེས་ཅི་ལྟར་བརྗོད་ཅེ་ན།",
    "གང་གི་མེ་དང་བཅས་པ་ཉིད་དུ་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་རྩོད་པ་སྤོང་བར་འགྱུར་བ་མེ་མེད་པར་རྣམ་པར་བཅད་ནས་མེ་དང་བཅས་པ་ཉིད་ཅི་ལྟར་མངོན་སུམ་གྱིས་འགྲུབ་ཅེ་ན།",
    "གང་གི་མཉན་བྱ་གཏན་ཚིགས་མ་ཡིན་པར་འགྱུར་བ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ལྡོག་པ་ཉིད་ཡིན་ན་གཏན་ཚིགས་ཁོ་ནར་འགྱུར་བ་དེས་ནའོ།",
    "དེ་བས་ན་ཐུན་མོང་བ་བཞིན་དུ་ཐུན་མོང་མ་ཡིན་པ་ཡང་མ་ངེས་པ་ཁོ་ནའོ་ཞེས་བྱ་བར་གནས་སོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་ཅེས་བྱ་བའོ།",
    "ཕན་ཚུན་མེད་པ་གཞལ་བྱ་ཡིན་མོད།",
    "རིགས་པ་ཅན་ལ་སོགས་པ་གཞན་དག་གིས་ནམ་མཁའ་མེད་དོ་ཞེས་བྱ་བའི་ཕྱོགས་མེད་པར་མ་རྟོགས་པ་ཏེ།",
    "དེ་ལྟར་གཞན་གྱི་འདོད་པའི་ནམ་མཁའ་མེད་པ་གཞལ་བྱ་ཉིད་དུ་བསྒྲུབས་ནས་རང་གི་འདོད་པ་བརྗོད་པ་ནི།",
    "གང་གི་ཕྱིར་དོན་བྱ་བར་ནུས་པའི་དངོས་པོ་ཁོ་ན་གཞལ་བྱ་ཡིན་པ་དེས་ན།",
    "འདིས་ནི་ཞེས་བྱ་བ་ནི་གཞལ་བྱ་ཉིད་ཐུན་མོང་གི་མ་ངེས་པར་བསྟན་པས་ནའོ།",
    "གལ་ཏེ་རྣམ་པ་དེ་ལྟ་བུའི་དངོས་པོ་མེད་པ་ནི་རང་ཉིད་འགྲུབ་མོད།",
    "དེ་ལའང་ཞེས་བྱ་བ་གང་གི་སྒྲ་ནི་ངེས་པར་གཟུང་བའི་དོན་ཏོ།",
    "བདག་གི་མཚན་ཉིད་ཀྱི་སྐྱེས་བུ་མཐོང་བ་མེད་པ་ལས་སྲོག་ལ་སོགས་པ་ལྡོག་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "གང་གི་ཚེ་རྗེས་སུ་དཔག་པ་མེད་ཀྱང་ན་ལྐོག་ཏུ་གྱུར་པའི་དོན་དེ་ཡོད་པ་དེའི་ཚེ་རྫས་དེ་རྗེས་སུ་དཔག་པ་ལ་འཁྲུལ་པ་ཡིན་ནོ་། འདི་ཉིད་བརྗོད་པ་ནི།",
    "འོན་ཏེ་རྗེས་སུ་དཔག་པས་ཡོད་པ་ལ་མ་ཁྱབ་མོད།",
    "དེ་དག་གི་ཞེས་བྱ་བ་སྟེ་བལྟར་རུང་བ་རྣམས་ཀྱིའོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡོད་པ་དང་དམིགས་པ་དག་དེའི་བདག་ཉིད་ཡིན་པ་དེའི་ཕྱིར་རོ།",
    "བུམ་པ་དང་སྣམ་བུ་མེད་པ་དག་གི་ཁྱད་པར་ནི་དངོས་པོ་མེད་པ་ལས་ལྡོག་པས་བུམ་པ་དང་སྣམ་བུ་དག་གཅིག་ཡིན་པའི་ཕྱིར་ན་གཅིག་ཁོ་ནའོ།",
    "ཁྱད་པར་གཅིག་ཡིན་པའི་ཕྱིར་ན་བུམ་པ་དང་སྣམ་བུ་ལྡོག་པའི་སྒོ་ནས་གཅིག་ཉིད་དུ་གྱུར་པ་དག་གིས་༦དངོས་པོ་མེད་པ་གང་ཡིན་པ་དེ་དག་ཀྱང་གཅིག་ཁོ་ནའོ།",
    "ཡང་ན་དངོས་པོ་གཉིས་ཐ་དད་པ་ཡིན་དུ་ཆུག་༧པ་དེ་ལྟ་ན་ཡང་དེ་དག་གི་དངོས་པོ་མེད་པ་དག་ནི་ཐ་དད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གལ་ཏེ་དེ་ལྟར་ཡིན་མོད་དེ་ལྟ་ན་ཡང་ཅི་ལྟར་ཡུལ་ཅན་འགོག་ཅེ་ན།",
    "གང་གིས་ཤེས་པ་ལ་སོགས་པ་འགོག་པ་དེའི་ཡུལ་ཅི་ལྟར་མེད་ཅེ་ན།",
    "གང་གིས་ཞེ་ན།",
    "བློ་དང་བྲལ་བ་ལ་སོགས་པ་ཡང་ཡོད་པའི་ཕྱིར་རོ་ཞེ་ན་གང་གི་ཕྱིར་བལྟར་རུང་བ་མ་མཐོང་བ་དེའི་འབྲས་བུ་ཡིན་ཡང་།",
    "གལ་ཏེ་ལུས་དང་ངག་གིས་༤ཐ་སྙད་འཇུག་པར་མི་བྱེད་པ་ཅི་ལྟར་ཡིད་ཀྱི་ཐ་སྙད་འཇུག་པར་བྱེད་ཅེ་ན་དངོས་པོ་མེད་པའི་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་མི་དམིགས་པ་མེད་པའི་ཐ་སྙད་དུ་རུང་བ་ཉིད་ལ་མི་འཁྲུལ་པར་གྲུབ་པ་དེའི་ཕྱིར་སྣང་བ་མི་དམིགས་པའི་བདག་ཉིད་ཅན་གྱི་ཡུལ་ཡོད་ན་ཡང་རྨོངས་པས་འཇིམ་གོང་ལ་སོགས་པ་འདིར་རྟོགས་པར་བྱ་བ་མེད་པའི་ཐ་སྙད་ལ་སོགས་པ་འཇུག་པར་མི་བྱེད་པ་མི་བརྗོད་ིདག་ལ་བརྡ་དྲན་པར་བྱེད་པ་འབའ་ཞིག་གོ།",
    "དུ་བ་སྐྱེད་༧པར་ནུས་པའི་མེ་ནི་རང་གི་རྒྱུ་ཁོ་ནས་བསྐྱེད་པ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་མེད་པའི་ཐ་སྙད་དུ་བྱར་རུང་བ་མི་དམིགས་པའི་རང་བཞིན་ཡིན་པ་དེས་ན།",
    "གང་གི་ཕྱིར་གཅིག་དམིགས་པ་ཉམས་སུ་མྱོང་བ་ལས་དྲན་པ་ལ་གནས་པའི་དགག་པར་བྱ་བ་འདི་མ་དམིགས་ལ།",
    "དངོས་པོ་མེད་པ་སྟོང་པའི་བདག་ཉིད་མེད་ན་འཆོལ་བར་འགྱུར་ཞེས་སེམས་པ་དེའི་ལྟ་བ་གང་ལ་ཡོད་པ་དེ་དག་གི་དངོས་པོ་མེད་པ་དེ་ལྟར་མི་འཆོལ་བར་བྱེད་པ་ཉིད་དུ་འདོད་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་དབེན་པ་ཉིད་གཞན་མེད་མོད།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "གང་གི་ཚེ་ཞེ་ན་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དངོས་པོ་མེད་པ་ཐ་དད་པ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་ན།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "ཤེས་པ་གཞན་ཞེས་བྱ་བ་ནི་ས་ཕྱོགས་ཀྱི་ཤེས་པའི་དམིགས་པ་གང་ཡིན་པ་དེ་བུམ་པའི་མི་དམིགས་པ་ཡིན་དུ་ཆུག་མོད།",
    "ས་ཕྱོགས་ཤེས་པ་བུམ་པ་ཤེས་པ་མེད་པ་ཡིན་མོད།",
    "དེ་ལྟར་མ་ཡིན་ན་འགྲོ་བ་ན་རྩ་ལ་རེག་པ་དང་།",
    "གང་གི་ཕྱིར་དྲན་པ་མེད་པར་ནི་འདི་ནི་མེད་དོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པ་ཅན་དངོས་པོ་མེད་པའི་ཤེས་པ་ཡོད་པར་མི་སྲིད་དོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དངོས་པོ་མེད་པ་ལ་ོམ་འཆོལ་བ་མི་འགྲུབ་པ་དེའི་ཕྱིར་རོ།",
    "དེའི་དོན་ཞེས་བྱ་བ་ནི་ས་ཕྱོགས་དང་བུམ་པ་དག་གིས་དབྱེ་བ་འགྲུབ་པའོ།",
    "གང་གིས་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དངོས་པོ་མེད་པ་མ་རྟོགས་པར་རང་གི་ངོ་བོ་རྟོགས་པར་མི་འདོད་དོ་ཞེ་རང་གི་ངོ་བོ་ཞེས་གསུངས་ཏེ།",
    "འོན་ཏེ་དངོས་པོ་མེད་པ་རང་གི་ངོ་བོས་རྟོགས་པར་འདོད་པས་བྱ་བ་ཁོ་ནའོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེས་དེ་ལྟར་དངོས་པོ་མེད་པ་གཞན་ལ་སྒྲུབ་པར་བྱེད་པ་མེད་པ་དེའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་དམིགས་པ་ཉིད་མི་དམིགས་པ་ཡིན་པ་དེས་ནའོ།",
    "གང་གི་ཕྱིར་དངོས་པོ་མེད་པ་གཞན་མ་ཡིན་པ་དེས་ནའོ་། རང་བཞིན་ནི་ངེས་པའི་ས་ཕྱོགས་ཀྱི་དམིགས་པའི་རང་བཞིན་མི་དམིགས་པ་གང་ཡིན་པ་ཉིད་དངོས་པོ་མེད་པ་ཡིན་ནོ།",
    "ཅི་ལྟར་དོན་རང་ལས་མི་འགྲུབ་ཀྱི་འོན་ཀྱང་རང་གི་ཤེས་པ་ལས་ཡིན་པ་དེ་བཞིན་དུ་དོན་མེད་པ་ཡང་རང་ལས་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་རང་གི་ཤེས་པ་མེད་པ་ལས་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་ཡིན་མོད་ཀྱི་འོན་ཀྱང་ཐུག་པ་མེད་པ་ལས་ཅི་ལྟར་ཐར་སྙམ་ན།",
    "དངོས་པོའི་མེད་པའི་ཐ་སྙད་ཀྱང་མངོན་སུམ་ཉིད་ལས་ཡིན་མོད།",
    "གང་གི་ཕྱིར་དེས་དབེན་པ་ཉིད་མི་དམིགས་པ་ཡིན་པ་དེས་ན་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་ཏུ་ཟད་མོད་དེ་ལྟར་ེན་ཡང་དོན་མེད་པ་མངོན་སུམ་གྱིས་གྲུབ་ཅེ་ན།",
    "གང་གི་ཚེ་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་ཤེས་པ་དང་ཤེས་བྱ་བའི་གཞི་ཐམས་ཅད་དུ་མངོན་སུམ་ཉིད་བལྟར་རུང་གི་དངོས་པོ་མེད་པ་རིགས་པར་བྱེད་པར་འགྱུར་བས་སོ།",
    "གང་གི་ཚེ་བལྟར་རུང་བའི་ཡོད་པ་མཐོང་བའི་ཡུལ་ཉིད་ཀྱི་ཁྱབ་པ་དེའི་ཚེ་རང་བཞིན་མི་དམིགས་པ་ཡང་ཡིན་པ་ནི་བསལ་བ་ཁོ་ནའོ།",
    "གང་གིས་གཅིག་གི་ཚེ་ནི་རང་བཞིན་མི་དམིགས་པ་ཡིན་ལ་གཞན་གྱི་ཚེ་ནི་ཁྱབ་བྱེད་མི་དམིགས་པར་འགྱུར་བ་རང་བཞིན་དང་ཁྱད་པར་བྱེད་པ་མི་དམིགས་པ་དག་ལ་ཁྱབ་པར་བྱ་བ་དང་ཁྱབ་པར་བྱེད་པའི་དངོས་པོ་ཁྱད་པར་ཡོད་པ་ཡང་མ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་གཞན་ཡང་ཞེས་བྱ་བའོ།",
    "ཐ་མི་དད་པ་དེས་ན་དེའི་རང་གི་ངོ་བོ་དང་ཁྱབ་ེཔར་མེད་པ་ཡིན་ནོ་དེ་ཞེས་བྱ་བ་འབྲས་བུ་མི་དམིགས་པ་ནི།",
    "གང་གི་ཕྱིར་དེ་ལྟར་རང་བཞིན་མི་དམིགས་པ་ཡིན་གྱི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་མ་ཡིན་པ་དེའི་ཕྱིར་རོ།",
    "ཤིང་ཉིད་ནི་ལྷག་པ་ཡིན་ཏེ་ཨ་མྲ་ལ་སོགས་པ་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཁྱབ་པར་བྱ་བ་དང་ཁྱབ་པར་བྱེད་པ་དག་ཐ་དད་པ་ཡིན་པས་ན་ཞེས་བྱ་བ་དེའི་ཕྱིར་རང་བཞིན་དང་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་དག་ཐ་དད་དོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཤིང་དང་ཤ་པ་དག་ལྟར་ཐ་དད་པ་མེད་པ་དེས་ན།",
    "གང་གི་ཕྱིར་དེ་ལྟ་བུའི་མི་དམིགས་པ་དངོས་པོ་མེད་པའི་ཐ་སྙད་སྒྲུབ་༧པ་དེ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "༡༥ ༣ ༣ན་གང་གིས་ནུས་པ་མ་ཡིན་ནོ་ཞེ་ན་དང་པོ་ཞེས་བྱ་བ་སྟེ།",
    "འོ་ན་གང་གི་ཚེ་ཉེས་པ་འདི་མེད་སྙམ་ན།",
    "གང་གི་ཚེ་ཞེས་བྱ་བའོ།",
    "དེས་ན་འགལ་བ་མེའི་གཟུགས་མཐོང་བ་ལས་དྲོ་བའི་རེག་པའི་མཚན་ཉིད་གྲང་བའི་རེག་པ་མི་དམིགས་པ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལས་ཞེས་བྱ་བའོ། ། གལ་ཏེ་དྲོ་བའི་རེག་པ་དམིགས་པ་ཅི་ལྟར་གྲང་བ་མ་དམིགས་པ་ཡིན་ཞེ་ན།",
    "དྲོ་བའི་རེག་པ་འབའ་ཞིག་ནི་གྲང་བ་མེད་པ་མ་ཡིན་གྱི།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེས་ན་དྲོ་བའི་རེག་པ་དེ་དམིགས་པ་ཉིད་གྲང་བ་དེ་མི་དམིགས་པ་ཡིན་ནོ།",
    "སྔ་མ་ནི་ཞེས་བྱ་སྟེ་རང་བཞིན་འགལ་བ་དམིགས་པར་ནི་གཟུགས་དང་དྲོ་བའི་རེག་པ་དག་ཚོགས་པ་གཅིག་ལ་རག་ལས་པ་ཉིད་ཀྱིས་ན།",
    "གཟུགས་མཐོང་བ་ལས་བལྟར་༤རུང་བའི་གྲང་བ་མི་དམིགས་པ་དྲོ་བའི་རེག་པ་དམིགས་པའི་མཚན་ཉིད་རྗེས་སུ་དཔོག་པ་ཡིན་ནོ།",
    "དེ་ནི་བདེན་མོད་ཀྱི་ཞེས་བྱ་བའི་ལན་ལ་དོན་འདི་ཡིན་ཏེ།",
    "གང་གིས་འདི་ཉེ་བར་བསྟན་པ་ལ་དགོས་པ་ཡོད་པར་འགྱུར་བ་ཅི་འདི་དགག་པར་སྒྲུབ་པར་བྱེད་པ་ཡིན་པར་མཐོང་ངམ་ཞེ་ན་འདི་ལྟར་ཞེས་གསུངས་སོ།་།",
    "མེ་དང་ཤིང་དག་གིས་འབྲས་བུ་དང་།",
    "གང་གིས་མི་དམིགས་པ་ཉིད་དུ་འགྱུར་བ་གྲང་བ་ལ་སོགས་པ་ཉིད་ལ་ནི་དུ་བ་ལ་སོགས་པ་དངོས་སུ་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་བརྒྱུད་ནས་ཞེས་བྱ་བ་ནི་འབྲས་བུ་དུ་བ་ལས་རྗེས་སུ་དཔག་པའི་མེ་འགལ་བ་དམིགས་པའི་རང་བཞིན་གྱིས་གྲང་བའི་རེག་པའི་རང་བཞིན་མི་དམིགས་པར་རྗེས་སུ་དཔག་པས་གྲང་བ་མེད་པའི་ཐ་སྙད་རྗེས་སུ་དཔོག་པའོ།",
    "༢༡༡༥༣༨གལ་ཏེ་འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཞེས་སྒྲ་གཅིག་གིས་བསྟན་པའི་ཕྱིར་འདི་གཏན་ཚིགས་གཅིག་ཁོ་ན་མ་༧ཡིན་ནམ་དེས་ན་ཅི་ལྟར་རྗེས་སུ་དཔག་པས་རྗེས་སུ་དཔོག་པ་ཡིན་ཞེ་ན།",
    "གཅིག་གིས་ཞེས་བྱ་བ་ནི་འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཞེས་བྱ་བའི་སྒྲས་སོ།",
    "འདི་ལྟར་འདི་ན་གྲང་བའི་རེག་པ་མེད་དེ་མེ་ཡོད་པའི་ཕྱིར་ཞེས་བྱ་བའི་སྦྱོར་བར་མེ་ཉིད་དང་དུ་བ་ཉིད་རང་གི་བསྒྲུབ་པར་བྱ་བ་ལ་ལྟོས་ཏེ།",
    "གསུམ་ཞེས་བྱ་བ་ནི་དུ་བ་དང་མེ་དང་སྣང་བ་མི་དམིགས་པ་སྟེ་གསུམ་མོ།",
    "འདི་དག་ཀྱང་སྒྲ་གཅིག་གིས་བསྟན་ཀྱང་དེ་ཞེས་བྱ་བ་འབྲས་བུ་ལ་སོགས་པའི་རང་བཞིན་མ་གཏོགས་པ་མི་དམིགས་པ་ཙམ་མ་ཡིན་ལ།",
    "གལ་ཏེ་སྒྲ་གཅིག་གིས་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ན།",
    "བདེན་མོད་ཀྱི་འོན་ཀྱང་ཐམས་ཅད་དུ་རྗེས་སུ་དཔག་པས་རྗེས་སུ་དཔོག་པ་ལ་སྒྲ་གཅིག་གིས་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱི་ཐ་མི་དད་པར་མི་འགྱུར་རོ་ཞེས་བསྟན་པའི་དོན་དུ་འདི་གསུངས་པར་ཟད་དོ།",
    "གལ་ཏེ་གཏན་ཚིགས་རྣམས་ཐ་དད་ཡིན་ན་ཅི་ལྟར་གཅིག་གིས་སྒྲས་བརྗོད་པར་བྱ་བ་ཉིད་ཡིན་ཞེ་ན་འདི་ནི་ཞེས་བྱ་བའོ་ཾ།",
    "གང་གིས་དེ་ཐ་མི་དད་པས་ཐ་དད་པ་མེད་པར་འགྱུར་བ་རྣམ་པར་གཅོད་པ་ཁོ་ན་ནི་གཏན་ཚིགས་ཀྱི་ཡུལ་མ་ཡིན་གྱི།",
    "སྔ་མ་འབྲས་བུ་དང་རང་བཞིན་དག་གིས་ནི་རྒྱུ་ལ་སོགས་པའི་རང་བཞིན་མ་ཡིན་པ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཆུ་མི་འགོག་པར་ཞེས་བྱ་བའོ།"
  ]
}