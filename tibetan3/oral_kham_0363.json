    "ཡང་གཡུལ་དུ་འཇུག་དུས་སུ་འདི་གྱོན་ན་གཡུལ་ལས་རྒྱལ་ནུས།",
    "དེ་ཙ་ན་སྒྲོམ་བུ་འདི་ཕུལ་ཅིག་གསུང་བ་དྲན་ནས།",
    "བལ་པོའི་རྒྱལ་པོའི་ཐུགས་ལ་འདི་བདེན་ནམ་མི་བདེན་སྙམ་ནས་བདེན་ན་ནི་ང་བས་ཁོ་བཟང་བར་འདུག།",
    "བདེན་ན་ནི་ངས་ཁོ་ཐུབ་པར་དཀའ་བ་ཅིག་འདུག་སྙམ་ནས་ཐེ་ཚོམ་དུ་གྱུར་ཏོ།",
    "ཁྱེད་མཐའ་འཁོབ་ཀྱི་རྒྱལ་པོས་ངའི་དྲུང་དུ་ཁས་ལེན་དག་ཆེ་བར་འདུག་སྟེ་དེ་ཙམ་གྱིས་གོ་མི་ཆོད་པས།",
    "དེར་བལ་པོའི་རྒྱལ་པོའི་ཐུགས་དགོངས་ལ་འདི་ནི་ངས་ཐུབ་པར་བཀའ་བ་ཅིག་འདུག་སྟེ།",
    "དེར་བལ་པོའི་རྒྱལ་པོ་འཇིགས་ནས་མཐའི་རྒྱལ་པོའི་སྒྲོམ་བུ་ལ་ཡང་ཟད་པ་མི་འདུག།",
    "ཁོའི་རྣམ་འཕྲུལ་གྱི་སྤྲུལ་པ་ཡང་བསམ་གྱིས་མི་ཁྱབ་པར་འདུག་པས་སྦྱིན་དགོས་སྙམ་ནས་ཐུགས་དགེས་སོ།",
    "དེ་རུ་ཁྲི་བཙུན་གྱིས་བོད་དུ་འགྲོ་དགོས་པར་འདུག་སྙམ་ནས།",
    "ལྷ་གཅིག་ཁྲི་བཙུན་གྱི་བསམ་པ་ལ་རྒྱལ་པོ་འདི་མི་ལས་འདས་པ་སྐུ་བྱད་ལྟ་བས་ཆོག་མི་ཤེས་པ་ངོ་མཚར་ཅན་ཅིག་འདུག་པ་ལ།",
    "ཕྱོགས་བཞིའི་རྒྱལ་པོས་དམག་དུས་གཅིག་ཏུ་དྲངས་ཀྱང་མི་ལྡས་ཐུབ་པ་ཡིན་ཏེ།",
    "དེར་བློན་པོ་གཞན་རྣམས་ཀྱིས་རྒྱ་སྲང་འཆོལ་ནས་འགྲོ་ས་མ་རྙེད་པར་ཀུ་རིང་རིང་འདུག་གོ།",
    "གཞན་རྣམས་ཀྱིས་མ་རྙེད་པ་ལ་བོད་བློན་རྣམས་ཀྱིས་རྙེད་ནས་འདུག་གོ།",
    "དེ་ལ་མི་རྟོགས་པའི་ཐབས་ང་རང་ལ་ཡོད་བྱས་ནས།",
    "ཙ་ན་ཀ་དང་།",
    "འོ་ན་བོད་དུ་སོ་ནམ་བྱ་རུ་བཏུབ་པ་འདུག་གསུངས་ནས།",
    "དེ་ནས་ཉིན་གཅིག་ཙ་ན་རྒྱལ་བློན་རྣམས་ཀྱིས་བལྟར་བྱོན་ནས།",
    "རྒྱ་རྗེའི་རྒྱལ་པོ་ལགས་ཞེས་ཞུ་འཚལ་བྲོ་ཅིག་འཚལ་གྱིན་གདའ་བ་བགྱིས་བས།",
    "ས་བཟླ་བ་གསུམ་ན་རྒྱ་རྗེའི་ལྡུམ་ར་ན་སྙེ་མ་ལོང་མ་ཐོན་ལ་ཁད་ཙ་ན།",
    "ད་སྟེ་ཞག་བདུན་ནས་ང་འཆི་བར་འདུག།",
    "དེ་ཙ་ན་ཡུལ་འདིར་ལྟས་ངན་བཅོ་བརྒྱད་འོང་ཟེར་བས།",
    "ཤི་ཙ་ན་སྤྱིར་ཡུལ་པ་ལ་མི་རུང་།",
    "རི་ཆེན་པོ་གསུམ་འདུག་པའི་སྟེང་ན་མཚོ་ཆེན་པོ་གཅིག།",
    "རབ་བརྒལ་བ་ལ་རྟ་སྦངས་དང་རྟ་རྗེས་རང་ཡང་འདི་ཙམ་འདུག་ཟེར།",
    "ཀོང་ཇོ་དཔོན་གཡོག་ཤར་སྒོ་ན་ལྷགས་ནས་འདུག་པ་དང་།",
    "དེར་ཁྲི་བཙུན་གྱི་སེམས་ལ་ཀོང་ཇོས་ང་ལ་ཉེས་པ་ཅིག་བསླབས་འདུག་སྙམ་ནས།",
    "ཁྱེད་རང་ལོག་པར་མ་ལྟ།",
    "རྒྱལ་པོས་ཀྱང་ཀོང་ཇོ་ལ་དྲིས་འདུག་པའི་ཡོ་བྱད་རྣམས་ཀྱང་ཟད་བྱས་པས།",
    "འདི་འོང་བའི་ས་ཕྱོགས་ཡང་བ་གདའོ།",
    "ལྷ་ཐུགས་རྗེ་ཆེན་པོ་ཁྱེད་རང་མ་ལགས་སམ།",
    "སྡིག་སྤྱོད་རྒྱལ་པོ་ཅིག་འདུག་པ་ཞེས་སྨྲས་ཤིང་ཕྱིར་བྲོས་སོ།",
    "བདུད་རི་དེ་དང་ཉེ་བ་ན་ཆུ་ཆེན་པོ་ཅིག་འདུག་པ་ལ།",
    "རི་དེ་ལ་དགེ་སློང་གཉིས་འདུག་པས་ཚོར་ཏེ་མདུན་དུ་བྱུང་བ་ལ།",
    "དེར་མ་འདུག་པར་ཡུལ་སྒྲ་གཅན་དུ་མྱུར་དུ་ཤོག་ཤིག་པར་བསྒོའོ།",
    "བྱ་ཀ་ལ་པིང་ཀ་ཅིག་ཤི་ནས་ཕྲུ་གུ་དྲུག་ཁ་དམར་དང་དང་འདུག་པ་མཐོང་ངོ།",
    "ཁོང་པ་ནས་མ་ཐོན་ན་ང་འཆི་བར་འདུག་པས་ཡར་ཐོན་ཅིག་ཟེར།",
    "ཁྱེད་རང་ཡང་འདི་འདྲར་སྐྱེ་སྨྲས་པས།",
    "ཁྱེད་རང་ཡབ་ཡུམ་སྲས་གསུམ་བློན་པོ་དང་བཅས་པ་ནང་པར་སྒོར་ཐོན་ལ་བཞུགས་ཤིག།",
    "རྒྱལ་བུའི་སྒོའི་རྩར་བསྡད་ཙ་ན་མི་ཅིག་རྟ་སྔོན་པོ་བཟང་པོ་ཅིག་ཞོན་ནས་བྱུང་སྟེ།",
    "དེར་རྒྱལ་བུ་ཁྱིམ་དུ་ལོག་ནས་ཟས་ཅིག་བཟའ་སྙམ་ཙ་ན་སྦྲ་དང་ནོར་ཚོ་མཁའ་ལ་འཇའ་བཞིན་ཡལ་ལོ།",
    "ཁྲི་ཁ་ནས་ས་ལ་ལྷུང་ནས་ཐོམ་མེ་འདུག་གོ།",
    "ཆབ་དཀར་གླིང་དུ་མི་འདུག་སྟེ།",
    "གང་ནས་མ་འོངས་འདི་ནས་འདུག།",
    "ང་ཡི་སྟོན་པ་གང་ན་འདུག།",
    "གཅན་གཟན་དང་དུག་སྦྲུལ་རྣམས་དགའ་སྟེ་མི་ཟ་བར་འདུག་གོ།",
    "དེ་ནས་ཆུ་བོ་ལ་བསྐྱུར་བས་ཆུ་མེད་པའི་སྐམ་ལ་འདུག་གོ།",
    "དེ་ནས་མེར་བསྲེགས་པས་མེ་ཤི་ནས་པདྨས་གང་བའི་རྫིང་བུ་ན་འདུག་གོ།",
    "བཅིངས་བ་གྲོལ་ནས་ཆུ་མེད་སྐམ་ལ་འདུག།",
    "དེར་བྲམ་ཟེས་ཤེས་སམ་མི་ཤེས་ཉམས་སད་པས་ཤེས་པར་འདུག་ནས་རྒྱལ་པོའི་སར་ལོག་སྟེ་ཕྱིན་ནོ།",
    "བྲམ་ཟེ་རྫུན་མི་བྱེད་འདུག་ཟེར་ནས་བྱ་དགའ་མང་པོ་བྱིན་ནོ།",
    "དགེ་སློང་རང་ཡང་བྲང་ཁང་དུ་གཤེགས་འཚལ་བྱས་པས།",
    "རྒྱལ་པོ་ལ་བདོས་ཀྱང་ཐུབ་བོ་ཟེར་གྱིན་འདུག་སྨྲས་ཏེ་ཕྲ་མ་བསྐྱལ་བས་རྒྱལ་པོ་དང་།",
    "འདི་ཙམ་པའི་ནོར་འདུག་བཞིན་དུ་ཆོག་ཤེས་མེད་པར་གཞན་གྱི་ནོར་ལ་བརྣབ་པ།",
    "གྱད་ཟླ་བ་བཟང་པོ་ཞེས་བྱ་བ་ཐམས་ཅད་བརྡུང་ཞིང་འཚོགས་པ་ཅིག་གདའ་སྐད་དོ།",
    "ཐོ་རངས་བློན་པོ་རིགས་ལྡན་དགའི་མནལ་ལམ་ན་ལྷ་ལྕམ་གྱི་སྐུ་ལ་ཉི་མ་ཤར་ནས་འོད་ཟེར་གྱིས་འཇིག་རྟེན་གྱི་ཁམས་ཁེངས་འདུག་པ་ཅིག་རྨིས་སོ།",
    "བཞུགས་ནས་འདུག་པ་བདག་ལ་རྨི།",
    "ཁོ་རང་ཡང་སྐྱེ་བ་འཕོས་པ་དྲན་ཏེ་འོང་སྙམ་ནས།",
    "དེ་ན་རྒྱལ་བུ་དེ་ཆེར་སྐྱེས་ཏེ་ལོ་བཅུ་དྲུག་ལོན་ཙ་ན།",
    "རྒྱལ་བུས་ཁྱེད་རང་གཉིས་སློང་ན་ཡང་སྟེར་ཕོད་དམ་བྱས་པས།",
    "དབུལ་དེ་ཅི་ཡང་མེད་པ་མང་པོ་འདུག་པས།",
    "རྒྱལ་བུས་ཁྱེད་རང་གཉིས་ཀྱང་ཁོར་དང་འགྲོགས་ལ་ལོག་གསུངས་པས།",
    "བདུད་རི་དེ་དང་ཉེ་བ་ན་ཆུ་ཆེན་པོ་ཅིག་འདུག།",
    "ནམ་མཁའ་སྒྲོན་མས་ཀྱང་ང་ཡང་དེ་ཁོ་ན་བཞིན་བྱེད་པ་དག་ཏུ་གདའ།",
    "རི་དགས་རྣམས་ཀྱང་ངུ་ཞིང་འདུག།",
    "ཁོང་གཉིས་ཀྱང་རྩེ་བ་མི་འདུག།",
    "རྒྱལ་པོ་ཡང་ངོ་གནག་པ་འདུག་ནས།",
    "སྔར་ངེད་གཉིས་ཤིང་ཐོག་བཏུས་འོང་ཙ་ན།",
    "གོས་ལ་རྡུལ་འདུག་ཀྱང་སོལ་དུ་འོང་བ་ཡིན་ལ།",
    "བྱ་དང་གཅན་གཟན་རི་དགས་རྣམས་ཀྱང་ལུས་ས་ལ་བརྡབས་ངུ་ཞིང་འདུག།",
    "རྒྱལ་པོས་ཁྱེད་རང་གཉིས་མ་ངུ་ཅིག།",
    "ལམ་ཁར་ཕྲད་དེ་ཁྱེད་གཉིས་ངའི་ཆུང་མ་བྱེད་ཟེར་ཙ་ན།",
    "རྒྱལ་བུས་ཅི་སློང་བདག་ལ་ཅི་འདུག་སྟེར་གསུངས།",
    "རྒྱལ་བུ་ལ་འགྱོད་པའི་སེམས་འདུག་གམ་མི་འདུག་བལྟས་པ་ཡིན་ཟེར་ནས།",
    "དེའི་ཚེ་རྒྱལ་པོ་ལ་སྲས་མིང་སྲིང་གཉིས་འོངས་འདུག་འུ་ཉོའམ་བྱས་སོ།",
    "ཁྱེད་རང་ཁོས་སྡུག་ཏུ་བཅུག་པ་ལ།",
    "ཁྱེད་རང་ཁྱེར་བྱས་པས།",
    "ངོ་མཚར་ཆེ་བ་ཅིག་འདུག་པར་མཐོང་ནས།",
    "ཐབས་དྲག་པོས་ནན་གྱིས་ཆད་པས་བཅད་ནས་འདུལ་དགོས་པར་འདུག།",
    "བྱེ་མ་གླིང་ན་འཇག་མ་འདུག་པའི་སྟེང་ན།",
    "དེ་རྣམས་སྤྱན་འདྲོངས་པར་འདུག།",
    "མཐའ་འཁོབ་ཀྱི་རྒྱལ་པོ་འདི་ལྷ་དང་མི་ལས་འདས་པའི་སྐུ་ལ་ངོ་མཚར་ཆེ་བ་ཅིག་འདུག་པ་ལ།",
    "སྤྱིར་འཛམ་བུ་གླིང་ལ་ཡུལ་གྲུ་ཆེན་པོ་བཞི་འདུག་སྟེ།",
    "ལྷ་གཙོ་འཁོར་གསུམ་རང་བྱུང་དུ་བྱོན་ནས་འདུག་གོ།",
    "ལྷོ་ནུབ་གླ་བའི་ཚལ་ན་འདྲེའི་བདུད་དཔུང་འདུག་སྟེ།",
    "རྟ་མགྲིན་གསུམ་འོད་དུ་བྱས་ནས་ཇི་ལྟར་འདུག་པ་ལྟར་བྲག་ལ་བརྐོས་སོ།",
    "ན་བུན་གྱི་གསེབ་ན་ཀུ་དི་རི་རི་འདུག་ནས།",
    "དར་ཐོད་ཅན་གཞན་པས་ཆེ་བ་ཅིག་ལ་འདྲེན་ཅིང་འདུག་ནས།",
    "རྒྱལ་པོའི་དབུ་སྔས་ན་མེ་ཏོག་ཐོར་བྱས་ནས་གཤེགས་ནས་མི་འདུག།",
    "རྒྱལ་པོ་ལ་ཕྱག་བསྒྱེལ་དུ་ཕྱིན་པ་དང་ལྷ་མི་བཞུགས་པར་འདུག་ཅེས།",
    "ཐུགས་རྗེ་ཆེན་པོ་གཙོ་འཁོར་གསུམ་བྱང་ངོས་ཀྱི་གཙང་ཁང་ན་བཞུགས་ནས་འདུག་གོ།",
    "རྒྱལ་པོ་གང་ན་བཞུགས་དྲིས་ཤིང་ཡར་ལུངས་སུ་ཕྱིན་ཙ་ན།",
    "རོའི་རྩིག་པ་ཆེན་པོ་འདུག་ནས་འདི་དག་སུས་བྱས་དྲིས་པས།",
