    "འདི་རྣམས་ཀྱི་ནི་སྤྱི་བོར་རྣམ་སྣང་བཞུགས།",
    "སྤྱི་བོར་ཡང་ནི་དོན་ཡོད་གྲུབ་པ་བཞུགས།",
    "ཞུ་ནས་དེ་ལས་གཟུགས་ལ་སོགས་པར་གྱུར།",
    "ཡ་ལས་བྱུང་བའི་འོད་སྔོན་གཞུར་བྱས་ཉིད།",
    "ཐམས་ཅད་ཀུན་དུ་ཚིམ་པར་བསམ་པར་བྱ།",
    "ལུས་ཀུན་ཚིམ་པར་ཀུན་དུ་གྱུར་ནས་ནི།",
    "སཾ་གྱི་ཤེནང་དུ་རབ་ཞུགས་རྣམ་པར་བལྟ།",
    "མངོན་སུམ་བྱས་ནས་ཐིག་ལེའི་སྦྱོར་བའོ།",
    "མཚན་མ་བརྟན་པོར་བྱས་པས་བརྟགས་ན་ནི།",
    "སྲོག་མ་བསྡམས་པར་གྱུར་པ་གང་ཡིན་དགེ།",
    "ཐམས་ཅད་ཀུན་དུ་འཁྱུད་པར་གྱུར་པ་དང་།",
    "དེ་དང་དེ་ཡིས་འཁོར་ལོ་མཆོག་སད་བྱས།",
    "མ་ལུས་སྐྱོ་བ་རྣམ་པར་བསལ་བར་བྱ།",
    "ཟན་ཟར་གྱུར་པའི་ཚེ་ན་འདི་སྐད་གསུངས།",
    "རྡོ་རྗེ་ལ་སོགས་ཆོ་ག་བཞིན་བྱས་ནས།",
    "སྐུ་སོགས་ལྷ་རྣམས་ཀུན་དུ་ཚིམ་པར་བྱ།",
    "མཐར་ཐུག་པར་ཡང་སེམས་ཀྱི་བྱ་བ་སྟེ།",
    "རྗེས་སུ་མཐུན་པའི་འགྲོ་བའི་དོན་བྱས་ཤིང་།",
    "སེམས་ནི་གཅིག་ཏུ་མཉམ་པར་གཞག་གྱུར་པས།",
    "དེ་ཡི་སྔགས་དང་ཕྱག་རྒྱ་རབ་བརྟགས་པར།",
    "ཇི་ལྟར་དངོས་པོ་གཅིག་ལ་རྣམ་པར་རྟོག།",
    "བདེ་དང་སྡུག་བསྔལ་རྣམ་པར་གྲོལ་བའི་སེམས།",
    "སྣ་ཚོགས་པདྨའི་གདན་ལ་བཞུགས་པ་ཡིགེ།",
    "གང་ཞིག་ཐུན་མཚམས་ཉམས་པར་གྱུར་པ་ཡིས།",
    "ཇི་ལྟ་བ་བཞིན་ཉེས་པ་གསུམ་འབྱུང་གསུངས།",
    "རྣལ་འབྱོར་ལྡན་པས་རིག་མར་ལྡན་པར་ཉལ།",
    "མྱུར་བར་༩ཀུན་དུ་ལངས་ནས་ཡང་བྱས་ཏེ།",
    "ཇི་ལྟར་ལོག་པའི་བརྫུན་ཕྱེགྱིས་བྱས་པ་ཡིསཕ་ཡི་དྲུང་ནས་ཅུང་ཟད་རྙེད་པ་ལྟར།",
    "དཔག་མེད་རྒྱུད་དོན་མ་ལུས་རབ་མཁྱེན་པ།",
    "དཔལ་ལྡན་རྣམ་པར་དུལ་ཞིའི་ཞལ་སྔ་ནས།",
    "པེ་སྣར་པར།་",
    "དམ་པ་ཡིས་ནི་བསྐུལ་ཕྱིར་སྤྲོ་བྱས་ཏེ།",
    "ཡིད་ལ་བྱེད་པའི་མཆོག་དེ་བསྒྲུབ་པར་བྱ།",
    "ཆོ་ག་བཞིན་དུ་རྗེས་གནང་ཐོབ་པ་ཡི།",
    "བློ་དང་ལྡན་པས་རང་སྔགས་མཉེས་པར་བྱ།",
    "ཤིང་མཆོག་མཛེས་པས་རྣམ་པར་བརྒྱན་པ་ཡི།",
    "སྒོ་ལ་སོགས་པ་ཡང་དག་དག་པར་བྱ།་།",
    "ཆོ་ག་བཞིན་དུ་ཐམས་ཅད་བཤགས་པར་བགྱི།",
    "རབ་ཏུ་དགའ་སོགས་ས་ལ་རབ་བཞུགས་ཉུཔ།",
    "བསམ་དང་རྣམ་པར་སྨིན་པ་དག་གྱུར་པས།",
    "ཡང་དག་ཉིད་དུ་ད་ནི་གནས་པར་བགྱི།",
    "མ་ལུས་སྨོན་པ་ལས་ནི་ངེས་པར་གྲོལ།",
    "གཟུགས་སོགས་ཡུལ་རྣམས་རྣམ་པར་དག་པ་ཡིན།",
    "གཞལ་ཡས་ཁང་པ་དེར་ནི་བསམ་པར་བྱ།",
    "ཕྱོགས་སྒོ་མཐའ་ཡས་ཁྱད་པར་རབ་བསྒྲུབ་པ།",
    "རིག་མ་དམ་པར་འཁྱུད་པར་མཛད་པའོ།",
    "ཁམས་གསུམ་ཁོང་ནི་རྣམ་པར་བརྒྱན་པ་ཡིས།",
    "ཐུབ་པའི་འོད་ཚོགས་དུ་མ་རྣམ་པར་འགྱེད།",
    "རྒྱལ་བའི་ཚོགས་རྣམས་མ་ལུས་གཞུག་ཀྱེཔར་བྱ།",
    "མ་ལུས་དེ་ནི་རབ་ཏུ་གཞུག་པར་བྱ།",
    "རྣམ་སྣང་ལ་སོགས་རྒྱལ་བའི་ཚོགས་བཞུགས་ཏེ་་།་།",
    "ངོ་བོ་ཉིད་གྱུར་སྤྱན་ལ་སོགས་པར་གྲགས།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་བདེ་གཤེགས་ཏེ།",
    "ཤེས་རབ་ཆགས་པས་ཞུ་བར་བྱས་པར་སྐྱེབསམ།",
    "ཟླ་བ་ཞུ་བར་བྱས་པར་མཐོང་བ་དང་།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་མུགསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "དགའ་བའི་སྤྱོད་པ་ཀུན་དུ་བཟང་པོ་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "ཡོན་ཏན་རིན་ཆེན་མང་པོའི་གཏེར་གྱུར་བདག་ལ་དགྱེས་པར་མཛོད།",
    "དེ་ལྟའི་གླུ་ཡི་ངོ་རུ་བྱས་པས་ན།",
    "སྣ་ཚོགས་རྒྱན་གྱིས་རྣམ་པར་བརྒྱན་པ་ཡི།",
    "ཕྱག་གཉིས་ཤེས་རབ་དམ་པར་འཁྱུད་པ་དང་།",
    "སྐུ་ཡི་རྡོ་རྗེ་ཉིད་དུ་བསམ་པར་བྱ།",
    "ཤེས་རབ་དམ་པར་གནས་པའི་འོད་རྣམས་ཀྱིས།",
    "ཕྱོགས་བཅུར་ཀུན་དུ་བཞུགས་པའི་ཐུབ་པའི་ཚོགས།",
    "རྣམ་པར་བཀོད་པས་ལུས་ནི་འོད་དང་ལྡན།",
    "སྔགས་པས་དགའ་བ་ཀུན་དུ་བརྩམ་པར་བྱ།",
    "དངོས་པོ་ཐམས་ཅད་ཀྱིས་ནི་ཞུགས་པར་བྱ།",
    "མཚན་མ་བསྣམས་པ་ནུབ་ཏུ་བསམ་པར་བྱ།",
    "མེ་ཡི་ཕྱོགས་ཉིད་དུ་ནི་བསམ་པར་བྱ།",
    "རྣམ་པར་སྒེག་པ་བདེན་བྲལ་མཚམས་སུ་བསམ།",
    "ཡ་མཱནྟ་ཀྲྀཏ་ཅེས་བྱས་གཤིན་རྗེ་གཤེད།",
    "དཔལ་ལྡན་ཤར་གྱི་སྒོར་ནི་བསམ་པར་བྱ།",
    "ལྷོ་ཕྱོགས་ཀྱི་ནི་སྒོ་རུ་བསམ་པར་བྱ།་",
    "པདྨཱནྟ་ཀྲྀཏ་ཛྭཅེས་བྱས་ཕྱོགས་རྣམས་ཀྱི།",
    "བིསྤྱོནྟ་ཌཀྲྀཏ་ཅེས་བྱས་དཔའ་བོ་ནི།",
    "རྣམ་པར་སྣང་མཛད་ཐུགས་གཙོ་འོད་དཔག་མེད།",
    "འོད་ཀྱི་སྒོ་ལས་ངེས་པར་བྱུང་བ་ཡི།",
    "མཚན་མས་རིམ་གྱིས་རྣམ་པར་སྒེག་བཅས་ཤིང་།",
    "རྣམ་པར་སྣང་མཛད་དག་པ་ཆེ།",
    "རྒྱལ་བའི་འཁོར་ལོ་དེས་ནི་ཚིམ་པར་བྱ།",
    "བྱ་བ་འགའ་ཡང་ཡོད་པར་མ་མཐོང་སྟེ།",
    "བསགས་པ་འགའ་ཡང་འདིར་ནི་མེད་པར་འགྱུར།",
    "དེས་ན་རྣམ་པར་དབྱེ་བ་ཐམས་ཅད་མིན།",
    "དད་དང་བརྩོན་འགྲུས་རྣམ་པར་དག་པ་དང་།",
    "འཁོར་ལོའི་གཙོ་བོ་འདི་ནི་རྣམ་པར་བཞུགས།་།",
    "སེར་སྣ་ལ་སོགས་ལྡོག་པར་གྱུར་པ་ནི།",
    "རང་ཡིད་འོད་དང་ལྡན་པར་ཡོངས་སུ་བསྒོམ།",
    "སླར་ཡང་འདི་ཉིད་དུ་ནི་ངེས་བཞུགས་ཤིང་།",
    "ཡེ་ཤེས་བདུད་རྩི་འབབ་པར་བསམ་པར་བྱ།",
    "དེ་ཡིས་ཀུན་དུ་མཐར་ནི་སྣང་བྱས་ནས།",
    "འོད་ལྡན་སྣ་རྩེར་གནས་པར་ཐུབ་པ་ཡི།",
    "སྲོག་དང་རྩོལ་༢བ་ཤིན་ཏུ་མ་བསྡམས་པར།",
    "ཅིག་ཅར་སྤྲོ་བ་དག་ནི་ལེགས་པར་བྱ།",
    "དེ་ལྟར་ཐང་ཅིག་ངལ་བསོ་བྱས་ནས་ནི།",
    "སྔགས་པའང་ཀུན་དུ་ཆགས་པ་མེད་པར་བྱ།",
    "ཨོཾ་ལ་སོགས་པར་འཁོར་ལོ་བསྡུས་ནས་ནི།",
    "རྣམ་པའི་ང་རྒྱལ་ཡིད་ལ་བྱས་ནས་ནི།",
    "བྱ་བ་མ་ལུས་པ་ནི་རྫོགས་པར་བྱ།",
    "ངོ་བོ་ཉིད་གྱུར་འོད་དང་ལྡན་པར་བསམ།",
    "ཡེ་ཤེས་འབར་བ་བླ་ན་མེད་པར་བཤད།",
    "དམ་ཚིག་འདི་ནི་བདེ་གཤེགས་རྣམས་ཀྱིས་གནང་།",
    "རྟག་ཏུ་ལེགས་པར་མཉམ་པར་གཞག་༡སྟེ་བྱ།",
    "རིམ་འདི་ཁྱད་པར་དུ་ཡང་བསམ་པར་བྱ།",
    "སྔོན་དུ་འགྲོ་བའི་བཟླས་བརྗོད་བྱས་ནས་ནི།",
    "འདོད་པའི་དངོས་གྲུབ་རབ་ཏུ་བསྒྲུབ་པར་བྱ།",
    "གང་ཞིག་དབུས་སུ་གནས་པར་གྱུར་པ་ཡིསགྱེ།་།",
    "འཁོར་ལོ་དེ་ཡང་དེ་ཡི་ཡིན་པར་འགྱུར།",
    "དེ་དང་རྣམ་པར་འགལ་བར་འགྱུར་བའི་སེམས།",
    "འདི་ནི་མངོན་སུམ་དུ་ནི་རྟོགས་པར་འགྱུར།་།",
    "ཡོད་པ་མིན་པར་སྔར་ནི་བསྒྲུབས་པས་ན།",
    "མཐོང་བའི་བསླབ་པ་རྣམ་པར་འཕེལ་བ་ཡིས།",
    "རྣམ་པར་ལྡོག་པར་མི་འགྱུར་གང་ཕྱིར་འདིར།",
    "ངོ་བོ་སུ་ཞིག་ངེས་པར་སྒོམ་རྗོ་མི་བྱེད།",
    "མུན་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བྱེད་པ།",
    "དེ་ལྟར་རྣམ་པར་སྦྱར་ལས་ལེགས་བྱུང་བའི།",
    "གཞོལ་བར་གྱུར་པས་རྟག་ཏུ་བསྒོམ་རྟེཔར་ཤོགདཔལ་གསང་བ་འདུས་པའི་སྒྲུབ་པའི་ཐབས་ཀུན་དུ་བཟང་པོ་ཞེས་བྱ་བ།",
    "གོམས་སྙེཔའི་རི་ལ་བཅོམ་ལྡན་འཇམ་དབྱངས་ཞེས་བྱ་རབ་ཏུ་བསྒྲུབ་པར་བྱ།",
    "དམིགས་ཏེ་སྣ་ཚོགས་མཆོད་སྤྲིན་སྤྲོ་སོགས་སྔོན་དུ་བྱས་ནས་བློ་ལྡན་པས།",
    "རྣམ་པར་ཐར་བརྒྱད་རྣམ་པར་དག་པས་ཀ་བ་བརྒྱད་ཀྱིས་ཀླུབས་༡པའི་མཆོག།",
    "དབུས་ཀྱི་གདན་ལ་ཆོ་ག་བཞིན་དུ་འོད་དཔག་མེད་གཞི་ཙབསམ་པར་བྱ།",
    "གསལ་བས་དུརྣམ་པར་བཀོད་པས་བརྒྱན་པའི་ཕྱག་གཉིས་དམ་པའི་རིག་མ་འཁྱུད།",
    "ཕྱུང་ནས་རིག་མ་ཐམས་ཅད་གཞི་ཡི་རིག་མའི་ནང་དུ་ཐིམ་པར་བྱ།",
    "བློ་ཚོཡིས་བསམས་ནས་རྫོགས་པར་བདེ་ལ་སྐྱེ་བོའི་ཚོགས་རྣམས་གཞུག་པར་བྱ།",
    "ཝཾ་རྨཱ་པཾ་ཏྟྭཾ་ཞེས་ཀྱང་གསུངས་པ་དེ་བཞིན་སྤྱན་ལ་སོགས་པའོ།་",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་བདག་ནི་དེ་རིང་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་བདག་ནི་དེ་རིང་གསོན་པར་མཆིས་བཞེད་ན།",
    "སྤྱོད་པ་དྲི་མེད་ཀུན་དུ་བཟང་པོས་བདག་ལ་དགྱེས་པར་མཛོད།",
    "མགོན་པོ་གལ་ཏེ་བདག་ནི་དེ་རིང་གསོན་པར་མཆིས་བཞེད་ན།",
    "ཡོན་ཏན་རིན་ཆེན་མང་པོའི་གཏེར་གྱུར་བདག་ལ་དགྱེས་པར་མཛོད།",
    "ནང་དུ་ཐིམ་ནས་འོད་ཀྱིས་ཐུདཔལ་ལྡན་འཇམ་པའི་རྡོ་རྗེར་གྱུར་པར་བྱ།",
    "རྣམ་པར་བྱང་བ་མངོན་བཞུགས་ཟབ་དོན་བྱིན་བརླབས་འདི་ལྟར་བྱ།",
    "རྡོ་རྗེ་གསུམ་ནི་ནམ་མཁའི་རང་བཞིན་མཚན་མ་སྤངས་པ་མཚོན་བྱས་ཏེ།",
    "དེ་དང་ལྷན་ཅིག་བདེ་གཤེགས་རྣམས་ལ་རྗེས་སུ་ཆགས་པར་བགྱི་ཞེས་བརྩམས།",
    "རིམ་པར་ཐོ་༦བ་བེེ་ཅོན་པདྨ་རྡོ་རྗེ་ལ་སོགས་ཕྱག་ཀྱང་དེ་བཞིན་ནོ།",
    "དེ་ལྟར་རྫོགས་པར་བསྐྱེད་པར་དཀྱིལ་འཁོར་མཐོང་ནས་དངོས་པོ་ཐམས་ཅད་ཀྱིས།",
    "དག་པ་ཡང་ནི་དེ་ལས་ལྡོག་པའི་ངོ་བོ་ཙམ་ལ་རྣམ་པར་ཤེས་པར་བྱ།",
    "ཅིའི་ཕྱིར་འཛིན་པ་ལ་སོགས་རྣམ་པར་བྲལ་བ་རྟག་ཏུ་ཀུན་ལ་སྒྲུབ་པའི་ཕྱིར།",
    "དད་དང་བརྩོན་འགྲུས་རྣམ་པར་དག་པ་དེ་བཞིན་དྲན་པ་བསམ་གཏན་དག་པས་ཀྱང་།",
    "དམ་པའི་སྒོ་སྲུང་གཟུགས་ཏེ་ཤེས་རབ་རྣམ་པར་དག་པས་ཐམས་ཅད་ཡུལ་དུ་སྣང་།",
    "ཐམས་ཅད་དོན་དང་བདག་པོ་རྣམ་པར་རྟོག་པ་རབ་ཏུ་འཇུག་པ་རྣམ་པར་དག་པ་ཡིས།",
    "རྣམ་པར་སྣང་མཛད་དག་པ་ཆེ།",
    "གཟུགས་ལ་སོགས་པའི་རྣམ་པར་གྲོལ་བས་མངོན་སུམ་གྱིས་ནི་མཐོང་མིན་དེ་འཛིན་པ།",
    "དུས་གཅིག་འབྲེལ་པར་གྱུར་པ་གཟུགས་ལ་སོགས་པ་བཞིན་དུ་དེ་དག་གཟུང་འཛིན་མེད།",
    "སྐུ་ལ་སོགས་པ་རྣམས་ཀྱི་སྤྲོ་བའི་རིམ་གྱིས་སམ་ནི་དུས་གཅིག་བྱས་པ་ཡིས།",
    "ལུས་ཉམ་ཆུང་ན་ཆོ་ག་བཞིན་དུ་སྐུ་ཡི་རྡོ་རྗེ་སོགས་ལ་དབབ་པར་བྱ།",
    "དམ་པའི་སྔགས་ཀྱིས་བཟླས་པ་ཉིན་མཚན་མེད་པར་བྱའོ་སྔགས་ཀྱང་མ་འདྲེས་པའོ།",
    "གསུངས་པའི་བསྟོད་ཏྲེདང་མཆོད་ལ་སོགས་པ་རྫོགས་པར་བསྐྱེད་པ་བརྩོན་པའི་སྔགས་པ་ཡིས།",
    "འདུས་ནས་བདག་ལ་བློ་དང་ལྡན་པས་དངོས་པོ་ཀུན་གྱིས་ཐིམ་པར་བྱ།",
    "རིག་མ་དང་བཅས་ལུས་ཅན་ཐམས་ཅད་ཉི་མའི་དཀྱིལ་འཁོར་ལ་ནི་བསམ་པར་བྱ།",
    "དོན་དམ་པར་ཡང་དབྱེར་མེད་དབྱེར་མེད་མ་ཡིན་ཁ་ཅིག་འདོད་དེ་གཞན་ཕྱིར་ན།",
    "དེ་ནས་ལུས་ནང་ཐམས་ཅད་གསལ་བར་བྱས་ནས་ཀུན་དུ་དེ་ཉིད་མཐའ་ཡས་པས།",
    "རྣམ་པ་སྣ་ཚོགས་ཕྱག་མཚན་རྣམས་ཀྱང་ཡང་དང་ཡང་དུ་བློ་དང་ལྡན་པར་བྱ།",
