    "ཆུ་ཡི་དཀྱིལ་འཁོར་འབེབས་པར་བྱེད།",
    "མདུང་ཅན་མ་དང་ཀླུ་རྣམས་སྤྱན་དྲངས་ལ་ཡང་དག་པར་མཆོད་དེ་ཧཱུཾ།",
    "ཀླུ་གནས་པའི་ཆུ་མིག་ལ་སོགས་པར་ཀླུ་ཐམས་ཅད་ཀུན་དུ་སྐུལ་བར་བྱེད་པའི་ཁམ་ཕོར་ཁ་སྦྱར་ཏེ་བཞག་ལ།",
    "འདི་སྐད་དུ་བདག་ལ་བརྩེ་༧བ་དང་བཅོམ་ལྡན་འདས་ཀྱི་བཀས་ཀླུ་ཆེན་པོ་ཁྱེད་རྣམས་ཀྱིས་ཆར་ཕོབ་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་ཀླུ་དེ་རྣམས་ཆར་གྱི་རྒྱུན་རབ་ཏུ་འབེེབས་པར་བསམ་ཞིང་བཟླས་པ་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱི་རྔུབཀས་ཀླུ་དེ་རྣམས་ཀྱིས་ཆར་འབེེབས་པར་བྱེད་དོ།",
    "གལ་ཏེ་དེ་ལྟར་བྱས་ཀྱང་ཆར་མི་འབེེབས་ན།",
    "ཇི་ལྟར་འདོད་པ་བུ་རམ་དང་འོ་མ་དང་མར་ལ་སོགས་པ་སྦྱིན་སྲེག་བྱས་ན་དགའ་བར་གྱུར་ནས་གདོན་མི་ཟ་བར་ཆར་གྱི་རྒྱུན་འབེེབས་པར་བྱེད་དོ།་།",
    "གདོན་མི་ཟ་བར་ཆར་འབབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟར་བྱས་ན་ཡང་ཀླུ་རྣམས་ཆར་མི་འབེབས་ན།",
    "སྟེང་དུ་བསྒྲགས་པའི་ཕཊ་ཀྱི་སྒྲས་ནམ་མཁའ་ཀུན་དུ་ཁྱབ་པར་བྱས་ནས་ཤིན་ཏུ་འཇིགས་པར་གྱུར་ཅིང་ཁྲག་སྐྱུགས་པའི་རྒྱུན་རྣམས་ཀྱིས་ཆུའི་རྒྱ་མཚོ་བྱེད་པར་བལྟ་ཞིང་སྔགས་བཟླས་པར་བྱ་སྟེ།",
    "དེའི་ཚེ་མེ་ཐབ་གྲུ་གསུམ་བྱས་ལ།",
    "དུག་དང་སྐེ་ཚེ་དང་ལན་ཚྭ་དང་མྱོས་གེབྱེད་རྣམས་ཀྱིས་ཀླུའི་གཟུགས་བརྙན་བྱས་ལ།",
    "གཏུབས་ནས་ཁ་ལྷོ་རུ་བལྟས་པས་འཕགས་པ་སྟོབས་པོ་ཆེའི་སྔགས་སོ་སོའམ་མ་ལུས་པར་བརྗོད་ལ།",
    "འདིས་ནི་ངེས་པར་འཕགས་པ་སྟོབས་པོ་ཆེས་ཆར་འབེེབས་སུ་འཇུག་གོ་ཞེས་བྱ་བའི་མཐུ་ནི་རྣལ་འབྱོར་པ་ཐམས་ཅད་ལ་རབ་ཏུ་གྲུབ་པོ།",
    "ཞེས་བྱ་བ་ནི་ཇི་ལྟ་བ་བཞིན་དུ་འཕགས་པ་འདོད་པའི་རྒྱལ་པོའི་རྣལ་འབྱོར་དང་ལྡན་པས་བསྒྲུབ་བྱའི་གཟུགས་བརྙན་བྱས་ལ།",
    "དེའི་སྔགས་བརྗོད་ཅིང་སྔ་མ་བཞིན་དུ་རྡོ་རྗེ་ལྕགས་ཀྱུས་དགུག་པར་བྱ་བའོ།",
    "ཁ་སྦྱར་ལུས་སུ་འགུགས་པར་འགྱུར།",
    "ཆུང་མ་དང་བཅས་པ་རྣམས་གདོན་མི་ཟ་བར་འགུགས་པར་འགྱུར་བའོ།",
    "དེའི་རྣམ་པར་འཕྲུལ་པ་ནི་དཔལ་གནོད་མཛེས་ཞེས་བྱ་བ་སྟེ།",
    "བསྐུལ་བའི་ཚིག་དང་ལྡན་པའི་སྔགས་བརྗོད་ཅིང་དགུག་པར་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "སྐུ་ནི་རྣམ་པར་སྣང་མཛད་དེ།",
    "ལྷ་ཐམས་ཅད་ཕན་ཚུན་དགུག་པར་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར།",
    "རྡོ་རྗེ་ཀྱོ་བའི་ཁྱད་པར་གྱིས།",
    "ཅེས་གསུངས་སོ།",
    "སྒྲུབ་པ་པོ་རྣམས་ཀྱི་དགེ་ལེགས་ཐོབ་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཞི་བའོ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་འདི་སྐད་དུ་ཇི་ལྟ་བ་བཞིན་དུ་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་རྣལ་འབྱོར་དང་ལྡན་པས་སྔ་མ་བཞིན་དུ་རྣམ་པར་སྣང་མཛད་ཆེན་པོ་ཉིད་ཟླ་བའི་དཀྱིལ་འཁོར་དུ་གྱུར་པར་བསམས་ལ།",
    "འདས་མ་ཐག་པ་བཞིན་དུ་ཐུསྔགས་ལན་ལྔ་བཅུ་བརྗོད་ཅིང་ཞགས་པ་དང་ལྕགས་ཀྱུས་དགུག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གཡོན་པའི་གསུམ་པས་རྩེ་གསུམ་བསྣམས་པར་བདག་ཉིད་དམིགས་ལ།",
    "ས་བོན་གསུམ་གྱིས་བྱིན་ཀྱིས་བརླབ་པར་ལྟེབྱ་སྟེ།",
    "དེ་ནས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་ཉིད་སྔགས་བརྗོད་ཅིང་བཀུག་ལ་ཉེ་བར་ལོངས་སྤྱད་བྱེ་པར་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ཀུན་གྱི་ཕྱག་རྒྱའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་དུ་བྱས་ན་འཇིག་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་སྦྱོར་བ་མ་ཚང་བས་དངོས་གྲུབ་འཇིག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པར་བསྒོམ།",
    "ཞེས་ཀྱང་འཆད་པར་འགྱུར་རོ།",
    "ཡང་ན་ཡི་གེ་ཧཱུཾ་སྐབས་སྐབས་སུ་བརྗོད་པར་བྱ་སྟེ།",
    "འཇིག་རྟེན་ཀྱི་ཁམས་ཐམས་ཅད་ཀྱི་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་སྟེད་ཀྱི་འཕགས་མ་རལ་པ་གཅིག་མའི་གཟུགས་རྣམས་ཀྱིས་པྱ་ནམ་མཁའི་དབྱིངས་ཁྱབ་པར་ཀུན་དུ་རྣམ་པར་འཕྲུལ་པ་སྐྱེད་པར་བྱེད་པའི་ཡེ་ཤེས་ནི་ཀུན་དུ་རྣམ་པར་འཕྲུལ་པའི་ཡེ་ཤེས་ཏེ།",
    "དེ་དང་ཡང་དག་པར་སྦྱོར་བས་ན།",
    "བཀུག་ནས་ཉེ་བར་སྤྱད་པར་བྱ།",
    "ཞེས་བྱ་བས་ནི་འདི་སྐད་དུ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་གྱུར་པར་བྱས་ནས་བདག་ཉིད་རལ་པ་གཅིག་མ་ཁ་སྤུ་མ་གཏོགས་པ་ཕྱག་དང་ཞལ་ལ་སོགས་པ་རྣམས་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པ་དང་མཚུངས་པ་སྟེ།",
    "ཉེ་བར་ལོངས་སྤྱོད་པར་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ཅེས་བྱ་བས་ནི་འདི་སྐད་དུ་བདག་ཉིད་འདས་མ་ཐག་པ་བཞིན་དཔལ་རྟ་མགྲིན་གྱི་རྣམ་པ་ཅན་གྱི་འཕགས་མ་ཁྲོ་གཉེར་ཅན་དེ་དང་ལྡན་པར་བསམས་ལ།",
    "སེམས་བརྟན་པར་གྱུར་པའི་རྣལ་འབྱོར་པས་འདས་མ་ཐག་པའི་དངོས་གྲུབ་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར་འགོག་པ་༤ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔགས་པས་འབུམ་དུ་བཟླས་བྱས་ནས།",
    "ལས་རྣམས་ཐམས་ཅད་བྱེད་པར་བཤད།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔགས་ཀྱི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "བསད་ན་མྱུར་དུ་འགྲུབ་པར་འགྱུར།",
    "ཁྲག་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྲོ་བོ་ཐམས་ཅད་ནི་དྲག་པོའི་ལས་རབ་ཏུ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དང་།",
