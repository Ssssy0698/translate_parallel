    "རོགས་ཤིག་ཡོད་བསམ་དགའ་བསྡད་གདའ།",
    "མཛེས་ཁ་དོག་མེད་བསམ་སྡུག་བསྡད་གདའ།",
    "རྒྱུག་བཏང་ན་ཐང་ཆེན་རྡིབ་ས་གདའ།",
    "བྲག་དཀར་སྒོ་ཁྱི་གྱོང་གདའ་ཟེར།",
    "བང་ཆེན་འདོ་བ་གྱོང་གདའ་ཟེར།",
    "རྟ་རྔ་ཆད་ཟེ་ཟླུམ་གཡུགས་བཞག་གདའ།",
    "རྩྭ་ཀུ་ཤ་འཇག་མ་གང་ཡང་འདུག།",
    "ཆུ་ཨག་ལེ་བདུད་རྩི་གཡང་ཆབ་འདུག།",
    "ད་མདུད་མཁན་ཡོང་ན་ཡོང་རན་གདའ།",
    "ད་མདུད་མི་ཡོང་ན་ཡོང་རན་གདའ།",
    "ས་ཁྱུག་ཁུག་གཅིག་ཏུ་སྐྱེལ་རན་འདུག།",
    "ཡུལ་ཁུག་ཁྱུག་གཅིག་ཏུ་བརྡབ་རན་འདུག།",
    "རྟ་རག་དཀར་རྟོད་ཐག་གྲོལ་བསྡད་གདའ།",
    "རྗེས་ར་མདའ་ཡོད་ན་འགྲོ་རན་གདའ།",
    "འགྲོ་རན་ལེའི་མ་ཚད་ཕྱིས་ཚར་གདའ།",
    "ེལ་ལུང་པ་རྟ་ཁྱུས་ཁེངས་བསྡད་འདུག།",
    "སྤང་རི་སྔོན་ནོར་གྱིས་ཁེངས་བསྡད་འདུག།",
    "བཞག་བཞག་དུས་རྟ་བརྒྱའི་རྒྱན་འདྲ་ཡིན།",
    "ཡར་ལྟོས་དང་མི་རྟ་ཁྱུ་ཞིག་གདའ།",
    "ར་ཆེ་གདའ་རྟ་སྒ་བརྒྱབ་ན་ཟེར།",
    "ཁམ་དམར་གཙོད་ལ་རྭ་ཅོ་གདའ།",
    "བྲེ་སེར་འབྲོང་ལ་རྭ་ཙོ་གདའ།",
    "ཁ་དཀར་རྐྱང་ལ་རྔོག་ཁྲུ་གདའ།",
    "སྨྱུག་ཆུང་དྲེལ་ལ་རྔོག་ཁྲུ་གདའ།",
    "མ་བསམ་རྒྱུ་ཞིག་བསམ་བསྡད་གདའ།",
    "རྐྱང་གྭ་མའི་བློ་རྟ་བསམ་བསྡད་གདའ།",
    "མ་བསམ་རྒྱུ་ཞིག་བསམ་བསྡད་གདའ།",
    "འབྲོང་བྲེ་སེར་སྒོ་ཟོག་བསམ་བསྡད་གདའ།",
    "ན་དམར་ཡག་རིག་དུས་སྡོད་འདོད་ལངས།",
    "ཐང་སྐྱ་རིག་དུས་འགྲོ་འདོད་ལངས།"
  ]
