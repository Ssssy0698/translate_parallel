    "མི་རིང་བར་སླར་ཚོས་ང་ལ་ཕུང་པོ་རྩིས་སྤྲོད་སྐབས་ཕྲུ་གུའི་ངོ་གདོང་ལ་བལྟ་བཟོ་གཏན་ནས་བསྡད་མི་འདུག་།",
    "གདུག་མི་ཚང་མས་མགོ་ཡར་བཏེགས་ཏེ་ཐེ་ཚོམ་གཅོད་བཏང་རྗེས་ཁོ་གཉིས་ལ་ཁ་ཡ་མ་བྱས་པར་ངང་ཀྲུའུ་ཞི་སྟེགས་བུའི་ཐོག་ཏུ་ཡོད་པའི་མི་རྣམས་དབྱུགས་བཞག་འདུག་ཁོ་གཉིས་ལོག་ཡོང་ལ་བལྟ་བ་དང་།",
    "ང་རྒུན་འབྲུམ་ཟ་འདོད་འདུག་ཉེན་རྟོག་པ།",
    "ད་དུང་སྣ་ཁུག་ཁོ་ལའང་པུ་ཙི་ཟེར་གྱི་མི་འདུག་གམ།",
    "དངོས་མཚོན་པར་བྱས་ཡོད་པས་འགྲེལ་ལྷག་མ་མི་ཞིག་ལ་མཚོན་ན་བསམ་བློ་གཏོང་ཕྱོགས་ཞིག་རྒྱག་དོན་མི་འདུག་སྙམ།",
    "ངས་ཚང་མ་ཤེས་ཀྱི་འདུག་རྒན་འགའི་བྱ་ཐབས་ཏེ།",
    "ཁྱེད་རང་མི་ཚུལ་ལྡན་ཞིག་བྱས་ན་འགྲིག་མི་གཞན་ལ་འོས་མིན་གྱི་གནོད་པ་མ་སྐྱེལ།",
    "སྐབས་འདིར་ཁོ་བོས་སྐུ་ཞབས་རང་གྲོལ་ལགས་ཀྱི་ལམ་གྱི་བདེན་པའི་ཐད་ནས་གླེང་རྒྱུ་ཡིན་ཙ་ན།",
    "དུས་དེ་ཙ་ན།",
    "ཁྱེད་ཀྱི་འཕྲིན་ཡིག་ལག་འབྱོར་བྱུང་བས་ང་རང་དགའ་སྤྲོ་ཆེན་པོ་སྐྱེས་ཡོད།",
    "འོན་ཀྱང་རང་སྲོག་བཅད་ནས་རང་ཉིད་ཀྱིས་ཕམ་ཁ་ཉོ་དགོས་བྱུང་ཡང་།",
    "མིའི་འཚོ་གནས་ཀྱི་བདེ་སྡུག་མཐའ་དག་ལོགས་སུ་བསྐྱུར་འདུག་པས།",
    "དེ་ནི་ལོས་ཡིན་ཏེ།",
    "འདི་ལྟར་བསམ་བློ་གཏོང་དགོས་འདུག་སྟེ།",
    "རྩོམ་ཧྲིལ་བོའི་ཁམས་ལ་བལྟས་ན་ལྷོད་ཆགས་གྲ་འགྲིག་ཅིག་འདུག་ན་ཡང་།",
    "དེ་དག་ནི་ཁོ་རང་དངོས་སུ་བརྒྱུད་པ་དང་།",
    "དོན་གྲུབ་རྒྱལ་གྱི་བརྩམས་སྒྲུང་འབྲུག་མཚོ་དང་པད་མཚོ་སོགས་ལ་བལྟས་ན་དེ་ཉིད་ཁོ་རང་དངོས་སུ་བརྒྱུད་མྱོང་བའི་སྣང་བ་ཞིག་སྟེར་བར་བྱེད་ལ།",
    "དེ་ཉིད་སྐུ་ཞབས་ཞོགས་དུང་ལགས་ནས་ཚན་ཟུར་ལྔ་རུ་བཀར་འདུག་སྟེ།",
    "འཐོབ་ཆ་ཙམ་ལ་ཡིད་ཚིམས་ནས་འདུག་པ་དང་རྦད་དེ་དུང་ནང་བཞིན་བག་ཆགས་དོང་སྤྲུགས་བྱེད་པར་བརྩམས་ན་དེའི་མཇུག་འབྲས་ཚད་ག་འདྲ་ཞིག་ཡིན་མིན་འུ་ཚོས་ཤེས་འོང་།",
    "སྐབས་འདིར་འུ་ཚོས་འདི་ལྟར་བསམ་གཞིག་གཏོང་དགོས་ཚོད་འདུག་སྟེ།",
    "དེ་ལ་རྒྱུ་རྐྱེན་ཁ་ཚ་དགོས་གཏུགས་ཤིག་འདུག་སྟེ།",
    "འདི་ནི་གང་དེའི་གཞུང་ལུགས་ཀྱི་བར་གསེང་གང་རུང་དུ་འཛུལ་ནས་ཤ་འཚོལ་རུས་འཚོལ་བྱེད་དགོས་མི་འདུག་སྟེ།",
    "དགག་པ་རྒྱག་དགོས་ས་ན་དགག་པ་བརྒྱབ་འདུག་ལྷག་པར་དུ།",
    "འདི་ལ་བལྟས་ན་ཡང་རང་གྲོལ་ལགས་ཀྱི་འཆི་བ་ནི་ཚོར་ཤེས་ཀྱིས་དེད་པའི་འཆི་བ་ཞིག་མིན་པ་གསལ་བོར་ཤེས་འོང་།",
    "འུ་ཚོས་མི་བུ་རང་ཉིད་ཀྱི་ཀླད་པ་བཀོལ་ཏེ་བསམ་གཞིག་ཅིག་གཏོང་དགོས་ཚོད་འདུག་དེ་ཡང་།",
    "བོད་རིགས་འདི་སྔར་བཞིན་རྨོངས་མུན་གྱི་ཁྲོད་དུ་མགོ་བོ་འཐོམ་ནས་འདུག་པས།",
    "རང་གྲོལ་ཞིབ་འཇུག་ཅེས་པའི་ཐ་སྙད་འདི་བྱུང་ནས་དུས་ཡུན་རིང་བོ་ཞིག་འགོར་མི་འདུག་ལ།",
    "འདི་ཉིད་ལ་གྲུབ་འབྲས་འོས་འཚམ་ཞིག་ཀྱང་ལོན་མི་འདུག་ཁོ་བོས་སྙམ།",
    "རྒྱལ་ཁབ་ཕྱི་ནང་གང་དུ་ཡང་ཁོང་ཉིད་ལ་ཞིབ་འཇུག་བྱེད་མཁན་མང་པོ་འདུག་ཅིང་།",
    "དོན་ལ་དེ་ནི་རང་ཉིད་རྙིང་ཞེན་གྱི་བག་ཆགས་ཟབ་དྲགས་པའི་རྐྱེན་དང་རང་གྲོལ་ལ་རྒྱུས་ལོན་མེད་པའི་ལན་པ་ལས་གཞན་གང་ཡང་མ་ཡིན་ཏེ།",
    "ཆུའི་སྣང་བརྙན་བརྒྱུད་ནས་དོན་དག་ཅི་ཞིག་སྟོན་གྱི་འདུག་གམ།",
    "རྨ་ཆུ་དང་འབྲི་ཆུའི་མིང་སྤྱད་དེ་སྣང་བརྙན་འདི་དག་ལ་བོད་ཀྱི་བྲོ་བ་ཤུགས་ཆེན་ལྡན་པར་བྱས་འདུག་ལ།",
    "ཆུ་ཀླུང་ཞིག་ལ་མཚོན་ན་དེ་ལ་རྒྱུན་མི་ཆད་པའི་རང་བཞིན་ལྡན་པ་ཕུད་ད་དུང་རང་བཞིན་གཞན་ཞིག་ལྡན་པ་ནི།",
    "སྐབས་སུ་བབས་པ་ནི་སྙན་ངག་འདིས་མི་རིགས་སུ་ཞིག་ཡིན་རུང་རང་ཉིད་ཀྱི་མི་རིགས་ལ་བཅངས་པའི་དུངས་པ་དང་ཞེན་པ་གཉིས་གསལ་བོར་མཚོན་པར་བྱས་ཡོད།",
    "ཡོད་ཚད་རྩོམ་མཁན་སྒེར་གྱི་ཉམས་མྱོང་ལ་རག་ལས་འདུག་ཧེ་བག་ཡོད་པ་ནི་རྩོམ་ལུས་ལ་ལ་ཞིག་སྒེར་གྱི་ཉམས་མྱོང་ཐད་ཀར་རྩོམ་གྱི་བརྗོད་བརྩམས་སྒྲུང་ཁྲོད་ཀྱི་མི་སྣ་ང་དང་དོན་གྲུབ་རྒྱལ་གྱི་ལྟ་ཚུལ།",
    "ད་དུང་སྐབས་སྐབས་སུ་གཏམ་དཔེ་སྤྱད་པ་མང་འདུག་པའམ་ཡུལ་ལྗོངས་ཞིབ་འབྲི་བྱས་པའི་ཚིག་སྦྱོར་ཡང་མང་དྲགས་པའི་ཚོར་བ་སྦྱིན་འོངས།",
    "ང་རང་ཉིད་ཀྱི་སེམས་སུ་ཡོད་པའི་དཔལ་ཁོང་ཉིད་མི་བུ་གང་འདྲ་ཞིག་ཡིན་པ་དང་།",
    "ང་རང་ལོ་རབས་བརྒྱད་ཅུ་བའི་ལོ་མཇུག་ཏུ་སྐྱེས་པ་ཡིན།",
    "སྒྲུང་གཏམ་རྩོམ་པ་པོ་ཚེ་རིང་དོན་གྲུབ་ལགས་ཀྱིས་ཞེས་པའི་རྩོམ་དེའི་ནང་དུ་དོན་གྲུབ་རྒྱལ་གྱི་སྐོར་བྲིས་འདུག་ལ།",
    "འོན་ཀྱང་འཇིག་རྟེན་དུ་ཚེ་སྲོག་བློས་བཏང་བ་དང་རང་སྲོག་བཅད་ཟིན་པའི་མི་ཐམས་ཅད་རླབས་ཆེན་ཡིན་ནམ་ཟེར་ན།",
    "གལ་ཏེ་ནམ་ཞིག་བོད་ཀྱི་རྩོམ་རིག་གསར་བ་འདི་འཛམ་གླིང་རང་བཞིན་གྱི་རྩོམ་རིག་ཏུ་གྱུར་པ་དང་།",
    "ང་རང་ལོ་ན་གསུམ་བཞིའི་སྐབས་དག་ཏུ།",
    "རྐོ་དོང་ནང་ན་ཅི་ཞིག་འདུག་ཟེར།",
    "ད་ལྟ་ངའི་ཚ་བོས་དེ་དག་རྐོ་དུང་དུ་སྐྱེས་པ་ཡིན་པར་ཡིད་ཆེས་བྱེད་ཀྱིན་འདུག་ལ།",
    "བོད་ལ་ཅི་གང་ཞིག་ཡོད་རྒྱུ་ན་ཞེས་ཟེར་མཁན་མང་བོ་འདུག་འོན་ཀྱང་དེ་ངས་བྱེད་ལ་བཏང་ཟེར་མཁན་མེད།",
