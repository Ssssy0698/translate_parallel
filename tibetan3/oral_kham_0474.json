    "ཉི་མ་དོན་གྲུབ་ཀྱིས་སྟོད་ལྭ་དང་དོར་མ་གསར་པ་གྱོན་འདུག་ལ་དེ་ནི་ཕལ་ཆེར་ཀུང་ཧྥེར་འབྲུ་ཁྲལ་འཇལ་དུ་འགྲོ་སྐབས་ཁྱིམ་མིས་ཉོས་ཡོང་བ་དེ་དག་ཡིན་པ་འདྲ།",
    "ཨ་ཙི།",
    "དགུན་ཁར་ཆུ་མིག་དེའི་ཉེ་འཁོར་དུ་ཆབ་རོམ་གྱི་གུར་ཁང་ཆགས་འདུག་ཅིང་།",
    "དེ་ལྟར་འདུག་དུས།",
    "འབྲོ་བསམས་ཀྱང་མདུན་གྱི་ལམ་བུ་ཁོའི་གཟུགས་པོ་རྒྱགས་པ་དེས་བཀག་འདུག་པས།",
    "ཁོ་ཚོས་ལུག་ཉོས་ནས་ལུག་རྒྱུད་སྤེལ་རྒྱུའི་སྐོར་ཁོ་ན་ལབ་བཞིན་འདུག་པ་དང་།",
    "ཡ་ཕུག་ཏུ་གསེར་རྩི་བྱུགས་པའི་འབག་སྐུ་ལྷམ་མེར་ལྷན་ནེར་ལྷང་ངེར་བཞུགས་འདུག་ལ།",
    "ངས་ཁ་གདངས་ནས་མགོ་འགྱོགས་སྐབས་ཉི་མ་དོན་གྲུབ་ཀྱི་གདོང་ལ་པྲ་ཚགས་ཀྱི་འཛུམ་ཞིག་རྒྱས་ནས་མཐོ་ས་ནས་ང་ལ་བལྟས་འདུག་པ་མཐོང་།",
    "བསང་དུད་ལྷག་མ་ཞིག་སྔོ་ལིང་ལིང་དུ་བར་སྣང་དུ་འཐིབས་བཞིན་འདུག་ལ།",
    "དེ་ལ་གསལ་སྒྲོན་སྔར་མལ་ནས་འགུལ་ཙམ་ཡང་མི་བྱེད་པར་འདི་ལྟར་བལྟས་ཏེ་བསྡད་ན་ཆུ་ནི་མི་འགྲོ་ང་ནི་འགྲོ་བཞིན་འདུག་གོ་ཟེར།",
    "ལྟ་བཞིན་ལྟ་བཞིན་སྣང་བ་ཞིག་ལ་བཞུར་ནས་འགྲོ་བའི་རྒྱུགས་ཆུ་འགུལ་མེད་དུ་གྱུར་ཅིང་མ་གཞིར་འགུལ་མེད་དུ་སྡོད་པའི་ང་རང་མགྱོགས་མྱུར་ངང་སྒྲུབ་ལོགས་སུ་བསྐྱོད་བཞིན་འདུག་ཚོར་བའི་གོ་འཛོལ་དེ་ནི་ཇི་ལྟར་བྱུང་བ་ཡིན་ནམ།",
    "མ་གཞིར་ཨ་སྐྱོ་པའི་ཐག་རིང་ལ་ལྟ་བའི་མཐོང་སྣེ་རུ་ཉི་མ་ལྷ་ས་ཡོད་འདུག་ཉིན་དེར།",
    "གདོང་ཡོངས་གཉེར་མས་ཁེབས་འདུག་ལ།",
    "ངེད་ཚང་དུ་ཁྱིམ་སྲོལ་དང་འགལ་པའི་ལས་ཅི་ཞིག་རྩོམ་པ་ནི་དཔེ་མི་སྲིད་པ་ཞིག་སྟེ།",
    "ང་ལ་ཡང་སྐད་མི་ཤོར་བའི་ཐབས་མི་འདུག་ང་ལ་མཚོན་ན།",
    "ད་ལྟ་ཡང་ངའི་བློ་རིག་ཏུ་ཤོང་ཐུབ་པ་ཞིག་མི་འདུག་དེ་བས།",
    "ང་རང་ག་པར་ཁ་ཕྱོགས་རྒྱུ་དང་།",
    "ངས་སྤོ་བོ་རལ་པ་ཅན་གྱིས་མཛུབ་བར་གྱི་བསྙུགས་འཕྲོར་ལུས་པའི་ཕྲེང་རྡོག་དེ་ལས་ཅི་ཞིག་ཇི་ལྟར་མཐོང་པའི་ཐད་ལ་བསམ་བློ་འཁོར་ཀྱིན་མི་འདུག་ཕྲེང་རྡོག་དེས་ཅི་ཞིག་ལབ་པ་ཡིན་ནམ།",
    "ཐར་འཕེལ་གྱིས་ངུ་བཤུམ་བྱེད་བཞིན་འདུག་ཁོས་ཀྱང་འཆི་བ་ཞེས་པ་དེའི་གདུག་རྩུབ་ཚོར་ཡོད་དམ།",
    "ཀུན་གྱིས་ཨ་ཙི་ཙི།",
    "འབྲུག་བྱམས་ལ་གཡར་འདུག་པ་འདི་ཅི་ཡིན་ནམ་ཟེར།",
    "ཐུག་འདུག་ཨ་ཙི།",
    "སྒོར་བཏོན་ཡོང་རྒྱུ་ཡང་དཀའ་ལས་ཁག་པོ་འདུག་ཨང་།",
    "ད་ནོར་ལུག་རི་འགོར་ཕུད་རན་འདུག་ཅེས་བཀའ་བསྒོ་བྱས་བྱུང་།",
    "དེ་ལ་ངའི་ཨ་ཅག་འབྲུག་སྐྱིད་ཀྱི་གདོང་བར་སྔར་བཞིན་རྣམ་འགྱུར་མེད་པར་གནག་ནས་འདུག་ཅིང་།",
    "སྣང་བ་ཞིག་ལ་ང་རང་གཙང་པོ་དེས་ཁུར་ནས་འགྲོ་ཞིང་།",
    "མག་པ་ང་རང་མ་ཡིན་ནོ།",
    "ཡིན་ན་ཡང་ང་ལ་ཐ་སྙད་དེར་བསམ་བློ་གཏོང་ཁོམ་མི་འདུག་སྟེ།",
    "དེ་ལྟ་བུའི་ཡང་ཟོར་ལྡན་པའི་ཁ་བའི་གོམ་སྒྲའི་ཁྲོད་ང་རང་རྨི་ལམ་གྱི་ཞིང་དུ་ཕྱིན།",
    "ཤར་ཕྱོགས་ཀྱི་མཁའ་མཐའ་ན་ངའི་རྩེད་གྲོགས་གསལ་སྒྲོན་གྱི་མཁུར་ཚོས་ངོས་ཀྱི་དམར་མདངས་དེ་ལྟ་བུའི་མཚམས་སྤྲིན་ཞིག་འཁྲིགས་འདུག་ཀྱང་འདུ་བས་ན།",
    "དར་མ་ཚོའི་ལག་པར་རྩལ་ཤུགས་ཀྱིས་ཁེངས་འདུག་ཉིན་དེར་སྣང་བ་ཞིག་ལ་ཕུ་བོ་འབྲུག་བྱམས་ཀྱི་ལག་པ་དེའི་རྩལ་ཤུགས་དེ་བས་ཀྱང་ཆེ་བ་ལྟར་སྣང་།",
    "ད་ནི་ངའི་བུ་ཆེན་པོ་ཆགས་འདུག་ཨང་།",
    "བོད་རྩིས་ཀྱིས་ང་རང་བོ་ལོ་བཅུ་གསུམ་ལ་བསླེབས།",
    "མག་པ་ང་རང་མ་ཡིན་ནོ།",
    "མཇུག་འབྲས་ནི་ང་དང་གསལ་སྒྲོན་ཡིག་རྒྱུགས་འཕྲོད་འདུག་ཅིང་།",
    "མ་གཞིར་ང་རང་མི་ལོ་བཅུ་གསུམ་ལ་འཚོ་ཞིང་གནས་སའི་ལུང་པ་དེ་ནི་དེ་འདྲ་ཞིག་ཡིན་ནམ།",
    "མར་ནང་ལུང་པའི་རི་ཁྱིམ་ཡོད་ཚད་སྤྱན་འོག་ཏུ་བསྡུས་འདུག་ངས་དེ་ལྟར་ཕྱིར་མིག་ལྟ་དུས།",
    "ཚུལ་དེ་ལ་ཨར་འདམ་དང་རྣོ་ལྕགས་ཀྱི་རང་བཞིན་དུ་གྲུབ་པའི་བརྩེ་མེད་ཀྱི་རྣམ་འགྱུར་གྱོང་པོ་ཞིག་མངོན་འདུག་ན་ད་ནི་ཁ་བ་ཞིག་དབབ་རྒྱུ་བྱུང་ན་དགའ་བ་ལ་ཨང་།",
    "དེའི་ནང་དུ་ང་རང་ཉན་པར་དགའ་བའི་བོད་ཀྱི་དམངས་གཞས་ཁ་ཤས་བླུགས་ཡོད།",
    "ངས་ཁ་པར་ཡར་བླངས་ནས་རྣ་འགྲམ་དུ་བཞག་ཙ་ན།",
    "ང་རང་ཤོག་བྱ་ཞིག་ཡིན་ཚེ།",
    "དང་ག་ལ་ཏེ་ང་རང་ཤོག་བྱ་ཞིག་ཡིན་ན།",
    "རྡོ་རྗེ་དྲིལ་བུ་དེ་ཡང་ཁ་སྦུབ་ཏུ་བརྩེངས་འདུག་རྣམ་པ་དེ་འདྲ་མཐོང་བ་ན།",
    "ད་དུང་དེ་ལ་ཀྲུང་ཧྭ་མིང་གོའི་ཐམ་ཀ་བརྒྱབ་ཡོད་པའི་ས་ཡིག་འདུག་ཟེར།་",
    "ངས་ཁ་པར་ཡར་བླངས་ནས་རྣ་རྩར་བཞག་ཙ་ན།",
    "མལ་སའི་ནང་ང་ལ་འཐམ་པའི་བསྟན་འཛིན་སྒྲོན་མེ་ལ་ནོར་འདུག་ཅེས་བཤད།",
    "རྣམ་ཀུན་འགྲོ་འདུག་གང་ཡིན་ཡང་ཁོ་མའི་ཁམས་དང་།",
    "ཐར་འཕེལ་གྱིས་ང་ལ་ཁ་པར་ལས་ལྕགས་སྐད་འཛེར་འཛེར་གྱིས་གནས་ཚུལ་ཛ་དྲག་ཏུ་འགྲོ་བཞིན་འདུག་ཟེར།་",
    "ད་ནི་ལག་པ་རིང་འདོད་ཀྱི་ཕུ་རུང་ཐུང་བའི་དཔེ་རུ་གྱུར་འདུག་ངས་ཀྱང་དེ་ལྟར་ཐར་འཕེལ་ལ་གཏམ་དཔེ་ཞིག་འཐེན་ཞིང་།",
    "སྔར་མལ་ན་ཁུ་སིམ་མེར་གནས་འདུག་ཡིན་ན་ཡང་དེའི་སྒང་དུ་སྡོད་མཁན་དེ་གཉིས་ལ་ཅི་འདྲའི་འགྱུར་བ་མང་པོ་ཞིག་བྱུང་ཡོད་ཨང་།",
    "དེ་ལྟར་འདུག་དུས།",
    "ཐར་འཕེལ་ཉིན་དེར་ཡར་སྔོན་ཁོ་དང་ཟླ་སྒྲོན་ཉལ་སའི་གད་པ་དེའི་ཁ་རུ་རྡོ་བཞིན་འགུལ་མེད་དུ་འདུག་དུས།",
    "༡༩་ ཕྱིས་སུ་ཐར་འཕེལ་གྱིས་ང་ལ་ཉིན་དེའི་མཐོང་བ་བརྗོད་དུས་སྐད་ལ་རང་ཉིད་ལ་ཟུར་ཟ་བྱེད་པའི་གདངས་འདྲེས་འདུག་།",
    "ཞོགས་པའི་ཉི་འོད་སེར་པོ་དེར་དེ་ལྟར་འཕྲད་བྱུང་བ་དེ་མི་ཚེ་འདིར་བརྗེད་ཐབས་མི་འདུག་ཟེར།",
    "ལོ་ཕྱེད་ཙམ་ལ་བྱེས་སུ་འཁྱམས་ནས་འདུག་དུས།",
