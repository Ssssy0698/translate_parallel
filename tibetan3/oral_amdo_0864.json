    "དེ་ནི་མ་གྲུབ་པས་ཁྱོད་ཀྱིས་དམ་བཅས་པ་ཡང་ཉམས་པ་ཡིན་ནོ།",
    "དགེ་སྦྱོང་གི་འབྲས་བུ་དང་།",
    "ཉོན་མོངས་པའི་གཞི་རྣམས་སྲིད་དོ།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ཐམས་ཅད་རྣམ་པར་གཞག་པ་ཡིན་ཏེ་ཚིག་གིས་ཇི་སྙེད་ཅིག་བསྟན་པར་ནུས་པས་ཕྱོགས་འདིས་རང་གིས་རྟོགས་པར་བྱའོ།",
    "ཉོན་མོངས་རྣམས་དང་གྲོལ་དེ་བཞིན།",
    "ཇི་ལྟར་རི་མོ་མཁན་གྱིས་གཟུགས།",
    "ཇི་ལྟར་རང་གིས་འདམ་གཡོས་པས།",
    "རྣམ་པར་རྟོག་བའི་དུག་གིས་བཅིངས།",
    "དེས་ཀྱང་ཚོགས་བསགས་ཀུན་རྫོབ་ཏུ།",
    "གང་གིས་ཡང་དག་དོན་དུ་གཟིགས།",
    "ཉོན་མོངས་པ་ཡི་རྣམ་པ་མེད།",
    "གང་གིས་ཕ་རོལ་ཕྱིན་པར་འགྱུར།",
    "ཕྱོགས་གཅིག་ཙམ་མོ།",
    "གང་རྣམས་འདོད་པ་དེ་དག་གི་གཏན་ཚིགས་ལས་གྲུབ་པར་མི་འགྱུར་གྱི།",
    "གལ་ཏེ་རེ་ཞིག་ཁྱེད་ཅག་གཏན་ཚིགས་མེད་པར་གཞན་པ་ཉིད་དུ་འདོད་ན་ནི་དེའི་ཚེ་ངའི་ཡང་གཏན་ཚིགས་མེད་པ་ཁོ་ནར་གཅིག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "འདིར་གལ་ཏེ་ཁྱེད་ཅག་གཏན་ཚིགས་མེད་པ་ལས་ཡོད་པ་ཉིད་ཡིན་ན་ནི་བདག་ཅག་གི་མེད་པ་ཉིད་ཀྱང་གཏན་ཚིགས་མེད་པ་ལས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དཔེར་ན་སྨྲ་བ་པོ་བདག་གིས་དེ་རིང་ཟས་ཞིམ་པོ་མྱོང་ངོ་ཞེས་ཟེར་ན།",
    "ཇི་ལྟར་གང་གི་ཕྱིར་སྨིག་རྒྱུ་རང་བཞིན་མེད་པའི་ཕྱིར་ཡོད་པ་མ་ཡིན་པ་ལས་སྐད་ཅིག་ཙམ་ཡང་མ་ཡིན་པ་དེ་ལྟར་སྣམ་བུ་ལ་སོགས་པ་རྣམས་ལ་ཡང་སྣལ་མ་ལ་སོགས་པའི་ཡན་ལག་རྣམས་ཀྱིས་ཕྱེ་ཞིང་གཟིགས་ན་ཡོད་པ་མ་དམིགས་ཏེ།",
    "འདི་ལ་འབྲས་བུ་ཡོད་པ་གང་དག་ཡིན་པ་དེ་དག་གི་རྒྱུ་ནི་ཡོད་པ་མ་ཡིན།",
    "གང་དག་འབྲས་བུ་མེད་པ་དག་གི་ཡང་རྒྱུ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གང་དག་འབྲས་བུ་ཡོད་པ་དང་མེད་པ་དག་གི་ཡང་རྒྱུ་ཡོད་པ་དང་མེད་པ་དེ་དག་གང་ཡང་རྒྱུ་ཡོད་པར་མི་འགྱུར་ཏེ།",
    "གཉི་གའི་སྐྱོན་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་གིས་ཡོད་པ་དེའི་མཚན་ཉིད་འཛིན་པ་དེས་མེད་པ་མ་ཡིན་ནོ།",
    "གང་གིས་མེད་པ་དེའི་མཚན་ཉིད་འཛིན་པ་དེས་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་ཕན་ཚུན་ལྟོས་པ་ཡིན་པའི་ཕྱིར་གཉི་གའང་རྒྱུ་ཉིད་དུ་ཐལ་བར་འགྱུར་ལ།",
    "གཉི་ག་རྒྱུ་ཉིད་དུ་ཐལ་ན་ཡང་འབྲས་བུ་མེད་དོ།",
    "བྱས་པ་ཉིད་དུ་ཡང་ཐལ་བར་འགྱུར་ཏེ།",
    "བྱས་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དེའི་རིགས་པ་སྤང་བའི་ཕྱིར་ངའི་འདོད་པ་ལས་ཁྱོད་ཀྱི་ཡང་ཡོད་པ་གང་ཡིན་པ་དེ་ངའི་མེད་པའོ།",
    "ཅི་སྟེ་ཁྱེད་ཅག་གི་འདོད་པ་ལས་གྲུབ་ཀྱི།",
    "འདི་ནི་བདག་ཅག་གི་བརྡ་ལས་སོ་ཞེ་ན།",
    "འདི་ལྟར་གང་ཁྱེད་ཅག་གིས་བརྡ་མ་གྲུབ་པ་སྟེ།",
    "འདིར་ཁྱེད་ཅག་གི་གཏན་ཚིགས་གང་ཡིན་པ་དེ་གལ་ཏེ་བསྒྲུབ་པའི་མཚན་ཉིད་དུ་གྱུར་པ་དེའི་ཚེ།",
    "དཔེར་ན་ཁྱེད་ཅག་གི་དམ་བཅའ་བ་ནི་སྒྲ་རྟག་སྟེ།",
    "བདག་ཅག་གི་དམ་བཅའ་བ་འདི་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དམ་བཅའ་བའི་དངོས་པོ་མེད་པ་ལ་འདི་གང་གི་གཏན་ཚིགས་སུ་འགྱུར།",
    "གང་གི་ཚེ་ཡི་གེ་ཕྲ་ཡོད་པ་དེའི་ཚེ་ཡི་གེ་ཧེ་དང་།",
    "གལ་ཏེ་རྒྱུ་དང་འབྲས་བུ་ཞེས་བྱ་བ་མ་གྲུབ་མོད།",
    "མི་ཤེས་པ་ཡིན་ན་ཡང་སྡུག་བསྔལ་བ་དང་བདེ་བ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "གཉི་ག་སྨྲ་བ་རྣམས་ལ་ནི་གཉི་གའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་བདག་སེམས་པ་ཅན་དུ་སྐྱེ་བ་དེའི་ཚེ་སེམས་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "བདག་ཡོད་དེ་བདག་གི་བའི་དངོས་པོ་ཡོད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་བདག་གིས་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པ་བཀག་པ་མ་ཡིན་ཏེ།",
    "ཀརྞ་དང་ཕན་བཞིན་དུ་གཅིག་ཉིད་ཡིན་ན་ནི་དེའི་ཚེ་ཐམས་ཅད་བུམ་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ཕྱིན་ཅི་ལོག་པར་ཐལ་བར་འགྱུར་བ་དང་།",
    "གང་དག་གི་གཅིག་པ་ཉིད་དེ་དག་ལ་ནི་སྐྱོན་འདི་ཡོད་ཀྱི་བདག་ཅག་ནི་གཞན་པ་ཉིད་དུ་ཁས་ལེན་པའི་ཕྱིར་སྐྱོན་འདི་མེད་དོ།",
    "ཇི་ལྟར་གང་གི་ཕྱིར་ནམ་མཁའི་མེ་ཏོག་དངོས་པོ་མེད་པས་མི་དམིགས་པ་དེ་ལྟ་བུར་བུམ་པ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་འདི་དག་ལ་འཛིན་པའི་ནུས་པ་མེད་དེ།",
    "བདག་ཅག་གི་ཡོད་པའི་ཕྱིར་ཅུང་ཟད་འཇིག་པའམ་སྐྱེ་བ་མེད་དོ།",
    "གལ་ཏེ་སྣམ་བུ་ལ་སོགས་པ་རྣམས་ཡོད་པ་ཡིན་ན་དེའི་མ་འོངས་པ་མེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་དག་མེད་པའི་ཕྱིར་ད་ལྟར་བྱུང་བ་ཡང་མེད་དོ་གལ་ཏེ་འདས་པ་དང་མ་འོངས་པ་མེད་ན་ད་ལྟར་བྱུང་བ་འདི་གང་གི་ཡིན་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བྱུང་བ་མེད་པའི་ཕྱིར་ཐམས་ཅད་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་མེད་པ་འབྲས་བུར་ཐལ་བར་འགྱུར་བ་དེ་བས་ན་ཡོད་པ་ནི་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་ཡང་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་དེ་དག་ལ་སྐྱེ་འཇིག་མེད་པར་ཐལ་བས་ཉེས་པར་འགྱུར་མོད།",
    "མ་སྐྱེས་པ་ལ་རང་གི་བདག་ཉིད་མེད་ན་ཇི་ལྟར་རང་ལས་སྐྱེ་བར་འགྱུར།",
    "དེ་ལྟར་རེ་ཞིག་རང་ལས་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "གཉི་གའི་སྐྱོན་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་གང་གི་ཚེ་སྐྱེ་བ་དེའི་ཚེ་གནས་པ་དང་འཇིག་པ་མེད་ལ།",
