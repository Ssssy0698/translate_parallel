    "ཧ་ཧ་ཞེས་སྒྲོགས་འཇིགས་པར་བྱེད།",
    "ཕྱོགས་དང་ཕྱོགས་མཚམས་ན་གནས་པར་བསྒོམ།",
    "གནོད་སྦྱིན་འཆི་ལམ་མཁའ་ལ་སྤྱོད་པར་འགྱུར།",
    "མགྲོན་པོ་དེ་དང་མཚུངས་པར་འགྱུར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་ལ་དགའཞུང་རྔ་རང་བར་གྱུར་ཏོ།",
    "པདྨ་རྣམ་པར་རོལ་པ།",
    "ལ་ལར་གཤིན་རྗེ་སྟོང་པས་རྔམ་པར་བྱེད།",
    "ཁྱད་པར་གྱི་གསང་བའི་སྔགས་བསྟན་པའི་ལེའུ་སྟེ་བརྒྱད་པའོ།",
    "རྣལ་འབྱོརདེ་དོནི་ཁྱད་པར་ཅན་ཐམས་ཅད་དང་ལྡན་བར་འགྱུར་རོ།",
    "ངོ་ཤེས་པར་མ་ལྡོག་པའི་དོན།",
    "ལུགས་བྱུང་ལུགས་ལས་ལྡོག་པར་བྱེད།",
    "ཁྱད་པར་དུར་ཁྲོད་ཆེན་པོ་ན།",
    "དགེ་སྦྱོང་དག་ནི་ཚངས་པར་སྤྱོད་པ་མཆོག།",
    "བར་ཆད་རབ་ཞི་འགྱུར་མེད་བརྙན་པར་འགྱུར།",
    "པར་རྒྱས་པ་གཡས་འཁྱིལ་དུ།",
    "ཞེ་སྲང་རྣམ་པར་དག་བྱེད་ཅིང་།",
    "དུར་ཁྲོད་ཆེན་པོར་བཞུགས་པ་ན།",
    "ང་རྒྱལ་རྣམ་པར་དག་བྱེད་ཅིང་།",
    "དུར་ཁྲོད་རྔམ་པར་བཞུགས་པ་ནི།",
    "ཚེས་རྣམས་རབ་ཏུ་རྟོགས་པར་འགྱུར།",
    "རྒྱས་པའི་འཕྲིན་ལས་གྲུབ་པར་བྱས།",
