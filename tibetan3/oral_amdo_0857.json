    "གང་གིས་བདག་ཉིད་ཀྱང་མཚོན་ནོ།",
    "ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི།",
    "འདིར་གཏུམ་མོའི་ངེས་པའི་ཚིག་རྣམས་གསུངས་པ།",
    "སྣོད་ལྡན་བུད་མེད་འཁྱུད་པ་དང་།",
    "གཏུམ་མོའི་རྣལ་འབྱོར་ལ་བརྟེན་བྱ།",
    "འདི་གསུངས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྡུད་པ་མཛད་པ་མོའི་རང་གི་རྒྱུད་ཡོངས་སུ་སྤངས་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ནི་སྟོན་པ་པོ་ལ་བདག་གིས་ལ་སོགས་པ་རྡོ་རྗེ་ཕག་མོའི་ལུས་ཀྱི་ཉན་པའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཏུམ་མོའི་རྣལ་འབྱོར་ཀྱང་ངོ།",
    "ནང་གི་གདམས་ངག་གི་རིགས་པས་སྐྱེ་གནས་དང་དེར་བསྐྱོད་པའི་མིང་གི་ཡི་གེའི་རྣམ་པར་གཞག་པའི་མཚན་ཉིད་དང་།",
    "གང་ཡང་དེ་རྣམས་ཀྱི་རང་བཞིན་ཡི་གེ་ཙམ་མོ་ཞེས་བྱ་བའོ།་།",
    "དེ་བཞིན་དུ་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ནང་གི་བདག་ཉིད་ཀྱི་མཚན་ཉིད་དང་།",
    "དེ་ཡང་བཅོམ་ལྡན་འདས་མཁའ་འགྲོ་མའི་གཟུགས་སུ་ལྐུཕག་མོའི་རྐྱེན་གྱིས་ཡེ་ཤེས་ཀྱི་སྐུ་ལས་རྣམ་པར་ཤེས་པའི་སྐུ་ཅན་ནོ།",
    "ཕག་མོའི་མཐའ་མེད་པ་ཡི་གཟུགས།",
    "དེ་བཞིན་དུ་ཕག་མོ་དང་མཁའ་འགྲོ་མའི་གཟུགས་ཀྱི་དངོས་པོའི་དབྱེ་བ་གསུངས་པ།",
    "འདིར་གང་གི་ཕྱིར་ཨ་ཝ་དྷཱུ་ཏཱིའི་ལུང་ལ་བརྟེན་པ་སྟེ།",
    "དེའི་ཚེ་རྡོ་རྗེ་ཕག་མོ་མཁའ་འགྲོ་མར་འགྱུར་རོ།",
    "དེ་ལྟར་ཡང་སྣ་ཚོགས་པ་ཕག་མོའི་སྦྱོར་བ་ལས་སྤྲོ་བའོ་ཞེས་བྱ་བའོ།",
    "འདོད་པ་ནི་འཐོབ་པ་སྟེ་ཐམས་ཅད་དུ་དེ་ལྟར་རྡོ་རྗེ་ཕག་མོ་ཉེ་བར་བགྲོད་པ་ལས་སོ།",
    "རྣལ་འབྱོར་ཀྱང་ལྟེ་བའི་འོག་གི་འཁྱེལ་བ་ལས་ཤིན་ཏུ་ཕྲ་བའི་བ་ཐག་བཅུ་གཉིས་ཀྱི་གཟུགས་ལས་རྩ་བཅུ་གཉིས་སུ་འགྱུར་རོ།",
    "ལུས་ཀྱི་འོག་དང་སྟེང་གི་འཇིག་རྟེན་དུ་ཡང་འགྱུར་རོ།་།",
    "དེ་ལྟར་ཤར་གྱི་ལུས་འཕགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་བཅོམ་ལྡན་འདས་གཟུགས་ཅན་མའོ་ཞེས་བྱ་བའི་བར་དུ་མཁའ་འགྲོ་མས་བྱིན་གྱིས་བརླབས་པའི་བདག་མོའི་སྐུའི་རྣམ་པ་གཉིས་ཀྱི་གནས་པའོ།",
    "ད་ནི་མཁའ་འགྲོ་མའི་གཙོ་མོའི་དཀྱིལ་འཁོར་པ་རྣམས་དང་བཅས་པའི་རྣམ་པར་གཞག་པ་གཉིས་པ་གསུངས་པ།་",
    "ཨཱ་ལི་དང་ཀཱ་ལི་ལས་བྱུང་བའི་ཟླ་བ་དང་ཉི་མའི་སྟེང་དུ་རོའི་གདན་ལ་སྔགས་ཀྱི་ཡི་གེ་ལས་བྱུང་བའི་མཁའ་འགྲོ་མ་ལ་སོགས་པ་སུམ་ཅུ་རྩ་བདུན་གྱི་གཟུགས་ཅན་རྣམས་སྐད་ཅིག་གིས་ཕྱེརྣམ་པར་བལྟ་བར་བྱའོ།",
    "སྔགས་ཀྱི་ཡི་གེ་རེ་རེ་གནས་སུམ་ཅུ་རྩ་བདུན་དུ་ཉེ་བར་དགོད་པར་བྱའོ།",
    "གདམས་ངག་རྣམ་པ་མང་པོ་བྱ་སྟེ་གསུངས་པའི་གཞུང་གི་རིགས་པས་སོ།",
    "དེ་ནས་གསང་བ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏེ་ཚིགས་སུ་བཅད་པ་བཅུ་གཅིག་གིས་ཏེ་འདི་ནི་ཐམས་ཅད་དུ་ངེས་པའོ།",
    "གང་གི་ཕྱིར་མཁའ་འགྲོ་མའི་ཡིན།",
    "ཕག་མོ་ཡི་ནི་རིགས་ལས་བྱུང་།",
    "རེ་རེ་ལ་ཡང་རིགས་སྣ་ཚོགས།",
    "དེ་ལྟར་རྡོ་རྗེ་ཕག་མོ་དང་འཁོར་ལོ་སྡོམ་པའི་རྒྱུད་དང་།",
    "ད་ནི་མཁའ་འགྲོ་མའི་མིང་གི་ཡི་གེའི་འདུ་ཤེས་དང་དེ་བཞིན་དུ་སྐྱེ་གནས་དང་དེར།",
    "བདག་འདྲིའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་བདག་པོ་ཞེས་བྱ་བ་དང་བདག་གི་ཞེས་བྱ་བ་ནི་ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པ་རྣམས་ཀྱི་རྣམ་པར་དཔྱད་པ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་དེའི་རང་གི་བསམ་པ་གསུངས་པའོ།",
    "ཁྱོན་ཞེས་བྱ་བ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་ཀྱིས།་",
    "རང་ཉིད་ནི་ཌའི་ཡི་གེ་དང་ཨིའི་ཡི་གེའི་ལུས་དང་ལྡན་པ་སྟེ་དེ་འདིར་གསུངས་པ་ཌ་ཡིག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ་གསང་བ་ཞེས་བྱ་བ་ནི་བུད་མེད་དང་སྐྱེས་པ་ལ་སོགས་པའི་རྡོ་རྗེ་ལ་སོགས་བུ་གའི་བདག་ཉིད་དོ།",
    "གཞུའི་དབྱུག་པའི་རྣམ་པ་ནི་སྲོག་གི་དབྱུག་པ་སྟེ་ལུས་ཐམས་ཅད་དུ་ཁྱབ་པའོ།",
    "འཛིན་ཉིད་ཀྱིས་སྲོག་གི་དབྱུག་པའོ།",
    "དེ་ལྟར་པདྨ་ཆེན་པོར་ཞེས་བྱ་བ་ནི་ཨ་ཝ་དྷཱུ་ཏཱིའི་ནང་དུ་སྤྲུལ་པ་ལ་སོགས་པའི་པདྨ་རྣམས་གནས་པའི་བ་ཐག་གི་སྒུད་པ་ལྟ་བུའི་རྩ་རྣམས་སོ།",
    "ཏུའི་ཡི་གེ་ནི་ངེས་པར་གཟུང་བ་སྟེ་རྩའི་འཁོར་ལོ་འདབ་མ་དྲུག་གི་རྣམ་པ་དེ་ལ་ཐིག་ལེ་ཆེན་པོས་ཁྱབ་པའོ་ཞེས་བྱ་བར་འབྱེལ་ལོ།",
    "ཅེས་བྱ་བ་སྟེ་གང་གི་ཕྱིར་མིའི་གཟུགས་ཀྱི་གནས་སྐབས་ཀྱི་རྗོམངོན་སུམ་ལས་ཏེ།",
    "ལུག་དང་དམར་སེར་ཡིད་བཟང་མོ།",
    "གང་གི་ཕྱིར་གནས་སྐབས་འདིར་མ་གསུངས།",
    "དེ་ལྟར་བྱས་པས་གང་གི་ཡོན་ཏན་ལྷག་པ་ཡོད་འགྱུར་ཞེས་བྱ་བ་གསུངས་པ།",
    "རང་གི་བདག་པོའི་སྤྱོར་བ་ལས།",
    "ཐིམ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རང་རང་གི་ཞིང་རྣམས་གནས་སུམ་ཅུ་རྩ་བདུན་དུ་ཐིམ་པ་དང་ལོངས་སྤྱོད་ལ་སོགས་པ་བྱེད་པ་པོ་ཉིད་དུ་བྱེད་དོ།",
    "རྫུ་འཕྲུལ་ཆེ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པར་ཤེས་པར་བྱའོ།",
    "གནས་པའི་དུས་སུ་གསུང་གི་འཁོར་ལོར་གནས་པ་རྣམས་ཀྱིའོ།",
    "དུས་ཀྱི་ཕོ་ཉ་མོ་རྩ་ཐམས་ཅད་ཀྱི་དང་མཁའ་འགྲོ་མ་ལ་སོགས་པའི་རང་བཞིན་དུ་རྒྱུ་བར་བྱའོ།",
    "བདག་པོ་རེ་རེའི་སྤྱོར་བས་ཇི་ལྟར་མཁའ་འགྲོ་མ་ལ་སོགས་པ་ནས་གཤིན་རྗེ་འཇོམས་མའི་བར་དུའོ།",
    "༦རྀ་སུ་ལོ་དུ་ཧ་ཡ་ར་ཝ་ལཨ་མ་ཨ་ཐ་ཨ་པ་ཨ་ས་ཨ་ཀྵ་ཧ།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟར་ཡི་གེ་དང་དབུགས་གཅིག་གིས་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་མཁའ་འགྲོ་མ་རྒྱས་བཏབ་པ་སྟེ་དེའི་རང་བཞིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁོར་ལོ་གསུམ་ན་གནས་པ་མོ་རྣམས་ཀྱི་ཁྱད་པར་དུ་བྱེད་པ་སྟེ་དེ་རྣམས་ཀྱི་སྤུརང་བཞིན་དུའོ།",
    "གསུང་གི་འཁོར་ལོ་ན་གནས་པ་རྣམས་ནི་སྔགས་སྐྱེས་སོ།",
    "འདོད་པའི་གནས་པ་མཆོག་གི་མཚོན་བྱ་རྣམས་སུ་ཐིག་ལེ་བཞི་དང་བྲལ་བས་རྩེན་པ་རྡོ་རྗེ་འཆང་གི་བདག་ཉིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "འདི་ནི་མཆོག་གི་མཚོན་བྱ་རྣམས་ལ་ཐིག་ལེ་བཞི་དང་བྲལ་བས་རོལ་པ་རྡོ་རྗེ་འཆང་གི་བདག་ཉིད་ཀྱིས་སོ།",
    "རོལ་པ་མཆོག་གི་མཚོན་ཕྱིར་རྡོ་རྗེ་འཆང་གི་སྐུས་གནས་གྲོང་མེད་པར་གང་དུ་མཐའ་དང་མཐའ་ལས་ཞེས་སོ།",
    "འདིའི་ཐེ་ཚོམ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་ཚིག་གིས་གསལ་བར་བྱེད་པ་གསུངས་པ།",
    "ཐ་མལ་པའི་བག་ཆགས་ཀྱི་བུད་མེད་དང་སྐྱེས་བུ་ཀུན་དུ་སྦྱོར་བ་ལས་དགའ་བ་ལ་སོགས་པར་ནུབ་པར་ཕྱེབྱེད་དོ།",
    "གང་དང་གང་གི་ལས་དྲག་པོས།",
    "གང་གིས་དེ་ལྟར་རྨོངས་པ་འཆིང་།",
    "ཅེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གིས་སོ།",
    "དེའི་ཕྱིར་ཐིག་ལེ་བཞི་དང་བྲལ་བ་རང་གི་བག་ཆགས་ཀྱི་སྐྱོན་དང་བྲལ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་རྣམས་སུ་ནི་བཟའ་སྟོན་མོ།",
    "འདིར་གང་གི་ཚེ་ནང་གི་བདག་ཉིད་ཅན་རང་གི་བདག་ཉིད་ཀྱི་སྦྱོར་བའི་རྐྱེན་ཀྱི་ཡེ་ཤེས་མཚན་ཉིད་མེད་པ་བརྗོད་དུ་མེད་པ་བདེན་པ་མ་ཡིན་པ་མི་རྟག་པ་གཞོམ་དུ་མེད་པ་གཟུགས་མེད་པ།",
    "ཐོག་མ་རྔེད་པ་ཐ་མ་མེད་པ་དབུས་མ་ཡིན་པ་ལུས་མེད་པ་ངག་མེད་པ་སེམས་མེད་པ་ཡེ་ཤེས་མ་ཡིན་པ་ཀུན་ཞེས་པ་ལ་སོགས་པས་གང་མཚོན་པ་རང་གི་ཁུརིག་པ་སྣ་ཚོགས་པའི་རྫས་ཀྱི་རང་བཞིན་ནོ།",
    "གང་ཞིག་གང་གི་རང་རང་བཞིན།",
    "སླར་ཡང་བསྐལ་པ་སྲེག་པ་ལ་སོགས་པའི་དུས་སུ་དེ་ལ་བདག་ལྐུཏུ་སོང་སྟེ་བསྟན་པར་བྱ་བ་དང་སྟོན་པ་པོ་ཐམས་ཅད་ནམ་མཁའི་གཟུགས་ཀྱིས་གནས་སོ།",
    "དེ་ལྟར་བརྟན་པ་ཕག་མོ་ལ་སོགས་པ་སུམ་ཅུ་རྩ་བདུན་ལ་སོགས་པའི་རྡོ་རྗེ་རྣལ་འབྱོར་མ་བསྒྲུབ་པར་འགྱུར་རོ།",
    "རྣམ་པར་སྣང་ཞིང་འབར་བར་བྱེད་པ་རབ་ཏུ་གསལ་བ་ཙམ་གྱིས་༤གཟུགས་ཀྱི་ཀུན་རྫོབ་ཀྱི་དངོས་པོས་ལྷ་མོ་ལས་རྣམ་པར་སྣང་མཛད་ཀྱིས་རྒྱས་གདབ་པ་ནི་མཚོན་པར་ཁྱ་བའོཏྲེ།",
    "དེ་ཡང་རང་གིས་འདི་རྣམས་ཀྱི་རྡོ་རྗེ་འཛིན་པའི་ཕྱིར་རྡོ་རྗེ་འཛིན་པས་མཚོན་པར་བྱ་སྟེ་རང་ཉིད་མངོན་སུམ་དུ་མྱ་ངན་ལས་འདས་པའི་གཟུགས་ཅན་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དེ་རྣམས་ཀྱི་རང་གི་དུས་སུ་རྒྱས་གདབ་པ་སྟེ་དེ་བཞིན་གཤེགས་པ་དྲུག་གིས་ནམ་མཁའ་ལ་སོགས་པའི་རིགས་ཅན་མ་རྣམས་ཀྱི་རིགས་རྣམས་ཀྱི་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ལྷ་མོ་མཁའ་འགྲོ་མ་རང་ཉིད་ཐབས་དང་ཤེས་རབ་ཀྱི་ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པ་གཅིག་ཏུ་ཐིམ་པར་གྱུར་པས་སྲོག་དང་ཐུར་དུ་སེལ་བ་ཨ་བ་དྷཱུ་ཏཱིའི་ནང་དུ་ཐིམ་པར་འགྱུར་རོ།",
    "ཡེ་ཤེས་ཀྱི་ནམ་མཁའ་རང་གིས་རང་ལ་བལྟ་བར་བྱའོ།",
    "ལྷ་མོ་ནམ་མཁའི་ནང་སོན་པ།",
    "མཆོག་གི་བདེ་ཆེན་རྡོ་རྗེ་རོལ་ཅིག་རོལ།་།",
    "ཞེས་བྱ་བ་སྟེ་འཇིག་རྟེན་པ་མགོན་མེད་པ་རྣམས་ལ་ཁྱོད་ཀྱིས་ཏེ་དེ་བཞིན་དུ་གསུངས་པའོ།",
    "ཞེས་བྱ་བ་ནི་ཅིའི་ཕྱིར་མགོན་པོ་ཁྱོད་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་གྱི་དངོས་པོ་ལ་གནས་པར་རྨྱེཁྱོད་ཀྱིས་དོར་ཅིག་པའོ།",
    "གང་གིས་རྣལ་འབྱོར་མ་རྣམས་རབ་ཏུ་སད་པར་འགྱུར་བར་རོ།",
    "ཞེས་བྱ་བ་སྟེ་གང་གིས་ལྷན་ཅིག་དངོས་ཀྱིས་ཁྱད་པར་དུ་བསམས་པའི་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་འདི་ལ་སྤྱོད་ཀྱིས་ཞུགས་པའོ།",
    "མངའ་བདག་ཁྱོད་ཀྱིས་ཁམས་བཞིའི་ས་བོན་འཛག་པར་མཛོད།",
    "རྒྱུ་གང་གི་ཕྱིར་གསུངས་པ།",
    "ཨ་ཝ་དྷཱུ་ཏཱིའི་རང་བཞིན་གཏུམ་མོ་ལྡང་།",
    "ཨ་ཝ་དྷཱུ་ཏཱིའི་རང་བཞིན་གྱིས་གཏུམ་མོ་ཉེ་བར་སྤོང་རྔུབ་ཞེས་བྱ་བ་སྟེ།",
    "དེ་བཞིན་དུ་གང་གིས་གཏུམ་མོ་ལངས་པས་གསུམ་སྲེག་པར་བྱེད་དེ་གང་དུ་ཡང་མ་མཐོང་ངོ་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ལྟར་སོང་བས་གང་དུ་ཡང་བདག་དང་བདག་གི་བ་ལ་སོགས་པ་དང་གཟུང་བ་དང་འཛིན་པའི་དངོས་པོ་མི་མཐོང་བའོཐམས་ཅད་དོན་མེད་པ་ཉིད་དུ་འགྲོ་བའོ།",
    "གང་གིས་སྐྱེ་བ་དང་ནི་འཆི་བ་སོ་སོར་མ་མཐོང་ངོ།",
    "གང་གིས་དེ་ལྟར་བསྒྲུབས་པས་འདིར་འགྱུར་བར་གསུངས་པ།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ལ་སོགས་པའི་གཙོ་མོ་སྒྱུ་མ་ལྟ་བུའི་མཚན་ཉིད་དོ།",
    "དེར་ཐིམ་པའི་ནམ་མཁའ་ལས་རང་གི་འཁོར་ལོ་ནི་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་གཟུགས་ཐིམ་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་གྱི་རྒྱུད་རྣམས་སུ་སེམས་འོད་གསལ་དུ་སོན་པས་དེ་ཁོ་ན་ཉིད་རང་གི་རིག་པ་གཉིས་སུ་མེད་པའི་ཡིད་ཆེས་པས་རང་གིས་མངོན་སུམ་དུ་ཉམས་སུ་མྱོང་བར་འགྱུར་རོ།",
    "དེ་ཁོ་ན་ཉིད་ལ་སོགས་པའི་རྣལ་འབྱོར་གྱི་རྒྱུད་རྣམས་སུ་གང་གིས།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་ལུས་ཀྱི་དེ་ཁོ་ན་ཉིད་ལ་སོགས་པ་རིག་པ་པོ་ཀུན་རྫོབ་ཀྱི་འོད་གསལ་བར་སོང་བ་ཡང་སྒྱུ་མའི་རྣམ་པས་སེམས་རྡོ་རྗེ་སོ་སོར་སྣང་བའི་སྐུའི་རྣམ་པ་ཉིད་ཀྱིས་སོ།",
    "གང་ཞིག་དོན་དམ་པ་ནི་ཀུན་རྫོབ་ཏུ་བདེ་བ་དང་སེམས་དག་གིས་ལུས་དང་བདེ་བའོ།",
    "སེལ་བར་བྱེད་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཚིག་གིས་གསུངས་ལ།",
    "གདམས་ངག་གིས་གྲུབ་པའི་མཐའ་བྲལ་ན་མི་འགྱུར་ཏེ།་",
    "དཔེ་དང་བྲལ་བའི་ཡེ་ཤེས་ལས་རང་གི་རིག་པའི་དུས་སུ་ཡང་རྣལ་འབྱོར་མ་རྣམས་ཀྱིས་དངོས་སུ་ཡིད་ཆེས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁཱ་མ་རང་གི་རྒྱུད་བདག་ཉིད།",
    "ལྷ་མོ་ཡོན་ཏན་ཀུན་བདག་ཉིད།",
    "རང་གི་བསམ་མེད་ལྷན་ཅིག་སྐྱེས།",
    "ཇི་ལྟར་གནས་པ་ཞེས་བྱ་བ་ནི་ཕྱི་དང་ནང་གི་བདག་ཉིད་དུ་ཇི་ལྟར་གནས་པའོ།",
    "གཞན་དུ་ནི་རྣལ་འབྱོར་མའི་རྒྱུད་རྣམས་ཀྱི་སྙུད་པ་མཛད་པ་མོ་རྡོ་རྗེ་ཕག་མོ་ལ་སོགས་པ་རྣལ་འབྱོར་མ་རྣམས་ཏེ།",
    "འདི་ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་གི་ངེས་པ་དུས་གསུམ་གཟིགས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་གང་གི་ཕྱིར་གཉིས་སུ་མེད་པ་དེ་རྣམས་ཀྱིས་བསྟན་པར་བྱ་བ་དང་སྟོན་པ་པོ་ནི་བཅོམ་ལྡན་འདས་རྣལ་འབྱོར་མར་འབྲེལ་ལོ།",
    "ལཱ་མ་རང་ཉིད་ཀྱིས་དྲིས་པ་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་འཆང་ཆེན་པོ་ལ་རང་གི་ཡེ་ཤེས་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པ་ལཱ་མའི་གཟུགས་ཀྱིས་དེའི་དངོས་པོ་དྲི་བའོ།",
    "གང་གི་ཕྱིར་ཕྱག་ན་རྡོ་རྗེའི་འདི་ཇི་ལྟར་ཞེ་ན།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ནི་རྟགས་གང་གིས་ཤེས་པར་བྱ་བའོ།",
    "གང་གི་ཚེ་རྣལ་འབྱོར་ཐམས་ཅད་ཀྱི་མར་གནས་པས་ཨ་ཝ་དྷཱུ་ཏཱི་ལ་ཕར་བྱེ་གནས་པ་ནི་རྡོ་རྗེའི་ལམ་སྟེ།",
    "དེའི་ཚེ་རྣལ་འབྱོར་ཞེས་བྱ་བ་ནི་བདུན་པའི་དོན་གྱི་དང་པོ་སྟེ་རྣལ་འབྱོར་རྣམས་སུ་སྡོམ་པར་བྱེད་པའི་ཡེ་ཤེས་ནི་རྣལ་འབྱོར་སྡོམ་པ་སྟེ་ཕག་མོ་ཞེས་བྱ་བར་འབྱེལ་ལོ།",
    "གང་གི་སྦྱོར་བའི་ཡན་ལག་དྲུག་བསྒོམས་པ་ལ་དངོས་པོའི་རྣལ་འབྱོར་དེ་དེ་བཞིན་དུ་གསུངས་སོ།",
    "ཐམས་ཅད་དམ་པའི་དོན་གྱི་དངོས་བོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་བདག་ཉིད་ཅན་དེ་སླར་ཡང་བདག་གི་རྣལ་འབྱོར་སྡོམ་པ་ཞེས་བྱ་བ་ནི་ཐབས་ཀྱི་བདག་ཉིད་ཀྱི་གྲུརྡོ་རྗེ་འཆང་ཆེན་པོ་སྟེ་སྟོན་པ་པོའི་གཟུགས་ཉིད་ཀྱི་ཕྱིར་ཏེ།",
    "མི་གཡོ་ཞིང་མི་འཁྲུགས་པས་གང་གི་ཕྱིར་མི་བསྐྱོད་པ་སྟེ།",
    "སོགས་ཀྱི་སྒྲས་ཕུང་པོ་དང་སྐྱེ་མཆེད་ལ་སོགས་པ་དེ་རྣམས་སུ་དེ་རྣམས་ཀྱིས་སྡོམ་པའི་ཡེ་ཤེས་ནི་རྣལ་འབྱོར་མ་ཆེན་མོའི་གཟུགས་སུའོ།",
    "དེ་ནས་དམ་ཚིག་གི་སྡོམ་པ་གསུངས་པ།",
    "ཡེ་ཤེས་ཀྱི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་དམ་ཚིག་གི་སྡོམ་པའི་ཡེ་ཤེས་དེ་ནི་དམ་ཚིག་སྡོམ་པའོ།",
    "དེ་ཡང་མགོ་བོ་དང་རྡོ་རྗེའི་ནོར་བུ་དག་ཏུ་འཕྱང་བ་དང་སོན་པ་དག་ཅེས་བྱ་བ་སྟེ་སྲོག་གི་ཐིག་ལེ་དཔྲལ་བ་ནས་འོངས་ནས་རྡོ་རྗེ་ནོར་བུའི་བར་དུའོ།",
    "གང་གི་ཕྱིར་ནམ་མཁའི་མཁའ་འགྲོའི་མིང་སྟེ།",
    "འོ་ན་བཅོམ་ལྡན་འདས་རྣམས་ཀྱིས་མཁའ་འགྲོ་བདུན་རྣམས་ཀྱི་ངེས་པའི་ཚིག་གི་མཚན་ཉིད་རྒྱུད་ཀྱི་ནང་དུ་གསུངས་ཤེ་ན།",
    "རྣལ་འབྱོར་དང་རྣལ་འབྱེར་མ་རྣམས་ཀྱི་རང་བཞིན་དེ་མཆོག་གི་ཡེ་ཤེས་ཅན་ཏེ་བདུན་པ་མཁའ་འགྲོ་སྡོམ་པ་ཞེས་བྱ་བའོ།",
    "ཡང་དག་པར་སྦྱོར་བ་ནི་ཨ་ཝ་དྷཱུ་ཏཱིའི་ནང་དུ་ཡོངས་སུ་བསྒྲུབས་པ་དེ་རྣམས་ཀྱིས་སྡོམ་པ་གཅིག་གི་སྟེང་དུ་སོན་པའོ།",
    "མན་ངག་འདིས་གཏུམ་མོ་འབར་བ་དང་ཨ་ཝ་དྷཱུ་ཏཱི་དང་སྣ་ཚོགས་པ་ཁྱབ་པ་ཉིད་པས་རྩ་ཐམས་ཅད་སོ་སོར་རེ་རེའི་དབུས་སུ་འབར་བས་རྩ་ཨ་ཝ་དྷཱུ་ཏཱི་ཅན་དེའི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "དེའི་དབུས་སུ་དེའི་དངོས་པོ་རང་གི་རིག་པའི་ཡེ་ཤེས་དེ་ཉིད་བདུད་རྩི་གསང་བའི་གཟུགས་སོ།",
    "ནམ་མཁའི་གཟུགས་ཅན་གྱིས་དེའི་ནང་དུ་སོན་པའི་སྲོག་གི་བདག་ཉིད་ཅན་གྱི་ཡེ་ཤེས་ནི་རྡོ་རྗེ་སྟེ།",
    "གང་གི་ཚེ་རྣལ་འབྱོར་གོམས་པ་རང་བཞིན་གྱི་གཟུགས་རྗེས་སུ་དམིགས་པ་མེད་པར་གྱུར་པ་དེའི་ཚེ་ནམ་མཁའ་ལ་རང་གི་གཟུགས་མཐོང་བར་འགྱུར་རོ།",
    "འཁོར་ལོ་ནང་གི་བདག་ཉིད་ཅན།",
    "འདི་རྣམས་ཀྱི་ཐིག་ལེས་ནང་གི་བདག་ཉིད་ཅན་གྱི་འཁོར་ལོའི་གཟུགས་ཞེས་བྱ་བར་འབྱེལ་ལོ།",
    "ད་ནི་དམ་ཚིག་གི་མཁའ་འགྲོའི་མཚན་ཉིད་གསུངས་པ།",
    "ཡེ་ཤེས་འདི་ལྟར་གཉིས་ཀྱི་རྫས་ཀྱི་རང་བཞིན་གྱིས་བདག་ཉིད་ཅན་ལས་དམ་ཚིག་གི་དུས་ཏེ་དེ་ཡང་རྣམ་པ་གསུམ་སྟེ་དུས་གསུམ་མོ།",
    "འདོད་ཆགས་སྒྱུ་མ་ནི་འདོད་ཆགས་སྒྱུ་མ་སྟེ་རྩ་ཐམས་ཅད་ཀྱིས་རང་གིས་རིག་པའི་བདེ་བའི་བདག་ཉིད་ཅན་གྱི་རང་བཞིན་དེས་ལྷན་ཅིག་ནམ་མཁའ་ལ་འོད་གསལ་བ་ནི་པདྨ་མཁའ་འགྲོ་སྟེ།",
    "རང་ཁྱབ་བདག་ཅེས་བྱ་བ་ནི་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་མའི་རང་བཞིན་གྱིས་ཏེ་ཞིང་གི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་ཀྱེཡེ་ཤེས་དེ་རང་ཉིད་གཙོ་བོ་རྡོ་རྗེ་འཆང་ཆེན་པོའི་བདག་ཉིད་ཅན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་ཡི་གེ་མཆོག་གི་ཡི་གེ་རྣམས་སུ་འོག་མིན་གྱི་ནང་རྣམས་སུ་ལོངས་སྤྱོད་པ་རྣམས་ཀྱི་བསྐྱེད་དོ།",
    "དེ་ལྟར་ཡེ་ཤེས་མཁའ་འགྲོ་ལ་སོགས་པ་མཁའ་འགྲོ་བདུན་རྣམས་ཀྱི་རང་རང་གི་ཁམས་རྣམས་ཀྱི་ཁམས་རྣམ་པ་བདུན་ཞེས་བྱ་བ་ནི་ས་དང་།",
    "དེ་རྣམས་ཀྱང་རྣམ་པར་ཤེས་པ་བདུན་གྱི་མཚན་ཉིད་ཅེས་བྱ་བ་ནི་མིག་དང་རྣ་བ་དང་སྣ་དང་ལྕེ་དང་ལུས་དང་ཡིད་དང་ཉོན་མོངས་པ་ཅན་ཀྱི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རྣམས་སོ།",
    "དེ་ལྟར་འདི་རྣམས་ཀྱི་གནས་རྣམས་ཀྱི་རིམ་པ་ཇི་ལྟ་བས་དེ་ཁོ་ན་ཉིད་ཉི་ཤུ་རྩ་ལྔ་རྣམས་རབ་ཏུ་གཏུམ་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མ་རྣམས་ཡང་དག་པར་གཞག་པ་གསུངས་པ།",
    "རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏེ་འཁོར་ལོའི་ར་བ་ལ་སོགས་པ་རྣམས་སུ་རང་བཞིན་ནི་རབ་ཏུ་གཏུམ་མོ་དང་སྐྱེས་བུའོ།",
    "ཐར་བར་ནི་ཤིང་གི་གྲིབ་མའོ།",
    "ཡེ་ཤེས་སུ་ནི་འཇིགས་བྱེད་ཆེན་མོའོ།",
    "ལམ་དུ་ནི་ལྗང་ལྷ་མོའོ།",
    "བདག་མེད་པར་ནི་ཤིན་ཏུ་དཔའ་མོའོ།་།",
    "སྟོང་པ་ཉིད་དུ་ནི་བརྩོན་འགྲུས་ཆེན་མོ་ཞེས་བྱ་བའོ།",
    "དེ་ཡི་དེ་ཉིད་ཕག་མོའི་སྟེ།",
    "དེ་ཡི་ལྷ་མོར་ཤེས་བྱ་སྟེ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ལ་སོགས་པ་རྣམ་པར་ཤེས་པ་བདུན་གྱི་མཚན་ཉིད་རྣམས་ཀྱང་ངོ།",
    "དེ་བཞིན་དུ་མིག་གི་སྐྱེ་མཆེད་ནི་རྡོ་རྗེའི་རིའོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་དང་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན་གྱི་ལུས་ཀྱི་རྣམ་པར་གཞག་དུ་པ་ནི་རྣལ་འབྱོར་མའི་རྒྱུད་ཀྱི་དགོངས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།་།",
    "དེ་ལྟར་སྒྲུབ་པ་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་མའི་རྒྱུད་དུ་སོང་བས་དེའི་ཚེ་སླར་བྱ་བ་དང་སྤྱོད་པའི་རྒྱུད་ཡོད་དམ་སྙེཞེ་ན།",
    "རང་བཞིན་ཅན་ནི་ཡེ་ཤེས་ཏེ་གཏུམ་མོའི་གཟུགས་ཏེ།",
    "འོན་ཀྱང་སྐྱེས་བུ་ནི་རང་གིས་རིག་པ་སྐྱེད་པ་པོ་རབ་ཏུ་སྤྱོར་བའི་ལམ་རྣམས་སོ་ཞེས་བྱ་བས་ཤེས་རབ་ཀྱི་རྒྱུད་རྣམས་གྲུབ་སྟེ།",
    "གང་གི་ཕྱིར་འདིར་རབ་ཏུ་གྲགས་ཏེ།",
    "ལེའུ་དང་པོར་གང་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས།",
    "དེ་རྣམས་ཀྱི་རྐྱེན་གྱེས་བུ་རྣམས་དེ་རང་གི་ཡན་ལག་གི་དངོས་པོ་ལས་སོ་སོར་སོང་བའོ།",
    "ལུས་ལ་ཡང་གཙུག་ཏོར་ནས་རྐང་པའི་མཐེ་བོང་གི་བར་དུ་སྟེ།",
    "འདིར་འཇིག་པ་དག་གི་སྟོང་པའི་དུས་རྣམས་སུ་གཞལ་མེད་ཁང་ན་སྤྱོད་པ་རྣམས་བསམ་གཏན་བཞི་ཐོབ་པ་རྣམས་ཀྱིས་དེ་ཐོབ་པས་གཟིར་བའི་སེམས་སོ།",
    "ད་ནི་ཁཱ་མའི་རང་གི་མཚན་ཉིད་གསུངས་པ།",
    "ལཱ་མའི་རང་གི་མཚན་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པས་ཏེ་ཇི་ལྟར་རྗེས་སུ་རིམ་པས་ཏེ་ཞེས་བྱ་བ་སྟེ།",
    "འོན་ཀྱང་དཀྱིལ་འཁོར་སྔོན་མ་འདི་རྣམས་ཀྱི་བདག་པོ་མཁའ་འགྲོ་མ་རྡོ་རྗེ་ཕག་མོའི་རང་བཞིན་ནོ།",
    "དེའི་ཚེ་མཁའ་འགྲོ་མ་རྡོ་རྗེ་ཕག་མོ་ལཱ་མ་གནས་སུ་སོང་ནས་ཁཱ་མ་བདག་པོའི་གནས་སུ་འོངས་ཏེ།",
    "རྡོ་རྗེ་ཕག་མོའི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "ལཱ་མ་རང་བཞིན་དུ་མཁའ་འགྲོ་མ་རྡོ་རྗེ་ཕག་མོར་འགྱུར་རོ།",
    "ལྷག་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་འཁོར་ལོ་དྲུག་གི་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་བར་བར་དུའོ།",
    "ཁཱ་མ་བྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྩ་གཡོན་པ་ནས་བབས་པས་གནས་དེར་བསྐྱེད་པའི་རྣལ་འབྱོར་མའི་ཚོགས་ཞེས་བྱ་བ་ནི་དེ་ལ་གནས་པ་རྣམས་ཀྱི་གནས་དང་ཉེ་བའི་གནས་ལ་སོགས་པར་གནས་པ་མོ་རྣམས་ཀྱི་གཙོ་མོ་ནི་ཚོགས་པ་རྣམས་ཀྱི་གཙོ་མོའོ།",
    "གང་གི་ཚེ་ཡང་དུས་ཚོད་ཀྱི་འཁོར་ལོ་བཞིན་ཡོངས་སུ་འཁོར་ཏེ་གླིང་གསུམ་གསུམ་རྣམས་སུ་རེ་རེའི་དུས་སོ།",
    "འཛམ་བུའི་གེ་གླིང་ཆུང་ངུར་རི་རབ་ཀྱི་ལྷོའི་འགྲམ་དུ་བདག་ནི་ཞེས་བྱ་བ་ཤཱཀྱའི་རིགས་ཀྱི་རྗེས་སུ་སོང་བ་ཤཱཀྱའི་རྒྱུད་དུ་སྐྱེས་པ་ཤཱཀྱ་ཐུབ་པས་ཀྱང་ཐོས་པར་རྔུབསྟན་པའོ།",
    "སླར་ཡང་ཡི་གེ་རེ་རེ་གཉིས་གསུམ་གྱི་རྩའི་རང་བཞིན་བསྐྱེད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ཡང་གལ་ཏེ་ཞེས་བྱ་བ་ནི་ཚིག་གཅིག་གིས་ཚིག་མང་པོར་གོ་བར་བྱའོ།",
    "ཚེགས་ཆུང་བའི་ལས་རྣམས་སུ་ཞེས་བྱ་བ་ནི་ལས་ཚེགས་ཆུང་བས་སྔགས་ཀྱི་བཟླས་པ་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་ལས་རྣམས་འགྲུབ་སྟེ་ནང་གི་བདག་ཉིད་ཀྱི་ལས་ཀྱིས་སོ།",
    "གང་གི་ཚེ་ཚོར་བ་དྲན་པ་ཉེ་བར་གཞག་པ་ནི་ལཱ་མ་སྟེ།",
    "རང་གིས་རིག་པའི་བདེ་བ་ཚོར་བ་ཉིད་ཀྱིས་ཚོར་བ་རྗེས་སུ་དྲན་པའོ།་།",
    "འདི་གསུངས་ཏེ་ལ་སོགས་པ་ནི་ཤིན་ཏུ་དད་པའི་རྡོ་རྗེ་ཕག་མོས་འཁོར་རྣམས་ལ་བོད་པའོ།",
    "ཁྱོད་ལ་ཞེས་བྱ་བ་ནི་ཁྱོད་ཀྱི་ཆོ་ག་རྣམས་ཀྱིས་འཁོར་གྱི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་མིང་གི་སྔགས་རྣམས་ཏེ་ཁྱོད་ཀྱི་ངག་གི་ལམ་གྱི་དུབོད་པའོ།",
    "འདི་གསུངས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྔོན་བཞིན་དུ་སྦུད་པར་མཛད་པ་མོའི་ཚིག་གོ།",
    "ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བས་བསྐྱེད་པའི་གདམས་ངག་གི་རིགས་པས་གནས་ནས་ཏེ།",
    "ཅེས་བྱ་བ་ནི་སྤྲུལ་པ་ལྷ་མོ་དུམ་སྐྱེས་མ་རྣལ་འབྱོར་རྒྱུད་ཀྱི་བདག་པོ་ཉིད་པས་སོ།",
    "དེ་ལྟར་སོ་སོའི་གླིང་དང་གླིང་རྣམས་སུ་རང་རང་གི་ཡུལ་དང་ཡུལ་གྱི་མིང་ཅན་མར་གོ་བར་བྱའོ།",
    "ཀུན་དུ་འགྲོ་མ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་ཆུའི་བདག་ཉིད་ཅན་ཏེ་གང་གི་ཚེ་ཆུ་ནི་ཐམས་ཅད་དུ་འགྲོ་ཞིང་ཆུ་ཀླུང་འབབ་པ་དུརྣམས་སུ་གཡོ་བའོ།",
    "དེ་བཞིན་དུ་རྩ་ཐམས་ཅད་མཐོང་བས་ཏེ་རང་གི་ཞིང་ངམ་རང་བདག་ཉིད་མ་རྣམས་ཀྱི་རང་གིས་ཨེམངོན་སུམ་དུ་མཐོང་སྟེ།",
    "མཆོག་ནི་གཙོ་བོ་དམ་པ་སྟེ་འདབ་མ་བཅུ་དྲུག་ལ་གནས་པའི་ལྷ་མོ་གཙོ་མོ་རྣམས་སོ།",
    "གསང་བ་མཆོག་གི་དགྱེས་པ་ན།",
    "ཇི་ལྟ་བའི་རིམ་པས་ཡི་གེ་རེ་རེའི་རིགས་པས་ཁམས་རེ་རེ་རྣལ་འབྱོར་མ་རྣམས་ལ་ཁྲག་ལ་སོགས་པ་སྦྱར་བར་བྱའོ།",
    "མེའི་ཁམས་ཀྱི་རང་བཞིན་རྣམས་ཀྱི་ཡང་ཆར་འབབ་པ་མོའོ།",
    "ནག་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་རྒྱལ་པོའི་བུ་མོ་ཞེས་བྱ་བའི་བར་གྱི་མིང་རྣམས་སོ།",
    "ལྷ་རྫས་མྱོས་བྱེད་ནི་རང་གིས་རིག་པའི་ཡེ་ཤེས་ཏེ་དེས་འགེངས་པ་མོ་རྣམས་ཏེ་འཛག་པའི་དུས་སུ་ཐམས་ཅད་ཞི་བའི་གཟུགས་རྣམས་ཀྱིས་སོ།་།",
    "སླར་ཡང་དུམ་སྐྱེས་མ་དེ་རྡོ་རྗེ་ཕག་མོའི་རྒྱན་ཅན་གྱིས་བཅོམ་ལྡན་འདས་ལ་ཡོངས་སུ་དྲིས་པའོ།",
    "བདག་གི་གསུང་བར་མཛོད་ཅེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "བདག་གིས་འདི་ཅི་ཞེས་བྱ་བ་སྟེ།",
    "ཅིའི་ཕྱིར་བདག་དུམ་སྐྱེས་མའི་རྩའི་འཁོར་ལོ་འདི་རྣམས་སུ་འགྲོ་བ་མོ་ཡིན།",
    "དོན་གྱིས་འུགོ་བར་བྱ་བ་ཡང་བདག་ཤི་ཡང་མིང་གི་ཡི་གེ་བཞི་རྣམས་ཀྱིས་དུམ་སྐྱེས་མ་ཞེས་བརྗོད་དོ།",
    "མཁའ་མཉམ་གཅིག་གི་དངོས་པོ་ཡིས།",
    "ཐ་མལ་པ་རྣམས་ཀྱི་དྲི་མ་དང་བྲལ་བའི་སེམས་ཀྱི་དངོས་པོར་མ་སོང་བས་བག་ཆགས་དང་བཅས་པ་སྟེ།",
    "ཁམས་ཀྱིས་སོ་སོར་བརྟན་པ་རྒྱའཐོབ་པ་སྟེ་དེ་མ་ལུས་པ་ཕྱིན་ཅི་ལོག་ཏུ་སོང་བའི་སེམས་ཀྱིས་སོ།",
    "རང་གིས་སྣ་ཚོགས་སེམས་ཀྱིས་སྦྱོང་།",
    "གང་གི་ཕྱིར་ཧེའི་ཡི་གེའི་དོན་དུའོ།",
    "གང་གི་ཚེ་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དངོས་པོ་མེད་པའི་གཟུགས་ཀྱི་ལས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་སྨྲ་བ་ལས་དེ་མི་བདེན་པའི་གཟུགས་འཁྲུལ་པས་ཐམས་ཅད་དུ་འཇུག་པའོ།",
    "རོ་ཡི་ཡི་གེ་ཁྱོད་དུ་བཤད།",
    "ཅེས་བྱ་བ་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་ལ་སོགས་པ་འགྲོ་བ་ངན་པ་རྣམས་ཀྱི་རྒྱུ་ཡང་རང་གི་ལུས་པྱརྣམས་སུ་ཤེས་རབ་ཀྱི་མཚོན་ཆས་རང་བཞིན་མེད་པའི་མཚན་ཉིད་དུ་ཁམས་གསོད་པའོ།",
    "གཙོ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏེ།",
    "མཆོག་གི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི།",
    "འོན་ཀྱང་མཁའ་འགྲོ་མ་དང་རྡོ་རྗེ་ཕག་མོའི་རང་བཞིན་ལཱ་མ་ཡང་བདག་པོའི་གནས་ནས་འོངས་ནས་དུམ་སྐྱེས་མའི་གནས་སུ་སོན་པ་སྟེ།",
    "དེ་ལ་མཁའ་འགྲོ་མ་དང་རྡོ་རྗེ་ཕག་མོ་དང་ཁཱ་མ་དང་དུམ་སྐྱེས་མའི་རྣམ་པའི་རང་བཞིན་དུ་གནས་ནས།",
    "དེར་རྡོ་རྗེ་ཕག་མོ་དང་མཁའ་འགྲོ་མ་དང་ཁཱ་མ་དང་དུམ་སྐྱེས་མའི་རང་བཞིན་དུ་གནས་པའོ།",
    "རང་གི་སྔགས་ལས་སྐྱེས་ཞེས་བྱ་བ་ནི་རང་གི་སྔགས་ཀྱི་ཡི་གེས་རིམ་པ་ཇི་ལྟ་བར་རྣལ་འབྱོར་མ་ཐམས་ཅད་སྐྱེས་པ་སྟེ་དེའི་སྔགས་གསུངས་པ།",
    "ཨོཾ་རྦས་ཞེས་བྱ་བ་ལ་སོགས་པས་ཏེ་སརྦ་བུདྷེ་ཌཱ་ཀི་ནཱིའི་སྔགས་ནི་གཅིག་གོ།",
    "དེ་ལྟར་གཉིས་ཡི་གེ་རེ་རེའི་བར་དུ་ཁ་སྦྱར་བའོ།",
    "དེ་ལྟར་ཨོཾ་སརྦ་བུདྷ་ཌཱ་ཀི་མྦི་དུབཛྲ་ཝཎྜི་རྔུབྷཱ་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "འདོད་ཅན་མོ་ཞེས་བྱ་བ་ནི་དཀྱིལ་འཁོར་ཐམས་ཅད་དང་དངོས་གྲུབ་ཐམས་ཅད་སྟེར་བ་མོ་སྟེ་འདོད་པའོ།",
    "བདག་གི་གདན་གྱི་མཚན་ཉིད་ཀྱིས་ཁམས་གསུམ་ཀྱང་སྟེ་དེ་ཉིད་ཤ་ཆེན་པོ་སྟེ་ཡོངས་སུ་ཟ་བར་གྱུར་པ་ནི་རྣམ་པར་རྟོག་པ་མེད་པར་རྟོག་པ་ཟ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་གང་དུ་ཡང་རྣལ་འབྱོར་པའི་གོམས་པས་རང་གི་ལྕེའི་འོག་གི་རྩ་བ་མེད་པར་བྱེད་དོ།་",
    "ཕག་མོ་ལ་ནི་ཤ་ཐམས་ཅད།",
    "མིག་ལ་སོགས་པ་རྣམ་པར་ཤེས་པ་དྲུག་གི་མཚན་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་གྱི་དུས་རྣམས་སུ་རྟོག་པ་ཡང་ངོ་དེ་དེ་ཉིད་ཀྱི་རྣལ་འབྱོར་དུ་སྡོམ་པ་དམ་ཚིག་ནི་དུས་ཏེ་རྣམ་པ་སྣ་ཚོགས་པ་མི་སྣང་བར་བྱས་ནས་དེ་ཉིད་ཟ་བའི་སྒྲས་དམ་ཚིག་སྡོམ་པའི་རྣལ་འབྱོར་གྱིས་ཞེས་བྱ་བའོ།",
    "ཡུལ་དབུས་སུ་ཞེས་བྱ་བ་ནི་དབུ་དུམར་འགྲོ་བར་གྱུར་པ་ན་རྩ་སོ་སོ་ལ་རང་གིས་རིག་པའི་སྔགས་ཀྱི་བཏུང་བ་སེམས་དང་སྲོག་ཏུ་ཀུན་དུ་སྤྱོད་པར་འགྱུར་རོ།",
    "རང་གི་གདན་ལ་གནས་ནས་ནི།",
    "གང་གིས་མངོན་སུམ་དུ་རྣམ་པར་གཟུང་བར་བྱའོ་ཞེས་བྱ་བའོ།",
    "གང་གིས་ཤེ་ན།",
    "ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པས་སྔགས་ཀྱི་ཡི་གེ་འདི་རྣམས་ཀྱིས་ཏེ་དེ་ཡང་མ་ཀ་ཨོཾ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་ནཱ་སྲུ་རཱ་ཞེས་བྱ་བའི་བར་དུ་འཁོར་ལོ་བཞི་རྣམས་སུ་གནས་ལ་སོགས་པའི་མིང་གི་ཡི་གེ་རྣམས་སོ།",
    "སོགས་པའི་སྒྲས་ནི་དཀྱིལ་འཁོར་གྱི་མཚན་ཉིད་དང་དེ་བཞིན་དུ་དམ་ཚིག་གི་སྒྲུབ་ཐབས་ཀྱང་ངོ།",
    "དེའི་ཀྱེ་ཕྱི་རོལ་གྱི་གཟུགས་རང་གིས་རང་ནི་རྒྱབདག་ཉིད་ལ་ལྟ་བ་སྟེ་དེ་ཉིད་སྐྱེད་པར་བྱེད་དོ།",
    "ནང་གི་བདག་ཉིད་ཀྱི་གཟུགས་དབྱེ་བ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་བལྟའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་བརླ་དང་པུས་མོ་དང་བྱིན་པ་དང་རྐང་མགོའོ།",
    "བཅུ་གཉིས་པོ་དེ་རྣམས་རེ་རེ་ལ་འཁོར་ལོ་བཅུ་གཉིས་ཀྱི་བདག་ཉིད་དོ།",
    "དེ་རྣམས་རེ་རེ་ལ་ཡང་ལྔ་ལྔ་ཞེས་བྱ་བ་ནི་བཅུ་གཉིས་པོ་རྣམས་ལ་ཤེས་པར་བྱ་སྟེ།",
    "དབུས་མ་དང་གླུ་ལེན་མ་དང་གཏུམ་མོ་དང་བདུད་འཇོམས་མ་སྟེ་བཞི་པོ་དུདེ་བཞིན་དུའོ།",
    "དེ་ཉིས་འགྱུར་རྩ་སུམ་ཅུ་རྣམས་ཀྱི་ཆུ་ཚོད་རྩ་དྲུག་ཅུའི་སྟེ་ཉིན་ཀྲུགཅིག་གི་ཆུ་ཚོད་དོ།",
    "ཞེས་བྱ་བ་ནི་རྐང་པ་དང་ལག་པ་ལ་ལྗུསོགས་པ་འདི་རྣམས་ཀྱི་ཚིགས་བཅུ་གཉིས་པོ་རེ་རེ་ལ་རྩ་སུམ་ཅུ་རྣམས་སོ།",
    "དེ་རྣམས་རེ་རེ་ལ་ཡང་མཚམས་ལྔའི་རྩ་རྣམས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་དུ་ཉི་མའི་ནང་དུ་སྲོག་གིས་ལྡུབགྲོད་པའི་འགྲོ་བ་སྟེ་རྩ་བའི་རྩར་འཇུག་པའོ།",
    "དེ་ལྟར་སུམ་ཅུ་པོ་རེ་རེ་ལ་དྲུག་དྲུག་ཏུ་འགྱུར་རོ།",
    "གང་ཉི་མ་རྒྱུ་བས་དེ་སྲོག་གི་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་བགྲོད་པ་སྟེ་ལམ་དམ་པར་འཇུག་པའོ།",
    "ད་ནི་མིང་གི་ཡི་གེ་རྣམས་ཀྱིས་རིགས་པར་བསྐྱེད་པ་གསུངས་པ་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པས་གཟུགས་ཅན་མ་འདྲི་བ་སྟེ་རྒྱུའི་ཡི་གེ་ནི་གང་གི་ཕྱིར་གྱི་དོན་ཏེ།",
    "དེ་སྔོན་དུ་གཟུགས་ཅན་མའི་རང་བཞིན་གྱི་ཡི་གེ་གསུངས་པའི་མིང་གི་ཡི་གེ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་ཤིག་པའོ།",
    "དེ་ཉིད་དེ་ལྟར་ཡང་གཡས་པའི་འདབ་མའི་གཟུགས་ཅན་མ་བདག་པོའི་གནས་སུ་འོངས་པས་དེ་རྡོ་རྗེ་ཕག་མོ་དང་མཁའ་འགྲོ་མ་དང་ཁཱ་མ་དང་ཁཎྜ་རོ་ཧའི་རང་བཞིན་གྱི་གཟུགས་ཅན་མར་འགྱུར་རོ།",
    "བདག་པོའི་གནས་ལས་གཟུགས་ཅན་མའི་གནས་སུ་འོངས་པས་རྡོ་རྗེ་ཕག་མོ་དང་མཁའ་འགྲོ་མ་དང་ཁཱ་མའི་རང་བཞིན་དུམ་སྐྱེས་མ་གཟུགས་ཅན་མའི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "སེར་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་རྟོགས་པར་སླའོ།",
    "གོ་ཆའི་དཔའ་བོ་དྲུག་གི་སྔགས་རྣམས་དང་ལྷན་ཅིག་ཡི་གེ་རེ་རེའི་བར་དུ་ཞེས་བྱ་བའོ།",
    "དེའི་སྦྱོར་བས་གཟུགས་ཀྱི་གཙོ་མོ་རྣམས་ཀྱི་རང་བཞིན་ནོ།",
    "གང་གིས་རྣལ་འབྱོར་མའི་དེ་ཁོ་ན་ཉིད་ཀྱི་གཟུགས་རྣམས་སུ་བརྟན་པ་ལ་སོགས་པ་ཐམས་ཅད་དྲན་པར་བྱའོ།",
    "མུ་སྟེགས་པ་ལ་སོགས་པའི་གཏུམ་མོ་རྣམས་རང་དང་གཞན་ལ་ཕན་པར་རྣམ་པར་དཔྱོད་པས་གང་ཡིན་པའི་མིའི་གཟུགས་ཀྱི་རྡོ་རྗེ་འཆང་སྟེ།",
    "ཕག་མོ་ལ་སོགས་པ་ཐམས་ཅད་དེའི་གནས་སྐབས་སུ་རྣམ་པར་བྱེད་པ་ལ་སོགས་པ་གསུམ་དུ་གྱུར་ཏོ།",
    "ཞེས་བྱ་བ་སྟེ་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་བྱེརང་གི་སེམས་དེས་སོ།",
    "སྲིང་མོ་ཁྱེད་ཅེས་བྱ་བ་ནི་ཀྱེའི་སྲིང་མོ་ཁྱེད་དོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འདིར་གང་གི་ཕྱིར།",
    "དཔའ་བོ་ཐམས་ཅད་སྒྲོལ་བར་མཛད་པ་མོ།",
    "སླར་ཡང་ཡོངས་སུ་དགའ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནི་དཔའ་བོ་ཐམས་ཅད་ཀྱི་རང་བཞིན་གྱི་སྐུ་ལ་ཆུ་ལ་ཆུ་བཞིན་དུ་རབ་ཏུ་ཞུགས་ཏེ་ཐམས་ཅད་རོ་མཉམ་པའི་རང་བཞིན་ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པ་ཐུཐིམ་པར་སོང་ཞེས་བྱ་བའོ།",
    "འོན་ཀྱང་ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པ་ཐིམ་པར་སོང་བས་གང་གི་ཚེ་སེམས་དྲན་པ་ཉེ་བར་གཞག་པའི་གཟུགས་ཅན་མ་དེའི་ཚེ་ཐིམ་པ་དང་སླར་ཡང་དེའི་སེམས་ཀྱི་རང་བཞིན་དེ་ལྟར་ཞལ་ལས་སྤྲོ་བའོ།",
    "རྣལ་འབྱོར་མ་ཐམས་ཅད་སྒྱུ་མ་ཆེན་མོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གི་ཕྱིར་དེ་བཞིན་དུ་དཔའ་བོའི་རང་བཞིན་དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་སླར་ཡང་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རྒྱུད་རྣམས་སྤྲོ་བའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་ལྷག་མ་ཞེས་པའི་བར་དུ་ཚིགས་སུ་བཅད་པ་དྲུག་གིས་རྣལ་འབྱོར་གྱི་རྒྱུད་སུམ་ཅུ་རྩ་དྲུག་རྣམས་ཏེ།",
    "རང་བྱུང་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་མ་རང་གི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ལས་བྱུང་བའོ།",
    "རང་གི་རང་བཞིན་རྟག་ཏུ་གནས།",
    "དངོས་པོའི་དབྱེ་བ་རྣམས་སུ་ཞེས་བྱ་བ་ནི་ཞི་བ་དང་དྲག་པོའི་དབྱེ་བ་དག་གིས་ཀྱེ་རྣམ་གྲངས་སོ་སོར་བྱས་པའོ།",
    "དོན་དམ་པར་བདེ་མཆོག་གི་རྣལ་འབྱོར་པས་རང་གིས་མཁའ་ལ་སྤྱོད་པ་ཉིད་ཐོབ་པའོ།",
    "གཟུགས་ཞེས་བྱ་བ་ནི་ཁམས་དྲུག་གི་བདག་ཉིད་ཅན་འདི་སྐྱེས་བུ་ཆེན་པོའི་གང་ཟག་གིས་གཟུགས་ཀྱི་སྐུ་སྟེ་དེ་སྲོག་དམན་པའི་དུས་སུ་འཆི་བ་ཞེས་བྱ་བར་འདུ་ཤེས་སོ།",
    "དེ་ལ་གནས་པའི་རྡོ་རྗེ་ཕག་མོ་མཁའ་འགྲོ་མའི་རང་བཞིན་བདག་པོའི་གནས་སུ་འོང་བའོ།",
    "སླར་ཡང་རྡོ་རྗེ་ཕག་མོ་དེ་བྱང་གི་འདབ་མ་ལ་འགྲོའོ།",
    "དེ་ལ་གནས་པའི་མཁའ་འགྲོ་མ་རྡོ་རྗེ་ཕག་མོ་དང་ཁཱ་མའི་རང་བཞིན་བདག་པོའི་གནས་སུ་འོང་བའོ།",
    "དེ་ལ་གནས་པའི་ལཱ་མ་རྡོ་རྗེ་ཕག་མོ་དང་མཁའ་འགྲོ་མ་དང་དུམ་སྐྱེས་མའི་རང་བཞིན་བདག་པོའི་གནས་སུ་འོང་བའོ།",
    "དེ་ལ་གནས་པའི་དུམ་སྐྱེས་མ་རྡོ་རྗེ་ཕག་མོ་དང་མཁའ་འགྲོ་མ་དང་དུམ་སྐྱེས་མ་དང་གཟུགས་ཅན་མའི་རང་བཞིན་བདག་པོའི་གནས་སུ་ལྷག་པར་འོང་བའོ།",
    "སླར་ཡང་གཟུགས་ཅན་མ་དེ་བྱང་གི་འདབ་མ་ལ་འགྲོའོ།",
    "དེ་ལ་གནས་པའི་རྡོ་རྗེ་ཕག་མོ་བདག་པོའི་གནས་སུ་འོང་ངོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་ཕག་མོ་ནུབ་ཀྱི་འདབ་མ་ལ་འགྲོའོ།",
    "དེ་བཞིན་དུ་དུམ་སྐྱེས་མ་བྱང་གི་འདབ་མར་འགྲོའོ།",
    "དེ་ན་གནས་པའི་རྡོ་རྗེ་ཕག་མོ་བདག་པོའི་གནས་སུ་ཀྲུའོང་ངོ།",
    "དེ་ལྟར་རྡོ་རྗེ་ཕག་མོ་ལྷོའི་འདབ་མ་ལ་འགྲོའོ།",
    "དེ་བཞིན་སྟིཁཱ་མ་བྱང་གི་འདབ་མ་ལ་འགྲོའོ།",
    "དེ་ལ་གནས་པའི་རྡོ་རྗེ་ཕག་མོ་བདག་པོའི་གནས་སུ་འོང་ངོ།",
    "འདི་གསུངས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པས་སྡུད་པར་མཛད་པ་མོའི་ཚིག་གོ།",
    "རྣལ་འབྱོར་མའི་མཆོག་མ་མོ་སྟེ།",
    "བདེན་པ་གཉིས་ལ་བརྟེན་བྱེ་པ་མོའི།",
    "ཙ་དང་མི་མོའི་རང་བཞིན་དུ་གནས་པ་སྟེ།",
    "ཤར་གྱི་སྒོར་གནས་པ་མོའི་ལྷ་མོ་ཁྭ་གདོང་མ་སྒོ་སྐྱོང་མ་བསམ་གཏན་བཞིའི་བདག་ཉིད་ཅན་ནོ།་།",
    "ཞེས་བྱ་བ་ནི་ཇི་ལྟར་བྱ་རོག་གི་གདོང་དེ་བཞིན་དུ་སྲོག་འབབ་པའི་བུ་གའི་ཁ་རྣམས་སོ།",
    "མངོན་སྤྱོད་ནི་གསོད་པ་སྟེ་རྟག་ཏུ་དུས་ཐམས་ཅད་དུ་མཉམ་པར་གཞག་པ་རྣམས་བྱས་ནས་དེ་ལ་ཞེས་བྱ་བ་ནི་བྱ་རོག་ལྟ་བུའི་གདོང་གི་བུ་གར་སྲོག་ཆགས་རྣམས་ཀྱི་སྲོག་བརྟེན་པ་སྟེ་རྣམ་པར་ཤེས་པ་རྣམ་པར་རྟོག་པའི་བདག་ཉིད་ཅན་གྱི་ངོ་བོ་ཉིད་རྣམས་ཀྱི་རང་བཞིན་ལ་གཞོམ་པ་སྟེ།",
    "ཇི་ལྟར་བྱ་རོག་གིས་ཟོས་པའི་ཤ་ལ་ལར་སོང་བར་གྱུར་པས་ཀླུ་དྲག་པོ་དང་ལྷ་ལ་སོགས་པ་ཁྱཤར་ལྷང་ངོ།",
    "སྲོག་གི་ནུས་པ་དང་སྲོག་མི་སྣང་བར་འགྱུར་རོ།",
    "དབུས་ཀྱི་གནས་ལས་རྡོ་རྗེ་ཕག་མོ་ཤར་གྱི་སྒོར་བྱ་རོག་མའི་གནས་སུ་འགྲོའོ།",
    "རྡོ་རྗེ་ཕག་མོའི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "ཨོཾ་ན་མོ་བྷ་ག་ཝ་ཏེ་བཱི་རེ་ཤཱ་ཡ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་སྭཱ་ཧཱ་ཧཱུཾ།",
    "ཡན་ལག་དྲུག་གི་གཞི་བརྟེན་མ།",
    "མཚན་ཉིད་མཆོག་ནི་གསང་བ་སྟེ་འཆད་པར་འགྱུར་བ་གང་གིས་འུག་གདོང་མ་འདིར་གང་གི་རང་བཞིན་གྱིས་གསལ་བར་ཤེས་པ་སྟེ།",
    "དེ་ཉིད་གཞན་འཆད་པ་སྟེ་དེ་བདག་གིས་སོ།",
    "ཞེས་བྱ་བ་ནི་འུག་གདོང་མའི་ཡི་གེ་བཞི་ནི་ཡེ་ཤེས་དེ་ལམ་གསུམ་དུ་འགྲོ་བ་མོ་གང་གིས་ཨ་ཝ་དྷཱུ་ཏཱི་སྒྲུབ་པར་བྱེད་དེ་ལམ་གསུམ་ནི་ལྟེ་བའི་གནས་ནས་ཏེ་བརྐྱང་མ་དང་རོ་མ་དང་ཨ་ཝ་སྒྲུ་ཏཱི་ཞེས་བྱ་བ་སྟེ།",
    "དྲག་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དྲག་པ་ཞེས་བྱ་བ་ནི་གཏུམ་པའི་འོད་ཟེར་འབར་བཞིན་པ་གཅིགས་པ་ལྷབ་ལྷབ་པར་གྱུར་པའོ།",
    "རྐང་པའི་མཐེབ་མཐར་བཅུ་གཉིས་༥ཞེས་བྱ་བ་ཡང་ནག་པོའི་ཚེས་གཅིག་ལ་སོགས་པ་ནས་ཇི་སྲིད་གནམ་སྟོང་གི་བར་དུ་སྟེ་དེ་དཔྲལ་བ་ནས་རྐང་པའི་མཐེ་བོའི་བར་དུ་་སྣའགྲོའོ།",
    "ཁྲོ་ཌི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས་གཙོ་མོའི་གཟུགས་ཅན་མ་ཞེས་བྱ་བའི་བར་དུ་རྟོགས་པར་སླའོ།",
    "འུག་གདོང་མ་ལ་སོགས་པ་སྟེ་དེ་ཉིད་ཀྱི་ནི་དབུས་ཀྱི་གཙོ་མོ་སྟེ་རྡོ་རྗེ་ཕག་མོའི་རང་བཞིན་དེའི་བདག་ཉིད་ལས་སྐྱེས་པའི་རྣལ་འབྱོར་མ་ཐམས་ཅད་དོ།",
    "སྔགས་ཀྱི་ཡི་གེ་གཉིས་བར་དུ་རེ་རེ་ཁ་སྦྱར་བར་གསུངས་པ།",
    "གཉིས་མེད་དུར་ཁྲོད་གནས་པ་མོ།",
    "འོན་ཀྱང་རྩ་ཛེེཀུན་དུ་སྤྱོད་པ་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་མ་ཐམས་ཅད་ཀྱི་ཕན་ཚུན་རང་གི་གནས་ལས་གཡོ་བས་སོ།",
    "དེ་ནས་བེེར་ཡང་བྱང་གི་སྒོར་འགྲོ་སྟེ་དབུས་བདག་པོའི་གནས་ནས་རྡོ་རྗེ་ཕག་མོའི་རང་བཞིན་གྱི་ཁཱ་གདོང་མ་ཡང་ངོ།",
    "དེ་ལ་གནས་པའི་འུག་གདོང་མ་བདག་པོའི་གནས་སུ་འོང་སྟེ་རྡོ་རྗེ་ཕག་མོ་དང་རྨྱེཁྭ་གདོང་མའི་རང་བཞིན་དུ་འགྱུར་རོ།",
    "ཇི་ལྟར་འུག་པ་གཞན་གྱི་གནས་སུ་འགྲོ་བ་ནི་མྱུར་བར་མཚན་མོ་བྱ་རོག་རྣམས་ཟ་བར་བྱེད་དོ།་།",
    "གང་གི་ཕྱིར་དེའི་སྦྱོར་བ་ཐམས་ཅད་ཅེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་སྤྱི་གཙུག་གི་ཚིགས་དང་།",
    "དེ་བཞིན་དུ་རྐང་པའི་སོར་མོ་དང་།",
    "གང་གི་ཚེ་དེའི་ཚེ་རང་གི་ཏྲེརིག་པ་མི་གཡོ་བར་འགྲོའོ།",
    "རྩ་བའི་རྩ་བ་ཞེས་བྱ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་མོར་རབ་ཏུ་གནས་སོ།",
    "ནག་པོའི་ཚེས་གཅིག་གི་མཐར་ཏེ།",
    "སོར་མོ་ཞེས་བྱ་བ་ནི་མཐེའུ་ཆུང་གི་སྟེང་དུ་མིང་མེད་སྦྱར་བར་བྱའོ།",
    "དེ་བཞིན་དུ་ཕྱི་དང་ནང་གི་བདག་ཉིད་ཀྱི་སྲོག་བསྐྱོད་པར་བྱ་བར་འདོད་དོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དེས་དེ་བཞིན་དུ་གཏུམ་མོ་འབར་བར་བྱའོ།"
  ]
}