    "སྦྲ་གུར་གྱི་གཡས་ཕྱོགས་སུ་མོ་སྦྲ་ཞེས་མར་དང་།",
    "དེའི་ནང་བུད་མེད་རྣམས་སྡོད་ཅིང་མོ་སྦྲའི་ཟུར་དུ་གཉེར་ཚང་ཡང་ཡོད།",
    "བུ་དང་བུ་མོ་སོ་སོས་གཉེན་སྒྲིག་བྱས་པ་ཉུང་ཉུང་རེད།",
    "འབྲོག་པ་ཁྱིམ་དུད་ཆེ་ཆུང་ཇི་འདྲ་ཞིག་ལ་སྤྱིར་བཏང་ནང་གི་བུ་རྒན་པ་དེར་གནའ་མ་བླངས་ནས་ཁྱིམ་གཞིས་འཛིན་བཅུག་པ་དང་།",
    "ད་དུང་བུ་གསུམ་པ་སོགས་ཡོད་ན་བུ་མོ་ཞིག་བསུས་ནས་ཁྱིམ་གཞིས་གསར་པ་འཛིན་བཅུག་གི་རེད།",
    "གལ་སྲིད་ཁྱིམ་དེར་བུ་མོ་ལས་བུ་མེད་ན་ཁྱིམ་གཞིས་འཛིན་མཁན་མག་པ་ཞིག་བསུ་བར་བྱེད།",
    "བུད་མེད་ཀྱིས་ལས་རིགས་དེ་རིགས་བྱེད་སྲོལ་མེད།",
    "རྐུ་རྒྱག་འཕྲོག་བཅོམ་སོགས་མགོ་འཇུག་གཏན་ནས་མེད་པ་དེ་འདྲའང་མ་རེད།",
    "འབྲོག་པའི་སྐྱེས་པ་ཚོར་ཤག་པོ་ཅེས་ཕན་ཚུན་མནའ་སྐྱལ་ནས་གྲོགས་པོ་བཟོ་ཀྱི་རེད།",
    "ཤག་པོ་དེ་གལ་ཆེ་ཤོས་བརྩི་གི་ཡོད།",
    "ཡུལ་ལྷ་གཞི་བདག་ཉི་ཟླ་དཔང་དུ་བཞག་ནས་དམ་བཅའི་ཚིག་བརྗོད་རེས་བྱས་རྗེས་གཞི་ནས་ཁོ་གཉིས་མནའ་གྲོགས་ཤག་པོར་གྱུར་བ་རེད།",
    "མནའ་བཞག་པའི་ཤག་པོ་ཕན་ཚུན་སྐྱིད་སྡུག་མཉམ་མྱོང་གིས་གཅིག་ཕན་གཅིག་གྲོགས་བྱེད་པ་རེད།",
    "མི་གཅིག་མནའ་གྲོགས་ཤག་པོ་ཁ་ཤས་ཡོང་གི་ཡོད་ཅིང་།",
    "གལ་ཏེ་མ་རྩ་བསྡིབས་པའམ་འཚོ་རྟེན་བྲལ་བ་སོགས་ཀྱི་དཀའ་ཁག་སྐབས་ཤག་པོས་རང་གི་འཁོས་བྱོར་ལ་གཞིགས་པའི་རོགས་རམ་ཁྱིམ་གཞི་འཛུགས་རོགས་བྱེད་ཀྱི་ཡོད།",
    "རྟ་རྒྱུགས་ནི་འབྲོག་པ་རྣམས་རྩེ་དགའ་ཆེ་བའི་རྩེད་མོའི་རིགས་ཤིག་རེད།",
    "འབྲོག་པ་ཚང་མས་དེར་ཧ་ཅང་དགའ་པོ་བྱེད་ཅིང་ས་ཐག་རིང་ཐུང་ལ་མ་བལྟོས་པར་ལྟད་མོར་ཡོང་བ་དང་།",
    "རྟ་རྩལ་བསྡུར་གྱི་རེད།",
    "གཉིས་པ་ནི་རྟའི་འགྱོགས་ཚད་བསྡུར་བ་རེད།",
    "གཡོན་སྐོར་གྱིས་རྩལ་ལག་འདོན་འབེན་ལ་འཕེན་གྱི་ཡོད་པས་ཕོ་གསར་ཚོའི་རྩལ་ངོམས་ས་ཞིག་རེད།",
    "རྟ་རྣམས་གཤིབས་ནས་རྒྱང་ཐག་རིང་ཐུང་ཚད་བཞག་ནས་དེར་སུ་སླེབས་ཀྱི་མགྱོགས་ཚད་བསྡུར་བ་རེད།",
    "དཔྱིད་དུས་དེ་འབྲོག་པར་དཀའ་ལས་ཁག་ཤོས་ཤིག་རེད།",
    "རྩི་མེ་ཏོག་བརྒྱ་འཛོམས་སྟོང་འཛོམས་རེད།",
    "དཀར་ཆེ་བ་སྤང་རྒྱན་མེ་ཏོག་རེད།",
    "ས་གར་སོང་དགྲ་ལྷའི་ཁ་འཛིན་མཛོད།",
    "ཁ་ནས་བོད་ལ་རོགས་སྐྱོར་ཡིན་བརྗོད་ཀྱི་ཡོད་ཀྱང་དོན་དུ་བོད་འདི་ཟ་སེམས་རེད།",
    "སྤུན་ཟླ་མི་རིགས་ཟེར་བ་སོགས་བརྗོད་མི་བདེ་བའི་སྔར་མེད་ཚིག་མང་པོ་བྱེད་སྤྱོད་གཏོང་བཅུག་སོང་།",
    "འདམ་པ་ཤོག་གི་རྟ་པ་བཅུ་ཡོང་དགོས་ཅེས་བོད་གཞུང་ནས་བཀའ་ཡིག་འབྱོར་སོང་།",
    "རྭ་སྒྲེང་ཤོག་ཁའི་རྟ་པ་བཅུ་ཡི་འགོ་བྱེད་ད་ལྟ་རྡ་རམ་ས་ལར་ཡོད་པའི་འཕྲིན་ལས་ཕོ་གསར་རེད།",
    "མའོ་གི་དཔར་ཆེན་པོ་རེ་བསྒྲིག་པ་དང་།",
    "བོད་གཞུང་གི་ཞི་དྲག་དཔོན་པོ་རྣམས་རྟ་རྒྱུགས་བྱེད་སའི་སྡིང་ཆའི་ཐོག་གཟིགས་མོར་འདུག་རྟ་རྒྱུགས་སུ་རྭ་སྒྲེང་ཤོག་གི་རྟ་པ་བཅུ་དང་།",
    "འདམ་པ་ཤོག་གི་རྟ་པ་བཅུ་ལས་མི་འདུག་ཉིན་དང་པོར་རྟ་ཐོག་ནས་མེ་མདའ་འཕེན་རྒྱུ་དང་།",
    "ཉིན་གཉིས་པར་ཁ་བཏགས་དང་ཤོག་ཆག་སྒྲུག་རྒྱུ་རེད།",
    "བོད་གཞུང་ནས་མི་རེར་ཁ་བཏགས་དང་དངུལ་སྲང་བརྒྱ།",
    "རྒྱ་ཕྱོགས་ནས་མི་རེར་གཞི་གྲུ་སིའི་ཐོག་འཚེམ་དྲུབ་ཡིན་པའི་པེ་ཅིང་གི་དཔར་རེ་དང་།",
    "གྲི་རྒྱ་གྲི་རེ།",
    "ཐ་མག་སྒམ་རེ།",
    "རྡ་ཡང་དཀར་པོ་ལྔ་བཅུ་རེ་བཅས་སྤྲད་བྱུང་།",
    "ལྟད་མོར་མི་དམངས་མང་པོ་སླེབས་འདུག་ས་ནག་གད་པའི་ཁུག་སོ་ནས།",
    "རྒྱ་གྲོང་ཁྲ་མོའི་ཁུག་སོ་ནས།",
    "དེ་ནི་སྤྱི་ལོ་༡༩༥༩ ལོ་རེད།",
    "ང་ཚོའི་སྦྲ་ཁག་དེར་མི་དྲུག་ཡོད་ཅིང་མལ་གྲོ་གུང་དཀར་བརྒྱུད་ཟི་སྦུག་ནང་ཡར་འཛུལ་ནས་འོང་རྟ་སྒ་ལ་བརྒྱབ་ནས་འོམ་བུ་སྡིང་སྣ་ལ་སླེབས།",
    "རིམ་བཞིན་ལྷོ་ཁ་ཉང་པོ་གྲུ་ལ་སླེབས་རྒྱུ་རེད།",
    "ཟངས་རི་གྲུ་ཁ་བརྒྱུད་ལྕགས་ཚ་གྲི་གུ་ཐང་དུ་སླེབས་རྒྱུ་རེད།",
    "ང་ཚོ་འོམ་བུ་སྡིང་སྣར་འབྱོར་སྐབས་ཟིང་འཁྲུག་ལངས་ནས་ལྷ་ས་ཤོར་ཚར་བའི་གནས་ཚུལ་གོ་བྱུང་།",
    "ཉིན་དེ་བོད་ཟླ་༢ ཚེས་༡༧ ཡིན་པ་གསལ་པོ་ངེས་ཀྱི་འདུག་དུས་ཚོད་ཛ་དྲག་དེ་འདྲར་ལ་སླེབས་པས་ཚོང་ཡོང་ཡས་མེད་སྟབས་ང་ཚོའི་སྦྲ་ཁག་གི་ཤ་མར་ཚ་སོགས་གཡག་གི་རྒྱབ་ཆ་ཆ་ཚང་མི་ཚང་ཞིག་ལ་བཅོལ།",
    "རྗེས་སུ་སྦྲ་ཁག་དེའི་རྒྱབ་ཆ་ཆ་ཚང་རྒྱ་མིས་འཕྲོག་བཅོམ་བྱས་པ་རེད།",
    "སྟོད་ལུང་ནས་ཡིན་པ་བློ་བཟང་ཕུན་ཚོགས་ཟེར་བ་གཉིས་རེད་འདུག་པས་ཁོང་གཉིས་ལ་མགོ་བཏགས་ནས་དམག་ཁོངས་དེར་འཛུལ།",
    "རོ་འཇོག་གི་ཡིན་ཞེས་སྐད་བརྒྱབ་པར་ང་ཚོ་མི་རྟ་ཧྲག་ཅིང་གོ་ལག་བཟང་བས་ཚུར་རྒོལ་བྱེད་མ་ཕོད་པར་ཁམས་རྫུས་མི་བཅུ་པོ་དེ་མགོ་སྒུར་སོང་།",
    "བུད་མེད་ཀྱི་གྱི་ཟོམ་པ་ཡང་འཕྲོག་བཅོམ་བྱས་པ་ཁྱོན་དོ་པོ་པང་དུ་ལེན་ཐུབ་ཙམ་དྲུག་འདུག་དེ་དག་ས་ཆ་གང་དང་།",
    "ཁམས་རྫུས་ཇག་པ་བཅུ་པོ་མེ་མདའ་རྒྱབ་ནས་དམར་བསད་བཏང་སྟེ་རོ་རྣམས་ས་དོང་གཅིག་ནང་དབྱུགས་པ་རེད།",
    "དུས་ཚོད་གཉན་འཕྲང་གི་དུས་འདིར་ཀྱི་བོད་བསྟན་པ་ཆབ་སྲིད་དོན་དུ་སྲོག་དམར་འབེན་ལ་བཙུགས་ནས་དགྲ་ལ་འཛིང་སྐབས་ཁ་ཤས་ཀྱིས་མེ་མདའ་འཁྱེར་ནས་ཇག་བཅོམ་བྱེད་པ་དེ་འོས་མིན་ལས་འབྲས་དང་མ་མཐུན་པས་ཇག་པ་རེ་རེ་བཞིན་ཁང་པའི་ཕྱིར་འབུད་རྒྱག་རྒྱབ་པ་དང་།",
    "གཡས་གཡོན་ནས་མི་གཉིས་ཀྱིས་མེ་མདའ་ཁ་བསྒྲིགས་ནས་རྒྱག་སྐབས་མ་གསོད་རོགས་ཅེས་ཞུ་བ་མང་པོ་འཐེན་སོང་ཡང་མ་ཉན་པར་ཚང་མ་དམར་གསོད་བཏང་བ་རེད།",
    "ང་ཚོ་རྟ་ལ་རྨིག་ལྕགས་རྒྱག་རྒྱུ་ཡིན་སྟབས་མཉམ་དུ་བསྐྱོད་མ་ཐུབ་ཅིང་ལམ་སེང་རྨིག་ལྕགས་རྒྱག་དགོས་ཁག་བརྒྱབ་ནས་ནམ་གསལ་མཚམས་ཐོན་པ་ཡིན།",
    "ཟངས་རི་ནི་ལྷོ་ཁར་ཡོད་པའི་བསྟན་སྲུང་དང་བླངས་དམག་གིས་སྲུང་བསྡད་ཡོད་པ་རེད།",
    "དེ་འཕྲལ་མེ་མདས་གྲོ་ཡོས་བརྔོས་སོང་།",
    "འཕྲང་གི་མགོ་མཇུག་གཉིས་སུ་རྒྱ་མིས་སྔོན་ཚུད་ནས་ག་ར་སྤྲད་འདུག་པས་མདུན་སྐྱོད་དང་ཕྱིར་འཐེན་བྱེད་ས་མི་འདུག།",
    "རྒྱ་དམག་གིས་ལྷོ་ཁར་ཟླ་བསྒྲིལ་རྩིས་བྱེད་མཁན་བསྟན་སྲུང་དྭང་བླངས་དམག་འཕྲང་སྒུག་རྒྱག་པར་ཡོང་ཡང་ང་ཚོའི་སྔོན་ལ་བསྐྱོད་མཁན་བསྟན་སྲུང་དྭང་བླངས་དམག་ཀྱི་མཇུག་མ་ཟིན་པར་ང་ཚོ་དང་ཁ་ཐུག་རྒྱབ་པ་རེད།",
    "སྒང་དུ་རི་དང་འོག་ཏུ་གཙང་པོ་རེད།",
    "ཐར་ས་མི་འདུག་ཁག་གཅིག་མི་རྟ་མཉམ་དུ་གཙང་པོར་མཆོང་སོང་།",
    "ཕར་མེ་མདའ་རྒྱག་ཡུལ་མཐོང་གི་མི་འདུག་རྒྱབ་མདུན་གཉིས་ནས་མེ་ཤིན་ལྷན་བརྒྱབ་ནས་མདེའུ་ཡིས་ས་གཞི་འཁོལ་གྱི་འདུག་ཅི་བྱེད་མེད་པར་རྟ་གཡུགས་ནས་རི་ལ་འབྱར་བ་ཡིན།",
    "ང་ཚོའི་རྗེས་ལ་མེ་མདའ་ལྕགས་ཚགས་དང་མེ་ཤིན་གྷན་བརྒྱབ་ཡོང་ནས་ཐལ་འཚུབ་རྒྱག་གི་འདུག་ཕར་འཛིངས་ས་མི་འདུག་པས་བྲོས་རྒྱུ་རེད།",
    "གོམ་པ་ཉིས་བརྒྱ་ཙམ་ནས་དབུགས་ཧལ་ནས་གྱེན་ལ་འགྲོ་ཐུབ་ཀྱི་མི་འདུག་རྒྱ་དམག་རྗེས་ལ་རྒྱུགས་ཡོང་གི་འདུག་པས་ཅི་བྱེད་མེད་པར་མེ་མདའ་ཡང་གཡུགས་ནས་རི་ལ་ཁ་གཏད་དེ་བྲོས།",
    "ང་ཚོ་ཚང་མ་ཁ་ཐོར་སོང་ཞིང་དེ་ཉིན་རྒན་སྦུ་ཏི་ཡང་ཁ་ཐོར་བ་རེད།",
    "ལོ་ཤས་གོང་ང་རང་བཙན་བྱོལ་དུ་འབྱོར་ནས་རྒན་སྦོ་ཏི་བརྩད་གཅོད་སྐབས་རྒན་སྦོ་ཏི་འབྲུག་གིས་དཀྲོངས་པ་རེད་ཟེར་བ་ཞིག་གོ་བྱུང་།",
    "དེ་ཉིན་བྲོས་ཐར་སོང་།",
    "ཅི་བྱེད་མི་འདུག་པས་ཉིན་མཚན་མེད་པར་ང་རང་གཅིག་པུ་རི་སྟོང་ལུང་སྟོང་བརྒྱུད་འབྲོག་པ་འདྲ་ཐུག་ཚེ་རྩམ་པ་སོགས་ཟ་རྒྱུ་སློང་གིན་མང་ཆེ་བ་རྟོགས་པར་ཡོང་ནས་མལ་གྲོ་གུང་དཀར་དུ་འབྱོར།",
    "རྒྱ་དམག་དེ་དག་ལྷ་ས་བླངས་ནས་ནོར་བུ་གླིང་ཁའི་ནང་ཡོད་གཞུང་གི་ཆིབས་རའི་རྟ་རྣམས་གཞོན་ཏེ་མལ་གྲོ་དང་འབྲི་གུང་གི་ས་ཟིན་པར་ཡོང་བ་ཞིག་རེད་འདུག་རྒྱ་དམག་རྣམས་ལམ་སེང་འབྲི་གུང་དུ་ཤོར་ཕྱིན་སོང་།",
    "རྒྱ་དམག་གིས་སྐད་བསྒྱུར་བརྒྱུད་ནས་དྲི་བ་བླངས་སོང་བར་ང་རང་ཚོང་པ་ཡིན་པ་དང་།",
    "ཉིན་མཚན་གསུམ་གོམ་པ་རྒྱབ་སྟེ་ང་མག་པར་འགྲོ་སའི་རེ་རུར་སྦྲ་ཆེན་ཚང་དུ་སླེབས་ཐུབ་ཙམ་བྱུང་།",
    "ཟོག་རྫི་ཐུག་སྐབས་རྩམ་པ་སློང་གིན་ཆུ་ལྕགས་བཟས་ནས་ཚ་པོ་ཁ་ལ་མ་རག་པར་ཡོང་བ་རེད།",
    "ནང་དུ་བཟའ་ཟླས་གཙོས་པའི་ནང་མི་ཚང་མ་དགའ་ཐག་ཆོད་སོང་།",
    "སྲོག་མགོ་ཐོན་ནས་ལོག་ཐུབ་པ་ཙམ་གྱིས་འགྲིག་པ་རེད།",
    "ཁོང་གཉིས་ལྷོ་ཁར་ཡོད་པའི་བསྟན་སྲུང་དྭང་བླངས་དམག་སྒར་ནས་ཡིན་པའི་ལག་འཁྱེར་ཡང་འཁྱེར་རྒྱུ་འདུག་ང་རང་དམག་ལ་འགྲོ་རྒྱུ་ཡིན་སྐོར་ཞུས་པར་དམག་སྤྱི་གཉིས་ནས་ཏན་ཏན་འགྲོ་གི་ཡིན་པས་ཅེས་དྲིས་བྱུང་།",
    "དམག་སྤྱི་ཛམ་ལྷས་ཁྱོད་སེམས་ཐག་བཅད་ནས་འགྲོ་རྒྱུ་ཡིན་ན་འགྲིག་གི་རེད།",
    "འགྲོ་ཐུབ་པ་ཡག་པོ་རེད།",
    "དཀའ་ལས་ཏོག་ཙམ་མྱངས་རྒྱུ་རེད།",
    "དེ་གར་འབྲས་སྤུངས་བློ་གསལ་གླིང་གི་འབྲུ་ཁང་རྒྱ་མིས་བཙན་བཟུང་བྱས་ནས་སྒོ་ཐེལ་རྒྱབ་འདུག་པ་ང་ཚོ་དྭང་བླངས་དམག་གིས་སྒོ་ཐེལ་གཏོར་ནས་འབྲུ་རིགས་རྣམས་དེ་གའི་མི་སེར་ལ་བགོ་འགྲེམས་བྱས།",
    "ང་ཚོའི་བཞོན་རྟའི་ཁ་ལའང་འབྲུ་དོ་པོ་ཁ་ཕྱེ་ནས་བྱོ།",
    "བར་སྐབས་གཅིག་ལ་དྭང་བླངས་དམག་གི་རྟ་ཡི་རྟ་ལུད་འབྲུ་རིགས་མ་གཏོགས་དོན་ཡས་མི་འདུག་ཟེར་སྲོལ་བྱུང་སོང་།",
    "རྒྱ་དམག་གཅིག་ང་ཚོ་དང་སྤྱི་མཚུངས་མེ་མདའ་སྤྲད་ནས་དམག་དཀྱུས་ཁོངས་རེད།",
    "ཞབས་གྲས་བསམ་གཏན་སྦྱིན་པ་གསུམ་གྱིས་རྒྱ་མིའི་ཧུར་བརྩོན་པ་བྱས་ནས་རྭ་སྒྲེང་ཤོག་ཆེན་བཅུ་གཉིས་ནང་གི་གོ་ལག་མཚོན་ཆ་ཡོད་དོ་ཅོག་བསྡུ་རུབ་ཀྱིས་རྒྱ་མིར་རྩིས་སྤྲོད་བྱས་པ་མ་ཟད།",
    "རྩིས་སྤྲོད་བྱེད་པར་ལྷ་སར་ཡང་ཕྱིན་འདུག་ངའི་པ་ལགས་དང་གྲོས་བྱས་ནས་བྱེད་གཏེ་གསུམ་འཇུ་བཟུང་གིས་འཇམ་དཔལ་སྟེ་པོ་དམར་གསོད་གཏོང་རྒྱུར་ཐག་བཅད།",
    "དམག་སྤྱི་ཛམ་ལྷས་གོ་ལག་རང་བསྒྲིག་གི་དྭང་བླངས་དམག་མི་རྟ་པ་བརྒྱད་འཇམ་དཔལ་སྟེ་པོ་དང་།",
    "བསམ་གཏན་སྦྱིན་པ་གསུམ་འཇུ་བཟུང་བྱེད་པར་བཏང་སོང་།",
    "ང་ཚོ་མི་རྟ་དམག་བརྒྱད་ཕ་བོང་ཐང་སྣེའི་རྒྱ་འོང་སེར་ཁྲར་ཞག་སྡོད་བྱས་ནས་ཕྱི་ཉིན་ཐོ་རེངས་སུ་རྭ་སྒྲེང་བླ་བྲང་མཐའ་སྐོར་བ་ཡིན།",
    "ཞབས་གྲས་བསམ་གཏན་སྦྱིན་པ་གསུམ་འཇུ་བཟུང་གིས་ཉིན་ལམ་གཅིག་གི་ས་ཆར་འཁྲིད་ནས་གཙང་གཤོད་ཐིལ་པའི་ནང་དུ་སྒར་བབ།",
    "དགོང་མོ་ལུང་ཁུག་ཏུ་འཁྲིད་ནས་འཇམ་དཔལ་སྟེ་པོ་སྲོག་ཐོག་གཏོང་རྒྱུ་དང་།",
    "དེ་རྗེས་རྒྱ་མིའི་སྐད་བསྒྱུར་བྱས་སོང་།",
    "ཁོ་གསོད་རྩིས་བྱ་དགོས་དོན་གང་ཡིན་ནམ་ཞེས་ང་ལ་དྲི་བ་འདོན་སྐབས་ར་སྒྲེང་ཤོག་གི་གོ་ལག་ཆ་ཚང་ཁོ་པས་རྒྱ་མིར་རྩིས་སྤྲོད་བྱས་སྟབས་གསོད་རྩིས་བྱས་པ་ཡིན་ཞེས་ལན་འདེབས་བྱས་༡༤ ལ་།",
    "པ་ནི་དེ་ནི་ཁོ་པས་གུང་ཁྲན་ཏང་ལ་བློ་དཀར་བའི་བྱ་བ་བཟང་པོ་ཞིག་སྒྲུབ་པའི་དཔང་རྟགས་སུ་གྱུར་བ་རེད།",
    "ལྷོ་ཁ་ནས་ཡོང་བའི་བསྟན་སྲུང་དྭང་བླངས་དམག་དང་ང་ཚོ་གཙང་གཤོང་ནས་ཁ་གྱེས།",
    "ཁོ་ཚོའང་བོད་ཀྱི་བསྟནསྲིད་ཞེ་ལ་བཞག་ནས་ས་མཐར་འཁྱམས་རྒྱུ་རེད།",
    "འོན་ཀྱང་ས་བྱང་སྟོང་སྐྱོ་མོར་མི་ལ་ཟ་རྒྱུ་དང་།",
    "བསམ་འགྲུབ་གཉིས་ཡིན་ཞིང་ཁོང་གཉིས་ཁམས་པ་རེད།",
    "ཁྱོད་ཡོང་སའི་བརྒྱུད་ལ་ངོ་ལོག་པ་མཐོང་ཡས་མི་འདུག་གས།",
    "རྟ་ཕོ་ཆེན་ཞིག་ཡོད་པ་དེ་ལོག་སྤྱོད་པས་འཁྲིད་ཚར་སོང་།",
    "ལོག་སྤྱོད་པ་ཟེར་བའི་སྐད་ཆ་དེས་ང་ཁོང་ཁྲོ་བཟའ་ནས་ཁོ་ལྟད་མོ་ལྟོས་ཨ་བསམ་སྟེ།",
    "ལོག་སྤྱོད་པ་མི་འདུག་ལབ་པས་ཁོ་ཤར་རྒྱག་ཕྱིན་སོང་།",
    "ཁོ་ཚོའང་དགྲ་རྒྱ་མི་དང་འཛིང་ནས་ཡོང་བ་ཞིག་རེད་འདུག་ཅིང་རྭ་སྒྲེང་གི་ཡུལ་རའི་གྲོང་གི་འཕྲིན་ལས་ཁམས་པ་དང་སྒྲོལ་འཛོམས་ནང་དུ་གནས་ཚང་བསྡད་སོང་།",
    "ངའི་སྐྱེས་ཁང་གཤོང་གྲོང་སྟོད་ཚང་དུ་ཞག་སྡོད་བྱས་པ་དང་མཚན་མོ་པ་ལགས་ཀྱིས་མ་ཤེས་པར་རྟ་བཞོན།",
    "ཁོ་རེ།",
    "ངས་ཞྭ་མོ་ཝ་ཞྭ་གྱོན།",
    "ཁ་དཀྲིས་བརྒྱབ་ནས་ངོ་མི་ཤེས་པར་བྱས་ཡོད་ཀྱང་གནས་ཚང་གིས་ཧ་གོ་ཡོད་འདུག་པས་རྗེས་སུ་རྒྱ་མིར་བསྟན་པ་ཚེ་རིང་ལོག་སྤྱོད་ཁམས་པ་མཉམ་དུ་ཁོ་པ་ཚོའི་ནང་ཇག་བཅོམ་བྱེད་པར་ཡོང་སྐོར་བརྗོད་འདུག་གང་ལྟར་སྐབས་དེར་མ་འཚམས་པའི་ལས་ཤིག་བྱས་པ་རེད།",
    "དེ་ནུབ་ངའི་ནང་རེ་རུ་སྦྲ་ཆེན་ཚང་དུ་ཞག་སྡོད་བྱས་པ་དང་རོགས་པ་གཉིས་འགར་པ་གྲོང་ཚོའི་གྲོང་སྟོད་ཚང་གི་དོན་ཡོད་པ་ཡོད་སར་རྟ་ལ་སྟེར་རྒྱུའི་རྩ་རྒྱབ་གཉིས་སློང་བར་བཏང་།",
    "རེ་རུ་ཚང་དང་འགར་པ་གྲོང་སྟོད་བར་འཕྲང་ནག་འཕྲང་ཞེས་པའི་འཕྲང་ཞིག་ལས་མེད།",
    "རྩ་རྟ་རྒྱབ་གཉིས་བཀལ་ནས་དོན་ཡོད་པ་ཡང་འཁྲིད་འདུག་རྩ་དགོས་ཡོད་ཟེར་དུས་མ་སྤྲད་པ་ཡིན་ཚེ་འཕྲོག་རྒྱུ་རེད།",
    "ཞོགས་སྔ་ལངས་དང་དགོང་ཕྱི་ཉལ་གྱིས་མྱུར་བསྐྱོད་བྱས་ནས་ཉིན་ཞག་ཁ་ཤས་ཐོག་བྱང་མི་ཏི་ཁ་ལ་འབྱོར་སོང་།",
    "བྱང་སྟོང་སྐྱོ་མོའི་སྤང་གཤོང་གད་ཁར་སྐྱབས་བཅོལ་ནས་སྒར་བབ།",
    "ས་ཆ་འདི་ལ་རྒྱ་མི་སླེབས་མ་ཐུབ་པར་བློ་བཅོལ་བ་རེད།",
    "བློ་ལྷོད་ལ་ཕབ་ནས་ཉལ་བའི་ཐོ་རེངས་ཤིག་རྒྱ་སླེབས་སོང་ཟེར་བས་ཡར་ལངས་སྐབས་རྒྱ་མིའི་རྟ་དམག་ཉིས་བརྒྱ་སྐོར་ཞིག་སླེབས་ཚར་འདུག་རྟ་དམག་དེ་ཚོ་ཆེད་མངགས་ང་ཚོ་རྗེས་འདེད་བཏང་ནས་ཡོང་བ་ཞིག་རེད་འདུག་ཅིང་ང་ཚོ་མྱུར་བསྐྱོད་བྱས་སྟབས་ད་བར་རྗེས་མ་ཟིན་པ་རེད།",
    "དགྲ་འཁྲིས་ལ་འབྱོར་དུས་འཛིང་རྒྱུ་རེད།",
    "རྒྱ་དམག་ང་ཚོ་ལས་ལྡབ་ཁ་ཤས་ཀྱིས་མང་བ་ཡོད་པས་དེ་འདྲའི་བློ་ཤེད་ཀྱིས་རྟ་ཐོག་ནས་མེ་མདའ་འཕེན་གིན་ང་ཚོའི་ཕྱོགས་ལ་ཤོར་ཡོང་གི་འདུག་ང་ཚོ་གཏོར་ཐེངས་གཅིག་ལ་རྩ་མེད་བཟོ་རྒྱུའི་དམིགས་ཡུལ་ཡོད་པ་འདྲ།",
    "རྒྱ་དམག་རྟ་གཞོན་ནས་ང་ཚོའི་སྟེང་ཤོར་ཡོང་གི་ཡོད་ཀྱང་ང་ཚོས་འཐབ་ས་ཟིན་ཡོད་པས་རྒྱ་མིའི་མི་རྟ་མང་པོ་གསོད་ཐུབ་བྱུང་།",
    "ཚུར་བརྒྱབ་ཡོང་བ་དེ་རྟ་ཐོག་གི་མེ་མདའ་ཡིན་པས་ཟིར་པོ་མི་འདུག་མེ་མདའ་རེ་རྒྱབ་ནས་ཀི་སྒྲ་རེ་བསྒྲོགས་ནས་རྒྱ་མི་མང་པོ་ས་ལ་བརྡབ་ཐུབ་སོང་།",
    "ང་ཚོ་དམག་ས་ནས་ཕྱིར་འཐེན་བྱ་སྐབས་མི་ལྔ་ཙམ་ཞིག་ཚང་མི་འདུག་དེ་ཉིན་དམག་ཐོག་ཏུ་ཤོར་བ་རེད།",
    "ལམ་བར་འབྲོག་པ་རེ་ཟུང་ལས་རྒྱ་མི་གང་ཡང་གདོང་ཐུག་བརྒྱབ་མ་བྱུང་།",
    "སོ་པ་རིང་ཐུང་རྣམས་རྟ་སྒ་ཡང་མ་བཤུས་པར་ནམ་རྒྱུན་བཞིན་རྒྱང་ཤེལ་འཁྱེར་ནས་སོ་ལ་ཕྱིན་སོང་།",
    "ལམ་སེང་རྡོ་དང་སྤོ་ཐོ་སོགས་ཀྱིས་འཛིང་རགས་བཟོས་པས་དེ་འཕྲལ་འཛིང་རེས་ཐུག་ཚར་སོང་།",
    "ངའི་གཡས་གཡོན་ནས་རོགས་པ་ཁ་ཤས་ཁྲག་དམར་ནང་འགྱེལ་ཚར་སོང་ཞིང་ཕར་ལའང་དགའ་རབ་གསོད་ཐུབ་བྱུང་།",
    "རྒྱ་དམག་གིས་མེ་ཤིན་གྷན་རྒྱབ་བྱུང་།",
    "རང་རེའི་མི་བཅུ་སྐོར་ཤོར་སོང་།",
    "མི་ཤིན་གྷན་གྱི་ཁ་འོག་ནས་གདོང་བསྟན་ཐུབ་ཀྱི་མི་འདུག་པས་ང་ཚོ་སྒར་གློད་ནས་ཕྱིར་འཐེན་གྱིས་ཁ་ཐོར་སོང་།",
    "ང་ཚོ་ཁ་ཐོར་བ་ཟླ་བསྒྲིལ་ཐུབ་མ་བྱུང་བས་ཅི་བྱེད་མེད་པར་མི་རྐྱང་རྟ་རྐྱང་གིས་ཉིན་མཚན་མེད་པར་ནང་དུ་ལོག་ཡོང་བ་ཡིན།",
    "སོ་སོའི་བཞོན་རྟ་ཆད་པའི་ཚེ་ས་ཆ་དེ་གར་བཞག་ནས་འབྲོག་པའི་རྟ་གཞན་ཞིག་བརྗེ་རྒྱུ་རེད།",
    "ཉིན་མཚན་གསུམ་བཞིའི་ནང་རེ་རུ་སྦ་ཆེན་ཚང་དུ་འབྱོར་ཐུབ་ཙམ་བྱུང་།",
    "སྦྱོར་ཤོག་ཚ་པོ་ཅི་ཇོ་ལེ་རེད་ཅེས་མེ་མདའ་སྤོར་ཏོག་དཀྲུག་ནས་རྒྱག་པར་ཡོང་སོང་བར་བཟའ་ཟླའི་ཕ་རེ་རུའི་ལྷ་ཀོག་ནས་སྐུ་མཁྱེན།",
    "མི་མ་གསོད་རོགས་ཅེས་ཞུ་བ་མཐེན་བཞིན་མེ་མདའ་འཇུས་ནས་ས་ལ་ཁ་གཅུས་པ་དང་རྐམ་པ་བསྣན་པ་མཉམ་དུ་འཁེལ་ནས་མདེའུ་རྐང་པའི་འཁྲིས་ཀྱི་རྡོ་ལ་ཐེབས་ནས་རྡོའི་ཕྱེའི་མེ་སྟག་འཐོར་ཡོང་སོང་།",
    "ཏོག་ཙམ་མིན་ན་ང་བསད་ཚར་བ་རེད།",
    "མེ་མདའ་ཉལ་སའི་གདན་འོག་གི་ཟུར་དུ་སྦས་ཡོད་པས་ཁོ་ཚོའི་ལག་ཏུ་ཐེབས་མ་སོང་།",
    "ཕྱི་ཉིན་ཁོ་ཚོ་སྡོད་ས་བཙད་གཅོད་བྱས་པར་འགའི་ནང་གི་ཚངས་པ་ཚང་ཞེས་པའི་དུད་ཆེན་དེ་རང་ཡིན་པ་ཧ་གོ་བྱུང་།",
    "བསྟན་སྲུང་དྭང་བླངས་དམག་དེའི་འགོ་བྱེད་ལི་ཐང་ཕུན་ཚོགས་ཟེར་བ་དང་ང་ལ་མེ་མདའ་རྒྱག་མཁན་ལི་ཐང་ཕུན་ཚོགས་རེད་འདུག་ཁོ་པ་སྐབས་དེར་ལོ་༢༢ ཡིན་པ་དང་།",
    "དེ་སྔ་ལྷ་སར་ཚོང་བརྒྱབ་ནས་སྡོད་མཁན་ཞིག་རེད།",
    "ལྷག་དོན་ལུང་པའི་གཡས་གཡོན་ནས་སྒེར་ནང་གྱེན་ལོག་འཇབ་དམག་གི་སྒར་ཡོད་པ་ཡོངས་གྲགས་ཏུ་གྱུར་བས་ས་ཆ་སྤོས་ཏེ་འབྲི་གུང་སི་རི་རོང་དུ་འགྲོ་རྒྱུའི་གྲོས་ཁ་བྱས།",
    "སྒར་བཏེགས་ནས་མི་རྟ་སུམ་ཅུ་སྐོར་དེ་འབྲི་གུང་སི་རི་རོང་གི་འོག་ཤོད་ནང་དུ་འབྱོར་སྐབས་དེ་གར་རྒྱ་མིའི་དམག་སྒར་ཞིག་ཡོད་པ་དེ་མཚན་བསྟིབ་བཏང་འདུག་རྒྱ་སྒར་དེར་དམག་མི་ལྔ་བཅུ་ཙམ་ཞིག་དང་གཡག་དང་རྟ་མང་པོ་ཡོད་འདུག་པ་མཐའ་སྐོར་ནས་བརྒྱབ་པར་རྒྱ་དམག་ཁ་ཤས་བྲོས་ཐར་བ་ལས་དེ་མིན་ཚང་མ་གསོད་ཐུབ་པ་བྱུང་འདུག་ཚུར་མེ་མདའ་མང་པོ་བརྒྱབ་འདུག་ཀྱང་མཚན་མོ་ཡིན་སྟབས་ང་ཚོའི་མི་གཅིག་ལ་སྨྲས་སྐྱོན་བྱུང་མི་འདུག་སྒར་དེ་ནས་གཡག་སུམ་ཅུ་སྐོར་ཞིག་དང་།",
    "ལུས་ཀྱི་གོས་རལ་ནས་གཅན་གཟན་ཇི་བཞིན་ཤ་ཁྲག་བཟའ་རྒྱུ་ལས་གཞན་གང་ཡང་མེད་པ་རེད།",
    "དགོ་ལ་བརྒྱབ་སྟེ་ལྷ་སའི་རྭ་མོ་ཆེའི་འབྲས་བུ་གླིང་ཁར་འཛོམས་རྒྱུའི་དུས་མ་བརྒྱབ།",
    "ཞྭ་མོ་འཕྱིང་ཞྭ་དཀར་པོ་ཞིག་གྱོན།",
    "ར་མོ་ཆེར་དེ་སྔའི་གནས་ཚང་རྙིང་པ་ཞིག་ཡོད་པ་དེར་བསྡད།",
    "ཚོགས་ཆུང་གིས་ཚོང་རྒྱག་པ་དང་།",
    "འཁོ་ཆས་ཉོ་སྒྲུབ་བྱེད་པར་བཏང་བྱུང་བརྗོད་པར་ཡིད་ཆེས་ནས་འགྲུལ་ཐོ་བརྒྱབ་སོང་།",
    "ཁོ་པས་ང་རྭ་སྒྲེང་ཁོངས་ཡིན་པ་ལས་ཟིང་འཁྲུག་ནང་ཕྱིན་པ་ཤེས་རྟོགས་བྱུང་ཡོད་མ་རེད།",
    "མཚན་མོ་བལ་པོའི་ཚོང་པ་ཡོད་སར་ཕྱིན་ནས་གླ་རྩི་ཚང་མ་བཙོངས་པ་ཡིན།",
    "ཞོ་པད་རྟ་སྒྲོ་ཁ་ཤས་འདུག་སྐད་གྲགས་ཅན་གྱི་ཇ་མོ་ཅན་སེང་གེ་ཉི་མ་ཞེས་པ་སེང་གེ་ཁ་ཕྱིར་བལྟས་པའི་རྟགས་ཐེལ་ཡོད་པ་སྒམ་དྲུག་སྒམ་གཅིག་ལ་དོ་པོ་གཅིག་གི་ཚད་ཡོད་མོ་ཇ་གསེར་ཐེལ་ཅན་ཞེས་གསེར་གྱི་རྟགས་ཡོད་པ་སྒམ་དྲུག་ཐ་མག་ཀྲིང་ལེན་པར་དོ་པོ་གཉིས།",
    "འགོ་བྱེད་ལི་ཐང་ཕུན་ཚོགས་ལ་རྡོ་ཚད་༢༥ སྤྲད་པའི་འཇུར་རྟ་ཡུ་རིང་དབྱིང་ཟོན་ཞིག་དར་ལྕོག་རྒྱལ་མཚན་རྩེ་མོ་དོ་པོ་གཉིས།",
    "བཟའ་ཆས་སོགས་དགོས་འཁོ་ཁྱོན་བསྡོམས་གཡག་རྒྱབ་༡༣ ཉོས།",
    "པཱ་ལགས་ཀྱང་འཇུས་ཚར་བཞག་བསམ་ནས་ཁོག་པ་ནག་པོར་གྱུར་སོང་།",
    "ལག་ལྕགས་མདུན་དུ་བརྒྱབ་ནས་རྒྱ་དམག་དེ་གཉིས་ཀྱི་སྲུང་བྱའི་འོག་སྤྱི་ཁང་དུ་འཁྲིད་ཡོང་གི་འདུག་རྒྱ་དམག་གཉིས་ལ་པཱ་ལགས་ཐུག་རྒྱུའི་རེ་བ་ཞུས་ཀྱང་ཐུག་མ་བཅུག་པ་མ་ཟད།",
    "མིག་ཀྱང་བལྟ་མི་བཅུག་པར་མེ་མདའི་ཁ་གྲི་ཐེངས་གསུམ་འཛུགས་པར་ཡོང་ནས་ཕྱིར་འབུད་བཏང་བར་པ་ལགས་ནས་ཀྱང་མགོ་བོ་གཡུགས་ནས་མ་ཡོང་ཟེར་བའི་བརྡ་གཏོང་གི་འདུག་པས་མིག་ཆུ་གཏོང་བཞིན་ཁོང་ཁྲོ་སྡུག་སྒོམ་རྒྱབ་ནས་སྡོད་རྒྱུ་རེད།",
    "བློ་རྟ་ནོར་བུ་བྲའུ་ཞེས་པ་རྐྱང་ནག་ཁ་དཀར་ཞིག་ཡོད་པ་དེའི་ཐོག་བསྡམ་ནས་འཕན་པོར་ཁ་ཕྱོགས་ཏེ་འཁྲིད་ཕྱིན་སོང་།",
    "དགོང་མོ་ས་རུབ་མཚམས་གཡག་གཉིས་ལ་སྒ་བརྒྱབ།",
    "གཡག་གཅིག་གི་སྒང་དུ་བཞོན་ནས་རྭ་སྒྲེང་གཙང་པོར་སྟེམ་ཉལ་བརྒྱབ་པ་སྟེ་གཙང་པོ་ཚུར་ཁར་འབྱོར་བ་དང་གཡག་གཉིས་དེ་གར་བཏགས་ནས་མཚན་མོ་སྐྱེས་ཁང་དུ་ཡོང་།",
    "མར་ལྟང་གཅིག་བཅས་ས་དོང་ནང་སྦས་ནས་ཁྱོད་ཚོ་ལྟོ་གོས་དཀོན་པ་དང་སྡུག་པའི་སྐབས་སུ་བཙོང་ནས་བཟོ་ཞེས་བསྔགས།",
    "ནམ་གསལ་སྐབས་ང་མག་པར་འགྲོ་སའི་ས་སྣེ་ཟིན་སོང་།",
    "རེ་རུ་ནས་ཡིན་པ་ཀ་རྡོ་ར་དང་།",
    "གཉལ་ཞང་པོ་གཉིས་གཡག་རྒྱབ་ཁ་ཤས་སི་རི་རོང་གི་འོག་ཤོད་ནང་དུ་ལི་ཐང་ཕུན་ཚོགས་ཤོག་གི་འཇབ་དམག་ཡོད་སར་བསྐྱལ་བར་བཏང་བ་དང་ང་རང་ནང་དུ་ལོག་ནས་བཟའ་ཟླ་མཉམ་དུ་ཉིན་ཤས་བསྡད།",
    "མག་པར་འགྲོ་སའི་རེ་རུ་སྦ་ཆེན་ཚང་ཡང་སྔ་ཕྱི་མ་གཏོགས་གཞུང་བཞེས་གཏོང་རྒྱུ་ཡིན་སྟབས་ཉིན་ཤས་དེའི་ནང་ངས་ལྷ་ས་ནས་ཁྱེར་ཡོང་བའི་ཇ་དང་།",
    "དངུལ་སོགས་དང་ཅ་དངོས་གལ་ཆེ་ཁག་གཅིག་ལྕི་འབམ་ནང་སྦས་ནས་འཚོ་གོས་དཀའ་ངལ་བྱུང་སྐབས་ཕན་ཐོགས་ཡོང་རེ་བྱས།",
    "ཕོ་ཁྱོ་ག་རེད།",
    "དེ་ཡིན་པ་སྔོན་ལས་བསྐོས་ཐང་རེད།",
    "དེ་ཡིན་པ་སྔོན་ལས་བསྐོས་ཐང་རེད།",
    "ང་ཚོ་འབྲི་གུང་སི་རི་རོང་གི་འོག་ཤོད་ནང་དམག་སྒར་བཅས།",
    "རྫ་རིས་བསྐོར་བའི་ས་ཆ་བཙན་པོ་ཞིག་རེད།",
    "རིམ་བཞིན་འབྲི་གུང་མཐིལ་དུ་སླེབས་ཀྱི་རེད།",
    "ངོ་རྒོལ་གྱེན་ལངས་ཁ་ཐོར་བ་ཁ་ཤས་དང་ཟླ་བསྒྲིལ་ནས་སླར་ཡང་མི་རྟ་བརྒྱད་ཅུ་སྐོར་འཛོམས་སོང་།",
    "དེ་ནི་མཐའ་མའི་དམག་འཐབ་ཡིན་པས་ཁྱོད་ཤི་ང་གསོན་གྱིས་འཛིང་རྒྱུ་ལས་མེད།",
    "མི་ཚང་མ་བློ་ཐག་ཆོད་ཚར་ནས་དེ་རིང་ཤི་དགོས་ལེ་རེད་ཟེ་ཨམ་ཙིག་ཐམ་ཐམ་བྱེད།",
    "མེ་མདའི་སྐད་ཀྱིས་ཁེངས་སོང་།",
    "ང་ཚོར་མདེའུ་མང་པོ་མེད།",
    "རྒྱ་དམག་གིས་མེ་ཤིན་གྷན་རྒྱབ་བྱུང་།",
    "མདེའུ་ཁ་ཤས་ལས་ལྷག་མི་འདུག་ཤི་བསད་ཁྲག་གི་འཁོར་ལོ་བསྐོར་སོང་།",
    "ང་ལ་མདའ་ཐེབས་ཚར་སོང་ཟེར་ནས་ས་ལ་འགྱེལ་སོང་།",
    "བྱུ་རུ་གཉིས་ཀྱི་བར་དུ་གཟི་མིག་གསུམ་པ་ཞིག་ཡོད་པ་དེ་དག་ཀྱང་ཁྲ་ལྷམ་མེར་ས་ལ་འགྱེལ་སོང་།",
    "ཡཱ་ཁོ་རེ་བསྟན་པ་ང་མི་ལོ་ལེ་རེད་ཚར་སོང་བརྗོད་བྱུང་བས་སོག་གོང་དུ་མདེའུ་ཐེབས་ཚར་བཞག་ཁོ་པའི་མདེའུ་ཡང་རྫོགས་ཚར་འདུག་པས་ངར་ཤུགས་ཆེན་པོས་ཡར་ལངས་ཏེ་མེ་མདའ་འཛིང་རགས་ཀྱི་རྡོ་ལ་བརྡབ་ནས་དུམ་བུར་བཏང་སོང་།",
    "ཁྲག་ཀྱང་དམར་ཆིལ་ལེར་རྡོ་ལ་བཤོས་སོང་བ་མ་ཟད་ཁྲག་ང་ལ་ཡང་འཐོར་བྱུང་།",
    "མེ་མདའི་སོ་ཁོ་པའི་མགོ་བོ་ནས་མར་ཕབ་སྟེ་ལྟེ་བ་ཡོད་སར་སླེབས་སོང་བསམ་པ་ཞིག་ལ་གཅིག་བརྒྱབ་པས་ཁོ་ཐལ་འཚུབ་འཕྱུར་རེར་འགྱེལ་སོང་།",
    "རྒྱ་དམག་གིས་རྒྱབ་ཡོང་བའི་མདེའུ་ངའི་གཡས་གཡོན་དུ་བབས་ནས་ཐལ་འཚུབ་རྒྱག་གི་འདུག་མདེའུ་ཞིག་འཛིང་རགས་ཀྱི་རྡོ་ལ་ཐེབས་ནས་རྡོ་ཕྱེས་ངའི་ལག་གཡས་སྨྲས་ནས་ཁྲག་མང་པོ་དོན་བྱུང་།"
  ]
}