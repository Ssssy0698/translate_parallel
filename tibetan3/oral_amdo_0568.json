    "རྒྱལ་རབས་ལ་ལར་རྒྱལ་པོས་ཇོ་བོ་ཤཱ་ཀྱ་བཞུགས་པའི་ལྷ་ཁང་དུ་བྱོན་པས་ཞལསྔར་ཤར་དུ་གཟིགས་པ་ནུབ་འགྱུར་འདུག་པས་གཞིགམ་སཀོང་ཇོས་པདག་བོད་དུ་སྤྱནིན་ལེགས་མིད་ཇོ་བགདན་འདྲོངས་ན་བདག་གི་མཛུབ་མོའི་རྩེ་ལ་སྔོན་ཞིག་ཞེས་དམོད་བོར་མ་མཛུབ་མོ་གཡས་པའི་སྨྱོ་ལ་ཡར་གྱིས་བྱོན་པས་ཡིད་ཆེས་ཏྲེ་ཀོང་ཇོ་བོད་དུ་བྱོན་བྱ་བ་སོགས་སྣང་།",
    "དེ་ནས་ཀོང་ཇོ་དཔོན་གཡོག་གིས་ཁམས་སུ་ཕེབས་ནས་མགར་སྒུག་པའི་ཕྱིར་བྲག་ལོགས་ལ་རྒྱས་པའི་དབུ་དུམ་དང་བཟང་།",
    "རྒྱ་མོ་ཕྲེང་ལམ་བཅོས་ཤིང་སེ་བ་སོགས་བལྟར་འགྲོ་ཟེར་ནས་ཀོང་ཚོས་ཡུལ་ཐམས་ཅད་དུ་བྱོན་པས་བློན་པོ་མག་པ་ལ་ལས་ལམ་དུ་རྩ་འགར་བྱེད་པར་མཐོང་།",
    "ཆུན་མ་བཙུན་མོའ་གཡོག་མོ་ཡནི།",
    "བཙུན་མོ་ཁྱེད་ཀྱི་འགྲན་ཚིག་བསྡུས་པ་ཡནི།",
    "དེ་ལྟར་སྤྲུལ་པའི་ལྷ་མོ་གཉིས་ཕེབས་ཚེ།",
    "ཉོན་མོངས་མ་ལུས་སྐད་ཅིགེ་གྲིས་གཅོད་པའི།",
    "རྡོ་རྗེའི་ཏེང་འཛིན་བདེ་བ་ཐོབ་པར་གཟིགས།",
    "མི་ཉག་གི་རྒྱལཔོའབུམོ་རུ་ཡོང་བཟའ་རྒྱལ་མོ་བཙུན་དང་།",
    "བོད་ཡུལ་སྲིན་མོ་གན་རྐྱལ་འགྱེལ་བ་འདྲ།",
    "དེ་ཡི་ཚིགས་ཆེན་བརྒྱད་དང་ཐལ་བཞི་པོ།",
    "གནོན་པའི་ལྷ་ཁང་རེ་རེ་དང་པོར་ཐོབ།",
    "ཇོརྗེ་ཀུའབྱིམ་བྱུགས་པའི་ཤིང་གིས་ཕུལ།",
    "ཡན་ལག་ཐལོ་བཞུ་གནོན་པའི་རུ་གནོན་བཞི།",
    "དེ་ལྟར་རྒྱལ་བའི་རྗེས་འཇུག་དུར་མིག་གི།",
    "རྒྱལ་པོས་ཐོད་ཕུད་ཨ་མི་དྷ་བྷ་བསྟན།",
    "ཀོང་ཇོས་སྤོར་ཐང་བཀྲམ་ས་བརྩིས་པས་བོད་ཡུལ་འདིར་ལྷ་ཁང་གིས་ཞིག་བཙལ་ན་སྤྱིར་སའི་དབྱེ་བ་སུམ་བརྒྱ་དྲུག་བཅུ།",
    "ནོརར་རེ་བཞི་བཅུ་རྩ་ལྔ།",
    "རེ་ཞིག་བདེ་བར་གནས་པ་སྐྱེ་བ་ཐ་མ་༤ པའི་ས་སྟེ་བཞི་ལས་འདི་རྒྱལ་པོའི་ས་དང་གཅིག་པ་ཡིན།",
    "དེ་ཡང་བོད་ཀྱི་རྒྱལ་ཁམས་འདི་སྲིནམ་གན་རྐྱལ་དུ་འགྱེལ་བའི་གཟུགས་སུ་འདུག་པས་པུང་མགོ་གཉིས་དཔྱི་གཉིས་གྲུ་མོ་གཉིས་པུས་མོ་གཉིས་ལ་བཞི་རྣམས་གནོན་པའི་ལྷ་ཁང་རེ་རེ་དགོས།",
    "མལ་གྲོང་གི་རྒྱབ་རིར་སྤྱན་ཉ།",
    "གར་པའི་ཇོ་མོཟེ་ཟེ་ལ་ལྕགས།",
    "རྩ་ཞལ་ནས་འོད་ཟེར་བྱུང་བ་མཚོ་སྟོད་དུ་སྨིན་ལྟར་འཁྲིགས་པ་ལས་འོད་ཞགས་པ་ལྟ་བུ་མཚོ་ལ་ཆར་པ་ལྟར་དཀ་བབ་པས་མཚོནང་དུ་འོད་མ་ལྔ་བ་མཚོད་རྟེན་བང་མེ་གསུམ་པའི་རྣམ་པར་ཆགས་པའི་རྡོ་རྣམས་མཚོ་དཀྱིལ་གྱི་འོད་ཟེར་ལ་རྒྱུག་གི་གསུང་སྟེ་བལ་པོའི་རྫོགཟོ་བས་གསང་ཕུ་ནས་རྡོ་དྲས་པ་ལགཟོ་བྱས་ཏེ་བློན་པོ་རྣམས་ཀྱིས་ཡིག་དྲུག་གི་སྒྲ་དང་བཅས་ཏེ་དབུས་བསྒྱུར་བས་མཁར་གྱི་རྣམ་པ་གྲུ་བཞི་པ་ཅིག་བྱུང་།",
    "སྐུའི་དབྱིབས་གཏོད་པའི་ཕྱིར་རྒྱ་མཚོའི་གླང་གི་འཇག་མ།",
    "འདི་ལ་རྒྱས་པའི་ཞལ་ཐང་ཤམ་པསོ་གོང་དུ་བརྗེས་ཏེ་ཞབས་གཡས་ནས་འོད་ཟེར་བྱུང་བས་རྟེན་དེ་རྣམས་སྤྱན་དྲངས་ཏེ་ཐུགས་ཀར་ཆགས་པས་ཤུན་ཏུ་སྤྲམ་པར་གྱུར་ལགཡོན་དུ་ཅུང་ཟད་འགྱིང་བ་དེ་དུས་བྱུད་ལ་དརཤམ་པུས་གོང་དུ་ལུས་པ་དུང་དུ་ཡོད་ཏོ་ག་ག་མ་དགང་གི་ཞལ་ཁམ་པ་གཉིས་མངོན་སྤྱོད་ཀྱི་ཞལ་དམར་པོ་གཉིས།",
    "རང་བྱུང་ཐུགས་རྗེ་ཆེན་པོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་བ་བྲག་ལོགས་ལ་ཕོག་པས་བྲག་ལྷ་ཀླདུགགི་ཀླུ་བདུད་དང་མ་མོས་ས་ཕྱོགཏརྣམ་སྣང་ཀུན་དུ་ཞལ་དང་འཇམ་དཔལ་ཁྲོ་བོ་སོགས་བྲག་ལ་རང་བྱོན་དུ་བྱུང་།",
    "ངེས་ཡང་བལ་བཟས་ལྷ་ཁང་བརྒྱ་རྩ་བརྒྱད་ཀྱི་རྨང་བཏིང་བ་བཤག་པ་དེ་ཡང་ལེགསསོ་༡ཟེར་ནས་གྱེས་སོང་།",
    "ཚངས་པ་དུང་གི་ཐོར་ཚུགས་ཅན་ལ་གཉེར་དུ་གཏང་།",
    "ངས་བདག་གི་རྒྱལ་པོ་ཁྱེད་དགེ་སྡོང་ག་ཞབས་ལ་མགོས་གཏུགས་ནས་ཕྱག་བྱས་པ་འདི་ངོ་མཚར་མི་ཆེའམ་གསུས་པས་དགེ་སྦྱོང་དེ་ན་རེ།",
    "རྒྱལ་པོས་དེ་ཡར་ངོ་མཚར་ཆེ་སྟེ་ང་སྐྱེ་བོ་ཐ་མལ་པའིམགོ་ལ་སས་རྒྱས་བཞུགས་པ་འདི་ངོ་མཚར་མི་ཆེའམ་ཞེས་ལ་ཐོད་ཕུར་སྟེ་ཨ་མི་ཏ་བྷའི་ཞལ་བསྟན་པས་དེ་ན་རེ་རྒྱལ་པོ་ལ་ལྷ་གཅིག་ལས་མི་འདུག་ན།",
    "དཔྱི་གཡས་གཡོན་གནོན་པ་ལ་རྩེ་ཕུག་དང་བརྒྱད་གུག་དུ་སྒྲུབ་པ་བྱས་ཏེ་གཡས་རུར་གཙང་འགྲམ་དང་ཡན་ལག་དུ་དགེ་དྲུང་གི་ལྷ་ཁང་།",
    "གཡོན་པ་ལ་ལྷོ་འབྲུག་གི་ཟེ་སྟེང་དུལོ་བྲག་ཁོ་ཐེང་།",
    "གསུང་གི་རྟེན་ཡག་དྲུག་འབུམ།",
    "ན་མཁའ་ནས་བཀྲོཞེས་ཀྱི་སྒྲ་སྒྲོག་རོལ་མོ་རྣམས་མ་དཀྲོལ་བར་སྒྲ་འབྱིན།",
    "རི་མོ་བྲི་བར་བཀའ་ཡིས་བསྐོས་པའི།",
    "རྒྱ་སྟག་ར་མོ་ཆེ་ཡ་ལྟཁང་བཞེངས།",
    "གཞན་ཡང་བཙུན་མོ་གསུམ་གྱིས་རང་རང་གི་ཐུགས་དམ་ལྟ་ཁྱེད་རེ་རེ་སོ་སོར་བརྩིགས།",
    "ཤར་ལྷོའི་གཡུང་དྲུང་ཁུགས་སུ་ལྕོག་སྟེང་ཁང་གྲུ་སྐས་དང་བཅས་པ་བྱས་ཏེ་དཔལ་ལྡན་ལྷ་མོའི་རྟེན་བཙུགས།",
    "ལྷོ་ཕྱོགས་ལ་རང་བྱུང་གི་རི་མོའི་གླིང་གཉིས་ཀྱི་ཁར་འཇམ་དབྱངས་དང་བདེ་བ་ཅན་གྱི་ཞིང་བཀོད།",
    "ཕྱིས་སོ་ཕག་གིས་ལེགས་བར་བརྩིགས་ཏེ་རྒྱ་བུབས་སྟག་ལྟར་བཀྲ་བས་རྒྱ་སྟག་ར་མོ་ཆེའི་ལྷ་ཁང་དུ།",
    "མོང་བཟའ་ཁྲི་ལྕམ་གྱིས་ཡར་པའི་གཙུག་ལག་ཁང་བཞེངས།",
    "ཀོང་ཇོས་ཀྱང་ར་མོ་ཆེར་སྤྱན་དྲངས་ཏེ་རབ་དུ་དགྱེས་པ་ཐོབ་",
