    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པར་ཐིམ།",
    "འདུག་ས་འདི་ཉིད་དུ་བྱིན་གྱིས་རློབས་ཤིག།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བརྗོད་པས་དེ་ཐམས་ཅད་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཞེས་པའང་རང་གཞན་ལ་ཉེ་བར་མཁོ་བའི་སླད།",
    "དེའི་འོད་ཀྱི་འཕྲོ་འདུ་ལས་ཁྱེད་རང་རྣམས་འཕགས་པ་བྱམས་པ་སོགས་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "རང་བྱུང་རང་ཤར་སྤྲོས་བྲལ་བསལ་བཞག་མེད་པ་ཆུ་རླབས་རྒྱ་མཚོར་ཐིམ་པ་ལྟར་རྟོགས་པ་ལ་བསླབ་པོ།",
    "ལུས་ཀྱི་འདུག་སྟངས་གསུམ་ནི།",
    "གསུམ་པ་ནི་སྒོ་ཡུལ་འདུག་སྟངས་སོགས་ཀྱི་རྐྱེན་དང་།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱཧཱ།",
    "རང་རང་གདན་ལ་བཞུགས་སུ་གསོལ།",
