    "འབྲས་བུ་དེ་དེ་རང་རང་རྒྱུ་དེ་ལས།",
    "ཕན་ཚུན་སྤང་འགལ་བསྟན་པ་ཁྱེད་རང་ཡང་འདོད་དགོས་པས་རྣམ་རིགས་ཀྱི་གཞུང་དེ་གཉིས་འགལ་བ་ལ་ལྷན་ཅིག་མི་གནས་འགལ་དང་།",
    "བརྗོད་བྱ་རྗོད་བྱེད་ལྟར་འདིར་ཡང་འཆད་དུས་ཀྱི་མཚན་མཚོན་དང་འཇུག་དུས་ཀྱི་མཚན་མཚོན་གཉིས་སུ་ཕྱེ་ནས།",
    "དང་པོ་དངོས་པོ་དང་དངོས་མེད་གཉིས་ལ་རྣམ་གཞག་བྱས་ཏེ་ཐད་སོར་མཚན་ཉིད་པ་དང་འཇུག་དུས་ཀྱི་མཚན་མཚོན་ནི།",
    "རང་རང་བློས་བཏགས་གྲུབ་པའི་མཐའ་མང་ཡང་།",
    "༡༥༣དང་འཇུག་དུས་རྣམ་དབྱེ་གཅེས།",
    "དེ་ལ་རང་མྱོང་རང་རིག་མངོན་སུམ་ངོ་བོ་གཅིག་ཏུ་ལྡན་པའི་ཕྱིར།",
    "རློམ་ཚོད་ནི་སྒྲ་དོན་དང་རང་མཚན་གཅིག་ཏུ་རློམ་ཞིང་འཁྲུལ་པ་སོགས་ཡིན་པས།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "འདིར་ཡང་རང་ལུགས་སུ་བཀོད་པ་ཡིན་ཞིང་།",
    "དེའི་དོན་ཡང་རང་མཚན་གཞིར་བཟུང་བའི་ཚེ།",
    "དེ་ཡང་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་སོགས་རང་རིག་དེ་དང་དེའི་ཉེར་ལེན་གྱི་རྒྱུར་གྱུར་པའི་ཤེས་པ་སྔ་མ་དེ།",
    "རྟོག་མྱོང་རང་རིག་མངོན་སུམ་དེ་དང་དེའི་མཚུངས་པ་དེ་རིག་གཏེར།",
    "དབྱེ་བ་ཡུལ་གཞན་མཐོང་དང་རང་མཐོང་དང་།",
    "གསུངས་པ་མཁས་རྣམས་རང་རང་འོལ་སྤྱི་ཡིས།",
    "རང་རིག་ཏུ་རྫས་གཅིག་པས་ཞེས་པ་དེ་ཅི་དོན་རིག་གཉིས་པོ་དེ་རང་མྱོང་རང་རིག་མངོན་སུམ་དང་རྫས་གཅིག་པ་མ་གཏོགས།",
    "རང་རིག་པའི་ཡེ་ཤེས་དང་རང་རིག་པའི་མངོན་སུམ་ཡིན་ན།",
    "དེའི་མཚུངས་པ་དེ་མ་ཐག་རྐྱེན་གྱི་ལག་རྗེས་དེ་མ་ཡིན་པ་ལ་ཤེས་བྱེད་མི་འདུག་པའི་ཕྱིར།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཤེས་པ་རང་རང་ངོ་བོ་མྱོང་བྱེད་ལ།",
    "ཤེས་པ་ཐམས་ཅད་རང་རང་ངོ་བོ་ལ།",
    "འོ་ན་གཞལ་བྱ་ཀུན་ཀྱང་རང་མཚན་དུ།",
    "ཤེས་ཀུན་རང་རང་སྣང་ཡུལ་མ་ཡིན་ན།",
    "ཁྱེད་རང་གཞུང་དེས་སྒྲུབ་བྱེད་ཀྱི་རྟགས་མཚན་ཉིད་པ་བསྟན་གསུངས་པ་འོལ་སྤྱོད་དེ།",
    "ཐེག་གསུམ་རང་རང་འབྲས་བུ་ཐོབ་པ་ནི།",
    "སྒྲུབ་བྱེད་རྣམ་གཉིས་འབྲས་དང་རང་བཞིན་ཡིན།",
    "དེ་ལས་གཞན་པའི་འཛིན་ཚུལ་མི་འདུག་པའི་ཕྱིར་ཏེ།",
    "ཡང་རང་འགྲེལ་ལས།",
    "སྣང་བ་དེ་གཉིས་ལས་གང་རང་རིག་པ་ནི་འབྲས་བུའོ།",
    "ཤེས་པ་གང་རང་རིག་པ་ལ་འདིའི་འབྲས་བུར་འཇོག་པ་ཡིན་ཞེ་ན།",
    "སྣང་བ་དེ་གཉིས་ལས་གང་རང་རིག་པ་ནི་འབྲས་བུའོ།",
    "ཕྱི་དོན་གཞལ་བྱ་ལ་ཡང་རང་རིག་འབྲས་བུར་འཇོག་པའི་ཚད་འབྲས་ཀྱི་རྣམ་གཞག་རིགས་པ་ཡིན་ནོ།",
    "ཕྱི་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་སྒྲུབ།",
    "རང་རང་བློ་ཡིས་འགྲེལ་ཚུལ་མང་བྱུང་ཀྱང་།",
    "གསུངས་ཀྱང་རང་རང་རྨོངས་པས་སྒྲིབ་པ་བཞིན།",
    "ཕྱི་རོལ་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་འཐད།",
    "པོད་གསུམ་གའི་མ་ཕྱི་བྲིས་རྙིང་ཞིག་ལས་ལག་ཏུ་མ་སོན་ཅིང་དེ་ཡང་ལྷག་ཆད་ནོར་འཁྲུལ་གྱི་གོལ་སྐྱོན་མང་བའི་དོགས་གཞིར་འདུག་ནའང་།",
    "ཁྱད་པར་དུ་ས་མིང་དང་མི་མིང་སོགས་བརྡར་ཤ་གཅོད་མ་ཐུབ་པ་རྣམས་འོལ་ཚོད་ཀྱིས་བཅའ་བར་མ་སྤོབས་པར་གཞུང་རང་དང་བསྟུན་ཏེ་སོར་གཞག་བྱས་ཡོད་པ་དགོངས་འཇགས་འཚལ།",
    "འདི་ནི་རྒྱུད་དང་མཐུན་པར་གདའ།",
    "ཡི་གེ་ཙ་ནི་དབྱུག་པ་གཙོ།",
    "མཚན་མཁན་ལ་བསྟན་པས་སྐྱེས་བུ་མཚན་དང་ལྡན་པ་ཅིག་ཡིན་ཐག་ཆོད་དུ་འདུག་འོན་ཀྱང་ཕྱི་པ་བྱས་ན་ལེགས་ཟེར།",
    "དེ་ནས་རྡོ་རྗེ་གདན་ལ་བསྐོར་བ་བྱེད་ཀྱིན་ཡོད་ཙ་ན།",
    "བསྐོར་བ་བྱེད་ཅིང་གསོལ་བ་འདེབས་ཀྱིན་འདུག་པས་ངོ་མཚར་སྐྱེས་ཏེ།",
    "ངས་ངོ་མ་ཤེས་པའི་སྐྱོན་ཆེན་པོ་བྱུང་འདུག་ད་བཤགས་པ་བྱ་དགོས་དགོངས་ནས།",
    "དེར་པཎྜི་ཏའི་ཐུགས་ལ་ཞག་བདུན་ལ་བློ་ལ་ཆེར་མི་ཟིན་དགོངས་ཙ་ན།",
    "བློ་ལ་ནི་གཅིག་ཀྱང་མ་ཟིན་ཅི་དྲག་དགོངས་ཙ་ན།",
    "གཞན་ཡང་དུར་ཁྲོད་དེ་ན་སྤྱིར་སྒྲུབ་པ་པོ་མང་པོ་ཡོད་ཀྱང་ཁོང་འདུག་ས་ངའི་ཉེ་གནས་ཀྱིས་ཤེས་གསུངས།",
    "བྷི་ཏི་པ་ཏིའི་ཕྱག་མཚན་ཅིག་འདུག་པ་དེའི་སྒྲུབ་ཐབས་དང་བཅས་པ་གནང་ནས།",
    "རྒྱ་སིངྒ་ལའི་རྒྱལ་པོ་དེ་ལ་ཕྱི་རོལ་པའི་མཆོད་གནས་མང་པོ་ཡོད་འདུག་པས།",
    "བྷ་རོ་ཧབ་འཐུང་གྲུབ་པ་ཐོབ་ནས་གདའ།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་ང་ལས་ཁོང་ནུས་པ་ཆེ་བ་འདུག་གསུངས།",
    "སློབ་དཔོན་གྱི་ཐུགས་ལ་འདིས་ཐེ་ཚོམ་ཆོད་པ་འདུག་དགོངས་ཏེ་ཕྱག་བཙལ་ནས་གསོལ་བ་བཏབ་པ་དང་།",
    "ཁོ་བོས་མ་ཤེས་པ་བྱུང་འདུག་པས།",
    "ད་ནི་མུ་སྟེགས་ཀྱི་མཐུས་ཁོ་རང་ཡང་ཤི་ལོ་ཟེར་བའི་གཏམ་བྱུང་བ་ཐོས་ནས།",
    "ད་ནི་གསེར་འདི་རྣམས་ཁྱེར་ལ་རྒྱ་གར་ནས་པཎྜི་ཏ་སྤྱན་འདྲེན་པ་ལ་འགྲོ་བར་བྱ་དགོངས་ཙ་ན།",
    "ང་རང་དམ་བཅའ་བརྟན་པོར་བགྱིད།",
    "སྔར་ནས་ཀྱི་ལས་འཕྲོ་ཡང་འདི་དང་ཡོད་པར་ངེས་པས་འདི་གར་གཤེགས་གར་བཞུགས་སུ་འགྲོ་འདུག་བྱ་དགོས་དགོངས་ནས།",
    "ཁྱེད་ས་སྐྱ་པ་ལ་ལས་གཤིན་འདི་བཀའ་བབས་ཤིང་འཕྲིན་ལས་སྒྲུབ་པ་འདུག་གསུངས་པ་དང་།",
    "མདང་ནུབ་ཁོ་བོ་ལ་རྨི་ལམ་འདི་བཞིན་བྱུང་བས་ཁྱེད་ལ་རྡོ་རྗེ་འཇིགས་བྱེད་འདི་བཀའ་བབས་འདུག་ཅེས་ཐུགས་ཤིན་ཏུ་དགེས་པ་ཆེན་པོ་དང་བཅས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་ཀྱང་མིག་སྔར་དཔེ་རིས་ཡིག་ཡུག་ཤད་ཤུག་བྱེད་ཀྱིན་འདུག་ཡི་གེ་ལ་ནི་མ་བརྟེན་པར།",
    "དེ་ན་རྟ་གཅིག་འདུག་པ་ལ་ཞོན་ནམ་མཁའ་ལ་འཕགས་ནས་རྟ་དེ་སེང་གེའི་རྣམ་པར་གྱུར།",
    "ཕྱིན་པས་ཆོག་ཟེར་བར་འདུག་ཟེར།",
    "ངེད་གཉིས་སྒྲ་མཉམ་པོར་སློབ་ཏུ་འོངས་པ་ལས་ཁོ་ནི་ཤིན་ཏུ་མཁས་པར་འདུག་ངས་ནི་ཅི་ཡང་མི་ཤེས་པས་ཡུལ་དུ་འགྲོགས་ནས་འགྲོ་ན་ངོ་ཚ་སྙམ་ནས།",
    "ཡུལ་འདི་སྐད་བྱ་བ་ན་པཎྜི་ཏ་འདི་སྐད་བྱ་བ་ཡོད་དེས་ཤེས་ཟེར་ཞིང་འདུག་པ་ཐོས་སོ།",
    "དུར་ཁྲོད་ན་སྲིན་ཕྲུག་མི་ཟན་གཅིག་འདུག་ཟེར།",
    "དུས་དེ་ཙ་ན་རི་རབ་ཀྱི་ཟོམ།",
    "ཞེ་སྡང་རང་དགར་སྤྱད།",
    "སྲིན་པོ་ཁོ་རང་ལྷའི་ཆ་བྱད་གཟུགས་བཟང་ལ་མཛེས་པ་གཅིག་ཏུ་སྤྲུལ།",
    "སྲིན་ཡུལ་ལང་ཀ་པུ་རི་ན་འདུག་ཅེས་སྨྲས་པས།",
    "ལུས་གཅེར་བུར་བྱས་ནས་འདུག་གོ།",
    "རལ་པ་རིང་ཟ་པད་དུ་འདུག་པ་གཅིག་ཏུ་གྱུར་ཏེ།",
    "ལག་པ་གཡོན་དུ་བཟུང་ནས་ཕྱིན་ཙ་ན།",
    "ཡང་ན་མགོ་བོའི་སྟེང་འདུག་ནས།",
    "རབ་ཏུ་འཁྲུགས་པའི་ངམས་ནག་དུས་མཐའི་སྤྲིན།",
    "གཞན་རྣམས་ཀླུས་བདག་ལ་བསྟོད་ཀྱིན་འདུག་པས་ཁྱེར་མ་ཡོང་།",
    "ལག་པ་ལྕགས་ཀྱིས་བཀྱིགས་ཀྱང་རང་གྲོལ་བྱས་ནས་ཕྱག་བྱེད་པར་འགྱུར་གྱིས།",
    "དམ་ཉམས་འདིའི་པགས་པ་བཤུས་ལ་ངའི་འདྲ་འབག་ཅིག་བཞེངས་ཤིག་ང་རང་དངོས་དང་ཁྱད་པར་མེད་པ་ཞིག་འབྱུང་ངོ།",
    "ཇི་ཞིག་ཙ་ན་མི་རོ་ཆེན་པོ་གཅིག་ལ་སྟག་གཉིས་བབས་ནས་ངར་གྱིན་ཟ་ཡིན་འདུག་པས།",
    "ཁྱེད་རང་རྡོ་རྗེ་གདན་གྱི་བྱང་སྒོའི་མགོན་ཁང་དུ་ཚོགས་ཀྱི་འཁོར་ལོ་ཤོམས་ལ།",
    "ལོ་ཙཱ་ཡང་མཁས་པར་གྲགས་ཤིང་འདུག་པས་ཁོ་བོའི་ལོ་ཙཱ་བྱེད་དགོས་གསུངས་པ་ལ།",
    "གྲུབ་ཐོབ་རིན་ཆེན་དངོས་གྲུབ་ཅེས་བྱ་བར་འདུག་དེ་དུས་ཁོ་བོ་བྱིན་གྱིས་རློབས་པ་ལ་ཕེབས་པར་འདུག་སྟེ་ཞལ་མ་ཚོར་བས་འགྱོད་པ་དྲག་པོ་སྐྱེས་གསུང་ངོ།",
    "སྔར་གྱི་ཤུལ་ན་ཇག་པ་རྣམས་མཚོན་ཐོགས་ནས་སླེབས་འདུག་ཀྱང་།",
    "དེ་ནས་ཟླ་བ་གཅིག་དང་ཞག་གསུམ་ན་ཀེ་རི་བྱ་བའི་ཡུལ་དུ་སླེབས་ཙ་ན།",
    "ཤི་སྐྱིད་ཀྱི་ཇག་པ་གསུམ་རྒྱུ་འགྲུལ་བྱེད་པ་ཐུག་ཡོད་འདུག་པས།",
    "དེ་ནས་ཐུགས་དགོངས་ལ་བདག་ལ་མཁའ་འགྲོ་མས་ལུང་བསྟན་པར་འདུག་པས།",
    "ཡབ་ཡུམ་གྱི་ཐུགས་དཀྲུགས་ན་རང་ལ་བག་ཆགས་ངན་པ་འཇོག་པ་འདུག་པས་ཇི་ལྟར་བྱ་སྙམ་ཐུགས་མ་བདེ་བའི་ངང་དུ་བཞུགས་པ་དང་།",
    "འདི་ལས་འཕྲོ་ཅན་ཅིག་འདུག་གསུངས་ནས།",
    "བྲམ་ཟེ་མཆོག་སྲེད་ཀྱི་བརྒྱུད་འཛིན་རྒྱ་གར་གྱི་པཎྜི་ཏ་ཆེན་པོ་ལ་ལི་ཏ་བཛྲ་ཞེས་བྱ་བ་གྲུབ་པ་ཐོབ་པའི་རྣལ་འབྱོར་པ་ཆེན་པོ་གཅིག་དུས་རྒྱུན་དུ་དུར་ཁྲོད་ཆེན་པོ་ཞིག་ཏུ་ཏིང་ངེ་འཛིན་བསྒོམ་ཞིང་བཞུགས་པས།",
    "མཁས་པ་བེ་རོ་ཙ་ན་སོགས་ཀྱིས་འཕགས་ཡུལ་དུ་དར་བར་མཛད་ཅིང་།",
    "བྱིས་པ་སྦོས་ནས་འཆི་བར་གདའ་བ།",
    "ལྟ་མཁན་གྱིས་ཟད་དུ་ཆ་ཡིན་འདུག་ཞུས་པས།",
    "ནམ་ཞིག་དུས་ལ་བབས་པ་ན།",
    "ད་ལྟའི་འདུག་ས་འདི་ཀས་རྡོ་རྗེ་གདན་གྱི་བྱང་སྒོ་ཡང་ནོན་ཞིང་བསྟན་དགྲ་གདུག་པ་ཅན་རྣམས་སྒྲོལ་བ་དང་།",
    "དེ་མིན་པར་གདའ་ཇོ་སྲས་ས་སྐྱ་པའི་གསེར་འབུལ་དུ་བཏང་བར་གདའ་ཞུས་པས།",
    "ལན་གཅིག་བླ་ཆེན་འདི་མེད་པར་མལ་ལོ་དཔོན་སློབ་ཚོས་རྟོགས་བདུན་གྱི་སྔགས་གཅིག་འཐུ་ཡིན་འདུག་པ་དང་།",
    "དེ་ཁྱེར་ཏེ་འདི་ན་གདའ་ཞུས་པས།",
    "དགུང་ལོ་བཅུ་གཉིས་པའི་དུས་ས་སྐྱའི་འཇམ་དཔལ་བྲག་ཁུང་དུ་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་བསྒྲུབས་པས།",
    "དེ་ནས་བོད་དུ་འབྱོན་ཁར་བས་མཐའ་ཞིག་ཏུ་སྐྱོ་བསངས་ལ་བྱོན་པས་ཡི་དྭགས་མང་པོ་ངུ་ཡིན་འདུག་པས་ཁྱེད་རྣམས་ཅི་ལ་ངུ་གསུངས་པས།",
    "ཁྱེད་བཞུགས་ན་ངེད་རྣམས་ལ་གཏོར་མ་མང་པོ་སྦྱིན་པས་མི་བཀྲེས་པར་འདུག་པ་ལ།",
    "རང་དང་རང་ལ་ཡིད་གཏད་གདུལ་བྱ་ཡི།",
    "དེ་ནས་ཁོང་རང་གཅིག་པུས་ཞག་བཅུ་ཕྲག་གསུམ་གྱི་བར་དུ་སྔགས་བོན་གཉིས་ཀྱི་ཞབས་ཏོག་ལ་ཆེས་ཆེར་བརྩོན་པ་ལྟར་བྱས་ནས།",
    "གདན་མང་པོ་ཡང་ཚར་འདུག་པ་དང་།",
    "སྤྲུལ་པ་ཡིན་ངེས་སུ་འདུག་པས།",
    "དེ་ཙ་ན་སོས་ཀ་ཡིན་པས།",
    "སྒྲུབ་ཐབས་བི་རོ་ཙ་ནས་མཛད་པ།",
    "ཁྲོམ་གྱི་དབུས་སུ་འཆམ་གྱིན་འདུག་པ།",
    "དེའི་ལྷ་འཕགས་པ་འཇམ་དཔལ་ཡིན་པས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་འདི་སྒྲུབས་གསུངས་ནས་རྗེས་གནང་མཛད།",
    "ཁྱེད་ཀྱི་བརྒྱུད་པ་འདི་ལ་འཇམ་དབྱངས་བདུན་བརྒྱུད་གཅིག་འབྱོན་པར་འདུག་གསུངས།",
    "འདིར་འཇམ་དབྱངས་ཀྱི་སྤྲུལ་པ་བདུན་འབྱོན་པར་འདུག་གསུངས་པ་དང་མཐུན།",
    "སྤྱན་མ་བཙུམ་པར་མནལ་དུ་ཡོང་འདུག་པ་བསྟན་ནས།",
    "ང་རང་ས་ཆ་གཞན་དུ་སྤྱད་པས་ཆོག་དམག་དུམ་གཅིག་བསླངས།",
    "ང་རང་གཞན་དུ་འགྲོ་ཟེར་བ་ལ།",
    "ག་དུ་རིན་ཆེན་ལ་ཉེས་པ་མེད་པས་ཁོ་རང་ཐོངས།",
    "མི་འཚམས་པ་སྣ་ཚོགས་བྱེད་མཁན་དེ་ཚོ་ཡིན་པ་འདུག་ཟེར།",
    "དེ་ལྟར་ན་འདིས་ཉེར་བརྒྱད་པ་ནས་ཞེས་ལྔའི་བར་འཕགས་པ་ཏི་ཤྲཱིའི་དབོན་པོ་ཡིན་ངེས་སུ་འདུག་པས།",
    "ད་ཁྱེད་རང་ལས་འོས་མི་འདུག་གསུངས་ནས།",
    "ས་ཆེན་ཟེར་བའི་བགྲེས་པོ་དེས་གཏེར་དུ་སྦས་པ་ཡིན་པར་འདུག་ཅེས་གསུངས་པ་སྔོན་གྱི་སྐྱེ་བ་དྲན་པའི་གསུང་ལས་གཞན་དུ་མ་འདས་པ་དང་།",
    "གང་ཡོད་ངེས་དོན་ལ་བློ་ཁ་ཕྱོགས་པ་ཞིག་ཡོང་བར་འདུག་ཅེས་རྗེ་བཙུན་རྡོ་རིང་པ་ཆེན་པོ་ལ་དངོས་སུ་གསུང་བར་སྣང་ངོ།",
    "འཁོར་གྱི་ཚུལ་བཟུང་བའི་དམ་ཉམས་ཤིག་འདུག་པ་འདི་ངས་སྒྲོལ་བ་ཡིན།",
    "མི་འདི་ཁ་བརྡར་གྲགས་འདུག་པས་ན་རུ་འོང་བར་འདུག་གསུང་བའི་སྣང་བ་ཅིག་བྱུང་བས།"
  ]
}