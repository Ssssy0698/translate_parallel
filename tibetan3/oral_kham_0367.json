    "དེ་ནས་མདུན་དུ་འདུག་ལ་དེ་ཁོ་ན་ཉིད་འདི་ལན་ཅིགབརྗོད་པར་བྱའོ།",
    "དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོས་པདྨ་དེ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ།",
    "ཕྱིའི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་སྣ་ཚོགས་པདྨ་ཤར་སྒོར་བལྟས་པ་བྲིས་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོར་པདྨ་དེར་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ།",
    "དེ་ནས་ཨོཾ་དྷཱི་༤བེ་རོ་ཙ་ན་ཧཱུཾ།",
    "དེའི་མདུན་དུ་འདུག་ལ་གསང་བའི་ལྕགས་ཀྱུ་མ་བཅིངས་ཏེ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་དེ་བཞིན་དུ་འདུག་ལ་བདག་ཉིད་ལ་སྤྲོ་བ་བསྐྱེད་པར་བྱའོ།",
    "ཤེ་ཥའི་མདུན་དུ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་ཤེ་ཥའི་ཕྱག་རྒྱ་ཆེན་པོས་འདུག་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེའི་སྤྱན་སྔར་འདུག་ལ་ཧཱུཾ་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་ཁོ་ན་ཉིད་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་མདུན་དུ་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "སླར་ཡང་བཅོམ་ལྡན་འདས་ཀྱི་མདུན་དུ་འདུག་སྟེ།",
    "ལངས་པའམ་ནི་འདུག་པའམ།",
    "ཨོཾ་བཛྲ་ལོ་ཙ་ན་ནི་མ་ཤ་རི་བི་བཛྲ་ཧོ།",
    "འཕྲོ་བ་རྣམ་པར་འབར་བའི་འོད་ཀྱི་རང་བཞིན་ནི་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱི་སྤྱན་སྔར་འདུག་པ་ལ།",
    "ཅེས་བྱ་བ་ནི་བསྐོར་བ་ལན་གསུམ་བྱས་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་མདུན་དུ་འདུག་སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱན་སྔར་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཉི་༦༡༣༢དེ་ནས་དཀྱིལ་འཁོར་ལན་གསུམ་བསྐོར་བ་བྱས་ལ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་མདུན་དུ་འདུག་སྟེ་དེ་ཁོ་ན་ཉིད་བརྗོད་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་ལྟེ་བར་གཡོན་བརྐྱང་བའི་གནས་པས་འདུག་ལ།",
    "༡༣༥༥བརྐྱང་བའི་གནས་པས་དེ་ཉིད་དུ་འདུག་སྟེ།",
    "དེ་ནས་གཡས་བརྐྱང་བ་དང་གཡོན་བརྐྱང་བ་དང་ས་གའི་འདུག་སྟངས་དང་།",
    "༡ ཟླུམ་པོའི་འདུག་སྟངས་དང་།",
    "དེ་ནས་ཕྱོགས་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་བསམ་ཞིང་སློབ་དཔོན་ནུབ་ཏུ་༤འདུག་ཅིང་ཤར་ཕྱོགས་སུ་བལྟས་ལ།",
    "ཡང་སློབ་དཔོན་ལྷོ་ཕྱོགས་སུ་འདུག་སྟེ།",
    "༡༣༦༥འདུག་སྟེ་བྱང་༧ ཕྱོགས་སུ་བལྟས་ལ་ཕྱིའི་དཀྱིལ་འཁོར་གྱི་ཤར་ངོས་ཀྱི་ཐིག་གདབ་བོ།",
    "དེ་ནས་དེ་ཉིད་དུ་འདུག་ལ་ཤར་ཕྱོགས་སུ་བལྟས་ཏེ།",
    "དེ་ནས་ཡང་མེའི་ཕྱོགས་སུ་འདུག་ལ་ནུབ་ཏུ་བལྟས་ཏེ་ལྷོ་ཕྱོགས་སུ་ཐིག་གདབ་བོ།",
    "འདི་དག་ཐམས་ཅད་ཀྱང་གཡོན་བརྐྱང་བའི་གནས་པས་འདུག་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་མདུན་དུ་འདུག་སྟེ་དེ་ཁོ་ན་ཉིད་ལན་ཅིག་བརྗོད་པར་བྱའོ།",
    "ཕྱིའི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་སྣ་ཚོགས་པདྨ་ཤར་སྒོར་བལྟས་པ་བྲིས་ནས་རྡོ་རྗེ་མེ་ལྟར་འབར་བའི་ཕྱག་རྒྱ་ཆེན་པོ་པདྨ་དེར་འདུག་ལ་མཆོད་ཡོན་བླངས་ཏེ་དྲི་དང་མེ་ཏོག་ལ་སོགས་པས་བདག་ཉིད་མཆོད་ལ།",
    "མྱུར་དུ་འཕང་བ་དང་དེ་བཞིན་དུ་བསྒྱུར་བ་དང་དེ་བཞིན་དུ་དྲང་བ་དང་རང་ཉིད་ང་རོ་འདོན་དུ་གཞུག་པ་དང་།",
    "དེ་ལྟ་བུས་ནི་ཐམས་ཅད་འདུག་གོ།",
    "༡༣༩༧དུ་བྱེད་ཅིང་འདུག་སྟེ།",
    "༡༤༢༡བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ་བརྗོད་པར་བྱའོ།",
    "༡༤༢༣བར་འདུག་ནས་ནི།",
    "ཞེས་བྱ་བ་ནི་ཡིད་དང་རྗེས་སུ་མཐུན་ཞིང་འདུ་འཛི་མེད་པའི་གནས་སུ་འདུག་པའོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་ལ་བསྐོར་བ་ལན་གསུམ་བྱས་ལ་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ།",
    "པེ་སྣར་འདུག་པེ་སྣར་དེ།",
    "པེ་སྣར་འདུག་༣པེ་སྣར་བྱིན་བརླབས།",
    "༡༣༦༥པེ་སྣར་མཚམས་སུ་འདུག་སྟེ་བྱང་།",
    "པེ་སྣར་འདུག་༣པེ་སྣར་པའི།",
    "ལྷག་པར་གྲོལ་དང་གྲོལ་བས་འདུག་གམ་ཅི",
    "གལ་ཏེམ་རྟོགས་པར་ལམ་ཁྱེར་ཙམ་ལ་གདིང་འཆའ་བ་དེ་རྒྱུ་འབྲས་སུ་འདུག་པསམཚང་བརྡོལ་བཨ་ཙ་མ",
    "ནང་རང་སེམས་གཞི་ཐམསབར་གཟུང་འཛིན་གཉིས་སུ་མི་ཕྱེད་པས་བརྡལ་ཁྱབ་ཆེན་པོ་དེར་བ་མེད་ད་དང་།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཉིད་བསྟན་པའི་ཕྱིར།",
    "སེམས་མཉམ་པ་ཉིད་ཀྱི་འོག་ཏུ་བསྒྲིམ་མི་དགོས་པར་སེམས་མཉམ་པར་གཞག་པའི་རྣལ་འབྱོར་གྱི་རྗེས་སུ་མཐུན་པར་མཉམ་པ་ཉིད་དུ་འཇུག་པ་གང་ཡིན་པ་དེ་སེམས་རྣལ་དུ་འདུག་པ་ཉིད་དོ།",
    "འཇིག་རྟེན་ནའང་སུ་དག་ཚིག་བསྡམས་ཏེ་འདུག་པ་དེ་ཐུབ་པ་ཞེས་བྱའོ།",
    "འདི་ཡང་གཡས་གཡོན་འདུག་པ་འགའ་ཞིག་ཡིན་གྱི།",
    "དེ་ནི་ངོ་བོ་གཅིག་པ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་ན་གྲིབ་མ་དང་ལྡན་པའི་མི་ལ་སོགས་པ་འདུག་བཞིན་དུ།",
    "དེ་དང་ལྡན་པ་འདུག་བཞིན་དུ།",
    "དེ་དང་ལྡན་པར་འདུག་བཞིན་དུ་དེ་དག་གཅིག་པ་ཡིན་པའི་ཕྱིར།",
    "མི་གཏོང་བར་འདུག་པ་ཞེས་བྱ་བ་ནི།",
    "ཡོངས་སུ་མ་བཏང་བར་འདུག་པའོ།",
    "འདུག་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "མིག་ལ་སོགས་པའི་རྟེན་ཉི་ཚེ་ལ་འདུག་པའི་ཕྱིར་རོ།",
    "ཁྱབ་པར་འདུག་ན།",
    "འོན་ཏེ་འདུག་པ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "འདུག་པ་ནི་རྣམ་པར་ཤེས་པ་རྣམས་རབ་ཏུ་འདུག་པ་དང་གནས་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
