    "མཆོད་སྦྱིན་འདི་ཁྱེར་རང་རང་གནས་སུ་དེངས",
    "ཨོྃ་རུ་ཏྲ་མ་ར་ནི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ཨཱ་ཧཱུྃ",
    "ཨོྃ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "ཨོྃ་རུ་ཏྲ་མཱ་ར་ནི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ཨོྃ་ཨཱ་ཧཱུྃ",
    "ལོ་ཟླ་ཞག་དུས་ཕྲ་མེན་དྲུག་ཅུ་བཞི",
    "ཨོྃ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མ་ཧཱ་མཱཾ་ས་རཀྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "མཆོད་སྦྱིན་འདི་ཁྱེར་རང་རང་གནས་སུ་དེངས",
    "ཨོྃ་རུ་ཏྲ་མ་ར་ཎི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ཨཱ་ཧཱུྃ",
    "ཨོཾ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "ལན་གསུམ་དང་མཐར་ཚོགས་ཞིང་རང་ལ་བསྟིམས།",
    "མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ལ་ཁཱ་ཧི",
    "རིགས་ཀྱི་ཡུམ་འཁྲིལ་རང་རང་འཁོར་ཚོགས་འབུམ",
    "སྟོབས་བསྐྱེད་རང་རང་སྐུ་ལས་འོད་ཚོགས་འཕྲོས",
    "རང་རང་རིགས་མཐུན་དཔག་མེད་འཕྲོས",
    "གཡོན་འཆི་མེད་ཚེ་ཡི་བུམ་པ་འཛིན་ཅིང་རང་བྱུང་ཡེ་ཤེས་འོད་ཀྱི་ཀློང་དུ་གསལ་བའོ",
    "ཅེས་ཚོགས་ཞིང་རང་ལ་བསྟིམས་ནས།",
    "བཛྲ་རཱུ་པ་ཤབྡ་གནྡྷེ་རཱ་ས་སྤརྴེ་པཱུ་ཛ་ཧོ་མ་ཧཱ་མཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ཁ་རཾ་ཁཱ་ཧི",
    "ཞེས་པའང་རང་སློབ་ཡེ་ཤེས་རྒྱལ་མཚན་ནས་འདི་ལྟར་བྲིས་ཞེས་ཡང་ཡང་བསྐུལ་ཞིང་ཡི་གེའི་མཐུན་གྱུར་ཀྱང་མཛད་པར་བརྟེན་སྒོ་ཆེན་སྤྲུལ་མིང་ནས་གཏེར་གཞུང་དགོངས་པ་བཞིན་སྦྱར་བའོ།",
    "སྐྱབས་ཡུལ་གསལ་བཏབ་ནས་སྐྱབས་སུ་འགྲོ་བ་དང་སེམས་བསྐྱེད་ཡན་ལག་བདུན་པ་རྣམས་གྲུབ་ནས་ཚོགས་ཞིང་རང་ལ་བསྡུ།",
    "རང་གཅིག་པུ་ལས་མེད་ན་སྤྱོད་ལམ་འདུག་ནས་བྱའོ།",
    "ཚུལ་དང་མཐུན་པར་ཙོག་ཙོག་པུར་འདུག་ཅིང་།",
    "ཞེས་ཚུལ་དང་མཐུན་པར་ཙོག་པུར་འདུག་སྟེ།",
    "ཞེས་ཙོག་པུར་འདུག་ལ་ཚེ་དང་ལྡན་པ་དགོངས་སུ་གསོལ།",
    "རྒན་རིམ་གྱི་མདུན་དུ་འདུག་ལ།",
    "འདུག་པའི་ཕྱིར་སྟན་ཤོམ་པ་སོགས་མ་བྱས་པ་ཚུན་ཆད་དུ།",
    "གང་དུ་བྱ་བའི་གཞི་དེ་ཉིད་དུ་འདུག་སྟེ།",
    "མཚམས་གཞན་གྱིས་བར་མ་ཆོད་པར་ཙོག་ཙོག་བུར་འདུག་སྟེ།",
    "རྒན་པའི་མཐར་ཙོག་ཙོག་པུར་འདུག་ནས།",
    "དེའི་ཚེ་དགེ་སློང་དེས་རྒན་པའི་མཐར་གུས་པ་དང་བཅས་པས་འདུག་སྟེ།",
    "ཤེས་ལྡན་དག་བདག་ཅག་འབའ་ཞིག་ལ་འདུག་པ་དང་།",
    "ཤེས་ལྡན་དག་བདག་ཅག་འབའ་ཞིག་ལ་འདུག་པ་དང་།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་རྣམས་ཀྱིས་དེང་ཕྱིན་ཆད་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་རྣམས་ཀྱིས་དེང་ཕྱིན་ཆད་འདུག་པ་དང་།",
    "དགེ་སློང་དག་ཁྱེད་ཚུར་ཤོག་འདུག་པ་ནི་རྣལ་འབྱོར་ཏེ།",
    "གོང་དུ་སྨོས་པའི་ཤིང་དེ་དག་ནི་ནང་ན་རྒྱ་སྐད་སོར་བཞག་བྲིས་པ་མང་དུ་འདུག་པས།",
    "ཡང་རང་གཅིག་པུ་ལ་ཕྱི་དྲོའི་ཁ་ཟས་ཟོས་པའི་ཉེས་པས་མ་གོས་ཤིང་།",
    "དེ་ནས་དགེ་ཚུལ་དེ་རྣམས་འདུག་སྟེ།",
    "འགའ་ཞིག་འདུག་སྟེ་གནས་པ་དང་།",
    "ཕྱོགས་མཐོན་པོར་འདུག་སྟེ་དགེ་སློང་མ་འོངས་པ་དག་འོང་ངམ་མི་འོང་ཕྱོགས་བཞིར་རྣམ་པར་བལྟ་བར་བྱའོ།",
    "གལ་ཏེ་གྲངས་མང་ཉུང་མཉམ་པ་ཉིད་ཡིན་ན་གཉུག་མར་གནས་པ་རྣམས་ཀྱི་རྗེས་སུ་འདུག་པར་བྱའོ།",
    "ཀུན་ཏུ་ཞུམ་ཞུམ་པོར་བྱས་ནས་བསྐུམ་ཞིང་བསྐུམས་ནས་འདུག་ན།",
    "དབྱར་གྱི་དུས་སུ་འགྲོ་འདུག་མང་པོ་བྱེད་པ་སྤངས་ཏེ།",
    "དེའི་མདུན་དུ་འདུག་སྟེ།",
    "ཚུལ་དང་མཐུན་པར་ཙོག་པུར་འདུག་སྟེ།",
    "གང་ཟག་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མིན་གྱི།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ།",
    "དེ་འབའ་ཞིག་ན་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་གཅིག་པུ་འདུག་ན་སྟན་དེ་ལ་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་བོ།",
    "ལྷག་མ་གཞན་ཞིག་ཡོད་ན་དེའི་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་ས་ཕྱོགས་མཐོན་པོ་ཞིག་ཏུ་འདུག་ལ་ཕྱོགས་བཞིར་བལྟ་བར་བྱའོ།",
    "འདི་ལ་འཆབ་སེམས་སྐྱེས་མ་སྐྱེས་ནི་གང་ཟག་ཁོ་རང་དང་།",
    "དེ་ནས་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་རྣམས་དང་ལྷན་ཅིག་ཏུ་གོས་པ་མཉམ་དུ་འདོར་བ་ཙམ་ཡང་མི་བྱ་བར་གོམ་པ་བསྲི་བ་དང་།",
    "སྟན་གཅིག་ལ་མི་འདུག་པར་རང་བཞིན་དུ་གནས་པ་ལས་སྟན་ཆེས་དམའ་བར་བྱེད་པ་སོགས་གཞན་དང་མཉམ་པ་དང་ལྷག་པའི་བསམ་པ་སྤོང་བ་དང་།",
    "མདུན་དུ་ཙོག་པུར་འདུག་ནས་ཐོག་མར་བཅབས་ཉེས་ཡོད་ན་དེ་བཤགས་དགོས་པས།",
    "བྲམ་ཟེ་རྣམས་ཀྱི་སྤྱི་བོ་ན་འདུག་པ་ཡིན།",
    "ཧོར་ཟླ་དང་བོ་སོགས་དྲུག་ལ་ཤོལ་བྱུང་ཚེ་ཐུབ་པའི་རྗེས་སུ་ཐུབ་པ་དམ་པ་འགའ་ཞིག་གསུངས་པ་རྗེ་ཡབ་སྲས་ཀྱི་ཕྱག་ལེན་ལས་ཞིབ་ཆ་ཐོན་པ་ལྟར་འདུག་པས་དེ་ལྟར་བྱེད་དོ་སྙམ་ན།",
    "གཞན་གྱི་ལོ་མགོ་རང་རང་དུས་ཟླས་དབྱེ།",
    "ཁྱེད་རང་དཀར་ཆ་རྫོགས་པ་ལ་གནམ་གང་ཟེར་བ་སྔོན་མེད་པའི་ཐ་སྙད་དེ།",
    "ཁྱེད་རང་ཁས་བླངས་པ་འགལ་ལོ།",
    "ཁྱེད་རང་དེ་དུས་བག་སྟོན་གྱི་སར་བོས་པ་ཡིན་ན།",
    "དེ་ཡང་གུང་བསྒྲིགས་པའི་དཔྱད་པ་མ་དག་པར་ཁ་ཚོན་གཅོད་པ་སྐྱོན་པར་གདའ་ཞེས་དང་།",
    "ཉིན་གུང་ཕན་ཆད་ཡིན་ན་གདུགས་ཀྱི་རིམ་པ་ལ་ཞེས་སྦྱོརདེ་ནས་ཐམས་ཅད་ཙོག་པུར་འདུག་སྟེ།",
    "དགེ་ཚུལ་རྣམས་ཙོག་པུར་འདུག་སྟེ།",
    "དེ་ནས་ཙོག་པུར་འདུག་སྟེ་གནས་བརྟན་དགོངས་སུ་གསོལ།",
    "དེ་ནས་ཙོག་པུར་འདུག་སྟེ་གནས་བརྟན་དགོངས་སུ་གསོལ་གནས་བརྟན་གྱིས་བཟུང་དུ་གསོལ།",
    "སྟོན་པ་དང་འཕགས་པའི་ཚོགས་སམ་བསྟན་པ་ལ་དགའ་བའི་ལྷ་གསལ་བཏབ་སྟེ་འདུག་ནས།",
    "དེ་ནས་ཙོག་པུར་འདུག་སྟེ་གནས་བརྟན་དགོངས་སུ་གསོལ་འདི་ལགས་སོ་ཞེས་ལན་གསུམ་ཐབས་ལེགས་བྱ།",
    "དེ་ནས་བསྐོས་པའི་དགེ་སློང་གདིང་བའི་སྟེང་ན་འདུག་པའི་མདུན་དུ་གནས་བརྟན་ནས་བཟུང་རྒན་རིམ་བཞིན་གསུམ་མན་ཆད་ཀྱིས་ཕྱག་གསུམ་འཚལ་ཏེ།",
    "དེ་ནས་དགེ་ཚུལ་དེ་རྣམས་འདུག་སྟེ།",
    "ཕྲ་རྒྱས་ཐམས་ཅད་ཀྱང་རང་ལ་དམིགས་པའི་སྒོ་ནས་ཟག་པ་རྒྱས་རུང་ཡིན་ཏེ།",
    "ཡིད་ཤེས་རྟོག་བྲལ་དུ་གྱུར་བའི་སེམས་དང་སེམས་བྱུང་རང་ཡུལ་ལ་གསལ་སྣང་དང་བཅས་ཏེ་འཇུག་ཚུལ་དང་།",
    "རྗེས་དཔག་དང་རང་དོན་རྗེས་དཔག་གཉིས་དོན་གཅིག་ཡིན་ཏེ།",
    "དམར་སེར་དང་དཀར་སྔོན་བཞི་ཁྲ་བོར་འདུག་ཀྱང་རུང་སོ་སོའི་ཁ་དོག་ཀྱང་རུང་དེ་བཞིན་དུ་གྱོལ་པོ་ནི་རྐང་ཡོན་ནོ།",
    "དགེ་སློང་རང་ལ་གཙུག་ཕུད་འཇོག་པ་འབྲེག་མཁན་ལ་སོགས་པ་བྱེད་དུ་མི་གཞུག་གོ།",
    "ལུས་ཕྱིས་མེད་ན་ཡུད་ཙམ་ཞིག་ནི་ཁྲུས་བྱས་པས་ལུས་གཤེར་བ་མ་བསྐམས་ཀྱི་བར་དུ་ཙོག་པུར་འདུག་པ་ནི་ལུས་ལ་ཆུའི་ཐིག་པ་མྱུར་དུ་འབྲུལ་བའི་ཕྱིར་ཊཱི་ལ་ཁྲུས་རས་ཀྱིས་ལུས་ཕྱི་བར་བྱའོ།",
    "འདུག་སྟེ་བྱའི་འགྲེང་བཞིན་དུ་ལྷུང་བཟེད་སྣོད་ནས་དབྱུང་བ་དང་གཞུག་པ་དང་སྐམ་པར་མི་བྱའོ།",
    "ཡུན་ཇི་སྲིད་དུ་མི་གནས་པར་འདུག་པ་ལ་ཉེས་པ་མེད་ཅེ་ན་ཞག་ལྔའི་མཐར་ཐུག་པའི་བར་དུའོ།",
    "གནས་དང་གནས་པ་གཉིས་གཙུག་ལག་ཁང་གཅིག་བི་པ་དེ་ན་འདུག་ན་གནས་པས་གནས་དེའི་དྲུང་དུ་ཉིན་པར་ལན་གསུམ་དུ་འགྲོ་ཞིང་བྱ་བ་ཞུ་བར་བྱའོ།",
    "གནས་དེ་ལ་གནས་པས་བཞར་བར་བྱ་སྟེ་ཐག་མི་རིང་བར་འདུག་པར་བྱའོ།་",
    "གོང་དུ་འདུག་པ་དང་འགྲེང་བར་ཊཱི་མི་བྱའོ།",
    "གལ་ཏེ་དགེ་སློང་རང་དང་ཡུལ་མི་གཞན་ལ་དངོས་སུ་གནོད་པར་མི་འགྱུར་བ་ནི་མི་དགག་པར་ཅི་བདེར་བཏང་སྙོམས་སུ་བཞག་གོ།",
    "གཡོག་འཁོར་གྱི་བྱ་བ་མི་མཐུན་པ་དེ་དག་རྒྱུན་བཅད་པར་མི་ནུས་པ་ཉིད་ཡིན་ན་དགེ་སློང་རང་ཉིད་གནས་གཞན་དུ་འགྲོ་བར་བྱའོ།",
    "མགུལ་པ་ཁྲམ་གཉེར་དུ་འདུག་པ་ཤིང་ཏ་ལའི་གཉེར་མ་ལྟ་བུ་དང་།",
    "ཚིག་ཏུ་སྨྲས་པ་དེ་ཁོ་ན་ལས་བསླབ་པ་དབུལ་བར་འགྱུར་བར་མ་ཟད་ཀྱི་ཚིག་ཏུ་མ་སྨྲས་པར་གཏོང་བའི་མཚན་མ་ལས་ཀྱང་ཕུལ་བར་འགྱུར་ཏེ་དེས་ན་ལུས་ཀྱི་རྣམ་པར་རིག་བྱེད་ལས་ཕུལ་བར་འགྱུར་ཞེས་ཊཱི་ཀ་དང་རང་འགྲེལ་ལས་ཀྱང་ངོ།",
    "དགེ་སློང་བསྲུངས་པ་ནི་གསུམ་སྟེ་སྒོ་བཅད་ཅིང་ལུང་རྣམ་འབྱེད་ལས་སྒོ་སྒོ་གཏན་གྱིས་བཅད་ཅེས་སོ་རྣམ་འབྱེད་འགྲེལ་ལས་སྒོ་གཏན་ཞེས་བྱ་བ་ནི་སྒོ་ལྕགས་ལ་སོགས་པའི་ཞེས་སོ་འགྲེལ་ཆུང་ལས་ཁང་པ་ལྟ་བུས་མཐའ་བསྐོར་ཅིང་འདུག་པ་ལ་སྒོ་གཏན་པ་བཅུག་སྟེ་ཉལ་ན་ཉེས་མེད་དོ་ཞེས་སོ།",
    "མུ་ཏིག་ཆུན་པོ་ལ་སོགས་རྩྭ་བཏིང་བའི་སྟེང་ན་འདུག་པ་ལ་རྩ་ཁ་དོག་གཅིག་པ་ཡིན་ན་ཕྱོགས་གཅིག་པར་བརྗོད་པར་བྱའོ་རྩྭ་ཁ་དོག་ཐ་དད་པ་ཡིན་ན་ཕྱོགས་ཐ་དད་པར་བརྗོད་པར་བྱའོ།་",
    "ཐོག་མ་འདུག་པའི་གནས་མི་སྣང་བར་གྱུར་ན་ཕམ།",
    "ཕ་རོལ་གྱི་འགྲམ་དུ་མ་ཕྱིན་ཀྱང་ཐོག་མ་འདུག་པའི་ས་མི་སྣང་ན་ཕམ།་",
    "གང་ན་གྲུ་ཕུར་པ་ལ་བརྟོད་ཅིང་འདུག་པའི་གནས་དེ་ནས་ཁྲིད་དེ་ཕ་རོལ་ཏུ་བསྒྲལ་བའི་ཕྱིར་ཚུ་རོལ་ཏུ་བཏང་བའི་གནས་སུ་གྱེན་ལ་འཁྲིད་པར་བྱེད་པའི་ཕྱོགས་དེ་ནི་གྲུ་ཚུགས་ཞེས་བྱའོ།",
    "ནོར་མང་པོ་ཞིག་འདུག་པ་ལ་གདམ་སྟེར་གང་བཟང་པོ་དེ་རྐུ་བར་འདོད་པས་གདམ་ཊཱི་པ་ལ་ཡང་ངོ།་",
    "རྩིས་བྱེད་པ་ལྟ་བུ་ལ་བཅུ་ཁྲམ་དང་བརྒྱ་ཁྲམ་དང་ཡིག་འབྲུ་ལ་སོགས་པ་གླེགས་བུ་ལ་བྲིས་ཏེ་བཞག་པ་ན་བདག་རྒྱལ་བར་བྱ་བའི་ཕྱིར་བཅུ་ཁྲམ་དང་བརྒྱ་ཁྲམ་ལ་སོགས་པའི་མཚན་མ་ཕྱིས་པ་མེད་པར་བྱས་པ་དང་མཚན་མ་བསྣན་པ་ལྷག་པར་བསྣན་པ་གཉིས་དང་མཚན་པ་གནས་གཞན་དུ་ལྟག་འོག་སྣོར་ཅིང་བཞག་པ་ཡང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་དེ་ཉིད་ཡིན་ཏེ་སྦྱོར་བ་དེའི་སྦྱོར་བ་སྟེ་ཉེས་བྱས་ཉིད་དོ།",
    "མི་གཞན་ལ་འདི་ལྟར་བྱས་ན་ཕམ་པར་འགྱུར་བས་དགེ་སློང་རང་ཉིད་གཡང་ས་ནས་མཆོང་པ་དང་།",
    "རྣམ་འབྱེད་འགྲེལ་ལས་རྡུལ་ཁྲོད་ཀྱི་ཤ་ཟ་ནི་ཕྱག་དར་ཁྲོད་ཀྱི་འདྲེའམ་ཚུབས་མའི་ནང་ན་འདུག་པའི་འདྲེའོ་ཞེས་སོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ལ་བརྟེན་པ་སྟེ་དེ་དག་དང་ཉེ་བར་གྱུར་པ་ཉིད་དང་།",
