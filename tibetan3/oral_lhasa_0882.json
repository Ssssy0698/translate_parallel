    "གཟུགས་ཇི་ལྟར་འགྲུབ་པར་འགྱུར།",
    "གལ་ཏེ་འདིའི་རྟགས་གཟུགས་སོ་སྙམ་པའི་བློ་གཟུགས་ཅན་གྱི་བློ་ཡོད་ན་གཟུགས་ཞེས་བྱ་བ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གཟུགས་མེད་ཇི་ལྟར་འཛིན་པར་འགྱུར།",
    "གལ་ཏེ་གཟུགས་འཛིན་པར་གྱུར་ཏེ།",
    "གཟུགས་ནི་ཇི་ལྟར་རྟོགས་པར་འགྱུར།",
    "འདི་ལ་གཟུགས་དང་བློ་འདི་གཉི་ག་ཡང་སྐད་ཅིག་ཡིན་པར་བསམས་ཏེ།",
    "མི་སྲིད་པའི་ཕྱིར་རྟོགས་པར་མི་འགྱུར་རོ།",
    "གཞན་ཡང་ཁ་དོག་དང་དབྱིབས་ཁས་བླངས་སུ་ཟིན་ཡང་གཟུགས་འཛིན་པར་མི་འཐད་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་དེ་གཉིས་ཐ་དད་དུ་འཛིན་པ་འཐད་པར་འགྱུར།",
    "རྣ་བ་ལ་སོགས་པ་ཡང་ཅི་རིགས་པར་དེ་དང་འདྲའོ།",
    "ཞེས་མཐུན་པར་བསྟན་ཏེ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་བློ་ནི་ནང་ཡིན་ལ་གཟུགས་ནི་སྤྱད་པར་བྱ་བ་དང་ཕྱི་རོལ་ཡིན་ཏེ།",
    "བློ་ཉིད་ནི་རྟོགས་བྱས་ལ་སོགས་པ་ལ་བརྟེན་ནས་གྲུབ་པ་ཡིན་ནོ།",
    "ཇི་སྟེ་གཞན་གྱི་བདག་ཉིད་དུ་ཡོད་པར་འདོད་ན་དེ་ཡང་མི་རུང་སྟེ།",
