    "༡༥བཞད་གད་དཔྱིད་ཀྱི་ཕོ་ཉར་བལྟས་རྗེས་ཀྱི་མྱོང་ཚོར་འདོད་ཡོན་སྣ་ལྔ།",
    "ཡང་འདི་ཉིད་གནས་གཅིག་ཏུ་དཀའ་བ་སྤྱད་དེ་སྒྲུབ་སྦྱངས་ཡུན་རིང་བར་བྱས་པས་ནམ་ཞིག་མཐའ་སྐོར་དུ་གྲོག་མའི་ཚང་གིས་ས་མཁར་ལྟ་བུར་གྱུར་པས་ན་མཚན་ཡང་དེ་ལྟར་ཐོགས།",
    "བོད་རང་གི་མཁས་པ་རྣམས་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགཀྱིས་གཏམ་རྒྱུད་དེ་ལ་སྦྱར་ནས་བརྩམས་པའི་སྙན་རྩོམ་གྱི་སྐོར་ཤིན་ཏུ་མང་ཞིང་།",
    "རཱ་མ་ཎའི་རྟོགས་བརྗོད་བོད་འགྱུར་གསར་རྙིང་ཁག་ལ་གཞི་བཅོལ་ཏེ་རྟོགས་བརྗོད་དེའི་ནང་གི་ཕུལ་དུ་བྱུང་བའི་སྙན་ངག་གི་སྒྱུ་རྩལ་དང་།",
    "ངོ་མཚར་ཆེ་བའི་ལྷ་སྒྲུང་གི་སྒྱུ་རྩལ།",
    "རང་ཉིད་མ་ཡོང་པར་རང་གི་བཙུན་མོ་དང་སྲས་གཉིས་སྔ་གཞུག་ཏུ་འབོད་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགསྒྲོགས་ལ་དངོས་གྲུབ་སྦྱིན་དུ་མངགས་མོད།",
    "ཁོ་བོས་དེ་གཉིཧ་དངོས་གྲུབ་ཀྱི་གེགས་སུ་བཟུང་ནས་བཙུན་མོ་ཨུ་མཱ་དང་སྲས་ཙིའུ་མིག་གསུམ་པ་གཉིས་ལ་རེ་རེར་བརྙས་ཤིང་སྨོད་པ་བཏང་བས་དེ་གཉིས་ཀྱང་ཤིན་ཏུ་ཁྲོས་པས་སྲིན་རྒྱལ་ལ་དམོད་པའི་ཚིག་མདའ་དྲག་པོ་འཕངས་པ་དང་།",
    "དེའི་ཚེ་སྲིན་པོའི་རྒྱལ་པོ་འདིའི་ཆུང་མར་སི་ཏཱ་ཞེས་པའི་བུ་མོ་ཤིན་ཏུ་མཛེས་སྡུག་ལྡན་པ་ཞིག་བཙས་ཤིང་།",
    "དེ་མཚན་མཁན་གྱིས་ཆེས་བཀྲ་མི་ཤིས་པའི་ལྟས་ངན་དུ་བརྩིས་ནས་ངེས་པར་དུ་ཆུ་ལ་གཡུག་དགོས་པའི་ངག་བཞིན་བུ་མོ་སི་ཏཱ་སྒྲོམ་དུ་བཅུག་ནས་ཆུ་ལ་བསྐྱུར།",
    "མ་ཎར་ཤིན་ཏུ་མཛེས་པའི་བཙུན་མོ་སི་ཏཱ་ཞེས་པ་ཞིག་ཡོད་པ་རྣ་བར་ཐོས་པས།",
    "འདོད་སེམས་མེ་ལྟར་འབར་ནས་རི་དྭགས་ཤིག་ལ་སྤྲུལ་ནས་ཁོང་རྣམས་གནས་བཅའ་སའི་སར་ཉེ་བར་སོང་བ་ན།",
    "སྲིན་ཡུལ་དུ་སི་ཏཱ་འཁྲུངས་པ་རཱ་མ་ཎའི་བཙུན་མོར་ཐོབ་པའི་སྐོར།",
    "སྤྲེའུ་ཧ་ནུ་མན་ཐ་སྲིན་ཡུལ་དུ་སོང་སྟེ་སི་ཏཱ་དང་འཕྲད་པའི་སྐོར།",
    "སྲིན་པོའི་དཔུང་གིས་སྤྲེའུ་བཟུང་སྟེ་གསོད་པར་བརྩམས་པའི་སྐོར།",
    "གཏམ་རྒྱུད་ནང་གི་ཕུལ་དུ་བྱུང་བའི་སྙན་ངག་གི་སྒྱུ་རྩལ།",
    "བར་བར་ཁྲག་གི་ལྡེང་ཀ་འཁྱིལ།",
    "ལྟ་བུ་འཇིགས་རུང་གི་ཉམས་རྒྱན།",
    "ངང་པ་ཤུག་གིས་དོར་བ་དང་།",
    "གཉིས་འཐུང་གླང་མོས་དོར་འདྲ་དེ།",
    "ལྟ་བུ་སྒྲ་རྒྱན་ལས་བོད་རང་གི་ཀ་ཕྲེང་།",
    "ལྟ་བུ་ཕུལ་བྱུང་གི་རྒྱན་དང་།",
    "ལྟ་བུ་རྨད་བྱུང་གི་དཔེ་དང་།",
    "མོ་མཆོག་ཡོད་དོ་ཅོག་ཐོས་སྒྲོགས།",
    "ཅ་ཅོའི་གླུ་ཡིས་ཅོ་ནས་འདྲེན་ཁྱོད་ཅིར་ཡང་མཆོག་ཚིག་ཅེ་སྤྱང་སྐད་མཚུངས་ལུས་གཅུ་ཞིང་།",
    "ཇ་ཡི་བཏུང་བའི་ཨུ་མའི་ཇོ་བ་ཇི་ཙམ་དགྱེས་པའི་ཇེ་མང་འདོད་ཡོན་ཇུ་རྩེའི་གོས་སོགས་ཟོང་འདི་དགཉ་གང་ཟླ་བར་འཆི་བའི་ཉི་འོད་ཉེ་བའི་སྐབས་མེད་ཉོ་ཚོང་རེ་བ་ཉུང་ངུ་མིན་འདིའི་སླད་དུའོ།",
    "ཐབས་གང་གིས་ནི་ཞི་བར་འགྱིད།",
    "ལྟ་བུ་གབ་ཚིག་གི་རྒྱན་ལ་སོཊ་པ་མཐའ་ཡས་སོ།",
    "གཏམ་རྒྱུད་ནང་གི་མི་སྣའི་གཟུགས་བརྙན་གྱི་སྒྱུ་རྩལ།",
    "རཱ་མ་ཎའི་གཏམ་རྒྱུད་ནང་གི་མི་སྣ་གཙོ་བོའི་གཟུགས་བརྙན་ནི་ཆེས་གསོན་ཉམས་ལྡན་པ་ཞིག་ཡིན་པས་གནའ་དུས་ནས་རྒྱ་གར་ཙམ་དུ་མ་ཟད་རྒྱལ་ཁབ་མང་པོས་ཀྱང་གཏམ་རྒྱུད་དེ་འཁྲབ་གཞུང་དུ་བཅོས་ནས་གར་སྟེགས་ཐོག་འཁྲབ་སྟོན་བྱེད་མྱོང་ཡོད།",
    "འདིར་གཏམ་རྒྱུད་དེའི་ནང་གི་མི་སྣ་གཙོ་བོ་འགའ་ཞིག་ངོ་སྤྲོད་ཞུས་ན་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགའདི་ལྟ་སྟེ།",
    "སྟོབས་དང་གཟི་བརྗིད་ལང་ཚོའི་དཔལ་ཕུན་སུམ་ཚོགས་ཤིང་།",
    "རྒྱལ་པོ་འདི་ནི་གཏམ་རྒྱུད་ནང་གི་མི་སྣ་གཙོ་བོའི་གཙོ་བོ་དེ་ཡིན་པས་གཏམ་རྒྱུད་ཀྱི་མིང་ལའང་རྒྱལ་པོ་རཱ་མ་ཎའི་གཏམ་རྒྱུད་ཅེས་ཟེར།",
    "འོན་ཀྱང་རྒྱལ་པོ་རཱ་མ་ཎ་དང་ཚེ་སྔོན་གྱི་ལས་འཕྲོའི་མེ་ཏོག་བགོ་སྐལ་ཕོག་ཟིན་པས་མཚན་མཁན་གྱིས་ལྟས་ངན་དུ་བརྩིས་ནས་སྒྲོམ་དུ་བླུགས་ཏེ་ཆུ་ལ་བསྐྱུར་བས་རྒྱལ་པོའི་བཙུན་མོ་བྱེད་པའི་སྐལ་བཟང་ཐོབ།",
    "སྤྲེའུ་མགྲིན་བཟང་གི་གཟུགས་བརྙན་ནི་ཞི་མ་ཁྲོ་ཞིག་སྤྲེའུ་ཧ་ནུ་མན་ཐ།",
    "འདི་ནི་མགྲིན་བཟང་གི་བྲན་ནམ་འཁོར་གཡོག་ཡིན་པས་ཧ་ནུ་མན་ཐའི་ངག་ལྟར་སྲིན་ཡུལ་མེ་ལ་བསྲེགས།",
    "སྤྲེའུ་དཀར་མོ།",
    "ཡངས་པའི་ས་གཞི་ཆེན་པོའི་ཐོག་གི་མི་རིགས་སོ་སོར་རང་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་ཡུལ་གོམས་གཤིས་ལུགས་དང་།",
    "རྒྱ་གར་བས་བུད་མེད་མཛེས་མའི་མིག་གི་དཔེ་ལ་རི་དྭགས་མིག་ཅན་ཞེས་སྦྱར་གྱི་ཡོད་པ་དེ་རང་ཅག་བོད་པས་ཀྱང་སྙན་ངག་ནང་བརྗོད་རྐྱང་བྱེད་ཀྱི་ཡོད།",
    "འོན་ཀྱང་གལ་སྲིད་རྒྱ་རིགས་མཛེས་མ་ཞིག་ལ་རྒྱ་སྐད་ཐོག་ནས་ཁྱེད་རང་གི་མིག་དེ་རི་དྭགས་ཀྱི་མིག་ནང་བཞིན་རེད་ཅེས་སྨྲས་ན་བསྟོད་བསྔགས་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགསུ་གོ་རྒྱུ་ཕར་བཞག་དམའ་འབེབས་སུ་གོ་ངེས་ཡིན།",
    "ཚན་རྩལ་འཕེལ་རྒྱས་གོམ་སྟབས་མེ་ཤུགས་འཕུར་མདའ་བཞིན་ཞེས་པར་མཚོན་ན་མེ་ཤུགས་འཕུར་མདའ་ནི་གནའ་དུས་མེད་པའི་གསར་གཏོད་ཅིག་ཡིན་པས་དཔེ་གསར་པ་ཡིན་པ་སྨོས་མེད་ཡིན་པ་ལྟ་བུ་རེད།",
    "རྗེས་སུ་མུ་མཐུད་འགོད་མཁན་ནི་བླུན་པོ་ཡིན་ཞེས་གསུངས་པ་ནི་ངེས་པར་དུ་ཡིད་ལ་བཅངས་དགོས་པའི་གདམས་ངག་ཟབ་མོ་ཞིག་ཡིན།",
    "ད་དུང་ཆུ་ཀླུང་ཚོགས་ཀྱིས་ཆེར་གང་བའི།",
    "ཉི་མའི་གྲོགས་མོ་ནི་མེ་ཏོག་པད་མ་ཡིན་ན་ཡང་པད་མའི་གྲོགས་མོ་ཞེས་མ་བརྗོད་པར་ཅུང་སྦས་པའམ་གབ་པའི་ཚུལ་གྱིས་ཉི་མའི་གྲོགས་མོ་ཞེས་བརྗོད་པ་ནི་སྔོན་ཆད་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགགཞན་གྱིས་ཡིད་ལ་མ་འཆར་བའི་དཔེ་གསར་པ་ཞིག་ཡིན་ནོ།",
    "སྣུམ་མེད་ན་མར་མེ་གསོན་ཐབས་བྲལ་བ་ཡོངས་གྲགས་ཡིན་མོད།",
    "དཔེ་དོན་ཤིན་ཏུ་འཚམ་ཞིང་གོ་བ་ཟབ་མོ་ལེན་རྒྱུ་ཡོད་པ་ཞིག་ཡིན་ཏེ།",
    "དེ་བཞིན་དཔེ་ཅན་སྙན་རྩོམ་ལས་སྙན་ངག་གི་ལུས་རྒྱན་སྲོག་གསུམ་གྱི་ངོ་གདོང་ཅིག་ཅར་གསལ་བའམ་སྣང་བ་དང་།",
    "དྲུག་ངོ་མཚར་ཆེ་བའི་ལྷ་སྒྲུང་གི་སྒྱུ་རྩལ།",
    "རྒྱལ་པོ་རཱ་མ་ཎའི་གཏམ་རྒྱུད་ནང་གི་ལྷ་སྒྲུང་གི་སྒྱུ་རྩལ་ནི་ཆེས་ངོ་མཚར་ལྡན་པ་ཞིག་ཏུ་སྣང་།",
    "རཱ་མ་ཎའི་གཏམ་རྒྱུད་ནང་གི་ལྷ་སྒྲུང་དག་ལས་ཀྱང་ཤེས་ཐུབ་པ་དཔེར་ན།",
    "ད་དུང་སྣུམ་རྒྱ་མཚོ་ཙམ་བླུགས་ན་ཐམས་ཅད་བསྣུབས་ངེས་ཡིན་པ་ཚང་མས་མཁྱེན་གསལ་ལྟར་རེད།",
    "འོན་ཀྱང་གཏམ་རྒྱུད་ནང་ལྷ་སྒྲུང་གི་སྒྱུ་རྩལ་ལ་བརྟེན་ནས་ཐོག་མར་སྲིན་པོའི་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགརྔ་མར་རས་རི་ཙམ་གཡོགས་པ་དང་།",
    "ཆུ་སྲིན་ཉའི་རིགས་ཅན་ཉ་མིད་ཅེས་བྱ་བ་སྟོང་གསུམ་གྱི་འཇིག་རྟེན་སྟོང་ཆེན་པོའི་ཁྱོན་དང་མཉམ་པ་ལྟ་བུའི་ལུས་བོངས་ཆེན་པོ་ཞིག་ཡོད་ཅེས་གསུངས།",
    "དོན་དངོས་ཐོག་ལུས་བོངས་སྟོང་གསུམ་གྱི་འཇིག་རྟེན་སྟོང་ཆེན་པོའི་ཁྱོན་དང་མཉམ་པའི་ཉ་མིད་དམ་ཉ་རིགས་ཤིག་ཡོད་མི་སྲིད།",
    "འོན་ཀྱང་དེ་ནི་འུད་ཤོབ་དང་རྫུན་གཏམ་གཏན་ནས་མ་ཡིན་པར་དམངས་ཁྲོད་དུ་ཡངས་པའི་ས་གཞི་ཆེན་པོའི་འོག་ཏུ་ཉ་ཆེན་པོ་ས་གཞི་དང་མཉམ་པ་ཞིག་ཡོད་པ་དེའི་མཇུག་མ་དང་མགོ་བོ་སོགས་ཀྱིས་འགུལ་སྐྱོད་བྱས་ན་ས་ཡོམ་རྒྱག་གི་ཡོད་ཅེས་པའི་ཤོད་སྲོལ་གཞིར་བཞག་ནས་ངོ་མཚར་ཅན་གྱི་ལྷ་སྒྲུང་ཞིག་གསར་རྩོམ་བྱས་ཡོད།",
    "གཏམ་རྒྱུད་ནང་རཱ་མ་ཎས་སྲིན་པོའི་གླིང་ལ་གཡུལ་བཤམས་ནས་ཕམ་པར་བྱས་པས་དམག་ལས་ཐར་བའི་སྲིན་པོ་འགའ་ཞིག་གིས་སྲིན་པོའི་རྒྱལ་པོ་མགྲིན་བཅུ་པའི་ནུ་བོ་ཨུ་པ་ཀརྣ་སྟེ།",
    "ཡིད་བསམ་གཏན་ལ་རྟག་ཏུ་འཇོག་པ་དེའི་དྲུང་དུ་སོང་སྟེ།",
    "པོའི་རྗེ་འབངས་ཐམས་ཅད་བརླག་པའི་སྡུག་བསྔལ་ཡུས་སམ་སྡུག་ཡུས་ཀྱི་མཆི་མས་མགྲིན་པ་བརྣངས་ཏེ་རྟབ་རྟབ་པོར་གྱུར་པའི་སྲིན་པོ་དེ་དག་གིས་ཨུ་པ་ཀརྣའི་རྣ་བར་ཁྲོ་ཆུ་ཚ་པོ་བླུགས་པས།",
    "བཏུང་དུ་མི་རུང་བའི་འབབ་ཆུ་དྲོན་མོའི་རྒྱུན་ཞིག་རྙེད།",
    "གླང་ཆེན་གྱི་ཕྲུ་གུ་ཞིག་གིས།",
    "འགྲོ་བ་བཟང་མོ།",
    "གཟུགས་ཀྱི་ཉི་མ་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགསོགས་ཀྱི་ནང་དུའང་བཀོད་ཡོད་པ་དེས་ལྷ་མོའི་སྒྱུ་རྩལ་ཐད་ལ་ནུས་པ་ཧ་ཅང་ཆེན་པོ་ཐོན་ཡོད།",
    "ཤེས་རྒྱུད་རེ་ཞིག་ཞི་བ་ལྟར་སྣང་བའི་ཞི་བ་བའམ་བསམ་གཏན་པ་དེའི་རྒྱུད་རབ་ཏུ་འཁྲུགས་ནས་ནི།",
    "རཱ་མ་ཎའི་རྟོགས་བརྗོད་ནང་རྩོམ་པ་པོས་མངོན་བརྗོད་ཧ་ཅང་མང་པོ་ཞིག་བཀོལ་སྤྱོད་གནང་ཡོད་པ་དེས་སྙན་ངག་ཧྲིལ་པོའི་ཚིག་སྦྱོར་གཡང་རྩེའི་སྒང་ལ་ཡས་སྒྲོན་ཞེས་པའི་དཔེ་ལྟར་དེ་བས་སྙན་དུ་སོང་ཡོད་པ་དང་།",
    "མཚན་མོ་རྒྱུ་བ་སྟེ་སྲིན་པོ།",
    "མངག་བཞུག་མ་སྟེ་བྲན་མོ།",
    "རྐང་པའི་རི་མོ་སྟེ་རྐང་རྗེས།",
    "རྩེ་མོ་ཅན་ཏེ་མེལྟོ་འགྲོ་སྟེ་སྦྲུལ།",
    "ཉིན་མོ་རྒྱུ་བ་སྟེ་སྤྲེའུ།",
    "དཔུང་ཚོགས་ཀྱི་ཕྲུ་མ་སྟེ་དམག་སྒར།",
    "ཛ་ཧུའི་བུ་མོ་སྟེ་ཆུ་བོ་གང་གཱ།",
    "མེ་ཏོག་གི་དུས་ཏེ་དཔྱིད་ཀ།",
    "སྣག་གི་གཉེན་ཏེ་མའི་རིགས་རྒྱུད་ཀྱི་གཉེན།",
    "ལྷ་མོ་མཚོ་ལྡན་མ་སྟེ་དབྱངས་ཅན་མ།",
    "མའི་རིགས་རྒྱུད་ཀྱི་གཉེན་ལ་སྣག་གི་གཉེན་དང་།",
    "རྔ་ཡབ་གླིང་གི་བདག་པོ་སོགས་སྣ་ཚོགས་སྦྱར་བས་ཟློས་སྐྱོན་འགོག་པའི་ནུས་པ་ཐོན་ཡོད་ཅིང་།",
    "ད་དུང་མངོན་བརྗོད་ཉིན་མོ་རྒྱུ་བ་དང་།",
    "ཀཱ་ཀོ་ལ་སོགས་ལ་གོ་དོན་གཞན་དག་ཀྱང་ཡོད་མོད།",
    "སྐབས་འདིར་ཉིན་མོ་རྒྱུ་བ་ནི་སྤྲེའུ་དང་།",
    "ཀཱ་ཀོ་ལ་ནི་དུག་ལ་གོ་དགོས་པ་བཅས་རཱ་མ་ཎའི་གཏམ་རྒྱུད་ནང་གི་མངོན་བརྗོད་ཀྱི་སྐོར་རེ་ཞིག་བརྗོད་མཚམས་འཇོག་པར་བྱ།",
    "ཚིག་གི་ལོ་མ་མེད་པར་དོན་གྱི་འབྲས་བུ་ཆུ་བརྒྱ་ཟམ་འདུས་ཀྱིས་ཞུས་ན།",
    "བྱའི་དཀྱིལ་འཁོར་མ་ལུས་པ་དྲི་མ་མེད་པའི་རིགས་པའི་མིག་གིས་ལྟ་བ་ལ་མཁས་པའི་མདུན་སར་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་དཔལ་ཐོབ་ཅིང་ཐ་སྙད་ཀྱི་གཙུག་ལག་མ་ལུས་པའི་ཕ་རོལ་དུ་སོན་པའི་སྐྱེ་བོ་མཐའ་དག་གི་ཞབས་ཀྱི་པད་མོ་ལ་ཕྱག་བྱས་པ།",
    "འོ་ན་རཱ་མ་ཎའི་གཏམ་རྒྱུད་འདིར་སྐྱོན་ཕྲ་མོ་ཙམ་ཡང་མེད་དམ་ཞེ་ན་དེ་འདྲ་འཇིག་རྟེན་དུ་གཏན་ནས་ཡོང་མི་སྲིད་དེ།",
    "མགྲིན་བཟང་གིས་སླར་ཡང་རྒྱལ་པོར་སྨྲས་པ།",
    "བདག་ཅག་གི་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བ་དང་པོར།",
    "བདག་གི་སོར་མོའི་རྩེ་ན་གནས་པའི་ཅོད་པན་བཞིན་ནོ་ཞེས་འཁོད་པ་ལྟར་རྒྱལ་པོ་རཱ་མ་ཎས་མདའ་འཕངས་ཏེ་སྤྲེའུ་འབའ་ལེ་བསད་པ་དང་།",
    "སྤྲེའུ་མགྲིན་བཟང་གིས་དེའི་དྲིན་ལན་དུ་རང་གི་གྲོགས་པོ་སྤྲེའུ་ཧ་ནུ་མན་ཐ་སྲིན་ཡུལ་དུ་མངགས་ནས་སྲིན་ཡུལ་མེ་ལ་བསྲེགས་པ་རེད།",
    "དེ་ནི་གཏམ་རྒྱུད་དེའི་ནང་གི་ནང་དོན་ཐད་ཀྱི་ཞན་ཆ་ཕྲན་བུ་ཞིག་ཏུ་མཐོང་།",
    "ཡང་གཏམ་རྒྱུད་དེའི་ནང་གི་སྙན་ངག་གི་དཔེ་སྦྱར་རྒྱལ་པོ་རཱ་མ་ཎའི་གཏམ་རྒྱུད་ཀྱི་སྒྱུ་རྩལ་སྐོར་རགས་ཙམ་གླེང་བ།",
    "སྟངས་ཐད་གཏམ་རྒྱུད་ནང་འཛམ་གླིང་ངང་མོའི་རྗེས་སོང་བ།",
    "ཞེས་འཛམ་གླིང་ངང་བ་མོ་དང་།",
    "དཔེ་རྒྱན་སོགས་མཚུངས་ཟླ་བྲལ་བའི་སྙན་ངག་འདི་ལྟ་བུར་མཚོན་ན་གོང་གསལ་ཤོ་ལོ་ཀ་ཕྱེད་ཀ་དེ་དཀར་གཙང་ཁ་བཏགས་ངོས་ཀྱི་ནག་ཐིག་ཕྲ་མོ་ཞིག་ཏུ་མཐོང་ངོ།",
    "འཁྲབ་གཞུང་ནང་གི་མི་སྣ་ཁག་ནི་སྤྱིར་མ་རྩོམ་ནང་གཞིར་བཟུང་གནང་འདུག་ལ་བཅོས་སྒྲིག་གནང་བ་འགའ་ཞིག་སྟེ།",
    "བཀོད་ལེགས་འོད་སྣང་གི་མི་སྣ་རྒྱལ་པོ་གསལ་ལྡན་དང་།",
    "བློན་ཆེན་བློ་གྲོས་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགམཆོག་ཏུ་གསལ་བ་ཡིད་འོང་མའི་ཁོལ་མོ་རྣ་སྐྱིད་ཁ་སྣོན་མཛད་པ་ནི་ཤིན་ཏུ་འོས་པ་ཞིག་ཏུ་སྣང་མ་རྩོམ་ནང་བློ་གྲོས་མཆོག་ཏུ་གསལ་བ་སྲིད་པའི་རྒྱན་གྱི་བློན་པོ་ཡིན་པས་གལ་སྲིད་བཀོད་ལེགས་འོད་སྣང་གི་མི་སྣ་བློན་ཆེན་ཁ་སྣོན་གནང་དགོས་ཚེ་མིང་གསར་པ་ཞིག་འདོགས་གནང་མཛད་ན་འཁྲུལ་གཞི་ཡོང་བའི་སྐྱོན་སེལ་ཐུབ་སྙམ་མོ།",
    "ཚང་པའི་བློ་ལྡན་སོགས་ཡོད་མོད་འོན་ཀྱང་བཅོས་སྒྲིག་པས་འཁྲབ་གཞུང་ནང་ལྷ་ལས་ཕུལ་བྱུང་དང་།",
    "ད་ནི་གཤམ་དུ་གཏམ་བརྗོད་ཟློས་གར་གྱི་འཁྲབ་གཞུང་ཡིད་འོང་མའི་ནང་གི་འཁྲབ་ཚན་རེ་རེ་བཞིན་མང་ཉུང་ཚིག་ལ་བསྡུས་ནས་དཔྱད་པར་བྱ་སྟེ།",
    "བཀོད་ལེགས་འོད་སྣང་རྒྱལ་ཁབ་ཀྱི་སྲས་མོ་ཡིད་འོང་མ་སྣང་བ་འབུམ་ལྡན་རྒྱལ་ཁབ་ཀྱི་རྒྱལ་སྲས་ལྷ་ལས་ཕུལ་བྱུང་ཞེས་པའི་བཙུན་མོར་སྟེར་རྒྱུ་དམ་དུ་བཅས་ཟིན་མོད།",
    "སྣང་བ་འབུལ་ལྡན་རྒྱལ་ཁབ་ཀྱི་དམག་དཔུང་གིས་མྱ་ངན་ཐང་ཆེན་ནས་ཡིད་འོང་མ་སོགས་འཕྲོག་པ་ནི་བཙན་འཕྲོག་མ་ཡིན་པར་རྐུན་པོའི་ལག་ནས་རང་ནོར་འཕྲོག་པ་དང་འདྲ་ལ་མཐར་སྲིད་པའི་རྒྱན་གྱིས་དཔུང་ཆེན་བཤམས་ནས་སྣང་བ་འབུལ་ལྡན་ཕམ་པར་བཟོས་ཏེ་ཡིད་འོང་མ་རྒྱལ་སྲས་གཞོན་ནུའི་བཙུན་མོར་བསུས་པ་ནི་ཡ་རབས་ཚུལ་ལྡན་མི་སྣ་གཞོན་ནུ་ཟླ་མེད་གཙོ་བོར་གྱུར་པའི་སྲིད་པའི་རྒྱན་གྱི་རྒྱལ་བློན་རྣམས་ཀྱི་གཤིས་ཀའམ་བྱ་སྤྱོད་དང་མི་མཐུན་པར་སྣང་།",
    "དེར་བརྟེན་འཁྲབ་གཞུང་ཡིད་འོང་མའི་བཅོས་སྒྲིག་པས་སྟོང་ཆ་དེ་ཁ་སྐོང་གནང་བས་མ་རྩོམ་སྔར་བས་ཆེས་ལེགས་སུ་སོང་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགའདུག་པ་ནི།",
    "དེས་ན་སྔོན་འགྲོའི་འཁྲབ་ཚན་ཐུང་ཐུང་འདིས་ཤིན་ཏུ་མཛེས་པའི་ཞལ་ཐང་གི་ཞལ་ཁེབས་དལ་བུས་ཕྱེ་བ་བཞིན་འཁྲབ་གཞུང་ཧྲིལ་པོ་ལེགས་གྲུབ་ཡོང་རྒྱུའི་ལམ་བདེ་པོ་ཞིག་བསྟན་འདུག་གལ་ཏེ་བཅོས་སྒྲིག་པའི་བློ་གྲོས་དེ་ཁབ་ཀྱི་རྩེ་ལྟར་རྣོ་པོ་དེ་འདྲ་ཞིག་མེད་ན་མ་རྩོམ་ལ་མཁོ་བའི་སྟོང་ཆ་དེ་གཏན་ནས་མཐོང་མི་སྲིད་པས་འཁྲབ་གཞུང་ཡིད་འོང་མའི་བཅོས་སྒྲིག་པ་རྣམས་ནི་བླང་དོར་གྱི་གནས་ལ་མི་རྨོངས་པ་དང་།",
    "སྒྱུ་རྩལ་གྱི་མྱོང་བས་ཕྱུག་པ་ཐུན་མོང་མ་ཡིན་པའི་བློ་རྩལ་དང་རྩོམ་རྩལ་ལ་གཞན་དྲིང་མི་འཇོག་པ་ཞིག་ཡིན་པར་གདོན་མི་ཟའོ།",
    "རྒྱལ་པོའི་བཀའ་བཞིན་ཕྱོགས་སོ་སོཪ་མངགས་པའི་ཕོ་ཉ་རིམ་གྱིས་འབྱོར་མཚུངས་མེད་བློ་གྲོས་ལྡན་ཕུད་ན་ཡང་རྒྱལ་སྲས་ལ་འོས་པའི་བཙུན་མོ་ཞིག་མ་རྙེད་པའི་སྐབས་དེར་འབངས་ཁོལ་གྱིས་བློན་ཆེན་པད་མའི་མྱུ་གུའི་བུ་མོ་མཛེས་སྡུག་མེ་ཏོག་རྒྱལ་སྲས་ཀྱི་བཙུན་མོར་སྤྱན་བསྟར་ཞུས་པ་ལ་ཡབ་རྒྱལ་པོའང་ཅུང་མོས་པའི་སྐབས་དེར་བཀོད་ལེགས་འོད་སྣང་རྒྱལ་ཁབ་ཕྱོགས་སུ་བསྐྱོད་མཁན་བློན་པོ་མཚུངསམེདབློ་གྲོས་ལྡན་འབྱོར་ཏེ་ཡིད་འོང་མའི་མཚར་སྡུག་གི་ཡོན་ཏན་བརྗོད་ཅིང་ཡིད་འོང་མས་ཕྱག་མདའ་བསྐུར་བའི་དོན་ཡབ་རྗེ་རྒྱལ་པོས་མ་རྟོགས་པས་ཞི་དྲག་བློན་གྱིས་ཕྱག་མདའི་དོན་བཀྲལ།",
    "འཁྲབ་ཚན་འདིའི་ནང་མ་རྩོམ་དུ་མི་གསལ་བའི་བརྗོད་བྱ་གསར་པ་སྟེ་བློན་ཆེན་པད་མའི་མྱུ་གུ་དང་འབངས་ཁོལ་གཉིས་ནང་གྲོས་ངན་ཇུས་བཤམས་ཏེ་མཛེས་སྡུག་མེ་ཏོག་གཞོན་ནུ་ཟླ་མེད་ཀྱི་བཙུན་མོ་བྱེད་རྒྱུའི་ཆེད་དུ་ཐབས་བརྒྱ་ཇུས་སྟོང་བྱེད་པ་ནི་འཁྲབ་གཞུང་ཧྲིལ་པོའི་ནང་གི་འགལ་བའི་ས་བོན་དང་མཐར་བརྩེ་གདུང་གི་སྐྱོ་ཤས་ཆེ་བའི་རྒྱུ་རུ་སོང་བས་བརྗོད་བྱ་དེ་ནི་འཁྲབ་གཞུང་ཡིད་འོང་མའི་ནང་གི་གཙོ་བོའི་གཙོ་བོར་མངོན།",
    "དོན་དེ་སྒྲུབ་པར་ང་ཚོས་ས་ཐག་རིང་པོར་ཕོ་ཉ་མངགས་དགོས་དོན་མི་འདུག་རྒྱལ་ཁབ་གཞན་ལ་གཡུལ་བཤམས་ཏེ་མི་བསད་རྟ་སྒྱེལ་བྱེད་དགོས་དོན་མི་འདུག་ལ་ཡུལ་གྱི་ལྷ་ཀླུ་གཞི་བདག་ཀྱང་གསོལ་དགོས་དོན་མི་འདུག་རང་ཅག་སྲིད་པའི་རྒྱན་ལ་རྒྱལ་སྲས་གཞོན་ནུ་ཟླ་མེད་སྐུ་བལྟམས་པ་དང་དུས་མཚུངས་གླང་པོ་ཆེ་དང་།",
    "རྟ་མཆོག་མ་ཧེ་ལ་སོགས་པར་མཆོག་ཏུ་གྱུར་པའི་ཕྲུ་གུ་མང་པོ་བྱུང་བའི་སྐབས་དེར་རང་རེའི་བློན་ཆེན་པད་མའི་མྱུ་གུའི་ལྷ་ལྕམ་ལ་ཡང་སྲས་མོ་མཛེས་སྡུག་མེ་ཏོག་ཞུ་བ་ཞིག་འཁྲུངས་ཡོད་པས་གུས་པས་བསམས་ན་དེ་རིང་རྒྱལ་བློན་ལྷན་འཛོམས་ཀྱི་ཐོག་ལ་སྲས་མོ་མཛེས་སྡུག་མེ་ཏོག་གདན་དྲངས་ཏེ་མི་བབས་སྤྱན་ཞུ་ཞིག་གནང་ན་དེ་ནི་དོན་ལ་གནས་པ་ཞིག་འདུག་ཅེས་སྨྲས་པ་ལ་ཞིབ་ཏུ་བརྟག་ཚེ་ཁ་ཐུག་ཚ་དྲགས་པའི་སྐྱོན་ཞིག་སྣང་།",
    "འཛམ་གླིང་ན་འགྲན་ཟླ་དང་བྲལ་བའི་གཞོན་ནུ་ཟླ་མེད་ཀྱི་བཙུན་མོ་ནི་ཕྱོགས་གང་ཐད་ནས་ཀྱང་ཟླ་མེད་པ་ཞིག་ཡོད་དགོས་པ་ལས་སྤྱིར་བཏང་ཞིག་གིས་གཏན་ནས་ཡོང་ཐབས་མེད་ན་དེ་འདྲ་ཡིད་ལ་བསམས་ཀྱང་ཐབས་ཀྱིས་སམ་ཡང་ན་དལ་བུ་དལ་བུས་ཞུ་བ་ལས་རྒྱལ་པོར་ཁ་ཐུག་ཏུ་ཞུ་བར་མི་སྤོབས་པ་མཁྱེན་གསལ་ལྟར་རོ།",
    "སྙན་པའི་གཏམ་གྱིས་ཡིད་འོང་མ་རྒྱལ་སྲས་གཞོན་ནུ་ཟླ་མེད་ཀྱི་བཙུན་མོར་གནང་རྒྱུའི་རེ་བ་ཞུས་ཀྱང་རྒྱལ་པོས་སྔར་གྱི་དམ་བཅའ་འགྱུར་བ་མེད་པར་ཡིད་འོང་མ་སྣང་བ་འབུམ་ལྡན་དུ་གཏོང་རྒྱུའི་ཐག་བཅད།",
    "སྲིད་པ་གཞོན་ནུས་གསང་ཐབས་ཀྱིས་ཡིད་འོང་མའི་བསྟི་གནས་སུ་བསྐྱོད་ནས་གཞོན་ནུ་ཟླ་མེད་ཀྱིས་གནང་བའི་ཕྱག་མདའ་ཕུལ་ཞིང་སྲིད་པའི་རྒྱན་དུ་ལྐོག་བྲོས་དགོས་རྒྱུའི་བྱ་ཐབས་བཏོན་པར་ཡིད་འོང་མས་བསམ་བཞིན་དུ་མོས་མཐུན་བྱུང་སྟེ་མཚན་མོ་དེ་རང་དུ་སྲིད་པའི་རྒྱན་གྱི་ཕྱོགས་སུ་བསྐྱོད་པའོ།",
    "སྤྱིར་འཁྲབ་ཚན་འདིའི་གོ་རིམ་བཀོད་སྒྲིག་གནང་སྟངས་ལེགས་ཙམ་བྱུང་ཡོད་ཀྱང་འཁྲབ་ཚན་འདིའི་མིང་ལས་ལ་ཕྱོགས་པ་ཞེས་པ་མ་གཞི་རྣམ་དབྱེ་གཉིས་པའི་ཁོངས་སུ་ཡིན་མོད་ཀྱང་ཐ་སྙད་འདི་དེ་ཙམ་མི་སྙན་ལ་ཁྱབ་ཀྱང་མི་ཆེ་བ་ཞིག་ཏུ་མཐོང་།",
    "དེ་ཕྱིར་གཏམ་བརྗོད་ཟློས་གར་ཞེས་པ་ནི་གཙོ་བོ་སྐད་ཆའི་སྒྱུ་རྩལ་ཞིག་ཡིན་པས་གཏམ་བརྗོད་ཟློས་གར་ནང་གི་སྐད་ཆ་ཡིན་ཕྱིན་གཙོ་ཕལ་ལ་མ་ལྟོས་པར་ཚིག་རེ་རེ་བཞིན་སྙན་ཞིང་གསལ་ལ་གོ་བདེ་བ་ཞིག་ངེས་པར་དུ་ཡོད་དགོས་སྙམ།",
    "འཁོར་དང་བཅས་པ་བཀོད་ལེགས་འོད་སྣང་གི་རྒྱལ་ཁབ་ནས་ལྐོག་བྲོས་བྱས་ཏེ་ཉིན་མཚན་ལྔ་སོང་རྗེས་མྱ་ངམ་གྱི་ཐང་ཆེན་ཞིག་ཏུ་སླེབས་ཤིང་།",
    "དེའི་ཚེ་རྒྱལ་སྲས་ཟླ་མེད་ཀྱིས་བདག་གི་ཡིད་ཀྱི་རྟེན་ས་གཅིག་པུ་ཡིད་འོང་མར་ཉམས་ཉེས་འདི་ལྟ་བུ་བྱུང་དུས་ང་སྡོད་ཐབས་བྲལ་སོང་ཞེས་ཡབ་རྒྱལ་པོཪ་དགོངས་སྐོར་མ་ཞུས་པར་རྒྱལ་རྔ་བརྡུངས་ཏེ་སྣང་བ་འབུམ་ལྡན་ཕྱོགས་སུ་དཔུང་ཆེན་བཤམ་རྒྱུའི་གྲབས་བྱས།",
    "འོན་ཀྱང་རྒྱལ་སྲས་ཟླ་མེད་ཀྱིས་ཡིད་འོང་མ་ལ་བཅངས་པའི་བརྩེ་སེམས་ནི་གང་གིས་ཀྱང་འགོག་ཏུ་མེད་པས་གྲོགས་མེད་གཅིག་པུར་ཕྱི་ལ་ཐོན་པའོ།",
    "མ་རྩོམ་ནང་སྐབས་འདིར་འབངས་ཁོལ་སྣང་བ་འབུམ་ལྡན་གྱི་དཔུང་དང་མཉམ་དུ་སོང་བ་ལས་སྲིད་པའི་རྒྱན་དུ་ལོག་མེད།",
    "སྲིད་པ་གཞོན་ནུའི་དཔུང་གི་ལྷག་མ་འགའ་ཞིག་ཉམ་ཐག་ངང་སྲིད་པའི་རྒྱན་དུ་འབྱོར་ནས་གནས་ཚུལ་ཇི་བཞིན་ཞུས་པས་རྒྱལ་བློན་ཚང་མས་ཡན་ལག་བཞི་ལྡན་གྱི་དཔུང་ཆེན་བཤམ་རྒྱུར་གྲོས་འཆམ་བྱུང་ནས་གཞོན་ནུ་ཟླ་མེད་དཔུང་གི་གཙོ་བོར་བྱོན་པར་ཡུམ་རྣ་ཆ་འཛིན་གྱིས་བྲལ་མི་བཟོད་པའི་གདུང་བ་ཙམ་ལས་གཞན་འགལ་བ་གང་ཡང་བྱུང་མེད་ཀྱང་འཁྲབ་གཞུང་ཡིད་འོང་མའི་ནང་དེང་གི་གཏམ་བརྗོད་དང་།",
    "དུས་རེ་ཞིག་སོང་བ་ན་བཀོད་ལེགས་འོད་སྣང་ཕྱོགས་ནས་ཡོང་བའི་མི་འགའ་ཞིག་གི་ངག་ལས་ཡབ་རྒྱལ་པོ་གསལ་ལྡན་དང་ཡུམ་ཟླ་འོད་མས་ཡིད་འོང་མའི་དོན་དུ་སེམས་ཁྲལ་ཆེན་པོ་གནང་བཞིན་ཡོད་པ་ཡིད་འོང་མས་གསན་རྗེས་རྒྱལ་སྲས་ལ་དགོངས་ཞུས་ཐོག་ཕ་ཡུལ་བཀོད་ལེགས་འོད་སྣང་ཕྱོགས་སུ་བསྐྱོད་པ་དང་།",
    "དེའི་རིང་མཛེས་སྡུག་མེ་ཏོག་གིས་གཞོན་ནུ་ཟླ་མེད་བསླུ་བར་སེམས་ཀྱང་འདོད་པ་མ་བསྒྲུབ་པའི་གནས་ཚུལ་བཀོད་ཡོད།",
    "གལ་ཏེ་མ་རྩོམ་ལྟར་ཡིད་འོང་མ་རང་གིས་དགོངས་ཞུས་ཐོག་ཕ་ཡུལ་དུ་བསྐྱོད་པ་ཡིན་ན་གནས་སྐབས་འགལ་བའང་མཚམས་ཆད་པས་འགལ་བ་གསར་པ་ཞིག་མ་སླེབས་པར་རྩོམ་བྲོ་བ་མེད་པར་གྱུར་སྲིད།",
    "འཁྲབ་ཚན་འདིའི་ནང་ཡུམ་རྣ་ཆ་འཛིན་དགོངས་པ་རྫོགས་ནས་ཞག་བཞི་བཅུ་ཞེ་དགུ་སོང་བའི་འདས་མཆོད་ཀྱི་ཉིན་སྔོན་མ་འབངས་ཁོལ་བཀོད་ལེགས་འོད་སྣང་རྒྱལ་ཁབ་ནས་འབྱོར་བ་དང་།",
    "འདས་མཆོད་ཉིན་འབངས་ཁོལ་གྱིས་ཡིད་འོང་མ་དང་སྲིད་པ་གཞོན་ནུ་གཉིས་ངན་པ་ལག་འབྲེལ་བྱས་ཏེ་ཁོང་གཉིས་བཀོད་ལེགས་འོད་སྣང་གི་ཁབ་ཏུ་བཞུགས་ཤིང་།",
    "གནས་ཚུལ་དེ་སྔ་ས་ནས་ཡོད་ཚུལ་སོགས་རྫུན་གྱི་འཁོར་ལོ་བསྐོར་བ་མ་ཟད་ཡིད་འོང་མའི་ས་ནས་ཐོད་རྒྱན་རྡོ་རྗེ་ཕ་ལམ་བརྐུས་པ་ལག་ཐོག་ཏུ་བསྟན་རྒྱུ་ཡོད་པ་རྒྱལ་བློན་ཕལ་མོ་ཆེ་གཟུགས་མེད་གྲིབ་མའི་རྫུན་གཏན་དེར་རེ་ཞིག་ཡིད་ཆེས་པ་དང་།",
    "འོན་ཀྱང་ཕྱིས་སོང་བས་ཡིད་འོང་མ་འགྱོད་སེམས་དང་བློ་ཕམ་རབ་ཏུ་སྐྱེས་ནས་དེ་མ་ཉིད་དུ་འཇིགས་རུང་གི་ནགས་ཁྲོད་དུ་རྒྱལ་སྲས་གཞོན་ནུ་ཟླ་མེད་འཚོལ་བར་བསྐྱོད་པའོ།",
    "དེ་ནས་མཇུག་བསྡུའི་ཚིགས་བཅད་ནང་ཡིད་འོང་མས་ངལ་བ་ཁྱད་བསད་ཀྱིས་དབེན་པའི་ནགས་ཁྲོད་དུ་རྒྱལ་སྲས་ཟླ་མེད་བཙལ་ཡང་རེ་འབྲས་མ་སྨིན་པར་མཐར་དྲན་པ་ཐོར་ཏེ་འགྱེལ་ནས་ཞུགས་པའི་ཚེ་རྒྱལ་སྲས་གཞོན་ནུ་ཟླ་བཅད་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགམེད་ཀྱིས་གཟིགས་ཏེ་སྐྱོབ་པར་བརྩམས་ཀྱང་རྒྱལ་སྲས་ཟླ་མེད་ཀྱི་ཞལ་དཀྱིལ་མཇལ་བའི་སྐལ་བ་དང་བྲལ་བ་སྟེ་སྐུ་ཚེའི་འཕེན་པ་རྫོགས་ནས་སྐྱོ་ཤས་ཆེ་བའི་བརྩེ་གདུང་གི་ཟློས་གར་དེ་མཇུག་བསྡུས་པའོ།",
    "འབྱོར་བ་ལྡན་པའི་རྒྱལ་སྲིད་འདི་མེ་འོབས་ལྟར་གཟིགས་ནས་ནགས་སུ་གཤེགས།",
    "གཏམ་བརྗོད་ཟློས་གར་དེ་བོད་ལྗོངས་གཏམ་བརྗོད་ཚོགས་པས་སྔ་ཕྱིཪ་བོད་རྒྱ་སྐད་རིགས་གཉིས་ཐོག་ནས་འཁྲབ་སྟོན་ཐེངས་མང་གནང་བར་རྒྱ་ཆེའི་ལྟད་མོ་བ་ཁྲི་འབུམ་མང་པོའི་བསྔགས་བརྗོད་ཐོབ་ཅིང་།",
    "ན་ནིང་ཡུན་ནན་དུ་ཀྲུང་གོའི་གྲངས་ཉུང་མི་རིགས་སྒྱུ་རྩལ་དུས་ཆེན་སྐབས་འཁྲབ་སྟོན་གནང་བར་སྤུན་ཟླའི་མི་རིགས་སྒྱུ་རྩལ་མཁས་པ་ཚོའི་གདེང་འཇོག་དང་བསྔགས་བརྗོད་ཐོབ་ཡོད་པ་སོགས་དགེ་མཚན་འབུམ་གྱིས་ཕྱུག་པར་ཁོ་བོས་གངས་རིའི་ལྗོངས་ཀྱི་ལྟད་མོ་ཀུན་གྱི་མགྲིན་ཚབ་ཞུས་ཏེ་གཏམ་བརྗོད་ཟློས་གར་ཡིད་འོང་མའི་འཁྲབ་གཞུང་རྩོམ་པ་པོ་དང་།",
    "དེ་བཞིན་འབྲེལ་ཡོད་དབུ་ཁྲིད་དང་ལས་རོགས་པ་མཐའ་དག་ལ་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་དང་ཆབས་ཅིག་ཕྱིས་བོད་ཡིག་རང་གི་ཐོག་ནས་བརྩམས་པའི་གཏམ་བརྗོད་ཟློས་གར་སྔར་བས་མང་ཞིང་ལེགས་པ་གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་ཐོན་པའི་སྨོན་འདུན་ཞུའོ།",
    "དཔྱད་པ་གནང་དང་གནང་བཞིན་ལགས་ན་རང་ཅག་བོད་མི་རྣམ་པས་རང་གི་ནོར་བུའི་ནོར་ཉམས་རང་གིས་ཡང་དག་པར་ཆོད་པ་བྱ་རྒྱུ་ནི་གལ་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡིན་པ་སྨོས་ཅི།",
    "དེ་ལས་སྟང་ཁྲིའི་འོག་གི་ཆང་བན་འཁྱེར་ཤོག་དགོངས་སྲིད་ཀྱང་ཤེས་བྱ་ཞེས་པ་ནི།",
    "འོན་ཏེ་དགེ་སློབ་འགའ་ཞིག་གིས་རྒྱུན་གཏན་རིག་པ་འདི་ལ་དོ་སྣང་ཆེར་མ་མཛད་པས་སློབ་ཚན་འདི་ནི་དེ་ཙམ་ཁྲིད་རིན་མེད་པཞིག་རེད་དགོངས་པ་དང་།",
    "ལྷུན་གྲུབ་གད་མོ་ཤོར་ཡོང་ཞེས་པའི་དཔེ་ལྟར་རེད་སྙམ་ནས་ཡིད་གཟབ་བྱེད་ཀྱི་མེད་པ་འདྲ།",
    "ཉེ་བའི་དུས་ཚོད་ནང་རང་དང་འབྲེལ་ཡོད་རྒན་ལགས་རེ་གཉིས་ཀྱིས་ཁོ་བོར་གླིང་སྒྲུང་སྐོར་ལ་དོགས་འདྲི་ཐེངས་ཁ་ཤས་གནང་བྱུང་བ་དེ་དག་ལ་སྐབས་འཕྲལ་རང་གིས་གང་ཤེས་བསམ་པ་རྣམ་དག་གིས་ལྗགས་ལན་ཕུལ་བ་དང་།",
    "སྔར་ནས་ཁ་རྒྱུན་དུའང་གསེར་སྲང་སྟོང་གིས་ཀྱང་མིའི་དགའ་སྤྲོ་མི་ཁུག་ཅེས་ཟེར་བ་དེ་ནི་དོན་དངོས་དང་ཡོངས་སུ་མཐུན་པའི་གཏམ་དཔེ་ཞིག་ཡིན།",
    "རྒན་ལགས་རྣམ་པས་ཐོག་མར་གླིང་སྒྲུང་དུམ་བུ་ཞིག་གསུང་དུས་ནམ་རྒྱུན་གྱི་བཀའ་མོལ་ལྟར་མ་ཡིན་པར་ངག་བརྗིད་ཅིང་དལ་ལ།",
    "ཡང་ན་གཞན་ཞིག་གི་གསུངས་པ་དེ་ཡིན་ནམ་སྙམ་སྟེ་མགོ་བོ་འཐོམས་ངེས་ཡིན།",
    "གཅིག་གླིང་གེ་སར་རྒྱལ་པོ་ཞེས་བྱ་བ་དེ་དངོས་བྱུང་གི་མི་ཞིག་ཡིན་ནམ།",
    "དང་པོ་དེའི་ལུང་གི་སྒྲུབ་བྱེད་ནི།",
    "དཔལ་ལྡན་འཁོར་ལོ་སྡོམ་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགཔ་དང་རྗེ་བཙུན་རྡོ་རྗེ་ཕག་མོའི་གནས་ཁྱད་པར་ཅན་གྱི་ཉེ་འདབས་ཡིན་ཞེས་གསལ་བར་གསུངས་པ་ལྟར་རོ།",
    "མ་འགག་བཟའ་ཀླུ་མོ་གཉིས་ལ།",
    "མ་གཅིག་ལབ་སྒྲོན་ལྕགས་འབྲུག་ལོ་ང་བདུན་གླིང་གི་གེ་སར་ས་སྟག་ལོ་ལྔ་བཅུ་མི་ལ་ལྕགས་འབྲུག་ལོ་ཞེ་བརྒྱད་ཅེས་གསུངས།",
    "ལྷ་ཀླུ་མི་དང་འབྲེལ་བའི་སྤྲུལ་བ་ཞིག་སྟག་གི་མགོ་བོ་སྤྲུལ་གྱི་མཇུག་མ་ཅན།",
    "ད་དུང་ཁོང་གི་གླིང་གེ་སར་རྒྱལ་པོའི་གདུང་རྒྱུད་དམ་རིགས་རུས་ཐད་གླིང་གི་མི་རྒྱུད་ནི།",
    "བོད་མིའུ་ལྡོང་དྲུག་གི་ནང་ཚན་ལས།",
    "སྨུག་པོ་ལྡོང་གི་རིགས་རྒྱུད་རེད།",
    "ཡང་འགའ་རེས་གླིང་གེ་སར་རྒྱལ་པོ་ནི་ཁྲི་སྲོང་ལྡེ་བཙན་རེད་ཟེར་ཡང་ཁྲི་སྲོང་དང་གེ་སར་གཉིས་མིང་དང་།",
    "བོད་ཁ་འཐོར་དུ་སོང་བའི་སྐབས་སུ།",
    "ཕྱོགས་ཀྱི་རྒྱལ་པོ་དག་གིས་བོད་ཀྱི་རྒྱལ་སྲིད་ཉམས་ནས།",
    "གླིང་གི་དཔའ་བརྟུལ་དཔའ་ཐུལ་ཡང་ཟེར་མང་པོ་རང་དང་སེམས་ཀྱི་འཆར་སྒོ་མཐུན་པའི་གྲོགས་སུ་བཀུག་ནས་རྣམ་པར་རྒྱལ་བའི་གཡུལ་ལས་ཤ་སྟག་བྱས་ཏེ།",
    "གེ་སར་སྒྲུང་གི་བརྗོད་བྱ་གཙོ་བོ་ནི་དམག་འཁྲུག་རེད་ཅེས་གསུངས་པ་མ་ཟད་ཁོང་གིས་དམག་འཁྲུག་དེ་དག་ཕྱོགས་བསྡུས་བྱས་ནས་རིགས་གསུམ་ལ་དབྱེ་གནང་ཡང་མཛད་ཡོད།",
    "ཕྱིས་འབྱུང་གི་རྩོམ་རིག་སྒྱུ་རྩལ་གོང་དུ་འཕེལ་བ་ལ་ཡང་ཤུགས་རྐྱེན་གཏིང་ཟབ་མོ་ཐེབས་ཡོད།",
    "རྒྱ་ཡི་ཀྲིག་རྒྱལ་རབས་ཀྱི་དུས་སུ་བྱུང་བའི་སྙན་ངག་འཛམ་གླིང་ན་གྲགས་ཆེ་བ་ཧྲི་ཅིན་ཞེས་པར་འབོད་པའི་ཕལ་མོ་ཆེ་དམངས་གཞས་ཀྱི་ཁོངས་སུ་གཏོགས་ལ་ཁྱད་པར་དེ་ཡི་ཡ་གྱལ་དུ་གྱུར་བ་ཧྥིང་ཞེས་པ་ནི་ཡོངས་རྫོགས་སྐབས་དེའི་དམངས་གཞས་ཡིན།",
    "རང་ཅག་བོད་མི་རིགས་ལའང་གནའ་སྔ་མོ་ནས་སྣེ་མང་ཕུན་སུམ་ཚོགས་པའི་དམངས་གཞས་དང་མགུར་སོགས་གྲངས་ཀྱིས་མི་ལང་བ་ཡོད་པའི་རྨང་གཞིའི་ཐོག་རིམ་བཞིན་སྙན་ངག་འཕེལ་རྒྱས་བྱུང་བ་དང་།",
    "དེས་ན་ང་ཚོས་གངས་ཅན་ཡུལ་དུ་ལུ་གུ་ལགས་སྐྱེས་ཡིན་པའི་གཞས་མ་གཏམ་གྱི་སྒྱུ་རྩལ་དེ་ལ་དཔྱད་པ་ནན་པོ་བྱས་ན་དེང་རབས་ཀྱི་ནང་དོན་ལྡན་པའི་གཞས་མ་གཏམ་གྱི་སྒྱུ་རྩལ་གསར་རྩོམ་བྱེད་དགོས་བྱུང་ཡང་ཕན་ཐོགས་ཤིན་ཏུ་ཆེའོ།",
    "ལྷ་སྒྲུང་གི་སྒྱུ་རྩལ།",
    "ང་ཚོས་དབྱེ་ཞིབ་བྱས་ན་གླིང་སྒྲུང་ནང་གི་མི་སྣ་གཙོ་བོ་མི་ཉུང་བ་ཞིག་དང་ཁྱད་པར་དུ་གླིང་གེ་སར་རྒྱལ་པོ་ནི་མི་ཕྱེད་ལྷ་ཕྱེད་ཀྱི་དཔའ་བོ་ཞིག་དང་།",
    "མི་ལ་ཐུན་མོང་མ་ཡིན་པའི་མཐུ་སྟོབས་དང་དཔའ་རྩལ་ཡོད་པ་དང་།",
    "ཟབ་པའི་མཚོ་མོ།",
    "ཚང་མས་ཧ་ཅང་དགའ་པོ་བྱེད་དོན་ནི་གཙོ་བོ་དེའི་ནང་གི་ལྷ་སྒྲུང་གི་སྒྱུ་རྩལ་ཧ་ལས་དགོས་པ་ཞིག་ཡོད་པའི་རྐྱེན་གྱིས་རེད།",
    "དེ་ཡང་སྒྲུང་མཁན་མང་ཆེ་བས་ཡི་གེ་མི་ཤེས་ཀྱང་སྒྲུང་པོ་ཏི་མང་པོ་ངག་ཐོག་ནས་ཆུ་རྒྱུགས་པ་ལྟར་ཤོད་ཐུབ་པའི་ངོ་མཚར་སྒྲུང་མཁན་གྱི་སྒྱུ་རྩལ་དེ་ལ་རྒྱལ་ཁབ་ཕྱི་ནང་གི་སྐྱེ་བོ་ཀུན་ཧ་ལས་ཤིང་།",
    "ཡང་སྒྲུང་མཁན་ལ་ལས་རང་ཉིད་ནི་དཔའ་ཐུལ་གང་ཞིག་གི་སྤྲུལ་པ་ཡིན་ཟེར་བ་དཔེར་ན།",
    "མགོ་ལོག་གི་སྒྲུང་མཁན་ངག་རིག་གིས་རང་ཉིད་མི་ཆུང་ཁ་བདེའི་སྤྲུལ་པ་ཡིན་ཟེར་བ་དང་།",
    "གླིང་གི་སྐྱེས་པ་རྣམས་ཀྱིས་དགུན་དུས་སུ་ཚ་རུའི་ནང་མ་ཅན་གྱི་ནང་འཇམ་དང་།",
    "སྲམ་གྱིས་མཐའ་རྒྱན་སྤྲས་པའི་ཚར་སློག་དང་གཟིག་ལྤགས་ཀྱི་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགགོང་བ་སྤྲས་པའི་སློག་པ་སོགས་ཕྱི་གོས་སུ་གྱོན།",
