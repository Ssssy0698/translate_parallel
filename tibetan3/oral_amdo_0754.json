    "ང་ཚོས་རིག་པ་བསྒྲིམས་ཏེ་བར་སྟོང་དེ་གསབ་པའི་ཐབས་ལ་འབད་དགོས་པ་ལས་རང་ཉིད་ཀྱི་མོས་པ་ཁོ་ན་དང་།",
    "མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགདེས་ན་སྔོན་ཆད་ཁོ་བོས་བསམ་བློ་ཉལ་ལངས་སྒུར་གསུམ་བཏང་མཐར་གཞས་ཚིག་གསར་རྩོམ་ཐད་ཡིན་མིན་ཆ་མ་འཚལ་བའི་དྲན་འཆར་འགའ་ཞིག་བྱུང་བ་འདིར་གྲོས་མོལ་གྱི་ཚུལ་དུ་བཀོད་པར་བྱ་སྟེ།",
    "གཅིག་མིག་སྔར་བོད་ཡིག་གཞས་ཡིག་རྩོམ་པ་པོ་མང་པོ་ཞིག་ལ་སྲོལ་རྒྱུན་སྙན་ངག་རྩོམ་སྲོལ་གྱི་བག་ཆགས་ཟབ་མོ་ཡོད་པས་དེའི་ཤན་ཞུགས་ཏེ་གཞས་ཚིག་འབྲི་དུས་ཕྱི་ངོས་ཀྱི་ཡུལ་ལ་ཡིད་གཟབ་བྱེད་པ་ལས་ནང་ངོས་ཡུལ་ཅན་གྱི་བརྩེ་དུང་ངམ་ཚོར་འདུ་གསོན་འབྲི་བྱེད་རྒྱུར་ཞན་ཆ་ཞིག་རྒྱུན་འཇགས་སུ་གནས་ཡོད།",
    "དཔེར་ན་གཞས་ཚིག་རྩོམ་པ་པོ་ཞིག་གིས་ས་མཐོའི་དགུན་ཁ་ཞེས་པའི་གཞས་ཚིག་དུམ་བུ་གཅིག་སྟེ།",
    "ཡངས་པའི་ནོར་འཛིན་དཔལ་མོར་མཛེས་རྒྱན་སྤྲས།",
    "དེས་ན་གོང་གསལ་གཞས་ཚིག་དུམ་བུ་དེའི་ནང་གི་ཚིག་སྦྱོར་སྙན་ཞིང་འཇེབས་པ་དང་།",
    "བསིལ་དུས་ཀྱི་རྣམ་པ་ཇི་མ་ཇི་བཞིན་རི་མོའི་ལམ་ནས་གསལ་ཐུབ་པ་སོགས་ནི་སྲོལ་རྒྱུན་སྙན་ངག་གི་བཀའ་དྲིན་ལ་བརྟེན་ནས་ཐོབ་པའི་འབྲས་བུ་ཞིག་ཡིན་པ་དང་།",
    "ལ་ལས་སྙན་ངག་གི་སྲོག་ཅེས་གལ་པོ་ཆེར་བཟུང་གིན་ཡོད་མོད་དེའང་སྙན་ངག་གི་བརྗོད་བྱའི་དོན་ཟབ་མོ་ཞིག་དགོས་པར་གོ་བ་ལེན་པ་ལས་ཡུལ་ཅན་གྱི་དུང་སེམས་འབྲི་དགོས་པར་ངོས་འཛིན་ཧ་ཅང་ཉུང་།",
    "བདག་གི་སྐྱེད་མ་བགྲེས་མོའི་དབུ་སྐྲ་དྲན།",
    "ཆུ་མཐོང་ན་ཆུ་རྐྱང་པ་འབྲི་བའི་སྲོལ་ནས་གོམ་པ་གང་མདུན་དུ་སྤོ་ཐུབ་ཀྱང་དེ་ལ་དགེ་མཚན་གོམ་པ་གང་ཡོད་སྙམ་མོ།",
    "ཡང་འགའ་རེས་གཞས་ཚིག་ཚང་མ་གླུ་བརྒྱ་དབྱངས་གཅིག་གིས་ཡར་བསྟོད་ན་འཚང་ཁ་ཤིག་ཤིག་གིས་བསྟོད་པ་དང་།",
    "དེས་ན་སྐབས་འགར་རྒྱ་ཆེའི་ལྟད་མོ་བ་རྣམས་ལའང་རང་གིས་བྲིས་པའི་གཞས་ཚིག་དེར་མཉམ་དུ་བསམ་གཞིགས་བྱ་རྒྱུའི་གོ་སྐབས་ཤིག་སྤྲོད་ཐུབ་ན་གཞས་ཚིག་དེའི་ནུབ་པ་དེ་བས་ཁྱབ་ཆེ་རུ་འགྲོ་བར་ངེས།",
    "ཡིད་འོང་མཛེས་ལྡན་ལྷ་མོས།",
    "དགོངས་པ་བཞེས་དང་མཛེས་ལྡན་ལྷ་མོ་ལགས།",
    "ཞེས་བྲིས་ན་དེར་བརྗོད་དོན་ཟབ་མོ་ཡོད་ཀྱང་ཐད་འབྲི་མ་བྱས་པར་གཞན་ལ་བསམ་གཞིགས་བྱ་རྒྱུའི་དྲི་ཚིག་བཀོད་ཡོད་པས་གོང་གི་གཞས་ཚིག་དང་བསྡུར་ན་སྒྱུ་རྩལ་གྱི་རིན་ཐང་ཆེ་ཆེར་ལྡན་ཡོད།",
    "མི་རིགས་གཞན་གྱི་གཞས་ཚིག་རྩོམ་པ་པོ་མཁས་པ་ཚོས་གཞས་ཚིག་གི་རྒྱབ་ལྗོངས་ཡག་པོ་ཞིག་འབྲི་རྒྱུའི་ཐད་ནུས་པ་གང་ཡོད་འདོན་གྱིན་ཡོད།",
    "དེང་ཆར་བོད་ཀྱི་སྲོལ་རྒྱུན་སྙན་ངག་ལ་གཉེན་ཉེ་གསར་པ་རང་མོས་སྙན་ངག་ཅེས་པ་ཞིག་རྙེད་པ་དེས་སྙན་རྩོམ་འཕེལ་རྒྱས་འགྲོ་བར་ནུས་པ་ཧ་ཅང་ཆེན་པོ་ཐོན་དང་ཐོན་མུས་ལགས་ན་ང་ཚོའི་སྲོལ་རྒྱུན་གཞས་ཚིག་ལའང་གཉེན་ཉེ་གསར་པ་རང་མོས་གཞས་ཚིག་ཅིག་རྙེད་ན་ཅི་མ་རུང་།",
    "ཨ་ཅང་ཀུ་རེ་ཞུས་པ་ཡིན་ཏེ།",
    "ང་ཚོས་རང་མོས་སྙན་ངག་ལྟར་ཚིག་རྐང་དང་ཚེག་བར་གྱི་བཀག་རྒྱ་ལས་ཐར་བའི་གཞས་ཚིག་གསར་རྩོམ་བྱེད་པའི་ཐབས་ལམ་ཞིག་བཙལ་ན་རང་ཅག་བོད་ཡིག་གི་གཞས་ཚིག་དེ་བས་ཀྱང་ཕུན་སུམ་ཚོགས་སུ་འགྲོ་ངེས་ཡིན།",
    "མེ་ཏོག་གུར་ཁང་གི་དབུས་སུ།",
    "ངོ་མཚར་ཆ་འགྲིག་དང་ཆ་འགྲིག་གི་ཞབས་བྲོ།",
    "དེ་ལྟར་ཁོ་བོས་གང་དྲན་རི་མོར་བཀོད་པ་འདི་ལ་འགལ་འཁྲུལ་ཅི་མཆིས་འབྲེལ་ཡོད།",
    "སྙན་ངག་གསར་རྙིང་གི་ཐོག་མའི་གཤིབ་བསྡུར།",
    "ཏུན་ཧོང་གི་ཡིག་རིགས་ཚིག་རྒྱན་རིག་པའི་སྒོ་འབྱེད།",
    "རྡོ་རྗེ་དང་ཐུང་ཅིན་ཧྭས་མཛད་བོད་རིགས་ཀྱི་མིང་གི་སྐོར་ཅུང་ཟད་གླེང་བ།",
    "དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་ལས་བོད་མིའི་རྒྱལ་ཁམས་སུ་གྱུར་ཏེ།",
    "མོན་རྫུ་ནག་པོ་ཁྱིའི་རྔ་ལྗང་ཅན་དང་བཞིར་དབྱེར་བ་བྱུང་ངོ་ཞེས་ཐོག་མའི་རུས་ཆེན་བཞི་ཡོད་པར་གསུངས་པ་དང་།་",
    "འབོད་མཁན་མེད་ཀྱང་བར་སྐབས་ཤིག་ན་བོད་རིགས་བློ་མཐུན་རེ་གཉིས་ཀྱིས་རང་གི་མིང་ངོས་ཀྱི་ཐོག་མར་རྒྱ་རིགས་ཀྱི་རུས་མིང་སྦྱར་ནས།",
    "བོད་རིགས་ཀྱི་མིང་གི་སྐོར་ཅུང་ཟད་གླེང་བ།",
    "འདི་ནི་གཙོ་བོ་བོད་ཀྱི་བཙན་པོ་རིམ་བྱུང་གི་མཚན་འདོགས་སྲོལ་ཞིག་སྟེ།",
    "ལྡེ་བརྒྱད་དང་འོག་གི་བཙན་ལྔ་དག་ཀྱང་ཐོག་མའི་མཚན་གྱི་ཟུར་དྲས་ནས་རྗེས་མ་རྣམས་ལ་གསོལ་བ་ལས་མ་འདས་སོ།",
    "ཡང་ན་འགྲན་ཟླ་བྲལ་བའི་མཁས་ཆེན་དམ་པ་རེ་གཉིས་ལ་ཆེད་དུ་དེའི་ཡོན་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགཏན་གྱི་ཆེ་བ་བརྗོད་པའམ་དད་གུས་ཀྱིས་བསྔགས་པ་བརྗོད་པའི་མཚན་ཆེན་པོ་འདོགས་སྲོལ་ཡོད་པ་ནི་དཔེར་ན།",
