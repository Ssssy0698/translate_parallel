    "ཡག་པོ་བྱུང་འདུག་བསམ་ན་སྐྱིད་པ་ཡོད།",
    "བརྩེ་བ་བྱེད་ཀྱི་འདུག་བསམ་པ་ཡིན་ན།",
    "བརྩེ་བ་འདོར་གྱི་མི་འདུག་དེང་སྐབས་འཛམ་བུའི་གླིང་འཁྲུག་ཆ་དོད་པོ་འདིའི་ནང་ལ།",
    "འོན་ཏེ་དེ་ལ་ཐུབ་ཚོད་ཤོད་མཁན་ཞིག་འདུག་ན།",
    "ཞེས་ཁྱེད་རང་ཕུན་སུམ་ཚོགས་པ་དང་བདེ་སྐྱིད་འདོད་ན་ནི།",
    "བོད་རིགས་ནང་ཁ་ཤས་ཀྱིས་ཆང་མང་པོ་འཐུང་བཞིན་འདུག་སྐྱིད་སྐྱིད་ལྟ་བུ་བྱས་ནས་ཆང་ཕྲན་བུ་འཐུང་བ་ལ་འགལ་བ་མེད་ཀྱང་།",
    "ཆང་འཐུང་ན་མི་འགྲིག་པར་གསུངས་འདུག་སྟོན་པ་ལ་སྐྱབས་སུ་མཆི་མཁན་སྐྱ་སེར་སུ་འདྲ་ཞིག་ཡིན་ནའང་།",
    "ཡག་པོ་མི་འདུག་རྒན་གཞོན་སུ་ཡིན་ནའང་ཡིད་གཟབ་བྱེད་དགོས།",
    "ཐ་མག་འཐེན་ན་དགོས་པ་མི་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "མི་གཞན་དགའ་བས་རང་ལ་དངོས་སུ་ཕན་གནོད་ཡོང་རྒྱུ་གང་ཡང་མི་འདུག་ཅིང་།",
    "ཞེས་གལ་ཏེ་ཕ་རོལ་པོའི་རྒྱུད་ལ་དགའ་བ་སྐྱེས་པའི་དགའ་བ་དེའི་བགོ་སྐལ་ང་ལ་ཐོབ་རྒྱུ་ཅང་མི་འདུག་ནའང་།",
    "ཕ་རོལ་པོའི་རྒྱུད་ལ་སེམས་དགའ་བདེ་སྐྱེས་སྐབས་དགའ་པོ་བྱུང་འདུག་སྙམ་ནས།",
    "དེ་ནས་ཀླུང་ལ་མར་འབབ་ཡོང་མཁན་དེ་འདྲ་ཡོང་གྲབས་བྱེད་ཀྱི་མི་འདུག་གམ།",
    "དེ་ནུས་པ་ཆེན་པོ་འདུག་གམ།",
    "ཞེས་དེ་བཞིན་དུ་སྒེར་གྱི་ཆ་ནས་ཀྱང་ང་རང་ལྟ་བུར་ཆ་བཞག་ན།",
    "སྐོར་བར་འགྲོ་མཁན་མི་དེས་ཁྱེད་རང་གང་བྱེད་ཀྱི་ཡོད་ཅེས་དྲིས་པ་དང་།",
    "མཐའ་གཅིག་ཏུ་ཕན་སེམས་དགོས་པ་མི་འདུག་ཅེས་གསུངས།",
    "ངས་འདི་ལ་དྲིན་ལན་འཇལ་དགོས་པ་གང་ཡང་མི་འདུག་ཅེ་ན།",
    "དངོས་གནས་ཡིན་པའི་བཟོ་ལྟ་བུ་ཞིག་མི་འདུག་གམ།",
    "དེ་དྲིན་ཆེན་དུ་བསྒྲུབས་ན་དམིགས་པ་གཞན་བདེ་བླག་ཏུ་འགྲུབ་པའི་དགེ་མཚན་དཔག་ཏུ་མེད་པ་འདུག་གོ།",
    "ཁྱེད་རང་བདེ་པོ་ཡིན་ནམ།",
    "མི་འགྲིག་པའི་རྙོག་དྲ་དེ་དང་དེ་འདུག་ཅེས་ཕར་ཕྱོགས་དེས་རྙོག་དྲ་ཁོ་ན་བཤད།",
    "སྐྱེ་རྒ་ན་འཆི་འདོད་ཀྱི་མི་འདུག་ན་སྐྱེ་བའི་རྒྱུན་གཅོད་དགོས།",
    "རྣལ་འབྱོར་ལུས་ཀྱི་རྩ་ན་གདའ།",
    "གཤིས་ཀ་ཕྲན་བུ་འགྱུར་བ་འགྲོ་བཞིན་འདུག་རྣམ་པར་ཤེས་པ་ནང་གསེས་ཕན་ཚུན་ལྟོས་ནས་འགྱུར་བ་འགྲོ་རྒྱུ་ཡོད་པ་དེ་ལྟ་བུའི་རིགས་ལ་ལྟོས་པའི་རིགས་པ་ཞེས་བརྗོད་པ་ཡིན།",
    "ལེའུ་དགུ་པའི་འགྲེལ་པ་ཡིན་ནམ་འགྲེལ་པ་ཁ་ཤས་ཀྱི་ནང་འདིར་སྐབས་དང་མ་འབྲེལ་བས་ལྷད་བཅུག་པར་གསུང་མཁན་ཡང་འདུག་ཞིབ་པར་བསམ་གཏན་གྱི་ལེའུར་བྱུང་ཡང་།",
    "དབུགས་ཀྱང་གཏོང་ཐུབ་ཨེ་ཡོང་སྙམ་པ་ཞིག་བྱེད་ཀྱི་འདུག་ཡང་།",
    "བདག་ནི་མ་ཡི་མངལ་དུ་ཟུག་རྔུ་སྐྱེ་བའི་ཆེད་དུ་སྐྱེ་བ་ལེན་པ་ཙམ་ཞིག་མ་གཏོགས་དགོས་པ་གང་ཡང་མ་བྱུང་བ་ཡིན་འདུག་གོ།",
    "དེ་ལྟར་མིན་པ་འཕྲལ་དུ་བདེ་བ་ཡོད་ནའང་ཕུགས་སུ་མི་ཕན་པ་ཞིག་འདུག་ན་དེ་བྱེད་མི་རུང་སྟེ།",
    "ཏེ་ནུས་པར་འདུག་གམ་མི་འདུག་ནུས་སམ་མི་ནུས་བརྟགས་ནས་བརྩམ་མམ་ཡང་ན་མི་བརྩམ་པར་བྱ་ཞིང་།",
    "འདི་ལྟ་བུའི་བརྩོན་པའི་སྟོབས་བསྐྱེད་ནས་ངས་སྒྲུབ་ནུས་སྙམ་པ་དེ་ལ་ནུས་པའི་ང་རྒྱལ་ཞེས་གསུངས་འདུགགཞན་དག་དམན་པའི་ལས་བྱེད་ན།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
    "ཞེས་བདག་ནི་བྱིས་པ་རྣམས་དང་འགྲོགས་པས་རྙེད་བཀུར་སྙན་གྲགས་བྱུང་ན་རང་ཉིད་ལ་ཕན་ཐོགས་འདུག་བསམ་པའི་སྙེམས་པའམ་ཁེངས་དྲེགས་འཆང་ན།",
    "ང་རང་ཤི་བའི་སྐབས་ལ།",
    "རྙེད་པ་ཅན་རྒྱུ་ནོར་ལོངས་སྤྱོད་ཡོད་པ་ཞིག་ཡིན་ནའང་འགྲིག་མི་འདུག་ཅེས་མི་སྙན་པ་བརྗོད།",
    "རུས་གོང་འདི་དང་ཁྱད་པར་རྩ་བ་ནས་མི་འདུག་སྙམ་པའི་བསམ་བློ་བཏང་སྟེ་ལུས་ལ་ཞེན་ཆགས་སྤོང་དགོས་སོ།",
    "དེས་ན་གེགས་བྱེད་མཁན་ལྟ་བུའི་མཛའ་བོར་གཙིགས་ཆེན་པོ་བྱས་ཏེ་ཆགས་རྒྱུ་ཅི་ཡང་མི་འདུག་པས་ད་ལྟ་ནས་ཆགས་ཞེན་འདོར་དགོས་སོ།",
    "འདུ་འཛིས་དབེན་པ་ཞེས་པ་སོ་སོའི་འདུག་གནས་དེའི་ནང་སྡོད་ཚུགས་པོ་བྱས་ནས་བསྡད་ན་དེའི་དོན་ཚང་ཐུབ་པ་ཡོང་།",
    "ཁོང་ཁྲོ་སྐྱེ་ཡུལ་མི་དེ་གང་དུ་འདུག་གམ།",
    "ཡིད་དུ་འོང་བའི་ཆ་གང་འདྲ་ཞིག་འདུག་ཅེས་བཙལ་ན་ལན་རྒྱག་རྒྱུ་ཕལ་ཆེར་མེད།",
    "མི་གཙང་རང་བཞིན་གཞན་གྱི་ལུས།",
    "བདེ་བ་སྐྱེད་ནུས་པ་ཞིག་ཡོད་ན་དེ་ལྟར་བྱེད་དགོས་དོན་མི་འདུག།",
    "དེ་ནས་དེ་ལ་བཟའ་ཚང་འཚོལ་དགོས་པའི་སྡུག་བསྔལ་སོགས་སེམས་ཁྲལ་མཐའ་ཡས་པ་ཞིག་མི་འདུག་གམ།",
    "ཧ་ཅང་ཡག་པོ་བྱུང་འདུག་ཅེས་ལབ་རྒྱུ་བྱུང་།",
    "གཞན་གྱི་བདེ་བས་རང་ལ་ཕན་པ་གང་ཡང་མི་འདུག།",
    "སེམས་འཁུར་བྱེད་དགོས་དོན་གང་ཡང་མི་འདུག་སྙམ་ན།",
    "ཅེས་གསུངས་པ་བཞིན་ནུས་པ་ཆེན་པོ་འདུག།",
    "རང་དོན་གཅིག་པུར་བསམ་བློ་བཏང་བས་དགོས་པ་རླབས་ཆེན་པོ་གང་ཡང་མི་འདུག།",
    "སེམས་སྐྱིད་པོ་མི་འདུག།",
    "ཞེས་རང་ལས་དམན་པ་དང་རང་དང་མཉམ་པ།",
    "ང་རྒྱལ་སྒོམ་ཚུལ་དམིགས་བསལ་ཅན་ཞིག་བསྟན་པ་འདི་སེམས་ལ་ཕན་པོ་འདུག་འདི་མན་ཆད་ཀྱིས་རང་གཅེས་འཛིན་ལ་འཁོན་དུ་བཟུང་ནས་རྩོད་པ་བསྟན་པ་ལ།",
    "བྱས་པ་ཡང་རང་སྐྱོན་དུ་བསྒྱུར་བར་བྱོས་ལ།",
    "ཅེས་ཤི་གསོན་གང་བྱུང་ན་འང་མི་གཙང་བའི་འཕྲུལ་འཁོར་འདི་ཡིས་བདག་ལ་ཕན་ཐོགས་ཅི་ཡང་མི་འདུག།",
