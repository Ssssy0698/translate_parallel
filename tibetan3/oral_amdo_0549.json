    "དབུས་གཙང་གི་གནས་མཆོག་ཕལ་ཆེར་ཞབས་ཀྱིས་བཅགས།",
    "ཕྱག་རྫོགས་ཟུང་འཇུག་གི་ཉམས་ལེན་ཆུ་བོའི་རྒྱུན་བཞིན་བསྐྱངས་པས་རོ་གཅིག་ཆེན་པོའི་རྟོགས་པ་མངོན་དུ་གྱུར།",
    "སྐུ་རིམ་གང་དྲག་གི་བཀའ་བཀོད་གནང་བར་ཞུས་པས།",
    "གཞན་ཡང་ཉིད་ཀྱི་གསུངས་རྣམས་ལ་མཁས་པས་གཟིགས་ན་ཟབ་པ་དང་རྒྱ་ཆེ་ལ་རྒྱུད་དོན་དང་མཐུས་ཤིང་།",
    "དེའང་མཁས་གྲུབ་དམ་པ་ཁོང་གི་གསུང་རྩོམ་ཐམས་ཅད་ནི།",
    "མ་ཟད་དུས་བབ་ཀྱི་དགོས་མཁོར་འོས་སུ་ཆེ་བ་ཐུགས་ཀློང་ནས་བབ་པ་དང་བརྩམས་པ་མ་གཏོགས་མཁས་འདོད་དང་གྲགས་འདོད་ཀྱིས་བརྩམས་པ་གཅིག་ཀྱང་མེད་ཅེས་བདེན་ཚིག་གིས་ཞལ་གྱིས་བཞེས་པ་དོན་ལ་གནས་ཤིང་།",
    "ད་ནི་ཁོ་བོས་རྩོམ་དང་ཆོག་སྒྲིག་སོགས་ཅི་ནས་ཀྱང་བྱེད་མི་ཕོད་བསམ་ནས་ཉལ་ནུབ་ལྷ་ཁང་ཞིག་གི་ནང་དུ་ཕྱིན་ནས་སྔོན་རང་གི་གཏེར་ནས་བཏོན་པ་ཡིན་བསམ་པའི་པུ་སྟི་དང་ད་རུང་འདོན་རྒྱུ་པོད་འགའ་ཤས་ཤིག་ལྷག་འདུག་པས།",
    "ཁྱོད་རང་གི་གཏེར་འདོན་འཕྲོ་རྣམས་ཐོན་ཅིག་ཞེས་ནམ་མཁའ་ནས་སྒྲ་ཞིག་གྲག་པས་རྩོམ་རྣམས་རུང་བའི་བརྡ་རུ་གོ།",
    "རྣལ་འབྱོར་རྒྱུད་སྒྲུབ་ངན་སོང་སྒོ་གཅོད་པ་༡༦༩༡༨༣ཞ་ཟ་",
    "འཆི་ལུགས་དཔག་བསམ་ཤིང་གི་འབྲས་བུ་ས་༣༨༢ནཾ་",
    "ན་མོ་གུ་རུ་དེ་ཝ་ཌཱ་ཀི་ནཱི་སརྦ་སིདྡྷི་ཧཱུཾ།",
    "གནམ་ས་གྲུ་ཀླན་གསུམ་ཕག་མོའི་དཀྱིལ་འཁོར་འདྲ།",
    "ངག་གི་བདེན་ཚིག་འགྲུབ་པ་མ་ཡིན་ཕྱིར།",
    "ལུས་སྦྱིན་བདག་འཛིན་གཅོད་པའི་སྟ་རེ་ཡོད་ ཚ་།",
    "རྣལ་འབྱོར་རྒྱུད་སྒྲུབ་ངན་སོང་སྒོ་གཅོད་ཡོད། ཞ་།",
    "མྱ་ངན་མེད་པའི་ཤིང་གི་བསིལ་གྲིབ་ཡོད་ ཡ་།",
    "ཉོན་མོངས་དུག་ལྔའི་སྒྲིབ་པ་སྤང་བའི་ཕྱིར།",
    "འཆི་ལུགས་དཔག་བསམ་ཤིང་གི་འབྲས་བུ་ཡོད་ ནྀ་།",
    "གསར་རྙིང་བཀའ་གཏེར་རྒྱ་ཆེར་གཟིགས་དང་མངོན།",
    "ཚིག་གི་བརྒྱུད་པ་རྒྱ་ཆེ་གྲངས་མང་ཡང་།",
    "གངས་དཀར་རྩེ་ཡི་སེང་ལྕམ་དཀར་མོ་ཁོ།",
    "བདེ་སྟོང་ཉམས་སྟེར་བཙུན་མོ་རིན་ཆེན་ཡིན།",
    "མེད་ཐབས་མེད་པའི་ཕ་ནོར་རིན་ཆེན་བདུན་། ཕ་རྒན་ཀརྨ་ཆགས་མེད་བདག་གིས་བཞག།",
    "སྲུང་ཞིང་སྐྱོང་བའི་གཉེར་ཁ་ཁྱོད་ལ་གཏད།",
    "མ་གཅིག་དཔལ་ལྡན་ལྷ་མོ་རང་བྱུང་མ།",
    "མ་མོ་རྦོད་གཏོང་དཀྱིལ་འཁོར་ལྷར་བཞུགས་པ།",
    "དཀར་མོ་ཆེན་མོ་ཉི་ཟླའི་ཐོད་ཕྲེང་ཅན།",
    "རྒྱལ་འགོང་དམ་སྲིའི་བར་ཆད་ཁྱོད་ཀྱིས་ཟློག།",
    "ནམ་ཞིག་འཕོས་ཚེ་སྐྱེ་བ་གཞན་དག་གིས།",
    "སྐུ་ཚེ་རྫུ་འཕྲུལ་པད་འབྱུང་ལྟ་བུར་ཤོག་སྤྱན་ཪས་གཟིགས་དང་འགྲོ་དོན་མཉམ་པར་ཤོག།",
    "ཡུམ་ཆེན་ཕག་མོ་དམར་མོ་མཚོན་པའི་མེ་ཕོ་ཕག་གི་ཟླ་བ།",
    "ན་མོ་རཏྣ་གུ་རུ་ཡེ།",
    "རྟ་ཕྱུགས་བྲང་ང་དེ་རིན་བཞག་གྲོང་ལྟག་ཁང་ཆུང་ཕྲ་མོའི་ནང་།",
    "རང་གིས་ཉམས་སུ་མ་བླངས་པའི།",
    "དགོང་མོའི་ཐུན་མཚམས་རེ་རེ་ལ།",
    "མཁས་པ་རྣམས་ཀྱིས་གཟིགས་ཉན་མེད།",
    "རྟོགས་པ་མཐོན་པོས་གཟིགས་ཉན་མེད།",
    "གླེང་གཞིའི་སྐོར་ཏེ་དང་པོའོ། ། ན་མོ་གུ་རུ།",
    "མི་ལུས་ཐོབ་པ་ལན་རེ་ལགས།",
    "ད་རེས་ལོ་བརྒྱ་ཐོག་གཅིག་ཡིན།",
    "ད་རེས་ཤཱཀྱའི་བསྟན་དང་མཇལ་། འཛམ་གླིང་ཡུལ་གྲུ་མང་པོ་ན།",
    "ད་རེས་ཤེས་རབ་རིག་པ་གསལ།",
    "ཕྲ་ཞིབ་ཉམས་ན་གསོ་སྦྱོང་མཛོད་། ལུས་ལ་གཡོག་གི་འདུ་ཤེས་ཀྱིས།",
    "ལྟོ་གོས་ཅི་འབྱོར་ཙམ་རེ་གྱིས།",
    "ཞག་གཅིག་སོང་ནས་མི་གཙང་རྫས།",
    "འཆི་བ་ཀུན་གྱིས་ཤེས་མོད་ཀྱང་།",
    "བརྩོན་འགྲུས་རྒྱ་མཚོ་ད་རེས་རེམ།",
    "ཞེ་སྡང་བསམ་པའི་ཀུན་སློང་གིས།",
    "འབྲིང་གིས་ཡི་དྭགས་གནས་སུ་སྐྱེ།",
    "འབྲིང་གིས་མི་རུ་སྐྱེ་བ་སྟེ།",
    "གཞན་གྱི་བུད་མེད་གཡེམ་ལ་དགའ་། རྫུན་གྱི་རྣམ་སྨིན་དུད་འགྲོ་སྟེ།"
  ]
}