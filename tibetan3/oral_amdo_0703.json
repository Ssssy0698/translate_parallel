    "མདུན་གྱི་རྩིབས་ལ་ཛ་ཁཾ་གཉིས་རེ་རེ་བགོད།",
    "གཡོན་ཐོད་པ་དཀར་པོ་དཀར་ཙེར་རེ་བའི་ནང་ན་ཁྲག་དམར་ཕྱུར་རེ་བ་ཅན།",
    "གཞན་རྒྱུད་ལས་ཇི་སྐད་བསྟན་པ་བཞིན་བསྒོམ་མོ།",
    "དེའི་ལྟེ་བར་ཡང་ཨ་རེག་བྱ་ཚ་བ་རྣོ་བ་དམར་ལྷང་ངེ་བསྒོམ།",
    "བདུད་རྩིའི་ཆུ་རྒྱུན་རང་གི་སྤྱི་བོའི་ཚངས་པའི་བུ་ག་ན་མར་སོང་ནས་ལྟེ་བའི་བདག་མེད་མའི་སྤྱི་གཙུག་ན་མར་བབ་པས་ལུས་བདུད་རྩིའི་ཆུས་དཀར་མེར་རེ་རེ་བྱུང་བ་ལ་བདེ་བ་ཕྲིལ་བསམས་ཏེ།",
    "ཡང་ཆང་གི་བདུད་རྩིས་སྔར་བཞིན་མཆོད་དེ་ཐུན་མཚམས་བྱའོ།",
    "དེ་ནས་ཐུན་ལ་ཡང་ཞུགས་ཤིང་སྔར་བཞིན་བསྒོམ་མོ།",
    "སློབ་དཔོན་གྱིས་ལྷ་མོ་བཅོ་ལྔའི་ས་བོན་བཟླས་པས།",
    "མཐའ་ཐུག་པ་མེད་པར་བསམ་མོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་རྟོགས་པའི་ཐབས་གསུམ་མོ།",
    "དངོས་སུ་ཚིག་གིས་མི་སྟོན་པའོ།",
    "དེའི་དུས་སུ་ཤེས་པ་ས་བས་ལྷུག་པ་དང་རང་ཐལ་དུ་གནས་སོ།",
    "རང་གི་སེམས་ནམ་མཁའ་ལྟར་ཤེས་པར་བྱའོ།",
    "དམ་ཚིག་ནི་ཟླ་བ་རེ་བུ་མོ་ལ་མཆོད།",
    "ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀ་ནི་ཡེ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧ་སོ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "དེ་ཉམས་སུ་བླངས་པས་ཌ་གི་མའི་ལུང་བསྟན་འབྱུང་སྟེ་སྤྱོད་པ་བྱས་ནས་ལོག་ནས་འོག་གི་བསམ་མི་ཁྱབ་ཀྱི་བྱིན་བརླབས་ཞུགས།",
    "འདི་ལྟར་སྐྱེ་བའི་ངེས་པ་མེད་གཏུམ་མོ་བསྒོམས་པས་སྤྱོད་པ་བྱ་རན་རྟགས་བྱུང་ན་སྤྱོད་པ་བྱས་ལ་བསམ་མི་ཁྱབ་བསྒོམས་དེ་ལ་སོགས་པ་འགྲེ། དེ་ལྟར་ན་ལམ་ཁྲིག་ཆགས་སུ་སྐྱེ་བ་ཡིན་ལ།",
    "གཏུམ་མོ་བཞག་ནས་ཡིད་ཀྱི་ཕྱག་རྒྱ་ལ་བསླབ་བོ།",
    "གཏུམ་མོ་ལ་བརྟེན་པའི་དུས་སུ་རང་དང་སྣང་བ་ཐམས་ཅད་བདེ་བར་བྱུང་ན་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་ལ་བསླབ་བོ།",
    "གཏུམ་མོའི་དུས་སུ་སྣང་བ་ཐམས་ཅད་བདེ་བར་བྱུང་ལ།",
    "བུ་མོས་དེར་དབུལ།",
    "ཟན་གྱི་ཏིང་དེའང་སློབ་དཔོན་གྱིས་བུ་མོ་ལ་བསླབས་ཤིང་།",
    "བུ་མོ་བཀོད་ལ།",
    "དེ་ནས་བུ་མོས་རྣལ་འབྱོར་པ་འདི་ལ་བྱིན་གྱིས་བརླབ་དུ་གསོལ།",
    "དེ་ནས་བུ་མོ་ལ་བཟའ་བཅའ་ལ་སོགས་པས་མགུ་བ་བྱས་ལ་གཏང་ངོ།",
    "བུ་མོ་དམར་ཀམ་ཟེར་སོང་བར་བསམས་ན་ངེས་པར་ཁུགས་པར་འགྱུར་རོ།",
    "འཛམ་བུ་གླིང་པ་རྣམས་ཀྱི་རྒྱན་མཁས་པ་རྣམས་ཀྱི་སྤྱི་གཙུག་གི་ནོར་བུ་ལྟ་བུར་གྱུར་པ།",
    "སྐྱེ་བོ་རྣམས་ཀྱིས་རང་རང་གི་རྣམ་དཔྱོད་འདྲ་མིན་གྱི་རྩལ་ལ་བརྟེན་ནས་རིག་པའི་གནས་ཅི་རིགས་གསར་གཏོད་དང་།",
    "བོད་ཀྱི་ས་ཆེན་པོའི་ཁྱོན་ཀུན་ལ་ཁྱབ་པར་ནུས་ཤིང་།",
    "ཡ་རབས་དང་གཤིས་བཟང་གི་མཛེས་སྡུག་རང་ཆས་སུ་ལྡན་པའི་མི་རིགས་ཁྱད་འཕགས་ཅན་ཞིག་ཏུ་ཡར་རྒྱས་བྱུང་བའི་འབྲས་བུར།",
    "དེང་གི་དུས་སུའང་འཛམ་གླིང་ཤར་ནུབ་ལ་གནས་པའི་སྲིད་འབྱོར་རིག་གསུམ་སྤྱི་དང་།",
    "དེར་བརྟེན་སེ་ར་ཐེག་ཆེན་གླིང་དང་ལྷ་ལྡན་ག་ཙུག་ལག་ཁང་མཉམ་འབྲེལ་གྱིས་སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་ཞེས་པའི་ཚན་པ་ཞིག་ཆེད་དུ་བཙུགས་ནས་ད་བར་བགྲང་བྱ་གསུམ་ལྷག་ཙམ་གྱི་རིང་ལ་ཕྱོགས་གཉིས་ནས་ཐུན་མོང་དུ་མ་ཐེབས་སྒོར་ས་ཡ་གསུམ་ལྷག་ཙམ་བཏང་སྟེ་དཔེ་དཀོན་མྱུར་སྐྱོབ་དང་།",
    "འདས་པའི་ལོ་ཟླའི་ནང་ངོས་ཚོའི་ལས་གཞི་ལ་གོང་རིམ་འབྲེལ་ཡོད་ཚན་པ་ཁག་གི་དབུ་ཁྲིད་ནས་གཟིགས་སྐྱོང་བླ་ན་མེད་པ་གནང་བ་དང་།",
    "ང་ཚོར་ཕྱར་བ་གྲུ་འདེགས་ཀྱིས་ལྷད་མེད་རྒྱབ་སྐྱོར་རོགས་རམ་གནང་བར་རྗེས་སུ་ཡིད་རངས་དང་།",
    "སྒྲོལ་དཀར་གྱི་ཐུན་མོང་མ་ཡིན་པའི་རྗེས་གནང་།་",
    "ཐེག་ཆེན་བློ་སྦྱོང་གི་གདམས་པ།",
    "ཡུམ་ཇོ་མོ་གནམ་སྐྱིད་གཉིས་ཀྱི་སྲས་སུ་ལྕགས་མོ་ལུག་གི་ལོར་འཁྲུངས།",
    "ཡབ་ཡུམ་འདི་གཉིས་ལ་སྲས་བཞི་དང་སྲས་མོ་གཅིག་བཅས་མིང་སྲིང་ལྔ་ཡོད་པ་ལས་རྗེ་འདི་ཉིད་སྲས་གསུམ་པ་ཡིན།",
    "འཁྲུངས་པའི་ནུབ་མོ་དེར་དགྲ་ཇག་བྱུང་སྟེ་ཡུམ་གྱི་ཁྱེའུ་འཁྲུངས་མ་ཐག་པ་དེ་ཁྱེར་མ་ཐུབ་པར་རྡོའི་གསེབ་ཅིག་ཏུ་སྦས་ཏེ་ནང་མི་ཐམས་ཅད་བྲིས།",
    "བྱ་རོག་ཆེན་པོ་གཅིག་གི་འཁྲུངས་མ་ཐག་པའི་ཁྱེའུ་དེ་གནོད་པ་ལས་བསྲུངས་ཏེ་མ་ནོངས་པར་བཞུགས་པ་མཐོང་བས་ཤིན་ཏུ་དགའ་ནས་ཁྱེའུ་དེ་འཁྱེར་ན་ས་བྲོས་ཏེ་ཕྱིན།",
    "ཁྱད་པར་གཙུག་ལག་ཁང་གི་ནང་ན་ཡོད་པའི་ལཉྩ་སོགས་ཡིག་རིགས་ཕལ་ཆེ་བ་རྗེ་འདིའི་ཕྱག་བྲིས་ཡིན།",
    "དགུང་ལོ་བཅོ་ལྔ་པ་ཤིང་མོ་བྱ་ལོར།",
    "སྣར་ཐང་གི་གཅུག་ལག་ཁང་དུ་མཁན་ཆེན་གྲུབ་པ་ཤེས་རབ་ལས།",
    "བས་བྱས་ནས་དགུང་ལོ་ཉེར་ལྔ་པ་ཤིང་མོ་ལུག་གི་ལོ་ལ་དབུས་ཕྱོགས་སུ་བྱོན་ཏེ།",
    "ད་རེབ་འབྲུག་མོ་ཧོར་གྱི་ཁྱེར་བ་འདྲ།",
    "ཞེས་གསུང་ནས་ལྷ་མོ་འདིའི་བཀའ་ལུང་མན་ངག་དང་བཅས་པ་རྫོགས་པར་གནང་།",
    "ལྷ་མོ་དམག་ཟོར་མས་ལུང་བསྟན་པ་དང་།",
    "ག་ཁང་འདིའི་ཁྱམས་སུ་བཞུགས་པའི་ཐོ་རངས་ཤིག་སྔར་གྱི་བུད་མེད་དེས་སྐད་བར་སྣང་ལ་ལྷང་བ་ཞིག་བྱུང་བ་ལ་གསན་པས།",
