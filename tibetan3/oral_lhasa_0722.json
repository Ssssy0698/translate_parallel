    "འདིར་གང་ལ་ལ་ཞིག་བཅིངས་པའི་རོ་ཟ་བར་བྱེད་དེའི་ཚེ་དེ་ཡིས་དང་པོར་སྣོད་དག་པར་བྱ་སྟེ།",
    "ཟླ་བ་ལུས་ནི་རྒྱས་པར་བྱེད།",
    "བསམ་གཏན་བཅས་པར་མེ་ཏོག་བརྔུབས་ན་སྐྲ་དཀར་དང་བཅས་རྒས་པ་དང་ནི་ལུས་སྐྱེས་རྣམས་ཀྱང་འཕྲོག།",
    "ད་ནི་བསམ་གཏན་བཅས་པར་ཞེས་པ་ལ་སོགས་པས་མེ་ཏོག་རྔུབ་པ་གསུངས་ཏེ།",
    "ད་ནི་སྒྲོན་མ་ལྔ་གསུངས་ཏེ།",
    "གསེར་དང་ལན་ཚྭ་བསྲེས་ནས་གཏན་པར་བརྡུང་།",
    "དེ་ནས་ཆུས་བཀྲུས་ཏེ་བསྐམས་ནས་མུ་ཟི་དང་ལྷན་ཅིག་རྫ་ཁ་སྦྱོར་དུ་བསྲེགས་པས་སྔོ་ལ་དམར་བའི་མདངས་ཅན་དུ་གྱུར་པ་ན་གསེར་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ནས་ཆུ་བྱིན་ནས་ལན་ཚྭའི་སྐྱོན་བསལ་ཏེ་དེ་ནས་སྐམ་པར་བྱའོ།",
    "གསེར་ལ་ཉི་མ་ཁབ་ལེན་ལྕགས་དང་བ་ཊ་ལས་སྐྱེས་ལྕགས་ནི་མཀྵི་ཀ་ཡིས་གདབ་པར་བྱ།",
    "དེ་ཕྱིར་དེ་ཉིད་ཉི་མ་སོ་སོའི་དུས་སུ་བཟའ་བར་བྱ་སྟེ་འོན་ཀྱང་གོང་བུས་རྣམ་པར་དམན།",
    "འདིའི་ཆོ་ག་གསུངས་པ་ནི།",
    "གསེར་ལ་སྟེ་རྣམ་པར་དག་པའི་གསེར་ལ་ཉི་མ་ཞེས་པ་ཟངས་དང་།",
    "དྲི་མ་དག་དང་བྲལ་བ་ཞེས་པ་ནི་ལན་བདུན་གྱི་བར་དུ་སྦྱང་བ་བྱས་པ་སྟེ་སྒོངས་པ་སྲང་ནི་དྲུག་ཏུ་བྱའོ།",
    "ཞེས་པ་ནི་དྭངས་མ་དེ་ཉིད་ཆོ་ག་དེས་བཟའ་བར་བྱ་སྟེ་གསེར་གྱི་གོང་བུ་རྣམ་པར་དམན་པ་ལོངས་སྤྱོད་པར་བྱའོ།",
    "དེ་ཉིད་བཏུང་སྟེ་མ་ཞུ་བ་ལ་ཉིན་ཞག་གསུམ་དུ་སྨྱུ་བར་གནས་པ་ནི་ཇི་སྲིད་ཤིན་ཏུ་བཀྲེས་པར་གྱུར་གྱི་བར་དུའོ།",
    "དེ་ནས་ཡང་ཟླ་བ་གཅིག་ན་རྩ་འདབ་གཉིས་པར་ཉིན་ཞག་བཞི་པ་རྒྱུས་ན་ཟླ་བ་ཉེར་དགུ།",
    "གལ་ཏེ་ཕྱོགས་གཅིག་རྣམ་པར་མ་ཆད་འབབ་ན་མི་རྣམས་ཀྱི་ནི་འཚོ་བ་ཕྱེད་དང་བཅས་པའི་ལོ།",
    "ཟླ་བ་གཅིག་ཏུ་རྣམ་པར་མ་ཆད་འབབ་ན་མི་ཡི་བདག་པོ་འཚོ་བ་དག་ཀྱང་ཟླ་བ་གསུམ།",
    "དེ་ལྟར་རྣལ་འབྱོར་པས་ནི་རང་ལུས་དག་ལ་ཟླ་བགྲོད་འཆི་བའི་དུས་ཀྱི་འཁོར་ལོར་ཤེས་པར་བྱ།",
    "ཕྱིར་ལོ་གསུམ་ལ་ཞག་སོ་གསུམ་ལྷག་ཅིང་དེ་ཉིད་ནང་ལ་འཆི་ལྟས་སུ་འགྱུར་བས་འཆི་ལྟས་ཀྱི་ཉིན་ཞག་སོ་གསུམ་དང་ཉི་མ་ཁྱིམ་ལ་རྒྱུ་བས་ཁྱིམ་གྱི་རྩ་ལ་རྒྱུ་བར་རྣམ་པར་བཞག་ཅིང་།",
    "འཆི་ལྟས་ཀྱི་ཉིན་ཞག་གྲངས་མཚུངས་ཞེས་འདབ་མ་བརྒྱད་པ་ནས་བཅུ་གཅིག་པའི་བར་གྱི་འཚོ་ཞག་དང་ལུང་ཕྱི་མས་རྩ་བཅུ་གཉིས་པ་དང་ཐ་མའི་འཚོ་ཞག་གཅིག་དང་བཅས་པའི་ཞག་གསུངས་པ་ཡིན་གྱི་འཆི་ལྟས་ཀྱི་ཞག་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ལུག་ལ་སོགས་པ་མི་མཉམ་པའི་དུས་སྦྱོར་ལ་སྐྱེས་པར་གྱུར་ན་གཡོན་པའི་རྩ་ལ་ཉིན་ཞག་གཅིག་རྒྱུའོ།",
    "གལ་ཏེ་གླང་ལ་སོགས་པ་མཉམ་པའི་དུས་སྦྱོར་ལ་སྐྱེས་པར་གྱུར་ན་གཡས་པ་ལ་ཉིན་ཞག་གཉིས་རྒྱུའོ།",
    "ལྷག་མ་ནི་གཡོན་དང་གཡས་པའི་འཆི་ལྟས་སུ་རིག་པར་བྱའོ།",
    "ཉིན་ཞག་སོ་སོར་རྒྱུ་བ་ནི་ཆུ་ཚོད་ལྷག་པར་འགྱུར་ཏེ་མཐའི་རྒྱུ་བ་ནི་གཡས་པའི་རྩ་ལའོ།",
    "ཕྱོགས་དང་ཕྱོགས་ལ་རྩ་ནི་དགུ་ཡིས་བསྣུན་པའི་ལག་འགྲོ་ལྟེ་བའི་འཁོར་ལོ་དག་ལ་གཅོད་པར་བྱེད།",
    "ཉི་མ་ཁ་དོག་ནག་པོ་ར་མཐོང་བ་དང་ནི་ཉ་ལ་ཡོངས་སུ་རྫོགས་པར་གྱུར་པའི་རི་བོང་འཛིན་པ་ཁ་དོག་སེར་པོ་མཐོང་།",
    "སྲོག་ནི་ཐིག་ལེར་གཞུག་པར་བྱ།",
    "དེ་ལ་ཉི་མའི་འཆི་ལྟས་སུ་གྱུར་ན་རྡོ་རྗེ་དཀྱིལ་ཀྲུང་བཅིངས་སྲོག་རྩོལ་སྔོན་དུ་འགྲོ་བས་དཔུང་པ་གཡས་པས་ནུ་མ་གཡས་པ་བཙིར་བ་ལས་དལ་ལྔ་འབབ་པའི་བདག་ཉིད་གཡས་པ་ལས་བཀུག་སྟེ་གཡོན་པ་ལ་སྲོག་ཡང་དག་པར་རྒྱུ་བར་བྱའོ།",
    "དེ་བཞིན་དུ་སྐྱིལ་ཀྲུང་བཅས་ནས་ཐིག་ལེར་ཏེ་དཔྲལ་བར་གནས་པའི་པདྨ་འདབ་མ་བཅུ་དྲུག་པ་དཀར་པོའི་དབུས་སུ་སྲོག་རྩོལ་སྔོན་དུ་འགྲོ་བས་སེམས་གཞུག་པར་བྱའོ།",
    "སྲོག་ནི་ཐིག་ལེར་གཞུག་པར་བྱ་ཞེས་པ་གཙོ་བོར་འཛིན་པའི་མཚན་ཉིད་དོ།",
    "དེ་ལྟར་ཉིན་ཞག་སྟོང་ལྔ་བརྒྱ་རྣམས་ཀྱིས་དབུགས་གཡོ་བ་མེད་པར་འགྱུར་ཏེ།",
    "འཇུག་པར་བྱེད་པ་དང་།",
    "ཞེས་པ་འདུ་བྱེད་ཀྱི་ཕུང་པོ་སྟེ་རྣམ་པ་བཅུ་ནི་གཡོན་དང་གཡས་ཀྱི་དལ་བཅུ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ལྟར་དེ་རྣམས་ཉིད་ཀྱིས་ཐིག་ལེའི་གནས་སུ་གོང་བུའི་གཟུགས་ཀྱིས་སྲོག་འགགས་པ་དེ་ནི་འཛིན་པར་བརྗོད་དེ།",
    "དེ་བཞིན་དུ་སྐྱིལ་ཀྲུང་བཅས་ནས་ཐིག་ལེར་ཏེ་དཔྲལ་བར་གནས་པའི་པདྨ་འདབ་མ་བཅུ་དྲུག་པ་དཀར་པོའི་དབུས་སུ་སྲོག་རྩོལ་སྔོན་དུ་འགྲོ་བས་སེམས་གཞུག་པར་བྱའོ།",
    "རྐང་པ་དེ་དག་བཟུང་བ་ལག་པའི་པདྨ་དག་ནི་རྒྱབ་ཀྱི་ཟུག་རྔུ་འཇོམས་པར་བྱེད་དོ།",
    "རྒྱུད་ཕྱི་མའི་སྣ་རྩེར་བལྟས་པས་ང་རྒྱལ་མཐའ་རུ་འགྱུར་ཏེ་ཞེས་པར།",
    "ཞེས་པའི་འགྲེལ་པར་ནཱ་རོ་ལས།",
    "དེ་ལྟར་ཐིག་ལེའི་དབུས་སུ་གོང་བུའི་གཟུགས་ཀྱིས་སྲོག་འགག་པ་སྟེ་དེ་ཉིད་ཀྱིས་ན་དེ་འཛིན་པར་བརྗོད་དོ།",
    "ཞེས་པར།",
