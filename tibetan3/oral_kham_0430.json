    "གྷོ་ར་ཁོ་རང་ཉིད་རྒྱང་རིང་ཞིག་ཏུ་འདུག་བཅུག་སྟེ།",
    "ཁོའི་སེམས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡིས་གྱེན་ལངས་ཀྱི་ངོ་རྒོལ་བྱས་པ་དང་ཆབས་ཅིག་ཁོ་རང་ཉིད་ཀྱི་རང་ཉིད་ལ་སྐད་ཤུགས་ཆེན་པོ་དང་བཅས།",
    "ང་ལ་དེའི་ཐད་ལ་བཀག་སྡོམ་དང་དགག་བྱ་བྱེད་ཀྱིན་འདུག་པ་དང་།",
    "ང་རང་ཉིད་ལ་འདྲིས་གཤིབ་དང་བློ་ཐག་ཉེ་བ་རྣམས་དང་ལྷན་དུ་ལོངས་སུ་སྤྱོད་མི་ཐུབ་པ་དང་།",
    "དོན་ངོ་མའིཆ་ནས་ང་རང་ཉིད་ལ་མཚོན་ན།",
    "དེར་བརྟེན་ང་རང་ཉིད་ཀྱི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཟབ་ས་ནས་ངས་དཀའ་ཐུབ་ཀྱི་སྒྲིབ་སྦྱོང་མིང་དོན་མཚུངས་པ་ཞིག་བྱེད་མ་ཐུབ་པ་ཡིན་ན།",
    "ཅེས་ཁོ་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་ཁེར་ལབ་བརྒྱབས།",
    "ཡིན་ནའང་གྷོ་ར་ཡིས་ཁོ་རང་ཉིད་ཀྱི་མགོ་བོ་ཡང་ནས་ཡང་དུ་གཡུགས་ནས།",
    "སུའུ་ཆར་རས་ཐ་ཡི་སེམས་ལ་ངོ་ཚའི་ཚོར་བ་འགོག་ཏུ་མེད་པ་ཞིག་སྐྱེ་རྒྱུའི་འགོ་བཙུགས་ཟིན་འདུག་སྙམ་པའི་རྟོག་པ་སྐྱེས།",
    "བྱ་བ་ཐམས་ཅད་ཀྱི་ཐོག་ལ་འགོར་འགྱང་བྱས་ཏེ་བསྡད་པ་ལ་དགོས་པ་ཅི་ཞིག་འདུག་གམ།",
    "ཁོ་རང་ཉིད་ཀྱི་ཁྱིམ་གྱི་ནང་དུ་ཁོའིབཟའ་ཟླ་སྐྱེས་དམན་དང་ཕྱི་རོལ་ཏུ་ཁོའི་གྲོགས་པོ་རྣམས་ཡོད་པ་དང་།",
    "ཁོ་རང་ཉིད་ཀྱི་ལྕགས་སྒམ་ནང་དུ་འཇོག་བཞིན་ཡོད་པ་མཐོང་དུས།",
    "ཁོ་ལམ་དུ་ཞུགས་ནས་འགྲོ་རྒྱུའི་བརྒྱུད་རིམ་འདིའི་ལས་ཀའི་ཁྲོད་དུ་ཁོ་རང་ཉིད་ཀྱི་ནང་མི་རྣམས་ཀྱི་ནང་ནས་ཁོ་ལ་རོགས་པ་བྱེད་མཁན་གྱི་མི་རྐང་གཅིག་ཀྱང་མེད་པ་དེ་ནི།",
    "ཁྱེད་རང་ངེས་པར་དུ་འདིར་སྡོད་ལ་སྐུ་མགྲོན་རྣམས་ལ་ལྟ་རྟོག་བྱེད་རོགས།",
    "ཁྱེད་རང་ཡང་འདི་ནས་ང་དང་མཉམ་དུ་ཐོན་ནས་ཕྱིན་པ་ཡིན་ན།",
    "ཁོ་ག་འདྲ་འདུག་གམ།",
    "དེ་གཏན་ནས་འགྲིག་ཐབས་མེད་པ་ཞིག་ཡིན་པ་ཤེས་ཀྱིན་འདུག་གང་ཡིན་ཟེར་ན།",
    "གྷོ་ར་ཁོ་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ།",
    "དེ་ཐམས་ཅད་ང་རང་ཉིད་ཀྱི་ནག་དང་ཉེས་པ་ལ་བརྩི་རྒྱུ་ཡིན།",
    "ཁོ་རང་ཉིད་ཀྱི་གཞུང་ལས་ཁང་དུ་དགོངས་ཞུའི་བཀའ་འཁྲོལ་འཐོབ་པའི་ཆེད་དུ་ཕྱིན།",
    "རྒྱ་གར་ལ་ང་རང་ཉིད་ཀྱི་འགྱུར་བ་མེད་པའི་བསམ་གཞིག་དང་ཞིབ་བརྟག་མེད་པའི་རྟོག་འཆར་སོགས་ཀྱི་འོག་ནས་རྒྱབ་ཕྱོགས་རྒྱ་ལ་ཡིད་སྐྲག་སྟེ།",
    "དེ་ཚོ་ལ་འཐབ་འཛིང་བྱས་ཏེ་ང་རང་ཉིད་ཀྱི་འབད་པ་དང་རྩོལ་བ་ཐམས་ཅད་རང་ཉིད་ཀྱི་ཡིད་ཆེས་ཀྱི་དད་པ་དེ་ཆ་ཚང་ཞིང་རྣམ་པ་ཡོངས་སུ་རྫོགས་པ་དང་།",
    "ངས་སྐད་ཆ་ཅི་ཞིག་བརྗོད་རྒྱུའི་ཐད་ལ་འབད་བརྩོན་བྱེད་བཞིན་ཡོད་པ་དེའི་དོན་ཁྱེད་རང་ལ་གསལ་པོ་ཆགས་ཀྱི་འདུག་གམ།",
    "དེ་རིང་ནས་བཟུང་རྒྱ་གར་གྱི་རིགས་རུས་ཡོད་ཚད་དེ་ང་རང་ཉིད་ཀྱི་རིགས་རུས་དང་།",
    "ང་རྒྱ་གར་ལ་ང་རང་ཉིད་ཀྱི་ཚེ་སྲོག་ལས་ཀྱང་བརྩེ་བ་ཆེ་བར་བརྟེན།",
    "ང་རང་ཉིད་ཀྱིས་རྟོགས་དགོས་པ་གང་ཡིན་པ་དེ་ཡི་ཆ་ཤས་ཙམ་ཞིག་ལ་ཡང་གཞན་གྱིས་སྐྱོན་བརྗོད་དང་དམའ་འབེབས་ཙམ་ཞིག་བྱས་པ་ཡིན་ནའང་།",
    "དེའང་རང་དོན་ལ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྗེས་སུ་དཔག་པ་ཡང་རང་ལས་ངེས་པ་ཁོ་ན་སྟེ།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "མཐོང་བ་ལྟར་ངེས་པ་སྐྱེས་ན་བ་མེན་གྱི་ཐ་སྙད་མ་ཐོགས་སུ་ཟིན་ཀྱང་རང་ལས་ངེས་པ་ཁོ་ན་ཡིན་ནོ།",
    "གང་ཞིག་ཕྲ་ཞིང་གཅིག་པུ་སྐྱེ་གནས་འདུག།",
    "དབྱིབས་ཤེས་པའི་སྒྲའི་སྤྱི་ཙམ་ནི་འཇུག་པར་མཚུངས་པར་མཐོང་བ་ལས་ལྷུན་པོའི་དབྱིབས་ཀྱང་རང་བྱེད་པ་པོའི་བློ་སྔོན་དུ་བཏང་ནས་བྱས་པར་སྒྲུབ་པར་བྱེད་པ་མི་རིགས་ཏེ།",
    "གལ་ཏེ་དུ་མའང་གཅིག་དུས་ཅན།",
    "ཁྱད་པར་འཕེལ་ཡང་རང་བཞིན་ཉིད།",
    "དེ་ལྟར་ན་སྲིད་པའི་ལྗོན་ཤིང་ཆེན་པོ་དེ་ཐོག་མ་མེད་པ་ནས་ཇི་སྲིད་མྱ་ངན་ལས་འདས་པའི་ས་ལ་ཕྱིན་གྱི་བར་དུ་འདུག་པའི་ཚུལ་དེའང་འཕྲུལ་འཁོར་མཁན་གྱིས་བྱས་པའི་ཟོ་ཆུན་གྱི་འཁོར་ལོ་འཕྱན་པ་དང་འདྲ་སྟེ།",
    "དེ་ཙམ་གྱིས་རང་རང་བཞེད་དོན་མྱ་ངན་ལས་འདས་པ་འགྲུབ་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་དང་རང་བཞིན་མ་ཡིན་པའི་ཁྱད་པར་རོ།",
    "རྩ་བ་མེད་པ་དང་མི་བརྟན་པ་དང་རང་བཞིན་ཡིན་ཏེ།",
    "འཕྲོད་པ་འདུ་བ་ལ་སོགས་པ་མེད་ན་ཡང་རང་བཞིན་དང་།",
    "༡༨བ་ཛ་༢ རང་བཞིན་དང་རང་བཞིན་མ་ཡིན་པའི་ཁྱད་པར།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "༡༥༣ན་སྔར་བུམ་པའི་གསལ་བ་ཡོད་པའི་དུས་སུ་བདག་ཉིད་ལ་དམིགས་པའི་མངོན་སུམ་གྱི་ཤེས་པ་བསྐྱེད་པ་ལ་ནུས་པ་དང་ལྡན་པ་གང་ཡིན་པ་དེ་ཉིད་བུམ་གསལ་མེད་པའི་དུས་སུ་ཡང་རང་འཛིན་པའི་མངོན་སུམ་བསྐྱེད་པ་ལ་ནུས་པ་དང་ལྡན་པའི་རྟག་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "བུམ་པའི་སྤྱི་དེ་ལ་ནི་བུམ་གསལ་ཡོད་པའི་དུས་ཀུན་གྱི་ཚེ་ན་ཡང་རང་འཛིན་མངོན་སུམ་བསྐྱེད་པའི་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "ཡང་ན་ཤིང་རང་མཚན་དུ་སྣང་ཡང་དེར་མེད་པ་ནི་སྤྱི་ཡིན་པར་འདོད་པའི་ཕྱིར་དང་།",
    "ཤིང་དུ་མེད་བཞིན་དུ་ཤིང་དུ་སྣང་བ་དེའང་རང་འཛིན་རྟོག་པས་བཏགས་ནས་བསླད་པའི་ཕྱིར་དང་།",
    "རྣམ་པ་འགས་ཀྱང་རང་འཛིན་པའི་རྣམ་པར་ཤེས་པ་ལ་སྤྱི་དེ་རྫས་ཐ་དད་པའི་དངོས་པོར་སྣང་བ་མེད་པའི་ཕྱིར་རོ།",
    "རྟགས་དང་རྟགས་ཅན་གྱི་བློ་དེ་དག་འཇུག་ཡུལ་རང་མཚན་གྱི་དངོས་པོ་ལ་སླུ་བར་བྱེད་པ་ཉིད་མིན་ཀྱང་རང་མཚན་མ་ཡིན་པ་ཞིག་ལ་རང་མཚན་དུ་འཁྲུལ་པར་རྣམ་གཞག་བྱས་པ་ཡིན་ནོ།",
    "ཡོད་པ་ཉིད་དང་རང་རྒྱུ་དང་།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "ཅི་སྟེ་རྟོག་པ་ལ་དོན་དུ་སྣང་བའི་རྣམ་པར་སྒྲོ་བཏགས་པའི་གཞན་སེལ་དེ་བརྗོད་ན་ཡང་རང་མཚན་སྣང་ནས་བརྗོད་པར་འགྱུར་ཏེ།",
    "འདིས་ནི་རྣམ་པར་ཤེས་པ་ཡང་རང་བཞིན་མེད་པར་གཏན་ལ་ཕབ་པས།",
    "ཕྱི་རོལ་གྱི་དོན་ཁས་བླངས་ཀྱང་རང་བཞིན་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "དེས་ན་ཅིག་ཅར་དུ་མ་འཛིན་པ་གྲངས་ཅན་ཁྱེད་རང་ལ་ཡང་གྲུབ་བོ།",
    "དེ་ལྟར་མིག་ཤེས་ཀྱིས་མཐོང་བའི་བ་ལང་རང་མཚན་རྟོག་པས་རྟོགས་པ་མེད་པར་ཡང་ནི་བརྗོད་པ་༢༣༨བ་དང་རྣམ་པར་རྟོག་པ་འཇུག་པའི་ཕྱིར།",
    "རྟགས་ཀྱི་ངོ་བོ་ཙམ་གྲུབ་ཀྱང་རང་བློ་རྗེས་སུ་དཔག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "དོན་འདི་ལ་སྔར་བདེ་སྡུག་བསྐྱེད་པའི་ནུས་པ་འདུག་གོ་ཞེས་མྱོང་བ་སྔ་ཕྱི་མཚམས་སྦྱོར་བའི་དྲན་པ་ལས་བྱུང་ལ།",
    "དེ་ལྟར་མ་ཡིན་ན་བུམ་གཟུགས་ལ་སོགས་པ་རང་ཤེས་པའི་ཡུལ་དུ་གསལ་བ་གསལ་བྱེད་གཞན་ལ་བལྟོས་པ་བཞིན་དུ་མར་མེ་ཡང་རང་གསལ་བ་གསལ་བྱེད་གཞན་ལ་བལྟོས་པར་འགྱུར་དགོས་པ་ལས་དེ་ལྟར་ཡང་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཟུགས་གཞན་གསལ་བ་དང་རང་གསལ་བའོ།",
    "དེ་ཡང་རང་དང་དུས་མཉམ་གཞན་གྱིས་མྱོང་བར་མཚུངས་ཤིང་།",
    "དེ་ཡང་རང་དང་དུས་མཉམ་གཞན་གྱིས་མྱོང་དགོས་པ་ལ་སོགས་པ་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར།",
    "བདེ་སོགས་མྱོང་བའི་རང་རིག་དེ་ནི་བདེ་སོགས་དེའི་བདག་ཉིད་ཀྱི་རང་བཞིན་མ་སྐྱེས་ནས་མེད་པ་བཞིན་དུ་དེ་མྱོང་རང་རིག་ཀྱང་མ་སྐྱེས་ནས་མེད་པའི་ཕྱིར་རོ།",
    "ཡུལ་བདེ་སོགས་དང་དེ་མྱོང་རང་རིག་པ་ཡང་འགགས་པའི་ཕྱིར་ཏེ།",
    "བརྡ་བྱ་བའི་ཡུལ་བདེ་སོགས་དེ་དང་བརྡ་བྱེད་པ་དེ་མྱོང་རང་རིག་ཐ་དད་པ་མེད་པའི་ཕྱིར་ནའོ།",
    "དེ་ལྟར་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་སོ་སོར་ངེས་པ་ལ་བལྟོས་པ་མི་འཐད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདེ་སོགས་ཤེས་པ་ཡིན་པ་དེ་ལ་ཡང་རང་རིག་མངོན་སུམ་གྱིས་དགའ་བ་དང་ཡོངས་སུ་གདུང་བ་དེ་མཐོང་།",
    "གཞན་༢༨༢བ་ཡང་རྗེས་དཔག་དེ་ལས་ཀྱང་རང་རྒྱུད་ལ་ལོངས་སྤྱོད་བྱེད་མི་འགྲུབ་པ་ཉིད་དེ།",
    "དེས་ན་བློ་མྱོང་གཉིས་པོ་དེ་ཡང་རང་བཞིན་གཅིག་ཉིད་དུ་མངོན་སུམ་གྱིས་མཐོང་བའི་ཕྱིར།",
    "གསུམ་པ་བྲལ་བྱ་རྟོག་པའང་རང་རིག་པར་བསྟན་པ་ལ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཕྱི་རོལ་ལྟར་སྣང་ཡང་རང་རིག་པའི་སྒྲུབ་བྱེད་བརྗོད།",
    "དོན་གྱི་རྣམ་པ་སྣང་བའི་མངོན་སུམ་གྱི་སོ་སོར་རིག་པར་བྱ་བ་དེ་ཕྱི་རོལ་ལྟར་སྣང་ཡང་རང་རིག་པ་ཡིན་ཏེ།",
    "དེ་ལ་འདོད་པའམ་མི་འདོད་པའི་དོན་དུ་ཐ་སྙད་བྱེད་པ་དེས་ཀྱང་རང་རིག་ལ་དོན་རིག་པའི་ཐ་སྙད་བྱེད་པར་ནི་འགྱུར་བ་ཡིན་པའི་ཕྱིར།",
    "རིགས་ཤེས་པ་ཡང་དོན་ཡོད་ཀྱང་རང་རིག་པ་ནི་རིགས་པས་གྲུབ་པ་ཡིན་གྱི།",
    "དེའི་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་གྱི།",
    "གཟུང་བའི་རྣམ་པ་དེའི་བསྒྲུབ་པར་བྱ་བ་ཡང་རང་རིག་པ་དེ་ཉིད་ཡིན་ཏེ།",
    "ཕྱི་དོན་གཞལ་བྱར་བྱས་ཀྱང་རང་རིག་པར་རིགས་པ།",
    "དོན་རིག་དེ་ཡང་རང་རིག་པ་དེའི་བདག་ཉིད་དུ་གནས་ཚུལ་ལ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དངོས་པོར་མེད་ན་ཡང་རང་བཞིན་གྱིས་གསལ་བར་གནས་པ་འགལ་ལོ་ཞེ་ན།",
    "ཡུལ་ཤེས་པ་དང་དེ་ཤེས་པའི་རྟགས་ལས་ཚུལ་གཉིས་དང་རང་རིག་བསྒྲུབ།",
    "ཚུལ་གཉིས་དང་རང་རིག་བསྒྲུབ།",
    "འདས་པའི་དོན་ནི་འཛིན་པའི་དྲན་པ་ལ་རྣམ་པ་སྣང་བའི་རྟགས་ཀྱིས་བློ་ཚུལ་གཉིས་པ་དང་རང་རིག་པར་གྲུབ་པ་ཡིན་ཏེ།",
    "འཆད་པ་པོས་རང་ཡུལ་བརྗོད་པ་དེ་ཉན་པ་པོས་ཀྱང་རང་ཡུལ་དུ་འབྲེལ་བ་གོ་བའི་ཕྱིར་ཞེ་ན།",
    "གཞན་རིག་དང་རང་རིག་པའི་ཚུལ་གཉིས་པ་ཅན་དུ་གྲུབ་སྟེ།",
    "དེ་ཡང་རང་ངོར་མ་གྲུབ་པ་ཉིད་ཡིན་པས་མ་གྲུབ་པ་ནི་རྟགས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ཡིན་གྱི།",
    "རྒྱུ་རྫས་གཞན་ལས་སྐྱེས་པ་དེ་ཡང་རང་བློ་བསྒྲུབ་པ་ལ་ཁྱབ་པ་འཁྲུལ་པ་ཅན་ཡིན་པའི་ཕྱིར།",
    "བུམ་པ་དག་ཀྱང་རང་གསལ་མིན་པ་དེར་བརྟེན་ནས་གསལ་བྱ་གསལ་བྱེད་ཀྱི་ངོ་བོ་ཡིས་ཐ་སྙད་རབ་ཏུ་རྒྱས་པར་བྱེད་དོ།",
    "དེ་ཡང་རང་རིག་པ་ལས་ཡིན་ནོ།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "མགྲིན་བཟང་ལ་སོགས་པ་ཐ་དད་ལ་གཅིག་ཏུ་རྟོག་པའི་ངོ་ཤེས་པ་དག་ལ་ཡང་རང་ཡུལ་གསལ་བར་སྣང་བ་ཡོད་པའི་ཕྱིར་མངོན་སུམ་དུ་འགྱུར་ལ།",
    "རང་གཞན་གྱི་བློ་གཉིས་ཀ་ལྐོག་ཏུ་གྱུར་པ་དང་རང་རིག་མེད་པར་བྱེ་བྲག་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱོན་སོ་ན་འདུག་སྟེ།",
    "༣༡༧བ་ཛ་༡ ཕྱི་རོལ་ལྟར་སྣང་ཡང་རང་རིག་པའི་སྒྲུབ་བྱེད་བརྗོད་པ།",
    "༣༣༢ན་ཚ་༡ ཕྱི་དོན་གཞལ་བྱར་བྱས་ཀྱང་རང་རིག་པར་རིགས་པ།",
    "༣༤༥ན་ད་༡ ཡུལ་ཤེས་པ་དང་དེ་ཤེས་པའི་རྟགས་ལས་ཚུལ་གཉིས་དང་རང་རིག་བསྒྲུབ་པ།",
    "༣༦༢བ་ད་༢ དུས་ཕྱིས་དྲན་པའི་རྟགས་ལས་ཚུལ་གཉིས་དང་རང་རིག་བསྒྲུབ་པ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གཏན་ལ་ཕབ་ཟིན་པའི་ཕྱིར་ཡང་རང་དོན་གྱི་ལེའུ་འདིར་མ་བཀྲལ་ལོ།",
    "དེ་ལྟར་ན་རོ་ད་ལྟར་བ་ལས་འདས་པའི་རོ་གཟུགས་དང་རང་དང་དུས་གཅིག་པའི་གཟུགས་རྣམས་རྟོགས་པའི་རྗེས་དཔག་དེ་ནི་འབྲས་བུའི་རྟགས་ལས་སྐྱེས་པ་ཡིན་ནོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་ཀྱི་ལྡོག་པ་འགྲུབ་པར་འགྱུར་གྱི།",
    "མི་རྟག་པ་དང་རང་བཞིན་གྱི་འབྲེལ་པ་༢༥ན་ཡོད་པའི་ཕྱིར་ཏེ།",
    "མེ་དང་རང་བཞིན་འབྲེལ་བའི་ཕྱིར་ཏེ།",
    "དེ་གང་དུ་འདུ་ན་འབྲས་བུ་མ་དམིགས་པ་རང་བཞིན་མ་དམིགས་པར་འདུ་བ་དེ་བཞིན་དུ་འདི་ཡང་རང་བཞིན་མ་དམིགས་པར་འདུ་བའོ།",
    "དེ་ཡང་རང་བཞིན་དང་འགལ་བ་གྲུབ་པ་ནི།",
    "རིག་བྱེད་རང་ཉིད་ཀྱིས་བྱས་པ་དེ་གཉིས་ལ་བྱེ་བྲག་ཅི་འདུག་བརྟག་པར་གྱིས་ཤིག།",
    "རྒོལ་ཕྱིར་རྒོལ་རྩོད་པའི་གྲར་ཞུགས་པ་མེད་ཀྱང་སྦྱོར་བ་གཉིས་པོ་དེ་ཡི་གེའི་རིས་སུ་བྲིས་པ་མཐོང་བའམ་སྦྱོར་བ་གོམས་པ་ལས་གང་ཟག་རང་ཉིད་ཀྱི་ལྐོག་གྱུར་གྱི་དོན་རྟོགས་པ་ན་ཡང་རང་དོན་རྗེས་དཔག་དེ་ལྟར་འགྱུར་བའི་ཕྱིར།",
    "དེ་ཉིད་སྟོན་པའི་སྒྲུབ་པའི་ངག་མེད་པར་འདོད་པ་ཐམས་ཅད་བཀག་ནས་འདུག་གོ།",
    "སྐྱེ་བ་འཇིག་པའི་རྒྱུ་ཡིན་པ་ཁེགས་པས་རྒྱུ་ལས་སྐྱེ་བ་མེད་པ་ཅན་གྱིས་བྱས་པ་ལ་ཡང་རང་བཞིན་མི་འཇིག་པར་གནས་པའི་ངེས་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའོ།",
    "གང་དག་དེ་གཉིས་དངོས་འགལ་མ་ཡིན་པར་སྨྲ་བ་ཐམས་ཅད་གཞུང་འདིས་བཀག་ནས་འདུག་གོ།",
    "དེ་ཡང་རང་བཞིན་དང་འབྲས་བུ་གཉིས་ལ་གནས་པ་ཡིན་ཏེ།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "འདིས་ནི་མངོན་སུམ་གྱིས་སྒྲོ་འདོགས་གཅོད་པ་བཀག་འདུག་གོ།",
    "གཞུང་འདིས་ནི་མངོན་སུམ་གྱིས་གཟུང་བའི་ཡུལ་ངེས་པ་དང་རྟོགས་པར་འདོད་པ་ཐམས་ཅད་བཀག་ནས་འདུག་གོ།",
    "ཐ་དད་ཡིན་ཀྱང་རང་བཞིན་གྱིས།",
    "ཐ་དད་ཡིན་ཀྱང་རང་རིགས་གཅིག་ཏུ་རྟོགས་པའི་དོན་ཅན་གྱི་ཤེས་པ་བསྐྱེད་པ་ལ་སོགས་པའི་དོན་གཅིག་སྒྲུབ་པ་ལ་རང་བཞིན་གྱི་ནུས་པ་སོ་སོར་ངེས་པ་ཡིན་ཏེ།",
    "གཞན་སེལ་བའི་སྒོ་ནས་བ་ལང་རང་མཚན་དེ་འཐོབ་པ་དང་རིག་པའི་དོན་ཅན་ཡིན་ཏེ།",
    "དོན་བ་ལང་རང་མཚན་ལ་མི་བསླུ་བར་ཡོད་པར་འདོད་དེ།",
    "བ་ལང་རང་མཚན་གྱི་དངོས་པོ་ཐ་དད་པ་རྣམས་ལ་བརྒྱུད་ནས་བརྟེན་པ་ཅན་ཡིན་པའི་ཕྱིར།",
    "ཉན་པ་པོའི་རྒྱུད་ལ་སྣང་བ་ལྟར་གྱི་གཟུང་དོན་མེད་པ་ཡིན་ཀྱང་རིགས་མཐུན་མི་མཐུན་གྱི་དངོས་པོ་ཀུན་ལས་ཐ་དད་པའི་བ་ལང་རང་མཚན་གྱི་དངོས་པོ་ཙམ་གྱི་ས་བོན་ཅན་གྱི་བློ་སྐྱེད་པར་བྱེད་པའི་ངག་ཡིན་པའི་ཕྱིར།",
    "གཞན་སེལ་བའི་སྒོ་ནས་བ་ལང་རང་མཚན་འཇུག་ཡུལ་དུ་བྱེད་པ་ཅན་ཡིན་ཏེ།",
    "གཞོ་ཁལ་གྱི་བྱ་བ་དེ་བྱེད་པའི་བ་ལང་རང་མཚན་ལ་བརྒྱུད་ནས་བརྟེན་པའི་ངོ་བོ་ཅན་ཡིན་པའི་ཕྱིར་ཏེ།",
    "བ་ལང་རང་མཚན་དང་བརྒྱུད་ནས་འབྲེལ་བའི་སྒོ་ནས་དེ་འཐོབ་པ་ལ་མི་བསླུ་བ་དེའི་ཕྱིར།",
    "བློ་འཁྲུལ་པས་གཞན་སེལ་དང་རང་མཚན་གྱི་དངོས་པོ་གཅིག་༡༣ན་པ་ལྟར་དུ་རྟོགས་པའི་ཕྱིར་རོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "གསལ་བ་དང་རང་བཞིན་ཐ་དད་པ་དེས་ནའོ།",
    "གློག་ལ་སོགས་པ་རྒྱུན་མི་བརྟན་པའི་དངོས་པོ་གང་ལ་རང་གྲུབ་ཙམ་ནས་འཇིག་ངེས་སུ་འགྱུར་ཞེས་བྱ་བ་དེ་ལས་གཞན་རྒྱུན་བརྟན་པར་འདོད་པའི་རི་ལ་སོགས་པ་ལའང་རང་གྲུབ་ཙམ་ནས་ངོ་བོ་ཉིད་ཀྱིས་འཇིག་ངེས་སུ་འགྱུར་ཏེ།",
    "སྐྱེས་བུས་མ་བྱས་ཀྱང་རང་བྱུང་དུ་འདོད་དེ།",
    "ནམ་མཁའ་ལ་སོགས་པ་རྟག་པ་ལས་ཀྱང་རང་འཛིན་ཤེས་པ་སྐྱེ་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "བུམ་པའི་དངོས་པོ་དང་རང་བཞིན་ནམ་རྒྱུ་འབྲས་ཀྱི་འབྲེལ་པ་གང་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཤིང་ཙམ་དང་རང་བཞིན་འབྲེལ་པའི་ཕྱིར།",
    "བྱས་པ་དེ་ཡོད་ཙམ་དང་རང་ཆས་སུ་མི་རྟག་པ་དང་རྗེས་སུ་འབྲེལ་པར་རོ།",
    "རྒྱུ་དང་རང་བཞིན་ལྡོག་བྱེད་ཡིན་པར་གོང་དུ་བསྒྲུབས་པ་དེའི་ཕྱིར།",
    "འབྲས་བུ་དུ་བ་དང་རང་བཞིན་བྱས་པ་དེ་གཉིས་པོ་ཁོ་ནས་མེ་དང་མི་རྟག་པའི་དངོས་པོ་ཡོད་པར་འགྲུབ་སྟེ།",
    "རྟགས་འགོད་པ་སྐབས་སུ་བབ་པ་ལ་བརྟེན་ནས་འདུག་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "ལུང་དོན་བསྒྲུབ་བྱ་ཡིན་ཀྱང་རང་ཉིད་སྨོས་པ་དོན་མེད་དུ་མི་འགྱུར་ཏེ།",
    "ཡང་ན་ཁྱེད་རང་མི་འདོད་པའི་བུམ་པའི་ཟླ་བཅས་བསྒྲུབ་བྱ་འགྲུབ་པ་ནི།",
    "དེས་ན་ཚིག་བརྗོད་བྱ་སྟོན་པ་དང་མ་འབྲེལ་ཞིང་མི་བདེན་པར་དམ་བཅས་པ་ན་ལུང་དང་རང་ཚིག་གཉིས་ཀར་གྱིས་གནོད་པ་ཡིན་ཏེ།",
    "རིགས་སྒོར་ལུང་དང་རང་ཚིག་དང་འགལ་བའི་དཔེར་བརྗོད་ཐ་དད་དུ་གསུངས་པའི་དགོས་པ།",
    "བཞི་པ་རིགས་སྒོར་ལུང་དང་རང་ཚིག་དང་འགལ་བ་ལ་དཔེར་བརྗོད་ཐ་དད་དུ་གསུངས་པའི་དགོས་པ་ནི།",
    "རི་བོང་ཅན་ཡང་རང་རྒྱུ་ལས་ཟླ་བར་སྐྱེས་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ལ་ཁས་བླངས་སྔ་ཕྱི་དང་རང་ཚིག་དངོས་ཤུགས་དང་།",
    "ཡིད་ཆེས་ཀྱི་བསལ་བ་ལ་ཁས་བླངས་དང་རང་ཚིག་ལ་བརྟེན་པ་གཉིས་ཡོད་པ་ལས།",
    "བྱེད་པའི་དབྱེ་བ་མེད་ན་འོ་ན་བསྟན་བཅོས་དང་རང་ཚིག་འདི་དག་ལ་དབྱེ་བ་ཅི་ཡོད་ཅེ་ན།",
    "འོ་ན་སྔར་ཁས་བླངས་པ་དང་རང་ཚིགས་དང་འགལ་བ་གཉིས་པོའི་གེགས་བྱེད་པའི་ཡུལ་ལ་བྱེ་བྲག་ཅི་ཞིག་ཡོད་དེ།",
    "ཁས་བླངས་དང་རང་ཚིག་གཉིས་ལ་གེགས་བྱེད་པའི་ཡུལ་གྱི་དབྱེ་བ་མེད་ཅིང་།",
    "དེ་ལྟར་ན་བསྒྲུབ་བྱའི་མཚན་གཞི་ལ་བརྟགས་ན་ཁྱེད་རང་ལའང་མཚུངས་སོ་ཞེ་ན།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "༢༦༤བ་ཚ་༤ རིགས་སྒོར་ལུང་དང་རང་ཚིག་དང་འགལ་བའི་དཔེར་བརྗོད་ཐ་དད་དུ་གསུངས་པའི་དགོས་པ།",
    "དེའི་ཕྱིར་གང་ཟག་གཉིས་ཀྱི་བསམ་ཚོད་ཕན་ཚུན་མ་མཐུན་པ་དེ་སྲིད་དུ་ཁོ་རང་གཉིས་རྩོད་པ་བྱས་པ་ཡིན་ལ།",
    "ཡོད་པ་ཡམིན་པ་ལ་སྤྱོད་ན་མཚན་མ་ལ་སྤྱོད་དོ་སོགས་ཀྱི་ལྷན་པ་མཛེས་པོ་དེ་ཚོ་སྣང་མེད་དུ་བཞག་འདུག་པས།",
    "ཉིན་གང་པོའི་བློ་ཐམས་ཅད་ཀྱི་ནང་ན་འགོག་རྒྱུ་གཅིག་ཀྱང་མི་འདུག་པས།",
    "དགེ་ལྡན་ཕྱོགས་ཀྱི་མཁས་གྲུབ་ཉམས་མྱོང་ཅན་ཚོས་ཀྱང་གསལ་བར་དགོངས་འདུག་སྟེ།",
    "དགག་རྒྱུ་རྭ་ཅན་ཞིག་འཚོལ་བར་འདུག་སྟ།",
    "བུམ་པ་འདི་ང་ལ་སྣང་རྒྱུ་འདུག་ཀྱང་།",
    "དོན་ལ་ཀུན་བརྟགས་ཀྱི་མ་རིག་པའི་ཡུལ་གྱི་ཁྱད་པར་འགའ་ཞིག་དགོས་པ་རྒྱ་ཆེན་པོའི་དོན་དུ་མཁས་པ་རྣམས་ཀྱི་རྟོག་གེའི་རིགས་པས་ཆེས་གསལ་དུ་བཏང་བ་ཞིག་ཏུ་འདུག་ལ།",
    "སྲེད་པ་སྐྱེད་ལ་ཁྱད་པར་མི་འདུག་པས།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུངས་པ།",
    "ཡོད་གོ་ཆོད་པར་འདུག་རི་བོང་རྭ་དོན་དམ་པར་མེད་ཅེས་དགག་བྱ་ལ་དོན་དམ་གྱི་ཁྱད་པར་སྦྱར་ཚེ།",
    "དགག་རྒྱུ་རྭ་ཅན་ཞིག་འཚོལ་བར་འདུག་སྟེ།",
    "སླར་ཡང་མདུན་ན་གནས་པ་དེ་ཤིང་གྲུ་བཞིར་འདུག་གྲུ་བཞི་དེ་ཅོག་ཙེ་རུ་འདུག་ཅོག་ཙེའི་སྟེང་ན་བུམ་པ་འདུག་སོགས་ཐ་མལ་པའི་བློ་མ་བསྒྱུར་བའི་འཇིག་རྟེན་ཕལ་པ་ཐམས་ཅད་ཀྱང་ཁ་མཐུན་ལ།",
    "ཤིང་རྟ་རྣམ་བདུན་གྱི་རིགས་པས་དུམ་བུ་སྟོང་དུ་བཤིགས་ཀྱང་ལྡོག་དུ་མེད་པའི་སྣང་བ་འདི་ཀུན་ཤེས་སྒྲིབ་ཁོ་རང་ངམ་ཁོ་ཡི་ནུས་པ་ཞིག་ཡིན་པར་སྣང་།",
    "གལ་ཏེ་རང་རང་སོ་སོས་ཐག་ཆོད་ན།",
    "དགག་བྱ་ལ་བདེན་གྲུབ་གྱི་ཁྱད་པར་མ་སྦྱར་བར་བཀག་ན་ཆད་ལྟར་འསགྱུར་ཚེ་བདེན་གྲུབ་ལ་ཡང་རང་བཞིན་གྱི་ཁྱད་པར་མ་སྦྱར་བར་བཀག་ན་ཆད་ལྟར་འགྱུར་ངེས་ལ།",
    "མེད་པ་འདི་ཀུན་རྫོབ་ཀྱི་ཁོངས་སུ་འདུས་པ་ཤེས་ན་མཐའ་བཞི་སྤྲོས་བྲལ་གྱི་མེད་རྒྱུའི་ནང་དུ་མེད་པ་ཁོ་རང་འོང་བ་ཡིན་པས་ཡོད་མེད་ཀྱི་ཕྱོགས་གཉིས་དང་བྲལ་བ་བདེ་བར་གཤེགས་པའི་ལུང་བསྟན་ལས།",
    "མེད་པ་ལ་ཡིད་མ་ཆེས་དྲགས་པའི་སྐྱོན་ཡིན་འདུག་རིས་མཐུན་སོ་སོ་སྐྱེ་བོ་རྣམས་ཀྱིས་ནམ་ཡང་མ་རྙེད་པ་དེ་ཀུན་ཡོད་པའི་ཁོངས་སུ་ཡོད་པར་འདུག་དེས་ན་སྟོབས་བཅུ།",
    "དོན་ལ་མེད་པ་ཞིག་ལ་ཐུག་འདུག་ཅིང་།",
    "དེ་ཡང་དོན་ལ་མ་རྙེད་པ་ཞིག་ལ་ཐུག་འདུག་པས།",
    "དེ་ལས་གོ་ལྡོག་པར་མཐོང་བའི་འུག་པའི་མིག་ཤེས་ལ་མི་གནོད་བྱ་བ་དང་ཁྱད་ཅི་ཡང་མི་འདུག།",
    "ཆུ་རྡོ་ཡི་སྟེང་དུ་རྟག་ཏུ་བརླན་པ་ཡོད་བྱ་བ་འགལ་མེད་ཀྱི་རྣམ་གཞག་དེ་ག་རང་དུ་འདུག་ལ།",
    "ངས་མཐོང་བ་ཙམ་མ་གཏོགས་ཁོ་རང་གསེར་ཡིན་ནམ།",
    "བཅོམ་ལྡན་འདས་ལ་སྣང་བའི་འབུམ་ཆ་གཅིག་ཙམ་ཡང་རང་ཅག་ལ་མི་སྣང་།",
    "དེའི་ངོར་བདེན་པ་ཀུན་རྫོབ་ཀྱི་བདེན་པ་བྱ་པའི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་བྱ་བའི་དོན་ཡིན་པར་འདུག།",
    "རང་ཅག་ལ་གྲུབ་པའི་ཚུལ་གསུམ་དེ་སྟག་ལ་མ་གྲུབ་པ་འདི་ཁོ་ནར་འདུག་པས།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ནའང་།",
