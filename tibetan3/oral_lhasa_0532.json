    "རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་རྣམ་། པར་ཤེས་པ་ཟབ་བོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་འདུས་བྱས་སྟོང་པ་ཉིད་ཟབ་བོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཟབ་བོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཟབ་བོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཟབ་བོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཟབ་བོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཟབ་བོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཟབ་བོ།",
    "གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བཅོམ་ལྡན་འདས་ཚོར་བའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "འདུ་ཤེས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "འདུ་བྱེད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྣ་བའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྣའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ལྕེའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ལུས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས་བཅོམ་ལྡན་འདས།",
    "ཡིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྒྲའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དྲིའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རོའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་། ཇི་ལྟ་བུ་ལགས།",
    "སའི་ཁམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཆུའི་ཁམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས་བཅོམ་ལྡན་འདས།",
    "མེའི་ཁམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ནམ་མཁའི་ཁམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "མ་རིག་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས་བཅོམ་ལྡན་འདས།",
    "འདུ་བྱེད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "མིང་དང་གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བཅོམ་ལྡན་འདས་ཚོར་བའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྲེད་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ལེན་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྲིད་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྐྱེ་བའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྒ་ཤིའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བཅོམ་ལྡན་། འདས་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ནང་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བཅོམ་ལྡན་འདས་ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྟོབས་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "བསམ་གཏན་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་། ལྟ་བུ་ལགས།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "སྨོན་པ་མེད་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་ནི་ཇི་ལྟ་བུ་ལགས།",
