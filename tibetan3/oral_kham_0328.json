    "དེ་དག་ལ་གོ་བདུན་འདུག་པ་ལ་བདུན་ཅུ་ཐམ་པར་བྱས་ནས་གྲངས་ཙམ་ལའང་འཁྲུལ་འདུག་པ་དང་།",
    "ནག་པོ་ཞི་བ་བཟང་པོ་གཉིས་ནག་པོ་ཞེས་པའི་ཚིག་ཙམ་ལས་གཅིག་ཏུ་འཁྲུལ་འདུག་པའི་ཕྱིར་ཏེ།",
    "རྟེན་གྱི་ཡན་ལག་ཡུལ་གྱི་ཡན་ལག་རྒྱུའི་ཡན་ལག་དུས་སྐབས་ཀྱི་ཡན་ལག་གོ།",
    "དེའི་ཚེ་ན་མཐར་རྟེན་བཞི་པོ་རྣམས་རང་རང་སར་སྦྱར་ཏེ།",
    "རང་རང་བསླབ་ལྡན་འཁོར་ཞེས་སོགས་ཀྱི་དོན་ནི།",
    "སྡོམ་པ་ཐོབ་མཚམས་འོ་སྐོལ་གསང་སྔགས་པ་ལས་ཉན་ཐོས་པར་མཁས་པ་འདུག་སྟེ།",
    "གཉིས་པ་ལྟར་ན་ཁྱེད་རང་རྣམས་ཀྱིས་ཀྱང་རྒྱུད་འབུམ་གྱི་ལུང་བྱེད་པ་དེ་མི་རིགས་པར་འགྱུར་ཏེ།",
    "ཁྱེད་རང་ཡང་བརྒྱུད་པ་གཅིག་ལྡན་དུ་འཇོག་བྱེད་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ལས་བདག་འཇུག་ལེན་པ་ལས་མེད་ཅིང་།",
    "ལྷ་དང་རང་འཇིགས་ཕ་མེས་དང་།",
    "རིགས་ལྔའི་སྡོམ་གཟུང་གཅིག་པོ་ལས་མི་འདུག་པའི་ཕྱིར།",
    "གླང་སེང་དྲང་སྲོང་འདུག་སྟངས་བཅའ",
    "ངེད་ཀྱི་ཁུངས་འདི་རྙེད་ནས་ཡན་ལག་བརྒྱད་པ་རྩ་འགྲེལ་ལ་བལྟས་པས་ཤིན་ཏུ་ཡིད་ཆེས་པ་འདི་ལྟར་འདུག་སྟེ།",
    "འདི་དག་ནས་ཀྱང་རང་གཞན་སྡིག་ས་ཡི།",
    "རང་རང་ཡུལ་གྱི་བདག་རོ་མངའ།",
    "ལོ་ཟླ་ཞག་དུས་ས་བདག་བསངས།",
    "ཙ་ནི་རང་དོན་ཕུན་ཚོགས་དང་།",
    "ཡས་ཁང་དུ་གྱུར་བའི་ནང་དུ་སྔགས་བརྗོད་པས་ལྷ་ཞེ་གཉིས་འོད་དུ་ལྟེམ་གྱིས་ཞུ་ནས་འདུག་པ་ལ།",
    "ཕྱག་རྒྱ་བཞིས་བཅིངས་ལ་ཁོ་རང་དངོས་སུ་བསམ་པའམམཚན་མའི་རྫས་ལ་དགྲ་བགེགས་དགུག་པ་སྲོག་མེད་ཀྱི་སྒྲུབ་རྫས་སམ།",
    "ཐོག་མར་སློབ་དཔོན་བ་ལས་བདགཉིད་དཀྱིལ་འཁོར་གྱི་ནུབ་ཕྱོགས་སུའདུག་སྟེ་རྡོ་རྗེཤུགས་ཀྱི་ཕྱག་རྒྱས་བཏེགས་པས་དཀྱིལ་འཁོན་གྱི་ལྷ་རྣམས་མདུན་གྱི་མཁའ་ལསྨིན་མཚམས་རོཡན་ཆད་འོད་ཕུང་འདབ་འདྲེས་སུ་བཞུགས་པར་བསམ་ལ།",
    "འདྲིགསབསྒྲལ་བའི་འོག་དུས་སུ་ཡང་གནས་པའོ།",
    "ཧ་ཅང་ཡང་མཁྱེན་དུར་ཁྲོད་བྱིངས་ལ་འདུག་ནས་བདུསྔགས་འཇུག་ནས་བཟློག་སྟེ་བཟླསན་ཆར་བ་ཆད་པར་འགྱུར་རོ།",
    "ང་རང་། བཛྲ་པུ་ཤ་ཡེ་ས་ཧཱ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "བདག་ཉིད་སྟན་བདེ་བ་ལ་འདུག་ནས་ཐོག་མ་ཉིད་དུ་ནང་བར་སྔར་ལངས་ཏེ།",
    "བདག་ཀྱང་རང་བཞིན་རྣམ་པར་དག་ཅེས་སྨོས་ཏེ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་ཡ་ཏེ་ན་མ་དེའི་ཕྱིའི་མུ་ཁྱུད་དང་པོ་ལ།",
    "རྗེ་ཉིད་ཞལ་ཤིན་ཏུ་ནས་འཛུམ་ཞིང་བཞད་ཆུང་དང་སྦྲགས་ནས་ད་ཅི་གདའ་༥ཞེས་ཡང་ཡང་གསུངས་ཤིང་།",
    "དམ་པར་སྨོད་པའི་ལས་ལ་མངོན་དགའ་ཕྱེ་ལེབ་མར་མེར་འཐབ་བཞིན་གདའ།",
    "དེ་དག་ལས་ཀྱང་རང་ཅག་ལ་བཀའ་དྲིན་གྱི་ཁྱད་པར་དུ་གྱུར་པ་ནི།",
    "བླ་སྤྲུལ་གཞན་པ་འགའ་ཞིག་ལས་ཀྱང་གྲངས་ཉུང་བ་འདུག་སྟེ།",
    "འཆད་ཀྱིན་འདུག་ཅེས་གསན་ལ་ག་སོལ་བ་འདེབས།",
    "བཙུན་ཆུང་ཤེས་རབ་ཅན་བསྟན་པ་ཐམས་ཅད་གྲུ་བཞི་ལམ་གྱིས་ཁྱེར་ཤེས་པ་གཅིག་འོང་བ་འདུག་ཅེས་བསྔགས་བརྗོད་གནང་།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ཤིན་ཏུ་དང་བ་འདྲེན་པ་ཞིག་འདུག་པས།",
    "འོན་ཀྱང་དགོས་པ་ལྷག་པོ་མི་འདུག་པས་བཞག་གསུང་།",
    "འོན་ཀྱང་སླར་ཡང་གནས་གཡར་པོ་འདྲ་ཡོང་ཤས་འདུག་པ།",
    "འདི་སྐྱེས་པ་སྡུག་པ་འདུག་ཅེས་སྨྲས་ཞེས་ཀྱང་གྲགས།",
    "བཀའ་བཅུ་པ་དཔལ་མགོན་གྱི་གོང་དེར་འདུག་པ་ཞིག་ཡོད་པའི་རྒྱུས།",
    "བསྐང་གསོའི་ཞོར་འདེགས་ཀྱང་ཡོང་བ་འདུག་གསུངས་པས།",
    "བཙུན་པ་ལེན་མི་ལེན་ཡོང་བལྟའོ་གསུངས་ནས་དབུ་པཎ་དེ་ཕུད་ཁོ་བོའི་མགོ་ལ་གཡོགས་ནས་བཙུན་པ་ལེན་པོ་ཡོང་བ་འདུག་ཅེས་གསུངས་ཤིང་བཞད་གནང་བས།",
    "འདི་ཡང་ཕག་འགྲམ་ཡིན་འདུག་ལ།",
    "དེ་དུས་ཁྱིམ་དུ་འདུག་པ་ལ་བཙོན་རའི་འདུ་ཤེས་ཡོད་པས།",
    "བྱས་པའི་ཞེན་པ་བསྲེགས་པའི་ཕྱིར་ཁྱིམ་དུ་འདུག་དགོས་པ་དང་།",
    "༧ན་བཙུན་པའི་བག་ཆགས་བཟང་བ་ཞིག་འདུག་པས་དལ་བར་རྩེ་བའི་དུས་སུ།",
    "སྐྲ་དཀར་གཉེར་མ་ལྷག་དུས་སུའང་།",
    "མ་བྱུང་འདུག་ཅེས་གསུངས་པའང་བདེན་པར་འདུག།",
    "ཐུན་མཚམས་སུ་དཔེ་ལྟ་བ་སོགས་ཀྱང་མ་བྱས་པར་ཟླ་བ་དྲུག་བདུན་གྱི་བར་དགེ་སྦྱོར་ལ་བརྩོན་པར་བྱས་པས་དགེ་སྦྱོར་ལ་བྲོད་པ་བརྙེད་༡༩ བ་འདི་ཁའི་རྒྱུན་ལོ་གཅིག་གཉིས་སྐྱོང་རྒྱུ་བྱུང་ན་ལམ་སྣ་ཟིན་པ་ལ་ཚེགས་མི་ཡོང་བ་འདུག་སེམས་པའང་ཤར།",
    "མི་རྒན་གཞོན་གོ་རིམ་མི་འདུག་པས།",
    "གངས་ཅན་པ་རྣམས་ལ་བཀའ་དྲིན་འདི་གཅིག་པུས་ཆོག་པ་འདུག་ཅེས་ཀྱང་ཟེར།",
    "སྔོན་སྲོལ་མི་འདུག་ཀྱང་།",
    "གྲགས་ཆེ་བར་འདུག་པས་༢ ༧བ་ཟ་ཕུའི་གཏེར་ལུང་བཅུ་གསུམ་པ་ཚུན་དང་།",
    "ཁ་བས་གཡོགས་པས་ལམ་ཉེན་ཆེ་ཀ་ཞིང་བགྲོད་དཀའ་བ་འདུག་ཀྱང་།",
    "གཞན་ལས་སྔ་བ་བྱུང་ནས་ཅི་འདྲ་འདུག་ཟེར།",
    "འདུག་གོ་མགྱོགས་པོ་བྱོན་ཅིག་བྱས།",
    "སྔ་ཕྱི་མང་པོར་སོས་ལྷག་པར་ཐན་པའི་དུས་སུ་འགྲོ་འདུག་བྱས་ཚེ་གང་དང་གང་དུ་ཕྱིན་པ་དེར།",
    "མང་པོ་ནི་མ་བརྟགས་ཉམས་དགའ་བས་བཞད་བགད་དང་བཅས་ཏེ་འདུག་པ་དང་།",
    "མར་མེ་ཇི་༣ ༧བ་བཞིན་དུ་འདུག་པ།",
    "སྲིད་པའི་ཕུན་ཚོགས་ཇི་ཙམ་ཐོབ་ཀྱང་སྐྱེ་རྒ་ན་འཆི་རྒུད་པའི་སྡུག་བསྔལ་གྱི་མེ་རབ་ཏུ་འབར་བས་སྐད་ཅིག་ཙམ་ཡང་བཟོད་གླགས་མི་འདུག།",
    "འདུས་པའི་རྩ་རྒྱུད་མཐིང་ཤོག་ལ་གསེར་གྱིས་དྲིས་པ་ཤིན་ཏུ་ལེགས་པ་ཞིག་འདུག་པས།",
    "རབ་ཡངས་ནམ་མཁའ་ཏིལ་གྱི་གོང་བུ་བཞིན་ཞེས་བདག་ཉིད་ཀྱིས་འདོན་གྱི་འདུག་པ་ན།",
    "འབྲས་སྤུངས་ནས་འབོད་མི་དོས་དྲག་སླེབས་འདུག་པ་ལྟར།",
    "སྟོད་ལུང་ཁྲི་ཟམ་ཁར་ཆིབས་བསུ་དང་སེར་སྦྲེང་རྒྱས་པ་ཅན་འདུག།",
    "ཅི་རང་དྲག་འབྲོས་ཐབས་ཨེ་འདུག་སོམས།",
    "ཡང་༤༩ བ་ཡང་རང་ཉམས་སུ་མྱོང་ལགས་ན།",
    "འཕགས་པའི་སྐུ་དེ་མབཀྱི་བསམ་པབཞུགས་པ་མ་ག་ཏོགས་ལུང་པ་དེ་ཤིན་ཏུ་ཡིད་མི་ཆགས་པ་ཞིག་འདུག་པས་ཀྱང་ཡིན་ནམ།",
    "མནར་མེད་ཀྱི་མེ་ནང་བསྲེག་ཉེན་གདའོ།",
    "ཀུན་ཤེས་ཀྱི་གཅིག་རྡུགས་བྱུང་ཉེན་གདའོ།",
    "དྲན་ཤེས་ཀྱི་སོ་བ་ཡེངས་ཉེན་གདའོ།",
    "༥༦ན་དེའི་ལོ་བྱང་འགྲུལ་ཀྱང་ལྟོས་མི་ཆུང་བ་འདུག་པ་ལྟར།",
    "དེ་རིང་རང་ཡང་མི་འཆི་བའི་གདེངས་མི་འདུག་ཀྱང་།",
    "དུས་ཐོག་འགྱངས་པས་ཐམས་ཅད་བརྒྱགས་ཟད་ཅིང་སྐུ་མཉེལ་བར་འདུག་པ་བློས་མ་བཟོད་པར།",
    "དཔལ་ལྷ་གཅིག་ཇོ་བོ་ཁྱེད་རང་མཁྱེན།",
    "ཨེ་མ་བྱིས་པ་ཆུང་ངུའི་ཀུན་སྤྱོད་དང་མཚུངས་པར་འདུག།",
    "སེམས་ཆགས་ཀྱང་རང་མཚང་མྱུར་དུ་སྟོན།",
    "ཟླ་ཕྱེད་ལྷག་ཙམ་འདུག་ནས།",
    "བོ་དོང་པ་རྣམས་ཀྱིས་སེར་སྦྲེང་རྒྱས་པ་བསྒྲིགས་འདུག།",
    "དྲན་ཤེས་བཞིན་ལྡན་པས་འཆག་ཅིང་འདུག།",
    "ད་དུང་ལྷག་པར་རྙིངས་པ་མང་དུ་འདུག་པས།",
    "སྤྱིར་འགྲོ་འདུག་མང་པོས་ཡིད་སུན་ཅིང་།",
    "བྲོས་པས་ཀྱང་ཐར་ས་མི་འདུག་པས།",
    "ནམ་ཡོང་ལ་ངེས་པ་མེད་འདུག་ན།",
    "ཟོན་མེད་བདེ་བར་འདུག་པ་འདི།",
    "ཅི་ཕྱིར་བདག་ཡིད་བདེ་བར་འདུག།",
    "ཞེས་པ་དེར་འདུག་ཅེས་ཟེར།",
    "འབྲོས་ཐབས་འདྲ་ཨེ་འདུག་ལེགས་པར་སོམས།",
    "ཤིང་ཆ་རྣམས་ཀྱང་ངན་པར་འདུག་པ་གསར་དུ་བསྒྲུབ་པའི་སྦྱོར་བ་ཉེ་བར་བརྩམས།",
    "ཙ་ནག་ཀྱ་ཡི་བྲམ་ཟེའི་ཁྱེའུའི།",
    "བ་སོའི་བླ་གཞིས་ཅི་ཡོད་བཀྲ་ཤིས་ལྷུན་པོའི་སྔར་གྱི་གྲྭ་ཚང་གསུམ་ཀའི་སློབ་དཔོན་གྱི་ཆ་རྐྱེན་ལས་བཟང་བ་འདུག་པ་སྔགས་པ་འཆད་ཉན་པའི་ཆ་རྐྱེན་དུ་གཙང་མར་སྦྱར་བ་ཡིན།",
    "བཀོད་པས་མཛེས་པའི་ཁྲི་གདན་ལ་འདུག་སྟེ།",
    "མི་གཙང་རང་བཞིན་རྣག་ཁྲག་རུལ་པ།",
    "སྡུག་བསྔལ་འདི་ལ་བཟོད་ཐབས་ཨེ་འདུག།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་མགོ་འདོན་རང་དུ་བྱུང་འདུག།",
    "ངོ་མཚར་ཅན་གཏན་མི་འདུག་པ་ནས།",
    "འབྲས་སྤུངས་ན་འབྲུམ་པ་འགའ་ཞིག་འདུག་པས།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཞབས་དྲུང་དུ་འབུལ་བ་རྒྱུ་ཆེན་པོས་མཉེས་པར་བྱས་འདུག་པ་ལྟར།",
    "ལྷ་རྒྱ་རི་བ་དཔོན་བློན་གྱིས་རྟ་བསུ་སེར་སྦྲེང་སོགས་ཤིན་ཏུ་རྒྱས་པ་འདུག་པ་ལྟར་མཆང་དཀར་བརྒྱུད།",
    "དེ་ཁའི་ཕུ་ན་ཆུ་དྲོན་གྲགས་པས་མཛེས་པ་ཞིག་འདུག་པར་ཞག་གཅིག་ཁྲུས་བགྱིས་ཤིང་།",
    "འབུལ་བ་སོགས་ཀྱང་རྨད་དུ་བྱུང་བ་འདུག་ཅིང་།",
    "ཡན་ལག་བདུན་པའི་ཆོ་ག་དུས་དྲུག་བསྐྱངས།",
    "རྩེ་ཐང་དུ་ཞག་གཅིག་འདུག་ཚེ།",
    "ཁྱད་པར་བྱམས་པ་གླིང་དུ་ཞག་གསུམ་འདུག་ནས་མཆོད་ཡོན་ཐམས་ཅད་ཀྱིས་མགྲིན་གཅིག་ཏུ་གསོལ་བ་བཏབ་པས།",
    "རྩེ་ནས་སོག་པོ་འདམ་དུ་སླེབས་ཡོད་འདུག་པ་ཅི་འདྲ་ཡིན་ཤེས་དཀའ་བས།",
    "རྒྱུས་ཡོད་སྙམ་པ་ཕལ་ཆེར་༡ ༡ ༣ན་ལ་ཡོང་འདུག་ཀྱང་།",
    "ས་སྐྱ་ཞབས་དྲུང་ཕེབས་གྲུབ་འདུག།",
    "འཇིག་དུས་ཀྱིས་མེས་ཇི་ལྟ་བ་བཞིན་དུ་བསྲེགས།",
    "ལས་མི་རྣམས་དཀའ་བར་འདུག་པ་ལ་འཚོ་བ་སྦྱར་ཏེ།",
    "ཡུལ་དེར་བྱོན་ཙམ་ཉིད་ནས་ངོ་མཚར་བའི་རྟགས་མཚན་དུ་མ་བྱུང་འདུག་ཅིང་།",
    "རྒྱུན་དུ་བཞུགས་དགོས་ཚུལ་ནན་ཆགས་པ་བྱས་འདུག་ཀྱང་།",
    "ཕྱོགས་འདིར་རང་རང་གྲུབ་པའི་ཕྱོགས་འཛིན་གྱི།",
    "ཞག་གཅིག་འདུག་ནས།",
    "དེ་སྐབས་དཔྱིད་འཁྱགས་ཤིན་ཏུ་འཚུབ་པ་ཞིག་འདུག་ཀྱང་།",
    "ཁོ་རང་ལ་རྒྱ་ནག་རྒྱལ་པོས་ཕུལ་བའི་ནོར་སྣ་ཁྱད་པར་ཅན་སྣ་ཚོགས་པའི་འབུལ་སྐྱེལ་སོགས་ཀྱང་བྱུང་།",
    "གངས་ཅན་གྱི་ཐུབ་སྐུ་གསར་དུ་སྤྱན་དྲངས་པ་དེའི་སྐུ་ཤ་ལ་ཚ་གསེར་གྲང་གསེར་གང་ཡང་མི་འདུག་པ།",
    "སླར་ཡང་རང་གཞན་གྱི་འགལ་རྐྱེན་བཟློག་ཕྱིར་བཞད་མན་གྱི་དགོན་ཆེ་ཁ་ཐམས་ཅད་ལ་མང་ཇ་རྟ་དྲེའུའི་འགྱེད་བཅས་དང་བཀྲ་ཤིས་ལྷུན་པོར་གསེར་འགྱེད་བཟང་པོ་བཏང་།",
    "ཆིབས་བསུ་སེར་སྦྲེང་ཡང་རྒྱས་པར་འདུག་ཅིང་བ་སོར་ཞག་བདུན་འདུག་རིང་ལ།",
    "གོས་སྐུའི་ཞལ་འབྱེད་མཛད་འདུག་༡༤༥ བ་པར་གུས་མཆོད་བྱས།",
    "དེ་ཡང་དགའ་བའི་ལོ་ནས་བཟུང་ཕྱོགས་སུ་འགྲོ་འདུག་སོགས་སྤངས་ནས་ཤས་ཆེར་མཚམས་ཁོངས་ནས་དགེ་སྦྱོར་ལ་བརྩོན་པར་བྱས་ཤིང་།",
    "འབུལ་བ་མང་འགྱེད་བཟང་པོ་བསྒྲུབས་ཏེ་ཁོང་རང་བསྙེན་རྫོགས་དང་།",
    "དུས་ཡུན་རིང་པོར་འདུག་པའི་འདུན་པ་དགོས་ཚུལ་མི་སྣ་དང་བཅས་པ་བྱུང་བ་བཞིན་དེ་དག་མཐུན་པའི་ཞུ་ལན་ལ་སོགས་པ་ཕུལ།",
