    },
    {
      "id": 462,
      "tibetan": "འཁོར་ལོ་བརྒྱད་པའི་དབུས་བཞུགས་པར།",
      "chinese": ""
    },
    {
      "id": 463,
      "tibetan": "ཕྱི་ཡི་དཀྱིལ་འཁོར་རྣམ་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 464,
      "tibetan": "བཅོམ་ལྡན་འདས་ནི་ངེས་པར་དགོད།",
      "chinese": ""
    },
    {
      "id": 465,
      "tibetan": "མཁའ་འགྲོ་ནུབ་ཏུ་དགོད་པར་བྱ།",
