      "tibetan": "རྣལ་འབྱོར་མ་དྲུག་མཉམ་པར་སྦྱར།",
      "chinese": ""
    },
    {
      "id": 453,
      "tibetan": "གཡོན་གྱི་ཕྱོགས་ནས་དགོད་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 454,
      "tibetan": "ཐམས་ཅད་ཡི་དགས་ཉི་སྟེངས་བཞུགས།",
      "chinese": ""
    },
    {
