    },
    {
      "id": 466,
      "tibetan": "རོ་ཡི་སྟེང་དུ་བཞུགས་པ་སྟེ།",
      "chinese": ""
    },
    {
      "id": 467,
      "tibetan": "ཕྱོགས་ཀྱི་གོས་ཅན་གཡས་བརྐྱང་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 468,
      "tibetan": "ཕྱག་རྒྱ་ལྔ་ཡིས་རྣམ་པར་བརྒྱན།",
      "chinese": ""
    },
