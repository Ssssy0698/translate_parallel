    },
    {
      "id": 405,
      "tibetan": "འོག་ཏུའང་མཚོན་ཆ་དགོད་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 406,
      "tibetan": "གླང་པོའི་པགས་པ་རྣམ་པར་བགོས།",
      "chinese": ""
    },
    {
      "id": 407,
      "tibetan": "སྣོད་ནི་སྟེང་དུ་གཞག་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 408,
      "tibetan": "ཁ་ནི་འདབ་མས་བརྒྱན་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 409,
      "tibetan": "བརྒྱད་ནི་སྒོ་རུ་རྣམ་པར་དགོད།",
      "chinese": ""
    },
    {
      "id": 410,
      "tibetan": "མུ་ཏིག་རྣམས་ནི་མཛེས་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 411,
      "tibetan": "གསེར་རྣམས་ཀྱིས་ནི་མཛེས་པར་སྤྱད།",
      "chinese": ""
    },
    {
      "id": 412,
      "tibetan": "དྲི་ཡི་ཆུ་ཡིས་ལེགས་པར་བསང་།",
      "chinese": ""
    },
    {
      "id": 413,
      "tibetan": "དཀྱིལ་འཁོར་ཀུན་ཏུ་དགོད་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 414,
      "tibetan": "ཕྱོགས་མཚམས་རྣམས་སུ་དགོད་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 415,
      "tibetan": "དང་པོར་སློབ་དཔོན་མཉེས་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 416,
      "tibetan": "ཧ་ཧ་ཞེས་ནི་བརྗོད་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 417,
      "tibetan": "དར་གྱིས་ལེགས་པར་བཀབ་ནས་སུ།",
      "chinese": ""
    },
    {
      "id": 418,
      "tibetan": "གཡོན་ཕྱོགས་བསྐོར་ནས་ཕྱག་བྱས་ཏེ།",
      "chinese": ""
    },
    {
      "id": 419,
      "tibetan": "དངོས་གྲུབ་སྲས་པོ་གཞག་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 420,
      "tibetan": "སྐོར་བ་དག་ཀྱང་བྱས་ནས་སུ།",
      "chinese": ""
    },
    {
      "id": 421,
      "tibetan": "ཤིན་ཏུ་མཉམ་པར་བཞག་པ་ཡིས།",
