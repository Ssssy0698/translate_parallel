      "tibetan": "དམ་པར་དགའ་དང་ལྷན་ཅིག་སྐྱེས།",
      "chinese": ""
    },
    {
      "id": 440,
      "tibetan": "རྣལ་འབྱོར་ངེས་པ་བྱས་པ་སྟེ།",
      "chinese": ""
    },
    {
      "id": 441,
      "tibetan": "ཡོངས་སུ་དག་པར་རིམ་པར་སྦྱོར།",
      "chinese": ""
    },
    {
      "id": 442,
      "tibetan": "རྡོ་རྗེ་དྲིལ་བུ་མཉམ་པར་ལྡན།",
      "chinese": ""
    },
    {
      "id": 443,
      "tibetan": "ཐམས་ཅད་མཁྱེན་པར་གྱུར་ནས་སུ།",
      "chinese": ""
    },
    {
