      "tibetan": "ཁྲོ་མེད་གཙང་ཞིང་མཁས་པ་དང་།",
      "chinese": ""
    },
    {
      "id": 402,
      "tibetan": "ཐོད་པས་སྤྱི་བོར་བརྒྱན་བྱས་ཤིང་།",
      "chinese": ""
    },
    {
      "id": 403,
      "tibetan": "རུས་ཕྲེང་རུས་པར་ཡང་དག་གནས།",
      "chinese": ""
    },
    {
      "id": 404,
      "tibetan": "བྱས་ནས་དེ་ཡི་འོག་ཏུ་ནི།",
