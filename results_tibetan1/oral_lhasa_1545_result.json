      "tibetan": "གཡས་བརྐྱང་གཡོན་བསྐུམ་ཚུལ་གྱིས་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 456,
      "tibetan": "ཡན་ལག་དྲུག་པ་རྣམ་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 457,
      "tibetan": "ཉིན་མཚན་བཟླས་ཤིང་བསྒོམས་བྱས་པས།",
      "chinese": ""
    },
    {
      "id": 458,
      "tibetan": "བྱིན་པ་གཉིས་ཀྱིས་ལེགས་པར་འཁྲིལ།",
      "chinese": ""
    },
    {
