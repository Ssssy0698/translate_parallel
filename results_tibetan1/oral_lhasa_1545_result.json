    },
    {
      "id": 422,
      "tibetan": "སྒྲུབ་པ་པོ་ཡིས་བྱས་ནས་གཞུག།",
      "chinese": ""
    },
    {
      "id": 423,
      "tibetan": "དེ་ཡི་རིགས་ནི་བསྟན་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 424,
      "tibetan": "དེ་ནས་སློབ་དཔོན་ལེགས་པར་ནི།",
      "chinese": ""
    },
    {
      "id": 425,
      "tibetan": "དཀྱིལ་འཁོར་དག་ནི་བསྟན་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 426,
      "tibetan": "དེར་དེ་ཡང་དག་བསྟན་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 427,
      "tibetan": "རབ་ཏུ་བཏུད་པ་བྱས་ནས་ནི།",
      "chinese": ""
    },
    {
      "id": 428,
      "tibetan": "དེ་བཞིན་གཤེགས་པས་གསུངས་པ་དབུལ།",
      "chinese": ""
    },
    {
      "id": 429,
      "tibetan": "གསེར་ལས་བྱས་པའི་མཆོད་ཕྱིར་ཐོགས།",
      "chinese": ""
    },
    {
      "id": 430,
      "tibetan": "ཕྱག་བྱས་ནས་ནི་དབུལ་བར་བྱ།",
      "chinese": ""
    },
    {
      "id": 431,
      "tibetan": "ཁྱེད་ལ་བདག་ནི་འབུལ་ལགས་ཞེས།",
      "chinese": ""
    },
    {
      "id": 432,
      "tibetan": "དེ་ལྟར་ངེས་པར་བྱ་བ་ནི།",
      "chinese": ""
    },
    {
      "id": 433,
      "tibetan": "སྒྲུབ་པ་པོ་ཡིས་རབ་ངེས་བྱས།",
      "chinese": ""
    },
    {
      "id": 434,
      "tibetan": "རྣལ་འབྱོར་མ་རྣམས་མཉེས་པར་འགྱུར།",
      "chinese": ""
    },
    {
      "id": 435,
      "tibetan": "ཅི་བགྱི་བྱེད་པར་ཐེ་ཚོམ་མེད།",
      "chinese": ""
    },
    {
      "id": 436,
      "tibetan": "རྟག་པར་རྒྱུན་དུ་བསྐྱེད་པར་འགྱུར།",
      "chinese": ""
    },
    {
      "id": 437,
      "tibetan": "མཁའ་འགྲོ་རྣམས་ཀྱི་ཁྱད་པར་དུ།",
      "chinese": ""
    },
    {
      "id": 438,
      "tibetan": "དེ་ཉིད་བསྡུས་པར་གྱུར་པའམ།",
