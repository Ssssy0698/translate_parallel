{
  "leixing": "oral_lhasa",
  "entries": [
    {
      "id": 1,
      "tibetan": "རིགས་དྲུག་དག་ནི་རྣམ་པར་དགོད།",
      "chinese": "六种物体是可笑的"
    },
    {
      "id": 2,
      "tibetan": "ལྷོ་རུ་ཨར་བུ་ད་ན་མཆེ་བ་རྣམ་པར་གཙིགས་པ་དང་།",
      "chinese": "南部的阿尔卑斯山的山峰。"
    },
    {
      "id": 3,
      "tibetan": "ནུབ་ཏུ་མ་རུ་ཏ་ན་རྣམ་པར་སྣང་མཛད་དང་།",
      "chinese": "西方的玛瑞达那，观世音。"
    },
    {
      "id": 4,
      "tibetan": "ཕྱག་རྒྱ་ལྔ་ཡིས་རྣམ་པར་བརྒྱན།",
      "chinese": "五手印。"
    },
    {
      "id": 5,
      "tibetan": "ཐམས་ཅད་ཡི་དགས་སྟེང་དུ་བཞུགས།",
      "chinese": "一切都在天堂里。"
    },
    {
      "id": 6,
      "tibetan": "དཀྱིལ་འཁོར་མཆོག་ནི་རྣམ་པར་བསྒོམ།",
      "chinese": "诚心修持佛坛。"
    },
    {
      "id": 7,
      "tibetan": "གཡོན་པ་ཁ་ཊྭཱཾ་གཡས་པར་ནི།",
      "chinese": "左手持钹，右手持杏叶。"
    },
    {
      "id": 8,
      "tibetan": "བསྒོམས་པས་ཐིམ་པར་བྱས་ནས་སུ།",
      "chinese": "以修行而入境。"
    },
    {
      "id": 9,
      "tibetan": "དོགས་པ་མེད་པར་བཟླས་བསྒོམ་བྱ།",
      "chinese": "无疑念地默想。"
    },
    {
      "id": 10,
      "tibetan": "ཇི་ལྟར་གསང་སྔགས་རྗེས་མཐུན་པར།",
      "chinese": "怎样合适密语后跟？"
    },
    {
      "id": 11,
      "tibetan": "ཟླ་དྲུང་ངེས་ཏེ་གཞན་མིན་པར།",
      "chinese": "月亮不会停在别处"
    },
    {
      "id": 12,
      "tibetan": "མཁས་པས་ངེས་པར་བསྒོམས་ནས་ནི།",
      "chinese": "智者须以心思修。"
    },
    {
      "id": 13,
      "tibetan": "རིམ་པར་སྦྱོར་བའི་རིམ་པ་དང་།",
      "chinese": "（关于排列）有间隔的间隔。"
    },
    {
      "id": 14,
      "tibetan": "གནས་ཀྱི་རྣལ་འབྱོར་རྗེས་མཐུན་པར།",
      "chinese": "同位的瑜伽，相称的瑜伽。"
    },
    {
      "id": 15,
      "tibetan": "འཇིགས་ཤིང་རབ་ཏུ་འཇིགས་པར་མཛད།",
      "chinese": "十分惊恐。"
    },
    {
      "id": 16,
      "tibetan": "གཡས་བརྐྱང་བ་ཡི་ཞབས་ཀྱིས་བཞུགས།",
      "chinese": "右脚向前屈。"
    },
    {
      "id": 17,
      "tibetan": "ཞབས་ཀྱིས་པདྨར་གནོན་པར་བཞུགས།",
      "chinese": "左足踏着莲花。"
    },
    {
      "id": 18,
      "tibetan": "རྒྱལ་བའི་པགས་པ་རྣམ་པར་སྤངས།",
      "chinese": "胜利的皮毛，"
    },
    {
      "id": 19,
      "tibetan": "ཕྱག་རྒྱ་ལྔ་ཡིས་རྣམ་པར་བརྒྱན།",
      "chinese": "以五手印为饰。"
    },
    {
      "id": 20,
      "tibetan": "ཐུགས་རྗེ་ཆགས་པས་རྣམ་པར་མྱོས།",
      "chinese": "心生感激，神情陶醉。"
    },
    {
      "id": 21,
      "tibetan": "ཁང་པ་བརྩེགས་པ་ལེགས་པར་མཛེས།",
      "chinese": "房屋屋顶建造得很美丽。"
    },
    {
      "id": 22,
      "tibetan": "ཡི་དགས་གདན་ལ་ལེགས་པར་བཞུགས།",
      "chinese": "请坐。"
    },
    {
      "id": 23,
      "tibetan": "ཕྱག་རྒྱ་ལྔ་ཡིས་རྣམ་པར་བརྒྱན།",
      "chinese": "五指合成手印。"
    },
    {
      "id": 24,
      "tibetan": "མི་བསྐྱོད་པ་ཡི་ཅོད་པན་བྱས།",
      "chinese": "作不动之冠。"
    },
    {
      "id": 25,
      "tibetan": "མཁྲིག་མ་མཉམ་པར་བྱས་ནས་ནི།",
      "chinese": "腕部水平。"
    },
    {
      "id": 26,
      "tibetan": "རྣམ་པར་སྣང་མཛད་དབུ་རྒྱན་བྱས།",
      "chinese": "以观世音为冠。"
    },
    {
      "id": 27,
      "tibetan": "གཅེར་བུ་གར་གྱིས་གནས་པས་བཞུགས།",
      "chinese": "赤身裸体，正坐。"
    },
    {
      "id": 28,
      "tibetan": "འཐོར་འཐུང་རིམ་པས་བྱས་པ་ཡི།",
      "chinese": "分散的或分开的。"
    },
    {
      "id": 29,
      "tibetan": "གྲངས་མེད་པར་ནི་བྱས་ནས་སུ།",
      "chinese": "无数次地被做了"
    },
    {
      "id": 30,
      "tibetan": "ཇི་སྲིད་སྐྱོ་བར་མ་གྱུར་པར།",
      "chinese": "只要不悲伤"
    },
    {
      "id": 31,
      "tibetan": "མཉམ་པར་བཞག་སྟེ་བཟླས་པ་བྱ།",
      "chinese": "合掌而诵。"
    },
    {
      "id": 32,
      "tibetan": "གཉིས་སུ་མེད་པར་མཉམ་པའི་བདག།",
      "chinese": "完全平等的所有人。"
    },
    {
      "id": 33,
      "tibetan": "འགྲོ་བ་གསུམ་པོ་བཅས་པར་ནི།",
      "chinese": "以及三界一切众生。"
    },
    {
      "id": 34,
      "tibetan": "ཧེ་རུ་ཀར་ནི་བྱས་ནས་ཀྱང་།",
      "chinese": "希腊人做的"
    },
    {
      "id": 35,
      "tibetan": "ས་རྣམས་གསུམ་པོ་མ་ལུས་པར།",
      "chinese": "三种土地都没有了。"
    },
    {
      "id": 36,
      "tibetan": "སྐུ་གསུང་ཐུགས་ལ་རྣམ་པར་གནས།",
      "chinese": "身语意，完全完备。"
    },
    {
      "id": 37,
      "tibetan": "ཀུན་གྱིས་གསོལ་བ་གདབ་པར་བྱ།",
      "chinese": "请大家做祈祷。"
    },
    {
      "id": 38,
      "tibetan": "རབ་རྨོངས་མ་ཡིས་བསྙེན་བྱས་ནས།",
      "chinese": ""
    },
    {
      "id": 39,
      "tibetan": "ཐོག་མ་དབུས་དང་མཐར་ཐུག་པར།",
      "chinese": ""
    },
    {
      "id": 40,
      "tibetan": "འཁོར་ལོ་དག་ནི་བརྟན་བྱས་ཏེ།",
      "chinese": ""
    },
    {
      "id": 41,
      "tibetan": "བསྒོམས་པས་ཐམས་ཅད་བརྟན་པར་འགྱུར།",
      "chinese": ""
    },
    {
      "id": 42,
      "tibetan": "ཇི་ལྟར་བདེ་བར་གནས་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 43,
      "tibetan": "ལྟེ་བའི་དབུས་སུ་རྣམ་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 44,
      "tibetan": "དེ་ཡི་དབུས་སུ་རྣམ་པར་བསམ།",
      "chinese": ""
    },
    {
      "id": 45,
      "tibetan": "བརྟགས་པས་ལེགས་པར་རྙེད་པ་ནི།",
      "chinese": ""
    },
    {
      "id": 46,
      "tibetan": "ཡིད་ཀྱིས་ངལ་བསོས་བྱས་པ་སྟེ།",
      "chinese": ""
    },
    {
      "id": 47,
      "tibetan": "མཆོག་སྟེ་སྤྱད་པར་བྱ་བ་མེད།",
      "chinese": ""
    },
    {
      "id": 48,
      "tibetan": "སྦྱོར་དང་སྦྱོར་བ་བྲལ་བྱས་ནས།",
      "chinese": ""
    },
    {
      "id": 49,
      "tibetan": "གསང་བ་ལེགས་པར་སྦ་བྱ་ཞིང་།",
      "chinese": ""
    },
    {
      "id": 50,
      "tibetan": "གསང་བ་བརྟན་པར་སྦ་བྱ་ཞིང་།",
      "chinese": ""
    },
    {
      "id": 51,
      "tibetan": "དེ་ཡིས་ཁྱད་པར་བདག་ཉིད་ནི།",
      "chinese": ""
    },
    {
      "id": 52,
      "tibetan": "འདིར་ནི་ཞབས་ཀྱིས་གནོན་པར་མཛད།",
      "chinese": ""
    },
    {
      "id": 53,
      "tibetan": "ཧེ་རུ་ཀ་ནི་རྣམ་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 54,
      "tibetan": "རྡོ་རྗེ་དྲིལ་བུ་མཉམ་པར་ལྡན།",
      "chinese": ""
    },
    {
      "id": 55,
      "tibetan": "བདུད་ནི་བཞི་པོའི་སྟེང་ན་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 56,
      "tibetan": "ཕྱག་རྒྱ་ལྔ་ཡིས་རྣམ་པར་བརྒྱན།",
      "chinese": ""
    },
    {
      "id": 57,
      "tibetan": "རང་མིང་གསལ་བྱེད་ཧཱུྃ་བྱས་ཏེ།",
      "chinese": ""
    },
    {
      "id": 58,
      "tibetan": "མཉམ་པར་མ་བཞག་སྦྱོར་བ་ཡིས།",
      "chinese": ""
    },
    {
      "id": 59,
      "tibetan": "སྔགས་ཀྱི་དེ་ཉིད་བཟླས་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 60,
      "tibetan": "སྦྱོར་བ་འདི་ནི་སྦྱིན་པར་བྱ།",
      "chinese": ""
    },
    {
      "id": 61,
      "tibetan": "དེ་ནི་ཐོ་ཙོམ་མེད་བྱས་ནས།",
      "chinese": ""
    },
    {
      "id": 62,
      "tibetan": "ངེས་པར་དངོས་གྲུབ་ཅན་དུ་འགྱུར།",
      "chinese": ""
    },
    {
      "id": 63,
      "tibetan": "མི་ཟད་གཉིས་མེད་རྣམ་པར་དག།",
      "chinese": ""
    },
    {
      "id": 64,
      "tibetan": "རྡོ་རྗེ་དྲིལ་བུ་མཉམ་པར་ལྡན།",
      "chinese": ""
    },
    {
      "id": 65,
      "tibetan": "ལྟེ་བའི་དབུས་སུ་རྣམ་པར་བསམ།",
      "chinese": ""
    },
    {
      "id": 66,
      "tibetan": "ཨེ་ནི་མགོ་ལ་རྣམ་པར་དགོད།",
      "chinese": ""
    },
    {
      "id": 67,
      "tibetan": "ཨཾ་ནི་གོ་ཆར་བྱས་ནས་སུ།",
      "chinese": ""
    },
    {
      "id": 68,
      "tibetan": "སྤྱན་གསུམ་དགྱེས་པས་རྣམ་པར་མྱོས།",
      "chinese": ""
    },
    {
      "id": 69,
      "tibetan": "གཞུ་ནི་འགུགས་པར་འཛིན་པ་སྟེ།",
      "chinese": ""
    },
    {
      "id": 70,
      "tibetan": "སྐྱིལ་ཀྲུང་ཕྱེད་པར་ལེགས་པར་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 71,
      "tibetan": "འདི་ལྟའི་ཆོ་གས་ཐམས་ཅད་མཁྱེན།",
      "chinese": ""
    },
    {
      "id": 72,
      "tibetan": "བྷ་གའི་དབུས་སུ་གནས་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 73,
      "tibetan": "རྡོ་རྗེ་དྲིལ་བུ་མཉམ་པར་ལྡན།",
      "chinese": ""
    },
    {
      "id": 74,
      "tibetan": "ཡེ་ཤེས་ལུས་ཅན་རྣམ་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 75,
      "tibetan": "འཁོར་ལོའི་དབུས་སུ་རྣམ་པར་བསྒོམ།",
      "chinese": ""
    },
    {
      "id": 76,
      "tibetan": "རྣམ་རྟོག་ཟོས་ཤིང་ཟད་པར་བྱེད།",
      "chinese": ""
    },
    {
      "id": 77,
      "tibetan": "གཡས་བརྐྱང་པ་ཡི་ཞབས་ཀྱིས་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 78,
