      "tibetan": "སྤྱན་གསུམ་པ་ལ་ཆགས་པར་མྱོས།",
      "chinese": ""
    },
    {
      "id": 472,
      "tibetan": "སྤྱན་གསུམ་རྣམ་པར་འགྱུར་ཞིང་དྲག།",
      "chinese": ""
    },
    {
      "id": 473,
      "tibetan": "སྤྱན་གསུམ་རྣམ་པར་འགྱུར་བའི་ཞལ།",
      "chinese": ""
    },
    {
      "id": 474,
      "tibetan": "གཡས་བརྐྱང་གཡོན་བརྐྱང་ཚུལ་གྱིས་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 475,
      "tibetan": "རོ་དང་པདྨའི་ཉི་དབུས་བཞུགས།",
      "chinese": ""
    },
    {
      "id": 476,
      "tibetan": "རྣམ་པར་ཐར་བརྒྱད་སྒོ་སྣ་ཚོགས།",
      "chinese": ""
    },
    {
      "id": 477,
      "tibetan": "ནང་གཟུགས་མེད་པར་ཕྱི་རོལ་གཟུགས་སུ་བལྟ་བའང་སྟོང་པ་ཡིན།",
      "chinese": ""
    },
    {
      "id": 478,
      "tibetan": "འདུ་ཤེས་དང་ནི་ཚོར་བའང་འགོག་པར་ལྟ་བ་སྟོང་པ་ཡིན།",
      "chinese": ""
    },
    {
